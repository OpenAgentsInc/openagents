# Build context for `gcloud builds submit` from the repository root, which
# builds the relay image from the root Dockerfile (see
# docs/deployment/runbook-cloud-run.md). Upload only what that Dockerfile
# copies; the rest of the tree is over a gigabyte.
/*
!/Dockerfile
!/Cargo.toml
!/Cargo.lock
!/migrations/
!/crates/
!/nips/
!/tests/
!/vendor/
!/apps/
/apps/*
!/apps/openagents/
/apps/openagents/*
!/apps/openagents/Cargo.toml
!/apps/openagents/crates/
!/questions/
!/docs/
/docs/*
!/docs/protocol/
/docs/protocol/*
!/docs/protocol/fixtures/
!/scripts/
/scripts/*
!/scripts/deploy/
/scripts/deploy/*
!/scripts/deploy/cargo-skeleton.sh
!/scripts/deploy/cloud-buildx.sh
!/scripts/deploy/oa-kache.sh
