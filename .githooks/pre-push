#!/usr/bin/env bash
# Pre-push guard for main.
# Runs: whitespace, then — for diffs that touch Rust sources — cargo fmt
# --all -- --check and cargo test --workspace. Docs-only diffs skip the
# suite (#306): a markdown commit cannot change Rust behavior, and paying
# a flake-prone six-minute gate to land prose is how docs stop landing.
# A failed suite retries the failing tests exactly once before blocking —
# timing-shape flakes under concurrent local sessions die on the second
# run (#306), while a real regression fails twice.
set -uo pipefail

gate=0
main_local_sha=""
main_remote_sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|*/main)
      gate=1
      main_local_sha="$local_sha"
      main_remote_sha="$remote_sha"
      ;;
  esac
done

[ "$gate" = 1 ] || exit 0

# Git exports GIT_DIR when it runs this hook. In a linked worktree that
# points at .git/worktrees/<name> with no GIT_WORK_TREE, and under an
# explicit GIT_DIR `rev-parse --show-toplevel` refuses to resolve a work
# tree at all — so every push from a linked worktree was blocked here
# (seen while landing #181). Clearing it puts the hook in the caller's
# shoes: the cwd is inside the worktree, so git discovers both dirs as it
# would for any command typed there.
unset GIT_DIR GIT_WORK_TREE

# `git -c core.bare=false` does NOT rescue work-tree resolution when the
# common config carries core.bare=true (#208): the config-file value wins
# for this query and rev-parse still exits 128. When resolution fails
# while the repo clearly has linked worktrees AND core.bare=true is set,
# the config is poisoned — unset core.bare directly in the common config
# file (a pure file edit, no repository resolution involved). A genuine
# bare hub has no linked worktrees, so this cannot damage one; a
# non-bare repository with core.bare=true is corruption by definition.
root="$(git -c core.bare=false rev-parse --path-format=absolute --show-toplevel 2>/dev/null)"
if [ -z "$root" ] || [ ! -d "$root" ]; then
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  if [ -n "$common" ] && [ -d "$common/worktrees" ] && [ "$(git config --get core.bare 2>/dev/null)" = "true" ]; then
    echo "[pre-push guard] core.bare=true in the common config while linked worktrees exist — poisoned config, healing (#208)..." >&2
    if git config --file "$common/config" --unset-all core.bare >/dev/null 2>&1; then
      root="$(git -c core.bare=false rev-parse --path-format=absolute --show-toplevel 2>/dev/null)"
    fi
  fi
fi
if [ -z "$root" ] || [ ! -d "$root" ]; then
  echo "[pre-push guard] BLOCKED: could not resolve the repository root." >&2
  if [ "$(git config --get core.bare 2>/dev/null)" = "true" ]; then
    echo "[pre-push guard] HINT: core.bare=true is set while working trees are attached — that combination is corrupt; unset it: git config --unset core.bare (#208)." >&2
  fi
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"

if [ "$main_local_sha" = "$zero_sha" ]; then
  echo "[pre-push guard] BLOCKED: refusing to delete main." >&2
  exit 1
fi

echo "[pre-push guard] checking in $root" >&2

# Checks run in $root. If that tree's HEAD is not the commit being pushed,
# cargo/fmt would test some other code and report a failure the push does
# not have (#243). Refuse before any check and name both commits.
tree_head="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
if [ -n "$main_local_sha" ] && [ -n "$tree_head" ] && [ "$tree_head" != "$main_local_sha" ]; then
  echo "[pre-push guard] BLOCKED: this tree is $tree_head, but the push is $main_local_sha." >&2
  echo "[pre-push guard] Push from a tree that holds the pushed commit, so the checks cover that code." >&2
  exit 1
fi

if [ -n "$main_local_sha" ] && [ "$main_remote_sha" != "$zero_sha" ]; then
  if ! ( cd "$root" && git diff --check "$main_remote_sha..$main_local_sha" ) >&2; then
    echo "[pre-push guard] BLOCKED: whitespace errors in pushed diff." >&2
    exit 1
  fi
  changed_files=$(cd "$root" && git diff --name-only "$main_remote_sha..$main_local_sha")
elif [ -n "$main_local_sha" ]; then
  if ! ( cd "$root" && git diff-tree --check --no-commit-id -r "$main_local_sha" ) >&2; then
    echo "[pre-push guard] BLOCKED: whitespace errors in pushed commit." >&2
    exit 1
  fi
  changed_files=$(cd "$root" && git diff-tree --no-commit-id --name-only -r "$main_local_sha")
fi

# Docs-only push: nothing the fmt/test gates cover has changed, so run
# neither (#306). Any .rs file, the workspace or toolchain manifests, or a
# lockfile schedule the full gate.
if [ -z "$(printf '%s\n' $changed_files | grep -E '\.rs$|Cargo\.(toml|lock)$|rust-toolchain(\.toml)?$|^\.cargo/')" ]; then
  echo "[pre-push guard] no Rust sources in the pushed diff — skipping fmt + workspace suite (#306)." >&2
  exit 0
fi

echo "[pre-push guard] push to main -> cargo fmt and cargo test --workspace..." >&2

# The guard inherits the caller's descriptor ceiling, and non-interactive
# shells on macOS default to a soft `ulimit -n` of 256 — under it, the CLI
# test suite fails intermittently with EMFILE ("Too many open files") in
# whichever fd-hungry test happens to exhaust the process-wide pool first,
# and every push to main is blocked by a flake the pushed diff did not
# cause (#179). Raise the soft limit where the kernel allows it; a child of
# an already-tight shell may be refused even with room under the hard
# ceiling, so when the ceiling is still tight, serialize the suite instead
# — proven green at 256, at the cost of wall time on constrained machines
# only.
ulimit -n 1024 2>/dev/null || true

if ! ( cd "$root" && cargo fmt --all -- --check ) >&2; then
  echo "[pre-push guard] BLOCKED: cargo fmt --all -- --check failed. Run \`cargo fmt --all\` and commit the result." >&2
  exit 1
fi

# Stream the suite live (tee) so a long run is never indistinguishable
# from a hang (#306), and retry the failing tests once on failure: the
# first-fail output is captured, the named failures re-run alone, and only
# a confirmed second failure blocks the push.
fmt_args=""
if [ "$(ulimit -Sn)" -lt 512 ]; then
  echo "[pre-push guard] soft fd limit $(ulimit -Sn) is tight -> running the suite serially (#179)..." >&2
  fmt_args="-- --test-threads=1"
fi

test_log="$(mktemp)"
echo "[pre-push guard] cargo test --workspace starting at $(date +%H:%M:%S)..." >&2
if ( cd "$root" && cargo test --workspace $fmt_args ) 2>&1 | tee "$test_log" >&2; then
  rm -f "$test_log"
else
  failed="$( { grep -E '^test [^ ]+ \.\.\. FAILED$' "$test_log" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/'; grep -E '^    [a-zA-Z0-9_]+(::[a-zA-Z0-9_]+)*$' "$test_log" | sed 's/^ *//'; } | grep -E '^[a-zA-Z0-9_]+(::[a-zA-Z0-9_]+)*$' | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//' )"
  if [ -n "$failed" ]; then
    echo "[pre-push guard] first run failed; retrying the failing tests once before blocking — load flakes die on the second run (#306):" >&2
    echo "[pre-push guard]   $failed" >&2
    if ! ( cd "$root" && cargo test --workspace -- $failed ) >/dev/null 2>&1; then
      echo "[pre-push guard] BLOCKED: cargo test --workspace failed (failures confirmed on retry)." >&2
      rm -f "$test_log"
      exit 1
    fi
    echo "[pre-push guard] retried tests passed — first run treated as a load flake (#306)." >&2
    rm -f "$test_log"
  else
    echo "[pre-push guard] BLOCKED: cargo test --workspace failed (no named test failures — likely a compile error; see output above)." >&2
    rm -f "$test_log"
    exit 1
  fi
fi

echo "[pre-push guard] cargo completion gate green — push allowed." >&2
exit 0
