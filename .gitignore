# docs/deploy/receipts/ instead.
.release/

# Local agent working files / tooling (never tracked)
.codex/
.artifacts/
NEEDS_OWNER.md

# GLM own-capacity continual-learning burn output (owner-private derived data)
.khala-continual-learning/

# Khala Sync backfill CLI resumable local cursor state (never commit)
packages/khala-sync-server/.artanis-backfill-state.json
/target
var/agent-computer/
.sarah-data/

# qa-runner session artifacts (video / trace / screenshots / result.json).
# Scratch, not source: a sweep rewrites whatever lives here, so tracking it
# makes unrelated read-only assertions fail depending on test order (#9240).
# Suites now default to an OS temp directory; ARTIFACT_DIR still points a
# deliberate evidence run back here.
/runs/
