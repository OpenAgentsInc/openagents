/target
/crates/psionic/target/
# Any nested Cargo workspace's build output.
target/
/target-mc/
/target-voyager/
/target-coder-one/
/.coder/

# Local build products; measurement records and fixtures stay tracked.
# Scratch of remote builds (coax/remote/remote.sh never sends it, #13181).
build-remote/
/swift/lev-bridge/.build/
# Python bytecode anywhere. Recorded bench traces that captured bytecode
# as produced artifacts stay tracked (their manifests hash them).
__pycache__/
*.py[co]
.pytest_cache/
mc-bridge/target/

# Local release packaging output
/dist/

# Firebase configuration for an opt-in push build; never committed.
bins/coder-android/host/app/google-services.json

# Results `openagents ext eval run` writes beside a catalog extension's suite.
/crates/plugin-*/evals/results/
/plugins/*/evals/results/

# Licensed Verse content never enters the repository
# (docs/metaverse/private-assets.md); builds belong under
# ~/.openagents/verse/private-build/.
/private-assets/
*.private.vtp
private-assets.json

# Local scratchpad. Shopping lists, previews, and private-client notes stay
# here. The readme is the only tracked file.
/scratch/*
!/scratch/README.md
# The licensed medieval kit pack, fetched into the web build context only.
/crates/openagents-web/kit/

# Agent worktrees and local Claude Code state; the shared project settings
# (the agent gate hooks, #11430) are tracked.
/.claude/*
!/.claude/settings.json
# Finder metadata.
.DS_Store

# Bench captures and record archives live in gs://openagents-bench-artifacts
# with a sha256 manifest per run (scripts/bench-artifacts.py, #11110).
/bench/verse/**/*.mp4
/bench/verse/**/*.webm
/bench/verse/**/*.mov
/bench/verse/**/*.png
/bench/verse/**/*.jpg
/bench/verse/**/*.jpeg
/bench/verse/**/*.wav
/bench/verse/**/*.gz
/bench/verse/**/*.zip
/bench/verse/**/*.npy
/bench/terminal-bench/experiments/**/*.tar.gz
/target-agents/
# generated by the build (`openagents project snapshot` and `project bake`)
apps/openagents-web/projects/*/work.coax
apps/openagents-web/projects/*/commits.coax
# generated by apps/openagents-web/build.sh: the NIP pages' and /pylon's shader,
# splash's with the sans atlas (apps/openagents-web/gpu/nip.coax), copied per page
apps/openagents-web/nip01.wgsl
apps/openagents-web/nip-guide.wgsl
apps/openagents-web/pylon.wgsl
apps/openagents-web/projects/baked.coax

# Licensed scan source/derived bytes stay in the private Aethyrforge cache.
/apps/openagents-web/assets/valley/scans/
# Lab-only reference engines, their build products and raw large captures.
metaverse-engine/lab/.cache/

# The experimental pack is rebuilt locally; its compressed transport is tracked.
/apps/openagents-web/realms/everglade-experimental/assets/glade.pack
# Range-addressable packs: apps/openagents-web/build.sh writes each from its tracked .pack (#13001).
/apps/openagents-web/realms/**/*.vpk3
# A pack with its rig entry: apps/openagents-web/build.sh writes it from the tracked pack and everglade/model/rigs.vrg (#13306).
/apps/openagents-web/realms/**/*.rigs.pack.gz

# libsodium for the Ed25519 differential test (ed25519_libsodium.py); never committed or shipped.
coax/tests/auth/.cache/
build/pipeline/
# Coax Native generated package and immutable runtime configuration.
/apps/openagents-ios/Starter/
/apps/openagents-ios/Native.plist
