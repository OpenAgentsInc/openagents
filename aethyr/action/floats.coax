// Floating numbers (book chapter 96, GitHub #12993): the one path every realm shows a combat result
// through, over whoever it happened to: damage you take, damage you deal, a critical hit, a miss, a
// heal, or a short word (KNOCKED OUT). Each is queued through react_present (aethyr/action/react.coax:
// at most per_source a source a frame, the rest suppressed and counted), so a burst never floods the
// screen, and each is presentation of a result the ruleset already accepted: nothing here changes it.
// A realm adds them from its own authority's events (a room's hit words, a local battle's log) and
// draws each live one with its own text routine from floats_look: where it is as it rises, how
// strongly it shows, its size and colour by kind.
//   coax/bin/coax test aethyr/action/floats.coax --library

#module "aethyr.action.floats";
#load "react.coax" as react;
#load "../space.coax";

FLOATS :: 12;               // numbers live at once (the oldest gives way)
FLOAT_TEXT :: 16;
FLOAT_LIFE :: 1.2;          // seconds one shows
FLOAT_RISE :: 0.9;          // metres it rises over its life
FLOAT_TAKEN :: 0; FLOAT_DEALT :: 1; FLOAT_MISS :: 2; FLOAT_HEAL :: 3; FLOAT_WORD :: 4;
// A result on a thing you aimed at, not a creature (a target's points): drawn as dealt damage is, and
// a realm shows it wherever its point is on screen, however far, never culled by sight or distance.
FLOAT_MARK :: 5;

FloatNum :: struct { on: bool; x: f32; y: f32; z: f32; t0: f32; kind: int; crit: bool; text: [FLOAT_TEXT] u8; n: int; }
Floats :: struct { items: [FLOATS] FloatNum; present: react.PresentQueue; per_source: int = 4; shown: int; suppressed: int; }
// How one shows now: ok false once it is done. (x, y, z) where it is, alpha its strength, size a
// share of the realm's text size (a miss small, a critical hit large), (r, g, b) its colour.
FloatLook :: struct { ok: bool; x: f32; y: f32; z: f32; alpha: f32; size: f32; r: f32; g: f32; b: f32; }

// A result over (x, y, z) at t0 from source (a realm's own numbering: 0 you, others a creature),
// through react_present's cap. False when it was suppressed (counted).
floats_add :: (f: [] Floats, source: int, x: f32, y: f32, z: f32, t0: f32, kind: int, crit: bool, text: string) -> bool {
  f[0].present.per_source = f[0].per_source;
  before := f[0].present.suppressed;
  f[0].present = react.react_present(f[0].present, react.PresentEvent.{kind = react.PresentKind.number, source = source, at = world_point(x, y, z),
                                                                        priority = ifx kind == FLOAT_TAKEN || crit then 3 else ifx kind == FLOAT_HEAL then 2 else 1});
  if f[0].present.suppressed > before { f[0].suppressed += 1; return false; }
  f[0].shown += 1;
  q := 0; oldest := 1e9f32;
  for i: 0..<FLOATS { if !f[0].items[i].on { q = i; break; } if f[0].items[i].t0 < oldest { oldest = f[0].items[i].t0; q = i; } }
  one := FloatNum.{on = true, x = x, y = y, z = z, t0 = t0, kind = kind, crit = crit};
  for ch: text { if one.n < FLOAT_TEXT { one.text[one.n] = ch; one.n += 1; } }
  f[0].items[q] = one;
  return true;
}
// An amount: damage as "-N" (taken or dealt), a heal or a target's points as "+N", a miss (amount 0 of damage) as "miss".
floats_amount :: (f: [] Floats, source: int, x: f32, y: f32, z: f32, t0: f32, kind: int, crit: bool, amount: int) -> bool {
  if (kind == FLOAT_TAKEN || kind == FLOAT_DEALT || kind == FLOAT_MARK) && amount <= 0 { return floats_add(f, source, x, y, z, t0, FLOAT_MISS, false, "miss"); }
  b: [FLOAT_TEXT] u8; n := 0;
  b[0] = ifx kind == FLOAT_HEAL || kind == FLOAT_MARK then '+' else '-'; n = 1;   // a target's points are a score, not harm
  v := ifx amount < 0 then -amount else amount;
  digits: [12] u8; d := 0;
  while true { digits[d] = cast(u8)(48 + v % 10); d += 1; v = v / 10; if v == 0 || d >= 12 { break; } }
  while d > 0 && n < FLOAT_TEXT { d -= 1; b[n] = digits[d]; n += 1; }
  return floats_add(f, source, x, y, z, t0, kind, crit, cast(string) b[0..<n]);
}
// The frame's end: the queue is handed on and emptied (its counts stay).
floats_frame :: (f: [] Floats) { f[0].present = react.react_present_drain(f[0].present); }
floats_text :: (f: [] Floats, i: int) -> string { return cast(string) f[0].items[i].text[0..<f[0].items[i].n]; }
floats_look :: (n: FloatNum, now: f32) -> FloatLook {
  if !n.on { return FloatLook.{}; }
  t := (now - n.t0) / f32(FLOAT_LIFE);
  if t < 0 || t > 1 { return FloatLook.{}; }
  l := FloatLook.{ok = true, x = n.x, y = n.y + t * f32(FLOAT_RISE), z = n.z, alpha = 1 - t * t, size = 1, r = 1, g = 0.85, b = 0.4};
  if n.kind == FLOAT_TAKEN { l.r = 1; l.g = 0.28; l.b = 0.24; }
  if n.kind == FLOAT_MISS { l.size = 0.7; l.r = 0.82; l.g = 0.82; l.b = 0.82; }
  if n.kind == FLOAT_HEAL { l.r = 0.5; l.g = 0.95; l.b = 0.55; }
  if n.kind == FLOAT_WORD { l.size = 0.75; l.r = 1; l.g = 0.92; l.b = 0.7; }
  if n.crit {
    // a critical hit: larger, brighter, and it swells as it starts
    l.size *= 1.5 + 0.35 * (1 - (ifx t < 0.15 then t / 0.15 else 1.0f32));
    if n.kind == FLOAT_TAKEN { l.g = 0.12; l.b = 0.1; } else { l.r = 1; l.g = 0.62; l.b = 0.12; }
  }
  return l;
}

#test "floats: each amount is one number, through react_present's cap; misses say miss; crits stand out" {
  f: [1] Floats;
  #assert floats_amount(f[..], 0, 0, 2, 0, 1, FLOAT_TAKEN, false, 7);
  #assert floats_text(f[..], 0) == "-7" && f[0].items[0].kind == FLOAT_TAKEN;
  #assert floats_amount(f[..], 1, 0, 2, 0, 1, FLOAT_DEALT, false, 0) && floats_text(f[..], 1) == "miss" && f[0].items[1].kind == FLOAT_MISS;
  #assert floats_amount(f[..], 1, 0, 2, 0, 1, FLOAT_HEAL, false, 12) && floats_text(f[..], 2) == "+12";
  #assert floats_amount(f[..], 2, 0, 2, 0, 1, FLOAT_TAKEN, true, 19);
  plain := floats_look(f[0].items[0], 1.05); crit := floats_look(f[0].items[3], 1.05); miss := floats_look(f[0].items[1], 1.05);
  #assert plain.ok && crit.size > plain.size * 1.4 && miss.size < plain.size && plain.r == 1 && plain.g < 0.3;
  #assert !floats_look(f[0].items[0], 1 + f32(FLOAT_LIFE) + 0.01).ok && floats_look(f[0].items[0], 1.6).y > 2;
  // one source past its cap in a frame is suppressed and counted; the next frame takes it
  for i: 0..<6 { _ := floats_amount(f[..], 5, 0, 2, 0, 2, FLOAT_DEALT, false, 3); }
  #assert f[0].suppressed == 2 && f[0].shown == 8;
  floats_frame(f[..]);
  #assert floats_amount(f[..], 5, 0, 2, 0, 3, FLOAT_DEALT, false, 3) && f[0].suppressed == 2;
}
