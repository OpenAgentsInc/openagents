// Its checks, with the checks files it loads: coax/bin/coax test --library aethyr/actors/instances.coax
// Realm-owned actor slots. Entity visibility still changes at entity_flush;
// the caller applies lifecycle edits and begin only on its paid fixed step.
#authority;
#load "resources.coax";
#load "definitions.coax";
#load "behavior.coax";
#load "behavior-plan.coax";
#load "../core/entity.coax" as entities;
#load "../core/ids.coax" as ids;
#load "../core/space.coax" as points;
#load "../ai/stimulus.coax" as senses;
#load "../core/loop.coax" as clock;
#load "../core/assets.coax" as assets;
#load "../render/registry.coax" as gpu;
ACTOR_POOL_SLOTS :: 16;
ACTOR_EMPTY :: 0; ACTOR_LOADING :: 1; ACTOR_BORN :: 2; ACTOR_LIVE :: 3; ACTOR_RETIRING :: 4; ACTOR_REMOVED :: 5; ACTOR_PRESSURE :: 6;
ActorStatus :: enum u8 {ok;invalid;plan;identity;duplicate;capacity;budget;resources;clock;exhausted;}
ActorKey :: struct {slot:int= -1;actor:int;generation:int;owner:int;epoch:int;}
ActorSpawn :: struct {id:int;seed:int;placement:points.Placement;}
ActorSlot :: struct {
 phase:int;key:ActorKey;archetype:int;revision:int;work:[3]int;resources:ActorResources;
 entity:Handle(entities.Entity);entity_id:ids.EntityId;placement:points.Placement;control:int;
 brain:BehaviorState;memory:senses.Memory;
}
ActorPool :: struct {
 valid:bool;epoch:int;tick:int;capacity:int;serial:int;caps:[3]int;used:[3]int;peaks:[3]int;
 count:int;peak:int;refused:int;slots:[ACTOR_POOL_SLOTS]ActorSlot;
}
ActorReceipt :: struct {status:ActorStatus=ActorStatus.invalid;key:ActorKey;}
ActorLifeEvent :: struct {key:ActorKey;kind:int;}
ActorLifecycle :: struct {status:ActorStatus=ActorStatus.invalid;n:int;events:[ACTOR_POOL_SLOTS]ActorLifeEvent;}
ActorTransfer :: struct {status:ActorStatus=ActorStatus.invalid;key:ActorKey;interrupted:bool;event:BehaviorEvent;}
#load "tests/instances.coax" #test;

actor_pool_open :: (epoch:int,tick:int,capacity:int,caps:[3]int)->ActorPool #effects(all) {
 if epoch<1 || epoch>BEHAVIOR_COUNTER_MAX || tick<0 || tick>BEHAVIOR_COUNTER_MAX || capacity<1 || capacity>ACTOR_POOL_SLOTS {return ActorPool.{};}
 for v,i:caps {if v<0 || v>[3]int.[1024,65536,512][i] {return ActorPool.{};}}
 return ActorPool.{valid=true,epoch=epoch,tick=tick,capacity=capacity,caps=caps};
}
actor_key_equal :: (a:ActorKey,b:ActorKey)->bool #effects(all) {return a.slot==b.slot && a.actor==b.actor && a.generation==b.generation && a.owner==b.owner && a.epoch==b.epoch;}
actor_pool_matches :: (pool:[]ActorPool,key:ActorKey)->bool #effects(all) {
 return pool[0].valid && key.slot>=0 && key.slot<pool[0].capacity && pool[0].slots[key.slot].phase!=ACTOR_EMPTY && actor_key_equal(pool[0].slots[key.slot].key,key);
}
actor_pool_refuse :: (pool:[]ActorPool,status:ActorStatus)->ActorReceipt #effects(all) {pool[0].refused=add_sat(pool[0].refused,1);return ActorReceipt.{status=status};}
actor_pool_request :: (pool:[]ActorPool,a:ActorArchetype,p:BehaviorPlan,spawn:ActorSpawn,s:[]ResourceStream,m:[]ResourceManifest)->ActorReceipt #effects(all) {
 if !pool[0].valid || spawn.id<1 || !resource_stream_bound(s,m) || s[0].epoch!=pool[0].epoch {return actor_pool_refuse(pool,ActorStatus.identity);}
 for v:[4]f32.[spawn.placement.origin.x,spawn.placement.origin.y,spawn.placement.origin.z,spawn.placement.yaw] {if !(v>= -1000000000 && v<=1000000000) {return actor_pool_refuse(pool,ActorStatus.invalid);}}
 if !(spawn.placement.yaw>= -1000000 && spawn.placement.yaw<=1000000) {return actor_pool_refuse(pool,ActorStatus.invalid);}
 if !a.valid || p.archetype!=a.id || p.archetype_revision!=a.revision || !assets.asset_same(a.schema,p.schema) {return actor_pool_refuse(pool,ActorStatus.plan);}
 work:[3]int;for parameter,i:[3]int.[ACTOR_SENSE_WORK,ACTOR_SEARCH_WORK,ACTOR_ACTION_WORK] {
  value:=a.parameters[parameter];if value.kind!=STATE_INT || value.integer<1 || value.integer>[3]int.[64,4096,32][i] {return actor_pool_refuse(pool,ActorStatus.plan);}work[i]=value.integer;
 }
 maximum:=a.parameters[ACTOR_INSTANCES];if maximum.kind!=STATE_INT || maximum.integer<1 || maximum.integer>64 || p.work!=work[2] {return actor_pool_refuse(pool,ActorStatus.plan);}
 at:= -1;similar:=0;for i:0..<pool[0].capacity {
  slot:=pool[0].slots[i];if slot.phase==ACTOR_EMPTY {if at<0 {at=i;}}else {
   if slot.key.actor==spawn.id {return actor_pool_refuse(pool,ActorStatus.duplicate);}if slot.archetype==a.id {similar+=1;}
  }
 }
 if at<0 || similar>=maximum.integer {return actor_pool_refuse(pool,ActorStatus.capacity);}
 for v,i:work {if v>pool[0].caps[i]-pool[0].used[i] {return actor_pool_refuse(pool,ActorStatus.budget);}}
 if pool[0].serial==BEHAVIOR_COUNTER_MAX {return actor_pool_refuse(pool,ActorStatus.exhausted);}
 generation:=pool[0].serial+1;cursor:=behavior_open(p,spawn.id,generation,1,pool[0].epoch,spawn.seed,pool[0].tick);
 if !cursor.ready {return actor_pool_refuse(pool,ActorStatus.plan);}
 lease:=actor_resources_hold(a,s,m);if !lease.valid {return actor_pool_refuse(pool,ActorStatus.resources);}
 key:=ActorKey.{slot=at,actor=spawn.id,generation=generation,owner=1,epoch=pool[0].epoch};
 pool[0].slots[at]=ActorSlot.{phase=ACTOR_LOADING,key=key,archetype=a.id,revision=a.revision,work=work,resources=lease,placement=spawn.placement,brain=cursor};
 // Differences and sums are bounded by the admitted fixed pool capacities;
 // their conversion to f64 and back is exact (the largest cap is 65,536).
 pool[0].serial=generation;pool[0].count+=1;difference:=pool[0].count-pool[0].peak;pool[0].peak+=(difference+cast(int)abs(f64(difference)))/2;
 for v,i:work {pool[0].used[i]+=v;delta:=pool[0].used[i]-pool[0].peaks[i];pool[0].peaks[i]+=(delta+cast(int)abs(f64(delta)))/2;}return ActorReceipt.{status=ActorStatus.ok,key=key};
}
actor_pool_current :: (pool:[]ActorPool,key:ActorKey,world:entities.EntityStore,s:[]ResourceStream,m:[]ResourceManifest)->bool #effects(all) {
 if !actor_pool_matches(pool,key) {return false;}slot:=pool[0].slots[key.slot];
 return slot.phase==ACTOR_LIVE && entities.entity_alive(world,slot.entity) && entities.entity_id(world,slot.entity)==slot.entity_id && actor_resources_ready(slot.resources,s,m);
}
actor_pool_stop :: (pool:[]ActorPool,key:ActorKey,world:entities.EntityStore)->bool #effects(all) {
 if !actor_pool_matches(pool,key) || pool[0].slots[key.slot].phase==ACTOR_RETIRING {return false;}
 pool[0].slots[key.slot].phase=ACTOR_RETIRING;entities.entity_despawn(world,pool[0].slots[key.slot].entity);return true;
}
actor_pool_begin :: (pool:[]ActorPool,world:entities.EntityStore,s:[]ResourceStream,m:[]ResourceManifest,paid:clock.FrameClock)->ActorLifecycle #effects(all) {
 if !pool[0].valid || !resource_stream_bound(s,m) || s[0].epoch!=pool[0].epoch {return ActorLifecycle.{status=ActorStatus.identity};}
 if pool[0].tick==BEHAVIOR_COUNTER_MAX || paid.ticks!=pool[0].tick+1 || paid.step_ns!=clock.LOOP_STEP_NS || paid.due!=0 || paid.ran<1 || paid.ran>paid.max_steps || paid.max_steps>clock.LOOP_MAX_STEPS || paid.counted_ns<0 || paid.counted_ns>paid.max_frame_ns || paid.max_frame_ns<1 || paid.max_frame_ns>clock.LOOP_MAX_FRAME_NS || paid.carry_ns<0 || paid.carry_ns>=paid.step_ns*paid.max_steps || paid.frames<1 {return ActorLifecycle.{status=ActorStatus.clock};}
 out:=ActorLifecycle.{status=ActorStatus.ok};
 // resource_stream_retire revokes every claim at once. The actor's own
 // retained receipt then ceases to be droppable, but cannot retain quotas
 // after the entity is gone. Physical owners and borrowers still retire in
 // the stream. A merely closing record with live claims uses normal drop.
 revoked:=s[0].closing;for claim:s[0].claims {if claim.live {revoked=false;}}
 for i:0..<pool[0].capacity {
  slot:=pool[0].slots[i];if slot.phase==ACTOR_EMPTY {continue;}kind:=0;
  if slot.phase==ACTOR_RETIRING {
   // Every transition into retirement has already queued the despawn.
   if !entities.entity_alive(world,slot.entity) && !entities.entity_waiting(world,slot.entity) {
    lease:=[1]ActorResources.[slot.resources];
    released:=revoked;if !released {released=actor_resources_drop(lease[..],s,m);}
    if released {
     for v,k:slot.work {pool[0].used[k]-=v;}pool[0].count-=1;pool[0].slots[i]=ActorSlot.{};kind=ACTOR_REMOVED;
    }else {kind=ACTOR_PRESSURE;pool[0].refused=add_sat(pool[0].refused,1);}
   }
  }else if s[0].closing || !actor_resources_bound(slot.resources,s,m) ||
   (slot.phase==ACTOR_LIVE && (!entities.entity_alive(world,slot.entity) || entities.entity_id(world,slot.entity)!=slot.entity_id || !actor_resources_ready(slot.resources,s,m))) ||
   (slot.phase==ACTOR_BORN && ((!entities.entity_alive(world,slot.entity) && !entities.entity_waiting(world,slot.entity)) ||
    (entities.entity_alive(world,slot.entity) && entities.entity_id(world,slot.entity)!=slot.entity_id))) {
   pool[0].slots[i].phase=ACTOR_RETIRING;entities.entity_despawn(world,slot.entity);kind=ACTOR_RETIRING;
  }else if slot.phase==ACTOR_LOADING && actor_resources_ready(slot.resources,s,m) {
   born:=entities.entity_spawn(world);
   if born.handle==entities.ENTITY_NONE {kind=ACTOR_PRESSURE;pool[0].refused=add_sat(pool[0].refused,1);}
   else {pool[0].slots[i].entity=born.handle;pool[0].slots[i].entity_id=born.id;pool[0].slots[i].phase=ACTOR_BORN;kind=ACTOR_BORN;}
  }else if slot.phase==ACTOR_BORN && entities.entity_alive(world,slot.entity) && actor_resources_ready(slot.resources,s,m) {
   pool[0].slots[i].phase=ACTOR_LIVE;pool[0].slots[i].brain.tick=paid.ticks-1;kind=ACTOR_LIVE;
  }
  if kind!=0 {out.events[out.n]=ActorLifeEvent.{key=slot.key,kind=kind};out.n+=1;}
 }
 pool[0].tick=paid.ticks;return out;
}
actor_pool_select :: (pool:[]ActorPool,key:ActorKey,world:entities.EntityStore,s:[]ResourceStream,m:[]ResourceManifest,p:BehaviorPlan,paid:clock.FrameClock,f:BehaviorFacts,c:BehaviorContext)->BehaviorResult #effects(all) {
 if !actor_pool_current(pool,key,world,s,m) {return BehaviorResult.{status=BehaviorStatus.identity};}
 live:=pool[0].slots[key.slot].brain;if paid.ticks!=pool[0].tick {return BehaviorResult.{status=BehaviorStatus.clock,state=live};}
 result:=behavior_step(p,live,paid,f,c);if result.status==BehaviorStatus.ok {pool[0].slots[key.slot].brain=result.state;}return result;
}
actor_pool_transfer :: (pool:[]ActorPool,key:ActorKey,world:entities.EntityStore,s:[]ResourceStream,m:[]ResourceManifest,control:int,p:BehaviorPlan)->ActorTransfer #effects(all) {
 if !actor_pool_current(pool,key,world,s,m) {return ActorTransfer.{status=ActorStatus.identity};}slot:=pool[0].slots[key.slot];
 if control<0 || control>1 || control==slot.control || !behavior_state_ok(p,slot.brain) {return ActorTransfer.{};}
 if key.owner==BEHAVIOR_COUNTER_MAX {return ActorTransfer.{status=ActorStatus.exhausted};}
 result:=[1]BehaviorResult.[BehaviorResult.{state=slot.brain}];interrupted:=slot.brain.selected>=0;
 if interrupted && !behavior_finish(result[..],p,pool[0].tick,slot.brain.serial,BEHAVIOR_INTERRUPTED,true) {return ActorTransfer.{status=ActorStatus.exhausted};}
 slot.key.owner+=1;slot.brain=result[0].state;slot.brain.owner=slot.key.owner;slot.control=control;pool[0].slots[key.slot]=slot;
 return ActorTransfer.{status=ActorStatus.ok,key=slot.key,interrupted=interrupted,event=result[0].events[0]};
}
