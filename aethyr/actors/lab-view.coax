ACTOR_LAB_LABELS :: [16]string.["GATE [B]","WATER [T]","NEXT DAY [N]","SAVE [P]","LOAD [L]","RETRY [C]","GUARD DATA [R]","UNLOAD [J]","RESPAWN [F]","PATH CAP [X]","STALE MODEL [O]","RIDE [G]","EDITOR [E]","VISUAL [V]","Actor Lab | WASD / arrows","Guard: gold  Villager: coral  Mount: blue"];
actor_lab_text :: (s:[]ActorLab,index:int)->string #export_c #effects(all) {return ifx index>=0 && index<16 then ACTOR_LAB_LABELS[index] else "";}
actor_lab_view :: (s:[]ActorLab,width:f32,height:f32) #export_c #effects(all) {
 if !s[0].ready || width<200 || height<300 {s[0].world[0].rect_n=0;return;}s[0].width=width;s[0].height=height;s[0].world[0].rect_n=0;
 cols:=ifx width>=800 then 7 else 3;rows:=(14+cols-1)/cols;available:=height-f32(rows)*40-100;mapw:=ifx width-32<available*2 then width-32 else available*2;scale:=mapw/16;x0:=(width-mapw)/2;y0:f32=48;
 state_lab_box(s[0].world[..],x0,y0,mapw,mapw/2,0.10,0.23,0.17);
 for i:0..<17 {state_lab_box(s[0].world[..],x0+f32(i)*scale,y0,0.5,mapw/2,0.23,0.32,0.24);}for i:0..<9 {state_lab_box(s[0].world[..],x0,y0+f32(i)*scale,mapw,0.5,0.23,0.32,0.24);}
 state_lab_box(s[0].world[..],x0+2*scale,y0+2*scale,3*scale,3*scale,0.10,0.29,0.7);
 for i:0..<7 {at:=i*6;box:=s[0].world[0].walls;left:=ifx box[at]<0 then 0.0f32 else box[at];right:=ifx box[at+3]>16 then 16.0f32 else box[at+3];near:=ifx box[at+2]<0 then 0.0f32 else box[at+2];far:=ifx box[at+5]>8 then 8.0f32 else box[at+5];
  if left<right && near<far {state_lab_box(s[0].world[..],x0+left*scale,y0+near*scale,(right-left)*scale,(far-near)*scale,0.46,0.45,0.36);}
 }
 for anchor:ACTOR_LAB_ANCHORS {state_lab_box(s[0].world[..],x0+(f32(anchor.x)/100-0.08)*scale,y0+(f32(anchor.z)/100-0.08)*scale,scale*0.16,scale*0.16,0.45,0.8,0.52);}
 player:=s[0].world[0].player.body.pos;state_lab_box(s[0].world[..],x0+(player.x-0.16)*scale,y0+(player.z-0.16)*scale,scale*0.32,scale*0.32,0.94,0.96,0.88);
 store:=actor_entity_store(s[0].actors[..]);for i:0..<3 {h:=s[0].handles[i];if !entities.entity_alive(store,h) {continue;}a:=s[0].actors[0].actors[entities.entity_slot(h)];attributes:=actor_attributes(s[0].actors[..],h);x:=a.presentation_x;z:=a.presentation_z;
  state_lab_box(s[0].world[..],x0+(x-0.24)*scale,y0+(z-0.24)*scale,scale*0.48,scale*0.48,ifx i==2 then 0.3 else 0.94,ifx i==0 then 0.78 else ifx i==1 then 0.43 else 0.65,ifx i==2 then 0.95 else 0.28);
  if attributes.controlled {state_lab_box(s[0].world[..],x0+(x-0.27)*scale,y0+(z+0.26)*scale,scale*0.54,scale*0.07,0.93,0.96,0.98);}
  if a.perception.seen || attributes.interacting || attributes.airborne {state_lab_box(s[0].world[..],x0+(x-0.06)*scale,y0+(z-0.4)*scale,scale*0.12,scale*0.08,1,1,0.6);}
 }
 bottom:=y0+mapw/2+18;button:=(width-32-f32(cols-1)*8)/f32(cols);
 for i:0..<14 {x:=16+f32(i%cols)*(button+8);y:=bottom+f32(i/cols)*40;state_lab_box(s[0].world[..],x,y,button,32,0.16,0.2,0.23);state_lab_rect(s[0].world[..],StateLabRect.{x=x+6,y=y+21,h=ifx cols==3 then 10 else 12,r=0.86,g=0.9,b=0.82,kind=f32(i+1)});}
 state_lab_rect(s[0].world[..],StateLabRect.{x=16,y=22,h=16,r=0.92,g=0.94,b=0.86,kind=15});state_lab_rect(s[0].world[..],StateLabRect.{x=16,y=height-14,h=ifx width<800 then 9 else 12,r=0.82,g=0.9,b=0.8,kind=16});
}
actor_lab_hit :: (s:[]ActorLab,x:f32,y:f32) #export_c #effects(all) {
 cols:=ifx s[0].width>=800 then 7 else 3;button:=(s[0].width-32-f32(cols-1)*8)/f32(cols);
 for i:0..<s[0].world[0].rect_n {r:=s[0].world[0].rects[i];if r.kind>=1 && r.kind<=14 && x>=r.x-6 && x<r.x-6+button && y>=r.y-21 && y<r.y+11 {actor_lab_action(s,int(r.kind)-1);return;}}
}
actor_lab_key :: (s:[]ActorLab,key:string,down:bool) #export_c #effects(all) {
 keys:=[18]string.["a","d","w","s","b","t","n","p","l","c","r","j","f","x","o","g","e","v"];lower:[1]u8;name:=key;
 if key.count==1 {lower[0]=key[0];if lower[0]>='A' && lower[0]<='Z' {lower[0]+=32;}name=cast(string)lower[..];}
 for k,i:keys {if name==k {s[0].keys[i]=input.input_level(s[0].keys[i],down);return;}}
 arrows:=[4]string.["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"];for k,i:arrows {if name==k {s[0].keys[i]=input.input_level(s[0].keys[i],down);return;}}
}
