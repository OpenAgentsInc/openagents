#module "aethyr.actors.pool";
// Deferred instances compose existing entity generations and RCM1 ownership.
#load "perception.coax";
#load "navigation.coax";
#load "../state/variants.coax";
#load "../core/entity.coax" as entities;
#load "../move/walk.coax" as walking;
#load "../ai/decide.coax" as decisions;
#load "../core/assets.coax" as assets;
#authority;
ACTOR_EXEC_SLOTS :: 16;
ActorControl :: struct {x:int;z:int;jump:bool;}
ActorExecInstance :: struct {
 definition:ActorProfile;archetype:assets.AssetId;overrides:ActorOverrides;scope_home:int=1;scope_enabled:bool=true;day_ticks:int=5529600;handle:Handle(entities.Entity);id:int;owner:int #counter;controller:int;
 facts:StateStore;brain:ActorBrain;perception:ActorPerception;navigation:ActorNavigation;
 body:walking.Player;home_x:int;home_z:int;input:ActorControl;choice:ActorChoice;
 members:[6]ResourceReference;flow:[128]f32;last_anchor:int;goal_x:int;goal_z:int;reset_sequence:int;reset_owner:int;model:decisions.DecideIntent;model_world:int;model_nav:int;pose_tick:int= -1;presentation_x:f32;presentation_z:f32;
}
ActorLimits :: struct {capacity:int=16;scans:int=256;senses:int=64;search:int=2048;choices:int=512;bytes:int=1048576;}
ActorExecPool :: struct {
 ready:bool;limits:ActorLimits;gen:[ACTOR_EXEC_SLOTS]int;live:[ACTOR_EXEC_SLOTS]bool;born:[ACTOR_EXEC_SLOTS]bool;doomed:[ACTOR_EXEC_SLOTS]bool;
 ids:[ACTOR_EXEC_SLOTS]int;free:[ACTOR_EXEC_SLOTS]int;spawns:[ACTOR_EXEC_SLOTS]int;n:[entities.ENTITY_COUNTERS]int;
 actors:[ACTOR_EXEC_SLOTS]ActorExecInstance;models:[1]decisions.DecideTable;
 scan_cap:int;sense_cap:int;search_cap:int;choice_cap:int;refused:int;tick:int= -1;hooks:[3]int;
}
ActorSpawnResult :: struct {status:int=ACTOR_INVALID;handle:Handle(entities.Entity);id:int;}
#load "tests/pool.coax";
#load "tests/pool-edges.coax";
actor_entity_store :: (p:[]ActorExecPool)->entities.EntityStore #effects(all) {return entities.EntityStore.{gen=p[0].gen[..],live=p[0].live[..],born=p[0].born[..],doomed=p[0].doomed[..],ids=p[0].ids[..],free=p[0].free[..],spawns=p[0].spawns[..],n=p[0].n[..]};}
actor_exec_pool_open :: (p:[]ActorExecPool,limits:ActorLimits)->bool #effects(all) {
 if p.count!=1 || p[0].ready || limits.capacity<1 || limits.capacity>ACTOR_EXEC_SLOTS || limits.scans<1 || limits.scans>256 || limits.senses<1 || limits.senses>256 || limits.search<1 || limits.search>2048 || limits.choices<1 || limits.choices>512 || (limits.bytes<size_of(ActorExecPool) || limits.bytes>16777216) {return false;}
 p[0]=ActorExecPool.{ready=true,limits=limits};decisions.decide_table(p[0].models[..]);return true;
}
actor_instance_schema :: (id:int,home:int)->StateSchema #effects(all) {
 s:=StateSchema.{id=1299201,n=2};s.fields[0]=StateField.{id=1,name="actor.enabled",scope=STATE_ACTOR,owner=id,kind=STATE_BOOL,initial=state_bool(true),resets=65};
 s.fields[1]=StateField.{id=2,name="actor.home",scope=STATE_ACTOR,owner=id,high=16,low=1,initial=state_int(home),resets=65};return s;
}
actor_definition_admit :: (d:ActorProfile,schema:StateSchema,refs:StateRefs,anchors:int)->bool #effects(all) {
 if !d.valid || !assets.asset_same(d.schema,state_schema_id(schema)) {return false;}
 author:=[1]ActorAuthor.[ActorAuthor.{id=d.id,revision=d.revision,parameters=d.parameters}];check:=actor_compile(author[..],schema,refs,anchors);if check.status!=ACTOR_OK || !assets.asset_same(d.content,check.items[0].content) {return false;}
 for i:0..<ACTOR_EXEC_PHASES {if d.order[i]!=check.items[0].order[i] {return false;}}
 for i:0..<d.parameters.rows {if d.parameters.schedule[i].index!=check.items[0].parameters.schedule[i].index {return false;}}return true;
}
actor_spawn :: (p:[]ActorExecPool,d:ActorProfile,schema:StateSchema,refs:StateRefs,anchors:int,m:[]ResourceManifest,pool:[]ResourceStream,world:StateWorld,x:int,z:int,tick:int)->ActorSpawnResult #effects(all) {
 out:ActorSpawnResult;if p.count!=1 || !p[0].ready || !state_store_ok(schema,world.facts,refs) || !actor_flat_point_ok(x,z) || tick<0 || tick>1000000000 || !actor_definition_admit(d,schema,refs,anchors) || !resource_stream_bound(pool,m) || world.variant<0 {return out;}
 store:=actor_entity_store(p);par:=d.parameters;
 if entities.entity_count(store)+p[0].n[entities.ENTITY_SPAWNS]>=p[0].limits.capacity || p[0].scan_cap+16>p[0].limits.scans || p[0].sense_cap+par.sense_work>p[0].limits.senses || p[0].search_cap+par.path_work>p[0].limits.search || p[0].choice_cap+4*par.n>p[0].limits.choices {out.status=ACTOR_CAPACITY;return out;}
 members:[6]ResourceReference;for _,i:members {if (par.resources&(cast(u32)1<<cast(u32)i))!=0 {
  ref:=world.members[i];if ref.slot<0 || ref.slot>=RESOURCE_STREAM_REFERENCES || ref.epoch!=pool[0].epoch {out.status=ACTOR_RESOURCES;return out;}
  c:=pool[0].claims[ref.slot];if !c.live || c.serial!=ref.serial || !resource_stream_ready(pool,c.root) {out.status=ACTOR_RESOURCES;return out;}
 }}
 for _,i:members {if (par.resources&(cast(u32)1<<cast(u32)i))!=0 {root:=pool[0].claims[world.members[i].slot].root;members[i]=resource_stream_hold(pool,m,root);if members[i].slot<0 {for j:0..<i {dropped:=resource_stream_drop(pool,m,members[j]);}out.status=ACTOR_CAPACITY;return out;}}}
 spawned:=entities.entity_spawn(store);if spawned.handle==entities.ENTITY_NONE {for ref:members {dropped:=resource_stream_drop(pool,m,ref);}out.status=ACTOR_CAPACITY;return out;}
 slot:=entities.entity_slot(spawned.handle);owner:=add_sat(entities.entity_generation(spawned.handle).value,1);
 actor:=ActorExecInstance.{definition=d,archetype=d.content,day_ticks=schema.day_ticks,handle=spawned.handle,id=spawned.id.value,owner=owner,members=members,home_x=x,home_z=z,goal_x=x,goal_z=z};
 scope:=actor_scope_schema(actor);actor.facts=state_construct(scope,StateRefs.{},owner);actor.body=walking.walk_place(f32(x)/100,0,f32(z)/100,0);actor.body.cam.theta=0;actor.presentation_x=actor.body.body.pos.x;actor.presentation_z=actor.body.body.pos.z;
 actor.facts.tick=tick;actor.facts.day=world.facts.day;actor.facts.phase=world.facts.phase;actor.brain.tick=tick;actor.perception.tick=tick;p[0].actors[slot]=actor;p[0].scan_cap+=16;p[0].sense_cap+=par.sense_work;p[0].search_cap+=par.path_work;p[0].choice_cap+=4*par.n;
 decisions.decide_transfer(p[0].models[..],slot);p[0].models[0].catalogue[slot]=decisions.DECIDE_ALL;
 if (par.hooks&1)!=0 {p[0].hooks[0]+=1;}out.status=ACTOR_OK;out.handle=spawned.handle;out.id=actor.id;return out;
}
actor_flush :: (p:[]ActorExecPool,m:[]ResourceManifest,pool:[]ResourceStream) #effects(all) {
 if p.count!=1 || !p[0].ready {return;}store:=actor_entity_store(p);
 for i:0..<ACTOR_EXEC_SLOTS {if p[0].doomed[i] && p[0].actors[i].id>0 {a:=p[0].actors[i];for ref:a.members {dropped:=resource_stream_drop(pool,m,ref);}
  par:=a.definition.parameters;if (par.hooks&2)!=0 {p[0].hooks[1]+=1;}p[0].scan_cap-=16;p[0].sense_cap-=par.sense_work;p[0].search_cap-=par.path_work;p[0].choice_cap-=4*par.n;decisions.decide_transfer(p[0].models[..],i);p[0].actors[i]=ActorExecInstance.{};
 }}entities.entity_flush(store);
}
actor_remove :: (p:[]ActorExecPool,h:Handle(entities.Entity))->bool #effects(all) {
 if p.count!=1 || !p[0].ready {return false;}store:=actor_entity_store(p);if !entities.entity_alive(store,h) && !entities.entity_waiting(store,h) {return false;}if p[0].actors[entities.entity_slot(h)].id<1 {return false;}entities.entity_despawn(store,h);return true;
}
actor_handoff :: (p:[]ActorExecPool,h:Handle(entities.Entity),owner:int,controller:int)->bool #effects(all) {
 if p.count!=1 || !p[0].ready {return false;}store:=actor_entity_store(p);if !entities.entity_alive(store,h) || entities.entity_doomed(store,h) || controller<0 || controller>1 {return false;}i:=entities.entity_slot(h);a:=p[0].actors[i];
 if a.id<1 || a.owner!=owner || a.owner>=1000000000 || (controller==1 && a.definition.parameters.controller!=1) {return false;}
 a.owner=add_sat(a.owner,1);a.controller=controller;a.input=ActorControl.{};a.reset_sequence=0;a.navigation.status=ACTOR_NAV_INVALIDATED;a.model=decisions.DecideIntent.{};a.brain.rule= -1;
 p[0].actors[i]=a;decisions.decide_transfer(p[0].models[..],i);return true;
}
actor_control :: (p:[]ActorExecPool,h:Handle(entities.Entity),owner:int,c:ActorControl)->bool #effects(all) {
 if p.count!=1 || !p[0].ready {return false;}store:=actor_entity_store(p);if !entities.entity_alive(store,h) || entities.entity_doomed(store,h) || c.x< -100 || c.x>100 || c.z< -100 || c.z>100 {return false;}i:=entities.entity_slot(h);
 if p[0].actors[i].id<1 || p[0].actors[i].owner!=owner || p[0].actors[i].controller!=1 || p[0].actors[i].facts.values[0].integer!=1 {return false;}p[0].actors[i].input=c;return true;
}

actor_editor_reset :: (p:[]ActorExecPool,h:Handle(entities.Entity),owner:int,sequence:int)->bool #effects(all) {
 if p.count!=1 || !p[0].ready || sequence<1 || sequence>1000000000 {return false;}store:=actor_entity_store(p);
 if !entities.entity_alive(store,h) || entities.entity_doomed(store,h) {return false;}i:=entities.entity_slot(h);a:=p[0].actors[i];
 if a.id<1 || a.owner!=owner || sequence<=a.facts.sequence || a.reset_sequence!=0 {return false;}
 p[0].actors[i].reset_sequence=sequence;p[0].actors[i].reset_owner=owner;return true;
}

actor_scope_schema :: (a:ActorExecInstance)->StateSchema #effects(all) {
 s:=actor_instance_schema(a.id,a.scope_home);s.day_ticks=a.day_ticks;s.fields[0].initial=state_bool(a.scope_enabled);return s;
}
actor_spawn_with :: (p:[]ActorExecPool,d:ActorProfile,schema:StateSchema,refs:StateRefs,anchors:int,m:[]ResourceManifest,pool:[]ResourceStream,world:StateWorld,x:int,z:int,tick:int,o:ActorOverrides)->ActorSpawnResult #effects(all) {
 if o.mask>15 || !actor_definition_admit(d,schema,refs,anchors) {return ActorSpawnResult.{};}
 derived:=d;if (o.mask&1)!=0 {derived.parameters.speed=o.speed;}if (o.mask&2)!=0 {derived.parameters.radius=o.radius;}
 home:=ifx (o.mask&4)!=0 then o.home else 1;enabled:=ifx (o.mask&8)!=0 then o.enabled else true;
 if home<1 || home>anchors || !actor_parameters_ok(derived.parameters) {return ActorSpawnResult.{};}
 derived.content=actor_definition_id(derived);spawn:=actor_spawn(p,derived,schema,refs,anchors,m,pool,world,x,z,tick);if spawn.status!=ACTOR_OK {return spawn;}
 i:=entities.entity_slot(spawn.handle);a:=p[0].actors[i];a.archetype=d.content;a.scope_home=home;a.scope_enabled=enabled;
 a.overrides=ActorOverrides.{mask=o.mask,speed=ifx (o.mask&1)!=0 then o.speed else 0,radius=ifx (o.mask&2)!=0 then o.radius else 0,home=home,enabled=enabled};
 // This is still a deferred spawn, so the overridden defaults publish with
 // the rest of its fully initialized components at entity_flush.
 scope:=actor_scope_schema(a);a.facts=state_construct(scope,StateRefs.{},a.facts.epoch);a.facts.tick=tick;a.facts.day=world.facts.day;a.facts.phase=world.facts.phase;p[0].actors[i]=a;return spawn;
}
