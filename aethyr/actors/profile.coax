#module "aethyr.actors.profile";
// Flat authored actor records, profile 1. Compilation is outside the paid loop.
#load "../state/codec.coax";
#load "../core/assets.coax" as assets;
#authority;
ACTOR_PROFILES :: 8; ACTOR_RULES :: 8; ACTOR_ROWS :: 8; ACTOR_EXEC_PHASES :: 6;
ACTOR_SEEN :: 1; ACTOR_ALERTED :: 2; ACTOR_KNOWN :: 4; ACTOR_SCHEDULE :: 8; ACTOR_PATH_FAILED :: 16; ACTOR_CONTROLLED :: 32; ACTOR_MODEL :: 64;
ACTOR_HOLD :: 0; ACTOR_GO :: 1; ACTOR_WATCH :: 2; ACTOR_FLEE :: 3; ACTOR_INTERACT :: 4; ACTOR_DRIVE :: 5;
ACTOR_HOME :: 0; ACTOR_ROUTINE :: 1; ACTOR_MEMORY :: 2; ACTOR_AWAY :: 3; ACTOR_RIDER :: 4;
ActorRule :: struct {verb:int;goal:int;require:u32;forbid:u32;priority:int;weight:int=1;duration:int=16;cooldown:int;interruptible:bool=true;}
ActorSchedule :: struct {phase:int;anchor:int=1;field:int;equals:int;index:int= -1;}
ActorParameters :: struct {
 // This profile supports the shared walking body and procedural pose only.
 controller:int;physics:int;animation:int;speed:int=200;radius:int=30;
 discover:int=600;alert:int=200;track:int=800;vertical:int=300;cull:int=2000;period:int=4;grace:int=16;forget:int=128;
 sense_work:int=4;path_work:int=128;retry:int=16;stuck:int=32;
 n:int=1;rules:[ACTOR_RULES]ActorRule;repeat:bool;
 rows:int=1;schedule:[ACTOR_ROWS]ActorSchedule;
 services:u32=127;resources:u32=63;hooks:u32=7;
 deps:[ACTOR_EXEC_PHASES]u32=[6]u32.[0,1,2,4,8,16];
}
// The eight override bits name whole typed groups: body, senses, work, rules,
// schedule, services, resources and lifecycle/phase dependencies. No strings.
ActorOverrides :: struct {mask:u32;speed:int;radius:int;home:int=1;enabled:bool=true;}
ActorAuthor :: struct {format:int=1;id:int;revision:int=1;parent:int;overrides:u32=255;parameters:ActorParameters;}
ActorProfile :: struct {valid:bool;id:int;revision:int;schema:assets.AssetId;content:assets.AssetId;parameters:ActorParameters;order:[ACTOR_EXEC_PHASES]int;}
ActorCatalogue :: struct {status:int;n:int;items:[ACTOR_PROFILES]ActorProfile;}
ACTOR_OK :: 0; ACTOR_INVALID :: 1; ACTOR_CYCLE :: 2; ACTOR_CAPACITY :: 3; ACTOR_STALE :: 4; ACTOR_RESOURCES :: 5; ACTOR_EXHAUSTED :: 6;
#load "tests/profile.coax" #test;
#load "tests/profile-matrix.coax" #test;
actor_inherit :: (base:ActorParameters,own:ActorParameters,mask:u32)->ActorParameters #effects(all) {
 p:=base;
 if (mask&1)!=0 {p.controller=own.controller;p.physics=own.physics;p.animation=own.animation;p.speed=own.speed;p.radius=own.radius;}
 if (mask&2)!=0 {p.discover=own.discover;p.alert=own.alert;p.track=own.track;p.vertical=own.vertical;p.cull=own.cull;p.period=own.period;p.grace=own.grace;p.forget=own.forget;}
 if (mask&4)!=0 {p.sense_work=own.sense_work;p.path_work=own.path_work;p.retry=own.retry;p.stuck=own.stuck;}
 if (mask&8)!=0 {p.n=own.n;p.rules=own.rules;p.repeat=own.repeat;}
 if (mask&16)!=0 {p.rows=own.rows;p.schedule=own.schedule;}
 if (mask&32)!=0 {p.services=own.services;}
 if (mask&64)!=0 {p.resources=own.resources;}
 if (mask&128)!=0 {p.hooks=own.hooks;p.deps=own.deps;}return p;
}
actor_parameters_ok :: (p:ActorParameters)->bool #effects(all) {
 if p.controller<0 || p.controller>1 || p.physics!=0 || p.animation!=0 || p.speed<1 || p.speed>800 || p.radius<10 || p.radius>80 || p.speed>32*p.radius {return false;}
 if p.alert<0 || p.alert>p.discover || p.discover>p.track || p.track>p.cull || p.cull>100000 || p.vertical<0 || p.vertical>10000 || p.period<1 || p.period>64 || p.grace<0 || p.grace>640 || p.forget<1 || p.forget>230400 {return false;}
 if p.sense_work<1 || p.sense_work>16 || p.path_work<1 || p.path_work>128 || p.retry<1 || p.retry>640 || p.stuck<1 || p.stuck>640 {return false;}
 if p.services!=127 || p.resources<1 || p.resources>63 || p.hooks>7 || p.n<1 || p.n>ACTOR_RULES || p.rows<1 || p.rows>ACTOR_ROWS {return false;}
 for i:0..<p.n {r:=p.rules[i];
  if r.verb<ACTOR_HOLD || r.verb>ACTOR_DRIVE || r.goal<ACTOR_HOME || r.goal>ACTOR_RIDER || r.require>127 || r.forbid>127 || (r.require&r.forbid)!=0 || r.priority<0 || r.priority>7 || r.weight<1 || r.weight>1000 || r.duration<1 || r.duration>640 || r.cooldown<0 || r.cooldown>640 {return false;}
  if (r.verb==ACTOR_DRIVE || r.goal==ACTOR_RIDER) && p.controller!=1 {return false;}
 }
 return true;
}
actor_compile :: (authors:[]const ActorAuthor,schema:StateSchema,refs:StateRefs,anchors:int)->ActorCatalogue #effects(all) {
 out:ActorCatalogue;if authors.count<1 || authors.count>ACTOR_PROFILES {out.status=ACTOR_CAPACITY;return out;}
 out.status=ACTOR_INVALID;if !state_schema_ok(schema,refs) || anchors<1 || anchors>16 {return out;}
 for a,i:authors {if a.format!=1 || a.id<1 || a.revision<1 || a.parent<0 || a.overrides>255 {return out;}for j:0..<i {if authors[j].id==a.id {return out;}}}
 // Bounded topological inheritance: unresolved records never enter the output.
 done:[ACTOR_PROFILES]bool;
 remaining:=authors.count;while remaining>0 {
  before:=remaining;
  for a,i:authors {if done[i] {continue;}parent:= -1;
   if a.parent>0 {for b,j:authors {if b.id==a.parent {parent=j;}}if parent<0 {return out;}if !done[parent] {continue;}}
   p:ActorParameters;if parent>=0 {p=out.items[parent].parameters;}p=actor_inherit(p,a.parameters,a.overrides);
   if !actor_parameters_ok(p) {return out;}
   for k:0..<p.rows {row:=p.schedule[k];if row.phase<0 || row.phase>=schema.day_ticks || row.anchor<1 || row.anchor>anchors || (k>0 && p.schedule[k-1].phase>=row.phase) {return out;}
    row.index= -1;if row.field!=0 {row.index=state_find(schema,row.field);if row.index<0 {return out;}f:=schema.fields[row.index];if f.kind!=STATE_INT && f.kind!=STATE_BOOL {return out;}v:=state_int(row.equals);v.kind=f.kind;if !state_value_ok(f,v,refs) {return out;}}
    p.schedule[k]=row;
   }
   order:[ACTOR_EXEC_PHASES]int;
   for phase:0..<ACTOR_EXEC_PHASES {required:=ifx phase==0 then cast(u32)0 else cast(u32)1<<cast(u32)(phase-1);deps:=p.deps[phase];
    if deps>63 || (deps&required)!=required {return out;}previous:=cast(u32)((1<<phase)-1);
    if (deps&previous)!=deps {out.status=ACTOR_CYCLE;return out;}order[phase]=phase;
   }
   out.items[i]=ActorProfile.{valid=true,id=a.id,revision=a.revision,schema=state_schema_id(schema),parameters=p,order=order};out.items[i].content=actor_definition_id(out.items[i]);done[i]=true;remaining-=1;
  }
  if remaining==before {out.status=ACTOR_CYCLE;return out;}
 }
 out.status=ACTOR_OK;out.n=authors.count;return out;
}
actor_schedule :: (d:ActorProfile,s:StateStore)->int #effects(all) {
 best:=0;for i:0..<d.parameters.rows {r:=d.parameters.schedule[i];if r.phase<=s.phase && (r.index<0 || s.values[r.index].integer==r.equals) {best=r.anchor;}}return best;
}

actor_definition_id :: (d:ActorProfile)->assets.AssetId #effects(all) {
 p:=d.parameters;words:[256]int;head:=[28]int.[1,d.id,d.revision,p.controller,p.physics,p.animation,p.speed,p.radius,p.discover,p.alert,p.track,p.vertical,p.cull,p.period,p.grace,p.forget,p.sense_work,p.path_work,p.retry,p.stuck,p.n,ifx p.repeat then 1 else 0,p.rows,cast(int)p.services,cast(int)p.resources,cast(int)p.hooks,ACTOR_EXEC_PHASES,ACTOR_RULES];n:=0;
 for v:head {words[n]=v;n+=1;}for v:d.schema.words {words[n]=cast(int)v;n+=1;}for i:0..<ACTOR_EXEC_PHASES {words[n]=cast(int)p.deps[i];words[n+1]=d.order[i];n+=2;}
 for i:0..<p.n {r:=p.rules[i];values:=[10]int.[r.verb,r.goal,cast(int)r.require,cast(int)r.forbid,r.priority,r.weight,r.duration,r.cooldown,ifx r.interruptible then 1 else 0,i];for v:values {words[n]=v;n+=1;}}
 for i:0..<p.rows {r:=p.schedule[i];values:=[5]int.[r.phase,r.anchor,r.field,r.equals,r.index];for v:values {words[n]=v;n+=1;}}
 return state_words_id(words[0..<n]);
}
