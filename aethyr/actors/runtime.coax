// Phase orchestration: all facts/decisions/requests enter checked shared gates.
#module "aethyr.actors.runtime";
#load "pool.coax";
#load "../assets.coax" as assets;
#load "model.coax";
#load "../nav/grid.coax" as navigation;
#load "../query-scene.coax" as scene;
#load "../query-filter.coax" as filters;
#load "../query.coax" as queries;
#load "../space.coax" as spatial;
#load "../ai/stimulus.coax" as senses;
#load "../ai/decide.coax" as decisions;
#load "../entity.coax" as entities;
#load "../walk.coax" as walking;
#authority;
#load "tests/runtime.coax";
#load "tests/runtime-edges.coax";
ActorAnchor :: struct {id:int;x:int;z:int;}
ActorTarget :: struct {handle:Handle(entities.Entity);x:int;y:int;z:int;eligible:bool=true;}
ActorStepWorld :: struct {
 tick:int;revision:int;nav_revision:int;clearance:int=30;seed:int=2026;schema:StateSchema;refs:StateRefs;facts:StateStore;
 anchors:[]const ActorAnchor;targets:[]const ActorTarget;queries:scene.QueryWorld;
 bodies:walking.World;grid:navigation.NavGrid;walk:[]bool;focus_x:int;focus_z:int;
}
ActorWork :: struct {ok:bool;scans:int;sense:int;rays:int;search:int;settled:int;choices:int;invalidated:int;refused:int;}
actor_cm :: (v:f32)->int #effects(all) {return int(floor(v*100+0.5));}
actor_context :: (a:ActorExecInstance,w:ActorStepWorld)->ActorNavKey #effects(all) {return ActorNavKey.{actor=a.id,generation=add_sat(entities.entity_generation(a.handle).value,1),owner=a.owner,world=w.revision,nav=w.nav_revision,radius=a.definition.parameters.radius,request=a.navigation.key.request};}
actor_runtime_sense :: (p:[]ActorExecPool,i:int,w:ActorStepWorld,work:[]ActorWork) #effects(all) {
 a:=p[0].actors[i];par:=a.definition.parameters;candidates:[16]ActorCandidate;n:=0;store:=actor_entity_store(p);
 // Scan one bounded public broad-phase snapshot before spending any ray work.
 for t:w.targets {if a.facts.values[0].integer!=1 {break;}work[0].scans+=1;
  if !entities.entity_alive(store,t.handle) || entities.entity_doomed(store,t.handle) {continue;}
  id:=entities.entity_id(store,t.handle).value;candidates[n]=ActorCandidate.{id=id,generation=add_sat(entities.entity_generation(t.handle).value,1),x=t.x,y=t.y,z=t.z,eligible=t.eligible};n+=1;
 }
 if n<=par.sense_work && w.tick%par.period==0 {
  scratch:[1]scene.QueryScratch;selected:=scene.query_select_world(w.queries,filters.QueryFilter.{include=1,ignore_entity=a.handle,sensors=false},scratch[..]);
  x:=actor_cm(a.body.pos.x);y:=actor_cm(a.body.pos.y);z:=actor_cm(a.body.pos.z);fx:=x-w.focus_x;fz:=z-w.focus_z;
  if fx*fx+fz*fz<=par.cull*par.cull {
   for j:0..<n {c:=candidates[j];if !c.eligible || c.id==a.id {continue;}dx:=c.x-x;dy:=c.y-y;dz:=c.z-z;range:=ifx c.id==a.perception.target then par.track else par.discover;
    if dx*dx+dz*dz>range*range || dy< -par.vertical || dy>par.vertical {continue;}
    from:=spatial.world_point(a.body.pos.x,a.body.pos.y+1.6,a.body.pos.z);to:=spatial.world_point(f32(c.x)/100,f32(c.y)/100+1.6,f32(c.z)/100);line:=scene.semantic_clear(selected,from,spatial.world_sub(to,from),0.99999994);
    candidates[j].clear=line.status==queries.QueryStatus.ok && line.clear;work[0].rays+=1;if line.status!=queries.QueryStatus.ok {work[0].refused+=1;}
   }
  }
 }
 got:=actor_perceive(par,a.perception,w.tick,a.id,actor_cm(a.body.pos.x),actor_cm(a.body.pos.y),actor_cm(a.body.pos.z),w.focus_x,w.focus_z,candidates[0..<n]);
 if got.status!=ACTOR_OK {work[0].refused+=1;got=actor_perceive(par,a.perception,w.tick,a.id,actor_cm(a.body.pos.x),actor_cm(a.body.pos.y),actor_cm(a.body.pos.z),w.focus_x,w.focus_z,candidates[0..<0]);}
 a.perception=got.state;a.choice=ActorChoice.{};a.choice.work=cast(int)got.flags;work[0].sense+=got.work;p[0].actors[i]=a;
}
actor_runtime_choose :: (p:[]ActorExecPool,i:int,w:ActorStepWorld,work:[]ActorWork) #effects(all) {
 a:=p[0].actors[i];if a.perception.tick!=w.tick {return;}par:=a.definition.parameters;flags:=cast(u32)a.choice.work;
 anchor:=actor_schedule(a.definition,w.facts);if anchor>0 {flags=flags|ACTOR_SCHEDULE;}if a.navigation.status>=ACTOR_NAV_UNREACHABLE {flags=flags|ACTOR_PATH_FAILED;}
 if a.controller==1 {flags=flags|ACTOR_CONTROLLED;}if a.model.kind!=decisions.DECIDE_NONE {flags=flags|ACTOR_MODEL;}
 choice:=actor_choose(par,a.brain,ActorKnowledge.{tick=w.tick,flags=flags,culled=a.perception.culled || a.facts.values[0].integer==0},w.seed,a.id);
 if choice.status!=ACTOR_OK {work[0].refused+=1;return;}a.brain=choice.brain;a.choice=choice;work[0].choices+=choice.work;
 goal:=ifx choice.goal==ACTOR_ROUTINE then anchor else a.facts.values[1].integer;
 a.goal_x=actor_cm(a.body.pos.x);a.goal_z=actor_cm(a.body.pos.z);
 if choice.goal==ACTOR_HOME || choice.goal==ACTOR_ROUTINE {for point:w.anchors {if point.id==goal {a.goal_x=point.x;a.goal_z=point.z;}}}
 if choice.goal==ACTOR_MEMORY || choice.goal==ACTOR_AWAY {
  recall:=senses.memory_recall(a.perception.memory,senses.Senses.{forget=par.forget},a.perception.target,w.tick);
  if recall.known {a.goal_x=actor_cm(recall.at.x);a.goal_z=actor_cm(recall.at.z);if choice.goal==ACTOR_AWAY {a.goal_x=2*actor_cm(a.body.pos.x)-a.goal_x;a.goal_z=2*actor_cm(a.body.pos.z)-a.goal_z;}}
 }
 if a.brain.rule>=0 && (par.rules[a.brain.rule].require&ACTOR_MODEL)!=0 && a.model.kind==decisions.DECIDE_GO {a.goal_x=actor_cm(a.model.x);a.goal_z=actor_cm(a.model.z);}
 a.last_anchor=anchor;p[0].actors[i]=a;
}
actor_runtime_move :: (p:[]ActorExecPool,i:int,w:ActorStepWorld,work:[]ActorWork) #effects(all) {
 a:=p[0].actors[i];par:=a.definition.parameters;input:ActorControl;
 context:=actor_context(a,w);nav:=a.navigation;
 if nav.status!=ACTOR_NAV_NONE && (!actor_nav_same(nav.key,context)) {nav.status=ACTOR_NAV_INVALIDATED;nav.retry_at=w.tick;work[0].invalidated+=1;}
 supported:=par.radius<=w.clearance;enabled:=a.facts.values[0].integer==1;wants:=enabled && (a.controller==1 || a.choice.verb==ACTOR_GO || a.choice.verb==ACTOR_FLEE);
 if !enabled {a.input=ActorControl.{};if nav.status==ACTOR_NAV_PENDING || nav.status==ACTOR_NAV_SUCCESS {nav.status=ACTOR_NAV_INVALIDATED;nav.retry_at=w.tick;work[0].invalidated+=1;}}
 if a.controller==1 && wants {input=a.input;}else if wants && !supported {if w.tick>=nav.retry_at {nav.status=ACTOR_NAV_INVALIDATED;nav.retry_at=w.tick+par.retry;work[0].refused+=1;}}else if wants && !a.perception.culled {
  goal:=navigation.nav_grid_cell_at(w.grid,f32(a.goal_x)/100,f32(a.goal_z)/100);
  if nav.goal!=goal && nav.status!=ACTOR_NAV_NONE {nav.status=ACTOR_NAV_INVALIDATED;nav.retry_at=w.tick;}
  if nav.status==ACTOR_NAV_PENDING && w.tick>nav.asked {
   heap:[128]s32;slots:[128]s32;order:[128]s32;
   got:=navigation.nav_grid_flow(w.grid,w.walk,a.flow[..],heap[..],slots[..],order[..],nav.goal,1000,par.path_work);work[0].search+=1;work[0].settled+=got.settled;
   at:=navigation.nav_grid_cell_at(w.grid,a.body.pos.x,a.body.pos.z);result:=ACTOR_NAV_UNREACHABLE;
   if got.status==navigation.NavFlowStatus.cut {result=ACTOR_NAV_EXHAUSTED;}else if got.status==navigation.NavFlowStatus.ok && at>=0 && a.flow[at]<1000 {result=ACTOR_NAV_SUCCESS;}
   admitted:=actor_nav_accept(nav,nav.key,context,w.tick,result,par.retry);if admitted.status==ACTOR_OK {nav=admitted.navigation;}else {nav.status=ACTOR_NAV_INVALIDATED;work[0].refused+=1;}
  }
  if goal<0 {nav.status=ACTOR_NAV_UNREACHABLE;nav.retry_at=w.tick+par.retry;}
  else if (nav.status==ACTOR_NAV_NONE || nav.status>=ACTOR_NAV_UNREACHABLE) && w.tick>=nav.retry_at {
   request:=actor_nav_request(nav,context,w.tick,goal);if request.status==ACTOR_OK {nav=request.navigation;}else {work[0].refused+=1;}
  }
  // A successful bounded search is followed using the shared downhill rule.
  if nav.status==ACTOR_NAV_SUCCESS {
   at:=navigation.nav_grid_cell_at(w.grid,a.body.pos.x,a.body.pos.z);next:= -1;if at>=0 && a.flow[at]<1000 {next=navigation.nav_grid_downhill(w.grid,w.walk,a.flow[..],at);}
   if next>=0 {dx:=navigation.nav_grid_centre_x(w.grid,next)-a.body.pos.x;dz:=navigation.nav_grid_centre_z(w.grid,next)-a.body.pos.z;length:=sqrt(dx*dx+dz*dz);if length>0.08 {input.x=int(dx/length*100);input.z=int(dz/length*100);}}
  }
 }
 before:=a.body.pos;body:=walking.walk_input(a.body,f32(input.x)/100,-f32(input.z)/100,0,0,false,input.jump,0,0);body.theta=0;
 world:=w.bodies;world.collision.radius=f32(par.radius)/100;world.collision.max_travel=world.collision.radius/2;world.locomotion.walk_speed=f32(par.speed)/100;world.locomotion.run_speed=f32(par.speed)/100;
 a.body=walking.step(world,body,1.0f32/64.0f32);a.input.jump=false;
 progress:=actor_nav_progress(nav,w.tick,actor_cm(before.x)!=actor_cm(a.body.pos.x) || actor_cm(before.z)!=actor_cm(a.body.pos.z),wants && (input.x!=0 || input.z!=0),par.stuck,par.retry);
 if progress.status==ACTOR_OK {a.navigation=progress.navigation;}else {a.navigation=nav;work[0].refused+=1;}p[0].actors[i]=a;
}
actor_runtime_step :: (p:[]ActorExecPool,w:ActorStepWorld)->ActorWork #effects(all) {
 work:[1]ActorWork;if p.count!=1 || !p[0].ready || w.tick!=p[0].tick+1 || w.tick<0 || w.tick>999999000 || w.revision<1 || w.nav_revision<1 || w.clearance<10 || w.clearance>80 || w.targets.count>16 || w.anchors.count<1 || w.anchors.count>16 || !navigation.nav_grid_ok(w.grid) || navigation.nav_grid_cells(w.grid)>128 || w.walk.count!=navigation.nav_grid_cells(w.grid) || !actor_flat_point_ok(w.focus_x,w.focus_z) || !state_schema_ok(w.schema,w.refs) || !state_store_ok(w.schema,w.facts,w.refs) || w.facts.tick!=w.tick {return work[0];}
 for point,i:w.anchors {if point.id!=i+1 || !actor_flat_point_ok(point.x,point.z) {return work[0];}}
 for t,i:w.targets {if !actor_point_ok(t.x,t.y,t.z) {return work[0];}for j:0..<i {if w.targets[j].handle==t.handle {return work[0];}}}
 schema_pin:=state_schema_id(w.schema);store:=actor_entity_store(p);drafts:[ACTOR_EXEC_SLOTS]StateStore;resets:[ACTOR_EXEC_SLOTS]bool;
 // Validate every scoped transition before publishing any phase or model effect.
 for a,i:p[0].actors {h:=entities.entity_at(store,i);if h==entities.ENTITY_NONE || entities.entity_doomed(store,h) || a.id==0 {continue;}
  if !assets.asset_same(a.definition.schema,schema_pin) {return work[0];}
  schema:=actor_scope_schema(a);next_phase:=(a.facts.phase+1)%schema.day_ticks;day:=a.facts.day+(a.facts.phase+1)/schema.day_ticks;
  jump:=next_phase!=w.facts.phase || day!=w.facts.day;
  c:=StateCommand.{epoch=a.facts.epoch,revision=a.facts.revision,tick=a.facts.tick+1,jump=jump,day=w.facts.day,phase=w.facts.phase};
  reset:=a.reset_sequence>0 && a.reset_owner==a.owner;
  if jump {c.sequence=add_sat(a.facts.sequence,1);}if reset {c.event=STATE_EDITOR;c.sequence=a.reset_sequence;}
  d:=state_prepare(schema,a.facts,StateRefs.{},a.facts.epoch,c);if d.status!=STATE_OK || d.state.tick!=w.tick {return work[0];}drafts[i]=d.state;resets[i]=reset;
 }

 // Compile-time dependencies require these six phases in this order. All
 // actors complete a phase before another phase reads their finalized results.
 for phase:0..<ACTOR_EXEC_PHASES {for _,i:p[0].actors {h:=entities.entity_at(store,i);if h==entities.ENTITY_NONE || entities.entity_doomed(store,h) || p[0].actors[i].id==0 {continue;}
  a:=p[0].actors[i];
  step:=a.definition.order[phase];
  if step==0 {
   actor_model_revoke(p,i,w.revision,w.nav_revision);reset:=resets[i];p[0].actors[i].facts=drafts[i];p[0].actors[i].reset_sequence=0;
   if reset {decisions.decide_cancel(p[0].models[..],i);p[0].actors[i].model=decisions.DecideIntent.{};p[0].actors[i].model_world=0;p[0].actors[i].model_nav=0;}
   if reset && (a.definition.parameters.hooks&4)!=0 {p[0].actors[i].brain=ActorBrain.{tick=w.tick-1};p[0].actors[i].perception=ActorPerception.{tick=w.tick-1};p[0].actors[i].navigation.status=ACTOR_NAV_INVALIDATED;p[0].hooks[2]+=1;}
  }
  else if step==1 {actor_runtime_sense(p,i,w,work[..]);}
  else if step==2 {actor_runtime_choose(p,i,w,work[..]);}
  else if step==3 {actor_runtime_move(p,i,w,work[..]);}
  else if step==4 {p[0].actors[i].pose_tick=w.tick;}else if step==5 {p[0].actors[i].presentation_x=a.body.pos.x;p[0].actors[i].presentation_z=a.body.pos.z;}
  // The procedural body is the final pose. Presentation reads only after the
  // last phase; the action/attachment pipeline can later extend these phases.
 }}
 expired:=decisions.decide_expire(p[0].models[..],w.tick);for _,i:p[0].actors {if (expired&(1<<i))!=0 {p[0].actors[i].model=decisions.decide_fallback(i,p[0].actors[i].perception.memory);}}
 p[0].tick=w.tick;work[0].ok=true;return work[0];
}
