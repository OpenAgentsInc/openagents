// Read-only actor attributes and typed fear/interest notices. These grant no
// action permissions. Consumers deduplicate (source,generation,tick,kind).
#module "aethyr.actors.signals";
#load "pool.coax";
#load "../core/entity.coax" as entities;
#load "../move/walk.coax" as walking;
#authority;
ACTOR_NOTICE_FEAR :: 1; ACTOR_NOTICE_INTEREST :: 2;
ActorAttributes :: struct {valid:bool;moving:bool;interacting:bool;interruptible:bool;controlled:bool;airborne:bool;}
ActorNotice :: struct {kind:int;source:int;generation:int;tick:int= -1;target:int;x:int;z:int;}
#load "tests/signals.coax";
actor_attributes :: (p:[]ActorExecPool,h:Handle(entities.Entity))->ActorAttributes #effects(all) {
 out:ActorAttributes;if p.count!=1 || !p[0].ready {return out;}store:=actor_entity_store(p);if !entities.entity_alive(store,h) || entities.entity_doomed(store,h) {return out;}a:=p[0].actors[entities.entity_slot(h)];if a.id<1 {return out;}
 out.valid=true;out.moving=a.body.body.vel.x!=0 || a.body.body.vel.z!=0;out.controlled=a.controller==1;out.airborne=a.body.body.act==walking.Act.airborne;
 if a.brain.rule>=0 {out.interacting=a.choice.status==ACTOR_OK && a.choice.verb==ACTOR_INTERACT;out.interruptible=a.definition.parameters.rules[a.brain.rule].interruptible;}return out;
}
actor_notice :: (p:[]ActorExecPool,h:Handle(entities.Entity),tick:int)->ActorNotice #effects(all) {
 out:ActorNotice;if p.count!=1 || !p[0].ready {return out;}store:=actor_entity_store(p);if !entities.entity_alive(store,h) || entities.entity_doomed(store,h) {return out;}a:=p[0].actors[entities.entity_slot(h)];
 if a.id<1 || a.brain.rule<0 || a.brain.tick!=tick || a.choice.status!=ACTOR_OK || (a.choice.reason!=ACTOR_CHOSEN && a.choice.reason!=ACTOR_INTERRUPTED) {return out;}
 if a.choice.verb==ACTOR_FLEE {out.kind=ACTOR_NOTICE_FEAR;}else if a.choice.verb==ACTOR_INTERACT {out.kind=ACTOR_NOTICE_INTEREST;}else {return out;}
 out.source=a.id;out.generation=add_sat(entities.entity_generation(h).value,1);out.tick=tick;out.target=a.perception.target;out.x=a.goal_x;out.z=a.goal_z;return out;
}
