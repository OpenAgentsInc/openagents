// Headless SDK boundary: numerical schedules, hit layout and controls stay Coax.
// tool.sh: stack-gib 2
#load "../../../coax/web/wasm-chrome.coax";
#load "../../../coax/lib/sys/fs.coax";
actor_browser_path :: (prefix:string,suffix:string,out:[]u8)->string {n:=ws_put(out,0,prefix);n=ws_put(out,n,suffix);return ifx n<0 then "" else cast(string)out[0..<n];}
actor_browser_write :: (c:[]Cdp,expression:string,path:string)->bool {
 query:[32768]u8;n:=ws_put(query[..],0,"(async()=>JSON.stringify(await (");n=ws_put(query[..],n,expression);n=ws_put(query[..],n,")))()");
 v:=cdp_evaluate(c,cast(string)query[0..<n]);if v<0 {tool_errln(cdp_error(c));return false;}
 if jv_path(cdp_doc(c),0,"result.exceptionDetails")>=0 {tool_errln(cdp_doc(c).text);return false;}raw:=jv_raw(cdp_doc(c),v);bytes:[262144]u8;count:=jv_unescape(raw,bytes[..]);if count<3 {tool_errln(raw);return false;}return fs_write(path,cast(string)bytes[0..<count]);
}
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=2 {return 2;}url:=args_at(args[..],0);prefix:=args_at(args[..],1);c:[1]Cdp;
 if !cdp_launch(c[..],960,640,"actor-lab-") {tool_errln(cdp_error(c[..]));return 1;}defer {cdp_close(c[..]);}
 viewport:=cdp_call(c[..],"Emulation.setDeviceMetricsOverride","{\"width\":960,\"height\":640,\"deviceScaleFactor\":1,\"mobile\":false}",CDP_CALL_MS);enabled:=cdp_call(c[..],"Page.enable","{}",CDP_CALL_MS);setup:=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument","{\"source\":\"window.__actorErrors=[];addEventListener('error',e=>__actorErrors.push(e.message));addEventListener('unhandledrejection',e=>__actorErrors.push(String(e.reason)))\"}",CDP_CALL_MS);
 params:[8192]u8;o:[1]Jo;jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);navigated:=cdp_call(c[..],"Page.navigate",jo_text(o[..]),CDP_CALL_MS);
 ready:=false;until:=proc_now_ms()+30000;while proc_now_ms()<until {if wc_eval(c[..],"!!window.stateLab?.ready")=="true" {ready=true;break;}proc_sleep(50);}
 if !ready {tool_errln(wc_eval(c[..],"JSON.stringify({url:location.href,errors:window.__actorErrors,html:document.body.innerHTML})"));return 1;}paused:=wc_eval(c[..],"stateLab.pause();true");
 path:[4096]u8;script:[8192]u8;
 for fps:[4]int.[30,60,144,0] {jo_start(o[..],script[..]);jo_put(o[..],"(async()=>{const l=await stateLab.create();const start=performance.now();const r=l.trial(");jo_int(o[..],fps);jo_put(o[..],");r.elapsed_ms=performance.now()-start;r.fps=");jo_int(o[..],fps);jo_put(o[..],";stateLab.show(l);return r})()");
  tail:[64]u8;n:=ws_put(tail[..],0,"-");n=ws_digits(tail[..],n,fps);n=ws_put(tail[..],n,".json");if !actor_browser_write(c[..],jo_text(o[..]),actor_browser_path(prefix,cast(string)tail[0..<n],path[..])) {return 1;}
 }
 if !actor_browser_write(c[..],"(async()=>{const l=await stateLab.create();if(!l.x.lab_source(1))throw Error('source refused');return l.trial(60)})()",actor_browser_path(prefix,"-ai.json",path[..])) {return 1;}
 if !actor_browser_write(c[..],"(async()=>{const l=await stateLab.create();return l.trial(60,true,false)})()",actor_browser_path(prefix,"-visual.json",path[..])) {return 1;}
 if !actor_browser_write(c[..],"(async()=>{const l=await stateLab.create();stateLab.show(l);l.key('d',true);l.steps(16);l.key('d',false);const walked=l.final();stateLab.draw();const r=new Float32Array(l.x.memory.buffer,l.x.lab_draw_ptr(),l.x.lab_draw_count()*8);let hit=false;for(let i=0;i<r.length;i+=8){if(r[i+7]===12){document.querySelector('canvas').dispatchEvent(new PointerEvent('pointerdown',{clientX:r[i]+4,clientY:r[i+1]-8,bubbles:true}));hit=true;break;}}l.steps(1);const mounted=l.final();l.key('d',true);l.steps(16);l.key('d',false);stateLab.draw();return {hit,walked,mounted,ridden:l.final(),errors:window.__actorErrors}})()",actor_browser_path(prefix,"-interactive.json",path[..])) {return 1;}
 png:[2097152]u8;count:=cdp_screenshot(c[..],png[..]);if count<1 || !fs_write(actor_browser_path(prefix,"-desktop.png",path[..]),cast(string)png[0..<count]) {return 1;}
 resized:=cdp_call(c[..],"Emulation.setDeviceMetricsOverride","{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}",CDP_CALL_MS);proc_sleep(100);drawn:=wc_eval(c[..],"stateLab.draw();true");count=cdp_screenshot(c[..],png[..]);if count<1 || !fs_write(actor_browser_path(prefix,"-phone.png",path[..]),cast(string)png[0..<count]) {return 1;}
 print("Actor route receipts and desktop/phone captures written.\n");return 0;
}
