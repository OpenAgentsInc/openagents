// Actual fixed-step behavior observations. All schedules and inputs are Coax.
#module "aethyr.actors.behavior_trial";
#import "Basic";
#load "../behavior.coax";
#load "../behavior-plan.coax";
#load "../definitions.coax";
#load "../../state/declarations.coax" as state;
#load "../../loop.coax" as clock;
BehaviorTrial :: struct {rows:[256][64]int;count:int;}
behavior_trial_plan :: ()->BehaviorPlan #effects(all) {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:state.StateRefs;anchors:=[2]int.[100,200];
 d:=BehaviorDefinition.{id=12992005,n=4,schedule_n=2};
 d.sequences[0]=BehaviorSequence.{id=10,cooldown=5,guard_n=1,action_n=2};
 d.sequences[0].guards[0]=BehaviorGuard.{kind=BEHAVIOR_SIGNAL,signal=BEHAVIOR_VISIBLE};
 d.sequences[0].actions[0]=BehaviorAction.{verb=BEHAVIOR_SAY,argument=4,duration=3,interruptible=false};
 d.sequences[0].actions[1]=BehaviorAction.{duration=2};
 d.sequences[1]=BehaviorSequence.{id=20,priority=1,weight=2,cooldown=2,guard_n=2};
 d.sequences[1].guards[0]=BehaviorGuard.{kind=BEHAVIOR_SCHEDULE};
 d.sequences[1].guards[1]=BehaviorGuard.{kind=BEHAVIOR_LESS,field=101,value=state.state_int(2)};
 d.sequences[1].actions[0]=BehaviorAction.{verb=BEHAVIOR_GO,duration=6};
 d.sequences[2]=BehaviorSequence.{id=30,priority=2};
 d.sequences[3]=BehaviorSequence.{id=40,priority=2,weight=3,guard_n=1};
 d.sequences[3].guards[0]=BehaviorGuard.{field=102,value=state.state_bool(true)};
 d.sequences[3].actions[0]=BehaviorAction.{verb=BEHAVIOR_SAY,argument=7,duration=2};
 d.schedules[0]=BehaviorSchedule.{anchor=100,day_period=2};
 d.schedules[1]=BehaviorSchedule.{phase=4,anchor=200,guard_n=1};
 d.schedules[1].guards[0]=BehaviorGuard.{field=102,value=state.state_bool(false)};
 compiled:=behavior_compile(a,schema,refs,d,anchors[..]);#assert compiled.status==BehaviorPlanStatus.ok;return compiled.plan;
}
behavior_trial_run :: (trial:[]BehaviorTrial,fps:int)->int #export_c #effects(all) {
 trial[0].count=0;if fps!=30 && fps!=60 && fps!=144 && fps!=0 {return -1;}
 p:=behavior_trial_plan();schema:=behavior_fixture_schema();refs:state.StateRefs;store:=state_construct(schema,refs,1);
 live:=behavior_open(p,7,2,3,1,2026,0);c:clock.FrameClock;
 uneven:=[4]int.[5000000,27000000,14000000,31000000];
 for frame:0..<4096 {
  ns:=ifx fps==0 then uneven[frame%4] else ((frame+1)*clock.LOOP_SECOND)/fps-(frame*clock.LOOP_SECOND)/fps;
  scheduled:=clock.loop_accept_ns(c,ns);count:=clock.loop_due(scheduled);if count>256-c.ticks {count=256-c.ticks;}
  for i:0..<count {
   paid:=clock.loop_ran_some(scheduled,i+1);tick:=paid.ticks;
   command:=StateCommand.{epoch=1,revision=store.revision,tick=store.tick+1};
   if tick%13==0 {command.patches[command.n]=StatePatch.{id=101,value=state.state_int((tick/13)%3)};command.n+=1;}
   if tick%17==0 {command.patches[command.n]=StatePatch.{id=102,value=state.state_bool(store.values[1].integer==0)};command.n+=1;}
   if tick==73 || tick==129 {command.jump=true;command.day=ifx tick==73 then 15 else 2;command.phase=ifx tick==73 then 7 else 2;}
   if command.n>0 || command.jump {command.sequence=add_sat(store.sequence,1);}
   prepared:=state_prepare(schema,store,refs,1,command);if prepared.status!=STATE_OK {return -10-prepared.status;}store=prepared.state;
   facts:=behavior_project(p,schema,store,refs,1);context:=BehaviorContext.{actor=7,generation=2,owner=3};known:=tick%48<32;
   if known {context.signals|=1;context.target=99;context.target_generation=5;}
   if known && tick%24<12 {context.signals|=2;}if known && tick%16>=8 {context.signals|=4;}
   context.signals|=ifx tick%8==0 then 16 else 8;
   if tick%37==0 {context.signals|=32;}if tick%41==0 {context.signals|=64;}if tick%43==0 {context.signals|=128;}
   if live.selected>=0 && p.sequences[live.selected].actions[live.step].verb==BEHAVIOR_GO && tick-live.started>=2 {
    context.feedback=BehaviorFeedback.{key=behavior_key(live),outcome=ifx tick%7==0 then BEHAVIOR_FAILURE else BEHAVIOR_SUCCESS};
   }
   refused:= -1;
   if tick%11==0 {
    bad:=context;bad.feedback=BehaviorFeedback.{key=behavior_key(live),outcome=BEHAVIOR_SUCCESS};bad.feedback.key.generation+=1;
    probe:=behavior_step(p,live,paid,facts,bad);refused=cast(int)probe.status;
    if probe.status!=BehaviorStatus.feedback || probe.state.tick!=live.tick || probe.state.serial!=live.serial || probe.event_n!=0 {return -90;}
   }
   result:=behavior_step(p,live,paid,facts,context);if result.status!=BehaviorStatus.ok {return -100-cast(int)result.status;}live=result.state;
   out:=[34]int.[tick,store.tick,store.day,store.phase,store.values[0].integer,store.values[1].integer,store.sequence,cast(int)context.signals,
    result.schedule,result.anchor,cast(int)result.status,live.selected,result.command.sequence,live.step,live.serial,live.draws,live.started,live.argument,live.anchor_slot,live.last,
    live.successes,live.failures,live.interrupts,ifx result.command.active then 1 else 0,ifx result.command.started then 1 else 0,result.command.verb,result.command.attributes,
    result.command.target,result.command.target_generation,result.work.guards,result.work.sequences,result.work.draws,result.work.actions,result.event_n];
   row:=tick-1;for word,k:out {trial[0].rows[row][k]=word;}
   for k:0..<2 {event:=result.events[k];words:=[5]int.[event.serial,event.sequence,event.step,event.outcome,ifx event.finished then 1 else 0];for word,j:words {trial[0].rows[row][34+k*5+j]=word;}}
   for k:0..<4 {trial[0].rows[row][44+k]=ifx live.cooling[k] then 1 else 0;trial[0].rows[row][48+k]=live.completed[k];}
   trial[0].rows[row][52]=context.feedback.outcome;trial[0].rows[row][53]=context.feedback.key.serial;trial[0].rows[row][54]=refused;trial[0].rows[row][55]=live.tick;
   for k:0..<8 {trial[0].rows[row][56+k]=cast(int)p.identity.words[k];}trial[0].count+=1;
  }
  c=clock.loop_ran_some(scheduled,count);if c.ticks==256 {return trial[0].count;}
 }return -2;
}
behavior_trial_word :: (trial:[]BehaviorTrial,row:int,word:int)->int #export_c #effects(all) {
 if row<0 || row>=trial[0].count || word<0 || word>=64 {return -9223372036854775807;}return trial[0].rows[row][word];
}
main :: () #effects(all) {
 trial:[1]BehaviorTrial;
 for fps:[4]int.[30,60,144,0] {#assert behavior_trial_run(trial[..],fps)==256;
  for row:0..<256 {print("% %",fps,row);for word:0..<64 {print(" %",behavior_trial_word(trial[..],row,word));}print("\n");}
 }
}
