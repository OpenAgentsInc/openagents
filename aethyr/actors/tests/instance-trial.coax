// A lifecycle/selection trace on the actual paid clock and entity store.
#module "aethyr.actors.instance_trial";
#import "Basic";
#load "../instances.coax";
#load "../resources.coax";
#load "../definitions.coax";
#load "../behavior.coax";
#load "../behavior-plan.coax";
#load "../../state/declarations.coax" as state;
#load "../../core/loop.coax" as clock;
#load "../../core/entity.coax" as entities;
#load "../../render/registry.coax" as gpu;
ActorTrial :: struct {rows:[64][104]int;count:int;}
actor_trial_run :: (out:[]ActorTrial,fps:int)->int #export_c #effects(all) {
 out[0].count=0;if fps!=0 && fps!=30 && fps!=60 && fps!=144 {return -1;}
 m:=[1]ResourceManifest.[actor_definition_manifest()];defs:=actor_definition_sources(m[0]);defs[0].root_count=1;
 defs[0].roots[0]=ActorResourceRef.{content=m[0].entries[1].plan.content,spec=m[0].entries[1].plan.spec};
 services:=actor_definition_services();schema:=behavior_fixture_schema();refs:state.StateRefs;
 admitted:=actor_definition_compile(defs[..],30,services[..],schema,refs,m[..]);if !admitted.archetype.valid {return -2;}a:=admitted.archetype;
 d:=BehaviorDefinition.{id=12992006,n=1};d.sequences[0]=BehaviorSequence.{id=100,cooldown=2};d.sequences[0].actions[0]=BehaviorAction.{duration=3};
 anchors:[1]int;p:=behavior_compile(a,schema,refs,d,anchors[0..<0]).plan;if !p.valid {return -3;}
 s:=[1]ResourceStream.[rs_fixture_stream(m[..])];pool:=[1]ActorPool.[actor_pool_open(7,0,3,[3]int.[24,384,24])];
 q:=[1]HostInboxQueue.[hiq_open(HOST_INBOX_CAPACITY)];r:[1]gpu.RenderRegistry;
 #assert gpu.rr_open(r[..],gpu.RrLimits.{slots=8,words=100})==gpu.RrStatus.ok;
 #assert resource_stream_hold(s[..],m[..],1).slot>=0;keys:[2]ResourceLoadKey;source:[4]u8;
 for i:0..<2 {load:=resource_stream_request(s[..],m[..],q[..],r[..],i);keys[i]=load.key;source[0]=cast(u8)(i+1);
  #assert load.status==ResourceStreamStatus.ok && resource_stream_complete(s[..],m[..],q[..],load.key,source[..],ResourceCostStatus.ok)==ResourceStreamStatus.ok;}
 events:[2]ResourceAccepted;#assert resource_stream_publish(s[..],m[..],0,events[..])==2;
 backing:[1]entities.OracleBacking;world:=entities.oracle_store(backing[..]);saved:[4]ActorKey;facts:=behavior_test_facts(p);facts.epoch=7;
 c:clock.FrameClock;uneven:=[4]int.[5000000,27000000,14000000,31000000];
 for frame:0..<1024 {
  ns:=ifx fps==0 then uneven[frame%4] else ((frame+1)*clock.LOOP_SECOND)/fps-(frame*clock.LOOP_SECOND)/fps;
  scheduled:=clock.loop_accept_ns(c,ns);count:=clock.loop_due(scheduled);if count>64-c.ticks {count=64-c.ticks;}
  for part:0..<count {
   paid:=clock.loop_ran_some(scheduled,part+1);tick:=paid.ticks;request:=ActorReceipt.{};requested:=false;stopped:= -1;transferred:=false;transfer:=ActorTransfer.{};
   if tick%3==1 {at:=(tick/3)%4;request=actor_pool_request(pool[..],a,p,ActorSpawn.{id=1000+at,seed=2026},s[..],m[..]);requested=true;
    if request.status==ActorStatus.ok {saved[at]=request.key;}}
   if tick%7==0 {key:=saved[(tick/7)%4];stopped=ifx actor_pool_stop(pool[..],key,world) then 1 else 0;}
   if tick%11==0 {
    at:=(tick/11)%4;key:=saved[at];control:=1;
    if actor_pool_current(pool[..],key,world,s[..],m[..]) {control=1-pool[0].slots[key.slot].control;}
    transfer=actor_pool_transfer(pool[..],key,world,s[..],m[..],control,p);transferred=true;
    if transfer.status==ActorStatus.ok {#assert !actor_pool_current(pool[..],key,world,s[..],m[..]);saved[at]=transfer.key;}
   }
   if tick==49 {#assert resource_stream_retire(s[..],m[..]);}
   if tick==51 {#assert resource_stream_destroyed(s[..],m[..],q[..],r[..],keys[1]) && resource_stream_destroyed(s[..],m[..],q[..],r[..],keys[0]);}
   lifecycle:=actor_pool_begin(pool[..],world,s[..],m[..],paid);if lifecycle.status!=ActorStatus.ok {return -10-cast(int)lifecycle.status;}refused:=0;
   for i:0..<3 {key:=pool[0].slots[i].key;if !actor_pool_current(pool[..],key,world,s[..],m[..]) {continue;}
    context:=BehaviorContext.{actor=key.actor,generation=key.generation,owner=key.owner};
    if tick%5==0 {bad:=context;bad.generation+=1;probe:=actor_pool_select(pool[..],key,world,s[..],m[..],p,paid,facts,bad);
     if probe.status!=BehaviorStatus.identity || probe.command.active {return -40;}refused+=1;}
    selected:=actor_pool_select(pool[..],key,world,s[..],m[..],p,paid,facts,context);if selected.status!=BehaviorStatus.ok {return -50-cast(int)selected.status;}
   }
   entities.entity_flush(world);row:=tick-1;
   head:=[24]int.[tick,pool[0].tick,pool[0].count,pool[0].serial,pool[0].refused,pool[0].peak,
    pool[0].used[0],pool[0].used[1],pool[0].used[2],pool[0].peaks[0],pool[0].peaks[1],pool[0].peaks[2],
    ifx requested then cast(int)request.status else -1,request.key.slot,request.key.generation,stopped,
    ifx transferred then cast(int)transfer.status else -1,transfer.key.owner,cast(int)lifecycle.status,lifecycle.n,
    entities.entity_count(world),world.n[entities.ENTITY_NEXT_ID],entities.entity_digest(world),refused];
   for v,i:head {out[0].rows[row][i]=v;}
   for i:0..<3 {event:=lifecycle.events[i];words:=[6]int.[event.kind,event.key.slot,event.key.actor,event.key.generation,event.key.owner,event.key.epoch];for v,k:words {out[0].rows[row][24+i*6+k]=v;}}
   for i:0..<3 {slot:=pool[0].slots[i];cursor:=slot.brain;words:=[18]int.[slot.phase,slot.key.actor,slot.key.generation,slot.key.owner,slot.key.epoch,cast(int)slot.entity.value,slot.entity_id.value,slot.control,
    cursor.tick,cursor.selected,cursor.serial,cursor.draws,cursor.successes,cursor.failures,cursor.interrupts,ifx cursor.cooling[0] then 1 else 0,cursor.completed[0],slot.memory.count];
    for v,k:words {out[0].rows[row][42+i*18+k]=v;}}
   tail:=[8]int.[ifx s[0].closing then 1 else 0,s[0].owners[1].refs,s[0].owners[0].refs,s[0].budget[0].total,q[0].bytes,r[0].live,cast(int)s[0].owners[1].phase,s[0].destroyed];
   for v,k:tail {out[0].rows[row][96+k]=v;}
   out[0].count+=1;
  }
  c=clock.loop_ran_some(scheduled,count);if c.ticks==64 {return out[0].count;}
 }return -100;
}
actor_trial_word :: (out:[]ActorTrial,row:int,word:int)->int #export_c #effects(all) {
 if row<0 || row>=out[0].count || word<0 || word>=104 {return -9223372036854775807;}return out[0].rows[row][word];
}
main :: () #effects(all) {
 out:[1]ActorTrial;for fps:[4]int.[30,60,144,0] {#assert actor_trial_run(out[..],fps)==64;
  for row:0..<64 {print("% %",fps,row);for word:0..<104 {print(" %",actor_trial_word(out[..],row,word));}print("\n");}}
}
