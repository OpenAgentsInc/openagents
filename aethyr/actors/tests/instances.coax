actor_instance_fixture :: ()->ActorArchetype #effects(all) {return behavior_fixture_archetype();}
actor_instance_plan :: ()->BehaviorPlan #effects(all) {return behavior_test_plan();}
actor_instance_clock :: (tick:int)->clock.FrameClock #effects(all) {return behavior_test_clock(tick);}
actor_instance_empty_roots :: (a:ActorArchetype)->ActorArchetype #effects(all) {
 m:=[1]ResourceManifest.[actor_definition_manifest()];defs:=actor_definition_sources(m[0]);defs[0].root_count=0;
 services:=actor_definition_services();refs:StateRefs;return actor_definition_compile(defs[..],a.id,services[..],behavior_fixture_schema(),refs,m[..]).archetype;
}
#test "actor instances reserve quotas and publish no entity until all roots are ready and the shared flush has passed" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];
 a:=actor_instance_fixture();p:=actor_instance_plan();pool:=[1]ActorPool.[actor_pool_open(7,0,3,[3]int.[24,384,24])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7,seed=2026,placement=points.Placement.{origin=points.WorldPoint.{x=4,z=2},yaw=1}},s[..],m[..]);
 #assert accepted.status==ActorStatus.ok && accepted.key.slot==0 && accepted.key.generation==1 && accepted.key.owner==1 && accepted.key.epoch==7;
 #assert pool[0].count==1 && pool[0].used[0]==8 && pool[0].used[1]==128 && pool[0].used[2]==8;
 #assert entities.entity_count(world)==0 && !actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);
 step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));#assert step.status==ActorStatus.ok && step.n==0 && pool[0].slots[0].phase==ACTOR_LOADING;
 q:=[1]HostInboxQueue.[hiq_open(HOST_INBOX_CAPACITY)];r:[1]gpu.RenderRegistry;#assert gpu.rr_open(r[..],gpu.RrLimits.{slots=8,words=100})==gpu.RrStatus.ok;
 source:[4]u8;for i:0..<3 {load:=resource_stream_request(s[..],m[..],q[..],r[..],i);source[0]=cast(u8)(i+1);
  #assert load.status==ResourceStreamStatus.ok && resource_stream_complete(s[..],m[..],q[..],load.key,source[..],ResourceCostStatus.ok)==ResourceStreamStatus.ok;}
 events:[3]ResourceAccepted;#assert resource_stream_publish(s[..],m[..],1,events[..])==3;
 step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));#assert step.n==1 && step.events[0].kind==ACTOR_BORN && pool[0].slots[0].phase==ACTOR_BORN;
 #assert entities.entity_count(world)==0 && entities.entity_waiting(world,pool[0].slots[0].entity) && !actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);
 entities.entity_flush(world);step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(3));
 #assert step.n==1 && step.events[0].kind==ACTOR_LIVE && actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);
 slot:=pool[0].slots[0];#assert slot.brain.ready && slot.brain.tick==2 && slot.brain.owner==1 && slot.brain.actor==7 && slot.brain.generation==1 && slot.brain.world_epoch==7;
 #assert slot.placement.origin.x==4 && slot.placement.origin.z==2 && slot.placement.yaw==1 && slot.memory.count==0;
}
#test "actor quota refusal and malformed spawn admission change no entity or stream or pool identity" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_fixture();p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[8,128,8])];first:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);#assert first.status==ActorStatus.ok;
 serial:=s[0].serial;#assert actor_pool_request(pool[..],a,p,ActorSpawn.{id=8},s[..],m[..]).status==ActorStatus.budget;
 #assert pool[0].serial==1 && pool[0].count==1 && s[0].serial==serial && pool[0].refused==1;
 #assert actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]).status==ActorStatus.duplicate;
 for which:0..<8 {fresh:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];bad:=ActorSpawn.{id=8};plan:=p;archetype:=a;
  zero:f32=0;if which==0 {bad.id=0;}if which==1 {bad.placement.origin.x=zero/zero;}if which==2 {bad.placement.origin.y=1/zero;}
  if which==3 {bad.placement.origin.z=1000000128.0;}if which==4 {bad.placement.yaw=1000001;}
  if which==5 {plan.archetype_revision+=1;}if which==6 {archetype.valid=false;}if which==7 {plan.identity.words[0]^=1;}
  #assert actor_pool_request(fresh[..],archetype,plan,bad,s[..],m[..]).status!=ActorStatus.ok && fresh[0].count==0 && fresh[0].serial==0 && s[0].serial==serial;
 }
}
#test "actor cancellation before birth and after birth retains quota until the entity flush and rejects old keys on reuse" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,1,[3]int.[8,128,8])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 first:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);#assert actor_pool_stop(pool[..],first.key,world) && !actor_pool_stop(pool[..],first.key,world);
 step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));#assert step.n==1 && step.events[0].kind==ACTOR_REMOVED && pool[0].count==0 && pool[0].used[2]==0;
 next:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);#assert next.key.slot==0 && next.key.generation==2 && !actor_pool_stop(pool[..],first.key,world);
 step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));#assert step.events[0].kind==ACTOR_BORN;
 #assert actor_pool_stop(pool[..],next.key,world) && pool[0].count==1;
 step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(3));#assert step.n==0 && pool[0].count==1;
 entities.entity_flush(world);step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(4));#assert step.events[0].kind==ACTOR_REMOVED && pool[0].count==0;
 third:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);#assert third.key.generation==3 && !actor_pool_current(pool[..],next.key,world,s[..],m[..]);
}
#forall "actor current ownership rejects every altered correlation lane and a dead or replaced entity" which:0..<9 #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));entities.entity_flush(world);
 step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));#assert actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);bad:=accepted.key;
 if which==0 {bad.slot= -1;}if which==1 {bad.slot=2;}if which==2 {bad.actor+=1;}if which==3 {bad.generation+=1;}if which==4 {bad.owner+=1;}if which==5 {bad.epoch+=1;}
 if which==6 {entities.entity_despawn(world,pool[0].slots[0].entity);entities.entity_flush(world);}
 if which==7 {s[0].closing=true;}if which==8 {pool[0].slots[0].entity_id.value+=1;}
 #assert !actor_pool_current(pool[..],bad,world,s[..],m[..]);
}
#test "actor selection commits only for a live current owner and control transfer preserves sensed memory and random counters" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7,seed=2026},s[..],m[..]);step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));entities.entity_flush(world);
 step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));facts:=behavior_test_facts(p);facts.epoch=7;context:=BehaviorContext.{actor=7,generation=1,owner=1};
 result:=actor_pool_select(pool[..],accepted.key,world,s[..],m[..],p,actor_instance_clock(2),facts,context);
 #assert result.status==BehaviorStatus.ok && result.command.active && pool[0].slots[0].brain.tick==2 && result.state.draws==1;
 pool[0].slots[0].memory.count=1;pool[0].slots[0].memory.items[0]=senses.Stimulus.{kind=senses.StimulusKind.sound,source=99,tick=2};
 transfer:=actor_pool_transfer(pool[..],accepted.key,world,s[..],m[..],1,p);
 #assert transfer.status==ActorStatus.ok && transfer.key.owner==2 && transfer.interrupted && transfer.event.outcome==BEHAVIOR_INTERRUPTED;
 #assert pool[0].slots[0].brain.draws==1 && pool[0].slots[0].brain.selected== -1 && pool[0].slots[0].memory.items[0].source==99 && pool[0].slots[0].control==1;
 #assert pool[0].slots[0].brain.cooling[1] && pool[0].slots[0].brain.completed[1]==2 && pool[0].slots[0].brain.interrupts==1;
 #assert !actor_pool_current(pool[..],accepted.key,world,s[..],m[..]) && actor_pool_current(pool[..],transfer.key,world,s[..],m[..]);
 old:=actor_pool_select(pool[..],accepted.key,world,s[..],m[..],p,actor_instance_clock(3),facts,context);
 #assert old.status==BehaviorStatus.identity && !old.command.active && pool[0].slots[0].brain.tick==2;
}
#test "actor pool declarations retain exact minimum maximum and zero work capacities" {
 for field:0..<6 {for edge:0..<2 {
  epoch:=1;tick:=0;capacity:=1;caps:[3]int;low:=[6]int.[1,0,1,0,0,0];high:=[6]int.[1000000000,1000000000,16,1024,65536,512];
  value:=ifx edge==0 then low[field] else high[field];
  if field==0 {epoch=value;}if field==1 {tick=value;}if field==2 {capacity=value;}if field>=3 {caps[field-3]=value;}
  admitted:=actor_pool_open(epoch,tick,capacity,caps);#assert admitted.valid && admitted.epoch==epoch && admitted.tick==tick && admitted.capacity==capacity;
  for v,i:caps {#assert admitted.caps[i]==v;}
  value+=ifx edge==0 then -1 else 1;
  if field==0 {epoch=value;}if field==1 {tick=value;}if field==2 {capacity=value;}if field>=3 {caps[field-3]=value;}
  #assert !actor_pool_open(epoch,tick,capacity,caps).valid;
 }}
}
#test "actor request reserves each work axis exactly and distinguishes malformed metadata from bounded pressure" #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 for axis:0..<3 {for which:0..<6 {
  archetype:=a;plan:=p;s:=[1]ResourceStream.[rs_fixture_stream(m[..])];pool:=[1]ActorPool.[actor_pool_open(7,0,16,[3]int.[1024,65536,512])];
  parameter:=[3]int.[ACTOR_SENSE_WORK,ACTOR_SEARCH_WORK,ACTOR_ACTION_WORK][axis];maximum:=[3]int.[64,4096,32][axis];
  value:=ifx which==0 then 1 else ifx which==1 then maximum else ifx which==2 then 0 else ifx which==3 then -1 else maximum+1;
  archetype.parameters[parameter].integer=value;if which==5 {archetype.parameters[parameter].kind=STATE_SCALAR;}
  if axis==2 {plan.work=value;plan.identity=behavior_plan_identity(plan);}
  result:=actor_pool_request(pool[..],archetype,plan,ActorSpawn.{id=1},s[..],m[..]);
  #assert result.status==(ifx which<2 then ActorStatus.ok else ActorStatus.plan);
  if which<2 {#assert pool[0].used[axis]==value && pool[0].peaks[axis]==value;}else {#assert pool[0].count==0 && s[0].serial==0;}
 }}
 for axis:0..<3 {s:=[1]ResourceStream.[rs_fixture_stream(m[..])];caps:=[3]int.[8,128,8];caps[axis]-=1;pool:=[1]ActorPool.[actor_pool_open(7,0,2,caps)];
  #assert actor_pool_request(pool[..],a,p,ActorSpawn.{id=1},s[..],m[..]).status==ActorStatus.budget && pool[0].count==0 && s[0].serial==0;
 }
}
#test "actor capacity counts pending actors across revisions and keeps peak work after release and reuse" #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,3,[3]int.[24,384,24])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);a.parameters[ACTOR_INSTANCES].integer=2;
 first:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=1},s[..],m[..]);second:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=2},s[..],m[..]);
 #assert first.status==ActorStatus.ok && second.status==ActorStatus.ok && second.key.slot==1 && pool[0].count==2 && pool[0].peak==2;
 for v,i:[3]int.[16,256,16] {#assert pool[0].peaks[i]==v;}
 #assert actor_pool_request(pool[..],a,p,ActorSpawn.{id=3},s[..],m[..]).status==ActorStatus.capacity && pool[0].count==2 && pool[0].serial==2;
 #assert actor_pool_stop(pool[..],first.key,world);step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));
 #assert pool[0].count==1 && pool[0].peak==2;for v,i:[3]int.[16,256,16] {#assert pool[0].peaks[i]==v;}
 again:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=3},s[..],m[..]);#assert again.status==ActorStatus.ok && again.key.slot==0 && again.key.generation==3;
 #assert pool[0].peak==2;for v,i:[3]int.[16,256,16] {#assert pool[0].peaks[i]==v && pool[0].used[i]==v;}
}
#test "actor request checks every plan placement and world fence before taking roots" #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];a:=actor_instance_fixture();p:=actor_instance_plan();
 for which:0..<17 {s:=[1]ResourceStream.[rs_fixture_stream(m[..])];pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];archetype:=a;plan:=p;spawn:=ActorSpawn.{id=1};expected:=ActorStatus.plan;
  if which==0 {pool[0].valid=false;expected=ActorStatus.identity;}if which==1 {s[0].valid=false;expected=ActorStatus.identity;}if which==2 {s[0].epoch=8;expected=ActorStatus.identity;}
  if which==3 {plan.archetype+=1;plan.identity=behavior_plan_identity(plan);}if which==4 {archetype.schema.words[3]^=1;}if which==5 {archetype.parameters[ACTOR_INSTANCES].kind=STATE_SCALAR;}
  if which==6 {archetype.parameters[ACTOR_INSTANCES].integer=0;}if which==7 {archetype.parameters[ACTOR_INSTANCES].integer=65;}
  if which==8 {plan.work+=1;}if which==9 {pool[0].serial=1000000000;expected=ActorStatus.exhausted;}
  if which==10 {s[0].closing=true;expected=ActorStatus.resources;}if which==11 {archetype.manifest.words[0]^=1;expected=ActorStatus.resources;}
  if which==12 {spawn.placement.origin.x= -1000000128;expected=ActorStatus.invalid;}if which==13 {spawn.placement.yaw= -1000001;expected=ActorStatus.invalid;}
  if which==14 {archetype.parameters[ACTOR_INSTANCES].integer=1;#assert actor_pool_request(pool[..],archetype,plan,ActorSpawn.{id=2},s[..],m[..]).status==ActorStatus.ok;expected=ActorStatus.capacity;}
  if which==15 {pool[0].capacity=1;#assert actor_pool_request(pool[..],archetype,plan,ActorSpawn.{id=2},s[..],m[..]).status==ActorStatus.ok;expected=ActorStatus.capacity;}
  if which==16 {plan.valid=false;}
  before:=s[0].serial;count:=pool[0].count;#assert actor_pool_request(pool[..],archetype,plan,spawn,s[..],m[..]).status==expected && s[0].serial==before && pool[0].count==count;
 }
 for edge:0..<2 {s:=[1]ResourceStream.[rs_fixture_stream(m[..])];pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];spawn:=ActorSpawn.{id=9223372036854775807};
  value:f32=ifx edge==0 then -1000000000 else 1000000000;spawn.placement.origin=points.WorldPoint.{x=value,y=value,z=value};spawn.placement.yaw=ifx edge==0 then -1000000 else 1000000;
  #assert actor_pool_request(pool[..],a,p,spawn,s[..],m[..]).status==ActorStatus.ok;
 }
}
#test "actor lifecycle clock admission refuses corrupt paid records without advancing the pool" {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 for which:0..<18 {pool:=[1]ActorPool.[actor_pool_open(7,0,1,[3]int.[0,0,0])];paid:=actor_instance_clock(1);expected:=ActorStatus.clock;
  if which==0 {pool[0].valid=false;expected=ActorStatus.identity;}if which==1 {pool[0].epoch=8;expected=ActorStatus.identity;}if which==2 {pool[0].tick=1000000000;paid.ticks=1000000001;}
  if which==3 {paid.ticks=0;}if which==4 {paid.step_ns+=1;}if which==5 {paid.due=1;}if which==6 {paid.ran=0;}if which==7 {paid.ran=paid.max_steps+1;}
  if which==8 {paid.max_steps=9;}if which==9 {paid.counted_ns= -1;}if which==10 {paid.counted_ns=paid.max_frame_ns+1;}
  if which==11 {paid.max_frame_ns=0;}if which==12 {paid.max_frame_ns=250000001;}if which==13 {paid.carry_ns= -1;}if which==14 {paid.carry_ns=paid.step_ns*paid.max_steps;}
  if which==15 {paid.frames=0;}if which==16 {paid.max_steps=0;}if which==17 {paid.max_steps=1;paid.ran=2;}
  tick:=pool[0].tick;result:=actor_pool_begin(pool[..],world,s[..],m[..],paid);#assert result.status==expected && pool[0].tick==tick && result.n==0;
 }
 pool:=[1]ActorPool.[actor_pool_open(7,0,1,[3]int.[0,0,0])];paid:=actor_instance_clock(1);paid.max_steps=8;paid.ran=8;paid.counted_ns=0;paid.max_frame_ns=1;paid.carry_ns=paid.step_ns*8-1;
 #assert actor_pool_begin(pool[..],world,s[..],m[..],paid).status==ActorStatus.ok;
 pool[0].tick=0;paid.counted_ns=250000000;paid.max_frame_ns=250000000;#assert actor_pool_begin(pool[..],world,s[..],m[..],paid).status==ActorStatus.ok;
}
ActorLoadedFixture :: struct {m:[1]ResourceManifest;s:[1]ResourceStream;q:[1]HostInboxQueue;r:[1]gpu.RenderRegistry;keys:[3]ResourceLoadKey;}
actor_loaded_fixture :: ()->ActorLoadedFixture #effects(all) {
 out:ActorLoadedFixture;out.m[0]=actor_definition_manifest();out.s[0]=rs_fixture_stream(out.m[..]);out.q[0]=hiq_open(HOST_INBOX_CAPACITY);
 #assert gpu.rr_open(out.r[..],gpu.RrLimits.{slots=8,words=100})==gpu.RrStatus.ok;
 for root:[2]int.[1,2] {#assert resource_stream_hold(out.s[..],out.m[..],root).slot>=0;}
 source:[4]u8;for i:0..<3 {load:=resource_stream_request(out.s[..],out.m[..],out.q[..],out.r[..],i);out.keys[i]=load.key;source[0]=cast(u8)(i+1);
  #assert load.status==ResourceStreamStatus.ok && resource_stream_complete(out.s[..],out.m[..],out.q[..],load.key,source[..],ResourceCostStatus.ok)==ResourceStreamStatus.ok;}
 events:[3]ResourceAccepted;#assert resource_stream_publish(out.s[..],out.m[..],0,events[..])==3;return out;
}
#test "actor world retirement releases quotas after entity flush while stream owners retain physical allocations" #steps 30000000 {
 f:=actor_loaded_fixture();a:=actor_instance_fixture();p:=actor_instance_plan();pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},f.s[..],f.m[..]);step:=actor_pool_begin(pool[..],world,f.s[..],f.m[..],actor_instance_clock(1));entities.entity_flush(world);
 step=actor_pool_begin(pool[..],world,f.s[..],f.m[..],actor_instance_clock(2));#assert actor_pool_current(pool[..],accepted.key,world,f.s[..],f.m[..]);before:=f.s[0].budget[0].total;
 #assert resource_stream_retire(f.s[..],f.m[..]) && !actor_pool_current(pool[..],accepted.key,world,f.s[..],f.m[..]);
 step=actor_pool_begin(pool[..],world,f.s[..],f.m[..],actor_instance_clock(3));#assert step.n==1 && step.events[0].kind==ACTOR_RETIRING && pool[0].slots[0].phase==ACTOR_RETIRING && entities.entity_doomed(world,pool[0].slots[0].entity);
 #assert pool[0].count==1 && f.s[0].budget[0].total==before;entities.entity_flush(world);
 step=actor_pool_begin(pool[..],world,f.s[..],f.m[..],actor_instance_clock(4));#assert step.n==1 && step.events[0].kind==ACTOR_REMOVED && pool[0].count==0 && pool[0].used[0]==0 && f.s[0].budget[0].total==before;
 #assert resource_stream_destroyed(f.s[..],f.m[..],f.q[..],f.r[..],f.keys[1]) && resource_stream_destroyed(f.s[..],f.m[..],f.q[..],f.r[..],f.keys[2]) && resource_stream_destroyed(f.s[..],f.m[..],f.q[..],f.r[..],f.keys[0]);
 #assert f.s[0].budget[0].total==0 && f.q[0].bytes==0 && f.r[0].live==0 && resource_stream_finished(f.s[..]);
}
#test "actor pressure is counted and never invents an entity or hides an unreleased claim" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 for i:0..<64 {#assert entities.entity_spawn(world).id.value==i+1;}entities.entity_flush(world);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));
 #assert step.n==1 && step.events[0].kind==ACTOR_PRESSURE && pool[0].refused==1 && pool[0].slots[0].phase==ACTOR_LOADING && pool[0].slots[0].entity==entities.ENTITY_NONE;
 entities.entity_despawn(world,entities.entity_at(world,0));entities.entity_flush(world);step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));
 #assert step.n==1 && step.events[0].kind==ACTOR_BORN && pool[0].slots[0].entity_id.value==65;
 #assert actor_pool_stop(pool[..],accepted.key,world) && entities.entity_doomed(world,pool[0].slots[0].entity);entities.entity_flush(world);
 // Corrupting a retained local receipt cannot release a different owner's claim.
 f:=actor_loaded_fixture();other:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];request:=actor_pool_request(other[..],actor_instance_fixture(),p,ActorSpawn.{id=8},f.s[..],f.m[..]);
 saved:=other[0].slots[0].resources;other[0].slots[0].resources.claims[0].serial+=1;
 step=actor_pool_begin(other[..],world,f.s[..],f.m[..],actor_instance_clock(1));#assert step.events[0].kind==ACTOR_RETIRING;
 step=actor_pool_begin(other[..],world,f.s[..],f.m[..],actor_instance_clock(2));#assert step.events[0].kind==ACTOR_PRESSURE && other[0].count==1 && other[0].refused==1 && other[0].used[2]==8;
 other[0].slots[0].resources=saved;step=actor_pool_begin(other[..],world,f.s[..],f.m[..],actor_instance_clock(3));#assert step.events[0].kind==ACTOR_REMOVED && other[0].count==0;
}
#forall "actor lifecycle sees external death replacement and withheld entity flush before exposing live components" which:0..<5 #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},s[..],m[..]);step:=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(1));
 if which==4 {step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));#assert step.n==0 && pool[0].slots[0].phase==ACTOR_BORN;entities.entity_flush(world);
  step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(3));#assert step.events[0].kind==ACTOR_LIVE && actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);}
 else {
  entities.entity_flush(world);tick:=2;
  if which<2 {step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(2));tick=3;}
  if which==0 || which==2 {entities.entity_despawn(world,pool[0].slots[0].entity);entities.entity_flush(world);}else {pool[0].slots[0].entity_id.value+=1;}
  step=actor_pool_begin(pool[..],world,s[..],m[..],actor_instance_clock(tick));#assert step.events[0].kind==ACTOR_RETIRING && !actor_pool_current(pool[..],accepted.key,world,s[..],m[..]);
 }
}
#test "actor transfer admits both control sources only with a current live cursor and preserves all refusal state" #steps 100000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();
 base:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 accepted:=actor_pool_request(base[..],a,p,ActorSpawn.{id=7},s[..],m[..]);step:=actor_pool_begin(base[..],world,s[..],m[..],actor_instance_clock(1));entities.entity_flush(world);
 step=actor_pool_begin(base[..],world,s[..],m[..],actor_instance_clock(2));
 idle:=actor_pool_transfer(base[..],accepted.key,world,s[..],m[..],1,p);#assert idle.status==ActorStatus.ok && !idle.interrupted && idle.event.serial==0 && idle.key.owner==2;
 back:=actor_pool_transfer(base[..],idle.key,world,s[..],m[..],0,p);#assert back.status==ActorStatus.ok && back.key.owner==3 && base[0].slots[0].control==0;
 for which:0..<5 {pool:=base;key:=back.key;plan:=p;control:=1;expected:=ActorStatus.invalid;
  if which==0 {control= -1;}if which==1 {control=2;}if which==2 {control=0;}if which==3 {plan.identity.words[0]^=1;}
  if which==4 {pool[0].slots[0].key.owner=1000000000;pool[0].slots[0].brain.owner=1000000000;key.owner=1000000000;expected=ActorStatus.exhausted;}
  result:=actor_pool_transfer(pool[..],key,world,s[..],m[..],control,plan);#assert result.status==expected && pool[0].slots[0].key.owner==key.owner && pool[0].slots[0].brain.owner==key.owner && pool[0].slots[0].control==0;
 }
 facts:=behavior_test_facts(p);facts.epoch=7;context:=BehaviorContext.{actor=7,generation=1,owner=3};
 refusal:=actor_pool_select(base[..],back.key,world,s[..],m[..],p,actor_instance_clock(3),facts,context);#assert refusal.status==BehaviorStatus.clock && refusal.state.tick==1 && base[0].slots[0].brain.tick==1;
 top:=base;context.signals=3;context.target=99;context.target_generation=1;
 result:=actor_pool_select(top[..],back.key,world,s[..],m[..],p,actor_instance_clock(2),facts,context);#assert result.status==BehaviorStatus.ok && top[0].slots[0].brain.selected==0;
 top_transfer:=actor_pool_transfer(top[..],back.key,world,s[..],m[..],1,p);#assert top_transfer.status==ActorStatus.ok && top_transfer.interrupted && top_transfer.event.sequence==10 && top[0].slots[0].brain.selected== -1;
 context.signals=0;context.target=0;context.target_generation=0;
 result=actor_pool_select(base[..],back.key,world,s[..],m[..],p,actor_instance_clock(2),facts,context);#assert result.status==BehaviorStatus.ok;
 base[0].slots[0].brain.interrupts=1000000000;exhausted:=actor_pool_transfer(base[..],back.key,world,s[..],m[..],1,p);
 #assert exhausted.status==ActorStatus.exhausted && base[0].slots[0].brain.selected==1 && base[0].slots[0].key.owner==3;
 #assert actor_pool_stop(base[..],back.key,world) && entities.entity_alive(world,base[0].slots[0].entity) && !actor_pool_current(base[..],back.key,world,s[..],m[..]);
}
#test "actor configured storage excludes nonempty tail slots and retains exact maximum instance capacity" #steps 30000000 {
 m:=[1]ResourceManifest.[actor_definition_manifest()];s:=[1]ResourceStream.[rs_fixture_stream(m[..])];a:=actor_instance_empty_roots(actor_instance_fixture());p:=actor_instance_plan();pool:=[1]ActorPool.[actor_pool_open(7,0,1,[3]int.[8,128,8])];
 a.parameters[ACTOR_INSTANCES].integer=64;first:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=1},s[..],m[..]);#assert first.status==ActorStatus.ok;
 pool[0].slots[1]=pool[0].slots[0];pool[0].slots[1].key.slot=1;#assert !actor_pool_matches(pool[..],pool[0].slots[1].key);
 bad:=p;bad.archetype_revision+=1;bad.identity=behavior_plan_identity(bad);fresh:=[1]ActorPool.[actor_pool_open(7,0,1,[3]int.[8,128,8])];
 #assert actor_pool_request(fresh[..],a,bad,ActorSpawn.{id=2},s[..],m[..]).status==ActorStatus.plan;
}
#test "a closing stream with live claims still drops each actor claim normally" #steps 30000000 {
 f:=actor_loaded_fixture();a:=actor_instance_fixture();p:=actor_instance_plan();pool:=[1]ActorPool.[actor_pool_open(7,0,2,[3]int.[16,256,16])];b:[1]entities.OracleBacking;world:=entities.oracle_store(b[..]);
 request:=actor_pool_request(pool[..],a,p,ActorSpawn.{id=7},f.s[..],f.m[..]);owned:=pool[0].slots[0].resources;
 // This diagnostic intermediate state is stronger than public retire's
 // postcondition, which clears the complete claim table atomically.
 f.s[0].closing=true;#assert actor_pool_stop(pool[..],request.key,world);
 step:=actor_pool_begin(pool[..],world,f.s[..],f.m[..],actor_instance_clock(1));#assert step.events[0].kind==ACTOR_REMOVED && pool[0].count==0;
 #assert !f.s[0].claims[owned.claims[0].slot].live && !f.s[0].claims[owned.claims[1].slot].live && f.s[0].owners[1].refs==1 && f.s[0].owners[2].refs==1;
}
