#test "perception validates every stored bound and candidate identity before touching memory" {
 p:=ActorParameters.{period=1};base:ActorPerception;one:=[1]ActorCandidate.[ActorCandidate.{id=2,generation=1,clear=true}];
 for field:0..<33 {old:=base;params:=p;tick:=0;self:=1;x:=0;y:=0;z:=0;fx:=0;fz:=0;candidate:=one;
  if field==0 {params.n=0;}else if field==1 {old.tick= -2;}else if field==2 {old.tick=1000000001;}else if field==3 {tick= -1;}else if field==4 {tick=1000000001;}else if field==5 {tick=1;}else if field==6 {self=0;}
  else if field==7 {x= -1000001;}else if field==8 {x=1000001;}else if field==9 {y= -1000001;}else if field==10 {y=1000001;}else if field==11 {z= -1000001;}else if field==12 {z=1000001;}else if field==13 {fx= -1000001;}else if field==14 {fz=1000001;}
  else if field==15 {old.last_seen= -2;}else if field==16 {old.last_seen=0;}else if field==17 {old.target= -1;}else if field==18 {old.generation= -1;}else if field==19 {old.generation=4097;old.target=1;}else if field==20 {old.target=1;}else if field==21 {old.generation=1;}else if field==22 {old.lost= -1;}
  else if field==23 {candidate[0].id=0;}else if field==24 {candidate[0].generation=0;}else if field==25 {candidate[0].generation=4097;}else if field==26 {candidate[0].x= -1000001;}else if field==27 {candidate[0].x=1000001;}else if field==28 {candidate[0].y= -1000001;}else if field==29 {candidate[0].y=1000001;}else if field==30 {candidate[0].z= -1000001;}else if field==31 {candidate[0].z=1000001;}else {old.memory.count=9;}
  r:=actor_perceive(params,old,tick,self,x,y,z,fx,fz,candidate[..]);#assert r.status==ACTOR_INVALID && r.state.tick==old.tick && r.state.memory.count==old.memory.count;
 }
 two:=[2]ActorCandidate.[one[0],one[0]];#assert actor_perceive(p,base,0,1,0,0,0,0,0,two[..]).status==ACTOR_INVALID;
}
#test "range height alert inclusive endpoints sampling cadence and culling expose explicit outcomes" {
 p:=ActorParameters.{period=1};old:ActorPerception;c:=[1]ActorCandidate.[ActorCandidate.{id=2,generation=1,clear=true}];
 for which:0..<12 {candidate:=c;visible:=true;
  if which==0 {candidate[0].x=600;}else if which==1 {candidate[0].x=601;visible=false;}else if which==2 {candidate[0].x=360;candidate[0].z=480;}else if which==3 {candidate[0].x=361;candidate[0].z=480;visible=false;}
  else if which==4 {candidate[0].y=300;}else if which==5 {candidate[0].y=301;visible=false;}else if which==6 {candidate[0].y= -300;}else if which==7 {candidate[0].y= -301;visible=false;}
  else if which==8 {candidate[0].x=200;}else if which==9 {candidate[0].x=201;}else if which==10 {candidate[0].id=1;visible=false;}else {candidate[0].clear=false;visible=false;}
  r:=actor_perceive(p,old,0,1,0,0,0,0,0,candidate[..]);#assert r.status==ACTOR_OK && r.state.seen==visible && (r.state.target==2)==visible;if which==8 {#assert r.state.alert;}if which==9 {#assert !r.state.alert;}
 }
 p.period=4;r:=actor_perceive(p,old,0,1,0,0,0,2000,0,c[..]);#assert r.state.seen && !r.state.culled && r.state.reason==1;
 c[0].clear=false;for tick:1..<4 {r=actor_perceive(p,r.state,tick,1,0,0,0,0,0,c[..]);#assert r.state.seen && r.work==0 && r.flags==(ACTOR_SEEN|ACTOR_ALERTED|ACTOR_KNOWN);}
 r=actor_perceive(p,r.state,4,1,0,0,0,0,0,c[..]);#assert !r.state.seen && r.state.reason==2 && r.state.lost==4;
 p.grace=4;r=actor_perceive(p,r.state,5,1,0,0,0,0,0,c[..]);#assert r.state.target==0 && r.state.reason==3 && r.state.generation==0;
}
#test "stored stimulus validation is bounded and all eight slots and terminal counters remain precise" {
 m:senses.Memory;#assert actor_memory_ok(m,0);
 for which:0..<8 {bad:=m;if which==0 {bad.count= -1;}else if which==1 {bad.count=9;}else if which==2 {bad.latest= -2;}else if which==3 {bad.latest=1;}else if which==4 {bad.refused= -1;}else if which==5 {bad.refused=1000000001;}else if which==6 {bad.forgotten= -1;}else {bad.forgotten=1000000001;}#assert !actor_memory_ok(bad,0);}
 m.count=8;m.latest=0;m.refused=1000000000;m.forgotten=1000000000;
 for i:0..<8 {m.items[i]=senses.Stimulus.{kind=senses.StimulusKind.sight,source=i+2,tick=0,at=spatial.world_point(1,0,0)};}#assert actor_memory_ok(m,0);
 for which:0..<7 {bad:=m;if which==0 {bad.items[0].kind=senses.StimulusKind.none;}else if which==1 {bad.items[0].source=0;}else if which==2 {bad.items[0].tick= -1;}else if which==3 {bad.items[0].tick=1;}else if which==4 {bad.items[0].at.x=1000000;}else if which==5 {bad.items[1]=bad.items[0];}else {bad.items[7].at.z= -1000000;}#assert !actor_memory_ok(bad,0);}
 p:=ActorParameters.{period=1};old:=ActorPerception.{tick=0,memory=m};c:=[1]ActorCandidate.[ActorCandidate.{id=10,generation=4096,clear=true}];r:=actor_perceive(p,old,1,1,0,0,0,0,0,c[..]);#assert r.status==ACTOR_EXHAUSTED;
 old.memory.refused=0;old.memory.forgotten=0;r=actor_perceive(p,old,1,1,0,0,0,0,0,c[..]);#assert r.status==ACTOR_OK && r.state.memory.count==8 && r.state.memory.refused==1 && r.state.reason==6 && (r.flags&ACTOR_KNOWN)==0;
 old.memory.forgotten=1000000000;p.forget=1;r=actor_perceive(p,old,2,1,0,0,0,0,0,c[..]);#assert r.status==ACTOR_INVALID;
 old.tick=1;r=actor_perceive(p,old,2,1,0,0,0,0,0,c[..]);#assert r.status==ACTOR_EXHAUSTED;
}
#load "../../core/assets.coax" as assets;
#test "the complete acquisition retention culling generation and memory trace matches the independent oracle" #steps 200000000 #traversal 2000000000 {
 old:ActorPerception;p:=ActorParameters.{period=4,grace=6,forget=8};words:[4096]int;n:=0;
 for tick:0..<128 {candidates:=[3]ActorCandidate.[ActorCandidate.{id=1,generation=1,clear=true},ActorCandidate.{id=2,generation=ifx tick>=80 then 2 else 1,x=100+tick*7,clear=tick%8<4,eligible=tick<48 || tick>=64},ActorCandidate.{id=3,generation=1,x= -600,clear=tick%16<12}];focus:=ifx tick>=112 then 2001 else 0;
  got:=actor_perceive(p,old,tick,1,0,0,0,focus,0,candidates[..]);#assert got.status==ACTOR_OK;old=got.state;
  record:=[13]int.[tick,got.status,old.reason,old.target,old.generation,old.last_seen,old.lost,ifx old.seen then 1 else 0,ifx old.alert then 1 else 0,ifx old.culled then 1 else 0,cast(int)got.flags,got.work,old.memory.count];for v:record {words[n]=v;n+=1;}
  for i:0..<old.memory.count {st:=old.memory.items[i];item:=[4]int.[st.source,st.tick,cast(int)f32_bits(st.at.x),cast(int)f32_bits(st.at.z)];for v:item {words[n]=v;n+=1;}}
 }h:[64]u8;#assert assets.asset_hex(state_words_id(words[0..<n]),h[..]) && cast(string)h[..]=="5cf24be3a55cd5fc6d54d6f9cd076c22d6fe05e5f90fa9c039c8652e64875ddf";
}
#test "coordinate generation and stable tie endpoints are admitted exactly" {
 #assert actor_point_ok(-1000000,0,0) && actor_point_ok(1000000,0,0) && actor_point_ok(0,-1000000,0) && actor_point_ok(0,1000000,0) && actor_point_ok(0,0,-1000000) && actor_point_ok(0,0,1000000);
 p:=ActorParameters.{period=1};old:ActorPerception;c:=[2]ActorCandidate.[ActorCandidate.{id=3,generation=1,x=600,clear=true},ActorCandidate.{id=2,generation=1,x= -600,clear=true}];r:=actor_perceive(p,old,0,1,0,0,0,0,0,c[..]);#assert r.state.target==2 && r.state.reason==1;
 c[1].generation=4096;r=actor_perceive(p,old,0,1,0,0,0,0,0,c[..]);#assert r.state.generation==4096;
 c[1].x= -800;c[0].eligible=false;r=actor_perceive(p,r.state,1,1,0,0,0,0,0,c[..]);#assert r.state.seen;c[1].x= -801;r=actor_perceive(p,r.state,2,1,0,0,0,0,0,c[..]);#assert !r.state.seen;
 m:senses.Memory;m.count=1;m.latest=0;m.items[0]=senses.Stimulus.{kind=senses.StimulusKind.sight,source=1,tick=0,at=spatial.world_point(0,0,0)};#assert actor_memory_ok(m,0);
}
#test "sight invalidation between samples clears every held bit and preserves a named reason" {
 p:=ActorParameters.{period=4};old:ActorPerception;c:=[1]ActorCandidate.[ActorCandidate.{id=1,generation=1,clear=true}];r:=actor_perceive(p,old,0,3,0,0,0,0,0,c[..]);#assert r.state.target==1 && r.state.seen && r.state.alert;
 unloaded:=actor_perceive(p,r.state,1,3,0,0,0,0,0,c[0..<0]);#assert unloaded.status==ACTOR_OK && unloaded.state.reason==4 && unloaded.state.target==0 && unloaded.state.generation==0 && unloaded.state.last_seen== -1 && !unloaded.state.seen && !unloaded.state.alert && unloaded.flags==0;
 c[0].generation=2;c[0].clear=false;stale:=actor_perceive(p,r.state,1,3,0,0,0,0,0,c[..]);#assert stale.state.reason==4 && stale.state.target==0 && stale.flags==0;
 c[0].generation=1;culled:=actor_perceive(p,r.state,1,3,0,0,0,2001,0,c[..]);#assert culled.state.reason==5 && !culled.state.seen && !culled.state.alert;
 none:=actor_perceive(p,old,0,3,0,0,0,0,0,c[0..<0]);#assert none.state.reason==0 && none.state.target==0 && none.flags==0;
 c[0].generation=1;r=actor_perceive(p,r.state,1,3,0,0,0,0,0,c[..]);r=actor_perceive(p,r.state,2,3,0,0,0,0,0,c[..]);r=actor_perceive(p,r.state,3,3,0,0,0,0,0,c[..]);r=actor_perceive(p,r.state,4,3,0,0,0,0,0,c[..]);#assert r.state.reason==2 && r.state.target==1 && r.state.lost==4 && (r.flags&ACTOR_KNOWN)!=0;
}
#test "translated three-axis sensing culling distance and remembered coordinates retain their units" {
 p:=ActorParameters.{period=1};old:ActorPerception;c:=[1]ActorCandidate.[ActorCandidate.{id=1,generation=1,x=1100,y=1100,z=1100,clear=true}];
 r:=actor_perceive(p,old,0,3,1100,1100,1100,1100,1100,c[..]);#assert r.state.seen && !r.state.culled && r.state.memory.items[0].at.x==11 && r.state.memory.items[0].at.y==11 && r.state.memory.items[0].at.z==11;
 c[0].x=0;c[0].y=0;c[0].z=0;r=actor_perceive(p,old,0,3,0,0,0,0,2001,c[..]);#assert r.state.culled && r.state.reason==5;
 p.sense_work=16;all:[16]ActorCandidate;for i:0..<16 {all[i]=ActorCandidate.{id=i+1,generation=1,clear=true};}r=actor_perceive(p,old,0,100,0,0,0,0,0,all[..]);#assert r.status==ACTOR_OK && r.work==16 && r.state.target==1 && r.flags==(ACTOR_SEEN|ACTOR_ALERTED|ACTOR_KNOWN);
 old.tick=999999999;r=actor_perceive(p,old,1000000000,100,0,0,0,0,0,all[0..<0]);#assert r.status==ACTOR_OK && r.state.tick==1000000000;
 old.tick=1000000000;#assert actor_perceive(p,old,1000000001,100,0,0,0,0,0,all[0..<0]).status==ACTOR_INVALID;
 #assert actor_rank_before(3,9,4,1) && !actor_rank_before(4,1,3,9) && actor_rank_before(3,1,3,9) && !actor_rank_before(3,9,3,1) && !actor_rank_before(3,9,3,9);
}
#test "memory capacity and terminal counters have no masked boundary failures" {
 m:senses.Memory;m.count=8;m.latest=0;for i:0..<8 {m.items[i]=senses.Stimulus.{kind=senses.StimulusKind.sight,source=i+1,tick=0,at=spatial.world_point(0,0,0)};}#assert actor_memory_ok(m,0);m.count=9;#assert !actor_memory_ok(m,0);
 old:=ActorPerception.{tick=0};old.memory.refused=1000000000;old.memory.forgotten=1000000000;p:=ActorParameters.{period=1};c:[1]ActorCandidate;
 r:=actor_perceive(p,old,1,1,0,0,0,0,0,c[0..<0]);#assert r.status==ACTOR_OK && r.state.memory.refused==1000000000 && r.state.memory.forgotten==1000000000;
 old.tick=1;old.memory=m;old.memory.count=1;old.memory.refused=0;old.memory.forgotten=1000000000;p.forget=1;r=actor_perceive(p,old,2,1,0,0,0,0,0,c[0..<0]);#assert r.status==ACTOR_EXHAUSTED;
}

#test "horizontal anchors retain both exact coordinate endpoints without an artificial height" {
 #assert actor_flat_point_ok(-1000000,0) && actor_flat_point_ok(1000000,0) && actor_flat_point_ok(0,-1000000) && actor_flat_point_ok(0,1000000);
 #assert !actor_flat_point_ok(-1000001,0) && !actor_flat_point_ok(1000001,0) && !actor_flat_point_ok(0,-1000001) && !actor_flat_point_ok(0,1000001);
