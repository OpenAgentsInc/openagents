// Native emitted-code observations for the independent phase-order oracle.
#import "Basic";
#load "../phases.coax" as actors;
main :: () #effects(all) {
 for graph:0..<4096 {for profile:0..<4 {
  tasks:=[4]actors.ActorTask.[actors.ActorTask.{id=40},actors.ActorTask.{id=10},
   actors.ActorTask.{id=30},actors.ActorTask.{id=20}];
  if profile==1 {for i:0..<4 {tasks[i].writes=1;}}
  if profile==2 {tasks[0].writes=1;tasks[1].reads=1;tasks[2].writes=2;tasks[3].reads=2;}
  if profile==3 {tasks[0].phase=3;tasks[1].phase=0;tasks[2].phase=2;tasks[3].phase=1;}
  bit:=0;for i:0..<4 {for j:0..<4 {if i==j {continue;}
   if (graph & (1<<bit))!=0 {tasks[i].dependencies[tasks[i].dependency_count]=tasks[j].id;tasks[i].dependency_count+=1;}
   bit+=1;
  }}
  r:=actors.actor_plan_compile(1,tasks[..]);
  print("% % % % % % % % %\n",graph,profile,cast(int)r.status,ifx r.plan.valid then 1 else 0,r.plan.n,
   r.plan.steps[0].id,r.plan.steps[1].id,r.plan.steps[2].id,r.plan.steps[3].id);
 }}
}
