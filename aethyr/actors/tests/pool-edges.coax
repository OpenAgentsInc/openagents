#load "../../core/entity.coax" as entities;
#load "../../ai/decide.coax" as decisions;
#test "direct spawns publish exact scoped clock and model catalogue without an override wrapper" #steps 200000000 #traversal 2000000000 {
 f:=actor_test_pool();refs:StateRefs;d:=f.definition;d.parameters.hooks=1;d.parameters.schedule[0].field=f.resources.schema.fields[0].id;
 author:=[1]ActorAuthor.[ActorAuthor.{id=d.id,parameters=d.parameters}];c:=actor_compile(author[..],f.resources.schema,refs,2);#assert c.status==ACTOR_OK && actor_definition_admit(c.items[0],f.resources.schema,refs,2);
 f.pool[0].models[0].catalogue[1]=0;f.resources.world[0].variant=0;f.resources.world[0].facts.day=3;f.resources.world[0].facts.phase=11;
 got:=actor_spawn(f.pool[..],c.items[0],f.resources.schema,refs,2,f.resources.m[..],f.resources.pool[..],f.resources.world[0],500,700,1000000000);#assert got.status==ACTOR_OK;
 a:=f.pool[0].actors[entities.entity_slot(got.handle)];#assert a.facts.tick==1000000000 && a.facts.day==3 && a.facts.phase==11 && a.facts.values[1].integer==1 && a.day_ticks==f.resources.schema.day_ticks;
 #assert f.pool[0].models[0].catalogue[1]==decisions.DECIDE_ALL && f.pool[0].hooks[0]==2;
 f.pool[0].limits.capacity=2;#assert actor_spawn(f.pool[..],f.definition,f.resources.schema,refs,2,f.resources.m[..],f.resources.pool[..],f.resources.world[0],0,0,0).status==ACTOR_CAPACITY;
}
#test "resource bit masks validate selected slots before hold and release slot zero on rollback" #steps 300000000 #traversal 3000000000 {
 base:=actor_test_pool();refs:StateRefs;
 for bit:0..<6 {f:=base;d:=f.definition;d.parameters.resources=cast(u32)1<<cast(u32)bit;d.content=actor_definition_id(d);for j:0..<6 {if j!=bit {f.resources.world[0].members[j].slot= -1;}}
 got:=actor_spawn(f.pool[..],d,f.resources.schema,refs,2,f.resources.m[..],f.resources.pool[..],f.resources.world[0],0,0,0);#assert got.status==ACTOR_OK;
 f.resources.world[0].members[bit].slot= -1;
 #assert actor_spawn(f.pool[..],d,f.resources.schema,refs,2,f.resources.m[..],f.resources.pool[..],f.resources.world[0],0,0,0).status==ACTOR_RESOURCES;
 }
 for mode:0..<2 {f:=base;old:=f.resources.world[0].members[0];root:=f.resources.pool[0].claims[old.slot].root;
 replacement:=resource_stream_hold(f.resources.pool[..],f.resources.m[..],root);#assert replacement.slot>=0;f.resources.world[0].members[0]=replacement;dropped:=resource_stream_drop(f.resources.pool[..],f.resources.m[..],old);#assert dropped && old.slot==0;
 if mode==0 {while actor_test_claims(f.resources.pool[..])<60 {held:=resource_stream_hold(f.resources.pool[..],f.resources.m[..],root);#assert held.slot>=0;}
 // Free slot zero again, so it is the first partial hold the failed spawn owns.
 for claim,i:f.resources.pool[0].claims {if i==0 && claim.live {dropped2:=resource_stream_drop(f.resources.pool[..],f.resources.m[..],ResourceReference.{slot=i,epoch=f.resources.pool[0].epoch,serial=claim.serial});#assert dropped2;}}
 }else {f.pool[0].n[entities.ENTITY_NEXT_ID]=9223372036854775807;}
 before:=actor_test_claims(f.resources.pool[..]);got:=actor_spawn(f.pool[..],f.definition,f.resources.schema,refs,2,f.resources.m[..],f.resources.pool[..],f.resources.world[0],0,0,0);
 #assert got.status==ACTOR_CAPACITY && actor_test_claims(f.resources.pool[..])==before && !f.resources.pool[0].claims[0].live;
 }
}
#test "external entity retirement is never an actor removal and hook flags are independent" #steps 200000000 #traversal 2000000000 {
 f:=actor_test_pool();store:=actor_entity_store(f.pool[..]);other:=entities.entity_spawn(store);entities.entity_flush(store);#assert !actor_remove(f.pool[..],other.handle);
 f.pool[0].actors[0].definition.parameters.hooks=2;#assert actor_remove(f.pool[..],f.handle);actor_flush(f.pool[..],f.resources.m[..],f.resources.pool[..]);#assert f.pool[0].hooks[1]==1;
 a:=ActorExecInstance.{id=5,day_ticks=32,scope_home=2};#assert actor_scope_schema(a).day_ticks==32;
}

#test "enabled defaults external retirement and independent hook bits are observable" #steps 200000000 #traversal 2000000000 {
 schema:=actor_instance_schema(1,1);#assert schema.fields[0].initial.integer==1;
 f:=actor_test_pool();store:=actor_entity_store(f.pool[..]);other:=entities.entity_spawn(store);entities.entity_flush(store);entities.entity_despawn(store,other.handle);actor_flush(f.pool[..],f.resources.m[..],f.resources.pool[..]);
 #assert f.pool[0].scan_cap==16 && f.pool[0].sense_cap==4 && f.pool[0].hooks[1]==0;
 f.pool[0].actors[0].definition.parameters.hooks=1;#assert actor_remove(f.pool[..],f.handle);actor_flush(f.pool[..],f.resources.m[..],f.resources.pool[..]);#assert f.pool[0].hooks[1]==0;
}
