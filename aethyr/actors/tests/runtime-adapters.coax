#load "../../entity.coax" as entities;
#load "../../ai/decide.coax" as decisions;
#load "../../ai/stimulus.coax" as senses;
#load "../../space.coax" as spatial;
#load "../../walk.coax" as walking;
#test "runtime derives guarded control path and model knowledge without granting unselected model goals" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<8 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.perception.tick=1;a.definition.parameters.controller=1;
 a.definition.parameters.rules[0]=ActorRule.{verb=ACTOR_INTERACT,goal=ACTOR_ROUTINE,require=ifx mode==0 then ACTOR_CONTROLLED else ifx mode==1 then ACTOR_PATH_FAILED else ifx mode==2 || mode==4 then ACTOR_MODEL else ifx mode==3 then ACTOR_SEEN else ifx mode==5 then ACTOR_ALERTED else ifx mode==6 then ACTOR_SCHEDULE else 0};
 a.definition.parameters.rules[0].forbid=ifx mode==3 then 0 else ACTOR_SEEN;if mode==3 {a.choice.work=ACTOR_SEEN;}if mode==0 {a.controller=1;}if mode==1 {a.navigation.status=ACTOR_NAV_UNREACHABLE;}if mode>=2 {a.model=decisions.DecideIntent.{kind=ifx mode==4 then decisions.DECIDE_HOLD else decisions.DECIDE_GO,x=8,z=7};}
 f[0].base.pool[0].actors[i]=a;w:=actor_runtime_world(f[..],1);work:[1]ActorWork;actor_runtime_choose(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];
 #assert got.choice.status==ACTOR_OK && got.choice.verb==(ifx mode==5 then ACTOR_HOLD else ACTOR_INTERACT) && got.brain.rule==(ifx mode==5 then -1 else 0) && work[0].choices==got.choice.work && work[0].choices>0 && got.goal_x==(ifx mode==2 then 800 else 600) && got.goal_z==(ifx mode==2 then 700 else 600);
 }
}
#test "tracked sight uses the wider band and inclusive height and update culling boundaries" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<4 {f:=base;store:=actor_entity_store(f[0].base.pool[..]);target:=entities.entity_spawn(store);entities.entity_flush(store);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.definition.parameters.period=1;
 a.perception.target=target.id.value;a.perception.generation=1;a.perception.seen=true;a.perception.memory.count=1;a.perception.memory.latest=0;a.perception.memory.items[0]=senses.Stimulus.{kind=senses.StimulusKind.sight,source=target.id.value,tick=0,at=spatial.world_point(11,0,4)};f[0].base.pool[0].actors[i]=a;
 targets:=[1]ActorTarget.[ActorTarget.{handle=target.handle,x=ifx mode==0 then 1100 else 500,y=ifx mode==1 then 300 else ifx mode==2 then -300 else 0,z=400}];w:=actor_runtime_world(f[..],1);w.targets=targets[..];if mode==3 {w.focus_x=2400;}
 work:[1]ActorWork;actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];#assert got.perception.seen && got.perception.target==target.id.value && work[0].rays==1 && work[0].refused==0;
 }
}
#test "one admitted rider tuple pays exactly one shared walking step with authored speed and capsule" #steps 200000000 #traversal 2000000000 {
 for variant:0..<2 {f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.body.theta=1;a.controller=1;a.input=ActorControl.{x= -100,z=100,jump=true};a.definition.parameters.speed=ifx variant==0 then 300 else 800;a.definition.parameters.radius=ifx variant==0 then 30 else 40;f[0].base.pool[0].actors[i]=a;
 w:=actor_runtime_world(f[..],1);body:=walking.walk_input(a.body,-1,-1,0,0,false,true,0,0);body.theta=0;world:=w.bodies;world.collision.radius=ifx variant==0 then 0.3 else 0.4;world.collision.max_travel=world.collision.radius/2;world.locomotion.walk_speed=ifx variant==0 then 3 else 8;world.locomotion.run_speed=world.locomotion.walk_speed;expected:=walking.step(world,body,1.0f32/64.0f32);
 work:[1]ActorWork;actor_runtime_move(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i].body;
 #assert got.pos.x==expected.pos.x && got.pos.y==expected.pos.y && got.pos.z==expected.pos.z && got.vel.x==expected.vel.x && got.vel.y==expected.vel.y && got.vel.z==expected.vel.z && got.face==expected.face && got.theta==0 && !got.run;
}
}
#test "empty paid worlds admit exact clock snapshot and coordinate ceilings without inventing actors" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);
 for mode:0..<3 {p:[1]ActorExecPool;#assert actor_exec_pool_open(p[..],ActorLimits.{});w:=actor_runtime_world(f[..],0);w.tick=ifx mode==0 then 0 else 999999000;p[0].tick=w.tick-1;w.facts.tick=w.tick;
 w.clearance=ifx mode==1 then 80 else 10;w.focus_x=ifx mode==1 then -1000000 else 1000000;w.focus_z=w.focus_x;
 anchors:[16]ActorAnchor;targets:[16]ActorTarget;for i:0..<16 {anchors[i]=ActorAnchor.{id=i+1,x=w.focus_x,z=w.focus_x};targets[i]=ActorTarget.{handle=entities.entity_handle(i,EntityGeneration.{}),x=w.focus_x,y=w.focus_x,z=w.focus_x};}
 w.anchors=anchors[..];w.targets=targets[..];work:=actor_runtime_step(p[..],w);
 #assert work.ok && p[0].tick==w.tick && work.scans==0 && work.sense==0 && work.rays==0 && work.search==0 && work.choices==0 && work.refused==0;
 }
}
#test "the first unsupported public snapshot sizes and clocks refuse independently" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);
 for mode:0..<5 {p:[1]ActorExecPool;#assert actor_exec_pool_open(p[..],ActorLimits.{});w:=actor_runtime_world(f[..],0);anchors:[17]ActorAnchor;targets:[17]ActorTarget;walk:[129]bool;
 for i:0..<17 {anchors[i]=ActorAnchor.{id=i+1};targets[i]=ActorTarget.{handle=entities.entity_handle(i,EntityGeneration.{})};}
 if mode==0 {w.tick= -1;p[0].tick= -2;}else if mode==1 {w.tick=999999001;p[0].tick=999999000;}else if mode==2 {w.targets=targets[..];}else if mode==3 {w.anchors=anchors[..];}else {w.grid.nx=129;w.grid.nz=1;w.walk=walk[..];}
 w.facts.tick=w.tick;#assert !actor_runtime_step(p[..],w).ok;
 }
}
