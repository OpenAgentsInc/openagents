#load "../../entity.coax" as entities;
#load "../../walk.coax" as walking;
#load "../../query-filter.coax" as filters;
#load "../../query.coax" as queries;
#test "paid phases include actor one and preserve external doomed and unpublished component records" #steps 300000000 #traversal 3000000000 {
 for mode:0..<3 {f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);f[0].base=actor_test_pool();store:=actor_entity_store(f[0].base.pool[..]);first:=f[0].base.handle;
 other:=entities.entity_spawn(store);entities.entity_flush(store);other_slot:=entities.entity_slot(other.handle);
 refs:StateRefs;pending:ActorSpawnResult;if mode==1 {#assert actor_remove(f[0].base.pool[..],first);f[0].base.pool[0].actors[entities.entity_slot(first)].facts.ready=false;}else if mode==2 {pending=actor_spawn(f[0].base.pool[..],f[0].base.definition,f[0].base.resources.schema,refs,2,f[0].base.resources.m[..],f[0].base.resources.pool[..],f[0].base.resources.world[0],500,500,1);#assert pending.status==ACTOR_OK;}
 work:=actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1));#assert work.ok && work.refused==0;
 #assert f[0].base.pool[0].actors[other_slot].pose_tick== -1 && f[0].base.pool[0].actors[other_slot].brain.tick== -1 && !f[0].base.pool[0].actors[other_slot].facts.ready;
 a:=f[0].base.pool[0].actors[entities.entity_slot(first)];#assert a.pose_tick==(ifx mode==1 then -1 else 1) && a.facts.tick==(ifx mode==1 then 0 else 1);
 if mode==2 {i:=entities.entity_slot(pending.handle);#assert f[0].base.pool[0].actors[i].pose_tick== -1 && f[0].base.pool[0].actors[i].facts.tick==1;actor_flush(f[0].base.pool[..],f[0].base.resources.m[..],f[0].base.resources.pool[..]);#assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],2)).ok && f[0].base.pool[0].actors[i].pose_tick==2;}
 }
}
#test "the last ordinary phase before a day boundary does not allocate a jump operation" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.facts.phase=a.day_ticks-2;f[0].base.pool[0].actors[i]=a;w:=actor_runtime_world(f[..],1);w.facts.phase=a.day_ticks-1;
 #assert actor_runtime_step(f[0].base.pool[..],w).ok && f[0].base.pool[0].actors[i].facts.sequence==0 && f[0].base.pool[0].actors[i].facts.day==0;
}
#test "unsupported clearance retry pays exactly at its deadline and a blocked single axis becomes stuck" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.definition.parameters.radius=40;a.choice.verb=ACTOR_GO;a.navigation=ActorNavigation.{key=ActorNavKey.{request=1},status=ACTOR_NAV_INVALIDATED,serial=1,retry_at=1};w:=actor_runtime_world(f[..],1);a.navigation.key=actor_context(a,w);f[0].base.pool[0].actors[i]=a;work:[1]ActorWork;actor_runtime_move(f[0].base.pool[..],i,w,work[..]);#assert work[0].refused==1 && f[0].base.pool[0].actors[i].navigation.retry_at==17;
 for axis:0..<2 {g:[1]ActorRuntimeFixture;actor_runtime_fixture(g[..]);slot:=entities.entity_slot(g[0].base.handle);actor:=g[0].base.pool[0].actors[slot];actor.controller=1;actor.definition.parameters.controller=1;actor.definition.parameters.radius=40;actor.definition.parameters.stuck=2;actor.input=ActorControl.{x=ifx axis==0 then 100 else 0,z=ifx axis==1 then 100 else 0};g[0].base.pool[0].actors[slot]=actor;
 wall:=ifx axis==0 then [6]f32.[4.4,0,3,5,3,5] else [6]f32.[3,0,4.4,5,3,5];for tick:1..<3 {view:=actor_runtime_world(g[..],tick);view.bodies.walls=wall[..];paid:[1]ActorWork;actor_runtime_move(g[0].base.pool[..],slot,view,paid[..]);}
 #assert g[0].base.pool[0].actors[slot].navigation.status==ACTOR_NAV_STUCK && g[0].base.pool[0].actors[slot].navigation.retry_at==18;
 }
}
#test "missing remembered or authored goals fall back to the current body rather than a stale destination" #steps 200000000 #traversal 2000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for goal:0..<5 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.definition.parameters.controller=1;a.definition.parameters.rules[0].goal=goal;a.body.pos.z=5.25;a.goal_x=900;a.goal_z=900;a.perception.tick=1;
 if goal==ACTOR_HOME {a.facts.values[1]=state_int(2);}if goal==ACTOR_ROUTINE {a.definition.parameters.schedule[0].phase=2;}
 f[0].base.pool[0].actors[i]=a;work:[1]ActorWork;actor_runtime_choose(f[0].base.pool[..],i,actor_runtime_world(f[..],1),work[..]);got:=f[0].base.pool[0].actors[i];#assert got.goal_x==400 && got.goal_z==525 && work[0].refused==0;
 }
}
#test "disabled editor resets keep a current-key navigation ticket in the invalidated mode" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.scope_enabled=false;a.facts.values[0]=state_bool(false);a.navigation=ActorNavigation.{key=ActorNavKey.{request=1},status=ACTOR_NAV_PENDING,serial=1,asked=0};w:=actor_runtime_world(f[..],1);a.navigation.key=actor_context(a,w);f[0].base.pool[0].actors[i]=a;
 #assert actor_editor_reset(f[0].base.pool[..],f[0].base.handle,a.owner,1);#assert actor_runtime_step(f[0].base.pool[..],w).ok && f[0].base.pool[0].actors[i].navigation.status==ACTOR_NAV_INVALIDATED;
}
#test "exact sense capacity includes the whole sample and sight starts above the feet" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);store:=actor_entity_store(f[0].base.pool[..]);target:=entities.entity_spawn(store);entities.entity_flush(store);i:=entities.entity_slot(f[0].base.handle);f[0].base.pool[0].actors[i].definition.parameters.period=1;f[0].base.pool[0].actors[i].definition.parameters.sense_work=1;
 sight_floor:=[6]f32.[3.5,-1,3.5,4.5,0,4.5];metadata:=[1]filters.QueryCollider.[filters.QueryCollider.{ref=filters.ColliderRef.{id=1,generation=1},shape=queries.QueryShape.box,surface=1}];targets:=[1]ActorTarget.[ActorTarget.{handle=target.handle,x=500,z=400}];w:=actor_runtime_world(f[..],1);w.targets=targets[..];w.queries.geometry.boxes=sight_floor[..];w.queries.metadata=metadata[..];work:[1]ActorWork;actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);#assert work[0].rays==1 && work[0].sense==1 && work[0].refused==0 && f[0].base.pool[0].actors[i].perception.seen;
}
#test "pending flow admission includes cell zero but excludes the exact horizon and uses the actor's minimal capsule" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<3 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];w:=actor_runtime_world(f[..],1);a.choice.verb=ACTOR_GO;
 if mode==0 {a.body=walking.walk_place(0.5,0,0.5,0);a.goal_x=150;a.goal_z=50;a.navigation=ActorNavigation.{key=ActorNavKey.{request=1},status=ACTOR_NAV_PENDING,goal=1,asked=0,serial=1};}
 else if mode==1 {a.body=walking.walk_place(1005,0,5,0);a.goal_x=500;a.goal_z=500;w.grid.nx=128;w.grid.nz=1;w.grid.cell=10;a.navigation=ActorNavigation.{key=ActorNavKey.{request=1},status=ACTOR_NAV_PENDING,goal=0,asked=0,serial=1};}
 else {a.controller=1;a.definition.parameters.controller=1;a.definition.parameters.radius=10;a.definition.parameters.speed=300;a.input=ActorControl.{x=100};}
 a.body.theta=0;a.navigation.key=actor_context(a,w);f[0].base.pool[0].actors[i]=a;work:[1]ActorWork;actor_runtime_move(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];
 if mode==0 {#assert got.navigation.status==ACTOR_NAV_SUCCESS && got.body.pos.x>0.5;}else if mode==1 {#assert got.navigation.status==ACTOR_NAV_UNREACHABLE && got.navigation.retry_at==17;}else {#assert got.body.pos.x>4;}
 }
}
#test "a scoped clock behind the paid clock refuses before publication" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);f[0].base.pool[0].tick=1;i:=entities.entity_slot(f[0].base.handle);#assert !actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],2)).ok && f[0].base.pool[0].tick==1 && f[0].base.pool[0].actors[i].facts.tick==0 && f[0].base.pool[0].actors[i].pose_tick== -1;
}
#test "invalidated pending and goal-changed tickets retain their typed mode when request IDs are exhausted" #steps 200000000 #traversal 2000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<2 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.choice.verb=ACTOR_GO;a.goal_x=600;a.goal_z=600;
 a.navigation=ActorNavigation.{key=ActorNavKey.{request=ifx mode==0 then 1000000000 else 1},status=ifx mode==0 then ACTOR_NAV_SUCCESS else ACTOR_NAV_PENDING,goal=ifx mode==0 then 0 else 102,asked=0,serial=1000000000};w:=actor_runtime_world(f[..],1);a.navigation.key=actor_context(a,w);f[0].base.pool[0].actors[i]=a;work:[1]ActorWork;actor_runtime_move(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];#assert got.navigation.status==ACTOR_NAV_INVALIDATED && got.navigation.serial==1000000000 && work[0].refused==mode+1;
 }
}
