#load "../../entity.coax" as entities;
#load "../../ai/decide.coax" as decisions;
#load "../../ai/stimulus.coax" as senses;
#load "../../space.coax" as spatial;
#test "centimetres and navigation context preserve exact coordinate and identity boundaries" {
 #assert actor_cm(0.125)==13 && actor_cm(-0.125)== -12 && actor_cm(1.25)==125 && actor_cm(-1.25)== -125;
 a:=ActorExecInstance.{id=7,owner=11};a.handle=entities.entity_handle(0,EntityGeneration.{value=2});a.definition.parameters.radius=40;a.navigation.key.request=3;
 k:=actor_context(a,ActorStepWorld.{revision=17,nav_revision=19});#assert k.actor==7 && k.generation==3 && k.owner==11 && k.world==17 && k.nav==19 && k.profile==0 && k.radius==40 && k.request==3;
}
#test "a malformed second scope cannot advance a first scope or cancel its pending model" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);refs:StateRefs;
 other:=actor_spawn(f[0].base.pool[..],f[0].base.pool[0].actors[i].definition,f[0].base.resources.schema,refs,1,f[0].base.resources.m[..],f[0].base.resources.pool[..],f[0].base.resources.world[0],500,500,0);#assert other.status==ACTOR_OK;actor_flush(f[0].base.pool[..],f[0].base.resources.m[..],f[0].base.resources.pool[..]);
 f[0].base.pool[0].actors[entities.entity_slot(other.handle)].facts.ready=false;
 f[0].base.pool[0].actors[i].model=decisions.DecideIntent.{kind=decisions.DECIDE_HOLD};f[0].base.pool[0].actors[i].model_world=2;
 #assert !actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1)).ok;
 a:=f[0].base.pool[0].actors[i];#assert a.facts.tick==0 && a.brain.tick==0 && a.pose_tick== -1 && a.model.kind==decisions.DECIDE_HOLD;
}
#test "sense capacity refuses the whole snapshot and disabled actors spend no ray or scan work" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);store:=actor_entity_store(f[0].base.pool[..]);first:=entities.entity_spawn(store);second:=entities.entity_spawn(store);entities.entity_flush(store);
 targets:=[2]ActorTarget.[ActorTarget.{handle=first.handle,x=500,z=400},ActorTarget.{handle=second.handle,x=400,z=500}];
 f[0].base.pool[0].actors[i].definition.parameters.period=1;f[0].base.pool[0].actors[i].definition.parameters.sense_work=1;w:=actor_runtime_world(f[..],1);w.targets=targets[..];work:[1]ActorWork;actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);
 #assert work[0].refused==1 && work[0].sense==0 && work[0].scans==2 && work[0].rays==0 && f[0].base.pool[0].actors[i].perception.tick==1 && f[0].base.pool[0].actors[i].perception.memory.count==0;
 f[0].base.pool[0].actors[i].facts.values[0]=state_bool(false);w.tick=2;work[0]=ActorWork.{};actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);#assert work[0].refused==0 && work[0].scans==0 && work[0].rays==0;
}

#test "runtime refuses a different compiled world schema before any actor publication" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);w:=actor_runtime_world(f[..],1);w.schema.revision=2;w.facts.version=2;
 #assert !actor_runtime_step(f[0].base.pool[..],w).ok && f[0].base.pool[0].tick==0;
}
