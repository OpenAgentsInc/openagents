#load "../../core/entity.coax" as entities;
#load "../../move/walk.coax" as walking;
#test "an open grid route pays the independently specified shared walker input sequence" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);expected:=f[0].base.pool[0].actors[i].body;world:=actor_runtime_world(f[..],1).bodies;world.collision.radius=0.3;world.collision.max_travel=0.15;world.locomotion.walk_speed=2;world.locomotion.run_speed=2;settled:=0;searched:=0;
 // One deferred request step, then the grid oracle's (5,5) diagonal: the
 // typed controller truncates 100/sqrt(2) to 70 on each world axis.
 for tick:1..<9 {body:=walking.walk_input(expected,ifx tick==1 then 0 else 0.7,ifx tick==1 then 0 else -0.7,0,0,false,false,0,0);body.cam.theta=0;expected=walking.step(world,body,1.0f32/64.0f32);
  work:=actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],tick));#assert work.ok && work.refused==0;settled+=work.settled;searched+=work.search;got:=f[0].base.pool[0].actors[i].body;
  #assert got.body.pos.x==expected.body.pos.x && got.body.pos.y==expected.body.pos.y && got.body.pos.z==expected.body.pos.z && got.body.vel.x==expected.body.vel.x && got.body.vel.z==expected.body.vel.z && got.body.face==expected.body.face;
 }
 a:=f[0].base.pool[0].actors[i];#assert searched==1 && settled==128 && a.navigation.status==ACTOR_NAV_SUCCESS && a.navigation.serial==1 && a.navigation.asked==1 && a.navigation.goal==102 && a.brain.until==17 && a.brain.draws==1 && a.last_anchor==1;
}
#test "routine anchors and instance home are distinct and long grid searches keep the exact cost horizon" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for goal:0..<2 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.facts.values[1]=state_int(2);a.definition.parameters.rules[0].goal=goal;a.perception.tick=1;f[0].base.pool[0].actors[i]=a;
 anchors:=[2]ActorAnchor.[ActorAnchor.{id=1,x=600,z=600},ActorAnchor.{id=2,x=900,z=900}];w:=actor_runtime_world(f[..],1);w.anchors=anchors[..];work:[1]ActorWork;actor_runtime_choose(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];#assert got.goal_x==(ifx goal==ACTOR_HOME then 900 else 600) && got.goal_z==got.goal_x;
 }
 f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.body=walking.walk_place(1005,0,5,0);a.body.cam.theta=0;a.goal_x=500;a.goal_z=500;a.choice.verb=ACTOR_GO;
 a.navigation=ActorNavigation.{key=ActorNavKey.{request=1},status=ACTOR_NAV_PENDING,goal=0,asked=0,serial=1};w:=actor_runtime_world(f[..],1);w.grid.nx=128;w.grid.nz=1;w.grid.cell=10.005;a.navigation.key=actor_context(a,w);f[0].base.pool[0].actors[i]=a;work:[1]ActorWork;actor_runtime_move(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];
 #assert work[0].search==1 && work[0].settled==101 && got.navigation.status==ACTOR_NAV_UNREACHABLE && got.navigation.retry_at==17;
}
