ActorRuntimeFixture :: struct {base:ActorTestPool;walk:[128]bool;anchors:[1]ActorAnchor;epoch:[1]int;surfaces:[1]filters.PhysicalSurface;}
actor_runtime_fixture :: (f:[]ActorRuntimeFixture) #effects(all) {
 f[0].base=actor_test_pool();old:=f[0].base.handle;removed:=actor_remove(f[0].base.pool[..],old);actor_flush(f[0].base.pool[..],f[0].base.resources.m[..],f[0].base.resources.pool[..]);
 schema:=f[0].base.resources.schema;refs:StateRefs;author:=[1]ActorAuthor.[ActorAuthor.{id=1}];author[0].parameters.rules[0]=ActorRule.{verb=ACTOR_GO,goal=ACTOR_ROUTINE,duration=16};c:=actor_compile(author[..],schema,refs,1);
 spawn:=actor_spawn(f[0].base.pool[..],c.items[0],schema,refs,1,f[0].base.resources.m[..],f[0].base.resources.pool[..],f[0].base.resources.world[0],400,400,0);#assert spawn.status==ACTOR_OK;f[0].base.handle=spawn.handle;actor_flush(f[0].base.pool[..],f[0].base.resources.m[..],f[0].base.resources.pool[..]);f[0].base.pool[0].tick=0;
 for i:0..<128 {f[0].walk[i]=true;}f[0].anchors[0]=ActorAnchor.{id=1,x=600,z=600};f[0].epoch[0]=1;f[0].surfaces[0]=filters.PhysicalSurface.{id=1};
}
actor_runtime_world :: (f:[]ActorRuntimeFixture,tick:int)->ActorStepWorld #effects(all) {
 schema:=f[0].base.resources.schema;state:=f[0].base.resources.world[0].facts;state.tick=tick;state.phase=tick%schema.day_ticks;
 return ActorStepWorld.{tick=tick,revision=1,nav_revision=1,schema=schema,facts=state,anchors=f[0].anchors[..],queries=scene.QueryWorld.{geometry=queries.Colliders.{ground_enabled=false},surfaces=f[0].surfaces[..],entity_store=actor_entity_store(f[0].base.pool[..]),current_epoch=f[0].epoch[..],epoch=1,tick=tick},grid=navigation.NavGrid.{nx=16,nz=8,cell=1},walk=f[0].walk[..],focus_x=400,focus_z=400};
}
#test "runtime pays the existing shared walker and cached flow once with final pose after movement" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);
 for tick:1..<9 {world:=actor_runtime_world(f[..],tick);work:=actor_runtime_step(f[0].base.pool[..],world);#assert work.ok && work.refused==0 && work.search<=1 && work.settled<=128 && work.choices<=32;}
 a:=f[0].base.pool[0].actors[entities.entity_slot(f[0].base.handle)];#assert a.body.pos.x>4 && a.body.pos.z>4 && a.pose_tick==8 && a.presentation_x==a.body.pos.x && a.presentation_z==a.body.pos.z && a.facts.tick==8;
 #assert !actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],8)).ok;
}
#test "runtime refuses malformed paid views before publishing any actor phase" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<23 {f:=base;w:=actor_runtime_world(f[..],1);anchors:[17]ActorAnchor;targets:[17]ActorTarget;
 if mode==0 {f[0].base.pool[0].ready=false;}else if mode==1 {w.tick=0;}else if mode==2 {w.tick= -1;f[0].base.pool[0].tick= -2;}else if mode==3 {w.tick=999999001;f[0].base.pool[0].tick=w.tick-1;}else if mode==4 {w.revision=0;}else if mode==5 {w.nav_revision=0;}else if mode==6 {w.clearance=9;}else if mode==7 {w.clearance=81;}else if mode==8 {w.targets=targets[..];}else if mode==9 {w.anchors=anchors[0..<0];}else if mode==10 {w.anchors=anchors[..];}
 else if mode==11 {w.grid.nx=0;}else if mode==12 {w.grid.nz=9;}else if mode==13 {w.walk=f[0].walk[0..<127];}else if mode==14 {w.focus_x=1000001;}else if mode==15 {w.facts.tick=0;}else if mode==16 {f[0].anchors[0].id=2;}else if mode==17 {f[0].anchors[0].z= -1000001;}else if mode==18 {targets[0].y=1000001;w.targets=targets[0..<1];}else if mode==19 {w.targets=targets[0..<2];}else if mode==20 {w.facts.ready=false;}else if mode==21 {i:=entities.entity_slot(f[0].base.handle);f[0].base.pool[0].actors[i].facts.ready=false;}else {w.schema.day_ticks=0;}
 old:=f[0].base.pool[0].tick;#assert !actor_runtime_step(f[0].base.pool[..],w).ok && f[0].base.pool[0].tick==old;
 i:=entities.entity_slot(f[0].base.handle);#assert f[0].base.pool[0].actors[i].pose_tick== -1 && f[0].base.pool[0].actors[i].brain.tick==0;
 }
}
#test "editor resets are one paid operation and disabled scoped actors retain no competing input" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);
 f[0].base.pool[0].actors[i].facts.values[0]=state_bool(false);f[0].base.pool[0].actors[i].input=ActorControl.{x=100,jump=true};
 #assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1)).ok;
 a:=f[0].base.pool[0].actors[i];#assert a.body.pos.x==4 && a.body.pos.z==4 && a.input.x==0 && !a.input.jump && a.choice.reason==ACTOR_SLEEP;
 #assert actor_editor_reset(f[0].base.pool[..],f[0].base.handle,a.owner,add_sat(a.facts.sequence,1));
 #assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],2)).ok;
 a=f[0].base.pool[0].actors[i];#assert a.facts.values[0].integer==1 && a.facts.sequence==2 && a.reset_sequence==0 && a.brain.tick==2 && a.perception.tick==2 && f[0].base.pool[0].hooks[2]==1;
 #assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],3)).ok && f[0].base.pool[0].hooks[2]==1;
}
#test "navigation work exhaustion unsupported radii and world revision changes have typed bounded fallbacks" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<4 {f:=base;i:=entities.entity_slot(f[0].base.handle);
 if mode==0 {f[0].base.pool[0].actors[i].definition.parameters.path_work=1;}else if mode==1 {f[0].base.pool[0].actors[i].definition.parameters.radius=40;}else if mode==2 {f[0].anchors[0].x=1700;}else {for j:0..<128 {f[0].walk[j]=false;}}
 for tick:1..<5 {w:=actor_runtime_world(f[..],tick);work:=actor_runtime_step(f[0].base.pool[..],w);#assert work.ok && work.search<=1;}
 a:=f[0].base.pool[0].actors[i];#assert a.navigation.status==(ifx mode==0 then ACTOR_NAV_EXHAUSTED else ifx mode==1 then ACTOR_NAV_INVALIDATED else ACTOR_NAV_UNREACHABLE);
 }
 f:=base;#assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1)).ok;
 w:=actor_runtime_world(f[..],2);w.nav_revision=2;work:=actor_runtime_step(f[0].base.pool[..],w);#assert work.ok && work.invalidated==1;
}
#test "senses read the semantic snapshot and retain only bounded current entity observations" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<8 {f:=base;store:=actor_entity_store(f[0].base.pool[..]);other:=entities.entity_spawn(store);entities.entity_flush(store);i:=entities.entity_slot(f[0].base.handle);
 f[0].base.pool[0].actors[i].definition.parameters.period=1;
 targets:=[1]ActorTarget.[ActorTarget.{handle=other.handle,x=500,z=400}];w:=actor_runtime_world(f[..],1);w.targets=targets[..];
 if mode==1 {targets[0].eligible=false;}else if mode==2 {entities.entity_despawn(store,other.handle);}else if mode==3 {targets[0].handle=f[0].base.handle;}else if mode==4 {targets[0].x=2000;}else if mode==5 {targets[0].y=400;}else if mode==6 {w.queries.epoch=2;}else if mode==7 {w.focus_x=10000;}
 work:=actor_runtime_step(f[0].base.pool[..],w);#assert work.ok && work.scans==1 && work.rays==(ifx mode==0 || mode==6 then 1 else 0);
 a:=f[0].base.pool[0].actors[i];#assert a.perception.target==(ifx mode==0 then other.id.value else 0) && a.perception.tick==1 && work.refused==(ifx mode==6 then 1 else 0);
 }
}
#test "movement control and goals share one walker without reading a target's hidden current pose" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<5 {f:=base;i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.choice=ActorChoice.{status=ACTOR_OK,verb=ACTOR_GO,goal=mode};a.perception.tick=1;a.choice.work=ACTOR_KNOWN;
 a.definition.parameters.rules[0].goal=mode;a.definition.parameters.controller=1;
 a.perception.target=99;a.perception.generation=1;a.perception.memory.count=1;a.perception.memory.latest=1;a.perception.memory.items[0]=senses.Stimulus.{source=99,tick=0,at=spatial.world_point(5,0,6)};
 f[0].base.pool[0].actors[i]=a;w:=actor_runtime_world(f[..],1);work:[1]ActorWork;actor_runtime_choose(f[0].base.pool[..],i,w,work[..]);a=f[0].base.pool[0].actors[i];
 #assert a.goal_x==(ifx mode<2 then 600 else ifx mode==2 then 500 else ifx mode==3 then 300 else 400) && a.goal_z==(ifx mode<3 then 600 else ifx mode==3 then 200 else 400);
 }
 f:=base;i:=entities.entity_slot(f[0].base.handle);f[0].base.pool[0].actors[i].definition.parameters.controller=1;#assert actor_handoff(f[0].base.pool[..],f[0].base.handle,f[0].base.pool[0].actors[i].owner,1);
 #assert actor_control(f[0].base.pool[..],f[0].base.handle,f[0].base.pool[0].actors[i].owner,ActorControl.{z= -100,jump=true});
 work:=actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1));#assert work.ok; a:=f[0].base.pool[0].actors[i];#assert a.body.pos.z<4 && a.body.pos.y>0 && !a.input.jump;
}
