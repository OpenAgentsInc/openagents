// The steering service's window filled from a realm's colliders and terrain (aethyr/query.coax):
// for zones that hold their world as Colliders, the window's cells need no test of the zone's own.
// A cell is open when a body stands there: ground under it that holds it (query_stand from its
// feet, so a box low enough to step onto is a floor and a heightfield's land is the ground) and
// not too steep, and from a step's height up its body clear of every box, capsule and hull.
//   coax/bin/coax test aethyr/ai/steer-colliders.coax --library
#module "aethyr.ai.steer_colliders";
#authority;
#load "../query.coax";
#load "steer.coax";

NAV_COLLIDERS_IDS :: 8;   // colliders a cell's test lists at most: more is a crowd, so closed

// Whether a body of radius r may stand at (x, z), its feet near `feet`.
nav_stand_ok :: (c: Colliders, x: f32, z: f32, feet: f32, r: f32) -> bool #effects(all) {
  g := query_stand_checked(c, x, z, feet, r);
  if g.status != QueryStatus.ok || g.shape == QueryShape.none || g.steep { return false; }
  mid := g.y + f32(QUERY_STEP_UP) + r;
  ids: [NAV_COLLIDERS_IDS] QueryId;
  o := query_overlap_checked(c, world_point(x, mid, z), r, ids[..]);
  if o.status != QueryStatus.ok || o.count > NAV_COLLIDERS_IDS { return false; }
  for i: 0..<o.count {
    if ids[i].shape == QueryShape.box || ids[i].shape == QueryShape.capsule { return false; }
  }
  // a hull too high to step onto: its slice just above a step's height, and at the body's middle
  low := g.y + f32(QUERY_STEP_UP) + 0.05;
  k := query_hull(c.hulls, 0);
  while k.ok {
    if query_hull_gap(c.hulls, k, x, low, z).gap < r || query_hull_gap(c.hulls, k, x, mid, z).gap < r { return false; }
    k = query_hull(c.hulls, k.next);
  }
  return true;
}

// Fills a placed window: each cell open where the agent's body may stand.
nav_window_fill :: (w: [] NavWindow, c: Colliders, feet: f32, r: f32) #effects(all) {
  for i: 0..<nav_window_cells(w) {
    p := nav_window_spot(w, i);
    w[0].walk[i] = nav_stand_ok(c, p[0], p[1], feet, r);
  }
}

// ---- checks
// A wall at z 4.8 to 5.2 with a doorway from x 2.5 to 4.5, a 0.3 m step west of the door and a
// post (a capsule) east of it.
nav_tc_boxes :: () -> [18] f32 #effects(all) {
  return [18] f32.[-10, 0, 4.8, 2.5, 3, 5.2,   4.5, 0, 4.8, 10, 3, 5.2,   -4, 0, 1, -2, 0.3, 3];
}
NAV_TC_POST :: [7] f32.[6, 0, 2, 6, 2, 2, 0.4];

#test "the colliders' window: the wall and the post closed, the doorway and a low step open" {
  b := nav_tc_boxes(); post := NAV_TC_POST;
  c: Colliders; c.boxes = b[..]; c.capsules = post[..];
  #assert !nav_stand_ok(c, 0, 5, 0, 0.35) && !nav_stand_ok(c, 0, 4.6, 0, 0.35);
  #assert nav_stand_ok(c, 3.5, 5, 0, 0.35) && nav_stand_ok(c, 0, 0, 0, 0.35);
  #assert nav_stand_ok(c, -3, 2, 0, 0.35);              // up on the step
  #assert !nav_stand_ok(c, 6, 2, 0, 0.35) && !nav_stand_ok(c, 6.6, 2, 0, 0.35) && nav_stand_ok(c, 6.8, 2, 0, 0.35);
  // a hull rock (the checks' wedge, its top 0.25 m to 0.75 m high) closes the cells over it from its side
  wedge: [QUERY_HULL_HEAD + 6 * QUERY_HULL_FACE] f32; _ := query_test_wedge(wedge[..], 0, 0);
  rock: Colliders; rock.hulls = wedge[..];
  #assert !nav_stand_ok(rock, 1.2, 0, 0, 0.35) && !nav_stand_ok(rock, 0.9, 0, 0, 0.35);
  #assert nav_stand_ok(rock, 3, 0, 0, 0.35);
}

#test "a pursuer paths round the colliders' wall and through the doorway" #steps 4000000000 {
  b := nav_tc_boxes(); post := NAV_TC_POST;
  c: Colliders; c.boxes = b[..]; c.capsules = post[..];
  t := NavTune.{span = 12};
  w: [1] NavWindow; a: [1] NavAgent; a[0] = nav_agent(0, 0, 3);
  through: f32 = -100; at := -1;
  for k: 0..<64 * 6 {
    if nav_think(a[..], t, 0, 10, 0.015625) {
      nav_window_place(w[..], t, a[0]); nav_window_fill(w[..], c, 0, t.body); nav_plan(a[..], t, w[..]);
    }
    body := [3] f32.[0, 10, 0.35];
    s := nav_move(a[..], t, false, 0.015625, body[..], -1);
    x := s.x; z := s.z;
    if !nav_stand_ok(c, x, z, 0, t.body - 0.02) { x = a[0].x; z = a[0].z; }
    before := a[0].z;
    nav_moved(a[..], s, x, z);
    if before < 5 && a[0].z >= 5 { through = a[0].x; }
    if at < 0 && nav_len(a[0].x, a[0].z - 10) <= t.reach { at = k; }
  }
  #assert through > 2.5 && through < 4.5 && at > 0;
}
