#load "bundle-policy.coax";
#load "library.coax";
#load "bundle-checks.coax" #test;
#authority;
anim_bundle_part :: (b:[]u8,k:int)->[]u8 #effects(all) {at:=12+k*8;first:=cast(int)anim_word(b,at);n:=cast(int)anim_word(b,at+4);return b[first..<first+n];}
anim_bundle_load :: (b:[]u8,out:[]AnimLibrary)->int #effects(all) {
 if out.count<1 {return ANIM_CAPACITY;}if !anim_bundle_valid(b) {return ANIM_RANGE;}next:AnimLibrary;bytes:=anim_bundle_part(b,0);next.packs[0]=AnimPack.{id=asset_id(cast(string)bytes),bytes=bytes};
 // Reuse one bounded JSON arena across the rig and clips. Typed records own
 // names; immutable binary views refer to the retained source bundle.
 nodes:[ANIM_DOCUMENT_NODES]JvNode;d:[1]Jv;e:=anim_json(cast(string)anim_bundle_part(b,1),d[..],nodes[..]);if e!=0 {return e;}e=anim_rig_read(d[0],next.packs[..],next.rig[..]);if e!=0 {return e;}next.count=cast(int)anim_word(b,8);
 for k:0..<next.count {e=anim_json(cast(string)anim_bundle_part(b,k+2),d[..],nodes[..]);if e!=0 {return e;}e=anim_clip_read(d[0],next.packs[..],next.rig[..],next.clips[k..<k+1]);if e!=0 {return e;}for j:0..<k {if anim_equal(next.clips[j].name,next.clips[k].name) {return ANIM_NAME;}}}
 out[0]=next;return ANIM_OK;
}
