#load "rig-document.coax";
#load "clip-document-checks.coax";
#authority;
AnimEvent :: struct {at:f32;kind:int;joint:int;}
AnimClip :: struct {
 ready:bool;name:AnimName;rig:AnimName;frames:int;rate:f32;length:f32;looping:bool;
 joint_count:int;joints:[ANIM_JOINTS]int;body:AnimPart;root:AnimPart;
 curve_count:int;curves:[ANIM_SHAPES]int;face:AnimPart;face_joint_count:int;face_joints:[64]int;face_pose:AnimPart;
 event_count:int;events:[256]AnimEvent;source:AssetId;receipt:AssetId;role:AnimName;
}
anim_hash :: (d:Jv,node:int,out:[]AssetId)->bool #effects(all) {b:[64]u8;n:=jv_str(d,node,b[..]);return n==64 && asset_parse(cast(string)b[..],out);}
anim_clip_poses :: (part:AnimPart,packs:[]AnimPack,count:int)->int #effects(all) {
 if part.pack<0 || part.count!=count || part.width!=28 {return ANIM_RANGE;}b:=packs[part.pack].bytes;
 for k:0..<count {at:=part.offset+k*part.stride;if !anim_floats(b,at,7) || !anim_unit(anim_local(b,at).q) {return ANIM_NUMBER;}}return ANIM_OK;
}
anim_track_names :: (d:Jv,node:int,names:[]AnimName,out:[]int)->int #effects(all) {
 if jv_kind(d,node)!=JV_ARRAY || jv_len(d,node)>out.count {return -1;}count:=jv_len(d,node);
 for k:0..<count {id:=anim_find(names,anim_name(d,jv_at(d,node,k)));if id<0 {return -1;}for j:0..<k {if out[j]==id {return -1;}}out[k]=id;}return count;
}
anim_clip_read :: (d:Jv,packs:[]AnimPack,rigs:[]AnimRig,out:[]AnimClip)->int #effects(all) {
 if !anim_schema(d,"anim.clip.v1") || !anim_keys(d,0,"schema|name|rig|frames|rate|length|loop|joints|body|root|curves|face|face_bones|face_pose|events|source") {return ANIM_SCHEMA;}
 c:AnimClip;c.name=anim_name(d,jv_get(d,0,"name"));c.rig=anim_name(d,jv_get(d,0,"rig"));if c.name.n==0 || c.rig.n==0 {return ANIM_NAME;}
 ri:= -1;for r,k:rigs {if r.ready && anim_equal(r.name,c.rig) {ri=k;break;}}if ri<0 {return ANIM_REFERENCE;}r:=rigs[ri];
 c.frames=anim_integer(d,jv_get(d,0,"frames"),2,2000);rate:=anim_number(d,jv_get(d,0,"rate"),0.001,240);length:=anim_number(d,jv_get(d,0,"length"),0.001,600);
 if !rate.ok || !length.ok || !anim_clip_close(length.value-cast(f64)(c.frames-1)/rate.value) {return ANIM_NUMBER;}c.rate=cast(f32)rate.value;c.length=cast(f32)length.value;
 loop:=jv_kind(d,jv_get(d,0,"loop"));if loop!=JV_TRUE && loop!=JV_FALSE {return ANIM_SCHEMA;}c.looping=loop==JV_TRUE;
 c.joint_count=anim_track_names(d,jv_get(d,0,"joints"),r.names[0..<r.joints],c.joints[..]);c.curve_count=anim_track_names(d,jv_get(d,0,"curves"),r.shapes[0..<r.shape_count],c.curves[..]);c.face_joint_count=anim_track_names(d,jv_get(d,0,"face_bones"),r.names[0..<r.joints],c.face_joints[..]);
 if c.joint_count<0 || c.curve_count<0 || c.face_joint_count<0 {return ANIM_REFERENCE;}if c.joint_count+c.curve_count+c.face_joint_count==0 {return ANIM_LIMIT;}
 for k:0..<c.face_joint_count {found:=false;for j:0..<r.face_joint_count {if c.face_joints[k]==r.face_joints[j] {found=true;}}if !found {return ANIM_REFERENCE;}}
 body:=jv_get(d,0,"body");if c.joint_count>0 {c.body=anim_part(d,body,packs);e:=anim_clip_poses(c.body,packs,c.frames*c.joint_count);if e!=0 {return e;}}else if body!= -1 {return ANIM_RANGE;}
 face_pose:=jv_get(d,0,"face_pose");if c.face_joint_count>0 {c.face_pose=anim_part(d,face_pose,packs);e:=anim_clip_poses(c.face_pose,packs,c.frames*c.face_joint_count);if e!=0 {return e;}}else if face_pose!= -1 {return ANIM_RANGE;}
 face:=jv_get(d,0,"face");if c.curve_count>0 {c.face=anim_part(d,face,packs);p:=c.face;if p.pack<0 || p.count!=c.frames*c.curve_count || p.width!=4 {return ANIM_RANGE;}for k:0..<p.count {if !anim_floats(packs[p.pack].bytes,p.offset+k*p.stride,1) {return ANIM_NUMBER;}}}else if face!= -1 {return ANIM_RANGE;}
 root:=jv_get(d,0,"root");if root!= -1 {c.root=anim_part(d,root,packs);p:=c.root;if p.pack<0 || p.count!=c.frames || p.width!=12 {return ANIM_RANGE;}for k:0..<p.count {if !anim_floats(packs[p.pack].bytes,p.offset+k*p.stride,3) {return ANIM_NUMBER;}}}
 events:=jv_get(d,0,"events");c.event_count=jv_len(d,events);if jv_kind(d,events)!=JV_ARRAY || c.event_count>256 {return ANIM_LIMIT;}previous:f64=0;
 for k:0..<c.event_count {row:=jv_at(d,events,k);if !anim_keys(d,row,"at|kind|joint") {return ANIM_SCHEMA;}at:=anim_number(d,jv_get(d,row,"at"),previous,length.value);words:=[4]string.["foot-down","foot-up","contact","cast"];tag:=anim_choice(d,jv_get(d,row,"kind"),words[..]);if !at.ok || tag<0 {return ANIM_NUMBER;}
  joint:=anim_find(r.names[0..<r.joints],anim_name(d,jv_get(d,row,"joint")));if joint<0 {return ANIM_REFERENCE;}c.events[k]=AnimEvent.{at=cast(f32)at.value,kind=tag,joint=joint};previous=at.value;
 }
 source:=jv_get(d,0,"source");if !anim_keys(d,source,"pack|role|receipt") {return ANIM_SCHEMA;}ids:[2]AssetId;if !anim_hash(d,jv_get(d,source,"pack"),ids[..]) || !anim_hash(d,jv_get(d,source,"receipt"),ids[1..<2]) {return ANIM_REFERENCE;}c.source=ids[0];c.receipt=ids[1];c.role=anim_name(d,jv_get(d,source,"role"));if c.role.n==0 {return ANIM_NAME;}
 c.ready=true;out[0]=c;return ANIM_OK;
}
anim_clip_load :: (text:string,packs:[]AnimPack,rigs:[]AnimRig,out:[]AnimClip)->int #effects(all) {if out.count<1 {return ANIM_CAPACITY;}nodes:[ANIM_DOCUMENT_NODES]JvNode;d:[1]Jv;e:=anim_json(text,d[..],nodes[..]);if e!=0 {return e;}return anim_clip_read(d[0],packs,rigs,out);}

// Invalid frame counts are -1. With positive rate and length, their duration
// cannot match; no second sentinel check is needed.
anim_clip_close :: (delta:f64)->bool #effects(all) {return abs(delta)<=0.0001;}
