// Common, bounded animation JSON admission. Retained values own their names;
// JSON nodes and pack views are borrowed only for the synchronous call.
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/nostr/json.coax";
#load "../core/assets.coax";
#load "pose.coax";
#load "field-catalog.coax";
#load "document-checks.coax";
#authority;
#load "json.coax";
AnimPack :: struct {id:AssetId;bytes:[]u8;}
AnimPart :: struct {pack:int= -1;offset:int;count:int;stride:int;width:int;}
anim_window :: (total:int,offset:int,count:int,stride:int,width:int)->bool #effects(all) {return width>=1 && width<=total && offset>=0 && offset<=total-width && stride>=width && count>=1 && count-1<=(total-width-offset)/stride;}
anim_pack_size :: (bytes:int)->bool #effects(all) {return bytes>0 && bytes<=1073741824;}
anim_pack_valid :: (pack:AnimPack)->bool #effects(all) {return anim_pack_size(pack.bytes.count) && asset_same(asset_id(cast(string)pack.bytes),pack.id);}
anim_part :: (d:Jv,node:int,packs:[]AnimPack)->AnimPart #effects(all) {
 if !anim_keys(d,node,anim_field_keys("anim.buffer")) {return AnimPart.{};}
 text:[64]u8;id:[1]AssetId;n:=jv_str(d,jv_get(d,node,"pack"),text[..]);if n!=64 || !asset_parse(cast(string)text[..],id[..]) {return AnimPart.{};}
 p:=-1;for pack,k:packs {if asset_same(pack.id,id[0]) {p=k;break;}}if p<0 {return AnimPart.{};}
 offset:=jv_int(d,jv_get(d,node,"offset"),-1);count:=jv_int(d,jv_get(d,node,"count"),0);stride:=jv_int(d,jv_get(d,node,"stride"),0);width:=jv_int(d,jv_get(d,node,"width"),0);
 if !anim_window(packs[p].bytes.count,offset,count,stride,width) {return AnimPart.{};}return AnimPart.{pack=p,offset=offset,count=count,stride=stride,width=width};
}
anim_word :: (bytes:[]u8,at:int)->u32 #effects(all) {return cast(u32)bytes[at]|(cast(u32)bytes[at+1]<<8)|(cast(u32)bytes[at+2]<<16)|(cast(u32)bytes[at+3]<<24);}
anim_float :: (bytes:[]u8,at:int)->f32 #effects(all) {return f32_from_bits(anim_word(bytes,at));}
anim_floats :: (bytes:[]u8,at:int,count:int)->bool #effects(all) {for k:0..<count {if (anim_word(bytes,at+k*4)&0x7f800000)==0x7f800000 {return false;}}return true;}
