// EFC1: named sparse morphs and source-rate facial curves/local bone samples.
// Borrowed bytes remain owned by the caller after whole-package identity admission.
#authority;
FACE_PACK_CAP :: 41943040;
FacePack :: struct {targets:int;vertices:int;deltas:int;clips:int;bones:int;curves:int;joints:int;target_table:int;rig_names:int;bone_table:int;curve_table:int;clip_table:int;delta_table:int;data:int;}
face_word :: (b:[]u8,at:int)->u32 #effects(all) {return cast(u32)b[at] | (cast(u32)b[at+1]<<8) | (cast(u32)b[at+2]<<16) | (cast(u32)b[at+3]<<24);}
face_put :: (b:[]u8,at:int,value:u32) #effects(all) {for k:0..<4 {b[at+k]=cast,trunc(u8)(value>>(k*8));}}
face_float :: (b:[]u8,at:int)->f32 #effects(all) {return f32_from_bits(face_word(b,at));}
face_finite :: (b:[]u8,at:int)->bool #effects(all) {return (face_word(b,at)&0x7f800000)!=0x7f800000;}
face_name_ok :: (name:[]u8)->bool #effects(all) {
 if name.count!=64 || name[0]==0 {return false;}ended:=false;
 for c:name {if c==0 {ended=true;}else if ended || !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_' || c=='-' || c=='.') {return false;}}
 return ended;
}
face_name_equal :: (b:[]u8,a:int,c:int)->bool #effects(all) {for k:0..<64 {if b[a+k]!=b[c+k] {return false;}}return true;}
face_info :: (b:[]u8)->FacePack #effects(all) {return FacePack.{targets=cast(int)face_word(b,12),vertices=cast(int)face_word(b,16),deltas=cast(int)face_word(b,20),clips=cast(int)face_word(b,24),bones=cast(int)face_word(b,28),curves=cast(int)face_word(b,32),joints=cast(int)face_word(b,36),target_table=cast(int)face_word(b,40),rig_names=cast(int)face_word(b,44),bone_table=cast(int)face_word(b,48),curve_table=cast(int)face_word(b,52),clip_table=cast(int)face_word(b,56),delta_table=cast(int)face_word(b,60),data=cast(int)face_word(b,64)};}
face_size_ok :: (n:int)->bool #effects(all) {return n>=80 && n<=FACE_PACK_CAP;}
face_counts_ok :: (f:FacePack)->bool #effects(all) {return f.targets>=1 && f.targets<=256 && f.vertices>=1 && f.vertices<=1000000 && f.deltas>=1 && f.deltas<=2000000 && f.clips>=1 && f.clips<=64 && f.bones>=1 && f.bones<=64 && f.curves>=1 && f.curves<=256 && f.joints>=1 && f.joints<=512;}
face_frames_ok :: (n:int)->bool #effects(all) {return n>=2 && n<=2000;}
face_rate_ok :: (rate:f32)->bool #effects(all) {return rate>0 && rate<=240;}
face_rotation_ok :: (length:f32)->bool #effects(all) {return length>0.99 && length<1.01;}
face_span :: (total:int,first:int,count:int)->bool #effects(all) {return total>=0 && first>=0 && first<=total && count>=0 && count<=total-first;}
face_prefix_ok :: (total:int,end:int)->bool #effects(all) {return end<=total;}
face_floats_ok :: (b:[]u8)->bool #effects(all) {if b.count%4!=0 {return false;}for k:0..<b.count/4 {if !face_finite(b,k*4) {return false;}}return true;}
face_valid :: (b:[]u8)->bool #effects(all) {
 if !face_size_ok(b.count) {return false;}
 if face_word(b,0)!=0x31434645 || face_word(b,4)!=1 || cast(int)face_word(b,8)!=b.count {return false;}
 f:=face_info(b);
 if !face_counts_ok(f) {return false;}
 if f.target_table!=80 || f.rig_names!=80+f.targets*80 || f.bone_table!=f.rig_names+f.joints*64 || f.curve_table!=f.bone_table+f.bones*68 || f.clip_table!=f.curve_table+f.curves*68 || f.delta_table!=f.clip_table+f.clips*80 || f.data!=f.delta_table+f.deltas*32 || !face_prefix_ok(b.count,f.data) {return false;}
 for k:0..<f.joints {at:=f.rig_names+k*64;if !face_name_ok(b[at..<at+64]) {return false;}for j:0..<k {if face_name_equal(b,at,f.rig_names+j*64) {return false;}}}
 cursor:=0;
 for k:0..<f.targets {at:=f.target_table+k*80;first:=cast(int)face_word(b,at+64);count:=cast(int)face_word(b,at+68);
  if !face_name_ok(b[at..<at+64]) || first!=cursor || !face_span(f.deltas,cursor,count) {return false;}
  for j:0..<k {if face_name_equal(b,at,f.target_table+j*80) {return false;}}
  for j:first..<first+count {d:=f.delta_table+j*32;if cast(int)face_word(b,d)>=f.vertices || cast(int)face_word(b,d+4)!=k {return false;}for v:2..<8 {if !face_finite(b,d+v*4) {return false;}}}
  cursor+=count;
 }if cursor!=f.deltas {return false;}
 for k:0..<f.bones {at:=f.bone_table+k*68;id:=cast(int)face_word(b,at+64);if id>=f.joints || !face_name_equal(b,at,f.rig_names+id*64) {return false;}for j:0..<k {if face_word(b,f.bone_table+j*68+64)==cast(u32)id {return false;}}}
 for k:0..<f.curves {at:=f.curve_table+k*68;id:=cast(int)face_word(b,at+64);if id>=f.targets || !face_name_equal(b,at,f.target_table+id*80) {return false;}for j:0..<k {if face_word(b,f.curve_table+j*68+64)==cast(u32)id {return false;}}}
 cursor=f.data;
 for k:0..<f.clips {at:=f.clip_table+k*80;frames:=cast(int)face_word(b,at+64);if !face_finite(b,at+68) {return false;}rate:=face_float(b,at+68);
  if !face_name_ok(b[at..<at+64]) || !face_frames_ok(frames) || !face_rate_ok(rate) || cast(int)face_word(b,at+72)!=cursor || !face_span(b.count,cursor,frames*f.curves*4) {return false;}
  end:=cursor+frames*f.curves*4;if !face_floats_ok(b[cursor..<end]) {return false;}cursor=end;
  if cast(int)face_word(b,at+76)!=cursor || !face_span(b.count,cursor,frames*f.bones*28) {return false;}
  for j:0..<frames*f.bones {p:=cursor+j*28;for v:0..<7 {if !face_finite(b,p+v*4) {return false;}}length:f32=0;for v:3..<7 {q:=face_float(b,p+v*4);length+=q*q;}if !face_rotation_ok(length) {return false;}}
  cursor+=frames*f.bones*28;
 }return cursor==b.count;
}
#load "../tests/face-pack-checks.coax";
