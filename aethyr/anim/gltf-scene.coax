// glTF's character data becomes skin8 and sparse-morph records. Materials
// are retained as named slots for the neutral inspector; textures stay source-side.
#load "gltf-access.coax";
#load "source-names.coax";
#load "gltf-scene-checks.coax";
#authority;
AgScene :: struct {nodes:int;node_joint:[512]int;skin_count:int;skin_joint:[512]int;shape_first:[512]int;shape_count:[512]int;}
ag_name :: (g:[]AgFile,node:int,key:string,prefix:string,index:int)->AnimName #effects(all) {
 text:[1024]u8;field:=ag_get(g,node,key);n:int;if field== -1 {o:[1]PnOut;o[0].buf=text[..];pn_put(o[..],prefix);pn_putint(o[..],index);n=o[0].n;}else {n=jv_str(g[0].d,field,text[..]);if n== -1 {return AnimName.{};}}for k:0..<n {c:=text[k];if !((c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9') || c=='_' || c=='-' || c=='.') {text[k]='_';}}return anim_named(cast(string)text[0..<n]);
}
ag_shape :: (a:AgAccess,count:int,components:int)->bool #effects(all) {return a.ok && a.count==count && a.components==components;}
ag_vec :: (g:[]AgFile,node:int,key:string,count:int)->bool #effects(all) {v:=ag_get(g,node,key);return v== -1 || anim_vector(g[0].d,v,count,1000000);}
ag_skin_vertex :: (g:[]AgFile,sc:[]AgScene,joints:[]AgAccess,weights:[]AgAccess,vertex:int,b:[]u8,at:int)->bool #effects(all) {
 ids:[8]int;value:[8]f32;sum:f32=0;for set:0..<2 {if !joints[set].ok {continue;}for k:0..<4 {i:=set*4+k;ids[i]=cast(int)ag_value(g,joints[set],vertex,k);value[i]=ag_value(g,weights[set],vertex,k);if ids[i]<0 || ids[i]>=sc[0].skin_count || value[i]<0 || value[i]>1 {return false;}for prev:0..<i {if ids[prev]==ids[i] && value[prev]>0 && value[i]>0 {return false;}}sum+=value[i];}}
 if !(sum>0) || g[0].bad {return false;}total:=0;fraction:[8]f32;quantized:[8]int;for k:0..<8 {scaled:=value[k]*255/sum;quantized[k]=cast(int)floor(scaled);fraction[k]=scaled-cast(f32)quantized[k];total+=quantized[k];}
 for k:total..<255 {best:=0;for i:1..<8 {if fraction[i]>fraction[best] {best=i;}}quantized[best]+=1;fraction[best]= -1;}
 for k:0..<8 {id:=sc[0].skin_joint[ids[k]];b[at+36+k*2]=cast,trunc(u8)id;b[at+37+k*2]=cast(u8)(id>>8);b[at+52+k]=cast(u8)quantized[k];}return true;
}
ag_scene :: (g:[]AgFile,name:string,b:[]u8,w:[]AiBuild,sc:[]AgScene)->string #effects(all) {
 if !anim_name_ok(name) {return "rig-name";}asset:=ag_get(g,0,"asset");if !jv_raw_eq(jv_raw(g[0].d,ag_get(g,asset,"version")),"2.0") {return "gltf-version";}if jv_len(g[0].d,ag_get(g,0,"extensionsRequired"))>0 {return "gltf-required-extension";}
 count:=jv_len(g[0].d,ag_get(g,0,"nodes"));if count<1 || count>512 || jv_len(g[0].d,ag_get(g,0,"skins"))!=1 {return "gltf-skin-count";}sc[0]=AgScene.{};sc[0].nodes=count;parents:[512]int;for _,k:parents {parents[k]= -1;sc[0].node_joint[k]= -1;}
 for k:0..<count {node:=ag_top(g,"nodes",k);children:=ag_get(g,node,"children");if children!= -1 && jv_kind(g[0].d,children)!=JV_ARRAY {return "gltf-hierarchy";}for j:0..<jv_len(g[0].d,children) {child:=jv_int(g[0].d,jv_at(g[0].d,children,j),-1);if child<0 || child>=count || child==k || parents[child]>=0 {return "gltf-hierarchy";}parents[child]=k;}}
 r:=w[0].library[0].rig[..];r[0]=AnimRig.{};r[0].name=anim_named(name);
 for pass:0..<count {for k:0..<count {if sc[0].node_joint[k]>=0 || (parents[k]>=0 && sc[0].node_joint[parents[k]]<0) {continue;}node:=ag_top(g,"nodes",k);joint:=r[0].joints;label:=ag_name(g,node,"name","joint-",k);if label.n==0 || anim_find(r[0].names[0..<joint],label)>=0 {return "gltf-joint-name";}r[0].names[joint]=label;r[0].parents[joint]=ifx parents[k]<0 then -1 else sc[0].node_joint[parents[k]];r[0].mapped[joint]=ai_bvh_map(cast(string)label.bytes[0..<label.n]);
  if ag_get(g,node,"matrix")!= -1 || !ag_vec(g,node,"translation",3) || !ag_vec(g,node,"rotation",4) || !ag_vec(g,node,"scale",3) {return "gltf-node-transform";}v:=ag_get(g,node,"translation");r[0].rest[joint].t=v3(cast(f32)anim_number(g[0].d,jv_at(g[0].d,v,0),-1000000,1000000).value,cast(f32)anim_number(g[0].d,jv_at(g[0].d,v,1),-1000000,1000000).value,cast(f32)anim_number(g[0].d,jv_at(g[0].d,v,2),-1000000,1000000).value);v=ag_get(g,node,"rotation");if v!= -1 {r[0].rest[joint].q=anim_quat(g[0].d,v);if !anim_unit(r[0].rest[joint].q) {return "gltf-node-rotation";}}v=ag_get(g,node,"scale");if v!= -1 {for axis:0..<3 {n:=anim_number(g[0].d,jv_at(g[0].d,v,axis),1,1);if !n.ok {return "gltf-nonunit-scale";}}}sc[0].node_joint[k]=joint;r[0].joints+=1;
 }}if r[0].joints!=count {return "gltf-hierarchy";}ai_bind(r);skin:=ag_top(g,"skins",0);js:=ag_get(g,skin,"joints");sc[0].skin_count=jv_len(g[0].d,js);if sc[0].skin_count<1 || sc[0].skin_count>count {return "gltf-skin-joints";}seen:[512]bool;
 for k:0..<sc[0].skin_count {node:=anim_integer(g[0].d,jv_at(g[0].d,js,k),0,count-1);if node<0 || seen[node] {return "gltf-skin-joints";}seen[node]=true;sc[0].skin_joint[k]=sc[0].node_joint[node];}
 if ag_get(g,skin,"inverseBindMatrices")!= -1 {a:=ag_accessor(g,ag_required(g,skin,"inverseBindMatrices"));if !ag_shape(a,sc[0].skin_count,16) || a.component!=5126 {return "gltf-inverse-bind";}for j:0..<a.count {for k:0..<4 {if ag_value(g,a,j,k*4+3)!=(ifx k==3 then 1.0f32 else 0.0f32) {return "gltf-inverse-bind";}}for row:0..<3 {for col:0..<4 {r[0].bind[sc[0].skin_joint[j]*12+row*4+col]=ag_value(g,a,j,col*4+row);}}}}
 if !ai_rest(w,b) {return "output-capacity";}materials:=ag_get(g,0,"materials");material_count:=jv_len(g[0].d,materials);r[0].material_count=ifx material_count==0 then 1 else material_count;if r[0].material_count>64 {return "gltf-material-limit";}for k:0..<r[0].material_count {r[0].materials[k]=ag_name(g,jv_at(g[0].d,materials,k),"name","material-",k);if r[0].materials[k].n==0 || anim_find(r[0].materials[0..<k],r[0].materials[k])>=0 {return "gltf-material-name";}}
 for node_index:0..<count {node:=ag_top(g,"nodes",node_index);if ag_get(g,node,"mesh")== -1 {continue;}if ag_int(g,node,"skin",-1)!=0 {return "gltf-mesh-skin";}mesh:=ag_top(g,"meshes",ag_required(g,node,"mesh"));primitives:=ag_get(g,mesh,"primitives");np:=jv_len(g[0].d,primitives);if np<1 || np>64-r[0].sections {return "gltf-primitive-limit";}
  shapes:=jv_len(g[0].d,ag_get(g,jv_at(g[0].d,primitives,0),"targets"));sc[0].shape_first[node_index]=r[0].shape_count;sc[0].shape_count[node_index]=shapes;if shapes>256-r[0].shape_count {return "gltf-shape-limit";}names:=ag_get(g,ag_get(g,mesh,"extras"),"targetNames");if names!= -1 && jv_len(g[0].d,names)!=shapes {return "gltf-shape-names";}
  for k:0..<shapes {shape:=r[0].shape_count;label:AnimName;if names== -1 {label=ag_name(g,-1,"name","shape-",shape);}else {text:[64]u8;name_node:=jv_at(g[0].d,names,k);n:=jv_str(g[0].d,name_node,text[..]);if n== -1 {return "gltf-shape-name";}label=anim_named(cast(string)text[0..<n]);}if label.n==0 || anim_find(r[0].shapes[0..<shape],label)>=0 {return "gltf-shape-name";}r[0].shapes[shape]=label;input:=anim_arkit(label);if input>=0 {r[0].face_map[r[0].face_bindings]=AnimFaceBinding.{input=input,target=shape,weight=1};r[0].face_bindings+=1;}r[0].shape_count+=1;}
  for pi:0..<np {pr:=jv_at(g[0].d,primitives,pi);if ag_int(g,pr,"mode",4)!=4 || ag_get(g,pr,"extensions")!= -1 {return "gltf-primitive-mode";}attr:=ag_get(g,pr,"attributes");pa:=ag_accessor(g,ag_int(g,attr,"POSITION",-1));normal:=ag_accessor(g,ag_int(g,attr,"NORMAL",-1));uv:=ag_accessor(g,ag_int(g,attr,"TEXCOORD_0",-1));tangent:=ag_accessor(g,ag_int(g,attr,"TANGENT",-1));indices:=ag_accessor(g,ag_int(g,pr,"indices",-1));nv:=pa.count;
   if !pa.ok || pa.components!=3 || pa.component!=5126 || !indices.ok || indices.components!=1 || indices.count%3!=0 || (indices.component!=5121 && indices.component!=5123 && indices.component!=5125) || indices.normalized {return "gltf-geometry-accessor";}for a,k:[3]AgAccess.[normal,uv,tangent] {if ag_get(g,attr,[3]string.["NORMAL","TEXCOORD_0","TANGENT"][k])!= -1 && (!ag_shape(a,nv,[3]int.[3,2,4][k]) || a.component!=5126) {return "gltf-vertex-accessor";}}
   joint:[2]AgAccess;weight:[2]AgAccess;for set:0..<2 {joint[set]=ag_accessor(g,ag_int(g,attr,[2]string.["JOINTS_0","JOINTS_1"][set],-1));weight[set]=ag_accessor(g,ag_int(g,attr,[2]string.["WEIGHTS_0","WEIGHTS_1"][set],-1));if set==1 && ag_get(g,attr,"JOINTS_1")== -1 && ag_get(g,attr,"WEIGHTS_1")== -1 {continue;}if !ag_shape(joint[set],nv,4) || !ag_shape(weight[set],nv,4) || (joint[set].component!=5121 && joint[set].component!=5123) || joint[set].normalized || (weight[set].component!=5126 && !weight[set].normalized) {return "gltf-skin-accessor";}}
   if ag_get(g,attr,"JOINTS_2")!= -1 || ag_get(g,attr,"WEIGHTS_2")!= -1 {return "gltf-influence-limit";}material:=ag_int(g,pr,"material",0);if material<0 || material>=r[0].material_count {return "gltf-material-index";}start:=w[0].at;if nv*96+indices.count*4>b.count-start {return "output-capacity";}index_at:=start+nv*96;end:=index_at+indices.count*4;for k:start..<end {b[k]=0;}
   for v:0..<nv {at:=start+v*96;for k:0..<3 {aw_put(b,at+k*4,f32_bits(ag_value(g,pa,v,k)));aw_put(b,at+12+k*4,f32_bits(ifx normal.ok then ag_value(g,normal,v,k) else ifx k==1 then 1 else 0));}if uv.ok {for k:0..<2 {aw_put(b,at+24+k*4,f32_bits(ag_value(g,uv,v,k)));}}aw_put(b,at+32,cast(u32)material);for k:0..<4 {aw_put(b,at+60+k*4,f32_bits(ifx tangent.ok then ag_value(g,tangent,v,k) else ifx k==0 || k==3 then 1 else 0));}if !ag_skin_vertex(g,sc,joint[..],weight[..],v,b,at) {return "gltf-skin-weights";}}
   for k:0..<indices.count {id:=ag_value(g,indices,k,0);if id<0 || id>=cast(f32)nv || floor(id)!=id {return "gltf-index-range";}aw_put(b,index_at+k*4,cast(u32)id);}section:=r[0].sections;r[0].meshes[section]=AnimMesh.{vertices=AnimPart.{pack=0,offset=start,count=nv,stride=96,width=96},indices=AnimPart.{pack=0,offset=index_at,count=indices.count,stride=4,width=4},material=material};r[0].sections+=1;w[0].at=end;
   targets:=ag_get(g,pr,"targets");if jv_len(g[0].d,targets)!=shapes {return "gltf-morph-count";}for shape:0..<shapes {target:=jv_at(g[0].d,targets,shape);position:=ag_accessor(g,ag_int(g,target,"POSITION",-1));normal_delta:=ag_accessor(g,ag_int(g,target,"NORMAL",-1));for a,k:[2]AgAccess.[position,normal_delta] {if ag_get(g,target,[2]string.["POSITION","NORMAL"][k])!= -1 && (!ag_shape(a,nv,3) || a.component!=5126) {return "gltf-morph-accessor";}}if ag_get(g,target,"TANGENT")!= -1 {return "gltf-morph-tangent";}first:=w[0].at;global_shape:=sc[0].shape_first[node_index]+shape;
    for v:0..<nv {value:[6]f32;active:=false;for k:0..<3 {value[k]=ifx position.ok then ag_value(g,position,v,k) else 0;value[k+3]=ifx normal_delta.ok then ag_value(g,normal_delta,v,k) else 0;}for x:value {active=active || x!=0;}if !active {continue;}if w[0].at>b.count-32 {return "output-capacity";}aw_put(b,w[0].at,cast(u32)v);aw_put(b,w[0].at+4,cast(u32)global_shape);for x,k:value {aw_put(b,w[0].at+8+k*4,f32_bits(x));}w[0].at+=32;}
    if w[0].at>first {if r[0].morph_count==256 {return "gltf-morph-limit";}r[0].morphs[r[0].morph_count]=AnimRigMorph.{shape=global_shape,section=section,data=AnimPart.{pack=0,offset=first,count=(w[0].at-first)/32,stride=32,width=32}};r[0].morph_count+=1;}
   }
  }
 }if r[0].sections==0 || g[0].bad {return "gltf-geometry";}r[0].ready=true;w[0].layout.bytes=w[0].at;return "";
}
