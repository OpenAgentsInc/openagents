// Its checks, with the checks files it loads: coax/bin/coax test --library aethyr/anim/import-bvh.coax
// BVH's declared channel order is retained. v1 uses centimetres and Y-up;
// callers never infer units from a character's size.
#load "import-build.coax";
#load "source-names.coax";
#load "import-bvh-checks.coax" #test;
#authority;
AiTokens :: struct {text:string;at:int;bad:bool;}
ai_token :: (s:[]AiTokens)->string #effects(all) {t:=s[0].text;while s[0].at<t.count && t[s[0].at]<=32 {s[0].at+=1;}a:=s[0].at;if a==t.count {return "";}if t[a]=='{' || t[a]=='}' {s[0].at+=1;}else {while s[0].at<t.count && t[s[0].at]>32 && t[s[0].at]!='{' && t[s[0].at]!='}' {s[0].at+=1;}}return t[a..<s[0].at];}
ai_bvh_number :: (s:[]AiTokens)->f32 #effects(all) {v:=anim_decimal(ai_token(s));if !v.ok || abs(v.value)>1000000 {s[0].bad=true;return 0;}return cast(f32)v.value;}
ai_bvh :: (text:string,name:string,bytes:[]u8,w:[]AiBuild)->string #effects(all) {
 if !anim_name_ok(name) {return "rig-name";}s:=[1]AiTokens.[AiTokens.{text=text}];if ai_token(s[..])!="HIERARCHY" || ai_token(s[..])!="ROOT" {return "bvh-header";}r:=w[0].library[0].rig[..];r[0]=AnimRig.{};r[0].name=anim_named(name);
 stack:[512]int;depth:=0;channel_joint:[3072]int;channel_kind:[3072]int;channels:=0;offset_seen:[512]bool;channels_seen:[512]bool;word:="ROOT";
 while word!="MOTION" {
  if word=="ROOT" || word=="JOINT" {n:=anim_named(ai_token(s[..]));j:=r[0].joints;if n.n==0 || anim_find(r[0].names[0..<j],n)>=0 {return "bvh-joint-name";}if j==512 {return "bvh-joint-limit";}if (word=="ROOT" && j!=0) || (word=="JOINT" && depth==0) || ai_token(s[..])!="{" {return "bvh-hierarchy";}r[0].names[j]=n;r[0].parents[j]=ifx depth==0 then -1 else stack[depth-1];r[0].mapped[j]=ai_bvh_map(cast(string)n.bytes[0..<n.n]);stack[depth]=j;depth+=1;r[0].joints+=1;
  }else if word=="OFFSET" {if depth<1 || offset_seen[stack[depth-1]] {return "bvh-offset";}offset_seen[stack[depth-1]]=true;p:=v3(ai_bvh_number(s[..]),ai_bvh_number(s[..]),ai_bvh_number(s[..]));r[0].rest[stack[depth-1]].t=times(p,0.01);
  }else if word=="CHANNELS" {if depth<1 || channels_seen[stack[depth-1]] {return "bvh-channels";}channels_seen[stack[depth-1]]=true;count:=ai_bvh_number(s[..]);if count<1 || count>6 || floor(count)!=count {return "bvh-channels";}seen:[6]bool;rotated:=false;for k:0..<cast(int)count {value:=ai_token(s[..]);kind:= -1;for v,i:[6]string.["Xposition","Yposition","Zposition","Xrotation","Yrotation","Zrotation"] {if value==v {kind=i;}}if kind<0 || seen[kind] {return "bvh-channel-kind";}if kind<3 && rotated {return "bvh-position-order";}rotated=rotated || kind>=3;seen[kind]=true;channel_joint[channels]=stack[depth-1];channel_kind[channels]=kind;channels+=1;}
  }else if word=="End" {if depth<1 || ai_token(s[..])!="Site" || ai_token(s[..])!="{" || ai_token(s[..])!="OFFSET" {return "bvh-end-site";}for k:0..<3 {v:=ai_bvh_number(s[..]);}if ai_token(s[..])!="}" {return "bvh-end-site";}
  }else if word=="}" {if depth==0 {return "bvh-hierarchy";}depth-=1;}else {return "bvh-hierarchy";}
  if s[0].bad {return "bvh-number";}word=ai_token(s[..]);if word=="" {return "bvh-truncated";}
 }
 for j:0..<r[0].joints {if !offset_seen[j] || !channels_seen[j] {return "bvh-joint-fields";}}
 if depth!=0 || ai_token(s[..])!="Frames:" {return "bvh-motion";}frames:=ai_bvh_number(s[..]);if frames<2 || frames>2000 || floor(frames)!=frames || ai_token(s[..])!="Frame" || ai_token(s[..])!="Time:" {return "bvh-frame-count";}step:=ai_bvh_number(s[..]);if !(step>=1.0f32/240 && step<=1) {return "bvh-frame-time";}
 ai_bind(r);if !ai_rest(w,bytes) || !ai_boxes(w,bytes) {return "output-capacity";}c:AnimClip;c.ready=true;c.name=anim_named("motion");c.rig=r[0].name;c.frames=cast(int)frames;c.rate=1/step;c.length=cast(f32)(c.frames-1)/c.rate;c.joint_count=r[0].joints;if c.length>600 {return "bvh-duration";}for j:1..<c.joint_count {c.joints[j]=j;}c.body=AnimPart.{pack=0,offset=w[0].at,count=c.frames*c.joint_count,stride=28,width=28};if c.body.count>(bytes.count-w[0].at)/28 {return "output-capacity";}
 for frame:0..<c.frames {poses:=r[0].rest;for k:0..<channels {v:=ai_bvh_number(s[..]);j:=channel_joint[k];kind:=channel_kind[k];if kind==0 {poses[j].t.x+=v*0.01;}if kind==1 {poses[j].t.y+=v*0.01;}if kind==2 {poses[j].t.z+=v*0.01;}if kind>=3 {poses[j].q=quat_unit(quat_mul(poses[j].q,ai_axis(kind-3,v*0.01745329251994)));}}if s[0].bad {return "bvh-motion-number";}for j:0..<c.joint_count {ai_pose(bytes,w[0].at,poses[j]);w[0].at+=28;}}
 if ai_token(s[..])!="" {return "bvh-extra-motion";}r[0].ready=true;w[0].library[0].clips[0]=c;w[0].library[0].count=1;w[0].layout.bytes=w[0].at;return "";
}
