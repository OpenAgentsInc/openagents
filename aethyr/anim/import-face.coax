// Live Link Face's wide CSV. Timecode rate is explicit (CLI default 60);
// header names select curves, never their incidental column order.
#load "import-build.coax";
#load "import-face-checks.coax";
#authority;
AiCsv :: struct {text:string;at:int;bad:bool;}
AiFaceRows :: struct {count:int;time:[2000]f64;values:[110000]f32;}
ai_csv_row :: (s:[]AiCsv,fields:[]string)->int #effects(all) {
 if s[0].at==s[0].text.count {return 0;}t:=s[0].text;n:=0;
 while s[0].at<t.count {start:=s[0].at;while s[0].at<t.count && t[s[0].at]!=',' && t[s[0].at]!='\n' && t[s[0].at]!='\r' {s[0].at+=1;}end:=s[0].at;if n==fields.count {s[0].bad=true;return -1;}f:=t[start..<end];if f.count>=2 && f[0]=='"' && f[f.count-1]=='"' {f=f[1..<f.count-1];}for c:f {if c=='"' {s[0].bad=true;return -1;}}fields[n]=f;n+=1;if s[0].at==t.count {return n;}c:=t[s[0].at];s[0].at+=1;if c==',' {continue;}if c=='\r' && s[0].at<t.count && t[s[0].at]=='\n' {s[0].at+=1;}return n;
 }s[0].bad=true;return -1;
}
ai_csv_time :: (text:string,rate:f32)->f64 #effects(all) {
 first:=0;n:=0;value:[4]f64;
 if text.count==0 || text[text.count-1]==':' {return -1;}for c,k:text {if c==':' || k==text.count-1 {if n==4 {return -1;}end:=ifx c==':' then k else k+1;part:=text[first..<end];while part.count>1 && part[0]=='0' && part[1]!='.' {part=part[1..<part.count];}v:=anim_decimal(part);if !v.ok || v.value<0 {return -1;}value[n]=v.value;n+=1;first=k+1;}}
 if n!=4 || value[0]>=24 || value[1]>=60 || value[2]>=60 || value[3]>=cast(f64)rate {return -1;}for k:0..<3 {if floor(value[k])!=value[k] {return -1;}}return value[0]*3600+value[1]*60+value[2]+value[3]/cast(f64)rate;
}
ai_face_value :: (text:string,curve:bool)->AnimNumber #effects(all) {v:=anim_decimal(text);low:f64=ifx curve then 0 else -3.141592653589793;high:f64=ifx curve then 1 else 3.141592653589793;if !v.ok || v.value<low || v.value>high {return AnimNumber.{};}return v;}
ai_face_bracket :: (rows:[]AiFaceRows,t:f64,cursor:int)->int #effects(all) {at:=cursor;while at+1<rows[0].count-1 && rows[0].time[at+1]<=t {at+=1;}return at;}
ai_face_csv :: (text:string,name:string,rate:f32,bytes:[]u8,w:[]AiBuild)->string #effects(all) {
 if !anim_name_ok(name) {return "rig-name";}if rate!=30 && rate!=60 {return "csv-rate";}s:=[1]AiCsv.[AiCsv.{text=text}];header:[64]string;n:=ai_csv_row(s[..],header[..]);if n<57 || header[0]!="Timecode" || header[1]!="BlendShapeCount" {return "csv-header";}columns:[61]int;for k:0..<61 {columns[k]= -1;}
 for col:2..<n {index:=columns.count;for word,k:ARKIT_NAMES {if mq_same(word,header[col]) {index=k;}}for word,k:[3]string.["HeadYaw","HeadPitch","HeadRoll"] {if mq_same(word,header[col]) {index=52+k;}}for word,k:[6]string.["LeftEyeYaw","LeftEyePitch","LeftEyeRoll","RightEyeYaw","RightEyePitch","RightEyeRoll"] {if mq_same(word,header[col]) {index=55+k;}}if index==columns.count {return "csv-unknown-column";}if columns[index]!= -1 {return "csv-duplicate-column";}columns[index]=col;}
 for col:columns[0..<55] {if col== -1 {return "csv-missing-column";}}
 rows:[1]AiFaceRows;values:[64]string;
 while s[0].at<text.count {count:=ai_csv_row(s[..],values[..]);if count!=n {return "csv-row-width";}if rows[0].count==2000 {return "csv-frame-limit";}frame:=rows[0].count;t:=ai_csv_time(values[0],rate);if t<0 || (frame>0 && t<=rows[0].time[frame-1]) {return "csv-time-order";}rows[0].time[frame]=t;count_value:=anim_decimal(values[1]);if !count_value.ok || count_value.value!=cast(f64)(n-2) {return "csv-blend-count";}
  for k:0..<55 {v:=ai_face_value(values[columns[k]],k<52);if !v.ok {return "csv-value-range";}rows[0].values[frame*55+k]=cast(f32)v.value;}for k:55..<61 {if columns[k]!= -1 && !ai_face_value(values[columns[k]],false).ok {return "csv-value-range";}}rows[0].count+=1;
 }
 if rows[0].count<2 {return "csv-frame-count";}start:=rows[0].time[0];duration:=rows[0].time[rows[0].count-1]-start;frames:=cast(int)floor(duration*cast(f64)rate+0.5)+1;if frames<2 || frames>2000 {return "csv-duration";}
 r:=w[0].library[0].rig[..];r[0]=AnimRig.{};r[0].name=anim_named(name);r[0].joints=1;r[0].names[0]=anim_named("Head");r[0].parents[0]= -1;r[0].mapped[0]=6;r[0].rest[0].t=v3(0,1.6,0);ai_bind(r);if !ai_rest(w,bytes) || !ai_boxes(w,bytes) {return "output-capacity";}
 r[0].shape_count=52;r[0].face_bindings=52;r[0].face_joint_count=1;r[0].morph_count=52;
 // Original diagnostic face: every named curve moves its own corner sample.
 // Real characters supply their own shape/DNA map through the rig document.
 if w[0].at+52*32+frames*(52*4+28)>bytes.count {return "output-capacity";}
 for k:0..<52 {r[0].shapes[k]=anim_named(ARKIT_NAMES[k]);r[0].face_map[k]=AnimFaceBinding.{input=k,target=k,weight=1};r[0].morphs[k]=AnimRigMorph.{shape=k,data=AnimPart.{pack=0,offset=w[0].at,count=1,stride=32,width=32}};for j:12..<r[0].morphs[k].data.width {bytes[w[0].at+j]=0;}aw_put(bytes,w[0].at,cast(u32)(k%8));aw_put(bytes,w[0].at+4,cast(u32)k);aw_put(bytes,w[0].at+8,f32_bits(ifx k%2==0 then -0.015 else 0.015));w[0].at+=32;}
 c:AnimClip;c.ready=true;c.name=anim_named("face-take");c.rig=r[0].name;c.frames=frames;c.rate=rate;c.length=cast(f32)(frames-1)/rate;c.curve_count=52;for k:1..<c.curve_count {c.curves[k]=k;}c.face_joint_count=1;c.face=AnimPart.{pack=0,offset=w[0].at,count=frames*c.curve_count,stride=4,width=4};w[0].at+=frames*c.curve_count*4;c.face_pose=AnimPart.{pack=0,offset=w[0].at,count=frames,stride=28,width=28};w[0].at+=frames*28;cursor:=0;
 for frame:0..<frames {t:=start+cast(f64)frame/cast(f64)rate;cursor=ai_face_bracket(rows[..],t,cursor);share:=clamp01(cast(f32)((t-rows[0].time[cursor])/(rows[0].time[cursor+1]-rows[0].time[cursor])));v:[55]f32;for k:0..<55 {a:=rows[0].values[cursor*55+k];b:=rows[0].values[(cursor+1)*55+k];v[k]=a+(b-a)*share;}for k:0..<c.curve_count {aw_put(bytes,c.face.offset+(frame*c.curve_count+k)*4,f32_bits(v[k]));}p:=r[0].rest[0];p.q=quat_unit(quat_mul(quat_mul(ai_axis(1,v[52]),ai_axis(0,v[53])),ai_axis(2,v[54])));ai_pose(bytes,c.face_pose.offset+frame*28,p);}
 w[0].source_frames=rows[0].count;w[0].extra_curves=n-57;r[0].ready=true;w[0].library[0].clips[0]=c;w[0].library[0].count=1;w[0].layout.bytes=w[0].at;return "";
}
