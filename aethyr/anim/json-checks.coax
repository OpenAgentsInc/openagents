#test "asset-independent animation JSON retains strict numbers names keys and choices" {
 nodes:[64]JvNode;d:[1]Jv;#assert anim_json("{\"schema\":\"made\",\"n\":1.5,\"point\":[1,2,3],\"name\":\"Head\"}",d[..],nodes[..])==0;
 #assert anim_schema(d[0],"made") && anim_keys(d[0],0,"schema|n|point|name") && !anim_keys(d[0],0,"name");
 #assert anim_integer(d[0],jv_get(d[0],0,"n"),0,2)== -1 && anim_number(d[0],jv_get(d[0],0,"n"),0,2).value==1.5;
 #assert anim_vector(d[0],jv_get(d[0],0,"point"),3,3) && anim_point(d[0],jv_get(d[0],0,"point")).z==3;
 names:=[2]AnimName.[anim_named("root"),anim_name(d[0],jv_get(d[0],0,"name"))];#assert anim_text(names[..],1)=="Head" && anim_equal(names[1],anim_named("Head")) && anim_find(names[..],anim_named("Head"))==1 && anim_name_ok("jawOpen");
 words:=[2]string.["root","Head"];#assert anim_choice(d[0],jv_get(d[0],0,"name"),words[..])==1;
 #assert anim_decimal("-2e1").value== -20 && !anim_decimal("1e999").ok;
 for text:[4]string.["[]","{\"a\":1,\"a\":2}","{\"a\":\"\\u0000\"}","{\"a\":NaN}"] {#assert anim_json(text,d[..],nodes[..])!=0;}
}
#test "JSON helpers expose exact components failed decimals missing choices and integer bounds" {
 #assert anim_decimal("1E+2").value==100 && anim_decimal("-1E-2").value== -0.01 && anim_decimal("1E12").value==1000000000000;
 #assert !anim_decimal("false").ok && !anim_decimal("null").ok;
 nodes:[128]JvNode;d:[1]Jv;#assert jv_parse(d[..],"{\"bad\":1e999,\"zero\":0,\"one\":1,\"point\":[1,2,3],\"word\":\"root\",\"lost\":\"lost\"}",nodes[..]);
 #assert !anim_number(d[0],jv_get(d[0],0,"bad"),0,1).ok;
 for key:[2]string.["zero","one"] {v:=jv_get(d[0],0,key);#assert anim_number(d[0],v,0,1).ok && anim_integer(d[0],v,0,1)==(ifx key=="zero" then 0 else 1);#assert !anim_number(d[0],v,2,3).ok;}
 point:=anim_point(d[0],jv_get(d[0],0,"point"));#assert point.x==1 && point.y==2 && point.z==3;
 words:=[2]string.["root","Head"];#assert anim_choice(d[0],jv_get(d[0],0,"word"),words[..])==0 && anim_choice(d[0],jv_get(d[0],0,"lost"),words[..])== -1 && anim_choice(d[0],jv_get(d[0],0,"zero"),words[..])== -1;
 #assert !anim_schema(d[0],"missing") && !anim_vector(d[0],jv_get(d[0],0,"point"),2,3) && !anim_vector(d[0],jv_get(d[0],0,"point"),3,2);
 names:=[2]AnimName.[anim_named("root"),anim_named("Head")];#assert anim_find(names[..],anim_named("lost"))== -1 && anim_find(names[..],anim_named("root"))==0;
}
#test "JSON helper edge semantics include unequal lengths empty options first components and exact error codes" {
 #assert !anim_equal(anim_named("root"),anim_named("root0"));
 #assert anim_in("","") && anim_in("","|x") && anim_in("x","x|") && !anim_in("y","x|");
 nodes:[64]JvNode;d:[1]Jv;#assert anim_json("{\"schema\":\"one\",\"point\":[9,0,0]}",d[..],nodes[..])==0;
 #assert !anim_schema(d[0],"two") && !anim_vector(d[0],jv_get(d[0],0,"point"),3,3);
 #assert anim_json("{\"a\":0,\"a\":1}",d[..],nodes[..])==ANIM_JSON;
}

anim_test_replace :: (text:string,from:string,to:string,out:[]u8)->int {
 start:= -1;for k:0..<text.count-from.count+1 {if text[k..<k+from.count]==from {start=k;break;}}if start<0 {return -1;}n:=0;for c:text[0..<start] {out[n]=c;n+=1;}for c:to {out[n]=c;n+=1;}for c:text[start+from.count..<text.count] {out[n]=c;n+=1;}return n;
}
anim_test_set :: (text:string,key:string,value:string,out:[]u8)->int {
 nodes:[4096]JvNode;d:[1]Jv;#assert jv_parse(d[..],text,nodes[..]);o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);k:=d[0].nodes[0].first;found:=false;
 while k!=-1 {name:[64]u8;n:=jv_unescape(jv_key(d[0],k),name[..]);#assert n>0;word:=cast(string)name[0..<n];if word==key {found=true;if value.count>0 {jo_key(o[..],word);jo_raw(o[..],value);}}else {jo_key(o[..],word);jv_write(d[0],k,o[..]);}k=d[0].nodes[k].next;}
 if !found && value.count>0 {jo_key(o[..],key);jo_raw(o[..],value);}jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}

#test "asset-independent animation document names and exact object keys refuse malformed input" {
 n:[128]JvNode;d:[1]Jv;
 #assert anim_json("{\"name\":\"root\"}",d[..],n[..])==ANIM_OK;
 #assert anim_keys(d[0],0,"name") && !anim_keys(d[0],0,"schema");
 #assert anim_name(d[0],jv_get(d[0],0,"name")).n==4;
 for bad:[7]string.["{\"a\":1,\"\\u0061\":2}","{\"\":1}","{\"x\":NaN}","{\"x\":1e999}","{\"x\":\"\\u0000\"}","[]", "{}x"] {
  #assert anim_json(bad,d[..],n[..])!=ANIM_OK;
 }
 for word:[5]string.["", "has space", "../root", "x/y", "root\\n"] {#assert !anim_name_ok(word);}
 #assert anim_name_ok("groom.Head-01") && anim_name_ok("jawOpen");
 b:[65]u8;for k:0..<65 {b[k]='a';}#assert anim_name_ok(cast(string)b[0..<64]) && !anim_name_ok(cast(string)b[..]);
}
#test "asset-independent animation numbers have a finite explicit decimal profile" {
 for x:[6]string.["0","-0","1.5","-2e1","1E+2","1e-6"] {v:=anim_decimal(x);#assert v.ok;}
 #assert anim_decimal("-2e1").value== -20 && anim_decimal("1.25").value==1.25;
 for x:[8]string.["", "nan", "Infinity", "1e999", "1e-999", "12345678901234567890123456789012345678901", "true", "+1"] {#assert !anim_decimal(x).ok;}
 nodes:[16]JvNode;d:[1]Jv;#assert anim_json("{\"x\":1.5,\"a\":[1,2,3]}",d[..],nodes[..])==0;
 #assert anim_integer(d[0],jv_get(d[0],0,"x"),0,2)== -1 && anim_vector(d[0],jv_get(d[0],0,"a"),3,3);
 #assert !anim_vector(d[0],jv_get(d[0],0,"a"),4,3) && !anim_vector(d[0],jv_get(d[0],0,"a"),3,2);
}
#test "asset-independent animation lexical and numeric admission includes every boundary byte" {
 for c:0..<256 {b:=[1]u8.[cast(u8)c];expected:=(c>=97 && c<=122)||(c>=65 && c<=90)||(c>=48 && c<=57)||c==95||c==45;
  #assert anim_name_ok(cast(string)b[..])==expected;
 }
 #assert !anim_name_ok(".") && !anim_name_ok("..") && anim_name_ok("a.b");
 #assert !anim_equal(anim_named("root"),anim_named("boot"));
 for name:[3]string.["a","", "bad name"] {n:=[1]AnimName.[anim_named(name)];#assert n[0].n==(ifx name=="a" then 1 else 0);}
 #assert anim_decimal("1e2").value==100 && anim_decimal("1e12").value==1000000000000 && anim_decimal("1e-2").value==0.01 && anim_decimal("1e+2").value==100;
 #assert anim_decimal("1e38").ok && !anim_decimal("1e39").ok && anim_decimal("1e-38").ok && !anim_decimal("1e-39").ok;
 long:="1000000000000000000000000000000000000000";#assert long.count==40 && anim_decimal(long).ok;
 n:[64]JvNode;d:[1]Jv;
 #assert anim_json("{\"schema\":\"one\",\"x\":0,\"empty\":\"\"}",d[..],n[..])==0 && anim_integer(d[0],jv_get(d[0],0,"x"),0,1)==0;
 #assert !anim_keys(d[0],jv_get(d[0],0,"x"),"x") && !anim_in("x","y|z") && anim_in("x","x|z");
 #assert anim_name(d[0],jv_get(d[0],0,"empty")).n==0 && anim_name(d[0],jv_get(d[0],0,"x")).n==0;
 #assert !anim_number(d[0],jv_get(d[0],0,"empty"),0,1).ok && !anim_vector(d[0],0,0,1);
 #assert anim_json("{\"a\":1e999}",d[..],n[..])==ANIM_NUMBER;
 #assert anim_json("{\"\":0}",d[..],n[..])==ANIM_NAME && anim_json("[]",d[..],n[..])==ANIM_JSON;
 #assert anim_json("{\"x\":\" \"}",d[..],n[..])==0 && anim_json("{\"x\":\"\\u001f\"}",d[..],n[..])==ANIM_JSON;
 bad:=[9]u8.['{','"','x','"',':','"',255,'"','}'];#assert anim_json(cast(string)bad[..],d[..],n[..])==ANIM_JSON;
 key:[66]u8;o:[1]Jo;source:[512]u8;for k:0..<65 {key[k]='a';}
 for count:[2]int.[64,65] {jo_start(o[..],source[..]);jo_obj(o[..]);jo_key(o[..],cast(string)key[0..<count]);jo_int(o[..],1);jo_end(o[..]);#assert anim_json(jo_text(o[..]),d[..],n[..])==(ifx count==64 then 0 else ANIM_NAME);}
 payload:[4097]u8;for k:0..<payload.count {payload[k]='x';}large:[8192]u8;
 for count:[2]int.[4096,4097] {jo_start(o[..],large[..]);jo_obj(o[..]);jo_key(o[..],"x");jo_str(o[..],cast(string)payload[0..<count]);jo_end(o[..]);#assert anim_json(jo_text(o[..]),d[..],n[..])==(ifx count==4096 then 0 else ANIM_LIMIT);}
}
#test "asset-independent animation document size is an exact joint budget" {
 b:[ANIM_DOCUMENT_BYTES+1]u8;b[0]='{';b[1]='}';for k:2..<b.count {b[k]=' ';}n:[2]JvNode;d:[1]Jv;
 #assert anim_json(cast(string)b[0..<ANIM_DOCUMENT_BYTES],d[..],n[..])==ANIM_OK;
 #assert anim_json(cast(string)b[..],d[..],n[..])==ANIM_LIMIT;
}
