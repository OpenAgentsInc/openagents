#load "retarget.coax";
#load "write.coax";
#load "retarget-clip-checks.coax";
RtBake :: struct {clip:AnimClip;bytes:int= -1;dropped_curves:int;dropped_events:int;dropped_root:bool;}
rt_bake :: (source:AnimRig,target:AnimRig,input:AnimClip,packs:[]AnimPack,plan:RtPlan,out:[]u8,start:int,receipt:AssetId)->RtBake {
 result:RtBake;c:AnimClip;c.ready=true;c.name=input.name;c.rig=target.name;c.frames=input.frames;c.rate=input.rate;c.length=input.length;c.looping=input.looping;c.source=input.source;c.receipt=receipt;c.role=input.role;c.joint_count=target.joints;
 for j:0..<target.joints {c.joints[j]=j;}c.body=AnimPart.{pack=0,offset=start,count=c.frames*target.joints,stride=28,width=28};cursor:=start+c.frames*target.joints*28;
 if input.root.pack>=0 {if plan.source.joints[0]==0 && plan.target.joints[0]==0 {c.root=AnimPart.{pack=0,offset=start,count=c.frames,stride=target.joints*28,width=12};}else {result.dropped_root=true;}}
 target_names:=target.shapes;for k:0..<input.curve_count {id:=anim_find(target_names[0..<target.shape_count],source.shapes[input.curves[k]]);if id>=0 {c.curves[c.curve_count]=id;c.curve_count+=1;}else {result.dropped_curves+=1;}}
 if c.curve_count>0 {c.face=AnimPart.{pack=0,offset=cursor,count=c.frames*c.curve_count,stride=4,width=4};cursor+=c.frames*c.curve_count*4;}
 if start<0 || cursor>out.count {return result;}
 for k:0..<input.event_count {event:=input.events[k];slot:=rt_anchor_slot(plan.source,event.joint);if slot<0 || plan.target.joints[slot]<0 {result.dropped_events+=1;continue;}event.joint=plan.target.joints[slot];c.events[c.event_count]=event;c.event_count+=1;}
 a:[1]AnimSample;b:[1]AnimSample;sample_clip:=input;sample_clip.looping=false;
 for frame:0..<c.frames {anim_sample(source,sample_clip,packs,cast(f32)frame/c.rate,a[..]);rt_apply(source,target,plan,a[..],b[..]);for j:0..<target.joints {p:=b[0].local[j];at:=start+(frame*target.joints+j)*28;for value,k:[7]f32.[p.t.x,p.t.y,p.t.z,p.q.x,p.q.y,p.q.z,p.q.w] {aw_put(out,at+k*4,f32_bits(value));}}
  for k:0..<c.curve_count {aw_put(out,c.face.offset+(frame*c.curve_count+k)*4,f32_bits(b[0].weights[c.curves[k]]));}
 }
 result.clip=c;result.bytes=cursor;return result;
}
