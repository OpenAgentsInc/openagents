// A mannequin slot has one rotational anchor. Canonical names disambiguate
// folded helper aliases; ambiguous custom aliases require an explicit map.
#load "rig-document.coax";
#load "retarget-policy-checks.coax";
#authority;
RtAnchors :: struct {joints:[65]int;count:int;}
rt_joint_count :: (count:int)->bool #effects(all) {return count>=1 && count<=512;}
rt_parent :: (parent:int,joint:int)->bool #effects(all) {return parent>= -1 && parent<joint;}
rt_slot :: (slot:int)->bool #effects(all) {return slot>= -1 && slot<65;}
rt_exact :: (name:AnimName,slot:int)->bool #effects(all) {bytes:=name.bytes;return mq_same(cast(string)bytes[0..<name.n],MANNEQUIN_NAME[slot]);}
rt_anchors :: (r:AnimRig,out:[]RtAnchors)->int #effects(all) {
 if out.count<1 {return ANIM_CAPACITY;}if !r.ready || !rt_joint_count(r.joints) {return ANIM_LIMIT;}
 for j:0..<r.joints {if !rt_parent(r.parents[j],j) {return ANIM_SKELETON;}if !rt_slot(r.mapped[j]) {return ANIM_REFERENCE;}if !anim_unit(r.offsets[j]) {return ANIM_NUMBER;}}
 rig:=[1]AnimRig.[r];next:RtAnchors;
 for slot:0..<65 {selected:=rt_pick_anchor(rig[..],slot);if selected== -2 {return ANIM_REFERENCE;}next.joints[slot]=selected;if selected>=0 {next.count+=1;}}
 if next.count==0 {return ANIM_REFERENCE;}out[0]=next;return ANIM_OK;
}
rt_anchor_slot :: (map:RtAnchors,joint:int)->int #effects(all) {if joint<0 {return -1;}for slot:0..<65 {if map.joints[slot]==joint {return slot;}}return -1;}

rt_pick_anchor :: (r:[]AnimRig,slot:int)->int #effects(all) {
 aliases:=0;selected:= -1;canonical:= -1;
 for j:0..<r[0].joints {if r[0].mapped[j]!=slot {continue;}aliases+=1;selected=j;if rt_exact(r[0].names[j],slot) {if canonical>=0 {return -2;}canonical=j;}}
 if canonical>=0 {return canonical;}if aliases>1 {return -2;}return selected;
}
