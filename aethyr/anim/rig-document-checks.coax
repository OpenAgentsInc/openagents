#test "animation rig cannot read rest bind or index data from a different pack or stride" #steps 100000000 {
 original:[4096]u8;rb:[452]u8;n:=anim_test_rig(original[..],rb[..]);a:[8192]u8;b:[8192]u8;value:[512]u8;
 rest:[64]u8;bind:[104]u8;indices:[20]u8;for j:0..<2 {for k:0..<28 {rest[j*32+k]=rb[j*28+k];}anim_test_put(rest[..],j*32+28,0x7fc00000);for k:0..<48 {bind[j*52+k]=rb[56+j*48+k];}anim_test_put(bind[..],j*52+48,0x7fc00000);}
 anim_test_put(indices[..],0,9);for k:0..<3 {anim_test_put(indices[..],4+k*4,cast(u32)k);}
 p:=[4]AnimPack.[AnimPack.{id=asset_id(cast(string)rb[..]),bytes=rb[..]},AnimPack.{id=asset_id(cast(string)rest[..]),bytes=rest[..]},AnimPack.{id=asset_id(cast(string)bind[..]),bytes=bind[..]},AnimPack.{id=asset_id(cast(string)indices[..]),bytes=indices[..]}];
 vn:=anim_test_part_text(value[..],p[1],0,2,32,28);n=anim_test_set(cast(string)original[0..<n],"rest",cast(string)value[0..<vn],a[..]);vn=anim_test_part_text(value[..],p[2],0,2,52,48);n=anim_test_set(cast(string)a[0..<n],"bind",cast(string)value[0..<vn],b[..]);
 // Change a nested part while retaining the rest of the made section.
 nodes:[1024]JvNode;d:[1]Jv;#assert jv_parse(d[..],cast(string)b[0..<n],nodes[..]);old:=jv_raw(d[0],jv_get(d[0],jv_at(d[0],jv_get(d[0],0,"sections"),0),"indices"));vn=anim_test_part_text(value[..],p[3],4,3,4,4);n=anim_test_replace(cast(string)b[0..<n],old,cast(string)value[0..<vn],a[..]);source:=cast(string)a[0..<n];r:[1]AnimRig;
 #assert anim_rig_load(source,p[..],r[..])==ANIM_OK && r[0].bind[0]==1 && r[0].bind[12]==1;
 anim_test_put(indices[..],4,3);#assert anim_rig_load(source,p[..],r[..])==ANIM_RANGE;anim_test_put(indices[..],4,0);
 anim_test_put(rb[..],152,0x7fc00000);#assert anim_rig_load(source,p[..],r[..])==ANIM_NUMBER;anim_test_put(rb[..],152,0);
 anim_test_put(rest[..],24,0);#assert anim_rig_load(source,p[..],r[..])==ANIM_NUMBER;anim_test_put(rest[..],24,f32_bits(1.0f32));
 nn:=anim_test_set(source,"sections","{\"x\":0}",b[..]);#assert anim_rig_load(cast(string)b[0..<nn],p[..],r[..])==ANIM_LIMIT;
 outputs:="[{\"input\":\"eyeBlinkLeft\",\"outputs\":[{\"kind\":\"shape\",\"name\":\"blink\",\"weight\":1},{\"kind\":\"shape\",\"name\":\"blink\",\"weight\":0.5}]}]";nn=anim_test_set(source,"face_map",outputs,b[..]);#assert anim_rig_load(cast(string)b[0..<nn],p[..],r[..])==ANIM_REFERENCE;
 map:[4096]u8;o:[1]Jo;jo_start(o[..],map[..]);jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"input");jo_str(o[..],"eyeBlinkLeft");jo_key(o[..],"outputs");jo_arr(o[..]);for k:0..<9 {jo_raw(o[..],"{\"kind\":\"shape\",\"name\":\"blink\",\"weight\":1}");}jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);nn=anim_test_set(source,"face_map",jo_text(o[..]),b[..]);#assert anim_rig_load(cast(string)b[0..<nn],p[..],r[..])==ANIM_LIMIT;
}
#test "animation rig admits sparse named morph deltas and refuses invalid bindings" {
 text:[4096]u8;rb:[452]u8;n:=anim_test_rig(text[..],rb[..]);delta:[32]u8;anim_test_put(delta[..],8,f32_bits(0.25f32));anim_test_put(delta[..],24,f32_bits(-0.5f32));p:=[2]AnimPack.[AnimPack.{id=asset_id(cast(string)rb[..]),bytes=rb[..]},AnimPack.{id=asset_id(cast(string)delta[..]),bytes=delta[..]}];part:[512]u8;v:=anim_test_part_text(part[..],p[1],0,1,32,32);list:[1024]u8;o:[1]Jo;jo_start(o[..],list[..]);jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"shape");jo_str(o[..],"blink");jo_key(o[..],"section");jo_int(o[..],0);jo_key(o[..],"data");jo_raw(o[..],cast(string)part[0..<v]);jo_end(o[..]);jo_end(o[..]);changed:[8192]u8;n=anim_test_set(cast(string)text[0..<n],"morphs",jo_text(o[..]),changed[..]);source:=cast(string)changed[0..<n];r:[1]AnimRig;
 #assert anim_rig_load(source,p[..],r[..])==0 && r[0].morph_count==1 && r[0].morphs[0].shape==0 && r[0].morphs[0].section==0 && r[0].morphs[0].data.pack==1 && r[0].morphs[0].data.count==1 && r[0].morphs[0].data.width==32;
 reverse:=[2]AnimPack.[p[1],p[0]];#assert anim_rig_load(source,reverse[..],r[..])==0;
 for at:0..<8 {old:=anim_word(delta[..],at*4);anim_test_put(delta[..],at*4,ifx at==0 then 3 else ifx at==1 then 1 else 0x7fc00000);#assert anim_rig_load(source,p[..],r[..])==(ifx at<2 then ANIM_REFERENCE else ANIM_NUMBER);anim_test_put(delta[..],at*4,old);}
 anim_test_rig_error(source,"\"shape\":\"blink\"","\"shape\":\"missing\"",p[..],ANIM_REFERENCE);anim_test_rig_error(source,"\"section\":0","\"section\":1",p[..],ANIM_REFERENCE);
}
#test "animation rig morph capacities widths and duplicate bindings are explicit" #steps 200000000 {
 text:[4096]u8;rb:[452]u8;rn:=anim_test_rig(text[..],rb[..]);delta:[8192]u8;for k:0..<256 {anim_test_put(delta[..],k*32+4,cast(u32)k);}p:=[2]AnimPack.[AnimPack.{id=asset_id(cast(string)rb[..]),bytes=rb[..]},AnimPack.{id=asset_id(cast(string)delta[..]),bytes=delta[..]}];hash:[64]u8;#assert asset_hex(p[1].id,hash[..]);names:[8192]u8;list:[65536]u8;a:[131072]u8;b:[131072]u8;o:[1]Jo;r:[1]AnimRig;
 jo_start(o[..],names[..]);jo_arr(o[..]);for k:0..<256 {name:=[1]AnimName.[anim_test_label(k)];jo_str(o[..],anim_text(name[..],0));}jo_end(o[..]);n:=anim_test_set(cast(string)text[0..<rn],"shapes",jo_text(o[..]),a[..]);
 for count:[3]int.[0,256,257] {jo_start(o[..],list[..]);jo_arr(o[..]);for k:0..<count {name:=[1]AnimName.[anim_test_label(k%256)];jo_obj(o[..]);jo_key(o[..],"shape");jo_str(o[..],anim_text(name[..],0));jo_key(o[..],"section");jo_int(o[..],0);jo_key(o[..],"data");anim_test_part(o[..],cast(string)hash[..],(k%256)*32,1,32,32);jo_end(o[..]);}jo_end(o[..]);nn:=anim_test_set(cast(string)a[0..<n],"face_map","[]",b[..]);for k:0..<nn {a[k]=b[k];}n=nn;nn=anim_test_set(cast(string)a[0..<n],"morphs",jo_text(o[..]),b[..]);#assert anim_rig_load(cast(string)b[0..<nn],p[..],r[..])==(ifx count==257 then ANIM_LIMIT else ANIM_OK);if count==256 {#assert r[0].morph_count==256 && r[0].morphs[255].shape==255 && r[0].morphs[255].data.offset==8160;}}
 n=anim_test_set(cast(string)text[0..<rn],"morphs","{}",a[..]);#assert anim_rig_load(cast(string)a[0..<n],p[..],r[..])==ANIM_LIMIT;
 part:[512]u8;v:=anim_test_part_text(part[..],p[1],0,1,32,31);jo_start(o[..],list[..]);jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"shape");jo_str(o[..],"blink");jo_key(o[..],"section");jo_int(o[..],0);jo_key(o[..],"data");jo_raw(o[..],cast(string)part[0..<v]);jo_end(o[..]);jo_end(o[..]);n=anim_test_set(cast(string)text[0..<rn],"morphs",jo_text(o[..]),a[..]);#assert anim_rig_load(cast(string)a[0..<n],p[..],r[..])==ANIM_RANGE;
}
#test "animation rig morph records retain offsets strides and unique bindings" {
 text:[4096]u8;rb:[452]u8;rn:=anim_test_rig(text[..],rb[..]);delta:[80]u8;anim_test_put(delta[..],0,7);anim_test_put(delta[..],48,1);p:=[2]AnimPack.[AnimPack.{id=asset_id(cast(string)rb[..]),bytes=rb[..]},AnimPack.{id=asset_id(cast(string)delta[..]),bytes=delta[..]}];part:[512]u8;v:=anim_test_part_text(part[..],p[1],16,2,32,32);list:[2048]u8;changed:[8192]u8;o:[1]Jo;r:[1]AnimRig;
 for count:[2]int.[1,2] {jo_start(o[..],list[..]);jo_arr(o[..]);for k:0..<count {jo_obj(o[..]);jo_key(o[..],"shape");jo_str(o[..],"blink");jo_key(o[..],"section");jo_int(o[..],0);jo_key(o[..],"data");jo_raw(o[..],cast(string)part[0..<v]);jo_end(o[..]);}jo_end(o[..]);n:=anim_test_set(cast(string)text[0..<rn],"morphs",jo_text(o[..]),changed[..]);#assert anim_rig_load(cast(string)changed[0..<n],p[..],r[..])==(ifx count==1 then ANIM_OK else ANIM_REFERENCE);if count==1 {#assert r[0].morphs[0].data.offset==16 && r[0].morphs[0].data.stride==32 && r[0].morphs[0].data.count==2;anim_test_rig_error(cast(string)changed[0..<n],"\"shape\":\"blink\"","\"shape\":\"blink\",\"extra\":0",p[..],ANIM_SCHEMA);}}
 nodes:[32]JvNode;d:[1]Jv;#assert jv_parse(d[..],"{\"first\":0,\"last\":1,\"bad\":2}",nodes[..]);#assert anim_index(d[0],jv_get(d[0],0,"first"),2)==0 && anim_index(d[0],jv_get(d[0],0,"last"),2)==1 && anim_index(d[0],jv_get(d[0],0,"bad"),2)== -1 && anim_index(d[0],jv_get(d[0],0,"first"),0)== -1;
}
#test "animation rig every structural refusal reports its named domain" {
 text:[4096]u8;bytes:[452]u8;n:=anim_test_rig(text[..],bytes[..]);source:=cast(string)text[0..<n];p:=[1]AnimPack.[AnimPack.{id=asset_id(cast(string)bytes[..]),bytes=bytes[..]}];
 from:=[26]string.["\"name\":\"made-rig\"","\"joints\":[","\"parent\":-1","\"parent\":0","\"mannequin\":\"Head\"","\"offset\":[0,0,0,1]","\"count\":2","\"width\":28","\"width\":48","\"materials\":[\"plain\"]","\"shapes\":[\"blink\"]","\"controls\":[]","\"face_bones\":[\"Head\"]","\"face_bones\":[\"Head\"]","\"input\":\"eyeBlinkLeft\"","\"outputs\":[{","\"kind\":\"shape\"","\"name\":\"blink\"","\"weight\":1","\"format\":\"skin8.v1\"","\"material\":\"plain\"","\"width\":96","\"width\":4","\"stride\":4","\"sections\":[{","\"schema\":\"anim.rig.v1\""];
 to:=[26]string.["\"name\":\"\"","\"joints\":{","\"parent\":0","\"parent\":0.5","\"mannequin\":\"tail\"","\"offset\":[0,0,0,0]","\"count\":1","\"width\":27","\"width\":47","\"materials\":[]","\"shapes\":{}","\"controls\":{}","\"face_bones\":[\"tail\"]","\"face_bones\":[\"Head\",\"Head\"]","\"input\":\"unknown\"","\"outputs\":{","\"kind\":\"unknown\"","\"name\":\"unknown\"","\"weight\":1.1","\"format\":\"unknown\"","\"material\":\"missing\"","\"width\":95","\"width\":3","\"stride\":3","\"sections\":{","\"schema\":\"anim.rig.v1\",\"extra\":0"];
 errors:=[26]int.[4,1,7,7,4,5,6,6,6,4,4,4,8,8,4,1,4,8,8,10,8,6,6,6,1,2];
 for k:0..<26 {anim_test_rig_error(source,from[k],to[k],p[..],errors[k]);}
 for at:0..<14 {old:=anim_word(bytes[..],at*4);anim_test_put(bytes[..],at*4,0x7fc00000);r:[1]AnimRig;#assert anim_rig_load(source,p[..],r[..])==ANIM_NUMBER;anim_test_put(bytes[..],at*4,old);}
 for at:0..<24 {old:=anim_word(bytes[..],56+at*4);anim_test_put(bytes[..],56+at*4,0x7fc00000);r:[1]AnimRig;#assert anim_rig_load(source,p[..],r[..])==ANIM_NUMBER;anim_test_put(bytes[..],56+at*4,old);}
}
#test "animation rig mixed control maps and null retargets retain all output fields" {
 text:[4096]u8;bytes:[452]u8;n:=anim_test_rig(text[..],bytes[..]);p:=[1]AnimPack.[AnimPack.{id=asset_id(cast(string)bytes[..]),bytes=bytes[..]}];a:[16384]u8;b:[16384]u8;
 n=anim_test_replace(cast(string)text[0..<n],"\"controls\":[]","\"controls\":[\"c0\",\"c1\",\"c2\",\"c3\",\"c4\",\"c5\",\"c6\",\"c7\"]",a[..]);
 n=anim_test_replace(cast(string)a[0..<n],"\"shapes\":[\"blink\"]","\"shapes\":[\"blink\",\"frown\"]",b[..]);
 n=anim_test_replace(cast(string)b[0..<n],"\"mannequin\":\"Head\"","\"mannequin\":null",a[..]);
 old:="[{\"input\":\"eyeBlinkLeft\",\"outputs\":[{\"kind\":\"shape\",\"name\":\"blink\",\"weight\":1}]}]";
 map:[4096]u8;o:[1]Jo;jo_start(o[..],map[..]);jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"input");jo_str(o[..],"tongueOut");jo_key(o[..],"outputs");jo_arr(o[..]);
 for k:0..<8 {jo_obj(o[..]);jo_key(o[..],"kind");jo_str(o[..],"control");jo_key(o[..],"name");name:=[2]u8.['c',cast(u8)('0'+k)];jo_str(o[..],cast(string)name[..]);jo_key(o[..],"weight");jo_int(o[..],1);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);jo_obj(o[..]);jo_key(o[..],"input");jo_str(o[..],"eyeBlinkLeft");jo_key(o[..],"outputs");jo_raw(o[..],"[{\"kind\":\"shape\",\"name\":\"frown\",\"weight\":0.25},{\"kind\":\"shape\",\"name\":\"blink\",\"weight\":0.75}]");jo_end(o[..]);jo_end(o[..]);
 n=anim_test_replace(cast(string)a[0..<n],old,jo_text(o[..]),b[..]);r:[1]AnimRig;#assert anim_rig_load(cast(string)b[0..<n],p[..],r[..])==0 && r[0].mapped[0]==0 && r[0].mapped[1]== -1 && r[0].shape_count==2 && r[0].control_count==8 && r[0].face_bindings==10;
 for k:0..<8 {v:=r[0].face_map[k];#assert v.input==51 && v.control && v.target==k && v.weight==1;}#assert r[0].face_map[8].input==0 && !r[0].face_map[8].control && r[0].face_map[8].target==1 && r[0].face_map[8].weight==0.25 && r[0].face_map[9].target==0 && r[0].face_map[9].weight==0.75;
 anim_test_rig_error(cast(string)b[0..<n],"\"input\":\"eyeBlinkLeft\"","\"input\":\"tongueOut\"",p[..],ANIM_NAME);
 anim_test_rig_error(cast(string)b[0..<n],"\"name\":\"frown\",\"weight\":0.25","\"name\":\"blink\",\"weight\":0.25",p[..],ANIM_REFERENCE);
}
