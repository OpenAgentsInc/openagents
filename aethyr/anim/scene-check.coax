// Numerical diagnostics use the same sampled performances and cut clock as
// the realm. Original-source ranges are checked before display clamping.
#load "scene-sample.coax";
#load "cut-playback.coax";
#load "write.coax";
#test "scene capsule screening includes touching and separated upright actors" {
 #assert scene_capsule_overlap(v3(0,0,0),v3(0.59,0,0))>0;#assert scene_capsule_overlap(v3(0,0,0),v3(0.61,0,0))==0;#assert scene_capsule_overlap(v3(0,0,0),v3(0,2,0))==0;
}
scene_capsule_overlap :: (a:Point,b:Point)->f32 {dy:=hi(0,abs(a.y-b.y)-1.2);dx:=a.x-b.x;dz:=a.z-b.z;return hi(0,0.6-sqrt(dx*dx+dy*dy+dz*dz));}
scene_check :: (p:[]SceneProject,out:[]u8)->int {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.scene.check.v1");jo_key(o[..],"sample_hz");jo_int(o[..],120);jo_key(o[..],"foot_sliding");jo_arr(o[..]);max_slide:f32=0;contacts:=0;a:[1]AnimSample;b:[1]AnimSample;report:[1]FixupReport;
 for shot:0..<p[0].cut[0].shots {range:=p[0].cut[0].shot[shot];maximum:f32=0;paths:f32=0;marks:=0;
  for actor:0..<p[0].scene[0].cast_count {row:=p[0].scene[0].actors[actor];lib:=p[0].library[row.rig..<row.rig+1];perf:=p[0].performance[row.performance];base:=perf.layers[0];
   for k:0..<perf.count {l:=perf.layers[k];if l.kind!=4 || l.solver!=0 {continue;}first:=hi(range.from,l.start+l.blend_in);last:=lo(range.to,l.end-l.blend_out);if last<=first {continue;}previous:Point;start:Point;steps:=0;travel:f32=0;drift:f32=0;
    for tick:0..<cast(int)((last-first)*120)+1 {time:=first+cast(f32)tick/120;if time>=last || !fix_contact(lib[0].clips[base.clip],(time-base.start)*base.speed,l.joint) {continue;}scene_actor(p[0].scene[..],actor,lib,p[0].performance[0..<p[0].performances],time,a[..],report[..]);point:=a[0].position[l.joint];if steps==0 {start=point;}else {travel+=length(sub(point,previous))*100;}drift=hi(drift,length(sub(point,start))*100);previous=point;steps+=1;
    }if steps>1 {marks+=1;maximum=hi(maximum,drift);paths=hi(paths,travel);}
   }
  }max_slide=hi(max_slide,paths);contacts+=marks;jo_obj(o[..]);jo_key(o[..],"shot");aw_name(o[..],range.name);jo_key(o[..],"contacts");jo_int(o[..],marks);jo_key(o[..],"max_drift_cm");aw_number(o[..],maximum);jo_key(o[..],"max_travel_cm");aw_number(o[..],paths);jo_key(o[..],"pass");jo_bool(o[..],marks>0 && paths<1);jo_end(o[..]);
 }jo_end(o[..]);
 jo_key(o[..],"continuity");jo_arr(o[..]);pose_ok:=true;
 for k:1..<p[0].cut[0].shots {before:=p[0].cut[0].shot[k-1];after:=p[0].cut[0].shot[k];angle:f32=0;distance:f32=0;
  for actor:0..<p[0].scene[0].cast_count {rig:=p[0].scene[0].actors[actor].rig;lib:=p[0].library[rig..<rig+1];scene_actor(p[0].scene[..],actor,lib,p[0].performance[0..<p[0].performances],before.to,a[..],report[..]);scene_actor(p[0].scene[..],actor,lib,p[0].performance[0..<p[0].performances],after.from,b[..],report[..]);for j:0..<lib[0].rig[0].joints {angle=hi(angle,rt_rotation_error(a[0].rotation[j],b[0].rotation[j]));distance=hi(distance,length(sub(a[0].position[j],b[0].position[j]))*100);}}
  ca:=fl_flown(p[0].scene[0].camera[before.camera].flight,before.to);cb:=fl_flown(p[0].scene[0].camera[after.camera].flight,after.from);pass:=angle<0.25 && distance<0.25;pose_ok=pose_ok && pass;jo_obj(o[..]);jo_key(o[..],"incoming");aw_name(o[..],after.name);jo_key(o[..],"pose_degrees");aw_number(o[..],angle);jo_key(o[..],"pose_cm");aw_number(o[..],distance);jo_key(o[..],"camera_eye_jump_m");aw_number(o[..],length(sub(ca.eye,cb.eye)));jo_key(o[..],"camera_look_jump_m");aw_number(o[..],length(sub(ca.at,cb.at)));jo_key(o[..],"camera_change");jo_str(o[..],ifx before.camera==after.camera then "same-camera" else "authored-cut");jo_key(o[..],"pass");jo_bool(o[..],pass);jo_end(o[..]);
 }jo_end(o[..]);raw_bad:=0;curve_samples:=0;for k:0..<p[0].libraries {for c:0..<p[0].library[k].count {clip:=p[0].library[k].clips[c];part:=clip.face;if clip.curve_count>0 {for v:0..<part.count {value:=anim_float(p[0].library[k].packs[part.pack].bytes,part.offset+v*part.stride);if value<0 || value>1 {raw_bad+=1;}curve_samples+=1;}}}}
 repeatable:=true;face_bad:=0;hinge_bad:=0;capsule_hits:=0;worst_overlap:f32=0;roots:[16]Point;framed:[128]int;framing_total:[128]int;
 for tick:0..<cast(int)(p[0].scene[0].length*30)+1 {time:=cast(f32)tick/30;for actor:0..<p[0].scene[0].cast_count {rig:=p[0].scene[0].actors[actor].rig;lib:=p[0].library[rig..<rig+1];scene_actor(p[0].scene[..],actor,lib,p[0].performance[0..<p[0].performances],time,a[..],report[..]);scene_voice_face(p,actor,time,a[..]);scene_actor(p[0].scene[..],actor,lib,p[0].performance[0..<p[0].performances],time,b[..],report[..]);scene_voice_face(p,actor,time,b[..]);roots[actor]=a[0].position[0];if actor==0 {moment:=cut_play(p[0].cut[..],time);head:=0;for joint:0..<lib[0].rig[0].joints {if lib[0].rig[0].mapped[joint]==6 {head=joint;break;}}framing_total[moment.shot]+=1;if scene_camera_contains(p[0].scene[0].camera[moment.camera],moment.time,a[0].position[head],960.0f32/540) {framed[moment.shot]+=1;}}for v:0..<lib[0].rig[0].joints*12 {if f32_bits(a[0].palette[v])!=f32_bits(b[0].palette[v]) {repeatable=false;}}for shape:0..<lib[0].rig[0].shape_count {if a[0].weights[shape]<0 || a[0].weights[shape]>1 {face_bad+=1;}if f32_bits(a[0].weights[shape])!=f32_bits(b[0].weights[shape]) {repeatable=false;}}for j:0..<lib[0].rig[0].joints {slot:=lib[0].rig[0].mapped[j];if slot==MQ_LOWERARM_L || slot==MQ_LOWERARM_R || slot==MQ_CALF_L || slot==MQ_CALF_R {if rt_rotation_error(a[0].local[j].q,lib[0].rig[0].rest[j].q)>170 {hinge_bad+=1;}}}}
  for left:0..<p[0].scene[0].cast_count {for right:left+1..<p[0].scene[0].cast_count {overlap:=scene_capsule_overlap(roots[left],roots[right]);if overlap>0 {capsule_hits+=1;worst_overlap=hi(worst_overlap,overlap);}}}
 }
 jo_key(o[..],"hero_head_framing");jo_arr(o[..]);for shot:0..<p[0].cut[0].shots {jo_obj(o[..]);jo_key(o[..],"shot");aw_name(o[..],p[0].cut[0].shot[shot].name);jo_key(o[..],"visible_samples");jo_int(o[..],framed[shot]);jo_key(o[..],"total_samples");jo_int(o[..],framing_total[shot]);jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"face_ranges");jo_obj(o[..]);jo_key(o[..],"source_curve_samples");jo_int(o[..],curve_samples);jo_key(o[..],"source_violations");jo_int(o[..],raw_bad);jo_key(o[..],"composite_violations");jo_int(o[..],face_bad);jo_end(o[..]);jo_key(o[..],"joint_limits");jo_obj(o[..]);jo_key(o[..],"profile");jo_str(o[..],"canonical elbow and knee screening: 170 degrees from rest; other joints have no authored limits in rig.v1");jo_key(o[..],"violations");jo_int(o[..],hinge_bad);jo_end(o[..]);jo_key(o[..],"capsule_intersections");jo_obj(o[..]);jo_key(o[..],"profile");jo_str(o[..],"upright character root capsules: radius .3 m, height 1.8 m; no self or prop collision shapes authored");jo_key(o[..],"sample_hz");jo_int(o[..],30);jo_key(o[..],"pair_samples");jo_int(o[..],capsule_hits);jo_key(o[..],"max_penetration_m");aw_number(o[..],worst_overlap);jo_end(o[..]);jo_key(o[..],"determinism");jo_obj(o[..]);jo_key(o[..],"method");jo_str(o[..],"repeated same-time CPU palette and face bits; GPU hashes are in the play receipt");jo_key(o[..],"pass");jo_bool(o[..],repeatable);jo_end(o[..]);jo_key(o[..],"continuity_pass");jo_bool(o[..],pose_ok);jo_key(o[..],"foot_contacts");jo_int(o[..],contacts);jo_key(o[..],"max_contact_travel_cm");aw_number(o[..],max_slide);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
