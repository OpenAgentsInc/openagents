  for field:[3]string.["cast","voice","words"] {row:[512]u8;w:[1]Jo;jo_start(w[..],row[..]);jo_obj(w[..]);jo_key(w[..],"name");jo_str(w[..],"audio");jo_key(w[..],field);jo_str(w[..],"bad");jo_end(w[..]);nn:=anim_test_replace(source,"\"name\":\"audio\"",jo_text(w[..])[1..<w[0].n-1],changed[..]);#assert anim_scene_load(cast(string)changed[0..<nn],packs[..],r[..],p[..],s[..])==ANIM_SCHEMA;}
  nn:=anim_test_replace(source,"\"count\":1","\"count\":2",changed[..]);#assert anim_scene_load(cast(string)changed[0..<nn],packs[..],r[..],p[..],s[..])==ANIM_RANGE;nn=anim_test_replace(source,"\"offset\":0","\"offset\":8",changed[..]);#assert anim_scene_load(cast(string)changed[0..<nn],packs[..],r[..],p[..],s[..])==ANIM_RANGE;
 }
 n:=anim_test_replace(AS_TEST,"Leave. Now.","X",text[..]);#assert anim_scene_load(cast(string)text[0..<n],packs[..],r[..],p[..],s[..])==0 && s[0].sound[0].word_count==1;
 n=anim_test_replace(AS_TEST,"\"words\":\"Leave. Now.\"","\"source\":{},\"words\":\"Leave. Now.\"",text[..]);#assert anim_scene_load(cast(string)text[0..<n],packs[..],r[..],p[..],s[..])==ANIM_REFERENCE;
