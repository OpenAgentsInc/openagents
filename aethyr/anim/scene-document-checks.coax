AS_TEST :: "{\"schema\":\"anim.scene.v1\",\"name\":\"made-scene\",\"length\":5,\"style\":\"realistic\",\"stage\":{\"realm\":\"animation-lab\",\"place\":\"studio\",\"time\":0.8,\"weather\":\"clear\"},\"cast\":[{\"name\":\"actor\",\"rig\":\"made-rig\",\"look\":\"default\",\"performance\":\"made-performance\",\"path\":[{\"at\":0,\"position\":[0,0,0],\"yaw\":0},{\"at\":5,\"position\":[1,0,0],\"yaw\":1}]}],\"props\":[{\"name\":\"wand\",\"rig\":\"made-rig\",\"position\":[0,1,0],\"rotation\":[0,0,0,1],\"scale\":1}],\"effects\":[{\"name\":\"summon\",\"kind\":\"guardian\",\"start\":1,\"end\":4,\"position\":[0,0,2],\"size\":2,\"seed\":7}],\"lights\":[{\"name\":\"key\",\"keys\":[{\"at\":0,\"position\":[1,3,2],\"colour\":[1,0.8,0.7],\"intensity\":3}]}],\"cameras\":[{\"name\":\"wide\",\"fov\":0.8,\"focus\":3,\"keys\":[{\"at\":0,\"eye\":[0,2,4],\"look\":[0,1,0],\"cut\":true,\"ease\":0},{\"at\":5,\"eye\":[1,2,3],\"look\":[0,1,0],\"cut\":false,\"ease\":1}]}],\"sounds\":[{\"name\":\"line\",\"kind\":\"voice\",\"start\":1,\"end\":2,\"gain\":1,\"cast\":\"actor\",\"voice\":\"stock\",\"words\":\"Leave. Now.\"}]}";
#test "animation scene holds stage cast paths props events light keys cameras and speaking cues" {
 rigs:=[1]AnimRig.[AnimRig.{ready=true,name=anim_named("made-rig")}];perf:=[1]AnimPerformance.[AnimPerformance.{ready=true,name=anim_named("made-performance"),rig=anim_named("made-rig"),length=5}];packs:[1]AnimPack;s:[1]AnimScene;
 #assert anim_scene_load(AS_TEST,packs[0..<0],rigs[..],perf[..],s[..])==0 && s[0].ready && s[0].cast_count==1 && s[0].actors[0].path.count==2 && s[0].actors[0].path.point[1].x==1;
 #assert s[0].props==1 && s[0].effects==1 && s[0].effect[0].seed==7 && s[0].lights==1 && s[0].light[0].intensity[0]==3 && s[0].cameras==1 && s[0].camera[0].flight.count==2 && s[0].sounds==1 && s[0].sound[0].word_count==11;
 changed:[4096]u8;from:=[5]string.["\"fov\":0.8","\"realm\":\"animation-lab\"","\"kind\":\"guardian\"","\"performance\":\"made-performance\"","\"at\":5"];to:=[5]string.["\"fov\":0","\"realm\":\"unknown\"","\"kind\":\"unknown\"","\"performance\":\"unknown\"","\"at\":6"];
 for k:0..<5 {n:=anim_test_replace(AS_TEST,from[k],to[k],changed[..]);#assert n>0 && anim_scene_load(cast(string)changed[0..<n],packs[0..<0],rigs[..],perf[..],s[..])!=0 && s[0].cameras==1;}
}
anim_test_scene_context :: (rigs:[]AnimRig,performances:[]AnimPerformance) {
 rigs[0]=AnimRig.{ready=true,name=anim_named("made-rig"),joints=1};rigs[0].names[0]=anim_named("root");performances[0]=AnimPerformance.{ready=true,name=anim_named("made-performance"),rig=anim_named("made-rig"),length=5};
}
anim_test_scene_error :: (text:string,from:string,to:string,expected:int) {
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;changed:[8192]u8;n:=anim_test_replace(text,from,to,changed[..]);#assert n>0 && anim_scene_load(cast(string)changed[0..<n],packs[0..<0],r[..],p[..],s[..])==expected && !s[0].ready;
}
#test "animation scene retains every authored value independently" {
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;#assert anim_scene_load(AS_TEST,packs[0..<0],r[..],p[..],s[..])==0;
 v:=s[0];#assert anim_equal(v.name,anim_named("made-scene")) && v.length==5 && v.style==0 && v.realm==0 && v.place==0 && v.time==0.8 && v.weather==0;
 a:=v.actors[0];#assert anim_equal(a.name,anim_named("actor")) && a.rig==0 && a.look==0 && a.performance==0 && a.path.time[0]==0 && a.path.time[1]==5 && a.path.point[0].x==0 && a.path.point[1].x==1 && a.path.yaw[0]==0 && a.path.yaw[1]==1;
 prop:=v.prop[0];#assert anim_equal(prop.name,anim_named("wand")) && prop.rig==0 && prop.position.x==0 && prop.position.y==1 && prop.position.z==0 && prop.rotation.x==0 && prop.rotation.y==0 && prop.rotation.z==0 && prop.rotation.w==1 && prop.scale==1;
 fx:=v.effect[0];#assert anim_equal(fx.name,anim_named("summon")) && fx.kind==0 && fx.start==1 && fx.end==4 && fx.position.x==0 && fx.position.y==0 && fx.position.z==2 && fx.size==2 && fx.seed==7;
 light:=v.light[0];#assert anim_equal(light.name,anim_named("key")) && light.count==1 && light.time[0]==0 && light.position[0].x==1 && light.position[0].y==3 && light.position[0].z==2 && light.colour[0].x==1 && light.colour[0].y==0.8 && light.colour[0].z==0.7;
 camera:=v.camera[0];#assert anim_equal(camera.name,anim_named("wide")) && camera.fov==0.8 && camera.focus==3 && camera.flight.count==2 && camera.flight.keys[0].at==0 && camera.flight.keys[0].cut && camera.flight.keys[0].ease==0 && camera.flight.keys[1].at==5 && !camera.flight.keys[1].cut && camera.flight.keys[1].ease==1;
 #assert camera.flight.keys[0].shot.eye.y==2 && camera.flight.keys[0].shot.eye.z==4 && camera.flight.keys[0].shot.at.y==1 && camera.flight.keys[1].shot.eye.x==1 && camera.flight.keys[1].shot.eye.y==2 && camera.flight.keys[1].shot.eye.z==3;
 cue:=v.sound[0];#assert anim_equal(cue.name,anim_named("line")) && cue.kind==0 && cue.start==1 && cue.end==2 && cue.gain==1 && cue.who==0 && anim_equal(cue.voice,anim_named("stock")) && cast(string)cue.words[0..<cue.word_count]=="Leave. Now.";
 #assert anim_scene_load("{}",packs[0..<0],r[..],p[..],s[..])==ANIM_SCHEMA && anim_scene_load("[]",packs[0..<0],r[..],p[..],s[..])==ANIM_JSON && anim_scene_load(AS_TEST,packs[0..<0],r[..],p[..],s[0..<0])==ANIM_CAPACITY;
}
#test "animation scene refuses invalid domains without publishing partial state" #steps 100000000 {
 from:=[42]string.["\"schema\":\"anim.scene.v1\"","\"name\":\"made-scene\"","\"length\":5","\"style\":\"realistic\"","\"realm\":\"animation-lab\"","\"place\":\"studio\"","\"weather\":\"clear\"","\"time\":0.8","\"name\":\"actor\"","\"name\":\"actor\"","\"rig\":\"made-rig\"","\"look\":\"default\"","\"performance\":\"made-performance\"","\"yaw\":1","\"position\":[1,0,0]","\"at\":5","\"name\":\"wand\"","\"rotation\":[0,0,0,1]","\"rotation\":[0,0,0,1]","\"scale\":1","\"name\":\"summon\"","\"kind\":\"guardian\"","\"seed\":7","\"size\":2","\"end\":4","\"name\":\"key\"","\"colour\":[1,0.8,0.7]","\"colour\":[1,0.8,0.7]","\"intensity\":3","\"name\":\"wide\"","\"focus\":3","\"fov\":0.8","\"cut\":false","\"ease\":1","\"look\":[0,1,0]","\"name\":\"line\"","\"gain\":1","\"cast\":\"actor\"","\"voice\":\"stock\"","\"words\":\"Leave. Now.\"","\"kind\":\"voice\"","\"end\":2"];
 to:=[42]string.["\"schema\":\"anim.scene.v1\",\"extra\":0","\"name\":\"\"","\"length\":0","\"style\":\"unknown\"","\"realm\":\"unknown\"","\"place\":\"unknown\"","\"weather\":\"unknown\"","\"time\":2","\"name\":\"\"","\"name\":\"actor\",\"extra\":0","\"rig\":\"missing\"","\"look\":\"unknown\"","\"performance\":\"missing\"","\"yaw\":1001","\"position\":[1000001,0,0]","\"at\":0","\"name\":\"\"","\"rotation\":[0,0,0,0]","\"rotation\":[0,0,1]","\"scale\":0","\"name\":\"\"","\"kind\":\"unknown\"","\"seed\":-1","\"size\":0","\"end\":1","\"name\":\"\"","\"colour\":[-1,0.8,0.7]","\"colour\":[65,0.8,0.7]","\"intensity\":10001","\"name\":\"\"","\"focus\":0","\"fov\":0","\"cut\":0","\"ease\":4","\"look\":[0,2,4]","\"name\":\"\"","\"gain\":5","\"cast\":\"missing\"","\"voice\":\"\"","\"words\":\"\"","\"kind\":\"unknown\"","\"end\":1"];
 errors:=[42]int.[2,4,5,2,5,5,5,5,4,2,8,8,8,5,5,5,4,5,5,5,4,5,5,5,5,4,5,5,5,4,5,5,5,5,5,4,5,8,8,8,5,5];for k:0..<42 {anim_test_scene_error(AS_TEST,from[k],to[k],errors[k]);}
 for field:[6]string.["cast","props","effects","lights","cameras","sounds"] {r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;changed:[8192]u8;n:=anim_test_set(AS_TEST,field,"{}",changed[..]);#assert anim_scene_load(cast(string)changed[0..<n],packs[0..<0],r[..],p[..],s[..])==ANIM_LIMIT;}
}
#test "animation scene each collection admits its capacity and refuses the next element" #steps 500000000 {
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;nodes:[2048]JvNode;d:[1]Jv;#assert jv_parse(d[..],AS_TEST,nodes[..]);list:[65536]u8;row:[4096]u8;text:[131072]u8;changed:[131072]u8;o:[1]Jo;
 fields:=[6]string.["cast","props","effects","lights","cameras","sounds"];limits:=[6]int.[16,64,64,16,16,32];
 for field,category:fields {original:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,field),0));for extra:0..<2 {count:=limits[category]+extra;jo_start(o[..],list[..]);jo_arr(o[..]);for k:0..<count {name:=[1]AnimName.[anim_test_label(k)];value:[128]u8;v:[1]Jo;jo_start(v[..],value[..]);jo_str(v[..],anim_text(name[..],0));n:=anim_test_set(original,"name",jo_text(v[..]),row[..]);jo_raw(o[..],cast(string)row[0..<n]);}jo_end(o[..]);n:=anim_test_set(AS_TEST,field,jo_text(o[..]),text[..]);
   if category==0 {n=anim_test_set(cast(string)text[0..<n],"sounds","[]",changed[..]);for k:0..<n {text[k]=changed[k];}}
   #assert anim_scene_load(cast(string)text[0..<n],packs[0..<0],r[..],p[..],s[..])==(ifx extra==0 then ANIM_OK else ANIM_LIMIT);
  }}
}
#test "animation scene empty and duplicate collections have explicit admission rules" #steps 100000000 {
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;nodes:[2048]JvNode;d:[1]Jv;#assert jv_parse(d[..],AS_TEST,nodes[..]);a:[8192]u8;b:[8192]u8;list:[8192]u8;o:[1]Jo;
 for field:[6]string.["cast","props","effects","lights","cameras","sounds"] {n:=anim_test_set(AS_TEST,field,"[]",a[..]);if field=="cast" {n=anim_test_set(cast(string)a[0..<n],"sounds","[]",b[..]);for k:0..<n {a[k]=b[k];}}#assert anim_scene_load(cast(string)a[0..<n],packs[0..<0],r[..],p[..],s[..])==(ifx field=="cameras" then ANIM_LIMIT else ANIM_OK);
  jo_start(o[..],list[..]);jo_arr(o[..]);row:=jv_at(d[0],jv_get(d[0],0,field),0);jv_write(d[0],row,o[..]);jv_write(d[0],row,o[..]);jo_end(o[..]);n=anim_test_set(AS_TEST,field,jo_text(o[..]),a[..]);#assert anim_scene_load(cast(string)a[0..<n],packs[0..<0],r[..],p[..],s[..])==ANIM_NAME;
 }
 for name:[5]string.["wand","summon","key","wide","line"] {from:[128]u8;to:[128]u8;w:[1]Jo;jo_start(w[..],from[..]);jo_key(w[..],"name");jo_str(w[..],name);jo_start(w[..],to[..]);jo_key(w[..],"name");jo_str(w[..],name);jo_put(w[..],",\"extra\":0");anim_test_scene_error(AS_TEST,cast(string)from[0..<name.count+9],cast(string)to[0..<name.count+19],ANIM_SCHEMA);}
 anim_test_scene_error(AS_TEST,"\"name\":\"wand\",\"rig\":\"made-rig\"","\"name\":\"wand\",\"rig\":\"missing\"",ANIM_REFERENCE);
 p[0].rig=anim_named("other");#assert anim_scene_load(AS_TEST,packs[0..<0],r[..],p[..],s[..])==ANIM_REFERENCE;p[0].rig=r[0].name;p[0].length=4;#assert anim_scene_load(AS_TEST,packs[0..<0],r[..],p[..],s[..])==ANIM_REFERENCE;p[0].length=5;p[0].ready=false;#assert anim_scene_load(AS_TEST,packs[0..<0],r[..],p[..],s[..])==ANIM_REFERENCE;
}
#test "animation camera and path readers cover exact key capacities" #steps 100000000 {
 nodes:[4096]JvNode;d:[1]Jv;o:[1]Jo;list:[16384]u8;text:[32768]u8;path:[1]AnimPath;camera:[1]AnimSceneCamera;
 for count:[4]int.[0,1,32,33] {jo_start(o[..],list[..]);jo_arr(o[..]);for k:0..<count {jo_obj(o[..]);jo_key(o[..],"at");jo_int(o[..],k);jo_key(o[..],"position");jo_raw(o[..],"[-1.1,2.2,-3.3]");jo_key(o[..],"yaw");jo_int(o[..],k);jo_end(o[..]);}jo_end(o[..]);#assert jv_parse(d[..],jo_text(o[..]),nodes[..]);#assert anim_path_read(d[0],0,600,path[..])==(ifx count==1 || count==32 then ANIM_OK else ANIM_LIMIT);if count==32 {#assert path[0].count==32 && path[0].time[31]==31 && path[0].yaw[31]==31 && path[0].point[31].x== -1.1 && path[0].point[31].y==2.2 && path[0].point[31].z== -3.3;}}
 for count:[4]int.[1,2,16,17] {jo_start(o[..],list[..]);jo_arr(o[..]);for k:0..<count {jo_obj(o[..]);jo_key(o[..],"at");jo_int(o[..],k);jo_key(o[..],"eye");jo_raw(o[..],"[1,2,3]");jo_key(o[..],"look");jo_raw(o[..],"[0,0,0]");jo_key(o[..],"cut");jo_bool(o[..],k%2==0);jo_key(o[..],"ease");jo_int(o[..],k%4);jo_end(o[..]);}jo_end(o[..]);n:=anim_test_set("{\"name\":\"w\",\"fov\":0.8,\"focus\":3}","keys",jo_text(o[..]),text[..]);#assert jv_parse(d[..],cast(string)text[0..<n],nodes[..]);#assert anim_camera_read(d[0],0,600,camera[..])==(ifx count==2 || count==16 then ANIM_OK else ANIM_LIMIT);if count==16 {#assert camera[0].flight.count==16 && camera[0].flight.keys[15].at==15 && camera[0].flight.keys[15].ease==3 && !camera[0].flight.keys[15].cut;}}
}
ASC_CAMERA :: "{\"name\":\"w\",\"fov\":0.8,\"focus\":3,\"keys\":[{\"at\":0,\"eye\":[1,2,3],\"look\":[0,0,0],\"cut\":true,\"ease\":0},{\"at\":1,\"eye\":[2,3,4],\"look\":[0,0,0],\"cut\":false,\"ease\":1}]}";
#test "animation camera and path refusals report exact domains" {
 #assert anim_camera_distance(0.0001) && !anim_camera_distance(0.00009999);
 nodes:[1024]JvNode;d:[1]Jv;changed:[4096]u8;camera:[1]AnimSceneCamera;path:[1]AnimPath;
 from:=[10]string.["\"name\":\"w\"","\"at\":0","\"eye\":[1,2,3]","\"look\":[0,0,0]","\"cut\":true","\"at\":1","\"at\":1","\"at\":0","\"eye\":[1,2,3]","\"name\":\"w\""];
 to:=[10]string.["\"name\":\"w\",\"extra\":0","\"at\":0,\"extra\":0","\"eye\":[1,2]","\"look\":[0,0]","\"cut\":1","\"at\":0","\"at\":7","\"at\":-1","\"eye\":[1,2,1000001]","\"name\":\"\""];
 expected:=[10]int.[2,2,5,5,5,5,5,5,5,4];for k:0..<10 {n:=anim_test_replace(ASC_CAMERA,from[k],to[k],changed[..]);#assert n>0 && jv_parse(d[..],cast(string)changed[0..<n],nodes[..]) && anim_camera_read(d[0],0,5,camera[..])==expected[k];}
 #assert jv_parse(d[..],"[{\"at\":0,\"position\":[0,0,0],\"yaw\":0,\"extra\":0}]",nodes[..]) && anim_path_read(d[0],0,5,path[..])==ANIM_SCHEMA;
 #assert jv_parse(d[..],"[{\"at\":1,\"position\":[0,0,0],\"yaw\":0},{\"at\":0,\"position\":[0,0,0],\"yaw\":0}]",nodes[..]) && anim_path_read(d[0],0,5,path[..])==ANIM_NUMBER;
 #assert jv_parse(d[..],"{}",nodes[..]) && anim_path_read(d[0],0,5,path[..])==ANIM_LIMIT;
}
