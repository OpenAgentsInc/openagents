#test "animation scene stored clocks remain ordered after float32 conversion" {
 nodes:[1024]JvNode;d:[1]Jv;path:[1]AnimPath;
 #assert jv_parse(d[..],"[{\"at\":1,\"position\":[0,0,0],\"yaw\":0},{\"at\":1.0000000001,\"position\":[1,0,0],\"yaw\":0}]",nodes[..]) && anim_path_read(d[0],0,5,path[..])==ANIM_NUMBER;
 anim_test_scene_error(AS_TEST,"\"end\":4","\"end\":1.0000000001",ANIM_NUMBER);anim_test_scene_error(AS_TEST,"\"end\":2","\"end\":1.0000000001",ANIM_NUMBER);
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;text:[8192]u8;
 n:=anim_test_set(AS_TEST,"lights","[{\"name\":\"key\",\"keys\":[{\"at\":1,\"position\":[1,2,3],\"colour\":[1,1,1],\"intensity\":1},{\"at\":1.0000000001,\"position\":[2,2,3],\"colour\":[1,1,1],\"intensity\":1}]}]",text[..]);#assert anim_scene_load(cast(string)text[0..<n],packs[0..<0],r[..],p[..],s[..])==ANIM_NUMBER;
}
#test "animation scene seeds include zero and refuse the first integer above their limit" {
 anim_test_scene_error(AS_TEST,"\"seed\":7","\"seed\":2147483648",ANIM_NUMBER);r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;text:[8192]u8;n:=anim_test_replace(AS_TEST,"\"seed\":7","\"seed\":0",text[..]);#assert anim_scene_load(cast(string)text[0..<n],packs[0..<0],r[..],p[..],s[..])==0 && s[0].effect[0].seed==0;
}
#test "animation scenes admit black lights and retain cuts after the first camera key" {
 r:[1]AnimRig;p:[1]AnimPerformance;anim_test_scene_context(r[..],p[..]);packs:[1]AnimPack;s:[1]AnimScene;text:[8192]u8;n:=anim_test_replace(AS_TEST,"[1,0.8,0.7]","[0,0,0]",text[..]);#assert anim_scene_load(cast(string)text[0..<n],packs[0..<0],r[..],p[..],s[..])==0 && s[0].light[0].colour[0].x==0 && s[0].light[0].colour[0].y==0 && s[0].light[0].colour[0].z==0;
 nodes:[1024]JvNode;d:[1]Jv;camera:[1]AnimSceneCamera;n=anim_test_replace(ASC_CAMERA,"\"cut\":false","\"cut\":true",text[..]);#assert jv_parse(d[..],cast(string)text[0..<n],nodes[..]) && anim_camera_read(d[0],0,5,camera[..])==0 && camera[0].flight.keys[1].cut;
}
