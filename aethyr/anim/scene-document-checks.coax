 for count:[3]int.[0,16,17] {jo_start(o[..],keys[..]);jo_arr(o[..]);for k:0..<count {jo_obj(o[..]);jo_key(o[..],"at");jo_int(o[..],k);jo_key(o[..],"position");jo_raw(o[..],"[-1,2,-3]");jo_key(o[..],"colour");jo_raw(o[..],"[0.2,0.4,0.6]");jo_key(o[..],"intensity");jo_int(o[..],k);jo_end(o[..]);}jo_end(o[..]);kn:=o[0].n;jo_start(o[..],light[..]);jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],"test-light");jo_key(o[..],"keys");jo_raw(o[..],cast(string)keys[0..<kn]);jo_end(o[..]);jo_end(o[..]);n:=anim_test_set(AS_TEST,"lights",jo_text(o[..]),text[..]);n=anim_test_set(cast(string)text[0..<n],"length","600",a[..]);#assert anim_scene_load(cast(string)a[0..<n],packs[0..<0],r[..],p[..],s[..])==(ifx count==16 then ANIM_OK else ANIM_LIMIT);
  if count==16 {#assert s[0].light[0].count==16 && s[0].light[0].time[15]==15 && s[0].light[0].position[15].x== -1 && s[0].light[0].position[15].z== -3 && s[0].light[0].intensity[15]==15 && s[0].light[0].colour[15].y==0.4;nn:=anim_test_replace(cast(string)a[0..<n],"\"at\":15","\"at\":0",text[..]);#assert anim_scene_load(cast(string)text[0..<nn],packs[0..<0],r[..],p[..],s[..])==ANIM_NUMBER;}
 }
