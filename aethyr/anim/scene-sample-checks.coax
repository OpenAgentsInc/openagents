#test "scene paths clamp endpoints and interpolate authored positions and winding" {
 p:AnimPath;p.count=3;p.time[1]=2;p.time[2]=5;p.point[0]=v3(1,2,3);p.point[1]=v3(3,4,5);p.point[2]=v3(9,10,11);p.yaw[0]= -1;p.yaw[1]=3;p.yaw[2]=9;
 a:=scene_path(p,-1);#assert a.position.x==1 && a.yaw== -1;a=scene_path(p,1);#assert a.position.x==2 && a.position.y==3 && a.position.z==4 && a.yaw==1;a=scene_path(p,3.5);#assert a.position.x==6 && a.yaw==6;a=scene_path(p,8);#assert a.position.z==11 && a.yaw==9;
}
#test "scene light keys and event envelopes sample the scene clock without mutable state" {
 l:AnimSceneLight;l.count=2;l.time[1]=4;l.position[0]=v3(1,2,3);l.position[1]=v3(5,6,7);l.colour[0]=v3(0.1,0.2,0.3);l.colour[1]=v3(0.5,0.6,0.7);l.intensity[0]=2;l.intensity[1]=6;a:=scene_light(l,2);#assert a.position.x==3 && abs(a.colour.z-0.5)<0.000001 && a.intensity==4;
 fx:=AnimSceneEffect.{start=2,end=6,size=3,seed=7};#assert scene_effect(fx,1)==0 && scene_effect(fx,2)==0 && scene_effect(fx,3)==1 && scene_effect(fx,5)==1 && scene_effect(fx,6)==0;
}

#test "camera framing bounds front-facing points and excludes behind and outside FOV" {
 c:AnimSceneCamera;c.fov=1;c.flight.count=1;c.flight.keys[0]=FlightKey.{shot=Shot.{eye=v3(0,1,4),at=v3(0,1,0)}};#assert scene_camera_contains(c,0,v3(0,1,0),1.7777778);#assert !scene_camera_contains(c,0,v3(0,1,5),1.7777778) && !scene_camera_contains(c,0,v3(100,1,0),1.7777778);
}
