// Its checks, with the checks files it loads: coax/bin/coax test --library aethyr/anim/unreal-source.coax
// An Unreal source plan names data assets. The native adapter creates its
// own data-only project; it never runs this source project's modules.
#load "document.coax";
#load "unreal-source-checks.coax" #test;
#authority;
AuAsset :: struct {path:[1024]u8;path_n:int;name:AnimName;face:bool;}
AuSource :: struct {project:[4096]u8;project_n:int;profile:int;meshes:int;clips:int;mesh:[8]AuAsset;clip:[64]AuAsset;}
au_asset_path :: (text:string)->bool #effects(all) {
 if text.count<7 || text.count>1024 || text[0..<6]!="/Game/" {return false;}
 for k:6..<text.count {c:=text[k];if !((c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9') || c=='_' || c=='/' || c=='.') {return false;}if c=='.' && k+1<text.count && text[k+1]=='.' {return false;}}return true;
}
au_asset :: (d:Jv,node:int,face:bool,out:[]AuAsset)->int #effects(all) {
 if !anim_keys(d,node,anim_field_keys(ifx face then "anim.unreal.animations[]" else "anim.unreal.meshes[]")) {return ANIM_SCHEMA;}a:AuAsset;a.path_n=jv_str(d,jv_get(d,node,"asset"),a.path[..]);if a.path_n== -1 {return ANIM_NAME;}if !au_asset_path(cast(string)a.path[0..<a.path_n]) {return ANIM_NAME;}a.name=anim_name(d,jv_get(d,node,"name"));if a.name.n==0 {return ANIM_NAME;}
 if face {kind:=jv_kind(d,jv_get(d,node,"face_only"));if kind!=JV_TRUE && kind!=JV_FALSE {return ANIM_SCHEMA;}a.face=kind==JV_TRUE;}out[0]=a;return 0;
}
au_source :: (text:string,out:[]AuSource)->int #effects(all) {
 nodes:[32768]JvNode;d:[1]Jv;e:=anim_json(text,d[..],nodes[..]);if e!=0 {return e;}if !anim_schema(d[0],"anim.unreal.source.v1") || !anim_keys(d[0],0,anim_field_keys("anim.unreal.source")) {return ANIM_SCHEMA;}p:AuSource;p.project_n=jv_str(d[0],jv_get(d[0],0,"project"),p.project[..]);if p.project_n<1 || p.project[0]!='/' {return ANIM_NAME;}profiles:=[2]string.["generic","echo-a0"];p.profile=anim_choice(d[0],jv_get(d[0],0,"profile"),profiles[..]);if p.profile<0 {return ANIM_NAME;}
 meshes:=jv_get(d[0],0,"meshes");clips:=jv_get(d[0],0,"animations");p.meshes=jv_len(d[0],meshes);p.clips=jv_len(d[0],clips);if jv_kind(d[0],meshes)!=JV_ARRAY || p.meshes<1 || p.meshes>8 || jv_kind(d[0],clips)!=JV_ARRAY || p.clips<1 || p.clips>64 {return ANIM_LIMIT;}
 for k:0..<p.meshes {e=au_asset(d[0],jv_at(d[0],meshes,k),false,p.mesh[k..<k+1]);if e!=0 {return e;}for prev:0..<k {if anim_equal(p.mesh[k].name,p.mesh[prev].name) {return ANIM_NAME;}}}for k:0..<p.clips {e=au_asset(d[0],jv_at(d[0],clips,k),true,p.clip[k..<k+1]);if e!=0 {return e;}for prev:0..<k {if anim_equal(p.clip[k].name,p.clip[prev].name) {return ANIM_NAME;}}}out[0]=p;return 0;
}
