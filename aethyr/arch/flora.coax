// Aethyr's architecture kit, what grows and the land it grows on: stylized trees, far hills and
// the ground, as generators. Each writes one part at the origin (aethyr/arch/mesh.coax ArchPart);
// a realm stands it with a record, and a record's tint and scale make one tree a wood.
//
//   arch_tree_spec  a tree's sizes and colours from its species, its season and a seed
//   arch_tree       a tree from a spec: a broadleaf is a thick trunk and boughs under a crown of
//                   clumped, faceted lumps of leaves; a conifer is tiers of cones
//   arch_clump      one faceted lump of leaves
//   arch_peak       a far hill or a mountain: a dome or a peak with a ragged outline
//   arch_ground     the ground as a grid over a table of heights, grass cover and paving
//
// A leaf's u is how high it sits in its crown (0 the underside, 1 the top), which the stylized
// shading darkens toward the underside; its v is a number of the facet's own, for brushwork.
//   coax/bin/coax test --library aethyr/arch/flora.coax
#module "aethyr.arch.flora";
#load "solid.coax";

ARCH_OAK :: 0;       // broad and round
ARCH_MAPLE :: 1;     // taller, a fuller top
ARCH_POPLAR :: 2;    // narrow and tall
ARCH_PINE :: 3;      // a conifer: tiers of cones
ARCH_SUMMER :: 0;    // greens
ARCH_AUTUMN :: 1;    // red and orange
ARCH_GOLD :: 2;      // yellow and gold
ARCH_SPRING :: 3;    // pale fresh green

ArchTree :: struct {
  species: int = ARCH_OAK;
  height: f32 = 9.0;                 // to the top of the crown
  crown: f32 = 4.0;                  // the crown's radius
  squash: f32 = 0.72;                // the crown's height as a share of its width
  trunk: f32 = 0.38;                 // the trunk's radius at the ground
  clumps: int = 22;                  // lumps of leaves in the crown
  // Two leaf colours: each clump takes its own mix of them.
  leaf_r: f32 = 0.16; leaf_g: f32 = 0.36; leaf_b: f32 = 0.13;
  leaf2_r: f32 = 0.26; leaf2_g: f32 = 0.47; leaf2_b: f32 = 0.15;
  seed: int = 1;
}

// A tree of a species in a season: the seed varies its size and its shape.
arch_tree_spec :: (species: int, season: int, seed: int) -> ArchTree {
  t: ArchTree; t.species = species; t.seed = seed;
  k := arch_vary(seed, 1, 0.88, 1.14);
  if species == ARCH_MAPLE { t.height = 10.5 * k; t.crown = 4.2 * k; t.squash = 0.85; t.trunk = 0.4 * k; t.clumps = 24; }
  else if species == ARCH_POPLAR { t.height = 12 * k; t.crown = 2.2 * k; t.squash = 1.9; t.trunk = 0.28 * k; t.clumps = 16; }
  else if species == ARCH_PINE { t.height = 11 * k; t.crown = 2.4 * k; t.trunk = 0.24 * k; t.clumps = 5; }
  else { t.height = 9 * k; t.crown = 4.3 * k; t.squash = 0.7; t.trunk = 0.42 * k; t.clumps = 22; }
  if season == ARCH_AUTUMN { t.leaf_r = 0.66; t.leaf_g = 0.27; t.leaf_b = 0.10; t.leaf2_r = 0.80; t.leaf2_g = 0.41; t.leaf2_b = 0.13; }
  else if season == ARCH_GOLD { t.leaf_r = 0.86; t.leaf_g = 0.62; t.leaf_b = 0.14; t.leaf2_r = 0.93; t.leaf2_g = 0.78; t.leaf2_b = 0.25; }
  else if season == ARCH_SPRING { t.leaf_r = 0.42; t.leaf_g = 0.64; t.leaf_b = 0.22; t.leaf2_r = 0.58; t.leaf2_g = 0.74; t.leaf2_b = 0.30; }
  if species == ARCH_PINE && season == ARCH_SUMMER { t.leaf_r = 0.13; t.leaf_g = 0.34; t.leaf_b = 0.20; t.leaf2_r = 0.20; t.leaf2_g = 0.44; t.leaf2_b = 0.24; }
  return t;
}

// One lump of leaves: a rounded solid of flat facets about (cx, cy, cz), its outline pushed in and
// out by `rough` (0 smooth, 0.3 lumpy). Each facet's normal leans toward the way out of the crown
// (from `heart`, the crown's middle), so the whole crown takes light as one mass with a faceted
// surface. u is `low` to `high`: how high the facet sits in the crown.
arch_clump :: (p: [] ArchPen, cx: f32, cy: f32, cz: f32, rx: f32, ry: f32, rz: f32, heart: [3] f32, crown_low: f32, crown_high: f32, rough: f32, seed: int) {
  segments := 7; rings := 5;
  pts: [48] [3] f32;   // (segments + 1) * (rings + 1)
  for j: 0..<rings + 1 {
    for i: 0..<segments + 1 {
      a := f32(ARCH_TAU) * cast(f32) (i % segments) / cast(f32) segments + cast(f32) j * 0.35;
      b := f32(ARCH_TAU) * 0.5 * cast(f32) j / cast(f32) rings;
      f: f32 = 1;
      if j > 0 && j < rings { f = 1 + rough * (arch_hash(seed, (i % segments) * 13 + j * 101) * 2 - 1); }
      pts[j * (segments + 1) + i] = arch_v(cx + cos(a) * sin(b) * rx * f, cy - cos(b) * ry * f, cz + sin(a) * sin(b) * rz * f);
    }
  }
  middle := arch_v(cx, cy, cz); span := arch_highf(crown_high - crown_low, 0.001);
  for j: 0..<rings {
    for i: 0..<segments {
      q0 := pts[j * (segments + 1) + i]; q1 := pts[j * (segments + 1) + i + 1];
      q2 := pts[(j + 1) * (segments + 1) + i + 1]; q3 := pts[(j + 1) * (segments + 1) + i];
      // Each quad is two facets, each with its own lean and its own number.
      for half: 0..<2 {
        a := q0; b := ifx half == 0 then q3 else q2; c := ifx half == 0 then q2 else q1;
        if j == 0 && half == 1 { continue; }
        if j == rings - 1 && half == 0 { b = q3; c = q1; }
        if j == rings - 1 && half == 1 { continue; }
        m := arch_vmul(arch_vadd(arch_vadd(a, b), c), 1.0 / 3.0);
        face := arch_vnorm(arch_vcross(arch_vsub(b, a), arch_vsub(c, a)));
        if arch_vdot(face, arch_vsub(m, middle)) < 0 { face = arch_vmul(face, -1); }
        out := arch_vnorm(arch_vsub(m, heart));
        n := arch_vnorm(arch_vadd(arch_vadd(arch_vmul(face, 0.5), arch_vmul(out, 0.5)), arch_v(0, 0.12, 0)));
        u := (m[1] - crown_low) / span; u = arch_lowf(arch_highf(u, 0), 1);
        v := arch_hash(seed, 7000 + j * 40 + i * 2 + half);
        arch_tri(p, arch_at(a[0], a[1], a[2], n[0], n[1], n[2], u, v), arch_at(b[0], b[1], b[2], n[0], n[1], n[2], u, v), arch_at(c[0], c[1], c[2], n[0], n[1], n[2], u, v));
      }
    }
  }
}

arch_tree :: (p: [] ArchPen, t: ArchTree) -> ArchPart {
  from := p[0].n; seed := t.seed;
  p[0].material = ARCH_M_BARK; p[0].tint = [3] f32.[0, 0, 0];
  if t.species == ARCH_PINE {
    arch_limb(p, 0, 0, 0, 0, t.height * 0.5, 0, t.trunk, t.trunk * 0.5, 7);
    tiers := ifx t.clumps < 3 then 3 else t.clumps;
    p[0].material = ARCH_M_LEAF;
    for k: 0..<tiers {
      s := cast(f32) k / cast(f32) tiers;
      y0 := t.height * (0.16 + 0.68 * s); y1 := y0 + t.height * (0.3 - 0.08 * s); r := t.crown * (1 - 0.72 * s);
      mix := arch_hash(seed, 300 + k);
      p[0].tint = [3] f32.[t.leaf_r + (t.leaf2_r - t.leaf_r) * mix, t.leaf_g + (t.leaf2_g - t.leaf_g) * mix, t.leaf_b + (t.leaf2_b - t.leaf_b) * mix];
      sides := 9; turn := arch_hash(seed, 400 + k) * 6;
      for i: 0..<sides {
        a := turn + f32(ARCH_TAU) * cast(f32) i / cast(f32) sides; b := turn + f32(ARCH_TAU) * cast(f32) (i + 1) / cast(f32) sides;
        ra := r * arch_vary(seed, k * 31 + i, 0.86, 1.1); rb := r * arch_vary(seed, k * 31 + (i + 1) % sides, 0.86, 1.1);
        qa := arch_v(cos(a) * ra, y0, sin(a) * ra); qb := arch_v(cos(b) * rb, y0, sin(b) * rb); tip := arch_v(0, y1, 0);
        n := arch_vnorm(arch_vcross(arch_vsub(qa, qb), arch_vsub(tip, qb)));
        if n[1] < 0 { n = arch_vmul(n, -1); }
        v := arch_hash(seed, 900 + k * 20 + i);
        arch_tri(p, arch_at(qb[0], qb[1], qb[2], n[0], n[1], n[2], 0.25 + 0.5 * s, v), arch_at(qa[0], qa[1], qa[2], n[0], n[1], n[2], 0.25 + 0.5 * s, v),
                 arch_at(tip[0], tip[1], tip[2], n[0], n[1], n[2], 0.6 + 0.4 * s, v));
        // the tier's underside, in shade
        arch_tri(p, arch_at(qa[0], qa[1], qa[2], 0, -1, 0, 0, v), arch_at(qb[0], qb[1], qb[2], 0, -1, 0, 0, v), arch_at(0, y0 + 0.2, 0, 0, -1, 0, 0, v));
      }
    }
    return arch_part(p, from);
  }
  // A broadleaf: the crown's middle and its radii.
  ry := t.crown * t.squash; heart := arch_v(0, t.height - ry * 1.02, 0);
  fork_y := arch_highf(heart[1] - ry * 0.75, t.height * 0.22);
  lean_x := arch_vary(seed, 2, -0.35, 0.35); lean_z := arch_vary(seed, 3, -0.35, 0.35);
  // The trunk: a flared foot, then up to the fork, leaning a little.
  arch_limb(p, 0, -0.1, 0, 0, 0.45, 0, t.trunk * 1.55, t.trunk * 1.05, 9);
  arch_limb(p, 0, 0.45, 0, lean_x, fork_y, lean_z, t.trunk * 1.05, t.trunk * 0.78, 9);
  arch_ellipsoid(p, lean_x, fork_y, lean_z, t.trunk * 0.8, t.trunk * 0.8, t.trunk * 0.8, 8, 5);
  // Boughs from the fork up into the crown.
  for k: 0..<4 {
    a := f32(ARCH_TAU) * (cast(f32) k + arch_hash(seed, 20 + k) * 0.6) / 4.0;
    r := t.crown * arch_vary(seed, 30 + k, 0.4, 0.62);
    arch_limb(p, lean_x, fork_y - 0.1, lean_z, cos(a) * r, heart[1] - ry * arch_vary(seed, 40 + k, 0.05, 0.4), sin(a) * r, t.trunk * 0.55, t.trunk * 0.2, 6);
  }
  // The crown: one lump at its heart and the rest in a spiral round it, larger above than below.
  p[0].material = ARCH_M_LEAF;
  low := heart[1] - ry * 1.05; high := heart[1] + ry * 1.05;
  n := ifx t.clumps < 1 then 1 else t.clumps;
  for k: 0..<n {
    mix := arch_hash(seed, 100 + k); shade := arch_vary(seed, 150 + k, 0.92, 1.08);
    p[0].tint = [3] f32.[(t.leaf_r + (t.leaf2_r - t.leaf_r) * mix) * shade, (t.leaf_g + (t.leaf2_g - t.leaf_g) * mix) * shade, (t.leaf_b + (t.leaf2_b - t.leaf_b) * mix) * shade];
    if k == 0 { arch_clump(p, heart[0], heart[1] + ry * 0.1, heart[2], t.crown * 0.62, ry * 0.66, t.crown * 0.62, heart, low, high, 0.22, seed * 31 + 7); continue; }
    s := (cast(f32) k - 0.5) / cast(f32) (n - 1);        // 0 the top, 1 the underside
    up := 1 - 1.75 * s;                                  // from 1 down to -0.75
    flat := sqrt(arch_highf(1 - up * up, 0.05)); a := cast(f32) k * 2.39996 + arch_hash(seed, 200 + k);
    reach := arch_vary(seed, 250 + k, 0.56, 0.72);
    size := t.crown * arch_vary(seed, 300 + k, 0.28, 0.4) * (1 - 0.25 * s);
    arch_clump(p, heart[0] + cos(a) * flat * t.crown * reach, heart[1] + up * ry * reach, heart[2] + sin(a) * flat * t.crown * reach,
               size, size * arch_vary(seed, 350 + k, 0.72, 0.9), size, heart, low, high, 0.3, seed * 31 + k * 17);
  }
  return arch_part(p, from);
}

// A far hill or a mountain about the origin: `r` across at its foot and `h` high. `sharp` below 1
// is a dome and above 1 a peak; `ragged` pushes its outline in and out. u is how high up it a
// point is (0 its foot, 1 its top), for green slopes under pale rock.
arch_peak :: (p: [] ArchPen, r: f32, h: f32, sharp: f32, ragged: f32, seed: int) -> ArchPart {
  from := p[0].n; segments := 16; rings := 7;
  p[0].material = ARCH_M_ROCK;
  pts: [136] [3] f32;    // (segments + 1) * (rings + 1)
  for j: 0..<rings + 1 {
    s := cast(f32) j / cast(f32) rings;
    for i: 0..<segments + 1 {
      a := f32(ARCH_TAU) * cast(f32) (i % segments) / cast(f32) segments;
      rad := r * pow(1 - s, sharp) * (1 + ragged * (arch_hash(seed, (i % segments) * 17 + j * 131) * 2 - 1));
      if j == rings { rad = 0; }
      y := h * (1 - pow(1 - s, 1.6)) * (1 + ragged * 0.4 * (arch_hash(seed, (i % segments) * 19 + j * 211) * 2 - 1));
      if j == 0 { y = 0; } if j == rings { y = h; }
      pts[j * (segments + 1) + i] = arch_v(cos(a) * rad, y, sin(a) * rad);
    }
  }
  for j: 0..<rings {
    for i: 0..<segments {
      q0 := pts[j * (segments + 1) + i]; q1 := pts[j * (segments + 1) + i + 1];
      q2 := pts[(j + 1) * (segments + 1) + i + 1]; q3 := pts[(j + 1) * (segments + 1) + i];
      for half: 0..<2 {
        a := q0; b := ifx half == 0 then q3 else q2; c := ifx half == 0 then q2 else q1;
        if j == rings - 1 && half == 0 { b = q3; c = q1; }
        if j == rings - 1 && half == 1 { continue; }
        m := arch_vmul(arch_vadd(arch_vadd(a, b), c), 1.0 / 3.0);
        face := arch_vnorm(arch_vcross(arch_vsub(b, a), arch_vsub(c, a)));
        if face[1] < 0 { face = arch_vmul(face, -1); }
        out := arch_vnorm(arch_v(m[0], h * 0.35, m[2]));
        n := arch_vnorm(arch_vadd(arch_vmul(face, 0.65), arch_vmul(out, 0.35)));
        arch_tri(p, arch_at(a[0], a[1], a[2], n[0], n[1], n[2], a[1] / h, 0), arch_at(b[0], b[1], b[2], n[0], n[1], n[2], b[1] / h, 0), arch_at(c[0], c[1], c[2], n[0], n[1], n[2], c[1] / h, 0));
      }
    }
  }
  return arch_part(p, from);
}

// The ground's table: `n + 1` nodes a side, `cell` metres apart, its first node at (x0, z0). A node
// is ARCH_GROUND_FLOATS floats: its height, its grass cover (1 grass, 0 bare), how paved it is (1
// cobbles) and one spare.
ARCH_GROUND_FLOATS :: 4;
ArchGround :: struct { n: int; cell: f32; x0: f32; z0: f32; }
arch_ground_node :: (g: ArchGround, table: [] f32, i: int, j: int, field: int) -> f32 {
  ci := ifx i < 0 then 0 else ifx i > g.n then g.n else i; cj := ifx j < 0 then 0 else ifx j > g.n then g.n else j;
  return table[(cj * (g.n + 1) + ci) * ARCH_GROUND_FLOATS + field];
}
// A field of the table at a place, blended between its four nodes (0 the height).
arch_ground_at :: (g: ArchGround, table: [] f32, x: f32, z: f32, field: int) -> f32 {
  fx := (x - g.x0) / g.cell; fz := (z - g.z0) / g.cell;
  i := cast(int) floor(fx); j := cast(int) floor(fz); tx := fx - floor(fx); tz := fz - floor(fz);
  a := arch_ground_node(g, table, i, j, field); b := arch_ground_node(g, table, i + 1, j, field);
  c := arch_ground_node(g, table, i, j + 1, field); d := arch_ground_node(g, table, i + 1, j + 1, field);
  return (a + (b - a) * tx) * (1 - tz) + (c + (d - c) * tx) * tz;
}
// The ground's mesh over its table: two triangles a cell, smooth normals from the heights; u is
// the grass cover and v the paving.
arch_ground :: (p: [] ArchPen, g: ArchGround, table: [] f32) -> ArchPart {
  from := p[0].n;
  p[0].material = ARCH_M_GROUND; p[0].tint = [3] f32.[0, 0, 0];
  if table.count < (g.n + 1) * (g.n + 1) * ARCH_GROUND_FLOATS { p[0].full = true; return arch_part(p, from); }
  for j: 0..<g.n {
    for i: 0..<g.n {
      q: [4] ArchPoint;
      for k: 0..<4 {
        ii := i + (ifx k == 1 || k == 2 then 1 else 0); jj := j + (ifx k >= 2 then 1 else 0);
        nx := arch_ground_node(g, table, ii - 1, jj, 0) - arch_ground_node(g, table, ii + 1, jj, 0);
        nz := arch_ground_node(g, table, ii, jj - 1, 0) - arch_ground_node(g, table, ii, jj + 1, 0);
        ny := 2 * g.cell; inv := 1 / sqrt(nx * nx + ny * ny + nz * nz);
        q[k] = arch_at(g.x0 + cast(f32) ii * g.cell, arch_ground_node(g, table, ii, jj, 0), g.z0 + cast(f32) jj * g.cell, nx * inv, ny * inv, nz * inv,
                       arch_ground_node(g, table, ii, jj, 1), arch_ground_node(g, table, ii, jj, 2));
      }
      arch_quad(p, q[0], q[3], q[2], q[1]);
    }
  }
  return arch_part(p, from);
}

#test "a broadleaf is a trunk under a crown of its size, and species, season and seed each change it" {
  buf: [40000 * ARCH_VERTEX_FLOATS] f32; p: [1] ArchPen; arch_pen(p[..], buf[..]);
  spec := arch_tree_spec(ARCH_OAK, ARCH_SUMMER, 5);
  oak := arch_tree(p[..], spec);
  #assert !p[0].full && oak.count % 3 == 0 && oak.count > 2000;
  low: f32 = 1000; high: f32 = -1000; wide: f32 = 0; leaves := 0; bark := 0;
  for i: 0..<oak.count {
    o := (oak.first + i) * ARCH_VERTEX_FLOATS;
    l := buf[o + 3] * buf[o + 3] + buf[o + 4] * buf[o + 4] + buf[o + 5] * buf[o + 5]; #assert abs(l - 1) < 0.01;
    if buf[o + 6] == ARCH_M_LEAF {
      leaves += 1; low = arch_lowf(low, buf[o + 1]); high = arch_highf(high, buf[o + 1]); wide = arch_highf(wide, sqrt(buf[o] * buf[o] + buf[o + 2] * buf[o + 2]));
      #assert buf[o + 7] >= 0 && buf[o + 7] <= 1 && buf[o + 8] >= 0 && buf[o + 8] < 1 && buf[o + 10] > buf[o + 9] && buf[o + 10] > buf[o + 11];
    } else { bark += 1; #assert buf[o + 6] == ARCH_M_BARK; }
  }
  #assert leaves > bark && low > spec.height * 0.15 && high > spec.height * 0.85 && high < spec.height * 1.25 && wide > spec.crown * 0.75 && wide < spec.crown * 1.45;
  autumn := arch_tree(p[..], arch_tree_spec(ARCH_OAK, ARCH_AUTUMN, 5));
  #assert autumn.count == oak.count;
  for i: 0..<autumn.count { o := (autumn.first + i) * ARCH_VERTEX_FLOATS; if buf[o + 6] == ARCH_M_LEAF { #assert buf[o + 9] > buf[o + 10] && buf[o + 10] > buf[o + 11]; } }
  other := arch_tree(p[..], arch_tree_spec(ARCH_OAK, ARCH_SUMMER, 6));
  #assert buf[(other.first + other.count - 1) * ARCH_VERTEX_FLOATS] != buf[(oak.first + oak.count - 1) * ARCH_VERTEX_FLOATS];
  pine := arch_tree(p[..], arch_tree_spec(ARCH_PINE, ARCH_SUMMER, 5));
  #assert !p[0].full && pine.count != oak.count && pine.count == 42 + 5 * 9 * 6;
}
#test "a peak rises from its foot to its top, a dome wider than a peak half way up" {
  buf: [4000 * ARCH_VERTEX_FLOATS] f32; p: [1] ArchPen; arch_pen(p[..], buf[..]);
  dome := arch_peak(p[..], 100, 60, 0.6, 0, 3); peak := arch_peak(p[..], 100, 60, 1.5, 0, 3);
  #assert !p[0].full && dome.count == peak.count && dome.count == (16 * 6 * 2 + 16) * 3;
  reach: [2] f32;
  for k: 0..<2 {
    part := ifx k == 0 then dome else peak;
    for i: 0..<part.count {
      o := (part.first + i) * ARCH_VERTEX_FLOATS;
      #assert buf[o + 1] >= 0 && buf[o + 1] <= 60.001 && buf[o + 6] == ARCH_M_ROCK && buf[o + 7] >= 0 && buf[o + 7] <= 1.001 && buf[o + 4] >= 0;
      if buf[o + 1] > 20 && buf[o + 1] < 40 { reach[k] = arch_highf(reach[k], sqrt(buf[o] * buf[o] + buf[o + 2] * buf[o + 2])); }
    }
  }
  #assert reach[0] > reach[1] && reach[1] > 0;
}
#test "the ground follows its table: heights at the nodes, blended between, cover and paving carried" {
  g := ArchGround.{n = 2, cell = 2, x0 = -2, z0 = -2};
  table: [9 * ARCH_GROUND_FLOATS] f32;
  for j: 0..<3 { for i: 0..<3 { o := (j * 3 + i) * ARCH_GROUND_FLOATS; table[o] = cast(f32) i; table[o + 1] = 1; table[o + 2] = cast(f32) j * 0.5; } }
  #assert arch_ground_at(g, table[..], -2, -2, 0) == 0 && arch_ground_at(g, table[..], 2, 0, 0) == 2 && arch_ground_at(g, table[..], -1, 1, 0) == 0.5;
  #assert arch_ground_at(g, table[..], 0, 1, 2) == 0.75 && arch_ground_at(g, table[..], 50, 50, 0) == 2;
  buf: [24 * ARCH_VERTEX_FLOATS] f32; p: [1] ArchPen; arch_pen(p[..], buf[..]);
  part := arch_ground(p[..], g, table[..]);
  #assert !p[0].full && part.count == 24 && arch_facing(buf[..], part) > 7.5;
  for i: 0..<24 {
    o := i * ARCH_VERTEX_FLOATS;
    #assert abs(buf[o + 1] - arch_ground_at(g, table[..], buf[o], buf[o + 2], 0)) < 0.001 && buf[o + 7] == 1 && buf[o + 6] == ARCH_M_GROUND && buf[o + 4] > 0.5;
  }
  short: [8] f32; q: [1] ArchPen; arch_pen(q[..], buf[..]);
  bad := arch_ground(q[..], g, short[..]); #assert q[0].full && bad.count == 0;
}
