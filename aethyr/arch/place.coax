// Aethyr's architecture kit, placing parts: a part (aethyr/arch/mesh.coax ArchPart) is built once
// and stood wherever a realm wants it by a record, and a draw names a part and a run of records.
//
// A record is ARCH_RECORD_FLOATS floats: where (x, y, z) and its turn about y; its scale, a motion
// (ARCH_STILL, or ARCH_FLOAT: it bobs and spins) and that motion's phase; a tint and a light of
// its own. A draw is four words: the part's first vertex, its vertex count, its first record and
// how many records, as the engine's other draws are (aethyr/render/geometry.coax).
// A turn of `yaw` takes a part's own +x to the world's (cos yaw, -sin yaw) and its +z to
// (sin yaw, cos yaw): the same turn Everglade's figures use.
//   coax/bin/coax test --library aethyr/arch/place.coax
#module "aethyr.arch.place";
#load "mesh.coax";

ARCH_RECORD_FLOATS :: 16;
ARCH_STILL :: 0; ARCH_FLOAT :: 1;

ArchScene :: struct {
  records: [] f32; rn: int;
  draws: [] u32; dn: int;
  full: bool;           // a record, a draw or a solid did not fit, and was left out
  local: [] f32;        // the pen's solids (aethyr/arch/mesh.coax), in each part's own space
  placed: [] f32; pn: int;   // every drawn part's solids where its records stand them, in the world
}
// A placed solid is ARCH_PLACED_FLOATS floats in the world: its kind (ARCH_SOLID_BOX,
// ARCH_SOLID_ROUND), its middle on the ground (x, z), its half sizes, its turn about y, its foot
// and its top. aethyr/arch/solids.coax hands them to Aethyr's queries and its walker.
ARCH_PLACED_FLOATS :: 8;
// Keep solids: `local` is the pen's (arch_pen_solids), `placed` is where the scene's go. Every
// draw after this stands its part's solids with its records.
arch_scene_solids :: (s: [] ArchScene, local: [] f32, placed: [] f32) { s[0].local = local; s[0].placed = placed; s[0].pn = 0; }
arch_place_solids :: (s: [] ArchScene, part: ArchPart, first: int, count: int) {
  if part.solids <= 0 || s[0].placed.count == 0 { return; }
  for r: first..<first + count {
    ro := r * ARCH_RECORD_FLOATS;
    x := s[0].records[ro]; y := s[0].records[ro + 1]; z := s[0].records[ro + 2]; yaw := s[0].records[ro + 3]; scale := s[0].records[ro + 4];
    c := cos(yaw); sn := sin(yaw);
    for k: 0..<part.solids {
      lo := (part.solid + k) * ARCH_SOLID_FLOATS;
      if lo + ARCH_SOLID_FLOATS > s[0].local.count { return; }
      if (s[0].pn + 1) * ARCH_PLACED_FLOATS > s[0].placed.count { s[0].full = true; return; }
      o := s[0].pn * ARCH_PLACED_FLOATS;
      lx := s[0].local[lo + 1] * scale; lz := s[0].local[lo + 2] * scale;
      s[0].placed[o] = s[0].local[lo];
      s[0].placed[o + 1] = x + lx * c + lz * sn; s[0].placed[o + 2] = z - lx * sn + lz * c;
      s[0].placed[o + 3] = s[0].local[lo + 3] * scale; s[0].placed[o + 4] = s[0].local[lo + 4] * scale;
      s[0].placed[o + 5] = s[0].local[lo + 5] + yaw;
      s[0].placed[o + 6] = y + s[0].local[lo + 6] * scale; s[0].placed[o + 7] = y + s[0].local[lo + 7] * scale;
      s[0].pn += 1;
    }
  }
}
arch_scene :: (s: [] ArchScene, records: [] f32, draws: [] u32) { s[0].records = records; s[0].rn = 0; s[0].draws = draws; s[0].dn = 0; s[0].full = false; s[0].pn = 0; }

// One record; its index, or -1 when there is no room.
arch_stand :: (s: [] ArchScene, x: f32, y: f32, z: f32, yaw: f32, scale: f32) -> int {
  if (s[0].rn + 1) * ARCH_RECORD_FLOATS > s[0].records.count { s[0].full = true; return -1; }
  o := s[0].rn * ARCH_RECORD_FLOATS;
  for i: 0..<ARCH_RECORD_FLOATS { s[0].records[o + i] = 0; }
  s[0].records[o] = x; s[0].records[o + 1] = y; s[0].records[o + 2] = z; s[0].records[o + 3] = yaw;
  s[0].records[o + 4] = scale;
  s[0].records[o + 8] = 1; s[0].records[o + 9] = 1; s[0].records[o + 10] = 1;
  s[0].rn += 1;
  return s[0].rn - 1;
}
// A record's motion and phase, and its own value (a display's number, a light's strength).
arch_motion :: (s: [] ArchScene, record: int, motion: int, phase: f32) {
  if record < 0 || record >= s[0].rn { return; }
  o := record * ARCH_RECORD_FLOATS; s[0].records[o + 5] = cast(f32) motion; s[0].records[o + 6] = phase;
}
arch_value :: (s: [] ArchScene, record: int, value: f32) {
  if record < 0 || record >= s[0].rn { return; }
  s[0].records[record * ARCH_RECORD_FLOATS + 11] = value;
}
// A draw of `part` at the records from `first`, `count` of them. Nothing is drawn for none.
arch_draw :: (s: [] ArchScene, part: ArchPart, first: int, count: int) {
  if count <= 0 || part.count <= 0 || first < 0 { return; }
  if (s[0].dn + 1) * 4 > s[0].draws.count { s[0].full = true; return; }
  o := s[0].dn * 4;
  s[0].draws[o] = cast(u32) part.first; s[0].draws[o + 1] = cast(u32) part.count; s[0].draws[o + 2] = cast(u32) first; s[0].draws[o + 3] = cast(u32) count;
  s[0].dn += 1;
  arch_place_solids(s, part, first, count);
}
// One part once, where it was built.
arch_once :: (s: [] ArchScene, part: ArchPart) { r := arch_stand(s, 0, 0, 0, 0, 1); arch_draw(s, part, r, 1); }
// `count` of a part round the y axis at `radius`, the first at `angle` and the rest a whole turn
// shared between them, each turned so its own +x points out from the middle. `skip_at` and
// `skip_half` leave a gap: none stands within skip_half radians of the angle skip_at (a doorway).
// Returns how many were placed.
arch_round :: (s: [] ArchScene, part: ArchPart, count: int, radius: f32, angle: f32, y: f32, skip_at: f32, skip_half: f32) -> int {
  first := s[0].rn; placed := 0;
  for i: 0..<count {
    a := angle + f32(ARCH_TAU) * cast(f32) i / cast(f32) count;
    d := a - skip_at; d -= f32(ARCH_TAU) * floor(d / f32(ARCH_TAU) + 0.5);
    if skip_half > 0 && abs(d) < skip_half { continue; }
    if arch_stand(s, cos(a) * radius, y, sin(a) * radius, -a, 1) >= 0 { placed += 1; }
  }
  arch_draw(s, part, first, placed);
  return placed;
}

#test "parts stand in a ring facing out, leave a doorway, and a full scene says so" {
  records: [40 * ARCH_RECORD_FLOATS] f32; draws: [8] u32; s: [1] ArchScene; arch_scene(s[..], records[..], draws[..]);
  part := ArchPart.{first = 120, count = 36};
  n := arch_round(s[..], part, 16, 7.75, ARCH_TAU / 32, 0, 0, 0);
  #assert n == 16 && s[0].rn == 16 && s[0].dn == 1 && draws[0] == 120 && draws[1] == 36 && draws[2] == 0 && draws[3] == 16;
  for i: 0..<16 { o := i * ARCH_RECORD_FLOATS; r := sqrt(records[o] * records[o] + records[o + 2] * records[o + 2]); #assert abs(r - 7.75) < 0.001 && records[o + 4] == 1; }
  // The turn takes the part's +x to the way out from the middle.
  c := cos(records[3]); sn := sin(records[3]);
  #assert abs(c - records[0] / 7.75) < 0.001 && abs(-sn - records[2] / 7.75) < 0.001;
  m := arch_round(s[..], part, 8, 4.0, 0, 0, -1.5707963, 0.5);
  #assert m == 7 && s[0].dn == 2 && draws[7] == 7;
  arch_motion(s[..], 0, ARCH_FLOAT, 0.5); arch_value(s[..], 0, 3); #assert records[5] == 1 && records[6] == 0.5 && records[11] == 3;
  for i: 0..<40 { r := arch_stand(s[..], 0, 0, 0, 0, 1); }
  #assert s[0].full && s[0].rn == 40;
  arch_draw(s[..], part, 0, 0); #assert s[0].dn == 2;
}
#test "a draw stands its part's solids with each record: moved, turned, scaled and lifted" {
  records: [4 * ARCH_RECORD_FLOATS] f32; draws: [8] u32; s: [1] ArchScene; arch_scene(s[..], records[..], draws[..]);
  buf: [36 * ARCH_VERTEX_FLOATS] f32; local: [4 * ARCH_SOLID_FLOATS] f32; placed: [8 * ARCH_PLACED_FLOATS] f32;
  p: [1] ArchPen; arch_pen(p[..], buf[..]); arch_pen_solids(p[..], local[..]); arch_scene_solids(s[..], local[..], placed[..]);
  arch_box(p[..], 2, 1, 0, 1, 1, 0.5); arch_solid_box(p[..], 1, 0, -0.5, 3, 2, 0.5); arch_solid_round(p[..], 2, 0, 0.25, 2, 3);
  part := arch_part(p[..], 0); #assert part.solids == 2 && part.solid == 0 && !p[0].full;
  // A second part claims none of the first's.
  none := arch_part(p[..], p[0].n); #assert none.solids == 0;
  a := arch_stand(s[..], 10, 5, 20, 0, 1); b := arch_stand(s[..], 0, 0, 0, ARCH_TAU / 4, 2);
  arch_draw(s[..], part, a, 2);
  #assert s[0].pn == 4 && !s[0].full && placed[0] == ARCH_SOLID_BOX && placed[1] == 12 && placed[2] == 20 && placed[3] == 1 && placed[4] == 0.5 && placed[6] == 5 && placed[7] == 7;
  #assert placed[8] == ARCH_SOLID_ROUND && placed[9] == 12 && placed[11] == 0.25 && placed[14] == 7 && placed[15] == 8;
  // A quarter turn takes the part's +x to the world's -z; twice the size is twice as far and as big.
  o := 2 * ARCH_PLACED_FLOATS;
  #assert abs(placed[o + 1]) < 0.001 && abs(placed[o + 2] + 4) < 0.001 && placed[o + 3] == 2 && placed[o + 4] == 1 && abs(placed[o + 5] - ARCH_TAU / 4) < 0.0001 && placed[o + 7] == 4;
  // No room: the scene says so.
  for i: 0..<3 { arch_draw(s[..], part, a, 2); } #assert s[0].full && s[0].pn == 8;
}
