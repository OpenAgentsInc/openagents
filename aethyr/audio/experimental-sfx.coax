// Everglade Experimental's own synthesized effects: the sounds its combat needs that the shared
// Everglade bank (everglade-bank.coax, aethyr/audio/SOURCES.md) has no fitting file for. Each is a
// recipe in Audio Lab's synthesized format (sfx.coax: SfxLayer, sl, sfx_add; synth.coax's
// oscillators, seeded noise, envelopes and one-pole filters), rendered once to 16-bit mono WAV
// bytes when the page's audio starts (fivelab-face.c coaxial_sound_bank). Nothing is recorded or
// downloaded: CC0, made by OpenAgents. Integers only, so a recipe renders the same bytes on every
// build and target.
//   coax/bin/coax test aethyr/audio/experimental-sfx.coax --library
#load "sfx.coax";

XSFX_PSYCHIC_CAST :: 0; XSFX_PSYCHIC_HIT :: 1; XSFX_CHOIR :: 2; XSFX_RAGE_ROAR :: 3; XSFX_GRUNT :: 4;
XSFX_SWING_HEAVY :: 5; XSFX_FIZZLE :: 6; XSFX_SECOND_WIND :: 7; XSFX_SURGE :: 8; XSFX_DASH :: 9;
XSFX_FLURRY :: 10; XSFX_ENTANGLE :: 11; XSFX_IMP_HURT :: 12; XSFX_IMP_DEATH :: 13;
XSFX_GREMLIN_HURT :: 14; XSFX_GREMLIN_DEATH :: 15;
// the monsters' ranged attacks (experimental-combat.coax xc_shots_step): the release, the flight
// past you and the impact, for an arrow and for a thrown rock
XSFX_BOW :: 16; XSFX_ARROW_WHIZ :: 17; XSFX_ARROW_HIT :: 18; XSFX_HURL :: 19; XSFX_ROCK_HIT :: 20;
XSFX_COUNT :: 21;
XSFX_NAMES :: [XSFX_COUNT] string.[
  "psychic-cast", "psychic-hit", "choir", "rage-roar", "grunt",
  "swing-heavy", "fizzle", "second-wind", "surge", "dash",
  "flurry", "entangle", "imp-hurt", "imp-death",
  "gremlin-hurt", "gremlin-death",
  "bow-release", "arrow-whiz", "arrow-hit", "hurl", "rock-hit"];
XSFX_MAX_MS :: 1400;

xsfx_id :: (name: string) -> int {
  for i: 0..<XSFX_COUNT { if XSFX_NAMES[i] == name { return i; } }
  return -1;
}

// book:begin experimental-recipes
xsfx_recipe :: (id: int) -> Sfx {
  s := Sfx.{};
  if id == XSFX_PSYCHIC_CAST {          // Vicious Mockery: a sinister, voice-like warble, the "oo" opening to "ah"
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 900, 90, 150, 120, 500, 1800, 0, 700), 1), 60, 6));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 900, 90, 226, 180, 500, 1800, 0, 500), 1), 70, 5));
    s = sfx_add(s, sl_vib(sl(SFX_SAW, 120, 760, 80, 300, 240, 900, 2600, 0, 350), 80, 4));
    s = sfx_add(s, sl(SFX_NOISE, 0, 800, 200, 0, 0, 6000, 5000, 2500, 250));
  } else if id == XSFX_PSYCHIC_HIT {    // the mockery lands: a dissonant shudder and a dull thump
    s = sfx_add(s, sl_vib(sl(SFX_SQUARE, 0, 520, 6, 330, 180, 2200, 600, 0, 600), 120, 11));
    s = sfx_add(s, sl(SFX_SAW, 0, 480, 6, 165, 90, 900, 300, 0, 600));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 260, 3, 0, 0, 3000, 500, 200, 500), 3));
  } else if id == XSFX_CHOIR {          // Sacred Flame: a bright held "ah" of four voices, C major
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 1300, 180, 523, 523, 1500, 2200, 0, 420), 1), 6, 5));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 20, 1280, 180, 659, 659, 1500, 2200, 0, 380), 1), 6, 6));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 40, 1260, 180, 784, 785, 1500, 2200, 0, 360), 1), 7, 5));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 60, 1240, 200, 1046, 1047, 1700, 2400, 0, 260), 1), 6, 4));
    s = sfx_add(s, sl(SFX_NOISE, 0, 900, 150, 0, 0, 10000, 9000, 6000, 120));
  } else if id == XSFX_RAGE_ROAR {      // Rage: a throaty roar with a growl under it
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 1100, 60, 95, 70, 600, 1400, 0, 900), 1), 70, 7));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 1050, 60, 143, 100, 700, 1600, 0, 600), 1), 90, 9));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 1000, 40, 0, 0, 1200, 500, 150, 800), 1));
    s = sfx_add(s, sl(SFX_SQUARE, 0, 900, 60, 48, 40, 300, 300, 0, 400));
  } else if id == XSFX_GRUNT {          // Reckless Attack: a grunt of effort and a wild heavy swing
    s = sfx_add(s, sl_vib(sl(SFX_SAW, 0, 380, 15, 180, 110, 900, 400, 0, 800), 60, 8));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 260, 10, 0, 0, 800, 300, 100, 500), 3));
    s = sfx_add(s, sl(SFX_NOISE, 150, 320, 150, 0, 0, 500, 1600, 200, 900));
  } else if id == XSFX_SWING_HEAVY {    // a greataxe or greatsword: a slower, lower whoosh with weight
    s = sfx_add(s, sl(SFX_NOISE, 0, 420, 220, 0, 0, 350, 1300, 120, 1000));
    s = sfx_add(s, sl(SFX_SINE, 0, 380, 200, 110, 55, 0, 0, 0, 500));
    s = sfx_add(s, sl(SFX_NOISE, 150, 250, 80, 0, 0, 1800, 800, 600, 350));
  } else if id == XSFX_FIZZLE {         // a spell that meets no one: sparks dying out and a falling blip
    s = sfx_add(s, sl(SFX_CRACKLE, 0, 550, 3, 600, 40, 7000, 3000, 1200, 700));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 450, 5, 0, 0, 5000, 1200, 2500, 500), 3));
    s = sfx_add(s, sl(SFX_SINE, 0, 300, 4, 900, 260, 0, 0, 0, 350));
  } else if id == XSFX_SECOND_WIND {    // Second Wind: a deep breath and a warm swell
    s = sfx_add(s, sl(SFX_NOISE, 0, 1100, 500, 0, 0, 400, 1400, 120, 700));
    s = sfx_add(s, sl_vib(sl(SFX_SINE, 0, 1100, 300, 220, 220, 0, 0, 0, 500), 5, 5));
    s = sfx_add(s, sl(SFX_SINE, 0, 1100, 400, 330, 330, 0, 0, 0, 380));
    s = sfx_add(s, sl(SFX_SINE, 150, 950, 300, 440, 440, 0, 0, 0, 280));
  } else if id == XSFX_SURGE {          // Action Surge: a rising rush of energy
    s = sfx_add(s, sl_curve(sl(SFX_SAW, 0, 800, 500, 110, 330, 600, 3000, 0, 600), 1));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 800, 600, 0, 0, 800, 4000, 300, 600), 1));
    s = sfx_add(s, sl(SFX_SINE, 0, 800, 400, 55, 110, 0, 0, 0, 500));
  } else if id == XSFX_DASH {           // Dash: two quick rushes of air
    s = sfx_add(s, sl(SFX_NOISE, 0, 300, 120, 0, 0, 700, 2600, 300, 900));
    s = sfx_add(s, sl(SFX_NOISE, 140, 300, 90, 0, 0, 1200, 3000, 500, 700));
  } else if id == XSFX_FLURRY {         // Flurry of Blows: three fast whooshes
    for k: 0..<3 { s = sfx_add(s, sl(SFX_NOISE, k * 170, 180, 70, 0, 0, 900, 2400, 300, 900)); }
  } else if id == XSFX_ENTANGLE {       // Entangle: creaking vines and groaning wood
    s = sfx_add(s, sl(SFX_CRACKLE, 0, 1200, 200, 120, 300, 3000, 1500, 300, 700));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 1200, 300, 70, 90, 400, 700, 0, 600), 1), 150, 3));
    s = sfx_add(s, sl(SFX_NOISE, 0, 1100, 400, 0, 0, 600, 900, 100, 500));
  } else if id == XSFX_IMP_HURT {       // an imp hurt: a shrill chittering squeal
    s = sfx_add(s, sl_vib(sl(SFX_SAW, 0, 350, 8, 1100, 700, 3500, 1800, 400, 800), 120, 23));
    s = sfx_add(s, sl(SFX_SQUARE, 0, 300, 8, 1650, 1000, 3000, 3000, 0, 300));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 120, 2, 0, 0, 2500, 2500, 300, 400), 3));
  } else if id == XSFX_IMP_DEATH {      // an imp dies: a long falling shriek and the body landing
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 800, 10, 1200, 300, 3800, 900, 200, 800), 1), 150, 17));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 700, 300, 2, 0, 0, 700, 150, 30, 800), 3));
    s = sfx_add(s, sl(SFX_SINE, 700, 260, 2, 80, 40, 0, 0, 0, 700));
  } else if id == XSFX_GREMLIN_HURT {   // a gremlin hurt: a guttural snarl
    s = sfx_add(s, sl_vib(sl(SFX_SAW, 0, 380, 10, 260, 170, 1600, 700, 80, 900), 90, 13));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 200, 3, 0, 0, 1200, 400, 80, 500), 3));
  } else if id == XSFX_GREMLIN_DEATH {  // a gremlin dies: a dying growl and a heavy fall
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 850, 20, 280, 90, 1800, 400, 0, 850), 1), 100, 9));
    s = sfx_add(s, sl(SFX_SAW, 0, 850, 20, 140, 60, 800, 250, 0, 500));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 800, 300, 2, 0, 0, 600, 150, 30, 900), 3));
    s = sfx_add(s, sl(SFX_SINE, 800, 280, 2, 70, 35, 0, 0, 0, 700));
  } else if id == XSFX_BOW {            // a shortbow loosed: the string's twang and the arrow leaving
    s = sfx_add(s, sl(SFX_SAW, 0, 180, 2, 210, 150, 2400, 600, 0, 700));
    s = sfx_add(s, sl(SFX_SINE, 0, 220, 2, 420, 300, 0, 0, 0, 400));
    s = sfx_add(s, sl(SFX_NOISE, 20, 260, 30, 0, 0, 2200, 4200, 900, 500));
  } else if id == XSFX_ARROW_WHIZ {     // an arrow flying past: a thin rising-falling whistle of air
    s = sfx_add(s, sl(SFX_NOISE, 0, 420, 180, 0, 0, 3000, 6000, 1800, 800));
    s = sfx_add(s, sl(SFX_SINE, 0, 380, 160, 1500, 1100, 0, 0, 0, 160));
  } else if id == XSFX_ARROW_HIT {      // an arrow striking: a short thunk and a quiver
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 140, 1, 0, 0, 2200, 500, 150, 900), 3));
    s = sfx_add(s, sl_vib(sl(SFX_SINE, 0, 260, 2, 190, 160, 0, 0, 0, 500), 40, 28));
  } else if id == XSFX_HURL {           // a rock heaved: a grunt and a low heavy whoosh
    s = sfx_add(s, sl_vib(sl(SFX_SAW, 0, 300, 15, 150, 95, 800, 350, 0, 600), 50, 8));
    s = sfx_add(s, sl(SFX_NOISE, 80, 520, 260, 0, 0, 300, 1100, 90, 1000));
  } else if id == XSFX_ROCK_HIT {       // a rock landing: a heavy crunch, then rubble
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 320, 2, 0, 0, 1400, 250, 40, 1000), 3));
    s = sfx_add(s, sl(SFX_SINE, 0, 300, 2, 75, 38, 0, 0, 0, 800));
    s = sfx_add(s, sl(SFX_CRACKLE, 40, 650, 10, 140, 30, 4000, 1500, 400, 500));
  }
  return s;
}
// book:end experimental-recipes

XSFX_MAX_FRAMES :: XSFX_MAX_MS * SFX_RATE / 1000;
// The WAV bytes every recipe takes at SFX_RATE: the face's bank holds them all.
xsfx_bytes :: () -> int {
  n := 0;
  for i: 0..<XSFX_COUNT { n += WAV_HEADER + 2 * (xsfx_recipe(i).ms * SFX_RATE / 1000); }
  return n;
}

// Recipe `id` rendered at `rate` into mix (scratch) and then out as WAV bytes, exactly as
// sfx.coax's sfx_render does an Everglade effect: peaks to 0.8 of full scale through a soft
// saturation, so every effect leaves the synthesizer at one level.
xsfx_render :: (id: int, rate: int, mix: [] int, out: [] u8) -> SfxRender {
  r := SfxRender.{};
  if id < 0 || id >= XSFX_COUNT || rate < 8000 { return r; }
  s := xsfx_recipe(id);
  n := s.ms * rate / 1000;
  if n > mix.count || n < 1 || out.count < WAV_HEADER + 2 * n { return r; }
  m := mix[0..<n];
  for i: 0..<n { m[i] = 0; }
  for j: 0..<s.n { sfx_layer(s.layers[j], 50021 + id * 977 + j * 131, rate, m); }
  peak := 0;
  for i: 0..<n { peak = au_max(peak, au_abs(m[i])); }
  if peak > 0 {
    for i: 0..<n {
      v := au_saturate(m[i] * (AU_ONE * 9 / 10) / peak, 78643);
      m[i] = au_clamp(v * 4 / 5 / 2, -32768, 32767);
    }
  }
  b := wav_write(m[0..<n], 1, rate, out);
  if b < 0 { return r; }
  return SfxRender.{ok = true, frames = n, peak = peak, bytes = b};
}

#test "every experimental effect has a name, a recipe, fits the scratch and is not an Everglade name" {
  for i: 0..<XSFX_COUNT {
    #assert xsfx_id(XSFX_NAMES[i]) == i && sfx_id(XSFX_NAMES[i]) == -1;
    s := xsfx_recipe(i);
    #assert s.n > 0 && s.ms > 0 && s.ms <= XSFX_MAX_MS && s.loop == 0;
  }
  #assert xsfx_id("nothing") == -1 && xsfx_bytes() < (1 << 20);
}

#test "an experimental effect renders loud WAV bytes, the same bytes each time" #steps 900000000 {
  mix: [XSFX_MAX_FRAMES] int; a: [WAV_HEADER + 2 * XSFX_MAX_FRAMES] u8; b: [WAV_HEADER + 2 * XSFX_MAX_FRAMES] u8;
  for id: 0..<XSFX_COUNT {
    r := xsfx_render(id, 8000, mix[..], a[..]);
    #assert r.ok && r.peak > 0 && r.bytes == WAV_HEADER + 2 * r.frames;
    loud := 0;
    for i: 0..<r.frames { v := (cast(int) a[WAV_HEADER + 2 * i] | (cast(int) a[WAV_HEADER + 2 * i + 1] << 8)); if v >= 32768 { v -= 65536; } loud = au_max(loud, au_abs(v)); }
    #assert loud > 20000 && loud <= 32767;
    q := xsfx_render(id, 8000, mix[..], b[..]);
    same := q.bytes == r.bytes;
    for i: 0..<r.bytes { if a[i] != b[i] { same = false; } }
    #assert same;
  }
  #assert !xsfx_render(XSFX_COUNT, SFX_RATE, mix[..], a[..]).ok && !xsfx_render(0, SFX_RATE, mix[0..<10], a[..]).ok;
}
