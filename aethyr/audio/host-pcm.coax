// Portable native mixer carrier. Platform code owns immutable decoded 48kHz
// PCM allocations and calls this interpreter under one audio-engine lock.
#module "aethyr.audio.host.pcm";
#load "host-voice.coax";
#load "host-convolution.coax";
#load "host-dynamics.coax";
#authority;
AudioPcmHost :: struct {
 voices:[128]AudioPcmVoice;names:[128][48]u8;name_n:[128]int;
 ids:[128][1024]u8;id_n:[128]int;level:f64=1;target:f64=1;
 room:[1]AudioConvolution;dynamics:[2]AudioDynamics;frames:int;accepted:int;refused:int;
}
ap_view :: (s:[]AudioPcmHost,index:int)->[]AudioPcmVoice {return s[0].voices[index..<index+1];}
ap_name :: (s:[]AudioPcmHost,index:int)->string {return cast(string)s[0].names[index][0..<s[0].name_n[index]];}
ap_id :: (s:[]AudioPcmHost,index:int)->string {return cast(string)s[0].ids[index][0..<s[0].id_n[index]];}
ap_copy :: (source:string,dest:[]u8) {for c,i:source {dest[i]=c;}}
ap_result :: (s:[]AudioPcmHost,value:int)->int {if value<0 {s[0].refused+=1;}else {s[0].accepted+=1;}return value;}
#test "a suspended native context retains controls and beds without replaying old one-shot cues" {
 s:[1]AudioPcmHost;pcm:=[2]f32.[1,0];w:[1]f64;
 #assert ap_context_command(s[..],w[..],"tap 1 0",pcm[..],1,false)== -2;
 #assert ap_context_command(s[..],w[..],"~wind 1 0",pcm[..],1,false)==0;
 #assert ap_context_command(s[..],w[..],"!bus 0.25",pcm[..],1,false)==128;
 #assert ap_context_command(s[..],w[..],"!fetch tap",pcm[..],1,false)==128;
 #assert ap_context_command(s[..],w[..],"!room room",pcm[..],1,false)== -1;
 #assert ap_context_command(s[..],w[..],"-id",pcm[..],1,false)== -2;
 #assert ap_context_command(s[..],w[..],"tap 1 0",pcm[..],1,true)==1;
}
ap_context_command :: (s:[]AudioPcmHost,w:[]f64,line:string,pcm:[]f32,channels:int,started:bool)->int #export_c {
 e:=audio_host_parse(line);if !started && e.kind!=2 && e.kind!=4 && e.kind!=5 && e.kind!=6 {return -2;}
 return ap_command(s,w,line,pcm,channels);
}
#test "PCM command ownership reuses a named bed and addresses only the newest equal voice ID" {
 s:[1]AudioPcmHost;pcm:=[4]f32.[1,0,0,0];empty:[1]f32;w:[1]f64;
 #assert ap_command(s[..],w[..],"~wind 1 0",pcm[..],1)==0;
 #assert ap_command(s[..],w[..],"~wind 0.25 1",empty[0..<0],1)==0 && s[0].accepted==2 && s[0].voices[0].target_gain==0.25;
 #assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 same",pcm[..],1)==1;
 #assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 same",pcm[..],1)==2 && s[0].id_n[1]==0 && ap_id(s[..],2)=="same";
 #assert ap_command(s[..],w[..],"-same",empty[0..<0],1)==128 && s[0].voices[1].stop== -1 && s[0].voices[2].stop==3840 && s[0].id_n[2]==0;
 #assert ap_command(s[..],w[..],"-absent",empty[0..<0],1)== -1 && s[0].accepted==5 && s[0].refused==1;
 s[0].voices[0].active=false;#assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 x",pcm[..],1)==0;
 #assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 x",pcm[..],1)==3 && s[0].id_n[0]==0;
 #assert ap_command(s[..],w[..],"-x",empty[0..<0],1)==128 && s[0].voices[3].stop==3840;
 s[0].voices[0].active=false;#assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 y",pcm[..],1)==0;
 #assert ap_command(s[..],w[..],"-y",empty[0..<0],1)==128 && s[0].voices[0].stop==3840;
 #assert ap_command(s[..],w[..],"breeze 1 0",pcm[..],1)==4;
 #assert ap_command(s[..],w[..],"~breeze 1 0",pcm[..],1)==5 && s[0].voices[5].bed;
}
#test "PCM carrier enforces independent sixteen legacy forty-eight mixed and sixty-four bed budgets" {
 s:[1]AudioPcmHost;pcm:=[2]f32.[1,0];w:[1]f64;
 for i:0..<16 {#assert ap_command(s[..],w[..],"tap 1 0",pcm[..],1)==i;}
 #assert ap_command(s[..],w[..],"tap 1 0",pcm[..],1)== -1;
 for i:0..<48 {#assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 id",pcm[..],1)==16+i;}
 #assert ap_command(s[..],w[..],"tap 1 0 0 0 1 0 id",pcm[..],1)== -1;
 // Distinct valid names consume the independent bed budget; the SDK owns
 // their stable PCM views and names are copied before returning.
 name:=[2]u8.['a','a'];line:=[8]u8.['~','a','a',' ','1',' ','0',' '];
 for i:0..<64 {name[0]=u8('a'+i/26);name[1]=u8('a'+i%26);line[1]=name[0];line[2]=name[1];#assert ap_command(s[..],w[..],cast(string)line[..],pcm[..],1)==64+i;}
 s[0].voices[0].active=false;#assert ap_command(s[..],w[..],"~other 1 0",pcm[..],1)== -1 && s[0].refused==3;
 s[0].voices[0].active=false;#assert ap_command(s[..],w[..],"tap 1 0",pcm[..],1)==0 && s[0].id_n[0]==0;
}
#test "PCM commands refuse malformed sample views and names, preserve controls, and admit the room only once" {
 s:[1]AudioPcmHost;pcm:=[2]f32.[1,0];w:[22528]f64;
 #assert ap_command(s[..],w[..],"",pcm[..],1)== -1 && ap_command(s[..],w[..],"../x 1 0",pcm[..],1)== -1;
 #assert ap_command(s[..],w[..],"tap 1 0",pcm[0..<0],1)== -1 && s[0].refused==3;
 #assert ap_command(s[..],w[..],"!bus 0.25",pcm[..],1)==128 && s[0].target==0.25;
 #assert ap_command(s[..],w[..],"!fetch tap",pcm[0..<0],1)==128;
 #assert ap_command(s[..],w[0..<1],"!room room",pcm[..],2)== -1 && !s[0].room[0].ready;
 #assert ap_command(s[..],w[..],"!room room",pcm[..],2)==128 && s[0].room[0].ready;
 #assert ap_command(s[..],w[0..<0],"!room room",pcm[0..<0],0)==128;
 pair:[2]AudioPcmHost;#assert ap_command(pair[..],w[..],"tap 1 0",pcm[..],1)== -1 && ap_command(pair[0..<0],w[..],"tap 1 0",pcm[..],1)== -1;
}
#test "PCM blocks route legacy dry audio outside bus level and mix the authored raw stereo room return" #steps 20000000 {
 s:[1]AudioPcmHost;pcm:=[2]f32.[1,0];w:[22528]f64;output:[2048]f32;
 #assert ap_command(s[..],w[..],"tap 0.03125 -1",pcm[..],1)==0;
 #assert ap_command(s[..],w[..],"tap 0.0625 1 0 0 1 0 id",pcm[..],1)==1;
 s[0].level=0;s[0].target=0;#assert ap_block(s[..],w[..],output[..]) && output[0]==0.03125 && abs(output[1])<0.000001 && s[0].frames==1024;
 #assert ap_command(s[..],w[..],"!room room",pcm[..],1)==128;
 #assert ap_command(s[..],w[..],"tap 0.03125 -1 0 0 1 1 id",pcm[..],1)==0;
 s[0].level=1;s[0].target=1;#assert ap_block(s[..],w[..],output[..]);
 scale:=ac_scale(pcm[..],1,true);#assert abs(f64(output[1152])-(0.03125+0.03125*scale))<0.000001 && abs(f64(output[1153])-0.03125*scale)<0.000001;
 #assert !ap_block(s[0..<0],w[..],output[..]) && !ap_block(s[..],w[..],output[0..<2047]);
 s[0].room[0].head= -1;#assert !ap_block(s[..],w[..],output[..]);
}
#test "PCM room accumulation preserves later right-channel samples and adds the right dry branch" #steps 20000000 {
 s:[1]AudioPcmHost;imp:=[2]f32.[1,1];pcm:=[4]f32.[0.5,0.25,0.25,-0.125];w:[22528]f64;output:[2048]f32;
 #assert ap_command(s[..],w[..],"!room room",imp[..],2)==128;
 #assert ap_command(s[..],w[..],"tap 0.03125 0 0 0 1 1 x",pcm[..],2)==0 && ap_block(s[..],w[..],output[..]);
 scale:=ac_scale(imp[..],2,true);#assert abs(f64(output[1153])-0.25*0.03125*(1+scale))<0.000000001 && abs(f64(output[1155])+0.125*0.03125*(1+scale))<0.000000001;
}
#test "PCM dynamics link both channels and execute compressor then wall for a loud stereo signal" #steps 20000000 {
 s:[1]AudioPcmHost;pcm:[2052]f32;w:[1]f64;output:[2048]f32;for i:0..<1026 {pcm[2*i]=0.75;pcm[2*i+1]=0.5;}
 #assert ap_command(s[..],w[..],"tap 4 0 0 0 1 0 x",pcm[..],2)==0 && ap_block(s[..],w[..],output[..]);
 db:=20*log(3.0)/log(10.0);target:= -18+(db+18)/3-db;wall:=0.0;
 for frame:288..<577 {comp:=pow(10.0,target*(1-exp(-f64(frame+1)/480))/20);wall_db:=20*log(3*comp)/log(10.0);wanted:= -0.95*audio_max(wall_db+1,0);delta:=wanted-wall;wall+=audio_min(delta,0)*(1-exp(-1.0/48))+audio_max(delta,0)*(1-exp(-1.0/3840));}
 gain:=pow(10.0,target*(1-exp(-289.0/480))/20)*pow(10.0,wall/20);
 peak:=audio_min(3*gain,pow(10.0,-1.0/20));#assert output[0]==0 && output[1150]==0 && abs(f64(output[1152])-peak)<0.0000002 && abs(f64(output[1153])-peak*2/3)<0.0000002;
 #assert s[0].dynamics[0].reduction< -10;
 #assert s[0].dynamics[1].reduction<0;
 #assert output[2046]<output[1152];
 #assert abs(output[2047]/output[2046]-2.0f32/3)<0.000001;
}
#test "PCM blocks preserve both channels at every sample offset, bus easing and a complete block boundary" #steps 20000000 {
 s:[1]AudioPcmHost;pcm:[2052]f32;w:[1]f64;output:[2048]f32;
 pcm[0]=0.25;pcm[1]=0.5;pcm[2]= -0.125;pcm[3]=0.25;pcm[2046]=0.5;pcm[2047]= -0.5;pcm[2048]=1;pcm[2049]=1;
 #assert ap_command(s[..],w[..],"tap 0.03125 0",pcm[..],2)==0;
 #assert ap_command(s[..],w[..],"tap 0.015625 0 0 0 1 0 x",pcm[..],2)==1;
 #assert ap_command(s[..],w[..],"!bus 0.5",pcm[..],2)==128;
 #assert ap_block(s[..],w[..],output[..]);level:=1.0;
 #assert output[0]==0.25f32*0.03125 && output[1]==0.5f32*0.03125 && abs(f64(output[1152])-0.25*0.015625*level)<0.00000001 && abs(f64(output[1153])-0.5*0.015625*level)<0.00000001;
 level=0.5+0.5*exp(-1.0/1440);#assert output[2]== -0.125f32*0.03125 && output[3]==0.25f32*0.03125 && abs(f64(output[1154])+0.125*0.015625*level)<0.00000001 && abs(f64(output[1155])-0.25*0.015625*level)<0.00000001;
 #assert s[0].voices[0].position==1024 && s[0].voices[1].position==1024 && abs(s[0].level-(0.5+0.5*exp(-1024.0/1440)))<0.00000001;
 #assert output[2046]>0 && output[2047]<0;
}
ap_command :: (s:[]AudioPcmHost,w:[]f64,line:string,pcm:[]f32,channels:int)->int #export_c {
 if s.count!=1 {return -1;}e:=audio_host_parse(line);
 if e.kind==3 {for i:0..<128 {if s[0].voices[i].active && ap_id(s,i)==e.id {apv_stop(ap_view(s,i));s[0].id_n[i]=0;return ap_result(s,128);}}return ap_result(s,-1);}
 if e.kind==4 {s[0].target=f64(e.gain);return ap_result(s,128);}
 if (e.kind!=1 && e.kind!=2 && e.kind!=5 && e.kind!=6) || !apv_asset_name(e.name) {return ap_result(s,-1);}
 if e.kind==5 {if !s[0].room[0].ready {if !ac_open(s[0].room[..],w,1024,pcm,channels,true) {return ap_result(s,-1);}}return ap_result(s,128);}
 if e.kind==6 {return ap_result(s,128);}
 if e.kind==2 {for i:0..<128 {if s[0].voices[i].active && s[0].voices[i].bed && ap_name(s,i)==e.name {apv_bed(ap_view(s,i),e);return ap_result(s,i);}}}
 voice:=apv_open(pcm,channels,e);if !voice.active {return ap_result(s,-1);}
 count:=0;slot:=-1;for i:0..<128 {v:=s[0].voices[i];if v.active {if v.bed==voice.bed && v.mixed==voice.mixed {count+=1;}}else if slot<0 {slot=i;}}
 limit:=ifx voice.bed then 64 else ifx voice.mixed then 48 else 16;
 if count>=limit {return ap_result(s,-1);}
 for i:0..<128 {if ap_id(s,i)==e.id {s[0].id_n[i]=0;}}
 s[0].voices[slot]=voice;s[0].name_n[slot]=e.name.count;ap_copy(e.name,s[0].names[slot][..]);s[0].id_n[slot]=e.id.count;ap_copy(e.id,s[0].ids[slot][..]);return ap_result(s,slot);
}
ap_block :: (s:[]AudioPcmHost,w:[]f64,output:[]f32)->bool #export_c {
 if s.count!=1 || output.count!=2048 {return false;}
 dry:[2048]f64;direct:[2048]f64;room:[2048]f32;wet:[2048]f32;
 for i:0..<128 {v:=s[0].voices[i];if !v.active {continue;}for frame:0..<1024 {if !s[0].voices[i].active {break;}q:=apv_frame(ap_view(s,i));
  if v.mixed {dry[frame]+=q.left;dry[1024+frame]+=q.right;wet[frame]+=f32(q.wet_left);wet[1024+frame]+=f32(q.wet_right);}
  else {direct[frame]+=q.left;direct[1024+frame]+=q.right;}
 }}
 if s[0].room[0].ready {if !ac_block(s[0].room[..],w,wet[..],room[..]) {return false;}}
 for frame:0..<1024 {left:=(dry[frame]+f64(room[frame]))*s[0].level;right:=(dry[1024+frame]+f64(room[1024+frame]))*s[0].level;comp:=apc_frame(s[0].dynamics[0..<1],left,right,false);wall:=apc_frame(s[0].dynamics[1..<2],comp.left,comp.right,true);output[2*frame]=f32(wall.left+direct[frame]);output[2*frame+1]=f32(wall.right+direct[1024+frame]);s[0].level+=(s[0].target-s[0].level)*(1-exp(-1.0/1440));}
 s[0].frames+=1024;return true;
}
