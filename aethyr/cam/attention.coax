// Attention (book chapters 10, 15 and 77, GitHub #12994): one shared answer to "what am I attending
// to?" for lock-on, talk, look-at and action prompts, so no consumer rescans the world.
//
// Each target publishes typed capabilities (lock-on, talk, look-only, action), its entity generation,
// an anchor and radius, a validity flag and a priority class. Capabilities are client hints: an action
// a consumer takes still passes its ruleset's authority, and a conversation its own lifecycle gate.
//
// A receiver evaluates at most ATTN_CANDIDATES targets: range and horizontal cone, a vertical band,
// a filtered line of sight (query_clear over the colliders it is given) and, optionally, an on-screen
// check the caller supplies per target. Ranking is deterministic: priority class, then the
// angle-weighted distance, then target id. A held target is kept within the larger retention bands for
// at least `hold` ticks and through `grace` ticks of being lost; switching and release state why.
// Self, invalid, unloaded and stale-generation targets are excluded. Time is the shared fixed step.
//
//   coax/bin/coax test aethyr/cam/attention.coax --library

#module "aethyr.cam.attention";
#load "../space.coax";
#load "../query.coax";

ATTN_CANDIDATES :: 32;
ATTN_LOCK :: 1; ATTN_TALK :: 2; ATTN_LOOK :: 4; ATTN_ACTION :: 8;

AttnTarget :: struct { id: int; gen: int; caps: int; at: WorldPoint; radius: f32 = 0.4; priority: int; valid: bool = true; on_screen: bool = true; }
AttnQuery :: struct {
  self: int = -1;
  origin: WorldPoint; forward: WorldPoint;        // the receiver's eyes and its flat facing (unit)
  need: int = ATTN_LOCK;                          // the capability asked for
  acquire: f32 = 12; retain: f32 = 16;            // metres
  acquire_cos: f32 = 0.7071; retain_cos: f32 = 0.0;   // horizontal half-cones
  rise: f32 = 4;                                  // metres above or below the eyes
  screen: bool;                                   // require the caller's on-screen flag
  hold: int = 16; grace: int = 32;                // ticks
}
AttnReason :: enum u8 { none; acquired; kept; switched; out_of_range; hidden; invalid; stale; released; }
AttnState :: struct {
  target: int = -1; gen: int; since: int; seen: int;   // the held target, since when, last tick it qualified
  runner: int = -1;                                    // the next best
  reason: AttnReason;
  rejected: int; exhausted: bool;                      // targets refused this step; more than the candidate budget
}

attn_flat :: (a: WorldPoint, b: WorldPoint) -> f32 { dx := a.x - b.x; dz := a.z - b.z; return sqrt(dx * dx + dz * dz); }
// Whether target t qualifies for q within (range, cos), and its rank key (lower is better).
AttnFit :: struct { ok: bool; key: f32; why: AttnReason; }
attn_fit :: (q: AttnQuery, t: AttnTarget, c: Colliders, range: f32, cosine: f32) -> AttnFit {
  out: AttnFit;
  if t.id == q.self || !t.valid || (t.caps & q.need) == 0 { out.why = AttnReason.invalid; return out; }
  if q.screen && !t.on_screen { out.why = AttnReason.hidden; return out; }
  d := attn_flat(t.at, q.origin);
  if d - t.radius > range || abs(t.at.y - q.origin.y) > q.rise { out.why = AttnReason.out_of_range; return out; }
  if d > 0.0001 {
    a := ((t.at.x - q.origin.x) * q.forward.x + (t.at.z - q.origin.z) * q.forward.z) / d;
    if a < cosine { out.why = AttnReason.out_of_range; return out; }
    line := query_clear(c, q.origin, world_sub(t.at, q.origin), 0.99999994);
    if line.status != QueryStatus.ok || !line.clear { out.why = AttnReason.hidden; return out; }
    out.key = d * (2 - a);
  }
  out.ok = true;
  return out;
}
attn_better :: (a: AttnTarget, ka: f32, b: AttnTarget, kb: f32) -> bool {
  if a.priority != b.priority { return a.priority > b.priority; }
  if ka != kb { return ka < kb; }
  return a.id < b.id;
}
// One fixed step at tick now. switch_to asks to switch to the best other target (a key press); release
// drops the held one.
attn_step :: (s: AttnState, q: AttnQuery, targets: [] AttnTarget, c: Colliders, now: int, switch_to: bool, release: bool) -> AttnState {
  out := s; out.rejected = 0; out.exhausted = targets.count > ATTN_CANDIDATES; out.runner = -1;
  n := ifx targets.count < ATTN_CANDIDATES then targets.count else ATTN_CANDIDATES;
  if release && s.target >= 0 { out.target = -1; out.reason = AttnReason.released; return out; }
  best := -1; bk := 0.0f32; second := -1; sk := 0.0f32; held := -1; held_ok := false; held_why := AttnReason.out_of_range;
  for i: 0..<n {
    t := targets[i];
    if t.id == s.target {
      held = i;
      if t.gen != s.gen { held_why = AttnReason.stale; }
      else { f := attn_fit(q, t, c, q.retain, q.retain_cos); held_ok = f.ok; if !f.ok { held_why = f.why; } }
    }
    f := attn_fit(q, t, c, q.acquire, q.acquire_cos);
    if !f.ok { out.rejected += 1; continue; }
    if best < 0 || attn_better(t, f.key, targets[best], bk) { second = best; sk = bk; best = i; bk = f.key; }
    else if second < 0 || attn_better(t, f.key, targets[second], sk) { second = i; sk = f.key; }
  }
  if s.target >= 0 && held < 0 { held_why = AttnReason.invalid; }   // unloaded
  if s.target >= 0 && held_ok && held >= 0 {
    out.seen = now; out.reason = AttnReason.kept;
    other := ifx best >= 0 && targets[best].id != s.target then best else second;
    if other >= 0 { out.runner = targets[other].id; }
    if switch_to && other >= 0 && now - s.since >= q.hold { out.target = targets[other].id; out.gen = targets[other].gen; out.since = now; out.seen = now; out.reason = AttnReason.switched; out.runner = s.target; }
    return out;
  }
  if s.target >= 0 && held_why != AttnReason.stale && held_why != AttnReason.invalid && now - s.seen < q.grace {
    out.reason = held_why;   // lost a moment: held through the grace
    if best >= 0 && targets[best].id != s.target { out.runner = targets[best].id; }
    return out;
  }
  if best >= 0 {
    out.target = targets[best].id; out.gen = targets[best].gen; out.since = now; out.seen = now;
    out.reason = ifx s.target >= 0 then AttnReason.switched else AttnReason.acquired;
    if second >= 0 { out.runner = targets[second].id; }
    return out;
  }
  out.target = -1; out.reason = ifx s.target >= 0 then held_why else AttnReason.none;
  return out;
}

// ---- checks: an independent brute-force ranking over the same filters
attn_oracle_best :: (q: AttnQuery, ts: [] AttnTarget, c: Colliders) -> int {
  best := -1; bp := -1000; bk := 1e9f32;
  for i: 0..<ts.count {
    t := ts[i];
    if t.id == q.self || !t.valid || (t.caps & q.need) == 0 { continue; }
    dx := t.at.x - q.origin.x; dz := t.at.z - q.origin.z; d := sqrt(dx * dx + dz * dz);
    if d - t.radius > q.acquire || abs(t.at.y - q.origin.y) > q.rise { continue; }
    a := 1.0f32; if d > 0.0001 { a = (dx * q.forward.x + dz * q.forward.z) / d; }
    if a < q.acquire_cos { continue; }
    if !query_clear(c, q.origin, world_sub(t.at, q.origin), 0.99999994).clear { continue; }
    k := ifx d > 0.0001 then d * (2 - a) else 0.0f32;
    if t.priority > bp || (t.priority == bp && (k < bk || (k == bk && t.id < ts[best].id))) { best = i; bp = t.priority; bk = k; }
  }
  return ifx best >= 0 then ts[best].id else -1;
}
attn_q :: () -> AttnQuery { return AttnQuery.{origin = world_point(0, 1.6, 0), forward = world_point(0, 0, 1)}; }

#forall "attention ranks like an independent brute-force oracle" k: 0..<200 #steps 400000000 {
  c: Colliders; c.ground = -10;
  ts: [6] AttnTarget;
  for i: 0..<6 {
    h := (k * 7919 + i * 104729) % 1000;
    ts[i] = AttnTarget.{id = 10 + i, gen = 1, caps = ifx h % 5 == 0 then ATTN_TALK else ATTN_LOCK, at = world_point(f32(h % 31) - 15, 1.6 + f32(h % 3) - 1, f32((h / 31) % 25) - 5), priority = (h / 7) % 2};
  }
  ts[k % 6].valid = k % 4 != 0;
  wall := [6] f32.[-2, 0, 3, 2, 4, 3.5];
  if k % 3 == 0 { c.boxes = wall[..]; }
  s := attn_step(AttnState.{}, attn_q(), ts[..], c, 100, false, false);
  #assert s.target == attn_oracle_best(attn_q(), ts[..], c);
}

#test "acquire, retain in the larger band, hold, grace, explicit switch, despawn and release" {
  c: Colliders; c.ground = -10; q := attn_q();
  ts := [2] AttnTarget.[AttnTarget.{id = 1, gen = 1, caps = ATTN_LOCK | ATTN_TALK, at = world_point(0, 1.6, 5)},
                        AttnTarget.{id = 2, gen = 1, caps = ATTN_LOCK, at = world_point(1, 1.6, 8)}];
  s := attn_step(AttnState.{}, q, ts[..], c, 0, false, false);
  #assert s.target == 1 && s.reason == AttnReason.acquired && s.runner == 2;
  // it walks out of the acquire band (12 m) but stays in the retain band (16 m): kept
  ts[0].at = world_point(0, 1.6, 14);
  s = attn_step(s, q, ts[..], c, 5, false, false);
  #assert s.target == 1 && s.reason == AttnReason.kept;
  // beside you (outside the acquire cone, inside the retain half-plane): kept
  ts[0].at = world_point(5, 1.6, 0.5);
  s = attn_step(s, q, ts[..], c, 6, false, false);
  #assert s.target == 1;
  // a switch before the hold is refused, after it taken
  s = attn_step(s, q, ts[..], c, 10, true, false); #assert s.target == 1;
  s = attn_step(s, q, ts[..], c, 16, true, false); #assert s.target == 2 && s.reason == AttnReason.switched && s.runner == 1;
  // lost behind a wall: held through the grace, then given up for the best other
  wall := [6] f32.[-3, 0, 4, 3, 4, 4.5]; c.boxes = wall[..];
  ts[0].at = world_point(0, 1.6, 2);
  s = attn_step(s, q, ts[..], c, 20, false, false); #assert s.target == 2 && s.reason == AttnReason.hidden;
  s = attn_step(s, q, ts[..], c, 47, false, false); #assert s.target == 2;
  s = attn_step(s, q, ts[..], c, 48, false, false); #assert s.target == 1 && s.reason == AttnReason.switched;
  // a despawned and respawned target (new generation) is stale at once
  ts[0].gen = 2;
  s = attn_step(s, q, ts[..], c, 49, false, false); #assert s.target == 1 && s.gen == 2;   // re-acquired as the new one
  // release
  s = attn_step(s, q, ts[..], c, 50, false, true); #assert s.target == -1 && s.reason == AttnReason.released;
  // talk asks only targets that can talk; self is never one
  tq := q; tq.need = ATTN_TALK;
  c.boxes = wall[0..<0];
  #assert attn_step(AttnState.{}, tq, ts[..], c, 60, false, false).target == 1;
  tq.self = 1;
  #assert attn_step(AttnState.{}, tq, ts[..], c, 60, false, false).target == -1;
  // more than the candidate budget: flagged, and only the first ATTN_CANDIDATES considered
  many: [40] AttnTarget;
  for i: 0..<40 { many[i] = AttnTarget.{id = 100 + i, gen = 1, caps = ATTN_LOCK, at = world_point(0, 1.6, 20 - f32(i) * 0.5)}; }
  m := attn_step(AttnState.{}, q, many[..], c, 70, false, false);
  #assert m.exhausted && m.target == 100 + 31;
}
