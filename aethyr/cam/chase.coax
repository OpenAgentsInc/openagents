// The follow camera a zone wires (GitHub #13087): one step of the orbit behind you from the frame's
// look, keys and walk; its room before the ground and the trunks; a drag's and the wheel's turn and
// zoom; and mouselook's over-the-shoulder framing. A zone passes its own inputs, its land (the
// CamGround ring it fills from its own height function) and its trunks (cam_trunk), and keeps nothing
// of the camera's own: Everglade II (everglade/client/client.coax e2_chase_step) and Experimental's lab
// (fivelab.coax lab_chase_step) wire it.
//
// Two looks share the step. With look_up (Everglade II's centred mode, modes.coax) a drag's tilt goes
// through the mode's pitch range, up past the horizon, and a look up holds until the walk's own
// recentring; the eye then settles on the ground ring and the trunks (cam_chase_settle). Without it
// the drag and the keys tilt through the shared orbit's range, and the eye keeps above a level floor
// (cam_chase_floor).
//
//   coax/bin/coax test aethyr/cam/chase.coax --library

#load "camera.coax";
#load "../core/points.coax";
#load "modes.coax";

CAM_DRAG_TURN :: 0.0055;    // radians a CSS pixel of a mouse drag turns or tilts the view
CAM_WHEEL_ZOOM :: 0.006;    // metres of zoom a wheel unit asks for (down is out)
CAM_WHEEL_MAX :: 400.0;     // the most of one wheel event that counts
CAM_SHOULDER :: 0.7;        // metres the over-the-shoulder camera sits right of you (mouselook, the bow)
CAM_LIFT :: 0.55;           // and above, in mouselook, so you stand below and left of the reticle
CAM_TRUNKS :: 64;           // trunks the camera keeps in front of, three spheres each
CAM_TRUNK_REACH :: 100.0;   // square metres: trunks further than 10 m from the pivot don't count

// A drag of (dx, dy) device pixels at device pixel ratio k: the look's turn and tilt, in radians (a
// drag right turns right, a drag up looks up).
cam_drag :: (dx: f32, dy: f32, k: f32) -> [2] f32 { return [2] f32.[-(dx / k * f32(CAM_DRAG_TURN)), -(dy / k * f32(CAM_DRAG_TURN))]; }
// The wheel (CSS px, down is out), at most CAM_WHEEL_MAX of it.
cam_wheel :: (o: Orbit, dy: f32) -> Orbit {
  d := ifx dy > f32(CAM_WHEEL_MAX) then f32(CAM_WHEEL_MAX) else ifx dy < -f32(CAM_WHEEL_MAX) then -f32(CAM_WHEEL_MAX) else dy;
  return verse_orbit_zoom(o, d * f32(CAM_WHEEL_ZOOM));
}
// A thumb's pinch (aethyr/core/sticks.coax), as the wheel.
cam_pinch :: (o: Orbit, zoom: f32) -> Orbit { if zoom == 0 { return o; } return verse_orbit_zoom(o, zoom * f32(CAM_WHEEL_ZOOM)); }

// Mouselook's framing: the eye and its aim both move CAM_SHOULDER right and CAM_LIFT up, as far as
// share (its fade) has come.
cam_shoulder_shot :: (shot: Shot, share: f32) -> Shot {
  m := share; if m <= 0 { return shot; }
  fx := shot.at.x - shot.eye.x; fz := shot.at.z - shot.eye.z; l := sqrt(fx * fx + fz * fz); if l < 0.0001 { return shot; }
  rx := -fz / l * f32(CAM_SHOULDER) * m; rz := fx / l * f32(CAM_SHOULDER) * m; up := f32(CAM_LIFT) * m;
  t := shot;
  t.eye = v3(shot.eye.x + rx, shot.eye.y + up, shot.eye.z + rz); t.at = v3(shot.at.x + rx, shot.at.y + up, shot.at.z + rz);
  return t;
}

// What moves the follow camera this frame.
CamChaseIn :: struct {
  look_yaw: f32; look_pitch: f32;   // a drag's or a thumb's look since the last frame (radians)
  turn: f32; tilt: f32; zoom: f32;  // the held keys: turn (1 left), tilt (1 up), zoom (1 out)
  feet: Point; heading: f32; moving: bool;   // you
  held: bool;                       // the mouse holds the tilt (mouselook): the walk never eases it back
  behind: bool; behind_heading: f32;   // ease round behind an autowalk (or a run) going this way
  look_up: bool;                    // the mode's look up past the horizon (Everglade II's centred follow)
}
// The orbit after the frame's look, keys and walk: before its room (cam_chase_settle, cam_chase_floor).
cam_chase_orbit :: (m: CamMode, orbit: Orbit, in: CamChaseIn, dt: f32) -> Orbit {
  o := orbit;
  if in.behind {
    turn := wrap_angle(in.behind_heading - o.yaw);
    o.yaw = wrap_angle(o.yaw + turn * (ifx dt * 1.5 < 1 then dt * 1.5 else 1.0f32));
  }
  if !in.look_up {
    o = verse_orbit_look(o, in.look_yaw, in.look_pitch);
    o = verse_orbit_keys(o, in.turn, in.tilt, dt);
    if in.zoom != 0 { o = verse_orbit_zoom(o, in.zoom * 6 * lo(dt, 0.1)); }
    if in.held { o.idle = 0; }
    return verse_orbit_follow(o, in.feet, in.heading, in.moving, dt);
  }
  // the turn is the shared orbit's; the tilt is the mode's, up past the horizon
  o = verse_orbit_look(o, in.look_yaw, 0);
  o = verse_orbit_keys(o, in.turn, 0, dt);
  tilt := in.look_pitch + in.tilt * f32(FREE_KEY_TURN) * 0.6 * (ifx dt < 0.25 then dt else 0.25f32);
  if tilt != 0 { o.pitch = cam_pitch(m, o, o.pitch - tilt); o.idle = 0; }
  if in.zoom != 0 { o = verse_orbit_zoom(o, in.zoom * 6 * (ifx dt < 0.1 then dt else 0.1f32)); }
  p0 := o.pitch;
  if in.held { o.idle = 0; }
  o = verse_orbit_follow(o, in.feet, in.heading, in.moving, dt);
  // the shared follow eases a look past its own range back into it; here a look up holds until the
  // walk's own recentring, a while after the last look
  if p0 < f32(FREE_PITCH_MIN) && !(in.moving && o.idle >= f32(FREE_RECENTRE_AFTER)) { o.pitch = cam_pitch(m, o, p0); }
  return o;
}

// Three spheres up a trunk at (x, z), radius r, from half a metre under the pivot: added to spheres
// (four numbers each) while it holds fewer than CAM_TRUNKS trunks and the trunk is within reach of the
// pivot. Returns the trunks held.
cam_trunk :: (spheres: [] f32, n: int, pivot: Point, x: f32, z: f32, r: f32) -> int {
  if n >= CAM_TRUNKS || (n + 1) * 12 > spheres.count { return n; }
  if (x - pivot.x) * (x - pivot.x) + (z - pivot.z) * (z - pivot.z) > f32(CAM_TRUNK_REACH) { return n; }
  for k: 0..<3 { q := (n * 3 + k) * 4; spheres[q] = x; spheres[q + 1] = pivot.y - 0.5 + f32(k) * 1.6; spheres[q + 2] = z; spheres[q + 3] = r; }
  return n + 1;
}

// The centred follow's eye for orbit o over the ground ring g and before the trunks: the orbit
// limited to its room, the eye's pitch and the press.
CamChaseOut :: struct { orbit: Orbit; eye_pitch: f32; press: f32; }
cam_chase_settle :: (m: CamMode, g: [] CamGround, o: Orbit, spheres: [] f32, dt: f32) -> CamChaseOut {
  c := cam_centred(m, g, o, spheres);
  return CamChaseOut.{orbit = verse_orbit_limit(o, c.room, dt), eye_pitch = c.eye_pitch, press = c.press};
}
// The orbit kept clear metres over a level floor at y 0 along its ray.
cam_chase_floor :: (o: Orbit, clear: f32, dt: f32) -> Orbit {
  ray := verse_orbit_ray(o);
  room := ray.far;
  if ray.dir.y < -0.0001 { room = lo(room, (ray.from.y - clear) / -ray.dir.y); }
  return verse_orbit_limit(o, room, dt);
}

#test "a drag turns and tilts by CAM_DRAG_TURN a pixel; the wheel zooms at most CAM_WHEEL_MAX of an event" {
  d := cam_drag(100, -50, 2);
  #assert abs(d[0] + 0.275) < 0.00001 && abs(d[1] - 0.1375) < 0.00001;
  o: Orbit; a := cam_wheel(o, 5000); b := cam_wheel(o, f32(CAM_WHEEL_MAX));
  #assert a.want == b.want && a.want > o.want && cam_pinch(o, 0).want == o.want;
}
#test "mouselook frames you below and left of the reticle, as far as its fade has come" {
  shot := Shot.{eye = v3(0, 2, 4), at = v3(0, 1.5, 0)};   // looking down -z
  t := cam_shoulder_shot(shot, 1);
  #assert t.eye.x > 0.6 && t.at.x > 0.6 && t.eye.y > 2.5 && abs(t.eye.z - 4) < 0.001;
  #assert cam_shoulder_shot(shot, 0).eye.x == 0 && abs(cam_shoulder_shot(shot, 0.5).eye.x - 0.35) < 0.0001;
}
#test "trunks: three spheres each, within reach of the pivot, at most CAM_TRUNKS" {
  sp: [CAM_TRUNKS * 12] f32; pv := v3(0, 2, 0);
  n := cam_trunk(sp[..], 0, pv, 3, 4, 0.5);
  #assert n == 1 && sp[1] == 1.5 && abs(sp[5] - 3.1) < 0.00001 && abs(sp[9] - 4.7) < 0.00001 && sp[3] == 0.5;
  #assert cam_trunk(sp[..], n, pv, 9, 9, 0.5) == 1;   // too far
  for i: 0..<100 { n = cam_trunk(sp[..], n, pv, 1, 1, 0.3); }
  #assert n == CAM_TRUNKS;
}
#test "the follow step: a look up holds past the horizon until the walk recentres; the floor keeps the eye up" #steps 200000000 {
  m := CamMode.{id = CamModeId.follow};
  o := verse_orbit_start(v3(0, 0, 0), 0);
  in: CamChaseIn; in.look_up = true; in.feet = v3(0, 0, 0); in.look_pitch = 1.5;
  o = cam_chase_orbit(m, o, in, 1.0f32 / 30);
  #assert o.pitch < f32(FREE_PITCH_MIN) && o.idle < 0.1;
  in.look_pitch = 0;
  for i: 0..<10 { o = cam_chase_orbit(m, o, in, 1.0f32 / 30); }
  #assert o.pitch < f32(FREE_PITCH_MIN);   // standing, the look up holds
  in.moving = true; for i: 0..<200 { o = cam_chase_orbit(m, o, in, 1.0f32 / 30); }
  #assert o.pitch > f32(FREE_PITCH_MIN);   // walking, it recentres
  g: [1] CamGround; cells: [7000] int;
  n := cam_ground_next(g[..], o.pivot.x, o.pivot.z, 13, cells[..]);
  for k: 0..<n { cam_ground_put(g[..], cells[k * 2], cells[k * 2 + 1], 0); }
  sp: [12] f32; out := cam_chase_settle(m, g[..], o, sp[0..<0], 1.0f32 / 30);
  #assert out.orbit.shown <= verse_orbit_ray(o).far && out.press == 0;
  // the shared range: a look down through the floor pulls the eye in over it
  q := verse_orbit_start(v3(0, 0, 0), 0); q.pitch = -0.5;
  f := cam_chase_floor(q, 0.3, 1.0f32 / 30); r := verse_orbit_ray(f);
  #assert r.from.y + r.dir.y * f.shown >= 0.299;
}
