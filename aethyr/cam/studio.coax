// Character Create's cameras (GitHub #13087): the studio that looks at your character from the south,
// the run from it into the world (a sweep behind you, then the follow camera through a cinematic
// hand-back, handback.coax), the lens that frames you in the gap a phone's wardrobe leaves, and the
// walk behind you down the road. Everglade II's Character Create (everglade/client/create.coax) and
// Experimental's (charactercreator.coax, charactercreator-walk.coax) wire them. A zone holds the eye
// over its own land: these return shots before that (cam_hold_eye, cam_studio_shot).
//
//   coax/bin/coax test aethyr/cam/studio.coax --library

#load "camera.coax";
#load "../core/points.coax";
#load "handback.coax";

// 0 to 1, eased in and out (smoothstep).
cam_smooth :: (v: f32) -> f32 { t := ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v; return t * t * (3 - 2 * t); }

// ---- the studio
// The studio camera from your feet: south of you, looking north at you, dist metres out and pitch
// radians up; pan_x and pan_y slide it across the view. Closer in it rises toward your face.
CamStudio :: struct { eye: Point; dir: Point; }
cam_studio :: (feet: Point, dist: f32, pitch: f32, pan_x: f32, pan_y: f32) -> CamStudio {
  c := (2.2 - dist) / 1.55; close := ifx c < 0 then 0.0f32 else ifx c > 1 then 1.0f32 else c;
  target := 1.2 + 0.58 * close;
  ey := target - 0.4 + 0.50 * close + sin(pitch - 0.1) * dist; ez := cos(pitch - 0.1) * dist;
  fy := target - ey; fz := -ez; fl := sqrt(fy * fy + fz * fz); fy /= fl; fz /= fl;
  return CamStudio.{eye = v3(feet.x + pan_x, feet.y + ey + pan_y * (-fz), feet.z + ez + pan_y * fy), dir = v3(0, fy, fz)};
}
// Its shot with the eye held at floor_y or over (the land under the eye and its clearance).
cam_studio_shot :: (st: CamStudio, floor_y: f32) -> Shot {
  eye := st.eye; if eye.y < floor_y { eye.y = floor_y; }
  return Shot.{eye = eye, at = v3(eye.x, eye.y + st.dir.y * 10, eye.z + st.dir.z * 10)};
}
// A shot's eye held at floor_y or over; the aim stays.
cam_hold_eye :: (s: Shot, floor_y: f32) -> Shot { t := s; if t.eye.y < floor_y { t.eye.y = floor_y; } return t; }

// ---- the run
// The run's camera at share u of it, relative to you and your heading: turned `turn` rad off straight
// behind you, `dist` m back, `rise` m up. A three-quarter view sweeps across behind you and back,
// pulling out and craning up midway, and comes in to the follow camera's distance and height.
CamRunFrame :: struct { turn: f32; dist: f32; rise: f32; }
cam_run_frame :: (u: f32) -> CamRunFrame {
  a := (1 - u) * 0.6 * cos(3 * 3.14159265 * u); arc := sin(3.14159265 * u);
  return CamRunFrame.{turn = a, dist = lerp(4.2, f32(FREE_DIST), u) + 2.5 * arc, rise = lerp(1.7, f32(FREE_HEIGHT) + 0.9, u) + 2.2 * arc};
}
cam_run_frame_shot :: (feet: Point, yaw: f32, f: CamRunFrame, look: Point) -> Shot {
  h := yaw + f.turn;
  return Shot.{eye = v3(feet.x - sin(h) * f.dist, feet.y + f.rise, feet.z - cos(h) * f.dist), at = look};
}
// The run's look: 1.3 m up, 3.5 m on the way you run.
cam_run_look :: (feet: Point, yaw: f32) -> Point { return v3(feet.x + sin(yaw) * 3.5, feet.y + 1.3, feet.z + cos(yaw) * 3.5); }
// The run's track t seconds in, before the land holds its eye: over the first `swing` s it swings from
// the studio's last shot round behind you into the run's start, then plays the run over `run` s.
cam_run_track :: (t: f32, studio: Shot, feet: Point, yaw: f32, swing: f32, run: f32) -> Shot {
  if t < swing {
    // the studio's framing in the track's terms, eased into the track's start
    st := studio; vx := st.eye.x - feet.x; vz := st.eye.z - feet.z;
    from := CamRunFrame.{turn = wrap_angle(atan2(-vx, -vz) - yaw), dist = sqrt(vx * vx + vz * vz), rise = st.eye.y - feet.y};
    if from.dist < 1 { from.dist = 1; }
    to := cam_run_frame(0); e := cam_smooth(t / swing);
    look_to := cam_run_look(feet, yaw);
    look := v3(lerp(st.at.x, look_to.x, e), lerp(st.at.y, look_to.y, e), lerp(st.at.z, look_to.z, e));
    return cam_run_frame_shot(feet, yaw, CamRunFrame.{turn = from.turn + wrap_angle(to.turn - from.turn) * e, dist = lerp(from.dist, to.dist, e), rise = lerp(from.rise, to.rise, e)}, look);
  }
  u := (t - swing) / run; u = ifx u < 0 then 0.0f32 else ifx u > 1 then 1.0f32 else u;
  return cam_run_frame_shot(feet, yaw, cam_run_frame(u), cam_run_look(feet, yaw));
}
// What the run shows t seconds in, from its held track: the swing as it is, the run through the
// cinematic `cut` (cam_cut_enter'd with the retain outcome as it began); at its end the orbit turns to
// look the way the run looked, then the hand-back eases from the run's framing, still on you, to the
// follow camera `chase`. handed: the follow camera and the keys are yours.
CamRunShown :: struct { shot: Shot; orbit: Orbit; handed: bool; }
cam_run_show :: (cut: [] CamCut, track: Shot, chase: Shot, t: f32, swing: f32, run: f32, orbit: Orbit, face: f32) -> CamRunShown {
  out := CamRunShown.{shot = track, orbit = orbit};
  if t < swing { return out; }
  if t < swing + run { out.shot = cam_cut_play(cut, track, t); return out; }
  if cam_cut_live(cut[0]) && cut[0].phase != CamCutPhase.handing { _p := cam_cut_play(cut, track, t); out.orbit = cam_cut_end(cut, orbit, face, swing + run); return out; }
  out.shot = cam_cut_hand_on(cut, track, chase, t);
  out.handed = !cam_cut_live(cut[0]);
  return out;
}

// ---- the lens
// The studio's lens on a phone: you stand in the gap the wardrobe leaves (held upright, between the
// card and the sheet; held sideways, between them side by side), easing by e to the follow camera's
// focal length and centre (focal, cx, cy) as the camera swings behind you.
cam_gap_lens :: (focal: f32, cx: f32, cy: f32, wide: bool, card_x1: f32, card_y1: f32, sheet_x0: f32, sheet_y0: f32, e: f32) -> [3] f32 {
  f0 := focal * 0.5; x0 := cx; y0 := cy;
  if wide { x0 = (card_x1 + sheet_x0) * 0.5; f0 = (sheet_x0 - card_x1) * 2.4; }
  else { gap := sheet_y0 - card_y1; f0 = gap * 1.3; y0 = (card_y1 + sheet_y0) * 0.5; }
  if f0 < focal * 0.5 { f0 = focal * 0.5; }
  return [3] f32.[lerp(f0, focal, e), lerp(x0, cx, e), lerp(y0, cy, e)];
}

// ---- the walk
// Behind a walker and above, looking a little past it down the road: the eye 2.1 m over `back` (a
// point behind it on the road) looking at 1.3 m over `ahead`, eased by b from the shot it started
// from (eye0, fwd0, a unit forward). The land holds the eye after.
CamWalkView :: struct { eye: [3] f32; fwd: [3] f32; }
cam_walk_view :: (eye0: [3] f32, fwd0: [3] f32, back: [3] f32, ahead: [3] f32, b: f32) -> CamWalkView {
  eye := [3] f32.[back[0], back[1] + 2.1, back[2]]; target := [3] f32.[ahead[0], ahead[1] + 1.3, ahead[2]];
  fwd: [3] f32;
  for i: 0..<3 { fwd[i] = target[i] - eye[i]; } fl := sqrt(fwd[0] * fwd[0] + fwd[1] * fwd[1] + fwd[2] * fwd[2]);
  for i: 0..<3 { eye[i] = eye0[i] + (eye[i] - eye0[i]) * b; fwd[i] = fwd0[i] + (fwd[i] / fl - fwd0[i]) * b; }
  fl = sqrt(fwd[0] * fwd[0] + fwd[1] * fwd[1] + fwd[2] * fwd[2]); for i: 0..<3 { fwd[i] /= fl; }
  return CamWalkView.{eye = eye, fwd = fwd};
}
// A level camera's right (forward x up) and up (right x forward) for a unit forward.
cam_right_up :: (fwd: [3] f32) -> [2][3] f32 {
  rl := sqrt(fwd[2] * fwd[2] + fwd[0] * fwd[0]); r := [3] f32.[-fwd[2] / rl, 0, fwd[0] / rl];
  up := [3] f32.[r[1] * fwd[2] - r[2] * fwd[1], r[2] * fwd[0] - r[0] * fwd[2], r[0] * fwd[1] - r[1] * fwd[0]];
  return [2][3] f32.[r, up];
}

#test "the studio looks north at you from the south, rises closer in, and holds its eye over the floor" {
  st := cam_studio(v3(1, 2, 3), 3, 0.3, 0, 0);
  #assert st.eye.z > 3 + 2 && st.eye.y > 2 && st.dir.z < 0 && abs(st.dir.y * st.dir.y + st.dir.z * st.dir.z - 1) < 0.0001;
  near := cam_studio(v3(1, 2, 3), 0.65, 0.3, 0, 0); #assert near.eye.y > st.eye.y - 1 && near.eye.z < st.eye.z;
  s := cam_studio_shot(st, 100); #assert s.eye.y == 100 && abs(s.at.y - (100 + st.dir.y * 10)) < 0.0001;
  #assert cam_hold_eye(s, 0).eye.y == 100 && cam_hold_eye(s, 200).at.y == s.at.y;
}
#test "the run swings from the studio, sweeps behind you and ends at the follow distance; the show hands back" #steps 200000000 {
  feet := v3(0, 0, 0); studio := Shot.{eye = v3(0, 1.5, 3), at = v3(0, 1.4, -7)};
  first := cam_run_track(0, studio, feet, 3.14159265, 3, 20);
  #assert length(sub(first.eye, studio.eye)) < 0.01;
  end := cam_run_frame(1); #assert abs(end.turn) < 0.0001 && abs(end.dist - f32(FREE_DIST)) < 0.001;
  last := first;
  for i: 1..<400 { t := f32(i) * 0.06; s := cam_run_track(t, studio, feet, 3.14159265, 3, 20); #assert length(sub(s.eye, last.eye)) < 0.6; last = s; }
  o := verse_orbit_start(feet, 3.14159265);
  cut: [1] CamCut; cut[0] = cam_cut_enter(studio, o, 0, 0, CamOutcome.retain); cut[0].hand = 1.5;
  chase := Shot.{eye = v3(0, 2, 4), at = v3(0, 1, -4)};
  handed := false; t := 0.0f32;
  while t < 30 && !handed { tr := cam_run_track(t, studio, feet, 3.14159265, 3, 20); r := cam_run_show(cut[..], tr, chase, t, 3, 20, o, 3.14159265); o = r.orbit; handed = r.handed; t += 0.016; }
  #assert handed && t > 23;
}
#test "a phone's lens frames you in the wardrobe's gap and eases to the follow camera's" {
  up := cam_gap_lens(600, 195, 422, false, 390, 300, 0, 500, 0);
  #assert up[0] == 300 && up[2] == 400;
  wide := cam_gap_lens(600, 422, 195, true, 200, 0, 700, 0, 0); #assert wide[0] == 1200 && wide[1] == 450;
  done := cam_gap_lens(600, 195, 422, false, 390, 300, 0, 500, 1); #assert done[0] == 600 && done[1] == 195 && done[2] == 422;
}
#test "the walk eases from where it started to behind the walker, a unit forward with a level right" {
  v := cam_walk_view([3] f32.[0, 2, 5], [3] f32.[0, 0, -1], [3] f32.[0, 0, -4], [3] f32.[0, 0, -11], 0);
  #assert v.eye[2] == 5 && abs(v.fwd[2] + 1) < 0.0001;
  w := cam_walk_view([3] f32.[0, 2, 5], [3] f32.[0, 0, -1], [3] f32.[0, 0, -4], [3] f32.[0, 0, -11], 1);
  #assert abs(w.eye[1] - 2.1) < 0.0001 && abs(w.eye[2] + 4) < 0.0001 && w.fwd[1] < 0;
  ru := cam_right_up(w.fwd); #assert ru[0][1] == 0 && ru[1][1] > 0.9;
}
