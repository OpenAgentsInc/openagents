// Shared, versioned Quaternius player appearance. No UI, clocks, geometry or renderer owners.
#module "aethyr.characterappearance";
#load "../everglade/scene/charactercreator-parts.coax";
CharacterAppearance :: struct {
 configured:bool;female:bool;worn:[40]bool;piece:int=18;outfit:int=2;hood:bool;hair:int;beard:bool;
 dye:int=8;skin:int=1;hair_color:int;eye_color:int;variant:int;pose:int;
 klass:int= -1;   // the SRD 5.2.1 class chosen (0 Barbarian ... 11 Wizard, everglade/shared/fivebar.coax FB_CL_*), -1 none: a CC1 or CC2 record
 level:int=1;     // its level, 1 to CA_LEVELS (CC4; a CC3 record is level 1)
 source_first:[80]int;source_count:[80]int;source_word:[80]int;source_n:int;
}
CaLook :: struct {head:int;hair:int=-1;extra:int=-1;skin:[3]f32;hair_rgb:[3]f32;dye:[4]f32;variant:int;}
#test "appearance codec round trips the complete chosen character and refuses corrupt bytes" {
 a:[1]CharacterAppearance;a[0].female=true;ca_preset(a[..],2);a[0].eye_color=4;a[0].dye=1;b:[64]u8;n:=ca_save(a[0],b[..]);c:[1]CharacterAppearance;
 #assert ca_restore(c[..],cast(string)b[0..<n]) && c[0].female && c[0].eye_color==4 && c[0].worn[29];
 for i:0..<56 {old:=b[i];b[i]='x';#assert !ca_restore(c[..],cast(string)b[0..<n]) && c[0].eye_color==4;b[i]=old;}
}
#test "appearance codec: a class makes the record CC3, which keeps it; CC2 restores with none (#13024)" {
 a:[1]CharacterAppearance;a[0].female=true;ca_preset(a[..],1);a[0].eye_color=2;b:[64]u8;
 #assert ca_save(a[0],b[..])==56 && b[2]=='2';
 for k:0..<CA_CLASSES {
  a[0].klass=k;n:=ca_save(a[0],b[..]);c:[1]CharacterAppearance;
  #assert n==57 && b[2]=='3' && ca_restore(c[..],cast(string)b[0..<n]) && c[0].klass==k && c[0].female && c[0].eye_color==2;
 }
 n:=ca_save(a[0],b[..]);c:[1]CharacterAppearance;c[0].klass=5;
 b[56]='m';#assert !ca_restore(c[..],cast(string)b[0..<n]) && c[0].klass==5;
 b[56]='a';b[2]='2';#assert !ca_restore(c[..],cast(string)b[0..<n]);
 a[0].klass= -1;n=ca_save(a[0],b[..]);#assert n==56 && ca_restore(c[..],cast(string)b[0..<n]) && c[0].klass== -1;
}
#test "appearance codec: a level past 1 makes the record CC4; CC3 restores at level 1 (#13046)" {
 a:[1]CharacterAppearance;ca_preset(a[..],1);a[0].klass=4;b:[64]u8;c:[1]CharacterAppearance;
 #assert ca_save(a[0],b[..])==57 && b[2]=='3' && ca_restore(c[..],cast(string)b[0..<57]) && c[0].level==1;
 for l:2..<CA_LEVELS+1 {
  a[0].level=l;n:=ca_save(a[0],b[..]);
  #assert n==58 && b[2]=='4' && b[57]==cast(u8)('0'+l) && ca_restore(c[..],cast(string)b[0..<n]) && c[0].klass==4 && c[0].level==l;
 }
 n:=ca_save(a[0],b[..]);
 for bad:[4]u8.['1','7','0','a'] {b[57]=bad;c[0].level=3;#assert !ca_restore(c[..],cast(string)b[0..<n]) && c[0].level==3;}
 b[57]='5';b[2]='3';#assert !ca_restore(c[..],cast(string)b[0..<n]);
 // no class keeps no level: CC2
 a[0].klass= -1;#assert ca_save(a[0],b[..])==56;
}
// The dyes are display-space colours. Both Character Create and the film apply them in display
// space, through one shared cc_albedo (apps/openagents-web/gpu/everglade2.coax), so a dye looks the
// same in both. The last dye is white: no dye.
CA_DYES :: [9][3]f32.[[3]f32.[0.06,0.22,0.18],[3]f32.[0.38,0.04,0.065],[3]f32.[0.06,0.12,0.38],[3]f32.[0.72,0.65,0.48],[3]f32.[0.29,0.08,0.34],[3]f32.[0.055,0.055,0.07],[3]f32.[0.65,0.29,0.05],[3]f32.[0.22,0.36,0.46],[3]f32.[1,1,1]];
#test "dyes are display-space colours in range and the last is no dye" {
 for d:CA_DYES {for c:d {#assert c>=0 && c<=1;}}
 #assert CA_DYES[8][0]==1 && CA_DYES[8][1]==1 && CA_DYES[8][2]==1;
}
CA_SKINS :: [6][3]f32.[[3]f32.[1,0.94,0.87],[3]f32.[0.91,0.79,0.67],[3]f32.[0.76,0.6,0.46],[3]f32.[0.61,0.43,0.31],[3]f32.[0.43,0.28,0.2],[3]f32.[0.28,0.17,0.13]];
CA_HAIRS :: [6][3]f32.[[3]f32.[0.08,0.05,0.035],[3]f32.[0.29,0.13,0.055],[3]f32.[0.65,0.42,0.15],[3]f32.[0.48,0.085,0.035],[3]f32.[0.62,0.65,0.69],[3]f32.[0.23,0.075,0.3]];
CA_EYES :: [6][3]f32.[[3]f32.[0.24,0.1,0.035],[3]f32.[0.08,0.35,0.75],[3]f32.[0.06,0.48,0.23],[3]f32.[0.8,0.48,0.06],[3]f32.[0.45,0.5,0.56],[3]f32.[0.45,0.12,0.65]];
// CC3 (#13024) is CC2 with the class after it: 57 bytes, the class a letter ('a' Barbarian to 'l'
// Wizard). A record with no class is written as CC2, 56 bytes, as before. CC4 (#13046) is CC3 with
// the class's level after it, a digit '2' to '6': 58 bytes. Level 1 is written as CC3, as before.
CA_CLASSES :: 12;
CA_LEVELS :: 6;
ca_size :: (s:CharacterAppearance)->int {return ifx s.klass>=0 && s.klass<CA_CLASSES then (ifx s.level>1 && s.level<=CA_LEVELS then 58 else 57) else 56;}
ca_save :: (s:CharacterAppearance,out:[]u8)->int {
  n:=ca_size(s);
  if out.count<n {return 0;}
  out[0]='C';out[1]='C';out[2]=ifx n==58 then '4' else ifx n==57 then '3' else '2';
  v:=[10]int.[ifx s.female then 1 else 0,s.outfit,ifx s.hood then 1 else 0,s.hair,ifx s.beard then 1 else 0,s.dye,s.skin,s.hair_color,s.variant,s.pose];
  for i:0..<10 {out[3+i]=cast(u8)('0'+v[i]);}
  out[13]=cast(u8)('0'+s.piece/10);out[14]=cast(u8)('0'+s.piece%10);
  for i:0..<40 {out[15+i]=ifx s.worn[i] then '1' else '0';}
  out[55]=cast(u8)(48+s.eye_color);
  if n>=57 {out[56]=cast(u8)('a'+s.klass);}
  if n==58 {out[57]=cast(u8)('0'+s.level);}
  return n;
}
ca_restore :: (s:[]CharacterAppearance,t:string)->bool {
  legacy:=t.count==54 && t[0..<3]=="CC1";
  four:=t.count==58 && t[0..<3]=="CC4";
  three:=four || (t.count==57 && t[0..<3]=="CC3");
  if three && (t[56]<'a' || int(t[56])>='a'+CA_CLASSES) {return false;}
  if four && (t[57]<'2' || int(t[57])>48+CA_LEVELS) {return false;}
  if !legacy && !three && (t.count!=56 || t[0..<3]!="CC2") {return false;}
  if !legacy && (t[55]<'0' || t[55]>'5') {return false;}
  limits:=[12]int.[1,4,1,3,1,8,5,5,2,3,3,9];
  for i:0..<12 {if t[3+i]<'0' || int(t[3+i])>48+limits[i] {return false;}}
  piece:=int(t[13]-'0')*10+int(t[14]-'0');if piece>=40 {return false;}
  if t[3]=='0' && t[6]>'2' {return false;}
  for i:0..<(ifx legacy then 39 else 40) {if t[15+i]!='0' && t[15+i]!='1' {return false;}}
  if (t[5]=='1')!=((t[41]=='1') || (!legacy && t[54]=='1')) {return false;}
  next:=s[0];next.female=t[3]=='1';next.outfit=int(t[4]-'0');next.hood=t[5]=='1';next.hair=int(t[6]-'0');next.beard=t[7]=='1';next.dye=int(t[8]-'0');next.skin=int(t[9]-'0');next.hair_color=int(t[10]-'0');next.variant=int(t[11]-'0');next.pose=int(t[12]-'0');next.piece=piece;
  for i:0..<40 {next.worn[i]=i<(ifx legacy then 39 else 40) && t[15+i]=='1' && ca_available(next,i);}
  next.eye_color=ifx legacy then 0 else int(t[55]-'0');
  next.klass=ifx three then int(t[56]-'a') else -1;
  next.level=ifx four then int(t[57]-'0') else 1;
  if legacy {if next.outfit==3 {for i:0..<40 {next.worn[i]=i>=18 && i<=21;}next.hood=false;next.outfit=0;}else if next.outfit==4 {next.outfit=3;}}
  if !legacy && (next.outfit==4 || t[54]=='1') {for i:0..<40 {next.worn[i]=i==28 || i==29 || i==30 || i==31 || i==37 || i==38;}next.outfit=2;next.hood=false;}
  if !ca_available(next,next.piece) {next.piece=18;}
  next.configured=true;s[0]=next;return true;
}

ca_available :: (s:CharacterAppearance,p:int)->bool {return p>=0 && p<40 && PART_SELECTABLE[p] && (!s.female || PART_NAMES[p]!="");}
ca_preset :: (s:[]CharacterAppearance,family:int) {
 for i:0..<40 {s[0].worn[i]=false;}for i:0..<8 {p:=PART_PRESETS[family][i];if p>=0 && ca_available(s[0],p) {s[0].worn[p]=true;}}s[0].hood=false;s[0].configured=true;
}
ca_look :: (s:CharacterAppearance)->CaLook {
 l:CaLook;l.head=ifx s.female then 7 else 6;
 if !s.hood && s.hair<(ifx s.female then 3 else 2) {l.hair=ifx s.female then [3]int.[11,12,13][s.hair] else [2]int.[8,9][s.hair];}
 if s.beard && !s.female {l.extra=10;}l.skin=CA_SKINS[s.skin];l.hair_rgb=CA_HAIRS[s.hair_color];l.dye=[4]f32.[CA_DYES[s.dye][0],CA_DYES[s.dye][1],CA_DYES[s.dye][2],ifx s.dye==8 then 0 else 1];l.variant=s.variant;return l;
}
ca_word_end :: (row:string,p:int)->int {i:=p;while i<row.count && row[i]!=' ' {i+=1;}return i;}
ca_whole_at :: (row:string,p:int)->int {i:=p;while i<row.count && row[i]==' ' {i+=1;}v:=0;while i<row.count && row[i]>='0' && row[i]<='9' {v=v*10+int(row[i]-'0');i+=1;}return v;}
ca_catalog_ready :: (s:CharacterAppearance)->bool {for i:0..<80 {if PART_NAMES[i]!="" && s.source_count[i]<=0 {return false;}}return true;}
ca_catalog :: (s:[]CharacterAppearance,t:string) {
 s[0].source_n=0;for i:0..<80 {s[0].source_count[i]=0;}
 at:=0;while at<t.count {e:=at;while e<t.count && t[e]!='\n' {e+=1;}row:=t[at..<e];at=e+1;if row.count<9 || row[0..<2]!="C " {continue;}
  ne:=ca_word_end(row,2);name:=row[2..<ne];for i:0..<80 {if PART_NAMES[i]==name && name!="" {p:=ne;s[0].source_first[i]=ca_whole_at(row,p);p=ca_word_end(row,p+1);s[0].source_count[i]=ca_whole_at(row,p);p=ca_word_end(row,p+1);p=ca_word_end(row,p+1);s[0].source_word[i]=ca_whole_at(row,p);}}
 }for i:0..<80 {if s[0].source_count[i]>0 {s[0].source_n+=1;}}
}
