// A character's face: clips from its pack's EFC1 face (aethyr/anim/face.coax plays them as morph
// weights and face-bone layers), and the idle face cycle, which plays short source segments
// (blinks, glances) on a fixed period so a character's face moves while nothing else drives it.
// idle.coax adds procedural blinks, saccades and breathing between them.

// Up to four face segments, played in turn every `period` seconds (above 0), the first after one period.
CHARACTER_FACE_SEGMENTS :: 4;
CharacterFaceCycle :: struct {paused:bool;period:f32;count:int;clip:[CHARACTER_FACE_SEGMENTS]int;first:[CHARACTER_FACE_SEGMENTS]int;last:[CHARACTER_FACE_SEGMENTS]int;clock:f32;segment:int;}

// Tick the face clip, then present the palette.
character_face_clock :: (c:[]Character,packs:[]CharacterPack,dt:f32) {if character_has_face(c,packs) {face_tick(c[0].face[..],character_face_bytes(c,packs),dt);}character_present(c,packs);}
// Play source frames first..last of face clip `clip`, cross-faded from the face on screen.
character_face_start :: (c:[]Character,packs:[]CharacterPack,clip:int,first:int,last:int,looping:bool)->bool {if !c[0].ready || !character_has_face(c,packs) {return false;}return face_begin(c[0].face[..],character_face_bytes(c,packs),clip,first,last,looping);}
// Loop the whole of face clip `clip` and present it; an unknown clip changes nothing.
character_face_play :: (c:[]Character,packs:[]CharacterPack,clip:int)->bool {
 if !c[0].ready || !character_has_face(c,packs) {return false;}b:=character_face_bytes(c,packs);f:=face_info(b);if clip<0 || clip>=f.clips {return false;}
 frames:=cast(int)face_word(b,f.clip_table+clip*80+64);_:=character_face_start(c,packs,clip,0,frames-1,true);character_present(c,packs);return true;
}
// One step of the idle face cycle: start the segment that falls due, and turn a finished one off.
character_face_cycle :: (c:[]Character,packs:[]CharacterPack,dt:f32) {
 if !c[0].ready || c[0].cycle.paused || c[0].cycle.count<1 || !(c[0].cycle.period>0) || !character_has_face(c,packs) {return;}
 next:=layer_cycle(LayerCycle.{clock=c[0].cycle.clock,segment=c[0].cycle.segment},dt,c[0].cycle.period,c[0].cycle.count);c[0].cycle.clock=next.state.clock;c[0].cycle.segment=next.state.segment;
 if next.due {k:=(c[0].cycle.segment+c[0].cycle.count-1)%c[0].cycle.count;_:=character_face_start(c,packs,c[0].cycle.clip[k],c[0].cycle.first[k],c[0].cycle.last[k],false);}
 if c[0].face[0].enabled && !c[0].face[0].looping && c[0].face[0].time>=c[0].face[0].end {c[0].face[0].enabled=false;character_present(c,packs);}
}
