// A character's idle life between clips: blinks, eye saccades and slight breathing, so a character
// standing in a world is never frozen. It runs on each fixed step right after character_step has
// presented the body and face clips, and layers itself on top: it turns the eye and breath joints,
// chains the skeleton again from the first joint it turned, raises the blink weights and writes the
// palette with a new revision. A world without idle life loads only character.coax and pays nothing.
//
// The pack names nothing for this, so the world declares which face targets blink, which joints
// are the eyes and which joint breathes (CharacterIdleRig); character_idle_bind finds them by exact
// name in the pack's face (its target and rig joint names). A name the pack doesn't have leaves that
// part off. Draws come from aethyr/rand.coax under the declared seed, so a replay gets the same blinks.
//   each fixed step: character_step(c[..],packs[..],dt), then character_idle_step(idle[..],c[..],packs[..],dt)
#load "character.coax";
#load "../rand.coax";
#load "../math.coax";

// Seconds a blink takes, closing and opening.
CHARACTER_BLINK :: 0.16f32;
// Seconds between blinks: at least 2.5, at most 6.
CHARACTER_BLINK_GAP :: 2.5f32;
CHARACTER_BLINK_SPREAD :: 3.5f32;
// Seconds an eye holds a look: 0.6 to 2.4. Eyes jump (a saccade is about 30 ms, under one 64 Hz step).
CHARACTER_LOOK_GAP :: 0.6f32;
CHARACTER_LOOK_SPREAD :: 1.8f32;
// The widest look in radians: 0.06 about the yaw axis, 0.03 about the pitch axis.
CHARACTER_LOOK_YAW :: 0.06f32;
CHARACTER_LOOK_PITCH :: 0.03f32;
// Breathing: one breath every 4.2 seconds, rocking the breath joint by up to 0.012 radians.
CHARACTER_BREATH_PERIOD :: 4.2f32;
CHARACTER_BREATH_ANGLE :: 0.012f32;

// What the world declares for a character's idle life. Axes are in the joint's local space, unit length.
CharacterIdleRig :: struct {
 blink_left:string;blink_right:string;eye_left:string;eye_right:string;breath:string;
 eye_yaw:Point;eye_pitch:Point;breath_axis:Point;seed:int;
}
CharacterIdle :: struct {
 seed:int;draws:int;blinks:int;blink:[2]int;eyes:int;eye:[2]int;breath:int= -1;
 eye_yaw:Point;eye_pitch:Point;breath_axis:Point;
 time:f32;next_blink:f32;blink_at:f32= -1;next_look:f32;yaw:f32;pitch:f32;
 // What the last step applied.
 weight:f32;look:Quat;breathe:Quat;
}

// The index of face target `name` in face bytes b, or -1.
character_face_target :: (b:[]u8,name:string)->int {f:=face_info(b);for k:0..<f.targets {if character_name_is(b,f.target_table+k*80,name) {return k;}}return -1;}
// The index of rig joint `name` (the face's copy of the rig's joint names), or -1.
character_face_joint :: (b:[]u8,name:string)->int {f:=face_info(b);for k:0..<f.joints {if character_name_is(b,f.rig_names+k*64,name) {return k;}}return -1;}
// Whether the zero-padded 64-byte name at b[at..] is exactly `name`.
character_name_is :: (b:[]u8,at:int,name:string)->bool {
 if name.count<1 || name.count>=64 {return false;}for k:0..<name.count {if b[at+k]!=name[k] {return false;}}return b[at+name.count]==0;
}
// Bind the declared names to character c's pack. Returns how many parts were found (blink
// targets, eyes, breath joint). The clocks start over; the first blink comes 1 to 3 seconds in.
character_idle_bind :: (s:[]CharacterIdle,c:[]Character,packs:[]CharacterPack,rig:CharacterIdleRig)->int {
 s[0]=CharacterIdle.{seed=rig.seed,eye_yaw=rig.eye_yaw,eye_pitch=rig.eye_pitch,breath_axis=rig.breath_axis};
 if !c[0].ready || !character_has_face(c,packs) {return 0;}b:=character_face_bytes(c,packs);
 for name:[2]string.[rig.blink_left,rig.blink_right] {k:=character_face_target(b,name);if k>=0 && k<CHARACTER_MORPHS {s[0].blink[s[0].blinks]=k;s[0].blinks+=1;}}
 for name:[2]string.[rig.eye_left,rig.eye_right] {k:=character_face_joint(b,name);if k>=0 && k<c[0].joints {s[0].eye[s[0].eyes]=k;s[0].eyes+=1;}}
 k:=character_face_joint(b,rig.breath);if k>=0 && k<c[0].joints {s[0].breath=k;}
 s[0].next_blink=1+2*character_idle_draw(s,1);return s[0].blinks+s[0].eyes+(ifx s[0].breath>=0 then 1 else 0);
}
character_idle_draw :: (s:[]CharacterIdle,stream:int)->f32 {s[0].draws+=1;return rand_unit(s[0].seed,stream,s[0].draws);}
character_axis_angle :: (axis:Point,angle:f32)->Quat {h:=angle*0.5;k:=math_sin(h);return Quat.{x=axis.x*k,y=axis.y*k,z=axis.z*k,w=math_cos(h)};}
// How closed a blink is `t` seconds after it began: up and down once over CHARACTER_BLINK.
character_blink_weight :: (t:f32)->f32 {if t<0 || t>=CHARACTER_BLINK {return 0;}return math_sin(PI*t/CHARACTER_BLINK);}
// One fixed step of idle life, after character_step. While a face clip is on screen it owns the
// eyes and lids, so blinks and saccades rest; breathing goes on.
character_idle_step :: (s:[]CharacterIdle,c:[]Character,packs:[]CharacterPack,dt:f32) {
 if !c[0].ready || !(dt>=0 && dt<=0.125) {return;}s[0].time+=dt;t:=s[0].time;
 clip:=c[0].face[0].enabled && c[0].face[0].fade>0;
 if t>=s[0].next_blink {s[0].blink_at=t;s[0].next_blink=t+CHARACTER_BLINK_GAP+CHARACTER_BLINK_SPREAD*character_idle_draw(s,1);}
 if t>=s[0].next_look {s[0].yaw=(2*character_idle_draw(s,2)-1)*CHARACTER_LOOK_YAW;s[0].pitch=(2*character_idle_draw(s,2)-1)*CHARACTER_LOOK_PITCH;s[0].next_look=t+CHARACTER_LOOK_GAP+CHARACTER_LOOK_SPREAD*character_idle_draw(s,2);}
 s[0].weight=ifx clip || s[0].blink_at<0 then 0.0f32 else character_blink_weight(t-s[0].blink_at);
 s[0].look=ifx clip then Quat.{} else quat_mul(character_axis_angle(s[0].eye_yaw,s[0].yaw),character_axis_angle(s[0].eye_pitch,s[0].pitch));
 s[0].breathe=character_axis_angle(s[0].breath_axis,CHARACTER_BREATH_ANGLE*math_sin(2*PI*t/CHARACTER_BREATH_PERIOD));
 first:=c[0].joints;
 if !clip {for k:0..<s[0].eyes {j:=s[0].eye[k];c[0].pose[j].q=quat_unit(quat_mul(c[0].pose[j].q,s[0].look));if j<first {first=j;}}}
 if s[0].breath>=0 {j:=s[0].breath;c[0].pose[j].q=quat_unit(quat_mul(c[0].pose[j].q,s[0].breathe));if j<first {first=j;}}
 for k:first..<c[0].joints {pose_chain(c[0].gq[..],c[0].gt[..],c[0].parent[k],k,c[0].pose[k]);pose_palette(c[0].gq[k],c[0].gt[k],c[0].bind[..],k,c[0].palette[..]);}
 for k:0..<s[0].blinks {at:=CHARACTER_PALETTE_MORPHS+s[0].blink[k];c[0].palette[at]=hi(c[0].palette[at],s[0].weight);}
 character_capsules(c);c[0].revision+=1;
}
