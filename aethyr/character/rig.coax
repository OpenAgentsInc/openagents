// Character packs and rigs: a pack holds a character's ECH1 rig (joints, inverse binds, rest pose
// and locomotion clips, aethyr/anim/echo-pack.coax) and its projected EFC1 face (face clips and
// face bones, aethyr/anim/face-pack.coax). A rig's sizes come from the pack, under these maximums.
#load "../anim/echo-pack.coax";
#load "../anim/face.coax";

// The most joints a character rig may have: a MetaHuman body and face skeleton (Echo's has 334).
// ECH1 admission (echo_rig_valid) holds a rig to ECHO_JOINTS, which checks.coax keeps at or under this.
CHARACTER_JOINTS :: 334;
// Morph weights per character: every face target an EFC1 face may name.
CHARACTER_MORPHS :: 256;
// Shadow capsules per character (palette.coax).
CHARACTER_CAPSULES :: 20;
// The rig arena: an ECH1 rig, and whatever trailer the world's carrier puts after it.
CHARACTER_RIG_CAP :: ECHO_RIG_CAP;

// The world owns its packs; characters name theirs by index. Bytes are copied in once and stay
// immutable while any character uses them.
CharacterPack :: struct {data:[CHARACTER_RIG_CAP]u8;face:[FACE_RUNTIME_CAP]u8;rig_bytes:int;face_bytes:int;ready:bool;}

// Admit the n-byte ECH1 rig the world copied into packs[pack].data. A new rig drops the pack's face.
character_pack_rig :: (packs:[]CharacterPack,pack:int,n:int)->bool {
 p:=pack;if p<0 || p>=packs.count {return false;}
 if n<0 || n>packs[p].data.count || !echo_rig_valid(packs[p].data[0..<n]) {packs[p].ready=false;return false;}
 packs[p].ready=true;packs[p].rig_bytes=n;packs[p].face_bytes=0;return true;
}
// Add an EFC1 face to an admitted rig: the face must be valid and name exactly the rig's joints.
// Only names and samples are kept on the CPU; the GPU admits the morph deltas separately.
// `checked` skips face_valid when the caller's container check has already run it.
character_pack_face :: (packs:[]CharacterPack,pack:int,source:[]u8,checked:bool)->bool {
 p:=pack;if p<0 || p>=packs.count || !packs[p].ready {return false;}
 if !checked && (!face_valid(source) || face_info(source).joints!=cast(int)scan_u32(packs[p].data[..],8)) {return false;}
 packs[p].face_bytes=face_project_admitted(packs[p].face[..],source);if packs[p].face_bytes==0 {packs[p].ready=false;return false;}return true;
}
character_rig :: (c:[]Character,packs:[]CharacterPack)->[]u8 {return packs[c[0].pack].data[0..<packs[c[0].pack].rig_bytes];}
character_face_bytes :: (c:[]Character,packs:[]CharacterPack)->[]u8 {return packs[c[0].pack].face[0..<packs[c[0].pack].face_bytes];}
character_has_face :: (c:[]Character,packs:[]CharacterPack)->bool {return packs[c[0].pack].face_bytes>0;}
// A local pose in the rig: translation, then rotation (x, y, z, w), 28 bytes.
character_local_at :: (b:[]u8,at:int)->SkinLocal {return SkinLocal.{t=scan_point(b,at),q=Quat.{x=f32_from_bits(scan_u32(b,at+12)),y=f32_from_bits(scan_u32(b,at+16)),z=f32_from_bits(scan_u32(b,at+20)),w=f32_from_bits(scan_u32(b,at+24))}};}
