// Private shared policy: producer and renderer libraries can load it without
// introducing duplicate native C exports into the same host executable.
#authority;
#test "GPU admission permits zero or one unfinished frame only" {
  #assert afp_submit_allowed(0) && afp_submit_allowed(1);
  #assert !afp_submit_allowed(2) && !afp_submit_allowed(3) && !afp_submit_allowed(-1) && !afp_submit_allowed(1000000);
}
afp_submit_allowed :: (pending:int)->bool #effects(all) {return pending>=0 && pending<2;}
