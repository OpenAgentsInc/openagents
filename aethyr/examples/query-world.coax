// Engine-owned integration content for #12989 and the subsequent lifecycle,
// streaming, action, actor, camera and terrain issues. All IDs are durable.
#module "aethyr.examples.queryworld";
#import "Basic";
#load "../query-fluid.coax";
#load "../entity.coax" as entities;
#load "../collide.coax";
#load "../follow.coax";
#load "../ai/stimulus.coax";

QueryWorldContent :: struct {
  boxes: [18] f32;
  capsules: [7] f32;
  metadata: [5] QueryCollider;
  surfaces: [3] PhysicalSurface;
  epoch: [1] int;
  entity_backing: [1] entities.OracleBacking;
}
QueryJourney :: struct {
  accepted: bool;
  walker_z: f32;
  stopped_z: f32;
  camera_room: f32;
  sight: SenseStatus;
  wall_sight: SenseStatus;
  footstep: int;
  reaction: int;
  fluid_depth: f32;
  fluid_vx: f32;
  fluid_vy: f32;
  stale_refused: bool;
  published: bool;
  next_footstep: int;
}

#test "one world drives movement, camera body and sight, NPC sight and material footsteps" {
  b: [1] QueryWorldContent;
  journey := query_world_journey(b[..]);
  #assert journey.accepted && abs(journey.walker_z - 2.2) < 0.000001;
  #assert abs(journey.stopped_z - 4.7) < 0.000001;
  #assert abs(journey.camera_room - 1.8) < 0.000001;
  #assert journey.sight == SenseStatus.sensed && journey.wall_sight == SenseStatus.hidden;
  #assert journey.footstep == 4 && journey.reaction == 9;
  #assert journey.fluid_depth == 1 && journey.fluid_vx == 2 && journey.fluid_vy == 0;
  #assert journey.stale_refused;
  #assert journey.published && journey.next_footstep == 12;
}

query_world_content :: (b: [] QueryWorldContent) -> QueryWorld #effects(all) {
  b[0].boxes = [18] f32.[-1, 0, 2, 1, 3, 2.25, -1, 0, 5, 1, 3, 5.25, 3, 0, 1, 5, 2, 3];
  b[0].capsules = [7] f32.[8, 0.3, 0, 8, 1.5, 0, 0.3];
  store := entities.oracle_store(b[0].entity_backing[..]);
  entities.entity_clear(store);
  npc := entities.entity_spawn(store); entities.entity_flush(store);
  b[0].metadata = [5] QueryCollider.[
    QueryCollider.{ref = ColliderRef.{id = 100, generation = 1}, shape = QueryShape.ground, surface = 10},
    QueryCollider.{ref = ColliderRef.{id = 200, generation = 1}, shape = QueryShape.box, categories = 2, surface = 20},
    QueryCollider.{ref = ColliderRef.{id = 300, generation = 1}, shape = QueryShape.box, index = 1, surface = 20},
    QueryCollider.{ref = ColliderRef.{id = 400, generation = 1}, shape = QueryShape.box, index = 2, categories = 4, role = QueryRole.fluid, surface = 30},
    QueryCollider.{ref = ColliderRef.{id = 500, generation = 1}, shape = QueryShape.capsule, categories = 8, surface = 20, entity = npc.handle}];
  b[0].surfaces = [3] PhysicalSurface.[PhysicalSurface.{id = 10, footstep = 4, reaction = 9},
    PhysicalSurface.{id = 20, footstep = 8, reaction = 12}, PhysicalSurface.{id = 30, fluid_kind = 2, density = 1200, drag = 64}];
  b[0].epoch[0] = 1;
  return QueryWorld.{geometry = Colliders.{boxes = b[0].boxes[..], capsules = b[0].capsules[..]},
    metadata = b[0].metadata[..], surfaces = b[0].surfaces[..], epoch = 1,
    current_epoch = b[0].epoch[..], entity_store = store};
}
query_world_journey :: (b: [] QueryWorldContent) -> QueryJourney #effects(all) {
  w := query_world_content(b); out: QueryJourney;
  movement_scratch: [1] QueryScratch; camera_scratch: [1] QueryScratch; sight_scratch: [1] QueryScratch;
  movement := query_select_world(w, QueryFilter.{include = 1}, movement_scratch[..]);
  camera := query_select_world(w, QueryFilter.{include = 3}, camera_scratch[..]);
  sight := query_select_world(w, QueryFilter.{include = 1}, sight_scratch[..]);
  if movement.status != QueryStatus.ok || camera.status != QueryStatus.ok || sight.status != QueryStatus.ok { return out; }
  // The existing capsule resolver reads the selected shared geometry. No
  // realm-specific camera-only-wall or water exception appears in movement.
  walk := collide_move(movement.geometry, CollideProfile.{}, CollideState.{feet = world_point(0, 0, 2.1)}, 0, 0.1);
  stopped := collide_move(movement.geometry, CollideProfile.{}, CollideState.{feet = world_point(0, 0, 4.8)}, 0, 0.1);
  room := follow_room_checked(camera.geometry, 1000, world_point(0, 1.5, 0), world_point(0, 0, 1), 6);
  line := semantic_clear(camera, world_point(0, 1.5, 0), world_point(0, 0, 4), 1);
  npc_sight := sense_sight(Senses.{}, sight.geometry, world_point(0, 0, 0), world_point(0, 1.6, 4), 500, 1);
  wall_sight := sense_sight(Senses.{}, sight.geometry, world_point(0, 0, 0), world_point(0, 1.6, 6), 500, 1);
  underfoot := semantic_ground(movement, walk.state.feet.x, walk.state.feet.z, 0.55, 0.3);
  if underfoot.geometry.status != QueryStatus.ok || underfoot.geometry.shape == QueryShape.none { return out; }
  material := movement.surfaces[query_surface_index(movement.surfaces, underfoot.collider.surface)];
  volumes := [1] FluidVolume.[FluidVolume.{body = ColliderRef.{id = 400, generation = 1}, kind = FluidSurfaceKind.flat, level = 2}];
  holes := [1] FluidHole.[FluidHole.{body = volumes[0].body, west = 3, east = 3.5, south = 1, north = 2}];
  fluid: [1] FluidSample;
  sampled := query_fluid_samples(w, QueryFilter.{include = 4}, volumes[..], holes[..], world_point(4, 1, 2), fluid[..]);
  slowed := query_fluid_motion(fluid[0], world_point(4, 0, 0), 0.015625);
  out = QueryJourney.{accepted = walk.status == CollideStatus.ok && stopped.status == CollideStatus.ok &&
    room.status == QueryStatus.ok && !line.clear && sampled.status == QueryStatus.ok && sampled.count == 1 && slowed.status == QueryStatus.ok,
    walker_z = walk.state.feet.z, stopped_z = stopped.state.feet.z, camera_room = room.room,
    sight = npc_sight.status, wall_sight = wall_sight.status, footstep = material.footstep, reaction = material.reaction,
    fluid_depth = fluid[0].depth, fluid_vx = slowed.velocity.x, fluid_vy = slowed.velocity.y};
  // A retained selection cannot outlive its NPC even before a new snapshot
  // is published. The next tick will publish content without the old handle.
  all_scratch: [1] QueryScratch;
  all := query_select_world(w, QueryFilter.{}, all_scratch[..]);
  entities.entity_despawn(w.entity_store, b[0].metadata[4].entity); entities.entity_flush(w.entity_store);
  out.stale_refused = semantic_ray(all, world_point(0, 1, 0), world_point(0, 0, 1), 10).geometry.status == QueryStatus.invalid;
  // Publish an inactive bank at the next paid tick: retire the NPC collider
  // and change the ground's response class as one coherent snapshot.
  next_metadata: [4] QueryCollider;
  for i: 0..<4 { next_metadata[i] = b[0].metadata[i]; }
  next_surfaces := b[0].surfaces; next_surfaces[0].footstep = 12;
  next := w; next.tick = 1; next.epoch = 2; next.metadata = next_metadata[..]; next.surfaces = next_surfaces[..];
  next.geometry.capsules = b[0].capsules[0..<0];
  published := query_world_publish(w, next, 1);
  out.published = published.status == QueryStatus.ok &&
    semantic_ground(movement, 0, 0, 0.55, 0.3).geometry.status == QueryStatus.invalid;
  fresh := query_select_world(published.world, QueryFilter.{include = 1}, all_scratch[..]);
  new_ground := semantic_ground(fresh, 0, 0, 0.55, 0.3);
  if new_ground.geometry.status == QueryStatus.ok && new_ground.collider.surface == 10 {
    out.next_footstep = fresh.surfaces[query_surface_index(fresh.surfaces, new_ground.collider.surface)].footstep;
  }
  return out;
}
query_world_word :: (mode: int) -> int #export_c #effects(all) {
  if mode < 0 || mode >= 14 { return -1; }
  b: [1] QueryWorldContent; j := query_world_journey(b[..]);
  words := [14] int.[ifx j.accepted then 1 else 0, cast(int) f32_bits(j.walker_z), cast(int) f32_bits(j.stopped_z),
    cast(int) f32_bits(j.camera_room), cast(int) j.sight, cast(int) j.wall_sight, j.footstep, j.reaction,
    cast(int) f32_bits(j.fluid_depth), cast(int) f32_bits(j.fluid_vx), cast(int) f32_bits(j.fluid_vy), ifx j.stale_refused then 1 else 0,
    ifx j.published then 1 else 0, j.next_footstep];
  return words[mode];
}
main :: () { for i: 0..<14 { print("%\n", query_world_word(i)); } }
