// Writes cel vertices (aethyr/render/cel-mesh.coax: six words a vertex) as glTF 2.0 binary, for
// the Unreal exporter (docs/unreal/2026-11-12-aethyr-to-unreal-exporter-spec.md). One buffer;
// each part is a run of vertices and becomes one named mesh and node, its triangles in order
// with no index. Positions stay in the Metaverse Engine's metres and axes: the reader's side maps them.
// Two writers. glb_from_cel is the plain one (the axis fixture, GitHub #13399): vertices in
// order, colours as the pen's sRGB bytes. glb_world is the exporter's (#13400): triangles
// grouped by material class and ground cell, vertices welded behind an index, colours linear
// as glTF asks, each vertex's parameter and object number in TEXCOORD_0 and its material class
// in TEXCOORD_1.
//   coax/bin/coax test --library aethyr/export/glb-write.coax
#load "../render/cel-mesh.coax";
#load "../../coax/lib/json/json.coax";

GlbPart :: struct { name: string; first: int; count: int; }

GLB_VERTEX_BYTES :: 28;   // position 12, normal 12, colour 4

glb_u32 :: (out: [] u8, at: int, w: u32) {
  out[at] = cast,trunc(u8) (w & 255); out[at + 1] = cast,trunc(u8) ((w >> 8) & 255);
  out[at + 2] = cast,trunc(u8) ((w >> 16) & 255); out[at + 3] = cast,trunc(u8) ((w >> 24) & 255);
}
// A number to six decimals, trailing zeros kept: exact for the halves and wholes a fixture uses.
glb_num :: (o: [] Jo, v: f32) #effects(all) {
  text: [48] u8; n := 0;
  a := v; if a < 0 { a = -a; text[n] = '-'; n += 1; }
  whole := cast(int) floor(a); frac := cast(int) floor((a - cast(f32) whole) * 1000000 + 0.5);
  if frac >= 1000000 { whole += 1; frac -= 1000000; }
  digits: [24] u8; d := 0;
  if whole == 0 { digits[0] = '0'; d = 1; }
  while whole > 0 { digits[d] = cast,trunc(u8) (48 + whole % 10); d += 1; whole /= 10; }
  for k: 0..<d { text[n] = digits[d - 1 - k]; n += 1; }
  text[n] = '.'; n += 1;
  scale := 100000;
  for k: 0..<6 { text[n] = cast,trunc(u8) (48 + (frac / scale) % 10); n += 1; scale /= 10; }
  jo_raw(o, cast(string) text[0..<n]);
}
glb_f :: (w: u32) -> f32 { return f32_from_bits(w); }

// The glTF binary of `parts` over the cel words in `buf`, into `out`. Returns its size, or -1
// when it does not fit or a part is not whole triangles inside the buffer.
glb_from_cel :: (buf: [] u32, parts: [] GlbPart, out: [] u8) -> int #effects(all) {
  vertices := 0;
  for p: parts {
    if p.count < 3 || p.count % 3 != 0 || p.first < 0 || (p.first + p.count) * VERTEX_WORDS > buf.count { return -1; }
    vertices += p.count;
  }
  json: [65536] u8; o: [1] Jo; jo_start(o[..], json[..]);
  bin_bytes := vertices * GLB_VERTEX_BYTES;
  jo_obj(o[..]);
  jo_key(o[..], "asset"); jo_obj(o[..]); jo_key(o[..], "version"); jo_str(o[..], "2.0"); jo_key(o[..], "generator"); jo_str(o[..], "aethyr/export/glb-write.coax"); jo_end(o[..]);
  jo_key(o[..], "scene"); jo_int(o[..], 0);
  jo_key(o[..], "scenes"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "nodes"); jo_arr(o[..]); for p, k: parts { jo_int(o[..], k); } jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  jo_key(o[..], "nodes"); jo_arr(o[..]);
  for p, k: parts { jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], p.name); jo_key(o[..], "mesh"); jo_int(o[..], k); jo_end(o[..]); }
  jo_end(o[..]);
  jo_key(o[..], "materials"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "cel"); jo_key(o[..], "extensions"); jo_obj(o[..]); jo_key(o[..], "KHR_materials_unlit"); jo_obj(o[..]); jo_end(o[..]); jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  jo_key(o[..], "extensionsUsed"); jo_arr(o[..]); jo_str(o[..], "KHR_materials_unlit"); jo_end(o[..]);
  jo_key(o[..], "meshes"); jo_arr(o[..]);
  for p, k: parts {
    jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], p.name);
    jo_key(o[..], "primitives"); jo_arr(o[..]); jo_obj(o[..]);
    jo_key(o[..], "attributes"); jo_obj(o[..]);
    jo_key(o[..], "POSITION"); jo_int(o[..], k * 3); jo_key(o[..], "NORMAL"); jo_int(o[..], k * 3 + 1); jo_key(o[..], "COLOR_0"); jo_int(o[..], k * 3 + 2);
    jo_end(o[..]);
    jo_key(o[..], "material"); jo_int(o[..], 0); jo_key(o[..], "mode"); jo_int(o[..], 4);
    jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_key(o[..], "accessors"); jo_arr(o[..]);
  first := 0;
  for p: parts {
    lo3 := [3] f32.[0, 0, 0]; hi3 := [3] f32.[0, 0, 0];
    for v: 0..<p.count { for c: 0..<3 {
      x := glb_f(buf[(p.first + v) * VERTEX_WORDS + c]);
      if v == 0 || x < lo3[c] { lo3[c] = x; }
      if v == 0 || x > hi3[c] { hi3[c] = x; }
    } }
    for a: 0..<3 {
      jo_obj(o[..]); jo_key(o[..], "bufferView"); jo_int(o[..], a); jo_key(o[..], "byteOffset"); jo_int(o[..], first * GLB_VERTEX_BYTES);
      jo_key(o[..], "componentType"); jo_int(o[..], ifx a == 2 then 5121 else 5126); jo_key(o[..], "count"); jo_int(o[..], p.count);
      jo_key(o[..], "type"); jo_str(o[..], ifx a == 2 then "VEC4" else "VEC3");
      if a == 2 { jo_key(o[..], "normalized"); jo_bool(o[..], true); }
      if a == 0 {
        jo_key(o[..], "min"); jo_arr(o[..]); for c: 0..<3 { glb_num(o[..], lo3[c]); } jo_end(o[..]);
        jo_key(o[..], "max"); jo_arr(o[..]); for c: 0..<3 { glb_num(o[..], hi3[c]); } jo_end(o[..]);
      }
      jo_end(o[..]);
    }
    first += p.count;
  }
  jo_end(o[..]);
  // One interleaved view an attribute: the same bytes and stride, each starting at its own offset.
  jo_key(o[..], "bufferViews"); jo_arr(o[..]);
  for a: 0..<3 {
    off := ifx a == 0 then 0 else ifx a == 1 then 12 else 24;
    jo_obj(o[..]); jo_key(o[..], "buffer"); jo_int(o[..], 0); jo_key(o[..], "byteOffset"); jo_int(o[..], off);
    jo_key(o[..], "byteLength"); jo_int(o[..], bin_bytes - off); jo_key(o[..], "byteStride"); jo_int(o[..], GLB_VERTEX_BYTES); jo_key(o[..], "target"); jo_int(o[..], 34962);
    jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_key(o[..], "buffers"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "byteLength"); jo_int(o[..], bin_bytes); jo_end(o[..]); jo_end(o[..]);
  jo_end(o[..]);
  if o[0].bad { return -1; }
  json_n := o[0].n; json_pad := (4 - json_n % 4) % 4;
  total := 12 + 8 + json_n + json_pad + 8 + bin_bytes;
  if total > out.count { return -1; }
  glb_u32(out, 0, 0x46546C67); glb_u32(out, 4, 2); glb_u32(out, 8, cast,trunc(u32) total);
  glb_u32(out, 12, cast,trunc(u32) (json_n + json_pad)); glb_u32(out, 16, 0x4E4F534A);
  at := 20;
  for k: 0..<json_n { out[at + k] = json[k]; }
  for k: 0..<json_pad { out[at + json_n + k] = ' '; }
  at += json_n + json_pad;
  glb_u32(out, at, cast,trunc(u32) bin_bytes); glb_u32(out, at + 4, 0x004E4942); at += 8;
  for p: parts { for v: 0..<p.count {
    i := (p.first + v) * VERTEX_WORDS;
    glb_u32(out, at, buf[i]); glb_u32(out, at + 4, buf[i + 1]); glb_u32(out, at + 8, buf[i + 2]);
    packed := buf[i + 3];
    nx := cast(f32) (packed & 255) / 255 * 2 - 1; ny := cast(f32) ((packed >> 8) & 255) / 255 * 2 - 1; nz := cast(f32) ((packed >> 16) & 255) / 255 * 2 - 1;
    n := unit_or(v3(nx, ny, nz), v3(0, 1, 0));
    glb_u32(out, at + 12, f32_bits(n.x)); glb_u32(out, at + 16, f32_bits(n.y)); glb_u32(out, at + 20, f32_bits(n.z));
    glb_u32(out, at + 24, (buf[i + 4] & 0x00FFFFFF) | 0xFF000000);
    at += GLB_VERTEX_BYTES;
  } }
  return total;
}


// ---- The world writer

GLB_GROUPS :: 1024;
GLB_WORLD_VERTEX_BYTES :: 56;   // position 12, normal 12, colour 16 (linear, alpha 1), parameter and object 8, material class 8
GLB_TABLE :: 262144;

// One mesh of the world: a material class inside one ground cell. Its name is w_mMM_xXXX_zZZZ,
// the cell numbers offset by 128 so they are never negative.
GlbGroup :: struct { mat: int; cx: int; cz: int; vertices: int; triangles: int; lo: [3] f32; hi: [3] f32; vertex_at: int; index_at: int; }
GlbWorld :: struct { ok: bool; bytes: int; groups: int; vertices: int; triangles: int; welded: int; lo: [3] f32; hi: [3] f32; }

glb_name :: (g: GlbGroup, out: [] u8) -> string {
  t := "w_m00_x000_z000"; for c, k: t { out[k] = c; }
  out[3] = cast,trunc(u8) (48 + (g.mat / 10) % 10); out[4] = cast,trunc(u8) (48 + g.mat % 10);
  x := g.cx + 128; z := g.cz + 128;
  out[7] = cast,trunc(u8) (48 + (x / 100) % 10); out[8] = cast,trunc(u8) (48 + (x / 10) % 10); out[9] = cast,trunc(u8) (48 + x % 10);
  out[12] = cast,trunc(u8) (48 + (z / 100) % 10); out[13] = cast,trunc(u8) (48 + (z / 10) % 10); out[14] = cast,trunc(u8) (48 + z % 10);
  return cast(string) out[0..<15];
}
// An sRGB byte as a linear value (IEC 61966-2-1).
glb_linear :: (b: u32) -> f32 {
  c := cast(f32) b / 255;
  return ifx c <= 0.04045 then c / 12.92 else pow((c + 0.055) / 1.055, 2.4);
}
// A cel normal's three bytes as a unit vector. A byte cannot hold zero exactly, so a part
// smaller than the byte's step is zero.
glb_normal :: (packed: u32) -> Point {
  x := cast(f32) (packed & 255) / 255 * 2 - 1; y := cast(f32) ((packed >> 8) & 255) / 255 * 2 - 1; z := cast(f32) ((packed >> 16) & 255) / 255 * 2 - 1;
  if x > -0.005 && x < 0.005 { x = 0; }
  if y > -0.005 && y < 0.005 { y = 0; }
  if z > -0.005 && z < 0.005 { z = 0; }
  return unit_or(v3(x, y, z), v3(0, 1, 0));
}
glb_key :: (buf: [] u32, tri: int, cell: f32) -> int {
  i := tri * 3 * VERTEX_WORDS;
  x := (glb_f(buf[i]) + glb_f(buf[i + VERTEX_WORDS]) + glb_f(buf[i + 2 * VERTEX_WORDS])) / 3;
  z := (glb_f(buf[i + 2]) + glb_f(buf[i + VERTEX_WORDS + 2]) + glb_f(buf[i + 2 * VERTEX_WORDS + 2])) / 3;
  cx := cast(int) floor(x / cell) + 128; cz := cast(int) floor(z / cell) + 128;
  if cx < 0 || cx > 255 || cz < 0 || cz > 255 { return -1; }
  return (cast(int) ((buf[i + 4] >> 24) & 255) << 16) | (cx << 8) | cz;
}
glb_same :: (buf: [] u32, a: int, b: int) -> bool {
  for w: 0..<VERTEX_WORDS { if buf[a * VERTEX_WORDS + w] != buf[b * VERTEX_WORDS + w] { return false; } }
  return true;
}
glb_hash :: (buf: [] u32, v: int) -> int {
  h := 2166136261;   // 64-bit, kept to 32 bits: the product never overflows
  for w: 0..<VERTEX_WORDS { h = ((h ^ cast(int) buf[v * VERTEX_WORDS + w]) * 16777619) & 0xFFFFFFFF; h = h ^ (h >> 15); }
  return h & (GLB_TABLE - 1);
}

// The world's glTF binary into `out`: `vertices` cel vertices (whole triangles) in `buf`,
// grouped by material class and by `cell`-metre ground cell. `scratch` holds the binary chunk
// while the JSON is written and must be as large as it; `groups` receives one entry a mesh.
// The same input gives the same bytes. Not ok when anything does not fit.
glb_world :: (buf: [] u32, vertices: int, cell: f32, out: [] u8, scratch: [] u8, groups: [] GlbGroup) -> GlbWorld #effects(all) {
  r: GlbWorld;
  if vertices < 3 || vertices % 3 != 0 || vertices * VERTEX_WORDS > buf.count || !(cell > 0) { return r; }
  tris := vertices / 3;
  keys: [50000] int; if tris > 50000 { return r; }
  distinct: [GLB_GROUPS] int; n := 0;
  for t: 0..<tris {
    k := glb_key(buf, t, cell); if k < 0 { return r; }
    keys[t] = k;
    at := 0; while at < n && distinct[at] < k { at += 1; }
    if at < n && distinct[at] == k { continue; }
    if n >= GLB_GROUPS || n >= groups.count { return r; }
    j := n; while j > at { distinct[j] = distinct[j - 1]; j -= 1; }
    distinct[at] = k; n += 1;
  }
  lut: [256] f32; for b: 0..<256 { lut[b] = glb_linear(cast(u32) b); }
  table: [GLB_TABLE] int; index_of: [150000] int;
  bin := 0;
  for gi: 0..<n {
    k := distinct[gi];
    g: GlbGroup; g.mat = k >> 16; g.cx = ((k >> 8) & 255) - 128; g.cz = (k & 255) - 128; g.vertex_at = bin;
    for s: 0..<GLB_TABLE { table[s] = -1; }
    // welded vertices first, in the order the triangles first use them
    for t: 0..<tris {
      if keys[t] != k { continue; }
      for c: 0..<3 {
        v := t * 3 + c; slot := glb_hash(buf, v);
        while table[slot] >= 0 && !glb_same(buf, table[slot], v) { slot = (slot + 1) & (GLB_TABLE - 1); }
        if table[slot] >= 0 { index_of[v] = index_of[table[slot]]; continue; }
        table[slot] = v; index_of[v] = g.vertices;
        if bin + GLB_WORLD_VERTEX_BYTES > scratch.count { return r; }
        i := v * VERTEX_WORDS;
        for a: 0..<3 {
          x := glb_f(buf[i + a]);
          if g.vertices == 0 || x < g.lo[a] { g.lo[a] = x; }
          if g.vertices == 0 || x > g.hi[a] { g.hi[a] = x; }
          glb_u32(scratch, bin + a * 4, buf[i + a]);
        }
        nn := glb_normal(buf[i + 3]);
        glb_u32(scratch, bin + 12, f32_bits(nn.x)); glb_u32(scratch, bin + 16, f32_bits(nn.y)); glb_u32(scratch, bin + 20, f32_bits(nn.z));
        col := buf[i + 4];
        glb_u32(scratch, bin + 24, f32_bits(lut[col & 255])); glb_u32(scratch, bin + 28, f32_bits(lut[(col >> 8) & 255])); glb_u32(scratch, bin + 32, f32_bits(lut[(col >> 16) & 255])); glb_u32(scratch, bin + 36, f32_bits(1));
        glb_u32(scratch, bin + 40, buf[i + 5]); glb_u32(scratch, bin + 44, f32_bits(cast(f32) ((buf[i + 3] >> 24) & 255)));
        glb_u32(scratch, bin + 48, f32_bits(cast(f32) ((col >> 24) & 255))); glb_u32(scratch, bin + 52, 0);
        bin += GLB_WORLD_VERTEX_BYTES; g.vertices += 1;
      }
      g.triangles += 1;
    }
    g.index_at = bin;
    for t: 0..<tris {
      if keys[t] != k { continue; }
      if bin + 12 > scratch.count { return r; }
      for c: 0..<3 { glb_u32(scratch, bin, cast,trunc(u32) index_of[t * 3 + c]); bin += 4; }
    }
    groups[gi] = g;
    for a: 0..<3 {
      if gi == 0 || g.lo[a] < r.lo[a] { r.lo[a] = g.lo[a]; }
      if gi == 0 || g.hi[a] > r.hi[a] { r.hi[a] = g.hi[a]; }
    }
    r.welded += g.vertices;
  }
  json: [1048576] u8; o: [1] Jo; jo_start(o[..], json[..]); name: [16] u8;
  jo_obj(o[..]);
  jo_key(o[..], "asset"); jo_obj(o[..]); jo_key(o[..], "version"); jo_str(o[..], "2.0"); jo_key(o[..], "generator"); jo_str(o[..], "aethyr/export/glb-write.coax"); jo_end(o[..]);
  jo_key(o[..], "scene"); jo_int(o[..], 0);
  jo_key(o[..], "scenes"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "nodes"); jo_arr(o[..]); for gi: 0..<n { jo_int(o[..], gi); } jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  jo_key(o[..], "nodes"); jo_arr(o[..]);
  for gi: 0..<n { jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], glb_name(groups[gi], name[..])); jo_key(o[..], "mesh"); jo_int(o[..], gi); jo_end(o[..]); }
  jo_end(o[..]);
  jo_key(o[..], "materials"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "cel"); jo_key(o[..], "extensions"); jo_obj(o[..]); jo_key(o[..], "KHR_materials_unlit"); jo_obj(o[..]); jo_end(o[..]); jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  jo_key(o[..], "extensionsUsed"); jo_arr(o[..]); jo_str(o[..], "KHR_materials_unlit"); jo_end(o[..]);
  jo_key(o[..], "meshes"); jo_arr(o[..]);
  for gi: 0..<n {
    jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], glb_name(groups[gi], name[..]));
    jo_key(o[..], "primitives"); jo_arr(o[..]); jo_obj(o[..]);
    jo_key(o[..], "attributes"); jo_obj(o[..]);
    jo_key(o[..], "POSITION"); jo_int(o[..], gi * 6); jo_key(o[..], "NORMAL"); jo_int(o[..], gi * 6 + 1); jo_key(o[..], "COLOR_0"); jo_int(o[..], gi * 6 + 2); jo_key(o[..], "TEXCOORD_0"); jo_int(o[..], gi * 6 + 3); jo_key(o[..], "TEXCOORD_1"); jo_int(o[..], gi * 6 + 5);
    jo_end(o[..]);
    jo_key(o[..], "indices"); jo_int(o[..], gi * 6 + 4); jo_key(o[..], "material"); jo_int(o[..], 0); jo_key(o[..], "mode"); jo_int(o[..], 4);
    jo_end(o[..]); jo_end(o[..]); jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_key(o[..], "accessors"); jo_arr(o[..]);
  for gi: 0..<n {
    g := groups[gi];
    for a: 0..<6 {   // position, normal, colour, parameter and object, the indices, material class
      off := ifx a == 0 then 0 else ifx a == 1 then 12 else ifx a == 2 then 24 else ifx a == 3 then 40 else ifx a == 5 then 48 else 0;
      jo_obj(o[..]); jo_key(o[..], "bufferView"); jo_int(o[..], gi * 2 + (ifx a == 4 then 1 else 0)); jo_key(o[..], "byteOffset"); jo_int(o[..], off);
      jo_key(o[..], "componentType"); jo_int(o[..], ifx a == 4 then 5125 else 5126); jo_key(o[..], "count"); jo_int(o[..], ifx a == 4 then g.triangles * 3 else g.vertices);
      jo_key(o[..], "type"); jo_str(o[..], ifx a == 4 then "SCALAR" else ifx a == 2 then "VEC4" else ifx a == 3 || a == 5 then "VEC2" else "VEC3");
      if a == 0 {
        jo_key(o[..], "min"); jo_arr(o[..]); for c: 0..<3 { glb_num(o[..], g.lo[c]); } jo_end(o[..]);
        jo_key(o[..], "max"); jo_arr(o[..]); for c: 0..<3 { glb_num(o[..], g.hi[c]); } jo_end(o[..]);
      }
      jo_end(o[..]);
    }
  }
  jo_end(o[..]);
  jo_key(o[..], "bufferViews"); jo_arr(o[..]);
  for gi: 0..<n {
    g := groups[gi];
    jo_obj(o[..]); jo_key(o[..], "buffer"); jo_int(o[..], 0); jo_key(o[..], "byteOffset"); jo_int(o[..], g.vertex_at); jo_key(o[..], "byteLength"); jo_int(o[..], g.vertices * GLB_WORLD_VERTEX_BYTES);
    jo_key(o[..], "byteStride"); jo_int(o[..], GLB_WORLD_VERTEX_BYTES); jo_key(o[..], "target"); jo_int(o[..], 34962); jo_end(o[..]);
    jo_obj(o[..]); jo_key(o[..], "buffer"); jo_int(o[..], 0); jo_key(o[..], "byteOffset"); jo_int(o[..], g.index_at); jo_key(o[..], "byteLength"); jo_int(o[..], g.triangles * 12);
    jo_key(o[..], "target"); jo_int(o[..], 34963); jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_key(o[..], "buffers"); jo_arr(o[..]); jo_obj(o[..]); jo_key(o[..], "byteLength"); jo_int(o[..], bin); jo_end(o[..]); jo_end(o[..]);
  jo_end(o[..]);
  if o[0].bad { return r; }
  json_n := o[0].n; json_pad := (4 - json_n % 4) % 4;
  total := 12 + 8 + json_n + json_pad + 8 + bin;
  if total > out.count { return r; }
  glb_u32(out, 0, 0x46546C67); glb_u32(out, 4, 2); glb_u32(out, 8, cast,trunc(u32) total);
  glb_u32(out, 12, cast,trunc(u32) (json_n + json_pad)); glb_u32(out, 16, 0x4E4F534A);
  at := 20;
  for b: 0..<json_n { out[at + b] = json[b]; }
  for b: 0..<json_pad { out[at + json_n + b] = ' '; }
  at += json_n + json_pad;
  glb_u32(out, at, cast,trunc(u32) bin); glb_u32(out, at + 4, 0x004E4942); at += 8;
  for b: 0..<bin { out[at + b] = scratch[b]; }
  r.ok = true; r.bytes = total; r.groups = n; r.vertices = vertices; r.triangles = tris;
  return r;
}

#test "a cube is a whole glTF binary: header, JSON chunk, 36 vertices of 28 bytes" {
  buf: [36 * VERTEX_WORDS] u32; p: [1] Pen; pen_set(p[..], 1, MAT_FLAT, 1, 0, 0);
  box(buf[..], p[..], frame_at(v3(10, 0.5, 0), 0), 0.5, 0.5, 0.5);
  #assert p[0].n == 36;
  parts := [1] GlbPart.[GlbPart.{name = "cube", first = 0, count = 36}];
  out: [8192] u8; n := glb_from_cel(buf[..], parts[..], out[..]);
  #assert n > 0 && n % 4 == 0;
  #assert out[0] == 'g' && out[1] == 'l' && out[2] == 'T' && out[3] == 'F';
  json_n := cast(int) out[12] + cast(int) out[13] * 256;
  #assert n == 12 + 8 + json_n + 8 + 36 * GLB_VERTEX_BYTES;
  #assert out[20] == '{';
}
#test "a part that is not whole triangles is refused" {
  buf: [36 * VERTEX_WORDS] u32; out: [4096] u8;
  parts := [1] GlbPart.[GlbPart.{name = "bad", first = 0, count = 35}];
  #assert glb_from_cel(buf[..], parts[..], out[..]) == -1;
}

#test "the world writer welds a cube to 24 vertices behind 36 indices, in one group" {
  buf: [36 * VERTEX_WORDS] u32; p: [1] Pen; pen_set(p[..], 1, MAT_FLAT, 1, 0, 0);
  box(buf[..], p[..], frame_at(v3(10, 0.5, 5), 0), 0.5, 0.5, 0.5);
  out: [16384] u8; scratch: [16384] u8; groups: [4] GlbGroup;
  r := glb_world(buf[..], 36, 64, out[..], scratch[..], groups[..]);
  #assert r.ok; #assert r.groups == 1; #assert r.triangles == 12; #assert r.welded == 24;
  #assert groups[0].mat == MAT_FLAT && groups[0].cx == 0 && groups[0].cz == 0 && groups[0].vertices == 24;
  #assert groups[0].lo[0] == 9.5 && groups[0].hi[0] == 10.5 && groups[0].lo[1] == 0 && groups[0].hi[1] == 1;
  #assert r.bytes % 4 == 0 && out[0] == 'g';
}
#test "two materials and two cells make three groups, in material then cell order, the same bytes each time" {
  buf: [108 * VERTEX_WORDS] u32; p: [1] Pen;
  pen_set(p[..], 1, MAT_GLOW, 0, 1, 1); box(buf[..], p[..], frame_at(v3(-10, 0.5, 5), 0), 0.5, 0.5, 0.5);
  pen_set(p[..], 2, MAT_WORLD, 1, 0, 0); box(buf[..], p[..], frame_at(v3(100, 0.5, 5), 0), 0.5, 0.5, 0.5);
  pen_set(p[..], 3, MAT_WORLD, 1, 0, 0); box(buf[..], p[..], frame_at(v3(10, 0.5, 5), 0), 0.5, 0.5, 0.5);
  a: [32768] u8; b: [32768] u8; scratch: [32768] u8; groups: [8] GlbGroup;
  ra := glb_world(buf[..], 108, 64, a[..], scratch[..], groups[..]);
  #assert ra.ok && ra.groups == 3 && ra.welded == 72;
  #assert groups[0].mat == MAT_WORLD && groups[0].cx == 0 && groups[1].mat == MAT_WORLD && groups[1].cx == 1 && groups[2].mat == MAT_GLOW && groups[2].cx == -1;
  rb := glb_world(buf[..], 108, 64, b[..], scratch[..], groups[..]);
  #assert rb.bytes == ra.bytes;
  for k: 0..<ra.bytes { #assert a[k] == b[k]; }
}
#test "the world writer refuses a run that is not whole triangles and a buffer too small" {
  buf: [36 * VERTEX_WORDS] u32; p: [1] Pen; pen_set(p[..], 1, MAT_FLAT, 1, 0, 0);
  box(buf[..], p[..], frame_at(v3(5, 0.5, 5), 0), 0.5, 0.5, 0.5);
  out: [16384] u8; small: [64] u8; scratch: [16384] u8; groups: [4] GlbGroup;
  #assert !glb_world(buf[..], 35, 64, out[..], scratch[..], groups[..]).ok;
  #assert !glb_world(buf[..], 36, 64, small[..], scratch[..], groups[..]).ok;
}
#test "an sRGB byte becomes linear: 0, 1 and the middle grey" {
  #assert glb_linear(0) == 0 && glb_linear(255) == 1;
  m := glb_linear(128); #assert m > 0.2155 && m < 0.2160;
}
