// A reference picture of cel vertices from one camera, drawn in software: flat vertex colour,
// nearest surface, nothing else. The Unreal importer renders the same camera with an unlit
// vertex-colour material, and the two are compared (docs/unreal/2026-11-12-aethyr-to-unreal-
// exporter-spec.md, step 1). It is the same vertex stream the page draws, without the anime
// shading, sky or post pass, so it checks where things are and what colour they carry.
// The projection is Anime Lab's (view_rows): fov is the vertical angle, y is up.
//   coax/bin/coax test --library aethyr/export/raster.coax
#load "../render/cel-mesh.coax";

ExCam :: struct { eye: Point; at: Point; fov: f32; }
EX_NEAR :: 0.1f32;

ExV :: struct { x: f32; y: f32; w: f32; }   // camera space: right, up, ahead

ex_view :: (c: ExCam, p: Point) -> ExV {
  f := unit_or(sub(c.at, c.eye), v3(0, 0, -1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  d := sub(p, c.eye);
  return ExV.{x = dot(r, d), y = dot(up, d), w = dot(f, d)};
}
ex_lerp :: (a: ExV, b: ExV, t: f32) -> ExV { return ExV.{x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t, w = a.w + (b.w - a.w) * t}; }
ex_edge :: (ax: f32, ay: f32, bx: f32, by: f32, px: f32, py: f32) -> f32 { return (bx - ax) * (py - ay) - (by - ay) * (px - ax); }

// One triangle already ahead of the near plane, into the picture.
ex_fill :: (a: ExV, b: ExV, c: ExV, colour: u32, t: f32, aspect: f32, w: int, h: int, px: [] u8, depth: [] f32) {
  fw := cast(f32) w; fh := cast(f32) h;
  ax := (a.x / (a.w * t * aspect) * 0.5 + 0.5) * fw; ay := (0.5 - a.y / (a.w * t) * 0.5) * fh;
  bx := (b.x / (b.w * t * aspect) * 0.5 + 0.5) * fw; by := (0.5 - b.y / (b.w * t) * 0.5) * fh;
  cx := (c.x / (c.w * t * aspect) * 0.5 + 0.5) * fw; cy := (0.5 - c.y / (c.w * t) * 0.5) * fh;
  area := ex_edge(ax, ay, bx, by, cx, cy);
  if area > -0.000001 && area < 0.000001 { return; }
  x0 := cast(int) floor(lo(ax, lo(bx, cx))); x1 := cast(int) floor(hi(ax, hi(bx, cx))) + 1;
  y0 := cast(int) floor(lo(ay, lo(by, cy))); y1 := cast(int) floor(hi(ay, hi(by, cy))) + 1;
  if x0 < 0 { x0 = 0; } if y0 < 0 { y0 = 0; } if x1 > w { x1 = w; } if y1 > h { y1 = h; }
  for y: y0..<y1 { for x: x0..<x1 {
    sx := cast(f32) x + 0.5; sy := cast(f32) y + 0.5;
    wa := ex_edge(bx, by, cx, cy, sx, sy) / area; wb := ex_edge(cx, cy, ax, ay, sx, sy) / area; wc := 1 - wa - wb;
    if wa < 0 || wb < 0 || wc < 0 { continue; }
    inv := wa / a.w + wb / b.w + wc / c.w;   // 1/w is straight on the screen
    i := y * w + x;
    if inv <= depth[i] { continue; }
    depth[i] = inv;
    px[i * 4] = cast,trunc(u8) (colour & 255); px[i * 4 + 1] = cast,trunc(u8) ((colour >> 8) & 255); px[i * 4 + 2] = cast,trunc(u8) ((colour >> 16) & 255); px[i * 4 + 3] = 255;
  } }
}
// The picture: w * h RGBA bytes into px (the pen's sRGB colour, alpha 255 where a surface is and
// 0 where none is), both faces of every triangle drawn. depth is w * h of working room.
ex_raster :: (buf: [] u32, vertices: int, c: ExCam, w: int, h: int, px: [] u8, depth: [] f32) -> bool {
  if w < 1 || h < 1 || px.count < w * h * 4 || depth.count < w * h || vertices * VERTEX_WORDS > buf.count { return false; }
  for i: 0..<w * h { depth[i] = 0; px[i * 4] = 0; px[i * 4 + 1] = 0; px[i * 4 + 2] = 0; px[i * 4 + 3] = 0; }
  t := tan(c.fov * 0.5); aspect := cast(f32) w / cast(f32) h;
  for tri: 0..<vertices / 3 {
    v: [3] ExV; i := tri * 3 * VERTEX_WORDS;
    for k: 0..<3 { v[k] = ex_view(c, v3(f32_from_bits(buf[i + k * VERTEX_WORDS]), f32_from_bits(buf[i + k * VERTEX_WORDS + 1]), f32_from_bits(buf[i + k * VERTEX_WORDS + 2]))); }
    colour := buf[i + 4];
    // clip to the near plane: a triangle becomes none, one or two
    poly: [4] ExV; n := 0;
    for k: 0..<3 {
      a := v[k]; b := v[(k + 1) % 3];
      if a.w >= EX_NEAR { poly[n] = a; n += 1; }
      if (a.w >= EX_NEAR) != (b.w >= EX_NEAR) { poly[n] = ex_lerp(a, b, (EX_NEAR - a.w) / (b.w - a.w)); n += 1; }
    }
    if n < 3 { continue; }
    ex_fill(poly[0], poly[1], poly[2], colour, t, aspect, w, h, px, depth);
    if n == 4 { ex_fill(poly[0], poly[2], poly[3], colour, t, aspect, w, h, px, depth); }
  }
  return true;
}

#test "a red wall ahead fills the middle of the picture and leaves the corners empty" {
  buf: [6 * VERTEX_WORDS] u32; p: [1] Pen; pen_set(p[..], 1, MAT_FLAT, 1, 0, 0);
  quad(buf[..], p[..], v3(-1, -1, -5), v3(1, -1, -5), v3(1, 1, -5), v3(-1, 1, -5));
  px: [16 * 16 * 4] u8; depth: [16 * 16] f32;
  #assert ex_raster(buf[..], 6, ExCam.{eye = v3(0, 0, 0), at = v3(0, 0, -1), fov = 1.0}, 16, 16, px[..], depth[..]);
  mid := (8 * 16 + 8) * 4;
  #assert px[mid] == 255 && px[mid + 1] == 0 && px[mid + 3] == 255;
  #assert px[3] == 0 && px[(15 * 16 + 15) * 4 + 3] == 0;
}
#test "the nearer of two walls wins whichever is drawn first, and a wall behind the camera draws nothing" {
  buf: [18 * VERTEX_WORDS] u32; p: [1] Pen;
  pen_set(p[..], 1, MAT_FLAT, 0, 1, 0); quad(buf[..], p[..], v3(-9, -9, -3), v3(9, -9, -3), v3(9, 9, -3), v3(-9, 9, -3));
  pen_set(p[..], 2, MAT_FLAT, 1, 0, 0); quad(buf[..], p[..], v3(-9, -9, -8), v3(9, -9, -8), v3(9, 9, -8), v3(-9, 9, -8));
  pen_set(p[..], 3, MAT_FLAT, 0, 0, 1); quad(buf[..], p[..], v3(-9, -9, 4), v3(9, -9, 4), v3(9, 9, 4), v3(-9, 9, 4));
  px: [8 * 8 * 4] u8; depth: [8 * 8] f32;
  #assert ex_raster(buf[..], 18, ExCam.{eye = v3(0, 0, 0), at = v3(0, 0, -1), fov = 1.0}, 8, 8, px[..], depth[..]);
  for i: 0..<64 { #assert px[i * 4] == 0 && px[i * 4 + 1] == 255 && px[i * 4 + 2] == 0; }
}
#test "up in the world is up in the picture, and +x is to the right when looking down -z" {
  buf: [12 * VERTEX_WORDS] u32; p: [1] Pen;
  pen_set(p[..], 1, MAT_FLAT, 1, 0, 0); quad(buf[..], p[..], v3(-0.2, 1, -5), v3(0.2, 1, -5), v3(0.2, 1.4, -5), v3(-0.2, 1.4, -5));   // above
  pen_set(p[..], 2, MAT_FLAT, 0, 0, 1); quad(buf[..], p[..], v3(1, -0.2, -5), v3(1.4, -0.2, -5), v3(1.4, 0.2, -5), v3(1, 0.2, -5));   // to the right
  px: [32 * 32 * 4] u8; depth: [32 * 32] f32;
  #assert ex_raster(buf[..], 12, ExCam.{eye = v3(0, 0, 0), at = v3(0, 0, -1), fov = 1.0}, 32, 32, px[..], depth[..]);
  red_y := -1; blue_x := -1;
  for y: 0..<32 { for x: 0..<32 { i := (y * 32 + x) * 4; if px[i] == 255 { red_y = y; } if px[i + 2] == 255 { blue_x = x; } } }
  #assert red_y >= 0 && red_y < 16 && blue_x > 16;
}
