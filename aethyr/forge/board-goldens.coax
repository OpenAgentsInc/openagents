// The realm builder's goldens through its codec (compliance plan step E11, GitHub #13250):
// proto/verse/realm-board-v1.json names every line of a board and of a pick, and holds the bodies
// the builder page and the CLI send and what the server answers them today. This requires:
//   - the profile's "lines" are exactly the reader's keys (aethyr/forge/board.coax BOARD_KEYS), and
//     each example reads as its own kind;
//   - every line of every board and pick is one of those kinds and comes back byte for byte from
//     what the reader gives for it; a row has its feature, a 0 or a 1, a space and its label; a
//     board starts with its plan line;
//   - every request body is what the codec writes for the fields it holds (forge_plan_body,
//     forge_make_body, forge_pick_body), and its keys are its message's in
//     proto/descriptors/verse-doc.pb (builder.proto);
//   - a JSON answer's keys, nested ones too, are its message's (PlanReply, PickReply), and a made
//     realm's answer reads through aethyr/forge/made.coax.
// coax/web/api/test_realm_builder.py sends the same bodies to the API and holds its answers to
// the same file.
//   coax/web/tool.sh aethyr/forge/board-goldens.coax proto/verse/realm-board-v1.json

#import "Basic";
#load "board.coax";
#load "made.coax";
#load "../../coax/lib/proto/importer.coax";
#load "../../coax/lib/proto/golden-keys.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";

BG_FIXTURE_PATH :: "proto/verse/realm-board-v1.json";
BG_DESCRIPTOR_PATH :: "proto/descriptors/verse-doc.pb";
BG_PKG :: ".openagents.verse.doc.v1alpha1.";
BG_ROWS :: 64;
Bg :: struct { bad: int; pass: int; quiet: bool; }
bg_need :: (g: [] Bg, name: string, what: string, ok: bool) -> bool {
  if ok { g[0].pass += 1; return true; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (%)\n", name, what); }
  return false;
}
bg_same :: (g: [] Bg, name: string, what: string, got: string, want: string) {
  if got == want { g[0].pass += 1; return; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (%)\n  got:  %\n  want: %\n", name, what, got, want); }
}
// A line written again from what the reader gives for it: its length in out, or -1.
bg_rebuild :: (l: ForgeBoardLine, out: [] u8) -> int {
  if l.kind < BOARD_PLAN { return -1; }
  keys := BOARD_KEYS;
  n := forge_put(out, forge_put(out, 0, keys[l.kind]), " ");
  if l.kind != BOARD_ROW { return forge_put(out, n, forge_board_text(l)); }
  r := forge_board_row(l);
  if !r.ok || !r.spaced || (r.mark != '0' && r.mark != '1') || r.feature.count == 0 { return -1; }
  n = forge_put(out, forge_put(out, n, r.feature), ifx r.mark == '1' then " 1 " else " 0 ");
  return forge_put(out, n, r.label);
}
// A board's or a pick's lines: every one a named kind, rebuilt the same; first is the first line's kind.
bg_lines :: (g: [] Bg, name: string, text: string, named: [] bool, first: int) {
  _ = bg_need(g, name, "the text ends with a newline and starts with its first line", text.count > 0 && text[text.count - 1] == '\n' && forge_board_line(text, 0).kind == first);
  at := 0; out: [1024] u8;
  while true {
    l := forge_board_line(text, at); at = l.next;
    if l.kind == BOARD_END { break; }
    if !bg_need(g, name, "a line is of a kind the profile names", l.kind >= BOARD_PLAN && named[l.kind]) { continue; }
    n := bg_rebuild(l, out[..]);
    bg_same(g, name, "a line comes back from what the reader gives", ifx n < 0 then "" else cast(string) out[0..<n], l.line);
  }
}
// The setup's keys and values in the body's order: how many.
bg_setup :: (j: Jv, at: int, keys: [] string, values: [] string, pool: [] u8) -> int {
  s := jv_get(j, at, "setup");
  if s < 0 { return 0; }
  n := 0; used := 0;
  for i: 0..<jv_len(j, s) {
    if n >= keys.count { break; }
    e := jv_at(j, s, i);
    keys[n] = jv_key(j, e);
    w := jv_str(j, e, pool[used..<pool.count]);
    values[n] = ifx w < 0 then "" else cast(string) pool[used..<used + w];
    used += ifx w < 0 then 0 else w; n += 1;
  }
  return n;
}
bg_request :: (g: [] Bg, st: [] D_State, name: string, request: string, body: string) {
  nodes: [256] JvNode; j: [1] Jv; buf: [2048] u8; text: [1024] u8; pool: [256] u8; more: [512] u8;
  if !bg_need(g, name, "the body is JSON", jv_parse(j[..], body, nodes[..]) && jv_kind(j[0], 0) == JV_OBJECT) { return; }
  full: [128] u8; fn := forge_put(full[..], forge_put(full[..], 0, BG_PKG), request);
  kn: [256] JvNode;
  why := pk_text_keys(st, cast(string) full[0..<fn], body, false, false, kn[..]);
  if why != "" { g[0].bad += 1; if !g[0].quiet { print("FAIL  % (the body's keys are %'s: %)\n", name, request, why); } } else { g[0].pass += 1; }
  keys: [4] string; values: [4] string;
  sn := bg_setup(j[0], 0, keys[..], values[..], pool[..]);
  on: [BG_ROWS] bool; rows := 0; list := jv_get(j[0], 0, "on");
  for i: 0..<jv_len(j[0], list) { if i < BG_ROWS { on[i] = jv_kind(j[0], jv_at(j[0], list, i)) == JV_TRUE; rows += 1; } }
  w := -1;
  if request == "PlanRequest" {
    pn := jv_str(j[0], jv_get(j[0], 0, "prompt"), text[..]);
    w = forge_plan_body(ifx pn < 0 then "" else cast(string) text[0..<pn], 2000, false, jv_int(j[0], jv_get(j[0], 0, "plan"), 0), on[0..<rows], keys[0..<sn], values[0..<sn], buf[..]);
  } else if request == "MakeRequest" {
    dn := jv_str(j[0], jv_get(j[0], 0, "description"), more[..]);
    w = forge_make_body(jv_int(j[0], jv_get(j[0], 0, "plan"), 0), on[0..<rows], keys[0..<sn], values[0..<sn], ifx dn < 0 then "" else cast(string) more[0..<dn], 400, buf[..]);
  } else if request == "PickRequest" {
    fnn := jv_str(j[0], jv_get(j[0], 0, "field"), more[..]); wn := jv_str(j[0], jv_get(j[0], 0, "words"), text[..]);
    w = forge_pick_body(ifx fnn < 0 then "" else cast(string) more[0..<fnn], ifx wn < 0 then "" else cast(string) text[0..<wn], 200, buf[..]);
  }
  bg_same(g, name, "the body, written by the codec", ifx w < 0 then "" else cast(string) buf[0..<w], body);
}
bg_keys :: (g: [] Bg, st: [] D_State, name: string, leaf: string, text: string) {
  full: [128] u8; fn := forge_put(full[..], forge_put(full[..], 0, BG_PKG), leaf);
  nodes: [1024] JvNode;
  why := pk_text_keys(st, cast(string) full[0..<fn], text, false, false, nodes[..]);
  if why == "" { g[0].pass += 1; return; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (its keys are %'s: %)\n", name, leaf, why); }
}

bg_run :: (text: string, st: [] D_State) -> int {
  nodes: [8192] JvNode; f: [1] Jv;
  if !jv_parse(f[..], text, nodes[..]) { print("FAIL  the fixture is not JSON\n"); return 1; }
  g: [1] Bg; named: [BOARD_KINDS] bool; keys := BOARD_KEYS;
  lines := jv_get(f[0], 0, "lines");
  for i: 0..<jv_len(f[0], lines) {
    e := jv_at(f[0], lines, i);
    kb: [32] u8; kn := jv_str(f[0], jv_get(f[0], e, "key"), kb[..]);
    key := ifx kn < 0 then "" else cast(string) kb[0..<kn];
    kind := -1;
    for k: BOARD_PLAN..<BOARD_KINDS { if keys[k] == key { kind = k; } }
    if !bg_need(g[..], key, "the profile's line is a key the reader knows, named once", kind >= 0 && !named[kind]) { continue; }
    named[kind] = true;
    eb: [256] u8; en := jv_str(f[0], jv_get(f[0], e, "example"), eb[..]);
    l := forge_board_line(ifx en < 0 then "" else cast(string) eb[0..<en], 0);
    ob: [256] u8; n := bg_rebuild(l, ob[..]);
    _ = bg_need(g[..], key, "its example reads as its kind and comes back the same", l.kind == kind && n >= 0 && cast(string) ob[0..<n] == l.line);
  }
  for k: BOARD_PLAN..<BOARD_KINDS { _ = bg_need(g[..], keys[k], "the reader's key is a line the profile names", named[k]); }
  steps := jv_get(f[0], 0, "steps"); boards := 0; picks := 0; bodies := 0;
  for i: 0..<jv_len(f[0], steps) {
    s := jv_at(f[0], steps, i);
    nb: [160] u8; nn := jv_str(f[0], jv_get(f[0], s, "name"), nb[..]); name := ifx nn < 0 then "" else cast(string) nb[0..<nn];
    mb: [32] u8; mn := jv_str(f[0], jv_get(f[0], s, "message"), mb[..]); message := ifx mn < 0 then "" else cast(string) mb[0..<mn];
    qb: [32] u8; qn := jv_str(f[0], jv_get(f[0], s, "request"), qb[..]); request := ifx qn < 0 then "" else cast(string) qb[0..<qn];
    rb: [16384] u8; rn := jv_str(f[0], jv_get(f[0], s, "reply"), rb[..]);
    bb: [4096] u8; bn := jv_str(f[0], jv_get(f[0], s, "body"), bb[..]);
    if !bg_need(g[..], name, "the step has an answer", rn > 0) { continue; }
    reply := cast(string) rb[0..<rn];
    if message == "BoardLines" { bg_lines(g[..], name, reply, named[..], BOARD_PLAN); boards += 1; }
    else if message == "PickLines" { bg_lines(g[..], name, reply, named[..], BOARD_FIELD); picks += 1; }
    else if message == "PlanReply" || message == "PickReply" { bg_keys(g[..], st, name, message, reply); }
    else if message == "MadeLines" { _ = bg_need(g[..], name, "the made realm's lines read", forge_read_made(reply).ok); }
    else if message == "MadeReply" { _ = bg_need(g[..], name, "the made realm's answer reads", forge_read_made_json(reply).ok); }
    else if message == "RouteError" { _ = bg_need(g[..], name, "the refusal is SQL's object", reply.count > 12 && reply[0..<11] == "{\"error\": \""); }
    else if message == "ErrorWords" { _ = bg_need(g[..], name, "the words are text, not JSON", reply[0] != '{'); }
    else { _ = bg_need(g[..], name, "the step names a message this check knows", false); }
    if request != "" && bn >= 0 { bg_request(g[..], st, name, request, cast(string) bb[0..<bn]); bodies += 1; }
  }
  _ = bg_need(g[..], "the fixture", "it holds boards, a pick and request bodies", boards >= 2 && picks >= 1 && bodies >= 8);
  print("% realm board goldens hold, % failed\n", g[0].pass, g[0].bad);
  return ifx g[0].bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else BG_FIXTURE_PATH;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("board-goldens: cannot read the fixture"); return 2; }
  pb: [65536] u8;
  pn := fs_read(BG_DESCRIPTOR_PATH, pb[..]);
  if pn <= 0 { tool_errln("board-goldens: cannot read the descriptor"); return 2; }
  d: [1] PkDescriptor;
  err := pk_load(d[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := d[0].state[..];
  // the checks bite: a row with no 0 or 1, a line of no kind, a body the codec writes otherwise, a key
  // the message lacks; and a good board passes
  all: [BOARD_KINDS] bool; for k: 0..<BOARD_KINDS { all[k] = true; }
  bad := [3] string.["plan 1\nf water 2 Pond\n", "plan 1\nnote x\n", "name A\nplan 1\n"];
  g: [1] Bg;
  for k: 0..<3 {
    g[0] = Bg.{quiet = true};
    bg_lines(g[..], "self", bad[k], all[..], BOARD_PLAN);
    if g[0].bad == 0 { print("FAIL  the check takes a board it should refuse\n"); return 1; }
  }
  g[0] = Bg.{quiet = true};
  bg_request(g[..], st, "self", "PlanRequest", "{\"prompt\": \"x\"}");
  spaced := g[0].bad;
  g[0] = Bg.{quiet = true};
  bg_request(g[..], st, "self", "PlanRequest", "{\"prompt\":\"x\",\"words\":\"y\"}");
  keyed := g[0].bad;
  g[0] = Bg.{quiet = true};
  bg_lines(g[..], "self", "plan 1\nname A\nf water 1 Pond\nwant a dragon\n", all[..], BOARD_PLAN);
  bg_request(g[..], st, "self", "PlanRequest", "{\"prompt\":\"x\",\"plan\":3,\"on\":[true,false],\"setup\":{\"camera\":\"first\"}}");
  if spaced == 0 || keyed == 0 || g[0].bad != 0 { print("FAIL  the check takes a body it should refuse, or refuses a good one\n"); return 1; }
  return bg_run(cast(string) buf[0..<n], st);
}
