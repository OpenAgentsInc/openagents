// Aethyrforge's edits to a realm document (book chapters 51, 52 and 81): every change is a typed
// operation with its inverse, undo and redo walk one log of them, replaying a log from the same
// document gives the same document, and a save names the revision it was made from, so the
// server refuses it when the document changed since (409) instead of letting the newer write win.
//
// Two kinds of thing change (#12629):
//   - an entity, by its override: where it stands (a move), its turn (rotate), its size (resize)
//     and whether it is there (remove). An entity is named by its feature and its index in that
//     feature's layout ("trees:3"), or "placed:N" for the N-th thing placed; the seeded layout
//     keeps the names stable. Places are whole centimetres, turns whole degrees, sizes whole
//     percent, so the same document is the same bytes everywhere. Overrides stand in entity
//     order (by feature, then index: forge_entity_before), as the server keeps them (migration
//     0166), so an undo gives back the bytes it undid (#13354).
//   - a slot: one named value of every other revision path, named as the server's undo log names
//     it (migration 0111). "feature:N" and "row:N" (the N-th board row on, in `features`, and off,
//     in `off`: the row's JSON object), "tool:NAME" (a visitor tool), "set:FIELD" (style, ground,
//     time, camera, palette), "lore:WHO", "quest:GIVER" (ASK|STEP|STEP|STEP|REWARD) and "place:N"
//     (THING X Z YAW, the N-th thing placed). A slot absent is the realm without it.
// One step is one edit; an edit that changes several slots (a board row switched, doc.coax's
// forge_switch) is one step of several ops, `joined` to the first.
// An operation is refused unless what it changes is still as it says it was. Nothing here reads words.
//   coax/bin/coax test aethyr/forge/edit.coax --library

#module "aethyr.forge.edit";

// book:begin doc
FORGE_KEY :: 24;       // an entity's name: "trees:3"
FORGE_MOVES :: 64;     // entities one document overrides (the server's limit too)
FORGE_OPS :: 64;       // undo steps kept; the oldest goes first
FORGE_REACH :: 4000;   // centimetres from the middle an entity may stand (the server's limit too)
FORGE_TURN :: 180;     // degrees an entity turns either way, at most
FORGE_SCALE_MIN :: 25; // percent of its laid-out size, at least
FORGE_SCALE_MAX :: 400;
FORGE_SLOT_KEY :: 48;  // a slot's name: "lore:mara"
FORGE_VAL :: 2400;     // a slot's value bytes at most (a quest: 564 characters of up to four bytes; lore: 400)
FORGE_SLOTS :: 400;    // slots one document keeps (200 placed things, 40 lore, 40 quests, setup, tools, board rows)
FORGE_TEXT :: 65536;   // bytes of slot values the document and its history keep together (40 lore and 40 quests of plain words fit)

// An entity as the document has it: where it stands instead (`at`), its turn and size, and gone.
// The plain shape (nothing overridden) is the entity as laid out.
ForgeShape :: struct { at: bool; x: int; z: int; yaw: int; scale: int = 100; gone: bool; }
ForgeMove :: struct { key: [FORGE_KEY] u8; key_n: int; x: int; z: int; at: bool = true; yaw: int; scale: int = 100; gone: bool; }
// A slot's value is a span of the document's `text`; so are an edit's before and after values.
ForgeSlot :: struct { key: [FORGE_SLOT_KEY] u8; key_n: int; at: int; n: int; }
FORGE_ENTITY :: 0;
FORGE_SLOT :: 1;
// One edit: what it changes, as it was before and after. An entity's shapes (`b`, `a`), or a
// slot's values (`had` false: absent before; `has` false: absent after). `joined`: part of the
// step of the op before it.
ForgeOp :: struct {
  kind: int; joined: bool;
  key: [FORGE_SLOT_KEY] u8; key_n: int;
  b: ForgeShape; a: ForgeShape;
  had: bool; bv: int; bv_n: int;
  has: bool; av: int; av_n: int;
}
ForgeDoc :: struct {
  rev: int;                        // the revision this document was read at, or last saved as
  moves: [FORGE_MOVES] ForgeMove; move_n: int;
  slots: [FORGE_SLOTS] ForgeSlot; slot_n: int;
  text: [FORGE_TEXT] u8; text_n: int;   // the values slots and edits name
  ops: [FORGE_OPS] ForgeOp; op_n: int; done: int;   // the log, and how many of it are applied
  saved: int;                      // `done` when it was last read or saved; -1 when that state is gone
}
// book:end doc

ForgeSpot :: struct { found: bool; x: int; z: int; }

forge_move_key :: (d: [] ForgeDoc, i: int) -> string { return cast(string) d[0].moves[i].key[0..<d[0].moves[i].key_n]; }
forge_slot_key :: (d: [] ForgeDoc, i: int) -> string { return cast(string) d[0].slots[i].key[0..<d[0].slots[i].key_n]; }

forge_lower :: (c: u8) -> bool { return c >= 'a' && c <= 'z'; }
forge_digit :: (c: u8) -> bool { return c >= '0' && c <= '9'; }
// A name the document keeps: a feature's lowercase letters, a colon, an index of one to three digits.
forge_key_ok :: (key: string) -> bool {
  if key.count < 3 || key.count > FORGE_KEY { return false; }
  colon := -1;
  for i: 0..<key.count { if key[i] == ':' { if colon >= 0 { return false; } colon = i; } }
  if colon < 1 || key.count - colon - 1 < 1 || key.count - colon - 1 > 3 { return false; }
  for i: 0..<colon { if !forge_lower(key[i]) { return false; } }
  for i: colon + 1..<key.count { if !forge_digit(key[i]) { return false; } }
  return true;
}
// a stands before b in a document's overrides (forge_key_ok names), as the server orders them
// (migration 0166, verse.realm_by_entity): by feature, bytewise, then by index, then bytewise.
forge_entity_before :: (a: string, b: string) -> bool {
  ca := 0; while ca < a.count && a[ca] != ':' { ca += 1; }
  cb := 0; while cb < b.count && b[cb] != ':' { cb += 1; }
  if a[0..<ca] != b[0..<cb] { return forge_after(b[0..<cb], a[0..<ca]); }
  ia := 0; for i: ca + 1..<a.count { ia = ia * 10 + cast(int) (a[i] - '0'); }
  ib := 0; for i: cb + 1..<b.count { ib = ib * 10 + cast(int) (b[i] - '0'); }
  if ia != ib { return ia < ib; }
  return forge_after(b, a);
}
forge_in_reach :: (x: int, z: int) -> bool { return x >= -FORGE_REACH && x <= FORGE_REACH && z >= -FORGE_REACH && z <= FORGE_REACH; }
// A turn is -179..180 degrees; a size FORGE_SCALE_MIN..FORGE_SCALE_MAX percent.
forge_turn :: (deg: int) -> int { t := deg % 360; if t > 180 { t -= 360; } if t <= -180 { t += 360; } return t; }
forge_shape_ok :: (s: ForgeShape) -> bool {
  return (!s.at || forge_in_reach(s.x, s.z)) && s.yaw == forge_turn(s.yaw) && s.scale >= FORGE_SCALE_MIN && s.scale <= FORGE_SCALE_MAX;
}
forge_plain :: (s: ForgeShape) -> bool { return !s.at && s.yaw == 0 && s.scale == 100 && !s.gone; }
forge_same_shape :: (p: ForgeShape, q: ForgeShape) -> bool {
  return p.at == q.at && (!p.at || (p.x == q.x && p.z == q.z)) && p.yaw == q.yaw && p.scale == q.scale && p.gone == q.gone;
}

// A slot's name: one of its kinds, a colon, and a lowercase name ("row:0", "lore:old-mara").
FORGE_SLOT_KINDS :: [7] string.["row", "feature", "tool", "set", "lore", "quest", "place"];
forge_slot_key_ok :: (key: string) -> bool {
  if key.count > FORGE_SLOT_KEY { return false; }
  colon := 0; while colon < key.count && key[colon] != ':' { colon += 1; }
  kind := key[0..<colon];
  known := false;
  for k: FORGE_SLOT_KINDS { if k == kind { known = true; } }
  if !known || colon + 1 >= key.count { return false; }
  name := key[colon + 1..<key.count];
  if !forge_lower(name[0]) && !forge_digit(name[0]) { return false; }
  for c: name { if !forge_lower(c) && !forge_digit(c) && c != '-' && c != '_' { return false; } }
  return true;
}
// A slot's value: one line, at most FORGE_VAL bytes.
forge_val_ok :: (v: string) -> bool {
  if v.count > FORGE_VAL { return false; }
  for c: v { if c == '\n' || c == '\r' { return false; } }
  return true;
}

// A document read at revision rev with nothing overridden, no slots and no history.
forge_reset :: (d: [] ForgeDoc, rev: int) {
  d[0].rev = rev; d[0].move_n = 0; d[0].slot_n = 0; d[0].text_n = 0; d[0].op_n = 0; d[0].done = 0; d[0].saved = 0;
}

forge_find :: (d: [] ForgeDoc, key: string) -> int {
  for i: 0..<d[0].move_n { if forge_move_key(d, i) == key { return i; } }
  return -1;
}
// An entity's shape: its override, or the plain shape.
forge_shape_of :: (d: [] ForgeDoc, key: string) -> ForgeShape {
  i := forge_find(d, key);
  if i < 0 { return ForgeShape.{}; }
  m := d[0].moves[i];
  return ForgeShape.{at = m.at, x = ifx m.at then m.x else 0, z = ifx m.at then m.z else 0, yaw = m.yaw, scale = m.scale, gone = m.gone};
}
// Where it stands instead, if it was moved.
forge_where :: (d: [] ForgeDoc, key: string) -> ForgeSpot {
  s := forge_shape_of(d, key);
  return ForgeSpot.{found = s.at, x = s.x, z = s.z};
}

// Give key this shape (the plain shape takes its override away). False when it can't be kept.
forge_set_shape :: (d: [] ForgeDoc, key: string, s: ForgeShape) -> bool {
  i := forge_find(d, key);
  if forge_plain(s) {
    if i < 0 { return true; }
    for j: i..<d[0].move_n - 1 { d[0].moves[j] = d[0].moves[j + 1]; }
    d[0].move_n -= 1;
    return true;
  }
  if !forge_key_ok(key) || !forge_shape_ok(s) { return false; }
  if i < 0 {   // a new override goes in entity order
    if d[0].move_n >= FORGE_MOVES { return false; }
    i = 0; while i < d[0].move_n && forge_entity_before(forge_move_key(d, i), key) { i += 1; }
    for j: 0..<d[0].move_n - i { d[0].moves[d[0].move_n - j] = d[0].moves[d[0].move_n - j - 1]; }
    d[0].move_n += 1;
    for k: 0..<key.count { d[0].moves[i].key[k] = key[k]; }
    d[0].moves[i].key_n = key.count;
  }
  d[0].moves[i].at = s.at; d[0].moves[i].x = ifx s.at then s.x else 0; d[0].moves[i].z = ifx s.at then s.z else 0;
  d[0].moves[i].yaw = s.yaw; d[0].moves[i].scale = s.scale; d[0].moves[i].gone = s.gone;
  return true;
}
// Put key at (x, z), or back at its laid-out place when `at` is false; its turn, size and gone stay.
forge_set :: (d: [] ForgeDoc, key: string, at: bool, x: int, z: int) -> bool {
  s := forge_shape_of(d, key);
  s.at = at; s.x = ifx at then x else 0; s.z = ifx at then z else 0;
  if at && (!forge_key_ok(key) || !forge_in_reach(x, z)) { return false; }
  return forge_set_shape(d, key, s);
}

// A move read from the server's document (its "moved" lines): no history.
forge_read_move :: (d: [] ForgeDoc, key: string, x: int, z: int) -> bool { return forge_set(d, key, true, x, z); }
// A shape read from the server's document (its "shaped" lines): no history.
forge_read_shape :: (d: [] ForgeDoc, key: string, yaw: int, scale: int, gone: bool) -> bool {
  s := forge_shape_of(d, key);
  s.yaw = yaw; s.scale = scale; s.gone = gone;
  return forge_key_ok(key) && forge_shape_ok(s) && forge_set_shape(d, key, s);
}

forge_slot_find :: (d: [] ForgeDoc, key: string) -> int {
  for i: 0..<d[0].slot_n { if forge_slot_key(d, i) == key { return i; } }
  return -1;
}
ForgeVal :: struct { found: bool; at: int; }
// Where a slot is, when found.
forge_slot_at :: (d: [] ForgeDoc, key: string) -> ForgeVal {
  i := forge_slot_find(d, key);
  return ForgeVal.{found = i >= 0, at = i};
}
forge_slot_text :: (d: [] ForgeDoc, key: string) -> string {
  v := forge_slot_at(d, key);
  if !v.found { return ""; }
  return forge_span(d, d[0].slots[v.at].at, d[0].slots[v.at].n);
}
forge_span :: (d: [] ForgeDoc, at: int, n: int) -> string { return cast(string) d[0].text[at..<at + n]; }
// Every value still named, packed to the front of `text`: what changed or was undone past the log goes.
forge_pack :: (d: [] ForgeDoc) {
  t: [1] ForgePacked;
  for i: 0..<d[0].slot_n { d[0].slots[i].at = forge_moved(d, t[..], d[0].slots[i].at, d[0].slots[i].n); }
  for i: 0..<d[0].op_n {
    if d[0].ops[i].kind != FORGE_SLOT { continue; }
    d[0].ops[i].bv = forge_moved(d, t[..], d[0].ops[i].bv, d[0].ops[i].bv_n);
    d[0].ops[i].av = forge_moved(d, t[..], d[0].ops[i].av, d[0].ops[i].av_n);
  }
  for k: 0..<t[0].n { d[0].text[k] = t[0].text[k]; }
  d[0].text_n = t[0].n;
}
// A pack in progress: the new text, and where each span already copied went (one copy a span).
ForgePacked :: struct { text: [FORGE_TEXT] u8; n: int; from: [FORGE_SLOTS + 2 * FORGE_OPS] int; size: [FORGE_SLOTS + 2 * FORGE_OPS] int; to: [FORGE_SLOTS + 2 * FORGE_OPS] int; seen: int; }
forge_moved :: (d: [] ForgeDoc, t: [] ForgePacked, at: int, n: int) -> int {
  if n == 0 { return 0; }
  for i: 0..<t[0].seen { if t[0].from[i] == at && t[0].size[i] == n { return t[0].to[i]; } }
  to := t[0].n;
  for k: 0..<n { t[0].text[to + k] = d[0].text[at + k]; }
  t[0].n += n;
  i := t[0].seen; t[0].from[i] = at; t[0].size[i] = n; t[0].to[i] = to; t[0].seen += 1;
  return to;
}
// Keep a value (never a span of `text` itself): its place, or -1 when even packed it doesn't fit.
forge_keep :: (d: [] ForgeDoc, v: string) -> int {
  if d[0].text_n + v.count > FORGE_TEXT { forge_pack(d); }
  if d[0].text_n + v.count > FORGE_TEXT { return -1; }
  at := d[0].text_n;
  for k: 0..<v.count { d[0].text[at + k] = v[k]; }
  d[0].text_n += v.count;
  return at;
}
// Set a slot (or take it away when `on` is false) to a value from outside the document. False when it can't be kept.
forge_set_slot :: (d: [] ForgeDoc, key: string, on: bool, val: string) -> bool {
  if !on { return forge_put_slot(d, key, false, 0, 0); }
  if !forge_slot_key_ok(key) || !forge_val_ok(val) { return false; }
  at := forge_keep(d, val);
  return at >= 0 && forge_put_slot(d, key, true, at, val.count);
}
// Point a slot at a span of `text` (or take it away).
forge_put_slot :: (d: [] ForgeDoc, key: string, on: bool, at: int, n: int) -> bool {
  i := forge_slot_find(d, key);
  if !on {
    if i < 0 { return true; }
    for j: i..<d[0].slot_n - 1 { d[0].slots[j] = d[0].slots[j + 1]; }
    d[0].slot_n -= 1;
    return true;
  }
  if !forge_slot_key_ok(key) { return false; }
  if i < 0 {
    if d[0].slot_n >= FORGE_SLOTS { return false; }
    i = d[0].slot_n; d[0].slot_n += 1;
    for k: 0..<key.count { d[0].slots[i].key[k] = key[k]; }
    d[0].slots[i].key_n = key.count;
  }
  d[0].slots[i].at = at; d[0].slots[i].n = n;
  return true;
}
// A spec's "shaped KEY YAW SCALE 0|1" line (migration 0109; the page's and the CLI's reader): whole
// degrees (any turn up to a full one either way, kept as -179..180), whole percent, 1 when taken away.
// Each entity once, never the plain shape; anything else is false and changes nothing.
forge_read_shape_line :: (d: [] ForgeDoc, line: string) -> bool {
  if line.count < 7 || line[0..<7] != "shaped " { return false; }
  w: [4] string; n := 0; at := 7;
  for i: at..<line.count + 1 {
    if i < line.count && line[i] != ' ' { continue; }
    if n == 4 { return false; }
    w[n] = line[at..<i]; n += 1; at = i + 1;
  }
  if n != 4 || (w[3] != "0" && w[3] != "1") { return false; }
  turn := forge_number(w[1], 360); scale := forge_number(w[2], FORGE_SCALE_MAX);
  if turn == FORGE_NO_NUMBER || scale == FORGE_NO_NUMBER { return false; }
  s := forge_shape_of(d, w[0]);
  if s.yaw != 0 || s.scale != 100 || s.gone || (forge_turn(turn) == 0 && scale == 100 && w[3] == "0") { return false; }   // twice, or no shape
  return forge_read_shape(d, w[0], forge_turn(turn), scale, w[3] == "1");
}
FORGE_NO_NUMBER :: -1000000;
// A whole number of at most `limit` either way, written plainly ("-90", "150"), or FORGE_NO_NUMBER.
forge_number :: (s: string, limit: int) -> int {
  neg := s.count > 1 && s[0] == '-';
  digits := ifx neg then s[1..<s.count] else s;
  if digits.count == 0 || digits.count > 6 { return FORGE_NO_NUMBER; }
  v := 0;
  for c: digits { if !forge_digit(c) { return FORGE_NO_NUMBER; } v = v * 10 + cast(int) (c - '0'); }
  if v > limit { return FORGE_NO_NUMBER; }
  return ifx neg then -v else v;
}
// A slot read from the server: no history.
forge_read_slot :: (d: [] ForgeDoc, key: string, val: string) -> bool { return forge_set_slot(d, key, true, val); }

// book:begin ops
// Apply an edit: refused unless what it changes is still as the edit says it was.
forge_apply :: (d: [] ForgeDoc, o: [] ForgeOp) -> bool {
  key := cast(string) o[0].key[0..<o[0].key_n];
  if o[0].kind == FORGE_ENTITY {
    if !forge_same_shape(forge_shape_of(d, key), o[0].b) { return false; }
    return forge_set_shape(d, key, o[0].a);
  }
  now := forge_slot_at(d, key);
  if now.found != o[0].had { return false; }
  if now.found && forge_slot_text(d, key) != forge_span(d, o[0].bv, o[0].bv_n) { return false; }
  return forge_put_slot(d, key, o[0].has, o[0].av, o[0].av_n);
}
// The edit that takes it back: before and after swapped.
forge_inverse :: (o: ForgeOp) -> ForgeOp {
  r := o;
  r.b = o.a; r.a = o.b;
  r.had = o.has; r.bv = o.av; r.bv_n = o.av_n;
  r.has = o.had; r.av = o.bv; r.av_n = o.bv_n;
  return r;
}
// book:end ops

// Apply o's ops as one undo step, all or none (an op refused takes back those before it). Redo past here is gone.
forge_push :: (d: [] ForgeDoc, o: [] ForgeOp) -> bool {
  if o.count < 1 || o.count > FORGE_OPS { return false; }
  for i: 0..<o.count {
    if !forge_apply(d, o[i..<i + 1]) {
      for k: 0..<i { back: [1] ForgeOp; back[0] = forge_inverse(o[i - 1 - k]); _ = forge_apply(d, back[..]); }
      return false;
    }
  }
  if d[0].saved > d[0].done { d[0].saved = -1; }   // the saved state was undone past and is now unreachable
  d[0].op_n = d[0].done;
  while d[0].op_n + o.count > FORGE_OPS {   // the oldest step goes, every op of it
    drop := 1; while drop < d[0].op_n && d[0].ops[drop].joined { drop += 1; }
    for j: 0..<d[0].op_n - drop { d[0].ops[j] = d[0].ops[j + drop]; }
    d[0].op_n -= drop;
    d[0].saved = ifx d[0].saved >= drop then d[0].saved - drop else -1;
  }
  for i: 0..<o.count { d[0].ops[d[0].op_n] = o[i]; d[0].ops[d[0].op_n].joined = i > 0; d[0].op_n += 1; }
  d[0].done = d[0].op_n;
  return true;
}
forge_key_into :: (o: [] ForgeOp, key: string) {
  for k: 0..<key.count { o[0].key[k] = key[k]; }
  o[0].key_n = key.count;
}
// Change an entity's shape as one step. False when nothing changes or it can't be kept.
forge_reshape :: (d: [] ForgeDoc, key: string, s: ForgeShape) -> bool {
  if !forge_key_ok(key) || !forge_shape_ok(s) { return false; }
  was := forge_shape_of(d, key);
  if forge_same_shape(was, s) { return false; }   // nothing changes
  o: [1] ForgeOp; o[0].kind = FORGE_ENTITY; forge_key_into(o[..], key);
  o[0].b = was; o[0].a = s;
  return forge_push(d, o[..]);
}
// Change a slot as one step. False when nothing changes or it can't be kept.
forge_reslot :: (d: [] ForgeDoc, key: string, on: bool, val: string) -> bool {
  if !forge_slot_key_ok(key) || !forge_val_ok(val) { return false; }
  now := forge_slot_at(d, key);
  if now.found == on && (!on || forge_slot_text(d, key) == val) { return false; }   // nothing changes
  o: [1] ForgeOp; o[0].kind = FORGE_SLOT; forge_key_into(o[..], key);
  o[0].has = on;
  if on { o[0].av = forge_keep(d, val); o[0].av_n = val.count; if o[0].av < 0 { return false; } }   // kept first: it may pack
  if now.found { sl := d[0].slots[forge_slot_find(d, key)]; o[0].bv = sl.at; o[0].bv_n = sl.n; }
  o[0].had = now.found;
  return forge_push(d, o[..]);
}

// book:begin edits
// The edits a made realm has, each one step with its inverse.
forge_move :: (d: [] ForgeDoc, key: string, x: int, z: int) -> bool {
  s := forge_shape_of(d, key); s.at = true; s.x = x; s.z = z;
  return forge_reshape(d, key, s);
}
forge_rotate :: (d: [] ForgeDoc, key: string, deg: int) -> bool {
  s := forge_shape_of(d, key); s.yaw = forge_turn(deg);
  return forge_reshape(d, key, s);
}
forge_resize :: (d: [] ForgeDoc, key: string, percent: int) -> bool {
  s := forge_shape_of(d, key); s.scale = percent;
  return forge_reshape(d, key, s);
}
forge_remove :: (d: [] ForgeDoc, key: string) -> bool {
  s := forge_shape_of(d, key); s.gone = true;
  return forge_reshape(d, key, s);
}
forge_restore :: (d: [] ForgeDoc, key: string) -> bool {
  s := forge_shape_of(d, key); s.gone = false;
  return forge_reshape(d, key, s);
}
// A visitor tool on or off; one of the setup fields. (A board row on or off is doc.coax's
// forge_switch: it reads the rows' objects.)
forge_tool :: (d: [] ForgeDoc, tool: string, on: bool) -> bool { return forge_slot_edit(d, "tool:", tool, true, ifx on then "1" else "0"); }
forge_setting :: (d: [] ForgeDoc, what: string, value: string) -> bool {
  if what != "style" && what != "ground" && what != "time" && what != "camera" && what != "palette" { return false; }
  return forge_slot_edit(d, "set:", what, true, value);
}
// A character's lore ("" forgets it); a giver's quest (ask "" takes it away). No bar in a quest's words.
forge_lore :: (d: [] ForgeDoc, who: string, text: string) -> bool { return forge_slot_edit(d, "lore:", who, text.count > 0, text); }
forge_quest :: (d: [] ForgeDoc, giver: string, asked: string, steps: [3] string, reward: string) -> bool {
  b: [FORGE_VAL] u8; n := 0;
  parts := [5] string.[asked, steps[0], steps[1], steps[2], reward];
  for p: 0..<5 {
    for c: parts[p] { if c == '|' { return false; } }
    if p > 0 { n = forge_put(b[..], n, "|"); }
    n = forge_put(b[..], n, parts[p]);
  }
  if n < 0 { return false; }
  return forge_slot_edit(d, "quest:", giver, asked.count > 0, cast(string) b[0..<n]);
}
// A thing placed: the next "place:N" slot, THING X Z YAW (centimetres, degrees).
forge_place :: (d: [] ForgeDoc, thing: string, x: int, z: int, yaw: int) -> bool {
  if !forge_in_reach(x, z) || thing.count == 0 { return false; }
  for c: thing { if !forge_lower(c) { return false; } }
  kb: [24] u8; n := 0; while forge_slot_at(d, forge_place_key(n, kb[..])).found { n += 1; }
  b: [64] u8; m := forge_put(b[..], 0, thing); m = forge_put(b[..], m, " "); m = forge_put_int(b[..], m, x);
  m = forge_put(b[..], m, " "); m = forge_put_int(b[..], m, z); m = forge_put(b[..], m, " "); m = forge_put_int(b[..], m, forge_turn(yaw));
  if m < 0 { return false; }
  return forge_reslot(d, forge_place_key(n, kb[..]), true, cast(string) b[0..<m]);
}
// book:end edits
forge_place_key :: (n: int, buf: [] u8) -> string {
  m := forge_put(buf, 0, "place:"); m = forge_put_int(buf, m, n);
  return cast(string) buf[0..<m];
}
forge_slot_edit :: (d: [] ForgeDoc, kind: string, name: string, on: bool, val: string) -> bool {
  b: [FORGE_SLOT_KEY + 8] u8; n := forge_put(b[..], 0, kind); n = forge_put(b[..], n, name);
  if n < 0 { return false; }
  return forge_reslot(d, cast(string) b[0..<n], on, val);
}

forge_can_undo :: (d: [] ForgeDoc) -> bool { return d[0].done > 0; }
forge_can_redo :: (d: [] ForgeDoc) -> bool { return d[0].done < d[0].op_n; }
// Undo the newest step, newest op first; redo the next, oldest op first. All of a step or none.
forge_undo :: (d: [] ForgeDoc) -> bool {
  if !forge_can_undo(d) { return false; }
  first := d[0].done - 1; while first > 0 && d[0].ops[first].joined { first -= 1; }
  for i: 0..<d[0].done - first {
    back: [1] ForgeOp; back[0] = forge_inverse(d[0].ops[d[0].done - 1 - i]);
    if !forge_apply(d, back[..]) {
      for k: 0..<i { again: [1] ForgeOp; again[0] = d[0].ops[d[0].done - i + k]; _ = forge_apply(d, again[..]); }
      return false;
    }
  }
  d[0].done = first;
  return true;
}
forge_redo :: (d: [] ForgeDoc) -> bool {
  if !forge_can_redo(d) { return false; }
  last := d[0].done + 1; while last < d[0].op_n && d[0].ops[last].joined { last += 1; }
  for i: d[0].done..<last {
    again: [1] ForgeOp; again[0] = d[0].ops[i];
    if !forge_apply(d, again[..]) {
      for k: 0..<i - d[0].done { back: [1] ForgeOp; back[0] = forge_inverse(d[0].ops[i - 1 - k]); _ = forge_apply(d, back[..]); }
      return false;
    }
  }
  d[0].done = last;
  return true;
}
// book:begin replay
// Replay: the applied steps of `from`, in order, onto `d` as steps of its own. False at the first
// step whose before no longer matches (the document changed under it); the steps before stay.
forge_replay :: (d: [] ForgeDoc, from: [] ForgeDoc) -> bool {
  i := 0;
  while i < from[0].done {
    end := i + 1; while end < from[0].done && from[0].ops[end].joined { end += 1; }
    o: [FORGE_OPS] ForgeOp;
    if !forge_room(d, from, i, end) { return false; }
    for k: i..<end {
      o[k - i] = from[0].ops[k];
      if o[k - i].kind == FORGE_SLOT {   // its values move into this document's text
        if o[k - i].has { o[k - i].av = forge_keep(d, forge_span(from, o[k - i].av, o[k - i].av_n)); }
        if o[k - i].had { o[k - i].bv = forge_keep(d, forge_span(from, o[k - i].bv, o[k - i].bv_n)); }
      }
    }
    if !forge_push(d, o[0..<end - i]) { return false; }
    i = end;
  }
  return true;
}
// Room in d's text for the values of from's ops i..<end (packed first when it needs to be), so
// keeping them packs nothing away: a value kept for an op not yet in the log is named by nothing.
forge_room :: (d: [] ForgeDoc, from: [] ForgeDoc, i: int, end: int) -> bool {
  need := 0;
  for k: i..<end { o := from[0].ops[k]; if o.kind == FORGE_SLOT { if o.has { need += o.av_n; } if o.had { need += o.bv_n; } } }
  if d[0].text_n + need > FORGE_TEXT { forge_pack(d); }
  return d[0].text_n + need <= FORGE_TEXT;
}
// book:end replay
// Changes not yet saved.
forge_dirty :: (d: [] ForgeDoc) -> bool { return d[0].done != d[0].saved; }
// The server kept it as revision rev.
forge_saved :: (d: [] ForgeDoc, rev: int) { d[0].rev = rev; d[0].saved = d[0].done; }
// The server kept it as revision rev, and its undo list now holds the save as one step: the page's
// own steps are done with (the overrides stay).
forge_commit :: (d: [] ForgeDoc, rev: int) { d[0].rev = rev; d[0].op_n = 0; d[0].done = 0; d[0].saved = 0; }
// The same overrides, in the same order: the server's document didn't move anything since.
forge_same_moves :: (a: [] ForgeDoc, b: [] ForgeDoc) -> bool {
  if a[0].move_n != b[0].move_n { return false; }
  for i: 0..<a[0].move_n {
    if forge_move_key(a, i) != forge_move_key(b, i) || !forge_same_shape(forge_shape_of(a, forge_move_key(a, i)), forge_shape_of(b, forge_move_key(b, i))) { return false; }
  }
  return true;
}

// ---- the bodies a client sends (realm.proto: SaveRequest, RevRequest); positions in metres
forge_put :: (buf: [] u8, at: int, text: string) -> int {
  if at < 0 || at + text.count > buf.count { return -1; }
  for i: 0..<text.count { buf[at + i] = text[i]; }
  return at + text.count;
}
forge_put_int :: (buf: [] u8, at: int, v: int) -> int {
  if v < 0 { return forge_put_int(buf, forge_put(buf, at, "-"), -v); }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  o := at;
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; o = forge_put(buf, o, cast(string) e[..]); }
  return o;
}
// Centimetres as metres with two decimals: -250 is "-2.50".
forge_put_cm :: (buf: [] u8, at: int, cm: int) -> int {
  a := ifx cm < 0 then -cm else cm;
  o := ifx cm < 0 then forge_put(buf, at, "-") else at;
  o = forge_put_int(buf, o, a / 100);
  o = forge_put(buf, o, ".");
  if a % 100 < 10 { o = forge_put(buf, o, "0"); }
  return forge_put_int(buf, o, a % 100);
}
// Does any override turn, size or take away its entity (beyond moving it)?
forge_any_shaped :: (d: [] ForgeDoc) -> bool {
  for i: 0..<d[0].move_n { m := d[0].moves[i]; if m.yaw != 0 || m.scale != 100 || m.gone { return true; } }
  return false;
}
// book:begin save
// The body of POST /api/playtest/realms/<slug>/save (proto/openagents/verse/doc/v1alpha1/realm.proto,
// SaveRequest): the revision read, every move in metres, and every turn, size and removal. "shaped"
// is always sent, empty when there are none: without it the server keeps the shapes it had (0109),
// so restoring the last turned, sized or removed entity would not be saved (#13249).
forge_save_body :: (d: [] ForgeDoc, buf: [] u8) -> int {
  n := forge_put(buf, 0, "{\"rev\":"); n = forge_put_int(buf, n, d[0].rev); n = forge_put(buf, n, ",\"moved\":[");
  first := true;
  for i: 0..<d[0].move_n {
    m := d[0].moves[i];
    if !m.at { continue; }
    if !first { n = forge_put(buf, n, ","); }
    first = false;
    n = forge_put(buf, n, "{\"entity\":\""); n = forge_put(buf, n, forge_move_key(d, i));
    n = forge_put(buf, n, "\",\"x\":"); n = forge_put_cm(buf, n, m.x);
    n = forge_put(buf, n, ",\"z\":"); n = forge_put_cm(buf, n, m.z); n = forge_put(buf, n, "}");
  }
  n = forge_put(buf, n, "],\"shaped\":[");
  first = true;
  for i: 0..<d[0].move_n {
    m := d[0].moves[i];
    if m.yaw == 0 && m.scale == 100 && !m.gone { continue; }
    if !first { n = forge_put(buf, n, ","); }
    first = false;
    n = forge_put(buf, n, "{\"entity\":\""); n = forge_put(buf, n, forge_move_key(d, i));
    n = forge_put(buf, n, "\",\"yaw\":"); n = forge_put_int(buf, n, m.yaw);
    n = forge_put(buf, n, ",\"scale\":"); n = forge_put_int(buf, n, m.scale);
    n = forge_put(buf, n, ",\"gone\":"); n = forge_put(buf, n, ifx m.gone then "true" else "false"); n = forge_put(buf, n, "}");
  }
  return forge_put(buf, n, "]}");
}
// The body of POST .../undo, .../redo and .../publish (RevRequest): the revision there now, {"rev":N}.
forge_rev_body :: (rev: int, buf: [] u8) -> int {
  n := forge_put(buf, 0, "{\"rev\":"); n = forge_put_int(buf, n, rev);
  return forge_put(buf, n, "}");
}
// book:end save

// book:begin text
// The whole document as text, every override and slot in name order: two documents are the same
// realm exactly when their texts are the same bytes (replays are compared this way).
forge_doc_text :: (d: [] ForgeDoc, buf: [] u8) -> int {
  n := forge_put(buf, 0, "rev "); n = forge_put_int(buf, n, d[0].rev); n = forge_put(buf, n, "\n");
  last := "";
  for _: 0..<d[0].move_n {   // the next override after `last`, by name
    best := -1;
    for i: 0..<d[0].move_n {
      k := forge_move_key(d, i);
      if forge_after(k, last) && (best < 0 || forge_after(forge_move_key(d, best), k)) { best = i; }
    }
    m := d[0].moves[best]; last = forge_move_key(d, best);
    n = forge_put(buf, n, "entity "); n = forge_put(buf, n, last);
    if m.at { n = forge_put(buf, n, " at "); n = forge_put_int(buf, n, m.x); n = forge_put(buf, n, " "); n = forge_put_int(buf, n, m.z); }
    n = forge_put(buf, n, " yaw "); n = forge_put_int(buf, n, m.yaw); n = forge_put(buf, n, " scale "); n = forge_put_int(buf, n, m.scale);
    n = forge_put(buf, n, ifx m.gone then " gone\n" else "\n");
  }
  last = "";
  for _: 0..<d[0].slot_n {
    best := -1;
    for i: 0..<d[0].slot_n {
      k := forge_slot_key(d, i);
      if forge_after(k, last) && (best < 0 || forge_after(forge_slot_key(d, best), k)) { best = i; }
    }
    last = forge_slot_key(d, best);
    n = forge_put(buf, n, "slot "); n = forge_put(buf, n, last); n = forge_put(buf, n, " ");
    n = forge_put(buf, n, forge_slot_text(d, last)); n = forge_put(buf, n, "\n");
  }
  return n;
}
// book:end text
// a sorts after b (bytewise); "" is before everything.
forge_after :: (a: string, b: string) -> bool {
  for i: 0..<a.count {
    if i >= b.count { return true; }
    if a[i] != b[i] { return a[i] > b[i]; }
  }
  return false;
}

// ---- a scene of placed things (#13226): parameterised by the caller's slices so a small fixture
// and a 4,096-thing world share one typed operation log with compound steps, undo and redo.
// Each atomic change names what stood there before (`had`, `b`) and after (`has`, `a`), is refused
// unless the scene still matches `b`, and undoes by swapping before and after. Compound edits
// (scattering a meadow, moving a group, clearing the world) bracket their changes with
// forge_scene_begin/forge_scene_end so undo and redo step the whole edit at once.

FORGE_SCENE_ITEMS :: 4096;
FORGE_SCENE_OPS :: 8192;
FORGE_SCENE_STEPS :: 128;

FORGE_SCENE_PLACE :: 1;
FORGE_SCENE_MOVE :: 2;
FORGE_SCENE_ROTATE :: 3;
FORGE_SCENE_SCALE :: 4;
FORGE_SCENE_DELETE :: 5;
FORGE_SCENE_DUPLICATE :: 6;
FORGE_SCENE_CLEAR :: 7;
FORGE_SCENE_LAND :: 8;        // a step that changed the land under the things (#13225)
FORGE_LAND_SAMPLE :: 12;      // bytes a land sample keeps: its height's bits, four material ids, four weights
FORGE_LAND_HEAD :: 16;        // a land step's rectangle: i0, j0, width, height (u32 each)

ForgeItem :: struct { id: int; mesh: int; x: f32; y: f32; z: f32; yaw: f32; scale: f32 = 1; }
ForgeItemOp :: struct { kind: int; had: bool; b: ForgeItem; has: bool; a: ForgeItem; }
ForgeStep :: struct { kind: int; first: int; count: int; }
ForgeSceneState :: struct {
  n: int; next_id: int;
  op_n: int; step_n: int; done: int; saved: int;
  open: bool; open_kind: int; open_first: int;
  land_n: int;      // bytes of `land` the land steps hold
  land_rev: int;    // changes whenever the land does (an edit, an undo, a redo)
}
// The land is optional: a scene on a terrain tile (aethyr/world/terrain-tile.coax) hands its samples
// (`land_side` a side: heights by rows from the south, four material ids and four weights a sample)
// and `land`, the bytes its land steps keep. A land step is the rectangle of samples an edit changed,
// as they were before it; undo swaps them with the land's, so the same bytes then hold the edit for redo.
// Item steps index `ops`, land steps index `land`; both stand in one order in `steps`.
ForgeScene :: struct {
  st: [] ForgeSceneState;
  items: [] ForgeItem;
  ops: [] ForgeItemOp;
  steps: [] ForgeStep;
  land_side: int; heights: [] f32; land_ids: [] u8; land_weights: [] u8; land: [] u8;
}

forge_scene_reset :: (s: ForgeScene) {
  s.st[0] = ForgeSceneState.{};
}

forge_same_item :: (p: ForgeItem, q: ForgeItem) -> bool {
  return p.id == q.id && p.mesh == q.mesh && p.x == q.x && p.y == q.y && p.z == q.z && p.yaw == q.yaw && p.scale == q.scale;
}

forge_item_inverse :: (o: ForgeItemOp) -> ForgeItemOp {
  return ForgeItemOp.{kind = o.kind, had = o.has, b = o.a, has = o.had, a = o.b};
}

// Items stand in ascending `id` order so removing and restoring a subset puts every item back where it stood.
forge_scene_lower :: (s: ForgeScene, id: int) -> int {
  lo := 0; hi := s.st[0].n;
  while lo < hi {
    mid := lo + (hi - lo) / 2;
    if s.items[mid].id < id { lo = mid + 1; } else { hi = mid; }
  }
  return lo;
}

forge_scene_find :: (s: ForgeScene, id: int) -> int {
  at := forge_scene_lower(s, id);
  return ifx at < s.st[0].n && s.items[at].id == id then at else -1;
}

// Apply one atomic item operation; refused unless the item is still as the operation says it was.
forge_scene_apply :: (s: ForgeScene, o: ForgeItemOp) -> bool {
  n := s.st[0].n;
  if o.had && o.has {
    if o.b.id != o.a.id { return false; }
    i := forge_scene_find(s, o.b.id);
    if i < 0 || !forge_same_item(s.items[i], o.b) { return false; }
    s.items[i] = o.a;
    return true;
  }
  if !o.had && o.has {
    if n >= s.items.count || forge_scene_find(s, o.a.id) >= 0 { return false; }
    at := forge_scene_lower(s, o.a.id);
    k := n;
    while k > at { s.items[k] = s.items[k - 1]; k -= 1; }
    s.items[at] = o.a;
    s.st[0].n = n + 1;
    if o.a.id >= s.st[0].next_id { s.st[0].next_id = o.a.id + 1; }
    return true;
  }
  if o.had && !o.has {
    i := forge_scene_find(s, o.b.id);
    if i < 0 || !forge_same_item(s.items[i], o.b) { return false; }
    for j: i..<n - 1 { s.items[j] = s.items[j + 1]; }
    s.st[0].n = n - 1;
    return true;
  }
  return false;
}

// Where the first `upto` steps' records end in `ops` (land false) or in `land` (land true).
forge_scene_end_of :: (s: ForgeScene, upto: int, land: bool) -> int {
  k := upto;
  while k > 0 {
    k -= 1;
    if (s.steps[k].kind == FORGE_SCENE_LAND) == land { return s.steps[k].first + s.steps[k].count; }
  }
  return 0;
}
// Drop the oldest committed step to make room in `ops`, `land` or `steps`.
forge_scene_drop_oldest :: (s: ForgeScene) -> bool {
  if s.st[0].step_n <= 0 { return false; }
  drop := s.steps[0].count;
  land := s.steps[0].kind == FORGE_SCENE_LAND;
  if land {
    for j: 0..<s.st[0].land_n - drop { s.land[j] = s.land[j + drop]; }
    s.st[0].land_n -= drop;
  } else {
    for j: 0..<s.st[0].op_n - drop { s.ops[j] = s.ops[j + drop]; }
    s.st[0].op_n -= drop;
    s.st[0].open_first -= drop;
  }
  for k: 0..<s.st[0].step_n - 1 {
    s.steps[k] = s.steps[k + 1];
    if (s.steps[k].kind == FORGE_SCENE_LAND) == land { s.steps[k].first -= drop; }
  }
  s.st[0].step_n -= 1;
  s.st[0].done -= 1;
  s.st[0].saved = ifx s.st[0].saved > 0 then s.st[0].saved - 1 else -1;
  return true;
}
// The redo branch goes: a new change lands after an undo.
forge_scene_branch :: (s: ForgeScene) {
  if s.st[0].done >= s.st[0].step_n { return; }
  if s.st[0].saved > s.st[0].done { s.st[0].saved = -1; }
  s.st[0].op_n = forge_scene_end_of(s, s.st[0].done, false);
  s.st[0].land_n = forge_scene_end_of(s, s.st[0].done, true);
  s.st[0].step_n = s.st[0].done;
}

// Start a compound edit step (`scatter`, multi-object `move`/`delete`, `clear`). The redo branch
// past `done` goes only when the step's first change lands (forge_scene_push), so an edit that
// changes nothing ("delete the rocks" in a world with none) leaves redo as it was.
forge_scene_begin :: (s: ForgeScene, kind: int) {
  if s.st[0].open { return; }
  s.st[0].open = true;
  s.st[0].open_kind = kind;
  s.st[0].open_first = forge_scene_end_of(s, s.st[0].done, false);
}
// The open step's changes so far (none while the redo branch still stands: nothing was pushed).
forge_scene_open_count :: (s: ForgeScene) -> int {
  return ifx s.st[0].done < s.st[0].step_n then 0 else s.st[0].op_n - s.st[0].open_first;
}

// Commit the open step as one undo entry; an edit that changed nothing leaves no undo entry.
forge_scene_end :: (s: ForgeScene) -> bool {
  if !s.st[0].open { return false; }
  count := forge_scene_open_count(s);
  if count <= 0 { s.st[0].open = false; return false; }
  if s.steps.count <= 0 { return false; }
  while s.st[0].step_n >= s.steps.count {
    if !forge_scene_drop_oldest(s) { return false; }
  }
  s.steps[s.st[0].step_n] = ForgeStep.{kind = s.st[0].open_kind, first = s.st[0].open_first, count = count};
  s.st[0].step_n += 1;
  s.st[0].done = s.st[0].step_n;
  s.st[0].open = false;
  return true;
}

forge_scene_cancel :: (s: ForgeScene) {
  if !s.st[0].open { return; }
  if forge_scene_open_count(s) == 0 { s.st[0].open = false; return; }
  k := s.st[0].op_n;
  while k > s.st[0].open_first {
    k -= 1;
    ok := forge_scene_apply(s, forge_item_inverse(s.ops[k]));
  }
  s.st[0].op_n = s.st[0].open_first;
  s.st[0].open = false;
}

// Record and apply one atomic operation: inside the open compound step, or as a one-op step of its own.
forge_scene_push :: (s: ForgeScene, o: ForgeItemOp) -> bool {
  if s.ops.count <= 0 || s.steps.count <= 0 { return false; }
  grouped := s.st[0].open;
  if !grouped { forge_scene_begin(s, o.kind); }
  if !forge_scene_apply(s, o) {
    if !grouped { s.st[0].open = false; }
    return false;
  }
  forge_scene_branch(s);   // the first change of a step made after an undo: the redo branch goes
  while s.st[0].op_n >= s.ops.count {
    if !forge_scene_drop_oldest(s) {   // one step bigger than the whole log: take the change back
      _ = forge_scene_apply(s, forge_item_inverse(o));
      if !grouped { forge_scene_cancel(s); }
      return false;
    }
  }
  s.ops[s.st[0].op_n] = o;
  s.st[0].op_n += 1;
  return ifx grouped then true else forge_scene_end(s);
}

// Read an item from a saved scene with no undo history.
forge_scene_load :: (s: ForgeScene, mesh: int, x: f32, y: f32, z: f32, yaw: f32, scale: f32) -> int {
  if s.st[0].n >= s.items.count { return -1; }
  id := s.st[0].next_id; s.st[0].next_id += 1;
  s.items[s.st[0].n] = ForgeItem.{id = id, mesh = mesh, x = x, y = y, z = z, yaw = yaw, scale = scale};
  s.st[0].n += 1;
  return id;
}

forge_scene_add_op :: (s: ForgeScene, kind: int, mesh: int, x: f32, y: f32, z: f32, yaw: f32, scale: f32) -> int {
  if s.st[0].n >= s.items.count { return -1; }
  id := s.st[0].next_id;
  item := ForgeItem.{id = id, mesh = mesh, x = x, y = y, z = z, yaw = yaw, scale = scale};
  if !forge_scene_push(s, ForgeItemOp.{kind = kind, has = true, a = item}) { return -1; }
  return id;
}

forge_scene_place :: (s: ForgeScene, mesh: int, x: f32, y: f32, z: f32, yaw: f32, scale: f32) -> int {
  return forge_scene_add_op(s, FORGE_SCENE_PLACE, mesh, x, y, z, yaw, scale);
}

forge_scene_duplicate :: (s: ForgeScene, mesh: int, x: f32, y: f32, z: f32, yaw: f32, scale: f32) -> int {
  return forge_scene_add_op(s, FORGE_SCENE_DUPLICATE, mesh, x, y, z, yaw, scale);
}

forge_scene_reshape :: (s: ForgeScene, kind: int, id: int, next: ForgeItem) -> bool {
  i := forge_scene_find(s, id);
  if i < 0 { return false; }
  was := s.items[i];
  if forge_same_item(was, next) { return false; }
  return forge_scene_push(s, ForgeItemOp.{kind = kind, had = true, b = was, has = true, a = next});
}

forge_scene_move :: (s: ForgeScene, id: int, x: f32, y: f32, z: f32) -> bool {
  i := forge_scene_find(s, id);
  if i < 0 { return false; }
  next := s.items[i]; next.x = x; next.y = y; next.z = z;
  return forge_scene_reshape(s, FORGE_SCENE_MOVE, id, next);
}

forge_scene_rotate :: (s: ForgeScene, id: int, yaw: f32) -> bool {
  i := forge_scene_find(s, id);
  if i < 0 { return false; }
  next := s.items[i]; next.yaw = yaw;
  return forge_scene_reshape(s, FORGE_SCENE_ROTATE, id, next);
}

forge_scene_scale :: (s: ForgeScene, id: int, scale: f32) -> bool {
  i := forge_scene_find(s, id);
  if i < 0 { return false; }
  next := s.items[i]; next.scale = scale;
  return forge_scene_reshape(s, FORGE_SCENE_SCALE, id, next);
}

forge_scene_delete :: (s: ForgeScene, id: int) -> bool {
  i := forge_scene_find(s, id);
  if i < 0 { return false; }
  return forge_scene_push(s, ForgeItemOp.{kind = FORGE_SCENE_DELETE, had = true, b = s.items[i]});
}

forge_scene_clear :: (s: ForgeScene) -> int {
  if s.st[0].n == 0 { return 0; }
  grouped := s.st[0].open;
  if !grouped { forge_scene_begin(s, FORGE_SCENE_CLEAR); }
  removed := 0;
  while s.st[0].n > 0 {
    last := s.items[s.st[0].n - 1];
    if !forge_scene_push(s, ForgeItemOp.{kind = FORGE_SCENE_CLEAR, had = true, b = last}) { break; }
    removed += 1;
  }
  if !grouped { ok := forge_scene_end(s); }
  return removed;
}

forge_scene_can_undo :: (s: ForgeScene) -> bool { return !s.st[0].open && s.st[0].done > 0; }
forge_scene_can_redo :: (s: ForgeScene) -> bool { return !s.st[0].open && s.st[0].done < s.st[0].step_n; }
forge_scene_dirty :: (s: ForgeScene) -> bool { return s.st[0].done != s.st[0].saved; }
forge_scene_saved :: (s: ForgeScene) { s.st[0].saved = s.st[0].done; }

forge_scene_undo :: (s: ForgeScene) -> bool {
  if !forge_scene_can_undo(s) { return false; }
  st := s.steps[s.st[0].done - 1];
  if st.kind == FORGE_SCENE_LAND {
    if !forge_scene_land_swap(s, st) { return false; }
    s.st[0].done -= 1;
    return true;
  }
  k := st.first + st.count;
  while k > st.first {
    k -= 1;
    if !forge_scene_apply(s, forge_item_inverse(s.ops[k])) {
      // roll forward anything already inverted in this step
      for j: k + 1..<st.first + st.count { ok := forge_scene_apply(s, s.ops[j]); }
      return false;
    }
  }
  s.st[0].done -= 1;
  return true;
}

forge_scene_redo :: (s: ForgeScene) -> bool {
  if !forge_scene_can_redo(s) { return false; }
  st := s.steps[s.st[0].done];
  if st.kind == FORGE_SCENE_LAND {
    if !forge_scene_land_swap(s, st) { return false; }
    s.st[0].done += 1;
    return true;
  }
  for k: st.first..<st.first + st.count {
    if !forge_scene_apply(s, s.ops[k]) {
      j := k;
      while j > st.first { j -= 1; ok := forge_scene_apply(s, forge_item_inverse(s.ops[j])); }
      return false;
    }
  }
  s.st[0].done += 1;
  return true;
}

// ---- the land's steps

forge_land_ok :: (s: ForgeScene) -> bool {
  p := s.land_side * s.land_side;
  return s.land_side >= 2 && s.heights.count == p && s.land_ids.count == p * 4 && s.land_weights.count == p * 4;
}
forge_land_u32 :: (b: [] u8, at: int) -> int { return cast(int) b[at] | (cast(int) b[at + 1] << 8) | (cast(int) b[at + 2] << 16) | (cast(int) b[at + 3] << 24); }
forge_land_put_u32 :: (b: [] u8, at: int, v: int) { for k: 0..<4 { b[at + k] = cast(u8) ((v >> (k * 8)) & 255); } }
// A land step's samples and the land's own change places.
forge_scene_land_swap :: (s: ForgeScene, st: ForgeStep) -> bool {
  if !forge_land_ok(s) || st.count < FORGE_LAND_HEAD || st.first + st.count > s.st[0].land_n { return false; }
  i0 := forge_land_u32(s.land, st.first); j0 := forge_land_u32(s.land, st.first + 4);
  w := forge_land_u32(s.land, st.first + 8); h := forge_land_u32(s.land, st.first + 12);
  if w < 1 || h < 1 || i0 + w > s.land_side || j0 + h > s.land_side || st.count != FORGE_LAND_HEAD + w * h * FORGE_LAND_SAMPLE { return false; }
  at := st.first + FORGE_LAND_HEAD;
  for j: j0..<j0 + h { for i: i0..<i0 + w {
    k := j * s.land_side + i;
    kept := forge_land_u32(s.land, at);
    forge_land_put_u32(s.land, at, cast(int) f32_bits(s.heights[k]));
    s.heights[k] = f32_from_bits(cast(u32) kept);
    for q: 0..<4 {
      a := s.land[at + 4 + q]; s.land[at + 4 + q] = s.land_ids[k * 4 + q]; s.land_ids[k * 4 + q] = a;
      b := s.land[at + 8 + q]; s.land[at + 8 + q] = s.land_weights[k * 4 + q]; s.land_weights[k * 4 + q] = b;
    }
    at += FORGE_LAND_SAMPLE;
  } }
  s.st[0].land_rev += 1;
  return true;
}
forge_land_same :: (s: ForgeScene, was_h: [] f32, was_ids: [] u8, was_w: [] u8, k: int) -> bool {
  if f32_bits(s.heights[k]) != f32_bits(was_h[k]) { return false; }
  for q: 0..<4 { if s.land_ids[k * 4 + q] != was_ids[k * 4 + q] || s.land_weights[k * 4 + q] != was_w[k * 4 + q] { return false; } }
  return true;
}
// Record a land edit already made in place as one step. `was_*` are the land as it stood before
// the edit; samples i0..i1 by j0..j1 (both ends in) are where it may differ. The step keeps the
// smallest rectangle that holds every changed sample; an edit that changed none leaves no step
// (false). An edit too big for `land` even alone is taken back, and false.
forge_scene_land_step :: (s: ForgeScene, was_h: [] f32, was_ids: [] u8, was_w: [] u8, i0: int, j0: int, i1: int, j1: int) -> bool {
  if !forge_land_ok(s) || s.st[0].open || s.steps.count <= 0 { return false; }
  if was_h.count != s.heights.count || was_ids.count != s.land_ids.count || was_w.count != s.land_weights.count { return false; }
  side := s.land_side;
  a0 := ifx i0 < 0 then 0 else i0; b0 := ifx j0 < 0 then 0 else j0;
  a1 := ifx i1 > side - 1 then side - 1 else i1; b1 := ifx j1 > side - 1 then side - 1 else j1;
  lo_i := side; hi_i := -1; lo_j := side; hi_j := -1;
  for j: b0..<b1 + 1 { for i: a0..<a1 + 1 {
    if forge_land_same(s, was_h, was_ids, was_w, j * side + i) { continue; }
    if i < lo_i { lo_i = i; } if i > hi_i { hi_i = i; }
    if j < lo_j { lo_j = j; } if j > hi_j { hi_j = j; }
  } }
  if hi_i < 0 { return false; }
  w := hi_i - lo_i + 1; h := hi_j - lo_j + 1;
  need := FORGE_LAND_HEAD + w * h * FORGE_LAND_SAMPLE;
  forge_scene_branch(s);
  while need <= s.land.count && (s.st[0].land_n + need > s.land.count || s.st[0].step_n >= s.steps.count) {
    if !forge_scene_drop_oldest(s) { break; }
  }
  if s.st[0].land_n + need > s.land.count || s.st[0].step_n >= s.steps.count {
    for j: lo_j..<hi_j + 1 { for i: lo_i..<hi_i + 1 {
      k := j * side + i;
      s.heights[k] = was_h[k];
      for q: 0..<4 { s.land_ids[k * 4 + q] = was_ids[k * 4 + q]; s.land_weights[k * 4 + q] = was_w[k * 4 + q]; }
    } }
    return false;
  }
  first := s.st[0].land_n;
  forge_land_put_u32(s.land, first, lo_i); forge_land_put_u32(s.land, first + 4, lo_j);
  forge_land_put_u32(s.land, first + 8, w); forge_land_put_u32(s.land, first + 12, h);
  at := first + FORGE_LAND_HEAD;
  for j: lo_j..<hi_j + 1 { for i: lo_i..<hi_i + 1 {
    k := j * side + i;
    forge_land_put_u32(s.land, at, cast(int) f32_bits(was_h[k]));
    for q: 0..<4 { s.land[at + 4 + q] = was_ids[k * 4 + q]; s.land[at + 8 + q] = was_w[k * 4 + q]; }
    at += FORGE_LAND_SAMPLE;
  } }
  s.st[0].land_n = first + need;
  s.steps[s.st[0].step_n] = ForgeStep.{kind = FORGE_SCENE_LAND, first = first, count = need};
  s.st[0].step_n += 1;
  s.st[0].done = s.st[0].step_n;
  s.st[0].land_rev += 1;
  return true;
}

// Replay the applied item steps of `from` onto `s` as steps of its own; false at the first step whose
// before diverges, and at a land step (the land's samples aren't in the log to replay).
forge_scene_replay :: (s: ForgeScene, from: ForgeScene) -> bool {
  for i: 0..<from.st[0].done {
    st := from.steps[i];
    if st.kind == FORGE_SCENE_LAND { return false; }
    forge_scene_begin(s, st.kind);
    for k: st.first..<st.first + st.count {
      if !forge_scene_push(s, from.ops[k]) { forge_scene_cancel(s); return false; }
    }
    if !forge_scene_end(s) { return false; }
  }
  return true;
}

#test "a name is a feature, a colon and an index" {
  #assert forge_key_ok("trees:3") && forge_key_ok("rocks:120") && forge_key_ok("a:0") && forge_key_ok("placed:7");
  #assert !forge_key_ok("trees") && !forge_key_ok(":3") && !forge_key_ok("trees:") && !forge_key_ok("Trees:3");
  #assert !forge_key_ok("trees:1234") && !forge_key_ok("trees:3:4") && !forge_key_ok("tr ees:3") && !forge_key_ok("trees:x");
  #assert forge_in_reach(4000, -4000) && !forge_in_reach(4001, 0) && !forge_in_reach(0, -4001);
}

#test "a move, its undo and its redo" {
  d: [1] ForgeDoc; forge_reset(d[..], 7);
  #assert !forge_dirty(d[..]) && !forge_can_undo(d[..]) && !forge_can_redo(d[..]);
  #assert forge_move(d[..], "trees:3", 125, -250);
  w := forge_where(d[..], "trees:3");
  #assert w.found && w.x == 125 && w.z == -250 && forge_dirty(d[..]) && forge_can_undo(d[..]);
  #assert !forge_move(d[..], "trees:3", 125, -250);   // no change, no step
  #assert forge_undo(d[..]) && !forge_where(d[..], "trees:3").found && d[0].move_n == 0 && !forge_dirty(d[..]);
  #assert !forge_undo(d[..]) && forge_can_redo(d[..]);
  #assert forge_redo(d[..]) && forge_where(d[..], "trees:3").x == 125 && forge_dirty(d[..]) && !forge_redo(d[..]);
}

#test "an undo of a second move puts back the first, not the laid-out place" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  #assert forge_move(d[..], "trees:0", 100, 100) && forge_move(d[..], "trees:0", 300, -300) && forge_move(d[..], "trees:1", 5, 5);
  #assert forge_undo(d[..]) && !forge_where(d[..], "trees:1").found;
  #assert forge_undo(d[..]);
  w := forge_where(d[..], "trees:0");
  #assert w.found && w.x == 100 && w.z == 100;
  #assert forge_move(d[..], "trees:2", 0, 0) && !forge_can_redo(d[..]) && d[0].op_n == 2;   // a new move drops what was undone
}

#test "an edit is refused when its entity no longer stands where it says" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  #assert forge_read_move(d[..], "trees:4", 10, 20);
  o: [1] ForgeOp; o[0].kind = FORGE_ENTITY; forge_key_into(o[..], "trees:4");
  o[0].b = ForgeShape.{at = true, x = 11, z = 20}; o[0].a = ForgeShape.{at = true, x = 0, z = 0};
  #assert !forge_apply(d[..], o[..]) && forge_where(d[..], "trees:4").x == 10;
  o[0].b.x = 10;
  inv: [1] ForgeOp; inv[0] = forge_inverse(o[0]);
  #assert forge_apply(d[..], o[..]) && forge_apply(d[..], inv[..]) && forge_where(d[..], "trees:4").x == 10;
  o[0].b.at = false;
  #assert !forge_apply(d[..], o[..]);
  #assert !forge_move(d[..], "trees:4", 4001, 0) && !forge_move(d[..], "nope", 0, 0);
}

#test "apply then its inverse leaves the document as it was" {
  d: [1] ForgeDoc; forge_reset(d[..], 3);
  #assert forge_read_move(d[..], "rocks:1", -40, 70) && forge_read_move(d[..], "trees:2", 900, -900);
  before: [512] u8; bn := forge_save_body(d[..], before[..]);
  for step: 0..<6 {
    x := step * 37 - 100; z := 250 - step * 91;
    #assert forge_move(d[..], ifx step % 2 == 0 then "trees:2" else "trees:9", x, z);
  }
  for step: 0..<6 { #assert forge_undo(d[..]); }
  after: [512] u8; an := forge_save_body(d[..], after[..]);
  #assert bn > 0 && cast(string) before[0..<bn] == cast(string) after[0..<an] && !forge_dirty(d[..]);
}

#test "saved is a state of the log: undo past it and it is dirty, a new branch loses it" {
  d: [1] ForgeDoc; forge_reset(d[..], 4);
  #assert forge_move(d[..], "trees:0", 1, 1);
  forge_saved(d[..], 5);
  #assert !forge_dirty(d[..]) && d[0].rev == 5;
  #assert forge_undo(d[..]) && forge_dirty(d[..]) && forge_redo(d[..]) && !forge_dirty(d[..]);
  #assert forge_undo(d[..]) && forge_move(d[..], "trees:0", 2, 2) && forge_dirty(d[..]) && d[0].saved == -1;
  #assert forge_undo(d[..]) && forge_dirty(d[..]);   // the saved state is gone for good
}

#test "a save committed ends the page's own steps and keeps the moves" {
  d: [1] ForgeDoc; forge_reset(d[..], 4);
  #assert forge_move(d[..], "rocks:1", 50, -50) && forge_move(d[..], "props:0", 1, 2);
  forge_commit(d[..], 5);
  #assert d[0].rev == 5 && !forge_dirty(d[..]) && !forge_can_undo(d[..]) && !forge_can_redo(d[..]) && d[0].move_n == 2;
  #assert forge_where(d[..], "props:0").z == 2 && forge_move(d[..], "props:0", 3, 3) && forge_dirty(d[..]) && forge_undo(d[..]) && !forge_dirty(d[..]);
}

#test "the same moves are the same keys, places and order" {
  a: [1] ForgeDoc; b: [1] ForgeDoc; forge_reset(a[..], 1); forge_reset(b[..], 9);
  #assert forge_same_moves(a[..], b[..]);
  #assert forge_read_move(a[..], "trees:1", 5, 6) && !forge_same_moves(a[..], b[..]);
  #assert forge_read_move(b[..], "trees:1", 5, 6) && forge_same_moves(a[..], b[..]);
  #assert forge_read_move(b[..], "trees:1", 5, 7) && !forge_same_moves(a[..], b[..]);
  #assert forge_read_move(b[..], "trees:1", 5, 6) && forge_read_move(a[..], "rocks:0", 0, 0) && forge_read_move(b[..], "rocks:1", 0, 0) && !forge_same_moves(a[..], b[..]);
  c: [1] ForgeDoc; e: [1] ForgeDoc; forge_reset(c[..], 1); forge_reset(e[..], 1);
  #assert forge_read_move(c[..], "trees:1", 5, 6) && forge_read_move(e[..], "trees:1", 5, 6) && forge_same_moves(c[..], e[..]);
  #assert forge_read_shape(e[..], "trees:1", 90, 100, false) && !forge_same_moves(c[..], e[..]);
}

#test "the log keeps its last FORGE_OPS steps" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  for i: 0..<FORGE_OPS + 5 { #assert forge_move(d[..], "trees:0", i + 1, 0); }
  #assert d[0].op_n == FORGE_OPS && d[0].done == FORGE_OPS && d[0].saved == -1;
  for i: 0..<FORGE_OPS { #assert forge_undo(d[..]); }
  #assert !forge_undo(d[..]) && forge_where(d[..], "trees:0").x == 5;   // the five oldest steps are gone
}

#test "a document keeps at most FORGE_MOVES overridden entities" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  for i: 0..<FORGE_MOVES {
    b: [8] u8; n := forge_put(b[..], 0, "t:"); n = forge_put_int(b[..], n, i);
    #assert forge_read_move(d[..], cast(string) b[0..<n], i, i);
  }
  #assert !forge_read_move(d[..], "t:999", 0, 0) && !forge_move(d[..], "t:998", 0, 0) && forge_move(d[..], "t:5", 0, 0);
  #assert !forge_rotate(d[..], "t:997", 90) && forge_rotate(d[..], "t:6", 90);
}

#test "the save names its revision and every move, in metres" {
  d: [1] ForgeDoc; forge_reset(d[..], 12);
  b: [256] u8;
  n := forge_save_body(d[..], b[..]);
  #assert cast(string) b[0..<n] == "{\"rev\":12,\"moved\":[],\"shaped\":[]}";
  #assert forge_move(d[..], "trees:3", 125, -250) && forge_move(d[..], "rocks:0", -5, 7);
  n = forge_save_body(d[..], b[..]);
  #assert cast(string) b[0..<n] == "{\"rev\":12,\"moved\":[{\"entity\":\"rocks:0\",\"x\":-0.05,\"z\":0.07},{\"entity\":\"trees:3\",\"x\":1.25,\"z\":-2.50}],\"shaped\":[]}";   // in entity order
  small: [10] u8;
  #assert forge_save_body(d[..], small[..]) < 0;
  // a restore of the last shaped entity is sent as no shapes, so the server drops it too
  #assert forge_remove(d[..], "rocks:0") && forge_restore(d[..], "rocks:0") && !forge_any_shaped(d[..]);
  n = forge_save_body(d[..], b[..]);
  #assert cast(string) b[n - 12..<n] == "\"shaped\":[]}";
  #assert forge_rev_body(7, b[..]) == 9 && cast(string) b[0..<9] == "{\"rev\":7}" && forge_rev_body(123, small[..]) < 0;
}

#test "rotate, resize and remove are overrides with inverses; moving keeps them" {
  d: [1] ForgeDoc; forge_reset(d[..], 2);
  #assert forge_rotate(d[..], "trees:1", 450) && forge_shape_of(d[..], "trees:1").yaw == 90 && !forge_where(d[..], "trees:1").found;
  #assert !forge_rotate(d[..], "trees:1", 90) && forge_rotate(d[..], "trees:1", -180) && forge_shape_of(d[..], "trees:1").yaw == 180;
  #assert forge_resize(d[..], "trees:1", 150) && !forge_resize(d[..], "trees:1", 24) && !forge_resize(d[..], "trees:1", 401) && forge_resize(d[..], "trees:1", 400);
  #assert forge_move(d[..], "trees:1", 10, 20);
  s := forge_shape_of(d[..], "trees:1");
  #assert s.at && s.x == 10 && s.yaw == 180 && s.scale == 400 && !s.gone;
  #assert forge_remove(d[..], "trees:1") && forge_shape_of(d[..], "trees:1").gone && !forge_remove(d[..], "trees:1");
  #assert forge_restore(d[..], "trees:1") && !forge_shape_of(d[..], "trees:1").gone;
  b: [512] u8; n := forge_save_body(d[..], b[..]);
  #assert cast(string) b[0..<n] == "{\"rev\":2,\"moved\":[{\"entity\":\"trees:1\",\"x\":0.10,\"z\":0.20}],\"shaped\":[{\"entity\":\"trees:1\",\"yaw\":180,\"scale\":400,\"gone\":false}]}";
  for i: 0..<7 { #assert forge_undo(d[..]); }
  #assert d[0].move_n == 0 && !forge_undo(d[..]) && !forge_dirty(d[..]);
  // only turned: no move in the body, a shape
  #assert forge_remove(d[..], "rocks:2");
  n = forge_save_body(d[..], b[..]);
  #assert cast(string) b[0..<n] == "{\"rev\":2,\"moved\":[],\"shaped\":[{\"entity\":\"rocks:2\",\"yaw\":0,\"scale\":100,\"gone\":true}]}";
  #assert forge_read_shape(d[..], "rocks:3", 30, 50, false) && !forge_read_shape(d[..], "rocks:4", 0, 20, false) && !forge_read_shape(d[..], "rocks:4", 200, 100, false);
}

#test "every other revision path is a slot edit with an inverse" {
  d: [1] ForgeDoc; forge_reset(d[..], 5);
  #assert forge_read_slot(d[..], "set:time", "day") && forge_read_slot(d[..], "tool:fly", "0");
  #assert forge_setting(d[..], "time", "night") && !forge_setting(d[..], "weather", "rain") && forge_tool(d[..], "fly", true);
  #assert forge_lore(d[..], "mara", "She keeps the lighthouse.") && forge_slot_text(d[..], "lore:mara") == "She keeps the lighthouse.";
  #assert !forge_lore(d[..], "Mara", "x") && !forge_lore(d[..], "mara", "two\nlines");
  steps := [3] string.["Find the lamp", "", "Bring it back"];
  #assert forge_quest(d[..], "mara", "Light the lamp", steps, "A map");
  #assert forge_slot_text(d[..], "quest:mara") == "Light the lamp|Find the lamp||Bring it back|A map";
  #assert !forge_quest(d[..], "mara", "a|b", steps, "");
  #assert forge_place(d[..], "barrel", 200, -300, 450) && forge_place(d[..], "crate", 0, 0, 0);
  #assert forge_slot_text(d[..], "place:0") == "barrel 200 -300 90" && forge_slot_text(d[..], "place:1") == "crate 0 0 0";
  #assert !forge_place(d[..], "Barrel", 0, 0, 0) && !forge_place(d[..], "barrel", 4001, 0, 0);
  #assert forge_lore(d[..], "mara", "") && !forge_slot_at(d[..], "lore:mara").found;
  #assert d[0].done == 7;
  for i: 0..<7 { #assert forge_undo(d[..]); }
  t: [1024] u8; n := forge_doc_text(d[..], t[..]);
  #assert cast(string) t[0..<n] == "rev 5\nslot set:time day\nslot tool:fly 0\n";
  for i: 0..<7 { #assert forge_redo(d[..]); }
  #assert forge_slot_text(d[..], "place:1") == "crate 0 0 0" && !forge_slot_at(d[..], "lore:mara").found && forge_slot_text(d[..], "set:time") == "night";
}

#test "a slot edit is refused when the slot isn't as it says" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  #assert forge_read_slot(d[..], "set:time", "day");
  o: [1] ForgeOp; o[0].kind = FORGE_SLOT; forge_key_into(o[..], "set:time");
  o[0].had = true; o[0].bv = forge_keep(d[..], "dug"); o[0].bv_n = 3; o[0].has = false;
  #assert !forge_apply(d[..], o[..]) && forge_slot_text(d[..], "set:time") == "day";
  o[0].bv = forge_keep(d[..], "day");
  o[0].had = false;
  #assert !forge_apply(d[..], o[..]);
  o[0].had = true;
  #assert forge_apply(d[..], o[..]) && !forge_slot_at(d[..], "set:time").found && !forge_apply(d[..], o[..]);
  #assert forge_slot_key_ok("row:0") && forge_slot_key_ok("feature:12") && forge_slot_key_ok("quest:old-mara") && forge_slot_key_ok("place:12");
  #assert !forge_slot_key_ok("rows:trees") && !forge_slot_key_ok("row:") && !forge_slot_key_ok("row:-x") && !forge_slot_key_ok("row:Trees") && !forge_slot_key_ok("trees");
  long: [FORGE_VAL + 1] u8; for i: 0..<FORGE_VAL + 1 { long[i] = 'a'; }
  #assert forge_val_ok(cast(string) long[0..<FORGE_VAL]) && !forge_val_ok(cast(string) long[0..<FORGE_VAL + 1]);
}

// A fixed sequence of every kind of edit, from one document.
forge_script :: (d: [] ForgeDoc) -> bool {
  steps := [3] string.["", "", ""];
  return forge_move(d, "trees:0", 120, -40) && forge_rotate(d, "trees:0", 45) && forge_resize(d, "rocks:2", 75)
      && forge_remove(d, "props:1") && forge_pair(d) && forge_setting(d, "palette", "dusk")
      && forge_tool(d, "build", true) && forge_lore(d, "ana", "Ana tends the herd.") && forge_quest(d, "ana", "Count the goats", steps, "Milk")
      && forge_place(d, "lantern", 300, 300, -90) && forge_move(d, "placed:0", 310, 300) && forge_undo(d) && forge_restore(d, "props:1");
}

// One step of two ops: board row 0 goes from `features` to `off` (as doc.coax's forge_switch writes one).
forge_pair :: (d: [] ForgeDoc) -> bool {
  at := forge_slot_at(d, "feature:0");
  if !at.found { return false; }
  o: [2] ForgeOp;
  o[0].kind = FORGE_SLOT; forge_key_into(o[0..<1], "feature:0"); o[0].had = true; o[0].bv = d[0].slots[at.at].at; o[0].bv_n = d[0].slots[at.at].n;
  o[1].kind = FORGE_SLOT; forge_key_into(o[1..<2], "row:0"); o[1].has = true; o[1].av = o[0].bv; o[1].av_n = o[0].bv_n;
  return forge_push(d, o[..]);
}

#test "a step of several ops undoes and redoes whole, is refused whole, and leaves a full log whole" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  #assert forge_read_slot(d[..], "feature:0", "{\"feature\": \"water\"}");
  #assert forge_pair(d[..]) && d[0].op_n == 2 && d[0].done == 2 && !d[0].ops[0].joined && d[0].ops[1].joined;
  #assert !forge_slot_at(d[..], "feature:0").found && forge_slot_text(d[..], "row:0") == "{\"feature\": \"water\"}";
  #assert forge_undo(d[..]) && d[0].done == 0 && forge_slot_at(d[..], "feature:0").found && !forge_slot_at(d[..], "row:0").found && !forge_undo(d[..]);
  #assert forge_redo(d[..]) && d[0].done == 2 && !forge_redo(d[..]) && forge_undo(d[..]);
  // its second op no longer fits: neither is applied, and the first is taken back
  #assert forge_read_slot(d[..], "row:0", "x");
  #assert !forge_redo(d[..]) && d[0].done == 0 && forge_slot_at(d[..], "feature:0").found && forge_slot_text(d[..], "row:0") == "x";
  #assert !forge_pair(d[..]) && d[0].op_n == 2 && forge_slot_at(d[..], "feature:0").found;
  #assert forge_set_slot(d[..], "row:0", false, "") && forge_redo(d[..]) && forge_undo(d[..]) && !forge_undo(d[..]);
  // a full log: the oldest step goes with every op of it
  e: [1] ForgeDoc; forge_reset(e[..], 1);
  #assert forge_read_slot(e[..], "feature:0", "{\"feature\": \"water\"}") && forge_pair(e[..]);
  for i: 0..<FORGE_OPS - 2 { #assert forge_tool(e[..], "fly", i % 2 == 0); }
  #assert e[0].op_n == FORGE_OPS && e[0].ops[1].joined;
  #assert forge_tool(e[..], "fly", true) && e[0].op_n == FORGE_OPS - 1 && !e[0].ops[0].joined && forge_dirty(e[..]);
  for i: 0..<FORGE_OPS - 1 { #assert forge_undo(e[..]); }
  #assert !forge_undo(e[..]) && forge_slot_text(e[..], "row:0") == "{\"feature\": \"water\"}";
}

#test "replaying a log from the same document gives the same document" {
  a: [1] ForgeDoc; forge_reset(a[..], 3);
  #assert forge_read_slot(a[..], "feature:0", "{\"feature\": \"water\"}") && forge_read_move(a[..], "rocks:2", 10, 10);
  base: [1] ForgeDoc; base[0] = a[0];
  #assert forge_script(a[..]);
  b: [1] ForgeDoc; b[0] = base[0];
  #assert forge_replay(b[..], a[..]);
  ta: [4096] u8; tb: [4096] u8;
  na := forge_doc_text(a[..], ta[..]); nb := forge_doc_text(b[..], tb[..]);
  #assert na > 0 && cast(string) ta[0..<na] == cast(string) tb[0..<nb];
  // and every step undone gives the document it started from
  while forge_can_undo(b[..]) { #assert forge_undo(b[..]); }   // a step, not an op, at a time
  tc: [4096] u8; nc := forge_doc_text(b[..], tc[..]); t0: [4096] u8; n0 := forge_doc_text(base[..], t0[..]);
  #assert cast(string) tc[0..<nc] == cast(string) t0[0..<n0];
  // a replay onto a document that changed under it stops at the first step that no longer fits
  c: [1] ForgeDoc; c[0] = base[0];
  #assert forge_read_move(c[..], "trees:0", 1, 1);
  #assert !forge_replay(c[..], a[..]) && c[0].done == 0;
}

#test "slot values share the document's text: what is no longer named is packed away, and a value that can't fit is refused" {
  d: [1] ForgeDoc; forge_reset(d[..], 1);
  long: [400] u8; for i: 0..<400 { long[i] = cast(u8) ('a' + i % 26); }
  // lore rewritten many times: far more than FORGE_TEXT bytes in all, but the log keeps 64 steps
  for i: 0..<200 {
    long[0] = cast(u8) ('a' + i % 26); long[1] = cast(u8) ('a' + (i / 26) % 26);
    #assert forge_lore(d[..], "mara", cast(string) long[..]);
  }
  #assert forge_slot_text(d[..], "lore:mara") == cast(string) long[..] && d[0].text_n <= FORGE_TEXT;
  for i: 0..<FORGE_OPS { #assert forge_undo(d[..]); }
  w := forge_slot_text(d[..], "lore:mara");
  #assert w[0] == cast(u8) ('a' + 135 % 26) && w[1] == cast(u8) ('a' + (135 / 26) % 26);   // the 136th lore: before the 64 kept steps
  for i: 0..<FORGE_OPS { #assert forge_redo(d[..]); }
  #assert forge_slot_text(d[..], "lore:mara") == cast(string) long[..];
  // the log's values and the slots fill the text: one more that can't fit is refused, nothing changes
  e: [1] ForgeDoc; forge_reset(e[..], 1);
  b: [16] u8; n := 0; ok := true; who := 0;
  while ok && who < 300 {
    n = forge_put(b[..], 0, "w"); n = forge_put_int(b[..], n, who);
    ok = forge_lore(e[..], cast(string) b[0..<n], cast(string) long[..]); who += 1;
  }
  #assert !ok && who > FORGE_OPS && e[0].slot_n == who - 1 && e[0].done == FORGE_OPS;   // the log keeps its last 64 steps
  #assert forge_slot_text(e[..], "lore:w0") == cast(string) long[..];
}

ForgeTestScene :: struct {
  st: [1] ForgeSceneState;
  items: [FORGE_SCENE_ITEMS] ForgeItem;
  ops: [FORGE_SCENE_OPS] ForgeItemOp;
  steps: [FORGE_SCENE_STEPS] ForgeStep;
}
forge_test_scene :: (t: [] ForgeTestScene) -> ForgeScene {
  return ForgeScene.{st = t[0].st[..], items = t[0].items[..], ops = t[0].ops[..], steps = t[0].steps[..]};
}

#test "scene edits: place, move, rotate, scale, duplicate, delete and clear each undo and redo cleanly" {
  t: [1] ForgeTestScene; s := forge_test_scene(t[..]);
  #assert !forge_scene_can_undo(s) && !forge_scene_can_redo(s) && !forge_scene_dirty(s);
  #assert forge_scene_clear(s) == 0 && !forge_scene_can_undo(s);

  tree := forge_scene_place(s, 1, 2.0, 0.0, -5.0, 0.25, 1.0);
  rock := forge_scene_place(s, 2, 4.0, 0.0, -5.0, 0.0, 1.0);
  house := forge_scene_place(s, 3, -6.0, 0.0, -5.0, 0.0, 1.0);
  #assert tree == 0 && rock == 1 && house == 2 && s.st[0].n == 3 && forge_scene_dirty(s);

  // no-op reshape records no step
  steps_was := s.st[0].step_n;
  #assert !forge_scene_move(s, house, -6.0, 0.0, -5.0) && s.st[0].step_n == steps_was;

  #assert forge_scene_move(s, house, -6.0, 0.0, -9.0);
  #assert forge_scene_rotate(s, house, 1.5);
  #assert forge_scene_scale(s, house, 1.75);
  dup := forge_scene_duplicate(s, 3, 2.0, 0.0, -9.0, 1.5, 1.75);
  #assert dup == 3 && s.st[0].n == 4;

  // delete rock in the middle: house and duplicate shift down; undo restores rock at index 1
  #assert forge_scene_delete(s, rock) && s.st[0].n == 3 && s.items[1].id == house;
  #assert forge_scene_undo(s) && s.st[0].n == 4 && s.items[1].id == rock && s.items[2].id == house;
  #assert forge_scene_can_redo(s);
  #assert forge_scene_redo(s) && s.st[0].n == 3 && !forge_scene_can_redo(s);

  // clear removes all 3 in one step; undo puts all 3 back; redo clears again
  #assert forge_scene_clear(s) == 3 && s.st[0].n == 0;
  #assert forge_scene_undo(s) && s.st[0].n == 3 && s.items[1].z == -9.0 && s.items[1].yaw == 1.5 && s.items[1].scale == 1.75;
  #assert forge_scene_redo(s) && s.st[0].n == 0;

  // walk all the way back to empty, then all the way forward again
  while forge_scene_can_undo(s) { #assert forge_scene_undo(s); }
  #assert s.st[0].n == 0 && !forge_scene_dirty(s) && forge_scene_can_redo(s);
  while forge_scene_can_redo(s) { #assert forge_scene_redo(s); }
  #assert s.st[0].n == 0 && !forge_scene_can_redo(s);

  // undo clear + undo delete + undo duplicate + undo scale/rotate/move -> back to initial 3 items
  #assert forge_scene_undo(s) && forge_scene_undo(s) && forge_scene_undo(s);
  #assert forge_scene_undo(s) && forge_scene_undo(s) && forge_scene_undo(s);
  #assert s.st[0].n == 3 && s.items[2].z == -5.0 && s.items[2].yaw == 0.0 && s.items[2].scale == 1.0;

  // an edit that changes nothing keeps the redo branch; a new edit after undo drops it
  #assert forge_scene_can_redo(s);
  forge_scene_begin(s, FORGE_SCENE_DELETE);
  #assert !forge_scene_delete(s, 999) && !forge_scene_end(s) && forge_scene_can_redo(s);
  #assert !forge_scene_move(s, tree, 2.0, 0.0, -5.0) && forge_scene_can_redo(s);
  #assert forge_scene_scale(s, tree, 2.0);
  #assert !forge_scene_can_redo(s) && s.items[0].scale == 2.0;
}

#test "compound scatter, 4,096 placed things, oldest-step eviction, replay and stale-edit refusal" {
  t: [1] ForgeTestScene; s := forge_test_scene(t[..]);
  // a scatter of 65 items is one undo/redo step; an empty compound step leaves none
  forge_scene_begin(s, FORGE_SCENE_PLACE);
  #assert !forge_scene_end(s) && !forge_scene_can_undo(s);

  forge_scene_begin(s, FORGE_SCENE_PLACE);
  for i: 0..<65 {
    id := forge_scene_place(s, i % 4, cast(f32) i * 0.5, 0.0, cast(f32) -i, 0.1, 1.0);
    #assert id == i;
  }
  #assert forge_scene_end(s) && s.st[0].n == 65 && s.st[0].step_n == 1;
  #assert forge_scene_undo(s) && s.st[0].n == 0 && forge_scene_can_redo(s);
  #assert forge_scene_redo(s) && s.st[0].n == 65 && s.items[64].x == 32.0;

  // fill all 4,096 slots across compound steps
  while s.st[0].n < FORGE_SCENE_ITEMS {
    forge_scene_begin(s, FORGE_SCENE_PLACE);
    batch := ifx FORGE_SCENE_ITEMS - s.st[0].n > 200 then 200 else FORGE_SCENE_ITEMS - s.st[0].n;
    for k: 0..<batch { #assert forge_scene_place(s, 1, cast(f32) k, 0.0, 0.0, 0.0, 1.0) >= 0; }
    #assert forge_scene_end(s);
  }
  #assert s.st[0].n == FORGE_SCENE_ITEMS && forge_scene_place(s, 1, 0, 0, 0, 0, 1) == -1;

  // replay onto an empty scene reproduces all 4,096 items; replay onto a diverged scene refuses
  u: [1] ForgeTestScene; su := forge_test_scene(u[..]);
  #assert forge_scene_replay(su, s) && su.st[0].n == FORGE_SCENE_ITEMS && forge_same_item(su.items[4095], s.items[4095]);
  v: [1] ForgeTestScene; sv := forge_test_scene(v[..]);
  loaded := forge_scene_load(sv, 9, 1, 0, 1, 0, 1);
  #assert loaded == 0 && !forge_scene_replay(sv, s);

  // small slice parameters evict the oldest whole step cleanly when ops or steps fill
  small_st: [1] ForgeSceneState; small_items: [16] ForgeItem; small_ops: [6] ForgeItemOp; small_steps: [3] ForgeStep;
  sm := ForgeScene.{st = small_st[..], items = small_items[..], ops = small_ops[..], steps = small_steps[..]};
  for i: 0..<5 {
    forge_scene_begin(sm, FORGE_SCENE_PLACE);
    #assert forge_scene_place(sm, 1, cast(f32) i, 0, 0, 0, 1) >= 0;
    #assert forge_scene_place(sm, 2, cast(f32) i, 0, 1, 0, 1) >= 0;
    #assert forge_scene_end(sm);
  }
  #assert sm.st[0].n == 10 && sm.st[0].step_n == 3 && sm.st[0].op_n == 6;
  #assert forge_scene_undo(sm) && forge_scene_undo(sm) && forge_scene_undo(sm) && !forge_scene_can_undo(sm);
  #assert sm.st[0].n == 4 && forge_scene_redo(sm) && sm.st[0].n == 6;
}

ForgeTestLand :: struct { h: [25] f32; ids: [100] u8; w: [100] u8; was_h: [25] f32; was_ids: [100] u8; was_w: [100] u8; pool: [340] u8; }
forge_test_keep :: (l: [] ForgeTestLand) { for k: 0..<25 { l[0].was_h[k] = l[0].h[k]; } for k: 0..<100 { l[0].was_ids[k] = l[0].ids[k]; l[0].was_w[k] = l[0].w[k]; } }
#test "land steps stand in one order with item steps: undo and redo swap the changed rectangle, and the oldest goes when the bytes fill" {
  st: [1] ForgeSceneState; items: [8] ForgeItem; ops: [8] ForgeItemOp; steps: [8] ForgeStep;
  l: [1] ForgeTestLand;
  for k: 0..<25 { l[0].ids[k * 4] = 0; l[0].w[k * 4] = 255; for q: 1..<4 { l[0].ids[k * 4 + q] = 255; } }
  s := ForgeScene.{st = st[..], items = items[..], ops = ops[..], steps = steps[..], land_side = 5, heights = l[0].h[..], land_ids = l[0].ids[..], land_weights = l[0].w[..], land = l[0].pool[..]};
  // nothing changed: no step
  forge_test_keep(l[..]);
  #assert !forge_scene_land_step(s, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 0, 0, 4, 4) && !forge_scene_can_undo(s);
  // a hill on two samples, then a thing, then paint on one sample
  forge_test_keep(l[..]); l[0].h[12] = 3; l[0].h[13] = 1.5;
  #assert forge_scene_land_step(s, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 0, 0, 4, 4);
  #assert st[0].step_n == 1 && steps[0].kind == FORGE_SCENE_LAND && steps[0].count == FORGE_LAND_HEAD + 2 * FORGE_LAND_SAMPLE && st[0].land_rev == 1;
  rock := forge_scene_place(s, 2, 1.0, 0.0, 1.0, 0.0, 1.0);
  forge_test_keep(l[..]); l[0].ids[6 * 4] = 3; l[0].ids[6 * 4 + 1] = 0; l[0].w[6 * 4] = 200; l[0].w[6 * 4 + 1] = 55;
  #assert forge_scene_land_step(s, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 1, 1, 1, 1) && st[0].step_n == 3;
  // undo walks back through paint, the thing and the hill; redo forward again
  #assert forge_scene_undo(s) && l[0].ids[6 * 4] == 0 && l[0].w[6 * 4] == 255 && l[0].w[6 * 4 + 1] == 0 && l[0].h[12] == 3;
  #assert forge_scene_undo(s) && st[0].n == 0 && l[0].h[12] == 3;
  #assert forge_scene_undo(s) && l[0].h[12] == 0 && l[0].h[13] == 0 && !forge_scene_can_undo(s);
  #assert forge_scene_redo(s) && l[0].h[12] == 3 && l[0].h[13] == 1.5;
  #assert forge_scene_redo(s) && st[0].n == 1 && forge_scene_redo(s) && l[0].ids[6 * 4] == 3 && l[0].w[6 * 4 + 1] == 55 && !forge_scene_can_redo(s);
  // a new land edit after an undo drops the redo branch, its bytes too
  #assert forge_scene_undo(s) && forge_scene_undo(s);
  forge_test_keep(l[..]); l[0].h[0] = -2;
  #assert forge_scene_land_step(s, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 0, 0, 4, 4) && !forge_scene_can_redo(s) && st[0].step_n == 2 && st[0].op_n == 0;
  #assert st[0].land_n == 2 * FORGE_LAND_HEAD + 3 * FORGE_LAND_SAMPLE;
  // the whole land (25 samples, 316 bytes) fits only once the older land steps go; an item step between them stays in order
  rock = forge_scene_place(s, 2, 1.0, 0.0, 1.0, 0.0, 1.0);
  forge_test_keep(l[..]); for k: 0..<25 { l[0].h[k] = 7; }
  #assert forge_scene_land_step(s, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 0, 0, 4, 4);
  #assert st[0].land_n == FORGE_LAND_HEAD + 25 * FORGE_LAND_SAMPLE && st[0].step_n == 2 && steps[0].kind == FORGE_SCENE_PLACE && steps[1].first == 0;
  #assert forge_scene_undo(s) && l[0].h[0] == -2 && l[0].h[12] == 3 && forge_scene_undo(s) && st[0].n == 0 && !forge_scene_can_undo(s);
  // an edit too big for the bytes even alone is taken back
  small: [100] u8;
  t := ForgeScene.{st = st[..], items = items[..], ops = ops[..], steps = steps[..], land_side = 5, heights = l[0].h[..], land_ids = l[0].ids[..], land_weights = l[0].w[..], land = small[..]};
  forge_test_keep(l[..]); for k: 0..<25 { l[0].h[k] = 9; }
  #assert !forge_scene_land_step(t, l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], 0, 0, 4, 4) && l[0].h[0] == -2 && l[0].h[12] == 3;
}
