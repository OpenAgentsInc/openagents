// A realm's other text answers through their readers (compliance plan step E11, GitHub #13250):
// proto/verse/realm-lists-v1.json names every line and holds the answers as the server gives
// them: the feature list, what an ask and a revision answer, the panes, the proposals, a listed
// realm's row, a made realm's row for /og and the card's want. This requires:
//   - the feature list's lines read as asks with an id, a state, a kind and words
//     (aethyr/forge/lists.coax), and come back byte for byte from those;
//   - an ask's answer starts with its ask line and a revision's with its plan line, and every line
//     after is a row of the board (aethyr/forge/spec.coax) or the revision; rows come back the same;
//   - the panes' lines are lore and quests with all their parts, and come back the same;
//   - a proposal has its eight fields, and comes back the same;
//   - a listed row is one aethyr/forge/listed.coax takes (listed_row_ok, listed_read), and a made
//     row has /og's fifteen fields: a realm's page, "made", a title and a picture's size;
//   - the card's want is "want" or "no".
// coax/web/api/tests/realm_record_checks.coax and coax/web/api/test_realm_builder.py ask the API
// for the same answers.
//   coax/web/tool.sh aethyr/forge/lists-goldens.coax proto/verse/realm-lists-v1.json

#import "Basic";
#load "lists.coax";
#load "listed.coax";
#load "edit.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";

LG_FIXTURE_PATH :: "proto/verse/realm-lists-v1.json";
Lg :: struct { bad: int; pass: int; quiet: bool; }
lg_need :: (g: [] Lg, name: string, what: string, ok: bool) -> bool {
  if ok { g[0].pass += 1; return true; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (%)\n", name, what); }
  return false;
}
lg_same :: (g: [] Lg, name: string, what: string, got: string, want: string) {
  if got == want { g[0].pass += 1; return; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (%)\n  got:  %\n  want: %\n", name, what, got, want); }
}
lg_join :: (out: [] u8, at: int, parts: [] string, sep: string) -> int {
  n := at;
  for k: 0..<parts.count { if k > 0 { n = forge_put(out, n, sep); } n = forge_put(out, n, parts[k]); }
  return n;
}
// A board's row after an ask's or a revision's first line, or the revision: rebuilt the same.
lg_row_or_rev :: (g: [] Lg, name: string, line: string) {
  out: [512] u8;
  l := forge_spec_line(line, 0);
  if l.kind == SPEC_ROW {
    r := forge_spec_row(l);
    n := forge_put(out[..], forge_put(out[..], forge_put(out[..], forge_put(out[..], 0, "row "), r.key), ifx r.on then " 1 " else " 0 "), r.label);
    lg_same(g, name, "a row comes back from its parts", ifx n < 0 then "" else cast(string) out[0..<n], line);
    return;
  }
  if l.kind == SPEC_REV { _ = lg_need(g, name, "the revision is a number", forge_spec_num(l) >= 1); return; }
  _ = lg_need(g, name, "a line after the first is a row of the board or the revision", false);
}
lg_answer :: (g: [] Lg, name: string, message: string, text: string) {
  out: [1024] u8;
  if message == "Empty" { _ = lg_need(g, name, "nothing is answered", text == ""); return; }
  if message == "CardWant" { _ = lg_need(g, name, "the card's want is want or no", text == "want" || text == "no"); return; }
  if message == "ListedRow" {
    // the row alone, and as the page takes it from an answer
    into: [512] u8; ab: [600] u8;
    an := forge_put(ab[..], forge_put(ab[..], forge_put(ab[..], 0, "200\ntotal 1\n"), text), "\n");
    got := listed_read(cast(string) ab[0..<(ifx an < 0 then 0 else an)], into[..], 4);
    _ = lg_need(g, name, "the listed row is one the list page takes", listed_row_ok(text) && got.rows == 1 && got.more == 0 && got.n == text.count + 1);
    return;
  }
  if message == "MadeRow" {
    f: [16] string; k := forge_list_split(text, f[..]);
    ok := k == 15 && f[1] == "made" && f[2] == "" && f[3].count > 0 && f[9] == "1200" && f[10] == "630" && f[14] == "" && (f[8] == "default" || f[8] == "made");
    ok = ok && f[0].count > 8 && f[0][0..<8] == "/realms/" && forge_spec_digits(f[11]) >= 0 && listed_field(text, 3) == f[3] && listed_field(text, 14) == "" && listed_field(text, 6) == f[6];
    _ = lg_need(g, name, "the made row has /og's fields", ok);
    n := lg_join(out[..], 0, f[0..<(ifx k > 15 then 15 else k)], "|");
    lg_same(g, name, "the row comes back from its fields", ifx n < 0 then "" else cast(string) out[0..<n], text);
    return;
  }
  if !lg_need(g, name, "the answer ends with a newline", text.count > 0 && text[text.count - 1] == '\n') { return; }
  at := 0; first := true;
  while true {
    l := forge_spec_line(text, at); at = l.next;
    if l.kind == SPEC_END { break; }
    line := l.line;
    if message == "Asks" || (message == "AskAnswer" && first) {
      a := forge_read_ask(line);
      if !lg_need(g, name, "an ask's line reads", a.ok && a.id >= 0 && a.state != "") { first = false; continue; }
      n := forge_put(out[..], forge_put(out[..], forge_put_int(out[..], forge_put(out[..], 0, "ask "), a.id), " "), a.state);
      if message == "Asks" {
        _ = lg_need(g, name, "a listed ask has its state, its kind and its words", (a.state == "applied" || a.state == "waiting" || a.state == "removing") && (a.kind == "ask" || a.kind == "remove") && a.words != "");
        n = forge_put(out[..], forge_put(out[..], forge_put(out[..], forge_put(out[..], n, " "), a.kind), " "), a.words);
      } else { _ = lg_need(g, name, "an ask's answer says applied, waiting or gone", a.state == "applied" || a.state == "waiting" || a.state == "gone"); }
      lg_same(g, name, "the ask's line comes back from its parts", ifx n < 0 then "" else cast(string) out[0..<n], line);
    }
    else if message == "ReviseAnswer" && first { _ = lg_need(g, name, "a revision's answer starts with its plan", forge_spec_word(line, 0) == "plan" && forge_spec_digits(forge_spec_word(line, 1)) >= 1 && forge_spec_word(line, 2) == ""); }
    else if message == "AskAnswer" && forge_spec_word(line, 0) == "plan" { _ = lg_need(g, name, "an applied ask names its plan", forge_spec_digits(forge_spec_word(line, 1)) >= 1); }
    else if message == "AskAnswer" || message == "ReviseAnswer" { lg_row_or_rev(g, name, line); }
    else if message == "Panes" {
      p := forge_read_pane(line);
      if p.kind == FORGE_PANE_LORE && p.fields >= 2 {
        n := forge_put(out[..], forge_put(out[..], forge_put(out[..], forge_put(out[..], 0, "lore "), p.who), "|"), p.text);
        lg_same(g, name, "a lore line comes back from its parts", ifx n < 0 then "" else cast(string) out[0..<n], line);
      } else if p.kind == FORGE_PANE_QUEST && p.fields == 6 {
        n := forge_put(out[..], forge_put(out[..], forge_put(out[..], 0, "quest "), p.who), "|");
        n = lg_join(out[..], n, p.parts[..], "|");
        lg_same(g, name, "a quest line comes back from its parts", ifx n < 0 then "" else cast(string) out[0..<n], line);
      } else { _ = lg_need(g, name, "a pane's line is lore or a quest with all its parts", false); }
    }
    else if message == "Proposals" {
      c := forge_read_proposal(line);
      if lg_need(g, name, "a proposal has its eight fields", c.ok && forge_spec_digits(c.id) >= 1 && c.thing != "" && forge_spec_digits(c.before) >= 0 && forge_spec_digits(c.after) >= 1) {
        parts := [8] string.[c.id, c.who, c.thing, c.x, c.z, c.yaw, c.before, c.after];
        n := lg_join(out[..], forge_put(out[..], 0, "P "), parts[..], "|");
        lg_same(g, name, "the proposal comes back from its fields", ifx n < 0 then "" else cast(string) out[0..<n], line);
      }
    }
    else { _ = lg_need(g, name, "the step names a message this check knows", false); }
    first = false;
  }
}

lg_run :: (text: string) -> int {
  nodes: [8192] JvNode; f: [1] Jv;
  if !jv_parse(f[..], text, nodes[..]) { print("FAIL  the fixture is not JSON\n"); return 1; }
  g: [1] Lg; seen: [8] int;
  kinds := [8] string.["Asks", "AskAnswer", "ReviseAnswer", "Panes", "Proposals", "ListedRow", "MadeRow", "CardWant"];
  lists := [2] string.["steps", "model_steps"];
  for which: 0..<2 {
    steps := jv_get(f[0], 0, lists[which]);
    for i: 0..<jv_len(f[0], steps) {
      s := jv_at(f[0], steps, i);
      nb: [160] u8; nn := jv_str(f[0], jv_get(f[0], s, "name"), nb[..]); name := ifx nn < 0 then "" else cast(string) nb[0..<nn];
      mb: [32] u8; mn := jv_str(f[0], jv_get(f[0], s, "message"), mb[..]); message := ifx mn < 0 then "" else cast(string) mb[0..<mn];
      rb: [8192] u8; rn := jv_str(f[0], jv_get(f[0], s, "reply"), rb[..]);
      if !lg_need(g[..], name, "the step has an answer", rn >= 0) { continue; }
      known := message == "Empty";
      for k: 0..<8 { if kinds[k] == message { seen[k] += 1; known = true; } }
      if known { lg_answer(g[..], name, message, cast(string) rb[0..<rn]); }   // the JSON answers are edits.proto's (change-goldens.coax) and the API's own
    }
  }
  for k: 0..<8 { _ = lg_need(g[..], kinds[k], "the fixture holds an answer of this kind", seen[k] >= 1); }
  lines := jv_get(f[0], 0, "lines");
  _ = lg_need(g[..], "the profile", "it names its lines", jv_len(f[0], lines) >= 12);
  print("% realm list goldens hold, % failed\n", g[0].pass, g[0].bad);
  return ifx g[0].bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else LG_FIXTURE_PATH;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("lists-goldens: cannot read the fixture"); return 2; }
  // the checks bite: a pane with a part missing, a proposal short a field, an ask with no words, a
  // want that is neither; and good ones pass
  bad := [5] string.["Panes", "Proposals", "Asks", "CardWant", "AskAnswer"];
  texts := [5] string.["quest old-mott|a|b\n", "P 3|V|barrel|0|1|2|0\n", "ask 3 waiting ask\n", "yes", "ask 3 applied\nnote x\n"];
  g: [1] Lg;
  for k: 0..<5 {
    g[0] = Lg.{quiet = true};
    lg_answer(g[..], "self", bad[k], texts[k]);
    if g[0].bad == 0 { print("FAIL  the check takes an answer it should refuse\n"); return 1; }
  }
  g[0] = Lg.{quiet = true};
  lg_answer(g[..], "self", "Panes", "lore m|x\nquest m|a|b|||r\n");
  lg_answer(g[..], "self", "AskAnswer", "ask 3 applied\nplan 9\nrow trees 1 Trees\nrev 4\n");
  lg_answer(g[..], "self", "Asks", "ask 3 waiting ask a waterfall\n");
  if g[0].bad != 0 { print("FAIL  the check refuses a good answer\n"); return 1; }
  return lg_run(cast(string) buf[0..<n]);
}
