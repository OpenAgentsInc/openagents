// A made or forked realm's goldens through the codec (compliance plan step E11, GitHub #13250):
// proto/verse/realm-made-v1.json holds what coax/web/api/realms.c answers a fork today and the
// bodies sent to it. This reads every answer through aethyr/forge/made.coax (a refusal through
// record.coax) and requires, for each step:
//   - a MadeReply reads, and written back from what was read it is the same bytes; its keys are
//     json_names of MadeReply in proto/descriptors/verse-doc.pb (made.proto);
//   - a MadeLines answer reads, names its own path and says whether its page was written;
//   - a fork's body is what the codec writes for its rules and name, and its keys are ForkRequest's;
//   - a refusal reads as one (RouteError, ErrorReply), and a lines caller's words are not JSON.
// It also reads the lines coax/web/api/realm-wire.coax writes (the "lines" goldens of
// proto/verse/realm-wire-v1alpha1.json), so the route's writer and this reader agree.
// coax/web/api/tests/realm_record_checks.coax makes the same calls against the API.
//   coax/web/tool.sh aethyr/forge/made-goldens.coax proto/verse/realm-made-v1.json

#import "Basic";
#load "made.coax";
#load "record.coax";
#load "../../coax/lib/proto/importer.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";

MG_FIXTURE_PATH :: "proto/verse/realm-made-v1.json";
MG_WIRE_PATH :: "proto/verse/realm-wire-v1alpha1.json";
MG_DESCRIPTOR_PATH :: "proto/descriptors/verse-doc.pb";
MG_PKG :: ".openagents.verse.doc.v1alpha1.";

MgDescriptor :: struct {
  types: [128] D_Type; enums: [16] D_Type; fields: [1024] D_Field; values: [256] D_Value; groups: [1024] string;
  files: [16] string; deps: [64] string; arena: [1048576] u8; output: [1] u8; symbols: [4096] string;
  state: [1] D_State;
}
mg_descriptor_load :: (g: [] MgDescriptor, raw: string) -> string {
  g[0].state[0] = D_State.{types = g[0].types[..], enums = g[0].enums[..], fields = g[0].fields[..], values = g[0].values[..], groups = g[0].groups[..],
    files = g[0].files[..], deps = g[0].deps[..], arena = g[0].arena[..], output = g[0].output[..], symbols = g[0].symbols[..]};
  D_parse(g[0].state[..], raw, "MG");
  return g[0].state[0].error;
}
Mg :: struct { bad: int; pass: int; }
mg_need :: (g: [] Mg, name: string, what: string, ok: bool) -> bool {
  if ok { g[0].pass += 1; return true; }
  g[0].bad += 1; print("FAIL  % (%)\n", name, what);
  return false;
}
mg_same :: (g: [] Mg, name: string, what: string, got: string, want: string) {
  if got == want { g[0].pass += 1; return; }
  g[0].bad += 1; print("FAIL  % (%)\n  got:  %\n  want: %\n", name, what, got, want);
}
// Whether every key of the JSON object is a json_name of the message (its leaf name).
mg_keys :: (st: [] D_State, leaf: string, text: string) -> bool {
  nodes: [128] JvNode; j: [1] Jv;
  if !jv_parse(j[..], text, nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { return false; }
  full: [128] u8; n := forge_put(full[..], 0, MG_PKG); n = forge_put(full[..], n, leaf);
  m := -1;
  for i: 0..<st[0].nt { if st[0].types[i].full == cast(string) full[0..<n] { m = i; } }
  if m < 0 { return false; }
  t := st[0].types[m];
  for i: 0..<jv_len(j[0], 0) {
    k := jv_key(j[0], jv_at(j[0], 0, i)); found := false;
    for f: t.first..<t.first + t.count { if st[0].fields[f].json == k { found = true; } }
    if !found { return false; }
  }
  return true;
}

mg_reply :: (g: [] Mg, st: [] D_State, name: string, message: string, reply: string) {
  buf: [2048] u8; m: [1] ForgeMade; e: [FORGE_ERROR] u8;
  if message == "MadeReply" {
    m[0] = forge_read_made_json(reply);
    if !mg_need(g, name, "the answer reads as a MadeReply", m[0].ok && m[0].page_said) { return; }
    w := forge_made_json(m[..], buf[..]);
    mg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = mg_need(g, name, "its keys are MadeReply's", mg_keys(st, "MadeReply", reply));
    return;
  }
  if message == "MadeLines" {
    m[0] = forge_read_made(reply);
    _ = mg_need(g, name, "the lines read: a slug, its own path and whether its page was written", m[0].ok && m[0].path_n > 0 && m[0].page_said && forge_made_goes(m[..], buf[..]) > 0);
    return;
  }
  if message == "RouteError" || message == "ErrorReply" {
    _ = mg_need(g, name, "the answer reads as a refusal", forge_read_error(reply, e[..]) != "");
    return;
  }
  if message == "ErrorWords" {
    _ = mg_need(g, name, "the words are text, not a made realm and not JSON", reply != "" && reply[0] != '{' && !forge_read_made(reply).ok);
    return;
  }
  _ = mg_need(g, name, "the step names a message this check knows", false);
}
mg_request :: (g: [] Mg, st: [] D_State, name: string, body: string) {
  nodes: [64] JvNode; j: [1] Jv; buf: [512] u8; nb: [FORGE_MADE_NAME] u8;
  if !mg_need(g, name, "the body is JSON", jv_parse(j[..], body, nodes[..]) && jv_kind(j[0], 0) == JV_OBJECT) { return; }
  _ = mg_need(g, name, "the body's keys are ForkRequest's", mg_keys(st, "ForkRequest", body));
  rules := jv_get(j[0], 0, "rules");
  ids: [FORGE_MADE_RULES] string; ib: [FORGE_MADE_RULES * FORGE_MADE_RULE] u8; k := 0;
  for i: 0..<jv_len(j[0], rules) {
    if i >= FORGE_MADE_RULES { break; }
    n := jv_str(j[0], jv_at(j[0], rules, i), ib[i * FORGE_MADE_RULE..<(i + 1) * FORGE_MADE_RULE]);
    ids[i] = ifx n < 0 then "" else cast(string) ib[i * FORGE_MADE_RULE..<i * FORGE_MADE_RULE + n]; k += 1;
  }
  nn := jv_str(j[0], jv_get(j[0], 0, "name"), nb[..]);
  w := forge_fork_body(rules >= 0, ids[0..<k], ifx nn < 0 then "" else cast(string) nb[0..<nn], buf[..]);
  mg_same(g, name, "the body, written", ifx w < 0 then "" else cast(string) buf[0..<w], body);
}

mg_run :: (text: string, wire: string, st: [] D_State) -> int {
  nodes: [4096] JvNode; f: [1] Jv;
  if !jv_parse(f[..], text, nodes[..]) { print("FAIL  the fixture is not JSON\n"); return 1; }
  g: [1] Mg;
  steps := jv_get(f[0], 0, "steps");
  if jv_len(f[0], steps) < 8 { print("FAIL  the fixture has too few steps\n"); return 1; }
  for i: 0..<jv_len(f[0], steps) {
    s := jv_at(f[0], steps, i);
    nb: [160] u8; name := forge_str(f[0], jv_get(f[0], s, "name"), nb[..]);
    mb: [32] u8; message := forge_str(f[0], jv_get(f[0], s, "message"), mb[..]);
    qb: [32] u8; request := forge_str(f[0], jv_get(f[0], s, "request"), qb[..]);
    rb: [4096] u8; rn := jv_str(f[0], jv_get(f[0], s, "reply"), rb[..]);
    bb: [1024] u8; bn := jv_str(f[0], jv_get(f[0], s, "body"), bb[..]);
    if !mg_need(g[..], name, "the step has a reply", rn >= 0) { continue; }
    mg_reply(g[..], st, name, message, cast(string) rb[0..<rn]);
    if request == "ForkRequest" && bn >= 0 { mg_request(g[..], st, name, cast(string) bb[0..<bn]); }
  }
  // the lines the route writes (realm-wire.coax's goldens), read here
  wn: [8192] JvNode; w: [1] Jv; lines := 0;
  if !jv_parse(w[..], wire, wn[..]) { print("FAIL  the route's fixture is not JSON\n"); return 1; }
  goldens := jv_get(w[0], 0, "goldens");
  for i: 0..<jv_len(w[0], goldens) {
    item := jv_at(w[0], goldens, i);
    kb: [32] u8; nb: [160] u8; lb: [512] u8;
    if forge_str(w[0], jv_get(w[0], item, "writer"), kb[..]) != "lines" { continue; }
    ln := jv_str(w[0], jv_get(w[0], item, "body"), lb[..]);
    m: [1] ForgeMade; m[0] = forge_read_made(ifx ln < 0 then "" else cast(string) lb[0..<ln]);
    _ = mg_need(g[..], forge_str(w[0], jv_get(w[0], item, "name"), nb[..]), "the route's lines read: a slug, its own path, its page", m[0].ok && m[0].path_n > 0 && m[0].page_said);
    lines += 1;
  }
  _ = mg_need(g[..], "the route's fixture", "it holds lines of a made realm", lines >= 2);
  print("% made realm goldens hold, % failed\n", g[0].pass, g[0].bad);
  return ifx g[0].bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else MG_FIXTURE_PATH;
  buf: [262144] u8; wb: [262144] u8;
  n := fs_read(path, buf[..]); wn := fs_read(MG_WIRE_PATH, wb[..]);
  if n <= 0 || wn <= 0 { tool_errln("made-goldens: cannot read the fixtures"); return 2; }
  pb: [65536] u8;
  pn := fs_read(MG_DESCRIPTOR_PATH, pb[..]);
  if pn <= 0 { tool_errln("made-goldens: cannot read the descriptor"); return 2; }
  d: [1] MgDescriptor;
  err := mg_descriptor_load(d[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := d[0].state[..];
  // The key check bites: a key the message lacks fails.
  if mg_keys(st, "MadeReply", "{\"slug\": \"s\", \"title\": \"x\"}") || !mg_keys(st, "MadeReply", "{\"slug\": \"s\", \"name\": \"x\"}") || mg_keys(st, "ForkRequest", "{\"rule\":[]}") {
    print("FAIL  the key check takes a body it should refuse\n"); return 1;
  }
  return mg_run(cast(string) buf[0..<n], cast(string) wb[0..<wn], st);
}
