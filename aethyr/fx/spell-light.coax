// Each SRD 5e spell's light (book chapter 72): the one colour its effects, its slot and its marks
// on the ground are drawn in, in every zone. class-look.coax picks a kit cast's recipe with it, and
// battle.coax a battle event's (#13086).
//   coax/bin/coax test --library aethyr/fx/spell-light.coax
#load "../../rules/srd/battle.coax";   // the spells (spells.coax loads only through it)
#load "puff.coax";

fxl_rgb :: (r: f32, g: f32, b: f32) -> FxV { return fxp_v(r, g, b); }
// A spell's colour, linear light.
fxl_spell_rgb :: (sp: int) -> FxV {
  // the level 17 Warlock's spells (warlock.coax): necrotic green, and Dimension Door's violet
  if sp == SP_BLIGHT || sp == SP_CIRCLE_OF_DEATH || sp == SP_FINGER_OF_DEATH { return FXW_NECRO; }
  if sp == SP_DIMENSION_DOOR { return FXW_VIOLET; }
  if sp == SP_HELLISH_REBUKE { return fxl_rgb(0.35, 1.0, 0.3); }   // its green flames
  if sp == SP_PRODUCE_FLAME || sp == SP_FLAME_HURL { return fxl_rgb(1.0, 0.55, 0.15); }
  if sp == SP_STARRY_WISP { return fxl_rgb(1.0, 0.95, 0.6); }
  if sp == SP_POISON_SPRAY { return fxl_rgb(0.6, 1.0, 0.3); }
  if sp == SP_CURE_WOUNDS || sp == SP_HEALING_WORD { return fxl_rgb(0.4, 1.0, 0.5); }
  if sp == SP_LESSER_RESTORATION { return fxl_rgb(0.45, 0.9, 0.75); }
  if sp == SP_AID { return fxl_rgb(0.9, 0.85, 0.4); }
  if sp == SP_GUIDANCE { return fxl_rgb(0.62, 0.78, 0.95); }
  if sp == SP_PROTECTION_GOOD_EVIL { return fxl_rgb(0.72, 0.85, 1); }
  if sp == SP_REVIVIFY { return fxl_rgb(1, 0.95, 0.7); }
  if sp == SP_ZONE_OF_TRUTH { return fxl_rgb(0.74, 0.93, 0.88); }
  if sp == SP_THUNDERWAVE { return fxl_rgb(0.55, 0.75, 1.0); }
  if sp == SP_ENTANGLE { return fxl_rgb(0.35, 0.85, 0.3); }
  if sp == SP_FAERIE_FIRE { return fxl_rgb(0.75, 0.48, 1.0); }
  if sp == SP_CHILL_TOUCH { return fxl_rgb(0.6, 0.92, 1.0); }
  if sp == SP_RAY_OF_SICKNESS { return fxl_rgb(0.75, 0.95, 0.2); }
  if sp == SP_FALSE_LIFE { return fxl_rgb(0.95, 0.25, 0.35); }
  if sp == SP_RAY_OF_ENFEEBLEMENT { return fxl_rgb(0.6, 0.55, 0.85); }
  if sp == SP_BLINDNESS { return fxl_rgb(0.4, 0.45, 1.0); }
  if sp == SP_ELDRITCH_BLAST { return fxl_rgb(0.85, 0.35, 1.0); }
  if sp == SP_HEX { return fxl_rgb(0.55, 0.2, 0.75); }
  if sp == SP_HOLD_PERSON { return fxl_rgb(1.0, 0.8, 0.35); }
  if sp == SP_SCORCHING_RAY { return fxl_rgb(1.0, 0.4, 0.12); }
  if sp == SP_VICIOUS_MOCKERY { return fxl_rgb(1.0, 0.5, 0.8); }
  if sp == SP_SACRED_FLAME { return fxl_rgb(1.0, 0.92, 0.6); }
  if sp == SP_GUIDING_BOLT { return fxl_rgb(0.95, 0.95, 1.0); }
  if sp == SP_DIVINE_SMITE { return fxl_rgb(1.0, 0.85, 0.4); }
  if sp == SP_HUNTERS_MARK { return fxl_rgb(0.55, 0.95, 0.35); }
  if sp == SP_FIRE_BOLT { return fxl_rgb(1.0, 0.48, 0.1); }
  if sp == SP_SHIELD { return fxl_rgb(0.35, 0.9, 1.0); }
  if sp == SP_FIREBALL { return fxl_rgb(1.0, 0.5, 0.12); }
  if sp == SP_ACID_SPLASH { return fxl_rgb(0.55, 1.0, 0.25); }
  if sp == SP_MAGIC_MISSILE { return fxl_rgb(0.8, 0.7, 1.0); }
  if sp == SP_INFLICT_WOUNDS { return fxl_rgb(0.45, 0.2, 0.4); }
  if sp == SP_SHATTER { return fxl_rgb(0.75, 0.85, 1.0); }
  if sp == SP_MASS_HEALING_WORD { return fxl_rgb(0.4, 1.0, 0.5); }
  if sp == SP_SPIRIT_GUARDIANS { return fxl_rgb(1.0, 0.95, 0.7); }
  if sp == SP_CALL_LIGHTNING || sp == SP_CALL_BOLT { return fxl_rgb(0.7, 0.85, 1.0); }
  if sp == SP_HYPNOTIC_PATTERN { return fxl_rgb(0.95, 0.5, 1.0); }
  if sp < 0 { return fxl_rgb(0.5, 0.9, 0.4); }
  return fxl_rgb(0.9, 0.92, 0.96);
}

#test "spell light: a spell has its own colour, the Warlock's are necrotic, an unknown one is grey" {
  #assert fxl_spell_rgb(SP_FIRE_BOLT).x == 1.0 && fxl_spell_rgb(SP_FIRE_BOLT).z < 0.2;
  #assert fxl_spell_rgb(SP_BLIGHT).y == FXW_NECRO.y && fxl_spell_rgb(SP_DIMENSION_DOOR).x == FXW_VIOLET.x;
  grey := fxl_spell_rgb(1000); #assert grey.x == 0.9 && grey.y == 0.92;
  #assert fxl_spell_rgb(-1).y == 0.9;
}
