// Exact piecewise-planar rays through Aethyr's heightfield, with a declared cell budget.
// This is a ray helper, not sphere overlap or swept-capsule collision.
#module "aethyr.ground.query";
#load "ground.coax";
#load "space.coax";
#load "tests/ground-ray-oracle.coax";
#authority;

GROUND_RAY_CELLS :: 4096;
GroundRayStatus :: enum u8 { ok; invalid; terrain; exhausted; }
GroundRay :: struct {
  status: GroundRayStatus = GroundRayStatus.invalid;
  hit: bool; t: f64; point: WorldPoint; normal: GroundNormal;
  visited: int;
  x: int = -1; z: int = -1; triangle: int = -1;
  interval_end: int;   // tested interval ends at x=1, z=2, range=4 (ties carry all bits)
  triangles: int;     // affine patches actually tested, at most twice the visited cells
}

#test "ground ray sees either drawn triangle and keeps t in the direction's units" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0};
  h := [4] f32.[0, 1, 2, 4];
  a := ground_ray(g, h[..], world_point(0.75, 10, 0.25), world_point(0, -2, 0), 10, 4);
  b := ground_ray(g, h[..], world_point(0.25, 10, 0.75), world_point(0, -1, 0), 10, 4);
  #assert a.status == GroundRayStatus.ok && a.hit && a.t == 4.25 && a.point.y == 1.5 && a.triangle == 0;
  #assert b.status == GroundRayStatus.ok && b.hit && b.t == 8 && b.point.y == 2 && b.triangle == 1;
  #assert abs(a.normal.x + 0.30151135) < 0.000001 && abs(a.normal.z + 0.904534) < 0.000001;
}

#test "ground ray starts on and below the solid at zero, facing back along the ray" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0};
  h := [4] f32.[2, 2, 2, 2];
  a := ground_ray(g, h[..], world_point(0.5, 2, 0.5), world_point(0, 3, 4), 1, 1);
  b := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(1, 0, 0), 0, 1);
  #assert a.status == GroundRayStatus.ok && a.hit && a.t == 0 && a.normal.x == 0 && a.normal.y == -0.6 && a.normal.z == -0.8;
  #assert b.status == GroundRayStatus.ok && b.hit && b.t == 0 && b.normal.x == -1;
}

#test "ground ray cannot step over a narrow peak, including its tangent crest" {
  g := Ground.{n = 3, rows = 1, cell = 0.1, west = 0, south = 0};
  h := [8] f32.[0, 0, 4, 0, 0, 0, 4, 0];
  a := ground_ray(g, h[..], world_point(0.01, 2, 0.05), world_point(1, 0, 0), 0.3, 8);
  crest := ground_ray(g, h[..], world_point(0.01, 4, 0.05), world_point(1, 0, 0), 0.3, 8);
  #assert a.status == GroundRayStatus.ok && a.hit && abs(a.t - 0.14) < 0.00000002;
  #assert crest.status == GroundRayStatus.ok && crest.hit && abs(crest.t - 0.19) < 0.00000002;
  reverse := ground_ray(g, h[..], world_point(0.29, 2, 0.05), world_point(-1, 0, 0), 0.3, 8);
  #assert reverse.status == GroundRayStatus.ok && reverse.hit && abs(reverse.point.x - 0.25) < 0.00000003;
}

#test "ground ray extends edges as constant height in the clamped axis" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0};
  h := [4] f32.[0, 1, 2, 4];
  a := ground_ray(g, h[..], world_point(-2, 3, 0.5), world_point(0, -1, 0), 5, 4);
  b := ground_ray(g, h[..], world_point(3, 5, 0.5), world_point(0, -1, 0), 5, 4);
  #assert a.status == GroundRayStatus.ok && a.hit && a.t == 2 && a.normal.x == 0;
  #assert b.status == GroundRayStatus.ok && b.hit && b.t == 2.5 && b.normal.x == 0;
  outside := ground_ray(g, h[..], world_point(-1, 0.5, 0.5), world_point(1, 0, 0), 3, 8);
  #assert outside.status == GroundRayStatus.ok && outside.hit && outside.t == 0;
}

#test "ground ray valid misses, far-end touches and zero range stay distinct" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h: [4] f32;
  up := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(0, 1, 0), 2, 1);
  level := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(1, 0, 0), 2, 4);
  end := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(0, -1, 0), 1, 1);
  none := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(0, -1, 0), 0, 1);
  #assert up.status == GroundRayStatus.ok && !up.hit && level.status == GroundRayStatus.ok && !level.hit;
  #assert end.status == GroundRayStatus.ok && end.hit && end.t == 1;
  #assert none.status == GroundRayStatus.ok && !none.hit;
}

#test "ground ray exhausted traversal refuses instead of promising a miss" {
  g := Ground.{n = 3, rows = 1, cell = 1, west = 0, south = 0}; h: [8] f32;
  q := ground_ray(g, h[..], world_point(0.25, 1, 0.5), world_point(1, 0, 0), 2.5, 1);
  #assert q.status == GroundRayStatus.exhausted && !q.hit && q.t == 0 && q.visited == 1;
  enough := ground_ray(g, h[..], world_point(0.25, 1, 0.5), world_point(1, 0, 0), 2.5, 3);
  #assert enough.status == GroundRayStatus.ok && !enough.hit && enough.visited == 3;
}

#forall "ground ray refuses malformed input without publishing a hit" which: 0..<12 {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h: [4] f32;
  o := world_point(0.5, 1, 0.5); d := world_point(0, -1, 0); far := 2.0; budget := 4;
  nan := 0.0f32; nan = nan / nan;
  if which == 0 { o.x = nan; } if which == 1 { o.y = nan; } if which == 2 { o.z = nan; }
  if which == 3 { d.x = nan; } if which == 4 { d.y = nan; } if which == 5 { d.z = nan; }
  if which == 6 { d.y = 0; } if which == 7 { far = -1; }
  if which == 8 { far = 1000000; } if which == 9 { budget = 0; }
  if which == 10 { budget = GROUND_RAY_CELLS + 1; }
  if which == 11 { o.y = 999999; d.y = 2; }
  q := ground_ray(g, h[..], o, d, far, budget);
  #assert q.status == GroundRayStatus.invalid && !q.hit && q.t == 0 && q.visited == 0;
}

#test "ground ray refuses a bad descriptor, short view and later malformed cell" {
  g := Ground.{n = 2, rows = 1, cell = 1, west = 0, south = 0};
  h := [6] f32.[0, 0, 1000000, 0, 0, 0];
  q := ground_ray(g, h[..], world_point(0.25, 1, 0.5), world_point(1, 0, 0), 1.5, 4);
  #assert q.status == GroundRayStatus.terrain && !q.hit && q.t == 0;
  short := ground_ray(g, h[0..<3], world_point(0.25, 1, 0.5), world_point(1, 0, 0), 1.5, 4);
  #assert short.status == GroundRayStatus.terrain;
  g.n = 0;
  #assert ground_ray(g, h[..], world_point(0, 1, 0), world_point(0, -1, 0), 1, 1).status == GroundRayStatus.terrain;
}

#forall "ground ray matches independent f64 triangle enumeration on a nonbinary mesh" seed: 0..<48 {
  ground_ray_oracle_case(seed);
}

#test "ground ray records tied cell and range boundaries without choosing an arbitrary axis" {
  a := ground_ray_boundary(4, 6, 4); b := ground_ray_boundary(6, 4, 4); c := ground_ray_boundary(4, 4, 4);
  d := ground_ray_boundary(2, 2, 4); e := ground_ray_boundary(5, 6, 4);
  #assert a.t == 4 && a.kind == 5 && b.t == 4 && b.kind == 6 && c.t == 4 && c.kind == 7;
  #assert d.t == 2 && d.kind == 3 && e.t == 4 && e.kind == 4;
}

#test "ground ray boundary starts belong to the side the ray enters, with a stationary axis kept inside" {
  a := ground_ray_start(2, 0.5, 3, 2, 0, 4);
  b := ground_ray_start(2, 0.5, 3, 2, -1, 4);
  c := ground_ray_start(2, 0.5, 3, 2.5, -1, 4);
  d := ground_ray_start(2, 0.5, 3, 3.5, 1, 4);
  e := ground_ray_start(2, 0.5, 3, 3.5, 0, 4);
  #assert a.region == 0 && a.next == 5 && a.u == 0 && a.rate == 0 && a.scale == 2;
  #assert b.region == -1 && b.next == 5 && b.u == 0 && b.rate == 0 && b.scale == 0;
  #assert c.region == 0 && c.next == 0.5 && c.u == 1 && c.rate == -2;
  #assert d.region == 3 && d.next == 5 && d.u == 1 && d.rate == 0 && d.scale == 0;
  #assert e.region == 2 && e.u == 1 && e.next == 5 && e.scale == 2;
}

#test "ground ray outside entry traverses the edge and preserves its nonclamped rate" {
  g := Ground.{n = 2, rows = 1, cell = 1, west = 0, south = 0};
  h := [6] f32.[0, 1, 3, 0, 1, 3];
  a := ground_ray(g, h[..], world_point(-1, 0.5, 0.5), world_point(1, 0, 0), 4, 8);
  b := ground_ray(g, h[..], world_point(3, 4, 0.5), world_point(-1, -1, 0), 4, 8);
  #assert a.status == GroundRayStatus.ok && a.hit && a.t == 1.5 && a.x == 0 && a.z == 0 && a.visited == 2;
  #assert b.status == GroundRayStatus.ok && b.hit && b.t == 1 && b.x == 1 && b.visited == 1;
  #assert a.interval_end == 1 && a.triangles == 2;
}

#test "ground ray coplanar starts are finite, and diagonal equality names triangle zero" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h: [4] f32;
  q := ground_ray(g, h[..], world_point(0.5, 0, 0.5), world_point(3, 0, 4), 1, 8);
  #assert q.status == GroundRayStatus.ok && q.hit && q.t == 0 && q.normal.x == -0.6 && q.normal.z == -0.8;
  shaped := [4] f32.[0, 1, 2, 4];
  d := ground_ray(g, shaped[..], world_point(0.5, 5, 0.5), world_point(0, -1, 0), 5, 1);
  #assert d.hit && d.triangle == 0 && d.t == 3 && d.visited == 1 && d.triangles == 1 && d.interval_end == 4;
}

#forall "ground ray refuses each malformed corner before testing a partial tile" corner: 0..<4 {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0};
  h := [4] f32.[999999, 999999, 999999, 999999]; h[corner] = 1000000;
  q := ground_ray(g, h[..], world_point(0.5, 2, 0.5), world_point(0, -1, 0), 2, 1);
  #assert q.status == GroundRayStatus.terrain && q.visited == 1 && !q.hit;
}

#forall "ground ray refuses an excessive slope on either axis" axis: 0..<2 {
  g := Ground.{n = 1, cell = 0.5, west = 0, south = 0};
  h := [4] f32.[0, 500000, 0, 500000];
  if axis == 1 { h = [4] f32.[0, 0, 500000, 500000]; }
  q := ground_ray(g, h[..], world_point(0.25, 800000, 0.25), world_point(0, -1, 0), 1, 1);
  #assert q.status == GroundRayStatus.terrain && q.visited == 1 && !q.hit;
  outside := ground_ray(g, h[..], world_point(-1, 800000, -1), world_point(0, -1, 0), 1, 1);
  #assert outside.status == GroundRayStatus.terrain && outside.visited == 1 && !outside.hit;
}

#forall "ground ray endpoint bounds use the actual directed range on every axis" axis: 0..<3, sign: 0..<2 {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h: [4] f32;
  o := world_point(0.5, 1, 0.5); d := world_point(0, -1, 0);
  start := ifx sign == 0 then 999998.0f32 else -999998.0f32;
  speed := ifx sign == 0 then 1.0f32 else -1.0f32;
  if axis == 0 { o.x = start; d.x = speed; }
  if axis == 1 { o.y = start; d.y = speed; }
  if axis == 2 { o.z = start; d.z = speed; }
  q := ground_ray(g, h[..], o, d, 2, 8);
  #assert q.status == GroundRayStatus.invalid && q.visited == 0;
  if axis == 0 { o.x = 999997; d.x = 1; }
  if axis == 1 { o.y = 999997; d.y = 1; }
  if axis == 2 { o.z = 999997; d.z = 1; }
  q = ground_ray(g, h[..], o, d, 2, 8);
  #assert q.status == GroundRayStatus.ok;
}

#test "ground ray admits its exact maximum traversal budget" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h: [4] f32;
  q := ground_ray(g, h[..], world_point(0.5, 1, 0.5), world_point(0, 1, 0), 0, GROUND_RAY_CELLS);
  #assert q.status == GroundRayStatus.ok && !q.hit && q.visited == 1 && q.triangles == 1;
}

#test "ground ray tests both affine patches when the hit follows the diagonal crossing" {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h := [4] f32.[0, 1, 2, 4];
  a := ground_ray(g, h[..], world_point(0.1, 3.3, 0.9), world_point(1, -3, -1), 0.8, 1);
  b := ground_ray(g, h[..], world_point(0.9, 3.3, 0.1), world_point(-1, -3, 1), 0.8, 1);
  #assert a.hit && a.status == GroundRayStatus.ok && a.triangle == 0 && a.triangles == 2;
  #assert abs(a.t - 0.5) < 0.0000001 && abs(a.point.z - 0.4) < 0.0000001;
  #assert b.hit && b.status == GroundRayStatus.ok && b.triangle == 1 && b.triangles == 2;
  #assert abs(b.t - 0.4333333333333333) < 0.0000001 && abs(b.point.z - 0.5333333333333333) < 0.0000001;
}

#forall "ground ray diagonal endpoint touches do not create a zero-length extra patch" which: 0..<4 {
  g := Ground.{n = 1, cell = 1, west = 0, south = 0}; h := [4] f32.[0, 1, 2, 4];
  o := world_point(0.25, 10, 0.25); d := world_point(0.5, 0, 0);
  if which == 1 { d = world_point(0, 0, 0.5); }
  if which == 2 { o.x = 0.75; d = world_point(-0.5, 0, 0); }
  if which == 3 { o.z = 0.75; d = world_point(0, 0, -0.5); }
  q := ground_ray(g, h[..], o, d, 1, 1);
  #assert q.status == GroundRayStatus.ok && !q.hit && q.visited == 1 && q.triangles == 1;
}

#test "ground ray never tests a later descending cell before it enters that cell" {
  g := Ground.{n = 3, rows = 1, cell = 0.1, west = 0, south = 0};
  h := [8] f32.[0, 0, 4, 0, 0, 0, 4, 0];
  q := ground_ray(g, h[..], world_point(0.01, 10, 0.05), world_point(1, 0, 0), 0.3, 8);
  #assert q.status == GroundRayStatus.ok && !q.hit && q.visited == 4;
}

#forall "ground ray locates a diagonal hit after entering a later cell at positive time" reverse: bool {
  g := Ground.{n = 2, rows = 1, cell = 1, west = 0, south = 0};
  h := [6] f32.[0, 0, 1, 0, 2, 4];
  o := world_point(0.1, 6.3, 1.9); d := world_point(1, -3, -1);
  b := GroundRayOraclePoint.{x = 2, y = 1, z = 0};
  if reverse { o = world_point(2.9, 6.3, -0.9); d = world_point(-1, -3, 1); b = GroundRayOraclePoint.{x = 1, y = 2, z = 1}; }
  a := GroundRayOraclePoint.{x = 1, y = 0, z = 0}; c := GroundRayOraclePoint.{x = 2, y = 4, z = 1};
  expected := ground_ray_oracle_triangle(a, b, c, o, d, 1.8);
  actual := ground_ray(g, h[..], o, d, 1.8, 12);
  #assert expected.hit && actual.status == GroundRayStatus.ok && actual.hit && actual.x == 1 && actual.z == 0;
  #assert abs(actual.t - expected.t) < 0.0000000001 && actual.visited >= 2 && actual.triangles > actual.visited;
}

GroundRayAxis :: struct { region: int; cell: int; u: f64; rate: f64; scale: f64; mesh_scale: f64; next: f64; step: int; }
GroundRayTile :: struct { ok: bool; a: f64; b: f64; c: f64; d: f64; }
GroundRayBoundary :: struct { t: f64; kind: int; }

ground_ray_finite :: (v: f64) -> bool { return v > -GROUND_LIMIT && v < GROUND_LIMIT; }
ground_ray_boundary :: (x: f64, z: f64, far: f64) -> GroundRayBoundary {
  out := GroundRayBoundary.{t = far, kind = 4};
  if x < out.t { out.t = x; out.kind = 1; } else if x == out.t { out.kind |= 1; }
  if z < out.t { out.t = z; out.kind = 2; } else if z == out.t { out.kind |= 2; }
  return out;
}

// The region before the first vertex is -1; after the last, n. In an outer region the
// height fraction is constant, while the ray's actual position keeps moving.
ground_ray_axis :: (origin: f32, cell: f32, n: int, o: f32, d: f32, region: int, far: f64) -> GroundRayAxis {
  at := region;
  if at == -1 { at = 0; } else if at == n { at = n - 1; }
  a := origin + f32(at) * cell; b := origin + f32(at + 1) * cell;
  scale := 1 / (f64(b) - f64(a));
  out := GroundRayAxis.{region = region, cell = at, u = (f64(o) - f64(a)) * scale,
    rate = f64(d) * scale, scale = scale, mesh_scale = scale, next = far + 1, step = 1 - 2 * cast(int) (f32_bits(d) >> 31)};
  if region < 0 { out.u = 0; out.rate = 0; out.scale = 0; }
  else if region >= n { out.u = 1; out.rate = 0; out.scale = 0; }
  if d > 0 && region < n { out.next = (f64(origin + f32(region + 1) * cell) - f64(o)) / f64(d); }
  else if d < 0 && region >= 0 { out.next = (f64(origin + f32(region) * cell) - f64(o)) / f64(d); }
  return out;
}

ground_ray_start :: (origin: f32, cell: f32, n: int, o: f32, d: f32, far: f64) -> GroundRayAxis {
  end := origin + f32(n) * cell;
  axis := ground_axis(origin, cell, n, o);
  region := axis.i;
  if o < origin { region = -1; }
  else if o > end { region = n; }
  else if d < 0 && o == origin + f32(region) * cell { region -= 1; }
  else if d > 0 && o == end { region = n; }
  return ground_ray_axis(origin, cell, n, o, d, region, far);
}

ground_ray_tile :: (g: Ground, heights: [] f32, x: int, z: int) -> GroundRayTile {
  at := z * (g.n + 1) + x;
  a := heights[at]; b := heights[at + 1]; c := heights[at + g.n + 1]; d := heights[at + g.n + 2];
  if !ground_finite(a) || !ground_finite(b) || !ground_finite(c) || !ground_finite(d) { return GroundRayTile.{}; }
  return GroundRayTile.{ok = true, a = f64(a), b = f64(b), c = f64(c), d = f64(d)};
}

// On one side of a cell's diagonal the ground is affine. The signed vertical gap is
// affine too: if its ends are positive there is no touch; otherwise solve the first zero.
ground_ray_piece :: (tile: GroundRayTile, x: GroundRayAxis, z: GroundRayAxis, o: WorldPoint, d: WorldPoint,
    low: f64, high: f64, triangle: int) -> GroundRay {
  out := GroundRay.{status = GroundRayStatus.ok};
  bx := tile.b - tile.a; bz := tile.d - tile.b;
  if triangle == 1 { bx = tile.d - tile.c; bz = tile.c - tile.a; }
  gx := bx * x.scale; gz := bz * z.scale;
  if !ground_finite(f32(bx * x.mesh_scale)) || !ground_finite(f32(bz * z.mesh_scale)) { return GroundRay.{status = GroundRayStatus.terrain}; }
  h0 := tile.a + bx * (x.u + x.rate * low) + bz * (z.u + z.rate * low);
  gap := f64(o.y) + f64(d.y) * low - h0;
  rate := f64(d.y) - bx * x.rate - bz * z.rate;
  last := gap + rate * (high - low);
  if gap > 0 && last > 0 { return out; }
  t := low;
  if gap > 0 { t = low + (high - low) * (gap / (gap - last)); }
  norm := sqrt(gx * gx + 1 + gz * gz);
  out.hit = true; out.t = t; out.x = x.cell; out.z = z.cell; out.triangle = triangle;
  out.normal = GroundNormal.{x = f32(-gx / norm), y = f32(1 / norm), z = f32(-gz / norm)};
  return out;
}

ground_ray :: (g: Ground, heights: [] f32, o: WorldPoint, d: WorldPoint, far: f64, cells: int) -> GroundRay {
  if cells < 1 || cells > GROUND_RAY_CELLS || !(far >= 0) || !(far < GROUND_LIMIT)
    || !ground_finite(o.x) || !ground_finite(o.y) || !ground_finite(o.z)
    || !ground_finite(d.x) || !ground_finite(d.y) || !ground_finite(d.z) { return GroundRay.{}; }
  ray_magnitude := sqrt(f64(d.x) * f64(d.x) + f64(d.y) * f64(d.y) + f64(d.z) * f64(d.z));
  if ray_magnitude == 0 || !ground_ray_finite(f64(o.x) + f64(d.x) * far)
    || !ground_ray_finite(f64(o.y) + f64(d.y) * far) || !ground_ray_finite(f64(o.z) + f64(d.z) * far) { return GroundRay.{}; }
  count := ground_points(g);
  if count == 0 || heights.count < count { return GroundRay.{status = GroundRayStatus.terrain}; }
  x := ground_ray_start(g.west, g.cell, g.n, o.x, d.x, far);
  z := ground_ray_start(g.south, g.cell, ground_rows(g), o.z, d.z, far);
  low := 0.0;
  tested := 0;
  boundary: GroundRayBoundary;
  for visit: 0..<cells {
    tile := ground_ray_tile(g, heights, x.cell, z.cell);
    if !tile.ok { return GroundRay.{status = GroundRayStatus.terrain, visited = visit + 1}; }
    boundary = ground_ray_boundary(x.next, z.next, far);
    high := boundary.t;
    first := (x.u - z.u) + (x.rate - z.rate) * low;
    last := (x.u - z.u) + (x.rate - z.rate) * high;
    triangle := ifx first + last >= 0 then 0 else 1;
    answer: GroundRay;
    if (first > 0 && last < 0) || (first < 0 && last > 0) {
      middle := low + (high - low) * (first / (first - last));
      triangle = cast(int) (f64_bits(first) >> 63);   // strict crossing: first is nonzero
      answer = ground_ray_piece(tile, x, z, o, d, low, middle, triangle);
      tested += 1;
      if answer.status == GroundRayStatus.ok && !answer.hit {
        answer = ground_ray_piece(tile, x, z, o, d, middle, high, 1 - triangle);
        tested += 1;
      }
    } else { answer = ground_ray_piece(tile, x, z, o, d, low, high, triangle); tested += 1; }
    if answer.status != GroundRayStatus.ok { return GroundRay.{status = answer.status, visited = visit + 1}; }
    if answer.hit {
      answer.visited = visit + 1; answer.interval_end = boundary.kind; answer.triangles = tested;
      answer.point = world_point(f32(f64(o.x) + f64(d.x) * answer.t), f32(f64(o.y) + f64(d.y) * answer.t), f32(f64(o.z) + f64(d.z) * answer.t));
      if answer.t == 0 { answer.normal = GroundNormal.{x = f32(-f64(d.x) / ray_magnitude), y = f32(-f64(d.y) / ray_magnitude), z = f32(-f64(d.z) / ray_magnitude)}; }
      return answer;
    }
    if (boundary.kind & 4) != 0 { return GroundRay.{status = GroundRayStatus.ok, visited = visit + 1, interval_end = boundary.kind, triangles = tested}; }
    low = high;
    if (boundary.kind & 1) != 0 { x = ground_ray_axis(g.west, g.cell, g.n, o.x, d.x, x.region + x.step, far); }
    if (boundary.kind & 2) != 0 { z = ground_ray_axis(g.south, g.cell, ground_rows(g), o.z, d.z, z.region + z.step, far); }
  }
  return GroundRay.{status = GroundRayStatus.exhausted, visited = cells, interval_end = boundary.kind, triangles = tested};
}
