// Every actual host action observation is checked, including effects after refusal.
#authority;
#test "action receipt requires all authored words and rejects every individual corruption" {
 rows:=[110]int.[0,0,1,1,1,1,3,0,1,1,1,1,0,1,1,1,1,3,1,1,0,1,2,0,1,1,1,1,3,1,1,0,1,3,0,1,1,1,1,3,1,1,0,1,4,0,1,1,1,1,3,1,1,0,1,5,0,0,0,1,1,3,0,1,1,1,6,0,0,0,1,1,3,0,1,1,1,7,0,1,1,1,1,3,1,1,0,1,8,0,1,1,1,1,3,1,1,0,1,99,0,1,0,1,1,3,1,1,0,1];#assert hapc_accept(rows[..]);long:[111]int;
 #assert !hapc_accept(rows[0..<109])&&!hapc_accept(long[..]);
 for i:0..<rows.count{before:=rows[i];rows[i]+=1;#assert !hapc_accept(rows[..]);rows[i]=before;}
}
hapc_accept::(rows:[]int)->bool #export_c {
 expected:=[110]int.[0,0,1,1,1,1,3,0,1,1,1,1,0,1,1,1,1,3,1,1,0,1,2,0,1,1,1,1,3,1,1,0,1,3,0,1,1,1,1,3,1,1,0,1,4,0,1,1,1,1,3,1,1,0,1,5,0,0,0,1,1,3,0,1,1,1,6,0,0,0,1,1,3,0,1,1,1,7,0,1,1,1,1,3,1,1,0,1,8,0,1,1,1,1,3,1,1,0,1,99,0,1,0,1,1,3,1,1,0,1];if rows.count!=expected.count{return false;}for v,i:expected{if rows[i]!=v{return false;}}return true;
}
