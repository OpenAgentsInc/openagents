// Frozen ordinary 5E startup observations. Asset readiness is distinct from
// decoder sample parity, audio-device timing and current producer admission.
#authority;
#test "ordinary startup retains every requested asset within unchanged PCM limits" {
 q:=[16]int.[48,0,0,126,120,0,1,0,1,0,0,122,1,0,0,16];
 #assert hpf_accept(q[..]);q[12]=8388608;#assert hpf_accept(q[..]);q[12]=1;
 for i:0..<16 {if i==12 {continue;}q[i]+=1;#assert !hpf_accept(q[..]);q[i]-=1;}
 q[12]=0;#assert !hpf_accept(q[..]);q[12]=8388609;#assert !hpf_accept(q[..]);
 #assert !hpf_accept(q[0..<15]);
}
#test "ordinary audio rows require actual PCM and preserve pregesture cue refusal" {
 for kind:[4]int.[1,2,5,6] {
  result:=ifx kind==1 then -2 else ifx kind==2 then 0 else 128;
  #assert hpf_ready(kind,true,result,1,1)&&hpf_ready(kind,true,result,8388608,2);
  #assert !hpf_ready(kind,false,result,1,1)&&!hpf_ready(kind,true,result,0,1)&&!hpf_ready(kind,true,result,-1,1)&&!hpf_ready(kind,true,result,8388609,1);
  for channels:[3]int.[0,3,-1] {#assert !hpf_ready(kind,true,result,1,channels);}
  #assert !hpf_ready(kind,true,-1,1,1)&&!hpf_ready(kind,true,129,1,1);
 }
 #assert hpf_ready(2,true,127,1,1)&&!hpf_ready(2,true,128,1,1);
 #assert !hpf_ready(1,true,0,1,1)&&!hpf_ready(5,true,0,1,1)&&!hpf_ready(6,true,0,1,1);
 #assert hpf_ready(4,true,128,0,0)&&!hpf_ready(4,false,128,0,0)&&!hpf_ready(4,true,127,0,0)&&!hpf_ready(4,true,128,1,0)&&!hpf_ready(4,true,128,0,1);
 for kind:[4]int.[-1,0,3,7] {#assert !hpf_ready(kind,true,128,0,0);}
}
hpf_ready :: (kind:int,parsed:bool,result:int,samples:int,channels:int)->bool #export_c {
 if !parsed {return false;}
 if kind==4 {return result==128&&samples==0&&channels==0;}
 if samples<1||samples>8388608||channels<1||channels>2 {return false;}
 if kind==1 {return result== -2;}
 if kind==2 {return result>=0&&result<128;}
 return (kind==5||kind==6)&&result==128;
}
hpf_accept :: (q:[]int)->bool #export_c {
 if q.count!=16 {return false;}
 expected:=[15]int.[48,0,0,126,120,0,1,0,1,0,0,122,0,0,16];
 for value,i:expected {if q[ifx i<12 then i else i+1]!=value {return false;}}
 return q[12]>0&&q[12]<=8388608;
}
