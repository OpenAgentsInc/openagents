// Actual allocation spans, before a host copies bytes into a realm.
#module "aethyr.host.buffers";
#authority;
#test "host copies require one complete measured destination including its allocation extent" {
  #assert htb_copy_span(1,4,4,5) && htb_copy_span(4096,64,4,4160) && htb_copy_span(4096,64,64,4160);
  #assert htb_copy_span(4096,0,0,4096) && htb_copy_span(4096,64,0,4160);
  #assert !htb_copy_span(0,4,4,5) && !htb_copy_span(1,4,5,6);
  #assert !htb_copy_span(4096,64,4,4159) && !htb_copy_span(4097,0,0,4096);
  #assert !htb_copy_span(1,5,0,5) && !htb_copy_span(1,0,1,5);
}
#test "host copy span arithmetic cannot wrap near the u64 boundary" {
  top:u64=18446744073709551615;
  #assert htb_copy_span(top,0,0,top) && htb_copy_span(top-3,3,3,top);
  #assert !htb_copy_span(top-3,4,0,top) && !htb_copy_span(top,1,1,top);
  #assert !htb_copy_span(1,top,0,top) && !htb_copy_span(1,0,top,top);
}
htb_copy_span :: (address:u64,capacity:u64,bytes:u64,memory_bytes:u64)->bool #export_c {
  return address!=0 && address<=memory_bytes && capacity<=memory_bytes-address && bytes<=capacity;
}
