// Emit the ordinary HTTP helper and link only approved platform effects.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3||args_count(a[..])>4||(args_count(a[..])==4&&args_at(a[..],3)!="--sanitize")||cxtool_os()!=2 {tool_errln("usage: build-linux-http ROOT COMPILER NEW_OUT [--sanitize]");return 2;}
 root:=args_at(a[..],0);compiler:=args_at(a[..],1);out:=args_at(a[..],2);sanitized:=args_count(a[..])==4;paths:[16][4096]u8;if !fs_mkdir(out) {return 1;}
 inputs:[1]RtqInputs;env:[]string;stdout:[8388608]u8;stderr:[1048576]u8;deadline:=proc_now_ms()+300000;
 for source,i:[2]string.["verse/native/net.coax","coax/lib/crypto/entropy.coax"] {
  name:=ifx i==0 then "net.c" else "entropy.c";header:=ifx i==0 then "Net.h" else "entropy-policy.h";
  unit:=fs_join(root,source,paths[0][..]);if !rtq_deps(inputs[..],compiler,unit,deadline,out,ifx i==0 then "net-deps" else "entropy-deps") {return 1;}
  argv:=[6]string.[compiler,"c",unit,"--library","--header",fs_join(out,header,paths[1][..])];
  r:=rtq_command(argv[..],env,deadline,out,ifx i==0 then "net-emission" else "entropy-emission",stdout[..],stderr[..]);if !rtq_ok(r)||!fs_write(fs_join(out,name,paths[2][..]),cast(string)stdout[0..<r.out_n]) {return 1;}
 }
 tls_script:=fs_join(root,"coax/platform/tls-env.sh",paths[3][..]);if !rtq_input_add(inputs[..],tls_script) {return 1;}
 setup:=[4]string.["bash","-c",". \"$1\" && printf '%s %s' \"$CXTLS_CFLAGS\" \"$CXTLS_LIBS\"","http-sdk"];setup_full:[5]string;for value,i:setup {setup_full[i]=value;}setup_full[4]=tls_script;
 r:=rtq_command(setup_full[..],env,deadline,out,"tls-flags",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}flags:[8192]u8;for i:0..<r.out_n {if i>=flags.count {return 1;}flags[i]=stdout[i];}flag_n:=r.out_n;
 argv:[64]string;n:=0;for value:[10]string.["nice","-n15","gcc","-std=gnu11",ifx sanitized then "-O1" else "-O2","-ffp-contract=off","-fno-fast-math","-fno-builtin-pow","-I",out] {argv[n]=value;n+=1;}
 argv[n]=fs_join(out,"net.c",paths[4][..]);n+=1;argv[n]=fs_join(out,"entropy.c",paths[5][..]);n+=1;
 for file,i:[8]string.["tool-native.c","process-native.c","store-file-native.c","read-file-native.c","socket-native.c","entropy-native.c","entropy-foreign.c","tls-native.c"] {
  relative:[256]u8;o:[1]Jo;jo_start(o[..],relative[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],file);argv[n]=fs_join(root,jo_text(o[..]),paths[6+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;
 }
 at:=0;while at<flag_n {while at<flag_n&&(flags[at]==' '||flags[at]=='\n'||flags[at]=='\t') {at+=1;}end:=at;while end<flag_n&&flags[end]!=' '&&flags[end]!='\n'&&flags[end]!='\t' {end+=1;}if end>at {if n>=56 {return 1;}argv[n]=cast(string)flags[at..<end];n+=1;}at=end;}
 if sanitized {for flag:[4]string.["-fsanitize=address,undefined","-fno-sanitize-recover=all","-fno-omit-frame-pointer","-g"] {argv[n]=flag;n+=1;}}
 for flag:[2]string.["-lpthread","-lm"] {argv[n]=flag;n+=1;}argv[n]="-o";argv[n+1]=fs_join(out,"http-helper",paths[15][..]);n+=2;
 r=rtq_command(argv[0..<n],env,deadline,out,"link",stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_inputs_match(inputs[..])||!rtq_input_add(inputs[..],compiler)||!rtq_input_add(inputs[..],argv[n-1]) {return 1;}
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.native-http-build.v1");jo_key(o[..],"sanitized");jo_bool(o[..],sanitized);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);return ifx !o[0].bad&&fs_write(fs_join(out,"build.json",paths[0][..]),jo_text(o[..])) then 0 else 1;
}
