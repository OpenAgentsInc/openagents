// Build the Coax probe against the actual Linux realm SDK, without a GPU
// window or speaker. COAX is supplied explicitly, never republished.
// tool.sh: tls
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";
hvb_run :: (argv:[]string,output:string)->bool {
  out:[16777216]u8;err:[8192]u8;r:=proc_run(argv,90000,out[..],err[..]);
  if r.started!=0 || r.status!=0 || r.timed_out || r.cut {tool_errln(cast(string)err[0..<r.err_n]);return false;}
  return output=="" || fs_write(output,cast(string)out[0..<r.out_n]);
}
hvb_flags :: (text:string,argv:[]string,at:int)->int {
  n:=at;i:=0;while i<text.count {while i<text.count && (text[i]==' ' || text[i]=='\n' || text[i]==9) {i+=1;}start:=i;while i<text.count && text[i]!=' ' && text[i]!='\n' && text[i]!=9 {i+=1;}if i>start {if n>=argv.count {return -1;}argv[n]=text[start..<i];n+=1;}}
  return n;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])<2 || args_count(a[..])>4 {tool_errln("usage: build-vulkan OUT COAX [--sanitize] [--transport]");return 2;}
  for i:2..<args_count(a[..]) {if args_at(a[..],i)!="--sanitize" && args_at(a[..],i)!="--transport" {return 2;}}
  sanitize:=args_has(a[..],"--sanitize");transport:=args_has(a[..],"--transport");
  if cxtool_os()!=2 {tool_errln("build-vulkan: the low-4G realm ABI runs on Linux");return 2;}
  paths:[12][4096]u8;dir:=args_at(a[..],0);coax:=args_at(a[..],1);if !fs_mkdir(dir) {return 1;}dir=fs_realpath(dir,paths[0][..]);
  fixture_c:=fs_join(dir,"fixture.c",paths[1][..]);fixture_h:=fs_join(dir,"fixture.h",paths[2][..]);
  check_c:=fs_join(dir,"HostCheck.c",paths[3][..]);check_h:=fs_join(dir,"HostCheck.h",paths[4][..]);bin:=fs_join(dir,"check-vulkan",paths[5][..]);
  emit_fixture:=[7]string.[coax,"c","aethyr/host/fixture.coax","--library","--header",fixture_h,"--release"];
  emit_check:=[7]string.[coax,"c",ifx transport then "aethyr/host/check-vulkan-transport.coax" else "aethyr/host/check-vulkan.coax","--library","--header",check_h,"--release"];
  if !hvb_run(emit_fixture[..],fixture_c) || !hvb_run(emit_check[..],check_c) {return 1;}
  net_c:=fs_join(dir,"HostNetwork.c",paths[6][..]);net_h:=fs_join(dir,"HostNetwork.h",paths[7][..]);entropy_c:=fs_join(dir,"entropy.c",paths[8][..]);entropy_h:=fs_join(dir,"entropy-policy.h",paths[9][..]);
  emit_net:=[7]string.[coax,"c","aethyr/host/native-socket.coax","--library","--header",net_h,"--release"];
  emit_entropy:=[6]string.[coax,"c","coax/lib/crypto/entropy.coax","--library","--header",entropy_h];
  if !hvb_run(emit_net[..],net_c) || !hvb_run(emit_entropy[..],entropy_c) {return 1;}
  base:=[28]string.["gcc","-std=gnu11","-O2","-no-pie","-ffp-contract=off","-fno-fast-math","-Wno-attributes","-I",dir,"-I","verse/native","-I","coax/platform",fixture_c,check_c,"aethyr/host/tests/fixture-face.c","aethyr/host/tests/vulkan-effects.c","verse/native/realm-host.c","coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c","-lpthread","-lm","-o",bin,"-Wno-unused-function","-Wno-unused-variable"];
  cc:[64]string;for i:0..<28 {cc[i]=base[i];}cn:=28;
  extra:=[7]string.[net_c,"verse/native/host-sockets.c","coax/platform/socket-native.c","coax/platform/tls-native.c","coax/platform/entropy-native.c","coax/platform/entropy-foreign.c",entropy_c];for file:extra {cc[cn]=file;cn+=1;}
  cf:[4096]u8;lf:[4096]u8;tls:[8192]u8;tls_err:[4096]u8;cflags:=proc_getenv("CXTLS_CFLAGS",cf[..]);libs:=proc_getenv("CXTLS_LIBS",lf[..]);
  if cflags!="" && libs!="" {cn=hvb_flags(cflags,cc[..],cn);if cn<0 {return 1;}cn=hvb_flags(libs,cc[..],cn);}else {
    // Reuse the repository's approved platform TLS selection even when
    // tool.sh executes a cached builder and does not relink that builder.
    query:=[3]string.["bash","-c",". coax/platform/tls-env.sh && printf '%s %s' \"$CXTLS_CFLAGS\" \"$CXTLS_LIBS\""];
    tr:=proc_run(query[..],30000,tls[..],tls_err[..]);if tr.status!=0 || tr.cut {tool_errln(cast(string)tls_err[0..<tr.err_n]);return 1;}cn=hvb_flags(cast(string)tls[0..<tr.out_n],cc[..],cn);
  }
  if cn<0 {return 1;}
  if sanitize {cc[cn]="-fsanitize=address,undefined";cc[cn+1]="-fno-omit-frame-pointer";cc[cn+2]="-fno-sanitize-recover=all";cn+=3;}
  if !hvb_run(cc[0..<cn],"") {return 1;}
  print("Built native core observer: %\n",bin);return 0;
}
