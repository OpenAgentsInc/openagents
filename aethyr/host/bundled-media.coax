// Bundled files project the same normalized request pathname as the web host.
// The original URL remains the immutable cache/607 identity.
#load "http-target.coax";
#authority;
HmbCase :: struct {url:string;path:string;}
#test "bundled media maps normalized app paths without retaining query or fragment" {
 out:[12288]u8;
 for row:[13]HmbCase.[HmbCase.{url="/worlds/everglade/hotbar/a.jpg",path="/realms/everglade/hotbar/a.jpg"},
  HmbCase.{url="/worlds",path="/realms"},HmbCase.{url="/worlds?x#f",path="/realms"},HmbCase.{url="/worldsx/a",path="/worldsx/a"},
  HmbCase.{url="/worlds/",path="/realms/"},HmbCase.{url="/WORLDs/a",path="/WORLDs/a"},HmbCase.{url="/x?y=/worlds/a",path="/x"},
  HmbCase.{url="/x#?q",path="/x"},HmbCase.{url="/a/../worlds/b?x",path="/realms/b"},HmbCase.{url="/",path="/index.html"},
  HmbCase.{url="/a%2fb?q",path="/a%2fb"},HmbCase.{url="/é🙂",path="/%C3%A9%F0%9F%99%82"},HmbCase.{url="/a/..//b",path="//b"}] {
  n:=hmb_path(row.url,out[..]);#assert n==row.path.count&&cast(string)out[0..<n]==row.path;
 }
}
#test "bundled path refusal is atomic and exact output extent is admitted" {
 out:[32]u8;for i:0..<out.count {out[i]=37;}
 for url:[5]string.["","x","//other/x","https://other/x","/\\x"] {#assert hmb_path(url,out[..])== -1&&out[0]==37;}
 #assert hmb_path("/worlds/x",out[0..<8])== -1&&out[0]==37;
 #assert hmb_path("/worlds/x",out[0..<9])==9&&cast(string)out[0..<9]=="/realms/x"&&out[9]==37;
 for i:0..<out.count {out[i]=37;}
 #assert hmb_path("/",out[0..<10])== -1;for c:out {#assert c==37;}
 #assert hmb_path("/",out[0..<11])==11&&cast(string)out[0..<11]=="/index.html"&&out[11]==37;
}
#test "physical containment requires exact canonical roots and a child separator" {
 #assert hmb_inside("/bundle","/bundle/a")&&hmb_inside("/bundle","/bundle/a/b")&&hmb_inside("/","/a");
 for path:[5]string.["","/bundle","/bundle-other/a","bundle/a","/bundl/a"] {#assert !hmb_inside("/bundle",path);}
 #assert !hmb_inside("/","/")&&!hmb_inside("/","a")&&!hmb_inside("","/a")&&!hmb_inside("bundle","bundle/a")&&!hmb_inside("/bundle/","/bundle//a");
}
hmb_path :: (url:string,out:[]u8)->int #export_c #effects(all) {
 normalized:[12288]u8;n:=htr_http_target(url,normalized[..]);if n<1 {return -1;}
 end:=n;for c,i:normalized[0..<n] {if c=='?' {end=i;break;}}
 path:=cast(string)normalized[0..<end];prefix:="";start:=0;
 if path=="/" {prefix="/index.html";start=end;}
 else if path=="/worlds"||(path.count>=8&&path[0..<8]=="/worlds/") {prefix="/realms";start=7;}
 count:=prefix.count+end-start;if count>out.count {return -1;}
 at:=0;for c:prefix {out[at]=c;at+=1;}for c:path[start..<end] {out[at]=c;at+=1;}return at;
}
hmb_inside :: (root:string,path:string)->bool #export_c #effects(all) {
 if root.count<1||root[0]!='/' {return false;}
 if root=="/" {return path.count>1&&path[0]=='/';}
 if root[root.count-1]=='/' {return false;}
 return path.count>root.count&&path[0..<root.count]==root&&path[root.count]=='/';
}
