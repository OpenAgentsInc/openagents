// Actual browser allocations and borrowed producer views, checked by the same
// observation authority as native. No world, device or DSP sample claim.
#load "../../coax/web/wasm-chrome.coax";
#load "audio-memory-conformance.coax";
#load "audio-retention-conformance.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=4 {tool_errln("usage: check-browser-audio-memory SITE_ROOT LOCAL_URL REACTOR.wasm OUT.json");return 2;}
 url:=args_at(a[..],1);if url.count<17||url[0..<17]!="http://127.0.0.1:" {return 2;}
 site:=args_at(a[..],0);paths:[3][4096]u8;binary:[262144]u8;n:=fs_read(args_at(a[..],2),binary[..]);build:=fs_join(site,"build",paths[0][..]);
 if n<1||!fs_mkdir(site)||!fs_mkdir(build)||!fs_write(fs_join(build,"host-services.wasm",paths[1][..]),cast(string)binary[0..<n])||!fs_write(fs_join(site,"index.html",paths[2][..]),"<!doctype html><meta charset=utf-8><title>Host PCM ownership fixture</title>") {return 1;}
 c:[1]Cdp;if !cdp_launch(c[..],160,90,"coax-host-audio-memory-") {return 1;}defer {cdp_close(c[..]);}
 text:[32768]u8;params:[8192]u8;o:[1]Jo;jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);nav:=cdp_call(c[..],"Page.navigate",jo_text(o[..]),CDP_CALL_MS);
 script:="(async()=>{const {openHostServices,openPcmMemory}=await import('/coaxial/services-host.js');const services=await openHostServices(),m=openPcmMemory(services),memory=[],bank=[];for(const [f,c] of [[-1,1],[0,1],[9223372036854775807n,1],[1,0],[1,3],[4194305,2]])memory.push(Number(m.allocate(f,c)===null));memory.push(m.total());let q=m.allocate(4194304,2);memory.push(q.words,m.total(),Number(m.allocate(1,1)===null));q.release();memory.push(m.total());const rows=[];for(let i=0;i<128;i++)rows.push(m.allocate(1,1));memory.push(rows.length,m.total(),Number(m.allocate(1,1)===null));rows.shift().release();q=m.allocate(1,2);memory.push(m.total());q.release();rows.forEach(r=>r.release());memory.push(m.total());q=m.copy(new Float32Array([0,.125,.25,.375,.5,.625]),3,2);memory.push(q.words,m.total(),Number(q.samples[5]===.625));q.release();memory.push(m.total());const producer=new WebAssembly.Memory({initial:1}),base=4096,bytes=new Uint8Array(producer.buffer,base,44);for(let i=0;i<44;i++)bytes[i]=37+i;if(!services.span(base,44,44,producer.buffer.byteLength))throw Error('physical fixture refused');for(const line of [`x ${base} 44`,`x ${base} 44`,`y ${base-1} 1`,`y ${base+44} 1`,`y ${base} 45`,`y ${base} -1`,`y ${base} 0`,`../y ${base} 1`,`y ${base} 1 extra`,`y ${base+43} 1`]){const q=services.bankLine(line,base,44);bank.push(Number(!!q),services.bankCount(),q?.bytes??0,q?q.name.charCodeAt(0):0,q?new Uint8Array(producer.buffer,q.address,q.bytes)[0]:0)}q=m.allocate(3,2);const created=m.total();q.retain();m.retire();const retired=m.total();q.release();const held=m.total();q.release();return {memory,bank,retention:[created,retired,held,m.total()],retiredRefused:m.allocate(1,1)===null}})()";
 value:=cdp_evaluate(c[..],script);d:=cdp_doc(c[..]);if value<0 {tool_errln(cdp_error(c[..]));return 1;}memory:[20]int;bank:[50]int;retention:[4]int;
 for key:[3]string.["memory","bank","retention"] {node:=jv_get(d,value,key);want:=ifx key=="memory" then 20 else ifx key=="bank" then 50 else 4;if jv_len(d,node)!=want {return 1;}for i:0..<want {v:=jv_int(d,jv_at(d,node,i),-999);if key=="memory" {memory[i]=v;}else if key=="bank" {bank[i]=v;}else {retention[i]=v;}}}
 q:=HostAudioRetention.{created=retention[0],retired=retention[1],held=retention[2],released=retention[3]};passed:=mamm_accept(memory[..],bank[..])&&harr_accept(q)&&jv_bool(d,jv_get(d,value,"retiredRefused"));
 jo_start(o[..],text[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.browser-audio-memory.v1");jo_key(o[..],"observations");jv_write(d,value,o[..]);jo_key(o[..],"passed");jo_bool(o[..],passed);jo_end(o[..]);if o[0].bad||!fs_write(args_at(a[..],3),jo_text(o[..])) {return 1;}if !passed {tool_errln("Browser allocation/span observations differ; raw fields retained.");return 1;}
 print("Actual browser PCM memory: bounded extents, 128 tickets, measured bank views and retained retirement passed.\n");return 0;
}
