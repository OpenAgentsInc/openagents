// Observe actual immutable line copies and lease lifetimes in browser effects.
#load "../../coax/web/wasm-chrome.coax";
#load "audio-queue-conformance.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2 {tool_errln("usage: check-browser-audio-queue LOCAL_URL OUT.json");return 2;}
 url:=args_at(a[..],0);if url.count<17||url[0..<17]!="http://127.0.0.1:" {return 2;}
 c:[1]Cdp;if !cdp_launch(c[..],160,90,"coax-host-audio-queue-") {return 1;}defer {cdp_close(c[..]);}
 text:[16384]u8;params:[8192]u8;o:[1]Jo;jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);nav:=cdp_call(c[..],"Page.navigate",jo_text(o[..]),CDP_CALL_MS);
 script:="(async()=>{const {openHostServices}=await import('/coaxial/services-host.js');const s=await openHostServices(),r=[],info=()=>r.push(...s.audioQueueInfo());const a=s.audioLine('é'.repeat(512));r.push(a.bytes.length,a.bytes[0],a.bytes[1],a.bytes[1023]);info();const full=[a,...Array.from({length:3},()=>s.audioLine('x'.repeat(1024)))];info();r.push(Number(s.audioLine('x')===null));info();full.forEach(q=>q.release());info();const empty=Array.from({length:64},()=>s.audioLine(''));r.push(empty.filter(Boolean).length);info();r.push(Number(s.audioLine('')===null));empty[0].release();info();const reused=s.audioLine('x');r.push(Number(!!reused));info();r.push(Number(empty[0].release()));info();empty.forEach(q=>q.release());reused.release();info();r.push(Number(s.audioLine('é'.repeat(513))===null));info();const first=s.audioLine('first'),second=s.audioLine('second');r.push(Number(new TextDecoder().decode(first.bytes)==='first'));first.release();second.release();info();const old=Array.from({length:64},()=>s.audioLine('')),fresh=await openHostServices(),next=Array.from({length:64},()=>fresh.audioLine(''));r.push(s.audioQueueInfo()[0],fresh.audioQueueInfo()[0]);old.forEach(q=>q.release());r.push(s.audioQueueInfo()[0],fresh.audioQueueInfo()[0]);next.forEach(q=>q.release());r.push(fresh.audioQueueInfo()[0]);return r})()";
 value:=cdp_evaluate(c[..],script);d:=cdp_doc(c[..]);if value<0||jv_len(d,value)!=38 {tool_errln(cdp_error(c[..]));return 1;}rows:[38]int;for i:0..<38 {rows[i]=jv_int(d,jv_at(d,value,i),-999);}
 jo_start(o[..],text[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.browser-audio-queue.v1");jo_key(o[..],"rows");jv_write(d,value,o[..]);jo_key(o[..],"passed");jo_bool(o[..],haqc_accept(rows[..]));jo_end(o[..]);if o[0].bad||!fs_write(args_at(a[..],1),jo_text(o[..])) {return 1;}if !haqc_accept(rows[..]) {tool_errln("Actual browser audio queue observations differ; raw rows retained.");return 1;}print("Browser audio offer queue: all 38 observed byte/lease/owner fields passed.\n");return 0;
}
