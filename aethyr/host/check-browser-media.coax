 }
 source:[8388608]u8;native:[16777216]u8;raw:[16777216]u8;encoded:[65536]u8;js:[4096]u8;name_bytes:[512]u8;o:[1]Jo;report:[262144]u8;r:[1]Jo;jo_start(r[..],report[..]);jo_obj(r[..]);jo_key(r[..],"schema");jo_str(r[..],"aethyr.host.media-bank.v1");jo_key(r[..],"images");jo_arr(r[..]);count:=0;different:=0;total:=0;
 while true {
  name:=hmc_line(cast(string)list[0..<ln],count);if name=="" {break;}if name=="."||name==".." {return 1;}for letter:name {if letter=='/'||letter=='\\' {return 1;}}
  input:=fs_join(fixture,name,paths[6][..]);sn:=fs_read(input,source[..]);if sn<1||!rtq_input_add(inputs[..],input)||!wc_file(c[..],"input.img",cast(string)source[0..<sn]) {return 1;}
  p:=htm_plan(source[0..<sn]);if p.status!=0 {return 1;}values:[6]int;v:=cdp_evaluate(c[..],"hostMediaEffects.decode('input.img')");if v<0 {tool_errln(cdp_error(c[..]));return 1;}d:=cdp_doc(c[..]);if jv_len(d,v)!=6 {return 1;}for i:0..<6 {values[i]=jv_int(d,jv_at(d,v,i),-1);}if !hmc_plan(values[..],p) {return 1;}
  at:=0;while at<p.bytes {chunk:=ifx p.bytes-at<16384 then p.bytes-at else 16384;jo_start(o[..],js[..]);jo_put(o[..],"hostMediaEffects.read(");jo_int(o[..],at);jo_put(o[..],",");jo_int(o[..],chunk);jo_put(o[..],")");v=cdp_evaluate(c[..],jo_text(o[..]));if v<0 {return 1;}en:=jv_str(cdp_doc(c[..]),v,encoded[..]);if en<1||b64_decode(cast(string)encoded[0..<en],raw[at..<at+chunk])!=chunk {return 1;}at+=chunk;}
  jo_start(o[..],name_bytes[..]);jo_put(o[..],name);jo_put(o[..],".rgba");decoded:=fs_join(fixture,jo_text(o[..]),paths[7][..]);nn:=fs_read(decoded,native[..]);if !rtq_input_add(inputs[..],decoded) {return 1;}delta:=hmc_bytes(raw[0..<p.bytes],native[0..<(ifx nn<0 then 0 else nn)]);if delta<0 {return 1;}
  if !fs_write(fs_join(out,jo_text(o[..]),paths[8][..]),cast(string)raw[0..<p.bytes]) {return 1;}
  different+=delta;total+=p.bytes;count+=1;jo_obj(r[..]);jo_key(r[..],"source");jo_str(r[..],name);jo_key(r[..],"width");jo_int(r[..],p.width);jo_key(r[..],"height");jo_int(r[..],p.height);jo_key(r[..],"bytes");jo_int(r[..],p.bytes);jo_key(r[..],"different");jo_int(r[..],delta);jo_end(r[..]);print("Canonical media %: % bytes, % different.\n",count,p.bytes,delta);
