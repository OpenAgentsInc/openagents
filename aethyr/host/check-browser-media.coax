 paths:[10][4096]u8;wasm:=args_at(a[..],0);fixture:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 2;}listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 site:=fs_join(out,"site",paths[0][..]);if !fs_mkdir(site) {return 1;}binary:[2097152]u8;n:=fs_read(wasm,binary[..]);if n<1||!fs_write(fs_join(site,"host-media.wasm",paths[1][..]),cast(string)binary[0..<n])||!fs_write(fs_join(site,"index.html",paths[1][..]),"<!doctype html><title>Canonical authored media fixture</title>") {return 1;}
 inputs:[1]RtqInputs;for file:[4]string.[wasm,"coax/web/media-bridge.js","coax/web/media-face.c","aethyr/host/tests/media-effects.js"] {if !rtq_input_add(inputs[..],file) {return 1;}}
 compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if !rtq_input_add(inputs[..],compiler)||!rtq_deps(inputs[..],compiler,"aethyr/host/check-browser-media.coax",proc_now_ms()+30000,out,"observer-dependencies")||!rtq_deps(inputs[..],compiler,"aethyr/host/media-carrier.coax",proc_now_ms()+30000,out,"reactor-dependencies") {return 1;}
 self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1||!rtq_input_add(inputs[..],cast(string)self[0..<self_n])||!hmc_sources(inputs[..],out) {return 1;}
 list:[65536]u8;listpath:=fs_join(fixture,"media.list",paths[1][..]);ln:=fs_read(listpath,list[..]);if ln<1||!rtq_input_add(inputs[..],listpath) {return 1;}
