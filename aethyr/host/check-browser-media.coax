// Actual browser Wasm decoder against every byte of the native authored media.
#load "../../coax/web/wasm-chrome.coax";
#load "../render/tests/qualification-files.coax";
#load "media-conformance.coax";
hmc_line :: (text:string,wanted:int)->string {start:=0;line:=0;for c,i:text {if c=='\n' {if line==wanted {return rtq_trim(text[start..<i]);}line+=1;start=i+1;}}return ifx line==wanted then rtq_trim(text[start..<text.count]) else "";}
hmc_spawn :: (argv:[]string)->int {h:=proc_new();if h<0 {return -1;}for arg:argv {if !proc_arg(h,arg){_:=proc_release(h);return -1;}}if proc_start(h)!=0 {_:=proc_release(h);return -1;}return h;}
// Retain exact observer/reactor/effects source bytes, so later source edits
// cannot leave a passing receipt with only hashes of unavailable inputs.
hmc_sources :: (inputs:[]RtqInputs,out:string)->bool {
 paths:[2][4096]u8;directory:=fs_join(out,"sources",paths[0][..]);if !fs_mkdir(directory) {return false;}bytes:[2097152]u8;name:[80]u8;o:[1]Jo;
 for i:0..<inputs[0].count {row:=inputs[0].rows[i];path:=cast(string)row.path[0..<row.count];n:=path.count;
  source:=(n>=5&&path[n-5..<n]==".coax")||(n>=3&&path[n-3..<n]==".js")||(n>=2&&(path[n-2..<n]==".c"||path[n-2..<n]==".h"));if !source {continue;}
  count:=fs_read(path,bytes[..]);if count<0 {return false;}jo_start(o[..],name[..]);jo_put(o[..],cast(string)row.hash[..]);jo_put(o[..],".source");if !fs_write(fs_join(directory,jo_text(o[..]),paths[1][..]),cast(string)bytes[0..<count]) {return false;}
 }return rtq_inputs_match(inputs);
}
