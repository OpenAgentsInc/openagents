 server:=hmc_spawn(argv[..]);if server<0 {return 1;}defer {k:=proc_kill(server,PROC_SIGTERM);w:=proc_wait(server,2000);r:=proc_release(server);}
 waiting:[1]Cdp;body:[4096]u8;ready:=false;for attempt:0..<100 {if cdp_get(waiting[..],9181,"/",body[..])>0 {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
 c:[1]Cdp;if !cdp_launch(c[..],160,90,"coax-media-bank-") {return 1;}defer {cdp_close(c[..]);}
 nav:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9181/\"}",30000);ready=false;for attempt:0..<100 {if wc_eval(c[..],"document.readyState==='complete'&&location.hostname==='127.0.0.1'")=="true" {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
