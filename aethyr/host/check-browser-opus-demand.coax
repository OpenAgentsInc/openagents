 bytes:[1048576]u8;n:=fs_read(WC_HOST_FILE,bytes[..]);if n<0||wc_eval(c[..],cast(string)bytes[0..<n])!="ready" {return 1;}
 for i:0..<2 {n=fs_read(args_at(a[..],i+1),bytes[..]);if n<1||!wc_file(c[..],[2]string.["demand.json","room.wav"][i],cast(string)bytes[0..<n]) {return 1;}}
