// Real browser streams/crypto and Coax reader without a realm/GPU workload.
#load "../../coax/web/wasm-chrome.coax";
#load "pack-browser-conformance.coax";
#load "../forge/pack.coax";
#load "../render/tests/qualification-files.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3{tool_errln("usage: check-browser-packs ROOT REACTOR NEW_OUTPUT");return 2;}root:=args_at(a[..],0);reactor:=args_at(a[..],1);dir:=args_at(a[..],2);paths:[6][4096]u8;if fs_exists(dir)||!fs_mkdir(dir){return 2;}site:=fs_join(dir,"site",paths[0][..]);build:=fs_join(site,"build",paths[1][..]);if !fs_mkdir(build){return 1;}
 held:[1]RtqInputs;if !rtq_input_add(held[..],reactor){return 1;}for file:[4]string.["coax/web/pack-host.js","coax/web/tests/pack-fixture.js","aethyr/host/pack-browser-conformance.coax","aethyr/host/check-browser-packs.coax"]{if !rtq_input_add(held[..],fs_join(root,file,paths[2][..])){return 1;}}
 raw:[1048576]u8;n:=fs_read(reactor,raw[..]);if n<1||!fs_write(fs_join(build,"host-packs.wasm",paths[2][..]),cast(string)raw[0..<n]){return 1;}pack_bytes:[512]u8;fixture:=pack_test(600,pack_bytes[..]);if !fs_write(fs_join(site,"fixture.pack",paths[2][..]),fixture)||!fs_write(fs_join(site,"index.html",paths[2][..]),"<!doctype html><meta charset=utf-8><title>Pack stream observations</title>"){return 1;}
 p:=proc_new();if p<0{return 1;}defer{done:=proc_kill(p,PROC_SIGTERM);waited:=proc_wait(p,2000);released:=proc_release(p);}
 for arg:[9]string.[fs_join(root,"coax/web/serve.sh",paths[2][..]),site,"--host-dir",fs_join(root,"coax/web",paths[3][..]),"--listen","127.0.0.1:9186","--static","--cache","0"]{if !proc_arg(p,arg){return 1;}}if proc_start(p)!=0{return 1;}
 c:[1]Cdp;body:[4096]u8;deadline:=proc_now_ms()+10000;up:=false;while proc_now_ms()<deadline{if cdp_get(c[..],9186,"/",body[..])>0{up=true;break;}proc_sleep(50);}if !up||!cdp_launch(c[..],160,90,"coax-pack-stream-"){return 1;}defer{cdp_close(c[..]);}_:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9186/\"}",CDP_CALL_MS);
 deadline=proc_now_ms()+10000;up=false;while proc_now_ms()<deadline{if wc_eval(c[..],"document.readyState==='complete'&&location.origin==='http://127.0.0.1:9186'")=="true"{up=true;break;}proc_sleep(25);}if !up{return 1;}
 at:=cdp_evaluate(c[..],"(async()=>{try{const {packFixture}=await import('/coaxial/tests/pack-fixture.js');return await packFixture()}catch(e){return {error:String(e),stack:e.stack}}})()");if at<0{tool_errln(cdp_error(c[..]));return 1;}o:[1]Jo;jo_start(o[..],raw[..]);jv_write(cdp_doc(c[..]),at,o[..]);text:=jo_text(o[..]);if o[0].bad||!fs_write(fs_join(dir,"receipt.json",paths[4][..]),text){return 1;}d:[1]Jv;nodes:[4096]JvNode;ok:=jv_parse(d[..],text,nodes[..])&&hpbc_accept(d[0]);same:=rtq_inputs_match(held[..]);jo_start(o[..],raw[..]);jo_obj(o[..]);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"inputs");rtq_inputs_json(o[..],held[..],root);jo_end(o[..]);if o[0].bad||!fs_write(fs_join(dir,"source-observation.json",paths[4][..]),jo_text(o[..])){return 1;}print("Actual browser pack stream/crypto ownership:%,sourcefence:%\n",ok,same);return ifx ok&&same then 0 else 1;
}
