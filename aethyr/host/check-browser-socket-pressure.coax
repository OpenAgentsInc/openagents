// Actual ordinary host + physical WebSocket peer; no visible browser or sound.
#load "../../coax/web/wasm-chrome.coax";
#load "browser-socket-pressure.coax";
#load "browser-socket-local.coax";
#load "../render/tests/qualification-files.coax";
bsp_run :: (argv:[]string)->int {h:=proc_new();if h<0{return -1;}for arg:argv{if !proc_arg(h,arg){done:=proc_release(h);return -1;}}if proc_start(h)!=0{done:=proc_release(h);return -1;}return h;}
bsp_copy :: (src:string,dst:string)->bool {b:[1048576]u8;n:=fs_read(src,b[..]);return n>0&&fs_write(dst,cast(string)b[0..<n]);}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3||args_count(a[..])>4{tool_errln("usage: check-browser-socket-pressure ROOT PREPARED_FIXTURE NEW_OUTPUT [--local-room]");return 2;}root:=args_at(a[..],0);prepared:=args_at(a[..],1);dir:=args_at(a[..],2);paths:[8][4096]u8;local_room:=args_has(a[..],"--local-room");
 if fs_exists(dir)||!fs_mkdir(dir){return 2;}site:=fs_join(dir,"site",paths[0][..]);build:=fs_join(site,"build",paths[1][..]);if !fs_mkdir(build){return 1;}held:[1]RtqInputs;
 for file:[2]string.["fixture.wasm","fixture.wgsl"]{src:=fs_join(prepared,file,paths[2][..]);if !rtq_input_add(held[..],src)||!bsp_copy(src,fs_join(site,file,paths[3][..])){return 1;}}
 for file:[2]string.["host-services.wasm","host-sockets.wasm"]{src:=fs_join(prepared,file,paths[2][..]);if !rtq_input_add(held[..],src)||!bsp_copy(src,fs_join(build,file,paths[3][..])){return 1;}}
 if local_room{src:=fs_join(prepared,"everglade-room.wasm",paths[2][..]);if !rtq_input_add(held[..],src)||!bsp_copy(src,fs_join(build,"everglade-room.wasm",paths[3][..])){return 1;}}
 for file:[7]string.["coax/web/host.js","coax/web/socket-queue-host.js","coax/web/room-worker.js","coax/web/tests/socket-pressure-fixture.js","aethyr/host/tests/browser-socket-peer.coax","aethyr/host/check-browser-socket-pressure.coax","aethyr/host/browser-socket-pressure.coax"]{if !rtq_input_add(held[..],fs_join(root,file,paths[2][..])){return 1;}}
 page:="<!doctype html><meta charset=utf-8><canvas id=coaxial width=160 height=90></canvas><script>globalThis.coaxialClip=true</script><script type=module src=/coaxial/host.js data-app=host-contract data-wasm=/fixture.wasm data-wgsl=/fixture.wgsl></script>";if !fs_write(fs_join(site,"index.html",paths[2][..]),page){return 1;}
 tool:=fs_join(root,"coax/web/tool.sh",paths[2][..]);peer_src:=fs_join(root,"aethyr/host/tests/browser-socket-peer.coax",paths[3][..]);ready:=fs_join(dir,"peer.ready",paths[7][..]);peer_args:=[4]string.[tool,peer_src,"9185",ready];peer:=bsp_run(peer_args[..]);if peer<0{return 1;}defer{done:=proc_kill(peer,PROC_SIGTERM);waited:=proc_wait(peer,2000);released:=proc_release(peer);}
 serve_args:=[9]string.[fs_join(root,"coax/web/serve.sh",paths[4][..]),site,"--host-dir",fs_join(root,"coax/web",paths[5][..]),"--listen","127.0.0.1:9184","--static","--cache","0"];server:=bsp_run(serve_args[..]);if server<0{return 1;}defer{done:=proc_kill(server,PROC_SIGTERM);waited:=proc_wait(server,2000);released:=proc_release(server);}
 c:[1]Cdp;body:[4096]u8;deadline:=proc_now_ms()+10000;up:=false;while proc_now_ms()<deadline{if fs_exists(ready)&&cdp_get(c[..],9184,"/",body[..])>0{up=true;break;}proc_sleep(50);}if !up{return 1;}
 if !cdp_launch(c[..],160,90,"coax-socket-physical-"){return 1;}defer{cdp_close(c[..]);}_:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9184/?probe&probe-manual\"}",CDP_CALL_MS);
 deadline=proc_now_ms()+20000;up=false;while proc_now_ms()<deadline{if wc_eval(c[..],"!!coaxial?.ready&&!!coaxial.socketRetention()?.active")=="true"{up=true;break;}proc_sleep(50);}if !up{tool_errln(wc_eval(c[..],"document.body.innerText"));return 1;}
 physical_expr:="(async()=>{try{const {socketPressureFixture}=await import('/coaxial/tests/socket-pressure-fixture.js');return await socketPressureFixture()}catch(error){return {error:String(error),retention:coaxial.socketRetention(),events:Array.from({length:Number(coaxial.hostProbe(-1,2))},(_,i)=>Array.from({length:8},(_,f)=>Number(coaxial.hostProbe(i,f))))}}})()";
 local_expr:="(async()=>{try{const {socketLocalFixture}=await import('/coaxial/tests/socket-pressure-fixture.js');return await socketLocalFixture()}catch(error){return {error:String(error),room:coaxial.roomHost,retention:coaxial.socketRetention(),events:Array.from({length:Number(coaxial.hostProbe(-1,2))},(_,i)=>Array.from({length:8},(_,f)=>Number(coaxial.hostProbe(i,f))))}}})()";
 at:=cdp_evaluate(c[..],ifx local_room then local_expr else physical_expr);if at<0{tool_errln(cdp_error(c[..]));return 1;}
 bytes:[131072]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jv_write(cdp_doc(c[..]),at,o[..]);text:=jo_text(o[..]);if o[0].bad||!fs_write(fs_join(dir,"receipt.json",paths[6][..]),text){return 1;}d:[1]Jv;n:[4096]JvNode;ok:=jv_parse(d[..],text,n[..]);if ok{if local_room{fields:[8]int;if jv_len(d[0],0)!=8{ok=false;}else{for i:0..<8{fields[i]=jv_int(d[0],jv_at(d[0],0,i),-1);}ok=hbsl_accept(fields[..]);}}else{ok=hbsp_accept(d[0]);}}stable:=rtq_inputs_match(held[..]);jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],stable);jo_key(o[..],"inputs");rtq_inputs_json(o[..],held[..],root);jo_end(o[..]);if o[0].bad||!fs_write(fs_join(dir,"source-observation.json",paths[6][..]),jo_text(o[..])){return 1;}
 print("Actual ordinary browser socket pressure:%; sourcefence:%; browser/SDK/OS buffers remain distinct observations.\n",ok,stable);return ifx ok&&stable then 0 else 1;
}
