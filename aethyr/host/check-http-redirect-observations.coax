// Re-admit immutable actual SDK receipts. This never issues a network request.
#import "Basic";
#load "../tests/render-test-origin-policy.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/sys/args.coax";
#load "http-redirect-conformance.coax";
hrr_text :: (d:Jv,node:int,out:[]u8)->string {n:=jv_str(d,node,out);return ifx n<0 then "" else cast(string)out[0..<n];}
#test "receipt strings decode newline quotes and physical header separators" {
 bytes:="[\"0\\n\",\"{\\\"x\\\":1}\",\"Authorization: Test fixture\\r\\n\"]";nodes:[32]JvNode;d:[1]Jv;out:[128]u8;#assert jv_parse(d[..],bytes,nodes[..]);
 #assert hrr_text(d[0],jv_at(d[0],0,0),out[..])=="0\n"&&hrr_text(d[0],jv_at(d[0],0,1),out[..])=="{\"x\":1}"&&hrr_text(d[0],jv_at(d[0],0,2),out[..])=="Authorization: Test fixture\r\n";
}
hrr_header :: (head:string,key:string)->string {
 at:=0;while at<head.count {end:=rtq_find(head,"\r\n",at);if end<0 {return "";}line:=head[at..<end];colon:=rtq_find(line,":",0);same:=colon==key.count;for i:0..<key.count {if i>=colon||rto_lower(line[i])!=rto_lower(key[i]) {same=false;}}if same {return rto_trim(line[colon+1..<line.count]);}at=end+2;}return "";
}
hrr_path :: (status:int,target:int,post:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"/r/");jo_int(o[..],status);jo_put(o[..],"/");jo_int(o[..],target);jo_put(o[..],"/");jo_int(o[..],post);return jo_text(o[..]);}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2 {tool_errln("usage: check-http-redirect-observations RAW_DIR NEW_OUTPUT.json");return 2;}
 dir:=args_at(a[..],0);paths:[4][4096]u8;peer_bytes:[262144]u8;browser_bytes:[262144]u8;old_bytes:[262144]u8;peer_nodes:[32768]JvNode;browser_nodes:[32768]JvNode;old_nodes:[32768]JvNode;peer:[1]Jv;browser:[1]Jv;old:[1]Jv;
 if !rtq_json_file(fs_join(dir,"peer.json",paths[0][..]),peer_bytes[..],peer_nodes[..],peer[..])||!rtq_json_file(fs_join(dir,"browser.json",paths[1][..]),browser_bytes[..],browser_nodes[..],browser[..])||!rtq_json_file(fs_join(dir,"receipt.json",paths[2][..]),old_bytes[..],old_nodes[..],old[..]) {return 1;}
 q:[13]int;requests:=jv_get(peer[0],0,"requests");hosts:=jv_get(browser[0],0,"host");replies:=jv_get(browser[0],0,"replies");statuses:=[5]int.[301,302,303,307,308];
 if jv_len(peer[0],requests)!=45||jv_len(browser[0],replies)!=31||jv_len(browser[0],hosts)!=15 {return 1;}
 text:[16384]u8;body:[512]u8;expected:[128]u8;
 for i:0..<30 {
  if hrr_text(browser[0],jv_at(browser[0],replies,i),text[..])=="0\n" {q[0]+=1;}
  row:=jv_at(peer[0],requests,15+i);post:=i%2==1;
  if jv_raw(peer[0],jv_get(peer[0],row,"path"))==hrr_path(statuses[i/6],(i/2)%3,i%2,expected[..])&&jv_raw(peer[0],jv_get(peer[0],row,"method"))==(ifx post then "POST" else "GET")&&jv_int(peer[0],jv_get(peer[0],row,"status"),-1)==statuses[i/6] {q[1]+=1;}
  head:=hrr_text(peer[0],jv_get(peer[0],row,"head"),text[..]);payload:=hrr_text(peer[0],jv_get(peer[0],row,"body"),body[..]);auth:=hrr_header(head,"authorization");player:=hrr_header(head,"x-verse-player");
  if post {if auth=="Test fixture" {q[3]+=1;}if player=="fixture-player" {q[4]+=1;}if payload=="{\"x\":1}" {q[5]+=1;}}
  else if auth==""&&player==""&&payload=="" {q[6]+=1;}
 }
 for i:0..<15 {request:=jv_at(peer[0],requests,i);rows:=jv_at(browser[0],hosts,i);last:=jv_at(browser[0],rows,2);
  physical:=jv_raw(peer[0],jv_get(peer[0],request,"path"))==hrr_path(statuses[i/3],i%3,0,expected[..])&&jv_raw(peer[0],jv_get(peer[0],request,"method"))=="GET"&&jv_int(peer[0],jv_get(peer[0],request,"status"),-1)==statuses[i/3];
  if physical&&jv_len(browser[0],rows)==3&&jv_int(browser[0],jv_at(browser[0],last,0),-1)==4&&jv_int(browser[0],jv_at(browser[0],last,1),-1)==512&&jv_int(browser[0],jv_at(browser[0],last,6),-1)==2&&jv_int(browser[0],jv_at(browser[0],last,7),-1)==669875135 {q[2]+=1;}
 }
 q[7]=jv_int(peer[0],jv_get(peer[0],0,"landings"),-1);q[8]=jv_int(peer[0],jv_get(peer[0],0,"foreign"),-1);q[9]=ifx hrr_text(browser[0],jv_at(browser[0],replies,30),text[..])=="200\nok"&&!jv_bool(browser[0],jv_get(browser[0],0,"follow"))&&jv_bool(browser[0],jv_get(browser[0],0,"legacy")) then 1 else 0;
 q[10]=ifx jv_int(browser[0],jv_get(browser[0],0,"dropped"),-1)==0 then 1 else 0;q[11]=ifx jv_bool(peer[0],jv_get(peer[0],0,"finished")) then 1 else 0;
 map:=jv_get(old[0],0,"inputs");same:=jv_kind(old[0],map)==JV_OBJECT&&jv_len(old[0],map)==6&&jv_int(old[0],jv_at(old[0],jv_get(old[0],0,"observations"),12),-1)==1;at:=ifx map>=0 then old[0].nodes[map].first else -1;
 while at>=0 {hash:[64]u8;path:=jv_key(old[0],at);same=rtq_hash_file(path,hash[..])&&jv_raw(old[0],at)==cast(string)hash[..]&&same;at=old[0].nodes[at].next;}
 q[12]=ifx same then 1 else 0;passed:=hhrc_accept(q[..]);inputs:[1]RtqInputs;for name:[3]string.["peer.json","browser.json","receipt.json"] {if !rtq_input_add(inputs[..],fs_join(dir,name,paths[3][..])) {return 1;}}self:[4096]u8;sn:=cxproc_self_path(self[..]);if sn<1||!rtq_input_add(inputs[..],cast(string)self[0..<sn]) {return 1;}
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.http-redirect-observation.v1");jo_key(o[..],"observations");jo_arr(o[..]);for value:q {jo_int(o[..],value);}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],passed);jo_key(o[..],"original_inputs_unchanged");jo_bool(o[..],same);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);if o[0].bad||!fs_write(args_at(a[..],1),jo_text(o[..])) {return 1;}print("Immutable actual redirect observations: %\n",passed);return ifx passed then 0 else 1;
}
