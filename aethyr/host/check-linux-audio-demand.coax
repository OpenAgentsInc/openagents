 if !eager {operations:=jv_get(plan[0],0,"operations");for i:0..<jv_len(plan[0],operations) {row:=jv_at(plan[0],operations,i);kind:=jv_raw(plan[0],jv_get(plan[0],row,"op"));
   if kind=="command" {n:=jv_str(plan[0],jv_get(plan[0],row,"line"),line[..]);if n<1 {return 1;}result:=hld_command(line[0..<n],true);if result<0&&cast(string)line[0..<n]!="-1102" {render_ok=false;}}
   if kind=="render" {blocks:=jv_int(plan[0],jv_get(plan[0],row,"blocks"),-1);if blocks<1||blocks>128 {return 1;}for block:0..<blocks {if hld_block(actual[block*8192..<(block+1)*8192])!=8192 {return 1;}}
    filename:[4096]u8;n:=jv_str(plan[0],jv_get(plan[0],row,"file"),filename[..]);if n<1 {return 1;}file:=fs_base(cast(string)filename[0..<n]);reference:=fs_join(args_at(a[..],4),file,paths[1][..]);en:=fs_read(reference,expected[..]);if en<1||!rtq_input_add(inputs[..],reference) {return 1;}
    c:=hpcm_compare_words(actual[0..<blocks*8192],expected[0..<en]);render_ok=render_ok&&c.shape&&c.over==0&&c.nonfinite==0;render_count+=1;render_words+=c.samples;render_over+=c.over;render_nonfinite+=c.nonfinite;
    jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],file);jo_key(o[..],"samples");jo_int(o[..],c.samples);jo_key(o[..],"over_2pow_minus20");jo_int(o[..],c.over);jo_key(o[..],"nonfinite");jo_int(o[..],c.nonfinite);jo_key(o[..],"max_abs_f64_bits");jo_int(o[..],int(f64_bits(c.max_abs)));jo_end(o[..]);if !fs_write(fs_join(out,file,paths[2][..]),cast(string)actual[0..<blocks*8192]) {return 1;}
   }
  }render_ok=render_ok&&render_count==4&&render_words==262144&&render_over==0&&render_nonfinite==0;
 }
