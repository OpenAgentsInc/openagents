// Actual Linux PCM/WAV SDK and muted PipeWire effects. Orchestration,
// fixture inputs, sample comparison and device acceptance remain Coax.
#import "Basic";
#load "audio-device-conformance.coax";
#load "pcm-compare.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
hva_open :: ()->int #foreign;
hva_wav :: (name:[]u8,bytes:[]u8)->int #foreign;
hva_raw :: (bytes:[]u8,channels:int)->int #foreign;
hva_asset :: (id:int,out:[]u8)->int #foreign;
hva_channels :: (id:int)->int #foreign;
hva_command :: (line:[]u8,asset:int,channels:int,started:bool)->int #foreign;
hva_block :: (out:[]u8)->int #foreign;
hva_reset :: () #foreign;
hva_info :: (field:int)->int #foreign;
hva_device_open :: ()->int #foreign;
hva_device_start :: ()->int #foreign;
hva_device_pause :: (paused:bool)->int #foreign;
hva_device_info :: (field:int)->int #foreign;
hva_device_close :: () #foreign;
hva_close :: () #foreign;
hla_path :: (dir:string,name:string,out:[]u8)->string {return fs_join(dir,fs_base(name),out);}
hla_command :: (line:string,asset:int,channels:int,started:bool)->int {bytes:[2048]u8;if line.count>bytes.count {return -1;}for b,i:line {bytes[i]=b;}return hva_command(bytes[0..<line.count],asset,channels,started);}
hla_integer :: (o:[]Jo,key:string,value:int) {jo_key(o,key);jo_int(o,value);}
hla_compare :: (o:[]Jo,q:HostPcmCompare,different:int) {
 hla_integer(o,"samples",q.samples);hla_integer(o,"different_bytes",different);hla_integer(o,"over_2pow_minus20",q.over);hla_integer(o,"nonfinite",q.nonfinite);
 hla_integer(o,"max_abs_f64_bits",cast(int)f64_bits(q.max_abs));
}
hla_bytes :: (a:[]u8,b:[]u8)->int {if a.count!=b.count {return -1;}n:=0;for byte,i:a {if byte!=b[i] {n+=1;}}return n;}
hla_device_json :: (o:[]Jo,v:HostAudioDeviceObserved) {
 jo_obj(o);hla_integer(o,"format",v.format);hla_integer(o,"muted",v.muted);hla_integer(o,"rate",v.rate);hla_integer(o,"channels",v.channels);
 hla_integer(o,"initial_callbacks",v.initial_callbacks);hla_integer(o,"initial_coax",v.initial_coax);
 hla_integer(o,"running_callbacks",v.running_callbacks);hla_integer(o,"running_frames",v.running_frames);hla_integer(o,"running_coax",v.running_coax);
 hla_integer(o,"held_callbacks",v.held_callbacks);hla_integer(o,"held_coax",v.held_coax);
 hla_integer(o,"resumed_callbacks",v.resumed_callbacks);hla_integer(o,"resumed_frames",v.resumed_frames);hla_integer(o,"resumed_coax",v.resumed_coax);
 hla_integer(o,"closed_coax",v.closed_coax);hla_integer(o,"after_close_coax",v.after_close_coax);hla_integer(o,"failures",v.failures);hla_integer(o,"node",v.node);hla_integer(o,"nonzero_device_samples",v.nonzero);jo_end(o);
}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<6||args_count(a[..])>7||(args_count(a[..])==7&&args_at(a[..],6)!="--device-only") {tool_errln("usage: check-linux-audio BANK.json BANK_DIR PLAN.json PLAN_DIR NEW_OUT REPO [--device-only]");return 2;}
 out:=args_at(a[..],4);repo:=args_at(a[..],5);paths:[8][4096]u8;if !fs_mkdir(out)||!fs_mkdir(fs_join(out,"decoded",paths[0][..])) {return 1;}
 inputs:[1]RtqInputs;for file:[4]string.[args_at(a[..],0),args_at(a[..],2),fs_join(repo,"verse/native/audio-host.c",paths[0][..]),fs_join(repo,"verse/native/audio-pipewire.c",paths[1][..])] {if !rtq_input_add(inputs[..],file) {return 1;}}
 self:[4096]u8;sn:=cxproc_self_path(self[..]);if sn<1||!rtq_input_add(inputs[..],cast(string)self[0..<sn]) {return 1;}
 if hva_open()!=1 {tool_errln("Linux audio SDK open failed");return 1;}defer {hva_close();}
 text:[262144]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_json_file(args_at(a[..],0),text[..],nodes[..],d[..]) {return 1;}
 events:=jv_get(d[0],0,"events");assets:=-1;for i:0..<jv_len(d[0],events) {e:=jv_at(d[0],events,i);if jv_raw(d[0],jv_get(d[0],e,"op"))=="export" {assets=jv_get(d[0],e,"assets");}}
 if jv_len(d[0],assets)<48||jv_len(d[0],assets)>128 {tool_errln("Linux audio bank export extent differs");return 1;}source:[8388608]u8;reference:[8388608]u8;observed:[8388608]u8;name:[256]u8;file:[4096]u8;
 record:[1048576]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-audio.v1");jo_key(o[..],"bank");jo_arr(o[..]);passed:=true;device_only:=args_count(a[..])==7;
 bank_count:=0;for i:0..<jv_len(d[0],assets) {
  row:=jv_at(d[0],assets,i);wav:=jv_get(d[0],row,"wav");if jv_kind(d[0],wav)!=JV_STRING {continue;}nn:=jv_str(d[0],jv_get(d[0],row,"name"),name[..]);fn:=jv_str(d[0],wav,file[..]);if nn<1||fn<1 {tool_errln("Linux audio bank row lacks name or WAV path");return 1;}
  path:=hla_path(args_at(a[..],1),cast(string)file[0..<fn],paths[0][..]);n:=fs_read(path,source[..]);if n<1||!rtq_input_add(inputs[..],path) {tool_errln(path);return 1;}
  id:=hva_wav(name[0..<nn],source[0..<n]);if id!=bank_count {tool_errln("Linux SDK canonical bank refused");return 1;}bank_count+=1;an:=hva_asset(id,observed[..]);if an<1 {return 1;}actual:=observed[0..<an];channels:=hva_channels(id);
  if !device_only {
   fn=jv_str(d[0],jv_get(d[0],row,"file"),file[..]);if fn<1 {return 1;}path=hla_path(args_at(a[..],1),cast(string)file[0..<fn],paths[1][..]);en:=fs_read(path,reference[..]);if en<1||!rtq_input_add(inputs[..],path) {return 1;}
   q:=hpcm_compare_words(actual,reference[0..<en]);different:=hla_bytes(actual,reference[0..<en]);good:=q.shape&&q.nonfinite==0&&different==0&&channels==jv_int(d[0],jv_get(d[0],row,"channels"),-1)&&q.samples==jv_int(d[0],jv_get(d[0],row,"samples"),-1);passed=passed&&good;
   jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],cast(string)name[0..<nn]);jo_key(o[..],"passed");jo_bool(o[..],good);hla_compare(o[..],q,different);jo_end(o[..]);
   if !fs_write(fs_join(fs_join(out,"decoded",paths[2][..]),fs_base(cast(string)file[0..<fn]),paths[3][..]),cast(string)actual) {return 1;}
  }
 }jo_end(o[..]);if bank_count!=48 {tool_errln("Linux audio expected48 canonical WAVs");return 1;}
 path:=fs_join(args_at(a[..],3),"impulse.f32",paths[0][..]);n:=fs_read(path,source[..]);if n<1||!rtq_input_add(inputs[..],path) {return 1;}impulse:=hva_raw(source[0..<n],1);if impulse<0 {return 1;}
 plan:[131072]u8;plan_nodes:[8192]JvNode;pd:[1]Jv;if !rtq_json_file(args_at(a[..],2),plan[..],plan_nodes[..],pd[..]) {return 1;}
 jo_key(o[..],"renders");jo_arr(o[..]);count:=0;
 if !device_only {
  operations:=jv_get(pd[0],0,"operations");rendered:[1048576]u8;line:[2048]u8;
  for i:0..<jv_len(pd[0],operations) {
   op:=jv_at(pd[0],operations,i);kind:=jv_raw(pd[0],jv_get(pd[0],op,"op"));
   if kind=="reset" {hva_reset();}
   else if kind=="command" {ln:=jv_str(pd[0],jv_get(pd[0],op,"line"),line[..]);if ln<1 {return 1;}cue:=cast(string)line[0..<ln];raw:=cue=="impulse 0.03125 0 0 0 1 1 room-test";if hla_command(cue,ifx raw then impulse else -1,ifx raw then 1 else 0,true)<0 {tool_errln(cue);return 1;}}
   else if kind=="render" {
    blocks:=jv_int(pd[0],jv_get(pd[0],op,"blocks"),-1);if blocks<1||blocks>128 {return 1;}
    for block:0..<blocks {bytes:[8192]u8;if hva_block(bytes[..])!=8192 {return 1;}for byte,j:bytes {rendered[block*8192+j]=byte;}}
    fn:=jv_str(pd[0],jv_get(pd[0],op,"file"),file[..]);if fn<1 {return 1;}path=hla_path(args_at(a[..],3),cast(string)file[0..<fn],paths[0][..]);en:=fs_read(path,reference[..]);if en<1||!rtq_input_add(inputs[..],path) {return 1;}
    q:=hpcm_compare(rendered[0..<blocks*8192],reference[0..<en]);good:=q.shape&&q.nonfinite==0&&q.over==0;passed=passed&&good;count+=1;
    jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],fs_base(path));jo_key(o[..],"passed");jo_bool(o[..],good);hla_compare(o[..],q,hla_bytes(rendered[0..<blocks*8192],reference[0..<en]));jo_end(o[..]);
    if !fs_write(fs_join(out,fs_base(path),paths[1][..]),cast(string)rendered[0..<blocks*8192]) {return 1;}
    print("Actual Linux PCM %: max %, over %, nonfinite %.\n",fs_base(path),q.max_abs,q.over,q.nonfinite);
   }
  }passed=passed&&count==11;
 }jo_end(o[..]);
 if device_only {
  hva_reset();if hla_command("~ambient 0.125 0",-1,0,false)<0||hva_device_open()!=1 {return 1;}
  v:HostAudioDeviceObserved;v.initial_callbacks=hva_device_info(3);v.initial_coax=hva_info(0);
  if hva_device_start()!=1 {return 1;}until:=proc_now_ms()+5000;while hva_device_info(3)<1&&proc_now_ms()<until {proc_sleep(10);}proc_sleep(350);if hva_device_pause(true)!=1 {return 1;}
  v.format=hva_device_info(1);v.muted=hva_device_info(6);v.rate=hva_device_info(7);v.channels=hva_device_info(8);v.node=hva_device_info(9);
  v.running_callbacks=hva_device_info(3);v.running_frames=hva_device_info(4);v.running_coax=hva_info(0);proc_sleep(250);v.held_callbacks=hva_device_info(3);v.held_coax=hva_info(0);
  if hva_device_pause(false)!=1 {return 1;}proc_sleep(350);if hva_device_pause(true)!=1 {return 1;}
  v.resumed_callbacks=hva_device_info(3);v.resumed_frames=hva_device_info(4);v.resumed_coax=hva_info(0);v.failures=hva_device_info(5);v.nonzero=hva_device_info(10);hva_device_close();v.closed_coax=hva_info(0);proc_sleep(100);v.after_close_coax=hva_info(0);
  passed=passed&&had_device(v);jo_key(o[..],"device");hla_device_json(o[..],v);
 }
 same:=rtq_inputs_match(inputs[..]);passed=passed&&same;jo_key(o[..],"passed");jo_bool(o[..],passed);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"device_only");jo_bool(o[..],device_only);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);
 if o[0].bad||!fs_write(fs_join(out,"audio.json",paths[0][..]),jo_text(o[..])) {return 1;}
 print("Actual Linux audio component passed %.\n",passed);return ifx passed then 0 else 1;
}
