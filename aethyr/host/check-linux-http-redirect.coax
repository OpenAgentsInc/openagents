// Actual ordinary helper requests to a private physical peer. No browser/GPU.
#import "Basic";
#load "tests/http-redirect-peer.coax";
#load "http-native-conformance.coax";
hhn_header :: (head:string,key:string)->string {
 at:=0;while at<head.count {end:=rtq_find(head,"\r\n",at);if end<0 {return "";}line:=head[at..<end];colon:=rtq_find(line,":",0);same:=colon==key.count;for i:0..<key.count {if i>=colon||rto_lower(line[i])!=rto_lower(key[i]) {same=false;}}if same {return rto_trim(line[colon+1..<line.count]);}at=end+2;}return "";
}
hhn_path :: (status:int,target:int,post:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"/r/");jo_int(o[..],status);jo_put(o[..],"/");jo_int(o[..],target);jo_put(o[..],"/");jo_int(o[..],post);return jo_text(o[..]);}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) {return 2;}
 if args_at(a[..],0)=="--redirect-peer" {if args_count(a[..])!=5 {return 2;}return hdr_peer(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3),args_at(a[..],4));}
 if args_count(a[..])!=3 {tool_errln("usage: check-linux-http-redirect ROOT HELPER NEW_OUT");return 2;}
 root:=args_at(a[..],0);helper:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}paths:[12][4096]u8;self:[4096]u8;image:=gp_self(self[..]);portfile:=fs_join(out,"port.json",paths[0][..]);peerfile:=fs_join(out,"peer.json",paths[1][..]);
 inputs:[1]RtqInputs;for file:[5]string.[helper,image,"aethyr/host/http-redirect.coax","verse/native/net.coax","aethyr/host/http-native-conformance.coax"] {if !rtq_input_add(inputs[..],file) {return 1;}}
 p:=proc_new();if p<0 {return 1;}for arg:[6]string.[image,"--redirect-peer",root,out,portfile,peerfile] {if !proc_arg(p,arg) {return 1;}}if proc_start(p)!=0 {return 1;}
 defer {k:=proc_kill(p,PROC_SIGTERM);w:=proc_wait(p,1000);freed:=proc_release(p);}
 bytes:[262144]u8;nodes:[32768]JvNode;d:[1]Jv;port:=-1;deadline:=proc_now_ms()+10000;
 while proc_now_ms()<deadline {n:=fs_read(portfile,bytes[..]);if n>0&&jv_parse(d[..],cast(string)bytes[0..<n],nodes[..]) {port=jv_int(d[0],jv_at(d[0],0,0),-1);break;}proc_sleep(20);}if port<1 {return 1;}
 body:=fs_join(out,"body.json",paths[2][..]);if !fs_write(body,"Test fixture\n{\"x\":1}") {return 1;}number:[32]u8;nw:[1]Jo;jo_start(nw[..],number[..]);jo_int(nw[..],port);port_text:=jo_text(nw[..]);q:[12]int;
 raw:[262144]u8;rows:[1]Jo;jo_start(rows[..],raw[..]);jo_arr(rows[..]);env:[]string;stdout:[65536]u8;stderr:[65536]u8;statuses:=[5]int.[301,302,303,307,308];
 for i:0..<36 {
  legacy:=i>=30&&i<35;post:=i<30&&i%2==1;path:[128]u8;url:=ifx i==35 then "/ok" else hhn_path(statuses[ifx legacy then i-30 else i/6],ifx legacy then 2 else (i/2)%3,ifx post then 1 else 0,path[..]);
  name:[128]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],"answer-");jo_int(o[..],i);jo_put(o[..],".txt");answer:=fs_join(out,jo_text(o[..]),paths[3][..]);
  argv:=[11]string.[helper,answer,"http://127.0.0.1",port_text,ifx post then "29" else "4",url,ifx post then body else "-",ifx post then "fixture-player" else "-","128","2000","--host-v1"];
  label:[128]u8;jo_start(o[..],label[..]);jo_put(o[..],"request-");jo_int(o[..],i);r:=rtq_command(argv[0..<(ifx legacy then 10 else 11)],env,proc_now_ms()+5000,out,jo_text(o[..]),stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}
  response:[256]u8;n:=fs_read(answer,response[..]);text:=ifx n<0 then "" else cast(string)response[0..<n];jo_str(rows[..],text);
  if i<30&&text=="0\n" {q[0]+=1;}
  if legacy {expected:[32]u8;e:[1]Jo;jo_start(e[..],expected[..]);jo_int(e[..],statuses[i-30]);jo_put(e[..],"\n");if text==jo_text(e[..]) {q[8]+=1;}}
  if i==35&&text=="200\nok" {q[9]=1;}
 }
 jo_end(rows[..]);if !fs_write(fs_join(out,"responses.json",paths[4][..]),jo_text(rows[..]))||!rto_get(port,"/finish")||proc_wait(p,5000)!=0||!rtq_json_file(peerfile,bytes[..],nodes[..],d[..]) {return 1;}
 requests:=jv_get(d[0],0,"requests");if jv_len(d[0],requests)!=35 {return 1;}head_bytes:[16384]u8;body_bytes:[1024]u8;
 for i:0..<30 {row:=jv_at(d[0],requests,i);post:=i%2==1;expected:[128]u8;
  if jv_raw(d[0],jv_get(d[0],row,"path"))==hhn_path(statuses[i/6],(i/2)%3,i%2,expected[..])&&jv_raw(d[0],jv_get(d[0],row,"method"))==(ifx post then "POST" else "GET")&&jv_int(d[0],jv_get(d[0],row,"status"),-1)==statuses[i/6] {q[1]+=1;}
  head:=rto_string(d[0],jv_get(d[0],row,"head"),head_bytes[..]);payload:=rto_string(d[0],jv_get(d[0],row,"body"),body_bytes[..]);auth:=hhn_header(head,"authorization");player:=hhn_header(head,"x-verse-player");
  if post {if auth=="Test fixture" {q[2]+=1;}if player=="fixture-player" {q[3]+=1;}if payload=="{\"x\":1}" {q[4]+=1;}}else if auth==""&&player==""&&payload=="" {q[5]+=1;}
 }
 q[6]=jv_int(d[0],jv_get(d[0],0,"landings"),-1);q[7]=jv_int(d[0],jv_get(d[0],0,"foreign"),-1);q[10]=ifx rtq_inputs_match(inputs[..]) then 1 else 0;q[11]=ifx jv_bool(d[0],jv_get(d[0],0,"finished")) then 1 else 0;
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.native-http-redirect.v1");jo_key(o[..],"observations");jo_arr(o[..]);for value:q {jo_int(o[..],value);}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],hhrn_accept(q[..]));jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);if o[0].bad||!fs_write(fs_join(out,"receipt.json",paths[5][..]),jo_text(o[..])) {return 1;}print("Actual native redirect observations: %\n",hhrn_accept(q[..]));return ifx hhrn_accept(q[..]) then 0 else 1;
}
