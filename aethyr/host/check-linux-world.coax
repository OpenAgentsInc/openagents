// Run the ordinary native world; independently fence its measured inputs and
// admit the raw replacement-device observations through the checked observer.
#import "Basic";
#load "linux-world-conformance.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
hlwc_add :: (inputs:[]RtqInputs,path:string)->bool {for i:0..<inputs.count {if inputs[i].count<512 {return rtq_input_add(inputs[i..<i+1],path);}}return false;}
hlwc_tree :: (inputs:[]RtqInputs,dir:string,depth:int)->bool {
 if depth>12 {return false;}listing:[1]FsList;n:=fs_list(dir,listing[..]);if n<0||listing[0].full {return false;}
 for i:0..<n {path:[4096]u8;file:=fs_join(dir,fs_entry(listing[..],i),path[..]);kind:=fs_kind(file);if kind==FS_DIR {if !hlwc_tree(inputs,file,depth+1) {return false;}}else if kind!=FS_FILE||!hlwc_add(inputs,file) {tool_errln(file);return false;}}
 return true;
}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<4||args_count(a[..])>5||(args_count(a[..])==5&&args_at(a[..],4)!="--software") {tool_errln("usage: check-linux-world WORLD_BUILD FACTS NEW_OUT INPUT_MANIFEST [--software]");return 2;}software:=args_has(a[..],"--software");
 build:=args_at(a[..],0);facts:=args_at(a[..],1);out:=args_at(a[..],2);manifest:=args_at(a[..],3);if !fs_mkdir(out) {return 1;}paths:[8][4096]u8;listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 inputs:[3]RtqInputs;json:[262144]u8;nodes:[8192]JvNode;doc:[1]Jv;if !rtq_json_file(manifest,json[..],nodes[..],doc[..]) {return 1;}
 rows:=jv_get(doc[0],0,"inputs");if jv_kind(doc[0],rows)!=JV_OBJECT||jv_len(doc[0],rows)<1 {return 1;}
 for i:0..<jv_len(doc[0],rows) {row:=jv_at(doc[0],rows,i);file:=jv_key(doc[0],row);hash:[64]u8;if !rtq_hash_file(file,hash[..])||cast(string)hash[..]!=jv_raw(doc[0],row)||!rtq_input_add(inputs[..],file) {tool_errln(file);return 1;}}
 self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1||!hlwc_add(inputs[..],cast(string)self[0..<self_n]) {return 1;}
 bin:=fs_join(build,"vk-realm",paths[0][..]);if !hlwc_add(inputs[..],bin)||!hlwc_add(inputs[..],facts)||!hlwc_add(inputs[..],manifest)||!hlwc_add(inputs[..],fs_join(build,"libhostaudio.so",paths[1][..]))||!hlwc_tree(inputs[..],fs_join(build,"render",paths[2][..]),0)||!hlwc_tree(inputs[..],fs_join(build,"render-assets",paths[3][..]),0) {return 1;}
 raw:=fs_join(out,"observed.i64",paths[4][..]);argv:=[14]string.["nice","-n15",bin,build,"unused","--facts",facts,"--size","320x180","--golden","--headless","90","--host-recovery",raw];
 env:=[2]string.["VERSE_NATIVE_CLOCK_MS=0","LP_NUM_THREADS=2"];stdout:[1048576]u8;stderr:[1048576]u8;r:=rtq_command(argv[..],env[0..<(ifx software then 2 else 1)],proc_now_ms()+(ifx software then RTQ_DEADLINE_MS else 240000),out,"world",stdout[..],stderr[..]);
 bytes:[184]u8;q:[23]int;if fs_read(raw,bytes[..])!=bytes.count {return 1;}
 for i:0..<q.count {word:u64;for lane:0..<8 {word|=cast(u64)bytes[i*8+lane]<<(lane*8);}q[i]=cast,trunc(int)word;}
 // The SDK cannot assert its own immutable input fence. This observation is
 // supplied only after independently checking every recorded file again.
 stable:=true;for i:0..<inputs.count {stable=rtq_inputs_match(inputs[i..<i+1])&&stable;}q[22]=ifx stable then 1 else 0;
 passed:=rtq_ok(r)&&hlwc_accept(q[..]);report:[1048576]u8;o:[1]Jo;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-world-recovery.v1");jo_key(o[..],"observations");jo_arr(o[..]);for value:q {jo_int(o[..],value);}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],passed);jo_key(o[..],"software_workers");jo_int(o[..],ifx software then 2 else 0);jo_key(o[..],"input_groups");jo_arr(o[..]);for i:0..<inputs.count {rtq_inputs_json(o[..],inputs[i..<i+1],"");}jo_end(o[..]);jo_end(o[..]);if o[0].bad||!fs_write(fs_join(out,"receipt.json",paths[5][..]),jo_text(o[..])) {return 1;}return ifx passed then 0 else 1;
}
