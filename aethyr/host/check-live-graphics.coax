// Compare saved final Everglade live readbacks with the existing G5 live
// allowance (coax/tests/metal-parity.coax: 2,000 values at 320x180).
// Input/frame/package provenance is established by the capture/replay gates.
// No GPU command, mask, shader edit or tolerance adjustment occurs here.
#import "Basic";
#load "../render/emit.coax";
#load "../render/tests/compare-frames-policy.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=4 {tool_errln("usage: check-live-graphics REFERENCE_RGBA32F ACTUAL FORMAT NEW_RECEIPT");return 2;}
  reference:=args_at(a[..],0);actual:=args_at(a[..],1);format:=cf_format(args_at(a[..],2));receipt:=args_at(a[..],3);
  r:=cf_begin(320,180,format,fs_size(reference),fs_size(actual));if r.status!=CFStatus.ok || fs_exists(receipt) {return 2;}
  before:[2][64]u8;after:[64]u8;if !rtq_hash_file(reference,before[0][..]) || !rtq_hash_file(actual,before[1][..]) {return 1;}
  expected:[230400]f32;observed:[230400]f32;raw:[921600]u8;
  if fs_read(reference,raw[..])!=921600 {return 1;}
  for p:0..<57600 {for c:0..<4 {expected[p*4+c]=cast(f32)cf_value(raw[..],0,p,c);}}
  bytes:=57600*cf_stride(format);if fs_read(actual,raw[..])!=bytes {return 1;}
  for p:0..<57600 {for c:0..<4 {observed[p*4+c]=cast(f32)cf_value(raw[0..<bytes],format,p,c);}}
  comparison:=render_compare(expected[..],observed[..],2000);
  if !rtq_hash_file(reference,after[..]) || cast(string)after[..]!=cast(string)before[0][..] || !rtq_hash_file(actual,after[..]) || cast(string)after[..]!=cast(string)before[1][..] {return 1;}
  out:[8192]u8;o:[1]Jo;jo_start(o[..],out[..]);jo_obj(o[..]);
  jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.live-graphics-comparison.v1");jo_key(o[..],"status");jo_str(o[..],ifx comparison.status==RenderEmissionStatus.ok then "pass" else "fail");
  jo_key(o[..],"width");jo_int(o[..],320);jo_key(o[..],"height");jo_int(o[..],180);jo_key(o[..],"channels");jo_int(o[..],comparison.values);
  jo_key(o[..],"past_tolerance");jo_int(o[..],comparison.bad);jo_key(o[..],"nonfinite");jo_int(o[..],comparison.nonfinite);jo_key(o[..],"existing_live_allowance");jo_int(o[..],2000);jo_key(o[..],"masked_pixels");jo_int(o[..],0);
  jo_key(o[..],"rule");jo_str(o[..],"Existing render_compare: abs(actual-reference) <= 0.002 * max(1,abs(reference)); G5 live allows at most 2000 values beyond it, with every nonfinite fatal.");
  for file,i:[4]string.[reference,actual,"aethyr/render/emit.coax","coax/tests/metal-parity.coax"] {
    hash:[64]u8;if !rtq_hash_file(file,hash[..]) {return 1;}jo_key(o[..],[4]string.["reference","actual","comparison_authority","allowance_source"][i]);jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],file);jo_key(o[..],"sha256");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);
  }
  jo_end(o[..]);if o[0].bad || !fs_write(receipt,jo_text(o[..])) {return 1;}
  print("G5 live: %/% values past tolerance (existing allowance 2000), % nonfinite.\n",comparison.bad,comparison.values,comparison.nonfinite);
  return ifx comparison.status==RenderEmissionStatus.ok then 0 else 1;
}
