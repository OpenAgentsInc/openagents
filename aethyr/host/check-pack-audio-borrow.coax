// Actual pack-view lifetime through the real audio adapter; no live output.
#load "../../coax/web/wasm-chrome.coax";
#load "pack-audio-conformance.coax";
#load "../forge/pack.coax";
#load "../render/tests/qualification-files.coax";
hpa_copy :: (source:string,target:string)->bool {b:[1048576]u8;n:=fs_read(source,b[..]);return n>0&&fs_write(target,cast(string)b[0..<n]);}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=5{return 2;}root:=args_at(a[..],0);dir:=args_at(a[..],4);if fs_exists(dir)||!fs_mkdir(dir){return 2;}paths:[5][4096]u8;site:=fs_join(dir,"site",paths[0][..]);build:=fs_join(site,"build",paths[1][..]);if !fs_mkdir(build){return 1;}held:[1]RtqInputs;
 for name,i:[3]string.["host-packs.wasm","host-audio.wasm","host-services.wasm"]{source:=args_at(a[..],i+1);if !rtq_input_add(held[..],source)||!hpa_copy(source,fs_join(build,name,paths[2][..])){return 1;}}
 for file:[7]string.["coax/web/pack-host.js","coax/web/audio-host.js","coax/web/audio-bridge.js","coax/web/audio-worklet.js","coax/web/services-host.js","coax/web/tests/pack-audio-fixture.js","aethyr/host/pack-audio-conformance.coax"]{if !rtq_input_add(held[..],fs_join(root,file,paths[2][..])){return 1;}}
 ogg:[1048576]u8;path:=fs_join(root,"apps/openagents-web/realms/everglade/sfx/fire-cast-e2.ogg",paths[2][..]);n:=fs_read(path,ogg[..]);if n<1||!rtq_input_add(held[..],path){return 1;}sources:[5]PackSource;pack_test_sources("",sources[..]);sources[4].name="pack-borrow-fixture";sources[4].data=cast(string)ogg[0..<n];catalog:[4096]u8;bytes:=0;
 for iteration:0..<4{o:[1]Jo;jo_start(o[..],catalog[..]);jo_put(o[..],"pack tiny\nbudget 1048576\nbytes ");jo_int(o[..],bytes);jo_put(o[..],"\nL 0 Kit|CC0 1.0 Universal|https://example.org/\nL 1 Sounds|CC0 1.0 Universal|https://example.org/\nM Crate 0 3 0 -0.500 0.000 -0.500 0.500 1.000 0.500\nT 0 layer3.jpg 0\nS pack-borrow-fixture 1\n");sources[0].data=jo_text(o[..]);bytes=pack_size(sources[..]);}
 raw:[1048576]u8;count:=pack_write(sources[..],1048576,raw[..]);checked:[1]PackRead;if count<1||!pack_read(cast(string)raw[0..<count],checked[..])||!fs_write(fs_join(site,"audio.pack",paths[2][..]),cast(string)raw[0..<count])||!fs_write(fs_join(site,"index.html",paths[2][..]),"<!doctype html><meta charset=utf-8><title>Pack audio ownership</title>"){return 1;}
 p:=proc_new();if p<0{return 1;}defer{done:=proc_kill(p,PROC_SIGTERM);waited:=proc_wait(p,2000);released:=proc_release(p);}for arg:[9]string.[fs_join(root,"coax/web/serve.sh",paths[2][..]),site,"--host-dir",fs_join(root,"coax/web",paths[3][..]),"--listen","127.0.0.1:9186","--static","--cache","0"]{if !proc_arg(p,arg){return 1;}}if proc_start(p)!=0{return 1;}
 c:[1]Cdp;body:[4096]u8;deadline:=proc_now_ms()+10000;up:=false;while proc_now_ms()<deadline{if cdp_get(c[..],9186,"/",body[..])>0{up=true;break;}proc_sleep(25);}if !up||!cdp_launch(c[..],160,90,"coax-pack-audio-"){return 1;}defer{cdp_close(c[..]);}_:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9186/\"}",CDP_CALL_MS);deadline=proc_now_ms()+10000;up=false;while proc_now_ms()<deadline{if wc_eval(c[..],"location.origin==='http://127.0.0.1:9186'&&document.readyState==='complete'")=="true"{up=true;break;}proc_sleep(25);}if !up{return 1;}
 at:=cdp_evaluate(c[..],"(async()=>{try{return await(await import('/coaxial/tests/pack-audio-fixture.js')).packAudioFixture()}catch(e){return {error:String(e),stack:e.stack}}})()");if at<0{return 1;}o:[1]Jo;jo_start(o[..],raw[..]);jv_write(cdp_doc(c[..]),at,o[..]);text:=jo_text(o[..]);if !fs_write(fs_join(dir,"receipt.json",paths[2][..]),text){return 1;}d:[1]Jv;nodes:[4096]JvNode;ok:=jv_parse(d[..],text,nodes[..])&&jv_len(d[0],0)==20;v:[20]int;if ok{for i:0..<20{v[i]=jv_int(d[0],jv_at(d[0],0,i),-1);}ok=hpac_accept(v[..]);}stable:=rtq_inputs_match(held[..]);jo_start(o[..],raw[..]);jo_obj(o[..]);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],stable);jo_key(o[..],"inputs");rtq_inputs_json(o[..],held[..],root);jo_end(o[..]);if !fs_write(fs_join(dir,"source-observation.json",paths[2][..]),jo_text(o[..])){return 1;}print("Actual pack/audio SDK borrow:%;sourcefence:%\n",ok,stable);return ifx ok&&stable then 0 else 1;
}
