// The same authored loopback workload as check-browser, through the actual
// native realm SDK. Observed rows are admitted by the common Coax checker.
// tool.sh: tls
#import "Basic";
#load "receipt-transport.coax";
#load "local-conformance.coax";
#load "http-conformance.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/net/http.coax";
hvn_open :: ()->int #foreign;
hvn_net :: (helper:[]u8,dir:[]u8)->int #foreign;
hvn_observe :: (event:int,field:int)->int #foreign;
hvn_reset :: () #foreign;
hvn_send :: (kind:int,bytes:[]u8) #foreign;
hvn_poll :: () #foreign;
hvn_close :: () #foreign;
hvn_clock :: (kind:int)->int #foreign;
hvt_send :: (kind:int,text:string) {bytes:[128]u8;for b,i:text {bytes[i]=b;}hvn_send(kind,bytes[0..<text.count]);}
hvt_count :: (kind:int)->int {n:=0;for i:0..<hvn_observe(-1,2) {if hvn_observe(i,0)==4 && hvn_observe(i,1)==kind {n+=1;}}return n;}
hvt_wait :: (kind:int,count:int)->bool {deadline:=proc_now_ms()+5000;while proc_now_ms()<deadline {hvn_poll();if hvt_count(kind)>=count {return true;}proc_sleep(2);}tool_errln("waiting for native callback exceeded five seconds");return false;}
hvt_drain :: (ms:int) {deadline:=proc_now_ms()+ms;while proc_now_ms()<deadline {hvn_poll();proc_sleep(2);}}
hvt_local :: ()->bool {
  hvt_send(910,"local:/api/room/relay/everglade/local-1");if !hvt_wait(256,1) {return false;}
  hvt_send(911,"0 route");if !hvt_wait(257,1) {return false;}
  hvt_send(911,"0 Aé🙂");if !hvt_wait(257,2) {return false;}
  hvt_send(912,"0");return hvt_wait(258,1);
}
hvt_urls :: ()->bool {
  for q,i:htu_cases() {hvt_send(920,q.input);if !hvt_wait(512,i+1) {return false;}}return true;
}
hvt_workload :: ()->bool {
  for i:0..<5 {hvt_send(910,"ws://127.0.0.1:9170/echo");}
  for i:0..<4 {if !hvt_wait(256+4*i,1) {return false;}}
  hvt_send(911,"0 Aé🙂");hvt_send(911,"1 ");hvt_send(911,"2 first");hvt_send(911,"2 second");
  if !hvt_wait(257,1) || !hvt_wait(261,1) || !hvt_wait(265,2) {return false;}
  hvt_send(911,"0 large");if !hvt_wait(259,1) {return false;}
  hvt_send(911,"0 binary");hvt_drain(250);
  hvt_send(912,"1");hvt_send(910,"ws://127.0.0.1:9170/echo");if !hvt_wait(260,2) {return false;}
  hvt_send(920,"/api/host-contract/ok");if !hvt_wait(512,1) {return false;}
  hvt_send(920,"/api/host-contract/large");if !hvt_wait(512,2) {return false;}
  hvt_send(920,"/api/host-contract/invalid");if !hvt_wait(512,3) {return false;}
  hvt_send(920,"/api/host-contract/slow");hvt_send(921,"0");hvt_send(920,"/api/host-contract/ok");
  if !hvt_wait(512,4) {return false;}hvt_drain(350);
  for i:0..<9 {hvt_send(920,"/api/host-contract/batch");}
  for i:0..<8 {if !hvt_wait(512+i,ifx i==0 then 5 else 1) {return false;}}
  for i:0..<4 {text:[20]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_int(o[..],i);hvt_send(912,jo_text(o[..]));}
  for i:0..<4 {if !hvt_wait(258+4*i,1) {return false;}}return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}
  if args_count(a[..])==1 && args_at(a[..],0)=="--clocks" {
    bytes:[64]u8;fake:=proc_getenv("VERSE_NATIVE_CLOCK_MS",bytes[..]);ms:=hvn_clock(0);seconds:=hvn_clock(1);
    if fake!="" {n:=args_whole(fake);return ifx ms==n && seconds==n/1000 then 0 else 1;}
    return ifx ms>=0 && seconds>=1000000000 && ms/1000<seconds then 0 else 1;
  }
  server_exe:=args_value(a[..],"--server","");count:=args_count(a[..])-(ifx server_exe=="" then 0 else 2);
  local:=count==4 && args_at(a[..],3)=="--local";
  urls:=count==4 && args_at(a[..],3)=="--http-target";
  if count!=3 && !local && !urls {tool_errln("usage: check-vulkan-transport OUT.json HTTP_HELPER STATE_DIR [--local | --http-target] [--server EXECUTABLE] | --clocks");return 2;}
  server:=proc_new();if server<0 {return 1;}defer {killed:=proc_kill(server,PROC_SIGTERM);waited:=proc_wait(server,2000);released:=proc_release(server);}
  if server_exe=="" {if !proc_arg(server,"coax/web/tool.sh")||!proc_arg(server,"aethyr/host/tests/network.coax") {return 1;}}
  else {if !proc_arg(server,server_exe) {return 1;}}
  if !proc_arg(server,"9170") || proc_start(server)!=0 {return 1;}
  health:[1]HttpWork;body:[128]u8;headers:[]string;until:=proc_now_ms()+15000;ready:=false;
  while proc_now_ms()<until {r:=http_do(health[..],"GET","http://127.0.0.1:9170/health",headers,"",250,0,body[..]);if r.error==HTTP_OK && r.code==200 && cast(string)body[0..<r.n]=="ok" {ready=true;break;}proc_sleep(25);}
  if !ready || hvn_open()!=1 {tool_errln("loopback fixture did not become ready");return 1;}defer {hvn_close();}
  helper:[4096]u8;dir:[4096]u8;hp:=args_at(a[..],1);dp:=args_at(a[..],2);if hp.count>helper.count || dp.count>dir.count {return 2;}
  for b,i:hp {helper[i]=b;}for b,i:dp {dir[i]=b;}
  if hvn_net(helper[0..<hp.count],dir[0..<dp.count])!=0 {return 1;}hvn_reset();
  completed:=ifx urls then hvt_urls() else ifx local then hvt_local() else hvt_workload();rows:[96][8]int;n:=hvn_observe(-1,2);if n<0 || n>96 {return 1;}
  for i:0..<n {for k:0..<8 {rows[i][k]=hvn_observe(i,k);}}
  buf:[32768]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_obj(o[..]);
  jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.observations.v1");jo_key(o[..],"host");jo_str(o[..],"vulkan");jo_key(o[..],"scope");jo_str(o[..],ifx urls then "http-target" else ifx local then "local-route" else "transport");jo_key(o[..],"dropped");jo_int(o[..],hvn_observe(-1,3));jo_key(o[..],"events");jo_arr(o[..]);
  for row:rows[0..<n] {jo_arr(o[..]);for value:row {jo_int(o[..],value);}jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);
  if o[0].bad || !fs_write(args_at(a[..],0),jo_text(o[..])) {return 1;}
  d:[1]Jv;nodes:[2048]JvNode;admitted:=ifx urls then hvn_observe(-1,3)==0 && htu_rows(rows[0..<n]) else ifx local then hcl_local_rows(rows[0..<n],hvn_observe(-1,3)) else jv_parse(d[..],jo_text(o[..]),nodes[..]) && hcr_transport(d[0]);
  if !completed || !admitted {tool_errln("actual Linux transport observations differ; raw rows retained");return 1;}
  print("Native Vulkan realm transport observations passed (local route: %).\n",local);return 0;
}
