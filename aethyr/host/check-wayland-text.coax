 protocol:string="";for suffix,k:[2]string.["-client-protocol.h","-protocol.c"]{name:[128]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],"text-input-unstable-v3");jo_put(o[..],suffix);dest:=fs_join(out,jo_text(o[..]),paths[12+k][..]);scan:=[4]string.["wayland-scanner",ifx k==0 then "client-header" else "private-code",xml,dest];r=rtq_command(scan[..],env,proc_now_ms()+30000,out,jo_text(o[..]),stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_input_add(inputs[..],dest){return 1;}if k==1{protocol=dest;}}
