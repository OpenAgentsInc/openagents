 query:=[3]string.["pkg-config","--variable=pkgdatadir","wayland-protocols"];r=rtq_command(query[..],env,proc_now_ms()+30000,out,"window-protocol-dir",stdout[..],stderr[..]);if !rtq_ok(r){return false;}dir:[4096]u8;pn:=r.out_n;while pn>0&&(stdout[pn-1]==10||stdout[pn-1]==13){pn-=1;}if pn>dir.count{return false;}for i:0..<pn{dir[i]=stdout[i];}
 protocols:[2]string;for spec,i:[2][2]string.[[2]string.["stable/xdg-shell/xdg-shell.xml","xdg-shell"],[2]string.["unstable/xdg-decoration/xdg-decoration-unstable-v1.xml","xdg-decoration-unstable-v1"]]{
  xml:=fs_join(cast(string)dir[0..<pn],spec[0],paths[11][..]);if !rtq_input_add(inputs,xml){return false;}
  for suffix,k:[2]string.["-client-protocol.h","-protocol.c"]{name:[128]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],spec[1]);jo_put(o[..],suffix);dest:=fs_join(out,jo_text(o[..]),paths[12+2*i+k][..]);scan:=[4]string.["wayland-scanner",ifx k==0 then "client-header" else "private-code",xml,dest];r=rtq_command(scan[..],env,proc_now_ms()+30000,out,jo_text(o[..]),stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_input_add(inputs,dest){return false;}if k==1{protocols[i]=dest;}}
 }
 pkg:=[5]string.["pkg-config","--cflags","--libs","wayland-client","xkbcommon"];r=rtq_command(pkg[..],env,proc_now_ms()+30000,out,"window-pkg-config",stdout[..],stderr[..]);if !rtq_ok(r){return false;}flags:[8192]u8;if r.out_n>flags.count{return false;}for i:0..<r.out_n{flags[i]=stdout[i];}flag_n:=r.out_n;
 argv:[64]string;n:=0;for flag:[10]string.["nice","-n15","gcc","-std=gnu11",ifx sanitize then "-O1" else "-O2","-g","-ffunction-sections","-fdata-sections","-Wl,--gc-sections","-ffp-contract=off"]{argv[n]=flag;n+=1;}
 if sanitize{argv[n]="-fsanitize=address,undefined";argv[n+1]="-fno-omit-frame-pointer";n+=2;}
 for include:[3]string.[out,fs_join(root,"verse/gpu",paths[16][..]),fs_join(root,"verse/kms",paths[17][..])]{argv[n]="-I";argv[n+1]=include;n+=2;}
 for file:[6]string.[fs_join(root,"aethyr/host/wayland-text-window-fixture.c",paths[18][..]),source,fs_join(out,"wayland-text.c",paths[19][..]),protocols[0],protocols[1],fs_join(out,"text-input-unstable-v3-protocol.c",paths[20][..])]{argv[n]=file;n+=1;}
 n=hwtc_flags(cast(string)flags[0..<flag_n],argv[..],n);if n<0{return false;}binary:=fs_join(out,"window-fixture",paths[21][..]);for flag:[4]string.["-lpthread","-lm","-o",binary]{argv[n]=flag;n+=1;}
