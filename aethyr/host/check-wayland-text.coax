 r:=rtq_command(emit[..],env,proc_now_ms()+90000,out,"coax-emit",stdout[..],stderr[..]);if !rtq_ok(r)||!fs_write(source,cast(string)stdout[0..<r.out_n])||!rtq_input_add(inputs[..],source)||!rtq_input_add(inputs[..],header){return 1;}
