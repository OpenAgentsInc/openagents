// One-command physical SDK/descriptor check; no window, audio device or GPU.
#import "Basic";
#load "wayland-text-conformance.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
#test "SDK flags project literal words into bounded argv" {
 out:[2]string;#assert hwtc_flags(" -I/a\t-lm\n",out[..],0)==2&&out[0]=="-I/a"&&out[1]=="-lm";
 #assert hwtc_flags("a b c",out[..],0)== -1;
}
hwtc_flags::(text:string,out:[]string,n:int)->int {at:=n;from:=0;for i:0..<text.count+1{if i==text.count||text[i]==' '||text[i]=='\n'||text[i]=='\t'{if i>from{if at==out.count{return -1;}out[at]=text[from..<i];at+=1;}from=i+1;}}return at;}
hwtc_receipt::(path:string)->bool {
 bytes:[65536]u8;nodes:[2048]JvNode;d:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],d[..]){return false;}
 if jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.host.wayland-text.v1"{return false;}
 list:=jv_get(d[0],0,"rows");if jv_len(d[0],list)!=25{return false;}rows:[100]int;for i:0..<25{row:=jv_at(d[0],list,i);if jv_len(d[0],row)!=4{return false;}for k:0..<4{rows[4*i+k]=jv_int(d[0],jv_at(d[0],row,k),-999);}}return hwtc_accept(rows[..]);
}
hwtc_window::(root:string,out:string,compiler:string,sanitize:bool,inputs:[]RtqInputs)->bool {
