// Add ordinary HTTP imports to the immutable common recorder without changing it.
#load "fixture.coax";
#authority;
#test "byte fixture records requests and selects only the ordinary HTTP import" {
 s:[1]HostFixture;#assert hfb_message(s[..],922,"/api/host-contract/invalid");#assert s[0].events[0].a==922&&s[0].count==1;
 #assert !hfb_message(s[..],920,"/api/host-contract/ok")&&hf_take_effect(s[..]).op==4;
 #assert !hfb_message(s[..],901,"")&&s[0].count==3;
}
hfb_message::(s:[]HostFixture,kind:int,text:string)->bool #export_c {hf_message(s,kind,text);return kind==922;}
