// Origin-bound HTTP request targets. This is the root-relative subset of
// browser URL parsing; it never chooses a host. In particular a normalized
// pathname beginning // remains a path on the already bound site.
#load "routes.coax";
#load "../../coax/lib/nostr/json.coax";
#authority;

HttCase :: struct {input:string;target:string;}
#test "HTTP targets preserve browser path query and fragment semantics" {
  cases:=[23]HttCase.[
    HttCase.{input="/",target="/"},HttCase.{input="/ ",target="/"},HttCase.{input="/a b",target="/a%20b"},HttCase.{input="/a#x",target="/a"},
    HttCase.{input="/a/../b",target="/b"},HttCase.{input="/a/%2E/b",target="/a/b"},HttCase.{input="/a/..//b",target="//b"},
    HttCase.{input="/a//../b",target="/a/b"},HttCase.{input="/a/.",target="/a/"},HttCase.{input="/a/..",target="/"},
    HttCase.{input="/a%2fb",target="/a%2fb"},HttCase.{input="/a?x=é🙂",target="/a?x=%C3%A9%F0%9F%99%82"},
    HttCase.{input="/a?",target="/a?"},HttCase.{input="/a?#z",target="/a?"},HttCase.{input="/a?x=  #f",target="/a?x=%20%20"},
    HttCase.{input="/a?x=  ",target="/a?x="},HttCase.{input="/a%",target="/a%"},HttCase.{input="/file:c",target="/file:c"},
    HttCase.{input="/../../b",target="/b"},HttCase.{input="/a///b/",target="/a///b/"},HttCase.{input="/é🙂",target="/%C3%A9%F0%9F%99%82"},
    HttCase.{input="/x?y=/a/../b",target="/x?y=/a/../b"},HttCase.{input="/#?x",target="/"}];
  out:[12288]u8;
  for q:cases {n:=htr_http_target(q.input,out[..]);#assert n==q.target.count && cast(string)out[0..<n]==q.target;}
}
#test "HTTP dot segments include every case of percent encoded dot" {
  out:[12288]u8;
  for d:[3]string.[".","%2e","%2E"] {
    b:[32]u8;at:=0;for c:"/a/" {b[at]=c;at+=1;}for c:d {b[at]=c;at+=1;}
    n:=htr_http_target(cast(string)b[0..<at],out[..]);#assert n==3 && cast(string)out[0..<n]=="/a/";
    for c:"/b" {b[at]=c;at+=1;}n=htr_http_target(cast(string)b[0..<at],out[..]);#assert n==4 && cast(string)out[0..<n]=="/a/b";
  }
  for d:[9]string.["..",".%2e",".%2E","%2e.","%2E.","%2e%2e","%2e%2E","%2E%2e","%2E%2E"] {
    b:[32]u8;at:=0;for c:"/a/" {b[at]=c;at+=1;}for c:d {b[at]=c;at+=1;}
    n:=htr_http_target(cast(string)b[0..<at],out[..]);#assert n==1 && out[0]=='/';
    for c:"/b" {b[at]=c;at+=1;}n=htr_http_target(cast(string)b[0..<at],out[..]);#assert n==2 && cast(string)out[0..<n]=="/b";
  }
  for path:[8]string.["/...","/.x","/%2f","/%2","/%2g","/%2eX","/%2e%2eX","/%2e%2e%2e"] {
    n:=htr_http_target(path,out[..]);#assert n==path.count && cast(string)out[0..<n]==path;
  }
}
#forall "HTTP ASCII encoding matches path and special query percent sets" value:32..<127 {
  c:=cast(u8)value;out:[32]u8;b:[4]u8;b[0]='/';b[1]=c;b[2]='x';
  n:=htr_http_target(cast(string)b[0..<3],out[..]);
  if c=='\\' {#assert n== -1;}
  else if c=='#' {#assert n==1 && out[0]=='/';}
  else if c=='?' {#assert n==3 && cast(string)out[0..<n]=="/?x";}
  else if c=='/' {#assert n== -1;}
  else {
    enc:=c==' ' || c=='"' || c=='<' || c=='>' || c=='`' || c=='{' || c=='}' || c=='^' || c=='|';
    #assert n==(ifx enc then 5 else 3) && out[0]=='/' && out[n-1]=='x';
    if enc {#assert out[1]=='%' && out[2]=="0123456789ABCDEF"[value/16] && out[3]=="0123456789ABCDEF"[value%16];}
    else {#assert out[1]==c;}
  }
  b[1]='?';b[2]=c;b[3]='x';n=htr_http_target(cast(string)b[..],out[..]);
  if c=='\\' {#assert n== -1;}
  else if c=='#' {#assert n==2 && cast(string)out[0..<n]=="/?";}
  else {
    enc:=c==' ' || c=='"' || c==39 || c=='<' || c=='>';
    #assert n==(ifx enc then 6 else 4) && out[0]=='/' && out[1]=='?' && out[n-1]=='x';
    if enc {#assert out[2]=='%' && out[3]=="0123456789ABCDEF"[value/16] && out[4]=="0123456789ABCDEF"[value%16];}
    else {#assert out[2]==c;}
  }
}
#test "HTTP target refusal writes nothing and admits the complete expansion only" {
  out:[12289]u8;for i:0..<out.count {out[i]=37;}
  for path:[8]string.["","x","//x","/\\x","/\n","/\r","/\t","/\0"] {#assert htr_http_target(path,out[..])== -1 && out[0]==37;}
  bad:[2]u8;bad[0]='/';bad[1]=255;#assert htr_http_target(cast(string)bad[..],out[..])== -1 && out[0]==37;
  bad[1]=127;#assert htr_http_target(cast(string)bad[..],out[..])== -1 && out[0]==37;
  #assert htr_http_target("/é",out[0..<6])== -1 && out[0]==37;
  #assert htr_http_target("/é",out[0..<7])==7 && cast(string)out[0..<7]=="/%C3%A9" && out[7]==37;
  b:[4097]u8;b[0]='/';for i:1..<b.count {b[i]='a';}
  #assert htr_http_target(cast(string)b[..],out[..])== -1;
  #assert htr_http_target(cast(string)b[0..<4096],out[..])==4096 && out[4095]=='a' && out[4096]==37;
  for i:1..<4095 {b[i]=ifx i%2==1 then 195 else 169;}b[4095]=' ';
  #assert htr_http_target(cast(string)b[0..<4096],out[..])==12283 && out[12282]=='9' && out[12283]==37;
}
#forall "HTTP byte encoder publishes the exact complete byte at an arbitrary offset" value:0..<256 {
  out:[8]u8;for i:0..<8 {out[i]=37;}
  for query:[2]bool.[false,true] {
    n:=htr_http_encode(out[..],2,cast(u8)value,query);
    encoded:=value<=32 || value>=127 || value==34 || value==60 || value==62 || (query && value==39) || (!query && (value==96 || value==123 || value==125 || value==94 || value==124));
    #assert n==(ifx encoded then 5 else 3) && out[1]==37 && out[5]==37;
    if encoded {#assert out[2]=='%' && out[3]=="0123456789ABCDEF"[value/16] && out[4]=="0123456789ABCDEF"[value%16];}
    else {#assert out[2]==cast(u8)value;}
  }
}

htr_http_dot :: (s:string)->int {
  dots:=0;i:=0;
  while i<s.count {
    if s[i]=='.' {i+=1;}
    else if i+2<s.count && s[i]=='%' && s[i+1]=='2' && (s[i+2]=='e' || s[i+2]=='E') {i+=3;}
    else {return 0;}
    dots+=1;if dots>2 {return 0;}
  }
  return dots;
}
htr_http_encode :: (out:[]u8,at:int,c:u8,query:bool)->int {
  encode:=c<=32 || c>126 || c=='"' || c=='<' || c=='>';
  if query {encode=encode || c==39;}
  else {encode=encode || c=='`' || c=='{' || c=='}' || c=='^' || c=='|';}
  if encode {out[at]='%';out[at+1]="0123456789ABCDEF"[cast(int)c/16];out[at+2]="0123456789ABCDEF"[cast(int)c%16];return at+3;}
  out[at]=c;return at+1;
}
htr_http_target :: (url:string,out:[]u8)->int #export_c {
  if !htr_http_path(url) {return -1;}
  utf:=1;while utf<url.count {bytes:=json_utf8(url,utf);if bytes==0 {return -1;}utf+=bytes;}
  end:=url.count;while url[end-1]==' ' {end-=1;}
  for i:1..<end {if url[i]=='#' {end=i;break;}}
  path_end:=end;for i:1..<end {if url[i]=='?' {path_end=i;break;}}
  starts:[4096]int;ends:[4096]int;count:=0;at:=1;
  while at<=path_end {
    finish:=at;while finish<path_end && url[finish]!='/' {finish+=1;}
    dots:=htr_http_dot(url[at..<finish]);
    if dots==2 && count>0 {count-=1;}
    if dots==0 || finish==path_end {starts[count]=ifx dots==0 then at else finish;ends[count]=finish;count+=1;}
    at=finish+1;
  }
  result:[12288]u8;result[0]='/';n:=1;
  for i:0..<count {
    if i>0 {result[n]='/';n+=1;}
    for k:starts[i]..<ends[i] {n=htr_http_encode(result[..],n,url[k],false);}
  }
  if path_end<end {
    result[n]='?';n+=1;
    for i:path_end+1..<end {n=htr_http_encode(result[..],n,url[i],true);}
  }
  if n>out.count {return -1;}
  for i:0..<n {out[i]=result[i];}return n;
}
