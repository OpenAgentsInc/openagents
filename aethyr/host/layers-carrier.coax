// Browser reactor for the same canonical compressed-image authority as native.
#load "../render/host-layers.coax";
#load "../render/texture-format.coax";   // which format and size tier a device's layers take (GitHub #13014)
#load "../render/block-layer.coax";      // a block build's layers, read before their levels go up (GitHub #13305)
HostLayerSource :: struct {bytes:[HOST_LAYER_SOURCE_BYTES]u8;}
hl_source_storage :: (bank:[]HostLayerSource)->[]u8 #export_c #effects(all) {return bank[0].bytes[..];}
