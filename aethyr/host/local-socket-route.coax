// Resolve the one native-local pipe only against an explicitly bound
// loopback room origin. The native Coax room still owns seat admission.
#load "routes.coax";
#authority;
#test "native local target retains the exact room path and explicit origin" {
  out:[128]u8;n:=htr_local_target("local:/api/room/relay/everglade/local-1","ws://127.0.0.1:9170",out[..]);
  #assert n==52 && cast(string)out[0..<n]=="ws://127.0.0.1:9170/api/room/relay/everglade/local-1";
  for origin:[6]string.["","ws://localhost:9170","ws://127.0.0.1:0","ws://127.0.0.1:9170/x","ws://127.0.0.1:09170","wss://127.0.0.1:9170"] {#assert htr_local_target("local:/api/room/relay/everglade/local-1",origin,out[..])== -1;}
  for uri:[4]string.["","local:/api/room/relay/everglade/local-2","local:/api/room/relay/other/local-1","ws://127.0.0.1:9170/echo"] {#assert htr_local_target(uri,"ws://127.0.0.1:9170",out[..])== -1;}
  for i:0..<128 {out[i]=37;}#assert htr_local_target("local:/api/room/relay/everglade/local-1","ws://127.0.0.1:9170",out[0..<51])== -1 && out[0]==37;
  #assert htr_local_target("local:/api/room/relay/everglade/local-1","ws://127.0.0.1:9170",out[0..<52])==52 && out[52]==37;
  #assert htr_local_target("local:/api/room/relay/everglade/local-1?re=1","ws://127.0.0.1:9170",out[0..<56])== -1&&out[52]==37;
  #assert htr_local_target("local:/api/room/relay/everglade/local-1?re=1","ws://127.0.0.1:9170",out[0..<57])==57&&cast(string)out[0..<57]=="ws://127.0.0.1:9170/api/room/relay/everglade/local-1?re=1"&&out[57]==37;
}
htr_local_target :: (uri:string,origin:string,out:[]u8)->int #export_c {
  if !htr_local_uri(uri) || !htr_local_origin(origin) {return -1;}
  path:=uri[6..<uri.count];n:=origin.count+path.count;if n>out.count {return -1;}
  for b,i:origin {out[i]=b;}for b,i:path {out[origin.count+i]=b;}return n;
}
