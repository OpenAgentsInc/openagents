// Physical media storage is measured by the face before any host forms a view.
#load "buffers.coax";
#authority;
#test "empty media needs no storage but a nonempty packet needs its complete measured allocation" {
 #assert hmp_span(0,0,0,0,false)&&hmp_span(0,4,0,0,true);
 #assert hmp_span(4096,4,4,4100,true)&&hmp_span(4096,4,1,4100,true);
 #assert !hmp_span(4096,4,4,4100,false)&&!hmp_span(4096,4,5,4101,true);
 #assert !hmp_span(4096,4,1,4099,true)&&!hmp_span(0,4,4,4100,true);
 #assert !hmp_span(4294967280,1024,4,4294967296,true);
 #assert !hmp_span(18446744073709551600,1024,4,18446744073709551615,true);
}
hmp_span :: (address:u64,capacity:u64,bytes:u64,address_limit:u64,capacity_present:bool)->bool #export_c #effects(all) {
 return bytes==0 || (capacity_present&&htb_copy_span(address,capacity,bytes,address_limit));
}
