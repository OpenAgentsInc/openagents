// Bounded stream/storage admission around the existing whole VPK1 reader.
// Page leases reuse hiq ownership: one unit is an actual 64KiB allocation page.
#load "inbox-queue.coax";
#load "../forge/pack.coax";
#load "../render/frame.coax";
#authority;
HOST_PACK_BYTES :: 67108864;
HOST_PACK_PAGE :: 65536;
HostPackStream :: struct {valid:bool;failed:bool;done:bool;encoded:bool;headed:bool;expected:int;loaded:int;head:[12]u8;head_bytes:int;}
HostPackChunk :: struct {accepted:bool;at:int;bytes:int;total:int;}
HostPackAllocation :: struct {valid:bool;address:int;pages:int;memory_bytes:int;}
HostPackStorageOffer :: struct {count:int;bytes:int;capacity:int;per_allocation:int;}

#test "pack storage counts actual pages before retained allocations and never truncates" {
 q:=[1]HostInboxQueue.[hpk_storage_open()];leases:[4]HostInboxLease;
 for i:0..<4{g:=hpk_storage_reserve(q[..],67108864);#assert g.status==HostInboxStatus.ok&&g.lease.slot==i;leases[i]=g.lease;}
 held:=hpk_storage_offer(q[..]);#assert held.count==4&&held.bytes==268435456&&held.capacity==268435456&&held.per_allocation==67108864;
 #assert q[0].bytes==4096&&q[0].count==4&&hpk_storage_reserve(q[..],1).status==HostInboxStatus.full;
 for lease:leases{#assert hiq_release(q[..],lease);}#assert q[0].bytes==0&&q[0].count==0;
 for bytes:[3]int.[-1,67108865,9223372036854775807]{#assert hpk_storage_reserve(q[..],bytes).status==HostInboxStatus.invalid&&q[0].count==0;}
 for bytes,i:[5]int.[0,1,65535,65536,65537]{g:=hpk_storage_reserve(q[..],bytes);#assert g.status==HostInboxStatus.ok&&q[0].entries[g.lease.slot].bytes==[5]int.[0,1,1,1,2][i];#assert hiq_release(q[..],g.lease);}
}
#test "pack streams assemble a split12byte header and admit only its exact complete size" {
 p:[512]u8;wire:=pack_test(512,p[..]);s:=[1]HostPackStream.[hpk_stream_open(0,false)];
 a:=hpk_stream_offer(s[..],wire[0..<3],3);#assert a.accepted&&a.at==0&&a.total==0&&s[0].head_bytes==3;
 a=hpk_stream_offer(s[..],wire[3..<11],8);#assert a.accepted&&a.at==3&&a.total==0&&s[0].head_bytes==11;
 a=hpk_stream_offer(s[..],wire[11..<12],1);#assert a.accepted&&a.at==11&&a.total==512&&s[0].loaded==12&&s[0].headed;
 a=hpk_stream_offer(s[..],"",500);#assert a.accepted&&a.at==12&&a.bytes==500&&a.total==512&&hpk_stream_finish(s[..]);
 #assert s[0].done&&!hpk_stream_offer(s[..],"",0).accepted&&hpk_stream_finish(s[..]);
}
#test "cut oversized malformed and inconsistent streams poison before any successful prefix" {
 p:[512]u8;wire:=pack_test(512,p[..]);
 for size:[5]int.[-1,1,31,67108865,9223372036854775807]{#assert !hpk_stream_open(size,false).valid;}
 #assert hpk_stream_open(32,false).valid&&hpk_stream_open(67108864,false).valid&&!hpk_stream_open(0,true).valid&&hpk_stream_open(1,true).valid;
 s:=[1]HostPackStream.[hpk_stream_open(0,false)];#assert !hpk_stream_finish(s[..])&&s[0].failed&&!hpk_stream_offer(s[..],wire[0..<12],12).accepted;
 s[0]=hpk_stream_open(0,false);#assert hpk_stream_offer(s[..],wire[0..<12],12).accepted&&!hpk_stream_finish(s[..])&&s[0].failed;
 s[0]=hpk_stream_open(0,false);#assert !hpk_stream_offer(s[..],wire[0..<11],12).accepted&&s[0].loaded==0&&s[0].failed;
 for n:[3]int.[-1,67108865,9223372036854775807]{s[0]=hpk_stream_open(0,false);#assert !hpk_stream_offer(s[..],"",n).accepted&&s[0].loaded==0&&s[0].failed;}
 s[0]=hpk_stream_open(0,false);#assert hpk_stream_offer(s[..],wire[0..<12],512).accepted&&!hpk_stream_offer(s[..],"",1).accepted&&s[0].loaded==512&&s[0].failed&&!hpk_stream_finish(s[..]);
 s[0]=hpk_stream_open(513,false);#assert !hpk_stream_offer(s[..],wire[0..<12],12).accepted&&s[0].loaded==0;
 for at:0..<4{bad:=p;bad[at]=0;s[0]=hpk_stream_open(0,false);#assert !hpk_stream_offer(s[..],cast(string)bad[0..<12],12).accepted&&s[0].failed;}
 for length:[3]int.[31,67108865,4294967295]{bad:=p;pack_put32(bad[..],8,length);s[0]=hpk_stream_open(0,false);#assert !hpk_stream_offer(s[..],cast(string)bad[0..<12],12).accepted&&s[0].failed;}
 for length:[2]int.[32,67108864]{bad:=p;pack_put32(bad[..],8,length);s[0]=hpk_stream_open(length,false);#assert hpk_stream_offer(s[..],cast(string)bad[0..<12],12).accepted&&s[0].headed&&s[0].expected==length;}
 s[0]=hpk_stream_open(1,true);#assert hpk_stream_offer(s[..],"",1).accepted&&hpk_stream_finish(s[..]);
 s[0]=HostPackStream.{expected=1,loaded=1};#assert !hpk_stream_offer(s[..],"",0).accepted&&!hpk_stream_finish(s[..]);
}
#test "private encoded streams require their exact bounded observed size" {
 s:=[1]HostPackStream.[hpk_stream_open(65536,true)];#assert hpk_stream_offer(s[..],"",65535).accepted&&hpk_stream_offer(s[..],"",1).accepted&&hpk_stream_finish(s[..]);
 s[0]=hpk_stream_open(1,true);#assert !hpk_stream_offer(s[..],"",2).accepted&&s[0].failed&&s[0].loaded==0;
 s[0]=hpk_stream_open(0,false);#assert hpk_stream_offer(s[..],"",0).accepted&&s[0].loaded==0&&s[0].head_bytes==0;
}
#test "manual pack arena admits the full measured module allocation and actual pages" {
 for base,i:[5]int.[0,1,15,16,65536]{r:=hpk_allocation(base,1);#assert r.valid&&r.address==[5]int.[0,16,16,16,65536][i]&&r.pages==[5]int.[1,1,1,1,2][i]&&r.memory_bytes==r.pages*65536;}
 r:=hpk_allocation(65532,4);#assert r.valid&&r.address==65536&&r.pages==2;
 r=hpk_allocation(67108848,16);#assert r.valid&&r.pages==1024;
 r=hpk_allocation(0,67108864);#assert r.valid&&r.pages==1024;
 for row:[7][2]int.[[2]int.[-1,1],[2]int.[0,-1],[2]int.[67108849,16],[2]int.[67108864,1],[2]int.[9223372036854775807,1],[2]int.[1,67108864],[2]int.[0,67108865]]{#assert !hpk_allocation(row[0],row[1]).valid;}
 r=hpk_allocation(67108864,0);#assert r.valid&&r.address==67108864&&r.pages==1024;
}
hpk_storage_open :: ()->HostInboxQueue #export_c #effects(all) {return hiq_open(1024);}
hpk_storage_reserve :: (q:[]HostInboxQueue,bytes:int)->HostInboxGrant #export_c #effects(all) {if bytes<0{return HostInboxGrant.{};}pages:=bytes/HOST_PACK_PAGE;if bytes%HOST_PACK_PAGE!=0{pages+=1;}return hiq_reserve(q,pages);}
hpk_storage_offer :: (q:[]HostInboxQueue)->HostPackStorageOffer #export_c #effects(all) {return HostPackStorageOffer.{count=q[0].count,bytes=q[0].bytes*HOST_PACK_PAGE,capacity=q[0].limit*HOST_PACK_PAGE,per_allocation=q[0].capacity*HOST_PACK_PAGE};}
hpk_stream_open :: (expected:int,encoded:bool)->HostPackStream #export_c #effects(all) {
 if expected<0||expected>HOST_PACK_BYTES{return HostPackStream.{};}
 if encoded {if expected==0{return HostPackStream.{};}}else if expected!=0&&expected<PACK_HEADER{return HostPackStream.{};}
 return HostPackStream.{valid=true,encoded=encoded,expected=expected};
}
hpk_stream_offer :: (s:[]HostPackStream,prefix:string,bytes:int)->HostPackChunk #export_c #effects(all) {
 r:=HostPackChunk.{};if !s[0].valid||s[0].failed||s[0].done{return r;}
 if bytes<0{s[0].failed=true;return r;}
 next:=s[0];
 if !next.encoded&&!next.headed{
  for i:0..<bytes{if next.head_bytes==12{break;}if i>=prefix.count{s[0].failed=true;return r;}next.head[next.head_bytes]=prefix[i];next.head_bytes+=1;}
  if next.head_bytes==12{
   head:=cast(string)next.head[..];stated:=pack_u32(head,8);
   if !pack_magic_ok(head[0..<4])||stated<PACK_HEADER||stated>HOST_PACK_BYTES||(next.expected!=0&&next.expected!=stated){s[0].failed=true;return r;}next.expected=stated;next.headed=true;
  }
 }
 if next.expected>0&&bytes>next.expected-next.loaded{s[0].failed=true;return r;}
 r=HostPackChunk.{accepted=true,at=next.loaded,bytes=bytes,total=next.expected};next.loaded+=bytes;s[0]=next;return r;
}
hpk_stream_finish :: (s:[]HostPackStream)->bool #export_c #effects(all) {if !s[0].valid||s[0].failed{return false;}if s[0].expected==0||s[0].loaded!=s[0].expected{s[0].failed=true;return false;}s[0].done=true;return true;}
hpk_allocation :: (base:int,bytes:int)->HostPackAllocation #export_c #effects(all) {
 if base<0||bytes<0{return HostPackAllocation.{};}
 address:=u64(base)+u64((16-base%16)%16);if !render_span_fits(address,u64(bytes),0,u64(HOST_PACK_BYTES)){return HostPackAllocation.{};}
 end:=int(address)+bytes;pages:=(end+HOST_PACK_PAGE-1)/HOST_PACK_PAGE;
 return HostPackAllocation.{valid=true,address=int(address),pages=pages,memory_bytes=pages*HOST_PACK_PAGE};
}

#test "VPK2 source packs use the same bounded complete stream admission" {
 p:[512]u8;wire:=pack_test(512,p[..]);p[3]='2';s:=[1]HostPackStream.[hpk_stream_open(512,false)];#assert hpk_stream_offer(s[..],cast(string)p[0..<12],12).accepted && s[0].headed;
 p[3]='3';s[0]=hpk_stream_open(512,false);#assert !hpk_stream_offer(s[..],cast(string)p[0..<12],12).accepted && s[0].failed;
}
