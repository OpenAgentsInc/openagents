// Range-addressable VPK3 packs in the browser's pack reactor (GitHub #13001,
// aethyr/forge/page-pack.coax). The browser fetches byte ranges and inflates them; it writes each
// page's decoded bytes at its place in the reactor's image arena, and only this module decides a
// page is held: its size and SHA-256 must be its manifest record's. The roots held, the image goes
// to the same complete-stream admission and VPK1 reader as a whole pack (pack-stream.coax).
#load "private-pack.coax";
#load "../forge/page-pack.coax";
#authority;
HOST_PAGED_HEAD :: PPK_HEADER + PPK_PAGES * PPK_RECORD;

#test "a paged pack opens from its head, admits pages in the arena and becomes a finished stream" #steps 600000000 {
  b: [512] u8; image := pack_test(600, b[..]);
  starts: [16] int; roots: [16] bool; entries: [16] int; n := ppk_plan(image, 128, 1 << PACK_SOUND, starts[..], roots[..], entries[..]);
  w: [1] DeflateWork; file: [4096] u8; scratch: [2048] u8;
  size := ppk_write(image, starts[0..<n], roots[0..<n], entries[0..<n], file[..], scratch[..], w[..]);
  l: [1] PpkLoad;
  #assert !hpg_open(l[..], cast(string) file[0..<PPK_HEADER]);
  #assert hpg_open(l[..], cast(string) file[0..<size]) && hpg_page(l[0], -1, 0) == n && hpg_page(l[0], -1, 1) == 512 && hpg_page(l[0], -1, 2) == size;
  #assert hpg_page(l[0], n, 0) == -1 && hpg_page(l[0], 0, 9) == -1 && hpg_page(l[0], 0, 5) == 1 && hpg_page(l[0], n - 1, 5) == 0;
  arena: [512] u8;
  #assert !hpg_stream(l[0], cast(string) arena[..]).done;
  for k: 0..<n - 1 {
    at := hpg_page(l[0], k, 2); d := hpg_page(l[0], k, 3);
    #assert !hpg_admit(l[..], k, cast(string) arena[0..<511]);
    for j: 0..<d { arena[at + j] = image[at + j]; }
    #assert hpg_admit(l[..], k, cast(string) arena[..]);
  }
  #assert l[0].roots_held == l[0].m.roots && !ppk_complete(l[0]);
  s := hpg_stream(l[0], cast(string) arena[..]); #assert s.valid && s.done && s.loaded == 512 && s.expected == 512;
  #assert !hpg_stream(l[0], cast(string) arena[0..<500]).done;
  sound := hpg_page(l[0], n - 1, 2);
  #assert hpg_ready(l[0], 0, sound) && !hpg_ready(l[0], sound, 3);
  out: [1] PackRead; plan := HostPrivatePack.{};
  #assert hpk_stream_pack(cast(string) arena[..], s, plan, false, out[..]) && out[0].count == 5;
  bad := arena; bad[0] = 0; #assert !hpg_stream(l[0], cast(string) bad[..]).done;
}

hpg_open :: (l: [] PpkLoad, head: string) -> bool #export_c #effects(all) {
  m: [1] PpkManifest;
  if !ppk_manifest(head, m[..]) || m[0].image_bytes > HOST_PACK_BYTES || m[0].image_bytes < PACK_HEADER { l[0] = PpkLoad.{}; return false; }
  return ppk_open(l, m[0]);
}
// Field f of page k: 0 stored offset, 1 stored bytes, 2 image offset, 3 decoded bytes, 4 codec,
// 5 root. Page -1 is the pack: 0 pages, 1 image bytes, 2 file bytes, 3 roots. Else -1.
hpg_page :: (l: PpkLoad, k: int, f: int) -> int #export_c #effects(all) {
  if !l.m.ok || k < -1 || k >= l.m.pages { return -1; }
  if k == -1 { return ifx f == 0 then l.m.pages else ifx f == 1 then l.m.image_bytes else ifx f == 2 then l.m.file_bytes else ifx f == 3 then l.m.roots else -1; }
  g := l.m.page[k];
  return ifx f == 0 then g.stored_at else ifx f == 1 then g.stored else ifx f == 2 then g.image_at else ifx f == 3 then g.decoded else ifx f == 4 then g.codec else ifx f == 5 then (ifx g.root then 1 else 0) else -1;
}
// Page k's bytes are in place in image (the whole arena): held when they are its record's.
hpg_admit :: (l: [] PpkLoad, k: int, image: string) -> bool #export_c #effects(all) {
  if !l[0].m.ok || image.count != l[0].m.image_bytes || k < 0 || k >= l[0].m.pages { l[0].refused += 1; return false; }
  g := l[0].m.page[k];
  return ppk_admit(l, k, image[g.image_at..<g.image_at + g.decoded]);
}
hpg_ready :: (l: PpkLoad, at: int, n: int) -> bool #export_c #effects(all) { return ppk_ready(l, at, n); }
// The image as a finished complete stream, for hpk_stream_pack, once every root is held.
hpg_stream :: (l: PpkLoad, image: string) -> HostPackStream #export_c #effects(all) {
  if !ppk_roots_ready(l) || image.count != l.m.image_bytes { return HostPackStream.{}; }
  s := [1] HostPackStream.[hpk_stream_open(image.count, false)];
  if !hpk_stream_offer(s[..], image[0..<12], image.count).accepted || !hpk_stream_finish(s[..]) { return HostPackStream.{}; }
  return s[0];
}
