// A genuine admitted historical compiler root plus separately pinned product
// inputs. Verify the original receipt before and after replacing only the
// product directories. This neither publishes nor writes compiler provenance.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
hhr_run :: (argv:[]string,dir:string,label:string)->bool {
  out:[65536]u8;err:[65536]u8;r:=proc_run(argv,180000,out[..],err[..]);path:[4096]u8;name:[256]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],label);jo_put(o[..],".stdout");ok:=fs_write(fs_join(dir,jo_text(o[..]),path[..]),cast(string)out[0..<r.out_n]);jo_start(o[..],name[..]);jo_put(o[..],label);jo_put(o[..],".stderr");ok=fs_write(fs_join(dir,jo_text(o[..]),path[..]),cast(string)err[0..<r.err_n])&&ok;
  if !ok || r.started!=0 || r.status!=0 || r.timed_out || r.cut {tool_errln(label);tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;
}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {tool_errln("usage: prepare-historical-root CLEAN_HISTORICAL_ROOT PRODUCT_COMMIT ORIGINAL_CACHE_DIR NEW_RECORD_DIR CURRENT_REPO");return 2;}
  root:=args_at(a[..],0);commit:=args_at(a[..],1);cache:=args_at(a[..],2);record:=args_at(a[..],3);repo:=args_at(a[..],4);if !fs_mkdir(record) {return 1;}files:[1]FsList;if fs_list(record,files[..])!=0 {tool_errln("record directory must be empty");return 2;}
  paths:[10][4096]u8;script:=fs_join(root,"coax/provenance.sh",paths[0][..]);compiler:=fs_join(cache,"coax",paths[1][..]);helper:=fs_join(cache,"provenance-check",paths[2][..]);receipt:=fs_join(cache,"provenance.record",paths[3][..]);archive:=fs_join(record,"product-inputs.tar",paths[4][..]);snapshot:=fs_join(record,"product-inputs",paths[5][..]);
  clean:=[6]string.["git","-C",root,"status","--porcelain","--untracked-files=normal"];out:[65536]u8;err:[65536]u8;r:=proc_run(clean[..],30000,out[..],err[..]);if r.status!=0 || r.out_n!=0 || r.cut || r.timed_out {tool_errln("historical worktree must be clean");return 2;}
  verify:=[6]string.[script,"verify",root,compiler,helper,receipt];if !hhr_run(verify[..],record,"original-receipt-before") {return 1;}
  source:=[3]string.[compiler,"source-digest",root];if !hhr_run(source[..],record,"compiler-sources-before") {return 1;}
  historical:=[4]string.["git","-C",root,"rev-parse"];history:=[5]string.[historical[0],historical[1],historical[2],historical[3],"HEAD"];if !hhr_run(history[..],record,"historical-commit") {return 1;}
  product:=[6]string.["git","-C",repo,"rev-parse","--verify",commit];if !hhr_run(product[..],record,"product-commit") {return 1;}
  pack:=[15]string.["git","-C",repo,"archive","--format=tar","--output",archive,commit,"aethyr","verse","apps","coax/web","coax/platform","coax/lib","psionic"];
  if !hhr_run(pack[..],record,"product-archive") || !fs_mkdir(snapshot) {return 1;}unpack:=[5]string.["tar","-xf",archive,"-C",snapshot];if !hhr_run(unpack[..],record,"product-extract") {return 1;}
  for part:[6]string.["aethyr/","verse/","apps/","coax/web/","coax/platform/","psionic/"] {
    from:=fs_join(snapshot,part,paths[6][..]);to:=fs_join(root,part,paths[7][..]);copy:=[5]string.["rsync","-a","--delete",from,to];label:[256]u8;o:[1]Jo;jo_start(o[..],label[..]);jo_put(o[..],"copy-");for c:part {if c!='/' {byte:=[1]u8.[c];jo_put(o[..],cast(string)byte[..]);}}if !hhr_run(copy[..],record,jo_text(o[..])) {return 1;}
  }
  from:=fs_join(snapshot,"coax/lib/",paths[6][..]);to:=fs_join(root,"coax/lib/",paths[7][..]);libraries:=[8]string.["rsync","-a","--delete","--exclude=compiler/","--exclude=proto/","--exclude=crypto/sha256-kernel.coax",from,to];if !hhr_run(libraries[..],record,"copy-product-libraries") || !hhr_run(verify[..],record,"original-receipt-after") || !hhr_run(source[..],record,"compiler-sources-after") {return 1;}
  print("Original admitted compiler receipt verifies before/after; product commit pinned separately. Record: %\n",record);return 0;
}
