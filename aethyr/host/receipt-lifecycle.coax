#load "receipt.coax";
#load "lifecycle-conformance.coax";
#authority;
#test "lifecycle envelope admits three hosts and refuses missing or malformed shape metadata" {
  text:[8192]u8;o:[1]Jo;nodes:[1024]JvNode;d:[1]Jv;
  for host:[3]string.["web","vulkan","metal"] {for bad:0..<16 {
    jo_start(o[..],text[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],ifx bad==1 then "bad" else "aethyr.host.observations.v1");jo_key(o[..],"scope");jo_str(o[..],ifx bad==2 then "core" else "lifecycle");jo_key(o[..],"host");jo_str(o[..],ifx bad==3 then "other" else host);
    if bad!=4 {jo_key(o[..],"version");jo_int(o[..],1);}if bad!=5 {jo_key(o[..],"constructed");jo_int(o[..],73);}if bad!=6 {jo_key(o[..],"dropped");jo_int(o[..],0);}if bad!=7 {jo_key(o[..],"held");jo_int(o[..],0);}
    jo_key(o[..],"lifecycle");jo_raw(o[..],ifx bad==8 then "null" else ifx bad==9 then "[1,1,1,1]" else ifx bad==10 then "[1,1,1,1,4015625,0]" else ifx bad==11 then "[1,1,1,1,4015625.5]" else ifx bad==12 then "[1,1,1,1,\"4015625\"]" else ifx bad==14 then "[1.5,1,1,1,4015625]" else ifx bad==15 then "[\"1\",1,1,1,4015625]" else "[1,1,1,1,4015625]");
    jo_key(o[..],"events");jo_raw(o[..],ifx bad==13 then "[]" else "[[1,1134559232,1127481344,1065353216,0,0,0,0],[1,1134559232,1127481344,1065353216,1015021568,0,0,0],[2,119,0,1,0,0,0,0],[5,1,0,0,0,0,0,0],[5,0,0,0,0,0,0,0],[1,1134559232,1127481344,1065353216,0,0,0,0],[5,0,0,0,0,0,0,0],[1,1134559232,1127481344,1065353216,0,0,0,0],[1,1134559232,1127481344,1065353216,0,0,0,0],[1,1134559232,1127481344,1065353216,1015021568,0,0,0]]");jo_end(o[..]);#assert !o[0].bad&&jv_parse(d[..],jo_text(o[..]),nodes[..]);#assert hcr_lifecycle(d[0])==(bad==0);
  }}#assert jv_parse(d[..],"[]",nodes[..])&&!hcr_lifecycle(d[0]);
}
hcr_lifecycle :: (d:Jv)->bool {
  if jv_kind(d,0)!=JV_OBJECT||jv_raw(d,jv_get(d,0,"schema"))!="aethyr.host.observations.v1"||jv_raw(d,jv_get(d,0,"scope"))!="lifecycle" {return false;}
  host:=jv_raw(d,jv_get(d,0,"host"));if host!="web"&&host!="vulkan"&&host!="metal" {return false;}
  at:=jv_get(d,0,"lifecycle");if jv_kind(d,at)!=JV_ARRAY||jv_len(d,at)!=5 {return false;}life:[5]int;for i:0..<5 {life[i]=jv_int(d,jv_at(d,at,i),0);}
  events:[10][8]int;n:=hcr_rows(d,jv_get(d,0,"events"),events[..]);if n!=10 {return false;}
  return hcl_lifecycle(jv_int(d,jv_get(d,0,"version"),0),jv_int(d,jv_get(d,0,"constructed"),72),jv_int(d,jv_get(d,0,"dropped"),-1),jv_int(d,jv_get(d,0,"held"),-1),life[..],events[..]);
}
