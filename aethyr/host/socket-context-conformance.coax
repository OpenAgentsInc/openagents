// Actual target-jar selection and explicit world Origin on the physical wire.
#load "transport-conformance.coax";
#authority;
HostOpeningObservation :: struct {path:string;origin:string;cookie:string;accepted:int;}
#load "tests/socket-context-observations.coax" #test;
hsc_cases :: ()->[6]HostOpeningObservation #effects(all) {
 origin:="http://127.0.0.1:9172";
 return [6]HostOpeningObservation.[
  HostOpeningObservation.{path="/auth/before",origin=origin,accepted=0},
  HostOpeningObservation.{path="/seed",accepted=2},
  HostOpeningObservation.{path="/auth/after",origin=origin,cookie="auth=one",accepted=1},
  HostOpeningObservation.{path="/other",origin=origin,cookie="other=two",accepted=1},
  HostOpeningObservation.{path="/host",origin=origin,accepted=1},
  HostOpeningObservation.{path="/auth/after",origin="http://other.invalid",cookie="auth=one",accepted=0}];
}
hsc_rows :: ()->[26][8]int #effects(all) {
 rows:[26][8]int;at:=0;
 for text,i:[6]string.["ws://127.0.0.1:9172/auth/before","/seed","ws://127.0.0.1:9172/auth/after","ws://127.0.0.1:9172/other","ws://localhost:9172/host","ws://127.0.0.1:9172/auth/after"] {
  rows[at]=htc_row(ifx i==1 then 920 else 910,text);at+=1;rows[at]=htc_result(ifx i==1 then 4 else 1,0);at+=1;
  if i==1 {rows[at]=htc_row(512,"200\nseed");at+=1;}
  else if i==0||i==5 {rows[at]=htc_row(259,"");at+=1;rows[at]=htc_row(258,"");at+=1;}
  else {rows[at]=htc_row(256,"");at+=1;rows[at]=htc_row(257,"authenticated");at+=1;rows[at]=htc_row(258,"");at+=1;}
 }return rows;
}
#test "opening receipt checks every observed target origin cookie status and callback word" {
 peer:=hsc_fixture_peer();rows:=hsc_fixture_rows();#assert hsc_peer(peer[..])&&hsc_client(rows[..],0);
 #assert !hsc_peer(peer[0..<5])&&!hsc_client(rows[0..<25],0)&&!hsc_client(rows[..],1);
 for i:0..<6 {p:=peer;p[i].path="bad";#assert !hsc_peer(p[..]);p=peer;p[i].origin="bad";#assert !hsc_peer(p[..]);p=peer;p[i].cookie="bad";#assert !hsc_peer(p[..]);p=peer;p[i].accepted+=1;#assert !hsc_peer(p[..]);}
 for i:0..<26 {for field:0..<8 {r:=rows;r[i][field]+=1;#assert !hsc_client(r[..],0);}}
}
hsc_peer :: (rows:[]HostOpeningObservation)->bool #export_c #effects(all) {
 want:=hsc_cases();if rows.count!=want.count{return false;}
 for row,i:want {actual:=rows[i];if actual.path!=row.path||actual.origin!=row.origin||actual.cookie!=row.cookie||actual.accepted!=row.accepted{return false;}}
 return true;
}
hsc_client :: (rows:[][8]int,dropped:int)->bool #export_c #effects(all) {
 want:=hsc_rows();if dropped!=0||rows.count!=want.count{return false;}
 for row,i:want {if !htc_equal(row,rows[i]) {return false;}}return true;
}
