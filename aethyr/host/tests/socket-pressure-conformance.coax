// Effects receipt admission, independent of the native storage interpreter.
#load "socket-pressure-payload.coax";
#authority;
#test "stalled delivery keeps exactly the admitted events and bytes across another main-thread stall" {
 a:=[10]int.[6,512,0,0,6,512,1,6,0,0];b:=a;#assert hspc_hold(a[..],b[..]);b[6]=2;#assert hspc_hold(a[..],b[..]);b=a;
 for i:0..<10 {if i!=6 {a[i]+=1;#assert !hspc_hold(a[..],b[..]);a[i]-=1;b[i]+=1;#assert !hspc_hold(a[..],b[..]);b[i]-=1;}}
 a[6]=0;#assert !hspc_hold(a[..],b[..]);a[6]=2;#assert !hspc_hold(a[..],b[..]);a[6]=1;#assert !hspc_hold(a[0..<9],b[..])&&!hspc_hold(a[..],b[0..<9]);
}
#test "sixty four empty physical commands fit and the next explicitly refuses" {
 accepted:[65]int;for i:0..<64 {accepted[i]=1;}max:=[2]int.[64,0];#assert hspc_commands(accepted[..],max[..]);
 for i:0..<65 {accepted[i]=1-accepted[i];#assert !hspc_commands(accepted[..],max[..]);accepted[i]=1-accepted[i];}
 for i:0..<2 {max[i]+=1;#assert !hspc_commands(accepted[..],max[..]);max[i]-=1;}#assert !hspc_commands(accepted[0..<64],max[..])&&!hspc_commands(accepted[..],max[0..<1]);
}
#test "every delivered payload byte and sequence number stays exact" {
 out:[128]u8;ok:=hsp_payload(123,out[..]);#assert ok&&hspc_payload(123,out[..]);
 for i:0..<128 {out[i]+=1;#assert !hspc_payload(123,out[..]);out[i]-=1;}
 #assert !hspc_payload(124,out[..])&&!hspc_payload(-1,out[..])&&!hspc_payload(1000000,out[..])&&!hspc_payload(123,out[0..<127]);
}
#test "replacement observes all four concrete opens without requiring cross-socket callback order" {
 good:=[4]int.[2,0,3,1];#assert hspc_opens(good[..]);for i:0..<4 {keep:=good[i];good[i]= -1;#assert !hspc_opens(good[..]);good[i]=4;#assert !hspc_opens(good[..]);good[i]=keep;}
 bad:=[4]int.[2,0,3,2];#assert !hspc_opens(bad[..])&&!hspc_opens(good[0..<3]);
}
#test "concrete replacement resources remain bounded and all owners retire on process teardown" {
 max:=[5]int.[9,8,4,512,4];closed:[5]int;#assert hspc_pool(max[..],closed[..]);
 for i:0..<5 {max[i]+=1;#assert !hspc_pool(max[..],closed[..]);max[i]-=1;closed[i]=1;#assert !hspc_pool(max[..],closed[..]);closed[i]=0;}
 for i:0..<5 {keep:=max[i];max[i]= -1;#assert !hspc_pool(max[..],closed[..]);max[i]=keep;}
 max[0]=0;#assert !hspc_pool(max[..],closed[..]);max[0]=9;max[1]=0;#assert !hspc_pool(max[..],closed[..]);max[1]=8;
 max[2]=0;max[3]=0;#assert hspc_pool(max[..],closed[..]);#assert !hspc_pool(max[0..<4],closed[..])&&!hspc_pool(max[..],closed[0..<4]);
 max[0]=1;max[1]=1;#assert hspc_pool(max[..],closed[..]);
}
#test "physical peer reports a real bounded flush timeout after complete messages" {
 #assert hspc_peer(4,-2,100)&&hspc_peer(99999,-2,1000);
 #assert !hspc_peer(3,-2,100)&&!hspc_peer(100000,-2,100)&&!hspc_peer(4,-1,100)&&!hspc_peer(4,-2,99);
}
hspc_hold :: (a:[]int,b:[]int)->bool #export_c {
 if a.count!=10||b.count!=10 {return false;}expected:=[9]int.[6,512,0,0,6,512,6,0,0];
 for value,i:expected {at:=ifx i<6 then i else i+1;if a[at]!=value||b[at]!=value {return false;}}return a[6]>0&&b[6]>=a[6];
}
hspc_commands :: (a:[]int,max:[]int)->bool #export_c {
 if a.count!=65||max.count!=2 {return false;}if max[0]!=64||max[1]!=0 {return false;}for i:0..<65 {if a[i]!=(ifx i<64 then 1 else 0) {return false;}}return true;
}
hspc_payload :: (index:int,bytes:[]u8)->bool #export_c {expected:[128]u8;if bytes.count!=128||!hsp_payload(index,expected[..]) {return false;}return cast(string)bytes==cast(string)expected[..];}
hspc_opens :: (ids:[]int)->bool #export_c {if ids.count!=4 {return false;}seen:[4]bool;for id:ids {if id<0||id>=4 {return false;}if seen[id] {return false;}seen[id]=true;}return true;}
hspc_pool :: (max:[]int,closed:[]int)->bool #export_c {
 if max.count!=5||closed.count!=5 {return false;}limits:=[4]int.[9,8,4,512];for value,i:limits {if closed[i]!=0||max[i]<0||max[i]>value {return false;}}
 return max[0]>0&&max[1]>0&&max[4]==4&&closed[4]==0;
}
hspc_peer :: (frames:int,failure:int,elapsed:int)->bool #export_c {return frames>=4&&frames<100000&&failure== -2&&elapsed>=100;}
