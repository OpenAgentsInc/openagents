sw_vk_upload_poll :: () -> s32 #foreign #effects(all);
sw_vk_transfer_info :: (field: s32) -> int #foreign #effects(all);
sw_vk_transfer_hold :: (ms: int, kind: s32) -> s32 #foreign #effects(all);
