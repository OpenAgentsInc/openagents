// Actual headless native consumer: local admitted sources, canonical codecs,
// the shared walker/owners/draw list, Vulkan effects and retained replacement.
// The local-file adapter is deliberately separate from HTTP transport.
#import "Basic";
#load "../../world/stream-walk-rescue.coax";
#load "../../render/submission-policy.coax";
