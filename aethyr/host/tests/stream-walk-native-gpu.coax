swn_state :: (s: [] SwWalk, out: [] u8) -> bool #export_c #effects(all) {
  return sw_rescue_digest(s, out);
}
swn_name :: (id: string, suffix: string, out: [] u8) -> string {
  #assert id.count == 64 && out.count >= 80;
  for c, i: id { out[i] = c; } for c, i: suffix { out[64 + i] = c; } return cast(string) out[0..<64 + suffix.count];
}
swn_source :: (scene: Jv, dir: string, row: int, out: [] u8) -> int {
  item := jv_at(scene, jv_get(scene, 0, "resources"), row); hex: [64] u8;
  if jv_int(scene, jv_get(scene, item, "row"), -1) != row || jv_str(scene, jv_get(scene, item, "container_sha256"), hex[..]) != 64 { return -1; }
  raw := jv_bool(scene, jv_get(scene, item, "raw")); name: [128] u8; path: [4096] u8; bytes: [65536] u8;
  n := fs_read(fs_join(dir, swn_name(cast(string) hex[..], ifx raw then ".raw" else ".vpk", name[..]), path[..]), bytes[..]);
  if n < 1 || !sw_auth(bytes[0..<n], cast(string) hex[..]) { return -1; }
  offset := jv_int(scene, jv_get(scene, item, "offset"), -1); count := jv_int(scene, jv_get(scene, item, "bytes"), -1);
  if offset < 0 || count < 1 || count > out.count || offset > n - count { return -1; }
  if !raw { pack: [1] packs.PackRead; if !packs.pack_read(cast(string) bytes[0..<n], pack[..]) { return -1; } }
  if jv_str(scene, jv_get(scene, item, "sha256"), hex[..]) != 64 || !sw_auth(bytes[offset..<offset + count], cast(string) hex[..]) { return -1; }
  for i: 0..<count { out[i] = bytes[offset + i]; } return count;
}
swn_surface :: () -> bool {
  for i: [6] int.[0, 1, 2, 6, 7, 8] {
    kind := ifx i == 0 || i == 7 then 1 else ifx i == 6 then 4 else 3;
    words := ifx i == 0 then 1024 else ifx i == 6 then 24576 else ifx i == 7 then 64 else ifx i == 8 then 115200 else 57600;
    if sw_host_fixed(cast(s32) i, cast(s32) kind, words) != 1 { return false; }
  }
  return sw_vk_make_surface() == 1;
}
SnLossEvent :: struct {
  result: int; real: int; injected: int; serial: int; began: int; reason: int; outcome: int; tick: int; cpu: int; reads: int;
  uploaded: int; granted: int; old_closed: bool; pending: bool; start: int; end: int;
  state_before: [64] u8; state_after: [64] u8; source_before: [64] u8; source_after: [64] u8;
}
SnNative :: struct {
  automatic: bool; event_n: int; events: [8] SnLossEvent; groups: int;
  state_ok: bool = true; source_ok: bool = true; tick_ok: bool = true; upload_ok: bool = true; pixels_ok: bool = true;
  probe_enabled: bool; probe_done: bool; upload_probe: [20] int; upload_guards: [8] int;
  upload_source_before: [64] u8; upload_source_after: [64] u8;
  sdk_case: int = -1; sdk_stopped: bool; sdk_stop: [24] int; sdk_before: [64] u8; sdk_after: [64] u8;
}
swn_sdk_stop :: (row: s32, gen: int, epoch: int, started: int, ctx: [] SnNative) -> bool {
  if ctx[0].sdk_case < 0 || nsf_domain(ctx[0].sdk_case) != 4 || ctx[0].sdk_stopped { return true; }
  ctx[0].sdk_stop = [24] int.[cast(int) row,gen,epoch,sw_host_info(0),0,sw_host_info(14),0,sw_vk_info(1),0,
    sw_vk_transfer_info(0),sw_vk_transfer_info(1),0,0,sw_loss_info(5),started,cxproc_now_ns(),0,sw_vk_transfer_info(2),0,
    cast(int) sw_host_fixed_live(5),0,cast(int) sw_host_trace_count(),0,0];
  if !swn_sources(ctx[0].sdk_before[..]) { return false; }ctx[0].sdk_stopped = true;return true;
}
swn_sdk_join :: (ctx: [] SnNative) -> bool {
  if !ctx[0].sdk_stopped { return true; }
  ctx[0].sdk_stop[4] = sw_host_info(0);ctx[0].sdk_stop[6] = sw_host_info(14);ctx[0].sdk_stop[8] = sw_vk_info(1);
  ctx[0].sdk_stop[11] = sw_vk_transfer_info(0);ctx[0].sdk_stop[12] = sw_vk_transfer_info(1);ctx[0].sdk_stop[16] = cxproc_now_ns();ctx[0].sdk_stop[18] = sw_vk_transfer_info(2);
  ctx[0].sdk_stop[20] = cast(int) sw_host_fixed_live(5);ctx[0].sdk_stop[22] = cast(int) sw_host_trace_count();
  if !swn_sources(ctx[0].sdk_after[..]) { return false; }ctx[0].sdk_stop[23] = ifx cast(string) ctx[0].sdk_before[..] == cast(string) ctx[0].sdk_after[..] then 1 else 0;
  return nsf_stop(ctx[0].sdk_case,ctx[0].sdk_stop[..]);
}
swn_upload_probe :: (row: s32, gen: int, epoch: int, ctx: [] SnNative) -> bool {
  ctx[0].upload_probe = [20] int.[50,sw_vk_transfer_info(8),sw_vk_transfer_info(9),sw_vk_transfer_info(3),sw_vk_transfer_info(4),sw_vk_transfer_info(5),
    sw_host_info(0),0,sw_host_info(14),0,sw_vk_info(1),0,cast(int) sw_host_trace_count(),0,sw_vk_transfer_info(0),sw_vk_transfer_info(1),0,0,0,0];
  if !swn_sources(ctx[0].upload_source_before[..]) { return false; }
  ctx[0].upload_guards = [8] int.[cast(int) sw_host_frame(15625000,1),cast(int) sw_host_finish(row,gen,epoch,0),cast(int) sw_host_finish_code(row,gen,epoch,0),
    cast(int) sw_host_destroy(row,gen,epoch),cast(int) sw_host_fixed_release(5),cast(int) sw_vk_drop(row,gen),cast(int) sw_host_recover(),cast(int) sw_vk_close()];
  if !swn_sources(ctx[0].upload_source_after[..]) { return false; }
  ctx[0].upload_probe[7] = sw_host_info(0);ctx[0].upload_probe[9] = sw_host_info(14);ctx[0].upload_probe[11] = sw_vk_info(1);ctx[0].upload_probe[13] = cast(int) sw_host_trace_count();
  ctx[0].upload_probe[16] = ifx cast(string) ctx[0].upload_source_before[..] == cast(string) ctx[0].upload_source_after[..] then 1 else 0;
  ctx[0].probe_done = nu_probe(ctx[0].upload_probe[..],ctx[0].upload_guards[..]);return ctx[0].probe_done;
}
swn_upload :: (row: s32, gen: int, epoch: int, replacement: s32, ctx: [] SnNative) -> bool {
  if sw_loss_info(1) == 1 { return false; }
  started := cxproc_now_ns(); outcome := sw_vk_upload(row,gen,epoch,replacement); drain := -1;
  if ctx[0].probe_enabled && !ctx[0].probe_done && outcome == 2 && sw_vk_transfer_info(7) > 0 && !swn_upload_probe(row,gen,epoch,ctx) { return false; }
  while outcome == 2 {
    now := cxproc_now_ns(); reason := nu_reason(sw_vk_transfer_info(2),true,ns_timed_out(started,now));
    if reason != GL_NONE && sw_loss_info(1) != 1 { ignored := sw_loss_abort(reason);if !swn_sdk_stop(row,gen,epoch,started,ctx) { return false; } }
    if sw_loss_info(1) == 1 { if drain < 0 { drain = now; } if ns_timed_out(drain,now) { return false; } }
    proc_sleep(1);outcome = sw_vk_upload_poll();
  }
  reason := nu_reason(sw_vk_transfer_info(2),false,ns_timed_out(started,cxproc_now_ns()));
  if reason != GL_NONE && sw_loss_info(1) != 1 { ignored := sw_loss_abort(reason);if !swn_sdk_stop(row,gen,epoch,started,ctx) { return false; } }
  if !swn_sdk_join(ctx) { return false; }
  return outcome == 1 && sw_loss_info(1) != 1;
}
swn_reupload :: (row: s32, ctx: [] SnNative) -> bool {
  bytes := sw_host_row(row,3);if sw_host_fixed(4,2,bytes / 4) != 1 { return false; }
  uploaded := swn_upload(row,sw_host_row(row,10),1,1,ctx);
  if sw_vk_transfer_info(1) != 0 { return false; }
  released := sw_host_fixed_release(4) == 1;return uploaded && released;
}
swn_return_all :: () -> bool {
  ok := true; for row: 0..<64 { if sw_host_borrowed(cast(s32) row) == 1 { ok = (sw_host_return(cast(s32) row) == 1) && ok; } } return ok;
}
swn_draw_once :: () -> bool {
  count := sw_host_draw_count();
  for i: 0..<cast(int) count { for field: 0..<4 {
    row := sw_host_draw(cast(s32) i, cast(s32) field); if row < 0 || row >= 64 { sn_ignored_1 := swn_return_all(); return false; }
    if sw_host_borrowed(cast(s32) row) != 1 && sw_host_borrow(cast(s32) row) != 1 { sn_ignored_2 := swn_return_all(); return false; }
  } }
  started := cxproc_now_ns(); sn_ignored_3 := sw_vk_render();
  while sw_vk_submission_info(0) == 1 {
    action := ns_action(sw_vk_submission_info(1), true);
    if action != NS_WAIT { sn_ignored_4 := sw_loss_abort(GL_REPLACEMENT); return false; }
    if sw_loss_info(0) == 1 && sw_loss_poll(cxproc_now_ns() / 1000000, sw_loss_info(2)) != GL_PENDING { return false; }
    if ns_timed_out(started, cxproc_now_ns()) { sn_ignored_5 := sw_loss_abort(GL_DEADLINE); return false; }
    proc_sleep(1); sn_ignored_6 := sw_vk_poll();
  }
  if !swn_return_all() { return false; }
  if ns_timed_out(started, cxproc_now_ns()) { sn_ignored_late := sw_loss_abort(GL_DEADLINE); return false; }
  return ns_action(sw_vk_submission_info(1), false) == NS_DONE;
}
swn_loss_begin :: (ctx: [] SnNative) -> int {
  if ctx[0].event_n == 8 { return -1; }
  at := ctx[0].event_n; ctx[0].event_n += 1; ev := SnLossEvent.{result = sw_vk_submission_info(1), real = sw_vk_submission_info(3), injected = sw_vk_submission_info(4),
    start = cxproc_now_ns(), tick = sw_host_info(0), cpu = sw_host_info(14), reads = sw_host_info(20), pending = sw_vk_submission_info(0) == 1};
  if !sw_vk_state(ev.state_before[..]) || !swn_sources(ev.source_before[..]) { return -1; }
  ctx[0].events[at] = ev; return at;
}
swn_loss_end :: (ctx: [] SnNative, at: int, outcome: int) -> bool {
  ctx[0].events[at].outcome = outcome; ctx[0].events[at].reason = sw_loss_info(5); ctx[0].events[at].end = cxproc_now_ns();
  if !sw_vk_state(ctx[0].events[at].state_after[..]) || !swn_sources(ctx[0].events[at].source_after[..]) { return false; }
  ev := ctx[0].events[at];
  ctx[0].state_ok = ctx[0].state_ok && cast(string) ev.state_before[..] == cast(string) ev.state_after[..];
  ctx[0].source_ok = ctx[0].source_ok && ev.cpu == sw_host_info(14) && cast(string) ev.source_before[..] == cast(string) ev.source_after[..];
  ctx[0].tick_ok = ctx[0].tick_ok && ev.tick == sw_host_info(0) && ev.reads == sw_host_info(20);
  if outcome == GL_RECOVERED { ctx[0].upload_ok = ctx[0].upload_ok && ev.granted > 0 && ev.uploaded == ev.granted; }
  return ctx[0].state_ok && ctx[0].source_ok && ctx[0].tick_ok && ctx[0].upload_ok;
}
swn_render :: (ctx: [] SnNative) -> bool {
  if sw_loss_info(1) == 1 { return false; }
  if swn_draw_once() { return true; }
  while true {
    at := swn_loss_begin(ctx); if at < 0 { return false; }
    if !ctx[0].automatic || sw_loss_info(1) == 1 || ns_action(sw_vk_submission_info(1), sw_vk_submission_info(0) == 1) != NS_REBUILD {
      if sw_loss_info(1) != 1 { sn_ignored_7 := sw_loss_abort(GL_REPLACEMENT); }
      sn_ignored_20 := swn_loss_end(ctx, at, GL_STOP); return false;
    }
    admitted := sw_loss_lost(cxproc_now_ns() / 1000000); serial := sw_loss_info(2);
    ctx[0].events[at].serial = serial; ctx[0].events[at].began = sw_loss_info(4);
    if admitted != GL_PENDING { sn_ignored_8 := swn_loss_end(ctx, at, admitted); return false; }
    if sw_vk_close() != 1 { return false; } ctx[0].events[at].old_closed = true;
    ok := sw_loss_poll(cxproc_now_ns() / 1000000, serial) == GL_PENDING;
    if ok { ok = sw_host_recover() == 1 && sw_vk_reopen() == 1 && swn_surface(); }
    if ok { ok = sw_loss_poll(cxproc_now_ns() / 1000000, serial) == GL_PENDING; }
    if ok { ctx[0].events[at].granted = sw_host_recover_info(1);
      for row: 0..<64 { if sw_host_uploadable(cast(s32) row) == 1 {
        if !swn_reupload(cast(s32) row,ctx) { ok = false; break; }
        ctx[0].events[at].uploaded += 1;
        if sw_loss_poll(cxproc_now_ns() / 1000000, serial) != GL_PENDING { ok = false; break; }
      } }
    }
    if !ok {
      if sw_loss_info(1) != 1 { sn_ignored_9 := sw_loss_abort(GL_REPLACEMENT); }
      sn_ignored_21 := swn_loss_end(ctx, at, GL_STOP); return false;
    }
    if swn_draw_once() {
      outcome := sw_loss_finish(cxproc_now_ns() / 1000000, serial, 1);
      if !swn_loss_end(ctx, at, outcome) { return false; } return outcome == GL_RECOVERED;
    }
    if sw_loss_info(1) == 1 { sn_ignored_10 := swn_loss_end(ctx, at, GL_STOP); return false; }
    if !swn_loss_end(ctx, at, GL_STALE) { return false; }
  }
  return false;
}
swn_quiesce :: () -> bool {
  quiescing := cxproc_now_ns();
  while sw_vk_submission_info(0) == 1 { if ns_timed_out(quiescing, cxproc_now_ns()) { return false; } proc_sleep(1); sn_ignored_11 := sw_vk_poll(); }
  return sw_vk_submission_info(2) == 0 && swn_return_all();
}
swn_effects :: (scene: Jv, dir: string, stages: [] Jo, ctx: [] SnNative) -> bool {
  for i: 0..<sw_host_info(2) {
    row := cast(s32) sw_host_command(1, cast(s32) i, 0); gen := sw_host_command(1, cast(s32) i, 1); epoch := sw_host_command(1, cast(s32) i, 2);
    if sw_vk_drop(row, gen) != 1 || sw_host_destroy(row, gen, epoch) != 1 { return false; }
  }
  for i: 0..<sw_host_info(1) {
    row := cast(s32) sw_host_command(0, cast(s32) i, 0); gen := sw_host_command(0, cast(s32) i, 1); epoch := sw_host_command(0, cast(s32) i, 2);
    start := cxproc_now_ns(); transfer := sw_host_row(row, 14);
    // The same mapped bytes also consume one concrete renderer buffer slot;
    // the resource's existing staging lease remains live through its fence.
    fixed := transfer > 0 && sw_host_fixed(5, 2, transfer / 4) == 1;
    allocation_ok := sw_host_allocate(row, gen, epoch) == 1; allocated := cxproc_now_ns();
    bytes: [4096] u8; n := -1; source_ok := false;
    if allocation_ok {
      if sw_fault_take(2, row, gen, epoch, -1) == 1 {
        missing: [4096] u8; n = fs_read(fs_join(dir, ".oa-unavailable-source", missing[..]), bytes[..]); sw_fault_source_result(n);
      } else { n = swn_source(scene, dir, cast(int) row, bytes[..]); }
      if n > 0 { source_ok = sw_sdk_copy(cast(int) row, gen, epoch, bytes[0..<n]); }
    }
    read := cxproc_now_ns(); decoded_result := -1;
    if source_ok { decoded_result = cast(int) sw_host_decode(row, gen, epoch); }
    decoded := cxproc_now_ns(); upload_ok := false;
    if decoded_result == 0 { upload_ok = sw_host_row(row, 3) == 0 || swn_upload(row, gen, epoch, 0,ctx); }
    uploaded := cxproc_now_ns(); result := nlf_status(allocation_ok, source_ok, decoded_result, upload_ok);
    if sw_host_finish_code(row, gen, epoch, cast(s32) result) != 1 { return false; }
    if fixed && sw_host_fixed_release(5) != 1 { return false; }
    jo_arr(stages); for word: [8] int.[cast(int) row, gen, epoch, allocated - start, read - allocated, decoded - read, uploaded - decoded, cxproc_now_ns() - start] { jo_int(stages, word); } jo_end(stages);
  }
  sw_host_ack(); return true;
}
swn_frame :: (scene: Jv, dir: string, ns: int, direction: f32, frames: [] Jo, ctx: [] SnNative) -> bool {
  start := cxproc_now_ns(); if sw_host_frame(ns, direction) != 1 { return false; }
  jo_obj(frames); jo_key(frames, "tick"); jo_int(frames, sw_host_info(0)); jo_key(frames, "direction"); jo_int(frames, cast(int) direction);
  jo_key(frames, "positionBits"); jo_arr(frames); for f: 0..<3 { jo_int(frames, cast(int) f32_bits(sw_host_player(cast(s32) f))); } jo_end(frames);
  jo_key(frames, "stepDigests"); jo_arr(frames);
  for step: 0..<cast(int) sw_host_step_count() { id: assets.AssetId; hex: [64] u8; for word: 0..<8 { id.words[word] = cast(u32) sw_host_step_word(cast(s32) step, cast(s32) word); } #assert assets.asset_hex(id, hex[..]); jo_str(frames, cast(string) hex[..]); } jo_end(frames);
  jo_key(frames, "records"); jo_arr(frames); for i: 0..<sw_host_info(3) { jo_arr(frames); for f: 0..<23 { jo_int(frames, sw_host_record(cast(s32) i, cast(s32) f)); } jo_end(frames); } jo_end(frames);
  jo_key(frames, "stages"); jo_arr(frames); ok := swn_effects(scene, dir, frames,ctx); jo_end(frames); if !ok { return false; }
  if !swn_render(ctx) && sw_loss_info(1) != 1 { return false; }
  jo_key(frames, "allocations"); jo_arr(frames); count := sw_host_trace_count(); if count < 0 { return false; }
  for i: 0..<cast(int) count { jo_arr(frames); for f: 0..<6 { jo_int(frames, sw_host_trace(cast(s32) i, cast(s32) f)); } jo_end(frames); } jo_end(frames); sw_host_trace_ack();
  if sw_host_info(14) > sw_host_info(10) || sw_host_info(14) + sw_vk_info(1) > sw_host_info(8) { return false; }
  jo_key(frames, "info"); jo_arr(frames); for f: 0..<28 { jo_int(frames, sw_host_info(cast(s32) f)); } jo_end(frames);
  jo_key(frames, "gpu"); jo_arr(frames); for f: 0..<20 { jo_int(frames, sw_vk_info(cast(s32) f)); } jo_end(frames);
  jo_key(frames, "hud"); jo_arr(frames); for f: 0..<5 { jo_int(frames, sw_host_hud_info(cast(s32) f)); } jo_end(frames);
  jo_key(frames, "frameNs"); jo_int(frames, ns); jo_key(frames, "elapsedNs"); jo_int(frames, cxproc_now_ns() - start); jo_end(frames); return !frames[0].bad;
}
swn_capture :: (out: [] u8) -> bool {
  if sw_host_fixed(3, 2, out.count / 4) != 1 { return false; }
  ok := sw_vk_capture(out) == 1; return (sw_host_fixed_release(3) == 1) && ok;
}
swn_sources :: (out: [] u8) -> bool {
  bytes: [263168] u8; n := 0;
  for row: 0..<64 { source: [4096] u8; count := sw_vk_source(row, source[..]); if count < 0 || count > 4096 { return false; }
    resource_put64(bytes[..], n, row); resource_put64(bytes[..], n + 8, count); n += 16;
    for i: 0..<count { bytes[n] = source[i]; n += 1; }
  }
  return assets.asset_hex(assets.asset_id(cast(string) bytes[0..<n]), out);
}
swn_recover :: (program: [] u8, hud_program: [] u8, present_program: [] u8, q: [] int, report: [] Jo, outdir: string, ctx: [] SnNative) -> bool {
  before: [230400] u8; after: [230400] u8; state_before: [64] u8; state_after: [64] u8; source_before: [64] u8; source_after: [64] u8;
  if !swn_capture(before[..]) || !sw_vk_state(state_before[..]) || !swn_sources(source_before[..]) { return false; }
  hud_before: [98304] u8; hud_after: [98304] u8; hn := sw_vk_hud_copy(hud_before[..]); if hn < 1 { return false; }
  live := sw_vk_info(0); tick := sw_host_info(0); cpu := sw_host_info(14); reads := sw_host_info(20); frames := sw_vk_info(7);
  started := cxproc_now_ns(); if sw_vk_close() != 1 { return false; } old_closed := sw_vk_info(4) == 0 && sw_vk_info(0) == 0;
  if sw_host_recover() != 1 || sw_vk_open(program, hud_program, present_program) != 1 || !swn_surface() { return false; }
  uploaded := 0;
  for row: 0..<64 { if sw_host_uploadable(cast(s32) row) == 1 {
    if !swn_reupload(cast(s32) row,ctx) { return false; } uploaded += 1;
  } }
  if !swn_render(ctx) || !swn_capture(after[..]) || !sw_vk_state(state_after[..]) || !swn_sources(source_after[..]) { return false; }
  if sw_vk_hud_copy(hud_after[..]) != hn || cast(string) hud_before[0..<hn] != cast(string) hud_after[0..<hn] { return false; }
  q[0] = 1; q[1] = ifx live > 0 then 1 else 0; q[2] = ifx cast(string) before[..] == cast(string) after[..] then 1 else 0;
  distinct := false; for i: 1..<57600 { for lane: 0..<4 { if before[i * 4 + lane] != before[lane] { distinct = true; } } } q[3] = ifx distinct then 1 else 0;
  q[4] = ifx cast(string) state_before[..] == cast(string) state_after[..] then 1 else 0;
  q[5] = ifx cpu == sw_host_info(14) && reads == sw_host_info(20) && cast(string) source_before[..] == cast(string) source_after[..] then 1 else 0;
  q[6] = ifx tick == sw_host_info(0) then 1 else 0; q[7] = ifx old_closed && sw_vk_info(5) == 2 && sw_vk_info(6) == 1 then 1 else 0;
  q[8] = ifx uploaded == sw_host_recover_info(1) && uploaded == live && sw_vk_info(0) == live then 1 else 0;
  q[9] = ifx sw_host_recover_info(2) == 2 then 1 else 0; q[10] = ifx sw_vk_info(7) > frames then 1 else 0;
  path: [4096] u8; if !fs_write(fs_join(outdir, "before.rgba", path[..]), cast(string) before[..]) || !fs_write(fs_join(outdir, "after.rgba", path[..]), cast(string) after[..]) { return false; }
  if !fs_write(fs_join(outdir, "before-hud.f32", path[..]), cast(string) hud_before[0..<hn]) || !fs_write(fs_join(outdir, "after-hud.f32", path[..]), cast(string) hud_after[0..<hn]) { return false; }
  jo_obj(report); jo_key(report, "tick"); jo_int(report, tick); jo_key(report, "cpuBytes"); jo_int(report, cpu); jo_key(report, "attempts"); jo_int(report, reads); jo_key(report, "uploaded"); jo_int(report, uploaded);
  jo_key(report, "elapsedNs"); jo_int(report, cxproc_now_ns() - started); jo_key(report, "stateSHA256"); jo_str(report, cast(string) state_before[..]); jo_key(report, "stateAfterSHA256"); jo_str(report, cast(string) state_after[..]);
  jo_key(report, "sourceSHA256"); jo_str(report, cast(string) source_before[..]); jo_key(report, "sourceAfterSHA256"); jo_str(report, cast(string) source_after[..]); jo_end(report); return true;
}
swn_fault_frame :: (scene: Jv, dir: string, output: string, kind: s32, count: int, frames: [] Jo, ctx: [] SnNative) -> bool {
  group := ctx[0].groups; if group >= 4 { return false; } ctx[0].groups += 1;
  before: [230400] u8; after: [230400] u8; path: [4096] u8;
  if !swn_capture(before[..]) || sw_vk_fault(kind, count) != 1 || !swn_frame(scene, dir, 0, 0, frames, ctx) { return false; }
  names_before := [4] string.["loss-before-0.rgba", "loss-before-1.rgba", "loss-before-2.rgba", "loss-before-3.rgba"];
  names_after := [4] string.["loss-after-0.rgba", "loss-after-1.rgba", "loss-after-2.rgba", "loss-after-3.rgba"];
  if !fs_write(fs_join(output, names_before[group], path[..]), cast(string) before[..]) { return false; }
  if sw_loss_info(1) != 1 {
    if !swn_capture(after[..]) || cast(string) before[..] != cast(string) after[..] { ctx[0].pixels_ok = false; return false; }
    if !fs_write(fs_join(output, names_after[group], path[..]), cast(string) after[..]) { return false; }
  }
  return true;
}
swn_loss_events :: (ctx: [] SnNative, report: [] Jo) {
  jo_arr(report);
  for i: 0..<ctx[0].event_n { e := ctx[0].events[i]; jo_obj(report);
    names := [18] string.["result", "realResult", "injectedCount", "serial", "beganMs", "reason", "outcome", "tick", "cpu", "reads", "uploaded", "granted", "oldClosed", "pending", "startNs", "endNs", "stateRetained", "sourceRetained"];
    values := [18] int.[e.result, e.real, e.injected, e.serial, e.began, e.reason, e.outcome, e.tick, e.cpu, e.reads, e.uploaded, e.granted,
      ifx e.old_closed then 1 else 0, ifx e.pending then 1 else 0, e.start, e.end,
      ifx cast(string) e.state_before[..] == cast(string) e.state_after[..] then 1 else 0,
      ifx cast(string) e.source_before[..] == cast(string) e.source_after[..] then 1 else 0];
    for value, k: values { jo_key(report, names[k]); jo_int(report, value); }
    jo_key(report, "stateBefore"); jo_str(report, cast(string) e.state_before[..]); jo_key(report, "stateAfter"); jo_str(report, cast(string) e.state_after[..]);
    jo_key(report, "sourceBefore"); jo_str(report, cast(string) e.source_before[..]); jo_key(report, "sourceAfter"); jo_str(report, cast(string) e.source_after[..]); jo_end(report);
  } jo_end(report);
}
swn_pressure :: (scene: Jv, dir: string, output: string, j: [] Jo, ctx: [] SnNative) -> bool {
  source: [4096] u8; n := scp_read(scene, dir, source[..]); if n < 1 { return false; }
  before: [230400] u8; after: [230400] u8;
  if !swn_capture(before[..]) { return false; }
  cpu := sw_host_info(14); gpu_bytes := sw_vk_info(1); gpu_n := sw_vk_info(0); trace_n := sw_host_trace_count();
  words: [31] int; manifest: [488] u8; hashes: [320] u8;
  if !sw_sdk_pressure(source[0..<n], words[..], manifest[..], hashes[..]) || !swn_render(ctx) || !swn_capture(after[..]) { return false; }
  words[10] = ifx words[10] == 1 && cpu == sw_host_info(14) && gpu_bytes == sw_vk_info(1) && gpu_n == sw_vk_info(0) && trace_n == sw_host_trace_count() then 1 else 0;
  words[11] = ifx cast(string) before[..] == cast(string) after[..] then 1 else 0;
  if !scp_accept(words[0..<13]) { return false; }
  path: [4096] u8;
  if !fs_write(fs_join(output, "pressure-before.rgba", path[..]), cast(string) before[..]) || !fs_write(fs_join(output, "pressure-after.rgba", path[..]), cast(string) after[..]) || !fs_write(fs_join(output, "pressure.rcm", path[..]), cast(string) manifest[..]) { return false; }
  jo_obj(j); jo_key(j, "schema"); jo_str(j, "aethyr.stream-category-pressure.v1");
  jo_key(j, "words"); jo_arr(j); for word: words[0..<13] { jo_int(j, word); } jo_end(j);
  jo_key(j, "before"); jo_arr(j); for word: words[13..<22] { jo_int(j, word); } jo_end(j);
  jo_key(j, "after"); jo_arr(j); for word: words[22..<31] { jo_int(j, word); } jo_end(j);
  for key, i: [5] string.["manifestSHA256", "sourceSHA256", "stateBefore", "stateAfter", "stateNormalized"] {
    jo_key(j, key); jo_str(j, cast(string) hashes[i * 64..<i * 64 + 64]);
  }
  jo_key(j, "cpuBytes"); jo_int(j, cpu); jo_key(j, "gpuBytes"); jo_int(j, gpu_bytes); jo_key(j, "gpuOwners"); jo_int(j, gpu_n); jo_key(j, "traceEvents"); jo_int(j, cast(int) trace_n);
  jo_end(j); return !j[0].bad;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) < 5 || args_count(a[..]) > 6 { tool_errln("usage: stream-native SCENE_DIR SCENE_SHA256 SHADER.spv NEW_OUTPUT_DIR TIER [--route]"); return 2; }
  mode := ifx args_count(a[..]) == 6 then args_at(a[..], 5) else "";
  pressure := mode == "--category-pressure";
  sdk_case := nsf_case(mode);sdk_fault := sdk_case >= 0;
  upload_probe := mode == "--upload-pending" || mode == "--upload-buffer-pending";
  failure_case := nlf_case(mode); failure := failure_case >= 0;
  automatic := mode == "--auto-loss" || mode == "--auto-repeat" || mode == "--auto-restart" || mode == "--auto-timeout" || mode == "--auto-fail" || mode == "--auto-oom" || mode == "--auto-route" || mode == "--auto-late";
  route := mode == "--route" || mode == "--auto-route"; if mode != "" && !route && !automatic && !pressure && !failure && !upload_probe && !sdk_fault { return 2; }
  tier := args_at(a[..], 4); if tier != "0" && tier != "1" { return 2; } quality := ifx tier == "0" then 0 else 1;
  dir := args_at(a[..], 0); output := args_at(a[..], 3); if fs_exists(output) || !fs_mkdir(output) { return 2; }
  path: [4096] u8; scene_bytes: [65536] u8; scene: [1] Jv; nodes: [4096] JvNode; n := fs_read(fs_join(dir, "scene.json", path[..]), scene_bytes[..]);
  if n < 1 || !sw_auth(scene_bytes[0..<n], args_at(a[..], 1)) || !jv_parse(scene[..], cast(string) scene_bytes[0..<n], nodes[..]) { return 1; }
  root: [64] u8; item := jv_at(scene[0], jv_get(scene[0], 0, "manifests"), 2 + quality);
  if jv_int(scene[0], jv_get(scene[0], item, "backend"), -1) != 1 || jv_int(scene[0], jv_get(scene[0], item, "tier"), -1) != quality || jv_str(scene[0], jv_get(scene[0], item, "sha256"), root[..]) != 64 { return 1; }
  name: [128] u8; manifest_bytes: [32768] u8; mn := fs_read(fs_join(dir, swn_name(cast(string) root[..], ".rcm", name[..]), path[..]), manifest_bytes[..]);
  if mn < 1 || sw_loss_open() != 1 || !sw_sdk_start(manifest_bytes[0..<mn], root[..], quality, 1) { return 1; }
  if failure && sw_fault_open(cast(s32) (ifx failure_case < 5 then 1 else failure_case - 3), cast(s32) (ifx failure_case < 5 then failure_case else -1)) != 1 { return 1; }
  if sdk_fault && sw_sdk_fault_open(cast(s32) nsf_kind(sdk_case),cast(s32) nsf_domain(sdk_case),cast(s32) nsf_phase(sdk_case)) != 1 { return 1; }
  program: [65536] u8; hud_program: [65536] u8; present_program: [65536] u8; sn := fs_read(args_at(a[..], 2), program[..]);
  hsn := fs_read(fs_join(fs_dir(args_at(a[..], 2)), "stream-hud.spv", path[..]), hud_program[..]);
  psn := fs_read(fs_join(fs_dir(args_at(a[..], 2)), "stream-present.spv", path[..]), present_program[..]);
  if sn < 1 || hsn < 1 || psn < 1 || sw_vk_open(program[0..<sn], hud_program[0..<hsn], present_program[0..<psn]) != 1 || !swn_surface() { return 1; }
  device: [256] u8; dn := sw_vk_name(device[..]); if dn < 0 { return 1; }
  report: [8388608] u8; j: [1] Jo; jo_start(j[..], report[..]); jo_obj(j[..]); jo_key(j[..], "schema"); jo_str(j[..], ifx sdk_fault then "aethyr.stream-walk-native-gpu.v6" else ifx failure then "aethyr.stream-walk-native-gpu.v5" else ifx pressure then "aethyr.stream-walk-native-gpu.v4" else ifx automatic then "aethyr.stream-walk-native-gpu.v3" else "aethyr.stream-walk-native-gpu.v2");
  jo_key(j[..], "device"); jo_str(j[..], cast(string) device[0..<cast(int) dn]); jo_key(j[..], "backend"); jo_int(j[..], 1); jo_key(j[..], "tier"); jo_int(j[..], quality);
  jo_key(j[..], "sceneSHA256"); jo_str(j[..], args_at(a[..], 1)); jo_key(j[..], "manifestSHA256"); jo_str(j[..], cast(string) root[..]);
  jo_key(j[..], "presentationSchema"); jo_str(j[..], "aethyr.stream-walk-display.v1");
  jo_key(j[..], "shaderSHA256"); program_hex: [64] u8; #assert assets.asset_hex(assets.asset_id(cast(string) program[0..<sn]), program_hex[..]); jo_str(j[..], cast(string) program_hex[..]);
  jo_key(j[..], "hudShaderSHA256"); #assert assets.asset_hex(assets.asset_id(cast(string) hud_program[0..<hsn]), program_hex[..]); jo_str(j[..], cast(string) program_hex[..]);
  jo_key(j[..], "presentShaderSHA256"); #assert assets.asset_hex(assets.asset_id(cast(string) present_program[0..<psn]), program_hex[..]); jo_str(j[..], cast(string) program_hex[..]);
  ctx := [1] SnNative.[SnNative.{automatic = automatic,probe_enabled = upload_probe,sdk_case = sdk_case}];
  if upload_probe && sw_vk_transfer_hold(50,ifx mode == "--upload-buffer-pending" then 1 else 2) != 1 { return 1; }
  q: [16] int; jo_key(j[..], "warmup"); jo_arr(j[..]); for i: 0..<32 { if sw_loss_info(1) == 1 { break; } if !swn_frame(scene[0], dir, 62500000, 0, j[..], ctx[..]) { tool_errln("native warmup failed"); return 1; } }
  if automatic && sw_loss_info(1) != 1 {
    kind: s32 = ifx mode == "--auto-late" then 5 else ifx mode == "--auto-timeout" then 2 else ifx mode == "--auto-fail" then 3 else ifx mode == "--auto-oom" then 4 else 1;
    count := ifx mode == "--auto-late" then 10050 else ifx mode == "--auto-timeout" then 10100 else ifx mode == "--auto-restart" then 2 else 1;
    rounds := ifx mode == "--auto-repeat" then 4 else 1;
    for i: 0..<rounds { if !swn_fault_frame(scene[0], dir, output, kind, count, j[..], ctx[..]) { tool_errln("automatic fault frame failed"); return 1; } }
  }
  jo_end(j[..]);
  if pressure { jo_key(j[..], "categoryPressure"); if !swn_pressure(scene[0], dir, output, j[..], ctx[..]) { tool_errln("native category pressure failed"); return 1; } }
  checkpoints: [2] [12] [5] int;
  for cell: 0..<12 { for field: 0..<5 { checkpoints[0][cell][field] = sw_host_cell(cast(s32) cell,cast(s32) field); } }
  jo_key(j[..], "recovery"); if !automatic && sw_loss_info(1) != 1 {
    if !swn_recover(program[0..<sn], hud_program[0..<hsn], present_program[0..<psn], q[..], j[..], output, ctx[..]) { tool_errln("native recovery failed"); return 1; }
  } else { jo_obj(j[..]); jo_end(j[..]); }
  for cell: 0..<12 { for field: 0..<5 { checkpoints[1][cell][field] = sw_host_cell(cast(s32) cell,cast(s32) field); } }
  jo_key(j[..], "route"); jo_arr(j[..]); if route { for leg: 0..<2 {
    for i: 0..<1600 {
      if sw_loss_info(1) == 1 { break; }
      if !swn_frame(scene[0], dir, 62500000, ifx leg == 0 then 1.0f32 else -1.0f32, j[..], ctx[..]) { tool_errln("native route failed"); return 1; }
      if automatic && i == 800 { if !swn_fault_frame(scene[0], dir, output, 1, 1, j[..], ctx[..]) { return 1; } }
    }
    for cell: 0..<12 { for field: 0..<5 { checkpoints[leg][cell][field] = sw_host_cell(cast(s32) cell, cast(s32) field); } }
  } }
  if (automatic || pressure || failure || sdk_fault) && !route {
    for cell: 0..<12 { for field: 0..<5 { checkpoints[0][cell][field] = sw_host_cell(cast(s32) cell, cast(s32) field); } }
    if sw_loss_info(1) != 1 { for i: 0..<8 { if !swn_frame(scene[0], dir, 15625000, 1, j[..], ctx[..]) { return 1; } } }
    for cell: 0..<12 { for field: 0..<5 { checkpoints[1][cell][field] = sw_host_cell(cast(s32) cell, cast(s32) field); } }
  } jo_end(j[..]);
  jo_key(j[..], "routeCells"); jo_arr(j[..]); for leg: checkpoints { jo_arr(j[..]); for cell: leg { jo_arr(j[..]); for field: cell { jo_int(j[..], field); } jo_end(j[..]); } jo_end(j[..]); } jo_end(j[..]);
  blocked := true; if sw_loss_info(1) == 1 { tick := sw_host_info(0); blocked = sw_host_frame(15625000, 1) == 0 && sw_host_info(0) == tick; }
  jo_key(j[..], "stopRetained"); jo_arr(j[..]); for value: [5] int.[sw_vk_submission_info(0), sw_vk_submission_info(2), sw_host_info(14), sw_vk_info(1), sw_host_info(12)] { jo_int(j[..], value); } jo_end(j[..]);
  quiesce_start := cxproc_now_ns(); if sw_host_close() != 1 || !swn_quiesce() { return 1; } quiesce_ns := cxproc_now_ns() - quiesce_start;
  jo_key(j[..], "cleanup"); jo_arr(j[..]); for i: 0..<128 { if sw_host_info(24) == 1 { break; } if !swn_frame(scene[0], dir, 15625000, 0, j[..], ctx[..]) { return 1; } } jo_end(j[..]);
  if sw_vk_info(4) == 1 && sw_vk_close() != 1 { return 1; }
  for i: [6] int.[0, 1, 2, 6, 7, 8] { if sw_host_fixed_live(cast(s32) i) == 1 && sw_host_fixed_release(cast(s32) i) != 1 { return 1; } }
  q[11] = sw_vk_info(9); q[12] = sw_vk_info(10); q[13] = sw_vk_info(0) + sw_vk_info(2) + sw_vk_info(4); q[14] = sw_host_info(12) + sw_host_info(13);
  drained := sw_host_info(24) == 1 && sw_host_info(20) == sw_host_info(21) && sw_vk_info(11) == 1;
  for field: [7] s32.[8, 10, 11, 12, 14, 22, 23] { drained = drained && sw_host_info(field) == 0; } q[15] = ifx drained then 1 else 0;
  auto_words := [12] int.[1, ifx ctx[0].state_ok then 1 else 0, ifx ctx[0].source_ok then 1 else 0, ifx ctx[0].tick_ok then 1 else 0,
    ifx ctx[0].upload_ok then 1 else 0, ifx blocked then 1 else 0, ifx sw_vk_submission_info(2) == 0 then 1 else 0,
    ifx drained && q[13] == 0 && q[14] == 0 then 1 else 0, ifx swn_close_accept(sw_vk_info(19)) then 1 else 0,
    ifx sw_vk_info(11) == 1 && q[11] == 0 && q[12] == 0 then 1 else 0,
    ifx sw_vk_submission_info(4) > 0 || mode == "--auto-timeout" then 1 else 0, ifx ctx[0].pixels_ok then 1 else 0];
  passed := ifx automatic then snl_accept(auto_words[..]) else swn_accept(q[..]) && swn_close_accept(sw_vk_info(19));
  load_words: [10] int; if failure { for i: 0..<10 { load_words[i] = sw_fault_info(cast(s32) i); } passed = passed && nlf_effect(failure_case, load_words[..]); }
  sdk_words: [26] int;
  if sdk_fault {
    for i: 0..<26 { sdk_words[i] = sw_sdk_fault_info(cast(s32) i); }
    passed = nsf_effect(sdk_case,sdk_words[..]) && drained && q[13] == 0 && q[14] == 0 && q[11] == 0 && q[12] == 0 && swn_close_accept(sw_vk_info(19)) && sw_vk_transfer_info(1) == 0;
    if nsf_domain(sdk_case) == 4 {
      passed = passed && ctx[0].sdk_stopped && nsf_stop(sdk_case,ctx[0].sdk_stop[..]) && blocked && sw_loss_info(1) == 1 && sw_loss_info(5) == nsf_reason(sdk_case);
      for i: 0..<3 { passed = passed && ctx[0].sdk_stop[i] == sdk_words[i + 5]; }
    }else { passed = passed && !ctx[0].sdk_stopped && sw_loss_info(1) == 0 && swn_accept(q[..]); }
  }
  jo_key(j[..], "observations"); jo_arr(j[..]); if automatic { for word: auto_words { jo_int(j[..], word); } } else { for word: q { jo_int(j[..], word); } } jo_end(j[..]); jo_key(j[..], "passed"); jo_bool(j[..], passed);
  if automatic {
    jo_key(j[..], "lossMode"); jo_str(j[..], mode); jo_key(j[..], "qualification"); jo_str(j[..], "SDK result injection after actual Vulkan submissions; no physical GPU reset");
    jo_key(j[..], "lossEvents"); swn_loss_events(ctx[..], j[..]); jo_key(j[..], "groups"); jo_int(j[..], ctx[0].groups);
    jo_key(j[..], "stoppedFrameRefused"); jo_bool(j[..], blocked); jo_key(j[..], "quiesceNs"); jo_int(j[..], quiesce_ns);
    jo_key(j[..], "lossPolicy"); jo_arr(j[..]); for f: 0..<7 { jo_int(j[..], sw_loss_info(cast(s32) f)); } jo_end(j[..]);
    jo_key(j[..], "finalSubmission"); jo_arr(j[..]); for f: 0..<7 { jo_int(j[..], sw_vk_submission_info(cast(s32) f)); } jo_end(j[..]);
  }
  jo_key(j[..], "fixedGrantsRetainedThroughDestruction"); jo_bool(j[..], swn_close_accept(sw_vk_info(19)));
  if failure {
    jo_key(j[..], "loadFailure"); jo_obj(j[..]); jo_key(j[..], "schema"); jo_str(j[..], "aethyr.stream-native-load-failure.v1"); jo_key(j[..], "case"); jo_int(j[..], failure_case);
    jo_key(j[..], "qualification"); jo_str(j[..], "explicit allocator/source/scratch effect input; no physical OS exhaustion");
    jo_key(j[..], "effect"); jo_arr(j[..]); for word: load_words { jo_int(j[..], word); } jo_end(j[..]); jo_end(j[..]);
  }
  if sdk_fault {
    jo_key(j[..],"sdkFault");jo_obj(j[..]);jo_key(j[..],"schema");jo_str(j[..],"aethyr.stream-native-sdk-fault.v1");jo_key(j[..],"case");jo_int(j[..],sdk_case);
    jo_key(j[..],"qualification");jo_str(j[..],"scoped SDK error inputs over real Vulkan effects; no physical exhaustion or reset");
    jo_key(j[..],"words");jo_arr(j[..]);for word: sdk_words { jo_int(j[..],word); }jo_end(j[..]);
    jo_key(j[..],"stop");jo_arr(j[..]);if ctx[0].sdk_stopped { for word: ctx[0].sdk_stop { jo_int(j[..],word); } }jo_end(j[..]);
    jo_key(j[..],"sourceBefore");jo_str(j[..],ifx ctx[0].sdk_stopped then cast(string) ctx[0].sdk_before[..] else "");
    jo_key(j[..],"sourceAfter");jo_str(j[..],ifx ctx[0].sdk_stopped then cast(string) ctx[0].sdk_after[..] else "");
    jo_key(j[..],"stoppedFrameRefused");jo_bool(j[..],ctx[0].sdk_stopped && blocked);
    jo_key(j[..],"policy");jo_arr(j[..]);for i: 0..<7 { jo_int(j[..],sw_loss_info(cast(s32) i)); }jo_end(j[..]);jo_end(j[..]);
  }
  jo_key(j[..], "finalInfo"); jo_arr(j[..]); for f: 0..<28 { jo_int(j[..], sw_host_info(cast(s32) f)); } jo_end(j[..]); jo_key(j[..], "finalGPU"); jo_arr(j[..]); for f: 0..<20 { jo_int(j[..], sw_vk_info(cast(s32) f)); } jo_end(j[..]);
  jo_key(j[..], "finalHUD"); jo_arr(j[..]); for f: 0..<5 { jo_int(j[..], sw_host_hud_info(cast(s32) f)); } jo_end(j[..]); jo_end(j[..]);
  if j[0].bad || !fs_write(fs_join(output, "receipt.json", path[..]), jo_text(j[..])) { return 1; }
  if !passed { tool_errln("native observations refused"); return 1; }
  if upload_probe {
    ctx[0].upload_probe[1] = sw_vk_transfer_info(8);ctx[0].upload_probe[17] = sw_vk_transfer_info(0);ctx[0].upload_probe[18] = sw_vk_transfer_info(1);ctx[0].upload_probe[19] = sw_vk_transfer_info(2);
    if !ctx[0].probe_done || !nu_probe(ctx[0].upload_probe[..],ctx[0].upload_guards[..]) { return 1; }
    probe: [4096] u8; p: [1] Jo; jo_start(p[..],probe[..]);jo_obj(p[..]);jo_key(p[..],"schema");jo_str(p[..],"aethyr.stream-native-upload-pending.v1");
    jo_key(p[..],"qualification");jo_str(p[..],"held fence observation after real Vulkan submission; no physical GPU delay");
    jo_key(p[..],"receiptSHA256"); #assert assets.asset_hex(assets.asset_id(jo_text(j[..])),program_hex[..]);jo_str(p[..],cast(string) program_hex[..]);
    jo_key(p[..],"words");jo_arr(p[..]);for word: ctx[0].upload_probe { jo_int(p[..],word); }jo_end(p[..]);
    jo_key(p[..],"guards");jo_arr(p[..]);for result: ctx[0].upload_guards { jo_int(p[..],result); }jo_end(p[..]);
    jo_key(p[..],"sourceBefore");jo_str(p[..],cast(string) ctx[0].upload_source_before[..]);jo_key(p[..],"sourceAfter");jo_str(p[..],cast(string) ctx[0].upload_source_after[..]);jo_end(p[..]);
    if p[0].bad || !fs_write(fs_join(output,"upload-probe.json",path[..]),jo_text(p[..])) { return 1; }
  }
  print("PASS actual native streaming GPU replacement; % attempts, % ticks, zero final owners\n", sw_host_info(20), sw_host_info(0)); return 0;
}
