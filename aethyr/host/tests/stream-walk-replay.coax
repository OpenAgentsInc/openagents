// Replay actual browser or native completion/destruction history through native
// malloc/free and the same Coax consumer. This is a CPU/codec replay receipt;
// no native GPU rendering or device recovery is inferred.
#import "Basic";
#load "../../world/stream-walk.coax";
#load "../../forge/pack.coax" as packs;
#load "../recorded-source.coax";
#load "../stream-replay-profile.coax";
#load "stream-pressure.coax";
#load "../native-load-policy.coax";
#load "../native-sdk-fault.coax";
#load "stream-backing-replay.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/json/json.coax";

sw_sdk_start :: (source: [] u8, root: [] u8, tier: int, backend: int) -> bool #foreign #effects(all);
sw_sdk_copy :: (row: int, generation: int, epoch: int, source: [] u8) -> bool #foreign #effects(all);
sw_sdk_pressure :: (source: [] u8, words: [] int, manifest: [] u8, hashes: [] u8) -> bool #foreign #effects(all);
sw_fault_open :: (kind: s32, field: s32) -> s32 #foreign #effects(all);
sw_fault_open_at :: (kind: s32, field: s32, row: s32) -> s32 #foreign #effects(all);
sw_fault_take :: (kind: s32, row: s32, generation: int, epoch: int, field: s32) -> s32 #foreign #effects(all);
sw_fault_source_result :: (result: int) #foreign #effects(all);
sw_fault_info :: (field: s32) -> int #foreign #effects(all);
sw_host_frame :: (ns: int, direction: f32) -> s32 #foreign #effects(all);
sw_host_step_count :: () -> s32 #foreign #effects(all);
sw_host_step_word :: (step: s32, word: s32) -> int #foreign #effects(all);
sw_host_ack :: () #foreign #effects(all);
sw_host_close :: () -> s32 #foreign #effects(all);
sw_host_info :: (field: s32) -> int #foreign #effects(all);
sw_host_row :: (row: s32, field: s32) -> int #foreign #effects(all);
sw_host_player :: (field: s32) -> f32 #foreign #effects(all);
sw_host_command :: (retiring: s32, index: s32, field: s32) -> int #foreign #effects(all);
sw_host_record :: (index: s32, field: s32) -> int #foreign #effects(all);
sw_host_allocate :: (row: s32, generation: int, epoch: int) -> s32 #foreign #effects(all);
sw_host_decode :: (row: s32, generation: int, epoch: int) -> s32 #foreign #effects(all);
sw_host_finish :: (row: s32, generation: int, epoch: int, status: s32) -> s32 #foreign #effects(all);
sw_host_finish_code :: (row: s32, generation: int, epoch: int, status: s32) -> s32 #foreign #effects(all);
sw_host_destroy :: (row: s32, generation: int, epoch: int) -> s32 #foreign #effects(all);
sw_host_cell :: (cell: s32, field: s32) -> int #foreign #effects(all);
sw_host_trace_ack :: () #foreign #effects(all);

SwReplaySources :: struct { data: [64] [4096] u8; count: [64] int; }
SwReplayAttempts :: struct { generation: [64] int; epoch: [64] int; retiring: [64] bool; failed: [64] int;
  sdk_case: int = -1; sdk: [26] int; sdk_seen: bool; sdk_after: bool; sdk_source: [64] u8;
}
SwReplaySnapshots :: struct {used: [RECORDED_SOURCE_EVENTS] bool;}
#test "replay numbers preserve unsigned SHA words and source decimal binary32 values" {
  d: [1] Jv; nodes: [32] JvNode;
  #assert jv_parse(d[..], "[\"4294967295\",-1,18.3974609375,\"9007199254740993\",\"9223372036854775807\",\"-9223372036854775808\"]", nodes[..]);
  #assert swr_word(d[0], jv_at(d[0], 0, 0)) == 4294967295 && swr_word(d[0], jv_at(d[0], 0, 1)) == -1;
  #assert f32(swr_number(d[0], jv_at(d[0], 0, 2))) == 18.3974609375;
  #assert swr_word(d[0], jv_at(d[0], 0, 3)) == 9007199254740993;
  #assert swr_word(d[0], jv_at(d[0], 0, 4)) == 9223372036854775807 && swr_word(d[0], jv_at(d[0], 0, 5)) == -9223372036854775808;
}
swr_number :: (d: Jv, at: int) -> f64 {
  #assert jv_kind(d, at) == JV_NUMBER || jv_kind(d, at) == JV_STRING;
  text := jv_raw(d, at); n := args_number(text); if !n.ok { print("unsupported replay number '%'\n", text); } #assert n.ok; return n.value;
}
swr_word :: (d: Jv, at: int) -> int {
  #assert jv_kind(d, at) == JV_NUMBER || jv_kind(d, at) == JV_STRING;
  word := recorded_source_word(jv_raw(d, at)); #assert word.ok; return word.value;
}
swr_name :: (id: string, suffix: string, out: [] u8) -> string {
  #assert id.count == 64 && out.count >= 80;
  for c, i: id { out[i] = c; } for c, i: suffix { out[64 + i] = c; }
  return cast(string) out[0..<64 + suffix.count];
}
swr_sources :: (scene: Jv, dir: string, out: [] SwReplaySources) -> bool {
  resources := jv_get(scene, 0, "resources"); if jv_len(scene, resources) != 64 { return false; }
  for row: 0..<64 {
    item := jv_at(scene, resources, row); hex: [64] u8;
    if jv_int(scene, jv_get(scene, item, "row"), -1) != row || jv_str(scene, jv_get(scene, item, "container_sha256"), hex[..]) != 64 { return false; }
    raw := jv_bool(scene, jv_get(scene, item, "raw")); name: [128] u8; path: [4096] u8; bytes: [65536] u8;
    n := fs_read(fs_join(dir, swr_name(cast(string) hex[..], ifx raw then ".raw" else ".vpk", name[..]), path[..]), bytes[..]);
    if n < 1 || !sw_auth(bytes[0..<n], cast(string) hex[..]) { return false; }
    offset := jv_int(scene, jv_get(scene, item, "offset"), -1); count := jv_int(scene, jv_get(scene, item, "bytes"), -1);
    if offset < 0 || count < 1 || count > 4096 || offset > n - count { return false; }
    if !raw { pack: [1] packs.PackRead; if !packs.pack_read(cast(string) bytes[0..<n], pack[..]) { return false; } }
    if jv_str(scene, jv_get(scene, item, "sha256"), hex[..]) != 64 || !sw_auth(bytes[offset..<offset + count], cast(string) hex[..]) { return false; }
    for i: 0..<count { out[0].data[row][i] = bytes[offset + i]; } out[0].count[row] = count;
  }
  return true;
}
swr_effects :: (source: [] SwReplaySources, attempts: [] SwReplayAttempts, failure: bool) -> bool {
  for i: 0..<sw_host_info(1) {
    row := sw_host_command(0, cast(s32) i, 0); gen := sw_host_command(0, cast(s32) i, 1); epoch := sw_host_command(0, cast(s32) i, 2);
    if row < 0 || row >= 64 || attempts[0].generation[row] != 0 { return false; }
    allocated := sw_host_allocate(cast(s32) row, gen, epoch) == 1; copied := false; decoded := -1;
    if allocated {
      if failure && sw_fault_take(2,cast(s32) row,gen,epoch,-1) == 1 { sw_fault_source_result(-1); }
      else { copied = sw_sdk_copy(row,gen,epoch,source[0].data[row][0..<source[0].count[row]]); }
    }
    if copied { decoded = cast(int) sw_host_decode(cast(s32) row,gen,epoch); }
    status := nlf_status(allocated,copied,decoded,true);
    target := attempts[0].sdk_case >= 0 && row == attempts[0].sdk[5] && gen == attempts[0].sdk[6] && epoch == attempts[0].sdk[7];
    if status != 0 && (!failure || sw_fault_info(3) != 1 || sw_fault_info(4) != row || sw_fault_info(5) != gen || sw_fault_info(6) != epoch) && !(target && nsf_domain(attempts[0].sdk_case) == 1 && status == 3) { return false; }
    if attempts[0].sdk_case >= 0 {
      if target && attempts[0].sdk_seen { return false; }
      status = nsf_outcome(attempts[0].sdk_case,target,attempts[0].sdk_after,sw_host_row(cast(s32) row,3) > 0);
      if status < 0 { return false; }
      if target { attempts[0].sdk_seen = true;attempts[0].sdk_after = true; }
    }
    attempts[0].failed[row] = status;
    attempts[0].generation[row] = gen; attempts[0].epoch[row] = epoch;
    if target && nsf_domain(attempts[0].sdk_case) == 4 {
      fingerprint: [263168] u8;at := 0;
      for owner: 0..<64 {
        size := ifx attempts[0].generation[owner] > 0 then source[0].count[owner] else 0;
        resource_put64(fingerprint[..],at,owner);resource_put64(fingerprint[..],at + 8,size);at += 16;
        for byte: 0..<size { fingerprint[at] = source[0].data[owner][byte];at += 1; }
      }
      hex: [64] u8;#assert assets.asset_hex(assets.asset_id(cast(string) fingerprint[0..<at]),hex[..]);
      if cast(string) hex[..] != cast(string) attempts[0].sdk_source[..] { return false; }
    }
  }
  for i: 0..<sw_host_info(2) {
    row := sw_host_command(1, cast(s32) i, 0); gen := sw_host_command(1, cast(s32) i, 1); epoch := sw_host_command(1, cast(s32) i, 2);
    if row < 0 || row >= 64 || attempts[0].generation[row] != gen || attempts[0].epoch[row] != epoch || attempts[0].retiring[row] { return false; }
    attempts[0].retiring[row] = true;
  }
  sw_host_ack(); sw_host_trace_ack(); return true;
}
swr_snapshot :: (trace: Jv, record: int, source: [] SwReplaySources, snapshots: [] SwReplaySnapshots) -> bool {
  list := jv_get(trace, 0, "sourceSnapshots"); count := jv_len(trace, list);
  if count > RECORDED_SOURCE_EVENTS { return false; }
  row := swr_word(trace, jv_at(trace, record, 2)); gen := swr_word(trace, jv_at(trace, record, 3)); epoch := swr_word(trace, jv_at(trace, record, 4)); found := -1;
  for i: 0..<count {
    item := jv_at(trace, list, i);
    if swr_word(trace, jv_get(trace, item, "owner")) == row && swr_word(trace, jv_get(trace, item, "generation")) == gen && swr_word(trace, jv_get(trace, item, "epoch")) == epoch {
      if found >= 0 || snapshots[0].used[i] { return false; } found = i;
    }
  }
  // Historical valid-source histories have no captured exception payload.
  if found < 0 { return true; }
  identity: assets.AssetId; for word: 0..<8 { identity.words[word] = cast(u32) swr_word(trace, jv_at(trace, record, word + 15)); }
  item := jv_at(trace, list, found); text: [RECORDED_SOURCE_MAX * 2] u8; bytes: [RECORDED_SOURCE_MAX] u8;
  n := jv_str(trace, jv_get(trace, item, "hex"), text[..]); if n < 0 { return false; }
  if recorded_source(cast(string) text[0..<n], identity, source[0].count[row], bytes[..]) != RecordedSourceStatus.ok { return false; }
  if !sw_sdk_copy(row, gen, epoch, bytes[0..<source[0].count[row]]) { return false; }
  // Match the retained source/decoder attempt. Failed effects keep their
  // recorded completion status; the shared gate still decides publication.
  decoded := sw_host_decode(cast(s32) row, gen, epoch);
  if decoded != 0 && swr_word(trace, jv_at(trace, record, 5)) == 0 { return false; }
  snapshots[0].used[found] = true; return true;
}
swr_frame :: (trace: Jv, frame: int, closing: bool, native: bool, failure: bool, source: [] SwReplaySources, attempts: [] SwReplayAttempts, snapshots: [] SwReplaySnapshots, observed: [] u8, used: [] int) -> bool {
  object := closing || native;
  records := ifx object then jv_get(trace, frame, "records") else jv_at(trace, frame, 13);
  for i: 0..<jv_len(trace, records) {
    record := jv_at(trace, records, i); if jv_len(trace, record) != 23 { return false; }
    kind := swr_word(trace, jv_at(trace, record, 1)); if kind == 2 { continue; }
    row := swr_word(trace, jv_at(trace, record, 2)); gen := swr_word(trace, jv_at(trace, record, 3)); epoch := swr_word(trace, jv_at(trace, record, 4));
    if row < 0 || row >= 64 || attempts[0].generation[row] != gen || attempts[0].epoch[row] != epoch { return false; }
    if kind == 0 {
      if !swr_snapshot(trace, record, source, snapshots) { return false; }
      status := cast(s32) swr_word(trace,jv_at(trace,record,5));
      if failure || attempts[0].sdk_case >= 0 {
        if cast(int) status != attempts[0].failed[row] || sw_host_finish_code(cast(s32) row,gen,epoch,status) != 1 { return false; }
      } else if sw_host_finish(cast(s32) row,gen,epoch,status) != 1 { return false; }
    } else if kind == 1 {
      if !attempts[0].retiring[row] || sw_host_destroy(cast(s32) row, gen, epoch) != 1 { return false; }
      attempts[0].generation[row] = 0; attempts[0].retiring[row] = false; attempts[0].failed[row] = 0;
    } else { return false; }
  }
  ns := swr_word(trace, ifx object then jv_get(trace, frame, "frameNs") else jv_at(trace, frame, 0));
  direction := f32(swr_number(trace, ifx object then jv_get(trace, frame, "direction") else jv_at(trace, frame, 1)));
  tick := swr_word(trace, ifx object then jv_get(trace, frame, "tick") else jv_at(trace, frame, 2));
  if sw_host_frame(ns, direction) != 1 || sw_host_info(0) != tick || sw_host_info(3) != jv_len(trace, records) { print("frame header differs at tick %\n", tick); return false; }
  digest_text: [4096] u8;
  digest_count := sw_host_step_count();
  if object {
    expected_digests := jv_get(trace, frame, "stepDigests");
    if jv_len(trace, expected_digests) != cast(int) digest_count { return false; }
    for step: 0..<cast(int) digest_count { if jv_str(trace, jv_at(trace, expected_digests, step), digest_text[step * 64..<step * 64 + 64]) != 64 { return false; } }
  } else if jv_str(trace, jv_at(trace, frame, 14), digest_text[..]) != cast(int) digest_count * 64 { return false; }
  for step: 0..<cast(int) digest_count {
    actual: assets.AssetId; hex: [64] u8;
    for word: 0..<8 { actual.words[word] = cast(u32) sw_host_step_word(cast(s32) step, cast(s32) word); }
    #assert assets.asset_hex(actual, hex[..]);
    if cast(string) hex[..] != cast(string) digest_text[step * 64..<step * 64 + 64] { print("canonical state differs at paid tick %\n", tick - cast(int) digest_count + step + 1); return false; }
    if used[0] > observed.count - 64 { return false; }
    for byte, i: hex { observed[used[0] + i] = byte; } used[0] += 64;
  }
  for i: 0..<jv_len(trace, records) { for field: 0..<23 {
    expected := swr_word(trace, jv_at(trace, jv_at(trace, records, i), field)); actual := sw_host_record(cast(s32) i, cast(s32) field);
    if actual != expected { print("record tick % event % field % expected % actual %\n", tick, i, field, expected, actual); return false; }
    if used[0] > observed.count - 8 { return false; } resource_put64(observed, used[0], actual); used[0] += 8;
  } }
  for axis: 0..<3 {
    expected := ifx native then swr_word(trace, jv_at(trace, jv_get(trace, frame, "positionBits"), axis)) else cast(int) f32_bits(f32(swr_number(trace, ifx closing then jv_at(trace, jv_get(trace, frame, "position"), axis) else jv_at(trace, frame, 3 + axis))));
    actual := sw_host_player(cast(s32) axis); if cast(int) f32_bits(actual) != expected { print("position bits tick % axis % expected % actual %\n", tick, axis, expected, f32_bits(actual)); return false; }
    if used[0] > observed.count - 8 { return false; } resource_put64(observed, used[0], cast(int) f32_bits(actual)); used[0] += 8;
  }
  if !closing {
    for field: 0..<4 {
      index := ifx field == 3 then 8 else field + 4;
      actual := sw_host_info(cast(s32) index); expected := swr_word(trace, jv_at(trace, ifx native then jv_get(trace, frame, "info") else frame, ifx native then index else field + 6));
      if actual != expected { print("state tick % field % expected % actual %\n", tick, field, expected, actual); return false; }
    }
  }
  if sw_host_info(14) > sw_host_info(10) { return false; }
  return swr_effects(source, attempts, failure);
}
swr_pressure :: (scene: Jv, dir: string, trace: Jv) -> bool {
  item := jv_get(trace, 0, "categoryPressure"); name: [64] u8;
  n := jv_str(trace, jv_get(trace, item, "schema"), name[..]);
  if n < 0 || cast(string) name[0..<n] != "aethyr.stream-category-pressure.v1" { return false; }
  source: [4096] u8; count := scp_read(scene, dir, source[..]); if count < 1 { return false; }
  words: [31] int; manifest: [488] u8; hashes: [320] u8;
  if !sw_sdk_pressure(source[0..<count], words[..], manifest[..], hashes[..]) { return false; }
  // CPU replay verifies the input's pixel verdict; only the actual GPU
  // qualifier/readback oracle establishes those pixels.
  expected := jv_get(trace, item, "words"); if jv_len(trace, expected) != 13 || swr_word(trace, jv_at(trace, expected, 11)) != 1 { return false; }
  words[11] = 1; if !scp_accept(words[0..<13]) { return false; }
  for word, i: words[0..<13] { if swr_word(trace, jv_at(trace, expected, i)) != word { return false; } }
  before := jv_get(trace, item, "before"); after := jv_get(trace, item, "after");
  if jv_len(trace, before) != 9 || jv_len(trace, after) != 9 { return false; }
  for i: 0..<9 {
    previous := swr_word(trace, jv_at(trace, before, i)); next := swr_word(trace, jv_at(trace, after, i)); if previous != next { return false; }
    // Fixed display/HUD grants and their slot generations are GPU effects.
    if i != 5 && i != 6 { if previous != words[13 + i] || next != words[22 + i] { return false; } }
  }
  for key, i: [5] string.["manifestSHA256", "sourceSHA256", "stateBefore", "stateAfter", "stateNormalized"] {
    if jv_str(trace, jv_get(trace, item, key), name[..]) != 64 || cast(string) name[..] != cast(string) hashes[i * 64..<i * 64 + 64] { return false; }
  }
  return true;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) != 3 { tool_errln("usage: stream-walk-replay SCENE_DIR TRACE_JSON OUTPUT_JSON"); return 2; }
  path: [4096] u8; scene_bytes: [65536] u8; scene: [1] Jv; scene_nodes: [4096] JvNode;
  n := fs_read(fs_join(args_at(a[..], 0), "scene.json", path[..]), scene_bytes[..]);
  if n < 1 || !jv_parse(scene[..], cast(string) scene_bytes[0..<n], scene_nodes[..]) { return 1; }
  sources: [1] SwReplaySources; if !swr_sources(scene[0], args_at(a[..], 0), sources[..]) { return 1; }
  bytes: [4194304] u8; d: [1] Jv; nodes: [524288] JvNode;
  trace_n := fs_read(args_at(a[..], 1), bytes[..]); if trace_n < 1 || !jv_parse(d[..], cast(string) bytes[0..<trace_n], nodes[..]) { return 1; }
  captured := jv_get(d[0], 0, "sourceSnapshots");
  if captured >= 0 || jv_get(d[0], 0, "sourceSchema") >= 0 {
    name: [64] u8; size := jv_str(d[0], jv_get(d[0], 0, "sourceSchema"), name[..]);
    if size < 0 || jv_kind(d[0], captured) != JV_ARRAY || !recorded_source_profile(cast(string) name[0..<size], jv_len(d[0], captured)) { return 1; }
  }
  native := jv_get(d[0], 0, "backend") >= 0;
  pressure := false; failure := false;sdk_fault := false;backing:=false;
  if native {
    schema: [64] u8; size := jv_str(d[0], jv_get(d[0], 0, "schema"), schema[..]);
    if size<0 {return 1;}backing=cast(string) schema[0..<size]=="aethyr.stream-walk-native-gpu.v7";
    observation:[64]u8;on:=jv_str(d[0],jv_get(d[0],0,"observationSchema"),observation[..]);if on<0 {on=0;}
    resolved:=srp_observation(cast(string) schema[0..<size],cast(string) observation[0..<on],jv_get(d[0],0,"backing")>=0);
    if !srp_native(resolved,jv_int(d[0],jv_get(d[0],0,"backend"),-1)) {return 1;}
    pressure = resolved == "aethyr.stream-walk-native-gpu.v4";
    if !srp_pressure(resolved, jv_get(d[0], 0, "categoryPressure") >= 0) { return 1; }
    failure = resolved == "aethyr.stream-walk-native-gpu.v5";
    if !srp_failure(resolved,jv_get(d[0],0,"loadFailure") >= 0) { return 1; }
    sdk_fault = resolved == "aethyr.stream-walk-native-gpu.v6";
    if !srp_sdk(resolved,jv_get(d[0],0,"sdkFault") >= 0) { return 1; }
  }
  profile := ifx native then 0 else jv_get(d[0], 0, "profile"); tier := ifx profile < 0 then 0 else jv_int(d[0], jv_get(d[0], profile, "tier"), -1);
  schema: [64] u8; schema_n := jv_str(d[0], jv_get(d[0], profile, "stateSchema"), schema[..]);
  if !native && (schema_n != 27 || cast(string) schema[0..<schema_n] != "aethyr.stream-walk-state.v1") { return 1; }
  if tier < 0 || tier > 1 { return 1; }
  item := jv_at(scene[0], jv_get(scene[0], 0, "manifests"), tier + (ifx native then 2 else 0)); root: [64] u8; name: [128] u8; manifest_bytes: [32768] u8;
  if jv_str(scene[0], jv_get(scene[0], item, "sha256"), root[..]) != 64 { return 1; }
  if profile >= 0 { pinned: [64] u8;
    if jv_str(d[0], jv_get(d[0], profile, ifx native then "manifestSHA256" else "manifestSHA"), pinned[..]) != 64 || cast(string) pinned[..] != cast(string) root[..] { return 1; }
    if jv_str(d[0], jv_get(d[0], profile, ifx native then "sceneSHA256" else "sceneSHA"), pinned[..]) != 64 || !sw_auth(scene_bytes[0..<n], cast(string) pinned[..]) { return 1; }
  }
  n = fs_read(fs_join(args_at(a[..], 0), swr_name(cast(string) root[..], ".rcm", name[..]), path[..]), manifest_bytes[..]);
  if n < 1 || !sw_sdk_start(manifest_bytes[0..<n], root[..], tier, ifx native then 1 else 0) { return 1; }
  if backing && !swr_backing(d[0],manifest_bytes[0..<n]) {tool_errln("backing observation replay differs");return 1;}
  failure_words: [10] int;
  if failure {
    entry := jv_get(d[0],0,"loadFailure"); words := jv_get(d[0],entry,"effect"); label: [128] u8;
    size := jv_str(d[0],jv_get(d[0],entry,"schema"),label[..]);
    if size < 0 || cast(string) label[0..<size] != "aethyr.stream-native-load-failure.v1" || jv_len(d[0],words) != 10 { return 1; }
    size = jv_str(d[0],jv_get(d[0],entry,"qualification"),label[..]);
    if size < 0 || cast(string) label[0..<size] != "explicit allocator/source/scratch effect input; no physical OS exhaustion" { return 1; }
    for i: 0..<10 { failure_words[i] = swr_word(d[0],jv_at(d[0],words,i)); }
    which := jv_int(d[0],jv_get(d[0],entry,"case"),-1);
    if !nlf_effect(which,failure_words[..]) || sw_fault_open(cast(s32) failure_words[0],cast(s32) failure_words[1]) != 1 { return 1; }
  }
  attempts: [1] SwReplayAttempts; snapshots: [1] SwReplaySnapshots; observed: [1048576] u8; used: [1] int;
  if sdk_fault {
    entry := jv_get(d[0],0,"sdkFault");label: [128] u8;
    size := jv_str(d[0],jv_get(d[0],entry,"schema"),label[..]);if size < 0 || cast(string) label[0..<size] != "aethyr.stream-native-sdk-fault.v1" { return 1; }
    size = jv_str(d[0],jv_get(d[0],entry,"qualification"),label[..]);if size < 0 || cast(string) label[0..<size] != "scoped SDK error inputs over real Vulkan effects; no physical exhaustion or reset" { return 1; }
    which := jv_int(d[0],jv_get(d[0],entry,"case"),-1);words := jv_get(d[0],entry,"words");if jv_len(d[0],words) != 26 { return 1; }
    for i: 0..<26 { attempts[0].sdk[i] = swr_word(d[0],jv_at(d[0],words,i)); }
    if !nsf_effect(which,attempts[0].sdk[..]) { return 1; }attempts[0].sdk_case = which;
    stop := jv_get(d[0],entry,"stop");before: [64] u8;after: [64] u8;
    bn := jv_str(d[0],jv_get(d[0],entry,"sourceBefore"),before[..]);an := jv_str(d[0],jv_get(d[0],entry,"sourceAfter"),after[..]);
    policy := jv_get(d[0],entry,"policy");if jv_len(d[0],policy) != 7 { return 1; }
    if nsf_domain(which) == 4 {
      values: [24] int;if jv_len(d[0],stop) != 24 { return 1; }for i: 0..<24 { values[i] = swr_word(d[0],jv_at(d[0],stop,i)); }
      if !nsf_stop(which,values[..]) || bn != 64 || an != 64 || cast(string) before[..] != cast(string) after[..] || !jv_bool(d[0],jv_get(d[0],entry,"stoppedFrameRefused")) { return 1; }
      for i: 0..<3 { if values[i] != attempts[0].sdk[i + 5] { return 1; } }
      if swr_word(d[0],jv_at(d[0],policy,1)) != 1 || swr_word(d[0],jv_at(d[0],policy,5)) != nsf_reason(which) { return 1; }
      attempts[0].sdk_source = before;
    }else if jv_len(d[0],stop) != 0 || bn != 0 || an != 0 || jv_bool(d[0],jv_get(d[0],entry,"stoppedFrameRefused")) || swr_word(d[0],jv_at(d[0],policy,1)) != 0 || swr_word(d[0],jv_at(d[0],policy,5)) != 0 { return 1; }
    if nsf_domain(which) == 1 && sw_fault_open_at(1,4,cast(s32) attempts[0].sdk[5]) != 1 { return 1; }
  }
  frames := jv_get(d[0], 0, ifx native then "warmup" else "frames"); route := ifx native then jv_get(d[0], 0, "route") else -1;
  count := jv_len(d[0], frames) + jv_len(d[0], route);
  if count < 1 { return 1; }
  if jv_len(d[0], jv_get(d[0], 0, "sourceSnapshots")) > RECORDED_SOURCE_EVENTS { return 1; }
  for list, phase: [2] int.[frames, route] {
    if phase == 1 && pressure && !swr_pressure(scene[0], args_at(a[..], 0), d[0]) { tool_errln("category-pressure replay differs"); return 1; }
    for i: 0..<jv_len(d[0], list) { if !swr_frame(d[0], jv_at(d[0], list, i), false, native, failure, sources[..], attempts[..], snapshots[..], observed[..], used[..]) { print("replay failed at frame %\n", i); return 1; } }
  }
  // Native observer has made no GPU SDK objects. Existing ledger handles
  // are exercised by the shared owner; no GPU presentation is claimed.
  legs := jv_get(d[0], 0, "legs"); expected_cells := jv_get(d[0], jv_at(d[0], legs, jv_len(d[0], legs) - 1), "cells");
  if native { expected_cells = jv_at(d[0], jv_get(d[0], 0, "routeCells"), 1); }
  if jv_len(d[0], expected_cells) != 12 { return 1; }
  for cell: 0..<12 { for field: 0..<5 { if sw_host_cell(cast(s32) cell, cast(s32) field) != swr_word(d[0], jv_at(d[0], jv_at(d[0], expected_cells, cell), field)) { return 1; } } }
  if sw_host_close() != 1 { return 1; }
  closing := ifx native then jv_get(d[0], 0, "cleanup") else jv_path(d[0], 0, "cleanup.closingFrames");
  for i: 0..<jv_len(d[0], closing) { if !swr_frame(d[0], jv_at(d[0], closing, i), true, native, failure, sources[..], attempts[..], snapshots[..], observed[..], used[..]) { print("closing replay failed at frame %\n", i); return 1; } }
  if failure { for word,i: failure_words { if word != sw_fault_info(cast(s32) i) { return 1; } } }
  if sdk_fault && !attempts[0].sdk_seen { return 1; }
  for i: 0..<jv_len(d[0], jv_get(d[0], 0, "sourceSnapshots")) { if !snapshots[0].used[i] { return 1; } }
  for field: [7] s32.[8, 10, 11, 12, 14, 22, 23] { if sw_host_info(field) != 0 { print("cleanup field % remains %\n", field, sw_host_info(field)); return 1; } }
  if sw_host_info(24) != 1 || sw_host_info(20) != sw_host_info(21) { return 1; }
  hex: [64] u8; report: [4096] u8; j: [1] Jo; jo_start(j[..], report[..]); jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], ifx native then "aethyr.stream-walk-native-replay.v3" else "aethyr.stream-walk-native-replay.v2"); jo_key(j[..], "frames"); jo_int(j[..], count);
  if native { jo_key(j[..], "backend"); jo_int(j[..], 1); }
  jo_key(j[..], "tier"); jo_int(j[..], tier);
  jo_key(j[..], "ticks"); jo_int(j[..], sw_host_info(0)); jo_key(j[..], "attempts"); jo_int(j[..], sw_host_info(20));
  jo_key(j[..], "cpu_peak"); jo_int(j[..], sw_host_info(15)); jo_key(j[..], "input_sha256"); #assert assets.asset_hex(assets.asset_id(cast(string) bytes[0..<trace_n]), hex[..]); jo_str(j[..], cast(string) hex[..]);
  jo_key(j[..], "observation_sha256"); #assert assets.asset_hex(assets.asset_id(cast(string) observed[0..<used[0]]), hex[..]); jo_str(j[..], cast(string) hex[..]);
  jo_key(j[..], "state_schema"); jo_str(j[..], "aethyr.stream-walk-state.v1");
  jo_key(j[..], "source_schema"); jo_str(j[..], ifx captured >= 0 then RECORDED_SOURCE_SCHEMA else "");
  jo_key(j[..], "captured_sources"); jo_int(j[..], jv_len(d[0], captured));
  jo_key(j[..], "qualified"); jo_str(j[..], "native CPU codecs and malloc/free; canonical state SHA-256 after each paid step, exact completion records and final actor identities; no native GPU"); jo_end(j[..]);
  if j[0].bad || !fs_write(args_at(a[..], 2), jo_text(j[..])) { return 1; }
  print("PASS native replay % frames, % attempts, final zero owners\n", count, sw_host_info(20)); return 0;
}
