#authority;
#test "real SDK transaction observations require every field and exact extent" {
 rows:=[100]int.[1,1,1,1,2,0,1,0,3,1,10,282769029,4,1,2,0,5,0,0,1,6,0,1,0,7,0,1,0,8,0,1,0,9,0,0,1,10,3,0,0,11,0,1,0,12,1,9,905803252,13,0,1,1,14,0,1,1,15,0,0,1,16,0,0,1,17,0,1,1,18,0,0,1,19,0,2097152,0,20,0,1,1,21,1,7,0,22,7,1,3,23,1,0,3,24,3,6,0,25,0,1,1];
 long:[101]int;#assert hwtc_accept(rows[..])&&!hwtc_accept(rows[0..<99])&&!hwtc_accept(long[..]);
 for i:0..<rows.count{rows[i]+=1;#assert !hwtc_accept(rows[..]);rows[i]-=1;}
}
hwtc_accept::(rows:[]int)->bool #export_c {
 expected:=[100]int.[
 1,1,1,1, 2,0,1,0, 3,1,10,282769029, 4,1,2,0, 5,0,0,1,
 6,0,1,0, 7,0,1,0, 8,0,1,0, 9,0,0,1, 10,3,0,0,
 11,0,1,0, 12,1,9,905803252, 13,0,1,1, 14,0,1,1, 15,0,0,1,
 16,0,0,1, 17,0,1,1, 18,0,0,1, 19,0,2097152,0, 20,0,1,1,
 21,1,7,0, 22,7,1,3, 23,1,0,3, 24,3,6,0, 25,0,1,1];
 if rows.count!=expected.count{return false;}for value,i:expected{if rows[i]!=value{return false;}}return true;
}
#test "window callbacks cancel real compose on every ownership boundary" {
 rows:=[24]int.[1,0,1,1,2,0,1,1,3,0,1,1,4,0,1,1,5,0,0,0,6,1,1,1];long:[25]int;
 #assert hwtc_window_accept(rows[..])&&!hwtc_window_accept(rows[0..<23])&&!hwtc_window_accept(long[..]);
 for i:0..<rows.count{rows[i]+=1;#assert !hwtc_window_accept(rows[..]);rows[i]-=1;}
}
hwtc_window_accept::(rows:[]int)->bool #export_c {
 expected:=[24]int.[1,0,1,1,2,0,1,1,3,0,1,1,4,0,1,1,5,0,0,0,6,1,1,1];if rows.count!=expected.count{return false;}for value,i:expected{if rows[i]!=value{return false;}}return true;
}
