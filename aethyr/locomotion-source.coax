// Scalar ground velocity path ported from installed UE 5.8 CharacterMovementComponent
// CalcVelocity/ApplyVelocityBraking, in metres. Aethyr retains collision and its paid fixed steps.
#module "aethyr.locomotion.source";
#authority;
#load "tests/locomotion-source-oracle.coax";
SourceVelocity :: struct {x:f32;z:f32;}
#test "source velocity accelerates brakes turns and never reverses while stopping" {
 a:=source_velocity(0,0,0,1,1,4.27,5,4,10,2,1.0/64.0);#assert a.x==0 && a.z==0.078125;
 b:=source_velocity(0,4.27,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert abs(b.z-3.58)<0.000001;
 c:=source_velocity(1,0,0,1,1,4.27,5,4,10,2,1.0/64.0);#assert c.x==0.9375 && c.z==0.140625;
 d:=source_velocity(0,0.15,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert d.x==0 && d.z==0;
 e:=source_velocity(0.2,0.3,0,0,0,4.27,0,0,0,2,1.0/64.0);#assert e.x==0.2 && e.z==0.3;
 g:=source_velocity(1,0,0,1,1,4.27,5,128,10,2,1.0/64.0);#assert g.x==0 && g.z==1.078125;
 f:=source_velocity(0,4.27,0,1,1,1.47,5,4,10,2,1.0/64.0);#assert abs(f.z-3.58)<0.000001;
}
#forall "source acceleration respects speed cap and braking approaches zero" angle:0..<8, count:1..<65 {
 x:=sin(cast(f32)angle);z:=cos(cast(f32)angle);v:=SourceVelocity.{};
 for k:0..<count {v=source_velocity(v.x,v.z,x,z,1,4.27,5,4,10,2,1.0/64.0);}#assert v.x*v.x+v.z*v.z<=4.27*4.27+0.00001;
 before:=v.x*v.x+v.z*v.z;v=source_velocity(v.x,v.z,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert v.x*v.x+v.z*v.z<=before;
}
#test "source strict comparisons retain equality unordered and signed boundaries" {
 #assert source_gt(1,0) && !source_gt(0,0) && !source_gt(-1,0);
 #assert source_lt(-1,0) && !source_lt(0,0) && !source_lt(1,0);
 #assert source_le(-1,0) && source_le(0,0) && !source_le(1,0);
 nan:=0.0f32/0.0f32;#assert !source_gt(nan,0) && !source_lt(nan,0) && !source_le(nan,0);
}
#test "source braking distinguishes overshoot tiny motion and the brake threshold" {
 a:=source_velocity(0,0.15,0,0,0,4.27,0,0,100,0,1.0/64.0);#assert a.z==0;
 b:=source_velocity(0,0.00001,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert b.z==0;
 c:=source_velocity(0,0.05,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert c.z==0.05;
 d:=source_velocity(0,0.05,0,0,0,4.27,0,0,0.000001,0,1.0/64.0);#assert d.z==0;
 e:=source_velocity(0,0,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert e.x==0 && e.z==0;
 f:=source_velocity(0,1.5,0,1,1,1.47,5,4,10,2,1.0/64.0);#assert f.z==1.47;
}
source_gt :: (a:f32,b:f32)->bool {return a>b;}
source_lt :: (a:f32,b:f32)->bool {return a<b;}
source_le :: (a:f32,b:f32)->bool {return a<=b;}
source_velocity :: (x:f32,z:f32,dx:f32,dz:f32,amount:f32,speed:f32,accel:f32,friction:f32,brake:f32,factor:f32,dt:f32)->SourceVelocity {
 v:=SourceVelocity.{x=x,z=z};old:=v;old_size:=sqrt(x*x+z*z);maximum:=speed*amount;ax:=dx*accel*amount;az:=dz*accel*amount;zero:=ax==0 && az==0;over:=source_gt(old_size*old_size,maximum*maximum*1.01);
 if zero || over {if source_gt(old_size,0) {v.x+=(0-friction*factor*v.x-brake*x/old_size)*dt;v.z+=(0-friction*factor*v.z-brake*z/old_size)*dt;
  threshold:=ifx source_gt(brake,0) then 0.01f32 else 0.00000001f32;
  if source_lt(v.x*x+v.z*z,0) || source_le(v.x*v.x+v.z*v.z,threshold) {v=SourceVelocity.{};}
  if over && source_lt(v.x*v.x+v.z*v.z,maximum*maximum) && source_gt(ax*old.x+az*old.z,0) {v.x=x/old_size*maximum;v.z=z/old_size*maximum;}
 }}else {share:=ifx source_gt(friction*dt,1) then 1.0f32 else friction*dt;v.x-=(v.x-dx*old_size)*share;v.z-=(v.z-dz*old_size)*share;}
 if !zero {now:=sqrt(v.x*v.x+v.z*v.z);limit:=ifx source_gt(now*now,maximum*maximum*1.01) then now else maximum;v.x+=ax*dt;v.z+=az*dt;size:=sqrt(v.x*v.x+v.z*v.z);if source_gt(size,limit) {v.x=v.x/size*limit;v.z=v.z/size*limit;}}
 return v;
}
