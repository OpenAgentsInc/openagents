// A murmuration: a deterministic, seekable flock simulation for films (GitHub #13009, phase F5
// of docs/research/vork/2026-11-07-desktop-film-renderer.md). vork's million-bird example
// gives the pattern, and this file keeps it as four kernels over flat buffers:
//   clear    every cell of a G^3 grid forgets its birds
//   grid     each cell keeps its four lowest-numbered birds as representatives
//   advance  each bird picks its 7 nearest among at most 108 candidates (the 4 representatives
//            of the 27 cells around it), steers by them, and writes the next generation to
//            scratch; it reads only the old generation
//   place    scratch becomes the state
// One step is 1/60 s whatever the render rate. Each kernel is a per-index function of the
// buffers, so a GPU dispatch (coax spirv --kernel) computes the same thing; the CPU loop here
// is the reference it is checked against.
//
// A simulation record (MurmurSim) holds t0, the fixed step, the seed and the state, plus
// bounded checkpoints. Seeking to step k restores the last checkpoint at or before k and steps
// on from it, so a film can start at any frame and get the same birds as stepping from S0
// (the digest is the same). Time is whole nanoseconds, as aethyr/loop.coax keeps it.
#module "aethyr.murmur";
#load "rand.coax";

MURMUR_MAX :: 4096;            // birds a record holds at most
MURMUR_SIDE :: 16;             // cells a side at most (the film's 32 needs a GPU buffer)
MURMUR_REPS :: 4;              // representatives a cell keeps
MURMUR_NEAR :: 7;              // neighbours a bird steers by
MURMUR_CHECKPOINTS :: 8;
MURMUR_STEP_NS :: 16666667;    // 1/60 s, rounded to the nanosecond
MURMUR_STEP :: 0.016666667f32;
MURMUR_SPEED :: 12.0f32;       // metres a second, the most
MURMUR_MIN_SPEED :: 4.0f32;
MURMUR_APART :: 1.2f32;        // nearer than this, birds push apart
MURMUR_HOME :: 0.4f32;         // the pull back toward the middle, per metre out past the radius
MURMUR_STREAM :: 11;           // aethyr/rand.coax stream of the start positions

MurmurState :: struct {
  birds: int; side: int; cell: f32; radius: f32; step: int;
  px: [MURMUR_MAX] f32; py: [MURMUR_MAX] f32; pz: [MURMUR_MAX] f32;
  vx: [MURMUR_MAX] f32; vy: [MURMUR_MAX] f32; vz: [MURMUR_MAX] f32;
}
MurmurGrid :: struct {
  count: [MURMUR_SIDE * MURMUR_SIDE * MURMUR_SIDE] int;
  rep: [MURMUR_SIDE * MURMUR_SIDE * MURMUR_SIDE * MURMUR_REPS] int;
}
MurmurSim :: struct {
  t0_ns: int; step_ns: int; seed: int;
  state: [1] MurmurState; scratch: [1] MurmurState; grid: [1] MurmurGrid;
  every: int; kept: int; at: [MURMUR_CHECKPOINTS] int; saved: [MURMUR_CHECKPOINTS] MurmurState;
}
MurmurRefusal :: enum u8 { ok; birds; side; every; }

// Admission, before anything runs: the bird count, the grid and the checkpoint spacing.
murmur_admit :: (birds: int, side: int, every: int) -> MurmurRefusal {
  if birds < 1 || birds > MURMUR_MAX { return MurmurRefusal.birds; }
  if side < 3 || side > MURMUR_SIDE { return MurmurRefusal.side; }
  if every < 1 { return MurmurRefusal.every; }
  return MurmurRefusal.ok;
}

// init: bird i's start, a pure function of the seed and i.
murmur_init :: (s: []MurmurState, seed: int, i: int) {
  r := s[0].radius;
  s[0].px[i] = (rand_unit(seed, MURMUR_STREAM, i * 6) * 2 - 1) * r;
  s[0].py[i] = (rand_unit(seed, MURMUR_STREAM, i * 6 + 1) * 2 - 1) * r * 0.5f32;
  s[0].pz[i] = (rand_unit(seed, MURMUR_STREAM, i * 6 + 2) * 2 - 1) * r;
  s[0].vx[i] = 6 + rand_unit(seed, MURMUR_STREAM, i * 6 + 3) * 2;
  s[0].vy[i] = rand_unit(seed, MURMUR_STREAM, i * 6 + 4) - 0.5f32;
  s[0].vz[i] = rand_unit(seed, MURMUR_STREAM, i * 6 + 5) * 2 - 1;
}
// The cell a position falls in: the grid covers [-side*cell/2, side*cell/2) and clamps.
murmur_axis :: (v: f32, side: int, cell: f32) -> int {
  k := cast(int) floor(v / cell + cast(f32) side * 0.5f32);
  return ifx k < 0 then 0 else ifx k >= side then side - 1 else k;
}
murmur_cell :: (s: []MurmurState, i: int) -> int {
  n := s[0].side; c := s[0].cell;
  return (murmur_axis(s[0].pz[i], n, c) * n + murmur_axis(s[0].py[i], n, c)) * n + murmur_axis(s[0].px[i], n, c);
}
// clear: cell c holds no birds.
murmur_clear :: (g: []MurmurGrid, c: int) { g[0].count[c] = 0; }
// grid: bird i joins its cell if it is among the cell's four lowest numbers. Taken in order of
// i, the first four are the four lowest; a GPU keeps the same four with an atomic minimum.
murmur_grid :: (s: []MurmurState, g: []MurmurGrid, i: int) {
  c := murmur_cell(s, i);
  if g[0].count[c] < MURMUR_REPS { g[0].rep[c * MURMUR_REPS + g[0].count[c]] = i; g[0].count[c] += 1; }
}
// advance: bird i's next velocity and position, from the old generation only, into scratch.
murmur_advance :: (s: []MurmurState, g: []MurmurGrid, out: []MurmurState, i: int) {
  n := s[0].side; c := s[0].cell;
  cx := murmur_axis(s[0].px[i], n, c); cy := murmur_axis(s[0].py[i], n, c); cz := murmur_axis(s[0].pz[i], n, c);
  near: [MURMUR_NEAR] int; d2: [MURMUR_NEAR] f32; found := 0;
  for dz: -1..<2 { for dy: -1..<2 { for dx: -1..<2 {
    x := cx + dx; y := cy + dy; z := cz + dz;
    if x >= 0 && x < n && y >= 0 && y < n && z >= 0 && z < n {
      cell := (z * n + y) * n + x;
      for r: 0..<g[0].count[cell] {
        j := g[0].rep[cell * MURMUR_REPS + r];
        if j != i {
          ex := s[0].px[j] - s[0].px[i]; ey := s[0].py[j] - s[0].py[i]; ez := s[0].pz[j] - s[0].pz[i];
          e := ex * ex + ey * ey + ez * ez;
          // keep the 7 nearest, ties to the lower number, in order
          k := ifx found < MURMUR_NEAR then found else MURMUR_NEAR;
          if k < MURMUR_NEAR || e < d2[k - 1] || (e == d2[k - 1] && j < near[k - 1]) {
            if k == MURMUR_NEAR { k -= 1; } else { found += 1; }
            while k > 0 && (d2[k - 1] > e || (d2[k - 1] == e && near[k - 1] > j)) { d2[k] = d2[k - 1]; near[k] = near[k - 1]; k -= 1; }
            d2[k] = e; near[k] = j;
          }
        }
      }
    }
  } } }
  vx := s[0].vx[i]; vy := s[0].vy[i]; vz := s[0].vz[i];
  if found > 0 {
    ax := 0.0f32; ay := 0.0f32; az := 0.0f32; mx := 0.0f32; my := 0.0f32; mz := 0.0f32; sx := 0.0f32; sy := 0.0f32; sz := 0.0f32;
    for k: 0..<found {
      j := near[k];
      ax += s[0].vx[j]; ay += s[0].vy[j]; az += s[0].vz[j];
      mx += s[0].px[j]; my += s[0].py[j]; mz += s[0].pz[j];
      if d2[k] < MURMUR_APART * MURMUR_APART && d2[k] > 0 {
        w := (MURMUR_APART - sqrt(d2[k])) / sqrt(d2[k]);
        sx -= (s[0].px[j] - s[0].px[i]) * w; sy -= (s[0].py[j] - s[0].py[i]) * w; sz -= (s[0].pz[j] - s[0].pz[i]) * w;
      }
    }
    f := 1.0f32 / cast(f32) found;
    vx += ((ax * f - vx) * 2.0f32 + (mx * f - s[0].px[i]) * 1.0f32 + sx * 8.0f32) * MURMUR_STEP;
    vy += ((ay * f - vy) * 2.0f32 + (my * f - s[0].py[i]) * 1.0f32 + sy * 8.0f32) * MURMUR_STEP;
    vz += ((az * f - vz) * 2.0f32 + (mz * f - s[0].pz[i]) * 1.0f32 + sz * 8.0f32) * MURMUR_STEP;
  }
  // home: past the radius, a pull back toward the middle
  out_r := sqrt(s[0].px[i] * s[0].px[i] + s[0].py[i] * s[0].py[i] * 4 + s[0].pz[i] * s[0].pz[i]);
  if out_r > s[0].radius {
    k := (out_r - s[0].radius) * MURMUR_HOME / out_r;
    vx -= s[0].px[i] * k * MURMUR_STEP * 10; vy -= s[0].py[i] * k * MURMUR_STEP * 40; vz -= s[0].pz[i] * k * MURMUR_STEP * 10;
  }
  speed := sqrt(vx * vx + vy * vy + vz * vz);
  if speed > MURMUR_SPEED { k := MURMUR_SPEED / speed; vx *= k; vy *= k; vz *= k; }
  else if speed < MURMUR_MIN_SPEED && speed > 0 { k := MURMUR_MIN_SPEED / speed; vx *= k; vy *= k; vz *= k; }
  out[0].vx[i] = vx; out[0].vy[i] = vy; out[0].vz[i] = vz;
  out[0].px[i] = s[0].px[i] + vx * MURMUR_STEP; out[0].py[i] = s[0].py[i] + vy * MURMUR_STEP; out[0].pz[i] = s[0].pz[i] + vz * MURMUR_STEP;
}
// place: scratch becomes the state.
murmur_place :: (s: []MurmurState, from: []MurmurState, i: int) {
  s[0].px[i] = from[0].px[i]; s[0].py[i] = from[0].py[i]; s[0].pz[i] = from[0].pz[i];
  s[0].vx[i] = from[0].vx[i]; s[0].vy[i] = from[0].vy[i]; s[0].vz[i] = from[0].vz[i];
}

// The four dispatches of one step, in order.
murmur_step :: (m: []MurmurSim) {
  st := m[0].state[..]; sc := m[0].scratch[..]; g := m[0].grid[..];
  n := st[0].side;
  for c: 0..<n * n * n { murmur_clear(g[..], c); }
  for i: 0..<st[0].birds { murmur_grid(st[..], g[..], i); }
  for i: 0..<st[0].birds { murmur_advance(st[..], g[..], sc[..], i); }
  for i: 0..<st[0].birds { murmur_place(st[..], sc[..], i); }
  st[0].step += 1;
  if st[0].step % m[0].every == 0 { murmur_keep(m); }
}
// Keep the state as a checkpoint; when all are used, double the spacing and keep the ones on
// it (S0 always is), so the checkpoints stay bounded and spread over the whole run.
murmur_keep :: (m: []MurmurSim) {
  if m[0].kept == MURMUR_CHECKPOINTS {
    m[0].every *= 2; k := 0;
    for i: 0..<MURMUR_CHECKPOINTS { if m[0].at[i] % m[0].every == 0 { m[0].at[k] = m[0].at[i]; m[0].saved[k] = m[0].saved[i]; k += 1; } }
    m[0].kept = k;
    if m[0].state[0].step % m[0].every != 0 { return; }
  }
  m[0].at[m[0].kept] = m[0].state[0].step; m[0].saved[m[0].kept] = m[0].state[0]; m[0].kept += 1;
}
// A new record: the birds at step 0 (S0), kept as the first checkpoint.
murmur_start :: (m: []MurmurSim, birds: int, side: int, cell: f32, seed: int, every: int, t0_ns: int) -> MurmurRefusal {
  why := murmur_admit(birds, side, every);
  if why != MurmurRefusal.ok { return why; }
  m[0].t0_ns = t0_ns; m[0].step_ns = MURMUR_STEP_NS; m[0].seed = seed; m[0].every = every; m[0].kept = 0;
  st := m[0].state[..];
  st[0].birds = birds; st[0].side = side; st[0].cell = cell; st[0].radius = cell * cast(f32) side * 0.35f32; st[0].step = 0;
  for i: 0..<birds { murmur_init(st[..], seed, i); }
  m[0].scratch[0] = st[0];
  m[0].at[0] = 0; m[0].saved[0] = st[0]; m[0].kept = 1;
  return MurmurRefusal.ok;
}
// Seek to step k: from the last checkpoint at or before k, step on. A seek back never steps
// from the current state, so the result is the same whatever was run before.
murmur_seek :: (m: []MurmurSim, k: int) {
  best := 0;
  for i: 0..<m[0].kept { if m[0].at[i] <= k && m[0].at[i] >= m[0].at[best] { best = i; } }
  if m[0].state[0].step > k || m[0].state[0].step < m[0].at[best] { m[0].state[0] = m[0].saved[best]; }
  while m[0].state[0].step < k { murmur_step_quiet(m); }
}
// A step that keeps no checkpoint: a seek replays, it does not reshape what is kept.
murmur_step_quiet :: (m: []MurmurSim) {
  every := m[0].every; m[0].every = 1 << 40; murmur_step(m); m[0].every = every;
}
// The step a film time falls in (whole nanoseconds from t0, steps of 1/60 s).
murmur_step_at :: (m: []MurmurSim, t_ns: int) -> int {
  d := t_ns - m[0].t0_ns;
  return ifx d <= 0 then 0 else d / m[0].step_ns;
}
murmur_mix :: (v: u32, h: u64) -> u64 {
  x := h;
  for b: 0..<4 { x = mul_wrap(x ^ cast(u64) ((v >> cast(u32) (8 * b)) & 255), cast(u64) 1099511628211); }
  return x;
}
// FNV-1a over the state's bits: positions and velocities of every bird, and the step.
murmur_digest :: (s: []MurmurState) -> u64 {
  h: u64 = 14695981039346656037;
  h = murmur_mix(cast(u32) s[0].step, h);
  for i: 0..<s[0].birds {
    h = murmur_mix(f32_bits(s[0].px[i]), h); h = murmur_mix(f32_bits(s[0].py[i]), h); h = murmur_mix(f32_bits(s[0].pz[i]), h);
    h = murmur_mix(f32_bits(s[0].vx[i]), h); h = murmur_mix(f32_bits(s[0].vy[i]), h); h = murmur_mix(f32_bits(s[0].vz[i]), h);
  }
  return h;
}

murmur_run :: (m: []MurmurSim, steps: int) { for k: 0..<steps { murmur_step(m); } }
#test "admission refuses before anything runs" {
  #assert murmur_admit(0, 8, 4) == MurmurRefusal.birds && murmur_admit(MURMUR_MAX + 1, 8, 4) == MurmurRefusal.birds;
  #assert murmur_admit(64, 2, 4) == MurmurRefusal.side && murmur_admit(64, MURMUR_SIDE + 1, 4) == MurmurRefusal.side;
  #assert murmur_admit(64, 8, 0) == MurmurRefusal.every && murmur_admit(64, 8, 4) == MurmurRefusal.ok;
}
#test "seeking to step k equals stepping from S0, forward, back and from a fresh record" #steps 400000000 {
  a: [1] MurmurSim; b: [1] MurmurSim;
  #assert murmur_start(a[..], 96, 6, 2.0, 7, 4, 0) == MurmurRefusal.ok;
  #assert murmur_start(b[..], 96, 6, 2.0, 7, 4, 0) == MurmurRefusal.ok;
  s0 := murmur_digest(a[0].state[..]);
  murmur_run(a[..], 45);
  d45 := murmur_digest(a[0].state[..]);
  murmur_run(a[..], 5);
  d50 := murmur_digest(a[0].state[..]);
  #assert d45 != s0 && d50 != d45;
  // the checkpoints stay bounded and spread: spacing doubled from 4
  #assert a[0].kept <= MURMUR_CHECKPOINTS && a[0].every > 4;
  murmur_seek(a[..], 45); #assert a[0].state[0].step == 45 && murmur_digest(a[0].state[..]) == d45;
  murmur_seek(a[..], 0); #assert murmur_digest(a[0].state[..]) == s0;
  murmur_seek(a[..], 50); #assert murmur_digest(a[0].state[..]) == d50;
  murmur_seek(b[..], 50); #assert murmur_digest(b[0].state[..]) == d50;
}
#test "the birds stay a flock: fast, apart and near home" #steps 400000000 {
  m: [1] MurmurSim;
  #assert murmur_start(m[..], 128, 8, 2.0, 3, 16, 0) == MurmurRefusal.ok;
  murmur_run(m[..], 120);
  s := m[0].state[..];
  for i: 0..<s[0].birds {
    v := sqrt(s[0].vx[i] * s[0].vx[i] + s[0].vy[i] * s[0].vy[i] + s[0].vz[i] * s[0].vz[i]);
    #assert v >= MURMUR_MIN_SPEED * 0.999f32 && v <= MURMUR_SPEED * 1.001f32;
    #assert abs(s[0].px[i]) < 16 && abs(s[0].py[i]) < 16 && abs(s[0].pz[i]) < 16;
  }
}
#test "the grid keeps each cell's four lowest-numbered birds, and a film time maps to its step" {
  m: [1] MurmurSim;
  #assert murmur_start(m[..], 200, 4, 2.0, 5, 8, 1000) == MurmurRefusal.ok;
  s := m[0].state[..]; g := m[0].grid[..];
  for c: 0..<64 { murmur_clear(g, c); }
  for i: 0..<200 { murmur_grid(s, g, i); }
  for c: 0..<64 {
    seen := 0;
    for i: 0..<200 {
      if murmur_cell(s, i) == c {
        if seen < MURMUR_REPS { #assert g[0].rep[c * MURMUR_REPS + seen] == i; }
        seen += 1;
      }
    }
    #assert g[0].count[c] == (ifx seen < MURMUR_REPS then seen else MURMUR_REPS);
  }
  #assert murmur_step_at(m[..], 1000) == 0 && murmur_step_at(m[..], 1000 + MURMUR_STEP_NS - 1) == 0;
  #assert murmur_step_at(m[..], 1000 + MURMUR_STEP_NS) == 1 && murmur_step_at(m[..], 1000 + 60 * MURMUR_STEP_NS) == 60;
}
