// Admitted semantic query snapshots. Geometry remains in query.coax; this
// boundary compacts eligible borrowed shapes in their original tie order.
#module "aethyr.query.scene";
#authority;
#load "query-filter.coax";
#load "../core/entity.coax" as entities;
#load "ground.coax" as terrain;
#load "../tests/query-semantic-fixture.coax" #test;

QUERY_HEIGHT_WORDS_MAX :: 65535;
QueryWorld :: struct {
  geometry: Colliders;
  metadata: [] QueryCollider;
  surfaces: [] PhysicalSurface;
  responses: [] SurfaceResponse;
  entity_store: entities.EntityStore;
  // The session owns this word. Publish/revoke changes it at a paid step.
  current_epoch: [] int;
  epoch: int;
  tick: int;
}
QueryScratch :: struct {
  boxes: [QUERY_METADATA_MAX * QUERY_BOX] f32;
  capsules: [QUERY_METADATA_MAX * QUERY_CAPSULE] f32;
  floors: [QUERY_METADATA_MAX * STAND_FLOATS] f32;
  fields: [QUERY_HEIGHTFIELDS_MAX] QueryHeightfield;
  metadata: [QUERY_METADATA_MAX] QueryCollider;
}
SelectedWorld :: struct {
  geometry: Colliders;
  metadata: [] QueryCollider;
  surfaces: [] PhysicalSurface;
  responses: [] SurfaceResponse;
  entity_store: entities.EntityStore;
  current_epoch: [] int;
  epoch: int;
  status: QueryStatus;
}
SemanticHit :: struct { geometry: QueryHit; collider: QueryCollider; }
SemanticGround :: struct { geometry: QueryGround; collider: QueryCollider; }
QueryPublication :: struct { world: QueryWorld; status: QueryStatus; }

#test "surface policy references resolve to admitted physical responses before publication" {
  b: [1] QueryFixture; w := query_fixture(b[..]);
  b[0].surfaces[0].friction_policy = 7;
  #assert query_world_status(w) == QueryStatus.invalid;
  responses := [2] SurfaceResponse.[SurfaceResponse.{id = 7, friction = 0.25}, SurfaceResponse.{id = 8, restitution = 0.5}];
  w.responses = responses[..]; #assert query_world_status(w) == QueryStatus.ok;
  b[0].surfaces[0].restitution_policy = 9; #assert query_world_status(w) == QueryStatus.invalid;
  b[0].surfaces[0].restitution_policy = 8; #assert query_world_status(w) == QueryStatus.ok;
  scratch: [1] QueryScratch; s := query_select_world(w, QueryFilter.{}, scratch[..]);
  #assert s.responses.count == 2 && s.responses[0].friction == 0.25 && s.responses[1].restitution == 0.5;
  #assert query_response_index(responses[..], 7) == 0 && query_response_index(responses[..], 9) == -1;
  b[0].surfaces[0].restitution_policy = 7; #assert query_world_status(w) == QueryStatus.ok;
  responses[0].id = 0; #assert !query_responses_ok(responses[..]) && query_world_status(w) == QueryStatus.invalid;
  responses[0].id = 8; #assert !query_responses_ok(responses[..]) && query_world_status(w) == QueryStatus.invalid;
  responses[0].id = 7; responses[0].friction = -0.1; #assert query_world_status(w) == QueryStatus.invalid;
  responses[0].friction = 16.1; #assert query_world_status(w) == QueryStatus.invalid;
  responses[0].friction = 0; #assert query_world_status(w) == QueryStatus.ok;
  responses[0].friction = 16; responses[0].restitution = 1; #assert query_world_status(w) == QueryStatus.ok;
  responses[0].restitution = -0.1; #assert query_world_status(w) == QueryStatus.invalid;
  responses[0].restitution = 1.1; #assert query_world_status(w) == QueryStatus.invalid;
  all: [65] SurfaceResponse;
  for i: 0..<65 { all[i].id = i + 1; }
  #assert query_responses_ok(all[0..<64]) && !query_responses_ok(all[..]);
}

#test "all shape families keep geometry, source indices and stable identities after compaction" {
  b: [1] QueryMixedFixture; w := query_mixed_fixture(b[..]); scratch: [1] QueryScratch;
  #assert query_world_status(w) == QueryStatus.ok;
  a := query_select_world(w, QueryFilter.{}, scratch[..]);
  #assert a.metadata.count == 8 && a.geometry.heightfields.count == 2;
  #assert a.geometry.boxes.count == 12 && a.geometry.capsules.count == 14 && a.geometry.floors.count == 20;
  #assert query_shape_count(a.geometry, QueryShape.floor) == 2;
  #assert semantic_ground(a, 20, 0, 5, 0.3).geometry.y == 4;
  for i: 0..<8 { #assert a.metadata[i].ref.id == w.metadata[i].ref.id; }
  g := semantic_ground(a, 0, 0, 1, 0.3);
  #assert g.geometry.y == -9 && g.collider.ref.id == 102 && g.collider.index == 1;
  a = query_select_world(w, QueryFilter.{include = 4}, scratch[..]);
  #assert a.metadata.count == 3 && a.geometry.heightfields.count == 0 && !a.geometry.ground_enabled;
  #assert a.geometry.boxes.count == 6 && a.geometry.capsules.count == 7 && a.geometry.floors.count == 10;
  #assert semantic_ray(a, world_point(0, 1, 0), world_point(0, 0, 1), 10).collider.ref.id == 201;
  #assert semantic_ray(a, world_point(8, 1, 0), world_point(0, 0, 1), 10).collider.ref.id == 301;
  #assert semantic_ground(a, 16, 0, 5, 0.3).collider.ref.id == 401;
  a = query_select_world(w, QueryFilter.{include = 8}, scratch[..]);
  #assert semantic_ray(a, world_point(4, 1, 0), world_point(0, 0, 1), 10).collider.ref.id == 202;
  #assert semantic_ray(a, world_point(12, 1, 0), world_point(0, 0, 1), 10).collider.ref.id == 302;
  #assert semantic_ground(a, 20, 0, 5, 0.3).collider.ref.id == 402;
  #assert a.metadata[0].index == 1 && a.metadata[1].index == 1 && a.metadata[2].index == 1;
  a = query_select_world(w, QueryFilter.{include = 1}, scratch[..]);
  #assert a.geometry.heightfields.count == 1 && semantic_ground(a, 0, 0, 1, 0.3).geometry.y == -10;
  #assert semantic_ray(a, world_point(0, 0, 0), world_point(0, -1, 0), 20).collider.ref.id == 101;
}
#test "world admission validates every geometry column and endpoint before publication" {
  b: [1] QueryMixedFixture; w := query_mixed_fixture(b[..]);
  w.geometry.capsules = b[0].capsules[0..<13]; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_mixed_fixture(b[..]); w.geometry.floors = b[0].floors[0..<19]; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_mixed_fixture(b[..]); b[0].capsules[6] = 0; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_mixed_fixture(b[..]); b[0].floors[0] = 0.0 / 0.0; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_mixed_fixture(b[..]); b[0].fields[0].ground.n = 0; #assert query_world_status(w) == QueryStatus.terrain;
  w = query_mixed_fixture(b[..]); b[0].fields[0].heights = b[0].low[0..<3]; #assert query_world_status(w) == QueryStatus.terrain;
  w = query_mixed_fixture(b[..]); b[0].low[0] = 0.0 / 0.0; #assert query_world_status(w) == QueryStatus.terrain;
  w = query_mixed_fixture(b[..]); b[0].metadata[0].ref.id = 0; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_mixed_fixture(b[..]); b[0].metadata[0].categories = QUERY_CATEGORIES; #assert query_world_status(w) == QueryStatus.ok;
  b[0].metadata[0].role = QueryRole.fluid; #assert query_world_status(w) == QueryStatus.ok;
  flat: [1] QueryFixture; f := query_fixture(flat[..]); f.geometry.ground = 0.0 / 0.0;
  #assert query_world_status(f) == QueryStatus.invalid;
  f = query_fixture(flat[..]); f.geometry.ground = 0.75; scratch: [1] QueryScratch;
  #assert semantic_ground(query_select_world(f, QueryFilter.{}, scratch[..]), 0, 0, 1, 0.3).geometry.y == 0.75;
  zero := [1] int.[0]; #assert !query_world_current(zero[..], 0);
  w = query_mixed_fixture(b[..]); w.geometry.ground = 0.0 / 0.0;
  #assert query_world_status(w) == QueryStatus.ok;
  extra_boxes: [13] f32; extra_capsules: [15] f32; extra_floors: [21] f32;
  for i: 0..<12 { extra_boxes[i] = b[0].boxes[i]; }
  for i: 0..<14 { extra_capsules[i] = b[0].capsules[i]; }
  for i: 0..<20 { extra_floors[i] = b[0].floors[i]; }
  w.geometry.boxes = extra_boxes[..]; #assert query_world_status(w) == QueryStatus.invalid;
  w.geometry.boxes = b[0].boxes[..]; w.geometry.capsules = extra_capsules[..]; #assert query_world_status(w) == QueryStatus.invalid;
  w.geometry.capsules = b[0].capsules[..]; w.geometry.floors = extra_floors[..]; #assert query_world_status(w) == QueryStatus.invalid;
}
#test "semantic queries preserve exhaustion and never publish a partial geometric result" {
  b: [1] QueryMixedFixture; w := query_mixed_fixture(b[..]); scratch: [1] QueryScratch;
  heights: [9] f32;
  fields := [1] QueryHeightfield.[QueryHeightfield.{ground = terrain.Ground.{n = 2, cell = 1, west = 0, south = 0}, heights = heights[..]}];
  w.geometry = Colliders.{heightfields = fields[..], heightfield_budget = 1};
  w.metadata = b[0].metadata[0..<1];
  a := query_select_world(w, QueryFilter.{}, scratch[..]);
  #assert a.geometry.heightfield_budget == 1;
  h := semantic_ray(a, world_point(0.5, 1, 0.5), world_point(1, -0.25, 0), 10);
  #assert h.geometry.status == QueryStatus.exhausted && !h.geometry.hit && h.collider.ref.id == 0;
  h = semantic_sweep(a, world_point(0.5, 1, 0.5), 0.25, world_point(2, -1, 0));
  #assert h.geometry.status == QueryStatus.exhausted && !h.geometry.hit;
  ids: [8] QueryCollider; ids[0].surface = 999;
  #assert semantic_overlap(a, world_point(0.9, 0.1, 0.9), 1, ids[..]).status == QueryStatus.exhausted && ids[0].surface == 999;
}
#test "world shape and height capacities admit the last complete supported records" #steps 4000000 {
  base: [1] QueryFixture; w := query_fixture(base[..]);
  boxes: [256 * QUERY_BOX] f32; metadata: [257] QueryCollider;
  metadata[0] = base[0].metadata[0];
  for i: 0..<256 {
    boxes[i * QUERY_BOX + 3] = 1; boxes[i * QUERY_BOX + 4] = 1; boxes[i * QUERY_BOX + 5] = 1;
    metadata[i + 1] = QueryCollider.{ref = ColliderRef.{id = 1000 + i, generation = 1}, shape = QueryShape.box, index = i, surface = 10};
  }
  w.metadata = metadata[0..<256]; w.geometry.boxes = boxes[0..<255 * QUERY_BOX];
  #assert query_world_status(w) == QueryStatus.ok;
  w.metadata = metadata[..]; w.geometry.boxes = boxes[..]; #assert query_world_status(w) == QueryStatus.capacity;
  fields: [17] QueryHeightfield; heights := [4] f32.[0, 0, 0, 0];
  for i: 0..<17 {
    fields[i] = QueryHeightfield.{ground = terrain.Ground.{n = 1, cell = 1, west = 0, south = 0}, heights = heights[..]};
    metadata[i] = QueryCollider.{ref = ColliderRef.{id = i + 1, generation = 1}, shape = QueryShape.heightfield, index = i, surface = 10};
  }
  w.geometry = Colliders.{heightfields = fields[0..<16]}; w.metadata = metadata[0..<16];
  #assert query_world_status(w) == QueryStatus.ok;
  w.geometry.heightfields = fields[..]; w.metadata = metadata[0..<17]; #assert query_world_status(w) == QueryStatus.capacity;
  large: [65536] f32;
  fields[0] = QueryHeightfield.{ground = terrain.Ground.{n = 4, rows = 13106, cell = 1, west = 0, south = 0}, heights = large[..]};
  w.geometry.heightfields = fields[0..<1]; w.metadata = metadata[0..<1];
  #assert query_world_status(w) == QueryStatus.ok;
  fields[0].ground.n = 255; fields[0].ground.rows = 255; #assert query_world_status(w) == QueryStatus.capacity;
}
#test "entity references reject despawns, slot reuse and malformed store extents" {
  b: [1] QueryFixture; w := query_fixture(b[..]); backing: [1] entities.OracleBacking;
  store := entities.oracle_store(backing[..]); born := entities.entity_spawn(store); entities.entity_flush(store);
  w.entity_store = store; b[0].metadata[0].entity = born.handle;
  #assert query_world_status(w) == QueryStatus.ok;
  scratch: [1] QueryScratch; selected := query_select_world(w, QueryFilter.{}, scratch[..]);
  #assert query_selected_status(selected) == QueryStatus.ok;
  entities.entity_despawn(store, born.handle); entities.entity_flush(store);
  #assert query_world_status(w) == QueryStatus.invalid && query_selected_status(selected) == QueryStatus.invalid;
  replacement := entities.entity_spawn(store); entities.entity_flush(store);
  #assert query_world_status(w) == QueryStatus.invalid;
  b[0].metadata[0].entity = replacement.handle; #assert query_world_status(w) == QueryStatus.ok;
  backing[0].n[entities.ENTITY_HIGH] = 64; #assert query_world_status(w) == QueryStatus.ok;
  backing[0].n[entities.ENTITY_HIGH] = 65; #assert query_world_status(w) == QueryStatus.invalid;
  backing[0].n[entities.ENTITY_HIGH] = 1; w.entity_store.gen = store.gen[0..<0]; #assert query_world_status(w) == QueryStatus.invalid;
  w.entity_store = store; w.entity_store.live = store.live[0..<0]; #assert query_world_status(w) == QueryStatus.invalid;
}
#forall "small scene mask combinations match hand-worked shape intersections" mask: 0..<16 {
  b: [1] QueryMixedFixture; w := query_mixed_fixture(b[..]); scratch: [1] QueryScratch;
  a := query_select_world(w, QueryFilter.{include = cast(u32) mask}, scratch[..]);
  #assert a.status == QueryStatus.ok;
  ray := semantic_ray(a, world_point(0, 1, 0), world_point(0, 0, 10), 1);
  #assert ray.geometry.hit == ((mask & 4) != 0);
  if ray.geometry.hit { #assert ray.geometry.t == 0.2 && ray.collider.ref.id == 201; }
  sweep := semantic_sweep(a, world_point(8, 1, 0), 0.25, world_point(0, 0, 10));
  #assert sweep.geometry.hit == ((mask & 4) != 0);
  if sweep.geometry.hit { #assert sweep.geometry.t == 0.15 && sweep.collider.ref.id == 301; }
  ids: [8] QueryCollider;
  overlap := semantic_overlap(a, world_point(12, 1, 2), 0.25, ids[..]);
  #assert overlap.status == QueryStatus.ok && overlap.count == (ifx (mask & 8) != 0 then 1 else 0);
  if overlap.count == 1 { #assert ids[0].ref.id == 302; }
  g := semantic_ground(a, 16, 0, 5, 0.3);
  if (mask & 4) != 0 { #assert g.geometry.y == 2 && g.collider.ref.id == 401; }
  else if (mask & 2) != 0 { #assert g.geometry.y == -9 && g.collider.ref.id == 102; }
  else if (mask & 1) != 0 { #assert g.geometry.y == -10 && g.collider.ref.id == 101; }
  else { #assert g.geometry.shape == QueryShape.none; }
}

#test "publication changes the whole query snapshot only at the next fixed step" {
  b: [1] QueryFixture; old := query_fixture(b[..]); next := old;
  next.epoch = 2; next.tick = 1;
  refused := query_world_publish(old, next, 0);
  #assert refused.status == QueryStatus.invalid && refused.world.epoch == 1 && b[0].epoch[0] == 1;
  wrong := next; wrong.epoch = 3;
  #assert query_world_publish(old, wrong, 1).status == QueryStatus.invalid;
  wrong = next; wrong.tick = 2;
  #assert query_world_publish(old, wrong, 1).status == QueryStatus.invalid;
  wrong = next; wrong.metadata = b[0].metadata[0..<2];
  #assert query_world_publish(old, wrong, 1).status == QueryStatus.invalid && b[0].epoch[0] == 1;
  too_many: [257] QueryCollider; wrong.metadata = too_many[..];
  #assert query_world_publish(old, wrong, 1).status == QueryStatus.capacity && b[0].epoch[0] == 1;
  accepted := query_world_publish(old, next, 1);
  #assert accepted.status == QueryStatus.ok && accepted.world.epoch == 2 && accepted.world.tick == 1;
  #assert query_world_status(old) == QueryStatus.invalid && query_world_status(accepted.world) == QueryStatus.ok;
  #assert query_world_publish(old, next, 1).status == QueryStatus.invalid;
  old = query_fixture(b[..]); next = old; next.epoch = 2;
  #assert query_world_publish(old, next, 0).status == QueryStatus.invalid;
  next.tick = 1; other := [1] int.[99]; next.current_epoch = other[..];
  accepted = query_world_publish(old, next, 1);
  #assert query_world_status(accepted.world) == QueryStatus.ok && other[0] == 99;
  old = accepted.world; old.epoch = 9223372036854775806; b[0].epoch[0] = old.epoch;
  next = old; next.epoch = 9223372036854775807; next.tick = 2;
  #assert query_world_publish(old, next, 2).status == QueryStatus.ok;
  old = next; old.current_epoch = b[0].epoch[..];
  #assert query_world_publish(old, next, 3).status == QueryStatus.invalid;
  old = query_fixture(b[..]); old.tick = -1; next = old; next.epoch = 2; next.tick = 0;
  #assert query_world_publish(old, next, 0).status == QueryStatus.invalid && b[0].epoch[0] == 1;
}

#test "semantic sweep, clear and overlap use the same selection with atomic output" {
  b: [1] QueryFixture; w := query_fixture(b[..]); scratch: [1] QueryScratch;
  a := query_select_world(w, QueryFilter.{exclude = 2}, scratch[..]);
  p := world_point(0, 1, 0); d := world_point(0, 0, 10);
  hit := semantic_sweep(a, p, 0.25, d);
  #assert hit.geometry.hit && hit.geometry.t == 0.475 && hit.collider.ref.id == 300;
  #assert semantic_clear(a, p, d, 0.4).clear && !semantic_clear(a, p, d, 1).clear;
  output: [3] QueryCollider; output[0].surface = 999;
  q := semantic_overlap(a, world_point(0, 0, 5), 1, output[0..<1]);
  #assert q.status == QueryStatus.capacity && q.count == 0 && output[0].surface == 999;
  q = semantic_overlap(a, world_point(0, 0, 5), 1, output[..]);
  #assert q.status == QueryStatus.ok && q.count == 2 && output[0].ref.id == 100 && output[1].ref.id == 300;
  q = semantic_overlap(a, world_point(0, 0, 5), 1, output[0..<2]);
  #assert q.status == QueryStatus.ok && q.count == 2;
  b[0].epoch[0] = 2;
  #assert semantic_sweep(a, p, 0.25, d).geometry.status == QueryStatus.invalid;
  #assert semantic_clear(a, p, d, 1).status == QueryStatus.invalid;
  #assert semantic_overlap(a, p, 1, output[..]).status == QueryStatus.invalid;
  a.status = QueryStatus.capacity;
  #assert semantic_sweep(a, p, 0.25, d).geometry.status == QueryStatus.capacity;
  #assert semantic_clear(a, p, d, 1).status == QueryStatus.capacity;
  #assert semantic_overlap(a, p, 1, output[..]).status == QueryStatus.capacity;
  #assert semantic_ray(a, p, d, 1).geometry.status == QueryStatus.capacity;
  #assert semantic_ground(a, 0, 0, 1, 0.3).geometry.status == QueryStatus.capacity;
}

#test "semantic selection skips a nearer excluded barrier and preserves stable hit identity" {
  b: [1] QueryFixture; w := query_fixture(b[..]); scratch: [1] QueryScratch;
  #assert query_world_status(w) == QueryStatus.ok;
  a := query_select_world(w, QueryFilter.{}, scratch[..]);
  h := semantic_ray(a, world_point(0, 1, 0), world_point(0, 0, 1), 10);
  #assert h.geometry.hit && h.geometry.t == 2 && h.collider.ref.id == 200 && h.collider.surface == 20;
  a = query_select_world(w, QueryFilter.{exclude = 2}, scratch[..]);
  h = semantic_ray(a, world_point(0, 1, 0), world_point(0, 0, 1), 10);
  #assert h.geometry.hit && h.geometry.t == 5 && h.collider.ref.id == 300 && h.collider.index == 1;
  g := semantic_ground(a, 0, 0, 1, 0.3);
  #assert g.geometry.y == 0 && g.collider.ref.id == 100 && g.collider.surface == 10;
  #assert query_shape_ordinal(a.geometry, QueryShape.box, 0) == 1;
  #assert query_shape_ordinal(a.geometry, QueryShape.none, 0) == -1;
  #assert query_shape_ordinal(a.geometry, QueryShape.box, 1) == -1;
  #assert query_shape_ordinal(a.geometry, QueryShape.box, -1) == -1;
  #assert query_world_current(w.current_epoch, 1) && !query_world_current(w.current_epoch, 0);
  #assert !query_world_current(w.current_epoch[0..<0], 1);
  b[0].epoch[0] = 2;
  #assert semantic_ray(a, world_point(0, 1, 0), world_point(0, 0, 1), 10).geometry.status == QueryStatus.invalid;
  #assert semantic_ground(a, 0, 0, 1, 0.3).geometry.status == QueryStatus.invalid;
  #assert query_select_world(w, QueryFilter.{}, scratch[..]).status == QueryStatus.invalid;
}
#test "selection refuses capacity and malformed filters before exposing a partial world" {
  b: [1] QueryFixture; w := query_fixture(b[..]); scratch: [1] QueryScratch;
  a := query_select_world(w, QueryFilter.{include = 0}, scratch[..]);
  #assert a.status == QueryStatus.ok && a.metadata.count == 0;
  #assert !semantic_ray(a, world_point(0, 1, 0), world_point(0, -1, 0), 10).geometry.hit;
  #assert semantic_ground(a, 0, 0, 1, 0.3).geometry.shape == QueryShape.none;
  a = query_select_world(w, QueryFilter.{include = 65536}, scratch[..]);
  #assert a.status == QueryStatus.invalid && a.metadata.count == 0;
  a = query_select_world(w, QueryFilter.{}, scratch[0..<0]);
  #assert a.status == QueryStatus.capacity && a.metadata.count == 0;
  w.geometry.boxes = b[0].boxes[0..<11]; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); w.tick = -1; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); w.metadata = b[0].metadata[0..<2]; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].ref.id = 100; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].ref.generation = 0; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].index = 1; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].surface = 30; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].categories = 0; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].categories = 65536; #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].metadata[1].entity = entities.entity_handle(0, EntityGeneration.{});
  #assert query_world_status(w) == QueryStatus.invalid;
  w = query_fixture(b[..]); b[0].boxes[3] = -2; #assert query_world_status(w) == QueryStatus.invalid;
}

query_world_current :: (word: [] int, epoch: int) -> bool #effects(all) {
  return word.count == 1 && epoch > 0 && word[0] == epoch;
}
query_response_index :: (table: [] SurfaceResponse, id: int) -> int #effects(all) {
  for i: 0..<table.count { if table[i].id == id { return i; } }
  return -1;
}
query_responses_ok :: (table: [] SurfaceResponse) -> bool #effects(all) {
  if table.count > QUERY_SURFACES_MAX { return false; }
  for i: 0..<table.count {
    r := table[i];
    if r.id <= 0 || !(r.friction >= 0 && r.friction <= 16) || !(r.restitution >= 0 && r.restitution <= 1) { return false; }
    for j: 0..<i { if table[j].id == r.id { return false; } }
  }
  return true;
}
query_shape_count :: (c: Colliders, shape: QueryShape) -> int #effects(all) {
  if shape == QueryShape.ground { return ifx c.heightfields.count == 0 && c.ground_enabled then 1 else 0; }
  if shape == QueryShape.heightfield { return c.heightfields.count; }
  if shape == QueryShape.box { return query_boxes(c); }
  if shape == QueryShape.capsule { return query_capsules(c); }
  if shape == QueryShape.floor { return c.floors.count / STAND_FLOATS; }
  return 0;
}
query_shape_ordinal :: (c: Colliders, shape: QueryShape, index: int) -> int #effects(all) {
  if index < 0 || index >= query_shape_count(c, shape) { return -1; }
  if shape == QueryShape.ground { return 0; }
  base := query_shape_count(c, QueryShape.ground);
  if shape == QueryShape.heightfield { return base + index; }
  base += c.heightfields.count;
  if shape == QueryShape.box { return base + index; }
  base += query_boxes(c);
  if shape == QueryShape.capsule { return base + index; }
  return base + query_capsules(c) + index;
}
query_world_status :: (w: QueryWorld) -> QueryStatus #effects(all) {
  if !query_world_current(w.current_epoch, w.epoch) || w.tick < 0 { return QueryStatus.invalid; }
  return query_world_data_status(w);
}
query_world_data_status :: (w: QueryWorld) -> QueryStatus #effects(all) {
  c := w.geometry;
  if w.metadata.count > QUERY_METADATA_MAX || c.heightfields.count > QUERY_HEIGHTFIELDS_MAX { return QueryStatus.capacity; }
  if c.boxes.count % QUERY_BOX != 0 || c.capsules.count % QUERY_CAPSULE != 0 || c.floors.count % STAND_FLOATS != 0 { return QueryStatus.invalid; }
  total := query_shape_count(c, QueryShape.ground) + c.heightfields.count + query_boxes(c) + query_capsules(c) + c.floors.count / STAND_FLOATS;
  if total != w.metadata.count || !query_surfaces_ok(w.surfaces) || !query_responses_ok(w.responses) { return QueryStatus.invalid; }
  for i: 0..<w.surfaces.count {
    s := w.surfaces[i];
    if (s.friction_policy != 0 && query_response_index(w.responses, s.friction_policy) < 0) ||
        (s.restitution_policy != 0 && query_response_index(w.responses, s.restitution_policy) < 0) { return QueryStatus.invalid; }
  }
  if query_shape_count(c, QueryShape.ground) > 0 && !query_finite(c.ground) { return QueryStatus.invalid; }
  for i: 0..<query_boxes(c) { if !query_box(c, i).ok { return QueryStatus.invalid; } }
  for i: 0..<query_capsules(c) { if !query_capsule(c, i).ok { return QueryStatus.invalid; } }
  for i: 0..<c.floors.count { if !query_finite(c.floors[i]) { return QueryStatus.invalid; } }
  for i: 0..<c.heightfields.count {
    f := c.heightfields[i]; n := terrain.ground_points(f.ground);
    if n > QUERY_HEIGHT_WORDS_MAX { return QueryStatus.capacity; }
    if n == 0 || f.heights.count < n { return QueryStatus.terrain; }
    for j: 0..<n { if !query_finite(f.heights[j]) { return QueryStatus.terrain; } }
  }
  for i: 0..<w.metadata.count {
    m := w.metadata[i];
    if !collider_ref_ok(m.ref) || query_shape_ordinal(c, m.shape, m.index) != i ||
        query_surface_index(w.surfaces, m.surface) < 0 || m.categories == 0 || m.categories > QUERY_CATEGORIES { return QueryStatus.invalid; }
    for j: 0..<i { if w.metadata[j].ref.id == m.ref.id { return QueryStatus.invalid; } }
    if m.entity.value != 0 {
      if w.entity_store.n.count != entities.ENTITY_COUNTERS { return QueryStatus.invalid; }
      high := w.entity_store.n[entities.ENTITY_HIGH];
      if high > w.entity_store.gen.count || high > w.entity_store.live.count { return QueryStatus.invalid; }
      if !entities.entity_alive(w.entity_store, m.entity) { return QueryStatus.invalid; }
    }
  }
  return QueryStatus.ok;
}
// Called by the owner after entity_flush on its paid tick. Candidate bytes
// live in an inactive retained bank; a failed admission leaves the old bank
// and epoch readable. Epoch exhaustion retires this session rather than wraps.
query_world_publish :: (old: QueryWorld, candidate: QueryWorld, now: int) -> QueryPublication #effects(all) {
  out := QueryPublication.{world = old, status = QueryStatus.invalid};
  if !query_world_current(old.current_epoch, old.epoch) || old.tick < 0 || old.epoch == 9223372036854775807 ||
      now <= old.tick || candidate.tick != now || candidate.epoch != old.epoch + 1 { return out; }
  status := query_world_data_status(candidate);
  if status != QueryStatus.ok { out.status = status; return out; }
  old.current_epoch[0] = candidate.epoch;
  next := candidate; next.current_epoch = old.current_epoch;
  return QueryPublication.{world = next};
}
query_select_world :: (w: QueryWorld, filter: QueryFilter, scratch: [] QueryScratch) -> SelectedWorld #effects(all) {
  status := query_world_status(w);
  if status != QueryStatus.ok { return SelectedWorld.{status = status}; }
  if !query_filter_ok(filter) { return SelectedWorld.{status = QueryStatus.invalid}; }
  if scratch.count != 1 { return SelectedWorld.{status = QueryStatus.capacity}; }
  out := SelectedWorld.{current_epoch = w.current_epoch, epoch = w.epoch, surfaces = w.surfaces, responses = w.responses, entity_store = w.entity_store};
  out.geometry.ground = w.geometry.ground; out.geometry.ground_enabled = false;
  out.geometry.heightfield_budget = w.geometry.heightfield_budget;
  boxes := 0; capsules := 0; floors := 0; fields := 0; count := 0;
  for i: 0..<w.metadata.count {
    m := w.metadata[i]; if !query_filter_accepts(filter, m) { continue; }
    scratch[0].metadata[count] = m; count += 1;
    if m.shape == QueryShape.ground { out.geometry.ground_enabled = true; }
    if m.shape == QueryShape.box {
      for j: 0..<QUERY_BOX { scratch[0].boxes[boxes * QUERY_BOX + j] = w.geometry.boxes[m.index * QUERY_BOX + j]; }
      boxes += 1;
    }
    if m.shape == QueryShape.capsule {
      for j: 0..<QUERY_CAPSULE { scratch[0].capsules[capsules * QUERY_CAPSULE + j] = w.geometry.capsules[m.index * QUERY_CAPSULE + j]; }
      capsules += 1;
    }
    if m.shape == QueryShape.floor {
      for j: 0..<STAND_FLOATS { scratch[0].floors[floors * STAND_FLOATS + j] = w.geometry.floors[m.index * STAND_FLOATS + j]; }
      floors += 1;
    }
    if m.shape == QueryShape.heightfield { scratch[0].fields[fields] = w.geometry.heightfields[m.index]; fields += 1; }
  }
  out.geometry.boxes = scratch[0].boxes[0..<boxes * QUERY_BOX];
  out.geometry.capsules = scratch[0].capsules[0..<capsules * QUERY_CAPSULE];
  out.geometry.floors = scratch[0].floors[0..<floors * STAND_FLOATS];
  out.geometry.heightfields = scratch[0].fields[0..<fields];
  out.metadata = scratch[0].metadata[0..<count];
  return out;
}
semantic_ray :: (w: SelectedWorld, o: WorldPoint, d: WorldPoint, far: f32) -> SemanticHit #effects(all) {
  status := query_selected_status(w);
  if status != QueryStatus.ok { return SemanticHit.{geometry = QueryHit.{status = status}}; }
  h := query_ray(w.geometry, o, d, far);
  out := SemanticHit.{geometry = h};
  if h.hit { out.collider = w.metadata[query_shape_ordinal(w.geometry, h.shape, h.index)]; }
  return out;
}
semantic_ground :: (w: SelectedWorld, x: f32, z: f32, below: f32, reach: f32) -> SemanticGround #effects(all) {
  status := query_selected_status(w);
  if status != QueryStatus.ok { return SemanticGround.{geometry = QueryGround.{status = status}}; }
  h := query_ground_checked(w.geometry, x, z, below, reach);
  out := SemanticGround.{geometry = h};
  if h.status == QueryStatus.ok && h.shape != QueryShape.none { out.collider = w.metadata[query_shape_ordinal(w.geometry, h.shape, h.index)]; }
  return out;
}
query_selected_status :: (w: SelectedWorld) -> QueryStatus #effects(all) {
  if w.status != QueryStatus.ok { return w.status; }
  if !query_world_current(w.current_epoch, w.epoch) { return QueryStatus.invalid; }
  for i: 0..<w.metadata.count {
    h := w.metadata[i].entity;
    if h.value != 0 && !entities.entity_alive(w.entity_store, h) { return QueryStatus.invalid; }
  }
  return QueryStatus.ok;
}
semantic_clear :: (w: SelectedWorld, o: WorldPoint, d: WorldPoint, far: f32) -> QueryClear #effects(all) {
  status := query_selected_status(w);
  if status != QueryStatus.ok { return QueryClear.{status = status}; }
  return query_clear(w.geometry, o, d, far);
}
semantic_sweep :: (w: SelectedWorld, from: WorldPoint, r: f32, by: WorldPoint) -> SemanticHit #effects(all) {
  status := query_selected_status(w);
  if status != QueryStatus.ok { return SemanticHit.{geometry = QueryHit.{status = status}}; }
  h := query_sweep(w.geometry, from, r, by);
  out := SemanticHit.{geometry = h};
  if h.hit { out.collider = w.metadata[query_shape_ordinal(w.geometry, h.shape, h.index)]; }
  return out;
}
semantic_overlap :: (w: SelectedWorld, centre: WorldPoint, r: f32, output: [] QueryCollider) -> QueryOverlapResult #effects(all) {
  status := query_selected_status(w);
  if status != QueryStatus.ok { return QueryOverlapResult.{status = status}; }
  staged: [QUERY_METADATA_MAX] QueryId;
  q := query_overlap_checked(w.geometry, centre, r, staged[..]);
  if q.status != QueryStatus.ok { return q; }
  if q.count > output.count { return QueryOverlapResult.{status = QueryStatus.capacity}; }
  for i: 0..<q.count { output[i] = w.metadata[query_shape_ordinal(w.geometry, staged[i].shape, staged[i].index)]; }
  return q;
}
