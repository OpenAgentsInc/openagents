// Particles and their neighbors (book chapter 23): the store that the
// liquid, cloth and granular solvers share, and fixed-radius neighbor search
// on a uniform grid of cells.
//
//   pstore_add(p, x, v, mass, material, entity)   one particle, or -1 when full
//   pgrid_build(p, g)        cell of each particle, counting sort by cell,
//                            exclusive scan for each cell's start, stable
//                            scatter: within a cell, particles keep index order
//   pgrid_neighbors(p, g, n) every particle's neighbors within h, in a fixed
//                            order (27 cells, z then y then x, then sorted
//                            order); a full list is reported, never cut
//   psample_box, psample_sphere   a lattice, or a jittered lattice from
//                            aethyr/core/rand.coax's counter streams, inside a shape
//
// The grid is bounded: origin, cell size h and nx * ny * nz cells. A particle
// outside it is a refusal of the build, not a clamp. CPU only, f64; device
// kernels are not built yet.
//   coax/bin/coax test --library aethyr/physics/sim/particles.coax
#load "../rigid.coax";
#load "../../core/rand.coax";

PSTORE :: 512;          // particles
PCELLS :: 4096;         // cells in a grid
PLIST :: 48;            // neighbors kept per particle

Pstore :: struct {
  count: int;
  pos: [PSTORE] D3;
  vel: [PSTORE] D3;
  mass: [PSTORE] f64;
  material: [PSTORE] int;
  entity: [PSTORE] int;
}

pstore_add :: (p: [] Pstore, x: D3, v: D3, mass: f64, material: int, entity: int) -> int {
  i := p[0].count;
  if i == PSTORE { return -1; }
  p[0].count = i + 1;
  p[0].pos[i] = x; p[0].vel[i] = v; p[0].mass[i] = mass; p[0].material[i] = material; p[0].entity[i] = entity;
  return i;
}

Pgrid_Refusal :: enum u8 { none; too_many_cells; outside; }

Pgrid :: struct {
  origin: D3;
  h: f64;
  nx: int; ny: int; nz: int;
  cell: [PSTORE] int;          // each particle's cell
  count: [PCELLS] int;         // particles per cell
  start: [PCELLS + 1] int;     // exclusive scan of count; start[cells] = n
  order: [PSTORE] int;         // particles sorted by cell, stable
}

// The grid of cells of size h covering lo..hi, with no particles yet.
pgrid_new :: (g: [] Pgrid, lo: D3, hi: D3, h: f64) -> Pgrid_Refusal {
  g[0].origin = lo; g[0].h = h;
  g[0].nx = cast(int) floor((hi.x - lo.x) / h) + 1;
  g[0].ny = cast(int) floor((hi.y - lo.y) / h) + 1;
  g[0].nz = cast(int) floor((hi.z - lo.z) / h) + 1;
  if g[0].nx * g[0].ny * g[0].nz > PCELLS { return Pgrid_Refusal.too_many_cells; }
  return Pgrid_Refusal.none;
}

// The cell coordinate of x on one axis, or -1 outside 0..n-1.
pgrid_axis :: (x: f64, lo: f64, h: f64, n: int) -> int {
  c := floor((x - lo) / h);
  if c < 0.0 || c >= cast(f64) n { return -1; }
  return cast(int) c;
}

// Counting sort of the particles by cell. Refuses, and leaves the order
// unset, when a particle lies outside the grid.
pgrid_build :: (p: [] Pstore, g: [] Pgrid) -> Pgrid_Refusal {
  cells := g[0].nx * g[0].ny * g[0].nz;
  for c: 0..<cells { g[0].count[c] = 0; }
  for i: 0..<p[0].count {
    x := pgrid_axis(p[0].pos[i].x, g[0].origin.x, g[0].h, g[0].nx);
    y := pgrid_axis(p[0].pos[i].y, g[0].origin.y, g[0].h, g[0].ny);
    z := pgrid_axis(p[0].pos[i].z, g[0].origin.z, g[0].h, g[0].nz);
    if x < 0 || y < 0 || z < 0 { return Pgrid_Refusal.outside; }
    c := (z * g[0].ny + y) * g[0].nx + x;
    g[0].cell[i] = c; g[0].count[c] += 1;
  }
  total := 0;
  for c: 0..<cells { g[0].start[c] = total; total += g[0].count[c]; }
  g[0].start[cells] = total;
  // Scatter in index order through a running cursor per cell: stable.
  for c: 0..<cells { g[0].count[c] = g[0].start[c]; }
  for i: 0..<p[0].count {
    c := g[0].cell[i];
    g[0].order[g[0].count[c]] = i; g[0].count[c] += 1;
  }
  for c: 0..<cells { g[0].count[c] -= g[0].start[c]; }   // mutant: equivalent (start[0] is 0, so cell 0's cursor already equals its count)
  return Pgrid_Refusal.none;
}

Pneighbors :: struct {
  count: [PSTORE] int;              // true neighbors within h, kept or not
  list: [PSTORE * PLIST] int;       // the first PLIST of them per particle
  overflow: int;                    // particles with more than PLIST
  tests: int;                       // distance tests made
}

// Every particle's neighbors j != i with |x_i - x_j| < h, after a build.
pgrid_neighbors :: (p: [] Pstore, g: [] Pgrid, n: [] Pneighbors) {
  n[0].overflow = 0; n[0].tests = 0;
  h2 := g[0].h * g[0].h; nx := g[0].nx; ny := g[0].ny; nz := g[0].nz;
  for i: 0..<p[0].count {
    c := g[0].cell[i];
    cx := c % nx; cy := (c / nx) % ny; cz := c / (nx * ny);
    k := 0;
    for dz: -1..<2 {
      for dy: -1..<2 {
        for dx: -1..<2 {
          x := cx + dx; y := cy + dy; z := cz + dz;
          if x < 0 || y < 0 || z < 0 || x >= nx || y >= ny || z >= nz { continue; }
          d := (z * ny + y) * nx + x;
          for s: g[0].start[d]..<g[0].start[d + 1] {
            j := g[0].order[s];
            if j == i { continue; }
            n[0].tests += 1;
            if d3_len2(d3_sub(p[0].pos[i], p[0].pos[j])) < h2 {
              if k < PLIST { n[0].list[i * PLIST + k] = j; }
              k += 1;
            }
          }
        }
      }
    }
    n[0].count[i] = k;
    if k > PLIST { n[0].overflow += 1; }
  }
}

// A lattice of spacing a filling the box lo..hi, cell-centred, each
// particle carrying density * a^3. jitter > 0 moves each point by up to
// jitter * a / 2 per axis from stream `seed`. Returns the particles added,
// or -1 when the store fills (the store keeps what fitted).
psample_box :: (p: [] Pstore, lo: D3, hi: D3, a: f64, density: f64, jitter: f64, seed: int, material: int, entity: int) -> int {
  return psample(p, lo, hi, D3_ZERO, -1.0, a, density, jitter, seed, material, entity);
}
// The same inside the sphere of radius r about c.
psample_sphere :: (p: [] Pstore, c: D3, r: f64, a: f64, density: f64, jitter: f64, seed: int, material: int, entity: int) -> int {
  return psample(p, d3_sub(c, d3(r, r, r)), d3_add(c, d3(r, r, r)), c, r, a, density, jitter, seed, material, entity);
}
psample :: (p: [] Pstore, lo: D3, hi: D3, c: D3, r: f64, a: f64, density: f64, jitter: f64, seed: int, material: int, entity: int) -> int {
  // A side that is a whole number of spacings up to rounding holds that many.
  nx := cast(int) floor((hi.x - lo.x) / a + 0.000000001); ny := cast(int) floor((hi.y - lo.y) / a + 0.000000001); nz := cast(int) floor((hi.z - lo.z) / a + 0.000000001);
  added := 0; k := 0;
  for z: 0..<nz {
    for y: 0..<ny {
      for x: 0..<nx {
        q := d3(lo.x + (cast(f64) x + 0.5) * a, lo.y + (cast(f64) y + 0.5) * a, lo.z + (cast(f64) z + 0.5) * a);
        if r >= 0.0 && d3_len2(d3_sub(q, c)) > r * r { continue; }   // mutant: equivalent (a lattice point exactly on the sphere is a float tie, and either side samples the sphere to half a spacing)
        if jitter > 0.0 {   // mutant: equivalent (a jitter of 0 moves no point)
          j := d3(cast(f64) rand_unit(seed, 23, 3 * k) - 0.5, cast(f64) rand_unit(seed, 23, 3 * k + 1) - 0.5, cast(f64) rand_unit(seed, 23, 3 * k + 2) - 0.5);
          q = d3_add(q, d3_scale(j, jitter * a));
        }
        k += 1;
        if pstore_add(p, q, D3_ZERO, density * a * a * a, material, entity) < 0 { return -1; }
        added += 1;
      }
    }
  }
  return added;
}

// ---- checks

CLOUD_TESTS :: 2560;   // a regression pin: the 27-cell search of this cloud

test_unit :: (seed: int, k: int) -> f64 { return cast(f64) rand_unit(seed, 99, k); }   // mutant: equivalent (the cloud generator: any stream gives a valid cloud, which the reference checks)
// n particles in the cube 0..size, or in two tight clusters.
test_cloud :: (p: [] Pstore, n: int, seed: int, size: f64, clustered: bool) {
  p[0].count = 0;
  for i: 0..<n {
    x := d3(test_unit(seed, 3 * i), test_unit(seed, 3 * i + 1), test_unit(seed, 3 * i + 2));   // mutant: equivalent (the cloud generator: any change still makes a valid cloud, which the reference checks)
    if clustered { x = d3_add(d3_scale(x, 0.1), ifx i % 2 == 0 then d3(0.2, 0.2, 0.2) else d3(0.7, 0.6, 0.65)); }   // mutant: equivalent (the cloud generator: any change still makes a valid cloud, which the reference checks)
    _ := pstore_add(p, d3_scale(x, size), D3_ZERO, 1.0, 0, 0);   // mutant: equivalent (the cloud generator: material and entity do not enter the search)
  }
}
// Brute force: neighbor sets equal as sets, and the kept list is a prefix
// of the fixed order with every entry a true neighbor.
reference_match :: (p: [] Pstore, n: [] Pneighbors, h: f64) -> bool {
  for i: 0..<p[0].count {   // mutant: equivalent (skipping a particle only weakens the oracle)
    want := 0;
    for j: 0..<p[0].count {
      if j == i { continue; }
      if d3_dist(p[0].pos[i], p[0].pos[j]) < h { want += 1; }
    }
    if n[0].count[i] != want { return false; }
    kept := ifx want < PLIST then want else PLIST;   // mutant: equivalent (at want == PLIST both forms keep PLIST; past it the oracle only inspects one more true neighbor)
    for k: 0..<kept {
      j := n[0].list[i * PLIST + k];
      if j == i || d3_dist(p[0].pos[i], p[0].pos[j]) >= h { return false; }
      for m: 0..<k { if n[0].list[i * PLIST + m] == j { return false; } }
    }
  }
  return true;
}
search :: (p: [] Pstore, n: [] Pneighbors, lo: D3, hi: D3, h: f64) -> Pgrid_Refusal {
  g: [1] Pgrid;
  r := pgrid_new(g[..], lo, hi, h);
  if r != Pgrid_Refusal.none { return r; }
  r = pgrid_build(p, g[..]);
  if r != Pgrid_Refusal.none { return r; }
  pgrid_neighbors(p, g[..], n);
  return r;
}

#test "neighbor sets equal brute force on random, clustered and boundary clouds" #steps 300000000 {
  p: [1] Pstore; n: [1] Pneighbors;
  for seed: 1..<4 {
    test_cloud(p[..], 200, seed, 1.0, false);
    #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.15) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.15);
    test_cloud(p[..], 200, seed, 1.0, true);
    #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.07) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.07);
  }
  // On cell boundaries: points on a lattice of exactly h, so each one's axis
  // neighbors are at distance h, which is not within h.
  p[0].count = 0;
  for z: 0..<4 { for y: 0..<4 { for x: 0..<4 { _ := pstore_add(p[..], d3(cast(f64) x * 0.25, cast(f64) y * 0.25, cast(f64) z * 0.25), D3_ZERO, 1.0, 0, 0); } } }
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.25) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.25);
  for i: 0..<64 { #assert n[0].count[i] == 0; }
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.2501) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.2501);
  #assert n[0].count[0] == 3 && n[0].count[21] == 6;
  // Two particles at the same point are neighbors; one alone has none.
  p[0].count = 0; _ := pstore_add(p[..], d3(0.5, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none && n[0].count[0] == 0 && n[0].tests == 0;
  _ = pstore_add(p[..], d3(0.5, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none && n[0].count[0] == 1 && n[0].list[0] == 1 && n[0].list[PLIST] == 0;
}

#test "the sort is stable and the order is fixed: a sorted cell keeps index order" {
  p: [1] Pstore; g: [1] Pgrid;
  test_cloud(p[..], 300, 5, 1.0, false);
  #assert pgrid_new(g[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.2) == Pgrid_Refusal.none;
  #assert g[0].nx == 6 && g[0].ny == 6 && g[0].nz == 6;
  #assert pgrid_build(p[..], g[..]) == Pgrid_Refusal.none;
  cells := g[0].nx * g[0].ny * g[0].nz;
  #assert g[0].start[0] == 0 && g[0].start[cells] == 300;
  seen: [PSTORE] bool;
  for c: 0..<cells {
    #assert g[0].start[c + 1] - g[0].start[c] == g[0].count[c];
    for s: g[0].start[c]..<g[0].start[c + 1] {
      i := g[0].order[s];
      #assert g[0].cell[i] == c && !seen[i];
      seen[i] = true;
      if s > g[0].start[c] { #assert g[0].order[s - 1] < i; }
    }
  }
  // Neighbors come in the fixed order: by the 27 cells, then index.
  n: [1] Pneighbors;
  pgrid_neighbors(p[..], g[..], n[..]);
  for i: 0..<300 {
    kept := ifx n[0].count[i] < PLIST then n[0].count[i] else PLIST;
    for k: 1..<kept {
      a := n[0].list[i * PLIST + k - 1]; b := n[0].list[i * PLIST + k];
      #assert g[0].cell[a] < g[0].cell[b] || (g[0].cell[a] == g[0].cell[b] && a < b);
    }
  }
}

#test "a full list is reported with its true count, never cut quietly" {
  p: [1] Pstore; n: [1] Pneighbors;
  for i: 0..<60 { _ := pstore_add(p[..], d3(0.5 + 0.001 * cast(f64) i, 0.5, 0.5), D3_ZERO, 1.0, 0, 0); }
  _ := pstore_add(p[..], d3(0.9, 0.9, 0.9), D3_ZERO, 1.0, 0, 0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none;
  #assert n[0].overflow == 60 && n[0].count[0] == 59 && n[0].count[60] == 0 && reference_match(p[..], n[..], 0.1);
  for k: 0..<PLIST { #assert n[0].list[k] == k + 1; }
}

#test "refusals: a particle outside the grid, too many cells, a full store" {
  p: [1] Pstore; n: [1] Pneighbors; g: [1] Pgrid;
  _ := pstore_add(p[..], d3(0.5, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);
  _ = pstore_add(p[..], d3(0.5, 1.21, 0.5), D3_ZERO, 1.0, 0, 0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.outside;
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.25, 1.0), 0.1) == Pgrid_Refusal.none;
  p[0].pos[1] = d3(-0.0001, 0.5, 0.5);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.outside;
  p[0].pos[1] = d3(0.5, 0.5, -0.0001);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.outside;
  p[0].pos[1] = d3(0.0, 0.0, 0.0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none;
  #assert pgrid_new(g[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.05) == Pgrid_Refusal.too_many_cells;
  #assert pgrid_new(g[..], D3_ZERO, d3(1.5, 1.5, 1.5), 0.1) == Pgrid_Refusal.none && g[0].nx * g[0].ny * g[0].nz == PCELLS;
  #assert pgrid_axis(0.999, 0.0, 0.1, 10) == 9 && pgrid_axis(1.0, 0.0, 0.1, 10) == -1;
  full: [1] Pstore;
  for k: 0..<PSTORE { #assert pstore_add(full[..], D3_ZERO, D3_ZERO, 1.0, 0, 0) == k; }
  #assert pstore_add(full[..], D3_ZERO, D3_ZERO, 1.0, 0, 0) == -1 && full[0].count == PSTORE;
  full[0].count = 0;
  #assert psample_box(full[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1, 1000.0, 0.0, 1, 0, 0) == -1 && full[0].count == PSTORE;
}

#test "sampling: count and mass match the shape's volume and density" {
  p: [1] Pstore;
  #assert psample_box(p[..], D3_ZERO, d3(0.5, 0.4, 0.3), 0.05, 1000.0, 0.0, 1, 2, 7) == 480;
  mass := 0.0;
  for i: 0..<p[0].count { mass += p[0].mass[i]; }
  #assert abs(mass - 1000.0 * 0.5 * 0.4 * 0.3) < 1e-9 && p[0].material[5] == 2 && p[0].entity[479] == 7;
  #assert d3_dist(p[0].pos[0], d3(0.025, 0.025, 0.025)) < 1e-15;
  // A sphere of radius 0.3 at spacing 0.075: the count is the volume / a^3
  // to within a shell half a spacing thick, 2 pi r^2 / a^2 points.
  p[0].count = 0;
  n := psample_sphere(p[..], d3(0.5, 0.5, 0.5), 0.3, 0.075, 1.0, 0.0, 1, 0, 0);
  ideal := 4.0 / 3.0 * PI_D * 0.027 / (0.075 * 0.075 * 0.075);
  #assert n > 0 && abs(cast(f64) n - ideal) < 2.0 * PI_D * 0.09 / (0.075 * 0.075);
  for i: 0..<p[0].count { #assert d3_dist(p[0].pos[i], d3(0.5, 0.5, 0.5)) <= 0.3; }
  // Jitter moves each point by at most a / 2 per axis times the jitter, and
  // the same seed gives the same points.
  p[0].count = 0;
  _ := psample_box(p[..], D3_ZERO, d3(0.2, 0.2, 0.2), 0.05, 1.0, 0.5, 9, 0, 0);
  q: [1] Pstore;
  _ = psample_box(q[..], D3_ZERO, d3(0.2, 0.2, 0.2), 0.05, 1.0, 0.5, 9, 0, 0);
  moved := false;
  for i: 0..<p[0].count {
    z := i / 16; y := (i / 4) % 4; x := i % 4;
    c := d3((cast(f64) x + 0.5) * 0.05, (cast(f64) y + 0.5) * 0.05, (cast(f64) z + 0.5) * 0.05);
    e := d3_sub(p[0].pos[i], c);
    #assert abs(e.x) <= 0.0125 && abs(e.y) <= 0.0125 && abs(e.z) <= 0.0125 && d3_eq(p[0].pos[i], q[0].pos[i]);
    moved = moved || d3_len(e) > 0.001;
  }
  #assert moved && p[0].count == 64;
}

#test "an offset grid, a rebuilt grid, and the store's fields" {
  p: [1] Pstore; n: [1] Pneighbors; g: [1] Pgrid;
  #assert pstore_add(p[..], d3(1.0, 2.0, 3.0), d3(4.0, 5.0, 6.0), 2.0, 3, 9) == 0;
  #assert d3_eq(p[0].vel[0], d3(4.0, 5.0, 6.0)) && p[0].mass[0] == 2.0;
  // The same cloud moved to 5..6 searches the same on a grid from 5.
  test_cloud(p[..], 200, 2, 1.0, false);
  #assert p[0].count == 200;
  for i: 0..<200 { p[0].pos[i] = d3_add(p[0].pos[i], d3(5.0, 5.0, 5.0)); }
  #assert search(p[..], n[..], d3(5.0, 5.0, 5.0), d3(6.0, 6.0, 6.0), 0.15) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.15);
  #assert pgrid_new(g[..], d3(5.0, 5.0, 5.0), d3(6.0, 6.0, 6.0), 0.15) == Pgrid_Refusal.none && g[0].nx == 7 && g[0].ny == 7 && g[0].nz == 7 && d3_eq(g[0].origin, d3(5.0, 5.0, 5.0));
  #assert pgrid_axis(5.31, 5.0, 0.15, 7) == 2;
  // Building twice on one grid gives the same counts.
  #assert pgrid_build(p[..], g[..]) == Pgrid_Refusal.none && pgrid_build(p[..], g[..]) == Pgrid_Refusal.none;
  #assert g[0].start[7 * 7 * 7] == 200;
  for c: 0..<7 * 7 * 7 { #assert g[0].start[c + 1] - g[0].start[c] == g[0].count[c]; }
  // 4097 cells is one too many.
  #assert pgrid_new(g[..], D3_ZERO, d3(16.0, 240.0, 0.0), 1.0) == Pgrid_Refusal.too_many_cells;
  #assert pgrid_new(g[..], D3_ZERO, d3(15.0, 240.0, 0.0), 1.0) == Pgrid_Refusal.none;
}

#test "the list holds exactly PLIST: 48 neighbors fit, 49 overflow, a second search starts clean" {
  p: [1] Pstore; n: [1] Pneighbors;
  for i: 0..<49 { _ := pstore_add(p[..], d3(0.5 + 0.001 * cast(f64) i, 0.5, 0.5), D3_ZERO, 1.0, 0, 0); }
  _ := pstore_add(p[..], d3(0.2, 0.2, 0.2), D3_ZERO, 1.0, 0, 0);
  _ = pstore_add(p[..], d3(0.9, 0.9, 0.9), D3_ZERO, 1.0, 0, 0);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none;
  #assert n[0].overflow == 0 && n[0].count[0] == 48 && reference_match(p[..], n[..], 0.1);
  // Particle 49 joins the row: 50 particles with 49 neighbors each.
  p[0].pos[49] = d3(0.5 + 0.001 * 49.0, 0.5, 0.5);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none;
  #assert n[0].overflow == 50 && n[0].count[0] == 49 && reference_match(p[..], n[..], 0.1);
  // Nothing is written past a particle's PLIST slots: the lone particle's stay empty.
  #assert n[0].count[50] == 0 && n[0].list[50 * PLIST] == 0;
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.1) == Pgrid_Refusal.none && n[0].overflow == 50;
}

#test "the reference rejects a wrong answer" {
  p: [1] Pstore; n: [1] Pneighbors;
  _ := pstore_add(p[..], d3(0.5, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);
  _ = pstore_add(p[..], d3(0.6, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);
  _ = pstore_add(p[..], d3(0.5, 0.55, 0.5), D3_ZERO, 1.0, 0, 0);
  _ = pstore_add(p[..], d3(0.75, 0.5, 0.5), D3_ZERO, 1.0, 0, 0);   // exactly h = 0.25 from particle 0
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.25) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.25);
  #assert n[0].count[0] == 2 && n[0].list[0] == 1 && n[0].list[1] == 2;
  n[0].count[0] = 3; #assert !reference_match(p[..], n[..], 0.25); n[0].count[0] = 2;
  n[0].list[0] = 0; #assert !reference_match(p[..], n[..], 0.25);
  n[0].list[0] = 3; #assert !reference_match(p[..], n[..], 0.25);
  n[0].list[0] = 1; n[0].list[1] = 1; #assert !reference_match(p[..], n[..], 0.25);
  n[0].list[1] = 2; #assert reference_match(p[..], n[..], 0.25);
}

#test "fixed costs and the jitter's streams" {
  p: [1] Pstore; n: [1] Pneighbors;
  test_cloud(p[..], 200, 1, 1.0, false);
  #assert search(p[..], n[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.15) == Pgrid_Refusal.none && n[0].tests == CLOUD_TESTS;
  // A small grid, two cells a side: edges and wraps are where a bound slips.
  test_cloud(p[..], 40, 3, 1.0, false);
  #assert search(p[..], n[..], D3_ZERO, d3(0.99, 0.99, 0.99), 0.5) == Pgrid_Refusal.none && reference_match(p[..], n[..], 0.5) && n[0].tests == 40 * 39;
  // The same on a grid that held a larger build: its old starts past the
  // new cells are never read.
  g: [1] Pgrid;
  #assert pgrid_new(g[..], D3_ZERO, d3(1.0, 1.0, 1.0), 0.34) == Pgrid_Refusal.none && pgrid_build(p[..], g[..]) == Pgrid_Refusal.none;
  #assert g[0].start[13] - g[0].start[9] > 3;
  #assert pgrid_new(g[..], D3_ZERO, d3(0.99, 0.99, 0.99), 0.5) == Pgrid_Refusal.none && pgrid_build(p[..], g[..]) == Pgrid_Refusal.none;
  pgrid_neighbors(p[..], g[..], n[..]);
  #assert reference_match(p[..], n[..], 0.5) && n[0].tests == 40 * 39;
  // A box sampled away from the origin holds the same count.
  p[0].count = 0;
  #assert psample_box(p[..], d3(1.0, 1.0, 1.0), d3(1.5, 1.4, 1.3), 0.05, 1000.0, 0.0, 1, 2, 7) == 480;
  // Point k takes jitter streams 3k, 3k + 1 and 3k + 2 of stream 23.
  p[0].count = 0;
  _ := psample_box(p[..], D3_ZERO, d3(0.2, 0.2, 0.2), 0.05, 1.0, 0.5, 9, 0, 0);
  for k: 0..<3 {
    c := d3((cast(f64) k + 0.5) * 0.05, 0.025, 0.025);
    j := d3(cast(f64) rand_unit(9, 23, 3 * k) - 0.5, cast(f64) rand_unit(9, 23, 3 * k + 1) - 0.5, cast(f64) rand_unit(9, 23, 3 * k + 2) - 0.5);
    #assert d3_eq(p[0].pos[k], d3_add(c, d3_scale(j, 0.5 * 0.05)));
  }
}
