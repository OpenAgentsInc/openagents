// The scene: Aethyr Part IV's container (book chapter 17). A Scene_Spec
// describes a world as data: entities, each a shape (geometry and pose), a
// material (which solver, and its parameters) and an appearance (how it is
// drawn, and nothing else). scene_build admits the spec against a published
// compatibility matrix, then lays each solver's state out as its own arrays,
// so an entity becomes a handle (solver, first, count) and stepping never
// allocates, looks anything up or changes shape.
//
//   scene_admit(spec)            the first refusal, or none; nothing is built
//   scene_build(spec, s)         admit, then build into s[0]: a Refusal
//   scene_step(s)                one step: per substep, each solver in order
//   scene_schedule(out)          the stages of one substep, in order
//   scene_digest(s)              FNV-1a over the state's bits and step count
//   scene_body_y(s, h, i)        read one value through a handle
//   scene_push(s, h, dvy)        add to the vertical velocity of h's slice
//
// The two solvers here are deliberately small: "rigid" moves each body's
// centre of mass under gravity and stops it on the ground plane, and
// "particles" does the same for the points a shape is sampled into. Chapter
// 18 replaces the rigid solver; the container, handles, admission and the
// recorded schedule are what this chapter fixes. A reset is a value copy:
// Scene holds no views, so a copied Scene is a snapshot.
//   coax/bin/coax test --library aethyr/physics/sim/scene.coax
#authority;

SV3 :: struct { x: f64; y: f64; z: f64; }

Solver :: enum u8 { none; ground; rigid; particles; }
Backend :: enum u8 { cpu; metal; cuda; webgpu; }
Precision :: enum u8 { double; single; }
Shape_Kind :: enum u8 { plane; box; sphere; }

Shape :: struct { kind: Shape_Kind; size: SV3; at: SV3; }
Material :: struct { solver: Solver; density: f64; }
Appearance :: struct { rgba: u32; }
Entity :: struct { shape: Shape; material: Material; appearance: Appearance; }

SCENE_ENTITIES :: 8;
SCENE_RIGID :: 8;
SCENE_POINTS :: 64;
// A particle shape is sampled into a 2 x 2 x 2 lattice of points. The
// capacities hold any admitted spec: at most 8 rigid bodies, 8 x 8 points.
SAMPLES :: 8;

Scene_Spec :: struct {
  entities: [SCENE_ENTITIES] Entity;
  count: int;
  gravity: f64 = -9.81;
  dt: f64 = 0.01;
  substeps: int = 1;
  backend: Backend;
  gradients: bool;
  precision: Precision;
}

Handle :: struct { solver: Solver; first: int; count: int; }

Scene :: struct {
  handles: [SCENE_ENTITIES] Handle;
  entities: int;
  ground_y: f64;
  gravity: f64;
  dt: f64;
  substeps: int;
  steps: int;
  rigid: int;
  ry: [SCENE_RIGID] f64;      // centre height
  rvy: [SCENE_RIGID] f64;     // vertical velocity
  rh: [SCENE_RIGID] f64;      // half height: the centre rests this far up
  rx: [SCENE_RIGID] f64;
  rz: [SCENE_RIGID] f64;
  rmass: [SCENE_RIGID] f64;
  points: int;
  py: [SCENE_POINTS] f64;
  pvy: [SCENE_POINTS] f64;
  px: [SCENE_POINTS] f64;
  pz: [SCENE_POINTS] f64;
}

Refusal :: enum u8 {
  none;
  no_entities; too_many_entities; bad_time_step; bad_substeps;
  ground_not_a_plane; one_ground_only; rigid_needs_box_or_sphere; rigid_needs_density;
  particles_need_box_or_sphere;
  // From the compatibility matrix.
  backend_not_built; no_backward_pass; needs_f64;
}

// ---- the compatibility matrix, as data

// One row per (solver, backend): what this engine supports. A gradient run
// needs a backward pass (chapter 32) and no solver has one yet; single
// precision is refused because the ground contact compares f64 heights.
Matrix_Row :: struct { solver: Solver; backend: Backend; built: bool; }

MATRIX :: [12] Matrix_Row.[
  Matrix_Row.{solver = Solver.ground, backend = Backend.cpu, built = true},
  Matrix_Row.{solver = Solver.ground, backend = Backend.metal, built = false},
  Matrix_Row.{solver = Solver.ground, backend = Backend.cuda, built = false},
  Matrix_Row.{solver = Solver.ground, backend = Backend.webgpu, built = false},
  Matrix_Row.{solver = Solver.rigid, backend = Backend.cpu, built = true},
  Matrix_Row.{solver = Solver.rigid, backend = Backend.metal, built = false},
  Matrix_Row.{solver = Solver.rigid, backend = Backend.cuda, built = false},
  Matrix_Row.{solver = Solver.rigid, backend = Backend.webgpu, built = false},
  Matrix_Row.{solver = Solver.particles, backend = Backend.cpu, built = true},
  Matrix_Row.{solver = Solver.particles, backend = Backend.metal, built = false},
  Matrix_Row.{solver = Solver.particles, backend = Backend.cuda, built = false},
  Matrix_Row.{solver = Solver.particles, backend = Backend.webgpu, built = false}];

matrix_built :: (solver: Solver, backend: Backend) -> bool #effects(all) {
  for row: MATRIX {
    if row.solver == solver && row.backend == backend { return row.built; }
  }
  return false;
}

// ---- admission: every refusal before anything is built

// The first refusal for spec, in entity order, or Refusal.none.
scene_admit :: (spec: Scene_Spec) -> Refusal #effects(all) {
  if spec.count < 1 { return Refusal.no_entities; }
  if spec.count > SCENE_ENTITIES { return Refusal.too_many_entities; }
  if !(spec.dt > 0.0) { return Refusal.bad_time_step; }
  if spec.substeps < 1 { return Refusal.bad_substeps; }
  grounds := 0;
  for i: 0..<spec.count {
    e := spec.entities[i];
    m := e.material.solver;
    if !matrix_built(m, spec.backend) { return Refusal.backend_not_built; }
    if spec.gradients { return Refusal.no_backward_pass; }
    if spec.precision != Precision.double { return Refusal.needs_f64; }
    if m == Solver.ground {
      if e.shape.kind != Shape_Kind.plane { return Refusal.ground_not_a_plane; }
      grounds += 1;
      if grounds > 1 { return Refusal.one_ground_only; }
    } else {
      if e.shape.kind == Shape_Kind.plane {
        return ifx m == Solver.rigid then Refusal.rigid_needs_box_or_sphere else Refusal.particles_need_box_or_sphere;
      }
      if m == Solver.rigid && !(e.material.density > 0.0) { return Refusal.rigid_needs_density; }
    }
  }
  return Refusal.none;
}

// ---- build

// The height of a shape's centre above its lowest point.
half_height :: (shape: Shape) -> f64 #effects(all) {
  return ifx shape.kind == Shape_Kind.sphere then shape.size.x else shape.size.y * 0.5;
}

volume :: (shape: Shape) -> f64 #effects(all) {
  r := shape.size.x;
  return ifx shape.kind == Shape_Kind.sphere then 4.0 / 3.0 * 3.141592653589793 * r * r * r
         else shape.size.x * shape.size.y * shape.size.z;
}

scene_build :: (spec: Scene_Spec, s: [] Scene) -> Refusal #effects(all) {
  refusal := scene_admit(spec);
  if refusal != Refusal.none { return refusal; }
  built: Scene;
  built.entities = spec.count;
  built.gravity = spec.gravity;
  built.dt = spec.dt;
  built.substeps = spec.substeps;
  for i: 0..<spec.count {
    e := spec.entities[i];
    m := e.material.solver;
    if m == Solver.ground {
      built.ground_y = e.shape.at.y;
      built.handles[i] = Handle.{solver = m, first = 0, count = 0};
    } else if m == Solver.rigid {
      k := built.rigid;
      built.rx[k] = e.shape.at.x;
      built.ry[k] = e.shape.at.y;
      built.rz[k] = e.shape.at.z;
      built.rh[k] = half_height(e.shape);
      built.rmass[k] = e.material.density * volume(e.shape);
      built.handles[i] = Handle.{solver = m, first = k, count = 1};
      built.rigid = k + 1;
    } else {
      // Sample the shape's bounding box at its eight corners, half way in.
      first := built.points;
      h := half_height(e.shape);
      w := ifx e.shape.kind == Shape_Kind.sphere then e.shape.size.x else e.shape.size.x * 0.5;
      d := ifx e.shape.kind == Shape_Kind.sphere then e.shape.size.x else e.shape.size.z * 0.5;
      for c: 0..<SAMPLES {
        k := first + c;
        built.px[k] = e.shape.at.x + ifx c & 1 == 0 then -0.5 * w else 0.5 * w;
        built.py[k] = e.shape.at.y + ifx c & 2 == 0 then -0.5 * h else 0.5 * h;
        built.pz[k] = e.shape.at.z + ifx c & 4 == 0 then -0.5 * d else 0.5 * d;
      }
      built.handles[i] = Handle.{solver = m, first = first, count = SAMPLES};
      built.points = first + SAMPLES;
    }
  }
  s[0] = built;
  return Refusal.none;
}

// ---- step: a fixed schedule

Stage :: enum u8 { controls; prepare; rigid; particles; exchange; finalize; }

// The stages of one step, in order: controls once, then per substep the
// coupler's prepare, each solver, the coupler's exchange, then finalize.
// Returns how many stages one substep's list holds.
scene_schedule :: (out: [] Stage) -> int #effects(all) {
  out[0] = Stage.controls;
  out[1] = Stage.prepare;
  out[2] = Stage.rigid;
  out[3] = Stage.particles;
  out[4] = Stage.exchange;
  out[5] = Stage.finalize;
  return 6;
}

// Semi-implicit Euler under gravity, stopped on the ground plane.
fall :: (y: f64, vy: f64, rest: f64, g: f64, h: f64, out: [] f64) #effects(all) {
  v := vy + g * h;
  next := y + v * h;
  if next < rest { next = rest; v = 0.0; }
  out[0] = next;
  out[1] = v;
}

scene_step :: (s: [] Scene) #effects(all) {
  h := s[0].dt / cast(f64) s[0].substeps;
  pair: [2] f64;
  for sub: 0..<s[0].substeps {
    // prepare: no coupler yet.
    for k: 0..<s[0].rigid {
      fall(s[0].ry[k], s[0].rvy[k], s[0].ground_y + s[0].rh[k], s[0].gravity, h, pair[..]);
      s[0].ry[k] = pair[0];
      s[0].rvy[k] = pair[1];
    }
    for k: 0..<s[0].points {
      fall(s[0].py[k], s[0].pvy[k], s[0].ground_y, s[0].gravity, h, pair[..]);
      s[0].py[k] = pair[0];
      s[0].pvy[k] = pair[1];
    }
    // exchange: no coupler yet.
  }
  s[0].steps += 1;
}

// ---- digest and handles

fnv :: (h: u64, word: u64) -> u64 #effects(all) {
  return mul_wrap(h ^ word, 1099511628211);
}

// FNV-1a over the step count and every live state value's bits. Appearance
// is not state, so it can't change the digest.
scene_digest :: (s: Scene) -> u64 #effects(all) {
  h: u64 = 14695981039346656037;
  h = fnv(h, cast(u64) s.steps);
  for k: 0..<s.rigid {
    h = fnv(fnv(fnv(h, f64_bits(s.rx[k])), f64_bits(s.ry[k])), f64_bits(s.rz[k]));
    h = fnv(fnv(h, f64_bits(s.rvy[k])), f64_bits(s.rmass[k]));
  }
  for k: 0..<s.points {
    h = fnv(fnv(fnv(fnv(h, f64_bits(s.px[k])), f64_bits(s.py[k])), f64_bits(s.pz[k])), f64_bits(s.pvy[k]));
  }
  return h;
}

// The height of value i in handle h's slice; NaN for an i outside it.
scene_body_y :: (s: Scene, h: Handle, i: int) -> f64 #effects(all) {
  if i < 0 || i >= h.count { return 0.0 / 0.0; }
  // A rigid body's slice is one value, so i is 0 there.
  return ifx h.solver == Solver.rigid then s.ry[h.first] else s.py[h.first + i];
}

// Add dvy to the vertical velocity of every value in h's slice: a control.
scene_push :: (s: [] Scene, h: Handle, dvy: f64) #effects(all) {
  for i: 0..<h.count {
    if h.solver == Solver.rigid { s[0].rvy[h.first] += dvy; }   // one value
    else { s[0].pvy[h.first + i] += dvy; }
  }
}

// ---- checks

// A plane, a 1 m box of density 500 at 2 m and a 0.5 m sphere of particles at 4 m.
demo_spec :: () -> Scene_Spec #effects(all) {
  spec: Scene_Spec;
  spec.count = 3;
  spec.entities[0] = Entity.{shape = Shape.{kind = Shape_Kind.plane}, material = Material.{solver = Solver.ground}};
  spec.entities[1] = Entity.{shape = Shape.{kind = Shape_Kind.box, size = SV3.{x = 1, y = 1, z = 1}, at = SV3.{x = 1.5, y = 2, z = -2}},
                             material = Material.{solver = Solver.rigid, density = 500}};
  spec.entities[2] = Entity.{shape = Shape.{kind = Shape_Kind.sphere, size = SV3.{x = 0.5}, at = SV3.{x = 3, y = 4, z = 0}},
                             material = Material.{solver = Solver.particles}};
  return spec;
}

#forall "the matrix builds every solver on the CPU and nothing else" solver: 0..<4, backend: 0..<4 {
  built := matrix_built(cast(Solver) solver, cast(Backend) backend);
  #assert built == (solver > 0 && backend == 0);
}

#test "the demo spec is admitted and every refusal is named" {
  #assert scene_admit(demo_spec()) == Refusal.none;
  s := demo_spec(); s.count = 0;
  #assert scene_admit(s) == Refusal.no_entities;
  s = demo_spec(); s.count = 1;
  #assert scene_admit(s) == Refusal.none;
  s = demo_spec(); s.count = SCENE_ENTITIES + 1;
  #assert scene_admit(s) == Refusal.too_many_entities;
  s = demo_spec(); s.count = SCENE_ENTITIES;
  for i: 3..<SCENE_ENTITIES { s.entities[i] = s.entities[1]; }
  #assert scene_admit(s) == Refusal.none;
  s = demo_spec(); s.dt = 0;
  #assert scene_admit(s) == Refusal.bad_time_step;
  s = demo_spec(); s.dt = 0.0 / 0.0;
  #assert scene_admit(s) == Refusal.bad_time_step;
  s = demo_spec(); s.substeps = 0;
  #assert scene_admit(s) == Refusal.bad_substeps;
  s = demo_spec(); s.backend = Backend.metal;
  #assert scene_admit(s) == Refusal.backend_not_built;
  s = demo_spec(); s.gradients = true;
  #assert scene_admit(s) == Refusal.no_backward_pass;
  s = demo_spec(); s.precision = Precision.single;
  #assert scene_admit(s) == Refusal.needs_f64;
  s = demo_spec(); s.entities[0].shape.kind = Shape_Kind.box;
  #assert scene_admit(s) == Refusal.ground_not_a_plane;
  s = demo_spec(); s.count = 4; s.entities[3] = s.entities[0];
  #assert scene_admit(s) == Refusal.one_ground_only;
  s = demo_spec(); s.entities[1].shape.kind = Shape_Kind.plane;
  #assert scene_admit(s) == Refusal.rigid_needs_box_or_sphere;
  s = demo_spec(); s.entities[2].shape.kind = Shape_Kind.plane;
  #assert scene_admit(s) == Refusal.particles_need_box_or_sphere;
  s = demo_spec(); s.entities[1].material.density = 0;
  #assert scene_admit(s) == Refusal.rigid_needs_density;
  s = demo_spec(); s.entities[1].material.solver = Solver.none;
  #assert scene_admit(s) == Refusal.backend_not_built;
}

#test "capacity is refused before anything is built" {
  s: Scene_Spec;
  s.count = SCENE_ENTITIES;
  for i: 0..<SCENE_ENTITIES { s.entities[i] = demo_spec().entities[2]; }
  #assert scene_admit(s) == Refusal.none;   // 8 shapes of 8 points: exactly 64
  out: [1] Scene;
  #assert scene_build(s, out[..]) == Refusal.none && out[0].points == SCENE_POINTS;
  r: Scene_Spec;
  r.count = SCENE_ENTITIES;
  for i: 0..<SCENE_ENTITIES { r.entities[i] = demo_spec().entities[1]; }
  #assert scene_admit(r) == Refusal.none && scene_build(r, out[..]) == Refusal.none && out[0].rigid == SCENE_RIGID;
}

#test "build lays each solver out as arrays and gives handles" {
  s: [1] Scene;
  s[0].steps = 99;
  bad := demo_spec(); bad.gradients = true;
  #assert scene_build(bad, s[..]) == Refusal.no_backward_pass && s[0].steps == 99;   // refused: nothing written
  #assert scene_build(demo_spec(), s[..]) == Refusal.none;
  b := s[0];
  #assert b.steps == 0 && b.entities == 3 && b.rigid == 1 && b.points == 8 && b.substeps == 1;
  #assert b.gravity == -9.81 && b.dt == 0.01 && b.ground_y == 0.0;
  #assert b.handles[0].solver == Solver.ground && b.handles[0].count == 0 && b.handles[0].first == 0;
  #assert b.handles[1].solver == Solver.rigid && b.handles[1].first == 0 && b.handles[1].count == 1;
  #assert b.handles[2].solver == Solver.particles && b.handles[2].first == 0 && b.handles[2].count == 8;
  #assert b.rx[0] == 1.5 && b.ry[0] == 2.0 && b.rz[0] == -2.0 && b.rh[0] == 0.5 && b.rmass[0] == 500.0;
  // Corners of the sphere's bounding box, half way in: x 3 -+ 0.25, y 4 -+ 0.25.
  #assert b.px[0] == 2.75 && b.py[0] == 3.75 && b.pz[0] == -0.25;
  #assert b.px[7] == 3.25 && b.py[7] == 4.25 && b.pz[7] == 0.25;
  for c: 0..<8 {
    #assert b.px[c] == ifx c % 2 == 0 then 2.75 else 3.25;
    #assert b.py[c] == ifx (c / 2) % 2 == 0 then 3.75 else 4.25;
    #assert b.pz[c] == ifx c / 4 == 0 then -0.25 else 0.25;
  }
  #assert b.pvy[0] == 0.0 && b.rvy[0] == 0.0;
  ground := demo_spec(); ground.entities[0].shape.at.y = -1;
  #assert scene_build(ground, s[..]) == Refusal.none && s[0].ground_y == -1.0;
}

#test "a sphere's half height and volume, a box's from its size" {
  ball := Shape.{kind = Shape_Kind.sphere, size = SV3.{x = 2}};
  #assert half_height(ball) == 2.0 && volume(ball) == 4.0 / 3.0 * 3.141592653589793 * 8.0;
  box := Shape.{kind = Shape_Kind.box, size = SV3.{x = 2, y = 3, z = 5}};
  #assert half_height(box) == 1.5 && volume(box) == 30.0;
  spec := demo_spec(); spec.entities[1].shape = ball;
  s: [1] Scene;
  #assert scene_build(spec, s[..]) == Refusal.none && s[0].rh[0] == 2.0 && s[0].rmass[0] == 500.0 * volume(ball);
  flat := demo_spec(); flat.entities[2].shape = box;
  #assert scene_build(flat, s[..]) == Refusal.none;
  #assert s[0].px[0] == -0.5 && s[0].py[0] == -0.75 && s[0].pz[0] == -1.25 && s[0].pz[7] == 1.25;
}

#test "one step: semi-implicit Euler, then rest on the ground" {
  pair: [2] f64;
  fall(2.0, 0.0, 0.5, -10.0, 0.1, pair[..]);
  #assert pair[1] == -1.0 && pair[0] == 2.0 - 0.1;
  fall(0.55, -1.0, 0.5, -10.0, 0.1, pair[..]);
  #assert pair[0] == 0.5 && pair[1] == 0.0;
  fall(0.5, 0.0, 0.5, 0.0, 0.1, pair[..]);
  #assert pair[0] == 0.5 && pair[1] == 0.0;
  fall(0.625, -1.25, 0.5, 0.0, 0.1, pair[..]);   // lands exactly on the rest height: still moving
  #assert pair[0] == 0.5 && pair[1] == -1.25;
  s: [1] Scene;
  spec := demo_spec(); spec.substeps = 2; spec.gravity = -10;
  #assert scene_build(spec, s[..]) == Refusal.none;
  scene_step(s[..]);
  // Two substeps of 0.005 s: v = -0.05 then -0.1; y = 2 - 0.00025 - 0.0005.
  #assert s[0].steps == 1 && s[0].rvy[0] == -0.1 && s[0].pvy[3] == -0.1;
  #assert s[0].ry[0] == 2.0 + (-0.05 * 0.005) + (-0.1 * 0.005);
  for i: 0..<400 { scene_step(s[..]); }
  #assert s[0].ry[0] == 0.5 && s[0].rvy[0] == 0.0 && s[0].py[0] == 0.0 && s[0].py[7] == 0.0;
}

#test "the schedule is fixed" {
  for fill: 0..<2 {
    st: [6] Stage;
    for i: 0..<6 { st[i] = ifx fill == 0 then Stage.finalize else Stage.controls; }
    #assert scene_schedule(st[..]) == 6;
    #assert st[0] == Stage.controls && st[1] == Stage.prepare && st[2] == Stage.rigid;
    #assert st[3] == Stage.particles && st[4] == Stage.exchange && st[5] == Stage.finalize;
  }
}

#test "the same spec gives the same digests, and a reset replays them bit for bit" {
  a: [1] Scene; b: [1] Scene;
  #assert scene_build(demo_spec(), a[..]) == Refusal.none && scene_build(demo_spec(), b[..]) == Refusal.none;
  #assert scene_digest(a[0]) == scene_digest(b[0]);
  snapshot: Scene;
  digests: [1000] u64;
  for i: 0..<1000 {
    if i == 37 { snapshot = a[0]; }
    scene_step(a[..]); scene_step(b[..]);
    digests[i] = scene_digest(a[0]);
    #assert digests[i] == scene_digest(b[0]);
  }
  #assert digests[0] != digests[1] && digests[998] != digests[999];   // the step count moves
  a[0] = snapshot;
  for i: 37..<1000 { scene_step(a[..]); #assert scene_digest(a[0]) == digests[i]; }
}

#test "appearance never changes the digest; every state value does" {
  painted := demo_spec();
  painted.entities[1].appearance.rgba = 0x00ff00ff;
  painted.entities[2].appearance.rgba = 0;
  a: [1] Scene; b: [1] Scene;
  #assert scene_build(demo_spec(), a[..]) == Refusal.none && scene_build(painted, b[..]) == Refusal.none;
  for i: 0..<50 { scene_step(a[..]); scene_step(b[..]); }
  #assert scene_digest(a[0]) == scene_digest(b[0]);
  base := scene_digest(a[0]);
  for field: 0..<10 {
    c := a[0];
    if field == 0 { c.steps += 1; }
    if field == 1 { c.rx[0] += 1; }
    if field == 2 { c.ry[0] += 1; }
    if field == 3 { c.rz[0] += 1; }
    if field == 4 { c.rvy[0] += 1; }
    if field == 5 { c.rmass[0] += 1; }
    if field == 6 { c.px[7] += 1; }
    if field == 7 { c.py[7] += 1; }
    if field == 8 { c.pz[7] += 1; }
    if field == 9 { c.pvy[7] += 1; }
    #assert scene_digest(c) != base;
  }
  #assert fnv(0, 0) == 0 && fnv(1, 0) == 1099511628211 && fnv(0, 3) == 3 * 1099511628211;
  empty: Scene;
  offset: u64 = 14695981039346656037;
  #assert scene_digest(empty) == mul_wrap(offset, 1099511628211);
  #assert painted.entities[1].appearance.rgba == 0x00ff00ff;
  first := a[0]; first.px[0] += 1;
  #assert scene_digest(first) != base;
}

#test "a write through a handle changes exactly that slice" {
  s: [1] Scene;
  #assert scene_build(demo_spec(), s[..]) == Refusal.none;
  before := s[0];
  scene_push(s[..], s[0].handles[2], 2.5);
  for k: 0..<s[0].points { #assert s[0].pvy[k] == 2.5; }
  #assert s[0].rvy[0] == 0.0;
  scene_push(s[..], s[0].handles[1], -1.0);
  #assert s[0].rvy[0] == -1.0 && s[0].pvy[0] == 2.5;
  scene_push(s[..], s[0].handles[0], 9.0);   // the ground has no slice
  #assert s[0].rvy[0] == -1.0 && s[0].pvy[7] == 2.5;
  #assert scene_body_y(s[0], s[0].handles[1], 0) == 2.0 && scene_body_y(s[0], s[0].handles[2], 7) == 4.25;
  #assert scene_body_y(before, before.handles[2], 0) == 3.75;
  for i: -1..<2 {
    y := scene_body_y(s[0], s[0].handles[1], i);
    #assert (y == y) == (i == 0);   // NaN outside the slice
  }
  #assert scene_body_y(s[0], s[0].handles[2], 8) != scene_body_y(s[0], s[0].handles[2], 8);
  // Second entities of each solver: their slices start past the first.
  two := demo_spec(); two.count = 5;
  two.entities[3] = two.entities[1]; two.entities[3].shape.at.y = 7;
  two.entities[4] = two.entities[2]; two.entities[4].shape.at.y = 9;
  t: [1] Scene;
  #assert scene_build(two, t[..]) == Refusal.none;
  #assert t[0].handles[3].first == 1 && t[0].handles[4].first == 8;
  #assert scene_body_y(t[0], t[0].handles[3], 0) == 7.0 && scene_body_y(t[0], t[0].handles[4], 1) == 8.75;
  scene_push(t[..], t[0].handles[3], 4.0);
  scene_push(t[..], t[0].handles[4], 3.0);
  #assert t[0].rvy[0] == 0.0 && t[0].rvy[1] == 4.0 && t[0].pvy[7] == 0.0 && t[0].pvy[8] == 3.0 && t[0].pvy[15] == 3.0;
}
