// A page's graphics quality, wired once (GitHub #13147): what every realm does round its
// `Quality` (quality.coax) so the governor runs the same way on each. A realm keeps one
// `QualityPage` and:
//   - hands it the page's facts (host message 600, qp_facts) and the GPU's (613, qp_gpu);
//   - calls qp_frame every frame with the frame's length and the picture's size, and says whether
//     its scene is drawing yet (the measured start waits for it);
//   - answers the host's pixel budget with qp_pixels (coaxial_pixel_budget);
//   - reads the knobs the frame draws with from `kn` (the reaches eased, so nothing pops);
//   - sends what qp_tell asks (host action 6: the tier to keep in verse.quality; 33: the rung AUTO
//     settled at, kept in verse.quality.settled) when it has no other action to send;
//   - shows qp_label beside its frame rate, and calls qp_pick(quality_next(mode)) on a tap.
// A golden frame holds the rung its screen's size alone gives, so a golden is the same on every
// machine. It never decides its graphics anywhere else.
//   coax/bin/coax test aethyr/quality-page.coax

#module "aethyr.qualitypage";
#load "quality.coax";

QP_ACT_QUALITY :: 6;    // host: the tier to keep in verse.quality (and draw at)
QP_ACT_SETTLED :: 33;   // host: the rung AUTO settled at, kept in verse.quality.settled
QP_HOST_GPU :: 613;     // host message: the adapter's facts, once it opens
QP_KNOB_EASE :: 0.34;   // a reach knob's change a second: a step thins or fills in over about 3 s

QualityPage :: struct {
  q: [1] Quality; ready: bool;
  dev: QualityDevice; facts: bool; mode: int = QUALITY_AUTO; tell: bool;   // the page's device and the player's pick
  settled: [QUALITY_CLASSES] int;   // the rung each class settled at on an earlier visit (-1 none; read only with facts)
  kn: QualityKnobs; kn_ready: bool; golden: bool;   // the rung's knobs as the frame uses them
}
QpTell :: struct { action: int; n: int; }

// The page's facts (host message 600): the device, ?quality= and the tier this browser kept.
qp_facts :: (p: [] QualityPage, t: string) {
  p[0].dev = quality_device_from_facts(t); p[0].mode = quality_mode_from_facts(t);
  p[0].tell = quality_url_new(t); p[0].facts = true;
  for c: 0..<QUALITY_CLASSES { p[0].settled[c] = quality_settled_from_facts(t, c); }
  p[0].ready = false;   // started again from these facts on the next frame
}
// The GPU's facts (host message 613): the device's class may change with them, so the governor
// starts again, unless the measured start has already begun.
qp_gpu :: (p: [] QualityPage, t: string) {
  g := quality_gpu_from_facts(t);
  if g == p[0].dev.gpu { return; }
  p[0].dev.gpu = g;
  if !p[0].q[0].probed && p[0].q[0].probe < 0 { p[0].ready = false; }
}
qp_device :: (p: [] QualityPage, w: f32, h: f32, dpr: f32) -> QualityDevice {
  d: QualityDevice; if p[0].facts && !p[0].golden { d = p[0].dev; }
  k := ifx dpr > 0.01 then dpr else 1.0f32;
  if w >= 1 && h >= 1 { d.css_w = w / k; d.css_h = h / k; d.dpr = k; }
  return d;
}
qp_ease :: (at: f32, to: f32, dt: f32) -> f32 {
  step := f32(QP_KNOB_EASE) * (ifx dt > 0.25 then 0.25f32 else dt);
  return ifx to > at + step then at + step else ifx to < at - step then at - step else to;
}
// A frame: its length (s), the picture's size in device pixels and their scale, whether it is a
// golden frame, and whether the realm's scene is drawing (the measured start begins then).
qp_frame :: (p: [] QualityPage, dt: f32, w: f32, h: f32, dpr: f32, golden: bool, drawing: bool) {
  p[0].golden = golden;
  if !p[0].ready || golden {
    if w < 1 || h < 1 { return; }
    d := qp_device(p, w, h, dpr);
    if golden { quality_start(p[0].q[..], d, QUALITY_AUTO); }
    else { k := quality_device_class(d); quality_start_settled(p[0].q[..], d, p[0].mode, ifx p[0].facts then p[0].settled[k] else -1); }
    p[0].ready = true;
  } else {
    if !p[0].q[0].probed && p[0].q[0].probe < 0 && drawing { quality_probe_begin(p[0].q[..]); }
    _ := quality_frame(p[0].q[..], dt);
  }
  t := quality_rung_knobs(p[0].q[0].rung);
  if golden || !p[0].kn_ready { p[0].kn = t; p[0].kn_ready = true; return; }
  k := p[0].kn;
  k.grass = qp_ease(k.grass, t.grass, dt); k.fine = qp_ease(k.fine, t.fine, dt); k.scenery = qp_ease(k.scenery, t.scenery, dt);
  k.scale = t.scale; k.debris = t.debris; k.fx = t.fx; k.shadow = t.shadow; k.post = t.post; k.crowd = t.crowd;
  p[0].kn = k;
}
// What the host should keep now, written into out: nothing (action 0), the rung AUTO settled at,
// or the tier the player picked. The realm calls it only when it has no other action to send.
qp_tell :: (p: [] QualityPage, out: [] u8) -> QpTell {
  if !p[0].ready || p[0].golden { return QpTell.{}; }
  if p[0].tell {
    p[0].tell = false;
    return QpTell.{action = QP_ACT_QUALITY, n = quality_put(out, 0, QUALITY_HOST[p[0].q[0].mode])};
  }
  if quality_settled_due(p[0].q[..]) {
    n := quality_settled_text(out, p[0].q[0].kind, p[0].q[0].rung); quality_settled_kept(p[0].q[..]);
    return QpTell.{action = QP_ACT_SETTLED, n = n};
  }
  return QpTell.{};
}
// The pixels a frame draws at most: the governor's; before it starts, the start rung's for the
// device the facts (or the picture) give; 0 when there is neither yet.
qp_pixels :: (p: [] QualityPage, w: f32, h: f32, dpr: f32) -> int {
  k := ifx dpr > 0.01 then dpr else 1.0f32;
  if p[0].ready { return quality_pixels(p[0].q[..], w / k, h / k); }
  return quality_start_pixels(qp_device(p, w, h, dpr), p[0].mode);
}
// The player picks a tier or AUTO; the host is told to keep it (qp_tell).
qp_pick :: (p: [] QualityPage, mode: int) {
  quality_choose(p[0].q[..], mode); p[0].mode = p[0].q[0].mode; p[0].tell = true;
}
// "GFX AUTO · MED", or the tier the player picked; nothing on a golden frame or before the start.
qp_label :: (p: [] QualityPage, out: [] u8) -> string {
  if p[0].golden || !p[0].ready { return ""; }
  return quality_label(p[0].q[..], out);
}

// ---- checks

#test "quality page: AUTO starts from the facts, steps down while frames run long, and tells the host what to keep" #steps 200000000 {
  p: [1] QualityPage; out: [64] u8;
  // before any size there is no budget; with one, the start rung's
  #assert qp_pixels(p[..], 0, 0, 1) == 0 && qp_label(p[..], out[..]) == "";
  qp_facts(p[..], QUALITY_FACTS_MAC);
  qp_frame(p[..], 0, 3024, 1720, 2, false, false);
  #assert p[0].ready && quality_auto(p[0].q[..]) && p[0].q[0].kind == QUALITY_DESKTOP && p[0].q[0].rung == QUALITY_CLASS_RUNG[QUALITY_DESKTOP];
  start := p[0].q[0].rung; px := qp_pixels(p[..], 3024, 1720, 2);
  #assert px == quality_pixels(p[0].q[..], 1512, 860) && px > 0 && p[0].kn.scale == QUALITY_SCALE[start];
  // the measured start waits for the scene
  for i: 0..<30 { qp_frame(p[..], 0.05, 3024, 1720, 2, false, false); } #assert p[0].q[0].probe < 0 && !p[0].q[0].probed;
  // frames of 50 ms once it draws: the rung falls, and the pixels with it
  for i: 0..<400 { qp_frame(p[..], 0.05, 3024, 1720, 2, false, true); }
  #assert p[0].q[0].probed && p[0].q[0].rung < start && qp_pixels(p[..], 3024, 1720, 2) < px;
  l := qp_label(p[..], out[..]); #assert l.count > 8 && l[0..<8] == "GFX AUTO";
  // frames on time: it settles, and the host is told the rung once
  told := 0; for i: 0..<3000 { qp_frame(p[..], 0.0166, 3024, 1720, 2, false, true); t := qp_tell(p[..], out[..]); if t.action == QP_ACT_SETTLED { told += 1; #assert t.n >= 5; } else { #assert t.action == 0; } }
  #assert told >= 1;
}
#test "quality page: a pick holds its tier, the host keeps it, and the reach knobs ease while the others step" {
  p: [1] QualityPage; out: [64] u8;
  qp_frame(p[..], 0, 1280, 800, 1, false, true); #assert p[0].ready && p[0].kn.grass == 1;
  #assert qp_tell(p[..], out[..]).action == 0;
  qp_pick(p[..], QUALITY_LOW); #assert !quality_auto(p[0].q[..]) && quality_tier(p[0].q[..]) == QUALITY_LOW && p[0].mode == QUALITY_LOW;
  t := qp_tell(p[..], out[..]); #assert t.action == QP_ACT_QUALITY && cast(string) out[0..<t.n] == "low" && qp_tell(p[..], out[..]).action == 0;
  qp_frame(p[..], 0.016, 1280, 800, 1, false, true);
  want := quality_rung_knobs(QUALITY_TIER_RUNG[QUALITY_LOW]);
  #assert p[0].kn.scale == want.scale && p[0].kn.shadow == want.shadow && p[0].kn.post == want.post && p[0].kn.grass < 1 && p[0].kn.grass > want.grass;
  for i: 0..<400 { qp_frame(p[..], 0.016, 1280, 800, 1, false, true); } #assert p[0].kn.grass == want.grass && p[0].kn.scenery == want.scenery;
  #assert qp_pixels(p[..], 1280, 800, 1) == cast(int) (1280 * 800 * want.scale * want.scale) && qp_label(p[..], out[..]) == "GFX LOW";
  // frames that run long never move a picked tier
  for i: 0..<300 { qp_frame(p[..], 0.08, 1280, 800, 1, false, true); } #assert quality_tier(p[0].q[..]) == QUALITY_LOW && p[0].q[0].rung == QUALITY_TIER_RUNG[QUALITY_LOW];
  // ?quality=high in the facts starts there and is told to the host; a golden frame holds the screen's rung and tells nothing
  qp_facts(p[..], "url=https://x/worlds/y?quality=high\nvw=1280\nvh=800\ndpr=1\n"); qp_frame(p[..], 0, 1280, 800, 1, false, true);
  #assert quality_tier(p[0].q[..]) == QUALITY_HIGH && qp_tell(p[..], out[..]).action == QP_ACT_QUALITY;
  qp_frame(p[..], 0.016, 1280, 800, 1, true, true); #assert quality_auto(p[0].q[..]) && p[0].kn.grass == quality_knobs(p[0].q[..]).grass && qp_tell(p[..], out[..]).action == 0 && qp_label(p[..], out[..]) == "";
  // the GPU's facts restart the governor only before the measured start
  q: [1] QualityPage; qp_frame(q[..], 0, 1280, 800, 1, false, false); qp_gpu(q[..], "gpu_vendor=apple\ngpu_arch=metal-3\ngpu_fallback=0\n");
  #assert !q[0].ready && q[0].dev.gpu == QUALITY_GPU_APPLE;
  qp_frame(q[..], 0, 1280, 800, 1, false, true); qp_frame(q[..], 0.016, 1280, 800, 1, false, true); #assert q[0].q[0].probe >= 0 || q[0].q[0].probed;
  q[0].dev.gpu = QUALITY_GPU_NONE; qp_gpu(q[..], "gpu_vendor=apple\ngpu_arch=metal-3\ngpu_fallback=0\n"); #assert q[0].ready;
}
