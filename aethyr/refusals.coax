// Aethyr's compile-time refusals, checked: each fixture under aethyr/tests/<dir>/ names on
// its first line what the compiler must say about it, `// expect: ok` (it compiles: the
// control) or `// expect: E0822 ...` (it is refused with that code). Mixing spaces must
// fail to compile (aethyr/space.coax), and this is the check that it does.
//   coax/web/tool.sh aethyr/refusals.coax [DIR...]   (from the repo root; default spaces)
//   coax test aethyr/refusals.coax --library          (its own checks)
#import "Basic";
#load "../coax/lib/sys/tool.coax";
#load "../coax/lib/sys/fs.coax";
#load "../coax/lib/sys/proc.coax";

RF_COMPILER :: "coax/bin/coax";

// What a fixture's first line expects: "" for no such line, "ok", an error code such as E0822,
// or "?" for the tag alone.
rf_expect :: (text: string) -> string {
  tag := "// expect: ";
  if text.count < tag.count || text[0..<tag.count] != tag { return ""; }
  i := tag.count; j := i;
  while j < text.count && text[j] != ' ' && text[j] != '\n' && text[j] != '.' { j += 1; }
  if j == i { return "?"; }   // the tag with nothing after it: an expectation nothing meets
  return text[i..<j];
}
rf_has :: (s: string, part: string) -> bool {
  if part.count == 0 || part.count > s.count { return false; }
  for i: 0..<s.count - part.count + 1 { if s[i..<i + part.count] == part { return true; } }
  return false;
}
// Did the compiler do what the fixture expects?
rf_holds :: (expect: string, status: int, err: string) -> bool {
  if expect == "ok" { return status == 0; }
  return expect.count == 5 && expect[0] == 'E' && status != 0 && rf_has(err, expect);
}

#test "a fixture's expectation, and whether the compiler met it" {
  #assert rf_expect("// expect: ok. The control\n") == "ok" && rf_expect("// expect: E0822 metres\n") == "E0822";
  #assert rf_expect("// expect: E0317\n") == "E0317" && rf_expect("// nothing\n") == "" && rf_expect("") == "";
  #assert rf_expect("// expect: E0317") == "E0317" && rf_expect("// expect: ") == "?" && rf_expect("// expect:") == "";
  #assert rf_has("abc", "abc") && rf_has("abc", "a") && !rf_has("ab", "abc") && !rf_holds("?", 1, "?");
  #assert rf_holds("ok", 0, "") && !rf_holds("ok", 1, "");
  #assert rf_holds("E0822", 1, "x error[E0822]: y") && !rf_holds("E0822", 0, "error[E0822]") && !rf_holds("E0822", 1, "error[E0823]");
  #assert !rf_holds("", 1, "anything") && !rf_holds("E08", 1, "E08") && rf_has("abc", "c") && !rf_has("abc", "");
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { return 2; }
  dirs: [16] string; nd := 0;
  for i: 0..<args_count(a[..]) { if nd < 16 { dirs[nd] = args_at(a[..], i); nd += 1; } }
  if nd == 0 { dirs[0] = "spaces"; nd = 1; }
  bad := 0; ran := 0;
  path_buf: [4096] u8; dir_buf: [4096] u8; text: [65536] u8; out: [65536] u8; err: [65536] u8;
  for d: 0..<nd {
    dir := fs_join("aethyr/tests", dirs[d], dir_buf[..]);
    l: [1] FsList;
    n := fs_list(dir, l[..]);
    if n < 0 { tool_errln("refusals: no such folder (run from the repo root)"); return 2; }
    for k: 0..<n {
      name := fs_entry(l[..], k);
      if name.count < 6 || name[name.count - 5..<name.count] != ".coax" { continue; }
      path := fs_join(dir, name, path_buf[..]);
      m := fs_read(path, text[..]);
      expect := rf_expect(cast(string) text[0..<hi_int(m, 0)]);
      argv := [3] string.[RF_COMPILER, "check", path];
      r := proc_run(argv[..], 120000, out[..], err[..]);
      said := cast(string) err[0..<r.err_n];
      ran += 1;
      if r.started == 0 && !r.timed_out && rf_holds(expect, r.status, said) { print("ok   % (%)\n", path, expect); }
      else { print("FAIL % expected %, exit %: %\n", path, ifx expect.count > 0 then expect else "a // expect: line", r.status, said); bad += 1; }
    }
  }
  print("% fixtures, % held, % failed\n", ran, ran - bad, bad);
  return ifx bad == 0 && ran > 0 then 0 else 1;
}
hi_int :: (a: int, b: int) -> int { if a > b { return a; } return b; }
