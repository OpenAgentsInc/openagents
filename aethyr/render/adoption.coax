// Catalogue admission and actual consumer adoption are different facts.
// A newly published realm keeps its explicit existing renderer until its
// shared profile is implemented and qualified. Unknown identities refuse.
#load "catalog.coax";
#authority;
RenderAdoption :: struct { shared: bool; tracked_legacy: bool; profile: int = -1; }

// The document inspector retains its immutable source bundle and GPU upload
// image together. Ordinary pages keep the existing 64 MiB Wasm ceiling.
render_memory_pages :: (app:string)->int #effects(all) {return ifx app=="animationlab" then 4096 else 1024;}
#test "only the document inspector requests the bounded larger Wasm memory" {
  #assert render_memory_pages("animationlab")==4096;
  for app:[4]string.["", "animationla", "animelab", "valleycanyon"] {#assert render_memory_pages(app)==1024;}
}

#test "Animation Lab binds its isolated inspection renderer to its exact producer" {
  r:=render_adoption("animation-lab","animationlab");
  #assert r.tracked_legacy && !r.shared && r.profile== -1;
  #assert !render_adoption("animation-lab","animelab").tracked_legacy;
  #assert !render_adoption("animation-la","animationlab").tracked_legacy;
}

#test "Ocarina Lab binds its source renderer only to the unlisted Ocarina producer" {
  r:=render_adoption("ocarina-lab","ocarinalab");
  #assert r.tracked_legacy && !r.shared && r.profile== -1;
  #assert !render_adoption("ocarina-lab","animationlab").tracked_legacy;
  #assert !render_adoption("ocarina-labs","ocarinalab").tracked_legacy;
  #assert !render_adoption("animation-lab","ocarinalab").tracked_legacy;
}

#test "shared adoption binds each catalog slug to its actual producer" {
  for i: 0..<RENDER_CATALOG_COUNT {
    p := render_catalog(i); route := render_adoption(p.slug, p.app);
    if p.slug == "built" { continue; }   // tracked legacy for now (below)
    #assert route.shared && !route.tracked_legacy && route.profile == i;
    #assert !render_adoption(p.slug, "not-the-producer").shared;
  }
}
#test "Anime Lab remains an explicitly tracked legacy consumer" {
  route := render_adoption("anime-lab", "animelab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("anime-lab", "newland").tracked_legacy;
  #assert !render_adoption("the-grid", "animelab").tracked_legacy;
}
// The made-world template (myrealm) can't link its carrier yet: the carrier and YOUR COMPUTER's
// wire both load sha256-kernel.coax (#12661), so its module has no renderer facade and its page
// keeps the existing renderer.
#test "the made-world template is a tracked legacy consumer until its carrier links" {
  route := render_adoption("built", "myrealm");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("built", "not-myrealm").tracked_legacy;
  #assert !render_adoption("not-built", "myrealm").tracked_legacy;
}
// 5E Lab (the SRD engine's bare grid) draws with its own two passes until it has a catalog profile.
#test "5E Lab is a tracked legacy consumer" {
  route := render_adoption("5e-lab", "fivelab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("5e-lab", "watchtower").tracked_legacy;
}
// 5E MMO (the SRD engine's battle in Everglade's look) draws with Everglade's passes until it has a catalog profile.
#test "5E MMO is a tracked legacy consumer" {
  route := render_adoption("5e-mmo", "fivemmo");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("5e-mmo", "everglade").tracked_legacy;
}
// Everglade is the SRD 5e module (everglade5e.coax on everglade.coax) since the swap (#12710): it draws
// with Everglade's passes until the catalog's profile names its module. Everglade Classic, the old
// module, is a tracked legacy page under its own slug; /worlds/everglade-5e is a redirect, no page.
#test "Everglade on the 5E module and Everglade Classic are tracked legacy consumers" {
  route := render_adoption("everglade", "everglade5e");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  classic := render_adoption("everglade-classic", "everglade");
  #assert !classic.shared && classic.tracked_legacy && classic.profile == -1;
  #assert !render_adoption("everglade-5e", "everglade5e").tracked_legacy;
  #assert !render_adoption("everglade-classic", "everglade5e").tracked_legacy;
}
// MetaHuman Lab (the human runtime's bench) draws with its own two passes until it has a catalog profile.
#test "MetaHuman Lab is a tracked legacy consumer" {
  route := render_adoption("metahuman-lab", "metahumanlab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("metahuman-lab", "fivelab").tracked_legacy;
}
// Splat Lab (the Gaussian splat bench) draws with its own passes and sort until it has a catalog profile.
#test "Splat Lab is a tracked legacy consumer" {
  route := render_adoption("splat-lab", "splatlab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("splat-lab", "fivelab").tracked_legacy;
}
// One-Shot (the campaign creator's Table) draws with 5E Lab's two passes until it has a catalog profile.
#test "One-Shot is a tracked legacy consumer" {
  route := render_adoption("one-shot", "oneshot");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("one-shot", "fivelab").tracked_legacy;
}
#test "Bitcoin Lab uses the existing HUD stroke renderer with its exact producer" {
  route:=render_adoption("bitcoin-lab","bitcoin-lab");
  #assert !route.shared && route.tracked_legacy && route.profile== -1;
  #assert !render_adoption("bitcoin-lab","newland").tracked_legacy;
  #assert !render_adoption("bitcoin-la","bitcoin-lab").tracked_legacy;
}
// Audio Lab (Everglade's sounds, #12832) draws the projects list's HUD passes: no 3D, no catalog profile.
#test "Audio Lab is a tracked legacy consumer" {
  route := render_adoption("audio-lab", "audiolab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("audio-lab", "fivelab").tracked_legacy;
}
#test "unknown page identities cannot gain a fallback renderer" {
  for slug: [5] string.["", "future-realm", "anime-la", "anime-lab/", "../anime-lab"] {
    route := render_adoption(slug, "animelab");
    #assert !route.shared && !route.tracked_legacy && route.profile == -1;
  }
}
// Penultimate Frontier (the Grid flown, newland page 2) draws with the Grid's passes until it has a catalog profile.
#test "Penultimate Frontier is a tracked legacy consumer" {
  route := render_adoption("penultimate-frontier", "newland");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("penultimate-frontier", "realm").tracked_legacy;
}
#test "Valley Lab graybox binds only its explicit initial renderer" {
  r:=render_adoption("valley-lab","valleylab");#assert r.tracked_legacy && !r.shared && r.profile== -1;
  #assert !render_adoption("valley-lab","newland").tracked_legacy;
  #assert !render_adoption("valley-la","valleylab").tracked_legacy;
}
#test "Valley Lab source pair has its explicit isolated renderer identity" {
  r:=render_adoption("valley-canyon","valleycanyon");#assert r.tracked_legacy && !r.shared && r.profile== -1;
  #assert !render_adoption("valley-canyon","valleylab").tracked_legacy && !render_adoption("valley-lab","valleycanyon").tracked_legacy;
  #assert !render_adoption("valley-canyons","valleycanyon").tracked_legacy;
}
#test "Valley world's source slice binds only its isolated initial renderer" {r:=render_adoption("valley-world","valleyworld");#assert r.tracked_legacy && !r.shared && r.profile== -1;#assert !render_adoption("valley-world","valleycanyon").tracked_legacy && !render_adoption("valley-worlds","valleyworld").tracked_legacy && !render_adoption("valley-canyon","valleyworld").tracked_legacy;}
render_adoption :: (slug: string, app: string) -> RenderAdoption #export_c #effects(all) {
  if slug == "ocarina-lab" && app == "ocarinalab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "animation-lab" && app == "animationlab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "valley-world" && app == "valleyworld" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "valley-canyon" && app == "valleycanyon" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "valley-lab" && app == "valleylab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "built" && app == "myrealm" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "bitcoin-lab" && app == "bitcoin-lab" { return RenderAdoption.{tracked_legacy = true}; }
  index := render_catalog_find(slug);
  if index >= 0 {
    p := render_catalog(index);
    if p.app == app { return RenderAdoption.{shared = true, profile = index}; }
  }
  if slug == "anime-lab" && app == "animelab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "5e-lab" && app == "fivelab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "5e-mmo" && app == "fivemmo" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "everglade" && app == "everglade5e" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "everglade-classic" && app == "everglade" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "metahuman-lab" && app == "metahumanlab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "splat-lab" && app == "splatlab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "one-shot" && app == "oneshot" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "audio-lab" && app == "audiolab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "penultimate-frontier" && app == "newland" { return RenderAdoption.{tracked_legacy = true}; }
  return RenderAdoption.{};
}
