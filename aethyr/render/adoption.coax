// Catalogue admission and actual consumer adoption are different facts.
// A newly published realm keeps its explicit existing renderer until its
// shared profile is implemented and qualified. Unknown identities refuse.
#load "catalog.coax";
#authority;
RenderAdoption :: struct { shared: bool; tracked_legacy: bool; profile: int = -1; }

#test "shared adoption binds each catalog slug to its actual producer" {
  for i: 0..<RENDER_CATALOG_COUNT {
    p := render_catalog(i); route := render_adoption(p.slug, p.app);
    if p.slug == "built" { continue; }   // tracked legacy for now (below)
    #assert route.shared && !route.tracked_legacy && route.profile == i;
    #assert !render_adoption(p.slug, "not-the-producer").shared;
  }
}
#test "Anime Lab remains an explicitly tracked legacy consumer" {
  route := render_adoption("anime-lab", "animelab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("anime-lab", "newland").tracked_legacy;
  #assert !render_adoption("the-grid", "animelab").tracked_legacy;
}
// The made-world template (myrealm) can't link its carrier yet: the carrier and YOUR COMPUTER's
// wire both load sha256-kernel.coax (#12661), so its module has no renderer facade and its page
// keeps the existing renderer.
#test "the made-world template is a tracked legacy consumer until its carrier links" {
  route := render_adoption("built", "myrealm");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
}
// 5E Lab (the SRD engine's bare grid) draws with its own two passes until it has a catalog profile.
#test "5E Lab is a tracked legacy consumer" {
  route := render_adoption("5e-lab", "fivelab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("5e-lab", "watchtower").tracked_legacy;
}
// 5E MMO (the SRD engine's battle in Everglade's look) draws with Everglade's passes until it has a catalog profile.
#test "5E MMO is a tracked legacy consumer" {
  route := render_adoption("5e-mmo", "fivemmo");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("5e-mmo", "everglade").tracked_legacy;
}
// Everglade 5E (Everglade on the SRD 5e engine) draws with Everglade's passes until it has a catalog profile.
#test "Everglade 5E is a tracked legacy consumer" {
  route := render_adoption("everglade-5e", "everglade5e");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("everglade-5e", "everglade").tracked_legacy;
}
// MetaHuman Lab (the human runtime's bench) draws with its own two passes until it has a catalog profile.
#test "MetaHuman Lab is a tracked legacy consumer" {
  route := render_adoption("metahuman-lab", "metahumanlab");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("metahuman-lab", "fivelab").tracked_legacy;
}
// One-Shot (the campaign creator's Table) draws with 5E Lab's two passes until it has a catalog profile.
#test "One-Shot is a tracked legacy consumer" {
  route := render_adoption("one-shot", "oneshot");
  #assert !route.shared && route.tracked_legacy && route.profile == -1;
  #assert !render_adoption("one-shot", "fivelab").tracked_legacy;
}
#test "unknown page identities cannot gain a fallback renderer" {
  for slug: [5] string.["", "future-realm", "anime-la", "anime-lab/", "../anime-lab"] {
    route := render_adoption(slug, "animelab");
    #assert !route.shared && !route.tracked_legacy && route.profile == -1;
  }
}
render_adoption :: (slug: string, app: string) -> RenderAdoption #export_c {
  if slug == "built" && app == "myrealm" { return RenderAdoption.{tracked_legacy = true}; }
  index := render_catalog_find(slug);
  if index >= 0 {
    p := render_catalog(index);
    if p.app == app { return RenderAdoption.{shared = true, profile = index}; }
  }
  if slug == "anime-lab" && app == "animelab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "5e-lab" && app == "fivelab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "5e-mmo" && app == "fivemmo" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "everglade-5e" && app == "everglade5e" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "metahuman-lab" && app == "metahumanlab" { return RenderAdoption.{tracked_legacy = true}; }
  if slug == "one-shot" && app == "oneshot" { return RenderAdoption.{tracked_legacy = true}; }
  return RenderAdoption.{};
}
