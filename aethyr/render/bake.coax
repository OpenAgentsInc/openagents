// The Metaverse Engine's baked light (GitHub #12995, book chapter 13): ambient occlusion and diffuse bounce
// baked on a terrain tile's samples, admitted whole and published only onto the geometry and world
// state they were baked for.
//
// Profile `aethyr.bake.grid.v1` (BAKE_VERSION 1, BAKE_PROFILE_GRID 1):
//   - Coordinates: the bake's grid is its tile's (aethyr/world/terrain-tile.coax): the same cells,
//     spacing and f64 origin, so the one floating-origin conversion places both. It is valid on
//     the tile's rectangle, edges included. Past it a sample is the fallback.
//   - Encoding: per sample, AO as f32 in 0..1 (the share of the sky's diffuse light that reaches
//     the ground there) and bounce as three f32 linear channels in 0..1 (light the occluders
//     return, as a share of the open sky's). Energy: AO + bounce is at most 1 in each channel, so
//     a hollow is never brighter than open ground.
//   - Interpolation: bilinear between a cell's four samples, the cell clamped to the grid; then
//     over `rise` metres above the ground the bake fades to open sky: s = smoothstep(0, rise, h),
//     AO' = mix(AO, 1, s), bounce' = bounce (1 - s).
//   - Composition: indirect = hemisphere ambient (AO' + bounce'), per channel
//     (aethyr/render/terrain-shade.coax). AO never touches the key light, its shadows, local
//     lights or the rim; exposure applies once, in the realm's tone curve.
//   - Fallback: AO 1 and bounce 0 (the unbaked hemisphere). A bake set that advertises baked
//     light (`require`) refuses a sample instead; every fallback is counted.
//   - Key: the tile revision and the occluders' content revision it was baked from, and up to
//     BAKE_AXES_MAX world-state axis values. A bake publishes only onto the key the world has now;
//     a stale one, or one for another state, refuses and the previous bake stays as it was.
//   - Identity: the SHA-256 of "ABL1", the header, the key, every AO and every bounce word.
//
// Names (locals too) start with `bake_` or `bk_`.
//   coax/bin/coax test aethyr/render/bake.coax
//   coax/bin/coax mutate aethyr/render/bake.coax --root-only

#module "aethyr.render.bake";
#authority;
#load "../world/terrain-tile.coax";
#load "terrain-shade.coax";
#load "tests/bake-fixtures.coax" #test;

// book:begin bake-types
BAKE_VERSION :: 1;
BAKE_PROFILE_GRID :: 1;
BAKE_AXES_MAX :: 4;
BAKE_RISE_MAX :: 64.0;

BAKE_OK :: 0;
BAKE_BAD_VERSION :: 1;
BAKE_BAD_PROFILE :: 2;
BAKE_BAD_GRID :: 3;       // not its tile's grid
BAKE_BAD_RISE :: 4;
BAKE_BAD_KEY :: 5;        // axis count out of range, or a state word past it
BAKE_BAD_STORAGE :: 6;
BAKE_BAD_AO :: 7;
BAKE_BAD_BOUNCE :: 8;     // nonfinite, out of range, or AO + bounce past 1
BAKE_STALE :: 9;          // baked from other geometry or other occluders
BAKE_STATE :: 10;         // baked for another world state

BakeKey :: struct { tile: [8] u32; content: [8] u32; axes: int; state: [BAKE_AXES_MAX] u32; }

BakeGrid :: struct {
  version: int = BAKE_VERSION;
  profile: int = BAKE_PROFILE_GRID;
  cells: int; spacing: f32; origin_x: f64; origin_z: f64;
  rise: f32;
  key: BakeKey;
}

// What a realm holds: whether a bake is live, its key and identity, and the counts its report shows.
BakeSet :: struct {
  require: bool;           // the profile advertises baked light: no fallback
  live: bool;
  key: BakeKey;
  rise: f32;
  revision: [8] u32;
  published: int; refused: int; first: int = BAKE_OK;
  fallbacks: int;
}

BakeAdmission :: struct { code: int = BAKE_OK; at: int = -1; revision: [8] u32; }
BakeSample :: struct { ok: bool; fallback: bool; ao: f32; bounce: [3] f32; }
// book:end bake-types

// ---- checks, written before the implementation

#test "a bake is admitted whole with its identity, which moves with any word" #steps 100000000 {
  t := TerrainTile.{cells = 2, spacing = 2, origin_x = -4, origin_z = 6};
  rev := [8] u32.[1, 2, 3, 4, 5, 6, 7, 8];
  g := bk_test_grid(t, rev);
  ao: [9] f32; bounce: [27] f32;
  bk_test_fill(ao[..], bounce[..]);
  a := bake_admit(g, t, ao[..], bounce[..]);
  #assert a.code == BAKE_OK && a.at == -1;
  for which: 0..<9 {
    g2 := g; ao2 := ao; b2 := bounce;
    if which == 0 { ao2[4] = 0.5; }
    if which == 1 { b2[26] = 0.01; }
    if which == 2 { g2.rise = 8; }
    if which == 3 { g2.key.tile[7] = 0; }
    if which == 4 { g2.key.content[0] = 1; }
    if which == 5 { g2.key.axes = 2; }
    if which == 6 { g2.key.state[0] = 4; }
    if which == 7 { b2[0] = 0.1; }
    if which == 8 { ao2[0] = 0.125; }
    q := bake_admit(g2, t, ao2[..], b2[..]);
    #assert q.code == BAKE_OK && !terrain_tile_same(q.revision, a.revision);
  }
}

#test "a bake's identity is the SHA-256 of its written encoding" #steps 100000000 {
  t := TerrainTile.{cells = 1, spacing = 0.5, origin_x = 3.25, origin_z = -1.0e7};
  g := BakeGrid.{cells = 1, spacing = 0.5, origin_x = 3.25, origin_z = -1.0e7, rise = 6.5,
    key = BakeKey.{tile = [8] u32.[11, 12, 13, 14, 15, 16, 17, 18], content = [8] u32.[21, 22, 23, 24, 25, 26, 27, 28], axes = 2, state = [4] u32.[7, 0x80000001, 0, 0]}};
  ao := [4] f32.[1, 0.5, 0.25, 0];
  bounce := [12] f32.[0, 0, 0,  0.5, 0.25, 0.125,  0.75, 0.5, 0,  1, 0.5, 0.25];
  a := bake_admit(g, t, ao[..], bounce[..]);
  #assert a.code == BAKE_OK;
  bytes: [300] u8; at := 0;
  at = tto_put32(bytes[..], at, 0x41424c31);
  at = tto_put64(bytes[..], at, 1); at = tto_put64(bytes[..], at, 1); at = tto_put64(bytes[..], at, 1);
  at = tto_put32(bytes[..], at, f32_bits(0.5));
  at = tto_put64(bytes[..], at, f64_bits(3.25)); at = tto_put64(bytes[..], at, f64_bits(-1.0e7));
  at = tto_put32(bytes[..], at, f32_bits(6.5));
  for k: 0..<8 { at = tto_put32(bytes[..], at, g.key.tile[k]); }
  for k: 0..<8 { at = tto_put32(bytes[..], at, g.key.content[k]); }
  at = tto_put64(bytes[..], at, 2);
  for k: 0..<4 { at = tto_put32(bytes[..], at, g.key.state[k]); }
  for k: 0..<4 { at = tto_put32(bytes[..], at, f32_bits(ao[k])); }
  for k: 0..<12 { at = tto_put32(bytes[..], at, f32_bits(bounce[k])); }
  want := S_hash(cast(string) bytes[0..<at]);
  for k: 0..<8 { #assert a.revision[k] == want.words[k]; }
}

#forall "a malformed bake refuses whole, naming the first bad sample" which: 0..<27 #steps 100000000 {
  t := TerrainTile.{cells = 2, spacing = 2, origin_x = -4, origin_z = 6};
  g := bk_test_grid(t, [8] u32.[1, 2, 3, 4, 5, 6, 7, 8]);
  ao: [9] f32; bounce: [27] f32;
  bk_test_fill(ao[..], bounce[..]);
  nan := 0.0f32; nan = nan / nan;
  ac := 9; bc := 27; code := BAKE_OK; at := -1;
  if which == 0 { g.version = 2; code = BAKE_BAD_VERSION; }
  if which == 1 { g.profile = 2; code = BAKE_BAD_PROFILE; }
  if which == 2 { g.cells = 3; code = BAKE_BAD_GRID; }
  if which == 3 { g.spacing = 2.5; code = BAKE_BAD_GRID; }
  if which == 4 { g.origin_x = -4.5; code = BAKE_BAD_GRID; }
  if which == 5 { g.origin_z = 6.5; code = BAKE_BAD_GRID; }
  if which == 6 { g.rise = 0; code = BAKE_BAD_RISE; }
  if which == 7 { g.rise = 64.01; code = BAKE_BAD_RISE; }
  if which == 8 { g.rise = nan; code = BAKE_BAD_RISE; }
  if which == 9 { g.key.axes = -1; code = BAKE_BAD_KEY; }
  if which == 10 { g.key.axes = 5; code = BAKE_BAD_KEY; }
  if which == 11 { g.key.state[1] = 1; code = BAKE_BAD_KEY; }     // past axis 1
  if which == 12 { g.key.state[3] = 1; code = BAKE_BAD_KEY; }
  if which == 13 { ac = 8; code = BAKE_BAD_STORAGE; }
  if which == 14 { bc = 26; code = BAKE_BAD_STORAGE; }
  if which == 15 { ao[3] = nan; code = BAKE_BAD_AO; at = 3; }
  if which == 16 { ao[0] = -0.001; code = BAKE_BAD_AO; at = 0; }
  if which == 17 { ao[8] = 1.001; bounce[24] = 0; bounce[25] = 0; code = BAKE_BAD_AO; at = 8; }
  if which == 18 { bounce[13] = nan; code = BAKE_BAD_BOUNCE; at = 4; }
  if which == 19 { bounce[0] = -0.001; code = BAKE_BAD_BOUNCE; at = 0; }
  if which == 20 { bounce[26] = 1.001; ao[8] = 0; code = BAKE_BAD_BOUNCE; at = 8; }
  if which == 21 { ao[2] = 0.75; bounce[6] = 0.2501; code = BAKE_BAD_BOUNCE; at = 2; }   // AO + bounce past 1
  if which == 22 { ao[2] = 0.75; bounce[7] = 0.2501; code = BAKE_BAD_BOUNCE; at = 2; }
  if which == 23 { ao[2] = 0.75; bounce[8] = 0.2501; code = BAKE_BAD_BOUNCE; at = 2; }
  if which == 24 { g.cells = 0; t.cells = 0; code = BAKE_BAD_GRID; }
  if which == 25 { ao[2] = 0.75; bounce[6] = 0.25; bounce[7] = 0.25; bounce[8] = 0.25; }   // exactly 1: admitted
  if which == 26 { g.key.axes = 4; g.key.state = [4] u32.[1, 2, 3, 4]; g.rise = 64; }
  q := bake_admit(g, t, ao[0..<ac], bounce[0..<bc]);
  #assert q.code == code && q.at == at;
  if code != BAKE_OK { for k: 0..<8 { #assert q.revision[k] == 0; } }
}

#test "a bake publishes only onto the key the world has now, and a refusal keeps the last one" #steps 200000000 {
  t := TerrainTile.{cells = 2, spacing = 2, origin_x = -4, origin_z = 6};
  rev := [8] u32.[1, 2, 3, 4, 5, 6, 7, 8];
  g := bk_test_grid(t, rev);
  ao: [9] f32; bounce: [27] f32;
  bk_test_fill(ao[..], bounce[..]);
  live_ao: [9] f32; live_b: [27] f32;
  set := [1] BakeSet.[BakeSet.{}];
  #assert !bake_current(set[0], g.key);
  #assert bake_publish(set[..], g, t, g.key, ao[..], bounce[..], live_ao[..], live_b[..]) == BAKE_OK;
  #assert set[0].live && set[0].published == 1 && set[0].refused == 0 && bake_current(set[0], g.key);
  for k: 0..<9 { #assert live_ao[k] == ao[k]; }
  for k: 0..<27 { #assert live_b[k] == bounce[k]; }
  first := set[0].revision;
  #assert terrain_tile_same(first, bake_admit(g, t, ao[..], bounce[..]).revision);
  // each refusal leaves the live bake, its key and the GPU copy as they were
  for which: 0..<6 {
    g2 := g; want := g.key; a2 := ao; b2 := bounce; code := BAKE_OK;
    for k: 0..<9 { a2[k] = 0.5; }
    for k: 0..<27 { b2[k] = 0.125; }
    if which == 0 { want.tile[0] = 99; code = BAKE_STALE; }           // the ground changed
    if which == 1 { want.content[7] = 99; code = BAKE_STALE; }        // the occluders changed
    if which == 2 { want.state[0] = 4; code = BAKE_STATE; }           // another world state
    if which == 3 { want.axes = 2; code = BAKE_STATE; }
    if which == 4 { a2[5] = 2; code = BAKE_BAD_AO; }                   // corrupt
    if which == 5 { g2.key.state[0] = 4; code = BAKE_STATE; }          // a variant for a state not in use
    #assert bake_publish(set[..], g2, t, want, a2[..], b2[..], live_ao[..], live_b[..]) == code;
    #assert set[0].live && set[0].published == 1 && set[0].refused == which + 1 && set[0].first == BAKE_STALE;
    #assert terrain_tile_same(set[0].revision, first) && bake_current(set[0], g.key);
    for k: 0..<9 { #assert live_ao[k] == ao[k]; }
    for k: 0..<27 { #assert live_b[k] == bounce[k]; }
  }
  // the GPU copy must be the bake's size
  short: [8] f32;
  #assert bake_publish(set[..], g, t, g.key, ao[..], bounce[..], short[..], live_b[..]) == BAKE_BAD_STORAGE;
  #assert bake_publish(set[..], g, t, g.key, ao[..], bounce[..], live_ao[..], live_b[0..<26]) == BAKE_BAD_STORAGE;
  #assert set[0].refused == 8 && set[0].published == 1;
  // a new state with its own bake publishes, and the old key is no longer current
  g3 := g; g3.key.state[0] = 4;
  for k: 0..<9 { ao[k] = 1; }
  for k: 0..<27 { bounce[k] = 0; }
  #assert bake_publish(set[..], g3, t, g3.key, ao[..], bounce[..], live_ao[..], live_b[..]) == BAKE_OK;
  #assert set[0].published == 2 && bake_current(set[0], g3.key) && !bake_current(set[0], g.key) && live_ao[4] == 1 && live_b[13] == 0;
  #assert !terrain_tile_same(set[0].revision, first);
}

#test "keys are the same only when every word that counts is" {
  a := BakeKey.{tile = [8] u32.[1, 2, 3, 4, 5, 6, 7, 8], content = [8] u32.[8, 7, 6, 5, 4, 3, 2, 1], axes = 3, state = [4] u32.[1, 2, 3, 0]};
  #assert bake_key_same(a, a);
  for k: 0..<8 {
    b := a; b.tile[k] += 1; #assert !bake_key_same(a, b);
    c := a; c.content[k] += 1; #assert !bake_key_same(a, c);
  }
  for k: 0..<4 { d := a; d.state[k] += 1; #assert !bake_key_same(a, d); }
  e := a; e.axes = 2; #assert !bake_key_same(a, e);
}

#test "hand-worked: bilinear AO and bounce, the rise to open sky and the fallback past the tile" #steps 100000000 {
  t := TerrainTile.{cells = 2, spacing = 2, origin_x = 100, origin_z = 200};
  g := BakeGrid.{cells = 2, spacing = 2, origin_x = 100, origin_z = 200, rise = 8, key = BakeKey.{axes = 0}};
  ao := [9] f32.[1, 0.5, 1,  0, 0.5, 1,  1, 1, 1];
  bounce: [27] f32;
  bounce[3] = 0.25; bounce[4] = 0.5; bounce[5] = 0.125;   // sample 1
  bounce[9] = 0.5;                                         // sample 3
  live_ao: [9] f32; live_b: [27] f32;
  set := [1] BakeSet.[BakeSet.{}];
  #assert bake_publish(set[..], g, t, g.key, ao[..], bounce[..], live_ao[..], live_b[..]) == BAKE_OK;
  frame := terrain_tile_ground(t, 90, 190);   // the tile at local (10, 10)
  // (11, 11): a quarter into cell (0, 0): ao = mix(mix(1, .5, .5), mix(0, .5, .5), .5) = .5
  s := bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 11, 11, 0);
  #assert s.ok && !s.fallback && s.ao == 0.5;
  #assert s.bounce[0] == 0.1875 && s.bounce[1] == 0.125 && s.bounce[2] == 0.03125;
  // 4 m up, half the rise: s = .5
  u := bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 11, 11, 4);
  #assert u.ao == 0.75 && u.bounce[0] == 0.09375 && u.bounce[2] == 0.015625;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 11, 11, 8).ao == 1;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 11, 11, -1).ao == 0.5;
  // a sample exactly: (10, 12) is sample 3; the north-east corner (14, 14) is sample 8
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 10, 12, 0).ao == 0;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 10, 12, 0).bounce[0] == 0.5;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 14, 14, 0).ao == 1;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 13, 11, 0).ao == 0.75;
  #assert set[0].fallbacks == 0;
  // past each edge: the unbaked hemisphere, counted
  xs := [4] f32.[9.99, 14.01, 12, 12];
  zs := [4] f32.[12, 12, 9.99, 14.01];
  for k: 0..<4 {
    f := bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], xs[k], zs[k], 0);
    #assert f.ok && f.fallback && f.ao == 1 && f.bounce[0] == 0 && f.bounce[1] == 0 && f.bounce[2] == 0 && set[0].fallbacks == k + 1;
  }
  // a key the world no longer has: the fallback too
  other := g.key; other.axes = 1; other.state[0] = 2;
  #assert bake_sample(set[..], other, frame, live_ao[..], live_b[..], 11, 11, 0).fallback && set[0].fallbacks == 5;
  // a profile advertised as baked refuses instead
  set[0].require = true;
  r := bake_sample(set[..], other, frame, live_ao[..], live_b[..], 11, 11, 0);
  #assert !r.ok && !r.fallback && r.ao == 0 && set[0].fallbacks == 5;
  #assert !bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 20, 11, 0).ok;
  #assert bake_sample(set[..], g.key, frame, live_ao[..], live_b[..], 11, 11, 0).ok;
  // short views and an empty frame are refusals, not fallbacks
  #assert !bake_sample(set[..], g.key, frame, live_ao[0..<8], live_b[..], 11, 11, 0).ok;
  #assert !bake_sample(set[..], g.key, frame, live_ao[..], live_b[0..<26], 11, 11, 0).ok;
  #assert !bake_sample(set[..], g.key, Ground.{n = 0}, live_ao[..], live_b[..], 11, 11, 0).ok;
  #assert !bake_sample(set[..], g.key, Ground.{n = 3, cell = 2, west = 10, south = 10}, live_ao[..], live_b[..], 11, 11, 0).ok;
}

#forall "bake sampling equals an independent f64 bilinear oracle over the grid" k: 0..<32 #steps 100000000 {
  n := 1 + k % 4;
  t := TerrainTile.{cells = n, spacing = 0.5 + f32(k % 3), origin_x = -3 + f64(k), origin_z = 7 - f64(k)};
  g := BakeGrid.{cells = n, spacing = t.spacing, origin_x = t.origin_x, origin_z = t.origin_z, rise = 5};
  p := (n + 1) * (n + 1);
  ao: [25] f32; bounce: [75] f32;
  seed := cast(u64) (k + 3) * 1009;
  for q: 0..<p {
    seed = tto_state(seed); ao[q] = f32(tto_unit(seed));
    for c: 0..<3 { seed = tto_state(seed); bounce[q * 3 + c] = f32(tto_unit(seed)) * (1 - ao[q]); }
  }
  live_ao: [25] f32; live_b: [75] f32;
  set := [1] BakeSet.[BakeSet.{}];
  #assert bake_publish(set[..], g, t, g.key, ao[0..<p], bounce[0..<p * 3], live_ao[0..<p], live_b[0..<p * 3]) == BAKE_OK;
  frame := terrain_tile_ground(t, 0, 0);
  for trial: 0..<12 {
    seed = tto_state(seed); ux := tto_unit(seed);
    seed = tto_state(seed); uz := tto_unit(seed);
    seed = tto_state(seed); h := f32(tto_unit(seed) * 7 - 1);
    x := frame.west + f32(ux * f64(n) * f64(t.spacing)); z := frame.south + f32(uz * f64(n) * f64(t.spacing));
    s := bake_sample(set[..], g.key, frame, live_ao[0..<p], live_b[0..<p * 3], x, z, h);
    // the oracle: the cell by f64 division, its fractions, then the written equations in f64
    gx := (f64(x) - f64(frame.west)) / f64(t.spacing); gz := (f64(z) - f64(frame.south)) / f64(t.spacing);
    i := cast(int) gx; j := cast(int) gz;
    if i > n - 1 { i = n - 1; }
    if j > n - 1 { j = n - 1; }
    fx := gx - f64(i); fz := gz - f64(j);
    q := j * (n + 1) + i;
    r := f64(h) / 5; if r < 0 { r = 0; } if r > 1 { r = 1; }
    rs := r * r * (3 - 2 * r);
    a0 := f64(ao[q]) * (1 - fx) + f64(ao[q + 1]) * fx; a1 := f64(ao[q + n + 1]) * (1 - fx) + f64(ao[q + n + 2]) * fx;
    want := a0 * (1 - fz) + a1 * fz;
    want = want + (1 - want) * rs;
    #assert s.ok && !s.fallback && abs(f64(s.ao) - want) < 0.00002;
    for c: 0..<3 {
      b0 := f64(bounce[q * 3 + c]) * (1 - fx) + f64(bounce[(q + 1) * 3 + c]) * fx;
      b1 := f64(bounce[(q + n + 1) * 3 + c]) * (1 - fx) + f64(bounce[(q + n + 2) * 3 + c]) * fx;
      wb := (b0 * (1 - fz) + b1 * fz) * (1 - rs);
      #assert abs(f64(s.bounce[c]) - wb) < 0.00002;
      #assert f64(s.ao) + f64(s.bounce[c]) <= 1.00002;
    }
  }
}

// ---- implementation

bake_key_same :: (a: BakeKey, b: BakeKey) -> bool #effects(all) {
  if a.axes != b.axes || !terrain_tile_same(a.tile, b.tile) || !terrain_tile_same(a.content, b.content) { return false; }
  for bk_k: 0..<BAKE_AXES_MAX { if a.state[bk_k] != b.state[bk_k] { return false; } }
  return true;
}

// book:begin admit
// Admits a bake against its tile: header, grid, key, view lengths and every value are checked
// before its identity is computed. A refusal names the first bad sample and has no identity.
bake_admit :: (g: BakeGrid, t: TerrainTile, ao: [] f32, bounce: [] f32) -> BakeAdmission #effects(all) {
  if g.version != BAKE_VERSION { return BakeAdmission.{code = BAKE_BAD_VERSION}; }
  if g.profile != BAKE_PROFILE_GRID { return BakeAdmission.{code = BAKE_BAD_PROFILE}; }
  if g.cells < 1 || g.cells != t.cells || g.spacing != t.spacing || g.origin_x != t.origin_x || g.origin_z != t.origin_z { return BakeAdmission.{code = BAKE_BAD_GRID}; }
  if !(g.rise > 0 && g.rise <= BAKE_RISE_MAX) { return BakeAdmission.{code = BAKE_BAD_RISE}; }
  if g.key.axes < 0 || g.key.axes > BAKE_AXES_MAX { return BakeAdmission.{code = BAKE_BAD_KEY}; }
  for bk_k: g.key.axes..<BAKE_AXES_MAX { if g.key.state[bk_k] != 0 { return BakeAdmission.{code = BAKE_BAD_KEY}; } }
  p := (g.cells + 1) * (g.cells + 1);
  if ao.count != p || bounce.count != p * 3 { return BakeAdmission.{code = BAKE_BAD_STORAGE}; }
  for bk_k: 0..<p {
    bk_a := ao[bk_k];
    if !(bk_a >= 0 && bk_a <= 1) { return BakeAdmission.{code = BAKE_BAD_AO, at = bk_k}; }
    for bk_c: 0..<3 {
      bk_b := bounce[bk_k * 3 + bk_c];
      if !(bk_b >= 0 && bk_b <= 1) || bk_a + bk_b > 1 { return BakeAdmission.{code = BAKE_BAD_BOUNCE, at = bk_k}; }
    }
  }
  d := [1] TerrainTileDigest.[terrain_tile_digest()];
  terrain_tile_digest_u32(d[..], 0x41424c31);   // "ABL1"
  terrain_tile_digest_int(d[..], g.version); terrain_tile_digest_int(d[..], g.profile); terrain_tile_digest_int(d[..], g.cells);
  terrain_tile_digest_f32(d[..], g.spacing);
  terrain_tile_digest_f64(d[..], g.origin_x); terrain_tile_digest_f64(d[..], g.origin_z);
  terrain_tile_digest_f32(d[..], g.rise);
  terrain_tile_digest_words(d[..], g.key.tile); terrain_tile_digest_words(d[..], g.key.content);
  terrain_tile_digest_int(d[..], g.key.axes);
  for bk_k: 0..<BAKE_AXES_MAX { terrain_tile_digest_u32(d[..], g.key.state[bk_k]); }
  for bk_k: 0..<p { terrain_tile_digest_f32(d[..], ao[bk_k]); }
  for bk_k: 0..<p * 3 { terrain_tile_digest_f32(d[..], bounce[bk_k]); }
  return BakeAdmission.{revision = terrain_tile_digest_end(d[..])};
}
// book:end admit

bk_refuse :: (set: [] BakeSet, code: int) -> int #effects(all) {
  set[0].refused += 1;
  if set[0].first == BAKE_OK { set[0].first = code; }
  return code;
}

// book:begin publish
// Publishes a staged bake into the live views the GPU reads, only when it is admitted, was baked
// from the geometry and occluders the world has now (`now`), and for its world state. Anything
// else refuses, and the live bake, its key and the live views stay exactly as they were.
bake_publish :: (set: [] BakeSet, g: BakeGrid, t: TerrainTile, now: BakeKey, ao: [] f32, bounce: [] f32, live_ao: [] f32, live_bounce: [] f32) -> int #effects(all) {
  a := bake_admit(g, t, ao, bounce);
  if a.code != BAKE_OK { return bk_refuse(set, a.code); }
  if !terrain_tile_same(g.key.tile, now.tile) || !terrain_tile_same(g.key.content, now.content) { return bk_refuse(set, BAKE_STALE); }
  if !bake_key_same(g.key, now) { return bk_refuse(set, BAKE_STATE); }
  if live_ao.count != ao.count || live_bounce.count != bounce.count { return bk_refuse(set, BAKE_BAD_STORAGE); }
  for bk_k: 0..<ao.count { live_ao[bk_k] = ao[bk_k]; }
  for bk_k: 0..<bounce.count { live_bounce[bk_k] = bounce[bk_k]; }
  set[0].live = true; set[0].key = g.key; set[0].rise = g.rise; set[0].revision = a.revision; set[0].published += 1;
  return BAKE_OK;
}
// book:end publish

// Whether the live bake is the one for `now`.
bake_current :: (set: BakeSet, now: BakeKey) -> bool #effects(all) { return set.live && bake_key_same(set.key, now); }

// book:begin sample
// The baked light at local (x, z), h metres above the ground, on the live views: the profile's
// bilinear AO and bounce and their rise, through terrain-shade.coax's equations. Past the tile,
// or when the live bake isn't the one for `now`, the fallback (counted), or a refusal where the
// set advertises baked light. `frame` is the tile in the realm's local frame (terrain_tile_ground).
bake_sample :: (set: [] BakeSet, now: BakeKey, frame: Ground, ao: [] f32, bounce: [] f32, x: f32, z: f32, h: f32) -> BakeSample #effects(all) {
  n := frame.n; p := (n + 1) * (n + 1);
  if !ground_valid(frame) || ao.count != p || bounce.count != p * 3 { return BakeSample.{}; }
  span := f32(n) * frame.cell;
  bk_in := aethyr_bake_inside(x, frame.west, span) * aethyr_bake_inside(z, frame.south, span);
  if !bake_current(set[0], now) || bk_in == 0 {
    if set[0].require { return BakeSample.{}; }
    set[0].fallbacks += 1;
    return BakeSample.{ok = true, fallback = true, ao = 1};
  }
  gx := (x - frame.west) / frame.cell; gz := (z - frame.south) / frame.cell;
  ix := aethyr_bake_index(gx, f32(n)); iz := aethyr_bake_index(gz, f32(n));
  fx := aethyr_bake_fraction(gx, ix); fz := aethyr_bake_fraction(gz, iz);
  q := cast(int) iz * (n + 1) + cast(int) ix;
  s := aethyr_bake_rise(h, set[0].rise);
  out := BakeSample.{ok = true};
  out.ao = aethyr_bake_ao(aethyr_bake_bilerp(ao[q], ao[q + 1], ao[q + n + 1], ao[q + n + 2], fx, fz), s);
  for bk_c: 0..<3 {
    out.bounce[bk_c] = aethyr_bake_bounce(aethyr_bake_bilerp(bounce[q * 3 + bk_c], bounce[(q + 1) * 3 + bk_c],
      bounce[(q + n + 1) * 3 + bk_c], bounce[(q + n + 2) * 3 + bk_c], fx, fz), s);
  }
  return out;
}
// book:end sample
