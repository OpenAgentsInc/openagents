// Character surface shading from one material record (aethyr/character/material.coax, #13012).
// GPU-safe Coax: a realm's fragment shader calls these with its own lights, so Character Create,
// Everglade II's player and every Quaternius outfit read the same normal and ORM maps the same way.
// Convention: the realms' key light is not divided by pi (diffuse = albedo * light * n.l), so each
// lobe here is the BRDF times pi times n.l, a radiance per unit light.
// Two qualities from one record:
//  - live: the mapped normal, a GGX key highlight with roughness and metalness from the ORM map,
//    and the map's occlusion on the fill;
//  - film: live plus cloth sheen (Charlie), skin's wrapped red light and broadened two-lobe
//    highlight (the forms of aethyr/render/character.coax cv_skin_light) and an anisotropic
//    highlight along hair cards (Kajiya-Kay, two shifted lobes).
// Characters stay matte (2026-11-07, c90c2b0a20): dielectric roughness never drops below
// CM_MATTE_ROUGH, so no key highlight is brighter than the old Blinn lobe's 0.12.
//   coax/bin/coax test aethyr/render/character-material.coax
#load "../../verse/gpu/wgsl.coax";

CM_SKIN :: 0;
CM_CLOTH :: 1;
CM_HAIR :: 2;
CM_EYE :: 3;
CM_METAL :: 4;
CM_PI :: 3.14159265f32;
CM_MATTE_ROUGH :: 0.55f32;   // the smoothest a dielectric character surface is drawn
CM_METAL_ROUGH :: 0.7f32;    // and a metal one: worn, never a mirror glint
CM_DIELECTRIC_F0 :: 0.04f32;

// The tangent-space normal map (linear texels, OpenGL convention: +Y up the texture) applied with
// the screen-space cotangent frame (Schueler 2006), since Quaternius vertices carry no tangents.
// p and uv are the world position and texture coordinate; px, py, ux, uy their screen derivatives,
// as WGSL's dpdx and dpdy give them: py runs down the framebuffer, so it is turned up first.
// The packed V coordinate runs down the image (1 - glTF's V, verse/tools/people.py), so the map's
// +Y is the frame's -V. A degenerate frame (no UV change) keeps the surface normal.
cm_normal :: (texel:V4,strength:f32,n:V3,px:V3,py:V3,ux:V2,uy:V2)->V3 {
 x:=(texel.x*2.0f32-1.0f32)*strength;y:=(texel.y*2.0f32-1.0f32)*strength;z:=texel.z*2.0f32-1.0f32;
 up:=scale3(py,-1.0f32);p2:=cross3(up,n);p1:=cross3(n,px);
 t:=add3(scale3(p2,ux.x),scale3(p1,-uy.x));b:=add3(scale3(p2,ux.y),scale3(p1,-uy.y));
 m:=fmax(dot3(t,t),dot3(b,b));
 if !(m>0.0f32) {return n;}
 k:=1.0f32/sqrt(m);
 out:=add3(add3(scale3(t,x*k),scale3(b,-y*k)),scale3(n,fmax(z,0.0f32)));
 l:=dot3(out,out);
 if !(l>0.0f32) {return n;}
 return scale3(out,1.0f32/sqrt(l));
}

// Along a hair card's strands: the surface's direction of increasing V (dP/dV, the cotangent frame
// of cm_normal), which is how Quaternius lays its hair cards out. A degenerate frame gives n's
// perpendicular nearest world up.
cm_strand :: (n:V3,px:V3,py:V3,ux:V2,uy:V2)->V3 {
 up:=scale3(py,-1.0f32);p2:=cross3(up,n);p1:=cross3(n,px);b:=add3(scale3(p2,ux.y),scale3(p1,-uy.y));
 l:=dot3(b,b);if !(l>0.0f32) {w:=sub3(v3(0,1,0),scale3(n,n.y));lw:=dot3(w,w);return ifx lw>0.0f32 then scale3(w,1.0f32/sqrt(lw)) else v3(1,0,0);}
 return scale3(b,1.0f32/sqrt(l));
}
// The drawn roughness: a matte floor for dielectrics, a lower one for metal.
cm_rough :: (rough:f32,metal:f32)->f32 {return clampf(rough,mix(CM_MATTE_ROUGH,CM_METAL_ROUGH,saturate(metal)),1.0f32);}
// F0: 4% for a dielectric, the base colour for a metal.
cm_f0 :: (albedo:V3,metal:f32)->V3 {return mix3(v3(CM_DIELECTRIC_F0,CM_DIELECTRIC_F0,CM_DIELECTRIC_F0),albedo,saturate(metal));}

// GGX with Schlick-GGX visibility (Unreal's k = (r+1)^2/8) and Schlick Fresnel, as
// aethyr/render/character.coax cv_area_light, times pi.
cm_ggx :: (f0:V3,rough:f32,n:V3,l:V3,v:V3)->V3 {
 nl:=dot3(n,l);if !(nl>0.0f32) {return v3(0,0,0);}
 h:=normalize3(add3(l,v));nv:=fmax(0.0001f32,dot3(n,v));nh:=fmax(0.0f32,dot3(n,h));vh:=fmax(0.0f32,dot3(v,h));
 a:=rough*rough;aa:=a*a;den:=nh*nh*(aa-1.0f32)+1.0f32;k:=(rough+1.0f32)*(rough+1.0f32)/8.0f32;
 s:=aa/(CM_PI*den*den)*nv/(nv*(1.0f32-k)+k)*nl/(nl*(1.0f32-k)+k)/(4.0f32*nv)*CM_PI;f:=pow(1.0f32-vh,5.0f32);
 return v3((f0.x+(1.0f32-f0.x)*f)*s,(f0.y+(1.0f32-f0.y)*f)*s,(f0.z+(1.0f32-f0.z)*f)*s);
}
// Cloth sheen: the Charlie distribution (Estevez and Kulla 2017) with Neubelt's visibility,
// times pi and n.l. A soft rim that brightens toward grazing view, never a point highlight.
cm_sheen :: (colour:V3,rough:f32,n:V3,l:V3,v:V3)->V3 {
 nl:=dot3(n,l);if !(nl>0.0f32) {return v3(0,0,0);}
 h:=normalize3(add3(l,v));nv:=fmax(0.0001f32,dot3(n,v));nh:=clampf(dot3(n,h),0.0f32,1.0f32);
 r:=clampf(rough,0.07f32,1.0f32);inv:=1.0f32/r;sin2:=fmax(1.0f32-nh*nh,0.0078125f32);
 d:=(2.0f32+inv)*pow(sin2,inv*0.5f32)/(2.0f32*CM_PI);vis:=1.0f32/(4.0f32*(nl+nv-nl*nv));
 return scale3(colour,fmin(d*vis*CM_PI*nl,1.0f32));
}
// Skin's light (aethyr/render/character.coax cv_skin_light): diffuse that wraps further for red
// than green and blue, with its normals bent toward the geometric g, plus two highlight lobes at
// 0.75x and 1.3x the roughness mixed 0.15 and 0.85, on a normal half way to g. Times pi.
cm_skin :: (albedo:V3,f0:V3,rough:f32,n:V3,g:V3,l:V3,v:V3)->V3 {
 ns:=normalize3(add3(scale3(n,0.5f32),scale3(g,0.5f32)));sr:=fmax(rough,CM_MATTE_ROUGH);
 a:=cm_ggx(f0,clampf(sr*0.75f32,0.045f32,1.0f32),ns,l,v);b:=cm_ggx(f0,clampf(sr*1.3f32,0.045f32,1.0f32),ns,l,v);
 nr:=normalize3(add3(scale3(n,0.4f32),scale3(g,0.6f32)));ng:=normalize3(add3(scale3(n,0.75f32),scale3(g,0.25f32)));
 dr:=fmax(0.0f32,(dot3(nr,l)+0.35f32)/1.35f32);dg:=fmax(0.0f32,(dot3(ng,l)+0.12f32)/1.12f32);db:=fmax(0.0f32,dot3(n,l));
 return add3(add3(scale3(a,0.15f32),scale3(b,0.85f32)),v3(albedo.x*dr,albedo.y*dg,albedo.z*db));
}
// Hair cards: Kajiya-Kay along the strand direction t, a primary lobe shifted toward the root and
// a broader, tinted secondary one toward the tip (Scheuermann 2004), times n.l's soft wrap.
cm_kk :: (t:V3,h:V3,shift:f32,n:V3,exponent:f32)->f32 {
 ts:=normalize3(add3(t,scale3(n,shift)));th:=dot3(ts,h);s:=sqrt(fmax(0.0f32,1.0f32-th*th));
 return pow(s,exponent)*smoothstep(-1.0f32,0.0f32,th);
}
cm_hair :: (albedo:V3,rough:f32,t:V3,n:V3,l:V3,v:V3)->V3 {
 wrap:=saturate((dot3(n,l)+0.5f32)/1.5f32);if !(wrap>0.0f32) {return v3(0,0,0);}
 h:=normalize3(add3(l,v));r:=clampf(rough,CM_MATTE_ROUGH,1.0f32);e1:=mix(80.0f32,16.0f32,r);e2:=e1*0.5f32;
 p:=cm_kk(t,h,-0.08f32,n,e1)*0.05f32;q:=cm_kk(t,h,0.12f32,n,e2)*0.04f32;
 return scale3(add3(v3(p,p,p),scale3(albedo,q)),wrap);
}
// What a metal reflects: its surroundings `env`, through Schlick at n.v, scaled by the surface's
// occlusion. A rough metal's reflection is its surroundings blurred toward what reaches the surface
// from every side, so the caller blends env from the sky along the reflection (smooth) toward the
// light the surface receives (rough): cm_metal_env.
cm_metal_env :: (along:V3,around:V3,rough:f32)->V3 {return mix3(along,around,saturate(rough));}
cm_metal_sky :: (sky:V3,f0:V3,rough:f32,nv:f32,ao:f32)->V3 {
 f:=pow(1.0f32-saturate(nv),5.0f32);k:=ao;
 return v3(sky.x*(f0.x+(1.0f32-f0.x)*f)*k,sky.y*(f0.y+(1.0f32-f0.y)*f)*k,sky.z*(f0.z+(1.0f32-f0.z)*f)*k);
}

#test "the mapped normal: a flat texel keeps the normal, a tilted one leans along U and up V" {
 n:=v3(0,0,1);px:=v3(0.01,0,0);py:=v3(0,-0.01,0);ux:=v2(0.001,0);uy:=v2(0,0.001);
 flat:=cm_normal(v4(0.5,0.5,1,1),1,n,px,py,ux,uy);#assert abs(flat.x)<0.00001 && abs(flat.y)<0.00001 && abs(flat.z-1)<0.00001;
 // +X in the map leans toward +U (world +x here)
 u:=cm_normal(v4(0.8,0.5,0.9,1),1,n,px,py,ux,uy);#assert u.x>0.3 && abs(u.y)<0.00001;
 // +Y in the map leans up the image: V grows down the screen here (py is -y), so up is +y
 w:=cm_normal(v4(0.5,0.8,0.9,1),1,n,px,py,ux,uy);#assert w.y>0.3 && abs(w.x)<0.00001;
 // strength 0 is the surface normal; a degenerate frame keeps it too
 z:=cm_normal(v4(0.8,0.2,0.9,1),0,n,px,py,ux,uy);#assert abs(z.z-1)<0.00001;
 d:=cm_normal(v4(0.8,0.2,0.9,1),1,n,px,py,v2(0,0),v2(0,0));#assert d.z==1;
 #assert abs(dot3(u,u)-1)<0.0001;
}
#test "a card's strand direction is where V grows; a flat frame falls back to up the surface" {
 n:=v3(0,0,1);px:=v3(0.01,0,0);py:=v3(0,-0.01,0);
 // V grows down the screen, which is world -y here
 t:=cm_strand(n,px,py,v2(0,0),v2(0,0.001));#assert abs(t.y+1)<0.00001 && abs(t.x)<0.00001;
 f:=cm_strand(v3(1,0,0),px,py,v2(0,0),v2(0,0));#assert abs(f.y-1)<0.00001;
}
#test "characters stay matte: no key highlight is above the old Blinn lobe's 0.12" {
 n:=v3(0,0,1);v:=v3(0,0,1);f0:=v3(0.04,0.04,0.04);
 for i:0..<11 {r:=cm_rough(cast(f32)i/10,0);s:=cm_ggx(f0,r,n,n,v);#assert s.x<=0.12 && r>=CM_MATTE_ROUGH;}
 #assert cm_rough(0.2,1)==CM_METAL_ROUGH && cm_rough(0.9,1)==0.9f32 && cm_rough(2,0)==1;
 // back light gives nothing; a rougher surface spreads the peak
 #assert cm_ggx(f0,0.6,n,v3(0,0,-1),v).x==0;
 l:=normalize3(v3(0.5,0,1));#assert cm_ggx(f0,0.9,n,l,v).x<cm_ggx(f0,0.6,n,n,v).x;
 m:=cm_f0(v3(0.8,0.6,0.4),1);#assert m.x==0.8f32 && cm_f0(v3(0.8,0.6,0.4),0).x==0.04f32;
}
#test "cloth sheen rises toward grazing view and stays bounded" {
 n:=v3(0,0,1);c:=v3(0.3,0.3,0.3);l:=normalize3(v3(0,0.4,1));
 face:=cm_sheen(c,0.5,n,l,v3(0,0,1));graze:=cm_sheen(c,0.5,n,l,normalize3(v3(0,-0.95,0.2)));
 #assert graze.x>face.x && graze.x<=0.3 && face.x>=0;
 #assert cm_sheen(c,0.5,n,v3(0,0,-1),v3(0,0,1)).x==0;
}
#test "skin wraps light past the terminator in red, not blue, and peaks below plain GGX" {
 n:=v3(0,0,1);v:=v3(0,0,1);f0:=v3(0.028,0.028,0.028);l:=normalize3(v3(0,1,-0.2));
 back:=cm_skin(v3(0.8,0.5,0.4),f0,0.5,n,n,l,v);#assert back.x>0 && back.z==0 && cm_ggx(f0,0.55,n,l,v).x==0;
 h:=normalize3(v3(0,0.3,1));r:=normalize3(sub3(scale3(h,2*dot3(h,v)),v));
 peak:=cm_skin(v3(0,0,0),f0,0.55,h,h,r,v);#assert peak.x>0 && peak.x<cm_ggx(f0,0.55*0.75,h,r,v).x;
}
#test "hair's highlight runs across the strands and fades behind them" {
 t:=v3(0,1,0);n:=v3(0,0,1);v:=v3(0,0,1);
 across:=cm_hair(v3(0.3,0.2,0.1),0.6,t,n,v3(0,0,1),v);along:=cm_hair(v3(0.3,0.2,0.1),0.6,t,n,normalize3(v3(0,1,0.05)),v);
 #assert across.x>along.x && across.x<0.1;
 #assert cm_hair(v3(0.3,0.2,0.1),0.6,t,n,v3(0,0,-1),v).x==0;
}
#test "a metal reflects its surroundings through Fresnel, less when occluded, blurred when rough" {
 sky:=v3(0.5,0.55,0.62);f0:=v3(0.6,0.6,0.6);
 a:=cm_metal_sky(sky,f0,0.5,1,1);c:=cm_metal_sky(sky,f0,0.5,1,0.5);g:=cm_metal_sky(sky,f0,0.5,0.1,1);
 #assert c.x<a.x && g.x>a.x && abs(a.x-0.5*0.6)<0.00001;
 along:=v3(0.5,0.55,0.62);around:=v3(3,2.8,2.4);
 #assert cm_metal_env(along,around,0).x==0.5 && cm_metal_env(along,around,1).x==3 && cm_metal_env(along,around,0.6).x>along.x;
}
