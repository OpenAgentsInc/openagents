// A detailed character's shading and the character pass (coax/web/host.js, the "character pass"
// section; docs/verse/2026-11-06-native-hero-characters.md, Design 3). Two users:
//  - Valley Lab's page shader (apps/openagents-web/gpu/valleycanyon.coax) loads it and shades Echo
//    with the TF0290 rig, as before;
//  - the character pass draws Echo in any world through ch_character_vs/fs (strands included) and
//    casts her into the world's shadow map through ch_caster_vs/fs. A world fills a SceneLights
//    block (scene-lights.coax) each frame, the pass's uniform block, so she is lit by the world's
//    key light, sky, lamps, haze and weather, and goes through the world's tone.
// The pass's module is apps/openagents-web/character.wgsl, written from this file by
// coax/web/wgsl-module.coax (apps/openagents-web/gpu/character.module and character.bindings):
//   coax/web/tool.sh coax/web/wgsl-module.coax aethyr/render/character.coax apps/openagents-web/character.wgsl apps/openagents-web/gpu/character.module
// Echo's word offsets and material slots are her pack's (verse/valley/); they move into the
// character pack's own data with Character pack v1 (H3).
//   coax/bin/coax test aethyr/render/character.coax
#load "../../verse/gpu/wgsl.coax";
#load "sampling.coax";
#load "pbr-env.coax";
#load "filmic.coax";
#load "hair-fiber.coax";
#load "light.coax";
#load "scene-lights.coax";
#load "../anim/morph-gpu.coax";
#load "../../verse/valley/echo-materials.coax";
#load "../../verse/valley/slay-lights.coax";

cv_at :: (u:[]f32,at:int)->V3 {return v3(u[at],u[at+1],u[at+2]);}
cv_add :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
cv_sub :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
cv_scale :: (a:V3,k:f32)->V3 {return v3(a.x*k,a.y*k,a.z*k);}
cv_word :: (vertices:[]u32,at:int)->f32 {return f32_from_bits(vertices[at]);}
ECHO_VERTEX_WORD :: 6052916;
ECHO_MATERIAL_WORD :: 6052404;
ECHO_GROOM_WORD :: 13573820;
cv_vertex_at :: (id:u32,vertices:[]u32)->int {return ifx id>=980000 then cast(int)vertices[ECHO_MATERIAL_WORD+31*16+1]+(cast(int)id-980000)*24 else ifx id>=900000 then cast(int)vertices[ECHO_MATERIAL_WORD+31*16]+(cast(int)id-900000)*24 else ECHO_VERTEX_WORD+(cast(int)id-504367)*24;}
cv_morph :: (id:u32,vertices:[]u32,bones:[]f32,u:[]f32)->MorphVertex {
 at:=cv_vertex_at(id,vertices);p:=v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2));n:=v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5));
 if u[111]<0.5 {return MorphVertex.{position=p,normal=n};}
 return morph_gpu(p,n,vertices,cast(int)vertices[ECHO_MATERIAL_WORD+30*16],cast(int)vertices[at+20],cast(int)vertices[at+21],bones,4008,cast(int)vertices[ECHO_MATERIAL_WORD+30*16+1]);
}
cv_head :: (p:V3,u:[]f32,bones:[]f32)->V3 {b:=82*12;q:=v4(p.x,p.y,p.z,1);local:=v3(wg_dot4(wg_at4(bones,b),q),wg_dot4(wg_at4(bones,b+4),q),wg_dot4(wg_at4(bones,b+8),q));return cv_add(cv_at(u,104),cv_echo_direction(local,u));}
GroomVertex :: struct {world:V3;normal:V3;tangent:V3;uv:V2;material:f32;coverage:f32;edge:f32;}
#test "Groom ribbons form two consistent triangles per original curve segment" {#assert cv_groom_endpoint(0)==0 && cv_groom_endpoint(1)==0 && cv_groom_endpoint(2)==1 && cv_groom_endpoint(3)==1 && cv_groom_endpoint(4)==0 && cv_groom_endpoint(5)==1;#assert cv_groom_side(0)== -1 && cv_groom_side(1)==1 && cv_groom_side(2)== -1 && cv_groom_side(3)== -1 && cv_groom_side(4)==1 && cv_groom_side(5)==1;}
#test "Strand colour coverage preserves the former stochastic expectation continuously" {#assert cv_groom_opacity(0.5,0)==0.5 && cv_groom_opacity(0.5,1)==0.375 && cv_groom_opacity(0,0)==0 && cv_groom_opacity(2,0)==1;}
cv_groom_opacity :: (coverage:f32,edge:f32)->f32 {return clampf(coverage*(1-abs(edge)*0.25),0.0f32,1.0f32);}
cv_groom_endpoint :: (vertex:int)->int {return ifx vertex==2 || vertex==3 || vertex==5 then 1 else 0;}
cv_groom_side :: (vertex:int)->f32 {return ifx vertex==0 || vertex==2 || vertex==3 then -1.0f32 else 1.0f32;}
// Strand LOD, as Unreal's groom LOD: |u[2]| is the share of strands drawn (the CPU sets it from the
// head's height on screen). Whole strands are kept by a hash of their seed and the kept ones widen
// by the inverse share so the hair's coverage stays the same.
// The shadow map takes at most a quarter of the strands, widened the same way.
CV_SHADOW_HAIR_SHARE :: 0.25f32;
cv_groom_share :: (u:[]f32,shadow:bool)->f32 {f:=abs(u[2]);f=ifx f>0 then f else 1.0f32;return ifx shadow then fmin(f,CV_SHADOW_HAIR_SHARE) else f;}
cv_groom_hash :: (seed:f32)->f32 {h:=sin(seed*251*12.9898)*43758.5453;return h-floor(h);}
cv_groom_kept :: (id:u32,vertices:[]u32,u:[]f32,shadow:bool)->bool {share:=cv_groom_share(u,shadow);if share>=1 {return true;}return cv_groom_hash(cv_word(vertices,ECHO_GROOM_WORD+8+((cast(int)id-1000000)/6)*12+10))<share;}
#test "Strand LOD keeps whole strands at about the requested share" {
 kept:=0;for k:0..<251 {if cv_groom_hash(cast(f32)k/251)<0.25 {kept+=1;}}#assert kept>45 && kept<80;
 u:[4]f32;#assert cv_groom_share(u[..],false)==1 && cv_groom_share(u[..],true)==0.25;u[2]= -0.5;#assert cv_groom_share(u[..],false)==0.5;u[2]=0.1;#assert cv_groom_share(u[..],true)==0.1f32;
}
cv_groom :: (id:u32,vertices:[]u32,u:[]f32,bones:[]f32,shadow:bool)->GroomVertex {
 vertex:=cast(int)id-1000000;at:=ECHO_GROOM_WORD+8+(vertex/6)*12;endpoint:=cv_groom_endpoint(vertex%6);p0:=cv_head(v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2)),u,bones);p1:=cv_head(v3(cv_word(vertices,at+4),cv_word(vertices,at+5),cv_word(vertices,at+6)),u,bones);p:=ifx endpoint==0 then p0 else p1;t:=wg_normalize3(cv_sub(p1,p0));view:=wg_normalize3(cv_sub(cv_at(u,8),p));side:=wg_normalize3(wg_cross3(t,view));radius:=cv_word(vertices,at+endpoint*4+3)/cv_groom_share(u,shadow);z:=fmax(0.05f32,wg_dot3(cv_sub(p,cv_at(u,8)),cv_at(u,20)));expanded:=fmax(radius,z/(u[19]*u[1]));edge:=cv_groom_side(vertex%6);world:=cv_add(p,cv_scale(side,expanded*edge));return GroomVertex.{world=world,normal=wg_normalize3(wg_cross3(side,t)),tangent=t,uv=v2(cv_word(vertices,at+8+endpoint),cv_word(vertices,at+10)),material=cast(f32)vertices[at+11],coverage=radius/expanded,edge=edge};
}
cv_skin :: (id:u32,p:V4,vertices:[]u32,bones:[]f32)->V3 {
 at:=cv_vertex_at(id,vertices);out:=v3(0,0,0);sum:f32=0;
 for k:0..<8 {joint:=cast(int)((vertices[at+9+k/2]>>cast(u32)((k%2)*16))&65535);weight:=cast(f32)((vertices[at+13+k/4]>>cast(u32)((k%4)*8))&255)/255;
  if weight>0 && joint<334 {b:=joint*12;q:=v3(wg_dot4(wg_at4(bones,b),p),wg_dot4(wg_at4(bones,b+4),p),wg_dot4(wg_at4(bones,b+8),p));out=cv_add(out,cv_scale(q,weight));sum+=weight;}}
 return cv_scale(out,1/fmax(sum,0.00001f32));
}
cv_echo_direction :: (p:V3,u:[]f32)->V3 {return v3(u[108]*p.x+u[109]*p.z,p.y,-u[109]*p.x+u[108]*p.z);}
cv_echo_mask :: (uv:V2,material:f32,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,dx:V2,dy:V2) {
 if material==ECHO_LASH_SLOT {if cv_echo_lash_mask(uv)<0.3333 {gpu_discard();}return;}
 m:=ECHO_MATERIAL_WORD+cast(int)material*16;if vertices[m+9]!=0 {gpu_discard();}alpha:=cast(int)vertices[m+3]-1;if alpha>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)alpha,dx,dy,0);if cv_srgb(a.x)<0.333333 {gpu_discard();}}
}
cv_srgb :: (x:f32)->f32 {return ifx x<=0.0031308 then 12.92*x else 1.055*pow(x,1.0f32/2.4f32)-0.055;}
cv_tone :: (x:f32)->f32 {return cv_srgb(fmin(1.0f32,(x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14)));}
#test "Echo source face graph applies instance colour multiplier desaturation contrast and tint" {
 c:=cv_echo_head_colour(v3(0.2,0.1,0.05));
 // UE Desaturation luminance factors (0.3,0.59,0.11), then CheapContrast_RGB(-0.02).
 #assert abs(c.x-0.417384)<0.000001 && abs(c.y-0.27176)<0.000001 && abs(c.z-0.1667997552)<0.000001;
 #assert cv_echo_head_colour(v3(10,10,10)).x==0.9;
 b:=cv_echo_body_colour(v3(0.2,0.1,0.05));#assert abs(b.x-0.18)<0.000001 && abs(b.y-0.1164215)<0.000001 && b.z==0.0625;
}
// M_Head_Echo: texture * Color_Mult -> Desaturation -> CheapContrast_RGB -> Tint.
// M_Head_Echo_Inst overrides 2.5, 0.2, -0.02 and (0.9,1,0.949020).
cv_echo_head_colour :: (a:V3)->V3 {
 c:=cv_scale(a,2.5);l:=c.x*0.3+c.y*0.59+c.z*0.11;
 return v3(clampf((c.x*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.9,clampf((c.y*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32),clampf((c.z*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.949020);
}
#test "Slay head instance retains its own desaturation and tint instead of Valley settings" {
 c:=cv_echo_slay_head_colour(v3(0.2,0.1,0.05));#assert abs(c.x-0.4106946115)<0.000002 && abs(c.y-0.27764)<0.000002 && abs(c.z-0.168731506)<0.000002;
}
// Slay MI_Head_Echo: Desat=.3, Tint=(.921582,1,.871367), gain/contrast unchanged.
cv_echo_slay_head_colour :: (a:V3)->V3 {
 c:=cv_scale(a,2.5);l:=c.x*0.3+c.y*0.59+c.z*0.11;
 return v3(clampf((c.x*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32)*0.921582,clampf((c.y*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32),clampf((c.z*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32)*0.871367);
}
#test "Slay skin specular uses both highpass channels and the ORM specular mask" {
 #assert abs(cv_echo_head_f0(0,0,1)-0.00465449106)<0.000001;
 #assert abs(cv_echo_head_f0(1,1,1)-0.07341152)<0.000001;
 #assert cv_echo_head_f0(0.5,0.25,0)==0;
 #assert abs(cv_echo_head_f0(0.5,0.25,0.7)-0.014754683)<0.000002;
}
// MI_Head_Echo: lerp(SpecVary0,1,highpass.r) *
// lerp(SpecVary2,3,highpass.g) * ORM.r; UE dielectric F0 = .08 * Specular.
// M_Head_Echo's AmbientOcclusion: ORM.r to the power 1.6, remapped from 0..1 to 0.25..1.
cv_echo_head_ao :: (r:f32)->f32 {return 0.25+0.75*pow(fmax(r,0.0f32),1.6f32);}
// Lagarde and de Rousiers' specular occlusion (Moving Frostbite to PBR, 2014): reflections fade
// in creases (the lip seam, under the lower lip) and at grazing angles where AO is low.
// Unreal's ray-traced shadows darken the creases (the lip seam, under the lower lip, the nostrils)
// even under direct light; our shadow map is too coarse for them, so the source AO stands in.
// The teeth sit inside the mouth: Unreal's ray-traced shadows leave them only what reaches through
// the lips. Every light and the ambient reach them at this share; the key's shadow map is too coarse to resolve the lips, so it takes the same share.
SLAY_MOUTH_OCCLUSION :: 0.06f32;
// Skin carries the key's light a few mm past its shadow edge, mostly red: Unreal's subsurface profile
// turns shadowed creases (the nostrils, under the lips) warm instead of leaving them to the cool fill.
SLAY_SSS_BLEED_R :: 0.35f32;
SLAY_SSS_BLEED_G :: 0.07f32;
// Inside the mouth the scattered key is what Unreal shows: a dark red, not grey teeth.
SLAY_MOUTH_BLEED :: 0.5f32;
SLAY_SKIN_CONTACT :: 1.1f32;
cv_specular_occlusion :: (nv:f32,ao:f32,rough:f32)->f32 {return clampf(pow(fmax(nv,0.0f32)+ao,pow(2.0f32,-16.0f32*rough-1.0f32))-1.0f32+ao,0.0f32,1.0f32);}
#test "Head AO and specular occlusion follow the source remap and fade in creases" {
 #assert abs(cv_echo_head_ao(1)-1)<0.00001 && abs(cv_echo_head_ao(0)-0.25)<0.00001;
 #assert abs(cv_specular_occlusion(1,1,0.4)-1)<0.00001 && cv_specular_occlusion(0.05,0.3,0.4)<0.31 && cv_specular_occlusion(0.8,0.6,0.4)>0.55;
}
cv_echo_head_f0 :: (r:f32,g:f32,mask:f32)->f32 {return 0.08*mix(0.195238f32,0.917644f32,r)*mix(0.298004f32,1.0f32,g)*mask;}
cv_echo_body_colour :: (a:V3)->V3 {return v3(a.x*0.9,a.y*1.164215,a.z*1.25);}
#test "Character material override uses original collection gain four gamma 1.2 and instance rolloff" {c:=cv_echo_overrides(v3(0.1,0.05,0.02),0.7,0.07);#assert abs(c.x-0.318432139)<0.000002 && abs(c.y-0.185325344)<0.000002 && abs(c.z-0.094407422)<0.000002;#assert cv_echo_overrides(v3(0,0,0),0.7,0.07).x==0;}
// MF_CharacterMaterialOverrides + MPC_CharacterAlbedo: gain 4, gamma 1.2,
// identity YCoCg Low/High, per-channel MinValue=0/Rolloff, then Desaturation.
cv_echo_overrides :: (base:V3,rolloff:f32,desat:f32)->V3 {c:=v3(pow(fmax(0.0f32,base.x*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.y*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.z*4),1.0f32/1.2f32)*rolloff);l:=wg_dot3(c,v3(0.3,0.59,0.11));return cv_add(cv_scale(c,1-desat),v3(l*desat,l*desat,l*desat));}
cv_echo_core_material :: (m:f32)->bool {return m==0 || m==1 || m==2 || m==4 || m==5 || m==6 || m==8 || m==13 || m==15 || m==23 || m==25;}
#test "Source angle corrected normal blend preserves either flat input" {a:=v3(0.2,0.1,0.9746794);b:=cv_echo_normal_blend(a,v3(0,0,1));#assert abs(a.x-b.x)<0.000001 && abs(a.z-b.z)<0.000001;b=cv_echo_normal_blend(v3(0,0,1),a);#assert abs(a.y-b.y)<0.000001 && abs(a.z-b.z)<0.000001;}
cv_echo_normal_blend :: (base:V3,detail:V3)->V3 {t:=v3(base.x,base.y,base.z+1);d:=v3(-detail.x,-detail.y,detail.z);return cv_sub(cv_scale(t,wg_dot3(t,d)/t.z),d);}
cv_echo_normal :: (a:V4,strength:f32)->V3 {return v3((cv_srgb(a.x)*2-1)*strength,(1-cv_srgb(a.y)*2)*strength,cv_srgb(a.z)*2-1);}
#test "Source groom colours retain the demo's brown root tip and pepper settings" {c:=cv_echo_groom_colour(0,0.5);#assert abs(c.x-0.08125)<0.000001 && abs(c.z-0.0284375)<0.000001;p:=cv_echo_groom_colour(0.5,0.1);#assert p.x==0.201556 && p.y==0.125356 && p.z==0.070545;}
// The sample's blonde hair material (MI_Hair_Cards_Blonde): root (darkened), mid and tip colours
// blended at its 0.55 root-tip bias, its straition colour for 15% of strands, and a per-strand
// brightness spread. A negative u[2] selects it over the source brown groom.
cv_blonde_groom_colour :: (u:f32,seed:f32)->V3 {
 if seed<0.15 {return v3(0.432292,0.331606,0.25217);}
 root:=v3(0.4,0.26710073,0.19570320);mid:=v3(0.65,0.422206,0.241219);tip:=v3(0.8,0.706667,0.52);
 c:=ifx u<0.55 then cv_add(root,cv_scale(cv_sub(mid,root),u/0.55)) else cv_add(mid,cv_scale(cv_sub(tip,mid),(u-0.55)/0.45));
 return cv_scale(c,mix(0.8f32,1.1f32,(seed-0.15)/0.85));
}
cv_hair_colour :: (u:[]f32,along:f32,seed:f32)->V3 {return ifx u[2]<0 then cv_blonde_groom_colour(along,seed) else cv_echo_groom_colour(along,seed);}
#test "The blonde groom follows the sample's root, mid and tip colours" {
 r:=cv_blonde_groom_colour(0,1);#assert abs(r.x-0.44)<0.00001 && abs(r.z-0.21527352)<0.00001;
 m:=cv_blonde_groom_colour(0.55,0.15);#assert abs(m.x-0.52)<0.00001;
 #assert cv_blonde_groom_colour(0.3,0.1).x==0.432292f32;
 u:[4]f32;u[2]=1;#assert cv_hair_colour(u[..],0,0.5).x==cv_echo_groom_colour(0,0.5).x;u[2]= -1;#assert cv_hair_colour(u[..],0,0.5).x==cv_blonde_groom_colour(0,0.5).x;
}
// UE 5.8 dual scattering (HairStrandsDeepTransmittanceDualScattering.ush). UE reads each strand's
// hair count toward the light from deep shadow maps, which are not ported; SLAY_HAIR_COUNT is one
// mean count (already less the one UE subtracts) for every strand and light. The average front and back scattering is UE's
// hair LUT (HairStrandsLUT.usf: Specular 0.5, backlit 1, separable R, energy-matched TT absorption)
// integrated for roughness 0.4 at 16 perceptual absorptions (sqrt of base colour) by 4 light angles
// (docs/verification/valley-lab-slay-2026-11-06/hair-lut.txt keeps the table).
cv_hair_average :: (xin:f32,sinl:f32,back:bool)->f32 {
 // Per light angle, a polynomial in absorption (degree 5 front, 3 back) fitted to the LUT's columns
 // for absorptions from 0.09375, its coefficients cubic in the angle; within 0.0007 of every LUT
 // entry. Below that the first LUT row is blended in. No per-pixel table, which cost 3x frame time.
 s:=clampf(abs(sinl),0.125f32,0.875f32);x:=clampf(xin,0.09375f32,1.0f32);
 v:=ifx back then (0.03127134f32+s*(0.0263001f32+s*(-0.08230201f32+s*0.08255216f32)))+x*((0.02026131f32+s*(0.0383529f32+s*(-0.1136023f32+s*0.07513832f32)))+x*((0.04536147f32+s*(-0.156055f32+s*(0.5274444f32+s*-0.4732738f32)))+x*((-0.008773213f32+s*(0.08169104f32+s*(-0.267709f32+s*0.3092193f32)))))) else (-0.02191352f32+s*(0.02817137f32+s*(-0.08309926f32+s*0.116148f32)))+x*((4.290813f32+s*(-0.8071187f32+s*(3.267088f32+s*-3.536371f32)))+x*((-9.24721f32+s*(1.820217f32+s*(-7.249328f32+s*8.141093f32)))+x*((11.57168f32+s*(-2.361881f32+s*(9.28707f32+s*-10.77409f32)))+x*((-7.912303f32+s*(1.653527f32+s*(-6.447952f32+s*7.665429f32)))+x*((2.240081f32+s*(-0.4747067f32+s*(1.842029f32+s*-2.230259f32))))))));
 low:=ifx back then mix(0.03394f32,0.04678f32,(s-0.125)/0.75) else mix(0.10855f32,0.13457f32,(s-0.125)/0.75);
 return fmin(0.99f32,ifx xin<0.09375 then mix(low,v,clampf((xin-0.03125)/0.0625,0.0f32,1.0f32)) else v);
}
cv_hair_asin :: (s:f32)->f32 {return wg_atan2(s,sqrt(fmax(0.0f32,1-s*s)));}
cv_dual_channel :: (af:f32,ab:f32,bf:f32,bb:f32,shift:f32,theta:f32,count:f32,fs:f32)->f32 {
 af2:=af*af;ab2:=ab*ab;one:=1-af2;big:=ab*af2/one+ab*ab2*af2/(one*one*one);
 delta:=shift*(1-2*ab2/(one*one))*shift*(2*one*one+4*af2*ab2)/(one*one*one);q:=sqrt(2*bf*bf+bb*bb);sigma:=(1+0.7*af2)*(ab*q+ab*ab2*q)/(ab+ab*ab2*(2*bf+3*bb));
 sf2:=bf*bf*fmax(1.0f32,count);local:=2*big*exp(-0.5*(theta-delta)*(theta-delta)/(sf2+sigma*sigma))/3.14159265*0.7;
 global:=mix(1.0f32,pow(af,count)*exp(-0.5*theta*theta/sf2)/3.14159265*0.7,clampf(count,0.0f32,1.0f32));
 return global*(fs+local);
}
// UE samples the LUT at each light's angle. Here it is sampled once per hair vertex at the view
// angle and shared by every light: per-pixel, per-light lookups cost a third of the frame.
HairAverage :: struct {front:V3;back:V3;}
cv_hair_averages :: (base:V3,sinv:f32)->HairAverage {
 x:=v3(sqrt(fmax(base.x,0.0f32)),sqrt(fmax(base.y,0.0f32)),sqrt(fmax(base.z,0.0f32)));
 return HairAverage.{front=v3(cv_hair_average(x.x,sinv,false),cv_hair_average(x.y,sinv,false),cv_hair_average(x.z,sinv,false)),back=v3(cv_hair_average(x.x,sinv,true),cv_hair_average(x.y,sinv,true),cv_hair_average(x.z,sinv,true))};
}
cv_hair_dual :: (avg:HairAverage,rough:f32,sl:f32,sv:f32,count:f32,fs:V3)->V3 {
 af:=avg.front;ab:=avg.back;
 r:=clampf(rough,0.18f32,0.6f32);br:=r*r;btt:=r*r*0.25;btrt:=r*r*4;fa:=af.x+af.y+af.z;ba:=ab.x+ab.y+ab.z;
 bf:=(br*af.x+btt*af.y+btrt*af.z)/fa;bb:=(br*ab.x+btt*ab.y+btrt*ab.z)/ba;shift:=(-0.07*af.x+0.035*af.y+0.14*af.z)/fa;theta:=(cv_hair_asin(sl)+cv_hair_asin(sv))*0.5;
 return v3(cv_dual_channel(af.x,ab.x,bf,bb,shift,theta,count,fs.x),cv_dual_channel(af.y,ab.y,bf,bb,shift,theta,count,fs.y),cv_dual_channel(af.z,ab.z,bf,bb,shift,theta,count,fs.z));
}
#test "Dual scattering reads UE's hair LUT and brightens blonde far more than the source brown" {
 #assert abs(cv_hair_average(0.21875,0.375,false)-0.58008)<0.001 && abs(cv_hair_average(0.78125,0.625,true)-0.07966)<0.0002 && abs(cv_hair_average(0.96875,0.875,false)-0.88)<0.05;
 #assert abs(cv_hair_average(0.03125,0.125,false)-0.10855)<0.00001 && abs(cv_hair_average(0.03125,0.875,true)-0.04678)<0.00001;
 z:=v3(0,0,0);brown:=cv_hair_dual(cv_hair_averages(v3(0.1,0.062,0.035),0.1),0.4,0.1,0.1,0,z);blonde:=cv_hair_dual(cv_hair_averages(v3(0.6,0.45,0.3),0.1),0.4,0.1,0.1,0,z);
 #assert brown.x>0 && brown.x<blonde.x && blonde.x>blonde.z && blonde.x<1;
 deep:=cv_hair_dual(cv_hair_averages(v3(0.6,0.45,0.3),0.1),0.4,0.1,0.1,SLAY_HAIR_COUNT,z);#assert deep.x<blonde.x;one:=v3(1,1,1);#assert cv_hair_dual(cv_hair_averages(v3(0.6,0.45,0.3),0.1),0.4,0.1,0.1,0,one).x==1+blonde.x;
}
cv_echo_groom_colour :: (u:f32,seed:f32)->V3 {if seed<0.15 {return v3(0.201556,0.125356,0.070545);}brightness:=ifx seed<1.0f32/3 then mix(0.4f32,0.15f32,seed*3) else ifx seed<2.0f32/3 then mix(0.15f32,0.5f32,seed*3-1) else mix(0.5f32,0.0f32,seed*3-2);return cv_scale(v3(mix(0.25f32,0.234375f32,u),mix(0.154883f32,0.164421f32,u),mix(0.0875f32,0.105469f32,u)),brightness);}
// The source eye's "Scale Pupils" node, at the instance's PupilScale=0.75.
#test "Eye pupil scaling retains centre and rim and source corner shadow bounds" {c:=cv_echo_pupil(v2(0.5,0.5));#assert c.x==0.5 && c.y==0.5;r:=cv_echo_pupil(v2(1,0.5));#assert r.x==1 && r.y==0.5;#assert cv_echo_eye_shadow(0)==1 && cv_echo_eye_shadow(0.35)==0;}
cv_echo_pupil :: (uv:V2)->V2 {x:=uv.x-0.5;y:=uv.y-0.5;r:=sqrt(x*x+y*y);if r<0.000001 {return v2(0.5,0.5);}k:=0.5/r*(1-clampf((1-r*2)*0.75,0.0f32,1.0f32));return v2(x*k+0.5,y*k+0.5);}
cv_echo_eye_shadow :: (radius:f32)->f32 {return clampf((1-radius/0.345)/(1-0.535610),0.0f32,1.0f32);}
#test "Original lash opacity tapers to the root and preserves the central tip" {#assert cv_echo_lash_mask(v2(0.5,1))==1 && cv_echo_lash_mask(v2(0.5,0))==0;#assert abs(cv_echo_lash_mask(v2(0,1))-0.35355339)<0.000001;}
cv_echo_lash_mask :: (uv:V2)->f32 {return pow(fmax(0.0f32,1-abs(uv.x-0.5)),1.5f32)*pow(fmax(0.0f32,uv.y),0.45f32);}
#test "Canyon material helpers retain linear roughness and bounded filmic response" {#assert abs(cv_srgb(0.21404114)-0.5)<0.00001;#assert cv_tone(0)==0 && cv_tone(1)>0.9 && cv_tone(100)<=1;}
cv_fiber_light :: (base:V3,t:V3,l:V3,v:V3,rough:f32,seed:f32,avg:HairAverage)->V3 {
 // Rootward tangent follows the source hair BSDF convention.
 root:=cv_scale(t,-1);sl:=wg_dot3(root,l);sv:=wg_dot3(root,v);lp:=cv_sub(l,cv_scale(root,sl));vp:=cv_sub(v,cv_scale(root,sv));phi:=wg_dot3(lp,vp)/sqrt(wg_dot3(lp,lp)*wg_dot3(vp,vp)+0.0001);vl:=wg_dot3(v,l);spec:=mix(0.05f32,0.1f32,seed);back:=mix(0.15f32,0.5f32,seed);
 // UE's global scattering times (Fs plus local scattering), before the light colour.
 return cv_hair_dual(avg,rough,sl,sv,SLAY_HAIR_COUNT,v3(hair_fiber(base.x,rough,spec,back,sl,sv,phi,vl),hair_fiber(base.y,rough,spec,back,sl,sv,phi,vl),hair_fiber(base.z,rough,spec,back,sl,sv,phi,vl)));
}
cv_mul :: (a:V3,b:V3)->V3 {return v3(a.x*b.x,a.y*b.y,a.z*b.z);}
#test "Each light evaluates its own microfacet highlight and back lights contribute zero" {
 n:=v3(0,0,1);a:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,n,n,1);
 #assert abs(a.x-0.369239468)<0.000002;
 b:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,v3(0,0,-1),n,1);#assert b.x==0 && b.y==0 && b.z==0;
 d:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,n,n,0);#assert abs(d.x-0.318309886)<0.000002;
}
cv_surface_light :: (base:V3,f0:V3,metal:f32,rough:f32,n:V3,l:V3,v:V3,spec_scale:f32)->V3 {return cv_area_light(base,f0,metal,rough,n,l,v,spec_scale,0);}
// Unreal's sphere-light widening (New_a2): a light subtending sin(angle) `size`
// spreads a smooth surface's highlight instead of leaving a pinpoint.
cv_area_a2 :: (a:f32,size:f32,vh:f32)->f32 {return fmin(1.0f32,a*a+0.25*size*(3*a+size)/(vh+0.001));}
cv_area_light :: (base:V3,f0:V3,metal:f32,rough:f32,n:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {
 nl:=fmax(0.0f32,wg_dot3(n,l));if nl==0 {return v3(0,0,0);}
 h:=wg_normalize3(cv_add(l,v));nv:=fmax(0.0001f32,wg_dot3(n,v));nh:=fmax(0.0f32,wg_dot3(n,h));vh:=fmax(0.0f32,wg_dot3(v,h));a:=rough*rough;aa:=cv_area_a2(a,size,vh);den:=nh*nh*(aa-1)+1;k:=(rough+1)*(rough+1)/8;
 scale:=aa/(3.14159265*den*den)*nv/(nv*(1-k)+k)*nl/(nl*(1-k)+k)/(4*nv)*spec_scale;f:=pow(1-vh,5.0f32);
 return cv_add(cv_scale(base,nl*(1-metal)/3.14159265),cv_scale(v3(f0.x+(1-f0.x)*f,f0.y+(1-f0.y)*f,f0.z+(1-f0.z)*f),scale));
}
#test "Skin keeps light past the terminator in red only and broadens its highlight" {
 n:=v3(0,0,1);l:=wg_normalize3(v3(0,1,-0.2));v:=v3(0,0,1);f0:=v3(0.028,0.028,0.028);
 back:=cv_skin_light(v3(0.8,0.5,0.4),f0,0.4,n,n,l,v,1,0);#assert back.x>0 && back.z==0 && cv_surface_light(v3(0.8,0.5,0.4),f0,0,0.4,n,l,v,1).x==0;
 h:=wg_normalize3(v3(0,0.3,1));r:=wg_normalize3(cv_sub(cv_scale(h,2*wg_dot3(h,v)),v));peak:=cv_skin_light(v3(0,0,0),f0,0.3,h,h,r,v,1,0);plain:=cv_surface_light(v3(0,0,0),f0,0,0.3,h,r,v,1);
 #assert peak.x>0 && peak.x<plain.x;
 front:=cv_skin_light(v3(0.8,0.5,0.4),f0,0.4,n,n,n,v,1,0);flat:=cv_surface_light(v3(0.8,0.5,0.4),f0,0,0.4,n,n,v,1);#assert abs(front.z-flat.z)<0.02 && front.x<flat.x+0.02;
}
// Unreal's subsurface-profile skin: two specular lobes at 0.75x and 1.30x roughness
// mixed 0.85 toward the broader one, and diffuse that wraps further for red than
// green and blue, with diffuse normals bent toward the smoother geometric normal.
#test "An area light lowers a smooth highlight's peak, keeps point lights unchanged and stays bounded" {
 n:=v3(0,0,1);v:=v3(0,0,1);f0:=v3(0.04,0.04,0.04);black:=v3(0,0,0);
 #assert cv_area_light(black,f0,0,0.2,n,n,v,1,0).x==cv_surface_light(black,f0,0,0.2,n,n,v,1).x;
 #assert cv_area_light(black,f0,0,0.2,n,n,v,1,SLAY_KEY_SIZE).x<cv_surface_light(black,f0,0,0.2,n,n,v,1).x*0.5;
 #assert cv_area_a2(0.04,0,1)==0.04*0.04 && cv_area_a2(0.04,SLAY_KEY_SIZE,1)>0.04*0.04 && cv_area_a2(1,1,0)==1;
}
// Skin's direct highlights: half way to the geometric normal and no smoother than this, so the
// pores' normals don't break the key into the wet glints Unreal's subsurface and TSR never show.
SLAY_SKIN_SPEC_ROUGH :: 0.4f32;
cv_skin_light :: (base:V3,f0:V3,rough:f32,n:V3,g:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {
 black:=v3(0,0,0);ns:=wg_normalize3(cv_add(cv_scale(n,0.5),cv_scale(g,0.5)));sr:=fmax(rough,SLAY_SKIN_SPEC_ROUGH);a:=cv_area_light(black,f0,0,clampf(sr*0.75,0.045f32,1.0f32),ns,l,v,spec_scale,size);b:=cv_area_light(black,f0,0,clampf(sr*1.3,0.045f32,1.0f32),ns,l,v,spec_scale,size);
 nr:=wg_normalize3(cv_add(cv_scale(n,0.4),cv_scale(g,0.6)));ng:=wg_normalize3(cv_add(cv_scale(n,0.75),cv_scale(g,0.25)));
 dr:=fmax(0.0f32,(wg_dot3(nr,l)+0.35)/1.35);dg:=fmax(0.0f32,(wg_dot3(ng,l)+0.12)/1.12);db:=fmax(0.0f32,wg_dot3(n,l));
 return cv_add(cv_add(cv_scale(a,0.15),cv_scale(b,0.85)),v3(base.x*dr/3.14159265,base.y*dg/3.14159265,base.z*db/3.14159265));
}
// Unreal's skin in TF0290 carries a soft, even sheen from its reflections of the temple and sky
// (about 0.02 linear on the face, neutral to warm): environment specular, split-sum, at this radiance.
SLAY_SKIN_ENV :: 0.7f32;
cv_slay_light :: (skin:bool,base:V3,f0:V3,metal:f32,rough:f32,n:V3,g:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {if skin {return cv_skin_light(base,f0,rough,n,g,l,v,spec_scale,size);}return cv_area_light(base,f0,metal,rough,n,l,v,spec_scale,size);}
#test "Walking Valley and Slay retain their own source head material profiles" {a:=v3(0.2,0.1,0.05);v:=cv_profile_head_colour(a,true);s:=cv_profile_head_colour(a,false);#assert v.x==cv_echo_head_colour(a).x && s.x==cv_echo_slay_head_colour(a).x && v.x!=s.x;}
cv_profile_head_colour :: (a:V3,valley:bool)->V3 {return ifx valley then cv_echo_head_colour(a) else cv_echo_slay_head_colour(a);}
cv_scale2 :: (a:V2,k:f32)->V2 {return v2(a.x*k,a.y*k);}
// Echo's surface at a pixel: the material's albedo, roughness, metalness, dielectric F0 and
// occlusion, and the normal with its maps applied. Discards what her masks cut (the lashes'
// taper, a hidden section, an alpha-masked texel).
EchoMaterial :: struct {normal:V3;albedo:V3;rough:f32;metal:f32;f0:f32;occlusion:f32;}
cv_echo_material :: (normal:V3,tangent:V4,world:V3,uv:V2,material:f32,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,dx:V2,dy:V2)->EchoMaterial {
 n:=wg_normalize3(normal);albedo:=v3(1,1,1);rough:f32=0.65;metal:f32=0;skin_f0:f32=0.04;occlusion:f32=1;
 cv_echo_mask(uv,material,vertices,sheets,sheet,dx,dy);m:=ECHO_MATERIAL_WORD+cast(int)material*16;albedo=v3(cv_word(vertices,m+4),cv_word(vertices,m+5),cv_word(vertices,m+6));rough=cv_word(vertices,m+8);metal=cv_word(vertices,m+7);colour:=cast(int)vertices[m]-1;normal_map:=cast(int)vertices[m+1]-1;orm:=cast(int)vertices[m+2]-1;
   if colour>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)colour,dx,dy,0);albedo=v3(albedo.x*a.x,albedo.y*a.y,albedo.z*a.z);}if orm>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)orm,dx,dy,0);rough=cv_srgb(a.y);metal=cv_srgb(a.z);}
   if (material==26 || material==27) {albedo=cv_hair_colour(u,uv.x,uv.y);metal=0;rough=mix(0.32f32,0.45f32,uv.y)*(1+0.1*uv.x);}
   if material==ECHO_LASH_SLOT {albedo=cv_scale(v3(mix(0.08f32,0.16f32,uv.y),mix(0.053397f32,0.090834f32,uv.y),mix(0.04f32,0.056f32,uv.y)),0.5);rough=0.6;metal=0;}
   if material==ECHO_HEAD_SLOT {albedo=cv_profile_head_colour(albedo,u[114]<0);metal=0;macro:=render_sample_layer8_grad(sheets,sheet,uv,26,dx,dy,0);additional:=render_sample_layer8_grad(sheets,sheet,uv,27,dx,dy,0);rough=macro.x+rough*0.2+additional.x;highpass:=render_sample_layer8_grad(sheets,sheet,uv,31,dx,dy,0);mask:=render_sample_layer8_grad(sheets,sheet,uv,17,dx,dy,0);if u[114]>=0 {skin_f0=cv_echo_head_f0(highpass.x,highpass.y,cv_srgb(mask.x));}occlusion=cv_echo_head_ao(cv_srgb(mask.x));}
   if material==ECHO_SKIN_SLOT {albedo=cv_echo_body_colour(albedo);rough=rough*0.2+0.45*0.8;metal=0;}
   if material==ECHO_EYE_LEFT_SLOT || material==ECHO_EYE_RIGHT_SLOT {x:=uv.x-0.5;y:=uv.y-0.5;r:=sqrt(x*x+y*y);iris_uv:=cv_echo_pupil(v2(x/0.3+0.5,y/0.3+0.5));iris:=render_sample_layer8_grad(sheets,sheet,iris_uv,9,cv_scale2(dx,1/0.3),cv_scale2(dy,1/0.3),0);mask:=1-smoothstep(0.115f32,0.15f32,r);limbus:=1-pow(fmin(1.0f32,sqrt((iris_uv.x-0.5)*(iris_uv.x-0.5)+(iris_uv.y-0.5)*(iris_uv.y-0.5))*2.15),8.0f32);ic:=v3(pow(iris.x*0.723055*1.4*2,1.1f32),pow(iris.y*0.644480*1.4*2,1.1f32),pow(iris.z*0.623960*1.4*2,1.1f32));sclera:=v3(albedo.x*0.541667,albedo.y*0.494239,albedo.z*0.460880);albedo=cv_add(cv_scale(sclera,1-mask),cv_scale(ic,mask*limbus));corner:=cv_echo_eye_shadow(r);albedo=v3(albedo.x*mix(0.23f32,1.0f32,corner)*1.4,albedo.y*mix(0.083042f32,1.0f32,corner)*1.4,albedo.z*mix(0.031906f32,1.0f32,corner)*1.4);}
   if normal_map>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)normal_map,dx,dy,0);strength:=ifx material==ECHO_HEAD_SLOT then 0.65f32 else ifx material==ECHO_SKIN_SLOT then 1.0f32 else ifx material==5 || material==13 then 0.7f32 else ifx cv_echo_core_material(material) then 0.65f32 else 1.0f32;map:=cv_echo_normal(a,strength);
    if material==ECHO_HEAD_SLOT {micro:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,uv,28,dx,dy,0),1);view:=wg_normalize3(cv_sub(cv_at(u,8),world));fresnel:=pow(1-fmax(0.0f32,wg_dot3(n,view)),3.0f32);amount:=0.5+fresnel;detail:=cv_add(cv_scale(v3(0,0,1),1-amount),cv_scale(micro,amount));detail=v3(detail.x*0.75,detail.y*0.75,detail.z);map=cv_echo_normal_blend(map,detail);brow:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,uv,29,dx,dy,0),0.1);mask:=render_sample_layer8_grad(sheets,sheet,uv,30,dx,dy,0).x;map=cv_add(cv_scale(map,1-mask),cv_scale(brow,mask));}
    t:=wg_normalize3(v3(tangent.x,tangent.y,tangent.z));b:=cv_scale(wg_cross3(n,t),tangent.w);n=wg_normalize3(cv_add(cv_scale(t,map.x),cv_add(cv_scale(b,map.y),cv_scale(n,map.z))));}
   if cv_echo_core_material(material) {view:=wg_normalize3(cv_sub(cv_at(u,8),world));nv:=clampf(wg_dot3(n,view),0.0f32,1.0f32);fuzzy:f32=1;
    if material==2 || material==23 {fuzzy=1-0.1*nv;}if material==5 || material==13 {fuzzy=mix(1.0f32,1-0.15*nv+pow(1-nv,1.8f32),smoothstep(0.97f32,0.98f32,nv));}
    mult:=ifx material==1 || material==15 then 0.6f32 else 1.0f32;gamma:=ifx material==8 then 1.1f32 else ifx material==5 || material==13 then 1.05f32 else 1.0f32;albedo=v3(pow(fmax(0.0f32,albedo.x*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.y*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.z*fuzzy*mult),1/gamma));rolloff:=ifx material==5 || material==13 || material==8 then 0.6f32 else 0.7f32;desat:=ifx material==6 then 0.07f32 else ifx material==2 || material==23 || material==8 then 0.1f32 else 0.05f32;albedo=cv_echo_overrides(albedo,rolloff,desat);
    if material==0 {rough=rough*0.6+0.095238;}if material==1 || material==15 {rough*=0.721429;}if material==8 {rough*=0.883333;}if material==5 || material==13 {rough*=0.857451;}
   }
 return EchoMaterial.{normal=n,albedo=albedo,rough=rough,metal=metal,f0=skin_f0,occlusion=occlusion};
}
