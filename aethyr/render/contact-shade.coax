// Normal/depth contact shading (lighting plan Phase 1 step 0, GitHub #13060; Phase 5 builds on it).
// A lit pass stores each pixel's octahedral normal, its indirect-light share and its signed view
// depth in one auxiliary target; the post pass rebuilds view points from that depth and darkens
// creases by how far neighbouring points rise above the normal, weighted by the indirect share, so
// contact shading never darkens direct sunlight. Character Create's glade defined it (its
// cg_normal_pack, cg_normal_unpack, cg_viewpoint and cg_contact_ao now call these). GPU-safe Coax.
//   coax/bin/coax test aethyr/render/contact-shade.coax
#load "../gpu/wgsl.coax";

#test "glade octahedral normal storage leaves room for indirect-light weight" {
 for i:0..<6 {n:=normalize3(v3(ifx i%2==0 then 0.3f32 else -0.3f32,ifx i<3 then 0.7f32 else -0.7f32,ifx i%3==0 then -0.4f32 else 0.4f32));p:=shade_normal_pack(n);r:=shade_normal_unpack(p);#assert dot3(n,r)>0.9999f32;}
 p:=shade_normal_pack(v3(0,0,-1));#assert abs(p.x)+abs(p.y)<=1.00001f32 || abs(p.x)==1 || abs(p.y)==1;
 #assert shade_sign(-0.5)== -1 && shade_sign(0)==1 && shade_sign(2)==1;
}
#test "contact reconstruction preserves camera-forward depth" {
 p:=shade_view_point(v2(50,40),4,v3(2,1,3),v3(0,0,-1),v3(1,0,0),v3(0,1,0),100,v2(50,40));#assert p.x==2 && p.y==1 && p.z== -1;
 q:=shade_view_point(v2(150,40),2,v3(0,0,0),v3(0,0,-1),v3(1,0,0),v3(0,1,0),100,v2(50,40));#assert q.x==2 && q.y==0 && q.z== -2;
}
#test "contact taps darken only points that rise above the normal close by" {
 n:=v3(0,1,0);c:=v3(0,0,0);
 #assert shade_contact_tap(n,c,v3(0.2,0,0))==0 && shade_contact_tap(n,c,v3(0,-0.2,0))==0;
 near:=shade_contact_tap(n,c,v3(0.1,0.2,0));far:=shade_contact_tap(n,c,v3(0.4,0.8,0));#assert near>far && far==0 && near>0;
 #assert shade_contact_finish(0)==1 && abs(shade_contact_finish(8)-0.35f32)<0.000001;
 #assert shade_contact_radius(100)==4 && shade_contact_radius(1080)==12.96f32 && shade_contact_radius(4000)==18;
}
shade_sign :: (x:f32)->f32 #export_c #effects(all) {return ifx x<0 then -1.0f32 else 1.0f32;}
shade_normal_pack :: (n:V3)->V2 {
 v:=scale3(n,1.0f32/(abs(n.x)+abs(n.y)+abs(n.z)));p:=v2(v.x,v.y);
 if (v.z<0) {p=v2((1.0f32-abs(v.y))*shade_sign(v.x),(1.0f32-abs(v.x))*shade_sign(v.y));}return p;
}
shade_normal_unpack :: (p:V2)->V3 {
 n:=v3(p.x,p.y,1.0f32-abs(p.x)-abs(p.y));t:=saturate(-n.z);n.x=n.x-shade_sign(n.x)*t;n.y=n.y-shade_sign(n.y)*t;return normalize3(n);
}
// The world point at view depth z under pixel: the eye plus z along the ray through the pixel
// (forward, right and up the camera's axes, focal its focal length in pixels, centre its middle).
shade_view_point :: (pixel:V2,z:f32,eye:V3,forward:V3,right:V3,up:V3,focal:f32,centre:V2)->V3 {
 return add3(eye,scale3(add3(forward,add3(scale3(right,(pixel.x-centre.x)/focal),scale3(up,(centre.y-pixel.y)/focal))),z));
}
// The sampling ring's radius (pixels) for a frame `height` pixels tall.
shade_contact_radius :: (height:f32)->f32 #export_c #effects(all) {return clampf(height*0.012f32,4.0f32,18.0f32);}
// One tap: how far the neighbour at rises above the normal n at center, fading out past 0.6 m.
shade_contact_tap :: (n:V3,center:V3,at:V3)->f32 {
 delta:=sub3(at,center);distance:=wg_length3(delta);
 return saturate((dot3(n,delta)-0.015f32)/fmax(distance,0.0001f32))*(1.0f32-smoothstep(0.1f32,0.6f32,distance));
}
// Eight taps' sum to the indirect light's attenuation.
shade_contact_finish :: (sum:f32)->f32 #export_c #effects(all) {return 1.0f32-sum*0.65f32/8.0f32;}
