// The Metaverse Engine's film profile (GitHub #13004, phase F1 of
// docs/research/vork/2026-11-07-desktop-film-renderer.md): how a native host renders one film
// frame as the average of N deterministic renders over pixel jitter, shutter time and lens
// aperture. It is not a rung on aethyr/core/quality.coax's ladder, which exists to hold 60 FPS; a film
// frame has no frame budget, but it has a film budget that refuses before the first frame.
//
// Scene content and render quality stay separate: the realm's state, stage or cut is the
// content, and this record only changes where and when the realm is sampled (the sample time,
// the pixel offset and the eye on the aperture), never how it is shaded.
//
// Everything here is a pure function of the profile, the frame and the sample, so two renders of
// the same input draw the same samples. Times are whole nanoseconds, as aethyr/core/loop.coax keeps
// them: a host advances the realm by the gap between one sample's time and the next, so the
// fixed steps a frame runs are the ones it would run at one sample (see the clock check below).
//
// The camera's optics are CameraLens (aethyr/cam/shot.coax), with Blender's physical camera names and
// units, so Blender and Unreal cameras map one to one.
//   coax/bin/coax test aethyr/render/film.coax --library
//   coax c aethyr/render/film.coax --library --header film.h    (the C host, verse/gpu/vk-realm.c)

#module "aethyr.film";
#load "../core/rand.coax";
#load "../cam/shot.coax";
#load "../core/loop.coax";

// ---- the profile

FILM_MAX_SAMPLES :: 256;          // samples a frame at most
FILM_MAX_SIDE :: 8192;            // pixels a side at most
FILM_SECOND_NS :: 1000000000;

// Where the shutter is open, relative to the frame's time (vork's render.motion_blur position).
FILM_SHUTTER_START :: 0;          // from the frame's time on
FILM_SHUTTER_CENTER :: 1;         // around it
FILM_SHUTTER_END :: 2;            // up to it

FILM_RASTER :: 0;                 // the realm's own passes (F1, F2)
FILM_TRACED :: 1;                 // ray queries for shadow, AO and reflection (F3)

// The random streams a film draws from (aethyr/core/rand.coax): one each, so a change to one never
// moves another's numbers.
FILM_STREAM_TIME :: 1;
FILM_STREAM_JITTER_X :: 2;
FILM_STREAM_JITTER_Y :: 3;
FILM_STREAM_LENS_U :: 4;
FILM_STREAM_LENS_V :: 5;
FILM_STREAM_ROWS :: 6;            // the Latin-square shuffle of the y strata
FILM_STREAM_LENS_ROWS :: 7;       // and of the lens's second axis

// What the film lifts that the live frame keeps for 60 FPS. A realm reads these in place of its
// quality knobs when it draws a film frame.
FilmDetail :: struct {
  far: f32 = 2000;                // metres: level of detail holds full detail out to here
  scenery: f32 = 1;               // share of the far scenery's reach and count (trees)
  grass: f32 = 1;                 // share of the grass's density and distance
  fx: f32 = 1;                    // share of fire, smoke and glow puffs
  debris: f32 = 1;                // share of debris, splinters and dust
  far_figures: bool = true;       // far figures animate at the full rate
  full_mips: bool = true;         // textures at their full mip
}

// The film budget (chapter 16): a batch is refused at the start, not at frame 3,000.
FilmBudget :: struct {
  memory_bytes: int = 4294967296; // the accumulation and sample targets together
  draws: int = 65536;             // draw records a sample
  seconds_per_frame: f64 = 600;   // all of a frame's samples
}

FilmProfile :: struct {
  samples: int = 1;               // renders a frame
  shutter: f32 = 0;               // frames the shutter is open, 0 to 1 (0: no motion blur)
  position: int = FILM_SHUTTER_CENTER;
  stratified: bool = true;        // stratified jitter, times and lens; false: independent draws
  seed: int = 0;
  jitter: bool = true;            // pixel jitter (false: every sample at the pixel's centre)
  transport: int = FILM_RASTER;
  detail: FilmDetail;
  budget: FilmBudget;
}

// The film profile at live settings: one sample at the pixel's centre, the shutter shut, no
// lens. Rendering with it must give the live frame to the bit (#13003's check).
film_live :: () -> FilmProfile {
  p: FilmProfile;
  p.samples = 1; p.shutter = 0; p.jitter = false; p.detail = film_live_detail();
  return p;
}
film_live_detail :: () -> FilmDetail {
  d: FilmDetail;
  d.far = 0; d.scenery = 0; d.grass = 0; d.fx = 0; d.debris = 0; d.far_figures = false; d.full_mips = false;
  return d;   // 0 everywhere: the realm keeps its own live knobs
}

FilmRefusal :: enum u8 { ok; samples; shutter; position; size; targets; transport; memory; draws; seconds; rate; }

film_finite :: (a: f32) -> bool { return a == a && a < 1000000000.0 && a > -1000000000.0; }

// Whether a profile can render frames of width x height with `targets` RGBA targets: every field
// in range, and the accumulation (f32 RGBA) plus one half-float sample image per target within
// the memory budget. `draws` is the realm's measured draw records for a sample.
film_admit :: (p: FilmProfile, width: int, height: int, targets: int, draws: int) -> FilmRefusal {
  if p.samples < 1 || p.samples > FILM_MAX_SAMPLES { return FilmRefusal.samples; }
  if !film_finite(p.shutter) || p.shutter < 0 || p.shutter > 1 { return FilmRefusal.shutter; }
  if p.position < FILM_SHUTTER_START || p.position > FILM_SHUTTER_END { return FilmRefusal.position; }
  if width < 1 || height < 1 || width > FILM_MAX_SIDE || height > FILM_MAX_SIDE { return FilmRefusal.size; }
  if targets < 1 || targets > 8 { return FilmRefusal.targets; }
  if p.transport != FILM_RASTER && p.transport != FILM_TRACED { return FilmRefusal.transport; }
  if film_bytes(width, height, targets) > p.budget.memory_bytes { return FilmRefusal.memory; }
  if draws < 0 || draws > p.budget.draws { return FilmRefusal.draws; }
  return FilmRefusal.ok;
}
// The bytes a film frame holds: the f32 RGBA accumulation and a half-float sample, each target.
film_bytes :: (width: int, height: int, targets: int) -> int { return width * height * targets * (16 + 8); }

// After the first sample is measured: whether a frame's samples fit its seconds.
film_admit_time :: (p: FilmProfile, sample_seconds: f64) -> FilmRefusal {
  if !(sample_seconds >= 0) || sample_seconds > 1000000 { return FilmRefusal.seconds; }
  if sample_seconds * cast(f64) p.samples > p.budget.seconds_per_frame { return FilmRefusal.seconds; }
  return FilmRefusal.ok;
}

// ---- the samples

// Sample s of a frame: when, where in the pixel, and where on the aperture.
FilmSample :: struct {
  time: f32;          // frames from the frame's time: in [-shutter, shutter]
  jx: f32; jy: f32;   // pixels from the pixel's centre: in [-0.5, 0.5)
  lu: f32; lv: f32;   // the point on the unit aperture disk
}

film_counter :: (frame: int, s: int) -> int { return frame * FILM_MAX_SAMPLES + s; }

// A Fisher-Yates shuffle of 0..n-1 from one stream: the order the strata of an axis pair with
// sample numbers (a Latin square), so x and y strata pair differently each frame.
film_shuffle :: (seed: int, stream: int, frame: int, n: int, order: [] int) {
  for i: 0..<n { order[i] = i; }
  i := n - 1;
  while i > 0 {
    j := rand_below(seed, stream, film_counter(frame, i), i + 1);
    t := order[i]; order[i] = order[j]; order[j] = t;
    i -= 1;
  }
}

// A number in [0, 1) for sample s on one axis: stratified, a random place inside the given
// stratum of n equal ones; independent, any place.
film_axis :: (p: FilmProfile, stream: int, frame: int, stratum: int, s: int) -> f32 {
  u := rand_unit(p.seed, stream, film_counter(frame, s));
  if !p.stratified { return u; }
  return (cast(f32) stratum + u) / cast(f32) p.samples;
}

// Shirley and Chiu's concentric map: the unit square onto the unit disk, keeping strata whole.
film_disk :: (a: f32, b: f32) -> [2] f32 {
  x := 2 * a - 1; y := 2 * b - 1;
  if x == 0 && y == 0 { return [2] f32.[0, 0]; }
  quarter := 0.78539816339744831f32;   // pi / 4
  if abs(x) > abs(y) {
    t := quarter * (y / x);
    return [2] f32.[x * cos(t), x * sin(t)];
  }
  t := 2 * quarter - quarter * (x / y);
  return [2] f32.[y * cos(t), y * sin(t)];
}

// Sample s's time, in frames from the frame's: time strata in order, so a frame's samples run
// forward in time.
film_sample_time :: (p: FilmProfile, frame: int, s: int) -> f32 {
  if p.samples < 1 || s < 0 || s >= p.samples { return 0; }
  open := film_axis(p, FILM_STREAM_TIME, frame, s, s);
  start := ifx p.position == FILM_SHUTTER_START then 0.0f32 else ifx p.position == FILM_SHUTTER_END then -p.shutter else -0.5f32 * p.shutter;
  return start + p.shutter * open;
}

// All of a frame's samples, in order: what a host draws them from. Returns how many.
film_samples :: (p: FilmProfile, frame: int, out: [] FilmSample) -> int {
  n := p.samples;
  if n < 1 || n > FILM_MAX_SAMPLES || out.count < n { return 0; }
  xs: [FILM_MAX_SAMPLES] int; ys: [FILM_MAX_SAMPLES] int; us: [FILM_MAX_SAMPLES] int; vs: [FILM_MAX_SAMPLES] int;
  film_shuffle(p.seed, FILM_STREAM_ROWS + 8, frame, n, xs[..]); film_shuffle(p.seed, FILM_STREAM_ROWS, frame, n, ys[..]);
  film_shuffle(p.seed, FILM_STREAM_LENS_ROWS + 8, frame, n, us[..]); film_shuffle(p.seed, FILM_STREAM_LENS_ROWS, frame, n, vs[..]);
  for s: 0..<n {
    q: FilmSample;
    q.time = film_sample_time(p, frame, s);
    if p.jitter {
      q.jx = film_axis(p, FILM_STREAM_JITTER_X, frame, xs[s], s) - 0.5;
      q.jy = film_axis(p, FILM_STREAM_JITTER_Y, frame, ys[s], s) - 0.5;
    }
    disk := film_disk(film_axis(p, FILM_STREAM_LENS_U, frame, us[s], s), film_axis(p, FILM_STREAM_LENS_V, frame, vs[s], s));
    q.lu = disk[0]; q.lv = disk[1];
    out[s] = q;
  }
  return n;
}
film_sample :: (p: FilmProfile, frame: int, s: int) -> FilmSample {
  all: [FILM_MAX_SAMPLES] FilmSample;
  if s < 0 || film_samples(p, frame, all[..]) <= s { out: FilmSample; return out; }
  return all[s];
}

// ---- the clock

// The nanosecond a frame's time is at: frame / fps of a second, rounded down.
film_frame_ns :: (frame: int, fps: int) -> int {
  if fps < 1 || frame < 0 { return 0; }
  return (frame * FILM_SECOND_NS) / fps;
}
// The nanosecond sample s of frame `frame` is drawn at. Never before 0, and never before an
// earlier sample of the same frame, so the host only ever advances the realm.
film_sample_ns :: (p: FilmProfile, frame: int, fps: int, s: int) -> int {
  base := film_frame_ns(frame, fps);
  if fps < 1 { return base; }
  length := film_frame_ns(frame + 1, fps) - base;
  t := base + cast(int) floor(cast(f64) film_sample_time(p, frame, s) * cast(f64) length);
  if t < 0 { return 0; }
  return t;
}

// ---- the camera

// The terms of a projection for one sample: NDC per view unit at unit depth (sx, sy), the
// principal point's shift in NDC (cx, cy: the camera's shift, the pixel jitter and the lens),
// the eye's offset on the aperture in view units (ex, ey: along the view's right and up), and the
// clip range. A realm builds its matrix as it does now, with these in place of its own.
FilmView :: struct { sx: f32; sy: f32; cx: f32; cy: f32; ex: f32; ey: f32; near: f32; far: f32; }

// The sensor size the lens fills along the frame's width and height (Blender's sensor fit: AUTO
// fits the larger side of the image to sensor_width).
film_sensor :: (c: CameraLens, width: f32, height: f32) -> [2] f32 {
  fit := c.sensor_fit;
  if fit == LENS_FIT_AUTO { fit = ifx width >= height then LENS_FIT_HORIZONTAL else LENS_FIT_VERTICAL; }
  if fit == LENS_FIT_HORIZONTAL { return [2] f32.[c.sensor_width, c.sensor_width * height / width]; }
  // AUTO fits the larger side, here the height, to sensor_width; VERTICAL fits it to sensor_height
  h := ifx c.sensor_fit == LENS_FIT_AUTO then c.sensor_width else c.sensor_height;
  return [2] f32.[h * width / height, h];
}

// The aperture's radius in metres: the focal length over twice the f-stop.
film_aperture :: (c: CameraLens) -> f32 {
  if !c.use_dof || !(c.aperture_fstop > 0) { return 0; }
  return (c.lens / 1000) / (2 * c.aperture_fstop);
}

film_view :: (c: CameraLens, width: f32, height: f32, s: FilmSample) -> FilmView {
  v: FilmView;
  sensor := film_sensor(c, width, height);
  v.sx = 2 * c.lens / sensor[0];
  v.sy = 2 * c.lens / sensor[1];
  // Blender's shift is a fraction of the larger sensor side, in image space
  larger := ifx sensor[0] >= sensor[1] then sensor[0] else sensor[1];
  v.cx = 2 * c.shift_x * larger / sensor[0] + 2 * s.jx / width;
  v.cy = 2 * c.shift_y * larger / sensor[1] + 2 * s.jy / height;
  r := film_aperture(c);
  focus := ifx c.focus_distance > c.clip_start then c.focus_distance else c.clip_start;
  if r > 0 {
    v.ex = r * s.lu; v.ey = r * s.lv;
    // moving the eye by e keeps the focus plane still when the image shifts by e/focus with it
    v.cx += v.sx * v.ex / focus;
    v.cy += v.sy * v.ey / focus;
  }
  v.near = c.clip_start; v.far = c.clip_end;
  return v;
}

// Where a point in view space (x right, y up, z forward, metres) lands in NDC under a sample's
// view: the eye moved by (ex, ey), then the perspective divide and the shift.
film_project :: (v: FilmView, x: f32, y: f32, z: f32) -> [2] f32 {
  if !(z > 0) { return [2] f32.[0, 0]; }
  return [2] f32.[v.sx * (x - v.ex) / z + v.cx, v.sy * (y - v.ey) / z + v.cy];
}

// The thin lens's circle of confusion: its diameter in pixels across the image's width, for a
// point at `depth` metres with the lens focused at focus_distance.
film_coc_px :: (c: CameraLens, width: f32, height: f32, depth: f32) -> f32 {
  if !c.use_dof || !(depth > 0) { return 0; }
  f := c.lens / 1000; s := c.focus_distance; a := f / c.aperture_fstop;
  if !(s > f) { return 0; }
  coc := a * f * abs(depth - s) / (depth * (s - f));   // metres on the sensor
  // the projection above has image distance f (the pinhole model); the thin lens's is s f/(s - f)
  coc = coc * (s - f) / s;
  return coc * 1000 / film_sensor(c, width, height)[0] * width;
}

// ---- a realm's own matrix

// A sample applied to a realm's view-projection matrix m (16 floats by rows: clip x is
// m[0] x + m[1] y + m[2] z + m[3], and clip w is the fourth row, the distance ahead of the eye
// times its length), so a realm keeps building its camera as it does and the host moves only the
// sample: the pixel jitter (pixels), and, with an f-stop, the eye on the aperture with the image
// shifted so the plane `focus` metres ahead stays still. The lens's focal length is the one the
// matrix's field of view gives on the 36 mm sensor, so the aperture is (36 sx / 2) / fstop mm.
// Returns false, changing nothing, for a matrix with no perspective.
film_matrix :: (m: [] f32, width: f32, height: f32, q: FilmSample, fstop: f32, focus: f32) -> bool {
  if m.count < 16 || !(width > 0) || !(height > 0) { return false; }
  // the forward axis and how long the fourth row's is
  fx := m[12]; fy := m[13]; fz := m[14];
  reach := sqrt(fx * fx + fy * fy + fz * fz);
  if !(reach > 0.000001) { return false; }
  fx /= reach; fy /= reach; fz /= reach;
  // the first two rows across the forward axis: NDC per metre at one metre ahead, and the
  // world's right and up
  ax := m[0]; ay := m[1]; az := m[2]; along := ax * fx + ay * fy + az * fz;
  rx := ax - along * fx; ry := ay - along * fy; rz := az - along * fz;
  bx := m[4]; by := m[5]; bz := m[6]; above := bx * fx + by * fy + bz * fz;
  ux := bx - above * fx; uy := by - above * fy; uz := bz - above * fz;
  sx := sqrt(rx * rx + ry * ry + rz * rz) / reach; sy := sqrt(ux * ux + uy * uy + uz * uz) / reach;
  if !(sx > 0) || !(sy > 0) { return false; }
  kx := 2 * q.jx / width; ky := 2 * q.jy / height;
  if fstop > 0 && focus > 0 {
    // the aperture's radius in metres: half of (focal length / f-stop)
    r := 0.036 * sx / 2 / fstop / 2;
    ex := r * q.lu; ey := r * q.lv;
    // the eye moves by e along right and up: every column's point is seen from there
    wx := ex * rx / (sx * reach) + ey * ux / (sy * reach);
    wy := ex * ry / (sx * reach) + ey * uy / (sy * reach);
    wz := ex * rz / (sx * reach) + ey * uz / (sy * reach);
    for row: 0..<4 { m[row * 4 + 3] -= m[row * 4] * wx + m[row * 4 + 1] * wy + m[row * 4 + 2] * wz; }
    kx += sx * ex / focus; ky += sy * ey / focus;
  }
  for c: 0..<4 { m[c] += kx * m[12 + c]; m[4 + c] += ky * m[12 + c]; }
  return true;
}
film_host_matrix :: (m: [] f32, width: f32, height: f32, jx: f32, jy: f32, lu: f32, lv: f32, fstop: f32, focus: f32) -> bool #export_c #effects(all) {
  return film_matrix(m, width, height, FilmSample.{jx = jx, jy = jy, lu = lu, lv = lv}, fstop, focus);
}

// ---- accumulation

// Add a sample (RGBA16F's values as f32) into the f32 accumulation, and divide at the end. Post
// (bloom, shafts, tone) runs once, on the resolved image.
film_add :: (acc: [] f32, sample: [] f32) -> bool {
  if acc.count != sample.count { return false; }
  for i: 0..<acc.count { acc[i] += sample[i]; }
  return true;
}
film_resolve :: (acc: [] f32, samples: int, out: [] f32) -> bool {
  if acc.count != out.count || samples < 1 { return false; }
  k := 1.0f32 / cast(f32) samples;
  for i: 0..<acc.count { out[i] = acc[i] * k; }
  return true;
}

// ---- C entry points for the native hosts (verse/gpu/vk-realm.c, the Metal host)

film_c_profile :: (samples: s32, shutter: f32, position: s32, seed: s64, jitter: bool) -> FilmProfile {
  p: FilmProfile;
  p.samples = cast(int) samples; p.shutter = shutter; p.position = cast(int) position; p.seed = cast(int) seed; p.jitter = jitter;
  return p;
}
// 0 when a host may render frames of this size with these samples; else the refusal's number.
film_host_admit :: (samples: s32, shutter: f32, position: s32, width: s32, height: s32, targets: s32) -> s32 #export_c #effects(all) {
  p := film_c_profile(samples, shutter, position, 0, true);
  return cast(s32) film_admit(p, cast(int) width, cast(int) height, cast(int) targets, 0);
}
// The nanosecond sample s of a frame is drawn at.
film_host_sample_ns :: (samples: s32, shutter: f32, position: s32, seed: s64, frame: s64, fps: s32, s: s32) -> s64 #export_c #effects(all) {
  p := film_c_profile(samples, shutter, position, seed, true);
  return cast(s64) film_sample_ns(p, cast(int) frame, cast(int) fps, cast(int) s);
}
// The sample's pixel jitter, x then y (which 0 or 1), in pixels.
film_host_jitter :: (samples: s32, shutter: f32, position: s32, seed: s64, frame: s64, s: s32, which: s32) -> f32 #export_c #effects(all) {
  p := film_c_profile(samples, shutter, position, seed, samples > 1);
  q := film_sample(p, cast(int) frame, cast(int) s);
  return ifx which == 0 then q.jx else q.jy;
}
// The sample's point on the unit aperture disk, u then v (which 0 or 1).
film_host_lens :: (samples: s32, shutter: f32, position: s32, seed: s64, frame: s64, s: s32, which: s32) -> f32 #export_c #effects(all) {
  p := film_c_profile(samples, shutter, position, seed, true);
  q := film_sample(p, cast(int) frame, cast(int) s);
  return ifx which == 0 then q.lu else q.lv;
}

// ---- checks

film_near :: (a: f32, b: f32, e: f32) -> bool { return abs(a - b) <= e; }

#test "the live profile is one centred sample with the shutter shut, and admits" {
  p := film_live();
  #assert p.samples == 1 && p.shutter == 0 && !p.jitter && p.detail.far == 0 && !p.detail.full_mips;
  q := film_sample(p, 7, 0);
  #assert q.time == 0 && q.jx == 0 && q.jy == 0;
  #assert film_admit(p, 1920, 1080, 1, 200) == FilmRefusal.ok;
  for f: 0..<48 { #assert film_sample_ns(p, f, 24, 0) == film_frame_ns(f, 24); }
}

#test "a profile refuses what it cannot render, before the first frame" {
  p: FilmProfile;
  #assert film_admit(p, 1920, 1080, 1, 100) == FilmRefusal.ok;
  q := p; q.samples = 0; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.samples;
  q = p; q.samples = FILM_MAX_SAMPLES + 1; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.samples;
  q = p; q.samples = FILM_MAX_SAMPLES; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.ok;
  q = p; q.shutter = 1.5; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.shutter;
  q = p; q.shutter = -0.1; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.shutter;
  q = p; q.shutter = f32(0.0 / 0.0); #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.shutter;
  q = p; q.shutter = 1; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.ok;
  q = p; q.position = 3; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.position;
  q = p; q.position = -1; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.position;
  #assert film_admit(p, 0, 1080, 1, 100) == FilmRefusal.size && film_admit(p, 1920, 8193, 1, 100) == FilmRefusal.size;
  #assert film_admit(p, 1920, 1080, 0, 100) == FilmRefusal.targets && film_admit(p, 1920, 1080, 9, 100) == FilmRefusal.targets;
  q = p; q.transport = 2; #assert film_admit(q, 1920, 1080, 1, 100) == FilmRefusal.transport;
  // 8192 x 8192 x 8 targets is 12 GiB, over the 4 GiB default
  #assert film_bytes(1920, 1080, 1) == 49766400 && film_admit(p, 8192, 8192, 8, 100) == FilmRefusal.memory;
  q = p; q.budget.memory_bytes = film_bytes(1920, 1080, 2); #assert film_admit(q, 1920, 1080, 2, 100) == FilmRefusal.ok && film_admit(q, 1920, 1081, 2, 100) == FilmRefusal.memory;
  #assert film_admit(p, 1920, 1080, 1, 65537) == FilmRefusal.draws && film_admit(p, 1920, 1080, 1, -1) == FilmRefusal.draws;
  q = p; q.samples = 16; q.budget.seconds_per_frame = 8;
  #assert film_admit_time(q, 0.5) == FilmRefusal.ok && film_admit_time(q, 0.51) == FilmRefusal.seconds;
  #assert film_admit_time(q, -1) == FilmRefusal.seconds && film_admit_time(q, cast(f64) (0.0 / 0.0)) == FilmRefusal.seconds;
  #assert film_host_admit(16, 0.5, 1, 1920, 1080, 1) == 0 && film_host_admit(0, 0.5, 1, 1920, 1080, 1) == cast(s32) FilmRefusal.samples;
}

#test "samples are the same every time, and each stream is its own" {
  p: FilmProfile; p.samples = 16; p.shutter = 0.5; p.seed = 2026;
  a := film_sample(p, 30, 5); b := film_sample(p, 30, 5);
  #assert a.time == b.time && a.jx == b.jx && a.jy == b.jy && a.lu == b.lu && a.lv == b.lv;
  c := film_sample(p, 31, 5);
  #assert c.jx != a.jx || c.jy != a.jy;
  q := p; q.seed = 2027; d := film_sample(q, 30, 5);
  #assert d.jx != a.jx && d.lu != a.lu;
  // out of range: nothing
  e := film_sample(p, 30, 16);
  #assert e.time == 0 && e.jx == 0 && e.lu == 0;
  #assert film_host_jitter(16, 0.5, 1, 2026, 30, 5, 0) == a.jx && film_host_jitter(16, 0.5, 1, 2026, 30, 5, 1) == a.jy;
  #assert film_host_lens(16, 0.5, 1, 2026, 30, 5, 0) == a.lu && film_host_lens(16, 0.5, 1, 2026, 30, 5, 1) == a.lv;
}

#forall "stratified samples fill every stratum of each axis once" frame: 0..<12 {
  p: FilmProfile; p.samples = 16; p.shutter = 1; p.position = FILM_SHUTTER_START; p.seed = frame * 3;
  xs: [16] int; ys: [16] int; ts: [16] int;
  last := -1.0f32;
  for s: 0..<16 {
    q := film_sample(p, frame, s);
    #assert q.jx >= -0.5 && q.jx < 0.5 && q.jy >= -0.5 && q.jy < 0.5 && q.time >= 0 && q.time < 1;
    #assert q.lu * q.lu + q.lv * q.lv <= 1.0001;
    xs[cast(int) floor((q.jx + 0.5) * 16)] += 1; ys[cast(int) floor((q.jy + 0.5) * 16)] += 1; ts[cast(int) floor(q.time * 16)] += 1;
    #assert q.time > last;   // forward in time
    last = q.time;
  }
  for k: 0..<16 { #assert xs[k] == 1 && ys[k] == 1 && ts[k] == 1; }
}

#test "the shutter's position puts its samples after, around or before the frame's time" {
  p: FilmProfile; p.samples = 8; p.shutter = 0.5;
  for s: 0..<8 {
    p.position = FILM_SHUTTER_START; a := film_sample(p, 3, s).time;
    p.position = FILM_SHUTTER_CENTER; b := film_sample(p, 3, s).time;
    p.position = FILM_SHUTTER_END; c := film_sample(p, 3, s).time;
    #assert a >= 0 && a < 0.5 && b >= -0.25 && b < 0.25 && c >= -0.5 && c < 0;
    #assert film_near(a - b, 0.25, 0.000001) && film_near(b - c, 0.25, 0.000001);
  }
  // the first frame never draws before the clock's start
  p.position = FILM_SHUTTER_END;
  for s: 0..<8 { #assert film_sample_ns(p, 0, 24, s) == 0; }
  #assert film_frame_ns(1, 24) == 41666666 && film_frame_ns(24, 24) == FILM_SECOND_NS && film_frame_ns(3, 0) == 0 && film_frame_ns(-1, 24) == 0;
}

#test "the concentric map keeps the square's area: the disk's rings fill as r squared" {
  // a 64 x 64 grid of cell centres: the share inside radius r is r^2, within a cell's worth
  for k: 1..<5 {
    r := cast(f32) k / 4;
    inside := 0;
    for i: 0..<64 { for j: 0..<64 {
      d := film_disk((cast(f32) i + 0.5) / 64, (cast(f32) j + 0.5) / 64);
      if d[0] * d[0] + d[1] * d[1] <= r * r { inside += 1; }
    } }
    #assert film_near(cast(f32) inside / 4096, r * r, 0.04);
  }
  c := film_disk(0.5, 0.5); #assert c[0] == 0 && c[1] == 0;
  e := film_disk(1, 0.5); #assert film_near(e[0], 1, 0.000001) && film_near(e[1], 0, 0.000001);
  n := film_disk(0.5, 1); #assert film_near(n[0], 0, 0.000001) && film_near(n[1], 1, 0.000001);
}

// A host advances the realm by each sample's gap. aethyr/core/loop.coax's clock then runs the same
// fixed steps by each frame's end as it does with one sample a frame, so the film profile changes
// no simulation digest (aethyr/core/replay.coax records one a step).
#test "sampling a frame many times runs the same fixed steps as one sample a frame" {
  p: FilmProfile; p.samples = 16; p.shutter = 0.5; p.position = FILM_SHUTTER_CENTER; p.seed = 9;
  one: FrameClock; film: FrameClock;
  at := 0;    // the nanosecond the film clock has reached
  was := 0;   // and the one-sample clock
  for f: 0..<240 {
    for s: 0..<16 {
      t := film_sample_ns(p, f, 24, s);
      #assert t >= at;
      film = loop_ran(loop_accept_ns(film, t - at)); at = t;
    }
    // the same time in one frame: the same steps, and the same part of a step left over
    one = loop_ran(loop_accept_ns(one, at - was)); was = at;
    #assert film.ticks == one.ticks && film.carry_ns == one.carry_ns && film.stalls == 0;
  }
  #assert one.ticks > 600;
}

// ---- the F1 oracles (#13004): motion blur, depth of field and convergence, on the CPU

// A bar W pixels wide moving V pixels a frame over a row, the shutter open a whole frame: the
// exact image is its coverage of each pixel averaged over the shutter, which this integrates with
// the overlap of two intervals over 4,096 times. The film draws the bar at each sample's time and
// pixel offset and averages; it must match that profile everywhere, edges included.
film_bar_exact :: (x: int, left: f32, width: f32, speed: f32) -> f32 {
  sum := 0.0f32;
  for k: 0..<4096 {
    t := (cast(f32) k + 0.5) / 4096;
    a := left + speed * t; b := a + width;
    lo := ifx a > cast(f32) x then a else cast(f32) x;
    hi := ifx b < cast(f32) (x + 1) then b else cast(f32) (x + 1);
    if hi > lo { sum += hi - lo; }
  }
  return sum / 4096;
}

#test "motion blur: a moving bar's film image is its exact shutter-averaged profile" {
  p: FilmProfile; p.samples = 64; p.shutter = 1; p.position = FILM_SHUTTER_START; p.seed = 13004;
  all: [FILM_MAX_SAMPLES] FilmSample;
  #assert film_samples(p, 5, all[..]) == 64;
  worst := 0.0f32; blurred := 0;
  for x: 0..<32 {
    sum := 0.0f32;
    for s: 0..<64 {
      // the pixel's sample point, and the bar where it is at the sample's time
      at := cast(f32) x + 0.5 + all[s].jx;
      a := 6 + 9 * all[s].time;
      if at >= a && at < a + 8 { sum += 1; }
    }
    film := sum / 64; exact := film_bar_exact(x, 6, 8, 9);
    d := abs(film - exact);
    worst = ifx d > worst then d else worst;
    if exact > 0.05 && exact < 0.95 { blurred += 1; }
  }
  // 9 pixels of travel blur 18 pixels of edge; every pixel within 1/16 of the exact profile
  #assert worst <= 0.0625 && blurred >= 14;
  // with the shutter shut the bar is sharp: covered or not, at its place at the frame's time
  q := p; q.shutter = 0;
  #assert film_samples(q, 5, all[..]) == 64;
  for x: 0..<32 {
    sum := 0.0f32;
    for s: 0..<64 { at := cast(f32) x + 0.5 + all[s].jx; if at >= 6 && at < 14 { sum += 1; } }
    #assert film_near(sum / 64, film_bar_exact(x, 6, 8, 0), 0.0625);
  }
}

// The thin lens: a point off the focus plane spreads into a disk of diameter A f |d - s| /
// (d (s - f)) on the sensor. The film keeps the live pinhole's image distance f, not the thin
// lens's s f / (s - f), so its disk is that times (s - f) / s: what film_coc_px says. The rim
// of the aperture gives the disk's rim; its diameter must match at every focus distance.
#test "depth of field: the aperture's rim draws the thin lens's circle of confusion" {
  c: CameraLens; c.lens = 50; c.use_dof = true; c.aperture_fstop = 2;
  width := 1920.0f32; height := 1080.0f32;
  for focus: [3] f32.[2, 5, 20] {
    c.focus_distance = focus;
    for depth: [4] f32.[1, 3, 8, 40] {
      lo := 1000000.0f32; hi := -1000000.0f32;
      for k: 0..<360 {
        q: FilmSample;
        angle := cast(f32) k * 0.017453292519943295f32;
        q.lu = cos(angle); q.lv = sin(angle);
        v := film_view(c, width, height, q);
        px := film_project(v, 0, 0, depth)[0] * width / 2;
        lo = ifx px < lo then px else lo; hi = ifx px > hi then px else hi;
      }
      f := c.lens / 1000; a := f / c.aperture_fstop;
      oracle := a * f * abs(depth - focus) / (depth * (focus - f)) * (focus - f) / focus * 1000 / 36 * width;
      #assert film_near(hi - lo, oracle, 0.001 * oracle + 0.0005) && film_near(film_coc_px(c, width, height, depth), oracle, 0.0001 * oracle + 0.0001);
    }
    // in the focus plane the rim draws one point
    q: FilmSample; q.lu = 1;
    v := film_view(c, width, height, q);
    #assert film_near(film_project(v, 0.3, -0.2, focus)[0], film_project(film_view(c, width, height, FilmSample.{}), 0.3, -0.2, focus)[0], 0.000001);
  }
  // no depth of field: the aperture is a pinhole
  c.use_dof = false;
  #assert film_aperture(c) == 0 && film_coc_px(c, width, height, 3) == 0;
  c.use_dof = true; c.aperture_fstop = 0;
  #assert film_aperture(c) == 0;
  c.aperture_fstop = 2.8; #assert film_near(film_aperture(c), 0.05 / 5.6, 0.0000001);
}

#test "the lens's field of view, sensor fit and shift follow Blender's camera" {
  c: CameraLens;
  v := film_view(c, 1920, 1080, FilmSample.{});
  // AUTO on a wide image: the width spans the 36 mm sensor
  #assert film_near(v.sx, 100.0 / 36, 0.000001) && film_near(v.sy, v.sx * 1920 / 1080, 0.0001) && v.cx == 0 && v.cy == 0;
  tall := film_view(c, 1080, 1920, FilmSample.{});
  #assert film_near(tall.sy, 100.0 / 36, 0.000001);
  c.sensor_fit = LENS_FIT_VERTICAL;
  #assert film_near(film_view(c, 1920, 1080, FilmSample.{}).sy, 100.0 / 24, 0.000001);
  c.sensor_fit = LENS_FIT_AUTO; c.shift_x = 0.1;
  // a shift of 0.1 moves the principal point a tenth of the larger side: 0.2 in NDC
  #assert film_near(film_view(c, 1920, 1080, FilmSample.{}).cx, 0.2, 0.000001);
  // a jitter of half a pixel moves it half of a pixel's NDC width (2 / 1920)
  c.shift_x = 0;
  #assert film_near(film_view(c, 1920, 1080, FilmSample.{jx = 0.5}).cx, 1.0 / 1920, 0.0000001);
  #assert film_project(v, 1, 1, 0)[0] == 0 && film_project(v, 1, 1, -2)[0] == 0;
  #assert v.near == 0.1f32 && v.far == 1000;
}

// One pixel across an edge, its value the share of its samples on the bright side: the mean of
// N samples over 256 frames. Independent samples' variance falls as 1/N; stratified ones' falls
// at least that fast.
film_edge_variance :: (n: int, stratified: bool) -> f64 {
  p: FilmProfile; p.samples = n; p.stratified = stratified; p.seed = 77;
  all: [FILM_MAX_SAMPLES] FilmSample;
  sum := 0.0; squares := 0.0;
  for f: 0..<256 {
    if film_samples(p, f, all[..]) != n { return -1; }
    hit := 0;
    for s: 0..<n { if all[s].jx + 0.3 * all[s].jy > 0.1 { hit += 1; } }
    m := cast(f64) hit / cast(f64) n;
    sum += m; squares += m * m;
  }
  mean := sum / 256;
  return squares / 256 - mean * mean;
}
#test "convergence: a pixel's variance falls as 1/N" #steps 200000000 {
  one := film_edge_variance(1, false); four := film_edge_variance(4, false); sixteen := film_edge_variance(16, false);
  // the edge covers about 0.41 of the pixel, so one sample's variance is about 0.24
  #assert one > 0.2 && one < 0.28;
  #assert one / four > 3 && one / four < 5.3 && four / sixteen > 3 && four / sixteen < 5.3;
  #assert film_edge_variance(16, true) < sixteen && film_edge_variance(4, true) < four;
}

#test "accumulation adds samples and divides once" {
  acc: [4] f32; one := [4] f32.[1, 2, 3, 4]; two := [4] f32.[3, 2, 1, 0]; out: [4] f32;
  #assert film_add(acc[..], one[..]) && film_add(acc[..], two[..]) && film_resolve(acc[..], 2, out[..]);
  #assert out[0] == 2 && out[1] == 2 && out[2] == 2 && out[3] == 2;
  short: [3] f32;
  #assert !film_add(acc[..], short[..]) && !film_resolve(acc[..], 0, out[..]) && !film_resolve(acc[..], 2, short[..]);
}

// A look-at camera's matrix as a realm builds one: perspective with sx, sy over a view whose
// eye is at (ex, ey, ez) looking along +Z, right +X, up +Y.
film_test_matrix :: (sx: f32, sy: f32, ex: f32, ey: f32, ez: f32) -> [16] f32 {
  return [16] f32.[sx, 0, 0, -sx * ex, 0, sy, 0, -sy * ey, 0, 0, 1, -ez - 0.1, 0, 0, 1, -ez];
}
film_test_ndc :: (m: [] f32, x: f32, y: f32, z: f32) -> [2] f32 {
  w := m[12] * x + m[13] * y + m[14] * z + m[15];
  return [2] f32.[(m[0] * x + m[1] * y + m[2] * z + m[3]) / w, (m[4] * x + m[5] * y + m[6] * z + m[7]) / w];
}

#test "a sample on a realm's matrix: jitter moves the image, the lens keeps the focus plane still" {
  sx := 2.7777777f32; sy := sx * 16 / 9;
  base := film_test_matrix(sx, sy, 1, 2, 3);
  m := base;
  #assert film_matrix(m[..], 1920, 1080, FilmSample.{jx = 0.25, jy = -0.5}, 0, 0);
  a := film_test_ndc(base[..], 1.5, 2.2, 9); b := film_test_ndc(m[..], 1.5, 2.2, 9);
  #assert film_near(b[0] - a[0], 0.5 / 1920, 0.0000001) && film_near(b[1] - a[1], -1.0 / 1080, 0.0000001);
  // the lens: f/2 with focus 6 m ahead of the eye (z = 9)
  c: CameraLens; c.use_dof = true; c.aperture_fstop = 2; c.focus_distance = 6; c.lens = 18 * sx;
  for k: 0..<8 {
    angle := cast(f32) k * 0.7853982f32;
    q := FilmSample.{lu = cos(angle), lv = sin(angle)};
    n := base;
    #assert film_matrix(n[..], 1920, 1080, q, 2, 6);
    // a point on the focus plane does not move
    on := film_test_ndc(n[..], 1.7, 1.6, 9); was := film_test_ndc(base[..], 1.7, 1.6, 9);
    #assert film_near(on[0], was[0], 0.000002) && film_near(on[1], was[1], 0.000002);
    // a point 3 m ahead (z = 6) moves as film_view's lens moves it
    v := film_view(c, 1920, 1080, q);
    want := film_project(v, 1.7 - 1, 1.6 - 2, 3);
    got := film_test_ndc(n[..], 1.7, 1.6, 6);
    #assert film_near(got[0], want[0], 0.00001) && film_near(got[1], want[1], 0.00001);
  }
  flat: [16] f32;
  #assert !film_matrix(flat[..], 1920, 1080, FilmSample.{}, 0, 0) && !film_matrix(m[0..<8], 1920, 1080, FilmSample.{}, 0, 0) && !film_matrix(m[..], 0, 1080, FilmSample.{}, 0, 0);
}
