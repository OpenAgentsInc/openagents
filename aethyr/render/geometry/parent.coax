// Supported class: one convex, horizontal-boundary triangle fan, in any
// source triangle order. Boundary edges are extracted and retained exactly.
#load "../../points.coax";
#authority;
PARENT_VERTICES :: 256;
PARENT_INDICES :: 768;
ParentMesh :: struct {p:[PARENT_VERTICES]Point;i:[PARENT_INDICES]u32;vertices:int;indices:int;error:f32;}

#test "topology reduction retains an irregular boundary and composes errors upward" {
  p:=[7]Point.[v3(-2,0,-1),v3(-1,0,-2),v3(1,0,-2),v3(2,0,-1),v3(2,0,1),v3(-2,0,1),v3(0,0.75,0)];
  i:[18]u32;for k:0..<6 {i[k*3]=cast(u32)k;i[k*3+1]=6;i[k*3+2]=cast(u32)((k+1)%6);}m:[1]ParentMesh;
  #assert parent_reduce(m[..],p[..],i[..],0.25) && m[0].vertices==6 && m[0].indices==12 && m[0].error==1;
  #assert m[0].p[0].x== -2 && m[0].p[1].z==1 && m[0].p[5].z== -2;
  for k:0..<6 {a:=m[0].p[k];b:=m[0].p[(k+1)%6];seen:=false;
    for t:0..<6 {x:=p[cast(int)i[t*3+2]];y:=p[cast(int)i[t*3]];if a.x==x.x && a.z==x.z && b.x==y.x && b.z==y.z {seen=true;}}
    #assert seen && a.y==0;
  }
  for k:0..<4 {#assert m[0].i[k*3]==0 && m[0].i[k*3+1]==cast(u32)(k+1) && m[0].i[k*3+2]==cast(u32)(k+2);}
  reversed:=i;for t:0..<6 {for k:0..<3 {reversed[t*3+k]=i[(5-t)*3+k];}}
  n:[1]ParentMesh;#assert parent_reduce(n[..],p[..],reversed[..],0.25);
  for k:0..<6 {#assert n[0].p[k].x==m[0].p[k].x && n[0].p[k].z==m[0].p[k].z;}
  p[6].y=0;#assert parent_reduce(n[..],p[..],i[..],0) && n[0].error==0;
  p[6].y= -0.5;#assert parent_reduce(n[..],p[..],i[..],0.25) && n[0].error==0.75;
}
#test "unsupported and malformed patches never replace a previously published parent" {
  p:=[5]Point.[v3(-1,0,-1),v3(1,0,-1),v3(1,0,1),v3(-1,0,1),v3(0,1,0)];i:=[12]u32.[0,4,1,1,4,2,2,4,3,3,4,0];m:[1]ParentMesh;
  #assert parent_reduce(m[..],p[..],i[..],0);
  #assert !parent_reduce(m[..],p[0..<3],i[..],0) && !parent_reduce(m[..],p[..],i[0..<9],0);
  #assert !parent_reduce(m[..],p[..],i[..],-1) && !parent_reduce(m[..],p[..],i[..],1000000);
  for k:0..<12 {bad:=i;bad[k]=5;#assert !parent_reduce(m[..],p[..],bad[..],0);}
  bad:=i;bad[9]=2;bad[11]=3;#assert !parent_reduce(m[..],p[..],bad[..],0);
  p[1].y=0.1;#assert !parent_reduce(m[..],p[..],i[..],0);p[1].y=0;
  p[4].x=2;#assert !parent_reduce(m[..],p[..],i[..],0);p[4].x=0;
  p[2].x= -0.5;p[2].z= -0.5;#assert !parent_reduce(m[..],p[..],i[..],0);
  p[2]=v3(1,0,1);p[0].z=1000000;#assert !parent_reduce(m[..],p[..],i[..],0);
  #assert m[0].vertices==4 && m[0].indices==6 && m[0].error==1;
  huge:[257]Point;#assert !parent_reduce(m[..],huge[..],i[..],0);
}
#test "positive error rounding encloses the f64 geometric sum" {
  #assert parent_error(0,0,0)==0 && parent_error(1,0,0.5)==1.5;
  value:=parent_error(0.1,0,0.000000001);#assert cast(f64)value>=cast(f64)0.1f32+cast(f64)0.000000001f32;
}

#test "topology reduction supports renumbering cyclic corners and a nonzero plane" {
  p:=[4]Point.[v3(0,2.75,0),v3(-2,2,-1),v3(2,2,-1),v3(0,2,2)];i:=[9]u32.[0,2,1,3,2,0,1,3,0];m:[1]ParentMesh;
  #assert parent_reduce(m[..],p[..],i[..],0) && m[0].vertices==3 && m[0].indices==3 && m[0].error==0.75;
  #assert m[0].p[0].x== -2 && m[0].p[1].z==2 && m[0].i[1]==1 && m[0].i[2]==2;
  p[0].x= -2;p[0].z= -1;#assert !parent_reduce(m[..],p[..],i[..],0);
  for k:0..<9 {bad:=i;bad[k]=0;check:=parent_reduce(m[..],p[..],bad[..],0);#assert !check;}
  rounded:=parent_error(0.1,0,0.000000001);exact:=cast(f64)0.1f32+cast(f64)0.000000001f32;
  #assert cast(f64)f32_from_bits(f32_bits(rounded)-1)<exact;
}
#test "strict convexity refuses collinear and concave boundary segmentation without dropping it" {
  p:=[6]Point.[v3(-2,0,-2),v3(0,0,-2),v3(2,0,-2),v3(2,0,2),v3(-2,0,2),v3(0,1,0)];i:[15]u32;
  for k:0..<5 {i[k*3]=cast(u32)k;i[k*3+1]=5;i[k*3+2]=cast(u32)((k+1)%5);}m:[1]ParentMesh;
  #assert !parent_reduce(m[..],p[..],i[..],0);
  p[1]=v3(0,0,-1);#assert !parent_reduce(m[..],p[..],i[..],0);
}
#test "parent capacity accepts the exact physical limit and refuses a valid larger fan" #steps 100000000 {
  p:[257]Point;i:[768]u32;m:[1]ParentMesh;
  for count:[2]int.[256,257] {
    for k:0..<count-1 {angle:=cast(f32)k*6.28318530718/cast(f32)(count-1);p[k]=v3(cos(angle)*2,0,sin(angle)*2);i[k*3]=cast(u32)k;i[k*3+1]=cast(u32)(count-1);i[k*3+2]=cast(u32)((k+1)%(count-1));}p[count-1]=v3(0,1,0);
    ok:=parent_reduce(m[..],p[0..<count],i[0..<(count-1)*3],0);#assert ok==(count==256);
  }
  #assert m[0].vertices==255;
}

#test "common apex lookup is exact and stable and rejects a missing common vertex" {
  counts:=[4]int.[2,4,4,3];#assert parent_apex(counts[..],4)==1 && parent_apex(counts[..],3)==3 && parent_apex(counts[..],5)== -1;
  p:=[5]Point.[v3(-1,0,-1),v3(1,0,-1),v3(1,0,1),v3(-1,0,1),v3(0,1,0)];m:[1]ParentMesh;
  i:=[12]u32.[0,1,2,1,3,4,2,3,4,0,1,3];#assert !parent_reduce(m[..],p[..],i[..],0);
  i=[12]u32.[0,1,2,4,4,1,2,4,3,3,4,0];#assert !parent_reduce(m[..],p[..],i[..],0);
}
parent_apex :: (counts:[]int,triangles:int)->int #effects(all) {for count,k:counts {if count==triangles {return k;}}return -1;}

parent_error :: (apex:f32,plane:f32,child:f32)->f32 #effects(all) {
  exact:=abs(cast(f64)apex-cast(f64)plane)+cast(f64)child;rounded:=cast(f32)exact;
  if cast(f64)rounded<exact {return f32_from_bits(f32_bits(rounded)+1);}return rounded;
}
parent_reduce :: (out:[]ParentMesh,p:[]Point,indices:[]u32,child_error:f32)->bool #effects(all) {
  if p.count<4 || p.count>PARENT_VERTICES || indices.count!=(p.count-1)*3 || !(child_error>=0 && child_error<1000000) {return false;}
  for v:p {if !finite3(v) {return false;}}
  for v:indices {if cast(int)v>=p.count {return false;}}
  occurrences:[PARENT_VERTICES]int;for v:indices {occurrences[cast(int)v]+=1;}
  apex:=parent_apex(occurrences[0..<p.count],indices.count/3);if apex== -1 {return false;}
  next:[PARENT_VERTICES]int;for k:0..<p.count {next[k]= -1;}
  for t:0..<indices.count/3 {
    x:=cast(int)indices[t*3];y:=cast(int)indices[t*3+1];z:=cast(int)indices[t*3+2];
    a:int;b:int;
    if x==apex {a=y;b=z;}else if y==apex {a=z;b=x;}else if z==apex {a=x;b=y;}else {return false;}
    if next[a]!= -1 {return false;}next[a]=b;
    if cross(sub(p[a],p[apex]),sub(p[b],p[apex])).y<=0 {return false;}
  }
  start:=ifx apex==0 then 1 else 0;plane:=p[start].y;
  for v,k:p {if k!=apex && v.y!=plane {return false;}}
  mesh:=ParentMesh.{vertices=p.count-1,indices=(p.count-3)*3,error=parent_error(p[apex].y,plane,child_error)};
  at:=start;for k:0..<mesh.vertices {mesh.p[k]=p[at];at=next[at];}
  for a,k:mesh.p[0..<mesh.vertices] {b:=mesh.p[(k+1)%mesh.vertices];
    for q,j:mesh.p[0..<mesh.vertices] {if j!=k && j!=(k+1)%mesh.vertices {if cross(sub(b,a),sub(q,a)).y<=0 {return false;}}}
  }
  for k:0..<mesh.indices/3 {mesh.i[k*3+1]=cast(u32)(k+1);mesh.i[k*3+2]=cast(u32)(k+2);}
  out[0]=mesh;return true;
}
