// Bounded still-image ownership. SDKs observe actual file/allocator results;
// the canonical decoder and 607 formatter remain separate shared authorities.
#load "host-image.coax";
#load "media-limits.coax";
#authority;
HOST_IMAGE_CACHE_BYTES :: 134217728;
HostImageMemory :: struct {bytes:[RENDER_MEDIA_ITEMS]int;total:int;}
#test "image cache capacity and physical source bounds are exact" {
 #assert hic_capacity()==112;
 #assert hic_source(1)&&hic_source(HOST_MEDIA_SOURCE_BYTES);
 #assert !hic_source(-1)&&!hic_source(0)&&!hic_source(HOST_MEDIA_SOURCE_BYTES+1)&&!hic_source(9223372036854775807);
}
#test "only root-relative still-image identities occupy a cache slot" {
 #assert hic_offer(1,"/image.jpg",0)&&hic_offer(1,"/image.jpg",111)&&hic_offer(1,"/",0);
 #assert !hic_offer(1,"/image.jpg",-1)&&!hic_offer(1,"/image.jpg",112)&&!hic_offer(1,"/image.jpg",113);
 for kind:[4]int.[-1,0,2,257]{#assert !hic_offer(kind,"/image.jpg",0);}
 for url:[7]string.["","image.jpg","//","//other/image","https://other/image","/a b","/a\nb"]{#assert !hic_offer(1,url,0);}
 #assert hic_offer(1,"/!",0);
 text:[65537]u8;text[0]='/';for i:1..<text.count{text[i]='a';}
 #assert hic_offer(1,cast(string)text[0..<65536],0)&&!hic_offer(1,cast(string)text[..],0);
 for c:0..<33{text[1]=cast(u8)c;#assert !hic_offer(1,cast(string)text[0..<2],0);}
 text[1]=127;#assert !hic_offer(1,cast(string)text[0..<2],0);text[1]=128;#assert hic_offer(1,cast(string)text[0..<2],0);
}
#test "decoded image reservations own the slot and aggregate residency before allocation" {
 m:[1]HostImageMemory;#assert hic_reserve(m[..],0,4)&&hic_reserve(m[..],111,16777216)&&hic_total(m[..])==16777220;
 #assert !hic_reserve(m[..],0,4)&&hic_total(m[..])==16777220;
 #assert hic_release(m[..],0)&&hic_total(m[..])==16777216&&!hic_release(m[..],0);
 #assert hic_release(m[..],111)&&hic_total(m[..])==0;
 #assert hic_reserve(m[..],0,1)&&hic_release(m[..],0)&&hic_total(m[..])==0;
 for i:0..<8{#assert hic_reserve(m[..],i,16777216);}#assert hic_total(m[..])==HOST_IMAGE_CACHE_BYTES&&!hic_reserve(m[..],8,4);
 #assert hic_release(m[..],7)&&hic_reserve(m[..],8,16777216)&&hic_total(m[..])==HOST_IMAGE_CACHE_BYTES;
}
#test "invalid image memory views slots extents and corrupted totals refuse atomically" {
 m:[1]HostImageMemory;two:[2]HostImageMemory;
 #assert !hic_reserve(m[0..<0],0,4)&&!hic_reserve(two[..],0,4)&&hic_total(m[0..<0])== -1&&hic_total(two[..])== -1;
 #assert !hic_release(m[0..<0],0)&&!hic_release(two[..],0);
 for slot:[4]int.[-1,112,113,9223372036854775807]{#assert !hic_reserve(m[..],slot,4)&&!hic_release(m[..],slot);}
 for bytes:[5]int.[-1,0,16777217,16777220,9223372036854775807]{#assert !hic_reserve(m[..],0,bytes)&&hic_total(m[..])==0;}
 for total:[2]int.[-1,HOST_IMAGE_CACHE_BYTES+1]{m[0].total=total;#assert !hic_reserve(m[..],0,4)&&m[0].total==total;m[0].bytes[0]=4;#assert !hic_release(m[..],0)&&m[0].bytes[0]==4;m[0].bytes[0]=0;}
 m[0].total=3;m[0].bytes[0]=4;#assert !hic_release(m[..],0)&&m[0].total==3&&m[0].bytes[0]==4;
 m[0].total=HOST_IMAGE_CACHE_BYTES-4;m[0].bytes[0]=0;#assert hic_reserve(m[..],0,4)&&m[0].total==HOST_IMAGE_CACHE_BYTES;
 m[0].total=HOST_IMAGE_CACHE_BYTES-3;m[0].bytes[0]=0;#assert !hic_reserve(m[..],0,4)&&m[0].total==HOST_IMAGE_CACHE_BYTES-3;
}
hic_capacity :: ()->int #export_c #effects(all) {return RENDER_MEDIA_ITEMS;}
hic_source :: (bytes:int)->bool #export_c #effects(all) {return bytes>=1&&bytes<=HOST_MEDIA_SOURCE_BYTES;}
hic_offer :: (kind:int,url:string,used:int)->bool #export_c #effects(all) {
 if kind!=1||used<0||used>=RENDER_MEDIA_ITEMS||url.count<1||url.count>65536||url[0]!='/'||(url.count>1&&url[1]=='/'){return false;}
 for c:url{if c<=32||c==127{return false;}}return true;
}
hic_reserve :: (s:[]HostImageMemory,slot:int,bytes:int)->bool #export_c #effects(all) {
 if s.count!=1||slot<0||slot>=RENDER_MEDIA_ITEMS||bytes<=0||bytes>HOST_MEDIA_SIDE*HOST_MEDIA_SIDE*4{return false;}
 if s[0].bytes[slot]!=0||s[0].total<0||bytes>HOST_IMAGE_CACHE_BYTES-s[0].total{return false;}
 s[0].bytes[slot]=bytes;s[0].total+=bytes;return true;
}
hic_release :: (s:[]HostImageMemory,slot:int)->bool #export_c #effects(all) {
 if s.count!=1||slot<0||slot>=RENDER_MEDIA_ITEMS{return false;}bytes:=s[0].bytes[slot];
 if bytes<=0||s[0].total<bytes||s[0].total>HOST_IMAGE_CACHE_BYTES{return false;}
 s[0].total-=bytes;s[0].bytes[slot]=0;return true;
}
hic_total :: (s:[]HostImageMemory)->int #export_c #effects(all) {if s.count!=1{return -1;}return s[0].total;}
