// Physical buffer observations are shared by the browser, native and reference
// adapters. The caller admits the source span before constructing words.
#module "aethyr.render.host.inputs";
#load "host-bindings.coax";
#load "geometry.coax";
#load "resources.coax";
#authority;
RenderHostNamedBuffer :: struct {name:string;words:[]u32;observed:RenderBufferObserved;}
RenderHostBufferReceipt :: struct {
 status:RenderResourceStatus;named_index:int=-1;view:RenderBufferView;
 words:[]u32;stride:int;
}
RenderHostGeometryBuffers :: struct {status:RenderResourceStatus;count:int;}
// Checks stay here so the complete Everglade carrier fits its source-unit budget.
#test "shared host inputs retain independent main and particle uniform extents" {
 rhi_words:[2304]u32;rhi_words[27]=27;rhi_words[28]=28;rhi_words[2299]=2299;
 rhi_files:=[1]RenderHostNamedBuffer.[RenderHostNamedBuffer.{name="u.bin",words=rhi_words[..],observed=RenderBufferObserved.{source_capacity=9216,logical_payload=9216,initialized_highwater=9216,gpu_bytes=9216}}];
 rhi_q:=render_host_resolve_buffer(2,0,0,rhi_files[..],RenderHostNamedBuffer.{});
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.named_index==0 && rhi_q.view.bytes==9200 && rhi_q.view.elements==2300 && rhi_q.stride==4;
 #assert rhi_q.words.count==2300 && rhi_q.words[2299]==2299;
 rhi_q=render_host_resolve_buffer(2,1,0,rhi_files[..],RenderHostNamedBuffer.{});
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.view.bytes==112 && rhi_q.view.elements==28 && rhi_q.words.count==28 && rhi_q.words[27]==27;
}
#test "shared host inputs preserve legacy padding retained initialization and physical offsets" {
 rhi_words:[12]u32;rhi_words[4]=41;rhi_words[11]=73;
 rhi_files:=[1]RenderHostNamedBuffer.[RenderHostNamedBuffer.{name="s0.bin",words=rhi_words[..],observed=RenderBufferObserved.{source_capacity=20,gpu_bytes=48,offset=16,zero_initialized=true}}];
 rhi_q:=render_host_resolve_buffer(16,0,1,rhi_files[..],RenderHostNamedBuffer.{});
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.view.offset==16 && rhi_q.view.bytes==32 && rhi_q.words.count==8 && rhi_q.words[0]==41 && rhi_q.words[7]==73;
 rhi_files[0].observed.zero_initialized=false;rhi_files[0].observed.initialized_highwater=47;
 #assert render_host_resolve_buffer(16,0,1,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.uninitialized;
 rhi_files[0].observed.initialized_highwater=48;
 #assert render_host_resolve_buffer(16,0,1,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.ok;
 rhi_files[0].words=rhi_words[0..<11];rhi_q=render_host_resolve_buffer(16,0,1,rhi_files[..],RenderHostNamedBuffer.{});
 #assert rhi_q.status==RenderResourceStatus.capacity && rhi_q.words.count==0 && rhi_q.named_index== -1;
}
#test "shared host inputs resolve an immutable mesh view and refuse missing duplicate or wrong roles" {
 rhi_words:[12]u32;rhi_words[4]=111;rhi_words[11]=222;
 rhi_files:=[2]RenderHostNamedBuffer.[RenderHostNamedBuffer.{name="mesh.bin",words=rhi_words[..],observed=RenderBufferObserved.{source_capacity=32,logical_payload=32,initialized_highwater=64,gpu_bytes=64,offset=16}},RenderHostNamedBuffer.{name="unrelated"}];
 rhi_q:=render_host_resolve_buffer(6,0,1,rhi_files[..],RenderHostNamedBuffer.{});
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.words.count==8 && rhi_q.words[0]==111 && rhi_q.words[7]==222;
 rhi_files[1].name="mesh.bin";#assert render_host_resolve_buffer(6,0,1,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
 rhi_files[1].name="";#assert render_host_named_buffers(rhi_files[..])==RenderResourceStatus.invalid;
 rhi_files[1].name="unrelated";rhi_files[0].name="";#assert render_host_named_buffers(rhi_files[..])==RenderResourceStatus.invalid;
 rhi_files[0].name="vertices.bin";
 #assert render_host_resolve_buffer(6,0,1,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
 #assert render_host_resolve_buffer(-1,0,0,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
 #assert render_host_resolve_buffer(6,-1,0,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
 #assert render_host_resolve_buffer(6,0,2,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
 #assert render_host_resolve_buffer(2,0,6,rhi_files[..],RenderHostNamedBuffer.{}).status==RenderResourceStatus.invalid;
}
#test "shared host inputs keep graph generated bloom and media uniform observations separate" {
 rhi_words:=[8]u32.[1,2,3,4,5,6,7,8];rhi_none:[]RenderHostNamedBuffer;
 rhi_generated:=RenderHostNamedBuffer.{words=rhi_words[..],observed=RenderBufferObserved.{source_capacity=32,logical_payload=32,initialized_highwater=32,gpu_bytes=32}};
 rhi_q:=render_host_resolve_buffer(2,0,14,rhi_none,rhi_generated);
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.named_index== -1 && rhi_q.words.count==4 && rhi_q.words[3]==4;
 rhi_q=render_host_resolve_buffer(2,2,0,rhi_none,rhi_generated);
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.words.count==8 && rhi_q.words[7]==8;
 #assert render_host_resolve_buffer(2,0,0,rhi_none,rhi_generated).status==RenderResourceStatus.invalid;
 #assert render_host_resolve_buffer(2,0,14,rhi_none,RenderHostNamedBuffer.{}).status!=RenderResourceStatus.ok;
}
#test "shared host inputs publish geometry bindings in catalog order only after every view is valid" {
 rhi_heights:[8]u32;rhi_objects:[16]u32;rhi_heights[7]=71;rhi_objects[15]=151;
 rhi_files:=[2]RenderHostNamedBuffer.[RenderHostNamedBuffer.{name="s1.bin",words=rhi_objects[..],observed=RenderBufferObserved.{source_capacity=64,gpu_bytes=64,zero_initialized=true}},RenderHostNamedBuffer.{name="s0.bin",words=rhi_heights[..],observed=RenderBufferObserved.{source_capacity=32,gpu_bytes=32,zero_initialized=true}}];
 rhi_out:[48]RenderGeometryBuffer;rhi_out[0].resource=99;rhi_out[2].resource=87;
 rhi_q:=render_host_geometry_buffers(16,rhi_files[..],rhi_out[0..<2]);
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.count==2 && rhi_out[0].resource==1 && rhi_out[0].binding_set==0 && rhi_out[0].words[7]==71;
 #assert rhi_out[1].resource==2 && rhi_out[1].words[15]==151 && rhi_out[2].resource==87;
 rhi_out[0].resource=99;rhi_files[0].observed.gpu_bytes=60;
 rhi_q=render_host_geometry_buffers(16,rhi_files[..],rhi_out[..]);#assert rhi_q.status!=RenderResourceStatus.ok && rhi_q.count==0 && rhi_out[0].resource==99;
 rhi_files[0].observed.gpu_bytes=64;rhi_q=render_host_geometry_buffers(16,rhi_files[..],rhi_out[0..<1]);
 #assert rhi_q.status==RenderResourceStatus.capacity && rhi_q.count==0 && rhi_out[0].resource==99;
 rhi_q=render_host_geometry_buffers(16,rhi_files[1..<2],rhi_out[..]);#assert rhi_q.status==RenderResourceStatus.ok && rhi_q.count==1;
 #assert render_host_geometry_buffers(-1,rhi_files[..],rhi_out[..]).status==RenderResourceStatus.invalid;
 rhi_files[0].name="s0.bin";rhi_out[0].resource=99;
 #assert render_host_geometry_buffers(16,rhi_files[..],rhi_out[..]).status==RenderResourceStatus.invalid && rhi_out[0].resource==99;
}
#test "shared host inputs include particle storage and bound names without mutating short output" {
 rhi_puffs:[12]u32;rhi_puffs[11]=91;
 rhi_files:=[1]RenderHostNamedBuffer.[RenderHostNamedBuffer.{name="puffs.bin",words=rhi_puffs[..],observed=RenderBufferObserved.{source_capacity=48,gpu_bytes=48,zero_initialized=true}}];
 rhi_out:[48]RenderGeometryBuffer;rhi_q:=render_host_geometry_buffers(2,rhi_files[..],rhi_out[..]);
 #assert rhi_q.status==RenderResourceStatus.ok && rhi_q.count==1 && rhi_out[0].binding_set==1 && rhi_out[0].resource==1 && rhi_out[0].words.count==12 && rhi_out[0].words[11]==91;
 rhi_q=render_host_geometry_buffers(2,rhi_files[..],rhi_out[0..<0]);#assert rhi_q.status==RenderResourceStatus.capacity && rhi_q.count==0;
}

