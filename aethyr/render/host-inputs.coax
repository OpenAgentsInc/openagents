#forall "shared host inputs closed storage inventories fit the48 row geometry receipt" rhi_profile:0..<18 {
 rhi_expected:=[18]int.[4,0,6,3,1,0,1,2,0,2,2,4,2,3,0,0,2,0];rhi_count:=0;
 for rhi_set:0..<2 {for rhi_resource:0..<render_host_binding_count(rhi_profile,rhi_set) {if render_host_binding(rhi_profile,rhi_set,rhi_resource).binding.kind==RenderResourceKind.storage {rhi_count+=1;}}}
 #assert rhi_count==rhi_expected[rhi_profile] && rhi_count<=RENDER_RESOURCES;
}
#test "shared host owned buffers describe every exact initialized byte and preserve their word view" {
 rhi_words:=[3]u32.[11,22,33];rhi_q:=render_host_owned_buffer("owned",rhi_words[..]);
 #assert rhi_q.name=="owned" && rhi_q.words.count==3 && rhi_q.words[2]==33;
 #assert rhi_q.observed.source_capacity==12 && rhi_q.observed.logical_payload==12 && rhi_q.observed.initialized_highwater==12 && rhi_q.observed.gpu_bytes==12;
 #assert rhi_q.observed.upload_bytes==0 && rhi_q.observed.offset==0 && rhi_q.observed.alignment==4 && !rhi_q.observed.zero_initialized;
 rhi_q=render_host_owned_buffer("generated",rhi_words[0..<0]);
 #assert rhi_q.name=="generated" && rhi_q.words.count==0 && rhi_q.observed.source_capacity==0 && rhi_q.observed.logical_payload==0 && rhi_q.observed.initialized_highwater==0 && rhi_q.observed.gpu_bytes==0;
}

render_host_named_buffers :: (rhi_named:[]RenderHostNamedBuffer)->RenderResourceStatus {
 if rhi_named.count>RENDER_RESOURCES {return RenderResourceStatus.capacity;}
 for rhi_i:0..<rhi_named.count {
  if rhi_named[rhi_i].name.count==0 {return RenderResourceStatus.invalid;}
  for rhi_j:0..<rhi_i {if rhi_named[rhi_j].name==rhi_named[rhi_i].name {return RenderResourceStatus.invalid;}}
 }
 return RenderResourceStatus.ok;
}
rhi_find_named :: (rhi_name:string,rhi_named:[]RenderHostNamedBuffer)->int {
 for rhi_i:0..<rhi_named.count {if rhi_named[rhi_i].name==rhi_name {return rhi_i;}}return -1;
}
render_host_resolve_buffer :: (rhi_profile:int,rhi_set:int,rhi_resource:int,rhi_named:[]RenderHostNamedBuffer,rhi_generated:RenderHostNamedBuffer)->RenderHostBufferReceipt {
 rhi_status:=render_host_named_buffers(rhi_named);
 if rhi_status!=RenderResourceStatus.ok {return RenderHostBufferReceipt.{status=rhi_status};}
 rhi_binding:=render_host_binding(rhi_profile,rhi_set,rhi_resource);
 if !rhi_binding.valid {return RenderHostBufferReceipt.{};}
 rhi_at:=-1;rhi_buffer:=rhi_generated;
 if rhi_binding.source.kind!=RenderSourceKind.bloom_step && rhi_binding.source.kind!=RenderSourceKind.media_uniform {
  rhi_name_bytes:[32]u8;rhi_name:=render_host_buffer_name(rhi_binding.source,rhi_name_bytes[..]);
  rhi_at=rhi_find_named(rhi_name,rhi_named);if rhi_at<0 {return RenderHostBufferReceipt.{};}rhi_buffer=rhi_named[rhi_at];
 }
 rhi_view:=render_buffer_view(rhi_binding.binding,rhi_binding.source.buffer_mode,rhi_buffer.observed);
 if rhi_view.status!=RenderResourceStatus.ok {return RenderHostBufferReceipt.{status=rhi_view.status};}
 rhi_first:=rhi_view.offset/4;rhi_words:=rhi_view.bytes/4;
 if !render_span_fits(rhi_first,rhi_words,0,cast(u64)rhi_buffer.words.count) {return RenderHostBufferReceipt.{status=RenderResourceStatus.capacity};}
 return RenderHostBufferReceipt.{status=RenderResourceStatus.ok,named_index=rhi_at,view=rhi_view,stride=rhi_binding.binding.stride,words=rhi_buffer.words[cast(int)rhi_first..<cast(int)(rhi_first+rhi_words)]};
}
render_host_geometry_buffers :: (rhi_profile:int,rhi_named:[]RenderHostNamedBuffer,rhi_out:[]RenderGeometryBuffer)->RenderHostGeometryBuffers {
 if !render_catalog(rhi_profile).valid {return RenderHostGeometryBuffers.{};}
 rhi_status:=render_host_named_buffers(rhi_named);
 if rhi_status!=RenderResourceStatus.ok {return RenderHostGeometryBuffers.{status=rhi_status};}
 // The closed catalog's combined storage sets fit the same48-resource bound.
 // Missing unused roles stay absent; Geometry decides which payloads a frame
 // actually requires. A requested role always uses resolve_buffer's refusal.
 rhi_candidate:[RENDER_RESOURCES]RenderGeometryBuffer;rhi_count:=0;
 rhi_slots:[RENDER_RESOURCES]u8;
 for rhi_set:[2]int.[0,1] {
  rhi_n:=render_host_binding_count(rhi_profile,rhi_set);if rhi_n== -1 {continue;}
  for rhi_slot,rhi_resource:rhi_slots[0..<rhi_n] {
   rhi_binding:=render_host_binding(rhi_profile,rhi_set,rhi_resource);
   if rhi_binding.binding.kind!=RenderResourceKind.storage {continue;}
   rhi_name_bytes:[32]u8;rhi_name:=render_host_buffer_name(rhi_binding.source,rhi_name_bytes[..]);
   if rhi_find_named(rhi_name,rhi_named)<0 {continue;}
   rhi_q:=render_host_resolve_buffer(rhi_profile,rhi_set,rhi_resource,rhi_named,RenderHostNamedBuffer.{});
   if rhi_q.status!=RenderResourceStatus.ok {return RenderHostGeometryBuffers.{status=rhi_q.status};}
   rhi_candidate[rhi_count]=RenderGeometryBuffer.{binding_set=rhi_set,resource=rhi_resource,words=rhi_q.words};rhi_count+=1;
  }
 }
 if rhi_out.count<rhi_count {return RenderHostGeometryBuffers.{status=RenderResourceStatus.capacity};}
 for rhi_i:0..<rhi_count {rhi_out[rhi_i]=rhi_candidate[rhi_i];}
 return RenderHostGeometryBuffers.{status=RenderResourceStatus.ok,count=rhi_count};
}

// The caller owns and has admitted every word in this precise initialized
// span. Its metadata is shared by working CPU uniforms and generated GPU data.
render_host_owned_buffer :: (rhi_name:string,rhi_words:[]u32)->RenderHostNamedBuffer {
 rhi_bytes:=cast(u64)rhi_words.count*4;
 return RenderHostNamedBuffer.{name=rhi_name,words=rhi_words,observed=RenderBufferObserved.{source_capacity=rhi_bytes,logical_payload=rhi_bytes,initialized_highwater=rhi_bytes,gpu_bytes=rhi_bytes,upload_bytes=0,offset=0,alignment=4,zero_initialized=false}};
}

#test "shared physical buffer allocation retains minimum and exact legacy padding under the device limit" {
 rhi_q:=render_host_buffer_bytes(16900,16912);#assert rhi_q.status==RenderResourceStatus.ok && rhi_q.bytes==16912 && rhi_q.offset==0 && rhi_q.elements==4228;
 #assert render_host_buffer_bytes(16900,16911).status==RenderResourceStatus.capacity;
 #assert render_host_buffer_bytes(16,16).status==RenderResourceStatus.ok && render_host_buffer_bytes(16,16).bytes==16;
 #assert render_host_buffer_bytes(17,32).bytes==32;
 #assert render_host_buffer_bytes(0,16).status==RenderResourceStatus.ok && render_host_buffer_bytes(0,16).bytes==16;
 #assert render_host_buffer_bytes(0,15).status==RenderResourceStatus.capacity;
 #assert render_host_buffer_bytes(18446744073709551615,18446744073709551615).status==RenderResourceStatus.capacity;
 #assert render_host_buffer_bytes(18446744073709551600,18446744073709551615).status==RenderResourceStatus.ok && render_host_buffer_bytes(18446744073709551600,18446744073709551615).bytes==18446744073709551600;
}
render_host_buffer_bytes :: (rhi_raw:u64,rhi_device:u64)->RenderBufferView {
 return render_buffer_view(RenderBinding.{name="physical-buffer",kind=RenderResourceKind.storage,stride=4},RenderBufferMode.legacy_capacity,RenderBufferObserved.{source_capacity=rhi_raw,gpu_bytes=rhi_device,zero_initialized=true});
}

#test "shared mesh placeholders preserve the nonblocking zero mesh with a measured device extent" {
 rhi_empty:=render_host_mesh_placeholder(6,0,1,16);
 #assert rhi_empty.status==RenderResourceStatus.ok && rhi_empty.bytes==16 && rhi_empty.offset==0 && rhi_empty.elements==4;
 #assert render_host_mesh_placeholder(6,0,1,15).status==RenderResourceStatus.capacity;
 #assert render_host_mesh_placeholder(6,0,1,0).status==RenderResourceStatus.capacity;
 #assert render_host_mesh_placeholder(6,0,0,16).status==RenderResourceStatus.invalid;
 #assert render_host_mesh_placeholder(-1,0,1,16).status==RenderResourceStatus.invalid;
 #assert render_host_mesh_placeholder(6,1,1,16).status==RenderResourceStatus.invalid;
 rhi_zero:[4]u32;rhi_buffer:=render_host_owned_buffer("mesh.bin",rhi_zero[..]);
 rhi_buffer.observed.zero_initialized=true;
 rhi_named:=[1]RenderHostNamedBuffer.[rhi_buffer];
 rhi_view:=render_host_resolve_buffer(6,0,1,rhi_named[..],RenderHostNamedBuffer.{});
 #assert rhi_view.status==RenderResourceStatus.ok && rhi_view.view.bytes==16 && rhi_view.words.count==4;
 #assert rhi_view.words[0]==0 && rhi_view.words[1]==0 && rhi_view.words[2]==0 && rhi_view.words[3]==0;
}
render_host_mesh_placeholder :: (rhi_profile:int,rhi_set:int,rhi_resource:int,rhi_device:u64)->RenderBufferView {
 if render_host_binding(rhi_profile,rhi_set,rhi_resource).source.kind!=RenderSourceKind.mesh_asset {return RenderBufferView.{};}
 return render_host_buffer_bytes(16,rhi_device);
}
