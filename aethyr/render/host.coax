aethyr_render_pipeline :: (rh_profile:int,rh_entry:int)->RenderHostPipeline #export_c {return render_host_pipeline(rh_profile,rh_entry);}
aethyr_render_clear :: ()->RenderHostClear #export_c {return render_host_clear();}
aethyr_render_buffer_name :: (rh_source:RenderBindingSource,rh_out:[]u8)->string #export_c {return render_host_buffer_name(rh_source,rh_out);}
aethyr_render_texture_name :: (rh_source:RenderBindingSource,rh_out:[]u8)->string #export_c {return render_host_texture_name(rh_source,rh_out);}
aethyr_render_decode_draw :: (rh_words:[]u32,rh_record:int)->RenderDecodedDraw #export_c {return render_decode_draw(rh_words,rh_record);}
aethyr_render_binding_source :: (rh_profile:int,rh_set:int,rh_resource:int)->RenderBindingSource #export_c {return render_binding_source(rh_profile,rh_set,rh_resource);}
aethyr_render_buffer_view :: (rh_binding:RenderBinding,rh_mode:host_resources.RenderBufferMode,rh_observed:host_resources.RenderBufferObserved)->host_resources.RenderBufferView #export_c {
 return host_resources.render_buffer_view(rh_binding,rh_mode,rh_observed);
}
aethyr_render_target :: (rh_target:RenderTarget,rh_width:int,rh_height:int,rh_coarse:bool,rh_format:host_resources.RenderTextureFormat,rh_max_dimension:int)->host_resources.RenderTargetDescriptor #export_c {
 return host_resources.render_target_desc_with_limit(rh_target,rh_width,rh_height,rh_coarse,rh_format,rh_max_dimension);
}
aethyr_render_target_raw :: (rh_target:int,rh_width:int,rh_height:int,rh_coarse:bool,rh_format:int,rh_device_max:int)->host_resources.RenderTargetDescriptor #export_c {return render_host_target_raw(rh_target,rh_width,rh_height,rh_coarse,rh_format,rh_device_max);}
