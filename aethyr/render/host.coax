// C facade source part. Link it once with the producer that already owns SHA
// (the Grid's landing-browser unit); no private copy of the crypto kernel.
#load "host-policy.coax";
#load "host-frame.coax";
#load "host-bindings.coax";
#load "host-inputs.coax";
#load "host-textures.coax";
#load "host-memory.coax";
#load "sans-profile.coax";
#load "media-commands.coax";
#load "host-media.coax";
#load "host-uploads.coax";
#load "asset-profile.coax";
#load "resources.coax" as host_resources;
#load "registry.coax";

RenderHostEntryBank :: struct {entries:[14]RenderPackageEntry;}
RenderHostJsonBank :: struct {bytes:[RENDER_PACKAGE_JSON]u8;}
RenderHostShaderBytes :: struct {bytes:[RENDER_PACKAGE_SHADER]u8;}
RenderHostNamedBank :: struct {buffers:[RENDER_RESOURCES]RenderHostNamedBuffer;names:[RENDER_RESOURCES][32]u8;}
RenderHostGeometryBank :: struct {buffers:[RENDER_RESOURCES]RenderGeometryBuffer;domains:[RENDER_GEOMETRY_DRAWS]RenderDrawDomain;}
RenderHostUploadBank :: struct {uploads:[RENDER_RESOURCES+3]RenderUpload;states:[RENDER_RESOURCES]RenderHostUploadState;index:RenderHostUploadState;}
RenderHostAssetBank :: struct {observations:[RENDER_ASSET_ROWS]RenderAssetObservation;}

aethyr_render_abi :: ()->int #export_c {return 1;}
aethyr_render_geometry_work :: ()->int #export_c {return RENDER_GEOMETRY_WORK;}
aethyr_render_operation :: (rh_frame:[]RenderRuntimeFrame,rh_index:int)->RenderOp #export_c {return render_host_operation(rh_frame,rh_index);}
// Field projections borrow platform-owned static storage. They make no
// admission decision; the caller supplies its one actual storage object.
aethyr_render_entry_storage :: (rh_bank:[]RenderHostEntryBank)->[]RenderPackageEntry #export_c {return rh_bank[0].entries[..];}
aethyr_render_json_storage :: (rh_bank:[]RenderHostJsonBank)->[]u8 #export_c {return rh_bank[0].bytes[..];}
aethyr_render_shader_storage :: (rh_bank:[]RenderHostShaderBytes)->[]u8 #export_c {return rh_bank[0].bytes[..];}
aethyr_render_named_storage :: (rh_bank:[]RenderHostNamedBank)->[]RenderHostNamedBuffer #export_c {return rh_bank[0].buffers[..];}
aethyr_render_geometry_storage :: (rh_bank:[]RenderHostGeometryBank)->[]RenderGeometryBuffer #export_c {return rh_bank[0].buffers[..];}
aethyr_render_upload_storage :: (rh_bank:[]RenderHostUploadBank)->[]RenderUpload #export_c {return rh_bank[0].uploads[..];}
aethyr_render_asset_storage :: (rh_bank:[]RenderHostAssetBank)->[]RenderAssetObservation #export_c {return rh_bank[0].observations[..];}
aethyr_render_json_size :: (rh_count:int)->RenderPackageStatus #export_c {return render_host_json_size(rh_count);}
aethyr_render_device :: (rh_backend:int,rh_helper:bool,rh_int64:bool)->RenderDeviceCapabilities #export_c {return render_host_device(rh_backend,rh_helper,rh_int64);}
aethyr_render_buffer_sizes :: (rh_profile:int,rh_vertices:int,rh_stride:int,rh_uniforms:int,rh_device_bytes:u64)->RenderHostBufferSizes #export_c {return render_host_buffer_sizes(rh_profile,rh_vertices,rh_stride,rh_uniforms,rh_device_bytes);}
aethyr_render_flat_layout :: (rh_profile:int,rh_counts:FrameCounts,rh_limits:RenderFrameLimits,rh_vertices:int,rh_uniforms:int,rh_vertex_address:u64,rh_uniform_address:u64,rh_memory_bytes:u64,rh_vertex_gpu:u64,rh_uniform_gpu:u64)->RenderHostFlatLayout #export_c {
 return render_host_flat_layout(rh_profile,rh_counts,rh_limits,rh_vertices,rh_uniforms,rh_vertex_address,rh_uniform_address,rh_memory_bytes,rh_vertex_gpu,rh_uniform_gpu);
}
aethyr_render_vertex_layout :: (rh_profile:int,rh_counts:FrameCounts,rh_limits:RenderFrameLimits,rh_vertices:int,rh_uniforms:int,rh_vertex_address:u64,rh_uniform_address:u64,rh_memory_bytes:u64,rh_vertex_gpu:u64,rh_uniform_gpu:u64)->RenderHostFlatLayout #export_c {
 return render_host_vertex_layout(rh_profile,rh_counts,rh_limits,rh_vertices,rh_uniforms,rh_vertex_address,rh_uniform_address,rh_memory_bytes,rh_vertex_gpu,rh_uniform_gpu);
}
