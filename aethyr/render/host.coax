 rh_uploads:[]RenderUpload,rh_words:[]u32,rh_indices:[]u32,rh_uniforms:[]f32,rh_buffers:[]RenderGeometryBuffer,rh_hud:[]f32,rh_domains:[]RenderDrawDomain,rh_work_limit:int)->RenderRuntimeFrame #export_c {
 return render_runtime_frame(rh_profile,rh_counts,rh_limits,rh_ready,rh_particles_ready,rh_uploads,rh_words,rh_indices,rh_uniforms,rh_buffers,rh_hud,rh_domains,rh_work_limit);
}
aethyr_render_catalog :: (rh_profile:int)->RenderCatalog #export_c {return render_catalog(rh_profile);}
aethyr_render_binding_count :: (rh_profile:int,rh_set:int)->int #export_c {return render_host_binding_count(rh_profile,rh_set);}
aethyr_render_binding :: (rh_profile:int,rh_set:int,rh_resource:int)->RenderHostBinding #export_c {return render_host_binding(rh_profile,rh_set,rh_resource);}
aethyr_render_use_count :: (rh_profile:int,rh_entry:int)->int #export_c {return render_host_use_count(rh_profile,rh_entry);}
aethyr_render_group_count :: (rh_profile:int,rh_entry:int)->int #export_c {return render_host_group_count(rh_profile,rh_entry);}
