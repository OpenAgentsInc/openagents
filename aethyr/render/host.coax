aethyr_render_texture_layout :: (rh_binding:RenderBinding)->host_resources.RenderTextureLayout #export_c {return host_resources.render_texture_layout(rh_binding);}

// A candidate owns the inactive borrowed bank until its actual products and
// platform pipelines are ready. Only commit publishes it to frame admission.
aethyr_render_package_prepare :: (rh_state:[]RenderHostPackageState,rh_json:string,rh_entries:[]RenderPackageEntry,rh_profile:int,rh_device:RenderDeviceCapabilities,rh_bank:int)->RenderHostPackageCandidate #export_c {return render_host_package_prepare(rh_state,rh_json,rh_entries,rh_profile,rh_device,rh_bank);}
aethyr_render_package_product :: (rh_candidate:[]RenderHostPackageCandidate,rh_kind:int,rh_index:int,rh_bytes:[]u8)->RenderPackageStatus #export_c {return render_host_package_product(rh_candidate,rh_kind,rh_index,rh_bytes);}
aethyr_render_package_pipeline :: (rh_candidate:[]RenderHostPackageCandidate,rh_index:int,rh_ready:bool)->RenderPackageStatus #export_c {return render_host_package_pipeline(rh_candidate,rh_index,rh_ready);}
aethyr_render_package_commit :: (rh_state:[]RenderHostPackageState,rh_candidate:[]RenderHostPackageCandidate)->RenderPackageStatus #export_c {return render_host_package_commit(rh_state,rh_candidate);}
aethyr_render_bytes :: (rh_address:u64,rh_base:u64,rh_capacity:u64,rh_bytes:u64)->RenderHostByteView #export_c {return render_host_bytes(rh_address,rh_base,rh_capacity,rh_bytes);}
aethyr_render_media_draws :: (rh_profile:int,rh_requests:[]RenderMediaRequest,rh_images:[]RenderHostMediaImage,rh_width:int,rh_height:int,rh_textures:[]RenderHostMediaTexture,rh_out:[]RenderMediaRect)->RenderHostMediaReceipt #export_c {return render_host_media_draws(rh_profile,rh_requests,rh_images,rh_width,rh_height,rh_textures,rh_out);}
aethyr_render_media_capacity :: ()->int #export_c {return RENDER_MEDIA_ITEMS;}
aethyr_render_media_effects :: ()->RenderMediaEffects #export_c {return render_media_effects();}
RenderHostMediaBank :: struct {requests:[RENDER_MEDIA_ITEMS]RenderMediaRequest;images:[RENDER_MEDIA_ITEMS]RenderHostMediaImage;textures:[RENDER_MEDIA_ITEMS]RenderHostMediaTexture;names:[RENDER_MEDIA_ITEMS][32]u8;rects:[RENDER_MEDIA_ITEMS]RenderMediaRect;}
aethyr_render_media_bank :: (rh_b:[]RenderHostMediaBank)->[]RenderHostMediaBank #export_c {return rh_b;}
RenderHostMediaTextBank :: struct {bytes:[RENDER_MEDIA_TEXT_BYTES]u8;}
aethyr_render_media_text_storage :: (rh_b:[]RenderHostMediaTextBank)->[]u8 #export_c {return rh_b[0].bytes[..];}
aethyr_render_bool :: (rh_raw:int)->RenderHostBool #export_c {return render_host_bool(rh_raw);}
aethyr_render_readiness :: (rh_raw:int)->RenderReadiness #export_c {return render_host_readiness(rh_raw);}
aethyr_render_asset_span :: (rh_address:u64,rh_capacity:u64,rh_bytes:u64,rh_memory:u64)->RenderHostByteView #export_c {return render_host_asset_span(rh_address,rh_capacity,rh_bytes,rh_memory);}

// The GPU resource ledger (registry.coax): the platform asks before it
// creates an object and reports each release; a lost device releases all.
RenderHostRegistryBank :: struct {registry:[1]RenderRegistry;}
aethyr_render_registry_storage :: (rh_bank:[]RenderHostRegistryBank)->[]RenderRegistry #export_c {return rh_bank[0].registry[..];}
aethyr_render_registry_open :: (rh_r:[]RenderRegistry)->RrStatus #export_c {return rr_open(rh_r,RrLimits.{slots=RR_SLOTS,words=RR_WORDS});}
aethyr_render_registry_acquire :: (rh_r:[]RenderRegistry,rh_kind:int,rh_words:int)->RrGrant #export_c {return rr_acquire(rh_r,rh_kind,rh_words);}
aethyr_render_registry_release :: (rh_r:[]RenderRegistry,rh_slot:int,rh_generation:int)->RrStatus #export_c {return rr_release(rh_r,RfHandle.{slot=rh_slot,generation=rh_generation});}
aethyr_render_registry_live :: (rh_r:[]RenderRegistry,rh_slot:int,rh_generation:int)->bool #export_c {return rr_live(rh_r,RfHandle.{slot=rh_slot,generation=rh_generation});}
aethyr_render_registry_advance :: (rh_r:[]RenderRegistry)->bool #export_c {return rr_advance(rh_r);}
aethyr_render_registry_lose :: (rh_r:[]RenderRegistry) #export_c {rr_lose(rh_r);}
aethyr_render_buffer_words :: (rh_bytes:int)->int #export_c {return rr_buffer_words(rh_bytes);}
aethyr_render_format_words :: (rh_format:int,rh_width:int,rh_height:int,rh_layers:int,rh_mips:int)->int #export_c {return rr_format_words(rh_format,rh_width,rh_height,rh_layers,rh_mips);}
aethyr_render_texture_words :: (rh_width:int,rh_height:int,rh_layers:int,rh_mips:int,rh_texel_bytes:int)->int #export_c {return rr_texture_words(rh_width,rh_height,rh_layers,rh_mips,rh_texel_bytes);}
aethyr_render_resource_kind :: (rh_index:int)->int #export_c {
  rh_kinds:=[6]int.[RF_UNIFORM,RF_STORAGE,RF_COLOR,RR_VERTEX,RR_INDEX,RR_TEXTURE];
  if rh_index<0 || rh_index>=6 {return -1;}
  return rh_kinds[rh_index];
}
