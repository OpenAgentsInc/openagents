aethyr_render_spirv_bytes :: (rh_package:RenderPackage,rh_entry:int,rh_bytes:[]u8)->RenderPackageStatus #export_c {return render_package_spirv_bytes(rh_package,rh_entry,rh_bytes);}
aethyr_render_tree_bytes :: (rh_package:RenderPackage,rh_entry:int,rh_bytes:[]u8)->RenderPackageStatus #export_c {return render_package_tree_bytes(rh_package,rh_entry,rh_bytes);}
aethyr_render_shader_size :: (rh_count:int)->bool #export_c {return render_package_shader_size(rh_count);}
aethyr_render_preflight :: (rh_profile:int,rh_counts:FrameCounts,rh_limits:RenderFrameLimits,rh_uploads:[]RenderUpload)->RenderRuntimePreflight #export_c {
