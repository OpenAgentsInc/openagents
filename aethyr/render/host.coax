aethyr_render_upload_ack :: (rh_state:RenderHostUploadState,rh_submitted:bool)->RenderHostUploadState #export_c {return render_host_upload_ack(rh_state,rh_submitted);}
aethyr_render_sans_profile :: ()->RenderSansProfile #export_c {return render_sans_profile();}
aethyr_render_sans_level :: (rh_level:int)->RenderSansLevel #export_c {return render_sans_level(rh_level);}
aethyr_render_sans_glyph :: (rh_level:int,rh_index:int)->RenderSansGlyph #export_c {return render_sans_glyph(rh_level,rh_index);}
aethyr_render_media_parse :: (rh_text:string,rh_out:[]RenderMediaRequest)->RenderMediaParse #export_c {return render_media_parse(rh_text,rh_out);}
aethyr_render_media_rect :: (rh_request:RenderMediaRequest,rh_width:int,rh_height:int,rh_image_width:int,rh_image_height:int)->RenderMediaRect #export_c {return render_media_rect(rh_request,rh_width,rh_height,rh_image_width,rh_image_height);}
aethyr_render_media_extent :: (rh_kind:RenderMediaKind,rh_width:int,rh_height:int)->RenderMediaExtent #export_c {return render_media_image_extent(rh_kind,rh_width,rh_height);}
aethyr_render_media_rects :: (rh_requests:[]RenderMediaRequest,rh_images:[]RenderHostMediaImage,rh_width:int,rh_height:int,rh_out:[]RenderMediaRect)->RenderHostMediaReceipt #export_c {return render_host_media_rects(rh_requests,rh_images,rh_width,rh_height,rh_out);}
aethyr_render_media_observe :: (rh_kind:int,rh_url:string,rh_ready:int,rh_width:int,rh_height:int)->RenderHostMediaObserved #export_c {return render_host_media_observe_raw(rh_kind,rh_url,rh_ready,rh_width,rh_height);}
aethyr_render_media_vertices :: ()->int #export_c {return render_media_vertex_count();}
aethyr_render_asset_count :: (rh_profile:int)->int #export_c {return render_asset_count(rh_profile);}
aethyr_render_asset :: (rh_profile:int,rh_row:int)->RenderAsset #export_c {return render_asset(rh_profile,rh_row);}
aethyr_render_asset_url :: (rh_profile:int,rh_row:int,rh_index:int)->string #export_c {return render_asset_url(rh_profile,rh_row,rh_index);}
aethyr_render_asset_source :: (rh_profile:int,rh_source:RenderBindingSource)->RenderAsset #export_c {return render_asset_for_source(rh_profile,rh_source);}
aethyr_render_asset_find :: (rh_profile:int,rh_kind:RenderAssetKind,rh_ordinal:int)->RenderAsset #export_c {return render_asset_find(rh_profile,rh_kind,rh_ordinal);}
aethyr_render_asset_readiness :: (rh_profile:int,rh_pipeline:bool,rh_particles:bool,rh_observed:[]RenderAssetObservation)->RenderAssetReadiness #export_c {return render_asset_readiness(rh_profile,rh_pipeline,rh_particles,rh_observed);}
aethyr_render_asset_mip :: (rh_width:int,rh_height:int,rh_layers:int,rh_level:int,rh_max:int,rh_max_layers:int)->RenderAssetMip #export_c {return render_asset_mip(rh_width,rh_height,rh_layers,rh_level,rh_max,rh_max_layers);}
aethyr_render_asset_layers :: ()->RenderAssetLayers #export_c {return render_asset_layers();}
aethyr_render_named_buffers :: (rh_named:[]RenderHostNamedBuffer)->host_resources.RenderResourceStatus #export_c {return render_host_named_buffers(rh_named);}
aethyr_render_owned_buffer :: (rh_name:string,rh_words:[]u32)->RenderHostNamedBuffer #export_c {return render_host_owned_buffer(rh_name,rh_words);}
aethyr_render_buffer_bytes :: (rh_raw:u64,rh_device:u64)->host_resources.RenderBufferView #export_c {return render_host_buffer_bytes(rh_raw,rh_device);}
aethyr_render_mesh_placeholder :: (rh_profile:int,rh_set:int,rh_resource:int,rh_device:u64)->host_resources.RenderBufferView #export_c {return render_host_mesh_placeholder(rh_profile,rh_set,rh_resource,rh_device);}
aethyr_render_resolve_buffer :: (rh_profile:int,rh_set:int,rh_resource:int,rh_named:[]RenderHostNamedBuffer,rh_generated:RenderHostNamedBuffer)->RenderHostBufferReceipt #export_c {return render_host_resolve_buffer(rh_profile,rh_set,rh_resource,rh_named,rh_generated);}
aethyr_render_geometry_buffers :: (rh_profile:int,rh_named:[]RenderHostNamedBuffer,rh_out:[]RenderGeometryBuffer)->RenderHostGeometryBuffers #export_c {return render_host_geometry_buffers(rh_profile,rh_named,rh_out);}
aethyr_render_resolve_texture :: (rh_profile:int,rh_set:int,rh_resource:int,rh_named:[]RenderHostNamedTexture,rh_media_context:int)->RenderHostTextureReceipt #export_c {return render_host_resolve_texture(rh_profile,rh_set,rh_resource,rh_named,rh_media_context);}
aethyr_render_named_textures :: (rh_named:[]RenderHostNamedTexture)->host_resources.RenderResourceStatus #export_c {return render_host_named_textures(rh_named);}

aethyr_render_find_profile :: (rh_app:string,rh_realm:string,rh_page:int)->int #export_c {return render_host_find_profile(rh_app,rh_realm,rh_page);}
aethyr_render_candidate_bank :: (rh_state:[]RenderHostPackageState)->int #export_c {return render_host_candidate_bank(rh_state);}
