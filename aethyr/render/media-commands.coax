// Shared media text and rectangle policy. Platforms retain the input text,
// decode/upload images and execute the admitted rectangle; Coax owns the
// first112-line window, record selection, numeric decoding and aspect fit.
#module "aethyr.render.media.commands";
#import "Basic";
#load "media-limits.coax";
#authority;
RENDER_MEDIA_TEXT_BYTES :: 65536;
RENDER_MEDIA_IMAGE_SIDE :: 2048;
RenderMediaKind :: enum u8 {invalid;image;video;}
RenderMediaStatus :: enum u8 {ok;capacity;}
RenderMediaRequest :: struct {kind:RenderMediaKind;url:string;over:bool;line:int=-1;box:[4]f64;}
RenderMediaParse :: struct {status:RenderMediaStatus;count:int;lines:int;truncated:bool;}
RenderMediaRect :: struct {ok:bool;draw:bool;line:int=-1;over:bool;uniforms:[8]f32;}
RenderMediaExtent :: struct {ok:bool;width:int;height:int;}
RenderMediaNumber :: struct {ok:bool;value:f64;}
// Checks stay in this unit so the composed realm fits the source graph budget.
// Source part; fixtures preserve the existing producer's whole-pixel text,
// first-line window and invalid-row skip behavior.
#test "media text retains kind URL phase line number and all four coordinates" {
  rows:[4]RenderMediaRequest;
  r:=render_media_parse("image /image 0 0 200 100\nover /overlay 4 8 64 40\nvideo /video 1 2 3 4",rows[..]);
  #assert r.status==RenderMediaStatus.ok && r.count==3 && r.lines==3 && !r.truncated;
  #assert rows[0].kind==RenderMediaKind.image && rows[0].url=="/image" && !rows[0].over && rows[0].line==0;
  #assert rows[1].kind==RenderMediaKind.image && rows[1].url=="/overlay" && rows[1].over && rows[1].line==1;
  #assert rows[2].kind==RenderMediaKind.video && rows[2].url=="/video" && !rows[2].over && rows[2].line==2;
  for i:0..<4 {#assert rows[1].box[i]==[4]f64.[4,8,64,40][i] && rows[2].box[i]==f64(i+1);}
  #assert rows[0].box[0]==0 && rows[0].box[1]==0 && rows[0].box[2]==200 && rows[0].box[3]==100;
}
#test "media text skips malformed rows without renumbering later image contexts" {
  rows:[3]RenderMediaRequest;
  r:=render_media_parse("bad\nimage /ok 1 2 3 4\n\nvideo /v 5 6 7 8\n",rows[..]);
  #assert r.status==RenderMediaStatus.ok && r.count==2 && r.lines==5 && !r.truncated;
  #assert rows[0].line==1 && rows[0].url=="/ok" && rows[1].line==3 && rows[1].url=="/v";
  empty:[]RenderMediaRequest;r=render_media_parse("",empty);
  #assert r.status==RenderMediaStatus.ok && r.count==0 && r.lines==1 && !r.truncated;
}
#test "media row selection preserves literal space columns and rejects unsafe or nonfinite records" {
  bad:=[15]string.["audio /x 0 0 2 2","image x 0 0 2 2","image //x 0 0 2 2","image // 0 0 2 2","image  0 0 2 2","image /x 0 0 2","image /x 0 0 2 2 extra","image\t/x 0 0 2 2","image /x NaN 0 2 2","image /x 0 Infinity 2 2","image /x 0 0 1e309 2","image /x 0 0 2 -Infinity","image /x 0 0 2 2 ","over /x 0 0 nope 2",""];
  for text:bad {q:=rmc_line(text,7);#assert q.kind==RenderMediaKind.invalid;}
  q:=rmc_line("image / 0 0 2 2",9);#assert q.kind==RenderMediaKind.image && q.url=="/" && q.line==9;
  // An empty Number column is zero in the legacy literal-space format.
  q=rmc_line("over /x  0 2 2",8);#assert q.kind==RenderMediaKind.image && q.over && q.box[0]==0;
}
#test "media admission is atomic when caller entry storage is too short" {
  rows:[3]RenderMediaRequest;
  for i:0..<3 {rows[i]=RenderMediaRequest.{kind=RenderMediaKind.video,url="/sentinel",line=91,over=true,box=[4]f64.[92,93,94,95]};}
  r:=render_media_parse("image /a 1 2 3 4\nvideo /b 5 6 7 8",rows[1..<2]);
  #assert r.status==RenderMediaStatus.capacity && r.count==0;
  for i:0..<3 {#assert rows[i].kind==RenderMediaKind.video && rows[i].url=="/sentinel" && rows[i].line==91 && rows[i].over;for j:0..<4 {#assert rows[i].box[j]==f64(92+j);}}
  r=render_media_parse("image /a 1 2 3 4",rows[1..<2]);
  #assert r.status==RenderMediaStatus.ok && r.count==1 && rows[1].url=="/a" && rows[1].line==0;
  #assert rows[0].url=="/sentinel" && rows[2].url=="/sentinel";
}
#test "media112 contexts are independent of48 binding slots and later lines are explicitly outside the window" {
  bytes:[4096]u8;n:=0;line:="image /i 0 0 8 8";
  for i:0..<112 {if i>0 {bytes[n]=10;n+=1;}for c:line {bytes[n]=c;n+=1;}}
  rows:[112]RenderMediaRequest;r:=render_media_parse(cast(string)bytes[0..<n],rows[..]);
  #assert RENDER_MEDIA_ITEMS==112 && r.status==RenderMediaStatus.ok && r.count==112 && r.lines==112 && !r.truncated;
  for i:0..<112 {#assert rows[i].line==i && rows[i].url=="/i";}
  for c:"\nvideo /late 0 0 4 4" {bytes[n]=c;n+=1;}
  r=render_media_parse(cast(string)bytes[0..<n],rows[..]);
  #assert r.status==RenderMediaStatus.ok && r.count==112 && r.lines==112 && r.truncated && rows[111].line==111 && rows[111].url=="/i";
}
#test "media raw text admits its exact byte bound and refuses one extra byte before any write" {
  bytes:[65537]u8;for i:0..<112 {bytes[i]=10;}
  rows:=[1]RenderMediaRequest.[RenderMediaRequest.{url="/sentinel"}];
  r:=render_media_parse(cast(string)bytes[0..<65536],rows[..]);
  #assert r.status==RenderMediaStatus.ok && r.lines==112 && r.truncated && r.count==0;
  r=render_media_parse(cast(string)bytes[..],rows[..]);
  #assert r.status==RenderMediaStatus.capacity && r.count==0 && rows[0].url=="/sentinel";
}
#test "media numeric decoding covers signed decimal exponent prefixed integers and ASCII whitespace" {
  texts:=[20]string.["0","-12.5","+.5","1.","1e2","2.5e-1","0xAf","0B101","0o17","\t +16\r",""," \t\r","0012","1e-9999","0X09","0b11","0O11","9","1E+2","1e9"];
  values:=[20]f64.[0,-12.5,0.5,1,100,0.25,175,5,15,16,0,0,12,0,9,3,9,9,100,1000000000];
  for text,i:texts {q:=rmc_number(text);#assert q.ok && q.value==values[i];}
  q:=rmc_number("-0");#assert q.ok && (f64_bits(q.value)>>63)==1;
  bad:=[19]string.["-","+",".","e1","1e","1e+","1.2.3","NaN","Infinity","0x","0xg","0b2","0o8","1x","1 2","-0x1","1e309","1:","1e:"];
  for text:bad {#assert !rmc_number(text).ok;}
}
#test "media decimal scaling admits the finite extreme and retains gradual underflow" {
  q:=rmc_number("1e308");#assert q.ok && q.value>9e307;
  q=rmc_number("1e-309");#assert q.ok && q.value>0 && q.value<1e-308;
  q=rmc_scale_decimal(1.7976931348623157e308,0);#assert q.ok && q.value==1.7976931348623157e308;
  q=rmc_scale_decimal(1e300,-500);#assert q.ok && q.value>9e-201 && q.value<1.1e-200;
  zero:=0.0;q=rmc_scale_decimal(1,-1.0/zero);#assert q.ok && q.value==0;
  #assert !rmc_scale_decimal(1,zero/zero).ok;
}
#test "media decimal scaling does not overflow a cancelled long significand" {
  bytes:[406]u8;bytes[0]='1';for i:1..<401 {bytes[i]='0';}bytes[401]='e';bytes[402]='-';bytes[403]='4';bytes[404]='0';bytes[405]='0';
  q:=rmc_number(cast(string)bytes[..]);#assert q.ok && abs(q.value-1)<0.000000000001;
}
#test "media aspect fit authors exact centred horizontal and vertical uniforms" {
  rmc_request:=RenderMediaRequest.{kind=RenderMediaKind.image,url="/x",line=111,over=true,box=[4]f64.[10,20,210,120]};
  a:=render_media_rect(rmc_request,400,200,400,400);b:=render_media_rect(rmc_request,400,200,400,100);
  expected_a:=[8]f32.[-0.7,0.8,-0.2,-0.2,1,0,0,0];expected_b:=[8]f32.[-0.95,0.55,0.05,0.05,1,0,0,0];
  #assert a.ok && a.draw && a.line==111 && a.over && b.ok && b.draw && b.line==111 && b.over;
  for i:0..<8 {#assert a.uniforms[i]==expected_a[i] && b.uniforms[i]==expected_b[i];}
}
#test "media pending and one-pixel boxes keep valid context without drawing" {
  rmc_request:=RenderMediaRequest.{kind=RenderMediaKind.video,line=0,box=[4]f64.[0,0,8,8]};
  r:=render_media_rect(rmc_request,8,8,0,0);#assert r.ok && !r.draw && r.line==0 && !r.over;
  rmc_request.box[2]=1;r=render_media_rect(rmc_request,8,8,2,2);#assert r.ok && !r.draw;
  rmc_request.box[2]=8;rmc_request.box[3]=1;r=render_media_rect(rmc_request,8,8,2,2);#assert r.ok && !r.draw;
  rmc_request.box[3]= -1;r=render_media_rect(rmc_request,8,8,2,2);#assert r.ok && !r.draw;
}
#test "media rectangle supports one-pixel images and screens up to the exact finite f32 coordinate limit" {
  rmc_request:=RenderMediaRequest.{kind=RenderMediaKind.image,line=0,box=[4]f64.[0,0,1.7014117331926443e38,1.7014117331926443e38]};
  q:=render_media_rect(rmc_request,1,1,1,1);#assert q.ok && q.draw && q.uniforms[2]==3.4028234663852886e38f32 && q.uniforms[3]==(-3.4028234663852886e38f32);
  rmc_request.box=[4]f64.[-3.4028234663852886e38,0,0,8.5070586659632215e37];
  #assert !render_media_rect(rmc_request,1,1,2,1).ok;
  rmc_request.box=[4]f64.[-1.7976931348623157e308,0,1.7976931348623157e308,8];
  #assert !render_media_rect(rmc_request,1,1,1,1).ok;
  rmc_request.box=[4]f64.[0,-1.7976931348623157e308,8,1.7976931348623157e308];
  #assert !render_media_rect(rmc_request,1,1,1,1).ok;
}
#forall "media rectangle refuses invalid identities dimensions and nonfinite or unrepresentable coordinates" mode:0..<11 {
  rmc_request:=RenderMediaRequest.{kind=RenderMediaKind.image,line=0,box=[4]f64.[0,0,8,8]};w:=8;h:=8;iw:=2;ih:=2;
  if mode==0 {rmc_request.kind=RenderMediaKind.invalid;}if mode==1 {rmc_request.line= -1;}if mode==2 {rmc_request.line=112;}
  if mode==3 {w=0;}if mode==4 {h=0;}if mode==5 {iw= -1;}if mode==6 {ih=0;}
  zero:=0.0;
  if mode==7 {rmc_request.box[0]=zero/zero;}if mode==8 {rmc_request.box[1]=1.0/zero;}
  if mode==9 {rmc_request.box[2]=1e300;}if mode==10 {rmc_request.box[3]= -1.0/zero;}
  r:=render_media_rect(rmc_request,w,h,iw,ih);#assert !r.ok && !r.draw && r.line==(-1);
  for j:0..<8 {#assert r.uniforms[j]==0;}
}
#test "media image extent keeps video dimensions and rounds bounded image resizes with a one-pixel minimum" {
  q:=render_media_image_extent(RenderMediaKind.image,2048,1024);#assert q.ok && q.width==2048 && q.height==1024;
  q=render_media_image_extent(RenderMediaKind.image,2049,1);#assert q.ok && q.width==2048 && q.height==1;
  q=render_media_image_extent(RenderMediaKind.image,1,4096);#assert q.ok && q.width==1 && q.height==2048;
  q=render_media_image_extent(RenderMediaKind.image,1,8192);#assert q.ok && q.width==1 && q.height==2048;
  q=render_media_image_extent(RenderMediaKind.image,8192,1);#assert q.ok && q.width==2048 && q.height==1;
  q=render_media_image_extent(RenderMediaKind.image,8192,4096);#assert q.ok && q.width==2048 && q.height==1024;
  q=render_media_image_extent(RenderMediaKind.video,8192,4096);#assert q.ok && q.width==8192 && q.height==4096;
  #assert !render_media_image_extent(RenderMediaKind.invalid,1,1).ok;
  #assert !render_media_image_extent(RenderMediaKind.image,0,1).ok && !render_media_image_extent(RenderMediaKind.video,1,0).ok;
}
#test "media aspect selection preserves the smaller positive ratio without cancellation" {
  #assert rmc_lower_positive(1,2)==1 && rmc_lower_positive(2,1)==1;
  #assert rmc_lower_positive(1e300,1)==1 && rmc_lower_positive(1,1e300)==1;
  #assert rmc_lower_positive(0.5,0.5)==0.5;
}
#test "media finite and digit classification include both signed infinities and base boundaries" {
  #assert rmc_finite(0) && rmc_finite(1.7976931348623157e308) && rmc_finite(-1.7976931348623157e308);
  zero:=0.0;#assert !rmc_finite(1.0/zero) && !rmc_finite(-1.0/zero) && !rmc_finite(zero/zero);
  #assert rmc_digit('0')==0 && rmc_digit('9')==9 && rmc_digit('a')==10 && rmc_digit('f')==15 && rmc_digit('A')==10 && rmc_digit('F')==15;
  #assert rmc_digit('/')==(-1) && rmc_digit(':')==(-1) && rmc_digit('g')==(-1) && rmc_digit('G')==(-1);
  for c:0..<34 {#assert rmc_space(c)==(c==32 || (c>=9 && c<=13));}
}

rmc_finite :: (x:f64)->bool {return x>=-1.7976931348623157e308 && x<=1.7976931348623157e308;}
// Both candidates are positive. Select their bits from the difference's sign
// rather than subtracting nearly equal large values to recover a small ratio.
rmc_lower_positive :: (a:f64,b:f64)->f64 {
  mask:=cast,trunc(u64)(-cast(int)(f64_bits(a-b)>>63));
  return f64_from_bits(f64_bits(b)^((f64_bits(a)^f64_bits(b))&mask));
}
rmc_space :: (c:int)->bool {return c==32 || (c>=9 && c<=13);}
rmc_digit :: (c:int)->int {
  if c>='0' && c<='9' {return c-'0';}
  if c>='a' && c<='f' {return c-'a'+10;}
  if c>='A' && c<='F' {return c-'A'+10;}
  return -1;
}
// The parser's mantissa is zero or at least1. Apply negative powers in
// bounded finite pieces, then admit only a finite final value.
rmc_scale_decimal :: (mantissa:f64,exponent:f64)->RenderMediaNumber {
  value:=mantissa;power:=exponent;
  if power!=power {return RenderMediaNumber.{};}
  if value!=0 {
    if power>308 {return RenderMediaNumber.{};}
    while power<0 && value!=0 {
      rmc_step:=rmc_lower_positive(-power,308);value*=pow(10.0,-rmc_step);power+=rmc_step;
    }
    if value!=0 {
      scale10:=pow(10.0,power);
      value*=scale10;
    }
  }
  return RenderMediaNumber.{ok=rmc_finite(value),value=value};
}
// The producer writes whole device pixels. Decimal fractions/exponents and
// prefixed integer columns are also decoded here, without a host number parser.
rmc_number :: (text:string)->RenderMediaNumber {
  a:=0;b:=text.count;
  while a<b && rmc_space(cast(int)text[a]) {a+=1;}
  while b>a && rmc_space(cast(int)text[b-1]) {b-=1;}
  if a==b {return RenderMediaNumber.{ok=true};}
  negative:=false;signed:=false;
  if text[a]=='-' || text[a]=='+' {negative=text[a]=='-';signed=true;a+=1;}
  if a==b {return RenderMediaNumber.{};}
  value:f64=0;
  prefix:int;
  if text[a]=='0' {
    if a+1==b {return RenderMediaNumber.{ok=true,value=ifx negative then -value else value};}
    prefix=cast(int)text[a+1];
  }
  if prefix=='x' || prefix=='X' || prefix=='b' || prefix=='B' || prefix=='o' || prefix=='O' {
    if signed {return RenderMediaNumber.{};}
    base:=16;if prefix=='b' || prefix=='B' {base=2;}if prefix=='o' || prefix=='O' {base=8;}
    a+=2;if a==b {return RenderMediaNumber.{};}
    while a<b {digit:=rmc_digit(cast(int)text[a]);if digit<0 || digit>=base {return RenderMediaNumber.{};}value=value*f64(base)+f64(digit);a+=1;}
  }else{
    has_digit:=false;fraction:=0;bias:=0;rmc_dot:=false;
    while a<b {
      c:=text[a];
      if c=='.' && !rmc_dot {rmc_dot=true;a+=1;continue;}
      if c<'0' || c>'9' {break;}
      value=value*10+f64(c-'0');has_digit=true;if rmc_dot {fraction+=1;}
      // Keep a long mantissa finite until its explicit decimal scale is known.
      if (f64_bits(value)>>56)==127 {value*=1e-100;bias+=100;}
      a+=1;
    }
    if !has_digit {return RenderMediaNumber.{};}
    exponent:f64=0;
    if a<b && (text[a]=='e' || text[a]=='E') {
      a+=1;minus:=false;
      if a<b && (text[a]=='+' || text[a]=='-') {minus=text[a]=='-';a+=1;}
      start:=a;
      while a<b && text[a]>='0' && text[a]<='9' {exponent=exponent*10+f64(text[a]-'0');a+=1;}
      if a==start {return RenderMediaNumber.{};}if minus {exponent= -exponent;}
    }
    if a!=b {return RenderMediaNumber.{};}
    scaled:=rmc_scale_decimal(value,exponent+f64(bias)-f64(fraction));
    if !scaled.ok {return scaled;}value=scaled.value;
  }
  if negative {value= -value;}
  return RenderMediaNumber.{ok=rmc_finite(value),value=value};
}
rmc_line :: (text:string,line:int)->RenderMediaRequest {
  columns:[6]string;at:=0;
  for i:0..<6 {
    rmc_begin:=at;while at<text.count && text[at]!=' ' {at+=1;}columns[i]=text[rmc_begin..<at];
    if i<5 {if at==text.count {return RenderMediaRequest.{};}at+=1;}
    else if at!=text.count {return RenderMediaRequest.{};}
  }
  kind:=RenderMediaKind.invalid;over:=false;
  if columns[0]=="image" {kind=RenderMediaKind.image;}
  if columns[0]=="video" {kind=RenderMediaKind.video;}
  if columns[0]=="over" {kind=RenderMediaKind.image;over=true;}
  url:=columns[1];
  if kind==RenderMediaKind.invalid || url.count==0 || url[0]!='/' {return RenderMediaRequest.{};}
  if url.count>1 && url[1]=='/' {return RenderMediaRequest.{};}
  rmc_request:=RenderMediaRequest.{kind=kind,url=url,over=over,line=line};
  for i:0..<4 {number:=rmc_number(columns[i+2]);if !number.ok {return RenderMediaRequest.{};}rmc_request.box[i]=number.value;}
  return rmc_request;
}
rmc_parse_pass :: (text:string,out:[]RenderMediaRequest,store:bool)->RenderMediaParse {
  r:RenderMediaParse;at:=0;
  for line:0..<RENDER_MEDIA_ITEMS {
    end:=at;while end<text.count && text[end]!=10 {end+=1;}
    rmc_request:=rmc_line(text[at..<end],line);r.lines=line+1;
    if rmc_request.kind!=RenderMediaKind.invalid {if store {out[r.count]=rmc_request;}r.count+=1;}
    if end==text.count {return r;}at=end+1;
  }
  r.truncated=true;return r;
}
render_media_parse :: (text:string,out:[]RenderMediaRequest)->RenderMediaParse {
  if text.count>RENDER_MEDIA_TEXT_BYTES {return RenderMediaParse.{status=RenderMediaStatus.capacity};}
  counted:=rmc_parse_pass(text,out,false);
  if counted.count>out.count {counted.status=RenderMediaStatus.capacity;counted.count=0;return counted;}
  return rmc_parse_pass(text,out,true);
}
render_media_rect :: (rmc_request:RenderMediaRequest,width:int,height:int,image_width:int,image_height:int)->RenderMediaRect {
  if (rmc_request.kind!=RenderMediaKind.image && rmc_request.kind!=RenderMediaKind.video) || rmc_request.line<0 || rmc_request.line>=RENDER_MEDIA_ITEMS || width<1 || height<1 {return RenderMediaRect.{};}
  bw:=rmc_request.box[2]-rmc_request.box[0];bh:=rmc_request.box[3]-rmc_request.box[1];
  if !rmc_finite(bw) || !rmc_finite(bh) {return RenderMediaRect.{};}
  r:=RenderMediaRect.{ok=true,line=rmc_request.line,over=rmc_request.over};
  if image_width==0 && image_height==0 {return r;}
  if image_width<1 || image_height<1 {return RenderMediaRect.{};}
  if bw<=1 || bh<=1 {return r;}
  scale:=rmc_lower_positive(bw/f64(image_width),bh/f64(image_height));dw:=f64(image_width)*scale;dh:=f64(image_height)*scale;
  cx:=rmc_request.box[0]+(bw-dw)/2;cy:=rmc_request.box[1]+(bh-dh)/2;
  values:=[4]f64.[cx/f64(width)*2-1,1-cy/f64(height)*2,(cx+dw)/f64(width)*2-1,1-(cy+dh)/f64(height)*2];
  for i:0..<4 {if !rmc_finite(values[i]) || abs(values[i])>3.4028234663852886e38 {return RenderMediaRect.{};}}
  for i:0..<4 {r.uniforms[i]=cast(f32)values[i];}r.uniforms[4]=1;r.draw=true;return r;
}
render_media_image_extent :: (kind:RenderMediaKind,width:int,height:int)->RenderMediaExtent {
  if (kind!=RenderMediaKind.image && kind!=RenderMediaKind.video) || width<1 || height<1 {return RenderMediaExtent.{};}
  if kind==RenderMediaKind.video {return RenderMediaExtent.{ok=true,width=width,height=height};}
  scale:=rmc_lower_positive(rmc_lower_positive(1.0,f64(RENDER_MEDIA_IMAGE_SIDE)/f64(width)),f64(RENDER_MEDIA_IMAGE_SIDE)/f64(height));
  w:=cast(int)floor(f64(width)*scale+0.5);h:=cast(int)floor(f64(height)*scale+0.5);
  return RenderMediaExtent.{ok=true,width=ifx w==0 then 1 else w,height=ifx h==0 then 1 else h};
}
