// The page generator transports this Coax-owned adoption decision verbatim.
//   coax/web/tool.sh aethyr/render/page-render.coax SLUG APP
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "adoption.coax";
RENDER_WEB_SHARED :: false;
#test "local animation workbench requests enough memory for its library" {
 #assert render_page_memory("everglade-experimental","fivelab")==4096;
 #assert render_page_memory("character-creator","fivelab")==4096;
 #assert render_page_memory("everglade-experimental","other")==1024;
}
render_page_memory :: (slug:string,app:string)->int {return render_memory_pages(app);}
#test "Character Create names its private shader only for its established producer" {
 #assert render_page_shader("character-creator","fivelab")=="/charactercreator.wgsl";
 #assert render_page_shader("everglade-experimental","fivelab")=="/charactercreator.wgsl";
 #assert render_page_shader("druid","fivelab")=="/charactercreator.wgsl";
 #assert render_page_shader("archery-range","archery-range")=="/charactercreator.wgsl" && render_page_shader("archery-range","fivelab")=="";
 #assert render_page_memory("archery-range","archery-range")==4096;
 #assert render_page_shader("bitcoin-lab","bitcoin-lab-walk")=="/charactercreator.wgsl" && render_page_shader("bitcoin-lab","bitcoin-lab")=="" && render_page_memory("bitcoin-lab","bitcoin-lab-walk")==4096;
 #assert render_page_shader("nostr-lab","nostr-lab-walk")=="/charactercreator.wgsl" && render_page_shader("nostr-lab","bitcoin-lab-walk")=="" && render_page_memory("nostr-lab","nostr-lab-walk")==4096;
 #assert render_page_shader("5e-lab","fivelab")=="" && render_page_shader("character-creator","other")=="";
 #assert render_page_shader("character-creators","fivelab")=="";
}
// The Archery Range and Bitcoin Lab's walk are modules of their own on the same scene (apps/openagents-web/archery-range.coax,
// bitcoin-lab-walk.coax and nostr-lab-walk.coax on verse/lab-walk.coax, everglade/zone.coax).
render_page_shader :: (slug:string,app:string)->string {return ifx ((slug=="character-creator" || slug=="everglade-experimental" || slug=="druid") && app=="fivelab") || (slug=="archery-range" && app=="archery-range") || (slug=="bitcoin-lab" && app=="bitcoin-lab-walk") || (slug=="nostr-lab" && app=="nostr-lab-walk") then "/charactercreator.wgsl" else "";}
tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args_count(args[..]) != 2 { return 2; }
  if args_at(args[..],0)=="--memory" {print("%",render_memory_pages(args_at(args[..],1)));return 0;}
  route := render_adoption(args_at(args[..], 0), args_at(args[..], 1));
  // Web pages keep the existing renderer for now: with data-render the host fetches the catalogue's
  // raw asset paths (/realms/SLUG/assets/...), which deploy doesn't upload (it content-names
  // data-assets under /build/), so every world 404'd on staging (2026-11-02). Set this when the
  // host or deploy maps the catalogue's URLs to the staged files.
  if route.shared && RENDER_WEB_SHARED {
    p := render_catalog(route.profile);
    print(" data-render=\"/build/render/%/render.json\" data-render-profile=\"%\"", p.slug, route.profile);
    return 0;
  }
  if route.shared || route.tracked_legacy {
    shader_path:=render_page_shader(args_at(args[..],0),args_at(args[..],1));if shader_path!="" {print(" data-wgsl=\"%\"",shader_path);}
    pages:=render_page_memory(args_at(args[..],0),args_at(args[..],1));
    if pages!=1024 {print(" data-memory-pages=\"%\"",pages);}
    return 0;
  }
  tool_errln("realm has no reviewed shared or legacy renderer adoption");
  return 2;
}
