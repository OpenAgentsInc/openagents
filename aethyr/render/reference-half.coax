// Shared physical binary16 codec. Texture-filter results and framebuffer
// storage use the same explicit nearest-even conversion, including subnormals.
#module "aethyr.render.reference.half";
#authority;
RHDecoded :: struct {ok:bool=true;value:f32;}

#test "reference half codec preserves normals boundaries subnormals and signed zero" {
 #assert rh_half_bits(1)==0x3c00 && rh_half_bits(-2)==0xc000 && rh_half_bits(65504)==0x7bff;
 #assert rh_half_bits(65536)==0x7c00 && rh_half_bits(-65536)==0xfc00;
 #assert rh_half_bits(f32_from_bits(0x80000000))==0x8000;
 #assert rh_half_bits(0.000000059604644775390625f32)==1;
 #assert rh_half_bits(0.0000000298023223876953125f32)==0;
 #assert rh_half_bits(0.00000001490116119384765625f32)==0;
 #assert rh_half_bits(0.0000000894069671630859375f32)==2;
 #assert rh_half_bits(0.00006103515625f32)==0x400;
 #assert rh_half_bits(0.000060975551605224609375f32)==0x3ff;
 #assert rh_half_bits(1.00048828125f32)==0x3c00 && rh_half_bits(1.00146484375f32)==0x3c02;
 #assert rh_half_bits(1.99951171875f32)==0x4000;
 #assert rh_half_decode(1).value==0.000000059604644775390625f32;
 #assert rh_half_decode(0x3ff).value==0.000060975551605224609375f32;
 #assert rh_half_decode(0x400).value==0.00006103515625f32;
 #assert rh_half_decode(0x7bff).value==65504 && rh_half_decode(0xc000).value==-2;
 #assert f32_bits(rh_half_decode(0x8000).value)==0x80000000;
 #assert rh_half_decode(0).ok && rh_half_decode(0x3c00).ok;
}
#test "reference half codec refuses malformed and nonfinite encodings" {
 #assert !rh_half_decode(0x10000).ok && !rh_half_decode(0x7c00).ok;
 #assert !rh_half_decode(0xfc00).ok && !rh_half_decode(0x7e00).ok;
 #assert rh_half_bits(1.0f32/0.0f32)==0x7c00;
 #assert rh_half_bits(-1.0f32/0.0f32)==0xfc00;
 #assert rh_half_bits(0.0f32/0.0f32)&0x7fff==0x7c00;
 #assert rh_half_bits(100000)==0x7c00 && rh_half_bits(-100000)==0xfc00;
 #assert rh_half_bits(f32_from_bits(0x33000001))==1 && rh_half_bits(f32_from_bits(0x33c00000))==2;
 #assert rh_half_bits(f32_from_bits(0x34200000))==2 && rh_half_bits(f32_from_bits(0x3f801001))==0x3c01;
 #assert !rh_half_decode(0x7c01).ok && !rh_half_decode(0xffff).ok;
}

rh_half_bits :: (value:f32)->u32 {
 raw:=f32_bits(value);sign:=(raw>>16)&0x8000;exponent:=cast(int)((raw>>23)&255)-127;mantissa:=raw&0x7fffff;
 if exponent>15 {return sign|0x7c00;}
 if exponent < -25 {return sign;}
 // max(-exponent-14,0) gives the extra subnormal shift. The same
 // significand rounding handles the normal/subnormal boundary.
 extra:=cast(f64)(-exponent-14);shift:=cast(u32)(13+(extra+abs(extra))*0.5);
 significand:=mantissa|0x800000;q:=significand>>shift;
 remainder:=significand&(((cast(u32)1)<<shift)-1);half:=cast(u32)1<<(shift-1);
 if remainder>half || (remainder==half && (q&1)!=0) {q+=1;}
 encoded:=cast(f64)(exponent+14);base:=cast(u32)((encoded+abs(encoded))*0.5);
 return sign|((base<<10)+q);
}
rh_half_decode :: (bits:u32)->RHDecoded {
 if (bits>>16)!=0 || (bits&0x7c00)==0x7c00 {return RHDecoded.{ok=false};}
 sign:=(bits&0x8000)<<16;exponent:=(bits>>10)&31;mantissa:=bits&1023;
 if exponent==0 {v:=cast(f32)mantissa*0.000000059604644775390625f32;return RHDecoded.{value=f32_from_bits(f32_bits(v)|sign)};}
 return RHDecoded.{value=f32_from_bits(sign|((exponent+112)<<23)|(mantissa<<13))};
}
