   if m[0].status!=RQStatus.ok {return r;}if start.ty!=loop.ty || limit.ty!=loop.ty {rq_ir_fail(m,RQStatus.malformed);return r;}
   rq_ir_transfer(memory,loop,start,mask);
  }
  body:=m[0].at;active:=mask;first:=true;
  while active!=0 || first {
   first=false;running:=active;
   if op==7 {m[0].at=condition;test:=rq_ir_expr(m,tree,meta,memory,res,f,active);if m[0].status!=RQStatus.ok {return r;}running=rq_ir_bool_mask(memory,test,active);body=m[0].at;}
   else {indices:=rq_active_lanes(running);for k:0..<indices.count {lane:=indices.lanes[k];bit:=cast(u32)1<<cast(u32)lane;
    if rq_ir_integer(m,meta,memory,loop,lane)>=rq_ir_integer(m,meta,memory,limit,lane) {running&=bit^15;}}}
   m[0].at=body;child:=rq_ir_stmt(m,tree,meta,memory,res,f,running);
   if m[0].status!=RQStatus.ok {return r;}
   r.returned|=child.returned;active=running&((child.returned|child.breaking)^15);
   if op==8 {indices:=rq_active_lanes(active);for k:0..<indices.count {lane:=indices.lanes[k];n:=rq_ir_u64(memory,loop,lane);rq_ir_put_u64(memory,loop,lane,add_wrap(n,cast(u64)1));}}
   // Keep the for range values alive across iterations; body temporaries are
