// Checked shader tree-v2/v3 execution on four fragment helper lanes. The native
// host supplies owned word/resource views and compiles this Coax; it decides no
// operation, control flow, texture policy or fragment publication.
#module "aethyr.render.reference.ir";
#authority;
#load "reference-quad.coax";
#load "active-lanes.coax";

RQ_IR_TYPES :: 512;RQ_IR_PROCS :: 512;RQ_IR_META :: 8192;
RQ_IR_PROC :: 4096;RQ_IR_SYNTAX_DEPTH :: 24;RQ_IR_NESTING :: 128;RQ_IR_WORDS :: 65536;
RQBuffer :: struct {words:[]u32;count:int;stride:int;}
RQResources :: struct {buffers:[]RQBuffer;textures:[]RQTexture;samplers:[]RQSampler;}
RQProgram :: struct {version:int;status:RQStatus;types:int;procs:int;entries:int;entry_at:int;tree_words:int;prepare_steps:int;}
RQExecution :: struct {status:RQStatus;steps:int;discarded:u32;publish_mask:u32;output_words:int;}
RQPrivate :: struct {at:int;elem:int;count:int;lane_words:int;}
RQMachine :: struct {version:int;private_count:int;private_views:[64]RQPrivate;types:int;procs:int;stage:int;nesting:int;status:RQStatus;at:int;used:int;steps:int;budget:int;discarded:u32;terminated:u32;derivative:RQDerivative;}
RQValue :: struct {ty:int;at:int;words:int;}
RQPlace :: struct {ty:int;at:[4]int;buffer:[4]int;}
RQFrame :: struct {proc:int;locals:int;values:int;result:RQValue;}
RQFlow :: struct {returned:u32;breaking:u32;continuing:u32;}

rq_ir_fail :: (m:[]RQMachine,status:RQStatus) {if m[0].status==RQStatus.ok {m[0].status=status;}}
rq_ir_next :: (m:[]RQMachine,tree:[]u32)->int {
 if m[0].status!=RQStatus.ok {return 0;}
 if m[0].steps>=m[0].budget {rq_ir_fail(m,RQStatus.budget);return 0;}
 if m[0].at<0 || m[0].at>=tree.count {rq_ir_fail(m,RQStatus.malformed);return 0;}
 n:=cast(int)tree[m[0].at];m[0].at+=1;m[0].steps+=1;return n;
}
rq_ir_meta_words :: ()->int {return RQ_IR_META;}
rq_ir_type :: (meta:[]int,ty:int,k:int)->int {return meta[ty*8+k];}
rq_ir_proc :: (meta:[]int,p:int,k:int)->int {return meta[RQ_IR_PROC+p*8+k];}
rq_ir_prepare :: (tree:[]u32,meta:[]int)->RQProgram {return rq_ir_prepare_with_budget(tree,meta,4000000);}
rq_ir_prepare_with_budget :: (tree:[]u32,meta:[]int,budget:int)->RQProgram {
 if meta.count<RQ_IR_META {return RQProgram.{status=RQStatus.capacity};}
 if budget<1 || budget>4000000 {return RQProgram.{status=RQStatus.resource};}
 ms:=[1]RQMachine.[RQMachine.{budget=budget}];result:=rq_ir_prepare_work(tree,meta,ms[..]);
 if ms[0].status!=RQStatus.ok {result.status=ms[0].status;}result.prepare_steps=ms[0].steps;return result;
}
rq_ir_prepare_work :: (tree:[]u32,meta:[]int,ms:[]RQMachine)->RQProgram {
 version:=rq_ir_next(ms[..],tree);nt:=rq_ir_next(ms[..],tree);
 if (version!=2 && version!=3) || nt<6 || nt>RQ_IR_TYPES {return RQProgram.{status=RQStatus.malformed};}
 ms[0].version=version;ms[0].types=nt;
 for t:0..<nt {
  at:=ms[0].at;k:=rq_ir_next(ms[..],tree);words:=0;bytes:=0;
  if t<6 && k!=t {return RQProgram.{status=RQStatus.malformed};}
  if k==0 {}
  else if k==1 {words=1;bytes=1;}
  else if k>=2 && k<=4 {words=1;bytes=4;}
  else if k==5 || k==6 {words=2;bytes=8;}
  else if k==7 {
   n:=rq_ir_next(ms[..],tree);if n<1 || n>64 {return RQProgram.{status=RQStatus.malformed};}
   end:=0;
   for f:0..<n {
    child:=rq_ir_next(ms[..],tree);offset:=rq_ir_next(ms[..],tree)&1073741823;
    if child<1 || child>=t || offset<end {return RQProgram.{status=RQStatus.malformed};}
    words+=rq_ir_type(meta,child,2);end=offset+rq_ir_type(meta,child,3);
   }
   bytes=rq_ir_next(ms[..],tree);if bytes<end {return RQProgram.{status=RQStatus.malformed};}
  } else if k==8 {
   child:=rq_ir_next(ms[..],tree);n:=rq_ir_next(ms[..],tree);stride:=rq_ir_next(ms[..],tree);
   if child<1 || child>=t || n<1 || n>65536 || stride<rq_ir_type(meta,child,3) {return RQProgram.{status=RQStatus.malformed};}
   words=rq_ir_type(meta,child,2)*n;bytes=stride*n;
  } else if k==9 {
   child:=rq_ir_next(ms[..],tree);if child<1 || child>=t {return RQProgram.{status=RQStatus.malformed};}words=1;
  } else if k==10 {
   dim:=rq_ir_next(ms[..],tree);if dim>2 {return RQProgram.{status=RQStatus.malformed};}meta[t*8+4]=dim;words=1;
  } else if k==11 {
   cmp:=rq_ir_next(ms[..],tree);if cmp>1 {return RQProgram.{status=RQStatus.malformed};}words=1;
  } else {return RQProgram.{status=RQStatus.unsupported};}
  if words>RQ_IR_WORDS || bytes>16777216 {return RQProgram.{status=RQStatus.capacity};}
  meta[t*8]=k;meta[t*8+1]=at;meta[t*8+2]=words;meta[t*8+3]=bytes;
 }
 np:=rq_ir_next(ms[..],tree);if np<1 || np>RQ_IR_PROCS {return RQProgram.{status=RQStatus.malformed};}
 ms[0].procs=np;
 for p:0..<np {
  ret:=rq_ir_next(ms[..],tree);params:=rq_ir_next(ms[..],tree);param_at:=ms[0].at;
  if ret>=nt || params>128 {return RQProgram.{status=RQStatus.malformed};}
  for j:0..<params {ty:=rq_ir_next(ms,tree);}
  locals:=rq_ir_next(ms[..],tree);types_at:=ms[0].at;localwords:=0;
  if locals<params || locals>2048 {return RQProgram.{status=RQStatus.malformed};}
  for j:0..<locals {
   ty:=rq_ir_next(ms[..],tree);if ty<1 || ty>=nt {return RQProgram.{status=RQStatus.malformed};}
   if j<params && tree[param_at+j]!=cast(u32)ty {return RQProgram.{status=RQStatus.malformed};}
   localwords+=rq_ir_type(meta,ty,2);
  }
  length:=rq_ir_next(ms[..],tree);body:=ms[0].at;
  if length<1 || localwords>262144 {return RQProgram.{status=RQStatus.malformed};}
  row:=RQ_IR_PROC+p*8;
  meta[row]=ret;meta[row+1]=params;meta[row+2]=locals;meta[row+3]=types_at;
  meta[row+4]=body;meta[row+5]=body+length;meta[row+6]=localwords;meta[row+7]=param_at;
  ms[0].at=body+length;
 }
 entries:=rq_ir_next(ms[..],tree);entry_at:=ms[0].at;
 if entries<1 {return RQProgram.{status=RQStatus.malformed};}
 stages:u32=0;
 for e:0..<entries {
  stage:=rq_ir_next(ms[..],tree);p:=rq_ir_next(ms[..],tree);
  if stage>1 || p>=np {return RQProgram.{status=RQStatus.malformed};}
  bit:=cast(u32)(stage+1);if (stages&bit)!=0 {return RQProgram.{status=RQStatus.malformed};}stages|=bit;
  for j:0..<rq_ir_proc(meta,p,1) {name:=rq_ir_next(ms[..],tree);}
 }
 if ms[0].status!=RQStatus.ok || ms[0].at!=tree.count {return RQProgram.{status=RQStatus.malformed};}
 for p:0..<np {
  ms[0].at=rq_ir_proc(meta,p,4);rq_ir_shape_stmt(ms[..],tree,meta);
  if ms[0].status!=RQStatus.ok {return RQProgram.{status=ms[0].status};}
  if ms[0].at!=rq_ir_proc(meta,p,5) {return RQProgram.{status=RQStatus.malformed};}
 }
 return RQProgram.{version=version,types=nt,procs=np,entries=entries,entry_at=entry_at,tree_words=tree.count};
}
rq_ir_entry :: (program:RQProgram,tree:[]u32,meta:[]int,stage:int)->int {
 at:=program.entry_at;
 for e:0..<program.entries {s:=cast(int)tree[at];p:=cast(int)tree[at+1];if s==stage {return p;}at+=2+rq_ir_proc(meta,p,1);}
 return -1;
}
rq_ir_parameter_words :: (program:RQProgram,tree:[]u32,meta:[]int,stage:int)->int {
 p:=rq_ir_entry(program,tree,meta,stage);if p<0 {return 0;}
 at:=rq_ir_proc(meta,p,7);n:=0;
 for j:0..<rq_ir_proc(meta,p,1) {n+=4*rq_ir_type(meta,cast(int)tree[at+j],2);}return n;
}
rq_ir_value :: (m:[]RQMachine,meta:[]int,memory:[]u32,ty:int)->RQValue {
 if ty<0 || ty>=m[0].types {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
 n:=rq_ir_type(meta,ty,2);at:=m[0].used;
 if n*4>memory.count-at {rq_ir_fail(m,RQStatus.capacity);return RQValue.{};}
 for j:0..<n*4 {memory[at+j]=0;}m[0].used+=n*4;return RQValue.{ty=ty,at=at,words=n};
}
// Values own four contiguous lanes inside the caller's larger arena. Exact
// subviews enforce that ownership independently of unused arena tail space.
rq_ir_value_words :: (memory:[]u32,v:RQValue)->[]u32 {return memory[v.at..<v.at+4*v.words];}
rq_ir_transfer :: (memory:[]u32,to:RQValue,from:RQValue,mask:u32) {
 target:=rq_ir_value_words(memory,to);source:=rq_ir_value_words(memory,from);
 active:=rq_active_lanes(mask);for active_index:0..<active.count {lane:=active.lanes[active_index];for j:0..<to.words {target[lane*to.words+j]=source[lane*from.words+j];}}
}
rq_ir_u64 :: (memory:[]u32,v:RQValue,lane:int)->u64 {
 words:=rq_ir_value_words(memory,v);at:=lane*v.words;n:=cast(u64)words[at];if v.words==2 {n|=cast(u64)words[at+1]<<32;}return n;
}
rq_ir_put_u64 :: (memory:[]u32,v:RQValue,lane:int,n:u64) {
 words:=rq_ir_value_words(memory,v);at:=lane*v.words;words[at]=cast(u32)(n&4294967295);if v.words==2 {words[at+1]=cast(u32)(n>>32);}
}
rq_ir_f32 :: (memory:[]u32,v:RQValue,lane:int)->f32 {words:=rq_ir_value_words(memory,v);return f32_from_bits(words[lane*v.words]);}
rq_ir_put_f32 :: (memory:[]u32,v:RQValue,lane:int,f:f32) {words:=rq_ir_value_words(memory,v);words[lane*v.words]=f32_bits(f);}

#load "tests/reference-ir-checks.coax";

rq_ir_local :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,f:RQFrame,id:int)->RQValue {
 if id<0 || id>=rq_ir_proc(meta,f.proc,2) {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
 ty:=cast(int)tree[rq_ir_proc(meta,f.proc,3)+id];
 return RQValue.{ty=ty,at=cast(int)memory[f.locals+id],words=rq_ir_type(meta,ty,2)};
}
rq_ir_field :: (m:[]RQMachine,tree:[]u32,meta:[]int,ty:int,field:int)->RQValue {
 if rq_ir_type(meta,ty,0)!=7 {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
 at:=rq_ir_type(meta,ty,1);count:=cast(int)tree[at+1];
 if field<0 || field>=count {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
 offset:=0;for j:0..<field {offset+=rq_ir_type(meta,cast(int)tree[at+2+j*2],2);}
 child:=cast(int)tree[at+2+field*2];return RQValue.{ty=child,at=offset,words=rq_ir_type(meta,child,2)};
}
rq_ir_bool_mask :: (memory:[]u32,v:RQValue,mask:u32)->u32 {
 r:u32=0;active:=rq_active_lanes(mask);
 for k:0..<active.count {lane:=active.lanes[k];if memory[v.at+lane*v.words]!=0 {r|=cast(u32)1<<cast(u32)lane;}}return r;
}
rq_ir_binary :: (m:[]RQMachine,meta:[]int,memory:[]u32,op:int,a:RQValue,b:RQValue,mask:u32)->RQValue {
 if a.ty!=b.ty || op<1 || op>18 {rq_ir_fail(m,RQStatus.unsupported);return RQValue.{};}
 kind:=rq_ir_type(meta,a.ty,0);
 if kind<1 || kind>6 || (kind==1 && (op<10 || op>13)) || (kind==2 && (op==5 || op>=12)) || (kind>=3 && (op==12 || op==13)) {rq_ir_fail(m,RQStatus.unsupported);return RQValue.{};}
 ty:=ifx op>=6 && op<14 then 1 else a.ty;r:=rq_ir_value(m,meta,memory,ty);
 if m[0].status!=RQStatus.ok {return r;}
 active:=rq_active_lanes(mask);for active_index:0..<active.count {lane:=active.lanes[active_index];
  yes:bool;
  if kind==2 {
   x:=rq_ir_f32(memory,a,lane);y:=rq_ir_f32(memory,b,lane);v:f32;
   if op==1 {v=x+y;}else if op==2 {v=x-y;}else if op==3 {v=x*y;}else if op==4 {v=x/y;}
   else if op==6 {yes=x<y;}else if op==7 {yes=x<=y;}else if op==8 {yes=x>y;}else if op==9 {yes=x>=y;}else if op==10 {yes=x==y;}else if op==11 {yes=x!=y;}
   if ty==1 {rq_ir_put_u64(memory,r,lane,ifx yes then 1 else 0);}else {rq_ir_put_f32(memory,r,lane,v);}
  } else {
   x:=rq_ir_u64(memory,a,lane);y:=rq_ir_u64(memory,b,lane);v:u64;
   sx:=cast,trunc(int)x;sy:=cast,trunc(int)y;
   if kind==3 {sx=cast(int)cast,trunc(s32)x;sy=cast(int)cast,trunc(s32)y;}
   signed:=kind==3 || kind==5;
   if op==1 {v=add_wrap(x,y);}else if op==2 {v=sub_wrap(x,y);}else if op==3 {v=mul_wrap(x,y);}
   else if op==4 || op==5 {
    if y==0 || (signed && sx==(-9223372036854775807-1) && sy==(-1)) {rq_ir_fail(m,RQStatus.unsupported);return r;}
    if signed {v=cast,trunc(u64)(ifx op==4 then sx/sy else sx%sy);}else {v=ifx op==4 then x/y else x%y;}
   } else if op==6 {yes=ifx signed then sx<sy else x<y;}
   else if op==7 {yes=ifx signed then sx<=sy else x<=y;}
   else if op==8 {yes=ifx signed then sx>sy else x>y;}
   else if op==9 {yes=ifx signed then sx>=sy else x>=y;}
   else if op==10 {yes=x==y;}else if op==11 {yes=x!=y;}
   else if op==12 {yes=x!=0 && y!=0;}else if op==13 {yes=x!=0 || y!=0;}
   else if op==14 {v=x&y;}else if op==15 {v=x|y;}else if op==16 {v=x^y;}
   else {
    width:=ifx kind==5 || kind==6 then 64 else 32;
    if y>=cast(u64)width {rq_ir_fail(m,RQStatus.unsupported);return r;}
    if op==17 {v=x<<cast(u32)y;}else if signed {v=cast,trunc(u64)(sx>>cast(u32)y);}else {v=x>>cast(u32)y;}
   }
   if ty==1 {v=ifx yes then 1 else 0;}rq_ir_put_u64(memory,r,lane,v);
  }
 }return r;
}
rq_ir_math :: (m:[]RQMachine,meta:[]int,memory:[]u32,fn:int,args:[]RQValue,mask:u32)->RQValue {
 if args.count<1 || args.count>2 || fn<1 || fn>9 || ((fn==9)!=(args.count==2)) {rq_ir_fail(m,RQStatus.unsupported);return RQValue.{};}
 for j:0..<args.count {if args[j].ty!=2 {rq_ir_fail(m,RQStatus.unsupported);return RQValue.{};}}
 r:=rq_ir_value(m,meta,memory,2);if m[0].status!=RQStatus.ok {return r;}
 active:=rq_active_lanes(mask);for active_index:0..<active.count {lane:=active.lanes[active_index];
  x:=rq_ir_f32(memory,args[0],lane);v:f32;
  if fn==1 {v=sin(x);}else if fn==2 {v=cos(x);}else if fn==3 {v=tan(x);}else if fn==4 {v=exp(x);}else if fn==5 {v=log(x);}else if fn==6 {v=sqrt(x);}else if fn==7 {v=floor(x);}else if fn==8 {v=abs(x);}else {v=pow(x,rq_ir_f32(memory,args[1],lane));}
  rq_ir_put_f32(memory,r,lane,v);
 }return r;
}
rq_ir_gpu_arity :: (fn:int)->int {
 if fn<1 || fn>18 {return -1;}
 counts:=[18]int.[0,3,4,4,5,5,4,4,4,1,1,1,1,1,1,1,1,0];return counts[fn-1];
}
rq_ir_gpu :: (m:[]RQMachine,meta:[]int,memory:[]u32,res:RQResources,fn:int,ty:int,args:[]RQValue,mask:u32)->RQValue {
 r:=rq_ir_value(m,meta,memory,ty);if m[0].status!=RQStatus.ok {return r;}
 arity:=rq_ir_gpu_arity(fn);if arity<0 {rq_ir_fail(m,RQStatus.unsupported);return r;}
 if args.count!=arity {rq_ir_fail(m,RQStatus.malformed);return r;}
 if m[0].stage==0 && (fn==1 || fn>=12) {rq_ir_fail(m,RQStatus.unsupported);return r;}
 if m[0].version==2 && fn>=15 {rq_ir_fail(m,RQStatus.unsupported);return r;}
 if fn==1 || fn==18 {
  if ty!=0 {rq_ir_fail(m,RQStatus.malformed);}
  else {m[0].discarded|=mask;if fn==1 {m[0].terminated|=mask;}}return r;
 }
 if fn>=12 {
  if args[0].ty!=2 || ty!=2 {rq_ir_fail(m,RQStatus.malformed);return r;}
  if mask==0 {return r;}if mask!=15 {rq_ir_fail(m,RQStatus.divergent);return r;}
  q:RQQuad;for lane:0..<4 {q.v[lane]=rq_ir_f32(memory,args[0],lane);}
  mode:=ifx fn>=15 then RQDerivative.fine else m[0].derivative;
  axis:=ifx fn==13 || fn==16 then 1 else 0;
  d:=ifx fn==14 || fn==17 then rq_fwidth(q,mode) else rq_derivative(q,axis,mode);
  for lane:0..<4 {rq_ir_put_f32(memory,r,lane,d.v[lane]);}return r;
 }
 return rq_ir_gpu_texture(m,meta,memory,res,fn,r,args,mask);
}
rq_ir_expr_inner :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,res:RQResources,f:RQFrame,mask:u32)->RQValue {
 op:=rq_ir_next(m,tree);if m[0].status!=RQStatus.ok {return RQValue.{};}
 if op==16 || op==17 {
  ty:=rq_ir_next(m,tree);r:=rq_ir_value(m,meta,memory,ty);if m[0].status!=RQStatus.ok {return r;}
  if op==16 {bits:=cast(u64)rq_ir_next(m,tree);if r.words==2 {bits|=cast(u64)rq_ir_next(m,tree)<<32;}
   for lane:0..<4 {rq_ir_put_u64(memory,r,lane,bits);}}
  return r;
 }
 if op==18 {
  id:=rq_ir_next(m,tree);v:=rq_ir_local(m,tree,meta,memory,f,id);r:=rq_ir_value(m,meta,memory,v.ty);
  if m[0].status==RQStatus.ok {rq_ir_transfer(memory,r,v,mask);}return r;
 }
 if op==19 {kind:=rq_ir_next(m,tree);a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);b:=rq_ir_expr(m,tree,meta,memory,res,f,mask);if m[0].status!=RQStatus.ok {return RQValue.{};}return rq_ir_binary(m,meta,memory,kind,a,b,mask&(m[0].terminated^15));}
 if op==20 || op==21 {
  a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);r:=rq_ir_value(m,meta,memory,a.ty);if m[0].status!=RQStatus.ok {return r;}
  active:=rq_active_lanes(mask);for active_index:0..<active.count {lane:=active.lanes[active_index];
   if op==21 {rq_ir_put_u64(memory,r,lane,ifx rq_ir_u64(memory,a,lane)==0 then 1 else 0);}
   else if a.ty==2 {rq_ir_put_f32(memory,r,lane,-rq_ir_f32(memory,a,lane));}
   else {rq_ir_put_u64(memory,r,lane,sub_wrap(cast(u64)0,rq_ir_u64(memory,a,lane)));}
  }return r;
 }
 if op==22 || op==23 || op==33 {
  fn:=rq_ir_next(m,tree);ty:int;if op==33 {ty=rq_ir_next(m,tree);}n:=rq_ir_next(m,tree);
  args:[128]RQValue;for j:0..<n {args[j]=rq_ir_expr(m,tree,meta,memory,res,f,mask);}
  if m[0].status!=RQStatus.ok {return RQValue.{};}
  if op==22 {return rq_ir_call(m,tree,meta,memory,res,fn,args[0..<n],mask);}
  if op==23 {return rq_ir_math(m,meta,memory,fn,args[0..<n],mask&(m[0].terminated^15));}
  return rq_ir_gpu(m,meta,memory,res,fn,ty,args[0..<n],mask&(m[0].terminated^15));
 }
 if op==24 {
  test:=rq_ir_expr(m,tree,meta,memory,res,f,mask);yes:=rq_ir_bool_mask(memory,test,mask);
  a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);b:=rq_ir_expr(m,tree,meta,memory,res,f,mask);
  if m[0].status!=RQStatus.ok {return RQValue.{};}if a.ty!=b.ty {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
  r:=rq_ir_value(m,meta,memory,a.ty);if m[0].status!=RQStatus.ok {return r;}
  rq_ir_transfer(memory,r,a,yes);rq_ir_transfer(memory,r,b,mask^yes);return r;
 }
 if op==25 {
  a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);field:=rq_ir_next(m,tree);v:=rq_ir_field(m,tree,meta,a.ty,field);
  r:=rq_ir_value(m,meta,memory,v.ty);if m[0].status!=RQStatus.ok {return r;}
  target:=rq_ir_value_words(memory,r);source:=rq_ir_value_words(memory,a);
  for lane:0..<4 {for j:0..<v.words {target[lane*v.words+j]=source[lane*a.words+v.at+j];}}return r;
 }
 if op==27 {place:=rq_ir_place(m,tree,meta,memory,res,f,mask);return rq_ir_load(m,tree,meta,memory,res,place,mask);}
 if op==29 || op==30 {
  ty:=rq_ir_next(m,tree);a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);return rq_ir_convert(m,meta,memory,ty,a,op==30,mask);
 }
 if op==31 {
  ty:=rq_ir_next(m,tree);n:=rq_ir_next(m,tree);
  r:=rq_ir_value(m,meta,memory,ty);if m[0].status!=RQStatus.ok {return r;}
  kind:=rq_ir_type(meta,ty,0);at:=rq_ir_type(meta,ty,1);offset:=0;
  for j:0..<n {
   a:=rq_ir_expr(m,tree,meta,memory,res,f,mask);
   if m[0].status!=RQStatus.ok {return r;}
   child:=cast(int)tree[at+(ifx kind==7 then 2+j*2 else 1)];
   if a.ty!=child {rq_ir_fail(m,RQStatus.malformed);return r;}
   target:=rq_ir_value_words(memory,r);source:=rq_ir_value_words(memory,a);
   for lane:0..<4 {for k:0..<a.words {target[lane*r.words+offset+k]=source[lane*a.words+k];}}offset+=a.words;
