  if m[0].status!=RQStatus.ok {return r;}
  if rq_ir_type(meta,view.ty,0)!=9 || rq_ir_type(meta,value.ty,0)!=8 {rq_ir_fail(m,RQStatus.malformed);return r;}
  va:=rq_ir_type(meta,value.ty,1);vt:=rq_ir_type(meta,view.ty,1);elem:=cast(int)tree[va+1];
