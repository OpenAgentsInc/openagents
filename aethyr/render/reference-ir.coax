  r.returned=mask;m[0].used=mark;return r;
 }
 if op==5 {if f.result.ty!=0 {rq_ir_fail(m,RQStatus.malformed);}r.returned=mask;return r;}
 if op==6 {
  has_else:=rq_ir_next(m,tree);
