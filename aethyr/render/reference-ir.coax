  if has_else==1 {other:=rq_ir_stmt(m,tree,meta,memory,res,f,mask^yes);r.returned|=other.returned;r.breaking|=other.breaking;r.continuing|=other.continuing;}
  return r;
 }
 if op==7 || op==8 {
