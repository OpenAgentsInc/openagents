rq_ir_call :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,res:RQResources,p:int,args:[]RQValue,mask:u32)->RQValue {
 // Prepared immutable tree transport already bounds every call index.
 // The shared execution nesting budget also bounds recursive calls.
 if args.count!=rq_ir_proc(meta,p,1) {rq_ir_fail(m,RQStatus.malformed);return RQValue.{};}
 ret:=rq_ir_proc(meta,p,0);result:=rq_ir_value(m,meta,memory,ret);mark:=m[0].used;
 locals:=rq_ir_proc(meta,p,2);localat:=m[0].used;
 if locals>memory.count-localat {rq_ir_fail(m,RQStatus.capacity);return result;}m[0].used+=locals;
 f:=RQFrame.{proc=p,locals=localat,result=result};
 for j:0..<locals {
  ty:=cast(int)tree[rq_ir_proc(meta,p,3)+j];v:=rq_ir_value(m,meta,memory,ty);
  if m[0].status!=RQStatus.ok {return result;}memory[localat+j]=cast(u32)v.at;
  if j<args.count {if args[j].ty!=ty {rq_ir_fail(m,RQStatus.malformed);return result;}rq_ir_transfer(memory,v,args[j],mask);}
 }
 caller:=m[0].at;private_mark:=m[0].private_count;m[0].at=rq_ir_proc(meta,p,4);
 flow:=rq_ir_stmt(m,tree,meta,memory,res,f,mask);
