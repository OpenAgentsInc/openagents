   else {child:=cast(int)tree[at+1];b:=rq_ir_buffer_view(m,res,handle,rq_ir_type(meta,child,3));if m[0].status!=RQStatus.ok {return r;}n=b.count;}
  } else {rq_ir_fail(m,RQStatus.malformed);return r;}
