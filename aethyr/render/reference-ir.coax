rq_ir_buffer_view :: (m:[]RQMachine,res:RQResources,index:int,element_bytes:int)->RQBuffer {
 if cast,trunc(u64)index>=cast(u64)res.buffers.count {rq_ir_fail(m,RQStatus.resource);return RQBuffer.{};}
