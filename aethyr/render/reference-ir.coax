 if op==1 {
  n:=rq_ir_next(m,tree);
  for j:0..<n {
   child:=rq_ir_stmt(m,tree,meta,memory,res,f,mask&((r.returned|r.breaking|r.continuing)^15));
   r.returned|=child.returned;r.breaking|=child.breaking;r.continuing|=child.continuing;
   if m[0].status!=RQStatus.ok {return r;}
  }return r;
 }
 if op==2 {value:=rq_ir_expr(m,tree,meta,memory,res,f,mask);m[0].used=mark;return r;}
 if op==3 {
  place:=rq_ir_place(m,tree,meta,memory,res,f,mask);value:=rq_ir_expr(m,tree,meta,memory,res,f,mask);
