}
rq_ir_run :: (program:RQProgram,tree:[]u32,meta:[]int,inputs:[]u32,res:RQResources,memory:[]u32,outputs:[]u32,stage:int,budget:int,coverage:u32,derivative:RQDerivative)->RQExecution {
 if program.status!=RQStatus.ok {return RQExecution.{status=program.status};}
 if meta.count<RQ_IR_META || tree.count!=program.tree_words || program.types<6 || program.types>RQ_IR_TYPES || program.procs<1 || program.procs>RQ_IR_PROCS {return RQExecution.{status=RQStatus.malformed};}
 if budget<1 || budget>100000000 || coverage>15 {return RQExecution.{status=RQStatus.resource};}
 p:=rq_ir_entry(program,tree,meta,stage);if p<0 {return RQExecution.{status=RQStatus.resource};}
 n:=rq_ir_proc(meta,p,1);ret:=rq_ir_proc(meta,p,0);words:=4*rq_ir_type(meta,ret,2);
 if inputs.count!=rq_ir_parameter_words(program,tree,meta,stage) || outputs.count<words {return RQExecution.{status=RQStatus.capacity};}
 ms:=[1]RQMachine.[RQMachine.{version=program.version,budget=budget,types=program.types,procs=program.procs,stage=stage,derivative=derivative}];args:[128]RQValue;at:=0;
 for j:0..<n {
  ty:=cast(int)tree[rq_ir_proc(meta,p,7)+j];v:=rq_ir_value(ms[..],meta,memory,ty);args[j]=v;
  if ms[0].status!=RQStatus.ok {return RQExecution.{status=ms[0].status};}
  for k:0..<v.words*4 {memory[v.at+k]=inputs[at+k];}at+=v.words*4;
 }
 result:=rq_ir_call(ms[..],tree,meta,memory,res,p,args[0..<n],15);
 if ms[0].status!=RQStatus.ok {return RQExecution.{status=ms[0].status,steps=ms[0].steps,discarded=ms[0].discarded};}
 for k:0..<words {outputs[k]=memory[result.at+k];}
 return RQExecution.{steps=ms[0].steps,discarded=ms[0].discarded,publish_mask=coverage&(ms[0].discarded^15),output_words=words};
}

rq_ir_lod :: (t:RQTexture,u:RQQuad,v:RQQuad,lane:int,mode:RQDerivative,bias:f32)->f32 {
 dx:=rq_derivative(u,0,mode);dy:=rq_derivative(u,1,mode);vx:=rq_derivative(v,0,mode);vy:=rq_derivative(v,1,mode);
 w:=cast(f32)t.levels[0].width;h:=cast(f32)t.levels[0].height;
 ax:=dx.v[lane]*w;ay:=vx.v[lane]*h;bx:=dy.v[lane]*w;by:=vy.v[lane]*h;
 return rq_footprint_lod(ax*ax+ay*ay,bx*bx+by*by,bias);
}
rq_ir_color :: (memory:[]u32,r:RQValue,lane:int,color:RQColor) {
 at:=r.at+lane*r.words;memory[at]=f32_bits(color.r);
 if r.words==4 {memory[at+1]=f32_bits(color.g);memory[at+2]=f32_bits(color.b);memory[at+3]=f32_bits(color.a);}
}
rq_ir_gpu_texture :: (m:[]RQMachine,meta:[]int,memory:[]u32,res:RQResources,fn:int,r:RQValue,args:[]RQValue,mask:u32)->RQValue {
 // The registry dispatcher has already selected texture operations2..11.
 if rq_ir_type(meta,args[0].ty,0)!=10 || args[0].words!=1 || (fn<=7 && r.words!=4) || (fn>=8 && r.words!=1) {rq_ir_fail(m,RQStatus.malformed);return r;}
 if m[0].version==2 && (fn==10 || fn==11) && rq_ir_type(meta,args[0].ty,4)==1 {rq_ir_fail(m,RQStatus.unsupported);return r;}
 implicit:=fn==2 || fn==4 || fn==6;
 if implicit && m[0].stage==0 {rq_ir_fail(m,RQStatus.unsupported);return r;}
 if implicit && mask!=0 && mask!=15 {rq_ir_fail(m,RQStatus.divergent);return r;}
 if fn<=6 || fn==9 {if args[1].words!=1 || args[2].words!=2 {rq_ir_fail(m,RQStatus.malformed);return r;}}
 u:RQQuad;v:RQQuad;
 if implicit {for lane:0..<4 {at:=args[2].at+lane*args[2].words;u.v[lane]=f32_from_bits(memory[at]);v.v[lane]=f32_from_bits(memory[at+1]);}}
 active:=rq_active_lanes(mask);for active_index:0..<active.count {lane:=active.lanes[active_index];
  image:int;
  // Resource handles occupy one word and have image/sampler nominal types,
  // rather than integer types; their carrier is read directly.
  image=cast(int)memory[args[0].at+lane];
  if image>=res.textures.count {rq_ir_fail(m,RQStatus.resource);return r;}
  t:=res.textures[image];texture:=rq_texture_status(t);if texture!=RQStatus.ok {rq_ir_fail(m,texture);return r;}
  if fn==10 || fn==11 {size:=ifx fn==10 then t.levels[0].width else t.levels[0].height;rq_ir_put_u64(memory,r,lane,cast(u64)size);}
  else if fn==7 || fn==8 {
   x:=rq_ir_integer(m,meta,memory,args[1],lane);y:=rq_ir_integer(m,meta,memory,args[2],lane);level:=rq_ir_integer(m,meta,memory,args[3],lane);
   if m[0].status!=RQStatus.ok {return r;}
   if level<0 || level>=t.levels.count {rq_ir_fail(m,RQStatus.resource);return r;}lev:=t.levels[level];
   if x<0 || x>=lev.width || y<0 || y>=lev.height || (fn==8 && !t.depth) {rq_ir_fail(m,RQStatus.resource);return r;}
   color:=t.texels[lev.offset+y*lev.width+x];rq_ir_color(memory,r,lane,color);
  } else {
   sampler:=cast(int)memory[args[1].at+lane];
   if sampler>=res.samplers.count {rq_ir_fail(m,RQStatus.resource);return r;}s:=res.samplers[sampler];
   at:=args[2].at+lane*args[2].words;cu:=f32_from_bits(memory[at]);cv:=f32_from_bits(memory[at+1]);layer:=0;lod:f32=0;
   if fn==4 || fn==5 || fn==6 {layer=rq_ir_integer(m,meta,memory,args[3],lane);}
   if fn==3 {lod=rq_ir_f32(memory,args[3],lane);}else if fn==5 {lod=rq_ir_f32(memory,args[4],lane);}
   if implicit {bias:=ifx fn==6 then rq_ir_f32(memory,args[4],lane) else 0.0f32;lod=rq_ir_lod(t,u,v,lane,m[0].derivative,bias);}
   sample:RQSample;
   if fn==9 {sample=rq_sample_compare(t,s,cu,cv,0,0,rq_ir_f32(memory,args[3],lane));}
   else {sample=rq_sample_level(t,s,cu,cv,layer,lod);}
   if sample.status!=RQStatus.ok {rq_ir_fail(m,sample.status);return r;}rq_ir_color(memory,r,lane,sample.color);
  }
 }return r;
}

rq_ir_expr :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,res:RQResources,f:RQFrame,mask:u32)->RQValue {
 if m[0].nesting>=RQ_IR_NESTING {rq_ir_fail(m,RQStatus.budget);return RQValue.{};}
 m[0].nesting+=1;r:=rq_ir_expr_inner(m,tree,meta,memory,res,f,mask&(m[0].terminated^15));m[0].nesting-=1;return r;
}

rq_ir_stmt :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,res:RQResources,f:RQFrame,mask:u32)->RQFlow {
 if m[0].nesting>=RQ_IR_NESTING {rq_ir_fail(m,RQStatus.budget);return RQFlow.{};}
 m[0].nesting+=1;r:=rq_ir_stmt_inner(m,tree,meta,memory,res,f,mask&(m[0].terminated^15));m[0].nesting-=1;return r;
}

rq_ir_place :: (m:[]RQMachine,tree:[]u32,meta:[]int,memory:[]u32,res:RQResources,f:RQFrame,mask:u32)->RQPlace {
 if m[0].nesting>=RQ_IR_NESTING {rq_ir_fail(m,RQStatus.budget);return RQPlace.{};}
 m[0].nesting+=1;r:=rq_ir_place_inner(m,tree,meta,memory,res,f,mask&(m[0].terminated^15));m[0].nesting-=1;return r;
}

// Structural admission follows node boundaries, never scans arbitrary words
// for opcode-looking constants. The input is the compiler's checked typed tree;
// this pass bounds its transport/control shape and enforces the op registry.
rq_ir_shape_place :: (m:[]RQMachine,tree:[]u32,meta:[]int) {
 if m[0].nesting>=RQ_IR_SYNTAX_DEPTH {rq_ir_fail(m,RQStatus.budget);return;}m[0].nesting+=1;
 op:=rq_ir_next(m,tree);
 if op==40 {local:=rq_ir_next(m,tree);}
 else if op==41 {rq_ir_shape_place(m,tree,meta);field:=rq_ir_next(m,tree);}
 else if op==42 {rq_ir_shape_place(m,tree,meta);rq_ir_shape_expr(m,tree,meta);}
 else {rq_ir_fail(m,RQStatus.malformed);}
 m[0].nesting-=1;
}
rq_ir_shape_expr :: (m:[]RQMachine,tree:[]u32,meta:[]int) {
 if m[0].nesting>=RQ_IR_SYNTAX_DEPTH {rq_ir_fail(m,RQStatus.budget);return;}m[0].nesting+=1;
 rq_ir_shape_expr_inner(m,tree,meta);m[0].nesting-=1;
}
rq_ir_shape_expr_inner :: (m:[]RQMachine,tree:[]u32,meta:[]int) {
 op:=rq_ir_next(m,tree);if m[0].status!=RQStatus.ok {return;}
 if op==16 || op==17 || op==29 || op==30 || op==31 {
  ty:=rq_ir_next(m,tree);if ty>=m[0].types {rq_ir_fail(m,RQStatus.malformed);return;}
  if op==16 {
   kind:=rq_ir_type(meta,ty,0);if kind<1 || kind>6 {rq_ir_fail(m,RQStatus.malformed);return;}
   low:=rq_ir_next(m,tree);if kind==5 || kind==6 {high:=rq_ir_next(m,tree);}return;
  }
  if op==17 {return;}
  if op==29 || op==30 {rq_ir_shape_expr(m,tree,meta);return;}
  kind:=rq_ir_type(meta,ty,0);if kind!=7 && kind!=8 {rq_ir_fail(m,RQStatus.unsupported);return;}
  at:=rq_ir_type(meta,ty,1);expected:=cast(int)tree[at+(ifx kind==7 then 1 else 2)];
  count:=rq_ir_next(m,tree);if count!=expected {rq_ir_fail(m,RQStatus.malformed);return;}
  for j:0..<count {rq_ir_shape_expr(m,tree,meta);if m[0].status!=RQStatus.ok {return;}}return;
 }
 if op==18 {local:=rq_ir_next(m,tree);return;}
 if op==19 {kind:=rq_ir_next(m,tree);if kind<1 || kind>18 {rq_ir_fail(m,RQStatus.unsupported);return;}rq_ir_shape_expr(m,tree,meta);rq_ir_shape_expr(m,tree,meta);return;}
 if op==20 || op==21 {rq_ir_shape_expr(m,tree,meta);return;}
 if op==22 || op==23 || op==33 {
  fn:=rq_ir_next(m,tree);
  if op==33 {
   ty:=rq_ir_next(m,tree);if ty>=m[0].types {rq_ir_fail(m,RQStatus.malformed);return;}
   if rq_ir_gpu_arity(fn)<0 || (m[0].version==2 && fn>=15) {rq_ir_fail(m,RQStatus.unsupported);return;}
  }
  n:=rq_ir_next(m,tree);if n>128 {rq_ir_fail(m,RQStatus.capacity);return;}
  if op==22 && fn>=m[0].procs {rq_ir_fail(m,RQStatus.malformed);return;}
  if op==23 && (fn<1 || fn>9) {rq_ir_fail(m,RQStatus.unsupported);return;}
  if op==22 && n!=rq_ir_proc(meta,fn,1) {rq_ir_fail(m,RQStatus.malformed);return;}
  if op==23 && n!=(ifx fn==9 then 2 else 1) {rq_ir_fail(m,RQStatus.unsupported);return;}
  if op==33 && n!=rq_ir_gpu_arity(fn) {rq_ir_fail(m,RQStatus.malformed);return;}
  for j:0..<n {rq_ir_shape_expr(m,tree,meta);if m[0].status!=RQStatus.ok {return;}}return;
 }
 if op==24 {rq_ir_shape_expr(m,tree,meta);rq_ir_shape_expr(m,tree,meta);rq_ir_shape_expr(m,tree,meta);return;}
 if op==25 {rq_ir_shape_expr(m,tree,meta);field:=rq_ir_next(m,tree);return;}
 if op==27 || op==32 {rq_ir_shape_place(m,tree,meta);return;}
 rq_ir_fail(m,RQStatus.unsupported);
}
rq_ir_shape_stmt :: (m:[]RQMachine,tree:[]u32,meta:[]int) {
 if m[0].nesting>=RQ_IR_SYNTAX_DEPTH {rq_ir_fail(m,RQStatus.budget);return;}m[0].nesting+=1;
 rq_ir_shape_stmt_inner(m,tree,meta);m[0].nesting-=1;
}
rq_ir_shape_stmt_inner :: (m:[]RQMachine,tree:[]u32,meta:[]int) {
 op:=rq_ir_next(m,tree);if m[0].status!=RQStatus.ok {return;}
 if op==1 {
  n:=rq_ir_next(m,tree);if !rq_ir_block_count_ok(n) {rq_ir_fail(m,RQStatus.capacity);return;}
  for j:0..<n {rq_ir_shape_stmt(m,tree,meta);if m[0].status!=RQStatus.ok {return;}}return;
 }
 if op==2 || op==4 {rq_ir_shape_expr(m,tree,meta);return;}
 if op==3 {rq_ir_shape_place(m,tree,meta);rq_ir_shape_expr(m,tree,meta);return;}
 if op==5 || op==9 || op==10 {return;}
 if op==6 {
  other:=rq_ir_next(m,tree);if other>1 {rq_ir_fail(m,RQStatus.malformed);return;}
  rq_ir_shape_expr(m,tree,meta);rq_ir_shape_stmt(m,tree,meta);if other==1 {rq_ir_shape_stmt(m,tree,meta);}return;
 }
 if op==7 {rq_ir_shape_expr(m,tree,meta);rq_ir_shape_stmt(m,tree,meta);return;}
 if op==8 {local:=rq_ir_next(m,tree);rq_ir_shape_expr(m,tree,meta);rq_ir_shape_expr(m,tree,meta);rq_ir_shape_stmt(m,tree,meta);return;}
 if op==11 {view:=rq_ir_next(m,tree);array:=rq_ir_next(m,tree);return;}
 rq_ir_fail(m,RQStatus.unsupported);
}

#load "tests/reference-ir-scalar-checks.coax";

#load "tests/reference-ir-admission-checks.coax";

#load "tests/reference-ir-convert-checks.coax";

#load "tests/reference-ir-storage-checks.coax";

#load "tests/reference-ir-run-checks.coax";

#load "tests/reference-ir-gpu-checks.coax";
#load "tests/reference-ir-type-checks.coax";
#load "tests/reference-ir-shape-checks.coax";
// The syntax envelope is independent of the runtime work allowance.
rq_ir_block_count_ok :: (count:int)->bool {return cast,trunc(u64)count<=1000000;}
#load "tests/reference-ir-arena-checks.coax";

#load "tests/reference-ir-transport-extra-checks.coax";
#load "tests/reference-ir-prepare-budget-checks.coax";

#load "tests/reference-ir-control-checks.coax";

#load "tests/reference-ir-texture-extra-checks.coax";

#load "tests/reference-ir-private-checks.coax";

#load "tests/reference-ir-statement-checks.coax";

#load "tests/reference-ir-array-query-checks.coax";

#load "tests/reference-ir-call-checks.coax";

#load "tests/reference-ir-place-checks.coax";

#load "tests/reference-ir-value-extra-checks.coax";

#load "tests/reference-ir-flow-extra-checks.coax";
