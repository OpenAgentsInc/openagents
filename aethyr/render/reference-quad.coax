// Four-lane shader execution primitives. Scalar shader-library bodies do not
// supply derivatives, discard publication or mip selection; this context does.
#module "aethyr.render.reference.quad";
#load "filter-profile.coax";
#authority;
RQStatus :: enum u8 {ok; malformed; capacity; unsupported; budget; resource; divergent;}
RQDerivative :: enum u8 {fine; coarse;}
RQAddress :: enum u8 {clamp; repeat; mirror;}
RQCompare :: enum u8 {none; never; less; equal; less_equal; greater; not_equal; greater_equal; always;}
RQQuad :: struct {v:[4]f32;}
RQColor :: struct {r:f32;g:f32;b:f32;a:f32;}
RQControl :: struct {coverage:u32=15;discarded:u32;}
RQMip :: struct {width:int;height:int;offset:int;}
RQTexture :: struct {levels:[]RQMip;layers:int;texels:[]RQColor;depth:bool;storage:RQStorageFormat;}
RQSampler :: struct {
 address_u:RQAddress;address_v:RQAddress;min_linear:bool;mag_linear:bool;mip_linear:bool;
 lod_min:f32;lod_max:f32=32;compare:RQCompare;max_anisotropy:int=1;precision:RQFilterProfile;
}
RQSample :: struct {status:RQStatus;color:RQColor;}
RQSamples :: struct {status:RQStatus;colors:[4]RQColor;}
#load "tests/reference-quad-checks.coax";
#load "tests/reference-filter-checks.coax";

rq_derivative :: (q:RQQuad,axis:int,mode:RQDerivative)->RQQuad {
 r:RQQuad;if axis!=0 && axis!=1 {return r;}
 for lane:0..<4 {
  pair:=ifx mode==RQDerivative.coarse then 0 else (ifx axis==0 then (lane/2)*2 else lane%2);
  other:=pair+(ifx axis==0 then 1 else 2);
  r.v[lane]=q.v[other]-q.v[pair];
 }return r;
}
rq_fwidth :: (q:RQQuad,mode:RQDerivative)->RQQuad {
 x:=rq_derivative(q,0,mode);y:=rq_derivative(q,1,mode);r:RQQuad;
 for k:0..<4 {r.v[k]=abs(x.v[k])+abs(y.v[k]);}return r;
}
rq_discard :: (q:RQControl,lanes:u32)->RQControl {r:=q;r.discarded|=lanes&15;return r;}
rq_publish_mask :: (q:RQControl)->u32 {return q.coverage&15&(q.discarded^15);}
rq_helper_mask :: (q:RQControl)->u32 {return 15;}
rq_finite :: (v:f32)->bool {return v==v && v>=-3.4028234663852886e38f32 && v<=3.4028234663852886e38f32;}
rq_clamp :: (x:f32,a:f32,b:f32)->f32 {if x<a{return a;}if x>b{return b;}return x;}
rq_mix_color :: (a:RQColor,b:RQColor,t:f32)->RQColor {
 return RQColor.{r=a.r+(b.r-a.r)*t,g=a.g+(b.g-a.g)*t,b=a.b+(b.b-a.b)*t,a=a.a+(b.a-a.a)*t};
}
rq_texture_status :: (t:RQTexture)->RQStatus {
 if t.layers<1 || t.levels.count<1 {return RQStatus.resource;}
 if t.layers>2048 || t.levels.count>32 {return RQStatus.capacity;}
 w:=t.levels[0].width;h:=t.levels[0].height;end:=0;
 if w<1 || h<1 {return RQStatus.resource;}
 if w>16384 || h>16384 {return RQStatus.capacity;}
 for n:0..<t.levels.count {
  m:=t.levels[n];
  if m.width!=w || m.height!=h || m.offset<end {return RQStatus.resource;}
  span:=w*h*t.layers;if span>t.texels.count-m.offset {return RQStatus.resource;}
  end=m.offset+span;
  if n+1<t.levels.count && w==1 && h==1 {return RQStatus.resource;}
  w=w/2+(ifx w==1 then 1 else 0);h=h/2+(ifx h==1 then 1 else 0);
 }
 return RQStatus.ok;
}
rq_texture_ok :: (t:RQTexture)->bool {return rq_texture_status(t)==RQStatus.ok;}
rq_sampler_status :: (s:RQSampler)->RQStatus {
 // Enum variants are checked by Coax at construction; native callers supply
 // the manifest's typed sampler records, not arbitrary byte tags.
 if !rq_filter_limits(s.precision).ok {return RQStatus.unsupported;}
 if !rq_finite(s.lod_min) || !rq_finite(s.lod_max) || s.lod_min<0 || s.lod_max<s.lod_min || s.lod_max>32 {return RQStatus.resource;}
 // Anisotropic filtering has a separate numerical contract; this exact
 // isotropic profile refuses it instead of silently pretending it is linear.
 if s.max_anisotropy!=1 {return RQStatus.unsupported;}
 return RQStatus.ok;
}
rq_address :: (i:int,n:int,mode:RQAddress)->int {
 if mode==RQAddress.clamp {
  if i>=n {return n-1;}
  // For negative i the exact f64 cancellation is zero. Otherwise i<n<=16384,
  // so this positive-part identity is an exact integer, including i==0.
  return cast(int)((cast(f64)i+abs(cast(f64)i))*0.5);
 }
 period:=ifx mode==RQAddress.mirror then n*2 else n;
 j:=i%period;if j<0 {j+=period;}
 if j>=n {return period-1-j;}return j;
}
rq_compare :: (actual:f32,ref:f32,mode:RQCompare)->f32 {
 yes:=false;
 if mode==RQCompare.less {yes=ref<actual;}
 else if mode==RQCompare.equal {yes=ref==actual;}
 else if mode==RQCompare.less_equal {yes=ref<=actual;}
 else if mode==RQCompare.greater {yes=ref>actual;}
 else if mode==RQCompare.not_equal {yes=ref!=actual;}
 else if mode==RQCompare.greater_equal {yes=ref>=actual;}
 else if mode==RQCompare.always {yes=true;}
 return ifx yes then 1.0f32 else 0.0f32;
}
rq_texel :: (t:RQTexture,s:RQSampler,level:int,layer:int,x:int,y:int,comparison:bool,ref:f32)->RQColor {
 m:=t.levels[level];ix:=rq_address(x,m.width,s.address_u);iy:=rq_address(y,m.height,s.address_v);
 c:=t.texels[m.offset+layer*m.width*m.height+iy*m.width+ix];
 if comparison {v:=rq_compare(c.r,ref,s.compare);return RQColor.{r=v,g=v,b=v,a=v};}return c;
}
rq_mip_sample :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,level:int,linear:bool,comparison:bool,ref:f32)->RQColor {
 m:=t.levels[level];fx:=u*cast(f32)m.width-0.5f32;fy:=v*cast(f32)m.height-0.5f32;
 if !linear {return rq_texel(t,s,level,layer,cast(int)floor(fx+0.5f32),cast(int)floor(fy+0.5f32),comparison,ref);}
 x:=floor(fx);y:=floor(fy);tx:=fx-x;ty:=fy-y;ix:=cast(int)x;iy:=cast(int)y;
 a:=rq_mix_color(rq_texel(t,s,level,layer,ix,iy,comparison,ref),rq_texel(t,s,level,layer,ix+1,iy,comparison,ref),tx);
 b:=rq_mix_color(rq_texel(t,s,level,layer,ix,iy+1,comparison,ref),rq_texel(t,s,level,layer,ix+1,iy+1,comparison,ref),tx);
 return rq_mix_color(a,b,ty);
}
rq_sample :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,lod:f32,comparison:bool,ref:f32)->RQSample {
 status:=rq_sampler_status(s);if status!=RQStatus.ok {return RQSample.{status=status};}
 texture:=rq_texture_status(t);if texture!=RQStatus.ok {return RQSample.{status=texture};}
 if !rq_finite(u) || !rq_finite(v) || abs(u)>1000000000 || abs(v)>1000000000 ||
  !rq_finite(lod) || layer<0 || layer>=t.layers || (comparison && (!t.depth || s.compare==RQCompare.none || !rq_finite(ref))) {return RQSample.{status=RQStatus.resource};}
 bounded:=rq_clamp(lod,s.lod_min,s.lod_max);last:=t.levels.count-1;
 bounded=rq_clamp(bounded,0,cast(f32)last);
 linear:=ifx lod<=0 then s.mag_linear else s.min_linear;
 if s.precision!=RQFilterProfile.analytic {return rq_sample_measured(t,s,u,v,layer,bounded,linear,comparison);}
 if !s.mip_linear {level:=cast(int)floor(bounded+0.5f32);return RQSample.{color=rq_mip_sample(t,s,u,v,layer,level,linear,comparison,ref)};}
 low:=cast(int)floor(bounded);high:=ifx low<last then low+1 else low;
 a:=rq_mip_sample(t,s,u,v,layer,low,linear,comparison,ref);
 b:=rq_mip_sample(t,s,u,v,layer,high,linear,comparison,ref);
 return RQSample.{color=rq_mix_color(a,b,bounded-cast(f32)low)};
}
RQFilterBytes :: struct {status:RQStatus;v:[4]f64;}
// The physical decoder supplies UNORM8 values. Recovering their exact byte
// codes before filtering avoids a second normalized-f32 rounding at output
// ties. The profile's weighted byte sums are exact binary fractions.
rq_filter_mip :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,level:int,limits:RQFilterLimits)->RQFilterBytes {
 m:=t.levels[level];fx:=u*cast(f32)m.width-0.5f32;fy:=v*cast(f32)m.height-0.5f32;
 x:=floor(fx);y:=floor(fy);scale:=cast(f64)limits.axis;
 tx:=floor(cast(f64)(fx-x)*scale+0.5)/scale;ty:=floor(cast(f64)(fy-y)*scale+0.5)/scale;
 weights:=rq_filter_weights(tx,ty,limits.joint);r:RQFilterBytes;
 for k:0..<4 {
  c:=rq_texel(t,s,level,layer,cast(int)x+k%2,cast(int)y+k/2,false,0);
  components:=[4]f32.[c.r,c.g,c.b,c.a];
  for ch:0..<4 {
   value:=components[ch];if !rq_finite(value) || value<0 || value>1 {return RQFilterBytes.{status=RQStatus.resource};}
   r.v[ch]+=floor(cast(f64)value*255+0.5)*weights.v[k];
  }
 }return r;
}
rq_sample_measured :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,lod:f32,linear:bool,comparison:bool)->RQSample {
 if t.storage!=RQStorageFormat.unorm8 || !linear || !s.mip_linear || comparison {return RQSample.{status=RQStatus.unsupported};}
 limits:=rq_filter_limits(s.precision);
 if limits.integer_lod && lod!=floor(lod) {return RQSample.{status=RQStatus.unsupported};}
 bounded:=cast(f64)lod;if limits.lod!=0 {bounded=floor(bounded*cast(f64)limits.lod)/cast(f64)limits.lod;}
 low:=cast(int)floor(bounded);last:=t.levels.count-1;high:=ifx low<last then low+1 else low;
 a:=rq_filter_mip(t,s,u,v,layer,low,limits);if a.status!=RQStatus.ok {return RQSample.{status=a.status};}
 b:=rq_filter_mip(t,s,u,v,layer,high,limits);if b.status!=RQStatus.ok {return RQSample.{status=b.status};}
 amount:=bounded-cast(f64)low;values:[4]f32;
 for ch:0..<4 {value:=a.v[ch]+(b.v[ch]-a.v[ch])*amount;values[ch]=cast(f32)(floor(value*cast(f64)limits.units+0.5)/cast(f64)limits.result);}
 return RQSample.{color=RQColor.{r=values[0],g=values[1],b=values[2],a=values[3]}};
}
rq_sample_level :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,lod:f32)->RQSample {return rq_sample(t,s,u,v,layer,lod,false,0);}
rq_sample_compare :: (t:RQTexture,s:RQSampler,u:f32,v:f32,layer:int,lod:f32,ref:f32)->RQSample {return rq_sample(t,s,u,v,layer,lod,true,ref);}
// Squared footprint axes are nonnegative f32. The f64 identity avoids an
// unobservable equality branch and returns their exact f32 maximum, including
// tiny subnormals, without overflowing the sum at f32's finite upper bound.
rq_footprint_lod :: (x:f32,y:f32,bias:f32)->f32 {
 rho:=cast(f32)((cast(f64)x+cast(f64)y+abs(cast(f64)x-cast(f64)y))*0.5);
 if rho==0 {return -1;}
 return 0.5f32*log(rho)/log(2.0f32)+bias;
}
rq_sample_quad :: (t:RQTexture,s:RQSampler,u:RQQuad,v:RQQuad,layer:int,bias:f32,mode:RQDerivative)->RQSamples {
 texture:=rq_texture_status(t);if texture!=RQStatus.ok {return RQSamples.{status=texture};}
 if !rq_finite(bias) {return RQSamples.{status=RQStatus.resource};}
 dx:=rq_derivative(u,0,mode);dy:=rq_derivative(u,1,mode);vx:=rq_derivative(v,0,mode);vy:=rq_derivative(v,1,mode);
 w:=cast(f32)t.levels[0].width;h:=cast(f32)t.levels[0].height;r:RQSamples;
 for k:0..<4 {
  ax:=dx.v[k]*w;ay:=vx.v[k]*h;bx:=dy.v[k]*w;by:=vy.v[k]*h;
  lod:=rq_footprint_lod(ax*ax+ay*ay,bx*bx+by*by,bias);
  sample:=rq_sample_level(t,s,u.v[k],v.v[k],layer,lod);
  if sample.status!=RQStatus.ok {return RQSamples.{status=sample.status};}r.colors[k]=sample.color;
 }
 return r;
}
