// SceneLights: the block a world fills each frame for the character pass (coax/web/host.js, the
// "character pass" section; docs/verse/2026-11-06-native-hero-characters.md, Design 3 and 4). The
// character shader (aethyr/render/character.coax) reads it as its uniform block, so a detailed
// character is lit by the world's own key light, sky, lamps, haze and weather, drawn through the
// world's own camera into the world's depth buffer, and cast into and read from the world's shadow
// map. Floats, at these offsets:
//
//   0..1     the target's width and height (pixels)
//   2        the share of hair strands drawn (negative: the sample's blonde groom); the character
//            runtime fills it from the head's size on screen
//   8..10    the eye; 12..14 the camera's right, 15 its horizontal focal scale; 16..18 its up,
//            19 its vertical focal scale; 20..22 the way it looks
//   24..26   toward the key light (the sun or the moon)
//   104..106 the character's feet; 108, 109 the cosine and sine of its heading; 111 1 when the face's
//            morphs play (the character runtime fills it); 112 0 (Valley Lab's TF0290 rig is off);
//            114 the head's material profile (0 and up: the Slay profile)
//   136..151 the world's clip rows: clip = rows * (x, y, z, 1), the matrix the world's own geometry
//            uses, so the depth tests agree both ways
//   152..163 the shadow map's rows: (x, y, z) = rows * (x, y, z, 1), x and y -1 to 1 across the map,
//            z its depth; the map is read at (0.5 + x / 2, 0.5 - y / 2), as the world's casters write it
//   164..167 1 when the map holds this frame's casters, the filter's reach (map uv), the depth bias,
//            the normal offset (m)
//   168..171 the key light's colour times its strength (rgb)
//   172..175 the sky's ambient (rgb); 176..179 the ground's ambient (rgb)
//   180..183 the haze's hue (rgb) and its cap
//   184..187 the haze: the eye's base height (m), where it starts (m), its density (1/m), its falloff (m)
//   188..191 the key light seen through the haze (rgb), 1 when it is added (the moon) rather than mixed
//   192..195 how wet surfaces are (0 to 1), rain, 0, 0
//   196..199 how many point lights, the aux distance scale (m: aux.g is the distance over it), 0, 0
// The pass writes linear light for the world's post pass to tone (Everglade's light and aux
// targets), as the world's own geometry does.
//   200..263 up to 8 point lights, two rows each: x, y, z, reach (m); r, g, b, strength
//
// The first 128 floats keep Valley Lab's slots, the ones Echo's shared shading reads (the camera,
// the key's direction, her feet and heading, the hair's share), so the Valley page's own uniform
// block is already this block's first half.
//   coax/bin/coax test aethyr/render/scene-lights.coax
#module "aethyr.render.scenelights";

SCL_FLOATS :: 272;     // 68 vec4f rows (host.js sizes the uniform buffer from coaxial_character_v1's caller)
SCL_SIZE :: 0;
SCL_HAIR :: 2;
SCL_EYE :: 8;
SCL_RIGHT :: 12;
SCL_FOCAL_X :: 15;
SCL_UP :: 16;
SCL_FOCAL_Y :: 19;
SCL_FORWARD :: 20;
SCL_KEY_DIR :: 24;
SCL_AT :: 104;
SCL_HEADING :: 108;
SCL_MORPH :: 111;
SCL_RIG :: 112;
SCL_PROFILE :: 114;
SCL_CLIP :: 136;
SCL_SHADOW :: 152;
SCL_SHADOW_INFO :: 164;
SCL_KEY :: 168;
SCL_SKY :: 172;
SCL_GROUND :: 176;
SCL_HAZE_HUE :: 180;
SCL_HAZE :: 184;
SCL_GLOW :: 188;
SCL_LOOK :: 192;
SCL_OUT :: 196;
SCL_LIGHTS :: 200;
SCL_MAX_LIGHTS :: 8;

SclPoint :: struct { x: f32; y: f32; z: f32; }

scl_put3 :: (b: [] f32, at: int, x: f32, y: f32, z: f32) { b[at] = x; b[at + 1] = y; b[at + 2] = z; }

// The camera from a world's clip rows (clip.x = fx (right . (p - eye)), clip.y = fy (up . (p - eye)),
// clip.w = forward . (p - eye)): the shared shading reads the eye, the axes and the focal scales.
scl_camera :: (b: [] f32, rows: [] f32, eye: SclPoint, width: f32, height: f32) {
  for k: 0..<16 { b[SCL_CLIP + k] = rows[k]; }
  fx := sqrt(rows[0] * rows[0] + rows[1] * rows[1] + rows[2] * rows[2]);
  fy := sqrt(rows[4] * rows[4] + rows[5] * rows[5] + rows[6] * rows[6]);
  fx = ifx fx > 0.000001 then fx else 1.0f32; fy = ifx fy > 0.000001 then fy else 1.0f32;
  b[SCL_SIZE] = width; b[SCL_SIZE + 1] = height;
  scl_put3(b, SCL_EYE, eye.x, eye.y, eye.z);
  scl_put3(b, SCL_RIGHT, rows[0] / fx, rows[1] / fx, rows[2] / fx); b[SCL_FOCAL_X] = fx;
  scl_put3(b, SCL_UP, rows[4] / fy, rows[5] / fy, rows[6] / fy); b[SCL_FOCAL_Y] = fy;
  scl_put3(b, SCL_FORWARD, rows[12], rows[13], rows[14]);
}

// The character's feet and heading (radians about +y; 0 faces +z).
scl_place :: (b: [] f32, x: f32, y: f32, z: f32, heading: f32) #export_c #effects(all) {
  scl_put3(b, SCL_AT, x, y, z); b[SCL_HEADING] = cos(heading); b[SCL_HEADING + 1] = sin(heading);
}

// One point light, kept when it reaches the character: the block holds the SCL_MAX_LIGHTS nearest
// her (by the gap from her feet to the light less its reach). Call scl_lights_clear first.
scl_lights_clear :: (b: [] f32) { b[SCL_OUT] = 0; for k: 0..<SCL_MAX_LIGHTS * 8 { b[SCL_LIGHTS + k] = 0; } }
scl_light_gap :: (b: [] f32, x: f32, y: f32, z: f32, reach: f32) -> f32 {
  dx := x - b[SCL_AT]; dy := y - (b[SCL_AT + 1] + 1); dz := z - b[SCL_AT + 2];
  return sqrt(dx * dx + dy * dy + dz * dz) - reach;
}
scl_light :: (b: [] f32, x: f32, y: f32, z: f32, reach: f32, r: f32, gr: f32, bl: f32, strength: f32) {
  if !(reach > 0) || !(strength > 0) { return; }
  gap := scl_light_gap(b, x, y, z, reach);
  if gap > 2 { return; }   // out of her reach, with a margin for her arms and the orbit's frames
  n := cast(int) b[SCL_OUT];
  slot := n;
  if n >= SCL_MAX_LIGHTS {
    // the farthest held, if this one is nearer
    slot = -1; worst := gap;
    for k: 0..<SCL_MAX_LIGHTS {
      at := SCL_LIGHTS + k * 8;
      held := scl_light_gap(b, b[at], b[at + 1], b[at + 2], b[at + 3]);
      if held > worst { worst = held; slot = k; }
    }
    if slot < 0 { return; }
  } else { b[SCL_OUT] = cast(f32) (n + 1); }
  at := SCL_LIGHTS + slot * 8;
  b[at] = x; b[at + 1] = y; b[at + 2] = z; b[at + 3] = reach;
  b[at + 4] = r; b[at + 5] = gr; b[at + 6] = bl; b[at + 7] = strength;
}

#test "The camera comes from the clip rows, and the lights keep the nearest eight that reach her" {
  b: [SCL_FLOATS] f32;
  rows := [16] f32.[2, 0, 0, -2, 0, 3, 0, 0, 0, 0, 1.0002, -0.1, 0, 0, 1, -1];
  scl_camera(b[..], rows[..], SclPoint.{x = 1, y = 0, z = 1}, 1280, 720);
  #assert b[SCL_FOCAL_X] == 2 && b[SCL_FOCAL_Y] == 3 && b[SCL_RIGHT] == 1 && b[SCL_UP + 1] == 1 && b[SCL_FORWARD + 2] == 1;
  #assert b[SCL_CLIP + 15] == -1 && b[SCL_SIZE] == 1280 && b[SCL_EYE + 2] == 1;
  scl_place(b[..], 0, 0, 0, 3.14159265);
  #assert b[SCL_HEADING] < -0.999 && abs(b[SCL_HEADING + 1]) < 0.0001;
  scl_lights_clear(b[..]);
  scl_light(b[..], 50, 1, 0, 5, 1, 1, 1, 1);   // too far
  scl_light(b[..], 1, 1, 0, 5, 1, 1, 1, 0);    // dark
  #assert b[SCL_OUT] == 0;
  for k: 0..<10 { scl_light(b[..], cast(f32) k, 1, 0, 12, 1, 0.5, 0.25, 2); }
  #assert b[SCL_OUT] == 8;
  // the two farthest (8 and 9) never displaced a nearer one
  for k: 0..<8 { #assert b[SCL_LIGHTS + k * 8] < 8; }
  scl_light(b[..], -0.5, 1, 0, 12, 1, 1, 1, 1);   // nearer than the farthest held (7)
  far := 0.0f32; for k: 0..<8 { far = ifx b[SCL_LIGHTS + k * 8] > far then b[SCL_LIGHTS + k * 8] else far; }
  #assert far == 6;
}
