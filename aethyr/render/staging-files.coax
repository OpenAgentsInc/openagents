// Filesystem effects for a package whose copy policy is checked in Coax.
// Every input is retained before publication; no source product is reread
// after a destination has been written.
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/crypto/sha256-kernel.coax";
#load "staging-policy.coax";
RSP_MANIFEST :: 262144;
RSP_PRODUCT_BYTES :: 2097152;
RSP_RETAINED :: 31*RSP_PRODUCT_BYTES;
RspFiles :: struct {
  manifest:[RSP_MANIFEST]u8; manifest_count:int;
  plan:RspPlan; starts:[31]int; counts:[31]int;
  bytes:[RSP_RETAINED]u8; used:int; hash:[64]u8;
}
rsp_load :: (source:string,files:[]RspFiles)->bool {
  f:=files;f[0].manifest_count=fs_read(source,f[0].manifest[..]);
  if f[0].manifest_count<0 {tool_errln("render staging: missing or oversized manifest");return false;}
  text:=cast(string)f[0].manifest[0..<f[0].manifest_count];f[0].plan=rsp_parse(text);
  if !f[0].plan.ok || !S_hex(S_hash(text),f[0].hash[..]) {tool_errln("render staging: invalid package");return false;}
  path:[FS_PATH_MAX]u8;hash:[64]u8;f[0].used=0;
  for i:0..<f[0].plan.count {
    name:=rsp_product_name(f[0].plan.rows[i..<i+1]);
    at:=f[0].used;n:=fs_read(fs_join(fs_dir(source),name,path[..]),f[0].bytes[at..<at+RSP_PRODUCT_BYTES]);
    if n<0 || !S_hex(S_hash(cast(string)f[0].bytes[at..<at+n]),hash[..]) || cast(string)hash[..]!=rsp_product_hash(f[0].plan.rows[i..<i+1]) {tool_errln("render staging: product missing, oversized or hash differs");return false;}
    f[0].starts[i]=at;f[0].counts[i]=n;f[0].used+=n;
  }
  return true;
}
rsp_publish_files :: (directory:string,files:[]RspFiles)->bool {
  if !fs_mkdir(directory) {return false;}
  path:[FS_PATH_MAX]u8;
  for i:0..<files[0].plan.count {
    name:=rsp_product_name(files[0].plan.rows[i..<i+1]);at:=files[0].starts[i];n:=files[0].counts[i];
    if !fs_write(fs_join(directory,name,path[..]),cast(string)files[0].bytes[at..<at+n]) {return false;}
  }
  return fs_write(fs_join(directory,"render.json",path[..]),cast(string)files[0].manifest[0..<files[0].manifest_count]);
}
rsp_stage :: (app:string,url:string,stage:string,result:[]u8)->string {
  if !rsp_url(url) {tool_errln("render staging: unsafe package URL");return "";}
  source:[FS_PATH_MAX]u8;files:[1]RspFiles;
  if !rsp_load(fs_join(app,url[1..<url.count],source[..]),files[..]) {return "";}
  // One writer per backing: the returned writer only ever holds the caller's
  // result, so the local rel never joins its returned borrow (E0383).
  rel:[128]u8;r:[1]Jo;jo_start(r[..],rel[..]);jo_put(r[..],"build/render/");jo_put(r[..],cast(string)files[0].hash[..]);rel_count:=r[0].n;
  path1:[FS_PATH_MAX]u8;path2:[FS_PATH_MAX]u8;
  for tree:[2]string.["assets","site"] {
    base:=fs_join(stage,tree,path1[..]);directory:=fs_join(base,jo_text(r[..]),path2[..]);
    if !rsp_publish_files(directory,files[..]) {tool_errln("render staging: could not publish products");return "";}
  }
  o:[1]Jo;jo_start(o[..],result);jo_put(o[..],"/");jo_put(o[..],cast(string)rel[0..<rel_count]);jo_put(o[..],"/render.json");
  return ifx o[0].bad then "" else jo_text(o[..]);
}
rsp_write_identity :: (source:string,app:string,slug:string,output:string)->bool {
  files:[1]RspFiles;if !rsp_load(source,files[..]) {return false;}
  identity:=rsp_read_identity(cast(string)files[0].manifest[0..<files[0].manifest_count],app,slug);
  header:[16384]u8;text:=rsp_header(identity,app,slug,cast(string)files[0].hash[..],header[..]);
  if text.count==0 {tool_errln("render identity: app, profile or index refused");return false;}
  pending:[FS_PATH_MAX]u8;o:[1]Jo;jo_start(o[..],pending[..]);jo_put(o[..],output);jo_put(o[..],".pending");
  if o[0].bad || !fs_mkdir(fs_dir(output)) || !fs_write(jo_text(o[..]),text) || !fs_rename(jo_text(o[..]),output) {tool_errln("render identity: publication failed");return false;}
  return true;
}
