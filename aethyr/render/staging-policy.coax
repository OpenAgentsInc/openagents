// Admission for copying an already built package; runtime shader/catalog
// compatibility remains the renderer's separate contract.
#load "../../coax/lib/json/json.coax";
#authority;
RspProduct :: struct { name:[128]u8; name_count:int; hash:[64]u8; }
RspPlan :: struct { ok:bool; count:int; rows:[31]RspProduct; }
RspIdentity :: struct { ok:bool; profile:int; }
#load "tests/staging-policy-checks.coax";
rsp_lower :: (c:u8)->bool {return c>='a' && c<='z';}
rsp_digit :: (c:u8)->bool {return c>='0' && c<='9';}
rsp_url :: (s:string)->bool {
  prefix:="/build/render/";suffix:="/render.json";
  if s.count<=prefix.count+suffix.count {return false;}
  end:=s.count-suffix.count;
  if s[0..<prefix.count]!=prefix || s[end..<s.count]!=suffix {return false;}
  for c:s[prefix.count..<end] {if !(rsp_lower(c) || rsp_digit(c) || c=='-') {return false;}}
  return true;
}
rsp_sibling :: (s:string,extension:string)->bool {
  if !rsp_length(s.count,extension.count) {return false;}
  if s[0]=='.' || s[s.count-extension.count..<s.count]!=extension {return false;}
  for c:s {if !(rsp_lower(c) || (c>='A' && c<='Z') || rsp_digit(c) || c=='-' || c=='_' || c=='.') {return false;}}
  return true;
}
rsp_length :: (count:int,extension:int)->bool {return count>=1 && count<=128 && count>=extension;}
rsp_identity :: (s:string)->bool {
  if s.count<1 || !rsp_lower(s[0]) {return false;}
  for c:s {if !(rsp_lower(c) || rsp_digit(c) || c=='-') {return false;}}
  return true;
}
rsp_counts :: (m:int,e:int)->bool {return m>=1 && m<=3 && e>=1 && e<=14;}
rsp_hash :: (s:string)->bool {
  if s.count!=64 {return false;}
  for c:s {if !(rsp_digit(c) || (c>='a' && c<='f')) {return false;}}
  return true;
}
rsp_product_name :: (p:[]RspProduct)->string {return cast(string)p[0].name[0..<p[0].name_count];}
rsp_product_hash :: (p:[]RspProduct)->string {return cast(string)p[0].hash[..];}
rsp_parse :: (text:string)->RspPlan {
  p:RspPlan;nodes:[16384]JvNode;doc:[1]Jv;
  if !jv_parse(doc[..],text,nodes[..]) {return p;}d:=doc[0];
  schema:[64]u8;n:=jv_str(d,jv_get(d,0,"schema"),schema[..]);
  if n!=24 {return p;}
  if cast(string)schema[0..<n]!="aethyr.render.package.v1" {return p;}
  modules:=jv_get(d,0,"modules");entries:=jv_get(d,0,"entries");
  if !rsp_counts(rsp_array_length(d,modules),rsp_array_length(d,entries)) {return p;}
  for group:0..<3 {
    rows:=ifx group==0 then modules else entries;
    file_key:=ifx group==0 then "wgsl_file" else ifx group==1 then "spirv_file" else "tree_file";
    hash_key:=ifx group==0 then "wgsl_sha256" else ifx group==1 then "spirv_sha256" else "tree_sha256";
    ext:=ifx group==0 then ".wgsl" else ifx group==1 then ".spv" else ".tree";
    for i:0..<jv_len(d,rows) {
      row:=jv_at(d,rows,i);product:RspProduct;
      product.name_count=jv_str(d,jv_get(d,row,file_key),product.name[..]);
      if !rsp_length(product.name_count,ext.count) {return p;}
      if !rsp_sibling(cast(string)product.name[0..<product.name_count],ext) {return p;}
      count:=jv_str(d,jv_get(d,row,hash_key),product.hash[..]);
      if count!=64 || !rsp_hash(cast(string)product.hash[..]) {return p;}
      p.rows[p.count]=product;p.count+=1;
    }
  }
  p.ok=true;return p;
}
rsp_array_length :: (d:Jv,node:int)->int {return ifx jv_kind(d,node)==JV_ARRAY then jv_len(d,node) else -1;}
rsp_read_identity :: (text:string,app:string,slug:string)->RspIdentity {
  if !rsp_identity(app) || !rsp_identity(slug) {return RspIdentity.{};}
  nodes:[16384]JvNode;doc:[1]Jv;
  if !jv_parse(doc[..],text,nodes[..]) {return RspIdentity.{};}d:=doc[0];
  a:[4096]u8;s:[4096]u8;an:=jv_str(d,jv_get(d,0,"app"),a[..]);sn:=jv_str(d,jv_get(d,0,"slug"),s[..]);
  if an!=app.count || sn!=slug.count {return RspIdentity.{};}
  if cast(string)a[0..<an]!=app || cast(string)s[0..<sn]!=slug {return RspIdentity.{};}
  profile:=jv_int(d,jv_get(d,0,"profile_index"),-1);
  return RspIdentity.{ok=profile>=0,profile=profile};
}
rsp_header :: (identity:RspIdentity,app:string,slug:string,hash:string,out:[]u8)->string {
  if !identity.ok {return "";}
  o:[1]Jo;jo_start(o[..],out);
  jo_put(o[..],"// Generated from the Coax-built render.json; do not edit.\n#ifndef AETHYR_RENDER_IDENTITY_H\n#define AETHYR_RENDER_IDENTITY_H\n#include <stdint.h>\n#define AETHYR_RENDER_TYPED 1\n#define AETHYR_RENDER_PROFILE_ID INT64_C(");
  jo_int(o[..],identity.profile);jo_put(o[..],")\n#define AETHYR_RENDER_PROFILE AETHYR_RENDER_PROFILE_ID\n#define AETHYR_RENDER_APP ");jo_quoted(o[..],app);
  jo_put(o[..],"\n#define AETHYR_RENDER_SLUG ");jo_quoted(o[..],slug);
  jo_put(o[..],"\n#define AETHYR_RENDER_PACKAGE_FILE \"render/render.json\"\n#define AETHYR_RENDER_PACKAGE AETHYR_RENDER_PACKAGE_FILE\n#define AETHYR_RENDER_PACKAGE_SHA256 ");jo_quoted(o[..],hash);jo_put(o[..],"\n#endif\n");
  return ifx o[0].bad then "" else jo_text(o[..]);
}
