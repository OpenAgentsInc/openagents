// Link a private renderer-only reactor from retained source-joined C bytes.
#import "Basic";
#load "qualification-files.coax";
#load "../../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3 {tool_errln("usage: build-display-probe ROOT NATIVE_DIR NEW_OUT_DIR");return 2;}root:=args_at(a[..],0);native:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}
 paths:[4][4096]u8;source:=fs_join(native,"RenderHost.c",paths[0][..]);face:=fs_join(root,"aethyr/render/tests/display-probe-face.c",paths[1][..]);output:=fs_join(out,"renderer.wasm",paths[2][..]);
 argv:=[24]string.["/opt/homebrew/opt/llvm/bin/clang","--target=wasm32-wasip1","--sysroot=/opt/homebrew/opt/wasi-libc/share/wasi-sysroot","-resource-dir=/opt/homebrew/opt/wasi-runtimes/share/wasi-runtimes","-std=c11","-O1","-ffp-contract=off","-fno-fast-math","-Wno-unused-function","-Wno-unused-variable","-I",native,source,face,"-mexec-model=reactor","-Wl,--import-memory,--max-memory=67108864,-z,stack-size=4194304,--export=__heap_base,--gc-sections","-lm","-o",output,"-Wno-unused-but-set-variable","-Wl,--strip-debug","-Wno-unknown-pragmas","-Wl,--export-dynamic","-g0"];
 raw:[1048576]u8;err:[1048576]u8;env:[]string;r:=rtq_command(argv[..],env,proc_now_ms()+180000,out,"reactor-link",raw[..],err[..]);return ifx rtq_ok(r) then 0 else 1;
}
