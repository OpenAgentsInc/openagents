// Effects for the independent build qualifier. Frozen expectations are in
// build-tool-policy; the retained Python oracle sees only SPIR-V bytes.
#load "native-qualification.coax";
#load "build-tool-policy.coax";
RBC_ORACLE :: "aethyr/render/tests/spirv_inventory_oracle.py";
rbc_product :: (directory:string,d:Jv,row:int,filekey:string,hashkey:string,out:[]u8,inputs:[]RtqInputs)->int {
  name:[4096]u8;n:=jv_str(d,jv_get(d,row,filekey),name[..]);if n<1 {return -1;}file:=cast(string)name[0..<n];if fs_base(file)!=file {return -1;}path:[4096]u8;full:=fs_join(directory,file,path[..]);size:=fs_size(full);if size<0 || size>out.count || !rtq_input_add(inputs,full) {return -1;}got:=fs_read_at(full,0,out[0..<size]);hash:[64]u8;declared:[64]u8;hn:=jv_str(d,jv_get(d,row,hashkey),declared[..]);if got!=size || !S_hex(S_hash(cast(string)out[0..<size]),hash[..]) || hn!=64 || cast(string)hash[..]!=cast(string)declared[..] {return -1;}return size;
}
rbc_verify :: (directory:string,snapshot:Jv,work:string,deadline:int,out:[]u8)->string {
  if !fs_mkdir(work) {return "";}inputs:[1]RtqInputs;paths:[4][4096]u8;manifest:=fs_join(directory,"render.json",paths[0][..]);bytes:[262144]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_input_add(inputs[..],manifest) || !rtq_input_add(inputs[..],RBC_ORACLE) || !rtq_json_file(manifest,bytes[..],nodes[..],doc[..]) {return "";}d:=doc[0];if !rbt_metadata(snapshot,d) {tool_errln("independent package catalog contract differs");return "";}
  module_bytes:[3][4194304]u8;module_counts:[3]int;modules:=jv_get(d,0,"modules");for i:0..<jv_len(d,modules) {row:=jv_at(d,modules,i);set:=jv_int(d,jv_get(d,row,"binding_set"),-1);n:=rbc_product(directory,d,row,"wgsl_file","wgsl_sha256",module_bytes[set][..],inputs[..]);if n<0 {tool_errln("module product bytes differ");return "";}module_counts[set]=n;}
  writer:[1]Jo;jo_start(writer[..],out);jo_obj(writer[..]);jo_key(writer[..],"profile");jv_write(d,jv_get(d,0,"slug"),writer[..]);jo_key(writer[..],"modules");jo_int(writer[..],jv_len(d,modules));jo_key(writer[..],"entries");jo_arr(writer[..]);entries:=jv_get(d,0,"entries");
  for i:0..<jv_len(d,entries) {
    row:=jv_at(d,entries,i);set:=jv_int(d,jv_get(d,row,"binding_set"),-1);index:=jv_int(d,jv_get(d,row,"entry_index"),-1);
    for stage:[2]string.["vertex","fragment"] {key:=ifx stage=="vertex" then "wgsl_vertex" else "wgsl_fragment";alias_bytes:[4096]u8;an:=jv_str(d,jv_get(d,row,key),alias_bytes[..]);if an<0 {return "";}alias:=cast(string)alias_bytes[0..<an];fragment:[4096]u8;fn:=jv_str(d,jv_get(d,row,"fragment"),fragment[..]);if stage=="fragment" && fn==0 {if index!=2 || an!=0 {return "";}continue;}if !rbt_wgsl(cast(string)module_bytes[set][0..<module_counts[set]],stage,alias) {tool_errln("WGSL entry is absent from actual module bytes");return "";}}
    spirv:[4194304]u8;tree:[4194304]u8;ns:=rbc_product(directory,d,row,"spirv_file","spirv_sha256",spirv[..],inputs[..]);nt:=rbc_product(directory,d,row,"tree_file","tree_sha256",tree[..],inputs[..]);if ns<0 || nt<0 {tool_errln("pipeline product bytes differ");return "";}tree_words:=rbt_tree(cast(string)tree[0..<nt],jv_int(d,jv_get(d,row,"tree_version"),-1));if tree_words<0 || !rbt_layout(d,row) {tool_errln("tree words or dense vertex layout differ");return "";}
    filename:[4096]u8;nn:=jv_str(d,jv_get(d,row,"spirv_file"),filename[..]);if nn<1 {return "";}file:=fs_join(directory,cast(string)filename[0..<nn],paths[1][..]);argv:=[3]string.["python3",RBC_ORACLE,file];stdout:[1048576]u8;stderr:[65536]u8;env:[]string;label:[128]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],"entry-");jo_int(lw[..],index);r:=rtq_command(argv[..],env,deadline,work,jo_text(lw[..]),stdout[..],stderr[..]);if !rtq_ok(r) {return "";}facts:[1]Jv;fact_nodes:[4096]JvNode;if !jv_parse(facts[..],cast(string)stdout[0..<r.out_n],fact_nodes[..]) || !rbt_facts(d,row,facts[0]) || jv_int(facts[0],jv_get(facts[0],0,"words"),-1)!=ns/4 {tool_errln("independently decoded SPIR-V interface differs");return "";}
    jo_obj(writer[..]);jo_key(writer[..],"entry_index");jo_int(writer[..],index);jo_key(writer[..],"spirv_words");jv_write(facts[0],jv_get(facts[0],0,"words"),writer[..]);jo_key(writer[..],"spirv_sha256");jv_write(d,jv_get(d,row,"spirv_sha256"),writer[..]);jo_key(writer[..],"tree_words");jo_int(writer[..],tree_words);jo_key(writer[..],"tree_sha256");jv_write(d,jv_get(d,row,"tree_sha256"),writer[..]);jo_end(writer[..]);
  }jo_end(writer[..]);sources:=jv_get(d,0,"source_inputs");if jv_kind(d,sources)!=JV_ARRAY || jv_len(d,sources)==0 {return "";}
  for i:0..<jv_len(d,sources) {row:=jv_at(d,sources,i);name:[4096]u8;n:=jv_str(d,jv_get(d,row,"path"),name[..]);if n<1 {return "";}for k:0..<i {if rtq_equal(d,jv_get(d,jv_at(d,sources,k),"path"),d,jv_get(d,row,"path")) {return "";}}path:=cast(string)name[0..<n];hash:[64]u8;declared:[64]u8;hn:=jv_str(d,jv_get(d,row,"sha256"),declared[..]);if !rtq_hash_file(path,hash[..]) || hn!=64 || cast(string)hash[..]!=cast(string)declared[..] || !rtq_input_add(inputs[..],path) {tool_errln("declared package source no longer matches");return "";}}
  hash:[64]u8;if !rtq_inputs_match(inputs[..]) || !rtq_hash_file(manifest,hash[..]) {return "";}jo_key(writer[..],"manifest_sha256");jo_str(writer[..],cast(string)hash[..]);jo_end(writer[..]);return ifx writer[0].bad then "" else jo_text(writer[..]);
}
rbc_native_inputs :: (inputs:[]RtqInputs)->bool {
  for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {path:[4096]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],".c");if !rtq_input_add(inputs,jo_text(o[..])) {return false;}}
  list:[1]FsList;if fs_list("coax/platform",list[..])<0 {return false;}for i:0..<list[0].n {name:=fs_entry(list[..],i);if name.count>=2 && name[name.count-2..<name.count]==".h" {path:[4096]u8;if !rtq_input_add(inputs,fs_join("coax/platform",name,path[..])) {return false;}}}return true;
}
rbc_prepare :: (compiler:string,entry:string,work:string,deadline:int,root:string)->bool {
  if !fs_mkdir(work) {return false;}inputs:[1]RtqInputs;if !rtq_deps(inputs[..],compiler,entry,deadline,work,"tool-dependencies") || !rtq_deps(inputs[..],compiler,"coax/lib/crypto/entropy.coax",deadline,work,"entropy-dependencies") || !rbc_native_inputs(inputs[..]) {return false;}
  compiler_hash:[64]u8;if !rtq_hash_file(compiler,compiler_hash[..]) {return false;}paths:[5][4096]u8;header:=fs_join(work,"entropy-policy.h",paths[0][..]);source:=fs_join(work,"tool.c",paths[1][..]);entropy:=fs_join(work,"entropy.c",paths[2][..]);exe:=fs_join(work,"tool",paths[3][..]);stdout:[RTQ_FILE]u8;stderr:[65536]u8;env:[]string;
  emit:=[6]string.[compiler,"c","coax/lib/crypto/entropy.coax","--library","--header",header];r:=rtq_command(emit[..],env,deadline,work,"entropy-emission",stdout[..],stderr[..]);if !rtq_ok(r) || !fs_write(entropy,cast(string)stdout[0..<r.out_n]) {return false;}coax:=[4]string.[compiler,"c",entry,"--library"];r=rtq_command(coax[..],env,deadline,work,"tool-emission",stdout[..],stderr[..]);if !rtq_ok(r) || !fs_write(source,cast(string)stdout[0..<r.out_n]) {return false;}
  uname:=[2]string.["uname","-s"];r=rtq_command(uname[..],env,deadline,work,"platform",stdout[..],stderr[..]);if !rtq_ok(r) {return false;}apple:=rtq_trim(cast(string)stdout[0..<r.out_n])=="Darwin";
  argv:[32]string;n:=0;for arg:[11]string.["clang",ifx apple then "-D_DARWIN_C_SOURCE" else "-D_DEFAULT_SOURCE","-std=c11","-O2","-I",work,"-I","coax/platform","-o",exe,source] {argv[n]=arg;n+=1;}for arg:[7]string.["coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c","coax/platform/socket-native.c","coax/platform/entropy-native.c","coax/platform/entropy-foreign.c"] {argv[n]=arg;n+=1;}argv[n]=entropy;n+=1;if apple {argv[n]="-framework";argv[n+1]="Security";n+=2;}else {argv[n]="-lpthread";n+=1;}argv[n]="-lm";n+=1;r=rtq_command(argv[0..<n],env,deadline,work,"native-link",stdout[..],stderr[..]);hash:[64]u8;if !rtq_ok(r) || !rtq_inputs_match(inputs[..]) || !rtq_hash_file(compiler,hash[..]) || cast(string)hash[..]!=cast(string)compiler_hash[..] {return false;}
  record:[2097152]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.builder.native.v1");jo_key(o[..],"compiler_sha256");jo_str(o[..],cast(string)compiler_hash[..]);if !rtq_hash_file(exe,hash[..]) {return false;}jo_key(o[..],"builder_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],inputs[..],root);jo_key(o[..],"generated_sha256");jo_obj(o[..]);for path,i:[3]string.[source,entropy,header] {if !rtq_hash_file(path,hash[..]) {return false;}jo_key(o[..],[3]string.["tool.c","entropy.c","entropy-policy.h"][i]);jo_str(o[..],cast(string)hash[..]);}jo_end(o[..]);jo_key(o[..],"command");jo_arr(o[..]);for arg:argv[0..<n] {jo_str(o[..],arg);}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && fs_write(fs_join(work,"qualification.json",paths[4][..]),jo_text(o[..]));
}
rbc_builder_receipt :: (path:string,builder:string,compiler_hash:string,inputs:[]RtqInputs)->bool {
  bytes:[2097152]u8;nodes:[32768]JvNode;doc:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],doc[..]) {return false;}d:=doc[0];hash:[64]u8;if !rtq_hash_file(builder,hash[..]) || !rbt_literal(d,jv_get(d,0,"compiler_sha256"),compiler_hash) || !rbt_literal(d,jv_get(d,0,"builder_sha256"),cast(string)hash[..]) {return false;}source:=jv_get(d,0,"source_sha256");if jv_kind(d,source)!=JV_OBJECT || jv_len(d,source)==0 {return false;}child:=d.nodes[source].first;
  while child!=-1 {name:=jv_key(d,child);if !rtq_hash_file(name,hash[..]) || !rbt_literal(d,child,cast(string)hash[..]) || !rtq_input_add(inputs,name) {tool_errln("builder source receipt no longer matches");return false;}child=d.nodes[child].next;}return rtq_input_add(inputs,path) && rtq_input_add(inputs,builder);
}
