RBT_TEST_SNAPSHOT :: "{\"profiles\":[{\"slug\":\"tiny\",\"module\":\"app\",\"features\":{\"media\":false},\"pass_first\":0,\"pass_count\":1,\"particle_pass_first\":1,\"particle_pass_count\":0,\"binding_first\":0,\"particle_binding_first\":1}],\"bindings\":[{\"name\":\"u\"}],\"passes\":[{\"pass_id\":\"background\",\"binding_set\":0,\"vertex\":\"v\",\"fragment\":\"f\",\"wgsl_vertex\":\"vs\",\"wgsl_fragment\":\"fs\",\"uses\":[{\"resource\":0,\"slot\":0,\"native_kind\":1,\"shape\":0,\"stride\":4,\"stages\":3}]}]}";
RBT_TEST_PACKAGE :: "{\"schema\":\"aethyr.render.package.v1\",\"profile_index\":0,\"slug\":\"tiny\",\"app\":\"app\",\"modules\":[{\"binding_set\":0}],\"entries\":[{\"entry_index\":0,\"binding_set\":0,\"vertex\":\"v\",\"fragment\":\"f\",\"wgsl_vertex\":\"vs\",\"wgsl_fragment\":\"fs\",\"uses\":[{\"name\":\"u\",\"slot\":0,\"native_kind\":1,\"shape\":0,\"stride\":4,\"stages\":3}],\"reflection_schema\":2,\"tree_version\":3,\"derivatives\":0,\"control\":0,\"native_int64\":true,\"fragment_targets\":1,\"fragment_depth\":false,\"attributes\":[{\"location\":0,\"scalar\":2,\"width\":4,\"offset\":0}],\"vertex_stride\":16}]}";
RBT_TEST_FACTS :: "{\"attributes\":[[0,2,4]],\"fragment_targets\":1,\"fragment_depth\":false,\"resources\":[[0,1,0,4]],\"native_int64\":true,\"derivatives\":0,\"control\":0,\"has_fragment\":true,\"words\":27}";
rbt_test_edit :: (text:string,needle:string,replacement:string,out:[]u8)->string {at:=rtq_find(text,needle,0);#assert at>=0;o:[1]Jo;jo_start(o[..],out);jo_put(o[..],text[0..<at]);jo_put(o[..],replacement);jo_put(o[..],text[at+needle.count..<text.count]);return jo_text(o[..]);}
#test "build qualifier owns a complete independent catalog contract" {
  sn:[512]JvNode;s:[1]Jv;dn:[512]JvNode;d:[1]Jv;#assert jv_parse(s[..],RBT_TEST_SNAPSHOT,sn[..]) && jv_parse(d[..],RBT_TEST_PACKAGE,dn[..]);#assert rbt_metadata(s[0],d[0]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_plan(s[0],p,0)>=0 && rbt_plan(s[0],p,1)== -1 && rbt_plan(s[0],p,13)== -1 && rbt_plan(s[0],p,-1)== -3 && rbt_plan(s[0],p,14)== -3;
  data:[8192]u8;
  for needle,i:[15]string.["\"slug\":\"tiny\"","\"app\":\"app\"","\"profile_index\":0","\"schema\":\"aethyr.render.package.v1\"","\"entry_index\":0","\"binding_set\":0,\"vertex\"","\"vertex\":\"v\"","\"fragment\":\"f\"","\"wgsl_vertex\":\"vs\"","\"wgsl_fragment\":\"fs\"","\"name\":\"u\"","\"reflection_schema\":2","\"tree_version\":3","\"derivatives\":0","\"control\":0"] {
    replacement:="\"wrong\":null";if i==4 {replacement="\"entry_index\":1";}if i==5 {replacement="\"binding_set\":1,\"vertex\"";}
    #assert jv_parse(d[..],rbt_test_edit(RBT_TEST_PACKAGE,needle,replacement,data[..]),dn[..]) && !rbt_metadata(s[0],d[0]);
  }
  for value:[4]string.["[]","{}","null","[{\"binding_set\":0},{\"binding_set\":0}]"] {#assert jv_parse(d[..],rbt_test_edit(RBT_TEST_PACKAGE,"[{\"binding_set\":0}]",value,data[..]),dn[..]) && !rbt_metadata(s[0],d[0]);}
}
#test "build qualifier validates dense layout and every independent SPIRV fact" {
  dn:[512]JvNode;d:[1]Jv;fn:[512]JvNode;f:[1]Jv;#assert jv_parse(d[..],RBT_TEST_PACKAGE,dn[..]) && jv_parse(f[..],RBT_TEST_FACTS,fn[..]);row:=jv_at(d[0],jv_get(d[0],0,"entries"),0);#assert rbt_layout(d[0],row) && rbt_facts(d[0],row,f[0]);data:[8192]u8;
  for needle:[11]string.["[[0,2,4]]","\"fragment_targets\":1","\"fragment_depth\":false","[[0,1,0,4]]","\"native_int64\":true","\"derivatives\":0","\"control\":0","\"has_fragment\":true","\"attributes\":","\"resources\":","\"words\":27"] {
    replacement:=ifx needle=="[[0,2,4]]" then "[[0,2,3]]" else ifx needle=="[[0,1,0,4]]" then "[[0,2,0,4]]" else ifx needle=="\"attributes\":" || needle=="\"resources\":" then "\"wrong\":" else "\"wrong\":null";#assert jv_parse(f[..],rbt_test_edit(RBT_TEST_FACTS,needle,replacement,data[..]),fn[..]) && !rbt_facts(d[0],row,f[0]);
  }
  #assert jv_parse(d[..],rbt_test_edit(RBT_TEST_PACKAGE,"\"offset\":0","\"offset\":4",data[..]),dn[..]) && !rbt_layout(d[0],jv_at(d[0],jv_get(d[0],0,"entries"),0));
  #assert jv_parse(d[..],rbt_test_edit(RBT_TEST_PACKAGE,"\"vertex_stride\":16","\"vertex_stride\":20",data[..]),dn[..]) && !rbt_layout(d[0],jv_at(d[0],jv_get(d[0],0,"entries"),0));
}
#test "build qualifier observes lexical WGSL entry names and bounded tree words" {
  separators:=[8]u8.['2','\r','\n','1',11,'2',12,'3'];#assert rbt_tree("3 0000\t4294967295\n",3)==3 && rbt_tree(cast(string)separators[..],2)==4;
  for text:[9]string.[""," ","3 4294967296","3 -1","3 +1","3 1.0","3 x","3 1_0","2 3"] {#assert rbt_tree(text,3)== -1;}
  #assert rbt_wgsl("@vertex\nfn\tvs (x:i32)","vertex","vs") && rbt_wgsl("@fragment fn fs()","fragment","fs");
  for text:[7]string.["@fragment fn vs()","@vertexfn vs()","@vertex fnvs()","@vertex fn wrong()","@vertex fn vs_extra()","@vertex fn vs", "@vertex fn vs ["] {#assert !rbt_wgsl(text,"vertex","vs");}
  #assert rbt_wgsl("@vertex fn wrong() @vertex fn vs()","vertex","vs") && !rbt_wgsl("@vertex fn ()","vertex","");
}
rbt_test_metadata :: (snapshot:string,package:string)->bool {sn:[1024]JvNode;s:[1]Jv;dn:[2048]JvNode;d:[1]Jv;#assert jv_parse(s[..],snapshot,sn[..]) && jv_parse(d[..],package,dn[..]);return rbt_metadata(s[0],d[0]);}
#test "build qualifier covers declaration range endpoints and binding offsets" {
  sn:[1024]JvNode;s:[1]Jv;data:[16384]u8;changed:[16384]u8;out:[8192]u8;
  #assert jv_parse(s[..],"[\"\",1]",sn[..]) && rbt_literal(s[0],jv_at(s[0],0,0),"") && !rbt_literal(s[0],jv_at(s[0],0,1),"") && !rbt_literal(s[0],-1,"");
  for first:-1..<3 {for count:-1..<3 {n:[32]u8;o:[1]Jo;jo_start(o[..],n[..]);jo_put(o[..],"\"pass_first\":");jo_int(o[..],first);text:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"pass_first\":0",jo_text(o[..]),data[..]);jo_start(o[..],n[..]);jo_put(o[..],"\"pass_count\":");jo_int(o[..],count);#assert jv_parse(s[..],rbt_test_edit(text,"\"pass_count\":1",jo_text(o[..]),changed[..]),sn[..]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);got:=rbt_plan(s[0],p,0);valid:=first>=0 && count>=0 && first<=1 && count<=1-first;#assert (got!= -3)==valid;if !valid {#assert !rbt_test_metadata(cast(string)changed[0..<s[0].text.count],RBT_TEST_PACKAGE);}}}
  for field:[2]string.["\"pass_first\":0,","\"pass_count\":1,"] {text:=rbt_test_edit(RBT_TEST_SNAPSHOT,field,"",data[..]);#assert jv_parse(s[..],text,sn[..]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_plan(s[0],p,0)== -3;}
  text:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"particle_pass_first\":1,\"particle_pass_count\":0","\"particle_pass_first\":0,\"particle_pass_count\":1",data[..]);#assert jv_parse(s[..],text,sn[..]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_plan(s[0],p,0)== -3 && !rbt_metadata(s[0],s[0]);
  for replacement:[5]string.["\"binding_first\":-1","\"binding_first\":1","\"wrong\":0","\"binding_first\":2","\"binding_first\":9007199254740992"] {text=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"binding_first\":0",replacement,data[..]);#assert jv_parse(s[..],text,sn[..]);p=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_uses(s[0],p,rbt_plan(s[0],p,0),0,out[..])=="";}
  for replacement:[3]string.["\"resource\":-1","\"resource\":1","\"wrong\":0"] {text=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"resource\":0",replacement,data[..]);#assert !rbt_test_metadata(text,RBT_TEST_PACKAGE);}
  text=rbt_test_edit(RBT_TEST_SNAPSHOT,"[{\"name\":\"u\"}]","[{\"name\":\"first\"},{\"name\":\"u\"}]",data[..]);text=rbt_test_edit(text,"\"binding_first\":0","\"binding_first\":1",changed[..]);#assert rbt_test_metadata(text,RBT_TEST_PACKAGE);
  #assert jv_parse(s[..],RBT_TEST_SNAPSHOT,sn[..]);p=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_uses(s[0],p,rbt_plan(s[0],p,0),0,out[0..<1])=="";text=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"uses\":[{","\"other\":[{",data[..]);#assert jv_parse(s[..],text,sn[..]);p=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_uses(s[0],p,rbt_plan(s[0],p,0),0,out[..])=="";
}
#test "build qualifier refuses duplicate and out of range package identities" {
  data:[16384]u8;other:[16384]u8;
  for replacement:[5]string.["\"profile_index\":-1","\"profile_index\":1","\"profile_index\":2","\"profile_index\":null","\"profile_index\":1.5"] {#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,rbt_test_edit(RBT_TEST_PACKAGE,"\"profile_index\":0",replacement,data[..]));}
  for replacement:[5]string.["\"entry_index\":-1","\"entry_index\":14","\"entry_index\":15","\"entry_index\":null","\"other\":0"] {#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,rbt_test_edit(RBT_TEST_PACKAGE,"\"entry_index\":0",replacement,data[..]));}
  for replacement:[4]string.["\"binding_set\":-1,\"vertex\"","\"binding_set\":3,\"vertex\"","\"binding_set\":4,\"vertex\"","\"other\":0,\"vertex\""] {#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,rbt_test_edit(RBT_TEST_PACKAGE,"\"binding_set\":0,\"vertex\"",replacement,data[..]));}
  for replacement:[4]string.["[{\"binding_set\":-1}]","[{\"binding_set\":3}]","[{\"binding_set\":4}]","[{}]"] {#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,rbt_test_edit(RBT_TEST_PACKAGE,"[{\"binding_set\":0}]",replacement,data[..]));}
  for replacement:[2]string.["\"entries\":{}","\"entries\":null"] {text:=rbt_test_edit(RBT_TEST_PACKAGE,"\"entries\":[", "\"entries\":[] ,\"ignored\":[",data[..]);text=rbt_test_edit(text,"\"entries\":[]",replacement,other[..]);#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,text);}
  for field:[3]string.["\"reflection_schema\":2","\"tree_version\":3","\"derivatives\":0"] {text:=rbt_test_edit(RBT_TEST_PACKAGE,field,"\"missing\":0",data[..]);#assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,text);}
  #assert rbt_test_metadata(RBT_TEST_SNAPSHOT,rbt_test_edit(RBT_TEST_PACKAGE,"\"tree_version\":3","\"tree_version\":2",data[..]));
  text:=rbt_test_edit(RBT_TEST_PACKAGE,"\"derivatives\":0","\"derivatives\":2",data[..]);text=rbt_test_edit(text,"\"control\":0","\"control\":2",other[..]);#assert rbt_test_metadata(RBT_TEST_SNAPSHOT,text);
}
#test "build qualifier media is an explicit independent declaration" {
  media:="{\"entry_index\":13,\"binding_set\":2,\"vertex\":\"media_vs\",\"fragment\":\"media_fs\",\"wgsl_vertex\":\"vs\",\"wgsl_fragment\":\"fs\",\"uses\":[{\"name\":\"u\",\"slot\":0,\"native_kind\":1,\"shape\":0,\"stride\":4,\"stages\":3},{\"name\":\"media_image\",\"slot\":1,\"native_kind\":2,\"shape\":0,\"stride\":0,\"stages\":2},{\"name\":\"media_sampler\",\"slot\":2,\"native_kind\":3,\"shape\":0,\"stride\":0,\"stages\":2}],\"reflection_schema\":2,\"tree_version\":2,\"derivatives\":0,\"control\":0}";
  a:[16384]u8;b:[16384]u8;sbuf:[8192]u8;prefix:[4096]u8;o:[1]Jo;jo_start(o[..],prefix[..]);jo_put(o[..],"\"entries\":[");jo_put(o[..],media);jo_put(o[..],",");text:=rbt_test_edit(RBT_TEST_PACKAGE,"\"entries\":[",jo_text(o[..]),a[..]);text=rbt_test_edit(text,"[{\"binding_set\":0}]","[{\"binding_set\":0},{\"binding_set\":2}]",b[..]);snapshot:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"media\":false","\"media\":true",sbuf[..]);#assert rbt_test_metadata(snapshot,text);
  dn:[2048]JvNode;d:[1]Jv;#assert jv_parse(d[..],snapshot,dn[..]);p:=jv_at(d[0],jv_get(d[0],0,"profiles"),0);#assert rbt_plan(d[0],p,13)== -2;uses:[1024]u8;#assert rbt_uses(d[0],p,-2,2,uses[..])==RBT_MEDIA_USES && rbt_uses(d[0],p,-2,2,uses[0..<1])=="";
  bad:[16384]u8;for field:[5]string.["\"binding_set\":2,\"vertex\"","\"vertex\":\"media_vs\"","\"fragment\":\"media_fs\"","\"wgsl_vertex\":\"vs\"","\"wgsl_fragment\":\"fs\""] {replacement:=ifx field=="\"binding_set\":2,\"vertex\"" then "\"binding_set\":1,\"vertex\"" else "\"bad\":null";#assert !rbt_test_metadata(snapshot,rbt_test_edit(text,field,replacement,bad[..]));}
  #assert !rbt_test_metadata(snapshot,rbt_test_edit(text,"\"entry_index\":13","\"entry_index\":0",bad[..]));
}
#test "build textual product checks include complete delimiter and numeric boundaries" {
  for c:0..<256 {#assert rbt_space(cast(u8)c)==(c==32 || c==9 || c==10 || c==11 || c==12 || c==13);}
  #assert rbt_tree("3",3)==1 && rbt_tree("3 19 4294967294 0 9",3)==5 && rbt_tree("0 0",0)==2;
  for text:[7]string.["3 :","3 /","3 99999999999999999999999999","3 42949672960","4","3 1\0","3 429496729599"] {#assert rbt_tree(text,3)== -1;}
  for text:[7]string.["@vertex fn (","@vertex fn vs(","@vertex fn\tvs(","@vertex fn vs\n(","@vertex  fn  vs()","@vertex fn vs\t(","x @vertex fn vs("] {#assert rbt_wgsl(text,"vertex",ifx text=="@vertex fn (" then "" else "vs")== (text!="@vertex fn (");}
  for text:[9]string.["@vertex fn","@vertex fn ","@vertex fn v","@vertex fn vs","@vertex fn vs ","@vertex fnvs(","@vertex f  vs(","@vertex xfn vs(","@vertex fn v("] {#assert !rbt_wgsl(text,"vertex","vs");}
  #assert !rbt_wgsl("", "vertex", "vs") && !rbt_wgsl("@vertex", "vertex", "vs");long:[129]u8;for i:0..<129 {long[i]='a';}#assert !rbt_wgsl("x",cast(string)long[..],"a");
}
#test "build layouts and oracle fact transport reject missing or malformed components" {
  dn:[4096]JvNode;d:[1]Jv;fn:[512]JvNode;f:[1]Jv;data:[16384]u8;other:[16384]u8;
  for attrs:[4]string.["null","{}","[{\"width\":-1,\"offset\":0}]","[{\"offset\":0}]"] {text:=rbt_test_edit(RBT_TEST_PACKAGE,"[{\"location\":0,\"scalar\":2,\"width\":4,\"offset\":0}]",attrs,data[..]);#assert jv_parse(d[..],text,dn[..]) && !rbt_layout(d[0],jv_at(d[0],jv_get(d[0],0,"entries"),0));}
  #assert jv_parse(d[..],"{\"attributes\":[{\"width\":0,\"offset\":0}],\"vertex_stride\":0}",dn[..]) && rbt_layout(d[0],0);#assert jv_parse(d[..],"{\"attributes\":[{\"width\":1}],\"vertex_stride\":4}",dn[..]) && !rbt_layout(d[0],0);#assert jv_parse(d[..],"{\"attributes\":[]}",dn[..]) && !rbt_layout(d[0],0);
  for count:[2]int.[32,33] {o:[1]Jo;jo_start(o[..],data[..]);jo_put(o[..],"{\"attributes\":[");for i:0..<count {if i>0 {jo_put(o[..],",");}jo_put(o[..],"{\"width\":0,\"offset\":0}");}jo_put(o[..],"],\"vertex_stride\":0}");#assert jv_parse(d[..],jo_text(o[..]),dn[..]) && rbt_layout(d[0],0)==(count==32);}
  #assert jv_parse(d[..],RBT_TEST_PACKAGE,dn[..]);row:=jv_at(d[0],jv_get(d[0],0,"entries"),0);
  for pair,i:[10]string.["[[0,2,4]]","[[0,2,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,1,0,4]]","\"words\":27","\"words\":27"] {replacement:=[10]string.["{}","[[0,2]]","{}","[[0,1,0]]","[[1,1,0,4]]","[[0,1,1,4]]","[[0,1,0,8]]","[[0,1,null,4]]","\"words\":5","\"words\":4"][i];text:=rbt_test_edit(RBT_TEST_FACTS,pair,replacement,data[..]);#assert jv_parse(f[..],text,fn[..]) && rbt_facts(d[0],row,f[0])==(i==7 || i==8);}
  text:=rbt_test_edit(RBT_TEST_PACKAGE,"\"fragment\":\"f\"","\"fragment\":\"\"",data[..]);#assert jv_parse(d[..],text,dn[..]);row=jv_at(d[0],jv_get(d[0],0,"entries"),0);text=rbt_test_edit(RBT_TEST_FACTS,"\"has_fragment\":true","\"has_fragment\":false",other[..]);#assert jv_parse(f[..],text,fn[..]) && rbt_facts(d[0],row,f[0]);
  text=rbt_test_edit(RBT_TEST_PACKAGE,"\"fragment\":\"f\"","\"fragment\":null",data[..]);#assert jv_parse(d[..],text,dn[..]) && !rbt_facts(d[0],jv_at(d[0],jv_get(d[0],0,"entries"),0),f[0]);
}
#test "build inventory distinguishes absence from zero and repeated identities" {
  sn:[2048]JvNode;s:[1]Jv;dn:[2048]JvNode;d:[1]Jv;a:[16384]u8;b:[16384]u8;c:[16384]u8;out:[8192]u8;
  #assert jv_parse(d[..],"[null,0,1,-1]",dn[..]);for expected,i:[4]int.[-1,0,1,-1] {#assert rbt_number(d[0],jv_at(d[0],0,i))==expected;}#assert rbt_number(d[0],-1)== -1;
  for replacement:[3]string.["\"resource\":-1","\"resource\":1","\"wrong\":0"] {text:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"resource\":0",replacement,a[..]);#assert jv_parse(s[..],text,sn[..]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_uses(s[0],p,rbt_plan(s[0],p,0),0,out[..])=="";}
  text:=rbt_test_edit(RBT_TEST_SNAPSHOT,"[{\"name\":\"u\"}]","[{\"name\":\"first\"},{\"name\":\"middle\"},{\"name\":\"u\"}]",a[..]);text=rbt_test_edit(text,"\"binding_first\":0","\"binding_first\":1",b[..]);text=rbt_test_edit(text,"\"resource\":0","\"resource\":1",c[..]);#assert rbt_test_metadata(text,RBT_TEST_PACKAGE);
  particle:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"particle_pass_first\":1,\"particle_pass_count\":0","\"particle_pass_first\":0,\"particle_pass_count\":1",a[..]);particle=rbt_test_edit(particle,"\"pass_first\":0,\"pass_count\":1","\"pass_first\":0,\"pass_count\":0",b[..]);#assert jv_parse(s[..],particle,sn[..]);p:=jv_at(s[0],jv_get(s[0],0,"profiles"),0);#assert rbt_plan(s[0],p,0)>=0;
  empty:=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"pass_count\":1","\"pass_count\":0",a[..]);#assert rbt_test_metadata(empty,"{\"schema\":\"aethyr.render.package.v1\",\"profile_index\":0,\"slug\":\"tiny\",\"app\":\"app\",\"modules\":[],\"entries\":[]}");for package:[2]string.["{\"schema\":\"aethyr.render.package.v1\",\"profile_index\":0,\"slug\":\"tiny\",\"app\":\"app\",\"modules\":[],\"entries\":{}}","{\"schema\":\"aethyr.render.package.v1\",\"profile_index\":0,\"slug\":\"tiny\",\"app\":\"app\",\"modules\":{},\"entries\":[]}"] {#assert !rbt_test_metadata(empty,package);}
  #assert !rbt_test_metadata(RBT_TEST_SNAPSHOT,"{\"schema\":\"aethyr.render.package.v1\",\"profile_index\":0,\"slug\":\"tiny\",\"app\":\"app\",\"modules\":[],\"entries\":[]}");
  #assert jv_parse(s[..],RBT_TEST_SNAPSHOT,sn[..]);pass:=jv_at(s[0],jv_get(s[0],0,"passes"),0);extra:=rbt_test_edit(jv_raw(s[0],pass),"\"background\"","\"hud\"",a[..]);prefix:[4096]u8;o:[1]Jo;jo_start(o[..],prefix[..]);jo_put(o[..],"\"passes\":[");jo_put(o[..],extra);jo_put(o[..],",");text=rbt_test_edit(RBT_TEST_SNAPSHOT,"\"passes\":[",jo_text(o[..]),b[..]);text=rbt_test_edit(text,"\"pass_count\":1","\"pass_count\":2",c[..]);
  #assert jv_parse(d[..],RBT_TEST_PACKAGE,dn[..]);entry:=jv_at(d[0],jv_get(d[0],0,"entries"),0);jo_start(o[..],prefix[..]);jo_put(o[..],"\"entries\":[");jo_put(o[..],jv_raw(d[0],entry));jo_put(o[..],",");package:=rbt_test_edit(RBT_TEST_PACKAGE,"\"entries\":[",jo_text(o[..]),a[..]);#assert !rbt_test_metadata(text,package);
}
#test "build lexical spans and independent fact shapes cover exact boundaries" {
  for first:-1..<5 {for resource:-1..<5 {for limit:0..<5 {expected:=ifx first>=0 && first<limit && resource>=0 && first+resource<limit then first+resource else -1;#assert rbt_use_index(first,resource,limit)==expected;}}}
  for at:-1..<6 {for word:[4]string.["","x","xy","xyz"] {expected:=false;if at>=0 && at<=3 && word.count<=3-at {expected="xyz"[at..<at+word.count]==word;}#assert rbt_prefix("xyz",at,word)==expected;}}
  #assert rbt_skip_space("  x",0)==2 && rbt_skip_space("  x",1)==2 && rbt_skip_space("  x",2)==2 && rbt_skip_space("  x",3)==3 && rbt_skip_space(" \t",0)==2 && !rbt_wgsl("vertex fn vs()","vertex","vs") && !rbt_wgsl("Xvertex fn vs()","vertex","vs") && !rbt_wgsl("@broken fn vs()","vertex","vs");
  dn:[2048]JvNode;d:[1]Jv;fn:[2048]JvNode;f:[1]Jv;a:[16384]u8;#assert jv_parse(d[..],RBT_TEST_PACKAGE,dn[..]);row:=jv_at(d[0],jv_get(d[0],0,"entries"),0);
  for pair,i:[8]string.["[[0,2,4]]","[[0,2,4]]","[[0,2,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,1,0,4]]","[[0,2,4]]","[[0,1,0,4]]"] {replacement:=[8]string.["{\"x\":[0,2,4]}","[[0,2,4],[0,2,4]]","[{\"a\":0,\"b\":2,\"c\":4}]","{\"x\":[0,1,0,4]}","[[0,1,0,4],[0,1,0,4]]","[{\"a\":0,\"b\":1,\"c\":0,\"d\":4}]","[]","[]"][i];#assert jv_parse(f[..],rbt_test_edit(RBT_TEST_FACTS,pair,replacement,a[..]),fn[..]) && !rbt_facts(d[0],row,f[0]);}
  #assert jv_parse(d[..],"{\"attributes\":[{\"offset\":0}],\"vertex_stride\":0}",dn[..]) && !rbt_layout(d[0],0);
