// Same compiler/arguments/product for the retained fault fixture and Coax.
//   coax/web/tool.sh aethyr/render/tests/check-build-fault-parity.coax OUT REFERENCE_DIR COAX_FIXTURE REAL_COAX
#import "Basic";
#load "qualification-files.coax";
BFP_FAULTS :: [7]string.["name","target","generic","framing","source","compiler","exit"];
bfp_run :: (argv:[]string,env:[]string,work:string,label:string,out:[]u8,err:[]u8)->ProcRun {
  r:=rtq_run_raw(argv,env,120000,out,err);if !rtq_record_run(work,label,argv,r,cast(string)out[0..<r.out_n],cast(string)err[0..<r.err_n]) {r.cut=true;}return r;
}
bfp_equal_json :: (a:string,b:string)->bool {an:[8192]JvNode;bn:[8192]JvNode;ad:[1]Jv;bd:[1]Jv;return jv_parse(ad[..],a,an[..]) && jv_parse(bd[..],b,bn[..]) && rtq_equal(ad[0],0,bd[0],0);}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=4 {return 2;}out:=args_at(a[..],0);ref:=args_at(a[..],1);fixture:=args_at(a[..],2);compiler:=args_at(a[..],3);if !fs_mkdir(out) {return 1;}compiler_hash:[64]u8;fixture_hash:[64]u8;if !rtq_hash_file(compiler,compiler_hash[..]) || !rtq_hash_file(fixture,fixture_hash[..]) {return 1;}start:=proc_now_ms();stdout:[1048576]u8;stderr:[1048576]u8;empty:[]string;paths:[7][4096]u8;
  for fault:BFP_FAULTS {
    if proc_now_ms()-start>=RTQ_DEADLINE_MS {return 1;}work:=fs_join(out,fault,paths[0][..]);if !fs_mkdir(work) {return 1;}old:=fs_join(work,"compiler-reference",paths[1][..]);current:=fs_join(work,"compiler-coax",paths[2][..]);dependency:=fs_join(work,"input.txt",paths[3][..]);product:=fs_join(work,"product.spv",paths[4][..]);
    script:="import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);from check_build import fake_compiler;fake_compiler(Path(sys.argv[2]),Path(sys.argv[3]),sys.argv[4],Path(sys.argv[5]))";factory:=[8]string.["python3","-c",script,ref,old,compiler,fault,dependency];r:=bfp_run(factory[..],empty,work,"reference-factory",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}copy:=[3]string.["cp",fixture,current];r=bfp_run(copy[..],empty,work,"coax-copy",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}
    config:[4][8192]u8;env:[4]string;values:=[4]string.[compiler,fault,dependency,current];for prefix,i:[4]string.["AETHYR_BUILD_REAL_COAX=","AETHYR_BUILD_FAULT=","AETHYR_BUILD_DEPENDENCY=","AETHYR_BUILD_SELF="] {o:[1]Jo;jo_start(o[..],config[i][..]);jo_put(o[..],prefix);jo_put(o[..],values[i]);env[i]=jo_text(o[..]);}
    if !fs_write(dependency,"source snapshot\n") {return 1;}args:=[4]string.[old,"deps","aethyr/render/build.coax","--library"];r=bfp_run(args[..],empty,work,"reference-deps",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}expected:[1048576]u8;expected_err:[1048576]u8;en:=r.out_n;ern:=r.err_n;for i:0..<en {expected[i]=stdout[i];}for i:0..<ern {expected_err[i]=stderr[i];}args[0]=current;r=bfp_run(args[..],env[..],work,"coax-deps",stdout[..],stderr[..]);if !rtq_ok(r) || !bfp_equal_json(cast(string)expected[0..<en],cast(string)stdout[0..<r.out_n]) || ern!=r.err_n || cast(string)expected_err[0..<ern]!=cast(string)stderr[0..<r.err_n] {return 1;}
    old_before:[64]u8;new_before:[64]u8;if !rtq_hash_file(old,old_before[..]) || !rtq_hash_file(current,new_before[..]) {return 1;}spirv:=[9]string.[old,"spirv","apps/openagents-web/gpu/newland.coax","--vertex","newland_bg_vs","--fragment","newland_bg_fs","-o",product];r=bfp_run(spirv[..],empty,work,"reference-spirv",stdout[..],stderr[..]);if r.started!=0 || r.timed_out || r.cut || r.status!=(ifx fault=="exit" then 31 else 0) {return 1;}en=r.out_n;ern=r.err_n;for i:0..<en {expected[i]=stdout[i];}for i:0..<ern {expected_err[i]=stderr[i];}product_hash:[64]u8;old_hash:[64]u8;if !rtq_hash_file(product,product_hash[..]) || !rtq_hash_file(old,old_hash[..]) || (cast(string)old_hash[..]!=cast(string)old_before[..])!=(fault=="compiler") {return 1;}source:[4096]u8;sn:=fs_read(dependency,source[..]);if sn<0 {return 1;}
    if !fs_write(dependency,"source snapshot\n") {return 1;}spirv[0]=current;r=bfp_run(spirv[..],env[..],work,"coax-spirv",stdout[..],stderr[..]);hash:[64]u8;new_hash:[64]u8;after:[4096]u8;an:=fs_read(dependency,after[..]);if r.started!=0 || r.timed_out || r.cut || r.status!=(ifx fault=="exit" then 31 else 0) || r.out_n!=en || cast(string)expected[0..<en]!=cast(string)stdout[0..<r.out_n] || r.err_n!=ern || cast(string)expected_err[0..<ern]!=cast(string)stderr[0..<r.err_n] || !rtq_hash_file(product,hash[..]) || cast(string)hash[..]!=cast(string)product_hash[..] || an!=sn || cast(string)source[0..<sn]!=cast(string)after[0..<an] || !rtq_hash_file(current,new_hash[..]) || (cast(string)new_hash[..]!=cast(string)new_before[..])!=(fault=="compiler") {tool_err("fault fixture parity differs: ");tool_errln(fault);return 1;}
    record:[4096]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"fault");jo_str(o[..],fault);jo_key(o[..],"product_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"stdout_stderr_exit_dependency_bytes");jo_str(o[..],"equal");jo_key(o[..],"self_identity_changes");jo_bool(o[..],fault=="compiler");jo_end(o[..]);if !fs_write(fs_join(work,"parity.json",paths[5][..]),jo_text(o[..])) {return 1;}
  }
  hash:[64]u8;if !rtq_hash_file(compiler,hash[..]) || cast(string)hash[..]!=cast(string)compiler_hash[..] || !rtq_hash_file(fixture,hash[..]) || cast(string)hash[..]!=cast(string)fixture_hash[..] {return 1;}record:[4096]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"compiler_sha256");jo_str(o[..],cast(string)compiler_hash[..]);jo_key(o[..],"fixture_sha256");jo_str(o[..],cast(string)fixture_hash[..]);jo_key(o[..],"before_after");jo_str(o[..],"equal");jo_key(o[..],"faults");jo_int(o[..],7);jo_end(o[..]);if !fs_write(fs_join(out,"qualification.json",paths[6][..]),jo_text(o[..])) {return 1;}print("fault compiler parity:7 faults, exact stdout/stderr/exit/products/dependency bytes, identical semantic dependency inventory and self-change detection\n");return 0;
}
