    slug:[128]u8;n:=jv_str(snapshot[0],jv_get(snapshot[0],jv_at(snapshot[0],profiles,i),"slug"),slug[..]);if n<1 {return 1;}name:=cast(string)slug[0..<n];directory:=fs_join(packages,name,paths[2][..]);verify_dir:=fs_join(out,name,paths[3][..]);report:[1048576]u8;text:=rbc_verify(directory,snapshot[0],verify_dir,deadline,report[..]);if text.count==0 || !fs_write(fs_join(verify_dir,"report.json",paths[4][..]),text) {return 1;}
    script:="import sys,json;from pathlib import Path;sys.path.insert(0,sys.argv[1]);import check_build;check_build.ROOT=Path.cwd();print(json.dumps(check_build.verify_package(Path(sys.argv[2]),json.load(open(sys.argv[3]))),sort_keys=True))";snapshot_path:=fs_join(ref,"catalog-6445ee0050.json",paths[5][..]);argv:=[6]string.["python3","-c",script,ref,directory,snapshot_path];if !rtq_ok(bt_run(argv[..],env,true,verify_dir,"reference-report",stdout[..],stderr[..])) || !bt_json_equal(fs_join(verify_dir,"report.json",paths[4][..]),fs_join(verify_dir,"reference-report.stdout",paths[6][..])) {return 1;}
    package_bytes:[262144]u8;package_nodes:[16384]JvNode;package_doc:[1]Jv;if !rtq_json_file(fs_join(directory,"render.json",paths[4][..]),package_bytes[..],package_nodes[..],package_doc[..]) {return 1;}d:=package_doc[0];entries:=jv_get(d,0,"entries");
    for e:0..<jv_len(d,entries) {row:=jv_at(d,entries,e);hash:[64]u8;hn:=jv_str(d,jv_get(d,row,"spirv_sha256"),hash[..]);if hn!=64 || fact_count==256 {return 1;}seen:=false;for k:0..<fact_count {if cast(string)fact_hashes[k][..]==cast(string)hash[..] {seen=true;}}if seen {continue;}fact_hashes[fact_count]=hash;fact_count+=1;file:[128]u8;fn:=jv_str(d,jv_get(d,row,"spirv_file"),file[..]);if fn<1 {return 1;}spirv:=fs_join(directory,cast(string)file[0..<fn],paths[7][..]);fact_script:="import sys,json;from pathlib import Path;sys.path.insert(0,sys.argv[1]);from check_build import spirv;print(json.dumps(spirv(Path(sys.argv[2]).read_bytes()),sort_keys=True))";args:=[5]string.["python3","-c",fact_script,ref,spirv];label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"fact-");jo_int(w[..],e);if !rtq_ok(bt_run(args[..],env,true,verify_dir,jo_text(w[..]),stdout[..],stderr[..])) {return 1;}expected:[1048576]u8;en:=0;
      // The reference command record keeps exact raw output; use its file size.
      record_name:[256]u8;rw:[1]Jo;jo_start(rw[..],record_name[..]);jo_put(rw[..],jo_text(w[..]));jo_put(rw[..],".stdout");reference_output:=fs_join(verify_dir,jo_text(rw[..]),paths[8][..]);en=fs_read(reference_output,expected[..]);oracle:=[3]string.["python3",RBC_ORACLE,spirv];jo_start(w[..],label[..]);jo_put(w[..],"oracle-");jo_int(w[..],e);r:=bt_run(oracle[..],env,true,verify_dir,jo_text(w[..]),stdout[..],stderr[..]);if !rtq_ok(r) || en!=r.out_n || cast(string)expected[0..<en]!=cast(string)stdout[0..<r.out_n] {return 1;}
    }
  }
  base:=fs_join(qualified,"the-grid",paths[2][..]);original_tests:="import sys,unittest;from pathlib import Path;sys.path.insert(0,sys.argv[1]);import check_build;check_build.ROOT=Path.cwd();import test_build_tooling as t;t.PACKAGE=Path(sys.argv[2]);unittest.main(module=t,argv=['reference'])";unit:=[5]string.["python3","-c",original_tests,ref,base];if !rtq_ok(bt_run(unit[..],env,true,out,"retained-unit-tests",stdout[..],stderr[..])) {return 1;}
  verify_reference:="import sys,json;from pathlib import Path;sys.path.insert(0,sys.argv[1]);import check_build;check_build.ROOT=Path.cwd();check_build.verify_package(Path(sys.argv[2]),json.load(open(sys.argv[3])))";snapshot_path:=fs_join(ref,"catalog-6445ee0050.json",paths[3][..]);
  for label,i:BT_LABELS {directory:=fs_join(out,label,paths[4][..]);copy:=[4]string.["cp","-R",base,directory];if !rtq_ok(bt_run(copy[..],env,true,out,label,stdout[..],stderr[..])) || !bt_poison(directory,i) {return 1;}check_dir:=fs_join(directory,"coax-verdict",paths[5][..]);check:=[5]string.[image,"--verify-package",directory,"--work-dir",check_dir];r:=bt_run(check[..],env,false,directory,"coax",stdout[..],stderr[..]);if r.cut {return 1;}reference:=[6]string.["python3","-c",verify_reference,ref,directory,snapshot_path];r=bt_run(reference[..],env,false,directory,"reference",stdout[..],stderr[..]);if r.cut {return 1;}}
  // Malformed word streams keep the original decoder's exact exception class.
  for which:0..<8 {
    original:[4194304]u8;package_bytes:[262144]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(base,"render.json",paths[4][..]),package_bytes[..],nodes[..],d[..]) {return 1;}first:=jv_at(d[0],jv_get(d[0],0,"entries"),0);name:[128]u8;nn:=jv_str(d[0],jv_get(d[0],first,"spirv_file"),name[..]);if nn<1 {return 1;}size:=fs_read(fs_join(base,cast(string)name[0..<nn],paths[5][..]),original[..]);if size<24 {return 1;}if which==0 {size=19;}if which==1 {size-=1;}if which==2 {bt_put_word(original[..],0,0);}if which==3 {bt_put_word(original[..],4,0x00010400);}if which==4 {bt_put_word(original[..],12,0);}if which==5 {bt_put_word(original[..],16,1);}if which==6 {bt_put_word(original[..],20,0);}if which==7 {bt_put_word(original[..],20,0xffff0000);}label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"malformed-");jo_int(w[..],which);directory:=fs_join(out,jo_text(w[..]),paths[6][..]);if !fs_mkdir(directory) {return 1;}file:=fs_join(directory,"input.spv",paths[7][..]);if !fs_write(file,cast(string)original[0..<size]) {return 1;}script:="import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);from check_build import spirv;spirv(Path(sys.argv[2]).read_bytes())";args:=[5]string.["python3","-c",script,ref,file];r:=bt_run(args[..],env,false,directory,"reference",stdout[..],stderr[..]);if r.cut {return 1;}error:[8192]u8;en:=rtn_text(error[..],bt_last_error(cast(string)stderr[0..<r.err_n]));oracle:=[3]string.["python3",RBC_ORACLE,file];r=bt_run(oracle[..],env,false,directory,"oracle",stdout[..],stderr[..]);if r.cut || en<0 || cast(string)error[0..<en]!=bt_last_error(cast(string)stderr[0..<r.err_n]) {return 1;}
  }
