}
bt_json_equal :: (a:string,b:string)->bool {ab:[1048576]u8;bb:[1048576]u8;an:[16384]JvNode;bn:[16384]JvNode;ad:[1]Jv;bd:[1]Jv;return rtq_json_file(a,ab[..],an[..],ad[..]) && rtq_json_file(b,bb[..],bn[..],bd[..]) && rtq_equal(ad[0],0,bd[0],0);}
bt_last_error :: (text:string)->string {trim:=rtq_trim(text);at:=trim.count-1;while at>=0 && trim[at]!='\n' {at-=1;}return trim[at+1..<trim.count];}
