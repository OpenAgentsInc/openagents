// Coax owns retained-reference parity, actual product poisons and verdicts.
//   coax/web/tool.sh aethyr/render/tests/check-build-tooling.coax OUT BUILD_BINARY MOCK_COMPILER PACKAGES QUALIFIED_BUILD COAX [REFERENCE_ROOT]
#import "Basic";
#load "build-qualification.coax";
#load "package-tool-policy.coax";
BT_LABELS :: [22]string.["use-name","use-slot","use-kind","use-shape","use-stride","use-stages","missing-entry","wrong-slug","vertex-offset","rehashed-int64-capability","rehashed-wgsl-entry","fragment-targets","fragment-depth","native-int64","derivatives","control","source-hash","spirv-hash","wgsl-hash","tree-hash","rehashed-tree-version","rehashed-tree-word-bound"];
bt_copy :: (from:string,to:string)->bool {bytes:[RTQ_FILE]u8;n:=fs_size(from);return n>=0 && n<=bytes.count && fs_read_at(from,0,bytes[0..<n])==n && fs_mkdir(fs_dir(to)) && fs_write(to,cast(string)bytes[0..<n]);}
bt_run :: (argv:[]string,env:[]string,success:bool,work:string,label:string,out:[]u8,err:[]u8)->ProcRun {
  r:=rtq_run_raw(argv,env,180000,out,err);if !rtq_record_run(work,label,argv,r,cast(string)out[0..<r.out_n],cast(string)err[0..<r.err_n]) {r.cut=true;}if r.started!=0 || r.timed_out || r.cut || (success && r.status!=0) || (!success && r.status!=1) {tool_err("build tooling command differs: ");tool_errln(label);tool_err(cast(string)err[0..<r.err_n]);r.cut=true;}return r;
}
bt_word :: (bytes:[]u8,at:int)->int {return cast(int)bytes[at]+cast(int)bytes[at+1]*256+cast(int)bytes[at+2]*65536+cast(int)bytes[at+3]*16777216;}
bt_put_word :: (bytes:[]u8,at:int,value:int) {for i:0..<4 {bytes[at+i]=cast(u8)((value>>(i*8))&255);}}
bt_poison :: (directory:string,which:int)->bool {
  path:[4096]u8;manifest:=fs_join(directory,"render.json",path[..]);bytes:[262144]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(manifest,bytes[..],nodes[..],doc[..]) {return false;}d:=doc[0];entries:=jv_get(d,0,"entries");first:=jv_at(d,entries,0);module:=jv_at(d,jv_get(d,0,"modules"),0);use:=jv_at(d,jv_get(d,first,"uses"),0);target:=-1;value:="";scratch:[524288]u8;writer:[1]Jo;jo_start(writer[..],scratch[..]);
  if which<6 {target=jv_get(d,use,[6]string.["name","slot","native_kind","shape","stride","stages"][which]);value=[6]string.["\"wrong\"","1","2","1","8","1"][which];}
  if which==6 {target=entries;jo_arr(writer[..]);for i:0..<jv_len(d,entries)-1 {jv_write(d,jv_at(d,entries,i),writer[..]);}jo_end(writer[..]);value=jo_text(writer[..]);}
  if which==7 {target=jv_get(d,0,"slug");value="\"wrong-profile\"";}
  if which==8 {for i:0..<jv_len(d,entries) {attributes:=jv_get(d,jv_at(d,entries,i),"attributes");if jv_len(d,attributes)>0 {target=jv_get(d,jv_at(d,attributes,0),"offset");break;}}jo_int(writer[..],jv_int(d,target,-1)+4);value=jo_text(writer[..]);}
