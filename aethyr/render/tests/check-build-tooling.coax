    for i:0..<jv_len(snapshot[0],profiles) {slug:[128]u8;n:=jv_str(snapshot[0],jv_get(snapshot[0],jv_at(snapshot[0],profiles,i),"slug"),slug[..]);if n<1 {return 1;}name:=cast(string)slug[0..<n];directory:=fs_join(packages,name,paths[2][..]);if name=="the-grid" {source:=fs_join(qualified,"the-grid",paths[3][..]);copy:=[4]string.["cp","-R",source,directory];if !rtq_ok(bt_run(copy[..],env,true,out,name,stdout[..],stderr[..])) {return 1;}}else {build:=[5]string.[builder,name,directory,"--coax",compiler];if !rtq_ok(bt_run(build[..],env,true,out,name,stdout[..],stderr[..])) {return 1;}}if proc_left(deadline,proc_now_ms())==0 {return 1;}}
    if !rtq_inputs_match(builder_inputs[..]) {return 1;}
