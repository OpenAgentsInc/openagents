  ref:=fs_join(out,"reference",paths[0][..]);for name:[3]string.["check_build.py","test_build_tooling.py","catalog-6445ee0050.json"] {source:[4096]u8;name_path:[4096]u8;directory:=fs_join(root,"aethyr/render/tests",source[..]);if !bt_copy(fs_join(directory,name,name_path[..]),fs_join(ref,name,paths[1][..])) {return 1;}}
