// Actual build, immutable products, independent reflection and atomic publish.
//   coax/web/tool.sh aethyr/render/tests/check-build.coax --work-dir DIR --receipt FILE [--profile SLUG] [--faults] [--cache-controls] [--coax FILE] [--compiler-source-digest FILE] [--explore-stale-compiler]
#import "Basic";
#load "build-qualification.coax";
#load "package-tool-policy.coax";
RBC_FAULTS :: [7]string.["name","target","generic","framing","source","compiler","exit"];
rbc_tables :: (builder:string,snapshot:Jv,work:string,deadline:int)->bool {
  profiles:=jv_get(snapshot,0,"profiles");for kind:0..<3 {
    expected:[16384]u8;o:[1]Jo;jo_start(o[..],expected[..]);for i:0..<jv_len(snapshot,profiles) {p:=jv_at(snapshot,profiles,i);if kind>0 {jo_int(o[..],i);jo_put(o[..]," ");}slug:[128]u8;n:=jv_str(snapshot,jv_get(snapshot,p,"slug"),slug[..]);if n<1 {return false;}jo_put(o[..],cast(string)slug[0..<n]);if kind==2 {app:[128]u8;an:=jv_str(snapshot,jv_get(snapshot,p,"module"),app[..]);if an<1 {return false;}jo_put(o[..]," ");jo_put(o[..],cast(string)app[0..<an]);}jo_put(o[..],"\n");}
    flag:=[3]string.["--profiles","--profile-table","--app-table"][kind];argv:=[2]string.[builder,flag];stdout:[65536]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(argv[..],env,deadline,work,flag[2..<flag.count],stdout[..],stderr[..]);if !rtq_ok(r) || o[0].bad || cast(string)stdout[0..<r.out_n]!=jo_text(o[..]) {return false;}
  }return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}work:=args_value(a[..],"--work-dir","");if work.count==0 || !fs_mkdir(work) {return 2;}start:=proc_now_ms();deadline:=proc_deadline(RTQ_DEADLINE_MS,start);paths:[16][4096]u8;snapshot_path:=args_value(a[..],"--snapshot","aethyr/render/tests/catalog-6445ee0050.json");snapshot_bytes:[1048576]u8;snapshot_nodes:[32768]JvNode;snapshot:[1]Jv;if !rtq_json_file(snapshot_path,snapshot_bytes[..],snapshot_nodes[..],snapshot[..]) {return 1;}
  verify:=args_value(a[..],"--verify-package","");report:[1048576]u8;if verify.count>0 {text:=rbc_verify(verify,snapshot[0],work,deadline,report[..]);if text.count==0 {return 1;}target:=args_value(a[..],"--report","");if target.count>0 && !fs_write(target,text) {return 1;}print("%",text);return 0;}
  receipt:=args_value(a[..],"--receipt","");if receipt.count==0 {return 2;}root_bytes:[4096]u8;root:=fs_cwd(root_bytes[..]);compiler_bytes:[4096]u8;selected:=proc_getenv("COAX",compiler_bytes[..]);if selected.count==0 {selected="coax/bin/coax";}compiler:=args_value(a[..],"--coax",selected);digest:=args_value(a[..],"--compiler-source-digest",fs_join(fs_dir(compiler),"source-digest",paths[0][..]));identity:[1]RtnCompiler;identity[0]=rtn_compiler(compiler,digest,root,work,deadline);if !identity[0].ok {return 1;}if !rpt_compiler_gate(identity[0].matching,args_has(a[..],"--explore-stale-compiler")) {tool_errln("source-matching compiler required before builder compilation or shader emission");return 1;}
  self_path:[4096]u8;self_n:=cxproc_self_path(self_path[..]);if self_n<1 || self_n>self_path.count {return 1;}self:=cast(string)self_path[0..<self_n];self_hash:[64]u8;if !rtq_hash_file(self,self_hash[..]) {return 1;}inputs:[1]RtqInputs;if !rtn_tool_sources(inputs[..],compiler,"aethyr/render/tests/check-build.coax",work,deadline) || !rtq_input_add(inputs[..],RBC_ORACLE) || !rtq_input_add(inputs[..],snapshot_path) {return 1;}
  builder:=args_value(a[..],"--builder","");builder_receipt:=args_value(a[..],"--builder-receipt","");if builder.count==0 {if builder_receipt.count>0 {return 2;}directory:=fs_join(work,"builder",paths[1][..]);if !rbc_prepare(compiler,"aethyr/render/build.coax",directory,deadline,root) {return 1;}builder=fs_join(directory,"tool",paths[2][..]);builder_receipt=fs_join(directory,"qualification.json",paths[3][..]);}else {if builder_receipt.count==0 {return 2;}}
  if !rbc_builder_receipt(builder_receipt,builder,cast(string)identity[0].hash[..],inputs[..]) || !rbc_tables(builder,snapshot[0],work,deadline) {return 1;}
  profile:=args_value(a[..],"--profile","the-grid");output:=fs_join(work,profile,paths[4][..]);argv:=[5]string.[builder,profile,output,"--coax",compiler];stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(argv[..],env,deadline,work,"build",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}text:=rbc_verify(output,snapshot[0],fs_join(work,"verify-initial",paths[5][..]),deadline,report[..]);if text.count==0 {return 1;}
  manifest:=fs_join(output,"render.json",paths[6][..]);before:[262144]u8;bn:=fs_read(manifest,before[..]);mtime:=fs_mtime_ns(manifest);if bn<1 || mtime<0 {return 1;}r=rtq_command(argv[..],env,deadline,work,"cache-reuse",stdout[..],stderr[..]);after:[262144]u8;an:=fs_read(manifest,after[..]);if !rtq_ok(r) || rtq_find(cast(string)stdout[0..<r.out_n],"reused ",0)<0 || an!=bn || cast(string)after[0..<an]!=cast(string)before[0..<bn] || fs_mtime_ns(manifest)!=mtime {tool_errln("unchanged package cache did not preserve exact bytes/mtime");return 1;}
  controls:[8192]u8;cw:[1]Jo;jo_start(cw[..],controls[..]);jo_arr(cw[..]);if args_has(a[..],"--cache-controls") || args_has(a[..],"--faults") {
    nodes:[16384]JvNode;d:[1]Jv;if !jv_parse(d[..],cast(string)before[0..<bn],nodes[..]) {return 1;}for kind,i:[3]string.["wgsl","spirv","tree"] {table:=ifx i==0 then "modules" else "entries";key:=[3]string.["wgsl_file","spirv_file","tree_file"][i];row:=jv_at(d[0],jv_get(d[0],0,table),0);name:[128]u8;n:=jv_str(d[0],jv_get(d[0],row,key),name[..]);if n<1 {return 1;}product:=fs_join(output,cast(string)name[0..<n],paths[7][..]);original:[4194304]u8;on:=fs_read(product,original[..]);if on<0 || !fs_append(product,"corrupt") {return 1;}r=rtq_command(argv[..],env,deadline,work,kind,stdout[..],stderr[..]);product_after:[4194304]u8;pn:=fs_read(product,product_after[..]);an=fs_read(manifest,after[..]);if !rtq_ok(r) || rtq_find(cast(string)stdout[0..<r.out_n],"reused ",0)>=0 || pn!=on || cast(string)product_after[0..<pn]!=cast(string)original[0..<on] || an!=bn || cast(string)after[0..<an]!=cast(string)before[0..<bn] {return 1;}jo_str(cw[..],kind);}
  }jo_end(cw[..]);
  losses:[8192]u8;lw:[1]Jo;jo_start(lw[..],losses[..]);jo_arr(lw[..]);if args_has(a[..],"--faults") {
    if profile!="the-grid" {return 2;}fixture:=args_value(a[..],"--fault-compiler","");fixture_receipt:=args_value(a[..],"--fault-compiler-receipt","");if fixture.count==0 {if fixture_receipt.count>0 {return 2;}fixture_dir:=fs_join(work,"fault-compiler",paths[8][..]);if !rbc_prepare(compiler,"aethyr/render/tests/build-fault-compiler.coax",fixture_dir,deadline,root) {return 1;}fixture=fs_join(fixture_dir,"tool",paths[9][..]);fixture_receipt=fs_join(fixture_dir,"qualification.json",paths[10][..]);}else {if fixture_receipt.count==0 {return 2;}}if !rbc_builder_receipt(fixture_receipt,fixture,cast(string)identity[0].hash[..],inputs[..]) {return 1;}
    for fault:RBC_FAULTS {
      name:[256]u8;nw:[1]Jo;jo_start(nw[..],name[..]);jo_put(nw[..],"fault-");jo_put(nw[..],fault);dest:=fs_join(work,jo_text(nw[..]),paths[11][..]);if !fs_mkdir(dest) {return 1;}previous:="{\"previous\":\"must remain byte identical\"}\n";previous_path:=fs_join(dest,"render.json",paths[12][..]);if !fs_write(previous_path,previous) {return 1;}
      jo_start(nw[..],name[..]);jo_put(nw[..],fault);jo_put(nw[..],"-input.txt");dependency:=fs_join(work,jo_text(nw[..]),paths[13][..]);jo_start(nw[..],name[..]);jo_put(nw[..],"compiler-");jo_put(nw[..],fault);fake:=fs_join(work,jo_text(nw[..]),paths[14][..]);if !fs_write(dependency,"source snapshot\n") {return 1;}copy:=[3]string.["cp",fixture,fake];r=rtq_command(copy[..],env,deadline,work,jo_text(nw[..]),stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}
      config:[4][8192]u8;child_env:[4]string;values:=[4]string.[compiler,fault,dependency,fake];for prefix,i:[4]string.["AETHYR_BUILD_REAL_COAX=","AETHYR_BUILD_FAULT=","AETHYR_BUILD_DEPENDENCY=","AETHYR_BUILD_SELF="] {e:[1]Jo;jo_start(e[..],config[i][..]);jo_put(e[..],prefix);jo_put(e[..],values[i]);if e[0].bad {return 1;}child_env[i]=jo_text(e[..]);}
      fault_args:=[5]string.[builder,profile,dest,"--coax",fake];r=rtq_run(fault_args[..],child_env[..],deadline,stdout[..],stderr[..]);if !rtq_record_run(work,fault,fault_args[..],r,cast(string)stdout[0..<r.out_n],cast(string)stderr[0..<r.err_n]) || r.started!=0 || r.status==0 || r.timed_out || r.cut {tool_err("undetected compiler fault: ");tool_errln(fault);return 1;}old:[256]u8;old_n:=fs_read(previous_path,old[..]);if old_n!=previous.count || cast(string)old[0..<old_n]!=previous {return 1;}if fault=="source" {changed:[256]u8;nn:=fs_read(dependency,changed[..]);if nn<1 || cast(string)changed[0..<nn]=="source snapshot\n" {return 1;}}if fault=="compiler" {fh:[64]u8;original_hash:[64]u8;if !rtq_hash_file(fake,fh[..]) || !rtq_hash_file(fixture,original_hash[..]) || cast(string)fh[..]==cast(string)original_hash[..] {return 1;}}jo_str(lw[..],fault);
    }
  }jo_end(lw[..]);
  hash:[64]u8;if !rtq_hash_file(compiler,hash[..]) || cast(string)hash[..]!=cast(string)identity[0].hash[..] || !rtq_hash_file(self,hash[..]) || cast(string)hash[..]!=cast(string)self_hash[..] || !rtq_inputs_match(inputs[..]) {return 1;}final:[1048576]u8;final_text:=rbc_verify(output,snapshot[0],fs_join(work,"verify-final",paths[15][..]),deadline,final[..]);if final_text.count==0 {return 1;}dn:[4096]JvNode;d:[1]Jv;fn:[4096]JvNode;f:[1]Jv;if !jv_parse(d[..],text,dn[..]) || !jv_parse(f[..],final_text,fn[..]) || !rtq_equal(d[0],0,f[0],0) {return 1;}
  record:[2097152]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.build.qualification.v1");jo_key(o[..],"status");jo_str(o[..],ifx identity[0].matching then "pass" else "exploratory");rtn_compiler_json(o[..],compiler,identity[..]);jo_key(o[..],"package");jo_raw(o[..],text);for key,i:[3]string.["builder_sha256","builder_receipt_sha256","qualifier_sha256"] {if !rtq_hash_file(ifx i==0 then builder else ifx i==1 then builder_receipt else "aethyr/render/tests/check-build.coax",hash[..]) {return 1;}jo_key(o[..],key);jo_str(o[..],cast(string)hash[..]);}jo_key(o[..],"qualifier_executable_sha256");jo_str(o[..],cast(string)self_hash[..]);jo_key(o[..],"failure_controls");jo_raw(o[..],jo_text(lw[..]));jo_key(o[..],"cache_product_controls");jo_raw(o[..],jo_text(cw[..]));jo_key(o[..],"enumerated_profiles");jo_int(o[..],jv_len(snapshot[0],jv_get(snapshot[0],0,"profiles")));jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],inputs[..],root);rtn_elapsed(o[..],proc_now_ms()-start);jo_key(o[..],"scope");jo_str(o[..],"Actual module/pipeline inventory, independent SPIRV framing/interface/resource/capability facts, frozen catalog contract, source closure, cache repair and atomic manifest publication. No GPU numerical/image or current-compiler release claim.");jo_end(o[..]);if o[0].bad || !fs_mkdir(fs_dir(receipt)) || !fs_write(receipt,jo_text(o[..])) {return 1;}print("build: %; exact cache reuse, % product repairs and % compiler faults; %\n",profile,ifx args_has(a[..],"--cache-controls") || args_has(a[..],"--faults") then 3 else 0,ifx args_has(a[..],"--faults") then 7 else 0,ifx identity[0].matching then "matching compiler" else "explicit older compiler observation");return 0;
}
