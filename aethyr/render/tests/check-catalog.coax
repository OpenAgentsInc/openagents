  jo_key(writer[..],"qualifier_executable");jo_str(writer[..],self_image);jo_key(writer[..],"qualifier_executable_sha256");jo_str(writer[..],cast(string)self_hash[..]);
  jo_key(writer[..],"source_sha256");rtq_inputs_json(writer[..],inputs[..],root);jo_key(writer[..],"header_fields_checked");rtc_abi_json(writer[..]);jo_key(writer[..],"modes");jo_raw(writer[..],jo_text(o[..]));jo_key(writer[..],"consumers");jo_raw(writer[..],cast(string)consumer_bytes[0..<consumers.bytes]);jo_key(writer[..],"shared_consumers");jo_int(writer[..],consumers.shared);jo_key(writer[..],"tracked_legacy_consumers");jo_int(writer[..],consumers.legacy);jo_key(writer[..],"elapsed_ms");jo_int(writer[..],proc_now_ms()-start);
  elapsed:=proc_now_ms()-start;seconds:[64]u8;seconds_writer:[1]Jo;jo_start(seconds_writer[..],seconds[..]);jo_int(seconds_writer[..],elapsed/1000);jo_put(seconds_writer[..],".");fraction:=[3]u8.[cast(u8)('0'+(elapsed%1000)/100),cast(u8)('0'+(elapsed%100)/10),cast(u8)('0'+elapsed%10)];jo_put(seconds_writer[..],cast(string)fraction[..]);jo_key(writer[..],"elapsed_seconds");jo_raw(writer[..],jo_text(seconds_writer[..]));
  jo_key(writer[..],"scope");jo_str(writer[..],"Complete normal-C frozen catalog data/ABI and producer-loss controls, plus every current realm's shared or explicitly tracked legacy route. Shader reflection/arithmetic, GPU rendering, images and production readiness remain separate.");jo_end(writer[..]);
  if writer[0].bad || !fs_mkdir(fs_dir(receipt)) || !fs_write(receipt,jo_text(writer[..])) {return 1;}
  print("catalog: % native profiles, % shared consumers, % tracked legacy consumers; %\n",jv_len(expected_doc[0],0),consumers.shared,consumers.legacy,ifx stale then "explicit pinned-compiler observation" else "matching-source qualification");return 0;
}
