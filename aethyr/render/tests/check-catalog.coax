// Native catalog data/ABI qualification and complete current consumer inventory.
//   coax/web/tool.sh aethyr/render/tests/check-catalog.coax --work-dir DIR --receipt FILE [--coax FILE] [--compiler-source-digest FILE] [--explore-stale-compiler] [--modes debug release sanitized]
#import "Basic";
#load "qualification-files.coax";
#load "catalog-tool-policy.coax";
RTC_NAMES :: [5]string.["RenderCatalog","RenderFeatures","RenderBinding","RenderEntry","RenderUse"];
RTC_FIELDS :: [5]string.["valid listed retired slug app page assets uniform_vec4s vertex_stride features binding_first binding_count pass_first pass_count particle_binding_first particle_binding_count particle_pass_first particle_pass_count","scene shadow casters grass surface water water_copy post post_depth traced_depth particles particle_depth particle_over media","name kind group binding stride uniform_vec4s","valid source vertex fragment wgsl_vertex wgsl_fragment binding_set","resource slot native_kind shape stride stages"];
RTC_FAULTS :: [7]string.["asset","feature","binding","pipeline","scope","slot","kind"];

rtc_modes :: (a:[]Args,out:[]string)->int {
  at:=args_find(a,"--modes");if at== -1 {out[0]="debug";out[1]="release";out[2]="sanitized";return 3;}
  n:=0;for i:at+1..<args_count(a) {
    value:=args_at(a,i);if value.count>=2 && value[0..<2]=="--" {break;}
    if n==3 || (value!="debug" && value!="release" && value!="sanitized") {return -1;}
    for k:0..<n {if out[k]==value {return -1;}}out[n]=value;n+=1;
  }return ifx n==0 then -1 else n;
}
rtc_abi :: (header:string)->bool {for name,i:RTC_NAMES {if !rtq_fields(header,name,RTC_FIELDS[i]) {tool_err("catalog ABI differs: ");tool_errln(name);return false;}}return true;}
rtc_abi_json :: (o:[]Jo) {
  jo_obj(o);for name,i:RTC_NAMES {jo_key(o,name);jo_arr(o);field:=0;while true {word:=rtq_word(RTC_FIELDS[i],field);if word.count==0 {break;}jo_str(o,word);field+=1;}jo_end(o);}jo_end(o);
}
rtc_authenticate_snapshot :: (d:Jv,directory:string,deadline:int)->bool {
  commit:[128]u8;count:=jv_str(d,jv_get(d,0,"reference_commit"),commit[..]);if count<1 {return false;}
  hashes:=jv_get(d,0,"sources_sha256");if jv_kind(d,hashes)!=JV_OBJECT {return false;}
  child:=d.nodes[hashes].first;out:[16777216]u8;err:[65536]u8;env:[]string;sequence:=0;
  while child!=-1 {
    ref:[8192]u8;o:[1]Jo;jo_start(o[..],ref[..]);jo_put(o[..],cast(string)commit[0..<count]);jo_put(o[..],":");jo_put(o[..],jv_key(d,child));
    label:[128]u8;label_writer:[1]Jo;jo_start(label_writer[..],label[..]);jo_put(label_writer[..],"reference-source-");jo_int(label_writer[..],sequence);sequence+=1;
    argv:=[3]string.["git","show",jo_text(o[..])];r:=rtq_command(argv[..],env,deadline,directory,jo_text(label_writer[..]),out[..],err[..]);hash:[64]u8;
    if !rtq_ok(r) || !S_hex(S_hash(cast(string)out[0..<r.out_n]),hash[..]) || !rtc_literal(d,child,cast(string)hash[..]) {tool_err("frozen source hash differs: ");tool_errln(jv_key(d,child));return false;}
    child=d.nodes[child].next;
  }return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}
  header_path:=args_value(a[..],"--check-header","");
  if header_path.count>0 {bytes:[1048576]u8;n:=fs_read(header_path,bytes[..]);return ifx n>=0 && rtc_abi(cast(string)bytes[0..<n]) then 0 else 1;}
  cwd:[4096]u8;root:=fs_cwd(cwd[..]);work:=args_value(a[..],"--work-dir","");receipt:=args_value(a[..],"--receipt","");
  if work.count==0 || receipt.count==0 || !fs_mkdir(work) {tool_errln("usage: check-catalog --work-dir DIR --receipt FILE [--coax FILE] [--modes ...]");return 2;}
  modes:[3]string;mode_count:=rtc_modes(a[..],modes[..]);if mode_count<0 {tool_errln("invalid mode list");return 2;}
  compiler_buf:[4096]u8;env_coax:=proc_getenv("COAX",compiler_buf[..]);if env_coax.count==0 {env_coax="coax/bin/coax";}compiler:=args_value(a[..],"--coax",env_coax);
  paths:[12][4096]u8;digest_path:=fs_join(fs_dir(compiler),"source-digest",paths[0][..]);digest_path=args_value(a[..],"--compiler-source-digest",digest_path);
  compiler_hash:[64]u8;if !rtq_hash_file(compiler,compiler_hash[..]) {tool_errln("cannot hash selected compiler");return 1;}
  self_path:[4096]u8;self_count:=cxproc_self_path(self_path[..]);if self_count<1 || self_count>self_path.count {return 1;}self_image:=cast(string)self_path[0..<self_count];self_hash:[64]u8;if !rtq_hash_file(self_image,self_hash[..]) {return 1;}
  start:=proc_now_ms();deadline:=proc_deadline(RTQ_DEADLINE_MS,start);env:[]string;stdout:[RTQ_FILE]u8;stderr:[65536]u8;
  version_args:=[2]string.[compiler,"version"];run:=rtq_command(version_args[..],env,deadline,work,"compiler-version",stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
  version:[4096]u8;version_writer:[1]Jo;jo_start(version_writer[..],version[..]);jo_put(version_writer[..],rtq_trim(cast(string)stdout[0..<run.out_n]));version_count:=version_writer[0].n;
  current_args:=[3]string.[compiler,"source-digest",root];run=rtq_command(current_args[..],env,deadline,work,"compiler-current-source",stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
  current:[4096]u8;current_writer:[1]Jo;jo_start(current_writer[..],current[..]);jo_put(current_writer[..],rtq_trim(cast(string)stdout[0..<run.out_n]));current_count:=current_writer[0].n;
