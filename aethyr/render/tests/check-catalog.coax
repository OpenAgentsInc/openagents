  if !rtq_json_file(manifest_path,manifest_bytes[..],manifest_nodes[..],manifest[..]) {return 1;}
  consumer_bytes:[1048576]u8;consumers:=rtc_consumers(snapshot[0],manifest[0],consumer_bytes[..]);if !consumers.ok {tool_errln("current realm consumer inventory differs or has an untracked renderer");return 1;}
  if !fs_write(fs_join(work,"consumers.json",paths[2][..]),cast(string)consumer_bytes[0..<consumers.bytes]) {return 1;}
  fixture:="aethyr/render/tests/catalog-native.coax";native:="aethyr/render/tests/catalog-native.c";inputs:[1]RtqInputs;
  if !rtq_deps(inputs[..],compiler,fixture,deadline,work,"catalog-dependencies") || !rtq_deps(inputs[..],compiler,"aethyr/render/tests/check-catalog.coax",deadline,work,"qualifier-dependencies") || !rtq_deps(inputs[..],compiler,"coax/lib/crypto/entropy.coax",deadline,work,"qualifier-entropy-dependencies") {return 1;}
  for path:[7]string.[native,snapshot_path,manifest_path,"aethyr/render/tests/check-catalog.coax","aethyr/render/tests/catalog-tool-policy.coax","aethyr/render/tests/tooling-policy.coax","aethyr/render/tests/qualification-files.coax"] {if !rtq_input_add(inputs[..],path) {return 1;}}
  for name:[6]string.["tool-native","process-native","store-file-native","socket-native","entropy-native","entropy-foreign"] {
    for ext:[2]string.[".c",".h"] {path:[4096]u8;w:[1]Jo;jo_start(w[..],path[..]);jo_put(w[..],"coax/platform/");jo_put(w[..],name);jo_put(w[..],ext);if !rtq_input_add(inputs[..],jo_text(w[..])) {return 1;}}
  }
  if !rtq_input_add(inputs[..],"coax/web/tool.sh") {return 1;}
  if fs_exists(receipt) {
    old_bytes:[1048576]u8;old_nodes:[32768]JvNode;old:[1]Jv;if !rtq_json_file(receipt,old_bytes[..],old_nodes[..],old[..]) {return 1;}
    hash_map:[1048576]u8;w:[1]Jo;jo_start(w[..],hash_map[..]);rtq_inputs_json(w[..],inputs[..],root);map_nodes:[8192]JvNode;map_doc:[1]Jv;if !jv_parse(map_doc[..],jo_text(w[..]),map_nodes[..]) {return 1;}
    if rtc_literal(old[0],jv_get(old[0],0,"compiler_sha256"),cast(string)compiler_hash[..]) && rtq_equal(old[0],jv_get(old[0],0,"source_sha256"),map_doc[0],0) {tool_errln("unchanged source/compiler inventory already qualified; retain its receipt");return 1;}
  }
  mode_record:[1048576]u8;o:[1]Jo;jo_start(o[..],mode_record[..]);jo_arr(o[..]);emitted:[2]bool;source_paths:[2][4096]u8;header_paths:[2][4096]u8;
  for mode_index:0..<mode_count {
    mode:=modes[mode_index];release:=mode=="release";index:=ifx release then 1 else 0;directory:=fs_join(work,ifx release then "wrapping" else "checked",paths[3][..]);if !fs_mkdir(directory) {return 1;}
    source:=fs_join(directory,"catalog.c",source_paths[index][..]);header:=fs_join(directory,"catalog.h",header_paths[index][..]);
    if !emitted[index] {
      command:=[7]string.[compiler,"c",fixture,"--library","--header",header,"--release"];count:=ifx release then 7 else 6;run=rtq_command(command[0..<count],env,deadline,directory,"emission",stdout[..],stderr[..]);if !rtq_ok(run) || !fs_write(source,cast(string)stdout[0..<run.out_n]) {return 1;}
      if rtq_find(cast(string)stderr[0..<run.err_n],"compiler is out of date",0)>=0 {stale=true;if !args_has(a[..],"--explore-stale-compiler") {tool_errln("compiler differs from current source; rebuild before final qualification");return 1;}}
      header_bytes:[1048576]u8;hn:=fs_read(header,header_bytes[..]);if hn<0 || !rtc_abi(cast(string)header_bytes[0..<hn]) {return 1;}emitted[index]=true;
    }
    name:[256]u8;nwriter:[1]Jo;jo_start(nwriter[..],name[..]);jo_put(nwriter[..],"catalog-");jo_put(nwriter[..],mode);exe:=fs_join(work,jo_text(nwriter[..]),paths[4][..]);
    cc:[16]string;cn:=0;cc[cn]="clang";cn+=1;cc[cn]="-std=c11";cn+=1;cc[cn]=ifx release then "-O2" else "-O0";cn+=1;if !release {cc[cn]="-g";cn+=1;}
    if mode=="sanitized" {cc[cn]="-fsanitize=address,undefined";cn+=1;cc[cn]="-fno-omit-frame-pointer";cn+=1;}
    for arg:[8]string.["-I",directory,source,native,"-lm","-o",exe,""] {if arg.count>0 {cc[cn]=arg;cn+=1;}}
    run=rtq_command(cc[0..<cn],env,deadline,work,jo_text(nwriter[..]),stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
    native_env:[2]string;env_count:=0;if mode=="sanitized" {native_env[0]="ASAN_OPTIONS=detect_leaks=0:halt_on_error=1";native_env[1]="UBSAN_OPTIONS=halt_on_error=1";env_count=2;}
    execute:=[2]string.[exe,""];run=rtq_command(execute[0..<1],native_env[0..<env_count],deadline,work,mode,stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
    actual_nodes:[32768]JvNode;actual:[1]Jv;if !jv_parse(actual[..],cast(string)stdout[0..<run.out_n],actual_nodes[..]) || !rtq_equal(actual[0],0,expected_doc[0],0) {tool_errln("native catalog receipt differs from frozen declarations");return 1;}
    transcript_name:[128]u8;tw:[1]Jo;jo_start(tw[..],transcript_name[..]);jo_put(tw[..],mode);jo_put(tw[..],".json");transcript_path:[4096]u8;transcript:=fs_join(work,jo_text(tw[..]),transcript_path[..]);if !fs_write(transcript,cast(string)stdout[0..<run.out_n]) {return 1;}
    transcript_hash:[64]u8;if !S_hex(S_hash(cast(string)stdout[0..<run.out_n]),transcript_hash[..]) {return 1;}
    for fault:RTC_FAULTS {
      execute[1]=fault;label:[256]u8;fw:[1]Jo;jo_start(fw[..],label[..]);jo_put(fw[..],mode);jo_put(fw[..],"-");jo_put(fw[..],fault);run=rtq_command(execute[..],native_env[0..<env_count],deadline,work,jo_text(fw[..]),stdout[..],stderr[..]);
      if !rtq_ok(run) || !jv_parse(actual[..],cast(string)stdout[0..<run.out_n],actual_nodes[..]) || rtq_equal(actual[0],0,expected_doc[0],0) {tool_errln("catalog producer loss was not detected");return 1;}
    }
    jo_obj(o[..]);jo_key(o[..],"mode");jo_str(o[..],mode);jo_key(o[..],"profiles");jo_int(o[..],jv_len(expected_doc[0],0));jo_key(o[..],"transcript_sha256");jo_str(o[..],cast(string)transcript_hash[..]);
    jo_key(o[..],"transcript");jo_str(o[..],transcript);jo_key(o[..],"unique_logical_bindings");jo_int(o[..],jv_len(snapshot[0],jv_get(snapshot[0],0,"bindings")));jo_key(o[..],"unique_pipelines");jo_int(o[..],jv_len(snapshot[0],all_passes));jo_key(o[..],"unique_binding_uses");jo_int(o[..],binding_uses);
    for key,which:[3]string.["generated_c_sha256","generated_header_sha256","executable_sha256"] {hash:[64]u8;target:=ifx which==0 then source else ifx which==1 then header else exe;if !rtq_hash_file(target,hash[..]) {return 1;}jo_key(o[..],key);jo_str(o[..],cast(string)hash[..]);}
    jo_key(o[..],"producer_faults_detected");jo_arr(o[..]);for fault:RTC_FAULTS {jo_str(o[..],fault);}jo_end(o[..]);jo_end(o[..]);
  }jo_end(o[..]);
  final_hash:[64]u8;if !rtq_hash_file(compiler,final_hash[..]) || cast(string)final_hash[..]!=cast(string)compiler_hash[..] || !rtq_inputs_match(inputs[..]) {return 1;}
  if !rtq_hash_file(self_image,final_hash[..]) || cast(string)final_hash[..]!=cast(string)self_hash[..] {return 1;}
  record:[2097152]u8;writer:[1]Jo;jo_start(writer[..],record[..]);jo_obj(writer[..]);jo_key(writer[..],"schema");jo_str(writer[..],"aethyr.render.catalog.inventory.v1");jo_key(writer[..],"status");jo_str(writer[..],ifx stale then "exploratory" else "pass");
