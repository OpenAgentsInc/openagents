  }}
 jo_obj(record);jo_key(record,"case");jo_str(record,label);jo_key(record,"expected_exit");jo_int(record,wanted.code);jo_key(record,"actual_exit");jo_int(record,r.status);jo_key(record,"passed");jo_bool(record,okay);jo_end(record);return okay;
}
