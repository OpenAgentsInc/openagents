CICT_FLAGS :: [15]string.["--cpu","--gpu","--gpu-format","--width","--height","--profile","--certificate","--geometry","--mask","--oracle-source","--edges","--witnesses","--zero-mask","--zero-radius","--receipt"];
CictExpect :: struct {code:int;raw:string;scope:string;full_colour:int=-1;scope_colour:int=-1;nonfinite:int=-1;excluded:int=-1;early:string;}
cict_word :: (bytes:[]u8,at:int,word:u32) {for k:0..<4 {bytes[at+k]=cast,trunc(u8)(word>>cast(u32)(8*k));}}
cict_copy :: (source:string,dest:string)->bool {bytes:[8388608]u8;n:=fs_size(source);return n>=0 && n<=bytes.count && fs_read_at(source,0,bytes[0..<n])==n && fs_write(dest,cast(string)bytes[0..<n]);}
