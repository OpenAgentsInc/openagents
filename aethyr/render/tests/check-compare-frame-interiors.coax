   if jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.render.pinned-interior-comparison.v1" || jv_raw(d[0],jv_get(d[0],0,"status"))!=wanted.scope || jv_raw(d[0],jv_get(d[0],full,"status"))!=wanted.raw || jv_raw(d[0],jv_get(d[0],scope,"status"))!=(ifx wanted.code==0 then "pass" else "fail") || jv_int(d[0],jv_get(d[0],0,"masked_pixels"),-1)!=159 || jv_int(d[0],jv_get(d[0],0,"unqualified_channels"),-1)!=636 || jv_int(d[0],jv_get(d[0],full,"checked_channels"),-1)!=230400 || jv_int(d[0],jv_get(d[0],scope,"checked_channels"),-1)!=229764 {okay=false;}
