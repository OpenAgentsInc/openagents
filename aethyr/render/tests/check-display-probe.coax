dpq_spawn :: (argv:[]string)->int {h:=proc_new();if h<0 {return -1;}for arg:argv {if !proc_arg(h,arg){_:=proc_release(h);return -1;}}if proc_start(h)!=0 {_:=proc_release(h);return -1;}return h;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=4 {tool_errln("usage: check-display-probe REACTOR PACKAGE_DIR PROBE_DIR NEW_OUT");return 2;}wasm:=args_at(a[..],0);package:=args_at(a[..],1);fixture:=args_at(a[..],2);out:=args_at(a[..],3);if !fs_mkdir(out) {return 1;}listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 paths:[8][4096]u8;site:=fs_join(out,"site",paths[0][..]);if !fs_mkdir(site)||!fs_write(fs_join(site,"index.html",paths[1][..]),"<!doctype html><title>Display conversion probe</title>") {return 1;}raw:[4194304]u8;wn:=fs_read(wasm,raw[..]);if wn<1||!fs_write(fs_join(site,"renderer.wasm",paths[1][..]),cast(string)raw[0..<wn]) {return 1;}
 inputs:[1]RtqInputs;for file:[5]string.[wasm,"coax/web/render.js","coax/web/render-face.c","aethyr/render/tests/display-probe-effects.js","aethyr/render/tests/display-probe.coax"] {if !rtq_input_add(inputs[..],file) {return 1;}}
 copy:=[3]string.["cp","-R",package];cp:[4]string;for i:0..<3 {cp[i]=copy[i];}cp[3]=fs_join(site,"package",paths[2][..]);stderr:[65536]u8;env:[]string;r:=rtq_command(cp[..],env,proc_now_ms()+30000,out,"package-copy",raw[..],stderr[..]);if !rtq_ok(r) {return 1;}
 manifest:=fs_join(package,"render.json",paths[3][..]);if !rtq_input_add(inputs[..],manifest) {return 1;}json:[262144]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(manifest,json[..],nodes[..],doc[..]) {return 1;}d:=doc[0];name:[4096]u8;
 for key:[2]string.["modules","entries"] {array:=jv_get(d,0,key);for i:0..<jv_len(d,array) {row:=jv_at(d,array,i);for field:[3]string.["wgsl_file","spirv_file","tree_file"] {v:=jv_get(d,row,field);if v<0 {continue;}n:=jv_str(d,v,name[..]);if n<1||!rtq_input_add(inputs[..],fs_join(package,cast(string)name[0..<n],paths[4][..])) {return 1;}}}}
 root:=fs_cwd(paths[5][..]);host:=fs_join(root,"coax/web",paths[6][..]);argv:=[9]string.["coax/web/serve.sh",site,"--host-dir",host,"--listen","127.0.0.1:9179","--static","--cache","0"];server:=dpq_spawn(argv[..]);if server<0 {return 1;}defer {k:=proc_kill(server,PROC_SIGTERM);w:=proc_wait(server,2000);done:=proc_release(server);}
 waiting:[1]Cdp;body:[4096]u8;ready:=false;for attempt:0..<100 {if cdp_get(waiting[..],9179,"/",body[..])>0 {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
 c:[1]Cdp;if !cdp_launch(c[..],256,256,"coax-display-probe-") {return 1;}defer {cdp_close(c[..]);}nav:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9179/\"}",30000);ready=false;for attempt:0..<100 {if wc_eval(c[..],"document.readyState==='complete'&&location.hostname==='127.0.0.1'")=="true" {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
 glue:[65536]u8;n:=fs_read(WC_HOST_FILE,glue[..]);if n<1||wc_eval(c[..],cast(string)glue[0..<n])!="ready" {return 1;}n=fs_read("aethyr/render/tests/display-probe-effects.js",glue[..]);if n<1||wc_eval(c[..],cast(string)glue[0..<n])!="ready" {return 1;}
 for file:[2]string.["plan.json","source.rgba16f"] {path:=fs_join(fixture,file,paths[4][..]);n=fs_read(path,raw[..]);if n<1||!rtq_input_add(inputs[..],path)||!wc_file(c[..],file,cast(string)raw[0..<n]) {return 1;}}
 value:=cdp_evaluate(c[..],"displayProbeEffects.run().then(v=>JSON.stringify(v),e=>JSON.stringify({error:String(e.stack)}))");sdk_bytes:[65536]u8;sdk_n:=jv_str(cdp_doc(c[..]),value,sdk_bytes[..]);if sdk_n<1 {tool_errln(cdp_error(c[..]));return 1;}sdk:=cast(string)sdk_bytes[0..<sdk_n];if !fs_write(fs_join(out,"sdk.json",paths[7][..]),sdk)||!jv_parse(doc[..],sdk,nodes[..]) {tool_errln(cdp_error(c[..]));return 1;}if jv_get(doc[0],0,"error")>=0 {tool_errln(sdk);return 1;}print("Actual WebGPU display readback complete.\n");result:[65536]u8;o:[1]Jo;
 got:[262144]u8;encoded:[32768]u8;code:[256]u8;at:=0;while at<got.count {chunk:=ifx got.count-at<16384 then got.count-at else 16384;jo_start(o[..],code[..]);jo_put(o[..],"displayProbeEffects.read(");jo_int(o[..],at);jo_put(o[..],",");jo_int(o[..],chunk);jo_put(o[..],")");value=cdp_evaluate(c[..],jo_text(o[..]));if value<0 {return 1;}en:=jv_str(cdp_doc(c[..]),value,encoded[..]);if en<1||b64_decode(cast(string)encoded[0..<en],got[at..<at+chunk])!=chunk {return 1;}at+=chunk;}
 different:=0;for pixel:0..<DISPLAY_PROBE_PIXELS {for channel:0..<4 {sdk_channel:=ifx channel<3 then 2-channel else 3;if cast(int)got[pixel*4+sdk_channel]!=dpq_expected(pixel,channel) {different+=1;}}}
 same:=rtq_inputs_match(inputs[..]);if !fs_write(fs_join(out,"display.bgra8",paths[7][..]),cast(string)got[..]) {return 1;}jo_start(o[..],result[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.display-probe-comparison.v1");jo_key(o[..],"private_iteration_only");jo_bool(o[..],true);jo_key(o[..],"channels");jo_int(o[..],got.count);jo_key(o[..],"different");jo_int(o[..],different);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);if o[0].bad||!fs_write(fs_join(out,"comparison.json",paths[7][..]),jo_text(o[..])) {return 1;}print("Actual browser display bytes: % channels, % different.\n",got.count,different);return ifx different==0&&same then 0 else 1;
}
