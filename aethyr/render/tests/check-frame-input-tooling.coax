#import "Basic";
#load "native-qualification.coax";
#load "frame-input-cases.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<4 {return 2;}fixture:=args_at(a[..],0);native_receipt:=args_at(a[..],1);image:=args_at(a[..],2);work:=args_at(a[..],3);if !fs_mkdir(work) {return 1;}bytes:[1048576]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(fixture,bytes[..],nodes[..],doc[..]) {return 1;}d:=doc[0];probe:[65536]u8;pn:=jv_str(d,jv_get(d,0,"probe"),probe[..]);if pn<0 || cast(string)probe[0..<pn]!=RFI_PROBE {return 1;}cases:=jv_get(d,0,"cases");if jv_len(d,cases)!=RFI_CASES.count {return 1;}
 for c,i:RFI_CASES {row:=jv_at(d,cases,i);values:=[3]string.[c.name,c.text,c.stdout];for value,k:values {column:=[3]int.[0,1,3][k];out:[65536]u8;n:=jv_str(d,jv_at(d,row,column),out[..]);if n<0 || cast(string)out[0..<n]!=value {return 1;}}if jv_int(d,jv_at(d,row,2),-1)!=c.status || jv_kind(d,jv_at(d,row,4))!=(ifx c.textures then JV_TRUE else JV_FALSE) {return 1;}}
 nb:[1048576]u8;nn:[16384]JvNode;nd:[1]Jv;if !rtq_json_file(native_receipt,nb[..],nn[..],nd[..]) {return 1;}observations:=jv_get(nd[0],0,"observations");if jv_len(nd[0],observations)!=RFI_CASES.count {return 1;}for c,i:RFI_CASES {row:=jv_at(nd[0],observations,i);if jv_int(nd[0],jv_get(nd[0],row,"status"),-1)!=c.status {return 1;}}
 path:[4096]u8;stale:=fs_join(work,"default-gate",path[..]);compiler:="/tmp/aethyr-authority-budget-qualified-1fac/coax";digest:="/Users/christopherdavid/work/openagents-aethyr-check-budgets-current/coax/bin/source-digest";argv:=[7]string.[image,"--out",stale,"--coax",compiler,"--compiler-source-digest",digest];stdout:[65536]u8;stderr:[65536]u8;env:[]string;r:=rtq_run_raw(argv[..],env,810000,stdout[..],stderr[..]);list:[1]FsList;if r.started!=0 || r.timed_out || r.status==0 || fs_list(stale,list[..])!=6 {return 1;}for i:0..<list[0].n {name:=fs_entry(list[..],i);if rtq_find(name,"compiler-version.",0)!=0 && rtq_find(name,"compiler-current-source.",0)!=0 {return 1;}}
 report:="{\"status\":\"pass\",\"same_input_cases\":20,\"exact_original_probe_bytes\":true,\"default_source_gate_identity_files\":6,\"renderer_executions\":0}";if !fs_write(fs_join(work,"qualification.json",path[..]),report) {return 1;}print("frame-input fixtures and exact C probe match; default source gate refuses before fixtures\n");return 0;
