// Bounded tests of the unchanged native frame-input transport effects.
#import "Basic";
#load "native-qualification.coax";
#load "frame-input-cases.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) {return 2;}work_arg:=args_value(a[..],"--out","");if work_arg.count==0 || !fs_mkdir(work_arg) {return 2;}paths:[10][4096]u8;work:=fs_realpath(work_arg,paths[0][..]);root:=fs_cwd(paths[1][..]);start:=proc_now_ms();deadline:=proc_deadline(RTQ_DEADLINE_MS,start);selected_buf:[4096]u8;selected:=proc_getenv("COAX",selected_buf[..]);if selected.count==0 {selected="coax/bin/coax";}compiler:=args_value(a[..],"--coax",selected);digest:=args_value(a[..],"--compiler-source-digest",fs_join(fs_dir(compiler),"source-digest",paths[2][..]));identity:[1]RtnCompiler;identity[0]=rtn_compiler(compiler,digest,root,work,deadline);if !identity[0].ok || (!identity[0].matching && !args_has(a[..],"--explore-stale-compiler")) {tool_errln("source-matching compiler required before transport fixture emission");return 1;}
 sources:[1]RtqInputs;if !rtn_tool_sources(sources[..],compiler,"aethyr/render/tests/check-frame-input.coax",work,deadline) || !rtq_input_add(sources[..],"aethyr/render/tests/frame-input.h") || !rtq_input_add(sources[..],compiler) || !rtq_input_add(sources[..],digest) {return 1;}self:[4096]u8;self_n:=cxproc_self_path(self[..]);self_hash:[64]u8;if self_n<1 || self_n>self.count || !rtq_input_add(sources[..],cast(string)self[0..<self_n]) || !rtq_hash_file(cast(string)self[0..<self_n],self_hash[..]) {return 1;}
 payload:=[8]u8.[0,1,2,3,4,5,6,7];if !fs_write(fs_join(work,"payload.bin",paths[3][..]),cast(string)payload[..]) || !fs_write(fs_join(work,"render.json",paths[3][..]),"{}") || !fs_write(fs_join(work,"shader.tree",paths[3][..]),"3 0") || !fs_write(fs_join(work,"media.txt",paths[3][..]),RFI_RAW_MEDIA) {return 1;}source:=fs_join(work,"probe.c",paths[3][..]);exe:=fs_join(work,"probe",paths[4][..]);if !fs_write(source,RFI_PROBE) {return 1;}compile:=[11]string.["clang","-std=c11","-Wall","-Wextra","-Werror","-I","aethyr/render/tests",source,"-o",exe,""];stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(compile[0..<10],env,deadline,work,"compile",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}held:[1]RtqInputs;for name:[7]string.[source,exe,fs_join(work,"payload.bin",paths[5][..]),fs_join(work,"render.json",paths[6][..]),fs_join(work,"shader.tree",paths[7][..]),fs_join(work,"media.txt",paths[8][..]),"aethyr/render/tests/frame-input.h"] {if !rtq_input_add(held[..],name) {return 1;}}
 record:[1048576]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.frame-input-tool.v1");jo_key(o[..],"qualification");jo_bool(o[..],false);jo_key(o[..],"qualification_status");jo_str(o[..],ifx identity[0].matching then "transport controls only" else "exploratory");rtn_compiler_json(o[..],compiler,identity[..]);jo_key(o[..],"qualifier_executable_sha256");jo_str(o[..],cast(string)self_hash[..]);jo_key(o[..],"observations");jo_arr(o[..]);
 for c:RFI_CASES {config:=fs_join(work,"frame.config",paths[9][..]);if !fs_write(config,c.text) {return 1;}argv:=[3]string.[exe,config,"textures"];run:=rtq_command(argv[0..<(ifx c.textures then 3 else 2)],env,deadline,work,c.name,stdout[..],stderr[..]);if run.started!=0 || run.timed_out || run.cut || run.status!=c.status || (c.status==0 && cast(string)stdout[0..<run.out_n]!=c.stdout) {tool_err("frame transport differs: ");tool_errln(c.name);return 1;}jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],c.name);jo_key(o[..],"status");jo_int(o[..],run.status);jo_key(o[..],"stdout");jo_str(o[..],cast(string)stdout[0..<run.out_n]);jo_key(o[..],"stderr");jo_str(o[..],cast(string)stderr[0..<run.err_n]);jo_end(o[..]);}jo_end(o[..]);if !rtq_inputs_match(held[..]) || !rtq_inputs_match(sources[..]) {return 1;}jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],sources[..],root);jo_key(o[..],"fixture_sha256");rtq_inputs_json(o[..],held[..],"");rtn_elapsed(o[..],proc_now_ms()-start);jo_key(o[..],"status");jo_str(o[..],"pass");jo_end(o[..]);if o[0].bad || !fs_write(fs_join(work,"qualification.json",paths[9][..]),jo_text(o[..])) {return 1;}print("frame input: all20 original raw transport controls, including NUL bytes\n");return 0;
}
