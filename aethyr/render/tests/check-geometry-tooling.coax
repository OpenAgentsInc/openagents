// Own-code fixture orchestration; independent unbounded-integer equations
// stay in check_geometry.py and are called only as a reference oracle.
#import "Basic";
#load "native-qualification.coax";
#load "reference-frame-tool-policy.coax";
RGT_NAMES :: [6]string.["FrameCounts","RenderGeometryBuffer","RenderGeometryResult","RenderDirectDomains","RenderDrawDomain","RenderFrameResult"];
RGT_FIELDS :: [6]string.["width height hud_vertices vertex_stride draw_count water_draws grass_instances particle_instances surface_vertices caster_vertices caster_instances","binding_set resource words","status bad_draw bad_resource work direct","hud_vertices grass_instances particle_instances surface_vertices caster_vertices caster_instances","vertex_begin vertices vertex_alt_begin vertex_alt_end instance_begin instances indices","status bad_upload bad_draw bad_direct checked_indices admitted_draws"];
RGT_BASE :: "{\"result\":{\"geometry_status\":0,\"frame_status\":0,\"bad_draw\":-1,\"bad_resource\":-1,\"work\":5,\"frame_bad_draw\":-1,\"frame_bad_upload\":-1,\"frame_bad_direct\":-1,\"frame_admitted_draws\":2,\"frame_checked_indices\":3,\"domains\":[[0,3,0,0,0,1,3],[0,3,0,0,0,1,3]],\"direct\":[8,0,0,0,0,0]},\"counts\":{\"draws\":2,\"hud\":6,\"grass\":0,\"particles\":0,\"surface\":0,\"caster_vertices\":0,\"caster_instances\":0},\"draws\":[0,3,0,1,0,3,2147483648,1],\"indices\":[0,2,1]}";
rgt_run :: (argv:[]string,env:[]string,good:bool,out:string,label:string)->bool {stdout:[1048576]u8;stderr:[65536]u8;r:=rtq_command(argv,env,proc_deadline(810000,proc_now_ms()),out,label,stdout[..],stderr[..]);if r.started!=0 || r.timed_out || r.cut {return false;}if good {return r.status==0;}return r.status==1 && rtq_find(cast(string)stderr[0..<r.err_n],ifx label=="stale-default-gate" then "source digests differ" else "AssertionError",0)>=0;}
rgt_header :: (text:string)->bool {for name,i:RGT_NAMES {if !rtq_fields(text,name,RGT_FIELDS[i]) {return false;}}return true;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<2 {tool_errln("OUT IDENTITY_FIXTURE");return 2;}out_arg:=args_at(a[..],0);mock:=args_at(a[..],1);if !fs_mkdir(out_arg) {return 1;}canonical:[4096]u8;out:=fs_realpath(out_arg,canonical[..]);paths:[9][4096]u8;held:[1]RtqInputs;compiler_bytes:[4096]u8;compiler:=proc_getenv("COAX",compiler_bytes[..]);if compiler.count==0 {compiler="coax/bin/coax";}if !rtn_tool_sources(held[..],compiler,"aethyr/render/tests/check-geometry-tooling.coax",out,proc_deadline(810000,proc_now_ms())) || !rtq_input_add(held[..],compiler) || !rtq_input_add(held[..],"aethyr/render/tests/geometry-identity-fixture.coax") {return 1;}self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 || self_n>self.count || !rtq_input_add(held[..],cast(string)self[0..<self_n]) {return 1;}if !rtq_input_add(held[..],"aethyr/render/tests/check_geometry.py") || !rtq_input_add(held[..],"aethyr/render/tests/check-geometry-tooling.coax") || !rtq_input_add(held[..],mock) {return 1;}fixture:=fs_join(out,"fixture.json",paths[0][..]);script:="import sys,json;sys.path.insert(0,sys.argv[1]);import check_geometry as q;d=json.load(open(sys.argv[2]));q.wire_audit(d['result'],d['counts'],tuple(d['draws']),tuple(d['indices']))";argv:=[5]string.["python3","-c",script,"aethyr/render/tests",fixture];env:[]string;
 if !fs_write(fixture,RGT_BASE) || !rgt_run(argv[..],env,true,out,"wire-positive") {return 1;}for which:0..<7 {needle:=[7]string.["[0,3,0,0,0,1,3]","[0,3,0,0,0,1,3]]","\"direct\":[8,","\"frame_checked_indices\":3","\"frame_admitted_draws\":2","\"frame_status\":0","\"indices\":[0,2,1]"][which];value:=[7]string.["[0,2,0,0,0,1,3]","[0,3,0,0,0,0,3]]","\"direct\":[5,","\"frame_checked_indices\":0","\"frame_admitted_draws\":1","\"frame_status\":1","\"indices\":[0,2,3]"][which];bytes:[16384]u8;changed:=rfr_test_edit(RGT_BASE,needle,value,bytes[..]);label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"wire-refusal-");jo_int(w[..],which);if !fs_write(fixture,changed) || !rgt_run(argv[..],env,false,out,jo_text(w[..])) {return 1;}}
 atomic:="{\"geometry_status\":4,\"domains\":[[0,99,0,0,0,0,0]]}";if !fs_write(fixture,atomic) {return 1;}argv[2]="import sys,json;sys.path.insert(0,sys.argv[1]);import check_geometry as q;q.atomic_refusal(json.load(open(sys.argv[2])),1)";if !rgt_run(argv[..],env,true,out,"atomic-positive") {return 1;}changed_atomic:[4096]u8;if !fs_write(fixture,rfr_test_edit(atomic,"99","3",changed_atomic[..])) || !rgt_run(argv[..],env,false,out,"atomic-partial-publication") {return 1;}
 header_bytes:[16384]u8;o:[1]Jo;jo_start(o[..],header_bytes[..]);for name,i:RGT_NAMES {jo_put(o[..],"struct coax_t_");jo_put(o[..],name);jo_put(o[..]," {");n:=0;while true {field:=rtq_word(RGT_FIELDS[i],n);if field.count==0 {break;}jo_put(o[..],"int ");jo_put(o[..],field);jo_put(o[..],";");n+=1;}jo_put(o[..],"};\n");}header:=jo_text(o[..]);if o[0].bad || !rgt_header(header) || !fs_write(fixture,header) {return 1;}argv[2]="import sys;sys.path.insert(0,sys.argv[1]);import check_geometry as q;q.header_inventory(open(sys.argv[2]).read())";if !rgt_run(argv[..],env,true,out,"header-positive") {return 1;}for which:0..<2 {changed:[16384]u8;candidate:=rfr_test_edit(header,"int work;",ifx which==0 then "" else "int work;int hidden;",changed[..]);if rgt_header(candidate) || !fs_write(fixture,candidate) || !rgt_run(argv[..],env,false,out,ifx which==0 then "header-omission" else "header-addition") {return 1;}}
 root:=fs_join(out,"stale-root",paths[1][..]);bin_dir:=fs_join(root,"coax/bin",paths[2][..]);if !fs_mkdir(bin_dir) {return 1;}binary:=fs_join(bin_dir,"coax",paths[3][..]);copy:=[3]string.["/bin/cp",mock,binary];if !rgt_run(copy[..],env,true,out,"identity-copy") || !fs_write(fs_join(bin_dir,"source-digest",paths[4][..]),"old\n") {return 1;}journal:=fs_join(out,"identity-journal",paths[4][..]);if !fs_write(journal,"") {return 1;}env_bytes:[8192]u8;ew:[1]Jo;jo_start(ew[..],env_bytes[..]);jo_put(ew[..],"AETHYR_GEOMETRY_IDENTITY_LOG=");jo_put(ew[..],journal);mock_env:=[1]string.[jo_text(ew[..])];work:=fs_join(root,"work",paths[5][..]);receipt:=fs_join(root,"receipt.json",paths[6][..]);script="import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);import check_geometry as q;q.ROOT=Path(sys.argv[2]);sys.argv=['check_geometry.py','--captures',str(q.ROOT/'missing'),'--work-dir',sys.argv[3],'--receipt',sys.argv[4]];q.main()";stale:=[7]string.["python3","-c",script,"aethyr/render/tests",root,work,receipt];if !rgt_run(stale[..],mock_env[..],false,out,"stale-default-gate") || fs_exists(receipt) {return 1;}journal_bytes:[4096]u8;n:=fs_read(journal,journal_bytes[..]);if n<0 || cast(string)journal_bytes[0..<n]!="version\nsource-digest\n" {return 1;}list:[1]FsList;if fs_list(work,list[..])!=0 || !rtq_inputs_match(held[..]) {return 1;}
 record:[65536]u8;rw:[1]Jo;jo_start(rw[..],record[..]);jo_obj(rw[..]);jo_key(rw[..],"status");jo_str(rw[..],"pass");jo_key(rw[..],"qualification");jo_bool(rw[..],false);jo_key(rw[..],"scope");jo_str(rw[..],"Small independent-oracle unit controls only; no product geometry execution or current-compiler release qualification.");jo_key(rw[..],"wire_refusals");jo_int(rw[..],7);jo_key(rw[..],"atomic_refusal_outcomes");jo_int(rw[..],2);jo_key(rw[..],"header_controls");jo_int(rw[..],3);jo_key(rw[..],"default_identity_calls");jo_arr(rw[..]);jo_str(rw[..],"version");jo_str(rw[..],"source-digest");jo_end(rw[..]);jo_key(rw[..],"source_sha256");rtq_inputs_json(rw[..],held[..],"");jo_end(rw[..]);if rw[0].bad || !fs_write(fs_join(out,"qualification.json",paths[7][..]),jo_text(rw[..])) {return 1;}print("geometry tooling: original small oracle controls, ABI inventory and actual stale ordering\n");return 0;
}
