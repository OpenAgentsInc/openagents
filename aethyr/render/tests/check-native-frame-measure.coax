// Local retained SDK metadata regression; no SSH, compiler or GPU execution.
#import "Basic";
#load "native-frame-measure-files.coax";
tool_main :: ()->int #export_c {
 args:[1]Args;if !args_load(args[..]) {return 2;}file:=args_value(args[..],"--layer","");expected:=args_value(args[..],"--expected-library","");if file=="" || expected=="" {return 2;}library:[4096]u8;n:=nfm_layer_library(file,library[..]);okay:=n==expected.count && n>0 && cast(string)library[0..<n]==expected;print("retained SDK metadata complete parse: % (%bytes)\n",okay,fs_size(file));work:=args_value(args[..],"--work-dir","");if work=="" {return ifx okay then 0 else 1;}listing:[1]FsList;if !fs_mkdir(work) || fs_list(work,listing[..])!=0 {return 2;}short:[4]u8;bounded:=nfm_layer_library(file,short[..])<0;print("short library output refuses: %\n",bounded);okay=okay && bounded;
 path:[4096]u8;for text,i:[3]string.["{\"layer\":{}}","{\"layer\":{\"library_path\":12}}","{\"layer\":{"] {name:[64]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],"malformed-");jo_int(o[..],i);jo_put(o[..],".json");fixture:=fs_join(work,jo_text(o[..]),path[..]);passed:=fs_write(fixture,text) && nfm_layer_library(fixture,library[..])<1;print("malformed metadata % refuses: %\n",i,passed);okay=okay && passed;}
 padded:[131073]u8;for i:0..<padded.count {padded[i]=' ';}head:="{\"layer\":{\"library_path\":\"/nix/store/fixture/lib.so\"}}";for i:0..<head.count {padded[i]=head[i];}fixture:=fs_join(work,"metadata-capacity.json",path[..]);at_cap:=fs_write(fixture,cast(string)padded[0..<131072]) && nfm_layer_library(fixture,library[..])==25;print("metadata exact capacity complete parse: %\n",at_cap);okay=okay && at_cap;over_cap:=fs_write(fixture,cast(string)padded[..]) && nfm_layer_library(fixture,library[..])<1;print("metadata above capacity refuses: %\n",over_cap);okay=okay && over_cap;return ifx okay then 0 else 1;
}
