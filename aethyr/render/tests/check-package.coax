// Native package ABI, guarded ownership, complete fields and fetched bytes.
//   coax/web/tool.sh aethyr/render/tests/check-package.coax --packages DIR --work-dir DIR --receipt FILE [--profiles SLUG ...] [--modes ...] [--coax FILE] [--compiler-source-digest FILE] [--explore-stale-compiler]
#import "Basic";
#load "native-qualification.coax";
#load "../staging-files.coax";
#load "package-tool-policy.coax";
RPP_NAMES :: [6]string.["RenderPackage","RenderPackageModule","RenderPackageEntry","RenderBuildReflection","RenderReflectedUse","RenderVertexInput"];
RPP_FIELDS :: [6]string.["status profile_index slug app module_count entry_count modules entries","present binding_set wgsl_file wgsl_sha256","present binding_set vertex fragment wgsl_vertex wgsl_fragment spirv_file spirv_sha256 tree_file tree_sha256 native_int64 reflection","ok schema tree_version derivatives control use_count uses vertex_stride attribute_count attributes fragment_targets fragment_depth","name slot native_kind shape stride stages","location scalar width offset"];
RPP_FAULTS :: [6]string.["profile","module_count","entry_count","resource","attribute","borrow"];
RppPackage :: struct {manifest:[262144]u8;count:int;directory:[4096]u8;directory_count:int;profile:int;slug:[128]u8;slug_count:int;}
RppPackages :: struct {count:int;rows:[18]RppPackage;}
rpp_abi :: (header:string)->bool {bytes:[1048576]u8;n:=fs_read(header,bytes[..]);if n<0 {return false;}for name,i:RPP_NAMES {if !rtq_fields(cast(string)bytes[0..<n],name,RPP_FIELDS[i]) {tool_err("package ABI differs: ");tool_errln(name);return false;}}return true;}

rpp_load_packages :: (a:[]Args,root:string,work:string,packages:string,snapshot:Jv,out:[]RppPackages,inputs:[]RtqInputs)->bool {
  profiles:=jv_get(snapshot,0,"profiles");wanted:[18]string;wanted_store:[18][128]u8;count:=0;at:=args_find(a,"--profiles");
  if at!= -1 {
    for i:at+1..<args_count(a) {name:=args_at(a,i);if name.count>=2 && name[0..<2]=="--" {break;}if count==18 {return false;}wanted[count]=name;count+=1;}
  }else {for i:0..<jv_len(snapshot,profiles) {n:=jv_str(snapshot,jv_get(snapshot,jv_at(snapshot,profiles,i),"slug"),wanted_store[i][..]);if n<1 {return false;}wanted[count]=cast(string)wanted_store[i][0..<n];count+=1;}}
  if count==0 {return false;}
  for i:0..<count {
    slug:=wanted[i];for old:0..<i {if wanted[old]==slug {return false;}}
    profile:=-1;app:[128]u8;app_count:=0;
    for k:0..<jv_len(snapshot,profiles) {
      node:=jv_at(snapshot,profiles,k);bytes:[128]u8;n:=jv_str(snapshot,jv_get(snapshot,node,"slug"),bytes[..]);if n>=0 && cast(string)bytes[0..<n]==slug {profile=k;app_count=jv_str(snapshot,jv_get(snapshot,node,"module"),app[..]);}
    }
    if profile<0 || app_count<1 {tool_errln("unknown frozen package profile");return false;}
    paths:[6][4096]u8;source:=fs_join(packages,slug,paths[0][..]);source_manifest:=fs_join(source,"render.json",paths[1][..]);files:[1]RspFiles;
    if !rsp_load(source_manifest,files[..]) {return false;}
    identity:=rsp_read_identity(cast(string)files[0].manifest[0..<files[0].manifest_count],cast(string)app[0..<app_count],slug);if !identity.ok || identity.profile!=profile {return false;}
    directory:=fs_join(fs_join(work,"inputs",paths[2][..]),slug,paths[3][..]);if !rsp_publish_files(directory,files[..]) || !rtq_input_add(inputs,source_manifest) {return false;}
    for p:0..<files[0].plan.count {name:=rsp_product_name(files[0].plan.rows[p..<p+1]);if !rtq_input_add(inputs,fs_join(source,name,paths[4][..])) {return false;}}
    row:RppPackage;row.manifest=files[0].manifest;row.count=files[0].manifest_count;row.directory_count=rtn_text(row.directory[..],directory);row.profile=profile;row.slug_count=rtn_text(row.slug[..],slug);if row.directory_count<0 || row.slug_count<0 {return false;}
    out[0].rows[out[0].count]=row;out[0].count+=1;
  }return true;
}
rpp_observe :: (argv:[]string,expected:string,equal:bool,append:bool,env:[]string,work:string,label:string,deadline:int,transcript:[]Jo)->bool {
  stdout:[1048576]u8;stderr:[65536]u8;r:=rtq_command(argv,env,deadline,work,label,stdout[..],stderr[..]);if !rtq_ok(r) {return false;}
  nodes:[32768]JvNode;doc:[1]Jv;want_nodes:[32768]JvNode;want:[1]Jv;
  if !jv_parse(doc[..],cast(string)stdout[0..<r.out_n],nodes[..]) || !jv_parse(want[..],expected,want_nodes[..]) || rtq_equal(doc[0],0,want[0],0)!=equal {tool_err("package observation differs: ");tool_errln(label);return false;}
  if append {jv_write(doc[0],0,transcript);}return true;
}
rpp_mode :: (compiler:string,mode:string,source:string,header:string,native:string,work:string,packages:[]RppPackages,deadline:int,result:[]Jo)->bool {
  executable_name:[128]u8;name_writer:[1]Jo;jo_start(name_writer[..],executable_name[..]);jo_put(name_writer[..],"package-");jo_put(name_writer[..],mode);exe_path:[4096]u8;exe:=fs_join(work,jo_text(name_writer[..]),exe_path[..]);
