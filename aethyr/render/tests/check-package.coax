  env:[2]string;env_count:=0;if mode=="sanitized" {env[0]="ASAN_OPTIONS=detect_leaks=0:detect_stack_use_after_return=1:halt_on_error=1";env[1]="UBSAN_OPTIONS=halt_on_error=1";env_count=2;}
