    profile_text:[64]u8;pw:[1]Jo;jo_start(pw[..],profile_text[..]);jo_int(pw[..],row.profile);manifest_path:[4096]u8;manifest:=fs_join(dir,"render.json",manifest_path[..]);argv:=[9]string.[exe,manifest,jo_text(pw[..]),"","","","","",""];
    expected:[1048576]u8;want:=rpt_expected(d,0,0,false,-1,expected[..]);if !rpp_observe(argv[0..<3],want,true,true,env[0..<env_count],directory,slug,deadline,transcript[..]) {return false;}observation_count+=1;
    entries:=jv_get(d,0,"entries");modules:=jv_get(d,0,"modules");
    for e:0..<jv_len(d,entries) {
      entry:=jv_at(d,entries,e);set:=jv_int(d,jv_get(d,entry,"binding_set"),-1);module:=rpt_slot(d,modules,"binding_set",set);file:[128]u8;paths:[3][4096]u8;
      for kind:0..<3 {key:=ifx kind==0 then "wgsl_file" else ifx kind==1 then "spirv_file" else "tree_file";node:=ifx kind==0 then module else entry;n:=jv_str(d,jv_get(d,node,key),file[..]);if n<1 {return false;}slot:=ifx kind<2 then 4+kind else 8;argv[slot]=fs_join(dir,cast(string)file[0..<n],paths[kind][..]);}
      entry_text:[64]u8;set_text:[64]u8;ew:[1]Jo;sw:[1]Jo;jo_start(ew[..],entry_text[..]);jo_int(ew[..],jv_int(d,jv_get(d,entry,"entry_index"),-1));jo_start(sw[..],set_text[..]);jo_int(sw[..],set);argv[6]=jo_text(ew[..]);argv[7]=jo_text(sw[..]);
      label:[256]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],slug);jo_put(lw[..],"-payload-");jo_int(lw[..],e);want=rpt_expected(d,0,0,true,-1,expected[..]);if !rpp_observe(argv[..],want,true,true,env[0..<env_count],directory,jo_text(lw[..]),deadline,transcript[..]) {return false;}observation_count+=1;
    }
    argv[3]="short";want=rpt_expected(d,2,2,false,-1,expected[..]);label:[256]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],slug);jo_put(lw[..],"-short");if !rpp_observe(argv[0..<4],want,true,true,env[0..<env_count],directory,jo_text(lw[..]),deadline,transcript[..]) {return false;}observation_count+=1;
  }
  first:=packages[0].rows[0];first_dir:=cast(string)first.directory[0..<first.directory_count];data:[1]Jv;nodes:[16384]JvNode;if !jv_parse(data[..],cast(string)first.manifest[0..<first.count],nodes[..]) {return false;}d:=data[0];
  paths:[8][4096]u8;manifest:=fs_join(first_dir,"render.json",paths[0][..]);profile_text:[64]u8;pw:[1]Jo;jo_start(pw[..],profile_text[..]);jo_int(pw[..],first.profile);argv:=[9]string.[exe,manifest,jo_text(pw[..]),"","","","","",""];
  expected:[1048576]u8;want:=rpt_expected(d,0,0,false,-1,expected[..]);
  for fault:RPP_FAULTS {argv[3]=fault;if !rpp_observe(argv[0..<4],want,false,false,env[0..<env_count],directory,fault,deadline,transcript[..]) {return false;}}
  negative:[524288]u8;
  for name,i:RPT_NEGATIVES {
    raw:=rpt_negative(d,i,negative[..]);if raw.count==0 {return false;}file_name:[256]u8;nw:[1]Jo;jo_start(nw[..],file_name[..]);jo_put(nw[..],"negative-");jo_put(nw[..],name);jo_put(nw[..],".json");file:=fs_join(work,jo_text(nw[..]),paths[1][..]);if !fs_write(file,raw) {return false;}
    changed_nodes:[16384]JvNode;changed:[1]Jv;parse:=rpt_negative_parse(i);admit:=rpt_negative_admit(i);
    if parse==0 {if !jv_parse(changed[..],raw,changed_nodes[..]) {return false;}want=rpt_expected(changed[0],0,admit,false,-1,expected[..]);}else {want=rpt_expected(d,parse,admit,false,-1,expected[..]);}
    argv[1]=file;if !rpp_observe(argv[0..<3],want,true,true,env[0..<env_count],directory,name,deadline,transcript[..]) {return false;}observation_count+=1;
  }
  argv[1]=manifest;argv[3]="";entry:=jv_at(d,jv_get(d,0,"entries"),0);set:=jv_int(d,jv_get(d,entry,"binding_set"),-1);module:=rpt_slot(d,jv_get(d,0,"modules"),"binding_set",set);originals:[3]string;
  file:[128]u8;for kind:0..<3 {key:=ifx kind==0 then "wgsl_file" else ifx kind==1 then "spirv_file" else "tree_file";node:=ifx kind==0 then module else entry;n:=jv_str(d,jv_get(d,node,key),file[..]);if n<1 {return false;}originals[kind]=fs_join(first_dir,cast(string)file[0..<n],paths[2+kind][..]);}
  entry_text:[64]u8;set_text:[64]u8;ew:[1]Jo;sw:[1]Jo;jo_start(ew[..],entry_text[..]);jo_int(ew[..],jv_int(d,jv_get(d,entry,"entry_index"),-1));jo_start(sw[..],set_text[..]);jo_int(sw[..],set);argv[6]=jo_text(ew[..]);argv[7]=jo_text(sw[..]);
  for key,kind:[3]string.["module_bytes","spirv_bytes","tree_bytes"] {
    bytes:[2097152]u8;n:=fs_read(originals[kind],bytes[..]);if n<0 {return false;}label:[256]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],"corrupt-");jo_put(lw[..],key);corrupt:=fs_join(work,jo_text(lw[..]),paths[5][..]);if !fs_write(corrupt,cast(string)bytes[0..<n]) || !fs_append(corrupt,"changed") {return false;}
    argv[4]=originals[0];argv[5]=originals[1];argv[8]=originals[2];argv[ifx kind<2 then 4+kind else 8]=corrupt;want=rpt_expected(d,0,0,true,kind,expected[..]);if !rpp_observe(argv[..],want,true,true,env[0..<env_count],directory,jo_text(lw[..]),deadline,transcript[..]) {return false;}observation_count+=1;
