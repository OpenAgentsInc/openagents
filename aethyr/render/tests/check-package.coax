  jo_obj(result);jo_key(result,"mode");jo_str(result,mode);jo_key(result,"observations");jo_int(result,observation_count);jo_key(result,"producer_loss_controls");jo_arr(result);for fault:RPP_FAULTS {jo_str(result,fault);}jo_end(result);jo_key(result,"negative_controls");jo_arr(result);for name:RPT_NEGATIVES {jo_str(result,name);}for key:[3]string.["module_bytes","spirv_bytes","tree_bytes"] {label:[128]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],"corrupt-");jo_put(lw[..],key);jo_str(result,jo_text(lw[..]));}jo_end(result);
  for key,i:[4]string.["transcript_sha256","generated_c_sha256","header_sha256","executable_sha256"] {path:=ifx i==0 then transcript_file else ifx i==1 then source else ifx i==2 then header else exe;hash:[64]u8;if !rtq_hash_file(path,hash[..]) {return false;}jo_key(result,key);jo_str(result,cast(string)hash[..]);}jo_end(result);return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}header_check:=args_value(a[..],"--check-header","");if header_check.count>0 {return ifx rpp_abi(header_check) then 0 else 1;}work:=args_value(a[..],"--work-dir","");receipt:=args_value(a[..],"--receipt","");packages_path:=args_value(a[..],"--packages","");if work.count==0 || receipt.count==0 || packages_path.count==0 || !fs_mkdir(work) {tool_errln("usage: check-package --packages DIR --work-dir DIR --receipt FILE [--coax FILE] [--profiles ...] [--modes ...]");return 2;}
  start:=proc_now_ms();deadline:=proc_deadline(RTQ_DEADLINE_MS,start);root_buf:[4096]u8;root:=fs_cwd(root_buf[..]);compiler_buf:[4096]u8;selected:=proc_getenv("COAX",compiler_buf[..]);if selected.count==0 {selected="coax/bin/coax";}compiler:=args_value(a[..],"--coax",selected);paths:[8][4096]u8;digest:=args_value(a[..],"--compiler-source-digest",fs_join(fs_dir(compiler),"source-digest",paths[0][..]));
  identity:[1]RtnCompiler;identity[0]=rtn_compiler(compiler,digest,root,work,deadline);if !identity[0].ok {return 1;}explore:=args_has(a[..],"--explore-stale-compiler");if !rpt_compiler_gate(identity[0].matching,explore) {tool_errln("source-matching compiler required before package emission");return 1;}
  self_path:[4096]u8;self_n:=cxproc_self_path(self_path[..]);if self_n<1 || self_n>self_path.count {return 1;}self:=cast(string)self_path[0..<self_n];self_hash:[64]u8;if !rtq_hash_file(self,self_hash[..]) {return 1;}
  modes:[3]string;mode_count:=rtn_modes(a[..],modes[..]);if mode_count<0 {return 2;}snapshot_bytes:[1048576]u8;snapshot_nodes:[32768]JvNode;snapshot:[1]Jv;snapshot_path:="aethyr/render/tests/catalog-6445ee0050.json";if !rtq_json_file(snapshot_path,snapshot_bytes[..],snapshot_nodes[..],snapshot[..]) {return 1;}
  inputs:[1]RtqInputs;fixture:="aethyr/render/tests/package-native.coax";native:="aethyr/render/tests/package-native.c";
  if !rtq_deps(inputs[..],compiler,fixture,deadline,work,"package-dependencies") || !rtn_tool_sources(inputs[..],compiler,"aethyr/render/tests/check-package.coax",work,deadline) || !rtq_input_add(inputs[..],native) || !rtq_input_add(inputs[..],snapshot_path) {return 1;}
  packages:[1]RppPackages;if !rpp_load_packages(a[..],root,work,packages_path,snapshot[0],packages[..],inputs[..]) {return 1;}
  records:[1048576]u8;o:[1]Jo;jo_start(o[..],records[..]);jo_arr(o[..]);emitted:[2]bool;source_paths:[2][4096]u8;header_paths:[2][4096]u8;
  for m:0..<mode_count {
    mode:=modes[m];release:=mode=="release";index:=ifx release then 1 else 0;directory:=fs_join(work,ifx release then "wrapping" else "checked",paths[1][..]);if !fs_mkdir(directory) {return 1;}
    source:=fs_join(directory,"package-native.c",source_paths[index][..]);header:=fs_join(directory,"package-native.h",header_paths[index][..]);
    if !emitted[index] {
      if !rtn_emit(compiler,fixture,source,header,release,directory,deadline) {return 1;}
      warning:[65536]u8;wn:=fs_read(fs_join(directory,"emission.stderr",paths[2][..]),warning[..]);if wn<0 {return 1;}if rtq_find(cast(string)warning[0..<wn],"compiler is out of date",0)>=0 {identity[0].matching=false;if !rpt_compiler_gate(false,explore) {return 1;}}
      if !rpp_abi(header) {return 1;}emitted[index]=true;
    }
    if !rpp_mode(compiler,mode,source,header,native,work,packages[..],deadline,o[..]) {return 1;}
  }jo_end(o[..]);hash:[64]u8;if !rtq_hash_file(compiler,hash[..]) || cast(string)hash[..]!=cast(string)identity[0].hash[..] || !rtq_hash_file(self,hash[..]) || cast(string)hash[..]!=cast(string)self_hash[..] || !rtq_inputs_match(inputs[..]) {return 1;}
  schema_names:=RPP_NAMES;schema_fields:=RPP_FIELDS;
  record:[2097152]u8;w:[1]Jo;jo_start(w[..],record[..]);jo_obj(w[..]);jo_key(w[..],"schema");jo_str(w[..],"aethyr.render.package.native.v1");jo_key(w[..],"status");jo_str(w[..],ifx identity[0].matching then "pass" else "exploratory");rtn_compiler_json(w[..],compiler,identity[..]);jo_key(w[..],"qualifier_executable_sha256");jo_str(w[..],cast(string)self_hash[..]);jo_key(w[..],"source_sha256");rtq_inputs_json(w[..],inputs[..],root);jo_key(w[..],"profiles");jo_arr(w[..]);for i:0..<packages[0].count {row:=packages[0].rows[i];jo_str(w[..],cast(string)row.slug[0..<row.slug_count]);}jo_end(w[..]);jo_key(w[..],"header_fields_checked");rtn_schema_json(w[..],schema_names[..],schema_fields[..]);jo_key(w[..],"modes");jo_raw(w[..],jo_text(o[..]));rtn_elapsed(w[..],proc_now_ms()-start);jo_key(w[..],"scope");jo_str(w[..],"Normal-C package JSON/catalog admission, every field and guarded borrowed view, actual WGSL/SPIRV/tree hashes and requirement admission. Supplied package bytes are pinned independently of build provenance. No shader arithmetic, full SPIRV validity, GPU image or current-compiler release claim.");jo_end(w[..]);
  if w[0].bad || !fs_mkdir(fs_dir(receipt)) || !fs_write(receipt,jo_text(w[..])) {return 1;}print("package: % profiles, % native modes,6 producer losses and17 negative/byte controls per mode; %\n",packages[0].count,mode_count,ifx identity[0].matching then "matching compiler" else "explicit older compiler observation");return 0;
}
