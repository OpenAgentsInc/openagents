// Actual bounded child-tree timeout and interrupt cleanup. The only added
// host effect is fork(); fixture logic and every comparison are Coax.
#import "Basic";
#load "native-qualification.coax";
#load "process-observation-policy.coax";
rpct_read_pids :: (path:string,out:[]int)->bool {bytes:[256]u8;nodes:[8]JvNode;doc:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],doc[..]) || jv_len(doc[0],0)!=2 {return false;}for i:0..<2 {out[i]=jv_int(doc[0],jv_at(doc[0],0,i),-1);if out[i]<=1 {return false;}}return out[0]!=out[1];}
rpct_live :: (pid:int)->bool {bytes:[64]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_int(o[..],pid);argv:=[5]string.["/bin/ps","-o","stat=","-p",jo_text(o[..])];stdout:[4096]u8;stderr:[4096]u8;env:[]string;r:=rtq_run_raw(argv[..],env,2000,stdout[..],stderr[..]);state:=rtq_trim(cast(string)stdout[0..<r.out_n]);return !rpo_dead(r.started,r.status,r.timed_out,r.cut,r.err_n,state);}
rpct_dead :: (pids:[]int)->bool {deadline:=proc_deadline(2000,proc_now_ms());while proc_left(deadline,proc_now_ms())>0 {alive:=false;for pid:pids {if rpct_live(pid) {alive=true;}}if !alive {return true;}proc_sleep(10);}return false;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) {return 2;}work_arg:=args_value(a[..],"--out","");if work_arg.count==0 || !fs_mkdir(work_arg) {return 2;}paths:[12][4096]u8;work:=fs_realpath(work_arg,paths[0][..]);root:=fs_cwd(paths[1][..]);start:=proc_now_ms();deadline:=proc_deadline(810000,start);selected_buf:[4096]u8;selected:=proc_getenv("COAX",selected_buf[..]);if selected.count==0 {selected="coax/bin/coax";}compiler:=args_value(a[..],"--coax",selected);digest:=args_value(a[..],"--compiler-source-digest",fs_join(fs_dir(compiler),"source-digest",paths[2][..]));identity:[1]RtnCompiler;identity[0]=rtn_compiler(compiler,digest,root,work,deadline);if !identity[0].ok || (!identity[0].matching && !args_has(a[..],"--explore-stale-compiler")) {tool_errln("source-matching compiler required before process worker emission");return 1;}
 worker_source:="aethyr/render/tests/pipeline-process-worker.coax";fork_source:="aethyr/render/tests/process-fork-native.c";sources:[1]RtqInputs;if !rtn_tool_sources(sources[..],compiler,"aethyr/render/tests/check-pipeline-processes.coax",work,deadline) || !rtq_deps(sources[..],compiler,worker_source,deadline,work,"worker-dependencies") || !rtq_input_add(sources[..],fork_source) || !rtq_input_add(sources[..],compiler) || !rtq_input_add(sources[..],digest) {return 1;}self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 || self_n>self.count || !rtq_input_add(sources[..],cast(string)self[0..<self_n]) {return 1;}
 source:=fs_join(work,"worker.c",paths[3][..]);header:=fs_join(work,"worker.h",paths[4][..]);exe:=fs_join(work,"worker",paths[5][..]);if !rtn_emit(compiler,worker_source,source,header,false,work,deadline) {return 1;}compile:=[16]string.["clang","-D_DARWIN_C_SOURCE","-std=c11","-O2",source,fork_source,"coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c","-lm","-o",exe,"","",""];stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(compile[0..<13],env,deadline,work,"compile-worker",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}products:[1]RtqInputs;for p:[3]string.[source,header,exe] {if !rtq_input_add(products[..],p) {return 1;}}
 exit_args:=[2]string.[exe,"exit7"];r=rtq_command(exit_args[..],env,deadline,work,"nonzero-child",stdout[..],stderr[..]);if r.started!=0 || r.timed_out || r.cut || r.status!=7 || rtq_ok(r) {return 1;}
 pid_file:=fs_join(work,"timeout-pids.json",paths[6][..]);if fs_exists(pid_file) {return 1;}timeout_args:=[3]string.[exe,"tree",pid_file];r=rtq_run_raw(timeout_args[..],env,200,stdout[..],stderr[..]);if !rtq_record_run(work,"timeout-tree",timeout_args[..],r,cast(string)stdout[0..<r.out_n],cast(string)stderr[0..<r.err_n]) {return 1;}pids:[2]int;if !r.timed_out || rtq_ok(r) || !rpct_read_pids(pid_file,pids[..]) || !rpct_dead(pids[..]) {tool_errln("timeout left an owned process live");return 1;}
 report:[65536]u8;o:[1]Jo;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.pipeline-process-controls.v1");jo_key(o[..],"qualification");jo_bool(o[..],false);jo_key(o[..],"qualification_status");jo_str(o[..],ifx identity[0].matching then "process effects controls only" else "exploratory");rtn_compiler_json(o[..],compiler,identity[..]);jo_key(o[..],"timeout_owned_pids");jo_arr(o[..]);for pid:pids {jo_int(o[..],pid);}jo_end(o[..]);jo_key(o[..],"interrupts");jo_arr(o[..]);
 for signal_number:[2]int.[2,15] {name:[128]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],"signal-");jo_int(w[..],signal_number);label:=jo_text(w[..]);directory:=fs_join(work,label,paths[7][..]);if !fs_mkdir(directory) {return 1;}pid_path:=fs_join(directory,"pids.json",paths[8][..]);passed:=fs_join(directory,"passed",paths[9][..]);if fs_exists(pid_path) || fs_exists(passed) {return 1;}h:=proc_new();if h<0 {return 1;}ok:=proc_arg(h,exe) && proc_arg(h,"wrapper") && proc_arg(h,pid_path) && proc_arg(h,passed);if !ok || proc_start(h)!=0 {done:=proc_release(h);return 1;}closed:=proc_close_stdin(h);ready:=false;limit:=proc_deadline(5000,proc_now_ms());while proc_left(limit,proc_now_ms())>0 {if rpct_read_pids(pid_path,pids[..]) {ready=true;break;}proc_sleep(10);}if !ready {kill:=proc_kill(h,9);status:=proc_wait(h,2000);done:=proc_release(h);return 1;}wrapper:=proc_pid(h);sent:=proc_kill(h,signal_number);status:=proc_wait(h,5000);if status==PROC_RUNNING {kill:=proc_kill(h,9);status=proc_wait(h,2000);}done:=proc_release(h);if !sent || status==0 || status==PROC_RUNNING || fs_exists(passed) || !rpct_dead(pids[..]) {tool_errln("interrupt left an owned process live or published success");return 1;}jo_obj(o[..]);jo_key(o[..],"signal");jo_int(o[..],signal_number);jo_key(o[..],"wrapper_pid");jo_int(o[..],wrapper);jo_key(o[..],"status");jo_int(o[..],status);jo_key(o[..],"owned_pids");jo_arr(o[..]);for pid:pids {jo_int(o[..],pid);}jo_end(o[..]);jo_key(o[..],"passed_marker_absent");jo_bool(o[..],true);jo_key(o[..],"all_owned_processes_dead_or_zombie");jo_bool(o[..],true);jo_end(o[..]);}
 jo_end(o[..]);if !rtq_inputs_match(sources[..]) || !rtq_inputs_match(products[..]) {return 1;}jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],sources[..],root);jo_key(o[..],"product_sha256");rtq_inputs_json(o[..],products[..],"");rtn_elapsed(o[..],proc_now_ms()-start);jo_key(o[..],"status");jo_str(o[..],"pass");jo_end(o[..]);if o[0].bad || !fs_write(fs_join(work,"qualification.json",paths[10][..]),jo_text(o[..])) {return 1;}print("process controls: exit7, timeout and SIGINT/SIGTERM remove owned child trees; no success marker\n");return 0;
}
