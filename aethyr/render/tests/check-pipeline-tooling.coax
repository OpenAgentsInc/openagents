// Coax owns ABI/word-loss controls. Pixel/depth equations and conversion to
// binary32 words remain the independent check_pipeline.py oracle.
#import "Basic";
#load "native-qualification.coax";
#load "reference-frame-tool-policy.coax";
RPP_NAMES :: [3]string.["RQColor","RRPixel","RRPassResult"];
RPP_FIELDS :: [3]string.["r g b a","depth colour aux","status steps triangles quads fragments written"];
rpp_run :: (argv:[]string,good:bool,out:string,label:string)->bool {stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(argv,env,proc_deadline(810000,proc_now_ms()),out,label,stdout[..],stderr[..]);if r.started!=0 || r.timed_out || r.cut {return false;}return ifx good then r.status==0 else r.status==1 && rtq_find(cast(string)stderr[0..<r.err_n],"AssertionError",0)>=0;}
rpp_header :: (text:string)->bool {for name,i:RPP_NAMES {if !rtq_fields(text,name,RPP_FIELDS[i]) {return false;}}return true;}
rpp_mutate :: (d:Jv,pixel:int,word:int,field:int,out:[]u8)->string {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"result");jo_arr(o[..]);result:=jv_get(d,0,"result");for i:0..<jv_len(d,result) {n:=jv_int(d,jv_at(d,result,i),-1);jo_int(o[..],ifx i==field then n+1 else n);}jo_end(o[..]);jo_key(o[..],"pixels");jo_arr(o[..]);pixels:=jv_get(d,0,"pixels");for p:0..<jv_len(d,pixels) {row:=jv_at(d,pixels,p);jo_arr(o[..]);for w:0..<jv_len(d,row) {n:=jv_int(d,jv_at(d,row,w),-1);jo_int(o[..],ifx p==pixel && w==word then n^1 else n);}jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then "" else jo_text(o[..]);
}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<1 {return 2;}out_arg:=args_at(a[..],0);if !fs_mkdir(out_arg) {return 1;}canonical:[4096]u8;out:=fs_realpath(out_arg,canonical[..]);paths:[7][4096]u8;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler.count==0 {compiler="coax/bin/coax";}held:[1]RtqInputs;if !rtn_tool_sources(held[..],compiler,"aethyr/render/tests/check-pipeline-tooling.coax",out,proc_deadline(810000,proc_now_ms())) || !rtq_input_add(held[..],"aethyr/render/tests/check_pipeline.py") || !rtq_input_add(held[..],compiler) {return 1;}self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 || self_n>self.count || !rtq_input_add(held[..],cast(string)self[0..<self_n]) {return 1;}
 facts:=fs_join(out,"oracle.json",paths[0][..]);candidate:=fs_join(out,"candidate.json",paths[1][..]);fact_script:="import sys,json;sys.path.insert(0,sys.argv[1]);import check_pipeline as q;r,p,s=q.oracle(int(sys.argv[2]),sys.argv[3]=='1');open(sys.argv[4],'w').write(json.dumps({'result':[r[0],100 if s is None else s,*r[1:]],'pixels':[[q.bits(x) for x in row] for row in p]}))";verify_script:="import sys,json;sys.path.insert(0,sys.argv[1]);import check_pipeline as q;q.verify(json.load(open(sys.argv[2])),int(sys.argv[3]),sys.argv[4]=='1')";fact_args:=[7]string.["python3","-c",fact_script,"aethyr/render/tests","0","0",facts];verify:=[7]string.["python3","-c",verify_script,"aethyr/render/tests",candidate,"0","0"];
 if !rpp_run(fact_args[..],true,out,"oracle-scenario0") {return 1;}bytes:[1048576]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(facts,bytes[..],nodes[..],doc[..]) {return 1;}d:=doc[0];n:=fs_size(facts);if n<0 || !fs_write(candidate,cast(string)bytes[0..<n]) || !rpp_run(verify[..],true,out,"word-positive") {return 1;}
 changed:[1048576]u8;for pixel:0..<16 {for word:0..<9 {label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"pixel-");jo_int(w[..],pixel);jo_put(w[..],"-word-");jo_int(w[..],word);value:=rpp_mutate(d,pixel,word,-1,changed[..]);if value.count==0 || !fs_write(candidate,value) || !rpp_run(verify[..],false,out,jo_text(w[..])) {return 1;}}}
 for field:[5]int.[0,2,3,4,5] {label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"counter-");jo_int(w[..],field);value:=rpp_mutate(d,-1,-1,field,changed[..]);if value.count==0 || !fs_write(candidate,value) || !rpp_run(verify[..],false,out,jo_text(w[..])) {return 1;}}
 for which:0..<2 {fact_args[4]=ifx which==0 then "6" else "0";fact_args[5]=ifx which==0 then "0" else "1";verify[5]=fact_args[4];verify[6]=fact_args[5];if !rpp_run(fact_args[..],true,out,ifx which==0 then "oracle-work-boundary" else "oracle-short-view") || !rtq_json_file(facts,bytes[..],nodes[..],doc[..]) {return 1;}n=fs_size(facts);if n<0 || !fs_write(candidate,cast(string)bytes[0..<n]) || !rpp_run(verify[..],true,out,ifx which==0 then "work-boundary-positive" else "short-view-positive") {return 1;}value:=rpp_mutate(doc[0],-1,-1,1,changed[..]);if value.count==0 || !fs_write(candidate,value) || !rpp_run(verify[..],false,out,ifx which==0 then "work-boundary-loss" else "short-view-loss") {return 1;}}
 header_bytes:[16384]u8;o:[1]Jo;jo_start(o[..],header_bytes[..]);for name,i:RPP_NAMES {jo_put(o[..],"struct coax_t_");jo_put(o[..],name);jo_put(o[..]," { ");at:=0;while true {field:=rtq_word(RPP_FIELDS[i],at);if field.count==0 {break;}jo_put(o[..],"uint32_t ");jo_put(o[..],field);jo_put(o[..],"; ");at+=1;}jo_put(o[..],"};\n");}header:=jo_text(o[..]);if o[0].bad || !rpp_header(header) || !fs_write(candidate,header) {return 1;}header_args:=[5]string.["python3","-c","import sys;sys.path.insert(0,sys.argv[1]);import check_pipeline as q;q.header_inventory(open(sys.argv[2]).read())","aethyr/render/tests",candidate];if !rpp_run(header_args[..],true,out,"header-positive") {return 1;}field_count:=0;
 for fields:RPP_FIELDS {at:=0;while true {field:=rtq_word(fields,at);if field.count==0 {break;}needle_bytes:[256]u8;w:[1]Jo;jo_start(w[..],needle_bytes[..]);jo_put(w[..],"uint32_t ");jo_put(w[..],field);jo_put(w[..],";");value:=rfr_test_edit(header,jo_text(w[..]),"",changed[..]);label:[128]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],"header-omit-");jo_put(lw[..],field);if rpp_header(value) || !fs_write(candidate,value) || !rpp_run(header_args[..],false,out,jo_text(lw[..])) {return 1;}at+=1;field_count+=1;}}
 for which:0..<2 {value:=rfr_test_edit(header,ifx which==0 then "uint32_t r;" else "uint32_t r; uint32_t g;",ifx which==0 then "uint32_t extra; uint32_t r;" else "uint32_t g; uint32_t r;",changed[..]);if rpp_header(value) || !fs_write(candidate,value) || !rpp_run(header_args[..],false,out,ifx which==0 then "header-added" else "header-reordered") {return 1;}}
 if !rtq_inputs_match(held[..]) {return 1;}record:[65536]u8;w:[1]Jo;jo_start(w[..],record[..]);jo_obj(w[..]);jo_key(w[..],"status");jo_str(w[..],"pass");jo_key(w[..],"qualification");jo_bool(w[..],false);jo_key(w[..],"pixel_word_losses");jo_int(w[..],144);jo_key(w[..],"counter_losses");jo_int(w[..],5);jo_key(w[..],"exact_work_losses");jo_int(w[..],2);jo_key(w[..],"header_omissions");jo_int(w[..],field_count);jo_key(w[..],"header_added_reordered_losses");jo_int(w[..],2);jo_key(w[..],"source_sha256");rtq_inputs_json(w[..],held[..],"");jo_end(w[..]);if w[0].bad || !fs_write(fs_join(out,"qualification.json",paths[2][..]),jo_text(w[..])) {return 1;}print("pipeline tooling: all144 pixel words,5 counters, exact work/short-view and ABI losses\n");return 0;
}
