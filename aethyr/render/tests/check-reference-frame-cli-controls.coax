// Actual CLI refusal/preparation controls; no additional renderer execution.
// OUT FRAME_BINARY COAX SOURCE_RECORD FIXTURE PACKAGE REFERENCE_DIR BACKEND
#import "Basic";
#load "reference-frame-tool-files.coax";
rfc_run :: (argv:[]string,status:int,out:string,label:string)->bool {stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_run_raw(argv,env,180000,stdout[..],stderr[..]);if !rtq_record_run(out,label,argv,r,cast(string)stdout[0..<r.out_n],cast(string)stderr[0..<r.err_n]) {return false;}if r.started!=0 || r.status!=status || r.timed_out || r.cut {tool_err("frame CLI control differs: ");tool_errln(label);tool_err(cast(string)stderr[0..<r.err_n]);return false;}return true;}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=8 {return 2;}out:=args_at(a[..],0);image:=args_at(a[..],1);compiler:=args_at(a[..],2);record:=args_at(a[..],3);fixture:=args_at(a[..],4);package:=args_at(a[..],5);ref:=args_at(a[..],6);backend:=args_at(a[..],7);if !fs_mkdir(out) {return 1;}image_hash:[64]u8;if !rtq_hash_file(image,image_hash[..]) {return 1;}paths:[8][4096]u8;source:=fs_join(fixture,"frame.config",paths[0][..]);capture:=fs_join(fixture,"capture.json",paths[1][..]);
  for which:0..<2 {
    label:=ifx which==0 then "prepare-config" else "prepare-capture-coarse";directory:=fs_join(out,label,paths[2][..]);args:=[15]string.[image,ifx which==0 then "--frame-config" else "--capture",ifx which==0 then source else capture,"--package",package,"--work-dir",directory,"--prepare-only","--coax",compiler,"--compiler-source-digest",record,"--explore-stale-compiler","--coarse",""];if !rfc_run(args[0..<(ifx which==0 then 13 else 14)],0,out,label) || fs_exists(fs_join(directory,"emission.json",paths[3][..])) || fs_exists(fs_join(directory,"reference-frame.c",paths[3][..])) {return 1;}bytes:[2097152]u8;nodes:[32768]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(directory,"preparation.json",paths[3][..]),bytes[..],nodes[..],d[..]) || !rfr_literal(d[0],jv_get(d[0],0,"status"),"prepared") || jv_kind(d[0],jv_get(d[0],0,"qualification"))!=JV_FALSE || jv_kind(d[0],jv_get(d[0],0,"compiler_sources_match"))!=JV_FALSE {return 1;}config_bytes:[4194304]u8;p:[1]RfrConfig;n:=fs_read(fs_join(directory,"frame.config",paths[3][..]),config_bytes[..]);if n<0 || !rfr_parse(cast(string)config_bytes[0..<n],p[..]) || p[0].counts[1]!=2 || p[0].counts[2]!=2 || p[0].counts[12]!=which {return 1;}
  }
  stale:=fs_join(out,"real-stale-default",paths[2][..]);stale_args:=[12]string.[image,"--frame-config",source,"--package",package,"--work-dir",stale,"--prepare-only","--coax",compiler,"--compiler-source-digest",record];if !rfc_run(stale_args[..],1,out,"real-stale-default") {return 1;}list:[1]FsList;if fs_list(stale,list[..])!=6 {return 1;}for i:0..<list[0].n {name:=fs_entry(list[..],i);if rtq_find(name,"compiler-version.",0)!=0 && rtq_find(name,"compiler-current-source.",0)!=0 {return 1;}}
  wrong:=fs_join(out,"wrong-package.json",paths[2][..]);wrong_json:[1024]u8;o:[1]Jo;jo_start(o[..],wrong_json[..]);jo_obj(o[..]);hash:[64]u8;if !rtq_hash_file(compiler,hash[..]) {return 1;}jo_key(o[..],"compiler_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"profile_index");jo_int(o[..],1);jo_key(o[..],"deliberate_wrong_package");jo_bool(o[..],true);jo_end(o[..]);if !fs_write(wrong,jo_text(o[..])) {return 1;}
  wrong_dir:=fs_join(out,"wrong-package-work",paths[3][..]);wrong_args:=[13]string.[image,"--frame-config",source,"--package",wrong,"--work-dir",wrong_dir,"--prepare-only","--coax",compiler,"--compiler-source-digest",record,"--explore-stale-compiler"];if !rfc_run(wrong_args[..],1,out,"wrong-package-coax") || fs_exists(fs_join(wrong_dir,"preparation.json",paths[4][..])) {return 1;}legacy_inputs:=fs_join(out,"wrong-package-reference",paths[3][..]);if !fs_mkdir(legacy_inputs) {return 1;}legacy_config:=fs_join(out,"wrong-reference.config",paths[4][..]);script:="import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);from check_reference_frame import snapshot_frame_config;snapshot_frame_config(*map(Path,sys.argv[2:]))";legacy:=[8]string.["python3","-c",script,ref,source,wrong,legacy_inputs,legacy_config];if !rfc_run(legacy[..],1,out,"wrong-package-reference") {return 1;}
  for which:0..<6 {
    label:=[6]string.["coarse-recorded-config","unknown-mode","unknown-flag","measured-filter-without-evidence","missing-raster-profile","exploratory-backend-cannot-qualify"][which];directory:=fs_join(out,label,paths[3][..]);args:[24]string;fixed:=[13]string.[image,"--frame-config",source,"--package",package,"--work-dir",directory,"--coax",compiler,"--compiler-source-digest",record,"--explore-stale-compiler",""];n:=12;for i:0..<12 {args[i]=fixed[i];}if which!=4 {args[n]="--raster-rounding";args[n+1]="nearest-even";n+=2;}if which==0 {args[n]="--coarse";n+=1;}if which==1 {args[n]="--mode";args[n+1]="other";n+=2;}if which==2 {args[n]="--unknown";n+=1;}if which==3 {args[n]="--filter-profile";args[n+1]="metal-unorm8";n+=2;}if which==5 {args[n]="--reuse-backend";args[n+1]=backend;n+=2;}if !rfc_run(args[0..<n],ifx which==5 then 1 else 2,out,label) || fs_exists(fs_join(directory,"measurement.json",paths[4][..])) || fs_exists(fs_join(directory,"emission.json",paths[4][..])) {return 1;}
  }
  if !rtq_hash_file(image,hash[..]) || cast(string)hash[..]!=cast(string)image_hash[..] {return 1;}result:[2048]u8;w:[1]Jo;jo_start(w[..],result[..]);jo_obj(w[..]);jo_key(w[..],"qualifier_executable_sha256");jo_str(w[..],cast(string)image_hash[..]);jo_key(w[..],"before_after");jo_str(w[..],"equal");jo_key(w[..],"preparation_paths");jo_int(w[..],2);jo_key(w[..],"refusal_controls");jo_int(w[..],8);jo_key(w[..],"renderer_executions");jo_int(w[..],0);jo_end(w[..]);if !fs_write(fs_join(out,"qualification.json",paths[5][..]),jo_text(w[..])) {return 1;}print("frame CLI:2 immutable preparation paths,8 refusals including real stale compiler and exact wrong-package legacy outcome; no renderer executions\n");return 0;
}
