rft_backend_fixture :: (root:string,directory:string,out:[]u8)->bool {path:[4096]u8;source:=fs_join(root,"aethyr/render/tests/reference-frame-native.coax",path[..]);if !fs_mkdir(fs_dir(source)) || !fs_write(source,"checked Coax source fixture") || !fs_mkdir(directory) {return false;}hash:[64]u8;o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"status");jo_str(o[..],"rendered");jo_key(o[..],"compiler_sha256");jo_str(o[..],"compiler");jo_key(o[..],"compiler_source_digest");jo_str(o[..],"digest");jo_key(o[..],"compiler_changed");jo_bool(o[..],false);jo_key(o[..],"compiler_sources_match");jo_bool(o[..],true);for key:[3]string.["source_changes","artifact_changes","input_changes"] {jo_key(o[..],key);jo_arr(o[..]);jo_end(o[..]);}jo_key(o[..],"source_sha256");jo_obj(o[..]);jo_key(o[..],"aethyr/render/tests/reference-frame-native.coax");if !rtq_hash_file(source,hash[..]) {return false;}jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"tool.py");jo_str(o[..],"old-tool");jo_end(o[..]);
  for kind,i:[3]string.["generated_c","generated_header","executable"] {name:=[3]string.["reference-frame.c","reference-frame.h","reference-frame"][i];file:=fs_join(directory,name,path[..]);text:[256]u8;w:[1]Jo;jo_start(w[..],text[..]);jo_put(w[..],"completed ");jo_put(w[..],kind);if !fs_write(file,jo_text(w[..])) || !rtq_hash_file(file,hash[..]) {return false;}jo_start(w[..],text[..]);jo_put(w[..],kind);jo_put(w[..],"_sha256");jo_key(o[..],jo_text(w[..]));jo_str(o[..],cast(string)hash[..]);}jo_end(o[..]);return !o[0].bad && fs_write(fs_join(directory,"measurement.json",path[..]),jo_text(o[..]));}
rft_explicit_renderer :: (root:string,directory:string,legacy:string)->bool {nodes:[2048]JvNode;doc:[1]Jv;if !jv_parse(doc[..],legacy,nodes[..]) {return false;}d:=doc[0];paths:[3][4096]u8;observer:=fs_join(root,"observer.coax",paths[0][..]);descriptor:=fs_join(root,"renderer.pbdesc",paths[1][..]);if !fs_write(observer,"old observer") || !fs_write(descriptor,"exact descriptor") {return false;}hash:[64]u8;bytes:[32768]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);child:=d.nodes[0].first;while child!=-1 {key:=jv_key(d,child);jo_key(o[..],key);if key=="source_sha256" {jo_obj(o[..]);source:=d.nodes[child].first;while source!=-1 {jo_key(o[..],jv_key(d,source));jv_write(d,source,o[..]);source=d.nodes[source].next;}if !rtq_hash_file(observer,hash[..]) {return false;}jo_key(o[..],"observer.coax");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);}else {jv_write(d,child,o[..]);}child=d.nodes[child].next;}jo_key(o[..],"renderer_source_sha256");jo_obj(o[..]);sources:=jv_get(d,0,"source_sha256");key:="aethyr/render/tests/reference-frame-native.coax";jo_key(o[..],key);jv_write(d,jv_get(d,sources,key),o[..]);if !rtq_hash_file(descriptor,hash[..]) {return false;}jo_key(o[..],"renderer.pbdesc");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);jo_end(o[..]);return !o[0].bad && fs_write(fs_join(directory,"measurement.json",paths[2][..]),jo_text(o[..]));}
