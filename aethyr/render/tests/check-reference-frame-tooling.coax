rft_run :: (argv:[]string,success:bool,work:string,label:string,out:[]u8,err:[]u8)->bool {env:[]string;r:=rtq_run_raw(argv,env,180000,out,err);if !rtq_record_run(work,label,argv,r,cast(string)out[0..<r.out_n],cast(string)err[0..<r.err_n]) {return false;}ok:=r.started==0 && !r.timed_out && !r.cut && r.status==(ifx success then 0 else 1);if !ok {tool_err("reference tooling outcome differs: ");tool_errln(label);tool_err(cast(string)err[0..<r.err_n]);}return ok;}
rft_projection :: (p:[]RfrConfig,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_arr(o[..]);jo_arr(o[..]);for i:0..<p[0].row_count {jo_arr(o[..]);for k:0..<p[0].rows[i].count {jo_str(o[..],rfr_token(p,i,k));}jo_end(o[..]);}jo_end(o[..]);jo_arr(o[..]);for i:0..<p[0].ref_count {jo_arr(o[..]);jo_int(o[..],p[0].refs[i].row);jo_int(o[..],p[0].refs[i].column);jo_end(o[..]);}jo_end(o[..]);jo_arr(o[..]);for n:p[0].counts {jo_int(o[..],n);}jo_end(o[..]);jo_arr(o[..]);for i:0..<p[0].tree_count {jo_int(o[..],p[0].tree_rows[i]);}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then "" else jo_text(o[..]);}
