#test "reference CLI preserves known flags and rejects unknown or missing values" {a:[1]Args;#assert args_add(a[..],"--prepare-only") && args_add(a[..],"--mode") && args_add(a[..],"debug") && rff_cli_shape(a[..]);#assert args_add(a[..],"--unknown") && !rff_cli_shape(a[..]);b:[1]Args;#assert args_add(b[..],"--mode") && !rff_cli_shape(b[..]);}
rff_cli_shape :: (a:[]Args)->bool {i:=0;while i<args_count(a) {key:=args_at(a,i);if key=="--coarse" || key=="--prepare-only" || key=="--explore-stale-compiler" {i+=1;continue;}known:=false;for name:[18]string.["--capture","--frame-config","--frame-provenance","--package","--work-dir","--reuse-backend","--raster-rounding","--subpixel-bits","--raster-provenance","--xy-clipping","--guard-pixels","--screen-format","--work-profile","--filter-profile","--filter-provenance","--mode","--coax","--compiler-source-digest"] {if key==name {known=true;}}if !known || i+1>=args_count(a) {return false;}next:=args_at(a,i+1);if next.count>=2 && next[0..<2]=="--" {return false;}i+=2;}return true;}
rff_note :: (commands:[]RffCommands,argv:[]string) {jo_arr(commands[0].o[..]);for arg:argv {jo_str(commands[0].o[..],arg);}jo_end(commands[0].o[..]);}
rff_run :: (commands:[]RffCommands,argv:[]string,env:[]string,deadline:int,work:string,label:string,out:[]u8,err:[]u8)->ProcRun {rff_note(commands,argv);return rtq_command(argv,env,deadline,work,label,out,err);}
rff_name :: (name:string)->bool {if name.count==0 || fs_base(name)!=name {return false;}for c:name {if rfr_white(c) {return false;}}return true;}
