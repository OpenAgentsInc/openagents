rff_changes :: (inputs:[]RtqInputs,o:[]Jo)->int {count:=0;hash:[64]u8;jo_arr(o);for i:0..<inputs[0].count {row:=inputs[0].rows[i];path:=cast(string)row.path[0..<row.count];if !rtq_hash_file(path,hash[..]) || cast(string)hash[..]!=cast(string)row.hash[..] {jo_str(o,path);count+=1;}}jo_end(o);return count;}
rff_input_inventory :: (p:[]RfrConfig,copies:[]RffCopies,inputs:string,config:string,capture:string,held:[]RtqInputs)->bool {
