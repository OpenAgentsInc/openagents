// Same-input parity against frozen original functions, never the old runner.
#import "Basic";
#load "reference-profiler-files.coax";
#load "reference-frame-tool-files.coax";
rfpt_run :: (argv:[]string,good:bool,work:string,label:string)->bool {stdout:[1048576]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(argv,env,proc_deadline(810000,proc_now_ms()),work,label,stdout[..],stderr[..]);return r.started==0 && !r.timed_out && !r.cut && (r.status==0)==good;}
rfpt_instrument :: (ref:string,source:string,points:[]RfpPoint,fragments:bool,extent:bool,work:string,label:string,good:bool)->bool {
  paths:[4][4096]u8;expected:=fs_join(work,"expected.c",paths[0][..]);flags:[256]u8;w:[1]Jo;jo_start(w[..],flags[..]);for p,i:points {if i>0 {jo_put(w[..],";");}jo_int(w[..],p.x);jo_put(w[..],",");jo_int(w[..],p.y);}script:="import sys;sys.path.insert(0,sys.argv[1]);from profile_reference_frame import instrument;from pathlib import Path;p=[tuple(map(int,q.split(','))) for q in sys.argv[4].split(';') if q];Path(sys.argv[3]).write_text(instrument(Path(sys.argv[2]).read_text(),p,sys.argv[5]=='1',sys.argv[6]=='1'))";argv:=[10]string.["python3","-c",script,ref,source,expected,jo_text(w[..]),ifx fragments then "1" else "0",ifx extent then "1" else "0",""];if !rfpt_run(argv[0..<9],good,work,label) {return false;}
  input:[8388608]u8;size:=fs_read(source,input[..]);if size<0 {return false;}probe:[65536]u8;n:=fs_read("aethyr/render/tests/reference-fragment-probe.h",probe[..]);if n<0 {return false;}out:[8388608]u8;scratch:[8388608]u8;value:=rfp_instrument(cast(string)input[0..<size],points,fragments,extent,cast(string)probe[0..<n],out[..],scratch[..]);if !good {return value.count==0;}actual:=fs_join(work,"actual.c",paths[1][..]);a:[64]u8;b:[64]u8;return value.count>0 && fs_write(actual,value) && rtq_hash_file(actual,a[..]) && rtq_hash_file(expected,b[..]) && cast(string)a[..]==cast(string)b[..];
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])<6 {tool_errln("OUT IMAGE REFERENCE_ROOT TINY_PROFILE GALAXY_PROFILE WATCHTOWER_MEASUREMENT [DRIVER]");return 2;}out_arg:=args_at(a[..],0);image:=args_at(a[..],1);reference_root:=args_at(a[..],2);tiny:=args_at(a[..],3);galaxy:=args_at(a[..],4);watchtower:=args_at(a[..],5);driver:=args_at(a[..],6);if driver.count==0 {driver="aethyr/render/tests/reference-frame-native.c";}if !fs_mkdir(out_arg) {return 1;}canonical:[4096]u8;work:=fs_realpath(out_arg,canonical[..]);paths:[12][4096]u8;ref:=fs_join(work,"reference",paths[0][..]);if !fs_mkdir(ref) {return 1;}
  for name:[4]string.["profile_reference_frame.py","test_reference_profiler.py","check_pipeline.py","reference-fragment-probe.h"] {dir:[4096]u8;from:[4096]u8;to:[4096]u8;if !rff_copy(fs_join(fs_join(reference_root,"aethyr/render/tests",dir[..]),name,from[..]),fs_join(ref,name,to[..])) {return 1;}}
  resume_text:=args_at(a[..],7);resume:=ifx resume_text.count==0 then 0 else rfr_number(resume_text).value;if resume<0 || resume>6 {return 2;}if resume==0 {tests:=[2]string.["python3",fs_join(ref,"test_reference_profiler.py",paths[1][..])];if !rfpt_run(tests[..],true,work,"original-unit-tests") {return 1;}}
  source:=fs_join(work,"fixture.c",paths[1][..]);if !fs_write(source,RFP_TEST_C) {return 1;}p:=[2]RfpPoint.[RfpPoint.{x=0,y=0},RfpPoint.{x=1,y=1}];control_measurement:[4096]u8;control_measurement_n:=0;for mode:resume..<6 {label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"synthetic-mode-");jo_int(w[..],mode);if !rfpt_instrument(ref,source,p[0..<(ifx mode>=2 then 2 else 0)],mode>=4,mode%2==1,work,jo_text(w[..]),true) {tool_errln("synthetic instrumentation parity differs");return 1;}}
  for text,i:[5]string.["", "static coax_t_RRVertices coax_p_rr_vertices(int x);\n", "static coax_t_RRVertices coax_p_rr_vertices(int x) {return v;}\n", "static coax_t_RRVertices coax_p_rr_vertices(int x) {return v;}\nstatic coax_t_RRVertices coax_p_rr_vertices(int x) {return v;}\n", "static coax_t_RRShaded coax_p_rr_shade(int x) {return f;}\n"] {if !fs_write(source,text) {return 1;}label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],"definition-refusal-");jo_int(w[..],i);if !rfpt_instrument(ref,source,p[0..<0],false,false,work,jo_text(w[..]),false) {return 1;}}
  for profile,i:[2]string.[tiny,galaxy] {bytes:[4194304]u8;nodes:[65536]JvNode;doc:[1]Jv;if !rtq_json_file(profile,bytes[..],nodes[..],doc[..]) || !rfr_literal(doc[0],jv_get(doc[0],0,"status"),"pass") || jv_kind(doc[0],jv_get(doc[0],0,"qualification"))!=JV_FALSE || !rfr_literal(doc[0],jv_get(doc[0],0,"qualification_status"),"exploratory") {return 1;}
    commands:=jv_get(doc[0],0,"commands");compile:=jv_at(doc[0],commands,0);generated_path:[4096]u8;gn:=jv_str(doc[0],jv_at(doc[0],compile,8),generated_path[..]);
    // The profiler's generated C bytes are compared with the old function on
    // the exact original C path authenticated by its retained measurement.
    inputs:=jv_get(doc[0],0,"input_sha256");row:=doc[0].nodes[inputs].first;measurement:="";while row!=-1 {key:=jv_key(doc[0],row);if fs_base(key)=="measurement.json" {measurement=key;break;}row=doc[0].nodes[row].next;}mb:[4194304]u8;mnodes:[65536]JvNode;md:[1]Jv;if measurement.count==0 || !rtq_json_file(measurement,mb[..],mnodes[..],md[..]) {return 1;}if i==0 {control_measurement_n=rtn_text(control_measurement[..],measurement);if control_measurement_n<1 {return 1;}}original:[4096]u8;on:=jv_str(md[0],jv_get(md[0],0,"generated_c_path"),original[..]);if on<1 || gn<1 {return 1;}for mode:0..<6 {label:[128]u8;w:[1]Jo;jo_start(w[..],label[..]);jo_put(w[..],ifx i==0 then "tiny-c-mode-" else "galaxy-c-mode-");jo_int(w[..],mode);if !rfpt_instrument(ref,cast(string)original[0..<on],p[0..<(ifx mode>=2 then 2 else 0)],mode>=4,mode%2==1,work,jo_text(w[..]),true) {return 1;}}
    expected:[64]u8;actual:[64]u8;generated:=cast(string)generated_path[0..<gn];if !rfpt_instrument(ref,cast(string)original[0..<on],p[..],true,true,work,ifx i==0 then "tiny-native-exact-source" else "galaxy-native-exact-source",true) || !rtq_hash_file(generated,actual[..]) || !rtq_hash_file(fs_join(work,"expected.c",paths[2][..]),expected[..]) || cast(string)actual[..]!=cast(string)expected[..] {return 1;}
    // Keep the exact diagnostic JSON tokens. Python's old loads/dumps changes
    // number spelling; that formatting is not pixel or numerical tolerance.
    script:="import sys;from pathlib import Path;e=(Path(sys.argv[1])/'execution.stderr').read_text().splitlines();print('{'+','.join('\"'+k+'\":['+','.join(s[len(p):] for s in e if s.startswith(p))+']' for k,p in [('stages','RF_COST '),('pixel_records','RF_PIXEL '),('fragment_records','RF_FRAGMENT '),('extent_records','RF_EXTENT ')])+'}')";argv:=[4]string.["python3","-c",script,fs_dir(profile)];stdout:[8388608]u8;stderr:[65536]u8;env:[]string;r:=rtq_run_raw(argv[..],env,810000,stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}observed_nodes:[32768]JvNode;observed:[1]Jv;if !jv_parse(observed[..],cast(string)stdout[0..<r.out_n],observed_nodes[..]) {return 1;}for key:[4]string.["stages","pixel_records","fragment_records","extent_records"] {if !rtq_equal(doc[0],jv_get(doc[0],0,key),observed[0],jv_get(observed[0],0,key)) {tool_errln("diagnostic raw token difference");return 1;}}
  }
  wb:[4194304]u8;wn:[65536]JvNode;wd:[1]Jv;if !rtq_json_file(watchtower,wb[..],wn[..],wd[..]) || rfp_admitted_driver(driver,wd[0]) {tool_errln("missing historical Watchtower driver must refuse");return 1;}
  exe:=fs_join(work,"renderer",paths[2][..]);if !fs_write(exe,"renderer") {return 1;}fixture:[32768]u8;w:[1]Jo;jo_start(w[..],fixture[..]);jo_obj(w[..]);jo_key(w[..],"commands");jo_arr(w[..]);jo_arr(w[..]);jo_str(w[..],"coax");jo_str(w[..],"deps");jo_end(w[..]);jo_arr(w[..]);for v:[4]string.[exe,"frame.config","screen","receipt"] {jo_str(w[..],v);}jo_end(w[..]);jo_arr(w[..]);jo_str(w[..],"coax");jo_str(w[..],"source-digest");jo_end(w[..]);jo_end(w[..]);jo_end(w[..]);cn:[128]JvNode;cd:[1]Jv;if !jv_parse(cd[..],jo_text(w[..]),cn[..]) {return 1;}cmd:[32]string;storage:[65536]u8;if rfp_render_command(cd[0],exe,cmd[..],storage[..])!=4 || cmd[0]!=exe || cmd[3]!="receipt" {return 1;}
  if rfp_records("RF_COST {bad}\n","RF_COST ","",fixture[..]).count!=0 {return 1;}if rfp_records("ignore\nRF_ERROR {\"status\":1}\nRF_TRIANGLE_ERROR {\"status\":2}\n","RF_ERROR ","RF_TRIANGLE_ERROR ",fixture[..])!="[{\"status\":1},{\"status\":2}]" {return 1;}
  compiler:="/tmp/aethyr-authority-budget-qualified-1fac/coax";digest:="/Users/christopherdavid/work/openagents-aethyr-check-budgets-current/coax/bin/source-digest";control_base:=[12]string.[image,"--measurement",watchtower,"--work-dir","","--coax",compiler,"--compiler-source-digest",digest,"--explore-stale-compiler","--driver",driver];for which:0..<7 {name:[128]u8;ww:[1]Jo;jo_start(ww[..],name[..]);jo_put(ww[..],"cli-refusal-");jo_int(ww[..],which);directory:=fs_join(work,jo_text(ww[..]),paths[3][..]);control_base[4]=directory;args:[20]string;for v,i:control_base {args[i]=v;}count:=12;if which!=0 {args[2]=cast(string)control_measurement[0..<control_measurement_n];}if which==1 {args[9]="--unknown";}if which==2 {args[count]="--fragments";count+=1;}if which==3 {args[count]="--pixels";args[count+1]="-1,0";count+=2;}if which==4 {args[count]="--pixels";args[count+1]="0,0,1";count+=2;}if which==5 {args[2]="missing-measurement";}if which==6 {count=9;}if !rfpt_run(args[0..<count],false,work,jo_text(ww[..])) {return 1;}if which==6 {list:[1]FsList;if fs_list(directory,list[..])!=6 {return 1;}}}
  report:[16384]u8;o:[1]Jo;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"original_unit_tests");jo_int(o[..],ifx resume==0 then 3 else 0);jo_key(o[..],"synthetic_resume_index");jo_int(o[..],resume);jo_key(o[..],"prior_synthetic_cases_retained");jo_int(o[..],resume);jo_key(o[..],"same_input_instrumentation_cases");jo_int(o[..],20-resume);jo_key(o[..],"definition_refusals");jo_int(o[..],5);jo_key(o[..],"native_profiles");jo_int(o[..],2);jo_key(o[..],"watchtower_exact_driver_refused");jo_bool(o[..],true);jo_key(o[..],"cli_refusals");jo_int(o[..],7);jo_key(o[..],"status");jo_str(o[..],"pass");jo_end(o[..]);if o[0].bad || !fs_write(fs_join(work,"qualification.json",paths[4][..]),jo_text(o[..])) {return 1;}print("profiler parity: exact instrumentation, frozen input/result/pixels, strict driver and source gates\n");return 0;
}
