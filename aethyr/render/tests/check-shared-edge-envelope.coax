// Geometry-only oracle orchestration and an independent integer-lattice census.
// No image path, image decoder, fragment evaluator or comparator is loaded.
#import "Basic";
#load "qualification-files.coax";
#load "shared-edge-envelope-policy.coax";
SE_ORACLE :: "aethyr/render/tests/shared_edge_envelope_oracle.py";
SE_GEOMETRY_HASH :: "62823c676088a5296d1ca46bc265aafe93b1946dec1f60268ee05818474d3302";
SeEdge :: struct {valid:bool;ax:int;ay:int;bx:int;by:int;}
se_artifact :: (d:Jv,key:string,name:string,directory:string,inputs:[]RtqInputs)->bool {node:=jv_get(d,0,key);path:[4096]u8;file:=fs_join(directory,name,path[..]);hash:[64]u8;return jv_raw(d,jv_get(d,node,"file"))==name && jv_int(d,jv_get(d,node,"bytes"),-1)==fs_size(file) && rtq_hash_file(file,hash[..]) && jv_raw(d,jv_get(d,node,"sha256"))==cast(string)hash[..] && rtq_input_add(inputs,file);}
se_edges :: (directory:string,held:[]RtqInputs,edges:[]SeEdge,expected:int,mask:[]u8,zero:[]u8)->int {
 path:[4096]u8;raw:[16777216]u8;n:=fs_read(fs_join(directory,"edges.jsonl",path[..]),raw[..]);if n<0 {return -1;}nodes:[4096]JvNode;d:[1]Jv;at:=0;count:=0;visits:=0;
 for k:0..<n {if raw[k]!='\n' {continue;}if k>at {if count>=edges.count || !jv_parse(d[..],cast(string)raw[at..<k],nodes[..]) || jv_int(d[0],jv_get(d[0],0,"id"),-1)!=count {return -1;}points:=jv_get(d[0],0,"snapped_xy_units_1_512");a:=jv_at(d[0],points,0);b:=jv_at(d[0],points,1);edge:=SeEdge.{valid=true,ax=jv_int(d[0],jv_at(d[0],a,0),41943041),ay=jv_int(d[0],jv_at(d[0],a,1),41943041),bx=jv_int(d[0],jv_at(d[0],b,0),41943041),by=jv_int(d[0],jv_at(d[0],b,1),41943041)};
   for c:[4]int.[edge.ax,edge.ay,edge.bx,edge.by] {if c< -41943040 || c>41943040 || c%2!=0 {return -1;}}if edge.ax==edge.bx && edge.ay==edge.by {return -1;}owners:=jv_get(d[0],0,"eligible_primitive_ids");if jv_kind(d[0],owners)!=JV_ARRAY || jv_len(d[0],owners)<2 {return -1;}for i:0..<jv_len(d[0],owners) {owner:=jv_int(d[0],jv_at(d[0],owners,i),-1);if owner<0 || owner>=6876 {return -1;}}
   dx:=cast(int)abs(cast(f64)(edge.bx-edge.ax));dy:=cast(int)abs(cast(f64)(edge.by-edge.ay));xmin:=cast(int)(-floor(-cast(f64)((edge.ax+edge.bx-dx)/2-257)/512));xmax:=cast(int)floor(cast(f64)((edge.ax+edge.bx+dx)/2-255)/512);ymin:=cast(int)(-floor(-cast(f64)((edge.ay+edge.by-dy)/2-257)/512));ymax:=cast(int)floor(cast(f64)((edge.ay+edge.by+dy)/2-255)/512);
   if xmin<0 {xmin=0;}if ymin<0 {ymin=0;}if xmax>319 {xmax=319;}if ymax>179 {ymax=179;}if xmin<=xmax && ymin<=ymax {for y:ymin..<ymax+1 {for x:xmin..<xmax+1 {visits+=1;if visits>100000000 {return -1;}index:=y*320+x;if se_point(edge.ax,edge.ay,edge.bx,edge.by,x*512+256,y*512+256,1) {mask[index]=1;}if se_point(edge.ax,edge.ay,edge.bx,edge.by,x*512+256,y*512+256,0) {zero[index]=1;}}}}
   edges[count]=edge;count+=1;
  }at=k+1;}return ifx at==n && count==expected then visits else -1;
}
se_witnesses :: (directory:string,edges:[]SeEdge,count:int,mask:[]u8,expected:int)->bool {
 path:[4096]u8;raw:[4194304]u8;n:=fs_read(fs_join(directory,"witnesses.jsonl",path[..]),raw[..]);if n<0 {return false;}nodes:[1024]JvNode;d:[1]Jv;at:=0;records:=0;seen:[57600]u8;
 for k:0..<n {if raw[k]!='\n' {continue;}if k>at {if !jv_parse(d[..],cast(string)raw[at..<k],nodes[..]) {return false;}id:=jv_int(d[0],jv_get(d[0],0,"edge"),-1);x:=jv_int(d[0],jv_get(d[0],0,"x"),-1);y:=jv_int(d[0],jv_get(d[0],0,"y"),-1);if id<0 || id>=count || x<0 || x>=320 || y<0 || y>=180 {return false;}edge:=edges[id];t:=jv_get(d[0],0,"t");lo:=jv_at(d[0],t,0);hi:=jv_at(d[0],t,1);if !se_interval(edge.ax,edge.ay,edge.bx,edge.by,x*512+256,y*512+256,jv_int(d[0],jv_at(d[0],lo,0),-1),jv_int(d[0],jv_at(d[0],lo,1),-1),jv_int(d[0],jv_at(d[0],hi,0),-1),jv_int(d[0],jv_at(d[0],hi,1),-1)) {return false;}zero:=se_point(edge.ax,edge.ay,edge.bx,edge.by,x*512+256,y*512+256,0);if jv_kind(d[0],jv_get(d[0],0,"zero_radius_centerline"))!=(ifx zero then JV_TRUE else JV_FALSE) {return false;}seen[y*320+x]=1;records+=1;}at=k+1;}return at==n && records==expected && cast(string)seen[..]==cast(string)mask;
}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) {return 2;}geometry:=args_value(a[..],"--geometry","");certificate:=args_value(a[..],"--certificate","");out_arg:=args_value(a[..],"--out","");if geometry=="" || certificate=="" || out_arg=="" || !fs_mkdir(out_arg) {return 2;}out_buf:[4096]u8;work:=fs_realpath(out_arg,out_buf[..]);listing:[1]FsList;if work=="" || fs_list(work,listing[..])!=0 {return 2;}
 held:[1]RtqInputs;for file:[4]string.[geometry,certificate,SE_ORACLE,"aethyr/render/tests/test_shared_edge_envelope_oracle.py"] {if !rtq_input_add(held[..],file) {return 1;}}compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_input_add(held[..],compiler) || !rtq_deps(held[..],compiler,"aethyr/render/tests/check-shared-edge-envelope.coax",proc_now_ms()+30000,work,"dependencies") {return 1;}
 for name:[4]string.["tool-native","process-native","store-file-native","read-file-native"] {for ext:[2]string.[".c",".h"] {path:[4096]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],ext);if !rtq_input_add(held[..],jo_text(o[..])) {return 1;}}}self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 || !rtq_input_add(held[..],cast(string)self[0..<self_n]) {return 1;}
 raw:[1048576]u8;nodes:[8192]JvNode;d:[1]Jv;hash:[64]u8;if fs_size(geometry)!=1155168 || !rtq_hash_file(geometry,hash[..]) || cast(string)hash[..]!=SE_GEOMETRY_HASH || !rtq_json_file(certificate,raw[..],nodes[..],d[..]) {return 1;}
 p:=jv_get(d[0],0,"profile");g:=jv_get(d[0],0,"geometry");radius:=jv_get(d[0],0,"radius");mode:=jv_raw(d[0],jv_get(d[0],p,"rounding"));if jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.render.shared-edge-envelope.v1" || jv_raw(d[0],jv_get(d[0],0,"algorithm_version"))!="exact-shared-world-fold-linf-cell-v1" || jv_raw(d[0],jv_get(d[0],0,"scope"))!="declared_conservative_geometry_boundary_not_hardware_error_bound" || jv_int(d[0],jv_get(d[0],0,"width"),-1)!=320 || jv_int(d[0],jv_get(d[0],0,"height"),-1)!=180 || (mode!="nearest-even" && mode!="nearest-positive") || jv_int(d[0],jv_get(d[0],p,"subpixel_bits"),-1)!=8 || jv_raw(d[0],jv_get(d[0],p,"xy"))!="guard-band" || jv_int(d[0],jv_get(d[0],p,"guard_pixels"),-1)!=65536 || jv_int(d[0],jv_get(d[0],radius,"numerator"),-1)!=1 || jv_int(d[0],jv_get(d[0],radius,"denominator"),-1)!=512 || jv_raw(d[0],jv_get(d[0],g,"sha256"))!=SE_GEOMETRY_HASH || jv_int(d[0],jv_get(d[0],g,"bytes"),-1)!=1155168 || jv_int(d[0],jv_get(d[0],g,"triangles"),-1)!=6876 || jv_int(d[0],jv_get(d[0],g,"vertex_stride_bytes"),-1)!=56 || jv_kind(d[0],jv_get(d[0],0,"admitted"))!=JV_FALSE || jv_kind(d[0],jv_get(d[0],0,"image_inputs"))!=JV_ARRAY || jv_len(d[0],jv_get(d[0],0,"image_inputs"))!=0 {return 1;}
 source:=jv_get(d[0],0,"oracle_source");oracle_hash:[64]u8;if !rtq_hash_file(SE_ORACLE,oracle_hash[..]) || jv_raw(d[0],jv_get(d[0],source,"sha256"))!=cast(string)oracle_hash[..] {return 1;}directory:=fs_dir(certificate);for key,i:[5]string.["mask","zero_radius_control","zero_mask_control","edges","witnesses"] {name:=[5]string.["mask.bin","zero-radius-mask.bin","zero-mask.bin","edges.jsonl","witnesses.jsonl"][i];if !se_artifact(d[0],key,name,directory,held[..]) {return 1;}}
 masks:[3][57600]u8;paths:[3][4096]u8;for file,i:[3]string.["mask.bin","zero-radius-mask.bin","zero-mask.bin"] {if fs_read(fs_join(directory,file,paths[i][..]),masks[i][..])!=57600 || se_count(masks[i][..])!=jv_int(d[0],jv_get(d[0],jv_get(d[0],0,[3]string.["mask","zero_radius_control","zero_mask_control"][i]),"pixels"),-1) {return 1;}}if se_count(masks[2][..])!=0 {return 1;}
 edge_count:=jv_int(d[0],jv_get(d[0],jv_get(d[0],0,"edges"),"records"),-1);witness_count:=jv_int(d[0],jv_get(d[0],jv_get(d[0],0,"witnesses"),"records"),-1);edges:[20628]SeEdge;fresh:[2][57600]u8;visits:=se_edges(directory,held[..],edges[..],edge_count,fresh[0][..],fresh[1][..]);same_mask:=visits>=0 && cast(string)fresh[0][..]==cast(string)masks[0][..] && cast(string)fresh[1][..]==cast(string)masks[1][..];witnesses:=same_mask && se_witnesses(directory,edges[..],edge_count,masks[0][..],witness_count);same:=rtq_inputs_match(held[..]);passed:=same_mask && witnesses && same;
 record:[4194304]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.shared-edge-independent-census.v1");jo_key(o[..],"status");jo_str(o[..],ifx passed then "math_verified_unadmitted_geometry_scope" else "failed");jo_key(o[..],"mask_pixels");jo_int(o[..],se_count(masks[0][..]));jo_key(o[..],"zero_radius_centerline_pixels");jo_int(o[..],se_count(masks[1][..]));jo_key(o[..],"zero_mask_pixels");jo_int(o[..],se_count(masks[2][..]));jo_key(o[..],"global_integer_predicate_matches_fraction_oracle");jo_bool(o[..],same_mask);jo_key(o[..],"every_witness_exact_rational_interval_verified");jo_bool(o[..],witnesses);jo_key(o[..],"eligible_shared_fold_edges");jo_int(o[..],edge_count);jo_key(o[..],"predicate_pixel_visits");jo_int(o[..],visits);jo_key(o[..],"witnesses");jo_int(o[..],witness_count);jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],held[..],"");jo_key(o[..],"source_changes");jo_arr(o[..]);if !same {jo_str(o[..],"source fence changed");}jo_end(o[..]);jo_key(o[..],"image_inputs");jo_arr(o[..]);jo_end(o[..]);jo_key(o[..],"admitted");jo_bool(o[..],false);jo_end(o[..]);path:[4096]u8;if o[0].bad || !fs_write(fs_join(work,"qualification.json",path[..]),jo_text(o[..])) {return 1;}print("shared edge geometry-only independent mask census: % (%pixels, %edges, %visits)\n",passed,se_count(masks[0][..]),edge_count,visits);return ifx passed then 0 else 1;
}
