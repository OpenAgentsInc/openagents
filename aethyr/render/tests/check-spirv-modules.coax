  jo_key(o[..],"declared_programs");jo_int(o[..],s[0].declared);jo_key(o[..],"unique_programs");jo_int(o[..],s[0].n);jo_key(o[..],"compiler_version");jo_str(o[..],cast(string)version[0..<version_n]);jo_key(o[..],"compiler_sha256");jo_str(o[..],cast(string)compiler_hash[..]);jo_key(o[..],"compiler_recorded_source_digest");jo_str(o[..],recorded_text);jo_key(o[..],"compiler_current_source_digest");jo_str(o[..],cast(string)current[0..<current_n]);jo_key(o[..],"compiler_current_sources_match");jo_bool(o[..],!stale);
  jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],inputs[..],root);jo_key(o[..],"source_changes");jo_arr(o[..]);jo_end(o[..]);jo_key(o[..],"result");jv_write(result[0],0,o[..]);
  jo_key(o[..],"remote_script_sent");jo_bool(o[..],false);jo_key(o[..],"remote_program_bytes_verified_before_and_after");jo_bool(o[..],true);jo_key(o[..],"remote_validator_hash_unchanged");jo_bool(o[..],true);jo_key(o[..],"remote_owned_directory_removed");jo_bool(o[..],true);jo_key(o[..],"same_input_reference");jo_str(o[..],reference_path);jo_key(o[..],"same_input_reference_equal");jo_bool(o[..],reference_path.count>0);jo_key(o[..],"elapsed_ms");jo_int(o[..],proc_now_ms()-start);
  jo_key(o[..],"scope");jo_str(o[..],"Exact supplied package programs validated for Vulkan1.1 by the pinned installed validator with bad-magic and type-zero refusal controls. No pipeline creation, GPU execution, image, current package build provenance or matching-main compiler claim when exploratory.");jo_end(o[..]);
  if o[0].bad || !fs_mkdir(fs_dir(receipt)) || !fs_write(receipt,jo_text(o[..])) {return 1;}
  print("SPIR-V: % declared, % unique, 2 controls; %\n",s[0].declared,s[0].n,ifx stale then "explicit exploratory compiler" else "matching-source qualification");return 0;
}
