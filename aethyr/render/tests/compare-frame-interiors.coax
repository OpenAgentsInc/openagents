// Finite pinned DG boundary-envelope comparison. Strict compare-frames v1 is unchanged.
// All15 --name VALUE options are required; see compare-frame-interiors-tool-policy.coax.
#import "Basic";
#load "compare-frame-interiors-tool-policy.coax";
#load "compare-interiors-policy.coax";
#load "qualification-files.coax";
#load "../../../coax/lib/crypto/sha256.coax";
CI_SOURCE :: "aethyr/render/tests/compare-frame-interiors.coax";
CI_RULE :: "abs(gpu-cpu) <= 0.002 * max(1, abs(cpu)); all original values finite";
ci_final_hash :: (state:[]u8,out:[]u8)->bool {bytes:[32]u8;if sha256_final_checked(state,bytes[..],false)!=SHA_OK {return false;}d:S_Digest;for k:0..<8 {d.words[k]=cb_load_be32(bytes[..],k*4).value;}return S_hex(d,out);}
ci_hash :: (path:string,out:[]u8,deadline:int)->bool {n:=fs_size(path);if n<0 || n>67108864 {return false;}state:[112]u8;if sha256_init(state[..])!=SHA_OK {return false;}bytes:[65536]u8;at:=0;while at<n {if proc_now_ms()>deadline {return false;}count:=ifx n-at<bytes.count then n-at else bytes.count;if fs_read_at(path,at,bytes[0..<count])!=count || sha256_update_checked(state[..],bytes[0..<count],false)!=SHA_OK {return false;}at+=count;}return fs_size(path)==n && ci_final_hash(state[..],out);}
ci_blob :: (path:string,out:[]u8,expected:string)->int {n:=fs_size(path);if n<0 || n>out.count || fs_read_at(path,0,out[0..<n])!=n {return -1;}hash:[64]u8;if !S_hex(S_hash(cast(string)out[0..<n]),hash[..]) || cast(string)hash[..]!=expected {return -1;}return n;}
// Exact binary64 diagnostics avoid lossy decimal formatting. The label is
// unsigned IEEE754 bits, hexadecimal most-significant digit first.
ci_bits :: (o:[]Jo,value:f64) {if !cf_finite(value) {jo_str(o,ifx value!=value then "nan" else ifx value>0 then "+inf" else "-inf");return;}word:=f64_bits(value);text:[16]u8;hex:="0123456789abcdef";for i:0..<16 {text[i]=hex[cast(int)((word>>cast(u64)((15-i)*4))&15)];}jo_str(o,cast(string)text[..]);}
ci_result :: (o:[]Jo,r:CFResult) {jo_obj(o);jo_key(o,"status");jo_str(o,ifx r.status==CFStatus.ok then "pass" else "fail");jo_key(o,"pixels");jo_int(o,r.pixels);jo_key(o,"checked_channels");jo_int(o,r.channels);jo_key(o,"colour_failures");jo_int(o,r.colour_failures);jo_key(o,"nonfinite_failures");jo_int(o,r.nonfinite_failures);jo_key(o,"max_absolute_error_binary64");ci_bits(o,r.max_absolute_error);jo_key(o,"max_normalized_error_binary64");ci_bits(o,r.max_normalized_error);jo_key(o,"samples");jo_arr(o);for i:0..<r.sample_count {s:=r.samples[i];jo_obj(o);jo_key(o,"x");jo_int(o,s.x);jo_key(o,"y");jo_int(o,s.y);jo_key(o,"channel");jo_int(o,s.channel);jo_key(o,"cpu_binary64");ci_bits(o,s.cpu);jo_key(o,"gpu_binary64");ci_bits(o,s.gpu);jo_key(o,"absolute_error_binary64");ci_bits(o,s.absolute_error);jo_key(o,"bound_binary64");ci_bits(o,s.bound);jo_key(o,"nonfinite");jo_bool(o,s.nonfinite);jo_end(o);}jo_end(o);jo_end(o);}
#test "interior diagnostics preserve signed zero exact finite words and nonfinite labels" {out:[128]u8;o:[1]Jo;for word:[3]u64.[0x8000000000000000,0x7fefffffffffffff,0x3ff8000000000000] {jo_start(o[..],out[..]);ci_bits(o[..],f64_from_bits(word));nodes:[4]JvNode;d:[1]Jv;#assert jv_parse(d[..],jo_text(o[..]),nodes[..]);#assert jv_raw(d[0],0).count==16;}jo_start(o[..],out[..]);ci_bits(o[..],1.5);#assert jo_text(o[..])=="\"3ff8000000000000\"";jo_start(o[..],out[..]);ci_bits(o[..],f64_from_bits(0x8000000000000000));#assert jo_text(o[..])=="\"8000000000000000\"";for value,i:[3]f64.[0.0/0.0,1.0/0.0,-1.0/0.0] {jo_start(o[..],out[..]);ci_bits(o[..],value);wanted:=[3]string.["\"nan\"","\"+inf\"","\"-inf\""];#assert jo_text(o[..])==wanted[i];}}
ci_inventory :: (inputs:[]RtqInputs,compiler:string,deadline:int)->bool {
 out:[1048576]u8;err:[65536]u8;argv:=[4]string.[compiler,"deps",CI_SOURCE,"--library"];env:[]string;r:=rtq_run(argv[..],env,deadline,out[..],err[..]);if !rtq_ok(r) {return false;}nodes:[8192]JvNode;d:[1]Jv;if !jv_parse(d[..],cast(string)out[0..<r.out_n],nodes[..]) {return false;}
 for key:[2]string.["sources","descriptors"] {list:=jv_get(d[0],0,key);if jv_kind(d[0],list)!=JV_ARRAY {return false;}for i:0..<jv_len(d[0],list) {path:[4096]u8;n:=jv_str(d[0],jv_at(d[0],list,i),path[..]);if n<1 || !rtq_input_add(inputs,cast(string)path[0..<n]) {return false;}}}
 for path:[16]string.["coax/web/tool.sh","coax/lib/crypto/entropy.coax","coax/platform/tool-native.c","coax/platform/tool-native.h","coax/platform/process-native.c","coax/platform/process-native.h","coax/platform/store-file-native.c","coax/platform/store-file-native.h","coax/platform/read-file-native.c","coax/platform/read-file-native.h","coax/platform/socket-native.c","coax/platform/socket-native.h","coax/platform/entropy-native.c","coax/platform/entropy-native.h","coax/platform/entropy-foreign.c","coax/platform/entropy-foreign.h"] {if !rtq_input_add(inputs,path) {return false;}}
 self:[4096]u8;n:=cxproc_self_path(self[..]);return n>0 && rtq_input_add(inputs,cast(string)self[0..<n]) && rtq_input_add(inputs,compiler);
}
// Directory entry enumeration also refuses dangling symlinks; fs_exists alone
// follows symlinks. Repeated immediately before publication, not atomic O_EXCL.
ci_fresh :: (path:string)->bool {if !fs_path_ok(path) || fs_kind(path)!=FS_NONE {return false;}base:=fs_base(path);if base=="" || base=="." || base==".." {return false;}list:[1]FsList;n:=fs_list(fs_dir(path),list[..]);if n<0 || list[0].full {return false;}for i:0..<n {if fs_entry(list[..],i)==base {return false;}}return true;}
ci_rows :: (path:string,expected:string,deadline:int)->int {n:=fs_size(path);if n<0 || n>67108864 {return -1;}state:[112]u8;if sha256_init(state[..])!=SHA_OK {return -1;}bytes:[65536]u8;at:=0;rows:=0;last:u8=0;while at<n {if proc_now_ms()>deadline {return -1;}count:=ifx n-at<bytes.count then n-at else bytes.count;if fs_read_at(path,at,bytes[0..<count])!=count || sha256_update_checked(state[..],bytes[0..<count],false)!=SHA_OK {return -1;}for byte:bytes[0..<count] {if byte==10 {rows+=1;}last=byte;}at+=count;}hash:[64]u8;if (n>0 && last!=10) || !ci_final_hash(state[..],hash[..]) || cast(string)hash[..]!=expected {return -1;}return rows;}
tool_main :: ()->int #export_c {
 args:[1]Args;if !args_load(args[..]) {return 2;}options:=cip_parse(args[0].v[0..<args[0].n]);if !options.valid {tool_errln("interiors: require each of15 closed options once, with a nonempty bounded value");return 2;}v:=options.values;
 // Receipt admission precedes writes and image ingress.
 parent:[4096]u8;receipt:[4096]u8;dir:=fs_realpath(fs_dir(v[14]),parent[..]);if dir=="" {return 2;}receipt_path:=fs_join(dir,fs_base(v[14]),receipt[..]);if !ci_fresh(receipt_path) {tool_errln("interiors: receipt must be a new directory entry");return 2;}
 deadline:=proc_now_ms()+810000;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {tool_errln("interiors: explicit COAX compiler is required");return 2;}sources:[1]RtqInputs;if !ci_inventory(sources[..],compiler,deadline) {tool_errln("interiors: compiler/source inventory refused");return 2;}
 slots:=[8]int.[6,7,8,9,10,11,12,13];names:[8][4096]u8;paths:[8]string;hashes:[8][64]u8;sizes:[8]int;
 for i:0..<8 {paths[i]=fs_realpath(v[slots[i]],names[i][..]);sizes[i]=fs_size(paths[i]);if paths[i]=="" || !ci_hash(paths[i],hashes[i][..],deadline) {tool_errln("interiors: certificate artifact unreadable");return 2;}}
 cert_bytes:[65536]u8;cert_n:=ci_blob(paths[0],cert_bytes[..],cast(string)hashes[0][..]);nodes:[1024]JvNode;doc:[1]Jv;if cert_n<0 || !jv_parse(doc[..],cast(string)cert_bytes[0..<cert_n],nodes[..]) {tool_errln("interiors: certificate JSON refused");return 2;}d:=doc[0];certificate:=cia_read(d);
 if !cip_pinned(certificate) {tool_errln("interiors: independently frozen finite DG geometry/mask/source/profile identities refused");return 2;}
 geometry:[3360000]u8;gn:=ci_blob(paths[1],geometry[..],cast(string)hashes[1][..]);mask:[1048576]u8;mn:=ci_blob(paths[2],mask[..],cast(string)hashes[2][..]);zero:[1048576]u8;zn:=ci_blob(paths[6],zero[..],cast(string)hashes[6][..]);center:[1048576]u8;cn:=ci_blob(paths[7],center[..],cast(string)hashes[7][..]);
 if gn<0 || mn<0 || zn<0 || cn<0 || !cia_geometry(geometry[0..<gn]) {tool_errln("interiors: bounded finite geometry or consumed artifact hash refused");return 2;}
 mask_count:=cia_mask_count(mask[0..<mn]);observed:=CiObserved.{width=args_whole(v[3]),height=args_whole(v[4]),profile=v[5],geometry_bytes=gn,mask_bytes=mn,mask_pixels=mask_count,edges_bytes=sizes[4],witness_bytes=sizes[5],geometry_hash=cast(string)hashes[1][..],mask_hash=cast(string)hashes[2][..],oracle_hash=cast(string)hashes[3][..],oracle_path=paths[3],edges_hash=cast(string)hashes[4][..],witness_hash=cast(string)hashes[5][..]};
 center_node:=cia_member(d,0,"zero_radius_control");zero_node:=cia_member(d,0,"zero_mask_control");if !cia_bind(certificate,observed) || zn!=mn || cn!=mn || cia_mask_count(zero[0..<zn])!=0 || cia_mask_count(center[0..<cn])!=62 || cia_hash(d,center_node,"sha256")!=cast(string)hashes[7][..] || cia_hash(d,zero_node,"sha256")!=cast(string)hashes[6][..] || cia_int(d,center_node,"pixels")!=62 {tool_errln("interiors: certificate/profile/file/shape/source joins refused");return 2;}
 if !cip_control_hashes(cast(string)hashes[7][..],cast(string)hashes[6][..]) || !cip_subset(center[0..<cn],mask[0..<mn]) {tool_errln("interiors: frozen zero controls or centerline subset refused");return 2;}
 edge_rows:=ci_rows(paths[4],cast(string)hashes[4][..],deadline);witness_rows:=ci_rows(paths[5],cast(string)hashes[5][..],deadline);if edge_rows!=cia_int(d,cia_member(d,0,"edges"),"records") || witness_rows!=cia_int(d,cia_member(d,0,"witnesses"),"records") {tool_errln("interiors: sidecar record joins refused");return 2;}
 // No image contents or paths are opened until all preceding admissions pass.
 cpu_name:[4096]u8;gpu_name:[4096]u8;cpu_path:=fs_realpath(v[0],cpu_name[..]);gpu_path:=fs_realpath(v[1],gpu_name[..]);format:=cf_format(v[2]);cpu_bytes:=fs_size(cpu_path);gpu_bytes:=fs_size(gpu_path);r:=cfi_begin(observed.width,observed.height,format,cpu_bytes,gpu_bytes,mn);if cpu_path=="" || gpu_path=="" || !r.valid {tool_errln("interiors: complete image shape/format refused");return 2;}
 cpu_state:[112]u8;gpu_state:[112]u8;if sha256_init(cpu_state[..])!=SHA_OK || sha256_init(gpu_state[..])!=SHA_OK {return 2;}cpu:[65536]u8;gpu:[65536]u8;
 while r.full.processed<r.full.pixels {if proc_now_ms()>deadline {return 2;}first:=r.full.processed;count:=ifx r.full.pixels-first<4096 then r.full.pixels-first else 4096;nb:=count*16;gb:=count*cf_stride(format);if fs_read_at(cpu_path,first*16,cpu[0..<nb])!=nb || fs_read_at(gpu_path,first*cf_stride(format),gpu[0..<gb])!=gb {return 2;}if sha256_update_checked(cpu_state[..],cpu[0..<nb],false)!=SHA_OK || sha256_update_checked(gpu_state[..],gpu[0..<gb],false)!=SHA_OK {return 2;}r=cfi_accumulate(r,cpu[0..<nb],gpu[0..<gb],mask[first..<first+count],format,observed.width,first);if !r.valid {return 2;}}
 r=cfi_done(r);if !r.valid || r.masked_pixels!=mask_count {return 2;}cpu_hash:[64]u8;gpu_hash:[64]u8;again:[64]u8;if !ci_final_hash(cpu_state[..],cpu_hash[..]) || !ci_final_hash(gpu_state[..],gpu_hash[..]) {return 2;}
 if !ci_hash(cpu_path,again[..],deadline) || cast(string)again[..]!=cast(string)cpu_hash[..] || !ci_hash(gpu_path,again[..],deadline) || cast(string)again[..]!=cast(string)gpu_hash[..] {tool_errln("interiors: image consumed/readback fence refused");return 2;}
 for i:0..<8 {if fs_size(paths[i])!=sizes[i] || !ci_hash(paths[i],again[..],deadline) || cast(string)again[..]!=cast(string)hashes[i][..] {tool_errln("interiors: certificate artifact changed");return 2;}}if !rtq_inputs_match(sources[..]) || !ci_fresh(receipt_path) {tool_errln("interiors: source or fresh receipt fence refused");return 2;}
 output:[262144]u8;o:[1]Jo;jo_start(o[..],output[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.pinned-interior-comparison.v1");jo_key(o[..],"status");jo_str(o[..],ifx r.checked.status==CFStatus.ok then "pass_scoped_interiors" else "fail");jo_key(o[..],"raw_full");ci_result(o[..],r.full);jo_key(o[..],"strict_interior");ci_result(o[..],r.checked);jo_key(o[..],"width");jo_int(o[..],observed.width);jo_key(o[..],"height");jo_int(o[..],observed.height);jo_key(o[..],"profile");jo_str(o[..],observed.profile);jo_key(o[..],"masked_pixels");jo_int(o[..],r.masked_pixels);jo_key(o[..],"unqualified_channels");jo_int(o[..],r.masked_pixels*4);jo_key(o[..],"excluded_colour_failures");jo_int(o[..],r.excluded_colour_failures);jo_key(o[..],"rule");jo_str(o[..],CI_RULE);
 jo_key(o[..],"artifacts");jo_arr(o[..]);for i:0..<8 {jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],paths[i]);jo_key(o[..],"bytes");jo_int(o[..],sizes[i]);jo_key(o[..],"sha256");jo_str(o[..],cast(string)hashes[i][..]);jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"images");jo_arr(o[..]);for i:0..<2 {jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],ifx i==0 then cpu_path else gpu_path);jo_key(o[..],"format");jo_str(o[..],ifx i==0 then "rgba32f" else v[2]);jo_key(o[..],"bytes");jo_int(o[..],ifx i==0 then cpu_bytes else gpu_bytes);jo_key(o[..],"sha256");jo_str(o[..],ifx i==0 then cast(string)cpu_hash[..] else cast(string)gpu_hash[..]);jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],sources[..],"");jo_key(o[..],"scope");jo_str(o[..],"Only the independently frozen DG geometry boundary envelope is authenticated. Every masked finite RGBA packet is UNQUALIFIED. Every original nonfinite value is fatal. Raw full strict failures are retained separately. The enclosing gate must establish matching producer, frame, shader and resource provenance; this CLI does not prove those joins or hardware legality. Receipt freshness is checked before publication, not an atomic concurrent-writer guarantee.");jo_end(o[..]);
 if o[0].bad || !fs_write(receipt_path,jo_text(o[..])) {return 2;}print("%\n",jo_text(o[..]));return ifx r.checked.status==CFStatus.ok then 0 else 1;
}
