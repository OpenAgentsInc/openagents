cf_test_float :: (data:[]u8,at:int,value:f32) {
  word:=f32_bits(value);
  for k:0..<4 {data[at+k]=cast,trunc(u8)(word>>cast(u32)(8*k));}
}
#test "frame comparator observes every channel and reports the final pixel" {
  cpu:[64]u8;gpu:[64]u8;
  for k:0..<16 {cf_test_float(cpu[..],k*4,f32(k));cf_test_float(gpu[..],k*4,f32(k));}
  cf_test_float(gpu[..],56,15);
  r:=cf_compare(cpu[..],gpu[..],0,2,2);
  #assert r.status==CFStatus.different && r.pixels==4 && r.channels==16 && r.processed==4;
  #assert r.colour_failures==1 && r.nonfinite_failures==0 && r.sample_count==1;
  #assert r.samples[0].x==1 && r.samples[0].y==1 && r.samples[0].channel==2;
  #assert r.max_absolute_error==1 && r.samples[0].cpu==14 && r.samples[0].gpu==15;
  #assert r.samples[0].absolute_error==1 && r.max_normalized_error==1.0/14;
}
#test "frame comparator retains the exact relative boundary and absolute floor" {
  cpu:[16]u8;gpu:[16]u8;
  cf_test_float(cpu[..],0,500);cf_test_float(cpu[..],4,-500);cf_test_float(cpu[..],12,1);
  cf_test_float(gpu[..],0,501);cf_test_float(gpu[..],4,-501);cf_test_float(gpu[..],8,1.0f32/512);cf_test_float(gpu[..],12,1);
  #assert cf_compare(cpu[..],gpu[..],0,1,1).status==CFStatus.ok;
  cf_test_float(gpu[..],0,501.0f32+1.0f32/32768);cf_test_float(gpu[..],4,-501.0f32-1.0f32/32768);cf_test_float(gpu[..],8,1.0f32/256);
  r:=cf_compare(cpu[..],gpu[..],0,1,1);
  #assert r.colour_failures==3 && r.samples[0].bound==1;
}
#test "frame comparator decodes RGBA and BGRA byte order and observes alpha" {
  cpu:[16]u8;cf_test_float(cpu[..],0,1);cf_test_float(cpu[..],4,0.5);cf_test_float(cpu[..],8,0.25);cf_test_float(cpu[..],12,0.75);
  rgba:=[4]u8.[255,128,64,191];bgra:=[4]u8.[64,128,255,191];
  #assert cf_compare(cpu[..],rgba[..],2,1,1).status==CFStatus.ok;
  #assert cf_compare(cpu[..],bgra[..],3,1,1).status==CFStatus.ok;
  #assert cf_compare(cpu[..],rgba[..],3,1,1).colour_failures==2;
  rgba[3]=0;r:=cf_compare(cpu[..],rgba[..],2,1,1);
  #assert r.colour_failures==1 && r.samples[0].channel==3;
}
#test "frame comparator decodes signed half HDR normals subnormals and zero" {
  cpu:[16]u8;cf_test_float(cpu[..],0,0.125);cf_test_float(cpu[..],4,-0.5);cf_test_float(cpu[..],8,2);cf_test_float(cpu[..],12,1);
  gpu:=[8]u8.[0,48,0,184,0,64,0,60];
  #assert cf_compare(cpu[..],gpu[..],1,1,1).status==CFStatus.ok;
  #assert cf_half(1)==0.000000059604644775390625 && cf_half(1023)==0.000060975551605224609375;
  #assert cf_half(1024)==0.00006103515625 && cf_half(0x7bff)==65504;
  #assert cf_half(0xbc00)==-1 && f64_bits(cf_half(0x8000))==0x8000000000000000;
}
#test "frame comparator rejects matching nonfinite values on both sides" {
  cpu:[16]u8;words:=[4]u32.[0x7fc00000,0x7f800000,0xff800000,0];
  for k:0..<4 {for j:0..<4 {cpu[k*4+j]=cast,trunc(u8)(words[k]>>cast(u32)(8*j));}}
  r:=cf_compare(cpu[..],cpu[..],0,1,1);
  #assert r.status==CFStatus.different && r.nonfinite_failures==3 && r.colour_failures==0 && r.sample_count==3;
  #assert r.samples[0].nonfinite && r.samples[1].nonfinite && r.samples[2].nonfinite;
  #assert !cf_finite(cf_half(0x7c00)) && !cf_finite(cf_half(0xfc00)) && !cf_finite(cf_half(0x7e00));
}
#test "frame comparator refuses malformed complete image declarations" {
  #assert cf_begin(0,1,0,16,16).status==CFStatus.bad_extent;
  #assert cf_begin(1,-1,0,16,16).status==CFStatus.bad_extent;
  #assert cf_begin(16385,1,0,16,16).status==CFStatus.bad_extent;
  #assert cf_begin(1,16385,0,16,16).status==CFStatus.bad_extent;
  #assert cf_begin(1,1,-1,16,16).status==CFStatus.bad_format;
  #assert cf_begin(1,1,4,16,16).status==CFStatus.bad_format;
  #assert cf_begin(1,1,0,15,16).status==CFStatus.bad_length;
  #assert cf_begin(1,1,2,16,5).status==CFStatus.bad_length;
  #assert cf_begin(1,1,1,16,7).status==CFStatus.bad_length;
  #assert cf_begin(16384,16384,0,4294967296,4294967296).pixels==268435456;
}
#test "frame comparator caps only samples and processes every failing channel" {
  cpu:[320]u8;gpu:[320]u8;for k:0..<80 {cf_test_float(gpu[..],k*4,1);}
  r:=cf_compare(cpu[..],gpu[..],0,5,4);
  #assert r.colour_failures==80 && r.sample_count==16 && r.nonfinite_failures==0 && r.processed==20;
  #assert r.max_absolute_error==1 && r.max_normalized_error==1;
}
#test "frame comparator chunk sequence preserves counts and rejects short extra or reordered input" {
  cpu:[32]u8;gpu:[32]u8;cf_test_float(gpu[..],28,1);
  r:=cf_begin(2,1,0,32,32);
  r=cf_accumulate(r,cpu[0..<16],gpu[0..<16],0,2,0);
  #assert r.processed==1 && cf_done(r).status==CFStatus.bad_sequence;
  #assert cf_accumulate(r,cpu[0..<15],gpu[0..<16],0,2,1).status==CFStatus.bad_length;
  #assert cf_accumulate(r,cpu[0..<16],gpu[0..<15],0,2,1).status==CFStatus.bad_length;
  #assert cf_accumulate(r,cpu[0..<16],gpu[0..<16],0,2,0).status==CFStatus.bad_sequence;
  #assert cf_accumulate(r,cpu[..],gpu[..],0,2,1).status==CFStatus.bad_sequence;
  r=cf_accumulate(r,cpu[16..<32],gpu[16..<32],0,2,1);
  #assert cf_done(r).status==CFStatus.different && r.colour_failures==1 && r.samples[0].x==1 && r.samples[0].channel==3;
  #assert cf_format("rgba32f")==0 && cf_format("rgba16f")==1 && cf_format("rgba8")==2 && cf_format("bgra8")==3 && cf_format("bad")==-1;
}
#test "frame comparator preserves NaN and signed infinity diagnostic classes" {
  #assert cf_half(0x7c01)!=cf_half(0x7c01) && cf_half(0x7c00)>0 && cf_half(0xfc00)<0;
  cpu:[16]u8;words:=[4]u32.[0x7f800001,0xff800001,0xff800000,0x7f800000];
  for k:0..<4 {for j:0..<4 {cpu[k*4+j]=cast,trunc(u8)(words[k]>>cast(u32)(8*j));}}
  #assert cf_value(cpu[..],0,0,0)!=cf_value(cpu[..],0,0,0);
  #assert cf_value(cpu[..],0,0,1)!=cf_value(cpu[..],0,0,1);
  #assert cf_value(cpu[..],0,0,2)<0 && cf_value(cpu[..],0,0,3)>0;
  zero:[16]u8;r:=cf_compare(zero[..],cpu[..],0,1,1);
  #assert r.nonfinite_failures==4 && r.colour_failures==0;
  r=cf_compare(cpu[..],zero[..],0,1,1);#assert r.nonfinite_failures==4;
}
#test "frame comparator pixel strides and invalid chunk formats are observed" {
  #assert f64_bits(cf_max(1,1.0000000000000002))==0x3ff0000000000001;
  #assert cf_max(1.0000000000000002,1)==1.0000000000000002 && cf_max(1,1)==1;
  half:=[16]u8.[0,0,0,0,0,0,0,0,0,60,0,64,0,66,0,68];
  byte:=[8]u8.[0,0,0,0,255,128,64,32];
  #assert cf_value(half[..],1,1,0)==1 && cf_value(half[..],1,1,3)==4;
  #assert cf_value(byte[..],2,1,0)==1 && cf_value(byte[..],3,1,2)==1;
  cpu:[16]u8;r:=cf_begin(1,1,0,16,16);
  #assert cf_accumulate(r,cpu[..],cpu[..],-1,1,0).status==CFStatus.bad_format;
  #assert cf_accumulate(r,cpu[..],cpu[..],4,1,0).status==CFStatus.bad_format;
  #assert cf_accumulate(r,cpu[..],cpu[..],0,0,0).status==CFStatus.bad_sequence;
}
#test "frame comparator admits exact chunk capacity and empty terminal chunk" {
  bytes:[65552]u8;r:=cf_begin(4097,1,0,65552,65552);
  #assert cf_accumulate(r,bytes[..],bytes[..],0,4097,0).status==CFStatus.bad_sequence;
  r=cf_accumulate(r,bytes[0..<65536],bytes[0..<65536],0,4097,0);
  #assert r.status==CFStatus.ok && r.processed==4096;
  r=cf_accumulate(r,bytes[65536..<65552],bytes[65536..<65552],0,4097,4096);
  #assert cf_accumulate(r,bytes[0..<0],bytes[0..<0],0,4097,4097).status==CFStatus.ok;
}
