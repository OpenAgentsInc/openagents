// Coax owns the fixed geometry/profile, fresh output, source fences, deadlines
// and verification. The Python program is an independent rational oracle.
#import "Basic";
#load "qualification-files.coax";
#load "shared-edge-generation-policy.coax";
SEG_ORACLE :: "aethyr/render/tests/shared_edge_envelope_oracle.py";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) {return 2;}i:=0;while i<args_count(a[..]) {key:=args_at(a[..],i);if (key!="--geometry" && key!="--out" && key!="--rounding" && key!="--python") || args_at(a[..],i+1)=="" {return 2;}i+=2;}geometry:=args_value(a[..],"--geometry","");out_arg:=args_value(a[..],"--out","");rounding:=args_value(a[..],"--rounding","");if geometry=="" || out_arg=="" || !fs_mkdir(out_arg) {return 2;}out_buf:[4096]u8;work:=fs_realpath(out_arg,out_buf[..]);listing:[1]FsList;hash:[64]u8;if work=="" || !rtq_hash_file(geometry,hash[..]) || !seg_admit(rounding,fs_size(geometry),cast(string)hash[..],fs_list(work,listing[..])) {tool_errln("shared edge generation refused: exact pinned geometry, declared profile and empty output required");return 2;}
 held:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}for file:[4]string.[geometry,SEG_ORACLE,"coax/web/tool.sh",compiler] {if !rtq_input_add(held[..],file) {return 1;}}if !rtq_deps(held[..],compiler,"aethyr/render/tests/derive-shared-edge-envelope.coax",proc_now_ms()+30000,work,"generation-dependencies") || !rtq_deps(held[..],compiler,"aethyr/render/tests/check-shared-edge-envelope.coax",proc_now_ms()+30000,work,"verifier-dependencies") {return 1;}
 for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {for ext:[2]string.[".c",".h"] {path:[4096]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],ext);if !rtq_input_add(held[..],jo_text(o[..])) {return 1;}}}self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 || !rtq_input_add(held[..],cast(string)self[0..<self_n]) {return 1;}
 stdout:[1048576]u8;stderr:[65536]u8;env:[]string;python_arg:=args_value(a[..],"--python","python3");which:=[3]string.["/usr/bin/which",python_arg,""];resolved:=rtq_command(which[0..<2],env,proc_now_ms()+5000,work,"python-resolution",stdout[..],stderr[..]);python_buf:[4096]u8;if !rtq_ok(resolved) {return 1;}python:=fs_realpath(rtq_trim(cast(string)stdout[0..<resolved.out_n]),python_buf[..]);if python=="" || !rtq_input_add(held[..],python) {return 1;}version:=[2]string.[python,"--version"];vr:=rtq_command(version[..],env,proc_now_ms()+5000,work,"python-version",stdout[..],stderr[..]);if !rtq_ok(vr) {return 1;}
 paths:[4][4096]u8;config:=fs_join(work,"oracle-config.json",paths[0][..]);facts:=fs_join(work,"facts.json",paths[1][..]);verification:=fs_join(work,"independent-coax",paths[2][..]);body:[1024]u8;o:[1]Jo;jo_start(o[..],body[..]);jo_obj(o[..]);jo_key(o[..],"width");jo_int(o[..],320);jo_key(o[..],"height");jo_int(o[..],180);jo_key(o[..],"profile");jo_obj(o[..]);jo_key(o[..],"rounding");jo_str(o[..],rounding);jo_key(o[..],"subpixel_bits");jo_int(o[..],8);jo_key(o[..],"xy");jo_str(o[..],"guard-band");jo_key(o[..],"guard_pixels");jo_int(o[..],65536);jo_end(o[..]);jo_end(o[..]);if o[0].bad || !fs_write(config,jo_text(o[..])) || !rtq_input_add(held[..],config) {return 1;}
 started:=proc_now_ms();argv:=[5]string.[python,SEG_ORACLE,geometry,config,work];math:=rtq_command(argv[..],env,started+120000,work,"rational-oracle",stdout[..],stderr[..]);verified:=false;if rtq_ok(math) {check:=[9]string.["/bin/bash","coax/web/tool.sh","aethyr/render/tests/check-shared-edge-envelope.coax","--geometry",geometry,"--certificate",facts,"--out",verification];r:=rtq_command(check[..],env,proc_now_ms()+120000,work,"independent-global-census",stdout[..],stderr[..]);verified=rtq_ok(r);}
 for name:[7]string.["facts.json","mask.bin","zero-radius-mask.bin","zero-mask.bin","edges.jsonl","witnesses.jsonl","independent-coax/qualification.json"] {file:=fs_join(work,name,paths[3][..]);if !rtq_input_add(held[..],file) {verified=false;}}
 same:=rtq_inputs_match(held[..]);record:[4194304]u8;w:[1]Jo;jo_start(w[..],record[..]);jo_obj(w[..]);jo_key(w[..],"schema");jo_str(w[..],"aethyr.render.shared-edge-generation.v1");jo_key(w[..],"status");jo_str(w[..],ifx verified && same then "generated_math_verified_unadmitted_geometry_scope" else "failed");jo_key(w[..],"rounding");jo_str(w[..],rounding);jo_key(w[..],"radius");jo_obj(w[..]);jo_key(w[..],"numerator");jo_int(w[..],1);jo_key(w[..],"denominator");jo_int(w[..],512);jo_end(w[..]);jo_key(w[..],"input_only");jo_bool(w[..],true);jo_key(w[..],"admitted");jo_bool(w[..],false);jo_key(w[..],"oracle_and_independent_census_passed");jo_bool(w[..],verified);jo_key(w[..],"source_inputs");rtq_inputs_json(w[..],held[..],"");jo_key(w[..],"source_changes");jo_arr(w[..]);if !same {jo_str(w[..],"source fence changed");}jo_end(w[..]);jo_key(w[..],"elapsed_ms");jo_int(w[..],proc_now_ms()-started);jo_end(w[..]);if w[0].bad || !fs_write(fs_join(work,"generation.json",paths[3][..]),jo_text(w[..])) {return 1;}print("shared-edge input-only generation and independent census: %\n",verified && same);return ifx verified && same then 0 else 1;
}
