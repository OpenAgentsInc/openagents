// Exact complete actual-byte admission; no image tolerance or pixel mask.
#load "display-probe.coax";
#authority;
#forall "display byte receipt requires complete shape and checks both physical orders and every endpoint" format:0..<2 #steps 200000000 {
 bytes:[262145]u8;
  for pixel:0..<65536 {for channel:0..<4 {physical:=ifx format==1&&channel<3 then 2-channel else channel;bytes[pixel*4+physical]=cast(u8)dpq_expected(pixel,channel);}}
  #assert dpqr_bytes(bytes[0..<262144],format)==0;
  for at:[6]int.[0,1,2,3,131071,262143] {bytes[at]^=1;}#assert dpqr_bytes(bytes[0..<262144],format)==6;
  #assert dpqr_bytes(bytes[..],format) == -1 && dpqr_bytes(bytes[0..<262143],format) == -1;
 #assert dpqr_bytes(bytes[0..<262144],-1) == -1 && dpqr_bytes(bytes[0..<262144],2) == -1;
}
dpqr_bytes :: (bytes:[]u8,format:int)->int #export_c {
 if bytes.count!=262144||format<0||format>1 {return -1;}different:=0;
 for pixel:0..<65536 {for channel:0..<4 {physical:=ifx format==1&&channel<3 then 2-channel else channel;if cast(int)bytes[pixel*4+physical]!=dpq_expected(pixel,channel) {different+=1;}}}return different;
}
