#load "native-qualification.coax";
#load "filter-tool-policy.coax";
RFL_DATASETS :: [2]string.["format","joint"];
RFL_PROFILES :: [4]string.["metal-unorm8","nvidia-unorm8-integer","METAL-UNORM8","NVIDIA-UNORM8-INTEGER"];
RFL_FORMATS :: [3]string.["rgba8unorm","rgba16float","rgba8unorm-srgb"];
RFL_MODES :: [7]string.["linear","min-nearest","mag-nearest","mip-nearest","anisotropic","compare","fractional-min"];
RFL_LOSSES :: [6]string.["none","storage","profile","color","mips","short-bytes"];
RflCase :: struct {dataset:int;profile:int;format:int;raw:int;mode:int;loss:int;kind:int;decoded:int;sampled:int;x_nan:bool;y_inf:bool;lod_nan:bool;lod_one:bool;}
RflCases :: struct {count:int;rows:[192]RflCase;}
rflt_add :: (cases:[]RflCases,c:RflCase)->bool {if cases[0].count==192 {return false;}cases[0].rows[cases[0].count]=c;cases[0].count+=1;return true;}
rflt_words :: (d:Jv,node:int,out:[]f64)->bool {if jv_kind(d,node)!=JV_ARRAY || jv_len(d,node)!=out.count {return false;}for i:0..<out.count {bytes:[64]u8;n:=jv_str(d,jv_at(d,node,i),bytes[..]);if n<0 {return false;}word:=rfl_word(cast(string)bytes[0..<n]);if !word.ok {return false;}out[i]=f64_from_bits(word.bits);}return true;}
rflt_codec :: (input:string,output:string,work:string,label:string,deadline:int)->bool {script:="import sys,json;sys.path.insert(0,'aethyr/tests');from raw_float_oracle import numeric_words;json.dump(numeric_words(json.load(open(sys.argv[1]))),open(sys.argv[2],'w'))";argv:=[5]string.["python3","-c",script,input,output];stdout:[65536]u8;stderr:[65536]u8;env:[]string;r:=rtq_command(argv[..],env,deadline,work,label,stdout[..],stderr[..]);return rtq_ok(r);}
rflt_plan :: (cases:[]RflCases,dataset:int,raw:Jv,coded:Jv)->bool {
 n:=jv_len(raw,jv_get(raw,0,"cases"));if n!=20 {return false;}group:=jv_at(coded,0,dataset);lods:=jv_at(coded,group,0);first:=-1;last:=-1;
 for profile:0..<2 {for i:0..<n {v:[1]f64;lod_node:=jv_at(coded,lods,i);bytes:[64]u8;got:=jv_str(coded,lod_node,bytes[..]);if got<0 {return false;}word:=rfl_word(cast(string)bytes[0..<got]);if !word.ok {return false;}lod:=f64_from_bits(word.bits);c:=RflCase.{dataset=dataset,profile=profile,raw=i};if profile==1 && !rfl_integer(lod) {c.kind=1;c.decoded=0;c.sampled=3;}else if profile==0 {if first<0 {first=cases[0].count;}if lod==1 {last=cases[0].count;}}if !rflt_add(cases,c) {return false;}}}
 for profile:0..<2 {base:=RflCase.{dataset=dataset,profile=profile,raw=-1,kind=1,decoded=0};for mode:1..<6 {c:=base;c.mode=mode;c.lod_one=mode==1;c.sampled=ifx mode==5 then 5 else 3;if !rflt_add(cases,c) {return false;}}
  for which:0..<7 {c:=base;c.sampled=3;if which==0 {c.format=1;}if which==1 {c.format=2;}if which==2 {c.profile+=2;}if which==3 {c.x_nan=true;c.sampled=5;}if which==4 {c.y_inf=true;c.sampled=5;}if which==5 {c.lod_nan=true;c.sampled=5;}if which==6 {c.loss=5;c.decoded= -1;c.sampled= -1;}if !rflt_add(cases,c) {return false;}}
 }c:=RflCase.{dataset=dataset,profile=1,raw=-1,kind=1,decoded=0,sampled=3,mode=6};if !rflt_add(cases,c) || first<0 {return false;}for loss:1..<4 {fault:=cases[0].rows[first];fault.kind=2;fault.loss=loss;if !rflt_add(cases,fault) {return false;}}if dataset==0 {if last<0 {return false;}fault:=cases[0].rows[last];fault.kind=2;fault.loss=4;if !rflt_add(cases,fault) {return false;}}return true;
}
rflt_coord :: (raw:Jv,c:RflCase,axis:int)->string {if axis==0 && c.x_nan {return "nan";}if axis==1 && c.y_inf {return "inf";}if axis==2 && c.lod_nan {return "nan";}if axis==2 && c.lod_one {return "1";}if c.raw<0 {return [3]string.["0.2","0.3","0"][axis];}row:=jv_at(raw,jv_get(raw,0,"cases"),c.raw);return jv_raw(raw,jv_get(raw,row,[3]string.["x","y","lod"][axis]));}
rflt_profile :: (path:string,product:[]RtqInputs,c_hash:string)->bool {
 bytes:[1048576]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],doc[..]) {return false;}d:=doc[0];if jv_kind(d,jv_get(d,0,"success"))!=JV_TRUE || jv_int(d,jv_get(d,0,"exit_status"),-1)!=0 || !rfr_literal(d,jv_get(d,0,"emitted_sha256"),c_hash) {return false;}seen:[512]bool;count:=0;
 for key:[2]string.["sources","descriptors"] {list:=jv_get(d,0,key);if jv_kind(d,list)!=JV_ARRAY {return false;}for i:0..<jv_len(d,list) {row:=jv_at(d,list,i);p:[4096]u8;n:=jv_str(d,jv_get(d,row,"path"),p[..]);if n<1 {return false;}matched:=false;for k:0..<product[0].count {source:=product[0].rows[k];if cast(string)source.path[0..<source.count]==cast(string)p[0..<n] {if seen[k] || !rfr_literal(d,jv_get(d,row,"sha256"),cast(string)source.hash[..]) {return false;}seen[k]=true;matched=true;count+=1;break;}}if !matched {return false;}}}return count==product[0].count;
}
rflt_admission :: (admission:string,source:string,header:string,profile:string,compiler:string,product:[]RtqInputs,root:string,reuse:bool)->bool {
 hashes:[3][64]u8;for path,i:[3]string.[source,header,profile] {if !rtq_hash_file(path,hashes[i][..]) {return false;}}if !rflt_profile(profile,product,cast(string)hashes[0][..]) {return false;}
 if reuse {bytes:[1048576]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(admission,bytes[..],nodes[..],doc[..]) || !rfl_admitted(doc[0],compiler,cast(string)hashes[0][..],cast(string)hashes[1][..],cast(string)hashes[2][..]) {return false;}d:=doc[0];map:=jv_get(d,0,"source_sha256");if jv_kind(d,map)!=JV_OBJECT || jv_len(d,map)!=product[0].count {return false;}for pi:0..<product[0].count {row:=product[0].rows[pi];path:=cast(string)row.path[0..<row.count];key:=path;if path.count>root.count && path[0..<root.count]==root && path[root.count]=='/' {key=path[root.count+1..<path.count];}if !rfr_literal(d,jv_get(d,map,key),cast(string)row.hash[..]) {return false;}}return true;}
 bytes:[1048576]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.filter-emission-admission.v1");jo_key(o[..],"compiler_sha256");jo_str(o[..],compiler);for key,i:[3]string.["c_sha256","header_sha256","profile_sha256"] {jo_key(o[..],key);jo_str(o[..],cast(string)hashes[i][..]);}jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],product,root);jo_end(o[..]);return !o[0].bad && fs_write(admission,jo_text(o[..]));
}
