// Controlled compiler-identity fixture; unexpected work is always refused.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
tool_main :: ()->int #export_c {a:[1]Args;if !args_load(a[..]) {return 2;}command:=args_at(a[..],0);path:[4096]u8;journal:=proc_getenv("AETHYR_GEOMETRY_IDENTITY_LOG",path[..]);if journal.count==0 || !fs_append(journal,command) || !fs_append(journal,"\n") {return 31;}if command=="version" {print("coax0 test\n");return 0;}if command=="source-digest" {print("new\n");return 0;}return 31;}
