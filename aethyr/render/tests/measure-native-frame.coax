// Prepare a closed native payload; remote execution requires explicit --measure.
// This observer never emits a shader or evaluates an image tolerance.
#import "Basic";
#load "native-frame-measure-run.coax";
tool_main :: ()->int #export_c {
 args:[1]Args;if !args_load(args[..]) {return 2;}measure:=args_has(args[..],"--measure");prepare_only:=args_has(args[..],"--prepare-only");if measure && prepare_only {return 2;}work_arg:=args_value(args[..],"--work-dir","");compiler_arg:=args_value(args[..],"--coax","");digest_arg:=args_value(args[..],"--compiler-source-digest","");prepared_arg:=args_value(args[..],"--prepared","");host:=args_value(args[..],"--host","");format:=args_value(args[..],"--format","rgba16f");if work_arg=="" || compiler_arg=="" || digest_arg=="" || (measure && !ng_host(host)) || nfm_bpp(format)<0 {tool_errln("usage: measure-native-frame --work-dir NEW --coax COMPILER --compiler-source-digest FILE [--frame RFI --package DIR --capture-root DIR --native-dir DIR | --prepared DIR] [--prepare-only | --measure --host HOST] [--format rgba8|rgba16f]");return 2;}
 started:=proc_now_ms();paths:[10][4096]u8;root_raw:=fs_cwd(paths[0][..]);root:=fs_realpath(root_raw,paths[1][..]);if !fs_mkdir(work_arg) {return 2;}work:=fs_realpath(work_arg,paths[2][..]);listing:[1]FsList;if work=="" || fs_list(work,listing[..])!=0 {tool_errln("native frame work directory must be empty");return 2;}compiler:=fs_realpath(compiler_arg,paths[3][..]);digest:=fs_realpath(digest_arg,paths[4][..]);if compiler=="" || digest=="" {return 2;}
 held:[1]RtqInputs;files:[1]NfmFiles;p:[1]NfmPrepared;p[0].format=ifx format=="rgba8" then 1 else 2;prepared:="";
 if prepared_arg!="" {if !measure {return 2;}prepared=fs_realpath(prepared_arg,paths[5][..]);if prepared=="" || !nfm_load_prepared(root,prepared,compiler,digest,work,p[..],held[..],files[..]) {tool_errln("native frame prepared source/compiler/input closure refused");return 1;}}
 else {frame:=fs_realpath(args_value(args[..],"--frame",""),paths[5][..]);package:=fs_realpath(args_value(args[..],"--package",""),paths[6][..]);native:=fs_realpath(args_value(args[..],"--native-dir",""),paths[7][..]);capture_arg:=args_value(args[..],"--capture-root",ifx frame=="" then "" else fs_dir(frame));capture:=fs_realpath(capture_arg,paths[8][..]);if frame=="" || package=="" || native=="" || capture=="" {return 2;}if !nfm_prepare(root,frame,package,capture,native,compiler,digest,work,p[..],held[..],files[..]) {tool_errln("native frame preparation failed; bounded command/input records retained");return 1;}prepared=work;}
 if !measure {print("native frame prepared: %files, %bytes; no remote/GPU execution\n",files[0].count,files[0].bytes);return 0;}
 passed:=nfm_measure(root,prepared,compiler,host,work,p[..],held[..],files[..],started);print("native frame raw measurement: %\n",passed);return ifx passed then 0 else 1;
}
