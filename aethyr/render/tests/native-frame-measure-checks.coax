#test "native frame readback format and exact64MiB envelopes are explicit" {#assert nfm_bpp("rgba8")==4 && nfm_bpp("rgba16f")==8 && nfm_bpp("bgra8")== -1;#assert nfm_raw_bytes(320,180,"rgba16f")==460800 && nfm_raw_bytes(4096,4096,"rgba8")==67108864;#assert nfm_raw_bytes(4097,4096,"rgba8")== -1 && nfm_raw_bytes(0,180,"rgba16f")== -1 && nfm_raw_bytes(320,0,"rgba16f")== -1;#assert nfm_raw_bytes(16385,1,"rgba8")== -1 && nfm_raw_bytes(1,16385,"rgba8")== -1 && nfm_raw_bytes(1,1,"unknown")== -1;}
#test "native frame closed stage paths never escape or name shell metacharacters" {#assert nfm_relative("frame.config") && nfm_relative("inputs/module-0-abcd.spv") && nfm_relative("RenderHost.c");for path:[10]string.["","/absolute","../x","inputs/../x","inputs//x","./x","inputs/","inputs/a b","inputs/a'","inputs/a;touch"] {#assert !nfm_relative(path);}buf:[4097]u8;for i:0..<buf.count {buf[i]='a';}#assert nfm_relative(cast(string)buf[0..<4096]) && !nfm_relative(cast(string)buf[..]);}
#test "native frame source containment requires a full canonical component boundary" {#assert nfm_within("/pkg/a.spv","/pkg") && nfm_within("/pkg/sub/a.spv","/pkg");#assert !nfm_within("/pkg2/a.spv","/pkg") && !nfm_within("/pkg","/pkg") && !nfm_within("/pkg/a.spv","");}
#test "native frame stage collision permits only the identical existing byte identity" {#assert nfm_collision(false,"","new") && nfm_collision(true,"same","same") && !nfm_collision(true,"old","new");}
#test "native frame raw observation validates shape resource format and every SDK failure" {nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],"{\"status\":\"rendered\",\"profile\":3,\"resource\":18,\"width\":320,\"height\":180,\"format\":\"rgba16f\",\"bytes\":460800,\"validation_errors\":0,\"validation_warnings\":0}",nodes[..]);#assert nfm_observation(d[0],3,18,320,180,"rgba16f",460800);#assert !nfm_observation(d[0],4,18,320,180,"rgba16f",460800) && !nfm_observation(d[0],3,19,320,180,"rgba16f",460800) && !nfm_observation(d[0],3,18,321,180,"rgba16f",460800) && !nfm_observation(d[0],3,18,320,181,"rgba16f",460800) && !nfm_observation(d[0],3,18,320,180,"rgba8",460800) && !nfm_observation(d[0],3,18,320,180,"rgba16f",1);}
#test "native frame remote output logs use only fixed owned names and preserve one exec" {out:[4096]u8;argv:=[3]string.["gcc","a source.c","-o"];text:=nfm_exec(argv[..],"compile",out[..]);#assert text=="exec 'gcc' 'a source.c' '-o' >'compile.stdout' 2>'compile.stderr'";#assert nfm_exec(argv[..],"measure",out[..])=="exec 'gcc' 'a source.c' '-o' >'measure.stdout' 2>'measure.stderr'";#assert nfm_exec(argv[..],"other",out[..])=="";#assert nfm_exec(argv[..],"compile",out[0..<1])=="";}
#test "native frame lifecycle validation messages cannot hide after the raw record was written" {#assert nfm_validation_clean("") && nfm_validation_clean("vkc: device initialized\n");#assert !nfm_validation_clean("vkc: validation: warning") && !nfm_validation_clean("first\nvkc: validation: error\n");}
#test "native frame file and total declared spans retain their exact bounds" {#assert nfm_input_bytes(0) && nfm_input_bytes(67108864) && !nfm_input_bytes(-1) && !nfm_input_bytes(67108865);#assert nfm_capacity(0,1073741824) && nfm_capacity(1073741824,0) && !nfm_capacity(1073741824,1) && !nfm_capacity(0,1073741825) && !nfm_capacity(-1,1) && !nfm_capacity(1,-1);}
#test "native frame smallest paths and independent dimension endpoints are exact" {#assert nfm_relative("x") && nfm_relative("a/b");#assert nfm_raw_bytes(1,1,"rgba8")==4 && nfm_raw_bytes(1,1,"rgba16f")==8;#assert nfm_raw_bytes(16384,1,"rgba8")==65536 && nfm_raw_bytes(1,16384,"rgba8")==65536;#assert nfm_raw_bytes(2,2,"unknown")== -1;empty:[]string;out:[128]u8;#assert nfm_exec(empty,"compile",out[..])=="";}
#test "native frame source draw count binds the whole16byte packet span" {#assert nfm_draw_span(0,0) && nfm_draw_span(190,3040) && nfm_draw_span(4194304,67108864);#assert !nfm_draw_span(67,3040) && !nfm_draw_span(190,3039) && !nfm_draw_span(0,1) && !nfm_draw_span(-1,16) && !nfm_draw_span(4194305,67108880);}
