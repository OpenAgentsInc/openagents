 p[0].profile=jv_int(d[0],jv_get(d[0],0,"profile"),-1);p[0].width=jv_int(d[0],jv_get(d[0],0,"width"),-1);p[0].height=jv_int(d[0],jv_get(d[0],0,"height"),-1);format:=jv_raw(d[0],jv_get(d[0],0,"format"));p[0].format=ifx format=="rgba8" then 1 else ifx format=="rgba16f" then 2 else 0;
 if p[0].profile<0 || nfm_raw_bytes(p[0].width,p[0].height,format)<1 || jv_int(d[0],jv_get(d[0],0,"resource"),-1)!=1 || jv_int(d[0],jv_get(d[0],0,"raw_bytes"),-1)!=nfm_raw_bytes(p[0].width,p[0].height,format) {return false;}
 p[0].package_n=jv_str(d[0],jv_get(d[0],0,"package_relative_path"),p[0].package_path[..]);if p[0].package_n<1 || !nfm_relative(cast(string)p[0].package_path[0..<p[0].package_n]) || !nfm_hash_large(archive,p[0].archive_hash[..]) || jv_raw(d[0],jv_get(d[0],0,"archive_sha256"))!=cast(string)p[0].archive_hash[..] || jv_int(d[0],jv_get(d[0],0,"archive_bytes"),-1)!=fs_size(archive) || !rtq_hash_file(fs_join(stage,"INPUTS.sha256",paths[3][..]),p[0].manifest_hash[..]) || jv_raw(d[0],jv_get(d[0],0,"manifest_sha256"))!=cast(string)p[0].manifest_hash[..] {return false;}
 map:=jv_get(d[0],0,"source_inputs");if jv_kind(d[0],map)!=JV_OBJECT {return false;}child:=d[0].nodes[map].first;hash:[64]u8;while child!=-1 {source:=jv_key(d[0],child);if !rtq_hash_file(source,hash[..]) || jv_raw(d[0],child)!=cast(string)hash[..] || !rtq_input_add(held,source) {return false;}child=d[0].nodes[child].next;}
