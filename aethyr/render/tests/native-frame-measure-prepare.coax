 manifest_text:[2097152]u8;if files[0].count!=jv_len(d[0],rows) || jv_int(d[0],jv_get(d[0],0,"stage_bytes"),-1)!=files[0].bytes || !S_hex(S_hash(nfm_manifest_text(files,manifest_text[..])),hash[..]) || cast(string)hash[..]!=cast(string)p[0].manifest_hash[..] {return false;}
