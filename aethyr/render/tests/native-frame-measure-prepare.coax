nfm_load_prepared :: (root:string,prepared:string,compiler:string,digest:string,work:string,p:[]NfmPrepared,held:[]RtqInputs,files:[]NfmFiles)->bool {
 paths:[5][4096]u8;receipt:=fs_join(prepared,"prepared.json",paths[0][..]);stage:=fs_join(prepared,"payload",paths[1][..]);archive:=fs_join(prepared,"payload.tar.gz",paths[2][..]);bytes:[4194304]u8;nodes:[32768]JvNode;d:[1]Jv;if !rtq_json_file(receipt,bytes[..],nodes[..],d[..]) || !rtq_input_add(held,receipt) {return false;}
