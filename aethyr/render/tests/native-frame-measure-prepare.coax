// A closed local payload precedes every remote command. Pre-emitted C/header
// bytes are source/profile joined; the controller never emits a GPU product.
#load "native-frame-measure-files.coax";
nfm_compiler_after :: (compiler:string,root:string,p:[]NfmPrepared,work:string,deadline:int)->bool {out:[65536]u8;err:[65536]u8;env:[]string;argv:=[3]string.[compiler,"source-digest",root];r:=rtq_command(argv[..],env,deadline,work,"compiler-source-after",out[..],err[..]);return rtq_ok(r) && rtq_trim(cast(string)out[0..<r.out_n])==cast(string)p[0].compiler[0].current[0..<p[0].compiler[0].current_count];}
nfm_tar_inventory :: (list:string,files:[]NfmFiles)->bool {
 seen:[NFM_FILES]bool;manifest:=false;at:=0;
 for k:0..<list.count {if list[k]!='\n' {continue;}name:=list[at..<k];at=k+1;if name=="./" {continue;}if name.count>=2 && name[0..<2]=="./" {name=name[2..<name.count];}if name.count==0 {return false;}
  if name[name.count-1]=='/' {directory:=name[0..<name.count-1];if !nfm_relative(directory) {return false;}found:=false;for i:0..<files[0].count {file:=nfm_name(files,i);if file.count>name.count && file[0..<name.count]==name {found=true;}}if !found {return false;}continue;}
  if !nfm_relative(name) {return false;}if name=="INPUTS.sha256" {if manifest {return false;}manifest=true;continue;}found:=-1;for i:0..<files[0].count {if nfm_name(files,i)==name {found=i;}}if found<0 || seen[found] {return false;}seen[found]=true;
 }if at!=list.count || !manifest {return false;}for i:0..<files[0].count {if !seen[i] {return false;}}return true;
}
nfm_prepare :: (root:string,frame:string,package:string,capture_root:string,native:string,compiler:string,digest:string,work:string,p:[]NfmPrepared,held:[]RtqInputs,files:[]NfmFiles)->bool {
