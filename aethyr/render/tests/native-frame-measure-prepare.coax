 version:=cast(string)p[0].compiler[0].version[0..<p[0].compiler[0].version_count];if !nfm_emission(native,"emission-profile.json","RenderHost.c","RenderHost.h",version,root,stage,held,files) || !nfm_emission(native,"texture-emission-profile.json","RenderTexture.c","RenderTexture.h",version,root,stage,held,files) {tool_errln("native frame pre-emitted backend source/profile/artifact join failed");return false;}
 for name,i:[12]string.["native-frame.c","frame-input.h","render-host.c","render-host.h","render-textures.c","render-textures.h","render-media.c","render-media.h","vks.c","vks.h","vkc.c","vkc.h"] {directory:=ifx i<2 then "aethyr/render/tests" else ifx i<8 then "verse/native" else "verse/gpu";source:=fs_join(directory,name,paths[1][..]);if !nfm_copy_input(source,stage,name,held,files) {return false;}}
 if !nfm_snapshot(frame,package,capture_root,stage,held,files,p) {tool_errln("native frame complete RFI/package snapshot refused");return false;}
 source_count:=held[0].count;for i:0..<source_count {row:=held[0].rows[i];source:=cast(string)row.path[0..<row.count];if (source.count>=5 && source[source.count-5..<source.count]==".coax") || (source.count>=2 && (source[source.count-2..<source.count]==".c" || source[source.count-2..<source.count]==".h")) {if !nfm_source(source,stage,held,files) {return false;}}}
 manifest:=fs_join(stage,"INPUTS.sha256",paths[2][..]);if !nfm_stable(files,stage) || !nfm_manifest(files,stage) || !rtq_hash_file(manifest,p[0].manifest_hash[..]) {return false;}archive:=fs_join(work,"payload.tar.gz",paths[3][..]);out:[4194304]u8;err:[65536]u8;env:[]string;pack:=[6]string.["tar","-czf",archive,"-C",stage,"."];r:=rtq_command(pack[..],env,deadline,work,"payload-archive",out[..],err[..]);if !rtq_ok(r) || !nfm_hash_large(archive,p[0].archive_hash[..]) {return false;}contents:=[3]string.["tar","-tzf",archive];r=rtq_command(contents[..],env,deadline,work,"payload-archive-inventory",out[..],err[..]);if !rtq_ok(r) || !nfm_tar_inventory(cast(string)out[0..<r.out_n],files) || !nfm_stable(files,stage) || !rtq_inputs_match(held) || !nfm_compiler_after(compiler,root,p,work,deadline) {return false;}
 record:[4194304]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.native-frame-prepared.v1");jo_key(o[..],"status");jo_str(o[..],"prepared_input_snapshot_no_gpu_measurement");jo_key(o[..],"profile");jo_int(o[..],p[0].profile);jo_key(o[..],"width");jo_int(o[..],p[0].width);jo_key(o[..],"height");jo_int(o[..],p[0].height);jo_key(o[..],"format");jo_str(o[..],nfm_format(p));jo_key(o[..],"resource");jo_int(o[..],1);jo_key(o[..],"raw_bytes");jo_int(o[..],nfm_raw_bytes(p[0].width,p[0].height,nfm_format(p)));jo_key(o[..],"package_relative_path");jo_str(o[..],cast(string)p[0].package_path[0..<p[0].package_n]);jo_key(o[..],"archive");jo_str(o[..],"payload.tar.gz");jo_key(o[..],"archive_sha256");jo_str(o[..],cast(string)p[0].archive_hash[..]);jo_key(o[..],"archive_bytes");jo_int(o[..],fs_size(archive));jo_key(o[..],"manifest_sha256");jo_str(o[..],cast(string)p[0].manifest_hash[..]);jo_key(o[..],"stage_files");nfm_files_json(files,o[..]);jo_key(o[..],"stage_bytes");jo_int(o[..],files[0].bytes);rtn_compiler_json(o[..],compiler,p[0].compiler[..]);jo_key(o[..],"compiler_digest_path");jo_str(o[..],digest);jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],held,"");jo_key(o[..],"source_changes");jo_arr(o[..]);jo_end(o[..]);jo_key(o[..],"measurement_scope");jo_str(o[..],"transport/pre-emitted native backend/source identity only; no GPU execution, image verdict, or repeated SPIR-V qualification");jo_key(o[..],"backend_header_identity");jo_str(o[..],"actual uppercase RenderHost/RenderTexture headers pinned separately; emitted C bytes and complete source maps match their supplied emission profiles");jo_end(o[..]);return !o[0].bad && fs_write(fs_join(work,"prepared.json",paths[4][..]),jo_text(o[..]));
