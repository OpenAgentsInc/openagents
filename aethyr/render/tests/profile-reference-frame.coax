// Bounded, source-fenced effects-only profiling of exact retained Coax C.
#import "Basic";
#load "reference-profiler-files.coax";
rfp_cli_shape :: (a:[]Args)->bool {i:=0;while i<args_count(a) {key:=args_at(a,i);if key=="--fragments" || key=="--extent" || key=="--explore-stale-compiler" {i+=1;continue;}if key=="--pixels" {i+=1;while i<args_count(a) {value:=args_at(a,i);if value.count>=2 && value[0..<2]=="--" {break;}i+=1;}continue;}known:=false;for name:[5]string.["--measurement","--work-dir","--driver","--coax","--compiler-source-digest"] {if key==name {known=true;}}if !known || i+1>=args_count(a) {return false;}next:=args_at(a,i+1);if next.count>=2 && next[0..<2]=="--" {return false;}i+=2;}return true;}
#test "profiler CLI preserves diagnostic modes and refuses unknown or valueless flags" {a:[1]Args;#assert args_add(a[..],"--pixels") && args_add(a[..],"0,0") && args_add(a[..],"3,2") && args_add(a[..],"--fragments") && args_add(a[..],"--extent") && args_add(a[..],"--measurement") && args_add(a[..],"receipt") && rfp_cli_shape(a[..]);#assert args_add(a[..],"--unknown") && !rfp_cli_shape(a[..]);b:[1]Args;#assert args_add(b[..],"--measurement") && !rfp_cli_shape(b[..]);}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || !rfp_cli_shape(a[..]) {return 2;}measurement_arg:=args_value(a[..],"--measurement","");work_arg:=args_value(a[..],"--work-dir","");if measurement_arg.count==0 || work_arg.count==0 || !fs_mkdir(work_arg) {return 2;}paths:[14][4096]u8;work:=fs_realpath(work_arg,paths[0][..]);root:=fs_cwd(paths[1][..]);measurement:=fs_realpath(measurement_arg,paths[2][..]);if work.count==0 || measurement.count==0 {return 1;}start:=proc_now_ms();deadline:=proc_deadline(RTQ_DEADLINE_MS,start);selected_buf:[4096]u8;selected:=proc_getenv("COAX",selected_buf[..]);if selected.count==0 {selected="coax/bin/coax";}compiler:=args_value(a[..],"--coax",selected);digest:=args_value(a[..],"--compiler-source-digest",fs_join(fs_dir(compiler),"source-digest",paths[3][..]));identity:[1]RtnCompiler;identity[0]=rtn_compiler(compiler,digest,root,work,deadline);if !identity[0].ok || !rfp_compiler_gate(identity[0].matching,args_has(a[..],"--explore-stale-compiler")) {tool_errln("source-matching compiler required before profiling; frozen observation requires explicit exploration");return 1;}
  sources:[1]RtqInputs;held:[1]RtqInputs;if !rtn_tool_sources(sources[..],compiler,"aethyr/render/tests/profile-reference-frame.coax",work,deadline) || !rtq_input_add(sources[..],compiler) || !rtq_input_add(sources[..],digest) || !rtq_input_add(held[..],measurement) {return 1;}self:[4096]u8;self_n:=cxproc_self_path(self[..]);self_hash:[64]u8;if self_n<1 || self_n>self.count || !rtq_input_add(sources[..],cast(string)self[0..<self_n]) || !rtq_hash_file(cast(string)self[0..<self_n],self_hash[..]) {return 1;}
  bytes:[4194304]u8;nodes:[65536]JvNode;doc:[1]Jv;if !rtq_json_file(measurement,bytes[..],nodes[..],doc[..]) || !rfp_measurement(doc[0]) {tool_errln("measurement is incomplete or changed");return 1;}m:=doc[0];artifact_paths:[3][4096]u8;artifacts:[3]string;
  for kind,i:[3]string.["generated_c","generated_header","executable"] {key:[128]u8;w:[1]Jo;jo_start(w[..],key[..]);jo_put(w[..],kind);jo_put(w[..],"_path");n:=jv_str(m,jv_get(m,0,jo_text(w[..])),artifact_paths[i][..]);if n<1 {return 1;}artifacts[i]=cast(string)artifact_paths[i][0..<n];hash:[64]u8;jo_start(w[..],key[..]);jo_put(w[..],kind);jo_put(w[..],"_sha256");if !rtq_hash_file(artifacts[i],hash[..]) || !rfr_literal(m,jv_get(m,0,jo_text(w[..])),cast(string)hash[..]) || !rtq_input_add(held[..],artifacts[i]) {return 1;}}
  driver_arg:=args_value(a[..],"--driver","aethyr/render/tests/reference-frame-native.c");driver:=fs_realpath(driver_arg,paths[4][..]);if driver.count==0 || !rfp_admitted_driver(driver,m) {tool_errln("driver differs from the exact recorded transport");return 1;}if !rtq_input_add(held[..],driver) || !rfp_hash_map(m,jv_get(m,0,"input_sha256"),held[..]) {return 1;}
  fragments:=args_has(a[..],"--fragments");extent:=args_has(a[..],"--extent");points:[256]RfpPoint;point_count:=0;at:=args_find(a[..],"--pixels");if at>=0 {for i:at+1..<args_count(a[..]) {value:=args_at(a[..],i);if value.count>=2 && value[0..<2]=="--" {break;}comma:=rtq_find(value,",",0);if comma<1 || point_count==256 {return 2;}x:=rfr_number(value[0..<comma]);y:=rfr_number(value[comma+1..<value.count]);if !x.ok || !y.ok || x.value<0 || y.value<0 {return 2;}points[point_count]=RfpPoint.{x=x.value,y=y.value};point_count+=1;}}if fragments && point_count==0 {return 2;}
  probe_bytes:[65536]u8;probe:="";support:[1]RtqInputs;if fragments {probe_path:="aethyr/render/tests/reference-fragment-probe.h";n:=fs_read(probe_path,probe_bytes[..]);if n<0 || !rtq_input_add(support[..],probe_path) {return 1;}probe=cast(string)probe_bytes[0..<n];}
  generated:[8388608]u8;gn:=fs_read(artifacts[0],generated[..]);out:[8388608]u8;scratch:[8388608]u8;if gn<0 {return 1;}instrumented:=rfp_instrument(cast(string)generated[0..<gn],points[0..<point_count],fragments,extent,probe,out[..],scratch[..]);source:=fs_join(work,"profiled.c",paths[5][..]);if instrumented.count==0 || !fs_write(source,instrumented) {return 1;}driver_bytes:[1048576]u8;dn:=fs_read(driver,driver_bytes[..]);host_bytes:[1048576]u8;if dn<0 {return 1;}body:=rfp_driver(cast(string)driver_bytes[0..<dn],host_bytes[..]);host:=fs_join(work,"driver.c",paths[6][..]);exe:=fs_join(work,"profiled",paths[7][..]);if body.count==0 || !fs_write(host,body) {return 1;}
  argv:[32]string;argv_storage:[65536]u8;argc:=rfp_render_command(m,artifacts[2],argv[..],argv_storage[..]);if argc<0 {tool_errln("receipt must contain exactly one renderer execution");return 1;}commands:[65536]u8;co:[1]Jo;jo_start(co[..],commands[..]);jo_arr(co[..]);stdout:[8388608]u8;stderr:[8388608]u8;env:[]string;
  compile:=[14]string.["clang","-std=c11","-O2","-ffp-contract=off","-I",fs_dir(artifacts[1]),"-I","aethyr/render/tests",source,host,"-lm","-o",exe,""];jo_arr(co[..]);for v:compile[0..<13] {jo_str(co[..],v);}jo_end(co[..]);run:=rtq_command(compile[0..<13],env,deadline,work,"compile",stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
  fenced:[1]RtqInputs;for path:[5]string.[source,host,artifacts[1],exe,driver] {if !rtq_input_add(fenced[..],path) {return 1;}}for i:0..<support[0].count {row:=support[0].rows[i];if !rtq_input_add(fenced[..],cast(string)row.path[0..<row.count]) {return 1;}}
  image:=fs_join(work,"screen.rgba32f",paths[8][..]);frame:=fs_join(work,"frame.json",paths[9][..]);argv[0]=exe;argv[2]=image;argv[3]=frame;jo_arr(co[..]);for v:argv[0..<argc] {jo_str(co[..],v);}jo_end(co[..]);run=rtq_command(argv[0..<argc],env,deadline,work,"execution",stdout[..],stderr[..]);if !rtq_ok(run) {return 1;}
  result_bytes:[1048576]u8;result_nodes:[16384]JvNode;result:[1]Jv;hash:[64]u8;if !rtq_json_file(frame,result_bytes[..],result_nodes[..],result[..]) || !rtq_equal(m,jv_get(m,0,"result"),result[0],0) || !rtq_hash_file(image,hash[..]) || !rfr_literal(m,jv_get(m,0,"screen_sha256"),cast(string)hash[..]) {tool_errln("instrumentation changed a Coax receipt or pixel bytes");return 1;}
  records:[5][8388608]u8;record_counts:[5]int;for prefix,i:[5]string.["RF_COST ","RF_PIXEL ","RF_FRAGMENT ","RF_EXTENT ","RF_ERROR "] {text:=rfp_records(cast(string)stderr[0..<run.err_n],prefix,ifx i==4 then "RF_TRIANGLE_ERROR " else "",records[i][..]);if text.count==0 {return 1;}record_counts[i]=text.count;}stage_nodes:[16384]JvNode;stage_doc:[1]Jv;if !jv_parse(stage_doc[..],cast(string)records[0][0..<record_counts[0]],stage_nodes[..]) {return 1;}observed:=rfp_steps(stage_doc[0],result[0]);after_args:=[3]string.[compiler,"source-digest",root];after:=rtq_command(after_args[..],env,deadline,work,"compiler-source-after",stdout[..],generated[..]);if !rtq_ok(after) || rtq_trim(cast(string)stdout[0..<after.out_n])!=cast(string)identity[0].current[0..<identity[0].current_count] {return 1;}if observed<0 || !rtq_inputs_match(held[..]) || !rtq_inputs_match(fenced[..]) || !rtq_inputs_match(sources[..]) {return 1;}
  report:[16777216]u8;o:[1]Jo;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.generated-stage-profile.v1");jo_key(o[..],"status");jo_str(o[..],"pass");jo_key(o[..],"qualification");jo_bool(o[..],false);jo_key(o[..],"qualification_status");jo_str(o[..],ifx identity[0].matching then "frozen-artifact observation" else "exploratory");jo_key(o[..],"scope");jo_str(o[..],"Unchanged retained generated-Coax values with effects-only stage-counter logging; result and image byte identity checked. Not a new shader/profile admission or GPU numerical qualification.");jo_key(o[..],"observer_compiler_identity");jo_obj(o[..]);rtn_compiler_json(o[..],compiler,identity[..]);jo_end(o[..]);jo_key(o[..],"observer_compiler_sha256");jo_str(o[..],cast(string)identity[0].hash[..]);jo_key(o[..],"qualifier_executable_sha256");jo_str(o[..],cast(string)self_hash[..]);jo_key(o[..],"compiler_sha256");jv_write(m,jv_get(m,0,"compiler_sha256"),o[..]);
  for key,i:[5]string.["stages","pixel_records","fragment_records","extent_records","error_records"] {jo_key(o[..],key);jo_raw(o[..],cast(string)records[i][0..<record_counts[i]]);}jo_key(o[..],"result");jv_write(result[0],0,o[..]);jo_key(o[..],"unattributed_steps");jo_int(o[..],jv_int(result[0],jv_get(result[0],0,"shader_steps"),0)-observed);jo_key(o[..],"source_sha256");rtq_inputs_json(o[..],sources[..],root);jo_key(o[..],"input_sha256");rtq_inputs_json(o[..],held[..],"");jo_key(o[..],"profile_source_fences");rtq_inputs_json(o[..],fenced[..],"");
  for key,i:[6]string.["tool_sha256","measurement_sha256_before","measurement_sha256","generated_c_sha256","profiled_c_sha256","driver_sha256"] {path:=ifx i==0 then "aethyr/render/tests/profile-reference-frame.coax" else ifx i==1 || i==2 then measurement else ifx i==3 then artifacts[0] else ifx i==4 then source else host;if !rtq_hash_file(path,hash[..]) {return 1;}jo_key(o[..],key);jo_str(o[..],cast(string)hash[..]);}jo_end(co[..]);jo_key(o[..],"commands");jo_raw(o[..],jo_text(co[..]));rtn_elapsed(o[..],proc_now_ms()-start);jo_end(o[..]);if o[0].bad || !fs_write(fs_join(work,"profile.json",paths[10][..]),jo_text(o[..])) {return 1;}print("reference profile: % observed steps, exact result and pixels (% compiler)\n",observed,ifx identity[0].matching then "current-source" else "explicit older");return 0;
}
