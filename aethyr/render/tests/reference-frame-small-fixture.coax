// Assemble a clearly synthetic2x2 fixture from exact retained uniform bytes
// and the selected compiler's authenticated package. No realm/image claim.
#import "Basic";
#load "reference-frame-tool-files.coax";
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=3 {return 2;}out:=args_at(a[..],0);package_arg:=args_at(a[..],1);uniform_arg:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}paths:[5][4096]u8;directory:=fs_realpath(out,paths[0][..]);package:=fs_realpath(package_arg,paths[1][..]);uniform:=fs_join(directory,"u.bin",paths[2][..]);if directory.count==0 || package.count==0 || !rff_copy(uniform_arg,uniform) {return 1;}bytes:[262144]u8;nodes:[16384]JvNode;doc:[1]Jv;if !rtq_json_file(package,bytes[..],nodes[..],doc[..]) {return 1;}d:=doc[0];profile:=jv_int(d,jv_get(d,0,"profile_index"),-1);size:=fs_size(uniform);hash:[64]u8;if profile<0 || size<1 || !rtq_hash_file(uniform,hash[..]) {return 1;}
  // Compiler reflection counts bytes; FrameCounts records uint32 words.
  entries:=jv_get(d,0,"entries");stride:=0;for i:0..<jv_len(d,entries) {row:=jv_at(d,entries,i);if jv_int(d,jv_get(d,row,"entry_index"),-1)==12 {bytes_per_vertex:=jv_int(d,jv_get(d,row,"vertex_stride"),-1);if bytes_per_vertex<4 || bytes_per_vertex%4!=0 {return 1;}stride=bytes_per_vertex/4;}}if stride<1 {return 1;}
  config:[65536]u8;o:[1]Jo;jo_start(o[..],config[..]);jo_int(o[..],profile);jo_put(o[..]," 2 2 0 ");jo_int(o[..],stride);jo_put(o[..]," 0 0 0 0 0 0 0 0\n");jo_put(o[..],uniform);jo_put(o[..],"\n-\n-\n-\n");jo_put(o[..],package);jo_put(o[..],"\n");jo_int(o[..],jv_len(d,entries));jo_put(o[..],"\n");for i:0..<jv_len(d,entries) {row:=jv_at(d,entries,i);name:[128]u8;n:=jv_str(d,jv_get(d,row,"tree_file"),name[..]);if n<1 {return 1;}jo_int(o[..],jv_int(d,jv_get(d,row,"entry_index"),-1));jo_put(o[..]," ");jo_put(o[..],fs_join(fs_dir(package),cast(string)name[0..<n],paths[3][..]));jo_put(o[..],"\n");}jo_put(o[..],"1\nu.bin ");jo_put(o[..],uniform);for k:0..<6 {jo_put(o[..]," ");jo_int(o[..],ifx k==3 then 0 else ifx k==5 then 1 else size);}jo_put(o[..],"\n");if o[0].bad || !fs_write(fs_join(directory,"frame.config",paths[4][..]),jo_text(o[..])) {return 1;}
  capture:[8192]u8;c:[1]Jo;jo_start(c[..],capture[..]);jo_obj(c[..]);jo_key(c[..],"schema");jo_str(c[..],"aethyr.render.producer-capture.v1");jo_key(c[..],"fixture_scope");jo_str(c[..],"synthetic2x2 dimensions/counts, exact retained uniform bytes; no actual realm screenshot");jo_key(c[..],"files");jo_obj(c[..]);jo_key(c[..],"u.bin");jo_obj(c[..]);jo_key(c[..],"bytes");jo_int(c[..],size);jo_key(c[..],"sha256");jo_str(c[..],cast(string)hash[..]);jo_end(c[..]);jo_end(c[..]);jo_key(c[..],"counts");jo_obj(c[..]);for key:[8]string.["hud","draws","water","grass","particles","surface","caster_vertices","caster_instances"] {jo_key(c[..],key);jo_int(c[..],0);}jo_end(c[..]);jo_key(c[..],"vertex_stride");jo_int(c[..],stride);jo_key(c[..],"options");jo_obj(c[..]);jo_key(c[..],"size");jo_str(c[..],"2x2");jo_end(c[..]);jo_key(c[..],"stores");jo_arr(c[..]);jo_end(c[..]);jo_key(c[..],"particles");jo_obj(c[..]);jo_end(c[..]);jo_end(c[..]);if c[0].bad || !fs_write(fs_join(directory,"capture.json",paths[4][..]),jo_text(c[..])) {return 1;}print("synthetic2x2 fixture: profile %, % exact uniform bytes\n",profile,size);return 0;
}
