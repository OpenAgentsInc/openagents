}

#test "quad legacy kill refuses later derivative evaluation with a missing lane" {
 tree:=RQ_IR_TEST_TREE;
 for k:0..<tree.count-3 {if tree[k]==33 && tree[k+1]==18 && tree[k+2]==0 && tree[k+3]==0 {tree[k+1]=1;}}
 meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
 input:=[16]u32.[1073741824,0,0,1065353216,1086324736,0,0,0,1092616192,0,0,1065353216,1102053376,0,0,1065353216];
 memory:[4096]u32;out:[16]u32;out[0]=123;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,10000,15,RQDerivative.fine);
 #assert r.status==RQStatus.divergent && out[0]==123;
}
#test "quad malformed scalar constants cannot write through a void value" {
 tree:=RQ_IR_TEST_TREE;
 // Replace the first f32 constant's type with void, keeping the word extent.
 for k:0..<tree.count-2 {if tree[k]==16 && tree[k+1]==2 && tree[k+2]==1056964608 {tree[k+1]=0;}}
 meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);input:[16]u32;memory:[4096]u32;out:[16]u32;out[0]=123;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,10000,15,RQDerivative.fine);
 #assert r.status==RQStatus.malformed && out[0]==123;
}
#test "quad fragment helper and derivative operations are refused in a vertex entry" {
 tree:=RQ_IR_TEST_TREE;tree[tree.count-3]=0;
 meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);input:[16]u32;memory:[4096]u32;out:[16]u32;out[0]=123;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],0,10000,15,RQDerivative.fine);
 #assert r.status==RQStatus.unsupported && out[0]==123;
}

#test "quad checked tree registry keeps v2 identity and requires v3 for new GPU operations" {
 tree:=RQ_IR_TEST_TREE;meta:[RQ_IR_META]int;
 #assert rq_ir_prepare(tree[..],meta[..]).status==RQStatus.ok;
 tree[0]=2;#assert rq_ir_prepare(tree[..],meta[..]).status==RQStatus.unsupported;
 old:=RQ_IR_BUFFER_TREE;#assert rq_ir_prepare(old[..],meta[..]).status==RQStatus.ok;
 old[0]=3;#assert rq_ir_prepare(old[..],meta[..]).status==RQStatus.ok;
}

RQ_IR_FLAGS_TREE :: [102]u32.[2,9,0,1,2,3,4,5,7,4,2,0,2,4,2,8,2,12,16,7,3,6,0,2,2147483664,4,2147483668,24,7,2,6,0,2,1073741840,20,2,8,1,7,1,7,30,1,1,4,31,8,2,22,1,4,27,41,40,0,1,29,2,27,41,40,0,2,16,2,0,16,2,1065353216,16,2,1056964608,6,4,2,2,2,2,4,2,2,2,2,14,1,1,4,31,6,4,18,0,18,1,18,2,18,3,1,1,0,0];
#test "quad stage flat and depth flags do not become storage byte offsets" {
 tree:=RQ_IR_FLAGS_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
 #assert p.status==RQStatus.ok;
 input:[24]u32;for lane:0..<4 {input[lane*6+4]=f32_bits(cast(f32)(lane+2));input[lane*6+5]=cast(u32)(lane+10);}
 memory:[4096]u32;out:[20]u32;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,10000,15,RQDerivative.fine);
 #assert r.status==RQStatus.ok && r.output_words==20;
 for lane:0..<4 {#assert f32_from_bits(out[lane*5])==cast(f32)(lane+2) && f32_from_bits(out[lane*5+1])==cast(f32)(lane+10) && f32_from_bits(out[lane*5+4])==0.5;}
}

RQ_IR_CONTROL_TREE :: [231]u32.[3,7,0,1,2,3,4,5,7,4,2,0,2,4,2,8,2,12,16,3,6,1,6,1,6,60,1,2,6,0,19,6,27,41,40,0,3,16,2,1056964608,1,1,2,33,18,0,0,4,22,1,4,33,15,2,1,27,41,40,0,0,33,16,2,1,27,41,40,0,0,33,17,2,1,27,41,40,0,0,22,2,1,27,41,40,0,2,6,4,2,2,2,2,4,2,2,2,2,14,1,1,4,31,6,4,18,0,18,1,18,2,18,3,2,1,2,4,2,2,5,5,106,1,5,3,40,1,16,2,0,8,2,16,5,0,0,16,5,4,0,1,3,6,0,19,10,18,2,16,5,1,0,1,1,10,6,0,19,10,18,2,16,5,3,0,1,1,9,3,40,1,19,1,27,40,1,19,1,18,0,29,2,18,2,3,40,3,16,5,0,0,7,19,6,18,3,16,5,2,0,1,2,3,40,1,19,1,27,40,1,16,2,1065353216,3,40,3,19,1,27,40,3,16,5,1,0,4,18,1,1,1,0,0];
#test "quad checked control tree preserves loops calls break continue and final values" {
 tree:=RQ_IR_CONTROL_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);#assert p.status==RQStatus.ok;
 input:=[16]u32.[1073741824,0,1073741824,1065353216,1086324736,0,1073741824,0,1092616192,0,1073741824,1065353216,1102053376,0,1073741824,1065353216];
 memory:[16384]u32;out:[16]u32;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,100000,15,RQDerivative.fine);
 #assert r.status==RQStatus.ok && r.discarded==2 && r.publish_mask==13;
 expected:=[16]f32.[4,8,12,8,4,16,20,8,12,8,20,8,12,16,28,8];
 for i:0..<16 {#assert f32_from_bits(out[i])==expected[i];}
}

#test "quad implicit LOD uses both texture axes and each fine lane footprint" {
 levels:=[2]RQMip.[RQMip.{width=4,height=8},RQMip.{width=2,height=4,offset=32}];texels:[40]RQColor;
 t:=RQTexture.{levels=levels[..],layers=1,texels=texels[..]};u:=RQQuad.{v=[4]f32.[0,0.75,1.25,2.75]};v:=RQQuad.{v=[4]f32.[0,0.5,0.75,2]};
 expected:=[4]f32.[2.9653686688,3.8502198591,3.5437314206,3.8502198591];
 for lane:0..<4 {
  a:=rq_ir_lod(t,u,v,lane,RQDerivative.fine,0);b:=rq_ir_lod(t,u,v,lane,RQDerivative.coarse,-1.25);
  #assert abs(a-expected[lane])<0.00001f32 && abs(b-1.7153686688f32)<0.00001f32;
 }
}
#test "quad logical field offsets reject both signed bounds and nonstruct carriers" {
 tree:=RQ_IR_TEST_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);m:=[1]RQMachine.[RQMachine.{types=p.types,budget=100}];
 first:=rq_ir_field(m[..],tree[..],meta[..],6,0);last:=rq_ir_field(m[..],tree[..],meta[..],6,3);
 #assert m[0].status==RQStatus.ok && first.ty==2 && first.at==0 && first.words==1 && last.ty==2 && last.at==3 && last.words==1;
 for which:0..<3 {
  m[0]=RQMachine.{types=p.types,budget=100};ty:=6;field:=-1;if which==1 {field=4;}if which==2 {field=0;ty=2;}
  value:=rq_ir_field(m[..],tree[..],meta[..],ty,field);#assert m[0].status==RQStatus.malformed;
 }
}
