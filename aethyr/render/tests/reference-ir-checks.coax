}

RQ_IR_PRIVATE_TREE :: [149]u32.[2,9,0,1,2,3,4,5,7,4,2,0,2,4,2,8,2,12,16,8,2,1,4,9,2,3,6,1,6,4,6,7,8,2,61,1,5,3,40,1,17,7,3,42,40,1,16,5,0,0,16,2,1073741824,11,2,1,3,40,3,19,1,27,42,40,2,16,5,0,0,22,1,1,18,2,4,22,2,4,18,3,27,42,40,2,16,5,0,0,27,41,40,0,0,16,2,1065353216,2,1,8,1,8,17,1,2,3,42,40,0,16,5,0,0,16,2,1091567616,4,16,2,1065353216,6,4,2,2,2,2,4,2,2,2,2,14,1,1,4,31,6,4,18,0,18,1,18,2,18,3,1,1,0,0];
#test "quad local array views write shared private storage through a callee" {
 tree:=RQ_IR_PRIVATE_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
 #assert p.status==RQStatus.ok;
 input:[16]u32;memory:[4096]u32;out:[16]u32;
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,10000,15,RQDerivative.fine);
 #assert r.status==RQStatus.ok;
 for lane:0..<4 {#assert f32_from_bits(out[lane*4])==3 && f32_from_bits(out[lane*4+1])==9 && f32_from_bits(out[lane*4+2])==0 && f32_from_bits(out[lane*4+3])==1;}
}

