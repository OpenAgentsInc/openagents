#test "reference bounded guard profile reproduces six Vulkan original plane observations" {
 tree:=RP_GUARD_PROBE_TREE;meta:[RQ_IR_META]int;memory:[RQ_IR_WORDS]u32;scratch:[4096]RRPixel;target:[4096]RRPixel;
 p:=rq_ir_prepare(tree[..],meta[..]);r:=rr_pipeline(p,tree[..],meta[..]);#assert r.status==RQStatus.ok;
 deltas:=[6]f32.[0,1.0f32/1024,2.0f32/1024,3.0f32/1024,6.0f32/1024,7.0f32/1024];
 observed:=[6]f32.[0.6124999523162842,0.6124999523162842,0.6124999523162842,0.6131109595298767,0.6137230396270752,0.6137230396270752];
 words:=[1]u32.[0];buffers:=[1]RQBuffer.[RQBuffer.{words=words[..],count=1,stride=4}];res:=RQResources.{buffers=buffers[..]};
 bindings:=[1]RRBinding.[RRBinding.{name_id=rq_ir_parameter(p,tree[..],meta[..],0,2).name_id,kind=1}];
 draws:=[1]RenderDecodedDraw.[RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,count=3,instances=1}];indices:[]u32;attrs:RRAttributes;state:=RenderPassState.{valid=true,outputs=1};profile:=rr_raster_xy_profile("nearest-even",8,"guard-band",64);
 for which:0..<6 {
  words[0]=f32_bits(deltas[which]);q:=rr_reference_pass_profile(r,p,tree[..],meta[..],res,bindings[..],attrs,draws[..],indices,state,64,64,RRFormat.f32,1000000,memory[..],scratch[..],target[..],profile);
  #assert q.status==RQStatus.ok && q.written>0;
  #assert abs(target[9*64+9].colour.r-observed[which])<0.000001 && target[9*64+9].colour.r==target[9*64+9].colour.g && target[9*64+9].colour.r==target[9*64+9].colour.b && target[9*64+9].colour.a==1;
 }
 before:=target[9*64+9];profile.guard_pixels=63;q:=rr_reference_pass_profile(r,p,tree[..],meta[..],res,bindings[..],attrs,draws[..],indices,state,64,64,RRFormat.f32,1000000,memory[..],scratch[..],target[..],profile);
 #assert q.status==RQStatus.unsupported && target[9*64+9].colour.r==before.colour.r && target[9*64+9].colour.g==before.colour.g && target[9*64+9].colour.b==before.colour.b && target[9*64+9].colour.a==before.colour.a && target[9*64+9].depth==before.depth;
}
