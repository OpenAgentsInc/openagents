RFP_TEST_C :: "static coax_t_RRVertices coax_p_rr_vertices(int x);\nstatic coax_t_RRShaded coax_p_rr_shade(int x);\nstatic coax_t_RRVertices coax_p_rr_vertices(int x) {return v;}\nstatic coax_t_RRShaded coax_p_rr_shade(int x) {return f;}\nstatic coax_t_RFResult coax_p_rf_execute_draw(int x) {return f;}\nstatic coax_t_RRStored coax_p_rr_store(int x) {return f;}\nstatic coax_t_RRTriangle coax_p_rr_triangle_profile(int x) {return f;}\n";
#test "profiler definition selector keeps declarations and requires exactly one definition" {
 d:=rfp_definition(RFP_TEST_C,"RRVertices","rr_vertices");#assert d.ok && d.args=="int x" && d.start==99 && d.end==151;
 #assert !rfp_definition("static coax_t_RRVertices coax_p_rr_vertices(int x);\n","RRVertices","rr_vertices").ok;
 bytes:[4096]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_put(o[..],RFP_TEST_C);jo_put(o[..],RFP_TEST_C);#assert !rfp_definition(jo_text(o[..]),"RRVertices","rr_vertices").ok;
 #assert !rfp_definition(" static coax_t_RRVertices coax_p_rr_vertices(int x) {","RRVertices","rr_vertices").ok;
}
#test "profiler generated argument forwarding preserves the declared final words" {bytes:[256]u8;#assert rfp_names("const uint32_t *l_tree, int64_t l_index, coax_t_RQ q",bytes[..])=="*l_tree,l_index,q";#assert rfp_names("int x",bytes[..])=="x";#assert rfp_names("",bytes[..])=="";small:[1]u8;#assert rfp_names("int long_name",small[..])=="";}
#test "profiler compiler gate requires current source unless exploration is explicit" {#assert rfp_compiler_gate(true,false);#assert rfp_compiler_gate(true,true);#assert rfp_compiler_gate(false,true);#assert !rfp_compiler_gate(false,false);}
#test "profiler measurement requires a completed immutable frame" {nodes:[128]JvNode;doc:[1]Jv;#assert jv_parse(doc[..],"{\"status\":\"rendered\",\"source_changes\":[],\"artifact_changes\":[],\"input_changes\":[]}",nodes[..]);#assert rfp_measurement(doc[0]);#assert jv_parse(doc[..],"{\"status\":\"refused\",\"source_changes\":[],\"artifact_changes\":[],\"input_changes\":[]}",nodes[..]);#assert rfp_measurement(doc[0]);for text:[5]string.["{}","{\"status\":\"prepared\"}","{\"status\":\"rendered\",\"source_changes\":[1]}","{\"status\":\"rendered\",\"source_changes\":[],\"artifact_changes\":false}","{\"status\":\"rendered\",\"source_changes\":[],\"artifact_changes\":[],\"input_changes\":[1]}"] {#assert jv_parse(doc[..],text,nodes[..]);#assert !rfp_measurement(doc[0]);}}
#test "profiler counters are positive and never exceed the measured renderer budget" {sn:[64]JvNode;sd:[1]Jv;rn:[64]JvNode;rd:[1]Jv;#assert jv_parse(rd[..],"{\"shader_steps\":12}",rn[..]);#assert jv_parse(sd[..],"[{\"vertex_steps\":2,\"fragment_steps\":4},{\"vertex_steps\":6,\"fragment_steps\":0}]",sn[..]);#assert rfp_steps(sd[0],rd[0])==12;for text:[5]string.["[]","[{\"vertex_steps\":0,\"fragment_steps\":0}]","[{\"vertex_steps\":13,\"fragment_steps\":0}]","[{\"vertex_steps\":-1,\"fragment_steps\":2}]","[{\"vertex_steps\":1}]"] {#assert jv_parse(sd[..],text,sn[..]);#assert rfp_steps(sd[0],rd[0])== -1;}}

#test "profiler preserves exact historical instrumentation bytes in every named observer mode" {out:[65536]u8;scratch:[65536]u8;p:=[1]RfpPoint.[RfpPoint.{x=104729,y=104723}];probe:="probe-header\n";hash:[64]u8;
points:=p[0..<0];value:=rfp_instrument(RFP_TEST_C,points,false,false,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="0260d8ba2002581398ae3a1e22010c702c9826c5011b95b3147b2f5b1907ea75";
value=rfp_instrument(RFP_TEST_C,p[0..<0],false,true,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="d292913cc4e0bfe067141dee7bad64517953050d418ac6e3f4da4170bd3f67ef";
value=rfp_instrument(RFP_TEST_C,p[0..<1],false,false,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="3ef8a903f37bd11505af66bbd6ed51a911613df8a5a9ff388ffccc5b98a5ff79";
value=rfp_instrument(RFP_TEST_C,p[0..<1],false,true,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="5d3d1e72c490d17f8ebf6348d813249f393955790837b62d45191767dd1a2b47";
value=rfp_instrument(RFP_TEST_C,p[0..<1],true,false,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="10b469e8dabce11fa676b260d48c903ebad8f8c7b56a2693a5480063bd7d2449";
value=rfp_instrument(RFP_TEST_C,p[0..<1],true,true,probe,out[..],scratch[..]);#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="62b8a5ee1a783f025cf44f17025e1db45c55dc73df870eec115f274e16c4ef7f";
small:[1]u8;#assert rfp_instrument(RFP_TEST_C,p[..],false,false,probe,small[..],scratch[..])=="";#assert rfp_instrument(RFP_TEST_C,p[0..<0],true,false,probe,out[..],scratch[..])=="";#assert rfp_instrument("",p[0..<0],false,false,probe,out[..],scratch[..])=="";}
#test "profiler driver registration and report preserve the exact frozen transport body" {out:[4096]u8;value:=rfp_driver("prefix coax_t_RFRequirements req=value;middle assert(out[pixels].r==91tail",out[..]);#assert value=="#include <stdint.h>\nvoid rfc_register(const uint32_t *,int64_t);\nvoid rfc_report(void);\nprefix for(int64_t k=0;k<programs_count;k++)rfc_register(programs[k].tree.data,programs[k].index);\n coax_t_RFRequirements req=value;middle rfc_report();\n assert(out[pixels].r==91tail";#assert rfp_driver("",out[..])=="";#assert rfp_driver(" coax_t_RFRequirements req= coax_t_RFRequirements req= assert(out[pixels].r==91",out[..])=="";#assert rfp_driver(" coax_t_RFRequirements req= assert(out[pixels].r==91 assert(out[pixels].r==91",out[..])=="";small:[1]u8;#assert rfp_driver(" coax_t_RFRequirements req= assert(out[pixels].r==91",small[..])=="";}

#test "profiler scanner covers zero arguments greedy closes final lines and embedded nondefinitions" {d:=rfp_definition("static coax_t_RRVertices coax_p_rr_vertices() {","RRVertices","rr_vertices");#assert d.ok && d.args=="";e:=rfp_definition("static coax_t_RRVertices coax_p_rr_vertices(int x) {) {","RRVertices","rr_vertices");#assert e.ok && e.args=="int x) {";#assert !rfp_definition("static coax_t_RRVertices coax_p_rr_vertices(","RRVertices","rr_vertices").ok;#assert !rfp_definition("prefixstatic coax_t_RRVertices coax_p_rr_vertices(int x) {","RRVertices","rr_vertices").ok;#assert !rfp_definition("static coax_t_RRVertices coax_p_rr_vertices(int x);","RRVertices","rr_vertices").ok;long:[512]u8;for i:0..<long.count {long[i]='a';}#assert !rfp_definition("",cast(string)long[..],"name").ok;}
#test "profiler forwards whitespace-delimited generated names including comma-adjacent spaces" {out:[256]u8;#assert rfp_names("  int first  ,\tlong second\t, char z ",out[..])=="first,second,z";#assert rfp_names("a",out[..])=="a";#assert rfp_names(" ",out[..])=="";#assert rfp_names("int x,",out[..])=="";}
#test "profiler template expansion handles edge tokens multi-point lists and refuses unknown tokens" {bytes:[512]u8;o:[1]Jo;p:=[2]RfpPoint.[RfpPoint.{x=0,y=1},RfpPoint.{x=2,y=3}];jo_start(o[..],bytes[..]);rfp_expand(o[..],"RFP_ARGS_TOKEN/RFP_NAMES_TOKEN/RFP_COUNT_TOKEN/RFP_POINTS_TOKEN/RFP_PROBE_TOKEN","args","names",p[..],"probe");#assert jo_text(o[..])=="args/names/2/{0,1},{2,3}/probe";jo_start(o[..],bytes[..]);rfp_expand(o[..],"RFP_UNKNOWN","","",p[..],"");#assert o[0].bad;jo_start(o[..],bytes[..]);rfp_expand(o[..],"RFP_","","",p[..],"");#assert o[0].bad;}
#test "profiler instrumentation refuses missing optional definitions negative points and short scratch" {out:[65536]u8;scratch:[65536]u8;small:[1]u8;p:=[1]RfpPoint.[RfpPoint.{x=-1,y=0}];#assert rfp_instrument(RFP_TEST_C,p[..],false,false,"",out[..],scratch[..])=="";p[0]=RfpPoint.{x=0,y=-1};#assert rfp_instrument(RFP_TEST_C,p[..],false,false,"",out[..],scratch[..])=="";p[0]=RfpPoint.{x=0,y=0};#assert rfp_instrument("",p[..],false,false,"",out[..],scratch[..])=="";#assert rfp_instrument(RFP_TEST_C,p[..],false,false,"",out[..],small[..])=="";no_args:="static coax_t_RRVertices coax_p_rr_vertices() {return v;}\nstatic coax_t_RRShaded coax_p_rr_shade(int x) {return f;}";#assert rfp_instrument(no_args,p[0..<0],false,false,"",out[..],scratch[..])=="";}
#test "profiler driver accepts first-byte needles rejects missing and reversed registrations" {out:[4096]u8;#assert rfp_driver(" coax_t_RFRequirements req= assert(out[pixels].r==91",out[..]).count>0;#assert rfp_driver(" assert(out[pixels].r==91 coax_t_RFRequirements req=",out[..]).count>0;#assert rfp_driver(" coax_t_RFRequirements req=",out[..])=="";#assert rfp_driver(" assert(out[pixels].r==91",out[..])=="";}
#test "profiler stage total observes unit limits second-row overflow and invalid containers" {sn:[64]JvNode;sd:[1]Jv;rn:[64]JvNode;rd:[1]Jv;#assert jv_parse(rd[..],"{\"shader_steps\":1}",rn[..]);#assert jv_parse(sd[..],"[{\"vertex_steps\":1,\"fragment_steps\":0}]",sn[..]);#assert rfp_steps(sd[0],rd[0])==1;#assert jv_parse(rd[..],"{\"shader_steps\":12}",rn[..]);#assert jv_parse(sd[..],"[{\"vertex_steps\":7,\"fragment_steps\":6}]",sn[..]);#assert rfp_steps(sd[0],rd[0])== -1;#assert jv_parse(sd[..],"{}",sn[..]);#assert rfp_steps(sd[0],rd[0])== -1;}

#test "profiler empty and adjacent forwarding names keep exact token ends" {out:[256]u8;#assert rfp_names("a,b",out[..])=="a,b";#assert rfp_names(",",out[..])=="";}
#test "profiler budget metadata must exist and admit at least the measured step" {sn:[64]JvNode;sd:[1]Jv;rn:[64]JvNode;rd:[1]Jv;#assert jv_parse(sd[..],"[{\"vertex_steps\":1,\"fragment_steps\":0}]",sn[..]);for text:[4]string.["{}","{\"shader_steps\":false}","{\"shader_steps\":0}","{\"shader_steps\":-1}"] {#assert jv_parse(rd[..],text,rn[..]);#assert rfp_steps(sd[0],rd[0])== -1;}}
#test "profiler wrapper order stays stable when generated definitions change order and pixels include zero" {out:[65536]u8;scratch:[65536]u8;p:=[2]RfpPoint.[RfpPoint.{x=0,y=0},RfpPoint.{x=1,y=1}];text:="static coax_t_RRTriangle coax_p_rr_triangle_profile(int x) {return f;}\nstatic coax_t_RRStored coax_p_rr_store(int x) {return f;}\nstatic coax_t_RFResult coax_p_rf_execute_draw(int x) {return f;}\nstatic coax_t_RRShaded coax_p_rr_shade(int x) {return f;}\nstatic coax_t_RRVertices coax_p_rr_vertices(int x) {return v;}\nstatic coax_t_RRShaded coax_p_rr_shade(int x);\nstatic coax_t_RRVertices coax_p_rr_vertices(int x);\n";value:=rfp_instrument(text,p[..],false,false,"",out[..],scratch[..]);hash:[64]u8;#assert S_hex(S_hash(value),hash[..]) && cast(string)hash[..]=="0a006c006661d527cd62ea4f948bc6f010f6e3db9c3ffdab3c795f102b52ab9c";}
