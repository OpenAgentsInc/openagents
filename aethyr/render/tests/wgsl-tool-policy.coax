// WGSL native compilation facts are admitted in Coax, never browser glue.
#import "Basic";
#load "tooling-policy.coax";
#authority;
#load "wgsl-tool-checks.coax";
WgtMessages :: struct {ok:bool;errors:int;warnings:int;}
wgt_same_text :: (d:Jv,node:int,value:string)->bool {
  bytes:[16384]u8;n:=jv_str(d,node,bytes[..]);return n==value.count && cast(string)bytes[0..<n]==value;
}
wgt_messages :: (d:Jv,node:int)->WgtMessages {
  s:WgtMessages;messages:=rtq_member(d,node,"messages");if jv_kind(d,messages)!=JV_ARRAY {return s;}
  for k:0..<jv_len(d,messages) {
    row:=jv_at(d,messages,k);if jv_kind(d,row)!=JV_OBJECT || jv_len(d,row)!=4 {return s;}
    kind:=rtq_member(d,row,"type");message:=rtq_member(d,row,"message");line:=rtq_member(d,row,"line");column:=rtq_member(d,row,"column");
    if jv_kind(d,message)!=JV_STRING || jv_int(d,line,-1)<0 || jv_int(d,column,-1)<0 {return s;}
    if wgt_same_text(d,kind,"error") {s.errors+=1;}else if wgt_same_text(d,kind,"warning") {s.warnings+=1;}else if !wgt_same_text(d,kind,"info") {return s;}
  }s.ok=true;return s;
}
wgt_admit :: (d:Jv,node:int,control:bool)->bool {
  s:=wgt_messages(d,node);if !s.ok {return false;}validation:=rtq_member(d,node,"validation_error");
  if control {return s.errors>0 && jv_kind(d,validation)==JV_STRING && jv_raw(d,validation).count>0;}
  return s.errors==0 && jv_kind(d,validation)==JV_NULL;
}
wgt_complete :: (errors:int,uncaptured:int,observed:int,expected:int,control:bool,changed:bool)->bool {
  return errors==0 && uncaptured==0 && observed==expected && expected>0 && control && !changed;
}
wgt_name :: (name:string)->bool {
  if name.count==0 || name=="." || name==".." || name[0]=='-' {return false;}
  for c:name {if !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='-' || c=='_' || c=='.') {return false;}}return true;
}
wgt_digest :: (text:string)->bool {
  if text.count!=64 {return false;}
  for c:text {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}return true;
}
