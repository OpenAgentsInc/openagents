// Character Advancement (SRD 5.2.1, p. 23): the XP a character needs for each level, and the level its
// XP gives. The one table (#13259): the room levels a seat by it (coax/web/room/room-events.coax
// ev_level_of, Everglade I's druid and Warlock, and Everglade II's classes), the API signs the level it
// gives into a seat ticket (aethyr/session/seat-class.coax), and the page draws its XP bar by it
// (apps/openagents-web/everglade-events.coax). Nothing else holds a level's XP.
//   coax/bin/coax test aethyr/rules/srd/advancement.coax --library
//   coax/bin/coax mutate aethyr/rules/srd/advancement.coax --library
#authority;

SRD_LEVEL_TOP :: 20;
// SRD_XP[L - 1]: the XP for level L
SRD_XP :: [20] int.[0, 300, 900, 2700, 6500, 14000, 23000, 34000, 48000, 64000,
                    85000, 100000, 120000, 140000, 165000, 195000, 225000, 265000, 305000, 355000];

// The XP level `level` needs (1 to SRD_LEVEL_TOP; below 1 is level 1's, above the top the top's).
srd_xp_at :: (level: int) -> int #effects(all) {
  x := 0;
  for l: 1..<SRD_LEVEL_TOP { if level > l { x = SRD_XP[l]; } }
  return x;
}
// The level `xp` gives, and at least `least`, never past `top` (1 to SRD_LEVEL_TOP: a world's highest
// level; below 1 is 1). `least` is a level the server grants without the XP (a ticket's signed level,
// a realm's starting level, a seat's level now): XP only ever adds to it.
srd_level_from :: (xp: int, least: int, top: int) -> int #effects(all) {
  l := 1;
  for i: 0..<SRD_LEVEL_TOP - 1 { if i + 1 < top && (xp >= SRD_XP[i + 1] || least > i + 1) { l = i + 2; } }
  return l;
}

#test "advancement: each level's XP, as the SRD prints it" {
  #assert srd_xp_at(1) == 0 && srd_xp_at(2) == 300 && srd_xp_at(3) == 900 && srd_xp_at(4) == 2700 && srd_xp_at(5) == 6500 && srd_xp_at(6) == 14000;
  #assert srd_xp_at(10) == 64000 && srd_xp_at(19) == 305000 && srd_xp_at(20) == 355000;
  #assert srd_xp_at(0) == 0 && srd_xp_at(-3) == 0 && srd_xp_at(21) == 355000;
  for l: 2..<SRD_LEVEL_TOP + 1 { #assert srd_xp_at(l) > srd_xp_at(l - 1); }
}
#test "advancement: the level XP gives, at each threshold and one below it, up to the top" {
  for l: 1..<SRD_LEVEL_TOP + 1 {
    #assert srd_level_from(srd_xp_at(l), 1, SRD_LEVEL_TOP) == l;
    if l > 1 { #assert srd_level_from(srd_xp_at(l) - 1, 1, SRD_LEVEL_TOP) == l - 1; }
  }
  #assert srd_level_from(0, 1, 6) == 1 && srd_level_from(299, 1, 6) == 1 && srd_level_from(300, 1, 6) == 2 && srd_level_from(899, 1, 6) == 2 && srd_level_from(900, 1, 6) == 3;
  #assert srd_level_from(6500, 1, 6) == 5 && srd_level_from(13999, 1, 6) == 5 && srd_level_from(14000, 1, 6) == 6 && srd_level_from(9999999, 1, 6) == 6;
  #assert srd_level_from(900, 1, 3) == 3 && srd_level_from(9999999, 1, 3) == 3 && srd_level_from(2700, 1, 3) == 3;
  #assert srd_level_from(9999999, 1, 20) == 20 && srd_level_from(9999999, 1, 21) == 20 && srd_level_from(9999999, 1, 0) == 1 && srd_level_from(9999999, 1, -2) == 1;
  #assert srd_level_from(-5, 1, 6) == 1 && srd_level_from(300, 1, 1) == 1 && srd_level_from(300, 1, 2) == 2;
}
#test "advancement: a floor grants a level without its XP; XP past it still counts; the top still holds" {
  for f: 1..<7 { #assert srd_level_from(0, f, 6) == f; }
  #assert srd_level_from(0, 0, 6) == 1 && srd_level_from(0, -3, 6) == 1 && srd_level_from(0, 7, 6) == 6 && srd_level_from(0, 20, 6) == 6;
  #assert srd_level_from(6500, 2, 6) == 5 && srd_level_from(300, 5, 6) == 5 && srd_level_from(14000, 5, 6) == 6 && srd_level_from(899, 2, 6) == 2;
  #assert srd_level_from(0, 20, 20) == 20 && srd_level_from(0, 19, 20) == 19 && srd_level_from(355000, 1, 20) == 20 && srd_level_from(0, 4, 3) == 3;
}
