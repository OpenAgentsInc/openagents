// A battle on a grid of 5-foot squares (docs/dnd/README.md, "The rules engine" and "The time
// adapter"): creatures, the lasting areas spells make, and the SRD's turn on a real-time clock.
// Every creature's turn comes round every 6 seconds on its own beat, staggered by initiative;
// in its turn it has one action, one Bonus Action, its Speed in movement and one spell slot to
// spend (the SRD's one-slot-a-turn rule). rs_cast runs any spell record's effect program;
// the world decides who casts what (its own AI or a player) and draws the events.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test --library aethyr/rules/srd/battle.coax
#load "spells.coax";

RS_MAX :: 216;
RS_ZONES :: 8;
RsZone :: struct { on: bool; spell: int; by: int; x0: int; y0: int; x1: int; y1: int; until: f32; difficult: bool; }
// A turn's economy and what has happened in it: moved (Steady Aim needs none), aimed (Steady Aim's
// Advantage waiting) and anchored (its Speed 0 after), last_hit (1 + whom its last melee weapon
// attack hit, 0 none: Divine Smite follows it) and last_crit, the once-a-turn Sneak Attack and
// Colossus Slayer, leveled (a level 1+ spell cast) and quickened (Quickened Spell used).
RsTurn :: struct { action: bool; bonus: bool; slot_spent: bool; move_left: int; cleaved: bool; frenzied: bool; struck: bool; new_round: bool;
                   moved: bool; aimed: bool; anchored: bool; last_hit: int; last_crit: bool; sneaked: bool; colossus: bool;
                   leveled: bool; quickened: bool; }
RsBattle :: struct {
  c: [RS_MAX] RsCreature; n: int;
  zone: [RS_ZONES] RsZone;
  dice: [1] RsDice;
  book: [1] RsLog;
  clock: f32;
  w: int; h: int;             // the grid, squares
  who: int;                   // whose turn is running (-1 none)
  turn: RsTurn;
  // The time adapter. The SRD's: a turn every 6 seconds (beat 0 means RS_ROUND), slots and uses back
  // only on a rest (recharge 0). The action adapter: a shorter beat, each beat a whole turn's
  // economy, and every spent slot, Rage and Focus Point back `recharge` seconds later (the ruleset
  // profile's `cost cooldown N`). Saves that repeat, death saves and Rage's upkeep stay on 6-second
  // rounds either way.
  beat: f32;
  recharge: f32;
}
rs_beat :: (b: [] RsBattle) -> f32 { return ifx b[0].beat > 0 then b[0].beat else f32(RS_ROUND); }

rs_abs :: (v: int) -> int { return ifx v < 0 then -v else v; }
rs_sign :: (v: int) -> int { if v > 0 { return 1; } if v < 0 { return -1; } return 0; }
// Distance in feet on the grid: each square 5 feet, diagonals too (the SRD's grid rule).
rs_feet :: (ax: int, ay: int, bx: int, by: int) -> int { return rs_max(rs_abs(ax - bx), rs_abs(ay - by)) * RS_SQUARE; }
rs_feet_to :: (b: [] RsBattle, i: int, j: int) -> int { return rs_feet(b[0].c[i].x, b[0].c[i].y, b[0].c[j].x, b[0].c[j].y); }
// Who stands on a square (the dead lie where they fell and still fill it), or -1.
rs_at :: (b: [] RsBattle, x: int, y: int) -> int {
  for i: 0..<b[0].n { if b[0].c[i].x == x && b[0].c[i].y == y { return i; } }
  return -1;
}
rs_inside :: (z: RsZone, x: int, y: int) -> bool { return z.on && x >= z.x0 && x <= z.x1 && y >= z.y0 && y <= z.y1; }
rs_difficult :: (b: [] RsBattle, x: int, y: int) -> bool {
  for k: 0..<RS_ZONES { if b[0].zone[k].difficult && rs_inside(b[0].zone[k], x, y) { return true; } }
  return false;
}
// A hostile creature within 5 feet that can act: ranged attacks have Disadvantage then.
rs_threatened :: (b: [] RsBattle, i: int) -> bool {
  for j: 0..<b[0].n {
    if j != i && b[0].c[j].team != b[0].c[i].team && rs_can_act(b[0].c[j]) && rs_feet_to(b, i, j) <= 5 { return true; }
  }
  return false;
}

// The squares a spell's area covers from caster i toward the point (tx, ty).
rs_area :: (b: [] RsBattle, i: int, sp: RsSpell, tx: int, ty: int) -> RsZone {
  z: RsZone;
  z.on = true; z.by = i; z.spell = -1;
  k := rs_max(sp.area_ft / RS_SQUARE, 1);
  cx := b[0].c[i].x; cy := b[0].c[i].y;
  if sp.area == RS_A_CUBE_SELF {
    // a cube originating from you: on the side toward the point, against your space
    ox_ := rs_sign(tx - cx); oy_ := rs_sign(ty - cy);
    if ox_ == 0 && oy_ == 0 { ox_ = 1; }
    z.x0 = ifx ox_ > 0 then cx + 1 else ifx ox_ < 0 then cx - k else cx - k / 2;
    z.y0 = ifx oy_ > 0 then cy + 1 else ifx oy_ < 0 then cy - k else cy - k / 2;
  } else {
    z.x0 = tx - (k - 1) / 2; z.y0 = ty - (k - 1) / 2;
  }
  z.x1 = z.x0 + k - 1; z.y1 = z.y0 + k - 1;
  return z;
}

// ---- telling the world

RsLine :: struct { buf: [RS_EV_TEXT] u8; n: int; }
rs_line :: () -> RsLine { l: RsLine; return l; }
rs_add_text :: (l: [] RsLine, t: string) { l[0].n = rs_put(l[0].buf[..], l[0].n, t); }
rs_add_int :: (l: [] RsLine, v: int) { l[0].n = rs_put_int(l[0].buf[..], l[0].n, v); }
rs_add_name :: (l: [] RsLine, b: [] RsBattle, i: int) { rs_add_text(l, cast(string) b[0].c[i].name[0..<b[0].c[i].name_n]); }
rs_tell :: (b: [] RsBattle, kind: int, spell: int, by: int, to: int, amount: int, damage: int, l: [] RsLine) {
  e: RsEvent;
  e.kind = kind; e.spell = spell; e.by = by; e.to = to; e.amount = amount; e.damage = damage; e.at = b[0].clock;
  if to >= 0 { e.x = b[0].c[to].x; e.y = b[0].c[to].y; }
  for k: 0..<l[0].n { e.text[k] = l[0].buf[k]; }
  e.text_n = l[0].n;
  i := rs_emit(b[0].book[..], e);
}
RS_ORDINAL :: [10] string.["", "1st", "2nd", "3rd", "4th", "5th", "6th", "7th", "8th", "9th"];

// ---- creatures in the battle

rs_add :: (b: [] RsBattle, c: RsCreature, x: int, y: int) -> int {
  if b[0].n >= RS_MAX { return -1; }
  i := b[0].n;
  b[0].c[i] = c; b[0].c[i].x = x; b[0].c[i].y = y;
  // Remarkable Athlete: Advantage on Initiative rolls
  b[0].c[i].initiative = rs_d20(b[0].dice[..], ifx c.athlete then 1 else 0).roll + rs_mod(c.score[RS_DEX]);
  b[0].n += 1;
  return i;
}
// The turns begin: the highest initiative first, the rest spread over the 6-second round.
rs_begin :: (b: [] RsBattle) {
  b[0].who = -1;
  for i: 0..<b[0].n {
    rank := 0;
    for j: 0..<b[0].n {
      if b[0].c[j].initiative > b[0].c[i].initiative || (b[0].c[j].initiative == b[0].c[i].initiative && j < i) { rank += 1; }
    }
    b[0].c[i].turn_at = b[0].clock + 0.4 + f32(rank) * rs_beat(b) / f32(rs_max(b[0].n, 1));
    b[0].c[i].round_at = b[0].c[i].turn_at;
  }
}
// Whose turn is due on the clock, or -1.
rs_due :: (b: [] RsBattle) -> int {
  best := -1;
  for i: 0..<b[0].n {
    if b[0].c[i].dead || b[0].c[i].turn_at > b[0].clock { continue; }
    if best < 0 || b[0].c[i].turn_at < b[0].c[best].turn_at { best = i; }
  }
  return best;
}

rs_drop_effect :: (b: [] RsBattle, j: int, k: int) {
  c: [1] RsCreature; c[0] = b[0].c[j];
  rs_effect_end(c[..], k);
  b[0].c[j] = c[0];
}
rs_put_effect :: (b: [] RsBattle, j: int, e: RsEffect) {
  if (e.kind == EF_COND || e.kind == EF_TURNED) && (b[0].c[j].immune_cond & e.cond) != 0 { return; }
  f := e;
  // Mindless Rage (p. 30): Immunity to Charmed and Frightened while raging
  if (f.kind == EF_COND || f.kind == EF_TURNED) && b[0].c[j].raging && b[0].c[j].mindless {
    f.cond = f.cond & (32767 - RS_CHARMED - RS_FRIGHTENED);
    if f.cond == 0 { return; }
  }
  c: [1] RsCreature; c[0] = b[0].c[j];
  rs_effect_add(c[..], f);
  b[0].c[j] = c[0];
}
// Uses up EF_WEAK on i (its next attack roll has Disadvantage); true when there was one.
rs_take_weak :: (b: [] RsBattle, i: int) -> bool {
  for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind == EF_WEAK { rs_drop_effect(b, i, k); return true; } }
  return false;
}
// When the caster's next turn ends, and when it starts (its turns are instants on the clock).
rs_after_next_turn :: (b: [] RsBattle, i: int) -> f32 { return b[0].c[i].turn_at + rs_beat(b) + 0.05; }
rs_before_next_turn :: (b: [] RsBattle, i: int) -> f32 { return b[0].c[i].turn_at + rs_beat(b) - 0.01; }

// Concentration ends: its areas go, and what they held is let go.
rs_end_concentration :: (b: [] RsBattle, i: int, why: string) {
  sp := b[0].c[i].conc;
  if sp < 0 { return; }
  for k: 0..<RS_ZONES {
    if b[0].zone[k].on && b[0].zone[k].by == i && b[0].zone[k].spell == sp {
      b[0].zone[k].on = false;
      for j: 0..<b[0].n {
        if b[0].c[j].restrained_by == k { b[0].c[j].restrained_by = -1; b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_RESTRAINED); }
      }
    }
  }
  for j: 0..<b[0].n {
    if b[0].c[j].outlined_by == i { b[0].c[j].outlined_by = -1; b[0].c[j].outlined_until = 0; }
    for k: 0..<RS_EFFECTS {
      if b[0].c[j].eff[k].kind != EF_NONE && b[0].c[j].eff[k].by == i && b[0].c[j].eff[k].spell == sp { rs_drop_effect(b, j, k); }
    }
  }
  b[0].c[i].conc = -1;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], "'s "); rs_add_text(l[..], rs_spell(sp).name); rs_add_text(l[..], " ends"); rs_add_text(l[..], why);
  rs_tell(b, RS_EV_END, sp, i, -1, 0, 0, l[..]);
}
// What follows a creature dropping to 0: a Hex on it can move on a later turn, and a Fiend
// Warlock who dropped it, or stands within 10 feet of it, has Dark One's Blessing.
rs_dropped :: (b: [] RsBattle, by: int, j: int) {
  for k: 0..<b[0].n {
    c := b[0].c[k];
    for e: 0..<RS_EFFECTS {
      ek := b[0].c[j].eff[e].kind;
      if b[0].c[j].eff[e].by == k && ((ek == EF_HEX && c.conc == SP_HEX) || (ek == EF_MARK && c.conc == SP_HUNTERS_MARK)) {
        b[0].c[k].hex_free = true;
        b[0].c[k].hex_free_after = ifx b[0].who == k then c.turn_at else c.turn_at - rs_beat(b);
      }
    }
    if !c.dark_blessing || !rs_up(c) || c.team == b[0].c[j].team { continue; }
    if k != by && rs_feet_to(b, k, j) > 10 { continue; }
    gain := rs_max(rs_mod(c.score[RS_CHA]) + c.level, 1);
    if gain <= c.temp { continue; }
    b[0].c[k].temp = gain;
    l: [1] RsLine;
    rs_add_name(l[..], b, k); rs_add_text(l[..], " has Dark One's Blessing: "); rs_add_int(l[..], gain); rs_add_text(l[..], " Temporary Hit Points");
    rs_tell(b, RS_EV_HEAL, -1, k, k, gain, 0, l[..]);
  }
}
// Damage, with dropping to 0 and the concentration save the SRD calls for.
rs_damage :: (b: [] RsBattle, by: int, j: int, amount: int, kind: int, crit: bool, spell: int) {
  hurt: [1] RsCreature; hurt[0] = b[0].c[j];
  r := rs_hurt(hurt[..], amount, crit);
  b[0].c[j] = hurt[0];
  // Turn Undead ends early on a creature that takes any damage
  if r.taken > 0 {
    for k: 0..<RS_EFFECTS {
      if b[0].c[j].eff[k].kind == EF_TURNED {
        rs_drop_effect(b, j, k);
        if !b[0].c[j].dead { l: [1] RsLine; rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is no longer turned"); rs_tell(b, RS_EV_END, -1, by, j, 0, 0, l[..]); }
      }
    }
  }
  if r.dropped || r.killed {
    l: [1] RsLine;
    rs_add_name(l[..], b, j); rs_add_text(l[..], ifx r.killed then " dies" else " drops to 0 Hit Points");
    rs_tell(b, ifx r.killed then RS_EV_DEATH else RS_EV_DOWN, spell, by, j, 0, 0, l[..]);
    rs_end_concentration(b, j, " (Unconscious)");
    rs_release_turned(b, j);
    if r.dropped { rs_dropped(b, by, j); }
    return;
  }
  if r.conc_dc > 0 && b[0].c[j].conc >= 0 {
    roll := rs_roll(b[0].dice[..], 20); total := roll + rs_save_bonus(b[0].c[j], RS_CON);
    if total < r.conc_dc {
      l: [1] RsLine;
      rs_add_text(l[..], " (Con save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], r.conc_dc); rs_add_text(l[..], ")");
      why := cast(string) l[0].buf[0..<l[0].n];
      rs_end_concentration(b, j, why);
    }
  }
}

// ---- casting

RS_NO :: 0; RS_OK :: 1;
// Whether a spell's program follows a weapon hit (Divine Smite).
rs_is_smite :: (s: RsSpell) -> bool {
  for k: 0..<s.step_n { if s.steps[k].kind == RS_S_SMITE { return true; } }
  return false;
}
// A creature's spell save DC now: Innate Sorcery adds 1 while it lasts.
rs_dc :: (b: [] RsBattle, i: int) -> int { return rs_spell_dc(b[0].c[i]) + (ifx b[0].c[i].innate_until > b[0].clock then 1 else 0); }
// Armor Class now: Shield's +5 until the start of its next turn.
rs_ac :: (b: [] RsBattle, j: int) -> int { return b[0].c[j].ac + (ifx b[0].c[j].shield_until > b[0].clock then 5 else 0); }
// Whether creature i can cast spell sp with a slot of level `slot` now (0 for a cantrip, or for the
// spell its feature casts without a slot: Paladin's Smite, Favored Enemy). `quick` casts an action
// spell as a Bonus Action with Quickened Spell (2 Sorcery Points), not after a level 1+ spell this
// turn and with none after it.
rs_can_cast_as :: (b: [] RsBattle, i: int, sp: int, slot: int, quick: bool) -> bool {
  if i < 0 || i >= b[0].n || !rs_can_act(b[0].c[i]) || b[0].who != i || b[0].c[i].raging { return false; }
  s := rs_spell(sp);
  if s.cast_time == RS_T_REACTION { return false; }
  t := s.cast_time;
  if quick {
    if t != RS_T_ACTION || !b[0].c[i].quickened || b[0].c[i].uses[RS_USE_SORCERY] < 2 || b[0].turn.leveled || b[0].turn.quickened { return false; }
    t = RS_T_BONUS;
  }
  if t == RS_T_ACTION && b[0].turn.action { return false; }
  if t == RS_T_BONUS && b[0].turn.bonus { return false; }
  if s.part_of == SP_PRODUCE_FLAME && b[0].c[i].flame_until <= b[0].clock { return false; }
  if s.level > 0 {
    if b[0].turn.quickened { return false; }
    if slot == 0 {
      if b[0].c[i].free_spell != sp || b[0].c[i].uses[RS_USE_FREE] <= 0 { return false; }
    } else if slot < s.level || slot > 9 || b[0].c[i].slots[slot] <= 0 || b[0].turn.slot_spent { return false; }
  }
  return true;
}
rs_can_cast :: (b: [] RsBattle, i: int, sp: int, slot: int) -> bool { return rs_can_cast_as(b, i, sp, slot, false); }
// Cast spell sp with a slot of level `slot` (0 for a cantrip) at the point (tx, ty), on creature
// `target` for a spell with no area. False, and nothing spent, when it can't be cast so.
rs_cast :: (b: [] RsBattle, i: int, sp: int, slot: int, tx: int, ty: int, target: int) -> bool { return rs_cast_as(b, i, sp, slot, tx, ty, target, false); }
// The same with Quickened Spell: an action spell as a Bonus Action, for 2 Sorcery Points.
rs_cast_quick :: (b: [] RsBattle, i: int, sp: int, slot: int, tx: int, ty: int, target: int) -> bool { return rs_cast_as(b, i, sp, slot, tx, ty, target, true); }
rs_cast_as :: (b: [] RsBattle, i: int, sp: int, slot: int, tx: int, ty: int, target: int, quick: bool) -> bool {
  if !rs_can_cast_as(b, i, sp, slot, quick) { return false; }
  s := rs_spell(sp);
  me := b[0].c[i];
  smite := rs_is_smite(s);
  if s.area == RS_A_NONE {
    if target < 0 || target >= b[0].n || b[0].c[target].dead { return false; }
    if s.humanoid_only && !b[0].c[target].humanoid { return false; }
    if s.range_ft > 0 && rs_feet_to(b, i, target) > s.range_ft { return false; }
    // Divine Smite: right after a melee weapon hit on this target
    if smite && b[0].turn.last_hit != target + 1 { return false; }
  } else if s.area != RS_A_CUBE_SELF {
    if rs_feet(me.x, me.y, tx, ty) > s.range_ft { return false; }
  }
  // spend
  if s.cast_time == RS_T_ACTION && !quick { b[0].turn.action = true; } else { b[0].turn.bonus = true; }
  if quick { b[0].c[i].uses[RS_USE_SORCERY] -= 2; b[0].turn.quickened = true; }
  if s.level > 0 {
    b[0].turn.leveled = true;
    if slot > 0 { b[0].c[i].slots[slot] -= 1; b[0].turn.slot_spent = true; } else { b[0].c[i].uses[RS_USE_FREE] -= 1; }
  }
  if smite { b[0].turn.last_hit = 0; }
  if s.concentration { rs_end_concentration(b, i, ""); b[0].c[i].conc = sp; b[0].c[i].conc_until = b[0].clock + s.duration_s; }
  l: [1] RsLine;
  rs_add_name(l[..], b, i);
  rs_add_text(l[..], ifx s.part_of >= 0 then " hurls Produce Flame" else " casts ");
  if s.part_of < 0 { rs_add_text(l[..], s.name); }
  if s.level > 0 && slot > 0 { rs_add_text(l[..], " ("); rs_add_text(l[..], RS_ORDINAL[slot]); rs_add_text(l[..], "-level slot)"); }
  if s.level > 0 && slot == 0 { rs_add_text(l[..], " (without a slot)"); }
  if quick { rs_add_text(l[..], ", Quickened"); }
  if s.area == RS_A_NONE && target != i && (s.range_ft > 0 || smite) { rs_add_text(l[..], ifx smite then " on " else " at "); rs_add_name(l[..], b, target); }
  rs_tell(b, RS_EV_CAST, sp, i, ifx s.area == RS_A_NONE then target else -1, slot, 0, l[..]);
  // the area, and what lasts in it
  area: RsZone;
  zone_at := -1;
  if s.area != RS_A_NONE {
    area = rs_area(b, i, s, tx, ty);
    area.spell = sp;
    area.until = b[0].clock + s.duration_s;
    for k: 0..<s.step_n { if s.steps[k].kind == RS_S_TERRAIN { area.difficult = true; } }
    if s.duration_s > 0 {
      for k: 0..<RS_ZONES { if zone_at < 0 && !b[0].zone[k].on { zone_at = k; } }
      if zone_at >= 0 { b[0].zone[zone_at] = area; }
    }
    e: RsEvent; e.kind = RS_EV_ZONE; e.spell = sp; e.by = i; e.to = -1; e.x = area.x0; e.y = area.y0; e.amount = area.x1 - area.x0 + 1; e.at = b[0].clock;
    k := rs_emit(b[0].book[..], e);
  }
  for k: 0..<s.step_n { if s.steps[k].kind == RS_S_FLAME { b[0].c[i].flame_until = b[0].clock + s.duration_s; } }
  // rays and beams: the program runs once for each, at the one target
  reps := 1;
  for k: 0..<s.step_n {
    st := s.steps[k];
    if st.kind == RS_S_REPEAT { reps = st.a + st.b * rs_max(slot - s.level, 0); if st.c == 1 { reps = st.a * rs_cantrip_tier(me.level); } }
  }
  if s.area == RS_A_NONE && reps > 1 {
    for r: 0..<reps { if !b[0].c[target].dead { rs_affect(b, i, target, sp, slot, zone_at); } }
    return true;
  }
  // each creature it affects
  for j: 0..<b[0].n {
    if s.area == RS_A_NONE {
      if j != target { continue; }
    } else {
      if !rs_inside(area, b[0].c[j].x, b[0].c[j].y) || b[0].c[j].dead { continue; }
      if j == i { continue; }   // "each creature (other than you)"; a cube from you starts beside you
    }
    rs_affect(b, i, j, sp, slot, zone_at);
  }
  return true;
}

// ---- attack rolls, and what can change one after the dice

// Shield (p. 161): a Reaction when it is hit by an attack roll, +5 AC until the start of its next
// turn, including against the triggering attack; its lowest free slot.
rs_shield :: (b: [] RsBattle, j: int) -> bool {
  c := b[0].c[j];
  if !c.shield_spell || c.reacted || !rs_can_act(c) || c.raging { return false; }
  slot := 0;
  for k: 1..<10 { if slot == 0 && c.slots[k] > 0 { slot = k; } }
  if slot == 0 { return false; }
  b[0].c[j].slots[slot] -= 1; b[0].c[j].reacted = true;
  b[0].c[j].shield_until = ifx b[0].who == j then c.turn_at + rs_beat(b) else c.turn_at;
  l: [1] RsLine;
  rs_add_name(l[..], b, j); rs_add_text(l[..], " casts Shield ("); rs_add_text(l[..], RS_ORDINAL[slot]); rs_add_text(l[..], "-level slot): AC ");
  rs_add_int(l[..], c.ac + 5);
  rs_tell(b, RS_EV_CAST, SP_SHIELD, j, j, slot, 0, l[..]);
  return true;
}
// Cutting Words (College of Lore, p. 35): a Bard within 60 feet of an enemy's successful attack roll
// spends a Reaction and a Bardic Inspiration use and subtracts its die from the roll; it does so
// only when the die could turn the hit (by `margin`, the roll over the AC). The amount taken off.
rs_cutting_words :: (b: [] RsBattle, i: int, margin: int) -> int {
  for k: 0..<b[0].n {
    c := b[0].c[k];
    if !c.cutting || c.team == b[0].c[i].team || c.reacted || !rs_can_act(c) || c.uses[RS_USE_INSPIRE] <= 0 { continue; }
    if margin >= c.insp_die || rs_feet_to(b, k, i) > 60 { continue; }
    b[0].c[k].reacted = true; b[0].c[k].uses[RS_USE_INSPIRE] -= 1;
    cut := rs_roll(b[0].dice[..], c.insp_die);
    l: [1] RsLine;
    rs_add_name(l[..], b, k); rs_add_text(l[..], " mocks "); rs_add_name(l[..], b, i); rs_add_text(l[..], " with Cutting Words: -"); rs_add_int(l[..], cut);
    rs_tell(b, RS_EV_CONDITION, -1, k, i, cut, 0, l[..]);
    return cut;
  }
  return 0;
}
// A Bardic Inspiration die a creature holds, rolled on a failed D20 Test of `total` against `need`:
// the number it adds (0 when it holds none or did not fail).
rs_inspired_roll :: (b: [] RsBattle, j: int, total: int, need: int) -> int {
  if b[0].c[j].inspired <= 0 || total >= need { return 0; }
  add := rs_roll(b[0].dice[..], b[0].c[j].inspired);
  b[0].c[j].inspired = 0;
  return add;
}
// One attack roll by i at j: the d20 with `edge`, `bonus`, a Critical Hit from `crit_min` up. A
// missed spell attack can reroll with Seeking Spell (a Sorcery Point); a miss adds a held Bardic
// Inspiration die; a hit can be cut by an enemy Bard's Cutting Words, or turned by Shield.
RsAttackRoll :: struct { roll: int; edge: int; total: int; hit: bool; crit: bool; insp: int; seek: bool; cut: int; shield: bool; ac: int; }
rs_roll_attack :: (b: [] RsBattle, i: int, j: int, edge: int, bonus: int, crit_min: int, spell: bool) -> RsAttackRoll {
  r: RsAttackRoll;
  d := rs_d20(b[0].dice[..], edge);
  r.roll = d.roll; r.edge = d.edge;
  r.ac = rs_ac(b, j);
  if spell && b[0].c[i].seeking && b[0].c[i].uses[RS_USE_SORCERY] > 0 && r.roll < crit_min && (r.roll == 1 || r.roll + bonus < r.ac) {
    b[0].c[i].uses[RS_USE_SORCERY] -= 1; r.seek = true;
    r.roll = rs_roll(b[0].dice[..], 20);
  }
  r.crit = r.roll >= crit_min;
  r.total = r.roll + bonus;
  r.hit = r.roll != 1 && (r.crit || r.total >= r.ac);
  if !r.hit && r.roll != 1 { r.insp = rs_inspired_roll(b, i, r.total, r.ac); r.total += r.insp; r.hit = r.total >= r.ac; }
  if r.hit && !r.crit { r.cut = rs_cutting_words(b, i, r.total - r.ac); r.total -= r.cut; r.hit = r.total >= r.ac; }
  if r.hit && !r.crit && r.total < r.ac + 5 && rs_shield(b, j) { r.shield = true; r.hit = false; r.ac += 5; }
  return r;
}
// The roll's line: "12 + 5 + 3 Inspiration - 2 Cutting Words = 18 vs AC 15".
rs_add_roll :: (l: [] RsLine, r: RsAttackRoll, bonus: int) {
  rs_add_int(l, r.roll);
  if r.edge > 0 { rs_add_text(l, " (Advantage)"); }
  if r.edge < 0 { rs_add_text(l, " (Disadvantage)"); }
  if r.seek { rs_add_text(l, " (Seeking Spell)"); }
  rs_add_text(l, " + "); rs_add_int(l, bonus);
  if r.insp > 0 { rs_add_text(l, " + "); rs_add_int(l, r.insp); rs_add_text(l, " Inspiration"); }
  if r.cut > 0 { rs_add_text(l, " - "); rs_add_int(l, r.cut); rs_add_text(l, " Cutting Words"); }
  rs_add_text(l, " = "); rs_add_int(l, r.total);
  rs_add_text(l, " vs AC "); rs_add_int(l, r.ac);
  if r.shield { rs_add_text(l, " (Shield)"); }
}

// Advantage (1), Disadvantage (-1) or neither on i's attack roll against j: every source the SRD
// names for what the battle tracks, cancelling as the SRD says. Uses up a pending EF_WEAK.
rs_attack_edge :: (b: [] RsBattle, i: int, j: int, melee: bool, strength: bool) -> int {
  ups := 0; downs := 0;
  t := b[0].clock;
  if b[0].c[j].outlined_by >= 0 && b[0].c[j].outlined_until > t { ups += 1; }
  if rs_has(b[0].c[j], RS_RESTRAINED) { ups += 1; }
  if rs_has(b[0].c[i], RS_RESTRAINED) { downs += 1; }
  if rs_has(b[0].c[i], RS_POISONED) { downs += 1; }
  if rs_has(b[0].c[i], RS_BLINDED) { downs += 1; }
  if rs_has(b[0].c[j], RS_BLINDED) { ups += 1; }
  if rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS) { ups += 1; }
  if rs_take_weak(b, i) { downs += 1; }
  if !melee && rs_threatened(b, i) { downs += 1; }
  if rs_has(b[0].c[j], RS_PRONE) { if melee && rs_feet_to(b, i, j) <= 5 { ups += 1; } else { downs += 1; } }
  // Reckless Attack: Advantage on its Strength attacks, and on attacks against it
  if b[0].c[j].reckless_until > t { ups += 1; }
  if strength && b[0].c[i].reckless_until > t { ups += 1; }
  // the Dodge action
  if b[0].c[j].dodge_until > t && rs_can_act(b[0].c[j]) { downs += 1; }
  // Frightened: Disadvantage on attack rolls (the source of its fear is always in sight here)
  if rs_has(b[0].c[i], RS_FRIGHTENED) { downs += 1; }
  // Guiding Bolt's light, Vex, and Steady Aim: each spent by this roll
  for k: 0..<RS_EFFECTS {
    if b[0].c[j].eff[k].kind == EF_EXPOSED { rs_drop_effect(b, j, k); ups += 1; break; }
  }
  for k: 0..<RS_EFFECTS {
    if b[0].c[i].eff[k].kind == EF_VEX && b[0].c[i].eff[k].cond == j { rs_drop_effect(b, i, k); ups += 1; break; }
  }
  if b[0].who == i && b[0].turn.aimed { b[0].turn.aimed = false; ups += 1; }
  return rs_edge(ups, downs);
}
// Rage's Resistance to Bludgeoning, Piercing and Slashing: half the damage, rounded down.
// Damage after Immunity (none), Resistance (half, rounded down) and Vulnerability (double):
// Rage gives Resistance to Bludgeoning, Piercing and Slashing.
rs_resisted :: (b: [] RsBattle, j: int, amount: int, kind: int) -> int {
  c := b[0].c[j];
  bit := 1 << kind;
  if (c.immune & bit) != 0 { return 0; }
  a := amount;
  if (c.resist & bit) != 0 || (c.raging && (kind == RS_BLUDGEONING || kind == RS_PIERCING || kind == RS_SLASHING)) { a = a / 2; }
  if (c.vulnerable & bit) != 0 { a = a * 2; }
  return a;
}

// Advantage or Disadvantage on j's saving throw of an ability.
rs_save_edge :: (b: [] RsBattle, j: int, ability: int) -> int {
  ups := 0; downs := 0;
  c := b[0].c[j];
  if ability == RS_DEX && rs_has(c, RS_RESTRAINED) { downs += 1; }
  if ability == RS_STR && rs_effect(c, EF_ENFEEBLED) { downs += 1; }
  if ability == RS_STR && c.raging { ups += 1; }
  if ability == RS_DEX && c.danger_sense && !rs_has(c, RS_INCAPACITATED) && rs_can_act(c) { ups += 1; }
  if ability == RS_DEX && c.dodge_until > b[0].clock && rs_can_act(c) { ups += 1; }
  return rs_edge(ups, downs);
}

// The effect program on one creature.
rs_affect :: (b: [] RsBattle, i: int, j: int, sp: int, slot: int, zone_at: int) {
  s := rs_spell(sp);
  ran_save := false; saved := false; crit := false; attack_hit := false; tier_dice := true; potent_miss := false; bane := 0;
  for k: 0..<s.step_n { if s.steps[k].kind == RS_S_REPEAT && s.steps[k].c == 1 { tier_dice = false; } }
  for k: 0..<s.step_n {
    st := s.steps[k];
    if potent_miss && st.kind != RS_S_DAMAGE { continue; }
    if st.kind == RS_S_ATTACK {
      melee := st.a == 1;
      helpless := rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS);
      edge := rs_attack_edge(b, i, j, melee, false);
      // Innate Sorcery: Advantage on the attack rolls of its spells (any Disadvantage cancels it)
      if b[0].c[i].innate_until > b[0].clock { edge = ifx edge < 0 then 0 else 1; }
      bonus := rs_spell_attack(b[0].c[i]);
      r := rs_roll_attack(b, i, j, edge, bonus, 20, true);
      crit = r.crit;
      hit := r.hit;
      // a hit on a Paralyzed or Unconscious creature from within 5 feet is a Critical Hit
      if hit && helpless && rs_feet_to(b, i, j) <= 5 { crit = true; }
      attack_hit = hit;
      l: [1] RsLine;
      rs_add_text(l[..], "  attack "); rs_add_roll(l[..], r, bonus);
      rs_add_text(l[..], ifx crit then ": critical hit" else ifx hit then ": hit" else ": miss");
      // Potent Cantrip: a missed cantrip still deals half its damage, and nothing more
      if !hit && b[0].c[i].potent && s.level == 0 { potent_miss = true; rs_add_text(l[..], " (Potent Cantrip: half damage)"); }
      rs_tell(b, ifx hit then RS_EV_ATTACK else RS_EV_MISS, sp, i, j, r.total, 0, l[..]);
      if !hit && !potent_miss { return; }
    } else if st.kind == RS_S_SAVE {
      ran_save = true;
      dc := rs_dc(b, i);
      fails := (rs_has(b[0].c[j], RS_UNCONSCIOUS) || rs_has(b[0].c[j], RS_PARALYZED)) && (st.a == RS_STR || st.a == RS_DEX);
      d := rs_d20(b[0].dice[..], rs_save_edge(b, j, st.a));
      total := d.roll + rs_save_bonus(b[0].c[j], st.a);
      insp := ifx fails then 0 else rs_inspired_roll(b, j, total, dc);
      total += insp;
      saved = !fails && total >= dc;
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " ");
      rs_add_text(l[..], RS_ABBR[st.a]); rs_add_text(l[..], " save ");
      if fails { rs_add_text(l[..], ifx rs_has(b[0].c[j], RS_PARALYZED) then "fails (Paralyzed)" else "fails (Unconscious)"); }
      else {
        rs_add_int(l[..], total); if insp > 0 { rs_add_text(l[..], " ("); rs_add_int(l[..], insp); rs_add_text(l[..], " Inspiration)"); }
        rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc); rs_add_text(l[..], ifx saved then ": success" else ": failure");
      }
      rs_tell(b, RS_EV_SAVE, sp, i, j, total, 0, l[..]);
    } else if st.kind == RS_S_DAMAGE {
      count := st.a;
      if s.level == 0 && tier_dice { count = st.a * rs_cantrip_tier(b[0].c[i].level); }
      else { count += st.d * rs_max(slot - s.level, 0); }
      count += bane;
      if crit { count *= 2; }
      amount := rs_sum(b[0].dice[..], count, st.b);
      // a save halves or stops the damage; for an Evoker's cantrip (Potent Cantrip) it halves it
      if ran_save && saved {
        half := (s.steps[0].kind == RS_S_SAVE && s.steps[0].b == RS_ON_SAVE_HALF) || (b[0].c[i].potent && s.level == 0);
        amount = ifx half then amount / 2 else 0;
      }
      if potent_miss { amount = amount / 2; }
      // Agonizing Blast: the Charisma modifier on the chosen cantrip's damage
      agony := 0;
      if s.level == 0 && b[0].c[i].agonizing == sp && sp != SP_PRODUCE_FLAME { agony = rs_mod(b[0].c[i].score[RS_CHA]); amount += agony; }
      weak := 0;
      if rs_effect(b[0].c[i], EF_ENFEEBLED) { weak = rs_roll(b[0].dice[..], 8); amount = rs_max(amount - weak, 0); }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " takes "); rs_add_int(l[..], amount);
      rs_add_text(l[..], " "); rs_add_text(l[..], RS_DAMAGE[st.c]);
      rs_add_text(l[..], " ("); rs_add_int(l[..], count); rs_add_text(l[..], "d"); rs_add_int(l[..], st.b);
      if agony != 0 { rs_add_text(l[..], " + "); rs_add_int(l[..], agony); }
      if weak > 0 { rs_add_text(l[..], ", -"); rs_add_int(l[..], weak); rs_add_text(l[..], " enfeebled"); }
      rs_add_text(l[..], ")");
      if rs_resisted(b, j, amount, st.c) != amount {
        after := rs_resisted(b, j, amount, st.c);
        rs_add_text(l[..], ifx after == 0 then ", immune" else ifx after > amount then ", vulnerable" else ", resisted");
        amount = after;
      }
      rs_tell(b, RS_EV_DAMAGE, sp, i, j, amount, st.c, l[..]);
      rs_damage(b, i, j, amount, st.c, crit, sp);
      // Hex and Hunter's Mark: 1d6 more when their caster hits the target with an attack roll
      if attack_hit { rs_curse_damage(b, i, j, crit); }
    } else if st.kind == RS_S_HEAL {
      count := st.a + st.d * rs_max(slot - s.level, 0);
      amount := rs_sum(b[0].dice[..], count, st.b);
      if st.c == 1 { amount += rs_mod(b[0].c[i].score[rs_max(b[0].c[i].spell_ability, 0)]); }
      // Disciple of Life: 2 + the slot's level more from a spell cast with a slot
      disciple := ifx b[0].c[i].disciple && s.level > 0 && slot > 0 then 2 + slot else 0;
      amount += disciple;
      was_down := b[0].c[j].hp == 0;
      h: [1] RsCreature; h[0] = b[0].c[j];
      got := rs_heal(h[..], amount);
      b[0].c[j] = h[0];
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " regains "); rs_add_int(l[..], got); rs_add_text(l[..], " Hit Points");
      if disciple > 0 { rs_add_text(l[..], " (Disciple of Life +"); rs_add_int(l[..], disciple); rs_add_text(l[..], ")"); }
      if was_down && b[0].c[j].hp > 0 { rs_add_text(l[..], " and wakes"); }
      if rs_effect(b[0].c[j], EF_NOHEAL) { rs_add_text(l[..], ": the grave's chill stops it"); }
      rs_tell(b, RS_EV_HEAL, sp, i, j, got, 0, l[..]);
    } else if st.kind == RS_S_CONDITION {
      if ran_save && saved { continue; }
      if (b[0].c[j].immune_cond & st.a) != 0 { continue; }
      b[0].c[j].cond = b[0].c[j].cond | st.a;
      if st.a == RS_RESTRAINED { b[0].c[j].restrained_by = zone_at; }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is ");
      rs_add_text(l[..], rs_condition_name(st.a));
      rs_tell(b, RS_EV_CONDITION, sp, i, j, st.a, 0, l[..]);
    } else if st.kind == RS_S_PUSH {
      if ran_save && saved { continue; }
      if !rs_up(b[0].c[j]) && b[0].c[j].dead { continue; }
      dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
      moved := 0;
      for n: 0..<(st.a / RS_SQUARE) {
        nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
        if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
        b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
      }
      if moved > 0 {
        l: [1] RsLine;
        rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is pushed "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
        rs_tell(b, RS_EV_PUSH, sp, i, j, moved * RS_SQUARE, 0, l[..]);
      }
    } else if st.kind == RS_S_OUTLINE {
      if ran_save && saved { continue; }
      b[0].c[j].outlined_by = i; b[0].c[j].outlined_until = b[0].c[i].conc_until;
      b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_INVISIBLE);
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is outlined: attacks against it have Advantage");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_TEMP {
      amount := rs_sum(b[0].dice[..], st.a, st.b) + st.c + st.d * rs_max(slot - s.level, 0);
      // Temporary Hit Points don't add up: keep the larger
      b[0].c[j].temp = rs_max(b[0].c[j].temp, amount);
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " gains "); rs_add_int(l[..], amount); rs_add_text(l[..], " Temporary Hit Points");
      rs_tell(b, RS_EV_HEAL, sp, i, j, amount, 0, l[..]);
    } else if st.kind == RS_S_NOHEAL {
      rs_put_effect(b, j, RsEffect.{kind = EF_NOHEAL, by = i, spell = sp, until = rs_after_next_turn(b, i), save = -1, dc = 0});
    } else if st.kind == RS_S_TIMED {
      // saved: a one-target concentration spell has nothing to hold, and ends
      if ran_save && saved { if s.concentration && s.area == RS_A_NONE && b[0].c[i].conc == sp { b[0].c[i].conc = -1; } continue; }
      e := RsEffect.{kind = EF_COND, cond = st.a, by = i, spell = sp, until = rs_after_next_turn(b, i), save = -1, dc = 0};
      if st.b == 2 { e.until = b[0].clock + s.duration_s; e.save = st.c; e.dc = rs_dc(b, i); }
      rs_put_effect(b, j, e);
      // Paralyzed (and so Incapacitated) breaks the target's own concentration, and lets go what it turned
      if (st.a & (RS_PARALYZED | RS_INCAPACITATED | RS_STUNNED)) != 0 {
        if b[0].c[j].conc >= 0 { rs_end_concentration(b, j, " (Incapacitated)"); }
        rs_release_turned(b, j);
      }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is "); rs_add_text(l[..], rs_condition_name(st.a));
      rs_add_text(l[..], ifx st.b == 1 then " until the end of " else " for up to a minute");
      if st.b == 1 { rs_add_name(l[..], b, i); rs_add_text(l[..], "'s next turn"); }
      rs_tell(b, RS_EV_CONDITION, sp, i, j, st.a, 0, l[..]);
    } else if st.kind == RS_S_ENFEEBLE {
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j);
      if saved {
        rs_put_effect(b, j, RsEffect.{kind = EF_WEAK, by = i, spell = sp, until = rs_before_next_turn(b, i), save = -1, dc = 0});
        rs_add_text(l[..], " shrugs it off: Disadvantage on its next attack roll");
        // nothing to hold: the spell ends
        if b[0].c[i].conc == sp { b[0].c[i].conc = -1; }
      } else {
        rs_put_effect(b, j, RsEffect.{kind = EF_ENFEEBLED, by = i, spell = sp, until = b[0].clock + s.duration_s, save = RS_CON, dc = rs_dc(b, i)});
        rs_add_text(l[..], " is enfeebled: 1d8 off its damage, Disadvantage on Strength");
      }
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_HEX {
      rs_put_effect(b, j, RsEffect.{kind = EF_HEX, cond = st.a, by = i, spell = sp, until = b[0].c[i].conc_until, save = -1, dc = 0});
      b[0].c[i].hex_free = false;
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is hexed: 1d6 Necrotic more from each of ");
      rs_add_name(l[..], b, i); rs_add_text(l[..], "'s hits, Disadvantage on "); rs_add_text(l[..], RS_ABBR[st.a]); rs_add_text(l[..], " checks");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_GLOW {
      b[0].c[j].wisp_until = b[0].c[i].turn_at + rs_beat(b);
      b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_INVISIBLE);
    } else if st.kind == RS_S_EXPOSE {
      rs_put_effect(b, j, RsEffect.{kind = EF_EXPOSED, by = i, spell = sp, until = rs_after_next_turn(b, i), save = -1, dc = 0});
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " glimmers: the next attack roll against it has Advantage");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_MOCK {
      if ran_save && saved { continue; }
      rs_put_effect(b, j, RsEffect.{kind = EF_WEAK, by = i, spell = sp, until = rs_own_turn_end(b, j), save = -1, dc = 0});
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " has Disadvantage on its next attack roll");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_SMITE {
      crit = b[0].turn.last_crit;
      if b[0].c[j].undead { bane = st.a; }
    } else if st.kind == RS_S_MARK {
      rs_put_effect(b, j, RsEffect.{kind = EF_MARK, by = i, spell = sp, until = b[0].c[i].conc_until, save = -1, dc = 0});
      b[0].c[i].hex_free = false;
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is marked: 1d6 Force more from each of ");
      rs_add_name(l[..], b, i); rs_add_text(l[..], "'s hits");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    }
  }
  // Repelling Blast: a hit with the chosen cantrip pushes the target up to 10 feet straight away
  if attack_hit && s.level == 0 && b[0].c[i].repelling == sp && sp != SP_PRODUCE_FLAME && !b[0].c[j].dead {
    dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
    moved := 0;
    for n: 0..<2 {
      nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
      if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
      b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
    }
    if moved > 0 {
      l: [1] RsLine;
      rs_add_text(l[..], "  Repelling Blast pushes "); rs_add_name(l[..], b, j); rs_add_text(l[..], " "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
      rs_tell(b, RS_EV_PUSH, sp, i, j, moved * RS_SQUARE, 0, l[..]);
    }
  }
}

// Hex or Hunter's Mark moves to a new creature: a Bonus Action on a turn after the one its target
// dropped to 0 Hit Points, while the caster still concentrates on it; no slot.
rs_hex_move :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) { return false; }
  sp := b[0].c[i].conc;
  if (sp != SP_HEX && sp != SP_HUNTERS_MARK) || !b[0].c[i].hex_free || b[0].c[i].turn_at <= b[0].c[i].hex_free_after { return false; }
  if j < 0 || j >= b[0].n || !rs_up(b[0].c[j]) || rs_feet_to(b, i, j) > rs_spell(sp).range_ft { return false; }
  kind := ifx sp == SP_HEX then EF_HEX else EF_MARK;
  ability := RS_STR;
  for jj: 0..<b[0].n {
    for k: 0..<RS_EFFECTS {
      if b[0].c[jj].eff[k].kind == kind && b[0].c[jj].eff[k].by == i { ability = b[0].c[jj].eff[k].cond; rs_drop_effect(b, jj, k); }
    }
  }
  b[0].turn.bonus = true;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " moves "); rs_add_text(l[..], rs_spell(sp).name); rs_add_text(l[..], " to "); rs_add_name(l[..], b, j);
  rs_tell(b, RS_EV_CAST, sp, i, j, 0, 0, l[..]);
  rs_put_effect(b, j, RsEffect.{kind = kind, cond = ability, by = i, spell = sp, until = b[0].c[i].conc_until, save = -1, dc = 0});
  b[0].c[i].hex_free = false;
  return true;
}

// A Restrained creature's action against what holds it: a Strength (Athletics) check against the
// caster's spell save DC (Entangle).
rs_escape :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_has(b[0].c[i], RS_RESTRAINED) { return false; }
  z := b[0].c[i].restrained_by;
  if z < 0 || !b[0].zone[z].on { return false; }
  b[0].turn.action = true;
  dc := rs_spell_dc(b[0].c[b[0].zone[z].by]);
  downs := ifx rs_has(b[0].c[i], RS_POISONED) || rs_effect(b[0].c[i], EF_ENFEEBLED) then 1 else 0;
  for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind == EF_HEX && b[0].c[i].eff[k].cond == RS_STR { downs += 1; } }
  // Rage and Remarkable Athlete (p. 49) give Advantage on Strength (Athletics) checks
  d := rs_d20(b[0].dice[..], rs_edge(ifx b[0].c[i].raging || b[0].c[i].athlete then 1 else 0, downs));
  total := d.roll + rs_mod(b[0].c[i].score[RS_STR]);
  total += rs_inspired_roll(b, i, total, dc);
  // Tactical Mind (p. 48): a failed check takes 1d10 from a Second Wind use, spent only if it succeeds
  mind := 0;
  if total < dc && b[0].c[i].tactical && b[0].c[i].uses[RS_USE_WIND] > 0 {
    mind = rs_roll(b[0].dice[..], 10);
    if total + mind >= dc { total += mind; b[0].c[i].uses[RS_USE_WIND] -= 1; } else { mind = 0; }
  }
  ok := total >= dc;
  if ok { b[0].c[i].restrained_by = -1; b[0].c[i].cond = rs_clear(b[0].c[i].cond, RS_RESTRAINED); }
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " strains against the plants: STR (Athletics) "); rs_add_int(l[..], total);
  if mind > 0 { rs_add_text(l[..], " (Tactical Mind +"); rs_add_int(l[..], mind); rs_add_text(l[..], ")"); }
  rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc); rs_add_text(l[..], ifx ok then ": free" else ": still held");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, total, 0, l[..]);
  return ok;
}

// Whether a creature can move: up, and not Paralyzed, Petrified, Stunned, Unconscious, Grappled or
// Restrained (an Incapacitated creature, a turned Undead, still moves).
rs_can_move :: (c: RsCreature) -> bool {
  return rs_up(c) && (c.cond & (RS_PARALYZED | RS_PETRIFIED | RS_STUNNED | RS_UNCONSCIOUS | RS_GRAPPLED | RS_RESTRAINED)) == 0;
}
// One square of movement: 5 feet, 10 into Difficult Terrain; none while Restrained or at 0, or
// after Steady Aim.
rs_step_to :: (b: [] RsBattle, i: int, x: int, y: int) -> bool {
  if b[0].who != i || !rs_can_move(b[0].c[i]) || b[0].turn.anchored { return false; }
  if rs_feet(b[0].c[i].x, b[0].c[i].y, x, y) != RS_SQUARE { return false; }
  if x < 0 || y < 0 || x >= b[0].w || y >= b[0].h || rs_at(b, x, y) >= 0 { return false; }
  cost := ifx rs_difficult(b, x, y) then 2 else 1;
  if b[0].turn.move_left < cost { return false; }
  b[0].turn.move_left -= cost; b[0].turn.moved = true;
  b[0].c[i].x = x; b[0].c[i].y = y;
  return true;
}

// The start of i's turn: what has run out ends, a creature at 0 makes its death saving throw, a
// Prone one stands (half its Speed).
rs_start_turn :: (b: [] RsBattle, i: int) {
  b[0].who = i;
  // a beat moves its share of a round's Speed (at least a square)
  // the Slow mastery: 10 feet less
  speed := b[0].c[i].speed - (ifx b[0].c[i].slowed_until > b[0].clock then 10 else 0);
  squares := rs_max(cast(int) (f32(rs_max(speed, 0) / RS_SQUARE) * rs_beat(b) / f32(RS_ROUND) + 0.5), ifx speed > 0 then 1 else 0);
  b[0].turn = RsTurn.{action = false, bonus = false, slot_spent = false, move_left = squares};
  b[0].turn.new_round = b[0].c[i].turn_at >= b[0].c[i].round_at - 0.01;
  if b[0].turn.new_round { b[0].c[i].round_at += f32(RS_ROUND); }
  b[0].c[i].reacted = false;
  if b[0].c[i].raging && !rs_can_act(b[0].c[i]) { rs_rage_end(b, i, " (Incapacitated)"); }
  if b[0].c[i].hp == 0 && !b[0].c[i].dead {
    if b[0].c[i].stable || !b[0].turn.new_round { return; }
    c: [1] RsCreature; c[0] = b[0].c[i];
    r := rs_death_save(b[0].dice[..], c[..]);
    b[0].c[i] = c[0];
    l: [1] RsLine;
    rs_add_name(l[..], b, i);
    if r == RS_DS_UP { rs_add_text(l[..], " rolls a 20 on a death save and is back up with 1 Hit Point"); }
    else if r == RS_DS_STABLE { rs_add_text(l[..], " is Stable (three death save successes)"); }
    else if r == RS_DS_DEAD { rs_add_text(l[..], " dies (three death save failures)"); }
    else { rs_add_text(l[..], ifx r == RS_DS_OK then " death save: success (" else " death save: failure (");
           rs_add_int(l[..], b[0].c[i].death_ok); rs_add_text(l[..], " of 3 successes, "); rs_add_int(l[..], b[0].c[i].death_fail); rs_add_text(l[..], " of 3 failures)"); }
    rs_tell(b, ifx r == RS_DS_DEAD then RS_EV_DEATH else ifx r == RS_DS_UP then RS_EV_UP else RS_EV_STABLE, -1, i, i, r, 0, l[..]);
    if r != RS_DS_UP { return; }
  }
  if rs_has(b[0].c[i], RS_PRONE) && rs_can_act(b[0].c[i]) {
    b[0].c[i].cond = rs_clear(b[0].c[i].cond, RS_PRONE);
    b[0].turn.move_left = b[0].turn.move_left / 2;
  }
}
rs_end_turn :: (b: [] RsBattle, i: int) {
  // the saves it repeats at the end of its turns
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.kind == EF_NONE || e.save < 0 || b[0].c[i].dead || !b[0].turn.new_round { continue; }
    d := rs_d20(b[0].dice[..], 0);
    total := d.roll + rs_save_bonus(b[0].c[i], e.save);
    total += rs_inspired_roll(b, i, total, e.dc);
    ok := total >= e.dc;
    l: [1] RsLine;
    rs_add_name(l[..], b, i); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[e.save]); rs_add_text(l[..], " save against ");
    rs_add_text(l[..], rs_spell(e.spell).name); rs_add_text(l[..], " "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], e.dc);
    rs_add_text(l[..], ifx ok then ": it ends" else ": it holds");
    rs_tell(b, RS_EV_SAVE, e.spell, e.by, i, total, 0, l[..]);
    if ok {
      rs_drop_effect(b, i, k);
      // a spell that ends on a success ends for its caster too (Ray of Enfeeblement)
      if e.kind == EF_ENFEEBLED && e.by >= 0 && b[0].c[e.by].conc == e.spell { rs_end_concentration(b, e.by, " (the target shook it off)"); }
      // a concentration spell with no one left under it ends (Hold Person on one target)
      if e.by >= 0 && b[0].c[e.by].conc == e.spell {
        left := 0;
        for jj: 0..<b[0].n { for kk: 0..<RS_EFFECTS { if b[0].c[jj].eff[kk].kind != EF_NONE && b[0].c[jj].eff[kk].by == e.by && b[0].c[jj].eff[kk].spell == e.spell { left += 1; } } }
        if left == 0 { rs_end_concentration(b, e.by, " (no one left under it)"); }
      }
    }
  }
  // Rage lasts until the end of its next turn; an attack roll against an enemy (or a Bonus Action)
  // in that turn extends it
  if b[0].turn.struck { b[0].c[i].struck_round = true; }
  if b[0].c[i].raging && b[0].turn.new_round {
    if b[0].c[i].rage_kept || b[0].c[i].struck_round { b[0].c[i].rage_kept = false; }
    else { rs_rage_end(b, i, ""); }
  }
  if b[0].turn.new_round { b[0].c[i].struck_round = false; }
  b[0].c[i].turn_at += rs_beat(b);
  if b[0].who == i { b[0].who = -1; }
}
// The clock moves on: what lasts for a time ends when it runs out.
rs_tick :: (b: [] RsBattle, dt: f32) {
  b[0].clock += dt;
  t := b[0].clock;
  for i: 0..<b[0].n {
    if b[0].c[i].conc >= 0 && b[0].c[i].conc_until <= t { rs_end_concentration(b, i, " (its duration is up)"); }
    if b[0].c[i].flame_until > 0 && b[0].c[i].flame_until <= t { b[0].c[i].flame_until = 0; }
    if b[0].c[i].outlined_by >= 0 && b[0].c[i].outlined_until <= t { b[0].c[i].outlined_by = -1; }
    for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind != EF_NONE && b[0].c[i].eff[k].until <= t { rs_drop_effect(b, i, k); } }
    // the action adapter: spent slots and uses come back on a cooldown, one at a time
    if b[0].recharge > 0 && !b[0].c[i].dead {
      r := b[0].recharge;
      for l: 1..<10 {
        if b[0].c[i].slots[l] >= b[0].c[i].slots_max[l] { b[0].c[i].slot_back[l] = 0; continue; }
        if b[0].c[i].slot_back[l] == 0 { b[0].c[i].slot_back[l] = t + r; }
        else if b[0].c[i].slot_back[l] <= t { b[0].c[i].slots[l] += 1; b[0].c[i].slot_back[l] = 0; }
      }
      if b[0].c[i].rages < b[0].c[i].rages_max {
        if b[0].c[i].rage_back == 0 { b[0].c[i].rage_back = t + r; }
        else if b[0].c[i].rage_back <= t { b[0].c[i].rages += 1; b[0].c[i].rage_back = 0; }
      } else { b[0].c[i].rage_back = 0; }
      if b[0].c[i].focus < b[0].c[i].focus_max {
        if b[0].c[i].focus_back == 0 { b[0].c[i].focus_back = t + r / 2; }
        else if b[0].c[i].focus_back <= t { b[0].c[i].focus += 1; b[0].c[i].focus_back = 0; }
      } else { b[0].c[i].focus_back = 0; }
      // the other classes' uses: one back at a time, points (Sorcery, Bardic Inspiration) and the
      // Lay On Hands pool (5 Hit Points a time) at half the cooldown
      for u: 0..<RS_USES {
        if b[0].c[i].uses[u] >= b[0].c[i].uses_max[u] { b[0].c[i].uses_back[u] = 0; continue; }
        quick := u == RS_USE_SORCERY || u == RS_USE_INSPIRE || u == RS_USE_LAY;
        if b[0].c[i].uses_back[u] == 0 { b[0].c[i].uses_back[u] = t + (ifx quick then r / 2 else r); }
        else if b[0].c[i].uses_back[u] <= t {
          b[0].c[i].uses[u] = rs_min(b[0].c[i].uses[u] + (ifx u == RS_USE_LAY then 5 else 1), b[0].c[i].uses_max[u]);
          b[0].c[i].uses_back[u] = 0;
        }
      }
    }
  }
}
rs_team_up :: (b: [] RsBattle, team: int) -> int {
  n := 0;
  for i: 0..<b[0].n { if b[0].c[i].team == team && rs_up(b[0].c[i]) { n += 1; } }
  return n;
}

// ---- weapons and martial features

rs_rage_end :: (b: [] RsBattle, i: int, why: string) {
  if !b[0].c[i].raging { return; }
  b[0].c[i].raging = false; b[0].c[i].rage_kept = false;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], "'s Rage ends"); rs_add_text(l[..], why);
  rs_tell(b, RS_EV_END, -1, i, -1, 0, 0, l[..]);
}
// Rage: a Bonus Action, one of its uses. While it lasts: Resistance to Bludgeoning, Piercing and
// Slashing, its Rage Damage on Strength attacks, Advantage on Strength checks and saves, no
// Concentration and no spells.
rs_rage :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].rages <= 0 || b[0].c[i].raging { return false; }
  b[0].turn.bonus = true;
  b[0].c[i].rages -= 1; b[0].c[i].raging = true; b[0].c[i].rage_kept = true;
  rs_end_concentration(b, i, " (Rage)");
  // Mindless Rage: a Charmed or Frightened condition on it ends
  if b[0].c[i].mindless {
    for k: 0..<RS_EFFECTS {
      ef := b[0].c[i].eff[k];
      if (ef.kind == EF_COND || ef.kind == EF_TURNED) && (ef.cond & (RS_CHARMED | RS_FRIGHTENED)) != 0 { rs_drop_effect(b, i, k); }
    }
  }
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " enters a Rage");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  return true;
}

// Hex and Hunter's Mark: 1d6 more (Necrotic, Force) when their caster i hits j with an attack roll.
rs_curse_damage :: (b: [] RsBattle, i: int, j: int, crit: bool) {
  mult := ifx crit then 2 else 1;
  for ek: 0..<RS_EFFECTS {
    e := b[0].c[j].eff[ek];
    if (e.kind != EF_HEX && e.kind != EF_MARK) || e.by != i || b[0].c[j].dead { continue; }
    kind := ifx e.kind == EF_HEX then RS_NECROTIC else RS_FORCE;
    sp := ifx e.kind == EF_HEX then SP_HEX else SP_HUNTERS_MARK;
    extra := rs_resisted(b, j, rs_sum(b[0].dice[..], mult, 6), kind);
    h: [1] RsLine;
    rs_add_text(h[..], "  "); rs_add_name(h[..], b, j); rs_add_text(h[..], " takes "); rs_add_int(h[..], extra);
    rs_add_text(h[..], ifx e.kind == EF_HEX then " Necrotic from Hex" else " Force from Hunter's Mark");
    rs_tell(b, RS_EV_DAMAGE, sp, i, j, extra, kind, h[..]);
    rs_damage(b, i, j, extra, kind, crit, sp);
  }
}
// The end of creature j's own next turn: the one running, or the one coming.
rs_own_turn_end :: (b: [] RsBattle, j: int) -> f32 {
  return ifx b[0].who == j then b[0].c[j].turn_at + rs_beat(b) + 0.05 else b[0].c[j].turn_at + 0.05;
}
// Whether i can use weapon w's mastery property m (Weapon Mastery).
rs_mastery :: (b: [] RsBattle, i: int, w: int, m: int) -> bool { return rs_weapon(w).mastery == m && (b[0].c[i].masteries & (1 << m)) != 0; }

// One attack roll with i's weapon at j, and its damage. `bare` drops the ability modifier from the
// damage (Cleave's second attack). Along the way: Improved Critical, Sacred Weapon, Sneak Attack,
// Colossus Slayer, the Berserker's Frenzy, Deflect Attacks, the Graze, Sap, Vex and Slow masteries,
// Hex and Hunter's Mark. True on a hit.
rs_strike :: (b: [] RsBattle, i: int, j: int, w: int, bare: bool) -> bool {
  wp := rs_weapon(w);
  me := b[0].c[i];
  ab := rs_attack_ability(me, w);
  strength := ab == RS_STR;
  b[0].turn.struck = true;
  melee := wp.range_ft <= 5;
  far := 0;
  if !melee && rs_feet_to(b, i, j) > wp.range_ft { far = -1; }   // long range: Disadvantage
  edge := rs_attack_edge(b, i, j, melee, strength);
  if far < 0 { edge = rs_edge(ifx edge > 0 then 1 else 0, 1 + (ifx edge < 0 then 1 else 0)); }
  bonus := rs_weapon_attack(me, w);
  // Sacred Weapon: its Charisma modifier (at least +1) on the attack rolls of a melee weapon
  sacred := melee && w != W_UNARMED && me.sacred_until > b[0].clock;
  if sacred { bonus += rs_max(rs_mod(me.score[RS_CHA]), 1); }
  // Improved Critical: weapons and Unarmed Strikes score a Critical Hit on 20 - crit_range or higher
  r := rs_roll_attack(b, i, j, edge, bonus, 20 - me.crit_range, false);
  crit := r.crit;
  hit := r.hit;
  if hit && melee && (rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS)) { crit = true; }
  // Divine Smite follows a hit with a Melee weapon or an Unarmed Strike
  b[0].turn.last_hit = ifx hit && melee then j + 1 else 0;
  b[0].turn.last_crit = crit;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], ifx melee then " attacks " else " shoots "); rs_add_name(l[..], b, j); rs_add_text(l[..], " with ");
  rs_add_text(l[..], ifx w == W_UNARMED then "an Unarmed Strike" else wp.name);
  rs_add_text(l[..], ": "); rs_add_roll(l[..], r, bonus);
  rs_add_text(l[..], ifx crit then ": critical hit" else ifx hit then ": hit" else ": miss");
  rs_tell(b, ifx hit then RS_EV_ATTACK else RS_EV_MISS, -1, i, j, r.total, 0, l[..]);
  if !hit {
    // Graze: a miss still deals the attack's ability modifier
    gm := rs_mod(me.score[ab]);
    if rs_mastery(b, i, w, M_GRAZE) && gm > 0 && !b[0].c[j].dead {
      g := rs_resisted(b, j, gm, wp.damage);
      gl: [1] RsLine;
      rs_add_text(gl[..], "  Graze: "); rs_add_name(gl[..], b, j); rs_add_text(gl[..], " takes "); rs_add_int(gl[..], g); rs_add_text(gl[..], " "); rs_add_text(gl[..], RS_DAMAGE[wp.damage]);
      rs_tell(b, RS_EV_DAMAGE, -1, i, j, g, wp.damage, gl[..]);
      rs_damage(b, i, j, g, wp.damage, false, -1);
    }
    return false;
  }
  tg := b[0].c[j];
  // the damage: the weapon's dice (a Monk's Martial Arts die unarmed; 1 + Strength for anyone else)
  ndice := wp.dice; sides := wp.sides;
  if w == W_UNARMED && me.martial_die > 0 { ndice = 1; sides = me.martial_die; }
  mult := ifx crit then 2 else 1;
  rolled := ifx ndice > 0 then rs_sum(b[0].dice[..], ndice * mult, sides) else 1;
  mod := rs_mod(me.score[ab]);
  amount := rolled;
  if !bare || mod < 0 { amount += mod; }
  rage := 0;
  if me.raging && strength { rage = me.rage_bonus; amount += rage; }
  frenzy := 0;
  if me.frenzy && me.raging && strength && me.reckless_until > b[0].clock && !b[0].turn.frenzied {
    b[0].turn.frenzied = true;
    frenzy = rs_sum(b[0].dice[..], me.rage_bonus * mult, 6); amount += frenzy;
  }
  // Sneak Attack: once a turn, with a Finesse or Ranged weapon, with Advantage, or with an ally
  // beside the target (not Incapacitated) and no Disadvantage
  sneak := 0;
  if me.sneak_dice > 0 && !b[0].turn.sneaked && (wp.finesse || !melee) && w != W_UNARMED {
    ally := false;
    for k: 0..<b[0].n {
      c := b[0].c[k];
      if k != i && c.team == me.team && rs_up(c) && !rs_has(c, RS_INCAPACITATED) && rs_feet_to(b, k, j) <= 5 { ally = true; }
    }
    if r.edge > 0 || (ally && r.edge >= 0) { b[0].turn.sneaked = true; sneak = rs_sum(b[0].dice[..], me.sneak_dice * mult, 6); amount += sneak; }
  }
  // Colossus Slayer: 1d8 more, once a turn, on a creature missing any of its Hit Points
  colossus := 0;
  if me.colossus && !b[0].turn.colossus && tg.hp < tg.hp_max && w != W_UNARMED {
    b[0].turn.colossus = true; colossus = rs_sum(b[0].dice[..], mult, 8); amount += colossus;
  }
  weak := 0;
  if rs_effect(me, EF_ENFEEBLED) { weak = rs_roll(b[0].dice[..], 8); amount = rs_max(amount - weak, 0); }
  amount = rs_max(amount, 0);
  // Sacred Weapon: its normal damage type or Radiant, whichever hurts more
  kind := wp.damage;
  if sacred && rs_resisted(b, j, amount, RS_RADIANT) > rs_resisted(b, j, amount, kind) { kind = RS_RADIANT; }
  dl: [1] RsLine;
  rs_add_text(dl[..], "  "); rs_add_name(dl[..], b, j); rs_add_text(dl[..], " takes ");
  // Deflect Attacks: a Monk's Reaction cuts Bludgeoning, Piercing or Slashing damage from a hit
  cut := 0;
  if tg.deflect && !tg.reacted && rs_can_act(tg) && (kind == RS_BLUDGEONING || kind == RS_PIERCING || kind == RS_SLASHING) {
    b[0].c[j].reacted = true;
    cut = rs_roll(b[0].dice[..], 10) + rs_mod(tg.score[RS_DEX]) + tg.level;
  }
  dealt := rs_max(amount - cut, 0);
  dealt = rs_resisted(b, j, dealt, kind);
  rs_add_int(dl[..], dealt); rs_add_text(dl[..], " "); rs_add_text(dl[..], RS_DAMAGE[kind]); rs_add_text(dl[..], " (");
  if ndice > 0 { rs_add_int(dl[..], ndice * mult); rs_add_text(dl[..], "d"); rs_add_int(dl[..], sides); } else { rs_add_text(dl[..], "1"); }
  if !bare || mod < 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], mod); }
  if rage > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], rage); rs_add_text(dl[..], " Rage"); }
  if frenzy > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], frenzy); rs_add_text(dl[..], " Frenzy"); }
  if sneak > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], sneak); rs_add_text(dl[..], " Sneak Attack"); }
  if colossus > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], colossus); rs_add_text(dl[..], " Colossus Slayer"); }
  if weak > 0 { rs_add_text(dl[..], ", -"); rs_add_int(dl[..], weak); rs_add_text(dl[..], " enfeebled"); }
  if cut > 0 { rs_add_text(dl[..], ", Deflect Attacks -"); rs_add_int(dl[..], cut); }
  if dealt != rs_max(amount - cut, 0) { rs_add_text(dl[..], ifx dealt == 0 then ", immune" else ifx dealt > amount - cut then ", vulnerable" else ", resisted"); }
  rs_add_text(dl[..], ")");
  rs_tell(b, RS_EV_DAMAGE, -1, i, j, dealt, kind, dl[..]);
  rs_damage(b, i, j, dealt, kind, crit, -1);
  // Hex and Hunter's Mark hold for any attack roll their caster hits with
  rs_curse_damage(b, i, j, crit);
  // the masteries that follow a hit: Sap (Disadvantage on its next attack roll before the start of
  // the attacker's next turn), Vex (Advantage on the attacker's next attack roll against it before
  // the end of its next turn), Slow (10 feet less Speed until the start of the attacker's next turn)
  if !b[0].c[j].dead && b[0].c[j].hp > 0 {
    if rs_mastery(b, i, w, M_SAP) {
      rs_put_effect(b, j, RsEffect.{kind = EF_WEAK, by = i, spell = -1, until = rs_before_next_turn(b, i), save = -1, dc = 0});
    }
    if rs_mastery(b, i, w, M_VEX) && dealt > 0 {
      rs_put_effect(b, i, RsEffect.{kind = EF_VEX, cond = j, by = i, spell = -1, until = rs_after_next_turn(b, i), save = -1, dc = 0});
    }
    if rs_mastery(b, i, w, M_SLOW) && dealt > 0 { b[0].c[j].slowed_until = rs_before_next_turn(b, i) + 0.01; }
  }
  // all damage cut away: the Monk may spend a Focus Point to send the force back at a melee attacker
  if cut > 0 && amount - cut <= 0 && b[0].c[j].focus > 0 && rs_up(b[0].c[j]) && rs_up(b[0].c[i]) {
    b[0].c[j].focus -= 1;
    sd := rs_d20(b[0].dice[..], rs_save_edge(b, i, RS_DEX));
    st := sd.roll + rs_save_bonus(b[0].c[i], RS_DEX);
    dc := rs_focus_dc(b[0].c[j]);
    rl: [1] RsLine;
    rs_add_name(rl[..], b, j); rs_add_text(rl[..], " redirects the blow: "); rs_add_name(rl[..], b, i);
    rs_add_text(rl[..], " DEX save "); rs_add_int(rl[..], st); rs_add_text(rl[..], " vs DC "); rs_add_int(rl[..], dc);
    if st >= dc { rs_add_text(rl[..], ": success"); rs_tell(b, RS_EV_SAVE, -1, j, i, st, 0, rl[..]); }
    else {
      back := rs_sum(b[0].dice[..], 2, b[0].c[j].martial_die) + rs_mod(b[0].c[j].score[RS_DEX]);
      rs_add_text(rl[..], ": failure, "); rs_add_int(rl[..], back); rs_add_text(rl[..], " "); rs_add_text(rl[..], RS_DAMAGE[kind]);
      rs_tell(b, RS_EV_DAMAGE, -1, j, i, back, kind, rl[..]);
      rs_damage(b, j, i, rs_resisted(b, i, back, kind), kind, false, -1);
    }
  }
  return true;
}

// The Attack action: one attack with its weapon at j (5 feet away). `reckless` attacks recklessly
// (a Barbarian's first attack in a turn); `cleave_to`, when the weapon's Cleave mastery applies, is
// a second creature within 5 feet of j and of the attacker (-1 none).
rs_attack :: (b: [] RsBattle, i: int, j: int, reckless: bool, cleave_to: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || j == i || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.action = true;
  w := b[0].c[i].weapon;
  if reckless && b[0].c[i].level >= 2 && b[0].c[i].klass == RS_BARBARIAN && b[0].c[i].reckless_until <= b[0].clock {
    b[0].c[i].reckless_until = rs_before_next_turn(b, i) + 0.01;
    l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " attacks recklessly");
    rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  }
  hit := rs_strike(b, i, j, w, false);
  wp := rs_weapon(w);
  k := cleave_to;
  if hit && wp.mastery == M_CLEAVE && (b[0].c[i].masteries & (1 << M_CLEAVE)) != 0 && !b[0].turn.cleaved && k >= 0 && k != j && k != i
     && !b[0].c[k].dead && b[0].c[k].team != b[0].c[i].team && rs_feet_to(b, i, k) <= 5 && rs_feet_to(b, j, k) <= 5 {
    b[0].turn.cleaved = true;
    l: [1] RsLine; rs_add_text(l[..], "  Cleave carries on into "); rs_add_name(l[..], b, k);
    rs_tell(b, RS_EV_CONDITION, -1, i, k, 0, 0, l[..]);
    ok := rs_strike(b, i, k, w, true);
  }
  rs_after_blow(b, i);
  // Extra Attack (p. 29, 48, 51, 55, 59): the Attack action's other attacks, at the same foe while
  // it stands, else another beside it
  for e: 0..<b[0].c[i].extra_attack {
    t := ifx rs_up(b[0].c[j]) then j else rs_beside(b, i);
    if t < 0 || !rs_can_act(b[0].c[i]) { break; }
    again := rs_strike(b, i, t, w, false);
    rs_after_blow(b, i);
  }
  return true;
}
// A foe standing within 5 feet of i, or -1.
rs_beside :: (b: [] RsBattle, i: int) -> int {
  for k: 0..<b[0].n {
    if k != i && rs_up(b[0].c[k]) && b[0].c[k].team != b[0].c[i].team && rs_feet_to(b, i, k) <= 5 { return k; }
  }
  return -1;
}
// After each attack: Remarkable Athlete (p. 49) moves half its Speed after a Critical Hit.
rs_after_blow :: (b: [] RsBattle, i: int) {
  if b[0].turn.last_crit && b[0].c[i].athlete && !b[0].turn.anchored { b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE / 2; b[0].turn.last_crit = false; }
}

// The Attack action with its ranged weapon, at j within its long range.
rs_shoot :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) || b[0].c[i].ranged < 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || j == i || rs_feet_to(b, i, j) > rs_weapon(b[0].c[i].ranged).long_ft { return false; }
  b[0].turn.action = true;
  ok := rs_strike(b, i, j, b[0].c[i].ranged, false);
  rs_after_blow(b, i);
  for e: 0..<b[0].c[i].extra_attack {
    if !rs_up(b[0].c[j]) || !rs_can_act(b[0].c[i]) { break; }
    again := rs_strike(b, i, j, b[0].c[i].ranged, false);
    rs_after_blow(b, i);
  }
  return true;
}

// Martial Arts: an Unarmed Strike as a Bonus Action.
rs_bonus_strike :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].martial_die <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.bonus = true;
  ok := rs_strike(b, i, j, W_UNARMED, false);
  return true;
}
// Open Hand Technique, on a creature hit by Flurry of Blows.
OH_ADDLE :: 0; OH_PUSH :: 1; OH_TOPPLE :: 2;
rs_open_hand :: (b: [] RsBattle, i: int, j: int, how: int) {
  if !b[0].c[i].open_hand || b[0].c[j].dead || b[0].c[j].hp == 0 { return; }
  l: [1] RsLine;
  if how == OH_ADDLE {
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is addled: no Opportunity Attacks until its next turn");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, 0, 0, l[..]);
    return;
  }
  ab := ifx how == OH_PUSH then RS_STR else RS_DEX;
  dc := rs_focus_dc(b[0].c[i]);
  fails := (rs_has(b[0].c[j], RS_UNCONSCIOUS) || rs_has(b[0].c[j], RS_PARALYZED));
  d := rs_d20(b[0].dice[..], rs_save_edge(b, j, ab));
  total := d.roll + rs_save_bonus(b[0].c[j], ab);
  saved := !fails && total >= dc;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[ab]); rs_add_text(l[..], " save ");
  rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
  if saved { rs_add_text(l[..], ": success"); rs_tell(b, RS_EV_SAVE, -1, i, j, total, 0, l[..]); return; }
  if how == OH_TOPPLE {
    b[0].c[j].cond = b[0].c[j].cond | RS_PRONE;
    rs_add_text(l[..], ": knocked Prone");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, RS_PRONE, 0, l[..]);
    return;
  }
  dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
  moved := 0;
  for n: 0..<3 {
    nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
    if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
    b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
  }
  rs_add_text(l[..], ": pushed "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
  rs_tell(b, RS_EV_PUSH, -1, i, j, moved * RS_SQUARE, 0, l[..]);
}
// Flurry of Blows: 1 Focus Point, two Unarmed Strikes as a Bonus Action; each hit can carry an
// Open Hand Technique.
rs_flurry :: (b: [] RsBattle, i: int, j: int, how: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.bonus = true; b[0].c[i].focus -= 1;
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Flurry of Blows");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  for k: 0..<2 {
    if b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { break; }
    if rs_strike(b, i, j, W_UNARMED, false) { rs_open_hand(b, i, j, how); }
  }
  return true;
}
// Patient Defense with a Focus Point: Disengage and Dodge as a Bonus Action.
rs_patient_defense :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus <= 0 { return false; }
  b[0].turn.bonus = true; b[0].c[i].focus -= 1;
  b[0].c[i].dodge_until = rs_before_next_turn(b, i);
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Patient Defense: Disengage and Dodge");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  return true;
}
// Step of the Wind without a Focus Point: Dash as a Bonus Action (its Speed again).
rs_step_of_the_wind :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus_max <= 0 { return false; }
  b[0].turn.bonus = true;
  b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE;
  return true;
}
// ---- the classes' features

// Who i has turned (Turn Undead) is let go: i dropped, or is Incapacitated.
rs_release_turned :: (b: [] RsBattle, i: int) {
  for j: 0..<b[0].n {
    for k: 0..<RS_EFFECTS { if b[0].c[j].eff[k].kind == EF_TURNED && b[0].c[j].eff[k].by == i { rs_drop_effect(b, j, k); } }
  }
}
// Who turned j (Turn Undead), or -1.
rs_turned_by :: (c: RsCreature) -> int {
  for k: 0..<RS_EFFECTS { if c.eff[k].kind == EF_TURNED { return c.eff[k].by; } }
  return -1;
}
// A creature's own Bonus Action feature may run: its turn, its Bonus Action free, able to act.
rs_bonus_free :: (b: [] RsBattle, i: int) -> bool { return b[0].who == i && !b[0].turn.bonus && rs_can_act(b[0].c[i]); }
rs_action_free :: (b: [] RsBattle, i: int) -> bool { return b[0].who == i && !b[0].turn.action && rs_can_act(b[0].c[i]); }
rs_say :: (b: [] RsBattle, kind: int, i: int, j: int, amount: int, t: string) {
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], t);
  rs_tell(b, kind, -1, i, j, amount, 0, l[..]);
}
// Healing from a feature (not a spell): the log line, and Hit Points back.
rs_feature_heal :: (b: [] RsBattle, i: int, j: int, amount: int, what: string) -> int {
  was_down := b[0].c[j].hp == 0;
  h: [1] RsCreature; h[0] = b[0].c[j];
  got := rs_heal(h[..], amount);
  b[0].c[j] = h[0];
  l: [1] RsLine;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " regains "); rs_add_int(l[..], got); rs_add_text(l[..], " Hit Points from "); rs_add_text(l[..], what);
  if was_down && b[0].c[j].hp > 0 { rs_add_text(l[..], " and wakes"); }
  rs_tell(b, RS_EV_HEAL, -1, i, j, got, 0, l[..]);
  return got;
}

// Bardic Inspiration (p. 31-32): a Bonus Action and one use; another creature within 60 feet gains
// the Bard's die, and adds it to a D20 Test it fails (one die at a time).
rs_inspire :: (b: [] RsBattle, i: int, j: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].insp_die <= 0 || b[0].c[i].uses[RS_USE_INSPIRE] <= 0 { return false; }
  if j < 0 || j >= b[0].n || j == i || !rs_up(b[0].c[j]) || b[0].c[j].inspired > 0 || rs_feet_to(b, i, j) > 60 { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_INSPIRE] -= 1;
  b[0].c[j].inspired = b[0].c[i].insp_die;
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " inspires "); rs_add_name(l[..], b, j); rs_add_text(l[..], ": a Bardic Inspiration d"); rs_add_int(l[..], b[0].c[i].insp_die);
  rs_tell(b, RS_EV_CONDITION, -1, i, j, 0, 0, l[..]);
  return true;
}

// Turn Undead (Channel Divinity, p. 37): a Magic action; each Undead foe within 30 feet makes a
// Wisdom save or is Frightened and Incapacitated for 1 minute, moving away; it ends early if the
// creature takes damage, or the Cleric is Incapacitated or dies.
rs_turn_undead :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].turn_undead || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  rs_say(b, RS_EV_CAST, i, -1, 0, " presents a holy symbol: Turn Undead");
  dc := rs_dc(b, i);
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if !c.undead || !rs_up(c) || c.team == b[0].c[i].team || rs_feet_to(b, i, j) > 30 { continue; }
    d := rs_d20(b[0].dice[..], rs_save_edge(b, j, RS_WIS));
    total := d.roll + rs_save_bonus(c, RS_WIS);
    ok := total >= dc;
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " WIS save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": success" else ": turned, Frightened and Incapacitated");
    rs_tell(b, ifx ok then RS_EV_SAVE else RS_EV_CONDITION, -1, i, j, total, 0, l[..]);
    if !ok { rs_put_effect(b, j, RsEffect.{kind = EF_TURNED, cond = RS_FRIGHTENED | RS_INCAPACITATED, by = i, spell = -1, until = b[0].clock + 60, save = -1, dc = 0}); }
  }
  return true;
}

// Preserve Life (Life Domain, p. 40): a Magic action and a Channel Divinity use; five times the
// Cleric's level in Hit Points, divided among Bloodied creatures within 30 feet (its side, itself
// too), none above half its Hit Point maximum. The most hurt first.
rs_preserve_life :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].preserve_life || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  any := false;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team && !c.dead && c.hp < c.hp_max / 2 && !rs_effect(c, EF_NOHEAL) && rs_feet_to(b, i, j) <= 30 { any = true; }
  }
  if !any { return false; }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  rs_say(b, RS_EV_CAST, i, -1, 0, " channels divinity: Preserve Life");
  pool := 5 * b[0].c[i].level;
  while pool > 0 {
    best := -1; bv := 2.0f32;
    for j: 0..<b[0].n {
      c := b[0].c[j];
      if c.team != b[0].c[i].team || c.dead || c.hp >= c.hp_max / 2 || rs_effect(c, EF_NOHEAL) || rs_feet_to(b, i, j) > 30 { continue; }
      v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
      if v < bv { bv = v; best = j; }
    }
    if best < 0 { break; }
    give := rs_min(pool, b[0].c[best].hp_max / 2 - b[0].c[best].hp);
    pool -= give;
    got := rs_feature_heal(b, i, best, give, "Preserve Life");
  }
  return true;
}

// Second Wind (p. 48): a Bonus Action, 1d10 + its Fighter level.
rs_second_wind :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_WIND] <= 0 || b[0].c[i].hp >= b[0].c[i].hp_max { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_WIND] -= 1;
  rs_say(b, RS_EV_CAST, i, i, 0, " takes a Second Wind");
  got := rs_feature_heal(b, i, i, rs_roll(b[0].dice[..], 10) + b[0].c[i].level, "Second Wind");
  // Tactical Shift (p. 48): half its Speed more (no Opportunity Attacks in this engine to avoid)
  if b[0].c[i].shift && !b[0].turn.anchored { b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE / 2; }
  return true;
}
// Action Surge (p. 48): one more action this turn, once.
rs_action_surge :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || !b[0].turn.action || !rs_can_act(b[0].c[i]) || b[0].c[i].uses[RS_USE_SURGE] <= 0 { return false; }
  b[0].turn.action = false; b[0].c[i].uses[RS_USE_SURGE] -= 1;
  rs_say(b, RS_EV_CONDITION, i, i, 0, " uses Action Surge");
  return true;
}

// Lay On Hands (p. 53-54): a Bonus Action, touching a creature (itself too), up to `amount` Hit
// Points from the pool.
rs_lay_on_hands :: (b: [] RsBattle, i: int, j: int, amount: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_LAY] <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 || rs_effect(b[0].c[j], EF_NOHEAL) { return false; }
  give := rs_min(rs_min(amount, b[0].c[i].uses[RS_USE_LAY]), b[0].c[j].hp_max - b[0].c[j].hp);
  if give <= 0 { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_LAY] -= give;
  rs_say(b, RS_EV_CAST, i, j, give, " lays on hands");
  got := rs_feature_heal(b, i, j, give, "Lay On Hands");
  return true;
}
// Sacred Weapon (Oath of Devotion, p. 56): with the Attack action, a Channel Divinity use; for 10
// minutes its Charisma modifier on its melee weapon's attack rolls, and Radiant damage if it likes.
rs_sacred_weapon :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || b[0].c[i].klass != RS_PALADIN || b[0].c[i].level < 3 || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  if b[0].c[i].sacred_until > b[0].clock { return false; }
  b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  b[0].c[i].sacred_until = b[0].clock + 600;
  rs_say(b, RS_EV_CONDITION, i, i, 0, " raises a Sacred Weapon: +Cha to hit, Radiant on a hit");
  return true;
}

// Cunning Action (p. 62): Dash as a Bonus Action.
rs_cunning_dash :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || !b[0].c[i].cunning { return false; }
  b[0].turn.bonus = true;
  b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE;
  return true;
}
// Steady Aim (p. 62): a Bonus Action, only if it hasn't moved this turn; Advantage on its next
// attack roll this turn, and its Speed is 0 until the turn ends.
rs_steady_aim :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || !b[0].c[i].steady_aim || b[0].turn.moved { return false; }
  b[0].turn.bonus = true; b[0].turn.aimed = true; b[0].turn.anchored = true; b[0].turn.move_left = 0;
  rs_say(b, RS_EV_CONDITION, i, i, 0, " takes Steady Aim");
  return true;
}

// Innate Sorcery (p. 65-66): a Bonus Action, for 1 minute: +1 to its spell save DC and Advantage on
// its spell attack rolls.
rs_innate_sorcery :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_INNATE] <= 0 || b[0].c[i].innate_until > b[0].clock { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_INNATE] -= 1;
  b[0].c[i].innate_until = b[0].clock + 60;
  rs_say(b, RS_EV_CONDITION, i, i, 0, " unleashes Innate Sorcery");
  return true;
}

// Land's Aid (Circle of the Land, p. 46): a Magic action and a Wild Shape use, a point within 60
// feet: each foe in the 10-foot-radius Sphere makes a Con save, 2d6 Necrotic or half; one creature
// there (`heal`, -1 none) regains 2d6 Hit Points.
rs_lands_aid :: (b: [] RsBattle, i: int, tx: int, ty: int, heal: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].lands_aid || b[0].c[i].uses[RS_USE_WILD] <= 0 { return false; }
  if rs_feet(b[0].c[i].x, b[0].c[i].y, tx, ty) > 60 { return false; }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_WILD] -= 1;
  n6 := ifx b[0].c[i].level >= 14 then 4 else ifx b[0].c[i].level >= 10 then 3 else 2;
  rs_say(b, RS_EV_CAST, i, -1, 0, " calls on Land's Aid: flowers and thorns");
  e: RsEvent; e.kind = RS_EV_ZONE; e.spell = -1; e.by = i; e.to = -1; e.x = tx - 2; e.y = ty - 2; e.amount = 5; e.at = b[0].clock;
  k := rs_emit(b[0].book[..], e);
  dc := rs_dc(b, i);
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || rs_feet(tx, ty, c.x, c.y) > 10 { continue; }
    d := rs_d20(b[0].dice[..], rs_save_edge(b, j, RS_CON));
    total := d.roll + rs_save_bonus(c, RS_CON);
    total += rs_inspired_roll(b, j, total, dc);
    ok := total >= dc;
    amount := rs_sum(b[0].dice[..], n6, 6);
    if ok { amount = amount / 2; }
    amount = rs_resisted(b, j, amount, RS_NECROTIC);
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " CON save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": half, " else ": "); rs_add_int(l[..], amount); rs_add_text(l[..], " Necrotic");
    rs_tell(b, RS_EV_DAMAGE, -1, i, j, amount, RS_NECROTIC, l[..]);
    rs_damage(b, i, j, amount, RS_NECROTIC, false, -1);
  }
  if heal >= 0 && heal < b[0].n && !b[0].c[heal].dead && rs_feet(tx, ty, b[0].c[heal].x, b[0].c[heal].y) <= 10 {
    got := rs_feature_heal(b, i, heal, rs_sum(b[0].dice[..], n6, 6), "Land's Aid");
  }
  return true;
}

// The Dash action: its Speed again.
rs_dash :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) { return false; }
  b[0].turn.action = true;
  b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE;
  return true;
}

#test "Starry Wisp: a ranged spell attack, +5, 1d8 Radiant on a hit" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 11;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  t := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 1);
  hits := 0; total := 0;
  for k: 0..<200 {
    b[0].c[t].hp = b[0].c[t].hp_max; b[0].c[t].cond = 0;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);
    #assert !rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);   // one action a turn
    rs_end_turn(b[..], a);
    lost := b[0].c[t].hp_max - b[0].c[t].hp;
    #assert lost >= 0 && lost <= 16;
    if lost > 0 { hits += 1; total += lost; }
  }
  // +5 against AC 15: 11 or higher hits, 55% (a 20 crits)
  #assert hits > 80 && hits < 140;
}
#test "Cure Wounds heals 2d8 + 3 by touch; a 2nd-level slot heals 4d8 + 3; one slot a turn" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  f := rs_add(b[..], rs_druid("Briar", 0, 3), 2, 1);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 1);
  b[0].c[f].hp = 1;
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, far);   // Touch
  #assert rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, f);
  #assert b[0].c[f].hp >= 1 + 5 && b[0].c[f].hp <= 1 + 19 && b[0].c[a].slots[1] == 3;
  #assert !rs_cast(b[..], a, SP_HEALING_WORD, 1, 0, 0, f);    // the one slot this turn is spent
  rs_end_turn(b[..], a);
  b[0].c[f].hp = 0; b[0].c[f].cond = RS_UNCONSCIOUS | RS_PRONE;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEALING_WORD, 2, 0, 0, f);
  #assert b[0].c[f].hp >= 4 + 3 && !rs_has(b[0].c[f], RS_UNCONSCIOUS) && b[0].c[a].slots[2] == 1;
}
#test "Thunderwave: a 15-foot cube from you, Con save, 2d8 Thunder and pushed 10 feet on a failure" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 3, 3);
  out := rs_add(b[..], rs_druid("Sable", 1, 3), 7, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_THUNDERWAVE, 1, 3, 3, -1);
  lost := b[0].c[e].hp_max - b[0].c[e].hp;
  #assert lost >= 1 && lost <= 16;
  #assert b[0].c[e].x == 3 || b[0].c[e].x == 5;          // stayed (saved) or pushed two squares
  #assert b[0].c[out].hp == b[0].c[out].hp_max;          // outside the cube
}
#test "Entangle restrains on a failed Strength save; concentration ends it and lets go" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  held := 0;
  for k: 0..<20 {
    for j: 0..<RS_ZONES { b[0].zone[j].on = false; }
    b[0].n = 1; b[0].c[a].conc = -1;
    e := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 3);
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ENTANGLE, 1 + k % 2, 8, 3, -1);
    if rs_has(b[0].c[e], RS_RESTRAINED) {
      held += 1;
      #assert rs_difficult(b[..], 8, 3);
      rs_end_concentration(b[..], a, "");
      #assert !rs_has(b[0].c[e], RS_RESTRAINED) && !rs_difficult(b[..], 8, 3);
    }
    b[0].c[a].slots[1] = 4; b[0].c[a].slots[2] = 2;
    rs_end_turn(b[..], a);
  }
  // Str +0 against DC 13: fails on 12 or lower, 60%
  #assert held >= 6 && held <= 18;
}
#test "Chill Touch: a melee spell attack; on a hit 1d10 Necrotic and no healing until the end of the caster's next turn" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 31;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 3, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 4, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, far);   // Touch
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 10; b[0].who = a; b[0].turn.action = false;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    if b[0].c[t].hp < 10 { hit = true; break; }
  }
  #assert hit && rs_effect(b[0].c[t], EF_NOHEAL);
  hp := b[0].c[t].hp;
  c: [1] RsCreature; c[0] = b[0].c[t];
  #assert rs_heal(c[..], 5) == 0;
  rs_end_turn(b[..], a);
  rs_tick(b[..], f32(RS_ROUND) + 0.1);
  #assert !rs_effect(b[0].c[t], EF_NOHEAL);
}
#test "Ray of Sickness poisons until the end of the caster's next turn; a Poisoned attacker has Disadvantage" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 41;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  got := false;
  for k: 0..<20 {
    b[0].c[t].hp = 21; b[0].c[a].slots[1] = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_SICKNESS, 1, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_POISONED) { got = true; break; }
  }
  #assert got;
  // still Poisoned until the caster's next turn has ended
  rs_tick(b[..], b[0].c[a].turn_at - 0.5 - b[0].clock);
  #assert rs_has(b[0].c[t], RS_POISONED);
  rs_tick(b[..], 0.7);
  #assert !rs_has(b[0].c[t], RS_POISONED);
}
#test "False Life: 2d4 + 4 Temporary Hit Points, 5 more a slot level above 1" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 1, 0, 0, a) && b[0].c[a].temp >= 6 && b[0].c[a].temp <= 12;
  rs_end_turn(b[..], a); b[0].c[a].temp = 0;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 2, 0, 0, a) && b[0].c[a].temp >= 11 && b[0].c[a].temp <= 17;
}
#test "Ray of Enfeeblement: on a failed Con save the target's damage loses 1d8, until it saves at the end of a turn" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 77;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_ENFEEBLEMENT, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_effect(b[0].c[t], EF_ENFEEBLED) { held = true; break; }
    #assert rs_effect(b[0].c[t], EF_WEAK) && b[0].c[a].conc < 0;
  }
  #assert held && b[0].c[a].conc == SP_RAY_OF_ENFEEBLEMENT;
  // concentration broken: it ends
  rs_end_concentration(b[..], a, "");
  #assert !rs_effect(b[0].c[t], EF_ENFEEBLED);
}
#test "Blindness/Deafness: Blinded on a failed save; attacks against it have Advantage; it saves to end it" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 13;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  blind := false;
  for k: 0..<20 {
    b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_BLINDNESS, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_BLINDED) { blind = true; break; }
  }
  #assert blind;
  ended := false;
  for k: 0..<40 { rs_start_turn(b[..], t); rs_end_turn(b[..], t); if !rs_has(b[0].c[t], RS_BLINDED) { ended = true; break; } }
  #assert ended;
}
#test "Produce Flame: the flame first (a Bonus Action), then a Magic action to hurl it" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert rs_cast(b[..], a, SP_PRODUCE_FLAME, 0, 0, 0, a);
  #assert rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert b[0].c[a].flame_until > b[0].clock;
}
#test "Eldritch Blast: 1d10 Force + Cha (Agonizing Blast), and a hit pushes 10 feet (Repelling Blast)" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 6, 3);
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 6; b[0].c[t].y = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    rs_end_turn(b[..], a);
    if b[0].c[t].hp < 21 { hit = true; break; }
  }
  #assert hit && b[0].c[t].x == 8;
  lost := 21 - b[0].c[t].hp;
  #assert lost >= 1 + 3 && lost <= 20 + 3;
  // one beam at level 3, two at 5: each its own attack
  #assert rs_cantrip_tier(3) == 1;
}
#test "Hex: 1d6 Necrotic more on each hit; it moves on a later turn once its target drops" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  u := rs_add(b[..], rs_druid("Fern", 0, 3), 10, 6);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEX, 2, 0, 0, t) && b[0].c[a].conc == SP_HEX && b[0].c[a].slots[2] == 1;
  #assert !rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, u);   // one slot a turn
  #assert rs_effect(b[0].c[t], EF_HEX);
  extra := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 10; b[0].c[t].y = 3; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.spell == SP_HEX && ev.kind == RS_EV_DAMAGE { extra = true; } }
    if extra { break; }
  }
  #assert extra;
  // it drops: not this turn, the next one
  b[0].c[t].hp = 1; b[0].c[t].temp = 0;
  rs_damage(b[..], a, t, 5, RS_FORCE, false, SP_ELDRITCH_BLAST);
  #assert b[0].c[t].hp == 0 && b[0].c[a].hex_free;
  #assert !rs_hex_move(b[..], a, u);
  rs_end_turn(b[..], a);
  rs_tick(b[..], b[0].c[a].turn_at - b[0].clock);
  rs_start_turn(b[..], a);
  #assert rs_hex_move(b[..], a, u) && rs_effect(b[0].c[u], EF_HEX) && !rs_effect(b[0].c[t], EF_HEX) && b[0].c[a].slots[2] == 1;
}
#test "Hold Person: Paralyzed on a failed Wis save; it fails Dex saves, and a hit from 5 feet is a Critical Hit" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[t].cond = 0; b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_PARALYZED) { held = true; break; }
    #assert b[0].c[a].conc < 0;   // saved: nothing to hold
  }
  #assert held && !rs_can_act(b[0].c[t]) && b[0].c[a].conc == SP_HOLD_PERSON;
  // a melee hit from 5 feet: a Critical Hit (two dice of Chill Touch)
  crit := false;
  for k: 0..<10 {
    b[0].c[t].hp = 21; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) {
      ev := rs_recent(b[0].book[0], e);
      if ev.kind == RS_EV_ATTACK { crit = ev.text_n > 12 && cast(string) ev.text[(ev.text_n - 12)..<ev.text_n] == "critical hit"; #assert crit; }
    }
    if crit { break; }
  }
  #assert crit;
  // its concentration ends: it can move again
  rs_end_concentration(b[..], a, "");
  #assert !rs_has(b[0].c[t], RS_PARALYZED);
}
#test "Scorching Ray: three rays, a ranged spell attack each, 2d6 Fire on a hit; four from a 3rd-level slot" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 2;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 5, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  rs_start_turn(b[..], a);
  seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 3, 0, 0, t);
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { rolls += 1; } }
  #assert rolls == 4;
}
#test "Dark One's Blessing: Cha + Warlock level Temporary Hit Points when it drops a foe, or one drops within 10 feet" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 4;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  near := rs_add(b[..], rs_druid("Rowan", 0, 3), 3, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 12, 3);
  ally := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 13, 6);
  b[0].c[far].hp = 1;
  rs_damage(b[..], ally, far, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 0 && b[0].c[ally].temp == 3 + 3;
  b[0].c[near].hp = 1;
  rs_damage(b[..], ally, near, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 6;
}
#test "Rage: a Bonus Action; +2 damage on Greataxe hits, Bludgeoning/Piercing/Slashing halved; it ends on a turn without an attack" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 12;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a) && b[0].c[a].raging && b[0].c[a].rages == 2 && !rs_rage(b[..], a);
  // a monk's 1d6 + 3 Bludgeoning is halved
  b[0].c[m].deflect = false;
  rs_end_turn(b[..], a);
  got := false;
  for k: 0..<20 {
    b[0].c[a].hp = 32;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_attack(b[..], m, a, false, -1);
    rs_end_turn(b[..], m);
    if b[0].c[a].hp < 32 { #assert 32 - b[0].c[a].hp <= 9 / 2 + 3; got = true; break; }
  }
  #assert got && b[0].c[a].raging;
  // its own turn passes with an attack: it holds; a turn without one: it ends
  rs_start_turn(b[..], a);
  #assert rs_attack(b[..], a, m, false, -1);
  rs_end_turn(b[..], a);
  #assert b[0].c[a].raging;
  rs_start_turn(b[..], a);
  rs_end_turn(b[..], a);
  #assert !b[0].c[a].raging;
}
#test "Reckless Attack: Advantage on its Strength attacks and on attacks against it; Frenzy adds 2d6 to the first hit" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 8;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a);
  #assert rs_attack(b[..], a, m, true, -1);
  #assert b[0].c[a].reckless_until > b[0].clock;
  #assert rs_attack_edge(b[..], m, a, true, false) == 1;
  frenzy := false;
  for k: 0..<10 {
    ev := rs_recent(b[0].book[0], k);
    if ev.kind == RS_EV_DAMAGE { s := cast(string) ev.text[0..<ev.text_n]; for c: 0..<(ev.text_n - 6) { if s[c..<(c + 6)] == "Frenzy" { frenzy = true; } } }
    if ev.kind == RS_EV_MISS { frenzy = true; }   // a miss: nothing to add
  }
  #assert frenzy;
  rs_end_turn(b[..], a);
  // gone at the start of its next turn
  rs_tick(b[..], b[0].c[a].turn_at - b[0].clock);
  #assert b[0].c[a].reckless_until <= b[0].clock;
}
#test "Cleave: a Greataxe hit carries into a second foe beside the first, without the Strength modifier" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 4, 3);
  n := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 4, 4);
  cleft := false;
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[n].hp = 21; b[0].c[m].temp = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, n);
    rs_end_turn(b[..], a);
    if b[0].c[n].hp < 21 { #assert 21 - b[0].c[n].hp <= 24; cleft = true; break; }
  }
  #assert cleft;
}
#test "Flurry of Blows: 1 Focus Point, two Unarmed Strikes (1d6 + 3); Topple knocks a foe Prone on a failed Dex save" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 19;
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 3, 3);
  t := rs_add(b[..], rs_warlock("Vesk", 0, 3, SP_ELDRITCH_BLAST), 4, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  prone := false;
  for k: 0..<10 {
    b[0].c[m].focus = 3; b[0].c[t].cond = 0;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_flurry(b[..], m, t, OH_TOPPLE) && b[0].c[m].focus == 2 && !rs_flurry(b[..], m, t, OH_TOPPLE);
    strikes := 0;
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { strikes += 1; } }
    #assert strikes == 2;
    rs_end_turn(b[..], m);
    if rs_has(b[0].c[t], RS_PRONE) { prone = true; break; }
  }
  #assert prone;
}
#test "Deflect Attacks: a Monk's Reaction cuts 1d10 + Dex + level from a Greataxe hit, once until its turn" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[m].reacted = false; b[0].c[m].focus = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, -1);
    rs_end_turn(b[..], a);
    if b[0].c[m].reacted { break; }
  }
  #assert b[0].c[m].reacted && 21 - b[0].c[m].hp <= 12 + 3 - (1 + 3 + 3);
}
#test "Patient Defense: Dodge until its next turn, Disadvantage on attacks against it and Advantage on Dex saves" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], m);
  #assert rs_patient_defense(b[..], m) && b[0].c[m].focus == 2;
  #assert rs_attack_edge(b[..], a, m, true, true) == -1 && rs_save_edge(b[..], m, RS_DEX) == 1;
  rs_end_turn(b[..], m);
  rs_tick(b[..], b[0].c[m].turn_at - b[0].clock);
  #assert rs_attack_edge(b[..], a, m, true, true) == 0;
}
#test "the action adapter: a turn every 1.5 seconds, slots back after the cooldown, saves still on 6-second rounds" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  b[0].beat = 1.5; b[0].recharge = 9;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 9, 3);
  rs_begin(b[..]);
  first := b[0].c[a].turn_at;
  rs_tick(b[..], first - b[0].clock);
  rs_start_turn(b[..], a);
  #assert b[0].turn.new_round && b[0].turn.move_left == 2;   // 30 feet a round: 7.5 feet a beat, 2 squares
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 2, 0, 0, t) && b[0].c[a].slots[2] == 1;
  rs_end_turn(b[..], a);
  #assert b[0].c[a].turn_at == first + 1.5;
  rs_tick(b[..], 1.5);
  rs_start_turn(b[..], a);
  #assert !b[0].turn.new_round;
  rs_end_turn(b[..], a);
  for k: 0..<10 { rs_tick(b[..], 1.0); }
  #assert b[0].c[a].slots[2] == 2;
}
#test "a Skeleton takes double from a Monk's fists, nothing from Poison Spray, and can't be held by Hold Person" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 14;
  m := rs_add(b[..], rs_monk("Sen", 0, 3), 3, 3);
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 3);
  w := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 8, 3);
  d := rs_add(b[..], rs_druid("Rowan", 0, 3), 5, 4);
  hit := false;
  for k: 0..<20 {
    b[0].c[s].hp = 13; b[0].c[s].dead = false; b[0].c[s].cond = 0;
    rs_start_turn(b[..], m);
    #assert rs_attack(b[..], m, s, false, -1);
    rs_end_turn(b[..], m);
    if b[0].c[s].hp < 13 { #assert (13 - b[0].c[s].hp) % 2 == 0 || b[0].c[s].hp == 0; hit = true; break; }
  }
  #assert hit;
  rs_start_turn(b[..], w);
  #assert !rs_cast(b[..], w, SP_HOLD_PERSON, 2, 0, 0, s);
  rs_end_turn(b[..], w);
  for k: 0..<10 {
    b[0].c[s].hp = 13; b[0].c[s].dead = false; b[0].c[s].cond = 0;
    rs_start_turn(b[..], d);
    #assert rs_cast(b[..], d, SP_POISON_SPRAY, 0, 0, 0, s);
    rs_end_turn(b[..], d);
    #assert b[0].c[s].hp == 13;
  }
}
#test "a Skeleton's Shortbow: 80 feet, Disadvantage out to 320, and up close Disadvantage while a foe is beside it" {
  b: [1] RsBattle; b[0].w = 80; b[0].h = 8; b[0].dice[0].state = 2;
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 30, 3);
  rs_start_turn(b[..], s);
  #assert rs_shoot(b[..], s, t);
  ev := rs_recent(b[0].book[0], 0);
  for k: 0..<4 { e := rs_recent(b[0].book[0], k); if e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS { ev = e; } }
  txt := cast(string) ev.text[0..<ev.text_n];
  dis := false;
  for c: 0..<(ev.text_n - 12) { if txt[c..<(c + 12)] == "Disadvantage" { dis = true; } }
  #assert dis;   // 145 feet: long range
  rs_end_turn(b[..], s);
  b[0].c[t].x = 75;
  rs_start_turn(b[..], s);
  #assert !rs_shoot(b[..], s, t);   // 370 feet: beyond 320
}

// Whether an event since `seq` says `needle` (the tests' look at the log).
rs_saw :: (b: [] RsBattle, seq: int, needle: string) -> bool {
  for e: 0..<rs_min(b[0].book[0].seq - seq, RS_EVENTS) {
    ev := rs_recent(b[0].book[0], e);
    t := cast(string) ev.text[0..<ev.text_n];
    if ev.text_n < needle.count { continue; }
    for c: 0..<(ev.text_n - needle.count + 1) { if t[c..<(c + needle.count)] == needle { return true; } }
  }
  return false;
}
// A fresh turn for i (its action, Bonus Action and slot unspent), without the clock moving.
rs_fresh :: (b: [] RsBattle, i: int) { b[0].who = i; b[0].turn = RsTurn.{move_left = 6}; b[0].c[i].reacted = false; }

#test "Bardic Inspiration: a Bonus Action gives an ally the d6, spent on its next failed attack roll" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 5, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 3);
  rs_fresh(b[..], a);
  #assert !rs_inspire(b[..], a, a) && rs_inspire(b[..], a, f) && b[0].c[f].inspired == 6 && b[0].c[a].uses[RS_USE_INSPIRE] == 2;
  #assert !rs_inspire(b[..], a, f);   // the Bonus Action is spent
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  for k: 0..<20 {
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], f, t, false, -1);
    if b[0].c[f].inspired == 0 { #assert rs_saw(b[..], seq, "Inspiration"); break; }
  }
  #assert b[0].c[f].inspired == 0;
}
#test "Cutting Words: a Lore Bard's Reaction takes its die off a foe's hit, turning some to misses" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  t := rs_add(b[..], rs_fighter("Garr", 0, 3), 5, 3);
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 3);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  cut := false;
  for k: 0..<30 {
    b[0].c[a].uses[RS_USE_INSPIRE] = 3; b[0].c[a].reacted = false;
    rs_fresh(b[..], s); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], s, t, false, -1);
    if rs_saw(b[..], seq, "Cutting Words") { cut = true; #assert b[0].c[a].uses[RS_USE_INSPIRE] == 2 && b[0].c[a].reacted; break; }
  }
  #assert cut;
}
#test "Vicious Mockery: a failed Wis save, 1d6 Psychic and Disadvantage on its next attack roll" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 8;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 8, 3);
  mocked := false;
  for k: 0..<20 {
    b[0].c[t].hp = 13; b[0].c[t].dead = false;
    rs_fresh(b[..], a);
    #assert rs_cast(b[..], a, SP_VICIOUS_MOCKERY, 0, 0, 0, t);
    if rs_effect(b[0].c[t], EF_WEAK) { mocked = true; #assert b[0].c[t].hp < 13 && b[0].c[t].hp >= 13 - 6; break; }
  }
  #assert mocked && rs_attack_edge(b[..], t, a, false, false) == -1 && !rs_effect(b[0].c[t], EF_WEAK);
}
#test "Turn Undead: Undead within 30 feet that fail a Wis save are Frightened and Incapacitated until hurt" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 4;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  for k: 0..<6 { s := rs_add(b[..], rs_skeleton("Skeleton", 2), 4 + k, 4); }
  far := rs_add(b[..], rs_skeleton("Skeleton", 2), 15, 4);
  rs_fresh(b[..], a);
  #assert rs_turn_undead(b[..], a) && b[0].c[a].uses[RS_USE_CHANNEL] == 1 && !rs_turn_undead(b[..], a);
  turned := -1;
  for j: 1..<7 { if rs_effect(b[0].c[j], EF_TURNED) { turned = j; } }
  #assert turned > 0 && !rs_effect(b[0].c[far], EF_TURNED);
  #assert !rs_can_act(b[0].c[turned]) && rs_can_move(b[0].c[turned]) && rs_has(b[0].c[turned], RS_FRIGHTENED) && rs_turned_by(b[0].c[turned]) == a;
  b[0].c[turned].hp = 13; b[0].c[turned].vulnerable = 0;
  rs_damage(b[..], a, turned, 1, RS_RADIANT, false, -1);
  #assert !rs_effect(b[0].c[turned], EF_TURNED) && rs_can_act(b[0].c[turned]);
}
#test "Preserve Life: 15 Hit Points among Bloodied allies within 30 feet, none above half; Disciple of Life adds 2 + slot" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 4, 5);
  rs_fresh(b[..], a);
  #assert !rs_preserve_life(b[..], a);   // nobody Bloodied: nothing spent
  b[0].c[f].hp = 2; b[0].c[r].hp = 9;
  #assert rs_preserve_life(b[..], a) && b[0].c[a].uses[RS_USE_CHANNEL] == 1;
  #assert b[0].c[f].hp == 14 && b[0].c[r].hp == 12;   // 12 and 3: each up to half its maximum
  b[0].c[f].hp = 1;
  rs_fresh(b[..], a);
  #assert rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, f) && b[0].c[f].hp >= 1 + 2 + 3 + 3;
}
#test "Guiding Bolt: 4d6 Radiant on a hit, and the next attack roll against it has Advantage; Sacred Flame is a Dex save" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Garr", 1, 3), 10, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  lit_up := false;
  for k: 0..<20 {
    b[0].c[a].slots[1] = 4; rs_fresh(b[..], a);
    #assert rs_cast(b[..], a, SP_GUIDING_BOLT, 1, 0, 0, t);
    if rs_effect(b[0].c[t], EF_EXPOSED) { lit_up = true; break; }
  }
  #assert lit_up && 500 - b[0].c[t].hp >= 4;
  #assert rs_attack_edge(b[..], a, t, false, false) == 1 && !rs_effect(b[0].c[t], EF_EXPOSED);
  b[0].c[t].hp = 500; rs_fresh(b[..], a); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_SACRED_FLAME, 0, 0, 0, t) && rs_saw(b[..], seq, "DEX save") && 500 - b[0].c[t].hp <= 8;
}
#test "Second Wind heals 1d10 + 3 as a Bonus Action; Action Surge gives a second Attack action" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 2;
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  b[0].c[f].hp = 5;
  rs_fresh(b[..], f);
  #assert rs_second_wind(b[..], f) && b[0].c[f].hp >= 5 + 4 && b[0].c[f].hp <= 5 + 13 && b[0].c[f].uses[RS_USE_WIND] == 1 && !rs_second_wind(b[..], f);
  #assert !rs_action_surge(b[..], f);   // nothing to surge past yet
  #assert rs_attack(b[..], f, t, false, -1) && !rs_attack(b[..], f, t, false, -1);
  #assert rs_action_surge(b[..], f) && rs_attack(b[..], f, t, false, -1) && b[0].c[f].uses[RS_USE_SURGE] == 0 && !rs_action_surge(b[..], f);
}
#test "Improved Critical: the Champion's 19s are Critical Hits; Graze deals the Strength modifier on a miss" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 12;
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  b[0].c[t].ac = 40;   // only Critical Hits land
  crits := 0; grazed := 0;
  for k: 0..<200 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], f);
    hit := rs_attack(b[..], f, t, false, -1);
    lost := 500 - b[0].c[t].hp;
    if lost == 3 { grazed += 1; }
    if lost > 3 { crits += 1; #assert lost >= 4 + 3; }
  }
  // 19 or 20: 10%; a 20 alone would be 5%
  #assert crits > 12 && crits < 32 && grazed > 150;
}
#test "Divine Smite: a Bonus Action after a melee hit, 2d8 Radiant (3d8 on Undead); once without a slot" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 14;
  p := rs_add(b[..], rs_paladin("Oriel", 0, 3), 3, 4);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 4);
  rs_fresh(b[..], p);
  #assert !rs_cast(b[..], p, SP_DIVINE_SMITE, 0, 0, 0, t);   // no hit yet
  smote := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500; b[0].c[t].dead = false; b[0].c[t].vulnerable = 0;
    rs_fresh(b[..], p);
    #assert rs_attack(b[..], p, t, false, -1);
    if b[0].turn.last_hit == t + 1 {
      before := b[0].c[t].hp; seq := b[0].book[0].seq;
      free := b[0].c[p].uses[RS_USE_FREE] > 0;
      #assert rs_cast(b[..], p, SP_DIVINE_SMITE, ifx free then 0 else 1, 0, 0, t);
      lost := before - b[0].c[t].hp;
      #assert lost >= 3 && rs_saw(b[..], seq, "3d8") || rs_saw(b[..], seq, "6d8");
      if free { #assert b[0].c[p].uses[RS_USE_FREE] == 0 && b[0].c[p].slots[1] == 3; }
      #assert !rs_cast(b[..], p, SP_DIVINE_SMITE, 1, 0, 0, t);   // one smite a hit
      smote = true; break;
    }
  }
  #assert smote;
}
#test "Lay On Hands heals from a 15-point pool by touch; Sacred Weapon adds Cha to hit; Sap weakens a foe hit" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 15;
  p := rs_add(b[..], rs_paladin("Oriel", 0, 3), 3, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 5);
  far := rs_add(b[..], rs_rogue("Nim", 0, 3), 10, 5);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  b[0].c[f].hp = 10; b[0].c[far].hp = 1;
  rs_fresh(b[..], p);
  #assert !rs_lay_on_hands(b[..], p, far, 10) && rs_lay_on_hands(b[..], p, f, 10) && b[0].c[f].hp == 20 && b[0].c[p].uses[RS_USE_LAY] == 5;
  #assert rs_sacred_weapon(b[..], p) && b[0].c[p].uses[RS_USE_CHANNEL] == 1;
  sapped := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], p); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], p, t, false, -1) && rs_saw(b[..], seq, " + 7 = ");   // +2 prof, +3 Str, +2 Cha
    if b[0].turn.last_hit == t + 1 { sapped = rs_effect(b[0].c[t], EF_WEAK); break; }
  }
  #assert sapped;
}
#test "Hunter's Mark: cast free with Favored Enemy, 1d6 Force on each hit; Colossus Slayer and Slow on a hurt foe" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 16;
  r := rs_add(b[..], rs_ranger("Wren", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  rs_fresh(b[..], r);
  #assert rs_cast(b[..], r, SP_HUNTERS_MARK, 0, 0, 0, t) && b[0].c[r].uses[RS_USE_FREE] == 1 && b[0].c[r].slots[1] == 3 && rs_effect(b[0].c[t], EF_MARK) && b[0].c[r].conc == SP_HUNTERS_MARK;
  marked := false; slayer := false;
  for k: 0..<30 {
    b[0].c[t].hp = 400; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], r); seq := b[0].book[0].seq;
    #assert rs_shoot(b[..], r, t);
    if rs_saw(b[..], seq, "Hunter's Mark") { marked = true; }
    if rs_saw(b[..], seq, "Colossus Slayer") { slayer = true; #assert b[0].c[t].slowed_until > b[0].clock; }
    if marked && slayer { break; }
  }
  #assert marked && slayer;
  // Slowed: 10 feet less at the start of its turn
  rs_start_turn(b[..], t); #assert b[0].turn.move_left == 4;
}
#test "Sneak Attack: 2d6 once a turn with an ally beside the foe or Advantage; Steady Aim gives Advantage, not after moving" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 17;
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 10, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], r);
  #assert rs_steady_aim(b[..], r) && b[0].turn.aimed && b[0].turn.move_left == 0 && !rs_step_to(b[..], r, 3, 4);
  #assert rs_attack_edge(b[..], r, t, false, false) == 1 && !b[0].turn.aimed;
  rs_fresh(b[..], r);
  #assert rs_step_to(b[..], r, 3, 4) && !rs_steady_aim(b[..], r);
  #assert rs_cunning_dash(b[..], r) && b[0].turn.move_left == 5 + 6;
  ally := rs_add(b[..], rs_fighter("Garr", 0, 3), 11, 4);
  sneaky := false;
  for k: 0..<20 {
    rs_fresh(b[..], r); seq := b[0].book[0].seq;
    #assert rs_shoot(b[..], r, t);
    if rs_saw(b[..], seq, "Sneak Attack") { sneaky = true; #assert b[0].turn.sneaked; break; }
  }
  #assert sneaky;
}
#test "Vex: a Shortsword hit that deals damage gives Advantage on the next attack roll against that foe" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 18;
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 3, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  u := rs_add(b[..], rs_fighter("Kell", 1, 3), 4, 5);
  vexed := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], r);
    #assert rs_attack(b[..], r, t, false, -1);
    if rs_effect(b[0].c[r], EF_VEX) { vexed = true; break; }
  }
  #assert vexed && rs_attack_edge(b[..], r, u, true, false) == 0 && rs_attack_edge(b[..], r, t, true, false) == 1 && !rs_effect(b[0].c[r], EF_VEX);
}
#test "Innate Sorcery: +1 DC and Advantage on spell attacks; Quickened Spell casts a cantrip as a Bonus Action" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 19;
  s := rs_add(b[..], rs_sorcerer("Ember", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], s);
  #assert rs_dc(b[..], s) == 13 && rs_innate_sorcery(b[..], s) && rs_dc(b[..], s) == 14 && b[0].c[s].uses[RS_USE_INNATE] == 1;
  rs_fresh(b[..], s); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && rs_saw(b[..], seq, "(Advantage)");
  #assert rs_cast_quick(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && b[0].c[s].uses[RS_USE_SORCERY] <= 1 && b[0].turn.bonus;
  #assert !rs_cast(b[..], s, SP_SCORCHING_RAY, 2, 0, 0, t);   // no level 1+ spell after a Quickened one
  rs_fresh(b[..], s);
  #assert rs_cast(b[..], s, SP_SCORCHING_RAY, 2, 0, 0, t) && !rs_cast_quick(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t);
}
#test "Seeking Spell rerolls a missed spell attack for a Sorcery Point; Draconic Resilience: 20 HP, AC 15" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 20;
  s := rs_add(b[..], rs_sorcerer("Ember", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], s); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && rs_saw(b[..], seq, "Seeking Spell") && b[0].c[s].uses[RS_USE_SORCERY] == 2;
  #assert b[0].c[s].hp_max == 20 && b[0].c[s].ac == 15;
}
#test "Shield: a Reaction to a hit, +5 AC against it and until the start of the caster's next turn" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 21;
  w := rs_add(b[..], rs_wizard("Mordra", 1, 3), 4, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  rs_begin(b[..]);
  shielded := false;
  for k: 0..<30 {
    b[0].c[w].hp = 17; b[0].c[w].reacted = false; b[0].c[w].shield_until = 0;
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], f, w, false, -1);
    if rs_saw(b[..], seq, "casts Shield") { shielded = true; break; }
  }
  #assert shielded && b[0].c[w].reacted && b[0].c[w].slots[1] == 2 && rs_ac(b[..], w) == 20 && b[0].c[w].hp == 17 - 3;   // turned to a miss, but Graze still deals its 3
  rs_tick(b[..], b[0].c[w].turn_at - b[0].clock);
  #assert rs_ac(b[..], w) == 15;
}
#test "Potent Cantrip: an Evoker's missed Fire Bolt still deals half its damage" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 22;
  w := rs_add(b[..], rs_wizard("Mordra", 1, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Garr", 0, 3), 14, 4);
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  half := false;
  for k: 0..<20 {
    rs_fresh(b[..], w); seq := b[0].book[0].seq;
    #assert rs_cast(b[..], w, SP_FIRE_BOLT, 0, 0, 0, t);
    if rs_saw(b[..], seq, "Potent Cantrip") { half = 500 - b[0].c[t].hp <= 5; break; }
  }
  #assert half;
}
#test "Land's Aid: a Wild Shape use, a 10-foot sphere: 2d6 Necrotic on a failed Con save, half on a success, 2d6 back to a friend" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 23;
  d := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 9, 4);
  e1 := rs_add(b[..], rs_fighter("Brand", 1, 3), 10, 4);
  e2 := rs_add(b[..], rs_fighter("Kell", 1, 3), 11, 5);
  out := rs_add(b[..], rs_fighter("Vane", 1, 3), 14, 4);
  b[0].c[f].hp = 5;
  rs_fresh(b[..], d);
  #assert !rs_lands_aid(b[..], d, 30, 4, f);   // beyond 60 feet
  #assert rs_lands_aid(b[..], d, 10, 4, f) && b[0].c[d].uses[RS_USE_WILD] == 1;
  #assert b[0].c[e1].hp < 28 && b[0].c[e2].hp < 28 && b[0].c[e1].hp >= 28 - 12 && b[0].c[out].hp == 28;
  #assert b[0].c[f].hp >= 5 + 2 && b[0].c[f].hp <= 5 + 12;
}
#test "Remarkable Athlete: a Champion rolls Initiative with Advantage" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 24;
  champ := 0; plain := 0;
  for k: 0..<100 {
    b[0].n = 0;
    a := rs_add(b[..], rs_fighter("Garr", 0, 3), 1, 1);
    c := rs_add(b[..], rs_fighter("Garr", 0, 2), 2, 1);
    champ += b[0].c[a].initiative; plain += b[0].c[c].initiative;
  }
  // a d20's mean is 10.5, with Advantage about 13.8
  #assert champ > plain + 150;
}

#test "a level 6 Champion: Strength 20 from two Ability Score Improvements, Extra Attack, Tactical Mind and Tactical Shift" {
  c := rs_fighter("Garr", 0, 6);
  // Ability Score Improvement (p. 87) at 4 and 6: Strength 16 to 20; Greatsword +5 (Str) +3 (Proficiency)
  #assert c.score[RS_STR] == 20 && rs_weapon_attack(c, c.weapon) == 8 && c.extra_attack == 1 && c.uses_max[RS_USE_WIND] == 3;
  #assert rs_fighter("Garr", 0, 4).score[RS_STR] == 18 && rs_fighter("Garr", 0, 4).extra_attack == 0;
  #assert c.hp_max == 10 + 2 + 5 * (6 + 2);
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 9;
  f := rs_add(b[..], c, 3, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 3);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  // Extra Attack: two attack rolls for one Attack action
  rs_fresh(b[..], f); seq := b[0].book[0].seq;
  #assert rs_attack(b[..], f, t, false, -1) && b[0].turn.action;
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) {
    ev := rs_recent(b[0].book[0], e);
    tx := cast(string) ev.text[0..<ev.text_n];
    for q: 0..<rs_max(ev.text_n - 6, 0) { if tx[q..<(q + 7)] == " vs AC " { rolls += 1; } }
  }
  #assert rolls == 2;
  // Tactical Shift: Second Wind gives half its Speed (3 squares) more
  b[0].c[f].hp = 10; rs_fresh(b[..], f);
  #assert rs_second_wind(b[..], f) && b[0].turn.move_left == 6 + 3 && b[0].c[f].uses[RS_USE_WIND] == 2;
  // Remarkable Athlete: half its Speed after a Critical Hit
  rs_fresh(b[..], f); b[0].turn.last_crit = true; rs_after_blow(b[..], f);
  #assert b[0].turn.move_left == 6 + 3 && !b[0].turn.last_crit;
}

#test "Tactical Mind: a failed Strength (Athletics) check takes 1d10 more from a Second Wind use, spent only when it then succeeds" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  b[0].c[a].score[RS_WIS] = 30;   // DC 8 + 2 + 10 = 20: hard enough that the plants hold
  f := rs_add(b[..], rs_fighter("Garr", 1, 6), 8, 3);
  b[0].c[f].score[RS_STR] = 10;
  mind := false;
  for k: 0..<40 {
    if !rs_has(b[0].c[f], RS_RESTRAINED) {
      for j: 0..<RS_ZONES { b[0].zone[j].on = false; }
      b[0].c[a].conc = -1; b[0].c[a].slots[1] = 4;
      rs_fresh(b[..], a);
      ok := rs_cast(b[..], a, SP_ENTANGLE, 1, 8, 3, -1);
      continue;
    }
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    was := b[0].c[f].uses[RS_USE_WIND];
    freed := rs_escape(b[..], f);
    if rs_saw(b[..], seq, "Tactical Mind") { mind = true; #assert freed && b[0].c[f].uses[RS_USE_WIND] == was - 1; }
    else { #assert b[0].c[f].uses[RS_USE_WIND] == was; }
    if b[0].c[f].uses[RS_USE_WIND] == 0 { b[0].c[f].uses[RS_USE_WIND] = 3; }
  }
  #assert mind;
}

#test "a level 6 Berserker: Strength 18, Extra Attack, Fast Movement, four Rages, and Mindless Rage" {
  c := rs_barbarian("Gorr", 1, 6);
  #assert c.score[RS_STR] == 18 && rs_weapon_attack(c, c.weapon) == 7 && c.extra_attack == 1 && c.speed == 40 && c.rages == 4 && c.primal;
  #assert c.hp_max == 12 + 2 + 5 * (7 + 2) && rs_barbarian("Gorr", 1, 5).mindless == false && c.mindless;
  b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].state = 4;
  a := rs_add(b[..], c, 2, 2);
  // Frightened before the Rage: entering it ends the condition
  rs_put_effect(b[..], a, RsEffect.{kind = EF_COND, cond = RS_FRIGHTENED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert rs_has(b[0].c[a], RS_FRIGHTENED);
  rs_fresh(b[..], a);
  #assert rs_rage(b[..], a) && !rs_has(b[0].c[a], RS_FRIGHTENED);
  // and while raging it can't be Charmed or Frightened; other conditions still land
  rs_put_effect(b[..], a, RsEffect.{kind = EF_COND, cond = RS_CHARMED | RS_POISONED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert !rs_has(b[0].c[a], RS_CHARMED) && rs_has(b[0].c[a], RS_POISONED);
}
