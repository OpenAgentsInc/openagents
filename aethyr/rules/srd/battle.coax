// A battle on a grid of 5-foot squares (docs/dnd/README.md, "The rules engine" and "The time
// adapter"): creatures, the lasting areas spells make, and the SRD's turn on a real-time clock.
// Every creature's turn comes round every 6 seconds on its own beat, staggered by initiative;
// in its turn it has one action, one Bonus Action, its Speed in movement and one spell slot to
// spend (the SRD's one-slot-a-turn rule). rs_cast runs any spell record's effect program;
// the world decides who casts what (its own AI or a player) and draws the events.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test --library aethyr/rules/srd/battle.coax
#load "spells.coax";

RS_MAX :: 24;
RS_ZONES :: 8;
RsZone :: struct { on: bool; spell: int; by: int; x0: int; y0: int; x1: int; y1: int; until: f32; difficult: bool; }
RsTurn :: struct { action: bool; bonus: bool; slot_spent: bool; move_left: int; cleaved: bool; frenzied: bool; struck: bool; new_round: bool; }
RsBattle :: struct {
  c: [RS_MAX] RsCreature; n: int;
  zone: [RS_ZONES] RsZone;
  dice: [1] RsDice;
  book: [1] RsLog;
  clock: f32;
  w: int; h: int;             // the grid, squares
  who: int;                   // whose turn is running (-1 none)
  turn: RsTurn;
  // The time adapter. The SRD's: a turn every 6 seconds (beat 0 means RS_ROUND), slots and uses back
  // only on a rest (recharge 0). The action adapter: a shorter beat, each beat a whole turn's
  // economy, and every spent slot, Rage and Focus Point back `recharge` seconds later (the ruleset
  // profile's `cost cooldown N`). Saves that repeat, death saves and Rage's upkeep stay on 6-second
  // rounds either way.
  beat: f32;
  recharge: f32;
}
rs_beat :: (b: [] RsBattle) -> f32 { return ifx b[0].beat > 0 then b[0].beat else f32(RS_ROUND); }

rs_abs :: (v: int) -> int { return ifx v < 0 then -v else v; }
rs_sign :: (v: int) -> int { if v > 0 { return 1; } if v < 0 { return -1; } return 0; }
// Distance in feet on the grid: each square 5 feet, diagonals too (the SRD's grid rule).
rs_feet :: (ax: int, ay: int, bx: int, by: int) -> int { return rs_max(rs_abs(ax - bx), rs_abs(ay - by)) * RS_SQUARE; }
rs_feet_to :: (b: [] RsBattle, i: int, j: int) -> int { return rs_feet(b[0].c[i].x, b[0].c[i].y, b[0].c[j].x, b[0].c[j].y); }
// Who stands on a square (the dead lie where they fell and still fill it), or -1.
rs_at :: (b: [] RsBattle, x: int, y: int) -> int {
  for i: 0..<b[0].n { if b[0].c[i].x == x && b[0].c[i].y == y { return i; } }
  return -1;
}
rs_inside :: (z: RsZone, x: int, y: int) -> bool { return z.on && x >= z.x0 && x <= z.x1 && y >= z.y0 && y <= z.y1; }
rs_difficult :: (b: [] RsBattle, x: int, y: int) -> bool {
  for k: 0..<RS_ZONES { if b[0].zone[k].difficult && rs_inside(b[0].zone[k], x, y) { return true; } }
  return false;
}
// A hostile creature within 5 feet that can act: ranged attacks have Disadvantage then.
rs_threatened :: (b: [] RsBattle, i: int) -> bool {
  for j: 0..<b[0].n {
    if j != i && b[0].c[j].team != b[0].c[i].team && rs_can_act(b[0].c[j]) && rs_feet_to(b, i, j) <= 5 { return true; }
  }
  return false;
}

// The squares a spell's area covers from caster i toward the point (tx, ty).
rs_area :: (b: [] RsBattle, i: int, sp: RsSpell, tx: int, ty: int) -> RsZone {
  z: RsZone;
  z.on = true; z.by = i; z.spell = -1;
  k := rs_max(sp.area_ft / RS_SQUARE, 1);
  cx := b[0].c[i].x; cy := b[0].c[i].y;
  if sp.area == RS_A_CUBE_SELF {
    // a cube originating from you: on the side toward the point, against your space
    ox_ := rs_sign(tx - cx); oy_ := rs_sign(ty - cy);
    if ox_ == 0 && oy_ == 0 { ox_ = 1; }
    z.x0 = ifx ox_ > 0 then cx + 1 else ifx ox_ < 0 then cx - k else cx - k / 2;
    z.y0 = ifx oy_ > 0 then cy + 1 else ifx oy_ < 0 then cy - k else cy - k / 2;
  } else {
    z.x0 = tx - (k - 1) / 2; z.y0 = ty - (k - 1) / 2;
  }
  z.x1 = z.x0 + k - 1; z.y1 = z.y0 + k - 1;
  return z;
}

// ---- telling the world

RsLine :: struct { buf: [RS_EV_TEXT] u8; n: int; }
rs_line :: () -> RsLine { l: RsLine; return l; }
rs_add_text :: (l: [] RsLine, t: string) { l[0].n = rs_put(l[0].buf[..], l[0].n, t); }
rs_add_int :: (l: [] RsLine, v: int) { l[0].n = rs_put_int(l[0].buf[..], l[0].n, v); }
rs_add_name :: (l: [] RsLine, b: [] RsBattle, i: int) { rs_add_text(l, cast(string) b[0].c[i].name[0..<b[0].c[i].name_n]); }
rs_tell :: (b: [] RsBattle, kind: int, spell: int, by: int, to: int, amount: int, damage: int, l: [] RsLine) {
  e: RsEvent;
  e.kind = kind; e.spell = spell; e.by = by; e.to = to; e.amount = amount; e.damage = damage; e.at = b[0].clock;
  if to >= 0 { e.x = b[0].c[to].x; e.y = b[0].c[to].y; }
  for k: 0..<l[0].n { e.text[k] = l[0].buf[k]; }
  e.text_n = l[0].n;
  i := rs_emit(b[0].book[..], e);
}
RS_ORDINAL :: [10] string.["", "1st", "2nd", "3rd", "4th", "5th", "6th", "7th", "8th", "9th"];

// ---- creatures in the battle

rs_add :: (b: [] RsBattle, c: RsCreature, x: int, y: int) -> int {
  if b[0].n >= RS_MAX { return -1; }
  i := b[0].n;
  b[0].c[i] = c; b[0].c[i].x = x; b[0].c[i].y = y;
  b[0].c[i].initiative = rs_roll(b[0].dice[..], 20) + rs_mod(c.score[RS_DEX]);
  b[0].n += 1;
  return i;
}
// The turns begin: the highest initiative first, the rest spread over the 6-second round.
rs_begin :: (b: [] RsBattle) {
  b[0].who = -1;
  for i: 0..<b[0].n {
    rank := 0;
    for j: 0..<b[0].n {
      if b[0].c[j].initiative > b[0].c[i].initiative || (b[0].c[j].initiative == b[0].c[i].initiative && j < i) { rank += 1; }
    }
    b[0].c[i].turn_at = b[0].clock + 0.4 + f32(rank) * rs_beat(b) / f32(rs_max(b[0].n, 1));
    b[0].c[i].round_at = b[0].c[i].turn_at;
  }
}
// Whose turn is due on the clock, or -1.
rs_due :: (b: [] RsBattle) -> int {
  best := -1;
  for i: 0..<b[0].n {
    if b[0].c[i].dead || b[0].c[i].turn_at > b[0].clock { continue; }
    if best < 0 || b[0].c[i].turn_at < b[0].c[best].turn_at { best = i; }
  }
  return best;
}

rs_drop_effect :: (b: [] RsBattle, j: int, k: int) {
  c: [1] RsCreature; c[0] = b[0].c[j];
  rs_effect_end(c[..], k);
  b[0].c[j] = c[0];
}
rs_put_effect :: (b: [] RsBattle, j: int, e: RsEffect) {
  c: [1] RsCreature; c[0] = b[0].c[j];
  rs_effect_add(c[..], e);
  b[0].c[j] = c[0];
}
// Uses up EF_WEAK on i (its next attack roll has Disadvantage); true when there was one.
rs_take_weak :: (b: [] RsBattle, i: int) -> bool {
  for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind == EF_WEAK { rs_drop_effect(b, i, k); return true; } }
  return false;
}
// When the caster's next turn ends, and when it starts (its turns are instants on the clock).
rs_after_next_turn :: (b: [] RsBattle, i: int) -> f32 { return b[0].c[i].turn_at + rs_beat(b) + 0.05; }
rs_before_next_turn :: (b: [] RsBattle, i: int) -> f32 { return b[0].c[i].turn_at + rs_beat(b) - 0.01; }

// Concentration ends: its areas go, and what they held is let go.
rs_end_concentration :: (b: [] RsBattle, i: int, why: string) {
  sp := b[0].c[i].conc;
  if sp < 0 { return; }
  for k: 0..<RS_ZONES {
    if b[0].zone[k].on && b[0].zone[k].by == i && b[0].zone[k].spell == sp {
      b[0].zone[k].on = false;
      for j: 0..<b[0].n {
        if b[0].c[j].restrained_by == k { b[0].c[j].restrained_by = -1; b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_RESTRAINED); }
      }
    }
  }
  for j: 0..<b[0].n {
    if b[0].c[j].outlined_by == i { b[0].c[j].outlined_by = -1; b[0].c[j].outlined_until = 0; }
    for k: 0..<RS_EFFECTS {
      if b[0].c[j].eff[k].kind != EF_NONE && b[0].c[j].eff[k].by == i && b[0].c[j].eff[k].spell == sp { rs_drop_effect(b, j, k); }
    }
  }
  b[0].c[i].conc = -1;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], "'s "); rs_add_text(l[..], rs_spell(sp).name); rs_add_text(l[..], " ends"); rs_add_text(l[..], why);
  rs_tell(b, RS_EV_END, sp, i, -1, 0, 0, l[..]);
}
// What follows a creature dropping to 0: a Hex on it can move on a later turn, and a Fiend
// Warlock who dropped it, or stands within 10 feet of it, has Dark One's Blessing.
rs_dropped :: (b: [] RsBattle, by: int, j: int) {
  for k: 0..<b[0].n {
    c := b[0].c[k];
    for e: 0..<RS_EFFECTS {
      if b[0].c[j].eff[e].kind == EF_HEX && b[0].c[j].eff[e].by == k && c.conc == SP_HEX {
        b[0].c[k].hex_free = true;
        b[0].c[k].hex_free_after = ifx b[0].who == k then c.turn_at else c.turn_at - rs_beat(b);
      }
    }
    if !c.dark_blessing || !rs_up(c) || c.team == b[0].c[j].team { continue; }
    if k != by && rs_feet_to(b, k, j) > 10 { continue; }
    gain := rs_max(rs_mod(c.score[RS_CHA]) + c.level, 1);
    if gain <= c.temp { continue; }
    b[0].c[k].temp = gain;
    l: [1] RsLine;
    rs_add_name(l[..], b, k); rs_add_text(l[..], " has Dark One's Blessing: "); rs_add_int(l[..], gain); rs_add_text(l[..], " Temporary Hit Points");
    rs_tell(b, RS_EV_HEAL, -1, k, k, gain, 0, l[..]);
  }
}
// Damage, with dropping to 0 and the concentration save the SRD calls for.
rs_damage :: (b: [] RsBattle, by: int, j: int, amount: int, kind: int, crit: bool, spell: int) {
  hurt: [1] RsCreature; hurt[0] = b[0].c[j];
  r := rs_hurt(hurt[..], amount, crit);
  b[0].c[j] = hurt[0];
  if r.dropped || r.killed {
    l: [1] RsLine;
    rs_add_name(l[..], b, j); rs_add_text(l[..], ifx r.killed then " dies" else " drops to 0 Hit Points");
    rs_tell(b, ifx r.killed then RS_EV_DEATH else RS_EV_DOWN, spell, by, j, 0, 0, l[..]);
    rs_end_concentration(b, j, " (Unconscious)");
    if r.dropped { rs_dropped(b, by, j); }
    return;
  }
  if r.conc_dc > 0 && b[0].c[j].conc >= 0 {
    roll := rs_roll(b[0].dice[..], 20); total := roll + rs_save_bonus(b[0].c[j], RS_CON);
    if total < r.conc_dc {
      l: [1] RsLine;
      rs_add_text(l[..], " (Con save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], r.conc_dc); rs_add_text(l[..], ")");
      why := cast(string) l[0].buf[0..<l[0].n];
      rs_end_concentration(b, j, why);
    }
  }
}

// ---- casting

RS_NO :: 0; RS_OK :: 1;
// Whether creature i can cast spell sp with a slot of level `slot` now (0 for a cantrip).
rs_can_cast :: (b: [] RsBattle, i: int, sp: int, slot: int) -> bool {
  if i < 0 || i >= b[0].n || !rs_can_act(b[0].c[i]) || b[0].who != i || b[0].c[i].raging { return false; }
  s := rs_spell(sp);
  if s.cast_time == RS_T_ACTION && b[0].turn.action { return false; }
  if s.cast_time == RS_T_BONUS && b[0].turn.bonus { return false; }
  if s.part_of == SP_PRODUCE_FLAME && b[0].c[i].flame_until <= b[0].clock { return false; }
  if s.level > 0 {
    if slot < s.level || slot > 9 || b[0].c[i].slots[slot] <= 0 || b[0].turn.slot_spent { return false; }
  }
  return true;
}
// Cast spell sp with a slot of level `slot` (0 for a cantrip) at the point (tx, ty), on creature
// `target` for a spell with no area. False, and nothing spent, when it can't be cast so.
rs_cast :: (b: [] RsBattle, i: int, sp: int, slot: int, tx: int, ty: int, target: int) -> bool {
  if !rs_can_cast(b, i, sp, slot) { return false; }
  s := rs_spell(sp);
  me := b[0].c[i];
  if s.area == RS_A_NONE {
    if target < 0 || target >= b[0].n || b[0].c[target].dead { return false; }
    if s.range_ft > 0 && rs_feet_to(b, i, target) > s.range_ft { return false; }
  } else if s.area != RS_A_CUBE_SELF {
    if rs_feet(me.x, me.y, tx, ty) > s.range_ft { return false; }
  }
  // spend
  if s.cast_time == RS_T_ACTION { b[0].turn.action = true; } else { b[0].turn.bonus = true; }
  if s.level > 0 { b[0].c[i].slots[slot] -= 1; b[0].turn.slot_spent = true; }
  if s.concentration { rs_end_concentration(b, i, ""); b[0].c[i].conc = sp; b[0].c[i].conc_until = b[0].clock + s.duration_s; }
  l: [1] RsLine;
  rs_add_name(l[..], b, i);
  rs_add_text(l[..], ifx s.part_of >= 0 then " hurls Produce Flame" else " casts ");
  if s.part_of < 0 { rs_add_text(l[..], s.name); }
  if s.level > 0 { rs_add_text(l[..], " ("); rs_add_text(l[..], RS_ORDINAL[slot]); rs_add_text(l[..], "-level slot)"); }
  if s.area == RS_A_NONE && target != i && s.range_ft > 0 { rs_add_text(l[..], " at "); rs_add_name(l[..], b, target); }
  if s.area == RS_A_NONE && target != i && s.range_ft == 5 { }
  rs_tell(b, RS_EV_CAST, sp, i, ifx s.area == RS_A_NONE then target else -1, slot, 0, l[..]);
  // the area, and what lasts in it
  area: RsZone;
  zone_at := -1;
  if s.area != RS_A_NONE {
    area = rs_area(b, i, s, tx, ty);
    area.spell = sp;
    area.until = b[0].clock + s.duration_s;
    for k: 0..<s.step_n { if s.steps[k].kind == RS_S_TERRAIN { area.difficult = true; } }
    if s.duration_s > 0 {
      for k: 0..<RS_ZONES { if zone_at < 0 && !b[0].zone[k].on { zone_at = k; } }
      if zone_at >= 0 { b[0].zone[zone_at] = area; }
    }
    ev: [1] RsLine; rs_add_text(ev[..], "");
    e: RsEvent; e.kind = RS_EV_ZONE; e.spell = sp; e.by = i; e.to = -1; e.x = area.x0; e.y = area.y0; e.amount = area.x1 - area.x0 + 1; e.at = b[0].clock;
    k := rs_emit(b[0].book[..], e);
  }
  for k: 0..<s.step_n { if s.steps[k].kind == RS_S_FLAME { b[0].c[i].flame_until = b[0].clock + s.duration_s; } }
  // rays and beams: the program runs once for each, at the one target
  reps := 1;
  for k: 0..<s.step_n {
    st := s.steps[k];
    if st.kind == RS_S_REPEAT { reps = st.a + st.b * rs_max(slot - s.level, 0); if st.c == 1 { reps = st.a * rs_cantrip_tier(me.level); } }
  }
  if s.area == RS_A_NONE && reps > 1 {
    for r: 0..<reps { if !b[0].c[target].dead { rs_affect(b, i, target, sp, slot, zone_at); } }
    return true;
  }
  // each creature it affects
  for j: 0..<b[0].n {
    if s.area == RS_A_NONE {
      if j != target { continue; }
    } else {
      if !rs_inside(area, b[0].c[j].x, b[0].c[j].y) || b[0].c[j].dead { continue; }
      if j == i { continue; }   // "each creature (other than you)"; a cube from you starts beside you
    }
    rs_affect(b, i, j, sp, slot, zone_at);
  }
  return true;
}

// Advantage (1), Disadvantage (-1) or neither on i's attack roll against j: every source the SRD
// names for what the battle tracks, cancelling as the SRD says. Uses up a pending EF_WEAK.
rs_attack_edge :: (b: [] RsBattle, i: int, j: int, melee: bool, strength: bool) -> int {
  ups := 0; downs := 0;
  t := b[0].clock;
  if b[0].c[j].outlined_by >= 0 && b[0].c[j].outlined_until > t { ups += 1; }
  if rs_has(b[0].c[j], RS_RESTRAINED) { ups += 1; }
  if rs_has(b[0].c[i], RS_RESTRAINED) { downs += 1; }
  if rs_has(b[0].c[i], RS_POISONED) { downs += 1; }
  if rs_has(b[0].c[i], RS_BLINDED) { downs += 1; }
  if rs_has(b[0].c[j], RS_BLINDED) { ups += 1; }
  if rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS) { ups += 1; }
  if rs_take_weak(b, i) { downs += 1; }
  if !melee && rs_threatened(b, i) { downs += 1; }
  if rs_has(b[0].c[j], RS_PRONE) { if melee && rs_feet_to(b, i, j) <= 5 { ups += 1; } else { downs += 1; } }
  // Reckless Attack: Advantage on its Strength attacks, and on attacks against it
  if b[0].c[j].reckless_until > t { ups += 1; }
  if strength && b[0].c[i].reckless_until > t { ups += 1; }
  // the Dodge action
  if b[0].c[j].dodge_until > t && rs_can_act(b[0].c[j]) { downs += 1; }
  return rs_edge(ups, downs);
}
// Rage's Resistance to Bludgeoning, Piercing and Slashing: half the damage, rounded down.
rs_resisted :: (b: [] RsBattle, j: int, amount: int, kind: int) -> int {
  if b[0].c[j].raging && (kind == RS_BLUDGEONING || kind == RS_PIERCING || kind == RS_SLASHING) { return amount / 2; }
  return amount;
}

// Advantage or Disadvantage on j's saving throw of an ability.
rs_save_edge :: (b: [] RsBattle, j: int, ability: int) -> int {
  ups := 0; downs := 0;
  c := b[0].c[j];
  if ability == RS_DEX && rs_has(c, RS_RESTRAINED) { downs += 1; }
  if ability == RS_STR && rs_effect(c, EF_ENFEEBLED) { downs += 1; }
  if ability == RS_STR && c.raging { ups += 1; }
  if ability == RS_DEX && c.danger_sense && !rs_has(c, RS_INCAPACITATED) && rs_can_act(c) { ups += 1; }
  if ability == RS_DEX && c.dodge_until > b[0].clock && rs_can_act(c) { ups += 1; }
  return rs_edge(ups, downs);
}

// The effect program on one creature.
rs_affect :: (b: [] RsBattle, i: int, j: int, sp: int, slot: int, zone_at: int) {
  s := rs_spell(sp);
  ran_save := false; saved := false; crit := false; attack_hit := false; tier_dice := true;
  for k: 0..<s.step_n { if s.steps[k].kind == RS_S_REPEAT && s.steps[k].c == 1 { tier_dice = false; } }
  for k: 0..<s.step_n {
    st := s.steps[k];
    if st.kind == RS_S_ATTACK {
      melee := st.a == 1;
      helpless := rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS);
      d := rs_d20(b[0].dice[..], rs_attack_edge(b, i, j, melee, false));
      total := d.roll + rs_spell_attack(b[0].c[i]);
      crit = d.roll == 20;
      hit := d.roll != 1 && (crit || total >= b[0].c[j].ac);
      // a hit on a Paralyzed or Unconscious creature from within 5 feet is a Critical Hit
      if hit && helpless && rs_feet_to(b, i, j) <= 5 { crit = true; }
      attack_hit = hit;
      l: [1] RsLine;
      rs_add_text(l[..], "  attack "); rs_add_int(l[..], d.roll);
      if d.edge > 0 { rs_add_text(l[..], " (Advantage)"); }
      if d.edge < 0 { rs_add_text(l[..], " (Disadvantage)"); }
      rs_add_text(l[..], " + "); rs_add_int(l[..], rs_spell_attack(b[0].c[i])); rs_add_text(l[..], " = "); rs_add_int(l[..], total);
      rs_add_text(l[..], " vs AC "); rs_add_int(l[..], b[0].c[j].ac);
      rs_add_text(l[..], ifx crit then ": critical hit" else ifx hit then ": hit" else ": miss");
      rs_tell(b, ifx hit then RS_EV_ATTACK else RS_EV_MISS, sp, i, j, total, 0, l[..]);
      if !hit { return; }
    } else if st.kind == RS_S_SAVE {
      ran_save = true;
      dc := rs_spell_dc(b[0].c[i]);
      fails := (rs_has(b[0].c[j], RS_UNCONSCIOUS) || rs_has(b[0].c[j], RS_PARALYZED)) && (st.a == RS_STR || st.a == RS_DEX);
      d := rs_d20(b[0].dice[..], rs_save_edge(b, j, st.a));
      total := d.roll + rs_save_bonus(b[0].c[j], st.a);
      saved = !fails && total >= dc;
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " ");
      rs_add_text(l[..], RS_ABBR[st.a]); rs_add_text(l[..], " save ");
      if fails { rs_add_text(l[..], ifx rs_has(b[0].c[j], RS_PARALYZED) then "fails (Paralyzed)" else "fails (Unconscious)"); }
      else { rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc); rs_add_text(l[..], ifx saved then ": success" else ": failure"); }
      rs_tell(b, RS_EV_SAVE, sp, i, j, total, 0, l[..]);
    } else if st.kind == RS_S_DAMAGE {
      count := st.a;
      if s.level == 0 && tier_dice { count = st.a * rs_cantrip_tier(b[0].c[i].level); }
      else { count += st.d * rs_max(slot - s.level, 0); }
      if crit { count *= 2; }
      amount := rs_sum(b[0].dice[..], count, st.b);
      if ran_save && saved { amount = ifx s.steps[0].kind == RS_S_SAVE && s.steps[0].b == RS_ON_SAVE_HALF then amount / 2 else 0; }
      // Agonizing Blast: the Charisma modifier on the chosen cantrip's damage
      agony := 0;
      if s.level == 0 && b[0].c[i].agonizing == sp && sp != SP_PRODUCE_FLAME { agony = rs_mod(b[0].c[i].score[RS_CHA]); amount += agony; }
      weak := 0;
      if rs_effect(b[0].c[i], EF_ENFEEBLED) { weak = rs_roll(b[0].dice[..], 8); amount = rs_max(amount - weak, 0); }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " takes "); rs_add_int(l[..], amount);
      rs_add_text(l[..], " "); rs_add_text(l[..], RS_DAMAGE[st.c]);
      rs_add_text(l[..], " ("); rs_add_int(l[..], count); rs_add_text(l[..], "d"); rs_add_int(l[..], st.b);
      if agony != 0 { rs_add_text(l[..], " + "); rs_add_int(l[..], agony); }
      if weak > 0 { rs_add_text(l[..], ", -"); rs_add_int(l[..], weak); rs_add_text(l[..], " enfeebled"); }
      rs_add_text(l[..], ")");
      if rs_resisted(b, j, amount, st.c) != amount { amount = rs_resisted(b, j, amount, st.c); rs_add_text(l[..], ", halved by Rage"); }
      rs_tell(b, RS_EV_DAMAGE, sp, i, j, amount, st.c, l[..]);
      // Hex: 1d6 Necrotic more when its caster hits the target with an attack roll
      hexed := false;
      if attack_hit {
        for ek: 0..<RS_EFFECTS { if b[0].c[j].eff[ek].kind == EF_HEX && b[0].c[j].eff[ek].by == i { hexed = true; } }
      }
      rs_damage(b, i, j, amount, st.c, crit, sp);
      if hexed && !b[0].c[j].dead {
        n6 := ifx crit then 2 else 1;
        extra := rs_sum(b[0].dice[..], n6, 6);
        h: [1] RsLine;
        rs_add_text(h[..], "  "); rs_add_name(h[..], b, j); rs_add_text(h[..], " takes "); rs_add_int(h[..], extra);
        rs_add_text(h[..], " Necrotic from Hex ("); rs_add_int(h[..], n6); rs_add_text(h[..], "d6)");
        rs_tell(b, RS_EV_DAMAGE, SP_HEX, i, j, extra, RS_NECROTIC, h[..]);
        rs_damage(b, i, j, extra, RS_NECROTIC, crit, SP_HEX);
      }
    } else if st.kind == RS_S_HEAL {
      count := st.a + st.d * rs_max(slot - s.level, 0);
      amount := rs_sum(b[0].dice[..], count, st.b);
      if st.c == 1 { amount += rs_mod(b[0].c[i].score[rs_max(b[0].c[i].spell_ability, 0)]); }
      was_down := b[0].c[j].hp == 0;
      h: [1] RsCreature; h[0] = b[0].c[j];
      got := rs_heal(h[..], amount);
      b[0].c[j] = h[0];
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " regains "); rs_add_int(l[..], got); rs_add_text(l[..], " Hit Points");
      if was_down && b[0].c[j].hp > 0 { rs_add_text(l[..], " and wakes"); }
      if rs_effect(b[0].c[j], EF_NOHEAL) { rs_add_text(l[..], ": the grave's chill stops it"); }
      rs_tell(b, RS_EV_HEAL, sp, i, j, got, 0, l[..]);
    } else if st.kind == RS_S_CONDITION {
      if ran_save && saved { continue; }
      b[0].c[j].cond = b[0].c[j].cond | st.a;
      if st.a == RS_RESTRAINED { b[0].c[j].restrained_by = zone_at; }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is ");
      rs_add_text(l[..], rs_condition_name(st.a));
      rs_tell(b, RS_EV_CONDITION, sp, i, j, st.a, 0, l[..]);
    } else if st.kind == RS_S_PUSH {
      if ran_save && saved { continue; }
      if !rs_up(b[0].c[j]) && b[0].c[j].dead { continue; }
      dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
      moved := 0;
      for n: 0..<(st.a / RS_SQUARE) {
        nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
        if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
        b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
      }
      if moved > 0 {
        l: [1] RsLine;
        rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is pushed "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
        rs_tell(b, RS_EV_PUSH, sp, i, j, moved * RS_SQUARE, 0, l[..]);
      }
    } else if st.kind == RS_S_OUTLINE {
      if ran_save && saved { continue; }
      b[0].c[j].outlined_by = i; b[0].c[j].outlined_until = b[0].c[i].conc_until;
      b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_INVISIBLE);
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is outlined: attacks against it have Advantage");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_TEMP {
      amount := rs_sum(b[0].dice[..], st.a, st.b) + st.c + st.d * rs_max(slot - s.level, 0);
      // Temporary Hit Points don't add up: keep the larger
      b[0].c[j].temp = rs_max(b[0].c[j].temp, amount);
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " gains "); rs_add_int(l[..], amount); rs_add_text(l[..], " Temporary Hit Points");
      rs_tell(b, RS_EV_HEAL, sp, i, j, amount, 0, l[..]);
    } else if st.kind == RS_S_NOHEAL {
      rs_put_effect(b, j, RsEffect.{kind = EF_NOHEAL, by = i, spell = sp, until = rs_after_next_turn(b, i), save = -1, dc = 0});
    } else if st.kind == RS_S_TIMED {
      // saved: a one-target concentration spell has nothing to hold, and ends
      if ran_save && saved { if s.concentration && s.area == RS_A_NONE && b[0].c[i].conc == sp { b[0].c[i].conc = -1; } continue; }
      e := RsEffect.{kind = EF_COND, cond = st.a, by = i, spell = sp, until = rs_after_next_turn(b, i), save = -1, dc = 0};
      if st.b == 2 { e.until = b[0].clock + s.duration_s; e.save = st.c; e.dc = rs_spell_dc(b[0].c[i]); }
      rs_put_effect(b, j, e);
      // Paralyzed (and so Incapacitated) breaks the target's own concentration
      if (st.a & (RS_PARALYZED | RS_INCAPACITATED | RS_STUNNED)) != 0 && b[0].c[j].conc >= 0 { rs_end_concentration(b, j, " (Incapacitated)"); }
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is "); rs_add_text(l[..], rs_condition_name(st.a));
      rs_add_text(l[..], ifx st.b == 1 then " until the end of " else " for up to a minute");
      if st.b == 1 { rs_add_name(l[..], b, i); rs_add_text(l[..], "'s next turn"); }
      rs_tell(b, RS_EV_CONDITION, sp, i, j, st.a, 0, l[..]);
    } else if st.kind == RS_S_ENFEEBLE {
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j);
      if saved {
        rs_put_effect(b, j, RsEffect.{kind = EF_WEAK, by = i, spell = sp, until = rs_before_next_turn(b, i), save = -1, dc = 0});
        rs_add_text(l[..], " shrugs it off: Disadvantage on its next attack roll");
        // nothing to hold: the spell ends
        if b[0].c[i].conc == sp { b[0].c[i].conc = -1; }
      } else {
        rs_put_effect(b, j, RsEffect.{kind = EF_ENFEEBLED, by = i, spell = sp, until = b[0].clock + s.duration_s, save = RS_CON, dc = rs_spell_dc(b[0].c[i])});
        rs_add_text(l[..], " is enfeebled: 1d8 off its damage, Disadvantage on Strength");
      }
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_HEX {
      rs_put_effect(b, j, RsEffect.{kind = EF_HEX, cond = st.a, by = i, spell = sp, until = b[0].c[i].conc_until, save = -1, dc = 0});
      b[0].c[i].hex_free = false;
      l: [1] RsLine;
      rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is hexed: 1d6 Necrotic more from each of ");
      rs_add_name(l[..], b, i); rs_add_text(l[..], "'s hits, Disadvantage on "); rs_add_text(l[..], RS_ABBR[st.a]); rs_add_text(l[..], " checks");
      rs_tell(b, RS_EV_CONDITION, sp, i, j, 0, 0, l[..]);
    } else if st.kind == RS_S_GLOW {
      b[0].c[j].wisp_until = b[0].c[i].turn_at + rs_beat(b);
      b[0].c[j].cond = rs_clear(b[0].c[j].cond, RS_INVISIBLE);
    }
  }
  // Repelling Blast: a hit with the chosen cantrip pushes the target up to 10 feet straight away
  if attack_hit && s.level == 0 && b[0].c[i].repelling == sp && sp != SP_PRODUCE_FLAME && !b[0].c[j].dead {
    dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
    moved := 0;
    for n: 0..<2 {
      nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
      if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
      b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
    }
    if moved > 0 {
      l: [1] RsLine;
      rs_add_text(l[..], "  Repelling Blast pushes "); rs_add_name(l[..], b, j); rs_add_text(l[..], " "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
      rs_tell(b, RS_EV_PUSH, sp, i, j, moved * RS_SQUARE, 0, l[..]);
    }
  }
}

// Hex moves to a new creature: a Bonus Action on a turn after the one its target dropped to 0 Hit
// Points, while the caster still concentrates on it; no slot.
rs_hex_move :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) { return false; }
  if b[0].c[i].conc != SP_HEX || !b[0].c[i].hex_free || b[0].c[i].turn_at <= b[0].c[i].hex_free_after { return false; }
  if j < 0 || j >= b[0].n || !rs_up(b[0].c[j]) || rs_feet_to(b, i, j) > rs_spell(SP_HEX).range_ft { return false; }
  ability := RS_STR;
  for jj: 0..<b[0].n {
    for k: 0..<RS_EFFECTS {
      if b[0].c[jj].eff[k].kind == EF_HEX && b[0].c[jj].eff[k].by == i { ability = b[0].c[jj].eff[k].cond; rs_drop_effect(b, jj, k); }
    }
  }
  b[0].turn.bonus = true;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " moves Hex to "); rs_add_name(l[..], b, j);
  rs_tell(b, RS_EV_CAST, SP_HEX, i, j, 0, 0, l[..]);
  rs_put_effect(b, j, RsEffect.{kind = EF_HEX, cond = ability, by = i, spell = SP_HEX, until = b[0].c[i].conc_until, save = -1, dc = 0});
  b[0].c[i].hex_free = false;
  return true;
}

// A Restrained creature's action against what holds it: a Strength (Athletics) check against the
// caster's spell save DC (Entangle).
rs_escape :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_has(b[0].c[i], RS_RESTRAINED) { return false; }
  z := b[0].c[i].restrained_by;
  if z < 0 || !b[0].zone[z].on { return false; }
  b[0].turn.action = true;
  dc := rs_spell_dc(b[0].c[b[0].zone[z].by]);
  downs := ifx rs_has(b[0].c[i], RS_POISONED) || rs_effect(b[0].c[i], EF_ENFEEBLED) then 1 else 0;
  for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind == EF_HEX && b[0].c[i].eff[k].cond == RS_STR { downs += 1; } }
  d := rs_d20(b[0].dice[..], rs_edge(ifx b[0].c[i].raging then 1 else 0, downs));
  total := d.roll + rs_mod(b[0].c[i].score[RS_STR]);
  ok := total >= dc;
  if ok { b[0].c[i].restrained_by = -1; b[0].c[i].cond = rs_clear(b[0].c[i].cond, RS_RESTRAINED); }
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " strains against the plants: STR (Athletics) "); rs_add_int(l[..], total);
  rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc); rs_add_text(l[..], ifx ok then ": free" else ": still held");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, total, 0, l[..]);
  return ok;
}

// One square of movement: 5 feet, 10 into Difficult Terrain; none while Restrained or at 0.
rs_step_to :: (b: [] RsBattle, i: int, x: int, y: int) -> bool {
  if b[0].who != i || !rs_can_act(b[0].c[i]) || rs_has(b[0].c[i], RS_RESTRAINED) { return false; }
  if rs_feet(b[0].c[i].x, b[0].c[i].y, x, y) != RS_SQUARE { return false; }
  if x < 0 || y < 0 || x >= b[0].w || y >= b[0].h || rs_at(b, x, y) >= 0 { return false; }
  cost := ifx rs_difficult(b, x, y) then 2 else 1;
  if b[0].turn.move_left < cost { return false; }
  b[0].turn.move_left -= cost;
  b[0].c[i].x = x; b[0].c[i].y = y;
  return true;
}

// The start of i's turn: what has run out ends, a creature at 0 makes its death saving throw, a
// Prone one stands (half its Speed).
rs_start_turn :: (b: [] RsBattle, i: int) {
  b[0].who = i;
  // a beat moves its share of a round's Speed (at least a square)
  squares := rs_max(cast(int) (f32(b[0].c[i].speed / RS_SQUARE) * rs_beat(b) / f32(RS_ROUND) + 0.5), 1);
  b[0].turn = RsTurn.{action = false, bonus = false, slot_spent = false, move_left = squares};
  b[0].turn.new_round = b[0].c[i].turn_at >= b[0].c[i].round_at - 0.01;
  if b[0].turn.new_round { b[0].c[i].round_at += f32(RS_ROUND); }
  b[0].c[i].reacted = false;
  if b[0].c[i].raging && !rs_can_act(b[0].c[i]) { rs_rage_end(b, i, " (Incapacitated)"); }
  if b[0].c[i].hp == 0 && !b[0].c[i].dead {
    if b[0].c[i].stable || !b[0].turn.new_round { return; }
    c: [1] RsCreature; c[0] = b[0].c[i];
    r := rs_death_save(b[0].dice[..], c[..]);
    b[0].c[i] = c[0];
    l: [1] RsLine;
    rs_add_name(l[..], b, i);
    if r == RS_DS_UP { rs_add_text(l[..], " rolls a 20 on a death save and is back up with 1 Hit Point"); }
    else if r == RS_DS_STABLE { rs_add_text(l[..], " is Stable (three death save successes)"); }
    else if r == RS_DS_DEAD { rs_add_text(l[..], " dies (three death save failures)"); }
    else { rs_add_text(l[..], ifx r == RS_DS_OK then " death save: success (" else " death save: failure (");
           rs_add_int(l[..], b[0].c[i].death_ok); rs_add_text(l[..], " of 3 successes, "); rs_add_int(l[..], b[0].c[i].death_fail); rs_add_text(l[..], " of 3 failures)"); }
    rs_tell(b, ifx r == RS_DS_DEAD then RS_EV_DEATH else ifx r == RS_DS_UP then RS_EV_UP else RS_EV_STABLE, -1, i, i, r, 0, l[..]);
    if r != RS_DS_UP { return; }
  }
  if rs_has(b[0].c[i], RS_PRONE) && rs_can_act(b[0].c[i]) {
    b[0].c[i].cond = rs_clear(b[0].c[i].cond, RS_PRONE);
    b[0].turn.move_left = b[0].turn.move_left / 2;
  }
}
rs_end_turn :: (b: [] RsBattle, i: int) {
  // the saves it repeats at the end of its turns
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.kind == EF_NONE || e.save < 0 || b[0].c[i].dead || !b[0].turn.new_round { continue; }
    d := rs_d20(b[0].dice[..], 0);
    total := d.roll + rs_save_bonus(b[0].c[i], e.save);
    ok := total >= e.dc;
    l: [1] RsLine;
    rs_add_name(l[..], b, i); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[e.save]); rs_add_text(l[..], " save against ");
    rs_add_text(l[..], rs_spell(e.spell).name); rs_add_text(l[..], " "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], e.dc);
    rs_add_text(l[..], ifx ok then ": it ends" else ": it holds");
    rs_tell(b, RS_EV_SAVE, e.spell, e.by, i, total, 0, l[..]);
    if ok {
      rs_drop_effect(b, i, k);
      // a spell that ends on a success ends for its caster too (Ray of Enfeeblement)
      if e.kind == EF_ENFEEBLED && e.by >= 0 && b[0].c[e.by].conc == e.spell { rs_end_concentration(b, e.by, " (the target shook it off)"); }
      // a concentration spell with no one left under it ends (Hold Person on one target)
      if e.by >= 0 && b[0].c[e.by].conc == e.spell {
        left := 0;
        for jj: 0..<b[0].n { for kk: 0..<RS_EFFECTS { if b[0].c[jj].eff[kk].kind != EF_NONE && b[0].c[jj].eff[kk].by == e.by && b[0].c[jj].eff[kk].spell == e.spell { left += 1; } } }
        if left == 0 { rs_end_concentration(b, e.by, " (no one left under it)"); }
      }
    }
  }
  // Rage lasts until the end of its next turn; an attack roll against an enemy (or a Bonus Action)
  // in that turn extends it
  if b[0].turn.struck { b[0].c[i].struck_round = true; }
  if b[0].c[i].raging && b[0].turn.new_round {
    if b[0].c[i].rage_kept || b[0].c[i].struck_round { b[0].c[i].rage_kept = false; }
    else { rs_rage_end(b, i, ""); }
  }
  if b[0].turn.new_round { b[0].c[i].struck_round = false; }
  b[0].c[i].turn_at += rs_beat(b);
  if b[0].who == i { b[0].who = -1; }
}
// The clock moves on: what lasts for a time ends when it runs out.
rs_tick :: (b: [] RsBattle, dt: f32) {
  b[0].clock += dt;
  t := b[0].clock;
  for i: 0..<b[0].n {
    if b[0].c[i].conc >= 0 && b[0].c[i].conc_until <= t { rs_end_concentration(b, i, " (its duration is up)"); }
    if b[0].c[i].flame_until > 0 && b[0].c[i].flame_until <= t { b[0].c[i].flame_until = 0; }
    if b[0].c[i].outlined_by >= 0 && b[0].c[i].outlined_until <= t { b[0].c[i].outlined_by = -1; }
    for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind != EF_NONE && b[0].c[i].eff[k].until <= t { rs_drop_effect(b, i, k); } }
    // the action adapter: spent slots and uses come back on a cooldown, one at a time
    if b[0].recharge > 0 && !b[0].c[i].dead {
      r := b[0].recharge;
      for l: 1..<10 {
        if b[0].c[i].slots[l] >= b[0].c[i].slots_max[l] { b[0].c[i].slot_back[l] = 0; continue; }
        if b[0].c[i].slot_back[l] == 0 { b[0].c[i].slot_back[l] = t + r; }
        else if b[0].c[i].slot_back[l] <= t { b[0].c[i].slots[l] += 1; b[0].c[i].slot_back[l] = 0; }
      }
      if b[0].c[i].rages < b[0].c[i].rages_max {
        if b[0].c[i].rage_back == 0 { b[0].c[i].rage_back = t + r; }
        else if b[0].c[i].rage_back <= t { b[0].c[i].rages += 1; b[0].c[i].rage_back = 0; }
      } else { b[0].c[i].rage_back = 0; }
      if b[0].c[i].focus < b[0].c[i].focus_max {
        if b[0].c[i].focus_back == 0 { b[0].c[i].focus_back = t + r / 2; }
        else if b[0].c[i].focus_back <= t { b[0].c[i].focus += 1; b[0].c[i].focus_back = 0; }
      } else { b[0].c[i].focus_back = 0; }
    }
  }
}
rs_team_up :: (b: [] RsBattle, team: int) -> int {
  n := 0;
  for i: 0..<b[0].n { if b[0].c[i].team == team && rs_up(b[0].c[i]) { n += 1; } }
  return n;
}

// ---- weapons and martial features

rs_rage_end :: (b: [] RsBattle, i: int, why: string) {
  if !b[0].c[i].raging { return; }
  b[0].c[i].raging = false; b[0].c[i].rage_kept = false;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], "'s Rage ends"); rs_add_text(l[..], why);
  rs_tell(b, RS_EV_END, -1, i, -1, 0, 0, l[..]);
}
// Rage: a Bonus Action, one of its uses. While it lasts: Resistance to Bludgeoning, Piercing and
// Slashing, its Rage Damage on Strength attacks, Advantage on Strength checks and saves, no
// Concentration and no spells.
rs_rage :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].rages <= 0 || b[0].c[i].raging { return false; }
  b[0].turn.bonus = true;
  b[0].c[i].rages -= 1; b[0].c[i].raging = true; b[0].c[i].rage_kept = true;
  rs_end_concentration(b, i, " (Rage)");
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " enters a Rage");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  return true;
}

// One attack roll with i's weapon at j, and its damage. `bare` drops the ability modifier from the
// damage (Cleave's second attack); `frenzy` lets the Berserker's Frenzy add its dice. True on a hit.
rs_strike :: (b: [] RsBattle, i: int, j: int, w: int, bare: bool) -> bool {
  wp := rs_weapon(w);
  me := b[0].c[i];
  ab := rs_attack_ability(me, w);
  strength := ab == RS_STR;
  b[0].turn.struck = true;
  d := rs_d20(b[0].dice[..], rs_attack_edge(b, i, j, true, strength));
  bonus := rs_weapon_attack(me, w);
  total := d.roll + bonus;
  crit := d.roll == 20;
  hit := d.roll != 1 && (crit || total >= b[0].c[j].ac);
  if hit && (rs_has(b[0].c[j], RS_PARALYZED) || rs_has(b[0].c[j], RS_UNCONSCIOUS)) { crit = true; }
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " attacks "); rs_add_name(l[..], b, j); rs_add_text(l[..], " with ");
  rs_add_text(l[..], ifx w == W_UNARMED then "an Unarmed Strike" else wp.name);
  rs_add_text(l[..], ": "); rs_add_int(l[..], d.roll);
  if d.edge > 0 { rs_add_text(l[..], " (Advantage)"); }
  if d.edge < 0 { rs_add_text(l[..], " (Disadvantage)"); }
  rs_add_text(l[..], " + "); rs_add_int(l[..], bonus); rs_add_text(l[..], " = "); rs_add_int(l[..], total);
  rs_add_text(l[..], " vs AC "); rs_add_int(l[..], b[0].c[j].ac);
  rs_add_text(l[..], ifx crit then ": critical hit" else ifx hit then ": hit" else ": miss");
  rs_tell(b, ifx hit then RS_EV_ATTACK else RS_EV_MISS, -1, i, j, total, 0, l[..]);
  if !hit { return false; }
  // the damage: the weapon's dice (a Monk's Martial Arts die unarmed; 1 + Strength for anyone else)
  ndice := wp.dice; sides := wp.sides;
  if w == W_UNARMED && me.martial_die > 0 { ndice = 1; sides = me.martial_die; }
  mult := ifx crit then 2 else 1;
  rolled := ifx ndice > 0 then rs_sum(b[0].dice[..], ndice * mult, sides) else 1;
  mod := rs_mod(me.score[ab]);
  amount := rolled;
  if !bare || mod < 0 { amount += mod; }
  rage := 0;
  if me.raging && strength { rage = me.rage_bonus; amount += rage; }
  frenzy := 0;
  if me.frenzy && me.raging && strength && me.reckless_until > b[0].clock && !b[0].turn.frenzied {
    b[0].turn.frenzied = true;
    frenzy = rs_sum(b[0].dice[..], me.rage_bonus * mult, 6); amount += frenzy;
  }
  weak := 0;
  if rs_effect(me, EF_ENFEEBLED) { weak = rs_roll(b[0].dice[..], 8); amount = rs_max(amount - weak, 0); }
  amount = rs_max(amount, 0);
  dl: [1] RsLine;
  rs_add_text(dl[..], "  "); rs_add_name(dl[..], b, j); rs_add_text(dl[..], " takes ");
  // Deflect Attacks: a Monk's Reaction cuts Bludgeoning, Piercing or Slashing damage from a hit
  cut := 0;
  tg := b[0].c[j];
  if tg.deflect && !tg.reacted && rs_can_act(tg) && (wp.damage == RS_BLUDGEONING || wp.damage == RS_PIERCING || wp.damage == RS_SLASHING) {
    b[0].c[j].reacted = true;
    cut = rs_roll(b[0].dice[..], 10) + rs_mod(tg.score[RS_DEX]) + tg.level;
  }
  dealt := rs_max(amount - cut, 0);
  dealt = rs_resisted(b, j, dealt, wp.damage);
  rs_add_int(dl[..], dealt); rs_add_text(dl[..], " "); rs_add_text(dl[..], RS_DAMAGE[wp.damage]); rs_add_text(dl[..], " (");
  if ndice > 0 { rs_add_int(dl[..], ndice * mult); rs_add_text(dl[..], "d"); rs_add_int(dl[..], sides); } else { rs_add_text(dl[..], "1"); }
  if !bare || mod < 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], mod); }
  if rage > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], rage); rs_add_text(dl[..], " Rage"); }
  if frenzy > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], frenzy); rs_add_text(dl[..], " Frenzy"); }
  if weak > 0 { rs_add_text(dl[..], ", -"); rs_add_int(dl[..], weak); rs_add_text(dl[..], " enfeebled"); }
  if cut > 0 { rs_add_text(dl[..], ", Deflect Attacks -"); rs_add_int(dl[..], cut); }
  if tg.raging && dealt != rs_max(amount - cut, 0) { rs_add_text(dl[..], ", halved by Rage"); }
  rs_add_text(dl[..], ")");
  rs_tell(b, RS_EV_DAMAGE, -1, i, j, dealt, wp.damage, dl[..]);
  rs_damage(b, i, j, dealt, wp.damage, crit, -1);
  // Hex holds for any attack roll its caster hits with
  for ek: 0..<RS_EFFECTS {
    if b[0].c[j].eff[ek].kind == EF_HEX && b[0].c[j].eff[ek].by == i && !b[0].c[j].dead {
      extra := rs_sum(b[0].dice[..], mult, 6);
      h: [1] RsLine;
      rs_add_text(h[..], "  "); rs_add_name(h[..], b, j); rs_add_text(h[..], " takes "); rs_add_int(h[..], extra); rs_add_text(h[..], " Necrotic from Hex");
      rs_tell(b, RS_EV_DAMAGE, SP_HEX, i, j, extra, RS_NECROTIC, h[..]);
      rs_damage(b, i, j, extra, RS_NECROTIC, crit, SP_HEX);
    }
  }
  // all damage cut away: the Monk may spend a Focus Point to send the force back at a melee attacker
  if cut > 0 && amount - cut <= 0 && b[0].c[j].focus > 0 && rs_up(b[0].c[j]) && rs_up(b[0].c[i]) {
    b[0].c[j].focus -= 1;
    sd := rs_d20(b[0].dice[..], rs_save_edge(b, i, RS_DEX));
    st := sd.roll + rs_save_bonus(b[0].c[i], RS_DEX);
    dc := rs_focus_dc(b[0].c[j]);
    rl: [1] RsLine;
    rs_add_name(rl[..], b, j); rs_add_text(rl[..], " redirects the blow: "); rs_add_name(rl[..], b, i);
    rs_add_text(rl[..], " DEX save "); rs_add_int(rl[..], st); rs_add_text(rl[..], " vs DC "); rs_add_int(rl[..], dc);
    if st >= dc { rs_add_text(rl[..], ": success"); rs_tell(b, RS_EV_SAVE, -1, j, i, st, 0, rl[..]); }
    else {
      back := rs_sum(b[0].dice[..], 2, b[0].c[j].martial_die) + rs_mod(b[0].c[j].score[RS_DEX]);
      rs_add_text(rl[..], ": failure, "); rs_add_int(rl[..], back); rs_add_text(rl[..], " "); rs_add_text(rl[..], RS_DAMAGE[wp.damage]);
      rs_tell(b, RS_EV_DAMAGE, -1, j, i, back, wp.damage, rl[..]);
      rs_damage(b, j, i, rs_resisted(b, i, back, wp.damage), wp.damage, false, -1);
    }
  }
  return true;
}

// The Attack action: one attack with its weapon at j (5 feet away). `reckless` attacks recklessly
// (a Barbarian's first attack in a turn); `cleave_to`, when the weapon's Cleave mastery applies, is
// a second creature within 5 feet of j and of the attacker (-1 none).
rs_attack :: (b: [] RsBattle, i: int, j: int, reckless: bool, cleave_to: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || j == i || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.action = true;
  w := b[0].c[i].weapon;
  if reckless && b[0].c[i].level >= 2 && b[0].c[i].klass == RS_BARBARIAN && b[0].c[i].reckless_until <= b[0].clock {
    b[0].c[i].reckless_until = rs_before_next_turn(b, i) + 0.01;
    l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " attacks recklessly");
    rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  }
  hit := rs_strike(b, i, j, w, false);
  wp := rs_weapon(w);
  k := cleave_to;
  if hit && wp.mastery == M_CLEAVE && (b[0].c[i].masteries & (1 << M_CLEAVE)) != 0 && !b[0].turn.cleaved && k >= 0 && k != j && k != i
     && !b[0].c[k].dead && b[0].c[k].team != b[0].c[i].team && rs_feet_to(b, i, k) <= 5 && rs_feet_to(b, j, k) <= 5 {
    b[0].turn.cleaved = true;
    l: [1] RsLine; rs_add_text(l[..], "  Cleave carries on into "); rs_add_name(l[..], b, k);
    rs_tell(b, RS_EV_CONDITION, -1, i, k, 0, 0, l[..]);
    ok := rs_strike(b, i, k, w, true);
  }
  return true;
}

// Martial Arts: an Unarmed Strike as a Bonus Action.
rs_bonus_strike :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].martial_die <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.bonus = true;
  ok := rs_strike(b, i, j, W_UNARMED, false);
  return true;
}
// Open Hand Technique, on a creature hit by Flurry of Blows.
OH_ADDLE :: 0; OH_PUSH :: 1; OH_TOPPLE :: 2;
rs_open_hand :: (b: [] RsBattle, i: int, j: int, how: int) {
  if !b[0].c[i].open_hand || b[0].c[j].dead || b[0].c[j].hp == 0 { return; }
  l: [1] RsLine;
  if how == OH_ADDLE {
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is addled: no Opportunity Attacks until its next turn");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, 0, 0, l[..]);
    return;
  }
  ab := ifx how == OH_PUSH then RS_STR else RS_DEX;
  dc := rs_focus_dc(b[0].c[i]);
  fails := (rs_has(b[0].c[j], RS_UNCONSCIOUS) || rs_has(b[0].c[j], RS_PARALYZED));
  d := rs_d20(b[0].dice[..], rs_save_edge(b, j, ab));
  total := d.roll + rs_save_bonus(b[0].c[j], ab);
  saved := !fails && total >= dc;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[ab]); rs_add_text(l[..], " save ");
  rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
  if saved { rs_add_text(l[..], ": success"); rs_tell(b, RS_EV_SAVE, -1, i, j, total, 0, l[..]); return; }
  if how == OH_TOPPLE {
    b[0].c[j].cond = b[0].c[j].cond | RS_PRONE;
    rs_add_text(l[..], ": knocked Prone");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, RS_PRONE, 0, l[..]);
    return;
  }
  dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
  moved := 0;
  for n: 0..<3 {
    nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
    if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
    b[0].c[j].x = nx; b[0].c[j].y = ny; moved += 1;
  }
  rs_add_text(l[..], ": pushed "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
  rs_tell(b, RS_EV_PUSH, -1, i, j, moved * RS_SQUARE, 0, l[..]);
}
// Flurry of Blows: 1 Focus Point, two Unarmed Strikes as a Bonus Action; each hit can carry an
// Open Hand Technique.
rs_flurry :: (b: [] RsBattle, i: int, j: int, how: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { return false; }
  b[0].turn.bonus = true; b[0].c[i].focus -= 1;
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Flurry of Blows");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  for k: 0..<2 {
    if b[0].c[j].dead || rs_feet_to(b, i, j) > 5 { break; }
    if rs_strike(b, i, j, W_UNARMED, false) { rs_open_hand(b, i, j, how); }
  }
  return true;
}
// Patient Defense with a Focus Point: Disengage and Dodge as a Bonus Action.
rs_patient_defense :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus <= 0 { return false; }
  b[0].turn.bonus = true; b[0].c[i].focus -= 1;
  b[0].c[i].dodge_until = rs_before_next_turn(b, i);
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Patient Defense: Disengage and Dodge");
  rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  return true;
}
// Step of the Wind without a Focus Point: Dash as a Bonus Action (its Speed again).
rs_step_of_the_wind :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].focus_max <= 0 { return false; }
  b[0].turn.bonus = true;
  b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE;
  return true;
}
// The Dash action: its Speed again.
rs_dash :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) { return false; }
  b[0].turn.action = true;
  b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE;
  return true;
}

#test "Starry Wisp: a ranged spell attack, +5, 1d8 Radiant on a hit" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 11;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  t := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 1);
  hits := 0; total := 0;
  for k: 0..<200 {
    b[0].c[t].hp = b[0].c[t].hp_max; b[0].c[t].cond = 0;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);
    #assert !rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);   // one action a turn
    rs_end_turn(b[..], a);
    lost := b[0].c[t].hp_max - b[0].c[t].hp;
    #assert lost >= 0 && lost <= 16;
    if lost > 0 { hits += 1; total += lost; }
  }
  // +5 against AC 15: 11 or higher hits, 55% (a 20 crits)
  #assert hits > 80 && hits < 140;
}
#test "Cure Wounds heals 2d8 + 3 by touch; a 2nd-level slot heals 4d8 + 3; one slot a turn" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  f := rs_add(b[..], rs_druid("Briar", 0, 3), 2, 1);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 1);
  b[0].c[f].hp = 1;
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, far);   // Touch
  #assert rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, f);
  #assert b[0].c[f].hp >= 1 + 5 && b[0].c[f].hp <= 1 + 19 && b[0].c[a].slots[1] == 3;
  #assert !rs_cast(b[..], a, SP_HEALING_WORD, 1, 0, 0, f);    // the one slot this turn is spent
  rs_end_turn(b[..], a);
  b[0].c[f].hp = 0; b[0].c[f].cond = RS_UNCONSCIOUS | RS_PRONE;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEALING_WORD, 2, 0, 0, f);
  #assert b[0].c[f].hp >= 4 + 3 && !rs_has(b[0].c[f], RS_UNCONSCIOUS) && b[0].c[a].slots[2] == 1;
}
#test "Thunderwave: a 15-foot cube from you, Con save, 2d8 Thunder and pushed 10 feet on a failure" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 3, 3);
  out := rs_add(b[..], rs_druid("Sable", 1, 3), 7, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_THUNDERWAVE, 1, 3, 3, -1);
  lost := b[0].c[e].hp_max - b[0].c[e].hp;
  #assert lost >= 1 && lost <= 16;
  #assert b[0].c[e].x == 3 || b[0].c[e].x == 5;          // stayed (saved) or pushed two squares
  #assert b[0].c[out].hp == b[0].c[out].hp_max;          // outside the cube
}
#test "Entangle restrains on a failed Strength save; concentration ends it and lets go" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  held := 0;
  for k: 0..<20 {
    for j: 0..<RS_ZONES { b[0].zone[j].on = false; }
    b[0].n = 1; b[0].c[a].conc = -1;
    e := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 3);
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ENTANGLE, 1 + k % 2, 8, 3, -1);
    if rs_has(b[0].c[e], RS_RESTRAINED) {
      held += 1;
      #assert rs_difficult(b[..], 8, 3);
      rs_end_concentration(b[..], a, "");
      #assert !rs_has(b[0].c[e], RS_RESTRAINED) && !rs_difficult(b[..], 8, 3);
    }
    b[0].c[a].slots[1] = 4; b[0].c[a].slots[2] = 2;
    rs_end_turn(b[..], a);
  }
  // Str +0 against DC 13: fails on 12 or lower, 60%
  #assert held >= 6 && held <= 18;
}
#test "Chill Touch: a melee spell attack; on a hit 1d10 Necrotic and no healing until the end of the caster's next turn" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 31;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 3, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 4, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, far);   // Touch
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 10; b[0].who = a; b[0].turn.action = false;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    if b[0].c[t].hp < 10 { hit = true; break; }
  }
  #assert hit && rs_effect(b[0].c[t], EF_NOHEAL);
  hp := b[0].c[t].hp;
  c: [1] RsCreature; c[0] = b[0].c[t];
  #assert rs_heal(c[..], 5) == 0;
  rs_end_turn(b[..], a);
  rs_tick(b[..], f32(RS_ROUND) + 0.1);
  #assert !rs_effect(b[0].c[t], EF_NOHEAL);
}
#test "Ray of Sickness poisons until the end of the caster's next turn; a Poisoned attacker has Disadvantage" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 41;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  got := false;
  for k: 0..<20 {
    b[0].c[t].hp = 21; b[0].c[a].slots[1] = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_SICKNESS, 1, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_POISONED) { got = true; break; }
  }
  #assert got;
  // still Poisoned until the caster's next turn has ended
  rs_tick(b[..], b[0].c[a].turn_at - 0.5 - b[0].clock);
  #assert rs_has(b[0].c[t], RS_POISONED);
  rs_tick(b[..], 0.7);
  #assert !rs_has(b[0].c[t], RS_POISONED);
}
#test "False Life: 2d4 + 4 Temporary Hit Points, 5 more a slot level above 1" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 1, 0, 0, a) && b[0].c[a].temp >= 6 && b[0].c[a].temp <= 12;
  rs_end_turn(b[..], a); b[0].c[a].temp = 0;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 2, 0, 0, a) && b[0].c[a].temp >= 11 && b[0].c[a].temp <= 17;
}
#test "Ray of Enfeeblement: on a failed Con save the target's damage loses 1d8, until it saves at the end of a turn" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 77;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_ENFEEBLEMENT, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_effect(b[0].c[t], EF_ENFEEBLED) { held = true; break; }
    #assert rs_effect(b[0].c[t], EF_WEAK) && b[0].c[a].conc < 0;
  }
  #assert held && b[0].c[a].conc == SP_RAY_OF_ENFEEBLEMENT;
  // concentration broken: it ends
  rs_end_concentration(b[..], a, "");
  #assert !rs_effect(b[0].c[t], EF_ENFEEBLED);
}
#test "Blindness/Deafness: Blinded on a failed save; attacks against it have Advantage; it saves to end it" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 13;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  blind := false;
  for k: 0..<20 {
    b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_BLINDNESS, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_BLINDED) { blind = true; break; }
  }
  #assert blind;
  ended := false;
  for k: 0..<40 { rs_start_turn(b[..], t); rs_end_turn(b[..], t); if !rs_has(b[0].c[t], RS_BLINDED) { ended = true; break; } }
  #assert ended;
}
#test "Produce Flame: the flame first (a Bonus Action), then a Magic action to hurl it" {
  b: [1] RsBattle; b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert rs_cast(b[..], a, SP_PRODUCE_FLAME, 0, 0, 0, a);
  #assert rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert b[0].c[a].flame_until > b[0].clock;
}
#test "Eldritch Blast: 1d10 Force + Cha (Agonizing Blast), and a hit pushes 10 feet (Repelling Blast)" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 6, 3);
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 6; b[0].c[t].y = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    rs_end_turn(b[..], a);
    if b[0].c[t].hp < 21 { hit = true; break; }
  }
  #assert hit && b[0].c[t].x == 8;
  lost := 21 - b[0].c[t].hp;
  #assert lost >= 1 + 3 && lost <= 20 + 3;
  // one beam at level 3, two at 5: each its own attack
  #assert rs_cantrip_tier(3) == 1;
}
#test "Hex: 1d6 Necrotic more on each hit; it moves on a later turn once its target drops" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  u := rs_add(b[..], rs_druid("Fern", 0, 3), 10, 6);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEX, 2, 0, 0, t) && b[0].c[a].conc == SP_HEX && b[0].c[a].slots[2] == 1;
  #assert !rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, u);   // one slot a turn
  #assert rs_effect(b[0].c[t], EF_HEX);
  extra := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 10; b[0].c[t].y = 3; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.spell == SP_HEX && ev.kind == RS_EV_DAMAGE { extra = true; } }
    if extra { break; }
  }
  #assert extra;
  // it drops: not this turn, the next one
  b[0].c[t].hp = 1; b[0].c[t].temp = 0;
  rs_damage(b[..], a, t, 5, RS_FORCE, false, SP_ELDRITCH_BLAST);
  #assert b[0].c[t].hp == 0 && b[0].c[a].hex_free;
  #assert !rs_hex_move(b[..], a, u);
  rs_end_turn(b[..], a);
  rs_tick(b[..], b[0].c[a].turn_at - b[0].clock);
  rs_start_turn(b[..], a);
  #assert rs_hex_move(b[..], a, u) && rs_effect(b[0].c[u], EF_HEX) && !rs_effect(b[0].c[t], EF_HEX) && b[0].c[a].slots[2] == 1;
}
#test "Hold Person: Paralyzed on a failed Wis save; it fails Dex saves, and a hit from 5 feet is a Critical Hit" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[t].cond = 0; b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_PARALYZED) { held = true; break; }
    #assert b[0].c[a].conc < 0;   // saved: nothing to hold
  }
  #assert held && !rs_can_act(b[0].c[t]) && b[0].c[a].conc == SP_HOLD_PERSON;
  // a melee hit from 5 feet: a Critical Hit (two dice of Chill Touch)
  crit := false;
  for k: 0..<10 {
    b[0].c[t].hp = 21; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) {
      ev := rs_recent(b[0].book[0], e);
      if ev.kind == RS_EV_ATTACK { crit = ev.text_n > 12 && cast(string) ev.text[(ev.text_n - 12)..<ev.text_n] == "critical hit"; #assert crit; }
    }
    if crit { break; }
  }
  #assert crit;
  // its concentration ends: it can move again
  rs_end_concentration(b[..], a, "");
  #assert !rs_has(b[0].c[t], RS_PARALYZED);
}
#test "Scorching Ray: three rays, a ranged spell attack each, 2d6 Fire on a hit; four from a 3rd-level slot" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 2;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 5, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  rs_start_turn(b[..], a);
  seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 3, 0, 0, t);
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { rolls += 1; } }
  #assert rolls == 4;
}
#test "Dark One's Blessing: Cha + Warlock level Temporary Hit Points when it drops a foe, or one drops within 10 feet" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 4;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  near := rs_add(b[..], rs_druid("Rowan", 0, 3), 3, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 12, 3);
  ally := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 13, 6);
  b[0].c[far].hp = 1;
  rs_damage(b[..], ally, far, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 0 && b[0].c[ally].temp == 3 + 3;
  b[0].c[near].hp = 1;
  rs_damage(b[..], ally, near, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 6;
}
#test "Rage: a Bonus Action; +2 damage on Greataxe hits, Bludgeoning/Piercing/Slashing halved; it ends on a turn without an attack" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 12;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a) && b[0].c[a].raging && b[0].c[a].rages == 2 && !rs_rage(b[..], a);
  // a monk's 1d6 + 3 Bludgeoning is halved
  b[0].c[m].deflect = false;
  rs_end_turn(b[..], a);
  got := false;
  for k: 0..<20 {
    b[0].c[a].hp = 32;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_attack(b[..], m, a, false, -1);
    rs_end_turn(b[..], m);
    if b[0].c[a].hp < 32 { #assert 32 - b[0].c[a].hp <= 9 / 2 + 3; got = true; break; }
  }
  #assert got && b[0].c[a].raging;
  // its own turn passes with an attack: it holds; a turn without one: it ends
  rs_start_turn(b[..], a);
  #assert rs_attack(b[..], a, m, false, -1);
  rs_end_turn(b[..], a);
  #assert b[0].c[a].raging;
  rs_start_turn(b[..], a);
  rs_end_turn(b[..], a);
  #assert !b[0].c[a].raging;
}
#test "Reckless Attack: Advantage on its Strength attacks and on attacks against it; Frenzy adds 2d6 to the first hit" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 8;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a);
  #assert rs_attack(b[..], a, m, true, -1);
  #assert b[0].c[a].reckless_until > b[0].clock;
  #assert rs_attack_edge(b[..], m, a, true, false) == 1;
  frenzy := false;
  for k: 0..<10 {
    ev := rs_recent(b[0].book[0], k);
    if ev.kind == RS_EV_DAMAGE { s := cast(string) ev.text[0..<ev.text_n]; for c: 0..<(ev.text_n - 6) { if s[c..<(c + 6)] == "Frenzy" { frenzy = true; } } }
    if ev.kind == RS_EV_MISS { frenzy = true; }   // a miss: nothing to add
  }
  #assert frenzy;
  rs_end_turn(b[..], a);
  // gone at the start of its next turn
  rs_tick(b[..], b[0].c[a].turn_at - b[0].clock);
  #assert b[0].c[a].reckless_until <= b[0].clock;
}
#test "Cleave: a Greataxe hit carries into a second foe beside the first, without the Strength modifier" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 4, 3);
  n := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 4, 4);
  cleft := false;
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[n].hp = 21; b[0].c[m].temp = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, n);
    rs_end_turn(b[..], a);
    if b[0].c[n].hp < 21 { #assert 21 - b[0].c[n].hp <= 24; cleft = true; break; }
  }
  #assert cleft;
}
#test "Flurry of Blows: 1 Focus Point, two Unarmed Strikes (1d6 + 3); Topple knocks a foe Prone on a failed Dex save" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 19;
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 3, 3);
  t := rs_add(b[..], rs_warlock("Vesk", 0, 3, SP_ELDRITCH_BLAST), 4, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  prone := false;
  for k: 0..<10 {
    b[0].c[m].focus = 3; b[0].c[t].cond = 0;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_flurry(b[..], m, t, OH_TOPPLE) && b[0].c[m].focus == 2 && !rs_flurry(b[..], m, t, OH_TOPPLE);
    strikes := 0;
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { strikes += 1; } }
    #assert strikes == 2;
    rs_end_turn(b[..], m);
    if rs_has(b[0].c[t], RS_PRONE) { prone = true; break; }
  }
  #assert prone;
}
#test "Deflect Attacks: a Monk's Reaction cuts 1d10 + Dex + level from a Greataxe hit, once until its turn" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[m].reacted = false; b[0].c[m].focus = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, -1);
    rs_end_turn(b[..], a);
    if b[0].c[m].reacted { break; }
  }
  #assert b[0].c[m].reacted && 21 - b[0].c[m].hp <= 12 + 3 - (1 + 3 + 3);
}
#test "Patient Defense: Dodge until its next turn, Disadvantage on attacks against it and Advantage on Dex saves" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], m);
  #assert rs_patient_defense(b[..], m) && b[0].c[m].focus == 2;
  #assert rs_attack_edge(b[..], a, m, true, true) == -1 && rs_save_edge(b[..], m, RS_DEX) == 1;
  rs_end_turn(b[..], m);
  rs_tick(b[..], b[0].c[m].turn_at - b[0].clock);
  #assert rs_attack_edge(b[..], a, m, true, true) == 0;
}
#test "the action adapter: a turn every 1.5 seconds, slots back after the cooldown, saves still on 6-second rounds" {
  b: [1] RsBattle; b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  b[0].beat = 1.5; b[0].recharge = 9;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 9, 3);
  rs_begin(b[..]);
  first := b[0].c[a].turn_at;
  rs_tick(b[..], first - b[0].clock);
  rs_start_turn(b[..], a);
  #assert b[0].turn.new_round && b[0].turn.move_left == 2;   // 30 feet a round: 7.5 feet a beat, 2 squares
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 2, 0, 0, t) && b[0].c[a].slots[2] == 1;
  rs_end_turn(b[..], a);
  #assert b[0].c[a].turn_at == first + 1.5;
  rs_tick(b[..], 1.5);
  rs_start_turn(b[..], a);
  #assert !b[0].turn.new_round;
  rs_end_turn(b[..], a);
  for k: 0..<10 { rs_tick(b[..], 1.0); }
  #assert b[0].c[a].slots[2] == 2;
}
