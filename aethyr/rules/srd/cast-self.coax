// SRD p.105 Range, False Life p.129, Divine Smite p.125 and Produce Flame p.156.
// A different primary creature on a caster-only spell is a malformed request.
// Originating areas, weapon-hit riders and later helper actions are distinct.
#authority;

#test "Self request shapes distinguish caster-only casts from originating effects" {
  expected := [16] bool.[true,true,true,false,true,true,true,true,true,true,true,true,true,true,true,true];
  for i: 0..<16 {
    #assert rs_self_request((i&1)!=0,(i&2)!=0,(i&4)!=0,(i&8)!=0) == expected[i];
  }
}
#test "canonical Self range is separate from zero feet, house records and later helpers" {
  #assert rs_spell_self_range(SP_FALSE_LIFE) && rs_spell_self_range(SP_PRODUCE_FLAME);
  #assert rs_spell_self_range(SP_DIVINE_SMITE) && rs_spell_self_range(SP_THUNDERWAVE);
  #assert !rs_spell_self_range(SP_FLAME_HURL) && !rs_spell_self_range(SP_CALL_BOLT);
  #assert !rs_spell_self_range(SP_WATER_WALK) && !rs_spell_self_range(SP_COMMAND);
  #assert !rs_spell_self_range(-1) && !rs_spell_self_range(78) && !rs_spell_self_range(SP_WATER_ORB);
}
rs_self_request :: (self_range: bool, creature_request: bool, smite: bool, same: bool) -> bool #effects(all) {
  return !self_range || !creature_request || smite || same;
}
rs_spell_self_range :: (sp: int) -> bool #effects(all) {
  if sp < 0 || sp >= RS_EXEC_SOURCE.count { return false; }
  return RS_SPELL_KEYS[RS_EXEC_SOURCE[sp]].range_kind == SRD_RANGE_SELF && rs_spell(sp).part_of < 0;
}
