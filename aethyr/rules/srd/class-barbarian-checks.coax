// The Barbarian's levels 1-6 features (#13044; class-features.coax lists them), each resolved
// through the shared battle against its SRD 5.2.1 text (p. 28-30), with fixed dice (d6 3, d12 6,
// d20 10) so each number is read off the page. The preset is a Path of the Berserker Barbarian
// with a Greataxe, Strength 16, Dexterity 13, Constitution 14.
//   coax/bin/coax test --library aethyr/rules/srd/class-barbarian-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

#test "Rage p.28: a Bonus Action and a use; B/P/S Resistance, +2 Rage Damage on a Strength hit, Advantage on Strength saves, no Concentration" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 1), 10);
  #assert b[0].c[0].rages == 2 && rs_barbarian("T", 0, 3).rages_max == 3 && rs_barbarian("T", 0, 6).rages_max == 4;
  b[0].c[0].conc = SP_ENTANGLE;   // were it holding a spell, Rage ends it
  #assert rs_rage(b[..], 0) && b[0].turn.bonus && !b[0].turn.action && b[0].c[0].rages == 1 && b[0].c[0].conc < 0;
  #assert !rs_rage(b[..], 0);   // already raging, and the Bonus Action is spent
  #assert rs_resisted(b[..], 0, 10, RS_SLASHING) == 5 && rs_resisted(b[..], 0, 10, RS_PIERCING) == 5 && rs_resisted(b[..], 0, 10, RS_BLUDGEONING) == 5;
  #assert rs_resisted(b[..], 0, 10, RS_FIRE) == 10;
  #assert rs_save_edge(b[..], 0, RS_STR) == 1 && rs_save_edge(b[..], 0, RS_CON) == 0;
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (6 + 3 + 2);   // 1d12 + 3, +2
  // a Short Rest gives back one use, a Long Rest all
  b[0].c[0].rages = 0; rs_short_rest_resources(b[0].c[0..<1]); #assert b[0].c[0].rages == 1;
  b[0].c[0].rages = 0; #assert rs_long_rest_resources(b[0].c[0..<1]) && b[0].c[0].rages == 2;
}

#test "Rage p.28: it lasts while each turn has an attack, and ends after a turn without one" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 1), 10);
  #assert rs_rage(b[..], 0);
  rs_end_turn(b[..], 0); rs_start_turn(b[..], 0);
  #assert rs_attack(b[..], 0, 1, false, -1);
  rs_end_turn(b[..], 0); #assert b[0].c[0].raging;
  rs_start_turn(b[..], 0); rs_end_turn(b[..], 0);
  #assert !b[0].c[0].raging;
}

#test "Unarmored Defense p.29: AC 10 + Dexterity + Constitution without armor" {
  for level: 1..<7 { c := rs_barbarian("Thorn", 0, level); #assert c.ac == 10 + 1 + 2; }
}

#test "Weapon Mastery p.29: two kinds at level 1, three at 4; a Greataxe hit Cleaves into a second foe beside it" {
  #assert rs_barbarian("T", 0, 3).mastery_n == 2 && rs_barbarian("T", 0, 4).mastery_n == 3;
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 1), 10);
  k := rs_add(b[..], rs_sorcerer("Other", 1, 3), 2, 2); b[0].c[k].hp = 200; b[0].c[k].ac = 10; b[0].c[k].shield_spell = false;
  #assert rs_attack(b[..], 0, 1, false, k);
  #assert b[0].c[1].hp == 200 - 9 && b[0].c[k].hp == 200 - 6;   // Cleave: no ability modifier
}

#test "Danger Sense p.29: Advantage on Dexterity saves from level 2, not while Incapacitated" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 2), 10);
  #assert rs_save_edge(b[..], 0, RS_DEX) == 1;
  b[0].c[0].cond = RS_INCAPACITATED; #assert rs_save_edge(b[..], 0, RS_DEX) == 0;
  one: [1] RsBattle; cf_field(one[..], rs_barbarian("Thorn", 0, 1), 10);
  #assert rs_save_edge(one[..], 0, RS_DEX) == 0;
}

#test "Reckless Attack p.29: from level 2, Advantage on its Strength attacks this turn and on attacks against it until its next turn" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 2), 10);
  #assert rs_attack(b[..], 0, 1, true, -1) && b[0].c[0].reckless_until > b[0].clock;
  #assert rs_attack_edge(b[..], 1, 0, true, false) == 1 && rs_attack_edge(b[..], 0, 1, true, true) == 1;
  rs_end_turn(b[..], 0); rs_tick(b[..], b[0].c[0].turn_at - b[0].clock);
  #assert b[0].c[0].reckless_until <= b[0].clock;
  one: [1] RsBattle; cf_field(one[..], rs_barbarian("Thorn", 0, 1), 10);
  #assert rs_attack(one[..], 0, 1, true, -1) && one[0].c[0].reckless_until <= one[0].clock;
}

#test "Primal Knowledge p.29: from level 3, while raging, Acrobatics, Intimidation, Perception, Stealth or Survival with Strength" {
  for level: [2] int.[2, 3] {
    c := rs_barbarian("Thorn", 0, level); c.raging = true;
    p := rs_check_plan(c, RsAbilityRequest.{ability = RS_DEX, skill = SK_STEALTH, primal = true});
    #assert p.accepted == (level == 3);
    if level == 3 { #assert p.ability == RS_STR && p.edge == 1; }   // and Rage's Advantage on Strength checks
    c.raging = false; #assert !rs_check_plan(c, RsAbilityRequest.{ability = RS_DEX, skill = SK_STEALTH, primal = true}).accepted;
  }
}

#test "Frenzy p.30: raging and reckless, the first Strength hit on its turn deals Rage Damage d6s more" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 3), 10);
  #assert rs_rage(b[..], 0) && rs_attack(b[..], 0, 1, true, -1);
  #assert b[0].c[1].hp == 200 - (6 + 3 + 2 + 2 * 3);
  two: [1] RsBattle; cf_field(two[..], rs_barbarian("Thorn", 0, 3), 10);
  #assert rs_rage(two[..], 0) && rs_attack(two[..], 0, 1, false, -1) && two[0].c[1].hp == 200 - 11;   // not reckless: no Frenzy
}

#test "Ability Score Improvement p.29: Strength 16 to 18 at level 4, +1 to hit and damage" {
  #assert rs_barbarian("T", 0, 3).score[RS_STR] == 16 && rs_barbarian("T", 0, 4).score[RS_STR] == 18;
  #assert rs_weapon_attack(rs_barbarian("T", 0, 4), W_GREATAXE) == 6;
}

#test "Extra Attack p.29: from level 5 the Attack action makes two attacks" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Thorn", 0, 5), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - 2 * (6 + 4);
  four: [1] RsBattle; cf_field(four[..], rs_barbarian("Thorn", 0, 4), 10);
  #assert rs_attack(four[..], 0, 1, false, -1) && four[0].c[1].hp == 200 - (6 + 4);
}

#test "Fast Movement p.29: Speed 30 + 10 from level 5" {
  #assert rs_barbarian("T", 0, 4).speed == 30 && rs_barbarian("T", 0, 5).speed == 40 && rs_barbarian("T", 0, 6).speed == 40;
}

#test "Mindless Rage p.30: from level 6, entering Rage ends Charmed and Frightened, and it can't gain them while raging" {
  b: [1] RsBattle; cf_field(b[..], rs_barbarian("Gorr", 0, 6), 10);
  #assert rs_put_effect(b[..], 0, RsEffect.{kind = EF_COND, cond = RS_FRIGHTENED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert rs_rage(b[..], 0) && !rs_has(b[0].c[0], RS_FRIGHTENED);
  #assert rs_put_effect(b[..], 0, RsEffect.{kind = EF_COND, cond = RS_CHARMED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert !rs_has(b[0].c[0], RS_CHARMED);
  five: [1] RsBattle; cf_field(five[..], rs_barbarian("Gorr", 0, 5), 10);
  #assert rs_rage(five[..], 0);
  #assert rs_put_effect(five[..], 0, RsEffect.{kind = EF_COND, cond = RS_CHARMED, by = -1, spell = -1, until = 100, save = -1, dc = 0}) && rs_has(five[0].c[0], RS_CHARMED);
}
