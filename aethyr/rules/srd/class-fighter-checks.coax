// The Fighter's levels 1-6 features (#13044; class-features.coax lists them), each resolved through
// the shared battle against its SRD 5.2.1 text (p. 47-49, the Defense style p. 88), with fixed dice
// (d10 5, d12 6, d20 10) so each number is read off the page. The preset is a Champion in Chain Mail
// with a Greatsword, Strength 16, Dexterity 13, Constitution 14.
//   coax/bin/coax test --library aethyr/rules/srd/class-fighter-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

#test "Fighting Style p.47 (Defense p.88): +1 AC in armor, Chain Mail 16 to 17" {
  for level: 1..<7 { #assert rs_fighter("Garr", 0, level).ac == 17; }
}

#test "Second Wind p.48: a Bonus Action, 1d10 + Fighter level; two uses, three at 4; one back on a Short Rest, all on a Long Rest" {
  for level: [2] int.[1, 4] {
    b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, level), 10);
    b[0].c[0].hp = 1;
    #assert rs_second_wind(b[..], 0) && b[0].turn.bonus && !b[0].turn.action && b[0].c[0].hp == 1 + 5 + level;
    #assert !rs_second_wind(b[..], 0);   // the Bonus Action is spent
    #assert b[0].c[0].uses[RS_USE_WIND] == (ifx level == 4 then 2 else 1);
  }
  c: [1] RsCreature; c[0] = rs_fighter("Garr", 0, 4); c[0].uses[RS_USE_WIND] = 0;
  rs_short_rest_resources(c[..]); #assert c[0].uses[RS_USE_WIND] == 1;
  #assert rs_long_rest_resources(c[..]) && c[0].uses[RS_USE_WIND] == 3;
  full: [1] RsBattle; cf_field(full[..], rs_fighter("Garr", 0, 1), 10); #assert !rs_second_wind(full[..], 0);   // nothing to heal
}

#test "Weapon Mastery p.48: three kinds, four at 4; a Greatsword miss Grazes for the Strength modifier" {
  #assert rs_fighter("G", 0, 3).mastery_n == 3 && rs_fighter("G", 0, 4).mastery_n == 4;
  b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, 1), 16);   // 10 + 5 misses AC 16
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - 3;
  hit: [1] RsBattle; cf_field(hit[..], rs_fighter("Garr", 0, 1), 15);
  #assert rs_attack(hit[..], 0, 1, false, -1) && hit[0].c[1].hp == 200 - (3 + 3 + 3);   // 2d6 + 3
}

#test "Action Surge p.48: from level 2, one more action this turn, once until a rest" {
  b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, 2), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && !rs_attack(b[..], 0, 1, false, -1);
  #assert rs_action_surge(b[..], 0) && rs_attack(b[..], 0, 1, false, -1) && b[0].c[0].uses[RS_USE_SURGE] == 0;
  #assert b[0].c[1].hp == 200 - 2 * 9 && !rs_action_surge(b[..], 0);
  c: [1] RsCreature; c[0] = b[0].c[0]; rs_short_rest_resources(c[..]); #assert c[0].uses[RS_USE_SURGE] == 1;
  one: [1] RsBattle; cf_field(one[..], rs_fighter("Garr", 0, 1), 10);
  #assert rs_attack(one[..], 0, 1, false, -1) && !rs_action_surge(one[..], 0);
}

#test "Tactical Mind p.48: a failed check adds 1d10 from a Second Wind use, which is kept if it still fails" {
  for dc: [2] int.[0, 40] {
    b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, 2), 10);
    q := RsAbilityRequest.{ability = RS_STR, skill = SK_ATHLETICS};
    base := 10 + rs_check_plan(b[0].c[0], q).bonus;
    q.dc = ifx dc == 0 then base + 3 else dc;
    r := rs_ability_check(b[..], 0, q);
    #assert r.mind == 5 && r.total == base + 5 && r.passed == (dc == 0) && r.mind_spent == (dc == 0);
    #assert b[0].c[0].uses[RS_USE_WIND] == (ifx dc == 0 then 1 else 2);
  }
  one: [1] RsBattle; cf_field(one[..], rs_fighter("Garr", 0, 1), 10);
  #assert rs_ability_check(one[..], 0, RsAbilityRequest.{ability = RS_STR, skill = SK_ATHLETICS, dc = 40}).mind == 0;
}

#test "Improved Critical p.49: from level 3 a Champion's 19 is a Critical Hit" {
  for level: [2] int.[2, 3] {
    b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, level), 40);   // only a Critical Hit lands
    b[0].dice[0].fixed = false; b[0].dice[0].state = cf_seed(20, 19);
    #assert rs_attack(b[..], 0, 1, false, -1);
    #assert (b[0].c[1].hp < 200 - 3) == (level == 3);   // more than the Graze
  }
}

#test "Remarkable Athlete p.49: from level 3, Advantage on Initiative and Athletics, and half its Speed after a Critical Hit" {
  #assert rs_initiative_plan(rs_fighter("G", 0, 3)).edge == 1 && rs_initiative_plan(rs_fighter("G", 0, 2)).edge == 0;
  #assert rs_check_plan(rs_fighter("G", 0, 3), RsAbilityRequest.{ability = RS_STR, skill = SK_ATHLETICS}).edge == 1;
  b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, 3), 10);
  b[0].turn.last_crit = true; rs_after_blow(b[..], 0);
  #assert b[0].turn.move_left == 6 + 3 && !b[0].turn.last_crit;
}

#test "Ability Score Improvement p.48: Strength 16 to 18 at 4 and 20 at 6" {
  #assert rs_fighter("G", 0, 3).score[RS_STR] == 16 && rs_fighter("G", 0, 4).score[RS_STR] == 18 && rs_fighter("G", 0, 6).score[RS_STR] == 20;
}

#test "Extra Attack p.48: from level 5, two attacks with the Attack action" {
  b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, 5), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - 2 * (6 + 4);
}

#test "Tactical Shift p.48: from level 5, Second Wind also moves it up to half its Speed" {
  for level: [2] int.[4, 5] {
    b: [1] RsBattle; cf_field(b[..], rs_fighter("Garr", 0, level), 10); b[0].c[0].hp = 1;
    #assert rs_second_wind(b[..], 0) && b[0].turn.move_left == 6 + (ifx level == 5 then 3 else 0);
  }
}
