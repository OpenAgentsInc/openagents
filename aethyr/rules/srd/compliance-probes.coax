// Milestone 1 witnesses, not a whole-SRD qualification. Expected outcomes come
// from SRD 5.2.1 pp. 41-46, 104-106, 141, 153-154 and the spec's no-loss
// deterministic effect contract. See docs/dnd/srd-compliance-ledger.md.
// Known gaps are executable predicates run by compliance-check.coax; they are
// NOT inverted into assertions that the bug must remain. A fix turns FAIL to PASS.
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "battle.coax";

#test "compliance Command: pending and active Halt follow logical turns while preserving reactions" {
  #assert sc_halt_turn();
}
sc_halt_turn :: () -> bool {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Caster",0,3),1,1);
  t := rs_add(b[..],rs_sorcerer("Target",1,3),2,1);
  command := [1] int.[RS_EXEC_SOURCE[SP_COMMAND]]; shield := [1] int.[RS_EXEC_SOURCE[SP_SHIELD]];
  if !rs_set_spells(b[0].c[a..<a+1],command[..]) || !rs_set_spells(b[0].c[t..<t+1],shield[..]) { return false; }
  b[0].c[t].shield_spell = true;
  rs_start_turn(b[..],a);
  if !rs_cast(b[..],a,SP_COMMAND,1,0,0,t) || !rs_can_act(b[0].c[t]) || !rs_can_move(b[0].c[t]) { return false; }
  rs_tick(b[..],100); rs_end_turn(b[..],a); rs_start_turn(b[..],t);
  if rs_can_act(b[0].c[t]) || rs_can_move(b[0].c[t]) || !rs_capable(b[0].c[t]) { return false; }
  if !rs_shield(b[..],t) || rs_attack(b[..],t,a,false,-1) { return false; }
  rs_end_turn(b[..],t); return rs_can_act(b[0].c[t]) && rs_can_move(b[0].c[t]);
}

#test "compliance spell choices: mixed conditions and chosen Hex duration execute through native entry helpers" {
  #assert sc_spell_options();
}
sc_spell_options :: () -> bool {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Deaf",1),3,1);
  u := rs_add(b[..],rs_skeleton("Blind",1),4,1);
  keys := [1] int.[RS_EXEC_SOURCE[SP_BLINDNESS]];
  if !rs_set_spells(b[0].c[a..<a+1],keys[..]) { return false; }
  rs_start_turn(b[..],a); picks := [2] int.[t,u]; options := [2] RsCastOptions.[RsCastOptions.{blindness=RS_DEAFENED},RsCastOptions.{}];
  before := sc_before(b[..]); options[0].blindness = RS_PRONE;
  if rs_cast_creatures_with(b[..],a,SP_BLINDNESS,3,picks[..],false,options[..]) || !sc_unchanged(b[..],before) { return false; }
  options[0].blindness = RS_DEAFENED;
  if !rs_cast_creatures_with(b[..],a,SP_BLINDNESS,3,picks[..],false,options[..]) { return false; }
  if !rs_has(b[0].c[t],RS_DEAFENED) || rs_has(b[0].c[t],RS_BLINDED) || !rs_has(b[0].c[u],RS_BLINDED) { return false; }
  if rs_attack_edge(b[..],t,a,true,true) != 0 || rs_attack_edge(b[..],u,a,true,true) != -1 { return false; }
  rs_tick(b[..],60); if rs_has(b[0].c[t],RS_DEAFENED) || rs_has(b[0].c[u],RS_BLINDED) { return false; }
  return sc_hex_options();
}
sc_hex_options :: () -> bool {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  a := rs_add(b[..],rs_warlock("Caster",0,5,SP_ELDRITCH_BLAST),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),3,1);
  keys := [1] int.[RS_EXEC_SOURCE[SP_HEX]]; if !rs_set_spells(b[0].c[a..<a+1],keys[..]) { return false; }
  rs_start_turn(b[..],a); picks := [1] int.[t]; options := [1] RsCastOptions.[RsCastOptions.{hex_ability=RS_WIS}];
  if !rs_cast_creatures_with(b[..],a,SP_HEX,3,picks[..],false,options[..]) { return false; }
  if b[0].c[t].eff[0].cond != RS_WIS || b[0].c[a].conc_until != 28800 || b[0].c[t].eff[0].until != 28800 { return false; }
  rs_tick(b[..],28799); if b[0].c[a].conc != SP_HEX || !rs_effect(b[0].c[t],EF_HEX) { return false; }
  rs_tick(b[..],1); return b[0].c[a].conc == -1 && !rs_effect(b[0].c[t],EF_HEX);
}

#test "compliance admission: chosen recipients retain a complete cast and capacity refusal spends nothing" {
  #assert sc_chosen_recipients();
}
sc_chosen_recipients :: () -> bool {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Chosen",1),3,1);
  u := rs_add(b[..],rs_skeleton("Unchosen",0),2,1);
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100,save=-1}; }
  rs_start_turn(b[..],a); picks := [2] int.[a,t]; before := sc_before(b[..]);
  if rs_cast_creatures(b[..],a,SP_BLESS,1,picks[..],false) || !sc_unchanged(b[..],before) { return false; }
  b[0].c[t].eff[RS_EFFECTS-1].kind = EF_NONE;
  if !rs_cast_creatures(b[..],a,SP_BLESS,1,picks[..],false) { return false; }
  return rs_effect(b[0].c[a],EF_BLESS) && rs_effect(b[0].c[t],EF_BLESS) && !rs_effect(b[0].c[u],EF_BLESS) && b[0].c[a].slots[1] == before.slots[1]-1;
}

#test "compliance admission: reaction slots belong to their caster's current turn" {
  #assert sc_reaction_slot();
}
sc_reaction_slot :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]);
  b[0].c[0].shield_spell = true;
  if !rs_grant_spell(b[0].c[0..<1],SP_SHIELD) { return false; }
  before := sc_before(b[..]); b[0].turn.slot_spent = true;
  if rs_shield(b[..],0) || b[0].c[0].reacted || b[0].c[0].slots[1] != before.slots[1] || b[0].book[0].seq != before.seq { return false; }
  b[0].turn.slot_spent = false;
  if !rs_shield(b[..],0) || !b[0].turn.slot_spent || !b[0].turn.leveled || b[0].c[0].slots[1] != before.slots[1]-1 { return false; }
  if rs_can_cast(b[..],0,SP_CURE_WOUNDS,1) { return false; }
  rs_end_turn(b[..],0); rs_start_turn(b[..],1);
  b[0].c[0].reacted = false; b[0].turn.slot_spent = true; b[0].turn.quickened = true;
  return rs_shield(b[..],0) && b[0].turn.slot_spent && b[0].turn.quickened && !b[0].turn.leveled;
}

#test "compliance admission: absent actor and unavailable slots refuse without spending" {
  #assert sc_admission_actor() && sc_admission_slot();
}
#test "compliance admission: malformed target and out of range refuse without spending" {
  #assert sc_admission_target() && sc_admission_range();
}
#test "compliance admission: class access and prepared selections both refuse unauthorized casts" {
  #assert sc_admission_class() && sc_admission_prepared();
}
#test "compliance admission: a Self spell cannot use another primary creature" {
  #assert sc_admission_self();
}
#test "compliance effects: adding into free storage retains existing independent effects" {
  c: [1] RsCreature;
  #assert rs_effect_add(c[..], RsEffect.{kind = EF_NOHEAL, by = 1, until = 60});
  #assert rs_effect_add(c[..], RsEffect.{kind = EF_HEX, by = 2, until = 90});
  #assert c[0].eff[0].kind == EF_NOHEAL && c[0].eff[0].by == 1 && c[0].eff[0].until == 60;
  #assert c[0].eff[1].kind == EF_HEX && c[0].eff[1].by == 2 && c[0].eff[1].until == 90;
}
#test "compliance effects: full storage reports refusal and a later free record admits the complete cast" {
  #assert sc_effect_capacity();
}
#test "compliance zones: an available zone retains a lasting cast and spends exactly one slot" {
  b: [1] RsBattle; sc_setup(b[..]);
  #assert rs_cast(b[..], 0, SP_ENTANGLE, 1, 3, 1, 1);
  #assert b[0].zone[0].on && b[0].zone[0].spell == SP_ENTANGLE && b[0].zone[0].by == 0;
  #assert b[0].c[0].slots[1] == 3 && b[0].turn.action && b[0].turn.slot_spent;
}

// A clean strict-clock battle; no world profile, grants, free casts or cooldowns.
sc_setup :: (b: [] RsBattle) {
  b[0].dice[0].fixed = true;
  b[0].w = 64; b[0].h = 8;
  _ := rs_add(b, rs_druid("Druid", 0, 3), 1, 1);
  _ = rs_add(b, rs_skeleton("Target", 1), 3, 1);
  rs_start_turn(b, 0);
}

// Snapshot the observable projection which a refused request must preserve.
// Effects/zones are additionally checked in their capacity witnesses below.
ScBefore :: struct { slots: [10] int; turn: RsTurn; dice: RsDice; seq: int; count: int; head: int;
                     conc: int; until: f32; hp: int; temp: int; cond: int; }
sc_before :: (b: [] RsBattle) -> ScBefore {
  return ScBefore.{slots = b[0].c[0].slots, turn = b[0].turn, dice = b[0].dice[0],
                   seq = b[0].book[0].seq, count = b[0].book[0].count, head = b[0].book[0].head,
                   conc = b[0].c[0].conc, until = b[0].c[0].conc_until,
                   hp = b[0].c[1].hp, temp = b[0].c[1].temp, cond = b[0].c[1].cond};
}
sc_unchanged :: (b: [] RsBattle, p: ScBefore) -> bool {
  for i: 0..<10 { if b[0].c[0].slots[i] != p.slots[i] { return false; } }
  return b[0].turn.action == p.turn.action && b[0].turn.bonus == p.turn.bonus &&
         b[0].turn.slot_spent == p.turn.slot_spent && b[0].turn.leveled == p.turn.leveled &&
         b[0].dice[0].state == p.dice.state && b[0].dice[0].rolled == p.dice.rolled &&
         b[0].book[0].seq == p.seq && b[0].book[0].count == p.count && b[0].book[0].head == p.head &&
         b[0].c[0].conc == p.conc && b[0].c[0].conc_until == p.until &&
         b[0].c[1].hp == p.hp && b[0].c[1].temp == p.temp && b[0].c[1].cond == p.cond;
}
sc_admission_actor :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); p := sc_before(b[..]);
  return !rs_cast(b[..], -1, SP_CURE_WOUNDS, 1, 0, 0, 0) &&
         !rs_cast(b[..], b[0].n, SP_CURE_WOUNDS, 1, 0, 0, 0) && sc_unchanged(b[..], p);
}
sc_admission_slot :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); b[0].c[0].slots[1] = 0; p := sc_before(b[..]);
  return !rs_cast(b[..], 0, SP_CURE_WOUNDS, 1, 0, 0, 0) && sc_unchanged(b[..], p);
}
sc_admission_target :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); p := sc_before(b[..]);
  return !rs_cast(b[..], 0, SP_CURE_WOUNDS, 1, 0, 0, -1) &&
         !rs_cast(b[..], 0, SP_CURE_WOUNDS, 1, 0, 0, b[0].n) && sc_unchanged(b[..], p);
}
sc_admission_range :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); p := sc_before(b[..]);
  return !rs_cast(b[..], 0, SP_CURE_WOUNDS, 1, 0, 0, 1) && sc_unchanged(b[..], p);
}

// SRD pp.41-46,104: this preset Druid has no feature granting Guiding Bolt,
// which is absent from its class and Circle of the Land lists. No override or
// external whitelist is supplied. Ray of Sickness would be an ambiguous witness:
// Circle of the Land can grant it even though the base Druid list does not.
sc_admission_class :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); p := sc_before(b[..]);
  return !rs_cast(b[..], 0, SP_GUIDING_BOLT, 1, 0, 0, 1) && sc_unchanged(b[..], p);
}
sc_admission_prepared :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]);
  keys := [8] int.[RS_EXEC_SOURCE[SP_STARRY_WISP],RS_EXEC_SOURCE[SP_PRODUCE_FLAME],RS_EXEC_SOURCE[SP_ENTANGLE],RS_EXEC_SOURCE[SP_THUNDERWAVE],RS_EXEC_SOURCE[SP_HEALING_WORD],RS_EXEC_SOURCE[SP_FAERIE_FIRE],RS_EXEC_SOURCE[SP_MOONBEAM],RS_EXEC_SOURCE[SP_SPIKE_GROWTH]];
  if !rs_set_spells(b[0].c[0..<1], keys[..]) { return false; }
  p := sc_before(b[..]);
  return rs_spell_access(b[0].c[0], SP_CURE_WOUNDS) && !rs_cast(b[..], 0, SP_CURE_WOUNDS, 1, 0, 0, 0) && sc_unchanged(b[..], p);
}
sc_admission_self :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]);
  b[0].c[0] = rs_wizard("Wizard",0,3); b[0].c[0].x = 1; b[0].c[0].y = 1;
  p := sc_before(b[..]);
  return rs_can_cast(b[..],0,SP_FALSE_LIFE,1) && !rs_cast(b[..],0,SP_FALSE_LIFE,1,0,0,1) && sc_unchanged(b[..],p);
}
// SRD p.106 Invalid Targets and Hold Person p.141: the Skeleton is not Humanoid.
// A used slot is expended, the target remains unaffected, and it rolls no save.
sc_invalid_target_spends :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]); p := sc_before(b[..]);
  accepted := rs_cast(b[..], 0, SP_HOLD_PERSON, 2, 0, 0, 1);
  return accepted && b[0].c[0].slots[2] == p.slots[2] - 1 && b[0].turn.action &&
         b[0].turn.slot_spent && b[0].dice[0].rolled == p.dice.rolled &&
         b[0].c[1].hp == p.hp && b[0].c[1].cond == p.cond;
}
// A deliberately necessary (not sufficient) Polymorph witness: a failed save
// must not simply Incapacitate the creature. It retains HP/type and gains form
// Temporary HP. The current API has no Beast choice; full qualification must add it.
#test "compliance Polymorph witness uses a prepared spell and an available fourth-level slot" {
  b: [1] RsBattle; #assert sc_polymorph_setup(b[..]);
  #assert rs_spell_ready(b[0].c[0], SP_POLYMORPH) && rs_can_cast(b[..], 0, SP_POLYMORPH, 4);
}
sc_polymorph_setup :: (b: [] RsBattle) -> bool {
  sc_setup(b);
  b[0].c[0] = rs_druid("Druid", 0, 7); b[0].c[0].x = 1; b[0].c[0].y = 1;
  b[0].c[0].slots[4] = 1; b[0].c[0].slots_max[4] = 1;
  choice := [1] int.[RS_EXEC_SOURCE[SP_POLYMORPH]];
  return rs_set_spells(b[0].c[0..<1], choice[..]);
}
sc_polymorph :: () -> bool {
  b: [1] RsBattle; if !sc_polymorph_setup(b[..]) { return false; }
  hp := b[0].c[1].hp; humanoid := b[0].c[1].humanoid;
  accepted := rs_cast(b[..], 0, SP_POLYMORPH, 4, 0, 0, 1);
  return accepted && !rs_has(b[0].c[1], RS_INCAPACITATED) && b[0].c[1].temp > 0 &&
         b[0].c[1].hp == hp && b[0].c[1].humanoid == humanoid;
}
// Storage exhaustion is an implementation contract, not a new SRD stacking rule.
// Independent effects must not silently disappear when another effect is added.
// Full storage now reports refusal explicitly; every old record must survive.
sc_effect_capacity :: () -> bool {
  c: [1] RsCreature;
  for i: 0..<RS_EFFECTS {
    if !rs_effect_add(c[..], RsEffect.{kind = EF_HEX + i, by = i + 1, until = f32(60 + i)}) { return false; }
  }
  if rs_effect_add(c[..], RsEffect.{kind = EF_NOHEAL, by = 100, until = 120}) { return false; }
  for i: 0..<RS_EFFECTS {
    found := false;
    for j: 0..<RS_EFFECTS {
      if c[0].eff[j].kind == EF_HEX + i && c[0].eff[j].by == i + 1 && c[0].eff[j].until == f32(60 + i) { found = true; }
    }
    if !found { return false; }
  }
  if rs_effect(c[0], EF_NOHEAL) { return false; }
  b: [1] RsBattle; sc_setup(b[..]);
  for k: 0..<RS_EFFECTS { b[0].c[1].eff[k] = RsEffect.{kind=EF_HEX,by=100+k,spell=-1,until=100,save=-1}; }
  before := sc_before(b[..]);
  if rs_cast(b[..],0,SP_ENTANGLE,1,3,1,1) || !sc_unchanged(b[..],before) { return false; }
  for k: 0..<RS_EFFECTS { if b[0].c[1].eff[k].kind != EF_HEX || b[0].c[1].eff[k].by != 100+k { return false; } }
  b[0].c[1].eff[RS_EFFECTS-1].kind = EF_NONE;
  if !rs_cast(b[..],0,SP_ENTANGLE,1,3,1,1) || !b[0].turn.action || b[0].c[0].slots[1] != before.slots[1]-1 { return false; }
  for k: 0..<RS_EFFECTS-1 { if b[0].c[1].eff[k].kind != EF_HEX || b[0].c[1].eff[k].by != 100+k { return false; } }
  e := b[0].c[1].eff[RS_EFFECTS-1];
  return e.kind == EF_ZONE_RESTRAIN && e.cond == 0 && e.by == 0 && e.spell == SP_ENTANGLE && rs_has(b[0].c[1],RS_RESTRAINED);
}
// Every zone belongs to a different caster than this cast; ending the caster's
// existing concentration cannot free one. Full capacity must refuse before spend.
sc_zone_capacity :: () -> bool {
  b: [1] RsBattle; sc_setup(b[..]);
  b[0].c[0].conc = SP_HEX; b[0].c[0].conc_until = 90;
  for k: 0..<RS_ZONES {
    b[0].zone[k] = RsZone.{on = true, spell = SP_FOG_CLOUD, by = 1, x0 = k, x1 = k + 1, until = f32(100 + k)};
  }
  p := sc_before(b[..]);
  if rs_cast(b[..], 0, SP_ENTANGLE, 1, 3, 1, 1) || !sc_unchanged(b[..], p) { return false; }
  for k: 0..<RS_ZONES {
    z := b[0].zone[k];
    if !z.on || z.spell != SP_FOG_CLOUD || z.by != 1 || z.x0 != k || z.x1 != k + 1 || z.until != f32(100 + k) { return false; }
  }
  return true;
}
