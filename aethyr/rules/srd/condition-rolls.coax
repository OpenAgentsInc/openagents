// SRD 5.2.1 pp.17, 177, 186, 189, 191. Roll-local consequences of
// the supplied condition state. Geometry, sight and lifecycle remain callers.
#authority;

RsConditionEdges :: struct { advantage: bool; disadvantage: bool; }
// Range-independent sources only. Prone's range-dependent sources stay in
// prone-movement.coax and are combined by rs_attack_edge.
rs_condition_edges :: (actor: RsCreature, target: RsCreature) -> RsConditionEdges #effects(all) {
  r: RsConditionEdges;
  r.disadvantage = rs_has(actor,RS_BLINDED|RS_POISONED|RS_RESTRAINED);
  r.advantage = rs_has(target,RS_BLINDED|RS_PARALYZED|RS_PETRIFIED|RS_RESTRAINED|RS_STUNNED|RS_UNCONSCIOUS);
  return r;
}

// Paralyzed and Unconscious grant automatic critical hits at five feet;
// Stunned and Petrified grant attack Advantage but do not grant these crits.
rs_condition_critical :: (target: RsCreature, feet: int) -> bool #effects(all) {
  return feet <= 5 && rs_has(target,RS_PARALYZED|RS_UNCONSCIOUS);
}

#test "a Charmed creature cannot attack its charmer but can attack anyone else; a raw bit names no charmer" {
  c: RsCreature;
  #assert !rs_charmed_by(c,1);
  c.cond=RS_CHARMED; #assert !rs_charmed_by(c,1);
  c.eff[3]=RsEffect.{kind=EF_COND,cond=RS_CHARMED,by=1};
  #assert rs_charmed_by(c,1) && !rs_charmed_by(c,2) && !rs_charmed_by(c,0);
  c.eff[3].kind=EF_DAZED; c.eff[3].cond=RS_CHARMED|RS_INCAPACITATED; #assert rs_charmed_by(c,1);
  c.eff[3].cond=RS_INCAPACITATED; #assert !rs_charmed_by(c,1);
  c.eff[3].kind=EF_HEX; c.eff[3].cond=RS_CHARMED; #assert !rs_charmed_by(c,1);
  c.eff[3].kind=EF_COND; c.eff[3].cond=RS_BLINDED|RS_DEAFENED; #assert !rs_charmed_by(c,1);
}
#test "a Grappled creature has Disadvantage against everyone but its grappler" {
  c: RsCreature;
  #assert !rs_grapple_down(c,1);
  c.cond=RS_GRAPPLED; #assert !rs_grapple_down(c,1);
  c.eff[0]=RsEffect.{kind=EF_COND,cond=RS_GRAPPLED|RS_PRONE,by=1};
  #assert !rs_grapple_down(c,1) && rs_grapple_down(c,2) && rs_grapple_down(c,0);
  c.eff[4]=RsEffect.{kind=EF_COND,cond=RS_GRAPPLED,by=2};   // two grapplers: each may be attacked freely
  #assert !rs_grapple_down(c,1) && !rs_grapple_down(c,2) && rs_grapple_down(c,3);
  c.eff[0].cond=RS_PRONE; #assert rs_grapple_down(c,1) && !rs_grapple_down(c,2);
  c.eff[4].cond=RS_BLINDED; #assert !rs_grapple_down(c,1);
}

// Charmed (p.177): no attack on the charmer. Grappled (p.182): Disadvantage on
// attacks against any target other than the grappler. The owner is the
// record's creator; a raw bit with no record names no charmer or grappler.
rs_charmed_by :: (actor: RsCreature, j: int) -> bool #effects(all) {
  for e: actor.eff { if e.by==j && (rs_effect_conditions(e)&RS_CHARMED)!=0 { return true; } }
  return false;
}
rs_grapple_down :: (actor: RsCreature, j: int) -> bool #effects(all) {
  other := false;
  for e: actor.eff {
    if (rs_effect_conditions(e)&RS_GRAPPLED)==0 { continue; }
    if e.by==j { return false; }
    other = true;
  }
  return other;
}

// These four conditions automatically fail Strength and Dexterity saves.
// Callers restrict the ability; this says nothing about Constitution saves.
rs_helpless :: (c: RsCreature) -> bool #effects(all) {
  return rs_has(c,RS_PARALYZED|RS_PETRIFIED|RS_STUNNED|RS_UNCONSCIOUS);
}
rs_auto_fails :: (c: RsCreature, ability: int) -> bool #effects(all) {
  return (ability == RS_STR || ability == RS_DEX) && rs_helpless(c);
}

// One admitted saving throw, including the existing optional rescue policies.
// An automatic failure neither samples dice nor spends Inspiration/Own Luck.
RsSavingThrow :: struct { total: int; passed: bool; automatic: bool; inspiration: int; luck: int; }
rs_saving_throw :: (b: [] RsBattle, j: int, ability: int, dc: int) -> RsSavingThrow #effects(all) { return rs_saving_throw_with(b,j,ability,dc,0); }
// `downs` more Disadvantage sources from the effect itself, joined before cancellation.
rs_saving_throw_with :: (b: [] RsBattle, j: int, ability: int, dc: int, downs: int) -> RsSavingThrow #effects(all) { return rs_saving_throw_edges(b,j,ability,dc,0,downs); }
// A save against a spell or another magical effect: Magic Resistance's Advantage (monster-traits.coax).
rs_saving_throw_magic :: (b: [] RsBattle, j: int, ability: int, dc: int, downs: int) -> RsSavingThrow #effects(all) {
  return rs_saving_throw_edges(b,j,ability,dc,rs_magic_save_ups(b[0].c[j],true),downs);
}
// `ups` more Advantage sources from the effect itself.
rs_saving_throw_edges :: (b: [] RsBattle, j: int, ability: int, dc: int, ups: int, downs: int) -> RsSavingThrow #effects(all) {
  r: RsSavingThrow;
  r.automatic = rs_auto_fails(b[0].c[j],ability);
  if r.automatic { return r; }
  d := rs_d20(b[0].dice[..],rs_save_edge_from(b,j,ability,ups,downs));
  r.total = d.roll + rs_save_in(b,j,ability) + rs_boon_roll(b,j) - rs_exhaustion_penalty(b[0].c[j]);
  r.inspiration = rs_inspired_roll(b,j,r.total,dc);
  r.total += r.inspiration;
  r.luck = rs_own_luck(b,j,r.total,dc);
  r.total += r.luck;
  r.passed = r.total >= dc;
  return r;
}

// Modifiers precede this helper; then immunity, one resistance, vulnerability.
// Petrified and Rage do not multiply another resistance to the same damage.
rs_resisted :: (b: [] RsBattle, j: int, amount: int, kind: int) -> int #effects(all) {
  c := b[0].c[j];
  bit := 1 << kind;
  if (c.immune & bit) != 0 { return 0; }
  a := amount;
  if (c.resist & bit) != 0 || rs_has(c,RS_PETRIFIED) || (c.raging && (kind == RS_BLUDGEONING || kind == RS_PIERCING || kind == RS_SLASHING)) { a = a/2; }
  if (c.vulnerable & bit) != 0 { a = a*2; }
  return a;
}
