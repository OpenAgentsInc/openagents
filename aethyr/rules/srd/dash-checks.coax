// SRD 5.2.1 p.180 Dash; p.182 Grappled, p.186 Restrained; class feature costs.
#load "battle.coax";

#test "all three Dash producers credit modified walking Speed including residual feet" {
  for mode: 0..<3 {
    b: [1] RsBattle; dh_field(b[..]);
    b[0].c[0].speed=37; b[0].c[0].slowed_until=10; b[0].c[0].halved_until=10;
    b[0].turn.move_left=1; b[0].turn.move_feet=3;
    ok := ifx mode==0 then rs_dash(b[..],0) else ifx mode==1 then rs_cunning_dash(b[..],0) else rs_step_of_the_wind(b[..],0);
    #assert ok;
    // (37 - 10) / 2 = 13 feet gained, preserving the existing eight.
    #assert b[0].turn.move_left==4 && b[0].turn.move_feet==1;
    #assert b[0].turn.action==(mode==0) && b[0].turn.bonus==(mode!=0);
    #assert b[0].dice[0].rolled==0 && b[0].c[0].focus==2;
  }
}

#test "Dash with zero Speed spends its action but never creates movement" {
  for state: 0..<5 {
    b: [1] RsBattle; dh_field(b[..]);
    b[0].turn.move_left=0; b[0].turn.move_feet=0;
    if state==0 { b[0].c[0].speed=0; }
    if state==1 { b[0].c[0].cond=RS_GRAPPLED; }
    if state==2 { b[0].c[0].cond=RS_RESTRAINED; }
    if state==3 { b[0].turn.anchored=true; }
    if state==4 { b[0].c[0].eff[0].kind=EF_DAZED; b[0].c[0].cond=RS_INCAPACITATED; }
    if state==4 { #assert !rs_dash(b[..],0); }
    else { #assert rs_dash(b[..],0) && b[0].turn.action; }
    #assert b[0].turn.move_left==0 && b[0].turn.move_feet==0;
  }
}

#test "Dash action and bonus feature share movement but pay separate budgets" {
  b: [1] RsBattle; dh_field(b[..]); b[0].c[0].speed=31;
  b[0].turn.move_left=0; b[0].turn.move_feet=0;
  #assert rs_dash(b[..],0) && rs_cunning_dash(b[..],0);
  #assert b[0].turn.move_left==12 && b[0].turn.move_feet==2;
  #assert !rs_dash(b[..],0) && !rs_step_of_the_wind(b[..],0);
  #assert b[0].turn.move_left==12 && b[0].turn.move_feet==2;
}

dh_field :: (b: [] RsBattle) {
  b[0].w=12; b[0].h=8; b[0].dice[0].fixed=true;
  _ := rs_add(b,rs_rogue("Runner",0,3),1,1);
  b[0].c[0].focus_max=2; b[0].c[0].focus=2;
  rs_start_turn(b,0); b[0].dice[0].rolled=0;
}

#test "Dash refuses invalid actors, budgets, incapacity and missing features without changing movement or events" {
  for mode: 0..<3 { for state: 0..<8 {
    b: [1] RsBattle; dh_field(b[..]);
    actor := 0;
    if state==0 { actor = -1; b[0].who=actor; }
    if state==1 { actor = b[0].n; b[0].who=actor; b[0].c[actor]=b[0].c[0]; }
    if state==2 { b[0].who = -1; }
    if state==3 { b[0].turn.action=true; b[0].turn.bonus=true; }
    if state==4 { b[0].c[0].cond=RS_INCAPACITATED; }
    if state==5 { b[0].c[0].hp=0; }
    if state==6 { b[0].c[0].dead=true; }
    if state==7 { b[0].c[0].eff[0].kind=EF_HALT; }
    before := b[0].turn; events := b[0].book[0].seq;
    ok := ifx mode==0 then rs_dash(b[..],actor) else ifx mode==1 then rs_cunning_dash(b[..],actor) else rs_step_of_the_wind(b[..],actor);
    #assert !ok;
    #assert b[0].turn.action==before.action && b[0].turn.bonus==before.bonus;
    #assert b[0].turn.move_left==before.move_left && b[0].turn.move_feet==before.move_feet;
    #assert b[0].book[0].seq==events && b[0].dice[0].rolled==0;
  } }
  b: [1] RsBattle; dh_field(b[..]);
  b[0].c[0].cunning=false; b[0].c[0].focus_max=0;
  #assert !rs_cunning_dash(b[..],0) && !rs_step_of_the_wind(b[..],0);
  #assert !b[0].turn.bonus;
}


#test "unrelated conditions keep Dash Speed and Step of the Wind spends no Focus and reports its own identity" {
  b: [1] RsBattle; dh_field(b[..]);
  b[0].c[0].cond=RS_BLINDED; b[0].c[0].focus_max=1; b[0].c[0].focus=0;
  before := b[0].book[0].seq;
  #assert rs_step_of_the_wind(b[..],0);
  #assert b[0].turn.move_left==12 && b[0].turn.move_feet==0 && b[0].c[0].focus==0;
  #assert b[0].book[0].seq==before+1;
  event := rs_recent(b[0].book[0],0);
  #assert event.kind==RS_EV_FEAT && event.feat==RS_FT_STEP_OF_THE_WIND && event.by==0 && event.text_n==0;
}

#test "native Dash witness checks real wrappers, modifiers, budgets and refusal" {
  #assert dh_native();
}
dh_native :: () -> bool {
  b: [1] RsBattle; dh_field(b[..]);
  b[0].c[0].speed=37; b[0].c[0].slowed_until=10; b[0].c[0].halved_until=10;
  b[0].turn.move_left=1; b[0].turn.move_feet=3;
  if !rs_dash(b[..],0) || !rs_step_of_the_wind(b[..],0) { return false; }
  if b[0].turn.move_left!=6 || b[0].turn.move_feet!=4 || !b[0].turn.action || !b[0].turn.bonus { return false; }
  if rs_cunning_dash(b[..],0) || b[0].dice[0].rolled!=0 || b[0].c[0].focus!=2 { return false; }
  rs_start_turn(b[..],0); b[0].c[0].cond=RS_RESTRAINED;
  before := b[0].turn.move_left*5+b[0].turn.move_feet;
  if !rs_cunning_dash(b[..],0) || b[0].turn.move_left*5+b[0].turn.move_feet!=before { return false; }
  return true;
}
