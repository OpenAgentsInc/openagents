// Death saves are saving throws, but have no ability modifier/proficiency and
// do not automatically fail through Unconscious's Strength/Dexterity rule.
#authority;

#test "an admitted battle death save is abilityless and preserves an unneeded rescue" {
  b: [1] RsBattle; c: [1] RsCreature; b[0].c = c[..]; b[0].n = 1;
  c[0].hp_max = 12; c[0].cond = RS_UNCONSCIOUS; c[0].inspired = 6;
  b[0].dice[0].fixed = true;
  #assert rs_battle_death_save(b[..],0) == RS_DS_OK;
  #assert c[0].hp == 0 && c[0].death_ok == 1 && c[0].death_fail == 0 && c[0].inspired == 6;
  #assert b[0].dice[0].rolled == 1;
}

#test "the final failed death save records its actual battle time" {
  b:[1]RsBattle; c:[1]RsCreature; b[0].c=c[..]; b[0].n=1; b[0].clock=27;
  c[0].hp_max=12; c[0].death_fail=2; c[0].exhaustion=1;
  b[0].dice[0].fixed=true;
  #assert rs_battle_death_save(b[..],0)==RS_DS_DEAD;
  #assert c[0].dead && c[0].combat_death_at==27;
}

rs_battle_death_save :: (b: [] RsBattle, j: int) -> int #effects(all) {
  if !rs_death_eligible(b[0].c[j]) { return RS_DS_NONE; }
  face := rs_roll(b[0].dice[..],20);
  total := face + rs_aura(b,j) + rs_boon_roll(b,j) - rs_exhaustion_penalty(b[0].c[j]);
  // A natural 1 imposes two failures regardless of the total. A natural 20's
  // healing is independent of modifiers, so it never spends a rescue.
  if face != 1 && face != 20 {
    total += rs_inspired_roll(b,j,total,10);
    total += rs_own_luck(b,j,total,10);
  }
  // Optional rescue rolls spend creature state; copy only after those rolls.
  c: [1] RsCreature; c[0] = b[0].c[j];
  r := rs_death_apply(c[..],face,total);
  b[0].c[j] = c[0];
  if r==RS_DS_DEAD { rs_record_combat_death(b,j); }
  rs_rest_retire_dead(b,j);
  if r == RS_DS_STABLE {
    b[0].c[j].stable_due=0;
    _ := rs_stable_arm(b,j);
  }
  return r;
}
