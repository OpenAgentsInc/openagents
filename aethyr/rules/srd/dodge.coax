// SRD 5.2.1 p.10: Dodge ends on the next actual turn start, Incapacitated,
// or Speed zero. Losing it is permanent until a new Dodge is taken.
#authority;

#test "Dodge takes one Action and actual turn retirement clears its benefit" {
  b: [1] RsBattle; c: [1] RsCreature; b[0].c = c[..]; b[0].n = 1;
  c[0].hp = 1; c[0].hp_max = 1; c[0].speed = 30;
  #assert rs_dodge(b[..],0) && b[0].turn.action && c[0].dodging;
  #assert !rs_dodge(b[..],0);
  rs_dodge_end(c[..]); #assert !rs_dodge_live(b[..],0);
}

rs_dodge_end :: (c: [] RsCreature) #effects(all) { c[0].dodging = false; }

rs_dodge_live :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  if !b[0].c[i].dodging { return false; }
  if !rs_capable(b[0].c[i]) || rs_has(b[0].c[i],RS_GRAPPLED|RS_RESTRAINED) || rs_walk_speed(b,i) <= 0 || (b[0].who == i && b[0].turn.anchored) {
    rs_dodge_end(b[0].c[i..<i+1]); return false;
  }
  // Hypnotic Pattern's separate carrier sets Speed zero; Command Halt
  // forbids movement without changing Speed and does not end Dodge.
  for e: b[0].c[i].eff {
    if e.kind == EF_DAZED { rs_dodge_end(b[0].c[i..<i+1]); return false; }
  }
  return true;
}

rs_dodge_begin :: (b: [] RsBattle, i: int) #effects(all) {
  b[0].c[i].dodging = true;
  _ := rs_dodge_live(b,i);
}

rs_dodge :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  if !rs_action_free(b,i) { return false; }
  b[0].turn.action = true;
  rs_dodge_begin(b,i);
  rs_say(b,RS_EV_CONDITION,i,i,0," takes the Dodge action");
  return true;
}
