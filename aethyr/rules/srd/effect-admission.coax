// Worst-case record demand, before dice or costs. Saves and misses may reduce
// demand but cannot be used to promise storage before their outcomes exist.
#authority;

#test "upcasting a single-target program does not prepay targets the executor will not select" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),2,1);
  u := rs_add(b[..],rs_skeleton("Other",1),3,1);
  for k: 0..<RS_EFFECTS { b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX}; }
  s := rs_spell(SP_BLESS); s.targets = 1;
  #assert rs_cast_effect_room(b[..],a,s,SP_BLESS,3,0,0,t);
  s.targets = 2; #assert !rs_cast_effect_room(b[..],a,s,SP_BLESS,1,0,0,t);
  // Area requests have no required primary creature, even with target metadata.
  s = rs_spell(SP_FIREBALL); s.targets = 3; s.step_n = 1; s.steps[0] = RsStep.{kind=RS_S_BOON,a=EF_BLESS};
  #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,3,3,1,-1);
}

#test "optional hit riders reserve only while their choices and budgets are live" {
  for mode: 0..<9 {
    b: [1] RsBattle;
    a := rs_add(b[..],rs_monk("Monk",0,5),1,1);
    t := rs_add(b[..],rs_skeleton("Target",1),2,1);
    for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; }
    b[0].who = a; b[0].c[a].stun_ready = true; b[0].c[a].focus = 1;
    w := W_UNARMED;
    if mode == 1 { b[0].c[a].stunning = false; }
    else if mode == 2 { b[0].c[a].stun_ready = false; }
    else if mode == 3 { b[0].c[a].focus = 0; }
    else if mode == 4 { b[0].turn.stunned = true; }
    else if mode == 5 { b[0].who = t; }
    else if mode == 6 { b[0].c[t].cond = RS_STUNNED; }
    else if mode == 7 { w = W_SLAM; }
    else if mode == 8 { b[0].c[t].cond = RS_BLINDED; }
    #assert rs_strikes_fit(b[..],a,t,w,1,false) == (mode > 0 && mode < 8 && mode != 5);
    b[0].c[t].eff[RS_EFFECTS-1].kind = EF_NONE;
    #assert rs_strikes_fit(b[..],a,t,w,1,false);
  }
  for mode: 0..<7 {
    b: [1] RsBattle;
    a := rs_add(b[..],rs_rogue("Rogue",0,5),1,1);
    t := rs_add(b[..],rs_skeleton("Target",1),2,1); b[0].c[t].immune_cond = 0;
    for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; }
    b[0].c[a].strike_plan = CS_POISON; b[0].c[a].poison_kit = true;
    if mode == 1 { b[0].c[a].cunning_strike = false; }
    else if mode == 2 { b[0].c[a].strike_plan = CS_TRIP; }
    else if mode == 3 { b[0].c[a].poison_kit = false; }
    else if mode == 4 { b[0].turn.sneaked = true; }
    else if mode == 5 { b[0].c[t].immune_cond = RS_POISONED; }
    else if mode == 6 { b[0].c[t].immune_cond = RS_BLINDED; }
    #assert rs_strikes_fit(b[..],a,t,W_SHORTSWORD,1,false) == (mode > 0 && mode < 6);
    b[0].c[t].eff[RS_EFFECTS-1].kind = EF_NONE;
    #assert rs_strikes_fit(b[..],a,t,W_SHORTSWORD,1,false);
  }
}
#test "full unrelated records do not charge an attack for absent masteries or unrelated targets" {
  b: [1] RsBattle;
  a := rs_add(b[..],rs_paladin("Paladin",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),2,1);
  u := rs_add(b[..],rs_skeleton("Two squares away",1),3,1);
  for k: 0..<RS_EFFECTS { b[0].c[a].eff[k] = RsEffect.{kind=EF_HEX}; b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX}; }
  #assert rs_strikes_fit(b[..],a,t,W_MACE,2,true);
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; }
  #assert rs_strikes_fit(b[..],a,t,W_SLAM,2,true);
  // A low-level caller can target itself: own and target demand share storage.
  b[0].c[a].masteries = 1 << M_VEX; b[0].c[a].cunning_strike = true; b[0].c[a].strike_plan = CS_POISON; b[0].c[a].poison_kit = true;
  b[0].c[a].eff[RS_EFFECTS-1].kind = EF_NONE;
  #assert !rs_strikes_fit(b[..],a,a,W_SHORTSWORD,1,false);
  b[0].c[a].eff[RS_EFFECTS-2].kind = EF_NONE;
  #assert rs_strikes_fit(b[..],a,a,W_SHORTSWORD,1,false);
}

#test "casting preflight targets the selected batch, including upcast and maximum target boundaries" {
  for slot: [4] int.[0,1,2,9] {
    for blocked: 0..<11 {
      b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
      _ := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
      for j: 1..<11 { added := rs_add(b[..],rs_skeleton("Target",1),1+j,1); }
      for k: 0..<RS_EFFECTS { b[0].c[blocked].eff[k] = RsEffect.{kind=EF_HEX}; }
      s := rs_spell(SP_BLESS); s.range_ft = 120;
      expected := ifx slot == 9 then 8 else ifx slot == 2 then 4 else 3;
      #assert rs_cast_effect_room(b[..],0,s,SP_BLESS,slot,0,0,1) == (blocked == 0 || blocked > expected);
    }
  }
}
#test "casting preflight pays each repetition before executing the first one" {
  for mode: 0..<5 {
    b: [1] RsBattle;
    _ := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
    t := rs_add(b[..],rs_skeleton("Target",1),2,1);
    s := rs_spell(SP_BLESS); s.targets = 1; s.concentration = false;
    s.step_n = 2; s.steps[0] = RsStep.{kind=RS_S_REPEAT,a=ifx mode == 3 then 3 else 2,b=2,c=ifx mode == 3 then 1 else ifx mode == 4 then 2 else 0};
    s.steps[1] = RsStep.{kind=RS_S_BOON,a=EF_BLESS};
    slot := ifx mode == 1 then 2 else ifx mode == 2 then 0 else 1;
    need := ifx mode == 3 then 6 else ifx mode == 1 then 4 else 2;
    for k: 0..<RS_EFFECTS-need { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; }
    #assert rs_cast_effect_room(b[..],0,s,SP_BLESS,slot,0,0,t);
    b[0].c[t].eff[RS_EFFECTS-need] = RsEffect.{kind=EF_HEX};
    #assert !rs_cast_effect_room(b[..],0,s,SP_BLESS,slot,0,0,t);
  }
}
#test "invalid first targets stop the whole cast and new casts repay even an identically named zone lease" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Invalid target",1),2,1);
  u := rs_add(b[..],rs_skeleton("Humanoid",1),3,1); b[0].c[u].humanoid = true;
  for k: 0..<RS_EFFECTS { b[0].c[a].eff[k] = RsEffect.{kind=EF_HEX}; b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX}; }
  s := rs_spell(SP_HOLD_PERSON); s.targets = 2;
  #assert rs_cast_effect_room(b[..],a,s,SP_HOLD_PERSON,2,0,0,t);
  // A cube from the caster still counts valid creatures despite an invalid
  // primary target: areas do not use the single-target invalid-type exit.
  s = rs_spell(SP_THUNDERWAVE); s.humanoid_only = true; s.step_n = 1; s.steps[0] = RsStep.{kind=RS_S_BOON,a=EF_BLESS};
  #assert !rs_cast_effect_room(b[..],a,s,SP_THUNDERWAVE,1,3,1,t);
  s = rs_spell(SP_BLESS); s.targets = 1;
  #assert !rs_cast_effect_room(b[..],a,s,SP_BLESS,1,0,0,a);
  s.concentration = false; s.steps[0] = RsStep.{kind=RS_S_CONDITION,a=RS_RESTRAINED}; s.step_n = 1;
  b[0].c[a].eff[0] = RsEffect.{kind=EF_ZONE_RESTRAIN,cond=0,by=a,spell=SP_BLESS};
  #assert !rs_cast_effect_room(b[..],a,s,SP_BLESS,1,0,0,a);
}
#test "area preflight excludes only outside, dead, invalid types, actually sculpted allies and a caster at its origin" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  // The caster stands outside this Sphere (it reaches x 7); a caster inside is checked at the end.
  a := rs_add(b[..],rs_wizard("Caster",0,5),12,1);
  t := rs_add(b[..],rs_skeleton("Target",0),3,1);
  u := rs_add(b[..],rs_skeleton("Second",0),4,1);
  v := rs_add(b[..],rs_skeleton("Third",0),5,1);
  for j: 0..<4 { for k: 0..<RS_EFFECTS { b[0].c[j].eff[k] = RsEffect.{kind=EF_HEX}; } }
  s := rs_spell(SP_FIREBALL); s.level = 1; s.step_n = 1; s.steps[0] = RsStep.{kind=RS_S_BOON,a=EF_BLESS};
  b[0].c[a].sculpt = true;
  #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,1,3,1,t);
  s.level = 2; #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[v].team = 1; #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[v].dead = true; #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[v].dead = false; b[0].c[v].x = 29; #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[v].x = 5; b[0].c[v].team = 0; b[0].c[a].sculpt = false;
  #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[a].sculpt = true; s.school = "Necromancy";
  #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  s.humanoid_only = true; b[0].c[t].humanoid = true;
  #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,a);
  b[0].c[t].humanoid = false; #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,a);
  // An area runs once, even if its data contains a repeated single-target step.
  s.humanoid_only = false; s.steps[1] = RsStep.{kind=RS_S_REPEAT,a=2}; s.step_n = 2;
  for j: 1..<4 { b[0].c[j].eff[RS_EFFECTS-1].kind = EF_NONE; }
  #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  // A caster inside its own Sphere is one more recipient (area-origin.coax); a Cube from it is not.
  b[0].c[a].x = 2; #assert !rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[a].eff[RS_EFFECTS-1].kind = EF_NONE; #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
  b[0].c[a].eff[RS_EFFECTS-1].kind = EF_HEX; s.area = RS_A_CUBE_SELF; s.area_ft = 15;
  #assert rs_cast_effect_room(b[..],a,s,SP_FIREBALL,2,3,1,t);
}

#test "each record-producing instruction prepays one slot per possible result" {
  c: RsCreature;
  for kind: [13] int.[RS_S_NOHEAL,RS_S_ENFEEBLE,RS_S_HEX,RS_S_EXPOSE,RS_S_MOCK,RS_S_BOON,RS_S_HALT,RS_S_MARK,RS_S_TIMED,RS_S_DAZE,RS_S_CONDITION,RS_S_HEAL,RS_S_SAVE] {
    s: RsSpell; s.step_n = 2; s.steps[0] = RsStep.{kind=kind,a=RS_BLINDED}; s.steps[1] = s.steps[0];
    #assert rs_effect_demand(c,s,-1,0,0) == (ifx kind == RS_S_HEAL || kind == RS_S_SAVE then 0 else 2);
  }
  c.immune_cond = RS_POISONED;
  #assert rs_effect_condition_mask(c,RS_POISONED) == 0 && rs_effect_condition_mask(c,RS_BLINDED) == RS_BLINDED;
  c.raging = true; c.mindless = true;
  #assert rs_effect_condition_mask(c,RS_CHARMED|RS_FRIGHTENED|RS_BLINDED) == RS_BLINDED;
  c.raging = false;
  #assert rs_effect_condition_mask(c,RS_CHARMED) == RS_CHARMED;
  c.mindless = false; c.raging = true;
  #assert rs_effect_condition_mask(c,RS_FRIGHTENED) == RS_FRIGHTENED;
}
#test "weapon batches reserve Sap at every possible foe and Vex on the attacker" {
  b: [1] RsBattle;
  a := rs_add(b[..],rs_paladin("Paladin",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("First",1),2,1);
  u := rs_add(b[..],rs_skeleton("Next",1),1,2);
  for k: 0..<RS_EFFECTS-1 { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX}; }
  #assert rs_strikes_fit(b[..],a,t,W_LONGSWORD,1,false) && !rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,false);
  b[0].c[t].eff[RS_EFFECTS-2].kind = EF_NONE;
  #assert rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,false) && !rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,true);
  b[0].c[u].team = 0; #assert rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,true);
  b[0].c[u].team = 1; b[0].c[u].dead = true; #assert rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,true);
  b[0].c[u].dead = false; b[0].c[u].x = 10; #assert rs_strikes_fit(b[..],a,t,W_LONGSWORD,2,true);
  b[0].c[a].masteries = 1 << M_VEX;
  for k: 0..<RS_EFFECTS-1 { b[0].c[a].eff[k] = RsEffect.{kind=EF_HEX}; }
  #assert rs_strikes_fit(b[..],a,t,W_SHORTSWORD,1,false) && !rs_strikes_fit(b[..],a,t,W_SHORTSWORD,2,false);
}

#test "effect demand counts carriers and excludes immune, raw prone and same-zone retries" {
  c: RsCreature;
  s: RsSpell; s.step_n = 1; s.steps[0] = RsStep.{kind=RS_S_CONDITION,a=RS_PRONE};
  #assert rs_effect_demand(c,s,-1,0,0) == 0;
  s.steps[0].a = RS_RESTRAINED;
  #assert rs_effect_demand(c,s,0,0,0) == 1;
  c.eff[0] = RsEffect.{kind=EF_ZONE_RESTRAIN,cond=0,by=0,spell=0};
  #assert rs_effect_demand(c,s,0,0,0) == 0 && rs_effect_demand(c,s,1,0,0) == 1;
  s.steps[0].kind = RS_S_TIMED; #assert rs_effect_demand(c,s,0,0,0) == 1;
  s.steps[0].kind = RS_S_CONDITION; s.steps[0].a = RS_BLINDED; #assert rs_effect_demand(c,s,0,0,0) == 1;
  s.steps[0].a = RS_RESTRAINED;
  c.immune_cond = RS_RESTRAINED; #assert rs_effect_demand(c,s,1,0,0) == 0;
  s.steps[0].kind = RS_S_DAMAGE; #assert rs_effect_demand(c,s,-1,0,0) == 0;
  s.steps[0].kind = RS_S_TIMED; s.steps[0].a = RS_CHARMED;
  #assert rs_effect_demand(c,s,-1,0,0) == 1;
  c.raging = true; c.mindless = true; #assert rs_effect_demand(c,s,-1,0,0) == 0;
}
#test "a Blinded creature in a sight-required area needs no effect room" {
  for blinded: 0..<2 {
    b: [1] RsBattle; b[0].w=20; b[0].h=20; b[0].dice[0].fixed=true;
    i := rs_add(b[..],rs_bard("Bard",0,5),1,1);
    j := rs_add(b[..],rs_fighter("Seen",1,1),6,6);
    for k: 0..<RS_EFFECTS { b[0].c[j].eff[k].kind=EF_HEX; }
    b[0].c[j].cond = ifx blinded==1 then RS_BLINDED else RS_CHARMED;
    #assert rs_cast_effect_room(b[..],i,rs_spell(SP_HYPNOTIC_PATTERN),SP_HYPNOTIC_PATTERN,3,6,6,-1)==(blinded==1);
  }
}
#test "Petrified creatures are immune to Poisoned and keep other conditions" {
  c: RsCreature; c.cond=RS_PETRIFIED;
  #assert rs_effect_condition_mask(c,RS_POISONED)==0 && rs_effect_condition_mask(c,RS_POISONED|RS_BLINDED)==RS_BLINDED;
  c.cond=RS_BLINDED; #assert rs_effect_condition_mask(c,RS_POISONED|RS_BLINDED)==(RS_POISONED|RS_BLINDED);
  c.cond=RS_PETRIFIED; c.raging=true; c.mindless=true;
  #assert rs_effect_condition_mask(c,RS_POISONED|RS_CHARMED|RS_FRIGHTENED|RS_PRONE)==RS_PRONE;
}
rs_effect_condition_mask :: (c: RsCreature, mask: int) -> int #effects(all) {
  if (c.immune_cond & mask) != 0 { return 0; }
  // Petrified (p.186): Immunity to the Poisoned condition.
  m := ifx rs_has(c,RS_PETRIFIED) then mask & (32767-RS_POISONED) else mask;
  return ifx c.raging && c.mindless then m & (32767-RS_CHARMED-RS_FRIGHTENED) else m;
}
rs_effect_demand :: (c: RsCreature, s: RsSpell, zone: int, by: int, spell: int) -> int #effects(all) {
  n := 0;
  for k: 0..<s.step_n {
    st := s.steps[k];
    if st.kind == RS_S_CONDITION || st.kind == RS_S_TIMED || st.kind == RS_S_DAZE {
      if st.kind == RS_S_CONDITION && st.a == RS_PRONE { continue; }
      if rs_effect_condition_mask(c,st.a) == 0 { continue; }
      retained := false;
      if st.kind == RS_S_CONDITION && st.a == RS_RESTRAINED && zone >= 0 {
        for e: c.eff { if e.kind == EF_ZONE_RESTRAIN && e.cond == zone && e.by == by && e.spell == spell { retained = true; } }
      }
      if !retained { n += 1; }
    } else if st.kind == RS_S_NOHEAL || st.kind == RS_S_ENFEEBLE || st.kind == RS_S_HEX || st.kind == RS_S_EXPOSE || st.kind == RS_S_MOCK || st.kind == RS_S_BOON || st.kind == RS_S_HALT || st.kind == RS_S_MARK { n += 1; }
  }
  return n;
}
rs_cast_effect_room :: (b: [] RsBattle, i: int, s: RsSpell, sp: int, slot: int, tx: int, ty: int, target: int) -> bool #effects(all) {
  me := b[0].c[i];
  if s.area == RS_A_NONE && s.humanoid_only && !b[0].c[target].humanoid { return true; }
  more: [RS_TARGETS_MAX] int; more_n: int;
  if s.area == RS_A_NONE && s.targets >= 2 { more_n = rs_more_targets(b,i,target,rs_min(s.targets+rs_max(slot-s.level,0),RS_TARGETS_MAX)-1,s.range_ft,more[..]); }
  area := rs_area(b,i,s,tx,ty);
  reps := 1;
  for k: 0..<s.step_n { st := s.steps[k]; if st.kind == RS_S_REPEAT { reps = st.a+st.b*rs_max(slot-s.level,0); if st.c == 1 { reps = st.a*rs_cantrip_tier(me.level); } } }
  sculpted := 0;
  for j: 0..<b[0].n {
    if s.area == RS_A_NONE {
      chosen := j == target;
      for m: 0..<more_n { if more[m] == j { chosen = true; } }
      if !chosen { continue; }
    } else {
      if !rs_inside(area,b[0].c[j].x,b[0].c[j].y) || b[0].c[j].dead || (j == i && rs_area_spares_caster(s.area,s.others,b[0].areas)) || rs_area_unseen(s.sight,rs_has(b[0].c[j],RS_BLINDED)) { continue; }
      if me.sculpt && s.school == "Evocation" && b[0].c[j].team == me.team && sculpted < 1+s.level { sculpted += 1; continue; }
    }
    if s.humanoid_only && !b[0].c[j].humanoid { continue; }
    // New casts prepay new leases; only a continuing area's application can
    // reuse one. Replacing concentration releases old records below.
    need := rs_effect_demand(b[0].c[j],s,-1,i,sp);
    if s.area == RS_A_NONE { need *= reps; }
    if rs_effect_room(b[0].c[j],s.concentration,i,me.conc) < need { return false; }
  }
  return true;
}
// Auto-retargeting an Extra Attack is not predictable before the first die.
// Reserve the worst case at every eligible adjacent target. No roll is used
// to discover whether the operation can afford authoritative records.
#load "strike-admission.coax";
#load "area-origin.coax";
