// SRD 5.2.1 Concentration/Incapacitated and Rage/Turn Undead ending rules.
#load "battle.coax";

#forall "each retained condition interrupts concentration only when it incapacitates" bit: 0..<15 {
  stops := [15] bool.[false,false,false,false,false,false,true,false,true,true,false,false,false,true,true];
  for kind: [3] int.[EF_COND,EF_DAZED,EF_TURNED] {
    b: [1] RsBattle; el_field(b[..]);
    b[0].c[1].conc = SP_BLESS; b[0].c[1].conc_until = 60;
    #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_BLESS,by=1,spell=SP_BLESS,until=60,save=-1});
    #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_BLESS,by=0,spell=SP_BLESS,until=60,save=-1});
    b[0].zone[0] = RsZone.{on=true,by=1,spell=SP_BLESS};
    b[0].zone[1] = RsZone.{on=true,by=0,spell=SP_BLESS};
    b[0].c[2].outlined_by = 1; b[0].c[2].outlined_until = 60;
    #assert rs_put_effect(b[..],1,RsEffect.{kind=kind,cond=1<<bit,by=0,spell=-1,until=30,save=-1});
    #assert (b[0].c[1].conc == -1) == stops[bit];
    #assert (b[0].c[2].eff[0].kind == EF_NONE) == stops[bit];
    #assert b[0].c[2].eff[1].kind == EF_BLESS && b[0].zone[1].on;
    #assert b[0].zone[0].on == !stops[bit] && (b[0].c[2].outlined_by == -1) == stops[bit];
    #assert rs_has(b[0].c[1],1<<bit);
  }
}

#test "incapacitation ends Rage and only that clerics Turn Undead ownership immediately" {
  for condition: [5] int.[RS_INCAPACITATED,RS_PARALYZED,RS_PETRIFIED,RS_STUNNED,RS_UNCONSCIOUS] {
    b: [1] RsBattle; el_field(b[..]); b[0].c[1].raging = true; b[0].c[1].rage_kept = true;
    b[0].c[1].turn_undead = true;
    #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_TURNED,cond=RS_FRIGHTENED|RS_INCAPACITATED,by=1,spell=-1,until=60,save=-1});
    #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_TURNED,cond=RS_FRIGHTENED|RS_INCAPACITATED,by=0,spell=-1,until=60,save=-1});
    #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_COND,cond=condition,by=0,spell=-1,until=30,save=-1});
    #assert !b[0].c[1].raging && !b[0].c[1].rage_kept;
    #assert b[0].c[2].eff[0].kind == EF_NONE && b[0].c[2].eff[1].kind == EF_TURNED;
    #assert rs_has(b[0].c[2],RS_FRIGHTENED|RS_INCAPACITATED);
  }
}

#test "refused full storage and immune condition outcomes do not interrupt concentration" {
  for kind: [3] int.[EF_COND,EF_TURNED,EF_DAZED] { for immune: 0..<2 {
    b: [1] RsBattle; el_field(b[..]); b[0].c[1].conc = SP_BLESS;
    if immune == 1 { b[0].c[1].immune_cond = RS_PARALYZED; }
    else { for k: 0..<RS_EFFECTS { #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_HEX,by=0,spell=SP_HEX,until=60,save=-1}); } }
    before := b[0].book[0].seq;
    #assert rs_put_effect(b[..],1,RsEffect.{kind=kind,cond=RS_PARALYZED,by=0,spell=-1,until=30,save=-1}) == (immune == 1);
    #assert b[0].c[1].conc == SP_BLESS && !rs_has(b[0].c[1],RS_PARALYZED) && b[0].book[0].seq == before;
  } }
}

#test "noncondition carriers and Command Halt do not infer incapacity from their payload bits" {
  for kind: [5] int.[EF_HEX,EF_BLESS,EF_EXPOSED,EF_HALT_PENDING,EF_HALT] {
    b: [1] RsBattle; el_field(b[..]); b[0].c[1].conc = SP_BLESS;
    b[0].c[1].immune_cond = RS_INCAPACITATED;
    #assert rs_put_effect(b[..],1,RsEffect.{kind=kind,cond=RS_INCAPACITATED,by=0,spell=-1,until=30,save=-1});
    #assert b[0].c[1].conc == SP_BLESS && b[0].c[1].cond == 0;
    #assert b[0].c[1].eff[0].kind == kind && b[0].c[1].eff[0].cond == RS_INCAPACITATED;
  }
}

#test "Mindless Rage filters only condition carriers and preserves every other retained field" {
  for mode: 0..<4 { for kind: [4] int.[EF_COND,EF_TURNED,EF_DAZED,EF_HEX] {
    for mask: [5] int.[RS_CHARMED,RS_FRIGHTENED,RS_CHARMED|RS_FRIGHTENED,RS_BLINDED,RS_CHARMED|RS_FRIGHTENED|RS_BLINDED] {
      b: [1] RsBattle; el_field(b[..]);
      b[0].c[1].mindless = (mode & 1) != 0; b[0].c[1].raging = (mode & 2) != 0;
      #assert rs_put_effect(b[..],1,RsEffect.{kind=kind,cond=mask,by=2,spell=SP_HEX,until=47,save=RS_WIS,dc=13});
      expected := ifx mode == 3 && kind != EF_HEX then mask & RS_BLINDED else mask;
      if expected == 0 { #assert b[0].c[1].eff[0].kind == EF_NONE; }
      else {
        e := b[0].c[1].eff[0];
        #assert e.kind == kind && e.cond == expected && e.by == 2 && e.spell == SP_HEX && e.until == 47 && e.save == RS_WIS && e.dc == 13;
      }
      #assert b[0].c[1].cond == (ifx kind == EF_HEX then 0 else expected);
      #assert b[0].c[1].raging == ((mode & 2) != 0) && b[0].book[0].seq == 0;
    }
  } }
}

#test "Stunning Strike breaks an actual Bless cast immediately and ending Stunned does not resume it" {
  b: [1] RsBattle; el_field(b[..]);
  b[0].c[0] = rs_monk("Monk",0,5); rs_place(b[..],0,1,1); b[0].c[0].stun_ready = true;
  b[0].c[1] = rs_cleric("Cleric",1,3); rs_place(b[..],1,2,1);
  b[0].c[1].score[RS_CON] = 8; b[0].who = 1;
  #assert rs_cast(b[..],1,SP_BLESS,1,0,0,2) && rs_effect(b[0].c[2],EF_BLESS);
  b[0].who = 0; b[0].turn = RsTurn.{};
  rs_stunning_strike(b[..],0,1);
  #assert rs_has(b[0].c[1],RS_STUNNED) && b[0].c[1].conc == -1;
  #assert !rs_effect(b[0].c[2],EF_BLESS) && b[0].c[0].focus == 4;
  for k: 0..<RS_EFFECTS { if b[0].c[1].eff[k].kind == EF_COND { rs_drop_effect(b[..],1,k); } }
  #assert !rs_has(b[0].c[1],RS_STUNNED) && b[0].c[1].conc == -1;
}

#test "Stunning Strike against condition immunity does not end Rage without inflicting Stunned" {
  b: [1] RsBattle; el_field(b[..]);
  b[0].c[0] = rs_monk("Monk",0,5); rs_place(b[..],0,1,1); b[0].c[0].stun_ready = true;
  b[0].c[1].raging = true; b[0].c[1].immune_cond = RS_STUNNED;
  rs_stunning_strike(b[..],0,1);
  #assert !rs_has(b[0].c[1],RS_STUNNED) && b[0].c[1].raging;
}

#test "dropping to zero HP ends Rage immediately rather than at the next turn" {
  b: [1] RsBattle; el_field(b[..]); b[0].c[1].raging = true;
  rs_damage(b[..],0,1,100,RS_FIRE,false,-1);
  #assert b[0].c[1].hp == 0 && !b[0].c[1].raging && rs_has(b[0].c[1],RS_UNCONSCIOUS);
}

el_field :: (b: [] RsBattle) {
  b[0].w = 16; b[0].h = 8; b[0].dice[0].fixed = true;
  _ := rs_add(b,rs_skeleton("Actor",0),1,1);
  _ = rs_add(b,rs_skeleton("Recipient",1),2,1);
  _ = rs_add(b,rs_skeleton("Other",1),3,1);
  for j: 0..<3 {
    b[0].c[j].hp = 100; b[0].c[j].hp_max = 100; b[0].c[j].immune_cond = 0;
    b[0].c[j].immune = 0; b[0].c[j].resist = 0; b[0].c[j].vulnerable = 0;
  }
  b[0].who = 0; b[0].dice[0].rolled = 0;
}
