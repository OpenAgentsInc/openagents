// SRD 5.2.1 pp. 90, 106, 112, 113, 138, 171-172: equal named spell
// benefits do not add dice; every next-roll rider names the same next roll.
#load "battle.coax";

#test "overlapping Bless and Bane retain their owners but roll one die per spell" {
  b: [1] RsBattle; er_setup(b[..]);
  for owner: 0..<3 {
    #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_BLESS,by=owner,spell=SP_BLESS,until=10+f32(owner)});
    #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_BANE,by=owner,spell=SP_BANE,until=20+f32(owner)});
  }
  #assert rs_boon_roll(b[..],0) == 0 && b[0].dice[0].rolled == 2;
  for k: 0..<RS_EFFECTS { #assert b[0].c[0].eff[k].kind != EF_NONE; }
  rs_drop_effect(b[..],0,0); rs_drop_effect(b[..],0,1);
  #assert rs_boon_roll(b[..],0) == 0 && b[0].dice[0].rolled == 4;
  rs_drop_effect(b[..],0,2); rs_drop_effect(b[..],0,3);
  #assert rs_boon_roll(b[..],0) == 0 && b[0].dice[0].rolled == 6;
  rs_drop_effect(b[..],0,4); rs_drop_effect(b[..],0,5);
  #assert rs_boon_roll(b[..],0) == 0 && b[0].dice[0].rolled == 6;
}

#forall "named boon dice are independent of multiplicity and physical slot" bits: 0..<64 {
  b: [1] RsBattle; er_setup(b[..]);
  for k: 0..<RS_EFFECTS {
    if (bits & (1 << k)) != 0 { b[0].c[0].eff[k] = RsEffect.{kind=EF_BLESS,by=k,spell=SP_BLESS,until=20}; }
    else { b[0].c[0].eff[k] = RsEffect.{kind=EF_HEX,by=k,spell=SP_HEX,until=20}; }
  }
  n := ifx bits == 0 then 0 else 1;
  #assert rs_boon_roll(b[..],0) == 2*n && b[0].dice[0].rolled == n;
  for k: 0..<RS_EFFECTS { if b[0].c[0].eff[k].kind == EF_BLESS { b[0].c[0].eff[k].kind = EF_BANE; } }
  #assert rs_boon_roll(b[..],0) == -2*n && b[0].dice[0].rolled == 2*n;
}

#test "a single next attack consumes all weakness riders and preserves unrelated effects" {
  b: [1] RsBattle; er_setup(b[..]);
  for k: 0..<RS_EFFECTS {
    b[0].c[0].eff[k] = RsEffect.{kind=ifx k == 2 then EF_BLESS else EF_WEAK,by=k,spell=-1,until=20};
  }
  #assert rs_attack_edge(b[..],0,1,true,true) == -1;
  #assert er_count(b[0].c[0],EF_WEAK) == 0 && er_count(b[0].c[0],EF_BLESS) == 1;
  #assert rs_attack_edge(b[..],0,1,true,true) == 0;
  #assert b[0].dice[0].rolled == 0 && b[0].book[0].seq == 0;
}

#test "all pending Vex and Guiding Bolt riders bind one roll and Vex keeps its other target" {
  b: [1] RsBattle; er_setup(b[..]);
  for k: 0..<RS_EFFECTS {
    b[0].c[0].eff[k] = RsEffect.{kind=EF_VEX,cond=ifx k == 2 then 2 else 1,by=k,spell=-1,until=20};
    b[0].c[1].eff[k] = RsEffect.{kind=EF_EXPOSED,by=k,spell=SP_GUIDING_BOLT,until=20};
  }
  #assert rs_attack_edge(b[..],0,1,true,true) == 1;
  #assert er_count(b[0].c[0],EF_VEX) == 1 && b[0].c[0].eff[2].cond == 2;
  #assert er_count(b[0].c[1],EF_EXPOSED) == 0;
  #assert rs_attack_edge(b[..],0,1,true,true) == 0;
  #assert rs_attack_edge(b[..],0,2,true,true) == 1 && er_count(b[0].c[0],EF_VEX) == 0;
  #assert rs_attack_edge(b[..],0,2,true,true) == 0;
}

#test "opposing next-roll sources cancel once and are all consumed even on the canceled roll" {
  b: [1] RsBattle; er_setup(b[..]);
  for k: 0..<RS_EFFECTS {
    b[0].c[0].eff[k] = RsEffect.{kind=EF_WEAK,until=20};
    b[0].c[1].eff[k] = RsEffect.{kind=EF_EXPOSED,spell=SP_GUIDING_BOLT,until=20};
  }
  #assert rs_attack_edge(b[..],0,1,true,true) == 0;
  #assert er_count(b[0].c[0],EF_WEAK) == 0 && er_count(b[0].c[1],EF_EXPOSED) == 0;
  #assert rs_attack_edge(b[..],0,1,true,true) == 0;
}

#test "two actual Bless casts keep independent concentration and expiry without stacking dice" {
  for ending: 0..<3 {
    b: [1] RsBattle; b[0].dice[0].fixed = true; b[0].w = 16; b[0].h = 8;
    _ := rs_add(b[..],rs_cleric("Earlier",0,3),1,1);
    _ = rs_add(b[..],rs_cleric("Later",0,3),2,1);
    _ = rs_add(b[..],rs_skeleton("Ally",0),3,1);
    rs_start_turn(b[..],0); #assert rs_cast(b[..],0,SP_BLESS,1,0,0,2); rs_end_turn(b[..],0);
    rs_tick(b[..],15);
    rs_start_turn(b[..],1); #assert rs_cast(b[..],1,SP_BLESS,1,0,0,2); rs_end_turn(b[..],1);
    #assert er_count(b[0].c[2],EF_BLESS) == 2;
    rolled := b[0].dice[0].rolled;
    #assert rs_boon_roll(b[..],2) == 2 && b[0].dice[0].rolled == rolled+1;
    if ending == 2 { rs_tick(b[..],45); }
    else { rs_end_concentration(b[..],ending," (test owner ends)"); }
    #assert er_count(b[0].c[2],EF_BLESS) == 1;
    rolled = b[0].dice[0].rolled;
    #assert rs_boon_roll(b[..],2) == 2 && b[0].dice[0].rolled == rolled+1;
    if ending == 2 {
      #assert b[0].c[0].conc == -1 && b[0].c[1].conc == SP_BLESS;
      rs_tick(b[..],15);
    } else { rs_end_concentration(b[..],1-ending," (last owner ends)"); }
    rolled = b[0].dice[0].rolled;
    #assert er_count(b[0].c[2],EF_BLESS) == 0 && rs_boon_roll(b[..],2) == 0 && b[0].dice[0].rolled == rolled;
  }
}

#test "a real missed weapon roll consumes all its riders even when opposing sources cancel" {
  b: [1] RsBattle; er_setup(b[..]); b[0].c[1].ac = 100;
  for k: 0..<3 {
    #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_WEAK,by=k,until=20});
    #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_EXPOSED,by=k,spell=SP_GUIDING_BOLT,until=20});
  }
  #assert !rs_strike(b[..],0,1,W_SHORTSWORD,false);
  #assert b[0].dice[0].rolled == 1 && b[0].c[1].hp == 13;
  #assert er_count(b[0].c[0],EF_WEAK) == 0 && er_count(b[0].c[1],EF_EXPOSED) == 0;
  #assert !rs_strike(b[..],0,1,W_SHORTSWORD,false) && b[0].dice[0].rolled == 2;
}

#test "seeded named-boon rolls use exactly one d4 per named spell in a stable order" {
  for mode: 0..<3 {
    b: [1] RsBattle; er_setup(b[..]); b[0].dice[0].fixed = false; b[0].dice[0].state = 4729;
    for k: 0..<RS_EFFECTS {
      kind := ifx mode == 0 then EF_BLESS else ifx mode == 1 then EF_BANE else ifx k < 3 then EF_BANE else EF_BLESS;
      b[0].c[0].eff[k] = RsEffect.{kind=kind,by=k,until=20};
    }
    d: [1] RsDice; d[0] = b[0].dice[0];
    expected := 0;
    if mode != 1 { expected += rs_roll(d[..],4); }
    if mode != 0 { expected -= rs_roll(d[..],4); }
    #assert rs_boon_roll(b[..],0) == expected && b[0].dice[0].state == d[0].state && b[0].dice[0].rolled == d[0].rolled;
  }
}

#forall "named boon dice keep the d4 distribution across replay seeds" seed: 1..<65 {
  b: [1] RsBattle; er_setup(b[..]); b[0].dice[0].fixed = false; b[0].dice[0].state = cast(u64) seed;
  b[0].c[0].eff[0] = RsEffect.{kind=EF_BLESS,until=20};
  b[0].c[0].eff[RS_EFFECTS-1] = RsEffect.{kind=EF_BANE,until=20};
  d: [1] RsDice; d[0] = b[0].dice[0];
  expected := rs_roll(d[..],4) - rs_roll(d[..],4);
  #assert rs_boon_roll(b[..],0) == expected && b[0].dice[0].state == d[0].state && b[0].dice[0].rolled == 2;
}

er_setup :: (b: [] RsBattle) {
  b[0].dice[0].fixed = true;
  _ := rs_add(b,rs_skeleton("First",0),1,1);
  _ = rs_add(b,rs_skeleton("Second",1),2,1);
  _ = rs_add(b,rs_skeleton("Third",1),1,2);
  b[0].dice[0].rolled = 0;
}
er_count :: (c: RsCreature, kind: int) -> int {
  n := 0; for e: c.eff { if e.kind == kind { n += 1; } } return n;
}
