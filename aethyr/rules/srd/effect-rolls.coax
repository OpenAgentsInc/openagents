// SRD 5.2.1 pp. 90, 106, 112, 113, 138, 171-172. Independent effect
// records keep their owners and deadlines; equal named benefits do not stack.
#authority;

// Every matching next-roll rider names this roll, including a miss or a roll
// whose Advantage and Disadvantage cancel. Vex binds only its named target.
rs_take_pending :: (b: [] RsBattle, i: int, kind: int, target: int) -> bool #effects(all) {
  any := false;
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.kind == kind && (kind != EF_VEX || e.cond == target) {
      rs_drop_effect(b,i,k); any = true;
    }
  }
  return any;
}
rs_take_weak :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  return rs_take_pending(b,i,EF_WEAK,i); // only Vex uses the target filter
}

// Bless and Bane each supply one d4, regardless of how many independent
// castings remain. Neither spell suppresses the other. Lifecycle retirement
// stays with rs_tick / rs_end_concentration, so ending one owner keeps another.
rs_boon_roll :: (b: [] RsBattle, j: int) -> int #effects(all) {
  bless := false; bane := false;
  for e: b[0].c[j].eff {
    if e.kind == EF_BLESS { bless = true; }
    if e.kind == EF_BANE { bane = true; }
  }
  n := 0;
  if bless { n += rs_roll(b[0].dice[..],4); }
  if bane { n -= rs_roll(b[0].dice[..],4); }
  return n;
}
