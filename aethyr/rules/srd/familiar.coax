// SRD 5.2.1 pp.43 and 130. A familiar is an independently scheduled ally
// in the battle. The Druid's Wild Companion pays a slot or Wild Shape use.
#authority;
RS_FAMILIAR_FEY :: 1; RS_FAMILIAR_CELESTIAL :: 2; RS_FAMILIAR_FIEND :: 3;
RS_FIND_FAMILIAR_SECONDS :: 3600.0;

rs_familiar_of :: (b:[]RsBattle,owner:int)->int #effects(all) {
  if owner<0 || owner>=b[0].n { return -1; }
  for j:0..<b[0].n { if b[0].c[j].familiar_owner==owner+1 { return j; } }
  return -1;
}
rs_familiar_retire :: (b:[]RsBattle,j:int) #effects(all) {
  b[0].c[j].hp=0; b[0].c[j].dead=true;
  rs_place(b,j,-1,-1);
}
rs_familiar_end_rest :: (b:[]RsBattle,owner:int) #effects(all) {
  j:=rs_familiar_of(b,owner);
  if j>=0 && b[0].c[j].familiar_until_rest { rs_familiar_retire(b,j); }
}

rs_familiar_form :: (m:int)->bool #effects(all) {
  return m==MON_RAT || m==MON_SPIDER || m==MON_CAT;
}
rs_familiar_destination :: (b:[]RsBattle,i:int,x:int,y:int)->bool #effects(all) {
  me:=b[0].c[i];
  return x>=0 && y>=0 && x<b[0].w && y<b[0].h && rs_max(rs_abs(me.x-x),rs_abs(me.y-y))<=2 && rs_at(b,x,y)<0;
}
// Preflight returns the owned actor's index, or the next free actor index.
rs_familiar_plan :: (b:[]RsBattle,i:int,m:int,x:int,y:int)->int #effects(all) {
  if !rs_familiar_form(m) { return -1; }
  j:=rs_familiar_of(b,i);
  if j>=0 && !b[0].c[j].dead {
    return ifx b[0].c[j].familiar_form!=m then j else -1;
  }
  if !rs_familiar_destination(b,i,x,y) { return -1; }
  if j>=0 { return j; }
  return ifx b[0].n<b[0].c.count then b[0].n else -1;
}
rs_familiar_publish :: (b:[]RsBattle,i:int,j:int,m:int,x:int,y:int,spirit:int,until_rest:bool) #effects(all) {
  fresh:=rs_monster(m,"Familiar",b[0].c[i].team);
  if j==b[0].n {
    _:=rs_add(b,fresh,x,y);
  } else if b[0].c[j].dead {
    b[0].c[j]=fresh;
    rs_place(b,j,x,y);
    _:=rs_roll_initiative(b,j);
  } else {
    // Recasting changes the form in place and keeps its turn and caps its current HP.
    b[0].c[j].score=fresh.score;
    b[0].c[j].save_prof=fresh.save_prof;
    b[0].c[j].ac=fresh.ac;
    b[0].c[j].hp_max=fresh.hp_max;
    b[0].c[j].hp=rs_min(b[0].c[j].hp,fresh.hp_max);
    b[0].c[j].speed=fresh.speed;
    b[0].c[j].climb=fresh.climb;
    b[0].c[j].jumper=fresh.jumper;
    b[0].c[j].form=fresh.form;
  }
  if b[0].c[j].familiar_form==0 {
    rank:=RS_INIT_SPAN-rs_init_slot(b[0].c[j].initiative);
    b[0].c[j].turn_at=b[0].clock+rs_beat(b)*f32(rank)/f32(RS_INIT_SPAN);
    b[0].c[j].round_at=b[0].c[j].turn_at;
  }
  b[0].c[j].familiar_owner=i+1;
  b[0].c[j].familiar_form=m;
  b[0].c[j].familiar_spirit=spirit;
  b[0].c[j].fiend=spirit==RS_FAMILIAR_FIEND;
  b[0].c[j].celestial=spirit==RS_FAMILIAR_CELESTIAL;
  b[0].c[j].familiar_until_rest=until_rest;
}
// Slot zero means a Wild Shape use. The feature waives only Material components.
rs_wild_companion :: (b:[]RsBattle,i:int,slot:int,m:int,x:int,y:int)->bool #effects(all) {
  if i<0 || i>=b[0].n || b[0].reaction_frame.on || !rs_action_free(b,i) { return false; }
  me:=b[0].c[i];
  if !me.companion || rs_casting_barred(me) || b[0].turn.quickened || me.speech_blocked || !me.gesture_hand { return false; }
  if slot<0 || slot>=me.slots.count { return false; }
  if slot==0 {
    if me.uses[RS_USE_WILD]<=0 { return false; }
  } else if b[0].turn.slot_spent || me.slots[slot]<=0 { return false; }
  j:=rs_familiar_plan(b,i,m,x,y);
  if j<0 { return false; }
  rs_rest_cause_before(b,i);
  b[0].turn.action=true; b[0].turn.leveled=true;
  if slot==0 { b[0].c[i].uses[RS_USE_WILD]-=1; }
  else { b[0].c[i].slots[slot]-=1; b[0].turn.slot_spent=true; }
  rs_unhide(b,i);
  rs_familiar_publish(b,i,j,m,x,y,RS_FAMILIAR_FEY,true);
  rs_say(b,RS_EV_CAST,i,j,m," casts Find Familiar through Wild Companion");
  return true;
}

#test "Wild Companion creates one Fey ally, never attacks, and expires at a completed Long Rest" {
  b:[1]RsBattle;
  b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_druid("Druid",0,2),1,1);
  enemy:=rs_add(b[..],rs_fighter("Enemy",1,1),3,1); #assert enemy==1;
  rs_fresh(b[..],0);
  used:=b[0].c[0].uses[RS_USE_WILD];
  #assert !rs_wild_companion(b[..],0,0,MON_WOLF,2,1);
  #assert !rs_wild_companion(b[..],0,0,MON_CAT,3,1);
  #assert b[0].n==2 && b[0].c[0].uses[RS_USE_WILD]==used && !b[0].turn.action;
  #assert rs_long_rest_start_owned(b[..],0,2,true);
  #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_COND,cond=RS_INVISIBLE,by=0,spell=RS_HIDE_SPELL,until=90000,save=-1});
  #assert rs_wild_companion(b[..],0,0,MON_CAT,2,1);
  #assert rs_hidden_at(b[0].c[0])<0 && b[0].c[0].long_rest.phase==2;
  #assert rs_recent_at(b[0].book[..],0).kind==RS_EV_CAST;
  j:=rs_familiar_of(b[..],0);
  #assert j==2 && b[0].n==3 && b[0].c[j].familiar_spirit==RS_FAMILIAR_FEY;
  #assert b[0].c[j].hp==2 && b[0].c[j].initiative==12 && b[0].c[j].turn_at==4.21875 && b[0].c[j].round_at==4.21875;
  #assert b[0].c[0].uses[RS_USE_WILD]==used-1 && b[0].turn.action && b[0].turn.leveled;
  rs_fresh(b[..],j);
  #assert !rs_attack(b[..],j,1,false,-1);
  #assert !rs_stat_attack(b[..],j,1,rs_monster_action(MON_CAT).attacks[0]);
  b[0].c[1].form=rs_form(RS_SMALL,0);
  #assert !rs_unarmed_fits(b[..],j,1,UO_PRONE);
  move:=RsOpportunityMove.{measured=true,from_feet=5,to_feet=6,reach=5,melee=true,seen=true,movement=true};
  #assert !rs_opportunity_trigger(b[..],j,1,move);
  #assert !rs_ready(b[..],j,RD_ATTACK,1,-1,0);
  #assert !b[0].turn.action && rs_ready(b[..],j,RD_MOVE,1,-1,0);
  b[0].c[j].form=rs_form(RS_SMALL,0);  // an altered size gives way to the replacement form

  rs_fresh(b[..],0); b[0].c[0].slots[1]=1; slots:=b[0].c[0].slots[1];
  #assert rs_wild_companion(b[..],0,1,MON_RAT,1,2);
  #assert b[0].n==3 && rs_familiar_of(b[..],0)==j && b[0].c[j].familiar_form==MON_RAT;
  #assert b[0].c[j].x==2 && b[0].c[j].y==1 && b[0].c[0].slots[1]==slots-1 && b[0].turn.slot_spent;
  rat:=b[0].c[j];
  #assert rat.hp==1 && rat.hp_max==1 && rat.ac==10 && rat.score[RS_STR]==2 && rat.score[RS_DEX]==11;
  #assert !rat.save_prof[RS_DEX] && rat.speed==20 && rat.climb==20 && !rat.jumper && rs_size(rat)==RS_TINY;
  #assert rat.turn_at==4.21875 && rat.initiative==12;
  rs_damage(b[..],1,j,5,RS_FORCE,false,-1);
  #assert b[0].c[j].dead && b[0].c[j].hp==0 && b[0].c[j].x==-1 && b[0].c[j].y==-1 && rs_at(b[..],2,1)==-1;
  rs_fresh(b[..],0);
  #assert rs_wild_companion(b[..],0,0,MON_CAT,2,1) && b[0].n==3;
  #assert !b[0].c[j].dead && b[0].c[j].hp==2 && rs_at(b[..],2,1)==j;
  b[0].c[0].long_rest.phase=3;
  #assert rs_long_rest_apply(b[..],0) && b[0].c[j].dead && b[0].c[j].hp==0 && rs_at(b[..],2,1)==-1;
}


#test "Wild Companion rejects illegal positions, costs, turn owners and capacity without spending" {
  b:[1]RsBattle; storage:[3]RsCreature; b[0].c=storage[..];
  b[0].w=6; b[0].h=6; b[0].dice[0].fixed=true;
  caster:=rs_add(b[..],rs_druid("Druid",0,2),2,2);
  #assert caster==0;
  rs_fresh(b[..],0);
  base:=b[0].c[0]; turn:=b[0].turn; rolls:=b[0].dice[0].rolled;
  for mode:0..<25 {
    b[0].c[0]=base; b[0].w=6; b[0].h=6; b[0].turn=turn; b[0].who=0; b[0].reaction_frame.on=false;
    i:=0; slot:=0; m:=MON_CAT; x:=2; y:=3;
    if mode==0 { i=-1; b[0].who=i; }
    if mode==1 { i=b[0].n; b[0].who=i; storage[1]=base; }
    if mode==2 { b[0].reaction_frame.on=true; }
    if mode==3 { b[0].who=-1; }
    if mode==4 { b[0].turn.action=true; }
    if mode==5 { b[0].c[0].companion=false; }
    if mode==6 { b[0].c[0].wild_form=MON_WOLF; }
    if mode==7 { b[0].turn.quickened=true; }
    if mode==8 { b[0].c[0].speech_blocked=true; }
    if mode==9 { b[0].c[0].gesture_hand=false; }
    if mode==10 { slot=-1; }
    if mode==11 { slot=10; }
    if mode==12 { b[0].c[0].uses[RS_USE_WILD]=0; }
    if mode==13 { slot=1; b[0].turn.slot_spent=true; }
    if mode==14 { slot=1; b[0].c[0].slots[1]=0; }
    if mode==15 { m=MON_WOLF; }
    if mode==16 { x=-1; b[0].c[0].x=1; }
    if mode==17 { y=-1; b[0].c[0].y=1; }
    if mode==18 { x=4; b[0].w=4; }
    if mode==19 { y=4; b[0].h=4; }
    if mode==20 { x=5; }
    if mode==21 { y=2; }
    if mode==22 { b[0].c=storage[0..<1]; }
    if mode==23 { b[0].c[0].hp=0; }
    if mode==24 { b[0].c[0].raging=true; }
    wild:=b[0].c[0].uses[RS_USE_WILD]; slots:=b[0].c[0].slots[1]; action:=b[0].turn.action;
    #assert !rs_wild_companion(b[..],i,slot,m,x,y);
    #assert b[0].c[0].uses[RS_USE_WILD]==wild && b[0].c[0].slots[1]==slots && b[0].turn.action==action;
    #assert b[0].n==1 && b[0].dice[0].rolled==rolls;
    b[0].c=storage[..];
  }
  b[0].c[0]=base; b[0].turn=turn;
  #assert rs_familiar_of(b[..],-1)==-1 && rs_familiar_of(b[..],1)==-1;
  #assert rs_wild_companion(b[..],0,0,MON_SPIDER,0,0);
  rs_fresh(b[..],0);
  #assert !rs_wild_companion(b[..],0,0,MON_SPIDER,1,1);
  j:=rs_familiar_of(b[..],0);
  #assert j==1 && b[0].c[j].x==0 && b[0].c[j].y==0;
  #assert b[0].c[j].familiar_form==MON_SPIDER && b[0].c[j].familiar_until_rest;
  b[0].c[j].familiar_until_rest=false; rs_familiar_end_rest(b[..],0);
  #assert !b[0].c[j].dead;
  b[0].c[j].familiar_owner=3;
  #assert rs_familiar_of(b[..],2)==-1;
}


#test "Familiar ownership is stable even when a roster restores the familiar before its owner" {
  b:[1]RsBattle; c:[2]RsCreature; b[0].c=c[..]; b[0].w=8; b[0].h=8; b[0].n=2;
  c[1]=rs_druid("Owner",0,2); c[1].x=2; c[1].y=2;
  c[0]=rs_monster(MON_RAT,"Familiar",0); c[0].familiar_owner=2; c[0].familiar_form=MON_RAT; c[0].familiar_until_rest=true;
  c[0].x=3; c[0].y=2;
  #assert rs_familiar_of(b[..],1)==0;
  rs_fresh(b[..],1);
  #assert rs_wild_companion(b[..],1,0,MON_CAT,2,2) && c[0].familiar_form==MON_CAT && c[0].x==3;
  rs_familiar_end_rest(b[..],1);
  #assert c[0].dead && c[0].x==-1 && c[0].y==-1;
  rs_fresh(b[..],1);
  #assert rs_wild_companion(b[..],1,0,MON_CAT,2,3) && !c[0].dead && c[0].y==3;
}

rs_familiar_paid_slot :: (c:RsCreature,slot:int,spent:bool)->bool #effects(all) {
  return slot>0 && slot<c.slots.count && c.slots[slot]>0 && !spent;
}
// The ordinary one-hour cast. Ritual Adept uses rs_ritual_begin instead.
rs_familiar_begin :: (b:[]RsBattle,i:int,slot:int)->bool #effects(all) {
  if i<0 || i>=b[0].n || b[0].reaction_frame.on || !rs_action_free(b,i) { return false; }
  c:=b[0].c[i];
  if c.rite>=0 || rs_casting_barred(c) || b[0].turn.quickened { return false; }
  if !rs_spell_ready(c,SP_FIND_FAMILIAR) || !rs_familiar_paid_slot(c,slot,b[0].turn.slot_spent) || !rs_cast_components_ready(c,SP_FIND_FAMILIAR) { return false; }
  rs_rite_open(b,i,SP_FIND_FAMILIAR,RS_FIND_FAMILIAR_SECONDS,slot);
  rs_say(b,RS_EV_TEXT,i,i,SP_FIND_FAMILIAR," begins casting Find Familiar");
  return true;
}
rs_familiar_finish :: (b:[]RsBattle,i:int,m:int,spirit:int,x:int,y:int)->bool #effects(all) {
  if i<0 || i>=b[0].n || b[0].reaction_frame.on || !rs_action_free(b,i) { return false; }
  if spirit<RS_FAMILIAR_FEY || spirit>RS_FAMILIAR_FIEND { return false; }
  c:=b[0].c[i]; slot:=c.familiar_slot;
  if !rs_rite_due_now(b,i,SP_FIND_FAMILIAR) || c.conc!=SP_FIND_FAMILIAR || rs_casting_barred(c) || b[0].turn.quickened { return false; }
  if slot!=0 && (!rs_spell_ready(c,SP_FIND_FAMILIAR) || !rs_familiar_paid_slot(c,slot,b[0].turn.slot_spent)) { return false; }
  j:=rs_familiar_plan(b,i,m,x,y);
  if j<0 || !rs_cast_components_pay(b[0].c[i..<i+1],SP_FIND_FAMILIAR) { return false; }
  rs_rite_complete(b[0].c[i..<i+1]);
  rs_unhide(b,i);
  b[0].turn.action=true; b[0].turn.leveled=true;
  if slot!=0 { b[0].c[i].slots[slot]-=1; b[0].turn.slot_spent=true; }
  rs_familiar_publish(b,i,j,m,x,y,spirit,false);
  rs_say(b,RS_EV_CAST,i,j,m," completes Find Familiar");
  return true;
}

#test "Find Familiar holds Concentration for an hour and pays incense and slot only on completion" {
  b:[1]RsBattle; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  i:=rs_add(b[..],rs_wizard("Wizard",0,2),2,2);
  c:=b[0].c[i..<i+1]; key:=rs_component_key(SP_FIND_FAMILIAR);
  #assert rs_spellbook_add(c,key);
  rs_fresh(b[..],i);
  #assert !rs_familiar_begin(b[..],i,1);
  picks:=[1]int.[key]; #assert rs_set_spells(c,picks[..]);
  #assert !rs_familiar_begin(b[..],i,1);
  c[0].materials[0]=RsMaterialStock.{key=key,count=1};
  slots:=c[0].slots[1];
  #assert !rs_cast(b[..],i,SP_FIND_FAMILIAR,1,3,2,-1);
  #assert rs_familiar_begin(b[..],i,1) && c[0].rite_until==3600 && c[0].conc==SP_FIND_FAMILIAR;
  #assert b[0].turn.action && !b[0].turn.slot_spent && c[0].slots[1]==slots;
  for turn:1..<600 {
    b[0].clock=f32(turn)*6; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
    #assert rs_ritual_continue(b[..],i);
  }
  b[0].clock=3600; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
  #assert !rs_familiar_finish(b[..],i,MON_CAT,RS_FAMILIAR_FIEND,2,2);
  #assert c[0].slots[1]==slots && c[0].materials[0].count==1 && b[0].n==1;
  #assert rs_familiar_finish(b[..],i,MON_CAT,RS_FAMILIAR_FIEND,3,2);
  j:=rs_familiar_of(b[..],i);
  #assert j==1 && b[0].c[j].fiend && !b[0].c[j].familiar_until_rest;
  #assert b[0].turn.action && b[0].turn.slot_spent && c[0].slots[1]==slots-1;
  #assert c[0].materials[0].count==0 && c[0].rite==-1 && c[0].conc==-1;
  c[0].long_rest.phase=3; #assert rs_long_rest_apply(b[..],i) && !b[0].c[j].dead;
}

#test "Find Familiar ritual uses the spellbook, takes seventy minutes and spends no slot" {
  b:[1]RsBattle; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  i:=rs_add(b[..],rs_wizard("Wizard",0,2),2,2);
  c:=b[0].c[i..<i+1]; key:=rs_component_key(SP_FIND_FAMILIAR);
  #assert rs_spellbook_add(c,key);
  slots:=c[0].slots[1];
  rs_fresh(b[..],i);
  #assert !rs_ritual_begin(b[..],i,SP_FIND_FAMILIAR);
  c[0].materials[0]=RsMaterialStock.{key=key,count=1};
  #assert rs_ritual_begin(b[..],i,SP_FIND_FAMILIAR) && c[0].rite_until==4200;
  b[0].clock=6; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
  #assert !rs_familiar_finish(b[..],i,MON_RAT,RS_FAMILIAR_CELESTIAL,3,2);
  b[0].clock=12; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
  #assert c[0].rite==-1 && c[0].conc==-1 && c[0].materials[0].count==1 && c[0].slots[1]==slots;
  #assert rs_ritual_begin(b[..],i,SP_FIND_FAMILIAR);
  for turn:1..<700 {
    b[0].clock=12+f32(turn)*6; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
    #assert rs_ritual_continue(b[..],i);
  }
  b[0].clock=4212; rs_fresh(b[..],i); rs_rite_turn(b[..],i);
  #assert !rs_cast(b[..],i,SP_FIND_FAMILIAR,0,3,2,-1);

  #assert !rs_familiar_finish(b[..],i,MON_RAT,0,3,2);
  #assert !rs_familiar_finish(b[..],i,MON_RAT,4,3,2);
  #assert rs_familiar_finish(b[..],i,MON_RAT,RS_FAMILIAR_CELESTIAL,3,2);
  j:=rs_familiar_of(b[..],i);
  #assert j==1 && b[0].c[j].celestial && !b[0].c[j].fiend && b[0].c[j].familiar_spirit==RS_FAMILIAR_CELESTIAL;
  #assert c[0].slots[1]==slots && !b[0].turn.slot_spent && c[0].materials[0].count==0;
}

#test "Find Familiar refuses invalid starts and completions before payment" {
  b:[1]RsBattle; storage:[2]RsCreature;
  b[0].c=storage[..]; b[0].n=1; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  c:=storage[0..<1]; c[0]=rs_wizard("Wizard",0,2); c[0].x=2; c[0].y=2;
  key:=rs_component_key(SP_FIND_FAMILIAR); picks:=[1]int.[key];
  #assert rs_spellbook_add(c,key) && rs_set_spells(c,picks[..]);
  c[0].materials[0]=RsMaterialStock.{key=key,count=1};
  c[0].slots[0]=1; c[0].slots[9]=1;
  base:=c[0]; storage[1]=base;
  for mode:0..<11 {
    c[0]=base; rs_fresh(b[..],0); b[0].reaction_frame.on=false;
    i:=0; slot:=1;
    if mode==0 { i=-1; b[0].who=i; }
    if mode==1 { i=1; b[0].who=i; }
    if mode==2 { b[0].reaction_frame.on=true; }
    if mode==3 { b[0].turn.action=true; }
    if mode==4 { b[0].turn.quickened=true; }
    if mode==5 { c[0].raging=true; }
    if mode==6 { c[0].rite=SP_PRODUCE_FLAME; }
    if mode==7 { slot=0; }
    if mode==8 { slot=10; }
    if mode==9 { c[0].slots[1]=0; }
    if mode==10 { b[0].turn.slot_spent=true; }
    #assert !rs_familiar_begin(b[..],i,slot);
    #assert b[0].n==1 && c[0].materials[0].count==1 && c[0].conc==-1;
  }
  c[0]=base; rs_fresh(b[..],0);
  #assert rs_familiar_begin(b[..],0,9);
  event:=rs_recent_at(b[0].book[..],0);
  #assert event.kind==RS_EV_TEXT && event.amount==SP_FIND_FAMILIAR && b[0].turn.leveled;
  rs_end_concentration(b[..],0,"");
  #assert c[0].rite==-1 && c[0].familiar_slot==0 && c[0].slots[9]==1 && c[0].materials[0].count==1;

  rs_fresh(b[..],0); #assert rs_familiar_begin(b[..],0,1);
  b[0].clock=3600; rs_fresh(b[..],0); rs_rite_turn(b[..],0);
  ready:=c[0]; storage[1]=ready;
  for mode:0..<11 {
    c[0]=ready; rs_fresh(b[..],0); b[0].reaction_frame.on=false;
    i:=0;
    if mode==0 { i=-1; b[0].who=i; }
    if mode==1 { i=1; b[0].who=i; }
    if mode==2 { b[0].reaction_frame.on=true; }
    if mode==3 { b[0].turn.action=true; }
    if mode==4 { b[0].turn.quickened=true; }
    if mode==5 { c[0].raging=true; }
    if mode==6 { c[0].conc=-1; }
    if mode==7 { c[0].spells.selected=[6]u64.[0,0,0,0,0,0]; }
    if mode==8 { c[0].materials[0].count=0; }
    if mode==9 { c[0].slots[1]=0; }
    if mode==10 { b[0].turn.slot_spent=true; }
    #assert !rs_familiar_finish(b[..],i,MON_SPIDER,RS_FAMILIAR_FEY,3,2);
    #assert b[0].n==1 && c[0].rite==SP_FIND_FAMILIAR;
  }
  c[0]=ready; rs_fresh(b[..],0);
  #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_COND,cond=RS_INVISIBLE,by=0,spell=RS_HIDE_SPELL,until=90000,save=-1});
  #assert rs_familiar_finish(b[..],0,MON_SPIDER,RS_FAMILIAR_FEY,3,2);
  #assert rs_hidden_at(c[0])<0 && b[0].turn.leveled && c[0].familiar_slot==0;
  #assert rs_recent_at(b[0].book[..],0).kind==RS_EV_CAST;
}

#test "Find Familiar can reform actor zero with the caster at the end of storage" {
  b:[1]RsBattle; storage:[2]RsCreature; b[0].c=storage[..];
  b[0].n=2; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  storage[0]=rs_monster(MON_RAT,"Familiar",0);
  storage[0].familiar_form=MON_RAT; storage[0].familiar_owner=2;
  storage[0].x=3; storage[0].y=2;
  c:=storage[1..<2]; c[0]=rs_wizard("Wizard",0,2); c[0].x=2; c[0].y=2;
  key:=rs_component_key(SP_FIND_FAMILIAR);
  #assert rs_spellbook_add(c,key);
  c[0].materials[0]=RsMaterialStock.{key=key,count=1};
  rs_fresh(b[..],1);
  #assert rs_ritual_begin(b[..],1,SP_FIND_FAMILIAR);
  b[0].clock=4200; rs_fresh(b[..],1); rs_rite_turn(b[..],1);
  #assert rs_familiar_finish(b[..],1,MON_CAT,RS_FAMILIAR_FEY,3,3);
  #assert b[0].n==2 && storage[0].familiar_form==MON_CAT && storage[0].x==3 && storage[0].y==2;
}
