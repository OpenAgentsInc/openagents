// Native body-adapter observation, not qualification of its legacy damage rolls.
#load "../../../verse/experimental-hostiles.coax" as hostile;

hostile_permission_probe :: () -> bool {
  h: [1] hostile.Hostiles; hostile.hostile_start(h[..]);
  for i: 0..<hostile.HS_N { h[0].enemies[i].dead=true; }
  e := h[0].enemies[0..<1]; e[0].dead=false; e[0].inactive=true; e[0].x=4; e[0].z=0;
  hostile.hostile_tick(h[..],0,0,0,0.05);
  if !e[0].moving || e[0].x>=4 { return false; }
  e[0].x=0; e[0].z=-1; e[0].swing=0.34; e[0].stopped=true;
  hostile.hostile_tick(h[..],0,0,0,0.05);
  if e[0].swing>=0 || h[0].hits!=0 || h[0].hp!=44 { return false; }
  e[0].stopped=false;
  for k: 0..<100 { hostile.hostile_tick(h[..],0,0,0,0.05); }
  if h[0].hits!=0 || e[0].swing>=0 { return false; }
  e[0].inactive=false; e[0].held=true; e[0].cool=0;
  hostile.hostile_tick(h[..],0,0,0,0.05);
  return e[0].swing==0 && e[0].x==0 && e[0].z == -1;
}
#test "native hostile adapter witness separates pursuit and attack permission" { #assert hostile_permission_probe(); }
