// Pure parsing of Poppler -raw lines. Caller retains source and arena storage.
// All syntax failures are explicit; no partially parsed book is publishable.
#load "source-schema.coax";

SiLines :: struct { v: [20000] string; page: [20000] int; n: int; error: bool; }
SiArena :: struct { bytes: [2097152] u8; n: int; error: bool; }
SiBook :: struct { spell: [400] SrdSourceSpell; n: int; list: [2048] SrdClassSpell; lists: int; error: bool; diagnostic: string; }

#test "SRD extraction separates page headers even after a field and keeps source bytes" {
  l: [1] SiLines;
  src := "System Reference Document 5.2.1 107\nName\nDuration: 1 hour\nSystem Reference Document 5.2.1 108\nbody\n";
  raw: [200] u8; for i: 0..<src.count { raw[i] = src[i]; }
  raw[si_find(src, "\nSystem")] = 12;
  si_lines(cast(string) raw[0..<src.count], l[..]);
  #assert !l[0].error && l[0].n == 3 && l[0].v[1] == "Duration: 1 hour";
  #assert l[0].page[0] == 107 && l[0].page[2] == 108;
  #assert si_header("Level 2 Evocation (Wizard)") == 4 && si_header("Evocation Cantrip (Wizard)") == 4;
  #assert si_header("Level 2: Feature") == -1;
}
#test "SRD parser imports multiline fields, singular Component and higher level text" {
  l: [1] SiLines; a: [1] SiArena; b: [1] SiBook;
  si_lines("System Reference Document 5.2.1 107\nAid\nLevel 2 Abjuration (Bard, Cleric, Druid, Paladin,\nRanger)\nCasting Time: Action\nRange: 30 feet\nComponent: V, S, M (a strip of white cloth)\nDuration: 8 hours\nChoose up to three creatures.\nUsing a Higher-Level Spell Slot. Each gains more.\n", l[..]);
  si_spells(l[..], a[..], b[..]);
  #assert !b[0].error && b[0].n == 1;
  s := b[0].spell[0];
  #assert s.id == "aid" && s.level == 2 && s.school == 0 && s.classes == 31;
  #assert s.cast_kind == SRD_CAST_ACTION && s.range_kind == SRD_RANGE_FEET && s.range_value == 30;
  #assert s.verbal && s.somatic && s.material && s.material_text == "a strip of white cloth";
  #assert s.duration_seconds == 28800 && !s.concentration && s.page == 107;
  #assert s.text == "Choose up to three creatures.\nUsing a Higher-Level Spell Slot. Each gains more.";
  #assert s.higher_levels == "Using a Higher-Level Spell Slot. Each gains more.";
}
#test "SRD source helpers preserve punctuation, distinguish special metadata and bound output" {
  a: [1] SiArena;
  #assert si_slug("Heroes’ Feast", a[..]) == "heroes-feast";
  #assert si_slug("Antipathy/Sympathy", a[..]) == "antipathy-sympathy";
  #assert si_seconds("Concentration, up to 6 rounds") == 36;
  #assert si_seconds("1 minute or Ritual") == 60 && si_seconds("Special") == -1;
  #assert si_seconds("Action (Overgrowth) or 8 hours (Enrichment)") == -1;
  #assert si_mask("Bard, Wizard") == 129 && si_mask("Artificer") == -1;
  #assert si_has("a diamond worth 50+ GP, which the spell consumes", "consum");
  s: [1] SrdSourceSpell; s[0].components = "V, S, M (one 150+ GP black onyx stone for each corpse)";
  si_metadata(s[..]); #assert s[0].cost_text == "one 150+ GP black onyx stone for each corpse";
  a[0].n = a[0].bytes.count; #assert si_store("x", a[..]) == "" && a[0].error;
  #assert si_number("9999999999999999999999999") == -1;
}
#test "truncated spell metadata and unknown classes produce no publishable candidates" {
  l: [1] SiLines; a: [1] SiArena; b: [1] SiBook;
  si_lines("System Reference Document 5.2.1 107\nBroken\nLevel 1 Evocation (Wizard)\nCasting Time: Action\nRange: 30 feet\n", l[..]);
  si_spells(l[..], a[..], b[..]); #assert b[0].error && b[0].n == 0;
  l[0].n = 0; b[0].error = false;
  si_lines("System Reference Document 5.2.1 107\nUnknown\nLevel 1 Evocation (Artificer)\nCasting Time: Action\nRange: 30 feet\nComponents: V\nDuration: Instantaneous\nEffect.\n", l[..]);
  si_spells(l[..], a[..], b[..]); #assert b[0].error && b[0].n == 0;
  l[0].n = 0; l[0].error = false;
  si_lines("body without source page", l[..]); #assert l[0].error;
}

si_starts :: (s: string, p: string) -> bool { return s.count >= p.count && s[0..<p.count] == p; }
si_find :: (s: string, p: string) -> int {
  if p.count > s.count { return -1; }
  for i: 0..<s.count - p.count + 1 { if s[i..<i + p.count] == p { return i; } }
  return -1;
}
si_has :: (s: string, p: string) -> bool { return si_find(s, p) >= 0; }
si_trim :: (s: string) -> string {
  a := 0; z := s.count;
  while a < z && (s[a] == 32 || s[a] == 9 || s[a] == 13) { a += 1; }
  while z > a && (s[z - 1] == 32 || s[z - 1] == 9 || s[z - 1] == 13) { z -= 1; }
  return s[a..<z];
}
si_number :: (s: string) -> int {
  n := 0;
  if s.count == 0 || s.count > 9 { return -1; }
  for c: s { if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) c - 48; }
  return n;
}
si_lines :: (src: string, l: [] SiLines) {
  page := 0; at := 0;
  for i: 0..<src.count + 1 {
    if i < src.count && src[i] != 10 && src[i] != 12 { continue; }
    s := si_trim(src[at..<i]); at = i + 1;
    if si_starts(s, "System Reference Document 5.2.1 ") { page = si_number(s[32..<s.count]); continue; }
    if s.count == 0 { continue; }
    if l[0].n >= l[0].v.count || page < 1 { l[0].error = true; return; }
    k := l[0].n; l[0].v[k] = s; l[0].page[k] = page; l[0].n += 1;
  }
}
si_store :: (s: string, a: [] SiArena) -> string {
  start := a[0].n;
  if s.count > a[0].bytes.count - start { a[0].error = true; return ""; }
  for c: s { a[0].bytes[a[0].n] = c; a[0].n += 1; }
  return cast(string) a[0].bytes[start..<a[0].n];
}
si_join :: (l: [] SiLines, lo: int, hi: int, a: [] SiArena, sep: string) -> string {
  start := a[0].n;
  for i: lo..<hi { if i > lo { _ := si_store(sep, a); } _ := si_store(l[0].v[i], a); }
  return cast(string) a[0].bytes[start..<a[0].n];
}
si_slug :: (name: string, a: [] SiArena) -> string {
  start := a[0].n; dash := false; i := 0;
  while i < name.count {
    c := name[i]; i += 1;
    if c == 39 { continue; }
    if c == 226 && i + 1 < name.count && name[i] == 128 && name[i + 1] == 153 { i += 2; continue; }
    if c >= 'A' && c <= 'Z' { c += 32; }
    if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
      if dash && a[0].n > start { _ := si_store("-", a); } dash = false;
      one := [1] u8.[c]; _ := si_store(cast(string) one[..], a);
    } else { dash = true; }
  }
  return cast(string) a[0].bytes[start..<a[0].n];
}
si_header :: (s: string) -> int {
  for j: 0..<8 {
    if si_starts(s, SRD_SCHOOLS[j]) && si_has(s, " Cantrip (") { return j; }
    if s.count > 8 && si_starts(s, "Level ") && s[6] >= '1' && s[6] <= '9' && s[7] == 32 && si_starts(s[8..<s.count], SRD_SCHOOLS[j]) { return j; }
  }
  return -1;
}
si_mask :: (classes: string) -> int {
  mask := 0; at := 0;
  for i: 0..<classes.count + 1 {
    if i < classes.count && classes[i] != ',' { continue; }
    item := si_trim(classes[at..<i]); at = i + 1; found := false;
    for j: 0..<8 { if item == SRD_CLASSES[j] { mask = mask | (1 << j); found = true; } }
    if !found { return -1; }
  }
  return mask;
}
si_seconds :: (s: string) -> int {
  // Only unambiguous single intervals; alternative casting modes stay special.
  if si_has(s, "(") { return -1; }
  for i: 0..<s.count {
    if s[i] < '0' || s[i] > '9' { continue; }
    z := i; while z < s.count && s[z] >= '0' && s[z] <= '9' { z += 1; }
    n := si_number(s[i..<z]); tail := si_trim(s[z..<s.count]);
    if si_starts(tail, "round") { return n * 6; }
    if si_starts(tail, "minute") { return n * 60; }
    if si_starts(tail, "hour") { return n * 3600; }
    if si_starts(tail, "day") { return n * 86400; }
    return -1;
  }
  return -1;
}
si_metadata :: (s: [] SrdSourceSpell) {
  c := s[0].cast_text;
  s[0].ritual = si_has(c, "Ritual"); s[0].cast_seconds = si_seconds(c);
  s[0].cast_kind = SRD_CAST_SPECIAL;
  if c == "Action" || c == "Action or Ritual" { s[0].cast_kind = SRD_CAST_ACTION; }
  else if c == "Bonus Action" { s[0].cast_kind = SRD_CAST_BONUS; }
  else if si_starts(c, "Reaction") { s[0].cast_kind = SRD_CAST_REACTION; }
  else if s[0].cast_seconds >= 0 { s[0].cast_kind = SRD_CAST_TIMED; }
  r := s[0].range_text; s[0].range_kind = SRD_RANGE_SPECIAL; s[0].range_value = -1;
  if r == "Self" { s[0].range_kind = SRD_RANGE_SELF; }
  else if r == "Touch" { s[0].range_kind = SRD_RANGE_TOUCH; }
  else if r == "Sight" { s[0].range_kind = SRD_RANGE_SIGHT; }
  else if r == "Unlimited" { s[0].range_kind = SRD_RANGE_UNLIMITED; }
  else {
    p := si_find(r, " ");
    if p > 0 { s[0].range_value = si_number(r[0..<p]); if si_has(r, "feet") { s[0].range_kind = SRD_RANGE_FEET; } else if si_has(r, "mile") { s[0].range_kind = SRD_RANGE_MILES; } }
  }
  comp := s[0].components; p := si_find(comp, "(");
  tags := ifx p < 0 then comp else comp[0..<p];
  s[0].verbal = si_has(tags, "V"); s[0].somatic = si_has(tags, "S"); s[0].material = si_has(tags, "M");
  if p >= 0 && comp[comp.count - 1] == ')' { s[0].material_text = comp[p + 1..<comp.count - 1]; }
  if si_has(s[0].material_text, "worth") || si_has(s[0].material_text, " GP") { s[0].cost_text = s[0].material_text; }
  s[0].consumed = si_has(s[0].material_text, "consum");
  d := s[0].duration_text;
  s[0].concentration = si_has(d, "Concentration"); s[0].duration_seconds = si_seconds(d);
  s[0].duration_kind = SRD_DURATION_SPECIAL;
  if d == "Instantaneous" { s[0].duration_kind = SRD_DURATION_INSTANT; s[0].duration_seconds = 0; }
  else if si_starts(d, "Until dispelled") { s[0].duration_kind = SRD_DURATION_UNTIL; }
  else if s[0].duration_seconds >= 0 { s[0].duration_kind = SRD_DURATION_TIMED; }
}
si_spells :: (l: [] SiLines, a: [] SiArena, b: [] SiBook) {
  for h: 1..<l[0].n {
    school := si_header(l[0].v[h]); if school < 0 { continue; }
    end := l[0].n;
    for j: h + 1..<l[0].n { if si_header(l[0].v[j]) >= 0 { end = j - 1; break; } }
    time := -1; range := -1; comp := -1; dur := -1;
    for j: h + 1..<end {
      s := l[0].v[j];
      if si_starts(s, "Casting Time:") { time = j; }
      if si_starts(s, "Range:") { range = j; }
      if si_starts(s, "Components:") || si_starts(s, "Component:") { comp = j; }
      if si_starts(s, "Duration:") { dur = j; }
    }
    if time <= h || range <= time || comp <= range || dur <= comp || dur + 1 >= end || b[0].n >= 400 { b[0].error = true; return; }
    s: [1] SrdSourceSpell; s[0].name = l[0].v[h - 1]; s[0].id = si_slug(s[0].name, a);
    header := si_join(l, h, time, a, " "); par := si_find(header, "(");
    if par < 0 || header[header.count - 1] != ')' { b[0].error = true; return; }
    s[0].classes = si_mask(header[par + 1..<header.count - 1]); s[0].school = school;
    s[0].level = ifx si_starts(header, "Level ") then cast(int) header[6] - 48 else 0;
    s[0].page = l[0].page[h - 1]; s[0].end_page = l[0].page[end - 1];
    field := si_join(l, time, range, a, " "); s[0].cast_text = si_trim(field[13..<field.count]);
    field = si_join(l, range, comp, a, " "); s[0].range_text = si_trim(field[6..<field.count]);
    field = si_join(l, comp, dur, a, " "); colon := si_find(field, ":"); s[0].components = si_trim(field[colon + 1..<field.count]);
    s[0].duration_text = si_trim(l[0].v[dur][9..<l[0].v[dur].count]);
    s[0].text = si_join(l, dur + 1, end, a, "\n");
    higher := si_find(s[0].text, "Using a Higher-Level Spell Slot.");
    if higher >= 0 { s[0].higher_levels = s[0].text[higher..<s[0].text.count]; }
    si_metadata(s[..]);
    if s[0].classes < 0 { b[0].error = true; return; }
    b[0].spell[b[0].n] = s[0]; b[0].n += 1;
  }
  if l[0].error || a[0].error { b[0].error = true; }
}
