// The physical action world's declared base tuning represents Speed 30.
// Keep source Speed changes and per-foot walking costs proportional to it.
#authority;
rs_locomotion_scale :: (b:[]RsBattle,i:int)->f32 #effects(all) {
  if i<0 || i>=b[0].n { return 0; }
  if !rs_can_move(b[0].c[i]) { return 0; }
  cost:=rs_step_feet(rs_has(b[0].c[i],RS_PRONE),rs_difficult(b,b[0].c[i].x,b[0].c[i].y));
  return f32(rs_walk_speed(b,i))/30/(f32(cost)/5);
}
#test "locomotion scaling does not turn incapacitated action permission into movement permission" {
  b:[1]RsBattle; b[0].w=8; b[0].h=8; _:=rs_add(b[..],rs_guard("Walker",0),2,2);
  #assert rs_locomotion_scale(b[..],0)==1;
  b[0].c[0].hp=0; #assert rs_locomotion_scale(b[..],0)==0;
}
