#load "long-rest-resources-checks.coax";
#load "../../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for klass:0..<RS_CLASSES { if klass==RS_MONSTER { continue; } for level:1..<7 {
    c:[1]RsCreature; c[0]=rt_class(klass,level);
    b:[1]RsBattle; b[0].c=c[..]; b[0].n=1; b[0].who = -1;
    maximum:=c[0].hp_max; scores:=c[0].score;
    if !rs_rest_reduce_max(c[..],2).admitted { return 1; }
    for ability:0..<6 { if rs_rest_reduce_score(c[..],ability,1).lost!=1 { return 2; } c[0].score[ability]+=1; }
    c[0].hp_max+=2; c[0].hp=1; c[0].temp=9; c[0].exhaustion=2; c[0].exhaustion_food=1;
    c[0].cond=RS_EXHAUSTION|RS_BLINDED; c[0].reacted=true; c[0].slots[1]=0;
    if !rs_sleep_begin(b[..],0) { return 9; }
    journal:[1]RsLongRest;
    if !rs_long_rest_begin(journal[..],1,0,1) || !rs_long_rest_advance(journal[..],40000).ready { return 10; }
    c[0].long_rest=journal[0];
    if !rs_long_rest_apply(b[..],0) { return 3; }
    if !c[0].long_rest.completed || c[0].long_rest.finished!=28800 || rs_sleeping(c[0]) || rs_long_rest_apply(b[..],0) { return 11; }
    if c[0].hp_max!=maximum+2 || c[0].hp!=maximum+2 || c[0].hp_max_lost!=0 || c[0].temp!=0 { return 4; }
    for ability:0..<6 { if c[0].score[ability]!=scores[ability]+1 || c[0].score_lost[ability]!=0 { return 5; } }
    if c[0].exhaustion!=1 || c[0].exhaustion_food!=1 || c[0].cond!=(RS_EXHAUSTION|RS_BLINDED|RS_PRONE) || !c[0].reacted { return 6; }
    if c[0].rest.dice!=level || c[0].slots[1]!=c[0].slots_max[1] { return 7; }
    // A malformed late field must refuse before HP, counters or banks change.
    c[0].hp=1; c[0].temp=7; c[0].slots[1]=0; c[0].score_lost[5] = -1;
    c[0].long_rest.phase=3;
    if rs_long_rest_apply(b[..],0) || c[0].hp!=1 || c[0].temp!=7 || c[0].slots[1]!=0 { return 8; }
  } }
  tool_errln("PASS LONG-REST-BENEFITS (72 class/level scenarios)"); return 0;
}
