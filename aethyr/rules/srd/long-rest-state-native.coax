#load "long-rest-state.coax";
#load "../../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  // Different sleep/watch orderings and coarse poll intervals must all retain
  // the same source completion second, including an interruption and a pause.
  for watch:[4]int.[0,1,3600,7200] {
    for lateness:[4]int.[0,1,100000,9223372036854675807] {
      s:[1]RsLongRest;
      if !rs_long_rest_begin(s[..],1,100,1) { return 1; }
      if !rs_long_rest_advance(s[..],3700).accepted { return 2; }
      if !rs_long_rest_interrupt(s[..]).short_rest { return 3; }
      if !rs_long_rest_resume(s[..],7300,1) { return 4; }
      if watch>0 {
        if !rs_long_rest_mode(s[..],2) { return 5; }
        if !rs_long_rest_advance(s[..],7300+watch).accepted { return 6; }
        if !rs_long_rest_mode(s[..],1) { return 7; }
      }
      if !rs_long_rest_advance(s[..],36100+lateness).ready { return 8; }
      if s[0].stamp!=36100 || s[0].elapsed!=32400 || s[0].light!=watch || s[0].sleep!=32400-watch { return 9; }
      if !rs_long_rest_commit(s[..]) || s[0].finished!=36100 { return 10; }
      if rs_long_rest_begin(s[..],1,93699,1) || !rs_long_rest_begin(s[..],1,93700,1) { return 11; }
    }
  }
  tool_errln("PASS LONG-REST-STATE (16 activity/poll schedules)"); return 0;
}
