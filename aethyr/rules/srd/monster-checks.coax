// The used monsters' blocks resolve as the SRD 5.2.1 says (#13034): each record's numbers, its
// attacks through the shared strike path, Multiattack, ranged and reach modes, riders, Pack
// Tactics, Magic Resistance and Nimble Escape. Fixed dice land on half their faces (a d20 on 10).
//   coax/bin/coax test aethyr/rules/srd/monster-checks.coax --library
#load "stat-opportunity-checks.coax";

// Block m at square (1, 1) of team 0 against a 100-HP, AC 12 target of team 1 `gap` squares east;
// block m's turn is running and no die has been counted.
mc_field :: (b: [] RsBattle, m: int, gap: int) -> int {
  b[0].w=80; b[0].h=8; b[0].dice[0].fixed=true;
  _ := rs_add(b,rs_monster(m,"",0),1,1);
  j := rs_add(b,rs_fighter("Target",1,1),1+gap,1);
  b[0].c[j].hp=100; b[0].c[j].hp_max=100; b[0].c[j].ac=12;
  rs_start_turn(b,0); b[0].dice[0].rolled=0;
  return j;
}
mc_event :: (b: [] RsBattle, since: int, text: string) -> RsEvent {
  for k: 0..<b[0].book[0].seq-since {
    e := rs_recent(b[0].book[0],k);
    if cast(string)e.text[0..<e.text_n]==text { return e; }
  }
  return RsEvent.{kind = -1};
}
mc_has_text :: (b: [] RsBattle, since: int, text: string) -> bool {
  for k: 0..<b[0].book[0].seq-since {
    e := rs_recent(b[0].book[0],k);
    if cast(string)e.text[0..<e.text_n]==text { return true; }
  }
  return false;
}

#test "the used blocks hold the SRD's numbers" {
  im := rs_monster(MON_IMP,"",0);
  #assert cast(string)im.name[0..<im.name_n]=="Imp" && im.ac==13 && im.hp_max==21 && im.speed==20 && rs_size(im)==RS_TINY && rs_proficiency(im.level)==2;
  #assert im.score[RS_DEX]==17 && im.score[RS_CHA]==14 && rs_trait(im,RS_TRAIT_MAGIC) && im.resist==1<<RS_COLD && im.immune==(1<<RS_FIRE)|(1<<RS_POISON) && im.immune_cond==RS_POISONED && im.fiend;
  qu := rs_monster(MON_QUASIT,"Imp Fiend",0);
  #assert cast(string)qu.name[0..<qu.name_n]=="Imp Fiend" && qu.ac==13 && qu.hp_max==25 && qu.speed==40 && rs_trait(qu,RS_TRAIT_MAGIC) && qu.immune_cond==RS_POISONED;
  #assert qu.resist==(1<<RS_COLD)|(1<<RS_FIRE)|(1<<RS_LIGHTNING) && qu.immune==1<<RS_POISON && qu.fiend;
  go := rs_monster(MON_GOBLIN_WARRIOR,"",0);
  #assert go.ac==15 && go.hp_max==10 && rs_size(go)==RS_SMALL && rs_trait(go,RS_TRAIT_NIMBLE) && !go.fiend && !go.humanoid && go.score[RS_DEX]==15;
  og := rs_monster(MON_OGRE,"",0);
  #assert og.ac==11 && og.hp_max==68 && og.speed==40 && rs_size(og)==RS_LARGE && og.score[RS_STR]==19;
  hg := rs_monster(MON_HILL_GIANT,"",0);
  #assert hg.ac==13 && hg.hp_max==105 && rs_size(hg)==RS_HUGE && rs_proficiency(hg.level)==3 && rs_save_bonus(hg,RS_CON)==4 && rs_save_bonus(hg,RS_DEX)== -1;
  wo := rs_monster(MON_WOLF,"",0);
  #assert wo.ac==12 && wo.hp_max==11 && wo.speed==40 && rs_trait(wo,RS_TRAIT_PACK) && !rs_trait(wo,RS_TRAIT_MAGIC) && rs_size(wo)==RS_MEDIUM && wo.klass==RS_MONSTER;
  zo := rs_monster(MON_ZOMBIE,"",0); old := rs_zombie("Zombie",0);
  #assert zo.ac==old.ac && zo.hp_max==old.hp_max && zo.speed==old.speed && zo.score[RS_STR]==old.score[RS_STR] && zo.score[RS_CON]==old.score[RS_CON] && zo.score[RS_WIS]==old.score[RS_WIS] && rs_save_bonus(zo,RS_WIS)==rs_save_bonus(old,RS_WIS);
  #assert zo.undead && zo.fortitude && zo.immune==old.immune && zo.immune_cond==old.immune_cond && rs_save_bonus(zo,RS_WIS)==0;
  // the attacks' printed numbers
  s := rs_monster_action(MON_IMP).attacks[0];
  #assert s.bonus==5 && s.dice==1 && s.sides==6 && s.flat==3 && s.kind==RS_PIERCING && s.plus_dice==2 && s.plus_sides==6 && s.plus_kind==RS_POISON && s.reach==5;
  h := rs_monster_action(MON_HILL_GIANT);
  #assert h.count==2 && h.n==2 && h.attacks[0].bonus==8 && h.attacks[0].dice==3 && h.attacks[0].sides==8 && h.attacks[0].flat==5 && h.attacks[0].reach==10;
  #assert h.attacks[1].range_ft==60 && h.attacks[1].long_ft==240 && h.attacks[1].dice==2 && h.attacks[1].sides==10 && h.attacks[1].ride==RS_RIDE_POISON_TO_END;
  g := rs_monster_action(MON_GOBLIN_WARRIOR);
  #assert g.count==1 && g.attacks[0].adv_dice==1 && g.attacks[0].adv_sides==4 && g.attacks[1].range_ft==80 && g.attacks[1].long_ft==320 && g.attacks[1].reach==0;
  for m: 1..<MON_N {
    k := rs_monster_block(m);
    #assert k.id.count>8 && k.page>=254 && k.page<=364 && rs_stat_action_valid(k.action) && k.pb>=2;
    for o: 1..<m { #assert rs_monster_block(o).id!=k.id; }
  }
  #assert rs_monster_block(MON_NONE).id.count==0 && rs_monster_block(MON_N).id.count==0;
}

#test "the used-monster manifest names only blocks the engine builds" {
  for u: RS_USED_MONSTERS { #assert rs_used_monster_built(u.id) && u.world.count>0 && u.role.count>0; }
  #assert !rs_used_monster_built("monster/mage") && !rs_used_monster_built("");
  // the npcs.coax blocks the manifest names are the SRD's (npcs.coax checks their numbers)
  #assert rs_cultist("C",1).ac==12 && rs_fanatic("F",1).hp_max==44 && rs_guard("G",1).ac==16;
}

#test "the Imp's Sting adds its Poison, which a poison-immune target ignores" {
  b: [1] RsBattle; j := mc_field(b[..],MON_IMP,1);
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_IMP));
  #assert b[0].c[j].hp==88 && b[0].dice[0].rolled==4 && b[0].turn.action;   // 6 Piercing and 6 Poison
  #assert !rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_IMP)) && b[0].c[j].hp==88;
  c: [1] RsBattle; k := mc_field(c[..],MON_IMP,1); c[0].c[k].immune=1<<RS_POISON;
  #assert rs_stat_multiattack(c[..],0,k,rs_monster_action(MON_IMP)) && c[0].c[k].hp==94;
}

#test "Magic Resistance gives Advantage on saves against spells, not against other effects" {
  b: [1] RsBattle; j := mc_field(b[..],MON_IMP,1);
  r := b[0].dice[0].rolled; _ := rs_saving_throw_magic(b[..],0,RS_DEX,30,0); #assert b[0].dice[0].rolled==r+2;
  r = b[0].dice[0].rolled; _ = rs_saving_throw(b[..],0,RS_DEX,30); #assert b[0].dice[0].rolled==r+1;
  r = b[0].dice[0].rolled; _ = rs_saving_throw_magic(b[..],0,RS_DEX,30,1); #assert b[0].dice[0].rolled==r+1;   // and Disadvantage cancels it
  r = b[0].dice[0].rolled; _ = rs_saving_throw_magic(b[..],j,RS_DEX,30,0); #assert b[0].dice[0].rolled==r+1;   // the fighter has none
  // a spell's save: Sacred Flame at the Imp rolls one die more than at the same Imp without the trait
  rolls: [2] int;
  for mode: 0..<2 {
    c: [1] RsBattle; c[0].w=10; c[0].h=8; c[0].dice[0].fixed=true;
    t := rs_add(c[..],rs_monster(MON_IMP,"",1),3,1); if mode==1 { c[0].c[t].form=RS_TINY; }
    p := rs_add(c[..],rs_cleric("Priest",0,1),1,1);
    rs_start_turn(c[..],p); c[0].dice[0].rolled=0;
    #assert rs_cast(c[..],p,SP_SACRED_FLAME,0,3,1,t);
    rolls[mode]=c[0].dice[0].rolled;
  }
  #assert rolls[0]==rolls[1]+1;
}

#test "the Quasit's Rend poisons until the start of its next turn, and refuses with no room for it" {
  b: [1] RsBattle; j := mc_field(b[..],MON_QUASIT,1);
  until := rs_before_next_turn(b[..],0); seq := b[0].book[0].seq;
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_QUASIT));
  #assert b[0].c[j].hp==95 && rs_has(b[0].c[j],RS_POISONED) && mc_has_text(b[..],seq,"  Target is Poisoned");
  found := false;
  for e: b[0].c[j].eff { if e.kind==EF_COND && e.cond==RS_POISONED { #assert e.until==until && e.by==0; found=true; } }
  #assert found;
  // immune: no record and no line
  c: [1] RsBattle; k := mc_field(c[..],MON_QUASIT,1); c[0].c[k].immune_cond=RS_POISONED; seq=c[0].book[0].seq;
  #assert rs_stat_multiattack(c[..],0,k,rs_monster_action(MON_QUASIT)) && !rs_has(c[0].c[k],RS_POISONED) && !mc_has_text(c[..],seq,"  Target is Poisoned");
  // full effect storage: refused before the Action or a die
  d: [1] RsBattle; t := mc_field(d[..],MON_QUASIT,1);
  for q: 0..<RS_EFFECTS { d[0].c[t].eff[q]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=q+10,spell=-1,until=100,save=-1}; }
  #assert !rs_stat_multiattack(d[..],0,t,rs_monster_action(MON_QUASIT)) && !d[0].turn.action && d[0].dice[0].rolled==0;
  #assert !rs_stat_attack(d[..],0,t,rs_monster_action(MON_QUASIT).attacks[0]) && !d[0].turn.action;
  d[0].c[t].immune_cond=RS_POISONED;   // immune, it needs no room
  #assert rs_stat_attack(d[..],0,t,rs_monster_action(MON_QUASIT).attacks[0]);
}

#test "the Goblin Warrior's extra die needs Advantage; its Shortbow shoots to long range" {
  b: [1] RsBattle; j := mc_field(b[..],MON_GOBLIN_WARRIOR,1);
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_GOBLIN_WARRIOR)) && b[0].c[j].hp==95 && b[0].dice[0].rolled==2;
  c: [1] RsBattle; k := mc_field(c[..],MON_GOBLIN_WARRIOR,1); c[0].c[k].cond=RS_PRONE; seq := c[0].book[0].seq;
  #assert rs_stat_multiattack(c[..],0,k,rs_monster_action(MON_GOBLIN_WARRIOR)) && c[0].c[k].hp==93 && c[0].dice[0].rolled==4;
  #assert mc_has_text(c[..],seq,"  Target takes 2 Slashing more (Advantage)");
  c[0].c[k].resist=1<<RS_SLASHING; rs_start_turn(c[..],0);
  #assert rs_stat_multiattack(c[..],0,k,rs_monster_action(MON_GOBLIN_WARRIOR)) && c[0].c[k].hp==90;   // 5/2 + 2/2
  // ranged: the bow at 30 feet, Disadvantage past 80, nothing past 320
  d: [1] RsBattle; t := mc_field(d[..],MON_GOBLIN_WARRIOR,6);
  #assert rs_stat_pick(d[..],0,t,rs_monster_action(MON_GOBLIN_WARRIOR))==1 && rs_stat_mode(d[..],0,t,rs_monster_action(MON_GOBLIN_WARRIOR).attacks[1])==2;
  #assert rs_stat_multiattack(d[..],0,t,rs_monster_action(MON_GOBLIN_WARRIOR)) && d[0].c[t].hp==95 && d[0].dice[0].rolled==2;
  e: [1] RsBattle; u := mc_field(e[..],MON_GOBLIN_WARRIOR,20);
  #assert rs_stat_multiattack(e[..],0,u,rs_monster_action(MON_GOBLIN_WARRIOR)) && e[0].dice[0].rolled>=3;
  f: [1] RsBattle; v := mc_field(f[..],MON_GOBLIN_WARRIOR,64);
  #assert rs_stat_mode(f[..],0,v,rs_monster_action(MON_GOBLIN_WARRIOR).attacks[1])==2;
  rs_place(f[..],v,66,1);
  #assert rs_stat_pick(f[..],0,v,rs_monster_action(MON_GOBLIN_WARRIOR))== -1 && !rs_stat_multiattack(f[..],0,v,rs_monster_action(MON_GOBLIN_WARRIOR)) && !f[0].turn.action;
  // Nimble Escape: Disengage as a Bonus Action, its alone
  #assert rs_disengage_use(f[..],0,RS_DISENGAGE_NIMBLE) && f[0].turn.bonus && f[0].turn.disengaged && !f[0].turn.action;
  #assert !rs_disengage_use(f[..],0,RS_DISENGAGE_NIMBLE);
  g: [1] RsBattle; w := mc_field(g[..],MON_OGRE,1);
  #assert !rs_disengage_use(g[..],0,RS_DISENGAGE_NIMBLE) && !g[0].turn.bonus;
}

#test "the Ogre's space reaches a square further; past it the Javelin is thrown" {
  b: [1] RsBattle; j := mc_field(b[..],MON_OGRE,2);
  a := rs_monster_action(MON_OGRE);
  #assert rs_stat_pick(b[..],0,j,a)==0 && rs_stat_multiattack(b[..],0,j,a) && b[0].c[j].hp==88;   // 2d8 + 4
  c: [1] RsBattle; k := mc_field(c[..],MON_OGRE,3);
  #assert rs_stat_pick(c[..],0,k,a)==1 && rs_stat_multiattack(c[..],0,k,a) && c[0].c[k].hp==90;   // 2d6 + 4
  c[0].c[0].form=RS_MEDIUM; rs_place(c[..],k,3,1);
  #assert rs_stat_pick(c[..],0,k,a)==1 && rs_stat_mode(c[..],0,k,a.attacks[0])==0;
  rs_place(c[..],k,2,1); #assert rs_stat_mode(c[..],0,k,a.attacks[0])==1 && rs_stat_mode(c[..],0,k,a.attacks[1])==1;
}

#test "the Hill Giant attacks twice, Prone only on a Large or smaller target, and lobs trash that poisons" {
  b: [1] RsBattle; j := mc_field(b[..],MON_HILL_GIANT,3);
  a := rs_monster_action(MON_HILL_GIANT);
  #assert rs_stat_multiattack(b[..],0,j,a) && b[0].c[j].hp==66 && rs_has(b[0].c[j],RS_PRONE);
  #assert b[0].dice[0].rolled==9;   // the second roll at a Prone target 15 feet off has Disadvantage
  #assert !rs_stat_multiattack(b[..],0,j,a);
  c: [1] RsBattle; k := mc_field(c[..],MON_HILL_GIANT,1); c[0].c[k].form=RS_HUGE;
  #assert rs_stat_multiattack(c[..],0,k,a) && c[0].c[k].hp==66 && !rs_has(c[0].c[k],RS_PRONE);
  c[0].c[k].form=RS_LARGE; c[0].c[k].immune_cond=RS_PRONE; rs_start_turn(c[..],0);
  #assert rs_stat_multiattack(c[..],0,k,a) && !rs_has(c[0].c[k],RS_PRONE);
  // a target dropped by the first attack takes no second
  d: [1] RsBattle; t := mc_field(d[..],MON_HILL_GIANT,1); d[0].c[t].hp=10;
  #assert rs_stat_multiattack(d[..],0,t,a) && d[0].dice[0].rolled==4 && d[0].c[t].hp==0;
  // Trash Lob at 40 feet, twice, Poisoned until the end of the target's next turn
  e: [1] RsBattle; u := mc_field(e[..],MON_HILL_GIANT,8); until := rs_own_turn_end(e[..],u);
  #assert rs_stat_pick(e[..],0,u,a)==1 && rs_stat_multiattack(e[..],0,u,a) && e[0].c[u].hp==70 && rs_has(e[0].c[u],RS_POISONED);
  found := false;
  for f: e[0].c[u].eff { if f.kind==EF_COND && f.cond==RS_POISONED { #assert f.until==until; found=true; } }
  #assert found && !rs_has(e[0].c[u],RS_PRONE);
  // two lobs need two free records
  g: [1] RsBattle; v := mc_field(g[..],MON_HILL_GIANT,8);
  for q: 0..<RS_EFFECTS-1 { g[0].c[v].eff[q]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=q+10,spell=-1,until=100,save=-1}; }
  #assert !rs_stat_multiattack(g[..],0,v,a) && !g[0].turn.action && g[0].dice[0].rolled==0;
  rs_place(g[..],v,2,1);   // in Tree Club's reach the lob isn't picked, but the Action is one record still
  #assert !rs_stat_multiattack(g[..],0,v,a);
}

#test "a Hill Giant's Opportunity Attack swings its Tree Club with its rider" {
  b: [1] RsBattle; j := mc_field(b[..],MON_HILL_GIANT,2);
  rs_start_turn(b[..],j);
  m := rs_monster_action(MON_HILL_GIANT);
  #assert rs_stat_melee_pick(m)==0;
  r := rs_stat_opportunity(b[..],0,j,m.attacks[0],RsOpportunityMove.{measured=true,from_feet=10,to_feet=20,seen=true,movement=true});
  #assert r.admitted && r.hit && rs_has(b[0].c[j],RS_PRONE) && b[0].c[0].reacted && b[0].c[j].hp==83;
  c: [1] RsBattle; k := mc_field(c[..],MON_HILL_GIANT,2); rs_start_turn(c[..],k);
  // a ranged-only record never makes one; nor past the reach of the giant's space
  q := rs_stat_opportunity(c[..],0,k,m.attacks[1],RsOpportunityMove.{measured=true,from_feet=10,to_feet=20,seen=true,movement=true});
  #assert !q.admitted && !c[0].c[0].reacted;
  q = rs_stat_opportunity(c[..],0,k,m.attacks[0],RsOpportunityMove.{measured=true,from_feet=16,to_feet=20,seen=true,movement=true});
  #assert !q.admitted;
  q = rs_stat_opportunity(c[..],0,k,m.attacks[0],RsOpportunityMove.{measured=true,from_feet=15,to_feet=16,seen=true,movement=true});
  #assert q.admitted;
  // a Quasit's Rend as a Reaction needs room for its Poisoned
  d: [1] RsBattle; t := mc_field(d[..],MON_QUASIT,1); rs_start_turn(d[..],t);
  for e: 0..<RS_EFFECTS { d[0].c[t].eff[e]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=e+10,spell=-1,until=100,save=-1}; }
  q = rs_stat_opportunity(d[..],0,t,rs_monster_action(MON_QUASIT).attacks[0],RsOpportunityMove.{measured=true,from_feet=5,to_feet=10,seen=true,movement=true});
  #assert !q.admitted && !d[0].c[0].reacted;
  #assert !rs_stat_opportunity(d[..],-1,t,m.attacks[0],RsOpportunityMove.{measured=true,from_feet=5,to_feet=20,seen=true,movement=true}).admitted;
  #assert !rs_stat_opportunity(d[..],0,9,m.attacks[0],RsOpportunityMove.{measured=true,from_feet=5,to_feet=20,seen=true,movement=true}).admitted;
}

#test "Pack Tactics needs an able ally of the wolf within 5 feet of the target" {
  b: [1] RsBattle; j := mc_field(b[..],MON_WOLF,1);
  w2 := rs_add(b[..],rs_monster(MON_WOLF,"",0),3,1);
  #assert rs_pack_tactics(b[..],0,j) && !rs_pack_tactics(b[..],j,0) && rs_attack_edge(b[..],0,j,true,true)==1;
  b[0].c[w2].cond=RS_INCAPACITATED; #assert !rs_pack_tactics(b[..],0,j);
  b[0].c[w2].cond=0; b[0].c[w2].hp=0; #assert !rs_pack_tactics(b[..],0,j);
  b[0].c[w2].hp=11; rs_place(b[..],w2,4,1); #assert !rs_pack_tactics(b[..],0,j);
  rs_place(b[..],w2,3,2); #assert rs_pack_tactics(b[..],0,j);
  b[0].c[w2].team=1; #assert !rs_pack_tactics(b[..],0,j);
  b[0].c[w2].team=0; b[0].c[0].form=RS_MEDIUM; #assert !rs_pack_tactics(b[..],0,j);
  // an ally at index 0 counts; 10 feet off it doesn't
  e: [1] RsBattle; e[0].w=12; e[0].h=8; e[0].dice[0].fixed=true;
  a0 := rs_add(e[..],rs_monster(MON_WOLF,"",0),3,1); t0 := rs_add(e[..],rs_fighter("T",1,1),2,1); w0 := rs_add(e[..],rs_monster(MON_WOLF,"",0),1,1);
  #assert rs_pack_tactics(e[..],w0,t0); rs_place(e[..],a0,4,1); #assert !rs_pack_tactics(e[..],w0,t0);
  // the target is no ally of itself, and the wolf isn't its own
  c: [1] RsBattle; k := mc_field(c[..],MON_WOLF,1); c[0].c[k].team=0;
  #assert !rs_pack_tactics(c[..],0,k);
  // the Bite: Advantage with the pack, Prone on a Medium target, not on a Large one
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_WOLF)) && b[0].c[j].hp==95 && rs_has(b[0].c[j],RS_PRONE);
  d: [1] RsBattle; t := mc_field(d[..],MON_WOLF,1); d[0].c[t].form=RS_LARGE;
  #assert rs_stat_multiattack(d[..],0,t,rs_monster_action(MON_WOLF)) && d[0].dice[0].rolled==2 && !rs_has(d[0].c[t],RS_PRONE);
}

#test "stat attack and action records refuse malformed numbers" {
  ok := RsStatAttack.{id="x",name="X",bonus=1,dice=1,sides=6,kind=RS_PIERCING,ability=RS_STR,reach=5};
  #assert rs_stat_attack_valid(ok);
  for n: 0..<30 {
    a := ok;
    want := false;
    if n==0 { a.range_ft= -1; } if n==1 { a.range_ft=20; a.long_ft=10; } if n==2 { a.range_ft=20; a.long_ft=1001; }
    if n==3 { a.range_ft=20; a.long_ft=1000; want=true; } if n==4 { a.range_ft=5; a.long_ft=20; } if n==5 { a.range_ft=6; a.long_ft=6; want=true; }
    if n==6 { a.plus_dice=1; } if n==7 { a.plus_dice=1; a.plus_sides=4; } if n==8 { a.plus_dice=1; a.plus_sides=4; a.plus_kind=RS_DAMAGE.count; }
    if n==9 { a.plus_dice=1; a.plus_sides=4; a.plus_kind=RS_DAMAGE.count-1; want=true; } if n==10 { a.plus_dice= -1; }
    if n==11 { a.adv_dice=1; } if n==12 { a.adv_dice=1; a.adv_sides=4; want=true; } if n==13 { a.adv_dice=101; a.adv_sides=4; }
    if n==14 { a.ride= -1; } if n==15 { a.ride=RS_RIDE_POISON_TO_END+1; } if n==16 { a.ride=RS_RIDE_POISON_TO_END; want=true; }
    if n==17 { a.ride_size= -1; } if n==18 { a.ride_size=RS_GARGANTUAN; want=true; } if n==19 { a.ride_size=RS_GARGANTUAN+1; }
    if n==20 { a.plus_kind=RS_DAMAGE.count; want=true; } if n==21 { a.plus_dice=100; a.plus_sides=100; a.plus_kind=1; want=true; }
    if n==22 { a.plus_sides=101; } if n==23 { a.adv_sides= -1; } if n==24 { a.reach=0; want=true; } if n==25 { a.long_ft= -1; }
    if n==26 { a.plus_dice=1; a.plus_sides=4; a.plus_kind=0; } if n==27 { a.adv_dice=100; a.adv_sides=100; want=true; }
    if n==28 { a.range_ft=0; a.long_ft=0; a.ride=RS_RIDE_NONE; want=true; } if n==29 { a.adv_sides=101; }
    #assert rs_stat_attack_valid(a)==want;
  }
  m := RsStatAction.{n=1,count=1}; m.attacks[0]=ok;
  #assert rs_stat_action_valid(m);
  m.n=0; #assert !rs_stat_action_valid(m); m.n=RS_MULTI+1; #assert !rs_stat_action_valid(m);
  m.n=2; #assert !rs_stat_action_valid(m); m.attacks[1]=ok; #assert rs_stat_action_valid(m);
  m.n=RS_MULTI; m.attacks[2]=ok; #assert rs_stat_action_valid(m);
  m.count=0; #assert !rs_stat_action_valid(m); m.count=4; #assert rs_stat_action_valid(m); m.count=5; #assert !rs_stat_action_valid(m);
  // the reaction's pick: the first record with reach
  bow := ok; bow.reach=0; bow.range_ft=80; bow.long_ft=320;
  p := RsStatAction.{n=2,count=1}; p.attacks[0]=bow; p.attacks[1]=ok;
  #assert rs_stat_melee_pick(p)==1; p.n=1; #assert rs_stat_melee_pick(p)== -1;
  // a no-mode record is refused, as are malformed Actions and wrong turns
  b: [1] RsBattle; j := mc_field(b[..],MON_OGRE,1);
  none := ok; none.reach=0;
  #assert !rs_stat_attack(b[..],0,j,none) && !b[0].turn.action;
  q := rs_monster_action(MON_OGRE); q.count=0;
  #assert !rs_stat_multiattack(b[..],0,j,q) && !rs_stat_multiattack(b[..],0,0,rs_monster_action(MON_OGRE));
  #assert !rs_stat_multiattack(b[..],-1,j,rs_monster_action(MON_OGRE)) && !rs_stat_multiattack(b[..],0,5,rs_monster_action(MON_OGRE));
  #assert !rs_stat_multiattack(b[..],j,0,rs_monster_action(MON_OGRE)) && !rs_stat_multiattack(b[..],0,-1,rs_monster_action(MON_OGRE));
  b[0].c[j].dead=true; #assert !rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_OGRE)); b[0].c[j].dead=false;
  b[0].c[0].cond=RS_STUNNED; #assert !rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_OGRE)); b[0].c[0].cond=0;
  b[0].c[0].klass=RS_FIGHTER; #assert !rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_OGRE)); b[0].c[0].klass=RS_MONSTER;
  #assert b[0].dice[0].rolled==0 && !b[0].turn.action;
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_OGRE));
}

#test "an attacker dropped by a Reaction stops its Multiattack" {
  b: [1] RsBattle; j := mc_field(b[..],MON_HILL_GIANT,1);
  w := rs_warlock("Rebuker",1,3,SP_ELDRITCH_BLAST); w.rebuke=true; w.hp=100; w.hp_max=100; w.ac=12;
  b[0].c[j]=w; rs_place(b[..],j,2,1); b[0].c[0].hp=1;
  #assert rs_stat_multiattack(b[..],0,j,rs_monster_action(MON_HILL_GIANT));
  #assert b[0].c[j].hp==83 && !rs_up(b[0].c[0]);   // one Tree Club; Hellish Rebuke drops the giant before its second
}

#test "riders tell their conditions as events and keep exact effect records" {
  b: [1] RsBattle; j := mc_field(b[..],MON_QUASIT,1); seq := b[0].book[0].seq;
  #assert rs_stat_attack(b[..],0,j,rs_monster_action(MON_QUASIT).attacks[0]);
  e := mc_event(b[..],seq,"  Target is Poisoned");
  #assert e.kind==RS_EV_CONDITION && e.spell== -1 && e.by==0 && e.to==j && e.amount==RS_POISONED && e.damage==0;
  for f: b[0].c[j].eff { if f.kind==EF_COND { #assert f.cond==RS_POISONED && f.spell== -1 && f.save== -1 && f.dc==0; } }
  c: [1] RsBattle; k := mc_field(c[..],MON_WOLF,1); seq = c[0].book[0].seq;
  #assert rs_stat_attack(c[..],0,k,rs_monster_action(MON_WOLF).attacks[0]);
  p := mc_event(c[..],seq,"  Target is knocked Prone");
  #assert p.kind==RS_EV_CONDITION && p.spell== -1 && p.by==0 && p.to==k && p.amount==RS_PRONE && p.damage==0;
  // already Prone: no second line
  rs_start_turn(c[..],0); seq = c[0].book[0].seq;
  #assert rs_stat_attack(c[..],0,k,rs_monster_action(MON_WOLF).attacks[0]) && mc_event(c[..],seq,"  Target is knocked Prone").kind== -1;
  // a dead target takes no rider; a poison-immune one but blind-able takes no Poisoned
  d: [1] RsBattle; t := mc_field(d[..],MON_QUASIT,1); d[0].c[t].immune_cond=RS_POISONED; seq = d[0].book[0].seq;
  #assert rs_stat_attack(d[..],0,t,rs_monster_action(MON_QUASIT).attacks[0]) && mc_event(d[..],seq,"  Target is Poisoned").kind== -1;
  rs_stat_ride(d[..],0,t,rs_monster_action(MON_WOLF).attacks[0]); #assert rs_has(d[0].c[t],RS_PRONE);
  d[0].c[t].cond=0; d[0].c[t].dead=true; rs_stat_ride(d[..],0,t,rs_monster_action(MON_WOLF).attacks[0]); #assert !rs_has(d[0].c[t],RS_PRONE);
  d[0].c[t].dead=false; d[0].c[t].immune_cond=0;
  rs_stat_ride(d[..],0,t,rs_monster_action(MON_OGRE).attacks[0]); #assert !rs_has(d[0].c[t],RS_PRONE) && !rs_has(d[0].c[t],RS_POISONED);
}

#test "Multiattack's admission bounds, exact rider room and per-attack follow-ups" {
  // a target at index 0 and the attacker after it; index n is no one
  b: [1] RsBattle; b[0].w=12; b[0].h=8; b[0].dice[0].fixed=true;
  j := rs_add(b[..],rs_fighter("Target",1,1),2,1); b[0].c[j].hp=100; b[0].c[j].hp_max=100; b[0].c[j].ac=12;
  i := rs_add(b[..],rs_monster(MON_OGRE,"",0),1,1); rs_start_turn(b[..],i); b[0].dice[0].rolled=0;
  #assert !rs_stat_multiattack(b[..],i,b[0].n,rs_monster_action(MON_OGRE)) && !rs_stat_multiattack(b[..],b[0].n,j,rs_monster_action(MON_OGRE));
  // no rider needs no room
  for q: 0..<RS_EFFECTS { b[0].c[j].eff[q]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=q+10,spell=-1,until=100,save=-1}; }
  #assert rs_stat_multiattack(b[..],i,j,rs_monster_action(MON_OGRE)) && b[0].c[j].hp==88;
  // two lobs in exactly two free records
  c: [1] RsBattle; k := mc_field(c[..],MON_HILL_GIANT,8);
  for q: 0..<RS_EFFECTS-2 { c[0].c[k].eff[q]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=q+10,spell=-1,until=100,save=-1}; }
  #assert rs_stat_multiattack(c[..],0,k,rs_monster_action(MON_HILL_GIANT)) && c[0].c[k].hp==70;
  // an unconscious (not dead) target still takes the first attack
  d: [1] RsBattle; t := mc_field(d[..],MON_OGRE,1); d[0].c[t].hp=0; d[0].c[t].cond=RS_UNCONSCIOUS;
  #assert rs_stat_multiattack(d[..],0,t,rs_monster_action(MON_OGRE)) && d[0].dice[0].rolled>0;
  // Remarkable Athlete's half Speed after a Critical Hit follows each attack
  e: [1] RsBattle; u := mc_field(e[..],MON_OGRE,1); e[0].c[u].cond=RS_PARALYZED; e[0].c[0].athlete=true; e[0].turn.move_left=0;
  #assert rs_stat_multiattack(e[..],0,u,rs_monster_action(MON_OGRE)) && e[0].turn.move_left==4;
  f: [1] RsBattle; v := mc_field(f[..],MON_OGRE,1); f[0].c[v].cond=RS_PARALYZED; f[0].c[0].athlete=true; f[0].turn.move_left=0;
  #assert rs_stat_attack(f[..],0,v,rs_monster_action(MON_OGRE).attacks[0]) && f[0].turn.move_left==4;
}

#test "an Opportunity Attack is melee, needs reach, exact room and a real reactor" {
  // the Ogre's Javelin as a Reaction is thrown as a melee attack (one die, \"attacks\")
  b: [1] RsBattle; j := mc_field(b[..],MON_OGRE,1); rs_start_turn(b[..],j); seq := b[0].book[0].seq; b[0].dice[0].rolled=0;
  jav := rs_monster_action(MON_OGRE).attacks[1];
  r := rs_stat_opportunity(b[..],0,j,jav,RsOpportunityMove.{measured=true,from_feet=5,to_feet=15,seen=true,movement=true});
  #assert r.admitted && b[0].dice[0].rolled==3 && mc_has_text(b[..],seq,"Ogre attacks Target with Javelin: 10 + 6 = 16 vs AC 12: hit");
  // a reach-0 record makes none, even from a Huge reactor's space
  c: [1] RsBattle; k := mc_field(c[..],MON_HILL_GIANT,1); rs_start_turn(c[..],k);
  lob := rs_monster_action(MON_HILL_GIANT).attacks[1];
  #assert !rs_stat_opportunity(c[..],0,k,lob,RsOpportunityMove.{measured=true,from_feet=5,to_feet=10,seen=true,movement=true}).admitted;
  #assert !rs_stat_opportunity(c[..],c[0].c.count,k,rs_monster_action(MON_HILL_GIANT).attacks[0],RsOpportunityMove.{measured=true,from_feet=5,to_feet=20,seen=true,movement=true}).admitted;
  // a one-foot reach record still counts
  one := rs_monster_action(MON_OGRE).attacks[0]; one.reach=1;
  d: [1] RsBattle; t := mc_field(d[..],MON_WOLF,1); rs_start_turn(d[..],t);
  #assert rs_stat_opportunity(d[..],0,t,one,RsOpportunityMove.{measured=true,from_feet=1,to_feet=3,seen=true,movement=true}).admitted;
  // exactly one free record for the Quasit's Poisoned
  e: [1] RsBattle; u := mc_field(e[..],MON_QUASIT,1); rs_start_turn(e[..],u);
  for q: 0..<RS_EFFECTS-1 { e[0].c[u].eff[q]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=q+10,spell=-1,until=100,save=-1}; }
  #assert rs_stat_opportunity(e[..],0,u,rs_monster_action(MON_QUASIT).attacks[0],RsOpportunityMove.{measured=true,from_feet=5,to_feet=10,seen=true,movement=true}).admitted;
}

#test "a stat attack's modes and riders read only their own reach, range and condition bits" {
  b: [1] RsBattle; j := mc_field(b[..],MON_OGRE,1);
  near := RsStatAttack.{id="x",name="X",bonus=5,dice=1,sides=4,flat=0,kind=RS_SLASHING,ability=RS_STR,reach=1};
  #assert rs_stat_mode(b[..],0,j,near)==1;   // a Large space and 1 foot of reach meet the next square
  none := near; none.reach=0;
  rs_place(b[..],j,1,1);                     // on the attacker's own square: 0 feet
  #assert rs_stat_mode(b[..],0,j,none)==0;
  thrown := none; thrown.long_ft=1; #assert rs_stat_mode(b[..],0,j,thrown)==2;
  // Blinded immunity or Blindness doesn't stop Poisoned or Prone, nor make room for Poisoned
  for pass: 0..<2 {
    c: [1] RsBattle; t := mc_field(c[..],MON_WOLF,1);
    if pass==0 { c[0].c[t].immune_cond=RS_BLINDED; } else { c[0].c[t].cond=RS_BLINDED; }
    #assert rs_stat_strike(c[..],0,t,rs_monster_action(MON_WOLF).attacks[0],1) && rs_has(c[0].c[t],RS_PRONE);
    q: [1] RsBattle; u := mc_field(q[..],MON_QUASIT,1);
    if pass==0 { q[0].c[u].immune_cond=RS_BLINDED; } else { q[0].c[u].cond=RS_BLINDED; }
    #assert rs_stat_rider_room(q[..],u,rs_monster_action(MON_QUASIT).attacks[0])==1;
    #assert rs_stat_strike(q[..],0,u,rs_monster_action(MON_QUASIT).attacks[0],1) && rs_has(q[0].c[u],RS_POISONED);
    q[0].c[u].immune_cond=RS_BLINDED; q[0].c[u].cond=0; for e: 0..<RS_EFFECTS { q[0].c[u].eff[e]=RsEffect.{kind=EF_COND,cond=RS_DEAFENED,by=e+10,spell=-1,until=100,save=-1}; }
    rs_start_turn(q[..],0);
    #assert !rs_stat_attack(q[..],0,u,rs_monster_action(MON_QUASIT).attacks[0]);
  }
}
