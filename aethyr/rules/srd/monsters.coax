// The SRD 5.2.1 stat blocks Everglade's worlds field (#13034), beyond the townsfolk and cultists of
// npcs.coax and the Skeleton and Zombie of engine.coax. Each record keeps its source ID
// (monster/<id>), its page in the pinned PDF and the block's numbers: size, AC, HP, Speed, scores,
// saves, resistances and immunities, CR's XP and Proficiency Bonus, its traits, and its Action's
// attacks as typed stat attacks (stat-attack.coax) with Multiattack's count (stat-multiattack.coax).
// rs_monster builds the creature; rs_monster_action is what it does with its Action.
//
// Who uses which (docs/dnd/srd-compliance-ledger.md, "Used monsters"): Experimental's village and
// dungeon (verse/experimental-hostiles.coax DG_KIND_*) field its Bestiary models under these
// blocks: the imp as the Imp, the gremlin (the Puglin) as the Goblin Warrior, the Puglin Brute as
// the Ogre, the Imp Fiend as the Quasit and the Puglin Warlord as the Hill Giant. Conjure Animals'
// wolves in Everglade 5E's room are Wolves, and Finger of Death's risen are Zombies.
//
// What these blocks have that the worlds don't use, and so the engine doesn't run: Speed other than
// walking (the Imp's Fly 40 ft.), Senses, Languages and skills, the Imp's and the Quasit's
// Invisibility and Shape-Shift, the Quasit's Scare and the Goblin's Hide (Nimble Escape's other
// choice). Recorded on #13034.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test aethyr/rules/srd/monster-checks.coax --library

MON_NONE :: 0; MON_IMP :: 1; MON_QUASIT :: 2; MON_GOBLIN_WARRIOR :: 3; MON_OGRE :: 4; MON_HILL_GIANT :: 5;
MON_WOLF :: 6; MON_ZOMBIE :: 7;
MON_N :: 8;
RsMonsterBlock :: struct {
  id: string; name: string; page: int; xp: int; pb: int;
  size: int; ac: int; hp: int; speed: int;
  score: [6] int; saves: int;               // save proficiencies, bits of 1 << RS_STR...
  resist: int; immune: int; immune_cond: int;
  undead: bool; pack: bool; magic: bool; nimble: bool; fortitude: bool;
  action: RsStatAction;
}
rs_mon_attack :: (id: string, name: string, bonus: int, dice: int, sides: int, flat: int, kind: int, ability: int, reach: int) -> RsStatAttack {
  return RsStatAttack.{id = id, name = name, bonus = bonus, dice = dice, sides = sides, flat = flat, kind = kind, ability = ability, reach = reach};
}
rs_monster_block :: (m: int) -> RsMonsterBlock {
  k: RsMonsterBlock; a: [RS_MULTI] RsStatAttack;
  if m == MON_IMP {
    // Imp (p. 300): Tiny Fiend (Devil), AC 13, HP 21 (6d4 + 6), Speed 20 ft., Fly 40 ft., Str 6 Dex
    // 17 Con 13 Int 11 Wis 12 Cha 14; Resistances Cold; Immunities Fire, Poison; Poisoned; CR 1 (XP
    // 200; PB +2). Magic Resistance. Sting: +5, reach 5 ft., 6 (1d6 + 3) Piercing plus 7 (2d6) Poison.
    k = RsMonsterBlock.{id = "monster/imp", name = "Imp", page = 300, xp = 200, pb = 2, size = RS_TINY, ac = 13, hp = 21, speed = 20,
                        score = [6] int.[6, 17, 13, 11, 12, 14], resist = 1 << RS_COLD, immune = (1 << RS_FIRE) | (1 << RS_POISON),
                        immune_cond = RS_POISONED, magic = true};
    a[0] = rs_mon_attack("monster/imp/sting", "Sting", 5, 1, 6, 3, RS_PIERCING, RS_DEX, 5);
    a[0].plus_dice = 2; a[0].plus_sides = 6; a[0].plus_kind = RS_POISON;
    k.action = RsStatAction.{attacks = a, n = 1, count = 1};
  } else if m == MON_QUASIT {
    // Quasit (p. 317): Tiny Fiend (Demon), AC 13, HP 25 (10d4), Speed 40 ft., Str 5 Dex 17 Con 10
    // Int 7 Wis 10 Cha 10; Resistances Cold, Fire, Lightning; Immunities Poison; Poisoned; CR 1 (XP
    // 200; PB +2). Magic Resistance. Rend: +5, reach 5 ft., 5 (1d4 + 3) Slashing, and the target has
    // the Poisoned condition until the start of the quasit's next turn.
    k = RsMonsterBlock.{id = "monster/quasit", name = "Quasit", page = 317, xp = 200, pb = 2, size = RS_TINY, ac = 13, hp = 25, speed = 40,
                        score = [6] int.[5, 17, 10, 7, 10, 10], resist = (1 << RS_COLD) | (1 << RS_FIRE) | (1 << RS_LIGHTNING),
                        immune = 1 << RS_POISON, immune_cond = RS_POISONED, magic = true};
    a[0] = rs_mon_attack("monster/quasit/rend", "Rend", 5, 1, 4, 3, RS_SLASHING, RS_DEX, 5);
    a[0].ride = RS_RIDE_POISON_TO_START;
    k.action = RsStatAction.{attacks = a, n = 1, count = 1};
  } else if m == MON_GOBLIN_WARRIOR {
    // Goblin Warrior (p. 290): Small Fey (Goblinoid), AC 15, HP 10 (3d6), Speed 30 ft., Str 8 Dex 15
    // Con 10 Int 10 Wis 8 Cha 8; CR 1/4 (XP 50; PB +2). Scimitar: +4, reach 5 ft., 5 (1d6 + 2)
    // Slashing, plus 2 (1d4) Slashing if the attack roll had Advantage. Shortbow: +4, range 80/320
    // ft., 5 (1d6 + 2) Piercing, plus 2 (1d4) Piercing if the attack roll had Advantage. Nimble
    // Escape: a Bonus Action Disengage or Hide.
    k = RsMonsterBlock.{id = "monster/goblin-warrior", name = "Goblin Warrior", page = 290, xp = 50, pb = 2, size = RS_SMALL, ac = 15, hp = 10, speed = 30,
                        score = [6] int.[8, 15, 10, 10, 8, 8], nimble = true};
    a[0] = rs_mon_attack("monster/goblin-warrior/scimitar", "Scimitar", 4, 1, 6, 2, RS_SLASHING, RS_DEX, 5);
    a[0].adv_dice = 1; a[0].adv_sides = 4;
    a[1] = rs_mon_attack("monster/goblin-warrior/shortbow", "Shortbow", 4, 1, 6, 2, RS_PIERCING, RS_DEX, 0);
    a[1].range_ft = 80; a[1].long_ft = 320; a[1].adv_dice = 1; a[1].adv_sides = 4;
    k.action = RsStatAction.{attacks = a, n = 2, count = 1};
  } else if m == MON_OGRE {
    // Ogre (p. 312): Large Giant, AC 11, HP 68 (8d10 + 24), Speed 40 ft., Str 19 Dex 8 Con 16 Int 5
    // Wis 7 Cha 7; CR 2 (XP 450; PB +2). Greatclub: +6, reach 5 ft., 13 (2d8 + 4) Bludgeoning.
    // Javelin: +6, reach 5 ft. or range 30/120 ft., 11 (2d6 + 4) Piercing.
    k = RsMonsterBlock.{id = "monster/ogre", name = "Ogre", page = 312, xp = 450, pb = 2, size = RS_LARGE, ac = 11, hp = 68, speed = 40,
                        score = [6] int.[19, 8, 16, 5, 7, 7]};
    a[0] = rs_mon_attack("monster/ogre/greatclub", "Greatclub", 6, 2, 8, 4, RS_BLUDGEONING, RS_STR, 5);
    a[1] = rs_mon_attack("monster/ogre/javelin", "Javelin", 6, 2, 6, 4, RS_PIERCING, RS_STR, 5);
    a[1].range_ft = 30; a[1].long_ft = 120;
    k.action = RsStatAction.{attacks = a, n = 2, count = 1};
  } else if m == MON_HILL_GIANT {
    // Hill Giant (p. 298): Huge Giant, AC 13, HP 105 (10d12 + 40), Speed 40 ft., Str 21 Dex 8 Con 19
    // Int 5 Wis 9 Cha 6; CR 5 (XP 1,800; PB +3). Multiattack: two attacks, Tree Club or Trash Lob in
    // any combination. Tree Club: +8, reach 10 ft., 18 (3d8 + 5) Bludgeoning; a Large or smaller
    // target has the Prone condition. Trash Lob: +8, range 60/240 ft., 16 (2d10 + 5) Bludgeoning,
    // and the target has the Poisoned condition until the end of its next turn.
    k = RsMonsterBlock.{id = "monster/hill-giant", name = "Hill Giant", page = 298, xp = 1800, pb = 3, size = RS_HUGE, ac = 13, hp = 105, speed = 40,
                        score = [6] int.[21, 8, 19, 5, 9, 6]};
    a[0] = rs_mon_attack("monster/hill-giant/tree-club", "Tree Club", 8, 3, 8, 5, RS_BLUDGEONING, RS_STR, 10);
    a[0].ride = RS_RIDE_PRONE; a[0].ride_size = RS_LARGE;
    a[1] = rs_mon_attack("monster/hill-giant/trash-lob", "Trash Lob", 8, 2, 10, 5, RS_BLUDGEONING, RS_STR, 0);
    a[1].range_ft = 60; a[1].long_ft = 240; a[1].ride = RS_RIDE_POISON_TO_END;
    k.action = RsStatAction.{attacks = a, n = 2, count = 2};
  } else if m == MON_WOLF {
    // Wolf (p. 364): Medium Beast, AC 12, HP 11 (2d8 + 2), Speed 40 ft., Str 14 Dex 15 Con 12 Int 3
    // Wis 12 Cha 6; CR 1/4 (XP 50; PB +2). Pack Tactics. Bite: +4, reach 5 ft., 5 (1d6 + 2)
    // Piercing; a Medium or smaller target has the Prone condition.
    k = RsMonsterBlock.{id = "monster/wolf", name = "Wolf", page = 364, xp = 50, pb = 2, size = RS_MEDIUM, ac = 12, hp = 11, speed = 40,
                        score = [6] int.[14, 15, 12, 3, 12, 6], pack = true};
    a[0] = rs_mon_attack("monster/wolf/bite", "Bite", 4, 1, 6, 2, RS_PIERCING, RS_STR, 5);
    a[0].ride = RS_RIDE_PRONE; a[0].ride_size = RS_MEDIUM;
    k.action = RsStatAction.{attacks = a, n = 1, count = 1};
  } else if m == MON_ZOMBIE {
    // Zombie (p. 343): Medium Undead, AC 8, HP 15 (2d8 + 6), Speed 20 ft., Str 13 Dex 6 Con 16 Int 3
    // Wis 6 (save +0) Cha 5; Immunities Poison; Exhaustion, Poisoned; CR 1/4 (XP 50; PB +2). Undead
    // Fortitude. Slam: +3, reach 5 ft., 5 (1d8 + 1) Bludgeoning.
    k = RsMonsterBlock.{id = "monster/zombie", name = "Zombie", page = 343, xp = 50, pb = 2, size = RS_MEDIUM, ac = 8, hp = 15, speed = 20,
                        score = [6] int.[13, 6, 16, 3, 6, 5], saves = 1 << RS_WIS, immune = 1 << RS_POISON,
                        immune_cond = RS_POISONED | RS_EXHAUSTION, undead = true, fortitude = true};
    a[0] = rs_mon_attack("monster/zombie/slam", "Slam", 3, 1, 8, 1, RS_BLUDGEONING, RS_STR, 5);
    k.action = RsStatAction.{attacks = a, n = 1, count = 1};
  }
  return k;
}
rs_monster_action :: (m: int) -> RsStatAction { return rs_monster_block(m).action; }
// A block's Proficiency Bonus as the engine's level: +2 is level 1, +3 level 5, +4 level 9.
rs_pb_level :: (pb: int) -> int { return 1 + (pb - 2) * 4; }
// The creature of block m on `team`, called `name` (a world's own name for it, else the block's).
rs_monster :: (m: int, name: string, team: int) -> RsCreature {
  k := rs_monster_block(m);
  c: [1] RsCreature;
  rs_set_name(c[..], ifx name.count > 0 then name else k.name);
  c[0].team = team; c[0].level = rs_pb_level(k.pb); c[0].klass = RS_MONSTER;
  c[0].score = k.score;
  for ab: 0..<6 { c[0].save_prof[ab] = (k.saves & (1 << ab)) != 0; }
  c[0].ac = k.ac; c[0].hp_max = k.hp; c[0].hp = k.hp; c[0].speed = k.speed;
  c[0].form = rs_form(k.size, (ifx k.pack then RS_TRAIT_PACK else 0) | (ifx k.magic then RS_TRAIT_MAGIC else 0) | (ifx k.nimble then RS_TRAIT_NIMBLE else 0));
  c[0].resist = k.resist; c[0].immune = k.immune; c[0].immune_cond = k.immune_cond;
  c[0].undead = k.undead; c[0].fortitude = k.fortitude;
  c[0].spell_ability = -1; c[0].weapon = W_UNARMED; c[0].ranged = -1;
  c[0].conc = -1; c[0].restrained_by = -1; c[0].outlined_by = -1; c[0].free_spell = -1; c[0].agonizing = -1; c[0].repelling = -1;
  return c[0];
}

// ---- the used-monster manifest: every creature an Everglade world fields, and its block

RsUsedMonster :: struct { world: string; role: string; id: string; }
RS_USED_MONSTERS :: [15] RsUsedMonster.[
  RsUsedMonster.{world = "experimental", role = "imp", id = "monster/imp"},
  RsUsedMonster.{world = "experimental", role = "gremlin", id = "monster/goblin-warrior"},
  RsUsedMonster.{world = "experimental", role = "puglin brute", id = "monster/ogre"},
  RsUsedMonster.{world = "experimental", role = "imp fiend", id = "monster/quasit"},
  RsUsedMonster.{world = "experimental", role = "puglin warlord", id = "monster/hill-giant"},
  RsUsedMonster.{world = "everglade-room", role = "conjure animals wolf", id = "monster/wolf"},
  RsUsedMonster.{world = "everglade-room", role = "finger of death zombie", id = "monster/zombie"},
  RsUsedMonster.{world = "everglade-room", role = "raid cultist", id = "monster/cultist"},
  RsUsedMonster.{world = "everglade-room", role = "raid fanatic", id = "monster/cultist-fanatic"},
  RsUsedMonster.{world = "everglade-room", role = "watch guard", id = "monster/guard"},
  RsUsedMonster.{world = "everglade-room", role = "watch veteran", id = "monster/warrior-veteran"},
  RsUsedMonster.{world = "everglade-room", role = "watch knight", id = "monster/knight"},
  RsUsedMonster.{world = "everglade-room", role = "watch scout", id = "monster/scout"},
  RsUsedMonster.{world = "everglade-forge", role = "cultist", id = "monster/cultist"},
  RsUsedMonster.{world = "everglade-forge", role = "guard", id = "monster/guard"}];
// Whether a manifest source ID names a block the engine builds: this file's, or npcs.coax's.
rs_used_monster_built :: (id: string) -> bool {
  for m: 1..<MON_N { if rs_monster_block(m).id == id { return true; } }
  for npc: [6] string.["monster/cultist", "monster/cultist-fanatic", "monster/guard", "monster/warrior-veteran", "monster/knight", "monster/scout"] {
    if npc == id { return true; }
  }
  return false;
}
