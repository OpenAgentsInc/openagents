// More SRD 5.2.1 spells as records, past spells.coax's first RS_SPELLS: the ones Everglade's bar
// casts (apps/openagents-web/fivebar.coax) that the first records didn't hold. Loaded by
// spells.coax, which answers for them through rs_spell. Each holds the SRD's level, school, casting
// time, range, duration, concentration and area, and an effect program in the same closed set of
// steps battle.coax runs. Canonical source words/page numbers are now in data/ through import.coax
// and catalog.coax. This legacy executable view still has empty `text` and page 0 pending migration;
// importing metadata alone does not qualify these effect programs.
//
// The grid has squares and spheres, and Lines from you (Lightning Bolt, Gust of Wind: RS_A_LINE),
// not cones or Lines elsewhere, so: a line (Wind Wall, Wall of Fire, Wall of Thorns, Sunbeam) is the
// square or sphere at the point it is aimed through, and a cone (Cone of Cold) is a cube from you. A cylinder is the sphere of
// its radius. What a spell does to the world rather than to a creature (lifting, water, walls you
// can't pass) is the world's; the record holds what the rules do to a creature.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test --library aethyr/rules/srd/spells.coax

SP_ICE_KNIFE :: 30; SP_ICE_KNIFE_BURST :: 31; SP_ICE_STORM :: 32; SP_SLEET_STORM :: 33; SP_MOONBEAM :: 34;
SP_SHILLELAGH :: 35; SP_ELEMENTALISM :: 36; SP_SPIKE_GROWTH :: 37; SP_SPIKE_STEP :: 38; SP_WALL_OF_FIRE :: 39;
SP_CONJURE_ANIMALS :: 40; SP_POLYMORPH :: 41; SP_MASS_CURE_WOUNDS :: 42; SP_SUNBEAM :: 43; SP_WALL_OF_THORNS :: 44;
SP_FIRE_STORM :: 45; SP_SUNBURST :: 46; SP_STORM_OF_VENGEANCE :: 47; SP_STORM_BOLT :: 48; SP_SHAPECHANGE :: 49;
SP_SPEAK_WITH_ANIMALS :: 50; SP_RAY_OF_FROST :: 51; SP_FOG_CLOUD :: 52; SP_CONE_OF_COLD :: 53; SP_REVERSE_GRAVITY :: 54;
SP_WIND_WALL :: 55; SP_LEVITATE :: 56; SP_FEATHER_FALL :: 57; SP_GUST_OF_WIND :: 58; SP_WALL_OF_STONE :: 59;
SP_TELEKINESIS :: 60; SP_BLACK_TENTACLES :: 61; SP_WATER_WALK :: 62; SP_CONTROL_WATER :: 63; SP_CREATE_WATER :: 64;
SP_WATER_BREATHING :: 65; SP_METEOR_SWARM :: 66;
// the Warlock's (a level 17 Fiend Warlock's bar: apps/openagents-web/fivebar.coax fb_warlock_bar)
SP_BLIGHT :: 67; SP_CIRCLE_OF_DEATH :: 68; SP_FINGER_OF_DEATH :: 69; SP_DIMENSION_DOOR :: 70;
// a Warlock's Reaction (battle.coax rs_hellish_rebuke runs it: a Reaction isn't cast on a turn)
SP_HELLISH_REBUKE :: 71;
// the Cultist Raid's (apps/openagents-web/everglade-raid-tactics.coax rt_spell)
SP_BURNING_HANDS :: 72; SP_LIGHTNING_BOLT :: 73;
// the cult's buffs and debuffs in a raid (#12771): the Cult Priests' (Clerics'), the Warlocks' and the Fanatics'
SP_BLESS :: 74; SP_BANE :: 75; SP_SHIELD_OF_FAITH :: 76; SP_COMMAND :: 77;
// the levels 1-6 slice's (#13043): spells the closed step set already expresses
SP_INFLICT_WOUNDS :: 78; SP_ACID_SPLASH :: 79; SP_MAGIC_MISSILE :: 80; SP_MASS_HEALING_WORD :: 81;
SP_SHATTER :: 82;
SP_FIND_FAMILIAR :: 83;
SP_LESSER_RESTORATION :: 84;
SP_AID :: 85;
SP_GUIDANCE :: 86;
SP_PROTECTION_GOOD_EVIL :: 87;
RS_MORE_END :: 88;

// A record's fields, the steps after.
rs_more :: (id: string, name: string, level: int, school: string, classes: string, time: int, range_ft: int,
            duration: string, duration_s: f32, conc: bool, area: int, area_ft: int) -> RsSpell {
  return RsSpell.{id = id, name = name, level = level, school = school, classes = classes, cast_time = time, range_ft = range_ft,
                  components = "", duration = duration, duration_s = duration_s, concentration = conc, area = area, area_ft = area_ft,
                  part_of = -1, page = 0, text = ""};
}
rs_more_spell :: (i: int) -> RsSpell {
  if i >= RS_HOUSE { return rs_house_spell(i); }
  s: RsSpell;
  s.part_of = -1;
  if i == SP_ICE_KNIFE {
    s = rs_more("ice-knife", "Ice Knife", 1, "Conjuration", "Druid, Sorcerer, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 10, RS_PIERCING, 0); s.step_n = 2;
  } else if i == SP_ICE_KNIFE_BURST {
    // the shard explodes, hit or miss: each creature within 5 feet of the target
    s = rs_more("ice-knife-burst", "Ice Knife", 1, "Conjuration", "Druid, Sorcerer, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_SPHERE, 5);
    s.part_of = SP_ICE_KNIFE;
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 6, RS_COLD, 1); s.step_n = 2;
  } else if i == SP_ICE_STORM {
    // the ground is Difficult Terrain until the end of the caster's next turn
    s = rs_more("ice-storm", "Ice Storm", 4, "Evocation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 300, "Instantaneous", 6, false, RS_A_SPHERE, 20);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 10, RS_BLUDGEONING, 1);
    s.steps[2] = rs_step(RS_S_DAMAGE, 4, 6, RS_COLD, 0); s.steps[3] = rs_step(RS_S_TERRAIN, 0, 0, 0, 0); s.step_n = 4;
  } else if i == SP_SLEET_STORM {
    s = rs_more("sleet-storm", "Sleet Storm", 3, "Conjuration", "Druid, Sorcerer, Wizard", RS_T_ACTION, 150, "Concentration, up to 1 minute", 60, true, RS_A_SPHERE, 40);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_CONDITION, RS_PRONE, 0, 0, 0);
    s.steps[2] = rs_step(RS_S_TERRAIN, 0, 0, 0, 0); s.step_n = 3;
  } else if i == SP_MOONBEAM {
    s = rs_more("moonbeam", "Moonbeam", 2, "Evocation", "Druid", RS_T_ACTION, 120, "Concentration, up to 1 minute", 60, true, RS_A_SPHERE, 5);
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 10, RS_RADIANT, 1); s.step_n = 2;
  } else if i == SP_SHILLELAGH {
    s = rs_more("shillelagh", "Shillelagh", 0, "Transmutation", "Druid", RS_T_BONUS, 0, "1 minute", 60, false, RS_A_NONE, 0);
  } else if i == SP_ELEMENTALISM {
    s = rs_more("elementalism", "Elementalism", 0, "Transmutation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 30, "Instantaneous", 0, false, RS_A_NONE, 0);
  } else if i == SP_SPIKE_GROWTH {
    s = rs_more("spike-growth", "Spike Growth", 2, "Transmutation", "Druid, Ranger", RS_T_ACTION, 150, "Concentration, up to 10 minutes", 600, true, RS_A_SPHERE, 20);
    s.steps[0] = rs_step(RS_S_TERRAIN, 0, 0, 0, 0); s.step_n = 1;
  } else if i == SP_SPIKE_STEP {
    // 2d4 Piercing for every 5 feet a creature moves in it
    s = rs_more("spike-growth-step", "Spike Growth", 2, "Transmutation", "Druid, Ranger", RS_T_ACTION, 150, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.part_of = SP_SPIKE_GROWTH;
    s.steps[0] = rs_step(RS_S_DAMAGE, 2, 4, RS_PIERCING, 0); s.step_n = 1;
  } else if i == SP_WALL_OF_FIRE {
    s = rs_more("wall-of-fire", "Wall of Fire", 4, "Evocation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 120, "Concentration, up to 1 minute", 60, true, RS_A_SQUARE, 10);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 5, 8, RS_FIRE, 1); s.step_n = 2;
  } else if i == SP_CONJURE_ANIMALS {
    s = rs_more("conjure-animals", "Conjure Animals", 3, "Conjuration", "Druid, Ranger", RS_T_ACTION, 60, "Concentration, up to 10 minutes", 600, true, RS_A_SPHERE, 10);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 3, 10, RS_SLASHING, 1); s.step_n = 2;
  } else if i == SP_POLYMORPH {
    // a beast's shape: as the grid can hold it, Incapacitated as itself for the duration
    s = rs_more("polymorph", "Polymorph", 4, "Transmutation", "Bard, Druid, Sorcerer, Wizard", RS_T_ACTION, 60, "Concentration, up to 1 hour", 3600, true, RS_A_NONE, 0);
    s.steps[0] = rs_step(RS_S_SAVE, RS_WIS, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_TIMED, RS_INCAPACITATED, 2, -1, 0); s.step_n = 2;
  } else if i == SP_MASS_CURE_WOUNDS {
    // up to six creatures in a 30-foot sphere: the world picks them and runs the record on each
    s = rs_more("mass-cure-wounds", "Mass Cure Wounds", 5, "Abjuration", "Bard, Cleric, Druid", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.steps[0] = rs_step(RS_S_HEAL, 5, 8, 1, 1); s.step_n = 1;
  } else if i == SP_SUNBEAM {
    s = rs_more("sunbeam", "Sunbeam", 6, "Evocation", "Cleric, Druid, Sorcerer, Wizard", RS_T_ACTION, 60, "Concentration, up to 1 minute", 60, true, RS_A_SPHERE, 5);
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 6, 8, RS_RADIANT, 0);
    s.steps[2] = rs_step(RS_S_TIMED, RS_BLINDED, 1, 0, 0); s.step_n = 3;
  } else if i == SP_WALL_OF_THORNS {
    s = rs_more("wall-of-thorns", "Wall of Thorns", 6, "Conjuration", "Druid", RS_T_ACTION, 120, "Concentration, up to 10 minutes", 600, true, RS_A_SQUARE, 10);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 7, 8, RS_PIERCING, 1); s.step_n = 2;
  } else if i == SP_FIRE_STORM {
    s = rs_more("fire-storm", "Fire Storm", 7, "Evocation", "Cleric, Druid, Sorcerer", RS_T_ACTION, 150, "Instantaneous", 0, false, RS_A_CUBE, 30);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 7, 10, RS_FIRE, 0); s.step_n = 2;
  } else if i == SP_SUNBURST {
    s = rs_more("sunburst", "Sunburst", 8, "Evocation", "Cleric, Druid, Sorcerer, Wizard", RS_T_ACTION, 150, "Instantaneous", 0, false, RS_A_SPHERE, 60);
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 12, 6, RS_RADIANT, 0);
    s.steps[2] = rs_step(RS_S_TIMED, RS_BLINDED, 2, RS_CON, 0); s.step_n = 3;
    s.duration_s = 60; s.burst = true;   // Blinded for a minute, the light itself only as it's cast
  } else if i == SP_STORM_OF_VENGEANCE {
    s = rs_more("storm-of-vengeance", "Storm of Vengeance", 9, "Conjuration", "Druid", RS_T_ACTION, 5280, "Concentration, up to 1 minute", 60, true, RS_A_SPHERE, 300);
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 6, RS_THUNDER, 0);
    s.steps[2] = rs_step(RS_S_CONDITION, RS_DEAFENED, 0, 0, 0); s.step_n = 3;
  } else if i == SP_STORM_BOLT {
    // its later rounds: bolts of lightning, each on a creature under the cloud
    s = rs_more("storm-of-vengeance-bolt", "Storm of Vengeance", 9, "Conjuration", "Druid", RS_T_ACTION, 5280, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.part_of = SP_STORM_OF_VENGEANCE;
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 10, 6, RS_LIGHTNING, 0); s.step_n = 2;
  } else if i == SP_SHAPECHANGE {
    s = rs_more("shapechange", "Shapechange", 9, "Transmutation", "Druid, Wizard", RS_T_ACTION, 0, "Concentration, up to 1 hour", 3600, true, RS_A_NONE, 0);
  } else if i == SP_SPEAK_WITH_ANIMALS {
    s = rs_more("speak-with-animals", "Speak with Animals", 1, "Divination", "Bard, Druid, Ranger, Warlock", RS_T_ACTION, 0, "10 minutes", 600, false, RS_A_NONE, 0); s.ritual = true;
  } else if i == SP_RAY_OF_FROST {
    s = rs_more("ray-of-frost", "Ray of Frost", 0, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 8, RS_COLD, 0); s.step_n = 2;
  } else if i == SP_FOG_CLOUD {
    s = rs_more("fog-cloud", "Fog Cloud", 1, "Conjuration", "Druid, Ranger, Sorcerer, Wizard", RS_T_ACTION, 120, "Concentration, up to 1 hour", 3600, true, RS_A_SPHERE, 20);
  } else if i == SP_CONE_OF_COLD {
    s = rs_more("cone-of-cold", "Cone of Cold", 5, "Evocation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 0, "Instantaneous", 0, false, RS_A_CUBE_SELF, 30);
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 8, 8, RS_COLD, 1); s.step_n = 2;
  } else if i == SP_REVERSE_GRAVITY {
    // a failure falls upward (the world's physics); a success holds on to something within reach
    s = rs_more("reverse-gravity", "Reverse Gravity", 7, "Transmutation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 100, "Concentration, up to 1 minute", 60, true, RS_A_SPHERE, 50);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.step_n = 1;
  } else if i == SP_WIND_WALL {
    s = rs_more("wind-wall", "Wind Wall", 3, "Evocation", "Druid, Ranger", RS_T_ACTION, 120, "Concentration, up to 1 minute", 60, true, RS_A_SQUARE, 10);
    s.steps[0] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 4, 8, RS_BLUDGEONING, 0); s.step_n = 2;
  } else if i == SP_LEVITATE {
    s = rs_more("levitate", "Levitate", 2, "Transmutation", "Sorcerer, Wizard", RS_T_ACTION, 60, "Concentration, up to 10 minutes", 600, true, RS_A_NONE, 0);
  } else if i == SP_FEATHER_FALL {
    s = rs_more("feather-fall", "Feather Fall", 1, "Transmutation", "Bard, Sorcerer, Wizard", RS_T_REACTION, 60, "1 minute", 60, false, RS_A_NONE, 0);
  } else if i == SP_GUST_OF_WIND {
    // a Line 60 feet long and 10 feet wide from you: each creature in it makes a Strength save or is
    // pushed 15 feet away from you, and one that ends its turn in it makes the same save (SRD 5.2.1)
    s = rs_more("gust-of-wind", "Gust of Wind", 2, "Evocation", "Druid, Ranger, Sorcerer, Wizard", RS_T_ACTION, 0, "Concentration, up to 1 minute", 60, true, RS_A_LINE, 60);
    s.wide_ft = 10; s.turn_save = true;
    s.steps[0] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_PUSH, 15, 0, 0, 0); s.step_n = 2;
  } else if i == SP_WALL_OF_STONE {
    s = rs_more("wall-of-stone", "Wall of Stone", 5, "Evocation", "Druid, Sorcerer, Wizard", RS_T_ACTION, 120, "Concentration, up to 10 minutes", 600, true, RS_A_SQUARE, 10);
  } else if i == SP_TELEKINESIS {
    s = rs_more("telekinesis", "Telekinesis", 5, "Transmutation", "Sorcerer, Wizard", RS_T_ACTION, 60, "Concentration, up to 10 minutes", 600, true, RS_A_NONE, 0);
    s.steps[0] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_TIMED, RS_RESTRAINED, 1, 0, 0); s.step_n = 2;
  } else if i == SP_BLACK_TENTACLES {
    s = rs_more("black-tentacles", "Evard's Black Tentacles", 4, "Conjuration", "Wizard", RS_T_ACTION, 90, "Concentration, up to 1 minute", 60, true, RS_A_SQUARE, 20);
    s.steps[0] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 3, 6, RS_BLUDGEONING, 0);
    s.steps[2] = rs_step(RS_S_CONDITION, RS_RESTRAINED, 0, 0, 0); s.steps[3] = rs_step(RS_S_ESCAPE, RS_STR, 0, 0, 0);
    s.steps[4] = rs_step(RS_S_TERRAIN, 0, 0, 0, 0); s.step_n = 5;
  } else if i == SP_WATER_WALK {
    s = rs_more("water-walk", "Water Walk", 3, "Transmutation", "Cleric, Druid, Ranger, Sorcerer", RS_T_ACTION, 30, "1 hour", 3600, false, RS_A_NONE, 0); s.ritual = true;
  } else if i == SP_CONTROL_WATER {
    // its whirlpool: a creature in the water makes a Strength save or takes 2d8 Bludgeoning
    s = rs_more("control-water", "Control Water", 4, "Transmutation", "Cleric, Druid, Wizard", RS_T_ACTION, 300, "Concentration, up to 10 minutes", 600, true, RS_A_SPHERE, 25);
    s.steps[0] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 8, RS_BLUDGEONING, 0); s.step_n = 2;
  } else if i == SP_CREATE_WATER {
    s = rs_more("create-or-destroy-water", "Create or Destroy Water", 1, "Transmutation", "Cleric, Druid", RS_T_ACTION, 30, "Instantaneous", 0, false, RS_A_NONE, 0);
  } else if i == SP_WATER_BREATHING {
    s = rs_more("water-breathing", "Water Breathing", 3, "Transmutation", "Druid, Ranger, Sorcerer, Wizard", RS_T_ACTION, 30, "24 hours", 86400, false, RS_A_NONE, 0); s.ritual = true;
  } else if i == SP_METEOR_SWARM {
    s = rs_more("meteor-swarm", "Meteor Swarm", 9, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 5280, "Instantaneous", 0, false, RS_A_SPHERE, 40);
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 20, 6, RS_FIRE, 0);
    s.steps[2] = rs_step(RS_S_DAMAGE, 20, 6, RS_BLUDGEONING, 0); s.step_n = 3;
  } else if i == SP_BLIGHT {
    // No Plant creature fights here; the plant it can wither instead (a tree) is the world's.
    s = rs_more("blight", "Blight", 4, "Necromancy", "Druid, Sorcerer, Warlock, Wizard", RS_T_ACTION, 30, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 113;
    s.text = "A creature that you can see within range makes a Constitution saving throw, taking 8d8 Necrotic damage on a failed save or half as much damage on a successful one. A Plant creature automatically fails the save. Alternatively, target a nonmagical plant that isn't a creature, such as a tree or shrub. It doesn't make a save; it simply withers and dies. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 4.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 8, 8, RS_NECROTIC, 1); s.step_n = 2;
  } else if i == SP_CIRCLE_OF_DEATH {
    s = rs_more("circle-of-death", "Circle of Death", 6, "Necromancy", "Sorcerer, Warlock, Wizard", RS_T_ACTION, 150, "Instantaneous", 0, false, RS_A_SPHERE, 60);
    s.components = "V, S, M (the powder of a crushed black pearl worth 500+ GP)"; s.page = 115;
    s.text = "Negative energy ripples out in a 60-foot-radius Sphere from a point you choose within range. Each creature in that area makes a Constitution saving throw, taking 8d8 Necrotic damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 2d8 for each spell slot level above 6.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 8, 8, RS_NECROTIC, 2); s.step_n = 2;
  } else if i == SP_FINGER_OF_DEATH {
    s = rs_more("finger-of-death", "Finger of Death", 7, "Necromancy", "Sorcerer, Warlock, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 131; s.plus = 30;
    s.text = "You unleash negative energy toward a creature you can see within range. The target makes a Constitution saving throw, taking 7d8 + 30 Necrotic damage on a failed save or half as much damage on a successful one. A Humanoid killed by this spell rises at the start of your next turn as a Zombie (see \"Monsters\") that follows your verbal orders.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 7, 8, RS_NECROTIC, 0);
    s.steps[2] = rs_step(RS_S_RISE, 0, 0, 0, 0); s.step_n = 3;
  } else if i == SP_HELLISH_REBUKE {
    s = rs_more("hellish-rebuke", "Hellish Rebuke", 1, "Evocation", "Warlock", RS_T_REACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 140;
    s.text = "The creature that damaged you is momentarily surrounded by green flames. It makes a Dexterity saving throw, taking 2d10 Fire damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 10, RS_FIRE, 1); s.step_n = 2;
  } else if i == SP_BURNING_HANDS {
    // its 15-foot Cone as the 15-foot cube against your side toward the point (Cone of Cold's rule)
    s = rs_more("burning-hands", "Burning Hands", 1, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 0, "Instantaneous", 0, false, RS_A_CUBE_SELF, 15);
    s.components = "V, S";
    s.text = "A thin sheet of flames shoots forth from you. Each creature in a 15-foot Cone makes a Dexterity saving throw, taking 3d6 Fire damage on a failed save or half as much damage on a successful one. Flammable objects in the Cone that aren't being worn or carried start burning. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 3, 6, RS_FIRE, 1); s.step_n = 2;
  } else if i == SP_LIGHTNING_BOLT {
    s = rs_more("lightning-bolt", "Lightning Bolt", 3, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 0, "Instantaneous", 0, false, RS_A_LINE, 100);
    s.components = "V, S, M (a bit of fur and a crystal rod)";
    s.text = "A stroke of lightning forming a 100-foot-long, 5-foot-wide Line blasts out from you in a direction you choose. Each creature in the Line makes a Dexterity saving throw, taking 8d6 Lightning damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 3.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 8, 6, RS_LIGHTNING, 1); s.step_n = 2;
  } else if i == SP_DIMENSION_DOOR {
    // You alone: the willing creature it can bring along isn't offered here.
    s = rs_more("dimension-door", "Dimension Door", 4, "Conjuration", "Bard, Sorcerer, Warlock, Wizard", RS_T_ACTION, 500, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V"; s.page = 123;
    s.text = "You teleport to a location within range. You arrive at exactly the spot desired. It can be a place you can see, one you can visualize, or one you can describe by stating distance and direction, such as \"200 feet straight downward\" or \"300 feet upward to the northwest at a 45-degree angle.\" You can also teleport one willing creature. The creature must be within 5 feet of you when you teleport, and it teleports to a space within 5 feet of your destination space. If you, the other creature, or both would arrive in a space occupied by a creature or completely filled by one or more objects, you and any creature traveling with you each take 4d6 Force damage, and the teleportation fails.";
    s.steps[0] = rs_step(RS_S_TELEPORT, 0, 0, 0, 0); s.step_n = 1;
  } else if i == SP_INFLICT_WOUNDS {
    s = rs_more("inflict-wounds", "Inflict Wounds", 1, "Necromancy", "Cleric", RS_T_ACTION, 5, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 143;
    s.text = "A creature you touch makes a Constitution saving throw, taking 2d10 Necrotic damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 10, RS_NECROTIC, 1); s.step_n = 2;
  } else if i == SP_ACID_SPLASH {
    s = rs_more("acid-splash", "Acid Splash", 0, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_SPHERE, 5);
    s.components = "V, S"; s.page = 107;
    s.text = "You create an acidic bubble at a point within range, where it explodes in a 5-foot-radius Sphere. Each creature in that Sphere must succeed on a Dexterity saving throw or take 1d6 Acid damage. Cantrip Upgrade. The damage increases by 1d6 when you reach levels 5 (2d6), 11 (3d6), and 17 (4d6).";
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 6, RS_ACID, 0); s.step_n = 2;
  } else if i == SP_MAGIC_MISSILE {
    // Each dart is its own damage roll of 1d4 + 1 (plus); no attack roll, so every dart strikes.
    // A target with Shield up takes none of it (magic-missile-ward.coax).
    s = rs_more("magic-missile", "Magic Missile", 1, "Evocation", "Sorcerer, Wizard", RS_T_ACTION, 120, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 146; s.plus = 1;
    s.text = "You create three glowing darts of magical force. Each dart strikes a creature of your choice that you can see within range. A dart deals 1d4 + 1 Force damage to its target. The darts all strike simultaneously, and you can direct them to hit one creature or several. Using a Higher-Level Spell Slot. The spell creates one more dart for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_REPEAT, 3, 1, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 4, RS_FORCE, 0); s.step_n = 2;
  } else if i == SP_MASS_HEALING_WORD {
    s = rs_more("mass-healing-word", "Mass Healing Word", 3, "Abjuration", "Bard, Cleric", RS_T_BONUS, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V"; s.page = 148; s.targets = 6; s.targets_optional = true;
    s.text = "Up to six creatures of your choice that you can see within range regain Hit Points equal to 2d4 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 1d4 for each spell slot level above 3.";
    s.steps[0] = rs_step(RS_S_HEAL, 2, 4, 1, 1); s.step_n = 1;
  } else if i == SP_SHATTER {
    // Damage to unattended nonmagical objects in the area is the world's.
    s = rs_more("shatter", "Shatter", 2, "Evocation", "Bard, Sorcerer, Wizard", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_SPHERE, 10);
    s.components = "V, S, M (a chip of mica)"; s.page = 161;
    s.text = "A loud noise erupts from a point of your choice within range. Each creature in a 10-foot-radius Sphere centered there makes a Constitution saving throw, taking 3d8 Thunder damage on a failed save or half as much damage on a successful one. A Construct has Disadvantage on the save. A nonmagical object that isn't being worn or carried also takes the damage if it's in the spell's area. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 2.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, RS_SAVE_RIDER_CONSTRUCT_DIS, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 3, 8, RS_THUNDER, 1); s.step_n = 2;
  } else if i == SP_BLESS {
    s = rs_more("bless", "Bless", 1, "Enchantment", "Cleric, Paladin", RS_T_ACTION, 30, "Concentration, up to 1 minute", 60, true, RS_A_NONE, 0);
    s.components = "V, S, M (a Holy Symbol worth 5+ GP)"; s.targets = 3; s.target_growth = 1; s.targets_optional = true;
    s.text = "You bless up to three creatures within range. Whenever a target makes an attack roll or a saving throw before the spell ends, the target adds 1d4 to the attack roll or save. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_BOON, EF_BLESS, 0, 0, 0); s.step_n = 1;
  } else if i == SP_BANE {
    s = rs_more("bane", "Bane", 1, "Enchantment", "Bard, Cleric, Warlock", RS_T_ACTION, 30, "Concentration, up to 1 minute", 60, true, RS_A_NONE, 0);
    s.components = "V, S, M (a drop of blood)"; s.targets = 3; s.target_growth = 1; s.targets_optional = true;
    s.text = "Up to three creatures of your choice that you can see within range must each make a Charisma saving throw. Whenever a target that fails this save makes an attack roll or a saving throw before the spell ends, the target must subtract 1d4 from the attack roll or save. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_CHA, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_BOON, EF_BANE, 0, 0, 0); s.step_n = 2;
  } else if i == SP_SHIELD_OF_FAITH {
    s = rs_more("shield-of-faith", "Shield of Faith", 1, "Abjuration", "Cleric, Paladin", RS_T_BONUS, 60, "Concentration, up to 10 minutes", 600, true, RS_A_NONE, 0);
    s.components = "V, S, M (a prayer scroll)";
    s.text = "A shimmering field surrounds a creature of your choice within range, granting it a +2 bonus to Armor Class for the duration.";
    s.steps[0] = rs_step(RS_S_BOON, EF_FAITH, 0, 0, 0); s.step_n = 1;
  } else if i == SP_COMMAND {
    // the command is Halt (the record holds that one: the raid's, to stop a foe where it stands)
    s = rs_more("command", "Command", 1, "Enchantment", "Bard, Cleric, Paladin", RS_T_ACTION, 60, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V"; s.targets = 1; s.target_growth = 1;
    s.text = "You speak a one-word command to a creature you can see within range. The target must succeed on a Wisdom saving throw or follow the command on its next turn. Choose the command from these options: Approach. The target moves toward you by the shortest and most direct route, ending its turn if it moves within 5 feet of you. Drop. The target drops whatever it is holding and then ends its turn. Flee. The target spends its turn moving away from you by the fastest available means. Grovel. The target has the Prone condition and then ends its turn. Halt. On its turn, the target doesn't move and takes no action or Bonus Action. Using a Higher-Level Spell Slot. You can affect one additional creature for each spell slot level above 1.";
    s.steps[0] = rs_step(RS_S_SAVE, RS_WIS, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_HALT, 0, 0, 0, 0); s.step_n = 2;
  } else if i == SP_FIND_FAMILIAR {
    s = rs_more("find-familiar", "Find Familiar", 1, "Conjuration", "Wizard", RS_T_LONG, 10, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S, M (burning incense worth 10+ GP, consumed)";
    s.ritual = true; s.page = 130;
  } else if i == SP_LESSER_RESTORATION {
    s = rs_more("lesser-restoration", "Lesser Restoration", 2, "Abjuration", "Bard, Cleric, Druid, Paladin, Ranger", RS_T_BONUS, 5, "Instantaneous", 0, false, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 144;
    s.steps[0] = rs_step(RS_S_RESTORE, 0, 0, 0, 0); s.step_n = 1;
  } else if i == SP_AID {
    s = rs_more("aid", "Aid", 2, "Abjuration", "Bard, Cleric, Druid, Paladin, Ranger", RS_T_ACTION, 30, "8 hours", 28800, false, RS_A_NONE, 0);
    s.components = "V, S, M (a strip of white cloth)"; s.page = 107; s.targets = 3; s.targets_optional = true;
    s.steps[0] = rs_step(RS_S_AID, 5, 0, 0, 0); s.step_n = 1;
  } else if i == SP_GUIDANCE {
    s = rs_more("guidance", "Guidance", 0, "Divination", "Cleric, Druid", RS_T_ACTION, 5, "Concentration, up to 1 minute", 60, true, RS_A_NONE, 0);
    s.components = "V, S"; s.page = 138;
    s.steps[0] = rs_step(RS_S_BOON, EF_GUIDANCE, SK_PERCEPTION, 0, 0); s.step_n = 1;
  } else if i == SP_PROTECTION_GOOD_EVIL {
    s = rs_more("protection-from-evil-and-good", "Protection from Evil and Good", 1, "Abjuration", "Cleric, Druid, Paladin, Warlock, Wizard", RS_T_ACTION, 5, "Concentration up to 10 minutes", 600, true, RS_A_NONE, 0);
    s.components = "V, S, M (a flask of Holy Water worth 25+ GP, which the spell consumes)"; s.page = 157;
    s.steps[0] = rs_step(RS_S_BOON, EF_PROTECTION, 0, 0, 0); s.step_n = 1;
  }
  return s;
}

#test "the more records hold the SRD's numbers" {
  for i: RS_SPELLS..<RS_MORE_END { s := rs_spell(i); #assert s.name.count > 0 && s.id.count > 0 && s.srd && s.level >= 0 && s.level <= 9; }
  ms := rs_spell(SP_METEOR_SWARM); #assert ms.level == 9 && ms.steps[1].a == 20 && ms.steps[1].b == 6 && ms.steps[2].c == RS_BLUDGEONING && ms.area_ft == 40;
  mb := rs_spell(SP_MOONBEAM); #assert mb.level == 2 && mb.concentration && mb.steps[0].a == RS_CON && mb.steps[1].b == 10 && mb.steps[1].d == 1;
  is := rs_spell(SP_ICE_STORM); #assert is.level == 4 && is.steps[1].c == RS_BLUDGEONING && is.steps[2].c == RS_COLD && is.area_ft == 20;
  cc := rs_spell(SP_CONE_OF_COLD); #assert cc.level == 5 && cc.steps[1].a == 8 && cc.steps[1].b == 8 && cc.steps[1].c == RS_COLD;
  tent := rs_spell(SP_BLACK_TENTACLES); #assert tent.concentration && tent.steps[2].a == RS_RESTRAINED && tent.area_ft == 20;
  sb := rs_spell(SP_SUNBURST); #assert sb.level == 8 && sb.steps[1].a == 12 && sb.steps[2].a == RS_BLINDED && sb.steps[2].c == RS_CON;
  #assert rs_spell(SP_FEATHER_FALL).cast_time == RS_T_REACTION && rs_spell(SP_ICE_KNIFE_BURST).part_of == SP_ICE_KNIFE;
  #assert rs_spell(SP_THUNDERWAVE).srd && rs_spell(SP_THUNDERWAVE).id == "thunderwave";
  bh := rs_spell(SP_BURNING_HANDS); #assert bh.level == 1 && bh.area_ft == 15 && bh.steps[0].a == RS_DEX && bh.steps[1].a == 3 && bh.steps[1].b == 6 && bh.steps[1].c == RS_FIRE && bh.steps[1].d == 1;
  bl := rs_spell(SP_BLESS); #assert bl.level == 1 && bl.concentration && bl.range_ft == 30 && bl.targets == 3 && bl.steps[0].a == EF_BLESS && bl.duration_s == 60;
  ba := rs_spell(SP_BANE); #assert ba.steps[0].kind == RS_S_SAVE && ba.steps[0].a == RS_CHA && ba.steps[1].a == EF_BANE && ba.targets == 3;
  sf := rs_spell(SP_SHIELD_OF_FAITH); #assert sf.cast_time == RS_T_BONUS && sf.range_ft == 60 && sf.concentration && sf.steps[0].a == EF_FAITH;
  cm := rs_spell(SP_COMMAND); #assert cm.range_ft == 60 && cm.steps[0].a == RS_WIS && cm.steps[1].kind == RS_S_HALT;
  lb := rs_spell(SP_LIGHTNING_BOLT); #assert lb.level == 3 && lb.area == RS_A_LINE && lb.area_ft == 100 && lb.steps[1].a == 8 && lb.steps[1].b == 6 && lb.steps[1].c == RS_LIGHTNING;
  gw := rs_spell(SP_GUST_OF_WIND); #assert gw.area == RS_A_LINE && gw.area_ft == 60 && gw.wide_ft == 10 && gw.turn_save && gw.concentration && gw.steps[0].a == RS_STR && gw.steps[1].a == 15;
}
