// A released attack lands even when its maker falls before it arrives: an arrow loosed, a bolt cast,
// a blow already swung. Anything already released resolves; anything not yet released (a draw, a
// cast bar, a ritual) is cancelled by the fall, which its own caller decides (GitHub #13120).
// For that one resolution the maker stands as it stood when it let go: up, at 1 Hit Point when it
// had none, without the conditions or halts its fall brought. Afterward it is down again as it
// was; whatever the resolution spent (a slot, the action) stays spent.
#authority;

RS_RELEASE_LIFT :: RS_INCAPACITATED | RS_PARALYZED | RS_PETRIFIED | RS_STUNNED | RS_UNCONSCIOUS | RS_PRONE;
RsReleased :: struct { on: bool; dead: bool; hp: int; cond: int; halts: int; halt: [RS_EFFECTS] RsEffect; }

// Stand creature i for a released attack's resolution. Nothing changes when it can act.
rs_release_stand :: (b: [] RsBattle, i: int) -> RsReleased #effects(all) {
  r: RsReleased;
  if i < 0 || i >= b[0].n || rs_can_act(b[0].c[i]) { return r; }
  c := b[0].c[i..<i + 1];
  r.on = true; r.dead = c[0].dead; r.hp = c[0].hp; r.cond = c[0].cond & RS_RELEASE_LIFT;
  c[0].dead = false;
  if c[0].hp < 1 { c[0].hp = 1; }
  c[0].cond = rs_clear(c[0].cond, RS_RELEASE_LIFT);
  for k: 0..<RS_EFFECTS {
    if c[0].eff[k].kind == EF_HALT { r.halts = r.halts | (1 << k); r.halt[k] = c[0].eff[k]; c[0].eff[k].kind = EF_NONE; }
  }
  return r;
}
// Put creature i back down after the resolution rs_release_stand opened.
rs_release_fall :: (b: [] RsBattle, i: int, r: RsReleased) #effects(all) {
  if !r.on || i < 0 || i >= b[0].n { return; }
  c := b[0].c[i..<i + 1];
  c[0].dead = r.dead;
  if r.hp < 1 { c[0].hp = r.hp; }
  c[0].cond = c[0].cond | r.cond;
  for k: 0..<RS_EFFECTS {
    if (r.halts & (1 << k)) == 0 { continue; }
    if c[0].eff[k].kind == EF_NONE { c[0].eff[k] = r.halt[k]; continue; }
    for q: 0..<RS_EFFECTS { if c[0].eff[q].kind == EF_NONE { c[0].eff[q] = r.halt[k]; break; } }
  }
}

#test "released: a fallen archer's loosed shot still rolls and harms; it is down again after" {
  b: [1] RsBattle; b[0].w = 40; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_fighter("Archer", 0, 3), 1, 3);
  t := rs_add(b[..], rs_fighter("Target", 1, 3), 5, 3);
  b[0].c[a].ranged = W_LONGBOW; b[0].c[t].ac = 1; b[0].c[t].hp = 40; b[0].c[t].hp_max = 40;
  rs_start_turn(b[..], a);
  // the archer falls: Unconscious and Prone at 0 Hit Points, and the shot is refused as a new action
  b[0].c[a].hp = 0; b[0].c[a].cond = RS_UNCONSCIOUS | RS_PRONE;
  #assert !rs_shoot(b[..], a, t) && b[0].c[t].hp == 40;
  // released before the fall, it resolves
  up := rs_release_stand(b[..], a);
  #assert up.on && rs_can_act(b[0].c[a]);
  ok := rs_shoot(b[..], a, t);
  rs_release_fall(b[..], a, up);
  #assert ok && b[0].c[t].hp < 40 && b[0].turn.action;
  #assert b[0].c[a].hp == 0 && rs_has(b[0].c[a], RS_UNCONSCIOUS) && rs_has(b[0].c[a], RS_PRONE) && !rs_can_act(b[0].c[a]);
  // a creature that can act is left as it is
  b[0].c[t].hp = 9;
  same := rs_release_stand(b[..], t);
  #assert !same.on && b[0].c[t].hp == 9;
  // a dead creature's halt comes back with it
  b[0].c[a].dead = true; b[0].c[a].eff[2] = RsEffect.{kind = EF_HALT, by = 1, until = 5};
  dn := rs_release_stand(b[..], a);
  #assert dn.on && !b[0].c[a].dead && b[0].c[a].eff[2].kind == EF_NONE && rs_can_act(b[0].c[a]);
  rs_release_fall(b[..], a, dn);
  #assert b[0].c[a].dead && b[0].c[a].eff[2].kind == EF_HALT && b[0].c[a].eff[2].until == 5;
}
