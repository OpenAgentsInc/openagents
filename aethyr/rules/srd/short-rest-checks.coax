// SRD 5.2.1 Short Rest p.187; class-specific recovery in each class chapter.
#load "battle.coax";
#load "hit-point-checks.coax";
#load "dash-checks.coax";

#test "a Short Rest completes once after an actual uninterrupted hour without renewing turn budgets" {
  b:[1]RsBattle; rt_field(b[..],RS_FIGHTER,3); b[0].clock=7; b[0].rest_clock.ticks=7000000;
  b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.slot_spent=true; b[0].turn.move_left=2;
  b[0].c[0].reacted=true; b[0].c[0].uses[RS_USE_WIND]=0; b[0].c[0].uses[RS_USE_SURGE]=0;
  #assert rs_short_rest_begin(b[..],0) && b[0].c[0].rest.phase==1;
  #assert !rs_short_rest_begin(b[..],0) && b[0].c[0].rest.started==7000000;
  b[0].clock=3606; b[0].rest_clock.ticks=3606000000; #assert !rs_short_rest_finish(b[..],0) && b[0].c[0].uses[RS_USE_WIND]==0;
  b[0].clock=3607; b[0].rest_clock.ticks=3607000000; #assert rs_short_rest_finish(b[..],0) && b[0].c[0].rest.phase==2;
  #assert b[0].c[0].uses[RS_USE_WIND]==1 && b[0].c[0].uses[RS_USE_SURGE]==1;
  #assert !rs_short_rest_finish(b[..],0) && b[0].c[0].uses[RS_USE_WIND]==1;
  #assert b[0].who==1 && b[0].turn.action && b[0].turn.bonus && b[0].turn.slot_spent && b[0].turn.move_left==2 && b[0].c[0].reacted;
  e:=rs_recent_at(b[0].book[..],0);
  #assert e.by==0 && e.to==0 && e.kind==RS_EV_END && e.amount==0 && e.spell == -1;
  #assert cast(string)e.text[0..<e.text_n]=="Resting finishes a Short Rest";
}

#test "the real battle clock completes only the resting actor and never heals without a chosen Hit Die" {
  b:[1]RsBattle; rt_field(b[..],RS_MONK,5); b[0].c[0].focus=0; b[0].c[0].hp=1; b[0].c[0].temp=7;
  #assert rs_short_rest_begin(b[..],0);
  rs_tick(b[..],3599); #assert b[0].c[0].focus==0 && b[0].c[0].rest.phase==1;
  rs_tick(b[..],1); #assert b[0].c[0].focus==5 && b[0].c[0].rest.phase==2;
  #assert b[0].c[0].hp==1 && b[0].c[0].temp==7 && b[0].c[1].rest.phase==0;
  b[0].c[0].focus=0; rs_tick(b[..],3600); #assert b[0].c[0].focus==0;
}

#test "all twelve level one to six class loadouts recover only their declared Short Rest banks" {
  for klass:0..<RS_CLASSES { if klass==RS_MONSTER { continue; } for level:1..<7 {
    b:[1]RsBattle; rt_field(b[..],klass,level);
    for u:0..<RS_USES { b[0].c[0].uses[u]=0; }
    for slot:1..<10 { b[0].c[0].slots[slot]=0; }
    b[0].c[0].focus=0; b[0].c[0].rages=0; b[0].c[0].hp=1;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000;
    #assert rs_short_rest_finish(b[..],0) && b[0].c[0].hp==1;
    #assert b[0].c[0].rages==(ifx klass==RS_BARBARIAN then 1 else 0);
    #assert b[0].c[0].focus==(ifx klass==RS_MONK then b[0].c[0].focus_max else 0);
    for u:0..<RS_USES {
      want:=0;
      if (klass==RS_CLERIC || klass==RS_PALADIN) && u==RS_USE_CHANNEL && b[0].c[0].uses_max[u]>0 { want=1; }
      if klass==RS_DRUID && u==RS_USE_WILD && level>=2 { want=1; }
      if klass==RS_FIGHTER && u==RS_USE_WIND { want=1; }
      if klass==RS_FIGHTER && u==RS_USE_SURGE { want=b[0].c[0].uses_max[u]; }
      if klass==RS_BARD && u==RS_USE_INSPIRE && level>=5 { want=b[0].c[0].uses_max[u]; }
      #assert b[0].c[0].uses[u]==want;
    }
    for slot:1..<10 { #assert b[0].c[0].slots[slot]==(ifx klass==RS_WARLOCK && slot<=5 then b[0].c[0].slots_max[slot] else 0); }
  } }
}

#test "class Hit Dice seed once and restarting or rejoining cannot refill spent dice" {
  sizes:=[13]int.[8,6,8,12,8,0,8,8,10,10,10,8,6];
  for klass:-1..<14 { for level:[4]int.[0,1,20,21] {
    c:[1]RsCreature; c[0].klass=klass; c[0].level=level; rs_rest_seed(c[..]);
    valid:=klass>=0 && klass<13 && klass!=5 && level>=1 && level<=20;
    #assert c[0].rest.die==(ifx valid then sizes[klass] else 0);
    #assert c[0].rest.dice==(ifx valid then level else 0) && c[0].rest.dice_max==c[0].rest.dice && c[0].rest.seeded;
    c[0].rest.dice=0; rs_rest_seed(c[..]); #assert c[0].rest.dice==0;
  } }
  b:[1]RsBattle; rt_field(b[..],RS_FIGHTER,2); b[0].c[0].hp=1;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  #assert rs_short_rest_hit_die(b[..],0).admitted && b[0].c[0].rest.dice==1;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=7200; b[0].rest_clock.ticks=7200000000; #assert rs_short_rest_finish(b[..],0);
  #assert b[0].c[0].rest.dice==1;
  copy:=b[0].c[0]; _:=rs_add(b[..],copy,5,5);
  #assert b[0].c[2].rest.dice==1 && b[0].c[2].rest.phase==0;
}

#test "Hit Dice are chosen one at a time with current Constitution minimum one and separate temporary HP" {
  b:[1]RsBattle; rt_field(b[..],RS_WIZARD,2); b[0].c[0].hp=1; b[0].c[0].temp=19;
  b[0].c[0].score[RS_CON]=1; #assert rs_short_rest_begin(b[..],0);
  rolls:=b[0].dice[0].rolled; #assert !rs_short_rest_hit_die(b[..],0).admitted && b[0].dice[0].rolled==rolls;
  b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  r:=rs_short_rest_hit_die(b[..],0);
  #assert r.admitted && r.roll==3 && r.modifier == -5 && r.healed==1 && b[0].c[0].hp==2 && b[0].c[0].rest.dice==1;
  b[0].c[0].score[RS_CON]=18; r=rs_short_rest_hit_die(b[..],0);
  #assert r.admitted && r.modifier==4 && r.healed==7 && b[0].c[0].hp==9 && b[0].c[0].rest.dice==0 && b[0].c[0].temp==19;
  #assert b[0].dice[0].rolled==rolls+2 && !rs_short_rest_hit_die(b[..],0).admitted;
}

#test "a spent Hit Die respects blocked healing and maximum HP without refunding its chosen die" {
  for blocked:0..<2 {
    b:[1]RsBattle; rt_field(b[..],RS_FIGHTER,1);
    if blocked==1 { b[0].c[0].hp=1; #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_NOHEAL,by=1,spell=-1,until=10000,save=-1}); }
    hp:=b[0].c[0].hp; #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    r:=rs_short_rest_hit_die(b[..],0);
    #assert r.admitted && r.healed==0 && b[0].c[0].hp==hp && b[0].c[0].rest.dice==0;
  }
}

#test "damage interrupts even through temporary HP while zero damage and failed strikes do not" {
  for amount:0..<2 {
    b:[1]RsBattle; rt_field(b[..],RS_MONK,2); b[0].c[0].focus=0; b[0].c[0].temp=10;
    #assert rs_short_rest_begin(b[..],0); rs_damage(b[..],1,0,amount,RS_FIRE,false,-1);
    #assert b[0].c[0].rest.phase==(ifx amount==0 then 1 else 0);
    b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0)==(amount==0);
    #assert b[0].c[0].focus==(ifx amount==0 then 2 else 0);
  }
}

#test "a completed rests Hit Dice choice ends on actual damage but never refunds its recovered resources" {
  b:[1]RsBattle; rt_field(b[..],RS_MONK,2); b[0].c[0].focus=0;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  rs_damage(b[..],1,0,1,RS_FIRE,false,-1);
  #assert b[0].c[0].rest.phase==0 && b[0].c[0].focus==2 && !rs_short_rest_hit_die(b[..],0).admitted;
}

#test "initiative admission ends a carried rest without replenishing its Hit Dice" {
  b:[1]RsBattle; rt_field(b[..],RS_ROGUE,2); #assert rs_short_rest_begin(b[..],0);
  c:=b[0].c[0]; c.rest.dice=1; _:=rs_add(b[..],c,5,5);
  #assert b[0].c[2].rest.phase==0 && b[0].c[2].rest.dice==1 && b[0].c[0].rest.phase==1;
}

#test "accepted leveled spells interrupt a rest while cantrips and refused requests preserve it" {
  for mode:0..<3 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,3); rs_start_turn(b[..],0);
    #assert rs_short_rest_begin(b[..],0);
    sp:=ifx mode==0 then SP_FIRE_BOLT else SP_RAY_OF_SICKNESS;
    if mode==2 { b[0].c[0].slots[1]=0; }
    #assert rs_cast(b[..],0,sp,ifx mode==0 then 0 else 1,4,3,1)==(mode!=2);
    #assert b[0].c[0].rest.phase==(ifx mode==1 then 0 else 1);
  }
}

#test "actual Shield interrupts only after accepted component and slot payment" {
  for allowed:0..<2 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,3); b[0].c[0].reacted=false;
    #assert rs_short_rest_begin(b[..],0); b[0].c[0].speech_blocked=allowed==0;
    #assert rs_shield(b[..],0)==(allowed==1);
    #assert b[0].c[0].rest.phase==(ifx allowed==1 then 0 else 1);
  }
}

#test "Arcane Recovery validates complete slot choices and studying the book before changing any slot" {
  b:[1]RsBattle; rt_field(b[..],RS_WIZARD,5); #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  b[0].c[0].slots[1]=0; b[0].c[0].slots[2]=0; b[0].c[0].slots[3]=0;
  pick:=[2]int.[2,1]; q:=RsRestSlots.{levels=pick[..]}; seq:=b[0].book[0].seq;
  #assert !rs_short_rest_slots(b[..],0,q) && !b[0].c[0].rest.recovery_used && b[0].book[0].seq==seq;
  q.spellbook=true; #assert rs_short_rest_slots(b[..],0,q) && b[0].c[0].slots[1]==1 && b[0].c[0].slots[2]==1 && b[0].c[0].slots[3]==0;
  #assert b[0].c[0].rest.recovery_used && !rs_short_rest_slots(b[..],0,q);
  #assert rs_short_rest_begin(b[..],0); b[0].clock=7200; b[0].rest_clock.ticks=7200000000; #assert rs_short_rest_finish(b[..],0);
  #assert !rs_short_rest_slots(b[..],0,q) && b[0].c[0].slots[2]==1;
}

#test "Natural Recovery belongs to the level six Land Druid and needs no Wizard book" {
  for level:5..<7 {
    b:[1]RsBattle; rt_field(b[..],RS_DRUID,level); b[0].c[0].slots[3]=0;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    pick:=[1]int.[3]; #assert rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[..]})==(level==6);
    #assert b[0].c[0].slots[3]==(ifx level==6 then 1 else 0);
    #assert b[0].c[0].natural_recovery==(level==6);
  }
}

#test "slot recovery refuses empty invalid over-budget and unexpended choices atomically" {
  for mode:0..<8 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,5); b[0].c[0].slots[1]=0; b[0].c[0].slots[2]=0;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    pick:=[4]int.[1,1,1,1]; n:=1;
    if mode==0 { n=0; } else if mode==1 { pick[0]=0; } else if mode==2 { pick[0] = -1; }
    else if mode==3 { pick[0]=6; } else if mode==4 { n=4; }
    else if mode==5 { pick[0]=3; }
    else if mode==6 { b[0].c[0].arcane_recovery=false; }
    else { b[0].c[0].rest.phase=0; }
    seq:=b[0].book[0].seq;
    #assert !rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[0..<n],spellbook=true});
    #assert b[0].c[0].slots[1]==0 && b[0].c[0].slots[2]==0 && !b[0].c[0].rest.recovery_used && b[0].book[0].seq==seq;
  }
}

#test "Sorcerous Restoration is an explicit once per Long Rest choice with floor half-level limits" {
  for level:4..<7 {
    b:[1]RsBattle; rt_field(b[..],RS_SORCERER,level); b[0].c[0].uses[RS_USE_SORCERY]=0;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    #assert !rs_short_rest_sorcery(b[..],0,0) && !rs_short_rest_sorcery(b[..],0,level/2+1);
    #assert rs_short_rest_sorcery(b[..],0,level/2)==(level>=5);
    #assert b[0].c[0].uses[RS_USE_SORCERY]==(ifx level>=5 then level/2 else 0);
    if level>=5 { #assert !rs_short_rest_sorcery(b[..],0,1) && b[0].c[0].rest.restoration_used; }
  }
}

#test "rest APIs refuse logical actor edges and borrowed reaction frames before writes or dice" {
  for bad:0..<4 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,5); i:=ifx bad==0 then -1 else ifx bad==1 then 2 else ifx bad==2 then 3 else 0;
    b[0].c[2]=b[0].c[0]; b[0].c[3]=b[0].c[0]; b[0].clock=3600; b[0].rest_clock.ticks=3600000000;
    if bad==3 { b[0].reaction_frame.on=true; }
    rolls:=b[0].dice[0].rolled; seq:=b[0].book[0].seq;
    #assert !rs_short_rest_begin(b[..],i);
    b[0].c[0].rest.phase=1; b[0].c[2].rest.phase=1; b[0].c[3].rest.phase=1;
    #assert !rs_short_rest_finish(b[..],i);
    b[0].c[0].rest.phase=2; b[0].c[2].rest.phase=2; b[0].c[3].rest.phase=2;
    #assert !rs_short_rest_hit_die(b[..],i).admitted;
    pick:=[1]int.[1]; #assert !rs_short_rest_slots(b[..],i,RsRestSlots.{levels=pick[..],spellbook=true});
    #assert !rs_short_rest_sorcery(b[..],i,1) && b[0].book[0].seq==seq && b[0].dice[0].rolled==rolls;
    #assert b[0].c[0].rest.dice==5 && !b[0].c[0].rest.recovery_used && !b[0].c[0].rest.restoration_used;
  }
}

#test "unliving zero-HP and reversed-clock rests cannot grant or consume recovery" {
  for mode:0..<4 {
    b:[1]RsBattle; rt_field(b[..],RS_MONK,2); b[0].c[0].focus=0;
    if mode==0 { b[0].c[0].dead=true; } else if mode==1 { b[0].c[0].hp=0; }
    else if mode==2 { b[0].clock = -1; } else { b[0].clock=7; b[0].rest_clock.ticks=7000000; }
    if mode<3 { #assert !rs_short_rest_begin(b[..],0); }
    else { #assert rs_short_rest_begin(b[..],0); b[0].clock=6; b[0].rest_clock.ticks=6000000; #assert !rs_short_rest_finish(b[..],0); }
    b[0].c[0].rest.phase=1; b[0].c[0].rest.started=0;
    if mode<2 { b[0].clock=3600; b[0].rest_clock.ticks=3600000000; }
    #assert !rs_short_rest_finish(b[..],0) && b[0].c[0].focus==0;
    b[0].c[0].rest.phase=2;
    if mode<2 { #assert !rs_short_rest_hit_die(b[..],0).admitted; }
  }
}

#test "a real attack or Dash ends downtime only after its own admission" {
  for mode:0..<3 {
    b:[1]RsBattle; rt_field(b[..],RS_FIGHTER,3); rs_start_turn(b[..],0);
    #assert rs_short_rest_begin(b[..],0);
    if mode==0 { b[0].turn.action=true; #assert !rs_dash(b[..],0) && b[0].c[0].rest.phase==1; }
    else if mode==1 { #assert rs_dash(b[..],0) && b[0].c[0].rest.phase==0; }
    else { b[0].c[1].ac=100; #assert rs_attack(b[..],0,1,false,-1) && b[0].c[0].rest.phase==0; }
  }
}

#test "a whole Short Rest cannot retain Rage or refill daily Warlock Arcanum or free-cast banks" {
  b:[1]RsBattle; rt_field(b[..],RS_BARBARIAN,3); b[0].c[0].raging=true;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0) && !b[0].c[0].raging;
  c:[1]RsCreature; c[0]=rs_warlock("Warlock",0,17,SP_ELDRITCH_BLAST);
  c[0].slots[5]=0; c[0].slots[6]=0; c[0].slots[9]=0; c[0].uses_max[RS_USE_FREE]=1;
  rs_short_rest_resources(c[..]);
  #assert c[0].slots[5]==4 && c[0].slots[6]==0 && c[0].slots[9]==0 && c[0].uses[RS_USE_FREE]==0;
}

#test "optional rest recovery refuses malformed resource bounds and unsupported feature provenance" {
  for mode:0..<8 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,6); b[0].c[0].slots[1]=0;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    if mode==0 { b[0].c[0].slots[1] = -1; }
    else if mode==1 { b[0].c[0].slots_max[1] = -2147483648; b[0].c[0].slots[1]=1; }
    else if mode==2 { b[0].c[0].klass=RS_DRUID; b[0].c[0].natural_recovery=false; }
    else if mode==3 { b[0].c[0].level=0; }
    else if mode==4 { b[0].c[0].level=21; }
    else if mode==5 { b[0].c[0].klass=RS_DRUID; b[0].c[0].natural_recovery=true; b[0].c[0].level=5; }
    else if mode==6 { b[0].c[0].klass=RS_ROGUE; b[0].c[0].natural_recovery=true; }
    else { b[0].c[0].klass=RS_ROGUE; }
    pick:=[1]int.[1]; #assert !rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[..],spellbook=true}) && !b[0].c[0].rest.recovery_used;
  }
  for mode:0..<5 {
    b:[1]RsBattle; rt_field(b[..],RS_SORCERER,5); b[0].c[0].uses[RS_USE_SORCERY]=0;
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    if mode==0 { b[0].c[0].uses[RS_USE_SORCERY] = -1; }
    else if mode==1 { b[0].c[0].uses_max[RS_USE_SORCERY] = -2147483648; b[0].c[0].uses[RS_USE_SORCERY]=1; }
    else if mode==2 { b[0].c[0].uses[RS_USE_SORCERY]=5; }
    else if mode==3 { b[0].c[0].restoration=false; }
    else { b[0].c[0].klass=RS_ROGUE; }
    #assert !rs_short_rest_sorcery(b[..],0,1) && !b[0].c[0].rest.restoration_used;
  }
}

#test "borrowed actors seed fresh Hit Dice when rest starts and report the actual begin and die events" {
  b:[1]RsBattle; c:[1]RsCreature; b[0].c=c[..]; b[0].n=1; b[0].who = -1; b[0].dice[0].fixed=true;
  c[0]=rs_wizard("Reader",0,1); c[0].hp=1;
  #assert !c[0].rest.seeded && rs_short_rest_begin(b[..],0) && c[0].rest.seeded && c[0].rest.dice==1;
  e:=rs_recent_at(b[0].book[..],0);
  #assert e.kind==RS_EV_CONDITION && e.by==0 && e.to==0 && e.amount==0 && e.spell == -1 && cast(string)e.text[0..<e.text_n]=="Reader starts a Short Rest";
  b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  r:=rs_short_rest_hit_die(b[..],0); e=rs_recent_at(b[0].book[..],0);
  #assert r.admitted && e.kind==RS_EV_HEAL && e.by==0 && e.to==0 && e.amount==r.healed && e.spell == -1 && cast(string)e.text[0..<e.text_n]=="Reader spends a Hit Die";
  c[0].rest.dice=1; c[0].rest.die=0; rolls:=b[0].dice[0].rolled;
  #assert !rs_short_rest_hit_die(b[..],0).admitted && b[0].dice[0].rolled==rolls && c[0].rest.dice==1;
}

#test "source recovery modes stay distinct even when a particular preset has no uses of that bank" {
  modes:[13][RS_USES]int;
  modes[RS_CLERIC][RS_USE_CHANNEL]=1; modes[RS_PALADIN][RS_USE_CHANNEL]=1; modes[RS_DRUID][RS_USE_WILD]=1;
  modes[RS_FIGHTER][RS_USE_WIND]=1; modes[RS_FIGHTER][RS_USE_SURGE]=2; modes[RS_BARD][RS_USE_INSPIRE]=2;
  for klass:0..<RS_CLASSES { for level:4..<6 { for font:0..<2 {
    c:RsCreature; c.klass=klass; c.level=level; c.font=font==1;
    for u:0..<RS_USES {
      expected:=modes[klass][u];
      if klass==RS_BARD && (level==4 || font==0) { expected=0; }
      #assert rs_short_rest_mode(c,u)==expected;
    }
  } } }
}

#test "untracked Dash binds its old walking allowance before adding another full current Speed" {
  b:[1]RsBattle; rt_field(b[..],RS_FIGHTER,3); b[0].who=0; b[0].c[0].speed=37;
  b[0].turn.move_left=3; b[0].turn.move_feet=2; #assert !b[0].turn.move_tracked;
  #assert rs_short_rest_begin(b[..],0) && rs_dash(b[..],0);
  #assert b[0].turn.move_left==10 && b[0].turn.move_feet==4 && b[0].turn.move_basis==74 && b[0].turn.dash_n==1 && b[0].turn.move_tracked && b[0].c[0].rest.phase==0;
}

#test "slot recovery rounds up all legal source levels and admits exactly full low or fifth-level budgets" {
  c:RsCreature; c.klass=RS_WIZARD; c.arcane_recovery=true;
  for level:1..<21 { c.level=level; #assert rs_rest_slot_budget(c,true)==(level+1)/2; }
  for mode:0..<2 {
    b:[1]RsBattle; rt_field(b[..],RS_WIZARD,ifx mode==0 then 5 else 10);
    pick:=[3]int.[1,1,1]; n:=3;
    if mode==0 { b[0].c[0].slots[1]=1; }
    else { pick[0]=5; n=1; b[0].c[0].slots_max[5]=2; b[0].c[0].slots[5]=1; }
    #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
    #assert rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[0..<n],spellbook=true});
    e:=rs_recent_at(b[0].book[..],0);
    #assert e.kind==RS_EV_FEAT && e.by==0 && e.to==0 && e.amount==(ifx mode==0 then 3 else 5) && e.spell == -1 && cast(string)e.text[0..<e.text_n]=="Resting uses Arcane Recovery";
    if mode==0 { #assert b[0].c[0].slots[1]==4; } else { #assert b[0].c[0].slots[5]==2; }
  }
}

#test "weighted slot recovery cannot buy two second-level slots with a three-level budget" {
  b:[1]RsBattle; rt_field(b[..],RS_WIZARD,5); b[0].c[0].slots[2]=0;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  pick:=[2]int.[2,2]; seq:=b[0].book[0].seq;
  #assert !rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[..],spellbook=true});
  #assert b[0].c[0].slots[2]==0 && !b[0].c[0].rest.recovery_used && b[0].book[0].seq==seq;
}

#test "Natural Recovery and a chosen single Sorcery Point publish their actual recovered amount" {
  b:[1]RsBattle; rt_field(b[..],RS_DRUID,6); b[0].c[0].slots[3]=0;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  pick:=[1]int.[3]; #assert rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[..]});
  e:=rs_recent_at(b[0].book[..],0);
  #assert e.kind==RS_EV_FEAT && e.by==0 && e.to==0 && e.amount==3 && e.spell == -1 && cast(string)e.text[0..<e.text_n]=="Resting uses Natural Recovery";
  b[0].c[0]=rs_sorcerer("Sorcerer",0,5); b[0].c[0].uses[RS_USE_SORCERY]=4;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=7200; b[0].rest_clock.ticks=7200000000; #assert rs_short_rest_finish(b[..],0);
  #assert rs_short_rest_sorcery(b[..],0,1) && b[0].c[0].uses[RS_USE_SORCERY]==5;
  e=rs_recent_at(b[0].book[..],0);
  #assert e.kind==RS_EV_FEAT && e.by==0 && e.to==0 && e.amount==1 && e.spell == -1 && cast(string)e.text[0..<e.text_n]=="Sorcerer uses Sorcerous Restoration";
}

#test "zero-capacity resource banks cannot be manufactured by a rest recovery choice" {
  b:[1]RsBattle; rt_field(b[..],RS_WIZARD,5); b[0].c[0].slots_max[1]=0; b[0].c[0].slots[1]=0;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=3600; b[0].rest_clock.ticks=3600000000; #assert rs_short_rest_finish(b[..],0);
  pick:=[1]int.[1]; #assert !rs_short_rest_slots(b[..],0,RsRestSlots.{levels=pick[..],spellbook=true});
  b[0].c[0]=rs_sorcerer("Sorcerer",0,5); b[0].c[0].uses_max[RS_USE_SORCERY]=0; b[0].c[0].uses[RS_USE_SORCERY]=0;
  #assert rs_short_rest_begin(b[..],0); b[0].clock=7200; b[0].rest_clock.ticks=7200000000; #assert rs_short_rest_finish(b[..],0);
  #assert !rs_short_rest_sorcery(b[..],0,1);
}

#test "Short Rest resource reads and writes belong to the first actor of its admitted view" {
  c:[2]RsCreature; c[0]=rs_barbarian("Resting",0,3); c[1]=rs_barbarian("Other",1,6);
  c[0].rages=1; rs_short_rest_resources(c[..]);
  #assert c[0].rages==2 && c[1].rages==4;
  c[0]=rs_monk("Resting",0,5); c[1]=rs_monk("Other",1,6); c[0].focus=2;
  rs_short_rest_resources(c[..]); #assert c[0].focus==5 && c[1].focus==6;
}

rt_field :: (b:[]RsBattle,klass:int,level:int) {
  b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b,rt_class(klass,level),3,3); _=rs_add(b,rs_guard("Other",1),4,3);
  b[0].who=1;
}
rt_class :: (klass:int,level:int)->RsCreature {
  if klass==RS_DRUID { return rs_druid("Resting",0,level); }
  if klass==RS_WIZARD { return rs_wizard("Resting",0,level); }
  if klass==RS_WARLOCK { return rs_warlock("Resting",0,level,SP_ELDRITCH_BLAST); }
  if klass==RS_BARBARIAN { return rs_barbarian("Resting",0,level); }
  if klass==RS_MONK { return rs_monk("Resting",0,level); }
  if klass==RS_BARD { return rs_bard("Resting",0,level); }
  if klass==RS_CLERIC { return rs_cleric("Resting",0,level); }
  if klass==RS_FIGHTER { return rs_fighter("Resting",0,level); }
  if klass==RS_PALADIN { return rs_paladin("Resting",0,level); }
  if klass==RS_RANGER { return rs_ranger("Resting",0,level); }
  if klass==RS_ROGUE { return rs_rogue("Resting",0,level); }
  return rs_sorcerer("Resting",0,level);
}
