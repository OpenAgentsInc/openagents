// Inflict Wounds, Acid Splash, Magic Missile and Mass Healing Word (#13043):
// records against the pinned source, and their effects through the shared
// battle with fixed dice (every die lands on half its faces: d4 2, d6 3,
// d10 5, d20 10), so each expected number is read from the SRD text.
//   coax/bin/coax test --library aethyr/rules/srd/slice-spells-checks.coax
#load "battle.coax";
#load "catalog.coax";
#load "executable-source-ids.coax";

sl_learn :: (b: [] RsBattle, i: int, sp: int) { keys := [1] int.[RS_EXEC_SOURCE[sp]]; #assert rs_set_spells(b[0].c[i..<i+1],keys[..]); }
sl_sturdy :: (b: [] RsBattle, j: int, con: int, dex: int) {
  b[0].c[j].hp = 200; b[0].c[j].hp_max = 200; b[0].c[j].score[RS_CON] = con; b[0].c[j].score[RS_DEX] = dex;
  b[0].c[j].shield_spell = false;   // the preset Sorcerer knows Shield; a plain target here does not
}

#test "the four slice records carry their pinned source level, timing, range, components, page and classes" #steps 100000000 {
  for sp: [4] int.[SP_INFLICT_WOUNDS,SP_ACID_SPLASH,SP_MAGIC_MISSILE,SP_MASS_HEALING_WORD] {
    s := rs_spell(sp); src := srd_source_lookup(s.id);
    #assert s.srd && s.part_of < 0 && s.step_n > 0 && rs_executable_spell(sp);
    #assert s.level == src.level && s.page == src.page && s.components == src.components;
    #assert s.concentration == src.concentration && s.cast_time == src.cast_kind;
    #assert s.range_ft == (ifx src.range_kind == 1 then 5 else src.range_value);
    #assert RS_EXECUTABLE_SOURCE_IDS[sp] == s.id && RS_SPELL_KEYS[RS_EXEC_SOURCE[sp]].id == s.id;
  }
  #assert RS_SPELL_KEYS[RS_KEY_MAGIC_MISSILE].id == rs_spell(SP_MAGIC_MISSILE).id;
}

#test "Inflict Wounds: touch, Con save for half of 2d10 Necrotic, one more d10 a slot level" {
  for slot: [2] int.[1,2] { for strong: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_cleric("Cleric",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),2,1);
    sl_learn(b[..],a,SP_INFLICT_WOUNDS); sl_sturdy(b[..],t,ifx strong == 1 then 30 else 1,10);
    rs_start_turn(b[..],a); slots := b[0].c[a].slots[slot];
    #assert rs_cast(b[..],a,SP_INFLICT_WOUNDS,slot,0,0,t);
    full := 5 * (2 + slot - 1);
    #assert 200 - b[0].c[t].hp == (ifx strong == 1 then full / 2 else full);
    #assert b[0].c[a].slots[slot] == slots - 1 && b[0].turn.action;
  } }
  // Out of touch reach: refused before anything is spent.
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Cleric",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),4,1);
  sl_learn(b[..],a,SP_INFLICT_WOUNDS); rs_start_turn(b[..],a);
  slots := b[0].c[a].slots[1]; hp := b[0].c[t].hp; rolls := b[0].dice[0].rolled;
  #assert !rs_cast(b[..],a,SP_INFLICT_WOUNDS,1,0,0,t);
  #assert b[0].c[a].slots[1] == slots && b[0].c[t].hp == hp && b[0].dice[0].rolled == rolls && !b[0].turn.action;
}

#test "Acid Splash: a Dex save or 1d6 Acid to each creature in the 5-foot Sphere, growing with the caster's level" {
  for level: [2] int.[1,5] { for nimble: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 10; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,level),1,1);
    t := rs_add(b[..],rs_sorcerer("Centre",1,3),8,4); u := rs_add(b[..],rs_sorcerer("Beside",1,3),9,4);
    far := rs_add(b[..],rs_sorcerer("Outside",1,3),12,4);
    for j: [3] int.[t,u,far] { sl_sturdy(b[..],j,10,ifx nimble == 1 then 30 else 1); }
    sl_learn(b[..],a,SP_ACID_SPLASH); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,SP_ACID_SPLASH,0,8,4,-1);
    full := 3 * (ifx level >= 5 then 2 else 1);
    // The level 5 preset is an Evoker: Potent Cantrip (level 3) halves a saved cantrip's damage.
    dealt := ifx nimble == 0 then full else ifx b[0].c[a].potent then full / 2 else 0;
    #assert 200 - b[0].c[t].hp == dealt && 200 - b[0].c[u].hp == dealt && b[0].c[far].hp == 200;
  } }
  // A point beyond 60 feet is refused.
  b: [1] RsBattle; b[0].w = 40; b[0].h = 4; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_wizard("Wizard",0,1),0,1); sl_learn(b[..],a,SP_ACID_SPLASH); rs_start_turn(b[..],a);
  #assert !rs_cast(b[..],a,SP_ACID_SPLASH,0,13,1,-1) && !b[0].turn.action;
}

#test "Magic Missile: three darts of 1d4 + 1 Force that never miss, one more a slot level, split as chosen" {
  for slot: [2] int.[1,2] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),10,1);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10); b[0].c[t].ac = 30;
    rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_MAGIC_MISSILE,slot,0,0,t);
    #assert 200 - b[0].c[t].hp == 3 * (3 + slot - 1);
  }
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1);
  t := rs_add(b[..],rs_sorcerer("One",1,3),10,1); u := rs_add(b[..],rs_sorcerer("Two",1,3),11,2);
  sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10); sl_sturdy(b[..],u,10,10);
  rs_start_turn(b[..],a); picks := [3] int.[t,u,u];
  #assert rs_cast_creatures(b[..],a,SP_MAGIC_MISSILE,1,picks[..],false);
  #assert 200 - b[0].c[t].hp == 3 && 200 - b[0].c[u].hp == 6;
  // A fourth dart needs a 2nd-level slot; with a 1st it is refused before spending.
  b2: [1] RsBattle; b2[0].w = 30; b2[0].h = 8; b2[0].dice[0].fixed = true;
  a2 := rs_add(b2[..],rs_wizard("Wizard",0,3),1,1); t2 := rs_add(b2[..],rs_sorcerer("One",1,3),10,1);
  sl_learn(b2[..],a2,SP_MAGIC_MISSILE); rs_start_turn(b2[..],a2); slots := b2[0].c[a2].slots[1];
  four := [4] int.[t2,t2,t2,t2];
  #assert !rs_cast_creatures(b2[..],a2,SP_MAGIC_MISSILE,1,four[..],false) && b2[0].c[a2].slots[1] == slots;
}

#test "Shield answers Magic Missile once before the darts and then takes none of them" {
  for warded: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Warded",1,3),10,1);
    other := rs_add(b[..],rs_sorcerer("Open",1,3),11,1);
    sl_sturdy(b[..],t,10,10); sl_sturdy(b[..],other,10,10);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_learn(b[..],t,SP_SHIELD); b[0].c[t].shield_spell = true;
    if warded == 1 { rs_shield_begin(b[0].c[t..<t+1]); b[0].c[t].reacted = true; }
    slots := b[0].c[t].slots[1];
    rs_start_turn(b[..],a); picks := [3] int.[t,t,other];
    #assert rs_cast_creatures(b[..],a,SP_MAGIC_MISSILE,1,picks[..],false);
    #assert b[0].c[t].hp == 200 && b[0].c[t].shield_active && 200 - b[0].c[other].hp == 3;
    // One Reaction and one slot when it reacted; none when Shield was already up.
    #assert b[0].c[t].slots[1] == (ifx warded == 1 then slots else slots - 1) && b[0].c[t].reacted;
  }
  // Without Shield prepared, or with its Reaction spent, every dart lands.
  for spent: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),10,1);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10);
    if spent == 1 { sl_learn(b[..],t,SP_SHIELD); b[0].c[t].shield_spell = true; b[0].c[t].reacted = true; }
    rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_MAGIC_MISSILE,1,0,0,t);
    #assert 200 - b[0].c[t].hp == 9 && !b[0].c[t].shield_active;
  }
}

#test "Mass Healing Word: a Bonus Action healing up to six chosen creatures 2d4 + modifier, 1d4 more a slot level" {
  // A Bard caster: the preset Cleric's Disciple of Life would add its own healing.
  for slot: [2] int.[3,4] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_bard("Bard",0,5),1,1);
    // The preset slot table stops at level 6 (the slice); grant the 4th-level slot directly.
    b[0].c[a].slots_max[4] = 1; b[0].c[a].slots[4] = 1;
    picks: [6] int;
    for k: 0..<6 { picks[k] = rs_add(b[..],rs_druid("Ally",0,3),2 + k,2); b[0].c[picks[k]].hp = 1; }
    sl_learn(b[..],a,SP_MASS_HEALING_WORD); rs_start_turn(b[..],a); slots := b[0].c[a].slots[slot];
    #assert rs_cast_creatures(b[..],a,SP_MASS_HEALING_WORD,slot,picks[..],false);
    heal := 2 * (2 + slot - 3) + rs_mod(b[0].c[a].score[RS_CHA]);
    for k: 0..<6 { #assert b[0].c[picks[k]].hp == 1 + heal; }
    #assert b[0].turn.bonus && !b[0].turn.action && b[0].c[a].slots[slot] == slots - 1;
  }
  // A seventh creature is refused before anything is spent.
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_bard("Bard",0,5),1,1);
  seven: [7] int;
  for k: 0..<7 { seven[k] = rs_add(b[..],rs_druid("Ally",0,3),2 + k,2); b[0].c[seven[k]].hp = 1; }
  sl_learn(b[..],a,SP_MASS_HEALING_WORD); rs_start_turn(b[..],a); slots := b[0].c[a].slots[3];
  #assert !rs_cast_creatures(b[..],a,SP_MASS_HEALING_WORD,3,seven[..],false);
  #assert b[0].c[a].slots[3] == slots && !b[0].turn.bonus && b[0].c[seven[0]].hp == 1;
}
