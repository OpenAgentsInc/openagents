// Class eligibility and explicit always-prepared/extra-list grants. Eligibility is necessary,
// not sufficient: prepared/known selection is a separate casting requirement.
// Loaded with engine.coax; spell records are supplied by the containing entry.
#authority;
#load "cast-request.coax";
#load "spell-state-policy.coax";

#test "class membership compares whole comma-separated class names" {
  #assert rs_class_spell("Bard, Druid", RS_BARD) && rs_class_spell("Bard, Druid", RS_DRUID);
  #assert !rs_class_spell("Bard, Druid", RS_CLERIC) && !rs_class_spell("Druid (Everglade)", RS_DRUID);
  #assert !rs_class_spell("", RS_DRUID) && !rs_class_spell("Wizard", -1) && !rs_class_spell("Wizard", 13);
  #assert !rs_class_spell("Monster", RS_MONSTER);
  for k: 0..<RS_CLASS.count {
    #assert rs_class_spell(" Wizard,, Druid, Bard", k) == (k == RS_WIZARD || k == RS_DRUID || k == RS_BARD);
    #assert rs_class_spell(RS_CLASS[k], k) == (k != RS_MONSTER);
  }
}
#test "explicit grants are bounded, creature-local and inherit through spell helpers" {
  c: [1] RsCreature; c[0].klass = RS_MONSTER; c[0].spell_ability = -1;
  #assert !rs_spell_access(c[0], SP_CALL_BOLT) && !rs_grant_spell(c[..], -1) && !rs_grant_spell(c[..], RS_MORE_END);
  #assert !rs_grant_spell(c[..], 104) && !rs_spell_access(c[0], -1);
  #assert !rs_grant_spell(c[..], SP_CALL_BOLT);
  #assert !rs_grant_spell(c[..], SP_FLAME_HURL);
  #assert rs_grant_spell(c[..], SP_CALL_LIGHTNING) && rs_spell_access(c[0], SP_CALL_BOLT);
  #assert rs_grant_spell(c[..], SP_PRODUCE_FLAME) && rs_spell_access(c[0], SP_FLAME_HURL);
  #assert rs_grant_spell(c[..], SP_CREATE_WATER) && rs_spell_access(c[0], SP_CREATE_WATER);
  #assert rs_grant_spell(c[..], SP_CALL_LIGHTNING) && rs_grant_spell(c[..], SP_EG_METEOR_SWARM);
  #assert rs_spell_access(c[0], SP_EG_METEOR_SWARM) && !rs_spell_access(c[0], SP_THUNDERBOLT);
  #assert !rs_spell_access(c[0], SP_CURE_WOUNDS);
  other: RsCreature; other.klass = RS_MONSTER; other.spell_ability = -1;
  #assert !rs_spell_access(other, SP_CALL_LIGHTNING);
  boundary: [1] RsCreature; boundary[0].klass = RS_MONSTER; boundary[0].spell_ability = -1;
  #assert rs_grant_spell(boundary[..], SP_CREATE_WATER) && rs_spell_access(boundary[0], SP_CREATE_WATER);
  #assert !rs_spell_access(boundary[0], SP_PRODUCE_FLAME);
}
#test "ordinary class access cannot infer house grants or spellcasting from slots" {
  c := rs_druid("Druid", 0, 3);
  #assert rs_spell_access(c, SP_ENTANGLE) && !rs_spell_access(c, SP_GUIDING_BOLT);
  #assert !rs_spell_access(c, SP_WATER_ORB);
  c.spell_ability = -1; #assert !rs_spell_access(c, SP_ENTANGLE);
  c.spell_ability = RS_STR; #assert rs_spell_access(c, SP_ENTANGLE);
}
#test "Fiendish Vigor grants only its spell to a level two or higher Warlock who chose it" {
  for level: 1..<4 {
    for chosen: 0..<2 {
      c := rs_warlock("Warlock", 0, level, SP_ELDRITCH_BLAST); c.vigor = chosen == 1;
      #assert rs_spell_access(c, SP_FALSE_LIFE) == (level >= 2 && chosen == 1);
      #assert !rs_spell_access(c, SP_CURE_WOUNDS);
    }
  }
  c := rs_druid("Druid", 0, 3); c.vigor = true;
  #assert !rs_spell_access(c, SP_FALSE_LIFE) && !rs_spell_access(c, SP_GUIDING_BOLT);
}
#test "preset extra-list spell grants appear at their source feature levels" {
  for level: 1..<10 {
    w := rs_warlock("Warlock", 0, level, SP_ELDRITCH_BLAST);
    #assert rs_spell_access(w, SP_SCORCHING_RAY) == (level >= 3);
    #assert rs_spell_access(w, SP_COMMAND) == (level >= 3);
    #assert rs_spell_access(w, SP_BURNING_HANDS) == (level >= 3);
    #assert rs_spell_access(w, SP_FIREBALL) == (level >= 5) && !rs_spell_access(w, SP_BLINDNESS);
    #assert rs_spell_access(w, SP_WALL_OF_FIRE) == (level >= 7);
    #assert rs_spell_access(rs_druid("Druid", 0, level), SP_RAY_OF_FROST) == (level >= 3);
    #assert rs_spell_access(rs_bard("Bard", 0, level), SP_SPIRIT_GUARDIANS) == (level >= 6);
    #assert rs_spell_access(rs_bard("Bard", 0, level), SP_FIREBALL) == (level >= 6);
    #assert rs_spell_access(rs_paladin("Paladin", 0, level), SP_SACRED_FLAME) == (level >= 2);
    #assert rs_spell_access(rs_sorcerer("Sorcerer", 0, level), SP_COMMAND) == (level >= 3);
  }
  mage := rs_mage("Mage", 0); priest := rs_priest("Priest", 0); fanatic := rs_fanatic("Fanatic", 0);
  #assert rs_spell_access(mage, SP_FIREBALL) && !rs_spell_access(mage, SP_ENTANGLE);
  #assert rs_spell_access(priest, SP_HEALING_WORD) && !rs_spell_access(priest, SP_FIREBALL);
  #assert rs_spell_access(fanatic, SP_HOLD_PERSON) && !rs_spell_access(fanatic, SP_FIREBALL);
}

#test "always-prepared and arcanum grants remain distinct from ordinary class eligibility" {
  for level: 1..<15 {
    d := rs_druid("Druid", 0, level);
    #assert rs_spell_granted(d, SP_FOG_CLOUD) == (level >= 3) && rs_spell_granted(d, SP_HOLD_PERSON) == (level >= 3);
    #assert rs_spell_granted(d, SP_SLEET_STORM) == (level >= 5);
    p := rs_paladin("Paladin", 0, level);
    #assert rs_spell_granted(p, SP_DIVINE_SMITE) == (level >= 2);
    #assert rs_spell_granted(p, SP_SHIELD_OF_FAITH) == (level >= 3);
    c := rs_cleric("Cleric", 0, level);
    #assert rs_spell_granted(c, SP_BLESS) == (level >= 3) && rs_spell_granted(c, SP_CURE_WOUNDS) == (level >= 3);
    #assert rs_spell_granted(rs_ranger("Ranger", 0, level), SP_HUNTERS_MARK);
    w := rs_warlock("Warlock", 0, level, SP_ELDRITCH_BLAST);
    #assert rs_spell_granted(w, SP_CIRCLE_OF_DEATH) == (level >= 11);
    #assert rs_spell_granted(w, SP_FINGER_OF_DEATH) == (level >= 13);
  }
  w := rs_wizard("Wizard", 0, 3);
  #assert !rs_spell_granted(w, SP_HUNTERS_MARK) && !rs_spell_granted(w, -1);
}

#test "class-owned grants remain distinct from world grants including helper aliases and malformed requests" {
  c: [1] RsCreature; c[0].klass=RS_DRUID;
  for sp: [6] int.[-1,RS_MORE_END,99,104,1000,1] {
    #assert !rs_grant_class_spell(c[..],sp);
    for word: c[0].class_spell_grants { #assert word==0; }
  }
  #assert rs_grant_spell(c[..],SP_FIREBALL) && !rs_class_spell_granted(c[0],SP_FIREBALL);
  #assert rs_grant_class_spell(c[..],SP_PRODUCE_FLAME) && rs_class_spell_granted(c[0],1);
  #assert rs_grant_class_spell(c[..],SP_COMMAND) && rs_class_spell_granted(c[0],SP_COMMAND);
  #assert rs_grant_class_spell(c[..],64) && rs_class_spell_granted(c[0],64) && !rs_class_spell_granted(c[0],65);
  #assert !rs_class_spell_granted(c[0],-1) && !rs_class_spell_granted(c[0],RS_MORE_END);
  for level: 1..<3 { for klass: [2] int.[RS_DRUID,RS_WARLOCK] {
    v: RsCreature; v.klass=klass; v.level=level; v.vigor=true;
    #assert rs_class_spell_granted(v,SP_FALSE_LIFE)==(level==2 && klass==RS_WARLOCK);
  } }
  edge: [1] RsCreature;
  #assert rs_grant_class_spell(edge[..],64) && edge[0].class_spell_grants[0]==0 && edge[0].class_spell_grants[1]==1;
  #assert rs_class_spell_granted(edge[0],64) && !rs_class_spell_granted(edge[0],65);
}

// Only these constructors' declared subclass/style/discovery selections use
// this helper. Raw rs_hero and world-defined characters gain no preset choices.
rs_preset_spell_grants :: (c: [] RsCreature) #effects(all) {
  level := c[0].level;
  if c[0].klass == RS_DRUID {
    // Druidic, p.42: Speak with Animals always prepared.
    { _ := rs_grant_class_spell(c, SP_SPEAK_WITH_ANIMALS); }
    // Circle of the Land polar spells, p.46. Base-list entries are included
    // because always-prepared grants do not consume ordinary selections.
    if level >= 3 { _ := rs_grant_class_spell(c, SP_RAY_OF_FROST); }
    if level >= 3 { _ := rs_grant_class_spell(c, SP_FOG_CLOUD); _ = rs_grant_class_spell(c, SP_HOLD_PERSON); }
    if level >= 5 { _ := rs_grant_class_spell(c, SP_SLEET_STORM); }
  } else if c[0].klass == RS_WARLOCK {
    // Fiend Spells, p.75. Unimplemented source spells are not granted IDs.
    if level >= 3 {
      _ := rs_grant_class_spell(c, SP_BURNING_HANDS); _ = rs_grant_class_spell(c, SP_SCORCHING_RAY); _ = rs_grant_class_spell(c, SP_COMMAND);
    }
    if level >= 5 { _ := rs_grant_class_spell(c, SP_FIREBALL); }
    if level >= 7 { _ := rs_grant_class_spell(c, SP_WALL_OF_FIRE); }
    // The existing high-level preset chooses these Mystic Arcanum spells.
    if level >= 11 { _ := rs_grant_class_spell(c, SP_CIRCLE_OF_DEATH); }
    if level >= 13 { _ := rs_grant_class_spell(c, SP_FINGER_OF_DEATH); }
  } else if c[0].klass == RS_BARD {
    // This Lore Bard chooses Fireball and Spirit Guardians at level 6, p.35.
    if level >= 6 { _ := rs_grant_class_spell(c, SP_FIREBALL); _ = rs_grant_class_spell(c, SP_SPIRIT_GUARDIANS); }
  } else if c[0].klass == RS_PALADIN {
    // Blessed Warrior's chosen Sacred Flame, p.54.
    if level >= 2 { _ := rs_grant_class_spell(c, SP_SACRED_FLAME); }
    if level >= 2 { _ := rs_grant_class_spell(c, SP_DIVINE_SMITE); }
    if level >= 3 { _ := rs_grant_class_spell(c, SP_SHIELD_OF_FAITH); }
    if level >= 5 { _ := rs_grant_class_spell(c, SP_AID); }
  } else if c[0].klass == RS_SORCERER {
    // Draconic Spells, p.70.
    if level >= 3 { _ := rs_grant_class_spell(c, SP_COMMAND); }
  } else if c[0].klass == RS_CLERIC {
    // Life Domain Spells, p.40. Revivify still needs execution.
    if level >= 3 {
      _ := rs_grant_class_spell(c, SP_BLESS);
      _ = rs_grant_class_spell(c, SP_CURE_WOUNDS);
      _ = rs_grant_class_spell(c, SP_LESSER_RESTORATION);
      _ = rs_grant_class_spell(c, SP_AID);
    }
    if level >= 5 { _ := rs_grant_class_spell(c, SP_MASS_HEALING_WORD); }
  } else if c[0].klass == RS_RANGER {
    _ := rs_grant_class_spell(c, SP_HUNTERS_MARK);
  }
  rs_preset_spells(c);
}
#test "the Life Domain's level 5 Mass Healing Word arrives at Cleric level 5" {
  #assert !rs_class_spell_granted(rs_cleric("A", 0, 4), SP_MASS_HEALING_WORD) && rs_class_spell_granted(rs_cleric("A", 0, 5), SP_MASS_HEALING_WORD);
}

rs_class_spell :: (list: string, klass: int) -> bool #effects(all) {
  if klass < 0 || klass >= RS_CLASS.count || klass == RS_MONSTER { return false; }
  start := 0;
  for i: 0..<list.count + 1 {
    if i == list.count || list[i] == 44 {
      if list[start..<i] == RS_CLASS[klass] { return true; }
      start = i + 1;
    } else if i == start && list[i] == 32 { start += 1; }
  }
  return false;
}
rs_grant_spell :: (c: [] RsCreature, sp: int) -> bool #effects(all) {
  if !rs_executable_spell(sp) { return false; }
  if rs_spell(sp).part_of >= 0 { return false; }
  c[0].spell_grants[sp / 64] |= cast(u64) 1 << (sp % 64);
  return true;
}
rs_spell_access :: (c: RsCreature, sp: int) -> bool #effects(all) {
  if !rs_executable_spell(sp) { return false; }
  if rs_spell_granted(c, sp) { return true; }
  s := rs_spell(rs_spell_root(sp));
  return s.srd && c.spell_ability >= 0 && rs_class_spell(s.classes, c.klass);
}
rs_grant_class_spell :: (c: [] RsCreature, sp: int) -> bool #effects(all) {
  if !rs_grant_spell(c,sp) { return false; }
  c[0].class_spell_grants[sp/64] |= cast(u64) 1 << (sp%64);
  return true;
}
rs_class_spell_granted :: (c: RsCreature, sp: int) -> bool #effects(all) {
  if !rs_executable_spell(sp) { return false; }
  parent := rs_spell_root(sp);
  return (c.class_spell_grants[parent/64] & (cast(u64) 1 << (parent%64)))!=0 || (parent==SP_FALSE_LIFE && c.klass==RS_WARLOCK && c.level>=2 && c.vigor);
}
rs_spell_granted :: (c: RsCreature, sp: int) -> bool #effects(all) {
  return rs_spell_grant_has(c.klass,c.level,c.vigor,c.spell_grants,sp);
}
rs_spell_root :: (sp: int) -> int #effects(all) {
  helper := rs_spell(sp).part_of;
  return ifx helper >= 0 then helper else sp;
}
#test "Druidic: a Druid preset always has Speak with Animals prepared (p.42)" {
  c: [1] RsCreature; c[0].klass = RS_DRUID; c[0].level = 1;
  rs_preset_spell_grants(c[..]); #assert rs_class_spell_granted(c[0], SP_SPEAK_WITH_ANIMALS) && !rs_class_spell_granted(c[0], SP_HOLD_PERSON);
}
