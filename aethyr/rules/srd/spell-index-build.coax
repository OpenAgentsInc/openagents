// Compact projection for legal loadouts. No PDF or text catalog is needed at
// gameplay runtime. Usage: tool.sh this.coax (--out NEW_FILE | --check FILE).
#load "executable-source-ids.coax";
#load "catalog.coax";
#load "import-emit.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";

#test "loadout projection aliases helpers and legacy names without inventing source entries" {
  #assert ski_source(1) == srd_source_index("produce-flame");
  #assert ski_source(64) == srd_source_index("create-or-destroy-water");
  #assert ski_source(20) == srd_source_index("guiding-bolt");
  #assert ski_source(103) == -1 && ski_source(-1) == -1;
}
ski_source :: (sp: int) -> int {
  if sp < 0 || sp >= RS_EXECUTABLE_SOURCE_IDS.count { return -1; }
  return srd_source_index(RS_EXECUTABLE_SOURCE_IDS[sp]);
}
ski_components :: (s: SrdSourceSpell) -> int {
  return (ifx s.verbal then 1 else 0) | (ifx s.somatic then 2 else 0) | (ifx s.material then 4 else 0) | (ifx s.cost_text.count>0 then 8 else 0) | (ifx s.consumed then 16 else 0);
}
ski_emit :: (a: [] SiArena) -> bool {
  _ := si_store("// Generated by spell-index-build.coax from the pinned canonical catalog.\n// ", a);
  _ = si_store(SRD_ATTRIBUTION, a);
  _ = si_store("\n// Class masks come from the independent base class tables, not description headers.\n// Components: V=1, S=2, M=4, priced=8, consumed=16; from canonical source fields.\nRsSpellKey :: struct { id: string; level: int; classes: int; range_kind: int; component_mask: int; }\nRS_SPELL_KEY_PIN :: ", a);
  si_quote(SRD_SOURCE_PDF_SHA256, a);
  _ = si_store(";\nRS_SPELL_KEYS :: [", a); si_integer(SRD_SOURCE_SPELLS, a);
  _ = si_store("] RsSpellKey.[\n", a);
  for i: 0..<SRD_SOURCE_SPELLS {
    s := srd_source_spell(i); mask := 0;
    for r: SRD_SOURCE_CLASS_SPELLS { if r.spell == i { mask |= 1 << r.klass; } }
    _ = si_store("  RsSpellKey.{id = ", a); si_quote(s.id, a);
    _ = si_store(", level = ", a); si_integer(s.level, a);
    _ = si_store(", classes = ", a); si_integer(mask, a);
    _ = si_store(", range_kind = ", a); si_integer(s.range_kind, a);
    _ = si_store(", component_mask = ", a); si_integer(ski_components(s), a);
    _ = si_store(ifx i + 1 < SRD_SOURCE_SPELLS then "},\n" else "}\n", a);
  }
  _ = si_store("];\nRS_EXEC_SOURCE :: [", a); si_integer(RS_EXECUTABLE_SOURCE_IDS.count, a);
  _ = si_store("] int.[", a);
  for sp: 0..<RS_EXECUTABLE_SOURCE_IDS.count {
    key := ski_source(sp); if key < 0 { return false; }
    if sp > 0 { _ = si_store(", ", a); } si_integer(key, a);
  }
  _ = si_store("];\nRS_KEY_MAGE_ARMOR :: ", a); si_integer(srd_source_index("mage-armor"), a);
  _ = si_store(";\nRS_KEY_MAGIC_MISSILE :: ", a); si_integer(srd_source_index("magic-missile"), a);
  _ = si_store(";\nRS_KEY_BLESS :: ", a); si_integer(srd_source_index("bless"), a);
  _ = si_store(";\nRS_KEY_CIRCLE_OF_DEATH :: ", a); si_integer(srd_source_index("circle-of-death"), a);
  _ = si_store(";\n", a);
  return !a[0].error;
}
tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args[0].n != 2 { tool_errln("usage: spell-index-build (--out NEW_FILE | --check FILE)"); return 2; }
  mode := args_at(args[..], 0); path := args_at(args[..], 1);
  if mode != "--out" && mode != "--check" { return 2; }
  a: [1] SiArena; if !ski_emit(a[..]) { tool_errln("incomplete source projection"); return 1; }
  expected := cast(string) a[0].bytes[0..<a[0].n];
  if mode == "--check" {
    buf: [65536] u8; n := fs_read(path, buf[..]);
    if n < 0 || cast(string) buf[0..<n] != expected { tool_errln("stale or missing spell index"); return 1; }
    tool_errln("spell index matches pinned source and executable IDs"); return 0;
  }
  if fs_kind(path) != FS_NONE { tool_errln("refused: output already exists"); return 1; }
  return ifx fs_write(path, expected) then 0 else 1;
}
