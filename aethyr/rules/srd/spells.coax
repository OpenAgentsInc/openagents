// SRD 5.2.1 spells as records (docs/dnd/README.md, "SRD content: data, not code"). Each holds the
// SRD's fields and an effect program: a short list of typed steps from a closed set that
// battle.coax runs for any world, so no world codes a spell's numbers. The first records are
// low-level Druid, Wizard and Warlock spells; the import tool (aethyr/rules/srd/import.coax, planned) will generate
// every spell from the PDF in this shape. Texts are the SRD's, word for word.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test --library aethyr/rules/srd/spells.coax
#load "engine.coax";
// More records past the first RS_SPELLS: SRD spells a world needed (more.coax) and house rules,
// marked srd: false (house.coax). rs_spell answers for both.
#load "more.coax";
#load "house.coax";

// casting times
RS_T_ACTION :: 0; RS_T_BONUS :: 1; RS_T_REACTION :: 2;
RS_TIME :: [3] string.["Action", "Bonus Action", "Reaction"];
// areas, in grid squares from the point (or from the caster, for a cube that originates there)
RS_A_NONE :: 0; RS_A_CUBE_SELF :: 1; RS_A_SQUARE :: 2; RS_A_CUBE :: 3; RS_A_SPHERE :: 4;   // a sphere: area_ft its radius

// The effect steps. A step after ATTACK applies only on a hit; after SAVE, DAMAGE is halved on a
// success when the save says so, and CONDITION and PUSH apply only on a failure.
RS_S_ATTACK :: 1;     // a spell attack against AC: a 0 ranged, 1 melee
RS_S_SAVE :: 2;       // a: the ability, b: RS_ON_SAVE_HALF or RS_ON_SAVE_NONE
RS_S_DAMAGE :: 3;     // a dice of b sides, type c; d more dice for each slot level above the spell's
RS_S_HEAL :: 4;       // a dice of b sides, plus the caster's spellcasting modifier when c is 1; d more dice a slot level
RS_S_CONDITION :: 5;  // a: the condition's bit, for the spell's duration
RS_S_PUSH :: 6;       // a: feet away from the caster
RS_S_TERRAIN :: 7;    // the area is Difficult Terrain for the spell's duration
RS_S_OUTLINE :: 8;    // Dim Light a feet, can't benefit from Invisible, attacks against it have Advantage
RS_S_GLOW :: 9;       // Dim Light a feet until the end of the caster's next turn, can't benefit from Invisible
RS_S_FLAME :: 10;     // a flame in the caster's hand for the duration: Bright Light a feet and Dim b more; grants the hurl
RS_S_ESCAPE :: 11;    // a creature it Restrains can take an action to make a check of ability a against the DC
RS_S_TEMP :: 12;      // Temporary Hit Points: a dice of b sides plus c, and d more for each slot level above the spell's
RS_S_NOHEAL :: 13;    // the target can't regain Hit Points until the end of the caster's next turn
RS_S_TIMED :: 14;     // condition bit a: b 1 until the end of the caster's next turn; b 2 for the spell's duration,
                      // the target repeating a save of ability c at the end of each of its turns
RS_S_ENFEEBLE :: 15;  // Ray of Enfeeblement: on a failed save, weakened for the duration (the Con save repeats at the end
                      // of each of its turns, ending the spell); on a success, Disadvantage on its next attack roll
                      // until the start of the caster's next turn
RS_S_REPEAT :: 16;    // the program runs again for each ray or beam: a of them, b more for each slot level above the
                      // spell's, times the Cantrip Upgrade's tier when c is 1 (its damage dice then don't grow)
RS_S_HEX :: 17;       // Hex: the curse, with Disadvantage on checks of ability a
RS_S_EXPOSE :: 18;    // the next attack roll against the target before the end of the caster's next turn has Advantage
RS_S_MOCK :: 19;      // on a failed save, Disadvantage on the next attack roll the target makes before the end of its next turn
RS_S_SMITE :: 20;     // part of the caster's melee weapon hit on the target this turn (its Critical Hit doubles the dice);
                      // a more dice of b sides when the target is a Fiend or an Undead
RS_S_MARK :: 21;      // Hunter's Mark: 1d6 Force more whenever the caster hits the target with an attack roll
RS_S_WARD :: 22;      // +a AC until the start of the caster's next turn, against the triggering attack too (Shield)
RS_S_DAZE :: 23;      // on a failed save, condition bits a for the duration and Speed 0, ending if it takes damage (Hypnotic Pattern)
RS_S_RISE :: 25;      // Finger of Death: a Humanoid the damage killed rises as a Zombie at the start of the caster's next turn
RS_S_TELEPORT :: 26;  // Dimension Door: the caster teleports to the point; a filled space there is a 4d6 Force each and no teleport
RS_S_GUARD :: 24;     // Spirit Guardians: an Emanation of area_ft round the caster; a creature it enters, or one that enters it
                      // or ends its turn there, makes a save of ability c once a turn, a dice of b sides Radiant, half on a
                      // success, d more a slot level above; Speed halved in it
RS_ON_SAVE_HALF :: 1; RS_ON_SAVE_NONE :: 0;

RsStep :: struct { kind: int; a: int; b: int; c: int; d: int; }
RS_STEPS :: 6;
RsSpell :: struct {
  id: string; name: string;
  level: int;                 // 0: a cantrip
  school: string; classes: string;
  cast_time: int;
  range_ft: int;              // 0 Self, 5 Touch
  components: string;
  duration: string; duration_s: f32; concentration: bool;
  area: int; area_ft: int;
  steps: [RS_STEPS] RsStep; step_n: int;
  part_of: int;               // a part of another spell (Produce Flame's hurl), -1 none
  humanoid_only: bool;        // its target must be a Humanoid
  burst: bool;                // an area that is there only as it's cast, though the spell lasts (Call Lightning)
  plus: int;                  // a flat number added to its damage roll (Finger of Death's 7d8 + 30)
  srd: bool = true;           // the SRD's; false: a house rule (house.coax), not SRD content
  page: int;                  // the SRD 5.2.1 page
  text: string;
}

SP_PRODUCE_FLAME :: 0; SP_FLAME_HURL :: 1; SP_STARRY_WISP :: 2; SP_POISON_SPRAY :: 3;
SP_CURE_WOUNDS :: 4; SP_HEALING_WORD :: 5; SP_THUNDERWAVE :: 6; SP_ENTANGLE :: 7; SP_FAERIE_FIRE :: 8;
SP_CHILL_TOUCH :: 9; SP_RAY_OF_SICKNESS :: 10; SP_FALSE_LIFE :: 11; SP_RAY_OF_ENFEEBLEMENT :: 12; SP_BLINDNESS :: 13;
SP_ELDRITCH_BLAST :: 14; SP_HEX :: 15; SP_HOLD_PERSON :: 16; SP_SCORCHING_RAY :: 17;
SP_VICIOUS_MOCKERY :: 18; SP_SACRED_FLAME :: 19; SP_GUIDING_BOLT :: 20; SP_DIVINE_SMITE :: 21;
SP_HUNTERS_MARK :: 22; SP_FIRE_BOLT :: 23; SP_SHIELD :: 24;
SP_FIREBALL :: 25; SP_SPIRIT_GUARDIANS :: 26; SP_CALL_LIGHTNING :: 27; SP_CALL_BOLT :: 28; SP_HYPNOTIC_PATTERN :: 29;
RS_SPELLS :: 30;

rs_step :: (kind: int, a: int, b: int, c: int, d: int) -> RsStep { return RsStep.{kind = kind, a = a, b = b, c = c, d = d}; }

rs_spell :: (i: int) -> RsSpell {
  if i >= RS_SPELLS { return rs_more_spell(i); }
  s: RsSpell;
  s.part_of = -1;
  if i == SP_PRODUCE_FLAME {
    s = RsSpell.{id = "produce-flame", name = "Produce Flame", level = 0, school = "Conjuration", classes = "Druid",
                 cast_time = RS_T_BONUS, range_ft = 0, components = "V, S", duration = "10 minutes", duration_s = 600,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 157,
                 text = "A flickering flame appears in your hand and remains there for the duration. While there, the flame emits no heat and ignites nothing, and it sheds Bright Light in a 20-foot radius and Dim Light for an additional 20 feet. The spell ends if you cast it again. Until the spell ends, you can take a Magic action to hurl fire at a creature or an object within 60 feet of you. Make a ranged spell attack. On a hit, the target takes 1d8 Fire damage. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8)."};
    s.steps[0] = rs_step(RS_S_FLAME, 20, 20, 0, 0); s.step_n = 1;
  } else if i == SP_FLAME_HURL {
    s = RsSpell.{id = "produce-flame-hurl", name = "Produce Flame", level = 0, school = "Conjuration", classes = "Druid",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = SP_PRODUCE_FLAME, page = 157,
                 text = "Until the spell ends, you can take a Magic action to hurl fire at a creature or an object within 60 feet of you. Make a ranged spell attack. On a hit, the target takes 1d8 Fire damage."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 8, RS_FIRE, 0); s.step_n = 2;
  } else if i == SP_STARRY_WISP {
    s = RsSpell.{id = "starry-wisp", name = "Starry Wisp", level = 0, school = "Evocation", classes = "Bard, Druid",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 166,
                 text = "You launch a mote of light at one creature or object within range. Make a ranged spell attack against the target. On a hit, the target takes 1d8 Radiant damage, and until the end of your next turn, it emits Dim Light in a 10-foot radius and can't benefit from the Invisible condition. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8)."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 8, RS_RADIANT, 0);
    s.steps[2] = rs_step(RS_S_GLOW, 10, 0, 0, 0); s.step_n = 3;
  } else if i == SP_POISON_SPRAY {
    s = RsSpell.{id = "poison-spray", name = "Poison Spray", level = 0, school = "Necromancy", classes = "Druid, Sorcerer, Warlock, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 30, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 154,
                 text = "You spray toxic mist at a creature within range. Make a ranged spell attack against the target. On a hit, the target takes 1d12 Poison damage. Cantrip Upgrade. The damage increases by 1d12 when you reach levels 5 (2d12), 11 (3d12), and 17 (4d12)."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 12, RS_POISON, 0); s.step_n = 2;
  } else if i == SP_CHILL_TOUCH {
    s = RsSpell.{id = "chill-touch", name = "Chill Touch", level = 0, school = "Necromancy", classes = "Sorcerer, Warlock, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 5, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 116,
                 text = "Channeling the chill of the grave, make a melee spell attack against a target within reach. On a hit, the target takes 1d10 Necrotic damage, and it can't regain Hit Points until the end of your next turn. Cantrip Upgrade. The damage increases by 1d10 when you reach levels 5 (2d10), 11 (3d10), and 17 (4d10)."};
    s.steps[0] = rs_step(RS_S_ATTACK, 1, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 10, RS_NECROTIC, 0);
    s.steps[2] = rs_step(RS_S_NOHEAL, 0, 0, 0, 0); s.step_n = 3;
  } else if i == SP_RAY_OF_SICKNESS {
    s = RsSpell.{id = "ray-of-sickness", name = "Ray of Sickness", level = 1, school = "Necromancy", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 159,
                 text = "You shoot a greenish ray at a creature within range. Make a ranged spell attack against the target. On a hit, the target takes 2d8 Poison damage and has the Poisoned condition until the end of your next turn. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 8, RS_POISON, 1);
    s.steps[2] = rs_step(RS_S_TIMED, RS_POISONED, 1, 0, 0); s.step_n = 3;
  } else if i == SP_FALSE_LIFE {
    s = RsSpell.{id = "false-life", name = "False Life", level = 1, school = "Necromancy", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 0, components = "V, S, M (a drop of alcohol)", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 130,
                 text = "You gain 2d4 + 4 Temporary Hit Points. Using a Higher-Level Spell Slot. You gain 5 additional Temporary Hit Points for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_TEMP, 2, 4, 4, 5); s.step_n = 1;
  } else if i == SP_RAY_OF_ENFEEBLEMENT {
    s = RsSpell.{id = "ray-of-enfeeblement", name = "Ray of Enfeeblement", level = 2, school = "Necromancy", classes = "Warlock, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V, S", duration = "Concentration, up to 1 minute", duration_s = 60,
                 concentration = true, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 158,
                 text = "A beam of enervating energy shoots from you toward a creature within range. The target must make a Constitution saving throw. On a successful save, the target has Disadvantage on the next attack roll it makes until the start of your next turn. On a failed save, the target has Disadvantage on Strength-based D20 Tests for the duration. During that time, it also subtracts 1d8 from all its damage rolls. The target repeats the save at the end of each of its turns, ending the spell on a success."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_ENFEEBLE, 0, 0, 0, 0); s.step_n = 2;
  } else if i == SP_BLINDNESS {
    // Upcast, it targets one more creature a slot level above 2; the record holds one target.
    s = RsSpell.{id = "blindness-deafness", name = "Blindness/Deafness", level = 2, school = "Transmutation", classes = "Bard, Cleric, Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V", duration = "1 minute", duration_s = 60,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 114,
                 text = "One creature that you can see within range must succeed on a Constitution saving throw, or it has the Blinded or Deafened condition (your choice) for the duration. At the end of each of its turns, the target repeats the save, ending the spell on itself on a success. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 2."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_TIMED, RS_BLINDED, 2, RS_CON, 0); s.step_n = 2;
  } else if i == SP_ELDRITCH_BLAST {
    s = RsSpell.{id = "eldritch-blast", name = "Eldritch Blast", level = 0, school = "Evocation", classes = "Warlock",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 128,
                 text = "You hurl a beam of crackling energy. Make a ranged spell attack against one creature or object in range. On a hit, the target takes 1d10 Force damage. Cantrip Upgrade. The spell creates two beams at level 5, three beams at level 11, and four beams at level 17. You can direct the beams at the same target or at different ones. Make a separate attack roll for each beam."};
    s.steps[0] = rs_step(RS_S_REPEAT, 1, 0, 1, 0); s.steps[1] = rs_step(RS_S_ATTACK, 0, 0, 0, 0);
    s.steps[2] = rs_step(RS_S_DAMAGE, 1, 10, RS_FORCE, 0); s.step_n = 3;
  } else if i == SP_HEX {
    s = RsSpell.{id = "hex", name = "Hex", level = 1, school = "Enchantment", classes = "Warlock",
                 cast_time = RS_T_BONUS, range_ft = 90, components = "V, S, M (the petrified eye of a newt)", duration = "Concentration, up to 1 hour", duration_s = 3600,
                 concentration = true, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 141,
                 text = "You place a curse on a creature that you can see within range. Until the spell ends, you deal an extra 1d6 Necrotic damage to the target whenever you hit it with an attack roll. Also, choose one ability when you cast the spell. The target has Disadvantage on ability checks made with the chosen ability. If the target drops to 0 Hit Points before this spell ends, you can take a Bonus Action on a later turn to curse a new creature. Using a Higher-Level Spell Slot. Your Concentration can last longer with a spell slot of level 2 (up to 4 hours), 3–4 (up to 8 hours), or 5+ (24 hours)."};
    s.steps[0] = rs_step(RS_S_HEX, RS_STR, 0, 0, 0); s.step_n = 1;
  } else if i == SP_HOLD_PERSON {
    // Upcast, it targets one more Humanoid a slot level above 2; the record holds one target.
    s = RsSpell.{id = "hold-person", name = "Hold Person", level = 2, school = "Enchantment", classes = "Bard, Cleric, Druid, Sorcerer, Warlock, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V, S, M (a straight piece of iron)", duration = "Concentration, up to 1 minute", duration_s = 60,
                 concentration = true, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 142,
                 text = "Choose a Humanoid that you can see within range. The target must succeed on a Wisdom saving throw or have the Paralyzed condition for the duration. At the end of each of its turns, the target repeats the save, ending the spell on itself on a success. Using a Higher-Level Spell Slot. You can target one additional Humanoid for each spell slot level above 2."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_WIS, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_TIMED, RS_PARALYZED, 2, RS_WIS, 0); s.step_n = 2;
    s.humanoid_only = true;
  } else if i == SP_SCORCHING_RAY {
    // On the Sorcerer and Wizard lists; a Fiend Patron Warlock always has it prepared from level 3.
    s = RsSpell.{id = "scorching-ray", name = "Scorching Ray", level = 2, school = "Evocation", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 160,
                 text = "You hurl three fiery rays. You can hurl them at one target within range or at several. Make a ranged spell attack for each ray. On a hit, the target takes 2d6 Fire damage. Using a Higher-Level Spell Slot. You create one additional ray for each spell slot level above 2."};
    s.steps[0] = rs_step(RS_S_REPEAT, 3, 1, 0, 0); s.steps[1] = rs_step(RS_S_ATTACK, 0, 0, 0, 0);
    s.steps[2] = rs_step(RS_S_DAMAGE, 2, 6, RS_FIRE, 0); s.step_n = 3;
  } else if i == SP_CURE_WOUNDS {
    s = RsSpell.{id = "cure-wounds", name = "Cure Wounds", level = 1, school = "Abjuration", classes = "Bard, Cleric, Druid, Paladin, Ranger",
                 cast_time = RS_T_ACTION, range_ft = 5, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 122,
                 text = "A creature you touch regains a number of Hit Points equal to 2d8 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 2d8 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_HEAL, 2, 8, 1, 2); s.step_n = 1;
  } else if i == SP_HEALING_WORD {
    s = RsSpell.{id = "healing-word", name = "Healing Word", level = 1, school = "Abjuration", classes = "Bard, Cleric, Druid",
                 cast_time = RS_T_BONUS, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 140,
                 text = "A creature of your choice that you can see within range regains Hit Points equal to 2d4 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 2d4 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_HEAL, 2, 4, 1, 2); s.step_n = 1;
  } else if i == SP_THUNDERWAVE {
    s = RsSpell.{id = "thunderwave", name = "Thunderwave", level = 1, school = "Evocation", classes = "Bard, Druid, Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 0, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_CUBE_SELF, area_ft = 15, part_of = -1, page = 170,
                 text = "You unleash a wave of thunderous energy. Each creature in a 15-foot Cube originating from you makes a Constitution saving throw. On a failed save, a creature takes 2d8 Thunder damage and is pushed 10 feet away from you. On a successful save, a creature takes half as much damage only. In addition, unsecured objects that are entirely within the Cube are pushed 10 feet away from you, and a thunderous boom is audible within 300 feet. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_CON, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 8, RS_THUNDER, 1);
    s.steps[2] = rs_step(RS_S_PUSH, 10, 0, 0, 0); s.step_n = 3;
  } else if i == SP_ENTANGLE {
    s = RsSpell.{id = "entangle", name = "Entangle", level = 1, school = "Conjuration", classes = "Druid, Ranger",
                 cast_time = RS_T_ACTION, range_ft = 90, components = "V, S", duration = "Concentration, up to 1 minute", duration_s = 60,
                 concentration = true, area = RS_A_SQUARE, area_ft = 20, part_of = -1, page = 129,
                 text = "Grasping plants sprout from the ground in a 20-foot square within range. For the duration, these plants turn the ground in the area into Difficult Terrain. They disappear when the spell ends. Each creature (other than you) in the area when you cast the spell must succeed on a Strength saving throw or have the Restrained condition until the spell ends. A Restrained creature can take an action to make a Strength (Athletics) check against your spell save DC. On a success, it frees itself from the grasping plants and is no longer Restrained by them."};
    s.steps[0] = rs_step(RS_S_TERRAIN, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_SAVE, RS_STR, RS_ON_SAVE_NONE, 0, 0);
    s.steps[2] = rs_step(RS_S_CONDITION, RS_RESTRAINED, 0, 0, 0); s.steps[3] = rs_step(RS_S_ESCAPE, RS_STR, 0, 0, 0); s.step_n = 4;
  } else if i == SP_FAERIE_FIRE {
    s = RsSpell.{id = "faerie-fire", name = "Faerie Fire", level = 1, school = "Evocation", classes = "Bard, Druid",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V", duration = "Concentration, up to 1 minute", duration_s = 60,
                 concentration = true, area = RS_A_CUBE, area_ft = 20, part_of = -1, page = 130,
                 text = "Objects in a 20-foot Cube within range are outlined in blue, green, or violet light (your choice). Each creature in the Cube is also outlined if it fails a Dexterity saving throw. For the duration, objects and affected creatures shed Dim Light in a 10-foot radius and can't benefit from the Invisible condition. Attack rolls against an affected creature or object have Advantage if the attacker can see it."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_OUTLINE, 10, 0, 0, 0); s.step_n = 2;
  } else if i == SP_VICIOUS_MOCKERY {
    s = RsSpell.{id = "vicious-mockery", name = "Vicious Mockery", level = 0, school = "Enchantment", classes = "Bard",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 171,
                 text = "You unleash a string of insults laced with subtle enchantments at one creature you can see or hear within range. The target must succeed on a Wisdom saving throw or take 1d6 Psychic damage and have Disadvantage on the next attack roll it makes before the end of its next turn. Cantrip Upgrade. The damage increases by 1d6 when you reach levels 5 (2d6), 11 (3d6), and 17 (4d6)."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_WIS, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 6, RS_PSYCHIC, 0);
    s.steps[2] = rs_step(RS_S_MOCK, 0, 0, 0, 0); s.step_n = 3;
  } else if i == SP_SACRED_FLAME {
    s = RsSpell.{id = "sacred-flame", name = "Sacred Flame", level = 0, school = "Evocation", classes = "Cleric",
                 cast_time = RS_T_ACTION, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 159,
                 text = "Flame-like radiance descends on a creature that you can see within range. The target must succeed on a Dexterity saving throw or take 1d8 Radiant damage. The target gains no benefit from Half Cover or Three-Quarters Cover for this save. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8)."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 8, RS_RADIANT, 0); s.step_n = 2;
  } else if i == SP_GUIDING_BOLT {
    s = RsSpell.{id = "guiding-bolt", name = "Guiding Bolt", level = 1, school = "Evocation", classes = "Cleric",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V, S", duration = "1 round", duration_s = 6,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 138,
                 text = "You hurl a bolt of light toward a creature within range. Make a ranged spell attack against the target. On a hit, it takes 4d6 Radiant damage, and the next attack roll made against it before the end of your next turn has Advantage. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 4, 6, RS_RADIANT, 1);
    s.steps[2] = rs_step(RS_S_EXPOSE, 0, 0, 0, 0); s.step_n = 3;
  } else if i == SP_DIVINE_SMITE {
    s = RsSpell.{id = "divine-smite", name = "Divine Smite", level = 1, school = "Evocation", classes = "Paladin",
                 cast_time = RS_T_BONUS, range_ft = 0, components = "V", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 125,
                 text = "The target takes an extra 2d8 Radiant damage from the attack. The damage increases by 1d8 if the target is a Fiend or an Undead. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1."};
    s.steps[0] = rs_step(RS_S_SMITE, 1, 8, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 2, 8, RS_RADIANT, 1); s.step_n = 2;
  } else if i == SP_HUNTERS_MARK {
    s = RsSpell.{id = "hunters-mark", name = "Hunter's Mark", level = 1, school = "Divination", classes = "Ranger",
                 cast_time = RS_T_BONUS, range_ft = 90, components = "V", duration = "Concentration, up to 1 hour", duration_s = 3600,
                 concentration = true, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 141,
                 text = "You magically mark one creature you can see within range as your quarry. Until the spell ends, you deal an extra 1d6 Force damage to the target whenever you hit it with an attack roll. You also have Advantage on any Wisdom (Perception or Survival) check you make to find it. If the target drops to 0 Hit Points before this spell ends, you can take a Bonus Action to move the mark to a new creature you can see within range. Using a Higher-Level Spell Slot. Your Concentration can last longer with a spell slot of level 3–4 (up to 8 hours) or 5+ (up to 24 hours)."};
    s.steps[0] = rs_step(RS_S_MARK, 0, 0, 0, 0); s.step_n = 1;
  } else if i == SP_FIRE_BOLT {
    s = RsSpell.{id = "fire-bolt", name = "Fire Bolt", level = 0, school = "Evocation", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 132,
                 text = "You hurl a mote of fire at a creature or an object within range. Make a ranged spell attack against the target. On a hit, the target takes 1d10 Fire damage. A flammable object hit by this spell starts burning if it isn't being worn or carried. Cantrip Upgrade. The damage increases by 1d10 when you reach levels 5 (2d10), 11 (3d10), and 17 (4d10)."};
    s.steps[0] = rs_step(RS_S_ATTACK, 0, 0, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 1, 10, RS_FIRE, 0); s.step_n = 2;
  } else if i == SP_SHIELD {
    // Cast by the battle as a Reaction to a hit (rs_shield), not through rs_cast.
    s = RsSpell.{id = "shield", name = "Shield", level = 1, school = "Abjuration", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_REACTION, range_ft = 0, components = "V, S", duration = "1 round", duration_s = 6,
                 concentration = false, area = RS_A_NONE, area_ft = 0, part_of = -1, page = 161,
                 text = "An imperceptible barrier of magical force protects you. Until the start of your next turn, you have a +5 bonus to AC, including against the triggering attack, and you take no damage from Magic Missile."};
    s.steps[0] = rs_step(RS_S_WARD, 5, 0, 0, 0); s.step_n = 1;
  } else if i == SP_FIREBALL {
    s = RsSpell.{id = "fireball", name = "Fireball", level = 3, school = "Evocation", classes = "Sorcerer, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 150, components = "V, S, M (a ball of bat guano and sulfur)", duration = "Instantaneous", duration_s = 0,
                 concentration = false, area = RS_A_SPHERE, area_ft = 20, part_of = -1, page = 131,
                 text = "A bright streak flashes from you to a point you choose within range and then blossoms with a low roar into a fiery explosion. Each creature in a 20-foot-radius Sphere centered on that point makes a Dexterity saving throw, taking 8d6 Fire damage on a failed save or half as much damage on a successful one. Flammable objects in the area that aren't being worn or carried start burning. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 3."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 8, 6, RS_FIRE, 1); s.step_n = 2;
  } else if i == SP_SPIRIT_GUARDIANS {
    s = RsSpell.{id = "spirit-guardians", name = "Spirit Guardians", level = 3, school = "Conjuration", classes = "Cleric",
                 cast_time = RS_T_ACTION, range_ft = 0, components = "V, S, M (a prayer scroll)", duration = "Concentration, up to 10 minutes", duration_s = 600,
                 concentration = true, area = RS_A_NONE, area_ft = 15, part_of = -1, page = 164,
                 text = "Protective spirits flit around you in a 15-foot Emanation for the duration. If you are good or neutral, their spectral form appears angelic or fey (your choice). If you are evil, they appear fiendish. When you cast this spell, you can designate creatures to be unaffected by it. Any other creature's Speed is halved in the Emanation, and whenever the Emanation enters a creature's space and whenever a creature enters the Emanation or ends its turn there, the creature must make a Wisdom saving throw. On a failed save, the creature takes 3d8 Radiant damage (if you are good or neutral) or 3d8 Necrotic damage (if you are evil). On a successful save, the creature takes half as much damage. A creature makes this save only once per turn. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 3."};
    s.steps[0] = rs_step(RS_S_GUARD, 3, 8, RS_WIS, 1); s.step_n = 1;
  } else if i == SP_CALL_LIGHTNING || i == SP_CALL_BOLT {
    s = RsSpell.{id = "call-lightning", name = "Call Lightning", level = 3, school = "Conjuration", classes = "Druid",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "V, S", duration = "Concentration, up to 10 minutes", duration_s = 600,
                 concentration = true, area = RS_A_SPHERE, area_ft = 5, part_of = -1, burst = true, page = 114,
                 text = "A storm cloud appears at a point within range that you can see above yourself. It takes the shape of a Cylinder that is 10 feet tall with a 60-foot radius. When you cast the spell, choose a point you can see under the cloud. A lightning bolt shoots from the cloud to that point. Each creature within 5 feet of that point makes a Dexterity saving throw, taking 3d10 Lightning damage on a failed save or half as much damage on a successful one. Until the spell ends, you can take a Magic action to call down lightning in that way again, targeting the same point or a different one. If you're outdoors in a storm when you cast this spell, the spell gives you control over that storm instead of creating a new one. Under such conditions, the spell's damage increases by 1d10. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 3."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_DEX, RS_ON_SAVE_HALF, 0, 0); s.steps[1] = rs_step(RS_S_DAMAGE, 3, 10, RS_LIGHTNING, 1); s.step_n = 2;
    // the later bolts: a Magic action while it lasts, no slot (at a 3rd-level slot's damage)
    if i == SP_CALL_BOLT { s.id = "call-lightning-bolt"; s.level = 0; s.part_of = SP_CALL_LIGHTNING; s.concentration = false; s.duration_s = 0; s.steps[1].d = 0; }
  } else if i == SP_HYPNOTIC_PATTERN {
    s = RsSpell.{id = "hypnotic-pattern", name = "Hypnotic Pattern", level = 3, school = "Illusion", classes = "Bard, Sorcerer, Warlock, Wizard",
                 cast_time = RS_T_ACTION, range_ft = 120, components = "S, M (a pinch of confetti)", duration = "Concentration, up to 1 minute", duration_s = 60,
                 concentration = true, area = RS_A_CUBE, area_ft = 30, part_of = -1, burst = true, page = 141,
                 text = "You create a twisting pattern of colors in a 30-foot Cube within range. The pattern appears for a moment and vanishes. Each creature in the area who can see the pattern must succeed on a Wisdom saving throw or have the Charmed condition for the duration. While Charmed, the creature has the Incapacitated condition and a Speed of 0. The spell ends for an affected creature if it takes any damage or if someone else uses an action to shake the creature out of its stupor."};
    s.steps[0] = rs_step(RS_S_SAVE, RS_WIS, RS_ON_SAVE_NONE, 0, 0); s.steps[1] = rs_step(RS_S_DAZE, RS_CHARMED | RS_INCAPACITATED, 0, 0, 0); s.step_n = 2;
  }
  return s;
}
// A cantrip's damage dice by the caster's level (Cantrip Upgrade: levels 5, 11 and 17).
rs_cantrip_tier :: (level: int) -> int {
  if level >= 17 { return 4; }
  if level >= 11 { return 3; }
  if level >= 5 { return 2; }
  return 1;
}

#test "the records hold the SRD's numbers" {
  for i: 0..<RS_SPELLS { s := rs_spell(i); #assert s.name.count > 0 && s.text.count > 40 && s.step_n > 0 && s.page > 100; }
  cw := rs_spell(SP_CURE_WOUNDS); #assert cw.level == 1 && cw.range_ft == 5 && cw.steps[0].a == 2 && cw.steps[0].b == 8 && cw.steps[0].d == 2;
  hw := rs_spell(SP_HEALING_WORD); #assert hw.cast_time == RS_T_BONUS && hw.range_ft == 60 && hw.steps[0].b == 4;
  tw := rs_spell(SP_THUNDERWAVE); #assert tw.area == RS_A_CUBE_SELF && tw.area_ft == 15 && tw.steps[0].a == RS_CON && tw.steps[1].d == 1 && tw.steps[2].a == 10;
  en := rs_spell(SP_ENTANGLE); #assert en.concentration && en.duration_s == 60 && en.range_ft == 90 && en.area_ft == 20;
  ps := rs_spell(SP_POISON_SPRAY); #assert ps.range_ft == 30 && ps.steps[1].b == 12 && ps.steps[1].c == RS_POISON;
  #assert rs_spell(SP_FLAME_HURL).part_of == SP_PRODUCE_FLAME && rs_spell(SP_PRODUCE_FLAME).cast_time == RS_T_BONUS;
  ct := rs_spell(SP_CHILL_TOUCH); #assert ct.range_ft == 5 && ct.steps[0].a == 1 && ct.steps[1].b == 10 && ct.steps[1].c == RS_NECROTIC && ct.steps[2].kind == RS_S_NOHEAL;
  rs2 := rs_spell(SP_RAY_OF_SICKNESS); #assert rs2.steps[1].a == 2 && rs2.steps[1].b == 8 && rs2.steps[1].d == 1 && rs2.steps[2].a == RS_POISONED;
  fl := rs_spell(SP_FALSE_LIFE); #assert fl.steps[0].a == 2 && fl.steps[0].b == 4 && fl.steps[0].c == 4 && fl.steps[0].d == 5;
  re := rs_spell(SP_RAY_OF_ENFEEBLEMENT); #assert re.level == 2 && re.concentration && re.steps[0].a == RS_CON;
  bd := rs_spell(SP_BLINDNESS); #assert bd.range_ft == 120 && !bd.concentration && bd.steps[1].a == RS_BLINDED && bd.steps[1].c == RS_CON;
  eb := rs_spell(SP_ELDRITCH_BLAST); #assert eb.range_ft == 120 && eb.steps[0].kind == RS_S_REPEAT && eb.steps[0].c == 1 && eb.steps[2].b == 10 && eb.steps[2].c == RS_FORCE;
  hx := rs_spell(SP_HEX); #assert hx.cast_time == RS_T_BONUS && hx.range_ft == 90 && hx.concentration && hx.level == 1;
  hp := rs_spell(SP_HOLD_PERSON); #assert hp.level == 2 && hp.concentration && hp.steps[0].a == RS_WIS && hp.steps[1].a == RS_PARALYZED && hp.steps[1].c == RS_WIS;
  sr := rs_spell(SP_SCORCHING_RAY); #assert sr.steps[0].a == 3 && sr.steps[0].b == 1 && sr.steps[2].a == 2 && sr.steps[2].b == 6;
  vm := rs_spell(SP_VICIOUS_MOCKERY); #assert vm.steps[0].a == RS_WIS && vm.steps[1].b == 6 && vm.steps[1].c == RS_PSYCHIC && vm.steps[2].kind == RS_S_MOCK;
  sf := rs_spell(SP_SACRED_FLAME); #assert sf.steps[0].a == RS_DEX && sf.steps[1].b == 8 && sf.steps[1].c == RS_RADIANT;
  gb := rs_spell(SP_GUIDING_BOLT); #assert gb.level == 1 && gb.range_ft == 120 && gb.steps[1].a == 4 && gb.steps[1].b == 6 && gb.steps[1].d == 1;
  ds := rs_spell(SP_DIVINE_SMITE); #assert ds.cast_time == RS_T_BONUS && ds.steps[0].a == 1 && ds.steps[1].a == 2 && ds.steps[1].b == 8 && ds.steps[1].d == 1;
  hm := rs_spell(SP_HUNTERS_MARK); #assert hm.concentration && hm.range_ft == 90 && hm.cast_time == RS_T_BONUS;
  fb := rs_spell(SP_FIRE_BOLT); #assert fb.range_ft == 120 && fb.steps[1].b == 10 && fb.steps[1].c == RS_FIRE;
  sh := rs_spell(SP_SHIELD); #assert sh.cast_time == RS_T_REACTION && sh.steps[0].a == 5;
  #assert rs_cantrip_tier(1) == 1 && rs_cantrip_tier(5) == 2 && rs_cantrip_tier(11) == 3 && rs_cantrip_tier(17) == 4;
}
