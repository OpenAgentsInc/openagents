#load "stat-opportunity-checks.coax";
#load "../../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for mode:0..<4 {
    b:[1]RsBattle; b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b[..],rs_guard("Reactor",1),3,3); _=rs_add(b[..],rs_wizard("Mover",0,3),5,3);
    spells:=[1]int.[RS_EXEC_SOURCE[SP_SHIELD]]; if !rs_set_spells(b[0].c[1..<2],spells[..]) { return 1; } b[0].c[1].shield_spell=true;
    rs_start_turn(b[..],1); b[0].turn.slot_spent=(mode&1)!=0; b[0].turn.quickened=(mode&2)!=0;
    a:=sa_record(); a.reach=10; slots:=b[0].c[1].slots[1]; hp:=b[0].c[1].hp;
    r:=rs_stat_opportunity(b[..],0,1,a,RsOpportunityMove.{x=6,y=3,seen=true,movement=true});
    if !r.admitted || r.hit!=(mode!=0) || b[0].c[1].slots[1]!=slots-(ifx mode==0 then 1 else 0) { return 2; }
    if b[0].c[1].hp!=hp-(ifx mode==0 then 0 else 9) || b[0].who!=1 || b[0].reaction_frame.on || !b[0].c[0].reacted { return 3; }
    if mode==0 && b[0].c[1].shield_until!=b[0].c[1].turn_at+rs_beat(b[..]) { return 4; }
  }
  tool_errln("PASS STAT-OPPORTUNITY"); return 0;
}
