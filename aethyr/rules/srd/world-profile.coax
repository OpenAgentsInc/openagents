// A world's whole rules declaration: every way its combat departs from SRD
// 5.2.1 turn timing, areas, press costs and walking, chosen in one call before
// the battle's clock is sealed. The shared rules read only the battle's applied
// fields (timing, areas, press, walk); worlds never pick them one at a time.
// Removing a profile (rs_reset, or RS_STRICT_WORLD) gives strict SRD results.
#authority;
#load "press-budget.coax";

RS_WALK_PAID :: 0;   // SRD p.24: continuous walking spends the turn's feet (walk-budget.coax)
RS_WALK_RATE :: 1;   // house: continuous walking at a Speed-proportional rate, unpaid
RsWorldProfile :: struct { timing: RsTimingProfile; areas: RsAreaProfile; press: RsPressProfile; walk: int; }
RS_STRICT_WORLD :: RsWorldProfile.{};
// Grid action worlds: Everglade 5E single play, 5E MMO and 5E Lab's action mode.
RS_ACTION_WORLD :: RsWorldProfile.{timing=RS_ACTION_TIMING, areas=RS_SPARE_CASTER_AREAS};
// Everglade Experimental, the Everglade 5E room and Everglade II: also free
// presses and continuous rate walking.
RS_EVERGLADE_WORLD :: RsWorldProfile.{timing=RS_ACTION_TIMING, areas=RS_SPARE_CASTER_AREAS, press=RS_UNLIMITED_PRESS, walk=RS_WALK_RATE};

// The named deviations, one bit each.
RS_DEV_BEATS :: 1;         // 1.5-second turns and a quarter-round movement grant
RS_DEV_RECHARGE :: 2;      // spent slots, uses and points come back on cooldowns
RS_DEV_SPARE_CASTER :: 4;  // a caster is never in its own area
RS_DEV_FREE_PRESS :: 8;    // each press refills slots, uses, Focus, Rage and the Action budget
RS_DEV_RATE_WALK :: 16;    // continuous walking is not paid from the turn's feet
RS_DEV_NAMES :: [5] string.["1.5-second turns", "cooldown recovery", "caster spared by its own areas", "unlimited presses", "unpaid continuous walking"];

rs_world_deviations :: (p: RsWorldProfile) -> int #effects(all) {
  d := 0;
  if p.timing.kind == RS_TIME_ACTION { d = d + RS_DEV_BEATS + RS_DEV_RECHARGE; }
  if p.areas.kind == RS_AREA_SPARE_CASTER { d = d + RS_DEV_SPARE_CASTER; }
  if p.press.kind == RS_UNLIMITED_PRESS.kind { d = d + RS_DEV_FREE_PRESS; }
  if p.walk == RS_WALK_RATE { d = d + RS_DEV_RATE_WALK; }
  return d;
}
rs_world_allowed :: (p: RsWorldProfile, sealed: bool) -> bool #effects(all) {
  return rs_timing_allowed(p.timing,sealed) && rs_area_allowed(p.areas,sealed)
    && (p.press.kind == RS_PAID_PRESS.kind || p.press.kind == RS_UNLIMITED_PRESS.kind)
    && (p.walk == RS_WALK_PAID || p.walk == RS_WALK_RATE);
}
// All or nothing: a refused profile leaves every applied field as it was.
rs_set_world :: (b: [] RsBattle, p: RsWorldProfile) -> bool #effects(all) {
  if !rs_world_allowed(p,b[0].timing_sealed) { return false; }
  b[0].timing = p.timing; b[0].areas = p.areas; b[0].press = p.press; b[0].walk = p.walk;
  return true;
}
rs_world_of :: (b: [] RsBattle) -> RsWorldProfile #effects(all) {
  return RsWorldProfile.{timing=b[0].timing, areas=b[0].areas, press=b[0].press, walk=b[0].walk};
}
rs_reset_world :: (b: [] RsBattle) #effects(all) {
  rs_reset_timing(b); rs_reset_areas(b); b[0].press = RS_PAID_PRESS; b[0].walk = RS_WALK_PAID;
}

#test "world admission accepts exactly declared fields and only before the clock is sealed" {
  for t: -1..<3 { for a: -1..<3 { for p: -1..<3 { for w: -1..<3 { for sealed: 0..<2 {
    profile := RsWorldProfile.{timing=RsTimingProfile.{kind=t}, areas=RsAreaProfile.{kind=a}, press=RsPressProfile.{kind=p}, walk=w};
    ok := t >= 0 && t <= 1 && a >= 0 && a <= 1 && p >= 0 && p <= 1 && w >= 0 && w <= 1 && sealed == 0;
    #assert rs_world_allowed(profile,sealed == 1) == ok;
    #assert rs_world_deviations(profile) == (ifx t == 1 then 3 else 0) + (ifx a == 1 then 4 else 0) + (ifx p == 1 then 8 else 0) + (ifx w == 1 then 16 else 0);
  } } } } }
}

#test "the declared worlds name every departure and the strict world none" {
  #assert rs_world_deviations(RS_STRICT_WORLD) == 0;
  #assert rs_world_deviations(RS_ACTION_WORLD) == RS_DEV_BEATS|RS_DEV_RECHARGE|RS_DEV_SPARE_CASTER;
  #assert rs_world_deviations(RS_EVERGLADE_WORLD) == 31;
  #assert RS_DEV_NAMES[0] == "1.5-second turns" && RS_DEV_NAMES[1] == "cooldown recovery" && RS_DEV_NAMES[2] == "caster spared by its own areas";
  #assert RS_DEV_NAMES[3] == "unlimited presses" && RS_DEV_NAMES[4] == "unpaid continuous walking";
}

#test "a world applies all or nothing, the clock seals it and reset restores strict" {
  b: [1] RsBattle;
  #assert rs_world_deviations(rs_world_of(b[..])) == 0;
  #assert rs_set_world(b[..],RS_ACTION_WORLD) && rs_world_deviations(rs_world_of(b[..])) == 7;
  for bad: 0..<4 {
    p := RS_EVERGLADE_WORLD;
    if bad == 0 { p.timing.kind = 2; } else if bad == 1 { p.areas.kind = 2; } else if bad == 2 { p.press.kind = 2; } else { p.walk = 2; }
    #assert !rs_set_world(b[..],p) && rs_world_deviations(rs_world_of(b[..])) == 7;
  }
  #assert rs_set_world(b[..],RS_EVERGLADE_WORLD) && rs_world_deviations(rs_world_of(b[..])) == 31;
  _ := rs_add(b[..],rs_fighter("Actor",0,1),1,1); rs_begin(b[..]);
  #assert !rs_set_world(b[..],RS_STRICT_WORLD) && rs_world_deviations(rs_world_of(b[..])) == 31;
  rs_reset(b[..]);
  #assert rs_world_deviations(rs_world_of(b[..])) == 0 && !b[0].timing_sealed;
  #assert rs_set_world(b[..],RS_ACTION_WORLD);
}

