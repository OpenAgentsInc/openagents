// The inventory and reward ledger's rules (GitHub #12849), and their one owner (#13318, decision
// docs/decisions/0006-item-ledger-rules-in-coax.md): every store of items asks this file what an ask
// does. This file's in-memory store (Ledger, below) asks it, and so does the API's Postgres store
// (coax/web/api/item-policy.coax, player.c room_items, migrations/0130 and 0165): the database
// keeps the rows, the version guard (locks), operation-ID uniqueness and the outbox insert, and
// decides nothing. The ledger holds game items only. Nothing in it is money or is redeemable for
// money; a feature that ever attaches value to an item settles on Bitcoin rails (Lightning, Spark,
// Taproot Assets) through the wallet's own contract, never here.
//
// Every mutation names a stable operation ID (OperationId) chosen by its caller (a room: its shard,
// its process generation, a counter) and is fenced by the character's owner generation (control.coax):
//   - the same ID with the same payload returns the recorded result and changes nothing (a retry
//     after a lost response, or a duplicate request);
//   - the same ID with another payload is refused (LEDGER_CONFLICT) and changes nothing;
//   - a write under a generation below the store's newest for that character is refused
//     (LEDGER_STALE): an old owner can't grant or move anything after a new one took over;
//   - a write that names an inventory version other than the current one is refused
//     (LEDGER_VERSION), so two concurrent transfers or claims can't both spend one item;
//   - a write that would move a character's version past the largest int is refused
//     (LEDGER_EXHAUSTED) before anything changes: versions are #counter fields, advanced only by
//     add_checked, the same in every build (#12927).
// A workflow that spans owners (a trade, travel with an item) escrows the item first: an escrowed
// item can't be transferred, granted again or escrowed elsewhere until its escrow settles (moves it)
// or cancels (returns it).
// Each applied mutation appends an outbox entry in the same step. A consumer (a notification, a
// view) applies entries in sequence order and skips a sequence it has seen, so redelivery is safe.
// Time is wall-clock milliseconds. An operation is remembered LEDGER_KEEP ms (a day) after it
// applied. An ask carries the time it was first sent; one first sent LEDGER_KEEP ago or more is
// refused (LEDGER_EXPIRED) rather than applied, since its first send may have applied and been
// forgotten. Restore: replaying the outbox from a snapshot rebuilds the same items, owners and
// versions (ledger_reconcile).
// A character is compared only for equality. The in-memory store numbers its characters
// (CharacterId, an index into its arrays); the database names them by account (coalesce(account,
// id)). Each store says whether two of its characters are one; the rules never see either form.
//   coax/bin/coax test aethyr/session/ledger.coax --library
//   coax/bin/coax mutate aethyr/session/ledger.coax --library --root-only

#module "aethyr.session.ledger";
#authority;
#load "control.coax";
#load "../core/ids.coax";

// book:begin ledger-profile
LEDGER_ITEMS :: 32;
LEDGER_OPS :: 64;
LEDGER_OUTBOX :: 64;
LEDGER_KEEP :: 86400000;   // ms an operation ID is remembered: a day

LEDGER_OK :: 0;
LEDGER_CONFLICT :: 1;  // the ID was used for another payload
LEDGER_STALE :: 2;     // the writer's owner generation is old
LEDGER_VERSION :: 3;   // the inventory changed since the writer read it
LEDGER_HELD :: 4;      // the item is escrowed, or isn't the writer's
LEDGER_FULL :: 5;      // no room for another item or operation
LEDGER_EXPIRED :: 6;   // the ID is older than LEDGER_KEEP
LEDGER_NO_ITEM :: 7;
LEDGER_EXHAUSTED :: 8; // a version the write would advance has no next value
LEDGER_GO :: -1;       // ledger_gate: a new ID, in time: ledger_rule decides it
LEDGER_REPLAY :: -2;   // ledger_gate: the ID is on record with this payload: its recorded answer

LOP_GRANT :: 1; LOP_TRANSFER :: 2; LOP_ESCROW :: 3; LOP_SETTLE :: 4; LOP_CANCEL :: 5;
LOP_CONSUME :: 6;   // the writer's item is used up: it is gone (#13291)
LOP_CLAIM :: 7;     // no item: the store's record of the character changes with this ID, once (a quest's stage, coin, what is worn; #13291)

LedgerItem :: struct { live: bool; kind: int; owner: CharacterId; escrow_to: CharacterId = CharacterId.{value = -1}; }
LedgerOp :: struct { live: bool; id: OperationId; op: int; c: CharacterId; item: ItemId; to: CharacterId; kind: int; at: int; result: int; made: ItemId; }
LedgerEntry :: struct { seq: int; op: int; c: CharacterId; item: ItemId; to: CharacterId; kind: int; }
ItemLedger :: struct {
  fence: [1] ControlFence;
  items: [LEDGER_ITEMS] LedgerItem;
  version: [CONTROL_CHARACTERS] int #counter;
  ops: [LEDGER_OPS] LedgerOp;
  out: [LEDGER_OUTBOX] LedgerEntry; out_n: int;
}
// What a caller asks: op, by character c under generation gen having read inventory version ver.
// sent: the time (ms) it was first sent (a retry keeps it).
LedgerAsk :: struct { id: OperationId; op: int; c: CharacterId; gen: OwnerGeneration; ver: int; item: ItemId = ItemId.{value = -1}; to: CharacterId = CharacterId.{value = -1}; kind: int; sent: int; }
LedgerAnswer :: struct { status: int; item: ItemId = ItemId.{value = -1}; replay: bool; }
// book:end ledger-profile

// ---- the rules: every store's facts in, the answer out (nothing changes)

// An operation the ledger knows.
ledger_known_op :: (op: int) -> bool #effects(reads, writes, traps) { return op >= LOP_GRANT && op <= LOP_CLAIM; }
// Whether an operation applied at `at` is still remembered at `now`.
ledger_remembered :: (at: int, now: int) -> bool #effects(reads, writes, traps) { return now - at < LEDGER_KEEP; }
// Whether a version can advance.
ledger_next :: (version: int) -> bool #effects(reads, writes, traps) { return add_checked(version, 1) != null; }
// A payload is the same when its operation, character, item, receiver and kind are.
ledger_same_payload :: (op: bool, c: bool, item: bool, to: bool, kind: bool) -> bool #effects(reads, writes, traps) { return op && c && item && to && kind; }

// The ask, before any inventory is read: an unknown operation or character is refused (not recorded);
// a remembered ID answers from its record (LEDGER_REPLAY) or is a conflict; one first sent too long
// ago is refused (LEDGER_EXPIRED); otherwise LEDGER_GO. seen: the ID has a record, applied at `at`;
// same: its payload is the ask's.
ledger_gate :: (op: int, known: bool, seen: bool, at: int, same: bool, sent: int, now: int) -> int #effects(reads, writes, traps) {
  if !ledger_known_op(op) || !known { return LEDGER_HELD; }
  if seen && ledger_remembered(at, now) { return ifx same then LEDGER_REPLAY else LEDGER_CONFLICT; }
  if !ledger_remembered(sent, now) { return LEDGER_EXPIRED; }
  return LEDGER_GO;
}

// The ask's answer from the store's facts, read under its locks; the store records it.
//   newest      the character's newest owner generation; gen the writer's
//   ver         the version the writer read; version the character's now
//   live        the item exists; mine: it is the writer's; escrowed: it has an escrow party
//   to_known    the receiver is a character; to_self: the receiver is the writer
//   c_next, to_next, escrow_next   the writer's, the receiver's and the escrow party's versions can advance
ledger_rule :: (op: int, gen: OwnerGeneration, newest: OwnerGeneration, ver: int, version: int, live: bool, mine: bool, escrowed: bool,
                to_known: bool, to_self: bool, c_next: bool, to_next: bool, escrow_next: bool) -> int #effects(reads, writes, traps) {
  if newest.value > gen.value { return LEDGER_STALE; }
  if ver != version { return LEDGER_VERSION; }
  if ledger_names_item(op) {
    if !live { return LEDGER_NO_ITEM; }
    if !mine { return LEDGER_HELD; }
    if op == LOP_TRANSFER || op == LOP_ESCROW {
      if escrowed || !to_known || to_self { return LEDGER_HELD; }
    } else if escrowed == ledger_destroys(op) { return LEDGER_HELD; }   // a settle or a cancel needs an escrow; a consume none
  }
  // every version the change advances must have a next one, or nothing changes
  if !c_next { return LEDGER_EXHAUSTED; }
  if op == LOP_TRANSFER && !to_next { return LEDGER_EXHAUSTED; }
  if op == LOP_SETTLE && !escrow_next { return LEDGER_EXHAUSTED; }
  return LEDGER_OK;
}

// What an applied operation changes. The writer's version always advances.
ledger_creates :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_GRANT; }      // a new item of the ask's kind, the writer's
ledger_moves :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_TRANSFER; }     // the owner becomes the receiver, whose version advances
ledger_escrows :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_ESCROW; }     // the item is escrowed to the receiver
ledger_settles :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_SETTLE; }     // the owner becomes the escrow party, whose version advances; the outbox names it
ledger_clears :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_SETTLE || op == LOP_CANCEL; }   // the escrow ends
ledger_destroys :: (op: int) -> bool #effects(reads, writes, traps) { return op == LOP_CONSUME; }   // the item is gone
// Whether an operation names an item that exists (every one but a grant, which makes its item, and a claim, which has none).
ledger_names_item :: (op: int) -> bool #effects(reads, writes, traps) { return op != LOP_GRANT && op != LOP_CLAIM; }
// Whether a character who holds `held` items has no room for another.
ledger_bag_full :: (held: int) -> bool #effects(reads, writes, traps) { return held >= LEDGER_ITEMS; }

#test "ledger rules: the gate, on its own" {
  #assert ledger_gate(0, true, false, 0, false, 5, 5) == LEDGER_HELD && ledger_gate(8, true, false, 0, false, 5, 5) == LEDGER_HELD;
  #assert ledger_gate(LOP_GRANT, true, false, 0, false, 5, 5) == LEDGER_GO && ledger_gate(LOP_CLAIM, true, false, 0, false, 5, 5) == LEDGER_GO;
  #assert ledger_gate(LOP_GRANT, false, true, 5, true, 5, 5) == LEDGER_HELD;
  #assert ledger_gate(LOP_GRANT, true, true, 5, true, 5, 6) == LEDGER_REPLAY && ledger_gate(LOP_GRANT, true, true, 5, false, 5, 6) == LEDGER_CONFLICT;
  // a record past its keep is forgotten: the ask is new again, or expired
  #assert ledger_gate(LOP_GRANT, true, true, 5, false, 5 + LEDGER_KEEP, 5 + LEDGER_KEEP) == LEDGER_GO;
  #assert ledger_gate(LOP_GRANT, true, true, 5, false, 5, 5 + LEDGER_KEEP) == LEDGER_EXPIRED && ledger_gate(LOP_GRANT, true, true, 6, false, 5, 5 + LEDGER_KEEP) == LEDGER_CONFLICT;
  #assert ledger_gate(LOP_GRANT, true, false, 0, false, 6, 5 + LEDGER_KEEP) == LEDGER_GO;
  #assert ledger_same_payload(true, true, true, true, true) && !ledger_same_payload(false, true, true, true, true) && !ledger_same_payload(true, true, true, true, false);
}
#test "ledger rules: each operation's effects" {
  for op: 0..<9 {
    #assert ledger_creates(op) == (op == 1) && ledger_moves(op) == (op == 2) && ledger_escrows(op) == (op == 3) && ledger_settles(op) == (op == 4);
    #assert ledger_clears(op) == (op == 4 || op == 5) && ledger_destroys(op) == (op == 6) && ledger_names_item(op) == (op != 1 && op != 7);
  }
  #assert !ledger_bag_full(0) && !ledger_bag_full(LEDGER_ITEMS - 1) && ledger_bag_full(LEDGER_ITEMS) && ledger_bag_full(LEDGER_ITEMS + 1);
}

// ---- the in-memory store

ledger_same :: (o: LedgerOp, a: LedgerAsk) -> bool #effects(reads, writes, traps) { return ledger_same_payload(o.op == a.op, o.c == a.c, o.item == a.item, o.to == a.to, o.kind == a.kind); }
ledger_character :: (c: CharacterId) -> bool #effects(reads, writes, traps) { return c.value >= 0 && c.value < CONTROL_CHARACTERS; }

// One mutation, all or nothing, at time `now` (ms).
ledger_apply :: (l: [] ItemLedger, a: LedgerAsk, now: int) -> LedgerAnswer #effects(reads, writes, traps) {
  // the ID first: a retry gets its first answer, whatever changed since; a forgotten slot frees
  free := -1; seen := -1;
  for i: 0..<LEDGER_OPS {
    if l[0].ops[i].live && !ledger_remembered(l[0].ops[i].at, now) { l[0].ops[i].live = false; }
    if !l[0].ops[i].live { if free == -1 { free = i; } continue; }
    if l[0].ops[i].id == a.id { seen = i; }
  }
  o := LedgerOp.{};
  if seen >= 0 { o = l[0].ops[seen]; }
  g := ledger_gate(a.op, ledger_character(a.c), seen >= 0, o.at, ledger_same(o, a), a.sent, now);
  if g == LEDGER_REPLAY { return LedgerAnswer.{status = o.result, item = o.made, replay = true}; }
  if g != LEDGER_GO { return LedgerAnswer.{status = g}; }
  if free == -1 { return LedgerAnswer.{status = LEDGER_FULL}; }
  st := ledger_check(l, a);
  made := ItemId.{value = -1};
  if st == LEDGER_OK && a.op == LOP_GRANT {
    for i: 0..<LEDGER_ITEMS { if !l[0].items[i].live { made = ItemId.{value = i}; break; } }
    if made.value < 0 { st = LEDGER_FULL; }
  }
  item := ifx a.op == LOP_GRANT then made else a.item;
  if st==LEDGER_OK {
    switch ledger_commit(l,a,item) {
      case none {return LedgerAnswer.{status=LEDGER_FULL};}
      case some(committed) {}
    }
  } else if l[0].out_n>=LEDGER_OUTBOX {
    return LedgerAnswer.{status=LEDGER_FULL};
  }
  // Keep a refusal receipt too. A full outbox keeps no receipt, so the same
  // operation can be retried when capacity returns, as before.
  l[0].ops[free] = LedgerOp.{live = true, id = a.id, op = a.op, c = a.c, item = a.item, to = a.to, kind = a.kind, at = now, result = st, made = made};
  return LedgerAnswer.{status=st,item=ifx st==LEDGER_OK then item else ItemId.{value= -1}};
}
// The item/version transition and its in-memory outbox are one undo scope.
// Refusal receipts belong to ledger_apply; durable service commits stay there.
ledger_commit :: (l:[]ItemLedger,a:LedgerAsk,item:ItemId)->ItemId? #effects(reads, writes, traps) {
  #transaction {
    to := ifx ledger_settles(a.op) then l[0].items[item.value].escrow_to else a.to;
    ledger_mutate(l,a.op,a.c,item,a.to,a.kind);
    if l[0].out_n>=LEDGER_OUTBOX {return null;}
    l[0].out[l[0].out_n]=LedgerEntry.{seq=l[0].out_n+1,op=a.op,c=a.c,item=item,to=to,kind=a.kind};
    l[0].out_n+=1;
  }
  return some(item);
}
#test "ledger transaction: outbox refusal after the first state write restores items, versions and the outbox" {
  l:[1]ItemLedger;l[0].out_n=LEDGER_OUTBOX;l[0].out[0]=LedgerEntry.{seq=7,kind=99};
  ask:=LedgerAsk.{id=OperationId.{value=1},op=LOP_GRANT,c=CharacterId.{value=0},gen=OwnerGeneration.{value=1},kind=3,sent=1};
  switch ledger_commit(l[..],ask,ItemId.{value=0}) {case none {} case some(wrong) {#assert false;}}
  #assert !l[0].items[0].live && l[0].items[0].kind==0 && l[0].version[0]==0;
  #assert l[0].out_n==LEDGER_OUTBOX && l[0].out[0].seq==7 && l[0].out[0].kind==99;
  answer:=ledger_apply(l[..],ask,1);
  #assert answer.status==LEDGER_FULL && !l[0].items[0].live && l[0].version[0]==0 && !l[0].ops[0].live;
  invalid:=ask;invalid.op=LOP_TRANSFER;invalid.item=ItemId.{value=0};
  #assert ledger_apply(l[..],invalid,1).status==LEDGER_FULL && !l[0].ops[0].live;
}
// The in-memory store's facts for a, and the rules' answer (nothing changes).
ledger_check :: (l: [] ItemLedger, a: LedgerAsk) -> int #effects(reads, writes, traps) {
  m := LedgerItem.{};
  if a.item.value >= 0 && a.item.value < LEDGER_ITEMS { m = l[0].items[a.item.value]; }
  e := m.escrow_to;
  to_known := ledger_character(a.to);
  return ledger_rule(a.op, a.gen, OwnerGeneration.{value = l[0].fence[0].gen[a.c.value]}, a.ver, l[0].version[a.c.value], m.live, m.owner == a.c,
                     e.value >= 0, to_known, a.to == a.c, ledger_has_next(l, a.c), to_known && ledger_has_next(l, a.to), e.value >= 0 && ledger_has_next(l, e));
}
// Whether character c's inventory version can advance.
ledger_has_next :: (l: [] ItemLedger, c: CharacterId) -> bool #effects(reads, writes, traps) { return ledger_next(l[0].version[c.value]); }
// Character c's inventory version advances; at its last it stays (ledger_rule refused the change first).
ledger_bump :: (l: [] ItemLedger, c: CharacterId) #effects(reads, writes, traps) {
  next := add_checked(l[0].version[c.value], 1);
  switch next { case none {} case some(v) { l[0].version[c.value] = v; } }
}
// The change itself, shared by apply and replay: the rules' effects on this store.
ledger_mutate :: (l: [] ItemLedger, op: int, c: CharacterId, item: ItemId, to: CharacterId, kind: int) #effects(reads, writes, traps) {
  if ledger_destroys(op) { l[0].items[item.value] = LedgerItem.{}; }
  if ledger_creates(op) { l[0].items[item.value] = LedgerItem.{live = true, kind = kind, owner = c}; }
  if ledger_moves(op) { l[0].items[item.value].owner = to; }
  if ledger_settles(op) { l[0].items[item.value].owner = l[0].items[item.value].escrow_to; }   // before the escrow clears
  if ledger_escrows(op) { l[0].items[item.value].escrow_to = to; }
  if ledger_clears(op) { l[0].items[item.value].escrow_to = CharacterId.{value = -1}; }
  ledger_bump(l, c);
  if ledger_moves(op) { ledger_bump(l, to); }
  if ledger_settles(op) { ledger_bump(l, l[0].items[item.value].owner); }   // its new owner, the escrow party
}
// A new owner generation for character c reaches the store (control.coax): older writers are fenced.
ledger_fence :: (l: [] ItemLedger, c: CharacterId, gen: OwnerGeneration) -> bool #effects(reads, writes, traps) { return control_fence(l[0].fence[..], c, gen.value) == CONTROL_OK; }


// A consumer of the outbox: it takes entries in sequence and skips one it has seen; a gap waits for
// the missing entry.
LedgerView :: struct { seen: int; }
ledger_consume :: (v: [] LedgerView, e: LedgerEntry) -> bool #effects(reads, writes, traps) {
  if e.seq != v[0].seen + 1 { return false; }
  v[0].seen = e.seq;
  return true;
}
// Restore: replay the first n outbox entries onto an empty ledger; true when the items, owners and
// versions equal l's (the audit's reconciliation).
ledger_reconcile :: (l: [] ItemLedger, n: int) -> bool #effects(reads, writes, traps) {
  r: [1] ItemLedger;
  for i: 0..<n { e := l[0].out[i]; ledger_mutate(r[..], e.op, e.c, e.item, e.to, e.kind); }
  for i: 0..<LEDGER_ITEMS {
    a := l[0].items[i]; b := r[0].items[i];
    if a.live != b.live || a.kind != b.kind || a.owner != b.owner || a.escrow_to != b.escrow_to { return false; }
  }
  for c: 0..<CONTROL_CHARACTERS { if l[0].version[c] != r[0].version[c] { return false; } }
  return true;
}

// ---- checks

ledger_ask :: (id: int, op: int, c: CharacterId, gen: OwnerGeneration, ver: int, item: ItemId, to: CharacterId, kind: int) -> LedgerAsk #effects(reads, writes, traps) {
  return LedgerAsk.{id = OperationId.{value = id}, op = op, c = c, gen = gen, ver = ver, item = item, to = to, kind = kind};
}

ledger_sent :: (a: LedgerAsk, t: int) -> LedgerAsk #effects(reads, writes, traps) { b := a; b.sent = t; return b; }

#test "ledger: a duplicate grant is answered once and applied once; another payload under its ID is refused" {
  l: [1] ItemLedger;
  #assert ledger_fence(l[..], CharacterId.{value = 1}, OwnerGeneration.{value = 1});
  a := ledger_apply(l[..], ledger_ask(10, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 7), 5);
  #assert a.status == LEDGER_OK && a.item.value == 0 && !a.replay && l[0].version[1] == 1 && l[0].out_n == 1;
  b := ledger_apply(l[..], ledger_ask(10, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 7), 6);   // the response was lost; asked again
  #assert b.status == LEDGER_OK && b.item.value == 0 && b.replay && l[0].version[1] == 1 && l[0].out_n == 1 && !l[0].items[1].live;
  c := ledger_apply(l[..], ledger_ask(10, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 8), 7);
  #assert c.status == LEDGER_CONFLICT && !l[0].items[1].live && l[0].out_n == 1;
  // a refusal is recorded: its retry hears the same, even once the version would let it through
  d := ledger_apply(l[..], ledger_ask(11, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 7), 8);
  #assert d.status == LEDGER_VERSION;
  #assert ledger_apply(l[..], ledger_ask(11, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 7), 9).status == LEDGER_VERSION && l[0].out_n == 1;
}
#test "ledger: two transfers of one item from one read: one applies, the other is refused, and nothing is duplicated" {
  l: [1] ItemLedger;
  g := ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 3), 1);
  #assert g.status == LEDGER_OK;
  x := ledger_apply(l[..], ledger_ask(2, LOP_TRANSFER, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 4}, 3), 2);
  y := ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 5}, 3), 2);
  #assert x.status == LEDGER_OK && y.status == LEDGER_VERSION && l[0].items[g.item.value].owner.value == 4;
  // with a fresh read the item is no longer theirs
  #assert ledger_apply(l[..], ledger_ask(4, LOP_TRANSFER, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, l[0].version[2], g.item, CharacterId.{value = 5}, 3), 3).status == LEDGER_HELD;
  // to themselves, or to no one: refused
  #assert ledger_apply(l[..], ledger_ask(5, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, l[0].version[4], g.item, CharacterId.{value = 4}, 3), 3).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(6, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, l[0].version[4], g.item, CharacterId.{value = -1}, 3), 3).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(7, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, l[0].version[4], ItemId.{value = 31}, CharacterId.{value = 5}, 3), 3).status == LEDGER_NO_ITEM;
}
#test "ledger: an old owner's write is refused once a new owner's generation reaches the store" {
  l: [1] ItemLedger;
  #assert ledger_fence(l[..], CharacterId.{value = 1}, OwnerGeneration.{value = 1});
  #assert ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 9), 1).status == LEDGER_OK;
  #assert ledger_fence(l[..], CharacterId.{value = 1}, OwnerGeneration.{value = 2});   // the character travelled; its new room is generation 2
  #assert ledger_apply(l[..], ledger_ask(2, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 9), 2).status == LEDGER_STALE;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 2}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 9), 2).status == LEDGER_OK && l[0].out_n == 2;
  #assert !ledger_fence(l[..], CharacterId.{value = 1}, OwnerGeneration.{value = 1});
}
#test "ledger: an escrowed item can't be spent elsewhere until it settles or cancels" {
  l: [1] ItemLedger;
  g := ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 2), 1);
  #assert ledger_apply(l[..], ledger_ask(2, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 2}, 0), 2).status == LEDGER_OK;
  v := l[0].version[1];
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, v, g.item, CharacterId.{value = 3}, 0), 3).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(4, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, v, g.item, CharacterId.{value = 3}, 0), 3).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(5, LOP_CANCEL, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, v, g.item, CharacterId.{value = -1}, 0), 4).status == LEDGER_OK && l[0].items[g.item.value].owner.value == 1;
  #assert ledger_apply(l[..], ledger_ask(6, LOP_CANCEL, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, l[0].version[1], g.item, CharacterId.{value = -1}, 0), 4).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(7, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, l[0].version[1], g.item, CharacterId.{value = 3}, 0), 5).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(8, LOP_SETTLE, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, l[0].version[1], g.item, CharacterId.{value = -1}, 0), 6).status == LEDGER_OK;
  #assert l[0].items[g.item.value].owner.value == 3 && l[0].items[g.item.value].escrow_to.value == -1 && l[0].version[3] == 1;
  #assert ledger_apply(l[..], ledger_ask(9, LOP_SETTLE, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, l[0].version[3], g.item, CharacterId.{value = -1}, 0), 6).status == LEDGER_HELD;
}
#test "ledger: the outbox is redelivered safely, a restore replays to the same state, and an old ID expires" {
  l: [1] ItemLedger; v: [1] LedgerView;
  g := ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 2), 1);
  #assert ledger_apply(l[..], ledger_ask(2, LOP_TRANSFER, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 2}, 0), 2).status == LEDGER_OK;
  #assert ledger_consume(v[..], l[0].out[0]) && !ledger_consume(v[..], l[0].out[0]);   // redelivered
  #assert ledger_consume(v[..], l[0].out[1]) && v[0].seen == 2;
  w: [1] LedgerView;
  #assert !ledger_consume(w[..], l[0].out[1]) && w[0].seen == 0;   // out of order waits
  #assert ledger_reconcile(l[..], l[0].out_n) && !ledger_reconcile(l[..], 1);
  // a retry within its window is answered from the record; one first sent LEDGER_KEEP ago or more is
  // refused, not applied twice, once its record is gone
  old := ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 2); old.sent = 1;
  r := ledger_apply(l[..], old, LEDGER_KEEP);
  #assert r.status == LEDGER_OK && r.replay && l[0].out_n == 2;
  late := ledger_ask(3, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 4); late.sent = LEDGER_KEEP + 10;
  #assert ledger_apply(l[..], late, LEDGER_KEEP + 10).status == LEDGER_OK;
  #assert ledger_apply(l[..], old, LEDGER_KEEP + 11).status == LEDGER_EXPIRED;
  #assert l[0].out_n == 3 && ledger_reconcile(l[..], 3);
}
#test "ledger: the store's limits refuse rather than overwrite" {
  l: [1] ItemLedger;
  for i: 0..<LEDGER_ITEMS { #assert ledger_apply(l[..], ledger_ask(i + 1, LOP_GRANT, CharacterId.{value = 0}, OwnerGeneration.{value = 0}, i, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 1).status == LEDGER_OK; }
  #assert ledger_apply(l[..], ledger_ask(100, LOP_GRANT, CharacterId.{value = 0}, OwnerGeneration.{value = 0}, LEDGER_ITEMS, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 1).status == LEDGER_FULL && l[0].version[0] == LEDGER_ITEMS;
  #assert ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 40}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 1).status == LEDGER_HELD;
  // full, a refusal stays the refusal it is
  #assert ledger_apply(l[..], ledger_ask(101, LOP_GRANT, CharacterId.{value = 0}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 1).status == LEDGER_VERSION;
  #assert ledger_apply(l[..], ledger_ask(102, LOP_TRANSFER, CharacterId.{value = 0}, OwnerGeneration.{value = 0}, 0, ItemId.{value = 3}, CharacterId.{value = 1}, 0), 1).status == LEDGER_VERSION;
}
#test "ledger: a version at the largest int refuses the change before anything moves, in every build (#12927)" {
  l: [1] ItemLedger;
  // character 2 one below the largest: its grant applies and reaches it; the next is refused
  l[0].version[2] = 9223372036854775806;
  #assert ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 9223372036854775806, ItemId.{value = -1}, CharacterId.{value = -1}, 4), 1).status == LEDGER_OK && l[0].version[2] == 9223372036854775807 && l[0].out_n == 1;
  r := ledger_apply(l[..], ledger_ask(2, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 9223372036854775807, ItemId.{value = -1}, CharacterId.{value = -1}, 4), 2);
  #assert r.status == LEDGER_EXHAUSTED && r.item.value == -1 && l[0].version[2] == 9223372036854775807 && l[0].out_n == 1 && !l[0].items[1].live;
  // its retry hears the same, and nothing changes
  #assert ledger_apply(l[..], ledger_ask(2, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 9223372036854775807, ItemId.{value = -1}, CharacterId.{value = -1}, 4), 3).status == LEDGER_EXHAUSTED && l[0].out_n == 1;
  // a transfer to a character at the largest: refused; the item and both versions stay
  g := ledger_apply(l[..], ledger_ask(3, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 5), 3);
  l[0].version[5] = 9223372036854775807;
  #assert ledger_apply(l[..], ledger_ask(4, LOP_TRANSFER, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 5}, 0), 4).status == LEDGER_EXHAUSTED;
  #assert l[0].items[g.item.value].owner.value == 1 && l[0].version[1] == 1 && l[0].version[5] == 9223372036854775807 && l[0].out_n == 2;
  // escrowed to it, the settle is refused and the escrow stands; to one below, it settles
  #assert ledger_apply(l[..], ledger_ask(5, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, g.item, CharacterId.{value = 5}, 0), 5).status == LEDGER_OK && l[0].version[1] == 2;
  #assert ledger_apply(l[..], ledger_ask(6, LOP_SETTLE, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 2, g.item, CharacterId.{value = -1}, 0), 6).status == LEDGER_EXHAUSTED && l[0].items[g.item.value].escrow_to.value == 5 && l[0].version[1] == 2;
  l[0].version[5] = 9223372036854775806;
  #assert ledger_apply(l[..], ledger_ask(7, LOP_SETTLE, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 2, g.item, CharacterId.{value = -1}, 0), 7).status == LEDGER_OK && l[0].items[g.item.value].owner.value == 5 && l[0].version[5] == 9223372036854775807 && l[0].version[1] == 3;
  // the writer itself at the largest: an escrow or a cancel is refused
  l[0].version[5] = 9223372036854775807;
  #assert ledger_apply(l[..], ledger_ask(8, LOP_ESCROW, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 9223372036854775807, g.item, CharacterId.{value = 1}, 0), 8).status == LEDGER_EXHAUSTED && l[0].items[g.item.value].escrow_to.value == -1;
  // a bump at the largest leaves it; one below reaches it
  ledger_bump(l[..], CharacterId.{value = 5}); #assert l[0].version[5] == 9223372036854775807;
  l[0].version[6] = 9223372036854775806; ledger_bump(l[..], CharacterId.{value = 6}); #assert l[0].version[6] == 9223372036854775807 && ledger_has_next(l[..], CharacterId.{value = 4}) && !ledger_has_next(l[..], CharacterId.{value = 6});
}
#test "ledger: each mutation's exact versions, slots and outbox; a retry differing in any field is a conflict" {
  l: [1] ItemLedger;
  g := ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 6), 1);
  #assert g.item.value == 0 && l[0].ops[0].id.value == 1 && l[0].ops[0].made.value == 0 && l[0].items[0].kind == 6 && l[0].items[0].owner.value == 3 && l[0].version[3] == 1;
  h := ledger_apply(l[..], ledger_ask(2, LOP_GRANT, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 6), 1);
  #assert h.item.value == 1 && l[0].ops[1].id.value == 2 && l[0].version[3] == 2;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 4}, 0), 2).status == LEDGER_OK && l[0].version[3] == 3 && l[0].version[4] == 1;
  e := l[0].out[2];
  #assert e.seq == 3 && e.op == LOP_TRANSFER && e.c.value == 3 && e.item.value == 0 && e.to.value == 4;
  #assert ledger_apply(l[..], ledger_ask(4, LOP_ESCROW, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 3, ItemId.{value = 1}, CharacterId.{value = 5}, 0), 3).status == LEDGER_OK && l[0].version[3] == 4 && l[0].version[5] == 0;
  #assert ledger_apply(l[..], ledger_ask(5, LOP_SETTLE, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 4, ItemId.{value = 1}, CharacterId.{value = -1}, 0), 4).status == LEDGER_OK && l[0].version[3] == 5 && l[0].version[5] == 1 && l[0].items[1].owner.value == 5;
  #assert l[0].out[4].to.value == 5 && l[0].out[3].to.value == 5 && l[0].out[0].to.value == -1;   // a settle names its receiver, the escrow party
  #assert ledger_apply(l[..], ledger_ask(6, LOP_ESCROW, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 1, ItemId.{value = 1}, CharacterId.{value = 3}, 0), 5).status == LEDGER_OK && l[0].version[5] == 2;
  #assert ledger_apply(l[..], ledger_ask(7, LOP_CANCEL, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 1}, CharacterId.{value = -1}, 0), 6).status == LEDGER_OK && l[0].version[5] == 3 && l[0].version[3] == 5 && l[0].items[1].escrow_to.value == -1;
  // one ID, one payload: any field changed is a conflict
  #assert ledger_apply(l[..], ledger_ask(3, LOP_ESCROW, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 4}, 0), 7).status == LEDGER_CONFLICT;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 4}, 0), 7).status == LEDGER_CONFLICT;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 1}, CharacterId.{value = 4}, 0), 7).status == LEDGER_CONFLICT;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 5}, 0), 7).status == LEDGER_CONFLICT;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 4}, 1), 7).status == LEDGER_CONFLICT;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_TRANSFER, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 2, ItemId.{value = 0}, CharacterId.{value = 4}, 0), 7).replay && l[0].out_n == 7;
  // the character, the item and the receiver must be real
  #assert ledger_apply(l[..], ledger_ask(20, LOP_GRANT, CharacterId.{value = -1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 8).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(21, LOP_GRANT, CharacterId.{value = CONTROL_CHARACTERS}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 8).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(22, LOP_GRANT, CharacterId.{value = CONTROL_CHARACTERS - 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 8).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(23, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, 1, ItemId.{value = -1}, CharacterId.{value = 5}, 0), 8).status == LEDGER_NO_ITEM;
  #assert ledger_apply(l[..], ledger_ask(24, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, 1, ItemId.{value = LEDGER_ITEMS}, CharacterId.{value = 5}, 0), 8).status == LEDGER_NO_ITEM;
  #assert ledger_apply(l[..], ledger_ask(25, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, 1, ItemId.{value = 0}, CharacterId.{value = CONTROL_CHARACTERS}, 0), 8).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(26, LOP_TRANSFER, CharacterId.{value = 4}, OwnerGeneration.{value = 0}, 1, ItemId.{value = 0}, CharacterId.{value = CONTROL_CHARACTERS - 1}, 0), 8).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(27, 9, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 3, ItemId.{value = 1}, CharacterId.{value = 4}, 0), 8).status == LEDGER_HELD;   // no such operation
  // character 0 is a character like any other: it receives, and an escrow to it holds the item
  #assert ledger_apply(l[..], ledger_ask(28, LOP_TRANSFER, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 3, ItemId.{value = 1}, CharacterId.{value = 0}, 0), 9).status == LEDGER_OK && l[0].items[1].owner.value == 0;
  #assert ledger_apply(l[..], ledger_ask(29, LOP_TRANSFER, CharacterId.{value = 0}, OwnerGeneration.{value = 0}, 1, ItemId.{value = 1}, CharacterId.{value = 5}, 0), 9).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(30, LOP_ESCROW, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 5, ItemId.{value = 1}, CharacterId.{value = 0}, 0), 9).status == LEDGER_OK && l[0].items[1].escrow_to.value == 0;
  #assert ledger_apply(l[..], ledger_ask(31, LOP_TRANSFER, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 6, ItemId.{value = 1}, CharacterId.{value = 4}, 0), 9).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(32, LOP_SETTLE, CharacterId.{value = 5}, OwnerGeneration.{value = 0}, 6, ItemId.{value = 1}, CharacterId.{value = -1}, 0), 9).status == LEDGER_OK && l[0].items[1].owner.value == 0;
  #assert ledger_reconcile(l[..], l[0].out_n);
}
#test "ledger: an operation is remembered exactly LEDGER_KEEP ticks, and its slot is reused after" {
  l: [1] ItemLedger;
  a := ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 2); a.sent = 10;
  #assert ledger_apply(l[..], a, 10).status == LEDGER_OK;
  #assert ledger_apply(l[..], a, 10 + LEDGER_KEEP - 1).replay && l[0].ops[0].live;
  #assert ledger_apply(l[..], a, 10 + LEDGER_KEEP).status == LEDGER_EXPIRED && !l[0].ops[0].live && l[0].out_n == 1;
  // every slot taken by refusals: the next is refused as full; once they age out, slots come back
  for i: 0..<LEDGER_OPS { #assert ledger_apply(l[..], ledger_sent(ledger_ask(100 + i, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 9, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 20000), 20000).status == LEDGER_VERSION; }
  #assert ledger_apply(l[..], ledger_sent(ledger_ask(500, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 20000), 20000).status == LEDGER_FULL;
  b := ledger_ask(500, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1); b.sent = 20000 + LEDGER_KEEP;
  #assert ledger_apply(l[..], b, 20000 + LEDGER_KEEP).status == LEDGER_OK && l[0].ops[0].id.value == 500;
}
#test "ledger: a full outbox refuses the next mutation" {
  l: [1] ItemLedger;
  #assert ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 1), 0).status == LEDGER_OK;
  for i: 1..<LEDGER_OUTBOX {
    from := ifx i % 2 == 1 then 1 else 2; to := 3 - from;
    #assert ledger_apply(l[..], ledger_sent(ledger_ask(i + 1, LOP_TRANSFER, CharacterId.{value = from}, OwnerGeneration.{value = 0}, l[0].version[from], ItemId.{value = 0}, CharacterId.{value = to}, 0), i * LEDGER_KEEP), i * LEDGER_KEEP).status == LEDGER_OK;
  }
  #assert l[0].out_n == LEDGER_OUTBOX && l[0].out[LEDGER_OUTBOX - 1].seq == LEDGER_OUTBOX;
  last := ledger_ask(999, LOP_TRANSFER, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, l[0].version[2], ItemId.{value = 0}, CharacterId.{value = 1}, 0); last.sent = LEDGER_OUTBOX * LEDGER_KEEP;
  #assert ledger_apply(l[..], last, LEDGER_OUTBOX * LEDGER_KEEP).status == LEDGER_FULL && l[0].items[0].owner.value == 2;
}
#test "ledger: reconciliation notices any field that differs" {
  l: [1] ItemLedger;
  #assert ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 4), 0).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(2, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, ItemId.{value = 0}, CharacterId.{value = 2}, 0), 0).status == LEDGER_OK;
  #assert ledger_reconcile(l[..], 2);
  l[0].items[0].kind = 5; #assert !ledger_reconcile(l[..], 2); l[0].items[0].kind = 4;
  l[0].items[0].owner = CharacterId.{value = 3}; #assert !ledger_reconcile(l[..], 2); l[0].items[0].owner = CharacterId.{value = 1};
  l[0].items[0].escrow_to = CharacterId.{value = 3}; #assert !ledger_reconcile(l[..], 2); l[0].items[0].escrow_to = CharacterId.{value = 2};
  l[0].items[5].live = true; #assert !ledger_reconcile(l[..], 2); l[0].items[5].live = false;
  l[0].version[CONTROL_CHARACTERS - 1] = 1; #assert !ledger_reconcile(l[..], 2); l[0].version[CONTROL_CHARACTERS - 1] = 0;
  l[0].version[0] = 1; #assert !ledger_reconcile(l[..], 2); l[0].version[0] = 0;
  l[0].items[LEDGER_ITEMS - 1].kind = 1; #assert !ledger_reconcile(l[..], 2); l[0].items[LEDGER_ITEMS - 1].kind = 0;
  #assert ledger_reconcile(l[..], 2);
}
#test "ledger: a consumed item is gone, once; an escrowed item, another's or none is refused (#13291)" {
  l: [1] ItemLedger;
  g := ledger_apply(l[..], ledger_ask(1, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 4), 1);
  h := ledger_apply(l[..], ledger_ask(2, LOP_GRANT, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 5), 1);
  #assert g.item.value == 0 && h.item.value == 1;
  // another's item, an escrowed item, no item
  #assert ledger_apply(l[..], ledger_ask(3, LOP_CONSUME, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 0, g.item, CharacterId.{value = -1}, 0), 2).status == LEDGER_HELD;
  #assert ledger_apply(l[..], ledger_ask(4, LOP_ESCROW, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 2, h.item, CharacterId.{value = 2}, 0), 2).status == LEDGER_OK;
  #assert ledger_apply(l[..], ledger_ask(5, LOP_CONSUME, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 3, h.item, CharacterId.{value = -1}, 0), 2).status == LEDGER_HELD && l[0].items[1].live;
  #assert ledger_apply(l[..], ledger_ask(6, LOP_CONSUME, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 3, ItemId.{value = 9}, CharacterId.{value = -1}, 0), 2).status == LEDGER_NO_ITEM;
  // its own, free: gone, the version advances, the outbox names it
  c := ledger_apply(l[..], ledger_ask(7, LOP_CONSUME, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 3, g.item, CharacterId.{value = -1}, 0), 3);
  #assert c.status == LEDGER_OK && c.item.value == 0 && !l[0].items[0].live && l[0].items[0].kind == 0 && l[0].items[0].owner.value == 0 && l[0].version[1] == 4 && l[0].out_n == 4;
  #assert l[0].out[3].op == LOP_CONSUME && l[0].out[3].item.value == 0 && l[0].out[3].c.value == 1;
  // again under its ID: the same answer, nothing more; under a new ID: there is no such item
  again := ledger_apply(l[..], ledger_ask(7, LOP_CONSUME, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 3, g.item, CharacterId.{value = -1}, 0), 4);
  #assert again.status == LEDGER_OK && again.replay && l[0].version[1] == 4 && l[0].out_n == 4;
  #assert ledger_apply(l[..], ledger_ask(8, LOP_CONSUME, CharacterId.{value = 1}, OwnerGeneration.{value = 0}, 4, g.item, CharacterId.{value = -1}, 0), 4).status == LEDGER_NO_ITEM;
  // the freed place takes the next grant, and a restore replays to the same state
  n := ledger_apply(l[..], ledger_ask(9, LOP_GRANT, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 6), 5);
  #assert n.status == LEDGER_OK && n.item.value == 0 && l[0].items[0].kind == 6 && l[0].items[0].escrow_to.value == -1 && ledger_reconcile(l[..], l[0].out_n);
  // a writer at its last version: refused before the item goes
  l[0].version[2] = 9223372036854775807;
  #assert ledger_apply(l[..], ledger_ask(10, LOP_CONSUME, CharacterId.{value = 2}, OwnerGeneration.{value = 0}, 9223372036854775807, n.item, CharacterId.{value = -1}, 0), 6).status == LEDGER_EXHAUSTED && l[0].items[0].live;
}
#test "ledger: a claim has no item: fenced and versioned like any write, applied once under its ID (#13291)" {
  l: [1] ItemLedger;
  #assert ledger_fence(l[..], CharacterId.{value = 1}, OwnerGeneration.{value = 2});
  a := ledger_apply(l[..], ledger_ask(1, LOP_CLAIM, CharacterId.{value = 1}, OwnerGeneration.{value = 2}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 1);
  #assert a.status == LEDGER_OK && a.item.value == -1 && !a.replay && l[0].version[1] == 1 && l[0].out_n == 1 && l[0].out[0].op == LOP_CLAIM && l[0].out[0].item.value == -1;
  for i: 0..<LEDGER_ITEMS { #assert !l[0].items[i].live; }
  b := ledger_apply(l[..], ledger_ask(1, LOP_CLAIM, CharacterId.{value = 1}, OwnerGeneration.{value = 2}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 2);
  #assert b.status == LEDGER_OK && b.replay && l[0].version[1] == 1 && l[0].out_n == 1;
  #assert ledger_apply(l[..], ledger_ask(2, LOP_CLAIM, CharacterId.{value = 1}, OwnerGeneration.{value = 1}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 2).status == LEDGER_STALE;
  #assert ledger_apply(l[..], ledger_ask(3, LOP_CLAIM, CharacterId.{value = 1}, OwnerGeneration.{value = 2}, 0, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 2).status == LEDGER_VERSION;
  #assert ledger_apply(l[..], ledger_ask(4, LOP_CLAIM, CharacterId.{value = 1}, OwnerGeneration.{value = 2}, 1, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 2).status == LEDGER_OK && l[0].version[1] == 2;
  #assert ledger_reconcile(l[..], l[0].out_n);
  l[0].version[3] = 9223372036854775807;
  #assert ledger_apply(l[..], ledger_ask(5, LOP_CLAIM, CharacterId.{value = 3}, OwnerGeneration.{value = 0}, 9223372036854775807, ItemId.{value = -1}, CharacterId.{value = -1}, 0), 3).status == LEDGER_EXHAUSTED;
  // the rules, on their own: a claim and a grant name no item; a consume names one that is the writer's and free
  g := OwnerGeneration.{value = 0};
  #assert ledger_rule(LOP_CLAIM, g, g, 0, 0, false, false, false, false, false, true, true, true) == LEDGER_OK && ledger_rule(LOP_GRANT, g, g, 0, 0, false, false, false, false, false, true, true, true) == LEDGER_OK;
  #assert ledger_rule(LOP_CONSUME, g, g, 0, 0, true, true, false, false, false, true, false, false) == LEDGER_OK && ledger_rule(LOP_CONSUME, g, g, 0, 0, true, true, true, false, false, true, true, true) == LEDGER_HELD;
  #assert ledger_rule(LOP_CONSUME, g, g, 0, 0, false, true, false, false, false, true, true, true) == LEDGER_NO_ITEM && ledger_rule(LOP_CONSUME, g, g, 0, 0, true, false, false, false, false, true, true, true) == LEDGER_HELD;
  #assert ledger_rule(LOP_CANCEL, g, g, 0, 0, true, true, false, false, false, true, true, true) == LEDGER_HELD && ledger_rule(LOP_CANCEL, g, g, 0, 0, true, true, true, false, false, true, true, true) == LEDGER_OK;
  #assert ledger_rule(LOP_SETTLE, g, g, 0, 0, true, true, false, false, false, true, true, true) == LEDGER_HELD && ledger_rule(LOP_SETTLE, g, g, 0, 0, true, true, true, false, false, true, true, true) == LEDGER_OK;
}
