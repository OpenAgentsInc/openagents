// Ticket v4 payload codec. The platform API signs this prefix with its existing
// HMAC SDK; room hosts authenticate the same bytes in resume-envelope.coax.
#authority;
#load "character-checkpoint.coax";
#load "../../coax/lib/text/base64.coax";
RT_TEXT :: 4096;
#test "resume envelope: canonical URL encoding and capacity refusal" {
  plain:=[7]string.["","f","fo","foo","foob","fooba","foobar"];codes:=[7]string.["","Zg","Zm8","Zm9v","Zm9vYg","Zm9vYmE","Zm9vYmFy"];
  b:[32]u8;for i:0..<7{n:=rt_url(plain[i],b[..]);#assert n==codes[i].count&&cast(string)b[0..<n]==codes[i];}
  all:[256]u8;encoded:[344]u8;back:[256]u8;for i:0..<256{all[i]=cast(u8)i;}
  n:=rt_url(cast(string)all[..],encoded[..]);for i:0..<n{if encoded[i]=='-'{encoded[i]='+';}else if encoded[i]=='_'{encoded[i]='/';}}
  #assert n==342&&b64_decode(cast(string)encoded[0..<n],back[..])==256;for i:0..<256{#assert back[i]==all[i];}
  #assert rt_url("a",b[0..<0])==-1;
  first:=[1]u8.[248];n=rt_url(cast(string)first[..],b[..]);#assert n==2&&cast(string)b[0..<n]=="-A";
  first[0]=252;n=rt_url(cast(string)first[..],b[..]);#assert n==2&&cast(string)b[0..<n]=="_A";
  #assert rt_core("v2.a")&&rt_core("v3.a")&&!rt_core("v4.a")&&!rt_core("v3.");
}
#test "resume payload: bounded complete prefix and exact caller capacity" {
  key:="v3.p-a.0.-.pair-a.1.1762190600000.-x350g7.signature";b:[4096]u8;small:[1]u8;
  #assert resume_ticket_prefix(key,"-",b[..])!="";
  #assert resume_ticket_prefix("v4.nested","-",b[..])==""&&resume_ticket_prefix(key,"{}",b[..])==""&&resume_ticket_prefix(key,"-",small[..])=="";
  #assert rt_size(4096)&&!rt_size(4097)&&rt_fit(4031,4096)&&!rt_fit(4032,4097)&&rt_fit(50,115)&&!rt_fit(50,114);
  for i:0..<257{b[i]='a';}b[0]='v';b[1]='2';b[2]='.';
  #assert rt_core(cast(string)b[0..<256])&&!rt_core(cast(string)b[0..<257]);
}
#test "resume payload: exact independent prefix bytes, complete stored capture, and exact output capacity" {
  core:="v3.p-a.0.-.pair-a.1.1762190600000.-x350g7.signature";
  expected:="v4.djMucC1hLjAuLS5wYWlyLWEuMS4xNzYyMTkwNjAwMDAwLi14MzUwZzcuc2lnbmF0dXJl.-";
  b:[4096]u8;s:=resume_ticket_prefix(core,"-",b[..]);#assert s==expected;
  #assert resume_ticket_prefix(core,"-",b[0..<expected.count])==expected&&resume_ticket_prefix(core,"-",b[0..<expected.count-1])=="";
  cap:=cc_fixture();stored:[2048]u8;saved:=cc_stored(cap,stored[..]);s=resume_ticket_prefix(core,saved,b[..]);
  start:=expected.count-1;#assert s[0..<start]==expected[0..<start];
  for i:start..<s.count{if b[i]=='-'{b[i]='+';}else if b[i]=='_'{b[i]='/';}}
  back:[2048]u8;n:=b64_decode(cast(string)b[start..<s.count],back[..]);#assert n==saved.count&&cast(string)back[0..<n]==saved;
}
rt_size :: (n:int)->bool #effects(all) {return n<=RT_TEXT;}
rt_fit :: (prefix:int,capacity:int)->bool #effects(all) {return prefix+65<=capacity&&rt_size(prefix+65);}
rt_core :: (s:string)->bool #effects(all) {return s.count>3&&s.count<=256&&(s[0..<3]=="v2."||s[0..<3]=="v3.");}
rt_url :: (s:string,out:[]u8)->int #effects(all) {
  n:=b64_encode(s,out);if n<0{return -1;}n=(s.count*8+5)/6;
  for i:0..<n{if out[i]=='+'{out[i]='-';}else if out[i]=='/'{out[i]='_';}}return n;
}
resume_ticket_prefix :: (legacy:string,saved:string,out:[]u8)->string #export_c #effects(all) {
  if !rt_core(legacy)||(saved!="-"&&!cc_read(saved,false).ok){return "";}
  b:[RT_TEXT]u8;b[0]='v';b[1]='4';b[2]='.';n:=rt_url(legacy,b[3..<b.count])+3;b[n]='.';n+=1;
  if saved=="-"{b[n]='-';n+=1;}else{n+=rt_url(saved,b[n..<b.count]);}
  if n>out.count{return "";}for i:0..<n{out[i]=b[i];}return cast(string)out[0..<n];
}
