// A seat's class and level, decided by the server (#13259; docs/protocol/seat-ticket-v5.md, "EXT").
// The API stores a character's class once (the first seat after Character Create, which the room reports
// on its vitals line) and signs it, and the level the character's stored XP gives, into the seat ticket's
// EXT as "c=CLASS,l=LEVEL" (seat_ticket_v5_class_ext). The room seats a ticketed player as the ticket
// says: the hello's level is never taken, and its class only when the ticket names none (the first seat).
// A re-hello changes nothing. Past the seat, the level only rises, as the seat's XP crosses a level of
// the one table (rules/srd/advancement.coax). The page decides class and level only where it is
// the only party: a room with no ticket keys (the page's own worker room, the checks), the local API
// stand-in's admin (room-dev.coax), and a ticket the API signed for one of the realm's admins (ACCT 2:
// the admin CLASSES and LEVEL menus, Change character), which the room tells apart (room-everglade.coax
// eg_page_decides).
//   coax/bin/coax test aethyr/session/seat-class.coax --library
//   coax/bin/coax mutate aethyr/session/seat-class.coax --library
#authority;
#load "../../rules/srd/advancement.coax";

SEAT_LEVEL_TOP :: 6;      // Everglade II's highest level: its class kits go to 6 (class-kit.coax XK_LEVELS)
SEAT_CLASS_TEXT :: 16;    // "srd-" and a class's name: "srd-barbarian" is the longest
SEAT_EXT_TEXT :: 32;      // "c=srd-barbarian,l=6" fits

// Where a hello's seat takes its class from.
SEAT_CLASS_KEEP :: 0;     // nowhere: the seat already sits, and stays as it is (a re-hello)
SEAT_CLASS_TICKET :: 1;   // the ticket's signed class
SEAT_CLASS_HELLO :: 2;    // the hello's: the page decides, or the ticket names no class (a first seat)

// A class word as the API keeps and signs it: "srd-" and 3 to 12 lowercase letters (the room knows
// which twelve are classes, fivebar.coax FB_CL_KIND).
seat_class_ok :: (class: string) -> bool #effects(all) {
  if class.count < 7 || class.count > SEAT_CLASS_TEXT || class[0..<4] != "srd-" { return false; }
  for c: class[4..<class.count] { if c < 'a' || c > 'z' { return false; } }
  return true;
}
// A level as the ticket's l item says it: 1 to SEAT_LEVEL_TOP, one digit; 0 for anything else (none).
seat_level_word :: (s: string) -> int #effects(all) {
  if s.count != 1 || s[0] < '1' || cast(int) (s[0] - '0') > SEAT_LEVEL_TOP { return 0; }
  return cast(int) (s[0] - '0');
}

// Where a hello takes its seat's class from: page, the page decides here; seated, the seat already sits
// (this is a re-hello); ticket_class, the ticket names one.
seat_class_source :: (page: bool, seated: bool, ticket_class: bool) -> int #effects(all) {
  if seated { return SEAT_CLASS_KEEP; }
  if ticket_class && !page { return SEAT_CLASS_TICKET; }
  return SEAT_CLASS_HELLO;
}
// The level a seat first sits at. Where the page decides, the hello's (hello_level, kept to 1 to the
// top). Else the ticket's signed level (ticket_level, 0 none: a v2, v3 or v4 ticket) or the level the
// seat's XP gives, whichever is more; never the hello's.
seat_level_start :: (page: bool, hello_level: int, ticket_level: int, xp: int) -> int #effects(all) {
  if page { return srd_level_from(srd_xp_at(hello_level), hello_level, SEAT_LEVEL_TOP); }   // (its own XP: the level and no more)
  return srd_level_from(xp, ticket_level, SEAT_LEVEL_TOP);
}
// A seated character's level once its XP is xp: it rises when xp crosses a level, never falls.
seat_level_up :: (now: int, xp: int) -> int #effects(all) { return srd_level_from(xp, now, SEAT_LEVEL_TOP); }

// The ticket's EXT for a character (the API's, player.c room_ticket): "c=CLASS,l=LEVEL", or "l=LEVEL"
// when it has no class kept (class "" or not a class word). LEVEL is the level its stored XP gives, at
// least start (the realm's starting level, OA_ROOM_START_LEVEL, kept to 1 to the top). Into out; the
// text, or "" when out is too small.
seat_ticket_v5_class_ext :: (class: string, xp: int, start: int, out: [] u8) -> string #export_c #effects(all) {
  if out.count < SEAT_EXT_TEXT { return ""; }
  l := srd_level_from(xp, start, SEAT_LEVEL_TOP);
  n := 0;
  if seat_class_ok(class) {
    for c: "c=" { out[n] = c; n += 1; }
    for c: class { out[n] = c; n += 1; }
    out[n] = ','; n += 1;
  }
  out[n] = 'l'; out[n + 1] = '='; out[n + 2] = cast(u8) ('0' + l); n += 3;
  return cast(string) out[0..<n];
}

#test "seat class: a kept class word is srd- and a class's letters" {
  #assert seat_class_ok("srd-fighter") && seat_class_ok("srd-barbarian") && seat_class_ok("srd-bard") && seat_class_ok("srd-abc") && seat_class_ok("srd-abcdefghijkl");
  bad := [12] string.["", "druid", "warlock", "srd-", "srd-ab", "srd-fighter-5", "srd-Fighter", "SRD-fighter", "srd_fighter", "xrd-fighter", "srd-abcdefghijklm", "srd-fight{r"];
  for b: bad { #assert !seat_class_ok(b); }
  #assert !seat_class_ok("srd-fight`r") && !seat_class_ok("sre-fighter") && !seat_class_ok("srdxfighter");
}
#test "seat class: the ticket's level item reads 1 to 6, else none" {
  for l: 1..<SEAT_LEVEL_TOP + 1 { b: [1] u8; b[0] = cast(u8) ('0' + l); #assert seat_level_word(cast(string) b[..]) == l; }
  bad := [8] string.["", "0", "7", "9", "20", "a", "-1", "1 "];
  for b: bad { #assert seat_level_word(b) == 0; }
  #assert seat_level_word("/") == 0 && seat_level_word(":") == 0;
}
#test "seat class: a re-hello keeps the seat; a first seat takes the ticket's class, else the hello's; the page's own room takes the hello's" {
  for page: 0..<2 { for t: 0..<2 { #assert seat_class_source(page == 1, true, t == 1) == SEAT_CLASS_KEEP; } }
  #assert seat_class_source(false, false, true) == SEAT_CLASS_TICKET;
  #assert seat_class_source(false, false, false) == SEAT_CLASS_HELLO;
  #assert seat_class_source(true, false, true) == SEAT_CLASS_HELLO && seat_class_source(true, false, false) == SEAT_CLASS_HELLO;
}
#test "seat class: a ticketed seat never sits at its hello's level: the ticket's, or its XP's when more" {
  // a level 1 character's ticket and a hello that says level 6 (or 20): level 1
  #assert seat_level_start(false, 6, 1, 0) == 1 && seat_level_start(false, 20, 1, 0) == 1 && seat_level_start(false, 6, 0, 0) == 1;
  #assert seat_level_start(false, 1, 5, 0) == 5 && seat_level_start(false, 6, 5, 0) == 5;
  #assert seat_level_start(false, 1, 0, 900) == 3 && seat_level_start(false, 1, 2, 6500) == 5 && seat_level_start(false, 1, 5, 2700) == 5;
  #assert seat_level_start(false, 1, 0, 9999999) == 6 && seat_level_start(false, 1, -1, 299) == 1 && seat_level_start(false, 1, 0, 300) == 2;
  #assert seat_level_start(false, 1, 6, 0) == 6;
  // where the page decides: its hello's, kept to 1 to 6
  #assert seat_level_start(true, 5, 1, 0) == 5 && seat_level_start(true, 1, 6, 9999999) == 1 && seat_level_start(true, 20, 0, 0) == 6 && seat_level_start(true, 0, 0, 0) == 1;
}
#test "seat class: XP raises a seated level through the one table, never lowers it" {
  #assert seat_level_up(1, 0) == 1 && seat_level_up(1, 299) == 1 && seat_level_up(1, 300) == 2 && seat_level_up(2, 900) == 3 && seat_level_up(1, 6500) == 5;
  #assert seat_level_up(5, 0) == 5 && seat_level_up(5, 2700) == 5 && seat_level_up(5, 14000) == 6 && seat_level_up(6, 9999999) == 6;
  #assert seat_level_up(0, 0) == 1 && seat_level_up(9, 0) == 6;
}
#test "seat class: the API's EXT carries the kept class and the stored XP's level, at least the start" {
  b: [SEAT_EXT_TEXT] u8;
  #assert seat_ticket_v5_class_ext("srd-fighter", 0, 1, b[..]) == "c=srd-fighter,l=1";
  #assert seat_ticket_v5_class_ext("srd-fighter", 6500, 1, b[..]) == "c=srd-fighter,l=5";
  #assert seat_ticket_v5_class_ext("srd-barbarian", 9999999, 1, b[..]) == "c=srd-barbarian,l=6";
  #assert seat_ticket_v5_class_ext("", 900, 1, b[..]) == "l=3" && seat_ticket_v5_class_ext("druid", 0, 1, b[..]) == "l=1";
  #assert seat_ticket_v5_class_ext("srd-wizard", 300, 4, b[..]) == "c=srd-wizard,l=4" && seat_ticket_v5_class_ext("srd-wizard", 14000, 4, b[..]) == "c=srd-wizard,l=6";
  #assert seat_ticket_v5_class_ext("srd-wizard", 0, 6, b[..]) == "c=srd-wizard,l=6" && seat_ticket_v5_class_ext("srd-wizard", 0, 7, b[..]) == "c=srd-wizard,l=6";
  #assert seat_ticket_v5_class_ext("srd-wizard", 0, 0, b[..]) == "c=srd-wizard,l=1" && seat_ticket_v5_class_ext("srd-wizard", 300, -2, b[..]) == "c=srd-wizard,l=2";
  #assert seat_ticket_v5_class_ext("srd-wizard", 0, 1, b[0..<SEAT_EXT_TEXT - 1]) == "";
  #assert seat_ticket_v5_class_ext("srd-barbarian", 0, 6, b[..]).count == 19;
}
