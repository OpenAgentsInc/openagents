// Smoke on a grid (book chapter 28): Stam's stable fluids on a 2D MAC grid,
// profile stable-fluids-2d-f64-v1. Velocity lives on cell faces (u on the
// vertical faces, v on the horizontal ones), pressure and smoke at cell
// centers. One step is: advect semi-Lagrangian (trace back by the midpoint
// rule, interpolate bilinearly), add forces, diffuse implicitly, project.
// Both solves are conjugate gradients with a Jacobi preconditioner on the
// matrix-free 5-point Laplacian, and each records its iterations and its
// final residual.
//
// The grid is periodic or a closed box. In a box the normal velocity on the
// walls is zero and the tangential velocity slips. CPU only, f64, 2D.
// Multigrid, vorticity confinement, solid cells from distance fields, 3D
// and device kernels are not built yet.
//   coax/bin/coax test --library aethyr/sim/grid-fluid.coax
#load "../rigid.coax";

GF_SIDE :: 64;
GF_FACES :: 4160;            // (64 + 1) x 64: the largest field

Gf :: struct {
  nx: int; ny: int;
  dx: f64;
  periodic: bool;
  nu: f64;                   // kinematic viscosity, m^2/s
  tolerance: f64 = 0.0000000001;   // relative residual each solve stops at
  u: [GF_FACES] f64;         // (nx + 1) x ny, at (i dx, (j + 1/2) dx)
  v: [GF_FACES] f64;         // nx x (ny + 1), at ((i + 1/2) dx, j dx)
  p: [GF_FACES] f64;         // nx x ny
  smoke: [GF_FACES] f64;     // nx x ny
  // The last step's solves.
  project_iterations: int; project_residual: f64;
  diffuse_iterations: int; diffuse_residual: f64;
}

// Scratch for a solve and for advection.
Gf_Work :: struct {
  b: [GF_FACES] f64; r: [GF_FACES] f64; z: [GF_FACES] f64; d: [GF_FACES] f64; q: [GF_FACES] f64;
  copy: [GF_FACES] f64; copy2: [GF_FACES] f64;
}

// A field of w x h values with wrap (periodic) or not. Fixed entries (the
// wall-normal faces) keep their values and act as known neighbors.
Gf_Field :: struct { w: int; h: int; wrap: bool; fixed_x: bool; fixed_y: bool; }

gf_new :: (g: [] Gf, nx: int, ny: int, dx: f64, periodic: bool) -> bool {
  if nx < 2 || ny < 2 || nx > GF_SIDE || ny > GF_SIDE { return false; }
  g[0].nx = nx; g[0].ny = ny; g[0].dx = dx; g[0].periodic = periodic; g[0].nu = 0.0;
  g[0].project_iterations = 0; g[0].project_residual = 0.0; g[0].diffuse_iterations = 0; g[0].diffuse_residual = 0.0;
  for k: 0..<GF_FACES { g[0].u[k] = 0.0; g[0].v[k] = 0.0; g[0].p[k] = 0.0; g[0].smoke[k] = 0.0; }
  return true;
}

gf_ufield :: (g: [] Gf) -> Gf_Field { return Gf_Field.{w = g[0].nx + 1, h = g[0].ny, wrap = g[0].periodic, fixed_x = !g[0].periodic}; }
gf_vfield :: (g: [] Gf) -> Gf_Field { return Gf_Field.{w = g[0].nx, h = g[0].ny + 1, wrap = g[0].periodic, fixed_y = !g[0].periodic}; }
gf_cfield :: (g: [] Gf) -> Gf_Field { return Gf_Field.{w = g[0].nx, h = g[0].ny, wrap = g[0].periodic}; }

// Whether entry (i, j) of f is fixed (a wall-normal face).
gf_fixed :: (f: Gf_Field, i: int, j: int) -> bool {
  return (f.fixed_x && (i == 0 || i == f.w - 1)) || (f.fixed_y && (j == 0 || j == f.h - 1));
}

// The width and height of f's unknowns: a periodic face field drops its
// repeated last column or row.
gf_span :: (f: Gf_Field, g: [] Gf) -> D2 {
  w := f.w; h := f.h;
  if f.wrap && f.w == g[0].nx + 1 { w = g[0].nx; }
  if f.wrap && f.h == g[0].ny + 1 { h = g[0].ny; }
  return d2(cast(f64) w, cast(f64) h);
}

// y = (alpha I + beta L) x over the unknowns, L the 5-point negative
// Laplacian times dx^2 with missing neighbors dropped (Neumann).
gf_apply :: (f: Gf_Field, w: int, h: int, alpha: f64, beta: f64, x: [] f64, y: [] f64) {
  for j: 0..<h {
    for i: 0..<w {
      k := j * f.w + i;
      if gf_fixed(f, i, j) { y[k] = x[k]; continue; }
      sum := 0.0; n := 0;
      for e: 0..<4 {
        a := i + ifx e == 0 then -1 else ifx e == 1 then 1 else 0;
        b := j + ifx e == 2 then -1 else ifx e == 3 then 1 else 0;
        if f.wrap { a = (a + w) % w; b = (b + h) % h; }
        if a < 0 || b < 0 || a >= w || b >= h { continue; }
        n += 1; sum += x[b * f.w + a];
      }
      y[k] = alpha * x[k] + beta * (cast(f64) n * x[k] - sum);
    }
  }
}
gf_diag :: (f: Gf_Field, w: int, h: int, alpha: f64, beta: f64, i: int, j: int) -> f64 {
  if gf_fixed(f, i, j) { return 1.0; }
  n := 0;
  for e: 0..<4 {
    a := i + ifx e == 0 then -1 else ifx e == 1 then 1 else 0;
    b := j + ifx e == 2 then -1 else ifx e == 3 then 1 else 0;
    if f.wrap || (a >= 0 && b >= 0 && a < w && b < h) { n += 1; }
  }
  return alpha + beta * cast(f64) n;
}

// Solves (alpha I + beta L) x = b by Jacobi-preconditioned CG from x's
// current values. A singular system (alpha 0, no fixed entry) has the
// constants as its null space: b's mean is removed and so is x's. Returns
// the iterations; *residual gets |r| / |b|.
Gf_Solve :: struct { iterations: int; residual: f64; }
gf_cg :: (f: Gf_Field, w: int, h: int, alpha: f64, beta: f64, x: [] f64, b: [] f64, work: [] Gf_Work, tolerance: f64) -> Gf_Solve {
  out: Gf_Solve; n := w * h;
  singular := alpha == 0.0 && !f.fixed_x && !f.fixed_y;
  if singular {
    mb := 0.0; mx := 0.0;
    for j: 0..<h { for i: 0..<w { mb += b[j * f.w + i]; mx += x[j * f.w + i]; } }
    for j: 0..<h { for i: 0..<w { b[j * f.w + i] -= mb / cast(f64) n; x[j * f.w + i] -= mx / cast(f64) n; } }
  }
  gf_apply(f, w, h, alpha, beta, x, work[0].q[..]);
  rz := 0.0; bb := 0.0;
  for j: 0..<h {
    for i: 0..<w {
      k := j * f.w + i;
      work[0].r[k] = b[k] - work[0].q[k];
      work[0].z[k] = work[0].r[k] / gf_diag(f, w, h, alpha, beta, i, j);
      work[0].d[k] = work[0].z[k];
      rz += work[0].r[k] * work[0].z[k]; bb += b[k] * b[k];
    }
  }
  if bb == 0.0 { bb = 1.0; }
  for step: 0..<4 * n {
    rr := 0.0;
    for j: 0..<h { for i: 0..<w { k := j * f.w + i; rr += work[0].r[k] * work[0].r[k]; } }
    out.residual = sqrt(rr / bb);
    if out.residual <= tolerance { return out; }
    gf_apply(f, w, h, alpha, beta, work[0].d[..], work[0].q[..]);
    dq := 0.0;
    for j: 0..<h { for i: 0..<w { k := j * f.w + i; dq += work[0].d[k] * work[0].q[k]; } }
    a := rz / dq; next := 0.0;
    for j: 0..<h {
      for i: 0..<w {
        k := j * f.w + i;
        x[k] += a * work[0].d[k]; work[0].r[k] -= a * work[0].q[k];
        work[0].z[k] = work[0].r[k] / gf_diag(f, w, h, alpha, beta, i, j);
        next += work[0].r[k] * work[0].z[k];
      }
    }
    for j: 0..<h { for i: 0..<w { k := j * f.w + i; work[0].d[k] = work[0].z[k] + next / rz * work[0].d[k]; } }
    rz = next; out.iterations = step + 1;
  }
  return out;
}

// A periodic face field's repeated column or row copies the first.
gf_wrap_faces :: (g: [] Gf) {
  if !g[0].periodic { return; }
  nx := g[0].nx; ny := g[0].ny;
  for j: 0..<ny { g[0].u[j * (nx + 1) + nx] = g[0].u[j * (nx + 1)]; }
  for i: 0..<nx { g[0].v[ny * nx + i] = g[0].v[i]; }
}

// Bilinear sample of a field stored w per row with origin (ox, oy) in
// cells, at point (x, y) in cells. Periodic grids wrap; boxes clamp.
gf_sample :: (g: [] Gf, a: [] f64, w: int, h: int, ox: f64, oy: f64, x: f64, y: f64) -> f64 {
  fx := x - ox; fy := y - oy;
  if g[0].periodic {
    pw := cast(f64) g[0].nx; ph := cast(f64) g[0].ny;
    fx = fx - pw * floor(fx / pw); fy = fy - ph * floor(fy / ph);
  } else {
    fx = fclamp(fx, 0.0, cast(f64) (w - 1)); fy = fclamp(fy, 0.0, cast(f64) (h - 1));
  }
  i := cast(int) floor(fx); j := cast(int) floor(fy); s := fx - cast(f64) i; t := fy - cast(f64) j;
  pw := ifx g[0].periodic then g[0].nx else w - 1; ph := ifx g[0].periodic then g[0].ny else h - 1;
  i1 := ifx g[0].periodic then (i + 1) % pw else imin(i + 1, w - 1);
  j1 := ifx g[0].periodic then (j + 1) % ph else imin(j + 1, h - 1);
  i = ifx g[0].periodic then i % pw else i; j = ifx g[0].periodic then j % ph else j;
  return (1.0 - s) * ((1.0 - t) * a[j * w + i] + t * a[j1 * w + i]) + s * ((1.0 - t) * a[j * w + i1] + t * a[j1 * w + i1]);
}
imin :: (a: int, b: int) -> int { return ifx a < b then a else b; }

// The velocity at a point in cells, from the faces.
gf_velocity :: (g: [] Gf, x: f64, y: f64) -> D2 {
  return d2(gf_sample(g, g[0].u[..], g[0].nx + 1, g[0].ny, 0.0, 0.5, x, y), gf_sample(g, g[0].v[..], g[0].nx, g[0].ny + 1, 0.5, 0.0, x, y));
}
// Where the point (x, y), in cells, came from dt ago: the midpoint rule.
gf_back :: (g: [] Gf, x: f64, y: f64, dt: f64) -> D2 {
  k := dt / g[0].dx;
  a := gf_velocity(g, x, y);
  m := gf_velocity(g, x - 0.5 * k * a.x, y - 0.5 * k * a.y);
  return d2(x - k * m.x, y - k * m.y);
}

gf_advect :: (g: [] Gf, work: [] Gf_Work, dt: f64) {
  nx := g[0].nx; ny := g[0].ny;
  for k: 0..<GF_FACES { work[0].copy[k] = g[0].u[k]; work[0].copy2[k] = g[0].v[k]; }
  // Trace from each face through a frozen copy of the old velocity.
  old: [1] Gf; old[0].nx = nx; old[0].ny = ny; old[0].dx = g[0].dx; old[0].periodic = g[0].periodic;
  for k: 0..<GF_FACES { old[0].u[k] = work[0].copy[k]; old[0].v[k] = work[0].copy2[k]; }
  for j: 0..<ny {
    for i: 0..<nx + 1 {
      if !g[0].periodic && (i == 0 || i == nx) { continue; }
      q := gf_back(old[..], cast(f64) i, cast(f64) j + 0.5, dt);
      g[0].u[j * (nx + 1) + i] = gf_sample(old[..], old[0].u[..], nx + 1, ny, 0.0, 0.5, q.x, q.y);
    }
  }
  for j: 0..<ny + 1 {
    for i: 0..<nx {
      if !g[0].periodic && (j == 0 || j == ny) { continue; }
      q := gf_back(old[..], cast(f64) i + 0.5, cast(f64) j, dt);
      g[0].v[j * nx + i] = gf_sample(old[..], old[0].v[..], nx, ny + 1, 0.5, 0.0, q.x, q.y);
    }
  }
  for k: 0..<nx * ny { work[0].copy[k] = g[0].smoke[k]; }
  for j: 0..<ny {
    for i: 0..<nx {
      q := gf_back(old[..], cast(f64) i + 0.5, cast(f64) j + 0.5, dt);
      g[0].smoke[j * nx + i] = gf_sample(old[..], work[0].copy[..], nx, ny, 0.5, 0.5, q.x, q.y);
    }
  }
  gf_wrap_faces(g);
}

// Divergence of cell (i, j), 1/s.
gf_div :: (g: [] Gf, i: int, j: int) -> f64 {
  nx := g[0].nx;
  return (g[0].u[j * (nx + 1) + i + 1] - g[0].u[j * (nx + 1) + i] + g[0].v[(j + 1) * nx + i] - g[0].v[j * nx + i]) / g[0].dx;
}
gf_max_div :: (g: [] Gf) -> f64 {
  worst := 0.0;
  for j: 0..<g[0].ny { for i: 0..<g[0].nx { worst = fmax(worst, abs(gf_div(g, i, j))); } }
  return worst;
}

// Makes the velocity divergence-free: L p = -dx^2 div / dt, then each
// interior face loses dt times the pressure difference over dx.
gf_project :: (g: [] Gf, work: [] Gf_Work, dt: f64) {
  nx := g[0].nx; ny := g[0].ny; c := gf_cfield(g);
  for j: 0..<ny { for i: 0..<nx { work[0].b[j * nx + i] = -g[0].dx * g[0].dx * gf_div(g, i, j) / dt; } }
  s := gf_cg(c, nx, ny, 0.0, 1.0, g[0].p[..], work[0].b[..], work, g[0].tolerance);
  g[0].project_iterations = s.iterations; g[0].project_residual = s.residual;
  k := dt / g[0].dx;
  for j: 0..<ny {
    for i: 0..<nx + 1 {
      if i == nx || (!g[0].periodic && i == 0) { continue; }
      left := ifx i == 0 then nx - 1 else i - 1;
      g[0].u[j * (nx + 1) + i] -= k * (g[0].p[j * nx + i] - g[0].p[j * nx + left]);
    }
  }
  for j: 0..<ny + 1 {
    for i: 0..<nx {
      if j == ny || (!g[0].periodic && j == 0) { continue; }
      below := ifx j == 0 then ny - 1 else j - 1;
      g[0].v[j * nx + i] -= k * (g[0].p[j * nx + i] - g[0].p[below * nx + i]);
    }
  }
  gf_wrap_faces(g);
}

// Implicit viscosity: (I + nu dt / dx^2 L) u' = u for each component.
gf_diffuse :: (g: [] Gf, work: [] Gf_Work, dt: f64) {
  if g[0].nu == 0.0 { g[0].diffuse_iterations = 0; g[0].diffuse_residual = 0.0; return; }
  beta := g[0].nu * dt / (g[0].dx * g[0].dx);
  fu := gf_ufield(g); su := gf_span(fu, g);
  for k: 0..<GF_FACES { work[0].b[k] = g[0].u[k]; }
  a := gf_cg(fu, cast(int) su.x, cast(int) su.y, 1.0, beta, g[0].u[..], work[0].b[..], work, g[0].tolerance);
  fv := gf_vfield(g); sv := gf_span(fv, g);
  for k: 0..<GF_FACES { work[0].b[k] = g[0].v[k]; }
  b := gf_cg(fv, cast(int) sv.x, cast(int) sv.y, 1.0, beta, g[0].v[..], work[0].b[..], work, g[0].tolerance);
  g[0].diffuse_iterations = a.iterations + b.iterations; g[0].diffuse_residual = fmax(a.residual, b.residual);
  gf_wrap_faces(g);
}

// One step of dt with uniform acceleration `gravity` and buoyancy
// `lift` m/s^2 per unit smoke upward. Advection comes first, on a velocity
// that was divergence-free (Bridson's order): forces added before it would
// be carried by an unprojected field, and still air would not stay still.
gf_step :: (g: [] Gf, work: [] Gf_Work, dt: f64, gravity: D2, lift: f64) {
  nx := g[0].nx; ny := g[0].ny;
  gf_advect(g, work, dt);
  for j: 0..<ny { for i: 0..<nx + 1 { if g[0].periodic || (i > 0 && i < nx) { g[0].u[j * (nx + 1) + i] += dt * gravity.x; } } }
  for j: 0..<ny + 1 {
    for i: 0..<nx {
      if !g[0].periodic && (j == 0 || j == ny) { continue; }
      below := ifx j == 0 then ny - 1 else j - 1; here := ifx j == ny then 0 else j;
      smoke := 0.5 * (g[0].smoke[below * nx + i] + g[0].smoke[here * nx + i]);
      g[0].v[j * nx + i] += dt * (gravity.y + lift * smoke);
    }
  }
  gf_wrap_faces(g);
  gf_diffuse(g, work, dt);
  gf_project(g, work, dt);
}

// Kinetic energy per unit density, m^4/s^2, from cell-centered velocity.
gf_energy :: (g: [] Gf) -> f64 {
  e := 0.0; nx := g[0].nx;
  for j: 0..<g[0].ny {
    for i: 0..<nx {
      u := 0.5 * (g[0].u[j * (nx + 1) + i] + g[0].u[j * (nx + 1) + i + 1]);
      v := 0.5 * (g[0].v[j * nx + i] + g[0].v[(j + 1) * nx + i]);
      e += 0.5 * (u * u + v * v) * g[0].dx * g[0].dx;
    }
  }
  return e;
}

// The smoke's mean height, m.
gf_smoke_height :: (g: [] Gf) -> f64 {
  m := 0.0; y := 0.0;
  for j: 0..<g[0].ny { for i: 0..<g[0].nx { m += g[0].smoke[j * g[0].nx + i]; y += g[0].smoke[j * g[0].nx + i] * (cast(f64) j + 0.5); } }
  return y / m * g[0].dx;
}

// The Taylor-Green vortex on a periodic square of side 2 pi:
// u = sin x cos y, v = -cos x sin y, which decays as exp(-2 nu t).
gf_taylor_green :: (g: [] Gf, n: int, nu: f64) -> bool {
  if !gf_new(g, n, n, 2.0 * PI_D / cast(f64) n, true) { return false; }
  g[0].nu = nu; h := g[0].dx;
  for j: 0..<n { for i: 0..<n + 1 { g[0].u[j * (n + 1) + i] = sin(cast(f64) i * h) * cos((cast(f64) j + 0.5) * h); } }
  for j: 0..<n + 1 { for i: 0..<n { g[0].v[j * n + i] = -cos((cast(f64) i + 0.5) * h) * sin(cast(f64) j * h); } }
  return true;
}

// ---- checks

#test "projection leaves every cell divergence-free to the solver tolerance" #steps 400000000 {
  g: [1] Gf; work: [1] Gf_Work;
  for periodic: 0..<2 {
    #assert gf_new(g[..], 24, 16, 0.1, periodic == 1);
    // A rough field: every face its own value.
    for k: 0..<GF_FACES { g[0].u[k] = sin(cast(f64) k * 0.7) + 0.3; g[0].v[k] = cos(cast(f64) k * 1.3); }
    if periodic == 0 { for j: 0..<16 { g[0].u[j * 25] = 0.0; g[0].u[j * 25 + 24] = 0.0; } for i: 0..<24 { g[0].v[i] = 0.0; g[0].v[16 * 24 + i] = 0.0; } }
    gf_wrap_faces(g[..]);
    before := gf_max_div(g[..]);
    gf_project(g[..], work[..], 0.01);
    #assert before > 1.0 && gf_max_div(g[..]) < 1e-7 && g[0].project_residual <= 1e-10 && g[0].project_iterations > 5;
  }
}

#test "a box of still air under gravity stays still: pressure holds it up" #steps 400000000 {
  g: [1] Gf; work: [1] Gf_Work;
  #assert gf_new(g[..], 16, 16, 0.1, false);
  for k: 0..<20 { gf_step(g[..], work[..], 0.05, d2(0.0, -9.81), 0.0); }
  worst := 0.0;
  for k: 0..<GF_FACES { worst = fmax(worst, fmax(abs(g[0].u[k]), abs(g[0].v[k]))); }
  #assert worst < 1e-9;
  // The pressure rises downward by g per metre (unit density): cell rows a
  // metre apart differ by 9.81.
  #assert abs(g[0].p[0] - g[0].p[10 * 16] - 9.81) < 1e-6 && abs(g[0].p[3] - g[0].p[0]) < 1e-9;
}

#test "the Taylor-Green vortex decays at least as fast as exp(-2 nu t), and finer grids add less" #steps 900000000 {
  g: [1] Gf; work: [1] Gf_Work;
  // 16 and 32 cells per side, 0.5 s at dt 0.05, nu 0.01.
  extra: [2] f64;
  for r: 0..<2 {
    n := 16 * (r + 1);
    #assert gf_taylor_green(g[..], n, 0.01);
    #assert gf_max_div(g[..]) < 0.01;
    e0 := gf_energy(g[..]);
    for k: 0..<10 { gf_step(g[..], work[..], 0.05, d2(0.0, 0.0), 0.0); }
    // Energy decays as exp(-4 nu t): solve for the viscosity that fits.
    fit := -log(gf_energy(g[..]) / e0) / (4.0 * 0.5);
    #assert fit > 0.01;
    extra[r] = fit - 0.01;
    #assert g[0].diffuse_residual <= 1e-10 && g[0].project_residual <= 1e-10;
  }
  #assert extra[1] < extra[0] && extra[1] > 0.0;
}

#test "smoke rises with buoyancy, straight up in a symmetric box" #steps 900000000 {
  g: [1] Gf; work: [1] Gf_Work;
  #assert gf_new(g[..], 16, 32, 0.05, false);
  for j: 2..<5 { for i: 6..<10 { g[0].smoke[j * 16 + i] = 1.0; } }
  y0 := gf_smoke_height(g[..]);
  for k: 0..<20 { gf_step(g[..], work[..], 0.02, d2(0.0, 0.0), 4.0); }
  #assert gf_smoke_height(g[..]) > y0 + 0.02 && gf_max_div(g[..]) < 1e-6;
  // Symmetric smoke in a symmetric box rises straight: left equals right.
  #assert abs(g[0].smoke[6 * 16 + 5] - g[0].smoke[6 * 16 + 10]) < 1e-9;
  #assert !gf_new(g[..], 65, 8, 0.1, true) && !gf_new(g[..], 1, 8, 0.1, true);
}
