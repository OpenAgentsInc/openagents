// A pinned ephemeris (book chapter 39): JPL Horizons vector tables read with
// their labels, so a state always says which time scale, frame, centre and
// dataset it is in, and a query outside the table's coverage is refused.
//
// A table is the `$$SOE`..`$$EOE` block of a Horizons VECTORS response in CSV
// (VEC_TABLE 2: JDTDB, calendar date, X, Y, Z, VX, VY, VZ in km and km/s),
// held as text in aethyr/space/fixtures/horizons.coax with its query and
// SHA-256 in that directory's README. Times are TDB instants of
// coax/lib/clock.coax (nanoseconds from 1970-01-01T00:00:00 TDB), so a UTC or
// TT time reaches a table only through that library's pinned conversions.
//
// Between rows a state is the nearest row carried by two-body motion about
// the table's centre (aethyr/orbit.coax), which is exact at a row and drifts
// with the perturbations it ignores; the checks measure that drift. Light
// time and stellar aberration are separate queries (eph_light_time,
// eph_aberrate), so a geometric state is never mistaken for an apparent one.
//   coax/bin/coax test aethyr/space/ephemeris.coax --library
#load "../orbit.coax";
#load "../../coax/lib/clock.coax";
#load "../../coax/lib/crypto/sha256-kernel.coax";
#load "fixtures/horizons.coax";

EPH_ROWS :: 64;
EPH_C :: 299792458.0;                 // m/s
// J2000.0, 2000-01-01T12:00:00, as a TDB instant; Julian date 2440587.5 is
// 1970-01-01T00:00:00.
EPH_J2000_NS :: 946728000000000000;
EPH_JD_1970 :: 2440587;

EphFrame :: enum u8 { ecliptic_j2000; icrf_equatorial; }
EphCentre :: enum u8 { sun; earth; barycentre; }
EphKind :: enum u8 { geometric; light_time; apparent; }
EphStatus :: enum u8 { ok; empty; malformed; too_many; outside; }

// Where the numbers came from: the solar-system ephemeris Horizons used and
// the SHA-256 of the exact block read (the README pins the same digest).
EphDataset :: struct { name: string; block: S_Digest; }

// One state with every label it needs: metres and metres per second, at a
// TDB instant, in a frame, about a centre, of one kind, from one dataset.
EphState :: struct { r: D3; v: D3; at: Instant(TDB); frame: EphFrame; centre: EphCentre; kind: EphKind; }

EphTable :: struct {
  rows: int; at: [EPH_ROWS] s64; r: [EPH_ROWS] D3; v: [EPH_ROWS] D3;
  frame: EphFrame; centre: EphCentre; mu: f64; dataset: EphDataset;
}
EphRead :: struct { status: EphStatus; line: int; }
EphQuery :: struct { status: EphStatus; state: EphState; }

eph_digit :: (c: u8) -> bool { return c >= '0' && c <= '9'; }
eph_pow10 :: (k: int) -> f64 { p := 1.0; for i: 0..<k { p *= 10.0; } return p; }

// Reads exactly n digits at t[i..] into v; i moves past them.
EphDigits :: struct { ok: bool; i: int; v: int; }
eph_digits :: (t: string, i: int, n: int) -> EphDigits {
  r := EphDigits.{i = i};
  for k: 0..<n { if r.i == t.count || !eph_digit(t[r.i]) { return r; } r.v = r.v * 10 + cast(int) (t[r.i] - '0'); r.i += 1; }
  r.ok = true;
  return r;
}
eph_spaces :: (t: string, i: int) -> int { j := i; while j < t.count && t[j] == ' ' { j += 1; } return j; }

// One Horizons number, in the one form Horizons prints: spaces, an optional
// minus, d.ddddddddddddddd (16 significant digits), E, a sign and two
// exponent digits, spaces. The 16 digits go into an integer and are scaled
// once by a power of ten: within an ulp or two of the decimal.
EphNumber :: struct { ok: bool; value: f64; }
eph_number :: (s: string, from: int, to: int) -> EphNumber {
  r: EphNumber; t := s[from..<to]; i := eph_spaces(t, 0);
  negative := i < t.count && t[i] == '-';
  if negative { i += 1; }
  lead := eph_digits(t, i, 1);
  if !lead.ok || lead.i == t.count || t[lead.i] != '.' { return r; }
  tail := eph_digits(t, lead.i + 1, 15);
  // E, a sign and two digits: four characters.
  if !tail.ok || tail.i + 4 > t.count || t[tail.i] != 'E' || (t[tail.i + 1] != '+' && t[tail.i + 1] != '-') { return r; }
  e := eph_digits(t, tail.i + 2, 2);
  if !e.ok || eph_spaces(t, e.i) != t.count { return r; }
  shift := ifx t[tail.i + 1] == '-' then -e.v - 15 else e.v - 15;
  value := cast(f64) (lead.v * 1000000000000000 + tail.v);
  if shift >= 0 { value *= eph_pow10(shift); } else { value /= eph_pow10(-shift); }   // mutant: equivalent (shift 0 scales by 1 either way)
  r.ok = true; r.value = ifx negative then -value else value;
  return r;
}

// A Julian date in TDB as Horizons prints it, ddddddd.ddddddddd, to a TDB
// instant in nanoseconds, exactly: (days - 2440587.5) * 86400e9 plus the
// nine decimals (in 1e-9 day) times 86400.
EphJulian :: struct { ok: bool; ns: s64; }
eph_julian :: (s: string, from: int, to: int) -> EphJulian {
  r: EphJulian; t := s[from..<to]; days := eph_digits(t, 0, 7);
  if !days.ok || days.i == t.count || t[days.i] != '.' { return r; }
  frac := eph_digits(t, days.i + 1, 9);
  if !frac.ok || frac.i != t.count { return r; }
  r.ok = true; r.ns = (days.v - EPH_JD_1970) * 86400000000000 - 43200000000000 + frac.v * 86400;
  return r;
}

// Reads one block into t. Each line is eight comma-separated fields and a
// trailing comma; times must increase. A refusal names the line (from 1).
eph_read :: (text: string, frame: EphFrame, centre: EphCentre, mu: f64, t: [] EphTable) -> EphRead {
  out: EphRead; table: EphTable; table.frame = frame; table.centre = centre; table.mu = mu;
  table.dataset.name = "DE441"; table.dataset.block = S_hash(text);
  start := 0; line := 0;
  while start < text.count {
    end := start; while end < text.count && text[end] != '\n' { end += 1; }
    line += 1;
    if table.rows == EPH_ROWS { out.status = EphStatus.too_many; out.line = line; return out; }
    cut: [9] int; n := 0; k := start;
    while k < end && n < 9 { if text[k] == ',' { cut[n] = k; n += 1; } k += 1; }
    if n != 8 || cut[7] != end - 1 { out.status = EphStatus.malformed; out.line = line; return out; }
    jd := eph_julian(text, start, cut[0]);
    f: [6] f64; ok := jd.ok;
    for j: 0..<6 { x := eph_number(text, cut[j + 1] + 1, cut[j + 2]); ok = ok && x.ok; f[j] = x.value; }
    at := jd.ns;
    if !ok || (table.rows > 0 && at <= table.at[table.rows - 1]) { out.status = EphStatus.malformed; out.line = line; return out; }
    table.at[table.rows] = at;
    table.r[table.rows] = d3(f[0] * 1000.0, f[1] * 1000.0, f[2] * 1000.0);
    table.v[table.rows] = d3(f[3] * 1000.0, f[4] * 1000.0, f[5] * 1000.0);
    table.rows += 1;
    start = end + 1;
  }
  if table.rows == 0 { out.status = EphStatus.empty; return out; }
  t[0] = table;
  return out;
}

eph_gap :: (a: s64, b: s64) -> s64 { return ifx a > b then a - b else b - a; }   // mutant: equivalent (a == b gives 0 either way)
eph_seconds :: (ns: s64) -> f64 { return cast(f64) (ns - EPH_J2000_NS) / 1000000000.0; }

// The geometric state at a TDB instant: the nearest row, carried by two-body
// motion to the instant. Outside the first to the last row is refused.
eph_at :: (t: EphTable, at: Instant(TDB)) -> EphQuery {
  q: EphQuery;
  if t.rows == 0 || at.ns < t.at[0] || at.ns > t.at[t.rows - 1] { q.status = EphStatus.outside; return q; }
  best := 0;
  for i: 1..<t.rows { if eph_gap(at.ns, t.at[i]) < eph_gap(at.ns, t.at[best]) { best = i; } }
  st := State.{r = t.r[best], v = t.v[best]};
  if at.ns != t.at[best] { st = orbit_propagate(st, t.mu, eph_seconds(t.at[best]), eph_seconds(at.ns)); }
  q.state = EphState.{r = st.r, v = st.v, at = at, frame = t.frame, centre = t.centre, kind = EphKind.geometric};
  return q;
}

// The light-time-corrected state of a target seen from an observer at its
// receive time: the target where it was when the light left, t_e solving
// t_r - t_e = |r_target(t_e) - r_obs(t_r)| / c by fixed-point iteration from
// t_e = t_r. Both must be geometric states about the same centre, in the same
// frame; the result is relative to the observer, labelled light_time, at t_r.
eph_light_time :: (target: EphTable, observer: EphState) -> EphQuery {
  q: EphQuery;
  if observer.kind != EphKind.geometric || observer.centre != target.centre || observer.frame != target.frame { q.status = EphStatus.malformed; return q; }
  emit := observer.at; e: EphQuery;
  for k: 0..<8 {   // mutant: equivalent (it converges in three; the cap only stops a loop that would not)
    e = eph_at(target, emit);
    if e.status != EphStatus.ok { q.status = e.status; return q; }
    gap := d3_len(d3_sub(e.state.r, observer.r));
    next := observer.at.ns - cast(s64) (gap / EPH_C * 1000000000.0);
    if next == emit.ns { break; }
    emit.ns = next;
  }
  q.state = EphState.{r = d3_sub(e.state.r, observer.r), v = d3_sub(e.state.v, observer.v), at = observer.at, frame = observer.frame, centre = EphCentre.earth, kind = EphKind.light_time};
  return q;
}

// Stellar aberration: the apparent direction of a light-time-corrected
// position seen by an observer moving at v_obs (barycentric), to first order
// in v/c. Horizons applies the relativistic formula for LT+S; the two agree
// to under 0.001 arcseconds here. The length stays the light-time distance;
// only the direction turns.
eph_aberrate :: (lt: EphState, v_obs: D3) -> EphQuery {
  q: EphQuery;
  if lt.kind != EphKind.light_time { q.status = EphStatus.malformed; return q; }
  // To first order in v/c the apparent direction is u + v/c; the terms
  // after that are below 0.001 arcseconds at the Earth's 30 km/s.
  d := d3_len(lt.r); w := d3_add(d3_scale(lt.r, 1.0 / d), d3_scale(v_obs, 1.0 / EPH_C));
  w = d3_scale(w, d / d3_len(w));
  q.state = lt; q.state.r = w; q.state.kind = EphKind.apparent;
  return q;
}

// ---- checks against the pinned tables
eph_load :: (text: string, centre: EphCentre, mu: f64) -> EphTable {
  t: [1] EphTable; r := eph_read(text, EphFrame.ecliptic_j2000, centre, mu, t[..]);
  #assert r.status == EphStatus.ok;
  return t[0];
}
eph_angle :: (a: D3, b: D3) -> f64 { return atan2_d(d3_len(d3_cross(a, b)), d3_dot(a, b)); }
EPH_MU_EARTH :: 403503235502000.0;    // the Earth and Moon together, DE440, m^3/s^2

#test "a Horizons number reads in Horizons' one form, and nothing else" {
  #assert eph_number(" 1.500000000000000E+02", 0, 22).value == 150.0 && eph_number("-2.500000000000000E-01 ", 0, 22).value == -0.25;
  #assert eph_number("1.234567890123456E+00", 0, 21).value == 1.234567890123456 && eph_number("9.000000000000000E+15", 0, 21).value == 9000000000000000.0;
  #assert eph_number("7.000000000000000E+21", 0, 21).value == 7000000000000000000000.0 && eph_number("3.000000000000000E-20", 0, 21).value == 0.00000000000000000003;
  // The span ends where it is told to: the rest of the string is not read.
  #assert eph_number("1.000000000000000E+01,9", 0, 21).value == 10.0;
  bad := [13] string.["", "1.5E+02", "1.50000000000000:E+02", "1.500000000000000E+0", "+1.500000000000000E+02", "1,500000000000000E+02", "1.50000000000000E+02", "1.5000000000000000E+02",
    "1.500000000000000e+02", "1.500000000000000E02", "1.500000000000000E+2", "1.500000000000000E+02x", "1.500000000000000E"];
  for b: bad { #assert !eph_number(b, 0, b.count).ok; }
  #assert !eph_number("1.500000000000000E+02", 0, 1).ok && !eph_number("-", 0, 1).ok && !eph_number("  ", 0, 2).ok;
}
#test "a Julian date is an exact TDB instant" {
  j := eph_julian("2451545.000000000", 0, 17); #assert j.ok && j.ns == EPH_J2000_NS;
  #assert eph_julian("2440587.500000000", 0, 17).ns == 0 && eph_julian("2440587.500000001", 0, 17).ns == 86400;
  #assert eph_julian("2440588.000000000", 0, 17).ns == 43200000000000;
  #assert !eph_julian("2451545.000000000", 0, 7).ok && !eph_julian("2451545:000000000", 0, 17).ok;
  bad := [6] string.["245154.5000000000", "2451545,000000000", "2451545.00000000", "2451545.0000000000", "2451545.00000000x", "24515x5.000000000"];
  for b: bad { #assert !eph_julian(b, 0, b.count).ok; }
  #assert eph_seconds(EPH_J2000_NS) == 0.0 && eph_seconds(EPH_J2000_NS + 1500000000) == 1.5 && eph_seconds(EPH_J2000_NS - 86400000000000) == -86400.0;
}
eph_join :: (a: string, b: string, buf: [] u8) -> string {
  for c, k: a { buf[k] = c; }
  for c, k: b { buf[a.count + k] = c; }
  return cast(string) buf[0..<a.count + b.count];
}
EPH_LINE :: "2451544.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00,\n";
EPH_NEXT :: "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00,\n";
#test "a table reads with its labels, and a bad line or a step back is refused by line" {
  t := eph_load(HZ_EMB, EphCentre.sun, GM_SUN);
  #assert t.rows == 41 && t.at[0] == 946684800000000000 && t.at[1] == t.at[0] + 1826 * 86400000000000 && t.centre == EphCentre.sun && t.frame == EphFrame.ecliptic_j2000 && t.mu == GM_SUN && t.dataset.name == "DE441";
  // 2000-01-01 00:00 TDB: -2.521478819505877E+07, 1.449249805618538E+08, -1.722419584468007E+02 km and its velocity.
  #assert t.r[0].x == -25214788195.05877 && t.r[0].y == 144924980561.8538 && t.r[0].z == -172241.9584468007;
  #assert abs(t.v[0].x + 29833.01944620392) < 1e-11 && abs(t.v[0].y + 5217.353546848384) < 1e-12 && abs(t.v[0].z - 0.04176555734147769) < 1e-17;
  x: [1] EphTable;
  one := eph_read(EPH_LINE, EphFrame.ecliptic_j2000, EphCentre.earth, 5.0, x[..]);
  #assert one.status == EphStatus.ok && x[0].rows == 1 && x[0].centre == EphCentre.earth && x[0].mu == 5.0 && x[0].r[0].z == 3000.0 && x[0].v[0].x == 4000.0 && x[0].v[0].z == 6000.0;
  two := [6] string.[
    "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00,\n",
    "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00, 7,\n",
    "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00\n",
    "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00, \n",
    "2451544.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00,\n",
    "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.00000000000000xE+00,\n"];
  for b: two {
    buf: [512] u8; x[0].rows = 99; r := eph_read(eph_join(EPH_LINE, b, buf[..]), EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]);
    #assert r.status == EphStatus.malformed && r.line == 2 && x[0].rows == 99;
  }
  buf: [512] u8;
  // The last line may end without a newline; a third row that steps back below the second is refused.
  last := EPH_NEXT[0..<EPH_NEXT.count - 1];
  #assert eph_read(eph_join(EPH_LINE, last, buf[..]), EphFrame.icrf_equatorial, EphCentre.sun, GM_SUN, x[..]).status == EphStatus.ok && x[0].rows == 2 && x[0].frame == EphFrame.icrf_equatorial;
  #assert eph_read(EPH_LINE[0..<EPH_LINE.count - 2], EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]).status == EphStatus.malformed;
  three: [1024] u8; mid := "2451545.000000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00,\n";
  r3 := eph_read(eph_join(eph_join(EPH_LINE, EPH_NEXT, buf[..]), mid, three[..]), EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]);
  #assert r3.status == EphStatus.malformed && r3.line == 3;
  ten := "2451545.500000000, A.D., 1.000000000000000E+00, 2.000000000000000E+00, 3.000000000000000E+00, 4.000000000000000E+00, 5.000000000000000E+00, 6.000000000000000E+00, 7, 8,\n";
  #assert eph_read(ten, EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]).line == 1;
  #assert eph_read(eph_join(EPH_LINE, EPH_NEXT, buf[..]), EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]).status == EphStatus.ok && x[0].rows == 2;
  // No space after a comma reads the same.
  tight := "2451544.500000000,A.D.,1.000000000000000E+00,-2.000000000000000E+00,3.000000000000000E+00,4.000000000000000E+00,5.000000000000000E+00,6.000000000000000E+00,\n";
  #assert eph_read(tight, EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]).status == EphStatus.ok && x[0].r[0].x == 1000.0 && x[0].r[0].y == -2000.0;
  #assert eph_read("", EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]).status == EphStatus.empty;
}
#test "a table holds at most EPH_ROWS rows" {
  // Rows on Julian days 2451100 to 2451169, each EPH_LINE's numbers.
  buf: [16384] u8; n := 0; tail := EPH_LINE.count - 17;
  for k: 0..<70 {
    head := "24511";
    for c: head { buf[n] = c; n += 1; }
    buf[n] = cast(u8) ('0' + k / 10); buf[n + 1] = cast(u8) ('0' + k % 10); n += 2;
    for i: 0..<tail + 10 { buf[n] = EPH_LINE[7 + i]; n += 1; }
  }
  x: [1] EphTable; line := n / 70;
  r := eph_read(cast(string) buf[0..<n], EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]);
  #assert r.status == EphStatus.too_many && r.line == EPH_ROWS + 1;
  r = eph_read(cast(string) buf[0..<EPH_ROWS * line], EphFrame.ecliptic_j2000, EphCentre.sun, GM_SUN, x[..]);
  #assert r.status == EphStatus.ok && x[0].rows == EPH_ROWS && x[0].at[63] - x[0].at[0] == 63 * 86400000000000;
}
#test "the block digests are the README's" {
  t := eph_load(HZ_MARS_GEO_LT, EphCentre.earth, EPH_MU_EARTH);
  // sha256 of horizons-mars-geo-lt.txt's block, as aethyr/space/fixtures/README.md records it.
  hex: [64] u8; #assert S_hex(t.dataset.block, hex[..]);
  want := "b1574bd3e1f369a8990dc0b199fbb4ad6d31c155c2581b22ec8cfc322075a1f8";
  for i: 0..<64 { #assert hex[i] == want[i]; }
}
eph_from :: (t: EphTable, row: int, at: s64) -> State { return orbit_propagate(State.{r = t.r[row], v = t.v[row]}, t.mu, eph_seconds(t.at[row]), eph_seconds(at)); }
#test "a query outside the table is refused; inside, it starts from the nearest row" {
  t := eph_load(HZ_MARS, EphCentre.sun, GM_SUN);
  #assert eph_at(t, tdb_at(t.at[0] - 1)).status == EphStatus.outside && eph_at(t, tdb_at(t.at[t.rows - 1] + 1)).status == EphStatus.outside;
  #assert eph_at(t, tdb_at(t.at[0])).status == EphStatus.ok && eph_at(t, tdb_at(t.at[t.rows - 1])).status == EphStatus.ok;
  empty: EphTable; #assert eph_at(empty, tdb_at(0)).status == EphStatus.outside;
  first := eph_at(t, tdb_at(t.at[0])); #assert first.state.r.x == t.r[0].x && first.state.v.y == t.v[0].y;
  q := eph_at(t, tdb_at(t.at[3]));
  #assert q.status == EphStatus.ok && q.state.r.x == t.r[3].x && q.state.v.z == t.v[3].z && q.state.kind == EphKind.geometric;
  #assert q.state.at.ns == t.at[3] && q.state.centre == EphCentre.sun && q.state.frame == EphFrame.ecliptic_j2000;
  // A day after row 3 and a day before row 4 start from those rows; the midpoint, a tie, from the earlier.
  day: s64 = 86400000000000;
  for c: 0..<3 {
    at := ifx c == 0 then t.at[3] + day else ifx c == 1 then t.at[4] - day else (t.at[3] + t.at[4]) / 2;
    row := ifx c == 1 then 4 else 3;
    q = eph_at(t, tdb_at(at)); want := eph_from(t, row, at);
    #assert q.state.r.x == want.r.x && q.state.r.y == want.r.y && q.state.v.x == want.v.x && q.state.at.ns == at;
  }
}
#test "two-body motion from one row reaches the next Moon row within 1,000 km" {
  t := eph_load(HZ_MOON, EphCentre.earth, EPH_MU_EARTH);
  one := t; one.rows = 2; one.at[1] = t.at[1]; one.r[1] = t.r[0]; one.v[1] = t.v[0];
  // A day of Kepler motion from row 0 against Horizons' row 1: the Sun's pull is what is missing.
  st := orbit_propagate(State.{r = t.r[0], v = t.v[0]}, EPH_MU_EARTH, eph_seconds(t.at[0]), eph_seconds(t.at[1]));
  #assert d3_len(d3_sub(st.r, t.r[1])) < 1000000.0;
}
#test "light time and aberration match Horizons' LT and LT+S states for Mars from the Earth" {
  mars := eph_load(HZ_MARS_SSB, EphCentre.barycentre, GM_SUN);
  earth := eph_load(HZ_EARTH_SSB, EphCentre.barycentre, GM_SUN);
  geo := eph_load(HZ_MARS_GEO, EphCentre.earth, EPH_MU_EARTH);
  lt := eph_load(HZ_MARS_GEO_LT, EphCentre.earth, EPH_MU_EARTH);
  lts := eph_load(HZ_MARS_GEO_LTS, EphCentre.earth, EPH_MU_EARTH);
  obs := eph_at(earth, tdb_at(earth.at[0])).state;
  // A light-time query before the table starts is refused, not extrapolated.
  #assert eph_light_time(mars, obs).status == EphStatus.outside;
  // On 2025-01-02 00:00 TDB, light left Mars about 5.4 minutes earlier.
  obs = eph_at(earth, tdb_at(earth.at[1])).state;
  ours := eph_light_time(mars, obs);
  #assert ours.status == EphStatus.ok && ours.state.kind == EphKind.light_time;
  // Within 10 m of Horizons' light-time-corrected vector, where the geometric
  // one is 7,424 km off and one iteration alone about 700 m.
  #assert d3_len(d3_sub(ours.state.r, lt.r[1])) < 10.0 && d3_len(d3_sub(geo.r[1], lt.r[1])) > 100000.0;
  // Aberration turns the direction by about 20 arcseconds; ours is within 0.01 of Horizons'.
  app := eph_aberrate(ours.state, obs.v);
  #assert app.status == EphStatus.ok && app.state.kind == EphKind.apparent;
  #assert eph_angle(app.state.r, lts.r[1]) < 0.01 / 206264.8 && eph_angle(lts.r[1], lt.r[1]) > 15.0 / 206264.8;
  // Each correction takes only the kind it corrects, from the table's centre and frame.
  #assert eph_aberrate(obs, obs.v).status == EphStatus.malformed && eph_light_time(mars, app.state).status == EphStatus.malformed;
  away := obs; away.centre = EphCentre.sun; #assert eph_light_time(mars, away).status == EphStatus.malformed;
  // The corrected states keep the observer's instant and frame, about the Earth.
  #assert ours.state.at.ns == obs.at.ns && ours.state.frame == EphFrame.ecliptic_j2000 && ours.state.centre == EphCentre.earth;
  #assert app.state.at.ns == obs.at.ns && app.state.centre == EphCentre.earth && d3_len(app.state.v) == d3_len(ours.state.v);
  // Aberration keeps the light-time distance and turns the direction toward the observer's motion.
  #assert abs(d3_len(app.state.r) - d3_len(ours.state.r)) < 0.001;
  #assert abs(eph_angle(app.state.r, ours.state.r) - eph_angle(lts.r[1], lt.r[1])) < 0.001 / 206264.8;
  // The relative velocity is the target's at emission less the observer's.
  #assert d3_len(d3_sub(ours.state.v, lt.v[1])) < 0.01;
}
