// Fixture SDK v1 observation names. Host frames, UI and derived scratch do
// not enter the canonical digest. Numeric values stay exact below 2^53.
STATE_LAB_METRICS :: 28;
STATE_LAB_METRIC_NAMES :: [STATE_LAB_METRICS]string.["tick","gate","npc_mode","water","nav","npc","credits","day","phase","status","state_tick","sequence","variant","x","z","loading","peak_bytes","claims","state_bytes","waiting","refused","applied","failed_roles","ready","frames","dropped_ns","actor_peak","saved_bytes"];
state_lab_metric_count :: ()->int #export_c #effects(all) {return STATE_LAB_METRICS;}
state_lab_metric_name :: (index:int)->string #export_c #effects(all) {if index<0 || index>=STATE_LAB_METRICS {return "";}return STATE_LAB_METRIC_NAMES[index];}
state_lab_metric :: (s:[]StateLab,index:int)->f64 #export_c #effects(all) {
 f:=s[0].world[0].facts;
 if index==0 {return f64(s[0].clock.ticks);}if index==1 {return f64(f.values[0].integer);}if index==2 {return f64(f.values[1].integer);}if index==3 {return f64(f.values[2].integer);}
 if index==4 {return ifx s[0].nav_reached then 1 else 0;}if index==5 {return ifx state_lab_npc(s) then 1 else 0;}if index==6 {return f64(s[0].credit.credits);}
 if index==7 {return f64(f.day);}if index==8 {return f64(f.phase);}if index==9 {return f64(s[0].last_status);}if index==10 {return f64(f.tick);}if index==11 {return f64(f.sequence);}if index==12 {return f64(s[0].world[0].variant);}
 if index==13 {return f64(s[0].player.pos.x);}if index==14 {return f64(s[0].player.pos.z);}if index==15 {return f64(s[0].pool[0].loading);}if index==16 {return f64(s[0].pool[0].budget[0].peak);}
 if index==17 {count:=0;for claim:s[0].pool[0].claims {if claim.live {count+=1;}}return f64(count);}if index==18 {return f64(size_of(StateLab));}if index==19 {return f64(s[0].waiting);}if index==20 {return f64(s[0].refused);}if index==21 {return f64(s[0].applied);}if index==22 {return f64(s[0].failed_roles);}
 if index==23 {return ifx s[0].ready then 1 else 0;}if index==24 {return f64(s[0].clock.frames);}if index==25 {return f64(s[0].clock.dropped_ns);}if index==26 {return f64(s[0].pool[0].budget[0].actor_peak);}if index==27 {return f64(s[0].saved_n);}return 0;
}
state_lab_hash :: (s:[]StateLab,out:[]u8)->bool #export_c #effects(all) {return assets.asset_hex(state_lab_digest(s),out);}
STATE_LAB_TRACE_TICKS :: [19]int.[120,128,144,160,161,192,193,224,256,288,320,352,384,416,448,449,480,600,640];
state_lab_observe :: (s:[]StateLab) #effects(all) {
 if !s[0].observe || s[0].trace_n>=19 {return;}row:=s[0].trace_n;if s[0].clock.ticks!=STATE_LAB_TRACE_TICKS[row] {return;}
 for i:0..<STATE_LAB_METRICS {s[0].trace_metrics[row][i]=state_lab_metric(s,i);}s[0].trace_ids[row]=state_lab_digest(s);s[0].trace_n+=1;
}
state_lab_trace_metric :: (s:[]StateLab,row:int,index:int)->f64 #export_c #effects(all) {if row<0 || row>=s[0].trace_n || index<0 || index>=STATE_LAB_METRICS {return 0;}return s[0].trace_metrics[row][index];}
state_lab_trace_hash :: (s:[]StateLab,row:int,out:[]u8)->bool #export_c #effects(all) {if row<0 || row>=s[0].trace_n {return false;}return assets.asset_hex(s[0].trace_ids[row],out);}
