// Pixel and text records for a thin Canvas2D SDK surface.
STATE_LAB_LABELS :: [15]string.["SWING [B]","WATER [T]","NPC SCHEDULE [N]","SAVE [P]","LOAD [L]","RETRY POINT [C]","RETRY [R]","NEXT DAY [J]","FAULT NEXT [F]","BAD SAVE [X]","STALE OWNER [O]","NEW GAME [G]","EDITOR RESET [E]","VISUAL TIME [V]","Declared State  |  move with WASD / arrows"];
state_lab_text :: (s:[]StateLab,index:int)->string #export_c #effects(all) {
 if index==14 && s[0].width<800 {return "Declared State | WASD / arrows";}if index==15 {return cast(string)s[0].info[0..<s[0].info_n];}if index<0 || index>=15 {return "";}return STATE_LAB_LABELS[index];
}
state_lab_rect :: (s:[]StateLab,r:StateLabRect) #effects(all) {if s[0].rect_n<128 {s[0].rects[s[0].rect_n]=r;s[0].rect_n+=1;}}
state_lab_box :: (s:[]StateLab,x:f32,y:f32,w:f32,h:f32,r:f32,g:f32,b:f32) #effects(all) {state_lab_rect(s,StateLabRect.{x=x,y=y,w=w,h=h,r=r,g=g,b=b});}
state_lab_write_info :: (s:[]StateLab) #effects(all) {
 b:=s[0].info[..];f:=s[0].world[0].facts;n:=ws_put(b,0,"Day ");n=ws_digits(b,n,f.day);n=ws_put(b,n,"  G:");n=ws_put(b,n,ifx f.values[0].integer==1 then "broken" else "intact");
 n=ws_put(b,n," N:");n=ws_put(b,n,ifx state_lab_npc(s) then "here" else "away");n=ws_put(b,n," W:");n=ws_put(b,n,ifx f.values[2].integer==1 then "high" else "low");
 n=ws_put(b,n," C:");n=ws_digits(b,n,s[0].credit.credits);n=ws_put(b,n," ");statuses:=[9]string.["ready","invalid","duplicate","stale owner","reference","capacity","variant refused","preparing","save refused"];
 n=ws_put(b,n,statuses[s[0].last_status]);s[0].info_n=ifx n<0 then 0 else n;
}
state_lab_view :: (s:[]StateLab,width:f32,height:f32) #export_c #effects(all) {
 if !s[0].ready || width<200 || height<300 {s[0].rect_n=0;return;}s[0].width=width;s[0].height=height;s[0].rect_n=0;state_lab_walls(s);state_lab_write_info(s);
 cols:=ifx width>=800 then 7 else 3;rows:=(14+cols-1)/cols;available:=height-f32(rows)*40-80;mapw:=ifx width-32<available*2 then width-32 else available*2;scale:=mapw/16;x0:=(width-mapw)/2;y0: f32=42;
 light:=f32(s[0].pixels[16])/255;state_lab_box(s,x0,y0,mapw,mapw/2,ifx s[0].visual then 0.16 else 0.10,0.18+light*0.1,ifx s[0].visual then 0.24 else 0.13);
 for i:0..<17 {state_lab_box(s,x0+f32(i)*scale,y0,0.5,mapw/2,0.23,0.29,0.24);}for i:0..<9 {state_lab_box(s,x0,y0+f32(i)*scale,mapw,0.5,0.23,0.29,0.24);}
 variant:=s[0].variants.items[s[0].world[0].variant];water:=s[0].bodies[variant.owners[3]];state_lab_box(s,x0+f32(water.words[0])*scale,y0+f32(water.words[1])*scale,f32(water.words[2]-water.words[0])*scale,f32(water.words[3]-water.words[1])*scale,0.08,0.28,ifx water.y>1 then 0.75 else 0.42);
 for i:0..<6 {at:=i*6;state_lab_box(s,x0+s[0].walls[at]*scale,y0+s[0].walls[at+2]*scale,(s[0].walls[at+3]-s[0].walls[at])*scale,(s[0].walls[at+5]-s[0].walls[at+2])*scale,0.45,0.43,0.36);}
 verts:=s[0].vertices[variant.owners[5]];state_lab_box(s,x0+verts[0]*scale,y0+verts[2]*scale,(verts[8]-verts[0])*scale,(verts[10]-verts[2])*scale,ifx verts[1]>1 then 0.8 else 0.3,0.5,0.15);
 if s[0].nav_reached {g:=navigation.NavGrid.{nx=16,nz=8,cell=1};cell:=68;for i:0..<18 {state_lab_box(s,x0+(f32(cell%16)+0.45)*scale,y0+(f32(cell/16)+0.45)*scale,scale*0.1,scale*0.1,0.4,0.85,0.48);if cell==76 {break;}next:=navigation.nav_grid_downhill(g,s[0].walk[..],s[0].cost[..],cell);if next==cell || next<0 {break;}cell=next;}}
 if state_lab_npc(s) {person:=s[0].bodies[variant.owners[0]];state_lab_box(s,x0+(f32(person.x)-0.25)*scale,y0+(f32(person.z)-0.25)*scale,scale*0.5,scale*0.5,0.95,0.55,0.28);}
 p:=s[0].player.pos;state_lab_box(s,x0+(p.x-0.22)*scale,y0+(p.z-0.22)*scale,scale*0.44,scale*0.44,0.95,0.92,0.65);
 bottom:=y0+mapw/2+16;button:=(width-32-f32(cols-1)*8)/f32(cols);
 for i:0..<14 {x:=16+f32(i%cols)*(button+8);y:=bottom+f32(i/cols)*40;state_lab_box(s,x,y,button,32,0.16,0.2,0.23);state_lab_rect(s,StateLabRect.{x=x+6,y=y+21,h=ifx cols==3 then 10 else 12,r=0.86,g=0.9,b=0.82,kind=f32(i+1)});}
 state_lab_rect(s,StateLabRect.{x=16,y=22,h=16,r=0.92,g=0.94,b=0.86,kind=15});state_lab_rect(s,StateLabRect.{x=16,y=height-12,h=ifx width<800 then 10 else 12,r=0.82,g=0.9,b=0.8,kind=16});
}
state_lab_hit :: (s:[]StateLab,x:f32,y:f32) #export_c #effects(all) {
 for i:0..<s[0].rect_n {r:=s[0].rects[i];if r.kind>=1 && r.kind<=14 && x>=r.x-6 && x<r.x-6+(s[0].width-32)/f32(ifx s[0].width>=800 then 7 else 3) && y>=r.y-21 && y<r.y+11 {state_lab_action(s,int(r.kind)-1);return;}}
}
