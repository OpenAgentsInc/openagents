// The touch controls a phone walks a realm with (the Grid first): a finger that starts on the
// left half is the move stick, from where it touched down, and pushed well past the ring you run;
// a finger that starts on the right half looks around, a quick tap there jumps, and a second
// finger there pinches to zoom. The hotbar, aethyr's HUD slots above the move stick, has one slot:
// dance. A finger that starts on it presses it; lifted on it (or near, as aethyr's buttons
// allow), you dance, or stop.
//
// The realm keeps a Sticks value and passes it back on every call. Every name here starts with
// sticks_ or STICKS_, so the Grid's session (verse/gridwalk.coax) can load it beside the walking
// controller (aethyr/player.coax). verse/grid.coax draws the stick and the slot.
//   coax/bin/coax test aethyr/sticks.coax --library
//   coax/bin/coax mutate aethyr/sticks.coax

#module "verse.sticks";

STICKS_RADIUS :: 56.0;          // the move stick's radius, in points
STICKS_RUN_PAST :: 0.8;        // pushed this far toward the ring (a full push), you run; a light push walks
STICKS_LOOK :: 0.006;          // radians per point dragged, as aethyr's drag look
STICKS_TAP_TIME :: 0.3;        // seconds: a touch shorter than this, that
STICKS_TAP_TRAVEL :: 10.0;     // moved less than this many points, is a tap
STICKS_PINCH_WHEEL :: 6.0;     // a pinch: wheel pixels per point the two fingers spread or close
STICKS_SLOT :: 46.0;           // a hotbar slot's size in points, as aethyr's on a phone
STICKS_SLOT_EDGE :: 16.0;      // from the screen's left edge
STICKS_SLOT_GAP :: 16.0;       // above the move stick's ring
STICKS_SLOT_SLOP :: 0.6;       // a lift this far off the slot (times its size) still counts

sticks_hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
sticks_near :: (a: f32, b: f32, tolerance: f32) -> bool { return abs(a - b) <= tolerance; }

Sticks :: struct {
  // The move stick: the finger's slot and where it touched down.
  move_on: bool;
  move_slot: int;
  ox: f32;
  oy: f32;
  // The look finger: its slot, where it was last, where and when it began,
  // and whether it has travelled far enough not to be a tap.
  look_on: bool;
  look_slot: int;
  lx: f32;
  ly: f32;
  sx: f32;
  sy: f32;
  since: f64;
  travelled: bool;
  // What the controller reads: the stick in [-1, 1] (x right, y forward),
  // run, the look turned since the last frame, and a jump to make.
  pad_x: f32;
  pad_y: f32;
  run: bool;
  dyaw: f32;
  dpitch: f32;
  jump: bool;
  // The hotbar: the finger on the dance slot, whether it is still over it,
  // and a dance asked for this frame, and when (for the slot's flash).
  slot_on: bool;
  slot_finger: int;
  slot_over: bool;
  dance: bool;
  danced_at: f64 = -100;
  // A second finger on the look side while one is down: a pinch, its slot,
  // where it was last, and the zoom it asked for since the last frame, in
  // wheel pixels (positive out, as the wheel's), for the host's wheel.
  pinch_on: bool;
  pinch_slot: int;
  px: f32;
  py: f32;
  zoom: f32;
}

sticks_gap :: (ax: f32, ay: f32, bx: f32, by: f32) -> f32 { return sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by)); }

// Where the move stick rests: its centre, before a thumb is down.
sticks_rest_y :: (height: f32, k: f32) -> f32 { return height - sticks_hi(f32(STICKS_RADIUS) * k * 2.4, height * 0.18); }

// The dance slot's box, in pixels: left, top, size.
SticksSlot :: struct { x: f32; y: f32; size: f32; }
sticks_dance_slot :: (height: f32, k: f32) -> SticksSlot {
  size := f32(STICKS_SLOT) * k;
  return SticksSlot.{x = f32(STICKS_SLOT_EDGE) * k, y = sticks_rest_y(height, k) - f32(STICKS_RADIUS) * k - f32(STICKS_SLOT_GAP) * k - size, size = size};
}
sticks_on_slot :: (b: SticksSlot, x: f32, y: f32, slop: f32) -> bool {
  return x >= b.x - slop && x <= b.x + b.size + slop && y >= b.y - slop && y <= b.y + b.size + slop;
}

// A touch: its slot (the host's number for the finger), phase (0 began, 1
// moved, 2 ended, 3 cancelled), where in pixels, the view's width and
// height in pixels, pixels per point, and the time in seconds.
sticks_touch :: (s: Sticks, slot: int, phase: int, x: f32, y: f32, width: f32, height: f32,
                          scale: f32, now: f64, hotbar:bool) -> Sticks {
  next := s;
  k := sticks_hi(scale, 0.5);
  hot := sticks_dance_slot(height, k);
  if phase == 0 {
    if hotbar && sticks_on_slot(hot, x, y, 0) {
      if !s.slot_on { next.slot_on = true; next.slot_finger = slot; next.slot_over = true; }
    } else if x < width / 2 {
      if !s.move_on {
        next.move_on = true; next.move_slot = slot;
        next.ox = x; next.oy = y;
      }
    } else if !s.look_on {
      next.look_on = true; next.look_slot = slot;
      next.lx = x; next.ly = y; next.sx = x; next.sy = y;
      next.since = now; next.travelled = false;
    } else if !s.pinch_on {
      next.pinch_on = true; next.pinch_slot = slot; next.px = x; next.py = y;
      next.travelled = true;   // two fingers are no tap
    }
    return next;
  }
  if s.pinch_on && slot == s.pinch_slot {
    if phase == 1 {
      next.zoom -= (sticks_gap(x, y, s.lx, s.ly) - sticks_gap(s.px, s.py, s.lx, s.ly)) / k * f32(STICKS_PINCH_WHEEL);
      next.px = x; next.py = y;
    } else { next.pinch_on = false; }
    return next;
  }
  if s.slot_on && slot == s.slot_finger {
    over := sticks_on_slot(hot, x, y, hot.size * f32(STICKS_SLOT_SLOP));
    if phase == 1 { next.slot_over = over; return next; }
    if phase == 2 && over { next.dance = true; next.danced_at = now; }
    next.slot_on = false; next.slot_over = false;
    return next;
  }
  if s.move_on && slot == s.move_slot {
    if phase == 1 {
      r := f32(STICKS_RADIUS) * k;
      dx := (x - s.ox) / r; dy := (s.oy - y) / r;
      d := sqrt(dx * dx + dy * dy);
      next.run = d > f32(STICKS_RUN_PAST);
      dx = dx / sticks_hi(d, 1); dy = dy / sticks_hi(d, 1);   // never past the ring
      next.pad_x = dx; next.pad_y = dy;
    } else {
      next.move_on = false; next.pad_x = 0; next.pad_y = 0; next.run = false;
    }
    return next;
  }
  if s.look_on && slot == s.look_slot && s.pinch_on {
    // pinching: the spread zooms and nothing turns; lifted, the other finger looks on
    if phase == 1 {
      next.zoom -= (sticks_gap(x, y, s.px, s.py) - sticks_gap(s.lx, s.ly, s.px, s.py)) / k * f32(STICKS_PINCH_WHEEL);
      next.lx = x; next.ly = y;
    } else {
      next.pinch_on = false; next.look_slot = s.pinch_slot; next.lx = s.px; next.ly = s.py;
    }
    return next;
  }
  if s.look_on && slot == s.look_slot {
    if phase == 1 {
      next.dyaw -= (x - s.lx) / k * f32(STICKS_LOOK);
      next.dpitch -= (y - s.ly) / k * f32(STICKS_LOOK);
      next.lx = x; next.ly = y;
      tx := (x - s.sx) / k; ty := (y - s.sy) / k;
      if tx * tx + ty * ty > f32(STICKS_TAP_TRAVEL * STICKS_TAP_TRAVEL) { next.travelled = true; }
    } else {
      if phase == 2 && !s.travelled && now - s.since < STICKS_TAP_TIME { next.jump = true; }
      next.look_on = false;
    }
  }
  return next;
}

// After the controller has read a frame's controls: the look and the jump
// are spent; the stick stays held.
verse_sticks_used :: (s: Sticks) -> Sticks #export_c {
  next := s;
  next.dyaw = 0; next.dpitch = 0; next.jump = false; next.dance = false; next.zoom = 0;
  return next;
}

// After a pause: no fingers are down.
verse_sticks_reset :: () -> Sticks #export_c { s: Sticks; return s; }

verse_sticks_touch :: (s:Sticks,slot:int,phase:int,x:f32,y:f32,width:f32,height:f32,scale:f32,now:f64)->Sticks #export_c {return sticks_touch(s,slot,phase,x,y,width,height,scale,now,true);}
verse_sticks_world_touch :: (s:Sticks,slot:int,phase:int,x:f32,y:f32,width:f32,height:f32,scale:f32,now:f64)->Sticks #export_c {return sticks_touch(s,slot,phase,x,y,width,height,scale,now,false);}

// ---- Checks ----

sticks_press :: (s: Sticks, slot: int, x: f32, y: f32, now: f64) -> Sticks { return verse_sticks_touch(s, slot, 0, x, y, 1000, 2000, 2, now); }
sticks_drag :: (s: Sticks, slot: int, x: f32, y: f32, now: f64) -> Sticks { return verse_sticks_touch(s, slot, 1, x, y, 1000, 2000, 2, now); }
sticks_lift :: (s: Sticks, slot: int, x: f32, y: f32, now: f64) -> Sticks { return verse_sticks_touch(s, slot, 2, x, y, 1000, 2000, 2, now); }

#test "a finger on the left is the move stick: a full push runs, a light one walks" {
  s := sticks_press(verse_sticks_reset(), 1, 200, 1500, 0);
  #assert s.move_on && !s.look_on && s.move_slot == 1;
  // Up a full radius (56 points at scale 2): forward, at full stick, running.
  s = sticks_drag(s, 1, 200, 1500 - 112, 0.1);
  #assert sticks_near(s.pad_x, 0, 0.00001) && sticks_near(s.pad_y, 1, 0.00001) && s.run;
  // Right half a radius: a light push walks.
  s = sticks_drag(s, 1, 256, 1500, 0.2);
  #assert sticks_near(s.pad_x, 0.5, 0.00001) && sticks_near(s.pad_y, 0, 0.00001) && !s.run;
  #assert !sticks_drag(s, 1, 200 + 112 * 0.75, 1500, 0.3).run;   // short of RUN_PAST
  #assert sticks_drag(s, 1, 200 + 112 * 0.85, 1500, 0.3).run;
  // Past the ring: still unit length, and running.
  s = sticks_drag(s, 1, 200 + 112 * 1.3, 1500 - 50, 0.3);
  #assert sticks_near(s.pad_x * s.pad_x + s.pad_y * s.pad_y, 1, 0.0001) && s.run;
  s = sticks_lift(s, 1, 0, 0, 0.4);
  #assert !s.move_on && s.pad_x == 0 && s.pad_y == 0 && !s.run;
}

#test "a finger on the right looks; sticks_drag right turns right, sticks_drag up looks up" {
  s := sticks_press(verse_sticks_reset(), 2, 800, 1000, 0);
  #assert s.look_on && !s.move_on && s.look_slot == 2;
  s = sticks_drag(s, 2, 900, 1000, 0.1);
  #assert sticks_near(s.dyaw, -100 / 2 * f32(STICKS_LOOK), 0.00001) && s.dpitch == 0;
  s = sticks_drag(s, 2, 900, 960, 0.2);
  #assert sticks_near(s.dpitch, 40 / 2 * f32(STICKS_LOOK), 0.00001);
  s = sticks_drag(s, 2, 900, 940, 0.2);
  #assert sticks_near(s.dpitch, 60 / 2 * f32(STICKS_LOOK), 0.00001);
  // Spent once the controller reads them; the finger stays down.
  s = verse_sticks_used(s);
  #assert s.dyaw == 0 && s.dpitch == 0 && s.look_on;
  s = sticks_drag(s, 2, 910, 960, 0.3);
  #assert sticks_near(s.dyaw, -10 / 2 * f32(STICKS_LOOK), 0.00001);
}

#test "a quick tap on the right jumps; a sticks_drag or a hold doesn't" {
  s := sticks_lift(sticks_press(verse_sticks_reset(), 3, 800, 1000, 5), 3, 802, 1000, 5.1);
  #assert s.jump && !s.look_on;
  s = verse_sticks_used(s);
  #assert !s.jump;
  // Moved more than TAP_TRAVEL points.
  t := sticks_press(verse_sticks_reset(), 3, 800, 1000, 5);
  t = sticks_drag(t, 3, 800 + 2 * 11, 1000, 5.05);
  #assert !sticks_lift(t, 3, 800, 1000, 5.1).jump;
  // Moved less than TAP_TRAVEL points, or exactly that far, any way: still a tap.
  tap := sticks_press(verse_sticks_reset(), 3, 800, 1000, 5);
  #assert sticks_lift(sticks_drag(tap, 3, 800 + 2 * 9, 1000, 5.05), 3, 800, 1000, 5.1).jump;
  #assert sticks_lift(sticks_drag(tap, 3, 800, 1000 - 2 * 9, 5.05), 3, 800, 1000, 5.1).jump;
  #assert sticks_lift(sticks_drag(tap, 3, 800 + 2 * 6, 1000 + 2 * 8, 5.05), 3, 800, 1000, 5.1).jump;
  #assert !sticks_lift(sticks_drag(tap, 3, 800, 1000 + 2 * 11, 5.05), 3, 800, 1000, 5.1).jump;
  #assert !sticks_lift(sticks_drag(tap, 3, 800 + 2 * 8, 1000 - 2 * 8, 5.05), 3, 800, 1000, 5.1).jump;
  // A drag, lifted, leaves no trace on the next tap.
  after := sticks_lift(sticks_drag(tap, 3, 900, 1000, 5.05), 3, 900, 1000, 5.1);
  #assert sticks_lift(sticks_press(after, 4, 800, 1000, 6), 4, 800, 1000, 6.1).jump;
  // Exactly TAP_TIME is too long.
  #assert !sticks_lift(sticks_press(verse_sticks_reset(), 3, 800, 1000, 0), 3, 800, 1000, 0.3).jump;
  // Held too long.
  #assert !sticks_lift(sticks_press(verse_sticks_reset(), 3, 800, 1000, 5), 3, 800, 1000, 5.35).jump;
  // Cancelled.
  #assert !verse_sticks_touch(sticks_press(verse_sticks_reset(), 3, 800, 1000, 5), 3, 3, 800, 1000, 1000, 2000, 2, 5.1).jump;
}

#test "the middle of the screen is the look side" {
  #assert sticks_press(verse_sticks_reset(), 1, 500, 1000, 0).look_on;
  #assert sticks_press(verse_sticks_reset(), 1, 499, 1000, 0).move_on;
}
#test "each finger keeps its own job" {
  s := sticks_press(verse_sticks_reset(), 1, 200, 1500, 0);
  s = sticks_press(s, 2, 800, 1000, 0);
  #assert s.move_on && s.look_on;
  // A second finger on the left is ignored; so are its moves and lift.
  s = sticks_press(s, 3, 300, 1500, 0);
  #assert s.move_slot == 1;
  s = sticks_drag(s, 3, 300, 1000, 0.1);
  #assert s.pad_y == 0 && s.dyaw == 0 && s.zoom == 0;
  s = sticks_lift(s, 3, 300, 1000, 0.1);
  #assert s.move_on && s.look_on;
  // The look finger moving doesn't move the stick, and the other way round.
  s = sticks_drag(s, 2, 850, 1000, 0.1);
  #assert s.pad_x == 0 && s.dyaw < 0;
  s = sticks_drag(s, 1, 200, 1400, 0.1);
  #assert s.pad_y > 0;
  // A second finger on the right while looking is ignored.
  t := sticks_press(s, 4, 900, 900, 0.2);
  #assert t.look_slot == 2 && t.lx == s.lx;
}

#test "touches at a small scale still count in points" {
  s := verse_sticks_touch(verse_sticks_reset(), 1, 0, 100, 500, 1000, 2000, 0, 0);
  s = verse_sticks_touch(s, 1, 1, 100 + 28, 500, 1000, 2000, 0, 0);
  // Scale is taken as at least 0.5: a 56-point radius is 28 pixels.
  #assert sticks_near(s.pad_x, 1, 0.00001);
}
#test "the dance slot sits above the move stick, at aethyr's phone size" {
  // A 1000 x 2000 pixel view at 2 pixels a point: the stick rests at
  // 2000 - 360, its ring 112 high; the slot 92 square, 32 above that.
  b := sticks_dance_slot(2000, 2);
  #assert b.size == 92 && b.x == 32 && b.y == 1640 - 112 - 32 - 92;
  // Clear of the stick's ring, and on the left.
  #assert b.y + b.size < sticks_rest_y(2000, 2) - 112 && b.x + b.size < 1000 * 0.22 - 112 + 92;
}

#test "a tap on the dance slot asks for the dance, once" {
  b := sticks_dance_slot(2000, 2);
  x := b.x + 40; y := b.y + 40;
  s := sticks_press(verse_sticks_reset(), 4, x, y, 1);
  #assert s.slot_on && s.slot_over && !s.move_on && !s.look_on && !s.dance;
  s = sticks_lift(s, 4, x, y, 1.1);
  #assert s.dance && !s.slot_on && s.danced_at == 1.1;
  #assert !verse_sticks_used(s).dance && verse_sticks_used(s).danced_at == 1.1;
}

#test "the dance slot: slid off and lifted, nothing; near enough still counts" {
  b := sticks_dance_slot(2000, 2);
  x := b.x + 40; y := b.y + 40;
  s := sticks_press(verse_sticks_reset(), 4, x, y, 1);
  s = sticks_drag(s, 4, x + 200, y, 1.1);
  #assert s.slot_on && !s.slot_over;
  #assert !sticks_lift(s, 4, x + 200, y, 1.2).dance;
  // Back within 0.6 of its size: over again, and it counts.
  s = sticks_drag(s, 4, b.x + b.size + 50, y, 1.2);
  #assert s.slot_over && sticks_lift(s, 4, b.x + b.size + 50, y, 1.3).dance;
  // Cancelled: nothing.
  t := verse_sticks_touch(sticks_press(verse_sticks_reset(), 4, x, y, 1), 4, 3, x, y, 1000, 2000, 2, 1.1);
  #assert !t.dance && !t.slot_on;
}

#test "the dance slot's finger doesn't move or look, and others still do" {
  b := sticks_dance_slot(2000, 2);
  s := sticks_press(verse_sticks_reset(), 4, b.x + 40, b.y + 40, 1);
  s = sticks_drag(s, 4, b.x + 40, b.y - 300, 1.1);
  #assert s.pad_x == 0 && s.pad_y == 0 && s.dyaw == 0;
  // A thumb on the stick meanwhile, and a look finger.
  s = sticks_press(s, 5, 200, 1700, 1.1);
  s = sticks_press(s, 6, 800, 1000, 1.1);
  #assert s.move_on && s.look_on && s.slot_on;
  // A second finger on the slot while one is there is not another press.
  u := sticks_press(s, 7, b.x + 10, b.y + 10, 1.2);
  #assert u.slot_finger == 4 && u.move_on && u.look_on;
  // Just outside the slot, it's the stick.
  v := sticks_press(verse_sticks_reset(), 8, b.x + b.size + 1, b.y + 40, 1);
  #assert v.move_on && !v.slot_on;
}
#test "two fingers on the look side pinch: spreading zooms in, closing out, and nothing turns" {
  s := sticks_press(verse_sticks_reset(), 1, 700, 1000, 0);
  s = sticks_press(s, 2, 800, 1000, 0.1);
  #assert s.pinch_on && s.look_on;
  s = sticks_drag(s, 2, 900, 1000, 0.2);    // 100 pixels apart more: 50 points at scale 2
  #assert sticks_near(s.zoom, -50 * f32(STICKS_PINCH_WHEEL), 0.001) && s.dyaw == 0 && s.dpitch == 0;
  s = verse_sticks_used(s);
  #assert s.zoom == 0;
  s = sticks_drag(s, 1, 800, 1000, 0.3);    // the first finger closes in
  #assert sticks_near(s.zoom, 50 * f32(STICKS_PINCH_WHEEL), 0.001) && s.dyaw == 0;
  // One lifts, no tap: the other looks on.
  s = sticks_lift(s, 1, 800, 1000, 0.35);
  #assert !s.pinch_on && s.look_on && !s.jump && s.look_slot == 2;
  s = sticks_drag(verse_sticks_used(s), 2, 910, 1000, 0.4);
  #assert s.dyaw < 0 && s.zoom == 0;
  s = sticks_lift(s, 2, 910, 1000, 0.5);
  #assert !s.look_on && !s.jump;
}

#test "the helpers: the larger of two, near, the distance between two points" {
  #assert sticks_hi(2, 3) == 3 && sticks_hi(3, 2) == 3 && 1 / sticks_hi(-0.0, 0.0) > 0;
  #assert sticks_near(1, 1.5, 0.5) && !sticks_near(1, 1.6, 0.5);
  #assert sticks_gap(0, 0, 3, 4) == 5 && sticks_gap(1, 2, 4, 6) == 5 && sticks_gap(4, 6, 1, 2) == 5;
}

#test "the stick rests at least 2.4 radii from the bottom, and 18% of a tall screen" {
  #assert sticks_rest_y(1000, 2) == 1000 - 56 * 2 * 2.4f32 && sticks_rest_y(2000, 2) == 2000 - 360;
}

#test "the dance slot's edges count, and its slop is 0.6 of its size" {
  b := sticks_dance_slot(2000, 2);
  #assert sticks_on_slot(b, b.x, b.y, 0) && sticks_on_slot(b, b.x + b.size, b.y + b.size, 0);
  #assert !sticks_on_slot(b, b.x - 0.01, b.y, 0) && !sticks_on_slot(b, b.x, b.y - 0.01, 0);
  #assert !sticks_on_slot(b, b.x + b.size + 0.01, b.y, 0) && !sticks_on_slot(b, b.x, b.y + b.size + 0.01, 0);
  x := b.x + 40; y := b.y + 40;
  s := sticks_press(verse_sticks_reset(), 4, x, y, 1);
  #assert !sticks_lift(s, 4, b.x + b.size + 56, y, 1.1).dance;   // past 0.6 of 92
  l := sticks_lift(s, 4, x, y, 1.1);
  #assert !l.slot_on && !l.slot_over;
  c := verse_sticks_touch(s, 4, 3, x, y, 1000, 2000, 2, 1.1);
  #assert !c.slot_on && !c.slot_over;
}

#test "a finger numbered 0 is a finger like any other" {
  s := sticks_press(verse_sticks_reset(), 0, 200, 1500, 0);
  s = sticks_drag(s, 0, 200, 1444, 0.1);    // half way up: walking at half
  #assert s.move_on && s.pad_y == 0.5 && s.pad_x == 0 && !s.run;
}

#test "a full push runs only past 0.8 of the ring" {
  s := verse_sticks_touch(verse_sticks_reset(), 1, 0, 200, 1500, 1000, 2000, 2.5, 0);
  at := verse_sticks_touch(s, 1, 1, 200, 1500 - 112, 1000, 2000, 2.5, 0.1);   // 0.8 of a 140 pixel ring
  #assert at.pad_y == 0.8 && !at.run;
  past := verse_sticks_touch(s, 1, 1, 200, 1500 - 113, 1000, 2000, 2.5, 0.1);
  #assert past.run;
}

#test "a pinch: each finger's move counts from where it was, and a third finger does nothing" {
  w := f32(STICKS_PINCH_WHEEL) / 2;   // scale 2: wheel pixels per pixel of spread
  s := sticks_press(verse_sticks_reset(), 1, 700, 1000, 0);
  s = sticks_press(s, 2, 800, 1000, 0.05);
  // the second finger moves twice; each move counts from where it was
  s = sticks_drag(s, 2, 900, 1000, 0.1); s = sticks_drag(s, 2, 950, 1040, 0.15);
  #assert sticks_near(s.zoom, -(sticks_gap(700, 1000, 950, 1040) - 100) * w, 0.001) && s.px == 950 && s.py == 1040;
  // the first finger moves twice
  s = verse_sticks_used(s);
  s = sticks_drag(s, 1, 680, 900, 0.2); s = sticks_drag(s, 1, 650, 960, 0.25);
  #assert sticks_near(s.zoom, -(sticks_gap(650, 960, 950, 1040) - sticks_gap(700, 1000, 950, 1040)) * w, 0.001);
  #assert s.lx == 650 && s.ly == 960 && s.dyaw == 0 && s.dpitch == 0;
  // a third finger on the look side moves: nothing
  t := sticks_press(s, 3, 900, 500, 0.26);
  t = sticks_drag(t, 3, 990, 400, 0.27);
  #assert t.zoom == s.zoom && t.dyaw == 0 && t.pinch_slot == 2;
  // the pinching finger lifts: no pinch, and the first looks on from where it is
  u := sticks_lift(s, 2, 950, 1040, 0.28);
  #assert !u.pinch_on && u.look_on && u.look_slot == 1;
  u = sticks_drag(verse_sticks_used(u), 1, 640, 950, 0.29);
  #assert sticks_near(u.dyaw, 10 / 2 * f32(STICKS_LOOK), 0.00001) && sticks_near(u.dpitch, 10 / 2 * f32(STICKS_LOOK), 0.00001) && u.zoom == 0;
  // the first finger lifts instead: the second looks on from where it was
  v := sticks_lift(s, 1, 650, 960, 0.28);
  #assert !v.pinch_on && v.look_slot == 2 && v.lx == 950 && v.ly == 1040;
  v = sticks_drag(verse_sticks_used(v), 2, 960, 1030, 0.29);
  #assert sticks_near(v.dyaw, -10 / 2 * f32(STICKS_LOOK), 0.00001) && sticks_near(v.dpitch, 10 / 2 * f32(STICKS_LOOK), 0.00001);
}

#test "two fingers are never a tap, however quick" {
  s := sticks_press(verse_sticks_reset(), 1, 700, 1000, 0);
  s = sticks_press(s, 2, 800, 1000, 0.01);
  s = sticks_lift(s, 2, 800, 1000, 0.02);
  s = sticks_lift(s, 1, 700, 1000, 0.03);
  #assert !s.jump && !s.look_on;
}

#test "a realm with no hotbar: a finger on the slot's place is the move stick" {
  b := sticks_dance_slot(2000, 2);
  s := verse_sticks_world_touch(verse_sticks_reset(), 4, 0, b.x + 40, b.y + 40, 1000, 2000, 2, 1);
  #assert s.move_on && !s.slot_on && s.move_slot == 4;
}
