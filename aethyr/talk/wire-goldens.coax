// The NPC ask held to its fixtures (E4, #13247): proto/verse/npc-ask-v1.json names each question
// the pages write, the answers the API writes and the bodies both refuse, byte for byte. For each,
// through wire.coax:
//   - an ask's values are written to its json byte for byte, and its json reads back to its values;
//   - a refused body is refused by the reader, and its values, when it has them, by the writer;
//   - an answer's words and model are written to its json, its json reads to its words, and a
//     page's line from it is its line;
//   - a refused answer is refused, and gives a page no line.
// It also needs an ask from each page: Everglade, Fairy Forest, the Haunted House and a made realm.
// coax/web/api/test_npc.py posts the same asks and refused bodies to the API.
//   coax/web/tool.sh aethyr/talk/wire-goldens.coax [proto/verse/npc-ask-v1.json]
#import "Basic";
#load "wire.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

WG_FIXTURE :: "proto/verse/npc-ask-v1.json";
WG_STRINGS :: 65536;

wg_fail :: (what: string, name: string) -> bool { print("FAIL %: %\n", what, name); return false; }

// A string member unescaped into strings at used[0], or "" when there is none.
wg_text :: (d: Jv, at: int, strings: [] u8, used: [] int) -> string {
  n := jv_str(d, at, strings[used[0]..<strings.count]);
  if n < 0 { return ""; }
  s := cast(string) strings[used[0]..<used[0] + n]; used[0] += n; return s;
}
// The values of an ask in the fixture as a question: its strings unescaped into strings.
wg_values :: (d: Jv, v: int, turns: [] NpcTurn, strings: [] u8) -> NpcAsk {
  a: NpcAsk; u := [1] int.[0];
  a.npc = wg_text(d, jv_get(d, v, "npc"), strings, u[..]);
  a.world = wg_text(d, jv_get(d, v, "world"), strings, u[..]);
  a.realm = wg_text(d, jv_get(d, v, "realm"), strings, u[..]);
  a.has_visit = jv_get(d, v, "visit") >= 0;
  a.visit = wg_text(d, jv_get(d, v, "visit"), strings, u[..]);
  a.scene = wg_text(d, jv_get(d, v, "scene"), strings, u[..]);
  a.question = wg_text(d, jv_get(d, v, "question"), strings, u[..]);
  h := jv_get(d, v, "history"); count := jv_len(d, h);
  for i: 0..<count {
    if i >= turns.count { break; }
    t := jv_at(d, h, i);
    from := wg_text(d, jv_get(d, t, "from"), strings, u[..]);
    turns[i] = NpcTurn.{npc = from == "npc", text = wg_text(d, jv_get(d, t, "text"), strings, u[..])};
  }
  a.history = turns[0..<ifx count < turns.count then count else turns.count];
  return a;
}

wg_same :: (a: NpcAsk, b: NpcAsk) -> bool {
  if a.npc != b.npc || a.world != b.world || a.realm != b.realm || a.has_visit != b.has_visit || a.visit != b.visit { return false; }
  if a.scene != b.scene || a.question != b.question || a.history.count != b.history.count { return false; }
  for t, k: a.history { if t.npc != b.history[k].npc || t.text != b.history[k].text { return false; } }
  return true;
}

wg_field :: (d: Jv, r: int, key: string, out: [] u8) -> string {
  n := jv_str(d, jv_get(d, r, key), out);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

wg_fixture :: (path: string) -> bool {
  raw: [262144] u8; n := fs_read(path, raw[..]);
  if n <= 0 { return wg_fail("cannot read the fixture", path); }
  nodes: [16384] JvNode; d: [1] Jv;
  if !jv_parse(d[..], cast(string) raw[0..<n], nodes[..]) { return wg_fail("the fixture is not JSON", path); }
  good := true; pages := [4] bool.[false, false, false, false];
  nb: [512] u8; jb: [NPC_ASK_BYTES] u8; ob: [NPC_ASK_BYTES] u8;
  asks := jv_get(d[0], 0, "asks");
  for i: 0..<jv_len(d[0], asks) {
    r := jv_at(d[0], asks, i);
    name := wg_field(d[0], r, "name", nb[..]); json := wg_field(d[0], r, "json", jb[..]);
    turns: [NPC_HISTORY + 8] NpcTurn; strings: [WG_STRINGS] u8;
    a := wg_values(d[0], jv_get(d[0], r, "values"), turns[..], strings[..]);
    w := npc_ask_write(a, ob[..]);
    if w <= 0 || cast(string) ob[0..<w] != json {
      print("FAIL ask %: the values are not written byte for byte\n  want %\n  got  %\n", name, json, ifx w > 0 then cast(string) ob[0..<w] else "(refused)");
      good = false; continue;
    }
    got: [NPC_HISTORY] NpcTurn; gs: [NPC_ASK_BYTES] u8;
    back := npc_ask_read(json, got[..], gs[..]);
    if back.status != NpcStatus.ok || !wg_same(back.ask, a) { good = wg_fail("the json does not read back to the values", name); continue; }
    if jv_int(d[0], jv_get(d[0], r, "status"), 0) != 200 { good = wg_fail("an ask whose status is not 200", name); continue; }
    if a.realm.count > 0 { pages[3] = true; }
    else if a.world == "everglade" { pages[0] = true; }
    else if a.world == "fairy-forest" { pages[1] = true; }
    else if a.world == "haunted-house" { pages[2] = true; }
    print("ok  ask %\n", name);
  }
  if !pages[0] || !pages[1] || !pages[2] || !pages[3] { good = wg_fail("the fixture needs an ask from each page", "Everglade, Fairy Forest, the Haunted House, a made realm"); }
  refused := jv_get(d[0], 0, "refused");
  for i: 0..<jv_len(d[0], refused) {
    r := jv_at(d[0], refused, i);
    name := wg_field(d[0], r, "name", nb[..]); json := wg_field(d[0], r, "json", jb[..]);
    got: [NPC_HISTORY] NpcTurn; gs: [NPC_ASK_BYTES] u8;
    if npc_ask_read(json, got[..], gs[..]).status == NpcStatus.ok { good = wg_fail("the reader takes a refused body", name); continue; }
    if jv_get(d[0], r, "values") >= 0 {
      turns: [NPC_HISTORY + 8] NpcTurn; strings: [WG_STRINGS] u8;
      if npc_ask_write(wg_values(d[0], jv_get(d[0], r, "values"), turns[..], strings[..]), ob[..]) != -1 { good = wg_fail("the writer writes refused values", name); continue; }
    }
    if jv_int(d[0], jv_get(d[0], r, "status"), 0) < 400 { good = wg_fail("a refused body whose status is not a refusal", name); continue; }
    print("ok  refused %\n", name);
  }
  answers := jv_get(d[0], 0, "answers");
  for i: 0..<jv_len(d[0], answers) {
    r := jv_at(d[0], answers, i);
    name := wg_field(d[0], r, "name", nb[..]); json := wg_field(d[0], r, "json", jb[..]);
    tb: [NPC_ANSWER_BYTES] u8; mb: [NPC_MODEL_BYTES] u8; lb: [NPC_ANSWER_BYTES] u8;
    text := wg_field(d[0], r, "text", tb[..]); model := wg_field(d[0], r, "model", mb[..]); line := wg_field(d[0], r, "line", lb[..]);
    w := npc_answer_write(text, model, ob[..]);
    if w <= 0 || cast(string) ob[0..<w] != json { good = wg_fail("the answer is not written byte for byte", name); continue; }
    words: [NPC_ANSWER_BYTES] u8; got := npc_answer_decode(json, words[..]);
    if got.status != NpcStatus.ok || cast(string) words[0..<got.count] != text { good = wg_fail("the answer does not read to its words", name); continue; }
    k := npc_answer_text(json, words[..]);
    if cast(string) words[0..<k] != line { good = wg_fail("a page's line from the answer is not its line", name); continue; }
    print("ok  answer %\n", name);
  }
  refused_answers := jv_get(d[0], 0, "refused_answers");
  for i: 0..<jv_len(d[0], refused_answers) {
    r := jv_at(d[0], refused_answers, i);
    name := wg_field(d[0], r, "name", nb[..]); json := wg_field(d[0], r, "json", jb[..]);
    words: [NPC_ANSWER_BYTES] u8;
    if npc_answer_decode(json, words[..]).status == NpcStatus.ok || npc_answer_text(json, words[..]) != 0 { good = wg_fail("a refused answer is read", name); continue; }
    print("ok  refused answer %\n", name);
  }
  if jv_len(d[0], asks) < 4 || jv_len(d[0], refused) < 1 || jv_len(d[0], answers) < 1 || jv_len(d[0], refused_answers) < 1 {
    good = wg_fail("the fixture needs asks, refused bodies, answers and refused answers", path);
  }
  return good;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  loaded := args_load(a[..]);
  path := ifx loaded && args_count(a[..]) >= 1 then args_at(a[..], 0) else WG_FIXTURE;
  if !wg_fixture(path) { print("npc ask goldens fail\n"); return 1; }
  print("npc ask goldens hold (%)\n", path);
  return 0;
}
