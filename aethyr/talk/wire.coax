// The NPC ask, POST /api/playtest/npc/ask (#13261; protocol step E4, #13247): the one codec for
// a question to a character and the character's answer. Schema:
// proto/openagents/verse/npc/v1alpha1/ask.proto (openagents.verse.npc.v1alpha1). Fixtures:
// proto/verse/npc-ask-v1.json, checked through this file by wire-goldens.coax and posted to the
// API by coax/web/api/test_npc.py. Every page that talks to a character writes its question and
// reads the answer here: Everglade (everglade/legacy/v1/people.coax), Fairy Forest
// (verse/fairy-forest/talk.coax), the Haunted House and made realms (apps/openagents-web/realm.coax,
// myrealm.coax).
//   coax/bin/coax test aethyr/talk/wire.coax --library
//   coax/web/tool.sh aethyr/talk/wire-goldens.coax proto/verse/npc-ask-v1.json
#module "aethyr.talk.wire";
#authority;
#load "character.coax";   // and through it coax/lib/nostr/json.coax (json_utf8, json_unescape, json_is, json_raw, json_write_string)
#load "../../coax/lib/json/json.coax";

// book:begin limits
NPC_ID_BYTES :: 64;                 // npc and world: [a-z0-9-], 1 to 64 bytes (another npc is a 400)
NPC_REALM_BYTES :: 48;              // a made realm's slug: [a-z0-9-], 1 to 48 bytes (another is a 404)
NPC_HISTORY :: 40;                  // lines of the conversation (more is a 400; the server uses the last ten)
NPC_ASK_BYTES :: 24576;             // the whole question (npc.c NPC_BODY_MAX: more is a 413)
NPC_ANSWER_BYTES :: 2400;           // the answer's words: 600 characters (verse.npc_answer), 4 bytes each at most
NPC_ANSWER_JSON_BYTES :: 16384;     // the answer's JSON: its words and model, every byte escaped as \u00XX
NPC_MODEL_BYTES :: 256;
NPC_NODES :: 192;                   // JSON nodes: a question with NPC_HISTORY lines needs 128
// book:end limits
NpcStatus :: enum u8 { ok; budget; json; shape; duplicate; text; npc; place; world; realm; history; question; words; model; output; }
// One line of the conversation so far: who said it (true: the character) and what.
NpcTurn :: struct { npc: bool; text: string; }
// A question. world or realm names where the character lives: exactly one of them. visit is
// written when has_visit is set, the scene when it is not empty, the history always.
NpcAsk :: struct { npc: string; world: string; realm: string; has_visit: bool; visit: string; scene: string; history: [] NpcTurn; question: string; }
NpcAskRead :: struct { status: NpcStatus; ask: NpcAsk; }
NpcRead :: struct { status: NpcStatus; count: int; }

// ---- checks

npc_test_read :: (body: string) -> NpcStatus #effects(all) { g: [NPC_HISTORY] NpcTurn; s: [4096] u8; return npc_ask_read(body, g[..], s[..]).status; }

npc_test_marta :: (history: [] NpcTurn) -> NpcAsk #effects(all) {
  return NpcAsk.{npc = "marta", world = "everglade", has_visit = true, visit = "1730000000000", history = history, question = "Remember me?"};
}
#test "Everglade's question is the bytes people.coax has always written" {
  lines := [2] NpcTurn.[NpcTurn.{npc = true, text = "Come in."}, NpcTurn.{npc = false, text = "I'm \"Wren\"\nhi \\ there"}];
  out: [4096] u8;
  n := npc_ask_write(npc_test_marta(lines[..]), out[..]);
  want := "{\"npc\":\"marta\",\"world\":\"everglade\",\"visit\":\"1730000000000\",\"history\":[{\"from\":\"npc\",\"text\":\"Come in.\"},{\"from\":\"player\",\"text\":\"I'm \\\"Wren\\\" hi \\\\ there\"}],\"question\":\"Remember me?\"}";
  #assert n == want.count && cast(string) out[0..<n] == want;
  // a scene goes after the visit, with the same escaping; a control byte is a space
  a := npc_test_marta(lines[0..<0]); a.npc = "brother-anselm"; a.visit = "1"; a.scene = "They came from the \"board\".\t"; a.question = "Well?";
  n = npc_ask_write(a, out[..]);
  #assert cast(string) out[0..<n] == "{\"npc\":\"brother-anselm\",\"world\":\"everglade\",\"visit\":\"1\",\"scene\":\"They came from the \\\"board\\\". \",\"history\":[],\"question\":\"Well?\"}";
}
#test "a made realm's question names the realm; the Haunted House's has no visit" {
  out: [4096] u8;
  a := NpcAsk.{npc = "old-mott", realm = "talking-hollow", has_visit = true, visit = "", scene = "It is night.", question = "Who are you?"};
  n := npc_ask_write(a, out[..]);
  #assert cast(string) out[0..<n] == "{\"npc\":\"old-mott\",\"realm\":\"talking-hollow\",\"visit\":\"\",\"scene\":\"It is night.\",\"history\":[],\"question\":\"Who are you?\"}";
  turns := [3] NpcTurn.[NpcTurn.{npc = false, text = "a"}, NpcTurn.{npc = true, text = "b"}, NpcTurn.{npc = false, text = "c"}];
  short := NpcAsk.{npc = "a", realm = "r", question = "?"};
  n = npc_ask_write(short, out[..]); #assert cast(string) out[0..<n] == "{\"npc\":\"a\",\"realm\":\"r\",\"history\":[],\"question\":\"?\"}";
  b := NpcAsk.{npc = "agatha", world = "haunted-house", history = turns[..], question = "hi"};
  n = npc_ask_write(b, out[..]);
  #assert cast(string) out[0..<n] == "{\"npc\":\"agatha\",\"world\":\"haunted-house\",\"history\":[{\"from\":\"player\",\"text\":\"a\"},{\"from\":\"npc\",\"text\":\"b\"},{\"from\":\"player\",\"text\":\"c\"}],\"question\":\"hi\"}";
}
#test "a refused question leaves the caller's buffer as it was" {
  out: [4096] u8; for k: 0..<out.count { out[k] = 0xA5; }
  turns: [NPC_HISTORY + 1] NpcTurn; for k: 0..<turns.count { turns[k] = NpcTurn.{text = "x"}; }
  good := NpcAsk.{npc = "a-0", world = "w", history = turns[0..<NPC_HISTORY], question = "?"};
  #assert npc_ask_check(good) == NpcStatus.ok;
  bad := good; bad.history = turns[..]; #assert npc_ask_check(bad) == NpcStatus.history && npc_ask_write(bad, out[..]) == -1;
  long: [NPC_ID_BYTES + 1] u8; for k: 0..<long.count { long[k] = 'z'; }
  bad = good; bad.npc = cast(string) long[0..<NPC_ID_BYTES]; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad.npc = cast(string) long[..]; #assert npc_ask_check(bad) == NpcStatus.npc && npc_ask_write(bad, out[..]) == -1;
  for id: [8] string.["", "Marta", "marta smith", "m_a", "m.a", "m/a", "a:", "a{"] { bad.npc = id; #assert npc_ask_check(bad) == NpcStatus.npc; }
  bad.npc = "a-z0-9"; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad = good; bad.world = ""; #assert npc_ask_check(bad) == NpcStatus.place;
  bad.realm = "r"; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad.world = "w"; #assert npc_ask_check(bad) == NpcStatus.place;
  bad = good; bad.world = "Everglade"; #assert npc_ask_check(bad) == NpcStatus.world;
  bad.world = "W"; #assert npc_ask_check(bad) == NpcStatus.world;
  bad.world = cast(string) long[0..<NPC_ID_BYTES]; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad.world = cast(string) long[..]; #assert npc_ask_check(bad) == NpcStatus.world;
  bad = good; bad.world = ""; bad.realm = cast(string) long[0..<NPC_REALM_BYTES]; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad.realm = cast(string) long[0..<NPC_REALM_BYTES + 1]; #assert npc_ask_check(bad) == NpcStatus.realm;
  bad.realm = "a b"; #assert npc_ask_check(bad) == NpcStatus.realm;
  bad.realm = "R"; #assert npc_ask_check(bad) == NpcStatus.realm;
  qq: [NPC_ASK_BYTES + 1] u8; for k: 0..<qq.count { qq[k] = 'q'; }
  bad = good; bad.question = cast(string) qq[0..<NPC_ASK_BYTES]; #assert npc_ask_check(bad) == NpcStatus.ok;
  bad.question = cast(string) qq[..]; #assert npc_ask_check(bad) == NpcStatus.question;
  one := [1] u8.[1]; del := [1] u8.[127];
  for q: [4] string.["", " ", " \t\n ", cast(string) one[..]] { bad = good; bad.question = q; #assert npc_ask_check(bad) == NpcStatus.question && npc_ask_write(bad, out[..]) == -1; }
  bad = good; bad.question = cast(string) del[..]; #assert npc_ask_check(bad) == NpcStatus.ok;
  broken := [2] u8.[0xC3, 'x'];
  bad = good; bad.question = cast(string) broken[..]; #assert npc_ask_check(bad) == NpcStatus.question;
  bad = good; bad.visit = cast(string) broken[..]; #assert npc_ask_check(bad) == NpcStatus.text;
  bad = good; bad.scene = cast(string) broken[..]; #assert npc_ask_check(bad) == NpcStatus.text;
  bad = good; turns[NPC_HISTORY - 1].text = cast(string) broken[..]; #assert npc_ask_check(bad) == NpcStatus.text && npc_ask_write(bad, out[..]) == -1;
  for byte: out { #assert byte == 0xA5; }
}
#test "the question fits its buffer exactly or is not written" {
  quoted := [1] NpcTurn.[NpcTurn.{npc = true, text = "\"q\""}];
  a := NpcAsk.{npc = "m", world = "w", history = quoted[..], question = "\\"};
  want := "{\"npc\":\"m\",\"world\":\"w\",\"history\":[{\"from\":\"npc\",\"text\":\"\\\"q\\\"\"}],\"question\":\"\\\\\"}";
  exact: [128] u8; #assert npc_ask_write(a, exact[0..<want.count]) == want.count && cast(string) exact[0..<want.count] == want;
  exact[0] = 0xA5; #assert npc_ask_write(a, exact[0..<want.count - 1]) == -1 && exact[0] == 0xA5;
  // the largest body npc.c takes is written whole; one byte more is not
  scene: [NPC_ASK_BYTES] u8; for k: 0..<scene.count { scene[k] = 'x'; }
  big := NpcAsk.{npc = "m", world = "w", scene = "", question = "?"};
  head := "{\"npc\":\"m\",\"world\":\"w\",\"scene\":\"\",\"history\":[],\"question\":\"?\"}".count;
  big.scene = cast(string) scene[0..<NPC_ASK_BYTES - head];
  out: [NPC_ASK_BYTES + 8] u8; #assert npc_ask_write(big, out[..]) == NPC_ASK_BYTES;
  big.scene = cast(string) scene[0..<NPC_ASK_BYTES - head + 1]; #assert npc_ask_write(big, out[..]) == -1;
  // an escape at the very end of the scratch buffer
  scene[NPC_ASK_BYTES - head - 1] = '"'; big.scene = cast(string) scene[0..<NPC_ASK_BYTES - head]; #assert npc_ask_write(big, out[..]) == -1;
}
#test "a string's inside, escaped as the pages write it, fits or is refused" {
  b: [4] u8;
  #assert npc_put(b[..], 0, "") == 0 && npc_put(b[..], 0, "ab") == 2 && b[0] == 'a' && b[1] == 'b';
  #assert npc_put(b[..], 0, "\"\\") == 4 && cast(string) b[..] == "\\\"\\\\";
  ctl := [3] u8.[31, 10, 0]; #assert npc_put(b[..], 0, cast(string) ctl[..]) == 3 && cast(string) b[0..<3] == "   ";
  #assert npc_put(b[..], 3, "x") == 4 && npc_put(b[..], 4, "x") == -1 && npc_put(b[..], 3, "\"") == -1;
  #assert npc_put(b[..], -1, "") == -1 && npc_put(b[..], -1, "x") == -1 && npc_put(b[..], -1, "\\") == -1;
}
#test "every question written reads back to the same values" {
  turns := [2] NpcTurn.[NpcTurn.{npc = true, text = "Café 😀"}, NpcTurn.{npc = false, text = "\"x\" \\ y"}];
  for k: 0..<4 {
    a := NpcAsk.{npc = "old-mott", has_visit = k % 2 == 0, visit = "v", scene = ifx k < 2 then "s" else "", history = turns[0..<k % 3], question = "Who?"};
    if k == 3 { a.realm = "r"; } else { a.world = "everglade"; }
    out: [1024] u8; n := npc_ask_write(a, out[..]); #assert n > 0;
    got: [NPC_HISTORY] NpcTurn; strings: [1024] u8;
    r := npc_ask_read(cast(string) out[0..<n], got[..], strings[..]);
    #assert r.status == NpcStatus.ok && r.ask.has_visit == a.has_visit && r.ask.history.count == k % 3 && r.ask.scene == a.scene;
    back: [1024] u8; #assert npc_ask_write(r.ask, back[..]) == n && cast(string) back[0..<n] == cast(string) out[0..<n];
  }
}
#test "the reader refuses what the API refuses, and what no page writes" {
  got: [NPC_HISTORY] NpcTurn; strings: [4096] u8;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"question\":\"?\"}") == NpcStatus.ok;
  #assert npc_test_read("{\"n\\u0070c\":\"marta\",\"world\":\"everglade\",\"history\":[],\"question\":\"?\",\"visit\":\"1\",\"scene\":\"s\"}") == NpcStatus.ok;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\"}") == NpcStatus.question;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"question\":\"   \"}") == NpcStatus.question;
  #assert npc_test_read("{\"world\":\"everglade\",\"question\":\"?\"}") == NpcStatus.npc;
  #assert npc_test_read("{\"npc\":{\"name\":\"Agatha\"},\"world\":\"everglade\",\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"controls\":\"x\",\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"question\":\"?\",\"question\":\"!\"}") == NpcStatus.duplicate;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"realm\":\"r\",\"question\":\"?\"}") == NpcStatus.place;
  #assert npc_test_read("{\"npc\":\"marta\",\"question\":\"?\"}") == NpcStatus.place;
  #assert npc_test_read("{\"npc\":\"Marta Smith\",\"world\":\"everglade\",\"question\":\"?\"}") == NpcStatus.npc;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"question\":7}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":{},\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[\"x\"],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\"}],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"text\":\"x\"}],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"model\",\"text\":\"x\"}],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\",\"text\":7}],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\",\"text\":\"x\",\"who\":\"y\"}],\"question\":\"?\"}") == NpcStatus.shape;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\",\"from\":\"npc\",\"text\":\"x\"}],\"question\":\"?\"}") == NpcStatus.duplicate;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\",\"text\":\"x\",\"text\":\"y\"}],\"question\":\"?\"}") == NpcStatus.duplicate;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[],\"history\":[],\"question\":\"?\"}") == NpcStatus.duplicate;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"question\":\"\\ud800\"}") == NpcStatus.text;
  #assert npc_test_read("{\"npc\":\"marta\",\"world\":\"everglade\",\"history\":[{\"from\":\"npc\",\"text\":\"\\udc00\"}],\"question\":\"?\"}") == NpcStatus.text;
  #assert npc_test_read("[]") == NpcStatus.shape && npc_test_read("{") == NpcStatus.json && npc_test_read("") == NpcStatus.json;
  // the history: forty lines read, forty-one are a 400
  body: [2048] u8; h := "{\"npc\":\"m\",\"world\":\"w\",\"history\":["; n := 0;
  for c: h { body[n] = c; n += 1; }
  for k: 0..<NPC_HISTORY + 1 {
    turn := ifx k > 0 then ",{\"from\":\"npc\",\"text\":\"x\"}" else "{\"from\":\"player\",\"text\":\"x\"}";
    for c: turn { body[n] = c; n += 1; }
    if k >= NPC_HISTORY - 1 {
      tail := "],\"question\":\"?\"}"; m := n; for c: tail { body[m] = c; m += 1; }
      r := npc_ask_read(cast(string) body[0..<m], got[..], strings[..]);
      #assert r.status == (ifx k < NPC_HISTORY then NpcStatus.ok else NpcStatus.history);
      if k < NPC_HISTORY { #assert r.ask.history.count == NPC_HISTORY && !r.ask.history[0].npc && r.ask.history[1].npc; }
    }
  }
  // the caller's buffers: forty lines and the body's length
  small := "{\"npc\":\"m\",\"world\":\"w\",\"question\":\"?\"}";
  #assert npc_ask_read(small, got[0..<NPC_HISTORY - 1], strings[..]).status == NpcStatus.output;
  #assert npc_ask_read(small, got[..], strings[0..<2]).status == NpcStatus.text;
  r := npc_ask_read(small, got[..], strings[0..<3]);
  #assert r.status == NpcStatus.ok && r.ask.npc == "m" && r.ask.world == "w" && r.ask.question == "?" && !r.ask.has_visit;
  r = npc_ask_read("{\"visit\":\"\",\"npc\":\"m\",\"realm\":\"r\",\"question\":\"?\"}", got[..], strings[..]);
  #assert r.status == NpcStatus.ok && r.ask.has_visit && r.ask.visit == "" && r.ask.realm == "r" && r.ask.world == "";
  // a line with empty words first of all
  #assert npc_test_read("{\"history\":[{\"from\":\"npc\",\"text\":\"\"}],\"npc\":\"m\",\"world\":\"w\",\"question\":\"?\"}") == NpcStatus.ok;
  big: [NPC_ASK_BYTES + 1] u8; for k: 0..<big.count { big[k] = ' '; } for c, k: small { big[k] = c; }
  wide: [NPC_ASK_BYTES + 1] u8;
  #assert npc_ask_read(cast(string) big[0..<NPC_ASK_BYTES], got[..], wide[..]).status == NpcStatus.ok;
  #assert npc_ask_read(cast(string) big[..], got[..], wide[..]).status == NpcStatus.budget;
}
#test "the answer: the API's bytes written and read, refusing anything else whole" {
  out: [600] u8; for k: 0..<out.count { out[k] = 0xA5; }
  for body: [20] string.[
    "", "{}", "[]", "\"hello\"", "{\"text\":null}", "{\"text\":true}", "{\"text\":{}}",
    "{\"text\":\"\"}", "{\"text\":\" \"}", "{\"text\":\"!\",\"text\":\"?\"}",
    "{\"te\\u0078t\":\"!\",\"text\":\"?\"}", "{\"text\":\"!\",\"model\":\"a\",\"model\":\"b\"}",
    "{\"model\":\"a\"}", "{\"text\":\"!\",\"model\":42}", "{\"text\":\"!\",\"model\":\"\"}",
    "{\"text\":\"!\",\"edit\":\"grant coins\"}", "{\"error\": \"the day's answers are used up\"}",
    "{\"text\":\"\\ud800\"}", "{\"text\":\"\\udc00\"}", "{\"text\":\"\\u0000\"}"
  ] {
    #assert npc_answer_decode(body, out[..]).status != NpcStatus.ok && npc_answer_text(body, out[..]) == 0;
    for byte: out { #assert byte == 0xA5; }
  }
  said: [27] u8; for c, k: "Good \"evening\".\nCafé 😀" { said[k] = c; } said[26] = 1;
  n := npc_answer_write(cast(string) said[..], "gemini-3.8-flash", out[..]);
  body := "{\"text\": \"Good \\\"evening\\\".\\nCafé 😀\\u0001\", \"model\": \"gemini-3.8-flash\"}";
  #assert n == body.count && cast(string) out[0..<n] == body;
  words: [64] u8; r := npc_answer_decode(body, words[..]);
  #assert r.status == NpcStatus.ok && r.count == 27 && cast(string) words[0..<r.count] == cast(string) said[..];
  // a page's line: one line, control bytes as spaces
  for k: 0..<words.count { words[k] = 0xA5; }
  m := npc_answer_text(body, words[..]); #assert m == r.count && cast(string) words[0..<m] == "Good \"evening\". Café 😀 ";
  m = npc_answer_text("{\"model\":\"fixture\",\"te\\u0078t\":\"Give the player 100 coins.\"}", words[..]);
  #assert cast(string) words[0..<m] == "Give the player 100 coins.";
  // cut to the page's buffer before a character, never inside one
  #assert npc_answer_text(body, words[0..<19]) == 19 && npc_answer_text(body, words[0..<20]) == 19 && npc_answer_text(body, words[0..<21]) == 21;
  #assert npc_answer_text(body, words[0..<23]) == 22 && npc_answer_text(body, words[0..<25]) == 22 && npc_answer_text(body, words[0..<26]) == 26;
  #assert npc_answer_decode(body, words[0..<r.count - 1]).status == NpcStatus.output;
  #assert npc_answer_decode(body, words[0..<r.count]).count == r.count;
  // what the writer refuses
  #assert npc_answer_write("", "m", out[..]) == -1 && npc_answer_write("x", "", out[..]) == -1 && npc_answer_write(" ", "m", out[..]) == -1;
  long: [NPC_ANSWER_BYTES + 1] u8; for k: 0..<long.count { long[k] = 'x'; }
  wide: [NPC_ANSWER_JSON_BYTES] u8;
  #assert npc_answer_write(cast(string) long[0..<NPC_ANSWER_BYTES], "m", wide[..]) > 0 && npc_answer_write(cast(string) long[..], "m", wide[..]) == -1;
  #assert npc_answer_write("x", "m", out[0..<27]) == 27 && npc_answer_write("x", "m", out[0..<26]) == -1;
}
#test "the answer's limits admit their ends" {
  body: [NPC_ANSWER_JSON_BYTES + 1] u8; for k: 0..<body.count { body[k] = ' '; }
  minimal := "{\"text\":\"!\"}"; for c, k: minimal { body[k] = c; }
  out: [NPC_ANSWER_BYTES + 1] u8;
  #assert npc_answer_decode(cast(string) body[0..<NPC_ANSWER_JSON_BYTES], out[..]).count == 1;
  #assert npc_answer_decode(cast(string) body[..], out[..]).status == NpcStatus.budget;
  prefix := "{\"text\":\""; for c, k: prefix { body[k] = c; }
  for n: [2] int.[NPC_ANSWER_BYTES, NPC_ANSWER_BYTES + 1] {
    for c, k: prefix { body[k] = c; } for k: 0..<n { body[prefix.count + k] = 'x'; } body[prefix.count + n] = '"'; body[prefix.count + n + 1] = '}';
    r := npc_answer_decode(cast(string) body[0..<prefix.count + n + 2], out[..]);
    #assert r.status == (ifx n == NPC_ANSWER_BYTES then NpcStatus.ok else NpcStatus.words);
    if n == NPC_ANSWER_BYTES { #assert npc_answer_text(cast(string) body[0..<prefix.count + n + 2], out[0..<NPC_ANSWER_BYTES]) == n; }
    back: [NPC_ANSWER_BYTES] u8; text := cast(string) out[0..<NPC_ANSWER_BYTES];
    if n == NPC_ANSWER_BYTES { m := npc_answer_write(text, "m", body[..]); #assert m > 0 && npc_answer_decode(cast(string) body[0..<m], back[..]).count == n; }
  }
  head := "{\"text\":\"!\",\"model\":\""; for c, k: head { body[k] = c; }
  for n: [2] int.[NPC_MODEL_BYTES, NPC_MODEL_BYTES + 1] {
    for k: 0..<n { body[head.count + k] = 'm'; } body[head.count + n] = '"'; body[head.count + n + 1] = '}';
    r := npc_answer_decode(cast(string) body[0..<head.count + n + 2], out[..]);
    #assert r.status == (ifx n == NPC_MODEL_BYTES then NpcStatus.ok else NpcStatus.model);
  }
  m: [NPC_MODEL_BYTES + 1] u8; for k: 0..<m.count { m[k] = 'm'; }
  w: [NPC_ANSWER_JSON_BYTES] u8;
  #assert npc_answer_write("x", cast(string) m[0..<NPC_MODEL_BYTES], w[..]) > 0 && npc_answer_write("x", cast(string) m[..], w[..]) == -1;
  // every byte escaped: the longest answer still fits the writer's buffer
  ctl: [NPC_ANSWER_BYTES] u8; for k: 0..<ctl.count { ctl[k] = 1; } ctl[0] = 'x';
  ctlm: [NPC_MODEL_BYTES] u8; for k: 0..<ctlm.count { ctlm[k] = 1; } ctlm[0] = 'x';
  #assert npc_answer_write(cast(string) ctl[..], cast(string) ctlm[..], w[..]) == 27 + 6 * (NPC_ANSWER_BYTES - 1 + NPC_MODEL_BYTES - 1);
}
#test "answer diagnostics name what is wrong" {
  out: [600] u8;
  #assert npc_answer_decode("oops", out[..]).status == NpcStatus.json;
  #assert npc_answer_decode("[]", out[..]).status == NpcStatus.shape;
  #assert npc_answer_decode("{\"text\":\"\\ud800\"}", out[..]).status == NpcStatus.text;
  #assert npc_answer_decode("{\"text\":\"\"}", out[..]).status == NpcStatus.words;
  #assert npc_answer_decode("{\"model\":\"m\"}", out[..]).status == NpcStatus.words;
  #assert npc_answer_decode("{\"text\":\"!\",\"model\":\"\\ud800\"}", out[..]).status == NpcStatus.text;
  #assert npc_answer_decode("{\"text\":\"!\",\"model\":\"\"}", out[..]).status == NpcStatus.model;
  #assert npc_answer_decode("{\"text\":\"!\",\"model\":\"m\"}", out[..]).status == NpcStatus.ok;
  #assert npc_answer_decode("{\"text\":\"!\",\"text\":\"?\"}", out[..]).status == NpcStatus.duplicate;
  #assert npc_answer_decode("{\"model\":\"m\",\"model\":\"m\",\"text\":\"!\"}", out[..]).status == NpcStatus.duplicate;
  #assert npc_answer_decode("{\"text\":\"!\"}", out[0..<0]).status == NpcStatus.output;
  broken: [12] u8; for c, k: "{\"text\":\"x\"}" { broken[k] = c; } broken[9] = 0xC3;
  #assert npc_answer_decode(cast(string) broken[..], out[..]).status == NpcStatus.words;
}

// ---- text

npc_id_ok :: (s: string, most: int) -> bool #effects(all) {
  if s.count < 1 || s.count > most { return false; }
  for c: s { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}
npc_utf8 :: (s: string) -> bool #effects(all) {
  at := 0;
  while at < s.count { n := json_utf8(s, at); if n == 0 { return false; } at += n; }
  return true;
}
// Words worth sending or showing: at most `most` bytes of UTF-8 with a byte that is not a space
// or a control byte (the pages send control bytes as spaces, and the server trims spaces).
npc_said :: (s: string, most: int) -> bool #effects(all) {
  if s.count > most || !npc_utf8(s) { return false; }
  for c: s { if c > 32 { return true; } }
  return false;
}
// A string's inside as the pages have always written it: " and \ escaped, a control byte as a
// space. The new length, or -1 when it doesn't fit (and -1 stays -1).
npc_put :: (b: [] u8, at: int, s: string) -> int #effects(all) {
  n := at;
  for c: s {
    if c == '"' || c == '\\' { n = json_raw(b, n, "\\"); }
    if n < 0 || n >= b.count { return -1; }
    b[n] = ifx (c & 0xE0) == 0 then cast(u8) ' ' else c; n += 1;
  }
  return n;
}

// ---- the question

// book:begin request
npc_ask_check :: (a: NpcAsk) -> NpcStatus #effects(all) {
  if !npc_id_ok(a.npc, NPC_ID_BYTES) { return NpcStatus.npc; }
  if (a.world.count > 0) == (a.realm.count > 0) { return NpcStatus.place; }
  if a.world.count > 0 && !npc_id_ok(a.world, NPC_ID_BYTES) { return NpcStatus.world; }
  if a.realm.count > 0 && !npc_id_ok(a.realm, NPC_REALM_BYTES) { return NpcStatus.realm; }
  if a.history.count > NPC_HISTORY { return NpcStatus.history; }
  if !npc_said(a.question, NPC_ASK_BYTES) { return NpcStatus.question; }
  if !npc_utf8(a.visit) || !npc_utf8(a.scene) { return NpcStatus.text; }
  for t: a.history { if !npc_utf8(t.text) { return NpcStatus.text; } }
  return NpcStatus.ok;
}
// The question's JSON into out: its length, or -1 when it is refused or doesn't fit, and then
// out is as it was.
npc_ask_write :: (a: NpcAsk, out: [] u8) -> int #effects(all) {
  if npc_ask_check(a) != NpcStatus.ok { return -1; }
  b: [NPC_ASK_BYTES] u8;
  n := npc_put(b[..], json_raw(b[..], 0, "{\"npc\":\""), a.npc);
  n = json_raw(b[..], n, ifx a.realm.count > 0 then "\",\"realm\":\"" else "\",\"world\":\"");
  n = npc_put(b[..], n, ifx a.realm.count > 0 then a.realm else a.world);
  if a.has_visit { n = npc_put(b[..], json_raw(b[..], n, "\",\"visit\":\""), a.visit); }
  if a.scene.count > 0 { n = npc_put(b[..], json_raw(b[..], n, "\",\"scene\":\""), a.scene); }
  n = json_raw(b[..], n, "\",\"history\":[");
  for t, k: a.history {
    n = json_raw(b[..], n, ifx k > 0 then ",{\"from\":\"" else "{\"from\":\"");
    n = npc_put(b[..], json_raw(b[..], n, ifx t.npc then "npc\",\"text\":\"" else "player\",\"text\":\""), t.text);
    n = json_raw(b[..], n, "\"}");
  }
  n = npc_put(b[..], json_raw(b[..], n, "],\"question\":\""), a.question);
  n = json_raw(b[..], n, "\"}");
  if n > out.count { return -1; }   // and -1, when it didn't fit b, copies nothing
  for k: 0..<n { out[k] = b[k]; }
  return n;
}
// book:end request

// Which member a key names (escapes read as what they mean): 0 npc, 1 world, 2 realm, 3 visit,
// 4 scene, 5 history, 6 question; -1 another.
NPC_KEYS :: [7] string.["npc", "world", "realm", "visit", "scene", "history", "question"];
npc_key :: (raw: string) -> int #effects(all) {
  for name, k: NPC_KEYS { if json_is(raw, name) { return k; } }
  return -1;
}
// One line of the history, {"from": "npc" or "player", "text": ...}, its text unescaped into
// strings from at. The status and the new end of strings.
npc_turn_read :: (d: Jv, t: int, strings: [] u8, at: int, turn: [] NpcTurn) -> NpcRead #effects(all) {
  if jv_kind(d, t) != JV_OBJECT { return NpcRead.{status = NpcStatus.shape}; }
  from := 0; has_text := false; end := at; m := d.nodes[t].first;
  while m != -1 {
    key := jv_key(d, m);
    if json_is(key, "from") {
      if from != 0 { return NpcRead.{status = NpcStatus.duplicate}; }
      from = ifx json_is(jv_raw(d, m), "npc") then 1 else ifx json_is(jv_raw(d, m), "player") then 2 else 3;
    } else if json_is(key, "text") {
      if has_text { return NpcRead.{status = NpcStatus.duplicate}; }
      if jv_kind(d, m) != JV_STRING { return NpcRead.{status = NpcStatus.shape}; }
      n := json_unescape(jv_raw(d, m), strings[at..<strings.count]);
      if n < 0 { return NpcRead.{status = NpcStatus.text}; }
      turn[0].text = cast(string) strings[at..<at + n]; has_text = true; end = at + n;
    } else { return NpcRead.{status = NpcStatus.shape}; }
    m = d.nodes[m].next;
  }
  if from == 0 || from == 3 || !has_text { return NpcRead.{status = NpcStatus.shape}; }
  turn[0].npc = from == 1;
  return NpcRead.{status = NpcStatus.ok, count = end};
}
// A question's JSON, read and checked as npc_ask_write checks it: the API's rules, and no member
// it doesn't know. turns holds NPC_HISTORY lines; strings, every value unescaped (the body's
// length is always room enough; less is refused as text). The values read are views into both.
// Any JSON escape is read; the writer's is the canonical form.
npc_ask_read :: (body: string, turns: [] NpcTurn, strings: [] u8) -> NpcAskRead #effects(all) {
  if body.count > NPC_ASK_BYTES { return NpcAskRead.{status = NpcStatus.budget}; }
  if turns.count < NPC_HISTORY { return NpcAskRead.{status = NpcStatus.output}; }
  d: [1] Jv; nodes: [NPC_NODES] JvNode;
  if !jv_parse(d[..], body, nodes[..]) { return NpcAskRead.{status = NpcStatus.json}; }
  if jv_kind(d[0], 0) != JV_OBJECT { return NpcAskRead.{status = NpcStatus.shape}; }
  a: NpcAsk; seen: [7] bool; used := 0;
  values: [7] string;
  k := d[0].nodes[0].first;
  while k != -1 {
    f := npc_key(jv_key(d[0], k));
    if f < 0 { return NpcAskRead.{status = NpcStatus.shape}; }
    if seen[f] { return NpcAskRead.{status = NpcStatus.duplicate}; }
    seen[f] = true;
    if f == 5 {
      if jv_kind(d[0], k) != JV_ARRAY { return NpcAskRead.{status = NpcStatus.shape}; }
      count := jv_len(d[0], k);
      if count > NPC_HISTORY { return NpcAskRead.{status = NpcStatus.history}; }
      t := d[0].nodes[k].first; i := 0;
      while t != -1 {
        r := npc_turn_read(d[0], t, strings, used, turns[i..<i + 1]);
        if r.status != NpcStatus.ok { return NpcAskRead.{status = r.status}; }
        used = r.count; i += 1; t = d[0].nodes[t].next;
      }
      a.history = turns[0..<count];
    } else {
      if jv_kind(d[0], k) != JV_STRING { return NpcAskRead.{status = NpcStatus.shape}; }
      n := json_unescape(jv_raw(d[0], k), strings[used..<strings.count]);
      if n < 0 { return NpcAskRead.{status = NpcStatus.text}; }
      values[f] = cast(string) strings[used..<used + n]; used += n;
    }
    k = d[0].nodes[k].next;
  }
  a.npc = values[0]; a.world = values[1]; a.realm = values[2]; a.has_visit = seen[3]; a.visit = values[3];
  a.scene = values[4]; a.question = values[6];
  return NpcAskRead.{status = npc_ask_check(a), ask = a};
}
// ---- the answer

// book:begin reply
// Accept only the words and the model's name: malformed JSON, another member, a duplicate key
// (escaped spellings too), bytes that are not UTF-8 and lone surrogates are refused whole, and
// out is left as it was. The words are display text, never a command.
npc_answer_decode :: (body: string, out: [] u8) -> NpcRead #effects(all) {
  if body.count > NPC_ANSWER_JSON_BYTES { return NpcRead.{status = NpcStatus.budget}; }
  d: [1] Jv; nodes: [8] JvNode;
  if !jv_parse(d[..], body, nodes[..]) { return NpcRead.{status = NpcStatus.json}; }
  if jv_kind(d[0], 0) != JV_OBJECT { return NpcRead.{status = NpcStatus.shape}; }
  words: [NPC_ANSWER_JSON_BYTES] u8; model: [NPC_ANSWER_JSON_BYTES] u8; n: int; text_seen := false; model_seen := false; k := d[0].nodes[0].first;
  while k != -1 {
    if jv_kind(d[0], k) != JV_STRING { return NpcRead.{status = NpcStatus.shape}; }
    key := jv_key(d[0], k);
    if json_is(key, "text") {
      if text_seen { return NpcRead.{status = NpcStatus.duplicate}; }
      text_seen = true; n = json_unescape(jv_raw(d[0], k), words[..]);
      if n < 0 { return NpcRead.{status = NpcStatus.text}; }
      if !npc_said(cast(string) words[0..<n], NPC_ANSWER_BYTES) { return NpcRead.{status = NpcStatus.words}; }
    } else if json_is(key, "model") {
      if model_seen { return NpcRead.{status = NpcStatus.duplicate}; }
      model_seen = true; m := json_unescape(jv_raw(d[0], k), model[..]);
      if m < 0 { return NpcRead.{status = NpcStatus.text}; }
      if !npc_said(cast(string) model[0..<m], NPC_MODEL_BYTES) { return NpcRead.{status = NpcStatus.model}; }
    } else { return NpcRead.{status = NpcStatus.shape}; }
    k = d[0].nodes[k].next;
  }
  if !text_seen { return NpcRead.{status = NpcStatus.words}; }
  if n > out.count { return NpcRead.{status = NpcStatus.output}; }
  for i: 0..<n { out[i] = words[i]; }
  return NpcRead.{status = NpcStatus.ok, count = n};
}
// book:end reply
// A page's line from the answer: the words on one line (a control byte as a space), cut to out
// before a character that doesn't fit. Its length, or 0 when the answer is refused.
npc_answer_text :: (body: string, out: [] u8) -> int #effects(all) {
  w: [NPC_ANSWER_BYTES] u8;
  r := npc_answer_decode(body, w[..]);
  if r.status != NpcStatus.ok { return 0; }
  n := r.count;
  if n > out.count { n = out.count; while (w[n] & 0xC0) == 0x80 { n -= 1; } }
  for i: 0..<n { out[i] = ifx (w[i] & 0xE0) == 0 then cast(u8) ' ' else w[i]; }
  return n;
}
// The answer as the API writes it (Postgres jsonb text): {"text": ..., "model": ...}. Its length,
// or -1 when it is refused or doesn't fit.
npc_answer_write :: (text: string, model: string, out: [] u8) -> int #effects(all) {
  if !npc_said(text, NPC_ANSWER_BYTES) || !npc_said(model, NPC_MODEL_BYTES) { return -1; }
  b: [NPC_ANSWER_JSON_BYTES] u8;
  n := json_write_string(b[..], json_raw(b[..], 0, "{\"text\": "), text);
  n = json_write_string(b[..], json_raw(b[..], n, ", \"model\": "), model);
  n = json_raw(b[..], n, "}");
  if n > out.count { return -1; }   // and -1, when it didn't fit b, copies nothing
  for k: 0..<n { out[k] = b[k]; }
  return n;
}
