pcf_metadata :: (p:PctOptions,s:PcSession,capture:[]PctCapture,work:string,wasm:string,wasm_bytes:int,wasm_hash:string,paths:[][4096]u8,path_n:[]int,files:[]PctFiles,inputs:[]RtqInputs)->bool {
