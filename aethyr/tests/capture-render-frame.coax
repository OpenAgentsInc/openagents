PCF_EFFECTS :: "aethyr/tests/producer-capture-effects.js";
pcf_input :: (inputs:[]RtqInputs,path:string)->bool {p:[4096]u8;file:=fs_realpath(path,p[..]);return file!="" && rtq_input_add(inputs,file);}
