    sizes:=[4]int.[catalog.bytes,mesh_bytes,index_bytes,layers];for size,k:sizes {ready:=[3]f64.[state,cast(f64)k,cast(f64)size];delivered:=pc_get(c,s,"coaxial_asset_ready",ready[..],true);}
  }
