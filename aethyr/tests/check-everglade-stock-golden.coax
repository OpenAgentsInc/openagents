// Coax owns the fenced loopback fixture and bounded existing stock PNG walk.
// The grandfathered stock tool retains its lit/blocks/moving/events policy.
#import "Basic";
#load "render-host-files.coax";
#load "everglade-stock-policy.coax";
// GET-only built-in realm metadata, from0075_realm_forks.sql/fork_info and
// the current everglade-fork.coax protocol fixture. This grants no owner or
// realm-making permission and does not serve POST .../fork.
EG_FORK_FIXTURE :: "base everglade\ntitle Everglade\nfork 0\nmaker OpenAgents\nname Everglade\nowner 0\npublished 0\nrule night 0 Always night\nrule waves 0 Hostile waves\nrule nodestroy 0 No destruction\nrule lowgrav 0 Low gravity\n";
eg_stock_config :: (surface:string,wasm:string,package:string,page:string,work:string,inputs:[]RtqInputs)->bool {
  paths:[8][4096]u8;source:[65536]u8;prepared:[65536]u8;n:=fs_read(page,source[..]);pn:=ifx n>0 then rh_page(cast(string)source[0..<n],prepared[..]) else -1;
  html:=fs_join(work,"page.html",paths[0][..]);capture:=fs_join(work,"analytics",paths[1][..]);if pn<1 || !fs_write(html,cast(string)prepared[0..<pn]) || !fs_mkdir(capture) {return false;}
  data:[65536]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.v1");jo_key(o[..],"lifetime_ms");jo_int(o[..],300000);jo_key(o[..],"idle_websockets");jo_raw(o[..],"[\"/coaxial/live\"]");jo_key(o[..],"routes");jo_arr(o[..]);
  jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],"/api/playtest/realms/everglade/fork");jo_key(o[..],"text");jo_str(o[..],EG_FORK_FIXTURE);jo_key(o[..],"mime");jo_str(o[..],"text/plain");jo_end(o[..]);
  for k:0..<7 {jo_obj(o[..]);jo_key(o[..],ifx k<4 then "url" else "prefix");jo_str(o[..],ifx k==0 then "/realms/everglade" else ifx k==1 then "/realms/everglade/" else ifx k==2 then "/test.wasm" else ifx k==3 then "/api/auth/viewer" else ifx k==4 then "/coaxial/" else ifx k==5 then "/package/" else "/");
    if k==3 {jo_key(o[..],"text");jo_str(o[..],"");}else {jo_key(o[..],ifx k<3 then "file" else "directory");jo_str(o[..],ifx k<2 then html else ifx k==2 then wasm else ifx k==4 then fs_join(surface,"coax/web",paths[2][..]) else ifx k==5 then package else fs_join(surface,"apps/openagents-web",paths[2][..]));}if k<2 {jo_key(o[..],"mime");jo_str(o[..],"text/html");}jo_end(o[..]);}jo_end(o[..]);
  jo_key(o[..],"post_sinks");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],"/api/analytics/events");jo_key(o[..],"root");jo_str(o[..],capture);jo_key(o[..],"file");jo_str(o[..],fs_join(capture,"events.json",paths[2][..]));jo_key(o[..],"max_bytes");jo_int(o[..],1048576);jo_end(o[..]);jo_end(o[..]);jo_key(o[..],"pins");jo_arr(o[..]);
  for file:[4]string.[wasm,page,html,fs_join(package,"render.json",paths[3][..])] {hash:[64]u8;if !rtq_input_add(inputs,file) || !rtq_hash_file(file,hash[..]) {return false;}jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],file);jo_key(o[..],"sha256");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && rto_saved(work,"origin-config.json",jo_text(o[..]));
}
// The stock policy reads realm shader declarations and optional pack manifests
// while constructing its complete page table, even for a single selected page.
eg_stock_inputs :: (inputs:[]RtqInputs,root:string)->bool {
  paths:[3][4096]u8;for name:[15]string.["coax/web/goldens.ts","coax/web/golden-pages.ts","coax/web/golden-policy.ts","coax/web/realms.ts","coax/web/chrome.ts","coax/web/loader.js","coax/web/og.ts","coax/web/analytics-contract.json","coax/web/goldens/everglade.png","apps/openagents-web/realms.json","apps/openagents-web/nip/catalog.json","verse/style.coax","coax/web/api/migrations/0075_realm_forks.sql","coax/web/api/realms.c","apps/openagents-web/everglade-fork.coax"] {if !rtq_input_add(inputs,fs_join(root,name,paths[0][..])) {return false;}}
  bytes:[131072]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(root,"apps/openagents-web/realms.json",paths[0][..]),bytes[..],nodes[..],d[..]) {return false;}worlds:=jv_get(d[0],0,"worlds");for k:0..<jv_len(d[0],worlds) {realm:=jv_get(d[0],jv_at(d[0],worlds,k),"realm");if jv_kind(d[0],realm)!=JV_OBJECT {continue;}module:[128]u8;mn:=jv_str(d[0],jv_get(d[0],realm,"module"),module[..]);if mn<1 {return false;}name:[512]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],"apps/openagents-web/");jo_put(o[..],cast(string)module[0..<mn]);jo_put(o[..],".wgsl");file:=fs_join(root,jo_text(o[..]),paths[0][..]);if !rtq_input_add(inputs,file) {return false;}}
  list:[1]FsList;dir:=fs_join(root,"verse/packs",paths[1][..]);count:=fs_list(dir,list[..]);if count<0 || list[0].full {return false;}for k:0..<count {file:=fs_join(dir,fs_entry(list[..],k),paths[0][..]);if !rtq_input_add(inputs,file) {return false;}}return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}child:=rto_child(a[..]);if child>=0 {return child;}if args_count(a[..])!=6 {tool_errln("usage: check-everglade-stock-golden WASM PACKAGE PAGE SURFACE NEW_OUT BUN");return 2;}
  paths:[12][4096]u8;root:=fs_cwd(paths[0][..]);wasm:=fs_realpath(args_at(a[..],0),paths[1][..]);package:=fs_realpath(args_at(a[..],1),paths[2][..]);page:=fs_realpath(args_at(a[..],2),paths[3][..]);surface:=fs_realpath(args_at(a[..],3),paths[4][..]);bun:=fs_realpath(args_at(a[..],5),paths[5][..]);if wasm=="" || package=="" || page=="" || surface=="" || bun=="" || !fs_mkdir(args_at(a[..],4)) {return 2;}work:=fs_realpath(args_at(a[..],4),paths[6][..]);list:[1]FsList;if work=="" || fs_list(work,list[..])!=0 {return 2;}
  compiler_buffer:[4096]u8;compiler:=proc_getenv("COAX",compiler_buffer[..]);if compiler=="" {compiler="coax/bin/coax";}inputs:[1]RtqInputs;self:[4096]u8;image:=gp_self(self[..]);chrome:[4096]u8;
  if !rtq_input_add(inputs[..],compiler) || !rtq_input_add(inputs[..],image) || !rtq_input_add(inputs[..],bun) || !rtq_input_add(inputs[..],cdp_chrome(chrome[..])) || !rtq_input_add(inputs[..],"coax/web/tool.sh") || !rtq_deps(inputs[..],compiler,"aethyr/tests/check-everglade-stock-golden.coax",proc_now_ms()+30000,work,"tool-dependencies") || !eg_stock_inputs(inputs[..],root) || !eg_stock_config(surface,wasm,package,page,work,inputs[..]) {return 1;}
  baseline:=fs_join(root,"coax/web/goldens/everglade.png",paths[7][..]);if !rlay_copy(baseline,0,fs_size(baseline),fs_join(work,"before.png",paths[8][..])) {return 1;}
  config:=fs_join(work,"origin-config.json",paths[7][..]);if !rtq_input_add(inputs[..],config) {return 1;}port_file:=fs_join(work,"origin-port",paths[8][..]);ledger:=fs_join(work,"origin",paths[9][..]);server:=rto_start(port_file,config,ledger);if server<0 {return 1;}text:[32]u8;pn:=-1;for k:0..<100 {pn=fs_read(port_file,text[..]);if pn>0 {break;}proc_sleep(50);}port:=ifx pn>0 then args_whole(cast(string)text[0..<pn]) else -1;
  url:[128]u8;o:[1]Jo;jo_start(o[..],url[..]);jo_put(o[..],"http://127.0.0.1:");jo_int(o[..],port);report:=fs_join(work,"stock-report.json",paths[10][..]);argv:=[8]string.[bun,"coax/web/goldens.ts",jo_text(o[..]),"--only","everglade","--report",report,"--full"];out:[1048576]u8;err:[1048576]u8;env:=[6]string.["GOLDENS_POOL=1","GOLDENS_PLATFORM=mac","BLOCK=8","SHADE=8","GOLDENS_FULL=1","GOLDENS_CHROMES=0"];r:ProcRun;r.started=PROC_ERROR;if port>0 {r=rtq_command(argv[..],env[..],proc_now_ms()+240000,work,"stock",out[..],err[..]);}
  shot:=eg_stock_shot(cast(string)out[0..<r.out_n]);
  retained:=true;if shot!="" {retained=rlay_copy(shot,0,fs_size(shot),fs_join(work,"current.png",paths[11][..]));}
  finalized:=port>0 && rto_finalize(port);status:=proc_wait(server,5000);if status==PROC_RUNNING {killed:=proc_kill(server,PROC_SIGKILL);status=proc_wait(server,5000);}released:=proc_release(server);joined:=finalized && status==0 && rto_add_inputs(ledger,inputs[..]);same:=rtq_inputs_match(inputs[..]);body:[131072]u8;dnodes:[8192]JvNode;d:[1]Jv;complete:=eg_stock_complete(r.started,r.status,r.timed_out,r.cut,retained,joined,same,rtq_json_file(report,body[..],dnodes[..],d[..]));
  record:[8388608]u8;w:[1]Jo;jo_start(w[..],record[..]);jo_obj(w[..]);jo_key(w[..],"schema");jo_str(w[..],"aethyr.everglade.stock-golden-observation.v1");jo_key(w[..],"observation_complete");jo_bool(w[..],complete);jo_key(w[..],"stock_exit");jo_int(w[..],r.status);jo_key(w[..],"stock_passed");jo_bool(w[..],rtq_ok(r));jo_key(w[..],"stock_report");if complete {jv_write(d[0],0,w[..]);}else {jo_null(w[..]);}jo_key(w[..],"failed_shot_source");jo_str(w[..],shot);jo_key(w[..],"failed_shot_retained");jo_bool(w[..],retained && shot!="");jo_key(w[..],"origin_finalized");jo_bool(w[..],joined);jo_key(w[..],"source_fence_unchanged");jo_bool(w[..],same);jo_key(w[..],"inputs");rtq_inputs_json(w[..],inputs[..],"");jo_key(w[..],"scope");jo_str(w[..],"Unmodified stock1280x800 golden walk on the normal Everglade URL with actual analytics POST bytes, muted/headless Chrome, exact supplied ordinary producer/package and fenced production surface. Original6block/lit/moving/event decisions remain in the full report/log. No baseline update, synthetic events, numerical closure or equality with the separate probe/half capture profile.");jo_end(w[..]);if w[0].bad || !rto_saved(work,"receipt.json",jo_text(w[..])) {return 1;}print("Everglade stock observation complete %, stock exit %\n",complete,r.status);return ifx complete then r.status else 1;
}
