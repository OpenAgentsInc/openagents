// Actual browser diagnostics and exact override-route controls. Each case is
// bounded and uses supplied frozen products; it does not compile a realm.
#import "Basic";
#load "render-golden-tools.coax";
ggd_run :: (epoch:string,label:string,argv:[]string)->bool {out:[1048576]u8;err:[262144]u8;env:[]string;r:=rtq_command(argv,env,proc_now_ms()+180000,epoch,label,out[..],err[..]);return r.started==0 && r.status==1 && !r.timed_out && !r.cut;}
ggd_event :: (directory:string,key:string)->bool {path:[4096]u8;raw:[4194304]u8;nodes:[32768]JvNode;d:[1]Jv;return rtq_json_file(fs_join(directory,"legacy/receipt.json",path[..]),raw[..],nodes[..],d[..]) && jv_kind(d[0],jv_get(d[0],0,key))==JV_ARRAY && jv_len(d[0],jv_get(d[0],0,key))>0;}
ggd_get :: (port:int,path:string,file:string)->bool {
 for c:"127.0.0.1" {r:=cxsock_host_push(cast(int)c);}h:=cxsock_connect(port,5000);if h<0 {return false;}request:[4096]u8;o:[1]Jo;jo_start(o[..],request[..]);jo_put(o[..],"GET ");jo_put(o[..],path);jo_put(o[..]," HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");okay:=!o[0].bad && wp_send(h,jo_text(o[..]));data:[1048576]u8;n:=0;ended:=false;response:CdpHttp;deadline:=proc_now_ms()+5000;
 while okay {response=cdp_http(cast(string)data[0..<n],ended);if response.done || ended {break;}count:=cxsock_read(h,proc_left(deadline,proc_now_ms()));if count== -1 {ended=true;continue;}if count<1 || n+count>data.count {okay=false;break;}for k:0..<count {data[n+k]=cast,trunc(u8)cxsock_byte(h,k);}n+=count;}closed:=cxsock_close(h);hash:[64]u8;got:[64]u8;return okay && response.done && response.status==200 && rtq_hash_file(file,hash[..]) && S_hex(S_hash(cast(string)data[response.from..<response.to]),got[..]) && cast(string)hash[..]==cast(string)got[..];
}
ggd_route :: (paths:GgPaths,route:string,work:string,scene:string,particles:string)->bool {
 if !fs_mkdir(work) {return false;}buffers:[4][4096]u8;config:=fs_join(work,"origin-config.json",buffers[0][..]);port_file:=fs_join(work,"origin-port",buffers[1][..]);ledger:=fs_join(work,"origin",buffers[2][..]);if !gg_config(paths,GgOptions.{},route,work,"fixture",config) {return false;}server:=rto_start(port_file,config,ledger);if server<0 {return false;}text:[32]u8;size:=-1;for attempt:0..<100 {size=fs_read(port_file,text[..]);if size>0 {break;}proc_sleep(20);}port:=ifx size>0 then args_whole(cast(string)text[0..<size]) else -1;okay:=port>0;for url,k:[5]string.["/fixture.wgsl","/particles.wgsl","/coaxial/host.js","/producer.wasm","/package/render.json"] {file:=[5]string.[scene,particles,paths.observed,paths.wasm,paths.manifest][k];fetched:=ggd_get(port,url,file);okay=fetched && okay;}done:=port>0 && rto_finalize(port);status:=proc_wait(server,5000);if status==PROC_RUNNING {killed:=proc_kill(server,PROC_SIGKILL);status=proc_wait(server,5000);}released:=proc_release(server);if !okay || !done || status!=0 {return false;}
 raw:[4194304]u8;n:=fs_read(fs_join(ledger,"requests.jsonl",buffers[3][..]),raw[..]);if n<0 {return false;}nodes:[1024]JvNode;d:[1]Jv;at:=0;scene_seen:=false;particle_seen:=false;host_seen:=false;observed:[64]u8;if !rtq_hash_file(paths.observed,observed[..]) {return false;}
 for k:0..<n {if raw[k]!='\n' {continue;}if k>at {if !jv_parse(d[..],cast(string)raw[at..<k],nodes[..]) {return false;}for url,i:[3]string.["/fixture.wgsl","/particles.wgsl","/coaxial/host.js"] {if !gg_text(d[0],jv_get(d[0],0,"path"),url) {continue;}if i==0 {scene_seen=gg_text(d[0],jv_get(d[0],0,"file"),scene);}if i==1 {particle_seen=gg_text(d[0],jv_get(d[0],0,"file"),particles);}if i==2 {host_seen=gg_text(d[0],jv_get(d[0],0,"served_sha256"),cast(string)observed[..]);}}}at=k+1;}return scene_seen && particle_seen && host_seen;
}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) {return 2;}child:=rto_child(a[..]);if child>=0 {return child;}epoch:=args_value(a[..],"--epoch","");observer:=args_value(a[..],"--observer","");wasm:=args_value(a[..],"--wasm","");package:=args_value(a[..],"--package","");if epoch=="" || observer=="" || wasm=="" || package=="" {return 2;}buffers:[16][4096]u8;surface:=fs_join(epoch,"surface",buffers[0][..]);page:=fs_join(surface,"apps/openagents-web/realms/fixture/index.html",buffers[1][..]);original:=fs_join(epoch,"legacy-source/aethyr/tests/check_render_goldens.ts",buffers[2][..]);bun:=args_value(a[..],"--bun","/Users/christopherdavid/.bun/bin/bun");inputs:[1]RtqInputs;for file:[4]string.[observer,wasm,original,bun] {if !rtq_input_add(inputs[..],file) {return 1;}}compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_input_add(inputs[..],compiler) || !rtq_deps(inputs[..],compiler,"aethyr/tests/check-golden-diagnostics.coax",proc_now_ms()+30000,epoch,"diagnostic-dependencies") {return 1;}
 source:[1048576]u8;sn:=fs_read(page,source[..]);if sn<0 {return 1;}record:[1048576]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.golden-port-diagnostics.v1");jo_key(o[..],"browser_refusals");jo_arr(o[..]);passed:=true;
 routing_only:=args_has(a[..],"--routing-only");if !routing_only {for kind,k:[2]string.["runtime","log"] {name:[128]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],"diagnostic-");jo_put(w[..],kind);jo_put(w[..],".html");html:=fs_join(epoch,jo_text(w[..]),buffers[3][..]);modified:[1048576]u8;m:[1]Jo;jo_start(m[..],modified[..]);jo_put(m[..],ifx k==0 then "<script>setTimeout(()=>{throw Error('golden-diagnostic')},0)</script>" else "<img src=\"/missing-golden-diagnostic.png\">");jo_put(m[..],cast(string)source[0..<sn]);if m[0].bad || !fs_write(html,jo_text(m[..])) {return 1;}
  targets:[2][4096]u8;for prefix,j:[2]string.["original-","coax-"] {jo_start(w[..],name[..]);jo_put(w[..],prefix);jo_put(w[..],"diagnostic-");jo_put(w[..],kind);target:=fs_join(epoch,jo_text(w[..]),targets[j][..]);okay:=false;if j==0 {argv:=[8]string.[bun,original,wasm,package,html,target,"--size=8x8","--unknown"];okay=ggd_run(epoch,jo_text(w[..]),argv[..]);}else {argv:=[9]string.[observer,wasm,package,html,target,"--size=8x8","--unknown","--surface-root",surface];okay=ggd_run(epoch,jo_text(w[..]),argv[..]);}okay=okay && ggd_event(target,ifx k==0 then "exceptions" else "errors");passed=passed && okay;jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],jo_text(w[..]));jo_key(o[..],"default_frames");jo_int(o[..],90);jo_key(o[..],"preserved_error_verdict");jo_bool(o[..],okay);jo_end(o[..]);}
 }}jo_end(o[..]);
 paths:GgPaths;paths.surface=surface;paths.wasm=wasm;paths.package=package;paths.page=page;paths.manifest=fs_join(package,"render.json",buffers[4][..]);paths.host=fs_join(surface,"coax/web/host.js",buffers[5][..]);paths.observed=fs_join(epoch,"coax-two-frames/observed-host.js",buffers[6][..]);paths.scene=fs_join(epoch,"scene-override.wgsl",buffers[7][..]);paths.particles=fs_join(epoch,"particle-override.wgsl",buffers[8][..]);default_scene:=fs_join(surface,"apps/openagents-web/fixture.wgsl",buffers[9][..]);default_particles:=fs_join(surface,"apps/openagents-web/particles.wgsl",buffers[10][..]);if !gg_copy(default_scene,paths.scene) || !gg_copy(default_particles,paths.particles) {return 1;}
 jo_key(o[..],"override_routing");jo_arr(o[..]);for route,k:[2]string.["legacy","generic"] {name:[128]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],ifx routing_only then "route-v2-" else "route-");jo_put(w[..],route);work:=fs_join(epoch,jo_text(w[..]),buffers[11][..]);okay:=ggd_route(paths,route,work,ifx k==0 then paths.scene else default_scene,ifx k==0 then paths.particles else default_particles);passed=passed && okay;jo_obj(o[..]);jo_key(o[..],"route");jo_str(o[..],route);jo_key(o[..],"exact_scene_particle_file_and_instrumented_host_identities");jo_bool(o[..],okay);jo_end(o[..]);}jo_end(o[..]);same:=rtq_inputs_match(inputs[..]);jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"source_changes");jo_arr(o[..]);if !same {jo_str(o[..],"source fence changed");}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],passed && same);jo_end(o[..]);if o[0].bad || !rto_saved(epoch,ifx routing_only then "routing-controls.json" else "diagnostics.json",jo_text(o[..])) {return 1;}print("golden diagnostic controls: %\n",passed && same);return ifx passed && same then 0 else 1;
}
