 paths:[12][4096]u8;surface:=fs_join(epoch,"surface",paths[0][..]);page:=fs_join(surface,"apps/openagents-web/realms/fixture/index.html",paths[1][..]);bun:=args_value(a[..],"--bun","/Users/christopherdavid/.bun/bin/bun");original:=fs_join(epoch,"legacy-source/aethyr/tests/check_render_goldens.ts",paths[2][..]);inputs:[1]RtqInputs;for file:[4]string.[observer,wasm,original,bun] {if !rtq_input_add(inputs[..],file) {return 1;}}compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_input_add(inputs[..],compiler) || !rtq_deps(inputs[..],compiler,"aethyr/tests/check-golden-tooling.coax",proc_now_ms()+30000,epoch,"qualification-dependencies") {return 1;}
 if args_has(a[..],"--final-output-guard") {
  sentinel:=fs_join(epoch,"output-guard-sentinel",paths[3][..]);if !fs_mkdir(sentinel) {return 1;}file:=fs_join(sentinel,"observed-host.js",paths[4][..]);if !gg_copy(wasm,file) {return 1;}before:[64]u8;after:[64]u8;if !gg_hash_file(file,before[..]) {return 1;}negative:=[8]string.[observer,file,package,page,sentinel,"--frames","2","--size=16x16"];refused:=ggq_command(epoch,"output-guard-refusal",negative[..],2) && gg_hash_file(file,after[..]) && cast(string)before[..]==cast(string)after[..];
  retained:=fs_join(epoch,"original-two-frames/legacy",paths[5][..]);target:=fs_join(epoch,"final-output-guard-positive",paths[6][..]);positive:=[13]string.[observer,wasm,package,page,target,"--frames","2","--size=16x16","--query=clock=12","--reuse-legacy",retained,"--surface-root",surface];captured:=ggq_command(epoch,"output-guard-positive",positive[..],0);reference:=fs_join(epoch,"original-two-frames",paths[7][..]);parity:=captured && ggq_pair(reference,target);same:=rtq_inputs_match(inputs[..]);record:[1048576]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.golden-output-guard.v1");jo_key(o[..],"existing_input_under_output_refused_before_write");jo_bool(o[..],refused);jo_key(o[..],"existing_wasm_sha256");jo_str(o[..],cast(string)before[..]);jo_key(o[..],"fresh_capture_exact_parity");jo_bool(o[..],parity);jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"source_changes");jo_arr(o[..]);if !same {jo_str(o[..],"source fence changed");}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],refused && parity && same);jo_end(o[..]);saved:=rto_saved(epoch,"output-guard-controls.json",jo_text(o[..]));return ifx saved && refused && parity && same then 0 else 1;
 }
 if args_has(a[..],"--only-changed-image") {
  retained:=fs_join(epoch,"original-two-frames/legacy",paths[3][..]);changed:=fs_join(epoch,"changed-image-legacy-v2",paths[4][..]);if !ggq_reuse_fixture(retained,changed,true) {return 1;}okay:=true;for prefix,k:[2]string.["original-","coax-"] {name:[128]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],prefix);jo_put(w[..],"changed-image-v2");target:=fs_join(epoch,jo_text(w[..]),paths[5][..]);if k==0 {argv:=[12]string.[bun,original,wasm,package,page,target,"--frames","2","--size=16x16","--query=clock=12","--reuse-legacy",changed];okay=ggq_command(epoch,jo_text(w[..]),argv[..],0) && okay;}else {argv:=[13]string.[observer,wasm,package,page,target,"--frames","2","--size=16x16","--query=clock=12","--reuse-legacy",changed,"--surface-root",surface];okay=ggq_command(epoch,jo_text(w[..]),argv[..],0) && okay;}}
  left:=fs_join(epoch,"original-changed-image-v2",paths[6][..]);right:=fs_join(epoch,"coax-changed-image-v2",paths[7][..]);okay=ggq_pair(left,right) && okay;bytes:[1048576]u8;ns:[8192]JvNode;d:[1]Jv;file:[4096]u8;okay=rtq_json_file(fs_join(right,"comparison.json",file[..]),bytes[..],ns[..],d[..]) && jv_kind(d[0],jv_get(d[0],0,"identical"))==JV_FALSE && jv_int(d[0],jv_get(d[0],0,"different_channels"),-1)==1 && jv_int(d[0],jv_get(d[0],0,"different_pixels"),-1)==1 && jv_int(d[0],jv_get(d[0],0,"max_byte_delta"),-1)==1 && okay;record:[1048576]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.golden-image-diagnostic.v1");jo_key(o[..],"passed");jo_bool(o[..],okay && rtq_inputs_match(inputs[..]));jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);saved:=rto_saved(epoch,"changed-image-control.json",jo_text(o[..]));return ifx saved && okay then 0 else 1;
 }
 data:[1048576]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.golden-port-controls.v1");jo_key(o[..],"pairs");jo_arr(o[..]);passed:=true;
 for label:[3]string.["two-frames","start-overrides","max-frames"] {left:[4096]u8;right:[4096]u8;lo:[64]u8;ro:[64]u8;w:[1]Jo;jo_start(w[..],lo[..]);jo_put(w[..],"original-");jo_put(w[..],label);l:=fs_join(epoch,jo_text(w[..]),left[..]);jo_start(w[..],ro[..]);jo_put(w[..],"coax-");jo_put(w[..],label);r:=fs_join(epoch,jo_text(w[..]),right[..]);okay:=ggq_pair(l,r);passed=passed && okay;jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],label);jo_key(o[..],"exact_capture_comparison_and_raw_artifacts");jo_bool(o[..],okay);jo_end(o[..]);}jo_end(o[..]);
 // A valid reused receipt may come from a deleted historical observer. Only
