  for key:[11]string.["route","frames","start","query","width","height","legacy_shader_override","legacy_particle_override","instrumentation_sha256","capture","render"] {x:=jv_get(a[0],0,key);y:=jv_get(b[0],0,key);if x== -1 && y== -1 {continue;}if !rtq_equal(a[0],x,b[0],y) {tool_err("golden parity field ");tool_errln(key);return false;}}
  for d:[2]Jv.[a[0],b[0]] {for key:[3]string.["source_changes","errors","exceptions"] {if !gg_empty(d,jv_get(d,0,key)) {return false;}}}
  for file:GG_FILES {af:=fs_join(a_dir,file,paths[4][..]);bf:=fs_join(b_dir,file,paths[5][..]);diff:=ggq_raw_equal(af,bf);if !diff {tool_err("golden raw parity file ");tool_errln(file);return false;}}
 }
 bytes:[2][1048576]u8;nodes:[2][8192]JvNode;docs:[2]Jv;paths:[2][4096]u8;for dir,k:[2]string.[left,right] {if !rtq_json_file(fs_join(dir,"comparison.json",paths[k][..]),bytes[k][..],nodes[k][..],docs[k..<k+1]) {return false;}}
 for key:[19]string.["schema","same_producer_wasm","same_inputs","same_shape","frames","start","query","width","height","legacy_shader_override","legacy_particle_override","source_changes","legacy_sha256","generic_sha256","different_channels","different_pixels","max_byte_delta","identical","scope"] {if !rtq_equal(docs[0],jv_get(docs[0],0,key),docs[1],jv_get(docs[1],0,key)) {tool_err("comparison parity field ");tool_errln(key);return false;}}return true;
}
ggq_raw_equal :: (a:string,b:string)->bool {n:=fs_size(a);if n<0 || fs_size(b)!=n {return false;}x:[65536]u8;y:[65536]u8;at:=0;while at<n {take:=ifx n-at<x.count then n-at else x.count;if fs_read_at(a,at,x[0..<take])!=take || fs_read_at(b,at,y[0..<take])!=take || cast(string)x[0..<take]!=cast(string)y[0..<take] {return false;}at+=take;}return true;}
ggq_reuse_fixture :: (source:string,target:string,patch_hash:bool)->bool {
 if !fs_mkdir(target) {return false;}paths:[2][4096]u8;for file:GG_FILES {if !gg_copy(fs_join(source,file,paths[0][..]),fs_join(target,file,paths[1][..])) {return false;}}receipt:[4194304]u8;nodes:[32768]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(source,"receipt.json",paths[0][..]),receipt[..],nodes[..],d[..]) {return false;}old_hash:=jv_get(d[0],jv_path(d[0],0,"capture.bytes"),"sha256");gpu:=fs_join(target,"gpu.bin",paths[1][..]);bytes:[65536]u8;size:=fs_size(gpu);if size<1 || size>bytes.count || fs_read_at(gpu,0,bytes[0..<size])!=size {return false;}bytes[0]=bytes[0]^1;if !fs_write(gpu,cast(string)bytes[0..<size]) {return false;}hash:[64]u8;if !gg_hash_file(gpu,hash[..]) {return false;}
 out:[4194304]u8;o:[1]Jo;jo_start(o[..],out[..]);if patch_hash {start:=d[0].nodes[old_hash].from;end:=d[0].nodes[old_hash].to;jo_put(o[..],d[0].text[0..<start]);jo_put(o[..],cast(string)hash[..]);jo_put(o[..],d[0].text[end..<d[0].text.count]);}else {jo_put(o[..],d[0].text);}return !o[0].bad && rto_saved(target,"receipt.json",jo_text(o[..]));
}
ggq_command :: (epoch:string,label:string,argv:[]string,expected:int)->bool {out:[1048576]u8;err:[262144]u8;env:[]string;r:=rtq_command(argv,env,proc_now_ms()+180000,epoch,label,out[..],err[..]);return r.started==0 && r.status==expected && !r.timed_out && !r.cut;}
