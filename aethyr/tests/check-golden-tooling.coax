// Bounded same-input qualification for the complete golden observer CLI.
// This checks retained raw captures, reuse corruption and the two routing
// configurations. It never emits a producer, shader, or package.
#import "Basic";
#load "render-golden-tools.coax";
ggq_pair :: (left:string,right:string)->bool {
