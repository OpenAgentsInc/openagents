 jo_key(o[..],"reuse_cases");jo_arr(o[..]);for mode,k:[4]string.["generic","legacy","changed-image","corrupt-image"] {out_dir:[4096]u8;out_name:[128]u8;name:[1]Jo;jo_start(name[..],out_name[..]);jo_put(name[..],"coax-reuse-");jo_put(name[..],mode);target:=fs_join(epoch,jo_text(name[..]),out_dir[..]);from:[4096]u8;source:=ifx k==0 then fs_join(epoch,"original-two-frames/generic",from[..]) else ifx k==1 then retained else ifx k==2 then changed else corrupt;flag:=ifx k==0 then "--reuse-generic" else "--reuse-legacy";argv:=[15]string.[observer,wasm,package,page,target,"--frames","2","--size=16x16","--query=clock=12",flag,source,"--surface-root",surface,"--unknown-preserved","tail"];okay:=ggq_command(epoch,jo_text(name[..]),argv[..],ifx k==3 then 1 else 0);passed=passed && okay;jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],mode);jo_key(o[..],"expected_exit");jo_int(o[..],ifx k==3 then 1 else 0);jo_key(o[..],"passed");jo_bool(o[..],okay);jo_end(o[..]);if k==2 && okay {raw:[1048576]u8;ns:[8192]JvNode;d:[1]Jv;file:[4096]u8;okay=rtq_json_file(fs_join(target,"comparison.json",file[..]),raw[..],ns[..],d[..]) && jv_kind(d[0],jv_get(d[0],0,"identical"))==JV_FALSE && jv_int(d[0],jv_get(d[0],0,"different_channels"),-1)==1 && jv_int(d[0],jv_get(d[0],0,"different_pixels"),-1)==1 && jv_int(d[0],jv_get(d[0],0,"max_byte_delta"),-1)==1;passed=passed && okay;}}
