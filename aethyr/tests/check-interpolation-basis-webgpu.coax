  code:[262144]u8;cn:=fs_read(wgsl,code[..]);effects:[65536]u8;en:=fs_read("aethyr/tests/depth-precision-effects.js",effects[..]);if cn<1 || en<1 {return 2;}port_buffer:[4096]u8;port_path:=fs_join(work,"port",port_buffer[..]);server:=gp_start_origin(port_path);status:=1;
  if server>=0 {port:[32]u8;pn:=-1;for attempt:0..<100 {pn=fs_read(port_path,port[..]);if pn>0 {break;}proc_sleep(50);}if pn>0 {url:[128]u8;uo:[1]Jo;jo_start(uo[..],url[..]);jo_put(uo[..],"http://127.0.0.1:");jo_put(uo[..],cast(string)port[0..<pn]);jo_put(uo[..],"/");c:[1]Cdp;browser:[65536]u8;bn:=wp_open(c[..],jo_text(uo[..]),cast(string)effects[0..<en],browser[..]);
    if bn>0 {request:[524288]u8;ro:[1]Jo;jo_start(ro[..],request[..]);ib_request(ro[..],cast(string)code[0..<cn]);if !ro[0].bad {value:=wp_run(c[..],"depthPrecisionStart","depthPrecisionPoll()",jo_text(ro[..]));if value>=0 {record:[524288]u8;rr:[1]Jo;jo_start(rr[..],record[..]);jo_obj(rr[..]);jo_key(rr[..],"schema");jo_str(rr[..],"aethyr.interpolation-basis-webgpu.v1");jo_key(rr[..],"observation");jv_write(c[0].doc[0],value,rr[..]);jo_key(rr[..],"browser");jo_raw(rr[..],cast(string)browser[0..<bn]);jo_key(rr[..],"source_fence_unchanged");stable:=rtq_inputs_match(inputs[..]);jo_bool(rr[..],stable);jo_key(rr[..],"inputs");rtq_inputs_json(rr[..],inputs[..],".");jo_end(rr[..]);if stable && !rr[0].bad && fs_write(output,jo_text(rr[..])) {status=0;}}}}cdp_close(c[..]);
  }killed:=proc_kill(server,PROC_SIGKILL);waited:=proc_wait(server,5000);released:=proc_release(server);}
  removed:=fs_remove(work);return ifx removed then status else 1;
}
