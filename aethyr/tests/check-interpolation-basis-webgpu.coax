  inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {return 2;}temp:[4096]u8;work:=fs_temp("aethyr-basis-",temp[..]);if work=="" {return 1;}
  deadline:=proc_deadline(120000,proc_now_ms());if !rtq_deps(inputs[..],compiler,"aethyr/tests/check-interpolation-basis-webgpu.coax",deadline,work,"observer-deps") {return 2;}
