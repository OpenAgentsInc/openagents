// Final controller option and child-exit boundaries. Local fixture artifacts
// are never GPU input; an owned SSH stand-in makes any network attempt fail.
#load "native-gpu-emissions.coax";
eb_env :: (key:string,value:string,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],key);jo_put(o[..],"=");jo_put(o[..],value);return jo_text(o[..]);}
eb_label :: (index:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"case-");jo_int(o[..],index);return jo_text(o[..]);}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}work:=args_value(a[..],"--work-dir","");controller:=args_value(a[..],"--controller","");fixture:=args_value(a[..],"--fixture-compiler","");ssh_fixture:=args_value(a[..],"--fixture-ssh","");real:=args_value(a[..],"--real-coax","");receipt:=args_value(a[..],"--receipt","");
  if work=="" || controller=="" || fixture=="" || ssh_fixture=="" || real=="" || receipt=="" || fs_exists(work) || fs_exists(receipt) || !fs_mkdir(work) {return 2;}
  paths:[8][4096]u8;out:[1048576]u8;err:[65536]u8;none:[]string;deadline:=proc_deadline(810000,proc_now_ms());bin:=fs_join(work,"bin",paths[0][..]);if !fs_mkdir(bin) {return 1;}link:=fs_join(bin,"ssh",paths[1][..]);ln:=[4]string.["ln","-s",ssh_fixture,link];r:=rtq_command(ln[..],none,deadline,work,"no-network-link",out[..],err[..]);if !rtq_ok(r) {return 1;}
  ssh_calls:=fs_join(work,"unexpected-ssh.jsonl",paths[2][..]);calls:=fs_join(work,"compiler-calls.jsonl",paths[3][..]);env_bytes:[6][4096]u8;environment:[6]string;
  environment[0]=eb_env("AETHYR_FRESH_REAL_COAX",real,env_bytes[0][..]);environment[1]=eb_env("AETHYR_FRESH_CALLS",calls,env_bytes[1][..]);environment[2]=eb_env("AETHYR_FRESH_FAIL","RenderCaps.c",env_bytes[2][..]);environment[3]=eb_env("AETHYR_FRESH_SSH_CALLS",ssh_calls,env_bytes[3][..]);path_value:[4096]u8;w:[1]Jo;jo_start(w[..],path_value[..]);jo_put(w[..],bin);jo_put(w[..],":/usr/bin:/bin");environment[4]=eb_env("PATH",jo_text(w[..]),env_bytes[4][..]);environment[5]=eb_env("COAX",real,env_bytes[5][..]);
  inputs:[1]RtqInputs;for file:[4]string.[controller,fixture,ssh_fixture,real] {if !rtq_input_add(inputs[..],file) {return 1;}}
  result:[65536]u8;o:[1]Jo;jo_start(o[..],result[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.native-gpu-entry-boundaries.v1");jo_key(o[..],"gpu_execution");jo_bool(o[..],false);jo_key(o[..],"cases");jo_arr(o[..]);
  for index:0..<7 {
    label:[128]u8;case_dir:=fs_join(work,eb_label(index,label[..]),paths[4][..]);case_receipt_buf:[4096]u8;p:[1]Jo;jo_start(p[..],case_receipt_buf[..]);jo_put(p[..],case_dir);jo_put(p[..],"-receipt.json");case_receipt:=jo_text(p[..]);
    argv:[24]string;n:=0;profile:=ifx index==1 then "helper" else ifx index==5 then "unknown" else "sampling";
    for arg:[11]string.[controller,"--profile",profile,"--emissions-only","--work-dir",case_dir,"--receipt",case_receipt,"--coax",fixture,"--worker-coax"] {argv[n]=arg;n+=1;}argv[n]=real;n+=1;if index!=6 {argv[n]="--explore-stale-compiler";n+=1;}
    if index!=2 {argv[n]="--fresh-emissions";n+=1;}if index==3 {argv[n]="--historical-emissions";n+=1;}if index==4 {argv[n]="--reuse-emissions";argv[n+1]=work;n+=2;}
    r=rtq_command(argv[0..<n],environment[..],deadline,work,eb_label(index,label[..]),out[..],err[..]);expected:=ifx index==0 then 1 else ifx index==1 then 71 else 2;
    if r.started!=0 || r.timed_out || r.cut || r.status!=expected || fs_exists(ssh_calls) || fs_exists(case_receipt) || fs_exists(fs_join(case_dir,"remote-mkdir.json",paths[5][..])) {return 1;}
    if index<2 {payload:=fs_join(case_dir,"payload",paths[5][..]);b:[1048576]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(payload,"qualification.json",paths[6][..]),b[..],nodes[..],d[..]) {return 1;}last:=ifx index==0 then 6 else 2;commands:=rtq_member(d[0],0,"commands");if jv_len(d[0],commands)!=last+1 || jv_int(d[0],rtq_member(d[0],0,"completed"),-1)!=last || jv_int(d[0],rtq_member(d[0],0,"failed_index"),-1)!=last || jv_int(d[0],rtq_member(d[0],jv_at(d[0],commands,last),"exit_code"),-1)!=71 {return 1;}}
    else if fs_exists(case_dir) {return 1;}
    jo_obj(o[..]);jo_key(o[..],"case");jo_int(o[..],index);jo_key(o[..],"exit");jo_int(o[..],r.status);jo_key(o[..],"before_network");jo_bool(o[..],true);jo_end(o[..]);
  }jo_end(o[..]);jo_key(o[..],"status");jo_str(o[..],"passed");jo_key(o[..],"source_inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);if !rtq_inputs_match(inputs[..]) || o[0].bad || !fs_write(receipt,jo_text(o[..])) {return 1;}return 0;
}
