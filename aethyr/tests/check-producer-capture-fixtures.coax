    pn=pfi_pack(false,pack[..]);pfi_u32(pack[..],40,pn-464+1);if !fs_write(payload_pack,cast(string)pack[0..<pn]) {return 1;}
    large:[200002]u8;for k:0..<200000 {large[k]='A';}large[200000]='\n';large[200001]='\n';if !fs_write(small_facts,"A\nB\n\n") || !fs_write(large_facts,cast(string)large[..]) {return 1;}
    override:=[9]u8.[0,255,128,13,10,7,6,5,4];if !fs_write(index_file,cast(string)override[0..<4]) || !fs_write(vertices_file,cast(string)override[..]) || !fs_write(mesh_file,cast(string)override[0..<5]) {return 1;}
  }
  for file:[9]string.[pack_path,zero_pack,table_pack,payload_pack,small_facts,large_facts,index_file,vertices_file,mesh_file] {if !rtq_input_add(inputs[..],file) {return 1;}}
  result:[1048576]u8;o:[1]Jo;jo_start(o[..],result[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.producer-capture-fixtures.v1");jo_key(o[..],"observer_sha256");jo_str(o[..],observer_expected);jo_key(o[..],"gpu_execution");jo_bool(o[..],false);jo_key(o[..],"start_case");jo_int(o[..],start_case);jo_key(o[..],"end_case");jo_int(o[..],end_case);jo_key(o[..],"reused_fixture_inputs");jo_str(o[..],reuse_inputs);jo_key(o[..],"cases");jo_arr(o[..]);
  for index:start_case..<end_case {
    label:[128]u8;case_dir:=fs_join(work,pf_name("case-",index,"",label[..]),paths[11][..]);if !fs_mkdir(case_dir) {return 1;}old_dump:=fs_join(case_dir,"old",paths[12][..]);new_dump:=fs_join(case_dir,"new",paths[13][..]);image:=ifx index==1 || index==3 then 1 else ifx index==14 || index==15 then 2 else ifx index==16 then 3 else 0;wasm:=fs_join(build,wasm_names[image],paths[14][..]);
    common:[48]string;n:=0;for arg:[12]string.["--frames","4","--every","1","--size","32x24","--scale","1.5","--clock","-9223372036854775808","--page","-2"] {common[n]=arg;n+=1;}
    if index==2 || index==3 {for arg:[17]string.["--pack",pack_path,"--facts",small_facts,"--fact","B=2","--extra","7,9","--hash","ok","--keys","1:32:1,2:32:0","--pointer","3:1.5:-3.25","--golden","--index",index_file] {common[n]=arg;n+=1;}for arg:[4]string.["--vertices",vertices_file,"--mesh",mesh_file] {common[n]=arg;n+=1;}}
    if index==4 || index==5 || index==17 || index==18 {common[n]="--pack";common[n+1]=ifx index==4 then pack_path else ifx index==5 then zero_pack else ifx index==17 then table_pack else payload_pack;n+=2;}
    if index==6 {for arg:[4]string.["--facts",large_facts,"--fact","B=2"] {common[n]=arg;n+=1;}}
    if index>=7 && index<=13 {faults:=[7]string.["bad-hud","bad-store","bad-span","bad-particles","bad-draw-span","bad-draw-span","bad-draw-span"];common[n]="--hash";common[n+1]=faults[index-7];n+=2;}
    if index==19 {common[n]="--extra";common[n+1]="7,9";n+=2;}if index==20 {common[n]="--fact";common[n+1]="ignored-without-facts=1";n+=2;}
    if index==14 {common[n]="--keys";common[n+1]="1:32:1";n+=2;}if index==16 {common[n]="--hash";common[n+1]="ignored-if-absent";n+=2;}
    dumped:=index!=12 && index!=13;old_args:[56]string;new_args:[56]string;on:=3;nn:=2;old_args[0]=bun;old_args[1]="aethyr/tests/capture-render-frame.ts";old_args[2]=wasm;new_args[0]=observer;new_args[1]=wasm;
    for arg:common[0..<n] {old_args[on]=arg;on+=1;new_args[nn]=arg;nn+=1;}
