    old:=pf_run(old_args[0..<on],environment[..],deadline,case_dir,"old-observer",out[..],err[..]);old_stdout:[1048576]u8;old_n:=old.out_n;for k:0..<old_n {old_stdout[k]=out[k];}
    fresh:=pf_run(new_args[0..<nn],environment[..],deadline,case_dir,"new-observer",out[..],err[..]);positive:=index<7 || index==12 || index==13 || index==15 || index==16 || index==19 || index==20;
    if old.started!=0 || fresh.started!=0 || old.timed_out || fresh.timed_out || old.cut || fresh.cut || (positive && (old.status!=0 || fresh.status!=0)) || (!positive && (old.status==0 || fresh.status==0)) {tool_err("producer fixture status mismatch case ");tool_errln(pf_name("",index,"",label[..]));return 1;}
    parity_ok:=false;if positive && dumped {parity_file:=fs_join(case_dir,"parity.json",paths[15][..]);argv:=[4]string.[parity,old_dump,new_dump,parity_file];checked:=pf_run(argv[..],environment[..],deadline,case_dir,"parity-check",out[..],err[..]);if !rtq_ok(checked) {tool_err("producer fixture product parity mismatch case ");tool_errln(pf_name("",index,"",label[..]));return 1;}parity_ok=true;}
    if positive && !dumped {if old_n!=fresh.out_n || cast(string)old_stdout[0..<old_n]!=cast(string)out[0..<fresh.out_n] {return 1;}parity_ok=true;}
