// Independent tiny producer qualification for the capture port. No realm,
// renderer or GPU gate runs here. Both observers receive identical Wasm and
// authored inputs; the root-owned checker compares raw artifacts and metadata.
#load "producer-capture-fixture-inputs.coax";
#load "../render/tests/qualification-files.coax";
pf_name :: (prefix:string,index:int,suffix:string,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],prefix);jo_int(o[..],index);jo_put(o[..],suffix);return jo_text(o[..]);}
pf_env :: (key:string,value:string,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],key);jo_put(o[..],"=");jo_put(o[..],value);return jo_text(o[..]);}
pf_run :: (argv:[]string,env:[]string,deadline:int,work:string,label:string,out:[]u8,err:[]u8)->ProcRun {
  left:=proc_left(deadline,proc_now_ms());r:=rtq_run_raw(argv,env,ifx left<120000 then left else 120000,out,err);if !rtq_record_run(work,label,argv,r,cast(string)out[0..<r.out_n],cast(string)err[0..<r.err_n]) {r.cut=true;}return r;
}
pf_build :: (clang:string,sysroot:string,resources:string,build:string,macro:string,name:string,deadline:int,work:string,env:[]string)->bool {
  paths:[4][4096]u8;header:[4096]u8;o:[1]Jo;jo_start(o[..],header[..]);jo_put(o[..],"-I");jo_put(o[..],build);sys:[4096]u8;w:[1]Jo;jo_start(w[..],sys[..]);jo_put(w[..],"--sysroot=");jo_put(w[..],sysroot);
  argv:[30]string;n:=0;for arg:[15]string.[clang,"--target=wasm32-wasip1",jo_text(w[..]),"-resource-dir",resources,"-std=c11","-O2","-ffp-contract=off","-fno-fast-math","-Wno-unused-function","-Wno-unused-variable",jo_text(o[..]),fs_join(build,"ProducerFixture.c",paths[0][..]),"aethyr/tests/producer-capture-fixture-face.c","-mexec-model=reactor"] {argv[n]=arg;n+=1;}
  if macro!="" {argv[n]=macro;n+=1;}argv[n]="-Wl,--import-memory,--max-memory=67108864,-z,stack-size=1048576,--export=__heap_base,--gc-sections,--strip-debug";argv[n+1]="-o";argv[n+2]=fs_join(build,name,paths[1][..]);n+=3;
  out:[1048576]u8;err:[65536]u8;r:=pf_run(argv[0..<n],env,deadline,work,name,out[..],err[..]);return rtq_ok(r);
}
pf_missing_stopped :: (path:string)->bool {
  bytes:[1048576]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],d[..]) {return false;}
  for i:0..<d[0].count {if jv_kind(d[0],i)==JV_OBJECT && jv_kind(d[0],rtq_member(d[0],i,"defined"))==JV_FALSE && jv_kind(d[0],rtq_member(d[0],i,"value"))==JV_NULL {return true;}}return false;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}work:=args_value(a[..],"--work-dir","");receipt:=args_value(a[..],"--receipt","");observer:=args_value(a[..],"--observer","");observer_expected:=args_value(a[..],"--observer-sha256","");bun:=args_value(a[..],"--bun","");parity:=args_value(a[..],"--parity","");compiler:=args_value(a[..],"--coax","");
  clang:=args_value(a[..],"--clang","/opt/homebrew/opt/llvm/bin/clang");sysroot:=args_value(a[..],"--sysroot","/opt/homebrew/opt/wasi-libc/share/wasi-sysroot");resources:=args_value(a[..],"--resources","/opt/homebrew/opt/wasi-runtimes/share/wasi-runtimes");
  start_case:=args_whole(args_value(a[..],"--start-case","0"));end_case:=args_whole(args_value(a[..],"--end-case","21"));reuse_inputs:=args_value(a[..],"--reuse-inputs","");
  if start_case<0 || end_case>21 || start_case>=end_case || work=="" || receipt=="" || observer=="" || observer_expected=="" || bun=="" || parity=="" || compiler=="" || fs_exists(work) || fs_exists(receipt) || !fs_mkdir(work) {return 2;}
  expected:[64]u8;if !rtq_hash_file(observer,expected[..]) || cast(string)expected[..]!=observer_expected {return 2;}
  deadline:=proc_deadline(810000,proc_now_ms());paths:[24][4096]u8;input_root:=ifx reuse_inputs=="" then work else reuse_inputs;build:=fs_join(input_root,"build",paths[0][..]);if reuse_inputs=="" && !fs_mkdir(build) {return 1;}
  inputs:[1]RtqInputs;for file:[10]string.[observer,bun,parity,compiler,clang,"aethyr/tests/capture-render-frame.ts","aethyr/tests/producer-capture-fixture.coax","aethyr/tests/producer-capture-fixture-checks.coax","aethyr/tests/producer-capture-fixture-face.c","aethyr/tests/producer-capture-fixture-inputs.coax"] {if !rtq_input_add(inputs[..],file) {return 1;}}
