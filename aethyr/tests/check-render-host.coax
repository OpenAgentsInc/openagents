rh_has_capture :: (d:Jv)->bool {return jv_kind(d,jv_get(d,0,"capture"))==JV_OBJECT;}
rh_any_media :: (d:Jv,key:string)->bool {array:=jv_get(d,0,"media");if jv_kind(d,array)!=JV_ARRAY {return false;}for k:0..<jv_len(d,array) {if rh_true(d,jv_at(d,array,k),key) {return true;}}return false;}
rh_observe :: (c:[]Cdp,s:[]RhSession,options:RhOptions,dpr:string,observed:[]RhObserved,inputs:[]RtqInputs,manifest:string)->bool {
