    if options.mediaVideo {
      if !rh_void(c,s,"videoStart") {return false;}proc_sleep(300);observed[0].n[8]=rh_call(c,s,"videoStop",observed[0].v[8][..]);d:[1]Jv;nodes:[2048]JvNode;
      if observed[0].n[8]<1 || !jv_parse(d[..],cast(string)observed[0].v[8][0..<observed[0].n[8]],nodes[..]) || rh_number(d[0],0,"audio_tracks")!=0 || rh_number(d[0],0,"bytes")<1 || !rh_transfer(c,s,d[0],jv_get(d[0],0,"transport"),"fixture.webm") {return rh_error(s,"fixture video is not silent or transport failed");}
      paths:[2][4096]u8;source:=fs_join(s[0].work,"fixture.webm",paths[0][..]);target:=fs_join(s[0].work,"video/fixture.webm",paths[1][..]);if !rlay_copy(source,0,fs_size(source),target) || !rtq_input_add(inputs,target) {return false;}
    }
    if options.mediaFixture {scratch:[65536]u8;if rh_effect(c,s,"fixture",ifx options.mediaVideo then "{\"video\":true}" else "{}",30000,scratch[..])<1 {return false;}}
  }
