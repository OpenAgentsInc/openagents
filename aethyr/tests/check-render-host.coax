  return rh_complete(rh_has_capture(sd[0]),true,true,options.requireDraws,rh_number(sd[0],0,"capture.admitted_draws")) && rh_artifacts(c,s,cast(string)observed[0].v[1][0..<observed[0].n[1]],manifest,inputs);
}
rh_control :: (o:[]Jo,options:RhOptions,observed:[]RhObserved) {
