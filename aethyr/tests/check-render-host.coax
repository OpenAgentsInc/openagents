  if options.mediaControls && captured {observed[0].n[3]=rh_media_phase(c,s,observed[0].v[3][..]);if observed[0].n[3]<1 {return false;}}
  if options.engineReload && captured {observed[0].n[5]=rh_engine_phase(c,s,false,observed[0].v[5][..]);if observed[0].n[5]<1 {return false;}}
