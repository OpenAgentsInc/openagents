    if observed[0].started && !observed[0].armed && rh_true(sd[0],0,"ready") && rh_number(sd[0],0,"render.readiness")==2 && (!options.mediaFixture || rh_any_media(sd[0],"ready")) {observed[0].arm_n=rh_call(c,s,"capture",observed[0].arm[..]);if observed[0].arm_n<1 {return false;}observed[0].armed=true;}
    if rh_has_capture(sd[0]) || rtq_find(jv_raw(sd[0],jv_get(sd[0],0,"loader")),"FAILED:",0)>=0 || rh_any_media(sd[0],"failed") {break;}proc_sleep(100);
  }
  captured:=rh_has_capture(sd[0]);
  if options.mediaVideo && captured {video:[262144]u8;vn:=rh_call(c,s,"videoObserved",video[..]);vd:[1]Jv;v_nodes:[4096]JvNode;if vn<1 || !jv_parse(vd[..],cast(string)video[0..<vn],v_nodes[..]) || !rh_video(vd[0],0) {return rh_error(s,"actual silent video did not reach production media texture");}
    fresh:[524288]u8;o:[1]Jo;jo_start(o[..],fresh[..]);jo_obj(o[..]);jo_key(o[..],"media_video");jo_raw(o[..],cast(string)video[0..<vn]);jo_end(o[..]);merged:[1048576]u8;mn:=rh_merge(cast(string)observed[0].v[1][0..<observed[0].n[1]],jo_text(o[..]),merged[..]);if mn<1 {return false;}for k:0..<mn {observed[0].v[1][k]=merged[k];}observed[0].n[1]=mn;
  }
