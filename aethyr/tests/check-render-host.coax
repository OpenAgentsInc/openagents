  jo_key(o,"width");jo_int(o,options.width);jo_key(o,"height");jo_int(o,options.height);if observed[0].n[10]>0 {d:[1]Jv;nodes:[256]JvNode;if jv_parse(d[..],cast(string)observed[0].v[10][0..<observed[0].n[10]],nodes[..]) {jo_key(o,"dpr");jv_write(d[0],jv_get(d[0],0,"dpr"),o);}}
  jo_key(o,"started");jo_bool(o,observed[0].started);jo_key(o,"armed");jo_bool(o,observed[0].armed);if observed[0].arm_n>0 {jo_key(o,"armResult");jo_raw(o,cast(string)observed[0].arm[0..<observed[0].arm_n]);}if observed[0].n[8]>0 {d:[1]Jv;nodes:[2048]JvNode;if jv_parse(d[..],cast(string)observed[0].v[8][0..<observed[0].n[8]],nodes[..]) {jo_key(o,"videoFixture");jo_obj(o);child:=d[0].nodes[0].first;while child!=-1 {if jv_key(d[0],child)!="transport" {jo_key(o,jv_key(d[0],child));jv_write(d[0],child,o);}child=d[0].nodes[child].next;}jo_end(o);}}jo_end(o);
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}child:=rto_child(a[..]);if child>=0 {return child;}options:=rh_options(a[..]);dpr:[131072]u8;dn:=rh_dpr(options.dpr,dpr[..]);if !options.valid || dn<1 {tool_errln("usage: check-render-host ENGINE.wasm PACKAGE_DIR PAGE.html NEW_OUTDIR [legacy host flags] [--surface-root DIR]");return 2;}
