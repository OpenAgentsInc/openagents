// Production layer upload/readback effects under a Coax controller.
// Resource conformance only; no whole-realm frame or new product emission.
#import "Basic";
#load "render-layer-tools.coax";
RlayObservation :: struct {browser:[65536]u8;browser_n:int;capture:[65536]u8;capture_n:int;total:int;fixture:[1]RlayFixture;}
rlay_observe :: (c:[]Cdp,url:string,profile:int,surface:string,wasm:string,manifest:string,work:string,inputs:[]RtqInputs,result:[]RlayObservation)->bool {
  deadline:=proc_now_ms()+180000;effects:[131072]u8;en:=fs_read(RLAY_EFFECTS,effects[..]);if en<1 {return false;}result[0].browser_n=wp_open(c,url,cast(string)effects[0..<en],result[0].browser[..]);if result[0].browser_n<1 {return false;}
  request:[CDP_REQ]u8;o:[1]Jo;jo_start(o[..],request[..]);jo_obj(o[..]);jo_key(o[..],"profile");jo_int(o[..],profile);jo_end(o[..]);setup:[262144]u8;sn:=rlay_effect(c,"renderLayerInitialize",jo_text(o[..]),deadline,work,"initialize.json",setup[..]);d:[1]Jv;nodes:[32768]JvNode;wh:[64]u8;ph:[64]u8;
  if sn<1 || !jv_parse(d[..],cast(string)setup[0..<sn],nodes[..]) || !rtq_hash_file(wasm,wh[..]) || !rtq_hash_file(manifest,ph[..]) || !rlay_init(d[0],cast(string)wh[..],fs_size(wasm),cast(string)ph[..],fs_size(manifest)) || !rlay_plan(d[0],surface,work,result[0].fixture[..],inputs,deadline) {return false;}
  rn:=rlay_decode_request(result[0].fixture[..],request[..]);if rn<1 {return false;}decoded:[262144]u8;dn:=rlay_effect(c,"renderLayerDecode",cast(string)request[0..<rn],deadline,work,"decoded.json",decoded[..]);decode_nodes:[32768]JvNode;dd:[1]Jv;if dn<1 || !jv_parse(dd[..],cast(string)decoded[0..<dn],decode_nodes[..]) || !rlay_decode_matches(result[0].fixture[..],dd[0]) {return false;}
  jo_start(o[..],request[..]);jo_obj(o[..]);jo_key(o[..],"set");jo_int(o[..],0);jo_key(o[..],"resource");jo_int(o[..],result[0].fixture[0].resource);jo_end(o[..]);result[0].capture_n=rlay_effect(c,"renderLayerCapture",jo_text(o[..]),deadline,work,"capture.json",result[0].capture[..]);capture_doc:[1]Jv;capture_nodes:[8192]JvNode;
  if result[0].capture_n<1 || !jv_parse(capture_doc[..],cast(string)result[0].capture[0..<result[0].capture_n],capture_nodes[..]) {return false;}result[0].total=rlay_size(capture_doc[0],jv_get(capture_doc[0],0,"capture"));return result[0].total>=0 && result[0].total==jv_int(capture_doc[0],jv_get(capture_doc[0],0,"bytes"),-1) && rlay_transport(c,capture_doc[0],result[0].total,work,deadline,inputs);
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}child:=rto_child(a[..]);if child>=0 {return child;}wasm_arg:=args_value(a[..],"--wasm","");package_arg:=args_value(a[..],"--package","");work_arg:=args_value(a[..],"--work-dir","");profile:=rlay_profile(args_value(a[..],"--profile","0"));
  if wasm_arg=="" || package_arg=="" || work_arg=="" || profile<0 || !fs_mkdir(work_arg) {tool_errln("usage: check-render-layers --wasm HOST.wasm --package DIR --work-dir NEW_DIR [--profile N] [--surface-root DIR] [--reference OLD_RECEIPT.json]");return 2;}
  buffers:[8][4096]u8;repo:=fs_cwd(buffers[0][..]);surface:=fs_realpath(args_value(a[..],"--surface-root",repo),buffers[1][..]);wasm:=fs_realpath(wasm_arg,buffers[2][..]);package:=fs_realpath(package_arg,buffers[3][..]);work:=fs_realpath(work_arg,buffers[4][..]);receipt:=fs_join(work,"receipt.json",buffers[5][..]);config:=fs_join(work,"origin-config.json",buffers[6][..]);manifest:=fs_join(package,"render.json",buffers[7][..]);if surface=="" || wasm=="" || package=="" || work=="" || fs_exists(receipt) || fs_exists(config) {return 2;}
  started:=proc_now_ms();inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_input_add(inputs[..],compiler) || !rtq_deps(inputs[..],compiler,"aethyr/tests/check-render-layers.coax",started+30000,work,"tool-dependencies") {return 1;}
  for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {for ext:[2]string.[".c",".h"] {path:[4096]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],ext);if !rtq_input_add(inputs[..],jo_text(o[..])) {return 1;}}}
  self:[4096]u8;image:=gp_self(self[..]);image_hash:[64]u8;compiler_hash:[64]u8;if !rtq_input_add(inputs[..],image) || !rtq_hash_file(image,image_hash[..]) || !rtq_hash_file(compiler,compiler_hash[..]) {return 1;}
  for file:[4]string.[wasm,manifest,RLAY_EFFECTS,"coax/web/tool.sh"] {if !rtq_input_add(inputs[..],file) {return 1;}}for name:[2]string.["coax/web/render.js","coax/web/render-face.c"] {path:[4096]u8;if !rtq_input_add(inputs[..],fs_join(surface,name,path[..])) {return 1;}}
  chrome:[4096]u8;if !rtq_input_add(inputs[..],cdp_chrome(chrome[..])) || !rlay_config(surface,wasm,package,work,config) {return 1;}
  paths:[2][4096]u8;port_file:=fs_join(work,"origin-port",paths[0][..]);ledger:=fs_join(work,"origin",paths[1][..]);server:=rto_start(port_file,config,ledger);if server<0 {return 1;}port_text:[32]u8;pn:=-1;for attempt:0..<100 {pn=fs_read(port_file,port_text[..]);if pn>0 {break;}proc_sleep(20);}port:=ifx pn>0 then args_whole(cast(string)port_text[0..<pn]) else -1;
  c:[1]Cdp;observation:[1]RlayObservation;observed:=false;if port>0 {url:[256]u8;o:[1]Jo;jo_start(o[..],url[..]);jo_put(o[..],"http://127.0.0.1:");jo_int(o[..],port);jo_put(o[..],"/");observed=rlay_observe(c[..],jo_text(o[..]),profile,surface,wasm,manifest,work,inputs[..],observation[..]);}
  if !observed {saved:=rto_saved(work,"failure-cdp.json",cast(string)c[0].msg[0..<c[0].msg_n]);}cdp_close(c[..]);finalized:=port>0 && rto_finalize(port);status:=proc_wait(server,5000);if status==PROC_RUNNING {killed:=proc_kill(server,PROC_SIGKILL);status=proc_wait(server,5000);}released:=proc_release(server);source_join:=finalized && status==0 && rto_add_inputs(ledger,inputs[..]);
  captured:[1]Jv;capture_nodes:[8192]JvNode;capture_at:=-1;assembled:=false;if observed && source_join && jv_parse(captured[..],cast(string)observation[0].capture[0..<observation[0].capture_n],capture_nodes[..]) {capture_at=jv_get(captured[0],0,"capture");assembled=rlay_assemble(work,observation[0].total,captured[0],capture_at);}
  same:=rtq_inputs_match(inputs[..]);passed:=observed && source_join && assembled && same;body:[1048576]u8;o:[1]Jo;jo_start(o[..],body[..]);jo_obj(o[..]);jo_key(o[..],"status");jo_str(o[..],ifx passed then "passed" else "failed");jo_key(o[..],"profile");jo_int(o[..],profile);if observed && capture_at>=0 {jo_key(o[..],"urls");jo_raw(o[..],cast(string)observation[0].fixture[0].urls[0..<observation[0].fixture[0].urls_n]);jo_key(o[..],"packed");jo_raw(o[..],cast(string)observation[0].fixture[0].packed[0..<observation[0].fixture[0].packed_n]);jo_key(o[..],"adapter");jo_raw(o[..],cast(string)observation[0].fixture[0].adapter[0..<observation[0].fixture[0].adapter_n]);jo_key(o[..],"capture");jv_write(captured[0],capture_at,o[..]);}jo_end(o[..]);
  reference:=args_value(a[..],"--reference","");parity:=true;if reference!="" {old_bytes:[1048576]u8;old_nodes:[32768]JvNode;old:[1]Jv;new_nodes:[32768]JvNode;fresh:[1]Jv;parity=rtq_json_file(reference,old_bytes[..],old_nodes[..],old[..]) && jv_parse(fresh[..],jo_text(o[..]),new_nodes[..]) && rtq_equal(old[0],jv_get(old[0],0,"status"),fresh[0],0) && rtq_input_add(inputs[..],reference);}
  record:[4194304]u8;writer:[1]Jo;jo_start(writer[..],record[..]);jo_obj(writer[..]);jo_key(writer[..],"schema");jo_str(writer[..],"aethyr.render.layer-effects.v1");jo_key(writer[..],"version");if observation[0].browser_n>0 {jo_raw(writer[..],cast(string)observation[0].browser[0..<observation[0].browser_n]);}else {jo_null(writer[..]);}jo_key(writer[..],"inputs");rtq_inputs_json(writer[..],inputs[..],repo);jo_key(writer[..],"source_changes");jo_arr(writer[..]);if !same {jo_str(writer[..],"source fence changed");}jo_end(writer[..]);jo_key(writer[..],"status");jo_raw(writer[..],jo_text(o[..]));jo_key(writer[..],"observer_image_sha256");jo_str(writer[..],cast(string)image_hash[..]);jo_key(writer[..],"compiler_sha256");jo_str(writer[..],cast(string)compiler_hash[..]);jo_key(writer[..],"origin_finalized");jo_bool(writer[..],source_join);jo_key(writer[..],"stable_reference_equal");jo_bool(writer[..],reference!="" && parity);jo_key(writer[..],"transport_parts");jo_int(writer[..],ifx observed then rlay_parts(observation[0].total) else 0);jo_key(writer[..],"elapsed_ms");jo_int(writer[..],proc_now_ms()-started);jo_end(writer[..]);
  if writer[0].bad || o[0].bad || !fs_write(receipt,jo_text(writer[..])) {return 1;}print("layer resource effects: %\n",passed && parity);return ifx passed && parity then 0 else 1;
}
