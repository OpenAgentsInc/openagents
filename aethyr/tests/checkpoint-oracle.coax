// The checks' side of aethyr/checkpoint.coax: the fleet of aethyr/tests/decide-oracle.coax (four
// creatures a model steers while a player walks past) as the realm. A captured run journals every
// accepted event and step digest, takes a checkpoint every CO_EVERY steps into two slots in turn,
// posts an XP grant to an outside ledger for each model intent it admits, and stops (a crash) at
// CO_CRASH. A restore reads the newest whole checkpoint and the journal, and runs the steps again.
// Only the checks call it.
#load "../ai/decide.coax";

CO_EVERY :: 80;
CO_CRASH :: 200;
CO_SLOT :: 1024;            // words a checkpoint slot holds
CO_JOURNAL :: 16384;        // words the journal holds
CO_LEDGER :: 256;
CO_PINS :: CheckpointPins.{engine = 11, content = 22, rules = 33, profile = 44};

// The fleet's state as words, and back.
co_bits :: (v: f32) -> int { return replay_bits(v); }
co_float :: (w: int) -> f32 { return replay_float(w); }
co_save :: (r: [] DoRun, out: [] int) -> int {
  k := 0;
  out[k] = co_bits(r[0].px); out[k + 1] = co_bits(r[0].pz); k += 2;
  for a: 0..<DO_ACTORS {
    out[k] = co_bits(r[0].x[a]); out[k + 1] = co_bits(r[0].z[a]); out[k + 2] = co_bits(r[0].gx[a]); out[k + 3] = co_bits(r[0].gz[a]); out[k + 4] = r[0].chase[a]; k += 5;
    m := r[0].mem[a];
    out[k] = m.count; out[k + 1] = m.latest; out[k + 2] = m.refused; out[k + 3] = m.forgotten; k += 4;
    for i: 0..<SENSE_MEMORY {
      st := m.items[i];
      out[k] = cast(int) st.kind; out[k + 1] = st.source; out[k + 2] = co_bits(st.at.x); out[k + 3] = co_bits(st.at.y); out[k + 4] = co_bits(st.at.z); out[k + 5] = st.tick; k += 6;
    }
  }
  t := r[0].t[0];
  for q: 0..<DECIDE_FLEET {
    tk := t.tickets[q];
    out[k] = replay_flag(tk.live); out[k + 1] = tk.request; out[k + 2] = tk.actor; out[k + 3] = tk.owner; out[k + 4] = tk.context; out[k + 5] = tk.due; k += 6;
  }
  for a: 0..<DECIDE_ACTORS { out[k] = t.owner[a]; out[k + 1] = t.catalogue[a]; k += 2; }
  for c: 0..<DECIDE_COUNTERS { out[k] = t.counts[c]; k += 1; }
  return k;
}
co_load :: (r: [] DoRun, b: [] int, at: int) {
  k := at;
  r[0].px = co_float(b[k]); r[0].pz = co_float(b[k + 1]); k += 2;
  for a: 0..<DO_ACTORS {
    r[0].x[a] = co_float(b[k]); r[0].z[a] = co_float(b[k + 1]); r[0].gx[a] = co_float(b[k + 2]); r[0].gz[a] = co_float(b[k + 3]); r[0].chase[a] = b[k + 4]; k += 5;
    m: Memory;
    m.count = b[k]; m.latest = b[k + 1]; m.refused = b[k + 2]; m.forgotten = b[k + 3]; k += 4;
    for i: 0..<SENSE_MEMORY {
      m.items[i] = Stimulus.{kind = cast(StimulusKind) b[k], source = b[k + 1], at = world_point(co_float(b[k + 2]), co_float(b[k + 3]), co_float(b[k + 4])), tick = b[k + 5]}; k += 6;
    }
    r[0].mem[a] = m;
  }
  for q: 0..<DECIDE_FLEET {
    r[0].t[0].tickets[q] = DecideTicket.{live = b[k] == 1, request = b[k + 1], actor = b[k + 2], owner = b[k + 3], context = b[k + 4], due = b[k + 5]}; k += 6;
  }
  for a: 0..<DECIDE_ACTORS { r[0].t[0].owner[a] = b[k]; r[0].t[0].catalogue[a] = b[k + 1]; k += 2; }
  for c: 0..<DECIDE_COUNTERS { r[0].t[0].counts[c] = b[k]; k += 1; }
}

// The outside domain: XP grants by operation id, each applied once.
CoLedger :: struct { ids: [CO_LEDGER] int; n: int; applied: int; repeats: int; }
co_grant :: (l: [] CoLedger, id: int) {
  for i: 0..<l[0].n { if l[0].ids[i] == id { l[0].repeats += 1; return; } }
  if l[0].n < CO_LEDGER { l[0].ids[l[0].n] = id; l[0].n += 1; l[0].applied += 1; }
}
// One step and its grants: one for each model intent the step admitted.
co_step :: (r: [] DoRun, s: ReplaySession, owner: int, l: [] CoLedger) {
  t := replay_tick(s);
  before := r[0].from_model;
  do_step(r, s);
  for k: before..<r[0].from_model { co_grant(l, checkpoint_op(owner, t, k - before)); }
}

CoCapture :: struct {
  run: [1] DoRun;
  slots: [2][CO_SLOT] int; slot_n: [2] int; taken: int;
  journal: [CO_JOURNAL] int; journal_n: int;
  ledger: [1] CoLedger;
  final: [CO_SLOT] int; final_n: int;   // the fleet's state at the crash
}
// The captured run: profile `profile`, owner `owner`, checkpoints every CO_EVERY steps, a crash at CO_CRASH.
co_capture :: (c: [] CoCapture, profile: int, owner: int) {
  r := c[0].run[..];
  do_init(r, profile);
  s := do_session(r);
  replay_record(s, 7, 1);
  state: [CO_SLOT] int;
  journaled := 0;
  while replay_tick(s) < CO_CRASH {
    t := replay_tick(s);
    if t > 0 && t % CO_EVERY == 0 {
      w := co_save(r, state[..]);
      slot := checkpoint_slot(c[0].taken);
      c[0].slot_n[slot] = checkpoint_write(c[0].slots[slot][..], CO_PINS, owner, s, state[0..<w]);
      c[0].taken += 1;
    }
    co_step(r, s, owner, c[0].ledger[..]);
    // publish the step: the events it took, then its digest
    while journaled < replay_events(s) { c[0].journal_n += journal_event(c[0].journal[..], c[0].journal_n, owner, s.events[journaled]); journaled += 1; }
    c[0].journal_n += journal_mark(c[0].journal[..], c[0].journal_n, owner, t, s.marks[t]);
  }
  c[0].final_n = co_save(r, c[0].final[..]);
}

CoRestore :: struct { run: [1] DoRun; status: int; slot: int; tick: int; matched: bool; diverged: int; same_state: bool; journal: JournalRead; }
// Restores from the capture's slots and journal (the first `journal_n` words) as `pins`, with
// `fence`; `nudge` moves one creature a metre after loading, as a wrong restore would.
co_restore :: (c: [] CoCapture, out: [] CoRestore, journal_n: int, pins: CheckpointPins, fence: int, owner: int, nudge: bool, l: [] CoLedger) {
  a := checkpoint_read(c[0].slots[0][..], c[0].slot_n[0], pins, fence);
  b := checkpoint_read(c[0].slots[1][..], c[0].slot_n[1], pins, fence);
  pick := checkpoint_pick(a, b);
  out[0].slot = pick;
  if pick < 0 { out[0].status = ifx a.status == CK_EMPTY then b.status else a.status; return; }
  rd := ifx pick == 0 then a else b;
  buf := ifx pick == 0 then c[0].slots[0][..] else c[0].slots[1][..];
  r := out[0].run[..];
  do_init(r, c[0].run[0].profile);
  co_load(r, buf, rd.state);
  if nudge { r[0].x[2] += 1; }
  s := do_session(r);
  j := journal_read(c[0].journal[..], journal_n, fence, s);
  out[0].journal = j;
  if !checkpoint_resume(s, buf, rd, j) { out[0].status = CK_TORN; return; }
  out[0].tick = rd.tick;
  while replay_tick(s) < s.n[REPLAY_MARKS] { co_step(r, s, owner, l); }
  out[0].matched = replay_matched(s);
  out[0].diverged = replay_diverged(s);
  now: [CO_SLOT] int; n := co_save(r, now[..]);
  same := n == c[0].final_n;
  for i: 0..<n { if same && now[i] != c[0].final[i] { same = false; } }
  out[0].same_state = same;
}
