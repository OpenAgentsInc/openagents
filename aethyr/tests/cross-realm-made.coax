// Cross-realm checks for made realms (GitHub #12721): apps/openagents-web/myrealm.coax, the page
// every realm made at /worlds/new opens in, and Aethyrforge's canvas. It keeps its own controls
// (W and S walk, A and D turn) but walks on Aethyr's clock (aethyr/loop.coax) and is pushed out of
// what stands by the shared walker (aethyr/walk.coax move_across), so it is checked here as the
// walking realms are in cross-realm.coax, in a file of its own because the page declares names the
// walker's modules also use:
//
//   - the feet: you are drawn between the last two steps, nowhere else, and on the ground at 0;
//   - replay: the session's recorded frames, stalls and all, played into a fresh realm give the
//     same realm, bit for bit, every frame, and a changed frame is found where it changes;
//   - frame rate: myrealm.coax's own "the walk is the same at 30, 60, 120 and 144 frames a second".
//
//   coax/bin/coax test aethyr/tests/cross-realm-made.coax

#load "../../apps/openagents-web/myrealm.coax";

CM_FRAMES :: 300;
CM_FRAME :: 1.0 / 60.0;

// The session: walk 4.3 s, turning right for the last half second of it, with two jumps.
CmFrame :: struct { walk: bool; turn: bool; jump: bool; }
cm_session :: (f: int) -> CmFrame {
  return CmFrame.{walk = f < 260, turn = f >= 230 && f < 260, jump = f == 60 || f == 200};
}

cm_open :: (s: [] MyRealm, t: [] Track) {
  opened(s, t, "moonlit-marsh", SPEC);
  s[0].clock = loop_clock(0);   // from a paid clock: opening drew frames
}
cm_frame :: (s: [] MyRealm, t: [] Track, c: CmFrame, dt: f32) {
  w := realm_key(s, t, 'w', c.walk);
  d := realm_key(s, t, 'd', c.turn);
  if c.jump { j := realm_key(s, t, ' ', true); }
  realm_step(s, dt);
}
cm_same :: (a: [] MyRealm, b: [] MyRealm) -> bool {
  return f32_bits(a[0].sim_x) == f32_bits(b[0].sim_x) && f32_bits(a[0].sim_y) == f32_bits(b[0].sim_y) &&
    f32_bits(a[0].sim_z) == f32_bits(b[0].sim_z) && f32_bits(a[0].sim_yaw) == f32_bits(b[0].sim_yaw) &&
    f32_bits(a[0].x) == f32_bits(b[0].x) && f32_bits(a[0].z) == f32_bits(b[0].z) &&
    f32_bits(a[0].vy) == f32_bits(b[0].vy) && f32_bits(a[0].walked) == f32_bits(b[0].walked) &&
    a[0].clock.ticks == b[0].clock.ticks && a[0].clock.carry_ns == b[0].clock.carry_ns;
}

#test "a made realm draws you between its last two steps, and on the ground at the ground" #steps 120000000 {
  s: [1] MyRealm; t: [1] Track;
  cm_open(s[..], t[..]);
  airborne := 0; grounded := 0; between := 0;
  for f: 0..<CM_FRAMES {
    cm_frame(s[..], t[..], cm_session(f), f32(CM_FRAME));
    a := loop_alpha(s[0].clock);
    #assert a >= 0 && a < 1;
    #assert s[0].x == loop_mix(s[0].prev_x, s[0].sim_x, a) && s[0].z == loop_mix(s[0].prev_z, s[0].sim_z, a);
    #assert s[0].y >= lo(s[0].prev_y, s[0].sim_y) && s[0].y <= hi(s[0].prev_y, s[0].sim_y);
    if s[0].prev_z != s[0].sim_z && a > 0 { between += 1; }
    if s[0].sim_y == 0 && s[0].prev_y == 0 { grounded += 1; #assert s[0].y == 0; }
    else { airborne += 1; #assert s[0].sim_y >= 0; }
  }
  #assert airborne > 40;
  #assert grounded > 100;
  #assert between > 100;
}

#test "a made realm's recorded session replays bit for bit, every frame" #steps 300000000 {
  s: [1] MyRealm; t: [1] Track;
  r: [1] MyRealm; u: [1] Track;
  cm_open(s[..], t[..]); cm_open(r[..], u[..]);
  first := -1;
  for f: 0..<CM_FRAMES {
    // A stall every 97 frames: the clock's clamp and dropped backlog replay too.
    dt: f32 = ifx f % 97 == 96 then 0.25f32 else f32(CM_FRAME);
    cm_frame(s[..], t[..], cm_session(f), dt);
    cm_frame(r[..], u[..], cm_session(f), dt);
    #assert cm_same(s[..], r[..]);
  }
  #assert s[0].clock.stalls == 3 && s[0].walked > 8;
  // A changed frame is found at the first frame it changes.
  c: [1] MyRealm; v: [1] Track;
  q: [1] MyRealm; w: [1] Track;
  cm_open(c[..], v[..]); cm_open(q[..], w[..]);
  for f: 0..<CM_FRAMES {
    k := cm_session(f);
    cm_frame(q[..], w[..], k, f32(CM_FRAME));
    if f == 150 { k.walk = false; }   // let go for one frame
    cm_frame(c[..], v[..], k, f32(CM_FRAME));
    if first < 0 && !cm_same(c[..], q[..]) { first = f; }
  }
  #assert first == 150;
}
