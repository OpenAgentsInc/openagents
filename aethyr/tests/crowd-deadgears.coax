// Dead Gears' mutants on Aethyr's shared navigation and senses (#12854), held to the independent
// oracles on the real deck, and in crowds. The flow fields verse/deadgears/arena.coax bakes match
// aethyr/tests/nav-oracle.coax's brute-force distances cell for cell, before and after rubble
// blocks a route; what a mutant sees matches aethyr/tests/stimulus-oracle.coax's sampled line on
// every line the oracle can decide. Two crowds meeting head on in a narrow passage keep right and
// pass, whether the passage is one, two or three bodies wide. deadgears_npc_case gives the
// same digests natively (aethyr/tests/crowd-deadgears-native.coax) and in wasm
// (coax/web/tool.sh replay-hosts deadgears, through crowd-deadgears-face.c).
//   coax/bin/coax test aethyr/tests/crowd-deadgears.coax --library --steps 4000000000
#load "../../verse/deadgears/rules.coax";
#load "nav-oracle.coax";
#load "stimulus-oracle.coax";
#load "../rand.coax";

// ---- the oracles on the deck

// The deck's boxes as the sight oracle reads them: x0, y0, z0, x1, y1, z1 each.
cdg_boxes :: (a: [] Arena, out: [] f32) -> int {
  for i: 0..<a[0].n {
    b := a[0].boxes[i];
    out[i * 6] = b.lo.x; out[i * 6 + 1] = b.lo.y; out[i * 6 + 2] = b.lo.z;
    out[i * 6 + 3] = b.hi.x; out[i * 6 + 4] = b.hi.y; out[i * 6 + 5] = b.hi.z;
  }
  return a[0].n * 6;
}

// Flow f to goal on n agrees with the oracle's distances in every cell, and each next cell is
// one the oracle would take.
cdg_flow_agrees :: (n: [] Nav, goal: Point) -> bool {
  if !nav_flow_to(n, 0, goal, 1000) { return false; }
  want: [NAV_CELLS] f32;
  nav_oracle_costs(NAV_NX, NAV_NZ, f32(NAV_CELL), n[0].walk[..], n[0].flows[0].goal, want[..]);
  for c: 0..<NAV_CELLS {
    if n[0].flows[0].cost[c] != want[c] { return false; }
    if want[c] < f32(NAV_ORACLE_FAR) && nav_downhill(n, 0, c) != nav_oracle_next(NAV_NX, NAV_NZ, n[0].walk[..], want[..], c) { return false; }
  }
  return true;
}

#test "the deck's flow fields are the oracle's distances, and stay so when rubble blocks a route" #steps 3000000000 {
  st: [1] Store; g := dg_bind(st[..]); dg_setup(g);
  goals := [3] Point.[v3(0, 0, 8), v3(-12, 0, -6), v3(10, 0, -20)];
  for k: 0..<3 { #assert cdg_flow_agrees(g.nav, goals[k]); }
  #assert cdg_flow_agrees(g.nav, goals[1]);
  before := g.nav[0].flows[0].cost[nav_cell_at(v3(-12, 0, 2))];
  r := dg_add_cover(g, -12, -2, 4, 0.8, 1.2);   // across the way from (-12, 2) to (-12, -6)
  #assert r != ECS_NONE && cdg_flow_agrees(g.nav, goals[1]);
  #assert g.nav[0].flows[0].cost[nav_cell_at(v3(-12, 0, 2))] > before;   // the way round is longer
}

#forall "what a mutant sees is the sampled oracle's line, wherever the oracle can decide" which: 0..<4 #steps 2000000000 {
  st: [1] Store; g := dg_bind(st[..]); dg_setup(g);
  boxes: [BOXES * 6] f32;
  nb := cdg_boxes(g.arena, boxes[..]);
  judged := 0; seen := 0;
  for k: 0..<60 {
    p := v3(-15 + 30 * f32(rand_u32(which, 3, k * 4) % 10000) / 10000.0, 0, -23 + 36 * f32(rand_u32(which, 3, k * 4 + 1) % 10000) / 10000.0);
    q := v3(-15 + 30 * f32(rand_u32(which, 3, k * 4 + 2) % 10000) / 10000.0, 0, -23 + 36 * f32(rand_u32(which, 3, k * 4 + 3) % 10000) / 10000.0);
    eye := world_point(p.x, 1.3, p.z); at := world_point(q.x, 1.3, q.z);
    wide := so_blocked(boxes[0..<nb], eye, at, 0.05); narrow := so_blocked(boxes[0..<nb], eye, at, -0.05);
    if wide != narrow { continue; }   // grazes an edge: the oracle can't decide
    judged += 1;
    #assert arena_sees(g.arena, p, q) == !wide;
    if !wide { seen += 1; }
  }
  #assert judged > 40 && seen > 5 && seen < judged;   // both answers are exercised
}

// ---- crowds
// Two crowds of three meet head on in a passage `w` metres wide, 4 m long, between tall covers at
// x = 11.2 on the east of the deck: one goes north, one south, each remembering its goal. Up to
// `frames` steps of 1/20 s, until every mutant is past the passage's far end.
Passage :: struct { crossed: int; frames: int; nearest: f32 = 100; inside: bool; over: bool; digest: int; }
PASS_NORTH :: Point.{x = 11.2, y = 0, z = 7.5};
PASS_SOUTH :: Point.{x = 11.2, y = 0, z = -7.5};
passage_run :: (g: Game, w: f32, frames: int) -> Passage {
  dg_setup(g);
  g.st[0].ally_time = 1000000;
  clear_mutants(g);
  r := dg_add_cover(g, 11.2 - w / 2 - 1.8, 0, 3.6, 4, 1.6);
  r = dg_add_cover(g, 11.2 + w / 2 + 1.8, 0, 3.6, 4, 1.6);
  ids: [6] int;
  for k: 0..<3 { ids[k] = spawn_now(g, REAVER, 10.4 + 0.8 * f32(k), -7, -1); ids[k + 3] = spawn_now(g, REAVER, 10.4 + 0.8 * f32(k), 7, -1); }
  out: Passage;
  while out.frames < frames && out.crossed < 6 {
    for k: 0..<6 { mind_saw(g, slot_of(ids[k]), ifx k < 3 then PASS_NORTH else PASS_SOUTH); g.mutant[slot_of(ids[k])].attack = 1000; }
    before := g.nav[0].bakes;
    tick(g, MIND_INSIDE, false, false, 0, -1, 0.05);
    if g.nav[0].bakes - before > NAV_STEP_BAKES { out.over = true; }
    out.crossed = 0;
    for k: 0..<6 {
      i := slot_of(ids[k]);
      if dg_blocked(g, g.pos[i].x, g.pos[i].z, 0.05) { out.inside = true; }
      if (k < 3 && g.pos[i].z > 2.5) || (k >= 3 && g.pos[i].z < -2.5) { out.crossed += 1; }
      for j: k + 1..<6 { out.nearest = lo(out.nearest, flat(g.pos[i], g.pos[slot_of(ids[j])])); }
    }
    out.frames += 1;
  }
  out.digest = dg_digest(g);
  return out;
}
// One body wide (1.6 m) and two (2.2 m) the same: aethyr/tests/crowd-deadgears-native.coax runs
// all three widths, and the digests below hold wasm to them.
#test "two crowds meeting head on in a narrow passage keep right and pass each other" #steps 9000000000 {
  st: [1] Store; g := dg_bind(st[..]);
  p := passage_run(g, 2.2, 300);
  #assert p.crossed == 6 && !p.inside && !p.over && p.nearest > f32(REACH) - 0.05 && g.st[0].stops == 0;
}

#test "a crowd three abreast, as wide as the passage, passes one coming the other way" #steps 9000000000 {
  st: [1] Store; g := dg_bind(st[..]);
  p := passage_run(g, 2.8, 300);
  #assert p.crossed == 6 && !p.inside && !p.over && p.nearest > f32(REACH) - 0.05 && g.st[0].stops == 0;
}

// ---- the same natively and in wasm

// Case k's digest: the passage one body wide (0), two (1) and three (2).
// The caller owns the store (in wasm, crowd-deadgears-face.c keeps it off the stack).
deadgears_npc_case :: (st: [] Store, k: int) -> int #export_c {
  st[0] = Store.{};
  g := dg_bind(st);
  if k == 0 { return passage_run(g, 1.6, 300).digest; }
  if k == 1 { return passage_run(g, 2.2, 300).digest; }
  if k == 2 { return passage_run(g, 2.8, 300).digest; }
  return 0;
}
