// Isolated current/sine shader diagnostics. Coax owns copies, exact historical
// source joins, substitutions, compiler effects and the complete source fence.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "everglade-noise-policy.coax";
en_save :: (work:string,name:string,body:string)->bool {path:[4096]u8;return fs_write(fs_join(work,name,path[..]),body);}
en_clone :: (repository:string,work:string,sine:bool,original:[]RtqInputs,variant:[]RtqInputs)->bool {
  paths:[3][4096]u8;bytes:[524288]u8;changed:[524288]u8;
  for k:0..<original[0].count {row:=original[0].rows[k];source:=cast(string)row.path[0..<row.count];relative:=en_relative(source,repository);if relative=="" {return false;}target:=fs_join(work,relative,paths[0][..]);if !fs_mkdir(fs_dir(target)) {return false;}n:=fs_read(source,bytes[..]);if n<0 {return false;}
    edits:=en_edit_count(relative,sine);if edits==0 {if !fs_write(target,cast(string)bytes[0..<n]) {return false;}}
    else {for site:0..<edits {m:=en_transform(relative,cast(string)bytes[0..<n],true,site,changed[..]);if m<0 {return false;}if site+1==edits {if !fs_write(target,cast(string)changed[0..<m]) {return false;}}else {for i:0..<m {bytes[i]=changed[i];}n=m;}}}
    if !rtq_input_add(variant,target) {return false;}
  }return true;
}
en_historical :: (work:string)->bool {
  for which:0..<2 {file:=ifx which==0 then "a1a35280cd:verse/everglade/gpu.coax" else "a1a35280cd:verse/style.coax";label:=ifx which==0 then "historical-gpu" else "historical-style";argv:=[3]string.["git","show",file];env:[]string;out:[524288]u8;err:[65536]u8;r:=rtq_command(argv[..],env,proc_now_ms()+30000,work,label,out[..],err[..]);if !rtq_ok(r) {return false;}
    scratch:[524288]u8;for site:0..<ifx which==0 then 5 else 1 {needle:=ifx which==0 then EN_EG_OLD[site] else EN_STYLE_OLD;if rto_replace(cast(string)out[0..<r.out_n],needle,needle,scratch[..])<0 {tool_errln("historical noise body does not match exact git bytes");return false;}}
  }return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || (args_count(a[..])!=2 && args_count(a[..])!=3) {tool_errln("usage: everglade-noise-variants NEW_EMPTY_OUT CURRENT_PACKAGE [RETAINED_INTEGER_WGSL]");return 2;}paths:[15][4096]u8;repository:=fs_cwd(paths[0][..]);if !fs_mkdir(args_at(a[..],0)) {return 2;}work:=fs_realpath(args_at(a[..],0),paths[1][..]);listing:[1]FsList;if work=="" || fs_list(work,listing[..])!=0 {return 2;}package:=fs_realpath(args_at(a[..],1),paths[2][..]);if package=="" {return 2;}
  compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {tool_errln("select the qualified compiler through COAX");return 2;}inputs:[1]RtqInputs;shader_inputs:[1]RtqInputs;integer:[1]RtqInputs;sine:[1]RtqInputs;self:[4096]u8;image:=cxproc_self_path(self[..]);if image<1 {return 1;}
  for file:[3]string.[compiler,cast(string)self[0..<image],"coax/web/tool.sh"] {if !rtq_input_add(inputs[..],file) {return 1;}}
  if !rtq_deps(inputs[..],compiler,"aethyr/tests/everglade-noise-variants.coax",proc_now_ms()+30000,work,"tool-dependencies") || !rtq_deps(shader_inputs[..],compiler,"verse/everglade/gpu.coax",proc_now_ms()+30000,work,"shader_inputs-dependencies") {return 1;}
  for name:[2]string.["verse/everglade/gpu.module","verse/everglade/gpu.bindings"] {file:=fs_realpath(name,paths[3][..]);if file=="" || !rtq_input_add(shader_inputs[..],file) {return 1;}}
  if !en_historical(work) {return 1;}integer_root:=fs_join(work,"integer/source",paths[3][..]);sine_root:=fs_join(work,"sine/source",paths[4][..]);if !en_clone(repository,integer_root,false,shader_inputs[..],integer[..]) || !en_clone(repository,sine_root,true,shader_inputs[..],sine[..]) {return 1;}
  manifest:=fs_join(package,"render.json",paths[5][..]);json:[65536]u8;nodes:[16384]JvNode;d:[1]Jv;if !rtq_input_add(inputs[..],manifest) || !rtq_json_file(manifest,json[..],nodes[..],d[..]) {return 1;}
  vs:[4096]u8;fs:[4096]u8;vo:[1]Jo;fo:[1]Jo;jo_start(vo[..],vs[..]);jo_start(fo[..],fs[..]);seen_v:[16]string;seen_f:[16]string;vn:=0;fn:=0;entries:=jv_get(d[0],0,"entries");for k:0..<jv_len(d[0],entries) {row:=jv_at(d[0],entries,k);if jv_int(d[0],jv_get(d[0],row,"binding_set"),-1)!=0 {continue;}v:=jv_raw(d[0],jv_get(d[0],row,"vertex"));f:=jv_raw(d[0],jv_get(d[0],row,"fragment"));have_v:=false;have_f:=false;for i:0..<vn {have_v=have_v || seen_v[i]==v;}for i:0..<fn {have_f=have_f || seen_f[i]==f;}if !have_v {if vn>=16 {return 1;}if vn>0 {jo_put(vo[..],",");}seen_v[vn]=v;vn+=1;jo_put(vo[..],v);}if !have_f {if fn>=16 {return 1;}if fn>0 {jo_put(fo[..],",");}seen_f[fn]=f;fn+=1;jo_put(fo[..],f);}}
  if vo[0].bad || fo[0].bad || vn<1 || fn<1 {return 1;}out:[1048576]u8;err:[65536]u8;outputs:[2][64]u8;product_hash:[64]u8;current_module:="";modules:=jv_get(d[0],0,"modules");for k:0..<jv_len(d[0],modules) {row:=jv_at(d[0],modules,k);if jv_int(d[0],jv_get(d[0],row,"binding_set"),-1)==0 {current_module=jv_raw(d[0],jv_get(d[0],row,"wgsl_file"));}}
  product:=fs_join(package,current_module,paths[6][..]);if current_module=="" || !rtq_input_add(inputs[..],product) || !rtq_hash_file(product,product_hash[..]) {return 1;}
  for which:0..<2 {source_root:=ifx which==0 then integer_root else sine_root;source:=fs_join(source_root,"verse/everglade/gpu.coax",paths[7][..]);bindings:=fs_join(source_root,"verse/everglade/gpu.bindings",paths[8][..]);target:=fs_join(work,ifx which==0 then "integer.wgsl" else "sine.wgsl",paths[9][..]);
    if which==0 && args_count(a[..])==3 {reused:=fs_realpath(args_at(a[..],2),paths[10][..]);hash:[64]u8;if reused=="" || !rtq_input_add(inputs[..],reused) || !rtq_hash_file(reused,hash[..]) || cast(string)hash[..]!=cast(string)product_hash[..] {return 1;}n:=fs_read(reused,out[..]);if n<1 || !fs_write(target,cast(string)out[0..<n]) || !rtq_hash_file(target,outputs[which][..]) {return 1;}continue;}
    argv:=[13]string.[compiler,"wgsl",source,"--vertices",jo_text(vo[..]),"--fragments",jo_text(fo[..]),"--bindings",bindings,"--strip","eg_","-o",target];env:[]string;r:=rtq_command(argv[..],env,proc_now_ms()+120000,work,ifx which==0 then "emit-integer" else "emit-sine",out[..],err[..]);if !rtq_ok(r) || !rtq_hash_file(target,outputs[which][..]) {return 1;}}
  same:=rtq_inputs_match(inputs[..]) && rtq_inputs_match(shader_inputs[..]) && rtq_inputs_match(integer[..]) && rtq_inputs_match(sine[..]);record:[8388608]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.everglade.noise-diagnostic-variants.v1");jo_key(o[..],"status");jo_str(o[..],ifx same then "passed" else "failed");jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"original_shader_inputs");rtq_inputs_json(o[..],shader_inputs[..],"");jo_key(o[..],"integer_sources");rtq_inputs_json(o[..],integer[..],"");jo_key(o[..],"sine_sources");rtq_inputs_json(o[..],sine[..],"");jo_key(o[..],"integer_wgsl_sha256");jo_str(o[..],cast(string)outputs[0][..]);jo_key(o[..],"sine_wgsl_sha256");jo_str(o[..],cast(string)outputs[1][..]);jo_key(o[..],"package_module_sha256");jo_str(o[..],cast(string)product_hash[..]);jo_key(o[..],"integer_equals_package");jo_bool(o[..],cast(string)outputs[0][..]==cast(string)product_hash[..]);jo_key(o[..],"integer_reused_from");jo_str(o[..],args_at(a[..],2));jo_key(o[..],"removed_diagnostic_checks");jo_raw(o[..],"[\"eg_hash2 live lattice uses the portable integer noise profile\",\"eg_hash live lattice uses the portable integer noise profile\",\"eg_weather_hash live lattice uses the portable integer noise profile\",\"style live lattice uses the portable integer noise profile\"]");jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"restored_sites");jo_raw(o[..],"[\"eg_hash2\",\"eg_place window dye\",\"eg_place spell-soft dye\",\"eg_hash\",\"eg_weather_hash\",\"verse_style_hash\"]");jo_key(o[..],"scope");jo_str(o[..],"Six exact historical sine hash bodies/expressions restored in isolated copies of the complete current direct GPU source closure. Current integer control is emitted from an unchanged copy using the package's exact entry order. No product source or generated WGSL arithmetic edited; every sampling/demote/math byte outside these six source spans are preserved. Only four named checks asserting the intentionally replaced integer hash value are removed in the diagnostic sine copy; all other checks remain. No browser, GPU execution, image parity or current product publication follows from this diagnostic generation.");jo_end(o[..]);if o[0].bad || !en_save(work,"qualification.json",jo_text(o[..])) {return 1;}print("noise variants: %, current matches package %\n",same,cast(string)outputs[0][..]==cast(string)product_hash[..]);return ifx same then 0 else 1;
}
