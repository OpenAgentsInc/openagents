// Everglade's sound in the browser (GitHub #12751, aethyr/book/ch068): the page's own sounds as the
// host plays them, in headless, muted Chrome, never to speakers.
//   1. Audio starts on a gesture, and the page hands the host every effect it rendered
//      (apps/openagents-web/everglade-sound.coax, aethyr/audio/sfx.coax), each one decoding.
//   2. Each spell kind (the wire's slot: the druid's, the abilities', the Warlock's and the
//      raid's) cast at a point plays its own cast and impact, by this file's own table.
//   3. Distance: the same impact 5, 10 and 20 m ahead plays at 1, 1/2 and 1/4 the gain, later
//      and duller the farther it is (no lowpass at 5 m, its corner 8 and then 4 kHz); 120 m off,
//      past the cutoff, it isn't played. The host's one-pole lowpass at 1 kHz, offline, keeps
//      a 100 Hz tone and passes a sixth of a 6 kHz one.
//   4. Bearing: 5 m to the right it pans fully right, to the left fully left; and the host's
//      output, recorded by an AudioWorklet tap at the end of its graph, carries a right-hand
//      sound in the right channel alone (over the town's bed, which is centred), a left-hand
//      one in the left alone, as loud.
//   5. The town's quiet bed plays, looped, centred.
//   6. Offline, a piece of the town broken (as a spell breaks it) plays a stone: a wall's or a tower's.
//   COAX=... coax/web/tool.sh aethyr/tests/everglade-sound.coax http://127.0.0.1:PORT/realms/everglade/
#import "Basic";
#load "../../coax/lib/net/cdp.coax";

ES_WAIT_MS :: 120000;
ES_TOL :: 0.004;          // the lines carry three places

// The spells the issue names and the kits', as the wire carries them (e cast SLOT), and what each
// must sound like: its cast's name ("" for none) and its impact's.
EsSpell :: struct { name: string; slot: int; start: string; hit: string; }
ES_WL :: 64;   // everglade-warlock.coax WL_SLOT0
ES_AB :: 4;    // everglade-spells.coax SP_SLOTS: the abilities after the druid's four
ES_SPELLS :: [20] EsSpell.[
  EsSpell.{name = "Fire Bolt",         slot = ES_WL + 9,  start = "fire-cast",     hit = "fire-hit"},
  EsSpell.{name = "Eldritch Blast",    slot = ES_WL + 0,  start = "eldritch-cast", hit = "eldritch-hit"},
  EsSpell.{name = "Ray of Frost",      slot = ES_WL + 10, start = "frost-cast",    hit = "frost-hit"},
  EsSpell.{name = "Chill Touch",       slot = ES_WL + 7,  start = "necro-cast",    hit = "necro-hit"},
  EsSpell.{name = "Burning Hands",     slot = ES_WL + 11, start = "fire-cast",     hit = "cone"},
  EsSpell.{name = "Hex",               slot = ES_WL + 8,  start = "arcane-cast",   hit = "hex"},
  EsSpell.{name = "Hellish Rebuke",    slot = ES_WL + 13, start = "",              hit = "rebuke"},
  EsSpell.{name = "Hold Person",       slot = ES_WL + 14, start = "arcane-cast",   hit = "hold"},
  EsSpell.{name = "Fireball",          slot = ES_WL + 1,  start = "fire-cast",     hit = "fireball"},
  EsSpell.{name = "Lightning Bolt",    slot = ES_WL + 12, start = "bolt-cast",     hit = "thunder"},
  EsSpell.{name = "Blight",            slot = ES_WL + 2,  start = "necro-cast",    hit = "blight"},
  EsSpell.{name = "Dimension Door",    slot = ES_WL + 5,  start = "teleport",      hit = "teleport"},
  EsSpell.{name = "Meteor Swarm",      slot = 0,          start = "fire-cast",     hit = "fireball"},
  EsSpell.{name = "Thunderbolt",       slot = 1,          start = "bolt-cast",     hit = "thunder"},
  EsSpell.{name = "Ray of Frost (druid)", slot = ES_AB + 39, start = "frost-cast", hit = "frost-hit"},
  EsSpell.{name = "Hold Person (druid)",  slot = ES_AB + 41, start = "arcane-cast", hit = "hold"},
  EsSpell.{name = "Thunderwave",       slot = ES_AB + 5,  start = "",              hit = "thunderwave"},
  EsSpell.{name = "Healing Word",      slot = ES_AB + 24, start = "",              hit = "heal"},
  EsSpell.{name = "Levitate",          slot = ES_AB + 2,  start = "",              hit = "levitate"},
  EsSpell.{name = "Produce Flame",     slot = ES_AB + 17, start = "fire-cast",     hit = "fire-hit"}];

// One host line, NAME GAIN PAN [DELAY [LOWPASS]].
EsLine :: struct { name: string; gain: f64; pan: f64; delay: f64; lowpass: f64; ok: bool; }
es_line :: (t: string) -> EsLine {
  f: [5] string; n := 0; a := 0;
  for i: 0..<t.count + 1 { if i == t.count || t[i] == ' ' { if n < 5 && i > a { f[n] = t[a..<i]; n += 1; } a = i + 1; } }
  if n < 3 { return EsLine.{}; }
  g := args_number(f[1]); p := args_number(f[2]);
  out := EsLine.{name = f[0], gain = g.value, pan = p.value, ok = g.ok && p.ok};
  if n >= 4 { d := args_number(f[3]); out.delay = d.value; out.ok = out.ok && d.ok; }
  if n == 5 { l := args_number(f[4]); out.lowpass = l.value; out.ok = out.ok && l.ok; }
  return out;
}
// The line for `name` among "|"-separated lines, or none.
es_find :: (lines: string, name: string) -> EsLine {
  a := 0;
  for i: 0..<lines.count + 1 {
    if i < lines.count && lines[i] != '|' { continue; }
    l := es_line(lines[a..<i]);
    if l.ok && l.name == name { return l; }
    a = i + 1;
  }
  return EsLine.{};
}
#test "a host line reads back its fields, and a name is found among lines" {
  l := es_line("fire-hit 0.455 -1.000 0.015");
  #assert l.ok && l.name == "fire-hit" && l.gain == 0.455 && l.pan == -1.0 && l.delay == 0.015;
  m := es_line("horn 0.630 0.000");
  #assert m.ok && m.delay == 0.0 && m.lowpass == 0.0 && !es_line("horn 0.6").ok;
  far := es_line("thunder 0.100 1.000 0.117 4000");
  #assert far.ok && far.delay == 0.117 && far.lowpass == 4000.0;
  #assert es_find("step-1 0.1 0|hex 0.4 0.5", "hex").pan == 0.5 && !es_find("step-1 0.1 0", "hex").ok;
}
// What the check needs of one spell's lines: its cast and impact there, nothing else of its kind.
es_spell_ok :: (sp: EsSpell, lines: string) -> bool {
  hit := es_find(lines, sp.hit);
  if !hit.ok || hit.gain <= 0 { return false; }
  if sp.start.count > 0 && !es_find(lines, sp.start).ok { return false; }
  return true;
}
#test "a spell passes on its own cast and impact, and fails on another's" {
  s := ES_SPELLS[0];
  #assert es_spell_ok(s, "fire-cast 0.3 0|fire-hit 0.4 0") && !es_spell_ok(s, "frost-cast 0.3 0|frost-hit 0.4 0") && !es_spell_ok(s, "fire-hit 0 0");
  #assert es_spell_ok(ES_SPELLS[6], "rebuke 0.4 0") && !es_spell_ok(s, "fire-hit 0.4 0");
}
es_near :: (a: f64, b: f64) -> bool { return abs(a - b) <= ES_TOL; }
// A line is a stone's: a wall's or a tower's.
es_stone :: (lines: string) -> bool { return es_find(lines, "wall-hit").ok || es_find(lines, "tower-hit").ok; }
#test "a stone is a wall's or a tower's" {
  #assert es_stone("step-1 0.1 0|wall-hit 0.3 0.2 0.04 9000") && es_stone("tower-hit 0.5 0") && !es_stone("hit 0.5 0");
}
ES_PROBE_BREAK :: -2000;   // apps/openagents-web/everglade-sound.coax EGS_PROBE_BREAK

// The host's voice (coaxial.audio.voice) offline, a tone of `hz` with and without a 1 kHz lowpass:
// "RATIO" of their RMS after its first tenth of a second, for 100 Hz and 6 kHz.
ES_DULL :: "(async()=>{const r=48000;const run=async(hz,lp)=>{const o=new OfflineAudioContext(2,r,r);const b=o.createBuffer(1,r,r);const x=b.getChannelData(0);for(let i=0;i<r;i++)x[i]=0.5*Math.sin(2*Math.PI*hz*i/r);const s=coaxial.audio.voice(o,b,1,0,o.destination,lp);s.start(0);const y=(await o.startRendering()).getChannelData(0);let e=0;for(let i=r/10;i<r;i++)e+=y[i]*y[i];return Math.sqrt(e)};const lo=(await run(100,1000))/(await run(100,0));const hi=(await run(6000,1000))/(await run(6000,0));return lo.toFixed(4)+' '+hi.toFixed(4)})()";
es_local :: (url: string) -> bool { return url.count > 17 && (url[0..<17] == "http://127.0.0.1:" || url[0..<17] == "http://localhost:"); }

// ---- the page

// The tap (aethyr/tests/live-audio.coax's): a gain bus at the end of the host's live graph, into the
// muted speakers and an AudioWorklet that sums each channel's energy while armed.
ES_SETUP :: "globalThis.coaxialAudioTap=(ctx)=>{const bus=ctx.createGain();bus.connect(ctx.destination);const t=globalThis.esTap={l:0,r:0,on:false};const src=`registerProcessor('es-tap',class extends AudioWorkletProcessor{process(i){const x=i[0];if(x&&x.length){let l=0,r=0;const a=x[0],b=x[x.length>1?1:0];for(let k=0;k<a.length;k++){l+=a[k]*a[k];r+=b[k]*b[k];}this.port.postMessage([l,r]);}return true;}})`;t.ready=ctx.audioWorklet.addModule(URL.createObjectURL(new Blob([src],{type:'text/javascript'}))).then(()=>{const n=new AudioWorkletNode(ctx,'es-tap',{numberOfInputs:1,numberOfOutputs:1,outputChannelCount:[2]});bus.connect(n);n.connect(ctx.destination);n.port.onmessage=(e)=>{if(t.on){t.l+=e.data[0];t.r+=e.data[1];}};});return bus;};";
ES_START :: "(async()=>{const a=coaxial.audio.start();if(!a)return 'none';await esTap.ready;await a.resume();return a.state})()";
// Every effect the page handed over, decoded: how many, and their seconds in all.
ES_BANK :: "(async()=>{const n=['fire-cast','fire-hit','fireball','frost-hit','eldritch-hit','necro-hit','thunder','cone','hex','hold','rebuke','blight','teleport','heal','swing','hit','death','stand','horn','wall-hit','tower-hit','raid-won','raid-lost','step-1','ambient'];let ok=0,s=0;for(const k of n){try{const b=await coaxial.audio.decode(k);if(b&&b.length>0){ok++;s+=b.duration;}}catch{}}return ok+' '+n.length+' '+s.toFixed(2)})()";
// A whole number, a sign before a negative one (an effect's probe slot is -1 - its id).
es_digits :: (out: [] u8, at: int, v: int) -> int {
  if v >= 0 { return ws_digits(out, at, v); }
  return ws_digits(out, ws_put(out, at, "-"), -v);
}
// The page's lines for a probe: slot cast `right` m to your right, `ahead` ahead, `up` up.
es_probe_js :: (slot: int, right: string, ahead: string, out: [] u8) -> string {
  k := ws_put(out, 0, "(async()=>{const h0=coaxial.audio.heard().length;const n=coaxial.audio.probe(");
  k = es_digits(out, k, slot); k = ws_put(out, k, ","); k = ws_put(out, k, right); k = ws_put(out, k, ","); k = ws_put(out, k, ahead);
  k = ws_put(out, k, ",0);if(n<1)return 'none';for(let i=0;i<40&&coaxial.audio.heard().length===h0;i++)await new Promise((d)=>setTimeout(d,25));await new Promise((d)=>setTimeout(d,60));return coaxial.audio.heard().slice(h0).join('|')})()");
  return ifx k > 0 then cast(string) out[0..<k] else "";
}
// The tap's energy, left and right, over the 0.6 s after a probe.
es_tap_js :: (slot: int, right: string, out: [] u8) -> string {
  k := ws_put(out, 0, "(async()=>{const t=esTap;t.l=0;t.r=0;t.on=true;coaxial.audio.probe(");
  k = es_digits(out, k, slot); k = ws_put(out, k, ","); k = ws_put(out, k, right);
  k = ws_put(out, k, ",0,0);await new Promise((d)=>setTimeout(d,900));t.on=false;return t.l.toFixed(4)+' '+t.r.toFixed(4)})()");
  return ifx k > 0 then cast(string) out[0..<k] else "";
}

es_param :: (c: [] Cdp, method: string, key: string, value: string) -> bool {
  buf: [CDP_REQ] u8; o: [1] Jo;
  jo_start(o[..], buf[..]); jo_obj(o[..]); jo_key(o[..], key); jo_str(o[..], value); jo_end(o[..]);
  return !o[0].bad && cdp_call(c, method, jo_text(o[..]), 30000) >= 0;
}
// Runtime.evaluate as a user gesture: the value's raw text ("" on failure).
es_gesture :: (c: [] Cdp, expression: string, gesture: bool) -> string {
  buf: [CDP_REQ] u8; o: [1] Jo;
  jo_start(o[..], buf[..]); jo_obj(o[..]); jo_key(o[..], "expression"); jo_str(o[..], expression);
  jo_key(o[..], "awaitPromise"); jo_bool(o[..], true); jo_key(o[..], "returnByValue"); jo_bool(o[..], true);
  jo_key(o[..], "userGesture"); jo_bool(o[..], gesture); jo_end(o[..]);
  if o[0].bad { return ""; }
  r := cdp_call(c, "Runtime.evaluate", jo_text(o[..]), CDP_CALL_MS);
  if r < 0 { return ""; }
  at := jv_path(c[0].doc[0], r, "result.value");
  return ifx at >= 0 then jv_raw(c[0].doc[0], at) else "";
}
// A value's text, copied into out (the reply's buffer is the next call's), without a string's quotes.
es_text :: (c: [] Cdp, raw: string, out: [] u8) -> string {
  a := 0; b := raw.count;
  if b >= 2 && raw[0] == '"' && raw[b - 1] == '"' { a = 1; b -= 1; }
  n := 0;
  for i: a..<b { if n < out.count { out[n] = raw[i]; n += 1; } }
  return cast(string) out[0..<n];
}
es_true :: (c: [] Cdp, expr: string) -> bool { at := cdp_evaluate(c, expr); return at >= 0 && jv_raw(c[0].doc[0], at) == "true"; }

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  url := args_at(a[..], 0);
  if !ok || !es_local(url) { tool_errln("usage: coax/web/tool.sh aethyr/tests/everglade-sound.coax http://127.0.0.1:PORT/realms/everglade/"); return 2; }
  c: [1] Cdp;
  if !cdp_launch(c[..], 800, 600, "coax-everglade-sound-") { tool_err("everglade-sound: "); tool_errln(cdp_error(c[..])); return 1; }
  defer cdp_close(c[..]);
  if cdp_call(c[..], "Page.enable", "", 30000) < 0 || cdp_call(c[..], "Runtime.enable", "", 30000) < 0 ||
     !es_param(c[..], "Page.addScriptToEvaluateOnNewDocument", "source", ES_SETUP) || !es_param(c[..], "Page.navigate", "url", url) {
    tool_err("everglade-sound: the page did not open: "); tool_errln(cdp_error(c[..])); return 1;
  }
  print("everglade-sound: open %\n", url);
  until := proc_now_ms() + ES_WAIT_MS;
  ready := "globalThis.coaxial?.ready===true&&!!globalThis.coaxial.audio";
  while proc_now_ms() < until && !es_true(c[..], ready) { proc_sleep(100); }
  if !es_true(c[..], ready) { tool_errln("everglade-sound: the page's engine never started"); return 1; }
  proc_sleep(3000);   // the town's first frames: the listener is the camera

  // 1. A gesture starts audio; the page's effects are the host's.
  txt: [8192] u8;
  state := es_text(c[..], es_gesture(c[..], ES_START, true), txt[..]);
  print("everglade-sound: the host's AudioContext: %\n", state);
  if state != "running" { tool_errln("everglade-sound: audio did not start on a gesture"); return 1; }
  bank := es_text(c[..], es_gesture(c[..], ES_BANK, false), txt[..]);
  print("everglade-sound: effects decoded (of those named, their seconds): %\n", bank);
  bank_ok := bank.count > 6 && bank[0..<6] == "25 25 ";

  // 2. Each spell kind: its own cast and impact.
  js: [4096] u8;
  kinds := 0;
  for sp: ES_SPELLS {
    lines := es_text(c[..], es_gesture(c[..], es_probe_js(sp.slot, "0", "6", js[..]), false), txt[..]);
    good := es_spell_ok(sp, lines);
    if good { kinds += 1; }
    print("everglade-sound: % (slot %): % [%]\n", sp.name, sp.slot, ifx good then "ok" else "WRONG", lines);
  }

  // 3. Distance: Fire Bolt's impact 5, 10, 20 and 120 m ahead.
  bolt := ES_SPELLS[0];
  near: [4] EsLine;
  aheads := [4] string.["5", "10", "20", "120"];
  for i: 0..<4 {
    lines := es_text(c[..], es_gesture(c[..], es_probe_js(-1 - 2, "0", aheads[i], js[..]), false), txt[..]);   // effect 2: fire-hit alone
    near[i] = es_find(lines, bolt.hit);
    print("everglade-sound: % at % m ahead: gain % pan % delay %\n", bolt.hit, aheads[i], near[i].gain, near[i].pan, near[i].delay);
  }
  falloff := near[0].ok && near[1].ok && near[2].ok && !near[3].ok && near[0].gain > 0.05 &&
             abs(near[1].gain - near[0].gain / 2) <= ES_TOL * 2 && abs(near[2].gain - near[0].gain / 4) <= ES_TOL * 2 &&
             near[2].delay > near[1].delay && near[1].delay > near[0].delay && abs(near[2].delay - 20.0 / 343.0) <= ES_TOL * 2;
  // duller as it goes: aethyr/audio/space.coax's corner, 16 kHz at the reference (5 m) over the distance's ratio
  print("everglade-sound: lowpass at 5, 10, 20 m: % % % Hz\n", near[0].lowpass, near[1].lowpass, near[2].lowpass);
  dull_lines := near[0].lowpass == 0 && abs(near[1].lowpass - 8000) <= 2 && abs(near[2].lowpass - 4000) <= 2;
  dull_txt := es_text(c[..], es_gesture(c[..], ES_DULL, false), txt[..]);
  dull := es_energy(dull_txt);
  print("everglade-sound: the host's 1 kHz lowpass keeps of a 100 Hz tone and a 6 kHz one: %\n", dull_txt);
  dulled := dull_lines && dull.ok && dull.l > 0.98 && dull.r > 0.13 && dull.r < 0.21;

  // 4. Bearing: 5 m right and left, in the lines and in what the host puts out.
  rl := es_find(es_text(c[..], es_gesture(c[..], es_probe_js(-1 - 2, "5", "0", js[..]), false), txt[..]), "fire-hit");
  ll := es_find(es_text(c[..], es_gesture(c[..], es_probe_js(-1 - 2, "-5", "0", js[..]), false), txt[..]), "fire-hit");
  print("everglade-sound: 5 m right pans %, 5 m left pans %\n", rl.pan, ll.pan);
  panned := rl.ok && ll.ok && es_near(rl.pan, 1) && es_near(ll.pan, -1) && es_near(rl.gain, ll.gain);
  proc_sleep(1500);   // the probes' tails die away
  right := es_text(c[..], es_gesture(c[..], es_tap_js(-1 - 3, "5", js[..]), false), txt[..]);   // effect 3: the Fireball's burst
  txt2: [256] u8;
  left := es_text(c[..], es_gesture(c[..], es_tap_js(-1 - 3, "-5", js[..]), false), txt2[..]);
  print("everglade-sound: the host's output (energy left right): a burst on your right % ; on your left %\n", right, left);
  er := es_energy(right); el := es_energy(left);
  // the town's bed is centred, the same samples in both channels: what one side has more is the burst's
  dr := er.r - er.l; dl := el.l - el.r;
  heard := er.ok && el.ok && dr > 1 && dl > 1 && abs(dr - dl) < 0.3 * dr;

  // 5. The town's bed plays, looped, at its level.
  beds := es_text(c[..], es_gesture(c[..], "coaxial.audio.beds().join('|')", false), txt[..]);
  print("everglade-sound: beds playing (name gain pan): %\n", beds);
  bed := es_line(beds);
  bed_ok := bed.ok && bed.name == "ambient" && bed.gain > 0.05 && es_near(bed.pan, 0);

  // 6. Offline, the town's piece nearest a point 8 m ahead broken: its stone.
  stones := es_text(c[..], es_gesture(c[..], es_probe_js(ES_PROBE_BREAK, "0", "8", js[..]), false), txt[..]);
  print("everglade-sound: a piece of the town broken offline: [%]\n", stones);
  stone := es_stone(stones);

  passed := bank_ok && kinds == ES_SPELLS.count && falloff && dulled && panned && heard && bed_ok && stone;
  print("everglade-sound: effects % spells %/% falloff % lowpass % panning % output % bed % stone %\n", bank_ok, kinds, ES_SPELLS.count, falloff, dulled, panned, heard, bed_ok, stone);
  print("% each spell kind plays its own sound, falling off and dulling with distance, panned by bearing; a broken wall sounds\n", ifx passed then "pass" else "FAIL");
  return ifx passed then 0 else 1;
}

EsEnergy :: struct { l: f64; r: f64; ok: bool; }
es_energy :: (t: string) -> EsEnergy {
  for i: 0..<t.count {
    if t[i] != ' ' { continue; }
    l := args_number(t[0..<i]); r := args_number(t[i + 1..<t.count]);
    return EsEnergy.{l = l.value, r = r.value, ok = l.ok && r.ok};
  }
  return EsEnergy.{};
}
#test "the tap's energies read back" {
  e := es_energy("0.0100 3.5000");
  #assert e.ok && e.l == 0.01 && e.r == 3.5 && !es_energy("x").ok;
}
