// The Ranger's actual GPU object matrix contains its world-space root.
#load "../../apps/openagents-web/everglade.coax";

drawn_feet_probe :: (fx: f32, fy: f32, fz: f32, result: [] f32) #export_c {
  s: [1] Everglade;
  everglade_start(s[..]);
  for i: 0..<s[0].heights.count { s[0].heights[i] = 2.5; }
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  f := Point.{x = fx, y = fy, z = fz};
  n := everglade_frame(s[..], out[..], u[..], 1280, 800, 1, 0, true,
    f.x, f.y, f.z, 0, 0, 0, 0, false, 0, 0, 0, 0);
  at := RANGER_AT * OBJECT_FLOATS;
  result[0] = s[0].objects[at + 3]; result[1] = s[0].objects[at + 7]; result[2] = s[0].objects[at + 11];
  result[3] = 0; result[4] = 2.5; result[5] = 0;
  result[6] = ifx n > 0 && s[0].objects[at + 5] != 0 then 1.0f32 else 0.0f32;
}
