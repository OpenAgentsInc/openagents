// Independent check-only geometry: solve each drawn triangle's barycentric coordinates
// in f64 and interpolate its three vertices. It does not use ground_sample's cell formula.

GroundOraclePoint :: struct { x: f64; y: f64; z: f64; }
GroundOracleSample :: struct { y: f64; gx: f64; gz: f64; }

ground_oracle_triangle :: (a: GroundOraclePoint, b: GroundOraclePoint, c: GroundOraclePoint, x: f64, z: f64) -> GroundOracleSample {
  ax := b.x - a.x; az := b.z - a.z; bx := c.x - a.x; bz := c.z - a.z;
  det := ax * bz - az * bx;
  u := ((x - a.x) * bz - (z - a.z) * bx) / det;
  v := (ax * (z - a.z) - az * (x - a.x)) / det;
  return GroundOracleSample.{y = (1 - u - v) * a.y + u * b.y + v * c.y,
    gx = ((b.y - a.y) * bz - (c.y - a.y) * az) / det,
    gz = (ax * (c.y - a.y) - bx * (b.y - a.y)) / det};
}

ground_oracle_case :: (k: int) {
  g := Ground.{n = 2, rows = 3, cell = 1.25, west = -2.5, south = 3.75};
  if k % 2 == 1 { g.cell = 0.1; g.west = 100.1; g.south = -12.3; }
  h := [12] f32.[-1, 2, 0, 4, -3, 7, 5, 1, 9, -2, 6, 3];
  i := k % 2; j := (k / 2) % 3;
  fx := f32((k * 7) % 17) / 16; fz := f32((k * 11) % 17) / 16;
  left := g.west + f32(i) * g.cell; right := g.west + f32(i + 1) * g.cell;
  south := g.south + f32(j) * g.cell; north := g.south + f32(j + 1) * g.cell;
  x := f32(f64(left) + f64(fx) * (f64(right) - f64(left)));
  z := f32(f64(south) + f64(fz) * (f64(north) - f64(south)));
  // Generate the triangle vertices from the mesh's index rule, independently of sampling.
  x0 := f64(left); z0 := f64(south);
  a := GroundOraclePoint.{x = x0, y = f64(h[j * 3 + i]), z = z0};
  c := GroundOraclePoint.{x = f64(right), y = f64(h[(j + 1) * 3 + i + 1]), z = f64(north)};
  b := GroundOraclePoint.{x = f64(right), y = f64(h[j * 3 + i + 1]), z = z0};
  if (f64(x) - x0) / (f64(right) - x0) < (f64(z) - z0) / (f64(north) - z0) {
    b = GroundOraclePoint.{x = x0, y = f64(h[(j + 1) * 3 + i]), z = f64(north)};
  }
  expected := ground_oracle_triangle(a, b, c, f64(x), f64(z));
  q := ground_sample(g, h[..], units.Quantity.{value = x}, units.Quantity.{value = z});
  #assert q.ok && abs(f64(q.height.value) - expected.y) < 0.00001;
  // On cell boundaries the next cell owns the normal, so compare slopes in cell interiors.
  if fx > 0 && fx < 1 && fz > 0 && fz < 1 {
    #assert abs(f64(q.gx) - expected.gx) < 0.00001 && abs(f64(q.gz) - expected.gz) < 0.00001;
    norm := ground_normal(q);
    magnitude := sqrt(1 + expected.gx * expected.gx + expected.gz * expected.gz);
    #assert abs(f64(norm.x) + expected.gx / magnitude) < 0.000001;
    #assert abs(f64(norm.y) - 1 / magnitude) < 0.000001 && abs(f64(norm.z) + expected.gz / magnitude) < 0.000001;
  }
}
