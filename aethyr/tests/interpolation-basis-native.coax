// Reuse the same typed Vulkan effect API and exact Coax shader. The only new
// values are the independently frozen heldout XY/plane fixtures.
#load "depth-precision-effects.coax" as dn;
#load "interpolation-basis-fixtures.coax";
#load "../render/tests/qualification-files.coax";
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}spv:=args_at(a[..],0);output:=args_at(a[..],1);inputs:[1]RtqInputs;if !rtq_input_add(inputs[..],spv) {return 2;}bytes:[1048576]u8;n:=fs_read(spv,bytes[..]);if n<20 || n%4!=0 {return 2;}
  if dn.ngfx_open()!=0 {return 2;}good:=dn.ngfx_info(9)==1;blob:=dn.ngfx_blob(n);if blob<0 {good=false;}if good {for k:0..<n {good=good && dn.ngfx_blob_put(blob,k,cast(int)bytes[k])==0;}}
  uniform:=dn.ngfx_buffer(96);good=good && uniform>=0;record:[131072]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.interpolation-basis-native.v1");jo_key(o[..],"format");jo_str(o[..],"rgba32float");jo_key(o[..],"depth_format");jo_str(o[..],"depth32float");jo_key(o[..],"rows");jo_arr(o[..]);
  for index:0..<17 {if !good {break;}c:=ib_case(index);for v:0..<6 {for lane:0..<4 {good=good && dn.ngfx_buffer_word(uniform,v*4+lane,cast(int)f32_bits(c.clips[v][lane]))==0;}}
    color:=dn.ngfx_image(64,64,1,0,2,2);depth:=dn.ngfx_image(64,64,1,0,3,2);good=good && color>=0 && depth>=0 && dn.ngfx_begin(blob)==0 && dn.ngfx_binding(0,1,uniform,0,96)==0 && dn.ngfx_field(0,1)==0 && dn.ngfx_field(1,c.vertices)==0 && dn.ngfx_target(0,color)==0 && dn.ngfx_field(2,1)==0 && dn.ngfx_field(3,depth)==0 && dn.ngfx_field(4,1)==0 && dn.ngfx_field(5,1)==0;for lane:0..<4 {good=good && dn.ngfx_clear(lane,cast(int)f32_bits(-1.0))==0;}
    if !good || dn.ngfx_pipe_open()!=0 {good=false;break;}good=dn.ngfx_submit()==0;rgba:=ifx good then dn.ngfx_read(color,65536) else -1;zs:=ifx good then dn.ngfx_read(depth,16384) else -1;good=good && rgba>=0 && zs>=0;
    jo_arr(o[..]);if good {for sample:0..<(ifx index<13 then 3 else 1) {x:=ifx sample==1 then 32 else 18;y:=ifx sample==2 then 32 else 18;pixel:=y*64+x;jo_obj(o[..]);jo_key(o[..],"rgba_words");jo_arr(o[..]);for lane:0..<4 {word:=dn.ngfx_blob_word(rgba,pixel*4+lane);good=good && word>=0;jo_int(o[..],word);}jo_end(o[..]);jo_key(o[..],"depth_word");jo_int(o[..],dn.ngfx_blob_word(zs,pixel));jo_end(o[..]);}}jo_end(o[..]);good=dn.ngfx_pipe_close()==0 && good;
  }jo_end(o[..]);jo_key(o[..],"device");jo_obj(o[..]);for field:3..<6 {jo_key(o[..],ifx field==3 then "vendor" else ifx field==4 then "device" else "driver");jo_int(o[..],dn.ngfx_info(field));}name:[256]u8;nn:=0;while nn<name.count {byte:=dn.ngfx_name(nn);if byte<=0 {break;}name[nn]=cast(u8)byte;nn+=1;}jo_key(o[..],"name");jo_str(o[..],cast(string)name[0..<nn]);jo_end(o[..]);validation:=dn.ngfx_info(9);closed:=dn.ngfx_close();errors:=dn.ngfx_info(6);warnings:=dn.ngfx_info(7);stable:=rtq_inputs_match(inputs[..]);good=good && closed==0 && errors==0 && warnings==0 && stable;
  jo_key(o[..],"validation_enabled");jo_int(o[..],validation);jo_key(o[..],"errors");jo_int(o[..],errors);jo_key(o[..],"warnings");jo_int(o[..],warnings);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],stable);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],".");jo_key(o[..],"status");jo_str(o[..],ifx good then "passed" else "failed");jo_end(o[..]);if o[0].bad || !fs_write(output,jo_text(o[..])) {return 2;}return ifx good then 0 else 1;
}
