// Loaded by verse/player.coax: exercise the real fixed step and its public
// diagnostics, rather than another copy of the capsule arithmetic.

#test "the checked fixed step admits the normal walking contact" {
  boxes := [6] f32.[-2, 0, 1, 2, 2, 1.01]; w: World; w.walls = boxes[..];
  p := held(verse_player_place(0, 0, 0.65, 0), 0, 1, true); p.vel.z = RUN;
  q := step(w, p, STEP);
  #assert abs(q.pos.z - 0.7) < 0.000001 && q.vel.z == 0;
  #assert verse_player_collision_status(q) == cast(int) cast(u8) CollideStatus.ok;
  #assert verse_player_collision_refusals(q) == 0 && verse_player_collision_residual(q) <= f32(COLLIDE_EPS);
  #assert verse_player_collision_passes(q) >= 1 && !verse_player_collision_floor_cut(q);
}

#test "a refused fixed step preserves its queued jump and recovers visibly" {
  w: World;
  p := verse_player_input(verse_player_place(0, 0, 0, 0), 0, 0, 0, 0, false, true, 0, 0);
  p.vel.z = 20;
  q := step_once(w, p, STEP);
  #assert q.collision_status == CollideStatus.travel_limit && q.collision_refusals == 1;
  #assert same_step(p, q) && q.jumps.waiting == p.jumps.waiting && q.jumps.taken == p.jumps.taken;
  #assert q.on_ground && q.vel.y == 0 && q.jump_held == p.jump_held;
  #assert q.target.x == p.target.x && q.target.y == p.target.y && q.target.z == p.target.z;
  #assert q.spring_vel.x == p.spring_vel.x && q.spring_vel.y == p.spring_vel.y && q.spring_vel.z == p.spring_vel.z;
  q.vel.z = 0;
  recovered := step_once(w, q, STEP);
  #assert recovered.collision_status == CollideStatus.ok && recovered.collision_refusals == 1;
  #assert !recovered.on_ground && recovered.vel.y > 0 && recovered.jumps.waiting == 0 && recovered.jumps.taken == 1;
}

#test "crowded fixed-step contacts refuse atomically and expose their residual" {
  boxes := [12] f32.[-2, 0, -2, -0.2, 2, 2, 0.2, 0, -2, 2, 2, 2];
  w: World; w.walls = boxes[..]; p := verse_player_place(0, 0, 0, 0);
  q := step(w, p, STEP);
  #assert q.collision_status == CollideStatus.unresolved && q.collision_refusals == 1 && q.collision_residual > 0.1;
  #assert same_step(p, q) && q.collision_passes == 1 && !q.collision_floor_cut;
}

#test "collision capacity and an unknown profile refuse before the step publishes" {
  boxes: [(COLLIDE_MAX_SHAPES + 1) * QUERY_BOX] f32;
  w: World; w.walls = boxes[..]; p := held(verse_player_place(0, 0, 0, 0), 0, 1, true);
  q := step(w, p, STEP);
  #assert q.collision_status == CollideStatus.capacity && q.collision_refusals == 1 && same_step(p, q);
  w.walls = boxes[0..<0]; w.collision.max_passes = 0;
  q = step(w, p, STEP);
  #assert q.collision_status == CollideStatus.bad_profile && q.collision_refusals == 1 && same_step(p, q);
  p.collision_refusals = 18446744073709551615;
  #assert step(w, p, STEP).collision_refusals == 18446744073709551615;
}

#test "a rejected physics step still consumes its scheduler time" {
  w: World; w.collision.max_passes = 0;
  p := verse_player_input(verse_player_place(0, 0, 0, 0), 0, 1, 0, 0, true, true, 0, 0);
  q := advance_in(w, p, STEP);
  #assert q.clock.ticks == 1 && q.collision_status == CollideStatus.bad_profile && q.collision_refusals == 1;
  #assert q.pos.x == p.pos.x && q.pos.y == p.pos.y && q.pos.z == p.pos.z;
  #assert q.jumps.waiting == 1 && q.jumps.taken == 0;
}

#test "trusted large-move adapters retain their legacy contract through shared helpers" {
  w: World; p := verse_player_place(0, 0, 0, 0);
  q := move_across(w, p, 1.5, -2);
  #assert q.pos.x == 1.5 && q.pos.z == -2 && q.collision_refusals == 0;
}

#test "named realm admission uses its declared collision profile and unknown names preserve input" {
  p := verse_player_input(verse_player_place(0, 0, 0, 0), 0, 1, 0, 0, true, true, 0, 0);
  empty: [1] f32;
  known := verse_player_advance_in_realm(p, STEP, empty[0..<0], empty[0..<0], empty[0..<0], "the-grid");
  #assert same_step(known, verse_player_advance(p, STEP)) && known.collision_status == CollideStatus.ok;
  unknown := verse_player_advance_in_realm(p, STEP, empty[0..<0], empty[0..<0], empty[0..<0], "not-a-realm");
  #assert unknown.collision_status == CollideStatus.bad_profile && unknown.collision_refusals == 1;
  #assert same_step(p, unknown) && unknown.jumps.waiting == p.jumps.waiting && unknown.jumps.taken == p.jumps.taken;
  #assert unknown.clock.ticks == p.clock.ticks && unknown.clock.carry_ns == p.clock.carry_ns;
}

#test "heightfield Player walks jumps and lands at the sampled world height" {
  heights := [4] f32.[2.5, 2.5, 2.5, 2.5]; fields: [1] QueryHeightfield;
  fields[0].ground.n = 1; fields[0].ground.cell = 4; fields[0].ground.west = -2; fields[0].ground.south = -2;
  fields[0].heights = heights[..]; w: World; w.heightfields = fields[..];
  p := held(verse_player_place(0, 2.5, 0, 0), 0, 1, false);
  q := step(w, p, STEP);
  #assert q.pos.z > 0 && q.pos.y == 2.5 && q.on_ground;
  #assert q.collision_status == CollideStatus.ok && q.query_status == QueryStatus.ok;
  q = verse_player_input(q, 0, 1, 0, 0, false, true, 0, 0);
  q = step(w, q, STEP);
  #assert !q.on_ground && q.pos.y > 2.5 && q.vel.y > 0 && q.jumps.taken == 1;
  for k: 0..<48 { q = step(w, q, STEP); }
  #assert q.on_ground && q.pos.y == 2.5 && q.vel.y == 0;
  #assert verse_player_query_status(q) == cast(int) cast(u8) QueryStatus.ok;
}

#test "heightfield Player uses the drawn triangle slope for sliding" {
  heights := [4] f32.[0, 2, 0, 2]; fields: [1] QueryHeightfield;
  fields[0].ground.n = 1; fields[0].ground.cell = 1; fields[0].ground.west = 0; fields[0].ground.south = 0;
  fields[0].heights = heights[..]; w: World; w.heightfields = fields[..];
  p := verse_player_place(0.5, 1, 0.5, 0);
  q := step(w, p, STEP);
  #assert q.sliding && !q.on_ground && q.vel.x < 0 && q.vel.z == 0;
  #assert q.pos.y == 1 && q.query_status == QueryStatus.ok && q.collision_status == CollideStatus.ok;
}

#test "heightfield Player refuses malformed ground atomically and recovers its queued jump" {
  heights := [4] f32.[2.5, 2.5, 2.5, 2.5]; fields: [1] QueryHeightfield;
  fields[0].ground.n = 1; fields[0].ground.cell = 1; fields[0].ground.west = 0; fields[0].ground.south = 0;
  fields[0].heights = heights[..]; w: World; w.heightfields = fields[..];
  p := verse_player_input(place_in(w, 0.5, 2.5, 0.5, 0), 0, 1, 0, 0, false, true, 0, 0);
  fields[0].heights = heights[0..<3];
  q := step_once(w, p, STEP);
  #assert q.collision_status == CollideStatus.bad_state && q.query_status == QueryStatus.terrain && q.collision_refusals == 1;
  #assert same_step(q, p) && q.jumps.waiting == 1 && q.jumps.taken == 0;
  #assert q.target.x == p.target.x && q.target.z == p.target.z && q.spring_vel.y == p.spring_vel.y;
  fields[0].heights = heights[..];
  recovered := step(w, q, STEP);
  #assert recovered.collision_status == CollideStatus.ok && recovered.query_status == QueryStatus.ok && recovered.collision_refusals == 1;
  #assert recovered.pos.y > 2.5 && recovered.jumps.waiting == 0 && recovered.jumps.taken == 1;
}

#forall "heightfield Player exposes invalid and capacity ground receipts" which: 0..<2 {
  fields: [QUERY_HEIGHTFIELDS_MAX + 1] QueryHeightfield; w: World;
  expected := QueryStatus.capacity;
  if which == 0 { w.heightfields = fields[..]; }
  else { nan := 0.0f32; w.ground = nan / nan; expected = QueryStatus.invalid; }
  p := verse_player_place(0, 0, 0, 0); q := step(w, p, STEP);
  #assert same_step(p, q) && q.collision_status == CollideStatus.bad_state && q.query_status == expected;
  #assert q.collision_refusals == 1 && verse_player_query_status(q) == cast(int) cast(u8) expected;
}

#test "heightfield Player camera stops above terrain and exposes an independent refusal" {
  heights := [4] f32.[2.5, 2.5, 2.5, 2.5]; fields: [1] QueryHeightfield;
  fields[0].ground.n = 1; fields[0].ground.cell = 4; fields[0].ground.west = -2; fields[0].ground.south = -2;
  fields[0].heights = heights[..]; w: World; w.heightfields = fields[..];
  p := verse_player_place(0, 2.5, 0, 0); p.phi = PI;
  q := camera_step(w, p, STEP);
  #assert q.dist < p.dist && abs(q.dist - (f32(LOOK_AT_HEIGHT) - f32(CAM_CLEAR))) < 0.0001;
  #assert q.pos.y == 2.5 && q.camera_query_status == QueryStatus.ok;
  fields[0].heights = heights[0..<3];
  refused := camera_step(w, q, STEP);
  #assert refused.target.x == q.target.x && refused.target.y == q.target.y && refused.target.z == q.target.z;
  #assert refused.spring_vel.x == q.spring_vel.x && refused.spring_vel.y == q.spring_vel.y && refused.spring_vel.z == q.spring_vel.z;
  #assert refused.dist == q.dist && refused.pos.y == q.pos.y && refused.collision_status == q.collision_status;
  #assert verse_player_camera_query_status(refused) == cast(int) cast(u8) QueryStatus.terrain;
}

#test "trusted Player contact adapters preserve floor sides and wall response" {
  floors: [STAND_FLOATS] f32; stand_put_box(floors[..], 0, 1, -1, 3, 1, 1);
  w: World; w.floors = floors[..]; p := verse_player_place(0, 0, 0, 0);
  #assert !floor_cuts(w, 0, 0, 0) && floor_cuts(w, 2, 0, 0);
  candidate := p; candidate.pos.x = 2; candidate.vel.x = 3;
  stopped := off_floors(w, p, candidate);
  #assert stopped.pos.x == 0 && stopped.pos.z == 0 && stopped.vel.x == 0;
  boxes := [6] f32.[-2, 0, 1, 2, 2, 1.1]; w.walls = boxes[..];
  candidate = p; candidate.pos.z = 0.8; candidate.vel.z = 3;
  wall_stop := out_of_walls(w, candidate);
  #assert abs(wall_stop.pos.z - 0.7) < 0.000001 && wall_stop.vel.z == 0;
}

#test "the legacy exported floor advance still eases onto its supplied surface" {
  floors: [STAND_FLOATS] f32; stand_put_box(floors[..], 0, -2, -2, 2, 2, 0.04);
  empty: [1] f32; p := verse_player_place(0, 0, 0, 0);
  q := verse_player_advance_on(p, STEP, empty[0..<0], empty[0..<0], floors[..]);
  #assert abs(q.pos.y - 0.00625) < 0.00000001 && q.on_ground && q.clock.ticks == 1;
  #assert q.collision_status == CollideStatus.ok && verse_player_advance(p, STEP).pos.y == 0;
}

#test "an external Player constraint translates camera history only on the constrained axes" {
  p := verse_player_place(1, 0.5, 2, 0); p.vel = v3(3, 4, 5);
  q := verse_player_constrain(p, 8, 2);
  #assert q.pos.x == 8 && q.prev_pos.x == 8 && q.target.x == p.target.x + 7 && q.prev_target.x == p.prev_target.x + 7;
  #assert q.vel.x == 0 && q.vel.y == 4 && q.vel.z == 5 && q.pos.y == 0.5 && q.pos.z == 2;
  r := verse_player_constrain(q, 8, -4);
  #assert r.pos.z == -4 && r.prev_pos.z == -4 && r.target.z == q.target.z - 6 && r.prev_target.z == q.prev_target.z - 6;
  #assert r.vel.x == 0 && r.vel.z == 0 && r.target.x == q.target.x;
}

#test "Player numerical decisions retain signed zero quadrants and the published yaw bits" {
  zero := 0.0f32; negative_zero := -zero; nan := zero / zero;
  #assert f32_bits(lo(zero, negative_zero)) == 2147483648;
  #assert f32_bits(hi(zero, negative_zero)) == 2147483648;
  #assert !player_negative(zero) && !player_negative(negative_zero) && !player_negative(nan);
  #assert player_negative(-1) && !player_negative(1) && player_negative(-1 / zero) && !player_negative(1 / zero);
  // The fitted diagonal is below pi/4; taking the reciprocal branch gives
  // a different f32 word. These are the published scalar profile's words.
  #assert f32_bits(atan2(1, 1)) == 1061752766;
  #assert f32_bits(verse_player_place(0, 0, 0, 1).theta) == 3221819354;
}

#test "Player contact diagnostics retain a floor cut and the last counter increment" {
  p := verse_player_place(0, 0, 0, 0); p.collision_refusals = 18446744073709551614;
  r := CollideResult.{status = CollideStatus.unresolved, passes = 7, residual = 0.125, floor_cut = true};
  q := collision_report(p, r);
  #assert verse_player_collision_floor_cut(q) && verse_player_collision_passes(q) == 7 && verse_player_collision_residual(q) == 0.125;
  #assert q.collision_refusals == 18446744073709551615 && collision_report(q, r).collision_refusals == q.collision_refusals;
}

#test "Player closest parameters retain interior contact points on long segments" {
  pair := closest(v3(0, 0, 0), v3(0, 4, 0), v3(-2, 2, 1), v3(2, 2, 1));
  #assert pair.s == 0.5 && pair.t == 0.5;
  #assert pair.p.y == 2 && pair.q.x == 0 && pair.q.y == 2 && pair.q.z == 1;
  bodies := [BODY] f32.[0, 0, 1, 0, 1, 1, 0.4]; w: World; w.bodies = bodies[..]; w.collision.max_passes = 1;
  q := move_across(w, verse_player_place(0, 0, 1.4, 0), 0, 0);
  #assert q.pos.z > 1.69 && q.pos.z < 1.71;
}

#forall "Player grip preserves the published finite and airborne fallbacks" which: 0..<8 {
  w: World; p := held(verse_player_place(0, 0, 0, 0), 1, 0, false); p.theta = 0;
  zero := 0.0f32; expected := 0.9375f32;
  if which == 0 { p.grip = 0; }
  if which == 1 { p.grip = -zero; }
  if which == 2 { p.grip = 1; }
  if which == 3 { p.grip = 2; }
  if which == 4 { p.grip = zero / zero; }
  if which == 5 { p.grip = 1 / zero; }
  if which == 6 { p.grip = 0.2; expected = 0.1875; }
  if which == 7 { p.grip = 0.2; p.pos.y = 10; p.on_ground = false; }
  q := step(w, p, STEP);
  #assert q.vel.x == expected && q.collision_status == CollideStatus.ok;
}

#test "Player steep diagonals retain their ride boundary and both gravity components" {
  floors: [STAND_FLOATS] f32; stand_put_quad(floors[..], 0, -1, -1, 2, 0, 0, 2, -3.5, 3, 4);
  w: World; w.ground = -1; w.floors = floors[..]; p := place_in(w, 0, f32(RIDE_HEIGHT), 0, 0); p.vel.y = -0.1;
  q := step(w, p, STEP);
  #assert q.sliding && !q.on_ground && q.vel.y == 0 && q.pos.y == 0;
  #assert abs(q.vel.x + 0.07758621) < 0.0000001 && abs(q.vel.z + 0.10344828) < 0.0000001;
  p.pos.y = 0.5;
  airborne := step(w, p, STEP);
  #assert !airborne.sliding && airborne.vel.x == 0 && airborne.vel.z == 0 && airborne.vel.y < -0.4;
  p = held(verse_player_place(0, 0, 0, 0), 0, 1, true); p.pace = 0.5;
  #assert step(World.{}, p, STEP).act == Act.walking; // speed is exactly WALK + 0.25
}

#test "the exported Player floor advance retains bodies and walls as well as floors" {
  empty: [1] f32; bodies := [BODY] f32.[0, 0, 1, 0, 1, 1, 0.4];
  p := verse_player_place(0, 0, 1.4, 0);
  body_stop := verse_player_advance_on(p, STEP, bodies[..], empty[0..<0], empty[0..<0]);
  #assert body_stop.pos.z > 1.69 && body_stop.pos.z < 1.71;
  boxes := [6] f32.[-2, 0, 1, 2, 2, 1.1]; p = verse_player_place(0, 0, 0.8, 0);
  wall_stop := verse_player_advance_on(p, STEP, empty[0..<0], boxes[..], empty[0..<0]);
  #assert abs(wall_stop.pos.z - 0.7) < 0.000001;
}

#test "the desk screen admits feet below it and blocks the right hand side above the desk" {
  walls: [12] f32; desk(walls[..]); w: World; w.walls = walls[6..<12];
  below := out_of_walls(w, verse_player_place(0, -1, 4, 0));
  #assert below.pos.x == 0 && below.pos.z == 4;
  beside := out_of_walls(w, verse_player_place(0.5, 1.3, 4, 0));
  #assert abs(beside.pos.z - 4) > 0.39;
  roof: [2 * STAND_FLOATS] f32; gable(roof[..], 4); w = World.{floors = roof[..]};
  under := floor_under(w, 2, 0, 6);
  #assert under.y == 5.5 && under.gx == -0.75 && under.gz == 0;
}

#test "Player zoom keeps invalid inputs and exact view crossing boundaries" {
  p := verse_player_place(7, 0, 2, 0); p.phi = 0.5; p.dist = 4; p.prev_dist = 3;
  unchanged := verse_player_zoom_view(p, 42, 0);
  #assert unchanged.mode == 42 && unchanged.player.pos.x == 7 && unchanged.player.dist == 4;
  p.zoom_push = 0.2; zero := 0.0f32;
  invalid := verse_player_zoom_view(p, 0, zero / zero);
  #assert invalid.mode == 0 && invalid.player.zoom_push == 0.2;
  top := verse_player_zoom_view(p, 2, -100);
  #assert top.mode == 2 && top.player.max_dist == 1 && top.player.phi == 0.5;
  cleared := verse_player_zoom_view(p, 0, -0.1); #assert cleared.player.zoom_push == 0;
  p.zoom_push = 0;
  outward := verse_player_zoom_view(p, 0, ZOOM_OUT);
  #assert outward.mode == 1 && outward.player.max_dist == 1 && outward.player.dist == 1 && outward.player.prev_dist == 1;
  #assert outward.player.phi == f32(BEHIND_PHI) && outward.player.zoom_push == 0;
  p.zoom_push = 0.2; p.max_dist = 1.5;
  exact_closest := verse_player_zoom_view(p, 1, -0.5);
  #assert exact_closest.mode == 1 && exact_closest.player.max_dist == 1 && exact_closest.player.zoom_push == 0;
  positive := verse_player_zoom_view(p, 1, 0.1); #assert positive.player.zoom_push == 0;
  p.max_dist = 1; p.zoom_push = 0;
  inward := verse_player_zoom_view(p, 1, -ZOOM_IN);
  #assert inward.mode == 0 && inward.player.phi == f32(PI / 2) && inward.player.zoom_push == 0;
}

#test "heightfield Player diagonal gravity uses the full squared gradient" {
  heights := [4] f32.[0, 3, 4, 7]; fields: [1] QueryHeightfield;
  fields[0].ground.n = 1; fields[0].ground.cell = 1; fields[0].ground.west = 0; fields[0].ground.south = 0;
  fields[0].heights = heights[..]; w: World; w.heightfields = fields[..];
  p := place_in(w, 0.5, 3.5, 0.5, 0); p.vel.y = -0.1;
  q := step(w, p, STEP);
  // |gradient|=5: tangential gravity is 24*5/(1+25), split 3/5 and 4/5.
  #assert q.sliding && !q.on_ground && q.pos.y == 3.5 && q.vel.y == 0;
  #assert abs(q.vel.x + 0.04326923) < 0.0000001 && abs(q.vel.z + 0.05769231) < 0.0000001;
}
