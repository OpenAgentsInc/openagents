// Acceptance checks written before the primitive WebGPU policy.
pp_test_parse :: (text:string,doc:[]Jv,nodes:[]JvNode)->bool {return jv_parse(doc,text,nodes);}
#test "primitive modes and complete authored cardinalities are closed" {
  names:=[4]string.["filter-format","ring8","sans-filter","sampling"];
  counts:=[4]int.[40,728,40,6];
  for i:0..<4 {#assert pp_mode(names[i])==i && pp_count(i)==counts[i];}
  #assert pp_mode("unknown")==-1 && pp_count(-1)==0 && pp_count(4)==0;
  #assert pp_width(0)==64 && pp_width(1)==8 && pp_width(2)==64 && pp_width(3)==2;
}
#test "primitive numeric transport requires finite words and their original f32 values" {
  doc:[1]Jv;nodes:[128]JvNode;
  yes:="{\"v\":[0,-0.0,1,-0.5],\"w\":[0,2147483648,1065353216,3204448256]}";
  #assert pp_test_parse(yes,doc[..],nodes[..]);
  v:=jv_get(doc[0],0,"v");w:=jv_get(doc[0],0,"w");
  for k:0..<4 {#assert pp_lane(doc[0],v,w,k);}
  bad:=[12]string.["{\"v\":[null],\"w\":[0]}","{\"v\":[1e999],\"w\":[0]}","{\"v\":[0],\"w\":[2139095040]}","{\"v\":[0],\"w\":[2143289344]}","{\"v\":[0],\"w\":[-1]}","{\"v\":[0],\"w\":[4294967296]}","{\"v\":[0],\"w\":[0.5]}","{\"v\":[1],\"w\":[0]}","{\"v\":[\"0\"],\"w\":[0]}","{\"v\":[0],\"w\":[\"0\"]}","{\"v\":[0],\"w\":[]}","{\"v\":[],\"w\":[0]}"];
  for text:bad {#assert pp_test_parse(text,doc[..],nodes[..]) && !pp_lane(doc[0],jv_get(doc[0],0,"v"),jv_get(doc[0],0,"w"),0);}
}
#test "primitive expected rules preserve exact ring and existing filter bounds" {
  #assert pp_numeric_match(0,0.0,100.0) && pp_numeric_match(0,1.0,-100.0);
  #assert pp_numeric_match(1,0.0,-0.0) && pp_numeric_match(1,cast(f64)f32_from_bits(1065353216),1.0);
  #assert !pp_numeric_match(1,cast(f64)f32_from_bits(1065353217),1.0);
  #assert pp_numeric_match(2,0.000001,0.0) && !pp_numeric_match(2,0.0000010000000001,0.0);
  #assert pp_numeric_match(2,-0.000001,0.0) && !pp_numeric_match(2,-0.0000010000000001,0.0);
  #assert pp_numeric_match(3,0.00001,0.0) && !pp_numeric_match(3,0.000010000000001,0.0);
  #assert pp_numeric_match(3,-0.00001,0.0) && !pp_numeric_match(3,-0.000010000000001,0.0);
  #assert !pp_numeric_match(-1,0.0,0.0) && !pp_numeric_match(4,0.0,0.0);
  #assert pp_max(0.0,0.125)==0.125 && pp_max(0.125,0.0)==0.125 && pp_max(0.25,0.125)==0.25 && pp_max(0.125,0.25)==0.25;
  tiny:=f64_from_bits(0x3ff0000000000001);#assert f64_bits(pp_max(0.0,tiny))==0x3ff0000000000001 && f64_bits(pp_max(tiny,0.0))==0x3ff0000000000001;
}
#test "sampling expectations retain all authored cases and four control lanes" {
  a:=[4]f64.[0.25,0.4375,0.25,1];b:=[4]f64.[0.125,0.25,0.5,0.75];c:=[4]f64.[0.75,0.5,0.125,1];
  for k:0..<4 {
    #assert pp_sampling_expected(0,k)==a[k] && pp_sampling_expected(1,k)==b[k] && pp_sampling_expected(2,k)==c[k];
    for row:3..<6 {#assert pp_sampling_expected(row,k)==b[k];}
  }
}
pp_test_document :: (mode:int,change:int,out:[]u8) ->string {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"format");jo_str(o[..],ifx change==1 then "rgba16float" else "rgba32float");
  jo_key(o[..],"width");jo_int(o[..],pp_width(mode)+(ifx change==2 then 1 else 0));jo_key(o[..],"height");jo_int(o[..],pp_width(mode));
  jo_key(o[..],"messages");jo_arr(o[..]);if change==3 {jo_str(o[..],"warning");}jo_end(o[..]);
  jo_key(o[..],"errors");jo_arr(o[..]);if change==4 {jo_str(o[..],"error");}jo_end(o[..]);
  jo_key(o[..],"results");jo_arr(o[..]);
  for row:0..<pp_count(mode)-(ifx change==5 then 1 else 0) {
    jo_obj(o[..]);jo_key(o[..],"values");jo_arr(o[..]);
    lanes:=ifx mode==3 then 16 else 4;
    for k:0..<lanes {
      if mode==3 && row==change-6 && k==0 {jo_raw(o[..],ifx row<4 then "0" else "0.125");}
      else if mode==3 && row<4 {expected:=pp_sampling_expected(row,k%4);if expected==0.125 {jo_raw(o[..],"0.125");}else if expected==0.25 {jo_raw(o[..],"0.25");}else if expected==0.4375 {jo_raw(o[..],"0.4375");}else if expected==0.5 {jo_raw(o[..],"0.5");}else if expected==0.75 {jo_raw(o[..],"0.75");}else {jo_int(o[..],1);}}
      else if (mode==1 || mode==2) && row<2 {jo_raw(o[..],ifx row==0 then "0.125" else "0.25");}else {jo_int(o[..],0);}
    }
    jo_end(o[..]);jo_key(o[..],"words");jo_arr(o[..]);
    for k:0..<lanes {bits:=0;if mode==3 && row==change-6 && k==0 {bits=ifx row<4 then 0 else 1040187392;}else if mode==3 && row<4 {bits=cast(int)f32_bits(cast(f32)pp_sampling_expected(row,k%4));}else if (mode==1 || mode==2) && row<2 {bits=ifx row==0 then 1040187392 else 1048576000;}jo_int(o[..],bits);}
    jo_end(o[..]);jo_end(o[..]);
  }
  jo_end(o[..]);jo_end(o[..]);return jo_text(o[..]);
}
pp_test_fixture :: (mode:int,out:[]u8)->string {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"cases");jo_arr(o[..]);
  for row:0..< (ifx mode==1 then 728 else 20) {jo_obj(o[..]);jo_key(o[..],"expected");jo_raw(o[..],ifx row==0 then "[0.125,0.125,0.125,0.125]" else ifx row==1 then "[0.25,0.25,0.25,0.25]" else "[0,0,0,0]");jo_end(o[..]);}
  jo_end(o[..]);jo_key(o[..],"expected");jo_arr(o[..]);for row:0..<40 {jo_raw(o[..],ifx row==0 then "[0.125,0.125,0.125,0.125]" else ifx row==1 then "[0.25,0.25,0.25,0.25]" else "[0,0,0,0]");}jo_end(o[..]);jo_end(o[..]);return jo_text(o[..]);
}
pp_test_replace :: (text:string,from:string,to:string,out:[]u8)->string {
  for at:0..<text.count-from.count+1 {if text[at..<at+from.count]!=from {continue;}
    for j:0..<at {out[j]=text[j];}for j:0..<to.count {out[at+j]=to[j];}
    for j:at+from.count..<text.count {out[j-from.count+to.count]=text[j];}
    return cast(string)out[0..<text.count-from.count+to.count];
  }return "";
}
#test "primitive result shapes and omitted expected lanes refuse before a verdict" {
  raw:[131072]u8;changed:[131072]u8;fraw:[32768]u8;doc:[1]Jv;fd:[1]Jv;nodes:[16384]JvNode;fnodes:[8192]JvNode;
  valid:=pp_test_document(0,0,raw[..]);#assert jv_parse(fd[..],pp_test_fixture(0,fraw[..]),fnodes[..]);
  from:=[11]string.["\"height\":64","\"messages\":[]","\"errors\":[]","\"values\":[0,0,0,0]","\"values\":[0,0,0,0]","\"words\":[0,0,0,0]","\"words\":[0,0,0,0]","\"values\":[0,0,0,0]","\"words\":[0,0,0,0]","\"width\":64","\"height\":64"];
  to:=[11]string.["\"height\":63","\"messages\":{}","\"errors\":{}","\"values\":[0,0,0]","\"values\":{\"a\":0,\"b\":0,\"c\":0,\"d\":0}","\"words\":[0,0,0]","\"words\":{\"a\":0,\"b\":0,\"c\":0,\"d\":0}","\"values\":[null,0,0,0]","\"words\":[2139095040,0,0,0]","\"width\":\"64\"","\"height\":\"64\""];
  for i:0..<11 {text:=pp_test_replace(valid,from[i],to[i],changed[..]);#assert text!="" && jv_parse(doc[..],text,nodes[..]) && !pp_evaluate(doc[0],0,fd[0],0).ok;}
  #assert jv_parse(doc[..],valid,nodes[..]) && !pp_evaluate(doc[0],0,fd[0],-1).ok && !pp_evaluate(doc[0],0,fd[0],4).ok;
  valid=pp_test_document(2,0,raw[..]);text:=pp_test_replace(valid,"\"values\":[0.125,0.125,0.125,0.125],\"words\":[1040187392,1040187392,1040187392,1040187392]","\"values\":[0.25,0.125,0.125,0.125],\"words\":[1048576000,1040187392,1040187392,1040187392]",changed[..]);
  #assert text!="" && jv_parse(doc[..],text,nodes[..]) && jv_parse(fd[..],pp_test_fixture(2,fraw[..]),fnodes[..]);
  r:=pp_evaluate(doc[0],0,fd[0],2);#assert !r.ok && r.discrepancies==1 && r.max_error==0.125;
  #assert jv_parse(fd[..],"{\"expected\":[[null,0,0,0]]}",fnodes[..]) && !pp_evaluate(doc[0],0,fd[0],2).ok;
  #assert jv_parse(doc[..],"{\"format\":\"rgba32float\",\"width\":64,\"height\":64,\"messages\":[],\"errors\":[],\"results\":[]}",nodes[..]) && !pp_evaluate(doc[0],0,fd[0],-1).ok && !pp_evaluate(doc[0],0,fd[0],4).ok;
}
#forall "every sampling normal and planted-control case must keep its individual verdict" loss:6..<12 {
  text:[32768]u8;doc:[1]Jv;nodes:[4096]JvNode;fd:Jv;
  #assert jv_parse(doc[..],pp_test_document(3,loss,text[..]),nodes[..]) && !pp_evaluate(doc[0],0,fd,3).ok;
}
#test "invalid reference lanes cannot turn into an accepted zero or an infinite error statistic" {
  raw:[131072]u8;fraw:[32768]u8;doc:[1]Jv;fd:[1]Jv;nodes:[16384]JvNode;fnodes:[8192]JvNode;
  #assert jv_parse(doc[..],pp_test_document(0,0,raw[..]),nodes[..]);
  invalid:=[3]string.["null","1e999","1.8e308"];
  for number:invalid {
    o:[1]Jo;jo_start(o[..],fraw[..]);jo_obj(o[..]);jo_key(o[..],"expected");jo_arr(o[..]);
    for row:0..<40 {jo_arr(o[..]);jo_raw(o[..],ifx row==0 then number else "0");for k:0..<3 {jo_int(o[..],0);}jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);
    #assert jv_parse(fd[..],jo_text(o[..]),fnodes[..]);r:=pp_evaluate(doc[0],0,fd[0],2);#assert !r.ok && r.discrepancies==0 && r.max_error==0;
  }
}
#forall "primitive outcomes require every case and all finite raw lanes" mode:0..<4,change:0..<6 #steps 100000000 {
  text:[131072]u8;fixture:[32768]u8;doc:[1]Jv;fd:[1]Jv;nodes:[16384]JvNode;fnodes:[8192]JvNode;
  #assert jv_parse(doc[..],pp_test_document(mode,change,text[..]),nodes[..]) && jv_parse(fd[..],pp_test_fixture(mode,fixture[..]),fnodes[..]);
  result:=pp_evaluate(doc[0],0,fd[0],mode);
  #assert result.ok==(change==0);
  if change==0 {#assert result.discrepancies==0 && result.max_error==0;}
}
