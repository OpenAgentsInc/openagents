#test "producer comparison checks every output field and ignores only the owned dump directory" {
  a:[1]Jv;b:[1]Jv;an:[1024]JvNode;bn:[1024]JvNode;left:[8192]u8;right:[8192]u8;
  ln:=pcp_fixture(-1,left[..]);rn:=pcp_fixture(-1,right[..]);#assert jv_parse(a[..],cast(string)left[0..<ln],an[..]) && jv_parse(b[..],cast(string)right[0..<rn],bn[..]) && pcp_fields(a[0],b[0]);
  for loss:0..<14 {rn=pcp_fixture(loss,right[..]);#assert jv_parse(b[..],cast(string)right[0..<rn],bn[..]) && !pcp_fields(a[0],b[0]);}
  ln=pcp_fixture(14,left[..]);rn=pcp_fixture(-1,right[..]);#assert jv_parse(a[..],cast(string)left[0..<ln],an[..]) && jv_parse(b[..],cast(string)right[0..<rn],bn[..]) && !pcp_fields(a[0],b[0]);
  for loss:0..<2 {ln=pcp_fixture(loss,left[..]);rn=pcp_fixture(loss,right[..]);#assert jv_parse(a[..],cast(string)left[0..<ln],an[..]) && jv_parse(b[..],cast(string)right[0..<rn],bn[..]) && !pcp_fields(a[0],b[0]);}
  #assert jv_parse(a[..],"{\"dump\":\"one\",\"frames\":\"2\"}",an[..]) && jv_parse(b[..],"{\"dump\":\"two\",\"frames\":\"2\"}",bn[..]) && pcp_options(a[0],0,b[0],0);
  #assert jv_parse(b[..],"{\"dump\":7,\"frames\":\"2\"}",bn[..]) && !pcp_options(a[0],0,b[0],0);
  #assert jv_parse(b[..],"{\"dump\":\"two\"}",bn[..]) && !pcp_options(a[0],0,b[0],0);
  #assert jv_parse(a[..],"[]",an[..]) && jv_parse(b[..],"{}",bn[..]) && !pcp_options(a[0],0,b[0],0);
  #assert jv_parse(a[..],"{}",an[..]) && jv_parse(b[..],"[]",bn[..]) && !pcp_options(a[0],0,b[0],0);
  #assert jv_parse(a[..],"{}",an[..]) && jv_parse(b[..],"{\"x\":0}",bn[..]) && !pcp_options(a[0],0,b[0],0);
}
#test "producer artifact filenames are flat canonical names" {
  #assert pcp_file_name("a") && pcp_file_name("u.bin") && pcp_file_name("layer-12.img") && pcp_file_name("A_9.bin");
  #assert !pcp_file_name("") && !pcp_file_name(".a") && !pcp_file_name("../u.bin") && !pcp_file_name("/u.bin") && !pcp_file_name("a b") && !pcp_file_name("a/b");
  for byte:0..<256 {bytes:=[2]u8.['a',cast(u8)byte];allowed:=(byte>=65 && byte<=90)||(byte>=97 && byte<=122)||(byte>=48 && byte<=57)||byte==45||byte==95||byte==46;#assert pcp_file_name(cast(string)bytes[..])==allowed;}
  bytes:[256]u8;for k:0..<256 {bytes[k]='a';}#assert pcp_file_name(cast(string)bytes[0..<255]) && !pcp_file_name(cast(string)bytes[..]);
}
pcp_fixture :: (loss:int,out:[]u8)->int {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);for key,k:pcp_keys() {jo_key(o[..],key);if k==0 {jo_str(o[..],ifx loss==k then "wrong" else "aethyr.render.producer-capture.v1");}else if k==1 {jo_str(o[..],ifx loss==k then "wrong" else "captured-unadmitted");}else if k==13 {jo_obj(o[..]);jo_key(o[..],"frames");jo_str(o[..],ifx loss==k then "3" else "2");jo_end(o[..]);}else {jo_int(o[..],ifx loss==k then k+1 else k);}}if loss==14 {jo_key(o[..],"extra");jo_int(o[..],1);}jo_end(o[..]);return o[0].n;
}
