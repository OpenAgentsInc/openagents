    m:=rto_string(d,jv_get(d,row,"module"),mb[..]);n:=rto_string(d,jv_get(d,row,"name"),nb[..]);kind:=rto_string(d,jv_get(d,row,"kind"),kb[..]);effect:=pc_import(m,n,kind);if effect<0 {return false;}
    jo_obj(o[..]);jo_key(o[..],"module");jo_str(o[..],m);jo_key(o[..],"name");jo_str(o[..],n);jo_key(o[..],"kind");jo_str(o[..],kind);
    if effect!=0 {
