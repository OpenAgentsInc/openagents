  return at>=0 && S_hex(S_hash(bytes),hash[..]) && jv_int(c[0].doc[0],jv_get(c[0].doc[0],at,"bytes"),-1)==bytes.count && jv_raw(c[0].doc[0],jv_get(c[0].doc[0],at,"sha256"))==cast(string)hash[..];
}
pc_send :: (c:[]Cdp,s:[]PcSession,kind:int,bytes:string)->bool {
  state:=[1]f64.[cast(f64)s[0].arena.base];empty:[]f64;cap:=pc_get(c,s,"coaxial_inbox_cap",empty,true);pointer:=pc_get(c,s,"coaxial_inbox",state[..],true);
  if s[0].failed || !pc_count(bytes.count,cap) || !pc_write(c,s,pointer,bytes) {return false;}
  args:=[3]f64.[state[0],cast(f64)kind,cast(f64)bytes.count];sent:=pc_get(c,s,"coaxial_message",args[..],true);pc_after(c,s);return !s[0].failed;
}
