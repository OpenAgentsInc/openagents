  d=c[0].doc[0];s[0].memory=jv_int(d,jv_get(d,at,"after"),-1);if s[0].memory!=s[0].arena.pages*65536 {return false;}
  args:=[1]f64.[cast(f64)s[0].arena.base];defaults:=pc_get(c,s,"coaxial_state_init",args[..],false);return !s[0].failed;
