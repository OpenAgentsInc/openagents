      jo_key(o[..],"value");if effect==1 || effect==2 {number:[32]u8;no:[1]Jo;jo_start(no[..],number[..]);jo_int(no[..],ifx effect==1 then clock else clock/1000);jo_str(o[..],jo_text(no[..]));}else {jo_int(o[..],ifx effect==3 then -1 else ifx effect==6 then 2 else ifx effect==7 then 52 else 0);}
