pc_write :: (c:[]Cdp,s:[]PcSession,pointer:int,bytes:string)->bool {
  if !pc_span(pointer,bytes.count,s[0].memory) {return false;}encoded:[262144]u8;n:=b64_encode(bytes,encoded[..]);if n<0 {return false;}
