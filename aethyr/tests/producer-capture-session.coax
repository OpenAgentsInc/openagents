}
pc_after :: (c:[]Cdp,s:[]PcSession) {
  args:=[1]f64.[cast(f64)s[0].arena.base];if pc_get(c,s,"coaxial_action",args[..],false)!=0 {done:=pc_get(c,s,"coaxial_action_done",args[..],true);}
