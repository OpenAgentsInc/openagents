#load "producer-capture-policy.coax";
#load "../../coax/lib/sys/args.coax";
#authority;
#load "producer-capture-tool-checks.coax";
PctOptions :: struct {valid:bool;values:[18]string;seen:[18]bool;frames:int=120;every:int=30;width:int=1280;height:int=720;scale:f64=1.0;clock:int;page:int;}
PctEvent :: struct {frame:int;a:f64;b:f64;}
PctAck :: struct {http:int;schema:string;status:int;published:bool;clean:bool;declared:int;received:int;stored:int;bytes:int;hash:string;file:string;}
PctClock :: struct {valid:bool;value:int;}
pct_option :: (text:string)->int {
  names:=[18]string.["--dump","--frames","--every","--size","--scale","--clock","--page","--pack","--facts","--fact","--extra","--hash","--keys","--pointer","--index","--vertices","--mesh","--golden"];
  for name,k:names {if name==text {return k;}}return -1;
}
pct_options :: (a:[]Args)->PctOptions {
  p:PctOptions;if args_at(a,0)=="" {return p;}i:=1;
  while i<args_count(a) {k:=pct_option(args_at(a,i));if k<0 {return p;}p.seen[k]=true;if k==17 {p.values[k]="1";i+=1;}else {if i+1>=args_count(a) {return p;}p.values[k]=args_at(a,i+1);i+=2;}}
  if p.seen[1] {value:=pct_whole(p.values[1]);if !value.valid {return p;}p.frames=value.value;}if p.seen[2] {value:=pct_whole(p.values[2]);if !value.valid {return p;}p.every=value.value;}
  if p.seen[3] {size:=args_size(p.values[3]);if !size.ok {return p;}p.width=size.w;p.height=size.h;}
  if p.seen[4] {scale:=args_number(p.values[4]);if !scale.ok {return p;}p.scale=scale.value;}
  if p.seen[5] {clock:=pct_clock(p.values[5]);if !clock.valid {return p;}p.clock=clock.value;}
  if p.seen[6] {value:=pct_whole(p.values[6]);if !value.valid || value.value< -2147483648 || value.value>2147483647 {return p;}p.page=value.value;}
  p.valid=pc_controls(p.frames,p.every,p.width,p.height,p.scale);return p;
}
pct_ack :: (a:PctAck,n:int,hash:string,file:string)->bool {
  return a.http==200 && a.schema=="aethyr.render-test-origin.post.v1" && a.status==200 && a.published && a.clean && a.declared==n && a.received==n && a.stored==n && a.bytes==n && a.hash==hash && a.file==file;
}
pct_events :: (text:string,out:[]PctEvent)->int {
  count:=0;start:=0;for i:0..<text.count+1 {if i==text.count || text[i]==',' {
    if i>start {
      row:=text[start..<i];parts:[3]string;part:=0;from:=0;for k:0..<row.count+1 {if k==row.count || row[k]==':' {if part==3 {return -1;}parts[part]=row[from..<k];part+=1;from=k+1;}}
      if part!=3 || count==out.count {return -1;}frame:=pct_whole(parts[0]);a:=args_number(parts[1]);b:=args_number(parts[2]);
      if !frame.valid || frame.value<0 || !a.ok || !b.ok {return -1;}
      out[count]=PctEvent.{frame=frame.value,a=a.value,b=b.value};count+=1;
    }start=i+1;
  }}return count;
}
pct_clock :: (text:string)->PctClock {
  r:PctClock;
  if text.count<1 {return r;}neg:=text[0]=='-';start:=ifx neg || text[0]=='+' then 1 else 0;if start==text.count {return r;}
  return pct_decimal(text[start..<text.count],0,neg);
}
pct_whole :: (text:string)->PctClock {
  r:=pct_clock(text);if r.valid {return r;}n:=args_number(text);if !n.ok {return r;}if n.value==0.0 {r.valid=true;return r;}
  // The admitted nonzero decimal has at least one nonspace character.
  first:=0;last:=text.count;while text[first]==' ' {first+=1;}while text[last-1]==' ' {last-=1;}
  s:=text[first..<last];negative:=s[0]=='-';start:=ifx negative || s[0]=='+' then 1 else 0;
  digits:[32]u8;used:=0;fraction:=0;after_dot:=false;exponent:=0;
  for k:start..<s.count {byte:=s[k];if byte=='e' || byte=='E' {exponent=pct_clock(s[k+1..<s.count]).value;break;}if byte=='.' {after_dot=true;}else {digits[used]=byte;used+=1;if after_dot {fraction+=1;}}}
  shift:=exponent-fraction;trim_digits:=pc_max(0,-shift);keep:=used-trim_digits;if keep<1 {return r;}for k:keep..<used {if digits[k]!='0' {return r;}}
  return pct_decimal(cast(string)digits[0..<keep],pc_max(0,shift),negative);
}
pct_decimal :: (digits:string,zeros:int,negative:bool)->PctClock {
  r:PctClock;if zeros<0 || zeros>22 {return r;}value:=0;limit:=ifx negative then -9223372036854775808 else -9223372036854775807;
  for k:0..<digits.count+zeros {byte:=ifx k<digits.count then digits[k] else cast(u8)'0';if byte<'0' || byte>'9' {return r;}digit:=cast(int)(byte-'0');if value<(limit+digit)/10 {return r;}value=value*10-digit;}
  r.valid=true;r.value=ifx negative then value else -value;return r;
}
