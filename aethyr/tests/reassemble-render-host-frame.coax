// Repair only the independently identified source-row header from retained
// actual browser bytes. No browser, product emission, shader or GPU execution.
#import "Basic";
#load "render-host-session.coax";
#load "render-host-rfi-policy.coax";
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {tool_errln("usage: reassemble-render-host-frame CAPTURE_DIR NEW_EMPTY_OUT");return 2;}paths:[7][4096]u8;capture:=fs_realpath(args_at(a[..],0),paths[0][..]);if capture=="" || !fs_mkdir(args_at(a[..],1)) {return 2;}work:=fs_realpath(args_at(a[..],1),paths[1][..]);listing:[1]FsList;if work=="" || fs_list(work,listing[..])!=0 {return 2;}
  receipt:=fs_join(capture,"receipt.json",paths[2][..]);original:=fs_join(capture,"frame.config",paths[3][..]);draws:=fs_join(capture,"draws.bin",paths[4][..]);inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}for file:[4]string.[receipt,original,draws,compiler] {if !rtq_input_add(inputs[..],file) {return 1;}}if !rtq_deps(inputs[..],compiler,"aethyr/tests/reassemble-render-host-frame.coax",proc_now_ms()+30000,work,"tool-dependencies") {return 1;}
  body:[8388608]u8;nodes:[65536]JvNode;d:[1]Jv;if !rtq_json_file(receipt,body[..],nodes[..],d[..]) || jv_raw(d[0],jv_get(d[0],0,"qualification"))!="passed" {return 1;}row:=jv_path(d[0],0,"status.capture");source:=rh_source_draws(d[0],row,fs_size(draws));admitted:=rh_number(d[0],row,"admitted_draws");old:[262144]u8;fresh:[262144]u8;n:=fs_read(original,old[..]);m:=ifx source>=0 && n>0 then rh_rfi_repair(cast(string)old[0..<n],source,admitted,fresh[..]) else -1;if m<1 {return 1;}
  target:=fs_join(work,"frame.config",paths[5][..]);if !fs_write(target,cast(string)fresh[0..<m]) {return 1;}self:[4096]u8;image:=gp_self(self[..]);if !rtq_input_add(inputs[..],image) {return 1;}same:=rtq_inputs_match(inputs[..]);hash:[64]u8;if !rtq_hash_file(target,hash[..]) {return 1;}record:[8388608]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.host-rfi-reassembly.v1");jo_key(o[..],"status");jo_str(o[..],ifx same then "passed" else "failed");jo_key(o[..],"source_draw_rows");jo_int(o[..],source);jo_key(o[..],"nonempty_admitted_rows");jo_int(o[..],admitted);jo_key(o[..],"draw_bytes");jo_int(o[..],fs_size(draws));jo_key(o[..],"original_config");jo_str(o[..],original);jo_key(o[..],"config");jo_str(o[..],target);jo_key(o[..],"config_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"scope");jo_str(o[..],"Only header field5 changes from active/nonempty admission count to actual source draw row count. All other13-field header values and every suffix byte/reference remain unchanged; no retained input/config is overwritten, no resource or shader omitted, and no GPU frame is repeated. Original browser metadata and failed measurement configurations remain separate immutable artifacts.");jo_end(o[..]);print("RFI source rows % (active %): %\n",source,admitted,same);return ifx same && !o[0].bad && rto_saved(work,"receipt.json",jo_text(o[..])) then 0 else 1;
}
