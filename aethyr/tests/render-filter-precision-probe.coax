// Independent hardware linear-filter fraction probe. Constant per-draw UVs
// exclude raster interpolation; authored black/white texels expose weights.
#load "../../verse/gpu/shader.coax";
filter_probe_uv :: (fraction:f32)->V2 {return v2((0.5f32+fraction)*0.5f32,0.5);}
#test "filter precision probe supplies exact texel-center and midpoint coordinates" {
 #assert filter_probe_uv(0).x==0.25 && filter_probe_uv(1).x==0.75 && filter_probe_uv(0.5).x==0.5;
 #assert filter_probe_uv(1.0f32/1024).x==0.25048828125;
}
render_filter_probe_vs :: (vertex:u32,instance:u32)->V4 {
 fp_points:=[3]V2.[v2(-1,1),v2(3,1),v2(-1,-3)];fp_p:=fp_points[cast(int)vertex];return v4(fp_p.x,fp_p.y,0.5,1);
}
render_filter_probe_fs :: (position:V4,u:[]f32,filter_image:Tex2D,filter_sampler:Sampler)->V4 {
 fp_uv:=filter_probe_uv(u[0]);fp_sample:=gpu_sample_level(filter_image,filter_sampler,fp_uv,0);return v4(fp_sample.x,u[0],fp_uv.x,1);
}
