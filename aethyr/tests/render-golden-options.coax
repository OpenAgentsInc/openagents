#load "../../coax/lib/sys/args.coax";
#load "render-golden-numbers.coax";
#load "../render/tests/tooling-policy.coax";
#authority;
GgOptions :: struct {valid:bool;start:bool;frames:int=90;width:int=320;height:int=180;query:string;legacy_shader:string;particles:string;reuse_generic:string;reuse_legacy:string;surface:string;}
#test "golden original CLI defaults and every named control remain available" {a:[1]Args;for value:[4]string.["producer","package","page","out"] {#assert args_add(a[..],value);}p:=gg_options(a[..]);#assert p.valid && !p.start && p.frames==90 && p.width==320 && p.height==180 && p.query=="" && p.legacy_shader=="" && p.particles=="" && p.reuse_generic=="" && p.reuse_legacy=="";for value:[13]string.["--start","--frames","0x10","--size=00016x0008","--query=a=hello+world","--legacy-wgsl","scene","--legacy-particles","particle","--reuse-generic","retained","--surface-root","surface"] {#assert args_add(a[..],value);}p=gg_options(a[..]);#assert p.valid && p.start && p.frames==16 && p.width==16 && p.height==8 && p.query=="a=hello+world" && p.legacy_shader=="scene" && p.particles=="particle" && p.reuse_generic=="retained" && p.reuse_legacy=="" && p.surface=="surface";#assert args_add(a[..],"--reuse-legacy") && args_add(a[..],"second") && !gg_options(a[..]).valid;}
#test "golden CLI keeps first matching options and ignores unknown flags as original" {a:[1]Args;for value:[13]string.["--start","package","page","out","--frames","1","--frames","600","--size=1x8192","--size=2x2","--query=first","--query=second","--unknown"] {#assert args_add(a[..],value);}p:=gg_options(a[..]);#assert p.valid && !p.start && p.frames==1 && p.width==1 && p.height==8192 && p.query=="first";}
#test "golden viewport and missing option controls refuse before effects" {for size:[9]string.["0x2","1x0","8193x1","1x8193","1x1x1","1.0x1","+1x1","1x1 ","x"] {a:[1]Args;for value:[4]string.["p","pack","page","out"] {#assert args_add(a[..],value);}#assert args_add(a[..],"--size=");a[0].n-=1;raw:[64]u8;n:=0;for c:"--size=" {raw[n]=c;n+=1;}for c:size {raw[n]=c;n+=1;}#assert args_add(a[..],cast(string)raw[0..<n]) && !gg_options(a[..]).valid;}for key:[6]string.["--frames","--legacy-wgsl","--legacy-particles","--reuse-generic","--reuse-legacy","--surface-root"] {a:[1]Args;for value:[4]string.["p","pack","page","out"] {#assert args_add(a[..],value);}#assert args_add(a[..],key) && !gg_options(a[..]).valid;}a:[1]Args;#assert !gg_options(a[..]).valid;}
GgSize :: struct {valid:bool;width:int;height:int;}
gg_find :: (a:[]Args,key:string,prefix:bool)->int {for i:4..<args_count(a) {value:=args_at(a,i);if (prefix && uri_prefix(value,key)) || (!prefix && value==key) {return i;}}return -1;}
gg_digits :: (text:string)->int {value:=0;for c:text {if c<'0' || c>'9' {return -1;}digit:=cast(int)(c-'0');if value>(8192-digit)/10 {return -1;}value=value*10+digit;}return ifx value>=1 then value else -1;}
gg_size :: (text:string)->GgSize {x:=rtq_find(text,"x",1);if x== -1 {return GgSize.{};}w:=gg_digits(text[0..<x]);h:=gg_digits(text[x+1..<text.count]);if w<1 || h<1 {return GgSize.{};}return GgSize.{valid=true,width=w,height=h};}
gg_options :: (a:[]Args)->GgOptions {
 p:GgOptions;if args_count(a)<4 {return p;}for i:4..<args_count(a) {if args_at(a,i)=="--start" {p.start=true;}}
 frame_at:=gg_find(a,"--frames",false);if frame_at!= -1 {p.frames=gg_integer(args_at(a,frame_at+1),600);if p.frames<1 {return p;}}
 size_at:=gg_find(a,"--size=",true);if size_at!= -1 {text:=args_at(a,size_at);size:=gg_size(text[7..<text.count]);if !size.valid {return p;}p.width=size.width;p.height=size.height;}
 query_at:=gg_find(a,"--query=",true);if query_at!= -1 {text:=args_at(a,query_at);p.query=text[8..<text.count];}
 for key,i:[5]string.["--legacy-wgsl","--legacy-particles","--reuse-generic","--reuse-legacy","--surface-root"] {at:=gg_find(a,key,false);if at== -1 {continue;}value:=args_at(a,at+1);if value=="" {return p;}if i==0 {p.legacy_shader=value;}if i==1 {p.particles=value;}if i==2 {p.reuse_generic=value;}if i==3 {p.reuse_legacy=value;}if i==4 {p.surface=value;}}
 if p.reuse_generic!="" && p.reuse_legacy!="" {return p;}p.valid=true;return p;
}
#test "golden viewport digit parser has exact positive endpoints and arbitrary leading zeros" {#assert gg_digits("")== -1 && gg_digits("0")== -1 && gg_digits("1")==1 && gg_digits("8192")==8192 && gg_digits("8193")== -1;#assert gg_digits("000000000000000000000001")==1 && gg_digits("1x")== -1 && gg_size("1x").valid==false;}

#test "golden frontend frame endpoints and nonnumeric viewport bytes are exact" {#assert gg_digits(":")== -1 && gg_size("1x1").valid;for text,i:[6]string.["1","600","601","0","1.5","Infinity"] {a:[1]Args;for v:[4]string.["p","pack","page","out"] {#assert args_add(a[..],v);}#assert args_add(a[..],"--frames") && args_add(a[..],text);p:=gg_options(a[..]);#assert p.valid==(i<2);if i<2 {#assert p.frames==[2]int.[1,600][i];}}}
#test "golden exact flag names never consume prefix aliases" {a:[1]Args;for v:[10]string.["p","pack","page","out","--frames-more","2","--legacy-wgslx","no","--reuse-genericx","no"] {#assert args_add(a[..],v);}p:=gg_options(a[..]);#assert p.valid && p.frames==90 && p.legacy_shader=="" && p.reuse_generic=="";}
