// URLSearchParams form decoding/encoding and the three forced probe flags.
#load "../render/tests/tooling-policy.coax";
#load "../../coax/lib/net/uri.coax";
#authority;
#load "render-golden-query-checks.coax";

gg_percent :: (text:string,out:[]u8)->int {o:[1]Jo;jo_start(o[..],out);at:=0;while at<text.count {c:=text[at];if c=='%' && at+2<text.count {a:=uri_hex(text[at+1]);b:=uri_hex(text[at+2]);if a>=0 && b>=0 {byte:=[1]u8.[cast(u8)(a*16+b)];jo_put(o[..],cast(string)byte[..]);at+=3;continue;}}if c=='+' {jo_put(o[..]," ");}else {jo_put(o[..],text[at..<at+1]);}at+=1;}return ifx o[0].bad then -1 else o[0].n;}
gg_utf8 :: (raw:string,out:[]u8)->int {
 o:[1]Jo;jo_start(o[..],out);at:=0;need:int;seen:int;begin:int;lower:int;upper:int;
 while at<raw.count {b:=cast(int)raw[at];if need==0 {
   if b<128 {jo_put(o[..],raw[at..<at+1]);at+=1;continue;}
   if b>=194 && b<=223 {need=1;}else if b>=224 && b<=239 {need=2;}else if b>=240 && b<=244 {need=3;}else {jo_put(o[..],"�");at+=1;continue;}
   begin=at;seen=0;lower=ifx b==224 then 160 else ifx b==240 then 144 else 128;upper=ifx b==237 then 159 else ifx b==244 then 143 else 191;at+=1;continue;
  }
  if b<lower || b>upper {jo_put(o[..],"�");need=0;continue;}seen+=1;lower=128;upper=191;at+=1;if seen==need {jo_put(o[..],raw[begin..<at]);need=0;}
 }if need!=0 {jo_put(o[..],"�");}return ifx o[0].bad then -1 else o[0].n;
}
gg_form :: (o:[]Jo,text:string) {digits:="0123456789ABCDEF";for c:text {if (c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9') || c=='*' || c=='-' || c=='.' || c=='_' {byte:=[1]u8.[c];jo_put(o,cast(string)byte[..]);}else if c==32 {jo_put(o,"+");}else {bytes:=[3]u8.['%',digits[c/16],digits[c%16]];jo_put(o,cast(string)bytes[..]);}}}
gg_query_into :: (text:string,out:[]u8,raw:[]u8,clean:[]u8)->int {
 o:[1]Jo;jo_start(o[..],out);at:=ifx text.count>0 && text[0]=='?' then 1 else 0;seen:[3]bool;wrote:=false;
 while true {end:=rtq_find(text,"&",at);if end== -1 {end=text.count;}pair:=text[at..<end];if pair.count>0 {equals:=rtq_find(pair,"=",0);key_end:=ifx equals== -1 then pair.count else equals;pn:=gg_percent(pair[0..<key_end],raw[..]);if pn<0 {return -1;}kn:=gg_utf8(cast(string)raw[0..<pn],clean[..]);if kn<0 {return -1;}key:=cast(string)clean[0..<kn];flag:=-1;for name,i:[3]string.["probe","golden","probe-manual"] {if key==name {flag=i;break;}}
   if flag<0 || !seen[flag] {if wrote {jo_put(o[..],"&");}gg_form(o[..],key);jo_put(o[..],"=");if flag>=0 {seen[flag]=true;}else {value:=ifx equals== -1 then "" else pair[equals+1..<pair.count];n:=gg_percent(value,raw[..]);if n<0 {return -1;}vn:=gg_utf8(cast(string)raw[0..<n],clean[..]);if vn<0 {return -1;}gg_form(o[..],cast(string)clean[0..<vn]);}wrote=true;}
  }if end==text.count {break;}at=end+1;
 }for name,i:[3]string.["probe","golden","probe-manual"] {if !seen[i] {if wrote {jo_put(o[..],"&");}jo_put(o[..],name);jo_put(o[..],"=");wrote=true;}}return ifx o[0].bad then -1 else o[0].n;
}

gg_query :: (text:string,out:[]u8)->int {raw:[131072]u8;clean:[393216]u8;return gg_query_into(text,out,raw[..],clean[..]);}
