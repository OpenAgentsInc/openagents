// Golden observation orchestration, source fences and binary publication.
#load "render-test-origin.coax";
#load "render-golden-transport.coax";
#load "render-golden-observation.coax";
#load "render-golden-query.coax";
#load "../../coax/lib/crypto/sha256.coax";
GG_EFFECTS :: "aethyr/tests/render-golden-effects.js";
GG_KEYS :: [4]string.["bytes","uniform_bytes","vertex_bytes","draw_bytes"];
GG_FILES :: [4]string.["gpu.bin","u.bin","hud.bin","draws.bin"];
GgTrace :: struct {work:string;deadline:int;events:int;exceptions:int;errors:int;calls:int;okay:bool=true;stage:string="startup";}
GgPaths :: struct {surface:string;wasm:string;package:string;page:string;out:string;scene:string;particles:string;generic:string;legacy:string;host:string;observed:string;manifest:string;}
gg_copy :: (source:string,target:string)->bool {n:=fs_size(source);if gg_parts(n)<0 || !fs_write(target,"") {return false;}bytes:[65536]u8;at:=0;while at<n {take:=ifx n-at<bytes.count then n-at else bytes.count;if fs_read_at(source,at,bytes[0..<take])!=take || !fs_append(target,cast(string)bytes[0..<take]) {return false;}at+=take;}return true;}
gg_hash_file :: (file:string,out:[]u8)->bool {n:=fs_size(file);if gg_parts(n)<0 {return false;}state:[112]u8;digest:[32]u8;bytes:[65536]u8;if sha256_init(state[..])!=SHA_OK {return false;}at:=0;while at<n {take:=ifx n-at<bytes.count then n-at else bytes.count;if fs_read_at(file,at,bytes[0..<take])!=take || sha256_update_checked(state[..],bytes[0..<take],false)!=SHA_OK {return false;}at+=take;}if sha256_final_checked(state[..],digest[..],false)!=SHA_OK {return false;}d:S_Digest;for k:0..<8 {d.words[k]=cb_load_be32(digest[..],4*k).value;}return S_hex(d,out);}
gg_call :: (c:[]Cdp,t:[]GgTrace,method:string,params:string)->int {
 if !t[0].okay || proc_now_ms()>=t[0].deadline {return -1;}id:=cdp_send(c,method,params);if id<0 || !rto_append(t[0].work,"commands.jsonl",cast(string)c[0].req[0..<cdp_command(id,method,params,c[0].req[..]).count]) {t[0].okay=false;return -1;}t[0].calls+=1;until:=proc_now_ms()+30000;if until>t[0].deadline {until=t[0].deadline;}
 while proc_now_ms()<until {k:=cdp_poll(c,proc_left(until,proc_now_ms()));if k!=CDP_GOT {return -1;}raw:=cast(string)c[0].msg[0..<c[0].msg_n];if !rto_append(t[0].work,"messages.jsonl",raw) {t[0].okay=false;return -1;}d:=c[0].doc[0];if cdp_reply_id(d)==id {return cdp_reply_result(d);}if cdp_reply_id(d)<0 {method_text:=cdp_event_method(d);if uri_prefix(method_text,"Runtime.") || method_text=="Log.entryAdded" {t[0].events+=1;if !rto_append(t[0].work,"events.jsonl",raw) {t[0].okay=false;return -1;}if method_text=="Runtime.exceptionThrown" {t[0].exceptions+=1;if !rto_append(t[0].work,"exceptions.jsonl",raw) {t[0].okay=false;return -1;}}if method_text=="Log.entryAdded" && gg_events(d) {t[0].errors+=1;if !rto_append(t[0].work,"errors.jsonl",raw) {t[0].okay=false;return -1;}}}}
 }return -1;
}
gg_evaluate :: (c:[]Cdp,t:[]GgTrace,expression:string)->int {data:[CDP_REQ]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"expression");jo_str(o[..],expression);jo_key(o[..],"returnByValue");jo_bool(o[..],true);jo_key(o[..],"awaitPromise");jo_bool(o[..],true);jo_end(o[..]);if o[0].bad {return -1;}r:=gg_call(c,t,"Runtime.evaluate",jo_text(o[..]));if r<0 || jv_get(c[0].doc[0],r,"exceptionDetails")>=0 {return -1;}return jv_path(c[0].doc[0],r,"result.value");}
gg_effect :: (c:[]Cdp,t:[]GgTrace,request:string,out:[]u8)->int {
 expression:[CDP_REQ]u8;o:[1]Jo;jo_start(o[..],expression[..]);jo_put(o[..],"renderGoldenStart(");jo_put(o[..],request);jo_put(o[..],")");if o[0].bad {return -1;}r:=gg_evaluate(c,t,jo_text(o[..]));if r<0 || !gg_text(c[0].doc[0],r,"started") {return -1;}
 while proc_now_ms()<t[0].deadline {r=gg_evaluate(c,t,"renderGoldenPoll()");if r<0 {return -1;}d:=c[0].doc[0];if jv_kind(d,jv_get(d,r,"done"))==JV_TRUE {if jv_kind(d,jv_get(d,r,"error"))!=JV_NULL {return -1;}jo_start(o[..],out);jv_write(d,jv_get(d,r,"value"),o[..]);return ifx o[0].bad then -1 else o[0].n;}proc_sleep(5);}return -1;
}
gg_step :: (c:[]Cdp,t:[]GgTrace,count:int,warmup:bool)->bool {data:[512]u8;out:[65536]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"operation");jo_str(o[..],"step");jo_key(o[..],"count");jo_int(o[..],count);jo_key(o[..],"optional");jo_bool(o[..],warmup);jo_key(o[..],"rate_words");jo_arr(o[..]);jo_int(o[..],0);jo_int(o[..],ifx warmup then 2146435072 else 1078853632);jo_end(o[..]);jo_end(o[..]);return !o[0].bad && gg_effect(c,t,jo_text(o[..]),out[..])>=0;}
gg_lines :: (work:string,name:string,o:[]Jo)->bool {path:[4096]u8;file:=fs_join(work,name,path[..]);data:[4194304]u8;n:=fs_read(file,data[..]);if n<0 {return false;}jo_arr(o);at:=0;for k:0..<n {if data[k]=='\n' {if k>at {jo_raw(o,cast(string)data[at..<k]);}at=k+1;}}jo_end(o);return at==n && !o[0].bad;}
gg_part_name :: (key:int,part:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"part-");jo_int(o[..],key);jo_put(o[..],"-");jo_int(o[..],part);jo_put(o[..],".bin");return ifx o[0].bad then "" else jo_text(o[..]);}
gg_part_url :: (key:int,part:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"/__golden_upload/");jo_int(o[..],key);jo_put(o[..],"/");jo_int(o[..],part);return ifx o[0].bad then "" else jo_text(o[..]);}
gg_config :: (paths:GgPaths,p:GgOptions,route:string,work:string,app:string,config:string)->bool {
 buffers:[6][4096]u8;page:=fs_join(work,"page.html",buffers[0][..]);capture:=fs_join(work,"capture",buffers[1][..]);source:[1048576]u8;out:[1048576]u8;scratch:[1048576]u8;n:=fs_read(paths.page,source[..]);if n<0 || !fs_mkdir(capture) {return false;}pn:=gg_page(cast(string)source[0..<n],route=="legacy",out[..],scratch[..]);if pn<0 || !fs_write(page,cast(string)out[0..<pn]) {return false;}
 data:[65536]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.v1");jo_key(o[..],"lifetime_ms");jo_int(o[..],180000);jo_key(o[..],"idle_websockets");jo_arr(o[..]);jo_str(o[..],"/coaxial/live");jo_end(o[..]);jo_key(o[..],"routes");jo_arr(o[..]);
 for k:0..<6 {jo_obj(o[..]);jo_key(o[..],ifx k==3 then "prefix" else "url");jo_str(o[..],[6]string.["/api/auth/viewer","/api/villa/pets","/api/villa/garden","/api/playtest/","/api/analytics/events","/favicon.ico"][k]);jo_key(o[..],"text");jo_str(o[..],ifx k==1 || k==2 then "{\"pets\":[]}" else ifx k==3 then "{}" else "");if k==4 || k==5 {jo_key(o[..],"status");jo_int(o[..],204);}jo_end(o[..]);}
 for k:0..<2 {if route!="legacy" || [2]string.[paths.scene,paths.particles][k]=="" {continue;}url:[4096]u8;uw:[1]Jo;jo_start(uw[..],url[..]);jo_put(uw[..],"/");jo_put(uw[..],ifx k==0 then app else "particles");jo_put(uw[..],".wgsl");jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],jo_text(uw[..]));jo_key(o[..],"file");jo_str(o[..],[2]string.[paths.scene,paths.particles][k]);jo_end(o[..]);}
 for k:0..<5 {jo_obj(o[..]);jo_key(o[..],ifx k<2 then "url" else "prefix");jo_str(o[..],[5]string.["/","/producer.wasm","/coaxial/","/package/","/"][k]);jo_key(o[..],ifx k<2 then "file" else "directory");jo_str(o[..],ifx k==0 then page else ifx k==1 then paths.wasm else ifx k==2 then fs_join(paths.surface,"coax/web",buffers[2][..]) else ifx k==3 then paths.package else fs_join(paths.surface,"apps/openagents-web",buffers[2][..]));if k==0 {jo_key(o[..],"mime");jo_str(o[..],"text/html");}jo_end(o[..]);}jo_end(o[..]);
 jo_key(o[..],"variants");jo_arr(o[..]);for k:0..<4 {jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],[4]string.["golden-readback-arm","golden-input-snapshot","golden-tight-image","golden-status"][k]);jo_key(o[..],"enabled");jo_bool(o[..],true);jo_key(o[..],"url");jo_str(o[..],"/coaxial/host.js");jo_key(o[..],"kind");jo_str(o[..],ifx k==3 then "append" else "replace");if k<3 {jo_key(o[..],"needle");jo_str(o[..],[3]string.[GG_ANCHOR_0,GG_ANCHOR_1,GG_ANCHOR_2][k]);}jo_key(o[..],"replacement");jo_str(o[..],[4]string.[GG_REPLACEMENT_0,GG_REPLACEMENT_1,GG_REPLACEMENT_2,GG_STATUS_SUFFIX][k]);jo_end(o[..]);}jo_end(o[..]);
 jo_key(o[..],"pins");jo_arr(o[..]);for file:[7]string.[paths.wasm,paths.page,paths.manifest,paths.host,paths.observed,page,GG_EFFECTS] {hash:[64]u8;if !rtq_hash_file(file,hash[..]) {return false;}jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],file);jo_key(o[..],"sha256");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);}jo_end(o[..]);
 jo_key(o[..],"post_sinks");jo_arr(o[..]);for key:0..<4 {for part:0..<8 {name:[64]u8;url:[128]u8;jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],gg_part_url(key,part,url[..]));jo_key(o[..],"root");jo_str(o[..],capture);jo_key(o[..],"file");jo_str(o[..],fs_join(capture,gg_part_name(key,part,name[..]),buffers[3][..]));jo_key(o[..],"max_bytes");jo_int(o[..],67108864);jo_end(o[..]);}}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && fs_write(config,jo_text(o[..]));
}
gg_transport :: (c:[]Cdp,t:[]GgTrace,d:Jv,capture:int)->bool {
 for key:0..<4 {entry:=jv_get(d,capture,GG_KEYS[key]);total:=jv_int(d,jv_get(d,entry,"bytes"),-1);parts:=gg_parts(total);if parts<0 {return false;}for part:0..<parts {n:=gg_chunk(total,part);request:[2048]u8;url:[128]u8;name:[64]u8;paths:[2][4096]u8;file:=fs_join(fs_join(t[0].work,"capture",paths[0][..]),gg_part_name(key,part,name[..]),paths[1][..]);o:[1]Jo;jo_start(o[..],request[..]);jo_obj(o[..]);jo_key(o[..],"operation");jo_str(o[..],"upload");jo_key(o[..],"key");jo_str(o[..],GG_KEYS[key]);jo_key(o[..],"from");jo_int(o[..],part*67108864);jo_key(o[..],"to");jo_int(o[..],part*67108864+n);jo_key(o[..],"url");jo_str(o[..],gg_part_url(key,part,url[..]));jo_end(o[..]);reply:[65536]u8;rn:=gg_effect(c,t,jo_text(o[..]),reply[..]);nodes:[2048]JvNode;ack:[1]Jv;hash:[64]u8;if rn<1 || !jv_parse(ack[..],cast(string)reply[0..<rn],nodes[..]) || fs_size(file)!=n || !rtq_hash_file(file,hash[..]) || !gg_ack(ack[0],cast(string)url[0..<gg_part_url(key,part,url[..]).count],file,n,cast(string)hash[..]) {return false;}}
 }return true;
}
gg_assemble :: (work:string,d:Jv,capture:int)->bool {
 for key:0..<4 {entry:=jv_get(d,capture,GG_KEYS[key]);total:=jv_int(d,jv_get(d,entry,"bytes"),-1);paths:[4][4096]u8;file:=fs_join(work,GG_FILES[key],paths[0][..]);pending:=fs_join(work,"capture.pending",paths[1][..]);if gg_parts(total)<0 || !fs_write(pending,"") {return false;}data:[65536]u8;for part:0..<gg_parts(total) {name:[64]u8;piece:=fs_join(fs_join(work,"capture",paths[2][..]),gg_part_name(key,part,name[..]),paths[3][..]);n:=gg_chunk(total,part);at:=0;while at<n {take:=ifx n-at<data.count then n-at else data.count;if fs_read_at(piece,at,data[0..<take])!=take || !fs_append(pending,cast(string)data[0..<take]) {return false;}at+=take;}}hash:[64]u8;if !gg_hash_file(pending,hash[..]) || !gg_artifact(d,entry,GG_FILES[key],fs_size(pending),cast(string)hash[..]) || !fs_rename(pending,file) {return false;}}
 return true;
}
