// Actual refusal before observation/dependency files can overwrite a supplied
// input or an earlier artifact. No browser, GPU or product emission.
#import "Basic";
#load "render-host-session.coax";
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {return 2;}worker:=args_at(a[..],0);wasm:=args_at(a[..],1);package:=args_at(a[..],2);page:=args_at(a[..],3);if !fs_mkdir(args_at(a[..],4)) {return 2;}paths:[5][4096]u8;root:=fs_realpath(args_at(a[..],4),paths[0][..]);inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_deps(inputs[..],compiler,"aethyr/tests/render-host-output-checks.coax",proc_now_ms()+30000,root,"tool-dependencies") {return 1;}for file:[5]string.[worker,wasm,page,compiler,"coax/web/tool.sh"] {if !rtq_input_add(inputs[..],file) {return 1;}}manifest:=fs_join(package,"render.json",paths[1][..]);if !rtq_input_add(inputs[..],manifest) {return 1;}
  report:[131072]u8;o:[1]Jo;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.host-output-controls.v1");jo_key(o[..],"cases");jo_arr(o[..]);passed:=true;
  for k:0..<3 {label:=ifx k==0 then "existing-artifact" else ifx k==1 then "input-page-overlap" else "empty-file-survives";dir:=fs_join(root,label,paths[1][..]);if !fs_mkdir(dir) {return 1;}file:=fs_join(dir,ifx k==0 then "u.bin" else ifx k==1 then "page.html" else "prior-empty",paths[2][..]);body:[65536]u8;n:=ifx k==1 then fs_read(page,body[..]) else 0;if k==1 && n<1 {return 1;}if !fs_write(file,ifx k==1 then cast(string)body[0..<n] else ifx k==0 then "retained NUL-safe artifact" else "") || !rtq_input_add(inputs[..],file) {return 1;}before:[64]u8;after:[64]u8;if !rtq_hash_file(file,before[..]) {return 1;}
    argv:=[5]string.[worker,wasm,package,ifx k==1 then file else page,dir];stdout:[65536]u8;stderr:[65536]u8;env:[1]string;r:=rtq_run_raw(argv[..],env[0..<0],30000,stdout[..],stderr[..]);if !rtq_record_run(root,label,argv[..],r,cast(string)stdout[0..<r.out_n],cast(string)stderr[0..<r.err_n]) {return 1;}listing:[1]FsList;okay:=r.started==0 && r.status==2 && !r.timed_out && !r.cut && fs_list(dir,listing[..])==1 && rtq_hash_file(file,after[..]) && cast(string)before[..]==cast(string)after[..];passed=passed && okay;jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],label);jo_key(o[..],"passed");jo_bool(o[..],okay);jo_key(o[..],"exit");jo_int(o[..],r.status);jo_key(o[..],"preserved_sha256");jo_str(o[..],cast(string)before[..]);jo_end(o[..]);
  }jo_end(o[..]);self:[4096]u8;image:=gp_self(self[..]);hash:[64]u8;if !rtq_input_add(inputs[..],image) || !rtq_hash_file(image,hash[..]) {return 1;}passed=passed && rtq_inputs_match(inputs[..]);jo_key(o[..],"status");jo_str(o[..],ifx passed then "passed" else "failed");jo_key(o[..],"observer_image_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],rtq_inputs_match(inputs[..]));jo_end(o[..]);print("host output preservation: %\n",passed);return ifx !o[0].bad && rto_saved(root,"qualification.json",jo_text(o[..])) && passed then 0 else 1;
}
