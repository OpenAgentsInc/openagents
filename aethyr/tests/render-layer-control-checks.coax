// Actual original/new refusal controls on copied, explicitly owned fixtures.
// Every command and planted byte is chosen here; no new producer is emitted.
#import "Basic";
#load "render-layer-tools.coax";
rlay_control_sources :: (root:string,inputs:[]RtqInputs)->bool {
  list:[1]FsList;n:=fs_list(root,list[..]);if n<0 || list[0].full {return false;}for k:0..<n {path:[4096]u8;file:=fs_join(root,fs_entry(list[..],k),path[..]);kind:=fs_kind(file);if kind==FS_DIR {if !rlay_control_sources(file,inputs) {return false;}}else if kind==FS_FILE {if !rtq_input_add(inputs,file) {return false;}}else {return false;}}return true;
}
rlay_control_shared :: (old_file:string,new_file:string)->bool {
  left:[1048576]u8;right:[4194304]u8;ln:[32768]JvNode;rn:[65536]JvNode;a:[1]Jv;b:[1]Jv;if !rtq_json_file(old_file,left[..],ln[..],a[..]) || !rtq_json_file(new_file,right[..],rn[..],b[..]) {return false;}
  if jv_raw(a[0],jv_get(a[0],jv_get(a[0],0,"status"),"status"))!="failed" || jv_raw(b[0],jv_get(b[0],jv_get(b[0],0,"status"),"status"))!="failed" || jv_len(a[0],jv_get(a[0],0,"source_changes"))!=0 || jv_len(b[0],jv_get(b[0],0,"source_changes"))!=0 || jv_kind(b[0],jv_get(b[0],0,"origin_finalized"))!=JV_TRUE {return false;}
  old_map:=jv_get(a[0],0,"inputs");new_map:=jv_get(b[0],0,"inputs");row:=a[0].nodes[old_map].first;while row!=-1 {file:=jv_key(a[0],row);if fs_base(file)!="check_render_layers.ts" {canonical:[4096]u8;name:=fs_realpath(file,canonical[..]);found:=false;child:=b[0].nodes[new_map].first;while child!=-1 {candidate:[4096]u8;if fs_realpath(jv_key(b[0],child),candidate[..])==name && jv_raw(b[0],child)==jv_raw(a[0],row) {found=true;break;}child=b[0].nodes[child].next;}if !found {return false;}}row=a[0].nodes[row].next;}return true;
}
rlay_control_one :: (work:string,surface:string,wasm:string,package:string,bun:string,observer:string,which:int,inputs:[]RtqInputs,deadline:int)->bool {
  names:=[7]string.["pack-magic","pack-length","pack-table","pack-unselected-span","image-decode","wrong-profile","empty-layer-part"];paths:[6][4096]u8;directory:=fs_join(work,names[which],paths[0][..]);if !fs_mkdir(directory) {return false;}copy:=fs_join(directory,"surface",paths[1][..]);if fs_exists(copy) {return false;}
  stdout:[65536]u8;stderr:[65536]u8;env:[1]string;cp:=[4]string.["/bin/cp","-R",surface,copy];r:=rtq_command(cp[..],env[0..<0],deadline,directory,"copy-surface",stdout[..],stderr[..]);if !rtq_ok(r) {return false;}
  pack_file:=fs_join(copy,"apps/openagents-web/realms/fixture/assets/fixture.pack",paths[2][..]);bytes:[2097152]u8;n:=fs_read(pack_file,bytes[..]);if n<32 {return false;}table:=rlay_u32(bytes[0..<n],16);count:=rlay_u32(bytes[0..<n],4);
  if which==0 {bytes[0]='X';}else if which==1 {rlay_test_word(bytes[..],8,n+1);}else if which==2 {rlay_test_word(bytes[..],16,n+1);}else if which==3 {rlay_test_word(bytes[..],table+4,n+1);}else if which==4 {from:=rlay_u32(bytes[0..<n],table+3*48+4);if from<0 || from>=n {return false;}bytes[from]=0;}else if which==6 {for k:0..<count {if bytes[table+k*48]==4 {bytes[table+k*48]=5;}}}
  if which!=5 && !fs_write(pack_file,cast(string)bytes[0..<n]) {return false;}if !rlay_control_sources(copy,inputs) {return false;}
  old_dir:=fs_join(directory,"legacy",paths[3][..]);new_dir:=fs_join(directory,"coax",paths[4][..]);script:=fs_join(copy,"aethyr/tests/check_render_layers.ts",paths[5][..]);profile:=ifx which==5 then "2147483647" else "7";old_argv:=[7]string.[bun,script,wasm,package,old_dir,profile,""];
  old_run:=rtq_command(old_argv[0..<6],env[0..<0],deadline,directory,"legacy-command",stdout[..],stderr[..]);new_argv:=[13]string.[observer,"--wasm",wasm,"--package",package,"--work-dir",new_dir,"--surface-root",copy,"--profile",profile,"",""];
  new_run:=rtq_command(new_argv[0..<11],env[0..<0],deadline,directory,"coax-command",stdout[..],stderr[..]);old_q:[4096]u8;new_q:[4096]u8;old_receipt:=fs_join(old_dir,"receipt.json",old_q[..]);new_receipt:=fs_join(new_dir,"receipt.json",new_q[..]);same:=old_run.started==0 && old_run.status==1 && !old_run.timed_out && new_run.started==0 && new_run.status==1 && !new_run.timed_out && rlay_control_shared(old_receipt,new_receipt) && rtq_input_add(inputs,old_receipt) && rtq_input_add(inputs,new_receipt);
  record:[4096]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],names[which]);jo_key(o[..],"legacy_exit");jo_int(o[..],old_run.status);jo_key(o[..],"coax_exit");jo_int(o[..],new_run.status);jo_key(o[..],"same_input_refusal");jo_bool(o[..],same);jo_key(o[..],"scope");jo_str(o[..],"Both original and Coax observers refuse the identical owned source/arguments and retain source identities. Stack strings and refusal phase differ and are not asserted equal. No layer GPU readback was accepted.");jo_end(o[..]);saved:=rto_saved(directory,"comparison.json",jo_text(o[..]));print("layer refusal %: %\n",names[which],same && saved);return same && saved;
}
rlay_control_assembly :: (work:string,positive:string,which:int)->bool {
  paths:[5][4096]u8;dir:=fs_join(work,ifx which==0 then "transport-short" else "transport-corrupt",paths[0][..]);parts:=fs_join(dir,"capture",paths[1][..]);if !fs_mkdir(parts) {return false;}source:=fs_join(positive,"capture/part-0.bin",paths[2][..]);target:=fs_join(parts,"part-0.bin",paths[3][..]);n:=fs_size(source);if n<1 || !rlay_copy(source,0,n-(ifx which==0 then 1 else 0),target) {return false;}
  if which==1 {data:[16777216]u8;dn:=fs_read(target,data[..]);if dn<1 {return false;}data[0]=data[0]^1;if !fs_write(target,cast(string)data[0..<dn]) {return false;}}
  output:=fs_join(dir,"layers.bin",paths[4][..]);if !fs_write(output,"previous valid output") {return false;}receipt_path:[4096]u8;bytes:[65536]u8;nodes:[8192]JvNode;d:[1]Jv;if !rtq_json_file(fs_join(positive,"capture.json",receipt_path[..]),bytes[..],nodes[..],d[..]) {return false;}capture:=jv_get(d[0],0,"capture");refused:=!rlay_assemble(dir,rlay_size(d[0],capture),d[0],capture);after:[64]u8;an:=fs_read(output,after[..]);same:=refused && an==21 && cast(string)after[0..<an]=="previous valid output";print("layer byte transport refusal %: %\n",which,same);return same;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}work_arg:=args_value(a[..],"--work-dir","");surface_arg:=args_value(a[..],"--surface-root","");wasm:=args_value(a[..],"--wasm","");package:=args_value(a[..],"--package","");bun:=args_value(a[..],"--bun","");observer:=args_value(a[..],"--observer","");positive:=args_value(a[..],"--positive","");if work_arg=="" || surface_arg=="" || wasm=="" || package=="" || bun=="" || observer=="" || positive=="" || !fs_mkdir(work_arg) {return 2;}
  buf:[4096]u8;work:=fs_realpath(work_arg,buf[..]);p:[4096]u8;if fs_exists(fs_join(work,"qualification.json",p[..])) || fs_exists(fs_join(work,"pack-magic",p[..])) {return 2;}start:=proc_now_ms();deadline:=start+720000;inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_deps(inputs[..],compiler,"aethyr/tests/render-layer-control-checks.coax",deadline,work,"tool-dependencies") {return 1;}
  self:[4096]u8;image:=gp_self(self[..]);image_hash:[64]u8;if !rtq_hash_file(image,image_hash[..]) {return 1;}for file:[7]string.[image,compiler,bun,observer,"/bin/cp",wasm,"coax/web/tool.sh"] {if !rtq_input_add(inputs[..],file) {return 1;}}path:[4096]u8;if !rtq_input_add(inputs[..],fs_join(package,"render.json",path[..])) {return 1;}
  for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {for ext:[2]string.[".c",".h"] {native:[4096]u8;nw:[1]Jo;jo_start(nw[..],native[..]);jo_put(nw[..],"coax/platform/");jo_put(nw[..],name);jo_put(nw[..],ext);if !rtq_input_add(inputs[..],jo_text(nw[..])) {return 1;}}}for file:[2]string.["capture.json","capture/part-0.bin"] {positive_path:[4096]u8;if !rtq_input_add(inputs[..],fs_join(positive,file,positive_path[..])) {return 1;}}
  passed:=0;for which:0..<7 {if proc_now_ms()>=deadline {break;}if rlay_control_one(work,surface_arg,wasm,package,bun,observer,which,inputs[..],deadline) {passed+=1;}}
  for which:0..<2 {if rlay_control_assembly(work,positive,which) {passed+=1;}}same:=rtq_inputs_match(inputs[..]);bytes:[4194304]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.layer-port-controls.v1");jo_key(o[..],"status");jo_str(o[..],ifx passed==9 && same then "passed" else "failed");jo_key(o[..],"cases");jo_int(o[..],9);jo_key(o[..],"passed");jo_int(o[..],passed);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"observer_image_sha256");jo_str(o[..],cast(string)image_hash[..]);jo_key(o[..],"inputs");root:[4096]u8;rtq_inputs_json(o[..],inputs[..],fs_cwd(root[..]));jo_key(o[..],"elapsed_ms");jo_int(o[..],proc_now_ms()-start);jo_end(o[..]);return ifx !o[0].bad && rto_saved(work,"qualification.json",jo_text(o[..])) && passed==9 && same then 0 else 1;
}
