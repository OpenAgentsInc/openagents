// Same-input original/new observer parity. Coax owns every comparison;
// the existing bounded cmp executable independently observes all raw bytes.
#import "Basic";
#load "render-layer-tools.coax";
rlay_compare_config :: (old_dir:string,new_dir:string)->bool {
  paths:[4][4096]u8;old_file:=fs_join(old_dir,"layers.bin",paths[0][..]);new_file:=fs_join(new_dir,"layers.bin",paths[1][..]);a:[16384]u8;b:[16384]u8;an:=fs_read(fs_join(old_dir,"textures.config",paths[2][..]),a[..]);bn:=fs_read(fs_join(new_dir,"textures.config",paths[3][..]),b[..]);if an<1 || bn<1 {return false;}old_text:=cast(string)a[0..<an];new_text:=cast(string)b[0..<bn];old_path:=rtq_word(old_text,6);new_path:=rtq_word(new_text,6);canonical:[4][4096]u8;
  if fs_realpath(old_path,canonical[0][..])!=fs_realpath(old_file,canonical[1][..]) || fs_realpath(new_path,canonical[2][..])!=fs_realpath(new_file,canonical[3][..]) {return false;}left:[16384]u8;right:[16384]u8;ln:=rto_replace(old_text,old_path,"<captured-layer-bytes>",left[..]);rn:=rto_replace(new_text,new_path,"<captured-layer-bytes>",right[..]);return ln>0 && ln==rn && cast(string)left[0..<ln]==cast(string)right[0..<rn];
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=4 {tool_errln("usage: render-layer-tool-checks OLD_RECEIPT NEW_RECEIPT LEGACY_SOURCE_COPY OUT_JSON");return 2;}
  old_file:=args_at(a[..],0);new_file:=args_at(a[..],1);legacy_source:=args_at(a[..],2);out_file:=args_at(a[..],3);old_bytes:[1048576]u8;new_bytes:[4194304]u8;old_nodes:[32768]JvNode;new_nodes:[65536]JvNode;old:[1]Jv;fresh:[1]Jv;
  inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}self:[4096]u8;image:=gp_self(self[..]);image_hash:[64]u8;compiler_hash:[64]u8;label:[256]u8;lw:[1]Jo;jo_start(lw[..],label[..]);jo_put(lw[..],fs_base(out_file));jo_put(lw[..],"-dependencies");
  if !rtq_deps(inputs[..],compiler,"aethyr/tests/render-layer-tool-checks.coax",proc_now_ms()+30000,fs_dir(out_file),jo_text(lw[..])) || !rtq_input_add(inputs[..],image) || !rtq_hash_file(image,image_hash[..]) || !rtq_input_add(inputs[..],compiler) || !rtq_hash_file(compiler,compiler_hash[..]) {return 1;}
  for file:[5]string.[old_file,new_file,legacy_source,"/usr/bin/cmp","coax/web/tool.sh"] {if !rtq_input_add(inputs[..],file) {return 1;}}for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {for ext:[2]string.[".c",".h"] {path:[4096]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],ext);if !rtq_input_add(inputs[..],jo_text(o[..])) {return 1;}}}
  if !rtq_json_file(old_file,old_bytes[..],old_nodes[..],old[..]) || !rtq_json_file(new_file,new_bytes[..],new_nodes[..],fresh[..]) {return 1;}
  status_equal:=jv_raw(old[0],jv_get(old[0],0,"schema"))=="aethyr.render.layer-effects.v1" && jv_raw(fresh[0],jv_get(fresh[0],0,"schema"))=="aethyr.render.layer-effects.v1" && rtq_equal(old[0],jv_get(old[0],0,"status"),fresh[0],jv_get(fresh[0],0,"status")) && rtq_equal(old[0],jv_get(old[0],0,"version"),fresh[0],jv_get(fresh[0],0,"version"));
  unchanged:=jv_kind(old[0],jv_get(old[0],0,"source_changes"))==JV_ARRAY && jv_len(old[0],jv_get(old[0],0,"source_changes"))==0 && jv_kind(fresh[0],jv_get(fresh[0],0,"source_changes"))==JV_ARRAY && jv_len(fresh[0],jv_get(fresh[0],0,"source_changes"))==0 && jv_kind(fresh[0],jv_get(fresh[0],0,"origin_finalized"))==JV_TRUE;
  source_hash:[64]u8;sources:=rtq_hash_file(legacy_source,source_hash[..]);source_found:=false;shared:=0;map:=jv_get(old[0],0,"inputs");new_map:=jv_get(fresh[0],0,"inputs");row:=old[0].nodes[map].first;source_rows:[65536]u8;sw:[1]Jo;jo_start(sw[..],source_rows[..]);jo_arr(sw[..]);
  while row!=-1 {path:=jv_key(old[0],row);hash:=jv_raw(old[0],row);actual:[64]u8;canonical:[4096]u8;name:=fs_realpath(path,canonical[..]);okay:=name!="" && rtq_hash_file(name,actual[..]) && cast(string)actual[..]==hash;
    if fs_base(path)=="check_render_layers.ts" {source_found=true;okay=okay && hash==cast(string)source_hash[..];}else {found:=false;other:=fresh[0].nodes[new_map].first;while other!=-1 {p:[4096]u8;if fs_realpath(jv_key(fresh[0],other),p[..])==name && jv_raw(fresh[0],other)==hash {found=true;break;}other=fresh[0].nodes[other].next;}okay=okay && found;shared+=1;}
    sources=sources && okay;jo_obj(sw[..]);jo_key(sw[..],"file");jo_str(sw[..],path);jo_key(sw[..],"sha256");jo_str(sw[..],hash);jo_key(sw[..],"equal");jo_bool(sw[..],okay);jo_end(sw[..]);row=old[0].nodes[row].next;
  }jo_end(sw[..]);sources=sources && source_found;
  old_status:=jv_get(old[0],0,"status");capture:=jv_get(old[0],old_status,"capture");new_status:=jv_get(fresh[0],0,"status");new_capture:=jv_get(fresh[0],new_status,"capture");count:=rlay_size(old[0],capture);paths:[2][4096]u8;old_raw:=fs_join(fs_dir(old_file),"layers.bin",paths[0][..]);new_raw:=fs_join(fs_dir(new_file),"layers.bin",paths[1][..]);oh:[64]u8;nh:[64]u8;
  raw_hashes:=count>=0 && fs_size(old_raw)==count && fs_size(new_raw)==count && rlay_hash_file(old_raw,oh[..]) && rlay_hash_file(new_raw,nh[..]) && rlay_match(old[0],capture,count,cast(string)oh[..]) && rlay_match(fresh[0],new_capture,count,cast(string)nh[..]) && cast(string)oh[..]==cast(string)nh[..];
  stdout:[4096]u8;stderr:[4096]u8;env:[1]string;argv:=[3]string.["/usr/bin/cmp",old_raw,new_raw];r:=rtq_run_raw(argv[..],env[0..<0],30000,stdout[..],stderr[..]);cmp_hash:[64]u8;raw_equal:=rtq_ok(r) && rtq_hash_file("/usr/bin/cmp",cmp_hash[..]);config_equal:=rlay_compare_config(fs_dir(old_file),fs_dir(new_file));observer_fence:=rtq_inputs_match(inputs[..]);passed:=status_equal && unchanged && sources && raw_hashes && raw_equal && config_equal && observer_fence;
  bytes:[131072]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.layer-port-parity.v1");jo_key(o[..],"status");jo_str(o[..],ifx passed then "passed" else "failed");jo_key(o[..],"stable_status_and_browser_equal");jo_bool(o[..],status_equal);jo_key(o[..],"source_fences_unchanged");jo_bool(o[..],unchanged);jo_key(o[..],"shared_sources");jo_int(o[..],shared);jo_key(o[..],"all_shared_source_hashes_equal");jo_bool(o[..],sources);jo_key(o[..],"source_rows");jo_raw(o[..],jo_text(sw[..]));jo_key(o[..],"complete_raw_bytes_equal");jo_bool(o[..],raw_equal);jo_key(o[..],"raw_hashes_match_receipts");jo_bool(o[..],raw_hashes);jo_key(o[..],"bytes_compared");jo_int(o[..],count);jo_key(o[..],"raw_sha256");jo_str(o[..],cast(string)nh[..]);jo_key(o[..],"cmp_image_sha256");jo_str(o[..],cast(string)cmp_hash[..]);jo_key(o[..],"cmp_exit");jo_int(o[..],r.status);jo_key(o[..],"texture_config_equal_except_owned_path");jo_bool(o[..],config_equal);jo_key(o[..],"scope");jo_str(o[..],"Exact stable status/browser/source observations, every raw byte and both canonical texture configurations. This does not rerun whole-realm rendering, native/CPU texture math, or claim current-main product emission.");jo_end(o[..]);
  // Append the exact observing tool and all source/native/SDK fences without
  // changing the compared legacy/current resource receipt schemas.
  base:[131072]u8;base_n:=o[0].n;for k:0..<base_n {base[k]=bytes[k];}doc:[1]Jv;nodes:[16384]JvNode;if o[0].bad || !jv_parse(doc[..],cast(string)base[0..<base_n],nodes[..]) {return 1;}jo_start(o[..],bytes[..]);jo_obj(o[..]);child:=doc[0].nodes[0].first;while child!=-1 {jo_key(o[..],jv_key(doc[0],child));jv_write(doc[0],child,o[..]);child=doc[0].nodes[child].next;}jo_key(o[..],"observer_image_sha256");jo_str(o[..],cast(string)image_hash[..]);jo_key(o[..],"compiler_sha256");jo_str(o[..],cast(string)compiler_hash[..]);jo_key(o[..],"observer_source_fence_unchanged");jo_bool(o[..],observer_fence);jo_key(o[..],"observer_inputs");root:[4096]u8;rtq_inputs_json(o[..],inputs[..],fs_cwd(root[..]));jo_end(o[..]);
  print("layer port parity: % (% bytes, % shared sources)\n",passed,count,shared);return ifx !o[0].bad && fs_write(out_file,jo_text(o[..])) && passed then 0 else 1;
}
