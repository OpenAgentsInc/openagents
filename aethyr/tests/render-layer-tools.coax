// Coax owns source identities, VPK traversal, image lists, upload ranges,
// transport/receipt admission and the native texture configuration.
#load "render-test-origin.coax";
#load "render-layer-policy.coax";
#load "../../coax/lib/crypto/sha256.coax";
RLAY_EFFECTS :: "aethyr/tests/render-layer-effects.js";
RlayImage :: struct {url:[4096]u8;un:int;file:[4096]u8;fn:int;bytes:int;hash:[64]u8;}
RlayFixture :: struct {images:[2048]RlayImage;n:int;resource:int;urls:[65536]u8;urls_n:int;packed:[262144]u8;packed_n:int;adapter:[65536]u8;adapter_n:int;}
rlay_hash_file :: (file:string,out:[]u8)->bool {
  n:=fs_size(file);if n<0 || rlay_parts(n)<0 {return false;}state:[112]u8;raw:[32]u8;chunk:[65536]u8;if sha256_init(state[..])!=SHA_OK {return false;}at:=0;
  while at<n {take:=ifx n-at<chunk.count then n-at else chunk.count;if fs_read_at(file,at,chunk[0..<take])!=take || sha256_update_checked(state[..],chunk[0..<take],false)!=SHA_OK {return false;}at+=take;}
  if sha256_final_checked(state[..],raw[..],false)!=SHA_OK {return false;}digest:S_Digest;for k:0..<8 {digest.words[k]=cb_load_be32(raw[..],k*4).value;}return S_hex(digest,out);
}
rlay_copy :: (source:string,from:int,n:int,target:string)->bool {
  if !rlay_span(from,n,fs_size(source)) || !fs_write(target,"") {return false;}at:=0;bytes:[65536]u8;while at<n {take:=ifx n-at<bytes.count then n-at else bytes.count;if fs_read_at(source,from+at,bytes[0..<take])!=take || !fs_append(target,cast(string)bytes[0..<take]) {return false;}at+=take;}return true;
}
rlay_asset_file :: (surface:string,url:string,out:[]u8)->string {
  path:=rto_path(url);if path=="" {return "";}app:[4096]u8;file:[4096]u8;root:=fs_join(surface,"apps/openagents-web",app[..]);candidate:=fs_join(root,path[1..<path.count],file[..]);canonical:=fs_realpath(candidate,out);return ifx rps_within(canonical,root) then canonical else "";
}
rlay_effect :: (c:[]Cdp,start:string,request:string,deadline:int,work:string,label:string,out:[]u8)->int {
  command:[CDP_REQ]u8;o:[1]Jo;jo_start(o[..],command[..]);jo_put(o[..],start);jo_put(o[..],"(");jo_put(o[..],request);jo_put(o[..],")");if o[0].bad {return -1;}began:=gp_evaluate(c,jo_text(o[..]));if began<0 || jv_raw(c[0].doc[0],began)!="started" {return -1;}
  while proc_now_ms()<deadline {value:=gp_evaluate(c,"renderLayerPoll()");if value<0 {return -1;}d:=c[0].doc[0];if jv_kind(d,jv_get(d,value,"done"))==JV_TRUE {
      writer:[1]Jo;jo_start(writer[..],out);if jv_kind(d,jv_get(d,value,"error"))!=JV_NULL {jv_write(d,value,writer[..]);saved:=rto_saved(work,"browser-failure.json",jo_text(writer[..]));return -1;}jv_write(d,jv_get(d,value,"value"),writer[..]);return ifx !writer[0].bad && rto_saved(work,label,jo_text(writer[..])) then writer[0].n else -1;
    }proc_sleep(100);
  }return -1;
}
rlay_plan :: (d:Jv,surface:string,work:string,fixture:[]RlayFixture,inputs:[]RtqInputs,deadline:int)->bool {
  asset_index:=rlay_asset(d);if asset_index<0 {return false;}asset:=jv_at(d,jv_get(d,0,"assets"),asset_index);fixture[0].resource=rlay_binding(d);writer:[1]Jo;jo_start(writer[..],fixture[0].urls[..]);jv_write(d,jv_get(d,asset,"urls"),writer[..]);fixture[0].urls_n=writer[0].n;if writer[0].bad {return false;}jo_start(writer[..],fixture[0].adapter[..]);jv_write(d,jv_get(d,0,"adapter"),writer[..]);fixture[0].adapter_n=writer[0].n;if writer[0].bad {return false;}
  jo_start(writer[..],fixture[0].packed[..]);jo_arr(writer[..]);urls:=jv_get(d,asset,"urls");packed_kind:=jv_kind(d,jv_get(d,asset,"packed"));if jv_kind(d,urls)!=JV_ARRAY || jv_len(d,urls)<1 || (packed_kind!=JV_TRUE && packed_kind!=JV_FALSE) {return false;}
  if packed_kind==JV_TRUE {
    url:[4096]u8;file:[4096]u8;name:=rto_string(d,jv_at(d,urls,0),url[..]);pack:=rlay_asset_file(surface,name,file[..]);if pack=="" || !rtq_input_add(inputs,pack) {return false;}
    header:[32]u8;if fs_read_at(pack,0,header[..])!=32 {return false;}head:=rlay_pack(header[..],fs_size(pack));if !head.valid {return false;}part:=jv_int(d,jv_get(d,asset,"pack_part"),-1);
    for k:0..<head.count {if proc_now_ms()>=deadline {return false;}row:[48]u8;if fs_read_at(pack,head.table+k*48,row[..])!=48 {return false;}from:=rlay_u32(row[..],4);n:=rlay_u32(row[..],8);if !rlay_span(from,n,fs_size(pack)) {return false;}if cast(int)row[0]!=part {continue;}if fixture[0].n>=2048 {return false;}
      image:RlayImage;path:[4096]u8;label:[128]u8;o:[1]Jo;jo_start(o[..],label[..]);jo_put(o[..],"images/image-");jo_int(o[..],fixture[0].n);jo_put(o[..],".bin");target:=fs_join(work,jo_text(o[..]),path[..]);if !rlay_copy(pack,from,n,target) || !rtq_hash_file(target,image.hash[..]) || !rtq_input_add(inputs,target) {return false;}
      jo_start(o[..],image.url[..]);jo_put(o[..],"/layer-images/image-");jo_int(o[..],fixture[0].n);jo_put(o[..],".bin");image.un=o[0].n;image.fn=target.count;for c,i:target {image.file[i]=c;}image.bytes=n;fixture[0].images[fixture[0].n]=image;fixture[0].n+=1;
      jo_obj(writer[..]);jo_key(writer[..],"row");jo_int(writer[..],k);jo_key(writer[..],"from");jo_int(writer[..],from);jo_key(writer[..],"bytes");jo_int(writer[..],n);jo_key(writer[..],"sha256");jo_str(writer[..],cast(string)image.hash[..]);jo_end(writer[..]);
    }
  }else {
    if jv_len(d,urls)>2048 {return false;}for k:0..<jv_len(d,urls) {image:RlayImage;image.un=jv_str(d,jv_at(d,urls,k),image.url[..]);if image.un<1 {return false;}name:=cast(string)image.url[0..<image.un];file:=rlay_asset_file(surface,name,image.file[..]);image.fn=file.count;if file=="" || !rtq_input_add(inputs,file) || !rtq_hash_file(file,image.hash[..]) {return false;}image.bytes=fs_size(file);fixture[0].images[k]=image;fixture[0].n+=1;}
  }
  jo_end(writer[..]);fixture[0].packed_n=writer[0].n;return !writer[0].bad && fixture[0].n>0 && fixture[0].resource>=0;
}
rlay_decode_request :: (fixture:[]RlayFixture,out:[]u8)->int {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"images");jo_arr(o[..]);for k:0..<fixture[0].n {image:=fixture[0].images[k];jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],cast(string)image.url[0..<image.un]);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
rlay_decode_matches :: (fixture:[]RlayFixture,d:Jv)->bool {
  images:=jv_get(d,0,"images");if jv_kind(d,images)!=JV_ARRAY || jv_len(d,images)!=fixture[0].n {return false;}for k:0..<fixture[0].n {image:=fixture[0].images[k];row:=jv_at(d,images,k);if !rlay_decoded(d,row,cast(string)image.url[0..<image.un],image.bytes,cast(string)image.hash[..]) {return false;}}return true;
}
rlay_config :: (surface:string,wasm:string,package:string,work:string,config:string)->bool {
  paths:[8][4096]u8;page:=fs_join(work,"page.html",paths[0][..]);images:=fs_join(work,"images",paths[1][..]);capture:=fs_join(work,"capture",paths[2][..]);if !fs_mkdir(images) || !fs_mkdir(capture) || !fs_write(page,"<!doctype html><title>Layer upload fixture</title>") {return false;}
  data:[65536]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.v1");jo_key(o[..],"lifetime_ms");jo_int(o[..],240000);jo_key(o[..],"routes");jo_arr(o[..]);for k:0..<5 {jo_obj(o[..]);jo_key(o[..],ifx k<2 then "url" else "prefix");jo_str(o[..],ifx k==0 then "/" else ifx k==1 then "/test.wasm" else ifx k==2 then "/layer-images/" else ifx k==3 then "/package/" else "/coaxial/");jo_key(o[..],ifx k<2 then "file" else "directory");jo_str(o[..],ifx k==0 then page else ifx k==1 then wasm else ifx k==2 then images else ifx k==3 then package else fs_join(surface,"coax/web",paths[3][..]));if k==0 {jo_key(o[..],"mime");jo_str(o[..],"text/html");}jo_end(o[..]);}
  jo_obj(o[..]);jo_key(o[..],"prefix");jo_str(o[..],"/");jo_key(o[..],"directory");jo_str(o[..],fs_join(surface,"apps/openagents-web",paths[3][..]));jo_end(o[..]);jo_end(o[..]);jo_key(o[..],"post_sinks");jo_arr(o[..]);
  for k:0..<4 {name:[128]u8;nw:[1]Jo;jo_start(nw[..],name[..]);jo_put(nw[..],"part-");jo_int(nw[..],k);jo_put(nw[..],".bin");url:[256]u8;uw:[1]Jo;jo_start(uw[..],url[..]);jo_put(uw[..],"/capture/");jo_put(uw[..],jo_text(nw[..]));jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],jo_text(uw[..]));jo_key(o[..],"root");jo_str(o[..],capture);jo_key(o[..],"file");jo_str(o[..],fs_join(capture,jo_text(nw[..]),paths[3][..]));jo_key(o[..],"max_bytes");jo_int(o[..],67108864);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && fs_write(config,jo_text(o[..]));
}
rlay_transport :: (c:[]Cdp,capture:Jv,total:int,work:string,deadline:int,inputs:[]RtqInputs)->bool {
  for k:0..<rlay_parts(total) {n:=rlay_chunk(total,k);request:[4096]u8;o:[1]Jo;jo_start(o[..],request[..]);jo_obj(o[..]);jo_key(o[..],"from");jo_int(o[..],k*67108864);jo_key(o[..],"to");jo_int(o[..],k*67108864+n);name:[128]u8;nw:[1]Jo;jo_start(nw[..],name[..]);jo_put(nw[..],"part-");jo_int(nw[..],k);jo_put(nw[..],".bin");url:[256]u8;uw:[1]Jo;jo_start(uw[..],url[..]);jo_put(uw[..],"/capture/");jo_put(uw[..],jo_text(nw[..]));jo_key(o[..],"url");jo_str(o[..],jo_text(uw[..]));jo_end(o[..]);result:[65536]u8;rn:=rlay_effect(c,"renderLayerUpload",jo_text(o[..]),deadline,work,jo_text(nw[..]),result[..]);nodes:[2048]JvNode;d:[1]Jv;if rn<1 || !jv_parse(d[..],cast(string)result[0..<rn],nodes[..]) {return false;}
    path:[4096]u8;piece:[4096]u8;dir:=fs_join(work,"capture",path[..]);file:=fs_join(dir,jo_text(nw[..]),piece[..]);hash:[64]u8;if fs_size(file)!=n || !rtq_hash_file(file,hash[..]) || !rlay_ack(d[0],jo_text(uw[..]),file,n,cast(string)hash[..]) || !rtq_input_add(inputs,file) {return false;}
  }return true;
}
rlay_assemble :: (work:string,total:int,d:Jv,capture:int)->bool {
  paths:[3][4096]u8;pending:=fs_join(work,"layers.pending",paths[0][..]);file:=fs_join(work,"layers.bin",paths[1][..]);if !fs_write(pending,"") {return false;}data:[65536]u8;
  for k:0..<rlay_parts(total) {name:[128]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],"capture/part-");jo_int(o[..],k);jo_put(o[..],".bin");part:=fs_join(work,jo_text(o[..]),paths[2][..]);n:=rlay_chunk(total,k);at:=0;while at<n {take:=ifx n-at<data.count then n-at else data.count;if fs_read_at(part,at,data[0..<take])!=take || !fs_append(pending,cast(string)data[0..<take]) {return false;}at+=take;}}
  hash:[64]u8;if !rlay_hash_file(pending,hash[..]) || !rlay_match(d,capture,fs_size(pending),cast(string)hash[..]) || !fs_rename(pending,file) {return false;}
  config:[16384]u8;o:[1]Jo;jo_start(o[..],config[..]);jo_put(o[..],"textures 1\n");jo_put(o[..],jv_raw(d,jv_get(d,capture,"name")));jo_put(o[..]," ");jo_put(o[..],jv_raw(d,jv_get(d,capture,"format")));jo_put(o[..]," ");jo_int(o[..],jv_int(d,jv_get(d,capture,"layers"),-1));jo_put(o[..]," ");levels:=jv_get(d,capture,"levels");jo_int(o[..],jv_len(d,levels));jo_put(o[..]," ");jo_put(o[..],file);jo_put(o[..],"\n");
  for k:0..<jv_len(d,levels) {row:=jv_at(d,levels,k);for key,i:[5]string.["width","height","offset","row_bytes","layer_bytes"] {if i>0 {jo_put(o[..]," ");}jo_int(o[..],jv_int(d,jv_get(d,row,key),-1));}jo_put(o[..],"\n");}return !o[0].bad && rto_saved(work,"textures.config",jo_text(o[..]));
}
