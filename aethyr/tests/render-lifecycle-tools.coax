rl_engine_observe :: (c:[]Cdp,mode:string,work:string,deadline:int,observed:[]RlObserved)->bool {
  observed[0].n[0]=rl_save(c,"renderLifecycleEngineBefore()",deadline,work,"before",observed[0].values[0][..]);
  if observed[0].n[0]<1 || rl_eval(c,ifx mode=="before" then "renderLifecycleArmEngine('compile')" else "renderLifecycleArmEngine('instantiate')",deadline)<0 || rl_eval(c,"renderLifecycleReload('first')",deadline)<0 || !rl_wait(c,"renderLifecycleEngineHeld().phase==='held'",rl_bound(deadline,60000),false) {return false;}
  observed[0].n[1]=rl_save(c,"renderLifecycleEngineHeld()",deadline,work,"held",observed[0].values[1][..]);if observed[0].n[1]<1 || rl_eval(c,"renderLifecycleReload('second')",deadline)<0 {return false;}
  if mode=="overlap" {proc_sleep(500);}else if !rl_wait(c,"renderLifecycleReloadResult('second').done",rl_bound(deadline,120000),false) {return false;}
  if rl_eval(c,"renderLifecycleReleaseEngine()",deadline)<0 || !rl_wait(c,"renderLifecycleReloadResult('first').done",rl_bound(deadline,120000),false) || !rl_wait(c,"renderLifecycleReloadResult('second').done",rl_bound(deadline,120000),false) {return false;}
  observed[0].n[2]=rl_save(c,"renderLifecycleReloadResult('first').result",deadline,work,"first",observed[0].values[2][..]);observed[0].n[3]=rl_save(c,"renderLifecycleReloadResult('second').result",deadline,work,"second",observed[0].values[3][..]);
  if rl_eval(c,"renderLifecycleStep(Infinity)",deadline)<0 {return false;}
  observed[0].n[4]=rl_save(c,"renderLifecycleEngineAfter()",deadline,work,"after",observed[0].values[4][..]);
  validation:[65536]u8;vn:=rl_save(c,"renderLifecycleValidation()",deadline,work,"validation-observation",validation[..]);vd:[1]Jv;v_nodes:[1024]JvNode;
  if vn<1 || !jv_parse(vd[..],cast(string)validation[0..<vn],v_nodes[..]) {return false;}defined:=jv_kind(vd[0],jv_get(vd[0],0,"defined"));
  if defined==JV_TRUE {v:[1]Jo;jo_start(v[..],observed[0].values[5][..]);jv_write(vd[0],jv_get(vd[0],0,"value"),v[..]);if v[0].bad {return false;}observed[0].n[5]=v[0].n;}else if defined!=JV_FALSE {return false;}
  observed[0].n[6]=rl_save(c,"renderLifecycleEvents()",deadline,work,"window-events",observed[0].values[6][..]);
  for k:0..<7 {if k!=5 && observed[0].n[k]<1 {return false;}}return true;
}
rl_media_observe :: (c:[]Cdp,work:string,deadline:int,observed:[]RlObserved)->bool {
  observed[0].n[0]=rl_save(c,"renderLifecycleMediaWaiting()",deadline,work,"waiting",observed[0].values[0][..]);if observed[0].n[0]<1 {return false;}
  d:[1]Jv;nodes:[256]JvNode;if !jv_parse(d[..],cast(string)observed[0].values[0][0..<observed[0].n[0]],nodes[..]) || !rl_kind(d[0],"present",JV_TRUE) || !rl_kind(d[0],"ready",JV_FALSE) || !rl_number(d[0],"decoded",0) {return false;}
