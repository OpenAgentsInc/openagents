  jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],jo_text(w[..]));jo_end(o[..]);installed:=cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),120000);if installed<0 {return false;}
  jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);navigated:=cdp_call(c,"Page.navigate",jo_text(o[..]),120000);if navigated<0 {return false;}
