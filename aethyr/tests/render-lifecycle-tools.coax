  observed[0].n[4]=rl_save(c,"renderLifecycleEvents()",deadline,work,"window-events",observed[0].values[4][..]);return observed[0].n[4]>0;
}
rl_pin_row :: (o:[]Jo,inputs:[]RtqInputs,path:string)->bool {hash:[64]u8;if !rl_input(inputs,path) || !rtq_hash_file(path,hash[..]) {return false;}jo_obj(o);jo_key(o,"file");jo_str(o,path);jo_key(o,"sha256");jo_str(o,cast(string)hash[..]);jo_end(o);return true;}
