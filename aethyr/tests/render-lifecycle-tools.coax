// Shared Coax orchestration for actual engine-generation and media-retirement
// observations. The origin and browser JS perform only named platform effects.
#load "render-test-origin.coax";
#load "render-lifecycle-policy.coax";
RL_EFFECTS :: "aethyr/tests/render-lifecycle-effects.js";
