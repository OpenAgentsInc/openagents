rl_input :: (inputs:[]RtqInputs,path:string)->bool {absolute:[4096]u8;name:=fs_realpath(path,absolute[..]);return name!="" && rtq_input_add(inputs,name);}
rl_eval :: (c:[]Cdp,expression:string,deadline:int)->int {
  left:=proc_left(deadline,proc_now_ms());if left<=0 {return -1;}params:[CDP_REQ]u8;o:[1]Jo;jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"expression");jo_str(o[..],expression);jo_key(o[..],"awaitPromise");jo_bool(o[..],true);jo_key(o[..],"returnByValue");jo_bool(o[..],true);jo_end(o[..]);if o[0].bad {return -1;}
  result:=cdp_call(c,"Runtime.evaluate",jo_text(o[..]),ifx left<120000 then left else 120000);if result<0 || jv_get(c[0].doc[0],result,"exceptionDetails")>=0 {return -1;}return jv_path(c[0].doc[0],result,"result.value");
}
rl_save :: (c:[]Cdp,expression:string,deadline:int,work:string,label:string,out:[]u8)->int {
