}
rl_bound :: (deadline:int,period:int)->int {next:=proc_now_ms()+period;return ifx next<deadline then next else deadline;}
rl_open :: (c:[]Cdp,url:string,media:bool,observed:[]RlObserved,deadline:int)->bool {
