  if value<0 {saved:=fs_write(file,cast(string)c[0].msg[0..<c[0].msg_n]);return -1;}w:[1]Jo;jo_start(w[..],out);jv_write(c[0].doc[0],value,w[..]);if w[0].bad || !fs_write(file,jo_text(w[..])) {return -1;}return w[0].n;
}
rl_wait :: (c:[]Cdp,condition:string,deadline:int,draw:bool)->bool {
  while proc_now_ms()<deadline {
    if draw && rl_eval(c,"renderLifecycleStep(60)",deadline)<0 {return false;}
    at:=rl_eval(c,condition,deadline);if at<0 {return false;}if jv_kind(c[0].doc[0],at)==JV_TRUE {return true;}proc_sleep(30);
