// Measured backend raster profile: all screen/clip vertex arithmetic stays
// in the actual Coax shader. The host supplies only authored test deltas.
#load "../../verse/gpu/shader.coax";
RenderRasterProbeVaryings :: struct {position:V4;value:f32;}
#test "raster probe produces the authored64 pixel triangle and unique vertex value" {
 rrp_u:=[4]f32.[0,0,0,0];
 #assert render_raster_probe_vs(0,0,rrp_u[..]).position.x== -0.75 && render_raster_probe_vs(0,0,rrp_u[..]).position.y==0.75;
 #assert render_raster_probe_vs(1,0,rrp_u[..]).position.x== -0.625 && render_raster_probe_vs(1,0,rrp_u[..]).value==0;
 #assert render_raster_probe_vs(2,0,rrp_u[..]).position.y==0.625 && render_raster_probe_vs(2,0,rrp_u[..]).value==0;
 #assert render_raster_probe_vs(0,0,rrp_u[..]).value==1;
 rrp_u[0]=1.0f32/512;
 #assert render_raster_probe_vs(0,0,rrp_u[..]).position.x== -0.75f32+1.0f32/16384;
 #assert render_raster_probe_fs(RenderRasterProbeVaryings.{value=0.25}).x==0.25;
}
render_raster_probe_vs :: (vertex:u32,instance:u32,u:[]f32)->RenderRasterProbeVaryings {
 rrp_x:=ifx vertex==1 then 12.0f32 else 8.0f32+u[0];
 rrp_y:=ifx vertex==2 then 12.0f32 else 8.0f32;
 return RenderRasterProbeVaryings.{position=v4(rrp_x/32-1,1-rrp_y/32,0.5,1),value=ifx vertex==0 then 1.0f32 else 0.0f32};
}
render_raster_probe_fs :: (rrp_v:RenderRasterProbeVaryings)->V4 {return v4(rrp_v.value,rrp_v.value,rrp_v.value,1);}
