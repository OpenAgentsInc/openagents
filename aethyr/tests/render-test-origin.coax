        off:[256]u8;on:[256]u8;ow:[1]Jo;jo_start(ow[..],off[..]);jo_put(ow[..],"/__rto/control/");jo_put(ow[..],cast(string)name[0..<n]);jo_put(ow[..],"/0");iw:[1]Jo;jo_start(iw[..],on[..]);jo_put(iw[..],"/__rto/control/");jo_put(iw[..],cast(string)name[0..<n]);jo_put(iw[..],"/1");
