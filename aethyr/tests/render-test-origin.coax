rto_final :: (s:[]RtoState,posts:[]RtoPosts,ledger:string,reason:string)->bool {
  data:[4194304]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.final.v1");jo_key(o[..],"reason");jo_str(o[..],reason);jo_key(o[..],"requests");jo_int(o[..],s[0].requests);jo_key(o[..],"served_files");jo_int(o[..],s[0].served);jo_key(o[..],"source_inputs");same:=rto_inputs(s,o[..]);jo_key(o[..],"post_attempts");jo_int(o[..],posts[0].attempts);jo_key(o[..],"post_published");jo_int(o[..],posts[0].published);jo_key(o[..],"sink_outputs");outputs:=rps_final(posts,o[..]);jo_key(o[..],"sink_outputs_unchanged");jo_bool(o[..],outputs);jo_key(o[..],"post_staging_removed");jo_bool(o[..],posts[0].clean);jo_key(o[..],"post_ledger_complete");jo_bool(o[..],posts[0].ledger_complete);passed:=rps_complete(same,outputs,posts[0].clean,posts[0].ledger_complete,reason=="requested");jo_key(o[..],"status");jo_str(o[..],ifx passed then "passed" else "failed");jo_key(o[..],"original_files_unchanged");jo_bool(o[..],same);jo_end(o[..]);return !o[0].bad && rto_saved(ledger,"final.json",jo_text(o[..])) && passed;
}
