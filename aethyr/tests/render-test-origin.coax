            if jv_raw(d[0],jv_get(d[0],v,"kind"))=="append" && rn>=0 && body_n+rn<=changed.count {for i:0..<body_n {changed[i]=body[i];}for i:0..<rn {changed[body_n+i]=replacement[i];}new_n=body_n+rn;}
