          mime=ifx declared_mime!="" then declared_mime else rto_mime(cast(string)file[0..<file_n]);
        } else {body_n=jv_str(d[0],jv_get(d[0],row,"text"),body[..]);response_known=body_n>=0;if body_n<0 {body_n=0;}mime=ifx declared_mime!="" then declared_mime else "text/plain";}
        if status==200 && file_n>0 {
