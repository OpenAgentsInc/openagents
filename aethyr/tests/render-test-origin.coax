  while okay {response=cdp_http(cast(string)data[0..<n],ended);if response.done || ended {break;}count:=cxsock_read(h,proc_left(deadline,proc_now_ms()));if count== -1 {ended=true;continue;}if count<1 || n+count>data.count {okay=false;break;}for k:0..<count {data[n+k]=cast,trunc(u8)cxsock_byte(h,k);}n+=count;}
