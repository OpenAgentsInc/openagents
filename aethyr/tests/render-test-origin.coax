rto_journal :: (s:[]RtoState,ledger:string,request:RtoHead,status:int,file:string,original:string,served:string,bytes:int,variant:string,sent:bool)->bool {
  data:[16384]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"request");jo_int(o[..],s[0].requests);jo_key(o[..],"method");jo_str(o[..],request.method);jo_key(o[..],"path");jo_str(o[..],request.path);jo_key(o[..],"status");jo_int(o[..],status);jo_key(o[..],"file");jo_str(o[..],file);jo_key(o[..],"original_sha256");jo_str(o[..],original);jo_key(o[..],"served_sha256");jo_str(o[..],served);jo_key(o[..],"bytes");jo_int(o[..],bytes);jo_key(o[..],"variant");jo_str(o[..],variant);jo_key(o[..],"sent");jo_bool(o[..],sent);jo_end(o[..]);
  return !o[0].bad && rto_append(ledger,"requests.jsonl",jo_text(o[..]));
