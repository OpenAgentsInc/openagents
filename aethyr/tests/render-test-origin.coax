  okay:=image!="";for arg:[5]string.[image,"--render-test-origin",port_file,config_file,ledger] {okay=okay && proc_arg(h,arg);}
  if !okay || !proc_quiet(h) || proc_start(h)!=0 {released:=proc_release(h);return -1;}return h;
