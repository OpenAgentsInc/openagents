// A reusable loopback fixture origin. Coax owns routes, named source variants,
// engine fetch sequences, original/served byte identities and finalization.
// Callers dispatch rto_child(args) before normal argument handling.
#load "webgpu-session.coax";
#load "../render/tests/qualification-files.coax";
#load "render-test-origin-policy.coax";
RTO_FILE :: 67108864;
RtoFile :: struct {path:[4096]u8;n:int;hash:[64]u8;}
RtoState :: struct {files:[512]RtoFile;n:int;hits:[128]int;active:[32]bool;requests:int;served:int;changed:bool;}
#load "render-test-sinks.coax";
rto_string :: (d:Jv,node:int,out:[]u8)->string {n:=jv_str(d,node,out);return ifx n<0 then "" else cast(string)out[0..<n];}
rto_prefix :: (value:string,prefix:string)->bool {return value.count>=prefix.count && value[0..<prefix.count]==prefix;}
rto_suffix :: (value:string,suffix:string)->bool {return value.count>=suffix.count && value[value.count-suffix.count..<value.count]==suffix;}
rto_saved :: (dir:string,name:string,text:string)->bool {path:[4096]u8;return fs_write(fs_join(dir,name,path[..]),text);}
rto_append :: (dir:string,name:string,text:string)->bool {path:[4096]u8;p:=fs_join(dir,name,path[..]);return fs_append(p,text) && fs_append(p,"\n");}
rto_pin :: (s:[]RtoState,path:string,hash:string)->bool {
  if path.count<1 || path.count>4096 || hash.count!=64 {return false;}
  for k:0..<s[0].n {row:=s[0].files[k];if cast(string)row.path[0..<row.n]==path {if cast(string)row.hash[..]!=hash {s[0].changed=true;return false;}return true;}}
  if s[0].n==512 {return false;}row:RtoFile;row.n=path.count;for c,i:path {row.path[i]=c;}for c,i:hash {row.hash[i]=c;}s[0].files[s[0].n]=row;s[0].n+=1;return true;
}
rto_inputs :: (s:[]RtoState,o:[]Jo)->bool {
  same:=true;jo_obj(o);for k:0..<s[0].n {row:=s[0].files[k];path:=cast(string)row.path[0..<row.n];again:[64]u8;if !rtq_hash_file(path,again[..]) || cast(string)again[..]!=cast(string)row.hash[..] {same=false;}
    jo_key(o,path);jo_str(o,cast(string)row.hash[..]);}jo_end(o);return same && !s[0].changed;
}
rto_reply :: (h:int,status:int,mime:string,body:string)->bool {
  header:[8192]u8;o:[1]Jo;jo_start(o[..],header[..]);jo_put(o[..],"HTTP/1.1 ");jo_int(o[..],status);jo_put(o[..]," ");jo_put(o[..],rto_reason(status));jo_put(o[..],"\r\nContent-Type: ");jo_put(o[..],mime);jo_put(o[..],"\r\nContent-Length: ");jo_int(o[..],body.count);jo_put(o[..],"\r\nConnection: close\r\n\r\n");
  if o[0].bad || !wp_send(h,jo_text(o[..])) {return false;}at:=0;while at<body.count {end:=ifx body.count-at>65536 then at+65536 else body.count;if !wp_send(h,body[at..<end]) {return false;}at=end;}return true;
}
rto_read_head :: (h:int,out:[]u8)->int {
  used:=0;deadline:=proc_now_ms()+5000;while proc_now_ms()<deadline {n:=cxsock_read(h,proc_left(deadline,proc_now_ms()));if n<1 || used+n>out.count {return -1;}
    for k:0..<n {out[used+k]=cast,trunc(u8)cxsock_byte(h,k);}used+=n;
    parsed:=rto_head(cast(string)out[0..<used]);if parsed.complete {return used;}if used>16384 {return -1;}
  }return -1;
}
rto_drain_body :: (h:int,head:RtoHead,received:int)->bool {
  have:=received-head.body_from;if !rto_body_span(0,have,head.length) {return false;}deadline:=proc_now_ms()+5000;
  while have<head.length {n:=cxsock_read(h,proc_left(deadline,proc_now_ms()));if n<1 || !rto_body_span(have,n,head.length) {return false;}have+=n;}return true;
