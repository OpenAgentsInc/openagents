  config_hash:[64]u8;self:[4096]u8;self_name:=gp_self(self[..]);self_hash:[64]u8;if !rtq_hash_file(config_file,config_hash[..]) || !rto_pin(s[..],config_file,cast(string)config_hash[..]) || !rtq_hash_file(self_name,self_hash[..]) || !rto_pin(s[..],self_name,cast(string)self_hash[..]) {return 2;}
