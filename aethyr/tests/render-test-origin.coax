  ready:[8192]u8;rw:[1]Jo;jo_start(rw[..],ready[..]);jo_obj(rw[..]);jo_key(rw[..],"schema");jo_str(rw[..],"aethyr.render-test-origin.ready.v1");jo_key(rw[..],"port");jo_int(rw[..],port);jo_key(rw[..],"config_sha256");jo_str(rw[..],cast(string)config_hash[..]);jo_key(rw[..],"image_sha256");jo_str(rw[..],cast(string)self_hash[..]);jo_key(rw[..],"lifetime_ms");jo_int(rw[..],life);jo_key(rw[..],"POST_supported");jo_bool(rw[..],posts[0].n>0);jo_key(rw[..],"declared_POST_sinks");jo_int(rw[..],posts[0].n);jo_end(rw[..]);
