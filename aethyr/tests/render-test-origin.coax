            if !s[0].active[k] {continue;}v:=jv_at(d[0],variants,k);vurl:[4096]u8;vp:[4096]u8;ext:[128]u8;
            u:=rto_string(d[0],jv_get(d[0],v,"url"),vurl[..]);p:=rto_string(d[0],jv_get(d[0],v,"prefix"),vp[..]);e:=rto_string(d[0],jv_get(d[0],v,"extension"),ext[..]);
            if !((u!="" && u==head.path) || (p!="" && rto_prefix(head.path,p) && rto_suffix(head.path,e))) {continue;}
            changed:[RTO_FILE]u8;needle:[65536]u8;replacement:[65536]u8;nn:=jv_str(d[0],jv_get(d[0],v,"needle"),needle[..]);rn:=jv_str(d[0],jv_get(d[0],v,"replacement"),replacement[..]);new_n:=-1;
