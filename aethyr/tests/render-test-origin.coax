rto_child :: (a:[]Args)->int {if args_at(a,0)!="--render-test-origin" {return -1;}if args_count(a)!=4 {return 2;}return rto_serve(args_at(a,1),args_at(a,2),args_at(a,3));}
rto_get :: (port:int,path:string)->bool {
