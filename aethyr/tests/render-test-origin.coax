  deadline:=proc_now_ms()+life;finished:=false;passed:=false;
  while proc_now_ms()<deadline {
    h:=cxsock_accept(listener,ifx proc_left(deadline,proc_now_ms())>1000 then 1000 else proc_left(deadline,proc_now_ms()));if h<0 {continue;}
    request:[65536]u8;count:=rto_read_head(h,request[..]);head:RtoHead;if count>0 {head=rto_head(cast(string)request[0..<count]);}s[0].requests+=1;
    status:=404;mime:="text/plain";mime_storage:[256]u8;file:[4096]u8;file_n:=0;body:[RTO_FILE]u8;body_n:=0;response_known:=false;original:[64]u8;original_known:=false;served:[64]u8;variant_name:[1024]u8;variant_n:=0;
