// Actual bounded binary uploads and refusal/recovery on the fixture origin.
// The same Coax image is both the checker and its loopback server child.
#import "Basic";
#load "render-test-origin.coax";
RpsTool :: struct {dir:[4096]u8;dn:int;port:int;rows:int;passed:int;old_hash:[64]u8;target:[4096]u8;tn:int;source:[4096]u8;sn:int;}
rps_tool_note :: (s:[]RpsTool,name:string,okay:bool)->bool {
  bytes:[4096]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],name);jo_key(o[..],"passed");jo_bool(o[..],okay);jo_end(o[..]);saved:=!o[0].bad && rto_append(cast(string)s[0].dir[0..<s[0].dn],"cases.jsonl",jo_text(o[..]));s[0].rows+=1;if okay && saved {s[0].passed+=1;}print("POST sink %: %\n",name,okay && saved);return okay && saved;
}
rps_tool_connect :: (port:int)->int {for c:"127.0.0.1" {pushed:=cxsock_host_push(cast(int)c);}return cxsock_connect(port,5000);}
rps_tool_response :: (h:int,out:[]u8)->CdpHttp {
  n:=0;ended:=false;deadline:=proc_now_ms()+5000;response:CdpHttp;
  while true {response=cdp_http(cast(string)out[0..<n],ended);if response.done || ended {break;}got:=cxsock_read(h,proc_left(deadline,proc_now_ms()));if got== -1 {ended=true;continue;}if got<1 || got>out.count-n {return CdpHttp.{status= -1};}for k:0..<got {out[n+k]=cast,trunc(u8)cxsock_byte(h,k);}n+=got;}
  return ifx response.done then response else CdpHttp.{status= -1};
}
rps_tool_request :: (port:int,text:string)->int {h:=rps_tool_connect(port);if h<0 {return -1;}okay:=wp_send(h,text);response:[16384]u8;r:=ifx okay then rps_tool_response(h,response[..]) else CdpHttp.{status= -1};closed:=cxsock_close(h);return r.status;}
rps_tool_ack :: (text:string,path:string,data:[]u8,published:bool)->bool {
  d:[1]Jv;nodes:[512]JvNode;if !jv_parse(d[..],text,nodes[..]) || jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.render-test-origin.post.v1" || jv_raw(d[0],jv_get(d[0],0,"path"))!=path || jv_kind(d[0],jv_get(d[0],0,"published"))!=(ifx published then JV_TRUE else JV_FALSE) || jv_int(d[0],jv_get(d[0],0,"declared_bytes"),-1)!=data.count || jv_int(d[0],jv_get(d[0],0,"received_bytes"),-1)!=data.count || jv_kind(d[0],jv_get(d[0],0,"staging_removed"))!=JV_TRUE {return false;}
  if !published {return jv_int(d[0],jv_get(d[0],0,"stored_bytes"),0)== -1 && jv_raw(d[0],jv_get(d[0],0,"sha256"))=="" && jv_int(d[0],jv_get(d[0],0,"status"),0)==503;}
  hash:[64]u8;return S_hex(S_hash(cast(string)data),hash[..]) && jv_raw(d[0],jv_get(d[0],0,"sha256"))==cast(string)hash[..] && jv_int(d[0],jv_get(d[0],0,"stored_bytes"),-1)==data.count && jv_int(d[0],jv_get(d[0],0,"status"),0)==200;
}
rps_tool_header :: (path:string,length:int,out:[]u8)->string {
  o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"POST ");jo_put(o[..],path);jo_put(o[..]," HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: ");jo_int(o[..],length);jo_put(o[..],"\r\nConnection: close\r\n\r\n");return ifx o[0].bad then "" else jo_text(o[..]);
}
rps_tool_old :: (s:[]RpsTool)->bool {hash:[64]u8;return rtq_hash_file(cast(string)s[0].target[0..<s[0].tn],hash[..]) && cast(string)hash[..]==cast(string)s[0].old_hash[..];}
rps_tool_staging :: (parent:string,out:[]u8)->string {
  deadline:=proc_now_ms()+3000;while proc_now_ms()<deadline {l:[1]FsList;n:=fs_list(parent,l[..]);for k:0..<n {name:=fs_entry(l[..],k);if rto_prefix(name,".rto-post.") {path:[4096]u8;p:=fs_join(parent,name,path[..]);file:=fs_join(p,"body.pending",out);if fs_size(file)>0 {return file;}}}proc_sleep(10);}return "";
}
rps_tool_upload :: (s:[]RpsTool,path:string,data:[]u8,write_fault:bool)->bool {
  h:=rps_tool_connect(s[0].port);if h<0 {return false;}header:[1024]u8;okay:=wp_send(h,rps_tool_header(path,data.count,header[..]));first:=ifx data.count>0 then 1 else 0;if okay && first>0 {okay=wp_send(h,cast(string)data[0..<first]);}
  pending:[4096]u8;staging:="";if first>0 {staging=rps_tool_staging(fs_dir(cast(string)s[0].target[0..<s[0].tn]),pending[..]);okay=okay && staging!="" && rps_tool_old(s);}
  if write_fault && okay {env:[1]string;out:[4096]u8;err:[4096]u8;argv:=[3]string.["/bin/chmod","0400",staging];r:=rtq_run_raw(argv[..],env[0..<0],5000,out[..],err[..]);okay=rtq_ok(r);}
  at:=first;while okay && at<data.count {end:=ifx data.count-at>32768 then at+32768 else data.count;okay=wp_send(h,cast(string)data[at..<end]);at=end;}
  response:[16384]u8;r:=ifx okay then rps_tool_response(h,response[..]) else CdpHttp.{status= -1};closed:=cxsock_close(h);return okay && r.status==(ifx write_fault then 503 else 200) && rps_tool_ack(cast(string)response[r.from..<r.to],path,data,!write_fault);
}
rps_tool_expired :: (dir:string)->bool {
  listener:=cxsock_listen(0);if listener<0 {return false;}client:=rps_tool_connect(cxsock_port(listener));server:=cxsock_accept(listener,5000);if client<0 || server<0 {return false;}body:=[3]u8.[0,255,0];sent:=wp_send(client,cast(string)body[..]);p:[4096]u8;file:=fs_join(dir,"expired-body.bin",p[..]);written:=fs_write(file,"previous");r:=rps_receive(server,3,"",file,proc_now_ms());queued:=cxsock_read(server,0);same:=queued==3;for k:0..<3 {same=same && cxsock_byte(server,k)==cast(int)body[k];}bytes:[32]u8;n:=fs_read(file,bytes[..]);a:=cxsock_close(client);b:=cxsock_close(server);c:=cxsock_close(listener);return sent && written && !r.framed && !r.written && r.received==0 && r.reason=="body-deadline" && same && n==8 && cast(string)bytes[0..<n]=="previous";
}
rps_tool_post_ledger :: (ledger:string)->bool {
  bytes:[131072]u8;p:[4096]u8;n:=fs_read(fs_join(ledger,"post-sinks.jsonl",p[..]),bytes[..]);if n<1 {return false;}text:=cast(string)bytes[0..<n];at:=0;row:=0;
  lengths:=[10]int.[131329,0,131330,2,1,3,3,5,10,3];received:=[10]int.[131329,0,1,3,1,3,3,3,3,3];statuses:=[10]int.[200,200,400,400,400,404,404,400,400,503];
  while at<text.count {end:=rtq_find(text,"\n",at);if end<0 || row>=10 {return false;}d:[1]Jv;nodes:[512]JvNode;if !jv_parse(d[..],text[at..<end],nodes[..]) || jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.render-test-origin.post.v1" || jv_int(d[0],jv_get(d[0],0,"attempt"),-1)!=row+1 || jv_int(d[0],jv_get(d[0],0,"declared_bytes"),-1)!=lengths[row] || jv_int(d[0],jv_get(d[0],0,"received_bytes"),-1)!=received[row] || jv_int(d[0],jv_get(d[0],0,"status"),-1)!=statuses[row] || jv_kind(d[0],jv_get(d[0],0,"published"))!=(ifx row<2 then JV_TRUE else JV_FALSE) || jv_kind(d[0],jv_get(d[0],0,"staging_removed"))!=JV_TRUE {return false;}
    expected:=ifx row==0 then "61c0c0466fcd918bb0f0bd8b284104bad17a1ff70f98540abdc05232f0fa53ff" else ifx row==1 then "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" else "";
    if jv_raw(d[0],jv_get(d[0],0,"sha256"))!=expected || jv_int(d[0],jv_get(d[0],0,"stored_bytes"),-2)!=(ifx row<2 then lengths[row] else -1) {return false;}row+=1;at=end+1;
  }return row==10;
}
rps_tool_config :: (s:[]RpsTool,config:string,root:string,target:string,url:string,cap:int,source_route:bool)->bool {
  bytes:[16384]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.v1");jo_key(o[..],"lifetime_ms");jo_int(o[..],120000);jo_key(o[..],"routes");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],"/source.bin");jo_key(o[..],"file");jo_str(o[..],cast(string)s[0].source[0..<s[0].sn]);jo_end(o[..]);if source_route {jo_obj(o[..]);jo_key(o[..],"prefix");jo_str(o[..],"/served/");jo_key(o[..],"directory");jo_str(o[..],root);jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"pins");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],cast(string)s[0].source[0..<s[0].sn]);hash:[64]u8;if !rtq_hash_file(cast(string)s[0].source[0..<s[0].sn],hash[..]) {return false;}jo_key(o[..],"sha256");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);jo_end(o[..]);jo_key(o[..],"post_sinks");jo_arr(o[..]);
  for k:0..<2 {jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],ifx k==0 then url else "/capture/empty.bin");jo_key(o[..],"root");jo_str(o[..],root);jo_key(o[..],"file");if k==0 {jo_str(o[..],target);}else {p:[4096]u8;jo_str(o[..],fs_join(root,"empty.bin",p[..]));}jo_key(o[..],"max_bytes");jo_int(o[..],ifx k==0 then cap else 0);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && fs_write(config,jo_text(o[..]));
}
rps_tool_bad_config :: (s:[]RpsTool,name:string,root:string,target:string,url:string,cap:int,source_route:bool)->bool {
  dir:[4096]u8;config:[4096]u8;port:[4096]u8;ledger:[4096]u8;work:=fs_join(cast(string)s[0].dir[0..<s[0].dn],name,dir[..]);if !fs_mkdir(work) {return false;}cfg:=fs_join(work,"config.json",config[..]);pf:=fs_join(work,"port",port[..]);ld:=fs_join(work,"ledger",ledger[..]);if !rps_tool_config(s,cfg,root,target,url,cap,source_route) {return false;}h:=rto_start(pf,cfg,ld);if h<0 {return false;}status:=proc_wait(h,5000);if status==PROC_RUNNING {killed:=proc_kill(h,PROC_SIGKILL);status=proc_wait(h,5000);}released:=proc_release(h);return status==2 && !fs_exists(pf) && rps_tool_old(s);
