// Actual RFC6455 opening, bounded idle ownership, control frames and cleanup.
#import "Basic";
#load "render-test-origin.coax";
RwsTool :: struct {dir:string;port:int;cases:int;passed:int;}
rws_note :: (s:[]RwsTool,name:string,okay:bool)->bool {bytes:[2048]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);jo_key(o[..],"case");jo_str(o[..],name);jo_key(o[..],"passed");jo_bool(o[..],okay);jo_end(o[..]);saved:=!o[0].bad && rto_append(s[0].dir,"cases.jsonl",jo_text(o[..]));s[0].cases+=1;if okay && saved {s[0].passed+=1;}print("idle websocket %: %\n",name,okay && saved);return okay && saved;}
rws_connect :: (port:int)->int {for c:"127.0.0.1" {pushed:=cxsock_host_push(cast(int)c);}return cxsock_connect(port,5000);}
rws_read_header :: (h:int,out:[]u8)->int {n:=0;until:=proc_now_ms()+5000;while proc_now_ms()<until {got:=cxsock_read(h,proc_left(until,proc_now_ms()));if got<1 || got>out.count-n {return -1;}for k:0..<got {out[n+k]=cast,trunc(u8)cxsock_byte(h,k);}n+=got;if rtq_find(cast(string)out[0..<n],"\r\n\r\n",0)>=0 {return n;}}return -1;}
rws_open :: (port:int,path:string,version:string,key:string,out:[]u8)->int {
  h:=rws_connect(port);if h<0 {return -1;}data:[2048]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_put(o[..],"GET ");jo_put(o[..],path);jo_put(o[..]," HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: ");jo_put(o[..],version);jo_put(o[..],"\r\nSec-WebSocket-Key: ");jo_put(o[..],key);jo_put(o[..],"\r\n\r\n");if o[0].bad || !wp_send(h,jo_text(o[..])) {closed:=cxsock_close(h);return -1;}n:=rws_read_header(h,out);if n<1 {closed:=cxsock_close(h);return -1;}return h;
}
rws_control :: (h:int,op:int,payload:string,wanted:int)->bool {
  data:[256]u8;mask:=[4]u8.[1,2,3,4];n:=ws_frame_write(op,true,payload,mask[..],data[..]);if n<1 || !wp_send(h,cast(string)data[0..<n]) {return false;}got:=cxsock_read(h,5000);if got<2 || got>data.count {return false;}for k:0..<got {data[k]=cast,trunc(u8)cxsock_byte(h,k);}return data[0]==cast(u8)(128+wanted) && data[1]==cast(u8)(ifx wanted==WS_OP_CLOSE then 2 else payload.count) && (wanted==WS_OP_CLOSE || cast(string)data[2..<got]==payload);
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}child:=rto_child(a[..]);if child>=0 {return child;}if args_count(a[..])!=1 || !fs_mkdir(args_at(a[..],0)) {return 2;}paths:[8][4096]u8;dir:=fs_realpath(args_at(a[..],0),paths[0][..]);if fs_exists(fs_join(dir,"qualification.json",paths[1][..])) {return 2;}s:[1]RwsTool;s[0].dir=dir;inputs:[1]RtqInputs;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if compiler=="" {compiler="coax/bin/coax";}if !rtq_input_add(inputs[..],compiler) || !rtq_deps(inputs[..],compiler,"aethyr/tests/render-test-websocket-tool-checks.coax",proc_now_ms()+30000,dir,"tool-dependencies") {return 1;}
  self:[4096]u8;image:=gp_self(self[..]);image_hash:[64]u8;if !rtq_input_add(inputs[..],image) || !rtq_hash_file(image,image_hash[..]) || !rtq_input_add(inputs[..],"coax/web/tool.sh") {return 1;}for name:[7]string.["tool-native","process-native","store-file-native","read-file-native","socket-native","entropy-native","entropy-foreign"] {for ext:[2]string.[".c",".h"] {p:[4096]u8;o:[1]Jo;jo_start(o[..],p[..]);jo_put(o[..],"coax/platform/");jo_put(o[..],name);jo_put(o[..],ext);if !rtq_input_add(inputs[..],jo_text(o[..])) {return 1;}}}
  cfg:=fs_join(dir,"config.json",paths[1][..]);port_file:=fs_join(dir,"port",paths[2][..]);ledger:=fs_join(dir,"ledger",paths[3][..]);if !fs_write(cfg,"{\"schema\":\"aethyr.render-test-origin.v1\",\"lifetime_ms\":120000,\"routes\":[{\"url\":\"/\",\"text\":\"unchanged GET\"}],\"idle_websockets\":[\"/coaxial/live\"]}") || !rto_saved(dir,"cases.jsonl","") {return 1;}server:=rto_start(port_file,cfg,ledger);if server<0 {return 1;}text:[32]u8;pn:=-1;for attempt:0..<100 {pn=fs_read(port_file,text[..]);if pn>0 {break;}proc_sleep(20);}s[0].port=ifx pn>0 then args_whole(cast(string)text[0..<pn]) else -1;if s[0].port<1 {return 1;}okay:=rws_note(s[..],"GET remains available",rto_get(s[0].port,"/"));
  response:[4096]u8;h:=rws_open(s[0].port,"/coaxial/live","13","dGhlIHNhbXBsZSBub25jZQ==",response[..]);okay=rws_note(s[..],"actual RFC6455 accept digest and101",h>=0 && cast(string)response[0..<12]=="HTTP/1.1 101" && rtq_find(cast(string)response[..],"s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",0)>0) && okay;
  binary:=[3]u8.[0,255,0];okay=rws_note(s[..],"masked binary ping yields exact NUL-safe pong",rws_control(h,WS_OP_PING,cast(string)binary[..],WS_OP_PONG)) && okay;close:=[2]u8.[3,232];okay=rws_note(s[..],"client close receives server close",rws_control(h,WS_OP_CLOSE,cast(string)close[..],WS_OP_CLOSE)) && okay;closed:=cxsock_close(h);
  for k:0..<3 {bad:=rws_open(s[0].port,ifx k==0 then "/unknown" else "/coaxial/live",ifx k==1 then "12" else "13",ifx k==2 then "bad" else "dGhlIHNhbXBsZSBub25jZQ==",response[..]);want:=ifx k==0 then "HTTP/1.1 404" else "HTTP/1.1 400";okay=rws_note(s[..],ifx k==0 then "unknown websocket route404" else ifx k==1 then "wrongversion400" else "malformedkey400",bad>=0 && cast(string)response[0..<12]==want) && okay;if bad>=0 {closed=cxsock_close(bad);}}
  h=rws_open(s[0].port,"/coaxial/live","13","dGhlIHNhbXBsZSBub25jZQ==",response[..]);unmasked:=[2]u8.[0x89,0];sent:=h>=0 && wp_send(h,cast(string)unmasked[..]);got:=ifx sent then cxsock_read(h,5000) else -1;okay=rws_note(s[..],"unmasked client control closes1002",got==4 && cxsock_byte(h,0)==136 && cxsock_byte(h,2)==3 && cxsock_byte(h,3)==234) && okay;if h>=0 {closed=cxsock_close(h);}
  owners:[8]int;for k:0..<8 {owners[k]=rws_open(s[0].port,"/coaxial/live","13","dGhlIHNhbXBsZSBub25jZQ==",response[..]);okay=rws_note(s[..],"bounded idle owner",owners[k]>=0 && cast(string)response[0..<12]=="HTTP/1.1 101") && okay;}extra:=rws_open(s[0].port,"/coaxial/live","13","dGhlIHNhbXBsZSBub25jZQ==",response[..]);okay=rws_note(s[..],"ninth idle peer refused503",extra>=0 && cast(string)response[0..<12]=="HTTP/1.1 503") && okay;if extra>=0 {closed=cxsock_close(extra);}
  finalized:=rto_finalize(s[0].port);status:=proc_wait(server,5000);if status==PROC_RUNNING {killed:=proc_kill(server,PROC_SIGKILL);status=proc_wait(server,5000);}released:=proc_release(server);all_closed:=true;for k:0..<8 {n:=cxsock_read(owners[k],5000);all_closed=all_closed && n==4 && cxsock_byte(owners[k],0)==136 && cxsock_byte(owners[k],2)==3 && cxsock_byte(owners[k],3)==233;closed=cxsock_close(owners[k]);}
  d:[1]Jv;nodes:[1024]JvNode;bytes:[65536]u8;wsfinal:=fs_join(ledger,"websockets-final.json",paths[4][..]);joined:=rtq_json_file(wsfinal,bytes[..],nodes[..],d[..]) && jv_int(d[0],jv_get(d[0],0,"opened"),-1)==10 && jv_int(d[0],jv_get(d[0],0,"closed"),-1)==10 && jv_int(d[0],jv_get(d[0],0,"active"),-1)==0 && jv_raw(d[0],jv_get(d[0],0,"status"))=="passed";okay=rws_note(s[..],"all owned peers close1001 on finalization and exact ledger counts",finalized && status==0 && all_closed && joined && rto_add_inputs(ledger,inputs[..])) && okay;okay=okay && rtq_inputs_match(inputs[..]) && s[0].cases==s[0].passed;
  record:[4194304]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render-test-origin.idle-websocket-controls.v1");jo_key(o[..],"status");jo_str(o[..],ifx okay then "passed" else "failed");jo_key(o[..],"cases");jo_int(o[..],s[0].cases);jo_key(o[..],"passed");jo_int(o[..],s[0].passed);jo_key(o[..],"observer_image_sha256");jo_str(o[..],cast(string)image_hash[..]);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],rtq_inputs_match(inputs[..]));jo_end(o[..]);return ifx !o[0].bad && rto_saved(dir,"qualification.json",jo_text(o[..])) && okay then 0 else 1;
}
