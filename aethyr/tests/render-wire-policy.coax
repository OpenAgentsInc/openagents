// Native facade qualification controls. An absent/timed-out process is never
// a killed loss control, and each source replacement must be unique.
#authority;
#test "wire process outcomes distinguish a real negative from a broken runner" {
  #assert rw_outcome(0, 0, false, false, false);
  #assert rw_outcome(0, 134, false, false, true);
  #assert !rw_outcome(0, 0, false, false, true);
  #assert !rw_outcome(0, 1, false, false, false);
  #assert !rw_outcome(0, -1, false, false, true);
  for negative: [2] bool.[false, true] {
    #assert !rw_outcome(2, 1, false, false, negative);
    #assert !rw_outcome(0, 1, true, false, negative);
    #assert !rw_outcome(0, 1, false, true, negative);
  }
}
#test "wire source controls replace exactly one complete occurrence" {
  out: [32] u8;
  #assert rw_replace("abc", "b", "XX", out[..]) == "aXXc";
  #assert rw_replace("abc", "a", "X", out[..]) == "Xbc";
  #assert rw_replace("abc", "c", "", out[..]) == "ab";
  #assert rw_replace("abc", "abc", "abc", out[0..<3]) == "abc";
  #assert rw_replace("abc", "abc", "xxxx", out[0..<3]) == "";
  #assert rw_replace("aba", "a", "x", out[..]) == "";
  #assert rw_replace("abc", "x", "x", out[..]) == "";
  #assert rw_replace("abc", "", "x", out[..]) == "";
  #assert rw_replace("aaa", "aa", "x", out[..]) == "";
}
rw_outcome :: (started: int, status: int, timed_out: bool, cut: bool, negative: bool) -> bool #export_c {
  return started == 0 && status >= 0 && !timed_out && !cut && (ifx negative then status != 0 else status == 0);
}
rw_replace :: (source: string, needle: string, replacement: string, out: [] u8) -> string #export_c {
  if needle.count == 0 { return ""; }
  found := -1;
  for i: 0..<source.count - needle.count + 1 {
    if source[i..<i + needle.count] == needle {
      if found != -1 { return ""; }
      found = i;
    }
  }
  if found < 0 || source.count - needle.count + replacement.count > out.count { return ""; }
  at := 0;
  for i: 0..<found { out[at] = source[i]; at += 1; }
  for c: replacement { out[at] = c; at += 1; }
  for i: found + needle.count..<source.count { out[at] = source[i]; at += 1; }
  return cast(string) out[0..<at];
}
