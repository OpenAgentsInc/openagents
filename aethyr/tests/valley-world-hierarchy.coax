// Fixture construction stays outside the production format reader.
#test "hierarchy admission helper boundaries are exact and independent" {
 #assert wh_room(32) && wh_room(33554432) && !wh_room(31) && !wh_room(33554433);
 #assert wh_counts(1,1,1) && wh_counts(512,262144,32768);
 #assert !wh_counts(0,1,1) && !wh_counts(513,1,1) && !wh_counts(1,0,1) && !wh_counts(1,262145,1) && !wh_counts(1,1,0) && !wh_counts(1,1,32769);
 #assert wh_shape(12,3,15,4,1,4,1,4,5) && wh_shape(12,9,21,4,5,8,3,4,9);
 #assert !wh_shape(12,4,20,4,1,4,1,4,5) && !wh_shape(12,3,15,4,1,4,0,4,5) && !wh_shape(12,3,15,4,1,4,1,3,5) && !wh_shape(12,3,15,4,1,4,1,4,4);
 #assert wh_leaf(12,372,12,4294967295,4294967295,0,64) && wh_leaf(12,3,12,4294967295,4294967295,0,1);
 #assert !wh_leaf(12,373,12,4294967295,4294967295,0,64) && !wh_leaf(12,3,12,4294967295,4294967295,0,0) && !wh_leaf(12,3,12,4294967295,4294967295,0,65);
 #assert wh_children(4,4,4,5,0) && !wh_children(3,4,4,5,0) && !wh_children(4,3,4,5,0) && !wh_children(5,4,4,5,0) && !wh_children(4,5,4,5,0);
 #assert wh_range(12,3,12,3) && !wh_range(11,3,12,6) && !wh_range(12,4,12,6) && !wh_range(12,3,12,2);
 #assert wh_partition(12,9,12,3,15,6) && !wh_partition(12,9,11,3,15,6) && !wh_partition(12,9,12,3,14,6) && !wh_partition(12,9,12,3,15,3);
 #assert wh_height(2,2)==3 && wh_height(1,2)==3 && wh_height(3,2)==4;
 #assert wh_complete(21,21,12,12,9,9) && !wh_complete(20,21,12,12,9,9) && !wh_complete(21,21,11,12,9,9) && !wh_complete(21,21,12,12,8,9);
 low:=v3(-2,-3,-4);high:=v3(2,3,4);#assert wh_encloses(low,high,low,high);
 for axis:0..<3 {a:=low;b:=high;if axis==0 {a.x-=1;b.x+=1;}if axis==1 {a.y-=1;b.y+=1;}if axis==2 {a.z-=1;b.z+=1;}#assert !wh_encloses(low,high,a,high) && !wh_encloses(low,high,low,b);}
}
#test "hierarchy admits a second independent model and visits every transform lane" {
 b:[480]u8;small:[252]u8;wh_fixture(small[..]);for k:0..<32 {b[k]=small[k];}scan_put(b[..],8,2);scan_put(b[..],12,4);scan_put(b[..],16,4);scan_put(b[..],24,80);scan_put(b[..],28,272);
 for k:0..<24 {b[32+k]=small[32+k];}for value,k:[6]u32.[30,3,3,1,3,1] {scan_put(b[..],56+k*4,value);}
 for k:0..<144 {b[80+k]=small[56+k];}for k:0..<48 {b[224+k]=small[56+k];}scan_put(b[..],224,30);
 for k:0..<4 {scan_put(b[..],272+k*52,cast(u32)(k%2));for j:0..<12 {scan_put(b[..],276+k*52+j*4,f32_bits(cast(f32)(j+1)/8));}}
 #assert wh_valid(b[..],4,100);
 source:[16]u32;for k:0..<4 {source[k*4]=cast(u32)(ifx k%2==0 then 12 else 30);source[k*4+1]=cast(u32)(ifx k%2==0 then 6 else 3);source[k*4+2]=cast(u32)(k+3);source[k*4+3]=1;}
 #assert wh_bindings(b[..],source[..]) && !wh_bindings(b[..],source[0..<15]) && !wh_bindings(b[..],source[0..<12]);
 for k:0..<4 {for lane:0..<2 {source[k*4+lane]^=1;#assert !wh_bindings(b[..],source[..]);source[k*4+lane]^=1;}}
 for k:0..<4 {for j:0..<12 {at:=276+k*52+j*4;old:=scan_u32(b[..],at);scan_put(b[..],at,0x7fc00000);#assert !wh_valid(b[..],4,100);scan_put(b[..],at,old);}}
 scan_put(b[..],232,2);#assert !wh_valid(b[..],4,100);
}
#test "hierarchy validates unequal nested bounds and every internal source partition" {
 b:[348]u8;
 for value,k:[8]u32.[0x31485756,1,1,5,1,32,56,296] {scan_put(b[..],k*4,value);}
 for value,k:[6]u32.[12,18,0,5,4,3] {scan_put(b[..],32+k*4,value);}
 for k:0..<5 {p:=56+k*48;first:=[5]int.[12,15,21,12,12][k];count:=[5]int.[3,6,9,9,18][k];scan_put(b[..],p,cast(u32)first);scan_put(b[..],p+4,cast(u32)count);scan_put(b[..],p+8,[5]u32.[0xffffffff,0xffffffff,0xffffffff,0,3][k]);scan_put(b[..],p+12,[5]u32.[0xffffffff,0xffffffff,0xffffffff,1,2][k]);scan_put(b[..],p+40,[5]u32.[0,0,0,1,2][k]);scan_put(b[..],p+44,ifx k<3 then 3 else 0);
  a:=[5]Point.[v3(-7,-3,-2),v3(-3,-8,-4),v3(-4,-2,-9),v3(-7,-8,-4),v3(-7,-8,-9)][k];z:=[5]Point.[v3(6,2,1),v3(2,7,3),v3(3,1,8),v3(6,7,3),v3(6,7,8)][k];scan_write_point(b[..],p+16,a);scan_write_point(b[..],p+28,z);
 }
 for k:0..<3 {scan_put(b[..],300+(k*4+k)*4,f32_bits(1));}#assert wh_valid(b[..],1,100);
 for k:0..<5 {for axis:0..<3 {p:=56+k*48;at:=p+16+axis*4;old:=scan_u32(b[..],at);scan_put(b[..],at,f32_bits(99));#assert !wh_valid(b[..],1,100);scan_put(b[..],at,old);}}
 // Each child owns a distinct extremum. Shrinking its parent excludes only that child.
 for at:[12]int.[216,220,224,228,232,236,264,268,272,276,280,284] {old:=scan_float(b[..],at);scan_put(b[..],at,f32_bits(old*0.5));#assert !wh_valid(b[..],1,100);scan_put(b[..],at,f32_bits(old));}
 for at:[4]int.[200,204,208,212] {old:=scan_u32(b[..],at);scan_put(b[..],at,old^3);#assert !wh_valid(b[..],1,100);scan_put(b[..],at,old);}
 scan_put(b[..],204,12);#assert !wh_valid(b[..],1,100);scan_put(b[..],204,9);
 scan_put(b[..],52,2);scan_put(b[..],44,3);scan_put(b[..],48,2);#assert !wh_valid(b[..],1,100);
}
#test "hierarchy rejects orphan nodes and incomplete root coverage without other malformed fields" {
 b:[300]u8;s:[252]u8;wh_fixture(s[..]);for k:0..<200 {b[k]=s[k];}for k:0..<52 {b[248+k]=s[200+k];}scan_put(b[..],12,4);scan_put(b[..],28,248);#assert !wh_valid(b[..],1,100);
 wh_fixture(s[..]);scan_put(s[..],36,9);#assert !wh_valid(s[..],1,100);
 wh_fixture(s[..]);scan_put(s[..],72,f32_bits(2));#assert !wh_valid(s[..],1,100);
}
wh_fixture :: (b:[]u8) #effects(all) {
 for v,k:[8]u32.[0x31485756,1,1,3,1,32,56,200] {scan_put(b,k*4,v);}
 for v,k:[6]u32.[12,6,0,3,2,2] {scan_put(b,32+k*4,v);}
 for k:0..<3 {at:=56+k*48;scan_put(b,at,cast(u32)(ifx k==1 then 15 else 12));scan_put(b,at+4,cast(u32)(ifx k==2 then 6 else 3));scan_put(b,at+8,ifx k==2 then 0 else 0xffffffff);scan_put(b,at+12,ifx k==2 then 1 else 0xffffffff);scan_write_point(b,at+16,v3(-1,-2,-3));scan_write_point(b,at+28,v3(1,2,3));scan_put(b,at+40,cast(u32)(ifx k==2 then 1 else 0));scan_put(b,at+44,cast(u32)(ifx k==2 then 0 else 3));}
 scan_put(b,200,0);for k:0..<3 {scan_put(b,204+(k*4+k)*4,f32_bits(1));}
}
#test "world hierarchy suffix admits exact source ranges and rejects truncation and foreign versions" {
 b:[252]u8;wh_fixture(b[..]);#assert wh_valid(b[..],1,100);
 #assert !wh_valid(b[0..<251],1,100) && !wh_valid(b[0..<31],1,100) && !wh_valid(b[..],2,100) && !wh_valid(b[..],1,17);
 for at:0..<8 {old:=scan_u32(b[..],at*4);scan_put(b[..],at*4,old+1);#assert !wh_valid(b[..],1,100);scan_put(b[..],at*4,old);}
 for at:[6]int.[32,36,40,44,48,52] {old:=scan_u32(b[..],at);scan_put(b[..],at,old^1);#assert !wh_valid(b[..],1,100);scan_put(b[..],at,old);}
}
#test "world hierarchy rejects cyclic missing overlapping and unbounded nodes or transforms" {
 b:[252]u8;wh_fixture(b[..]);
 for at:[14]int.[56,60,64,68,96,104,108,112,116,144,152,156,192,196] {old:=scan_u32(b[..],at);scan_put(b[..],at,old^1);#assert !wh_valid(b[..],1,100);scan_put(b[..],at,old);}
 for at:[5]int.[72,84,168,180,204] {old:=scan_u32(b[..],at);for bits:[2]u32.[0x7fc00000,0x7f800000] {scan_put(b[..],at,bits);#assert !wh_valid(b[..],1,100);}scan_put(b[..],at,old);}
 scan_put(b[..],200,1);#assert !wh_valid(b[..],1,100);scan_put(b[..],200,0);
 scan_put(b[..],168,f32_bits(0));#assert !wh_valid(b[..],1,100);scan_put(b[..],168,f32_bits(-1));scan_put(b[..],180,f32_bits(0));#assert !wh_valid(b[..],1,100);
}
