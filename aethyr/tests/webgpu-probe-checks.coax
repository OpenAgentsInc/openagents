gp_test_result :: (mode:int,change:int,out:[]u8)->string {
  c:=gp_config(mode);o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);
  jo_key(o[..],"format");jo_str(o[..],"rgba32float");jo_key(o[..],"width");jo_int(o[..],ifx change==1 then 63 else 64);jo_key(o[..],"height");jo_int(o[..],64);
  jo_key(o[..],"messages");jo_arr(o[..]);if change==2 {jo_str(o[..],"warning");}jo_end(o[..]);
  jo_key(o[..],"errors");jo_arr(o[..]);if change==3 {jo_str(o[..],"error");}jo_end(o[..]);
  jo_key(o[..],"results");if change==8 {jo_obj(o[..]);}else {jo_arr(o[..]);}
  n:=c.count-(ifx change==4 then 1 else 0);
  for i:0..<n {
    if change==8 {key:[24]u8;ko:[1]Jo;jo_start(ko[..],key[..]);jo_int(ko[..],i);jo_key(o[..],jo_text(ko[..]));}
    row:[1024]u8;ro:[1]Jo;jo_start(ro[..],row[..]);gp_observation(ro[..],mode,ifx change==5 && i==0 then 1 else i);
    text:=jo_text(ro[..]);jo_value(o[..]);jo_put(o[..],text[0..<text.count-1]);jo_put(o[..],",\"rgba\":[0,0,0,");jo_put(o[..],ifx change==6 then "0" else "1");jo_put(o[..],"]}");
  }
  jo_end(o[..]);jo_key(o[..],"raw_words");if change==9 {jo_obj(o[..]);}else {jo_arr(o[..]);}
  for i:0..<c.count {
    if change==9 {key:[24]u8;ko:[1]Jo;jo_start(ko[..],key[..]);jo_int(ko[..],i);jo_key(o[..],jo_text(ko[..]));}
    jo_arr(o[..]);jo_int(o[..],ifx change==7 then 2139095040 else 0);jo_int(o[..],0);jo_int(o[..],0);jo_int(o[..],1065353216);jo_end(o[..]);
  }
  jo_end(o[..]);jo_end(o[..]);return jo_text(o[..]);
}
#forall "WebGPU probe configs preserve the authored counts and shader entry pairs" mode:0..<6 {
  c:=gp_config(mode);counts:=[6]int.[6,6,12,30,30,14];
  #assert c.valid && c.count==counts[mode];
  #assert gp_mode("bad")==-1 && !gp_config(-1).valid && !gp_config(6).valid;
  names:=[6]string.["raster","raster-guard","depth-plane","depth-left","depth-guard","filter-precision"];#assert gp_mode(names[mode])==mode;
  #assert c.pixel==(ifx mode==2 || mode==3 || mode==4 then 20 else 9);
  #assert gp_fraction(mode,0)=="0" && gp_perspective(mode,0)==0;
  vertices:=[6]string.["render_raster_probe_vs","render_raster_probe_vs","render_depth_plane_probe_vs","render_depth_left_probe_vs","render_depth_guard_probe_vs","render_filter_probe_vs"];
  fragments:=[6]string.["render_raster_probe_fs","render_raster_probe_fs","render_depth_plane_probe_fs","render_depth_plane_probe_fs","render_depth_plane_probe_fs","render_filter_probe_fs"];
  sources:=[6]string.["aethyr/tests/render-raster-probe.coax","aethyr/tests/render-raster-guard-probe.coax","aethyr/tests/render-depth-plane-probe.coax","aethyr/tests/render-depth-left-envelope-probe.coax","aethyr/tests/render-depth-guard-envelope-probe.coax","aethyr/tests/render-filter-precision-probe.coax"];
  #assert c.vertex==vertices[mode] && c.fragment==fragments[mode] && c.source==sources[mode];
  #assert c.bindings==(ifx mode==5 then "aethyr/tests/render-filter-precision-probe.bindings" else ifx mode>=2 then "aethyr/tests/render-depth-plane-probe.bindings" else "");
  raw:[32768]u8;o:[1]Jo;jo_start(o[..],raw[..]);gp_cases(o[..],mode);
  nodes:[4096]JvNode;d:[1]Jv;#assert !o[0].bad && jv_parse(d[..],jo_text(o[..]),nodes[..]) && jv_len(d[0],0)==counts[mode];
  expected:=[6]string.["0","0.0009765625","0.001953125","0.0029296875","0.005859375","0.0068359375"];
  fractions:=[14]string.["0","0.0009765625","0.001953125","0.0029296875","0.005859375","0.0068359375","0.1","0.2","0.3333333333333333","0.4990234375","0.5","0.5009765625","0.9990234375","1"];
  for i:0..<counts[mode] {
    row:=jv_at(d[0],0,i);u:=jv_get(d[0],row,"uniform");#assert jv_len(d[0],u)==4;
    fraction:=ifx mode==5 then fractions[i] else ifx mode==3 || mode==4 then expected[ifx i%3==2 then 3 else i%3] else expected[i%6];
    #assert gp_fraction(mode,i)==fraction && jv_raw(d[0],jv_at(d[0],u,0))==fraction;
    perspective:=ifx mode==2 then (ifx i<6 then 0 else 1) else ifx mode==3 || mode==4 then (ifx i<15 then 0 else 1) else 0;
    #assert gp_perspective(mode,i)==perspective && jv_int(d[0],jv_at(d[0],u,1),-1)==perspective;
    far_values:=[5]int.[4096,8192,16384,32768,65536];
    far:=ifx mode==3 || mode==4 then far_values[(i%15)/3]*(ifx mode==3 then -1 else 1) else 0;
    #assert gp_far(mode,i)==far && jv_int(d[0],jv_at(d[0],u,2),-1)==far && jv_int(d[0],jv_at(d[0],u,3),-1)==0;
    p:=jv_get(d[0],row,"pixel");#assert jv_int(d[0],jv_at(d[0],p,0),-1)==c.pixel && jv_int(d[0],jv_at(d[0],p,1),-1)==c.pixel;
    observation:=jv_get(d[0],row,"observation");#assert jv_len(d[0],observation)==(ifx mode==2 then 3 else ifx mode==3 || mode==4 then 4 else 2);
  }
}
gp_test_replace :: (text:string,from:string,to:string,out:[]u8)->string {
  for at:0..<text.count-from.count+1 {
    if text[at..<at+from.count]!=from {continue;}
    n:=text.count-from.count+to.count;
    for j:0..<at {out[j]=text[j];}for j:0..<to.count {out[at+j]=to[j];}
    for j:at+from.count..<text.count {out[j-from.count+to.count]=text[j];}
    return cast(string)out[0..<n];
  }
  return "";
}
#test "WebGPU probes refuse malformed field shapes bytes and nonfinite numeric transports" {
  source:[32768]u8;valid:=gp_test_result(0,0,source[..]);out:[32768]u8;nodes:[4096]JvNode;d:[1]Jv;
  from:=[22]string.["\"rgba32float\"","\"height\":64","\"messages\":[]","\"errors\":[]","\"raw_words\":[[0,0,0,1065353216],","[9,9]","[9,9]","[9,9]","[9,9]","[0,0,0,1]","[0,0,0,1]","[0,0,0,1]","[0,0,0,1]","[0,0,0,1]","[0,0,0,1065353216]","[0,0,0,1065353216]","[0,0,0,1065353216]","[0,0,0,1065353216]","[0,0,0,1065353216]","\"width\":64","[0,0,0,1065353216]","[9,9]"];
  to:=[22]string.["\"rgba16float\"","\"height\":63","\"messages\":{}","\"errors\":{}","\"raw_words\":[","[10,9]","[9,10]","[9]","{\"a\":9,\"b\":9}","[0,0,0]","{\"a\":0,\"b\":0,\"c\":0,\"d\":1}","[null,0,0,1]","[1e999,0,0,1]","[1.8e308,0,0,1]","[-1,0,0,1065353216]","[4294967296,0,0,1065353216]","[0.5,0,0,1065353216]","[0,0,0,1065353217]","[0,0,1065353216]","\"width\":\"64\"","{\"a\":0,\"b\":0,\"c\":0,\"d\":1065353216}","[\"9\",9]"];
  for i:0..<22 {changed:=gp_test_replace(valid,from[i],to[i],out[..]);#assert changed!="" && jv_parse(d[..],changed,nodes[..]) && !gp_admit(d[0],0,0);}
  #assert jv_parse(d[..],valid,nodes[..]) && !gp_admit(d[0],0,-1) && !gp_admit(d[0],0,6);
}
#forall "WebGPU depth metadata is required and bound to its original authored case" mode:2..<5 {
  source:[32768]u8;valid:=gp_test_result(mode,0,source[..]);out:[32768]u8;nodes:[4096]JvNode;d:[1]Jv;
  changed:=gp_test_replace(valid,"\"perspective\":0","\"perspective\":1",out[..]);
  #assert changed!="" && jv_parse(d[..],changed,nodes[..]) && !gp_admit(d[0],0,mode);
  if mode==3 || mode==4 {
    changed=gp_test_replace(valid,ifx mode==3 then "\"farX\":-4096" else "\"farY\":4096",ifx mode==3 then "\"farX\":-4097" else "\"farY\":4097",out[..]);
    #assert changed!="" && jv_parse(d[..],changed,nodes[..]) && !gp_admit(d[0],0,mode);
  }
}
#forall "WebGPU probe admission accepts complete finite authored observations and refuses planted losses" mode:0..<6,change:0..<8 {
  raw:[32768]u8;nodes:[4096]JvNode;d:[1]Jv;
  #assert jv_parse(d[..],gp_test_result(mode,change,raw[..]),nodes[..]);
  #assert gp_admit(d[0],0,mode)==(change==0);
}
#forall "WebGPU result containers retain arrays rather than keyed objects with the same length" mode:0..<6,change:8..<10 {
  raw:[32768]u8;nodes:[4096]JvNode;d:[1]Jv;
  #assert jv_parse(d[..],gp_test_result(mode,change,raw[..]),nodes[..]);
  #assert !gp_admit(d[0],0,mode);
}
