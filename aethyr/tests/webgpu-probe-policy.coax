// Authored diagnostic fixtures and admission of complete raw observations.
// No calibration result alters an engine profile or grants a frame tolerance.
#authority;
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/nostr/json-f64.coax";
#load "webgpu-probe-checks.coax";
GPConfig :: struct {valid:bool;count:int;vertex:string;fragment:string;source:string;bindings:string;pixel:int;}
gp_mode :: (name:string)->int {
  names:=[6]string.["raster","raster-guard","depth-plane","depth-left","depth-guard","filter-precision"];
  for i:0..<6 {if name==names[i] {return i;}}return -1;
}
gp_config :: (mode:int)->GPConfig {
  if mode<0 || mode>=6 {return GPConfig.{};}
  vertices:=[6]string.["render_raster_probe_vs","render_raster_probe_vs","render_depth_plane_probe_vs","render_depth_left_probe_vs","render_depth_guard_probe_vs","render_filter_probe_vs"];
  sources:=[6]string.["aethyr/tests/render-raster-probe.coax","aethyr/tests/render-raster-guard-probe.coax","aethyr/tests/render-depth-plane-probe.coax","aethyr/tests/render-depth-left-envelope-probe.coax","aethyr/tests/render-depth-guard-envelope-probe.coax","aethyr/tests/render-filter-precision-probe.coax"];
  counts:=[6]int.[6,6,12,30,30,14];
  c:=GPConfig.{valid=true,count=counts[mode],vertex=vertices[mode],source=sources[mode],pixel=9};
  c.fragment="render_raster_probe_fs";
  if mode>=2 && mode<=4 {c.fragment="render_depth_plane_probe_fs";c.bindings="aethyr/tests/render-depth-plane-probe.bindings";c.pixel=20;}
  if mode==5 {c.fragment="render_filter_probe_fs";c.bindings="aethyr/tests/render-filter-precision-probe.bindings";}
  return c;
}
gp_fraction :: (mode:int,index:int)->string {
  delta:=[6]string.["0","0.0009765625","0.001953125","0.0029296875","0.005859375","0.0068359375"];
  fractions:=[14]string.["0","0.0009765625","0.001953125","0.0029296875","0.005859375","0.0068359375","0.1","0.2","0.3333333333333333","0.4990234375","0.5","0.5009765625","0.9990234375","1"];
  if mode==5 {return fractions[index];}
  if mode==3 || mode==4 {p:=[3]int.[0,1,3];return delta[p[index%3]];}
  return delta[index%6];
}
gp_perspective :: (mode:int,index:int)->int {return ifx mode==2 then index/6 else ifx mode==3 || mode==4 then index/15 else 0;}
gp_far :: (mode:int,index:int)->int {
  if mode!=3 && mode!=4 {return 0;}values:=[5]int.[4096,8192,16384,32768,65536];
  value:=values[(index/3)%5];return ifx mode==3 then -value else value;
}
gp_observation :: (o:[]Jo,mode:int,index:int) {
  c:=gp_config(mode);jo_obj(o);jo_key(o,ifx mode==5 then "fraction" else "delta");jo_raw(o,gp_fraction(mode,index));
  if mode>=2 && mode<=4 {jo_key(o,"perspective");jo_int(o,gp_perspective(mode,index));}
  if mode==3 || mode==4 {jo_key(o,ifx mode==3 then "farX" else "farY");jo_int(o,gp_far(mode,index));}
  jo_key(o,"pixel");jo_arr(o);jo_int(o,c.pixel);jo_int(o,c.pixel);jo_end(o);jo_end(o);
}
gp_cases :: (o:[]Jo,mode:int) {
  c:=gp_config(mode);jo_arr(o);
  for i:0..<c.count {
    jo_obj(o);jo_key(o,"uniform");jo_arr(o);jo_raw(o,gp_fraction(mode,i));jo_int(o,gp_perspective(mode,i));jo_int(o,gp_far(mode,i));jo_int(o,0);jo_end(o);
    jo_key(o,"pixel");jo_arr(o);jo_int(o,c.pixel);jo_int(o,c.pixel);jo_end(o);
    jo_key(o,"observation");gp_observation(o,mode,i);jo_end(o);
  }
  jo_end(o);
}
gp_integer :: (d:Jv,node:int,expected:int)->bool {
  text:[24]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_int(o[..],expected);
  return jv_kind(d,node)==JV_NUMBER && jv_raw(d,node)==jo_text(o[..]);
}
gp_admit :: (d:Jv,root:int,mode:int)->bool {
  c:=gp_config(mode);if !c.valid {return false;}
  if jv_raw(d,jv_get(d,root,"format"))!="rgba32float" || !gp_integer(d,jv_get(d,root,"width"),64) || !gp_integer(d,jv_get(d,root,"height"),64) {return false;}
  messages:=jv_get(d,root,"messages");errors:=jv_get(d,root,"errors");
  if jv_kind(d,messages)!=JV_ARRAY || jv_len(d,messages)!=0 || jv_kind(d,errors)!=JV_ARRAY || jv_len(d,errors)!=0 {return false;}
  results:=jv_get(d,root,"results");words:=jv_get(d,root,"raw_words");
  if jv_kind(d,results)!=JV_ARRAY || jv_len(d,results)!=c.count || jv_kind(d,words)!=JV_ARRAY || jv_len(d,words)!=c.count {return false;}
  for i:0..<c.count {
    row:=jv_at(d,results,i);key:=ifx mode==5 then "fraction" else "delta";
    value:=jv_get(d,row,key);if jv_kind(d,value)!=JV_NUMBER || jv_raw(d,value)!=gp_fraction(mode,i) {return false;}
    pixel:=jv_get(d,row,"pixel");
    if jv_kind(d,pixel)!=JV_ARRAY || jv_len(d,pixel)!=2 || !gp_integer(d,jv_at(d,pixel,0),c.pixel) || !gp_integer(d,jv_at(d,pixel,1),c.pixel) {return false;}
    if mode>=2 && mode<=4 {if !gp_integer(d,jv_get(d,row,"perspective"),gp_perspective(mode,i)) {return false;}}
    if mode==3 || mode==4 {if !gp_integer(d,jv_get(d,row,ifx mode==3 then "farX" else "farY"),gp_far(mode,i)) {return false;}}
    rgba:=jv_get(d,row,"rgba");raw:=jv_at(d,words,i);
    if jv_kind(d,rgba)!=JV_ARRAY || jv_len(d,rgba)!=4 || jv_kind(d,raw)!=JV_ARRAY || jv_len(d,raw)!=4 {return false;}
    for channel:0..<4 {
      number:=jv_at(d,rgba,channel);if jv_kind(d,number)!=JV_NUMBER {return false;}
      f:=json_f64(jv_raw(d,number));if !f.ok || f.value-f.value!=0 {return false;}
      bits:=jv_int(d,jv_at(d,raw,channel),-1);
      if bits<0 || bits>=4294967296 || ((cast(u32)bits>>23)&255)==255 {return false;}
      if channel==3 && (f.value!=1 || bits!=1065353216) {return false;}
    }
  }
  return true;
}
