// Original Guardian keys on a privately retargeted Valley walk. Outputs remain
// under the caller's private asset directory; no source payload enters git.
// tool.sh: stack-gib 2
#import "Basic";
#load "anim-retarget-io.coax";
#load "../../verse/animlab/layer-demo.coax";
#load "../../verse/animlab/project.coax";
#load "../../aethyr/anim/write.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}root:=args_at(a[..],0);dest:=args_at(a[..],1);path:[4096]u8;text:[262144]u8;pack:[67108864]u8;n:=fs_read(fs_join(root,"rig.json",path[..]),text[..]);#assert n>0;ids:[1]AssetId;bn:=ar_read_pack(fs_join(root,"rig.json",path[..]),cast(string)text[0..<n],pack[..],ids[..]);#assert bn>0;packs:=[1]AnimPack.[AnimPack.{id=ids[0],bytes=pack[0..<bn]}];r:[1]AnimRig;#assert anim_rig_load(cast(string)text[0..<n],packs[..],r[..])==0;n=fs_read(fs_join(root,"clip-0.json",path[..]),text[..]);source:[1]AnimClip;#assert n>0 && anim_clip_load(cast(string)text[0..<n],packs[..],r[..],source[..])==0;
 out:[16777216]u8;rig:[1]AnimRig;layout:=aw_pack_rig(r[0],packs[..],out[..],rig[..]);#assert layout.bytes>0;at:=layout.bytes;clips:[4]AnimClip;frames:=901;joints:=rig[0].joints;sample:[1]AnimSample;start:[1]AnimSample;last:[1]AnimSample;walk:=source[0];walk.looping=false;anim_sample(r[0],walk,packs[..],0,start[..]);anim_sample(r[0],walk,packs[..],walk.length,last[..]);delta:=sub(last[0].local[0].t,start[0].local[0].t);
 for take:0..<3 {c:=AnimClip.{ready=true,name=anim_named(ifx take==0 then "guardian-body" else ifx take==1 then "guardian-wand" else "guardian-extras"),rig=rig[0].name,frames=frames,rate=30,length=30,joint_count=joints,role=anim_named("study"),source=source[0].source,receipt=asset_id("guardian-study-keys.v1")};for j:0..<joints {c.joints[j]=j;}c.body=AnimPart.{pack=0,offset=at,count=frames*joints,stride=28,width=28};
  for frame:0..<frames {time:=cast(f32)frame/30;motion:=lo(time,5);cycles:=floor(motion/walk.length);local:=motion-cycles*walk.length;anim_sample(r[0],walk,packs[..],local,sample[..]);advance:=times(delta,cycles);stop:=clamp01((time-5)/0.6);root_position:=add(sample[0].local[0].t,advance);turn:=clamp01((time-5)/4)*0.8;
   for j:0..<joints {p:=sample[0].local[j];if j==0 {p.t=root_position;p.q=quat_mul(Quat.{y=sin(turn/2),w=cos(turn/2)},p.q);}else {p.t=mix(p.t,rig[0].rest[j].t,stop);p.q=slerp(p.q,rig[0].rest[j].q,stop);}if take>0 {p=rig[0].rest[j];raise:=ifx take==1 then clamp01(time/4)*(1-clamp01((time-14)/3)) else sin(clamp01(time-18)*3.14159265)*0.4;if j==MQ_UPPERARM_R {angle:= -1.8*raise;p.q=quat_mul(p.q,Quat.{z=sin(angle/2),w=cos(angle/2)});}if j==MQ_LOWERARM_R {angle:= -0.7*raise;p.q=quat_mul(p.q,Quat.{y=sin(angle/2),w=cos(angle/2)});}}pos:=at+(frame*joints+j)*28;for value,k:[7]f32.[p.t.x,p.t.y,p.t.z,p.q.x,p.q.y,p.q.z,p.q.w] {aw_put(out[..],pos+k*4,f32_bits(value));}}
  }clips[take]=c;at+=frames*joints*28;
 }
 // Original jaw opening: only the bottom four vertices of our head box move.
 morph_at:=at;for k:0..<128 {out[at+k]=0;}for corner,k:[4]int.[0,1,4,5] {aw_put(out[..],at+k*32,cast(u32)(6*8+corner));aw_put(out[..],at+k*32+12,f32_bits(-0.055));}at+=128;rig[0].shape_count=1;rig[0].shapes[0]=anim_named("jawOpen");rig[0].morph_count=1;rig[0].morphs[0]=AnimRigMorph.{shape=0,section=0,data=AnimPart.{pack=0,offset=morph_at,count=4,stride=32,width=32}};
 // The held wand is original mesh geometry weighted to the right hand, so
 // every authored raise and reach moves it with the same sampled palette.
 empty:AnimClip;anim_sample(r[0],empty,packs[..],0,sample[..]);hand:=sample[0].position[MQ_HAND_R];wand_at:=at;corners:=[8]Point.[v3(-1,-1,-1),v3(1,-1,-1),v3(1,1,-1),v3(-1,1,-1),v3(-1,-1,1),v3(1,-1,1),v3(1,1,1),v3(-1,1,1)];tri:=[36]int.[0,2,1,0,3,2,4,5,6,4,6,7,0,1,5,0,5,4,3,7,6,3,6,2,1,2,6,1,6,5,0,4,7,0,7,3];
 for k:0..<912 {out[at+k]=0;}for corner,k:corners {point:=add(hand,v3(corner.x*0.018,corner.y*0.45,corner.z*0.018));for value,axis:[6]f32.[point.x,point.y,point.z,corner.x*0.5773503,corner.y*0.5773503,corner.z*0.5773503] {aw_put(out[..],at+k*96+axis*4,f32_bits(value));}aw_put(out[..],at+k*96+32,0x00305870);out[at+k*96+36]=cast(u8)MQ_HAND_R;out[at+k*96+52]=255;}for value,k:tri {aw_put(out[..],at+768+k*4,cast(u32)value);}at+=912;rig[0].sections=2;rig[0].material_count=2;rig[0].materials[1]=anim_named("wood");rig[0].meshes[1]=AnimMesh.{vertices=AnimPart.{pack=0,offset=wand_at,count=8,stride=96,width=96},indices=AnimPart.{pack=0,offset=wand_at+768,count=36,stride=4,width=4},material=1};
 lib:[1]AnimLibrary;lib[0].rig[0]=rig[0];for k:0..<4 {lib[0].clips[k]=clips[k];}lib[0].count=1;lib[0].packs[0]=AnimPack.{id=asset_id(cast(string)out[0..<at]),bytes=out[0..<at]};demo:[1]AlLayerDemo;#assert al_demo(lib[..],demo[..])==0;clips[3]=demo[0].clip;clips[3].name=anim_named("guardian-contacts");p:=demo[0].performance;p.name=anim_named("guardian-performance");p.layers[0].clip=3;p.layers[0].blend_in=0;p.layers[0].blend_out=0;
 // Keep the source-derived contact fix-ups, with original wand and breath keys.
 p.layers[1]=AnimLayer.{kind=1,clip=1,start=12,end=30,speed=1,weight=1,blend_in=2,blend_out=0.4,mask=3};p.layers[2]=AnimLayer.{kind=2,clip=1,start=0,end=30,speed=1,weight=0.02,blend_in=0.15,blend_out=0.15,mask=2};p.layers[3]=AnimLayer.{kind=3,clip=1,start=0,end=30,speed=1,weight=1,mask=1};
 p.layers[p.count]=AnimLayer.{kind=4,solver=2,joint=MQ_HAND_R,target=v3(0.5,1.8,0),start=14,end=28,speed=1,weight=1,blend_in=1,blend_out=0.4,mask=5};p.count+=1;
 hash:[64]u8;#assert asset_hex(lib[0].packs[0].id,hash[..]);h:=cast(string)hash[..];rig_n:=aw_rig(text[..],rig[0],layout,h);#assert rig_n>0;bundle:[16777216]u8;cursor:=60;for word,k:[3]u32.[0x31424c41,0,4] {aw_put(bundle[..],k*4,word);}for part:0..<6 {size:=0;aw_put(bundle[..],12+part*8,cast(u32)cursor);if part==0 {size=at;for k:0..<size {bundle[cursor+k]=out[k];}}else {if part>1 {rig_n=aw_clip(text[..],clips[part-2],rig[0],h);}size=rig_n;for k:0..<size {bundle[cursor+k]=text[k];}}aw_put(bundle[..],16+part*8,cast(u32)size);cursor+=size;}aw_put(bundle[..],4,cast(u32)cursor);verified:[1]AnimLibrary;e:=anim_bundle_load(bundle[0..<cursor],verified[..]);if e!=0 {print("guardian bundle refused code=% part_bytes=%\n",e,cursor);return 1;}
 #assert ar_file(dest,"guardian.bundle",cast(string)bundle[0..<cursor]);pn:=aw_performance(text[..],p,rig[0],clips[..]);#assert pn>0 && ar_file(dest,"guardian.performance.json",cast(string)text[0..<pn]);extras:=AnimPerformance.{ready=true,name=anim_named("guardian-extras"),rig=rig[0].name,length=30,count=1};extras.layers[0]=AnimLayer.{kind=0,clip=2,start=0,end=30,speed=1,weight=1,mask=0};pn=aw_performance(text[..],extras,rig[0],clips[..]);#assert pn>0 && ar_file(dest,"extras.performance.json",cast(string)text[0..<pn]) && guardian_wand(dest);print("guardian clips=4 contacts=% joints=% pack_bytes=% bundle_bytes=%\n",demo[0].count,joints,at,cursor);return 0;
}

guardian_wand :: (dest:string)->bool {
 pack:[4096]u8;r:AnimRig;r.ready=true;r.name=anim_named("guardian-wand");r.joints=1;r.names[0]=anim_named("root");r.parents[0]= -1;r.sections=1;r.material_count=1;r.materials[0]=anim_named("wood");for k:[3]int.[0,5,10] {r.bind[k]=1;}
 corners:=[8]Point.[v3(-1,-1,-1),v3(1,-1,-1),v3(1,1,-1),v3(-1,1,-1),v3(-1,-1,1),v3(1,-1,1),v3(1,1,1),v3(-1,1,1)];indices:=[36]int.[0,2,1,0,3,2,4,5,6,4,6,7,0,1,5,0,5,4,3,7,6,3,6,2,1,2,6,1,6,5,0,4,7,0,7,3];
 for point,k:corners {pos:=v3(point.x*0.018,point.y*0.45,point.z*0.018);for value,axis:[6]f32.[pos.x,pos.y,pos.z,point.x*0.5773503,point.y*0.5773503,point.z*0.5773503] {aw_put(pack[..],k*96+axis*4,f32_bits(value));}pack[k*96+52]=255;}for value,k:indices {aw_put(pack[..],768+k*4,cast(u32)value);}r.meshes[0]=AnimMesh.{vertices=AnimPart.{pack=0,offset=0,count=8,stride=96,width=96},indices=AnimPart.{pack=0,offset=768,count=36,stride=4,width=4},material=0};
 for frame:0..<2 {aw_put(pack[..],912+frame*28+24,f32_bits(1.0f32));}c:=AnimClip.{ready=true,name=anim_named("wand-rest"),rig=r.name,frames=2,rate=30,length=1.0f32/30,joint_count=1,role=anim_named("original"),source=asset_id("original-wand.v1"),receipt=asset_id("original-wand.v1")};c.body=AnimPart.{pack=0,offset=912,count=2,stride=28,width=28};packs:=[1]AnimPack.[AnimPack.{id=asset_id(cast(string)pack[0..<968]),bytes=pack[0..<968]}];packed:[4096]u8;rig:[1]AnimRig;layout:=aw_pack_rig(r,packs[..],packed[..],rig[..]);if layout.bytes<1 {return false;}hash:[64]u8;#assert asset_hex(asset_id(cast(string)packed[0..<layout.bytes]),hash[..]);h:=cast(string)hash[..];rig_text:[8192]u8;clip_text:[8192]u8;rn:=aw_rig(rig_text[..],rig[0],layout,h);
 // aw_pack_rig compacts mesh/rest/bind; append the original rest clip after it.
 for k:0..<56 {packed[layout.bytes+k]=pack[912+k];}c.body.offset=layout.bytes;layout.bytes+=56;#assert asset_hex(asset_id(cast(string)packed[0..<layout.bytes]),hash[..]);rn=aw_rig(rig_text[..],rig[0],layout,h);cn:=aw_clip(clip_text[..],c,r,h);if rn<1 || cn<1 {return false;}bundle:[16384]u8;cursor:=36;parts:=[3]string.[cast(string)packed[0..<layout.bytes],cast(string)rig_text[0..<rn],cast(string)clip_text[0..<cn]];for part,k:parts {aw_put(bundle[..],12+k*8,cast(u32)cursor);aw_put(bundle[..],16+k*8,cast(u32)part.count);for value,j:part {bundle[cursor+j]=value;}cursor+=part.count;}for value,k:[3]u32.[0x31424c41,cast(u32)cursor,1] {aw_put(bundle[..],k*4,value);}library:[1]AnimLibrary;return anim_bundle_load(bundle[0..<cursor],library[..])==0 && ar_file(dest,"wand.bundle",cast(string)bundle[0..<cursor]);
}
