// Package admitted animation documents for owner-local station playback.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../verse/tools/humans/ph_num.coax";
#load "../anim/bundle.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {print("usage: anim-lab-bundle DOCUMENT_DIR OUTPUT.bundle\n");return 2;}
 root:=args_at(a[..],0);out:[ANIM_BUNDLE_BYTES]u8;text:[262144]u8;path:[4096]u8;n:=fs_read(fs_join(root,"receipt.json",path[..]),text[..]);#assert n>0;nodes:[32768]JvNode;d:[1]Jv;#assert anim_json(cast(string)text[0..<n],d[..],nodes[..])==0;id:[1]AssetId;#assert anim_hash(d[0],jv_get(d[0],0,"pack"),id[..]);
 count:=jv_int(d[0],jv_get(d[0],0,"body_clips"),0)+jv_int(d[0],jv_get(d[0],0,"face_clips"),0);#assert anim_bundle_count(count);at:=12+(count+2)*8;hash:[64]u8;#assert asset_hex(id[0],hash[..]);filename:[68]u8;for c,k:hash {filename[k]=c;}for c,k:".bin" {filename[64+k]=c;}
 n=fs_read(fs_join(root,cast(string)filename[..],path[..]),out[at..<out.count]);#assert n>0 && asset_same(asset_id(cast(string)out[at..<at+n]),id[0]);anim_bundle_put(out[..],12,cast(u32)at);anim_bundle_put(out[..],16,cast(u32)n);at+=n;
 rig_file:=ifx fs_kind(fs_join(root,"rig.json",path[..]))==FS_FILE then "rig.json" else "echo.rig.json";
 for k:0..<count+1 {name:[32]u8;o:[1]PnOut;o[0].buf=name[..];if k==0 {pn_put(o[..],rig_file);}else {pn_put(o[..],"clip-");pn_putint(o[..],k-1);pn_put(o[..],".json");}n=fs_read(fs_join(root,pn_text(o[..]),path[..]),out[at..<out.count]);#assert n>0;anim_bundle_put(out[..],20+k*8,cast(u32)at);anim_bundle_put(out[..],24+k*8,cast(u32)n);at+=n;}
 anim_bundle_put(out[..],0,0x31424c41);anim_bundle_put(out[..],4,cast(u32)at);anim_bundle_put(out[..],8,cast(u32)count);lib:[1]AnimLibrary;#assert anim_bundle_load(out[0..<at],lib[..])==0 && fs_write(args_at(a[..],1),cast(string)out[0..<at]);#assert asset_hex(asset_id(cast(string)out[0..<at]),hash[..]);print("animation bundle clips=% joints=% bytes=% sha256=%\n",count,lib[0].rig[0].joints,at,cast(string)hash[..]);return 0;
}
