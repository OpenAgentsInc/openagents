// Native headless film renderer. Verse produces every pixel; ffmpeg only
// encodes the measured PNGs and muxes the independently sampled PCM at the end.
#load "anim-scene-io.coax";
#load "../../coax/lib/media/media.coax";
#load "../../aethyr/anim/cut-playback.coax";
#load "../../aethyr/anim/write.coax";
#load "../../aethyr/anim/export-policy.coax";
scene_audio_value :: (wave:[]u8,plan:AudioWavPlan,time:f32,channel:int)->f32 {
 if time<0 {return 0;}position:=cast(f64)time*cast(f64)plan.rate;frame:=cast(int)position;if frame>=plan.frames {return 0;}next:=ifx frame+1<plan.frames then frame+1 else frame;ch:=ifx plan.channels==1 then 0 else channel;a:=apw_u16(wave,44+(frame*plan.channels+ch)*2);b:=apw_u16(wave,44+(next*plan.channels+ch)*2);sa:=ifx a>=32768 then a-65536 else a;sb:=ifx b>=32768 then b-65536 else b;return lerp(cast(f32)sa/32768,cast(f32)sb/32768,cast(f32)(position-cast(f64)frame));
}
#test "film WAV sampling observes signed stereo channels and finite cue ends" {
 pcm:=[4]int.[-32768,32767,0,16384];b:[52]u8;wave:=apw_test_wav(2,48000,pcm[..],b[..]);p:=apw_plan(wave);#assert scene_audio_value(wave,p,0,0)== -1 && scene_audio_value(wave,p,0,1)==32767.0f32/32768;#assert scene_audio_value(wave,p,-1,0)==0 && scene_audio_value(wave,p,1,1)==0;#assert abs(scene_audio_value(wave,p,0.5/48000,0)+0.5)<0.00001;
}
scene_audio_mix :: (p:[]SceneProject,file:string)->bool {
 frames:=cast(int)(p[0].cut[0].length*48000);if frames>2880000 {return false;}pcm:[5760000]int;bytes:[11520044]u8;
 waves:[32][]u8;plans:[32]AudioWavPlan;voice:=0;for k:0..<p[0].scene[0].sounds {cue:=p[0].scene[0].sound[k];if cue.kind==0 {at:=p[0].wave_at[voice];size:=p[0].wave_n[voice];waves[k]=p[0].bytes[at..<at+size];voice+=1;}else {part:=cue.source;waves[k]=p[0].library[part.pack].packs[0].bytes[part.offset..<part.offset+part.width];}plans[k]=apw_plan(waves[k]);if !plans[k].valid {return false;}}
 for frame:0..<frames {moment:=cut_play(p[0].cut[..],cast(f32)frame/48000);for channel:0..<2 {value:f32=0;for k:0..<p[0].scene[0].sounds {cue:=p[0].scene[0].sound[k];if moment.time>=cue.start && moment.time<cue.end {value+=scene_audio_value(waves[k],plans[k],moment.time-cue.start,channel)*cue.gain;}}value=clamp(value*moment.opacity,-1,32767.0f32/32768);pcm[frame*2+channel]=cast(int)(value*32768);}}
 n:=wav_write(pcm[0..<frames*2],2,48000,bytes[..]);return n>0 && fs_write(file,cast(string)bytes[0..<n]);
}
scene_play_file :: (file:string,output:string,why:[]u8)->string {
 bytes:[67108864]u8;n:=ap_file(file,bytes[..]);p:[1]SceneProject;if n<1 || !project_load(bytes[0..<n],p[..]) {return "animation project refused";}if p[0].cut[0].length>60 {return "A5 renders at most 60 seconds; render a shorter cut";}for k:0..<p[0].cut[0].shots {if p[0].cut[0].shot[k].transition==2 {return "crossfade needs two render targets; A5 supports cut and fade";}}
 home:[4096]u8;root:[4096]u8;canonical:[4096]u8;parent:[4096]u8;outpath:[4096]u8;private_root:=fs_realpath(fs_join(proc_getenv("HOME",home[..]),".openagents",root[..]),canonical[..]);canonical_parent:=fs_realpath(fs_dir(output),parent[..]);if !anim_export_path(canonical_parent,private_root,fs_base(output)) {return "film output must be under ~/.openagents";}dest:=fs_join(canonical_parent,fs_base(output),outpath[..]);if fs_kind(dest)!=FS_NONE {return "film output already exists";}
 hash:[64]u8;#assert asset_hex(asset_id(cast(string)bytes[0..<n]),hash[..]);alias:[80]u8;o:[1]PnOut;o[0].buf=alias[..];pn_put(o[..],cast(string)hash[..]);token:=pn_text(o[..]);web:[4096]u8;webroot:=fs_join(private_root,"verse/private-build/web",web[..]);filename:[96]u8;w:[1]PnOut;w[0].buf=filename[..];pn_put(w[..],token);pn_put(w[..],".bundle");assetpath:[4096]u8;if !fs_write(fs_join(webroot,pn_text(w[..]),assetpath[..]),cast(string)bytes[0..<n]) {return "could not stage the private project";}
 originbuf:[4096]u8;origin:=proc_getenv("OPENAGENTS_ANIM_ORIGIN",originbuf[..]);if origin=="" {origin="http://127.0.0.1:8800";}if origin.count<17 || origin[0..<17]!="http://127.0.0.1:" {return "OPENAGENTS_ANIM_ORIGIN must be a local http://127.0.0.1:PORT server";}
 urlbuf:[8192]u8;u:[1]PnOut;u[0].buf=urlbuf[..];pn_put(u[..],origin);pn_put(u[..],"/realms/animation-lab/?project=");pn_put(u[..],token);pn_put(u[..],"#cut?card=1");
 framesbuf:[4096]u8;f:[1]PnOut;f[0].buf=framesbuf[..];pn_put(f[..],dest);pn_put(f[..],".frames");frames:=pn_text(f[..]);if fs_kind(frames)!=FS_NONE || !fs_mkdir(frames) {return "film frame directory already exists or cannot be created";}
 start:=proc_now_ms();c:[1]Cdp;if !cdp_launch_background(c[..],960,540,"anim-film-") {return "headless Chrome failed";}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);_=cdp_call(c[..],"Emulation.setDeviceMetricsOverride","{\"width\":960,\"height\":540,\"deviceScaleFactor\":1,\"mobile\":false}",30000);request:[8192]u8;j:[1]Jo;jo_start(j[..],request[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],"globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceErrors=[];globalThis.faceHashes=[];globalThis.animTimes=[];globalThis.animEngine='';addEventListener('error',e=>faceErrors.push(e.message));const ce=console.error;console.error=(...a)=>{faceErrors.push(a.map(String).join(' '));ce(...a)};const af=fetch;globalThis.fetch=async(...a)=>{const r=await af(...a);if(new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname.endsWith('/animationlab.wasm'))animEngine=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',await r.clone().arrayBuffer())),v=>v.toString(16).padStart(2,'0')).join('');return r}");jo_end(j[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000);jo_start(j[..],request[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],pn_text(u[..]));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
 ready:=false;deadline:=proc_now_ms()+60000;while proc_now_ms()<deadline {v:=cdp_evaluate(c[..],"(async()=>{if(!globalThis.coaxial?.ready)return false;await coaxialClipStep(1,60);return coaxial.sceneReady&&coaxial.guardProbe(30)===1&&coaxial.guardProbe(35)===0&&faceErrors.length===0})()");if v>=0 && jv_raw(c[0].doc[0],v)=="true" {ready=true;break;}proc_sleep(100);}if !ready {return "scene did not become ready in headless Chrome";}
 fps:=p[0].cut[0].fps;total:=cast(int)(p[0].cut[0].length*cast(f32)fps);if total>144000 {return "film exceeds the frame limit";}
 if !scene_eval(c[..],"install held authored-frame capture","(()=>{globalThis.animFrame=async(frame,fps)=>{const begin=performance.now();globalThis.faceShotCanvas?.remove();coaxial.send(700,String(frame));await coaxialClipStep(1,fps);coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,fps);for(let i=0;i<200&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,5));const r=coaxial.renderCapture;if(!r?.bytes||coaxial.guardProbe(3)!==frame||faceErrors.length)return false;const digest=await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes));faceHashes.push(Array.from(new Uint8Array(digest),v=>v.toString(16).padStart(2,'0')).join(''));const canvas=document.createElement('canvas');canvas.width=r.width;canvas.height=r.height;canvas.style.cssText='position:fixed;inset:0;width:100vw;height:100vh;z-index:2147483647;pointer-events:none';canvas.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);document.body.append(canvas);globalThis.faceShotCanvas=canvas;animTimes.push(performance.now()-begin);return true};return true})()") {return "could not install the capture loop";}
 png:[8388608]u8;name:[32]u8;path:[4096]u8;expr:[256]u8;e:[1]PnOut;
 for frame:0..<total {e[0]=PnOut.{buf=expr[..]};pn_put(e[..],"animFrame(");pn_putint(e[..],frame);pn_put(e[..],",");pn_putint(e[..],fps);pn_put(e[..],")");if !scene_eval(c[..],"authored movie frame",pn_text(e[..])) {return "movie capture failed";}size:=cdp_screenshot(c[..],png[..]);if size<1 || !fs_write(fs_join(frames,clip_frame_name(frame,name[..]),path[..]),cast(string)png[0..<size]) {return "could not save a movie frame";}}
 render_ms:=proc_now_ms()-start;wavpath:[4096]u8;wav:=fs_join(frames,"sound.wav",wavpath[..]);if !scene_audio_mix(p[..],wav) {return "audio cue is missing a canonical WAV or mix failed";}fpsbuf:[16]u8;ft:[1]PnOut;ft[0].buf=fpsbuf[..];pn_putint(ft[..],fps);error:=media_encode_sound("",frames,pn_text(ft[..]),wav,dest,why);if error!="" {return error;}
 result:=cdp_evaluate(c[..],"JSON.stringify({schema:'anim.play.receipt.v1',engine_sha256:animEngine,viewport:[innerWidth,innerHeight],frame_hashes:faceHashes,frame_count:faceHashes.length,capture_median_ms:[...animTimes].sort((a,b)=>a-b)[Math.floor(animTimes.length/2)],capture_p95_ms:[...animTimes].sort((a,b)=>a-b)[Math.floor(animTimes.length*.95)],errors:faceErrors})");receipt:[262144]u8;rn:=jv_str(c[0].doc[0],result,receipt[..]);if rn<1 || !fs_write(fs_join(frames,"receipt.json",path[..]),cast(string)receipt[0..<rn]) {return "could not save frame hashes";}
 timing:[4096]u8;jo_start(j[..],timing[..]);jo_obj(j[..]);jo_key(j[..],"render_ms");jo_int(j[..],render_ms);jo_key(j[..],"total_ms");jo_int(j[..],proc_now_ms()-start);jo_key(j[..],"film_seconds");aw_number(j[..],p[0].cut[0].length);jo_key(j[..],"render_seconds_per_film_second");aw_number(j[..],cast(f32)render_ms/1000/p[0].cut[0].length);jo_key(j[..],"project_sha256");jo_str(j[..],cast(string)hash[..]);jo_end(j[..]);if !fs_write(fs_join(frames,"timing.json",path[..]),jo_text(j[..])) {return "could not save timing";}return "";
}

scene_eval :: (c:[]Cdp,label:string,js:string)->bool {v:=cdp_evaluate(c,js);if v>=0 && jv_raw(c[0].doc[0],v)=="true" {return true;}return false;}
