// Bounded original BYML/SARC inspection, without executing archived code.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "kokiri-byml.coax";
ki_fres :: (b:[]u8) {model:=ob_ptr(b,40);shapes:=ob_u16(b,model+106);array:=ob_ptr(b,model+40);gpu:=ob_ptr(b,ob_ptr(b,176)+8);print("BFRES shapes=% gpu=% bytes=%\n",shapes,gpu,b.count);for i:0..<shapes {s:=array+i*96;print("FSHP id=% name=% flags=% meshcount=%\n",i,ob_name(b,s+8),ob_word(b,s+4),b[s+91]);if (ob_word(b,s+4)&16)!=0 {v:=ob_ptr(b,s+16);print("FVTX ptr=% flags=% vertexCount=% attrs=% buffers=% baseGpu=% weightCount=%\n",v,ob_word(b,v+4),ob_int(b,v+80),b[v+76],b[v+77],ob_int(b,v+72),b[v+84]);for a:0..<cast(int)b[v+76] {ap:=ob_ptr(b,v+8)+a*16;print("ATTR name=% format=% offset=% buffer=%\n",ob_name(b,ap),ob_int(b,ap+8),ob_u16(b,ap+12),b[ap+14]);}m:=ob_ptr(b,s+24);info:=ob_ptr(b,m+16);offsets:=ob_ptr(b,m+24);count:=cast(int)b[m+68];print("MESHLET header=% info=% offsets=% buffers=%\n",m,info,offsets,count);for j:0..<count {size:=ob_int(b,info+j*16);offset:=ob_int(b,offsets+j*8);print("BUFFER id=% size=% offset=% absolute=%\n",j,size,offset,gpu+offset);for k:0..<(ifx size/4<48 then size/4 else 48) {print("WORD buffer=% index=% value=%\n",j,k,ob_word(b,gpu+offset+k*4));}}}}}
ki_node :: (b:[]u8,node:KbNode,key:string,depth:int) {#assert depth<=32;if node.kind==0xc1 || node.kind==0xc0 {print("BYML depth=% key=% kind=% count=%\n",depth,key,node.kind,kb_count(b,node));for k:0..<kb_count(b,node) {child:=kb_at(b,node,k);name:=ifx node.kind==0xc1 then kb_key(b,node,k) else "[]";ki_node(b,child,name,depth+1);}}else if node.kind==0xa0 {print("BYML depth=% key=% string=%\n",depth,key,kb_string(b,node));}else if node.kind==0xd2 {print("BYML depth=% key=% float=%\n",depth,key,kb_float(b,node));}else {print("BYML depth=% key=% kind=% raw=%\n",depth,key,node.kind,node.value);}}
tool_main :: ()->int #export_c #effects(all) {args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=1 {return 2;}data:[67108864]u8;n:=fs_read(args_at(args[..],0),data[..]);#assert n>0;b:=data[0..<n];if cast(string)b[0..<4]=="SARC" {for k:0..<kb_sarc_count(b) {name:=kb_sarc_name(b,k);member:=kb_sarc_at(b,k);print("SARC name=% bytes=%\n",name,member.count);if member.count>=16 && cast(string)member[0..<2]=="YB" {ki_node(member,kb_root(member),name,0);}}}else if cast(string)b[0..<4]=="FRES" {ki_fres(b);}else {ki_node(b,kb_root(b),"root",0);}return 0;}
