// Verified local NUP extents -> original RomFS payloads and decompressed source files.
// The catalog selection is explicit input; no game code executes.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../core/assets.coax";
#load "../render/geometry/scan.coax";
#test "Kokiri preparation reads Zstandard dictionary widths and window descriptor" {
 b:[16]u8;scan_put(b[..],0,0xfd2fb528);b[4]=0x21;b[5]=3;#assert kp_dict(b[..])==3;
 b[4]=2;b[6]=2;b[7]=0;#assert kp_dict(b[..])==2;
 b[4]=0x23;scan_put(b[..],5,4);#assert kp_dict(b[..])==4;
 b[4]=0x20;#assert kp_dict(b[..])==0;
}
#test "Preparation rejects escaped paths and truncated four-byte dictionary IDs" {#assert kp_logical("romfs/Tex/A.bntx.zs") && !kp_logical("romfs/../A") && !kp_logical("romfs//A") && !kp_logical("romfs/./A") && !kp_logical("/romfs/A");b:[8]u8;scan_put(b[..],0,0xfd2fb528);b[4]=3;#assert kp_dict(b[..])== -1;}
kp_logical :: (p:string)->bool {if p.count<=6 || p[0..<6]!="romfs/" {return false;}begin:=0;for c,i:p {if c==0 || c==92 {return false;}if c==47 {part:=p[begin..<i];if part.count==0 || part=="." || part==".." {return false;}begin=i+1;}}part:=p[begin..<p.count];return part.count>0 && part!="." && part!="..";}
kp_dict :: (b:[]u8)->int {
 if b.count<5 || scan_u32(b,0)!=0xfd2fb528 {return -1;}f:=cast(int)b[4];n:=[4]int.[0,1,2,4][f&3];p:=ifx (f&32)!=0 then 5 else 6;if p+n>b.count {return -1;}v:=0;
 for k:0..<n {v|=cast(int)b[p+k]<<(8*k);}return v;
}
kp_parent :: (p:string)->string {for i:0..<p.count {k:=p.count-1-i;if p[k]=='/' {return p[0..<k];}}return ".";}
kp_zstd :: (input:string,output:string,dict:string) {
 a:=[9]string.["/opt/homebrew/bin/zstd","-d","-q","-f",input,"-o",output,"-D",dict];out:[8192]u8;err:[8192]u8;r:=proc_run(a[0..<(ifx dict.count>0 then 9 else 7)],120000,out[..],err[..]);
 if r.started!=0 || r.status!=0 || r.timed_out {tool_errln(cast(string)err[0..<r.err_n]);}#assert r.started==0 && r.status==0 && !r.timed_out;
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<4 {return 2;}nup:=args_at(a[..],0);selection:=args_at(a[..],1);dictionaries:=args_at(a[..],2);root:=args_at(a[..],3);
 text:[2097152]u8;nodes:[65536]JvNode;doc:[1]Jv;sn:=fs_read(selection,text[..]);#assert sn>0 && jv_parse(doc[..],cast(string)text[0..<sn],nodes[..]);d:=doc[0];#assert jv_kind(d,0)==JV_ARRAY;
 data:[134217728]u8;decoded:[268435456]u8;rawbuf:[4096]u8;sourcebuf:[4096]u8;tempbuf:[4096]u8;dictbuf:[4096]u8;logbuf:[4096]u8;outerbuf:[4096]u8;
 temporary:=fs_join(root,"decode.tmp",tempbuf[..]);outer:=fs_join(root,"outer.tmp",outerbuf[..]);journal:=fs_join(root,"source-provenance.jsonl",logbuf[..]);#assert fs_mkdir(root);done:=0;waiting:=0;existing:=0;
 for i:0..<jv_len(d,0) {record:=jv_at(d,0,i);logical:=jv_raw(d,jv_get(d,record,"path"));#assert kp_logical(logical);
  targetname:=ifx logical.count>3 && logical[logical.count-3..<logical.count]==".zs" then logical[0..<logical.count-3] else logical;
  destination:[4096]u8;target:=fs_join(fs_join(root,"source",sourcebuf[..]),targetname,destination[..]);if fs_exists(target) {existing+=1;continue;}
  offset:=jv_int(d,jv_get(d,record,"offset"),-1);stored:=jv_int(d,jv_get(d,record,"stored"),-1);size:=jv_int(d,jv_get(d,record,"size"),-1);codec:=jv_int(d,jv_get(d,record,"codec"),-1);#assert offset>=0 && stored>0 && stored<=data.count && size>0 && size<=data.count && (codec==0 || codec==1);
  n:=fs_read_at(nup,offset,data[0..<stored]);if n!=stored {waiting+=1;continue;}
  rawname:[4096]u8;original:=fs_join(fs_join(root,"original-assets",rawbuf[..]),logical,rawname[..]);#assert fs_mkdir(kp_parent(original));
  if codec==1 {#assert fs_write(temporary,cast(string)data[0..<n]);kp_zstd(temporary,outer,"");n=fs_read(outer,data[..]);}
  hash:[64]u8;#assert n>0 && asset_hex(asset_id(cast(string)data[0..<n]),hash[..]);want:=jv_raw(d,jv_get(d,record,"sha256"));
  if n!=size || cast(string)hash[..]!=want {waiting+=1;continue;}
  #assert fs_write(original,cast(string)data[0..<n]);
  final:=data[0..<n];if n>=8 && scan_u32(data[..],0)==0xfd2fb528 {id:=kp_dict(final);#assert id>=0 && id<=4;dict:=ifx id==0 then "" else fs_join(dictionaries,[4]string.["dictionary-1.zsdic","dictionary-2.zsdic","dictionary-3.zsdic","dictionary-4.zsdic"][id-1],dictbuf[..]);kp_zstd(original,temporary,dict);dn:=fs_read(temporary,decoded[..]);#assert dn>0;final=decoded[0..<dn];}
  #assert fs_mkdir(kp_parent(target)) && fs_write(target,cast(string)final);#assert asset_hex(asset_id(cast(string)final),hash[..]);
  line:[8192]u8;jo:[1]Jo;jo_start(jo[..],line[..]);jo_obj(jo[..]);jo_key(jo[..],"path");jo_str(jo[..],logical);jo_key(jo[..],"entry_sha256");jo_str(jo[..],want);jo_key(jo[..],"decoded_bytes");jo_int(jo[..],final.count);jo_key(jo[..],"decoded_sha256");jo_str(jo[..],cast(string)hash[..]);jo_end(jo[..]);#assert fs_append(journal,jo_text(jo[..])) && fs_append(journal,"\n");print("SOURCE % %\n",logical,final.count);done+=1;
 }
 print("KOKIRI_PREPARED=% EXISTING=% WAITING=%\n",done,existing,waiting);return ifx waiting==0 || args_has(a[..],"--available") then 0 else 1;
}
