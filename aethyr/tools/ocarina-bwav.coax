// Original BWAV DSP-ADPCM -> PCM16 WAV. No SDK or Python decoder at runtime.
// CLI INPUT.bwav OUTPUT.wav. Prefetch stubs and Opus refuse rather than publishing a prefix.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../render/geometry/scan.coax";
#load "../audio/wav.coax";
ob_u16 :: (b:[]u8,p:int)->int {return cast(int)b[p]+cast(int)b[p+1]*256;}
ob_s16 :: (b:[]u8,p:int)->int {v:=ob_u16(b,p);return ifx v>=32768 then v-65536 else v;}
ObWave :: struct {ok:bool;channels:int;rate:int;frames:int;}
#test "BWAV rejects truncated prefetch unknown codec and unequal channel metadata" {
 b:[136]u8;ob_fixture(b[..]);#assert ob_header(b[..]).ok && !ob_header(b[0..<135]).ok;
 b[12]=1;#assert !ob_header(b[..]).ok;b[12]=0;b[16]=2;#assert !ob_header(b[..]).ok;b[16]=1;scan_put(b[..],28,13);#assert !ob_header(b[..]).ok;
}
#test "DSP nibbles coefficients saturation and WAV output match hand worked samples" {
 b:[136]u8;ob_fixture(b[..]);b[128]=4;b[129]=0x78;b[130]=0x1f;pcm:[14]int;h:=ob_header(b[..]);#assert ob_decode(b[..],h,pcm[..]);#assert pcm[0]==112 && pcm[1]== -128 && pcm[2]==16 && pcm[3]== -16;
 // Predictor 1 with coefficient 2048 copies previous history (112).
 ob_fixture(b[..]);b[128]=0x10;wav_u16(b[..],0x10+0x14,2048);wav_u16(b[..],0x10+0x46,112);#assert ob_decode(b[..],ob_header(b[..]),pcm[..]);#assert pcm[0]==112 && pcm[13]==112;
 b[128]=0x80;#assert !ob_decode(b[..],ob_header(b[..]),pcm[..]);
}
#test "Stereo BWAV requires complete independent channels with matching rates and lengths" {
 b:[208]u8;ob_fixture(b[..]);wav_u16(b[..],14,2);for k:0..<76 {b[92+k]=b[16+k];}scan_put(b[..],64,192);scan_put(b[..],140,200);#assert ob_header(b[..]).ok;
 scan_put(b[..],96,32000);#assert !ob_header(b[..]).ok;scan_put(b[..],96,48000);scan_put(b[..],140,192);#assert !ob_header(b[..]).ok;
}
ob_fixture :: (b:[]u8) {for k:0..<b.count {b[k]=0;}scan_put(b,0,0x56415742);wav_u16(b,4,0xfeff);wav_u16(b,6,1);wav_u16(b,14,1);wav_u16(b,16,1);scan_put(b,20,48000);scan_put(b,24,14);scan_put(b,28,14);scan_put(b,64,128);scan_put(b,68,128);}
ob_header :: (b:[]u8)->ObWave {
 if b.count<16 || scan_u32(b,0)!=0x56415742 || ob_u16(b,4)!=0xfeff || ob_u16(b,6)!=1 || ob_u16(b,12)!=0 {return ObWave.{};}channels:=ob_u16(b,14);if channels<1 || channels>2 || b.count<16+channels*76 {return ObWave.{};}
 frames:=cast(int)scan_u32(b,24);rate:=cast(int)scan_u32(b,20);if frames<1 || frames>1000000 || rate!=48000 {return ObWave.{};}
 for c:0..<channels {p:=16+c*76;at:=cast(int)scan_u32(b,p+48);bytes:=(frames+13)/14*8;if ob_u16(b,p)!=1 || scan_u32(b,p+4)!=cast(u32)rate || scan_u32(b,p+8)!=cast(u32)frames || scan_u32(b,p+12)!=cast(u32)frames || at<16+channels*76 || at>b.count || bytes>b.count-at {return ObWave.{};}if c>0 {previous:=cast(int)scan_u32(b,64);if at<previous+bytes && previous<at+bytes {return ObWave.{};}}}
 return ObWave.{ok=true,channels=channels,rate=rate,frames=frames};
}
ob_decode :: (b:[]u8,h:ObWave,pcm:[]int)->bool {
 if !h.ok || pcm.count<h.frames*h.channels {return false;}
 for c:0..<h.channels {p:=16+c*76;at:=cast(int)scan_u32(b,p+48);h1:=ob_s16(b,p+70);h2:=ob_s16(b,p+72);
  for i:0..<h.frames {frame:=at+i/14*8;header:=cast(int)b[frame];predictor:=header/16;if predictor>7 {return false;}scale:=1<<(header%16);byte:=cast(int)b[frame+1+i%14/2];nibble:=ifx i%2==0 then byte/16 else byte%16;if nibble>=8 {nibble-=16;}sample:=((nibble*scale*2048)+1024+ob_s16(b,p+16+predictor*4)*h1+ob_s16(b,p+18+predictor*4)*h2)>>11;sample=ifx sample< -32768 then -32768 else ifx sample>32767 then 32767 else sample;pcm[i*h.channels+c]=sample;h2=h1;h1=sample;}
 }return true;
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}b:[2097152]u8;pcm:[2000000]int;out:[4000044]u8;n:=fs_read(args_at(a[..],0),b[..]);if n<0 {return 3;}data:=b[0..<n];h:=ob_header(data);if !h.ok || !ob_decode(data,h,pcm[..]) {return 4;}size:=wav_write(pcm[0..<h.frames*h.channels],h.channels,h.rate,out[..]);if size<0 {return 5;}#assert fs_write(args_at(a[..],1),cast(string)out[0..<size]);print("BWAV_PCM_PASS frames=% channels=% rate=% wav_bytes=% sample_hash=%\n",h.frames,h.channels,h.rate,size,wav_hash(pcm[0..<h.frames*h.channels]));return 0;
}
