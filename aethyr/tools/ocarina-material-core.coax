// Original FMAT bindings and UnifyTex aliases -> private normalized material records.
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "ocarina-bfres.coax";
MpNames :: struct {text:[2048][160]u8;n:[2048]int;count:int;}
mp_u64 :: (b:[]u8,p:int)->u64 {return cast(u64)ob_word(b,p)|(cast(u64)ob_word(b,p+4)<<32);}
mp_name :: (b:[]u8,p:int,e:[]u8)->string {id:=mp_u64(b,p);if id==0 {return "";}ids:=ob_ptr(e,0xb8);dic:=ob_ptr(e,0xc0);for i:0..<ob_int(e,dic+4) {if mp_u64(e,ids+i*8)==id {return ob_name(e,dic+32+i*16);}}return ob_name(b,p);}
mp_zstring :: (b:[]u8,p:int)->string {n:=p;while n<b.count && b[n]!=0 {n+=1;}#assert n<b.count;return cast(string)b[p..<n];}
mp_byml_string :: (b:[]u8,table:int,index:int)->string {#assert index>=0 && index<(ob_int(b,table)>>8);return mp_zstring(b,table+ob_int(b,table+4+index*4));}
#test "BYML alias records use little endian 24bit counts and exact string nodes" {b:[80]u8;b[0]='Y';b[1]='B';scan_put(b[..],4,16);scan_put(b[..],8,32);scan_put(b[..],12,48);scan_put(b[..],16,0x1c2);scan_put(b[..],20,8);b[24]='a';scan_put(b[..],32,0x1c2);scan_put(b[..],36,8);b[40]='b';scan_put(b[..],48,0x1c1);scan_put(b[..],52,0xa0000000);#assert mp_alias(b[..],"a")=="b" && mp_alias(b[..],"other")=="other";}
mp_alias :: (b:[]u8,name:string)->string {#assert cast(string)b[0..<2]=="YB";root:=ob_int(b,12);keys:=ob_int(b,4);strings:=ob_int(b,8);#assert b[root]==0xc1;for i:0..<(ob_int(b,root)>>8) {p:=root+4+i*8;key:=ob_int(b,p)&0xffffff;if mp_byml_string(b,keys,key)==name {#assert b[p+3]==0xa0;return mp_byml_string(b,strings,ob_int(b,p+4));}}return name;}
mp_layer :: (s:[]MpNames,b:[]u8,name:string)->int {if name=="" {return 0;}resolved:=name;for i:0..<8 {next:=mp_alias(b,resolved);if next==resolved {break;}resolved=next;}for i:0..<s[0].count {if cast(string)s[0].text[i][0..<s[0].n[i]]==resolved {return i+1;}}#assert s[0].count<2048 && resolved.count<160;i:=s[0].count;for c,k:resolved {s[0].text[i][k]=c;}s[0].n[i]=resolved.count;s[0].count+=1;return i+1;}
mp_texture :: (b:[]u8,e:[]u8,m:int,sampler:string)->string {d:=ob_ptr(b,m+0x38);n:=ob_int(b,d+4);for i:0..<n {if mp_name(b,d+32+i*16,e)==sampler {#assert i<cast(int)b[m+0xa3];return mp_name(b,ob_ptr(b,m+0x20)+i*8,e);}}return "";}
mp_parameter :: (b:[]u8,e:[]u8,m:int,name:string)->int {s:=ob_ptr(b,ob_ptr(b,m+0x10));list:=ob_ptr(b,s+0x20);for i:0..<ob_u16(b,s+0x4a) {p:=list+i*24;if mp_name(b,p+8,e)==name {return ob_ptr(b,m+0x58)+ob_u16(b,p+16);}}return -1;}
mp_render :: (b:[]u8,e:[]u8,m:int,name:string)->int {s:=ob_ptr(b,ob_ptr(b,m+0x10));list:=ob_ptr(b,s+0x10);for i:0..<ob_u16(b,s+0x48) {p:=list+i*16;if mp_name(b,p,e)==name {return ob_ptr(b,m+0x40)+ob_u16(b,ob_ptr(b,m+0x50)+i*2);}}return -1;}
mp_float :: (b:[]u8,p:int,otherwise:f32)->f32 {return ifx p<0 then otherwise else ob_float(b,p);}
mp_type :: (name:string)->int {return ifx name=="Mt_Hairs" then 1 else ifx name=="Mt_Skin" || name=="Mt_Face" || name=="Mt_Face_Eyelid" then 2 else ifx name=="Mt_Eye_Inner" then 3 else ifx name=="Mt_Eye_Outer" then 4 else ifx name=="Mt_Eyebrow" || name=="Mt_Eyelashes_01" || name=="Mt_Eyelashes_02" || name=="Mt_Eyelashes_03" then 5 else ifx name=="Mt_EyeShadow_test" then 6 else ifx name=="Mt_Cloth" || name=="Mt_Cloth_Pants" then 7 else 0;}
