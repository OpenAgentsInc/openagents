// Original FMAT bindings and UnifyTex aliases -> private normalized material records.
// tool.sh: stack-gib 2
#import "Basic";
#load "ocarina-material-core.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {return 2;}model:[8388608]u8;external:[65536]u8;aliases:[1048576]u8;out:[8192]u8;path:[4096]u8;names:[1]MpNames;list:[32768]u8;listed:=0;
 n:=fs_read(args_at(a[..],0),model[..]);en:=fs_read(args_at(a[..],1),external[..]);an:=fs_read(args_at(a[..],2),aliases[..]);#assert n>0 && en>0 && an>0;b:=model[0..<n];e:=external[0..<en];ab:=aliases[0..<an];fm:=ob_ptr(b,0x28);count:=ob_u16(b,fm+0x6c);#assert count==25;
 // First image fixes the shared texture array's dimensions. Keep the largest source atlas first.
 _:=mp_layer(names[..],ab,"Player_Child_Skin_Alb");
 for i:0..<count {m:=ob_ptr(b,fm+0x38)+i*0xb0;name:=mp_name(b,m+8,e);kind:=mp_type(name);base:=32+i*256;
  samplers:=[8]string.["_a0","_n0","_rgh0","_ao0","_n1","_gn1","_gn0","_a1"];
  for k:0..<8 {texture:=mp_texture(b,e,m,samplers[k]);if kind==1 && k==5 {texture="Player_Child_Hairs_Gn3";}if kind==1 && k==6 {texture="Player_Child_Hairs_Gn0";}if kind==3 && k==5 {texture="Eye_Inner_Mask_CmnTex_Chara_Eye_Gn3";}scan_put(out[..],base+k*4,cast(u32)mp_layer(names[..],ab,texture));}
  scan_put(out[..],base+16*4,cast(u32)kind);mode:=mp_render(b,e,m,"gsys_render_state_mode");mode_name:=ifx mode<0 then "opaque" else mp_name(b,mode,e);scan_put(out[..],base+17*4,ifx mode_name=="mask" then 1 else ifx mode_name=="translucent" then 2 else 0);
  cut:=mp_render(b,e,m,"gsys_alpha_test_value");scan_put(out[..],base+18*4,f32_bits(mp_float(b,cut,0.5)));scan_put(out[..],base+19*4,f32_bits(ifx kind==1 then 0.3f32 else ifx kind==2 then 0.5f32 else 0.7f32));
  for c:0..<4 {scan_put(out[..],base+(20+c)*4,f32_bits(1.0f32));}
  for c:0..<2 {p:=mp_parameter(b,e,m,[2]string.["ns_param_color0","ns_param_color1"][c]);for j:0..<4 {scan_put(out[..],base+(24+c*4+j)*4,f32_bits(ifx p>=0 then ob_float(b,p+j*4) else 1.0f32));}}
  for c:0..<2 {p:=mp_parameter(b,e,m,[2]string.["ns_tex_mtx0","ns_tex_mtx1"][c]);for j:0..<6 {scan_put(out[..],base+(32+c*6+j)*4,f32_bits(ifx p>=0 then ob_float(b,p+j*4) else ifx j==1 || j==2 then 1.0f32 else 0.0f32));}}
  for c:0..<8 {key:=[8]string.["ns_param_scalar0","ns_param_scalar1","ns_param_scalar2","ns_param_scalar3","ns_param_scalar4","ns_param_scalar5","ns_param_scalar6","ns_param_scalar7"][c];p:=mp_parameter(b,e,m,key);scan_put(out[..],base+(44+c)*4,f32_bits(mp_float(b,p,1)));}
  for j:0..<8 {scan_put(out[..],base+(52+j)*4,cast(u32)(ifx kind==7 && j<4 then 1 else 0));}
  scan_put(out[..],base+60*4,cast(u32)mp_layer(names[..],ab,mp_texture(b,e,m,"_mt0")));print("FMAT % type=% mode=%\n",name,kind,mode_name);
 }
 for i:0..<names[0].count {name:=cast(string)names[0].text[i][0..<names[0].n[i]];file:[256]u8;for c,k:name {file[k]=c;}for c,k:".png" {file[name.count+k]=c;}filename:=cast(string)file[0..<name.count+4];#assert fs_exists(fs_join(args_at(a[..],3),filename,path[..]));for c:filename {list[listed]=c;listed+=1;}list[listed]='\n';listed+=1;}
 scan_put(out[..],0,0x314d434f);scan_put(out[..],4,1);scan_put(out[..],8,cast(u32)count);scan_put(out[..],12,cast(u32)names[0].count);dest:=args_at(a[..],4);#assert fs_write(fs_join(dest,"link.materials",path[..]),cast(string)out[0..<32+count*256]);#assert fs_write(fs_join(dest,"link.textures",path[..]),cast(string)list[0..<listed]);print("Ocarina materials=% image_layers=%\n",count,names[0].count);return 0;
}
