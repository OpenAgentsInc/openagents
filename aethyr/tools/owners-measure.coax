// What two adjacent owners cost (aethyr/world/owners.coax, GitHub #12851), by link delay: a fight
// inside one owner against the same fight across the line, its messages and replica age, and a
// crowd of eight crossing the line: handoffs, ticks in flight, messages and replica age.
//   coax/web/tool.sh aethyr/tools/owners-measure.coax
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../tests/owners-oracle.coax";   // this program runs the fixture as code
#load "../world/owners.coax";
tool_main :: () -> int #export_c #effects(all) {
  for link: 0..<6 {
    w: [1] OwWorld;
    inside := ow_fight(w[..], -6, -2, link, 600);
    across := ow_fight(w[..], -2, 2, link, 600);
    msgs := w[0].messages; ticks := w[0].tick; age := w[0].most_age;
    c: [1] OwWorld; ow_crowd(c[..]); c[0].link = link;
    for t: 0..<120 { ow_tick(c[..]); }
    print("link % ticks: fight inside % ticks, across % (+%); across: % messages in % ticks, replica age max %; crowd of 8: % handoffs, % ticks in flight, % messages in 120 ticks, replica age max %\n",
      link, inside, across, across - inside, msgs, ticks, age, c[0].handoffs, c[0].flight_ticks, c[0].messages, c[0].most_age);
  }
  return 0;
}
