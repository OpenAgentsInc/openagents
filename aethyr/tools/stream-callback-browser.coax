scb_save :: (c: [] Cdp, expression: string, path: string) -> bool {
  value := cdp_evaluate(c,expression);if value < 0 {tool_errln(cdp_error(c));return false;}
  bytes: [8388608] u8;n := jv_str(cdp_doc(c),value,bytes[..]);
  return n > 0 && fs_write(path,cast(string) bytes[0..<n]);
}
