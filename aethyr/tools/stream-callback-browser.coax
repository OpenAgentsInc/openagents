  }
  path: [4096] u8;
  if !scb_save(c[..],"JSON.stringify(cb.beforeCapture)",fs_join(output,"before.json",path[..])) || !scb_save(c[..],"JSON.stringify(cb.afterCapture)",fs_join(output,"after.json",path[..])) || !scb_save(c[..],"(async()=>{const app=streamWalk,before=app.stats();cb.legs.push({cells:app.cells()});const cleanup=await app.close();window.fetch=cb.fetch;const records=[...cb.frames.flatMap(f=>f[13]),...cleanup.closingFrames.flatMap(f=>f.records)],key=r=>r.slice(2,5).join('/'),old=cb.key.map(String).join('/'),completed=records.filter(r=>+r[1]===0&&key(r)===old),destroyed=records.filter(r=>+r[1]===1&&key(r)===old),ready=records.filter(r=>+r[1]===2&&key(r)===old),callback=cb.callbacks.find(r=>r[0]===cb.row&&r[1]===String(cb.key[1])&&r[4]===1);if(completed.length!==1||destroyed.length!==1||!callback)throw Error('old completion/retirement count differs');const sizes=cb.pending.ptrs,mask=[0,1,4,2,3].reduce((n,p,i)=>n+(sizes[p]?1<<i:0),0),zero=cb.pending.bytes[0].split('').every(c=>c==='0'),events=cb.allocations.flatMap(a=>a.events.map(e=>[a.tick,...e])),frees=events.filter(e=>e[1]===1&&e[2]===cb.row&&e[3]===Number(cb.key[1])),noReuse=events.filter(e=>e[1]===0&&e[2]===cb.row&&e[3]!==Number(cb.key[1])).every(e=>e[0]>=+destroyed[0][0]);const words=[cb.row,Number(cb.key[1]),Number(cb.key[2]),cb.held.tick,cb.pending.tick,cb.releaseTick,callback[5],+completed[0][0],+destroyed[0][0],cb.probeBefore.row[10],cb.probeBefore.tick,cb.pending.row[8],cb.pending.row[9],cb.pending.row[10],mask,+cb.held.aborted,+cb.held.released,+completed[0][5],+completed[0][6],ready.length,destroyed.length,+cb.sameSnapshot,...cb.guards,+cb.samePixels,cb.probeBefore.tick,cb.probeAfter.tick,+zero,+(cb.currentSourceSHA===cb.expected),+(noReuse&&frees.length===mask.toString(2).split('1').length-1)];return JSON.stringify({schema:'aethyr.stream-walk-callback-history.v1',callbacks:{schema:'aethyr.stream-walk-callbacks.v1',qualification:'held actual response; old callback redelivery after physical join and newer generatio