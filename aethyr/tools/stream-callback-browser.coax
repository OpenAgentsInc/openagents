    wrapped: [16384] u8;fragments := [3] string.["(async()=>{try{return await (",script,");}catch(error){return JSON.stringify({error:String(error),stack:error.stack,stats:window.streamWalk?.stats(),pending:window.cb?.pending,held:window.cb?.held});}})()"];
