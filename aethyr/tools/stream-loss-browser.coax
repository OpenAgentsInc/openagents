// Actual muted WebGPU loss callbacks, deadline/late-device effects and drain.
// tool.sh: stack-gib 1
#load "../../coax/web/wasm-chrome.coax";
#load "../assets.coax" as assets;
slb_error :: (c: [] Cdp) {
  tool_errln(cdp_error(c)); raw := jv_raw(cdp_doc(c), 0);
  tool_errln(raw[0..<(ifx raw.count < 4096 then raw.count else 4096)]);
}
slb_save :: (c: [] Cdp, expression: string, path: string) -> bool {
  code: [32768] u8; pieces := [3] string.["(async()=>JSON.stringify(await (", expression, ")))()"];
  value := cdp_evaluate(c, wc_cat(code[..], pieces[..])); if value < 0 {
    slb_error(c); detail: [4096] u8;
    n := jv_str(cdp_doc(c), jv_path(cdp_doc(c), 0, "result.exceptionDetails.exception.description"), detail[..]);
    if n > 0 { tool_errln(cast(string) detail[0..<n]); } return false;
  }
  out: [4194304] u8; n := jv_str(cdp_doc(c), value, out[..]); if n <= 0 { slb_error(c); return false; } return fs_write(path, cast(string) out[0..<n]);
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) != 4 { tool_errln("usage: stream-loss-browser BASE SCENE_JSON NEW_OUTPUT MODE"); return 2; }
  mode := args_at(a[..], 3);
  if mode != "steady" && mode != "repeated" && mode != "adapter-failure" && mode != "deadline" && mode != "late-device" && mode != "restart" && mode != "frame-loss" && mode != "route" { return 2; }
  output := args_at(a[..], 2); if fs_exists(output) || !fs_mkdir(output) { return 2; }
  bytes: [65536] u8; nodes: [4096] JvNode; scene: [1] Jv; n := fs_read(args_at(a[..], 1), bytes[..]);
  if n < 1 || !jv_parse(scene[..], cast(string) bytes[0..<n], nodes[..]) { return 1; }
  root: [64] u8; identity: [64] u8; descriptor := jv_at(scene[0], jv_get(scene[0], 0, "manifests"), 0);
  if jv_str(scene[0], jv_get(scene[0], descriptor, "sha256"), root[..]) != 64 || !assets.asset_hex(assets.asset_id(cast(string) bytes[0..<n]), identity[..]) { return 1; }
  url: [4096] u8; digits: [32] u8; pieces := [8] string.[args_at(a[..], 0), "/aethyr/host/tests/stream-walk.html?root=", cast(string) root[..], "&scene_sha=", cast(string) identity[..], "&scene_bytes=", wc_dec(digits[..], n), "&width=320&height=180&tier=0"];
  c: [1] Cdp; if !cdp_launch(c[..], 320, 180, "aethyr-stream-loss-") { return 1; } defer { cdp_close(c[..]); }
  params: [8192] u8; j: [1] Jo; jo_start(j[..], params[..]); jo_obj(j[..]); jo_key(j[..], "url"); jo_str(j[..], wc_cat(url[..], pieces[..])); jo_end(j[..]);
  if cdp_call(c[..], "Page.navigate", jo_text(j[..]), CDP_CALL_MS) < 0 { return 1; }
  until := proc_now_ms() + 30000; ready := false;
  while proc_now_ms() < until { state := wc_eval(c[..], "window.streamError||window.streamReady||false"); if state == "true" { ready = true; break; } if state != "false" && state != "" { tool_errln(state); return 1; } proc_sleep(50); }
  if !ready { return 1; }
  mode_source: [128] u8; mode_parts := [3] string.["window.lossMode='", mode, "';true"];
  if wc_eval(c[..], wc_cat(mode_source[..], mode_parts[..])) != "true" { return 1; }
  setup := "(async()=>{const app=streamWalk;if(/swiftshader|llvmpipe|software/i.test(JSON.stringify(app.adapter)))throw Error('hardware WebGPU required');window.lossFrames=[];window.lossStep=async(ns,d)=>{const f=await app.step(ns,d);lossFrames.push([f.frameNs,f.direction,f.tick,...f.position,f.active,f.drawn,f.updated,f.declared,f.cpu,f.gpuBytes,f.frameMs,f.records,f.stepDigests.join('')]);return f;};for(let i=0;i<32;i++){await lossStep(62500000,0);await app.settle();}window.lossBefore={digest:app.stateDigest(),cells:app.cells(),stats:app.stats(),hud:app.hud()};window.lossStates=[];window.lossLegs=[];window.lossWait=async(expected)=>{const until=performance.now()+12000;while(performance.now()<until){const s=app.deviceStatus();if(s.state===expected)return s;if(s.state==='stopped'&&expected!=='stopped')throw Error(JSON.stringify(s));await new Promise(r=>setTimeout(r,5));}throw Error('loss observer timed out '+JSON.stringify(app.deviceStatus()));};return true;})()";
  if wc_eval(c[..], setup) != "true" { tool_errln(cdp_error(c[..])); return 1; }
  path: [4096] u8;
  if !slb_save(c[..], "streamWalk.capture()", fs_join(output, "before.json", path[..])) { return 1; }
  inject := "true";
  if mode == "adapter-failure" { inject = "(window.lossOriginalAdapter=navigator.gpu.requestAdapter.bind(navigator.gpu),navigator.gpu.requestAdapter=()=>Promise.resolve(null),true)"; }
  if mode == "deadline" { inject = "(window.lossOriginalAdapter=navigator.gpu.requestAdapter.bind(navigator.gpu),navigator.gpu.requestAdapter=()=>new Promise(resolve=>{window.lossRelease=async()=>resolve(await lossOriginalAdapter({powerPreference:'high-performance'}));}),true)"; }
  if mode == "late-device" { inject = "(()=>{const original=GPUAdapter.prototype.requestDevice;window.lossOriginalDevice=original;GPUAdapter.prototype.requestDevice=function(...args){return original.apply(this,args).then(device=>{window.lossLateDevice=device;return new Promise(resolve=>{window.lossRelease=()=>resolve(device);});});};return true;})()"; }
  if mode == "restart" { inject = "(()=>{const original=GPUAdapter.prototype.requestDevice,compile=GPUShaderModule.prototype.getCompilationInfo;let once=true;GPUAdapter.prototype.requestDevice=function(...args){return original.apply(this,args).then(device=>{if(once){once=false;window.lossRestartDevice=device;}return device;});};GPUShaderModule.prototype.getCompilationInfo=async function(){const result=await compile.call(this);if(window.lossRestartDevice){const device=lossRestartDevice;window.lossRestartDevice=null;device.destroy();await device.lost;}return result;};return true;})()"; }
  if mode == "frame-loss" { inject = "(()=>{const done=GPUQueue.prototype.onSubmittedWorkDone;let armed=true;GPUQueue.prototype.onSubmittedWorkDone=function(){const result=done.call(this);if(armed){armed=false;streamWalk.loseDevice();}return result;};return true;})()"; }
  if wc_eval(c[..], inject) != "true" { tool_errln(cdp_error(c[..])); return 1; }
  action := "(async()=>{streamWalk.loseDevice();const s=await lossWait('recovered');lossStates.push(s);return true;})()";
  if mode == "repeated" { action = "(async()=>{for(let i=1;i<=3;i++){streamWalk.loseDevice();const until=performance.now()+12000;while(streamWalk.deviceStatus().serial<i||streamWalk.deviceStatus().state==='recovering'){if(performance.now()>until)throw Error('repeated loss timed out');await new Promise(r=>setTimeout(r,5));}const s=await lossWait('recovered');if(s.losses!==i)throw Error('loss count');lossStates.push(s);}streamWalk.loseDevice();lossStates.push(await lossWait('stopped'));return true;})()"; }
  if mode == "adapter-failure" || mode == "deadline" || mode == "late-device" { action = "(async()=>{streamWalk.loseDevice();const until=performance.now()+12000;while(!['recovering','stopped'].includes(streamWalk.deviceStatus().state)){if(performance.now()>until)throw Error('device-loss callback did not arrive');await new Promise(r=>setTimeout(r,1));}window.lossActiveFaceBlocked=false;try{await streamWalk.step(15625000,1,true);}catch{lossActiveFaceBlocked=true;}if(!lossActiveFaceBlocked)throw Error('SDK advanced a replacement or stopped session');const s=await lossWait('stopped');lossStates.push(s);window.lossStoppedAt=performance.now();if(window.lossRelease){await lossRelease();if(window.lossLateDevice){const lost=await lossLateDevice.lost;if(lost.reason!=='destroyed')throw Error('late device survived');}await new Promise(r=>setTimeout(r,30));}return true;})()"; }
  if mode == "frame-loss" { action = "(async()=>{await lossStep(62500000,1);lossStates.push(await lossWait('recovered'));return true;})()"; }
  if mode == "route" { action = "(async()=>{const app=streamWalk;for(const direction of [1,-1]){for(let i=0;i<1600;i++){await lossStep(62500000,direction);if(i%20===0)await app.settle();if(i===800){await app.settle();const before=app.stateDigest(),tick=app.stats().info[0],serial=app.deviceStatus().serial;app.loseDevice();const until=performance.now()+12000;while(app.deviceStatus().serial===serial||app.deviceStatus().state==='recovering'){if(performance.now()>until)throw Error('route loss timed out');await new Promise(r=>setTimeout(r,5));}const s=await lossWait('recovered');if(app.stateDigest()!==before||app.stats().info[0]!==tick)throw Error('automatic route replacement changed canonical state');lossStates.push({...s,digest:before,tick});}}lossLegs.push({cells:app.cells(),last:lossFrames.at(-1),hud:app.hud()});}return true;})()"; }
  if wc_eval(c[..], action) != "true" { slb_error(c[..]); tool_errln(wc_eval(c[..], "JSON.stringify(streamWalk.deviceStatus())")); return 1; }
  if mode == "steady" || mode == "restart" || mode == "frame-loss" || mode == "route" {
    if !slb_save(c[..], "streamWalk.capture()", fs_join(output, "after.json", path[..])) { return 1; }
  }
  final := "(async()=>{const app=streamWalk,after={digest:app.stateDigest(),cells:app.cells(),stats:app.stats(),hud:app.hud(),status:app.deviceStatus()};let blocked=false,faceBlocked=null;if(after.status.state==='stopped'){try{await app.step(15625000,1);}catch{blocked=true;}if(!blocked)throw Error('stopped simulation advanced');faceBlocked=false;try{await app.step(15625000,1,true);}catch{faceBlocked=true;}if(!faceBlocked)throw Error('SDK allowed a stopped paid frame');}else{await lossStep(15625000,0);}if(!lossLegs.length)lossLegs.push({cells:app.cells()});else{lossLegs.at(-1).cells=app.cells();lossLegs.at(-1).last=lossFrames.at(-1);}const cleanup=await app.close();if(cleanup.info[12]||cleanup.info[13]||cleanup.info[14]||cleanup.gpuErrors.length)throw Error('loss owners did not drain');return {schema:'aethyr.stream-walk-loss.v1',mode:lossMode,profile:app.profile,adapter:app.adapter,before:lossBefore,after,states:lossStates,stoppedAt:window.lossStoppedAt||null,blocked,faceBlocked,frames:lossFrames,legs:lossLegs,cleanup,lateDeviceDestroyed:!!window.lossLateDevice};})()";
  if !slb_save(c[..], final, fs_join(output, "receipt.json", path[..])) { return 1; }
  if mode == "deadline" || mode == "late-device" {
    if !slb_save(c[..], "({activeFaceBlocked:lossActiveFaceBlocked})", fs_join(output, "active-frame-gate.json", path[..])) { return 1; }
  }
  print("PASS actual streaming device-loss mode %\n", mode); return 0;
}
