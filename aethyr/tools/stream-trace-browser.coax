// Actual diagnostic pressure while a concrete browser source/cancel stays live.
// tool.sh: stack-gib 1
#load "stream-walk-faults.coax";
#load "../assets.coax" as assets;
stb_save :: (c:[]Cdp,expression:string,path:string)->bool {
  at:=cdp_evaluate(c,expression);if at<0 {tool_errln(cdp_error(c));return false;}
  out:[16777216]u8;n:=jv_str(cdp_doc(c),at,out[..]);return n>0 && fs_write(path,cast(string)out[0..<n]);
}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || (args_count(a[..])!=4 && args_count(a[..])!=6) {tool_errln("usage: stream-trace-browser BASE SCENE_JSON TRANSPORT_SHA NEW_OUTPUT [CAPACITY OWNER]");return 2;}
  capacity:=ifx args_count(a[..])==6 then args_whole(args_at(a[..],4)) else 32;owner:=ifx args_count(a[..])==6 then args_whole(args_at(a[..],5)) else 5;
  if capacity<1 || capacity>2048 || (owner!=4 && owner!=5) || fs_exists(args_at(a[..],3)) || !fs_mkdir(args_at(a[..],3)) {return 2;}
  raw:[32768]u8;n:=fs_read(args_at(a[..],1),raw[..]);d:[1]Jv;nodes:[4096]JvNode;hex:[64]u8;root:[64]u8;
  if n<1 || !jv_parse(d[..],cast(string)raw[0..<n],nodes[..]) || !assets.asset_hex(assets.asset_id(cast(string)raw[0..<n]),hex[..]) {return 1;}
  item:=jv_at(d[0],jv_get(d[0],0,"manifests"),0);if jv_str(d[0],jv_get(d[0],item,"sha256"),root[..])!=64 {return 1;}
  c:[1]Cdp;if !cdp_launch(c[..],320,180,"aethyr-trace-capacity-") {return 1;}defer{cdp_close(c[..]);}
  if !swf_install(c[..]) {return 1;}
  script:="(()=>{window.traceProbe={offers:0,refused:0};const instantiate=WebAssembly.instantiate,Words=BigInt64Array;window.BigInt64Array=new Proxy(Words,{construct(target,args){const value=Reflect.construct(target,args);traceProbe.words=value;return value;}});WebAssembly.instantiate=async function(module,imports){const result=await instantiate.call(this,module,imports),instance=result.instance||result,x=instance.exports;if(!x.sw_trace_offer)return result;traceProbe.x=x;traceProbe.memory=imports.env.memory;const exports={...x,sw_trace_offer(){traceProbe.offers++;const index=x.sw_trace_offer();if(index<0n)traceProbe.refused++;return index;}};return result.instance?{...result,instance:{exports}}:{exports};};})()";
  parameters:[8192]u8;j:[1]Jo;jo_start(j[..],parameters[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],script);jo_end(j[..]);if cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),CDP_CALL_MS)<0 {return 1;}
  digits:[3][32]u8;url:[4096]u8;parts:=[12]string.[args_at(a[..],0),"/aethyr/host/tests/stream-walk.html?root=",cast(string)root[..],"&scene_sha=",cast(string)hex[..],"&scene_bytes=",wc_dec(digits[0][..],n),"&width=320&height=180&transport_sha=",args_at(a[..],2),"&trace_capacity=",wc_dec(digits[1][..],capacity),""];
  jo_start(j[..],parameters[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],wc_cat(url[..],parts[..]));jo_end(j[..]);if cdp_call(c[..],"Page.navigate",jo_text(j[..]),CDP_CALL_MS)<0 {return 1;}
  deadline:=proc_now_ms()+30000;ready:=false;while proc_now_ms()<deadline {state:=wc_eval(c[..],"window.streamError||window.streamReady||false");if state=="true" {ready=true;break;}if state!="false" && state!="" {tool_errln(state);return 1;}proc_sleep(25);}if !ready {return 1;}
  selection:[512]u8;chosen:=[3]string.["traceProbe.row=",wc_dec(digits[2][..],owner),";true"];if wc_eval(c[..],wc_cat(selection[..],chosen[..]))!="true" {return 1;}
  run:="(async()=>{try{const p=traceProbe,app=streamWalk,fetcher=window.fetch;let releaseCancel,held=false,cancelling=false,closed=false;window.fetch=async function(...args){const row=window.sourceAllocatedOwner,r=await fetcher.apply(this,args);if(held||row!==p.row)return r;held=true;const bytes=new Uint8Array(await r.arrayBuffer());p.url=String(args[0]);return new Response(new ReadableStream({start(c){c.enqueue(bytes);},cancel(){cancelling=true;return new Promise(resolve=>{releaseCancel=resolve;});}}));};const frames=[],allocations=[],stages=[];for(let i=0;i<12000;i++){const direction=Number(p.x.sw_trace_info(0))===2048?(Math.floor(i/1600)%2?-1:1):0,f=await app.step(62500000,direction);frames.push([f.frameNs,f.direction,f.tick,...f.position,f.active,f.drawn,f.updated,f.declared,f.cpu,f.gpuBytes,f.frameMs,f.records,f.stepDigests.join('')]);if(f.allocations.length)allocations.push({tick:f.tick,events:f.allocations});stages.push(...f.stages);if(p.x.sw_trace_info(3)===1n&&held)break;await new Promise(r=>setTimeout(r,0));}if(!held||p.x.sw_trace_info(3)!==1n)throw Error('actual trace did not reach its capacity');const before=app.stats(),cells=app.cells(),key=[p.row,String(p.x.sw_host_row(p.row,10)),String(p.x.sw_host_command(0,0,2))],pointer=p.x.sw_host_pointer(p.row,0),bytes=Number(p.x.sw_host_row(p.row,1));if(!pointer||p.x.sw_host_row(p.row,8)!==1n)throw Error('held source lost its loading owner');const closing=app.close().then(r=>{closed=true;return r;});for(let i=0;i<500&&!cancelling;i++)await new Promise(r=>setTimeout(r,1));if(!cancelling||!releaseCancel)throw Error('actual reader cancel did not begin');const heldDuringCancel=!closed&&p.x.sw_host_pointer(p.row,0)===pointer&&p.x.sw_host_row(p.row,8)===1n,retained=app.stats();releaseCancel();const cleanup=await Promise.race([closing,new Promise((_,reject)=>setTimeout(()=>reject(Error('trace exhaustion drain exceeded five seconds')),5000))]);window.fetch=fetcher;const binding=app.transportBinding();p.receipt={diagnostic:{schema:'aethyr.trace-capacity-check.v1',heldDuringCancel,capacity:binding.capacity,recorded:binding.events.length,dropped:binding.dropped,offers:p.offers,refused:p.refused,traceZero:p.words.every(v=>v===0n),engineZero:new Uint8Array(p.memory.buffer).every(v=>v===0),url:p.url,pointer,sourceBytes:bytes,retained},profile:app.profile,adapter:app.adapter,frames,allocations,stages,legs:[{cells}],before,cleanup,sourceSchema:'aethyr.recorded-source.v1',sourceSnapshots,sourceSnapshotBytes,sourceSnapshotError};return true;}catch(e){traceProbe.failure={error:String(e),stack:e.stack,stats:window.streamWalk?.stats()};return JSON.stringify(traceProbe.failure);}})()";
  result:=wc_eval(c[..],run);path:[4096]u8;if result!="true" {saved:=fs_write(fs_join(args_at(a[..],3),"failure.json",path[..]),result);tool_errln(result);return 1;}
  if !stb_save(c[..],"JSON.stringify(traceProbe.receipt)",fs_join(args_at(a[..],3),"history.json",path[..])) || !stb_save(c[..],"JSON.stringify(streamWalk.transportBinding())",fs_join(args_at(a[..],3),"history.json.transport.json",path[..])) {return 1;}
  check:=wc_eval(c[..],"(()=>{const r=traceProbe.receipt,b=streamWalk.transportBinding(),d=r.diagnostic;return b.schema==='aethyr.stream-transport-observation.v2'&&!b.complete&&b.exhausted&&BigInt(b.dropped)>0n&&b.events.length===b.capacity&&d.offers===d.recorded+Number(d.dropped)&&d.refused===Number(d.dropped)&&d.heldDuringCancel&&d.traceZero&&d.engineZero&&r.cleanup.transport.storage[0]===1&&r.cleanup.transport.storage[1]===8388608&&['owners','loading','published','readers','sdkPending'].every(k=>r.cleanup.transport[k]===0)&&[8,10,11,12,13,14,22,23].every(f=>r.cleanup.info[f]===0)&&!r.cleanup.gpuErrors.length;})()");
  print("Actual trace capacity %, held owner %, safe join/zero/release: %\n",capacity,owner,check);return ifx check=="true" then 0 else 1;
}
