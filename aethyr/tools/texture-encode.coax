// The offline texture block encoder (GitHub #13014, part of #12998), and its check against
// independent decoders. The encoders are aethyr/render/texture-encode.coax's: BC7 (mode 6), BC5,
// and ASTC 4x4 and 6x6 for colour and for normals. The block files are the ones
// verse/tools/ocarina-texture-core.coax hands its reference runners: ASTC's .astc (magic
// 0x5CA1AB13, block size, then the image size in three 24-bit fields) for ARM astcenc 5.7.1, and a
// 16-byte BCX1 header (magic, BNTX channel format 0x20 BC7 or 0x1e BC5, width, height) for
// ocarina-bc-reference.c, the pinned bcdec runner.
//
//   coax/web/tool.sh aethyr/tools/texture-encode.coax encode IMAGE OUT --format F
//       F is bc7, bc5, astc4, astc6, astc4-normal or astc6-normal; OUT is .astc or .bcx
//   coax/web/tool.sh aethyr/tools/texture-encode.coax check --astcenc PATH --bc PATH --out DIR
//       [--pack PACK [--layers N]] [--image FILE]... [--normal FILE]... [--synthetic-normal SIDE]
//   coax/bin/coax test aethyr/tools/texture-encode.coax        # its own checks
//
// check encodes each image in every format for its kind (colour: bc7, astc4, astc6; normal: bc5,
// astc4-normal, astc6-normal), decodes the blocks with the reference decoder (astcenc -ds for
// colour, sRGB as the layers are, and -dl for normals; the bcdec runner for BC), and compares that
// with the source: colour as PSNR over RGB, normals as the angle between the normal the source's
// X and Y give and the one the decoded X and Y give (Z = sqrt(1 - X^2 - Y^2) both times, as the
// shader rebuilds it), mean and worst, in degrees.
// It also decodes every block with this file's own decoder and counts the texels where the two
// differ by more than one level: a block the reference reads otherwise is a bug in the encoder's
// bit layout. --pack takes every texture layer of a realm pack (or the first N); --synthetic-normal
// draws a normal map of overlapping bumps, so the normal check needs no private source.
// DIR/quality.tsv has a line per image and format (NAME KIND FORMAT WIDTH HEIGHT PSNR_DB_X100
// MEAN_ANGLE_MDEG MAX_ANGLE_MDEG MISMATCHED BYTES) and DIR/summary.tsv the totals per format
// (PSNR over all texels pooled). Exit 0 when every block read back the same both ways, 1 when one
// didn't or a decoder failed, 2 on bad usage.
// tool.sh: stack-gib 3
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/image/image.coax";
#load "../forge/pack.coax";
#load "../render/texture-encode.coax";

TQ_SIDE :: 4096;
TQ_PIXELS :: TQ_SIDE * TQ_SIDE * 4;

// ---- numbers ---------------------------------------------------------------------------------

tq_log10 :: (x: f64) -> f64 { return log(x) / 2.302585092994046; }   // log: coax/lib/compiler/strict-math.coax
// atan(x) for x >= 0: reduced below tan(pi/12), then its series.
tq_atan :: (x: f64) -> f64 {
  if x > 1.0 { return 1.5707963267948966 - tq_atan(1.0 / x); } // mutant: equivalent (at x == 1 both give pi/4)
  if x > 0.2679491924311228 { return 0.5235987755982988 + tq_atan((x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772)); } // mutant: equivalent (at tan(pi/12) both reductions give the same angle)
  term := x; x2 := x * x; sum := 0.0;
  for i: 0..<30 { s := ifx i % 2 == 0 then 1.0 else -1.0; sum += s * term / cast(f64) (2 * i + 1); term *= x2; } // mutant: equivalent (the 31st term is below f64's last place for x <= tan(pi/12))
  return sum;
}
// The angle between two unit vectors, in degrees: 2 atan(|a - b| / |a + b|), steady near 0.
tq_angle :: (a: [3] f64, b: [3] f64) -> f64 {
  d := 0.0; s := 0.0;
  for k: 0..<3 { d += (a[k] - b[k]) * (a[k] - b[k]); s += (a[k] + b[k]) * (a[k] + b[k]); }
  if s <= 0.0 { return 180.0; } // mutant: equivalent (at s == 0, atan of infinity is also 180)
  return 2.0 * tq_atan(sqrt(d) / sqrt(s)) * 57.29577951308232;
}
// A normal from two 8-bit channels (0..255 -> -1..1), Z rebuilt and the whole normalized.
tq_normal_xy :: (x: int, y: int) -> [3] f64 {
  n: [3] f64; n[0] = cast(f64) x / 127.5 - 1.0; n[1] = cast(f64) y / 127.5 - 1.0;
  zz := 1.0 - n[0] * n[0] - n[1] * n[1]; n[2] = ifx zz > 0.0 then sqrt(zz) else 0.0; // mutant: equivalent (sqrt(0) is 0)
  l := sqrt(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]); for k: 0..<3 { n[k] /= l; }
  return n;
}
#test "logarithms, arctangents and normal angles" {
  #assert abs(tq_log10(1.0)) < 1.0e-12 && abs(tq_log10(1000.0) - 3.0) < 1.0e-12 && abs(tq_log10(0.01) + 2.0) < 1.0e-12;
  #assert abs(tq_atan(1.0) - 0.7853981633974483) < 1.0e-12 && abs(tq_atan(0.0)) < 1.0e-15 && abs(tq_atan(1.0e6) - 1.5707953267948966) < 1.0e-9 && abs(tq_atan(0.3) - 0.2914567944778671) < 1.0e-12;
  up := [3] f64.[0.0, 0.0, 1.0]; side := [3] f64.[1.0, 0.0, 0.0]; down := [3] f64.[0.0, 0.0, -1.0];
  #assert abs(tq_angle(up, side) - 90.0) < 1.0e-9 && tq_angle(up, up) == 0.0 && tq_angle(up, down) == 180.0;
  n := tq_normal_xy(255, 128); #assert n[0] > 0.999 && n[2] < 0.05;
  f := tq_normal_xy(128, 128); #assert f[2] > 0.9999;
  #assert abs(tq_angle(tq_normal_xy(255, 128), side)) < 3.0 && abs(tq_angle(tq_normal_xy(128, 128), up)) < 0.5;
  over := tq_normal_xy(255, 255); #assert over[2] == 0.0 && abs(over[0] - over[1]) < 1.0e-12 && abs(over[0] - 0.7071067811865476) < 1.0e-12;
  lo := tq_normal_xy(0, 51); #assert abs(lo[0] + 1.0 / sqrt(1.36)) < 1.0e-12 && abs(lo[1] + 0.6 / sqrt(1.36)) < 1.0e-12 && lo[2] == 0.0;
  mid := tq_normal_xy(51, 204); #assert abs(mid[0] + 0.6) < 1.0e-12 && abs(mid[1] - 0.6) < 1.0e-12 && abs(mid[2] - sqrt(0.28)) < 1.0e-12;
  #assert abs(tq_atan(0.1) - 0.09966865249116204) < 1.0e-15 && abs(tq_atan(3.0) - 1.2490457723982544) < 1.0e-12;
}
// PSNR in hundredths of a dB from a squared error over `samples` 8-bit samples (99999 for none).
tq_psnr :: (sse: int, samples: int) -> int {
  if sse <= 0 || samples <= 0 { return 99999; }
  mse := cast(f64) sse / cast(f64) samples;
  return cast(int) floor(1000.0 * tq_log10(65025.0 / mse) + 0.5);
}
#test "PSNR in hundredths of a dB" { #assert tq_psnr(65025, 1) == 0 && tq_psnr(65025, 100) == 2000 && tq_psnr(1, 1) == 4813 && tq_psnr(0, 9) == 99999 && tq_psnr(5, 0) == 99999; }

// ---- block files -----------------------------------------------------------------------------

tq_u32 :: (out: []u8, at: int, v: int) { for k: 0..<4 { out[at + k] = cast,trunc(u8) (v >> (8 * k)); } }
// The 16-byte header a reference decoder reads ahead of the blocks.
tq_header :: (format: int, w: int, h: int, out: []u8) {
  for k: 0..<16 { out[k] = 0; } // mutant: equivalent (byte 0 is always written after)
  if format == TE_BC7 || format == TE_BC5 { tq_u32(out, 0, 0x31584342); tq_u32(out, 4, ifx format == TE_BC7 then 0x20 else 0x1e); tq_u32(out, 8, w); tq_u32(out, 12, h); return; }
  tq_u32(out, 0, 0x5ca1ab13); b := te_block_w(format); out[4] = cast(u8) b; out[5] = cast(u8) b; out[6] = 1;
  for k: 0..<3 { out[7 + k] = cast,trunc(u8) (w >> (8 * k)); out[10 + k] = cast,trunc(u8) (h >> (8 * k)); }
  out[13] = 1;
}
#test "the block files carry the headers the reference runners read" {
  h: [16] u8; for k: 0..<16 { h[k] = 9; } tq_header(TE_BC7, 0x10203, 7, h[..]); #assert h[0] == 0x42 && h[3] == 0x31 && h[4] == 0x20 && h[8] == 3 && h[9] == 2 && h[10] == 1 && h[12] == 7;
  tq_header(TE_BC5, 4, 4, h[..]); #assert h[4] == 0x1e;
  for k: 0..<16 { h[k] = 9; } tq_header(TE_ASTC6, 0x10203, 0x40506, h[..]); #assert h[0] == 0x13 && h[1] == 0xab && h[2] == 0xa1 && h[3] == 0x5c && h[4] == 6 && h[5] == 6 && h[6] == 1;
  #assert h[7] == 3 && h[8] == 2 && h[9] == 1 && h[10] == 6 && h[11] == 5 && h[12] == 4 && h[13] == 1 && h[14] == 0 && h[15] == 0;
}
TqName :: struct { name: string; format: int; normal: bool; }
TQ_FORMATS :: [6] TqName.[TqName.{name = "bc7", format = TE_BC7}, TqName.{name = "astc4", format = TE_ASTC4}, TqName.{name = "astc6", format = TE_ASTC6},
                          TqName.{name = "bc5", format = TE_BC5, normal = true}, TqName.{name = "astc4-normal", format = TE_ASTC4_NORMAL, normal = true}, TqName.{name = "astc6-normal", format = TE_ASTC6_NORMAL, normal = true}];
tq_format :: (name: string) -> int { for f: TQ_FORMATS { if f.name == name { return f.format; } } return 0; }
#test "format names" { #assert tq_format("bc7") == TE_BC7 && tq_format("astc6-normal") == TE_ASTC6_NORMAL && tq_format("bc5") == TE_BC5 && tq_format("etc2") == 0; }

// ---- the check -------------------------------------------------------------------------------

TqBuf :: struct { b: [1048576] u8; n: int; }
tq_put :: (o: []TqBuf, t: string) { for c: t { if o[0].n < o[0].b.count { o[0].b[o[0].n] = c; o[0].n += 1; } } }
tq_int :: (o: []TqBuf, v: int) {
  if v < 0 { tq_put(o, "-"); tq_int(o, -v); return; }
  d: [20] u8; n := 0; x := v; if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; tq_put(o, cast(string) e[..]); }
}
tq_hundredths :: (o: []TqBuf, v: int) { tq_int(o, v / 100); tq_put(o, "."); r := v % 100; if r < 10 { tq_put(o, "0"); } tq_int(o, r); }
tq_text :: (o: []TqBuf) -> string { return cast(string) o[0].b[0..<o[0].n]; }

// Totals per format over every image checked.
TqTotal :: struct { sse: int; samples: int; angle_sum: f64; angle_max: f64; texels: int; mismatched: int; bytes: int; images: int; }
TqState :: struct {
  astcenc: string; bc: string; out: string;
  totals: [6] TqTotal; rows: [1] TqBuf; failed: bool;
  blocks: [TQ_PIXELS / 4 + 16] u8; reference: [TQ_PIXELS] u8; own: [TQ_PIXELS] u8; png: [TQ_PIXELS + 65536] u8; work: [TQ_PIXELS + TQ_SIDE * 8 + 65536] u8;
}
tq_run :: (argv: []string) -> bool {
  out: [8192] u8; err: [8192] u8; r := proc_run(argv, 600000, out[..], err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out { tool_err("texture-encode: "); tool_err(argv[0]); tool_err(" failed: "); tool_errln(cast(string) err[0..<r.err_n]); return false; }
  return true;
}
// One image in one format: encode, reference-decode, compare. false when a decoder failed.
tq_check_one :: (st: []TqState, name: string, img: []u8, w: int, h: int, f: int) -> bool {
  format := TQ_FORMATS[f].format; normal := TQ_FORMATS[f].normal; srgb := !normal && format != TE_BC7 && format != TE_BC5;
  n := te_image_bytes(format, w, h);
  _ := te_encode_image(format, img, w, h, srgb, st[0].blocks[16..<16 + n]);
  tq_header(format, w, h, st[0].blocks[0..<16]);
  paths: [3][4096] u8; bc := format == TE_BC7 || format == TE_BC5;
  blockfile := fs_join(st[0].out, ifx bc then "blocks.bcx" else "blocks.astc", paths[0][..]);
  if !fs_write(blockfile, cast(string) st[0].blocks[0..<16 + n]) { tool_errln("texture-encode: cannot write the block file"); return false; }
  if bc {
    raw := fs_join(st[0].out, "reference.rgba", paths[1][..]);
    argv := [3] string.[st[0].bc, blockfile, raw]; if !tq_run(argv[..]) { return false; }
    if fs_read(raw, st[0].reference[..]) != w * h * 4 { tool_errln("texture-encode: the BC reference wrote the wrong size"); return false; }
  } else {
    pngfile := fs_join(st[0].out, "reference.png", paths[1][..]);
    argv := [4] string.[st[0].astcenc, ifx srgb then "-ds" else "-dl", blockfile, pngfile]; if !tq_run(argv[..]) { return false; }
    pn := fs_read(pngfile, st[0].png[..]); info := img_info(st[0].png[0..<pn]);
    if pn <= 0 || info.status != IMG_OK || info.w != w || info.h != h || info.work > st[0].work.count || img_decode(st[0].png[0..<pn], st[0].work[..], st[0].reference[..]) != IMG_OK { tool_errln("texture-encode: astcenc's image did not read back"); return false; }
    if normal { for i: 0..<w * h { st[0].reference[i * 4 + 1] = st[0].reference[i * 4 + 3]; st[0].reference[i * 4 + 2] = 0; st[0].reference[i * 4 + 3] = 255; } }
  }
  if !te_decode_image(format, st[0].blocks[16..<16 + n], w, h, srgb, st[0].own[..]) { tool_errln("texture-encode: a block did not decode with its own decoder"); return false; }
  mismatched := 0; sse := 0; asum := 0.0; amax := 0.0;
  for i: 0..<w * h {
    for c: 0..<3 { d := cast(int) st[0].reference[i * 4 + c] - cast(int) st[0].own[i * 4 + c]; if d > 1 || d < -1 { mismatched += 1; break; } }
    if normal {
      for c: 0..<2 { d := cast(int) st[0].reference[i * 4 + c] - cast(int) img[i * 4 + c]; sse += d * d; }
      a := tq_angle(tq_normal_xy(cast(int) img[i * 4], cast(int) img[i * 4 + 1]), tq_normal_xy(cast(int) st[0].reference[i * 4], cast(int) st[0].reference[i * 4 + 1]));
      asum += a; if a > amax { amax = a; }
    } else { for c: 0..<3 { d := cast(int) st[0].reference[i * 4 + c] - cast(int) img[i * 4 + c]; sse += d * d; } }
  }
  samples := w * h * (ifx normal then 2 else 3);
  t := st[0].totals[f]; t.sse += sse; t.samples += samples; t.angle_sum += asum; if amax > t.angle_max { t.angle_max = amax; } t.texels += w * h; t.mismatched += mismatched; t.bytes += n; t.images += 1; st[0].totals[f] = t;
  if mismatched > 0 { st[0].failed = true; }
  r := st[0].rows[..];
  tq_put(r, name); tq_put(r, ifx normal then "\tnormal\t" else "\tcolour\t"); tq_put(r, TQ_FORMATS[f].name);
  vals := [7] int.[w, h, tq_psnr(sse, samples), ifx normal then cast(int) floor(asum / cast(f64) (w * h) * 1000.0 + 0.5) else 0, ifx normal then cast(int) floor(amax * 1000.0 + 0.5) else 0, mismatched, n];
  for v: vals { tq_put(r, "\t"); tq_int(r, v); }
  tq_put(r, "\n");
  return true;
}
tq_check_image :: (st: []TqState, name: string, img: []u8, w: int, h: int, normal: bool) -> bool {
  for f: 0..<TQ_FORMATS.count {
    if TQ_FORMATS[f].normal != normal { continue; }
    if !tq_check_one(st, name, img, w, h, f) { return false; }
  }
  print("texture-encode: checked % (%x%, %)\n", name, w, h, ifx normal then "normal" else "colour");
  return true;
}
// Overlapping round bumps on a plane, as a tangent-space normal map (RGB, Z up).
tq_synthetic_normal :: (side: int, img: []u8) {
  for y: 0..<side { for x: 0..<side {
    gx := 0.0; gy := 0.0;
    for k: 0..<24 {
      cx := cast(f64) ((k * 7919 + 13) % side); cy := cast(f64) ((k * 104729 + 71) % side); r := cast(f64) (side / 10 + (k * 37) % (side / 6 + 1));
      dx := cast(f64) x - cx; dy := cast(f64) y - cy; q := 1.0 - (dx * dx + dy * dy) / (r * r);
      if q > 0.0 { s := (ifx k % 3 == 0 then -1.6 else 1.6) * q / r; gx += s * dx; gy += s * dy; } // mutant: equivalent (at q == 0 the bump adds nothing)
    }
    l := sqrt(gx * gx + gy * gy + 1.0); i := (y * side + x) * 4;
    img[i] = cast(u8) te_clamp(cast(int) floor((gx / l + 1.0) * 127.5 + 0.5), 0, 255); // mutant: equivalent (gx / l is inside (-1, 1), so the clamp never binds)
    img[i + 1] = cast(u8) te_clamp(cast(int) floor((gy / l + 1.0) * 127.5 + 0.5), 0, 255); // mutant: equivalent (gy / l is inside (-1, 1), so the clamp never binds)
    img[i + 2] = cast(u8) te_clamp(cast(int) floor((1.0 / l + 1.0) * 127.5 + 0.5), 0, 255); // mutant: equivalent (1 / l is inside (0, 1], so the clamp never binds)
    img[i + 3] = 255;
  } }
}
#test "the synthetic normal map holds unit normals that tilt" {
  img: [32 * 32 * 4] u8; tq_synthetic_normal(32, img[..]);
  tilted := 0;
  for i: 0..<32 * 32 {
    n := tq_normal_xy(cast(int) img[i * 4], cast(int) img[i * 4 + 1]);
    #assert n[2] > 0.0 && img[i * 4 + 3] == 255;
    if n[2] < 0.97 { tilted += 1; }
  }
  #assert tilted > 32 * 32 / 10;
  // pinned: the map aethyr/tools/texture-encode.coax check measured (docs/verification/textures-2026-11-07/quality/)
  h := 7; for i: 0..<img.count { h = (h * 31 + cast(int) img[i]) % 1000000007; } #assert h == 297463588;
  small: [20 * 20 * 4] u8; tq_synthetic_normal(20, small[..]); h = 7;
  for i: 0..<small.count { h = (h * 31 + cast(int) small[i]) % 1000000007; } #assert h == 95144628;
}

// A pack's table entry k as the browser's pack reader takes it (48 bytes from offset 32: kind,
// licence, then the offset and length, then the name), bounds checked. The layers are what this
// tool reads, so it walks the table itself: Aethyrforge's reader keeps VPK1's 48-entry ceiling,
// and Character Create's glade pack has more.
TqEntry :: struct { ok: bool; kind: int; at: int; n: int; name: string; }
tq_entry :: (p: []u8, k: int) -> TqEntry {
  e: TqEntry; row := 32 + k * 48;
  if k < 0 || row + 48 > p.count { return e; }
  e.kind = cast(int) p[row]; e.at = pack_u32(cast(string) p, row + 4); e.n = pack_u32(cast(string) p, row + 8);
  name := 0; while name < 32 && p[row + 16 + name] != 0 { name += 1; }
  e.name = cast(string) p[row + 16..<row + 16 + name];
  e.ok = e.at >= 0 && e.n >= 0 && e.at + e.n <= p.count && name > 0; // mutant: equivalent (at and n are unsigned 32-bit reads, never negative)
  return e;
}
#test "a pack's table entries read with their bounds" {
  p: [32 + 96 + 8] u8; p[32] = 4; p[36] = 128; p[40] = 8; p[48] = 'a'; p[80] = 1; p[84] = 200;
  e := tq_entry(p[..], 0); #assert e.ok && e.kind == 4 && e.at == 128 && e.n == 8 && e.name == "a";
  #assert !tq_entry(p[..], 1).ok && !tq_entry(p[..], 2).ok && !tq_entry(p[..], -1).ok;
  p[40] = 9; #assert !tq_entry(p[..], 0).ok;
  q: [32 + 48 + 48] u8; q[36] = 80; for k: 0..<32 { q[48 + k] = 'n'; } q[80] = 3; q[88] = 128; q[96] = 'b'; q[97] = 'c';
  a := tq_entry(q[..], 0); #assert a.ok && a.at == 80 && a.n == 0 && a.name.count == 32 && a.name[31] == 'n';
  b := tq_entry(q[..], 1); #assert b.ok && b.kind == 3 && b.at == 0 && b.n == 128 && b.name == "bc" && !tq_entry(q[0..<80], 1).ok && tq_entry(q[0..<80], 0).ok;
  q[96] = 0; #assert !tq_entry(q[..], 1).ok;
}

TqImage :: struct { pixels: [TQ_PIXELS] u8; w: int; h: int; }
tq_load :: (bytes: []u8, im: []TqImage, work: []u8) -> bool {
  info := img_info(bytes);
  if info.status != IMG_OK || info.w < 1 || info.h < 1 || info.w > TQ_SIDE || info.h > TQ_SIDE || info.work > work.count { return false; }
  im[0].w = info.w; im[0].h = info.h;
  return img_decode(bytes, work, im[0].pixels[..]) == IMG_OK;
}

tq_summary :: (st: []TqState) -> string {
  o := st[0].rows[..]; o[0].n = 0;
  tq_put(o, "FORMAT\tKIND\tIMAGES\tTEXELS\tPSNR_DB_X100\tMEAN_ANGLE_MDEG\tMAX_ANGLE_MDEG\tMISMATCHED\tBYTES\n");
  for f: 0..<TQ_FORMATS.count {
    t := st[0].totals[f]; if t.images == 0 { continue; }
    tq_put(o, TQ_FORMATS[f].name); tq_put(o, ifx TQ_FORMATS[f].normal then "\tnormal" else "\tcolour");
    vals := [7] int.[t.images, t.texels, tq_psnr(t.sse, t.samples), ifx TQ_FORMATS[f].normal then cast(int) floor(t.angle_sum / cast(f64) t.texels * 1000.0 + 0.5) else 0, ifx TQ_FORMATS[f].normal then cast(int) floor(t.angle_max * 1000.0 + 0.5) else 0, t.mismatched, t.bytes];
    for v: vals { tq_put(o, "\t"); tq_int(o, v); }
    tq_put(o, "\n");
    p: [1] TqBuf; tq_put(p[..], "  "); tq_put(p[..], TQ_FORMATS[f].name); tq_put(p[..], ": "); tq_hundredths(p[..], tq_psnr(t.sse, t.samples)); tq_put(p[..], " dB");
    if TQ_FORMATS[f].normal { tq_put(p[..], ", angle mean "); tq_int(p[..], cast(int) floor(t.angle_sum / cast(f64) t.texels * 1000.0 + 0.5)); tq_put(p[..], " mdeg, worst "); tq_int(p[..], cast(int) floor(t.angle_max * 1000.0 + 0.5)); tq_put(p[..], " mdeg"); }
    tq_put(p[..], "; texels the decoders read differently: "); tq_int(p[..], t.mismatched); tq_put(p[..], " of "); tq_int(p[..], t.texels); tq_put(p[..], "\n");
    print("%", tq_text(p[..]));
  }
  return tq_text(o);
}

tq_valued :: (s: string) -> bool {
  names := [8] string.["--astcenc", "--bc", "--out", "--pack", "--layers", "--image", "--normal", "--synthetic-normal"];
  for x: names { if s == x { return true; } }
  return s == "--format";
}

tool_main :: () -> int #effects(all) #export_c {
  a: [1] Args; ok := args_load(a[..]);
  usage := "usage: texture-encode encode IMAGE OUT --format bc7|bc5|astc4|astc6|astc4-normal|astc6-normal\n       texture-encode check --astcenc PATH --bc PATH --out DIR [--pack PACK [--layers N]] [--image FILE]... [--normal FILE]... [--synthetic-normal SIDE]";
  if !ok || args_count(a[..]) < 1 { tool_errln(usage); return 2; }
  verb := args_at(a[..], 0);
  input: [33554432] u8; im: [1] TqImage;
  if verb == "encode" {
    if args_count(a[..]) < 5 { tool_errln(usage); return 2; }
    format := tq_format(args_value(a[..], "--format", "")); if format == 0 { tool_errln(usage); return 2; }
    st: [1] TqState;
    n := fs_read(args_at(a[..], 1), input[..]);
    if n <= 0 || !tq_load(input[0..<n], im[..], st[0].work[..]) { tool_err("texture-encode: cannot read the image "); tool_errln(args_at(a[..], 1)); return 1; }
    srgb := format == TE_ASTC4 || format == TE_ASTC6;
    bytes := te_image_bytes(format, im[0].w, im[0].h);
    _ := te_encode_image(format, im[0].pixels[..], im[0].w, im[0].h, srgb, st[0].blocks[16..<16 + bytes]);
    tq_header(format, im[0].w, im[0].h, st[0].blocks[0..<16]);
    if !fs_write(args_at(a[..], 2), cast(string) st[0].blocks[0..<16 + bytes]) { tool_errln("texture-encode: cannot write"); return 1; }
    print("texture-encode: % (%x%) as % bytes\n", args_at(a[..], 2), im[0].w, im[0].h, 16 + bytes);
    return 0;
  }
  if verb != "check" { tool_errln(usage); return 2; }
  st: [1] TqState;
  st[0].astcenc = args_value(a[..], "--astcenc", ""); st[0].bc = args_value(a[..], "--bc", ""); st[0].out = args_value(a[..], "--out", "");
  if st[0].astcenc.count == 0 || st[0].bc.count == 0 || st[0].out.count == 0 { tool_errln(usage); return 2; }
  if !fs_exists(st[0].out) && !fs_mkdir(st[0].out) { tool_err("texture-encode: cannot make "); tool_errln(st[0].out); return 2; }
  tq_put(st[0].rows[..], "NAME\tKIND\tFORMAT\tWIDTH\tHEIGHT\tPSNR_DB_X100\tMEAN_ANGLE_MDEG\tMAX_ANGLE_MDEG\tMISMATCHED\tBYTES\n");
  for i: 1..<args_count(a[..]) {
    flag := args_at(a[..], i - 1); value := args_at(a[..], i);
    if flag == "--image" || flag == "--normal" {
      n := fs_read(value, input[..]);
      if n <= 0 || !tq_load(input[0..<n], im[..], st[0].work[..]) { tool_err("texture-encode: cannot read the image "); tool_errln(value); return 1; }
      if !tq_check_image(st[..], value, im[0].pixels[..], im[0].w, im[0].h, flag == "--normal") { return 1; }
    } else if flag == "--synthetic-normal" {
      side := args_whole(value); if side < 8 || side > TQ_SIDE { tool_errln(usage); return 2; }
      tq_synthetic_normal(side, im[0].pixels[..]);
      if !tq_check_image(st[..], "synthetic-normal", im[0].pixels[..], side, side, true) { return 1; }
    } else if flag == "--pack" {
      n := fs_read(value, input[..]);
      if n < 32 || !pack_magic_ok(cast(string) input[0..<4]) { tool_err("texture-encode: cannot read the pack "); tool_errln(value); return 1; }
      limit := args_whole(args_value(a[..], "--layers", "100000")); done := 0; count := pack_u32(cast(string) input[0..<n], 4);
      for k: 0..<count {
        e := tq_entry(input[0..<n], k);
        if !e.ok { tool_err("texture-encode: a bad table entry in "); tool_errln(value); return 1; }
        if e.kind != PACK_LAYER || done >= limit { continue; }
        if !tq_load(input[e.at..<e.at + e.n], im[..], st[0].work[..]) { tool_err("texture-encode: cannot decode layer "); tool_errln(e.name); return 1; }
        if !tq_check_image(st[..], e.name, im[0].pixels[..], im[0].w, im[0].h, false) { return 1; }
        done += 1;
      }
    }
  }
  paths: [2][4096] u8;
  if !fs_write(fs_join(st[0].out, "quality.tsv", paths[0][..]), tq_text(st[0].rows[..])) { tool_errln("texture-encode: cannot write quality.tsv"); return 1; }
  summary := tq_summary(st[..]);
  if !fs_write(fs_join(st[0].out, "summary.tsv", paths[1][..]), summary) { tool_errln("texture-encode: cannot write summary.tsv"); return 1; }
  print("texture-encode: wrote %\n", st[0].out);
  return ifx st[0].failed then 1 else 0;
}
