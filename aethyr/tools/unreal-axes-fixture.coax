// Writes the axis fixture for the Unreal exporter (GitHub #13399): three unit cubes at known
// Aethyr positions, one per axis and each a different distance out, so the importing side can
// read back where +x, +y and +z land and which way the faces wind.
//   marker_x10 centre (10, 0, 0) red, marker_y5 (0, 5, 0) green, marker_z20 (0, 0, 20) blue
//   coax/web/tool.sh aethyr/tools/unreal-axes-fixture.coax OUT.glb
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../export/glb-write.coax";

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { print("usage: unreal-axes-fixture OUT.glb\n"); return 2; }
  buf: [108 * VERTEX_WORDS] u32; p: [1] Pen;
  pen_set(p[..], 1, MAT_FLAT, 1, 0, 0); box(buf[..], p[..], frame_at(v3(10, 0, 0), 0), 0.5, 0.5, 0.5);
  pen_set(p[..], 2, MAT_FLAT, 0, 1, 0); box(buf[..], p[..], frame_at(v3(0, 5, 0), 0), 0.5, 0.5, 0.5);
  pen_set(p[..], 3, MAT_FLAT, 0, 0, 1); box(buf[..], p[..], frame_at(v3(0, 0, 20), 0), 0.5, 0.5, 0.5);
  parts := [3] GlbPart.[GlbPart.{name = "marker_x10", first = 0, count = 36}, GlbPart.{name = "marker_y5", first = 36, count = 36}, GlbPart.{name = "marker_z20", first = 72, count = 36}];
  out: [16384] u8; n := glb_from_cel(buf[..], parts[..], out[..]);
  if n < 0 { print("unreal-axes-fixture: the fixture did not fit\n"); return 1; }
  if !fs_write(args_at(a[..], 0), cast(string) out[0..<n]) { print("unreal-axes-fixture: could not write the file\n"); return 1; }
  print("unreal-axes-fixture: % bytes, 3 cubes\n", n);
  return 0;
}
