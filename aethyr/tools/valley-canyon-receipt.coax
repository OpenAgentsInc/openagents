// Native matrix words used by the actual GPU source view, for independent SDK/Wasm parity.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
#load "../../verse/valley/canyon.coax";
tool_main :: ()->int #export_c #effects(all) {a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}b:[4096]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"pose_words");jo_arr(j[..]);for instance:0..<2 {u:[24]f32;canyon_matrix(u[..],instance);for value:u {jo_int(j[..],cast(int)f32_bits(value));}}jo_end(j[..]);jo_end(j[..]);if !fs_write(args_at(a[..],0),jo_text(j[..])) {return 1;}return 0;}
