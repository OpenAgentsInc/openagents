// Offline leaf builder/report. Does not change the canonical rock bytes.
// coax/web/tool.sh aethyr/tools/valley-clusters.coax
#import "Basic";
#load "../../verse/valley/rock.coax";
#load "../render/geometry/clusters.coax";
tool_main :: ()->int #export_c {
  r:[1]Rock;c:[1]Clusters;
  for detail:[3]int.[8,16,32] {
    if !rock_build(r[..],detail,12609) || !clusters_build(c[..],r[0].p[0..<r[0].vertices],r[0].i[0..<r[0].indices],CLUSTER_LEAVES) {return 1;}
    max_v:=0;max_t:=0;covered:=0;
    for a:c[0].leaf[0..<c[0].count] {
      if a.first!=covered {return 1;}covered+=a.triangles;
      if a.vertices>max_v {max_v=a.vertices;}if a.triangles>max_t {max_t=a.triangles;}
      for k:0..<a.triangles*3 {if a.source[cast(int)a.local[k]]!=r[0].i[a.first*3+k] {return 1;}}
    }
    if covered!=r[0].indices/3 {return 1;}
    print("source-order-v1 divisions=% leaves=% remapped_vertices=% triangles=% max_vertices=% max_triangles=% sha256=%\n",detail,c[0].count,c[0].vertices,covered,max_v,max_t,cast(string)r[0].hash[..]);
  }return 0;
}
