// Original SDK groom arrays -> full-resolution curve segments; Coax owns unit/axis conversion.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../verse/valley/scan.coax";
eg_position :: (p:Point)->Point {return v3(p.x*0.01,p.z*0.01,p.y*0.01);}
#test "Groom source axes use the same centimetre conversion as Unreal glTF" {p:=eg_position(v3(10,20,150));#assert abs(p.x-0.1)<0.0000001 && p.y==1.5 && abs(p.z-0.2)<0.0000001;}
eg_array :: (data:[]u8,at:[]int,width:int)->int {#assert at[0]>=4 && at[0]<=data.count-4;n:=cast(int)scan_u32(data,at[0]);at[0]+=4;#assert n<= (data.count-at[0])/width;begin:=at[0];at[0]+=n*width;return begin;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}source:=args_at(a[..],0);dest:=args_at(a[..],1);input:[16777216]u8;out:[33554432]u8;indices:[16777216]u8;path:[4096]u8;segments:=0;
 for asset:0..<2 {
  name:=ifx asset==0 then "Hair_S_UpdoBuns.strands" else "Eyebrows_L_Echo.strands";n:=fs_read(fs_join(source,name,path[..]),input[..]);#assert n>0 && scan_u32(input[..],0)==0x31534745;data:=input[0..<n];at:=[1]int.[4];positions:=eg_array(data,at[..],12);np:=(at[0]-positions)/12;radius:=eg_array(data,at[..],4);#assert (at[0]-radius)/4==np;coords:=eg_array(data,at[..],4);#assert (at[0]-coords)/4==np;counts:=eg_array(data,at[..],2);nc:=(at[0]-counts)/2;offsets:=eg_array(data,at[..],4);#assert (at[0]-offsets)/4==nc+1;uvs:=eg_array(data,at[..],8);#assert (at[0]-uvs)/8==nc && at[0]==n;
  max_radius:f32=0;for k:0..<np {r:=f32_from_bits(scan_u32(data,radius+k*4));#assert r>=0 && r<1;max_radius=ifx r>max_radius then r else max_radius;}#assert max_radius>0;
  for curve:0..<nc {first:=cast(int)scan_u32(data,offsets+curve*4);last:=cast(int)scan_u32(data,offsets+(curve+1)*4);count:=cast(int)data[counts+curve*2]|(cast(int)data[counts+curve*2+1]<<8);#assert last-first==count && count>=2 && first>=0 && last<=np;
   for point:first..<last-1 {base:=32+segments*48;#assert base+48<=out.count;for endpoint:0..<2 {p:=eg_position(scan_point(data,positions+(point+endpoint)*12));scan_put(out[..],base+endpoint*16,f32_bits(p.x));scan_put(out[..],base+endpoint*16+4,f32_bits(p.y));scan_put(out[..],base+endpoint*16+8,f32_bits(p.z));r:=f32_from_bits(scan_u32(data,radius+(point+endpoint)*4));scan_put(out[..],base+endpoint*16+12,f32_bits(r/max_radius*(ifx asset==0 then 0.00005f32 else 0.00004f32)));scan_put(out[..],base+32+endpoint*4,scan_u32(data,coords+(point+endpoint)*4));}
    // Stable curve variation. Original positions/radii/U are retained; Unreal's packed random seed is a separate parity exit.
    seed:=cast(f32)(curve%251)/251;scan_put(out[..],base+40,f32_bits(seed));scan_put(out[..],base+44,cast(u32)(26+asset));for vertex:0..<6 {scan_put(indices[..],(segments*6+vertex)*4,cast(u32)(1000000+segments*6+vertex));}segments+=1;
   }
  }print("Groom % curves=% points=% segments_so_far=%\n",name,nc,np,segments);
 }
 scan_put(out[..],0,0x32475345);scan_put(out[..],4,cast(u32)segments);#assert fs_write(fs_join(dest,"echo.groom",path[..]),cast(string)out[0..<32+segments*48]);#assert fs_write(fs_join(dest,"echo.groom-indices",path[..]),cast(string)indices[0..<segments*24]);print("Groom bytes=% indices=%\n",32+segments*48,segments*6);return 0;
}
