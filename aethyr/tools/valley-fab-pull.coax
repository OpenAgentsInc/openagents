// Repeatable anonymous GET-only download of the two verified free source archives.
// No login, purchase, entitlement mutation or signed-URL logging. Refuse changed bytes.
// tool.sh: tls
// CLI QUixel_ID OUTPUT_ZIP (explicit path; uses OUTPUT_ZIP.part until SHA256 passes).
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/net/http.coax";
#load "../assets.coax";
vp_join :: (parts:[]string,b:[]u8)->string {at:=0;for p:parts {for c:p {if at>=b.count {return "";}b[at]=c;at+=1;}}return cast(string)b[0..<at];}
vp_decimal :: (n:int,b:[]u8)->string {o:[1]Jo;jo_start(o[..],b);jo_int(o[..],n);return jo_text(o[..]);}
#test "Fab pull concatenation is bounded and integer range endpoints are decimal" {b:[32]u8;parts:=[2]string.["ab","cd"];#assert vp_join(parts[..],b[..])=="abcd" && vp_join(parts[..],b[0..<3])=="";#assert vp_decimal(524287,b[..])=="524287";}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}id:=args_at(a[..],0);selected:=ifx id=="uk4cdch" then 0 else ifx id=="ubhvccfda" then 1 else -1;if selected<0 {return 2;}
  endpoints:=[2]string.["https://www.fab.com/i/listings/11700737-077c-416b-a005-53d0b5e1e285/asset-formats/gltf/files/849bcfb2-0f4a-4ec4-b277-2df435c0338e/download-info","https://www.fab.com/i/listings/c47f6376-20c4-4631-a6d6-82f626652691/asset-formats/gltf/files/61789c49-84d4-45a8-bd98-fbeebd988256/download-info"];
  hashes:=[2]string.["3279bfdc961fe825a0b159320a5ab92a814b6af2242517804b65f81783f2f0b1","33214eaebee405959ddec86462ba8927f3abbe4eb5c350a069a28e229e4c40df"];total:=[2]int.[2053796,1639935][selected];
  w:[1]HttpWork;body:[524288]u8;headers:=[1]string.["User-Agent: OpenAgents-ValleyLab-Source/1.0"];r:=http_do(w[..],"GET",endpoints[selected],headers[..],"",10000,0,body[..]);if r.error!=HTTP_OK || r.code!=200 {print("download unavailable: HTTP % error %\n",r.code,r.error);return 3;}
  d:[1]Jv;nodes:[512]JvNode;url:[8192]u8;if !jv_parse(d[..],cast(string)body[0..<r.n],nodes[..]) {return 4;}entry:=jv_at(d[0],jv_get(d[0],0,"downloadInfo"),0);n:=jv_str(d[0],jv_get(d[0],entry,"downloadUrl"),url[..]);if n<1 {return 4;}download:=cast(string)url[0..<n];if !http_url(download).ok {return 4;}
  temp:[4096]u8;parts:=[2]string.[args_at(a[..],1),".part"];partial:=vp_join(parts[..],temp[..]);if partial=="" {return 4;}
  offset:=0;while offset<total {last:=offset+524287;if last>=total {last=total-1;}left:[32]u8;right:[32]u8;line:[128]u8;pieces:=[4]string.["Range: bytes=",vp_decimal(offset,left[..]),"-",vp_decimal(last,right[..])];range:=vp_join(pieces[..],line[..]);hs:=[2]string.[headers[0],range];
    r=http_do(w[..],"GET",download,hs[..],"",15000,3,body[..]);if r.error!=HTTP_OK || r.code!=206 || r.n!=last-offset+1 {print("range refused: HTTP % error %\n",r.code,r.error);return 5;}
    ok:=ifx offset==0 then fs_write(partial,cast(string)body[0..<r.n]) else fs_append(partial,cast(string)body[0..<r.n]);if !ok {return 6;}offset=last+1;
  }
  archive:[2097152]u8;size:=fs_read(partial,archive[..]);expected:[1]AssetId;if size!=total || !asset_parse(hashes[selected],expected[..]) || !asset_same(asset_id(cast(string)archive[0..<size]),expected[0]) {print("archive SHA256 refused\n");return 7;}
  if !fs_rename(partial,args_at(a[..],1)) {return 8;}print("downloaded %: % bytes, pinned archive SHA256 verified\n",id,size);return 0;
}
