// Native asset producer/report, identical to the Valley Lab generator.
// coax/web/tool.sh aethyr/tools/valley-rock.coax [OUTPUT_DIRECTORY]
#import "Basic";
#load "../../verse/valley/rock.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
tool_main :: ()->int #export_c #effects(all) {
  args:[1]Args;if !args_load(args[..]) || args_count(args[..])>1 {return 2;}
  r:[1]Rock;
  for divisions:[3]int.[8,16,32] {
    if !rock_build(r[..],divisions,12609) {return 1;}
    print("rock-v1 seed=12609 divisions=% vertices=% triangles=% bytes=% sha256=%\n",divisions,r[0].vertices,r[0].indices/3,r[0].bytes,cast(string)r[0].hash[..]);
    print("bounds metres: % % % to % % % / source: % / licence: %\n",r[0].measured.low.x,r[0].measured.low.y,r[0].measured.low.z,r[0].measured.high.x,r[0].measured.high.y,r[0].measured.high.z,ROCK_SOURCE,ROCK_LICENCE);
    if args_count(args[..])==1 {
      name:=ifx divisions==8 then "rock-8.vro" else ifx divisions==16 then "rock-16.vro" else "rock-32.vro";
      path:[4096]u8;if !fs_write(fs_join(args_at(args[..],0),name,path[..]),cast(string)r[0].encoded[0..<r[0].bytes]) {return 1;}
    }
  }return 0;
}
