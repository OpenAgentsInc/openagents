// Read-only Unreal source provenance inventory. No Unreal code or project is run.
// coax/web/tool.sh aethyr/tools/valley-source-inventory.coax CONTENT_ROOT ANCIENT_WORLD_ACTOR_ROOT OUTPUT_JSON
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
VS_PREFIX :: 262144;
VS_ASSETS :: 512;
VSource :: struct {path:[1024]u8;path_n:int;id:[64]u8;id_n:int;file:[256]u8;file_n:int;md5:[64]u8;md5_n:int;bytes:int;refs:int;metadata:bool;}
VInventory :: struct {asset:[VS_ASSETS]VSource;n:int;actors:int;actor_prefixes:int;unknown:int;}
#test "source metadata is bounded JSON rather than guessed binary strings" {
  s:="junk[{ \"RelativeFilename\" : \"C:/Megascans/3d_rock_uk4sehs/uk4sehs_High.fbx\", \"FileMD5\" : \"abcdef\" }]\0tail";
  source:=vs_source(s);#assert source.count>0;nodes:[32]JvNode;d:[1]Jv;#assert jv_parse(d[..],source,nodes[..]);
  #assert vs_id("C:/Megascans/3d_rock_uk4sehs/uk4sehs_High.fbx")=="uk4sehs";
  #assert vs_id("F:/Quarry Cliff_ubhvccfda_3D Assembly/SM_Quarry_Cliff_10.fbx")=="ubhvccfda";
  #assert vs_id("C:/foo/bar.fbx")=="" && vs_id("C:/foo/NOTANID_High.fbx")=="";
  #assert vs_source("junk[{not JSON}]\0")=="" && vs_source("[{\"RelativeFilename\":\"unfinished")=="";
  #assert vs_base("C:\\folder\\mesh.fbx")=="mesh.fbx" && vs_base("a/b.fbx")=="b.fbx";
  #assert vs_find("abcabc","bc")==1 && vs_find("abc","z")== -1;
}
vs_find :: (s:string,needle:string)->int {for i:0..<s.count-needle.count+1 {if s[i..<i+needle.count]==needle {return i;}}return -1;}
vs_base :: (s:string)->string {at:=0;for c,k:s {if c=='/' || c=='\\' {at=k+1;}}return s[at..<s.count];}
vs_id :: (s:string)->string {
  for suffix:[5]string.["_3D","_High","_LOD","_high","_low"] {end:=vs_find(s,suffix);if end<0 {continue;}start:=end;
    while start>0 && s[start-1]!='_' && s[start-1]!='/' && s[start-1]!='\\' && s[start-1]!=' ' {start-=1;}
    candidate:=s[start..<end];ok:=candidate.count>=6 && candidate.count<=12;for c:candidate {if !((c>='a' && c<='z') || (c>='0' && c<='9')) {ok=false;}}
    if ok {return candidate;}
  }return "";
}
vs_source :: (data:string)->string {
  marker:="[{";from:=0;
  while from<data.count {at:=vs_find(data[from..<data.count],marker);if at<0 {return "";}at+=from;
    end:=at;while end<data.count && end-at<4096 && data[end]!=0 {end+=1;}
    if end<data.count && data[end]==0 {nodes:[64]JvNode;doc:[1]Jv;candidate:=data[at..<end];
      if jv_parse(doc[..],candidate,nodes[..]) && jv_kind(doc[0],jv_get(doc[0],jv_at(doc[0],0,0),"RelativeFilename"))==JV_STRING {return candidate;}
    }from=at+2;
  }return "";
}
vs_copy :: (out:[]u8,s:string)->int {if s.count>out.count {return -1;}for c,k:s {out[k]=c;}return s.count;}
vs_walk :: (root:string,relative:string,inventory:[]VInventory)->bool {
  path:[4096]u8;dir:=fs_join(root,relative,path[..]);list:[1]FsList;if fs_list(dir,list[..])<0 || list[0].full {return false;}
  for k:0..<list[0].n {name:=fs_entry(list[..],k);joined:[4096]u8;rel:=fs_join(relative,name,joined[..]);full:[4096]u8;p:=fs_join(root,rel,full[..]);kind:=fs_kind(p);
    if kind==FS_DIR {if !vs_walk(root,rel,inventory) {return false;}}
    else if kind==FS_FILE && name.count>7 && name[name.count-7..<name.count]==".uasset" && (name[0..<3]=="SM_" || name[0..<2]=="S_") {
      if inventory[0].n>=VS_ASSETS {return false;}row:=VSource.{bytes=fs_size(p)};row.path_n=vs_copy(row.path[..],rel);if row.path_n<0 {return false;}
      data:[VS_PREFIX]u8;n:=fs_read_at(p,0,data[..]);if n<0 {return false;}source:=vs_source(cast(string)data[0..<n]);
      if source.count>0 {doc:[1]Jv;nodes:[64]JvNode;source_path:[4096]u8;
        if !jv_parse(doc[..],source,nodes[..]) {return false;}object:=jv_at(doc[0],0,0);sn:=jv_str(doc[0],jv_get(doc[0],object,"RelativeFilename"),source_path[..]);if sn<0 {return false;}
        s:=cast(string)source_path[0..<sn];row.file_n=vs_copy(row.file[..],vs_base(s));row.id_n=vs_copy(row.id[..],vs_id(s));
        row.md5_n=jv_str(doc[0],jv_get(doc[0],object,"FileMD5"),row.md5[..]);if row.md5_n<0 {row.md5_n=0;}if row.file_n<0 || row.id_n<0 {return false;}row.metadata=true;
      }else {inventory[0].unknown+=1;}
      inventory[0].asset[inventory[0].n]=row;inventory[0].n+=1;
    }
  }return true;
}
vs_actors :: (root:string,inventory:[]VInventory)->bool {
  list:[1]FsList;if fs_list(root,list[..])<0 || list[0].full {return false;}
  for k:0..<list[0].n {name:=fs_entry(list[..],k);path:[4096]u8;p:=fs_join(root,name,path[..]);kind:=fs_kind(p);
    if kind==FS_DIR {if !vs_actors(p,inventory) {return false;}}
    else if kind==FS_FILE && name.count>7 && name[name.count-7..<name.count]==".uasset" {
      inventory[0].actors+=1;if fs_size(p)>VS_PREFIX {inventory[0].actor_prefixes+=1;}data:[VS_PREFIX]u8;n:=fs_read_at(p,0,data[..]);if n<0 {return false;}s:=cast(string)data[0..<n];
      seen:[VS_ASSETS]bool;from:=0;prefix:="/Game/AncientContent/Megascans/";
      while from<s.count {at:=vs_find(s[from..<s.count],prefix);if at<0 {break;}at+=from;end:=at;
        while end<s.count && end-at<1024 && s[end]!=0 && s[end]!='.' && s[end]!=39 {end+=1;}
        if end<s.count && (s[end]==0 || s[end]=='.' || s[end]==39) {candidate:=s[at+6..<end];
          for j:0..<inventory[0].n {rel:=cast(string)inventory[0].asset[j].path[0..<inventory[0].asset[j].path_n-7];if !seen[j] && candidate==rel {inventory[0].asset[j].refs+=1;seen[j]=true;}}
        }from=at+prefix.count;
      }
    }
  }return true;
}
tool_main :: ()->int #export_c #effects(all) {
  args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=3 {return 2;}inventory:[1]VInventory;
  if !vs_walk(args_at(args[..],0),"AncientContent/Megascans",inventory[..]) || !vs_actors(args_at(args[..],1),inventory[..]) {return 1;}
  bytes:[2097152]u8;j:[1]Jo;jo_start(j[..],bytes[..]);jo_obj(j[..]);jo_key(j[..],"schema");jo_str(j[..],"valley.unreal-source-inventory.v1");jo_key(j[..],"prefix_bytes");jo_int(j[..],VS_PREFIX);jo_key(j[..],"mesh_packages");jo_int(j[..],inventory[0].n);jo_key(j[..],"metadata_not_found_in_prefix");jo_int(j[..],inventory[0].unknown);jo_key(j[..],"actor_packages");jo_int(j[..],inventory[0].actors);jo_key(j[..],"actor_packages_larger_than_prefix");jo_int(j[..],inventory[0].actor_prefixes);jo_key(j[..],"assets");jo_arr(j[..]);
  for k:0..<inventory[0].n {r:=inventory[0].asset[k];jo_obj(j[..]);jo_key(j[..],"package");jo_str(j[..],cast(string)r.path[0..<r.path_n]);jo_key(j[..],"package_bytes");jo_int(j[..],r.bytes);jo_key(j[..],"import_metadata_found");jo_bool(j[..],r.metadata);jo_key(j[..],"source_file");jo_str(j[..],cast(string)r.file[0..<r.file_n]);jo_key(j[..],"source_md5");jo_str(j[..],cast(string)r.md5[0..<r.md5_n]);jo_key(j[..],"quixel_id_candidate");jo_str(j[..],cast(string)r.id[0..<r.id_n]);jo_key(j[..],"ancient_world_actor_references");jo_int(j[..],r.refs);jo_end(j[..]);}jo_end(j[..]);jo_end(j[..]);
  if j[0].bad || !fs_write(args_at(args[..],2),jo_text(j[..])) {return 1;}print("mesh_packages=% metadata_absent=% ancient_world_actors=% oversized_actor_prefixes=%\n",inventory[0].n,inventory[0].unknown,inventory[0].actors,inventory[0].actor_prefixes);return 0;
}
