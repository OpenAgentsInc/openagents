// Coax/WebGPU rendering of the pinned ARWES value ports. License and source
// mappings: arwes/LICENSE and arwes/SOURCES.md. No DOM/SVG/Canvas2D runtime.
// Uses the HUD's 12-float stroke/atlas records; modes5/6/7 add radial, solid
// rectangle and filled circle primitives in demos/hud/gpu.coax.
#load "draw.coax";
#load "arwes-frames.coax";
#load "arwes-motion.coax";
#load "arwes-fx.coax";

AW_NAMES :: [25]string.["FRAME / UNDERLINE","FRAME / LINES","FRAME / CORNERS","FRAME / OCTAGON","FRAME / NERO","FRAME / NEFREX","FRAME / KRANOX","FRAME / HEADER","FRAME / CIRCLE","BACKGROUND / DOTS","BACKGROUND / GRID LINES","BACKGROUND / MOVING LINES","BACKGROUND / PUFFS","EFFECT / ILLUMINATOR","TEXT / SEQUENCE","TEXT / DECIPHER","MOTION / 31 EASINGS","ANIMATOR / CHILD TIMING","TRANSITION / FLICKER","STYLE / STEPS","STYLE / STRIP","STYLE / SEPARATOR","THEME / TOKEN SCALES","BLEEPS / CUE MODEL","TOOLS / KEYED TIMERS"];

#test "Arwes GPU primitives refuse short buffers without publishing partial records" {
  out:[144]f32;p:=HdPen.{d=2,top=0,bottom=400};b:=HudBox.{x=10,y=20,width=100,height=80};
  c:=AxColor.{r=1,g=1,b=1,a=0.5};
  #assert aw_quad(out[0..<60],0,b,60,60,20,c,p,5)==0 && out[0]==0;
  #assert aw_quad(out[..],0,b,60,60,20,c,p,5)==6 && out[11]==5 && out[6]==0.5;
  #assert out[0]==20 && out[1]==40 && out[4]==40;
}
#test "drawn source paths and particles stay bounded on a tiny consumer buffer" {
  out:[1440]f32;p:=HdPen.{d=1,cyan=true,top=0,bottom=500};b:=HudBox.{x=10,y=20,width=240,height=140};
  for kind:0..<14 {
    n:=aw_visual(out[..],0,kind,b,p,2,1,7,100,100);
    #assert n>=0 && n<=120 && n%6==0;
  }
}

aw_color :: (p:HdPen,kind:int,alpha:f32)->AxColor {
  k:=hd_ink(p,kind);return AxColor.{r=k.red,g=k.green,b=k.blue,a=alpha};
}
// b is a clipped rectangle; cx/cy/radius retain the original radial origin.
aw_quad :: (out:[]f32,at:int,b:HudBox,cx:f32,cy:f32,radius:f32,c:AxColor,p:HdPen,mode:f32)->int {
  if at<0 || (at+6)*12>out.count || b.width<=0 || b.height<=0 {return at;}
  top:=ax_max(b.y,p.top);bottom:=ax_min(b.y+b.height,p.bottom);if bottom<=top {return at;}
  xs:=[6]f32.[b.x,b.x+b.width,b.x+b.width,b.x,b.x+b.width,b.x];
  ys:=[6]f32.[top,top,bottom,top,bottom,bottom];
  for i:0..<6 {o:=(at+i)*12;out[o]=xs[i]*p.d;out[o+1]=ys[i]*p.d;
    out[o+2]=(xs[i]-cx)*p.d;out[o+3]=(ys[i]-cy)*p.d;out[o+4]=radius*p.d;out[o+5]=0;
    out[o+6]=c.a;out[o+7]=0;out[o+8]=c.r;out[o+9]=c.g;out[o+10]=c.b;out[o+11]=mode;}
  return at+6;
}
aw_disc :: (out:[]f32,at:int,b:HudBox,cx:f32,cy:f32,r:f32,c:AxColor,p:HdPen,soft:bool)->int {
  left:=ax_max(b.x,cx-r);right:=ax_min(b.x+b.width,cx+r);top:=ax_max(b.y,cy-r);bottom:=ax_min(b.y+b.height,cy+r);
  return aw_quad(out,at,HudBox.{x=left,y=top,width=right-left,height=bottom-top},cx,cy,r,c,p,ifx soft then 5.0f32 else 7.0f32);
}
aw_clip_line :: (a:HudCoord,b:HudCoord,box:HudBox)->HudBox {
  low:=0.0f32;high:=1.0f32;dx:=b.x-a.x;dy:=b.y-a.y;empty:HudBox;
  if dx==0 {if a.x<box.x || a.x>box.x+box.width {return empty;}}
  else {start:=(box.x-a.x)/dx;end:=(box.x+box.width-a.x)/dx;low=ax_max(low,ax_min(start,end));high=ax_min(high,ax_max(start,end));}
  if dy==0 {if a.y<box.y || a.y>box.y+box.height {return empty;}}
  else {start:=(box.y-a.y)/dy;end:=(box.y+box.height-a.y)/dy;low=ax_max(low,ax_min(start,end));high=ax_min(high,ax_max(start,end));}
  if high<=low {return empty;}return HudBox.{x=a.x+dx*low,y=a.y+dy*low,width=dx*(high-low),height=dy*(high-low)};
}
aw_stroke :: (out:[]f32,at:int,a:HudCoord,b:HudCoord,box:HudBox,p:HdPen,kind:int,alpha:f32,stroke:f32)->int {
  clip:=box;top:=ax_max(box.y,p.top);bottom:=ax_min(box.y+box.height,p.bottom);clip.y=top;clip.height=bottom-top;
  if clip.height<=0 {return at;}r:=aw_clip_line(a,b,clip);if r.width==0 && r.height==0 {return at;}
  k:=hd_ink(p,kind);
  if lit(out,at,r.x*p.d,r.y*p.d,(r.x+r.width)*p.d,(r.y+r.height)*p.d,ax_max(0.4,stroke*0.5)*p.d,alpha,1.5*p.d,k.red,k.green,k.blue,0) {return at+6;}return at;
}
// Even/odd scan conversion preserves concave frame fills without a fan that
// covers clipped corners. Bounded rows are at most two logical points apart.
aw_fill :: (out:[]f32,at:int,points:[]AfPoint,box:HudBox,p:HdPen,kind:int,alpha:f32)->int {
  if points.count<3 {return at;}v:=at;rows:=cast(int)(-floor(-box.height/2));if rows>256 {rows=256;}if rows<1 {return at;}
  step:=box.height/cast(f32)rows;
  for row:0..<rows {
    y:=box.y+(cast(f32)row+0.5)*step;cross:[256]f32;n:=0;
    for i:0..<points.count {j:=(i+1)%points.count;a:=points[i];b:=points[j];
      if (a.y<=y && b.y>y) || (b.y<=y && a.y>y) {if n<256 {cross[n]=a.x+(y-a.y)*(b.x-a.x)/(b.y-a.y);n+=1;}}
    }
    for i:0..<n {for j:i+1..<n {if cross[j]<cross[i] {tmp:=cross[i];cross[i]=cross[j];cross[j]=tmp;}}}
    i:=0;while i+1<n {
      left:=ax_max(box.x,cross[i]);right:=ax_min(box.x+box.width,cross[i+1]);
      v=aw_quad(out,v,HudBox.{x=left,y=y-step*0.5,width=right-left,height=step},0,0,0,aw_color(p,kind,alpha),p,6);i+=2;
    }
  }return v;
}
aw_frame :: (out:[]f32,at:int,kind:int,b:HudBox,p:HdPen,share:f32)->int {
  return aw_frame_profile(out,at,kind,b,p,share,true,false);
}
aw_frame_family :: (out:[]f32,at:int,kind:int,b:HudBox,p:HdPen,progress:f32,entering:bool)->int {
  return aw_frame_profile(out,at,kind,b,p,progress,entering,true);
}
aw_frame_profile :: (out:[]f32,at:int,kind:int,b:HudBox,p:HdPen,progress:f32,entering:bool,family:bool)->int {
  points:[256]AfPoint;settings:=af_settings(kind);scale:=ax_min(1,b.height/200);
  settings.square*=scale;settings.corner_length*=scale;settings.large_line_length*=scale;settings.small_line_length*=scale;settings.side_width*=scale;
  box:=b;if kind==8 {size:=ax_min(b.width,b.height);box=HudBox.{x=b.x+(b.width-size)*0.5,y=b.y,width=size,height=size};}
  n:=ifx family then af_frame_family(kind,box,settings,progress,entering,points[..]) else af_frame_settings(kind,box,settings,progress,points[..]);v:=at;start:=0;
  for i:0..<n {
    if points[i].move {start=i;}
    end:=i+1==n || points[i+1].move;
    if end && points[start].fill {v=aw_fill(out,v,points[start..<i+1],box,p,ifx points[start].layer==2 then 2 else 1,points[start].alpha*(ifx points[start].layer==2 then 0.65f32 else 0.035f32));}
    if i>start && !points[start].fill {
      a:=HudCoord.{x=points[i-1].x,y=points[i-1].y};z:=HudCoord.{x=points[i].x,y=points[i].y};
      v=aw_stroke(out,v,a,z,box,p,ifx points[i].layer==2 then 2 else 0,points[i].alpha*0.9,points[i].stroke);
    }
  }
  return v;
}
aw_background :: (out:[]f32,at:int,kind:int,b:HudBox,p:HdPen,time:f32,share:f32,seed:int)->int {
  v:=at;
  if kind==0 {
    count:=ax_dot_count(b,22);
    for i:0..<count {d:=ax_dot(b,22,i,share,4,false,true);v=aw_disc(out,v,b,d.x,d.y,1.3,aw_color(p,2,d.alpha*0.65),p,false);}
  } else if kind==1 {
    gap:=24.0f32;columns:=1+cast(int)floor(b.width/gap);rows:=1+cast(int)floor(b.height/gap);
    margin_x:=(b.width-floor(b.width/gap)*gap)*0.5;margin_y:=(b.height-floor(b.height/gap)*gap)*0.5;
    for i:0..<columns {x:=b.x+margin_x+cast(f32)i*gap;v=aw_stroke(out,v,HudCoord.{x=x,y=b.y},HudCoord.{x=x,y=b.y+b.height},b,p,1,0.45*share,1);}
    for i:0..<rows {y:=b.y+margin_y+cast(f32)i*gap;for j:0..<cast(int)(-floor(-b.width/8)) {x:=b.x+cast(f32)j*8;v=aw_stroke(out,v,HudCoord.{x=x,y=y},HudCoord.{x=x+4,y=y},b,p,1,0.45*share,1);}}
  } else if kind==2 {
    lines:[1024]AxLine;n:=ax_moving_lines(b,20,5,seed,ax_wrap(time/4),lines[..]);
    for i:0..<n {v=aw_stroke(out,v,lines[i].a,lines[i].b,b,p,2,0.8*share,1);}
  } else {
    settings:=AxPuffSettings.{padding=18,radius=3,y_fixed= -4,y_var= -24,r_fixed=12,r_var=30};
    for i:0..<10 {puff:=ax_puff(b,settings,seed,i,ax_wrap(time/4));v=aw_disc(out,v,b,puff.x,puff.y,puff.radius,aw_color(p,2,puff.alpha*share*0.3),p,true);}
  }return v;
}
aw_visual :: (out:[]f32,at:int,kind:int,b:HudBox,p:HdPen,time:f32,share:f32,seed:int,pointer_x:f32,pointer_y:f32)->int {
  if kind<9 {return aw_frame(out,at,kind,b,p,share);}
  if kind<13 {return aw_background(out,at,kind-9,b,p,time,share,seed);}
  v:=at;
  if kind==13 {
    v=aw_background(out,v,1,b,p,time,0.4,seed);
    x:=pointer_x;y:=pointer_y;if !hud_contains(b,x,y) {x=b.x+b.width*0.5;y=b.y+b.height*0.5;}
    v=aw_disc(out,v,b,x,y,70,aw_color(p,2,0.35),p,true);v=hd_diamond(out,v,x,y,5,p,2);
    return hd_text_fit(out,v,"MOVE THE POINTER / LOCAL LIGHT",b.x+6,b.y+b.height-6,8,b.width-12,p,0);
  }
  return v;
}
