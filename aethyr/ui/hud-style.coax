// HUD styles: how a realm's HUD looks, apart from what it shows. A realm picks one style
// (hud_style_named, from its config) and draws every HUD part through it. Two styles exist:
//  - SCIFI: the Verse's instrument look (verse/hud/frame.coax, aethyr/ui/draw.coax and the Arwes
//    frames in aethyr/ui/arwes-frames.coax): grey and cyan glow lines, cut corners, thin bars.
//    The realms that use it keep their own drawing code; these tokens name its values.
//  - FANTASY: dark iron and bronze frames, warm gold type, parchment, rounded corners with
//    diamond studs, framed segmented bars, recessed slots and a gold banner (docs/verse/hud-styles.md).
// A style is tokens (HudTokens: palette, faces, line weights, corner and ornament treatment, bar,
// slot, banner and damage-number styles) plus drawers that turn a HUD part into primitives
// (HudPrim: filled rounded boxes, rings, lines, pie sweeps and soft shadows) in screen points,
// y down. A realm's renderer turns the primitives into its own vertices (Everglade:
// apps/openagents-web/charactercreator.coax hud_emit). Text is the realm's: a style says which face,
// colour and size each text role takes (hud_text), never how glyphs are drawn.
// coax/bin/coax test aethyr/ui/hud-style.coax --library
#load "hud.coax";

HUD_SCIFI :: 0; HUD_FANTASY :: 1; HUD_STYLES :: 2;

// The faces a style asks for. BODY is a realm's reading face (numbers, lines); TITLE its display
// face (names, places, banners). SCIFI uses one face for both.
HUD_FACE_BODY :: 0; HUD_FACE_TITLE :: 1;
HUD_CORNER_CUT :: 0; HUD_CORNER_ROUND :: 1;
HUD_ORN_NONE :: 0; HUD_ORN_STUDS :: 1;          // a diamond stud at each corner of a panel
HUD_BAR_LINE :: 0; HUD_BAR_FRAMED :: 1;         // a glow line, or a framed bar with segments and a gloss
HUD_SLOT_OUTLINE :: 0; HUD_SLOT_RECESSED :: 1;  // an outline, or a sunk bevel with a gold trim when ready
HUD_BANNER_RULES :: 0; HUD_BANNER_RIBBON :: 1;  // two rules, or a dark ribbon fading out with gold rules and diamonds
HUD_DAMAGE_PLAIN :: 0; HUD_DAMAGE_OUTLINED :: 1;

HudRgba :: struct { r: f32; g: f32; b: f32; a: f32 = 1; }
HudTokens :: struct {
  style: int; name: string;
  frame_dark: HudRgba;    // a panel's body
  frame_mid: HudRgba;     // its frame's metal
  frame_light: HudRgba;   // the frame's lit edge
  trim: HudRgba;          // gold trim, studs, the ready slot's edge
  text: HudRgba; text_dim: HudRgba; title: HudRgba;
  parchment: HudRgba;     // a map's or a scroll's ground
  hp: HudRgba; hp_back: HudRgba; hp_low: HudRgba;
  magic: HudRgba;         // spell slots
  good: HudRgba; bad: HudRgba; damage: HudRgba; heal: HudRgba;
  title_face: int; label_face: int;
  line: f32;              // the base stroke, points
  radius: f32;            // a panel's corner rounding (FANTASY) or cut (SCIFI), points
  corner: int; ornament: int; stud: f32;
  bar: int; bar_segments: int;
  slot: int; banner: int; damage_style: int; damage_scale: f32;
  shadow: f32;            // a panel's soft drop shadow reach, points; 0 none
}

#test "two styles, picked by name; anything else is SCIFI, as every realm was" {
  #assert hud_style_named("fantasy") == HUD_FANTASY && hud_style_named("FANTASY") == HUD_FANTASY;
  #assert hud_style_named("scifi") == HUD_SCIFI && hud_style_named("") == HUD_SCIFI && hud_style_named("steampunk") == HUD_SCIFI;
  for s: 0..<HUD_STYLES { #assert hud_tokens(s).style == s && hud_tokens(s).name.count > 0; }
  #assert hud_tokens(-1).style == HUD_SCIFI && hud_tokens(9).style == HUD_SCIFI;
}

#test "the styles differ in every treatment a realm can see" {
  a := hud_tokens(HUD_SCIFI); b := hud_tokens(HUD_FANTASY);
  #assert a.corner == HUD_CORNER_CUT && b.corner == HUD_CORNER_ROUND;
  #assert a.ornament == HUD_ORN_NONE && b.ornament == HUD_ORN_STUDS;
  #assert a.bar == HUD_BAR_LINE && b.bar == HUD_BAR_FRAMED && b.bar_segments > 1;
  #assert a.slot == HUD_SLOT_OUTLINE && b.slot == HUD_SLOT_RECESSED;
  #assert a.banner == HUD_BANNER_RULES && b.banner == HUD_BANNER_RIBBON;
  #assert a.damage_style == HUD_DAMAGE_PLAIN && b.damage_style == HUD_DAMAGE_OUTLINED && b.damage_scale > a.damage_scale;
  #assert a.title_face == HUD_FACE_BODY && b.title_face == HUD_FACE_TITLE;
  // SCIFI's palette is the Verse HUD's: grey-white text and the Arwes cyan accent
  #assert a.text.r == 0.94 && a.trim.r == 0.216 && a.trim.g == 0.851;
  // FANTASY's text is warm: more red than blue, everywhere it is read
  for c: [4] HudRgba.[b.text, b.title, b.trim, b.parchment] { #assert c.r > c.b + 0.15; }
}

hud_style_named :: (name: string) -> int {
  if name.count != 7 { return HUD_SCIFI; }
  want := "fantasy";
  for i: 0..<7 { c := name[i]; if c >= 'A' && c <= 'Z' { c += 32; } if c != want[i] { return HUD_SCIFI; } }
  return HUD_FANTASY;
}

hud_rgba :: (r: f32, g: f32, b: f32, a: f32) -> HudRgba { return HudRgba.{r = r, g = g, b = b, a = a}; }
hud_fade :: (c: HudRgba, a: f32) -> HudRgba { return HudRgba.{r = c.r, g = c.g, b = c.b, a = c.a * a}; }
hud_mix :: (p: HudRgba, q: HudRgba, t: f32) -> HudRgba {
  return HudRgba.{r = p.r + (q.r - p.r) * t, g = p.g + (q.g - p.g) * t, b = p.b + (q.b - p.b) * t, a = p.a + (q.a - p.a) * t};
}

hud_tokens :: (style: int) -> HudTokens {
  if style == HUD_FANTASY {
    return HudTokens.{style = HUD_FANTASY, name = "fantasy",
      frame_dark = hud_rgba(0.075, 0.062, 0.050, 0.86), frame_mid = hud_rgba(0.32, 0.24, 0.15, 1),
      frame_light = hud_rgba(0.62, 0.48, 0.30, 1), trim = hud_rgba(0.86, 0.68, 0.36, 1),
      text = hud_rgba(0.95, 0.89, 0.76, 1), text_dim = hud_rgba(0.72, 0.64, 0.52, 1), title = hud_rgba(0.98, 0.84, 0.52, 1),
      parchment = hud_rgba(0.70, 0.60, 0.43, 0.94),
      hp = hud_rgba(0.72, 0.12, 0.09, 1), hp_back = hud_rgba(0.13, 0.05, 0.04, 0.92), hp_low = hud_rgba(0.95, 0.30, 0.16, 1),
      magic = hud_rgba(0.42, 0.62, 0.98, 1),
      good = hud_rgba(0.42, 0.80, 0.36, 1), bad = hud_rgba(0.92, 0.32, 0.22, 1),
      damage = hud_rgba(1.0, 0.62, 0.26, 1), heal = hud_rgba(0.55, 0.95, 0.45, 1),
      title_face = HUD_FACE_TITLE, label_face = HUD_FACE_TITLE,
      line = 1.5, radius = 6, corner = HUD_CORNER_ROUND, ornament = HUD_ORN_STUDS, stud = 4,
      bar = HUD_BAR_FRAMED, bar_segments = 10, slot = HUD_SLOT_RECESSED, banner = HUD_BANNER_RIBBON,
      damage_style = HUD_DAMAGE_OUTLINED, damage_scale = 1.6, shadow = 10};
  }
  g := 0.94f32;
  return HudTokens.{style = HUD_SCIFI, name = "scifi",
    frame_dark = hud_rgba(0, 0, 0, 0.55), frame_mid = hud_rgba(0.42, 0.42, 0.42, 1), frame_light = hud_rgba(0.78, 0.78, 0.78, 1),
    trim = hud_rgba(0.216, 0.851, 0.851, 1),
    text = hud_rgba(g, g, g, 1), text_dim = hud_rgba(0.6, 0.6, 0.6, 1), title = hud_rgba(g, g, g, 1),
    parchment = hud_rgba(0, 0, 0, 0.55),
    hp = hud_rgba(0.85, 0.13, 0.10, 1), hp_back = hud_rgba(0.35, 0.22, 0.20, 1), hp_low = hud_rgba(1, 0.3, 0.25, 1),
    magic = hud_rgba(0.216, 0.851, 0.851, 1),
    good = hud_rgba(0.3, 0.9, 0.2, 1), bad = hud_rgba(0.95, 0.2, 0.15, 1),
    damage = hud_rgba(1, 0.55, 0.35, 1), heal = hud_rgba(0.5, 0.95, 0.55, 1),
    title_face = HUD_FACE_BODY, label_face = HUD_FACE_BODY,
    line = 1, radius = 10, corner = HUD_CORNER_CUT, ornament = HUD_ORN_NONE, stud = 0,
    bar = HUD_BAR_LINE, bar_segments = 1, slot = HUD_SLOT_OUTLINE, banner = HUD_BANNER_RULES,
    damage_style = HUD_DAMAGE_PLAIN, damage_scale = 1, shadow = 0};
}

// ---- text roles: which face, colour and size (a share of the caller's cap) each role takes
HUD_TEXT_NAME :: 0;     // a character's name: the portrait's, a plate's
HUD_TEXT_TITLE :: 1;    // a panel's heading, a class
HUD_TEXT_NUMBER :: 2;   // HP, AC, counts
HUD_TEXT_LABEL :: 3;    // a small caption
HUD_TEXT_KEY :: 4;      // a slot's key
HUD_TEXT_BANNER :: 5;   // a place reached, a level gained
HUD_TEXT_DAMAGE :: 6; HUD_TEXT_HEAL :: 7; HUD_TEXT_WARN :: 8;
HudText :: struct { face: int; ink: HudRgba; scale: f32 = 1; shadow: bool; outline: bool; }

#test "text roles: FANTASY names and banners in the title face, numbers in the body; damage outlined and larger" {
  f := hud_tokens(HUD_FANTASY); s := hud_tokens(HUD_SCIFI);
  #assert hud_text(f, HUD_TEXT_NAME).face == HUD_FACE_TITLE && hud_text(f, HUD_TEXT_BANNER).face == HUD_FACE_TITLE;
  #assert hud_text(f, HUD_TEXT_NUMBER).face == HUD_FACE_BODY && hud_text(f, HUD_TEXT_DAMAGE).face == HUD_FACE_BODY;
  #assert hud_text(f, HUD_TEXT_DAMAGE).outline && !hud_text(s, HUD_TEXT_DAMAGE).outline;
  #assert hud_text(f, HUD_TEXT_DAMAGE).scale > hud_text(s, HUD_TEXT_DAMAGE).scale;
  #assert hud_text(f, HUD_TEXT_LABEL).shadow && !hud_text(s, HUD_TEXT_LABEL).shadow;
  for r: 0..<9 { #assert hud_text(s, r).face == HUD_FACE_BODY && hud_text(f, r).scale > 0; }
}
hud_text :: (t: HudTokens, role: int) -> HudText {
  fan := t.style == HUD_FANTASY;
  if role == HUD_TEXT_NAME { return HudText.{face = t.title_face, ink = t.title, shadow = fan}; }
  if role == HUD_TEXT_TITLE { return HudText.{face = t.title_face, ink = t.title, shadow = fan}; }
  if role == HUD_TEXT_NUMBER { return HudText.{face = HUD_FACE_BODY, ink = t.text, shadow = fan}; }
  if role == HUD_TEXT_LABEL { return HudText.{face = t.label_face, ink = t.text_dim, scale = 0.9, shadow = fan}; }
  if role == HUD_TEXT_KEY { return HudText.{face = t.label_face, ink = t.text, scale = 0.85, shadow = fan}; }
  if role == HUD_TEXT_BANNER { return HudText.{face = t.title_face, ink = t.title, scale = 1.5, shadow = fan, outline = fan}; }
  if role == HUD_TEXT_DAMAGE { return HudText.{face = HUD_FACE_BODY, ink = t.damage, scale = t.damage_scale, outline = fan}; }
  if role == HUD_TEXT_HEAL { return HudText.{face = HUD_FACE_BODY, ink = t.heal, scale = t.damage_scale, outline = fan}; }
  return HudText.{face = HUD_FACE_BODY, ink = t.bad, shadow = fan};
}

// ---- primitives
HUD_PRIM_FILL :: 1;     // a rounded box (radius; width = its edge's softness), top colour to bottom
HUD_PRIM_RING :: 2;     // a rounded box's edge, width thick, inside the box
HUD_PRIM_SHADOW :: 3;   // a rounded box's soft shadow, width its reach
HUD_PRIM_SWEEP :: 4;    // a box's pie: share of a turn dark from twelve o'clock, clockwise
HUD_PRIMS :: 512;
HudPrim :: struct {
  kind: int; x0: f32; y0: f32; x1: f32; y1: f32;
  radius: f32; width: f32; top: HudRgba; bottom: HudRgba;
  turn: f32;    // radians about the box's centre: a diamond is a square at a quarter turn
  share: f32;   // a sweep's share
}
HudList :: struct { p: [HUD_PRIMS] HudPrim; n: int; dropped: int; }

#test "a list keeps what fits and counts what it dropped, never writing past its end" {
  l: [1] HudList;
  for i: 0..<HUD_PRIMS + 5 { hud_fill(l[..], hud_box(0, 0, 10, 10), 2, hud_rgba(1, 1, 1, 1), hud_rgba(1, 1, 1, 1)); }
  #assert l[0].n == HUD_PRIMS && l[0].dropped == 5;
  hud_clear(l[..]); #assert l[0].n == 0 && l[0].dropped == 0;
  // nothing empty or invisible is kept
  hud_fill(l[..], hud_box(5, 5, 5, 20), 0, hud_rgba(1, 1, 1, 1), hud_rgba(1, 1, 1, 1));
  hud_fill(l[..], hud_box(0, 0, 10, 10), 0, hud_rgba(1, 1, 1, 0), hud_rgba(1, 1, 1, 0));
  hud_ring(l[..], hud_box(0, 0, 10, 10), 0, 0, hud_rgba(1, 1, 1, 1), hud_rgba(1, 1, 1, 1));
  #assert l[0].n == 0;
}

hud_box :: (x0: f32, y0: f32, x1: f32, y1: f32) -> HudPrim { return HudPrim.{x0 = x0, y0 = y0, x1 = x1, y1 = y1}; }
hud_clear :: (l: [] HudList) { l[0].n = 0; l[0].dropped = 0; }
hud_put :: (l: [] HudList, p: HudPrim) {
  if !(p.x1 > p.x0) || !(p.y1 > p.y0) || (p.top.a <= 0 && p.bottom.a <= 0) { return; }
  if p.kind == HUD_PRIM_RING && !(p.width > 0) { return; }
  if l[0].n >= HUD_PRIMS { l[0].dropped += 1; return; }
  l[0].p[l[0].n] = p; l[0].n += 1;
}
hud_fill :: (l: [] HudList, b: HudPrim, radius: f32, top: HudRgba, bottom: HudRgba) {
  p := b; p.kind = HUD_PRIM_FILL; p.radius = radius; p.width = 0.75; p.top = top; p.bottom = bottom; hud_put(l[..], p);
}
hud_ring :: (l: [] HudList, b: HudPrim, radius: f32, width: f32, top: HudRgba, bottom: HudRgba) {
  p := b; p.kind = HUD_PRIM_RING; p.radius = radius; p.width = width; p.top = top; p.bottom = bottom; hud_put(l[..], p);
}
hud_shadow :: (l: [] HudList, b: HudPrim, radius: f32, reach: f32, c: HudRgba) {
  if !(reach > 0) { return; }
  p := b; p.kind = HUD_PRIM_SHADOW; p.radius = radius; p.width = reach; p.top = c; p.bottom = c;
  p.x0 -= reach; p.y0 -= reach * 0.6; p.x1 += reach; p.y1 += reach * 1.4; hud_put(l[..], p);
}
hud_line :: (l: [] HudList, x0: f32, y0: f32, x1: f32, y1: f32, wide: f32, c: HudRgba) {
  // an axis-aligned rule as a thin box with round ends (the HUD's rules are level or plumb)
  h := wide * 0.5;
  hud_fill(l, hud_box((ifx x0 < x1 then x0 else x1) - h, (ifx y0 < y1 then y0 else y1) - h,
                      (ifx x0 < x1 then x1 else x0) + h, (ifx y0 < y1 then y1 else y0) + h), h, c, c);
}
hud_diamond :: (l: [] HudList, cx: f32, cy: f32, r: f32, top: HudRgba, bottom: HudRgba) {
  // a square of half-diagonal r turned an eighth: its corners up, down, left and right
  h := r * 0.7071068;
  p := hud_box(cx - h, cy - h, cx + h, cy + h); p.turn = 0.7853982; hud_fill(l[..], p, r * 0.08, top, bottom);
}
hud_disc :: (l: [] HudList, cx: f32, cy: f32, r: f32, top: HudRgba, bottom: HudRgba) { hud_fill(l[..], hud_box(cx - r, cy - r, cx + r, cy + r), r, top, bottom); }
hud_circle :: (l: [] HudList, cx: f32, cy: f32, r: f32, wide: f32, top: HudRgba, bottom: HudRgba) { hud_ring(l[..], hud_box(cx - r, cy - r, cx + r, cy + r), r, wide, top, bottom); }
hud_sweep :: (l: [] HudList, b: HudPrim, share: f32, c: HudRgba) {
  if !(share > 0) { return; }
  p := b; p.kind = HUD_PRIM_SWEEP; p.share = ifx share > 1 then 1.0f32 else share; p.top = c; p.bottom = c; hud_put(l[..], p);
}

// ---- the parts. k is the caller's scale (device pixels a point).
#test "a FANTASY panel: shadow, body, metal frame, gold inner line and four studs; SCIFI: a body and its cut outline" {
  l: [1] HudList; b := hud_box(10, 10, 210, 90);
  hud_panel(l[..], hud_tokens(HUD_FANTASY), b, 1);
  #assert l[0].n == 8 && l[0].p[0].kind == HUD_PRIM_SHADOW && l[0].p[1].kind == HUD_PRIM_FILL && l[0].p[2].kind == HUD_PRIM_RING;
  for i: 4..<8 { #assert abs(l[0].p[i].turn - 0.7853982) < 0.0001; }
  // the studs sit on the frame's corners
  #assert l[0].p[4].x0 < 10 + 6 && l[0].p[4].y0 < 10 + 6;
  hud_clear(l[..]); hud_panel(l[..], hud_tokens(HUD_SCIFI), b, 1);
  #assert l[0].n == 9 && l[0].p[0].kind == HUD_PRIM_FILL;
  for i: 1..<9 { #assert l[0].p[i].kind == HUD_PRIM_FILL && l[0].p[i].turn == 0; }
}
hud_panel :: (l: [] HudList, t: HudTokens, b: HudPrim, k: f32) {
  if t.style == HUD_FANTASY {
    r := t.radius * k; w := t.line * k;
    hud_shadow(l[..], b, r, t.shadow * k, hud_rgba(0, 0, 0, 0.45));
    hud_fill(l[..], b, r, hud_mix(t.frame_dark, hud_rgba(0.16, 0.13, 0.10, t.frame_dark.a), 0.6), t.frame_dark);
    hud_ring(l[..], b, r, 2.5 * w, t.frame_light, t.frame_mid);
    i := b; inset := 4 * w; i.x0 += inset; i.y0 += inset; i.x1 -= inset; i.y1 -= inset;
    hud_ring(l[..], i, r * 0.6, 0.75 * k, hud_fade(t.trim, 0.55), hud_fade(t.trim, 0.25));
    s := t.stud * k;
    for c: 0..<4 {
      cx := ifx c % 2 == 0 then b.x0 + 2 * w else b.x1 - 2 * w; cy := ifx c < 2 then b.y0 + 2 * w else b.y1 - 2 * w;
      hud_diamond(l[..], cx, cy, s, t.trim, hud_mix(t.trim, t.frame_mid, 0.5));
    }
    return;
  }
  // SCIFI: dim glass and an outline whose two opposite corners are cut (verse/hud/frame.coax's panel)
  hud_fill(l[..], b, 0, t.frame_dark, t.frame_dark);
  c := t.radius * k; w := t.line * k; e := t.frame_light;
  hud_line(l[..], b.x0 + c, b.y0, b.x1, b.y0, w, e); hud_line(l[..], b.x1, b.y0, b.x1, b.y1 - c, w, e);
  hud_line(l[..], b.x0, b.y1, b.x1 - c, b.y1, w, e); hud_line(l[..], b.x0, b.y0 + c, b.x0, b.y1, w, e);
  // the cuts, as short steps (a rule is level or plumb)
  for q: 0..<2 {
    f := f32(q + 1) / 3;
    hud_line(l[..], b.x0 + c * f, b.y0 + c * (1 - f), b.x0 + c * f + w, b.y0 + c * (1 - f), w, e);
    hud_line(l[..], b.x1 - c * f - w, b.y1 - c * (1 - f), b.x1 - c * f, b.y1 - c * (1 - f), w, e);
  }
}

#test "a bar: FANTASY frames its back, its fill and its segments; the fill is the share, clamped" {
  l: [1] HudList; t := hud_tokens(HUD_FANTASY); b := hud_box(0, 0, 200, 12);
  hud_bar(l[..], t, b, 0.5, t.hp, 1);
  fills := 0; fill_w: f32 = 0;
  want := hud_mix(t.hp, hud_rgba(0, 0, 0, 1), 0.35);
  for i: 0..<l[0].n { p := l[0].p[i]; if p.kind == HUD_PRIM_FILL && p.bottom.r == want.r && p.bottom.g == want.g { fills += 1; fill_w = p.x1 - p.x0; } }
  #assert fills == 1 && abs(fill_w - 100) < 0.01;
  hud_clear(l[..]); hud_bar(l[..], t, b, 3, t.hp, 1);
  for i: 0..<l[0].n { p := l[0].p[i]; #assert p.x1 <= 203.01 && p.x0 >= -3.01; }
  hud_clear(l[..]); hud_bar(l[..], t, b, -1, t.hp, 1); n0 := l[0].n;
  hud_clear(l[..]); hud_bar(l[..], t, b, 0.0f32 / 0.0f32, t.hp, 1); #assert l[0].n == n0;
  hud_clear(l[..]); hud_bar(l[..], hud_tokens(HUD_SCIFI), b, 0.5, t.hp, 1); #assert l[0].n == 2;
}
hud_bar :: (l: [] HudList, t: HudTokens, b: HudPrim, share: f32, c: HudRgba, k: f32) {
  v := ifx !(share > 0) then 0.0f32 else ifx share > 1 then 1.0f32 else share;
  h := b.y1 - b.y0;
  if t.bar == HUD_BAR_LINE {
    y := (b.y0 + b.y1) * 0.5;
    hud_line(l[..], b.x0, y, b.x1, y, h, t.hp_back);
    if v > 0 { hud_line(l[..], b.x0, y, b.x0 + (b.x1 - b.x0) * v, y, h, c); }
    return;
  }
  r := h * 0.5; w := t.line * k;
  o := b; o.x0 -= 2 * w; o.y0 -= 2 * w; o.x1 += 2 * w; o.y1 += 2 * w;
  hud_fill(l[..], o, r + 2 * w, t.frame_mid, hud_mix(t.frame_mid, hud_rgba(0, 0, 0, 1), 0.5));
  hud_fill(l[..], b, r, t.hp_back, hud_mix(t.hp_back, hud_rgba(0, 0, 0, 1), 0.4));
  if v > 0 {
    f := b; f.x1 = b.x0 + (b.x1 - b.x0) * v;
    if f.x1 - f.x0 < h { f.x1 = f.x0 + h; }   // a sliver still reads as a rounded end
    hud_fill(l[..], f, r, hud_mix(c, hud_rgba(1, 0.9, 0.7, 1), 0.28), hud_mix(c, hud_rgba(0, 0, 0, 1), 0.35));
    g := f; g.y1 = f.y0 + h * 0.42; g.x0 += r * 0.5; g.x1 -= r * 0.5;
    hud_fill(l[..], g, r * 0.5, hud_rgba(1, 0.95, 0.85, 0.30), hud_rgba(1, 0.95, 0.85, 0.06));
  }
  for s: 1..<t.bar_segments {
    x := b.x0 + (b.x1 - b.x0) * f32(s) / f32(t.bar_segments);
    hud_line(l[..], x, b.y0 + 1 * k, x, b.y1 - 1 * k, 1 * k, hud_rgba(0, 0, 0, 0.42));
  }
  hud_ring(l[..], o, r + 2 * w, 1 * k, hud_fade(t.frame_light, 0.9), hud_fade(t.frame_mid, 0.9));
}

#test "a slot: FANTASY sinks it and trims it gold when ready; SCIFI draws its outline" {
  l: [1] HudList; t := hud_tokens(HUD_FANTASY); b := hud_box(100, 100, 152, 152);
  hud_slot(l[..], t, b, 1, false); n0 := l[0].n;
  hud_clear(l[..]); hud_slot(l[..], t, b, 1, true); #assert l[0].n == n0 + 1;
  // the frame stays outside the picture, the picture's box itself is left clear
  for i: 0..<l[0].n { p := l[0].p[i]; #assert p.kind != HUD_PRIM_FILL || p.x0 < 100 || p.y0 < 100 || p.x1 > 152 || p.y1 > 152; }
  hud_clear(l[..]); hud_slot(l[..], hud_tokens(HUD_SCIFI), b, 1, true); #assert l[0].n == 4;
}
hud_slot :: (l: [] HudList, t: HudTokens, b: HudPrim, k: f32, ready: bool) {
  w := t.line * k;
  if t.slot == HUD_SLOT_OUTLINE {
    e := ifx ready then t.trim else t.frame_light;
    hud_line(l[..], b.x0, b.y0, b.x1, b.y0, w, e); hud_line(l[..], b.x0, b.y1, b.x1, b.y1, w, e);
    hud_line(l[..], b.x0, b.y0, b.x0, b.y1, w, e); hud_line(l[..], b.x1, b.y0, b.x1, b.y1, w, e);
    return;
  }
  o := b; o.x0 -= 4 * w; o.y0 -= 4 * w; o.x1 += 4 * w; o.y1 += 4 * w;
  // a sunk well: dark above where the light can't reach, the metal lit below
  hud_ring(l[..], o, 4 * k, 4 * w, hud_mix(t.frame_mid, hud_rgba(0, 0, 0, 1), 0.55), t.frame_light);
  hud_ring(l[..], b, 2 * k, 1 * k, hud_rgba(0, 0, 0, 0.75), hud_rgba(0, 0, 0, 0.35));
  if ready { hud_ring(l[..], o, 4 * k, 1 * k, hud_fade(t.trim, 0.95), hud_fade(t.trim, 0.55)); }
}

// A tray under a row of slots: the action bar's iron and its end caps.
hud_tray :: (l: [] HudList, t: HudTokens, b: HudPrim, k: f32) {
  if t.style != HUD_FANTASY { hud_fill(l[..], b, 0, t.frame_dark, t.frame_dark); return; }
  r := 10 * k; w := t.line * k;
  hud_shadow(l[..], b, r, t.shadow * k, hud_rgba(0, 0, 0, 0.5));
  hud_fill(l[..], b, r, hud_rgba(0.20, 0.16, 0.12, 0.92), hud_rgba(0.06, 0.05, 0.04, 0.95));
  hud_ring(l[..], b, r, 3 * w, t.frame_light, hud_mix(t.frame_mid, hud_rgba(0, 0, 0, 1), 0.3));
  top := b.y0 + 1.5 * w;
  hud_line(l[..], b.x0 + r, top, b.x1 - r, top, 1 * k, hud_fade(t.trim, 0.7));
  for e: 0..<2 {
    cx := ifx e == 0 then b.x0 else b.x1; cy := (b.y0 + b.y1) * 0.5; s := (b.y1 - b.y0) * 0.36;
    hud_diamond(l[..], cx, cy, s, t.frame_light, t.frame_mid);
    hud_diamond(l[..], cx, cy, s * 0.55, t.trim, hud_mix(t.trim, t.frame_mid, 0.6));
  }
}

// A button: a raised plate of metal (FANTASY) or an outline (SCIFI). lit marks the one chosen (a
// tab, a toggle that is on): a gold trim and a warmer face. The caller writes its label over it.
#test "a button: FANTASY raises a plate and trims the chosen one gold; SCIFI outlines it" {
  l: [1] HudList; t := hud_tokens(HUD_FANTASY); b := hud_box(10, 10, 110, 54);
  hud_button(l[..], t, b, 1, false); n0 := l[0].n;
  hud_clear(l[..]); hud_button(l[..], t, b, 1, true); #assert l[0].n == n0 + 1 && n0 >= 3;
  for i: 0..<l[0].n { p := l[0].p[i]; #assert p.x0 >= 10 - 0.01 && p.x1 <= 110.01 && p.y0 >= 10 - 0.01 && p.y1 <= 56.01; }
  hud_clear(l[..]); hud_button(l[..], hud_tokens(HUD_SCIFI), b, 1, true); #assert l[0].n == 4;
}
hud_button :: (l: [] HudList, t: HudTokens, b: HudPrim, k: f32, lit: bool) {
  if t.style != HUD_FANTASY {
    e := ifx lit then t.trim else t.frame_light; w := t.line * k;
    hud_line(l[..], b.x0, b.y0, b.x1, b.y0, w, e); hud_line(l[..], b.x0, b.y1, b.x1, b.y1, w, e);
    hud_line(l[..], b.x0, b.y0, b.x0, b.y1, w, e); hud_line(l[..], b.x1, b.y0, b.x1, b.y1, w, e);
    return;
  }
  r := 5 * k; w := t.line * k;
  // a lip of shadow under it, so it stands off the panel
  s := b; s.y0 += 2 * k; s.y1 += 2 * k; hud_fill(l[..], s, r, hud_rgba(0, 0, 0, 0.5), hud_rgba(0, 0, 0, 0.5));
  face_top := ifx lit then hud_rgba(0.42, 0.31, 0.17, 0.97) else hud_rgba(0.27, 0.21, 0.15, 0.95);
  face_bottom := ifx lit then hud_rgba(0.20, 0.14, 0.08, 0.97) else hud_rgba(0.11, 0.09, 0.07, 0.95);
  hud_fill(l[..], b, r, face_top, face_bottom);
  hud_ring(l[..], b, r, 1.5 * w, t.frame_light, hud_mix(t.frame_mid, hud_rgba(0, 0, 0, 1), 0.35));
  if lit { i := b; i.x0 += 3 * k; i.y0 += 3 * k; i.x1 -= 3 * k; i.y1 -= 3 * k; hud_ring(l[..], i, r * 0.6, 1 * k, t.trim, hud_fade(t.trim, 0.6)); }
}
// A sunk well: a row of a form, a field's ground. Darker than the panel, a hairline round it.
hud_well :: (l: [] HudList, t: HudTokens, b: HudPrim, k: f32, lit: bool) {
  if t.style != HUD_FANTASY { hud_fill(l[..], b, 0, t.frame_dark, t.frame_dark); return; }
  r := 6 * k;
  hud_fill(l[..], b, r, hud_rgba(0.03, 0.025, 0.02, 0.62), hud_rgba(0.08, 0.065, 0.05, 0.55));
  hud_ring(l[..], b, r, 1 * k, ifx lit then hud_fade(t.trim, 0.85) else hud_rgba(0, 0, 0, 0.6), ifx lit then hud_fade(t.trim, 0.5) else hud_fade(t.frame_light, 0.35));
}
// A tray under a row of slots, leaving each slot's own box clear (the realm draws the slots'
// pictures under its strokes, so the tray's iron must not cover them): strips above, below and
// between. sx holds each slot's left and right edge, n slots, all between y0 and y1.
hud_tray_round :: (l: [] HudList, t: HudTokens, b: HudPrim, y0: f32, y1: f32, sx: [] f32, n: int, k: f32) {
  if t.style != HUD_FANTASY { return; }
  r := 8 * k; w := t.line * k;
  top := hud_rgba(0.20, 0.16, 0.12, 0.92); bottom := hud_rgba(0.06, 0.05, 0.04, 0.95);
  mid := hud_mix(top, bottom, 0.5);
  hud_fill(l[..], hud_box(b.x0, b.y0, b.x1, y0), 0, top, hud_mix(top, bottom, 0.25));
  hud_fill(l[..], hud_box(b.x0, y1, b.x1, b.y1), 0, hud_mix(top, bottom, 0.75), bottom);
  x := b.x0;
  for i: 0..<n { hud_fill(l[..], hud_box(x, y0, sx[2 * i], y1), 0, mid, mid); x = sx[2 * i + 1]; }
  hud_fill(l[..], hud_box(x, y0, b.x1, y1), 0, mid, mid);
  hud_ring(l[..], b, 2 * k, 3 * w, t.frame_light, hud_mix(t.frame_mid, hud_rgba(0, 0, 0, 1), 0.3));
  hud_line(l[..], b.x0 + r, b.y0 + 1.5 * w, b.x1 - r, b.y0 + 1.5 * w, 1 * k, hud_fade(t.trim, 0.7));
  for e: 0..<2 {
    cx := ifx e == 0 then b.x0 else b.x1; cy := (b.y0 + b.y1) * 0.5; s := (b.y1 - b.y0) * 0.36;
    hud_diamond(l[..], cx, cy, s, t.frame_light, t.frame_mid);
    hud_diamond(l[..], cx, cy, s * 0.55, t.trim, hud_mix(t.trim, t.frame_mid, 0.6));
  }
}
#test "a tray round slots leaves every slot's box clear" {
  l: [1] HudList; t := hud_tokens(HUD_FANTASY);
  sx := [6] f32.[20, 72, 80, 132, 140, 192];
  hud_tray_round(l[..], t, hud_box(10, 90, 202, 160), 100, 152, sx[..], 3, 1);
  for i: 0..<l[0].n { p := l[0].p[i]; if p.kind != HUD_PRIM_FILL || p.turn != 0 || p.y1 - p.y0 < 3 { continue; }
    for s: 0..<3 { #assert p.x1 <= sx[2 * s] + 0.01 || p.x0 >= sx[2 * s + 1] - 0.01 || p.y1 <= 100.01 || p.y0 >= 151.99; } }
}

// A round medallion: a portrait's, a map's, a button's. Its face is the caller's colour.
hud_medallion :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, r: f32, face_top: HudRgba, face_bottom: HudRgba, k: f32) {
  w := t.line * k;
  if t.style != HUD_FANTASY { hud_disc(l[..], cx, cy, r, face_top, face_bottom); hud_circle(l[..], cx, cy, r, w, t.trim, t.trim); return; }
  hud_disc(l[..], cx, cy + 2 * k, r + 3 * w, hud_rgba(0, 0, 0, 0.45), hud_rgba(0, 0, 0, 0.45));
  hud_disc(l[..], cx, cy, r, face_top, face_bottom);
  hud_circle(l[..], cx, cy, r + 2.5 * w, 3.5 * w, t.frame_light, t.frame_mid);
  hud_circle(l[..], cx, cy, r - 0.5 * w, 1 * k, hud_fade(t.trim, 0.8), hud_fade(t.trim, 0.4));
}

// A small round badge (a level, an AC): its metal, its rim; the caller writes its number.
hud_badge :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, r: f32, k: f32) {
  if t.style != HUD_FANTASY { hud_circle(l[..], cx, cy, r, t.line * k, t.trim, t.trim); return; }
  hud_disc(l[..], cx, cy, r, hud_rgba(0.30, 0.22, 0.13, 1), hud_rgba(0.12, 0.09, 0.06, 1));
  hud_circle(l[..], cx, cy, r, 1.5 * k, t.trim, hud_mix(t.trim, t.frame_mid, 0.6));
}

// A shield (an AC): a box rounded at the top and coming to a point below, in two prims.
hud_shield :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, r: f32, k: f32) {
  if t.style != HUD_FANTASY { hud_badge(l[..], t, cx, cy, r, k); return; }
  hud_diamond(l[..], cx, cy + r * 0.35, r * 0.95, t.trim, hud_mix(t.trim, t.frame_mid, 0.6));
  hud_fill(l[..], hud_box(cx - r * 0.82, cy - r, cx + r * 0.82, cy + r * 0.45), r * 0.3, t.trim, hud_mix(t.trim, t.frame_mid, 0.4));
  hud_diamond(l[..], cx, cy + r * 0.3, r * 0.78, hud_rgba(0.30, 0.22, 0.13, 1), hud_rgba(0.12, 0.09, 0.06, 1));
  hud_fill(l[..], hud_box(cx - r * 0.66, cy - r * 0.84, cx + r * 0.66, cy + r * 0.38), r * 0.22, hud_rgba(0.30, 0.22, 0.13, 1), hud_rgba(0.16, 0.12, 0.08, 1));
}

// A gem: a spell slot, filled when it is left, hollow when spent.
hud_gem :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, r: f32, full: bool, k: f32) {
  if full { hud_diamond(l[..], cx, cy, r, hud_mix(t.magic, hud_rgba(1, 1, 1, 1), 0.45), hud_mix(t.magic, hud_rgba(0, 0, 0, 1), 0.3)); }
  else { hud_diamond(l[..], cx, cy, r, hud_rgba(0.05, 0.05, 0.08, 0.85), hud_rgba(0.10, 0.10, 0.14, 0.85)); }
  if t.style == HUD_FANTASY {
    h := r * 0.7071068; p := hud_box(cx - h, cy - h, cx + h, cy + h); p.turn = 0.7853982;
    hud_ring(l[..], p, r * 0.08, 1 * k, t.trim, hud_mix(t.trim, t.frame_mid, 0.5));
  }
}

#test "a banner fades in, holds and fades out over its life; FANTASY gives it a ribbon and diamonds" {
  #assert hud_banner_alpha(-0.1, 3) == 0 && hud_banner_alpha(0, 3) == 0 && hud_banner_alpha(1, 3) == 1 && hud_banner_alpha(3, 3) == 0;
  #assert hud_banner_alpha(0.15, 3) > 0.4 && hud_banner_alpha(0.15, 3) < 0.6 && hud_banner_alpha(2.85, 3) < 0.6;
  l: [1] HudList; hud_banner(l[..], hud_tokens(HUD_FANTASY), 960, 300, 300, 40, 1, 1);
  d := 0; for i: 0..<l[0].n { if l[0].p[i].turn != 0 { d += 1; } } #assert d == 2 && l[0].n >= 6;
  hud_clear(l[..]); hud_banner(l[..], hud_tokens(HUD_SCIFI), 960, 300, 300, 40, 1, 1); #assert l[0].n == 2;
}
hud_banner_alpha :: (age: f32, life: f32) -> f32 {
  if !(age > 0) || age >= life { return 0; }
  a := ifx age < 0.3 then age / 0.3 else ifx age > life - 0.3 then (life - age) / 0.3 else 1.0f32;
  return a;
}
// A banner centred at cx, cy, half as wide as half_w, h tall.
hud_banner :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, half_w: f32, h: f32, alpha: f32, k: f32) {
  if !(alpha > 0) { return; }
  if t.banner == HUD_BANNER_RULES {
    hud_line(l[..], cx - half_w, cy - h * 0.5, cx + half_w, cy - h * 0.5, t.line * k, hud_fade(t.trim, alpha));
    hud_line(l[..], cx - half_w, cy + h * 0.5, cx + half_w, cy + h * 0.5, t.line * k, hud_fade(t.trim, alpha));
    return;
  }
  // the ribbon: dark in the middle, gone at its ends, in eight steps each side
  for q: 0..<8 {
    f0 := f32(q) / 8; f1 := f32(q + 1) / 8; a := alpha * 0.62 * (1 - f0 * f0);
    c := hud_rgba(0.06, 0.04, 0.03, a);
    hud_fill(l[..], hud_box(cx + half_w * f0, cy - h * 0.5, cx + half_w * f1 + 0.5, cy + h * 0.5), 0, c, c);
    hud_fill(l[..], hud_box(cx - half_w * f1 - 0.5, cy - h * 0.5, cx - half_w * f0, cy + h * 0.5), 0, c, c);
  }
  rule := hud_fade(t.trim, alpha * 0.9); w := 1.2 * k;
  hud_line(l[..], cx - half_w * 0.8, cy - h * 0.5, cx + half_w * 0.8, cy - h * 0.5, w, rule);
  hud_line(l[..], cx - half_w * 0.8, cy + h * 0.5, cx + half_w * 0.8, cy + h * 0.5, w, rule);
  hud_diamond(l[..], cx - half_w * 0.8 - 5 * k, cy - h * 0.5, 4 * k, rule, rule);
  hud_diamond(l[..], cx + half_w * 0.8 + 5 * k, cy - h * 0.5, 4 * k, rule, rule);
}

// A name plate over a creature: its bar under the name, red for a foe, gold for your target.
hud_plate :: (l: [] HudList, t: HudTokens, cx: f32, y: f32, half_w: f32, share: f32, foe: bool, target: bool, alpha: f32, k: f32) {
  if !(alpha > 0) { return; }
  h := ifx t.style == HUD_FANTASY then 5 * k else 2.5 * k;
  c := ifx foe then t.hp else t.good;
  tt := t; tt.bar_segments = ifx t.style == HUD_FANTASY then 4 else 1;
  tt.frame_mid = hud_fade(t.frame_mid, alpha); tt.frame_light = hud_fade(ifx target then t.trim else t.frame_light, alpha);
  tt.hp_back = hud_fade(t.hp_back, alpha);
  hud_bar(l[..], tt, hud_box(cx - half_w, y - h * 0.5, cx + half_w, y + h * 0.5), share, hud_fade(c, alpha), k);
  if target && t.style == HUD_FANTASY {
    hud_diamond(l[..], cx - half_w - 6 * k, y, 3.5 * k, hud_fade(t.trim, alpha), hud_fade(t.trim, alpha));
    hud_diamond(l[..], cx + half_w + 6 * k, y, 3.5 * k, hud_fade(t.trim, alpha), hud_fade(t.trim, alpha));
  }
}

#test "a map ring: its parchment inside, the frame round it, four studs at the compass points" {
  l: [1] HudList; hud_map_ring(l[..], hud_tokens(HUD_FANTASY), 100, 100, 60, 1);
  studs := 0; for i: 0..<l[0].n { if l[0].p[i].turn != 0 { studs += 1; } }
  #assert studs == 4 && l[0].p[1].kind == HUD_PRIM_FILL && l[0].p[1].x0 == 40;
}
hud_map_ring :: (l: [] HudList, t: HudTokens, cx: f32, cy: f32, r: f32, k: f32) {
  hud_medallion(l[..], t, cx, cy, r, t.parchment, hud_mix(t.parchment, hud_rgba(0.3, 0.24, 0.16, 0.94), 0.6), k);
  if t.style != HUD_FANTASY { return; }
  for q: 0..<4 {
    a := f32(q) * 1.5707963; rr := r + 3 * t.line * k;
    hud_diamond(l[..], cx + sin(a) * rr, cy - cos(a) * rr, (ifx q == 0 then 6.5f32 else 4.5f32) * k, t.trim, hud_mix(t.trim, t.frame_mid, 0.5));
  }
}

// The point on a map ring of radius r for a thing dx, dz metres off: the map turns with your view,
// fx, fz its forward and rx, rz its right on the ground, so ahead is up; reach metres fill the ring.
// A thing beyond the ring waits on its edge.
hud_map_point :: (cx: f32, cy: f32, r: f32, dx: f32, dz: f32, fx: f32, fz: f32, rx: f32, rz: f32, reach: f32) -> HudCoord {
  side := dx * rx + dz * rz; fwd := dx * fx + dz * fz;
  d := sqrt(side * side + fwd * fwd); scale := r / reach;
  if d * scale > r * 0.9 && d > 0.0001 { scale = r * 0.9 / d; }
  return HudCoord.{x = cx + side * scale, y = cy - fwd * scale};
}
#test "the map turns with you: ahead is up, your right is right, far things wait on the edge" {
  p := hud_map_point(100, 100, 50, 0, 10, 0, 1, 1, 0, 20);   // 10 m ahead
  #assert abs(p.x - 100) < 0.001 && abs(p.y - 75) < 0.001;
  q := hud_map_point(100, 100, 50, 10, 0, 0, 1, 1, 0, 20);   // 10 m to your right
  #assert abs(q.x - 125) < 0.001 && abs(q.y - 100) < 0.001;
  e := hud_map_point(100, 100, 50, 0, 400, 0, 1, 1, 0, 20);  // far ahead: on the ring's edge
  #assert abs(e.y - 55) < 0.01;
  r := hud_map_point(100, 100, 50, 0, 10, 1, 0, 0, -1, 20);  // facing +x with -z on your right: +z is left
  #assert r.x < 90 && abs(r.y - 100) < 0.01;
}
