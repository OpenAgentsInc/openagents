// A player's input and reading settings, one versioned record every host reads the same way (GitHub
// #12857): which key and which pad button does each action, the text size, reduced motion and sound
// captions. The defaults are usable as they are. A host maps its device's codes (a key's code, a
// pad's button index) through this record and nothing else, so the keys you see named on screen and
// the keys that work are the same record.
//
// The rules:
// - Every action has one key and one pad button, and no key or button does two actions. Binding a
//   code another action holds swaps them, so nothing is ever left unbound.
// - Text is 100 to 200 percent of its size, in steps of 25.
// - The saved text is "s1 k=... p=... t=... m=... c=...". A record of another version, or one that
//   doesn't read whole, gives the defaults and says so; it never half-applies.
//   coax/bin/coax test aethyr/ui/settings.coax --library
//   coax/bin/coax mutate aethyr/ui/settings.coax --library --root-only

#module "aethyr.ui.settings";
#authority;

// book:begin settings-profile
SETTINGS_VERSION :: 1;

// The actions a player can bind.
SA_FORWARD :: 0; SA_BACK :: 1; SA_LEFT :: 2; SA_RIGHT :: 3; SA_JUMP :: 4; SA_ACT :: 5; SA_WALK :: 6;
SA_CHAT :: 7; SA_MAP :: 8; SA_SLOT1 :: 9;   // SA_SLOT1 .. SA_SLOT1 + 9: the hotbar's ten slots
SA_N :: 19;

SD_KEYS :: 0; SD_PAD :: 1;                  // the devices a record binds
SETTINGS_CODE_MAX :: 255;                   // a key's or button's code: 0 to this
SETTINGS_TEXT_MIN :: 100; SETTINGS_TEXT_STEP :: 25; SETTINGS_TEXT_STEPS :: 4;   // 100, 125, 150, 175, 200

ST_OK :: 0;
ST_SWAPPED :: 1;       // the code was another action's: the two traded codes
ST_BAD_ACTION :: 2;
ST_BAD_CODE :: 3;
ST_BAD_DEVICE :: 4;
ST_BAD_TEXT :: 5;      // a text size off the steps or out of range
ST_VERSION :: 6;       // a saved record of another version: the defaults
ST_UNREADABLE :: 7;    // a saved record that doesn't read whole: the defaults

// Keys by their uppercase ASCII code (W A S D, Space 32, Shift 16, Enter 13, M, 1 to 9 and 0);
// pad buttons by the standard gamepad mapping's index.
SETTINGS_KEYS :: [SA_N] int.[87, 83, 65, 68, 32, 69, 16, 13, 77, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48];
SETTINGS_PAD :: [SA_N] int.[12, 13, 14, 15, 0, 2, 10, 9, 8, 4, 5, 6, 7, 1, 3, 11, 16, 17, 18];

Settings :: struct {
  version: int = SETTINGS_VERSION;
  keys: [SA_N] int; pad: [SA_N] int;
  text_pct: int = SETTINGS_TEXT_MIN;
  reduced_motion: bool;
  captions: bool = true;      // sounds that matter are said in words too
}
SettingsRead :: struct { s: Settings; status: int; }
// book:end settings-profile

settings_default :: () -> Settings #effects(all) {
  s: Settings;
  for a: 0..<SA_N { s.keys[a] = SETTINGS_KEYS[a]; s.pad[a] = SETTINGS_PAD[a]; }
  return s;
}
// The action device d's code does, or -1.
settings_action :: (s: Settings, d: int, code: int) -> int #effects(all) {
  for a: 0..<SA_N {
    c := ifx d == SD_KEYS then s.keys[a] else s.pad[a];
    if c == code && (d == SD_KEYS || d == SD_PAD) { return a; }
  }
  return -1;
}
// Binds device d's code to action a; a code another action held is swapped with a's old code.
settings_bind :: (s: [] Settings, d: int, a: int, code: int) -> int #effects(all) {
  if d != SD_KEYS && d != SD_PAD { return ST_BAD_DEVICE; }
  if a < 0 || a >= SA_N { return ST_BAD_ACTION; }
  if code < 0 || code > SETTINGS_CODE_MAX { return ST_BAD_CODE; }
  other := settings_action(s[0], d, code);
  if other == a { return ST_OK; }
  if d == SD_KEYS {
    if other >= 0 { s[0].keys[other] = s[0].keys[a]; }
    s[0].keys[a] = code;
  } else {
    if other >= 0 { s[0].pad[other] = s[0].pad[a]; }
    s[0].pad[a] = code;
  }
  return ifx other >= 0 then ST_SWAPPED else ST_OK;
}
settings_text_ok :: (pct: int) -> bool #effects(all) {
  k := (pct - SETTINGS_TEXT_MIN) / SETTINGS_TEXT_STEP;
  return pct >= SETTINGS_TEXT_MIN && k <= SETTINGS_TEXT_STEPS && SETTINGS_TEXT_MIN + k * SETTINGS_TEXT_STEP == pct;
}
settings_text :: (s: [] Settings, pct: int) -> int #effects(all) {
  if !settings_text_ok(pct) { return ST_BAD_TEXT; }
  s[0].text_pct = pct;
  return ST_OK;
}
// Whether a record keeps the rules: its version, every code in range, no code twice on a device, the text size.
settings_check :: (s: Settings) -> int #effects(all) {
  if s.version != SETTINGS_VERSION { return ST_VERSION; }
  for a: 0..<SA_N {
    if s.keys[a] < 0 || s.keys[a] > SETTINGS_CODE_MAX || s.pad[a] < 0 || s.pad[a] > SETTINGS_CODE_MAX { return ST_BAD_CODE; }
    for b: a + 1..<SA_N { if s.keys[a] == s.keys[b] || s.pad[a] == s.pad[b] { return ST_BAD_CODE; } }
  }
  if !settings_text_ok(s.text_pct) { return ST_BAD_TEXT; }
  return ST_OK;
}

// ---- the saved text

settings_put :: (out: [] u8, at: int, t: string) -> int #effects(all) {
  n := at;
  for c: t { if n < out.count { out[n] = c; n += 1; } }
  return n;
}
settings_int :: (out: [] u8, at: int, v: int) -> int #effects(all) {
  d: [20] u8; dn := 0; x := v;
  while x > 0 || dn == 0 { d[dn] = cast(u8) ('0' + x % 10); dn += 1; x = x / 10; }
  n := at;
  for j: 0..<dn { if n < out.count { out[n] = d[dn - 1 - j]; n += 1; } }
  return n;
}
settings_list :: (out: [] u8, at: int, codes: [] int) -> int #effects(all) {
  n := at;
  for a: 0..<codes.count { if a > 0 { n = settings_put(out, n, ","); } n = settings_int(out, n, codes[a]); }
  return n;
}
// "s1 k=K,K,... p=P,P,... t=PCT m=0|1 c=0|1": its length in out.
settings_write :: (s_in: Settings, out: [] u8) -> int #effects(all) {
  s := s_in;
  n := settings_put(out, 0, "s"); n = settings_int(out, n, s.version);
  n = settings_put(out, n, " k="); n = settings_list(out, n, s.keys[..]);
  n = settings_put(out, n, " p="); n = settings_list(out, n, s.pad[..]);
  n = settings_put(out, n, " t="); n = settings_int(out, n, s.text_pct);
  n = settings_put(out, n, ifx s.reduced_motion then " m=1" else " m=0");
  n = settings_put(out, n, ifx s.captions then " c=1" else " c=0");
  return n;
}
// A whole number of 1 to 3 digits, the whole of x: -1 if not one.
settings_whole :: (x: string) -> int #effects(all) {
  if x.count < 1 || x.count > 3 { return -1; }
  v := 0;
  for c: x { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); }
  return v;
}
// Whether field f starts "L=".
settings_prefix :: (f: string, letter: u8) -> bool #effects(all) { return f.count >= 2 && f[0] == letter && f[1] == '='; }
// Field f is "L=" and SA_N codes a ',' apart, into out: whether it was.
settings_codes :: (f: string, letter: u8, out: [] int) -> bool #effects(all) {
  if !settings_prefix(f, letter) { return false; }
  a := 0; at := 2;
  for i: at..<f.count + 1 {
    if i < f.count && f[i] != ',' { continue; }
    if a >= SA_N { return false; }
    v := settings_whole(f[at..<i]);
    if v < 0 { return false; }
    out[a] = v; a += 1; at = i + 1;
  }
  return a == SA_N;
}
// Field f is "L=0" or "L=1": 0 or 1, else -1.
settings_flag :: (f: string, letter: u8) -> int #effects(all) {
  if f.count != 3 || !settings_prefix(f, letter) || (f[2] != '0' && f[2] != '1') { return -1; }
  return cast(int) (f[2] - '0');
}
SETTINGS_FIELDS :: 6;
settings_read :: (t: string) -> SettingsRead #effects(all) {
  d := settings_default();
  bad := SettingsRead.{s = d, status = ST_UNREADABLE};
  // the fields, one space apart
  f: [SETTINGS_FIELDS] string; n := 0; at := 0;
  for i: at..<t.count + 1 {
    if i < t.count && t[i] != ' ' { continue; }
    if n >= SETTINGS_FIELDS { return bad; }
    f[n] = t[at..<i]; n += 1; at = i + 1;
  }
  if f[0].count < 2 || f[0][0] != 's' { return bad; }
  ver := settings_whole(f[0][1..<f[0].count]);
  if ver < 0 { return bad; }
  if ver != SETTINGS_VERSION { return SettingsRead.{s = d, status = ST_VERSION}; }
  if n != SETTINGS_FIELDS { return bad; }
  s := d;
  if !settings_codes(f[1], 'k', s.keys[..]) || !settings_codes(f[2], 'p', s.pad[..]) { return bad; }
  if !settings_prefix(f[3], 't') { return bad; }
  s.text_pct = settings_whole(f[3][2..<f[3].count]);
  m := settings_flag(f[4], 'm'); c := settings_flag(f[5], 'c');
  if s.text_pct < 0 || m < 0 || c < 0 { return bad; }
  s.reduced_motion = m == 1; s.captions = c == 1;
  why := settings_check(s);
  if why != ST_OK { return SettingsRead.{s = d, status = why}; }
  return SettingsRead.{s = s, status = ST_OK};
}

// ---- checks

#test "settings: the defaults keep the rules, and each key and button does one action" {
  s := settings_default();
  #assert settings_check(s) == ST_OK && s.version == SETTINGS_VERSION && s.text_pct == 100 && s.captions && !s.reduced_motion;
  #assert settings_action(s, SD_KEYS, 87) == SA_FORWARD && settings_action(s, SD_KEYS, 48) == SA_SLOT1 + 9;
  #assert settings_action(s, SD_PAD, 0) == SA_JUMP && settings_action(s, SD_PAD, 18) == SA_SLOT1 + 9;
  #assert settings_action(s, SD_KEYS, 81) == -1 && settings_action(s, 2, 87) == -1;
  for a: 0..<SA_N { #assert settings_action(s, SD_KEYS, s.keys[a]) == a && settings_action(s, SD_PAD, s.pad[a]) == a; }
}

#test "settings: binding a held code swaps, so nothing is left unbound; bad binds change nothing" {
  s: [1] Settings; s[0] = settings_default();
  #assert settings_bind(s[..], SD_KEYS, SA_JUMP, 81) == ST_OK && s[0].keys[SA_JUMP] == 81 && settings_action(s[0], SD_KEYS, 32) == -1;
  // W to jump: forward takes Q, jump's old key
  #assert settings_bind(s[..], SD_KEYS, SA_JUMP, 87) == ST_SWAPPED && s[0].keys[SA_JUMP] == 87 && s[0].keys[SA_FORWARD] == 81;
  #assert settings_bind(s[..], SD_KEYS, SA_JUMP, 87) == ST_OK && settings_check(s[0]) == ST_OK;
  #assert settings_bind(s[..], SD_PAD, SA_ACT, 0) == ST_SWAPPED && s[0].pad[SA_ACT] == 0 && s[0].pad[SA_JUMP] == 2 && settings_check(s[0]) == ST_OK;
  #assert settings_bind(s[..], SD_PAD, SA_MAP, 200) == ST_OK && s[0].pad[SA_MAP] == 200;
  before := s[0];
  #assert settings_bind(s[..], 2, SA_JUMP, 3) == ST_BAD_DEVICE && settings_bind(s[..], -1, SA_JUMP, 3) == ST_BAD_DEVICE;
  #assert settings_bind(s[..], SD_KEYS, -1, 3) == ST_BAD_ACTION && settings_bind(s[..], SD_KEYS, SA_N, 3) == ST_BAD_ACTION;
  #assert settings_bind(s[..], SD_KEYS, SA_JUMP, -1) == ST_BAD_CODE && settings_bind(s[..], SD_PAD, SA_JUMP, SETTINGS_CODE_MAX + 1) == ST_BAD_CODE;
  #assert settings_bind(s[..], SD_KEYS, SA_JUMP, SETTINGS_CODE_MAX) == ST_OK && settings_bind(s[..], SD_KEYS, SA_JUMP, 0) == ST_OK;
  for a: 0..<SA_N { if a != SA_JUMP { #assert s[0].keys[a] == before.keys[a]; } #assert s[0].pad[a] == before.pad[a]; }
}

#test "settings: text from 100 to 200 percent in steps of 25" {
  s: [1] Settings; s[0] = settings_default();
  #assert settings_text(s[..], 125) == ST_OK && s[0].text_pct == 125 && settings_text(s[..], 200) == ST_OK && s[0].text_pct == 200;
  #assert settings_text(s[..], 75) == ST_BAD_TEXT && settings_text(s[..], 225) == ST_BAD_TEXT && settings_text(s[..], 110) == ST_BAD_TEXT && s[0].text_pct == 200;
  #assert settings_text(s[..], 100) == ST_OK && s[0].text_pct == 100;
  t := s[0]; t.text_pct = 150; #assert settings_check(t) == ST_OK;
  t.text_pct = 101; #assert settings_check(t) == ST_BAD_TEXT;
  t = s[0]; t.keys[3] = t.keys[2]; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.pad[SA_N - 1] = t.pad[0]; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.keys[0] = -1; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.pad[0] = SETTINGS_CODE_MAX + 1; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.keys[SA_N - 1] = SETTINGS_CODE_MAX + 1; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.pad[SA_N - 1] = -1; #assert settings_check(t) == ST_BAD_CODE;
  t = s[0]; t.version = 2; #assert settings_check(t) == ST_VERSION;
}

#test "settings: the saved text reads back whole; another version or a broken one gives the defaults" {
  s: [1] Settings; s[0] = settings_default();
  _a := settings_bind(s[..], SD_KEYS, SA_JUMP, 81); _b := settings_bind(s[..], SD_PAD, SA_ACT, 0); _c := settings_text(s[..], 150);
  s[0].reduced_motion = true; s[0].captions = false;
  b: [256] u8;
  n := settings_write(s[0], b[..]);
  t := cast(string) b[0..<n];
  #assert t == "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0";
  r := settings_read(t);
  #assert r.status == ST_OK && r.s.keys[SA_JUMP] == 81 && r.s.pad[SA_ACT] == 0 && r.s.pad[SA_JUMP] == 2 && r.s.text_pct == 150 && r.s.reduced_motion && !r.s.captions;
  for a: 0..<SA_N { #assert r.s.keys[a] == s[0].keys[a] && r.s.pad[a] == s[0].pad[a]; }
  d := settings_default();
  dn := settings_write(d, b[..]);
  rd := settings_read(cast(string) b[0..<dn]);
  #assert rd.status == ST_OK && rd.s.captions && !rd.s.reduced_motion && rd.s.text_pct == 100;
  // never half-applied: each broken record gives the defaults whole
  bad := [16] string.[
    "", "s", "x1 k=", "s2 k=1", "s12", "s1", "s1 q=1",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57 p=12",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=2 c=0",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=x",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0 more",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=x m=1 c=0",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 x=1 c=0",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 x=0",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18x t=150 m=1 c=0",
    "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0"];
  for x: bad {
    q := settings_read(x);
    #assert q.status == ST_UNREADABLE || q.status == ST_VERSION;
    #assert q.s.keys[SA_JUMP] == 32 && q.s.pad[SA_ACT] == 2 && q.s.text_pct == 100 && q.s.captions && !q.s.reduced_motion;
  }
  #assert settings_read("s2 k=1").status == ST_VERSION && settings_read("s12").status == ST_VERSION && settings_read("").status == ST_UNREADABLE;
  #assert settings_read("sx").status == ST_UNREADABLE && settings_read("s1x").status == ST_UNREADABLE && settings_read("s1 q=1").status == ST_UNREADABLE;
  // a record that reads but breaks the rules: the defaults, and the rule it broke
  dup := "s1 k=87,87,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0";
  #assert settings_read(dup).status == ST_BAD_CODE && settings_read(dup).s.keys[SA_BACK] == 83;
  odd := "s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=130 m=1 c=0";
  #assert settings_read(odd).status == ST_BAD_TEXT && settings_read(odd).s.text_pct == 100;
  // four digits is not a code
  big := "s1 k=1000,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0";
  #assert settings_read(big).status == ST_UNREADABLE;
}

#test "settings: edges: action 0 and pad swaps with it, codes 0 and 255, text steps, a short buffer, odd fields" {
  s: [1] Settings; s[0] = settings_default();
  #assert settings_bind(s[..], SD_KEYS, SA_FORWARD, 90) == ST_OK && s[0].keys[SA_FORWARD] == 90;
  #assert settings_bind(s[..], SD_PAD, SA_JUMP, 12) == ST_SWAPPED && s[0].pad[SA_JUMP] == 12 && s[0].pad[SA_FORWARD] == 0;
  #assert settings_bind(s[..], SD_KEYS, SA_BACK, 90) == ST_SWAPPED && s[0].keys[SA_FORWARD] == 83 && s[0].keys[SA_BACK] == 90;
  t := settings_default(); t.keys[0] = 0; t.pad[0] = SETTINGS_CODE_MAX; t.keys[1] = SETTINGS_CODE_MAX; t.pad[1] = 254;
  #assert settings_check(t) == ST_OK;
  for pct: 0..<260 { #assert settings_text_ok(pct) == (pct == 100 || pct == 125 || pct == 150 || pct == 175 || pct == 200); }
  // a buffer too short: what fits, and nothing past it
  b: [6] u8;
  #assert settings_write(settings_default(), b[..]) == 6 && cast(string) b[..] == "s1 k=8";
  #assert settings_whole("") == -1 && settings_whole("1234") == -1 && settings_whole("9:") == -1 && settings_whole("/") == -1 && settings_whole("909") == 909 && settings_whole("0") == 0;
  #assert settings_flag("m=1", 'm') == 1 && settings_flag("m=0", 'm') == 0 && settings_flag("c=1", 'm') == -1 && settings_flag("m:1", 'm') == -1;
  #assert settings_flag("m=2", 'm') == -1 && settings_flag("m=/", 'm') == -1 && settings_flag("m=1x", 'm') == -1 && settings_flag("m=", 'm') == -1;
  codes: [SA_N] int;
  k := "k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48";
  #assert settings_codes(k, 'k', codes[..]) && codes[0] == 87 && codes[SA_N - 1] == 48;
  #assert !settings_codes(k, 'p', codes[..]) && !settings_codes("k:87", 'k', codes[..]) && !settings_codes("k", 'k', codes[..]) && !settings_codes("k=", 'k', codes[..]);
  #assert !settings_codes("k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48,1", 'k', codes[..]);
  #assert !settings_codes("k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57", 'k', codes[..]);
  #assert !settings_codes("k=87,,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48", 'k', codes[..]);
  #assert !settings_codes("k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,", 'k', codes[..]);
  #assert settings_read("s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t=150 m=1 c=0").status == ST_OK;
  #assert settings_read("s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 t= m=1 c=0").status == ST_UNREADABLE;
  #assert settings_read("s1 k=87,83,65,68,81,69,16,13,77,49,50,51,52,53,54,55,56,57,48 p=12,13,14,15,2,0,10,9,8,4,5,6,7,1,3,11,16,17,18 x=150 m=1 c=0").status == ST_UNREADABLE;
