// The piles' meshes (engine): the items of a build site's piles (aethyr/world/build-work.coax),
// made in Coax with the build-site mesher's pieces (build-site-mesh.coax: poles, boxes, stones,
// leaf cards) and drawn in the same materials, so a pile of withies looks like the withies in the
// wall. Item i of a pile has its own place, bottom first, so drawing the first n items draws the
// pile with n left: the top of the pile goes first. A page bakes each item once and shows the
// first bw_shown of them; the carried item is item 0 laid in the hands (bwm_carried).
//   coax/bin/coax test aethyr/world/build-work-mesh.coax --library
#module "aethyr.buildworkmesh";
#load "build-site.coax" as bs;
#load "build-site-mesh.coax" as bsm;
#load "build-work.coax" as bw;

bwm_v3 :: (x:f32,y:f32,z:f32)->[3]f32 {return [3]f32.[x,y,z];}

// The rows a stack of `most` items needs when each row holds one less than the row under it.
bwm_base :: (most:int)->int {b:=1;while b*(b+1)/2<most {b+=1;}return b;}
// Row and place in a stack of rows b, b-1, ... for item i.
bwm_stack :: (i:int,b:int)->[2]int {r:=0;k:=i;c:=b;while c>0 && k>=c {k-=c;r+=1;c-=1;}return [2]int.[r,k];}

// Where item i of a pile sits, its centre in the pile's own frame (the pile's middle on the ground
// at (0, 0), its long things lying along z), and a turn about the vertical.
bwm_place :: (s:bw.BuildStock,i:int)->[4]f32 {
 most:=bw.BW_SHOWN[s.shape];if s.count<most {most=s.count;}
 h:=bsm.bm_hash(f32(i)*1.7+f32(s.shape),3.1);g:=bsm.bm_hash(f32(i)*2.3,f32(s.mat)+1.9);
 if s.shape==bw.BW_LOGS || s.shape==bw.BW_SHEAVES {
  b:=bwm_base(most);rk:=bwm_stack(i,b);c:=b-rk[0];r:=s.size*(ifx s.shape==bw.BW_SHEAVES then 0.55f32 else 1.0f32);
  return [4]f32.[(f32(rk[1])-f32(c-1)*0.5)*r*2.05,r+f32(rk[0])*r*1.75,(h-0.5)*s.len*0.12,(g-0.5)*0.12];
 }
 if s.shape==bw.BW_RODS {
  // two loose bundles side by side; in each a rod's place round the bundle's core
  k:=i/2;side:=ifx i%2==0 then -1.0f32 else 1.0f32;a:=f32(k)*2.39996;rr:=s.size*2.3*sqrt(f32(k)+0.5);
  return [4]f32.[side*0.13+rr*cos(a),s.size*2.3*sqrt(f32(most/2)+0.5)+rr*sin(a),(h-0.5)*0.25,(g-0.5)*0.08];
 }
 if s.shape==bw.BW_ROCKS || s.shape==bw.BW_MOUND {
  // a heap: the first round the base, the last on top in the middle
  k:=f32(i)/f32(most);sz:=ifx s.shape==bw.BW_MOUND then s.size*0.55 else s.size;R:=sz*sqrt(f32(most))*0.55;
  rad:=R*sqrt(1-k)*(0.85+0.3*h);a:=f32(i)*2.39996;
  return [4]f32.[rad*cos(a),sz*0.3+k*R*0.75,rad*sin(a),a];
 }
 if s.shape==bw.BW_BLOCKS {
  // courses of three by four, each course across the last
  c:=i/12;k:=i%12;a:=k%3;b:=k/3;l:=s.size;w:=s.size*0.5;
  if c%2==0 {return [4]f32.[(f32(a)-1)*w*1.05,w*0.5+f32(c)*w,(f32(b)-1.5)*l*1.02,0];}
  return [4]f32.[(f32(b)-1.5)*w*1.05*0.75,w*0.5+f32(c)*w,(f32(a)-1)*l*0.7,1.5707963];
 }
 if s.shape==bw.BW_BOARDS {
  th:=ifx s.mat==bs.BS_FLAG then 0.06f32 else 0.03f32;col:=i%2;lv:=i/2;
  return [4]f32.[(f32(col)-0.5)*s.size*1.15,th*0.5+f32(lv)*th,(h-0.5)*0.06,(g-0.5)*0.05];
 }
 // boughs: heaped crosswise, each a little higher
 a:=f32(i)*1.13;rad:=0.25*(1-f32(i)/f32(most));
 return [4]f32.[rad*cos(a*1.7),0.05+f32(i)*0.025,rad*sin(a*1.7),a];
}

// Item i of a pile added to m, the pile's middle at (px, pz) in the building's frame (m's frame
// places it in the world).
bwm_item :: (m:[]bsm.BsMesh,s:bw.BuildStock,i:int,px:f32,pz:f32) {
 q:=bwm_place(s,i);o:=bwm_v3(px+q[0],q[1],pz+q[2]);bwm_thing(m,s,o,q[3],f32(i));
}
// One item at o (its centre), turned `turn` about the vertical (0: lying along z).
bwm_thing :: (m:[]bsm.BsMesh,s:bw.BuildStock,o:[3]f32,turn:f32,seed:f32) {
 c:=cos(turn);sn:=sin(turn);
 along:=bwm_v3(sn,0,c);across:=bwm_v3(c,0,-sn);
 sh:=s.shape;
 if sh==bw.BW_LOGS || sh==bw.BW_RODS {
  half:=bsm.bm_mul(along,s.len*0.5);
  if s.mat==bs.BS_TIMBER {bsm.bm_box(m,o,half,bwm_v3(0,s.size,0),bsm.bm_mul(across,s.size),bsm.bm_shade(seed*1.3+o[0],0.15),s.mat,true);return;}
  sides:=ifx sh==bw.BW_RODS then 4 else 7;
  bsm.bm_pole(m,bsm.bm_sub(o,half),bsm.bm_add(o,half),s.size,s.size*0.8,sides,bsm.bm_shade(seed*1.7+o[2],0.25),ifx sh==bw.BW_RODS then bs.BS_WITHY else s.mat);
  return;
 }
 if sh==bw.BW_SHEAVES {
  // a bundle: thick at the butt, tied, thinning to its heads; every other one turned end for end
  half:=bsm.bm_mul(along,s.len*0.5*(ifx int(seed)%2==0 then 1.0f32 else -1.0f32));r:=s.size*0.55;
  bsm.bm_pole(m,bsm.bm_sub(o,half),bsm.bm_add(o,half),r,r*0.55,8,bsm.bm_shade(seed*2.9,0.2),s.mat);
  bsm.bm_pole(m,bsm.bm_sub(o,bsm.bm_mul(half,0.42)),bsm.bm_sub(o,bsm.bm_mul(half,0.36)),r*1.04,r*1.02,8,bwm_v3(0.55,0.45,0.32),bs.BS_BARK);
  return;
 }
 if sh==bw.BW_ROCKS {r:=s.size*0.5;bsm.bm_rock(m,o,r*(0.85+0.3*bsm.bm_hash(seed,1)),r*(0.6+0.3*bsm.bm_hash(seed,2)),r*(0.75+0.3*bsm.bm_hash(seed,3)),turn,seed+o[0],bsm.bm_shade(seed,0.35),s.mat);return;}
 if sh==bw.BW_MOUND {r:=s.size*0.55*0.5;bsm.bm_rock(m,o,r*1.4,r*0.8,r*1.3,turn,seed*3.1+o[2],bsm.bm_shade(seed*1.9,0.2),s.mat);return;}
 if sh==bw.BW_BLOCKS {w:=s.size*0.25;bsm.bm_box(m,o,bsm.bm_mul(along,s.size*0.5),bwm_v3(0,w,0),bsm.bm_mul(across,w),bsm.bm_shade(seed*1.1,0.25),s.mat,false);return;}
 if sh==bw.BW_BOARDS {th:=ifx s.mat==bs.BS_FLAG then 0.03f32 else 0.015f32;bsm.bm_box(m,o,bsm.bm_mul(along,s.len*0.5),bwm_v3(0,th,0),bsm.bm_mul(across,s.size*0.5),bsm.bm_shade(seed*1.3,0.2),s.mat,s.mat!=bs.BS_FLAG);return;}
 // a leafy bough: two cards crossed
 a:=bsm.bm_mul(along,s.len*0.5);b:=bsm.bm_mul(across,s.size*0.5);
 bsm.bm_card(m,o,a,b,bsm.bm_shade(seed*0.7,0.2),s.mat);bsm.bm_card(m,bsm.bm_add(o,bwm_v3(0,0.02,0)),bsm.bm_mul(b,1.4),bsm.bm_mul(a,0.7),bsm.bm_shade(seed*1.9,0.2),s.mat);
}
// The pile with `items` drawn (bw.bw_shown), at pile k of n beside a site of reach `reach`.
bwm_pile :: (m:[]bsm.BsMesh,s:bw.BuildStock,items:int,k:int,n:int,reach:[3]f32) {
 at:=bw.bw_pile_at(k,n,reach);for i:0..<items {bwm_item(m,s,i,at[0],at[1]);}
}
// What the builder carries from a pile: item 0's thing at `o` (the hands' middle, in the building's
// frame), lying across the body when it faces `yaw`: a pole on the shoulder, a sheaf, a stone.
bwm_carried :: (m:[]bsm.BsMesh,s:bw.BuildStock,o:[3]f32,yaw:f32) {
 if s.shape==bw.BW_RODS {for j:0..<6 {bwm_thing(m,s,bsm.bm_add(o,bwm_v3(f32(j%3-1)*s.size*2.2,f32(j/3)*s.size*2.2,0)),yaw,f32(j));}return;}
 bwm_thing(m,s,o,ifx s.shape==bw.BW_LOGS || s.shape==bw.BW_SHEAVES || s.shape==bw.BW_BOARDS then yaw else yaw+1.5707963,0);
}

#test "every pile shape makes its items, each in the vertex budget and beside its site" #steps 400000000 {
 reach:=[3]f32.[2,2,2];m:[1]bsm.BsMesh;
 for sh:0..<bw.BW_SHAPES {
  s:=bw.BuildStock.{shape=sh,mat=ifx sh==bw.BW_RODS then bs.BS_WITHY else ifx sh==bw.BW_ROCKS then bs.BS_FIELDSTONE else bs.BS_BARK,count=40,size=ifx sh==bw.BW_RODS then 0.012f32 else 0.12f32,len=1.6,feed=bs.BS_BARK};
  most:=bw.bw_shown(s,s.count);
  // fewer items draw fewer vertices: the top of the pile goes first
  m[0].nv=0;m[0].ni=0;bwm_pile(m[..],s,most/2,0,1,reach);half:=m[0].nv;
  m[0].nv=0;m[0].ni=0;bwm_pile(m[..],s,most,0,1,reach);#assert !m[0].over && m[0].nv>half && m[0].ni%3==0;
  at:=bw.bw_pile_at(0,1,reach);
  for i:0..<m[0].nv {v:=m[0].v[i].p;#assert v[0]>reach[0]+0.2 && abs(v[0]-at[0])<1.4 && abs(v[2]-at[1])<1.4 && v[1]> -0.2 && v[1]<1.4;}
 }
}
#test "a stack is filled from the bottom row, and its items never sit inside each other" {
 s:=bw.BuildStock.{shape=bw.BW_LOGS,mat=bs.BS_BARK,count=14,size=0.065,len=2.4};
 b:=bwm_base(14);#assert b==5 && bwm_stack(0,b)[0]==0 && bwm_stack(4,b)[0]==0 && bwm_stack(5,b)[0]==1;
 for i:0..<14 {for j:i+1..<14 {p:=bwm_place(s,i);q:=bwm_place(s,j);dx:=p[0]-q[0];dy:=p[1]-q[1];#assert dx*dx+dy*dy>(s.size*1.9)*(s.size*1.9);}}
 for i:1..<14 {#assert bwm_place(s,i)[1]>=bwm_place(s,i-1)[1]-0.0001;}
}
