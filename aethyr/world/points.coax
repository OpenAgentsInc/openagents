// A zone's named points (GitHub #13078): spawn, gates and points of interest, each a name and four
// numbers in the zone's map data (x, y, z in metres, and the way it faces, radians, 0 north as
// yaw_of). Scripted checks (the drift, the walk tests, goldens' views, the lighting baseline, the
// flyover, the room's checks) read where to stand from here, never from coordinates of their own, so
// a spawn or gate that moves takes every check with it (the drift's raid stood at the old spawn for
// days, #13070).
//
// A zone's map data holds two arrays, its names and MAP_POINT_FLOATS numbers a name, and a lookup
// of its own that passes them here with the zone's label (its name and the file the points live in):
//   verse/everglade/points.coax eg_point, everglade/world/points.coax e2_point,
//   verse/experimental-points.coax exp_point.
// A name the zone doesn't have comes back not found, never as a place: a tool refuses it loudly
// (coax/web/map-points.coax map_need), a check asserts .found. The inventory of what each check
// read before is docs/verification/check-positions-2026-11-09.md.
//   coax/bin/coax test --library aethyr/world/points.coax

MAP_POINT_FLOATS :: 4;   // x, y, z, face
MapPoint :: struct { found: bool; zone: string; name: string; x: f32; y: f32; z: f32; face: f32; }

// The point called name in a zone's table, or one not found (zone and name kept, for the refusal).
// A name listed twice, or a table whose numbers are short, is not found either: no check guesses.
map_point :: (zone: string, names: [] string, at: [] f32, name: string) -> MapPoint {
  p := MapPoint.{zone = zone, name = name};
  hit := -1;
  for i: 0..<names.count {
    if names[i] != name { continue; }
    if hit >= 0 { return p; }
    hit = i;
  }
  if hit < 0 || (hit + 1) * MAP_POINT_FLOATS > at.count { return p; }
  k := hit * MAP_POINT_FLOATS;
  p.found = true; p.x = at[k]; p.y = at[k + 1]; p.z = at[k + 2]; p.face = at[k + 3];
  return p;
}
// Whether every name in a zone's table is listed once and has its numbers.
map_points_whole :: (names: [] string, at: [] f32) -> bool {
  if at.count != names.count * MAP_POINT_FLOATS { return false; }
  for i: 0..<names.count {
    if names[i].count == 0 { return false; }
    for j: 0..<i { if names[j] == names[i] { return false; } }
  }
  return true;
}
// A coordinate in whole millimetres, rounded (the drift's probes read places in mm).
map_mm :: (m: f32) -> int { return cast(int) (ifx m >= 0 then m * 1000 + 0.5 else m * 1000 - 0.5); }

#test "a named point is read from its zone's table, a missing or doubled one is not found" {
  names := [3] string.["spawn", "gate-south", "camp"];
  at := [12] f32.[0, 0, -16, 3.14159265,   0, 0, -56, 0,   1.5, 0.25, -106, -1.5];
  #assert map_points_whole(names[..], at[..]);
  s := map_point("Test (here)", names[..], at[..], "spawn");
  #assert s.found && s.x == 0 && s.y == 0 && s.z == -16 && s.face == 3.14159265 && s.name == "spawn";
  c := map_point("Test (here)", names[..], at[..], "camp");
  #assert c.found && c.x == 1.5 && c.y == 0.25 && c.z == -106 && c.face == -1.5;
  m := map_point("Test (here)", names[..], at[..], "raid-front");
  #assert !m.found && m.zone == "Test (here)" && m.name == "raid-front" && m.x == 0 && m.z == 0;
  #assert !map_point("Test (here)", names[..], at[..], "").found;
  #assert !map_point("Test (here)", names[..], at[0..<11], "camp").found;   // its numbers cut short
  two := [2] string.["spawn", "spawn"]; two_at := [8] f32.[0, 0, 1, 0, 0, 0, 2, 0];
  #assert !map_point("Test (here)", two[..], two_at[..], "spawn").found && !map_points_whole(two[..], two_at[..]);
  #assert !map_points_whole(names[..], at[0..<8]);
}
#test "a point's metres are whole millimetres, rounded either side of zero" {
  #assert map_mm(-58.75) == -58750 && map_mm(1.5) == 1500 && map_mm(0) == 0 && map_mm(-56) == -56000;
  #assert map_mm(0.0004) == 0 && map_mm(0.0006) == 1 && map_mm(-0.0006) == -1;
}
