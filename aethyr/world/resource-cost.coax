// Decoder-derived resource costs, #12990. This is a source part so the
// existing unmoduled image decoder keeps one owner in a composed host.
// A plan is not successful decoding or permission to publish an asset.
#authority;
#load "../core/assets.coax" as assets;
#load "../render/host-layers.coax";
#load "../render/registry.coax" as gpu;
#load "../audio/host-wav.coax" as wav;
#load "../physics/query.coax" as queries;
#load "../core/space.coax" as points;
#load "cells.coax" as cells;
#load "../forge/vertices.coax" as packed;

RESOURCE_COST_VERSION :: 1;
RESOURCE_PACKED_VERSION :: 2;
RESOURCE_SOURCE_MAX :: 67108864;
ResourceCategory :: enum u8 { geometry; textures; collision; lighting; audio; actors; staging; }
ResourceFormat :: enum u8 { invalid; positions4; indices; boxes; capsules; image_mips; wav_pcm16; cell_bodies; packed_vertices48; }
ResourceBackend :: enum u8 { browser; vulkan; }
ResourceCostStatus :: enum u8 { ok; unsupported; invalid; capacity; mismatch; decode; }
ResourceSpec :: struct {
  version: int = RESOURCE_COST_VERSION;
  format: ResourceFormat;
  category: ResourceCategory;
  backend: ResourceBackend;
  side: int; // canonical image output side; other formats require zero
}
ResourceCost :: struct {
  encoded: int;
  decoded: int;
  gpu: int;
  objects: int;
  decode_scratch: int;
  upload_scratch: int;
  alignment: int;
  actors: int;
  voices: int;
  width: int;
  height: int;
  levels: int;
  elements: int;
}
ResourcePlan :: struct {
  status: ResourceCostStatus = ResourceCostStatus.invalid;
  spec: ResourceSpec;
  content: assets.AssetId;
  cost: ResourceCost;
}
#load "tests/resource-cost-fixture.coax";

#test "packed VPK vertices use a separate model revision and exact shared loader costs" {
  source: [96] u8;
  for i: 32..<48 { source[i] = 255; source[i + 48] = 255; }
  spec := ResourceSpec.{version = 2, format = ResourceFormat.packed_vertices48};
  p := resource_plan(source[..], spec);
  #assert p.status == ResourceCostStatus.ok && p.cost.encoded == 96 && p.cost.gpu == 96 && p.cost.decoded == 0 && p.cost.alignment == 4 && p.cost.elements == 2;
  #assert resource_matches(p, source[..]);
  spec.backend = ResourceBackend.vulkan; #assert resource_plan(source[..], spec).cost.upload_scratch == 96;
  spec.version = 1; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  spec.version = 3; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  spec = p.spec; spec.category = ResourceCategory.textures; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  #assert resource_plan(source[0..<95], p.spec).status == ResourceCostStatus.invalid;
  resource_fixture_f32(source[..], 48, 1000000); #assert resource_plan(source[..], p.spec).status == ResourceCostStatus.invalid;
  #assert !resource_spec_supported(ResourceSpec.{format = ResourceFormat.invalid});
}

#test "image costs come from the canonical full mip decoder and the shared GPU ledger" {
  image := PNG_ONE;
  spec := ResourceSpec.{format = ResourceFormat.image_mips, category = ResourceCategory.textures, side = 2};
  p := resource_plan(image[..], spec);
  #assert p.status == ResourceCostStatus.ok && assets.asset_same(p.content, assets.asset_id(cast(string) image[..]));
  #assert p.cost.encoded == image.count && p.cost.decoded == 20 && p.cost.gpu == 20;
  #assert p.cost.decode_scratch == htx_plan(image[..], 2).work && p.cost.upload_scratch == 0;
  #assert p.cost.width == 2 && p.cost.height == 2 && p.cost.levels == 2 && p.cost.elements == 5;
  #assert p.cost.objects == size_of(ResourcePlan) && p.cost.alignment == 4;
  spec.backend = ResourceBackend.vulkan; native := resource_plan(image[..], spec);
  #assert native.status == ResourceCostStatus.ok && native.cost.upload_scratch == 20;
  #assert assets.asset_same(p.content, native.content);
  spec.category = ResourceCategory.lighting;
  #assert resource_plan(image[..], spec).status == ResourceCostStatus.ok;
  spec.side = 1; low := resource_plan(image[..], spec);
  #assert low.cost.gpu == 4 && low.cost.decoded == 4 && low.cost.width == 1 && low.cost.levels == 1;
  #assert assets.asset_same(low.content, p.content);
  work: [256] u8; pixels: [20] u8;
  #assert resource_decode_image(p, image[..], work[..], pixels[..]) == ResourceCostStatus.ok;
  #assert resource_decode_image(p, image[..], work[0..<0], pixels[..]) == ResourceCostStatus.capacity;
  #assert resource_decode_image(p, image[..], work[..], pixels[0..<19]) == ResourceCostStatus.capacity;
  bad := p; bad.cost.gpu += 4;
  #assert resource_decode_image(bad, image[..], work[..], pixels[..]) == ResourceCostStatus.mismatch;
  late := PNG_BAD_FILTER5; lp := resource_plan(late[..], ResourceSpec.{format = ResourceFormat.image_mips, category = ResourceCategory.textures, side = 2});
  #assert lp.status == ResourceCostStatus.ok && resource_decode_image(lp, late[..], work[..], pixels[..]) == ResourceCostStatus.decode;
}
#test "raw geometry and collision use exact payloads and the existing shape admission" {
  vertices: [32] u8;
  for i: 0..<2 { resource_fixture_f32(vertices[..], i * 16 + 12, 1); }
  p := resource_plan(vertices[..], ResourceSpec.{format = ResourceFormat.positions4});
  #assert p.status == ResourceCostStatus.ok && p.cost.encoded == 32 && p.cost.decoded == 0 && p.cost.gpu == 32 && p.cost.elements == 2 && p.cost.alignment == 16;
  #assert resource_plan(vertices[0..<31], p.spec).status == ResourceCostStatus.invalid;
  resource_fixture_f32(vertices[..], 0, 1000000); #assert resource_plan(vertices[..], p.spec).status == ResourceCostStatus.invalid;
  resource_fixture_f32(vertices[..], 0, 0); resource_fixture_f32(vertices[..], 12, 0); #assert resource_plan(vertices[..], p.spec).status == ResourceCostStatus.invalid;
  index: [4] u8; index[0] = 2;
  q := resource_plan(index[..], ResourceSpec.{format = ResourceFormat.indices});
  #assert q.status == ResourceCostStatus.ok && q.cost.gpu == 4 && q.cost.elements == 1 && q.cost.alignment == 4;
  #assert resource_plan(index[0..<3], q.spec).status == ResourceCostStatus.invalid;
  box: [24] u8; resource_fixture_f32(box[..], 12, 1); resource_fixture_f32(box[..], 16, 2); resource_fixture_f32(box[..], 20, 3);
  p = resource_plan(box[..], ResourceSpec.{format = ResourceFormat.boxes, category = ResourceCategory.collision});
  #assert p.status == ResourceCostStatus.ok && p.cost.decoded == 24 && p.cost.gpu == 0 && p.cost.elements == 1;
  values: [6] f32;
  #assert resource_decode_collision(p, box[..], values[..]) == ResourceCostStatus.ok && values[3] == 1 && values[4] == 2 && values[5] == 3;
  #assert resource_decode_collision(p, box[..], values[0..<5]) == ResourceCostStatus.capacity;
  resource_fixture_f32(box[..], 0, 2); #assert resource_plan(box[..], p.spec).status == ResourceCostStatus.invalid;
  capsule: [28] u8; resource_fixture_f32(capsule[..], 16, 1); resource_fixture_f32(capsule[..], 24, 0.5);
  p = resource_plan(capsule[..], ResourceSpec.{format = ResourceFormat.capsules, category = ResourceCategory.collision});
  #assert p.status == ResourceCostStatus.ok && p.cost.decoded == 28 && p.cost.elements == 1;
  caps: [7] f32; #assert resource_decode_collision(p, capsule[..], caps[..]) == ResourceCostStatus.ok && caps[6] == 0.5;
  resource_fixture_f32(capsule[..], 24, 0); #assert resource_plan(capsule[..], p.spec).status == ResourceCostStatus.invalid;
}
#test "WAV cost follows the real output and resampling work while stable cell bodies use their actual layout" {
  pcm := [4] int.[1, -1, 2, -2]; bytes: [52] u8;
  src := wav.apw_test_wav(2, 48000, pcm[..], bytes[..]);
  p := resource_plan(src, ResourceSpec.{format = ResourceFormat.wav_pcm16, category = ResourceCategory.audio});
  #assert p.status == ResourceCostStatus.ok && p.cost.decoded == 16 && p.cost.gpu == 0 && p.cost.decode_scratch == 0 && p.cost.voices == 1;
  filter: [1] wav.AudioWavFilter; work: [wav.APW_WORDS] f64; samples: [10] f32;
  #assert resource_decode_audio(p, src, filter[..], work[..], samples[..]) == ResourceCostStatus.ok && samples[1] == -1.0f32 / 32768;
  #assert resource_decode_audio(p, src, filter[..], work[..], samples[0..<3]) == ResourceCostStatus.capacity;
  src = wav.apw_test_wav(2, 22050, pcm[..], bytes[..]);
  p = resource_plan(src, p.spec);
  #assert p.status == ResourceCostStatus.ok && p.cost.decoded == 40 && p.cost.decode_scratch == wav.APW_WORDS * 8;
  #assert resource_decode_audio(p, src, filter[..], work[0..<0], samples[..]) == ResourceCostStatus.capacity;
  #assert resource_decode_audio(p, src, filter[0..<0], work[..], samples[..]) == ResourceCostStatus.capacity;
  body: [64] u8; body[0] = 9;
  p = resource_plan(body[..], ResourceSpec.{format = ResourceFormat.cell_bodies, category = ResourceCategory.actors});
  #assert p.status == ResourceCostStatus.ok && p.cost.decoded == size_of(cells.CellBody) && p.cost.actors == 1 && p.cost.alignment == 8;
  bodies: [1] cells.CellBody;
  #assert resource_decode_bodies(p, body[..], bodies[..]) == ResourceCostStatus.ok && bodies[0].id == 9 && bodies[0].x == 0;
  #assert resource_decode_bodies(p, body[..], bodies[0..<0]) == ResourceCostStatus.capacity;
  body[0] = 0; #assert resource_plan(body[..], p.spec).status == ResourceCostStatus.invalid;
}
#test "model version format category and source identity refuse before successful decode" {
  source := PNG_ONE; spec := ResourceSpec.{format = ResourceFormat.image_mips, category = ResourceCategory.textures, side = 1};
  p := resource_plan(source[..], spec); #assert p.status == ResourceCostStatus.ok;
  spec.version = 2; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  spec.version = 1; spec.format = ResourceFormat.invalid; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  spec = p.spec; spec.category = ResourceCategory.geometry; #assert resource_plan(source[..], spec).status == ResourceCostStatus.unsupported;
  #assert resource_plan(source[0..<0], p.spec).status == ResourceCostStatus.invalid;
  changed := source; changed[changed.count - 1] ^= 1;
  #assert !resource_matches(p, changed[..]);
  bad := p; bad.status = ResourceCostStatus.invalid; #assert !resource_matches(bad, source[..]);
  little := [4] u8.[1, 2, 3, 4]; #assert resource_u32(little[..], 0) == 67305985;
}
#test "source extents preflight before allocation and cost fields cannot be forged independently" {
  #assert resource_source_status(0) == ResourceCostStatus.invalid && resource_source_status(-1) == ResourceCostStatus.invalid;
  #assert resource_source_status(1) == ResourceCostStatus.ok && resource_source_status(67108864) == ResourceCostStatus.ok;
  #assert resource_source_status(67108865) == ResourceCostStatus.capacity;
  source := PNG_ONE; p := resource_plan(source[..], ResourceSpec.{format = ResourceFormat.image_mips, category = ResourceCategory.textures, side = 1});
  for field: 0..<13 {
    bad := p; bad.cost = resource_fixture_changed_cost(p.cost, field);
    #assert !resource_matches(bad, source[..]);
  }
  bad := p; bad.spec.version = 2; #assert !resource_matches(bad, source[..]);
  bad = p; bad.spec.side = 3; #assert !resource_matches(bad, source[..]);
  work: [256] u8; pixels: [4] u8;
  #assert resource_decode_image(p, source[..], work[0..<p.cost.decode_scratch], pixels[..]) == ResourceCostStatus.ok;
}
#test "cell bodies preserve every 64 bit lane and exact capacity and reject duplicates and nonfinite positions" {
  source: [2112] u8;
  for i: 0..<33 { resource_fixture_u64(source[..], i * 64, cast(u64) (i + 1)); }
  spec := ResourceSpec.{format = ResourceFormat.cell_bodies, category = ResourceCategory.actors};
  p := resource_plan(source[0..<2048], spec);
  #assert p.status == ResourceCostStatus.ok && p.cost.actors == 32;
  #assert resource_plan(source[..], spec).status == ResourceCostStatus.invalid;
  #assert resource_plan(source[0..<63], spec).status == ResourceCostStatus.invalid;
  for lane: 0..<3 {
    resource_fixture_u64(source[..], 8 + lane * 8, f64_bits(1000000000000));
    #assert resource_plan(source[0..<64], spec).status == ResourceCostStatus.invalid;
    resource_fixture_u64(source[..], 8 + lane * 8, f64_bits(0));
  }
  resource_fixture_u64(source[..], 128, 2);
  #assert resource_plan(source[0..<192], spec).status == ResourceCostStatus.invalid;
  resource_fixture_u64(source[..], 128, 1);
  #assert resource_plan(source[0..<192], spec).status == ResourceCostStatus.invalid;
  resource_fixture_u64(source[..], 128, 3);
  resource_fixture_u64(source[..], 0, 4294967297);
  resource_fixture_u64(source[..], 8, f64_bits(1.25)); resource_fixture_u64(source[..], 16, f64_bits(-2.5)); resource_fixture_u64(source[..], 24, f64_bits(3.75));
  for lane: 0..<4 { resource_fixture_u64(source[..], 32 + lane * 8, cast(u64) (12345 + lane)); }
  p = resource_plan(source[0..<128], spec); bodies: [2] cells.CellBody;
  #assert p.status == ResourceCostStatus.ok && resource_decode_bodies(p, source[0..<128], bodies[..]) == ResourceCostStatus.ok;
  #assert bodies[0].id == 4294967297 && bodies[1].id == 2 && bodies[0].x == 1.25 && bodies[0].y == -2.5 && bodies[0].z == 3.75;
  for lane: 0..<4 { #assert bodies[0].words[lane] == 12345 + lane; }
  p.content.words[0] ^= 1;
  #assert resource_decode_bodies(p, source[0..<128], bodies[..]) == ResourceCostStatus.mismatch;
}
#test "collision extent is the query shape capacity and malformed tails never decode" #steps 200000000 {
  source: [98328] u8; spec := ResourceSpec.{format = ResourceFormat.boxes, category = ResourceCategory.collision};
  p := resource_plan(source[0..<98304], spec);
  #assert p.status == ResourceCostStatus.ok && p.cost.elements == 4096;
  #assert resource_plan(source[..], spec).status == ResourceCostStatus.invalid;
  #assert resource_plan(source[0..<23], spec).status == ResourceCostStatus.invalid;
  resource_fixture_f32(source[..], 0, -1); p = resource_plan(source[0..<24], spec);
  out: [6] f32;
  #assert resource_decode_collision(p, source[0..<24], out[..]) == ResourceCostStatus.ok && out[0] == -1;
  p.content.words[0] ^= 1; #assert resource_decode_collision(p, source[0..<24], out[..]) == ResourceCostStatus.mismatch;
}
#test "every position lane is admitted and audio decodes in exact work and sample spans" {
  vertices: [32] u8;
  for i: 0..<2 { resource_fixture_f32(vertices[..], i * 16 + 12, 1); }
  for vertex: 0..<2 { for lane: 0..<3 {
    resource_fixture_f32(vertices[..], vertex * 16 + lane * 4, 1000000);
    #assert resource_plan(vertices[..], ResourceSpec.{format = ResourceFormat.positions4}).status == ResourceCostStatus.invalid;
    resource_fixture_f32(vertices[..], vertex * 16 + lane * 4, 0);
  } }
  pcm := [4] int.[1, -1, 2, -2]; bytes: [52] u8;
  src := wav.apw_test_wav(2, 48000, pcm[..], bytes[..]);
  p := resource_plan(src, ResourceSpec.{format = ResourceFormat.wav_pcm16, category = ResourceCategory.audio});
  filter: [1] wav.AudioWavFilter; work: [wav.APW_WORDS] f64; samples: [10] f32;
  #assert p.cost.elements == 2;
  #assert resource_decode_audio(p, src, filter[0..<0], work[0..<0], samples[0..<4]) == ResourceCostStatus.ok;
  p.content.words[0] ^= 1; #assert resource_decode_audio(p, src, filter[..], work[..], samples[..]) == ResourceCostStatus.mismatch;
  src = wav.apw_test_wav(2, 22050, pcm[..], bytes[..]); p = resource_plan(src, p.spec);
  #assert resource_decode_audio(p, src, filter[..], work[..], samples[..]) == ResourceCostStatus.ok;
  #assert resource_decode_audio(p, src, filter[..], work[0..<wav.APW_WORDS - 1], samples[..]) == ResourceCostStatus.capacity;
}

resource_u32 :: (b: [] u8, at: int) -> u32 #effects(all) {
  value: u32;
  for lane: 0..<4 { value |= cast(u32) b[at + lane] << cast(u32) (lane * 8); }
  return value;
}
resource_u64 :: (b: [] u8, at: int) -> u64 #effects(all) {
  return cast(u64) resource_u32(b, at) | (cast(u64) resource_u32(b, at + 4) << 32);
}
resource_body :: (b: [] u8, at: int) -> cells.CellBody #effects(all) {
  out := cells.CellBody.{id = cast,trunc(int) resource_u64(b, at), x = f64_from_bits(resource_u64(b, at + 8)),
    y = f64_from_bits(resource_u64(b, at + 16)), z = f64_from_bits(resource_u64(b, at + 24))};
  for i: 0..<cells.CELL_WORDS { out.words[i] = cast,trunc(int) resource_u64(b, at + 32 + i * 8); }
  return out;
}
resource_cost_equal :: (a: ResourceCost, b: ResourceCost) -> bool #effects(all) {
  return a.encoded == b.encoded && a.decoded == b.decoded && a.gpu == b.gpu && a.objects == b.objects &&
    a.decode_scratch == b.decode_scratch && a.upload_scratch == b.upload_scratch && a.alignment == b.alignment &&
    a.actors == b.actors && a.voices == b.voices && a.width == b.width && a.height == b.height && a.levels == b.levels && a.elements == b.elements;
}
resource_matches :: (plan: ResourcePlan, source: [] u8) -> bool #effects(all) {
  if plan.status != ResourceCostStatus.ok { return false; }
  actual := resource_plan(source, plan.spec);
  return actual.status == ResourceCostStatus.ok && assets.asset_same(actual.content, plan.content) && resource_cost_equal(actual.cost, plan.cost);
}
// The host can refuse a declared extent before retaining/copying its bytes.
resource_source_status :: (bytes: int) -> ResourceCostStatus #effects(all) {
  if bytes < 1 { return ResourceCostStatus.invalid; }
  if bytes > RESOURCE_SOURCE_MAX { return ResourceCostStatus.capacity; }
  return ResourceCostStatus.ok;
}
resource_spec_supported :: (spec: ResourceSpec) -> bool #effects(all) {
  if spec.format == ResourceFormat.invalid { return false; }
  version := ifx spec.format == ResourceFormat.packed_vertices48 then RESOURCE_PACKED_VERSION else RESOURCE_COST_VERSION;
  return spec.version == version;
}
resource_plan :: (source: [] u8, spec: ResourceSpec) -> ResourcePlan #effects(all) {
  if !resource_spec_supported(spec) { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
  extent := resource_source_status(source.count);
  if extent != ResourceCostStatus.ok { return ResourcePlan.{status = extent}; }
  c := ResourceCost.{encoded = source.count, objects = size_of(ResourcePlan), alignment = 4};
  if spec.format == ResourceFormat.image_mips {
    if spec.category != ResourceCategory.textures && spec.category != ResourceCategory.lighting { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
    image := htx_plan(source, spec.side);
    if image.status != IMG_OK { return ResourcePlan.{}; }
    c.decoded = image.bytes; c.decode_scratch = image.work; c.width = image.side; c.height = image.side; c.levels = image.levels;
    c.gpu = gpu.rr_texture_words(c.width, c.height, 1, c.levels, 4) * 4; c.elements = c.decoded / 4;
  } else {
    if spec.side != 0 { return ResourcePlan.{}; }
    if spec.format == ResourceFormat.packed_vertices48 {
      if spec.category != ResourceCategory.geometry { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
      vertices := packed.pack_vertices_plan(source);
      if vertices.status != packed.PackVertexStatus.ok { return ResourcePlan.{}; }
      c.elements = vertices.vertices; c.gpu = gpu.rr_buffer_words(vertices.bytes) * 4;
    } else if spec.format == ResourceFormat.wav_pcm16 {
      if spec.category != ResourceCategory.audio { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
      audio := wav.apw_plan(source); if !audio.valid { return ResourcePlan.{}; }
      c.decoded = audio.samples * 4; c.elements = audio.output_frames; c.voices = 1;
      if audio.rate != 48000 { c.decode_scratch = wav.APW_WORDS * 8; }
    } else if spec.format == ResourceFormat.cell_bodies {
      if spec.category != ResourceCategory.actors { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
      if source.count % 64 != 0 || source.count / 64 > cells.CELL_ENTITIES { return ResourcePlan.{}; }
      c.elements = source.count / 64; c.decoded = c.elements * size_of(cells.CellBody); c.actors = c.elements; c.alignment = 8;
      for i: 0..<c.elements {
        body := resource_body(source, i * 64);
        if body.id <= 0 || !(abs(body.x) < 1000000000000 && abs(body.y) < 1000000000000 && abs(body.z) < 1000000000000) { return ResourcePlan.{}; }
        for j: 0..<i { if resource_body(source, j * 64).id == body.id { return ResourcePlan.{}; } }
      }
    } else if spec.format == ResourceFormat.boxes || spec.format == ResourceFormat.capsules {
      if spec.category != ResourceCategory.collision { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
      stride := ifx spec.format == ResourceFormat.boxes then queries.QUERY_BOX else queries.QUERY_CAPSULE;
      if source.count % (stride * 4) != 0 || source.count / (stride * 4) > 4096 { return ResourcePlan.{}; }
      c.elements = source.count / (stride * 4); c.decoded = source.count;
      piece: [queries.QUERY_CAPSULE] f32;
      for i: 0..<c.elements {
        for j: 0..<stride { piece[j] = f32_from_bits(resource_u32(source, (i * stride + j) * 4)); }
        if spec.format == ResourceFormat.boxes {
          if !queries.query_box(queries.Colliders.{boxes = piece[0..<stride]}, 0).ok { return ResourcePlan.{}; }
        } else { if !queries.query_capsule(queries.Colliders.{capsules = piece[..]}, 0).ok { return ResourcePlan.{}; } }
      }
    } else {
      if spec.category != ResourceCategory.geometry { return ResourcePlan.{status = ResourceCostStatus.unsupported}; }
      stride := ifx spec.format == ResourceFormat.positions4 then 16 else 4;
      if source.count % stride != 0 { return ResourcePlan.{}; }
      c.elements = source.count / stride; c.gpu = gpu.rr_buffer_words(source.count) * 4;
      if spec.format == ResourceFormat.positions4 {
        c.alignment = 16;
        for i: 0..<c.elements {
          point := points.WorldPoint.{x = f32_from_bits(resource_u32(source, i * 16)), y = f32_from_bits(resource_u32(source, i * 16 + 4)), z = f32_from_bits(resource_u32(source, i * 16 + 8))};
          if !queries.query_point_finite(point) { return ResourcePlan.{}; }
          if f32_from_bits(resource_u32(source, i * 16 + 12)) != 1 { return ResourcePlan.{}; }
        }
      }
    }
  }
  // Browser queue writes borrow the admitted CPU span. Vulkan owns an
  // explicit transfer buffer until its submission completes. Driver-private
  // allocation overhead is an observed SDK quantity, not guessed here.
  if spec.backend == ResourceBackend.vulkan { c.upload_scratch = c.gpu; }
  return ResourcePlan.{status = ResourceCostStatus.ok, spec = spec, content = assets.asset_id(cast(string) source), cost = c};
}
// Decode outputs are inactive owner buffers. A failed codec may have written
// there, but only the stream publication gate can make that buffer ready.
resource_decode_image :: (p: ResourcePlan, source: [] u8, work: [] u8, output: [] u8) -> ResourceCostStatus #effects(all) {
  if !resource_matches(p, source) || p.spec.format != ResourceFormat.image_mips { return ResourceCostStatus.mismatch; }
  if work.count < p.cost.decode_scratch || output.count < p.cost.decoded { return ResourceCostStatus.capacity; }
  if htx_decode(source, p.spec.side, work, output) != IMG_OK { return ResourceCostStatus.decode; }
  return ResourceCostStatus.ok;
}
resource_decode_collision :: (p: ResourcePlan, source: [] u8, output: [] f32) -> ResourceCostStatus #effects(all) {
  if !resource_matches(p, source) || (p.spec.format != ResourceFormat.boxes && p.spec.format != ResourceFormat.capsules) { return ResourceCostStatus.mismatch; }
  if output.count < p.cost.decoded / 4 { return ResourceCostStatus.capacity; }
  for i: 0..<p.cost.decoded / 4 { output[i] = f32_from_bits(resource_u32(source, i * 4)); }
  return ResourceCostStatus.ok;
}
resource_decode_audio :: (p: ResourcePlan, source: [] u8, filter: [] wav.AudioWavFilter, work: [] f64, output: [] f32) -> ResourceCostStatus #effects(all) {
  if !resource_matches(p, source) || p.spec.format != ResourceFormat.wav_pcm16 { return ResourceCostStatus.mismatch; }
  if output.count < p.cost.decoded / 4 { return ResourceCostStatus.capacity; }
  if p.cost.decode_scratch != 0 { if !wav.apw_coefficients(filter, work) { return ResourceCostStatus.capacity; } }
  if !wav.apw_decode(filter, source, work, output) { return ResourceCostStatus.decode; }
  return ResourceCostStatus.ok;
}
resource_decode_bodies :: (p: ResourcePlan, source: [] u8, output: [] cells.CellBody) -> ResourceCostStatus #effects(all) {
  if !resource_matches(p, source) || p.spec.format != ResourceFormat.cell_bodies { return ResourceCostStatus.mismatch; }
  if output.count < p.cost.elements { return ResourceCostStatus.capacity; }
  for i: 0..<p.cost.elements { output[i] = resource_body(source, i * 64); }
  return ResourceCostStatus.ok;
}
