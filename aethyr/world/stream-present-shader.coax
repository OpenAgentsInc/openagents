// One final linear HDR-to-UNORM display conversion. No tone/gamma transform
// is added to this corridor profile; the display attachment clamps/rounds.
#module "aethyr.world.streampresent";
#load "../gpu/shader.coax";
#test "display triangle covers every viewport corner and preserves sampled linear RGBA" {
  a := sp_vs(0, 0); b := sp_vs(1, 0); c := sp_vs(2, 0);
  #assert a.x == -1 && a.y == -3 && a.z == 0 && a.w == 1;
  #assert b.x == -1 && b.y == 1 && b.z == 0 && b.w == 1;
  #assert c.x == 3 && c.y == 1 && c.z == 0 && c.w == 1;
  pixels := [4] V4.[v4(0.25, 0.5, 0.75, 1), v4(0.125, 0.375, 0.625, 0.875), v4(0.8, 0.6, 0.4, 0.2), v4(0.7, 0.5, 0.3, 0.1)]; u := [4] f32.[2, 2, 0, 0];
  image := Tex2D.{width = 2, height = 2, texels = pixels[..]};
  x := sp_fs(v4(0.5, 0.5, 0, 1), u[..], image, Sampler.{}); y := sp_fs(v4(1.5, 0.5, 0, 1), u[..], image, Sampler.{});
  #assert x.x == 0.25 && x.y == 0.5 && x.z == 0.75 && x.w == 1;
  #assert y.x == 0.125 && y.y == 0.375 && y.z == 0.625 && y.w == 0.875;
  z := sp_fs(v4(0.5, 1.5, 0, 1), u[..], image, Sampler.{}); #assert z.x == 0.8 && z.y == 0.6 && z.z == 0.4 && z.w == 0.2;
  u[1] = 1; image.height = 1; image.texels = pixels[0..<2];
  r := sp_fs(v4(0.5, 0.5, 0, 1), u[..], image, Sampler.{}); #assert r.x == 0.25 && r.z == 0.75;
}
sp_vs :: (vertex: u32, instance: u32) -> V4 {
  positions := [3] V2.[v2(-1, -3), v2(-1, 1), v2(3, 1)];
  return v4(positions[cast(int) vertex].x, positions[cast(int) vertex].y, 0, 1);
}
sp_fs :: (position: V4, u: [] f32, scene: Tex2D, smp: Sampler) -> V4 {
  return gpu_sample_level(scene, smp, v2(position.x / u[0], position.y / u[1]), 0);
}
