// Independent wire vectors are specified by state_wire_vector in the Python
// oracle. These deliberately raw records test encoding, not world admission.
#load "../../core/input.coax" as inputs;
#forall "canonical zero-scalar wire vectors pin every byte with both Boolean values" bit: 0..<2 #steps 30000000 {
  flag := bit == 1; s: [1] SwWalk; b: [1] SwStateBytes;
  zero_clock := clock.FrameClock.{step_ns = 0, max_frame_ns = 0, max_steps = 0};
  s[0].valid = flag; s[0].closing = flag; s[0].prefetch_cell = 0;
  s[0].player = walking.Player.{on_ground = flag, theta = 0, phi = 0, dist = 0, max_dist = 0,
    target = walking.Vec3.{}, prev_target = walking.Vec3.{}, prev_dist = 0, pace = 0, grip = 0, clock = zero_clock,
    run = flag, jump_held = flag, wings = flag, dive_held = flag, diving = flag, sliding = flag, collision_floor_cut = flag};
  s[0].player.jumps.held = flag;
  s[0].cells[0].n = 1; s[0].cells[0].cells[0].body_n = 1;
  boxes: [6] f32; bodies: [1] cells.CellBody; s[0].decoded_boxes[0] = boxes[..]; s[0].decoded_bodies[0] = bodies[..];
  for i: 0..<SW_CELLS {
    s[0].entity[0].live[i] = flag; s[0].entity[0].born[i] = flag; s[0].entity[0].doomed[i] = flag;
    s[0].born[i] = flag; s[0].awake[i] = flag;
  }
  s[0].stream[0].valid = flag; s[0].stream[0].closing = flag; s[0].stream[0].last_tick = 0;
  s[0].stream[0].budget[0].valid = flag;
  zero_lease := HostInboxLease.{slot = 0};
  for i: 0..<7 { s[0].stream[0].budget[0].peak_owners[i] = zero_lease; }
  s[0].stream[0].budget[0].peak_owner = zero_lease; s[0].stream[0].budget[0].actor_peak_owner = zero_lease; s[0].stream[0].budget[0].voice_peak_owner = zero_lease;
  for i: 0..<64 {
    s[0].stream[0].owners[i].active = flag; s[0].stream[0].wanted[i] = flag; s[0].retire_sent[i] = flag;
    s[0].stream[0].owners[i].admission[0].status = ResourceAdmissionStatus.ok; s[0].stream[0].owners[i].admission[0].settled = flag;
    for k: 0..<5 { s[0].stream[0].owners[i].admission[0].leases[k] = zero_lease; }
    s[0].claims[i].slot = 0; s[0].stream[0].claims[i].live = flag; s[0].queue[0].entries[i].live = flag;
  }
  s[0].prefetch.slot = 0; s[0].queue[0].valid = flag; s[0].queue[0].epoch = 0; s[0].queue[0].retired = flag;
  s[0].load_n = 1; s[0].loads[0].owner = 0; s[0].retire_n = 1; s[0].retires[0].owner = 0;
  s[0].record_n = 1; s[0].records[0].key.owner = 0;
  n := sw_state_bytes(s[..], zero_clock, 0, b[..]); #assert n == 27928;
  hex: [64] u8; #assert assets.asset_hex(assets.asset_id(cast(string) b[0].bytes[0..<n]), hex[..]);
  expected := ifx flag then "b6924eb23d1c0967da2516f174709cd244fe0a821d911c5ff7dd3768cb820645" else "f817b3610a618dc57e8eb94235deb5eb38117924b4b2ebf42049a7d02a3569ad";
  #assert cast(string) hex[..] == expected;
}
#test "canonical schema review is required when retained record shapes change" {
  #assert type_info(SwWalk).field_count == 52 && type_info(walking.Player).field_count == 38;
  #assert type_info(clock.FrameClock).field_count == 13;
  #assert type_info(inputs.InputPress).field_count == 5;
  #assert type_info(cells.CellBody).field_count == 5 && type_info(cells.CellState).field_count == 4 && type_info(cells.CellWorld).field_count == 5;
  #assert type_info(ResourceStream).field_count == 19 && type_info(ResourceOwner).field_count == 7;
  #assert type_info(ResourceBudget).field_count == 18 && type_info(ResourceAdmission).field_count == 9;
  #assert type_info(ResourceReference).field_count == 3 && type_info(ResourceClaimEntry).field_count == 3;
  #assert type_info(ResourceLoadKey).field_count == 4 && type_info(SwRecord).field_count == 6;
  #assert type_info(HostInboxQueue).field_count == 9 && type_info(HostInboxEntry).field_count == 3 && type_info(HostInboxLease).field_count == 3;
  #assert type_info(profiles.WorldStreamProfile).field_count == 15 && type_info(profiles.WorldPools).field_count == 7;
  #assert type_info(cells.CellRings).field_count == 6 && type_info(assets.AssetId).field_count == 1;
  #assert type_info(SwEntities).field_count == 8 && type_info(filters.PhysicalSurface).field_count == 10;
}
