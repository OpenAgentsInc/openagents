// The weather adapter for the environment resolver (lighting plan Phase 1 step 4, GitHub #13064;
// docs/verse/lighting/README.md). It is not a second weather: it reads aethyr/world/water-weather.coax, the
// schedule every Everglade client, late joiner and replay already shares (weather_sample,
// weather_sample_at, weather_ground), into a versioned WeatherCondition, and applies Everglade's
// existing weather light (apps/openagents-web/everglade.coax weather_frame: the key dims and the
// ambient, sky and haze go grey under cloud; fog and rain thicken the haze) to a ResolvedEnvironment.
//
//   - Global weather is the zone's schedule at a tick (weather_cond_global): the same everywhere.
//     Local visual overlays (spell weather: Create Water's rain, Sleet Storm, Fog Cloud, Call
//     Lightning's cloud, Storm of Vengeance) are a separate, local condition at a place
//     (weather_cond_local), never folded into the global one. The ground's wetness and puddles are
//     the schedule's (weather_ground) in both, as Everglade has them.
//   - A condition is made only from known game state: the schedule (with the pins a realm holds,
//     such as the room server's word through everglade-net.coax net_sky_weather), its seed, the
//     world tick and, for a local one, the place and the host's overlays. The adapter reads copies:
//     it never pins, unpins or changes the schedule, and nothing here changes the simulation.
//   - The lighting resolver (light_resolve) takes the day (aethyr/world/day.coax), the condition
//     and the set, and invents no policy: it applies the arithmetic Everglade already draws.
//   - The cache (light_resolve_cached) keeps one resolved value under its complete identity: the
//     environment and day versions, the set's generation, the profile, the tick, the world, the
//     whole clock and the whole condition. Any difference misses; a refusal is never kept.
//   coax/bin/coax test aethyr/world/weather.coax
//   coax/bin/coax mutate aethyr/world/weather.coax --root-only
#module "aethyr.world.weather";
#authority;
#load "environment.coax" as env;
#load "day.coax" as day;
#load "water-weather.coax";

WEATHER_COND_VERSION :: 1;
WEATHER_COND_WIND_MAX :: 100.0;     // m/s, either axis
WEATHER_COND_POS_MAX :: 10000000.0; // m

WeatherScope :: enum u8 { global; local; }
WeatherRefusal :: enum u8 { none; version; state; nonfinite; range; scope; }

// The weather the lighting reads, at one tick (and, local, one place).
WeatherCondition :: struct {
  version: u32;
  scope: WeatherScope;
  seed: u64; tick: u64;     // the schedule's seed and the world tick it was sampled at
  x: f64; z: f64;           // local: where (m); global: 0
  state: int;               // WEATHER_CLEAR .. WEATHER_STORM
  rain: f64; cloud: f64; fog: f64; lightning: f64;   // 0 to 1
  wind_x: f64; wind_z: f64; // m/s
  wet: f64; puddles: f64;   // the ground, 0 to 1
}

EnvLightKey :: struct {
  env_version: u32; day_version: u32; cond_version: u32;
  generation: int; profile: u32;
  tick: s64; world: day.DayWorld; clock: day.DayClock;
  cond: WeatherCondition;
}
EnvLightCache :: struct { valid: bool; key: EnvLightKey; env: env.ResolvedEnvironment; }
EnvLightResolve :: struct {
  day: day.DayRefusal; weather: WeatherRefusal; env: env.EnvRefusal;
  hit: bool;
  value: env.ResolvedEnvironment;
}

// ---- checks (written before the code below)

wc_everglade :: () -> [1] WeatherSchedule #effects(all) { s: [1] WeatherSchedule; weather_everglade(s[..]); return s; }
// The first tick, block by block from block `from`, whose block's state differs from the block before
// it (and is `want` when want >= 0).
wc_turn :: (s: [] WeatherSchedule, want: int, from: u64) -> u64 #effects(all) {
  b := from;
  while weather_block(s, b) == weather_block(s, b - 1) || (want >= 0 && weather_block(s, b) != want) { b += 1; }
  return b * WEATHER_BLOCK;
}

#test "a global condition is the schedule's weather and ground at the tick, exactly, and reads only a copy" {
  s := wc_everglade(); before := s[0]; before_state := weather_cond_global(s[..], 1).state;
  for i: 0..<6 {
    tick := [6] u64.[0, 1, 7199, WEATHER_BLOCK * 3 + 11, wc_turn(s[..], WEATHER_RAIN, 1) + 2000, wc_turn(s[..], WEATHER_STORM, 1) + 40000][i];
    c := weather_cond_global(s[..], tick); w := weather_sample(s[..], tick); g := weather_ground(s[..], tick);
    #assert c.version == WEATHER_COND_VERSION && c.scope == WeatherScope.global && c.seed == 0xe7e5 && c.tick == tick && c.x == 0 && c.z == 0;
    #assert c.state == w.state && c.rain == w.rain && c.cloud == w.cloud && c.fog == w.fog && c.lightning == w.lightning && c.wind_x == w.wind_x && c.wind_z == w.wind_z;
    #assert c.wet == g.wet && c.puddles == g.puddles && weather_cond_check(c) == WeatherRefusal.none;
  }
  // the schedule's state and its wetness: rain wets the ground, and a storm's block is a storm
  rain := wc_turn(s[..], WEATHER_RAIN, 1) + WEATHER_BLOCK / 2;
  #assert weather_cond_global(s[..], rain).state == WEATHER_RAIN && weather_cond_global(s[..], rain).wet > 0.5;
  #assert weather_cond_global(s[..], wc_turn(s[..], WEATHER_STORM, 1) + WEATHER_BLOCK / 2).state == WEATHER_STORM;
  // a pin the realm holds (a capture's ?weather=, the room's word) is read, never written
  s[0].pin_n = 0; weather_pin(s[..], 600, WEATHER_FOG); pinned := s[0];
  #assert weather_cond_global(s[..], 600 + WEATHER_BLOCK).state == WEATHER_FOG && weather_cond_global(s[..], 1).state == before_state;
  #assert s[0].pin_n == 1 && pinned.pin_n == 1 && s[0].pin_tick[0] == 600 && s[0].pin_state[0] == WEATHER_FOG && s[0].seed == before.seed;
  none: [1] WeatherOverlay;
  s[0] = before; _ := weather_cond_local(s[..], 3, 4, 99, none[0..<0]); _ = weather_cond_global(s[..], 99);
  #assert s[0].pin_n == 0 && s[0].seed == 0xe7e5 && s[0].climate.wind_high == 7.0 && s[0].climate.weights[4] == 0.04;
}
#test "spell weather is a local condition: inside it the overlay shows, the global condition never moves" {
  s := wc_everglade();
  tick := wc_turn(s[..], WEATHER_CLEAR, 1) + WEATHER_BLOCK / 2;
  o: [2] WeatherOverlay;
  o[0] = WeatherOverlay.{kind = OVERLAY_FOG, x = 10, z = -4, radius = 6, start = tick - 1000, duration = 5000};
  o[1] = WeatherOverlay.{kind = OVERLAY_STORM, x = -50, z = 20, radius = 8, start = tick - 1000, duration = 5000};
  g := weather_cond_global(s[..], tick);
  inside := weather_cond_local(s[..], 10, -4, tick, o[..]);
  storm := weather_cond_local(s[..], -50, 20, tick, o[..]);
  outside := weather_cond_local(s[..], 200, 200, tick, o[..]);
  w := weather_sample_at(s[..], 10, -4, tick, o[..]);
  #assert inside.scope == WeatherScope.local && inside.x == 10 && inside.z == -4 && inside.fog == w.fog && inside.fog == 1 && g.fog < 0.5;
  #assert inside.state == w.state && inside.rain == w.rain && inside.cloud == w.cloud && inside.wind_x == w.wind_x && inside.wind_z == w.wind_z && inside.lightning == w.lightning;
  #assert storm.state == WEATHER_STORM && storm.rain > 0.999 && g.state == WEATHER_CLEAR;
  // the ground is the schedule's in both: a spell does not wet the world's ground
  #assert inside.wet == g.wet && inside.puddles == g.puddles && storm.wet == g.wet && inside.tick == tick && inside.seed == g.seed;
  // outside every overlay a local condition is the global one at that place
  #assert outside.scope == WeatherScope.local && outside.state == g.state && outside.rain == g.rain && outside.fog == g.fog && outside.cloud == g.cloud;
  #assert outside.wind_x == g.wind_x && outside.wind_z == g.wind_z && outside.lightning == g.lightning;
  // and the global condition is the same however many overlays are cast
  #assert weather_cond_same(weather_cond_global(s[..], tick), g) && !weather_cond_same(inside, g) && !weather_cond_same(outside, g);
  #assert weather_cond_check(inside) == WeatherRefusal.none && weather_cond_check(storm) == WeatherRefusal.none;
}
#test "Everglade's weather light: under cloud the key dims and the sky greys, fog and rain thicken the haze" {
  set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  base := env.env_resolve(set[..], env.EnvironmentState.{version = env.ENV_VERSION, profile = 7, day = 0.2}).env;
  sched := wc_everglade(); weather_pin_all(sched[..], WEATHER_CLEAR); clear := weather_cond_global(sched[..], WEATHER_BLOCK * 7);
  #assert clear.state == WEATHER_CLEAR && clear.cloud == 0.15 && clear.fog == 0 && clear.rain == 0;
  // a clear sky leaves every value as it is
  #assert env.env_resolved_same(weather_env_apply(base, clear), base, true);
  c := clear; c.state = WEATHER_RAIN; c.cloud = 0.95; c.fog = 0.25; c.rain = 0.6;
  r := weather_env_apply(base, c);
  over := cast(f32) fmax(c.cloud - 0.15, 0.0) / 0.85;
  #assert over > 0.94 && over < 0.95;
  // everglade.coax weather_frame, number for number: the key's strength, the ambient rows, the haze,
  // its glow, the zenith and the horizon, and the haze's density
  #assert r.direct.r == base.direct.r * (1 - 0.55 * over) && r.direct.g == base.direct.g * (1 - 0.55 * over) && r.direct.b == base.direct.b * (1 - 0.55 * over);
  a := [3] env.EnvRgb.[base.channels.ambient.upper, base.channels.ambient.horizon, base.channels.ambient.lower];
  b := [3] env.EnvRgb.[r.channels.ambient.upper, r.channels.ambient.horizon, r.channels.ambient.lower];
  for i: 0..<3 { #assert b[i].r == a[i].r * (1 - 0.3 * over) && b[i].g == a[i].g * (1 - 0.3 * over) && b[i].b == a[i].b * (1 - 0.3 * over); }
  grey := [3] f32.[0.82, 0.9, 1.0];
  was := [4] env.EnvRgb.[base.channels.fog.air, base.channels.fog.sun_tint, base.channels.sky.zenith, base.channels.sky.horizon];
  now := [4] env.EnvRgb.[r.channels.fog.air, r.channels.fog.sun_tint, r.channels.sky.zenith, r.channels.sky.horizon];
  for i: 0..<4 {
    v := [3] f32.[was[i].r, was[i].g, was[i].b]; n := [3] f32.[now[i].r, now[i].g, now[i].b];
    y := 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
    for k: 0..<3 { #assert n[k] == v[k] + (y * grey[k] * 0.78 - v[k]) * (0.8 * over); }
    #assert n[0] != v[0];
  }
  #assert r.channels.fog.density == base.channels.fog.density * (1 + 4.0 * cast(f32) c.fog + 1.5 * cast(f32) c.rain);
  // nothing else moves: the direction, the identifiers, the other channels
  rest := r; rest.direct = base.direct; rest.channels.ambient = base.channels.ambient;
  rest.channels.fog.air = base.channels.fog.air; rest.channels.fog.sun_tint = base.channels.fog.sun_tint; rest.channels.fog.density = base.channels.fog.density;
  rest.channels.sky.zenith = base.channels.sky.zenith; rest.channels.sky.horizon = base.channels.sky.horizon;
  #assert env.env_resolved_same(rest, base, true);
  // a fog with no cloud thickens the haze and dims nothing
  f := clear; f.fog = 1; f.cloud = 0.1;
  q := weather_env_apply(base, f);
  #assert q.channels.fog.density == base.channels.fog.density * 5 && q.direct.r == base.direct.r && q.channels.sky.zenith.g == base.channels.sky.zenith.g;
}
#test "condition changes: when the weather turns, the resolved light follows it" {
  s := wc_everglade(); set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  clock := day.day_cycle(0.5, 30, 0, day.DaySource.authority);
  turn := wc_turn(s[..], WEATHER_STORM, 1);
  calm := weather_cond_global(s[..], wc_turn(s[..], WEATHER_CLEAR, 1) + WEATHER_BLOCK / 2); storm := weather_cond_global(s[..], turn + WEATHER_BLOCK / 2);
  #assert calm.state == WEATHER_CLEAR && storm.state == WEATHER_STORM && storm.cloud == 1;
  a := light_resolve(set[..], 0, clock, day.DayWorld.shared, 300, calm);
  b := light_resolve(set[..], 0, clock, day.DayWorld.shared, 300, storm);
  #assert a.day == day.DayRefusal.none && a.weather == WeatherRefusal.none && a.env == env.EnvRefusal.none && !a.hit;
  #assert b.value.direct.r < a.value.direct.r && b.value.channels.fog.density > a.value.channels.fog.density;
  d := day.day_state(clock, day.DayWorld.shared, 300, 0).state;
  #assert env.env_resolved_same(a.value, weather_env_apply(env.env_resolve(set[..], d).env, calm), true);
  #assert env.env_resolved_same(b.value, weather_env_apply(env.env_resolve(set[..], d).env, storm), true);
  // through the blend the light moves smoothly: no jump between frames two seconds apart
  last := light_resolve(set[..], 0, clock, day.DayWorld.shared, 300, weather_cond_global(s[..], turn)).value.direct.r;
  moved := 0.0f32; from := last;
  for i: 0..<31 {
    t := turn + cast(u64) i * 240;
    r := light_resolve(set[..], 0, clock, day.DayWorld.shared, 300, weather_cond_global(s[..], t)).value.direct.r;
    #assert abs(r - last) < 0.1f32; moved += abs(r - last); last = r;
  }
  // and only one way: the cloud thickens to the storm's, so the key only dims
  #assert moved > 0.01f32 && abs(moved - (from - last)) < 0.00001f32;
}
#test "malformed conditions are refused, each for its reason, and resolve nothing" {
  s := wc_everglade(); ok := weather_cond_global(s[..], 1000);
  #assert weather_cond_check(ok) == WeatherRefusal.none;
  for f: 0..<24 {
    c := ok; want := WeatherRefusal.range;
    if f == 0 { c.version = 0; want = WeatherRefusal.version; }
    else if f == 1 { c.version = 2; want = WeatherRefusal.version; }
    else if f == 2 { c.state = -1; want = WeatherRefusal.state; }
    else if f == 3 { c.state = WEATHER_STORM + 1; want = WeatherRefusal.state; }
    else if f == 4 { c.rain = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 5 { c.cloud = 1.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 6 { c.fog = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 7 { c.lightning = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 8 { c.wind_x = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 9 { c.wind_z = -1.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 10 { c.wet = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 11 { c.puddles = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 12 { c.x = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 13 { c.z = 0.0 / 0.0; want = WeatherRefusal.nonfinite; }
    else if f == 14 { c.rain = -0.001; }
    else if f == 15 { c.cloud = 1.001; }
    else if f == 16 { c.fog = 1.001; }
    else if f == 17 { c.lightning = -0.001; }
    else if f == 18 { c.wet = 1.001; }
    else if f == 19 { c.puddles = -0.001; }
    else if f == 20 { c.wind_x = WEATHER_COND_WIND_MAX + 0.001; }
    else if f == 21 { c.wind_z = -WEATHER_COND_WIND_MAX - 0.001; }
    else if f == 22 { c.x = 1; want = WeatherRefusal.scope; }
    else { c.z = -1; want = WeatherRefusal.scope; }
    #assert weather_cond_check(c) == want;
    set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
    r := light_resolve(set[..], 0, day.day_fixed(0.5, 30), day.DayWorld.solo, 1, c);
    #assert r.weather == want && r.value.version == 0;
  }
  // the bounds themselves are admitted, and a local condition may sit anywhere in the world
  for f: 0..<12 {
    c := ok;
    if f == 0 { c.rain = 0; } else if f == 1 { c.rain = 1; } else if f == 2 { c.cloud = 0; } else if f == 3 { c.fog = 1; }
    else if f == 4 { c.lightning = 1; } else if f == 5 { c.wet = 1; } else if f == 6 { c.puddles = 1; } else if f == 7 { c.wind_x = -WEATHER_COND_WIND_MAX; }
    else if f == 8 { c.wind_z = WEATHER_COND_WIND_MAX; } else if f == 9 { c.state = WEATHER_CLEAR; } else if f == 10 { c.state = WEATHER_STORM; }
    else { c.scope = WeatherScope.local; c.x = WEATHER_COND_POS_MAX; c.z = -WEATHER_COND_POS_MAX; }
    #assert weather_cond_check(c) == WeatherRefusal.none;
  }
  l := ok; l.scope = WeatherScope.local; l.x = WEATHER_COND_POS_MAX * 1.000001; #assert weather_cond_check(l) == WeatherRefusal.range;
  l = ok; l.scope = WeatherScope.local; l.z = -WEATHER_COND_POS_MAX * 1.000001; #assert weather_cond_check(l) == WeatherRefusal.range;
  // a refused clock or state resolves nothing either
  set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  r := light_resolve(set[..], 0, day.day_real(0.5, 30, 0, day.DaySource.local), day.DayWorld.shared, 1, ok);
  #assert r.day == day.DayRefusal.local_clock && r.weather == WeatherRefusal.none && r.value.version == 0;
  r = light_resolve(set[..], 99, day.day_fixed(0.5, 30), day.DayWorld.shared, 1, ok);
  #assert r.day == day.DayRefusal.none && r.env == env.EnvRefusal.reference && r.value.version == 0;
}
#test "the cache holds one value under its whole identity: any change misses, a refusal is never kept" {
  s := wc_everglade(); set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  cache: [1] EnvLightCache;
  clock := day.day_cycle(0.2, 30, 10, day.DaySource.authority);
  cond := weather_cond_global(s[..], wc_turn(s[..], WEATHER_RAIN, 1) + 3000);
  first := light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond);
  #assert !first.hit && cache[0].valid && first.env == env.EnvRefusal.none;
  again := light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond);
  #assert again.hit && env.env_resolved_same(again.value, first.value, true);
  #assert env.env_resolved_same(first.value, light_resolve(set[..], 7, clock, day.DayWorld.shared, 500, cond).value, true);
  // each part of the identity, changed alone, misses and recomputes what it must
  for f: 0..<26 {
    c := clock; w := cond; tick := cast(s64) 500; world := day.DayWorld.shared; profile := cast(u32) 7;
    if f == 0 { tick = 501; } else if f == 1 { world = day.DayWorld.solo; } else if f == 2 { profile = 0; }
    else if f == 3 { c.mode = day.DayMode.real; c.seconds = day.DAY_REAL_SECONDS; } else if f == 4 { c.source = day.DaySource.authored; }
    else if f == 5 { c.hz = 31; } else if f == 6 { c.epoch = 11; } else if f == 7 { c.at = 0.21; } else if f == 8 { c.seconds = 2881; }
    else if f == 9 { w.scope = WeatherScope.local; } else if f == 10 { w.seed = 1; } else if f == 11 { w.tick += 1; }
    else if f == 12 { w.scope = WeatherScope.local; w.x = 1; } else if f == 13 { w.scope = WeatherScope.local; w.z = 1; }
    else if f == 14 { w.state = WEATHER_STORM; } else if f == 15 { w.rain = 0.01; } else if f == 16 { w.cloud = 0.5; }
    else if f == 17 { w.fog = 0.9; } else if f == 18 { w.lightning = 0.5; } else if f == 19 { w.wind_x = 1; }
    else if f == 20 { w.wind_z = 1; } else if f == 21 { w.wet = 0.01; } else if f == 22 { w.puddles = 0.01; }
    else if f == 23 { c.version = 0; } else if f == 24 { w.version = 0; } else { tick = -1; }
    cache[0] = EnvLightCache.{}; _ := light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond);
    k := light_key(set[..], profile, c, world, tick, w);
    #assert !light_key_same(k, cache[0].key) && !light_key_same(cache[0].key, k);
    r := light_resolve_cached(cache[..], set[..], profile, c, world, tick, w);
    u := light_resolve(set[..], profile, c, world, tick, w);
    #assert !r.hit && r.day == u.day && r.weather == u.weather && r.env == u.env && env.env_resolved_same(r.value, u.value, true);
    refused := u.day != day.DayRefusal.none || u.weather != WeatherRefusal.none || u.env != env.EnvRefusal.none;
    #assert refused == (f >= 23);
    // a refusal leaves the cache as it was; an admitted value takes its place
    #assert cache[0].valid && light_key_same(cache[0].key, ifx refused then light_key(set[..], 7, clock, day.DayWorld.shared, 500, cond) else k);
  }
  // replacing the set moves its generation: the same request misses, even for the same numbers
  cache[0] = EnvLightCache.{}; _ := light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond);
  next: [1] env.EnvironmentSet; next[0] = env.env_test_set();
  #assert env.env_set_replace(set[..], next[..]).refusal == env.EnvRefusal.none;
  r := light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond);
  #assert !r.hit && cache[0].key.generation == set[0].generation && light_resolve_cached(cache[..], set[..], 7, clock, day.DayWorld.shared, 500, cond).hit;
  // and the versions are part of the key
  k := light_key(set[..], 7, clock, day.DayWorld.shared, 500, cond);
  #assert k.env_version == env.ENV_VERSION && k.day_version == day.DAY_VERSION && k.cond_version == WEATHER_COND_VERSION && k.profile == 7 && k.tick == 500;
  for f: 0..<3 {
    j := k;
    if f == 0 { j.env_version = 2; } else if f == 1 { j.day_version = 2; } else { j.cond_version = 2; }
    #assert !light_key_same(j, k);
  }
}
#test "fixed-state replay and late-join evaluation agree: the same tick, epoch and state give the same light" #steps 2000000000 {
  span := cast(s64) 2880000; base := cast(s64) 1700000; hz := cast(u32) 30;
  // the room's W at a tick: the server's day ms, as room-sky.coax eg_sky_day has it
  w_ms := (base + 40 * 1000 / 30) % span;
  host_clock := day.day_from_room(40, hz, w_ms, span);
  host: [1] EnvLightCache; host_s := wc_everglade(); set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  // the host plays on, through a weather turn (the world tick runs at 120 Hz, four to a room tick),
  // resolving every 2,600 ticks
  turn := wc_turn(host_s[..], -1, 3);
  start := cast(s64) (turn / 4) - 30000;
  replay: [24] env.ResolvedEnvironment;
  for i: 0..<24 {
    t := start + cast(s64) i * 2600;
    r := light_resolve_cached(host[..], set[..], 7, host_clock, day.DayWorld.shared, t, weather_cond_global(host_s[..], cast(u64) t * 4));
    #assert r.day == day.DayRefusal.none && r.env == env.EnvRefusal.none; replay[i] = r.value;
  }
  // the weather turned somewhere in that run
  #assert replay[0].channels.fog.density != replay[23].channels.fog.density;
  // a late joiner hears W at some later tick, builds its own schedule from the seed, and resolves
  // each of the same ticks fresh: the same values, bit for bit
  for j: 0..<3 {
    late_tick := start + [3] s64.[5, 31000, 59000][j];
    late_clock := day.day_from_room(late_tick, hz, (base + late_tick * 1000 / 30) % span, span);
    #assert day.day_clock_same(late_clock, host_clock);
    late: [1] EnvLightCache; late_s := wc_everglade();
    for i: 0..<24 {
      t := start + cast(s64) i * 2600;
      r := light_resolve_cached(late[..], set[..], 7, late_clock, day.DayWorld.shared, t, weather_cond_global(late_s[..], cast(u64) t * 4));
      #assert !r.hit && env.env_resolved_same(r.value, replay[i], true);
    }
  }
  // a replay of the run in reverse order gives the same values too
  again: [1] EnvLightCache;
  i := 23;
  while i >= 0 {
    t := start + cast(s64) i * 2600;
    #assert env.env_resolved_same(light_resolve_cached(again[..], set[..], 7, host_clock, day.DayWorld.shared, t, weather_cond_global(host_s[..], cast(u64) t * 4)).value, replay[i], true);
    i -= 1;
  }
}

// ---- conditions

weather_cond_from :: (scope: WeatherScope, s: WeatherSchedule, tick: u64, x: f64, z: f64, w: Weather, g: WeatherGround) -> WeatherCondition #effects(all) {
  return WeatherCondition.{version = WEATHER_COND_VERSION, scope = scope, seed = s.seed, tick = tick, x = x, z = z, state = w.state,
    rain = w.rain, cloud = w.cloud, fog = w.fog, lightning = w.lightning, wind_x = w.wind_x, wind_z = w.wind_z, wet = g.wet, puddles = g.puddles};
}
// The zone's weather at world tick `tick`: the schedule's, the same everywhere.
weather_cond_global :: (s: [] WeatherSchedule, tick: u64) -> WeatherCondition #effects(all) {
  c: [1] WeatherSchedule; c[0] = s[0];
  return weather_cond_from(WeatherScope.global, c[0], tick, 0, 0, weather_sample(c[..], tick), weather_ground(c[..], tick));
}
// The weather at (x, z) with the host's spell overlays laid over the schedule's; the ground stays the
// schedule's.
weather_cond_local :: (s: [] WeatherSchedule, x: f64, z: f64, tick: u64, overlays: [] WeatherOverlay) -> WeatherCondition #effects(all) {
  c: [1] WeatherSchedule; c[0] = s[0];
  return weather_cond_from(WeatherScope.local, c[0], tick, x, z, weather_sample_at(c[..], x, z, tick, overlays), weather_ground(c[..], tick));
}

wc_finite :: (x: f64) -> bool #effects(all) { return x - x == 0; }
wc_unit :: (x: f64) -> bool #effects(all) { return x >= 0 && x <= 1; }
weather_cond_check :: (c: WeatherCondition) -> WeatherRefusal #effects(all) {
  if c.version != WEATHER_COND_VERSION { return WeatherRefusal.version; }
  if c.state < WEATHER_CLEAR || c.state > WEATHER_STORM { return WeatherRefusal.state; }
  v := [10] f64.[c.rain, c.cloud, c.fog, c.lightning, c.wet, c.puddles, c.wind_x, c.wind_z, c.x, c.z];
  for i: 0..<10 { if !wc_finite(v[i]) { return WeatherRefusal.nonfinite; } }
  for i: 0..<6 { if !wc_unit(v[i]) { return WeatherRefusal.range; } }
  if abs(c.wind_x) > WEATHER_COND_WIND_MAX || abs(c.wind_z) > WEATHER_COND_WIND_MAX { return WeatherRefusal.range; }
  if abs(c.x) > WEATHER_COND_POS_MAX || abs(c.z) > WEATHER_COND_POS_MAX { return WeatherRefusal.range; }
  if c.scope == WeatherScope.global && (c.x != 0 || c.z != 0) { return WeatherRefusal.scope; }
  return WeatherRefusal.none;
}
weather_cond_same :: (a: WeatherCondition, b: WeatherCondition) -> bool #effects(all) {
  return a.version == b.version && a.scope == b.scope && a.seed == b.seed && a.tick == b.tick && a.x == b.x && a.z == b.z && a.state == b.state
    && a.rain == b.rain && a.cloud == b.cloud && a.fog == b.fog && a.lightning == b.lightning && a.wind_x == b.wind_x && a.wind_z == b.wind_z
    && a.wet == b.wet && a.puddles == b.puddles;
}

// ---- Everglade's weather light (everglade.coax weather_frame), on resolved values

wc_scale :: (c: env.EnvRgb, k: f32) -> env.EnvRgb #effects(all) { return env.EnvRgb.{r = c.r * k, g = c.g * k, b = c.b * k}; }
// Toward a rain sky's blue-grey: its luminance through (0.82, 0.9, 1) at 0.78, by k.
wc_grey :: (c: env.EnvRgb, k: f32) -> env.EnvRgb #effects(all) {
  y := 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
  return env.EnvRgb.{r = c.r + (y * 0.82 * 0.78 - c.r) * k, g = c.g + (y * 0.9 * 0.78 - c.g) * k, b = c.b + (y * 1.0 * 0.78 - c.b) * k};
}
weather_env_apply :: (e: env.ResolvedEnvironment, c: WeatherCondition) -> env.ResolvedEnvironment #effects(all) {
  o := e;
  over := cast(f32) fmax(c.cloud - 0.15, 0.0) / 0.85;   // a clear sky's thin cloud leaves the light
  o.direct = wc_scale(o.direct, 1 - 0.55 * over);
  a := 1 - 0.3 * over;
  o.channels.ambient.upper = wc_scale(o.channels.ambient.upper, a);
  o.channels.ambient.horizon = wc_scale(o.channels.ambient.horizon, a);
  o.channels.ambient.lower = wc_scale(o.channels.ambient.lower, a);
  g := 0.8 * over;
  o.channels.fog.air = wc_grey(o.channels.fog.air, g);
  o.channels.fog.sun_tint = wc_grey(o.channels.fog.sun_tint, g);
  o.channels.sky.zenith = wc_grey(o.channels.sky.zenith, g);
  o.channels.sky.horizon = wc_grey(o.channels.sky.horizon, g);
  o.channels.fog.density *= 1 + 4.0 * cast(f32) c.fog + 1.5 * cast(f32) c.rain;
  return o;
}

// ---- resolution and its cache

// The resolved environment for `profile` (0: the set's default) at simulation tick `tick` on `clock`,
// under condition `c`. Refused at the first failing input: the condition, the day, then the set.
light_resolve :: (set: [] env.EnvironmentSet, profile: u32, clock: day.DayClock, world: day.DayWorld, tick: s64, c: WeatherCondition) -> EnvLightResolve #effects(all) {
  out: EnvLightResolve;
  out.weather = weather_cond_check(c);
  if out.weather != WeatherRefusal.none { return out; }
  d := day.day_state(clock, world, tick, profile);
  out.day = d.refusal;
  if out.day != day.DayRefusal.none { return out; }
  r := env.env_resolve(set, d.state);
  out.env = r.refusal;
  if out.env != env.EnvRefusal.none { return out; }
  out.value = weather_env_apply(r.env, c);
  return out;
}
light_key :: (set: [] env.EnvironmentSet, profile: u32, clock: day.DayClock, world: day.DayWorld, tick: s64, c: WeatherCondition) -> EnvLightKey #effects(all) {
  return EnvLightKey.{env_version = env.ENV_VERSION, day_version = day.DAY_VERSION, cond_version = WEATHER_COND_VERSION,
    generation = set[0].generation, profile = profile, tick = tick, world = world, clock = clock, cond = c};
}
light_key_same :: (a: EnvLightKey, b: EnvLightKey) -> bool #effects(all) {
  return a.env_version == b.env_version && a.day_version == b.day_version && a.cond_version == b.cond_version && a.generation == b.generation
    && a.profile == b.profile && a.tick == b.tick && a.world == b.world && day.day_clock_same(a.clock, b.clock) && weather_cond_same(a.cond, b.cond);
}
// light_resolve through a one-entry cache: a hit only under the same complete key; an admitted value
// replaces the entry, a refusal leaves it.
light_resolve_cached :: (cache: [] EnvLightCache, set: [] env.EnvironmentSet, profile: u32, clock: day.DayClock, world: day.DayWorld, tick: s64, c: WeatherCondition) -> EnvLightResolve #effects(all) {
  k := light_key(set, profile, clock, world, tick, c);
  if cache[0].valid && light_key_same(cache[0].key, k) {
    out: EnvLightResolve; out.hit = true; out.value = cache[0].env;
    return out;
  }
  out := light_resolve(set, profile, clock, world, tick, c);
  if out.weather == WeatherRefusal.none && out.day == day.DayRefusal.none && out.env == env.EnvRefusal.none {
    cache[0] = EnvLightCache.{valid = true, key = k, env = out.value};
  }
  return out;
}
