{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aethyrforge.measurement.v1",
  "title": "Aethyrforge measurement report",
  "type": "object",
  "required": [
    "schema",
    "quantile",
    "id",
    "startedAt",
    "finishedAt",
    "ok",
    "environment",
    "pins",
    "cache",
    "warmup",
    "trialOrder",
    "phases",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "aethyrforge.measurement.v1" },
    "quantile": { "const": "linear-n-minus-one" },
    "id": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "ok": { "type": "boolean" },
    "environment": { "type": "object", "required": ["browser", "os", "gpu"] },
    "pins": {
      "type": "object",
      "required": ["source", "assets", "kernel", "wgsl", "quality", "build"]
    },
    "cache": {
      "type": "object",
      "required": ["state", "scope"],
      "properties": {
        "state": {
          "enum": ["cold", "warm", "mixed", "not-applicable", "unknown"]
        },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "warmup": {
      "type": "object",
      "required": ["durationMs", "iterations"],
      "properties": {
        "durationMs": { "type": ["number", "null"], "minimum": 0 },
        "iterations": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "trialOrder": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "type": "string" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "kind", "scope", "metrics"],
        "properties": {
          "kind": {
            "enum": [
              "simulation-cpu",
              "integrated",
              "startup",
              "edit",
              "archive"
            ]
          },
          "scope": { "type": "string", "minLength": 1 },
          "metrics": { "type": "object" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "schema", "limitations"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "details": {}
  },
  "$comment": "The executable validator also checks all source/artifact pins, ordered times, finite JSON values, and size limits. Null means unavailable; zero is a measured zero. Native archived reports keep their original schemas and quantile methods."
}
