// Build just the existing Everglade page, local room and native shell.
// No web release, deployment, model download or production API is involved.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc-raw.coax";
#load "../../coax/lib/json/json.coax";
#load "linux-build.coax";

AfPaths :: struct { b: [65536] u8; n: int; }
af_path :: (p: [] AfPaths, root: string, name: string) -> string {
  start := p[0].n;
  for c: root { p[0].b[p[0].n] = c; p[0].n += 1; }
  p[0].b[p[0].n] = '/'; p[0].n += 1;
  for c: name { p[0].b[p[0].n] = c; p[0].n += 1; }
  return cast(string) p[0].b[start..<p[0].n];
}
af_run :: (argv: [] string, out: [] u8, deadline: int) -> int {
  left := deadline - proc_now_ms();
  if left <= 0 { tool_errln("Aethyrforge build reached its fourteen-minute limit; resume the remaining build step."); return -1; }
  err: [65536] u8;
  env: [] string;
  r := proc_run_bytes(argv, env, left, out, err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out || r.cut {
    tool_errln(cast(string) out[0..<r.out_n]); tool_errln(cast(string) err[0..<r.err_n]);
    tool_errln("Aethyrforge build step failed or exceeded its time/output limit."); return -1;
  }
  return r.out_n;
}
af_start :: (argv: [] string) -> int {
  h := proc_new(); if h < 0 { return -1; }
  for arg: argv { if !proc_arg(h, arg) { released := proc_release(h); return -1; } }
  if proc_start(h) != 0 { released := proc_release(h); return -1; }
  return h;
}
af_finish :: (h: int, deadline: int) -> bool {
  if h < 0 { return true; }
  line: [65536] u8;
  while proc_now_ms() < deadline {
    n := proc_line(h, 500, line[..]);
    if n >= 0 { print("%\n", cast(string) line[0..<n]); continue; }
    if n == PROC_TIMEOUT { continue; }
    if n == PROC_EOF { break; }
    released := proc_release(h); return false;
  }
  status := proc_wait(h, proc_left(deadline, proc_now_ms())); ok := status == 0;
  if !ok { tool_errln(proc_stderr(h, line[..])); tool_errln("Local-stack build failed or reached its fourteen-minute limit."); }
  released := proc_release(h); return ok;
}
// Ignored build outputs never make the next build stale.
af_newest :: (dir: string) -> int {
  l: [1] FsList; n := fs_list(dir, l[..]);
  if n < 0 || l[0].full { return 9223372036854775807; }
  latest := 0;
  for i: 0..<n {
    name := fs_entry(l[..], i);
    if name.count == 0 || name[0] == '.' || name == "build" || name == "bin" || name == "node_modules" { continue; }
    b: [4096] u8; path := fs_join(dir, name, b[..]);
    stamp := ifx fs_kind(path) == FS_DIR then af_newest(path) else fs_mtime_ns(path);
    if stamp > latest { latest = stamp; }
  }
  return latest;
}
// Ask the existing source-closure tool, without evaluating every engine check.
// New, unrelated CLI libraries must not rerun a passing Everglade build.
af_stack_stamp :: (root: string, deadline: int) -> int {
  path: [4096] u8; script := fs_join(root, "coax/web/tool.sh", path[..]);
  argv := [11] string.[script, "wasm-size", "sources", "coax/web/room/room.coax", "apps/openagents-web/everglade5e.coax",
    "apps/openagents-web/everglade-step.coax", "verse/grid.coax", "verse/everglade/river.coax",
    "verse/everglade/guard-guide-policy.coax", "apps/openagents-web/everglade5e-rules.coax", "aethyr/render/carriers/everglade.coax"];
  h := proc_new(); if h < 0 { return -1; }
  ok := proc_cwd(h, root); for a: argv { ok = ok && proc_arg(h, a); }
  if !ok || proc_start(h) != 0 { released := proc_release(h); return -1; }
  latest := 0; line: [8192] u8;
  while proc_now_ms() < deadline {
    n := proc_line(h, 1000, line[..]);
    if n == PROC_TIMEOUT { continue; }
    if n == PROC_EOF { break; }
    if n < 0 { released := proc_release(h); return -1; }
    b: [4096] u8; file := fs_join(root, cast(string) line[0..<n], b[..]); stamp := fs_mtime_ns(file);
    if stamp < 0 { released := proc_release(h); return -1; }
    if stamp > latest { latest = stamp; }
  }
  status := proc_wait(h, proc_left(deadline, proc_now_ms())); released := proc_release(h);
  if status != 0 { return -1; }
  // Native faces, scripts, compiler and pack are outside Coax's load graph.
  for dir: [3] string.["apps/openagents-web", "coax/web/room", "coax/platform"] {
    b: [4096] u8; stamp := af_newest(fs_join(root, dir, b[..])); if stamp > latest { latest = stamp; }
  }
  for name: [2] string.["verse/voice-host/ws.c", "verse/voice-host/ws.h"] {
    b: [4096] u8; stamp := fs_mtime_ns(fs_join(root, name, b[..])); if stamp > latest { latest = stamp; }
  }
  b: [4096] u8; compiler := fs_mtime_ns(fs_join(root, "coax/bin/coax", b[..]));
  return ifx compiler > latest then compiler else latest;
}
// Native units have separate resumable artifacts. Their source closure is the
// compiler's existing load listing; the SDK never implements a Coax parser.
af_native_stamp :: (root:string,source:string,deadline:int)->int {
 paths:[2][4096]u8;out:[1048576]u8;cmd:=[4]string.[fs_join(root,"coax/web/tool.sh",paths[0][..]),"wasm-size","sources",source];n:=af_run(cmd[..],out[..],deadline);if n<0 {return -1;}latest:=0;start:=0;
 for i:0..<n {if out[i]=='\n' {if i>start {stamp:=fs_mtime_ns(fs_join(root,cast(string)out[start..<i],paths[1][..]));if stamp<0 {return -1;}if stamp>latest {latest=stamp;}}start=i+1;}}
 return latest;
}
af_native :: (root:string,here:string,work:string,coax:string,out:[]u8,deadline:int)->bool {
 paths:[8][4096]u8;metal:=fs_join(work,"metal",paths[0][..]);if !fs_mkdir(metal) {return false;}
 names:=[11]string.["everglade5e","Everglade-step","Grid","River","Guard-guide-policy","Everglade5e-rules","MetalRender","RenderTexture","AppKitInput","HostNetwork","entropy-policy"];
 sources:=[11]string.["apps/aethyrforge-desktop/metal-world.coax","apps/openagents-web/everglade-step.coax","verse/grid.coax","verse/everglade/river.coax","verse/everglade/guard-guide-policy.coax","apps/openagents-web/everglade5e-rules.coax","apps/aethyrforge-desktop/metal-render.coax","aethyr/render/native-texture.coax","aethyr/host/appkit-input.coax","aethyr/host/native-socket.coax","coax/lib/crypto/entropy.coax"];
 compiler_stamp:=fs_mtime_ns(coax);producer_stamp:=0;
 for name,i:names {stamp:=af_native_stamp(root,sources[i],deadline);if stamp<0 {return false;}if compiler_stamp>stamp {stamp=compiler_stamp;}
  text:[128]u8;j:[1]Jo;jo_start(j[..],text[..]);jo_put(j[..],name);jo_put(j[..],".o");object:=fs_join(metal,jo_text(j[..]),paths[1][..]);
  if fs_mtime_ns(object)<stamp {print("Building native Metal unit %…\n",name);cmd:=[6]string.[fs_join(root,"coax/web/tool.sh",paths[2][..]),fs_join(here,"metal-build.coax",paths[3][..]),root,name,"--coax",coax];if af_run(cmd[..],out,deadline)<0 {return false;}}
  if i<6 && fs_mtime_ns(object)>producer_stamp {producer_stamp=fs_mtime_ns(object);}
 }
 for name:[5]string.["apps/openagents-web/everglade5e-face.c","apps/openagents-web/face-address.h","apps/openagents-web/edit-face.h","apps/openagents-web/place-face.h","apps/openagents-web/analytics-face.h"] {stamp:=fs_mtime_ns(fs_join(root,name,paths[1][..]));if stamp>producer_stamp {producer_stamp=stamp;}}
 if fs_mtime_ns(fs_join(metal,"libeverglade.dylib",paths[1][..]))<producer_stamp {cmd:=[4]string.[fs_join(root,"coax/web/tool.sh",paths[2][..]),fs_join(here,"metal-build.coax",paths[3][..]),root,"producer"];if af_run(cmd[..],out,deadline)<0 {return false;}}
 sdk_stamp:=fs_mtime_ns(fs_join(here,"MetalRealm.m",paths[1][..]));for name:[5]string.["metal-host.h","metal-producer.h","metal-sockets.h","build/metal/MetalRender.h","build/metal/RenderTexture.h"] {stamp:=fs_mtime_ns(fs_join(here,name,paths[1][..]));if stamp>sdk_stamp {sdk_stamp=stamp;}}
 if fs_mtime_ns(fs_join(metal,"MetalRealm.o",paths[1][..]))<sdk_stamp {cmd:=[4]string.[fs_join(root,"coax/web/tool.sh",paths[2][..]),fs_join(here,"metal-build.coax",paths[3][..]),root,"sdk"];if af_run(cmd[..],out,deadline)<0 {return false;}}
 network_stamp:=af_newest(fs_join(root,"coax/platform",paths[1][..]));for name:[5]string.["MetalSockets.c","metal-sockets.h","metal-build.coax","build/metal/HostNetwork.o","build/metal/entropy-policy.o"] {stamp:=fs_mtime_ns(fs_join(here,name,paths[1][..]));if stamp>network_stamp {network_stamp=stamp;}}
 if fs_mtime_ns(fs_join(metal,"libnetwork.dylib",paths[1][..]))<network_stamp {cmd:=[4]string.[fs_join(root,"coax/web/tool.sh",paths[2][..]),fs_join(here,"metal-build.coax",paths[3][..]),root,"socket-library"];if af_run(cmd[..],out,deadline)<0 {return false;}}
 shader_stamp:=af_newest(fs_join(root,"verse/gpu",paths[1][..]));for dir:[2]string.["aethyr/render","apps/openagents-web"] {stamp:=af_newest(fs_join(root,dir,paths[1][..]));if stamp>shader_stamp {shader_stamp=stamp;}}
 if fs_mtime_ns(fs_join(metal,"render/metal.json",paths[1][..]))<shader_stamp {env:[4096]u8;graphics:=proc_getenv("COAX_GRAPHICS",env[..]);if graphics=="" {tool_errln("Metal shader products need a graphics-qualified compiler: set COAX_GRAPHICS to its executable, then resume build.sh. The cached tool compiler is never replaced.");return false;}cmd:=[6]string.[fs_join(root,"coax/web/tool.sh",paths[2][..]),fs_join(here,"metal-build.coax",paths[3][..]),root,"shaders","--coax",graphics];if af_run(cmd[..],out,deadline)<0 {return false;}}
 pack:=fs_join(root,"apps/openagents-web/realms/everglade/assets/everglade.pack",paths[1][..]);asset_stamp:=af_native_stamp(root,"apps/aethyrforge-desktop/metal-assets.coax",deadline);if fs_mtime_ns(pack)>asset_stamp {asset_stamp=fs_mtime_ns(pack);}
 if fs_mtime_ns(fs_join(metal,"assets/textures.config",paths[2][..]))<asset_stamp {cmd:=[5]string.[fs_join(root,"coax/web/tool.sh",paths[3][..]),fs_join(here,"metal-assets.coax",paths[4][..]),root,pack,fs_join(metal,"assets",paths[5][..])];if af_run(cmd[..],out,deadline)<0 {return false;}}
 return true;
}
tool_main :: () -> int #export_c {
  a: [1] Args;
  if tool_os()==TOOL_LINUX {if !args_load(a[..]) {return 2;}return fgl_build(a[..]);}
  if !args_load(a[..]) || args_count(a[..]) < 1 || args_count(a[..]) > 2 || (args_count(a[..]) == 2 && args_at(a[..], 1) != "--open") {
    tool_errln("usage: apps/aethyrforge-desktop/build.sh [--open]"); return 2;
  }
  root := args_at(a[..], 0); p: [1] AfPaths;
  here := af_path(p[..], root, "apps/aethyrforge-desktop");
  work := af_path(p[..], here, "build"); app := af_path(p[..], work, "Aethyrforge.app");
  res := af_path(p[..], app, "Contents/Resources"); mac := af_path(p[..], app, "Contents/MacOS");
  if !fs_mkdir(res) || !fs_mkdir(mac) { return 1; }
  deadline := proc_now_ms() + 840000;
  out: [16777216] u8; env: [4096] u8;
  coax := proc_getenv("COAX", env[..]); if coax == "" { coax = af_path(p[..], root, "coax/bin/coax"); }
  print("Checking local stack sources…\n"); newest := af_stack_stamp(root, deadline);
  if newest < 0 { tool_errln("Cannot read the local stack's source closure."); return 1; }
  room := af_path(p[..], root, "coax/web/room/bin/room");
  room_job := -1; page_job := -1;worker_job:=-1;
  if fs_mtime_ns(room) < newest {
    print("Building the local room…\n");
    script := af_path(p[..], root, "coax/web/room/build.sh"); cmd := [2] string.["bash", script];
    room_job = af_start(cmd[..]); if room_job < 0 { return 1; }
  }
  wasm := af_path(p[..], root, "apps/openagents-web/build/everglade5e.wasm");
  if fs_mtime_ns(wasm) < newest {
    print("Building Everglade's existing WebGPU engine…\n");
    cmd := [10] string.["bash", af_path(p[..], root, "coax/web/wasm.sh"), af_path(p[..], root, "apps/openagents-web/everglade5e.coax"),
      af_path(p[..], root, "apps/openagents-web/everglade5e-face.c"), wasm,
      af_path(p[..], root, "apps/openagents-web/everglade-step.coax"), af_path(p[..], root, "verse/grid.coax"),
      af_path(p[..], root, "verse/everglade/river.coax"), af_path(p[..], root, "verse/everglade/guard-guide-policy.coax"),
      af_path(p[..], root, "apps/openagents-web/everglade5e-rules.coax")];
    page_job = af_start(cmd[..]); if page_job < 0 { if room_job >= 0 { released := proc_release(room_job); } return 1; }
  }
  worker_wasm:=af_path(p[..],root,"apps/openagents-web/build/everglade-room.wasm");
  if fs_mtime_ns(worker_wasm)<newest {
    cmd:=[2]string.["bash",af_path(p[..],root,"coax/web/room/worker.sh")];worker_job=af_start(cmd[..]);if worker_job<0 {return 1;}
  }
  if !af_finish(room_job, deadline) { if page_job >= 0 { released := proc_release(page_job); }if worker_job>=0 {released:=proc_release(worker_job);} return 1; }
  if !af_finish(page_job, deadline) { return 1; }
  if !af_finish(worker_job,deadline) {return 1;}
  audio_stamp:=af_native_stamp(root,"aethyr/host/audio-carrier.coax",deadline);if audio_stamp<0 {return 1;}
  for name:[4]string.["coax/web/audio-face.c","coax/web/build-audio.coax","coax/web/wasm.sh","coax/bin/coax"] {stamp:=fs_mtime_ns(af_path(p[..],root,name));if stamp>audio_stamp {audio_stamp=stamp;}}
  if fs_mtime_ns(af_path(p[..],root,"apps/openagents-web/build/host-audio.wasm"))<audio_stamp {
    print("Building the shared browser audio carrier…\n");audio_cmd:=[3]string.[af_path(p[..],root,"coax/web/tool.sh"),af_path(p[..],root,"coax/web/build-audio.coax"),root];if af_run(audio_cmd[..],out[..],deadline)<0 {return 1;}
  }
  layer_stamp:=af_native_stamp(root,"aethyr/host/layers-carrier.coax",deadline);if layer_stamp<0 {return 1;}
  for name:[4]string.["coax/web/layers-face.c","coax/web/build-layers.coax","coax/web/wasm.sh","coax/bin/coax"] {stamp:=fs_mtime_ns(af_path(p[..],root,name));if stamp>layer_stamp {layer_stamp=stamp;}}
  layers_wasm:=af_path(p[..],root,"apps/openagents-web/build/host-layers.wasm");
  if fs_mtime_ns(layers_wasm)<layer_stamp {
    print("Building the shared browser image carrier…\n");layer_cmd:=[4]string.[af_path(p[..],root,"coax/web/tool.sh"),af_path(p[..],root,"coax/web/build-layers.coax"),root,layers_wasm];if af_run(layer_cmd[..],out[..],deadline)<0 {return 1;}
  }
  media_stamp:=af_native_stamp(root,"aethyr/host/media-carrier.coax",deadline);if media_stamp<0 {return 1;}
  for name:[4]string.["coax/web/media-face.c","coax/web/build-media.coax","coax/web/wasm.sh","coax/bin/coax"] {stamp:=fs_mtime_ns(af_path(p[..],root,name));if stamp>media_stamp {media_stamp=stamp;}}
  media_wasm:=af_path(p[..],root,"apps/openagents-web/build/host-media.wasm");
  if fs_mtime_ns(media_wasm)<media_stamp {
    print("Building the shared browser still-media carrier…\n");media_cmd:=[4]string.[af_path(p[..],root,"coax/web/tool.sh"),af_path(p[..],root,"coax/web/build-media.coax"),root,media_wasm];if af_run(media_cmd[..],out[..],deadline)<0 {return 1;}
  }
  services_stamp:=af_native_stamp(root,"aethyr/host/services-carrier.coax",deadline);if services_stamp<0 {return 1;}
  for name:[4]string.["coax/web/services-face.c","coax/web/build-services.coax","coax/web/wasm.sh","coax/bin/coax"] {stamp:=fs_mtime_ns(af_path(p[..],root,name));if stamp>services_stamp {services_stamp=stamp;}}
  services_wasm:=af_path(p[..],root,"apps/openagents-web/build/host-services.wasm");
  if fs_mtime_ns(services_wasm)<services_stamp {
    print("Building the shared browser service carrier…\n");services_cmd:=[4]string.[af_path(p[..],root,"coax/web/tool.sh"),af_path(p[..],root,"coax/web/build-services.coax"),root,services_wasm];if af_run(services_cmd[..],out[..],deadline)<0 {return 1;}
  }
  if !af_native(root,here,work,coax,out[..],deadline) {return 1;}
  print("Building Aethyrforge's AppKit shell…\n");
  serve := af_path(p[..], res, "serve");
  sc := [12] string.["/usr/bin/clang", "-std=c11", "-O2", "-D_DARWIN_C_SOURCE", "-Wall", "-Wextra", "-o", serve,
    af_path(p[..], root, "coax/web/serve.c"), af_path(p[..], root, "verse/voice-host/ws.c"), "-lm", "-Wno-unused-function"];
  if af_run(sc[..], out[..], deadline) < 0 { return 1; }
  header := af_path(p[..], work, "session.h"); code := af_path(p[..], work, "session.c"); object := af_path(p[..], work, "session.o");
  gen := [6] string.[coax, "c", af_path(p[..], here, "session.coax"), "--library", "--header", header];
  n := af_run(gen[..], out[..], deadline);
  if n < 0 || !fs_write(code, cast(string) out[0..<n]) { return 1; }
  cc := [8] string.["/usr/bin/clang", "-std=c11", "-O2", "-c", code, "-o", object, "-Wno-unused-function"];
  if af_run(cc[..], out[..], deadline) < 0 { return 1; }
  bridge := af_path(p[..], work, "setup-face.o");
  bc := [10] string.["/usr/bin/clang", "-std=c11", "-O2", "-c", af_path(p[..], here, "setup-face.c"), "-I", work, "-o", bridge, "-Wno-unused-function"];
  if af_run(bc[..], out[..], deadline) < 0 { return 1; }
  chat_h := af_path(p[..], work, "chat.h"); chat_c := af_path(p[..], work, "chat.c"); chat_o := af_path(p[..], work, "chat.o");
  cg := [6]string.[coax,"c",af_path(p[..],here,"chat.coax"),"--library","--header",chat_h];
  cn := af_run(cg[..],out[..],deadline); if cn<0 || !fs_write(chat_c,cast(string)out[0..<cn]) {return 1;}
  ccc := [8]string.["/usr/bin/clang","-std=c11","-O2","-c",chat_c,"-o",chat_o,"-Wno-unused-function"];
  if af_run(ccc[..],out[..],deadline)<0 {return 1;}
  chat_face := af_path(p[..],work,"chat-face.o");
  cbc := [10]string.["/usr/bin/clang","-std=c11","-O2","-c",af_path(p[..],here,"chat-face.c"),"-I",work,"-o",chat_face,"-Wno-unused-function"];
  if af_run(cbc[..],out[..],deadline)<0 {return 1;}
  hud_copy := [3]string.["ditto",af_path(p[..],here,"HUD.metal"),af_path(p[..],res,"HUD.metal")];
  if af_run(hud_copy[..],out[..],deadline)<0 {return 1;}
  sw := [44] string.["xcrun", "swiftc", "-O", "-target", "arm64-apple-macos26.0", "-import-objc-header", af_path(p[..], here, "face.h"),
    af_path(p[..], here, "Sources/main.swift"), af_path(p[..], here, "Sources/Setup.swift"), af_path(p[..],here,"Sources/Chat.swift"), af_path(p[..],here,"Sources/SetupProfile.swift"), af_path(p[..],here,"Sources/Offline.swift"), af_path(p[..],here,"Sources/Benchmark.swift"), af_path(p[..],root,"apps/shared/zeron/MetalUI.swift"),af_path(p[..],here,"Sources/MetalWorld.swift"),af_path(p[..],here,"Sources/MetalNetwork.swift"),af_path(p[..],here,"Sources/MetalAudio.swift"),af_path(p[..],here,"Sources/MetalBridge.swift"),object,bridge,chat_o,chat_face,af_path(p[..],work,"metal/MetalRealm.o"),af_path(p[..],work,"metal/MetalRender.o"),af_path(p[..],work,"metal/RenderTexture.o"),af_path(p[..],work,"metal/AppKitInput.o"),"-Xlinker","-export_dynamic","-framework","MetalKit", "-framework", "AppKit", "-framework", "WebKit", "-framework", "AVFoundation","-framework","QuartzCore","-framework","ImageIO","-framework","CoreGraphics", "-o", af_path(p[..], mac, "Aethyrforge")];
  if af_run(sw[..], out[..], deadline) < 0 { return 1; }
  for name:[3]string.["Zeron.metal","fonts","NOTICE"] {
    copy:=[3]string.["ditto",af_path(p[..],af_path(p[..],root,"apps/shared/zeron"),name),af_path(p[..],res,name)];
    if af_run(copy[..],out[..],deadline)<0 {return 1;}
  }
  for name:[4]string.["render","assets","libeverglade.dylib","libnetwork.dylib"] {cmd:=[3]string.["ditto",af_path(p[..],af_path(p[..],work,"metal"),name),af_path(p[..],af_path(p[..],res,"metal"),name)];if af_run(cmd[..],out[..],deadline)<0 {return 1;}}
  // Keep a compact self-contained page tree: the exact engine, shaders and pack
  // the website uses, plus all generic browser host modules.
  web := af_path(p[..], res, "web"); host := af_path(p[..], res, "host"); seed := af_path(p[..], res, "seed");
  if !fs_mkdir(web) || !fs_mkdir(host) || !fs_mkdir(seed) { return 1; }
  metal_voice:=[3]string.["ditto",af_path(p[..],here,"metal-voice.html"),af_path(p[..],web,"metal-voice.html")];if af_run(metal_voice[..],out[..],deadline)<0 {return 1;}
  for name: [11] string.["everglade5e.wgsl", "everglade-fx.wgsl", "favicon.svg", "realms/everglade", "build/everglade5e.wasm", "build/everglade-room.wasm", "build/host-audio.wasm", "build/host-layers.wasm", "build/host-media.wasm", "build/host-services.wasm", "render-shaders"] {
    src := af_path(p[..], root, "apps/openagents-web"); from := af_path(p[..], src, name); to := af_path(p[..], web, name);
    if fs_kind(from) == FS_NONE { if name == "render-shaders" { continue; } return 1; }
    cmd := [3] string.["ditto", from, to]; if af_run(cmd[..], out[..], deadline) < 0 { return 1; }
  }
  hosts := af_path(p[..], root, "coax/web"); l: [1] FsList; count := fs_list(hosts, l[..]);
  if count < 0 || l[0].full { return 1; }
  for i: 0..<count {
    name := fs_entry(l[..], i);
    if name.count < 3 || name[name.count - 3..<name.count] != ".js" { continue; }
    cmd := [3] string.["ditto", af_path(p[..], hosts, name), af_path(p[..], host, name)];
    if af_run(cmd[..], out[..], deadline) < 0 { return 1; }
  }
  for name: [2] string.["world-everglade.json", "room-control.txt"] {
    cmd := [3] string.["ditto", af_path(p[..], af_path(p[..], root, "coax/web/room/dev"), name), af_path(p[..], seed, name)];
    if af_run(cmd[..], out[..], deadline) < 0 { return 1; }
  }
  copy_room := [3] string.["ditto", room, af_path(p[..], res, "room")];
  if af_run(copy_room[..], out[..], deadline) < 0 { return 1; }
  cli_dir := af_path(p[..], root, "apps/openagents-cli"); cli := af_path(p[..], cli_dir, "build/openagents");
  cli_stamp := af_newest(cli_dir);
  for dir: [4] string.["coax/lib", "coax/platform", "apps/shared", "psionic"] {
    b: [4096] u8; stamp := af_newest(fs_join(root, dir, b[..])); if stamp > cli_stamp { cli_stamp = stamp; }
  }
  compiler_stamp := fs_mtime_ns(coax); if compiler_stamp > cli_stamp { cli_stamp = compiler_stamp; }
  pk_image := af_path(p[..], root, "psionic/build/parakeet/psionic-parakeet");
  if fs_mtime_ns(cli) < cli_stamp || fs_kind(pk_image) != FS_FILE {
    print("Building the shared OpenAgents CLI…\n");
    cmd := [2] string.["bash", af_path(p[..], cli_dir, "build.sh")];
    if af_run(cmd[..], out[..], deadline) < 0 { return 1; }
  }
  for name: [2] string.["openagents", "openagents-dictate"] {
    cp := [3] string.["ditto", af_path(p[..], af_path(p[..], cli_dir, "build"), name), af_path(p[..], res, name)];
    if af_run(cp[..], out[..], deadline) < 0 { return 1; }
  }
  // Build the same Coder and Microcoder used by the TUI once, then package
  // their images. A chat message never compiles or needs a source checkout.
  hash_cmd := [4]string.["shasum","-a","256",coax];
  if af_run(hash_cmd[..],out[..],deadline)<64 {return 1;}
  hash_buf:[64]u8; for i:0..<64 {hash_buf[i]=out[i];} hash:=cast(string)hash_buf[..];
  for name:[3]string.["coder","mcworker","scene-cli"] {
    src_buf:[128]u8; sn:=0;
    for c:(ifx name=="scene-cli" then "apps/aethyrforge-desktop/" else "coder/tui/") {src_buf[sn]=c;sn+=1;} for c:name {src_buf[sn]=c;sn+=1;}
    for c:".coax" {src_buf[sn]=c;sn+=1;}
    cmd:=[3]string.[af_path(p[..],root,"coax/web/tool.sh"),af_path(p[..],root,cast(string)src_buf[0..<sn]),ifx name=="scene-cli" then "--help" else "--version"];
    child:=af_start(cmd[..]); if child<0 {return 1;} closed:=proc_close_stdin(child);
    if !af_finish(child,deadline) {return 1;}
    cache_buf:[256]u8; k:=0;
    for c:"coax/web/build/tools/" {cache_buf[k]=c;k+=1;}
    for c:name {cache_buf[k]=c;k+=1;} cache_buf[k]='-';k+=1;
    for c:hash {cache_buf[k]=c;k+=1;}
    cp:=[3]string.["ditto",af_path(p[..],root,cast(string)cache_buf[0..<k]),af_path(p[..],res,ifx name=="scene-cli" then "aethyrforge-scene" else name)];
    if af_run(cp[..],out[..],deadline)<0 {return 1;}
  }
  pk := [3] string.["ditto", pk_image, af_path(p[..], res, "psionic-parakeet")];
  if af_run(pk[..], out[..], deadline) < 0 { return 1; }
  voice_build := [3] string.[af_path(p[..], root, "coax/web/tool.sh"), af_path(p[..], here, "voice-build.coax"), root];
  if af_run(voice_build[..], out[..], deadline) < 0 { return 1; }
  for name: [2] string.["voice-host", "voice.wasm"] {
    destination := ifx name == "voice-host" then af_path(p[..], res, name) else af_path(p[..], web, "build/voice.wasm");
    cp := [3] string.["ditto", af_path(p[..], af_path(p[..], work, "voice"), name), destination];
    if af_run(cp[..], out[..], deadline) < 0 { return 1; }
  }
  for name:[2]string.["hello-foreman.wav","add-two-giant-crates.wav"] {
    fixture := [3] string.["ditto", af_path(p[..],af_path(p[..],root,"verse/voice-host/fixtures"),name), af_path(p[..],res,name)];
    if af_run(fixture[..], out[..], deadline) < 0 { return 1; }
  }
  plist := [3] string.["ditto", af_path(p[..], here, "Info.plist"), af_path(p[..], app, "Contents/Info.plist")];
  if af_run(plist[..], out[..], deadline) < 0 { return 1; }
  sign := [5] string.["codesign", "--force", "--sign", "-", app]; if af_run(sign[..], out[..], deadline) < 0 { return 1; }
  print("Built %\n", app);
  if args_has(a[..], "--open") {
    home_buf: [4096] u8; home := proc_getenv("HOME", home_buf[..]); if home == "" { return 1; }
    shared := af_path(p[..], home, ".openagents");
    installed := af_path(p[..], shared, "aethyrforge/Aethyrforge.app");
    cp := [3] string.["ditto", app, installed]; if af_run(cp[..], out[..], deadline) < 0 { return 1; }
    bins := af_path(p[..], shared, "bin"); version := af_path(p[..], shared, "versions/aethyrforge-cli-coder-2026-11-04");
    if !fs_mkdir(bins) || !fs_mkdir(version) { return 1; }
    for name: [6] string.["openagents", "openagents-dictate", "psionic-parakeet", "coder", "mcworker", "aethyrforge-scene"] {
      target := af_path(p[..], version, name);
      copy := [3] string.["ditto", af_path(p[..], res, name), target]; if af_run(copy[..], out[..], deadline) < 0 { return 1; }
      if name != "coder" && name != "mcworker" {
        link := [4] string.["ln", "-sfn", target, af_path(p[..], bins, name)];
        if af_run(link[..], out[..], deadline) < 0 { return 1; }
      }
    }
    launch := [2] string.["open", installed]; if af_run(launch[..], out[..], deadline) < 0 { return 1; }
    print("Opened %\n", installed);
  }
  return 0;
}
