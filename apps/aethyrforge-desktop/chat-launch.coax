// How a desktop chat turn runs: in this process, on Linux and the Mac, on the
// shared turn runner (coax/lib/agent/engine/run.coax): unattended, as Coder's
// plain runs are (Claude Code bypasses permissions; Codex runs with approval
// policy never and full access; Cursor's permissions and Microcoder's
// commands are accepted), System One picking the engine unless the person
// named one (the offline echo engine, or an engine the Mac's menu chose),
// and the reply streaming as it comes. An
// approval that still asks is refused: no one stands at an unattended run.
#authority;
// The runner's engine numbers (TR_* in run.coax, Coder's ENGINE_*), by name.
FC_RUN_NAMES :: [7] string.["echo","claude","codex","microcoder","psionic","cursor","micro"];
FC_RUN_ENGINES :: [7] int.[0,1,2,3,4,5,3];
FC_RUN_CLAUDE :: 1;    // where an automatic route starts from
#test "desktop turns on the runner: System One picks unless an engine is named, streamed, approvals refused" {
  names:=FC_RUN_NAMES;engines:=FC_RUN_ENGINES;
  for name,i:names {#assert !fc_run_routed(name) && fc_run_engine(name)==engines[i];}
  #assert fc_run_engine("echo")==0 && fc_run_engine("claude")==1 && fc_run_engine("codex")==2 && fc_run_engine("microcoder")==3;
  #assert fc_run_engine("psionic")==4 && fc_run_engine("cursor")==5 && fc_run_engine("micro")==3;
  for name:[4]string.["auto","","Echo","claude "] {#assert fc_run_routed(name) && fc_run_engine(name)==FC_RUN_CLAUDE;}
  #assert fc_run_live() && !fc_run_allow();
}
// The engine a turn runs on: the one named, else Claude Code, where an automatic route starts from.
fc_run_engine :: (engine:string)->int #export_c #effects(all) {
  names:=FC_RUN_NAMES;engines:=FC_RUN_ENGINES;
  for name,i:names {if name==engine {return engines[i];}}
  return FC_RUN_CLAUDE;
}
// Whether System One picks the turn's engine: unless the person named one.
fc_run_routed :: (engine:string)->bool #export_c #effects(all) {
  names:=FC_RUN_NAMES;
  for name:names {if name==engine {return false;}}
  return true;
}
// The reply streams as it comes (reply_delta lines), as --stream-json did.
fc_run_live :: ()->bool #export_c #effects(all) {return true;}
// What an approval that still asks gets: no.
fc_run_allow :: ()->bool #export_c #effects(all) {return false;}
