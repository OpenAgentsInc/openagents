// Desktop turns use Coder's existing unattended provider flow. Claude sets
// bypassPermissions; Codex sets approvalPolicy=never / danger-full-access.
#authority;
#test "desktop launch routes and streams without forcing interactive tool approval" {
  #assert fc_launch_option(0)=="--engine" && fc_launch_option(1)=="auto";
  #assert fc_launch_option(2)=="--stream-json";
  #assert fc_launch_option(-1)=="" && fc_launch_option(3)=="";
}
fc_launch_option :: (i:int)->string #export_c {
  options:=[3]string.["--engine","auto","--stream-json"];
  return ifx i>=0 && i<options.count then options[i] else "";
}
