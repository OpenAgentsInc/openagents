// Desktop-only Coder presentation and ownership of Return's complete press.
// 0 passes through, 1 consumes, 2 opens Coder, 3 delivers to native controls.
#load "../../metaverse-engine/ui/feed.coax";
#test "desktop feed events own the buffer and expiry across new turns" {
  s:[1]HudFeed;fc_feed_event(s[..],1,"first",10);
  #assert fc_feed_text(s[..])=="first" && fc_chat_mode(false,true,s[..],10)==1;
  fc_feed_event(s[..],2,"",10);
  #assert fc_chat_mode(false,false,s[..],5009)==1 && fc_chat_mode(false,false,s[..],5010)==0;
  #assert fc_chat_mode(true,false,s[..],5010)==2;
  fc_feed_event(s[..],0,"",20);#assert fc_feed_text(s[..])=="";
  fc_feed_event(s[..],1,"second",20);fc_feed_event(s[..],9,"ignored",30);
  #assert fc_feed_text(s[..])=="second" && !hf_visible(s[..],false,30);
}
#test "closed Coder keeps completed messages for five seconds without showing controls" {
  #assert fc_chat_hold_ms()==5000;
  for opened:[2]bool.[false,true] {for busy:[2]bool.[false,true] {for messages:[2]bool.[false,true] {
    for age:[5]int.[-1,0,4999,5000,5001] {
      expected:=ifx opened then 2 else ifx messages && (busy || age==0 || age==4999) then 1 else 0;
      s:[1]HudFeed;s[0].n=ifx messages then 1 else 0;hf_finish(s[..],0,5000);
      #assert fc_chat_mode(opened,busy,s[..],age)==expected;
    }
  }}}
}
#test "Return and keypad Enter open Coder and keep their release out of the realm" {
  for key:[2]int.[36,76] {
    #assert fc_enter_route(true,false,key,true,false,false,false)==2;
    #assert fc_enter_route(true,true,key,true,false,false,false)==3;
    #assert fc_enter_route(true,false,key,true,true,false,false)==1;
    #assert fc_enter_route(true,false,key,false,false,false,false)==0;
    #assert fc_enter_route(false,false,key,true,false,false,false)==0;
    #assert fc_enter_route(true,false,key,true,false,true,false)==0;
    #assert fc_enter_route(true,true,key,true,false,true,false)==0;
    #assert fc_enter_route(false,false,key,false,false,true,true)==1;
    #assert fc_enter_route(true,true,key,true,true,false,true)==1;
  }
  #assert fc_enter_route(true,false,0,true,false,false,false)==0;
  #assert fc_enter_route(true,false,53,true,false,false,true)==0;
}
fc_chat_hold_ms :: ()->int #export_c #effects(all) {return 5000;}
fc_chat_mode :: (opened:bool,busy:bool,feed:[]HudFeed,now_ms:int)->int #export_c #effects(all) {
  return ifx opened then 2 else ifx hf_visible(feed,busy,now_ms) then 1 else 0;
}
fc_feed_event :: (feed:[]HudFeed,kind:int,text:string,now_ms:int) #export_c #effects(all) {
  if kind==0 {hf_clear(feed);}
  if kind==1 {hf_append(feed,text);}
  if kind==2 {hf_finish(feed,now_ms,fc_chat_hold_ms());}
}
fc_feed_text :: (feed:[]HudFeed)->string #export_c #effects(all) {return hf_text(feed);}
fc_enter_route :: (ready:bool,opened:bool,key:int,down:bool,repeated:bool,modified:bool,held:bool)->int #export_c #effects(all) {
  if key!=36 && key!=76 {return 0;}
  if held {return 1;}
  if !down || !ready || modified {return 0;}
  if repeated {return 1;}
  return ifx opened then 3 else 2;
}
