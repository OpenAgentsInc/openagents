// Actual allocation and measured-pointer effects; no GPU or audio device starts.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../aethyr/host/audio-memory-conformance.coax";
mam_run :: (cmd:[]string)->bool {out:[1048576]u8;err:[1048576]u8;r:=proc_run(cmd,120000,out[..],err[..]);if r.started!=0||r.status!=0||r.timed_out||r.cut {tool_errln(cast(string)out[0..<r.out_n]);tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;}
mam_same :: (left:string,right:string)->bool {size:=fs_size(left);if size<1||fs_size(right)!=size {return false;}a:[65536]u8;b:[65536]u8;at:=0;while at<size {n:=ifx size-at<a.count then size-at else a.count;if fs_read_at(left,at,a[0..<n])!=n||fs_read_at(right,at,b[0..<n])!=n||cast(string)a[0..<n]!=cast(string)b[0..<n] {return false;}at+=n;}return true;}
mam_text :: (d:Jv,at:int,out:[]u8)->string {n:=jv_str(d,at,out);return ifx n>0 then cast(string)out[0..<n] else "";}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3 {tool_errln("usage: metal-audio-memory ROOT SDK_DIR OUTPUT [--sanitize] [--prepared] [--existing] [--resources DIR --producer DYLIB --golden PCM_DIR]");return 2;}
 root:=args_at(a[..],0);sdk:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}paths:[8][4096]u8;program:=fs_join(sdk,"MetalAudioMemory",paths[0][..]);report:=fs_join(out,"receipt.json",paths[1][..]);
 if !args_has(a[..],"--existing") {
  if !args_has(a[..],"--prepared") {cmd:[40]string;n:=0;
   for v:[8]string.["xcrun","swiftc","-O","-parse-as-library","-target","arm64-apple-macos26.0","-import-objc-header",fs_join(root,"apps/aethyrforge-desktop/metal-host.h",paths[2][..])] {cmd[n]=v;n+=1;}
   if args_has(a[..],"--sanitize") {cmd[n]="-sanitize=address";n+=1;}
   for name,i:[2]string.["apps/aethyrforge-desktop/Sources/MetalAudio.swift","apps/aethyrforge-desktop/tests/MetalAudioMemory.swift"] {cmd[n]=fs_join(root,name,paths[3+i][..]);n+=1;}
   for name,i:[3]string.["MetalRealm.o","MetalRender.o","RenderTexture.o"] {cmd[n]=fs_join(sdk,name,paths[5+i][..]);n+=1;}
   cmd[n]="-Xlinker";cmd[n+1]="-export_dynamic";n+=2;
   for name:[6]string.["AVFoundation","Foundation","Metal","QuartzCore","ImageIO","CoreGraphics"] {cmd[n]="-framework";cmd[n+1]=name;n+=2;}cmd[n]="-o";cmd[n+1]=program;n+=2;if !mam_run(cmd[0..<n]) {return 1;}
  }
  run:[5]string;run[0]=program;run[1]=report;rn:=2;if args_has(a[..],"--producer") {run[2]=args_value(a[..],"--resources","");run[3]=args_value(a[..],"--producer","");run[4]=args_value(a[..],"--golden","");rn=5;}if !mam_run(run[0..<rn]) {return 1;}
 }
 text:[65536]u8;nn:=fs_read(report,text[..]);doc:[1]Jv;nodes:[2048]JvNode;if nn<1||!jv_parse(doc[..],cast(string)text[0..<nn],nodes[..]) {return 1;}d:=doc[0];if !jv_raw_eq(jv_raw(d,jv_get(d,0,"schema")),"aethyr.metal.audio-memory.v1") {return 1;}
 mem:=jv_get(d,0,"memory");bank:=jv_get(d,0,"bank");if jv_len(d,mem)!=20||jv_len(d,bank)!=10 {return 1;}m:[20]int;b:[50]int;
 for i:0..<20 {m[i]=jv_int(d,jv_at(d,mem,i),-1);}for i:0..<10 {row:=jv_at(d,bank,i);if jv_len(d,row)!=5 {return 1;}for j:0..<5 {b[i*5+j]=jv_int(d,jv_at(d,row,j),-1);}}
 if !mamm_accept(m[..],b[..]) {tool_errln("Native audio memory/bank receipt refused");return 1;}
 bank_fields:=jv_get(d,0,"canonical");if bank_fields>=0 {if jv_len(d,bank_fields)!=15 {return 1;}fields:[15]int;for i:0..<15 {fields[i]=jv_int(d,jv_at(d,bank_fields,i),-1);}if !mamm_bank(fields[..]) {tool_errln("Native physical bank/allocation receipt refused");return 1;}
  files:=jv_get(d,0,"files");if jv_len(d,files)!=48 {return 1;}names:[48][64]u8;lengths:[48]int;actual:[4096]u8;golden:[4096]u8;bytes:=0;
  for i:0..<48 {file:=jv_at(d,files,i);name:=mam_text(d,jv_get(d,file,"name"),names[i][..]);if name.count==0 {return 1;}lengths[i]=name.count;for j:0..<i {if name==cast(string)names[j][0..<lengths[j]] {return 1;}}
   for pair:[2][2]string.[[2]string.["actual","golden"],[2]string.["wav","goldenWav"]] {left:=mam_text(d,jv_get(d,file,pair[0]),actual[..]);right:=mam_text(d,jv_get(d,file,pair[1]),golden[..]);if !mam_same(left,right) {tool_errln(left);tool_errln("Physical bank bytes differ from frozen canonical bank");return 1;}bytes+=fs_size(left);}
  }print("Actual48asset physical bank and retained PCM bytes match the complete frozen bank (%bytes)\n",bytes);
 }
 print("Actual native PCM extent, reservation lifetime and bank pointer-span boundaries passed: %\n",report);return 0;
}
