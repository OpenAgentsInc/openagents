// Measure the actual existing producer/adapter. Missing assets remain observations,
// never a successful default-audio qualification or a changed memory policy.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../metaverse-engine/host/audio-prefetch-conformance.coax";
#load "../../metaverse-engine/host/audio-prefetch-room-conformance.coax";
#load "../../metaverse-engine/host/audio-assets-conformance.coax";
#load "../../metaverse-engine/audio/sfx.coax";
#load "../../metaverse-engine/audio/everglade-bank.coax";
map_run :: (cmd:[]string,log_path:string)->bool {out:[1048576]u8;err:[65536]u8;r:=proc_run(cmd,180000,out[..],err[..]);if !fs_write(log_path,cast(string)err[0..<r.err_n])||r.started!=0||r.status!=0||r.cut||r.timed_out{tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;}
map_asset :: (j:[]Jo,c:SfxbCand) {label:[128]u8;name:[1]Jo;jo_start(name[..],label[..]);jo_put(name[..],SFX_NAMES[c.sound]);jo_put(name[..],"-");jo_put(name[..],c.cand);jo_str(j,jo_text(name[..]));}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<4{tool_errln("usage: metal-audio-prefetch ROOT SDK RESOURCES NEW_OUTPUT [--sanitize] [--prepared] [--producer DYLIB] [--phase decode|prefetch|input|picked|authored|canonical] [--require-ready] [--room-authoritative] [--existing]");return 2;}root:=args_at(a[..],0);sdk:=args_at(a[..],1);res:=args_at(a[..],2);dir:=args_at(a[..],3);requested:=args_value(a[..],"--phase","");if requested!=""&&requested!="decode"&&requested!="prefetch"&&requested!="input"&&requested!="picked"&&requested!="authored"&&requested!="canonical"{return 2;}if !fs_mkdir(dir){return 1;}paths:[22][4096]u8;program:=fs_join(sdk,"MetalAudioPrefetch",paths[0][..]);
 if !args_has(a[..],"--prepared")&&!args_has(a[..],"--existing") {cmd:[40]string;n:=0;for v:[8]string.["xcrun","swiftc","-O","-parse-as-library","-target","arm64-apple-macos26.0","-import-objc-header",fs_join(root,"apps/aethyrforge-desktop/metal-host.h",paths[1][..])]{cmd[n]=v;n+=1;}if args_has(a[..],"--sanitize"){cmd[n]="-sanitize=address";n+=1;}for source,i:[2]string.["apps/aethyrforge-desktop/Sources/MetalAudio.swift","apps/aethyrforge-desktop/tests/MetalAudioPrefetch.swift"]{cmd[n]=fs_join(root,source,paths[2+i][..]);n+=1;}for object,i:[3]string.["MetalRealm.o","MetalRender.o","RenderTexture.o"]{cmd[n]=fs_join(sdk,object,paths[4+i][..]);n+=1;}cmd[n]="-Xlinker";cmd[n+1]="-export_dynamic";n+=2;for framework:[6]string.["AVFoundation","Foundation","Metal","QuartzCore","ImageIO","CoreGraphics"]{cmd[n]="-framework";cmd[n+1]=framework;n+=2;}cmd[n]="-o";cmd[n+1]=program;n+=2;if !map_run(cmd[0..<n],fs_join(dir,"build.stderr",paths[7][..])){return 1;}}
 for phase,i:[6]string.["decode","prefetch","input","picked","authored","canonical"] {if requested!=""&&requested!=phase{continue;}name:[64]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],phase);jo_put(o[..],".json");report:=fs_join(dir,jo_text(o[..]),paths[8+i][..]);jo_start(o[..],name[..]);jo_put(o[..],phase);jo_put(o[..],"-plan.json");plan:=fs_join(dir,jo_text(o[..]),paths[14+i][..]);text:[4096]u8;j:[1]Jo;jo_start(j[..],text[..]);jo_obj(j[..]);jo_key(j[..],"schema");jo_str(j[..],"aethyr.metal.audio-prefetch-plan.v1");jo_key(j[..],"phase");jo_str(j[..],phase);jo_key(j[..],"assets");jo_arr(j[..]);if phase=="picked" {for pick:SFXB_PICK {if pick<0 {continue;}map_asset(j[..],SFXB[pick]);}}else if phase=="authored"||phase=="canonical" {for candidate:SFXB {if candidate.source!=SFXB_SYNTH{map_asset(j[..],candidate);}}}else{for asset:[3]string.["fire-cast-e2","fire-hit-e2","ambient-e1"]{jo_str(j[..],asset);}}jo_end(j[..]);jo_end(j[..]);if j[0].bad||!fs_write(plan,jo_text(j[..])){return 1;}producer:=args_value(a[..],"--producer",fs_join(res,"metal/libeverglade.dylib",paths[20][..]));run:=[5]string.[program,res,producer,plan,report];if !args_has(a[..],"--existing")&&!map_run(run[..],fs_join(dir,ifx i==0 then "decode.stderr" else ifx i==1 then "prefetch.stderr" else "input.stderr",paths[21][..])){return 1;}
  raw:[262144]u8;nn:=fs_read(report,raw[..]);d:[1]Jv;nodes:[16384]JvNode;if nn<1||!jv_parse(d[..],cast(string)raw[0..<nn],nodes[..]){return 1;}if jv_int(d[0],jv_get(d[0],0,"closedWords"),-1)!=0||jv_int(d[0],jv_get(d[0],0,"deviceFrames"),-1)!=0{return 1;}rows:=jv_get(d[0],0,"rows");fetches:=0;missing:=0;beds:=0;missing_beds:=0;rooms:=0;missing_rooms:=0;invalid:=0;for at:0..<jv_len(d[0],rows){row:=jv_at(d[0],rows,at);kind:=jv_int(d[0],jv_get(d[0],row,"kind"),0);samples:=jv_int(d[0],jv_get(d[0],row,"samples"),0);if kind==6{fetches+=1;if samples==0{missing+=1;}}if kind==2{beds+=1;if samples==0{missing_beds+=1;}}if kind==5{rooms+=1;if samples==0{missing_rooms+=1;}}if !hpf_ready(kind,jv_bool(d[0],jv_get(d[0],row,"parsed")),jv_int(d[0],jv_get(d[0],row,"result"),-99),samples,jv_int(d[0],jv_get(d[0],row,"channels"),-1)){invalid+=1;}}
  if args_has(a[..],"--require-ready")&&phase=="prefetch" {q:[16]int;for key,field_at:[3]string.["registered","bankAssets","bankWords"]{q[field_at]=jv_int(d[0],jv_get(d[0],0,key),-1);}q[3]=jv_len(d[0],rows);q[4]=fetches;q[5]=missing;q[6]=beds;q[7]=missing_beds;q[8]=rooms;q[9]=missing_rooms;q[10]=invalid;for key,field_at:[5]string.["heldAssets","heldWords","closedWords","deviceFrames","worldFrames"]{q[11+field_at]=jv_int(d[0],jv_get(d[0],0,key),-1);}accepted:=ifx args_has(a[..],"--room-authoritative") then hpfr_accept(q[..]) else hpf_accept(q[..]);if !accepted{tool_errln("Ordinary startup asset readiness refused; raw receipt retained");return 1;}}
  if phase=="canonical" {
   q:[9]int;q[0]=jv_len(d[0],rows);
   for at:0..<q[0] {row:=jv_at(d[0],rows,at);if jv_int(d[0],jv_get(d[0],row,"samples"),0)<1||jv_int(d[0],jv_get(d[0],row,"channels"),0)<1 {q[1]+=1;}if jv_int(d[0],jv_get(d[0],row,"releasedWords"),-1)!=0 {q[2]+=1;}}
   for key,field_at:[6]string.["sdkDecodes","companionDecodes","heldAssets","heldWords","closedWords","deviceFrames"] {q[3+field_at]=jv_int(d[0],jv_get(d[0],0,key),-1);}
   faults:=jv_get(d[0],0,"refusal");f:[28]int;if jv_len(d[0],faults)!=28 {return 1;}
   for at:0..<28 {f[at]=jv_int(d[0],jv_at(d[0],faults,at),-1);}
   if !hac_bank(q[..])||!hac_refusal(f[..]){tool_errln("Canonical adapter shape/release/refusal gate failed; raw receipt retained");return 1;}
  }
  print("Actual % observation: rows=% fetches=% unavailable=% beds=% unavailable_beds=%; receipt retained at %\n",phase,jv_len(d[0],rows),fetches,missing,beds,missing_beds,report);
 }return 0;
}
