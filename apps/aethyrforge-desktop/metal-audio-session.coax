// Observe source-node admission before a device or gesture starts.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../aethyr/host/audio-product-conformance.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<2{tool_errln("usage: metal-audio-session SDK OUTPUT [--product]");return 2;}sdk:=args_at(a[..],0);dir:=args_at(a[..],1);if !fs_mkdir(dir){return 1;}paths:[4][4096]u8;report:=fs_join(dir,"receipt.json",paths[0][..]);run:=[4]string.[fs_join(sdk,"MetalAudioSession",paths[1][..]),report,dir,fs_join(sdk,"libaudiofixture.dylib",paths[3][..])];count:=ifx args_has(a[..],"--product") then 4 else 2;out:[65536]u8;err:[65536]u8;r:=proc_run(run[0..<count],60000,out[..],err[..]);if !fs_write(fs_join(dir,"sdk.stderr",paths[2][..]),cast(string)err[0..<r.err_n])||r.started!=0||r.status!=0||r.cut||r.timed_out{tool_errln(cast(string)err[0..<r.err_n]);return 1;}
 raw:[4096]u8;n:=fs_read(report,raw[..]);doc:[1]Jv;nodes:[128]JvNode;if n<1||!jv_parse(doc[..],cast(string)raw[0..<n],nodes[..]){return 1;}ok:=true;for key:[4]string.["preFrames","preDeviceFrames","nonzero","status"]{ok=ok&&jv_int(doc[0],jv_get(doc[0],0,key),-1)==0;}
 if count==4 {list:=jv_get(doc[0],0,"observed");if jv_len(doc[0],list)!=32{return 1;}v:[32]int;for i:0..<32 {v[i]=jv_int(doc[0],jv_at(doc[0],list,i),-99);}q:=HostAudioProductObserved.{assets=v[0],words=v[1],control=v[2],pre_cue=v[3],pre_frames=v[4],pre_callbacks=v[5],covered_frames=v[6],covered_callbacks=v[7],started=v[8],running_frames=v[9],running_callbacks=v[10],cue=v[11],accepted=v[12],repeat_accepted=v[13],hidden_frames=v[14],hidden_callbacks=v[15],resumed_frames=v[16],resumed_callbacks=v[17],retired=v[18],retired_frames=v[19],late_frames=v[20],device_closed=v[21],context_closed=v[22],nonzero=v[23],bad_metadata=v[24],bad_source=v[25],remaining_assets=v[26],unavailable=v[27],remaining_cue=v[28],world_frames=v[29],drains=v[30],packet_refusals=v[31]};ok=ok&&hpa_accept(q);}
 print("Actual source callback admission, muted device clock and audio lifetime:%\n",ok);return ifx ok then 0 else 1;
}
