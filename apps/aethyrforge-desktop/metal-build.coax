mb_shaders :: (root:string,work:string,compiler:string)->bool {
 paths:[7][4096]u8;render:=fs_join(work,"render",paths[0][..]);if !fs_mkdir(render) {return false;}
 out:[4194304]u8;cmd:=[6]string.[fs_join(root,"coax/web/tool.sh",paths[1][..]),fs_join(root,"aethyr/render/build.coax",paths[2][..]),"everglade",render,"--coax",compiler];
 if mb_run(cmd[..],out[..])<0 {return false;}
 base:[262144]u8;n:=fs_read(fs_join(render,"render.json",paths[1][..]),base[..]);entries:[14]RenderPackageEntry;
 if n<1 {return false;}p:=render_package_parse(cast(string)base[0..<n],entries[..]);
