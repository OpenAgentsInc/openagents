  name:[64]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],"entry-");jo_int(w[..],i);jo_put(w[..],".metal");file:=jo_text(w[..]);path:=fs_join(render,file,paths[3][..]);
  shader_cmd:=[9]string.[compiler,"metal",fs_join(root,source,paths[4][..]),"--vertex",e.vertex,"--fragment",e.fragment,"-o",path];
  err:[65536]u8;r:=proc_run(shader_cmd[..],840000,out[..],err[..]);if r.started!=0 || r.status!=0 || r.timed_out || r.cut {tool_errln(cast(string)err[0..<r.err_n]);return false;}
  binding_name:[64]u8;b:[1]Jo;jo_start(b[..],binding_name[..]);jo_put(b[..],"entry-");jo_int(b[..],i);jo_put(b[..],".bindings");
  if !fs_write(fs_join(render,jo_text(b[..]),paths[5][..]),cast(string)err[0..<r.err_n]) {return false;}
  sn:=fs_read(path,out[..]);if sn<1 {return false;}jo_obj(o[..]);jo_key(o[..],"entry_index");jo_int(o[..],i);jo_key(o[..],"file");jo_str(o[..],file);mb_product_fields(o[..],"",out[0..<sn],"sha256");
  jo_key(o[..],"reflection_file");jo_str(o[..],jo_text(b[..]));mb_product_fields(o[..],"",err[0..<r.err_n],"reflection_sha256");jo_end(o[..]);
 }
 jo_end(o[..]);jo_end(o[..]);if o[0].bad {return false;}
 q:=metal_package_parse(jo_text(o[..]),p,base[0..<n]);return q.status==RenderPackageStatus.ok && fs_write(fs_join(render,"metal.json",paths[1][..]),jo_text(o[..]));
