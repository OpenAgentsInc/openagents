// Hash an existing product set after an isolated shader replacement, without
// rerunning unchanged shader emissions. The package authority still admits it.
mb_manifest :: (work:string)->bool {
 paths:[5][4096]u8;render:=fs_join(work,"render",paths[0][..]);base:[262144]u8;n:=fs_read(fs_join(render,"render.json",paths[1][..]),base[..]);entries:[14]RenderPackageEntry;
 if n<1 {return false;}p:=render_package_parse(cast(string)base[0..<n],entries[..]);
 if render_package_admit(p,2,RenderDeviceCapabilities.{backend=RenderBackend.metal,helper_enabled=true,int64_enabled=true})!=RenderPackageStatus.ok {return false;}
 manifest:[65536]u8;o:[1]Jo;jo_start(o[..],manifest[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.render.metal.v1");mb_product_fields(o[..],"",base[0..<n],"render_sha256");jo_key(o[..],"entries");jo_arr(o[..]);
 bytes:[4194304]u8;
 for i:0..<14 {if !p.entries[i].present {continue;}names:[2][64]u8;lengths:[2]int;for k:0..<2 {b:[1]Jo;jo_start(b[..],names[k][..]);jo_put(b[..],"entry-");jo_int(b[..],i);jo_put(b[..],ifx k==0 then ".metal" else ".bindings");lengths[k]=jo_text(b[..]).count;}
  a:=cast(string)names[0][0..<lengths[0]];b:=cast(string)names[1][0..<lengths[1]];
  sn:=fs_read(fs_join(render,a,paths[2][..]),bytes[..]);if sn<1 {return false;}jo_obj(o[..]);jo_key(o[..],"entry_index");jo_int(o[..],i);jo_key(o[..],"file");jo_str(o[..],a);mb_product_fields(o[..],"",bytes[0..<sn],"sha256");
  rn:=fs_read(fs_join(render,b,paths[3][..]),bytes[..]);if rn<1 {return false;}jo_key(o[..],"reflection_file");jo_str(o[..],b);mb_product_fields(o[..],"",bytes[0..<rn],"reflection_sha256");jo_end(o[..]);
 }
 jo_end(o[..]);jo_end(o[..]);return !o[0].bad&&metal_package_parse(jo_text(o[..]),p,base[0..<n]).status==RenderPackageStatus.ok&&fs_write(fs_join(render,"metal.json",paths[4][..]),jo_text(o[..]));
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<2 {tool_errln("usage: metal-build ROOT UNIT|shaders [--coax COMPILER] [--out DIRECTORY]");return 2;}
 root:=args_at(a[..],0);task:=args_at(a[..],1);paths:[2][4096]u8;work:=args_value(a[..],"--out",fs_join(root,"apps/aethyrforge-desktop/build/metal",paths[0][..]));
 compiler:=args_value(a[..],"--coax",fs_join(root,"coax/bin/coax",paths[1][..]));if !fs_mkdir(work) {return 1;}
 face_path:[4096]u8;face:=args_value(a[..],"--face",fs_join(root,"apps/openagents-web/everglade5e-face.c",face_path[..]));
 primary_path:[4096]u8;primary:=args_value(a[..],"--producer-object",fs_join(work,"everglade5e.o",primary_path[..]));
 if task=="instrument-render" {return ifx mb_instrument_render(work) then 0 else 1;}
 if task=="socket-sdk" {return ifx mb_socket_sdk(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="socket-probe" {return ifx mb_socket_probe(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="socket-library" {return ifx mb_socket_library(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="socket-test-trust" {return ifx mb_socket_test_trust(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="audio-packet" {return ifx mb_audio_packet(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="audio-session" {return ifx mb_audio_session(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="media-span" {return ifx mb_media_span(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="action-packet" {return ifx mb_action_packet(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="action-core" {return ifx mb_action_core(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 if task=="action-capacity" {return ifx mb_action_capacity(root,work) then 0 else 1;}
 if task=="audio-fixture" {return ifx mb_audio_fixture(root,work,args_has(a[..],"--sanitize")) then 0 else 1;}
 ok:=ifx task=="check-runner" then mb_check_runner() else ifx task=="manifest" then mb_manifest(work) else ifx task=="shaders" then mb_shaders(root,work,compiler) else ifx task=="generated" then mb_generated(work,args_value(a[..],"--generated","")) else ifx task=="producer" then mb_producer(root,work,face,primary,args_has(a[..],"--sanitize")) else ifx task=="fixture-producer" then mb_fixture(root,work,args_has(a[..],"--sanitize")) else ifx task=="conformance" then mb_conformance(root,work,args_has(a[..],"--sanitize")) else ifx task=="appkit" then mb_appkit(root,work) else ifx task=="effects" then mb_effects(root,work,args_has(a[..],"--sanitize")) else ifx task=="sdk" then mb_sdk(root,work,args_has(a[..],"--sanitize")) else mb_unit(root,work,compiler,task);
 return ifx ok then 0 else 1;
}
