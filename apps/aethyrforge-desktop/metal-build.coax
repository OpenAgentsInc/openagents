// Bounded native build slices. This tool never changes the qualified cache.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc-raw.coax";
#load "../../coax/lib/json/json.coax";
#load "../../aethyr/render/metal-package.coax";

mb_join :: (dir:string,name:string,out:[]u8)->string {return fs_join(dir,name,out);}
mb_run :: (argv:[]string,stdout:[]u8)->int {
 stderr:[65536]u8;env:[]string;r:=proc_run_bytes(argv,env,840000,stdout,stderr[..]);
 if r.started!=0 || r.status!=0 || r.timed_out || r.cut {tool_errln(cast(string)stderr[0..<r.err_n]);print("Metal build failed: started=% status=% timeout=% cut=% stdout=% stderr=%\n",r.started,r.status,r.timed_out,r.cut,r.out_n,r.err_n);return -1;}
 return r.out_n;
}
// Literal rig tables produce C lines longer than the text-process API's
// 64 KiB line bound. Generated code must retain every byte, including LF.
mb_check_runner :: ()->bool {
 line:[70001]u8;for i:0..<70000 {line[i]='a';}line[70000]='\n';
 out:[70001]u8;cmd:=[3]string.["/usr/bin/printf","%s",cast(string)line[..]];
 n:=mb_run(cmd[..],out[..]);return n==line.count && cast(string)out[..]==cast(string)line[..];
}
mb_unit :: (root:string,work:string,compiler:string,name:string)->bool {
 names:=[13]string.["everglade5e","Everglade-step","Grid","River","Guard-guide-policy","Everglade5e-rules","MetalRender","RenderTexture","fixture","AppKitInput","HostNetwork","entropy-policy","AudioFixture"];
 sources:=[13]string.["apps/aethyrforge-desktop/metal-world.coax","everglade/shared/everglade-step.coax","verse/grid.coax","verse/everglade/river.coax","everglade/npc/guard-guide-policy.coax","apps/openagents-web/everglade5e-rules.coax","apps/aethyrforge-desktop/metal-render.coax","aethyr/render/native-images.coax","aethyr/host/fixture.coax","aethyr/host/appkit-input.coax","aethyr/host/native-socket.coax","coax/lib/crypto/entropy.coax","aethyr/host/audio-fixture.coax"];
 found:=-1;for n,i:names {if n==name {found=i;}}if found<0 {return false;}
 text:[256]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_put(o[..],name);jo_put(o[..],".h");paths:[5][4096]u8;header:=fs_join(work,jo_text(o[..]),paths[0][..]);
 o[0]=Jo.{};jo_start(o[..],text[..]);jo_put(o[..],name);jo_put(o[..],".c");code:=fs_join(work,jo_text(o[..]),paths[1][..]);
 o[0]=Jo.{};jo_start(o[..],text[..]);jo_put(o[..],name);jo_put(o[..],".o");object:=fs_join(work,jo_text(o[..]),paths[2][..]);
 out:[67108864]u8;cmd:=[8]string.[compiler,"c",fs_join(root,sources[found],paths[3][..]),"--library","--run-steps","128000","--header",header];
 if name=="Everglade-step" || name=="Guard-guide-policy" {
  // These names remain compatibility headers/objects. The producer's graph
  // owns their exported definitions once, alongside replay's shared hashes.
  if !fs_write(header,"#include \"everglade5e.h\"\n") || !fs_write(code,"/* definitions are owned by everglade5e.o */\n") {return false;}
 } else {
  n:=mb_run(cmd[..],out[..]);if n<0 || !fs_write(code,cast(string)out[0..<n]) {return false;}
 }
 cc:=[11]string.["/usr/bin/clang","-std=c11","-O2","-ffp-contract=off","-fno-fast-math","-Wno-unused-function","-Wno-unused-variable","-c",code,"-o",object];
 return mb_run(cc[..],out[..])>=0;
}
mb_producer :: (root:string,work:string,face:string,primary:string,sanitize:bool)->bool {
 paths:[10][4096]u8;out:[1048576]u8;
 bridge:=fs_join(work,"producer-face.o",paths[0][..]);
 cc:=[14]string.["/usr/bin/clang","-std=gnu11","-O2","-ffp-contract=off","-fno-fast-math","-DCOAXIAL_NATIVE_ADDRESS","-Wno-unknown-attributes",ifx sanitize then "-fsanitize=address" else "-g0","-I",work,"-c",face,"-o",bridge];
 if mb_run(cc[..],out[..])<0 {return false;}
 link:=[14]string.["/usr/bin/clang","-dynamiclib",ifx sanitize then "-fsanitize=address" else "-g0","-Wl,-undefined,dynamic_lookup","-Wl,-install_name,@rpath/libeverglade.dylib",
 primary,fs_join(work,"Everglade-step.o",paths[2][..]),fs_join(work,"Grid.o",paths[3][..]),fs_join(work,"River.o",paths[4][..]),fs_join(work,"Guard-guide-policy.o",paths[5][..]),fs_join(work,"Everglade5e-rules.o",paths[6][..]),bridge,"-o",fs_join(work,"libeverglade.dylib",paths[7][..])];
 return mb_run(link[..],out[..])>=0;
}
mb_sdk :: (root:string,work:string,sanitize:bool)->bool {
 paths:[2][4096]u8;out:[1048576]u8;
 cc:=[12]string.["/usr/bin/clang","-fobjc-arc","-O2","-ffp-contract=off","-fno-fast-math",ifx sanitize then "-fsanitize=address" else "-g0","-I",work,"-c",fs_join(root,"apps/aethyrforge-desktop/MetalRealm.m",paths[0][..]),"-o",fs_join(work,"MetalRealm.o",paths[1][..])];
 return mb_run(cc[..],out[..])>=0;
}
mb_socket_sdk :: (root:string,work:string,sanitize:bool)->bool {
 paths:[4][4096]u8;out:[1048576]u8;
 for source,i:[7]string.["HostNetwork.c","entropy-policy.c","apps/aethyrforge-desktop/MetalSockets.c","coax/platform/socket-native.c","coax/platform/tls-native.c","coax/platform/entropy-native.c","coax/platform/entropy-foreign.c"] {
  object:=[7]string.["HostNetwork.o","entropy-policy.o","MetalSockets.o","socket-native.o","tls-native.o","entropy-native.o","entropy-foreign.o"];
  cmd:=[16]string.["/usr/bin/clang","-std=gnu11","-O2","-ffp-contract=off","-fno-fast-math","-fblocks",ifx sanitize then "-fsanitize=address" else "-g0","-I",work,"-I",fs_join(root,"coax/platform",paths[0][..]),"-c",fs_join(ifx i<2 then work else root,source,paths[1][..]),"-o",fs_join(work,object[i],paths[2][..]),"-Wno-unused-function"];
  if mb_run(cmd[..],out[..])<0 {return false;}
 }return true;
}
mb_socket_probe :: (root:string,work:string,sanitize:bool)->bool {
 paths:[11][4096]u8;out:[1048576]u8;cmd:[40]string;n:=0;
 for arg:[8]string.["xcrun","swiftc","-O","-parse-as-library","-target","arm64-apple-macos26.0","-import-objc-header",fs_join(root,"apps/aethyrforge-desktop/metal-sockets.h",paths[0][..])] {cmd[n]=arg;n+=1;}
 if sanitize {cmd[n]="-sanitize=address";n+=1;}
 cmd[n]=fs_join(root,"apps/aethyrforge-desktop/tests/MetalSocketEffects.swift",paths[1][..]);n+=1;
 for object,i:[7]string.["HostNetwork.o","entropy-policy.o","MetalSockets.o","socket-native.o","tls-native.o","entropy-native.o","entropy-foreign.o"] {cmd[n]=fs_join(work,object,paths[2+i][..]);n+=1;}
 for name:[3]string.["Network","Security","CoreFoundation"] {cmd[n]="-framework";cmd[n+1]=name;n+=2;}
 cmd[n]="-o";cmd[n+1]=fs_join(work,"MetalSocketEffects",paths[9][..]);n+=2;return mb_run(cmd[0..<n],out[..])>=0;
}
mb_socket_library :: (root:string,work:string,sanitize:bool)->bool {
 if !mb_socket_sdk(root,work,sanitize) {return false;}return mb_socket_link(work,sanitize);
}
mb_socket_link :: (work:string,sanitize:bool)->bool {
 paths:[8][4096]u8;out:[1048576]u8;cmd:[24]string;n:=0;
 for arg:[4]string.["/usr/bin/clang","-dynamiclib","-Wl,-install_name,@rpath/libnetwork.dylib",ifx sanitize then "-fsanitize=address" else "-g0"] {cmd[n]=arg;n+=1;}
 for object,i:[7]string.["HostNetwork.o","entropy-policy.o","MetalSockets.o","socket-native.o","tls-native.o","entropy-native.o","entropy-foreign.o"] {cmd[n]=fs_join(work,object,paths[i][..]);n+=1;}
 for name:[3]string.["Network","Security","CoreFoundation"] {cmd[n]="-framework";cmd[n+1]=name;n+=2;}
 cmd[n]="-o";cmd[n+1]=fs_join(work,"libnetwork.dylib",paths[7][..]);n+=2;return mb_run(cmd[0..<n],out[..])>=0;
}
// Test-only certificate anchors are compiled into a separate SDK directory.
// Ordinary socket-library never calls this task or changes platform trust.
mb_socket_test_trust :: (root:string,work:string,sanitize:bool)->bool {
 paths:[3][4096]u8;out:[1048576]u8;
 cmd:=[17]string.["/usr/bin/clang","-std=gnu11","-O2","-ffp-contract=off","-fno-fast-math","-fblocks","-DCXTLS_TEST_TRUST",ifx sanitize then "-fsanitize=address" else "-g0","-I",fs_join(root,"coax/platform",paths[0][..]),"-c",fs_join(root,"coax/platform/tls-native.c",paths[1][..]),"-o",fs_join(work,"tls-native.o",paths[2][..]),"-Wno-unused-function","-Wno-unused-variable","-Wno-unused-parameter"];
 return mb_run(cmd[..],out[..])>=0&&mb_socket_link(work,sanitize);
}
mb_generated :: (work:string,source:string)->bool {
