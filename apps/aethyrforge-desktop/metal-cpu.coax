// The native-width producer and the actual browser Wasm receive the same
// existing deterministic host workload. Compare all handed-off CPU bytes.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
mcp_word :: (a:u32,b:u32)->bool {
 if a==b {return true;}if (a&0x7f800000)==0x7f800000 || (b&0x7f800000)==0x7f800000 {return false;}x:=f64(f32_from_bits(a));y:=f64(f32_from_bits(b));scale:=ifx abs(x)>abs(y) then abs(x) else abs(y);d:=abs(x-y);return d<=0.000001 || d<=scale*0.000001;
}
#test "native CPU comparison preserves exact words and admits only the existing libm rounding bound" {
 #assert mcp_word(0x7fc00001,0x7fc00001) && mcp_word(0,0x80000000);
 #assert mcp_word(f32_bits(1.0f32),f32_bits(1.0000001f32));
 #assert !mcp_word(f32_bits(1.0f32),f32_bits(1.01f32));
 #assert !mcp_word(0x7fc00001,0x7fc00002) && !mcp_word(0x7f800000,0x7f800001);
}
mcp_run :: (argv:[]string)->bool {out:[1048576]u8;err:[65536]u8;r:=proc_run(argv,120000,out[..],err[..]);if r.started!=0 || r.status!=0 || r.cut || r.timed_out {tool_errln(cast(string)out[0..<r.out_n]);tool_errln(cast(string)err[0..<r.err_n]);return false;}print("%",cast(string)out[0..<r.out_n]);return true;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<4 {tool_errln("usage: metal-cpu ROOT RESOURCES ENGINE.WASM OUTPUT [--producer LIBRARY] [--existing-wasm]");return 2;}
 root:=args_at(a[..],0);res:=args_at(a[..],1);wasm:=args_at(a[..],2);dir:=args_at(a[..],3);paths:[12][4096]u8;native:=fs_join(dir,"native",paths[0][..]);web:=fs_join(dir,"wasm",paths[1][..]);if !fs_mkdir(native) || !fs_mkdir(web) {return 1;}
 facts:=fs_join(root,"verse/native/everglade.facts",paths[2][..]);pack:=fs_join(res,"web/realms/everglade/assets/everglade.pack",paths[3][..]);
 browser:=[20]string.[fs_join(root,"coax/web/tool.sh",paths[4][..]),fs_join(root,"verse/native/wasm-run.coax",paths[5][..]),wasm,"--frames","90","--every","90","--size","320x180","--golden","--pack",pack,"--facts",facts,"--extra","1","--dump",web,"--state-dump",web];if !args_has(a[..],"--existing-wasm") && !mcp_run(browser[..]) {return 1;}
 bytes:[65536]u8;fn:=fs_read(facts,bytes[..]);if fn<1 {return 1;}while fn>0 && bytes[fn-1]=='\n' {fn-=1;}
 plan:[65536]u8;o:[1]Jo;jo_start(o[..],plan[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.metal.effects.v1");jo_key(o[..],"golden");jo_bool(o[..],true);jo_key(o[..],"operations");jo_arr(o[..]);
 jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"message");jo_key(o[..],"kind");jo_int(o[..],600);jo_key(o[..],"text");jo_str(o[..],cast(string)bytes[0..<fn]);jo_end(o[..]);
 jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"message");jo_key(o[..],"kind");jo_int(o[..],606);jo_key(o[..],"text");jo_str(o[..],"");jo_end(o[..]);
 for i:0..<90 {jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"frame");for key,k:[4]string.["width","height","scale","dt"] {jo_key(o[..],key);if k==3 {jo_raw(o[..],"0.016666666666666666");}else {jo_int(o[..],ifx k==0 then 320 else ifx k==1 then 180 else 1);}}jo_end(o[..]);}
 jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"dump");jo_key(o[..],"file");jo_str(o[..],native);jo_end(o[..]);
 image_path:[4096]u8;jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"snapshot");jo_key(o[..],"file");jo_str(o[..],fs_join(native,"frame.f32",image_path[..]));jo_end(o[..]);
 jo_end(o[..]);jo_end(o[..]);input:=fs_join(dir,"plan.json",paths[6][..]);if o[0].bad || !fs_write(input,jo_text(o[..])) {return 1;}
 producer:=args_value(a[..],"--producer",fs_join(res,"metal/libeverglade.dylib",paths[8][..]));run:=[5]string.[fs_join(root,"apps/aethyrforge-desktop/build/metal/MetalEffects",paths[7][..]),res,producer,input,fs_join(dir,"metal.json",paths[9][..])];if !mcp_run(run[..]) {return 1;}
 left:[8388608]u8;right:[8388608]u8;total:=0;different:=0;
 for name:[8]string.["u.bin","hud.bin","draws.bin","s0.bin","s1.bin","s2.bin","s3.bin","puffs.bin"] {ln:=fs_read(fs_join(native,name,paths[10][..]),left[..]);rn:=fs_read(fs_join(web,name,paths[11][..]),right[..]);if ln<0 || rn!=ln || ln%4!=0 {tool_errln("Native/Wasm byte extent differs: ");tool_errln(name);return 1;}for i:0..<ln/4 {at:=i*4;x:=u32(left[at])|(u32(left[at+1])<<8)|(u32(left[at+2])<<16)|(u32(left[at+3])<<24);y:=u32(right[at])|(u32(right[at+1])<<8)|(u32(right[at+2])<<16)|(u32(right[at+3])<<24);if x!=y {different+=1;}if !mcp_word(x,y) {print("Native/Wasm % word%: nativebits% Wasmbits%\n",name,i,x,y);return 1;}}total+=ln;}
 print("Native/Wasm CPU: % bytes across8 complete producer buffers, % words differ, none beyond the existing1e-6 libm bound\n",total,different);return 0;
}
