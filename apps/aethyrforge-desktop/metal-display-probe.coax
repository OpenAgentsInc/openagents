// Run the independent finite-HALF display fixture through the real Metal SDK.
// This consumes frozen private products and never changes the ordinary app.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/crypto/sha256-kernel.coax";
mdp_string :: (o:[]Jo,key:string,value:string) {jo_key(o,key);jo_str(o,value);}
mdp_hash :: (o:[]Jo,key:string,bytes:[]u8) {hash:[64]u8;ok:=S_hex(S_hash(cast(string)bytes),hash[..]);mdp_string(o,key,ifx ok then cast(string)hash[..] else "");}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<5 {tool_errln("usage: metal-display-probe ROOT RESOURCES EFFECTS FIXTURE_DIR NEW_OUTPUT [--rgba8] [--legacy]");return 2;}
 root:=args_at(a[..],0);res:=args_at(a[..],1);effects:=args_at(a[..],2);fixture:=args_at(a[..],3);dir:=args_at(a[..],4);if !fs_mkdir(dir) {return 1;}
 paths:[10][4096]u8;text:[32768]u8;n:=fs_read(fs_join(fixture,"plan.json",paths[0][..]),text[..]);d:[1]Jv;nodes:[512]JvNode;
 if n<1||!jv_parse(d[..],cast(string)text[0..<n],nodes[..]) {return 1;}width:=jv_int(d[0],jv_get(d[0],0,"width"),0);height:=jv_int(d[0],jv_get(d[0],0,"height"),0);
 source:=fs_join(fixture,"source.rgba16f",paths[1][..]);expected:=fs_join(fixture,"expected.rgba8",paths[2][..]);raw:=fs_join(dir,"display.raw",paths[3][..]);report:=fs_join(dir,"sdk.json",paths[4][..]);
 format:=ifx args_has(a[..],"--rgba8") then 0 else 1;legacy:=args_has(a[..],"--legacy");
 plan:[32768]u8;o:[1]Jo;jo_start(o[..],plan[..]);jo_obj(o[..]);mdp_string(o[..],"schema","aethyr.metal.effects.v1");jo_key(o[..],"operations");jo_arr(o[..]);
 jo_obj(o[..]);mdp_string(o[..],"op","present-probe");mdp_string(o[..],"file",source);for name,k:[3]string.["width","height","format"] {jo_key(o[..],name);jo_int(o[..],ifx k==0 then width else ifx k==1 then height else format);}jo_key(o[..],"quantized");jo_bool(o[..],!legacy);jo_end(o[..]);
 jo_obj(o[..]);mdp_string(o[..],"op","presented-raw");mdp_string(o[..],"file",raw);jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);input:=fs_join(dir,"plan.json",paths[5][..]);if o[0].bad||!fs_write(input,jo_text(o[..])) {return 1;}
 stdout:[1048576]u8;stderr:[65536]u8;run:=[5]string.[effects,res,fs_join(res,"metal/libeverglade.dylib",paths[6][..]),input,report];r:=proc_run(run[..],60000,stdout[..],stderr[..]);
 if !fs_write(fs_join(dir,"sdk-stdout.txt",paths[7][..]),cast(string)stdout[0..<r.out_n])||!fs_write(fs_join(dir,"sdk-stderr.txt",paths[8][..]),cast(string)stderr[0..<r.err_n]) {return 1;}
 if r.started!=0||r.status!=0||r.cut||r.timed_out {tool_errln(cast(string)stderr[0..<r.err_n]);return 1;}
 left:[4194304]u8;right:[4194304]u8;ln:=fs_read(expected,left[..]);rn:=fs_read(raw,right[..]);if width<1||height<1||width>1024||height>1024||ln!=width*height*4||rn!=ln {return 1;}
 different:=0;for i:0..<ln {lane:=i%4;at:=ifx format==1&&(lane==0||lane==2) then i+2-2*lane else i;if left[i]!=right[at] {different+=1;}}
 sn:=fs_read(report,text[..]);if sn<1||!jv_parse(d[..],cast(string)text[0..<sn],nodes[..]) {return 1;}
 quiet:=true;for name,k:[5]string.["frames","completed","pending","closedLedgerLive","closedLedgerWords"] {if jv_int(d[0],jv_get(d[0],0,name),-1)!=(ifx k==1 then 1 else 0) {quiet=false;}}
 receipt:[32768]u8;jo_start(o[..],receipt[..]);jo_obj(o[..]);mdp_string(o[..],"schema","aethyr.render.metal-display-probe.v1");jo_key(o[..],"private_iteration_only");jo_bool(o[..],true);mdp_string(o[..],"status",ifx different==0&&quiet then "pass" else "fail");mdp_string(o[..],"format",ifx format==1 then "bgra8unorm" else "rgba8unorm");jo_key(o[..],"quantized");jo_bool(o[..],!legacy);jo_key(o[..],"channels");jo_int(o[..],ln);jo_key(o[..],"different");jo_int(o[..],different);jo_key(o[..],"no_producer_and_closed");jo_bool(o[..],quiet);mdp_hash(o[..],"expected_rgba8_sha256",left[0..<ln]);mdp_hash(o[..],"actual_native_order_sha256",right[0..<rn]);jo_end(o[..]);
 if o[0].bad||!fs_write(fs_join(dir,"comparison.json",paths[9][..]),jo_text(o[..])) {return 1;}print("Metal display probe: %/% different bytes, producer quiet and closed:%\n",different,ln,quiet);return ifx different==0&&quiet then 0 else 1;
}
