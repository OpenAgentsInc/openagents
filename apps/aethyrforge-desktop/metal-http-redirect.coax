// Coax-authored physical peer workload through the actual Metal HTTP adapter.
#import "Basic";
#load "../../metaverse-engine/host/tests/http-redirect-peer.coax";
#load "../../metaverse-engine/host/http-redirect-conformance.coax";
#load "../../metaverse-engine/host/fixture.coax";
#test "physical Metal redirect paths and header values are literal" {
 b:[128]u8;#assert mhd_path(308,2,1,b[..])=="/r/308/2/1"&&mhd_label(45,b[..])=="reply-45";
 #assert mhd_header("POST / HTTP/1.1\r\naUtHoRiZaTiOn: Test fixture\r\nX-Verse-Player: fixture-player\r\n\r\n","authorization")=="Test fixture";
 #assert mhd_header("GET / HTTP/1.1\r\n\r\n","authorization")=="";
}
#test "native callback observer requires whole failure shape and payload identity" {
 d:[1]Jv;nodes:[128]JvNode;
 #assert jv_parse(d[..],"[[4,512,0,0,0,0,2,669875135]]",nodes[..])&&mhd_reply(d[0],0,"0\n",1);
 #assert !mhd_reply(d[0],0,"0\n",3)&&!mhd_reply(d[0],0,"1\n",1);
 #assert jv_parse(d[..],"[[4,512,0,0,0,0,2,669875135],[4,512,0,0,0,0,2,669875135]]",nodes[..])&&!mhd_reply(d[0],0,"0\n",1);
 #assert jv_parse(d[..],"[[4,513,0,0,0,0,2,669875135]]",nodes[..])&&!mhd_reply(d[0],0,"0\n",1);
}
mhd_path :: (status:int,target:int,post:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"/r/");jo_int(o[..],status);jo_put(o[..],"/");jo_int(o[..],target);jo_put(o[..],"/");jo_int(o[..],post);return jo_text(o[..]);}
mhd_header :: (head:string,key:string)->string {
 at:=0;while at<head.count {end:=rtq_find(head,"\r\n",at);if end<0{return "";}line:=head[at..<end];colon:=rtq_find(line,":",0);same:=colon==key.count;for i:0..<key.count{if i>=colon||rto_lower(line[i])!=rto_lower(key[i]){same=false;}}if same{return rto_trim(line[colon+1..<line.count]);}at=end+2;}return "";
}
mhd_label :: (i:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_put(o[..],"reply-");jo_int(o[..],i);return jo_text(o[..]);}
mhd_reply :: (d:Jv,rows:int,text:string,expected:int)->bool {row:=jv_at(d,rows,expected-1);return jv_len(d,rows)==expected&&jv_int(d,jv_at(d,row,0),-1)==4&&jv_int(d,jv_at(d,row,1),-1)==512&&jv_int(d,jv_at(d,row,6),-1)==text.count&&jv_int(d,jv_at(d,row,7),-1)==int(hf_hash(text));}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]){return 2;}
 if args_at(a[..],0)=="--peer" {if args_count(a[..])!=5{return 2;}return hdr_peer(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3),args_at(a[..],4));}
 if args_count(a[..])<4 {tool_errln("usage: metal-http-redirect ROOT RESOURCES SDK NEW_OUT [--existing]");return 2;}
 root:=args_at(a[..],0);resources:=args_at(a[..],1);sdk:=args_at(a[..],2);dir:=args_at(a[..],3);if !fs_mkdir(dir){return 1;}paths:[10][4096]u8;self:[4096]u8;image:=gp_self(self[..]);peerfile:=fs_join(dir,"peer.json",paths[0][..]);portfile:=fs_join(dir,"port.json",paths[1][..]);plan:=fs_join(dir,"plan.json",paths[2][..]);result:=fs_join(dir,"sdk.json",paths[3][..]);driver:=fs_join(sdk,"HostEffects",paths[4][..]);fixture:=fs_join(sdk,"libfixture.dylib",paths[5][..]);
 inputs:[1]RtqInputs;for file:[8]string.[image,driver,fixture,"apps/aethyrforge-desktop/Sources/MetalNetwork.swift","apps/aethyrforge-desktop/MetalRealm.m","apps/aethyrforge-desktop/tests/MetalConformance.swift","metaverse-engine/host/http-redirect.coax","metaverse-engine/host/http-redirect-conformance.coax"]{if !rtq_input_add(inputs[..],file){return 1;}}
 existing:=args_has(a[..],"--existing");p:=-1;defer{if p>=0{k:=proc_kill(p,PROC_SIGTERM);w:=proc_wait(p,1000);freed:=proc_release(p);}}
 if !existing {
  p=proc_new();if p<0{return 1;}for arg:[6]string.[image,"--peer",root,dir,portfile,peerfile]{if !proc_arg(p,arg){return 1;}}if proc_start(p)!=0{return 1;}
  bytes:[262144]u8;nodes:[32768]JvNode;d:[1]Jv;port:=-1;deadline:=proc_now_ms()+10000;
  while proc_now_ms()<deadline{n:=fs_read(portfile,bytes[..]);if n>0&&jv_parse(d[..],cast(string)bytes[0..<n],nodes[..]){port=jv_int(d[0],jv_at(d[0],0,0),-1);break;}proc_sleep(20);}if port<1{return 1;}
  raw:[65536]u8;o:[1]Jo;jo_start(o[..],raw[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.effects.v1");jo_key(o[..],"scope");jo_str(o[..],"http-redirect");jo_key(o[..],"player");jo_str(o[..],"fixture-player");jo_key(o[..],"origin");origin:[128]u8;u:[1]Jo;jo_start(u[..],origin[..]);jo_put(u[..],"http://127.0.0.1:");jo_int(u[..],port);jo_str(o[..],jo_text(u[..]));jo_key(o[..],"operations");jo_arr(o[..]);statuses:=[5]int.[301,302,303,307,308];
  for i:0..<46 {
   path:[128]u8;host:=i<15;post:=i>=15&&i<45&&(i-15)%2==1;uri:=ifx i==45 then "/ok" else mhd_path(statuses[ifx host then i/3 else (i-15)/6],ifx host then i%3 else ((i-15)/2)%3,ifx post then 1 else 0,path[..]);
   jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"reset");jo_end(o[..]);jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],ifx host then "message" else "http");
   if host{jo_key(o[..],"kind");jo_int(o[..],920);jo_key(o[..],"text");jo_str(o[..],uri);}else{jo_key(o[..],"path");jo_str(o[..],uri);jo_key(o[..],"body");jo_str(o[..],ifx post then "Test fixture\n{\"x\":1}" else "");jo_key(o[..],"flags");jo_int(o[..],ifx post then 29 else 4);jo_key(o[..],"timeout");jo_int(o[..],2000);}jo_end(o[..]);
   jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"wait");jo_key(o[..],"ms");jo_int(o[..],250);jo_end(o[..]);label:[64]u8;jo_obj(o[..]);jo_key(o[..],"op");jo_str(o[..],"observe");jo_key(o[..],"name");jo_str(o[..],mhd_label(i,label[..]));jo_end(o[..]);
  }
  jo_end(o[..]);jo_end(o[..]);if o[0].bad||!fs_write(plan,jo_text(o[..])){return 1;}
  argv:=[5]string.[driver,resources,fixture,plan,result];env:[]string;stdout:[65536]u8;stderr:[65536]u8;r:=rtq_command(argv[..],env,proc_now_ms()+60000,dir,"driver",stdout[..],stderr[..]);if !rtq_ok(r){return 1;}
  if !rto_get(port,"/finish")||proc_wait(p,5000)!=0{return 1;}
 }
 bytes:[262144]u8;nodes:[32768]JvNode;d:[1]Jv;if !rtq_json_file(peerfile,bytes[..],nodes[..],d[..]){return 1;}peer:=d[0];requests:=jv_get(peer,0,"requests");if jv_len(peer,requests)!=45{return 1;}q:[13]int;host_good:[15]bool;statuses:=[5]int.[301,302,303,307,308];
 for i:0..<45 {
  row:=jv_at(peer,requests,i);host:=i<15;post:=!host&&(i-15)%2==1;path:[128]u8;status:=statuses[ifx host then i/3 else (i-15)/6];uri:=mhd_path(status,ifx host then i%3 else ((i-15)/2)%3,ifx post then 1 else 0,path[..]);same:=jv_raw(peer,jv_get(peer,row,"path"))==uri&&jv_raw(peer,jv_get(peer,row,"method"))==(ifx post then "POST" else "GET")&&jv_int(peer,jv_get(peer,row,"status"),-1)==status;
  if host{host_good[i]=same;continue;}if same{q[1]+=1;}headers:[16384]u8;payload:[512]u8;head:=rto_string(peer,jv_get(peer,row,"head"),headers[..]);body:=rto_string(peer,jv_get(peer,row,"body"),payload[..]);auth:=mhd_header(head,"authorization");player:=mhd_header(head,"x-verse-player");if post{if auth=="Test fixture"{q[3]+=1;}if player=="fixture-player"{q[4]+=1;}if body=="{\"x\":1}"{q[5]+=1;}}else if auth==""&&player==""&&body==""{q[6]+=1;}
 }
 q[7]=jv_int(peer,jv_get(peer,0,"landings"),-1);q[8]=jv_int(peer,jv_get(peer,0,"foreign"),-1);q[11]=ifx jv_bool(peer,jv_get(peer,0,"finished")) then 1 else 0;
 if !rtq_json_file(result,bytes[..],nodes[..],d[..]){return 1;}sdk_doc:=d[0];for i:0..<45{label:[64]u8;rows:=jv_get(sdk_doc,0,mhd_label(i,label[..]));if mhd_reply(sdk_doc,rows,"0\n",ifx i<15 then 3 else 1){if i<15{if host_good[i]{q[2]+=1;}}else{q[0]+=1;}}}
 policy:=jv_get(sdk_doc,0,"httpPolicy");ids:=jv_get(sdk_doc,0,"httpRequests");admitted:=jv_len(sdk_doc,ids)==31;for i:0..<jv_len(sdk_doc,ids){if jv_int(sdk_doc,jv_at(sdk_doc,ids,i),-1)!=0{admitted=false;}}
 q[9]=ifx mhd_reply(sdk_doc,jv_get(sdk_doc,0,"reply-45"),"200\nok",1)&&jv_len(sdk_doc,policy)==3&&!jv_bool(sdk_doc,jv_at(sdk_doc,policy,0))&&!jv_bool(sdk_doc,jv_at(sdk_doc,policy,1))&&jv_bool(sdk_doc,jv_at(sdk_doc,policy,2))&&admitted then 1 else 0;q[10]=ifx jv_int(sdk_doc,jv_get(sdk_doc,0,"dropped"),-1)==0 then 1 else 0;q[12]=ifx rtq_inputs_match(inputs[..]) then 1 else 0;
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.http-redirect.v1");jo_key(o[..],"host");jo_str(o[..],"metal");jo_key(o[..],"observations");jo_arr(o[..]);for value:q{jo_int(o[..],value);}jo_end(o[..]);jo_key(o[..],"passed");jo_bool(o[..],hhrc_accept(q[..]));jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);if o[0].bad||!fs_write(fs_join(dir,"receipt.json",paths[6][..]),jo_text(o[..])){return 1;}print("Actual Metal redirect observations:%\n",hhrc_accept(q[..]));return ifx hhrc_accept(q[..]) then 0 else 1;
