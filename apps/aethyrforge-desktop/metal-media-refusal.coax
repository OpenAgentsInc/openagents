// Exercise the real native per-image refusal, notice and recovery effects.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../aethyr/render/host-image.coax";
mrf_names :: [7]string.["meteor-swarm-48.jpg","thunderbolt-48.jpg","mega-thunderbolt-48.jpg","water-orb-48.jpg","reverse-gravity-48.jpg","wind-wall-48.jpg","next-row-48.jpg"];
mrf_str :: (o:[]Jo,key:string,value:string) {jo_key(o,key);jo_str(o,value);}
mrf_run :: (argv:[]string,dir:string,label:string)->bool {out:[1048576]u8;err:[65536]u8;r:=proc_run(argv,60000,out[..],err[..]);names:[2][128]u8;paths:[2][4096]u8;for i:0..<2 {o:[1]Jo;jo_start(o[..],names[i][..]);jo_put(o[..],label);jo_put(o[..],ifx i==0 then ".stdout" else ".stderr");if !fs_write(fs_join(dir,jo_text(o[..]),paths[i][..]),ifx i==0 then cast(string)out[0..<r.out_n] else cast(string)err[0..<r.err_n]) {return false;}}if r.started!=0||r.status!=0||r.cut||r.timed_out {tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<4 {tool_errln("usage: metal-media-refusal ROOT RESOURCES EFFECTS NEW_OUTPUT [--missing] [--late-invalid]");return 2;}
 root:=args_at(a[..],0);res:=args_at(a[..],1);effects:=args_at(a[..],2);dir:=args_at(a[..],3);paths:[12][4096]u8;if !fs_mkdir(dir) {return 1;}
 fixture:=fs_join(dir,"resources",paths[0][..]);for part:[6]string.["resources","resources/web","resources/web/realms","resources/web/realms/everglade","resources/web/realms/everglade/hotbar","resources/web/realms/everglade/assets"] {if !fs_mkdir(fs_join(dir,part,paths[1][..])) {return 1;}}
 link:=[4]string.["/bin/ln","-s",fs_join(res,"metal",paths[1][..]),fs_join(fixture,"metal",paths[2][..])];if !mrf_run(link[..],dir,"link-metal") {return 1;}
 link=[4]string.["/bin/ln","-s",fs_join(res,"web/realms/everglade/assets/everglade.pack",paths[1][..]),fs_join(fixture,"web/realms/everglade/assets/everglade.pack",paths[2][..])];if !mrf_run(link[..],dir,"link-pack") {return 1;}
 bytes:[65536]u8;source:=fs_join(res,"web/realms/everglade/hotbar",paths[3][..]);target:=fs_join(fixture,"web/realms/everglade/hotbar",paths[4][..]);missing:=args_has(a[..],"--missing");late:=args_has(a[..],"--late-invalid");
 for name,i:mrf_names {if i==0&&missing {continue;}n:=fs_read(fs_join(source,name,paths[5][..]),bytes[..]);if n<1 {return 1;}if i==0 {if late {n=PNG_BAD_FILTER5.count;for b,k:PNG_BAD_FILTER5 {bytes[k]=b;}}else {n=2;bytes[0]=0;bytes[1]=0;}}if !fs_write(fs_join(target,name,paths[5][..]),cast(string)bytes[0..<n]) {return 1;}}
 facts:[65536]u8;fn:=fs_read(fs_join(root,"verse/native/everglade.facts",paths[5][..]),facts[..]);if fn<1 {return 1;}while fn>0&&facts[fn-1]=='\n' {fn-=1;}
 plan:[32768]u8;o:[1]Jo;jo_start(o[..],plan[..]);jo_obj(o[..]);mrf_str(o[..],"schema","aethyr.metal.effects.v1");jo_key(o[..],"golden");jo_bool(o[..],true);jo_key(o[..],"operations");jo_arr(o[..]);for kind:[2]int.[600,606] {jo_obj(o[..]);mrf_str(o[..],"op","message");jo_key(o[..],"kind");jo_int(o[..],kind);mrf_str(o[..],"text",ifx kind==600 then cast(string)facts[0..<fn] else "");jo_end(o[..]);}
 urls:[7][256]u8;lengths:[7]int;expected:[4096]u8;e:[1]Jo;jo_start(e[..],expected[..]);for name,i:mrf_names {u:[1]Jo;jo_start(u[..],urls[i][..]);jo_put(u[..],"/worlds/everglade/hotbar/");jo_put(u[..],name);lengths[i]=jo_text(u[..]).count;if i>0 {jo_put(e[..],"\n");}jo_put(e[..],jo_text(u[..]));jo_put(e[..],ifx i==0 then " 0 0" else " 48 48");}
 for phase:0..<2 {if phase==1 {jo_obj(o[..]);mrf_str(o[..],"op","recover");jo_end(o[..]);}for frame:0..<3 {jo_obj(o[..]);mrf_str(o[..],"op","frame");for key,k:[4]string.["width","height","scale","dt"] {jo_key(o[..],key);if k==3 {jo_raw(o[..],"0.016666666666666666");}else {jo_int(o[..],ifx k==0 then 320 else ifx k==1 then 180 else 1);}}jo_end(o[..]);}
  jo_obj(o[..]);mrf_str(o[..],"op","media-state");mrf_str(o[..],"file",fs_join(dir,ifx phase==0 then "state.json" else "recovered-state.json",paths[5][..]));jo_key(o[..],"urls");jo_arr(o[..]);for i:0..<7 {jo_str(o[..],cast(string)urls[i][0..<lengths[i]]);}jo_end(o[..]);jo_end(o[..]);jo_obj(o[..]);mrf_str(o[..],"op","media-notice");mrf_str(o[..],"file",fs_join(dir,ifx phase==0 then "notice.txt" else "recovered-notice.txt",paths[5][..]));jo_end(o[..]);
  jo_obj(o[..]);mrf_str(o[..],"op","media-ownership");jo_end(o[..]);
 }
 jo_end(o[..]);jo_end(o[..]);input:=fs_join(dir,"plan.json",paths[6][..]);report:=fs_join(dir,"sdk.json",paths[7][..]);if o[0].bad||e[0].bad||!fs_write(input,jo_text(o[..])) {return 1;}run:=[5]string.[effects,fixture,fs_join(res,"metal/libeverglade.dylib",paths[8][..]),input,report];if !mrf_run(run[..],dir,"sdk") {return 1;}
 d:[1]Jv;nodes:[512]JvNode;for phase:0..<2 {n:=fs_read(fs_join(dir,ifx phase==0 then "state.json" else "recovered-state.json",paths[9][..]),bytes[..]);if n<1||!jv_parse(d[..],cast(string)bytes[0..<n],nodes[..])||jv_at(d[0],0,7)!= -1 {return 1;}for i:0..<7 {row:=jv_at(d[0],0,i);if row<0||jv_at(d[0],row,5)!= -1 {return 1;}for k:0..<5 {want:=ifx k==0 then 1 else ifx k==1 then (ifx i==0 then 0 else 1) else ifx k==2 then (ifx i==0 then 1 else 0) else ifx i==0 then 0 else 48;if jv_int(d[0],jv_at(d[0],row,k),-1)!=want {return 1;}}}n=fs_read(fs_join(dir,ifx phase==0 then "notice.txt" else "recovered-notice.txt",paths[9][..]),bytes[..]);if n<1||cast(string)bytes[0..<n]!=jo_text(e[..]) {return 1;}}
 n:=fs_read(report,bytes[..]);if n<1||!jv_parse(d[..],cast(string)bytes[0..<n],nodes[..]) {return 1;}for key,k:[7]string.["frames","completed","pending","recoveries","recoveryReleasedLive","closedLedgerLive","closedLedgerWords"] {if jv_int(d[0],jv_get(d[0],0,key),-1)!=(ifx k<2 then 6 else ifx k==3 then 1 else 0) {return 1;}}
 owner:=jv_get(d[0],0,"mediaOwnership");if jv_len(d[0],owner)!=2||jv_int(d[0],jv_get(d[0],0,"closedMediaBytes"),-1)!=0 {return 1;}
 for phase:0..<2 {row:=jv_at(d[0],owner,phase);if jv_len(d[0],row)!=2||jv_int(d[0],jv_at(d[0],row,0),-1)!=7||jv_int(d[0],jv_at(d[0],row,1),-1)!=55296 {return 1;}}
 receipt:[4096]u8;jo_start(o[..],receipt[..]);jo_obj(o[..]);mrf_str(o[..],"schema","aethyr.metal.media-refusal.v1");mrf_str(o[..],"case",ifx missing then "missing" else ifx late then "late-invalid" else "malformed-metadata");jo_key(o[..],"passed");jo_bool(o[..],true);jo_key(o[..],"notice_kind");jo_int(o[..],607);jo_key(o[..],"continuing_frames");jo_int(o[..],6);jo_end(o[..]);if o[0].bad||!fs_write(fs_join(dir,"receipt.json",paths[10][..]),jo_text(o[..])) {return 1;}print("Actual per-image refusal: world continues6frames, failed0x0notice, recovery andcloseclean\n");return 0;
}
