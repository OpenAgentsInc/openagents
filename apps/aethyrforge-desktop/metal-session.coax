// Ordinary native menu actions and actual SDK observations. Coax owns verdict.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "metal-window-plan.coax";
#load "../../aethyr/host/metal-session-conformance.coax";
hms_audio :: (d:Jv,row:int,key:string)->int {return mw_field(d,jv_get(d,row,"audio"),key);}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3 {tool_errln("usage: metal-session ISOLATED_APP PERSISTED_DATA NEW_OUTPUT [--existing]");return 2;}
 app:=args_at(a[..],0);data:=args_at(a[..],1);dir:=args_at(a[..],2);paths:[4][4096]u8;if !fs_mkdir(dir){return 1;}report:=fs_join(dir,"window.json",paths[0][..]);plan:=fs_join(dir,"plan.json",paths[1][..]);raw:[32768]u8;o:[1]Jo;jo_start(o[..],raw[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.metal.window-plan.v1");jo_key(o[..],"report");jo_str(o[..],report);jo_key(o[..],"operations");jo_arr(o[..]);
 mw_op(o[..],"raise");jo_end(o[..]);mw_op(o[..],"audio");jo_end(o[..]);mw_wait(o[..],1000);for down:[2]bool.[true,false]{mw_op(o[..],"key");jo_key(o[..],"key");jo_int(o[..],-2);jo_key(o[..],"down");jo_bool(o[..],down);jo_end(o[..]);}mw_wait(o[..],500);mw_observe(o[..],"before");
 mw_op(o[..],"recover");jo_end(o[..]);mw_wait(o[..],1000);mw_observe(o[..],"recovered");mw_op(o[..],"reload");jo_end(o[..]);mw_wait(o[..],2000);mw_observe(o[..],"reloaded");mw_op(o[..],"audio");jo_end(o[..]);mw_wait(o[..],500);mw_observe(o[..],"started");jo_end(o[..]);jo_end(o[..]);if o[0].bad||!fs_write(plan,jo_text(o[..])){return 1;}
 if !args_has(a[..],"--existing"){cmd:=[10]string.[fs_join(app,"Contents/MacOS/Aethyrforge",paths[2][..]),"--world","metal","--mute-audio","--data-dir",data,"--metal-measure-plan",plan,"--test-window-title","Metal12868Session"];out:[65536]u8;err:[65536]u8;r:=proc_run(cmd[..],120000,out[..],err[..]);if !fs_write(fs_join(dir,"sdk.stderr",paths[3][..]),cast(string)err[0..<r.err_n])||r.started!=0||r.status!=0||r.cut||r.timed_out{return 1;}}
 bytes:[4194304]u8;n:=fs_read(report,bytes[..]);doc:[1]Jv;nodes:[131072]JvNode;if n<1||!jv_parse(doc[..],cast(string)bytes[0..<n],nodes[..]){return 1;}d:=doc[0];before:=mw_label(d,"before");recovered:=mw_label(d,"recovered");reload:=mw_label(d,"reloaded");started:=mw_label(d,"started");retired:=jv_at(d,jv_get(d,0,"retirements"),0);closed:=jv_get(d,0,"closedAudio");if before<0||recovered<0||reload<0||started<0||retired<0||jv_len(d,jv_get(d,0,"retirements"))!=1{return 1;}
 q:=HmsObserved.{frames=mw_field(d,before,"frames"),net=mw_field(d,before,"net"),seat=mw_field(d,before,"seat"),recovered_frames=mw_field(d,recovered,"frames"),recoveries=mw_field(d,recovered,"recoveries"),recovered_net=mw_field(d,recovered,"net"),recovered_seat=mw_field(d,recovered,"seat"),reloaded_frames=mw_field(d,reload,"frames"),reloaded_net=mw_field(d,reload,"net"),reloaded_seat=mw_field(d,reload,"seat"),retired_live=mw_field(d,retired,"ledgerLive"),retired_words=mw_field(d,retired,"ledgerWords"),retired_media=mw_field(d,retired,"mediaBytes"),retired_audio=hms_audio(d,retired,"retired"),retired_active=hms_audio(d,retired,"active"),pre_frames=hms_audio(d,reload,"frames"),pre_started=hms_audio(d,reload,"started"),post_frames=hms_audio(d,started,"frames"),post_started=hms_audio(d,started,"started"),nonzero=hms_audio(d,before,"nonzeroDeviceSamples")+hms_audio(d,recovered,"nonzeroDeviceSamples")+hms_audio(d,reload,"nonzeroDeviceSamples")+hms_audio(d,started,"nonzeroDeviceSamples"),closed_live=mw_field(d,0,"closedLedgerLive"),closed_words=mw_field(d,0,"closedLedgerWords"),closed_media=mw_field(d,0,"closedMediaBytes"),closed_audio=mw_field(d,closed,"retired"),closed_active=mw_field(d,closed,"active")};ok:=hms_accept(q);print("Actual native device rebuild and ordinary reload: same roomseat, retired GPU/CPU/audio owners, fresh gesture clock:%\n",ok);return ifx ok then 0 else 1;
}
