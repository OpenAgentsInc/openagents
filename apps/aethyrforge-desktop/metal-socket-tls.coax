// Local certificate/peer orchestration. Private fixture keys are deleted.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc-raw.coax";
#load "../../coax/lib/json/json.coax";
#load "../../aethyr/host/socket-tls-conformance.coax";
mst_run :: (argv:[]string)->bool {out:[65536]u8;err:[65536]u8;r:=proc_run(argv,30000,out[..],err[..]);if r.started!=0||r.status!=0||r.cut||r.timed_out{tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;}
mst_text :: (d:Jv,row:int,key:string,out:[]u8)->string {n:=jv_str(d,jv_get(d,row,key),out);return ifx n<0 then "" else cast(string)out[0..<n];}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3{tool_errln("usage: metal-socket-tls ROOT TEST_TRUST_SDK NEW_OUTPUT");return 2;}root:=args_at(a[..],0);sdk:=args_at(a[..],1);dir:=args_at(a[..],2);if !fs_mkdir(dir){return 1;}
 paths:[32][4096]u8;names:=[12]string.["good.key","good.pem","good.cnf","rogue.key","rogue.pem","rogue.cnf","wrong.key","wrong.pem","wrong.cnf","wrong.csr","client.json","plan.json"];files:[12]string;for name,i:names{files[i]=fs_join(dir,name,paths[i][..]);}
 defer{for i:[3]int.[0,3,6]{removed:=fs_remove(files[i]);}}
 for i:0..<3 {text:[1024]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_put(o[..],"[req]\nprompt=no\ndistinguished_name=dn\nx509_extensions=v3\n[dn]\nCN=");jo_put(o[..],ifx i==2 then "other.invalid" else "localhost");jo_put(o[..],"\n[v3]\nbasicConstraints=critical,CA:TRUE\nkeyUsage=critical,digitalSignature,keyCertSign,cRLSign\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:");jo_put(o[..],ifx i==2 then "other.invalid" else "localhost");jo_put(o[..],"\n");if o[0].bad||!fs_write(files[i*3+2],jo_text(o[..])){return 1;}}
 for i:0..<2 {cmd:=[18]string.["/usr/bin/openssl","req","-x509","-newkey","rsa:2048","-nodes","-days","1","-keyout",files[i*3],"-out",files[i*3+1],"-config",files[i*3+2],"-sha256","-extensions","v3","-batch"];if !mst_run(cmd[..]){return 1;}}
 req:=[13]string.["/usr/bin/openssl","req","-new","-newkey","rsa:2048","-nodes","-keyout",files[6],"-out",files[9],"-config",files[8],"-batch"];if !mst_run(req[..]){return 1;}
 sign:=[19]string.["/usr/bin/openssl","x509","-req","-in",files[9],"-CA",files[1],"-CAkey",files[0],"-set_serial","2","-days","1","-out",files[7],"-extfile",files[8],"-extensions","v3"];if !mst_run(sign[..]){return 1;}
 children:=[3]int.[-1,-1,-1];peers:[3]string;defer{for child:children{if child>=0{killed:=proc_kill(child,PROC_SIGTERM);waited:=proc_wait(child,2000);released:=proc_release(child);}}}
 for port,i:[3]string.["9174","9175","9176"] {peers[i]=fs_join(dir,[3]string.["trusted.json","untrusted.json","wrong-name.json"][i],paths[12+i][..]);child:=proc_new();children[i]=child;if child<0{return 1;}for arg:[7]string.["python3","-I",fs_join(root,"apps/aethyrforge-desktop/tests/metal-tls-peer.py",paths[15+i][..]),port,files[i*3+1],files[i*3],peers[i]]{if !proc_arg(child,arg){return 1;}}if proc_start(child)!=0{return 1;}line:[64]u8;n:=proc_line(child,5000,line[..]);if n!=5||cast(string)line[0..<n]!="READY"{tool_errln(proc_stderr(child,line[..]));return 1;}}
 bytes:[16384]u8;j:[1]Jo;jo_start(j[..],bytes[..]);jo_obj(j[..]);jo_key(j[..],"schema");jo_str(j[..],"aethyr.host.effects.v1");jo_key(j[..],"scope");jo_str(j[..],"socket-tls");jo_key(j[..],"origin");jo_str(j[..],"https://bound.invalid");jo_key(j[..],"operations");jo_arr(j[..]);
 for name,i:[3]string.["plain","secure","other"]{jo_obj(j[..]);jo_key(j[..],"op");jo_str(j[..],"cookie");jo_key(j[..],"domain");jo_str(j[..],"localhost");jo_key(j[..],"path");jo_str(j[..],ifx i==2 then "/other" else "/auth");jo_key(j[..],"name");jo_str(j[..],name);jo_key(j[..],"value");jo_str(j[..],[3]string.["one","two","three"][i]);jo_key(j[..],"secure");jo_bool(j[..],i==1);jo_end(j[..]);}
 for uri:[4]string.["wss://localhost:9174/auth/a","wss://localhost:9175/auth/b","wss://localhost:9176/auth/c","wss://localhost:9174/auth/d"]{jo_obj(j[..]);jo_key(j[..],"op");jo_str(j[..],"message");jo_key(j[..],"kind");jo_int(j[..],910);jo_key(j[..],"text");jo_str(j[..],uri);jo_end(j[..]);jo_obj(j[..]);jo_key(j[..],"op");jo_str(j[..],"wait");jo_key(j[..],"ms");jo_int(j[..],1500);jo_end(j[..]);}
 jo_obj(j[..]);jo_key(j[..],"op");jo_str(j[..],"observe");jo_key(j[..],"name");jo_str(j[..],"events");jo_end(j[..]);jo_end(j[..]);jo_end(j[..]);if j[0].bad||!fs_write(files[11],jo_text(j[..])){return 1;}
 env:[8192]u8;e:[1]Jo;jo_start(e[..],env[..]);jo_put(e[..],"CXTLS_TEST_CA=");jo_put(e[..],files[1]);variables:=[1]string.[jo_text(e[..])];run:=[5]string.[fs_join(sdk,"HostEffects",paths[18][..]),fs_join(sdk,"resources",paths[19][..]),fs_join(sdk,"libfixture.dylib",paths[20][..]),files[11],files[10]];out:[65536]u8;err:[65536]u8;r:=proc_run_bytes(run[..],variables[..],60000,out[..],err[..]);if !fs_write(fs_join(dir,"sdk.stderr",paths[21][..]),cast(string)err[0..<r.err_n])||r.started!=0||r.status!=0||r.cut||r.timed_out{tool_errln(cast(string)err[0..<r.err_n]);return 1;}
 raw:[65536]u8;nodes:[2048]JvNode;d:[1]Jv;n:=fs_read(files[10],raw[..]);if n<1||!jv_parse(d[..],cast(string)raw[0..<n],nodes[..]){return 1;}events:=jv_get(d[0],0,"events");rows:[18][8]int;if jv_len(d[0],events)!=18{tool_errln("TLS callback count differs; raw retained");return 1;}for i:0..<18{row:=jv_at(d[0],events,i);if jv_len(d[0],row)!=8{return 1;}for field:0..<8{rows[i][field]=jv_int(d[0],jv_at(d[0],row,field),-1);}}if !hst_client(rows[..],jv_int(d[0],jv_get(d[0],0,"dropped"),-1)){tool_errln("TLS callback words differ; raw retained");return 1;}
 n=fs_read(peers[0],raw[..]);if n<1||!jv_parse(d[..],cast(string)raw[0..<n],nodes[..])||jv_len(d[0],0)!=2{return 1;}storage:[2][4][4096]u8;observed:[2]HostTlsOpening;for i:0..<2{row:=jv_at(d[0],0,i);observed[i]=HostTlsOpening.{path=mst_text(d[0],row,"path",storage[i][0][..]),origin=mst_text(d[0],row,"origin",storage[i][1][..]),cookie=mst_text(d[0],row,"cookie",storage[i][2][..]),version=mst_text(d[0],row,"version",storage[i][3][..])};}
 failures:[2]int;for i:0..<2{n=fs_read(peers[i+1],raw[..]);if n<1||!jv_parse(d[..],cast(string)raw[0..<n],nodes[..]){return 1;}failures[i]=jv_len(d[0],0);}
 ok:=hst_peer(observed[..],failures[0],failures[1]);print("Actual TLS opening, Secure cookie/Origin and certificate/hostname refusal:%\n",ok);return ifx ok then 0 else 1;
}
