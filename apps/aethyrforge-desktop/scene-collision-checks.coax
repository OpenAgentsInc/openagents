// The actual Everglade NPC controller consumes the planner's objects through
// the same fence builder used by the live page and authoritative room.
#load "scene-policy.coax";
#load "../../verse/everglade/watch.coax";

#test "scene tool rows and stacks immediately make NPCs walk around their actual footprints" #steps 400000000 {
  for stack:[2]bool.[false,true] {
    c:=ForgeSceneCommand.{op=FS_PLACE,item=0,count=ifx stack then 5 else 3,stack=stack,located=true,x=600,z=-1050};
    p:=fs_plan(EgEdits.{},c,0,0);#assert p.ok;
    f:[WATCH_FENCES*5]f32;n:=eg_edit_fences(p.edits,f[..],0);#assert n==(ifx stack then 1 else 3);
    heights:[EG_GROUND_POINTS]f32;watch_ground(heights[..]);w:[1]Watch;watch_test_town(w[..],heights[..]);
    watch_fences(w[..],f[..],n);g:=EG_SPOTS;watch_home(w[..],g,6,-12,0,false);
    a:=w[0].actors[g..<g+1];a[0].mode=WM_BACK;a[0].t=0;a[0].x=6;a[0].z=-8;
    #assert watch_fence_cuts(w[..],0,6,-8,6,-12) || !stack;
    home:=false;detour:=false;
    for frame:0..<600 {
      heading:=watch_way(w[..],a[0].x,a[0].z,6,-12);
      moved:=watch_stride(w[..],a,heading,0.05);
      #assert !watch_fenced(w[..],a[0].x,a[0].z);
      if abs(a[0].x-6)>0.6 {detour=true;}
      if flat_gap(v3(a[0].x,0,a[0].z),v3(6,0,-12))<0.06 {home=true;break;}
    }
    #assert home && detour;
    watch_fences(w[..],f[..],0);#assert !watch_fenced(w[..],6,-10.5);
  }
}
