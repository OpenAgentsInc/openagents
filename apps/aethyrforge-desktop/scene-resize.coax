// V2 adds one-object resizing without changing the published v1 parser.
#authority;
#load "scene-policy.coax";
ForgeResize :: struct {index:int;version:int;amount:int;relative:bool;}
FSR_FIELDS :: [5]string.["op","index","version","size_percent","scale_percent"];

#test "resize selects one versioned object and exactly one typed size field" {
  c:[1]ForgeResize;
  #assert fsr_command("{\"op\":\"resize\",\"index\":0,\"version\":0,\"size_percent\":25}",c[..]) && c[0].index==0 && c[0].version==0 && c[0].amount==25 && !c[0].relative;
  #assert fsr_command("{\"op\":\"resize\",\"index\":63,\"version\":1000000000,\"size_percent\":400}",c[..]) && c[0].index==63 && c[0].version==1000000000 && c[0].amount==400;
  #assert fsr_command("{\"op\":\"resize\",\"index\":1,\"version\":23,\"scale_percent\":300}",c[..]) && c[0].relative && c[0].amount==300;
  #assert fsr_command("{\"op\":\"resize\",\"index\":1,\"version\":1,\"scale_percent\":1}",c[..]);
  #assert fsr_command("{\"op\":\"resize\",\"index\":1,\"version\":1,\"scale_percent\":1600}",c[..]);
  #assert !fsr_command("{\"op\":\"resize\",\"index\":1,\"version\":0,\"scale_percent\":true}",c[..]);
  for bad:[22]string.["oops","{}","[]","{\"op\":\"place\",\"index\":1,\"version\":0,\"size_percent\":100}","{\"op\":1,\"index\":1,\"version\":0,\"size_percent\":100}","{\"op\":\"resize\",\"version\":0,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":0}","{\"op\":\"resize\",\"index\":-1,\"version\":0,\"size_percent\":100}","{\"op\":\"resize\",\"index\":64,\"version\":0,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":-1,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":1000000001,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":24}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":401}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"scale_percent\":0}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"scale_percent\":1601}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":100,\"scale_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":true}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":100.5}","{\"op\":\"resize\",\"index\":1,\"index\":2,\"version\":0,\"size_percent\":100}","{\"extra\":1,\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":100}","{\"op\":\"resize\",\"index\":1,\"version\":0,\"size_percent\":100,\"group\":1}"] {#assert !fsr_command(bad,c[..]);}
}
#test "tripling the middle crate preserves its neighbours identities transforms and document flags" {
  e:EgEdits;e.n=3;e.gone=3;e.hidden=5;
  for i:0..<3 {e.things[i]=eg_thing(0,6+f32(i-1)*2.09,-12,0,1);e.things[i].group=7;e.things[i].tint=2;}
  e.things[3]=eg_thing(0,14,-12,0,1);
  c:=ForgeResize.{index=1,version=23,amount=300,relative=true};p:=fsr_plan(e,c,23);
  #assert p.ok && p.count==1 && p.group==7 && p.edits.n==3 && p.edits.gone==3 && p.edits.hidden==5;
  for i:0..<3 {t:=p.edits.things[i];b:=e.things[i];#assert t.size==(ifx i==1 then 3.0f32 else 1.0f32) && t.kind==b.kind && t.group==b.group && t.x==b.x && t.z==b.z && t.yaw==b.yaw && t.lift==b.lift && t.tint==b.tint;}
  #assert !fsr_plan(e,c,24).ok; c.index=3;#assert !fsr_plan(e,c,23).ok;
  c.index= -1;#assert !fsr_plan(e,c,23).ok;
  c.index=0;c.amount=1600;#assert !fsr_plan(e,c,23).ok;
  c.amount=1;#assert !fsr_plan(e,c,23).ok;
  c.index=1;c.amount=400;p=fsr_plan(e,c,23);#assert !p.ok && p.edits.things[1].size==1;
  c.amount=25;c.relative=false;p=fsr_plan(e,c,23);#assert p.ok && p.edits.things[1].size==0.25;
  #assert fsr_percent(125,150,true)==188 && fsr_percent(125,150,false)==150 && fsr_percent(149,101,true)==150;
  one:EgEdits;one.n=1;one.things[0]=eg_thing(0,6,-12,0.5,1);one.things[0].lift=1;
  c=ForgeResize.{index=0,version=23,amount=400};p=fsr_plan(one,c,23);#assert p.ok && p.edits.things[0].size==4 && p.edits.things[0].yaw==0.5 && p.edits.things[0].lift==1;
  c.amount=401;#assert !fsr_plan(one,c,23).ok;
  one.things[0]=eg_thing(0,0,0,0,1);c.amount=100;#assert !fsr_plan(one,c,23).ok;
}
fsr_field :: (key:string)->int #effects(all) {for i:0..<FSR_FIELDS.count {if key==FSR_FIELDS[i] {return i;}}return FSR_FIELDS.count;}
fsr_command :: (text:string,out:[]ForgeResize)->bool #effects(all) {
  nodes:[16]JvNode;j:[1]Jv;if !jv_parse(j[..],text,nodes[..]) {return false;}v:=j[0];seen:u32=0;
  for i:1..<v.count {
    f:=fsr_field(jv_key(v,i));if f==FSR_FIELDS.count || (seen & (cast(u32)1 << cast(u32)f))!=0 {return false;}
    seen|=cast(u32)1 << cast(u32)f;
    if f==0 {if jv_kind(v,i)!=JV_STRING {return false;}}
  }
  if jv_raw(v,jv_get(v,0,"op"))!="resize" {return false;}
  c:ForgeResize;c.index=jv_int(v,jv_get(v,0,"index"),-1);c.version=jv_int(v,jv_get(v,0,"version"),-1);
  size:=seen & cast(u32)24;if size!=8 && size!=16 {return false;}c.relative=size==16;
  c.amount=jv_int(v,jv_get(v,0,ifx c.relative then "scale_percent" else "size_percent"),0);
  if c.index<0 || c.index>=64 || c.version<0 || c.version>1000000000 {return false;}
  if c.relative {if c.amount<1 || c.amount>1600 {return false;}}else{if c.amount<25 || c.amount>400 {return false;}}
  out[0]=c;return true;
}
fsr_percent :: (current:int,amount:int,relative:bool)->int #effects(all) {return ifx relative then (current*amount+50)/100 else amount;}
fsr_plan :: (before:EgEdits,c:ForgeResize,version:int)->ForgeScenePlan #effects(all) {
  p:ForgeScenePlan;p.edits=before;
  if c.version!=version || c.index<0 || c.index>=before.n {return p;}
  percent:=fsr_percent(eg_round(before.things[c.index].size*100),c.amount,c.relative);
  if percent<25 || percent>400 {return p;}
  after:=before;after.things[c.index].size=f32(percent)/100;
  for i:0..<after.n {if eg_edit_fault(after,i)!=EG_FAULT_NONE {return p;}}
  p.edits=after;p.group=after.things[c.index].group;p.count=1;p.ok=true;return p;
}
