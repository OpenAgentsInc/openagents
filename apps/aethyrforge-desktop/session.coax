// The desktop's local entry point. The Swift host supplies OS-assigned ports;
// Everglade, its editor, world rules and saves stay in the existing Coax stack.
#import "Basic";

#test "desktop opens the local 5e Everglade in EDIT at the South Gate" {
  b: [256] u8;
  #assert forge_page_url(49152, 49153, b[..]) == "http://127.0.0.1:49152/worlds/everglade?forge&room=pair-aethyrforge&relay=ws://localhost:49153#gate";
  #assert forge_url_byte(49152, 49153, 0) == 'h';
  #assert forge_url_byte(49152, 49153, 128) == -1;
}
#test "desktop refuses missing, overlapping and reserved ports, without a partial URL" {
  b: [256] u8;
  #assert forge_page_url(0, 49153, b[..]) == "" && forge_page_url(49152, 65536, b[..]) == "";
  #assert forge_page_url(49152, 49152, b[..]) == "" && forge_page_url(8830, 49153, b[..]) == "";
  #assert forge_page_url(49152, 8872, b[..]) == "" && forge_page_url(-1, 49153, b[..]) == "";
  #assert forge_page_url(80, 49153, b[..]) == "";
  small: [8] u8;
  #assert forge_page_url(49152, 49153, small[..]) == "";
  #assert small[0] == 0 && forge_url_byte(49152, 49153, -1) == -1;
}

forge_port :: (p: int) -> bool { return p >= 1024 && p <= 65535 && p != 8830 && p != 8872; }
forge_page_url :: (page: int, room: int, out: [] u8) -> string {
  if !forge_port(page) || !forge_port(room) || page == room || out.count < 128 { return ""; }
  n := 0;
  // pair-* takes the default character. The client's explicit local relay
  // contract accepts ws://localhost:PORT; 127.0.0.1 is not a relay override and
  // would send the WebSocket through the blocking HTTP-only page proxy.
  for s: [5] string.["http://127.0.0.1:", "", "/worlds/everglade?forge&room=pair-aethyrforge&relay=ws://localhost:", "", "#gate"] {
    if s.count > 0 { for c: s { out[n] = c; n += 1; } }
    else {
      v := ifx n < 32 then page else room; digits: [5] u8; k := 0;
      while v > 0 { digits[k] = cast(u8) ('0' + v % 10); v /= 10; k += 1; }
      for i: 0..<k { out[n] = digits[k - i - 1]; n += 1; }
    }
  }
  return cast(string) out[0..<n];
}
// Scalar bridge: no borrowed Coax storage crosses the Swift ABI.
forge_url_byte :: (page: int, room: int, index: int) -> int #export_c {
  b: [256] u8; url := forge_page_url(page, room, b[..]);
  return ifx index >= 0 && index < url.count then cast(int) url[index] else -1;
}
