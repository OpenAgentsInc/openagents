// The qualified native world opens by default; web remains an explicit preview.
#authority;
#test "the desktop defaults to native Metal and keeps explicit web preview" {
 #assert forge_world_backend("")==1 && forge_world_backend("web")==0 && forge_world_backend("metal")==1;
 #assert forge_world_backend("Metal")== -1 && forge_world_backend("vulkan")== -1 && forge_world_backend("metal ")== -1;
}
forge_world_backend :: (name:string)->int #export_c #effects(all) {
 if name=="web" {return 0;}
 if name=="" || name=="metal" {return 1;}
 return -1;
}
