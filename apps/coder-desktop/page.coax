  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Hello.\"}") == MWW_ENDED;
  s[0].d = 1; s[0].col_x = 100; s[0].col_w = 400; s[0].view = 600; s[0].turns[0].ay = 50; s[0].turns[0].ah = 40;
  #assert !coder_page_pointer(s, 200, 60, 0) && coder_page_pointer(s, 200, 60, 2) && s[0].turns[0].info;
  #assert !coder_page_pointer(s, 200, 60, 0) && coder_page_pointer(s, 200, 60, 2) && !s[0].turns[0].info;
  #assert !coder_page_pointer(s, 200, 60, 0) && !coder_page_pointer(s, 260, 60, 2) && !s[0].turns[0].info;
  #assert !coder_page_pointer(s, 50, 60, 0) && !coder_page_pointer(s, 50, 60, 2) && !s[0].turns[0].info;
  #assert coder_page_icon_size(ICON_COPY) == coder_page_icon_size(ICON_COMPOSE) && coder_page_icon_size(ICON_FOLDER) == CP_ICON && coder_page_icon_size(ICON_CHECK) == CP_ICON;
}
#test "sub-agents: a neon task runs on Gemini 4 Neon, its row and wait line name Neon, and it is not a Claude level" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  #assert coder_page_set_text(s, "ship it") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"neon\",\"task\":\"build it\"},{\"level\":\"opus\",\"task\":\"review\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert s[0].turns[0].nagents == 2 && CP_LEVEL_NAME[s[0].turns[0].agents[0].level] == "Neon" && !coder_page_agent_claude(s, 0) && coder_page_agent_claude(s, 1);
  #assert CP_LEVEL_NAME[s[0].turns[0].agents[1].level] == "Claude Opus";
  #assert coder_page_agent_next(s) == 0;
  n = coder_page_agent_task(s, 0, "s-a0", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].task == "build it" && back[0].model == "gemini-4-neon" && back[0].effort == "medium" && back[0].gated && back[0].edits;
  s[0].clock = s[0].turns[0].agents[0].heard + 4;
  wb: [256] u8;
  #assert cp_agent_wait(s, 0, 0, wb[..]) == "waiting on Gemini 4 Neon · 4s";
}
#test "sub-agents: tasks start once each, a complex one on Carbon; their tool calls show; when all end the worker gets the results" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  #assert coder_page_set_text(s, "do two things") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].agents && back[0].edits && back[0].gated && back[0].unlimited;
  #assert coder_page_agent_next(s) == -1;
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"count files\"},{\"level\":\"carbon\",\"task\":\"find the bug\"}],\"ticket\":3}") == MWW_DELEGATE;
  #assert s[0].turns[0].nagents == 2 && s[0].turns[0].waiting && !s[0].results_due;
  #assert coder_page_agent_next(s) == 0 && coder_page_agent_next(s) == 1 && coder_page_agent_next(s) == -1;
  n = coder_page_agent_task(s, 0, "s-a0", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].task == "count files" && back[0].model == "gemini-4-hydrogen" && !back[0].agents && back[0].gated && back[0].edits && back[0].cwd == "/w";
  n = coder_page_agent_task(s, 1, "s-a1", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].task == "find the bug" && back[0].model == "gemini-4-carbon" && back[0].effort == "medium";
  s[0].clock = 5;
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"ask\",\"command\":\"ls | wc -l\",\"ticket\":1}") == MWW_ASK;
  n = coder_page_agent_answer_line(s, 0, out[..]);
  #assert cast(string) out[0..<n] == "{\"answer\":true,\"ticket\":1}\n" && coder_page_agent_answer_line(s, 0, out[..]) == 0 && coder_page_agent_answer_line(s, 1, out[..]) == 0;
  #assert s[0].turns[0].agents[0].calls == 1 && s[0].turns[0].agents[0].now_running && cast(string) s[0].turns[0].agents[0].now[0..<s[0].turns[0].agents[0].now_n] == "ls | wc -l";
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"command\",\"command\":\"ls | wc -l\",\"exit\":0,\"timed_out\":false,\"output\":\"12\"}") == MWW_COMMAND && !s[0].turns[0].agents[0].now_running && s[0].turns[0].agents[0].calls == 1;
  s[0].clock = 70;
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"12 files\"}") == MWW_ENDED;
  #assert !coder_page_agent_running(s, 0) && coder_page_agent_running(s, 1) && !s[0].results_due && coder_page_answer_line(s, out[..]) == 0;
  kb: [24] u8;
  #assert cp_took(kb[..], s[0].turns[0].agents[0].took) == "1m 10s" && cp_took(kb[..], 9.7) == "9s" && cp_took(kb[..], 65) == "1m 05s" && cp_took(kb[..], -1) == "";
  coder_page_agent_failed(s, 1, "Its worker stopped.");
  #assert s[0].results_due && s[0].turns[0].agents[1].state == CP_FAILED;
  n = coder_page_answer_line(s, out[..]);
  #assert cast(string) out[0..<n] == "{\"results\":[{\"exit\":0,\"output\":\"12 files\"},{\"exit\":1,\"output\":\"Its worker stopped.\"}],\"ticket\":3}\n";
  #assert !s[0].turns[0].waiting && coder_page_answer_line(s, out[..]) == 0;
  // a second round, stopped: its sub-agent is stopped with the run and nothing is owed
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"again\"}],\"ticket\":4}") == MWW_DELEGATE && s[0].turns[0].nagents == 3;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\",\"text\":\"\"}") == MWW_ENDED;
  #assert s[0].turns[0].agents[2].state == CP_STOPPED && !s[0].results_due && coder_page_agent_next(s) == -1;
  // a new chat's first message shows none of them
  #assert coder_page_new(s) && coder_page_set_text(s, "hi") && coder_page_submit(s) && s[0].turns[0].nagents == 0 && !s[0].turns[0].waiting;
}

#test "a chat is kept and read back whole; the list names the chats; a reopened chat's turns go to the worker" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  #assert !coder_page_save_due(s) && coder_page_set_text(s, "List  the\nfiles") && coder_page_submit(s) && coder_page_save_due(s) && !coder_page_save_due(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"opus\",\"task\":\"look\"}],\"ticket\":1}") == MWW_DELEGATE;
  s[0].clock = 9;
  #assert coder_page_agent_next(s) == 0 && coder_page_agent_line(s, 0, "{\"kind\":\"ask\",\"command\":\"ls\",\"ticket\":1}") == MWW_ASK;
  // running conversation cost updates in real time (main worker + sub-agent), persists, and resets
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":12500}") == MWW_ATTEMPT;
  #assert coder_page_cost_usd_micros(s) == 12500 && coder_page_save_due(s);
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"openrouter\",\"outcome\":\"done\",\"status\":200,\"provider_cost_usd_micros\":7500,\"usd_micros\":9999}") == MWW_ATTEMPT;
  #assert coder_page_cost_usd_micros(s) == 20000 && coder_page_save_due(s);
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"attempt\",\"gateway\":\"claude\",\"outcome\":\"done\",\"status\":200,\"provider_cost_usd_micros\":50000,\"usd_micros\":50000}") == MWW_ATTEMPT;
  #assert coder_page_cost_usd_micros(s) == 70000 && coder_page_save_due(s);
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"two files\"}") == MWW_ENDED;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"ls\",\"exit\":0,\"timed_out\":false,\"output\":\"a\\nb\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"There are **two** files.\"}") == MWW_ENDED && coder_page_save_due(s);
  tb: [200] u8; n := coder_page_title(s, tb[..]);
  #assert cast(string) tb[0..<n] == "List the files";
  kept: [16384] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && json_valid(cast(string) kept[0..<kn]) && coder_page_save(s, kept[0..<40]) == 0 && !coder_page_save_due(s);
  // a new chat, then the kept one again
  #assert coder_page_new(s) && s[0].nturns == 0 && coder_page_cost_usd_micros(s) == 0 && !coder_page_save_due(s);
  #assert !coder_page_load(s, "{}") && coder_page_load(s, cast(string) kept[0..<kn]) && coder_page_cost_usd_micros(s) == 70000 && !coder_page_save_due(s);
  #assert s[0].nturns == 1 && cast(string) s[0].turns[0].ask[0..<s[0].turns[0].ask_n] == "List  the\nfiles" && s[0].turns[0].state == CP_DONE && s[0].turns[0].blocks == 1;
  #assert cast(string) s[0].turns[0].reply[0..<s[0].turns[0].reply_n] == "There are **two** files." && s[0].turns[0].ncmds == 1 && cast(string) s[0].calls[cp_nth(s, 0, -1, 0)].out[0..<s[0].calls[cp_nth(s, 0, -1, 0)].out_n] == "a\nb";
  #assert s[0].turns[0].nagents == 1 && CP_LEVEL_NAME[s[0].turns[0].agents[0].level] == "Claude Opus" && s[0].turns[0].agents[0].state == CP_DONE && s[0].turns[0].agents[0].took == 9 && s[0].turns[0].agents[0].calls == 1;
  #assert cast(string) s[0].turns[0].agents[0].reply[0..<s[0].turns[0].agents[0].reply_n] == "two files" && coder_page_agent_next(s) == -1;
  // kept again, it is the same text
  again: [16384] u8; an := coder_page_save(s, again[..]);
  #assert cast(string) again[0..<an] == cast(string) kept[0..<kn];
  out: [4096] u8; rn := coder_page_recall_line(s, out[..]);
  #assert cast(string) out[0..<rn] == "{\"recall\":[{\"task\":\"List  the\\nfiles\",\"reply\":\"There are **two** files.\"}]}\n";
  // the list: 50 rows and how many more; the id a press asks for
  coder_page_chats(s, "a1\tFirst chat\nb2\t\nc3\tThird\n");
  #assert s[0].nchats == 3 && s[0].chats_more == 0 && cast(string) s[0].chats[0].id[0..<s[0].chats[0].id_n] == "chat.a1" && cast(string) s[0].chats[1].title[0..<s[0].chats[1].title_n] == "New chat";
  coder_page_current(s, "a1"); s[0].open = 2;
  on := coder_page_open_id(s, out[..]);
  #assert cast(string) out[0..<on] == "c3" && cast(string) s[0].current[0..<s[0].current_n] == "chat.a1";
  coder_page_current(s, "");
  #assert s[0].current_n == 0;
}

#test "a running chat moves out of view and back with its run; a new chat and another chat open while it runs; the list marks it" {
  p: [2] CoderPage; s := p[0..<1]; b := p[1..<2];
  cp_init(s); coder_page_init(b);
  coder_page_current(s, "a1");
  #assert coder_page_set_text(s, "look around") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND && coder_page_save_due(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"opus\",\"task\":\"look\"}],\"ticket\":4}") == MWW_DELEGATE;
  s[0].clock = 50;
  #assert coder_page_agent_next(s) == 0 && coder_page_agent_line(s, 0, "{\"kind\":\"ask\",\"command\":\"ls\",\"ticket\":1}") == MWW_ASK;
  // a new chat while it runs: the host is asked, and the chat moves out
  #assert coder_page_new(s) && coder_page_action(s) == CP_ASK_NEW && cp_running(s);
  #assert coder_page_take(b, s) && !cp_running(s) && s[0].nturns == 0 && s[0].current_n == 0 && coder_page_action(s) == CP_ASK_NONE;
  #assert cp_running(b) && cast(string) b[0].current[0..<b[0].current_n] == "chat.a1" && b[0].turns[0].nagents == 1 && b[0].turns[0].agents[0].began == -50;
  #assert !coder_page_take(b, s);   // it holds a running chat
  // out of view its lines still land: the sub-agent's row ends, then the reply
  coder_page_tick(b, 7);
  #assert coder_page_agent_line(b, 0, "{\"kind\":\"command\",\"command\":\"ls\",\"exit\":0,\"timed_out\":false,\"output\":\"x\"}") == MWW_COMMAND;
  #assert b[0].calls[cp_nth(b, 0, 0, 0)].took == 7 && !coder_page_save_due(b);
  // the list marks it, and another chat opens while it runs
  coder_page_chats(s, "a1\tLook around\t1\nb2\tOther\n");
  #assert s[0].nchats == 2 && s[0].chats[0].busy && !s[0].chats[1].busy && cast(string) s[0].chats[0].title[0..<s[0].chats[0].title_n] == "Look around";
  #assert cast(string) s[0].chats[1].title[0..<s[0].chats[1].title_n] == "Other";
  // back in view, run and all
  s[0].clock = 100;
  #assert coder_page_take(s, b) && cp_running(s) && b[0].nturns == 0 && s[0].turns[0].agents[0].began == 43;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"done\"}") == MWW_ENDED && !cp_running(s) && coder_page_save_due(s);
}
#test "Claude sub-agents: offered only where Claude Code is installed; a level is a model; a tool call needs no answer" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "ask claude") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].agents && !back[0].claude;
  coder_page_set_claude(s, true);
  n = coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].agents && back[0].claude;
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"count\"},{\"level\":\"opus\",\"task\":\"find the bug\"},{\"level\":\"fable\",\"task\":\"design it\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert !coder_page_agent_claude(s, 0) && coder_page_agent_claude(s, 1) && coder_page_agent_claude(s, 2) && !coder_page_agent_claude(s, 3);
  #assert CP_LEVEL_NAME[s[0].turns[0].agents[1].level] == "Claude Opus" && CP_LEVEL_NAME[s[0].turns[0].agents[2].level] == "Claude Fable";
  n = coder_page_agent_task(s, 1, "s-a1", "/w", out[..]);
  r: [1] MwwRequest;
  #assert mww_request(ar[..], cast(string) out[0..<n - 1], r[..]) == MWW_TASK && r[0].task == "find the bug" && r[0].model == "opus" && r[0].cwd == "/w" && !r[0].agents;
  // two tool calls at once: each is logged when it starts, and neither is owed an answer
  #assert coder_page_agent_line(s, 1, "{\"kind\":\"ask\",\"command\":\"ls\",\"ticket\":1}") == MWW_ASK && coder_page_agent_line(s, 1, "{\"kind\":\"ask\",\"command\":\"read a.txt\",\"ticket\":2}") == MWW_ASK;
  #assert coder_page_agent_answer_line(s, 1, out[..]) == 0 && s[0].turns[0].agents[1].calls == 2 && s[0].turns[0].agents[1].now_running;
  #assert coder_page_agent_line(s, 1, "{\"kind\":\"command\",\"command\":\"ls\",\"exit\":0,\"timed_out\":false,\"output\":\"a\"}") == MWW_COMMAND && coder_page_agent_line(s, 1, "{\"kind\":\"command\",\"command\":\"read a.txt\",\"exit\":0,\"timed_out\":false,\"output\":\"b\"}") == MWW_COMMAND;
  #assert s[0].turns[0].agents[1].calls == 2 && s[0].turns[0].agents[1].nrows == 2 && cast(string) s[0].calls[cp_nth(s, 0, 1, 1)].text[0..<s[0].calls[cp_nth(s, 0, 1, 1)].text_n] == "read a.txt" && cast(string) s[0].calls[cp_nth(s, 0, 1, 1)].out[0..<s[0].calls[cp_nth(s, 0, 1, 1)].out_n] == "b" && !s[0].calls[cp_nth(s, 0, 1, 0)].running;
  #assert coder_page_agent_line(s, 1, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"line 4\"}") == MWW_ENDED && s[0].turns[0].agents[1].state == CP_DONE;
}
#test "a chat keeps 6,000 sub-agent tool calls: past that the oldest in the chat goes, and its sub-agent counts it" {
  p: [1] CoderPage; s := p[..];
  s[0].nturns = 1; s[0].turns[0].nagents = 2; s[0].turns[0].state = CP_DONE;
  s[0].calls_n = CP_AGENT_CALLS - 4;   // as if all but four places were taken
  _ = cp_call_add(s, 0, 0, "a", "", false, false, false);
  _ = cp_call_add(s, 0, 0, "b", "", false, false, false);
  for q: 0..<2 { _ = cp_call_add(s, 0, 1, "x", "", false, false, false); }
  #assert s[0].calls_n == CP_AGENT_CALLS && s[0].turns[0].agents[0].nrows == 2 && s[0].turns[0].agents[1].nrows == 2;
  _ = cp_call_add(s, 0, 1, "y", "", false, false, false);
  #assert s[0].turns[0].agents[0].nrows == 1 && s[0].turns[0].agents[0].early_rows == 1 && cast(string) s[0].calls[cp_nth(s, 0, 0, 0)].text[0..<1] == "b";
  _ = cp_call_add(s, 0, 1, "y", "", false, false, false);
  #assert s[0].turns[0].agents[0].nrows == 0 && s[0].turns[0].agents[0].head == 0 && s[0].turns[0].agents[0].tail == 0 && cp_nth(s, 0, 0, 0) == -1;
  _ = cp_call_add(s, 0, 1, "newest", "", false, false, false);
  #assert s[0].turns[0].agents[1].nrows == 4 && s[0].turns[0].agents[1].early_rows == 1 && s[0].turns[0].agents[0].early_rows == 2 && s[0].calls_n == CP_AGENT_CALLS;
  #assert cast(string) s[0].calls[s[0].turns[0].agents[1].tail - 1].text[0..<6] == "newest" && cast(string) s[0].calls[cp_nth(s, 0, 1, 0)].text[0..<1] == "x";
  // a new chat lets them all go
  #assert coder_page_new(s) && s[0].calls_n == 0 && s[0].calls_free == 0;
}
#test "a sub-agent's tool calls are rows with their output; a press opens its transcript and another closes it; a kept chat has them" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  #assert coder_page_set_text(s, "look") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"count\"},{\"level\":\"fable\",\"task\":\"read it\"}],\"ticket\":1}") == MWW_DELEGATE;
  // Microcoder's worker asks, then ends the command; a file read is a row of its own
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"ask\",\"command\":\"ls\",\"ticket\":1}") == MWW_ASK && s[0].calls[cp_nth(s, 0, 0, 0)].running;
  s[0].clock = 3;
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"command\",\"command\":\"ls\",\"exit\":1,\"timed_out\":false,\"output\":\"no\"}") == MWW_COMMAND;
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"view\",\"path\":\"a.txt\",\"found\":true}") == MWW_VIEW;
  #assert s[0].turns[0].agents[0].nrows == 2 && !s[0].calls[cp_nth(s, 0, 0, 0)].running && s[0].calls[cp_nth(s, 0, 0, 0)].failed && s[0].calls[cp_nth(s, 0, 0, 0)].took == 3;
  #assert cast(string) s[0].calls[cp_nth(s, 0, 0, 0)].out[0..<s[0].calls[cp_nth(s, 0, 0, 0)].out_n] == "no" && s[0].calls[cp_nth(s, 0, 0, 1)].read;
  // a call still running when its sub-agent ends is ended with it
  #assert coder_page_agent_line(s, 1, "{\"kind\":\"ask\",\"command\":\"sleep 9\",\"ticket\":1}") == MWW_ASK;
  _ = cp_call_add(s, 0, 1, "newest", "", false, false, false);
  #assert s[0].turns[0].agents[1].early_rows == 0 && cast(string) s[0].calls[s[0].turns[0].agents[1].tail - 1].text[0..<6] == "newest";
  #assert coder_page_agent_line(s, 1, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"# Done\"}") == MWW_ENDED && !s[0].calls[cp_nth(s, 0, 1, 0)].running && !s[0].calls[cp_nth(s, 0, 1, 0)].failed;
  // a sidebar's edge drags: the chats' between 180 and 480 points, the transcript's from 320, and
  // the conversation keeps 380; the widths are owed to the host once, and a kept one is held to its limits
  s[0].d = 1; s[0].win_w = 1400; s[0].side = 260; s[0].pane_open = true; s[0].pane_x = 960; s[0].pane_w = 440;
  #assert coder_page_pointer(s, 262, 300, 0) && s[0].drag == 1 && coder_page_edge(s);
  #assert coder_page_pointer(s, 300, 300, 1) && s[0].side_w == 300 && coder_page_pointer(s, 20, 300, 1) && s[0].side_w == 180 && coder_page_pointer(s, 900, 300, 1) && s[0].side_w == 480;
  #assert coder_page_pointer(s, 330, 300, 2) && s[0].drag == 0 && s[0].side_w == 480 && !coder_page_edge(s);
  s[0].side = 480;
  #assert coder_page_pointer(s, 958, 300, 0) && s[0].drag == 2 && coder_page_pointer(s, 700, 300, 1) && s[0].pane_user == 540;
  #assert coder_page_pointer(s, 1390, 300, 1) && s[0].pane_user == 320 && coder_page_pointer(s, 1390, 300, 2);
  sw: [2] f32;
  #assert coder_page_sides(s, sw[..]) && sw[0] == 480 && sw[1] == 320 && !coder_page_sides(s, sw[..]);
  coder_page_sides_set(s, 9000, 10);
  #assert s[0].side_w == 480 && s[0].pane_user == 320;
  coder_page_sides_set(s, 0, 0);
  #assert s[0].side_w == 0 && s[0].pane_user == 0 && !coder_page_pointer(s, 600, 300, 1) && !coder_page_edge(s);
  s[0].side = 0;
  // the transcript: open, the wheel over it moves it and not the conversation, closed by New chat
  s[0].pane_open = true; s[0].pane_turn = 0; s[0].pane_agent = 1; s[0].pane_x = 500; s[0].pane_w = 440; s[0].pane_content = 900; s[0].pane_view = 300; s[0].d = 1; s[0].px = 600; s[0].content = 900; s[0].view = 300; s[0].stick = false;
  coder_page_wheel(s, 50);
  #assert s[0].pane_scroll == 50 && s[0].scroll == 0 && !s[0].pane_stick;
  coder_page_wheel(s, 900);
  #assert s[0].pane_scroll == 600 && s[0].pane_stick;
  s[0].px = 100; coder_page_wheel(s, 20);
  #assert s[0].scroll == 20 && s[0].pane_scroll == 600;
  #assert coder_page_agent_line(s, 0, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"2\"}") == MWW_ENDED;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  kept: [65536] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && json_valid(cast(string) kept[0..<kn]);
  #assert coder_page_new(s) && !s[0].pane_open && coder_page_load(s, cast(string) kept[0..<kn]);
  #assert s[0].turns[0].agents[0].nrows == 2 && s[0].calls[cp_nth(s, 0, 0, 0)].failed && s[0].calls[cp_nth(s, 0, 0, 0)].took == 3 && s[0].calls[cp_nth(s, 0, 0, 1)].read;
  #assert cast(string) s[0].calls[cp_nth(s, 0, 0, 0)].out[0..<s[0].calls[cp_nth(s, 0, 0, 0)].out_n] == "no";
  #assert s[0].turns[0].agents[1].early_rows == 0 && cast(string) s[0].calls[s[0].turns[0].agents[1].tail - 1].text[0..<6] == "newest";
  // a chat kept before the rows: its list of tool calls becomes rows with no output
  #assert coder_page_new(s) && coder_page_load(s, "{\"v\":1,\"turns\":[{\"ask\":\"a\",\"reply\":\"b\",\"state\":1,\"cmds\":[],\"agents\":[{\"level\":\"opus\",\"task\":\"t\",\"state\":1,\"reply\":\"r\",\"log\":\"ls\\nread a.txt\\n[The list is cut at 2,000 bytes.]\\n\",\"calls\":2,\"took\":4}]}]}");
  #assert s[0].turns[0].agents[0].nrows == 2 && cast(string) s[0].calls[cp_nth(s, 0, 0, 1)].text[0..<s[0].calls[cp_nth(s, 0, 0, 1)].text_n] == "read a.txt";
}

#test "conversation cost formatting and attempt cost selection" {
  cb: [32] u8;
  #assert cp_cost(cb[..], 0) == "";
  #assert cp_cost(cb[..], -5) == "";
  #assert cp_cost(cb[..], 50) == "<$0.0001";
  #assert cp_cost(cb[..], 700) == "$0.0007";
  #assert cp_cost(cb[..], 9999) == "$0.01";
  #assert cp_cost(cb[..], 10000) == "$0.01";
  #assert cp_cost(cb[..], 1234567) == "$1.23";
  #assert cp_cost(cb[..], 1235000) == "$1.24";
  ab: [512] u8; ar: [1] ClArena; ar[0].buf = ab[..]; l: [1] MwwLine;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":12500}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 12500;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"openrouter\",\"outcome\":\"done\",\"status\":200,\"provider_cost_usd_micros\":7500,\"usd_micros\":9999}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 7500;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"retried\",\"status\":429}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 0;
}

#test "per-thread max budget defaults to $50, persists across save/load/take, auto-stops on exceed, and requires manual approval or budget increase" {
  p: [1] CoderPage; s := p[..];
  cp_init(s);
  #assert coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  #assert coder_page_set_budget_usd_micros(s, 100000) && coder_page_budget_usd_micros(s) == 100000;
  #assert !coder_page_set_budget_usd_micros(s, 0) && !coder_page_set_budget_usd_micros(s, -5);
  // Start a turn and exceed the $0.10 budget: page automatically asks host to stop.
  #assert coder_page_set_text(s, "do work") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":100000}") == MWW_ATTEMPT;
  #assert coder_page_cost_usd_micros(s) == 100000 && coder_page_budget_exceeded(s) && coder_page_action(s) == CP_ASK_STOP;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\"}") == MWW_ENDED && !cp_running(s);
  // New turns are blocked while over budget.
  #assert coder_page_set_text(s, "more work") && !coder_page_submit(s);
  // Persist and reload preserves custom budget and cost.
  kept: [16384] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && coder_page_new(s) && coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  #assert coder_page_load(s, cast(string) kept[0..<kn]) && coder_page_budget_usd_micros(s) == 100000 && coder_page_cost_usd_micros(s) == 100000 && coder_page_budget_exceeded(s);
  // Older chats without budget_usd_micros default to $50.
  #assert coder_page_load(s, "{\"v\":1,\"cost_usd_micros\":5000,\"turns\":[{\"ask\":\"hi\",\"reply\":\"hello\"}]}") && coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  // Reload over-budget chat, approve continuing above budget, verify unblocked and save_due.
  #assert coder_page_load(s, cast(string) kept[0..<kn]) && coder_page_budget_exceeded(s) && !coder_page_save_due(s);
  #assert coder_page_budget_approve(s) && !coder_page_budget_exceeded(s) && coder_page_save_due(s);
  // Persist override across save/load.
  kn2 := coder_page_save(s, kept[..]);
  #assert kn2 > 0 && coder_page_load(s, cast(string) kept[0..<kn2]) && !coder_page_budget_exceeded(s) && s[0].budget_override;
  // Can now submit a new turn; raising budget above current cost clears override; lowering re-triggers exceeded + stop.
  #assert coder_page_set_text(s, "continue") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_set_budget_usd_micros(s, 500000) && !s[0].budget_override && !coder_page_budget_exceeded(s);
  #assert coder_page_set_budget_usd_micros(s, 50000) && coder_page_budget_exceeded(s) && coder_page_action(s) == CP_ASK_STOP;
}

#test "per-thread max budget and override transfer across coder_page_take and reset the source page" {
  p: [1] CoderPage; s := p[..]; q: [1] CoderPage; b := q[..];
  cp_init(s); cp_init(b);
  #assert coder_page_set_budget_usd_micros(s, 100000) && coder_page_budget_approve(s);
  #assert coder_page_set_text(s, "run") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_take(b, s);
  #assert coder_page_budget_usd_micros(b) == 100000 && b[0].budget_override;
  #assert coder_page_budget_usd_micros(s) == 50000000 && !s[0].budget_override;
}

#test "desktop skin matches Claude sidebar proportions while keeping Coder monochrome palette" {
  u: f32 = ARCADE_PHONE_SCALE;
  k := cp_skin();
  base := arcade_phone_skin();
  // Structure/geometry matches Claude Desktop at 1.2x scale (280pt sidebar, 32pt rows, 26pt headers, 8pt inset/radius, 16pt pad).
  #assert CP_SIDE == 234;
  #assert k.app.side_row * u > 31.9f32 && k.app.side_row * u < 32.1f32;
  #assert k.app.side_head * u > 25.9f32 && k.app.side_head * u < 26.1f32;
  #assert k.app.row_inset * u > 7.9f32 && k.app.row_inset * u < 8.1f32;
  #assert k.app.row_radius * u > 7.9f32 && k.app.row_radius * u < 8.1f32;
  #assert k.app.side_pad * u > 15.9f32 && k.app.side_pad * u < 16.1f32;
  // Main-area typography is smaller than Arcade default while sidebar (k.small) stays unchanged.
  #assert k.small.face == base.small.face && k.small.size == base.small.size;
  #assert k.body.size < base.body.size && k.mono.size < base.mono.size && k.tool.size < base.tool.size && k.label.size < base.label.size;
  // Composer geometry matches Claude Desktop card proportions.
  #assert k.cmp.radius * u > 15.9f32 && k.cmp.radius * u < 16.1f32;
  #assert k.cmp.send * u > 31.9f32 && k.cmp.send * u < 32.1f32;
  #assert k.cmp.chip_h * u > 27.9f32 && k.cmp.chip_h * u < 28.1f32;
  // Color palette stays Coder's own Arcade monochrome.
  #assert k.canvas.r == base.canvas.r && k.surface.r == base.surface.r && k.ink.r == base.ink.r;
}

#test "sidebar footer draws demo pills stacked in the footer region" {
  u0: [64] Prim; o0: [64] Prim; l0: [16] SheetLine; h0: [16] SheetHit; p0: [512] u8; r0: [16] El;
  u1: [64] Prim; o1: [64] Prim; l1: [16] SheetLine; h1: [16] SheetHit; p1: [512] u8; r1: [16] El;
  sf: [1] UiSurface;
  sf[0] = surface_over(
    Sheet.{under = u0[..], over = o0[..], lines = l0[..], hits = h0[..], pool = p0[..]}, r0[..],
    Sheet.{under = u1[..], over = o1[..], lines = l1[..], hits = h1[..], pool = p1[..]}, r1[..]);
  keys: [16] Keyed; ks: [1] KeyedStore; ks[0] = KeyedStore.{rows = keys[..]};
  k := cp_skin();
  f: [1] UiFrame;
  h: f32 = 660.0f32;
  footer_h := cp_side_footer_h(k);
  #assert footer_h > 2.0f32 * k.cmp.chip_h;
  uiframe_begin(f[..], sf[..], ks[..], measure_cells(), k, uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_side_footer(f[..], 0, h - footer_h, cast(f32) CP_SIDE - k.border);
  #assert uiframe_end(f[..], sf[..]);
  u_idx := surface_find(sf[..], "coder.side.pill.update");
  p_idx := surface_find(sf[..], "coder.side.pill.provider");
  #assert u_idx >= 0 && p_idx >= 0;
  tb := surface_rows(sf[..]);
  u_row := tb.rows[u_idx];
  p_row := tb.rows[p_idx];
  #assert u_row.action == 0 && p_row.action == 0;
  #assert p_row.y > u_row.y;
  #assert u_row.y > h - footer_h && p_row.y + p_row.h < h;
}
