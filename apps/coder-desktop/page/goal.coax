// Coder Desktop page (../page.coax): the chat's cost and budget, the thread goal and /goal, and their
// host calls.

// ---- Thread Goals (/goal), ported from openai/codex ----
cp_budget :: (s: [] CoderPage) -> int {
  return ifx s[0].budget_usd_micros > 0 then s[0].budget_usd_micros else CP_BUDGET_DEFAULT;
}
cp_budget_exceeded :: (s: [] CoderPage) -> bool {
  return !s[0].budget_override && s[0].cost_usd_micros >= cp_budget(s);
}
cp_add_cost :: (s: [] CoderPage, delta: int) {
  if delta <= 0 { return; }
  s[0].cost_usd_micros += delta;
  if cp_budget_exceeded(s) && cp_running(s) && !s[0].turns[s[0].nturns - 1].stopping {
    if s[0].goal_status == CP_GOAL_ACTIVE { s[0].goal_status = CP_GOAL_BUDGET_LIMITED; }
    s[0].turns[s[0].nturns - 1].stopping = true;
    s[0].ask = CP_ASK_STOP;
  }
}
cp_goal_reset :: (s: [] CoderPage) {
  s[0].goal_status = CP_GOAL_NONE; s[0].goal_objective_n = 0; s[0].goal_time_seconds = 0;
  s[0].goal_turns = 0; s[0].goal_prompt_kind = CP_GOAL_PROMPT_NONE; s[0].goal_turn_began = 0;
  s[0].goal_notice_n = 0;
}
cp_goal_set_notice :: (s: [] CoderPage, text: string) {
  s[0].goal_notice_n = cp_out(s[0].goal_notice[..], text);
}
cp_goal_status_label :: (st: int) -> string {
  if st == CP_GOAL_ACTIVE { return "Active"; }
  if st == CP_GOAL_PAUSED { return "Paused"; }
  if st == CP_GOAL_COMPLETE { return "Complete"; }
  if st == CP_GOAL_BLOCKED { return "Blocked"; }
  if st == CP_GOAL_BUDGET_LIMITED { return "Budget limit"; }
  return "None";
}
cp_goal_elapsed :: (out: [] u8, secs: int) -> string {
  if secs <= 0 { n := el_put(out, 0, "<1m"); return cast(string) out[0..<n]; }
  if secs < 60 { n := el_put_i(out, 0, secs); n = el_put(out, n, "s"); return cast(string) out[0..<n]; }
  mins := secs / 60;
  if mins < 60 { n := el_put_i(out, 0, mins); n = el_put(out, n, "m"); return cast(string) out[0..<n]; }
  hrs := mins / 60; rem := mins % 60;
  n := el_put_i(out, 0, hrs); n = el_put(out, n, "h");
  if rem > 0 { n = el_put_i(out, n, rem); n = el_put(out, n, "m"); }
  return cast(string) out[0..<n];
}
cp_goal_account_turn :: (s: [] CoderPage) {
  if s[0].goal_status == CP_GOAL_NONE || s[0].goal_turn_began <= 0 { return; }
  dt := cast(int) (s[0].clock - s[0].goal_turn_began);
  if dt > 0 { s[0].goal_time_seconds += dt; }
  s[0].goal_turn_began = 0;
}
cp_start_turn :: (s: [] CoderPage, ask_text: string, prompt_kind: int) -> bool {
  if ask_text.count == 0 || cp_running(s) || cp_full(s) || cp_budget_exceeded(s) { return false; }
  i := s[0].nturns;
  s[0].turns[i].ask_n = cp_out(s[0].turns[i].ask[..], ask_text);
  s[0].turns[i].reply_n = 0; s[0].turns[i].head = 0; s[0].turns[i].tail = 0; s[0].turns[i].ncmds = 0; s[0].turns[i].early_cmds = 0; s[0].turns[i].more_cmds = 0; s[0].turns[i].cut = false; s[0].turns[i].blocks = 0; s[0].turns[i].note_n = 0; s[0].turns[i].steered_n = 0;
  // a new chat uses the first turns again: nothing of the old ones may show (their sub-agents did, once)
  s[0].turns[i].nagents = 0; s[0].turns[i].round_asked = 0; s[0].turns[i].waiting = false; s[0].turns[i].info = false; s[0].results_due = false;
  s[0].turns[i].state = CP_RUNNING; s[0].turns[i].stopping = false; s[0].turns[i].fresh = false; s[0].turns[i].h = 0;
  s[0].turns[i].model = s[0].model;
  s[0].turns[i].began = s[0].clock; s[0].turns[i].fold = APP_ACT_UNCHOSEN;
  s[0].turns[i].heard = false; s[0].turns[i].took = -1; s[0].turns[i].ask_open = false; s[0].turns[i].seen_h = 0;
  s[0].rev_n += 1; s[0].turns[i].rev = s[0].rev_n;
  s[0].model_menu = false;
  s[0].nturns += 1; s[0].live_ask = i; s[0].live_reply = -1; s[0].pane_manual = false;
  s[0].goal_prompt_kind = prompt_kind;
  if s[0].goal_status == CP_GOAL_ACTIVE {
    s[0].goal_turns += 1;
    s[0].goal_turn_began = ifx s[0].clock > 0 then s[0].clock else 0.001f32;
  }
  cp_glide_end(s); s[0].ask = CP_ASK_SEND;   // the view glides to the new message (#13745)
  return true;
}
cp_goal_start_or_update :: (s: [] CoderPage, objective: string) -> bool {
  obj := cp_trim(objective);
  if obj.count == 0 { cp_goal_set_notice(s, CP_GOAL_USAGE); return false; }
  had := s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0;
  s[0].goal_objective_n = cp_out(s[0].goal_objective[..], obj);
  s[0].goal_status = CP_GOAL_ACTIVE;
  if !had { s[0].goal_time_seconds = 0; s[0].goal_turns = 0; }
  s[0].goal_notice_n = 0;
  if cp_budget_exceeded(s) {
    s[0].goal_status = CP_GOAL_BUDGET_LIMITED;
    cp_goal_set_notice(s, "Goal saved, but chat budget is reached. Approve or increase budget, then run /goal resume.");
    return true;
  }
  if cp_full(s) {
    cp_goal_set_notice(s, "Goal saved, but this chat reached its 24-message limit. Start a new chat to run it.");
    return true;
  }
  if !cp_running(s) {
    ask_buf: [CP_GOAL_TEXT + 32] u8;
    an := el_put(ask_buf[..], 0, ifx had then "/goal (updated) " else "/goal ");
    an += cp_out(ask_buf[an..<ask_buf.count], obj);
    _ := cp_start_turn(s, cast(string) ask_buf[0..<an], ifx had then CP_GOAL_PROMPT_UPDATED else CP_GOAL_PROMPT_START);
  }
  return true;
}
cp_goal_set_status :: (s: [] CoderPage, st: int) -> bool {
  if s[0].goal_status == CP_GOAL_NONE || s[0].goal_objective_n == 0 {
    cp_goal_set_notice(s, "No active goal. Use /goal <objective> to set one.");
    return false;
  }
  s[0].goal_status = st;
  s[0].goal_notice_n = 0;
  if st == CP_GOAL_PAUSED {
    cp_goal_account_turn(s);
    if cp_running(s) && !s[0].turns[s[0].nturns - 1].stopping {
      s[0].turns[s[0].nturns - 1].stopping = true;
      s[0].ask = CP_ASK_STOP;
    }
    cp_goal_set_notice(s, "Goal paused. Use /goal resume to continue.");
    return true;
  }
  if st == CP_GOAL_COMPLETE {
    cp_goal_account_turn(s);
    if cp_running(s) && !s[0].turns[s[0].nturns - 1].stopping {
      s[0].turns[s[0].nturns - 1].stopping = true;
      s[0].ask = CP_ASK_STOP;
    }
    cp_goal_set_notice(s, "Goal marked complete.");
    return true;
  }
  if st == CP_GOAL_ACTIVE {
    if cp_budget_exceeded(s) {
      s[0].goal_status = CP_GOAL_BUDGET_LIMITED;
      cp_goal_set_notice(s, "Chat budget is reached. Approve continuing above budget or increase the limit first.");
      return true;
    }
    if !cp_running(s) && !cp_full(s) {
      _ := cp_start_turn(s, "Continue working toward the active thread goal.", CP_GOAL_PROMPT_CONTINUE);
    }
    return true;
  }
  return true;
}
cp_goal_clear :: (s: [] CoderPage) -> bool {
  had := s[0].goal_status != CP_GOAL_NONE;
  cp_goal_reset(s);
  if cp_running(s) && !s[0].turns[s[0].nturns - 1].stopping {
    s[0].turns[s[0].nturns - 1].stopping = true;
    s[0].ask = CP_ASK_STOP;
  }
  cp_goal_set_notice(s, ifx had then "Goal cleared." else "No active goal to clear.");
  return true;
}
cp_goal_on_turn_end :: (s: [] CoderPage, i: int, ending: string, text: string) {
  cp_goal_account_turn(s);
  if s[0].goal_status != CP_GOAL_ACTIVE || s[0].goal_objective_n == 0 { return; }
  if s[0].turns[i].stopping {
    if cp_budget_exceeded(s) {
      s[0].goal_status = CP_GOAL_BUDGET_LIMITED;
      cp_goal_set_notice(s, "Goal reached the chat budget. Approve or increase budget, then run /goal resume.");
    } else {
      s[0].goal_status = CP_GOAL_PAUSED;
    }
    return;
  }
  if ending == "asked" {
    s[0].goal_status = CP_GOAL_BLOCKED;
    cp_goal_set_notice(s, "Goal waiting for your input. Reply or run /goal resume.");
    return;
  }
  if ending != "finished" {
    s[0].goal_status = CP_GOAL_BLOCKED;
    cp_goal_set_notice(s, "Goal blocked because the turn failed. Run /goal resume to retry.");
    return;
  }
  reply := ifx text.count > 0 then text else cast(string) s[0].turns[i].reply[0..<s[0].turns[i].reply_n];
  if cp_contains(reply, "[GOAL_COMPLETE]") {
    s[0].goal_status = CP_GOAL_COMPLETE;
    cp_goal_set_notice(s, "Goal completed.");
    return;
  }
  if cp_contains(reply, "[GOAL_BLOCKED]") {
    s[0].goal_status = CP_GOAL_BLOCKED;
    cp_goal_set_notice(s, "Goal blocked: needs user input. Reply or run /goal resume.");
    return;
  }
  if cp_budget_exceeded(s) {
    s[0].goal_status = CP_GOAL_BUDGET_LIMITED;
    cp_goal_set_notice(s, "Goal reached the chat budget. Approve or increase budget, then run /goal resume.");
    return;
  }
  if cp_full(s) {
    s[0].goal_status = CP_GOAL_PAUSED;
    cp_goal_set_notice(s, "Goal paused: this chat reached its 24-message limit.");
    return;
  }
  _ := cp_start_turn(s, "Continue working toward the active thread goal.", CP_GOAL_PROMPT_CONTINUE);
}
// Handles /goal slash commands entered in the composer. Returns true if the input was a /goal command.
cp_goal_slash :: (s: [] CoderPage, raw: string) -> bool {
  trimmed := cp_trim(raw);
  if trimmed.count < 5 { return false; }
  if !cp_eq_ci(cast(string) trimmed[0..<5], "/goal") { return false; }
  if trimmed.count > 5 && !cp_is_space(trimmed[5]) { return false; }
  eb_set(s[0].draft[..], "");
  rest := ifx trimmed.count > 5 then cp_trim(cast(string) trimmed[5..<trimmed.count]) else "";
  if rest.count == 0 {
    s[0].goal_notice_n = 0;
    s[0].ask = CP_ASK_GOAL;
    return true;
  }
  // split first token for subcommands
  sp := 0;
  while sp < rest.count && !cp_is_space(rest[sp]) { sp += 1; }
  cmd := cast(string) rest[0..<sp];
  tail := ifx sp < rest.count then cp_trim(cast(string) rest[sp..<rest.count]) else "";
  if tail.count == 0 {
    if cp_eq_ci(cmd, "edit") {
      s[0].goal_notice_n = 0;
      s[0].ask = CP_ASK_GOAL;
      return true;
    }
    if cp_eq_ci(cmd, "pause") { _ := cp_goal_set_status(s, CP_GOAL_PAUSED); return true; }
    if cp_eq_ci(cmd, "resume") { _ := cp_goal_set_status(s, CP_GOAL_ACTIVE); return true; }
    if cp_eq_ci(cmd, "complete") || cp_eq_ci(cmd, "done") { _ := cp_goal_set_status(s, CP_GOAL_COMPLETE); return true; }
    if cp_eq_ci(cmd, "clear") { _ := cp_goal_clear(s); return true; }
    if cp_eq_ci(cmd, "help") { cp_goal_set_notice(s, CP_GOAL_USAGE); return true; }
  }
  _ := cp_goal_start_or_update(s, rest);
  return true;
}

cp_attempt_cost :: (l: MwwLine) -> int {
  if l.provider_cost_usd_micros.ok && l.provider_cost_usd_micros.value > 0 { return l.provider_cost_usd_micros.value; }
  if l.usd_micros.ok && l.usd_micros.value > 0 { return l.usd_micros.value; }
  return 0;
}
// Formats a microdollar total for the UI ($0.0007 under a cent, $0.12 at a cent and up).
cp_cost :: (out: [] u8, micros: int) -> string {
  if micros <= 0 { return ""; }
  if micros < 100 { n := el_put(out, 0, "<$0.0001"); return cast(string) out[0..<n]; }
  if micros < 10000 {
    tenths := (micros + 50) / 100;
    if tenths >= 100 { n := el_put(out, 0, "$0.01"); return cast(string) out[0..<n]; }
    n := el_put(out, 0, "$0.00");
    n = el_put_i(out, n, tenths / 10);
    n = el_put_i(out, n, tenths % 10);
    return cast(string) out[0..<n];
  }
  cents := (micros + 5000) / 10000;
  dollars := cents / 100;
  rem := cents % 100;
  n := el_put(out, 0, "$");
  n = el_put_i(out, n, dollars);
  n = el_put(out, n, ".");
  if rem < 10 { n = el_put(out, n, "0"); }
  n = el_put_i(out, n, rem);
  return cast(string) out[0..<n];
}
// The chat's running total cost and max budget in microdollars (1,000,000 = $1.00).
coder_page_cost_usd_micros :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].cost_usd_micros else 0; }
coder_page_budget_usd_micros :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then cp_budget(s) else CP_BUDGET_DEFAULT; }
coder_page_set_budget_usd_micros :: (s: [] CoderPage, micros: int) -> bool #export_c #effects(all) {
  if s.count < 1 || micros <= 0 { return false; }
  s[0].budget_usd_micros = micros;
  if s[0].cost_usd_micros < micros { s[0].budget_override = false; }
  if cp_budget_exceeded(s) && cp_running(s) && !s[0].turns[s[0].nturns - 1].stopping {
    s[0].turns[s[0].nturns - 1].stopping = true;
    s[0].ask = CP_ASK_STOP;
  }
  return true;
}
coder_page_budget_exceeded :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_budget_exceeded(s); }
coder_page_budget_approve :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  s[0].budget_override = true;
  if s[0].goal_status == CP_GOAL_BUDGET_LIMITED { s[0].goal_status = CP_GOAL_ACTIVE; }
  return true;
}
coder_page_goal_status :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].goal_status else CP_GOAL_NONE; }
coder_page_goal_time :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].goal_time_seconds else 0; }
coder_page_goal_objective :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].goal_objective_n == 0 { return 0; }
  return cp_out(out, cast(string) s[0].goal_objective[0..<s[0].goal_objective_n]);
}
coder_page_goal_set :: (s: [] CoderPage, objective: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return cp_goal_start_or_update(s, objective);
}
coder_page_goal_set_status :: (s: [] CoderPage, status: int) -> bool #export_c #effects(all) {
  if s.count < 1 || status < CP_GOAL_ACTIVE || status > CP_GOAL_BUDGET_LIMITED { return false; }
  return cp_goal_set_status(s, status);
}
coder_page_goal_clear :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return cp_goal_clear(s);
}
