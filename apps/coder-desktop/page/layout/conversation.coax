// Coder Desktop page (../../page.coax): the conversation: a message's activity group, the
// messages and replies, the notices, the corner buttons and the composer.

// Row q of a message as its activity group shows it (#13731): a thought's words, a file read by
// its name, or a command on one line that opens onto the whole of it and what came back.
cp_act_row :: (s: [] CoderPage, f: [] UiFrame, q: int, w: f32) -> AppActRow {
  sh := f[0].sheet;
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; output := cp_call_text(s, q);
  if s[0].calls[q].thought || s[0].calls[q].said {
    r := AppActRow.{kind = APP_ACT_THOUGHT, verb = "Thought process", output = output};
    // its words read as a reply does: its Markdown, parsed into this frame's document
    at := s[0].think_at; b0 := s[0].think[at].nb;
    r.blocks = md_parse(s[0].think[at..<at + 1], output, 0);
    if r.blocks > 0 { r.doc = s[0].think[at..<at + 1]; r.block0 = b0; }
    else {
      // the document is full: its words as they are, wrapped to the row
      wb := s[0].scratch[..];
      per := cast(int) ((w - f[0].skin.act.gutter) / measure_width(f[0].m, f[0].skin.body.face, "0")) - 1; if per < 8 { per = 8; }
      wn := cp_wrap(wb, output, per);
      r.output = sheet_pool(sh, cast(string) wb[0..<wn]);
    }
    return r;
  }
  if s[0].calls[q].read {
    // a file by its name; the row opens onto its whole path and what was read
    base := 0;
    for c, ci: text { if c == '/' && ci + 1 < text.count { base = ci + 1; } }
    return AppActRow.{kind = APP_ACT_READ, verb = "Read", target = sheet_pool(sh, cast(string) text[base..<text.count]),
                      call = ifx base > 0 then text else "", output = output, failed = s[0].calls[q].failed};
  }
  return AppActRow.{kind = APP_ACT_EXEC, verb = "Ran", target = sheet_single_line(sh, text), call = text, output = output,
                    failed = s[0].calls[q].failed, running = s[0].calls[q].running};
}
// Sub-agent j of turn i as a row of its message's group: "Ran a subagent", its model and its
// task's first line; a press opens its transcript beside the conversation.
cp_act_agent :: (s: [] CoderPage, f: [] UiFrame, i: int, j: int) -> AppActRow {
  g := s[0].turns[i].agents[j];
  task := sheet_single_line(f[0].sheet, cast(string) g.task[0..<g.task_n]);
  tb: [CP_AGENT_TASK + 32] u8; n := el_put(tb[..], 0, CP_LEVEL_NAME[g.level]);
  if task.count > 0 { n = el_put(tb[..], n, " · "); n = el_put(tb[..], n, task); }
  return AppActRow.{kind = APP_ACT_AGENT, verb = "Ran a subagent", target = sheet_pool(f[0].sheet, cast(string) tb[0..<n]),
                    failed = g.state == CP_FAILED, running = g.state == CP_RUNNING && !g.paused, opens = true};
}
// Turn i's activity group at (x, y), cw wide (#13731): the summary, counted in Zeron's words;
// open while the message works or when the person opened it, its thoughts, commands, reads and
// sub-agents in the order they came, a tree down their left. Rows out of view between top and
// bottom keep their place and are not drawn. Returns its height, 0 when it did nothing.
cp_group :: (s: [] CoderPage, f: [] UiFrame, i: int, x: f32, y0: f32, cw: f32, top: f32, bottom: f32) -> f32 {
  a := f[0].skin.act; sh := f[0].sheet;
  nagents := s[0].turns[i].nagents; early := s[0].turns[i].early_cmds; more := s[0].turns[i].more_cmds;
  if s[0].turns[i].ncmds + nagents + early + more == 0 { return 0; }
  // the summary: every kind it did, counted
  c := [1] AppActCount.[AppActCount.{}];
  q := s[0].turns[i].head - 1;
  while q >= 0 {
    kind := ifx s[0].calls[q].thought || s[0].calls[q].said then APP_ACT_THOUGHT else ifx s[0].calls[q].read then APP_ACT_READ else APP_ACT_EXEC;
    app_act_count(c[..], kind, s[0].calls[q].failed);
    q = s[0].calls[q].next - 1;
  }
  for j: 0..<nagents { app_act_count(c[..], APP_ACT_AGENT, s[0].turns[i].agents[j].state == CP_FAILED); }
  sb: [256] u8; sn := app_act_summary(sb[..], c[0]);
  if sn == 0 { sn = el_put(sb[..], 0, "Worked"); }
  live := s[0].turns[i].state == CP_RUNNING;
  open := app_act_open(s[0].turns[i].fold, live);
  ib: [EL_ID] u8; tb: [EL_ID] u8; xb: [EL_ID] u8;
  y := y0;
  y += app_act_head(f, cp_id(ib[..], i, ".grp"), x, y, cw, sheet_pool(sh, cast(string) sb[0..<sn]), live, open, CP_GROUP);
  if !open { return y - y0; }
  // the tree's rows: its sub-agents each in its place among the message's own, after the rows
  // that came before it was handed over
  last := s[0].turns[i].ncmds + nagents - 1; pos := 0; drawn := 0;
  if early > 0 {
    eb: [96] u8; en := el_put_i(eb[..], 0, early); en = el_put(eb[..], en, ifx early == 1 then " earlier row is not shown. A chat keeps 6,000 tool calls and thoughts." else " earlier rows are not shown. A chat keeps 6,000 tool calls and thoughts.");
    y += app_meta(f, cp_id(ib[..], i, ".xe"), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) eb[0..<en]), false);
  }
  q = s[0].turns[i].head - 1; at := early;
  while q >= 0 || drawn < nagents {
    if drawn < nagents && (q < 0 || s[0].turns[i].agents[drawn].after <= at) {
      y += app_act_row(f, app_id(tb[..], cp_id(xb[..], i, ".g"), CP_CMD_IDS[drawn]), x, y, cw, cp_act_agent(s, f, i, drawn), pos < last, CP_AGENT);
      drawn += 1; pos += 1; continue;
    }
    nx := s[0].calls[q].next - 1;
    // a row out of view keeps its place and is not drawn, so a long run costs what shows
    rh := s[0].calls[q].h;
    if rh > 0 && (y + rh < top - CP_PANE_MARGIN || y > bottom + CP_PANE_MARGIN) { y += rh; q = nx; at += 1; pos += 1; continue; }
    rh = app_act_row(f, cp_row_id(tb[..], i, at), x, y, cw, cp_act_row(s, f, q, cw), pos < last, CP_TOOL);   // a row keeps its id when older ones go, so an open row stays open
    s[0].calls[q].h = rh; y += rh;
    q = nx; at += 1; pos += 1;
  }
  if more > 0 {
    mb: [96] u8; mn := el_put_i(mb[..], 0, more); mn = el_put(mb[..], mn, " more ran after these and were not kept.");
    y += app_meta(f, cp_id(ib[..], i, ".xm"), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) mb[0..<mn]), false);
  }
  return y - y0;
}
// The conversation from x, cw wide, in the window up to w: the messages, their groups and replies,
// the notices, the goal and the budget, scrolling above the composer.
cp_conversation :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  side := a.icon_button; edge := (side - a.icon) / 2;   // a Copy's icon sits on its message's edge
  bar := ifx s[0].box.height > 0 then s[0].box.height else 80.0f32;
  top: f32 = 0; bottom := h - CP_BOTTOM - bar;   // what scrolls runs up to the bar
  s[0].view = bottom - top;
  if s[0].stick { s[0].scroll = s[0].content - s[0].view; if s[0].scroll < 0 { s[0].scroll = 0; } }
  uiframe_clip(f, left, top, w, bottom);
  y := top - s[0].scroll + a.gap;
  // where the column reaches under a corner's buttons, the first message starts below them
  right_corner := (ifx left > 0 then side else 2 * side) + CP_CORNER + 128.0f32;
  if x + cw > w - right_corner || left == 0 && x < CP_CORNER + CP_FOLDER_MOST { y += CP_CORNER + side; }
  is_foreman := cast(string) s[0].current[0..<s[0].current_n] == "chat.foreman";
  if is_foreman { y += cp_foreman_hud(s, f, x, y, cw, running, exceeded); }
  if s[0].nturns == 0 {
    if is_foreman {
      _ := app_empty(f, "coder.empty", x, y + a.gap, cw, ICON_BOT, "Foreman is standing by", "Describe a goal or delegate work across managed chats.");
    } else {
      _ := app_empty(f, "coder.empty", x, top + s[0].view / 3, cw, ICON_THOUGHT, "What do you want to do?", "Microcoder answers on Gemini 4 Neon.");
    }
  }
  ib: [EL_ID] u8;
  for i: 0..<s[0].nturns {
    th := s[0].turns[i].h;
    if th > 0 && s[0].turns[i].hw == cw && (y + th < top || y > bottom) { y += th; s[0].turns[i].ah = 0; }
    else {
      y0 := y;
      enter := f[0].skin.motion.enter;
      if s[0].live_ask != i { f[0].skin.motion.enter = 0; }
      y += app_message_user(f, cp_id(ib[..], i, ".u"), x, y, cw, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n]);
      f[0].skin.motion.enter = enter; if s[0].live_ask == i { s[0].live_ask = -1; }
      asked := s[0].copied_kind == CP_COPIED_ASK && s[0].copied_turn == i;
      y += app_icon_button(f, cp_id(ib[..], i, ".uc"), x + cw - side + edge, y, ifx asked then k.icon_check else k.icon_copy, ifx asked then "Copied" else "Copy message", APP_BUTTON_QUIET, 0, CP_COPY_ASK) + a.gap_small;
      // what it did on its way to the reply: one activity group (#13731)
      gh := cp_group(s, f, i, x, y, cw, top, bottom);
      if gh > 0 { y += gh + a.gap; }
      if s[0].turns[i].reply_n > 0 {
        s[0].turns[i].ay = y;
        if s[0].live_reply != i { f[0].skin.motion.enter = 0; }
        y += app_message_agent(f, cp_id(ib[..], i, ".a"), x, y, cw, s[0].turns[i].doc[..], s[0].turns[i].blocks,
                               ifx s[0].copied_kind == CP_COPIED_BLOCK && s[0].copied_turn == i then s[0].copied_block else -1, CP_COPY);
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
        s[0].turns[i].ah = y - s[0].turns[i].ay;
        if s[0].turns[i].state != CP_RUNNING {
          did := s[0].copied_kind == CP_COPIED_REPLY && s[0].copied_turn == i;
          // who wrote it, beside Copy, after a click on the reply
          if s[0].turns[i].info { _ := app_meta(f, cp_id(ib[..], i, ".m"), x - edge + side, y + (side - k.small.line) / 2, cw - side, cp_model_meta(s, s[0].turns[i].model), false); }
          y += app_icon_button(f, cp_id(ib[..], i, ".ac"), x - edge, y, ifx did then k.icon_check else k.icon_copy, ifx did then "Copied" else "Copy message", APP_BUTTON_QUIET, 0, CP_COPY_REPLY);
        } else { y += a.gap; }
      } else { s[0].turns[i].ah = 0; }
      if s[0].turns[i].cut {
        f[0].skin.motion.enter = 0;
        y += app_notice(f, cp_id(ib[..], i, ".c"), x, y, cw, "This reply is longer than 60,000 bytes. The rest is not shown.", APP_NOTICE_INFO) + a.gap;
        f[0].skin.motion.enter = enter;
      }
      st := s[0].turns[i].state;
      if st == CP_RUNNING { y += app_working(f, cp_id(ib[..], i, ".t"), x, y, cast(int) (s[0].clock - s[0].turns[i].began), i, ifx s[0].turns[i].stopping then "Stopping…" else "") + a.gap; }
      else if st == CP_FAILED {
        if s[0].live_reply != i { f[0].skin.motion.enter = 0; }
        y += app_notice(f, cp_id(ib[..], i, ".n"), x, y, cw, cast(string) s[0].turns[i].note[0..<s[0].turns[i].note_n], APP_NOTICE_ERROR) + a.gap;
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
      }
      else if st == CP_STOPPED { y += app_meta(f, cp_id(ib[..], i, ".s"), x, y, cw, "Stopped", false) + a.gap; }
      if i + 1 < s[0].nturns { y += a.gap; }
      s[0].turns[i].h = ifx st == CP_RUNNING then 0.0f32 else y - y0; s[0].turns[i].hw = cw;
    }
  }
  enter0 := f[0].skin.motion.enter;
  if full && !running {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.full", x, y, cw, "This chat holds 24 messages. Start a new chat to send more.", APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0 {
    gb: [640] u8; tb_el: [32] u8;
    gn := el_put(gb[..], 0, "Goal ("); gn = el_put(gb[..], gn, cp_goal_status_label(s[0].goal_status));
    gn = el_put(gb[..], gn, " · "); gn = el_put(gb[..], gn, cp_goal_elapsed(tb_el[..], s[0].goal_time_seconds));
    gn = el_put(gb[..], gn, "): ");
    obj_cut := ifx s[0].goal_objective_n > 280 then 280 else s[0].goal_objective_n;
    gn += cp_out(gb[gn..<gb.count], cast(string) s[0].goal_objective[0..<obj_cut]);
    if s[0].goal_objective_n > 280 { gn = el_put(gb[..], gn, "..."); }
    f[0].skin.motion.enter = 0;
    gkind := ifx s[0].goal_status == CP_GOAL_BLOCKED || s[0].goal_status == CP_GOAL_BUDGET_LIMITED then APP_NOTICE_ERROR else APP_NOTICE_INFO;
    y += app_notice(f, "coder.goal.banner", x, y, cw, sheet_pool(f[0].sheet, cast(string) gb[0..<gn]), gkind) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    tlabel := ifx s[0].goal_status == CP_GOAL_ACTIVE then "Pause goal" else "Resume goal";
    tw := app_button_width(f, -1, tlabel);
    ew := app_button_width(f, -1, "Edit goal");
    cw_btn := app_button_width(f, -1, "Complete");
    xw := app_button_width(f, -1, "Clear");
    bx := x;
    bh := app_button(f, "coder.goal.toggle", bx, y, tw, -1, tlabel, APP_BUTTON_DEFAULT, 0, CP_GOAL_TOGGLE);
    bx += tw + a.gap_small;
    if bx + ew <= x + cw { _ := app_button(f, "coder.goal.edit", bx, y, ew, -1, "Edit goal", APP_BUTTON_DEFAULT, 0, CP_GOAL_OPEN); bx += ew + a.gap_small; }
    if s[0].goal_status != CP_GOAL_COMPLETE && bx + cw_btn <= x + cw { _ := app_button(f, "coder.goal.complete", bx, y, cw_btn, -1, "Complete", APP_BUTTON_DEFAULT, 0, CP_GOAL_COMPLETE_ACT); bx += cw_btn + a.gap_small; }
    if bx + xw <= x + cw { _ := app_button(f, "coder.goal.clear", bx, y, xw, -1, "Clear", APP_BUTTON_DEFAULT, 0, CP_GOAL_CLEAR_ACT); }
    y += bh + a.gap;
  }
  if s[0].goal_notice_n > 0 {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.goal.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) s[0].goal_notice[0..<s[0].goal_notice_n]), APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if exceeded {
    cb1: [32] u8; bb1: [32] u8; nb: [160] u8;
    c_str := ifx s[0].cost_usd_micros > 0 then cp_cost(cb1[..], s[0].cost_usd_micros) else "$0.00";
    b_str := cp_cost(bb1[..], cp_budget(s));
    nn := el_put(nb[..], 0, "Chat budget reached ("); nn = el_put(nb[..], nn, c_str); nn = el_put(nb[..], nn, " / "); nn = el_put(nb[..], nn, b_str);
    nn = el_put(nb[..], nn, "). Approve continuing above budget or increase the limit.");
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.budget.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) nb[0..<nn]), APP_NOTICE_ERROR) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    aw := app_button_width(f, -1, "Continue above budget");
    ew := app_button_width(f, -1, "Edit budget");
    if aw + a.gap_small + ew <= cw {
      bh := app_button(f, "coder.budget.approve", x, y, aw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE);
      _ := app_button(f, "coder.budget.edit", x + aw + a.gap_small, y, ew, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT);
      y += bh + a.gap;
    } else {
      y += app_button(f, "coder.budget.approve", x, y, cw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE) + a.gap_small;
      y += app_button(f, "coder.budget.edit", x, y, cw, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT) + a.gap;
    }
  }
  uiframe_unclip(f);
  s[0].content = y + s[0].scroll - top;
}
// The Foreman chat's HUD at (x, y), cw wide: its tier, budget and managed chats. Returns the height it takes.
cp_foreman_hud :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, cw: f32, running: bool, exceeded: bool) -> f32 {
  a := f[0].skin.app;
  hud: [1] FhudData;
  hud[0].tier_label = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then "Observe" else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then "Auto" else "Managed";
  hud[0].tier_status = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then FHUD_IDLE else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then FHUD_WARN else FHUD_RUNNING;
  hud[0].foreman_busy = s[0].foreman_busy || running;
  hud[0].collapsed = s[0].foreman_hud_collapsed;
  hud[0].toggle_action = CP_FOREMAN_HUD_TOGGLE;
  for ti: 0..<s[0].nturns {
    for ai: 0..<s[0].turns[ti].nagents {
      if s[0].turns[ti].agents[ai].state == CP_RUNNING { hud[0].agents_active += 1; }
    }
  }
  fcost := ifx s[0].cost_usd_micros > 0 then cp_cost(s[0].scratch[0..<32], s[0].cost_usd_micros) else "$0.00";
  fbud := cp_cost(s[0].scratch[32..<64], cp_budget(s));
  fln := el_put(s[0].scratch[64..<128], 0, fcost); fln = el_put(s[0].scratch[64..<128], fln, " / "); fln = el_put(s[0].scratch[64..<128], fln, fbud);
  hud[0].budget_text = sheet_pool(f[0].sheet, cast(string) s[0].scratch[64..<64 + fln]);
  b_lim := cp_budget(s);
  hud[0].budget_ratio = ifx b_lim > 0 then cast(f32) s[0].cost_usd_micros / cast(f32) b_lim else 0.0f32;
  if hud[0].budget_ratio > 1.0f32 { hud[0].budget_ratio = 1.0f32; }
  hud[0].budget_status = ifx exceeded then FHUD_FAILED else ifx hud[0].budget_ratio >= 0.8f32 then FHUD_WARN else FHUD_DONE;
  for q: 0..<s[0].nchats {
    if !s[0].chats[q].managed { continue; }
    hud[0].managed_total += 1;
    if s[0].chats[q].busy { hud[0].managed_busy += 1; }
    if hud[0].nnodes < FHUD_MAX_NODES {
      nn := el_put(s[0].scratch[0..<EL_ID], 0, "foreman.node.");
      nn = el_put(s[0].scratch[0..<EL_ID], nn, cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n]);
      ntitle := cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n];
      if ntitle.count == 0 { ntitle = "Managed chat"; }
      hud[0].nodes[hud[0].nnodes] = FhudNode.{
        id = sheet_pool(f[0].sheet, cast(string) s[0].scratch[0..<nn]),
        title = sheet_pool(f[0].sheet, ntitle),
        subtitle = ifx s[0].chats[q].busy then "Running · Managed" else "Standby · Managed",
        status = ifx s[0].chats[q].busy then FHUD_RUNNING else FHUD_DONE,
        action = CP_FOREMAN_HUD_OPEN,
      };
      hud[0].nnodes += 1;
    }
  }
  return fhud_hud(f, x, y, cw, hud[..]) + a.gap;
}
// The buttons in the window's top corners: the chat's cost and goal, Copy chat, and with no sidebar
// Show sidebar and New chat.
cp_corners :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, window_w: f32, exceeded: bool) {
  k := f[0].skin; a := k.app;
  side := a.icon_button;
  // New chat floats in the window's top right corner, over what scrolls
  all := s[0].copied_kind == CP_COPIED_ALL;
  copy_x := ifx left > 0 then w - a.icon_button - CP_CORNER else w - 2 * a.icon_button - CP_CORNER;
  {
    cb: [32] u8; bb: [32] u8; lb: [64] u8;
    cost := ifx s[0].cost_usd_micros > 0 then cp_cost(cb[..], s[0].cost_usd_micros) else "$0.00";
    bud := cp_cost(bb[..], cp_budget(s));
    ln := el_put(lb[..], 0, cost); ln = el_put(lb[..], ln, " / "); ln = el_put(lb[..], ln, bud);
    label := sheet_pool(f[0].sheet, cast(string) lb[0..<ln]);
    cw_cost := app_chip_width(f, -1, label, 0);
    cx := copy_x - a.gap_small - cw_cost;
    if cx > left + CP_CORNER {
      _ := app_chip(f, "coder.cost", cx, CP_CORNER + (side - k.cmp.chip_h) / 2, 0, -1, "Chat budget", label, ifx exceeded then EL_S_CURRENT else 0, CP_BUDGET_EDIT);
    }
    if s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0 {
      glb: [64] u8; gtb: [32] u8;
      gln := el_put(glb[..], 0, "Goal · ");
      gln = el_put(glb[..], gln, cp_goal_status_label(s[0].goal_status));
      if s[0].goal_time_seconds > 0 {
        gln = el_put(glb[..], gln, " · ");
        gln = el_put(glb[..], gln, cp_goal_elapsed(gtb[..], s[0].goal_time_seconds));
      }
      glabel := sheet_pool(f[0].sheet, cast(string) glb[0..<gln]);
      gw := app_chip_width(f, -1, glabel, 0);
      gx := cx - a.gap_small - gw;
      if gx > left + CP_CORNER {
        _ := app_chip(f, "coder.goal", gx, CP_CORNER + (side - k.cmp.chip_h) / 2, 0, -1, "Thread goal", glabel, ifx s[0].goal_status == CP_GOAL_ACTIVE then EL_S_CURRENT else 0, CP_GOAL_OPEN);
      }
    }
  }
  _ := app_icon_button(f, "coder.copy", copy_x, CP_CORNER, ifx all then k.icon_check else k.icon_copy, ifx all then "Copied" else "Copy chat", APP_BUTTON_QUIET,
                       ifx s[0].nturns == 0 then EL_S_DISABLED else 0, CP_COPY_ALL);
  if left == 0 {
    if s[0].side_collapsed && window_w >= cast(f32) CP_SIDE_FROM {
      _ := app_icon_button(f, "coder.side.toggle", CP_CORNER, CP_CORNER, a.icon_nav, "Show sidebar", APP_BUTTON_QUIET, 0, CP_SIDE_TOGGLE);
    }
    _ := app_icon_button(f, "coder.new", w - a.icon_button - CP_CORNER, CP_CORNER, ICON_COMPOSE, "New chat", APP_BUTTON_QUIET,
                         ifx s[0].nturns == 0 then EL_S_DISABLED else 0, CP_NEW);
  }
}
// The composer at the window's foot, x and cw as the conversation: its working folder, the model
// chip beside Send and the models' popover above it.
cp_composer :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  c := AppComposer.{placeholder = "Message", text = eb_text(s[0].draft[..]),
    state = ifx running then APP_COMPOSER_RUNNING else ifx (full || exceeded) then APP_COMPOSER_OFF else APP_COMPOSER_READY,
    editing = s[0].focused && !s[0].model_menu, editor_h = s[0].editor_h / cp_scale(s), unit = ARCADE_PHONE_SCALE};
  s[0].box = app_composer(f, "coder.composer", "coder.composer.send", x, h - CP_BOTTOM, cw, c, CP_FIELD, CP_SEND);
  // bottom toolbar inside the composer, matching Claude Desktop: working folder on the left,
  // compact model selector beside the send button on the right, and its popover menu above it.
  box_y := (h - CP_BOTTOM) - s[0].box.height;
  row_y := box_y + s[0].box.row_y;
  chip_y := row_y + (s[0].box.send - k.cmp.chip_h) / 2;
  m_label := cp_model_label(s, cp_model_index(s));
  m_tw := measure_width(f[0].m, k.small.face, m_label);
  m_chev: f32 = 12;
  m_gap: f32 = 4;
  m_w := m_tw + m_gap + m_chev + 2 * k.cmp.chip_pad;
  m_max := s[0].box.send_x - k.cmp.action_inset - a.gap_small;
  if m_w > m_max { m_w = m_max; }
  m_x := x + s[0].box.send_x - a.gap_small - m_w;
  if s[0].folder_n > 0 {
    u: f32 = ARCADE_PHONE_SCALE;
    name := sheet_pool(f[0].sheet, cast(string) s[0].folder[0..<s[0].folder_n]);
    fx := x + k.cmp.action_inset;
    max_fw := m_x - fx - a.gap_small;
    cap := cast(f32) CP_FOLDER_MOST / u;
    if max_fw > cap { max_fw = cap; }
    if max_fw > 0 {
      _ := app_chip(f, "coder.folder", fx, chip_y, max_fw, ICON_FOLDER, "Working folder", name, ifx running then EL_S_DISABLED else 0, CP_FOLDER);
    }
  }
  if m_w > 0 {
    sh := f[0].sheet;
    m_state := ifx s[0].model_menu then EL_S_CURRENT else 0;
    m_row := uiframe_semantic(f, "coder.model", EL_BUTTON, "Model", m_x, chip_y, m_w, k.cmp.chip_h, m_state, CP_MODEL_MENU);
    elt_value(f[0].rows, m_row, m_label);
    m_hov := uiframe_hovered(f, "coder.model");
    m_bg := ifx s[0].model_menu || m_hov then k.hover else k.raised;
    _ := sheet_box(sh, m_x, chip_y, m_w, k.cmp.chip_h, k.cmp.chip_radius, k.border, m_bg, k.hairline);
    m_ink := ifx s[0].model_menu || m_hov then k.ink else k.muted;
    shown := app_fit(f, k.small.face, m_label, m_w - 2 * k.cmp.chip_pad - m_gap - m_chev);
    _ := sheet_text(sh, f[0].m, -1, m_x + k.cmp.chip_pad, chip_y + (k.cmp.chip_h - k.small.line) / 2, k.small.line, k.small.face, m_ink, shown);
    sheet_icon(sh, ICON_CHEVRON, m_x + m_w - k.cmp.chip_pad - m_chev, chip_y + (k.cmp.chip_h - m_chev) / 2, m_chev, m_ink);
    sheet_hit(sh, UIFRAME_HIT, m_row, 0, m_x, chip_y, m_w, k.cmp.chip_h);
  }
  if s[0].model_menu {
    sh := f[0].sheet;
    pw: f32 = 224;
    if pw > cw { pw = cw; }
    pad: f32 = 6;
    rh: f32 = 42;
    ph := pad * 2 + cast(f32) cp_models(s) * rh;
    px := m_x + m_w - pw;
    if px < x { px = x; }
    py := box_y - ph - 6;
    if py < 8 { py = 8; }
    // Paint the popover card in the over list so it cleanly covers underlying transcript text.
    sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, k.radius, k.border, k.raised, k.hairline));
    card_row := uiframe_semantic(f, "coder.model.menu", EL_REGION, "Models", px, py, pw, ph, 0, 0);
    sheet_hit(sh, UIFRAME_HIT, card_row, 0, px, py, pw, ph);
    mb: [32] u8;
    for mi: 0..<cp_models(s) {
      ry := py + pad + cast(f32) mi * rh;
      mn := el_put(mb[..], 0, "coder.model."); mn = el_put_i(mb[..], mn, mi);
      mid := sheet_pool(sh, cast(string) mb[0..<mn]);
      sel := mi == cp_model_index(s);
      hov := uiframe_hovered(f, mid);
      label := cp_model_label(s, mi);
      desc := cp_model_desc(s, mi);
      mrow := uiframe_semantic(f, mid, EL_BUTTON, label, px + pad, ry, pw - 2 * pad, rh, ifx sel then EL_S_CURRENT else 0, CP_MODEL_PICK);
      elt_value(f[0].rows, mrow, desc);
      if hov || sel {
        fill := ifx hov then k.hover else opacity(k.hover, 0.55f32);
        sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, ry + 1, pw - 2 * pad, rh - 2, k.cmp.chip_radius, 0, fill, Rgba.{}));
      }
      tx := px + pad + 10;
      tw := pw - 2 * pad - 34;
      _ := sheet_text(sh, f[0].m, -1, tx, ry + 5, k.body.line, k.body.face, k.ink, app_fit(f, k.body.face, label, tw));
      _ := sheet_text(sh, f[0].m, -1, tx, ry + 22, k.small.line, k.small.face, k.muted, app_fit(f, k.small.face, desc, tw));
      if sel {
        ck: f32 = 14;
        sheet_over_n(sh, prim_icon(sh[0].over, sh[0].no, ICON_CHECK, px + pw - pad - 10 - ck, ry + (rh - ck) / 2, ck, ck, k.accent));
      }
      sheet_hit(sh, UIFRAME_HIT, mrow, 0, px + pad, ry, pw - 2 * pad, rh);
    }
  }
}
