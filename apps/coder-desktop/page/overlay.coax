// Coder Desktop page (../page.coax): the dialogs and the right-click menus, drawn over the page by
// components/app/overlay.coax (GitHub #13746). The host says what a dialog or a menu holds and
// opens it; the page draws it, takes the pointer and the keys while it is up, and keeps the answer
// until the host takes it. What an answer does stays in the host (Window+Dialogs.swift,
// Window+Menus.swift). The menu bar, the status item and the folder panel stay native. The command
// palette (palette.coax, GitHub #13700) stands here too, under a dialog: its field is the page's
// fourth editor (editor.coax).

CpOverlay :: struct { dlg: [1] AppDialog; menu: [1] AppMenu; pal: [1] AppPalette; pal_cmd: int; }

// Zeron's measures, in points: the page lays out in points (GitHub #13737).
cp_ov_spec :: () -> AppOverlaySpec { return app_overlay_zeron(); }
cp_overlay_open :: (s: [] CoderPage) -> bool { return s[0].ov[0].dlg[0].shown || s[0].ov[0].menu[0].open || s[0].ov[0].pal[0].shown; }

// One frame's worth: time passes for whichever is up, then it paints over the page. True while one moves.
cp_overlay :: (s: [] CoderPage, f: [] UiFrame, w: f32, h: f32, dt: f32) -> bool {
  o := cp_ov_spec(); d := s[0].ov[0].dlg[..]; mn := s[0].ov[0].menu[..];
  pal := s[0].ov[0].pal[..];
  moving := app_dialog_step(d, dt, s[0].reduced, o) || app_menu_step(mn, dt, s[0].reduced, o);
  if app_palette_step(pal, dt, s[0].reduced, cp_pal_spec()) { moving = true; }
  // the palette's words are the page's fourth editor once it is at rest (editor.coax)
  pbox: [4] f32;
  pal[0].editing = cp_ed_which(s) == CP_ED_PALETTE && app_palette_field_box(pal, f[0].skin, cp_pal_spec(), pbox[..]);
  app_palette_paint(f, pal, w, h, o, cp_pal_spec());
  if pal[0].editing && app_palette_field_box(pal, f[0].skin, cp_pal_spec(), pbox[..]) {
    cp_ed_draw(s, f, CP_ED_PALETTE, pbox[0], pbox[1], pbox[2], pbox[3], pal[0].placeholder);
  }
  app_menu_paint(f, mn, w, h, o);
  // the field with the keyboard is the page's editor (editor.coax): the dialog leaves its words to it
  box: [5] f32;
  edit := cp_ed_which(s) == CP_ED_DIALOG && app_dialog_field_box(d, f[0].skin, o, box[..]);
  d[0].editing = edit;
  if cp_ed_dialog_field(s) < 0 { s[0].fld[0].dlg_at = -1; }
  app_dialog_paint(f, d, w, h, o);
  if edit && app_dialog_field_box(d, f[0].skin, o, box[..]) {
    i := d[0].focus;
    cp_ed_draw(s, f, CP_ED_DIALOG, box[0], box[1], box[2], box[3], cast(string) d[0].fields[i].hint[0..<d[0].fields[i].nh]);
  }
  return moving;
}

// ---------------------------------------------------------------- the host's calls

// A dialog: begin with its size (0 sm 380, 1 md 460, 2 lg 560), title and words; then its fields
// (label, text, hint, secure, lines: 1 one line, more a box of that many) and its buttons in the
// foot's order (kind 0 primary, 1 secondary, 2 destructive; aside stands at the foot's start); then
// show it with the buttons Return and Escape stand for (-1: none) and the field the keyboard starts
// on (-1 or one past the last: the first). A menu over it closes.
coder_page_dialog_begin :: (s: [] CoderPage, size: int, title: string, body: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  app_menu_close(s[0].ov[0].menu[..], APP_MENU_NONE); _ := app_menu_take(s[0].ov[0].menu[..]);
  app_dialog_begin(s[0].ov[0].dlg[..], size, title, body);
}
coder_page_dialog_field :: (s: [] CoderPage, label: string, value: string, hint: string, secure: bool, lines: int) -> bool #export_c #effects(all) {
  return s.count > 0 && app_dialog_field(s[0].ov[0].dlg[..], label, value, hint, secure, lines);
}
coder_page_dialog_button :: (s: [] CoderPage, label: string, kind: int, aside: bool) -> bool #export_c #effects(all) {
  return s.count > 0 && app_dialog_button(s[0].ov[0].dlg[..], label, kind, aside);
}
coder_page_dialog_show :: (s: [] CoderPage, confirm: int, cancel: int, focus: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].model_menu = false;
  d := s[0].ov[0].dlg[..];
  app_dialog_open(d, confirm, cancel);
  if focus >= 0 && focus < d[0].nf { d[0].focus = focus; }
}
// The answer once: the button pressed, -1 for Escape or a click on the dim, -2 while none is owed.
coder_page_dialog_answer :: (s: [] CoderPage) -> int #export_c #effects(all) {
  return ifx s.count > 0 then app_dialog_take(s[0].ov[0].dlg[..]) else APP_DLG_NONE;
}
// Field i's text (after an answer too, until the next dialog begins). Its length in out, -1 when it does not fit.
coder_page_dialog_value :: (s: [] CoderPage, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  v := app_dialog_value(s[0].ov[0].dlg[..], i);
  if v.count > out.count { return -1; }
  for c, k: v { out[k] = c; }
  return v.count;
}
// Field i's text set by the host.
coder_page_dialog_set :: (s: [] CoderPage, i: int, text: string) -> bool #export_c #effects(all) {
  return s.count > 0 && app_dialog_set(s[0].ov[0].dlg[..], i, text);
}
// A menu: begin, its items (kind 0 a row, 1 a heading, 2 a rule; checked, disabled, destructive),
// then open it at the pointer in device pixels (the pointer's own coordinates).
coder_page_menu_begin :: (s: [] CoderPage) #export_c #effects(all) { if s.count > 0 { app_menu_begin(s[0].ov[0].menu[..]); } }
coder_page_menu_item :: (s: [] CoderPage, label: string, kind: int, checked: bool, disabled: bool, danger: bool) -> bool #export_c #effects(all) {
  return s.count > 0 && app_menu_item(s[0].ov[0].menu[..], label, kind, checked, disabled, danger);
}
coder_page_menu_show :: (s: [] CoderPage, x: f32, y: f32) #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) || s[0].ov[0].dlg[0].shown || s[0].ov[0].pal[0].shown { return; }
  s[0].model_menu = false;
  app_menu_open(s[0].ov[0].menu[..], x / s[0].d, y / s[0].d);
}
// The menu's answer once: the item chosen, -1 when it closed with none, -2 while none is owed.
coder_page_menu_answer :: (s: [] CoderPage) -> int #export_c #effects(all) {
  return ifx s.count > 0 then app_menu_take(s[0].ov[0].menu[..]) else APP_MENU_WAIT;
}
// Whether a dialog or a menu is up: the pointer, the wheel and the keys are its.
coder_page_overlay_open :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_overlay_open(s); }
// The pointer while one is up, in device pixels (phases as coder_page_pointer's). True when it took it.
coder_page_overlay_pointer :: (s: [] CoderPage, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  return coder_page_overlay_press(s, x, y, phase, 1, 0);
}
// The same with the press's clicks and modifiers: in the field with the keyboard they place the
// caret, select a word (two) or the line (three), or extend (Shift).
coder_page_overlay_press :: (s: [] CoderPage, x: f32, y: f32, phase: int, clicks: int, mods: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) || !cp_overlay_open(s) { return false; }
  ux := x / s[0].d; uy := y / s[0].d;
  s[0].px = ux; s[0].py = uy; s[0].touching = false; s[0].pressed_n = 0;
  if s[0].ov[0].menu[0].open { return app_menu_pointer(s[0].ov[0].menu[..], ux, uy, phase); }
  if !s[0].ov[0].dlg[0].shown && s[0].ov[0].pal[0].shown {
    // the palette's field takes a press on its words (and the drag it starts); the rest is the list's
    if phase != 0 && s[0].fld[0].drag == CP_ED_PALETTE + 1 { _ = cp_ed_pointer(s, ux, uy, phase, clicks, mods); return true; }
    if phase == 0 && cp_ed_pointer(s, ux, uy, 0, clicks, mods) { return true; }
    took := app_palette_pointer(cp_pal(s), ux, uy, phase); cp_palette_collect(s); return took;
  }
  d := s[0].ov[0].dlg[..];
  if phase != 0 && s[0].fld[0].drag == CP_ED_DIALOG + 1 { _ = cp_ed_pointer(s, ux, uy, phase, clicks, mods); d[0].px = ux; d[0].py = uy; return true; }
  before := d[0].focus;
  took := app_dialog_pointer(d, ux, uy, phase);
  if phase == 0 && d[0].focus == before && cp_ed_which(s) == CP_ED_DIALOG { _ = cp_ed_pointer(s, ux, uy, 0, clicks, mods); }
  return took;
}
// A key while one is up (composer.coax's numbering: -1 Escape, -2 Return, -6 up, -7 down, -13 Tab;
// mods 1 Shift, 8 Command). True when it took the key; false leaves it to the dialog's editor.
coder_page_overlay_key :: (s: [] CoderPage, key: int, mods: int) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  if s[0].ov[0].menu[0].open { return app_menu_key(s[0].ov[0].menu[..], key, mods); }
  if !s[0].ov[0].dlg[0].shown && s[0].ov[0].pal[0].shown { took := app_palette_key(cp_pal(s), key, mods); cp_palette_collect(s); return took; }
  return app_dialog_key(s[0].ov[0].dlg[..], key, mods);
}
// The wheel while the palette is up: a mouse's notch as coder_page_wheel takes it (wheel), else a
// gesture's as coder_page_scroll does (dy the fingers' way; a mouse's notches in lines unless precise).
coder_page_overlay_scroll :: (s: [] CoderPage, dy: f32, precise: bool, wheel: bool) #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) || !s[0].ov[0].pal[0].open || s[0].ov[0].dlg[0].shown { return; }
  app_palette_scroll(cp_pal(s), ifx wheel then dy / s[0].d else -dy * (ifx precise then 1.0f32 else CP_WHEEL_LINE) / cp_scale(s));
}
