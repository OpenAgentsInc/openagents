#test "next issue: Stop stops between turns too, and the answer to a stopped asking is left unread" {
  s: [1] NextPanel; np_init(s[..]); out: [1200] f32; box: [4] f32; b := np_button(1320);
  #assert np_pointer(s[..], b.x + 5, b.y + 5, 0, 1320, 880) && np_pointer(s[..], b.x + 5, b.y + 5, 2, 1320, 880);
  n := np_frame(s[..], out[..], box[..], 1320, 880, 2, 0.016, 1);
  #assert s[0].state == NP_CONTEXT_WAIT && s[0].open && np_take_request(s[..]) == 1;
  #assert np_pointer(s[..], b.x + 5, b.y + 5, 0, 1320, 880) && np_pointer(s[..], b.x + 5, b.y + 5, 2, 1320, 880) && s[0].want_stop;
  n = np_frame(s[..], out[..], box[..], 1320, 880, 2, 0.016, 2);
  #assert s[0].state == NP_STOPPED && np_take_request(s[..]) == 0;
  np_context(s[..], "issues", "", true);
  #assert s[0].state == NP_STOPPED && !s[0].started;
}
#test "next issue: a picker that chose none is not pressed to start, and a run has a budget" {
  s: [1] NextPanel; np_init(s[..]);
  #assert !s[0].declined && NP_BUDGET_E6 > 0;
  np_ask(s[..], false, false); s[0].declined = true; s[0].run_cost_e6 = 5;
  np_ask(s[..], true, true); #assert !s[0].declined && s[0].run_cost_e6 == 5;
  np_ask(s[..], false, false); #assert s[0].run_cost_e6 == 0;
}
