// Everglade for desktop: Next issue (everglade/docs/next-issue-spec.md). The button at the top
// right asks one Claude agent which issue to work on next, and you answer it in your own words.
//
//   1. The host runs next-context (next-context.coax): the open issues and recent commits from the
//      cache under ~/.openagents, your recent Claude Code prompts, in one message.
//   2. One session starts through the Coax Claude Agent SDK (coax/lib/agent/claude) on your own
//      Claude Code login: NP_MODEL, no built-in tools, one in-process tool, `choose`. The session
//      stays open, so a reply is one short message more: the issues are not sent again.
//   3. The agent names one issue and why. You type a reply. The agent reads it and calls `choose`
//      with what you meant: start that issue, another one, or none. Your words are never matched
//      against keywords here; the model's typed tool call is the decision.
//   4. `start` begins the coding flow in the same chat. The host runs `next-context work N`, which
//      makes a fresh worktree off origin/main and prints the issue whole. A second session starts
//      there: NP_CODER_MODEL (EVERGLADE_CODER_MODEL overrides it), Bash, Read, Edit, Write, Grep
//      and Glob and nothing else (no subagents, no web), told to do that issue and nothing else,
//      push it and close the issue. Its messages stream into the chat and each tool call is one
//      short line. Your replies go to it. EVERGLADE_CODER_MODE=rehearsal makes it read-only: it
//      says what it would change and stops, for trying the flow without changing anything.
//
// The coding agent can be Antigravity instead (GitHub #13193): EVERGLADE_CODER_ENGINE=antigravity,
// or EVERGLADE_TIER_FAMILY=gemini, which makes the rubric name Gemini models (tier.coax). It runs on
// the shared ACP engine with Antigravity's agent (coax/lib/agent/engine/antigravity.coax, cue_* and
// agy_*), as Coder runs it, in the same worktree with the same task and rules. agy has its own
// tools, so the panel maps the Claude coder's limits onto them through its permission answers:
// rehearsal allows only reading and searching; a coding run allows edits and commands inside the
// worktree; web fetches, paths outside the worktree, subagents, the browser, web search, image
// generation and swarms are refused, and a turn that starts one unasked is stopped. agy takes no
// in-process tool, so the coder reports with a last line, `REPORT: done SUMMARY` or
// `REPORT: blocked SUMMARY`, which the panel reads from its words when the turn ends. agy reports
// tokens but no cost: the turn is priced from the rates card (coax/lib/gateway/card.coax, rates.coax's table), and that
// price goes to the ledger line and the Autopilot budget. The picker stays Claude.
//
// Autopilot (a button beside Next issue, on by default) makes it a loop with no one in it: the
// picker is told not to ask, picks and starts; when the coding agent's turn ends the caches are
// fetched again and the picker picks the next, leaving out what this run already worked. It stops
// when an agent fails, when the picker finds nothing worth starting, when the run has spent
// NP_BUDGET_E6, or when you press Stop (which also stops it between turns, while the caches are
// read or a worktree is made).
//
// The issues are only the owner's own (next-context's NC_AUTHOR): an agent with a shell is never
// handed text a stranger filed.
//
// Every turn's model, tokens and cost go to the ledger (np_take_usage, one JSON line a turn).
// The agent is polled from the frame without waiting (cl_poll), so the world keeps running.
// Drawn over the scene; workshop.coax loads this file, so the two are one unit.
//   coax/bin/coax test --library apps/everglade-desktop/next.coax --only "next issue"
#load "../../metaverse-engine/ui/draw.coax";
#load "text.coax";
#load "../../coax/lib/agent/claude/claude.coax";
#load "../../coax/lib/agent/engine/claude.coax";   // the shared Claude engine and the session record it writes
#load "../../coax/lib/agent/engine/antigravity.coax";   // the shared ACP engine with Antigravity's agent (agy_*), for an Antigravity coder
#load "../../coax/lib/gateway/card.coax";   // what Antigravity's tokens cost (the rates card): it reports none
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/agent/tier.coax";
#load "../../coax/lib/agent/ledger.coax";   // the AI-call ledger's and the decision's one writer
#load "golem-board.coax";

NP_MODEL :: "claude-haiku-5-5";
NP_TOOL :: "mcp__next__choose";
NP_SYSTEM :: "You help one developer pick the next GitHub issue to work on in their repository. You are given the open issues, recent commits, what they asked for recently, and sometimes what they say now. What they say now outweighs what they asked recently, which outweighs the commits. Prefer an issue that unblocks others, then one that continues the work in hand.\n\nSuggest exactly one issue. Write: line 1, the issue as `#NUMBER title`; then at most three short lines on why it is next, naming the signal you used; then the line `Do it?`. Plain ASCII, no Markdown, lines under 60 characters.\n\nWhen the developer answers, work out what they mean. If it is a decision, call the tool `choose` first, before you write anything: action `start` when they agree to work on an issue (the one you suggested or one they name), `another` when they turn it down or want a different one, `none` when they want to stop. Every decision is recorded through the tool, so never skip it. After `another`, suggest the next best issue in the same form, using what they said. After `start` or `none`, say in one line what the tool told you. Only if their answer is purely a question, answer it briefly without the tool.\n\nWith every `choose` call, fill the rubric below for the issue it names: the scores decide which model works it, from Haiku for housekeeping to Fable for the hardest. For `none`, give zeros. Never start an issue you rated not delegable; pick another.";
NP_ASK :: "\nSuggest the one issue to work on next.";
NP_ASK_AUTO :: "\nAutopilot is on: nobody will answer you. Pick the one issue to work on next and call `choose` with action `start` now, before any text; then say in two short lines which issue and why. If no open issue is worth starting, call `choose` with action `none`.";
NP_GO :: "Yes. Start it.";      // what Autopilot answers when the picker asks anyway
NP_WORKED :: 32;                // issues one run remembers it worked
NP_BUDGET_E6 :: 100000000;      // millionths of a dollar one Autopilot run may spend before it stops going round
NP_CHOOSE_SCHEMA :: "{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"enum\":[\"start\",\"another\",\"none\"]},\"issue\":{\"type\":\"integer\",\"description\":\"The issue number the action is about; 0 for none.\"},\"reason\":{\"type\":\"string\",\"description\":\"One line: what the developer said that decided it.\"},\"scope\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"ambiguity\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"risk\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"depth\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"delegable\":{\"type\":\"boolean\"}},\"required\":[\"action\",\"issue\",\"reason\",\"scope\",\"ambiguity\",\"risk\",\"depth\",\"delegable\"],\"additionalProperties\":false}";
NP_CHOOSE_ABOUT :: "Record what the developer decided about the suggested issue: start it, ask for another, or none.";
NP_STARTING :: "Recorded. A coding agent now starts on it in a fresh worktree, in this chat. Tell the developer that in one line.";
NP_CODER_MODEL :: "claude-opus-5-5";   // when the picker gave no usable scores
NP_CODER_RULES :: "You are working one GitHub issue for OpenAgentsInc/openagents in a fresh git worktree, detached at origin/main. Do what the issue asks and nothing else: no other issues, no cleanup it did not ask for. Read AGENTS.md and coax/start-here.md first. Run coax/build.sh once to get the compiler; it installs the published build in seconds. Run heavy builds and large test units through coax/remote/remote.sh, not on this Mac. Do not use subagents. Do not touch the main checkout or any other worktree. When the work is done and the checks for the units you touched pass: commit only your files, run git fetch origin and git rebase origin/main, push with git push origin HEAD:main, then close the issue with gh issue close NUMBER --comment naming the commit. If you cannot finish, stop, say exactly what blocks you, and leave the issue open. Never end your turn while something you started still runs (a remote check, a build, a background job): wait for it in the foreground, however long it takes. End by calling the tool report: done after you pushed and closed the issue, blocked when you stop and leave it open. Your turn is over only when you have called report. Keep your messages short: what you found and what you did. Write plain text, no Markdown.";
NP_REPORT_SCHEMA :: "{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"done\",\"blocked\"]},\"summary\":{\"type\":\"string\",\"description\":\"One line: the commit, or what blocks you.\"}},\"required\":[\"status\",\"summary\"],\"additionalProperties\":false}";
NP_REPORT_ABOUT :: "Say that your work on the issue is over: done (pushed and closed) or blocked (stopped, issue left open).";
NP_REPORT_TOOL :: "mcp__next__report";
NP_NUDGES :: 3;            // times Autopilot tells a coder that ended its turn without report to finish
NP_KEEP_GOING :: "You ended your turn without calling report, and nobody is watching. If something you started is still running, wait for it in the foreground now. Then finish the issue and call report, or call report with blocked.";
NP_CODER_REHEARSAL :: "This is a rehearsal of working one GitHub issue for OpenAgentsInc/openagents. You may only read: you have Read, Grep and Glob. Do not try to edit, commit, push or close anything. Read the issue, find the files it touches in at most eight tool calls, and say in under ten short lines of plain text, no Markdown, what you would change. Then call the tool report with done and stop.";
NP_SAID :: 8192;           // bytes of an Antigravity coder's words kept a turn
// The Antigravity coder (GitHub #13193; the panel's header says how it maps the Claude coder's rules).
NP_ENGINE_CLAUDE :: 0; NP_ENGINE_AGY :: 1;
NP_AGY_CODER_MODEL :: "gemini-4-argon";   // when the picker gave no usable scores: the Opus tier's Gemini model (agy thinks low unless a level is named)
NP_AGY_PRICE_FALLBACK :: "gemini-4-carbon";    // a model the card has no row for is priced at the dearest Gemini row, never free
NP_AGY_BARRED :: [9] string.["browser", "invoke_subagent", "send_message", "manage_subagents", "define_subagent", "search_web", "read_url", "generate_image", "swarm"];
NP_AGY_TOOLS :: "The instructions above are your system instructions. You run in the Antigravity CLI, so your tools are its own: reading and searching files, editing files and running commands, all in the worktree. Subagents, the browser, web search, reading URLs, image generation and swarms are refused here, and starting one stops your turn. There is no report tool: you report by ending your last message with one line, REPORT: done SUMMARY after you pushed and closed the issue, or REPORT: blocked SUMMARY when you stop and leave the issue open. Your turn is over only when that line is written.";
NP_AGY_REHEARSAL_TOOLS :: "The instructions above are your system instructions. You run in the Antigravity CLI: only its reading and searching tools are allowed here, and every edit or command is refused. Subagents, the browser, web search, reading URLs, image generation and swarms are refused too. There is no report tool: end your last message with one line, REPORT: done followed by a short summary.";
NP_AGY_KEEP_GOING :: "You ended your turn without the REPORT line, and nobody is watching. If something you started is still running, wait for it in the foreground now. Then finish the issue and end with REPORT: done SUMMARY, or end with REPORT: blocked SUMMARY.";
NP_INSTALL :: "Claude Code is not installed. Install it with:\ncurl -fsSL https://claude.ai/install.sh | bash";
NP_LOGIN :: "Claude Code is logged out. Log in with:\nclaude /login";

NP_TEXT :: 24000;         // bytes of the conversation kept on screen; more is cut and the panel says so
NP_CONTEXT :: 400000;     // bytes of context the model's first message may carry
NP_DRAFT :: 400;          // bytes of a reply
NP_MAX_VERTICES :: 120000;
NP_BUTTON_W :: 132.0; NP_BUTTON_H :: 34.0; NP_MARGIN :: 24.0;
NP_PANEL_W :: 500.0;      // points; narrower windows give it the width they have
NP_SIZE :: 15.0;          // the text's size (its em), points
NP_LINE :: 21.0;          // a line's height, points
NP_PAD :: 18.0;

// idle; asking the host for context; the agent's turn; your turn; the agent failed; you stopped it.
NP_IDLE :: 0; NP_CONTEXT_WAIT :: 1; NP_RUNNING :: 2; NP_YOURS :: 3; NP_FAILED :: 4; NP_STOPPED :: 5;

// The Antigravity coder's engine (the shared ACP engine, cue_*) and the buffers it reads and writes.
NpAgy :: struct {
  cue: [1] CuEngine; cu: [1] CuClient; cup: [1] ClProcess;
  line: [1048576] u8; arena: [262144] u8; out: [1048576] u8;
}

NextPanel :: struct {
  state: int; open: bool; focus: bool;
  want_start: bool; want_refresh: bool; want_stop: bool;   // a press asked; the next frame does it
  request: int;                           // what the host is asked for: 1 the context, 2 the context refetched
  text: [NP_TEXT] u8; text_n: int; cut: bool;
  draft: [NP_DRAFT] u8; draft_n: int;
  scroll: int;
  report: [256] u8; report_n: int;        // what next-context said about its caches
  context_n: int;
  // This session, and the turn in hand.
  turn: int; seconds: f32; now: int;      // now: the host's clock, seconds since the epoch
  input: int; output: int; cache_read: int; cache_write: int; cost_e6: int = -1; session_cost_e6: int;
  usage: [2048] u8; usage_n: int;         // a ledger line waiting for the host
  // A decision waiting for the host, as its values (np_decide keeps them, np_take_decision writes the line).
  decided: bool; decided_at: int; decided_issue: int; decided_scores: bool; decided_tier: int; decided_rubric: TierScores;
  decided_action: [16] u8; decided_action_n: int; decided_reason: [GY_REASON_MAX] u8; decided_reason_n: int; decided_session: [128] u8; decided_session_n: int;
  chosen: int;                            // the issue you said to start, 0 none
  autopilot: bool = true;                 // pick, work, pick again, with no one answering
  worked: [NP_WORKED] int; worked_n: int; // the issues this run has worked, which the picker is told to leave
  runs: int;                              // coding turns that have ended
  nudged: bool;                           // Autopilot has answered this picker once
  declined: bool;                         // this picker chose `none`: nothing is worth starting, so Autopilot doesn't press it
  run_cost_e6: int;                       // what this run's turns have cost, pickers and coders
  pending_work: bool;                     // you said start: when the picker's turn ends, the coding flow begins
  coding: bool;                           // the open session is the coding agent's, not the picker's
  rehearsal: bool;
  reported: int; nudges: int;             // the coder's report: 0 none yet, 1 done, 2 blocked; and how often Autopilot told it to finish
  model: [64] u8; model_n: int;           // the open session's model
  scores: TierScores; tier: int;          // the picker's rubric for the issue to start, and the tier it gives (tier.coax)
  system: [8192] u8;                      // the picker's system prompt: NP_SYSTEM and the rubric
  cwd: [2048] u8; cwd_n: int;             // the coding agent's worktree
  after_tool: bool;                       // the last line written was a tool call's
  star: bool;                             // np_say: an asterisk is held, in case the next is its pair
  down: bool; down_in: int;               // which box the press began in: 1 the button, 2 Close, 3 Refresh
  // The panel's agent (the picker, then the coder) runs on the shared Claude engine with the panel's own
  // options (np_run); the engine folds its messages into ses, and the panel answers its own tool.
  eng: [1] Engine; ses: [1] Session; opt: [1] ClOptions; pool: [262144] u8; started: bool;
  // An Antigravity coder: the shared ACP engine with agy's agent, and what the panel keeps of its turn.
  agy: bool;                              // the open session is Antigravity's (else Claude Code's)
  agy_owed: bool;                         // the first message goes once the session and its model are set
  agy_barred: bool;                       // the turn started a tool it may not use: it was stopped
  thought: int;                           // the turn's thought tokens (Antigravity's)
  priced_as: [64] u8; priced_as_n: int;   // the rates card's row the turn was priced at
  said: [NP_SAID] u8; said_n: int;        // the turn's words, for its REPORT line
  ag: [1] NpAgy;                          // its engine and buffers
  board: [1] GolemBoard;                  // the Golems board (golem-board.coax)
  line: [1048576] u8; arena: [262144] u8; out: [1048576] u8; scratch: [131072] u8;
  context: [NP_CONTEXT] u8;
}

// ---- the text

np_append :: (s: []NextPanel, t: string) {
  for c: t {
    if s[0].text_n >= NP_TEXT {
      // A long run outgrows the buffer: the oldest half goes, from a line's start.
      from := NP_TEXT / 2; while from < s[0].text_n && s[0].text[from] != '\n' { from += 1; }
      if from < s[0].text_n { from += 1; }
      for i: from..<s[0].text_n { s[0].text[i - from] = s[0].text[i]; }
      s[0].text_n -= from; s[0].cut = true;
    }
    // The faces' atlas is ASCII; anything else reads as a space.
    b := c; if (b < 32 && b != '\n') || b > 126 { b = ' '; }
    s[0].text[s[0].text_n] = b; s[0].text_n += 1;
  }
}
// What a model wrote, as plain text: the panel doesn't draw Markdown, so its backticks and its
// bold marks are left out. `star` carries a lone asterisk across two pieces of a stream.
np_say :: (s: []NextPanel, t: string) {
  for c: t {
    if c == '`' { continue; }
    if c == '*' { if s[0].star { s[0].star = false; } else { s[0].star = true; } continue; }
    if s[0].star { s[0].star = false; np_append(s, "*"); }
    one: [1] u8; one[0] = c; np_append(s, cast(string) one[..]);
  }
}
// The text ends its line, so what comes next starts a new one.
np_break :: (s: []NextPanel) { if s[0].text_n > 0 && s[0].text[s[0].text_n - 1] != '\n' { np_append(s, "\n"); } }
np_gap :: (s: []NextPanel) { np_break(s); if s[0].text_n > 1 && s[0].text[s[0].text_n - 2] != '\n' { np_append(s, "\n"); } }
np_put :: (out: []u8, n: int, text: string) -> int { m := n; for c: text { if m < out.count { out[m] = c; m += 1; } } return m; }
np_put_int :: (out: []u8, n: int, v: int) -> int {
  d: [24] u8; k := 0; x := v; if x < 0 { x = 0; }
  while x > 0 || k == 0 { d[k] = cast(u8) ('0' + x % 10); x = x / 10; k += 1; if k >= 22 { break; } }
  m := n; for i: 0..<k { if m < out.count { out[m] = d[k - 1 - i]; m += 1; } }
  return m;
}
// Dollars from millionths, to four places.
np_put_cost :: (out: []u8, n: int, e6: int) -> int {
  e4 := (e6 + 50) / 100; m := np_put(out, n, "$"); m = np_put_int(out, m, e4 / 10000); m = np_put(out, m, ".");
  frac := e4 % 10000; div := 1000;
  for i: 0..<4 { one: [1] u8; one[0] = cast(u8) ('0' + (frac / div) % 10); m = np_put(out, m, cast(string) one[..]); div = div / 10; }
  return m;
}

// Where the line starting at `from` ends when it must fit `width` points: at its newline, or at
// the last space that fits, or mid-word when one word is wider than the panel. `next` is where the
// line after it starts.
NpLine :: struct { end: int; next: int; }
np_line :: (text: string, from: int, width: f32) -> NpLine {
  i := from; space := -1;
  while i < text.count {
    if text[i] == '\n' { return NpLine.{end = i, next = i + 1}; }
    if text[i] == ' ' { space = i; }
    if eg_width(text[from..<i + 1], NP_SIZE, EG_BODY) > width {
      if space > from { return NpLine.{end = space, next = space + 1}; }
      if i == from { return NpLine.{end = i + 1, next = i + 1}; }
      return NpLine.{end = i, next = i};
    }
    i += 1;
  }
  return NpLine.{end = text.count, next = text.count};
}

// ---- the boxes

np_auto_box :: (width: f32) -> HudBox { return HudBox.{x = width - f32(NP_MARGIN) - f32(NP_BUTTON_W) - 12 - 156, y = f32(NP_MARGIN), width = 156, height = f32(NP_BUTTON_H)}; }
np_button :: (width: f32) -> HudBox { return HudBox.{x = width - f32(NP_MARGIN) - f32(NP_BUTTON_W), y = f32(NP_MARGIN), width = f32(NP_BUTTON_W), height = f32(NP_BUTTON_H)}; }
np_panel :: (width: f32, height: f32) -> HudBox {
  w := f32(NP_PANEL_W); if w > width - 2 * f32(NP_MARGIN) { w = width - 2 * f32(NP_MARGIN); }
  top := f32(NP_MARGIN) + f32(NP_BUTTON_H) + 12;
  return HudBox.{x = width - f32(NP_MARGIN) - w, y = top, width = w, height = height - top - f32(NP_MARGIN)};
}
np_close_box :: (b: HudBox) -> HudBox { return HudBox.{x = b.x + b.width - 76, y = b.y + 10, width = 64, height = 26}; }
np_refresh_box :: (b: HudBox) -> HudBox { return HudBox.{x = b.x + b.width - 164, y = b.y + 10, width = 80, height = 26}; }
np_reply_box :: (b: HudBox) -> HudBox { return HudBox.{x = b.x + f32(NP_PAD), y = b.y + b.height - 104, width = b.width - 2 * f32(NP_PAD), height = 34}; }
np_in :: (b: HudBox, x: f32, y: f32) -> bool { return x >= b.x && x <= b.x + b.width && y >= b.y && y <= b.y + b.height; }

// ---- the agent

// Starts the panel's agent on the shared Claude engine with these options; the context is its first
// message, sent once the CLI has answered initialize. "" when it started, else why not.
np_run :: (s: []NextPanel, o: [] ClOptions) -> string {
  e := s[0].eng[..]; ses := s[0].ses[..];
  if s[0].started { np_end(s, s[0].state); }
  s[0].opt[0] = o[0];
  e_attach(e, s[0].line[..], s[0].arena[..], s[0].out[..], s[0].scratch[..], s[0].context[..]);
  e_own(e, s[0].opt[..]);
  s_init(ses, s[0].pool[..]); ses[0].tabs = true;
  e_send_as(e, ses, "", cast(string) s[0].context[0..<s[0].context_n]);
  if !e[0].running { return ifx ses[0].n > 1 then s_text_of(ses, ses[0].n - 1) else "Claude Code did not start"; }
  return "";
}
// An agent's turn, or the host is fetching for one: what Stop stops.
np_busy :: (s: []NextPanel) -> bool { return s[0].state == NP_RUNNING || s[0].state == NP_CONTEXT_WAIT; }
np_end :: (s: []NextPanel, state: int) {
  if s[0].started && s[0].agy { np_agy_close(s); }
  if s[0].started { e_close(s[0].eng[..]); s[0].started = false; }
  s[0].agy = false; s[0].agy_owed = false;
  s[0].state = state;
}
// A fresh asking: the old session ends and the host is asked for the context. `again` is
// Autopilot going round: the chat so far stays, and so does what this run has worked.
np_ask :: (s: []NextPanel, refetch: bool, again: bool) {
  np_end(s, NP_CONTEXT_WAIT);
  if again { np_gap(s); np_append(s, "> next\n\n"); } else { s[0].text_n = 0; s[0].cut = false; s[0].worked_n = 0; s[0].run_cost_e6 = 0; s[0].focus = true; }
  s[0].scroll = 0; s[0].open = true; s[0].nudged = false; s[0].declined = false;
  s[0].turn = 0; s[0].seconds = 0; s[0].cost_e6 = -1; s[0].session_cost_e6 = 0; s[0].chosen = 0; s[0].report_n = 0;
  s[0].pending_work = false; s[0].coding = false; s[0].after_tool = false;
  s[0].model_n = np_put(s[0].model[..], 0, NP_MODEL);
  s[0].request = ifx refetch then 2 else 1;
}
// The host's answer: next-context's message and what it said about its caches. The session starts
// and the message goes to it.
np_context :: (s: []NextPanel, text: string, report: string, ok: bool) #export_c #effects(all) {
  if s[0].state != NP_CONTEXT_WAIT || s[0].coding { return; }
  s[0].request = 0;   // an answer to an asking you stopped serves the one you made since
  s[0].report_n = np_put(s[0].report[..], 0, report);
  while s[0].report_n > 0 && s[0].report[s[0].report_n - 1] <= 32 { s[0].report_n -= 1; }
  for i: 0..<s[0].report_n { if s[0].report[i] < 32 { s[0].report[i] = ' '; } }
  if !ok || text.count == 0 || text.count + 1200 > NP_CONTEXT {
    np_append(s, ifx text.count + 1200 > NP_CONTEXT then "The issues are more than the first message holds." else "The issues could not be read.");
    np_break(s); np_append(s, report); s[0].state = NP_FAILED; return;
  }
  n := np_put(s[0].context[..], 0, text);
  if s[0].worked_n > 0 {
    n = np_put(s[0].context[..], n, "\nALREADY WORKED IN THIS RUN (do not pick these):");
    for i: 0..<s[0].worked_n { n = np_put(s[0].context[..], n, " #"); n = np_put_int(s[0].context[..], n, s[0].worked[i]); }
    n = np_put(s[0].context[..], n, "\n");
  }
  n = np_put(s[0].context[..], n, ifx s[0].autopilot then NP_ASK_AUTO else NP_ASK); s[0].context_n = n;
  o: [1] ClOptions;
  o[0].model = NP_MODEL;
  sn := np_put(s[0].system[..], 0, NP_SYSTEM); sn = np_put(s[0].system[..], sn, "\n\n"); sn = np_put(s[0].system[..], sn, TIER_RUBRIC);
  o[0].system_prompt = cast(string) s[0].system[0..<sn];
  o[0].persist_session = false;
  o[0].setting_sources_set = true;          // no settings files: no project rules, hooks or other servers
  o[0].include_partial_messages = true;     // the text streams
  o[0].tools_set = true;                    // the base set is empty: no Bash, no files, no web
  server := cl_add_server(o[..], "next", "1");
  tool := cl_add_server_tool(o[..], server, "choose", NP_CHOOSE_ABOUT, NP_CHOOSE_SCHEMA);
  cl_add_allowed(o[..], NP_TOOL);
  cl_remove_env(o[..], "ANTHROPIC_API_KEY"); cl_remove_env(o[..], "ANTHROPIC_AUTH_TOKEN"); // your login, never a key
  problem := np_run(s, o[..]);
  if problem.count > 0 { np_append(s, NP_INSTALL); np_break(s); np_append(s, problem); s[0].state = NP_FAILED; s[0].started = false; return; }
  s[0].started = true; s[0].state = NP_RUNNING; s[0].seconds = 0;
}

// The host's answer to a start: next-context work's output, the worktree's path on its first line
// and then the issue whole. The coding agent's session starts in that worktree.
np_work :: (s: []NextPanel, text: string, report: string, ok: bool) #export_c #effects(all) {
  if s[0].state != NP_CONTEXT_WAIT || !s[0].coding { return; }
  s[0].report_n = np_put(s[0].report[..], 0, report);
  while s[0].report_n > 0 && s[0].report[s[0].report_n - 1] <= 32 { s[0].report_n -= 1; }
  for i: 0..<s[0].report_n { if s[0].report[i] < 32 { s[0].report[i] = ' '; } }
  eol := 0; while eol < text.count && text[eol] != '\n' { eol += 1; }
  if !ok || eol == 0 || eol >= text.count || text[0] != '/' || eol > 2000 || text.count + 400 > NP_CONTEXT {
    np_gap(s); np_append(s, "The worktree could not be made."); np_break(s); np_append(s, report); s[0].state = NP_FAILED; return;
  }
  s[0].cwd_n = np_put(s[0].cwd[..], 0, text[0..<eol]);
  mode: [32] u8; s[0].rehearsal = cl_getenv("EVERGLADE_CODER_MODE", mode[..]) == "rehearsal";
  eb: [32] u8; fb: [32] u8;
  choice := np_coder_choice(cl_getenv("EVERGLADE_CODER_ENGINE", eb[..]), cl_getenv("EVERGLADE_TIER_FAMILY", fb[..]));
  if choice.problem.count > 0 { np_gap(s); np_append(s, choice.problem); np_append(s, "\n"); s[0].state = NP_FAILED; return; }
  named: [64] u8;
  s[0].model_n = np_put(s[0].model[..], 0, np_coder_model(choice, cl_getenv("EVERGLADE_CODER_MODEL", named[..]), s[0].tier));
  // The first message: the one job, where it is, and the issue. Antigravity takes no system prompt
  // here, so its first message carries the same rules ahead of the job, and how they map onto agy.
  n := 0;
  if choice.engine == NP_ENGINE_AGY {
    n = np_put(s[0].context[..], n, ifx s[0].rehearsal then NP_CODER_REHEARSAL else NP_CODER_RULES);
    n = np_put(s[0].context[..], n, "\n\n");
    n = np_put(s[0].context[..], n, ifx s[0].rehearsal then NP_AGY_REHEARSAL_TOOLS else NP_AGY_TOOLS);
    n = np_put(s[0].context[..], n, "\n\n---\n\n");
  }
  n = np_put(s[0].context[..], n, ifx s[0].rehearsal then "Rehearse GitHub issue #" else "Complete GitHub issue #");
  n = np_put_int(s[0].context[..], n, s[0].chosen);
  n = np_put(s[0].context[..], n, ifx s[0].rehearsal then ": read only, change nothing.\n\nThe worktree is " else " and nothing else, then push it and close the issue.\n\nYour worktree is ");
  n = np_put(s[0].context[..], n, cast(string) s[0].cwd[0..<s[0].cwd_n]);
  n = np_put(s[0].context[..], n, ".\n\n");
  n = np_put(s[0].context[..], n, text[eol + 1..<text.count]);
  s[0].context_n = n;
  s[0].reported = 0; s[0].nudges = 0;
  if choice.engine == NP_ENGINE_AGY {
    problem := np_run_agy(s);
    if problem.count > 0 { np_gap(s); np_append(s, problem); np_append(s, "\n"); s[0].state = NP_FAILED; return; }
    np_begin_work(s);
    return;
  }
  o: [1] ClOptions;
  o[0].model = cast(string) s[0].model[0..<s[0].model_n];
  o[0].append_system_prompt = ifx s[0].rehearsal then NP_CODER_REHEARSAL else NP_CODER_RULES;
  server := cl_add_server(o[..], "next", "1");
  tool := cl_add_server_tool(o[..], server, "report", NP_REPORT_ABOUT, NP_REPORT_SCHEMA);
  cl_add_allowed(o[..], NP_REPORT_TOOL);
  o[0].cwd = cast(string) s[0].cwd[0..<s[0].cwd_n];
  cl_add_setting_source(o[..], "project");   // the repository's own rules (AGENTS.md, CLAUDE.md); not your user settings
  o[0].include_partial_messages = true;
  // The whole tool set: files and the shell. No Task or Agent (no subagents), no web.
  if s[0].rehearsal { for t: [3] string.["Read", "Grep", "Glob"] { cl_add_tool(o[..], t); cl_add_allowed(o[..], t); } }
  else { for t: [6] string.["Bash", "Read", "Edit", "Write", "Grep", "Glob"] { cl_add_tool(o[..], t); cl_add_allowed(o[..], t); } o[0].permission_mode = ClPermissionMode.accept_edits; }
  for t: [4] string.["Task", "Agent", "WebSearch", "WebFetch"] { cl_add_disallowed(o[..], t); }
  cl_remove_env(o[..], "ANTHROPIC_API_KEY"); cl_remove_env(o[..], "ANTHROPIC_AUTH_TOKEN");
  problem := np_run(s, o[..]);
  if problem.count > 0 { np_gap(s); np_append(s, NP_INSTALL); np_break(s); np_append(s, problem); s[0].state = NP_FAILED; s[0].started = false; return; }
  s[0].started = true;
  np_begin_work(s);
}
// The coding agent started: its turn runs, and the chat says who works which issue where.
np_begin_work :: (s: []NextPanel) {
  s[0].state = NP_RUNNING; s[0].seconds = 0; s[0].turn = 0; s[0].session_cost_e6 = 0; s[0].cost_e6 = -1;
  np_gap(s); np_append(s, "> "); np_append(s, cast(string) s[0].model[0..<s[0].model_n]);
  if s[0].agy { np_append(s, " (Antigravity)"); }
  np_append(s, ifx s[0].rehearsal then " rehearses #" else " works #"); b: [24] u8; k := np_put_int(b[..], 0, s[0].chosen); np_append(s, cast(string) b[0..<k]);
  np_append(s, " in "); np_append(s, cast(string) s[0].cwd[0..<s[0].cwd_n]); np_append(s, "\n\n");
}

// One tool call as one short line: what it is and what it is on. Paths are shown from the worktree.
np_tool_line :: (s: []NextPanel, name: string, input: string) {
  ar := s[0].eng[0].q[0].ar[..];
  held: [24] u8; kn := np_put(held[..], 0, name); kind := cast(string) held[0..<kn];
  key := "";
  if kind == "Bash" { key = "command"; }
  if kind == "Read" || kind == "Edit" || kind == "Write" { key = "file_path"; }
  if kind == "Grep" || kind == "Glob" { key = "pattern"; }
  np_break(s); if !s[0].after_tool { np_gap(s); }
  np_append(s, "> "); np_append(s, ifx kind == "Bash" then "$" else kind);
  if key.count > 0 {
    v := cl_str(ar, input, key); cwd := cast(string) s[0].cwd[0..<s[0].cwd_n];
    if cwd.count > 0 && v.count > cwd.count + 1 && v[0..<cwd.count] == cwd && v[cwd.count] == '/' { v = v[cwd.count + 1..<v.count]; }
    np_append(s, " ");
    // One line, its spaces single, at most 96 bytes.
    n := 0; gap := false;
    for c: v {
      if n >= 96 { np_append(s, "..."); break; }
      if c <= 32 { gap = n > 0; continue; }
      if gap { np_append(s, " "); n += 1; gap = false; }
      one: [1] u8; one[0] = c; np_append(s, cast(string) one[..]); n += 1;
    }
  }
  np_append(s, "\n"); s[0].after_tool = true;
}

// One turn's line for the ledger: who asked, which model, what it cost (written by ledger.coax).
np_record :: (s: []NextPanel, harness: string, session: string, model_usage: string, duration_ms: int, api_ms: int, turns: int) {
  purpose := ifx s[0].turn == 0 then "next-issue.suggest" else "next-issue.reply";
  if s[0].coding { purpose = ifx s[0].rehearsal then "issue.rehearse" else "issue.code"; }
  c := GyCall.{at = s[0].now, app = "everglade-desktop", purpose = purpose, harness = harness, model = cast(string) s[0].model[0..<s[0].model_n],
    session = session, has_session = true, turn = s[0].turn,
    input_tokens = s[0].input, cache_read_input_tokens = s[0].cache_read, cache_creation_input_tokens = s[0].cache_write, output_tokens = s[0].output,
    cost_usd_e6 = ifx s[0].cost_e6 < 0 then 0 else s[0].cost_e6, session_cost_usd_e6 = s[0].session_cost_e6,
    duration_ms = duration_ms, duration_api_ms = api_ms, model_turns = turns, prompt_bytes = ifx s[0].turn == 0 then s[0].context_n else s[0].draft_n,
    caches = cast(string) s[0].report[0..<s[0].report_n], has_caches = true, model_usage = model_usage};
  if s[0].coding { c.issue = s[0].chosen; }
  if s[0].agy {
    // agy reports tokens but no cost: the cost is the rates card's price for them, at this row.
    c.thought_tokens = s[0].thought;
    c.cost_priced_as = cast(string) s[0].priced_as[0..<s[0].priced_as_n]; c.has_cost_priced_as = true;
  }
  s[0].usage_n = gy_write_call(c, s[0].usage[..]);
}
// The decision, kept for the host to append (np_take_decision writes its line through ledger.coax).
np_decide :: (s: []NextPanel, action: string, issue: int, reason: string) {
  s[0].decided = true; s[0].decided_at = s[0].now; s[0].decided_issue = issue;
  s[0].decided_action_n = np_put(s[0].decided_action[..], 0, action);
  s[0].decided_reason_n = np_put(s[0].decided_reason[..], 0, gy_reason(reason));
  s[0].decided_session_n = np_put(s[0].decided_session[..], 0, cl_session_id(s[0].eng[0].q[..]));
  s[0].decided_scores = action == "start"; s[0].decided_tier = s[0].tier; s[0].decided_rubric = s[0].scores;
}

// The coder called `report`: its work on the issue is over.
np_report :: (s: []NextPanel, arguments: string) {
  ar := s[0].eng[0].q[0].ar[..];
  status := cl_str(ar, arguments, "status");
  if status != "done" && status != "blocked" { cl_tool_text(s[0].eng[0].q[..], "status must be done or blocked.", true); return; }
  s[0].reported = ifx status == "done" then 1 else 2;
  np_break(s); np_append(s, ifx s[0].reported == 1 then "> done: " else "> blocked: ");
  np_append(s, cl_str(ar, arguments, "summary")); np_append(s, "\n");
  cl_tool_text(s[0].eng[0].q[..], "Recorded. End your turn now.", false);
}
// The agent called `choose`: what you meant, as it read it.
np_choose :: (s: []NextPanel, arguments: string) {
  ar := s[0].eng[0].q[0].ar[..];
  action := cl_str(ar, arguments, "action"); issue := cl_int(arguments, "issue"); number := ifx issue.ok then issue.value else 0;
  held: [16] u8; an := np_put(held[..], 0, action); act := cast(string) held[0..<an];   // the arena is reused by the next read
  reason := cl_str(ar, arguments, "reason");
  delegable := cl_bool(arguments, "delegable");
  s[0].scores = TierScores.{scope = cl_int(arguments, "scope").value, ambiguity = cl_int(arguments, "ambiguity").value, risk = cl_int(arguments, "risk").value, depth = cl_int(arguments, "depth").value, delegable = !delegable.ok || delegable.value};
  s[0].tier = tier_of(s[0].scores);
  if act == "start" && number > 0 && s[0].tier == TIER_NONE {
    cl_tool_text(s[0].eng[0].q[..], "You rated that issue not delegable, so nothing was started. Pick another issue, or call choose with none.", true);
    return;
  }
  np_decide(s, act, number, reason);
  np_gap(s);
  if act == "start" && number > 0 {
    s[0].chosen = number;
    np_append(s, "> start #"); b: [24] u8; n := np_put_int(b[..], 0, number); np_append(s, cast(string) b[0..<n]);
    np_append(s, " on "); np_append(s, tier_name(s[0].tier)); np_append(s, "\n");
    np_append(s, "\n");
    s[0].pending_work = true;
    cl_tool_text(s[0].eng[0].q[..], NP_STARTING, false);
    return;
  }
  if act == "another" { np_append(s, "> another\n\n"); cl_tool_text(s[0].eng[0].q[..], "Recorded. Suggest the next best issue.", false); return; }
  if act == "none" { s[0].declined = true; np_append(s, "> none\n\n"); cl_tool_text(s[0].eng[0].q[..], "Recorded. Nothing will be started.", false); return; }
  cl_tool_text(s[0].eng[0].q[..], "The action must be start (with an issue number), another or none.", true);
}

// Claude Code reports where its credentials came from: "none" means your claude.ai login.
np_login_billed :: (source: string) -> bool { return source.count == 0 || source == "none"; }
np_message :: (s: []NextPanel, m: ClMessage) {
  if m.parent_tool_use_id.count > 0 { return; }
  l := m.line; ar := s[0].eng[0].q[0].ar[..];
  // Every run is billed to your Claude login. "none" is the login; anything else is a key or a
  // helper, and the run stops before its first model turn is paid for.
  if m.kind == ClKind.system && m.system == ClSystem.init && !np_login_billed(cl_str(ar, l, "apiKeySource")) {
    np_gap(s); np_append(s, "Stopped: this run would bill an API key, not your Claude login. Remove ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN or apiKeyHelper and start again.\n");
    np_end(s, NP_FAILED); return;
  }
  if m.kind == ClKind.stream_event {
    if !cl_eq(l, cl_at(l, "event.type"), "content_block_delta") { return; }
    if cl_eq(l, cl_at(l, "event.delta.type"), "text_delta") {
      if s[0].after_tool { np_gap(s); s[0].after_tool = false; }
      np_say(s, cl_str(ar, l, "event.delta.text"));
    }
    return;
  }
  if m.kind == ClKind.user && s[0].coding {
    // A tool's result shows only when it failed, as one line.
    content := cl_raw(l, "message.content");
    for i: 0..<cl_count(content) {
      item := cl_json(content, cl_item(content, i));
      if cl_str(ar, item, "type") == "tool_result" && cl_bool(item, "is_error").value {
        np_break(s); np_append(s, "  failed");
        why := cl_str(ar, item, "content"); if why.count == 0 { why = cl_str(ar, item, "content.0.text"); }
        if why.count > 0 { np_append(s, ": "); n := 0; for c: why { if n >= 90 || c == '\n' { break; } one: [1] u8; one[0] = c; np_append(s, cast(string) one[..]); n += 1; } }
        np_append(s, "\n");
      }
    }
    return;
  }
  if m.kind == ClKind.assistant {
    if s[0].coding {
      content := cl_raw(l, "message.content");
      for i: 0..<cl_count(content) {
        item := cl_json(content, cl_item(content, i));
        if cl_str(ar, item, "type") == "tool_use" { np_tool_line(s, cl_str(ar, item, "name"), cl_raw(item, "input")); }
      }
    }
    e := cl_assistant_error(l, cl_at(l, "error"));
    if e == ClAssistantError.authentication_failed || e == ClAssistantError.oauth_org_not_allowed { np_break(s); np_append(s, NP_LOGIN); np_end(s, NP_FAILED); }
    return;
  }
  if m.kind == ClKind.result {
    a := cl_int(l, "usage.input_tokens"); s[0].input = ifx a.ok then a.value else 0;
    b := cl_int(l, "usage.output_tokens"); s[0].output = ifx b.ok then b.value else 0;
    c := cl_int(l, "usage.cache_read_input_tokens"); s[0].cache_read = ifx c.ok then c.value else 0;
    d := cl_int(l, "usage.cache_creation_input_tokens"); s[0].cache_write = ifx d.ok then d.value else 0;
    // The CLI reports the session's cost so far; this turn's is what it grew by.
    total := cl_num(l, "total_cost_usd"); total_e6 := ifx total.ok then cast(int) (total.value * 1000000 + 0.5) else s[0].session_cost_e6;
    s[0].cost_e6 = total_e6 - s[0].session_cost_e6; if s[0].cost_e6 < 0 { s[0].cost_e6 = total_e6; }
    s[0].session_cost_e6 = total_e6;
    s[0].run_cost_e6 += s[0].cost_e6;
    ms := cl_int(l, "duration_ms"); api := cl_int(l, "duration_api_ms"); turns := cl_int(l, "num_turns");
    np_record(s, "claude-code", cl_session_id(s[0].eng[0].q[..]), cl_raw(l, "modelUsage"), ifx ms.ok then ms.value else 0, ifx api.ok then api.value else 0, ifx turns.ok then turns.value else 0);
    s[0].turn += 1; s[0].draft_n = 0;
    failed := cl_bool(l, "is_error").value || m.result != ClResultKind.success;
    if failed {
      why := cl_str(ar, l, "result"); if why.count == 0 { why = cl_str(ar, l, "errors.0"); }
      np_break(s); np_append(s, ifx why.count > 0 then why else "The turn failed."); np_end(s, NP_FAILED); return;
    }
    np_turn_over(s);
  }
}
// A turn ended well, on either engine: what comes next.
np_turn_over :: (s: []NextPanel) {
  np_break(s); s[0].state = NP_YOURS; s[0].after_tool = false;
  // The coding agent's turn is over: the issue is one this run has worked, and Autopilot goes
  // round: the caches are fetched again (the issue may be closed now) and the picker picks.
  // A coder that ended its turn without saying done or blocked is told to finish: it may have
  // left a check running and stopped to wait for it, and in a turn nobody answers that is the end.
  if s[0].coding && s[0].autopilot && s[0].reported == 0 && s[0].nudges < NP_NUDGES {
    s[0].nudges += 1; np_append(s, "> no report yet: told to finish\n");
    s[0].draft_n = np_put(s[0].draft[..], 0, ifx s[0].agy then NP_AGY_KEEP_GOING else NP_KEEP_GOING); np_send(s); return;
  }
  if s[0].coding {
    s[0].runs += 1;
    if s[0].worked_n < NP_WORKED { s[0].worked[s[0].worked_n] = s[0].chosen; s[0].worked_n += 1; }
    if s[0].autopilot && s[0].run_cost_e6 >= NP_BUDGET_E6 { np_gap(s); np_append(s, "> Autopilot stopped: this run has spent its budget.\n"); }
    else if s[0].autopilot && s[0].worked_n < NP_WORKED { np_ask(s, true, true); return; }
  }
  // The picker asked instead of starting: Autopilot answers it once.
  if s[0].autopilot && !s[0].coding && !s[0].pending_work && s[0].chosen == 0 && !s[0].nudged && !s[0].declined {
    s[0].nudged = true; s[0].draft_n = np_put(s[0].draft[..], 0, NP_GO); np_send(s); return;
  }
  // You said start: the picker's turn is over and written down, so its session ends and the
  // host is asked for the worktree.
  if s[0].pending_work && !s[0].coding {
    s[0].pending_work = false; np_end(s, NP_CONTEXT_WAIT); s[0].coding = true; s[0].request = 3;
  }
}
// What has arrived since the last frame, without waiting for more.
np_poll :: (s: []NextPanel) {
  if s[0].agy { np_agy_poll(s); return; }
  for i: 0..<256 {
    if s[0].state != NP_RUNNING || !s[0].started { return; }
    one: [1] ClEvent;
    e_poll(s[0].eng[..], s[0].ses[..], one[..]);
    ev := one[0];
    // the panel prints from the messages themselves: the record is read to its end so it starts over and never fills
    cur: [1] SCursor; cur[0].part = s[0].ses[0].n;
    trimmed := s_trim(s[0].ses[..], cur[..]);
    if ev.kind == ClEventKind.idle { return; }
    if ev.kind == ClEventKind.message { np_message(s, ev.message); continue; }
    if ev.kind == ClEventKind.tool_call { if s[0].coding { np_report(s, ev.arguments); } else { np_choose(s, ev.arguments); } continue; }
    if ev.kind == ClEventKind.failed { np_break(s); np_append(s, cl_error(s[0].eng[0].q[..])); np_end(s, NP_FAILED); return; }
    if ev.kind == ClEventKind.end { np_break(s); np_append(s, "Claude Code closed before it answered."); np_end(s, NP_FAILED); return; }
  }
}
// Your reply goes to the open session as its next message.
np_send :: (s: []NextPanel) {
  if s[0].state != NP_YOURS || !s[0].started || s[0].draft_n == 0 { return; }
  said := cast(string) s[0].draft[0..<s[0].draft_n];
  np_gap(s); np_append(s, "You: "); np_append(s, said); np_append(s, "\n\n");
  if s[0].agy { s[0].said_n = 0; s[0].agy_barred = false; sent := cue_send(s[0].ag[0].cue[..], said); }
  else { e_send_as(s[0].eng[..], s[0].ses[..], said, said); }
  s[0].state = NP_RUNNING; s[0].seconds = 0; s[0].scroll = 0;
}

// ---- the Antigravity coder

// Which engine codes and which family the rubric names, from EVERGLADE_CODER_ENGINE and
// EVERGLADE_TIER_FAMILY: either alone decides both (antigravity runs the Gemini family, gemini
// runs on Antigravity), neither is Claude, and two that disagree are refused with why.
NpCoder :: struct { engine: int; family: int; problem: string; }
np_coder_choice :: (engine_word: string, family_word: string) -> NpCoder {
  family := tier_family(family_word);
  if family < 0 { return NpCoder.{engine = -1, family = -1, problem = "EVERGLADE_TIER_FAMILY is claude or gemini."}; }
  runs := ifx engine_word.count > 0 then tier_family_of_engine(engine_word) else family;
  if runs < 0 { return NpCoder.{engine = -1, family = -1, problem = "EVERGLADE_CODER_ENGINE is claude or antigravity."}; }
  if family_word.count == 0 { family = runs; }
  if family != runs { return NpCoder.{engine = -1, family = -1, problem = "EVERGLADE_TIER_FAMILY and EVERGLADE_CODER_ENGINE disagree: the gemini family runs on antigravity, the claude family on claude."}; }
  return NpCoder.{engine = ifx runs == TIER_GEMINI then NP_ENGINE_AGY else NP_ENGINE_CLAUDE, family = family};
}
// The coder's model: the one EVERGLADE_CODER_MODEL names, else the tier's in the family, else the engine's default.
np_coder_model :: (c: NpCoder, named: string, tier: int) -> string {
  if named.count > 0 { return named; }
  tiered := tier_model_in(tier, c.family);
  if tiered.count > 0 { return tiered; }
  return ifx c.engine == NP_ENGINE_AGY then NP_AGY_CODER_MODEL else NP_CODER_MODEL;
}

// Starts the Antigravity coder in the worktree: agy acp with the credentials file, as Coder starts
// it. The first message (s.context) goes once the session is open and its model set.
// "" when it started, else why not.
np_run_agy :: (s: []NextPanel) -> string {
  if s[0].started { np_end(s, s[0].state); }
  x := s[0].ag[0].cue[..];
  a := s[0].ag[..];
  cue_attach(x, a[0].cu[..], a[0].cup[..], a[0].line[..], a[0].arena[..], a[0].out[..]);
  pb: [4096] u8; program := agy_program(pb[..]);
  if program.count == 0 { return AGY_MISSING; }
  why := agy_launch(x, program, cast(string) s[0].cwd[0..<s[0].cwd_n], "everglade-desktop", "1");
  if why.count > 0 { return why; }
  s[0].started = true; s[0].agy = true; s[0].agy_owed = true; s[0].agy_barred = false; s[0].said_n = 0;
  return "";
}

// The agy process closed (cue_close's steps, spelled out: called on the panel's own engine it
// runs out the checker's borrow budget, E0381).
np_agy_close :: (s: []NextPanel) { a := s[0].ag[..]; cu_close_process(a[0].cup[..]); a[0].cue[0].live = false; a[0].cue[0].ready = false; a[0].cue[0].replay = false; a[0].cue[0].hold = 0; }
// A tool agy may not use here, by its name: subagents, the browser, the web, images, swarms.
np_agy_barred :: (name: string) -> bool {
  barred := NP_AGY_BARRED;
  for b: barred { if name.count >= b.count && name[0..<b.count] == b { return true; } }
  return false;
}
// Whether a permission agy asks is allowed: never a barred tool, a fetch (the web) or a path
// outside the worktree; in rehearsal only reading and searching; else what the worktree needs.
np_agy_allows :: (rehearsal: bool, name: string, kind: string, inside: bool) -> bool {
  if np_agy_barred(name) || kind == "fetch" || !inside { return false; }
  if rehearsal { return kind == "read" || kind == "search"; }
  return true;
}
// Whether every path a tool names is in the worktree (no "..", no absolute path elsewhere).
np_agy_inside :: (cwd: string, tool: string, ar: [] ClArena) -> bool {
  if cu_tool_outside(tool, ar) || agy_outside(tool, ar) { return false; }
  locs := cl_raw(tool, "locations");
  for i: 0..<cl_count(locs) { if !np_in_tree(cwd, cl_str(ar, cl_json(locs, cl_item(locs, i)), "path")) { return false; } }
  raw := cl_raw(tool, "rawInput");
  for key: [3] string.["path", "file_path", "cwd"] { if !np_in_tree(cwd, cl_str(ar, raw, key)) { return false; } }
  keys := AGY_PATH_KEYS;
  for key: keys { if !np_in_tree(cwd, cl_str(ar, raw, key)) { return false; } }
  return true;
}
// A path is in the tree: relative, or the tree itself, or under it.
np_in_tree :: (cwd: string, path: string) -> bool {
  if path.count == 0 || path[0] != '/' { return true; }
  if cwd.count == 0 || path.count < cwd.count || path[0..<cwd.count] != cwd { return false; }
  return path.count == cwd.count || path[cwd.count] == '/';
}

// The turn's words, kept (without Markdown's marks) for the REPORT line; the oldest half goes when full.
np_agy_keep :: (s: []NextPanel, t: string) {
  for c: t {
    if c == '`' || c == '*' { continue; }
    if s[0].said_n >= NP_SAID { h := NP_SAID / 2; for i: h..<NP_SAID { s[0].said[i - h] = s[0].said[i]; } s[0].said_n -= h; }
    s[0].said[s[0].said_n] = c; s[0].said_n += 1;
  }
}
// The last REPORT line in a turn's words: status 1 done, 2 blocked, 0 none; and its summary.
NpReport :: struct { status: int; summary: string; }
np_agy_report :: (text: string) -> NpReport {
  r: NpReport; at := 0;
  while at < text.count {
    end := at; while end < text.count && text[end] != '\n' { end += 1; }
    i := at; while i < end && (text[i] == ' ' || text[i] == '\t' || text[i] == '>' || text[i] == '-') { i += 1; }
    if end - i >= 7 && (text[i..<i + 7] == "REPORT:" || text[i..<i + 7] == "Report:") {
      j := i + 7; while j < end && text[j] == ' ' { j += 1; }
      w := j; while w < end && text[w] != ' ' && text[w] != ':' && text[w] != '.' && text[w] != ',' { w += 1; }
      word := text[j..<w];
      st := ifx word == "done" || word == "Done" || word == "DONE" then 1 else ifx word == "blocked" || word == "Blocked" || word == "BLOCKED" then 2 else 0;
      if st > 0 {
        k := w; while k < end && (text[k] == ' ' || text[k] == ':' || text[k] == '-' || text[k] == '.' || text[k] == ',') { k += 1; }
        e := end; while e > k && (text[e - 1] == ' ' || text[e - 1] == '\r') { e -= 1; }
        r = NpReport.{status = st, summary = text[k..<e]};
      }
    }
    at = end + 1;
  }
  return r;
}

// What a turn's tokens cost at the rates card: agy's model less its thinking level ("-low",
// "-medium", "-high") is the card's model on Vertex; one the card lacks is priced at
// NP_AGY_PRICE_FALLBACK, so the budget never reads an unpriced model as free. ACP's counts are
// apart (input is uncached), and thought tokens are billed as output.
np_agy_rate_model :: (model: string) -> string {
  for suffix: [3] string.["-low", "-medium", "-high"] {
    if model.count > suffix.count && model[model.count - suffix.count..<model.count] == suffix { return model[0..<model.count - suffix.count]; }
  }
  return model;
}
NpPrice :: struct { e6: int; row: string; }
np_agy_price :: (model: string, input: int, cached: int, cache_write: int, output: int, thought: int) -> NpPrice {
  row := np_agy_rate_model(model);
  f := gw_rate("vertex", row);
  if !f.ok { row = NP_AGY_PRICE_FALLBACK; f = gw_rate("vertex", row); }
  return NpPrice.{e6 = gw_card_cost(f.rate, input + cached + cache_write, cached, cache_write, output + thought), row = row};
}

// The first message, once the session is open and no setting is still unanswered.
np_agy_owed :: (s: []NextPanel) {
  x := s[0].ag[0].cue[..];
  if !s[0].agy_owed || !x[0].ready || x[0].hold > 0 || s[0].state != NP_RUNNING { return; }
  r := cu_session_prompt(x[0].c, cast(string) s[0].context[0..<s[0].context_n]);
  s[0].agy_owed = false;
}

// A permission agy asks, answered by the panel's rules (np_agy_allows); a refusal is one line.
np_agy_permit :: (s: []NextPanel, params: string) {
  c := s[0].ag[0].cue[0].c; ar := c[0].ar[..];
  tool := cl_raw(params, "toolCall");
  name := cl_str(ar, tool, "name"); kind := cl_str(ar, tool, "kind");
  inside := np_agy_inside(cast(string) s[0].cwd[0..<s[0].cwd_n], tool, ar);
  if np_agy_allows(s[0].rehearsal, name, kind, inside) {
    id := cu_allow_option(c);
    if id.count > 0 { cu_permit(c, id); return; }
  }
  cu_decline(c);
  title := cl_str(ar, tool, "title"); if title.count == 0 { title = name; }
  np_break(s); np_append(s, "  refused: "); np_line_of(s, title); np_append(s, "\n"); s[0].after_tool = true;
}
// At most 96 bytes of v on one line, its spaces single, the worktree's path left off.
np_line_of :: (s: []NextPanel, v_in: string) {
  v := v_in; cwd := cast(string) s[0].cwd[0..<s[0].cwd_n];
  if cwd.count > 0 && v.count > cwd.count + 1 && v[0..<cwd.count] == cwd && v[cwd.count] == '/' { v = v[cwd.count + 1..<v.count]; }
  n := 0; gap := false;
  for c: v {
    if n >= 96 { np_append(s, "..."); break; }
    if c <= 32 { gap = n > 0; continue; }
    if gap { np_append(s, " "); n += 1; gap = false; }
    one: [1] u8; one[0] = c; np_append(s, cast(string) one[..]); n += 1;
  }
}
// A tool call agy started, as one line; a barred one stops the turn.
np_agy_tool :: (s: []NextPanel, update: string) {
  c := s[0].ag[0].cue[0].c; ar := c[0].ar[..];
  name := cl_str(ar, update, "name"); raw := cl_raw(update, "rawInput");
  np_break(s); if !s[0].after_tool { np_gap(s); }
  s[0].after_tool = true;
  if np_agy_barred(name) {
    np_append(s, "> refused: "); np_append(s, name); np_append(s, " is not allowed here; the turn is stopped\n");
    if !s[0].agy_barred { s[0].agy_barred = true; cue_cancel(s[0].ag[0].cue[..]); }
    return;
  }
  what := cl_str(ar, raw, "CommandLine");
  np_append(s, "> "); np_append(s, ifx name == "run_command" then "$" else ifx name.count > 0 then name else "tool");
  if what.count == 0 { for key: [4] string.["Path", "TargetFile", "AbsolutePath", "DirectoryPath"] { if what.count == 0 { what = cl_str(ar, raw, key); } } }
  if what.count == 0 { what = cl_str(ar, raw, "Query"); }
  if what.count == 0 { what = cl_str(ar, update, "title"); }
  if what.count > 0 { np_append(s, " "); np_line_of(s, what); }
  np_append(s, "\n");
}
// The turn's answer: its usage priced and written down, its REPORT line read, then what comes next.
np_agy_end :: (s: []NextPanel, result: string) {
  c := s[0].ag[0].cue[0].c; ar := c[0].ar[..];
  rb: [64] u8; rn := np_put(rb[..], 0, cl_str(ar, result, "stopReason")); reason := cast(string) rb[0..<rn];
  u := cl_raw(result, "usage");
  s[0].input = cl_int(u, "inputTokens").value; s[0].cache_read = cl_int(u, "cachedReadTokens").value;
  s[0].cache_write = cl_int(u, "cachedWriteTokens").value; s[0].output = cl_int(u, "outputTokens").value; s[0].thought = cl_int(u, "thoughtTokens").value;
  for v: [5] int.[s[0].input, s[0].cache_read, s[0].cache_write, s[0].output, s[0].thought] { if v < 0 { s[0].input = 0; s[0].cache_read = 0; s[0].cache_write = 0; s[0].output = 0; s[0].thought = 0; } }
  price := np_agy_price(cast(string) s[0].model[0..<s[0].model_n], s[0].input, s[0].cache_read, s[0].cache_write, s[0].output, s[0].thought);
  s[0].priced_as_n = np_put(s[0].priced_as[..], 0, price.row);
  s[0].cost_e6 = price.e6; s[0].session_cost_e6 += price.e6; s[0].run_cost_e6 += price.e6;
  np_record(s, "antigravity", cu_session_id(c), "", cast(int) (s[0].seconds * 1000), 0, 1);
  s[0].turn += 1; s[0].draft_n = 0;
  rep := np_agy_report(cast(string) s[0].said[0..<s[0].said_n]);
  if rep.status > 0 {
    s[0].reported = rep.status;
    np_break(s); np_append(s, ifx rep.status == 1 then "> done: " else "> blocked: "); np_append(s, rep.summary); np_append(s, "\n");
  }
  s[0].said_n = 0;
  if s[0].agy_barred { np_break(s); np_append(s, "Stopped: the coder started a tool it may not use here."); np_end(s, NP_FAILED); return; }
  if reason == "cancelled" && cue_stalled(s[0].ag[0].cue[..]) { sb: [256] u8; np_break(s); np_append(s, cue_stall_why(s[0].ag[0].cue[..], sb[..])); np_end(s, NP_FAILED); return; }
  if reason.count > 0 && reason != "end_turn" && reason != "end" {
    np_break(s); np_append(s, "Antigravity ended the turn: "); np_append(s, reason); np_end(s, NP_FAILED); return;
  }
  np_turn_over(s);
}
// The usage of a turn's part the watchdog cancelled and continued, priced into the session's and the run's cost.
np_agy_spent :: (s: []NextPanel, u: string) {
  if u.count == 0 { return; }
  v: [5] int; i := 0;
  for key: [5] string.["inputTokens", "cachedReadTokens", "cachedWriteTokens", "outputTokens", "thoughtTokens"] { n := cl_int(u, key).value; v[i] = ifx n > 0 then n else 0; i += 1; }
  price := np_agy_price(cast(string) s[0].model[0..<s[0].model_n], v[0], v[1], v[2], v[3], v[4]);
  s[0].session_cost_e6 += price.e6; s[0].run_cost_e6 += price.e6;
}
// One event from the Antigravity coder, after the shared engine's part of it (cue_take).
np_agy_event :: (s: []NextPanel, ev: CuEvent) {
  x := s[0].ag[0].cue[..]; c := x[0].c; ar := c[0].ar[..];
  k := ev.kind;
  if k == CuEventKind.none { np_agy_spent(s, cue_spent(x)); return; }
  if k == CuEventKind.end || k == CuEventKind.failed {
    np_break(s); why := cue_why(x); np_append(s, ifx why.count > 0 then why else "Antigravity closed before it answered."); np_end(s, NP_FAILED); return;
  }
  if k == CuEventKind.refused {
    if ev.of == CU_SESSION_SET_CONFIG || ev.of == CU_SESSION_SET_MODE { np_agy_owed(s); return; }
    np_break(s);
    if ev.of == CU_SESSION_SET_MODEL { np_append(s, "Antigravity did not take the model "); np_append(s, cast(string) s[0].model[0..<s[0].model_n]); np_append(s, ": "); }
    np_append(s, ifx agy_signed_out(ev.message) then AGY_SIGNED_OUT else ev.message); np_end(s, NP_FAILED); return;
  }
  if k == CuEventKind.answered {
    if ev.of == CU_SESSION_NEW || ev.of == CU_SESSION_RESUME {
      missed := agy_configure(x, ev.result, cast(string) s[0].model[0..<s[0].model_n], "");
      if (missed & AGY_MODEL_NOT_APPLIED) != 0 {
        np_break(s); np_append(s, "Antigravity does not offer the model "); np_append(s, cast(string) s[0].model[0..<s[0].model_n]); np_append(s, "."); np_end(s, NP_FAILED); return;
      }
      np_agy_owed(s); return;
    }
    if ev.of == CU_SESSION_PROMPT { np_agy_end(s, ev.result); return; }
    np_agy_owed(s); return;   // a setting was answered
  }
  if k == CuEventKind.permission { np_agy_permit(s, ev.params); return; }
  if k == CuEventKind.question { cu_question(c, true); return; }
  if k == CuEventKind.plan { cu_plan(c, true); return; }
  if k != CuEventKind.notification || ev.method != "session/update" { return; }
  update := cl_raw(ev.params, "update"); kind := cl_str(ar, update, "sessionUpdate");
  if kind == "agent_message_chunk" {
    text := cl_str(ar, update, "content.text");
    if s[0].after_tool { np_gap(s); s[0].after_tool = false; }
    np_say(s, text); np_agy_keep(s, text);
    return;
  }
  if kind == "tool_call" { np_agy_tool(s, update); return; }
  if kind == "tool_call_update" && cl_str(ar, update, "status") == "failed" {
    np_break(s); np_append(s, "  failed");
    why := cl_str(ar, update, "content.0.content.text");
    if why.count > 0 { np_append(s, ": "); n := 0; for ch: why { if n >= 90 || ch == '\n' { break; } one: [1] u8; one[0] = ch; np_append(s, cast(string) one[..]); n += 1; } }
    np_append(s, "\n");
  }
}
// The stall watchdog (the shared engine's cue_watch) on the host's clock: what it did is a line in
// the chat; an agy that did not answer the cancel is closed and the turn fails.
np_agy_watch :: (s: []NextPanel) {
  w := cue_watch(s[0].ag[0].cue[..], s[0].now * 1000);
  if w == CUE_WATCH_NONE { return; }
  nb: [256] u8; np_break(s); np_append(s, "> "); np_append(s, cue_watch_notice(s[0].ag[0].cue[..], w, nb[..])); np_append(s, "\n");
  if w == CUE_WATCH_ENDED { np_end(s, NP_FAILED); }
}
// What agy has sent since the last frame, without waiting for more.
np_agy_poll :: (s: []NextPanel) {
  if s[0].state == NP_RUNNING && s[0].started && s[0].agy { np_agy_watch(s); }
  for i: 0..<256 {
    if s[0].state != NP_RUNNING || !s[0].started || !s[0].agy { return; }
    one: [1] CuEvent; cue_poll(s[0].ag[0].cue[..], one[..]);
    if one[0].kind == CuEventKind.idle { return; }
    np_agy_event(s, one[0]);
  }
}

// ---- the frame

np_status :: (s: []NextPanel, out: []u8) -> string {
  n := 0;
  if s[0].state == NP_CONTEXT_WAIT { return ifx s[0].coding then "Making the worktree" else "Reading the issue cache"; }
  if s[0].state == NP_FAILED { n = np_put(out, n, "Failed   "); }
  if s[0].state == NP_STOPPED { n = np_put(out, n, "Stopped   "); }
  if s[0].cost_e6 < 0 { n = np_put(out, n, cast(string) s[0].model[0..<s[0].model_n]); return cast(string) out[0..<n]; }
  n = np_put(out, n, "in "); n = np_put_int(out, n, s[0].input);
  n = np_put(out, n, "  cached "); n = np_put_int(out, n, s[0].cache_read);
  n = np_put(out, n, "  out "); n = np_put_int(out, n, s[0].output);
  n = np_put(out, n, "   "); n = np_put_cost(out, n, s[0].cost_e6);
  n = np_put(out, n, "  session "); n = np_put_cost(out, n, s[0].session_cost_e6);
  if s[0].cut { n = np_put(out, n, "  (text cut)"); }
  return cast(string) out[0..<n];
}

// One frame: what a press asked for, what the agent sent, then the button and the panel.
// `now` is the host's clock, seconds since the epoch. Returns the vertex count; `panel` gets the
// panel's box in points (x, y, width, height; all 0 when it is shut) for the host to darken.
np_frame :: (s: []NextPanel, out: []f32, panel: []f32, width: f32, height: f32, d: f32, dt: f32, now: int) -> int #export_c #effects(all) {
  step := dt; if !(step > 0) { step = 0; } if step > 0.1 { step = 0.1; }
  s[0].now = now;
  if s[0].want_stop {
    s[0].want_stop = false;
    // Between turns too: the host's answer to what was asked is then left unread.
    if np_busy(s) { np_break(s); np_end(s, NP_STOPPED); s[0].request = 0; s[0].pending_work = false; s[0].coding = false; }
  }
  if s[0].want_refresh { s[0].want_refresh = false; np_ask(s, true, false); }
  if s[0].want_start { s[0].want_start = false; if s[0].started || s[0].state == NP_CONTEXT_WAIT { s[0].open = !s[0].open; s[0].focus = s[0].open; } else { np_ask(s, false, false); } }
  if s[0].state == NP_RUNNING { s[0].seconds += step; }
  np_poll(s);
  for i: 0..<8 { if i < panel.count { panel[i] = 0; } }
  if !(width > 0) || !(height > 0) || !(d > 0) { return 0; }
  pen := HdPen.{d = d, cyan = true, top = 0, bottom = height, sans = false};
  n := 0;
  auto_box := np_auto_box(width);
  n = hd_rect(out, n, auto_box, pen, ifx s[0].autopilot then 2 else 1, ifx s[0].autopilot then 1.0f32 else 0.6f32);
  auto_label := ifx s[0].autopilot then "Autopilot on" else "Autopilot off";
  n = eg_text(out, n, auto_label, auto_box.x + (auto_box.width - eg_width(auto_label, 16, EG_TITLE)) * 0.5, auto_box.y + 23, 16, d, EG_TITLE, ifx s[0].autopilot then EG_WHITE else EG_MID);
  b := np_button(width);
  n = hd_rect(out, n, b, pen, 2, 1);
  label := ifx np_busy(s) && s[0].open then "Stop" else "Next issue";
  n = eg_text(out, n, label, b.x + (b.width - eg_width(label, 16, EG_TITLE)) * 0.5, b.y + 23, 16, d, EG_TITLE, EG_WHITE);
  s[0].board[0].reserve = ifx s[0].open then f32(NP_PANEL_W) + 12 else 0;
  n = gb_frame(s[0].board[..], out, n, width, height, d, pen, now, panel);
  if !s[0].open { return n; }
  box := np_panel(width, height);
  if box.height < 220 { return n; }
  if panel.count >= 4 { panel[0] = box.x; panel[1] = box.y; panel[2] = box.width; panel[3] = box.height; }
  n = hd_rect(out, n, box, pen, 1, 0.8);
  n = eg_text(out, n, "Next issue", box.x + f32(NP_PAD), box.y + 30, 19, d, EG_TITLE, EG_WHITE);
  n = eg_text(out, n, cast(string) s[0].model[0..<s[0].model_n], box.x + f32(NP_PAD) + eg_width("Next issue", 19, EG_TITLE) + 14, box.y + 30, 13, d, EG_BODY, EG_DIM);
  c := np_close_box(box);
  n = hd_rect(out, n, c, pen, 1, 0.7);
  n = eg_text(out, n, "Close", c.x + (c.width - eg_width("Close", 14, EG_BODY)) * 0.5, c.y + 18, 14, d, EG_BODY, EG_WHITE);
  if s[0].state != NP_RUNNING && s[0].state != NP_CONTEXT_WAIT {
    r := np_refresh_box(box);
    n = hd_rect(out, n, r, pen, 1, 0.7);
    n = eg_text(out, n, "Refresh", r.x + (r.width - eg_width("Refresh", 14, EG_BODY)) * 0.5, r.y + 18, 14, d, EG_BODY, EG_WHITE);
  }
  n = hd_line(out, n, box.x, box.y + 46, box.x + box.width, box.y + 46, pen, 1, 0.5);
  // The conversation: every line laid out, then the ones in view drawn, the newest at the bottom.
  reply := np_reply_box(box);
  top := box.y + 46 + f32(NP_PAD); bottom := reply.y - 12;
  fits := cast(int) ((bottom - top) / f32(NP_LINE)); if fits < 1 { fits = 1; }
  text := cast(string) s[0].text[0..<s[0].text_n];
  inner := box.width - 2 * f32(NP_PAD);
  total := 0; at := 0;
  while at < text.count { l := np_line(text, at, inner); total += 1; at = l.next; }
  most := total - fits; if most < 0 { most = 0; }
  if s[0].scroll > most { s[0].scroll = most; } if s[0].scroll < 0 { s[0].scroll = 0; }
  first := most - s[0].scroll;
  row := 0; at = 0;
  while at < text.count {
    l := np_line(text, at, inner);
    if row >= first && row < first + fits && l.end > at {
      kind := EG_WHITE;
      if text[at] == '>' { kind = EG_ACCENT; }
      if l.end - at > 4 && text[at..<at + 4] == "You:" { kind = EG_MID; }
      n = eg_text(out, n, text[at..<l.end], box.x + f32(NP_PAD), top + f32(NP_LINE) * f32(row - first) + 13, f32(NP_SIZE), d, EG_BODY, kind);
    }
    row += 1; at = l.next;
  }
  // Your reply: the box is lit when the keys go to it, and it takes a reply on your turn.
  n = hd_rect(out, n, reply, pen, ifx s[0].focus then 2 else 1, ifx s[0].focus then 1.0f32 else 0.6f32);
  if s[0].draft_n > 0 {
    // The end of a long reply stays in view.
    from := 0; while from < s[0].draft_n && eg_width(cast(string) s[0].draft[from..<s[0].draft_n], NP_SIZE, EG_BODY) > reply.width - 24 { from += 1; }
    shown := cast(string) s[0].draft[from..<s[0].draft_n];
    n = eg_text(out, n, shown, reply.x + 10, reply.y + 22, f32(NP_SIZE), d, EG_BODY, EG_WHITE);
    if s[0].focus { cx := reply.x + 12 + eg_width(shown, NP_SIZE, EG_BODY); n = hd_line(out, n, cx, reply.y + 8, cx, reply.y + 26, pen, 0, 1); }
  } else if s[0].state == NP_YOURS {
    n = eg_text(out, n, "Reply in your own words, then Enter", reply.x + 10, reply.y + 22, f32(NP_SIZE), d, EG_BODY, EG_DIM);
  }
  n = hd_line(out, n, box.x, reply.y + reply.height + 12, box.x + box.width, reply.y + reply.height + 12, pen, 1, 0.5);
  words: [160] u8;
  n = eg_text(out, n, np_status(s, words[..]), box.x + f32(NP_PAD), box.y + box.height - 34, 13, d, EG_BODY, EG_MID);
  n = eg_text(out, n, cast(string) s[0].report[0..<s[0].report_n], box.x + f32(NP_PAD), box.y + box.height - 14, 13, d, EG_BODY, EG_DIM);
  return n;
}

// A press: phase 0 down, 1 moved, 2 up; points from the top left. True when the panel took it, so
// the host leaves the world's look-drag alone. A button acts when the press began and ended on it.
// A press on the panel gives it the keys; a press on the world takes them back.
np_pointer :: (s: []NextPanel, x: f32, y: f32, phase: int, width: f32, height: f32) -> bool #export_c #effects(all) {
  // The Golems board first, unless a press that began on Next issue is still held.
  if !(phase != 0 && s[0].down) && gb_pointer(s[0].board[..], x, y, phase, width, height, s[0].now) { return true; }
  b := np_button(width); box := np_panel(width, height);
  over_panel := s[0].open && np_in(box, x, y);
  if phase == 0 {
    s[0].down_in = 0;
    if np_in(b, x, y) { s[0].down_in = 1; }
    else if np_in(np_auto_box(width), x, y) { s[0].down_in = 4; }
    else if over_panel && np_in(np_close_box(box), x, y) { s[0].down_in = 2; }
    else if over_panel && s[0].state != NP_RUNNING && s[0].state != NP_CONTEXT_WAIT && np_in(np_refresh_box(box), x, y) { s[0].down_in = 3; }
    s[0].down = s[0].down_in != 0 || over_panel;
    s[0].focus = over_panel;
    return s[0].down;
  }
  if phase == 1 { return s[0].down; }
  took := s[0].down; s[0].down = false;
  if s[0].down_in == 1 && np_in(b, x, y) { if np_busy(s) && s[0].open { s[0].want_stop = true; } else { s[0].want_start = true; } }
  if s[0].down_in == 2 && np_in(np_close_box(box), x, y) { s[0].open = false; s[0].focus = false; }
  if s[0].down_in == 3 && np_in(np_refresh_box(box), x, y) { s[0].want_refresh = true; }
  if s[0].down_in == 4 && np_in(np_auto_box(width), x, y) { s[0].autopilot = !s[0].autopilot; }
  s[0].down_in = 0;
  return took;
}
// The wheel over the panel scrolls it. True when the panel took it.
np_wheel :: (s: []NextPanel, x: f32, y: f32, dy: f32, width: f32, height: f32) -> bool #export_c #effects(all) {
  if gb_wheel(s[0].board[..], x, y, dy, width, height) { return true; }
  if !s[0].open || !np_in(np_panel(width, height), x, y) { return false; }
  s[0].scroll += cast(int) (dy / 12);
  if s[0].scroll < 0 { s[0].scroll = 0; }
  return true;
}
// Whether the keys go to the reply, not to the world.
np_wants_keys :: (s: []NextPanel) -> bool #export_c #effects(all) { return s[0].open && s[0].focus; }
// A key for the reply: a printable ASCII byte, 13 Enter, 8 Backspace, 27 Escape (the keys go back to the world).
np_key :: (s: []NextPanel, key: int) #export_c #effects(all) {
  if key == 27 { s[0].focus = false; return; }
  if key == 8 { if s[0].draft_n > 0 { s[0].draft_n -= 1; } return; }
  if key == 13 { np_send(s); return; }
  if key >= 32 && key <= 126 && s[0].draft_n < NP_DRAFT && s[0].state != NP_RUNNING { s[0].draft[s[0].draft_n] = cast(u8) key; s[0].draft_n += 1; }
}
// Coding turns that have ended, for a host that waits on the loop.
np_runs :: (s: []NextPanel) -> int #export_c #effects(all) { return s[0].runs; }
// The issue you said to start, for the host's `next-context work`.
np_chosen :: (s: []NextPanel) -> int #export_c #effects(all) { return s[0].chosen; }
// What the host is asked for, once: 0 nothing, 1 the context, 2 the context refetched, 3 the
// worktree for np_chosen's issue (answered with np_work).
np_take_request :: (s: []NextPanel) -> int #export_c #effects(all) { r := s[0].request; s[0].request = 0; return r; }
// A ledger line or a decision waiting to be appended to its file, once; 0 when there is none.
np_take_usage :: (s: []NextPanel, out: []u8) -> int #export_c #effects(all) {
  n := s[0].usage_n; if n == 0 || n > out.count { return 0; }
  for i: 0..<n { out[i] = s[0].usage[i]; } s[0].usage_n = 0; return n;
}
np_take_decision :: (s: []NextPanel, out: []u8) -> int #export_c #effects(all) {
  if !s[0].decided { return 0; }
  action := cast(string) s[0].decided_action[0..<s[0].decided_action_n];
  line: [GY_DECISION_MAX] u8;
  n := gy_write_decision(GyDecision.{at = s[0].decided_at, action = action, issue = s[0].decided_issue,
    reason = cast(string) s[0].decided_reason[0..<s[0].decided_reason_n], session = cast(string) s[0].decided_session[0..<s[0].decided_session_n],
    coding_flow = ifx action == "start" then "started" else "none", has_scores = s[0].decided_scores, tier = tier_name(s[0].decided_tier), scores = s[0].decided_rubric}, line[..]);
  if n > out.count { return 0; }
  s[0].decided = false;
  for i: 0..<n { out[i] = line[i]; }
  return n;
}
// The app is quitting: the agent's process group goes with it.
np_close :: (s: []NextPanel) #export_c #effects(all) { if s[0].started { np_end(s, s[0].state); } }
// 0 idle, 1 reading the cache, 2 the agent's turn, 3 your turn, 4 failed, 5 stopped.
np_state :: (s: []NextPanel) -> int #export_c #effects(all) { return s[0].state; }
// Whether the host should run everglade-golems now, and its answer.
np_golems_due :: (s: []NextPanel, now: int) -> bool #export_c #effects(all) { return gb_due(s[0].board[..], now); }
np_golems :: (s: []NextPanel, text: string, now: int) #export_c #effects(all) { gb_take(s[0].board[..], text, now); }
np_golems_open :: (s: []NextPanel) #export_c #effects(all) { s[0].board[0].open = true; s[0].board[0].asked = 0; }
// Whether the host should run `everglade-golems refresh` now (the issues from GitHub, the build
// hosts), and a line the board hands the host, once: `open URL` or `copy TEXT`, a tab between.
np_golems_refresh_due :: (s: []NextPanel, now: int) -> bool #export_c #effects(all) { return gb_refresh_due(s[0].board[..], now); }
np_golems_action :: (s: []NextPanel, out: []u8) -> int #export_c #effects(all) { return gb_take_action(s[0].board[..], out); }
// The board's views, for a shot: 1 the first agent, 2 narrow, 3 narrow with the queue.
np_golems_view :: (s: []NextPanel, view: int) #export_c #effects(all) {
  if view == 1 && s[0].board[0].count > 0 { s[0].board[0].sel = 0; }
  if view == 2 || view == 3 { s[0].board[0].wide = false; s[0].board[0].queue = view == 3; }
}
np_size :: () -> int #export_c #effects(all) { return size_of(NextPanel); }
np_init :: (s: []NextPanel) #export_c #effects(all) { s[0].board[0].sel = -1; s[0].board[0].wide = true; s[0].autopilot = true; s[0].state = NP_IDLE; s[0].cost_e6 = -1; s[0].open = false; s[0].text_n = 0; s[0].started = false; s[0].model_n = np_put(s[0].model[..], 0, NP_MODEL); }
np_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
np_max_vertices :: () -> int #export_c #effects(all) { return NP_MAX_VERTICES; }

