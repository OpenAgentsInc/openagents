#test "next issue: the picker rates the issue it starts, and the rating picks the coding model" {
  for word: [5] string.["\"scope\"", "\"ambiguity\"", "\"risk\"", "\"depth\"", "\"delegable\""] {
    found := false;
    for i: 0..<NP_CHOOSE_SCHEMA.count - word.count + 1 { if NP_CHOOSE_SCHEMA[i..<i + word.count] == word { found = true; } }
    #assert found;
  }
  s: [1] NextPanel; np_init(s[..]);
  np_choose(s[..], "{\"action\":\"start\",\"issue\":13116,\"reason\":\"auto\",\"scope\":0,\"ambiguity\":0,\"risk\":1,\"depth\":0,\"delegable\":true}");
  #assert s[0].chosen == 13116 && s[0].pending_work && s[0].tier == TIER_HAIKU && tier_model(s[0].tier) == "claude-haiku-5-5";
  t: [1] NextPanel; np_init(t[..]);
  np_choose(t[..], "{\"action\":\"start\",\"issue\":13128,\"reason\":\"auto\",\"scope\":3,\"ambiguity\":2,\"risk\":2,\"depth\":3,\"delegable\":false}");
  #assert t[0].chosen == 0 && !t[0].pending_work;   // a tracker is never started
}
