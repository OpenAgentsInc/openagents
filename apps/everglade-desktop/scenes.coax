// Everglade's apps, the worlds you can open (everglade/docs/app-scenes-spec.md): the app opens on
// a list of five, and you hop between them.
//
//   Everglade                  the main flow, as the web has it: make a character, then the glade
//   The Golemancers' Workshop  workshop.coax
//   The Archery Range          the web's Archery Range realm (everglade/docs/archery-range-spec.md)
//   Everglade Experimental     the web's Experimental world
//   The Bitcoin Lab            the web's Bitcoin Lab realm (apps/openagents-web/old/labs/bitcoin-lab-walk.coax)
//
// The Workshop runs here. Everglade is the web's everglade2 realm, and the Archery Range and
// Experimental are the web's fivelab realm on their own pages: a host that can run a realm's page
// (metaverse-engine/host/apple/, the Mac app) says so with sc_host_runs, draws the realm itself and sends it
// the keys; this file then draws only the Worlds button over it. On a host that can't yet,
// choosing the world says where it runs today. Nothing pretends: there is no web view standing in,
// and no scene written for the app alone stands in for a realm.
//
// This file is the one face every host calls (face.h, face.c): it holds each scene's state, sends
// a frame, a key, a press and a stick to the scene that is open, and draws what they share: the
// list, and the Worlds button that brings you back to it (Escape does too, outside a realm).
//   coax/bin/coax test --library apps/everglade-desktop/scenes.coax --only "scenes"
#load "workshop.coax";
#load "account.coax";   // your account's card, on a host that offers a login (sc_login_offer)
#load "crash-ask.coax"; // the question after a crash, on a host that draws its own (sc_crash_ask, #13379)

SC_LIST :: 0; SC_MAIN :: 1; SC_WORKSHOP :: 2; SC_RANGE :: 3; SC_EXPERIMENTAL :: 4; SC_BTCLAB :: 5;
SC_WORLDS :: 5;
// The place a host draws behind a scene: the temple. The list and the cards are shown over it,
// seen from a camera that walks slowly round it.
SC_PLACE_TEMPLE :: 1;

Scenes :: struct {
  scene: int = SC_LIST;
  workshop: [1] Workshop;
  time: f32; width: f32; height: f32;
  touch: bool; safe_left: f32; safe_top: f32; safe_bottom: f32;
  press_row: int; press_back: bool;   // the row of the list, or the Worlds button, a press began on
  took: bool;                         // the last press let go was the list's or a button's, not the world's
  realm_main: bool;                   // this host runs Everglade's realm itself (sc_host_runs)
  realm_experimental: bool;           // and Experimental's
  realm_range: bool;                  // and the Archery Range's
  realm_btclab: bool;                 // and the Bitcoin Lab's
  opening: bool;                      // the host is still opening the realm of the world that is open (sc_host_opening)
  card: [1] AcCard;                   // your account (account.coax)
  ask: [1] CaAsk;                     // the question after a crash (crash-ask.coax)
}

sc_name :: (world: int) -> string {
  if world == SC_MAIN { return "Everglade"; }
  if world == SC_WORKSHOP { return "The Golemancers' Workshop"; }
  if world == SC_RANGE { return "The Archery Range"; }
  if world == SC_BTCLAB { return "The Bitcoin Lab"; }
  return "Everglade Experimental";
}
sc_about :: (world: int) -> string {
  if world == SC_MAIN { return "Make your character, then walk into the glade"; }
  if world == SC_WORKSHOP { return "A marble temple in the night, and an unfinished golem"; }
  if world == SC_RANGE { return "Shoot for points on foot, from horseback and dragonback"; }
  if world == SC_BTCLAB { return "Walk through bytes, hashes and a chain of blocks"; }
  return "Classes, monsters, a horse and a red dragon";
}
// Whether a world is one of this file's own scenes.
sc_here :: (world: int) -> bool { return world == SC_WORKSHOP; }
// Whether a world runs in this app today: this file's scenes, and a realm the host runs.
sc_runs :: (s: []Scenes, world: int) -> bool { return sc_here(world) || sc_realm(s, world); }
// Whether a world is a realm this host runs itself.
sc_realm :: (s: []Scenes, world: int) -> bool {
  return (world == SC_MAIN && s[0].realm_main) || (world == SC_RANGE && s[0].realm_range) || (world == SC_EXPERIMENTAL && s[0].realm_experimental) || (world == SC_BTCLAB && s[0].realm_btclab);
}
// Whether the host is drawing a realm now, under the Worlds button.
sc_in_realm :: (s: []Scenes) -> bool { return sc_realm(s, s[0].scene); }
// Where a world that doesn't runs meanwhile.
sc_address :: (world: int) -> string {
  if world == SC_MAIN { return "openagents.com/worlds/character-creator"; }
  if world == SC_RANGE { return "openagents.com/worlds/archery-range"; }
  if world == SC_EXPERIMENTAL { return "openagents.com/worlds/everglade-experimental"; }
  if world == SC_BTCLAB { return "openagents.com/worlds/bitcoin-lab"; }
  return "";
}

// ---- the boxes, in points

sc_left :: (s: []Scenes) -> f32 { return 36 + s[0].safe_left; }
// Row `i` (0 the first) of the list.
sc_row :: (s: []Scenes, i: int) -> HudBox {
  left := sc_left(s); w := s[0].width - 2 * left; if w > 560 { w = 560; } if w < 120 { w = 120; }
  return HudBox.{x = left, y = s[0].safe_top + 132 + 78 * cast(f32) i, width = w, height = 66};
}
sc_row_at :: (s: []Scenes, x: f32, y: f32) -> int {
  for i: 0..<SC_WORLDS { b := sc_row(s, i); if x >= b.x && x <= b.x + b.width && y >= b.y && y <= b.y + b.height { return i; } }
  return -1;
}
// The Worlds button, under a scene's title. Over a realm, which has no title of ours, it sits at
// the middle of the top edge, between the realm's own panels in the corners. An upright phone has
// no room there: the realm's name plate runs the width of its top (#13152). There the button is in
// the band beside the notch, over the realm's picture, which begins under that band; a narrow screen
// with no such band has it at the right, under the name plate.
SC_NARROW :: 600.0;      // points: narrower than this, a realm's top edge is its name plate's
SC_NOTCH_BAND :: 44.0;   // points: a top inset this deep has room for the button beside the notch
sc_back :: (s: []Scenes) -> HudBox {
  if sc_in_realm(s) {
    if s[0].width >= SC_NARROW { return HudBox.{x = (s[0].width - 92) * 0.5, y = s[0].safe_top + 10, width = 92, height = 32}; }
    if s[0].safe_top >= SC_NOTCH_BAND { return HudBox.{x = 22 + s[0].safe_left, y = s[0].safe_top - 36, width = 92, height = 30}; }
    return HudBox.{x = s[0].width - 104, y = s[0].safe_top + 92, width = 92, height = 32};
  }
  return HudBox.{x = sc_left(s), y = s[0].safe_top + 106, width = 92, height = 32};
}
sc_on_back :: (s: []Scenes, x: f32, y: f32) -> bool {
  b := sc_back(s);
  return s[0].scene != SC_LIST && x >= b.x && x <= b.x + b.width && y >= b.y && y <= b.y + b.height;
}

// Opens a world (SC_LIST: back to the list). Every key and finger is let go on the way.
sc_open :: (s: []Scenes, world: int) {
  if world < SC_LIST || world > SC_WORLDS { return; }
  released := ws_key(s[0].workshop[..], -1, true);
  s[0].workshop[0].pad_x = 0; s[0].workshop[0].pad_y = 0;
  s[0].scene = world; s[0].press_row = -1; s[0].press_back = false;
}

// ---- a frame

// The list, or a card for a world that doesn't run here yet.
sc_list :: (s: []Scenes, out: []f32, d: f32) -> int {
  pen := HdPen.{d = d, cyan = true, top = 0, bottom = s[0].height, sans = false};
  left := sc_left(s); top := s[0].safe_top; n := 0;
  n = eg_text(out, n, "Everglade", left, top + 66, 40, d, EG_TITLE, EG_WHITE);
  if s[0].scene == SC_LIST && s[0].ask[0].asking { return ca_card(s, s[0].ask[..], out, n, d); }
  if s[0].scene == SC_LIST && s[0].card[0].open { return ac_card(s, s[0].card[..], out, n, d); }
  if s[0].scene == SC_LIST {
    n = ac_open_button(s, s[0].card[..], out, n, d);
    n = eg_text(out, n, "Choose a world", left + 1, top + 94, 18, d, EG_TITLE, EG_MID);
    for i: 0..<SC_WORLDS {
      b := sc_row(s, i); world := i + 1; here := sc_runs(s, world);
      n = hd_rect(out, n, b, pen, ifx here then 2 else 1, ifx here then 0.9f32 else 0.5f32);
      n = eg_text(out, n, sc_name(world), b.x + 16, b.y + 28, 19, d, EG_TITLE, ifx here then EG_WHITE else EG_MID);
      // On a narrow screen the line about a world gives way to whether it opens here.
      about := ifx here then sc_about(world) else "On the web for now";
      if b.width >= 430 && !here { about = sc_about(world); n = eg_text(out, n, "On the web for now", b.x + b.width - 16 - eg_width("On the web for now", 13, EG_BODY), b.y + 26, 13, d, EG_BODY, EG_DIM); }
      n = eg_text(out, n, about, b.x + 16, b.y + 50, 14, d, EG_BODY, EG_DIM);
    }
    hint := ifx s[0].touch then "Tap a world" else "Click a world, or press 1 to 5";
    n = eg_text(out, n, hint, left, s[0].height - 30 - s[0].safe_bottom, 15, d, EG_BODY, EG_DIM);
    return n;
  }
  n = eg_text(out, n, sc_name(s[0].scene), left + 1, top + 94, 18, d, EG_TITLE, EG_MID);
  y := top + 190;
  n = eg_text(out, n, "This world isn't in this app yet.", left, y, 19, d, EG_TITLE, EG_WHITE);
  n = eg_text(out, n, ifx s[0].scene != SC_WORKSHOP then "It runs in the Mac app, and on the web:" else "It runs on the web today:", left, y + 34, 15, d, EG_BODY, EG_MID);
  n = eg_text(out, n, sc_address(s[0].scene), left, y + 58, 15, d, EG_BODY, EG_ACCENT);
  return n;
}

// While the host opens a realm (its pack is read and its pictures are drawn, a few seconds on a
// phone): the world's name and one line, in the middle of the screen.
sc_opening :: (s: []Scenes, out: []f32, d: f32) -> int {
  name := sc_name(s[0].scene); line := "Opening the world";
  y := s[0].height * 0.5;
  n := eg_text(out, 0, name, (s[0].width - eg_width(name, 22, EG_TITLE)) * 0.5, y - 8, 22, d, EG_TITLE, EG_WHITE);
  return eg_text(out, n, line, (s[0].width - eg_width(line, 15, EG_BODY)) * 0.5, y + 22, 15, d, EG_BODY, EG_MID);
}

sc_frame :: (s: []Scenes, out: []f32, width: f32, height: f32, d: f32, dt: f32) -> int {
  step := dt; if !(step > 0) { step = 0; } if step > 0.1 { step = 0.1; }
  s[0].time += step; s[0].width = width; s[0].height = height;
  n := 0;
  if s[0].scene == SC_WORKSHOP { n = ws_frame(s[0].workshop[..], out, width, height, d, dt); }
  else if sc_in_realm(s) { n = ifx s[0].opening && width > 0 && height > 0 && d > 0 then sc_opening(s, out, d) else 0; }   // the host draws the realm; only the Worlds button is ours, and a line while the realm opens
  else { if !(width > 0) || !(height > 0) || !(d > 0) { return 0; } n = sc_list(s, out, d); }
  if !(width > 0) || !(height > 0) || !(d > 0) { return n; }
  return n + sc_worlds_button(s, out, n, d);
}
// The Worlds button, drawn after a scene's own strokes; the count of vertices it added.
sc_worlds_button :: (s: []Scenes, out: []f32, at: int, d: f32) -> int {
  if s[0].scene == SC_LIST { return 0; }
  pen := HdPen.{d = d, cyan = true, top = 0, bottom = s[0].height, sans = false};
  b := sc_back(s);
  n := hd_rect(out, at, b, pen, 1, 0.7);
  n = eg_text(out, n, "Worlds", b.x + (b.width - eg_width("Worlds", 15, EG_TITLE)) * 0.5, b.y + 21, 15, d, EG_TITLE, EG_WHITE);
  return n - at;
}

// ---- the host's face

sc_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
sc_max_vertices :: () -> int #export_c #effects(all) { return WS_MAX_VERTICES; }
sc_state_size :: () -> int #export_c #effects(all) { return size_of(Scenes); }
sc_state_init :: (s: []Scenes) #export_c #effects(all) { s[0] = Scenes.{}; s[0].press_row = -1; s[0].card[0].press = AC_B_NONE; s[0].ask[0].press = CA_B_NONE; }
sc_draw :: (s: []Scenes, out: []f32, width: f32, height: f32, d: f32, dt: f32) -> int #export_c #effects(all) { return sc_frame(s, out, width, height, d, dt); }
// Which world is open (SC_*), and which place the host draws behind it (SC_PLACE_*).
sc_scene :: (s: []Scenes) -> int #export_c #effects(all) { return s[0].scene; }
sc_place :: (s: []Scenes) -> int #export_c #effects(all) { return SC_PLACE_TEMPLE; }
// Opens a world from outside (a host's own menu or a launch argument): SC_LIST to SC_BTCLAB.
sc_go :: (s: []Scenes, world: int) #export_c #effects(all) { sc_open(s, world); }
// The host says whether it runs a realm itself (SC_MAIN and SC_RANGE: the web's everglade2 on
// Everglade's and the Archery Range's pages; SC_EXPERIMENTAL: the web's fivelab on Experimental's
// page). It then draws the realm and sends
// it the keys and presses while that world is open; this file draws the Worlds button over it and
// takes the presses that begin on it (sc_on_worlds).
sc_host_runs :: (s: []Scenes, world: int, runs: bool) #export_c #effects(all) {
  if world == SC_MAIN { s[0].realm_main = runs; }
  if world == SC_RANGE { s[0].realm_range = runs; }
  if world == SC_EXPERIMENTAL { s[0].realm_experimental = runs; }
  if world == SC_BTCLAB { s[0].realm_btclab = runs; }
}
sc_on_worlds :: (s: []Scenes, x: f32, y: f32) -> bool #export_c #effects(all) { return sc_on_back(s, x, y); }
// The host is opening the realm of the world that is open, off the frame: the scene says so until
// the host has it (or it didn't open).
sc_host_opening :: (s: []Scenes, opening: bool) #export_c #effects(all) { s[0].opening = opening; }

// A key (workshop.coax ws_key's codes). Escape (27) is the list from anywhere; on the list 1 to 5
// open a world.
sc_key :: (s: []Scenes, key: int, down: bool) -> bool #export_c #effects(all) {
  if key == -1 { a := ws_key(s[0].workshop[..], -1, true); s[0].press_row = -1; s[0].press_back = false; return true; }
  if s[0].scene == SC_LIST && s[0].ask[0].asking { return true; }   // the question waits for its own two buttons
  if s[0].scene == SC_LIST && s[0].card[0].open { if key == 27 && down { s[0].card[0].open = false; s[0].card[0].focus = false; } return true; }
  if key == 27 { if down && s[0].scene != SC_LIST { sc_open(s, SC_LIST); } return true; }
  if s[0].scene == SC_WORKSHOP { return ws_key(s[0].workshop[..], key, down); }
  if s[0].scene == SC_LIST && down && key >= 49 && key < 49 + SC_WORLDS { sc_open(s, key - 48); return true; }
  return false;
}
// A press: phase 0 down, 1 moved, 2 up; points from the top left. The Worlds button and the list
// take it first; a scene gets the rest.
sc_pointer :: (s: []Scenes, x: f32, y: f32, phase: int) #export_c #effects(all) {
  if ca_pointer(s, s[0].ask[..], x, y, phase) { s[0].took = true; s[0].press_row = -1; return; }
  if ac_pointer(s, s[0].card[..], x, y, phase) { s[0].took = true; s[0].press_row = -1; return; }
  if phase == 0 {
    s[0].took = false; s[0].press_back = sc_on_back(s, x, y);
    s[0].press_row = ifx s[0].scene == SC_LIST then sc_row_at(s, x, y) else -1;
    if s[0].press_back || s[0].scene != SC_WORKSHOP { return; }
  }
  if phase == 2 && (s[0].press_back || s[0].press_row >= 0) {
    back := s[0].press_back && sc_on_back(s, x, y); row := s[0].press_row;
    s[0].press_back = false; s[0].press_row = -1; s[0].took = true;
    if back { sc_open(s, SC_LIST); } else if row >= 0 && s[0].scene == SC_LIST && sc_row_at(s, x, y) == row { sc_open(s, row + 1); }
    return;
  }
  if s[0].press_back { return; }
  if s[0].scene == SC_WORKSHOP { ws_pointer(s[0].workshop[..], x, y, phase); }
  if phase == 2 && s[0].scene != SC_WORKSHOP { s[0].took = true; }
}
// Whether a touch that begins at a point is the list's or a button's, so a host doesn't make it
// the stick that moves you.
sc_claims :: (s: []Scenes, x: f32, y: f32) -> bool #export_c #effects(all) {
  if s[0].scene != SC_WORKSHOP { return true; }
  if sc_on_back(s, x, y) { return true; }
  w := s[0].workshop[..];
  return w[0].turn_can && w[0].bw > 0 && x >= w[0].bx && x <= w[0].bx + w[0].bw && y >= w[0].by && y <= w[0].by + w[0].bh;
}
// A tap at a point, after its press was let go: true when it was the list's, a button's or the
// Workshop's Gyro switch (which it flips), so the host doesn't jump.
sc_tap :: (s: []Scenes, x: f32, y: f32) -> bool #export_c #effects(all) {
  if s[0].took { return true; }
  if s[0].scene == SC_WORKSHOP { return ws_tap(s[0].workshop[..], x, y); }
  return true;
}
sc_wheel :: (s: []Scenes, dy: f32) #export_c #effects(all) {
  if s[0].scene == SC_WORKSHOP { ws_wheel(s[0].workshop[..], dy); }
}
// A touch stick. It marks the host as a touch screen for every scene.
sc_pad :: (s: []Scenes, x: f32, y: f32) #export_c #effects(all) {
  s[0].touch = true; s[0].workshop[0].touch = true;
  if s[0].scene == SC_WORKSHOP { ws_pad(s[0].workshop[..], x, y); }
}
sc_safe :: (s: []Scenes, left: f32, top: f32, bottom: f32) #export_c #effects(all) {
  ws_safe(s[0].workshop[..], left, top, bottom);
  w := s[0].workshop[0];
  s[0].safe_left = w.safe_left; s[0].safe_top = w.safe_top; s[0].safe_bottom = w.safe_bottom;
}
// The phone's turn as camera look (workshop.coax): the Workshop draws the Gyro switch.
sc_turn_offer :: (s: []Scenes) #export_c #effects(all) { ws_turn_offer(s[0].workshop[..]); }
sc_turns :: (s: []Scenes) -> bool #export_c #effects(all) { return s[0].scene == SC_WORKSHOP && ws_turns(s[0].workshop[..]); }
sc_turn :: (s: []Scenes, yaw: f32, pitch: f32) #export_c #effects(all) {
  if s[0].scene == SC_WORKSHOP { ws_turn(s[0].workshop[..], yaw, pitch); }
}
// Your account (account.coax). A host that can log in offers it; the list then has Log in.
sc_login_offer :: (s: []Scenes) #export_c #effects(all) { s[0].card[0].offered = true; }
// 1 while the card's box takes typing: the host shows the keyboard.
sc_login_wants_keys :: (s: []Scenes) -> bool #export_c #effects(all) {
  c := s[0].card[..];
  return c[0].offered && c[0].open && c[0].focus && c[0].state != AC_IN && s[0].scene == SC_LIST;
}
// 1 while the card is open (a phone's Back closes it: sc_key 27).
sc_login_open :: (s: []Scenes) -> bool #export_c #effects(all) { return s[0].card[0].open && s[0].scene == SC_LIST; }
// A typed character: printable ASCII, 8 Backspace, 13 Enter.
sc_login_char :: (s: []Scenes, ch: int) -> bool #export_c #effects(all) { return s[0].scene == SC_LIST && ac_char(s[0].card[..], ch); }
// What the person asked for (AC_EMAIL with the email, AC_CODE with the code, AC_KEY, AC_LOGOUT,
// AC_BACK), once: sc_login_text first, then sc_login_take, which clears it.
sc_login_text :: (s: []Scenes, out: []u8) -> int #export_c #effects(all) {
  c := s[0].card[..]; n := ifx c[0].text_n < out.count then c[0].text_n else out.count;
  for i: 0..<n { out[i] = c[0].text[i]; }
  return n;
}
sc_login_take :: (s: []Scenes) -> int #export_c #effects(all) { a := s[0].card[0].action; s[0].card[0].action = AC_NONE; return a; }
// What the host's login says: AC_OUT, AC_SENT or AC_IN, whether a request is under way, the
// server's words and who is logged in.
sc_login_show :: (s: []Scenes, state: int, busy: bool, words: string, who: string) #export_c #effects(all) { ac_show(s[0].card[..], state, busy, words, who); }

// A crash log waits for the person's word (#13379): the list asks, once.
sc_crash_ask :: (s: []Scenes) #export_c #effects(all) { s[0].ask[0].asking = true; s[0].ask[0].answer = CA_NONE; s[0].ask[0].press = CA_B_NONE; }
// The answer, once: CA_SEND or CA_DONT, then CA_NONE until the host asks again.
sc_crash_take :: (s: []Scenes) -> int #export_c #effects(all) { a := s[0].ask[0].answer; s[0].ask[0].answer = CA_NONE; return a; }
// Where you stand, for the host's model: nobody stands on the list or a card.
sc_you :: (s: []Scenes, out: []f32) -> bool #export_c #effects(all) {
  if s[0].scene == SC_WORKSHOP { return ws_you(s[0].workshop[..], out); }
  return false;
}
// The view. Behind the list and the cards: an eye that walks round the temple, looking at the golem.
sc_camera :: (s: []Scenes, width: f32, height: f32, d: f32, out: []f32) -> bool #export_c #effects(all) {
  if s[0].scene == SC_WORKSHOP { return ws_camera(s[0].workshop[..], width, height, d, out); }
  if out.count < 16 { return false; }
  a := s[0].time * 0.07 + 1.2;
  v := ws_view(pc.Vec3.{x = math_cos(a) * 6.2, y = 2.6, z = math_sin(a) * 6.2}, pc.Vec3.{x = 0, y = 1.7, z = 0}, width, height, d);
  out[0] = v.ex; out[1] = v.ey; out[2] = v.ez; out[3] = 0;
  out[4] = v.rx; out[5] = 0; out[6] = v.rz; out[7] = 0;
  out[8] = v.ux; out[9] = v.uy; out[10] = v.uz; out[11] = 0;
  out[12] = v.fx; out[13] = v.fy; out[14] = v.fz; out[15] = v.focal;
  return true;
}

#test "scenes: the app opens on the list of five worlds, and the temple is behind it with nobody in it" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; you: [5] f32; cam: [16] f32;
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert sc_scene(s[..]) == SC_LIST && n > 200 && n % 6 == 0 && sc_place(s[..]) == SC_PLACE_TEMPLE;
  #assert !sc_you(s[..], you[..]) && sc_camera(s[..], 1280, 800, 2, cam[..]) && cam[15] > 0;
  #assert sc_claims(s[..], 10, 10) && sc_row_at(s[..], 5000, 5000) == -1;
  for i: 0..<SC_WORLDS { b := sc_row(s[..], i); #assert sc_row_at(s[..], b.x + 5, b.y + 5) == i && b.y + b.height < 800; }
  #assert sc_here(SC_WORKSHOP) && !sc_here(SC_RANGE) && !sc_here(SC_MAIN) && !sc_here(SC_EXPERIMENTAL) && sc_address(SC_MAIN).count > 0 && sc_address(SC_EXPERIMENTAL).count > 0;
  #assert sc_address(SC_RANGE) == "openagents.com/worlds/archery-range" && sc_address(SC_WORKSHOP).count == 0;
  #assert sc_address(SC_BTCLAB) == "openagents.com/worlds/bitcoin-lab" && !sc_runs(s[..], SC_BTCLAB);
  sc_host_runs(s[..], SC_BTCLAB, true); #assert sc_runs(s[..], SC_BTCLAB) && sc_key(s[..], 53, true) && sc_in_realm(s[..]); sc_go(s[..], SC_LIST);
  // An upright phone: the five rows fit, inside its width.
  t: [1] Scenes; sc_state_init(t[..]); sc_pad(t[..], 0, 0); sc_safe(t[..], 0, 59, 34);
  n = sc_draw(t[..], out[..], 402, 874, 3, 0.016);
  last := sc_row(t[..], SC_WORLDS - 1); #assert n > 200 && last.x + last.width <= 402 && last.y + last.height < 874 - 60;
}
#test "scenes: a press on a row opens that world, Worlds and Escape come back, and a press let go elsewhere does nothing" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32;
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  w := sc_row(s[..], SC_WORKSHOP - 1);
  sc_pointer(s[..], w.x + 9, w.y + 9, 0); sc_pointer(s[..], w.x + 9, w.y + 300, 2);
  #assert sc_scene(s[..]) == SC_LIST && sc_tap(s[..], 0, 0);
  sc_pointer(s[..], w.x + 9, w.y + 9, 0); sc_pointer(s[..], w.x + 9, w.y + 9, 2);
  #assert sc_scene(s[..]) == SC_WORKSHOP && sc_tap(s[..], 0, 0);
  n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  you: [5] f32; #assert sc_you(s[..], you[..]) && you[2] > 4 && !sc_claims(s[..], 700, 500);
  b := sc_back(s[..]); #assert sc_claims(s[..], b.x + 4, b.y + 4);
  sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert sc_scene(s[..]) == SC_LIST;
  // on a host that doesn't run the Archery Range's realm, its row opens a card over the temple, with nobody in it
  #assert sc_key(s[..], 51, true) && sc_scene(s[..]) == SC_RANGE && sc_place(s[..]) == SC_PLACE_TEMPLE;
  n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert n > 200 && !sc_you(s[..], you[..]) && sc_claims(s[..], 600, 400);
  #assert sc_key(s[..], 27, true) && sc_scene(s[..]) == SC_LIST;
}
#test "scenes: keys and drags go to the open world only, and leaving it lets every key go" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32;
  #assert sc_key(s[..], 50, true) && sc_scene(s[..]) == SC_WORKSHOP;
  #assert sc_key(s[..], 119, true) && s[0].workshop[0].keys == 1;
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  sc_pointer(s[..], 600, 400, 0); sc_pointer(s[..], 660, 400, 1); #assert s[0].workshop[0].look_x < 0;
  sc_pointer(s[..], 660, 400, 2); #assert !sc_tap(s[..], 660, 400);
  #assert sc_key(s[..], 27, true) && s[0].workshop[0].keys == 0;
  // On a card, a key is nobody's: 2 doesn't open another world from there.
  sc_go(s[..], SC_RANGE); n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert !sc_key(s[..], 50, true) && sc_scene(s[..]) == SC_RANGE;
  sc_go(s[..], SC_LIST); #assert sc_scene(s[..]) == SC_LIST;
}
#test "scenes: a world that isn't here yet opens a card that says where it runs, and Worlds comes back from it" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; you: [5] f32;
  #assert sc_key(s[..], 49, true) && sc_scene(s[..]) == SC_MAIN;
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert n > 200 && !sc_you(s[..], you[..]) && sc_claims(s[..], 600, 400) && sc_place(s[..]) == SC_PLACE_TEMPLE;
  b := sc_back(s[..]); sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert sc_scene(s[..]) == SC_LIST;
  sc_go(s[..], SC_EXPERIMENTAL); #assert sc_scene(s[..]) == SC_EXPERIMENTAL; sc_go(s[..], 99); #assert sc_scene(s[..]) == SC_EXPERIMENTAL;
}
#test "scenes: a host that runs Everglade's realm gets only the Worlds button to draw over it, and the row reads as a world that opens" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; you: [5] f32;
  #assert !sc_runs(s[..], SC_MAIN) && sc_runs(s[..], SC_WORKSHOP) && !sc_runs(s[..], SC_EXPERIMENTAL);
  sc_host_runs(s[..], SC_WORKSHOP, true); sc_host_runs(s[..], SC_LIST, true); #assert !sc_realm(s[..], SC_WORKSHOP) && !sc_realm(s[..], SC_LIST) && !sc_runs(s[..], SC_RANGE);
  sc_host_runs(s[..], SC_MAIN, true); #assert sc_runs(s[..], SC_MAIN) && !sc_in_realm(s[..]);
  list := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert sc_key(s[..], 49, true) && sc_scene(s[..]) == SC_MAIN && sc_in_realm(s[..]) && !sc_you(s[..], you[..]);
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  // the button alone: far fewer strokes than the list, and none of a card's
  #assert n > 0 && n < 400 && n < list;
  b := sc_back(s[..]); #assert b.x > 500 && b.x + b.width < 780 && b.y < 40 && sc_on_worlds(s[..], b.x + 4, b.y + 4) && !sc_on_worlds(s[..], 600, 400) && !sc_on_worlds(s[..], 40, 20);
  sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert sc_scene(s[..]) == SC_LIST && !sc_on_worlds(s[..], b.x + 4, b.y + 4);
  // without the realm the same row opens the card, as before
  sc_host_runs(s[..], SC_MAIN, false); sc_go(s[..], SC_MAIN); n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert !sc_in_realm(s[..]) && n > 200;
}
#test "scenes: a host that runs Experimental's realm opens it from its row and from 4, with only the Worlds button over it, and Everglade's row is its own" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; you: [5] f32;
  sc_host_runs(s[..], SC_EXPERIMENTAL, true);
  #assert sc_runs(s[..], SC_EXPERIMENTAL) && !sc_runs(s[..], SC_MAIN) && !sc_in_realm(s[..]);
  list := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  r := sc_row(s[..], SC_EXPERIMENTAL - 1);
  sc_pointer(s[..], r.x + 9, r.y + 9, 0); sc_pointer(s[..], r.x + 9, r.y + 9, 2);
  #assert sc_scene(s[..]) == SC_EXPERIMENTAL && sc_in_realm(s[..]) && !sc_you(s[..], you[..]);
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert n > 0 && n < 400 && n < list;
  b := sc_back(s[..]); #assert b.y < 40 && sc_on_worlds(s[..], b.x + 4, b.y + 4) && !sc_on_worlds(s[..], 600, 400);
  sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert sc_scene(s[..]) == SC_LIST;
  #assert sc_key(s[..], 52, true) && sc_in_realm(s[..]);
  // Everglade's row on this host is still a card, and a host that stops running Experimental gets its card back
  sc_go(s[..], SC_MAIN); #assert !sc_in_realm(s[..]);
  sc_host_runs(s[..], SC_EXPERIMENTAL, false); sc_go(s[..], SC_EXPERIMENTAL); n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert !sc_in_realm(s[..]) && n > 200;
}
#test "scenes: a host that runs the Archery Range's realm opens it from its row and from 3, with only the Worlds button over it, and Experimental's row is its own" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; you: [5] f32;
  sc_host_runs(s[..], SC_RANGE, true);
  #assert sc_runs(s[..], SC_RANGE) && !sc_runs(s[..], SC_EXPERIMENTAL) && !sc_runs(s[..], SC_MAIN) && !sc_in_realm(s[..]);
  list := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  r := sc_row(s[..], SC_RANGE - 1);
  sc_pointer(s[..], r.x + 9, r.y + 9, 0); sc_pointer(s[..], r.x + 9, r.y + 9, 2);
  #assert sc_scene(s[..]) == SC_RANGE && sc_in_realm(s[..]) && !sc_you(s[..], you[..]);
  n := sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert n > 0 && n < 400 && n < list;
  b := sc_back(s[..]); sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert sc_scene(s[..]) == SC_LIST;
  #assert sc_key(s[..], 51, true) && sc_scene(s[..]) == SC_RANGE && sc_in_realm(s[..]);
  // Experimental's row on this host is still a card, and a host that stops running the range gets its card back
  sc_go(s[..], SC_EXPERIMENTAL); #assert !sc_in_realm(s[..]);
  sc_host_runs(s[..], SC_RANGE, false); sc_go(s[..], SC_RANGE); n = sc_draw(s[..], out[..], 1280, 800, 2, 0.016);
  #assert !sc_in_realm(s[..]) && n > 200;
}
#test "scenes: on an upright phone Worlds is beside the notch, clear of the realm's picture; with no notch it is under the name plate at the right; a line is drawn while the realm opens" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32;
  sc_pad(s[..], 0, 0); sc_safe(s[..], 0, 59, 34); sc_host_runs(s[..], SC_RANGE, true); sc_go(s[..], SC_RANGE);
  n := sc_draw(s[..], out[..], 402, 874, 3, 0.016);
  // the realm's picture begins at the inset's foot (y 59): the button is wholly over it, left of the notch's island
  b := sc_back(s[..]); #assert sc_in_realm(s[..]) && b.y >= 20 && b.y + b.height <= 59 && b.x >= 16 && b.x + b.width < 402 * 0.5 - 60 && n > 0;
  #assert sc_on_worlds(s[..], b.x + 4, b.y + 4) && !sc_on_worlds(s[..], 201, 59 + 26);
  // while it opens: the world's name and a line, more strokes than the button alone
  sc_host_opening(s[..], true); m := sc_draw(s[..], out[..], 402, 874, 3, 0.016); #assert m > n;
  sc_host_opening(s[..], false); #assert sc_draw(s[..], out[..], 402, 874, 3, 0.016) == n;
  // no notch (a small phone): at the right, under where the name plate ends
  sc_safe(s[..], 0, 20, 0); n = sc_draw(s[..], out[..], 375, 667, 2, 0.016);
  b = sc_back(s[..]); #assert b.y >= 20 + 88 && b.x + b.width <= 375 - 8 && b.x > 375 * 0.5;
  // turned on its side it is wide: the middle of the top edge, as on a desktop
  sc_safe(s[..], 59, 0, 21); n = sc_draw(s[..], out[..], 874, 402, 3, 0.016);
  b = sc_back(s[..]); #assert b.y < 40 && b.x > 874 * 0.5 - 92 && b.x < 874 * 0.5;
}
#test "account: offered, the list has Log in; the card sends the email, takes the code, shows who is logged in, logs out" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; txt: [300] u8;
  sc_pad(s[..], 0, 0); sc_safe(s[..], 0, 59, 34);
  plain := sc_draw(s[..], out[..], 402, 874, 3, 0.016);
  b := ac_open_box(s[..]); sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert !s[0].card[0].open && !sc_login_wants_keys(s[..]);   // not offered: nothing there
  sc_login_offer(s[..]);
  #assert sc_draw(s[..], out[..], 402, 874, 3, 0.016) > plain;
  b = ac_open_box(s[..]); #assert b.x + b.width <= 402 && sc_row_at(s[..], b.x + 4, b.y + 4) == -1;
  sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2);
  #assert s[0].card[0].open && sc_login_wants_keys(s[..]) && sc_scene(s[..]) == SC_LIST;
  n := sc_draw(s[..], out[..], 402, 874, 3, 0.016); #assert n > 0;
  // a press where a row was opens no world while the card is up; 1 to 5 open none either
  r := sc_row(s[..], 1); sc_pointer(s[..], r.x + 9, r.y + 9, 0); sc_pointer(s[..], r.x + 9, r.y + 9, 2);
  #assert sc_scene(s[..]) == SC_LIST && sc_key(s[..], 50, true) && sc_scene(s[..]) == SC_LIST;
  for ch: "me@b.coo" { #assert sc_login_char(s[..], cast(int) ch); }
  #assert sc_login_char(s[..], 8) && sc_login_char(s[..], 13) && sc_login_take(s[..]) == AC_EMAIL;
  #assert cast(string) txt[0..<sc_login_text(s[..], txt[..])] == "me@b.co" && sc_login_take(s[..]) == AC_NONE;
  sc_login_show(s[..], AC_OUT, true, "", "");
  m := ac_box(s[..], AC_B_MAIN); sc_pointer(s[..], m.x + 4, m.y + 4, 0); sc_pointer(s[..], m.x + 4, m.y + 4, 2);
  #assert sc_login_take(s[..]) == AC_NONE;   // busy: the buttons wait
  sc_login_show(s[..], AC_SENT, false, "We sent a 6-digit code to your email. Type it here.", "");
  #assert eb_text(s[0].card[0].box[..]) == "" && sc_draw(s[..], out[..], 402, 874, 3, 0.016) > 0;
  for ch: "123456" { #assert sc_login_char(s[..], cast(int) ch); }
  sc_pointer(s[..], m.x + 4, m.y + 4, 0); sc_pointer(s[..], m.x + 4, m.y + 4, 2);
  #assert sc_login_take(s[..]) == AC_CODE && cast(string) txt[0..<sc_login_text(s[..], txt[..])] == "123456";
  // Use another email: the email comes back to the box
  o := ac_box(s[..], AC_B_OTHER); sc_pointer(s[..], o.x + 4, o.y + 4, 0); sc_pointer(s[..], o.x + 4, o.y + 4, 2);
  #assert sc_login_take(s[..]) == AC_BACK;
  sc_login_show(s[..], AC_OUT, false, "", ""); #assert eb_text(s[0].card[0].box[..]) == "me@b.co";
  sc_pointer(s[..], o.x + 4, o.y + 4, 0); sc_pointer(s[..], o.x + 4, o.y + 4, 2);
  #assert sc_login_take(s[..]) == AC_KEY && !sc_login_wants_keys(s[..]);
  sc_login_show(s[..], AC_IN, false, "", "m**@b.co");
  #assert !sc_login_wants_keys(s[..]) && !sc_login_char(s[..], 65) && sc_draw(s[..], out[..], 402, 874, 3, 0.016) > 0;
  sc_pointer(s[..], m.x + 4, m.y + 4, 0); sc_pointer(s[..], m.x + 4, m.y + 4, 2);
  #assert sc_login_take(s[..]) == AC_LOGOUT;
  c := ac_box(s[..], AC_B_CLOSE); sc_pointer(s[..], c.x + 4, c.y + 4, 0); sc_pointer(s[..], c.x + 4, c.y + 4, 2);
  #assert !s[0].card[0].open && sc_draw(s[..], out[..], 402, 874, 3, 0.016) > 0;
  // Escape closes it too
  sc_pointer(s[..], b.x + 4, b.y + 4, 0); sc_pointer(s[..], b.x + 4, b.y + 4, 2); #assert s[0].card[0].open;
  #assert sc_login_open(s[..]) && sc_key(s[..], 27, true) && !s[0].card[0].open && !sc_login_open(s[..]);
}
#test "crash question: the host asks, the list shows the question in place of its rows, and one press of Send or Don't Send is the answer, once (#13379)" {
  s: [1] Scenes; sc_state_init(s[..]); out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32;
  n0 := sc_draw(s[..], out[..], 402, 874, 3, 0.016);
  #assert sc_crash_take(s[..]) == CA_NONE && !s[0].ask[0].asking && sc_scene(s[..]) == SC_LIST;
  sc_crash_ask(s[..]);
  #assert s[0].ask[0].asking && sc_crash_take(s[..]) == CA_NONE && sc_draw(s[..], out[..], 402, 874, 3, 0.016) > 0 && sc_draw(s[..], out[..], 402, 874, 3, 0.016) != n0;
  // a press where a row was opens no world, and a key opens none: the question takes them
  r := sc_row(s[..], 0); sc_pointer(s[..], r.x + 20, r.y + 10, 0); sc_pointer(s[..], r.x + 20, r.y + 10, 2);
  #assert sc_scene(s[..]) == SC_LIST && s[0].ask[0].asking && sc_key(s[..], 49, true) && sc_key(s[..], 27, true) && sc_scene(s[..]) == SC_LIST && sc_crash_take(s[..]) == CA_NONE;
  // down on Send and up off it is no answer; down and up on it is Send, and the question is gone
  b := ca_box(s[..], CA_B_SEND); d := ca_box(s[..], CA_B_DONT);
  #assert ca_at(s[..], b.x + 5, b.y + 5) == CA_B_SEND && ca_at(s[..], d.x + 5, d.y + 5) == CA_B_DONT && ca_at(s[..], b.x + 5, b.y - 5) == CA_B_NONE && d.y >= b.y + b.height;
  sc_pointer(s[..], b.x + 5, b.y + 5, 0); sc_pointer(s[..], d.x + 5, d.y + 5, 2);
  #assert s[0].ask[0].asking && sc_crash_take(s[..]) == CA_NONE;
  sc_pointer(s[..], b.x + 5, b.y + 5, 0); sc_pointer(s[..], b.x + 5, b.y + 5, 1); #assert s[0].ask[0].asking;
  sc_pointer(s[..], b.x + 5, b.y + 5, 2);
  #assert !s[0].ask[0].asking && sc_crash_take(s[..]) == CA_SEND && sc_crash_take(s[..]) == CA_NONE && sc_draw(s[..], out[..], 402, 874, 3, 0.016) == n0;
  // asked again (another crash, on a host that kept no answer): Don't Send
  sc_crash_ask(s[..]); sc_pointer(s[..], d.x + 5, d.y + 5, 0); sc_pointer(s[..], d.x + 5, d.y + 5, 2);
  #assert !s[0].ask[0].asking && sc_crash_take(s[..]) == CA_DONT && sc_crash_take(s[..]) == CA_NONE;
  // with the question down the list takes presses again, and in a world the question waits unseen
  sc_pointer(s[..], r.x + 20, r.y + 10, 0); sc_pointer(s[..], r.x + 20, r.y + 10, 2); #assert sc_scene(s[..]) != SC_LIST;
  sc_crash_ask(s[..]); #assert !ca_pointer(s[..], s[0].ask[..], b.x + 5, b.y + 5, 0) && s[0].ask[0].asking;
}
