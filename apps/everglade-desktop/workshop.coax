// Everglade for desktop, its first scene (everglade/docs/desktop-app-spec.md section 4.1): the
// Golemancers' Workshop, a round marble temple open to the night. Six pylons stand round the
// middle, where an unfinished golem stands with a sphere in its chest, and the bronze door is in
// the wall at the back. This file is what stops you and how you move; where things are is
// everglade/workshop/layout.coax, which the temple is also built and lit from. You walk it with the controller every web realm uses (metaverse-engine/move/walk.coax: its fixed step, its
// follow camera, its run and jump) and the web's keys: W A S D, Space, Shift to walk, a drag or the
// arrows to look, the wheel to zoom.
// You are the web's player model, which model.coax holds and the host draws: ws_you says where
// you stand and what you are doing, and ws_camera the view. There is no room and no golem to wake yet.
// What this draws is the text over the scene, in Everglade's faces (text.coax).
//   coax/bin/coax test --library apps/everglade-desktop/workshop.coax
#load "../../metaverse-engine/ui/draw.coax";
#load "../../metaverse-engine/core/math.coax";
#load "../../metaverse-engine/move/walk.coax" as pc;
#load "../../everglade/workshop/layout.coax";   // where things are: the same numbers the temple is built and lit from
#load "text.coax";     // Everglade's faces, Spectral and Cinzel

WS_MAX_VERTICES :: 36000;
WS_PYLONS :: WK_PYLONS;
WS_PYLON_RING :: WK_PYLON_RING;     // metres from the dais to each pylon
WS_PYLON_HEIGHT :: WK_PYLON_HEIGHT;
WS_PYLON_BASE :: WK_PYLON_BASE;    // half the width of a pylon's foot
WS_WALL :: WK_WALL;           // metres from the middle to the chamber's wall, which holds the iron door
WS_REACH :: WK_REACH;         // how far from the middle your feet may go: the wall, less your body
WS_NEAR :: 0.2;           // nothing closer than this to the eye is drawn
WS_LOOK :: 0.006;         // radians a point dragged, as metaverse-engine/core/sticks.coax's STICKS_LOOK
WS_WALLS :: 8;            // the six pylons, the golem and the door, each a box you can't walk through

// keys: the web realms' bits: 1 forward, 2 back, 4 left, 8 right, 16 jump, 32 Shift.
Workshop :: struct {
  time: f32; started: bool; you: pc.Player; keys: int; look_x: f32; look_y: f32;
  held: bool; px: f32; py: f32;
  pad_x: f32; pad_y: f32;   // a touch stick: x right, y forward, each -1 to 1
  touch: bool;              // the host has a touch screen, not keys
  safe_left: f32; safe_top: f32; safe_bottom: f32;   // points the screen's edges keep clear (a notch, a home bar)
  turn_can: bool; turn_on: bool;                     // the host can turn the camera as the phone turns, and it is on
  bx: f32; by: f32; bw: f32; bh: f32;                // where the Gyro switch was drawn last, in points
}

// The eye for one frame, its right, up and forward, and the picture it projects onto.
WsView :: struct { ex: f32; ey: f32; ez: f32; rx: f32; rz: f32; ux: f32; uy: f32; uz: f32; fx: f32; fy: f32; fz: f32; cx: f32; cz: f32; focal: f32; d: f32; }
WsPoint :: struct { x: f32; y: f32; z: f32; }
// The view from an eye toward a point. You face +Z with your left along +X (metaverse-engine/anim/figure.coax),
// so right is forward cross up.
ws_view :: (eye: pc.Vec3, at: pc.Vec3, width: f32, height: f32, d: f32) -> WsView {
  v: WsView;
  fx := at.x - eye.x; fy := at.y - eye.y; fz := at.z - eye.z;
  dist := sqrt(fx * fx + fy * fy + fz * fz);
  if !(dist > 0.0001) { fx = 0; fy = 0; fz = 1; dist = 1; }
  fx = fx / dist; fy = fy / dist; fz = fz / dist;
  rx := -fz; rz := fx; flat := sqrt(rx * rx + rz * rz);
  if !(flat > 0.0001) { rx = -1; rz = 0; flat = 1; }
  rx = rx / flat; rz = rz / flat;
  v.ex = eye.x; v.ey = eye.y; v.ez = eye.z; v.fx = fx; v.fy = fy; v.fz = fz; v.rx = rx; v.rz = rz;
  v.ux = -rz * fy; v.uy = rz * fx - rx * fz; v.uz = rx * fy;
  v.cx = width * 0.5 * d; v.cz = height * 0.5 * d; v.d = d;
  // The focal length is the picture's height, so a wide window sees the same height of the world
  // however wide it is; a tall, narrow one (an upright phone) takes it from its width, or it
  // would see only a sliver.
  span := height; if width * 1.2 < span { span = width * 1.2; }
  v.focal = span * d;
  return v;
}

// A world point in the eye's own space: x right, y up, z ahead.
ws_eye :: (v: WsView, p: WsPoint) -> WsPoint {
  x := p.x - v.ex; y := p.y - v.ey; z := p.z - v.ez;
  return WsPoint.{x = x * v.rx + z * v.rz, y = x * v.ux + y * v.uy + z * v.uz, z = x * v.fx + y * v.fy + z * v.fz};
}

// Where pylon `i` stands: the six are a sixth of a turn apart, none on the line from the door
// through the golem.
ws_pylon_at :: (i: int) -> WsPoint {
  a := 1.0471976 * cast(f32) i;
  return WsPoint.{x = math_cos(a) * WS_PYLON_RING, y = 0, z = math_sin(a) * WS_PYLON_RING};
}

// What you can't walk through, as the walker's walls (min x, y, z, max x, y, z each): each pylon's
// foot, the golem and the door, the same boxes the frame draws.
ws_walls :: (out: []f32) -> int {
  if out.count < WS_WALLS * pc.WALL { return 0; }
  for i: 0..<WS_PYLONS {
    p := ws_pylon_at(i); o := i * pc.WALL;
    out[o] = p.x - WS_PYLON_BASE; out[o + 1] = 0; out[o + 2] = p.z - WS_PYLON_BASE;
    out[o + 3] = p.x + WS_PYLON_BASE; out[o + 4] = WS_PYLON_HEIGHT; out[o + 5] = p.z + WS_PYLON_BASE;
  }
  g := WS_PYLONS * pc.WALL;
  out[g] = WK_GOLEM_LEFT; out[g + 1] = 0; out[g + 2] = -WK_GOLEM_DEEP; out[g + 3] = WK_GOLEM_RIGHT; out[g + 4] = WK_GOLEM_HEIGHT; out[g + 5] = WK_GOLEM_DEEP;
  d := g + pc.WALL;
  out[d] = -WK_DOOR_HALF; out[d + 1] = 0; out[d + 2] = -WS_WALL; out[d + 3] = WK_DOOR_HALF; out[d + 4] = WK_DOOR_HEIGHT; out[d + 5] = -WS_WALL + WK_DOOR_DEPTH;
  return WS_WALLS * pc.WALL;
}

// You start in front of the golem, facing it, with the camera behind you.
ws_start :: (s: []Workshop) {
  if s[0].started { return; }
  s[0].you = pc.walk_place(0, 0, 4.2, f32(pc.PI));
  s[0].you.cam.theta = 0; s[0].you.cam.phi = 1.25;
  s[0].started = true;
}

// One frame of the shared controller: this frame's keys and look, its fixed steps among the
// walls, and the chamber's round wall.
ws_walk :: (s: []Workshop, dt: f32) {
  k := s[0].keys;
  key_x := cast(f32) ((ifx (k & 8) != 0 then 1 else 0) - (ifx (k & 4) != 0 then 1 else 0));
  key_y := cast(f32) ((ifx (k & 1) != 0 then 1 else 0) - (ifx (k & 2) != 0 then 1 else 0));
  p := pc.walk_input(s[0].you, key_x, key_y, s[0].pad_x, s[0].pad_y, pc.walk_runs((k & 32) != 0, false, s[0].pad_x, s[0].pad_y), (k & 16) != 0, s[0].look_x, s[0].look_y);
  walls: [WS_WALLS * pc.WALL] f32; count := ws_walls(walls[..]);
  p = pc.walk_advance_on(p, dt, walls[0..<0], walls[0..<count], walls[0..<0]);
  r := sqrt(p.body.pos.x * p.body.pos.x + p.body.pos.z * p.body.pos.z);
  if r > WS_REACH { p = pc.walk_constrain(p, p.body.pos.x * f32(WS_REACH) / r, p.body.pos.z * f32(WS_REACH) / r); }
  s[0].you = p; s[0].look_x = 0; s[0].look_y = 0;
}

ws_frame :: (s: []Workshop, out: []f32, width: f32, height: f32, d: f32, dt: f32) -> int {
  step := dt; if !(step > 0) { step = 0; } if step > 0.1 { step = 0.1; }
  ws_start(s);
  s[0].time += step;
  ws_walk(s, step);
  if !(width > 0) || !(height > 0) || !(d > 0) { return 0; }
  n := 0;
  left := 36 + s[0].safe_left; top := s[0].safe_top; foot := height - 30 - s[0].safe_bottom;
  n = eg_text(out, n, "Everglade", left, top + 66, 40, d, EG_TITLE, EG_WHITE);
  n = eg_text(out, n, "The Golemancers' Workshop", left + 1, top + 94, 18, d, EG_TITLE, EG_MID);
  s[0].bw = 0;
  if s[0].turn_can {
    // The Gyro switch, on the right under the title (which fills an upright phone's width): bright when the phone's turn turns the camera.
    tw := eg_width("Gyro off", 16, EG_TITLE); tx := width - left - tw;
    if s[0].turn_on { n = eg_text(out, n, "Gyro on", tx, top + 130, 16, d, EG_TITLE, EG_WHITE); }
    else { n = eg_text(out, n, "Gyro off", tx, top + 130, 16, d, EG_TITLE, EG_DIM); }
    s[0].bx = tx - 16; s[0].by = top + 130 - 32; s[0].bw = tw + 32; s[0].bh = 48;
  }
  if !s[0].touch {
    n = eg_text(out, n, "W A S D move    Space jump    Shift walk    Drag look    Wheel zoom", left, foot, 15, d, EG_BODY, EG_DIM);
  } else if width - left < 640 {
    // An upright phone: the hint in two lines.
    n = eg_text(out, n, "Drag the left side to move, the right to look", left, foot - 22, 15, d, EG_BODY, EG_DIM);
    n = eg_text(out, n, "Tap to jump    Pinch to zoom", left, foot, 15, d, EG_BODY, EG_DIM);
  } else {
    n = eg_text(out, n, "Drag the left side to move    Drag the right side to look    Tap to jump    Pinch to zoom", left, foot, 15, d, EG_BODY, EG_DIM);
  }
  return n;
}

// Where you stand and what you are doing, for the host's model (model.coax): your feet (x, y,
// z), the way you face, and your act (0 idle, 1 walking, 2 running, 3 in the air).
ws_you :: (s: []Workshop, out: []f32) -> bool #export_c #effects(all) {
  if out.count < 5 || !s[0].started { return false; }
  feet := pc.walk_feet(s[0].you);
  out[0] = feet.x; out[1] = feet.y; out[2] = feet.z; out[3] = pc.walk_face(s[0].you); out[4] = cast(f32) pc.walk_act(s[0].you);
  return true;
}
// The follow camera's eye, kept inside the temple: the balustrade is a line you can't cross, not
// a collider the camera knows, so an eye that would stand outside it is drawn in along its line of
// sight to WS_EYE_REACH from the middle, and never below the floor. The reach is past where you
// can stand (WK_REACH) and inside the balustrade's line (WK_WALL): were it nearer the middle
// than you can be, the point looked at would itself be outside it with your back to the rail, and
// the eye would be drawn all the way in to that point, inside your own head.
WS_EYE_REACH :: 7.05;
ws_eye_inside :: (eye: pc.Vec3, at: pc.Vec3) -> pc.Vec3 {
  e := eye;
  // A point looked at that is itself outside the reach (it can't be while WK_REACH holds you) keeps the eye where it is.
  if at.x * at.x + at.z * at.z < WS_EYE_REACH * WS_EYE_REACH && e.x * e.x + e.z * e.z > WS_EYE_REACH * WS_EYE_REACH {
    // Halve toward the point looked at until the eye is inside; twelve halvings is under a millimetre.
    low: f32 = 0; high: f32 = 1;
    for i: 0..<12 {
      mid := (low + high) * 0.5;
      x := at.x + (eye.x - at.x) * mid; z := at.z + (eye.z - at.z) * mid;
      if x * x + z * z > WS_EYE_REACH * WS_EYE_REACH { high = mid; } else { low = mid; }
    }
    e = pc.Vec3.{x = at.x + (eye.x - at.x) * low, y = at.y + (eye.y - at.y) * low, z = at.z + (eye.z - at.z) * low};
  }
  if e.y < 0.25 { e.y = 0.25; }
  return e;
}
// The view this frame, for the host's model pass: the eye, its right, up and forward, then the
// focal length and the picture's middle in pixels (16 floats).
ws_camera :: (s: []Workshop, width: f32, height: f32, d: f32, out: []f32) -> bool #export_c #effects(all) {
  if out.count < 16 || !s[0].started { return false; }
  v := ws_view(ws_eye_inside(pc.walk_eye(s[0].you), pc.walk_at(s[0].you)), pc.walk_at(s[0].you), width, height, d);
  out[0] = v.ex; out[1] = v.ey; out[2] = v.ez; out[3] = 0;
  out[4] = v.rx; out[5] = 0; out[6] = v.rz; out[7] = 0;
  out[8] = v.ux; out[9] = v.uy; out[10] = v.uz; out[11] = 0;
  out[12] = v.fx; out[13] = v.fy; out[14] = v.fz; out[15] = v.focal;
  return true;
}

// The host's face.
ws_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
ws_max_vertices :: () -> int #export_c #effects(all) { return WS_MAX_VERTICES; }
ws_state_size :: () -> int #export_c #effects(all) { return size_of(Workshop); }
ws_state_init :: (s: []Workshop) #export_c #effects(all) { s[0] = Workshop.{}; }
ws_draw :: (s: []Workshop, out: []f32, width: f32, height: f32, d: f32, dt: f32) -> int #export_c #effects(all) {
  return ws_frame(s, out, width, height, d, dt);
}
// A key held or let go, in the web realms' codes: W A S D, Space (32), Shift (-13), the arrows
// (-4 left, -5 right, -6 up, -7 down) to look, and -1 when the window loses the keys.
ws_key :: (s: []Workshop, key: int, down: bool) -> bool #export_c #effects(all) {
  if key == -1 { s[0].keys = 0; s[0].held = false; s[0].look_x = 0; s[0].look_y = 0; return true; }
  bit := 0;
  if key == 87 || key == 119 { bit = 1; }
  if key == 83 || key == 115 { bit = 2; }
  if key == 65 || key == 97 { bit = 4; }
  if key == 68 || key == 100 { bit = 8; }
  if key == 32 { bit = 16; }
  if key == -13 { bit = 32; }
  if bit != 0 { if down { s[0].keys |= bit; } else { s[0].keys = (s[0].keys | bit) - bit; } return true; }
  if down {
    if key == -4 { s[0].look_x += 0.12; return true; }
    if key == -5 { s[0].look_x -= 0.12; return true; }
    if key == -6 { s[0].look_y += 0.08; return true; }
    if key == -7 { s[0].look_y -= 0.08; return true; }
  }
  return false;
}
// A touch stick, for a host without keys: how far it is pushed right and forward, each -1 to 1
// (0, 0 when let go). The walker's own stick rules apply: a small push is no push, a full one runs.
ws_pad :: (s: []Workshop, x: f32, y: f32) #export_c #effects(all) {
  s[0].touch = true;
  s[0].pad_x = ifx x == x then (ifx x < -1 then -1.0f32 else ifx x > 1 then 1.0f32 else x) else 0.0f32;
  s[0].pad_y = ifx y == y then (ifx y < -1 then -1.0f32 else ifx y > 1 then 1.0f32 else y) else 0.0f32;
}
// The points the screen's edges keep clear, so the text stays out from under a notch or a home bar.
ws_safe :: (s: []Workshop, left: f32, top: f32, bottom: f32) #export_c #effects(all) {
  s[0].safe_left = ifx left > 0 && left < 200 then left else 0.0f32;
  s[0].safe_top = ifx top > 0 && top < 200 then top else 0.0f32;
  s[0].safe_bottom = ifx bottom > 0 && bottom < 200 then bottom else 0.0f32;
}
// The phone's turn as camera look. A host that can read it offers it once; it starts on, and a
// tap on the Gyro switch turns it off and on.
ws_turn_offer :: (s: []Workshop) #export_c #effects(all) { s[0].turn_can = true; s[0].turn_on = true; }
ws_turns :: (s: []Workshop) -> bool #export_c #effects(all) { return s[0].turn_can && s[0].turn_on; }
// How far the phone turned since the last call, in radians, signed as a drag is: yaw to the right
// is negative, pitch up is positive. More than a radian in one call is a fault, not a turn.
ws_turn :: (s: []Workshop, yaw: f32, pitch: f32) #export_c #effects(all) {
  if !s[0].turn_can || !s[0].turn_on { return; }
  if yaw > -1 && yaw < 1 { s[0].look_x += yaw; }
  if pitch > -1 && pitch < 1 { s[0].look_y += pitch; }
}
// A tap at a point: true when it was on the Gyro switch, which it flips, so the host doesn't jump.
ws_tap :: (s: []Workshop, x: f32, y: f32) -> bool #export_c #effects(all) {
  if !s[0].turn_can || !(s[0].bw > 0) { return false; }
  if x < s[0].bx || x > s[0].bx + s[0].bw || y < s[0].by || y > s[0].by + s[0].bh { return false; }
  s[0].turn_on = !s[0].turn_on;
  return true;
}
// A drag looks round: phase 0 down, 1 moved, 2 up. Points, from the top left.
ws_pointer :: (s: []Workshop, x: f32, y: f32, phase: int) #export_c #effects(all) {
  if phase == 0 { s[0].held = true; }
  if phase == 1 && s[0].held { s[0].look_x -= (x - s[0].px) * WS_LOOK; s[0].look_y -= (y - s[0].py) * WS_LOOK; }
  if phase == 2 { s[0].held = false; }
  s[0].px = x; s[0].py = y;
}
// The wheel zooms the follow camera, as on the web.
ws_wheel :: (s: []Workshop, dy: f32) #export_c #effects(all) {
  ws_start(s);
  s[0].you = pc.walk_zoom(s[0].you, dy * 0.01);
}

#test "the workshop has six pylons a sixth of a turn apart, all the same distance from the dais" {
  for i: 0..<WS_PYLONS {
    p := ws_pylon_at(i); r := sqrt(p.x * p.x + p.z * p.z);
    #assert r > WS_PYLON_RING - 0.001 && r < WS_PYLON_RING + 0.001 && p.y == 0;
    q := ws_pylon_at((i + 1) % WS_PYLONS); gap := sqrt((p.x - q.x) * (p.x - q.x) + (p.z - q.z) * (p.z - q.z));
    #assert gap > WS_PYLON_RING - 0.01 && gap < WS_PYLON_RING + 0.01;
  }
}
#test "a frame draws whole glyphs inside its buffer, and a short buffer is never overrun" {
  s: [1] Workshop; out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32;
  n := ws_frame(s[..], out[..], 1280, 800, 2, 0.016);
  #assert n > 60 && n <= WS_MAX_VERTICES && n % 6 == 0;
  small: [125] f32; small[120] = 911;
  m := ws_frame(s[..], small[0..<120], 1280, 800, 2, 0.016);
  #assert m <= 10 && small[120] == 911;
  #assert ws_frame(s[..], out[..], 0, 800, 2, 0.016) == 0;
}
#test "you start in front of the golem facing it, the camera behind you, and you are on screen" {
  s: [1] Workshop; ws_start(s[..]);
  eye := pc.walk_eye(s[0].you); feet := pc.walk_feet(s[0].you);
  #assert feet.z > 3 && eye.z > feet.z + 1 && eye.y > 1;
  v := ws_view(eye, pc.walk_at(s[0].you), 1280, 800, 1);
  head := ws_eye(v, WsPoint.{x = feet.x, y = feet.y + 1.6, z = feet.z});
  golem := ws_eye(v, WsPoint.{x = 0, y = 1.4, z = 0});
  #assert head.z > 1 && golem.z > head.z;
  #assert abs(head.x) < 0.5 && abs(golem.x) < 0.5;
}
#test "W walks you toward the golem and it stops you; D moves you to the right of the screen" {
  s: [1] Workshop; ws_start(s[..]);
  first := ws_view(pc.walk_eye(s[0].you), pc.walk_at(s[0].you), 1280, 800, 1);
  #assert ws_key(s[..], 119, true);
  for i: 0..<20 { ws_walk(s[..], 0.016); }
  #assert s[0].you.body.pos.z < 4.0 && abs(s[0].you.body.pos.x) < 0.01;
  for i: 0..<300 { ws_walk(s[..], 0.016); }
  // The golem's box ends at z = 0.26; your body is 0.3 m round.
  #assert s[0].you.body.pos.z > 0.5 && s[0].you.body.pos.z < 0.7;
  #assert ws_key(s[..], 119, false) && s[0].keys == 0;
  t: [1] Workshop; ws_start(t[..]);
  #assert ws_key(t[..], 100, true);
  for i: 0..<30 { ws_walk(t[..], 0.016); }
  moved := ws_eye(first, WsPoint.{x = t[0].you.body.pos.x, y = 0, z = t[0].you.body.pos.z});
  was := ws_eye(first, WsPoint.{x = 0, y = 0, z = 4.2});
  #assert moved.x > was.x + 0.5;
}
#test "the chamber's wall holds you in, Space jumps, and losing the window lets every key go" {
  s: [1] Workshop; ws_start(s[..]);
  #assert ws_key(s[..], 115, true);
  for i: 0..<600 { ws_walk(s[..], 0.016); }
  r := sqrt(s[0].you.body.pos.x * s[0].you.body.pos.x + s[0].you.body.pos.z * s[0].you.body.pos.z);
  #assert r <= WS_REACH + 0.001 && r > WS_REACH - 0.2;
  #assert ws_key(s[..], -1, true) && s[0].keys == 0;
  for i: 0..<60 { ws_walk(s[..], 0.016); }
  #assert s[0].you.body.on_ground && s[0].you.body.pos.y == 0;
  #assert ws_key(s[..], 32, true);
  peak: f32 = 0;
  for i: 0..<40 { ws_walk(s[..], 0.016); if s[0].you.body.pos.y > peak { peak = s[0].you.body.pos.y; } }
  #assert peak > 0.8 && peak < 1.4;
  #assert !ws_key(s[..], 999, true);
}
#test "a drag turns the camera as on the web" {
  s: [1] Workshop; out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; ws_start(s[..]); theta := s[0].you.cam.theta;
  ws_pointer(s[..], 100, 100, 0); ws_pointer(s[..], 160, 100, 1); ws_pointer(s[..], 160, 100, 2);
  #assert !s[0].held && s[0].look_x < 0;
  n := ws_frame(s[..], out[..], 1280, 800, 2, 0.016);
  #assert s[0].you.cam.theta != theta && s[0].look_x == 0;
}
#test "you walk and look at once: a stick pushed forward and a drag in the same frames both take" {
  s: [1] Workshop; ws_start(s[..]); theta := s[0].you.cam.theta; z := s[0].you.body.pos.z; x := s[0].you.body.pos.x;
  ws_pad(s[..], 0, 1); ws_pointer(s[..], 300, 300, 0);
  px: f32 = 300;
  for i: 0..<30 { px += 4; ws_pointer(s[..], px, 300, 1); ws_walk(s[..], 0.016); }
  moved := (s[0].you.body.pos.z - z) * (s[0].you.body.pos.z - z) + (s[0].you.body.pos.x - x) * (s[0].you.body.pos.x - x);
  #assert s[0].you.cam.theta != theta && moved > 0.25;
}
#test "the Gyro switch: offered it is on and the phone's turn looks; a tap on it turns it off; elsewhere a tap is not its" {
  s: [1] Workshop; out: [WS_MAX_VERTICES * VERTEX_FLOATS] f32; ws_start(s[..]);
  ws_turn(s[..], 0.1, 0.1); #assert s[0].look_x == 0 && !ws_turns(s[..]) && !ws_tap(s[..], 350, 60);
  ws_pad(s[..], 0, 0); ws_turn_offer(s[..]); #assert ws_turns(s[..]);
  n := ws_frame(s[..], out[..], 402, 874, 3, 0.016);
  #assert s[0].bw > 0 && s[0].bx + s[0].bw <= 402 && s[0].bx > 201;
  theta := s[0].you.cam.theta;
  ws_turn(s[..], -0.2, 0); ws_turn(s[..], 5, 0); #assert s[0].look_x < -0.19 && s[0].look_x > -0.21;
  ws_walk(s[..], 0.016); #assert s[0].you.cam.theta != theta;
  #assert !ws_tap(s[..], 40, 400) && ws_turns(s[..]);
  #assert ws_tap(s[..], s[0].bx + 20, s[0].by + 20) && !ws_turns(s[..]);
  ws_turn(s[..], -0.2, 0); #assert s[0].look_x == 0;
  #assert ws_tap(s[..], s[0].bx + 20, s[0].by + 20) && ws_turns(s[..]);
}
#test "the host reads where you stand and the view only once you have started" {
  s: [1] Workshop; you: [5] f32; cam: [16] f32;
  #assert !ws_you(s[..], you[..]) && !ws_camera(s[..], 1280, 800, 2, cam[..]);
  ws_start(s[..]);
  #assert ws_you(s[..], you[..]) && you[0] == 0 && you[1] == 0 && you[2] > 4 && you[4] == 0;
  #assert ws_camera(s[..], 1280, 800, 2, cam[..]) && cam[2] > you[2] && cam[14] < -0.5 && cam[15] > 0;
  #assert !ws_you(s[..], you[0..<4]) && !ws_camera(s[..], 1280, 800, 2, cam[0..<15]);
}
#test "the camera's eye stays inside the balustrade and above the floor" {
  at := pc.Vec3.{x = 0, y = 1.5, z = 6};
  inside := ws_eye_inside(pc.Vec3.{x = 0, y = 2, z = 3}, at); #assert inside.x == 0 && inside.y == 2 && inside.z == 3;
  drawn := ws_eye_inside(pc.Vec3.{x = 0, y = 3.5, z = 10}, at);
  #assert drawn.z <= WS_EYE_REACH + 0.001 && drawn.z > WS_EYE_REACH - 0.01 && drawn.y > 1.5 && drawn.y < 3.5;
  low := ws_eye_inside(pc.Vec3.{x = 1, y = -2, z = 1}, at); #assert low.y == 0.25;
}
#test "backed against the balustrade the eye stays behind you, not inside your head" {
  #assert WS_EYE_REACH > WS_REACH + 0.1 && WS_EYE_REACH < WS_WALL;
  s: [1] Workshop; ws_start(s[..]);
  #assert ws_key(s[..], 115, true);
  for i: 0..<600 { ws_walk(s[..], 0.016); }
  #assert ws_key(s[..], 115, false);
  for i: 0..<120 { ws_walk(s[..], 0.016); }
  at := pc.walk_at(s[0].you); e := ws_eye_inside(pc.walk_eye(s[0].you), at);
  gap := sqrt((e.x - at.x) * (e.x - at.x) + (e.y - at.y) * (e.y - at.y) + (e.z - at.z) * (e.z - at.z));
  #assert gap > 0.15 && e.x * e.x + e.z * e.z <= WS_EYE_REACH * WS_EYE_REACH + 0.01;
  // A point looked at outside the reach leaves the eye where it was.
  far := pc.Vec3.{x = 0, y = 1.5, z = 7.5}; kept := ws_eye_inside(pc.Vec3.{x = 0, y = 3, z = 9}, far);
  #assert kept.z == 9 && kept.y == 3;
}
#test "a touch stick walks you: pushed forward you go toward the golem, let go you stop, and it keeps to its range" {
  s: [1] Workshop; ws_start(s[..]);
  ws_pad(s[..], 0, 5);
  #assert s[0].touch && s[0].pad_y == 1 && s[0].pad_x == 0;
  for i: 0..<40 { ws_walk(s[..], 0.016); }
  #assert s[0].you.body.pos.z < 4.0;
  ws_pad(s[..], 0, 0); z := s[0].you.body.pos.z;
  for i: 0..<60 { ws_walk(s[..], 0.016); }
  after := s[0].you.body.pos.z;
  for i: 0..<30 { ws_walk(s[..], 0.016); }
  #assert s[0].you.body.pos.z == after && after <= z;
  zero: f32 = 0; ws_pad(s[..], zero / zero, -9); #assert s[0].pad_x == 0 && s[0].pad_y == -1;
}
