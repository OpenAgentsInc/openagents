{
  "name": "@openagents/haunt-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:kiln": "node scripts/prepare-kiln.mjs",
    "predev": "npm run prepare:kiln && node scripts/copy-medieval.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run check && npm run prepare:kiln && node scripts/copy-medieval.mjs && vite build",
    "verify:browser": "node scripts/verify-browser.mjs && node scripts/verify-editor.mjs && node scripts/verify-assets.mjs && node scripts/verify-behaviors.mjs && node scripts/verify-layout.mjs && node scripts/verify-town.mjs",
    "prepare:medieval": "python3 scripts/prepare-medieval.py && node scripts/copy-medieval.mjs",
    "verify:town": "node scripts/verify-town.mjs"
  },
  "dependencies": {
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@webgpu/types": "0.1.74",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
