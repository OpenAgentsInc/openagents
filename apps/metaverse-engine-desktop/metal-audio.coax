// Render the product's audio carrier without sound, then exercise the same
// source node on the real muted CoreAudio device through pause/resume.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
ma_run :: (argv:[]string)->bool {out:[1048576]u8;err:[1048576]u8;r:=proc_run(argv,120000,out[..],err[..]);if r.started!=0 || r.status!=0 || r.timed_out || r.cut {tool_errln(cast(string)out[0..<r.out_n]);tool_errln(cast(string)err[0..<r.err_n]);return false;}return true;}
ma_string :: (o:[]Jo,key:string,value:string) {jo_key(o,key);jo_str(o,value);}
ma_op :: (o:[]Jo,name:string) {jo_obj(o);ma_string(o,"op",name);}
ma_command :: (o:[]Jo,line:string) {ma_op(o,"command");ma_string(o,"line",line);jo_end(o);}
ma_render :: (o:[]Jo,path:string,blocks:int) {ma_op(o,"render");ma_string(o,"file",path);jo_key(o,"blocks");jo_int(o,blocks);jo_end(o);}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<3 {tool_errln("usage: metal-audio ROOT RESOURCES NEW_OUTPUT [--prepare-only] [--default --sdk DIR --producer DYLIB]");return 2;}
 root:=args_at(a[..],0);res:=args_at(a[..],1);dir:=args_at(a[..],2);if !fs_mkdir(dir) {return 1;}paths:[12][4096]u8;work:=args_value(a[..],"--sdk",fs_join(root,"apps/metaverse-engine-desktop/build/metal",paths[0][..]));
 argv:[40]string;n:=0;for v:[8]string.["xcrun","swiftc","-O","-parse-as-library","-target","arm64-apple-macos26.0","-import-objc-header",fs_join(root,"apps/metaverse-engine-desktop/metal-host.h",paths[1][..])] {argv[n]=v;n+=1;}
 argv[n]=fs_join(root,"apps/metaverse-engine-desktop/Sources/MetalAudio.swift",paths[2][..]);argv[n+1]=fs_join(root,"apps/metaverse-engine-desktop/tests/MetalAudioEffects.swift",paths[3][..]);n+=2;
 for name,i:[3]string.["MetalRealm.o","MetalRender.o","RenderTexture.o"] {argv[n]=fs_join(work,name,paths[4+i][..]);n+=1;}
 for v:[2]string.["-Xlinker","-export_dynamic"] {argv[n]=v;n+=1;}
 for f:[6]string.["AVFoundation","Foundation","Metal","QuartzCore","ImageIO","CoreGraphics"] {argv[n]="-framework";argv[n+1]=f;n+=2;}
 program:=fs_join(work,"MetalAudioEffects",paths[7][..]);argv[n]="-o";argv[n+1]=program;n+=2;if !args_has(a[..],"--prepared") && !ma_run(argv[0..<n]) {return 1;}if args_has(a[..],"--prepare-only") {return 0;}
 plan:[65536]u8;o:[1]Jo;jo_start(o[..],plan[..]);jo_obj(o[..]);ma_string(o[..],"schema","aethyr.metal.audio-effects.v1");jo_key(o[..],"fixture");jo_bool(o[..],args_has(a[..],"--default"));jo_key(o[..],"operations");jo_arr(o[..]);
 if args_has(a[..],"--default") {
  ma_op(o[..],"register");jo_end(o[..]);
  for line:[5]string.["!room room","!bus 0.75","~ambient-e1 0.125 -0.25","fire-cast-e2 0.5 -0.5 0.02 1800 0.875 0.25 1101","fire-hit-e3 0.375 0.5 0 6000 1.125 0.5 1102"] {ma_command(o[..],line);}
  ma_render(o[..],fs_join(dir,"first.f32",paths[8][..]),4);
  for line:[2]string.["frost-hit-e2 0.3125 0.25 0.04 2500 0.75 0.75 1103","ice-e3 0.25 -0.75 0 800 1.25 0.375 1104"] {ma_command(o[..],line);}
  ma_render(o[..],fs_join(dir,"voices.f32",paths[8][..]),12);
  ma_command(o[..],"~ambient-e1 0.0625 0.5");ma_command(o[..],"splash-e1 0.25 -1 0.125 900 0.75 1 1105");
  ma_render(o[..],fs_join(dir,"bed-update.f32",paths[8][..]),16);
  for line:[6]string.["-1101","-1102","-1103","-1104","-1105","~ambient-e1 0 0"] {ma_command(o[..],line);}
  ma_render(o[..],fs_join(dir,"stop-tail.f32",paths[8][..]),96);
  ma_op(o[..],"export");ma_string(o[..],"directory",fs_join(dir,"inputs",paths[8][..]));jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);
  input:=fs_join(dir,"plan.json",paths[10][..]);report:=fs_join(dir,"audio.json",paths[11][..]);if o[0].bad||!fs_write(input,jo_text(o[..])){return 1;}
  producer:[4096]u8;run:=[5]string.[program,res,args_value(a[..],"--producer",fs_join(res,"metal/libeverglade.dylib",producer[..])),input,report];if !ma_run(run[..]){return 1;}
  print("Actual default audio cue/bed/room fixture retained at %\n",report);return 0;
 }
 ma_op(o[..],"frame");jo_end(o[..]);ma_op(o[..],"bank");jo_end(o[..]);ma_op(o[..],"drain");jo_end(o[..]);
 ma_command(o[..],"!room room");ma_command(o[..],"~ambient 0 0");ma_command(o[..],"fire-hit 0.125 -1 0.02 1000 0.75 0.25 901");
 first:=fs_join(dir,"voice.f32",paths[8][..]);tail:=fs_join(dir,"tail.f32",paths[9][..]);ma_render(o[..],first,3);ma_command(o[..],"-901");ma_render(o[..],tail,88);
 ma_op(o[..],"probe");jo_key(o[..],"slot");jo_int(o[..],1);jo_key(o[..],"right");jo_int(o[..],5);jo_key(o[..],"ahead");jo_int(o[..],0);jo_end(o[..]);ma_op(o[..],"frame");jo_key(o[..],"count");jo_int(o[..],12);jo_key(o[..],"capture");jo_bool(o[..],true);jo_end(o[..]);ma_op(o[..],"device");jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);
 input:=fs_join(dir,"plan.json",paths[10][..]);report:=fs_join(dir,"audio.json",paths[11][..]);if o[0].bad || !fs_write(input,jo_text(o[..])) {return 1;}
 producer:[4096]u8;run:=[5]string.[program,res,fs_join(res,"metal/libeverglade.dylib",producer[..]),input,report];if !ma_run(run[..]) {return 1;}
 text:[262144]u8;nn:=fs_read(report,text[..]);nodes:[8192]JvNode;doc:[1]Jv;if nn<1 || !jv_parse(doc[..],cast(string)text[0..<nn],nodes[..]) {return 1;}d:=doc[0];events:=jv_get(d,0,"events");last:=jv_at(d,events,12);print("Audio effect receipts retained at%\n",report);
 // Read the real rendered samples independently of the CoreAudio glue.
 data:[1048576]u8;peak:=0.0;energy:=0.0;nonfinite:=0;
 for path:[2]string.[first,tail] {count:=fs_read(path,data[..]);if count<1 || count%8!=0 {return 1;}for i:0..<count/4 {at:=4*i;bits:=u32(data[at])|(u32(data[at+1])<<8)|(u32(data[at+2])<<16)|(u32(data[at+3])<<24);if (bits&0x7f800000)==0x7f800000 {nonfinite+=1;continue;}x:=f64(f32_from_bits(bits));if abs(x)>peak {peak=abs(x);}energy+=x*x;}}
 observed:=jv_get(d,0,"observed");if nonfinite!=0 || peak<=0.00001 || peak>1 || energy<=0 || jv_int(d,jv_get(d,observed,"roomPartitions"),-1)!=66 {tool_errln("Authored native PCM/room render failed");return 1;}
 device:=-1;for i:0..<jv_len(d,events) {e:=jv_at(d,events,i);if jv_raw_eq(jv_raw(d,jv_get(d,e,"op")),"device") {device=e;}}
 if device<0 || !jv_bool(d,jv_get(d,device,"started")) || !jv_bool(d,jv_get(d,device,"muted")) {return 1;}
 running:=jv_get(d,device,"running");paused:=jv_get(d,device,"paused");held:=jv_get(d,device,"held");resumed:=jv_get(d,device,"resumed");
 if jv_int(d,jv_get(d,running,"callbacks"),0)<1 || jv_int(d,jv_get(d,paused,"callbacks"),-1)!=jv_int(d,jv_get(d,held,"callbacks"),-2) || jv_int(d,jv_get(d,resumed,"callbacks"),0)<=jv_int(d,jv_get(d,held,"callbacks"),0) {tool_errln("CoreAudio callback/pause/resume observation failed");return 1;}
 print("Native Coax audio finite, peak%, energy%; authored66-part room and actual muted CoreAudio pause/resume passed\n",peak,energy);return 0;
}
