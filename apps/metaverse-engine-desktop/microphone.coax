// Platform permission and live capture are separate decisions. A system sheet
// taking key focus does not revoke an existing macOS microphone grant.
#authority;

#test "only the current local main frame may receive microphone permission" {
  for trusted:0..<2 {for audio:0..<2 {for authorized:0..<2 {
    #assert fm_permission(trusted==1,audio==1,authorized==1)==(trusted==1 && audio==1 && authorized==1);
  }}}
}
#test "capture needs the ready visible foreground app, independent of key window" {
  for ready:0..<2 {for visible:0..<2 {for active:0..<2 {
    #assert fm_capture(ready==1,visible==1,active==1)==(ready==1 && visible==1 && active==1);
  }}}
}
fm_permission :: (trusted:bool,audio:bool,authorized:bool)->bool #export_c #effects(all) {
  return trusted && audio && authorized;
}

#test "setup preflights unknown microphone permission only in a visible foreground setup session" {
  for bits:0..<64 {for status:-1..<5 {
    visible:=bits%2==1;active:=bits/2%2==1;shown:=bits/4%2==1;completed:=bits/8%2==1;pending:=bits/16%2==1;interactive:=bits/32%2==1;
    #assert fm_setup_request(visible,active,shown,completed,status,pending,interactive)==(visible && active && (shown || completed) && status==0 && !pending && interactive);
  }}
}
// AVAuthorizationStatus: 0 not determined, 1 restricted, 2 denied, 3 authorized.
// Existing saved setup is eligible without displaying the setup pane again.
fm_setup_request :: (visible:bool,active:bool,shown:bool,completed:bool,status:int,pending:bool,interactive:bool)->bool #export_c #effects(all) {
  return visible && active && (shown || completed) && status==0 && !pending && interactive;
}
fm_capture :: (ready:bool,visible:bool,active:bool)->bool #export_c #effects(all) {
  return ready && visible && active;
}
