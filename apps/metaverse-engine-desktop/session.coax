// The desktop's local entry point. The Swift host supplies OS-assigned ports;
// Everglade, its editor, world rules and saves stay in the existing Coax stack.
#import "Basic";
#load "setup.coax";
#load "startup.coax";
#load "world-visibility.coax";
#load "chrome.coax";
#load "world-host.coax";
#load "world-preview.coax";
#load "native-entry.coax";

#test "desktop opens the local 5e Everglade in play at the South Gate" {
  b: [256] u8;
  #assert editor_page_url(49152, 49153, b[..]) == "http://127.0.0.1:49152/worlds/everglade?forge=play&room=pair-aethyrforge&relay=ws://localhost:49153#gate";
  #assert editor_url_byte(49152, 49153, 0) == 'h';
  #assert editor_url_byte(49152, 49153, 128) == -1;
}
#test "desktop refuses missing, overlapping and reserved ports, without a partial URL" {
  b: [256] u8;
  #assert editor_page_url(0, 49153, b[..]) == "" && editor_page_url(49152, 65536, b[..]) == "";
  #assert editor_page_url(49152, 49152, b[..]) == "" && editor_page_url(8830, 49153, b[..]) == "";
  #assert editor_page_url(49152, 8872, b[..]) == "" && editor_page_url(-1, 49153, b[..]) == "";
  #assert editor_page_url(80, 49153, b[..]) == "";
  small: [8] u8;
  #assert editor_page_url(49152, 49153, small[..]) == "";
  #assert small[0] == 0 && editor_url_byte(49152, 49153, -1) == -1;
}
#test "offline launch selects the same one-seat profile without a network relay override" {
  b:[256]u8;
  #assert editor_offline_url(49152,b[..])=="http://127.0.0.1:49152/worlds/everglade?forge=play&offline=worker#gate";
  #assert editor_offline_url(8830,b[..])=="" && editor_offline_url(65536,b[..])=="";
  small:[32]u8;#assert editor_offline_url(49152,small[..])=="";
}
#test "benchmark scene names the same South Gate front fixture" {
  b:[256]u8;#assert editor_benchmark_url(49152,b[..])=="http://127.0.0.1:49152/worlds/everglade?forge=play&offline=worker&stage=benchmark-south-gate&quality=high&clock=0.4&style=painterly#gate";
  small:[128]u8;#assert editor_benchmark_url(49152,small[..])=="";
}

editor_port :: (p: int) -> bool { return p >= 1024 && p <= 65535 && p != 8830 && p != 8872; }
editor_page_url :: (page: int, room: int, out: [] u8) -> string {
  if !editor_port(page) || !editor_port(room) || page == room || out.count < 128 { return ""; }
  n := 0;
  // pair-* takes the default character. The client's explicit local relay
  // contract accepts ws://localhost:PORT; 127.0.0.1 is not a relay override and
  // would send the WebSocket through the blocking HTTP-only page proxy.
  for s: [5] string.["http://127.0.0.1:", "", "/worlds/everglade?forge=play&room=pair-aethyrforge&relay=ws://localhost:", "", "#gate"] {
    if s.count > 0 { for c: s { out[n] = c; n += 1; } }
    else {
      v := ifx n < 32 then page else room; digits: [5] u8; k := 0;
      while v > 0 { digits[k] = cast(u8) ('0' + v % 10); v /= 10; k += 1; }
      for i: 0..<k { out[n] = digits[k - i - 1]; n += 1; }
    }
  }
  return cast(string) out[0..<n];
}
// Scalar bridge: no borrowed Coax storage crosses the Swift ABI.
editor_url_byte :: (page: int, room: int, index: int) -> int #export_c #effects(all) {
  b: [256] u8; url := editor_page_url(page, room, b[..]);
  return ifx index >= 0 && index < url.count then cast(int) url[index] else -1;
}
editor_offline_url :: (page:int,out:[]u8)->string {
  if !editor_port(page) || out.count<128 {return "";}
  n:=0;for c:"http://127.0.0.1:" {out[n]=c;n+=1;}
  v:=page;digits:[5]u8;k:=0;while v>0 {digits[k]=cast(u8)('0'+v%10);v/=10;k+=1;}
  for i:0..<k {out[n]=digits[k-i-1];n+=1;}
  for c:"/worlds/everglade?forge=play&offline=worker#gate" {out[n]=c;n+=1;}
  return cast(string)out[0..<n];
}
editor_offline_url_byte :: (page:int,index:int)->int #export_c #effects(all) {b:[256]u8;url:=editor_offline_url(page,b[..]);return ifx index>=0 && index<url.count then cast(int)url[index] else -1;}
editor_benchmark_url :: (page:int,out:[]u8)->string {
  if out.count<192 {return "";}
  base:=editor_offline_url(page,out);if base.count==0 {return "";}n:=base.count-5;
  for c:"&stage=benchmark-south-gate&quality=high&clock=0.4&style=painterly#gate" {out[n]=c;n+=1;}return cast(string)out[0..<n];
}
editor_benchmark_url_byte :: (page:int,index:int)->int #export_c #effects(all) {b:[256]u8;url:=editor_benchmark_url(page,b[..]);return ifx index>=0 && index<url.count then cast(int)url[index] else -1;}
#load "frame-pacing.coax";
#load "voice-ready.coax";
