ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

# Preserve the immutable release assets baked into the currently deployed
# image (the Pylon binaries in `pylon-dist/`) while advancing only the
# update-service code. This is the safe path when no fresh Pylon release has
# been staged in `pylon-dist/`.
COPY dist-server ./dist-server

EXPOSE 8080

CMD ["node", "dist-server/serve.mjs"]
