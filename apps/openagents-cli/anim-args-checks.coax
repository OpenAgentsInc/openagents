#test "animation CLI parses retarget paths literally and consumes each flag value once" {
 a:[1]Args;for token:[10]string.["--json","labs","anim","retarget","clip.json","--to","mannequin","--source-rig","rig.json","--help"] {#assert args_add(a[..],token);}
 r:=an_parse(a[..]);#assert r.err=="" && r.json && r.help && r.clip=="clip.json" && r.target=="mannequin" && r.source=="rig.json";
 a[0]=Args.{};for token:[6]string.["labs","anim","retarget","clip.json","--to","--json"] {#assert args_add(a[..],token);}r=an_parse(a[..]);#assert r.err=="" && !r.json && r.target=="--json";
}
#test "animation CLI refuses missing repeated unknown and extra operands" {
 a:[1]Args;for token:[6]string.["labs","anim","retarget","clip.json","--to","mannequin"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err=="";
 #assert args_add(a[..],"extra");#assert an_parse(a[..]).err!="";a[0].n=6;
 #assert args_add(a[..],"--to") && args_add(a[..],"other");#assert an_parse(a[..]).err!="";a[0].n=6;
 #assert args_add(a[..],"--unknown");#assert an_parse(a[..]).err!="";a[0].n=5;#assert an_parse(a[..]).err!="";a[0].n=4;#assert an_parse(a[..]).err!="";
 a[0]=Args.{};#assert args_add(a[..],"labs") && args_add(a[..],"anim");#assert an_parse(a[..]).err=="" && an_parse(a[..]).help;
}
an_test_error :: (tokens:[]string,expected:string) {
 a:[1]Args;for token:tokens {#assert args_add(a[..],token);}#assert an_parse(a[..]).err==expected;
}
#test "animation CLI reports each refusal without treating literal path bytes as flags" {
 tokens_0:=[6]string.["other","anim","retarget","clip","--to","rig"];an_test_error(tokens_0[..],"expected labs");
 tokens_1:=[6]string.["labs","other","retarget","clip","--to","rig"];an_test_error(tokens_1[..],"expected labs anim");
 tokens_2:=[6]string.["labs","anim","other","clip","--to","rig"];an_test_error(tokens_2[..],"unknown animation verb");
 tokens_3:=[1]string.["labs"];an_test_error(tokens_3[..],"expected labs anim");
 tokens_4:=[5]string.["labs","anim","retarget","clip","--to"];an_test_error(tokens_4[..],"animation flag needs a value");
 tokens_5:=[8]string.["labs","anim","retarget","clip","--to","rig","--out",""];an_test_error(tokens_5[..],"invalid animation flag value");
 tokens_6:=[6]string.["labs","anim","retarget","--to","rig","--"];an_test_error(tokens_6[..],"unknown animation flag");
 #assert an_flag("--unknown")== -1;
 for path:[3]string.["-","-x","a-clip"] {a:[1]Args;for token:[6]string.["labs","anim","retarget",path,"--to","rig"] {#assert args_add(a[..],token);}r:=an_parse(a[..]);#assert r.err=="" && r.clip==path && !r.help && !r.json;}
 a:[1]Args;#assert an_parse(a[..]).err=="expected labs anim";a[0].full=true;#assert an_parse(a[..]).err=="argument capacity";#assert an_parse(a[0..<0]).err=="missing arguments";
}
#test "animation CLI retains every option independently and accepts help before a clip" {
 a:[1]Args;for token:[14]string.["labs","anim","retarget","clip","--profile","owner","--to","rig","--out","output","--source-rig","source","--json","--help"] {#assert args_add(a[..],token);}r:=an_parse(a[..]);#assert r.err=="" && r.profile=="owner" && r.target=="rig" && r.out=="output" && r.source=="source" && r.json && r.help;
 a[0]=Args.{};for token:[7]string.["labs","anim","retarget","clip","--to","rig","--help"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).help && !an_parse(a[..]).json;
 a[0]=Args.{};for token:[6]string.["labs","anim","retarget","clip","--to","rig"] {#assert args_add(a[..],token);}#assert !an_parse(a[..]).help && !an_parse(a[..]).json;
 #assert args_add(a[..],"--json");#assert an_parse(a[..]).json && !an_parse(a[..]).help;
}

#test "animation import grammar requires a rig and preserves literal source output and rate" {
 a:[1]Args;for token:[10]string.["labs","anim","import","made.gltf","--rig","made","--out","private-dir","--rate","60"] {#assert args_add(a[..],token);}r:=an_parse(a[..]);#assert r.err=="" && r.verb=="import" && r.rig=="made" && r.rate==60 && r.out=="private-dir" && r.clip=="made.gltf";
 a[0].n=4;#assert an_parse(a[..]).err!="";a[0].n=10;#assert args_add(a[..],"--rig") && args_add(a[..],"other");#assert an_parse(a[..]).err=="repeated animation flag";
}

#test "animation sample rates and verb-specific options have independent errors" {
 a:[1]Args;for token:[8]string.["labs","anim","import","source.csv","--rig","face","--rate","30"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).rate==30;
 a[0].n=7;#assert args_add(a[..],"31");#assert an_parse(a[..]).err=="animation rate must be 30 or 60";
 a[0]=Args.{};for token:[8]string.["labs","anim","retarget","source","--to","target","--rate","30"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err=="import options require labs anim import";
 a[0]=Args.{};for token:[8]string.["labs","anim","retarget","source","--to","target","--rig","other"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err=="import options require labs anim import";
}

#test "animation film commands accept literal operands and refuse unrelated mode flags" {
 a:[1]Args;for token:[5]string.["labs","anim","play","scene.json","out.mp4"] {#assert args_add(a[..],token);}r:=an_parse(a[..]);#assert r.err=="" && r.verb=="play" && r.clip=="scene.json" && r.out=="out.mp4";#assert args_add(a[..],"extra") && an_parse(a[..]).err!="";
 a[0]=Args.{};for token:[4]string.["labs","anim","check","scene.json"] {#assert args_add(a[..],token);}r=an_parse(a[..]);#assert r.err=="" && r.verb=="check" && r.out=="";#assert args_add(a[..],"out.json") && an_parse(a[..]).err!="";
 for flag:[4]string.["--rig","--rate","--to","--source-rig"] {a[0]=Args.{};for token:[6]string.["labs","anim","check","scene.json",flag,"30"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err!="";}
 a[0]=Args.{};for token:[4]string.["labs","anim","play","scene.json"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err!="";
}

#test "animation directing grammar preserves words and supports undo diff and a literal API origin" {
 a:[1]Args;for token:[7]string.["labs","anim","edit","scene.json","slow down -- literally","--origin","http://127.0.0.1:1234"] {#assert args_add(a[..],token);}r:=an_parse(a[..]);#assert r.err=="" && r.verb=="edit" && r.words=="slow down -- literally" && r.origin=="http://127.0.0.1:1234";
 for verb:[2]string.["undo","diff"] {a[0]=Args.{};for token:[4]string.["labs","anim",verb,"scene.json"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err=="" && an_parse(a[..]).verb==verb;#assert args_add(a[..],"unexpected");#assert an_parse(a[..]).err!="";}
 a[0]=Args.{};for token:[4]string.["labs","anim","edit","scene.json"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err!="";
}

#test "directing grammar admits exact word capacities and rejects origin on other verbs" {
 words:[2049]u8;for k:0..<words.count {words[k]='w';}a:[1]Args;
 for size:[3]int.[1,2048,2049] {a[0]=Args.{};for token:[5]string.["labs","anim","edit","scene.alp",cast(string)words[0..<size]] {#assert args_add(a[..],token);}#assert (an_parse(a[..]).err=="")== (size<=2048);}
 a[0]=Args.{};for token:[6]string.["labs","anim","check","scene.alp","--origin","http://localhost"] {#assert args_add(a[..],token);}#assert an_parse(a[..]).err=="--origin requires labs anim edit";
}
