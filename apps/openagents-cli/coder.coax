// The coder domain: Coder, OpenAgents' coding agent (coder/book/), run from
// this checkout. openagents coder replaces itself with coder/tui/coder.sh,
// which builds coder/tui/coder.coax when it is stale, so the terminal UI gets
// the terminal and the verbs print straight to stdout:
//   openagents coder                       the terminal UI
//   openagents coder run "TASK" [--json]   one task; exits 0 finished, 1 failed, 130 stopped
//   openagents coder ls | status ID | log ID | stop ID [--json]
//   openagents coder fork ID "TASK" [--at TURN] | route "TASK" | run "TASK" --detach
//   openagents coder attach ID ["MESSAGE"] | replay ID | bench [SUITE]
//   openagents coder trigger "TEXT" | router | watch THREAD | policy list|add|rm
// Sessions are in ~/.openagents/coder/sessions, one JSON-lines file each.
#load "../../coax/lib/agent/observe/processes-host.coax";

cxproc_exec :: (h: int) -> int #foreign #effects(all);

coder_usage :: () {
  print("%\n", "Coder (OpenAgents' coding agent, in this terminal):");
  print("%\n", "  coder                              the terminal UI; Shift-Tab switches agent");
  print("%\n", "  coder run \"TASK\" [--engine micro|claude|codex|psionic|echo|auto] [--effort low|medium|high] [--cwd DIR] [--json]");
  print("%\n", "                                     [--allow EFFECT] [--ceiling EFFECT] [--root DIR,DIR]: approvals by policy (read, network, write, run)");
  print("%\n", "                                     [--deadline SECONDS] [--report-to ID]: a job that expires, and reports back to session ID");
  print("%\n", "                                     one task, its steps as text or JSON lines");
  print("%\n", "                                     no --engine: System One picks it (coder route \"TASK\" shows the pick)");
  print("%\n", "  coder run \"TASK\" --detach          a background job: prints its ID and returns");
  print("%\n", "  coder fork ID \"TASK\" [--at TURN]   a new session carrying ID's turns");
  print("%\n", "  coder stop ID                      stop a running session");
  print("%\n", "  coder attach ID [\"MESSAGE\"]        follow a session; a message becomes the job's next turn");
  print("%\n", "  coder replay ID                    rebuild every request from the log and compare bytes");
  print("%\n", "  coder trigger \"TEXT\" [--thread T] [--to-agent] | router [--once]   the Router (book chapters 17, 20)");
  print("%\n", "  coder watch THREAD | policy list|add|rm   what the Router acts on");
  print("%\n", "  coder bench [SUITE]                run a suite (harness, checks, smoke) and report it");
  print("%\n", "  coder mcp                          Coder's verbs as MCP tools on stdio, for Claude Code or another agent");
  print("%\n", "  coder acp [--engine E]             Coder as an agent for editors, such as Zed (Agent Client Protocol on stdio)");
  print("%\n", "  coder ls                           sessions, newest first");
  print("%\n", "  coder agents [--json]              running local agent processes; read-only discovery");
  print("%\n", "  coder models --json                live Codex model/list pages, without starting a conversation");
  print("%\n", "  coder status ID                    one session's state (ID may be a prefix)");
  print("%\n", "  coder log ID                       one session's log");
  print("%\n", "");
}

// The checkout with coder/tui/coder.sh: OPENAGENTS_SOURCE, else the one this
// binary was built in (apps/openagents-cli/build/openagents).
coder_root :: (out: [] u8) -> string {
  env: [1024] u8; p: [1024] u8;
  s := proc_getenv("OPENAGENTS_SOURCE", env[..]);
  if s.count == 0 {
    n := cxcli_exe_path(p[..]);
    if n <= 0 { return ""; }
    s = cast(string) p[0..<n];
    for up: 0..<4 { s = fs_dir(s); }
  }
  q: [1024] u8;
  if fs_kind(fs_join(s, "coder/tui/coder.sh", q[..])) != FS_FILE { return ""; }
  n := copy(s, out);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

coder_main :: (a: [] Args, r: [] Rep) -> int {
  if positional(a, 1) == "agents" { return la_command(r[0].json); }
  // Packaged native clients use the same prebuilt Coder, without rebuilding a
  // checkout at every message. Source invocation keeps its existing behavior.
  image: [4096] u8;
  binary := proc_getenv("OPENAGENTS_CODER_BIN", image[..]);
  exe: [4096] u8;
  if binary.count == 0 {
    en := cxcli_exe_path(exe[..]);
    if en > 0 {
      sibling := fs_join(fs_dir(cast(string)exe[0..<en]), "coder", image[..]);
      if fs_kind(sibling) == FS_FILE { binary = sibling; }
    }
  }
  src: [1024] u8;
  sb: [1100] u8;
  script := binary;
  if binary.count == 0 {
    root := coder_root(src[..]);
    if root.count == 0 { return fail(r, EXIT_NOT_FOUND, "no OpenAgents checkout with coder/tui/coder.sh: set OPENAGENTS_SOURCE"); }
    script = fs_join(root, "coder/tui/coder.sh", sb[..]);
  }
  h := proc_new();
  ok := proc_arg(h, script);
  worker_buf: [4096] u8; env_buf: [4200] u8;
  if binary.count > 0 {
    worker := fs_join(fs_dir(binary), "mcworker", worker_buf[..]);
    if fs_kind(worker) == FS_FILE {
      n := 0; for c: "CODER_MICRO_WORKER=" { env_buf[n]=c;n+=1; }
      for c: worker { env_buf[n]=c;n+=1; }
      ok = ok && proc_env(h, cast(string)env_buf[0..<n]);
    }
  }
  // Everything after the domain, without the CLI's own --profile.
  past := false; i := 0;
  while i < args_count(a) {
    s := args_at(a, i);
    i += 1;
    if !past { if s == "coder" { past = true; } continue; }
    if s == "--profile" { i += 1; continue; }
    ok = ok && proc_arg(h, s);
  }
  if !ok { return fail(r, EXIT_USAGE, "arguments too long"); }
  e := cxproc_exec(h);
  return fail(r, EXIT_MISSING, "could not run Coder");
}
