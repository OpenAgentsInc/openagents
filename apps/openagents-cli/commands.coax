}

CliCommand :: struct { domain: string = "realm"; verb: string; method: string; route: string; arguments: string; optional: int; flags: string; usage: string; help: string; }
// The seat rows (route "seat") drive one realm open in headless Chrome on this computer, as a
// visitor (apps/openagents-cli/realm-play.coax, docs/verse/realm-seat.md).
REALM_COMMANDS :: [37] CliCommand.[
  CliCommand.{verb="list",method="GET",route="/mine",help="your realms"},
  CliCommand.{verb="show",method="GET",route="",arguments="slug",usage="SLUG",help="the realm's spec and page"},
  CliCommand.{verb="new",method="POST",route="/plan",arguments="newwords",flags="--from:id|--style:style|--time:time|--camera:camera|--ground:ground",usage="\"WORDS\" [--style S] [--time T] [--camera C] [--ground G] | --from PLAN",help="plan words and make a private realm; --from PLAN makes an existing plan"},
  CliCommand.{verb="visibility",method="POST",route="/visibility",arguments="slug|visibility",flags="--rev:id",usage="SLUG private|unlisted|public [--rev N]",help="who sees it"},
  CliCommand.{verb="publish",method="POST",route="/publish",arguments="slug",flags="--rev:id|--listed:bool|--yes:bool",usage="SLUG [--rev N] [--listed] [--yes]",help="publish the named revision"},
  CliCommand.{verb="fork",method="POST",route="/fork",arguments="slug",flags="--name:who",usage="SLUG [--name NAME]",help="a private copy that you own"},
  CliCommand.{verb="shot",method="LOCAL",route="shot",arguments="slug|shotfile",optional=1,flags="--size:size|--phone:bool|--square:bool|--vertical:bool|--wait:waitms|--eval:script|--dark:bool|--fresh:bool|--as-me:bool",usage="SLUG [OUT.png] [--size WxH|--phone|--square|--vertical] [--wait MS] [--eval JS] [--dark] [--fresh] [--as-me]",help="a visitor's PNG in muted headless Chrome, once its scene is drawn; OUT defaults to SLUG.png"},
  CliCommand.{verb="doc",method="GET",route="/doc",arguments="slug",usage="SLUG",help="the versioned document and SHA-256"},
  CliCommand.{verb="asks",method="GET",route="/asks",arguments="slug",usage="SLUG",help="the feature asks"},
  CliCommand.{verb="proposals",method="GET",route="/proposals",arguments="slug",usage="SLUG",help="visitors' proposals"},
  CliCommand.{verb="panes",method="GET",route="/panes",arguments="slug",usage="SLUG",help="lore and quests"},
  CliCommand.{verb="switch",method="POST",route="/switch",arguments="slug|row|onoff",flags="--rev:id",usage="SLUG ROW on|off [--rev N]",help="turn a row on or off"},
  CliCommand.{verb="revise",method="POST",route="/revise",arguments="slug|words",flags="--rev:id",usage="SLUG \"WORDS\" [--rev N]",help="ask the planner to revise the board"},
  CliCommand.{verb="ask",method="POST",route="/asks",arguments="slug|words",flags="--rev:id|--doc:file",usage="SLUG \"WORDS\" | SLUG --doc FILE [--rev N]",help="add words, or a design document, to the feature list"},
  CliCommand.{verb="ask-delete",method="POST",route="/asks/:id/delete",arguments="slug|id",flags="--rev:id",usage="SLUG ID [--rev N]",help="delete an ask"},
  CliCommand.{verb="ask-done",method="POST",route="/asks/:id/done",arguments="slug|id",flags="--rev:id|--commit:commit",usage="SLUG ID --commit HASH [--rev N]",help="an admin marks pushed code done"},
  CliCommand.{verb="row-delete",method="POST",route="/rows/:row/delete",arguments="slug|row",flags="--rev:id",usage="SLUG ROW [--rev N]",help="delete a board row"},
  CliCommand.{verb="move",method="POST",route="/save",arguments="slug|entity|metres|metres",flags="--rev:id",usage="SLUG ENTITY X Z [--rev N]",help="move a thing (FEATURE:N, such as trees:3) to X Z metres; one save"},
  CliCommand.{verb="rotate",method="POST",route="/save",arguments="slug|entity|yaw",flags="--rev:id",usage="SLUG ENTITY DEGREES [--rev N]",help="turn a thing DEGREES from its laid-out way (0 puts it back); one save"},
  CliCommand.{verb="resize",method="POST",route="/save",arguments="slug|entity|percent",flags="--rev:id",usage="SLUG ENTITY PERCENT [--rev N]",help="size a thing to PERCENT (25 to 400) of its laid-out size; one save"},
  CliCommand.{verb="remove",method="POST",route="/save",arguments="slug|entity",flags="--rev:id",usage="SLUG ENTITY [--rev N]",help="take a thing away (undo brings it back); one save"},
  CliCommand.{verb="place",method="POST",route="/place",arguments="slug|row|metres|metres",flags="--rev:id|--yaw:yaw",usage="SLUG THING X Z [--yaw DEG] [--rev N]",help="place a thing at X Z metres"},
  CliCommand.{verb="settings",method="POST",route="/settings",arguments="slug",flags="--rev:id|--tools:tools",usage="SLUG --tools build,fly,jump,map,talk,voice [--rev N]",help="the tools visitors get"},
  CliCommand.{verb="lore",method="POST",route="/lore",arguments="slug|who|lore",flags="--rev:id",usage="SLUG WHO \"TEXT\" [--rev N]",help="set WHO's lore; \"\" forgets it"},
  CliCommand.{verb="quest",method="POST",route="/quest",arguments="slug|who",flags="--rev:id|--ask:ask|--step:step|--reward:step",usage="SLUG GIVER --ask \"TEXT\" [--step \"TEXT\"]... [--reward \"TEXT\"] [--rev N]",help="set a giver's quest, up to three steps"},
  CliCommand.{verb="accept",method="POST",route="/proposals/:id/accept",arguments="slug|id",flags="--rev:id",usage="SLUG ID [--rev N]",help="accept a visitor's proposal"},
  CliCommand.{verb="decline",method="POST",route="/proposals/:id/decline",arguments="slug|id",flags="--rev:id",usage="SLUG ID [--rev N]",help="decline a visitor's proposal"},
  CliCommand.{verb="undo",method="POST",route="/undo",arguments="slug",flags="--rev:id",usage="SLUG [--rev N]",help="take back the newest step (its own edits only) as a new revision"},
  CliCommand.{verb="redo",method="POST",route="/redo",arguments="slug",flags="--rev:id",usage="SLUG [--rev N]",help="apply the step last undone again, as a new revision"},
  CliCommand.{verb="apply",method="LOCAL",route="batch",arguments="slug|file",flags="--rev:id",usage="SLUG FILE.jsonl [--rev N]",help="run JSON-line edits in order (below); consecutive moves share one save"},
  CliCommand.{verb="play",method="LOCAL",route="seat",arguments="slug",flags="--phone:bool|--hosted:bool",usage="SLUG [--phone] [--hosted]",help="sit in the realm as your account (headless Chrome here, or the server's with --hosted) and say what you see; others see an agent; the seat stays open for look, go, say, use and bye, and closes after 10 idle minutes"},
  CliCommand.{verb="look",method="LOCAL",route="seat",arguments="slug",flags="--turn:turn|--pitch:pitch|--shot:shotfile",usage="SLUG [--turn DEG] [--pitch DEG] [--shot OUT.png]",help="turn right (negative: left) up to 180 degrees; --pitch looks up or down in first person; --shot keeps a picture of the view"},
  CliCommand.{verb="go",method="LOCAL",route="seat",arguments="slug|target",flags="--x:metres|--z:metres|--max:seconds",usage="SLUG TARGET | SLUG --x X --z Z [--max S]",help="walk to a character's name, a kind (house, centre, ...), character:N, entity:N, or X Z metres, until 2 m away, blocked, or --max seconds (10; at most 30)"},
  CliCommand.{verb="say",method="LOCAL",route="seat",arguments="slug|line",usage="SLUG \"WORDS\"",help="talk to the character within 3.5 m and wait for the answer"},
  CliCommand.{verb="use",method="LOCAL",route="seat",arguments="slug|tool|thing",optional=1,usage="SLUG jump|map|build [THING]",help="use a tool the realm has on; build THING (crate, barrel, tree, rock, plant, lantern, fence, chest) asks the owner to place it in front of you"},
  CliCommand.{verb="bye",method="LOCAL",route="seat",arguments="slug",usage="SLUG",help="end the talk"},
  CliCommand.{verb="leave",method="LOCAL",route="seat",arguments="slug",usage="SLUG",help="close the seat and its browser"}
];

rc_find :: (verb: string) -> int { for i: 0..<REALM_COMMANDS.count { if REALM_COMMANDS[i].verb == verb { return i; } } return -1; }
CliBound :: struct { min: int; max: int; }
rc_bound :: (kind: string) -> CliBound {
  if kind == "slug" { return CliBound.{min=1,max=48}; }
  if kind == "row" { return CliBound.{min=1,max=63}; }
  if kind == "entity" { return CliBound.{min=3,max=24}; }
  if kind == "metres" { return CliBound.{min=-40,max=40}; }
  if kind == "yaw" { return CliBound.{min=-360,max=360}; }
  if kind == "percent" { return CliBound.{min=25,max=400}; }
  if kind == "id" { return CliBound.{min=1,max=999999999}; }
  if kind == "words" { return CliBound.{min=1,max=600}; }
  if kind == "newwords" { return CliBound.{min=1,max=2000}; }
  if kind == "lore" { return CliBound.{min=0,max=400}; }
  if kind == "who" { return CliBound.{min=1,max=40}; }
  if kind == "file" { return CliBound.{min=1,max=1024}; }
  if kind == "ask" { return CliBound.{min=0,max=160}; }
  if kind == "step" { return CliBound.{min=0,max=100}; }
  if kind == "commit" { return CliBound.{min=7,max=64}; }
  if kind == "tools" { return CliBound.{min=3,max=29}; }
  if kind == "onoff" { return CliBound.{min=2,max=3}; }
  if kind == "visibility" { return CliBound.{min=6,max=8}; }
  if kind == "bool" { return CliBound.{min=0,max=1}; }
  if kind == "shotfile" { return CliBound.{min=0,max=1024}; }
  if kind == "size" { return CliBound.{min=0,max=19}; }
  if kind == "waitms" { return CliBound.{min=0,max=120000}; }
  if kind == "script" { return CliBound.{min=0,max=131072}; }
  if kind == "style" { return CliBound.{min=4,max=9}; }
  if kind == "time" { return CliBound.{min=3,max=5}; }
  if kind == "camera" { return CliBound.{min=3,max=5}; }
  if kind == "ground" { return CliBound.{min=4,max=6}; }
  if kind == "turn" { return CliBound.{min=-180,max=180}; }
  if kind == "pitch" { return CliBound.{min=-60,max=60}; }
  if kind == "target" { return CliBound.{min=1,max=40}; }
  if kind == "seconds" { return CliBound.{min=1,max=30}; }
  if kind == "line" { return CliBound.{min=1,max=400}; }
  if kind == "tool" { return CliBound.{min=3,max=5}; }
  if kind == "thing" { return CliBound.{min=4,max=7}; }
  return CliBound.{};
}
rc_value :: (kind: string, value: string) -> bool {
  if kind == "slug" { return cli_slug_ok(value); }
  if kind == "row" { return cli_edit_row_ok(value); }
  if kind == "entity" {
    feature := 0;
    for c: value { if c == ':' { break; } feature += 1; }
    return forge_key_ok(value) && feature <= 20;
  }
  if kind == "metres" { return cli_edit_cm(value) != 4001; }
  if kind == "id" { return cli_count(value,1,999999999) >= 1; }
  if kind == "percent" { return cli_count(value,25,400) >= 25; }
  if kind == "onoff" { return cli_onoff(value) >= 0; }
  if kind == "visibility" { return cli_visibility_ok(value); }
  if kind == "commit" { return cli_edit_commit_ok(value); }
  if kind == "tools" { return cli_edit_tools(value); }
  if kind == "yaw" {
    if value.count == 0 { return false; }
    s := ifx value[0] == '-' then value[1..<value.count] else value;
    return cli_count(s,0,360) >= 0;
  }
  if kind == "size" {
    if value == "" { return true; }
    size := args_size(value);
    return size.ok && size.w >= 16 && size.h >= 16 && size.w <= 7680 && size.h <= 7680;
  }
  if kind == "waitms" { n := args_whole(value); return n >= 0 && n <= 120000; }
  if kind == "style" || kind == "time" || kind == "camera" || kind == "ground" { return cli_setup_ok(kind, value); }
  if kind == "turn" || kind == "pitch" { return rc_degrees_ok(value, rc_bound(kind).max); }
  if kind == "seconds" { return cli_count(value,1,30) >= 1; }
  if kind == "tool" { return value == "jump" || value == "map" || value == "build"; }
  if kind == "thing" { for t: CLI_SEAT_THINGS { if t == value { return true; } } return false; }
  if kind == "target" { for c: value { if c < 32 || c == 127 { return false; } } }
  b := rc_bound(kind);
  return b.max > 0 && value.count >= b.min && value.count <= b.max;
}

// What a visitor's build pane offers (myrealm.coax THING_NAMES; realm-play.coax checks they agree).
CLI_SEAT_THINGS :: [8] string.["crate", "barrel", "tree", "rock", "plant", "lantern", "fence", "chest"];
// Degrees: an optional minus, up to three digits, at most two decimals, within max either way.
rc_degrees_ok :: (value: string, max: int) -> bool {
  if value.count == 0 { return false; }
  neg := value[0] == '-'; i := ifx neg then 1 else 0;
  whole := 0; digits := 0;
  while i < value.count && value[i] >= '0' && value[i] <= '9' { whole = whole * 10 + cast(int) (value[i] - '0'); i += 1; digits += 1; }
  if digits == 0 || digits > 3 { return false; }
  frac := 0; places := 0;
  if i < value.count && value[i] == '.' {
    i += 1;
    while i < value.count && value[i] >= '0' && value[i] <= '9' { frac = frac * 10 + cast(int) (value[i] - '0'); i += 1; places += 1; }
    if places == 0 || places > 2 { return false; }
  }
  if i != value.count { return false; }
  return whole < max || (whole == max && frac == 0);
}
#test "seat inputs: degrees, targets, seconds, tools and things" {
  #assert rc_value("turn","90") && rc_value("turn","-180") && rc_value("turn","45.5") && rc_value("turn","-0.25") && rc_value("turn","180.0");
  #assert !rc_value("turn","181") && !rc_value("turn","180.5") && !rc_value("turn","") && !rc_value("turn","-") && !rc_value("turn","1e2") && !rc_value("turn","9.") && !rc_value("turn","1.234") && !rc_value("turn","+5");
  #assert rc_value("pitch","-60") && !rc_value("pitch","61") && !rc_value("pitch","60.01");
  #assert rc_value("seconds","1") && rc_value("seconds","30") && !rc_value("seconds","0") && !rc_value("seconds","31") && !rc_value("seconds","2.5");
  #assert rc_value("tool","jump") && rc_value("tool","map") && rc_value("tool","build") && !rc_value("tool","fly") && !rc_value("tool","Jump");
  #assert rc_value("thing","barrel") && rc_value("thing","lantern") && !rc_value("thing","boat") && !rc_value("thing","");
  #assert rc_value("target","Old Mott") && rc_value("target","character:0") && !rc_value("target","") && !rc_value("target","a\nb");
  long: [401] u8; for i: 0..<long.count { long[i] = 'a'; }
  #assert rc_value("line",cast(string) long[0..<400]) && !rc_value("line",cast(string) long[..]) && !rc_value("target",cast(string) long[0..<41]);
  a: [1] Args;
  for w: [4] string.["realm","go","village-green","Maple"] { #assert args_add(a[..],w); }
  #assert rc_validate(a[..],"go") == "";
  #assert args_add(a[..],"--max") && args_add(a[..],"20") && rc_validate(a[..],"go") == "";
  b: [1] Args;
  for w: [7] string.["realm","go","village-green","--x","4.5","--z","-2"] { #assert args_add(b[..],w); }
  #assert rc_validate(b[..],"go") == "";
  #assert args_add(b[..],"Maple") && rc_validate(b[..],"go") == "go takes TARGET or --x X --z Z, not both";
  c: [1] Args;
  for w: [5] string.["realm","go","village-green","--x","4.5"] { #assert args_add(c[..],w); }
  #assert rc_validate(c[..],"go") == "go takes TARGET or --x X --z Z, not both";
  d: [1] Args;
  for w: [4] string.["realm","use","village-green","build"] { #assert args_add(d[..],w); }
  #assert rc_validate(d[..],"use") == "use build takes a THING: crate, barrel, tree, rock, plant, lantern, fence or chest";
  #assert args_add(d[..],"barrel") && rc_validate(d[..],"use") == "";
  e: [1] Args;
  for w: [5] string.["realm","use","village-green","jump","barrel"] { #assert args_add(e[..],w); }
  #assert rc_validate(e[..],"use") == "only build takes a THING";
  e[0].n = 4; #assert rc_validate(e[..],"use") == "";
  f: [1] Args;
  for w: [6] string.["realm","look","village-green","--turn","90","--phone"] { #assert args_add(f[..],w); }
  #assert rc_validate(f[..],"look") != "";
  f[0].n = 5; #assert rc_validate(f[..],"look") == "";
}
rc_flag_kind :: (c: CliCommand, flag: string) -> string {
  if flag == "--json" { return "bool"; }
  if flag == "--profile" { return "who"; }
  if flag == "--origin" { return "file"; }
  i := 0;
  while cli_field(c.flags,i) != "" {
    f := cli_field(c.flags,i);
    n := flag.count;
    if f.count > n && f[0..<n] == flag && f[n] == ':' { return f[n+1..<f.count]; }
    i += 1;
  }
  return "";
}

rc_is_flag :: (s: string) -> bool { return s.count >= 2 && s[0..<2] == "--"; }

// Flag-shaped literal values belong to the flag that consumed them. Every
// reader uses this token walk, rather than searching arbitrary argv words.
rc_option_index :: (a: [] Args, verb: string, name: string, occurrence: int) -> int {
  ci := rc_find(verb); if ci < 0 { return -1; }
  c := REALM_COMMANDS[ci]; found := 0; skip := false;
  for i: 0..<args_count(a) {
    if skip { skip = false; continue; }
    s := args_at(a,i);
    if rc_is_flag(s) {
      kind := rc_flag_kind(c,s);
      if s == name { if found == occurrence { return i; } found += 1; }
      skip = kind != "" && kind != "bool";
    }
  }
  return -1;
}
rc_has :: (a: [] Args, verb: string, name: string) -> bool { return rc_option_index(a,verb,name,0) >= 0; }
rc_option :: (a: [] Args, verb: string, name: string, fallback: string) -> string {
  i := rc_option_index(a,verb,name,0);
  if i < 0 || i + 1 >= args_count(a) { return fallback; }
  if rc_flag_kind(REALM_COMMANDS[rc_find(verb)],name) == "bool" { return fallback; }
  return args_at(a,i+1);
}
rc_option_at :: (a: [] Args, verb: string, name: string, occurrence: int) -> string {
  i := rc_option_index(a,verb,name,occurrence);
  if i < 0 { return ""; }
  return args_at(a,i+1);
}
rc_pos :: (a: [] Args, verb: string, index: int) -> string {
  ci := rc_find(verb); if ci < 0 { return ""; }
  c := REALM_COMMANDS[ci]; seen := 0; skip := false;
  for i: 0..<args_count(a) {
    if skip { skip = false; continue; }
    s := args_at(a,i);
    if rc_is_flag(s) {
      kind := rc_flag_kind(c,s);
      skip = kind != "" && kind != "bool";
      continue;
    }
    if seen == index { return s; }
    seen += 1;
  }
  return "";
}

// Returns a usage error, or empty. Global flags are admitted alongside the row's
// flags. Repetition is only meaningful for a quest's three ordered steps.
rc_validate :: (a: [] Args, verb: string) -> string {
  ci := rc_find(verb); if ci < 0 { return "unknown realm command"; }
  if a[0].full { return "arguments were truncated"; }
  c := REALM_COMMANDS[ci];
  p: [8] string; pn := 0; steps := 0; i := 0;
  while i < args_count(a) {
    s := args_at(a,i);
    if rc_is_flag(s) {
      kind := rc_flag_kind(c,s);
      if kind == "" { return "that flag is not one this realm command takes (openagents help)"; }
      if s == "--step" { steps += 1; if steps > 3 { return "a quest has at most three steps"; } }
      else { if rc_option_index(a,verb,s,0) != i { return "a flag was supplied twice"; } }
      if kind != "bool" {
        if i+1 >= args_count(a) || !rc_value(kind,args_at(a,i+1)) { return rc_why(kind); }
        i += 1;
      }
    } else { if pn >= p.count { return "too many realm arguments"; } p[pn] = s; pn += 1; }
    i += 1;
  }
  expected := 2;
  fields := 0;
  while cli_field(c.arguments,fields) != "" { expected += 1; fields += 1; }
  if (verb == "ask" && rc_has(a,verb,"--doc")) || (verb == "new" && rc_has(a,verb,"--from")) { expected -= 1; }
  if verb == "go" && (rc_has(a,verb,"--x") || rc_has(a,verb,"--z")) {
    if !(rc_has(a,verb,"--x") && rc_has(a,verb,"--z")) || pn != expected - 1 { return "go takes TARGET or --x X --z Z, not both"; }
    expected -= 1;
  }
  if pn < expected - c.optional || pn > expected { return "wrong number of realm arguments (openagents help)"; }
  if p[0] != "realm" || p[1] != verb { return "realm command does not match its catalogue row"; }
  for j: 2..<pn {
    kind := cli_field(c.arguments,j-2);
    if !rc_value(kind,p[j]) { return rc_why(kind); }
  }
  if verb == "new" && rc_has(a,verb,"--from") {
    for f: [4] string.["--style","--time","--camera","--ground"] { if rc_has(a,verb,f) { return "--style, --time, --camera and --ground go with WORDS: a plan made earlier keeps its setup"; } }
  }
  if verb == "ask-done" && !rc_has(a,verb,"--commit") { return "ask-done needs --commit HASH"; }
  if verb == "use" && pn == expected - 1 && p[3] == "build" { return "use build takes a THING: crate, barrel, tree, rock, plant, lantern, fence or chest"; }
  if verb == "use" && pn == expected && p[3] != "build" { return "only build takes a THING"; }
  if verb == "settings" && !rc_has(a,verb,"--tools") { return "settings needs --tools build,talk,..."; }
  if verb == "quest" && !rc_has(a,verb,"--ask") { return "quest needs --ask TEXT (empty removes it)"; }
  if verb == "shot" {
    sizes := 0;
    if rc_option(a,verb,"--size","") != "" { sizes += 1; }
    for preset: [3] string.["--phone","--square","--vertical"] { if rc_has(a,verb,preset) { sizes += 1; } }
    if sizes > 1 { return "shot takes at most one of --size, --phone, --square or --vertical"; }
  }
  return "";
}

// What a bad argument or flag value should be, naming it and its bounds.
#test "a bad argument or flag value is named with its bounds" {
  kinds := [33] string.["slug","row","entity","metres","yaw","id","words","newwords","lore","who","file","ask","step","commit","tools","onoff","visibility","bool","shotfile","size","waitms","script","style","time","camera","ground","turn","pitch","target","seconds","line","tool","thing"];
  names := [33] string.["SLUG ","ROW ","ENTITY ","X and Z ","--yaw ","ID, ","WORDS ","WORDS ","TEXT ","WHO ","FILE ","--ask ","--step ","--commit ","--tools ","the last word ","the visibility ","that flag ","OUT.png ","--size ","--wait ","--eval ","--style ","--time ","--camera ","--ground ","--turn ","--pitch ","TARGET ","--max ","WORDS ","the tool ","THING "];
  for i: 0..<kinds.count {
    w := rc_why(kinds[i]);
    #assert cli_prefix(w, names[i]);
    for j: 0..<i { #assert w != rc_why(kinds[j]); }
  }
  #assert rc_why("entity") == "ENTITY is one thing of a board row as FEATURE:N, such as enclosure:0 or trees:3 (FEATURE at most 20 characters; realm show SLUG lists the rows)";
  #assert rc_why("metres") == "X and Z are metres from -40 to 40 with at most two decimals, such as 4.5 or -2";
  #assert rc_why("") == "an argument is outside its bounds (openagents help)" && rc_why("unknown") == rc_why("");
  a: [1] Args;
  for w: [6] string.["realm","move","walled-garden","enclosure","1","1"] { #assert args_add(a[..],w); }
  #assert rc_validate(a[..],"move") == rc_why("entity");
  a[0].v[3] = "enclosure:0"; a[0].v[4] = "41"; #assert rc_validate(a[..],"move") == rc_why("metres");
  a[0].v[4] = "1"; #assert rc_validate(a[..],"move") == "";
  #assert args_add(a[..],"--rev") && rc_validate(a[..],"move") == rc_why("id");
  #assert args_add(a[..],"x") && rc_validate(a[..],"move") == rc_why("id");
  b: [1] Args;
  for w: [4] string.["realm","undo","garden","--nope"] { #assert args_add(b[..],w); }
  #assert rc_validate(b[..],"undo") == "that flag is not one this realm command takes (openagents help)";
}
rc_why :: (kind: string) -> string {
  if kind == "slug" { return "SLUG is 1 to 48 of a-z, 0-9 and -"; }
  if kind == "row" { return "ROW (or THING) is 1 to 63 of a-z, 0-9, : and -"; }
  if kind == "entity" { return "ENTITY is one thing of a board row as FEATURE:N, such as enclosure:0 or trees:3 (FEATURE at most 20 characters; realm show SLUG lists the rows)"; }
  if kind == "metres" { return "X and Z are metres from -40 to 40 with at most two decimals, such as 4.5 or -2"; }
  if kind == "yaw" { return "--yaw and DEGREES are whole degrees from -360 to 360"; }
  if kind == "percent" { return "PERCENT is a whole number from 25 to 400"; }
  if kind == "id" { return "ID, --rev N and --from PLAN are whole numbers from 1 to 999999999"; }
  if kind == "words" { return "WORDS are 1 to 600 bytes"; }
  if kind == "newwords" { return "WORDS are 1 to 2000 bytes"; }
  if kind == "lore" { return "TEXT is at most 400 bytes (\"\" forgets the lore)"; }
  if kind == "who" { return "WHO (a name, --name or --profile) is 1 to 40 bytes"; }
  if kind == "file" { return "FILE (or --origin) is 1 to 1024 bytes"; }
  if kind == "ask" { return "--ask TEXT is at most 160 bytes"; }
  if kind == "step" { return "--step and --reward TEXT are at most 100 bytes"; }
  if kind == "commit" { return "--commit HASH is 7 to 64 lowercase hex digits"; }
  if kind == "tools" { return "--tools is a comma-separated list of build, fly, jump, map, talk and voice, each at most once"; }
  if kind == "onoff" { return "the last word is on or off"; }
  if kind == "visibility" { return "the visibility is private, unlisted or public"; }
  if kind == "bool" { return "that flag takes no value"; }
  if kind == "shotfile" { return "OUT.png is a path of at most 1024 bytes"; }
  if kind == "size" { return "--size is WxH, each from 16 to 7680"; }
  if kind == "waitms" { return "--wait is milliseconds from 0 to 120000"; }
  if kind == "script" { return "--eval JS is at most 128 KiB"; }
  if kind == "style" { return "--style is lowpoly, painterly or flat"; }
  if kind == "time" { return "--time is day, dawn, dusk or night"; }
  if kind == "camera" { return "--camera is third, first, top or side"; }
  if kind == "ground" { return "--ground is meadow, forest, desert, snow, stone or beach"; }
  if kind == "turn" { return "--turn is degrees from -180 to 180, such as 90 or -45.5"; }
  if kind == "pitch" { return "--pitch is degrees from -60 to 60 (up is positive)"; }
  if kind == "target" { return "TARGET is 1 to 40 bytes: a character's name, a kind such as house, character:N or entity:N"; }
  if kind == "seconds" { return "--max is whole seconds from 1 to 30"; }
  if kind == "line" { return "WORDS to a character are 1 to 400 bytes"; }
  if kind == "tool" { return "the tool is jump, map or build"; }
  if kind == "thing" { return "THING is crate, barrel, tree, rock, plant, lantern, fence or chest"; }
  return "an argument is outside its bounds (openagents help)";
}

// A made realm's setup, as the server's builder holds it (verse.builder_setup,
// migrations 0048, 0049 and 0062): the words each field takes. Anything else
// the server drops silently, so the CLI refuses it first. Palette is the
// model's pick and anime is not a realm style yet.
#test "setup words are the server's" {
  #assert cli_setup_ok("style","lowpoly") && cli_setup_ok("style","painterly") && cli_setup_ok("style","flat");
  #assert !cli_setup_ok("style","anime") && !cli_setup_ok("style","Flat") && !cli_setup_ok("style","");
  #assert cli_setup_ok("time","day") && cli_setup_ok("time","dawn") && cli_setup_ok("time","dusk") && cli_setup_ok("time","night") && !cli_setup_ok("time","noon");
  #assert cli_setup_ok("camera","third") && cli_setup_ok("camera","first") && cli_setup_ok("camera","top") && cli_setup_ok("camera","side") && !cli_setup_ok("camera","2d");
  for g: [6] string.["meadow","forest","desert","snow","stone","beach"] { #assert cli_setup_ok("ground",g) && !cli_setup_ok("style",g); }
  #assert !cli_setup_ok("ground","grass") && !cli_setup_ok("palette","pastel") && !cli_setup_ok("","day") && !cli_setup_ok("time","lowpoly");
  a: [1] Args;
  for w: [9] string.["realm","new","a koi pond","--style","flat","--time","dusk","--camera","top"] { #assert args_add(a[..],w); }
  #assert rc_validate(a[..],"new") == "";
  #assert args_add(a[..],"--ground") && args_add(a[..],"beach") && rc_validate(a[..],"new") == "";
  #assert rc_option(a[..],"new","--style","") == "flat" && rc_option(a[..],"new","--ground","") == "beach";
  a[0].v[4] = "anime"; #assert rc_validate(a[..],"new") == rc_why("style");
  b: [1] Args;
  for w: [6] string.["realm","new","--from","7","--time","night"] { #assert args_add(b[..],w); }
  #assert rc_validate(b[..],"new") == "--style, --time, --camera and --ground go with WORDS: a plan made earlier keeps its setup";
  for f: [3] string.["--style","--camera","--ground"] {
    c: [1] Args;
    for w: [4] string.["realm","new","--from","7"] { #assert args_add(c[..],w); }
    #assert rc_validate(c[..],"new") == "" && args_add(c[..],f) && args_add(c[..],ifx f == "--style" then "flat" else ifx f == "--camera" then "top" else "snow");
    #assert rc_validate(c[..],"new") != "";
  }
}
cli_setup_ok :: (field: string, v: string) -> bool {
  words := ifx field == "style" then "lowpoly|painterly|flat" else ifx field == "time" then "day|dawn|dusk|night"
           else ifx field == "camera" then "third|first|top|side" else ifx field == "ground" then "meadow|forest|desert|snow|stone|beach" else "";
  i := 0;
  while cli_field(words,i) != "" { if cli_field(words,i) == v { return true; } i += 1; }
  return false;
}

// One help line: "  realm VERB USAGE", its help from column 42 (or two spaces after a longer one).
#test "help lines read like the other domains' and show no catalogue syntax" {
  out: [512] u8;
  #assert rc_help_line(REALM_COMMANDS[rc_find("move")],out[..]) == "  realm move SLUG ENTITY X Z [--rev N]    move a thing (FEATURE:N, such as trees:3) to X Z metres; one save";
  #assert rc_help_line(REALM_COMMANDS[rc_find("list")],out[..]) == "  realm list                              your realms";
  #assert rc_help_line(REALM_COMMANDS[rc_find("new")],out[..]) == "  realm new \"WORDS\" [--style S] [--time T] [--camera C] [--ground G] | --from PLAN  plan words and make a private realm; --from PLAN makes an existing plan";
  #assert rc_help_line(REALM_COMMANDS[rc_find("move")],out[0..<20]) == "";
  long := CliCommand.{verb="a-verb-long-enough-to-pass-the-column-x",usage="X",help="h"};
  #assert rc_help_line(long,out[..]) == "  realm a-verb-long-enough-to-pass-the-column-x X  h";
  long.usage = ""; #assert rc_help_line(long,out[..]) == "  realm a-verb-long-enough-to-pass-the-column-x  h";
  long.verb = "a-verb-exactly-to-the-column-xxx"; #assert rc_help_line(long,out[..]) == "  realm a-verb-exactly-to-the-column-xxx  h";
  long.verb = "a-verb-exactly-to-the-column-xx"; #assert rc_help_line(long,out[..]) == "  realm a-verb-exactly-to-the-column-xx   h";
  #assert rc_contains("ab","ab") && rc_contains("ab","a") && rc_contains("ab","b") && rc_contains("ab","") && !rc_contains("a","ab") && !rc_contains("ab","ba");
  #assert rc_word("ab cd",0) == "ab" && rc_word("ab cd",1) == "cd" && rc_word("a  b",1) == "b" && rc_word(" a",0) == "a" && rc_word("a",1) == "" && rc_word("",0) == "";
  for c: REALM_COMMANDS {
    line := rc_help_line(c,out[..]);
    #assert line.count > 0;
    #assert rc_contains(line,c.usage) && rc_contains(line,c.help);
    for bad: [8] string.[":id",":bool",":file","slug","metres","newwords","|row","shotfile"] { #assert !rc_contains(c.usage,bad); }
    // every flag the row takes is shown by name, and the required arguments come first
    fi := 0;
    while cli_field(c.flags,fi) != "" {
      f := cli_field(c.flags,fi); colon := 0;
      for j: 0..<f.count { if f[j] == ':' { colon = j; } }
      #assert rc_contains(c.usage,f[0..<colon]);
      fi += 1;
    }
    args := 0; while cli_field(c.arguments,args) != "" { args += 1; }
    for k: 0..<args - c.optional {
      t := rc_word(c.usage,k);
      #assert t.count > 0 && t[0] != '-' && t[0] != '[';
    }
  }
}
rc_contains :: (s: string, part: string) -> bool {
  if part.count > s.count { return false; }
  for i: 0..<s.count - part.count + 1 { if s[i..<i + part.count] == part { return true; } }
  return false;
}
// The k-th space-separated word of s, or "".
rc_word :: (s: string, k: int) -> string {
  at := 0; seen := 0;
  for i: 0..<s.count + 1 {
    if i == s.count || s[i] == ' ' {
      if i > at { if seen == k { return s[at..<i]; } seen += 1; }
      at = i + 1;
    }
  }
  return "";
}
rc_help_line :: (c: CliCommand, out: [] u8) -> string {
  n := forge_put(out,0,"  realm "); n = forge_put(out,n,c.verb);
  if c.usage.count > 0 { n = forge_put(out,n," "); n = forge_put(out,n,c.usage); }
  w := n;
  while w < 40 { n = forge_put(out,n," "); w += 1; }
  n = forge_put(out,n,"  "); n = forge_put(out,n,c.help);
  return ifx n == -1 then "" else cast(string) out[0..<n];
}

// A bounded JSON-line edit becomes the same copied Args the command table
// validates for a person. No effects, implicit revisions or semantic routing.

#test "batch edits map every supported operation to the exact command arguments" {
  lines := [16] string.[
    "{\"op\":\"move\",\"entity\":\"trees:3\",\"x\":4.5,\"z\":-2}",
    "{\"op\":\"switch\",\"row\":\"trees\",\"on\":true}",
    "{\"op\":\"place\",\"thing\":\"barrel\",\"x\":2,\"z\":3,\"yaw\":90}",
    "{\"op\":\"revise\",\"prompt\":\"add a pond\"}",
    "{\"op\":\"ask\",\"words\":\"more trees\"}",
    "{\"op\":\"ask-delete\",\"id\":7}",
    "{\"op\":\"ask-done\",\"id\":8,\"commit\":\"abcdef0\"}",
    "{\"op\":\"row-delete\",\"row\":\"trees\"}",
    "{\"op\":\"settings\",\"tools\":\"build,talk\"}",
    "{\"op\":\"lore\",\"who\":\"Bram\",\"text\":\"\"}",
    "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"find it\",\"steps\":[\"first\",\"--reward\",\"third\"],\"reward\":\"a hat\"}",
    "{\"op\":\"accept\",\"id\":9}",
    "{\"op\":\"decline\",\"id\":10}",
    "{\"op\":\"undo\"}",
    "{\"op\":\"publish\",\"listed\":true}",
    "{\"op\":\"visibility\",\"visibility\":\"unlisted\"}"
  ];
  want := [16] string.[
    "realm|move|garden|trees:3|4.5|-2", "realm|switch|garden|trees|on", "realm|place|garden|barrel|2|3|--yaw|90",
    "realm|revise|garden|add a pond", "realm|ask|garden|more trees", "realm|ask-delete|garden|7", "realm|ask-done|garden|8|--commit|abcdef0",
    "realm|row-delete|garden|trees", "realm|settings|garden|--tools|build,talk", "realm|lore|garden|Bram|",
    "realm|quest|garden|Bram|--ask|find it|--step|first|--step|--reward|--step|third|--reward|a hat",
    "realm|accept|garden|9", "realm|decline|garden|10", "realm|undo|garden", "realm|publish|garden|--listed", "realm|visibility|garden|unlisted"
  ];
  counts := [16] int.[6,5,8,4,4,4,6,4,5,5,14,4,4,3,4,4];
  a: [1] Args;
  for i: 0..<lines.count {
    #assert rb_args(lines[i], "garden", a[..]) && a[0].n == counts[i] && !a[0].full;
    for j: 0..<counts[i] { #assert args_at(a[..], j) == cli_field(want[i], j); }
  }
}
#test "batch optional fields preserve false zero empty strings and decoded copies" {
  a: [1] Args;
  #assert rb_args("{\"op\":\"switch\",\"row\":\"trees\",\"on\":false}", "garden", a[..]) && args_at(a[..],4) == "off";
  #assert rb_args("{\"op\":\"place\",\"thing\":\"barrel\",\"x\":0,\"z\":0}", "garden", a[..]) && a[0].n == 6;
  #assert rb_args("{\"op\":\"publish\",\"listed\":false}", "garden", a[..]) && a[0].n == 3;
  #assert rb_args("{\"op\":\"publish\"}", "garden", a[..]) && a[0].n == 3;
  #assert rb_args("{\"op\":\"ask\",\"doc\":\"scene.md\"}", "garden", a[..]) && a[0].n == 5 && args_at(a[..],3) == "--doc" && args_at(a[..],4) == "scene.md";
  #assert rb_args("{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"\",\"steps\":[]}", "garden", a[..]) && a[0].n == 6 && args_at(a[..],5) == "";
  #assert rb_args("{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\",\"steps\":[\"\"]}", "garden", a[..]) && a[0].n == 8 && args_at(a[..],7) == "";
  bytes: [256] u8;
  text := "{\"o\\u0070\":\"lore\",\"who\":\"Kai\\u0020Lin\",\"text\":\"line\\nnext\"}";
  for i: 0..<text.count { bytes[i] = text[i]; }
  #assert rb_args(cast(string)bytes[0..<text.count], "garden", a[..]);
  for i: 0..<text.count { bytes[i] = 'x'; }
  #assert args_at(a[..],3) == "Kai Lin" && args_at(a[..],4) == "line\nnext";
}
#test "batch rejects unsupported keys duplicate decoded keys revisions and read commands" {
  bad := [24] string.[
    "", "{}", "[]", "true", "{", "{\"op\":1}", "{\"op\":\"unknown\"}",
    "{\"op\":\"list\"}", "{\"op\":\"show\"}", "{\"op\":\"doc\"}", "{\"op\":\"asks\"}", "{\"op\":\"proposals\"}", "{\"op\":\"panes\"}", "{\"op\":\"shot\"}",
    "{\"op\":\"apply\"}", "{\"op\":\"new\"}", "{\"op\":\"fork\"}",
    "{\"op\":\"undo\",\"rev\":1}", "{\"op\":\"undo\",\"extra\":true}", "{\"op\":\"undo\",\"op\":\"undo\"}", "{\"op\":\"undo\",\"o\\u0070\":\"undo\"}",
    "{\"op\":\"switch\",\"row\":\"trees\",\"row\":\"rocks\",\"on\":true}", "{\"op\":\"switch\",\"row\":\"trees\",\"r\\u006fw\":\"trees\",\"on\":true}", "{\"op\":\"undo\",\"\":0}"
  ];
  a: [1] Args;
  for s: bad {
    #assert args_add(a[..],"previous"); a[0].full = true;
    #assert !rb_args(s,"garden",a[..]) && a[0].n == 0 && a[0].used == 0 && !a[0].full;
  }
}
#test "batch refuses missing fields wrong JSON types alternatives and catalogue bounds" {
  bad := [35] string.[
    "{\"op\":\"move\",\"entity\":\"trees:0\",\"x\":0}",
    "{\"op\":\"move\",\"entity\":\"trees:0\",\"x\":\"0\",\"z\":0}",
    "{\"op\":\"move\",\"entity\":3,\"x\":0,\"z\":0}",
    "{\"op\":\"move\",\"entity\":\"trees:0\",\"x\":40.01,\"z\":0}",
    "{\"op\":\"switch\",\"row\":\"trees\",\"on\":1}", "{\"op\":\"switch\",\"row\":\"trees\"}",
    "{\"op\":\"place\",\"thing\":\"barrel\",\"x\":0,\"z\":0,\"yaw\":\"90\"}",
    "{\"op\":\"place\",\"thing\":\"barrel\",\"x\":0,\"z\":0,\"yaw\":361}",
    "{\"op\":\"revise\",\"prompt\":null}", "{\"op\":\"revise\",\"prompt\":\"\"}",
    "{\"op\":\"ask\"}", "{\"op\":\"ask\",\"words\":\"x\",\"doc\":\"x.md\"}", "{\"op\":\"ask\",\"doc\":false}",
    "{\"op\":\"ask-delete\",\"id\":\"7\"}", "{\"op\":\"ask-delete\",\"id\":0}", "{\"op\":\"ask-done\",\"id\":7}", "{\"op\":\"ask-done\",\"id\":7,\"commit\":0}",
    "{\"op\":\"row-delete\",\"row\":\"../x\"}", "{\"op\":\"settings\",\"tools\":[\"build\"]}", "{\"op\":\"settings\",\"tools\":\"unknown\"}",
    "{\"op\":\"lore\",\"who\":\"Bram\"}", "{\"op\":\"lore\",\"who\":false,\"text\":\"x\"}", "{\"op\":\"lore\",\"who\":\"Bram\",\"text\":0}",
    "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\"}", "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\",\"steps\":{}}",
    "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\",\"steps\":[1]}", "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\",\"steps\":[\"a\",\"b\",\"c\",\"d\"]}",
    "{\"op\":\"quest\",\"giver\":\"Bram\",\"ask\":\"x\",\"steps\":[],\"reward\":true}",
    "{\"op\":\"publish\",\"listed\":\"true\"}", "{\"op\":\"publish\",\"listed\":null}",
    "{\"op\":\"visibility\",\"visibility\":1}", "{\"op\":\"visibility\",\"visibility\":\"listed\"}",
    "{\"op\":\"accept\",\"id\":1.5}", "{\"op\":\"decline\",\"id\":1000000000}", "{\"op\":\"undo\",\"slug\":\"other\"}"
  ];
  a: [1] Args;
  for s: bad { #assert !rb_args(s,"garden",a[..]) && a[0].n == 0; }
  #assert !rb_args("{\"op\":\"undo\"}","../bad",a[..]) && a[0].n == 0;
  #assert !rb_args("{\"op\":\"undo\"}","garden",a[0..<0]);
}
#test "batch enforces the exact line bound before parsing and clears successful arguments" {
  a: [1] Args; bytes: [8193] u8;
  text := "{\"op\":\"undo\"}";
  for i: 0..<bytes.count { bytes[i] = ' '; }
  for i: 0..<text.count { bytes[i] = text[i]; }
  #assert rb_args(cast(string)bytes[0..<8192],"garden",a[..]) && a[0].n == 3;
  #assert !rb_args(cast(string)bytes[..],"garden",a[..]) && a[0].n == 0;
  #assert rb_args(text,"garden",a[..]) && a[0].n == 3 && a[0].used == 15;
}
#test "batch bounded field emitters refuse malformed Unicode types arrays and exhausted output" {
  #assert rb_find("unknown") == -1 && rb_find("move") == 0 && rb_find("m\\u006fve") == 0;
  a: [1] Args; nodes: [32] JvNode; d: [1] Jv;
  #assert jv_parse(d[..],"[7,\"\\ud800\",\"\\u0000\",[],[\"a\",\"b\",\"c\",\"d\"],[7]]",nodes[..]);
  #assert !rb_string(d[0],jv_at(d[0],0,0),a[..]);
  #assert rb_string(d[0],jv_at(d[0],0,1),a[..]) && args_at(a[..],0) == "�";
  #assert !rb_string(d[0],jv_at(d[0],0,2),a[..]);
  step := RbField.{kind=4,flag="--step"};
  #assert !rb_emit(d[0],jv_at(d[0],0,4),step,a[..]);
  #assert !rb_emit(d[0],jv_at(d[0],0,5),step,a[..]);
  rb_clear(a[..]); a[0].used = ARGS_BYTES;
  #assert !rb_emit(d[0],jv_at(d[0],0,0),RbField.{kind=2,flag="--yaw"},a[..]);
  #assert !rb_emit(d[0],jv_at(d[0],0,5),step,a[..]);
  #assert rb_read("{\"op\":\"undo\"}","garden",a[..]).why == "the operation does not fit";
  #assert !rb_args("{\"op\":\"lore\",\"who\":\"Bram\",\"text\":\"\\u0000\"}","garden",a[..]);
  #assert rb_args("{\"op\":\"lore\",\"who\":\"Bram\",\"text\":\"\\ud800\"}","garden",a[..]);
  #assert rb_args("{\"op\":\"lore\",\"who\":\"Bram\",\"text\":\"\\u0001\"}","garden",a[..]);
  big: [1027] u8; big[0] = '"'; big[1026] = '"';
  for i: 1..<1026 { big[i] = 'x'; }
  #assert jv_parse(d[..],cast(string)big[..],nodes[..]);
  #assert !rb_string(d[0],0,a[..]);
}

RbField :: struct { key: string; kind: int = 1; flag: string; optional: bool; }
RbSpec :: struct { verb: string; fields: [4] RbField; }
// kind: 1 string, 2 JSON number, 3 on/off boolean, 4 ordered string array,
// 5 a boolean flag (false means omit it). The catalogue owns value bounds.
RB_SPECS :: [20] RbSpec.[
  RbSpec.{verb="move",fields=[4] RbField.[RbField.{key="entity"},RbField.{key="x",kind=2},RbField.{key="z",kind=2},RbField.{}]},
  RbSpec.{verb="rotate",fields=[4] RbField.[RbField.{key="entity"},RbField.{key="yaw",kind=2},RbField.{},RbField.{}]},
  RbSpec.{verb="resize",fields=[4] RbField.[RbField.{key="entity"},RbField.{key="scale",kind=2},RbField.{},RbField.{}]},
  RbSpec.{verb="remove",fields=[4] RbField.[RbField.{key="entity"},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="switch",fields=[4] RbField.[RbField.{key="row"},RbField.{key="on",kind=3},RbField.{},RbField.{}]},
  RbSpec.{verb="place",fields=[4] RbField.[RbField.{key="thing"},RbField.{key="x",kind=2},RbField.{key="z",kind=2},RbField.{key="yaw",kind=2,flag="--yaw",optional=true}]},
  RbSpec.{verb="revise",fields=[4] RbField.[RbField.{key="prompt"},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="ask",fields=[4] RbField.[RbField.{key="words",optional=true},RbField.{key="doc",flag="--doc",optional=true},RbField.{},RbField.{}]},
  RbSpec.{verb="ask-delete",fields=[4] RbField.[RbField.{key="id",kind=2},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="ask-done",fields=[4] RbField.[RbField.{key="id",kind=2},RbField.{key="commit",flag="--commit"},RbField.{},RbField.{}]},
  RbSpec.{verb="row-delete",fields=[4] RbField.[RbField.{key="row"},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="settings",fields=[4] RbField.[RbField.{key="tools",flag="--tools"},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="lore",fields=[4] RbField.[RbField.{key="who"},RbField.{key="text"},RbField.{},RbField.{}]},
  RbSpec.{verb="quest",fields=[4] RbField.[RbField.{key="giver"},RbField.{key="ask",flag="--ask"},RbField.{key="steps",kind=4,flag="--step"},RbField.{key="reward",flag="--reward",optional=true}]},
  RbSpec.{verb="accept",fields=[4] RbField.[RbField.{key="id",kind=2},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="decline",fields=[4] RbField.[RbField.{key="id",kind=2},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="undo"},
  RbSpec.{verb="redo"},
  RbSpec.{verb="publish",fields=[4] RbField.[RbField.{key="listed",kind=5,flag="--listed",optional=true},RbField.{},RbField.{},RbField.{}]},
  RbSpec.{verb="visibility",fields=[4] RbField.[RbField.{key="visibility"},RbField.{},RbField.{},RbField.{}]}
];

rb_clear :: (a: [] Args) { a[0].n = 0; a[0].used = 0; a[0].full = false; }
rb_find :: (raw: string) -> int { for i: 0..<RB_SPECS.count { if jv_raw_eq(raw,RB_SPECS[i].verb) { return i; } } return -1; }
rb_string :: (d: Jv, at: int, a: [] Args) -> bool {
  bytes: [1024] u8;
  if jv_kind(d,at) != JV_STRING { return false; }
  n := jv_str(d,at,bytes[..]); if n < 0 { return false; }
  for i: 0..<n { if bytes[i] == 0 { return false; } }
  return args_add(a,cast(string)bytes[0..<n]);
}
rb_emit :: (d: Jv, at: int, f: RbField, a: [] Args) -> bool {
  if f.kind == 4 {
    if jv_kind(d,at) != JV_ARRAY || jv_len(d,at) > 3 { return false; }
    for i: 0..<jv_len(d,at) { if !args_add(a,f.flag) || !rb_string(d,jv_at(d,at,i),a) { return false; } }
    return true;
  }
  if f.kind == 3 || f.kind == 5 {
    kind := jv_kind(d,at); if kind != JV_TRUE && kind != JV_FALSE { return false; }
    if f.kind == 5 { return !jv_bool(d,at) || args_add(a,f.flag); }
    return args_add(a,ifx jv_bool(d,at) then "on" else "off");
  }
  if f.flag != "" && !args_add(a,f.flag) { return false; }
  if f.kind == 1 { return rb_string(d,at,a); }
  return jv_kind(d,at) == JV_NUMBER && args_add(a,jv_raw(d,at));
}
// Why a line is refused: field names the JSON field ("" for the whole line;
// a slice of the line or of RB_SPECS), why says what it must be. why "" is admitted.
RbWhy :: struct { field: string; why: string; }
RB_OPS :: "is not an edit: move, rotate, resize, remove, switch, place, revise, ask, ask-delete, ask-done, row-delete, settings, lore, quest, accept, decline, undo, publish or visibility";
rb_kind_why :: (kind: int) -> string {
  if kind == 2 { return "must be a JSON number"; }
  if kind == 3 || kind == 5 { return "must be true or false"; }
  if kind == 4 { return "must be an array of at most three strings"; }
  return "must be a string (without NUL)";
}
rb_read :: (line: string, slug: string, a: [] Args) -> RbWhy {
  if line.count > 8192 { return RbWhy.{why="a line is at most 8192 bytes"}; }
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..],line,nodes[..]) || jv_kind(d[0],0) != JV_OBJECT { return RbWhy.{why="is not one JSON object such as {\"op\":\"undo\"}"}; }
  op := jv_get(d[0],0,"op");
  if jv_kind(d[0],op) != JV_STRING { return RbWhy.{field="op",why="is missing or not a string"}; }
  index := rb_find(jv_raw(d[0],op)); if index == -1 { return RbWhy.{field="op",why=RB_OPS}; }
  spec := RB_SPECS[index]; verb := spec.verb; fields := [4] int.[-1,-1,-1,-1];
  c := d[0].nodes[0].first;
  while c != -1 {
    key := jv_key(d[0],c);
    if jv_raw_eq(key,"op") { if c != op { return RbWhy.{field="op",why="is given twice"}; } }
    else {
      found := -1;
      for i: 0..<4 { if spec.fields[i].key != "" && jv_raw_eq(key,spec.fields[i].key) { found = i; } }
      if found == -1 { return RbWhy.{field=key,why="is not a field of this op (a revision goes in --rev, not in a line)"}; }
      if fields[found] != -1 { return RbWhy.{field=key,why="is given twice"}; }
      fields[found] = c;
    }
    c = d[0].nodes[c].next;
  }
  if verb == "ask" && (fields[0] != -1) == (fields[1] != -1) { return RbWhy.{field="words",why="ask takes words or doc, exactly one"}; }
  if !args_add(a,"realm") || !args_add(a,verb) || !args_add(a,slug) { return RbWhy.{why="the operation does not fit"}; }
  for i: 0..<4 {
    f := spec.fields[i]; if f.key == "" { continue; }
    if fields[i] == -1 { if !f.optional { return RbWhy.{field=f.key,why="is missing"}; } }
    else { if !rb_emit(d[0],fields[i],f,a) { return RbWhy.{field=f.key,why=rb_kind_why(f.kind)}; } }
  }
  return RbWhy.{why=rc_validate(a,verb)};
}
// Failure leaves no partially parsed operation for a caller to execute.
rb_args :: (line: string, slug: string, a: [] Args) -> bool { return rb_check(line,slug,a).why == ""; }
rb_check :: (line: string, slug: string, a: [] Args) -> RbWhy {
  if a.count < 1 { return RbWhy.{why="no room for the operation"}; }
  rb_clear(a);
  w := rb_read(line,slug,a);
  if w.why != "" { rb_clear(a); }
  return w;
}

#test "rotate, resize and remove: a thing, whole degrees, whole percent 25 to 400" {
  a: [1] Args;
  ok := [5] string.["{\"op\":\"rotate\",\"entity\":\"trees:3\",\"yaw\":90}", "{\"op\":\"rotate\",\"entity\":\"placed:0\",\"yaw\":-360}",
    "{\"op\":\"resize\",\"entity\":\"rocks:1\",\"scale\":25}", "{\"op\":\"resize\",\"entity\":\"rocks:1\",\"scale\":400}", "{\"op\":\"remove\",\"entity\":\"props:2\"}"];
  for line: ok { #assert rb_check(line,"garden",a[..]).why == ""; }
  #assert rb_check(ok[2],"garden",a[..]).why == "" && args_at(a[..],1) == "resize" && args_at(a[..],3) == "rocks:1" && args_at(a[..],4) == "25";
  bad := [7] string.["{\"op\":\"rotate\",\"entity\":\"trees:3\",\"yaw\":361}", "{\"op\":\"rotate\",\"entity\":\"trees:3\",\"yaw\":1.5}",
    "{\"op\":\"resize\",\"entity\":\"rocks:1\",\"scale\":24}", "{\"op\":\"resize\",\"entity\":\"rocks:1\",\"scale\":401}", "{\"op\":\"resize\",\"entity\":\"rocks:1\",\"scale\":\"50\"}",
    "{\"op\":\"remove\",\"entity\":\"trees\"}", "{\"op\":\"remove\",\"entity\":\"trees:1\",\"x\":1}"];
  whys := [7] string.[rc_why("yaw"), rc_why("yaw"), rc_why("percent"), rc_why("percent"), "must be a JSON number", rc_why("entity"), "is not a field of this op (a revision goes in --rev, not in a line)"];
  for i: 0..<bad.count { #assert rb_check(bad[i],"garden",a[..]).why == whys[i] && a[0].n == 0; }
  #assert rc_value("percent","25") && rc_value("percent","400") && !rc_value("percent","24") && !rc_value("percent","401") && !rc_value("percent","") && !rc_value("percent","1e2");
  #assert rc_why("percent") == "PERCENT is a whole number from 25 to 400";
}

#test "a refused batch line names its field and what it must be" {
  a: [1] Args;
  cases := [12] string.[
    "[1]", "{\"x\":1}", "{\"op\":\"fly\"}", "{\"op\":\"undo\",\"op\":\"undo\"}",
    "{\"op\":\"undo\",\"rev\":3}", "{\"op\":\"switch\",\"row\":\"a\",\"row\":\"b\",\"on\":true}",
    "{\"op\":\"ask\"}", "{\"op\":\"move\",\"entity\":\"trees:0\",\"x\":0}",
    "{\"op\":\"move\",\"entity\":\"trees:0\",\"x\":\"0\",\"z\":0}", "{\"op\":\"switch\",\"row\":\"a\",\"on\":1}",
    "{\"op\":\"move\",\"entity\":\"enclosure\",\"x\":1,\"z\":1}", "{\"op\":\"quest\",\"giver\":\"B\",\"ask\":\"x\",\"steps\":{}}"];
  fields := [12] string.["", "op", "op", "op", "rev", "row", "words", "z", "x", "on", "", "steps"];
  whys := [12] string.["is not one JSON object such as {\"op\":\"undo\"}", "is missing or not a string", RB_OPS, "is given twice",
    "is not a field of this op (a revision goes in --rev, not in a line)", "is given twice", "ask takes words or doc, exactly one", "is missing",
    "must be a JSON number", "must be true or false", rc_why("entity"), "must be an array of at most three strings"];
  for i: 0..<cases.count {
    w := rb_check(cases[i],"garden",a[..]);
    #assert w.field == fields[i] && w.why == whys[i] && a[0].n == 0;
  }
  #assert rb_check("{\"op\":\"lore\",\"who\":\"B\",\"text\":0}","garden",a[..]).why == "must be a string (without NUL)";
  #assert rb_check("{\"op\":\"publish\",\"listed\":1}","garden",a[..]).why == "must be true or false";
  #assert rb_check("{\"op\":\"undo\"}","garden",a[0..<0]).why != "";
  long: [8193] u8; for i: 0..<long.count { long[i] = ' '; }
  #assert rb_check(cast(string) long[..],"garden",a[..]).why == "a line is at most 8192 bytes";
  ok := rb_check("{\"op\":\"undo\"}","garden",a[..]);
  #assert ok.why == "" && ok.field == "" && a[0].n == 3;
}

// realm apply's FILE, for help: each op and its fields (? optional), from RB_SPECS.
#test "the batch format help lists every op with its fields" {
  out: [1024] u8;
  h := rb_help(out[..]);
  #assert cli_prefix(h, "move entity x z; rotate entity yaw; resize entity scale; remove entity; switch row on; place thing x z yaw?; revise prompt; ask words?|doc?; ask-delete id; ask-done id commit; ");
  #assert rc_contains(h, "quest giver ask steps reward?; accept id; decline id; undo; redo; publish listed?; visibility visibility") && !rc_contains(h, "  ");
  #assert rb_help(out[0..<10]) == "";
}
rb_help :: (out: [] u8) -> string {
  n := 0;
  for i: 0..<RB_SPECS.count {
    sp := RB_SPECS[i];
    if i > 0 { n = forge_put(out,n,"; "); }
    n = forge_put(out,n,sp.verb);
    for j: 0..<4 {
      f := sp.fields[j]; if f.key == "" { continue; }
      n = forge_put(out,n,ifx sp.verb == "ask" && j == 1 then "|" else " ");
      n = forge_put(out,n,f.key);
      if f.optional { n = forge_put(out,n,"?"); }
    }
  }
  return ifx n == -1 then "" else cast(string) out[0..<n];
}

// realm list's text: one aligned row a realm under a header, from the
// server's "realm SLUG|REV|PUBLISHED|LISTED|NAME|VISIBILITY" lines
// (published 0: never); "realms 0" when there are none. A line of another
// shape is kept as it came. Its length, or -1 when out is short.
#test "realm list reads as aligned columns, not pipe rows" {
  out: [1024] u8;
  t := "realm night-garden|1|1|0|Night Garden|private\nrealm walled-garden|12|0|1|Walled Garden|public\n";
  n := cli_realm_rows(t, out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "SLUG           VISIBILITY  REV  PUBLISHED  NAME\nnight-garden   private     1    1          Night Garden\nwalled-garden  public      12   never      Walled Garden\n";
  n = cli_realm_rows("", out[..]);
  #assert cast(string) out[0..<n] == "realms 0\n";
  n = cli_realm_rows("\n\n", out[..]);
  #assert cast(string) out[0..<n] == "realms 0\n";
  n = cli_realm_rows("realm a|2|2|0|A|unlisted\nnote x", out[..]);
  #assert cast(string) out[0..<n] == "SLUG  VISIBILITY  REV  PUBLISHED  NAME\na     unlisted    2    2          A\nnote x\n";
  n = cli_realm_rows("realm a|2|2|0|A|", out[..]);
  #assert cast(string) out[0..<n] == "SLUG  VISIBILITY  REV  PUBLISHED  NAME\na     public      2    2          A\n";
  #assert cli_realm_rows(t, out[0..<40]) == -1 && cli_realm_rows("", out[0..<3]) == -1;
  n = cli_realm_rows("note x", out[..]);
  #assert cast(string) out[0..<n] == "note x\n";
  n = cli_realm_rows("\nrealm abcdefg|2|2|0|A|unlisted", out[..]);
  #assert cast(string) out[0..<n] == "SLUG     VISIBILITY  REV  PUBLISHED  NAME\nabcdefg  unlisted    2    2          A\n";
  n = cli_realm_rows("realm a-very-long-realm-slug-name|123456|99|0|N|private", out[..]);
  #assert cast(string) out[0..<n] == "SLUG                         VISIBILITY  REV  PUBLISHED  NAME\na-very-long-realm-slug-name  private     123456 99         N\n";
}
cli_realm_rows :: (text: string, out: [] u8) -> int {
  slug_w := 4; rows := false; at := 0;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    line := text[at..<end]; at = end + 1;
    if !cli_prefix(line,"realm ") { continue; }
    k := cli_field(line[6..<line.count],0).count;
    while slug_w < k { slug_w += 1; }
    rows = true;
  }
  n := 0;
  if rows {
    n = cli_cell(out,n,"SLUG",slug_w + 2); n = cli_cell(out,n,"VISIBILITY",12); n = cli_cell(out,n,"REV",5); n = cli_cell(out,n,"PUBLISHED",11); n = forge_put(out,n,"NAME\n");
  }
  at = 0; others := false;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    line := text[at..<end]; at = end + 1;
    if line.count == 0 { continue; }
    if !cli_prefix(line,"realm ") { n = forge_put(out,n,line); n = forge_put(out,n,"\n"); others = true; continue; }
    r := line[6..<line.count];
    vis := cli_field(r,5); pub := cli_field(r,2);
    n = cli_cell(out,n,cli_field(r,0),slug_w + 2);
    n = cli_cell(out,n,ifx vis == "" then "public" else vis,12);
    n = cli_cell(out,n,cli_field(r,1),5);
    n = cli_cell(out,n,ifx pub == "0" then "never" else pub,11);
    n = forge_put(out,n,cli_field(r,4)); n = forge_put(out,n,"\n");
  }
  if !rows && !others { n = forge_put(out,n,"realms 0\n"); }
  return n;
}
// text, then spaces to width (at least one).
cli_cell :: (out: [] u8, at: int, text: string, width: int) -> int {
  n := forge_put(out,forge_put(out,at,text)," ");
  w := text.count + 1;
  while w < width { n = forge_put(out,n," "); w += 1; }
  return n;
}

