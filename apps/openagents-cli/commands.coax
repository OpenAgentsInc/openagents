  #assert rc_validate(c[..],"settings") != "";
  #assert args_add(c[..],"--tools") && args_add(c[..],"build,talk") && rc_validate(c[..],"settings") == "";
  d: [1] Args;
  for s: [4] string.["realm","quest","garden","Bram"] { #assert args_add(d[..],s); }
  #assert rc_validate(d[..],"quest") != "";
  e: [1] Args;
  for s: [6] string.["realm","ask-done","garden","7","--commit","abcdef0"] { #assert args_add(e[..],s); }
  #assert rc_validate(e[..],"ask-done") == "";
}

#test "parser helpers handle flags before positionals and refuse truncated argv" {
  a: [1] Args;
  for s: [7] string.["--profile","test","--json","realm","undo","garden","--yes"] { #assert args_add(a[..],s); }
  #assert rc_validate(a[..],"undo") != "";
  a[0].n = 6; #assert rc_validate(a[..],"undo") == "";
  #assert rc_option(a[..],"undo","--json","boolean") == "boolean" && rc_option(a[..],"undo","--origin","missing") == "missing";
  #assert rc_pos(a[..],"undo",0) == "realm" && rc_pos(a[..],"undo",2) == "garden";
  a[0].full = true; #assert rc_validate(a[..],"undo") != "";
  b: [1] Args; for s: [2] string.["wrong","list"] { #assert args_add(b[..],s); }
  #assert rc_validate(b[..],"list") != "";
  b[0].v[0] = "realm"; b[0].v[1] = "other"; #assert rc_validate(b[..],"list") != "";
  #assert rc_pos(b[..],"unknown",0) == "" && !rc_has(b[..],"unknown","--json") && rc_option(b[..],"unknown","--rev","missing") == "missing";
  c: [1] Args; for s: [11] string.["realm","list","a","b","c","d","e","f","g","h","i"] { #assert args_add(c[..],s); }
  #assert rc_validate(c[..],"list") != "";
  d: [1] Args; for s: [3] string.["realm","undo","--rev"] { #assert args_add(d[..],s); }
  #assert rc_option(d[..],"undo","--rev","missing") == "missing";
  e: [1] Args; for s: [4] string.["--profile","test","realm","list"] { #assert args_add(e[..],s); }
  #assert rc_validate(e[..],"list") == "" && rc_has(e[..],"list","--profile");
  #assert rc_option(e[..],"list","--profile","") == "test" && rc_option_at(e[..],"list","--profile",0) == "test";
  #assert rc_pos(e[..],"list",0) == "realm" && rc_pos(e[..],"list",1) == "list";
  f: [1] Args; for s: [5] string.["realm","quest","garden","Bram","--ask"] { #assert args_add(f[..],s); }
  #assert rc_validate(f[..],"quest") != "" && rc_option_at(f[..],"quest","--ask",0) == "";
  g: [1] Args; for s: [6] string.["realm","undo","--unknown","--rev","7","garden"] { #assert args_add(g[..],s); }
  #assert rc_option(g[..],"undo","--rev","") == "7" && rc_pos(g[..],"undo",2) == "garden";
  #assert rc_is_flag("--") && rc_is_flag("--rev") && rc_is_flag("---");
  #assert !rc_is_flag("") && !rc_is_flag("-") && !rc_is_flag("a--");
}

#test "realm shots preserve optional output and every implemented labs shot flag" {
  a: [1] Args;
  for s: [3] string.["realm","shot","garden"] { #assert args_add(a[..],s); }
  #assert rc_validate(a[..],"shot") == "";
  #assert args_add(a[..],"garden.png") && rc_validate(a[..],"shot") == "";
  #assert args_add(a[..],"extra.png") && rc_validate(a[..],"shot") != "";
  b: [1] Args;
  for s: [2] string.["realm","shot"] { #assert args_add(b[..],s); }
  #assert rc_validate(b[..],"shot") != "";
  for preset: [3] string.["--phone","--square","--vertical"] {
    c: [1] Args;
    for s: [9] string.["realm","shot","garden",preset,"--wait","120000","--eval","--phone","--dark"] { #assert args_add(c[..],s); }
    #assert args_add(c[..],"--fresh") && rc_validate(c[..],"shot") == "";
    #assert rc_option(c[..],"shot","--eval","") == "--phone";
  }
  d: [1] Args;
  for s: [5] string.["realm","shot","garden","--size","7680x16"] { #assert args_add(d[..],s); }
  #assert rc_validate(d[..],"shot") == "";
  #assert args_add(d[..],"--phone") && rc_validate(d[..],"shot") != "";
  d[0].v[4] = ""; #assert rc_validate(d[..],"shot") == "";
  #assert args_add(d[..],"--square") && rc_validate(d[..],"shot") != "";
  e: [1] Args;
  for s: [4] string.["realm","shot","garden","--as-me"] { #assert args_add(e[..],s); }
  #assert rc_validate(e[..],"shot") == ""; // labs_shot keeps its explicit not-built refusal.
  e[0].v[3] = ""; #assert rc_validate(e[..],"shot") == ""; // explicitly empty OUT uses the default too.
  e[0].v[3] = "--at"; #assert rc_validate(e[..],"shot") != "";
  e[0].v[3] = "--stage"; #assert rc_validate(e[..],"shot") != "";
}

#test "shot size wait script and file fields retain their bounded profiles" {
  #assert rc_value("size","") && rc_value("size","16x16") && rc_value("size","7680x7680") && rc_value("size","000000016x000007680");
  #assert !rc_value("size","15x16") && !rc_value("size","16x15") && !rc_value("size","7681x16") && !rc_value("size","16x7681");
  #assert !rc_value("size","x16") && !rc_value("size","16") && !rc_value("size","16x") && !rc_value("size","16.5x16");
  #assert rc_value("waitms","0") && rc_value("waitms","120000") && !rc_value("waitms","-1") && !rc_value("waitms","120001") && !rc_value("waitms","");
  #assert !rc_value("waitms","1.5") && !rc_value("waitms","1e3") && !rc_value("waitms","0000000000");
  b: [131073] u8; for i: 0..<b.count { b[i] = 'x'; }
  #assert rc_value("script","") && rc_value("script",cast(string)b[0..<131072]) && !rc_value("script",cast(string)b[..]);
  #assert rc_value("shotfile","") && rc_value("shotfile",cast(string)b[0..<1024]) && !rc_value("shotfile",cast(string)b[0..<1025]);
  c: [1] Args;
  for s: [5] string.["realm","shot","garden","--wait",""] { #assert args_add(c[..],s); }
