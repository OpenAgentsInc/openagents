  b: [1] Args;
  for s: [5] string.["realm","ask","garden","--doc","design.md"] { #assert args_add(b[..],s); }
  #assert rc_validate(b[..],"ask") == "";
  #assert args_add(b[..],"a pond") && rc_validate(b[..],"ask") != "";
  c: [1] Args;
  for s: [4] string.["realm","new","a pond","--from"] { #assert args_add(c[..],s); }
  #assert rc_validate(c[..],"new") != "";
  d: [1] Args; long: [2001] u8; for i: 0..<long.count { long[i] = 'x'; }
  for s: [2] string.["realm","new"] { #assert args_add(d[..],s); }
  #assert args_add(d[..],cast(string)long[0..<2000]) && rc_validate(d[..],"new") == "";
  d[0].v[2] = cast(string)long[..]; #assert rc_validate(d[..],"new") != "";
}

#test "only actual flag tokens count for duplicate and required flags" {
  a: [1] Args;
  for s: [9] string.["realm","quest","garden","Bram","--ask","--rev","--rev","7","--json"] { #assert args_add(a[..],s); }
  #assert rc_validate(a[..],"quest") == "";
  #assert rc_has(a[..],"quest","--rev") && rc_option(a[..],"quest","--rev","") == "7";
  #assert rc_option(a[..],"quest","--ask","") == "--rev";
  #assert rc_pos(a[..],"quest",0) == "realm" && rc_pos(a[..],"quest",1) == "quest" && rc_pos(a[..],"quest",2) == "garden" && rc_pos(a[..],"quest",3) == "Bram";
  #assert rc_pos(a[..],"quest",4) == "" && rc_pos(a[..],"quest",-1) == "";
  #assert args_add(a[..],"--rev") && args_add(a[..],"8") && rc_validate(a[..],"quest") != "";
  b: [1] Args;
  for s: [6] string.["realm","ask","garden","hello","--profile","--doc"] { #assert args_add(b[..],s); }
  #assert rc_validate(b[..],"ask") == "" && !rc_has(b[..],"ask","--doc");
  #assert rc_option(b[..],"ask","--doc","fallback") == "fallback" && rc_option(b[..],"ask","--profile","") == "--doc";
  c: [1] Args;
  for s: [6] string.["realm","ask-done","garden","1","--profile","--commit"] { #assert args_add(c[..],s); }
  #assert rc_validate(c[..],"ask-done") != "" && !rc_has(c[..],"ask-done","--commit");
  d: [1] Args;
  for s: [4] string.["realm","new","--profile","--from"] { #assert args_add(d[..],s); }
  #assert rc_validate(d[..],"new") != "" && !rc_has(d[..],"new","--from");
}

