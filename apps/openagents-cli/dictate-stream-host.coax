// Explicit Linux streaming helper; kept separate from the offline model's
// generated-C symbols and CLI signing code. No default provider substitution.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "rules.coax";
#load "out.coax";
#load "dictate-launch.coax";
#load "dictate-stream.coax";
cxcli_isatty :: (fd:int)->int #foreign;
cxcli_exe_path :: (out:[]u8)->int #foreign;
cxproc_exec :: (h:int)->int #foreign;
tool_main :: ()->int #export_c {
 a:[1]Args;r:[1]Rep;if !args_load(a[..]) {return EXIT_USAGE;}
 r[0].json=args_has(a[..],"--json");
 if args_has(a[..],"--help") || args_has(a[..],"-h") {dictate_usage();return 0;}
 return dictate_stream_main(a[..],r[..]);
}
