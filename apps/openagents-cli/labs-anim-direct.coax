#load "../../metaverse-engine/tools/anim-direction-store.coax";
labs_anim_direct :: (p:AnimArgs,r:[]Rep,profile:string)->int {
 canonical:[4096]u8;file:=fs_realpath(p.clip,canonical[..]);if file=="" {return fail(r,EXIT_USAGE,"animation source file is missing");}current:[67108864]u8;n:=ap_file(file,current[..]);project:[1]SceneProject;if n<1 || !project_load(current[0..<n],project[..]) {return fail(r,EXIT_FAIL,"animation project refused");}
 if p.verb!="edit" {return labs_anim_history(p,r,file,current[0..<n]);}
 request:[16384]u8;rn:=ad_request(project[..],p.words,request[..]);if rn<1 {return fail(r,EXIT_FAIL,"direction or inventory exceeds the bounded catalogue");}origin_buf:[300]u8;origin:=la_origin(AnimeArgs.{origin=p.origin},profile,origin_buf[..]);if origin=="" {return fail(r,EXIT_USAGE,"invalid Decisions API origin");}reply:[65536]u8;res:=la_request_at(profile,origin,"/api/playtest/labs/anim/direct",cast(string)request[0..<rn],reply[..]);if !api_ok(res) {return api_fail(r,res,cast(string)reply[0..<res.n]);}
 e:[1]AnimDirection;code:=ads_reply(current[0..<n],cast(string)reply[0..<res.n],e[..]);if code!=0 {return fail(r,EXIT_FAIL,"invalid or stale director response; scene unchanged");}score:=ad_confidence(e[0]);rep_int(r,"confidence_milli",score);rep_str(r,"kind",AED_KINDS[e[0].kind]);if r[0].json {score_nodes:[1024]JvNode;score_doc:[1]Jv;#assert anim_json(cast(string)reply[0..<res.n],score_doc[..],score_nodes[..])==0;direction:=jv_get(score_doc[0],0,"direction");rep_raw(r,"confidence",jv_raw(score_doc[0],jv_get(score_doc[0],direction,"confidence")));}if e[0].kind==0 || score<=850 {rep_str(r,"outcome",ifx e[0].kind==0 then "not in stock" else "ambiguous; scene unchanged");return rep_done(r,EXIT_OK);}
 next:[67108864]u8;built:=ad_build(project[..],e[0],next[..]);if built.code!=0 {return fail(r,EXIT_FAIL,anim_error_name(built.code));}accepted:[1]SceneProject;if !project_load(next[0..<built.n],accepted[..]) {return fail(r,EXIT_FAIL,anim_error_name(accepted[0].error));}report:[262144]u8;report_n:=scene_check(accepted[..],report[..]);if report_n<1 {return fail(r,EXIT_FAIL,"scene report capacity");}failed:=ad_screen(cast(string)report[0..<report_n]);if failed!="" {return fail(r,EXIT_FAIL,failed);}
 nodes:[1024]JvNode;d:[1]Jv;#assert anim_json(cast(string)reply[0..<res.n],d[..],nodes[..])==0;proposal:=jv_raw(d[0],jv_get(d[0],0,"direction"));if !ad_store_publish(file,current[0..<n],next[0..<built.n],p.words,proposal) {return fail(r,EXIT_CONFLICT,"version publication refused; source changed, output exists, or private storage unavailable");}
 hash:[64]u8;root_buf:[4096]u8;version:=ad_store_head(ad_store_dir(file,root_buf[..]),hash[..]);rep_str(r,"version",version);rep_str(r,"outcome","applied");rep_str(r,"file",file);return rep_done(r,EXIT_OK);
}
labs_anim_history :: (p:AnimArgs,r:[]Rep,file:string,current:[]u8)->int {
 root_buf:[4096]u8;root:=ad_store_dir(file,root_buf[..]);head:[64]u8;id:=ad_store_head(root,head[..]);if id=="" {return fail(r,EXIT_FAIL,"no animation edit history");}path:[4096]u8;text:[8192]u8;n:=fs_read(ad_store_name(root,id,".json",path[..]),text[..]);nodes:[1024]JvNode;d:[1]Jv;ids_head:[1]AssetId;if n<1 || !asset_parse(id,ids_head[..]) || !asset_same(asset_id(cast(string)text[0..<n]),ids_head[0]) || anim_json(cast(string)text[0..<n],d[..],nodes[..])!=0 || !anim_schema(d[0],"anim.version.v1") {return fail(r,EXIT_FAIL,"version receipt refused");}parent_buf:[64]u8;pn:=jv_str(d[0],jv_get(d[0],0,"parent"),parent_buf[..]);parent:=cast(string)parent_buf[0..<ifx pn>0 then pn else 0];ids:[1]AssetId;if pn!=64 || !asset_parse(parent,ids[..]) {return fail(r,EXIT_FAIL,"already at the original version");}
 parent_receipt:[8192]u8;prn:=fs_read(ad_store_name(root,parent,".json",path[..]),parent_receipt[..]);if prn<1 || !asset_same(asset_id(cast(string)parent_receipt[0..<prn]),ids[0]) {return fail(r,EXIT_FAIL,"parent receipt refused");}parent_nodes:[1024]JvNode;pd:[1]Jv;content:[1]AssetId;if anim_json(cast(string)parent_receipt[0..<prn],pd[..],parent_nodes[..])!=0 || !anim_schema(pd[0],"anim.version.v1") || !anim_hash(pd[0],jv_get(pd[0],0,"content"),content[..]) {return fail(r,EXIT_FAIL,"parent receipt refused");}
 previous:[67108864]u8;before_n:=fs_read(ad_store_name(root,parent,".alp",path[..]),previous[..]);parent_project:[1]SceneProject;if before_n<1 || !asset_same(asset_id(cast(string)previous[0..<before_n]),content[0]) || !project_load(previous[0..<before_n],parent_project[..]) {return fail(r,EXIT_FAIL,"parent version refused");}
 if p.verb=="diff" {out:[1048576]u8;o:[1]Jo;jo_start(o[..],out[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.diff.v1");jo_key(o[..],"from");jo_str(o[..],parent);jo_key(o[..],"to");jo_str(o[..],id);jo_key(o[..],"direction");jv_write(d[0],jv_get(d[0],0,"direction"),o[..]);jo_key(o[..],"parts");jo_arr(o[..]);for part:0..<project_parts(current) {before:=project_part(previous[0..<before_n],part);after:=project_part(current,part);if cast(string)before!=cast(string)after {if part<cast(int)anim_word(current,8) {return fail(r,EXIT_FAIL,"unexpected library change");}jo_obj(o[..]);jo_key(o[..],"part");jo_int(o[..],part);jo_key(o[..],"before");jo_raw(o[..],cast(string)before);jo_key(o[..],"after");jo_raw(o[..],cast(string)after);jo_end(o[..]);}}jo_end(o[..]);jo_end(o[..]);if o[0].bad {return fail(r,EXIT_FAIL,"diff capacity");}print("%\n",jo_text(o[..]));return EXIT_OK;}
 if !ad_store_private(root) {return fail(r,EXIT_FAIL,"undo requires canonical private storage");}lock:[4096]u8;if !fs_try_lock(fs_join(fs_dir(file),".anim-direct.lock",lock[..])) {return fail(r,EXIT_CONFLICT,"another animation writer holds the lock");}defer {released:=fs_unlock();}head_now:[64]u8;if ad_store_head(root,head_now[..])!=id {return fail(r,EXIT_CONFLICT,"animation version changed");}temp:[4096]u8;dest:[4096]u8;if !fs_write(fs_join(root,"pending-head",temp[..]),parent) || !fs_rename(fs_join(root,"pending-head",temp[..]),fs_join(root,"head",dest[..])) {return fail(r,EXIT_FAIL,"could not publish undo");}rep_str(r,"version",parent);rep_str(r,"outcome","undone");return rep_done(r,EXIT_OK);
}
