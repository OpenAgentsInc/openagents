#load "anim-args.coax";
#load "../../metaverse-engine/tools/anim-scene-play.coax";
#load "../../metaverse/animlab/check.coax";
#load "../../metaverse-engine/tools/anim-import-io.coax";
#load "../../metaverse-engine/tools/anim-retarget-io.coax";
#load "labs-anim-direct.coax";
labs_anim :: (a:[]Args,r:[]Rep,profile:string)->int {
 request:=an_parse(a);if request.err!="" {return fail(r,EXIT_USAGE,request.err);}if request.verb=="play" {why:[4096]u8;error:=scene_play_file(request.clip,request.out,why[..]);if error!="" {return fail(r,EXIT_FAIL,error);}rep_str(r,"out",request.out);return rep_done(r,EXIT_OK);}
 if request.verb=="edit" || request.verb=="undo" || request.verb=="diff" {return labs_anim_direct(request,r,profile);}
 if request.verb=="check" {bytes:[67108864]u8;n:=ap_file(request.clip,bytes[..]);project:[1]SceneProject;if n<1 || !project_load(bytes[0..<n],project[..]) {return fail(r,EXIT_FAIL,"animation project refused");}out:[262144]u8;size:=scene_check(project[..],out[..]);if size<1 {return fail(r,EXIT_FAIL,"animation report exceeds capacity");}print("%\n",cast(string)out[0..<size]);return ifx ad_screen(cast(string)out[0..<size])=="" then EXIT_OK else EXIT_FAIL;}if request.verb=="import" {sdk_root:[1024]u8;imported:=ai_import_files(request.clip,request.rig,request.out,request.rate,source_root(sdk_root[..]));if imported.err!="" {return fail(r,EXIT_FAIL,imported.err);}rep_str(r,"out",cast(string)imported.path[0..<imported.path_n]);rep_int(r,"clips",imported.clips);rep_int(r,"joints",imported.joints);rep_int(r,"frames",imported.frames);rep_int(r,"pack_bytes",imported.bytes);return rep_done(r,EXIT_OK);}buffer:[4096]u8;destination:=request.out;
 if destination=="" {n:=copy(request.clip,buffer[..]);if n<0 {return fail(r,EXIT_USAGE,"animation path is too long");}m:=copy(".retarget",buffer[n..<buffer.count]);if m<0 {return fail(r,EXIT_USAGE,"animation path is too long");}destination=cast(string)buffer[0..<n+m];}
 result:=anim_retarget_files(request.clip,request.source,request.target,destination);if result.code!=0 {return fail(r,ifx result.code==91 then EXIT_CONFLICT else EXIT_FAIL,ar_error(result.code));}
 rep_str(r,"out",destination);rep_int(r,"frames",result.frames);rep_int(r,"joints",result.joints);rep_int(r,"paired_anchors",result.paired);rep_int(r,"pack_bytes",result.bytes);rep_int(r,"dropped_curves",result.dropped_curves);rep_int(r,"dropped_events",result.dropped_events);return rep_done(r,EXIT_OK);
}
