}

#test "every tunable reads back what tuning_put set" {
  t: Tuning;
  for i: 0..<TUNABLES {
    b := TUNABLE_BOUNDS[i];
    v := ifx b.whole then b.hi else (b.lo + b.hi) / 2.0;
    #assert cast(f32) tuning_get(tuning_put(t, i, v), i) == cast(f32) v;
  }
  #assert tuning_get(t, 0) == 4.5 && tuning_get(t, TUNABLES) == 0;
}

#test "the same seed and tuning give the same run" #steps 600000000 {
  games: [1] Game; bots: [1] Bot;
  t: Tuning;
  a := ice_run(games[..], bots[..], 11, t, 1);
  again := ice_run(games[..], bots[..], 11, t, 1);
  other := ice_run(games[..], bots[..], 12, t, 1);
  #assert a.fingerprint == again.fingerprint && a.ms == again.ms && a.fingerprint != other.fingerprint;
  #assert a.end == 0 && a.ms == 1000;
}

#test "a cut's side panel, captions file and shot filters read" {
  c: [1] LbCut;
  lb_cut_parse(c[..], "side face.mp4 width=576 in=1.5 vf=\"crop=576:1080,eq=contrast=1.07\"\ncaptions talk.srt box=no\nshot a src=a.mp4 dur=2 vf=\"crop=1194:960:556:115,scale=1344:1080\"\n", "");
  #assert c[0].problems[0].n == 0 && c[0].side_w == 576 && c[0].side_in_ms == 1500 && lb_cut_sp(c[..], c[0].side) == "face.mp4";
  #assert lb_cut_sp(c[..], c[0].side_vf) == "crop=576:1080,eq=contrast=1.07" && lb_cut_sp(c[..], c[0].captions) == "talk.srt" && !c[0].cap_box;
  #assert lb_cut_sp(c[..], c[0].shots[0].vf) == "crop=1194:960:556:115,scale=1344:1080";
  o: [1] LbCut;
  lb_cut_parse(o[..], "shot a src=a.mp4 dur=2 over=hud.mp4 over_in=1.25\n", "");
  #assert o[0].problems[0].n == 0 && lb_cut_sp(o[..], o[0].shots[0].over) == "hud.mp4" && o[0].shots[0].over_in_ms == 1250;
  b: [2048] u8; e: [1] LbCut;
  lb_cut_parse(e[..], "side x.mp4\nside y.mp4 width=7 fast=1\ncaptions a.srt box=maybe\nshot a src=a.mp4 dur=1\n", "");
  t := lb_problems_text(e[0].problems[..], e[0].pool[..], b[..]);
  #assert lb_has(t, "1 side needs width=W\n") && lb_has(t, "2 width is an even number of pixels, 16 or more\n") && lb_has(t, "2 unknown word fast (side takes width, in and vf)\n");
  #assert lb_has(t, "3 unknown word box (captions takes box=yes or box=no)\n");
}
