  else if index == 23 { return cast(f64) t.gloat; }
  else if index == 24 { return cast(f64) t.volley_min; }
  else if index == 25 { return cast(f64) t.volley_max; }
  else if index == 26 { return cast(f64) t.volley_spread; }
