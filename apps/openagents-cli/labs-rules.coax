// The labs domain's rules (docs/cli/2026-11-01-openagents-labs.md): where a
// page is, the sizes, times and qualities the flags name, the programs Labs
// needs and how to install them, the .cut and .board formats and their
// checks, the playtest summary, and how two labels differ. No effects: the
// labs*.coax files run Chrome, ffmpeg and the rules, and print. Not
// #authority: nothing here decides money, admission or policy.
//   coax/bin/coax test apps/openagents-cli/labs-rules.coax --library
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/json/json.coax";
#load "../../metaverse-engine/anim/cut-lines.coax";
#load "../../metaverse-engine/render/capture-profile.coax";

EXIT_MISSING :: 8;   // a program Labs needs is missing (Chrome, ffmpeg, the transcribe backend)

// ---- shots are a visitor's ------------------------------------------------------

// A shot sees what a visitor sees unless `realm shot SLUG --as-me`: that opens
// the profile's account's seat (POST /api/playtest/seats, coax/web/api/seats.c)
// and the page plays with the seat's own player key, so a private realm shows
// to its owner and site admins. A labs shot of any URL stays a visitor's.
LB_AS_ME :: "--as-me is for a made realm: openagents realm shot SLUG --as-me (a labs shot of a URL is a visitor's)";
#test "a shot's refusals say how to show a private realm: --as-me, or unlisted" {
  out: [300] u8;
  said := lb_private_shot("walled-garden", out[..]);
  #assert said == "walled-garden is private, and a shot is a visitor's: take it as its owner (openagents realm shot walled-garden --as-me, with this profile's key), or make it unlisted: openagents realm visibility walled-garden unlisted";
  #assert lb_private_shot("walled-garden", out[0..<20]) == "" && lb_private_shot("", out[..]) == "";
  #assert lb_has(LB_AS_ME, "realm shot SLUG --as-me");
}
lb_private_shot :: (slug: string, out: [] u8) -> string {
  if slug.count == 0 { return ""; }
  w: [1] LbW; w[0].buf = out;
  lbw_put(w[..], slug); lbw_put(w[..], " is private, and a shot is a visitor's: take it as its owner (openagents realm shot ");
  lbw_put(w[..], slug); lbw_put(w[..], " --as-me, with this profile's key), or make it unlisted: openagents realm visibility ");
  lbw_put(w[..], slug); lbw_put(w[..], " unlisted");
  return ifx w[0].full then "" else lbw_text(w[..]);
}

// ---- times: 1.5, 12, 1:26, 1:02:03.25 ---------------------------------------

// A time as seconds or m:ss or h:mm:ss (seconds may have a fraction): milliseconds, or -1.
lb_time :: (s: string) -> int {
  parts := 0; total := 0; start := 0;
  for i: 0..<s.count + 1 {
    if i < s.count && s[i] != ':' { continue; }
    piece := cast(string) s[start..<i];
    last := i == s.count;
    v := ifx last then lb_ms(piece) else args_whole(piece);
    if v < 0 || (parts > 0 && !last && v > 59) || (parts > 0 && last && v >= 60000) { return -1; }
    total = ifx last then total * 60000 + v else total * 60 + v;
    parts += 1; start = i + 1;
    if parts > 3 { return -1; }
  }
  if parts == 3 { total = total; }
  return total;
}
// A comma list of times into out: how many, or -1 (a bad time, or more than out holds).
lb_times :: (s: string, out: [] int) -> int {
  n := 0; start := 0;
  for i: 0..<s.count + 1 {
    if i < s.count && s[i] != ',' { continue; }
    t := lb_time(cast(string) s[start..<i]);
    if t < 0 || n >= out.count { return -1; }
    out[n] = t; n += 1; start = i + 1;
  }
  return n;
}

#test "times" {
  #assert lb_ms("1.5") == 1500 && lb_ms("12") == 12000 && lb_ms("0.0005") == 1 && lb_ms("") == -1 && lb_ms("-1") == -1 && lb_ms("1e3") == -1 && lb_ms("x") == -1;
  #assert lb_time("1:26") == 86000 && lb_time("1.5") == 1500 && lb_time("1:02:03.25") == 3723250 && lb_time("0:59.5") == 59500;
  #assert lb_time("1:60") == -1 && lb_time("1:75:00") == -1 && lb_time("") == -1 && lb_time("1::2") == -1 && lb_time("1:2:3:4") == -1;
  t: [4] int;
  #assert lb_times("1.5,12,1:26", t[..]) == 3 && t[0] == 1500 && t[1] == 12000 && t[2] == 86000;
  #assert lb_times("1,2,3,4,5", t[..]) == -1 && lb_times("1,,2", t[..]) == -1 && lb_times("7", t[..]) == 1 && t[0] == 7000;
}

// ---- where: a URL from a URL or a path ---------------------------------------

lb_is_url :: (s: string) -> bool { return lb_starts(s, "https://") || lb_starts(s, "http://") || lb_starts(s, "file://"); }
// target as it is when it is a URL; a path (/realms/x) joined to origin; "" otherwise.
lb_url :: (origin: string, target: string, out: [] u8) -> string {
  w: [1] LbW; w[0].buf = out;
  if lb_is_url(target) { lbw_put(w[..], target); }
  else if target.count > 0 && target[0] == '/' && lb_is_url(origin) {
    o := origin;
    while o.count > 0 && o[o.count - 1] == '/' { o = cast(string) o[0..<o.count - 1]; }
    lbw_put(w[..], o); lbw_put(w[..], target);
  } else { return ""; }
  for c: lbw_text(w[..]) { if c <= ' ' || c == 127 { return ""; } }
  return ifx w[0].full then "" else lbw_text(w[..]);
}
#test "capture fingerprints remove only the inline take query payload" {
  b: [256] u8;
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?take64=ABCD&t=2&card=1#keep",b[..]) == "https://o/realms/anime-lab?t=2&card=1#keep";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?card=1&take64=ABCD&t=2",b[..]) == "https://o/realms/anime-lab?card=1&t=2";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab/?take64=ABCD",b[..]) == "https://o/realms/anime-lab/";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?take64=&take64=more#x",b[..]) == "https://o/realms/anime-lab#x";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?x=take64&take64x=v",b[..]) == "https://o/realms/anime-lab?x=take64&take64x=v";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab#frag?take64=x",b[..]) == "https://o/realms/anime-lab#frag?take64=x";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab",b[..]) == "https://o/realms/anime-lab";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?a=1&",b[..]) == "https://o/realms/anime-lab?a=1&";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?take64=x&a=1&",b[..]) == "https://o/realms/anime-lab?a=1&";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab?",b[..]) == "https://o/realms/anime-lab?";
  #assert lb_page_fingerprint_url("https://o/other?take64=x&t=2",b[..]) == "https://o/other?take64=x&t=2";
  #assert lb_page_fingerprint_url("https://o/realms/anime-lab-extra?take64=x",b[..]) == "https://o/realms/anime-lab-extra?take64=x";
  tiny: [4] u8; #assert lb_page_fingerprint_url("https://o/realms/anime-lab?take64=x",tiny[..]) == "";
}
// The take is decoded in the page, not in its HTML response. Fingerprint the
// served page without these potentially large bytes; the complete URL still
// participates in the capture input digest and output label.
lb_page_fingerprint_url :: (url: string, out: [] u8) -> string {
  end := url.count; query_at := -1;
  for i: 0..<url.count {
    if url[i] == '#' { end = i; break; }
    if url[i] == '?' && query_at < 0 { query_at = i; }
  }
  w: [1] LbW; w[0].buf = out;
  fingerprint_scheme := ifx lb_starts(url,"https://") then 8 else ifx lb_starts(url,"http://") then 7 else 0;
  fingerprint_path_at := fingerprint_scheme;
  while fingerprint_path_at < end && url[fingerprint_path_at] != '/' && url[fingerprint_path_at] != '?' { fingerprint_path_at += 1; }
  fingerprint_path_to := ifx query_at < 0 then end else query_at;
  fingerprint_anime := fingerprint_scheme > 0 && fingerprint_path_at < fingerprint_path_to
    && (url[fingerprint_path_at..<fingerprint_path_to] == "/realms/anime-lab" || url[fingerprint_path_at..<fingerprint_path_to] == "/realms/anime-lab/");
  if query_at < 0 || !fingerprint_anime {
    lbw_put(w[..],url); return ifx w[0].full then "" else lbw_text(w[..]);
  }
  lbw_put(w[..],url[0..<query_at]);
  at := query_at + 1; kept := false; removed := false;
  while at <= end {
    stop := at; while stop < end && url[stop] != '&' { stop += 1; }
    part := url[at..<stop];
    if part != "take64" && !lb_starts(part,"take64=") {
      lbw_byte(w[..],ifx kept then '&' else '?'); lbw_put(w[..],part); kept = true;
    } else { removed = true; }
    at = stop + 1;
  }
  lbw_put(w[..],url[end..<url.count]);
  if !removed { w[0].n = 0; w[0].full = false; lbw_put(w[..],url); }
  return ifx w[0].full then "" else lbw_text(w[..]);
}

// A stage name is 1 to 32 of a-z, 0-9, - and _.
lb_stage_ok :: (s: string) -> bool {
  if s.count < 1 || s.count > 32 { return false; }
  for c: s { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_') { return false; } }
  return true;
}
// url with ?stage=NAME&card=1 (or &stage=... when it has a query), before any #fragment.
lb_with_stage :: (url: string, stage: string, out: [] u8) -> string {
  hash := url.count;
  for i: 0..<url.count { if url[i] == '#' && hash == url.count { hash = i; } }
  q := false;
  for i: 0..<hash { if url[i] == '?' { q = true; } }
  w: [1] LbW; w[0].buf = out;
  lbw_put(w[..], cast(string) url[0..<hash]);
  lbw_put(w[..], ifx q then "&stage=" else "?stage="); lbw_put(w[..], stage); lbw_put(w[..], "&card=1");
  lbw_put(w[..], cast(string) url[hash..<url.count]);
  return ifx w[0].full then "" else lbw_text(w[..]);
}

#test "where a page is" {
  b: [256] u8;
  #assert lb_url("https://openagents.com", "/realms/orbit-league?stage=highlight", b[..]) == "https://openagents.com/realms/orbit-league?stage=highlight";
  #assert lb_url("https://openagents.com/", "/", b[..]) == "https://openagents.com/";
  #assert lb_url("https://openagents.com", "http://127.0.0.1:8800/x", b[..]) == "http://127.0.0.1:8800/x";
  #assert lb_url("https://openagents.com", "realms/x", b[..]) == "" && lb_url("", "/x", b[..]) == "" && lb_url("https://a", "/a b", b[..]) == "";
  #assert lb_with_stage("https://o.com/realms/belt", "highlight", b[..]) == "https://o.com/realms/belt?stage=highlight&card=1";
  #assert lb_with_stage("https://o.com/r?x=1#top", "a", b[..]) == "https://o.com/r?x=1&stage=a&card=1#top";
  #assert lb_stage_ok("highlight") && lb_stage_ok("a_b-2") && !lb_stage_ok("") && !lb_stage_ok("Hi") && !lb_stage_ok("a&b");
}

// ---- sizes and qualities -----------------------------------------------------

LB_DESKTOP :: ArgsSize.{ok = true, w = 1440, h = 900};
LB_PHONE :: ArgsSize.{ok = true, w = 390, h = 844};
LB_SQUARE :: ArgsSize.{ok = true, w = 1080, h = 1080};
LB_VERTICAL :: ArgsSize.{ok = true, w = 1080, h = 1920};
// The size from --size or one preset flag (at most one), else fallback; ok false when two are given or --size is bad.
lb_size :: (size: string, phone: bool, square: bool, vertical: bool, fallback: ArgsSize) -> ArgsSize {
  bad: ArgsSize;
  n := 0;
  if size.count > 0 { n += 1; } if phone { n += 1; } if square { n += 1; } if vertical { n += 1; }
  if n > 1 { return bad; }
  if phone { return LB_PHONE; }
  if square { return LB_SQUARE; }
  if vertical { return LB_VERTICAL; }
  if size.count == 0 { return fallback; }
  s := args_size(size);
  if !s.ok || s.w < 16 || s.h < 16 || s.w > 7680 || s.h > 7680 { return bad; }
  return s;
}
// A board's size word: desktop, phone, square, vertical or WxH.
lb_size_word :: (word: string) -> ArgsSize {
  if word == "desktop" { return LB_DESKTOP; }
  if word == "phone" { return LB_PHONE; }
  if word == "square" { return LB_SQUARE; }
  if word == "vertical" { return LB_VERTICAL; }
  return lb_size(word, false, false, false, LB_DESKTOP);
}

LB_PREVIEW :: 0; LB_REVIEW :: 1; LB_MASTER :: 2;
lb_quality :: (s: string) -> int {
  if s == "preview" { return LB_PREVIEW; }
  if s == "review" || s == "" { return LB_REVIEW; }
  if s == "master" { return LB_MASTER; }
  return -1;
}
// The size a quality renders at: preview is a quarter of the area (half each side, even).
lb_quality_size :: (q: int, w: int, h: int) -> ArgsSize {
  if q != LB_PREVIEW { return ArgsSize.{ok = true, w = w, h = h}; }
  return ArgsSize.{ok = true, w = (w / 2) / 2 * 2, h = (h / 2) / 2 * 2};
}

#test "sizes and qualities" {
  d := lb_size("", false, false, false, LB_DESKTOP);
  #assert d.ok && d.w == 1440 && d.h == 900;
  p := lb_size("", true, false, false, LB_DESKTOP);
  #assert p.w == 390 && p.h == 844 && lb_size("", false, true, false, LB_DESKTOP).h == 1080 && lb_size("", false, false, true, LB_DESKTOP).h == 1920;
  #assert lb_size("1280x720", false, false, false, LB_DESKTOP).w == 1280 && !lb_size("1280x720", true, false, false, LB_DESKTOP).ok;
  #assert !lb_size("8x8", false, false, false, LB_DESKTOP).ok && !lb_size("9000x10", false, false, false, LB_DESKTOP).ok && !lb_size("big", false, false, false, LB_DESKTOP).ok;
  #assert lb_size_word("phone").w == 390 && lb_size_word("desktop").w == 1440 && lb_size_word("800x600").h == 600 && !lb_size_word("tablet").ok;
  #assert lb_quality("preview") == LB_PREVIEW && lb_quality("") == LB_REVIEW && lb_quality("master") == LB_MASTER && lb_quality("best") == -1;
  q := lb_quality_size(LB_PREVIEW, 1920, 1080);
  #assert q.w == 960 && q.h == 540 && lb_quality_size(LB_PREVIEW, 1366, 770).w == 682 && lb_quality_size(LB_REVIEW, 1366, 770).w == 1366;
}

// ---- programs Labs needs -----------------------------------------------------

// The one command that installs a program, by system (tool_os: TOOL_MAC or not).
lb_install :: (program: string, mac: bool) -> string {
  if program == "chrome" { return ifx mac then "install Google Chrome from https://www.google.com/chrome/, or set CHROME" else "install Chromium (nix profile install nixpkgs#chromium, or apt install chromium), or set CHROME"; }
  if program == "ffmpeg" { return ifx mac then "brew install ffmpeg" else "nix profile install nixpkgs#ffmpeg, or apt install ffmpeg"; }
  if program == "whisper-cli" { return ifx mac then "brew install whisper-cpp" else "nix profile install nixpkgs#whisper-cpp"; }
  return "";
}
lb_missing_text :: (program: string, mac: bool, out: [] u8) -> string {
  w: [1] LbW; w[0].buf = out;
  lbw_put(w[..], ifx program == "chrome" then "Chrome" else program);
  lbw_put(w[..], " was not found: "); lbw_put(w[..], lb_install(program, mac));
  return lbw_text(w[..]);
}

#test "missing programs name their install command" {
  b: [256] u8;
  #assert lb_missing_text("ffmpeg", true, b[..]) == "ffmpeg was not found: brew install ffmpeg";
  #assert lb_missing_text("chrome", true, b[..]) == "Chrome was not found: install Google Chrome from https://www.google.com/chrome/, or set CHROME";
  #assert lb_has(lb_missing_text("ffmpeg", false, b[..]), "nixpkgs#ffmpeg") && lb_install("whisper-cli", true) == "brew install whisper-cpp" && lb_install("x", true) == "";
}

// ---- the .board format ---------------------------------------------------------
//   board NAME...        base URL        sizes desktop phone|WxH...        themes light dark
//   page PATH NAME [wait=MS]

LB_PAGES :: 128;
LbPage :: struct { line: int; path: LbSpan; name: LbSpan; wait: int = 4000; }
LbBoard :: struct {
  pool: [1] LbPool;
  name: LbSpan; base: LbSpan;
  sizes: [4] ArgsSize; size_words: [4] LbSpan; size_n: int;
  dark: [2] bool; theme_n: int;
  pages: [LB_PAGES] LbPage; page_n: int;
  problems: [1] LbProblems;
}
lb_board_problem :: (b: [] LbBoard, line: int, a: string, c: string, d: string) { lb_problem(b[0].problems[..], b[0].pool[..], line, a, c, d); }
lb_board_line :: (b: [] LbBoard, line: string, at: int) {
  w := lb_words(line);
  if w.bad { lb_board_problem(b, at, "a quote is not closed, or the line has more than 32 words", "", ""); return; }
  if w.n == 0 || lb_word(line, w, 0)[0] == '#' { return; }
  head := lb_word(line, w, 0);
  if head == "board" { b[0].name = lb_add(b[0].pool[..], ifx w.n > 1 then cast(string) line[w.at[1]..<w.to[w.n - 1]] else ""); return; }
  if head == "base" {
    u := lb_word(line, w, 1);
    if w.n != 2 || !(lb_starts(u, "https://") || lb_starts(u, "http://")) { lb_board_problem(b, at, "base is one URL: base https://openagents.com", "", ""); return; }
    b[0].base = lb_add(b[0].pool[..], u); return;
  }
  if head == "sizes" {
    b[0].size_n = 0;
    for k: 1..<w.n {
      s := lb_size_word(lb_word(line, w, k));
      if !s.ok { lb_board_problem(b, at, "a size is desktop, phone, square, vertical or WxH, not ", lb_word(line, w, k), ""); continue; }
      if b[0].size_n >= 4 { lb_board_problem(b, at, "a board has at most 4 sizes", "", ""); break; }
      b[0].sizes[b[0].size_n] = s; b[0].size_words[b[0].size_n] = lb_add(b[0].pool[..], lb_word(line, w, k)); b[0].size_n += 1;
    }
    return;
  }
  if head == "themes" {
    b[0].theme_n = 0;
    for k: 1..<w.n {
      t := lb_word(line, w, k);
      if t != "light" && t != "dark" { lb_board_problem(b, at, "a theme is light or dark, not ", t, ""); continue; }
      if b[0].theme_n >= 2 { lb_board_problem(b, at, "a board has at most 2 themes", "", ""); break; }
      b[0].dark[b[0].theme_n] = t == "dark"; b[0].theme_n += 1;
    }
    return;
  }
  if head == "page" {
    if b[0].page_n >= LB_PAGES { lb_board_problem(b, at, "a board has at most 128 pages", "", ""); return; }
    path := lb_word(line, w, 1); name := lb_word(line, w, 2);
    if w.n < 3 || path.count == 0 || !(path[0] == '/' || lb_is_url(path)) || lb_pair(name).has { lb_board_problem(b, at, "a page line is: page /PATH NAME [wait=MS]", "", ""); return; }
    p: LbPage; p.line = at; p.path = lb_add(b[0].pool[..], path); p.name = lb_add(b[0].pool[..], name);
    for k: 3..<w.n {
      q := lb_pair(lb_word(line, w, k));
      ms := args_whole(q.value);
      if q.name != "wait" || !q.has { lb_board_problem(b, at, "unknown word ", q.name, " (a page takes wait=)"); continue; }
      if ms < 0 || ms > 120000 { lb_board_problem(b, at, "wait is milliseconds from 0 to 120000", "", ""); continue; }
      p.wait = ms;
    }
    b[0].pages[b[0].page_n] = p; b[0].page_n += 1;
    return;
  }
  lb_board_problem(b, at, "unknown word ", head, " (a line starts with board, base, sizes, themes or page)");
}
lb_board_parse :: (b: [] LbBoard, text: string) {
  start := 0; line := 1;
  for i: 0..<text.count + 1 {
    if i < text.count && text[i] != '\n' { continue; }
    l := cast(string) text[start..<i];
    if l.count > 0 && l[l.count - 1] == '\r' { l = cast(string) l[0..<l.count - 1]; }
    lb_board_line(b, l, line);
    start = i + 1; line += 1;
  }
  if b[0].size_n == 0 { b[0].sizes[0] = LB_DESKTOP; b[0].size_words[0] = lb_add(b[0].pool[..], "desktop"); b[0].size_n = 1; }
  if b[0].theme_n == 0 { b[0].theme_n = 1; }
  if b[0].page_n == 0 && b[0].problems[0].n == 0 { lb_board_problem(b, 0, "the board has no pages", "", ""); }
  for i: 0..<b[0].page_n {
    if lb_sp(b[0].pool[..], b[0].pages[i].path)[0] == '/' && b[0].base.n == 0 { lb_board_problem(b, b[0].pages[i].line, "a page by path needs a base line (base https://openagents.com) or --origin", "", ""); break; }
  }
}

#test "a .board file reads, and its refusals" {
  b: [1] LbBoard; t: [4096] u8;
  lb_board_parse(b[..], "board OPENAGENTS WEB\nbase https://openagents.com\nsizes desktop phone\nthemes light dark\npage /                 HOME\npage /realms           REALMS\npage /realms/everglade EVERGLADE wait=9000\n");
  #assert b[0].problems[0].n == 0 && lb_sp(b[0].pool[..], b[0].name) == "OPENAGENTS WEB" && lb_sp(b[0].pool[..], b[0].base) == "https://openagents.com";
  #assert b[0].size_n == 2 && b[0].sizes[1].w == 390 && lb_sp(b[0].pool[..], b[0].size_words[1]) == "phone" && b[0].theme_n == 2 && !b[0].dark[0] && b[0].dark[1];
  #assert b[0].page_n == 3 && lb_sp(b[0].pool[..], b[0].pages[2].name) == "EVERGLADE" && b[0].pages[2].wait == 9000 && b[0].pages[0].wait == 4000;
  d: [1] LbBoard;
  lb_board_parse(d[..], "page https://example.com/ EX\n");
  #assert d[0].problems[0].n == 0 && d[0].size_n == 1 && d[0].sizes[0].w == 1440 && d[0].theme_n == 1 && !d[0].dark[0];
  e: [1] LbBoard;
  lb_board_parse(e[..], "base openagents.com\nsizes tablet\nthemes sepia\npage realms R\npage /x X wait=-1 zoom=2\nwhat\npage /y Y\n");
  s := lb_problems_text(e[0].problems[..], e[0].pool[..], t[..]);
  #assert lb_has(s, "1 base is one URL: base https://openagents.com\n") && lb_has(s, "2 a size is desktop, phone, square, vertical or WxH, not tablet\n");
  #assert lb_has(s, "3 a theme is light or dark, not sepia\n") && lb_has(s, "4 a page line is: page /PATH NAME [wait=MS]\n");
  #assert lb_has(s, "5 wait is milliseconds from 0 to 120000\n") && lb_has(s, "5 unknown word zoom (a page takes wait=)\n");
  #assert lb_has(s, "6 unknown word what (a line starts with board, base, sizes, themes or page)\n");
  #assert lb_has(s, "5 a page by path needs a base line (base https://openagents.com) or --origin\n");
  z: [1] LbBoard;
  lb_board_parse(z[..], "board EMPTY\n");
  #assert lb_problems_text(z[0].problems[..], z[0].pool[..], t[..]) == "0 the board has no pages\n";
}

// ---- playtest: the bot's runs and their summary --------------------------------

LB_ESCAPED :: 1; LB_MELTED :: 2; LB_SCOOPED :: 3;   // a run's end, as Ice Cream Man's Status; 0 is a timeout
LbRun :: struct { seed: int; end: int; ms: int; keys: int; hits: int; spotted: int; }
LbSummary :: struct { runs: int; won: int; escaped: int; melted: int; lost: int; timeout: int; median_ms: int = -1; keys_x10: int; hits_x10: int; spotted_x10: int; }
lb_end_word :: (end: int) -> string {
  if end == LB_ESCAPED { return "won"; }
  if end == LB_MELTED { return "won"; }
  if end == LB_SCOOPED { return "lost"; }
  return "timeout";
}
lb_end_how :: (end: int) -> string {
  if end == LB_ESCAPED { return "escaped"; }
  if end == LB_MELTED { return "melted"; }
  if end == LB_SCOOPED { return "scooped"; }
  return "timeout";
}
// Tenths, rounded: the average of total over n.
lb_tenths :: (total: int, n: int) -> int { return ifx n <= 0 then 0 else (total * 10 + n / 2) / n; }
lb_tenths_text :: (x10: int, out: [] u8) -> string { w: [1] LbW; w[0].buf = out; lbw_int(w[..], x10 / 10); lbw_byte(w[..], '.'); lbw_int(w[..], x10 % 10); return lbw_text(w[..]); }
// Won is escaped or melted (Game Lab's wins); the median is of the won runs' times, the middle one (upper middle for an even count).
lb_summary :: (runs: [] LbRun) -> LbSummary {
  s: LbSummary; s.runs = runs.count;
  won: [1024] int; wn := 0; keys := 0; hits := 0; spotted := 0;
  for r: runs {
    if r.end == LB_ESCAPED { s.escaped += 1; } else if r.end == LB_MELTED { s.melted += 1; } else if r.end == LB_SCOOPED { s.lost += 1; } else { s.timeout += 1; }
    if (r.end == LB_ESCAPED || r.end == LB_MELTED) && wn < won.count { won[wn] = r.ms; wn += 1; }
    keys += r.keys; hits += r.hits; spotted += r.spotted;
  }
  s.won = s.escaped + s.melted;
  // sort the won times (insertion; at most 1024)
  for i: 1..<wn { v := won[i]; j := i - 1; while j >= 0 && won[j] > v { won[j + 1] = won[j]; j -= 1; } won[j + 1] = v; }
  if wn > 0 { s.median_ms = won[wn / 2]; }
  s.keys_x10 = lb_tenths(keys, runs.count); s.hits_x10 = lb_tenths(hits, runs.count); s.spotted_x10 = lb_tenths(spotted, runs.count);
  return s;
}

#test "the playtest summary" {
  runs := [5] LbRun.[LbRun.{seed = 0, end = LB_ESCAPED, ms = 90000, keys = 3, hits = 1, spotted = 2},
                     LbRun.{seed = 1, end = LB_SCOOPED, ms = 40000, keys = 1, hits = 9, spotted = 5},
                     LbRun.{seed = 2, end = LB_ESCAPED, ms = 150000, keys = 3},
                     LbRun.{seed = 3, end = LB_MELTED, ms = 60000, keys = 3, hits = 2},
                     LbRun.{seed = 4, end = 0, ms = 600000, keys = 2}];
  s := lb_summary(runs[..]);
  #assert s.runs == 5 && s.won == 3 && s.escaped == 2 && s.melted == 1 && s.lost == 1 && s.timeout == 1;
  #assert s.median_ms == 90000 && s.keys_x10 == 24 && s.hits_x10 == 24 && s.spotted_x10 == 14;
  #assert lb_summary(runs[0..<2]).median_ms == 90000 && lb_summary(runs[1..<2]).median_ms == -1 && lb_summary(runs[0..<0]).keys_x10 == 0;
  b: [16] u8;
  #assert lb_tenths_text(24, b[..]) == "2.4" && lb_tenths_text(0, b[..]) == "0.0" && lb_tenths_text(105, b[..]) == "10.5";
  #assert lb_end_word(LB_MELTED) == "won" && lb_end_word(LB_SCOOPED) == "lost" && lb_end_word(0) == "timeout" && lb_end_how(LB_MELTED) == "melted";
}

// ---- two labels, or two playtest summaries: what differs ------------------------

// One "KEY A → B" line per top-level key whose JSON differs between a and b
// (a key only one has shows as -), skipping skip (a space-separated list).
lb_diff :: (a: string, b: string, skip: string, w: [] LbW, na: [] JvNode, nb: [] JvNode) -> int {
  da: [1] Jv; db: [1] Jv;
  if !jv_parse(da[..], a, na) || !jv_parse(db[..], b, nb) || jv_kind(da[0], 0) != JV_OBJECT || jv_kind(db[0], 0) != JV_OBJECT { return -1; }
  n := 0;
  for pass: 0..<2 {
    x := ifx pass == 0 then da[0] else db[0]; y := ifx pass == 0 then db[0] else da[0];
    k := x.nodes[0].first;
    while k >= 0 {
      raw := jv_key(x, k);
      key := ifx raw.count >= 2 && raw[0] == '"' then cast(string) raw[1..<raw.count - 1] else raw;
      other := jv_get(y, 0, key);
      skipped := lb_word_in(skip, key);
      if !skipped && (pass == 0 || other < 0) {
        va := ifx pass == 0 then jv_raw(x, k) else "-";
        vb := ifx pass == 0 then (ifx other >= 0 then jv_raw(y, other) else "-") else jv_raw(x, k);
        if va != vb {
          lbw_put(w, key); lbw_byte(w, ' '); lbw_put(w, lb_unquote(va)); lbw_put(w, " → "); lbw_put(w, lb_unquote(vb)); lbw_byte(w, '\n');
          n += 1;
        }
      }
      k = x.nodes[k].next;
    }
  }
  return n;
}
lb_unquote :: (raw: string) -> string { return ifx raw.count >= 2 && raw[0] == '"' && raw[raw.count - 1] == '"' then cast(string) raw[1..<raw.count - 1] else raw; }
lb_word_in :: (list: string, word: string) -> bool {
  start := 0;
  for i: 0..<list.count + 1 {
    if i < list.count && list[i] != ' ' { continue; }
    if cast(string) list[start..<i] == word && word.count > 0 { return true; }
    start = i + 1;
  }
  return false;
}

#test "what differs between two labels" {
  na: [256] JvNode; nb: [256] JvNode; t: [1024] u8;
  w: [1] LbW; w[0].buf = t[..];
  a := "{\"kind\":\"shot\",\"url\":\"https://o.com/\",\"size\":\"1440x900\",\"made\":\"x\",\"build\":\"newland.1\"}";
  b := "{\"kind\":\"shot\",\"url\":\"https://o.com/\",\"size\":\"390x844\",\"made\":\"y\",\"dark\":true}";
  #assert lb_diff(a, b, "made", w[..], na[..], nb[..]) == 3;
  #assert lbw_text(w[..]) == "size 1440x900 → 390x844\nbuild newland.1 → -\ndark - → true\n";
  w[0].n = 0;
  #assert lb_diff(a, a, "", w[..], na[..], nb[..]) == 0 && lb_diff("[1]", a, "", w[..], na[..], nb[..]) == -1;
  #assert lb_word_in("made output", "output") && !lb_word_in("made output", "put") && !lb_word_in("", "");
}


// ==== Ice Cream Man, headless ===================================================

// Ice Cream Man played headless: the bot plays a seeded house to its end
// with no window, as Game Lab measured a tuning (24 houses, 600 seconds
// each, the Ice Cream Man in). The CLI's `openagents labs playtest icecream`
// runs it (ice_run below); verse/icecream/replay.c steps the same rules natively.
#load "../../verse/icecream/rules.coax";

ICE_RUNS :: 24;         // the houses Game Lab measured a tuning on
ICE_LIMIT_S :: 600;     // the longest a bot run lasts, seconds

// One run's end (Status: 0 still playing at the limit, 1 escaped, 2 melted
// him, 3 scooped), its game time, and what happened on the way.
IceRun :: struct { end: int; ms: int; keys: int; hits: int; spotted: int; fingerprint: u64; }

// The bot plays seed's house with tuning t until the run ends or limit_s
// seconds of game time pass.
ice_run :: (g: [] Game, b: [] Bot, seed: u64, t: Tuning, limit_s: int) -> IceRun {
  r: IceRun;
  game_new(g, seed, true, t);
  fresh: Bot; b[0] = fresh;
  for i: 0..<limit_s * HZ {
    game_step(g, bot_input(g, b));
    for k: 0..<g[0].event_n { if g[0].events[k].kind == EventKind.spotted { r.spotted += 1; } }
    if g[0].status != Status.playing { break; }
  }
  r.end = cast(int) g[0].status;
  r.ms = cast(int) (g[0].tick * 1000 / cast(u64) HZ);
  r.keys = cast(int) g[0].player.keys;
  r.hits = cast(int) g[0].stats.hits_taken;
  r.fingerprint = fingerprint(g);
  return r;
}

// The tunable at index (in TUNABLE_BOUNDS), as tuning_put sets it.
tuning_get :: (t: Tuning, index: int) -> f64 {
  if index == 0 { return cast(f64) t.walk; }
  else if index == 1 { return cast(f64) t.sprint; }
  else if index == 2 { return cast(f64) t.jump_speed; }
  else if index == 3 { return cast(f64) t.gravity; }
  else if index == 4 { return cast(f64) t.max_health; }
  else if index == 5 { return cast(f64) t.regen_after; }
  else if index == 6 { return cast(f64) t.regen_rate; }
  else if index == 7 { return cast(f64) t.man_wander; }
  else if index == 8 { return cast(f64) t.man_investigate; }
  else if index == 9 { return cast(f64) t.man_search; }
