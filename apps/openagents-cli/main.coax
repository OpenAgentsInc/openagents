// openagents: the OpenAgents command line, v1.0.0-dev
// (docs/cli/2026-11-01-openagents-cli-v1.md). One Coax program on the C tool
// host; cli-native.c does the platform effects (Keychain, 0600 files, stdin,
// the clock), and every decision is in the Coax files or rules.coax.
//
//   apps/openagents-cli/build.sh            builds apps/openagents-cli/build/openagents
//   openagents help
//
// This file is the dispatch. Each domain has its own file, so domains change
// apart: out.coax (the report, arguments, paths), nostr.coax (your NIP-06
// identity, signing, NIP-98, publish and req), relay.coax (the relay client),
// pylon.coax (start, stop, status, logs, around scripts/join-pylon.sh), and
// project.coax (the project queue: list, show, plan, claim, note, done,
// publish; with project-rules.coax, project-write.coax, project-publish.coax
// and project-review.coax).
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/nostr/nip06.coax";
#load "../../coax/lib/nostr/event_sign.coax";
#load "../../coax/lib/nostr/base64.coax";
#load "rules.coax";
#load "out.coax";
#load "relay.coax";
#load "nostr.coax";
#load "pylon.coax";
#load "account.coax";
#load "project.coax";

CLI_VERSION :: "1.0.0-dev";

cxcli_now_s :: () -> int #foreign;
cxcli_hostname :: (out: [] u8) -> int #foreign;
cxcli_isatty :: (fd: int) -> int #foreign;
cxcli_read_line :: (out: [] u8, hide: int) -> int #foreign;
cxcli_read_stdin :: (out: [] u8) -> int #foreign;
cxcli_mkdir_private :: (path: [] u8) -> int #foreign;
cxcli_write_private :: (path: [] u8, data: [] u8) -> int #foreign;
cxcli_alive :: (pid: int) -> int #foreign;
cxcli_exe_path :: (out: [] u8) -> int #foreign;
cxcli_keychain_set :: (account: [] u8, secret: [] u8) -> int #foreign;
cxcli_keychain_get :: (account: [] u8, out: [] u8) -> int #foreign;
cxcli_keychain_remove :: (account: [] u8) -> int #foreign;
// cxrand_draw comes from coax/lib/net/relay_conn.coax (loaded by relay.coax).

usage :: () {
  print("%\n", "openagents 1.0.0-dev: the OpenAgents command line");
  print("%\n", "");
  print("%\n", "Usage: openagents [--json] [--profile NAME] DOMAIN VERB [ARGS]");
  print("%\n", "");
  nostr_usage();
  pylon_usage();
  project_usage();
  account_usage();
  print("%\n", "Other:");
  print("%\n", "  version, help");
  print("%\n", "");
  print("%\n", "Every command takes --json. Keys are kept in ~/.openagents/cli/keys/PROFILE, mode 0600.");
  print("%\n", "OPENAGENTS_KEYCHAIN=1 uses the macOS Keychain instead (it asks for your password after each rebuild).");
  print("%\n", "OPENAGENTS_NSEC=nsec1... uses that key for one run and stores nothing.");
  print("%\n", "Exit codes: 0 done, 1 failed, 2 usage, 3 no identity or key, 5 conflict, 6 not found.");
}


// ---- dispatch -----------------------------------------------------------------

tool_main :: () -> int #export_c {
  a: [1] Args; r: [1] Rep;
  if !args_load(a[..]) { tool_errln("openagents: arguments too long"); return EXIT_USAGE; }
  r[0].json = args_has(a[..], "--json");
  profile := args_value(a[..], "--profile", "");
  env: [64] u8;
  if profile == "" { profile = proc_getenv("OPENAGENTS_PROFILE", env[..]); }
  if profile == "" { profile = "default"; }
  if !cli_profile_ok(profile) { return fail(r[..], EXIT_USAGE, "--profile is 1 to 32 of a-z, 0-9, - and _"); }
  domain := positional(a[..], 0);
  verb := positional(a[..], 1);
  if domain == "" || domain == "help" || args_has(a[..], "--help") || domain == "-h" { usage(); return ifx domain == "" && !args_has(a[..], "--help") then EXIT_USAGE else EXIT_OK; }
  if domain == "version" { rep_str(r[..], "openagents", CLI_VERSION); return rep_done(r[..], EXIT_OK); }
  // Account: login, logout, whoami, account keys, access (account.coax).
  if domain == "login" { return cli_login(a[..], r[..], profile); }
  if domain == "logout" { return cli_logout(a[..], r[..], profile); }
  if domain == "whoami" { return cli_whoami(a[..], r[..], profile, false); }
  if domain == "account" { return ifx verb == "keys" then cli_whoami(a[..], r[..], profile, true) else fail(r[..], EXIT_USAGE, "account keys"); }
  if domain == "access" { return cli_access(a[..], r[..], profile, verb); }
  // One line per domain; each domain file dispatches its own verbs.
  if domain == "nostr" { return nostr_main(a[..], r[..], profile, verb); }
  if domain == "pylon" { return pylon_main(a[..], r[..], profile, verb); }
  if domain == "http" { return cli_http(a[..], r[..]); }   // hidden: one request through coax/lib/net/http.coax
  if domain == "project" { return project_main(a[..], r[..], verb); }
  return fail(r[..], EXIT_USAGE, "unknown command (openagents help)");
}
