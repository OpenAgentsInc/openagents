// Explicit local Parakeet selection. Reject options the TDT engine does not
// implement; a request must never silently run Whisper or force a language.
#authority;

#test "Parakeet admits text or JSON and an explicitly named device" {
  for format: [2]int.[0,3] { for device: [2]string.["gpu","cpu"] {
    #assert tr_pk_options(format,"auto","","",device)==0;
    #assert tr_pk_options(format,"","","",device)==0;
  }}
}
#test "Parakeet refuses every unsupported format before model effects" {
  for format: [5]int.[-1,1,2,4,99] { #assert tr_pk_options(format,"auto","","","gpu")==1; }
}
#test "Parakeet cannot pretend to honor language hints or Whisper bias" {
  for language: [4]string.["en","de","AUTO","fr"] { #assert tr_pk_options(0,language,"","","gpu")==2; }
  #assert tr_pk_options(0,"auto","hint","","gpu")==3;
  #assert tr_pk_options(0,"auto","","Coax","gpu")==3;
  #assert tr_pk_options(0,"auto","hint","Coax","gpu")==3;
}
#test "Parakeet never substitutes a device or backend" {
  for device: [4]string.["","metal","cuda","GPU"] { #assert tr_pk_options(0,"auto","","",device)==4; }
}

// 0 supported; 1 format; 2 forced language; 3 bias; 4 device.
tr_pk_options :: (format:int,language:string,prompt:string,words:string,device:string)->int {
  if format!=0 && format!=3 { return 1; }
  if language!="" && language!="auto" { return 2; }
  if prompt!="" || words!="" { return 3; }
  if device!="gpu" && device!="cpu" { return 4; }
  return 0;
}
