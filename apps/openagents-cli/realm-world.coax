// The realm commands that edit a world with an ID (GitHub #13415, the browser editor's E6;
// docs/protocol/world-edit-v1.md). They are rows of REALM_COMMANDS like every other realm command
// (route "world"), so the CLI, the realm_* MCP tools and `coax drive` all take them from one table.
// Each turns its bounded arguments into world.edit.v1 (metaverse-engine/editor/world-edit.coax),
// sends it to /api/worlds/ID made from the revision it read, and answers one result
// (metaverse-engine/editor/op-result.coax, realm.result.v1): done with the new revision, a dry run
// with its level, or a refusal in words with its code.
//   realm world ID                       the world as an agent needs it to aim an edit
//   realm world-place ID KIND X Z        a spawn; KIND is a content ID from `realm world`
//   realm world-move ID N X Z, world-turn ID N DEG, world-set ID N COLUMN VALUE, world-remove ID N
//   realm world-undo ID, world-redo ID, world-original ID
//   realm world-apply ID FILE            edits as JSON lines, one batch: all are saved or none
//   realm world-publish ID now|next --yes
//   realm world-why ID THING             why a thing isn't seen, reached or working (the page's own answer)
//   realm world-open ID                  the page that edits it
//   realm world-foes ID                  the actors and their plans by time of day (#13466)
//   realm world-plan ID FOE WHEN DO, world-route ID FOE WHEN "X Z, X Z", world-time ID WHEN
//                                        an actor's plan, its route, the editor's time of day: each a
//                                        cell edit of the world's plans or clock table (one undo step;
//                                        metaverse-engine/ai/npc-plan.coax holds what a plan takes)
//   realm world-board ID on|off [--casual CM/S] [--fast CM/S]
//                                        the player's hoverboard and its two speeds: a cell edit of the
//                                        world's board table (metaverse-engine/action/hoverboard.coax, #13485)
//   realm world-scripts ID               the world's stored scripts and the store's limits (#13467)
//   realm world-script-compile ID FILE.coax --name NAME, world-script-put ID FILE.wasm --name NAME
//                                        store a script: its source compiled by the server, or a built module
//   realm world-script-run ID --script HASH --name NAME --for "kind K"|"who N"
//                                        the world's scripts row that runs it: a cell edit, as a plan's
//   realm world-script-report ID HASH --why WORDS --yes
//   realm world-publish ID now --confirm HASH,HASH --yes   a publish that adds or grows scripts
// Places are whole centimetres, as the wire carries them. --origin http://127.0.0.1:PORT sends
// them to `coax serve`, which answers the same routes on this computer.
#load "../../metaverse-engine/editor/op-result.coax";
#load "../../metaverse-engine/ai/npc-plan.coax";   // an actor's plan: its words, a route reshaped, its row (#13466)
#load "../../metaverse-engine/script/store.coax";  // a world's stored scripts: the list, a refusal, a report's answer (#13467)
#load "../../metaverse-engine/action/hoverboard.coax";   // the board table's row (#13485)

RW_ANSWER :: 400000;     // a state with its document
RW_LINES :: 65536;       // an apply file
RwWork :: struct {
  out: [RW_ANSWER] u8; doc: [RW_ANSWER] u8; did: [WE_BATCH_BODY] u8; scratch: [RW_ANSWER] u8;
  body: [WE_BATCH_BODY] u8; content: [CT_BODY] u8; file: [RW_LINES] u8; e: [WE_BATCH] WorldEdit;
  path: [256] u8; page: [128] u8; result: [OR_BODY] u8; words: [OR_WORDS] u8; line: [OR_BODY] u8;
  st: WorldState; words_n: int;
}
rw_path :: (slug: string, tail: string, out: [] u8) -> string {
  n := forge_put(out,0,"/api/worlds/"); n = forge_put(out,n,slug); n = forge_put(out,n,tail);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
rw_page :: (slug: string, out: [] u8) -> string {
  n := forge_put(out,0,"/worlds/"); n = forge_put(out,n,slug);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// The exit code a result is: done and a dry run are 0.
rw_exit :: (r: OpResult) -> int #effects(all) {
  if r.state == OR_DONE || r.state == OR_DRY_RUN || r.state == OR_RUNNING { return EXIT_OK; }
  if r.state == OR_NEEDS_APPROVAL { return EXIT_USAGE; }
  if r.state == OR_UNKNOWN { return EXIT_SLOW; }
  if r.code == ORC_STALE { return EXIT_CONFLICT; }
  if r.code == ORC_NOT_PERMITTED { return EXIT_FORBIDDEN; }
  if r.code == ORC_NOT_FOUND { return EXIT_NOT_FOUND; }
  if r.code == ORC_BAD_REQUEST { return EXIT_USAGE; }
  return EXIT_FAIL;
}
#test "a result's exit code: saved and dry are 0; each refusal has its own" {
  #assert rw_exit(OpResult.{state = OR_DONE}) == EXIT_OK && rw_exit(OpResult.{state = OR_DRY_RUN}) == EXIT_OK && rw_exit(OpResult.{state = OR_RUNNING}) == EXIT_OK;
  #assert rw_exit(OpResult.{state = OR_NEEDS_APPROVAL}) == EXIT_USAGE && rw_exit(OpResult.{state = OR_UNKNOWN, code = ORC_NO_ANSWER}) == EXIT_SLOW;
  #assert rw_exit(or_of_status(409, 0)) == EXIT_CONFLICT && rw_exit(or_of_status(403, 0)) == EXIT_FORBIDDEN && rw_exit(or_of_status(401, 0)) == EXIT_FORBIDDEN && rw_exit(or_of_status(404, 0)) == EXIT_NOT_FOUND;
  #assert rw_exit(or_of_status(400, 0)) == EXIT_USAGE && rw_exit(or_of_status(422, 0)) == EXIT_FAIL && rw_exit(or_of_status(500, 0)) == EXIT_FAIL && rw_exit(or_of_status(0, 0)) == EXIT_SLOW && rw_exit(or_of_status(200, 3)) == EXIT_OK;
}
// The result, printed: with --json the report's "result" member (and "rev", "state"); else one line.
rw_answer :: (r: [] Rep, w: [] RwWork, res: OpResult, words: OpWords) -> int {
  made := or_write(res, words, w[0].result[..]);
  if made.count == 0 { return fail(r, EXIT_FAIL, "the result does not fit its shape"); }
  realm_key_keep(words.key, res, made);
  if r[0].json {
    rep_raw(r, "result", made); rep_str(r, "state", OR_STATE[res.state]); rep_int(r, "rev", res.rev);
    if res.state == OR_REFUSED || res.state == OR_UNKNOWN { rep_str(r, "error", words.words); }
    return rep_done(r, rw_exit(res));
  }
  line := or_line(res, words, w[0].line[..]);
  if rw_exit(res) == EXIT_OK { print("%\n", line); } else { tool_err("openagents: "); tool_errln(line); }
  return rw_exit(res);
}
// The lane's state (and its document, in w.doc): the route's answer, read through the codec.
rw_state :: (a: [] Args, profile: string, slug: string, lane: string, w: [] RwWork) -> ApiAnswer {
  tail: [32] u8; n := forge_put(tail[..],0,"?lane="); n = forge_put(tail[..],n,lane);
  res := api_call(a, profile, "GET", rw_path(slug, cast(string) tail[0..<n], w[0].path[..]), "", w[0].out[..]);
  w[0].st = WorldState.{};
  if api_ok(res) { w[0].st = we_state_read(cast(string) w[0].out[0..<res.n], w[0].doc[..], w[0].did[..], w[0].scratch[..]); }
  return res;
}
// A whole number of centimetres as typed ("17720", "-7060"); WE_REACH + 1 when it is none.
rw_cm :: (s: string) -> int #effects(all) {
  neg := s.count > 0 && s[0] == '-';
  v := cli_count(ifx neg then s[1..<s.count] else s, 0, WE_REACH);
  if v < 0 { return WE_REACH + 1; }
  return ifx neg then -v else v;
}
#test "centimetres are whole numbers within the reach" {
  #assert rw_cm("0") == 0 && rw_cm("17720") == 17720 && rw_cm("-7060") == -7060 && rw_cm("10000000") == 10000000 && rw_cm("-10000000") == -10000000;
  #assert rw_cm("10000001") == WE_REACH + 1 && rw_cm("") == WE_REACH + 1 && rw_cm("-") == WE_REACH + 1 && rw_cm("1.5") == WE_REACH + 1 && rw_cm("x") == WE_REACH + 1;
}
// The edits a world verb's arguments are, into e: how many, or -1 for arguments that are none.
// world-apply's come from its file (rw_file_edits).
rw_edits :: (a: [] Args, verb: string, e: [] WorldEdit) -> int {
  p3 := positional(a, 3); p4 := positional(a, 4); p5 := positional(a, 5);
  id := cli_count(p3, 1, WE_ID_MAX);
  if verb == "world-place" {
    yaw := forge_turn(args_whole_signed(rc_option(a, verb, "--yaw", "0")));
    e[0] = WorldEdit.{op = WE_SPAWN, id = 0, kind = id, x = rw_cm(p4), z = rw_cm(p5), yaw = yaw, scale = 100};
  } else if verb == "world-move" { e[0] = WorldEdit.{op = WE_MOVE, id = id, x = rw_cm(p4), z = rw_cm(p5)}; }
  else if verb == "world-turn" { e[0] = WorldEdit.{op = WE_ROTATE, id = id, yaw = forge_turn(args_whole_signed(p4))}; }
  else if verb == "world-set" { e[0] = WorldEdit.{op = WE_SET, id = id, col = we_col(p4), v = rw_cm(p5)}; }
  else if verb == "world-remove" { e[0] = WorldEdit.{op = WE_DESPAWN, id = id}; }
  else if verb == "world-time" { e[0] = rw_cell("clock", 1, "when", p3); }
  else { return 0; }
  return ifx we_valid(e[0]) then 1 else -1;
}
// A cell edit of a content table: TABLE's row ROW, column COL ("*": the whole row) set to TEXT.
rw_cell :: (table: string, row: int, col: string, text: string) -> WorldEdit #effects(all) {
  e := WorldEdit.{ok = true, op = WE_CELL, id = row};
  e.table_n = ct_copy(e.table[..], table); e.name_n = ct_copy(e.name[..], col); e.text_n = ct_copy(e.text[..], text);
  return e;
}
// Table `name` of a content document's text: its header line and rows ("" when it has none).
rw_table :: (content: string, name: string) -> string #effects(all) {
  from := -1; to := content.count; at := 0;
  for k: 0..<ct_parts(content, '\n') {
    line := ct_part(content, '\n', k);
    if ct_part(line, ' ', 0) == "table" {
      if from >= 0 { to = at; break; }
      if ct_part(line, ' ', 1) == name { from = at; }
    }
    at += line.count + 1;
  }
  return ifx from < 0 then "" else content[from..<ifx to > content.count then content.count else to];
}
// The row with this ID in a table's text, or "".
rw_row :: (table: string, id: int) -> string #effects(all) {
  for k: 1..<ct_parts(table, '\n') {
    line := ct_part(table, '\n', k);
    v := ct_num(ct_part(line, '|', 0));
    if v.ok && v.v == id { return line; }
  }
  return "";
}
// The words for a write the site refused to this login.
rw_not_permitted :: (origin: string, out: [] u8) -> string #effects(all) {
  n := forge_put(out, 0, "this openagents login can't write to this world on "); n = forge_put(out, n, origin);
  n = forge_put(out, n, ": only an admin's login can (openagents login). A dev server (coax/web/serve.sh) takes edits from this computer with no login");
  return ifx n < 0 then "log in as an admin" else cast(string) out[0..<n];
}
#test "a refused write names the site and what can write" {
  b: [512] u8;
  #assert rw_not_permitted("https://openagents.com", b[..]) == "this openagents login can't write to this world on https://openagents.com: only an admin's login can (openagents login). A dev server (coax/web/serve.sh) takes edits from this computer with no login";
  t: [8] u8; #assert rw_not_permitted("https://openagents.com", t[..]) == "log in as an admin";
}
// Whether a content document's text already holds a cell edit's value: the row's cell under the
// edit's column (the whole row for "*").
rw_holds :: (content: string, edit: WorldEdit) -> bool #effects(all) {
  e := edit;
  table := rw_table(content, cast(string) e.table[0..<e.table_n]);
  row := rw_row(table, e.id); col := cast(string) e.name[0..<e.name_n]; text := cast(string) e.text[0..<e.text_n];
  if row.count == 0 { return false; }
  if col == "*" { return row == text; }
  head := ct_part(table, '\n', 0);
  for k: 2..<ct_parts(head, ' ') { if ct_part(ct_part(head, ' ', k), ':', 0) == col { return ct_part(row, '|', k - 2) == text; } }
  return false;
}
// world-board: the board table's row 1 as the world's dev tables hold it, with what the arguments change
// (on or off, --casual, --fast), written as its whole row. 1, or -N with the words when the world has no
// board table or the speeds do not hold, or -1.
rw_board_edit :: (a: [] Args, content: string, e: [] WorldEdit, words: [] u8) -> int {
  on := cli_onoff(positional(a, 3));
  if on < 0 { return -1; }
  table := rw_table(content, "board"); row := rw_row(table, 1);
  if ct_parts(row, '|') != 4 {
    n := forge_put(words, 0, "this world has no hoverboard to give: its content has no board table (");
    n = forge_put(words, n, BOARD_TABLE); n = forge_put(words, n, ")");
    return ifx n < 0 then -1 else -n;
  }
  casual := ct_num(rc_option(a, "world-board", "--casual", ct_part(row, '|', 2))).v;
  fast := ct_num(rc_option(a, "world-board", "--fast", ct_part(row, '|', 3))).v;
  why := board_row_why(1, ifx on == 1 then "on" else "off", casual, fast);
  if why != BRW_OK { n := forge_put(words, 0, board_row_words(why)); return ifx n < 0 then -1 else -n; }
  out: [64] u8;
  text := board_row_text(on == 1, casual, fast, out[..]);
  if text.count == 0 { return -1; }
  e[0] = rw_cell("board", 1, "*", text);
  return ifx we_valid(e[0]) then 1 else -1;
}
#test "the hoverboard from the command line is the board table's whole row; what is left out stays, and speeds that do not hold are refused in words" {
  a: [1] Args; e: [1] WorldEdit; o: [WE_LINE] u8; words: [200] u8;
  content := "aethyr.content.v1 splice 2\nreach 30000\ntable board id on:text casual:int fast:int\n1|off|700|2200\ntable clock id when:text\n1|story\n";
  for s: [4] string.["realm","world-board","splice","on"] { #assert args_add(a[..],s); }
  #assert rw_board_edit(a[..], content, e[..], words[..]) == 1 && we_write(e[0], o[..]) == "{\"op\":\"cell\",\"table\":\"board\",\"row\":1,\"col\":\"*\",\"v\":\"1|on|700|2200\"}";
  #assert !rw_holds(content, e[0]) && rw_holds("table board id on:text casual:int fast:int\n1|on|700|2200\n", e[0]);
  a[0] = Args.{}; for s: [8] string.["realm","world-board","splice","on","--casual","900","--fast","3000"] { #assert args_add(a[..],s); }
  #assert rw_board_edit(a[..], content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "1|on|900|3000";
  a[0] = Args.{}; for s: [6] string.["realm","world-board","splice","off","--fast","2500"] { #assert args_add(a[..],s); }
  #assert rw_board_edit(a[..], content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "1|off|700|2500";
  a[0] = Args.{}; for s: [6] string.["realm","world-board","splice","on","--casual","2500"] { #assert args_add(a[..],s); }
  n := rw_board_edit(a[..], content, e[..], words[..]);
  #assert n < -1 && cast(string) words[0..<-n] == "the very fast speed is faster than the casual one, and at most 6000 centimetres a second";
  a[0] = Args.{}; for s: [4] string.["realm","world-board","splice","on"] { #assert args_add(a[..],s); }
  n = rw_board_edit(a[..], "aethyr.content.v1 x 1\nreach 1\ntable clock id when:text\n1|story\n", e[..], words[..]);
  #assert n < -1 && cast(string) words[0..<-n] == "this world has no hoverboard to give: its content has no board table (table board id on:text casual:int fast:int)";
  a[0] = Args.{}; for s: [4] string.["realm","world-board","splice","maybe"] { #assert args_add(a[..],s); }
  #assert rw_board_edit(a[..], content, e[..], words[..]) == -1;
  // the command's bounds are the engine's
  #assert rc_bound("boardspeed").min == BOARD_SPEED_MIN && rc_bound("boardspeed").max == BOARD_SPEED_MAX;
}
// world-plan and world-route: actor FOE's plan at WHEN, as it is in the world's dev tables, with what
// the arguments change, written as its whole row: one edit that holds, since a new DO takes a route of
// its own shape (npl_fit). 1, or 0 when the world has no such plan (the words say so), or -1.
rw_plan_edit :: (a: [] Args, verb: string, content: string, e: [] WorldEdit, words: [] u8) -> int {
  foe := cli_count(positional(a, 3), 1, NPL_WHO_MAX); when := positional(a, 4); arg := positional(a, 5);
  lw := NPL_WHEN; w := npl_word(lw[..], when);
  if foe < 1 || w < 0 || arg.count == 0 { return -1; }
  row := rw_row(rw_table(content, "plans"), npl_id(foe, w));
  if ct_parts(row, '|') != 8 {
    n := forge_put(words, 0, "the world has no plan for actor "); n = forge_put_int(words, n, foe); n = forge_put(words, n, " at "); n = forge_put(words, n, when);
    n = forge_put(words, n, " (realm world-foes ID lists its actors and their plans)");
    return ifx n < 0 then -1 else -n;
  }
  ld := NPL_DO;
  was := ct_part(row, '|', 3); route := ct_part(row, '|', 4);
  act := ifx verb == "world-plan" then arg else was;
  given := ifx verb == "world-route" then arg else rc_option(a, verb, "--route", "");
  fit: [NPL_ROUTE] u8;
  if given.count > 0 { route = given; }
  else if act != was { route = npl_fit(npl_word(ld[..], act), route, "", foe, fit[..]); }
  speed := ct_num(rc_option(a, verb, "--speed", ct_part(row, '|', 5))).v;
  notice := ct_num(rc_option(a, verb, "--notice", ct_part(row, '|', 6))).v;
  on := rc_option(a, verb, "--on", ct_part(row, '|', 7));
  out: [WE_TEXT] u8;
  text := npl_row(foe, when, act, route, speed, notice, on, out[..]);
  if text.count == 0 { return -1; }
  e[0] = rw_cell("plans", npl_id(foe, w), "*", text);
  return ifx we_valid(e[0]) then 1 else -1;
}
#test "an actor's plan from the command line is its whole row, its route fitted to what it now does" {
  a: [1] Args; e: [1] WorldEdit; o: [WE_LINE] u8; words: [200] u8;
  content := "aethyr.content.v1 splice 2\nreach 30000\ntable clock id when:text\n1|story\ntable plans id who:int when:text do:text route:text speed:int notice:int on:text\n10|1|dawn|dance|-600 -4800|180|0|chase\n62|6|dusk|patrol|850 -4500, 850 -5700|180|500|chase\ntable templates id name:text parts:text\n";
  #assert rw_table(content, "clock") == "table clock id when:text\n1|story\n" && rw_table(content, "nope") == "" && rw_row(rw_table(content, "plans"), 62) == "62|6|dusk|patrol|850 -4500, 850 -5700|180|500|chase";
  for s: [6] string.["realm","world-plan","splice","6","dusk","guard"] { #assert args_add(a[..],s); }
  #assert rw_plan_edit(a[..], "world-plan", content, e[..], words[..]) == 1 && we_write(e[0], o[..]) == "{\"op\":\"cell\",\"table\":\"plans\",\"row\":62,\"col\":\"*\",\"v\":\"62|6|dusk|guard|850 -4500, 850 -5700|180|500|chase\"}";
  a[0] = Args.{}; for s: [10] string.["realm","world-plan","splice","1","dawn","sleep","--notice","300","--on","call"] { #assert args_add(a[..],s); }
  #assert rw_plan_edit(a[..], "world-plan", content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "10|1|dawn|sleep|-600 -4800|180|300|call";
  a[0] = Args.{}; for s: [6] string.["realm","world-plan","splice","1","dawn","patrol"] { #assert args_add(a[..],s); }
  #assert rw_plan_edit(a[..], "world-plan", content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "10|1|dawn|patrol|-600 -4800, -200 -4800|180|0|chase";
  // what the world holds already is told apart from a change: the whole row, or one cell
  #assert rw_holds(content, rw_cell("plans", 62, "*", "62|6|dusk|patrol|850 -4500, 850 -5700|180|500|chase")) && !rw_holds(content, rw_cell("plans", 62, "*", "62|6|dusk|guard|850 -4500, 850 -5700|180|500|chase"));
  #assert rw_holds(content, rw_cell("clock", 1, "when", "story")) && !rw_holds(content, rw_cell("clock", 1, "when", "dusk")) && !rw_holds(content, rw_cell("clock", 2, "when", "story")) && !rw_holds(content, rw_cell("clock", 1, "nope", "story"));
  #assert rw_holds(content, rw_cell("plans", 10, "do", "dance")) && !rw_holds(content, rw_cell("plans", 10, "on", "dance"));
  a[0] = Args.{}; for s: [6] string.["realm","world-route","splice","6","dusk","0 -4500, 1200 -4500, 0 -4500"] { #assert args_add(a[..],s); }
  #assert rw_plan_edit(a[..], "world-route", content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "62|6|dusk|patrol|0 -4500, 1200 -4500, 0 -4500|180|500|chase";
  a[0] = Args.{}; for s: [6] string.["realm","world-route","splice","6","dawn","0 0, 1 1"] { #assert args_add(a[..],s); }
  n := rw_plan_edit(a[..], "world-route", content, e[..], words[..]);
  #assert n < 0 && cast(string) words[0..<-n] == "the world has no plan for actor 6 at dawn (realm world-foes ID lists its actors and their plans)";
  a[0] = Args.{}; for s: [4] string.["realm","world-time","splice","dusk"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..], "world-time", e[..]) == 1 && we_write(e[0], o[..]) == "{\"op\":\"cell\",\"table\":\"clock\",\"row\":1,\"col\":\"when\",\"v\":\"dusk\"}";
  // the command line's words are the plan's
  lw := NPL_WHEN; ld := NPL_DO; lo := NPL_ON;
  for w, k: CLI_DAYTIME { #assert lw[k] == w; } for w, k: CLI_PLAN_DO { #assert ld[k] == w; } for w, k: CLI_PLAN_ON { #assert lo[k] == w; }
}
// A whole number with an optional minus ("-45"); 0 for what is none (the row's kind refused that already).
args_whole_signed :: (s: string) -> int #effects(all) {
  neg := s.count > 0 && s[0] == '-';
  v := cli_count(ifx neg then s[1..<s.count] else s, 0, 999999999);
  if v < 0 { return 0; }
  return ifx neg then -v else v;
}
#test "a world verb's arguments are one edit of the wire" {
  a: [1] Args; e: [2] WorldEdit; o: [WE_LINE] u8;
  for s: [8] string.["realm","world-place","splice","113","17720","-7060","--yaw","270"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-place",e[..]) == 1 && we_write(e[0],o[..]) == "{\"op\":\"spawn\",\"id\":0,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":-90,\"scale\":100}";
  a[0] = Args.{}; for s: [6] string.["realm","world-move","splice","2","300","120"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-move",e[..]) == 1 && we_write(e[0],o[..]) == "{\"op\":\"move\",\"id\":2,\"x\":300,\"y\":0,\"z\":120}";
  a[0] = Args.{}; for s: [5] string.["realm","world-turn","splice","2","-45"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-turn",e[..]) == 1 && we_write(e[0],o[..]) == "{\"op\":\"rotate\",\"id\":2,\"yaw\":-45}";
  a[0] = Args.{}; for s: [6] string.["realm","world-set","splice","2","x","310"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-set",e[..]) == 1 && we_write(e[0],o[..]) == "{\"op\":\"set\",\"id\":2,\"col\":\"x\",\"v\":310}";
  a[0] = Args.{}; for s: [4] string.["realm","world-remove","splice","2"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-remove",e[..]) == 1 && we_write(e[0],o[..]) == "{\"op\":\"despawn\",\"id\":2}";
  #assert rw_edits(a[..],"world-undo",e[..]) == 0;
  a[0] = Args.{}; for s: [6] string.["realm","world-set","splice","2","mass","310"] { #assert args_add(a[..],s); }
  #assert rw_edits(a[..],"world-set",e[..]) == -1;
  #assert args_whole_signed("-45") == -45 && args_whole_signed("90") == 90 && args_whole_signed("") == 0 && args_whole_signed("x") == 0;
}
// A file's edits, one JSON object a line (blank lines pass), into e: how many, or minus the line
// that is no edit.
rw_file_edits :: (text: string, e: [] WorldEdit) -> int #effects(all) {
  n := 0; line := 0;
  for k: 0..<ct_parts(text, '\n') {
    row := ct_part(text, '\n', k); line += 1;
    if row.count > 0 && row[row.count - 1] == '\r' { row = row[0..<row.count - 1]; }
    if row.count == 0 { continue; }
    if n >= e.count { return -line; }
    e[n] = we_read(row);
    if !e[n].ok { return -line; }
    n += 1;
  }
  return n;
}
#test "an apply file is edits a line; the line that is none is named" {
  e: [3] WorldEdit;
  #assert rw_file_edits("{\"op\":\"despawn\",\"id\":2}\n\n{\"op\":\"rotate\",\"id\":1,\"yaw\":90}\r\n", e[..]) == 2 && e[1].yaw == 90;
  #assert rw_file_edits("{\"op\":\"despawn\",\"id\":2}\n{\"op\":\"fly\"}\n", e[..]) == -2 && rw_file_edits("", e[..]) == 0 && rw_file_edits("x", e[..]) == -1;
  #assert rw_file_edits("{\"op\":\"despawn\",\"id\":1}\n{\"op\":\"despawn\",\"id\":2}\n{\"op\":\"despawn\",\"id\":3}\n{\"op\":\"despawn\",\"id\":4}\n", e[..]) == -4;
}
// What a world verb does to the batch: apply its edits, or undo, redo, original, publish.
rw_what :: (verb: string, when: string) -> int #effects(all) {
  if verb == "world-undo" { return WB_UNDO; }
  if verb == "world-redo" { return WB_REDO; }
  if verb == "world-original" { return WB_ORIGINAL; }
  if verb == "world-publish" { return ifx when == "next" then WB_PUBLISH_NEXT else WB_PUBLISH_NOW; }
  return WB_APPLY;
}
#test "what each world verb asks of the batch" {
  #assert rw_what("world-undo","") == WB_UNDO && rw_what("world-redo","") == WB_REDO && rw_what("world-original","") == WB_ORIGINAL && rw_what("world-place","") == WB_APPLY && rw_what("world-apply","") == WB_APPLY;
  #assert rw_what("world-publish","now") == WB_PUBLISH_NOW && rw_what("world-publish","next") == WB_PUBLISH_NEXT;
}

// A frame of the world's page after an edit (--shot OUT.png): the page is opened on its dev lane
// and the picture is taken once it stands at revision `rev`, so the frame is the edit's. The report
// says what the picture is of: the realm, the revision, the page, the camera and the GPU (#13437).
rw_shot :: (a: [] Args, r: [] Rep, profile: string, slug: string, out: string, rev: int, w: [] RwWork) -> bool {
  b: [1] Args; js: [400] u8; pg: [160] u8;
  n := forge_put(js[..],0,"new Promise(done => { const t0 = Date.now(); const look = () => { const at = coaxial.fieldProbe ? coaxial.fieldProbe(0) : -1; if (at >= ");
  n = forge_put_int(js[..],n,rev); n = forge_put(js[..],n," || Date.now() - t0 > 8000) setTimeout(() => done(String(at)), 900); else setTimeout(look, 50); }; look(); })");
  pn := forge_put(pg[..],0,rw_page(slug, w[0].page[..])); pn = forge_put(pg[..],pn,"?edit");
  if n < 0 || pn < 0 { return false; }
  ok := args_add(b[..],"labs") && args_add(b[..],"shot") && args_add(b[..],cast(string) pg[0..<pn]) && args_add(b[..],out) && args_add(b[..],"--eval") && args_add(b[..],cast(string) js[0..<n]) && args_add(b[..],"--fresh");
  if args_has(a,"--origin") { ok = ok && args_add(b[..],"--origin") && args_add(b[..],args_value(a,"--origin","")); }
  if !ok { return false; }
  // the shot's own report is read here, not printed: its lines are `key value`
  q := [1] Rep.[Rep.{}];
  if labs_shot_fill(b[..], q[..], profile, "") != EXIT_OK { return false; }
  at := -1; text := cast(string) q[0].buf[0..<q[0].n];
  for k: 0..<ct_parts(text, '\n') { row := ct_part(text, '\n', k); if ct_part(row, ' ', 0) == "eval" { at = wd_field_int(row, 1); } }
  // the picture names what it is of (#13437): the realm, the revision the page stood at, the page, the camera and the GPU
  rep_str(r, "shot", out); rep_str(r, "shot_realm", slug); rep_int(r, "shot_rev", at); rep_str(r, "shot_page", cast(string) pg[0..<pn]);
  rep_str(r, "shot_camera", "the page's own"); rep_str(r, "shot_gpu", "headless");
  if at != rev { rep_str(r, "shot_note", "the page did not reach the edit's revision in time: the picture is of the revision named"); }
  return true;
}

// realm world ID: the world as an agent needs it to aim an edit.
rw_show :: (a: [] Args, r: [] Rep, profile: string, slug: string, w: [] RwWork) -> int {
  lane := rc_option(a, "world", "--lane", "dev");
  res := rw_state(a, profile, slug, lane, w);
  if !api_ok(res) { return api_fail(r, res, cast(string) w[0].out[0..<res.n]); }
  st := w[0].st;
  if !st.ok { return fail(r, EXIT_FAIL, "the world's answer is not a world.state.v1"); }
  doc := cast(string) w[0].doc[0..<st.doc_n];
  // the lane's own content tables: dev's as they are edited, live's as they were published (#13419)
  cres := api_call(a, profile, "GET", rw_path(slug, ifx lane == "dev" then "/content?lane=dev" else "/content", w[0].path[..]), "", w[0].content[..]);
  content := ifx api_ok(cres) then cast(string) w[0].content[0..<cres.n] else "";
  pb: [160] u8; lb: [480] u8; bb: [64] u8;
  bn := 0; for k: 0..<4 { if k > 0 { bn = forge_put(bb[..],bn,"."); } bn = forge_put_int(bb[..],bn,st.build[k]); }
  // the reference on the origin this read, so an agent fetches the dev server's page and not production's (#13466)
  ob: [256] u8; origin := acct_origin(a, profile, ob[..]);
  ln := forge_put(lb[..],0,origin); ln = forge_put(lb[..],ln,rw_page(slug, pb[..])); ln = forge_put(lb[..],ln,"/llms.txt");
  rep_str(r, "world", slug); rep_str(r, "lane", lane); rep_int(r, "rev", st.rev); rep_int(r, "dev", st.dev); rep_int(r, "live", st.live);
  rep_str(r, "build", cast(string) bb[0..<bn]); rep_int(r, "undo", st.undo); rep_int(r, "redo", st.redo);
  rep_str(r, "page", rw_page(slug, pb[..])); rep_str(r, "reference", cast(string) lb[0..<ln]);
  if r[0].json { rep_str(r, "doc", doc); rep_str(r, "content", content); return rep_done(r, EXIT_OK); }
  code := rep_done(r, EXIT_OK);
  // the placed things: the document's entities whose kind is a content ID (100 and up), by number
  print("placed (N KIND X Z YAW, centimetres and degrees; KIND is a row of the pieces table):\n");
  placed := 0;
  for k: 0..<ct_parts(doc, '\n') {
    row := ct_part(doc, '\n', k);
    if ct_part(row, ' ', 0) != "e" || ct_parts(row, ' ') < 19 { continue; }
    kind := wd_field_int(row, 17); item := wd_field_int(row, 18);
    if kind < 100 || (wd_field_int(row, 4) & 1) == 0 { continue; }
    print("  % % % % %\n", item + 1, kind, wd_field_cm(row, 6), wd_field_cm(row, 8), wd_field_deg(row, 9));
    placed += 1;
  }
  if placed == 0 { print("  none\n"); }
  if content.count > 0 { print("content tables (aethyr.content.v1: pieces, landmarks, kept_clear, areas; places in centimetres):\n%", content); }
  print("player and here: a page knows them. `coax/web/tool.sh drive web APP /worlds/% --live ORIGIN where` asks the open page.\n", slug);
  return code;
}
// A field of a document's entity line as a whole number, or as an f32 column's bits turned into
// centimetres or degrees.
wd_field_int :: (row: string, k: int) -> int #effects(all) {
  s := ct_part(row, ' ', k); neg := s.count > 0 && s[0] == '-';
  v := cli_count(ifx neg then s[1..<s.count] else s, 0, 999999999999999999);
  return ifx v < 0 then 0 else (ifx neg then -v else v);
}
wd_field_f :: (row: string, k: int) -> f32 #effects(all) {
  s := ct_part(row, ' ', k); v := 0;
  if s.count != 8 { return 0; }
  for b: s { d := ifx b >= '0' && b <= '9' then cast(int) (b - '0') else (ifx b >= 'a' && b <= 'f' then cast(int) (b - 'a') + 10 else 0); v = v * 16 + d; }
  return f32_from_bits(cast(u32) v);
}
wd_field_cm :: (row: string, k: int) -> int #effects(all) { return we_cm(wd_field_f(row, k)); }
wd_field_deg :: (row: string, k: int) -> int #effects(all) { return we_deg(wd_field_f(row, k)); }
#test "a document's entity line gives a placed thing's number, kind, place and turn" {
  row := "e 102 0 103 1 27 43314000 00000000 c28d3333 bfc90fdb 00000000 00000000 00000000 3f99999a 40000000 0 0 113 1 0 0 0 0 1";
  #assert wd_field_int(row, 17) == 113 && wd_field_int(row, 18) == 1 && wd_field_int(row, 4) == 1 && wd_field_cm(row, 6) == 17725 && wd_field_cm(row, 8) == -7060 && wd_field_deg(row, 9) == -90;
  #assert wd_field_int("e -5", 1) == -5 && wd_field_int("e x", 1) == 0 && wd_field_f("e 12", 1) == 0;
}

// A world verb that writes: the batch made from the revision read (or --rev N), sent, and its one result.
rw_write :: (a: [] Args, r: [] Rep, profile: string, verb: string, slug: string, w: [] RwWork) -> int {
  c := REALM_COMMANDS[rc_find(verb)];
  words := OpWords.{verb = verb, realm = slug, effect = c.effect, page = rw_page(slug, w[0].page[..]), key = rc_option(a, verb, "--key", "")};
  n := rw_edits(a, verb, w[0].e[..]);
  same := false;
  if verb == "world-plan" || verb == "world-route" || verb == "world-time" || verb == "world-script-run" || verb == "world-board" {
    // the plan or the clock as the dev tables hold it now, changed by the arguments
    cres := api_call(a, profile, "GET", rw_path(slug, "/content?lane=dev", w[0].path[..]), "", w[0].content[..]);
    if !api_ok(cres) { words.words = api_why(cast(string) w[0].content[0..<cres.n], w[0].words[..]); return rw_answer(r, w, or_of_status(ifx cres.error == HTTP_OK then cres.status else 0, 0), words); }
    content := cast(string) w[0].content[0..<cres.n];
    if verb == "world-script-run" { n = rw_script_row(a, content, w[0].e[..], w[0].words[..]); }
    else if verb == "world-board" { n = rw_board_edit(a, content, w[0].e[..], w[0].words[..]); }
    else if verb != "world-time" { n = rw_plan_edit(a, verb, content, w[0].e[..], w[0].words[..]); }
    if n < -1 { words.words = cast(string) w[0].words[0..<-n]; return rw_answer(r, w, OpResult.{state = OR_REFUSED, code = ORC_BAD_REQUEST}, words); }
    // already so: done, at the revision it stands at, with nothing sent (an agent that sets what is there is not refused)
    same = n == 1 && rw_holds(content, w[0].e[0]);
  }
  if verb == "world-apply" {
    file := positional(a, 3);
    fn := fs_read(file, w[0].file[..]);
    if fn <= 0 { return fail(r, EXIT_USAGE, "FILE is edits as JSON lines, at most 64 KiB (realm help)"); }
    n = rw_file_edits(cast(string) w[0].file[0..<fn], w[0].e[..]);
    if n < 0 {
      wn := forge_put(w[0].words[..],0,"line "); wn = forge_put_int(w[0].words[..],wn,-n); wn = forge_put(w[0].words[..],wn," is not a world.edit.v1 edit");
      words.words = cast(string) w[0].words[0..<ifx wn < 0 then 0 else wn];
      return rw_answer(r, w, OpResult.{state = OR_REFUSED, code = ORC_BAD_REQUEST, edit = -n - 1}, words);
    }
    if n == 0 { words.words = "the file holds no edit"; return rw_answer(r, w, OpResult.{state = OR_REFUSED, code = ORC_BAD_REQUEST}, words); }
  }
  if n < 0 { words.words = "the arguments are not an edit this world's wire carries (realm help)"; return rw_answer(r, w, OpResult.{state = OR_REFUSED, code = ORC_BAD_REQUEST}, words); }
  // the revision the batch is made from: --rev N, or the world's as read now
  res := rw_state(a, profile, slug, "dev", w);
  if !api_ok(res) || !w[0].st.ok {
    words.words = api_why(cast(string) w[0].out[0..<res.n], w[0].words[..]);
    return rw_answer(r, w, or_of_status(ifx res.error == HTTP_OK then (ifx res.status == 200 then 500 else res.status) else 0, 0), words);
  }
  st := w[0].st; base := st.rev;
  if same {
    words.words = "nothing changed: the world already holds that";
    out := OpResult.{ok = true, state = OR_DONE, rev = st.rev}; for k: 0..<4 { out.build[k] = st.build[k]; }
    return rw_answer(r, w, out, words);
  }
  if rc_has(a, verb, "--rev") { base = cli_count(rc_option(a, verb, "--rev", ""), 1, 999999999); if base < 0 { base = 0; } }
  what := rw_what(verb, positional(a, 3));
  body := we_batch_write(base, what, w[0].e[..], ifx what == WB_APPLY then n else 0, w[0].body[..]);
  if body.count == 0 { words.words = "the edits do not fit one batch (64 at most)"; return rw_answer(r, w, OpResult.{state = OR_REFUSED, code = ORC_BAD_REQUEST}, words); }
  dry := rc_has(a, verb, "--dry-run");
  tail: [RS_CONFIRM + 32] u8;
  post := api_call(a, profile, "POST", rw_path(slug, rw_query(a, verb, dry, tail[..]), w[0].path[..]), body, w[0].out[..]);
  answer := cast(string) w[0].out[0..<post.n];
  out := or_of_status(ifx post.error == HTTP_OK then post.status else 0, st.rev);
  for k: 0..<4 { out.build[k] = st.build[k]; }
  if out.state == OR_DONE {
    done := we_state_read(answer, w[0].doc[..], w[0].did[..], w[0].scratch[..]);
    if !done.ok { out = or_of_status(500, st.rev); words.words = "the world's answer is not a world.state.v1"; }
    else {
      out.rev = ifx wr_is_publish(what) then st.rev else done.rev;
      for k: 0..<4 { out.build[k] = done.build[k]; }
      if dry { out.state = OR_DRY_RUN; out.level = ORL_COPY; out.rev = st.rev; }
      if r[0].json && done.did_n > 0 { rep_raw(r, "did", cast(string) w[0].did[0..<done.did_n]); }
      if wr_is_publish(what) { rep_int(r, "live", done.rev); }
    }
  } else if out.state == OR_REFUSED && wr_is_publish(what) && post.status == 409 && rs_grows(a, r, slug, answer, w) {
    // scripts that are new or do more than live's: each with what it adds, and the command that confirms them
    words.words = cast(string) w[0].words[0..<w[0].words_n];
    out.code = ORC_EDIT_REFUSED; out.retry = or_code_retry(ORC_EDIT_REFUSED);
  } else if out.state == OR_REFUSED {
    refusal := we_refusal_read(answer, w[0].words[..]);
    words.words = ifx refusal.ok then cast(string) w[0].words[0..<refusal.words_n] else api_why(answer, w[0].words[..]);
    out.edit = refusal.edit;
    // a login that can't write: say whose site and what can (a local agent's tools use the person's login there)
    if out.code == ORC_NOT_PERMITTED { ob: [512] u8; words.words = rw_not_permitted(acct_origin(a, profile, ob[..]), w[0].words[..]); }
    if out.code == ORC_EDIT_REFUSED && (words.words == "nothing to undo" || words.words == "nothing to redo" || words.words == "nothing to change" || words.words == "live is already this revision") { out.code = ORC_NOTHING; out.retry = false; }
  } else { words.words = "the request was sent and no answer came: it may have been saved. Read the world (realm world) before you repeat it"; }
  shot := rc_option(a, verb, "--shot", "");
  if shot.count > 0 && out.state == OR_DONE && !rw_shot(a, r, profile, slug, shot, out.rev, w) { rep_str(r, "shot_error", "the frame could not be taken (labs doctor says what is missing)"); }
  return rw_answer(r, w, out, words);
}
wr_is_publish :: (what: int) -> bool #effects(all) { return what == WB_PUBLISH_NOW || what == WB_PUBLISH_NEXT; }

// realm world-foes ID: the actors, their plans by time of day and the editor's time of day, from the
// lane's content tables, and the places a route may name.
rw_foes :: (a: [] Args, r: [] Rep, profile: string, slug: string, w: [] RwWork) -> int {
  lane := rc_option(a, "world-foes", "--lane", "dev");
  cres := api_call(a, profile, "GET", rw_path(slug, ifx lane == "dev" then "/content?lane=dev" else "/content", w[0].path[..]), "", w[0].content[..]);
  if !api_ok(cres) { return api_fail(r, cres, cast(string) w[0].content[0..<cres.n]); }
  content := cast(string) w[0].content[0..<cres.n];
  plans := rw_table(content, "plans"); actors := rw_table(content, "actors"); clock := rw_row(rw_table(content, "clock"), 1);
  if plans.count == 0 { return fail(r, EXIT_FAIL, "this world keeps no plans: its content has no plans table"); }
  rep_str(r, "world", slug); rep_str(r, "lane", lane); rep_str(r, "time", ct_part(clock, '|', 1));
  if r[0].json { rep_str(r, "actors", actors); rep_str(r, "plans", plans); rep_str(r, "content", content); return rep_done(r, EXIT_OK); }
  code := rep_done(r, EXIT_OK);
  print("time of day in the editor: % (story: the run's own clock; realm world-time sets it)\n", ifx clock.count > 0 then ct_part(clock, '|', 1) else "story");
  print("actors: FOE NAME, then a plan a line: WHEN DO SPEED NOTICE ON ROUTE (centimetres; speed a second)\n");
  for k: 1..<ct_parts(actors, '\n') {
    line := ct_part(actors, '\n', k);
    who := ct_num(ct_part(line, '|', 0));
    if !who.ok { continue; }
    print("  % %\n", who.v, ct_part(line, '|', 1));
    for j: 1..<ct_parts(plans, '\n') {
      p := ct_part(plans, '\n', j);
      if ct_num(ct_part(p, '|', 1)).v != who.v || ct_parts(p, '|') != 8 { continue; }
      print("    % % % % % %\n", ct_part(p, '|', 2), ct_part(p, '|', 3), ct_part(p, '|', 5), ct_part(p, '|', 6), ct_part(p, '|', 7), ct_part(p, '|', 4));
    }
  }
  print("places a route may name (areas and landmarks: ID NAME X Z ...):\n%", rw_table(content, "areas"));
  print("%", rw_table(content, "landmarks"));
  print("routes: stand, dance, sleep \"X Z\"; guard the post, then where it looks; patrol 2 to 8 points (a loop ends where it starts); wander \"X Z R\"; follow \"foe N\". The world refuses a route it cannot hold, in words.\n");
  return code;
}
// realm world-why ID THING: the page's own answer (metaverse-engine/agent/why.coax), asked of the
// world's page in headless Chrome.
rw_why :: (a: [] Args, r: [] Rep, profile: string, slug: string, w: [] RwWork) -> int {
  thing := positional(a, 3);
  b: [1] Args; js: [300] u8; pg: [160] u8; tmp: [1100] u8; td: [1024] u8; name: [48] u8;
  // a placed thing's number, as `realm world` lists it, is the page's piece one below it
  number := cli_count(thing, 1, 999999999);
  if number >= 1 { tn := forge_put(name[..],0,"piece-"); tn = forge_put_int(name[..],tn,number - 1); thing = cast(string) name[0..<tn]; }
  for c: thing { if c == '\'' || c == '\\' || c < 32 { return fail(r, EXIT_USAGE, "THING is a placed thing's number, or a name the page knows: you, foe-N, rubble, boss-wall, caps"); } }
  n := forge_put(js[..],0,"new Promise(done => setTimeout(() => done(coaxial.drive.send('why "); n = forge_put(js[..],n,thing); n = forge_put(js[..],n,"') || 'the page has no driver'), 1200))");
  pn := forge_put(pg[..],0,rw_page(slug, w[0].page[..])); pn = forge_put(pg[..],pn,"?edit");
  dir := fs_temp("world-why", td[..]);
  png := fs_join(dir, "why.png", tmp[..]);
  if n < 0 || pn < 0 || png == "" { return fail(r, EXIT_FAIL, "the question does not fit"); }
  ok := args_add(b[..],"labs") && args_add(b[..],"shot") && args_add(b[..],cast(string) pg[0..<pn]) && args_add(b[..],png) && args_add(b[..],"--eval") && args_add(b[..],cast(string) js[0..<n]) && args_add(b[..],"--fresh");
  if args_has(a,"--origin") { ok = ok && args_add(b[..],"--origin") && args_add(b[..],args_value(a,"--origin","")); }
  if !ok { return fail(r, EXIT_USAGE, "arguments too long"); }
  // the shot's own report is read here: the answer is its eval, from "eval " to the line "cached"
  q := [1] Rep.[Rep.{}];
  code := labs_shot_fill(b[..], q[..], profile, "");
  gone := fs_remove(png) && fs_remove(dir);
  if code != EXIT_OK { return code; }
  text := cast(string) q[0].buf[0..<q[0].n]; from := -1; to := text.count;
  for i: 0..<text.count { if from < 0 && i + 5 <= text.count && text[i..<i + 5] == "eval " && (i == 0 || text[i - 1] == '\n') { from = i + 5; } }
  for i: 0..<text.count { if from >= 0 && i > from && i + 8 <= text.count && text[i..<i + 8] == "\ncached " { to = i; break; } }
  answer := ifx from < 0 then "the page gave no answer" else text[from..<to];
  if r[0].json { rep_str(r, "world", slug); rep_str(r, "thing", thing); rep_str(r, "why", answer); return rep_done(r, EXIT_OK); }
  print("%\n", answer);
  return EXIT_OK;
}

rw_main :: (a: [] Args, r: [] Rep, profile: string, verb: string) -> int {
  slug := positional(a, 2);
  if !we_world_ok(slug) { return fail(r, EXIT_USAGE, "ID is a world's: a lowercase letter or a digit, then a-z, 0-9 and -, 48 at most"); }
  w := [1] RwWork.[RwWork.{}];
  if verb == "world" { return rw_show(a, r, profile, slug, w[..]); }
  if verb == "world-why" { return rw_why(a, r, profile, slug, w[..]); }
  if verb == "world-foes" { return rw_foes(a, r, profile, slug, w[..]); }
  if verb == "world-scripts" { return rs_list(a, r, profile, slug); }
  if verb == "world-script-compile" || verb == "world-script-put" || verb == "world-script-report" { return rs_send(a, r, profile, verb, slug, w[..]); }
  if verb == "world-open" {
    ob: [300] u8; ub: [500] u8;
    n := forge_put(ub[..],0,acct_origin(a, profile, ob[..])); n = forge_put(ub[..],n,rw_page(slug, w[0].page[..])); n = forge_put(ub[..],n,"?edit");
    if n < 0 { return fail(r, EXIT_USAGE, "--origin is too long"); }
    rep_str(r, "world", slug); rep_str(r, "edit", cast(string) ub[0..<n]);
    return rep_done(r, EXIT_OK);
  }
  return rw_write(a, r, profile, verb, slug, w[..]);
}

// ---- a world's realm scripts (#13467, docs/protocol/world-scripts-v1.md). Every answer is read
// through its one codec (metaverse-engine/script/store.coax: the list, a refusal, a report's answer;
// manifest.coax: a stored script), and a script's row of the world's content tables through rows.coax.
//   world-scripts          GET  /api/worlds/ID/scripts
//   world-script-compile   POST /api/worlds/ID/scripts/compile?name=NAME   body: the source
//   world-script-put       POST /api/worlds/ID/scripts?name=NAME           body: the module; X-Script-Fields
//   world-script-report    POST /api/worlds/ID/scripts/HASH/report         body: the reason
//   world-script-run       a world.edit.v1 cell edit of the scripts table, through rw_write as every edit
//   world-publish --confirm POST /api/worlds/ID?confirm=HASH,HASH

RS_CONFIRM :: SH_SCRIPTS * 65;          // --confirm's hashes and their commas
RS_BODY :: 65536;                        // a module (WM_BYTES) or a source (SS_SOURCE)
RS_JSON :: 60000;                        // a list for --json
RsWork :: struct {
  out: [SS_OUT] u8; nodes: [SS_LIST_NODES] JvNode; d: [1] Jv; world: [64] u8;
  mf: [1] ScriptManifest; why: [SS_WHY] u8; r: [1] SsRefusal; words: [SS_WORDS + 200] u8; detail: [SS_DETAIL] u8;
  body: [RS_BODY] u8; fields: [SM_TEXT + 2] u8; path: [400] u8; extra: [SM_TEXT + 40] u8; text: [RS_JSON] u8; line: [2000] u8;
}

// The names of a manifest's handlers (kind 0), powers (1) or calls (2), joined by ", "; "none" for none.
rs_add :: (out: [] u8, n: int, name: string) -> int #effects(all) { return forge_put(out, ifx n > 0 then forge_put(out, n, ", ") else n, name); }
rs_names :: (bits: int, kind: int, out: [] u8) -> string #effects(all) {
  n := 0;
  if kind == 0 { for name, h: RH_NAMES { if (bits & (1 << h)) != 0 { n = rs_add(out, n, name); } } }
  if kind == 1 { for name, p: SM_POWERS { if (bits & (1 << p)) != 0 { n = rs_add(out, n, name); } } }
  if kind == 2 { for c, k: SCRIPT_API { if (bits & (1 << k)) != 0 { n = rs_add(out, n, c.name); } } }
  if n == 0 { n = forge_put(out, 0, "none"); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// A stored script on one line: "pacer HASH 1234 bytes; handlers on_tick, on_hit; may read, write; calls sa_x, sa_move".
rs_what :: (mf: ScriptManifest, out: [] u8) -> string #effects(all) {
  m := mf; b: [800] u8;
  n := forge_put(out, 0, cast(string) m.name[0..<m.name_n]); n = forge_put(out, n, " "); n = forge_put(out, n, cast(string) m.hash[..]);
  n = forge_put(out, n, " "); n = forge_put_int(out, n, m.bytes); n = forge_put(out, n, " bytes; handlers "); n = forge_put(out, n, rs_names(m.handlers, 0, b[..]));
  n = forge_put(out, n, "; may "); n = forge_put(out, n, rs_names(m.powers, 1, b[..]));
  n = forge_put(out, n, "; calls "); n = forge_put(out, n, rs_names(m.calls, 2, b[..]));
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// The command that runs a stored script, for the answer to a store.
rs_run_hint :: (slug: string, name: string, hash: string, out: [] u8) -> string #effects(all) {
  n := forge_put(out, 0, "openagents realm world-script-run "); n = forge_put(out, n, slug); n = forge_put(out, n, " --script "); n = forge_put(out, n, hash);
  n = forge_put(out, n, " --name "); n = forge_put(out, n, name); n = forge_put(out, n, " --for \"kind K\" (or \"who N\"), then world-publish");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// The limits, in words: what each of world.scripts.v1's limits is (SS_LIMIT_NAMES' order).
RS_LIMIT_WORDS :: [SS_LIMITS] string.["scripts a world runs", "bytes a module", "modules a world stores", "fuel a call", "fuel a tick", "uploads a day", "compiles a day", "reports a day", "bytes a source", "bytes a reason", ""];
rs_limits_line :: (l: SsLimits, out: [] u8) -> string #effects(all) {
  n := forge_put(out, 0, "limits: ");
  for words, k: RS_LIMIT_WORDS {
    if k == SS_LIMITS - 1 { n = forge_put(out, n, ifx ss_limit(l, k) == 1 then "; this server compiles sources" else "; this server compiles no source (store built modules)"); continue; }
    if k > 0 { n = forge_put(out, n, ", "); }
    n = forge_put_int(out, n, ss_limit(l, k)); n = forge_put(out, n, " "); n = forge_put(out, n, words);
  }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// A list's scripts for --json: name, hash, bytes, handlers, powers and calls by name, whether it is off and why, whether its source is kept.
rs_scripts_json :: (d: [] Jv, h: SsHead, mf: [] ScriptManifest, why: [] u8, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_arr(o[..]);
  for i: 0..<h.count {
    e := ss_list_entry(d, i, mf, why);
    if !e.ok { return ""; }
    m := mf[0];
    jo_obj(o[..]);
    jo_key(o[..], "name"); jo_str(o[..], cast(string) m.name[0..<m.name_n]); jo_key(o[..], "hash"); jo_str(o[..], cast(string) m.hash[..]); jo_key(o[..], "bytes"); jo_int(o[..], m.bytes);
    ss_bits_write(o[..], "handlers", m.handlers, 0); ss_bits_write(o[..], "powers", m.powers, 1); ss_bits_write(o[..], "calls", m.calls, 2);
    jo_key(o[..], "off"); jo_bool(o[..], e.off); jo_key(o[..], "why"); jo_str(o[..], cast(string) why[0..<e.why_n]); jo_key(o[..], "source"); jo_bool(o[..], e.source);
    jo_end(o[..]);
  }
  jo_end(o[..]);
  return ifx o[0].bad then "" else jo_text(o[..]);
}
rs_limits_json :: (l: SsLimits, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]); for name, k: SS_LIMIT_NAMES { jo_key(o[..], name); jo_int(o[..], ss_limit(l, k)); } jo_end(o[..]);
  return ifx o[0].bad then "" else jo_text(o[..]);
}

// realm world-scripts ID: the world's stored scripts, one a line, then the limits.
rs_list :: (a: [] Args, r: [] Rep, profile: string, slug: string) -> int {
  w := [1] RsWork.[RsWork.{}];
  res := api_call(a, profile, "GET", rw_path(slug, "/scripts", w[0].path[..]), "", w[0].out[..]);
  answer := cast(string) w[0].out[0..<res.n];
  if !api_ok(res) { return api_fail(r, res, answer); }
  h := ss_list_read(w[0].d[..], answer, w[0].nodes[..], w[0].world[..]);
  if !h.ok { return fail(r, EXIT_FAIL, "the answer is not a world.scripts.v1 list"); }
  rep_str(r, "world", slug); rep_int(r, "count", h.count);
  if r[0].json {
    scripts := rs_scripts_json(w[0].d[..], h, w[0].mf[..], w[0].why[..], w[0].text[..]);
    lb: [800] u8; limits := rs_limits_json(h.limits, lb[..]);
    if scripts.count == 0 || limits.count == 0 { return fail(r, EXIT_FAIL, "the list does not fit --json: read it without"); }
    rep_raw(r, "scripts", scripts); rep_raw(r, "limits", limits);
    return rep_done(r, EXIT_OK);
  }
  code := rep_done(r, EXIT_OK);
  print("scripts (NAME HASH BYTES; handlers; what it may do; calls; on or off; its source):\n");
  for i: 0..<h.count {
    e := ss_list_entry(w[0].d[..], i, w[0].mf[..], w[0].why[..]);
    if !e.ok { continue; }
    ob: [400] u8; on := "on";
    if e.off { on = rw_with2("off, switched off by the site's admins: ", cast(string) w[0].why[0..<e.why_n], ob[..]); }
    print("  %; %; %\n", rs_what(w[0].mf[0], w[0].line[..]), on, ifx e.source then "source kept" else "no source (an uploaded module)");
  }
  if h.count == 0 { print("  none stored yet: world-script-compile or world-script-put stores one\n"); }
  print("%\n", rs_limits_line(h.limits, w[0].line[..]));
  return code;
}
rw_with2 :: (a: string, b: string, out: [] u8) -> string #effects(all) {
  n := forge_put(out, 0, a); n = forge_put(out, n, b);
  return ifx n < 0 then a else cast(string) out[0..<n];
}

// One request to the scripts routes: its method, address, body and the headers it adds.
RsRequest :: struct { ok: bool; why: string; method: string; path: string; body: string; kind: string; extra: string; }
// A built script's manifest (NAME.json, realm.script.v1 as coax/web/script.sh writes it) as the header
// X-Script-Fields: its state.fields, into out. The header's length; 0 when the script keeps no fields;
// -1 when the text is no manifest; -2 when it is another script's.
rs_fields :: (text: string, name: string, out: [] u8) -> int {
  t := text; mf: [1] ScriptManifest;
  while t.count > 0 && (t[t.count - 1] == '\n' || t[t.count - 1] == '\r') { t = t[0..<t.count - 1]; }
  if !sm_read(t, mf[..]) { return -1; }
  if cast(string) mf[0].name[0..<mf[0].name_n] != name { return -2; }
  if mf[0].layout.n == 0 { return 0; }
  nodes: [512] JvNode; d: [1] Jv;
  if !jv_parse(d[..], t, nodes[..]) { return -1; }
  n := forge_put(out, 0, "X-Script-Fields: "); n = forge_put(out, n, jv_raw(d[0], jv_path(d[0], 0, "state.fields")));
  return n;
}
// The request a scripts verb's arguments make: file is FILE's bytes, fields NAME.json's ("": no --fields).
rs_request :: (a: [] Args, verb: string, slug: string, file: string, fields: string, path: [] u8, extra: [] u8) -> RsRequest {
  q := RsRequest.{method = "POST"};
  name := rc_option(a, verb, "--name", "");
  n := forge_put(path, 0, "/api/worlds/"); n = forge_put(path, n, slug);
  if verb == "world-script-report" {
    n = forge_put(path, n, "/scripts/"); n = forge_put(path, n, rc_pos(a, verb, 3)); n = forge_put(path, n, "/report");
    q.body = rc_option(a, verb, "--why", ""); q.kind = "Content-Type: text/plain; charset=utf-8";
  } else if verb == "world-script-compile" {
    if file.count < 1 || file.count > SS_SOURCE { q.why = "FILE.coax is a realm script's Coax source, 1 to 65536 bytes"; return q; }
    n = forge_put(path, n, "/scripts/compile?name="); n = forge_put(path, n, name);
    q.body = file; q.kind = "Content-Type: text/plain; charset=utf-8";
  } else if verb == "world-script-put" {
    if file.count < 8 || file.count > WM_BYTES || file[0] != 0 || file[1..<4] != "asm" { q.why = "FILE.wasm is a built script module, at most 65536 bytes (coax/web/script.sh SOURCE.coax writes NAME.wasm and NAME.json)"; return q; }
    n = forge_put(path, n, "/scripts?name="); n = forge_put(path, n, name);
    q.body = file; q.kind = "Content-Type: application/wasm";
    if fields.count > 0 {
      got := rs_fields(fields, name, extra);
      if got == -2 { q.why = "--fields is another script's manifest: its name is not --name's"; return q; }
      if got < 0 { q.why = "--fields is NAME.json, the realm.script.v1 manifest coax/web/script.sh writes beside NAME.wasm"; return q; }
      q.extra = cast(string) extra[0..<got];
    }
  } else { q.why = "not a scripts command"; return q; }
  if n < 0 { q.why = "the request does not fit"; return q; }
  q.path = cast(string) path[0..<n]; q.ok = true;
  return q;
}
// A refusal's words (world.script.refusal.v1, read by store.coax's codec): its error, then the refused
// module's refusal name and byte, and when a daily limit lifts. "" when the answer is no such refusal.
rs_refused :: (answer: string, f: [] SsRefusal, words: [] u8, detail: [] u8, nodes: [] JvNode) -> string {
  if words.count < SS_WORDS + 80 || !ss_refusal_read(answer, f, words[0..<SS_WORDS], detail, nodes) { return ""; }
  v := f[0]; n := v.words_n;
  if v.detail_n > 0 {
    n = forge_put(words, n, " ("); n = forge_put(words, n, cast(string) detail[0..<v.detail_n]);
    if v.at >= 0 { n = forge_put(words, n, " at byte "); n = forge_put_int(words, n, v.at); }
    n = forge_put(words, n, ")");
  }
  if v.left_ms > 0 { n = forge_put(words, n, "; it lifts in "); n = forge_put_int(words, n, (v.left_ms + 59999) / 60000); n = forge_put(words, n, " minutes"); }
  return ifx n < 0 then cast(string) words[0..<v.words_n] else cast(string) words[0..<n];
}
// A stored script, answered: what it is and the command that runs it.
rs_stored :: (r: [] Rep, slug: string, mf: ScriptManifest) -> int {
  m := mf; b: [800] u8; nb: [400] u8;
  name := cast(string) m.name[0..<m.name_n]; hash := cast(string) m.hash[..];
  rep_str(r, "stored", name); rep_str(r, "hash", hash); rep_int(r, "bytes", m.bytes);
  rep_str(r, "handlers", rs_names(m.handlers, 0, b[..])); rep_str(r, "may", rs_names(m.powers, 1, b[..])); rep_str(r, "calls", rs_names(m.calls, 2, b[..]));
  rep_str(r, "next", rs_run_hint(slug, name, hash, nb[..]));
  return rep_done(r, EXIT_OK);
}
// realm world-script-compile, world-script-put and world-script-report: one request, its answer read
// through its codec. A keyed write keeps its result as the world's verbs do.
rs_send :: (a: [] Args, r: [] Rep, profile: string, verb: string, slug: string, rw: [] RwWork) -> int {
  w := [1] RsWork.[RsWork.{}];
  c := REALM_COMMANDS[rc_find(verb)];
  words := OpWords.{verb = verb, realm = slug, effect = c.effect, page = rw_page(slug, rw[0].page[..]), key = rc_option(a, verb, "--key", "")};
  file := ""; fields := "";
  if verb != "world-script-report" {
    fn := fs_read(rc_pos(a, verb, 3), w[0].body[..]);
    if fn < 0 { return fail(r, EXIT_NOT_FOUND, "FILE is not a file this computer can read, or it is over 65536 bytes"); }
    file = cast(string) w[0].body[0..<fn];
    given := rc_option(a, verb, "--fields", "");
    if given.count > 0 {
      gn := fs_read(given, w[0].fields[..]);
      if gn < 0 { return fail(r, EXIT_NOT_FOUND, "--fields is NAME.json, the manifest coax/web/script.sh writes beside NAME.wasm"); }
      fields = cast(string) w[0].fields[0..<gn];
    }
  }
  q := rs_request(a, verb, slug, file, fields, w[0].path[..], w[0].extra[..]);
  if !q.ok { return fail(r, EXIT_USAGE, q.why); }
  if rc_has(a, verb, "--dry-run") { return rw_answer(r, rw, OpResult.{ok = true, state = OR_DRY_RUN, level = ORL_SCHEMA}, words); }
  res := api_send(a, profile, q.method, q.path, q.body, q.kind, q.extra, w[0].out[..]);
  answer := cast(string) w[0].out[0..<res.n];
  if res.error != HTTP_OK { return api_fail(r, res, answer); }
  if words.key.count > 0 {
    kept := or_of_status(res.status, 0);
    if kept.state == OR_REFUSED { words.words = "the command was refused: its own answer said why"; }
    realm_key_keep(words.key, kept, or_write(kept, words, rw[0].result[..]));
  }
  if !api_ok(res) {
    said := rs_refused(answer, w[0].r[..], w[0].words[..], w[0].detail[..], w[0].nodes[..]);
    if said.count == 0 { return api_fail(r, res, answer); }
    if r[0].json { rep_int(r, "status", res.status); rep_str(r, "code", ssc_id(w[0].r[0].code)); }
    return fail(r, cli_exit_of(res.status), said);
  }
  if verb == "world-script-report" {
    hash: [64] u8;
    if ss_done_read(answer, hash[..]) != 0 || cast(string) hash[..] != rc_pos(a, verb, 3) { return fail(r, EXIT_FAIL, "the answer is not a world.script.done.v1 for this report"); }
    rep_str(r, "reported", cast(string) hash[..]); rep_str(r, "world", slug);
    rep_str(r, "next", "the site's admins read it: they keep the script or switch it off everywhere");
    return rep_done(r, EXIT_OK);
  }
  if !sm_read(answer, w[0].mf[..]) { return fail(r, EXIT_FAIL, "the answer is not a realm.script.v1 manifest"); }
  return rs_stored(r, slug, w[0].mf[0]);
}

// world-script-run: the world's scripts row that runs the script, written whole in rows.coax's shape:
// --place's row, else the row that already has that name, else the first free one. 1, or minus the
// words' length when the world has no row to give, or -1.
rw_script_row :: (a: [] Args, content: string, e: [] WorldEdit, words: [] u8) -> int {
  verb := "world-script-run";
  name := rc_option(a, verb, "--name", ""); hash := rc_option(a, verb, "--script", ""); target := rc_option(a, verb, "--for", "");
  table := rw_table(content, "scripts");
  n := 0;
  if table.count == 0 || ct_part(table, '\n', 0) != SRW_TABLE {
    n = forge_put(words, 0, "this world runs no scripts: its content has no `"); n = forge_put(words, n, SRW_TABLE); n = forge_put(words, n, "` table");
    return ifx n < 0 then -1 else -n;
  }
  place := cli_count(rc_option(a, verb, "--place", ""), 1, SH_SCRIPTS);
  if !rc_has(a, verb, "--place") {
    place = -1;
    for id: 1..<SH_SCRIPTS + 1 { row := rw_row(table, id); if place < 0 && row.count > 0 && ct_part(row, '|', 1) == name { place = id; } }
    for id: 1..<SH_SCRIPTS + 1 { if place < 0 && rw_row(table, id).count == 0 { place = id; } }
    if place < 0 {
      n = forge_put(words, 0, "the world runs "); n = forge_put_int(words, n, SH_SCRIPTS);
      n = forge_put(words, n, " scripts already, none named so: say which row to replace with --place N (realm world ID shows its scripts table)");
      return ifx n < 0 then -1 else -n;
    }
  }
  text: [WE_TEXT] u8;
  t := forge_put_int(text[..], 0, place); t = forge_put(text[..], t, "|"); t = forge_put(text[..], t, name); t = forge_put(text[..], t, "|");
  t = forge_put(text[..], t, hash); t = forge_put(text[..], t, "|"); t = forge_put(text[..], t, target);
  one: [1] ScriptRow;
  why := ifx t < 0 then SRW_BAD_FOR else srw_read(place, name, hash, target, one[..]);
  if why != SRW_OK { n = forge_put(words, 0, srw_why(why)); return ifx n < 0 then -1 else -n; }
  e[0] = rw_cell("scripts", place, "*", cast(string) text[0..<t]);
  return ifx we_valid(e[0]) then 1 else -1;
}
// The query of a world verb's batch: ?dry=1 for a dry run, and world-publish's --confirm hashes.
rw_query :: (a: [] Args, verb: string, dry: bool, out: [] u8) -> string {
  n := ifx dry then forge_put(out, 0, "?dry=1") else 0;
  confirm := ifx verb == "world-publish" then rc_option(a, verb, "--confirm", "") else "";
  if confirm.count > 0 { n = forge_put(out, n, ifx n > 0 then "&confirm=" else "?confirm="); n = forge_put(out, n, confirm); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// One script a publish asks about: its name and hash, whether it is new, and what it adds.
rs_ask_line :: (k: SsAsk, out: [] u8) -> string #effects(all) {
  q := k; b: [800] u8;
  n := forge_put(out, 0, cast(string) q.name[0..<q.name_n]); n = forge_put(out, n, " "); n = forge_put(out, n, cast(string) q.hash[..]);
  n = forge_put(out, n, ifx q.fresh then ": new; handlers " else ": does more than the live one; it adds handlers "); n = forge_put(out, n, rs_names(q.grows.handlers, 0, b[..]));
  n = forge_put(out, n, "; may "); n = forge_put(out, n, rs_names(q.grows.powers, 1, b[..]));
  n = forge_put(out, n, "; calls "); n = forge_put(out, n, rs_names(q.grows.calls, 2, b[..]));
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// The command that publishes again with every script asked about confirmed (and those --confirm named).
rs_confirm_command :: (a: [] Args, slug: string, f: SsRefusal, out: [] u8) -> string {
  v := f; verb := "world-publish";
  given := rc_option(a, verb, "--confirm", "");
  n := forge_put(out, 0, "openagents realm world-publish "); n = forge_put(out, n, slug); n = forge_put(out, n, " "); n = forge_put(out, n, rc_pos(a, verb, 3));
  n = forge_put(out, n, " --confirm "); n = forge_put(out, n, given);
  first := given.count == 0;
  for i: 0..<v.asks_n {
    hash := cast(string) v.asks[i].hash[..];
    if rc_contains(given, hash) { continue; }
    if !first { n = forge_put(out, n, ","); }
    n = forge_put(out, n, hash); first = false;
  }
  n = forge_put(out, n, " --yes");
  if args_has(a, "--origin") { n = forge_put(out, n, " --origin "); n = forge_put(out, n, args_value(a, "--origin", "")); }
  if args_has(a, "--profile") { n = forge_put(out, n, " --profile "); n = forge_put(out, n, args_value(a, "--profile", "")); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// A publish refused because scripts are new or do more than live's (world.script.refusal.v1, code grows):
// each one and what it adds, and the command that publishes with them confirmed; its words into w.words.
// False when the answer is no such refusal.
rs_grows :: (a: [] Args, r: [] Rep, slug: string, answer: string, w: [] RwWork) -> bool {
  f: [1] SsRefusal; words: [SS_WORDS] u8; detail: [SS_DETAIL] u8; nodes: [4096] JvNode;
  if !ss_refusal_read(answer, f[..], words[..], detail[..], nodes[..]) || f[0].code != SSC_GROWS { return false; }
  cmd: [RS_CONFIRM + 800] u8; line: [1600] u8;
  command := rs_confirm_command(a, slug, f[0], cmd[..]);
  if r[0].json {
    d: [1] Jv;
    if jv_parse(d[..], answer, nodes[..]) { rep_raw(r, "asks", jv_raw(d[0], jv_get(d[0], 0, "asks"))); }
    rep_str(r, "confirm", command);
  } else {
    print("the publish asks about these scripts:\n");
    for i: 0..<f[0].asks_n { print("  %\n", rs_ask_line(f[0].asks[i], line[..])); }
    print("publish them with: %\n", command);
  }
  n := ifx f[0].words_n > OR_WORDS then OR_WORDS else f[0].words_n;
  for i: 0..<n { w[0].words[i] = words[i]; }
  w[0].words_n = n;
  return true;
}

// The scripts rows' words agree with the codec's (commands.coax keeps its own copy: it loads no engine).
#test "a world's script kinds in the command table are the script row's and the store's" {
  #assert CLI_SCRIPTS == SH_SCRIPTS && rc_bound("place").max == SH_SCRIPTS && rc_bound("sname").max == SRW_NAME && SRW_NAME == SM_NAME && rc_bound("reason").max == SS_WHY && rc_bound("hashes").max == RS_CONFIRM - 1;
  for x: [10] string.["pacer", "a", "z9-x", "Pacer", "9a", "-a", "a_b", "", "a b", "a-"] { #assert rc_value("sname", x) == srw_name_ok(x) && srw_name_ok(x) == sm_name_ok(x); }
  h := "528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5";
  for x: [4] string.[h, h[0..<63], "528D98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5", ""] { #assert rc_value("hash", x) == srw_hash_ok(x); }
  one: [1] ScriptRow;
  for x: [14] string.["kind 0", "kind 255", "kind 256", "kind 01", "who 1", "who 99", "who 0", "who 100", "who 09", "kind ", "who", "foe 1", "kind 1x", "kind 12"] { #assert rc_value("sfor", x) == (srw_read(1, "a", h, x, one[..]) == SRW_OK); }
  for x: [6] string.["it strikes players", "~", "", "a \"b\"", "a\\b", "a\nb"] { #assert rc_value("reason", x) == ss_why_ok(x); }
  #assert RS_LIMIT_WORDS.count == SS_LIMIT_NAMES.count && SS_LIMIT_NAMES[SS_LIMITS - 1] == "compiler";
}
// A manifest for the checks, as the server writes one.
rs_test_manifest :: (name: string, handlers: int, powers: int, calls: int, fields: bool) -> ScriptManifest #effects(all) {
  m := ScriptManifest.{ok = true, bytes = 1234, pages = 1, state = 16, slots = 1, handlers = handlers, powers = powers, calls = calls};
  for c, i: name { m.name[i] = c; } m.name_n = name.count;
  h := "528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5"; for c, i: h { m.hash[i] = c; }
  if fields {
    f: ScriptField; fn := "turn_at"; ft := "f32";
    for c, i: fn { f.name[i] = c; } f.name_n = cast(s32) fn.count; for c, i: ft { f.type[i] = c; } f.type_n = cast(s32) ft.count; f.at = 4; f.size = 4;
    m.layout.fields[0] = f; m.layout.n = 1;
  }
  return m;
}
#test "each scripts verb's request: its address, method, body and headers" {
  path: [400] u8; extra: [SM_TEXT + 40] u8; mt: [SM_TEXT] u8;
  a: [1] Args;
  for s: [6] string.["realm","world-script-compile","splice","pacer.coax","--name","pacer"] { #assert args_add(a[..],s); }
  q := rs_request(a[..], "world-script-compile", "splice", "#script \"pacer\";\n", "", path[..], extra[..]);
  #assert q.ok && q.method == "POST" && q.path == "/api/worlds/splice/scripts/compile?name=pacer" && q.body == "#script \"pacer\";\n" && q.kind == "Content-Type: text/plain; charset=utf-8" && q.extra == "";
  q = rs_request(a[..], "world-script-compile", "splice", "", "", path[..], extra[..]);
  #assert !q.ok && q.why == "FILE.coax is a realm script's Coax source, 1 to 65536 bytes";
  module: [12] u8; module[0] = 0; module[1] = 'a'; module[2] = 's'; module[3] = 'm'; module[4] = 1;
  wasm := cast(string) module[..];
  b: [1] Args;
  for s: [8] string.["realm","world-script-put","splice","pacer.wasm","--name","pacer","--fields","pacer.json"] { #assert args_add(b[..],s); }
  manifest := sm_write(rs_test_manifest("pacer", 1 | (1 << RH_HIT), 3, (1 << SA_X) | (1 << SA_MOVE), true), mt[..]);
  #assert manifest.count > 0;
  q = rs_request(b[..], "world-script-put", "splice", wasm, manifest, path[..], extra[..]);
  #assert q.ok && q.path == "/api/worlds/splice/scripts?name=pacer" && q.body == wasm && q.kind == "Content-Type: application/wasm";
  #assert q.extra == "X-Script-Fields: [{\"name\":\"turn_at\",\"type\":\"f32\",\"at\":4,\"size\":4}]";
  // a manifest file's newline is not part of it; a script with no fields sends no header
  nl: [SM_TEXT + 2] u8; nn := forge_put(nl[..], 0, manifest); nn = forge_put(nl[..], nn, "\n");
  #assert rs_request(b[..], "world-script-put", "splice", wasm, cast(string) nl[0..<nn], path[..], extra[..]).extra == q.extra;
  mb: [SM_TEXT] u8; bare := sm_write(rs_test_manifest("pacer", 1, 1, 1 << SA_X, false), mb[..]);
  q = rs_request(b[..], "world-script-put", "splice", wasm, bare, path[..], extra[..]);
  #assert q.ok && q.extra == "" && rs_request(b[..], "world-script-put", "splice", wasm, "", path[..], extra[..]).extra == "";
  mo: [SM_TEXT] u8; other := sm_write(rs_test_manifest("guard", 1, 1, 1 << SA_X, true), mo[..]);
  #assert rs_request(b[..], "world-script-put", "splice", wasm, other, path[..], extra[..]).why == "--fields is another script's manifest: its name is not --name's";
  #assert rs_request(b[..], "world-script-put", "splice", wasm, "{}", path[..], extra[..]).why == "--fields is NAME.json, the realm.script.v1 manifest coax/web/script.sh writes beside NAME.wasm";
  #assert rs_fields("{}", "pacer", extra[..]) == -1;
  #assert rs_fields(other, "pacer", extra[..]) == -2;
  #assert rs_fields(bare, "pacer", extra[..]) == 0;
  for bad: [3] string.["", "\0asx1234", "#script \"pacer\";"] { #assert !rs_request(b[..], "world-script-put", "splice", bad, "", path[..], extra[..]).ok; }
  big: [WM_BYTES + 1] u8; big[1] = 'a'; big[2] = 's'; big[3] = 'm';
  #assert rs_request(b[..], "world-script-put", "splice", cast(string) big[0..<WM_BYTES], "", path[..], extra[..]).ok && !rs_request(b[..], "world-script-put", "splice", cast(string) big[..], "", path[..], extra[..]).ok;
  c: [1] Args; h := "528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5";
  for s: [7] string.["realm","world-script-report","splice",h,"--why","it strikes players at the gate","--yes"] { #assert args_add(c[..],s); }
  q = rs_request(c[..], "world-script-report", "splice", "", "", path[..], extra[..]);
  #assert q.ok && q.path == "/api/worlds/splice/scripts/528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5/report" && q.body == "it strikes players at the gate" && q.kind == "Content-Type: text/plain; charset=utf-8" && q.extra == "";
  #assert rs_request(c[..], "world-scripts", "splice", "", "", path[..], extra[..]).why == "not a scripts command" && !rs_request(c[..], "world-script-report", "splice", "", "", path[0..<20], extra[..]).ok;
}
#test "each scripts verb's answer: a manifest, a refusal's words, the list and the limits" {
  mt: [SM_TEXT] u8; line: [2000] u8; b: [800] u8;
  m := rs_test_manifest("pacer", 1 | (1 << RH_HIT), 3, (1 << SA_X) | (1 << SA_MOVE), true);
  read: [1] ScriptManifest;
  #assert sm_read(sm_write(m, mt[..]), read[..]);
  #assert rs_what(read[0], line[..]) == "pacer 528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5 1234 bytes; handlers on_tick, on_hit; may read, write; calls sa_x, sa_move";
  #assert rs_names(0, 0, b[..]) == "none" && rs_names(1 << 2, 1, b[..]) == "engine" && rs_names(1 << SA_STRIKE, 2, b[..]) == "sa_strike" && rs_names(3, 1, b[0..<6]) == "";
  #assert rs_run_hint("splice", "pacer", "abc", line[..]) == "openagents realm world-script-run splice --script abc --name pacer --for \"kind K\" (or \"who N\"), then world-publish";
  // a refusal: its words, the refused module's name and byte, when a daily limit lifts
  f: [1] SsRefusal; words: [SS_WORDS + 200] u8; detail: [SS_DETAIL] u8; nodes: [2048] JvNode; out: [4096] u8; none: [1] SsAsk;
  text := ss_refusal_write(SSC_MODULE, "the module check refused it", "not-wasm", 0, 0, 0, none[0..<0], out[..]);
  #assert rs_refused(text, f[..], words[..], detail[..], nodes[..]) == "the module check refused it (not-wasm at byte 0)" && f[0].code == SSC_MODULE && ssc_id(f[0].code) == ssc_id(SSC_MODULE);
  text = ss_refusal_write(SSC_RATE, "you have sent 200 modules today", "", -1, 200, 90001, none[0..<0], out[..]);
  #assert rs_refused(text, f[..], words[..], detail[..], nodes[..]) == "you have sent 200 modules today; it lifts in 2 minutes";
  text = ss_refusal_write(SSC_SOURCE, "line 3: no such name", "", -1, 0, 0, none[0..<0], out[..]);
  #assert rs_refused(text, f[..], words[..], detail[..], nodes[..]) == "line 3: no such name";
  #assert rs_refused("{\"error\":\"log in\"}", f[..], words[..], detail[..], nodes[..]) == "" && rs_refused(text, f[..], words[0..<SS_WORDS], detail[..], nodes[..]) == "";
  // the list, read by the store's codec: one line a script, the --json view and the limits in words
  lt: [20000] u8; l := ss_limits(true);
  n := ss_list_begin(lt[..], "splice", l); n = ss_list_add(lt[..], n, sm_write(m, mt[..]), true, "it strikes players", false, true); n = ss_list_end(lt[..], n);
  d: [1] Jv; world: [64] u8; why: [SS_WHY] u8; js: [4000] u8;
  hd := ss_list_read(d[..], cast(string) lt[0..<n], nodes[..], world[..]);
  #assert hd.ok && hd.count == 1;
  #assert rs_scripts_json(d[..], hd, read[..], why[..], js[..]) == "[{\"name\":\"pacer\",\"hash\":\"528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5\",\"bytes\":1234,\"handlers\":[\"on_tick\",\"on_hit\"],\"powers\":[\"read\",\"write\"],\"calls\":[\"sa_x\",\"sa_move\"],\"off\":true,\"why\":\"it strikes players\",\"source\":false}]";
  #assert rs_scripts_json(d[..], hd, read[..], why[..], js[0..<40]) == "";
  #assert rs_limits_json(hd.limits, js[..]) == "{\"scripts\":8,\"module_bytes\":65536,\"stored\":64,\"call_fuel\":20000,\"tick_fuel\":400000,\"uploads_a_day\":200,\"compiles_a_day\":100,\"reports_a_day\":20,\"source_bytes\":65536,\"why_bytes\":160,\"compiler\":1}";
  #assert rs_limits_line(hd.limits, line[..]) == "limits: 8 scripts a world runs, 65536 bytes a module, 64 modules a world stores, 20000 fuel a call, 400000 fuel a tick, 200 uploads a day, 100 compiles a day, 20 reports a day, 65536 bytes a source, 160 bytes a reason; this server compiles sources";
  #assert rs_limits_line(ss_limits(false), line[..]) == "limits: 8 scripts a world runs, 65536 bytes a module, 64 modules a world stores, 20000 fuel a call, 400000 fuel a tick, 200 uploads a day, 100 compiles a day, 20 reports a day, 65536 bytes a source, 160 bytes a reason; this server compiles no source (store built modules)";
  #assert rw_with2("a", "b", line[..]) == "ab" && rw_with2("a", "bc", line[0..<2]) == "a";
}
#test "a script run is its row of the scripts table; a publish sends --confirm and says what each script adds" {
  a: [1] Args; e: [1] WorldEdit; o: [WE_LINE] u8; words: [300] u8; h := "528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5";
  g := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  content := "aethyr.content.v1 splice 2\nreach 30000\ntable scripts id name:text hash:text for:text\n1|pacer|0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef|kind 1\n3|scout|0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef|who 9\ntable templates id name:text parts:text\n";
  // a script of a name the world runs takes its row
  for s: [9] string.["realm","world-script-run","splice","--script",h,"--name","pacer","--for","kind 2"] { #assert args_add(a[..],s); }
  #assert rw_script_row(a[..], content, e[..], words[..]) == 1 && we_write(e[0], o[..]) == "{\"op\":\"cell\",\"table\":\"scripts\",\"row\":1,\"col\":\"*\",\"v\":\"1|pacer|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 2\"}";
  // a new one takes the first free row; --place names one
  a[0] = Args.{}; for s: [9] string.["realm","world-script-run","splice","--script",h,"--name","guard","--for","who 4"] { #assert args_add(a[..],s); }
  #assert rw_script_row(a[..], content, e[..], words[..]) == 1 && cast(string) e[0].text[0..<e[0].text_n] == "2|guard|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 4" && e[0].id == 2;
  #assert args_add(a[..],"--place") && args_add(a[..],"8") && rw_script_row(a[..], content, e[..], words[..]) == 1 && e[0].id == 8 && cast(string) e[0].text[0..<e[0].text_n] == "8|guard|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 4";
  // what the row holds already is told apart from a change
  #assert rw_holds(content, rw_cell("scripts", 1, "*", "1|pacer|0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef|kind 1")) && !rw_holds(content, e[0]);
  // a world with no scripts table, or all eight taken by other names
  n := rw_script_row(a[..], "aethyr.content.v1 splice 2\nreach 30000\n", e[..], words[..]);
  #assert n < 0 && cast(string) words[0..<-n] == "this world runs no scripts: its content has no `table scripts id name:text hash:text for:text` table";
  full: [2000] u8; fn := forge_put(full[..], 0, "table scripts id name:text hash:text for:text\n");
  for id: 1..<9 { fn = forge_put_int(full[..], fn, id); fn = forge_put(full[..], fn, "|s"); fn = forge_put_int(full[..], fn, id); fn = forge_put(full[..], fn, "|"); fn = forge_put(full[..], fn, g); fn = forge_put(full[..], fn, "|kind 1\n"); }
  a[0] = Args.{}; for s: [9] string.["realm","world-script-run","splice","--script",h,"--name","guard","--for","who 4"] { #assert args_add(a[..],s); }
  n = rw_script_row(a[..], cast(string) full[0..<fn], e[..], words[..]);
  #assert n < 0 && cast(string) words[0..<-n] == "the world runs 8 scripts already, none named so: say which row to replace with --place N (realm world ID shows its scripts table)";
  a[0] = Args.{}; for s: [9] string.["realm","world-script-run","splice","--script",h,"--name","s5","--for","who 4"] { #assert args_add(a[..],s); }
  #assert rw_script_row(a[..], cast(string) full[0..<fn], e[..], words[..]) == 1 && e[0].id == 5;
  #assert rw_script_row(a[..], "aethyr.content.v1 splice 2\n", e[..], words[0..<5]) == -1;
  // the publish's query, and the refusal of one that adds scripts
  b: [1] Args; q: [RS_CONFIRM + 32] u8;
  for s: [4] string.["realm","world-publish","splice","now"] { #assert args_add(b[..],s); }
  #assert rw_query(b[..], "world-publish", false, q[..]) == "" && rw_query(b[..], "world-publish", true, q[..]) == "?dry=1";
  #assert args_add(b[..],"--confirm") && args_add(b[..],g);
  #assert rw_query(b[..], "world-publish", false, q[..]) == "?confirm=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" && rw_query(b[..], "world-publish", true, q[..]) == "?dry=1&confirm=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  #assert rw_query(b[..], "world-move", true, q[..]) == "?dry=1" && rw_query(b[..], "world-publish", false, q[0..<10]) == "";
  asks: [2] SsAsk;
  for c, i: "pacer" { asks[0].name[i] = c; } asks[0].name_n = 5; for c, i: h { asks[0].hash[i] = c; } asks[0].fresh = true; asks[0].grows = ScriptGrowth.{handlers = 1, powers = 3, calls = 1 << SA_X};
  for c, i: "guard" { asks[1].name[i] = c; } asks[1].name_n = 5; for c, i: g { asks[1].hash[i] = c; } asks[1].grows = ScriptGrowth.{powers = 4, calls = 1 << SA_STRIKE};
  out: [4096] u8; words2: [SS_WORDS] u8; detail: [SS_DETAIL] u8; nodes: [2048] JvNode; f: [1] SsRefusal; line: [1000] u8; cmd: [RS_CONFIRM + 800] u8;
  text := ss_refusal_write(SSC_GROWS, "these scripts are new or do more than the live ones: confirm each by its hash", "", -1, 0, 0, asks[..], out[..]);
  #assert ss_refusal_read(text, f[..], words2[..], detail[..], nodes[..]) && f[0].asks_n == 2;
  #assert rs_ask_line(f[0].asks[0], line[..]) == "pacer 528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5: new; handlers on_tick; may read, write; calls sa_x";
  #assert rs_ask_line(f[0].asks[1], line[..]) == "guard 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef: does more than the live one; it adds handlers none; may engine; calls sa_strike";
  // the command confirms every script asked about, after those --confirm named already
  #assert rs_confirm_command(b[..], "splice", f[0], cmd[..]) == "openagents realm world-publish splice now --confirm 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5 --yes";
  c: [1] Args; for s: [7] string.["realm","world-publish","splice","next","--origin","http://127.0.0.1:9538","--yes"] { #assert args_add(c[..],s); }
  #assert rs_confirm_command(c[..], "splice", f[0], cmd[..]) == "openagents realm world-publish splice next --confirm 528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5,0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --yes --origin http://127.0.0.1:9538";
  #assert rs_confirm_command(c[..], "splice", f[0], cmd[0..<20]) == "";
  // the CLI's reading of that answer: the words, and the asks and the command for --json
  r := [1] Rep.[Rep.{json = true}]; w := [1] RwWork.[RwWork.{}];
  #assert rs_grows(c[..], r[..], "splice", text, w[..]) && cast(string) w[0].words[0..<w[0].words_n] == "these scripts are new or do more than the live ones: confirm each by its hash";
  said := cast(string) r[0].buf[0..<r[0].n];
  #assert rc_contains(said, "\"asks\":[{\"name\":\"pacer\"") && rc_contains(said, "\"confirm\":\"openagents realm world-publish splice next --confirm 528d");
  #assert !rs_grows(c[..], r[..], "splice", "{\"error\":\"edit 1: stale\"}", w[..]) && !rs_grows(c[..], r[..], "splice", ss_refusal_write(SSC_RATE, "slow down", "", -1, 0, 1, asks[0..<0], out[..]), w[..]);
}
