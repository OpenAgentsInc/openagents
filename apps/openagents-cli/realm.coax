// Realm edit effects. Input bounds and the command catalogue are pure Coax
// policies; SQL owns the atomic revision comparison. Every edit reads its
// base, sends that revision, and refuses a server without the fence capability.
#load "commands.coax";
#load "../../metaverse-engine/editor/doc.coax";   // the realm document and its bodies (realm.proto): one codec
#load "../../metaverse-engine/editor/change.coax";   // the edits' bodies (edits.proto): one codec
#load "../../metaverse-engine/editor/board.coax";   // the plan's and the make's bodies and the board's lines: one codec
#load "../../metaverse-engine/editor/made.coax";   // a made or forked realm's answer and a fork's body (made.proto): one codec
#load "../../metaverse-engine/editor/record.coax";   // mine, visibility, publish and the publish record (record.proto): one codec
#load "../../coax/lib/text/base64.coax";
#load "realm-world.coax";
#load "realm-files.coax";   // the rows for a world's attachments and its project's (#13468)   // the rows that edit a world with an ID, and the one result every operation answers

REALM_DOC_MAX :: 368640;
REALM_DOC_BODY :: 524288;

// Reads may return the document as JSON or the page's compact line protocol.
realm_read :: (a: [] Args, r: [] Rep, profile: string, tail: string) -> int {
  out: [API_OUT] u8; path: [256] u8;
  res := api_call(a,profile,"GET",realm_path(positional(a,2),tail,path[..]),"",out[..]);
  body := cast(string) out[0..<res.n];
  if !api_ok(res) { return api_fail(r,res,body); }
  if tail == "/doc" {
    if !rep_object(r,body) { return fail(r,EXIT_FAIL,"the document answer isn't a complete JSON object"); }
    return rep_done(r,EXIT_OK);
  }
  if !r[0].json { print("%",body); return EXIT_OK; }
  rep_str(r,"slug",positional(a,2)); rep_str(r,"lines",body);
  return rep_done(r,EXIT_OK);
}

realm_edit_answer :: (r: [] Rep, res: ApiAnswer, body: string) -> int {
  if res.error == HTTP_OK && res.status == 409 {
    c := editor_read_reply(body);   // realm.proto's Conflict: the revision there now
    if c.ok { rep_int(r,"rev",c.rev); }
  }
  if !api_ok(res) { return api_fail(r,res,body); }
  rev := realm_reply_rev(body);
  if rev < 1 { return fail(r,EXIT_FAIL,"the edit returned no valid revision; read the realm before retrying"); }
  if !rep_object(r,body) {
    rep_str(r,"lines",body);
    v := cli_count(editor_spec_value(body,"rev"),1,999999999);
    if v >= 1 { rep_int(r,"rev",v); }
  }
  return rep_done(r,EXIT_OK);
}

// A synthetic refusal uses the same body/status as the server, before effects.
realm_edit_refuse :: (status: int, message: string, rev: int, out: [] u8) -> ApiAnswer {
  o: [1] Jo; jo_start(o[..],out); jo_obj(o[..]);
  jo_key(o[..],"error"); jo_str(o[..],message);
  if rev >= 1 { jo_key(o[..],"rev"); jo_int(o[..],rev); }
  jo_end(o[..]);
  return ApiAnswer.{error=HTTP_OK,status=status,n=o[0].n,keyed=true};
}

realm_edit_tail :: (verb: string, id: string, out: [] u8) -> string {
  c := REALM_COMMANDS[rc_find(verb)];
  if verb == "ask-delete" || verb == "ask-done" || verb == "row-delete" || verb == "accept" || verb == "decline" {
    n := editor_put(out,0,ifx verb == "row-delete" then "/rows/" else ifx verb == "ask-delete" || verb == "ask-done" then "/asks/" else "/proposals/");
    n = editor_put(out,n,id);
    n = editor_put(out,n,ifx verb == "ask-done" then "/done" else ifx verb == "accept" then "/accept" else ifx verb == "decline" then "/decline" else "/delete");
    return ifx n < 0 then "" else cast(string) out[0..<n];
  }
  return c.route;
}

realm_edit_doc :: (a: [] Args, profile: string, slug: string, rev: int, out: [] u8) -> ApiAnswer {
  file := rc_option(a,"ask","--doc","");
  size := fs_size(file);
  if size <= 0 || size > REALM_DOC_MAX { return realm_edit_refuse(400,"--doc is a nonempty file of at most 360 KiB",-1,out); }
  bytes: [REALM_DOC_MAX+1] u8;
  n := fs_read(file,bytes[..]);
  if n <= 0 || n > REALM_DOC_MAX { return realm_edit_refuse(400,"--doc is a nonempty file of at most 360 KiB",-1,out); }
  encoded: [491520] u8; en := b64_encode(cast(string) bytes[0..<n],encoded[..]);
  if en < 0 { return realm_edit_refuse(400,"the document did not encode",-1,out); }
  buf: [REALM_DOC_BODY] u8;
  bn := editor_ask_doc_body(rev,fs_base(file),cast(string) encoded[0..<en],buf[..]);   // edits.proto's AskDocRequest (metaverse-engine/editor/change.coax)
  if bn < 0 { return realm_edit_refuse(400,"the document is too large",-1,out); }
  path: [256] u8;
  return api_call(a,profile,"POST",realm_path(slug,"/edit-v1/asks/doc",path[..]),cast(string) buf[0..<bn],out);
}

// expected < 1 means read the revision now. Batch calls instead carry the last
// accepted revision forward, so a concurrent writer stops the remaining batch.
realm_edit_run :: (a: [] Args, profile: string, verb: string, expected: int, out: [] u8) -> ApiAnswer {
  slug := rc_pos(a,verb,2);
  specbuf: [API_OUT] u8; path: [256] u8;
  read := api_call(a,profile,"GET",realm_path(slug,"",path[..]),"",specbuf[..]);
  spec := cast(string) specbuf[0..<read.n];
  if !api_ok(read) {
    n := copy(spec,out);
    if n < 0 { return realm_edit_refuse(400,"the answer buffer is too small",-1,out); }
    read.n = n; return read;
  }
  current := cli_count(editor_spec_value(spec,"rev"),1,999999999);
  if current < 1 { return realm_edit_refuse(400,"that realm has no versioned document",-1,out); }
  rev := expected;
  if rev < 1 && rc_has(a,verb,"--rev") { rev = cli_count(rc_option(a,verb,"--rev",""),1,999999999); }
  if rev < 1 { rev = current; }
  if rev != current { return realm_edit_refuse(409,"changed since",current,out); }
  fork_publish := false;
  if verb == "publish" {
    docbuf: [API_OUT] u8;
    got := api_call(a,profile,"GET",realm_path(slug,"/doc",path[..]),"",docbuf[..]);
    if !api_ok(got) {
      copied := copy(cast(string) docbuf[0..<got.n],out);
      if copied < 0 { return realm_edit_refuse(400,"the answer buffer is too small",-1,out); }
      got.n=copied; return got;
    }
    base := editor_read_base(cast(string) docbuf[0..<got.n]);   // the document's base: null, or the realm a fork came from
    if !base.ok { return realm_edit_refuse(400,"the realm has no supported publication profile",rev,out); }
    fork_publish = base.fork;
    if fork_publish && editor_spec_value(spec,"edit_fence") != "1" { return realm_edit_refuse(400,"built-in fork publication needs revision-fenced routes (migration 0102)",rev,out); }
  }
  if realm_shape_verb(verb) && editor_spec_value(spec,"shapes") != "1" {
    return realm_edit_refuse(400,"this server keeps no turns, sizes or removals (migration 0109)",current,out);
  }
  if !realm_save_verb(verb) && verb != "undo" && verb != "redo" && verb != "publish" && editor_spec_value(spec,"edit_fence") != "1" {
    return realm_edit_refuse(400,"this server needs revision-fenced edit routes (migration 0102)",current,out);
  }
  if verb == "ask" && rc_has(a,verb,"--doc") { return realm_edit_doc(a,profile,slug,rev,out); }
  buf: [API_BODY_MAX] u8;
  if realm_save_verb(verb) {
    doc: [1] EditorDoc; editor_reset(doc[..],rev);
    if !cli_edit_read_moves(spec,doc[..]) { return realm_edit_refuse(400,"the realm's move list did not read",rev,out); }
    if !realm_save_edit(a,verb,doc[..]) { return realm_edit_refuse(400,"the edit does not fit the document",rev,out); }
    n := editor_save_body(doc[..],buf[..]);
    if n < 0 { return realm_edit_refuse(400,"the move body is too large",rev,out); }
    return api_call(a,profile,"POST",realm_path(slug,"/save",path[..]),cast(string) buf[0..<n],out);
  }
  if verb == "undo" || verb == "redo" {
    n := editor_rev_body(rev,buf[..]);   // realm.proto's RevRequest, {"rev":N}
    tb: [128] u8;
    return api_call(a,profile,"POST",realm_path(slug,realm_edit_tail(verb,"",tb[..]),path[..]),cast(string) buf[0..<n],out);
  }
  // record.proto's VisibilityRequest and a made realm's PublishRequest: record.coax writes them
  if verb == "visibility" || (verb == "publish" && !fork_publish) {
    n := ifx verb == "visibility" then editor_visibility_body(rev,rc_pos(a,verb,3),buf[..])
         else ifx rc_has(a,verb,"--listed") then editor_publish_body(rev,true,buf[..]) else editor_rev_body(rev,buf[..]);
    if n < 0 { return realm_edit_refuse(400,"the visibility is private, unlisted or public",rev,out); }
    return api_call(a,profile,"POST",realm_path(slug,ifx verb == "visibility" then "/edit-v1/visibility" else "/publish",path[..]),cast(string) buf[0..<n],out);
  }
  // edits.proto's bodies, the revision first (metaverse-engine/editor/change.coax writes each)
  v := rc_pos(a,verb,3);
  bn := -1;
  if verb == "revise" { bn = editor_words_body(rev,"prompt",v,false,buf[..]); }
  else if verb == "ask" { bn = editor_words_body(rev,"words",v,false,buf[..]); }
  else if verb == "ask-done" { bn = editor_words_body(rev,"commit",rc_option(a,verb,"--commit",""),false,buf[..]); }
  else if verb == "lore" { bn = editor_lore_body(rev,v,rc_pos(a,verb,4),false,buf[..]); }
  else if verb == "quest" {
    steps: [3] string; sn := 0;
    for i: 0..<3 { if rc_option_index(a,verb,"--step",i) >= 0 { steps[sn] = rc_option_at(a,verb,"--step",i); sn += 1; } }
    bn = editor_quest_body(rev,v,rc_option(a,verb,"--ask",""),steps[0..<sn],rc_option(a,verb,"--reward",""),false,buf[..]);
  }
  else if verb == "publish" && rc_has(a,verb,"--listed") { bn = editor_publish_body(rev,true,buf[..]); }   // a fork's publish, listed
  else { bn = editor_rev_body(rev,buf[..]); }   // accept, decline, the two deletes, a fork's publish: {"rev":N}
  if bn < 0 { return realm_edit_refuse(400,"the edit body is too large",rev,out); }
  tailbuf: [128] u8; tail := realm_edit_tail(verb,v,tailbuf[..]);
  fenced: [160] u8;
  if verb != "undo" && verb != "redo" && (verb != "publish" || fork_publish) { n := editor_put(fenced[..],0,"/edit-v1"); n = editor_put(fenced[..],n,tail); tail = cast(string) fenced[0..<n]; }
  return api_call(a,profile,"POST",realm_path(slug,tail,path[..]),cast(string) buf[0..<bn],out);
}

realm_edit :: (a: [] Args, r: [] Rep, profile: string, verb: string) -> int {
  out: [API_OUT] u8;
  res := realm_edit_run(a,profile,verb,-1,out[..]);
  return realm_edit_answer(r,res,cast(string) out[0..<res.n]);
}

// The edits a /save carries: a move, and (0109) a turn, a size or a removal.
realm_shape_verb :: (verb: string) -> bool { return verb == "rotate" || verb == "resize" || verb == "remove"; }
realm_save_verb :: (verb: string) -> bool { return verb == "move" || realm_shape_verb(verb); }
// One such edit onto the document read (metaverse-engine/editor/edit.coax's typed operations); one already so is no change.
realm_save_edit :: (a: [] Args, verb: string, doc: [] EditorDoc) -> bool {
  key := rc_pos(a,verb,3); was := editor_shape_of(doc,key);
  if verb == "move" {
    x := cli_edit_cm(rc_pos(a,verb,4)); z := cli_edit_cm(rc_pos(a,verb,5));
    return (was.at && was.x == x && was.z == z) || editor_move(doc,key,x,z);
  }
  if verb == "rotate" {
    y := rc_pos(a,verb,4); neg := y.count > 0 && y[0] == '-';
    amount := cli_count(ifx neg then y[1..<y.count] else y,0,360);
    turn := editor_turn(ifx neg then -amount else amount);
    return amount >= 0 && (was.yaw == turn || editor_rotate(doc,key,turn));
  }
  if verb == "resize" { p := cli_count(rc_pos(a,verb,4),25,400); return p >= 25 && (was.scale == p || editor_resize(doc,key,p)); }
  return was.gone || editor_remove(doc,key);
}

RealmLine :: struct { first: int; end: int; next: int; }
realm_line :: (text: string, at: int) -> RealmLine {
  e := at; while e < text.count && text[e] != '\n' { e += 1; }
  next := ifx e < text.count then e+1 else e;
  s := at;
  while s < e && (text[s] == ' ' || text[s] == '\t' || text[s] == '\r') { s += 1; }
  while e > s && (text[e-1] == ' ' || text[e-1] == '\t' || text[e-1] == '\r') { e -= 1; }
  return RealmLine.{first=s,end=e,next=next};
}

// Non-atomic JSON lines: only committed operations count as applied. A group
// of adjacent moves, turns, sizes and removals is one /save and therefore one undo step.
realm_apply :: (a: [] Args, r: [] Rep, profile: string) -> int {
  slug := rc_pos(a,"apply",2); file := rc_pos(a,"apply",3);
  size := fs_size(file);
  if size < 1 || size > 65536 { return fail(r,EXIT_USAGE,"apply needs a nonempty JSON-lines file of at most 64 KiB"); }
  input: [65537] u8; n := fs_read(file,input[..]);
  if n < 1 || n > 65536 { return fail(r,EXIT_USAGE,"the batch file did not fit"); }
  text := cast(string) input[0..<n]; at := 0; applied := 0; line := 1;
  expected := ifx rc_has(a,"apply","--rev") then cli_count(rc_option(a,"apply","--rev",""),1,999999999) else -1;
  out: [API_OUT] u8; b: [1] Args;
  while at < text.count {
    span := realm_line(text,at);
    if span.first == span.end { at=span.next; line+=1; continue; }
    bad := ifx applied >= 256 then RbWhy.{why="a batch has at most 256 operations"} else rb_check(text[span.first..<span.end],slug,b[..]);
    if bad.why != "" {
      rep_int(r,"applied",applied); rep_int(r,"line",line); if expected >= 1 { rep_int(r,"rev",expected); }
      if bad.field != "" { rep_str(r,"field",bad.field); }
      said: [1024] u8;
      lt: [24] u8; m := editor_put(said[..],0,"line "); m = editor_put(said[..],m,int_text(line,lt[..]));
      if bad.field != "" { m = editor_put(said[..],m,": field \""); m = editor_put(said[..],m,bad.field); m = editor_put(said[..],m,"\""); }
      m = editor_put(said[..],m,ifx bad.field != "" then " " else ": "); m = editor_put(said[..],m,bad.why);
      m = editor_put(said[..],m," (openagents help: realm apply's FILE)");
      if applied > 0 {
        at_text: [24] u8; rev_text: [24] u8;
        m = editor_put(said[..],m,"; applied before it: "); m = editor_put(said[..],m,int_text(applied,at_text[..]));
        m = editor_put(said[..],m,", and the realm is now at rev "); m = editor_put(said[..],m,int_text(expected,rev_text[..]));
      }
      return fail(r,EXIT_USAGE,ifx m < 0 then bad.why else cast(string) said[0..<m]);
    }
    if rc_has(a,"apply","--origin") {
      added := args_add(b[..],"--origin") && args_add(b[..],rc_option(a,"apply","--origin",""));
      if !added { return fail(r,EXIT_USAGE,"batch arguments did not fit"); }
    }
    // The parser always emits realm, verb, slug before any flags.
    verb := args_at(b[..],1);
    res: ApiAnswer;
    if realm_save_verb(verb) {
      path: [256] u8; specbuf: [API_OUT] u8;
      read := api_call(a,profile,"GET",realm_path(slug,"",path[..]),"",specbuf[..]);
      if !api_ok(read) {
        rep_int(r,"applied",applied); return api_fail(r,read,cast(string) specbuf[0..<read.n]);
      }
      spec := cast(string) specbuf[0..<read.n]; current := cli_count(editor_spec_value(spec,"rev"),1,999999999);
      if current < 1 { rep_int(r,"applied",applied); return fail(r,EXIT_USAGE,"that realm has no versioned document"); }
      if expected < 1 { expected=current; }
      if current != expected {
        rep_int(r,"applied",applied); res=realm_edit_refuse(409,"changed since",current,out[..]);
        return realm_edit_answer(r,res,cast(string) out[0..<res.n]);
      }
      doc: [1] EditorDoc; editor_reset(doc[..],expected);
      if !cli_edit_read_moves(spec,doc[..]) { rep_int(r,"applied",applied); return fail(r,EXIT_FAIL,"the realm's move list did not read"); }
      shapes := editor_spec_value(spec,"shapes") == "1";
      count := 0;
      while at < text.count && applied+count < 256 {
        span=realm_line(text,at);
        if span.first == span.end { at=span.next; line+=1; continue; }
        if !rb_args(text[span.first..<span.end],slug,b[..]) || !realm_save_verb(args_at(b[..],1)) { break; }
        if realm_shape_verb(args_at(b[..],1)) && !shapes {
          rep_int(r,"applied",applied); rep_int(r,"line",line);
          return fail(r,EXIT_USAGE,"this server keeps no turns, sizes or removals (migration 0109)");
        }
        if !realm_save_edit(b[..],args_at(b[..],1),doc[..]) { break; }
        count+=1; at=span.next; line+=1;
      }
      if count == 0 { rep_int(r,"applied",applied); rep_int(r,"line",line); return fail(r,EXIT_USAGE,"the move, turn, size or removal group does not fit the document"); }
      body: [API_BODY_MAX] u8; bn := editor_save_body(doc[..],body[..]);
      if bn < 0 { rep_int(r,"applied",applied); return fail(r,EXIT_USAGE,"the move group body does not fit"); }
      res=api_call(a,profile,"POST",realm_path(slug,"/save",path[..]),cast(string) body[0..<bn],out[..]);
      if !api_ok(res) { rep_int(r,"applied",applied); rep_int(r,"line",line-count); return realm_edit_answer(r,res,cast(string) out[0..<res.n]); }
      applied+=count;
    } else {
      res=realm_edit_run(b[..],profile,verb,expected,out[..]);
      if !api_ok(res) { rep_int(r,"applied",applied); rep_int(r,"line",line); return realm_edit_answer(r,res,cast(string) out[0..<res.n]); }
      applied+=1; at=span.next; line+=1;
    }
    expected=realm_reply_rev(cast(string) out[0..<res.n]);
    if expected < 1 {
      rep_int(r,"applied",applied); return fail(r,EXIT_FAIL,"the batch stopped after an edit returned no revision; read the realm before retrying");
    }
  }
  rep_int(r,"applied",applied); if expected >= 1 { rep_int(r,"rev",expected); }
  return rep_done(r,EXIT_OK);
}

// The realm domain: your realms on openagents.com, over the same routes the
// page uses (coax/web/api/realms.c), each request signed with NIP-98 by the
// profile's key, so the key's account is the caller. The server decides every
// right; this file sends the words and reads the answers (realm_rules.coax).

realm_usage :: () {
  print("%\n", "Realms (openagents.com/realms):");
  line: [512] u8;
  for c: REALM_COMMANDS { print("%\n", rc_help_line(c, line[..])); }
  print("%\n", "  Each line ends with what the command does and who must agree: [read], [write; the owner], [destructive; asks first: --yes].");
  print("%\n", "  A command that is not a read also takes --dry-run (nothing is sent or saved; the answer says how far the check went)");
  print("%\n", "  and --key K (a repeat with the same key answers the first result and sends nothing).");
  ops: [1024] u8;
  print("%\n", "  realm apply's FILE: one JSON object a line, {\"op\":OP, ...its fields}; a revision goes in --rev, not a line:");
  print("%\n", "    {\"op\":\"move\",\"entity\":\"trees:3\",\"x\":4.5,\"z\":-2}   {\"op\":\"rotate\",\"entity\":\"trees:3\",\"yaw\":90}   {\"op\":\"switch\",\"row\":\"water\",\"on\":false}");
  print("    ops and fields (? optional): %\n", rb_help(ops[..]));
  print("%\n", "");
}

// Its page: /realms/SLUG, or /realms/built#SLUG while it is private (no page is written for it).
realm_page :: (a: [] Args, profile: string, slug: string, visibility: string, out: [] u8) -> string {
  env: [300] u8;
  n := copy(acct_origin(a, profile, env[..]), out);
  n += copy(ifx visibility == "private" then "/realms/built#" else "/realms/", out[n..<out.count]);
  n += copy(slug, out[n..<out.count]);
  return cast(string) out[0..<n];
}

realm_path :: (slug: string, tail: string, out: [] u8) -> string {
  n := copy("/api/playtest/realms/", out);
  n += copy(slug, out[n..<out.count]);
  n += copy(tail, out[n..<out.count]);
  return cast(string) out[0..<n];
}

// text, then spaces to width (at least one).
realm_cell :: (out: [] u8, at: int, text: string, width: int) -> int #effects(all) {
  n := editor_put(out,editor_put(out,at,text)," ");
  w := text.count + 1;
  while w < width { n = editor_put(out,n," "); w += 1; }
  return n;
}

// realm list's text: one aligned row a realm under a header, from the
// server's "realm SLUG|REV|PUBLISHED|LISTED|NAME|VISIBILITY" lines
// (published 0: never); "realms 0" when there are none. A line of another
// shape is kept as it came. Its length, or -1 when out is short. The lines are read through
// metaverse-engine/editor/record.coax (record.proto's MineRealm).
#test "realm list reads as aligned columns, not pipe rows" {
  out: [1024] u8;
  t := "realm night-garden|1|1|0|Night Garden|private\nrealm walled-garden|12|0|1|Walled Garden|public\n";
  n := realm_rows(t, out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "SLUG           VISIBILITY  REV  PUBLISHED  NAME\nnight-garden   private     1    1          Night Garden\nwalled-garden  public      12   never      Walled Garden\n";
  n = realm_rows("", out[..]);
  #assert cast(string) out[0..<n] == "realms 0\n";
  n = realm_rows("\n\n", out[..]);
  #assert cast(string) out[0..<n] == "realms 0\n";
  n = realm_rows("realm a|2|2|0|A|unlisted\nnote x", out[..]);
  #assert cast(string) out[0..<n] == "SLUG  VISIBILITY  REV  PUBLISHED  NAME\na     unlisted    2    2          A\nnote x\n";
  n = realm_rows("realm a|2|2|0|A|", out[..]);
  #assert cast(string) out[0..<n] == "SLUG  VISIBILITY  REV  PUBLISHED  NAME\na     public      2    2          A\n";
  #assert realm_rows(t, out[0..<40]) == -1 && realm_rows("", out[0..<3]) == -1;
  n = realm_rows("note x", out[..]);
  #assert cast(string) out[0..<n] == "note x\n";
  n = realm_rows("\nrealm abcdefg|2|2|0|A|unlisted", out[..]);
  #assert cast(string) out[0..<n] == "SLUG     VISIBILITY  REV  PUBLISHED  NAME\nabcdefg  unlisted    2    2          A\n";
  n = realm_rows("realm a-very-long-realm-slug-name|123456|99|0|N|private", out[..]);
  #assert cast(string) out[0..<n] == "SLUG                         VISIBILITY  REV  PUBLISHED  NAME\na-very-long-realm-slug-name  private     123456 99         N\n";
}
realm_rows :: (text: string, out: [] u8) -> int #effects(all) {
  slug_w := 4; rows := false; at := 0;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    m: [1] EditorMine; m[0] = editor_read_mine_line(text[at..<end]); at = end + 1;   // record.proto's MineRealm, a line
    if m[0].slug_n == 0 { continue; }
    while slug_w < m[0].slug_n { slug_w += 1; }
    rows = true;
  }
  n := 0;
  if rows {
    n = realm_cell(out,n,"SLUG",slug_w + 2); n = realm_cell(out,n,"VISIBILITY",12); n = realm_cell(out,n,"REV",5); n = realm_cell(out,n,"PUBLISHED",11); n = editor_put(out,n,"NAME\n");
  }
  at = 0; others := false;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    line := text[at..<end]; at = end + 1;
    if line.count == 0 { continue; }
    m: [1] EditorMine; m[0] = editor_read_mine_line(line);
    if m[0].slug_n == 0 { n = editor_put(out,n,line); n = editor_put(out,n,"\n"); others = true; continue; }
    rb: [24] u8; pb: [24] u8;
    rn := editor_put_int(rb[..],0,m[0].rev); pn := editor_put_int(pb[..],0,m[0].published);
    n = realm_cell(out,n,editor_mine_slug(m[..]),slug_w + 2);
    n = realm_cell(out,n,editor_mine_vis(m[..]),12);
    n = realm_cell(out,n,cast(string) rb[0..<rn],5);
    n = realm_cell(out,n,ifx m[0].published == 0 then "never" else cast(string) pb[0..<pn],11);
    n = editor_put(out,n,editor_mine_name(m[..])); n = editor_put(out,n,"\n");
  }
  if !rows && !others { n = editor_put(out,n,"realms 0\n"); }
  return n;
}

// A server on this computer: http://127.0.0.1[:PORT] or http://localhost[:PORT].
realm_local_origin :: (o: string) -> bool {
  for h: [2] string.["http://127.0.0.1", "http://localhost"] {
    if o.count >= h.count && o[0..<h.count] == h && (o.count == h.count || o[h.count] == ':') { return true; }
  }
  return false;
}
#test "a dev server's origin is this computer's" {
  #assert realm_local_origin("http://127.0.0.1:9538") && realm_local_origin("http://localhost") && realm_local_origin("http://127.0.0.1");
  #assert !realm_local_origin("https://openagents.com") && !realm_local_origin("http://127.0.0.10:1") && !realm_local_origin("http://localhost.example.com");
}

realm_list :: (a: [] Args, r: [] Rep, profile: string) -> int {
  out: [API_OUT] u8;
  res := api_call(a, profile, "GET", ifx r[0].json then "/api/playtest/realms/mine" else "/api/playtest/realms/mine?as=lines", "", out[..]);
  body := cast(string) out[0..<res.n];
  if res.error == HTTP_OK && res.status == 404 { return fail(r, EXIT_FAIL, "this server has no list of your realms yet (GET /api/playtest/realms/mine)"); }
  if !api_ok(res) { return api_fail(r, res, body); }
  // With no key a deployed site can't tell whose realms to list and answers none: say so, never an empty list.
  // A dev server on this computer (http://127.0.0.1) takes an unsigned request as its own login (auth.c local_admin).
  if !res.keyed && !realm_local_origin(cast(string) res.origin[0..<res.origin_n]) {
    return fail(r, EXIT_AUTH, "not logged in on this profile, so no server knows whose realms to list: run `openagents login` (or pass --profile)");
  }
  if !r[0].json {
    rows: [API_OUT] u8; n := realm_rows(body, rows[..]);
    if n < 0 { return fail(r, EXIT_FAIL, "your realms do not fit the answer buffer"); }
    print("%", cast(string) rows[0..<n]);
    // the worlds you may edit, as the site's side lists them under Worlds (GET /api/worlds: "world ID NAME" lines)
    wo: [API_OUT] u8;
    wr := api_call(a, profile, "GET", "/api/worlds", "", wo[..]);
    if api_ok(wr) && wr.n > 0 { print("%\n", "worlds you may edit:"); print("%", cast(string) wo[0..<wr.n]); }
    return EXIT_OK;
  }
  if !rep_object(r, body) { return fail(r, EXIT_FAIL, "the server's answer isn't JSON"); }
  // and "worlds": the worlds you may edit, the list the site's side shows under Worlds (GET /api/worlds), so an
  // agent asked "what worlds do I have" answers what the page shows (#13493)
  wo: [API_OUT] u8; wj: [API_OUT] u8;
  wr := api_call(a, profile, "GET", "/api/worlds", "", wo[..]);
  if api_ok(wr) {
    wn := realm_worlds_json(cast(string) wo[0..<wr.n], wj[..]);
    if wn > 0 { rep_raw(r, "worlds", cast(string) wj[0..<wn]); }
  }
  return rep_done(r, EXIT_OK);
}
// GET /api/worlds' lines, "world ID NAME", as a JSON array of {"id", "name"}: its length, or -1 when out is short.
realm_worlds_json :: (lines: string, out: [] u8) -> int {
  n := copy("[", out); if n < 0 { return -1; }
  count := 0; at := 0;
  for end: 0..<lines.count + 1 {
    if end < lines.count && lines[end] != '\n' { continue; }
    l := lines[at..<end]; at = end + 1;
    if l.count < 7 || l[0..<6] != "world " { continue; }
    sp := 6; while sp < l.count && l[sp] != ' ' { sp += 1; }
    id := l[6..<sp]; name := ifx sp < l.count then l[sp + 1..<l.count] else id;
    if id.count == 0 { continue; }
    parts := [5] string.[ifx count > 0 then ",{\"id\":" else "{\"id\":", "", ",\"name\":", "", "}"];
    for k: 0..<5 {
      m := ifx k == 1 then ar_json_str(id, out[n..<out.count]) else ifx k == 3 then ar_json_str(name, out[n..<out.count]) else copy(parts[k], out[n..<out.count]);
      if m < 0 { return -1; }
      n += m;
    }
    count += 1;
  }
  m := copy("]", out[n..<out.count]); if m < 0 { return -1; }
  return n + m;
}
#test "the side's worlds as JSON" {
  b: [200] u8;
  n := realm_worlds_json("world splice-bots Splice Bots\nworld a-b a \"q\"\n", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "[{\"id\":\"splice-bots\",\"name\":\"Splice Bots\"},{\"id\":\"a-b\",\"name\":\"a \\\"q\\\"\"}]";
  #assert cast(string) b[0..<realm_worlds_json("", b[..])] == "[]" && realm_worlds_json("world x y\n", b[0..<5]) == -1;
}

realm_show :: (a: [] Args, r: [] Rep, profile: string) -> int {
  slug := positional(a, 2);
  if !cli_slug_ok(slug) { return fail(r, EXIT_USAGE, "realm show SLUG: a slug is 1 to 48 of a-z, 0-9 and -"); }
  out: [API_OUT] u8; p: [128] u8; pg: [400] u8;
  res := api_call(a, profile, "GET", realm_path(slug, "", p[..]), "", out[..]);
  spec := cast(string) out[0..<res.n];
  if !api_ok(res) { return api_fail(r, res, spec); }
  vis := editor_spec_value(spec, "visibility");
  page := realm_page(a, profile, slug, vis, pg[..]);
  if !r[0].json { print("%", spec); print("page %\n", page); return EXIT_OK; }
  rep_str(r, "slug", slug);
  rep_str(r, "name", editor_spec_value(spec, "name"));
  rep_str(r, "visibility", ifx vis == "" then "public" else vis);
  rep_str(r, "role", editor_spec_value(spec, "role"));
  rev := editor_spec_value(spec, "rev");
  if rev != "" { rep_raw(r, "rev", rev); rep_raw(r, "published", editor_spec_value(spec, "published")); }
  rep_str(r, "page", page);
  rep_str(r, "spec", spec);
  return rep_done(r, EXIT_OK);
}

// new: POST /plan {prompt} (the model's board), then MAKE IT with exactly the rows it checked.
realm_new :: (a: [] Args, r: [] Rep, profile: string) -> int {
  words := positional(a, 2);
  from := args_value(a, "--from", "");
  if words == "" && from == "" { return fail(r, EXIT_USAGE, "realm new WORDS [--from PLAN]"); }
  if words.count > 2000 { return fail(r, EXIT_USAGE, "say it in at most 2000 characters"); }
  out: [API_OUT] u8; buf: [API_BODY_MAX] u8;
  on: [64] bool;
  plan := -1; rows := 0;
  if from != "" {
    plan = cli_count(from, 1, 999999999);
    if plan < 0 { return fail(r, EXIT_USAGE, "--from is a plan's number"); }
  } else {
    // The setup the words fix (verse.builder_setup); a field not given is the model's pick.
    // board.coax writes the body: {"prompt":WORDS[,"setup":{"style":..,"time":..,"camera":..,"ground":..}]}
    keys := [4] string.["style", "time", "camera", "ground"]; values: [4] string; none: [1] bool;
    for f: 0..<4 {
      flag: [16] u8; fn := copy("--", flag[..]); fn += copy(keys[f], flag[fn..<flag.count]);
      values[f] = rc_option(a, "new", cast(string) flag[0..<fn], "");
    }
    bn := editor_plan_body(words, 2000, false, 0, none[0..<0], keys[..], values[..], buf[..]);
    if bn < 0 { return fail(r, EXIT_USAGE, "those words are too long"); }
    body := cast(string) buf[0..<bn];
    res := api_call(a, profile, "POST", "/api/playtest/realms/plan?as=lines", body, out[..]);
    text := cast(string) out[0..<res.n];
    if !api_ok(res) { return api_fail(r, res, text); }
    b := cli_plan_board(text, on[..]);
    if b.plan < 0 || b.rows < 0 { return fail(r, EXIT_FAIL, "the plan's board didn't read"); }
    plan = b.plan; rows = b.rows;
  }
  nokeys: [1] string;
  mn := editor_make_body(plan, on[0..<rows], nokeys[0..<0], nokeys[0..<0], "", 0, buf[..]);   // board.coax: {"plan":N,"on":[..]}
  if mn < 0 { return fail(r, EXIT_FAIL, "the plan's board didn't fit"); }
  res := api_call(a, profile, "POST", "/api/playtest/realms?as=lines", cast(string) buf[0..<mn], out[..]);
  made := cast(string) out[0..<res.n];
  if !api_ok(res) { return api_fail(r, res, made); }
  mm: [1] EditorMade; mm[0] = editor_read_made(made);   // made.proto's lines
  slug := editor_made_slug(mm[..]);
  if !mm[0].ok || !cli_slug_ok(slug) { return fail(r, EXIT_FAIL, "the server made no realm"); }
  pg: [400] u8;
  rep_int(r, "plan", plan);
  rep_str(r, "slug", slug);
  rep_str(r, "visibility", "private");
  rep_str(r, "page", realm_page(a, profile, slug, "private", pg[..]));
  return rep_done(r, EXIT_OK);
}

// visibility (also `admin realm visibility`): POST /<slug>/visibility {visibility}.
realm_visibility :: (a: [] Args, r: [] Rep, profile: string, at: int) -> int {
  slug := positional(a, at);
  vis := positional(a, at + 1);
  if !cli_slug_ok(slug) || !cli_visibility_ok(vis) { return fail(r, EXIT_USAGE, "visibility SLUG private|unlisted|public"); }
  out: [API_OUT] u8; p: [128] u8; buf: [256] u8; pg: [400] u8;
  bn := editor_visibility_body(0, vis, buf[..]);   // record.proto's VisibilityRequest, {"visibility":"V"}
  res := api_call(a, profile, "POST", realm_path(slug, "/visibility", p[..]), cast(string) buf[0..<bn], out[..]);
  body := cast(string) out[0..<res.n];
  if !api_ok(res) { return api_fail(r, res, body); }
  if !editor_read_visibility(body).ok || !rep_object(r, body) { return fail(r, EXIT_FAIL, "the server's answer isn't a visibility"); }
  rep_str(r, "url", realm_page(a, profile, slug, vis, pg[..]));
  return rep_done(r, EXIT_OK);
}

// publish: the revision named, or the one there now (read first). 409: it moved; `rev N` says where.
realm_publish :: (a: [] Args, r: [] Rep, profile: string) -> int {
  slug := positional(a, 2);
  if !cli_slug_ok(slug) { return fail(r, EXIT_USAGE, "realm publish SLUG [--rev N]"); }
  out: [API_OUT] u8; p: [128] u8; buf: [256] u8;
  rev := -1;
  if args_has(a, "--rev") {
    rev = cli_count(args_value(a, "--rev", ""), 1, 999999999);
    if rev < 0 { return fail(r, EXIT_USAGE, "--rev is a revision number"); }
  } else {
    res := api_call(a, profile, "GET", realm_path(slug, "", p[..]), "", out[..]);
    spec := cast(string) out[0..<res.n];
    if !api_ok(res) { return api_fail(r, res, spec); }
    rev = cli_count(editor_spec_value(spec, "rev"), 1, 999999999);
    if rev < 0 { return fail(r, EXIT_USAGE, "that realm has no revisions to publish (a built-in realm?)"); }
  }
  bn := editor_rev_body(rev, buf[..]);   // realm.proto's RevRequest, {"rev":N}
  res := api_call(a, profile, "POST", realm_path(slug, "/publish", p[..]), cast(string) buf[0..<bn], out[..]);
  body := cast(string) out[0..<res.n];
  if res.error == HTTP_OK && res.status == 409 {
    c := editor_read_reply(body);   // a Conflict's revision; a quoted "7" is none, so only a number is printed
    if c.ok { rep_int(r, "rev", c.rev); }
  }
  if !api_ok(res) { return api_fail(r, res, body); }
  if !rep_object(r, body) { return fail(r, EXIT_FAIL, "the server's answer isn't JSON"); }
  return rep_done(r, EXIT_OK);
}

realm_fork :: (a: [] Args, r: [] Rep, profile: string) -> int {
  slug := positional(a, 2);
  if !cli_slug_ok(slug) { return fail(r, EXIT_USAGE, "realm fork SLUG [--name NAME]"); }
  out: [API_OUT] u8; p: [128] u8; buf: [512] u8; pg: [400] u8;
  no: [1] string;
  bn := editor_fork_body(true, no[0..<0], ifx args_has(a, "--name") then args_value(a, "--name", "") else "", buf[..]);   // made.proto's ForkRequest
  if bn < 0 { return fail(r, EXIT_USAGE, "--name is too long"); }
  res := api_call(a, profile, "POST", realm_path(slug, "/fork?as=lines", p[..]), cast(string) buf[0..<bn], out[..]);
  made := cast(string) out[0..<res.n];
  if !api_ok(res) { return api_fail(r, res, made); }
  mm: [1] EditorMade; mm[0] = editor_read_made(made);   // made.proto's lines
  fork := editor_made_slug(mm[..]);
  if !mm[0].ok || !cli_slug_ok(fork) { return fail(r, EXIT_FAIL, "the server made no fork"); }
  rep_str(r, "slug", fork);
  rep_str(r, "from", slug);
  rep_str(r, "visibility", "private");
  rep_str(r, "page", realm_page(a, profile, fork, "private", pg[..]));
  return rep_done(r, EXIT_OK);
}

// A key's kept result: ~/.openagents/cli/results/KEY, the exit code and the result (realm.result.v1)
// of the first write sent with that --key. A write repeated with the key answers that result again
// and sends nothing (#13436). A dry run, a wait for approval and an unknown outcome are not kept:
// nothing was decided, and the key may be used again.
realm_key_file :: (key: string, out: [] u8) -> string {
  c: [1024] u8; d: [1100] u8;
  dir := fs_join(cli_dir(c[..]), "results", d[..]);
  if dir == "" || !rc_value("key",key) { return ""; }
  made := fs_mkdir(cli_dir(c[..])) || true;
  made = fs_mkdir(dir) || true;
  return fs_join(dir, key, out);
}
realm_key_keep :: (key: string, res: OpResult, result: string) {
  f: [1200] u8; b: [OR_BODY + 4] u8;
  code := rw_exit(res);
  if key.count == 0 || (res.state != OR_DONE && res.state != OR_REFUSED) || result.count + 2 > b.count { return; }
  path := realm_key_file(key, f[..]);
  if path == "" { return; }
  b[0] = cast(u8) ('0' + code); b[1] = '\n';
  for i: 0..<result.count { b[2 + i] = result[i]; }
  ok := fs_write(path, cast(string) b[0..<result.count + 2]);
}
// The kept result of `key` answered again: its exit code, or -1 when none is kept.
realm_key_again :: (r: [] Rep, key: string) -> int {
  f: [1200] u8; b: [OR_BODY + 4] u8; rd := [1] OpRead.[OpRead.{}]; line: [OR_BODY] u8;
  path := realm_key_file(key, f[..]);
  n := ifx path == "" then -1 else fs_read(path, b[..]);
  if n < 3 || b[1] != '\n' || b[0] < '0' || b[0] > '9' { return -1; }
  text := cast(string) b[2..<n];
  res := or_read(text, rd[..]);
  if !res.ok { return -1; }
  code := cast(int) (b[0] - '0');
  if r[0].json {
    rep_raw(r, "result", text); rep_str(r, "state", OR_STATE[res.state]); rep_int(r, "rev", res.rev); rep_bool(r, "repeat", true);
    return rep_done(r, code);
  }
  print("% (the first result of this key; nothing was sent again)\n", or_line(res, or_words(rd[..]), line[..]));
  return code;
}
// The result an older row's exit code is, for a row that has not moved onto the world document yet.
realm_result_of_exit :: (code: int) -> OpResult #effects(all) {
  if code == EXIT_OK { return OpResult.{ok = true, state = OR_DONE}; }
  if code == EXIT_SLOW { return OpResult.{ok = true, state = OR_UNKNOWN, code = ORC_NO_ANSWER, retry = true}; }
  c := ifx code == EXIT_CONFLICT then ORC_STALE else (ifx code == EXIT_AUTH || code == EXIT_FORBIDDEN then ORC_NOT_PERMITTED else (ifx code == EXIT_NOT_FOUND then ORC_NOT_FOUND else (ifx code == EXIT_USAGE then ORC_BAD_REQUEST else ORC_FAILED)));
  return OpResult.{ok = true, state = OR_REFUSED, code = c, retry = or_code_retry(c)};
}
#test "an older row's exit code is a result" {
  #assert realm_result_of_exit(EXIT_OK).state == OR_DONE && realm_result_of_exit(EXIT_SLOW).state == OR_UNKNOWN && realm_result_of_exit(EXIT_SLOW).retry;
  #assert realm_result_of_exit(EXIT_CONFLICT).code == ORC_STALE && realm_result_of_exit(EXIT_CONFLICT).retry && realm_result_of_exit(EXIT_AUTH).code == ORC_NOT_PERMITTED && realm_result_of_exit(EXIT_FORBIDDEN).code == ORC_NOT_PERMITTED;
  #assert realm_result_of_exit(EXIT_NOT_FOUND).code == ORC_NOT_FOUND && realm_result_of_exit(EXIT_USAGE).code == ORC_BAD_REQUEST && realm_result_of_exit(EXIT_FAIL).code == ORC_FAILED && realm_result_of_exit(EXIT_FAIL).state == OR_REFUSED;
  for code: 0..<8 { r := realm_result_of_exit(code); #assert rw_exit(r) == (ifx code == EXIT_AUTH then EXIT_FORBIDDEN else code) || code == EXIT_MISSING; }
}

realm_main :: (a: [] Args, r: [] Rep, profile: string, verb: string) -> int {
  why := rc_validate(a,verb);
  if why != "" { return fail(r,EXIT_USAGE,why); }
  c := REALM_COMMANDS[rc_find(verb)];
  // One result shape for what every row does before it is sent (op-result.coax, #13436): a two-step
  // row without --yes does nothing and says it needs approval (#13435); --dry-run on a row that has
  // no deeper check says the arguments are a well-formed request, and sends nothing.
  slug := ifx cli_field(c.arguments,0) == "slug" then positional(a,2) else "";
  words := OpWords.{verb = verb, realm = slug, effect = c.effect, key = rc_option(a,verb,"--key","")};
  if rc_needs_yes(c) && !rc_has(a,verb,"--yes") {
    words.approval = c.approval;
    w := [1] RwWork.[RwWork.{}];
    return rw_answer(r, w[..], OpResult.{state = OR_NEEDS_APPROVAL}, words);
  }
  if c.route != "world" && c.effect != "read" && args_has(a,"--dry-run") {
    w := [1] RwWork.[RwWork.{}];
    return rw_answer(r, w[..], OpResult.{state = OR_DRY_RUN, level = ORL_SCHEMA}, words);
  }
  // a keyed write that was answered before is answered the same again, and nothing is sent
  keyed := words.key.count > 0 && c.effect != "read";
  if keyed {
    again := realm_key_again(r, words.key);
    if again >= 0 { return again; }
  }
  if c.route == "world" { return rw_main(a, r, profile, verb); }
  if c.route == "files" { return rf_main(a, r, profile, verb); }
  code := realm_run(a, r, profile, verb);
  if keyed {
    w := [1] RwWork.[RwWork.{}];
    res := realm_result_of_exit(code);
    if res.state == OR_REFUSED { words.words = "the command was refused: its own answer said why"; }
    realm_key_keep(words.key, res, or_write(res, words, w[0].result[..]));
  }
  return code;
}
// The rows that have not moved onto the world document: each still answers in its own words.
realm_run :: (a: [] Args, r: [] Rep, profile: string, verb: string) -> int {
  if verb == "list" { return realm_list(a, r, profile); }
  if verb == "shot" { return labs_realm_shot(a, r, profile); }
  if verb == "show" { return realm_show(a, r, profile); }
  if verb == "new" { return realm_new(a, r, profile); }
  if verb == "fork" { return realm_fork(a, r, profile); }
  if verb == "doc" || verb == "asks" || verb == "proposals" || verb == "panes" { return realm_read(a,r,profile,REALM_COMMANDS[rc_find(verb)].route); }
  if verb == "apply" { return realm_apply(a,r,profile); }
  if REALM_COMMANDS[rc_find(verb)].route == "seat" { return realm_seat(a,r,profile,verb); }
  return realm_edit(a,r,profile,verb);
}
