// The review report's decisions, with no host calls (project-review.coax
// does the I/O): which commits weaken a check together with the code it
// checks (r0-independent-review, coax/web/project/QUEUE.md). Report only, by
// owner decision (2026-10-31): it never stops a release.
//   coax/bin/coax test apps/openagents-cli/review-rules.coax --library
//
// What weakens a check (per commit, per file): a removed #assert, #test,
// #forall or #authority line in a .coax file, or a removed assert/expect line
// in a test file, that the same file does not add back; a new
// "mutant: equivalent" mark; a check line moved into a file without
// #authority (an unmarked helper); any removed line of an INVARIANTS.md; a
// removed tests/run.sh line with a word no added line has. "Together with the
// code it checks": the same commit also changes code (anything that is not a
// test, doc or generated report). These are review.ts's rules, line for line
// (docs/verification/2026-11-01-project-page-coax.md).
#load "../../coax/lib/nostr/event_sign.coax";
#load "../../coax/lib/json/json.coax";

// ---- text ----------------------------------------------------------------------

rv_space :: (c: u8) -> bool { return c == ' ' || c == 9 || c == 10 || c == 11 || c == 12 || c == 13; }
rv_word :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
rv_trim :: (s: string) -> string {
  a := 0; while a < s.count && rv_space(s[a]) { a += 1; }
  b := s.count; while b > a && rv_space(s[b - 1]) { b -= 1; }
  return s[a..<b];
}
rv_starts :: (s: string, prefix: string) -> bool { return s.count >= prefix.count && s[0..<prefix.count] == prefix; }
rv_ends :: (s: string, suffix: string) -> bool { return s.count >= suffix.count && s[s.count - suffix.count..<s.count] == suffix; }
rv_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  i := 0;
  while i + needle.count <= hay.count { if hay[i..<i + needle.count] == needle { return true; } i += 1; }
  return false;
}
#test "text helpers" {
  #assert rv_trim(" \t a b \r\n") == "a b" && rv_trim("") == "" && rv_trim("   ") == "";
  #assert rv_starts("abc", "ab") && !rv_starts("a", "ab") && rv_ends("abc", "bc") && !rv_ends("c", "bc");
  #assert rv_contains("abc", "bc") && rv_contains("abc", "") && !rv_contains("abc", "cd") && !rv_contains("ab", "abc");
  #assert rv_word('a') && rv_word('Z') && rv_word('0') && rv_word('_') && !rv_word('#') && !rv_word(' ') && !rv_word('(');
  #assert rv_space(11) && rv_space(12) && !rv_space('x');
}

// A check line (/(^|[{;]\s*)(#assert|#test|#forall|#authority)\b/): one of
// the words at the line's start, or after a { or ; and spaces, ending a word.
rv_check_line :: (s: string) -> bool {
  words := [4] string.["#assert", "#test", "#forall", "#authority"];
  after := false;   // a { or ; and only spaces since
  for i: 0..<s.count {
    if i == 0 || after {
      for w: words {
        e := i + w.count;
        if e <= s.count && s[i..<e] == w && (e == s.count || !rv_word(s[e])) { return true; }
      }
    }
    c := s[i];
    if c == '{' || c == ';' { after = true; } else if !rv_space(c) { after = false; }
  }
  return false;
}
#test "check lines" {
  #assert rv_check_line("#assert f(1)==2;") && rv_check_line("#test \"x\" {") && rv_check_line("#forall x") && rv_check_line("#authority;");
  #assert rv_check_line("x := 1; #assert x == 1;") && rv_check_line("{ #test") && rv_check_line("a;#assert") && rv_check_line("#assert");
  #assert !rv_check_line("  #assert x;") && !rv_check_line("S :: \"a #test inside a string\";") && !rv_check_line("#tests") && !rv_check_line("");
  #assert !rv_check_line("x #assert") && !rv_check_line("; x #assert") && !rv_check_line("#asser") && rv_check_line("#assert(x)");
}
// A test line (/\b(assert\w*|expect)\s*\(/).
rv_test_line :: (s: string) -> bool {
  for i: 0..<s.count {
    if i > 0 && rv_word(s[i - 1]) { continue; }
    j := -1;
    if rv_starts(s[i..<s.count], "assert") { j = i + 6; while j < s.count && rv_word(s[j]) { j += 1; } }
    else if rv_starts(s[i..<s.count], "expect") { j = i + 6; }
    if j < 0 { continue; }
    while j < s.count && rv_space(s[j]) { j += 1; }
    if j < s.count && s[j] == '(' { return true; }
  }
  return false;
}
#test "test lines" {
  #assert rv_test_line("self.assertEqual(a, b)") && rv_test_line("assert (x)") && rv_test_line("expect(f()).toBe(1)") && rv_test_line("expect  (x)");
  #assert !rv_test_line("reassert(x)") && !rv_test_line("expectation (x)") && !rv_test_line("assert x") && !rv_test_line("") && !rv_test_line("expect");
  #assert rv_test_line("x;assert_eq(a)") && !rv_test_line("myexpect(x)") && rv_test_line("assert(");
}

// ---- files ----------------------------------------------------------------------

// A test file: a test/ or tests/ folder, *.test.ts, or test_*.py.
rv_is_test :: (p: string) -> bool {
  for i: 0..<p.count {
    if i > 0 && p[i - 1] != '/' { continue; }
    rest := p[i..<p.count];
    if rv_starts(rest, "test/") || rv_starts(rest, "tests/") { return true; }
  }
  if rv_ends(p, ".test.ts") { return true; }
  b := 0; for i: 0..<p.count { if p[i] == '/' { b = i + 1; } }
  base := p[b..<p.count];
  return base.count >= 8 && rv_starts(base, "test_") && rv_ends(base, ".py");
}
// Generated files (baked project data, release snapshots) are not checks.
rv_is_generated :: (p: string) -> bool {
  return rv_contains(p, "apps/openagents-web/projects/") || rv_ends(p, "baked.coax") || rv_starts(p, "coax/bootstrap/");
}
rv_is_doc :: (p: string) -> bool {
  return rv_ends(p, ".md") || rv_ends(p, ".txt") || rv_starts(p, "docs/") || rv_ends(p, ".json.gz") || rv_starts(p, "coax/reviews/");
}
#test "kinds of files" {
  #assert rv_is_test("coax/tests/run.sh") && rv_is_test("tests/a.py") && rv_is_test("x/test/y") && rv_is_test("a.test.ts") && rv_is_test("x/test_a.py") && rv_is_test("test_.py");
  #assert !rv_is_test("contests/a") && !rv_is_test("x/tests") && !rv_is_test("test_a.pyc") && !rv_is_test("mytest_a.py") && !rv_is_test("a.ts");
  #assert rv_is_generated("apps/openagents-web/projects/coax/work.coax") && rv_is_generated("x/baked.coax") && rv_is_generated("coax/bootstrap/a.c");
  #assert !rv_is_generated("apps/openagents-web/project.coax") && !rv_is_generated("x/coax/bootstrap/a");
  #assert rv_is_doc("a.md") && rv_is_doc("a.txt") && rv_is_doc("docs/a.coax") && rv_is_doc("a.json.gz") && rv_is_doc("coax/reviews/a.json");
  #assert !rv_is_doc("a.json") && !rv_is_doc("x/docs/a.coax");
}
// A "mutant: equivalent" mark (/\/\/\s*mutant:\s*equivalent/).
rv_mutant_mark :: (s: string) -> bool {
  i := 0;
  while i + 1 < s.count {
    if s[i] == '/' && s[i + 1] == '/' {
      j := i + 2; while j < s.count && rv_space(s[j]) { j += 1; }
      if rv_starts(s[j..<s.count], "mutant:") {
        j += 7; while j < s.count && rv_space(s[j]) { j += 1; }
        if rv_starts(s[j..<s.count], "equivalent") { return true; }
      }
    }
    i += 1;
  }
  return false;
}
#test "equivalence marks" {
  #assert rv_mutant_mark("x<=lo // mutant: equivalent") && rv_mutant_mark("//mutant:equivalent") && rv_mutant_mark("/// mutant:  equivalent!");
  #assert !rv_mutant_mark("adds a `mutant: equivalent` mark") && !rv_mutant_mark("/ / mutant: equivalent") && !rv_mutant_mark("// mutant equivalent") && !rv_mutant_mark("");
}

// ---- a commit's diff ----------------------------------------------------------------

RV_FILES :: 4096;
RV_LINES :: 4194304;   // the lines the report gives a diff (project-review.coax); the checks give fewer
RvDiff :: struct {
  nf: int; path: [RV_FILES] string; first: [RV_FILES] int; end: [RV_FILES] int;
  nl: int; line: [] string; added: [] bool;   // the caller's room for lines
  full: bool;   // more files or lines than it holds
}
// git show -U0's unified diff, per file: its added and removed lines.
rv_parse :: (text: string, d: [] RvDiff) {
  d[0].nf = 0; d[0].nl = 0; d[0].full = false;
  i := 0;
  while i <= text.count {
    e := i; while e < text.count && text[e] != 10 { e += 1; }
    line := text[i..<e];
    i = e + 1;
    if rv_starts(line, "diff --git ") {
      if d[0].nf >= RV_FILES { d[0].full = true; return; }
      // a/(.*) b/: the path runs to the last " b/"
      p := line[11..<line.count];
      cut := -1;
      for k: 0..<p.count { if k + 3 <= p.count && p[k..<k + 3] == " b/" { cut = k; } }
      path := ifx rv_starts(p, "a/") && cut >= 2 then p[2..<cut] else line;
      if d[0].nf > 0 { d[0].end[d[0].nf - 1] = d[0].nl; }
      d[0].path[d[0].nf] = path; d[0].first[d[0].nf] = d[0].nl; d[0].end[d[0].nf] = d[0].nl; d[0].nf += 1;
      continue;
    }
    if d[0].nf == 0 || rv_starts(line, "+++") || rv_starts(line, "---") { continue; }
    if line.count > 0 && (line[0] == '+' || line[0] == '-') {
      if d[0].nl >= d[0].line.count || d[0].nl >= d[0].added.count { d[0].full = true; return; }
      d[0].line[d[0].nl] = line[1..<line.count]; d[0].added[d[0].nl] = line[0] == '+'; d[0].nl += 1;
      d[0].end[d[0].nf - 1] = d[0].nl;
    }
  }
}
#test "unified diffs parse per file" {
  d_: [1] RvDiff; d := d_[..]; ls: [64] string; la: [64] bool; d[0].line = ls[..]; d[0].added = la[..];
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n--- a/lib/a.coax\n+++ b/lib/a.coax\n@@ -1 +1 @@\n-#assert x;\n+y := 1;\n", d);
  #assert d[0].nf == 1 && d[0].path[0] == "lib/a.coax" && d[0].nl == 2 && d[0].first[0] == 0 && d[0].end[0] == 2;
  #assert d[0].line[0] == "#assert x;" && !d[0].added[0] && d[0].line[1] == "y := 1;" && d[0].added[1];
  rv_parse("+x\ndiff --git a/a b/b b/c\n---x\n+\ndiff --git weird\n-gone\n", d);
  #assert d[0].nf == 2 && d[0].path[0] == "a b/b" && d[0].end[0] == 1 && d[0].line[0] == "" && d[0].path[1] == "diff --git weird" && d[0].first[1] == 1 && d[0].end[1] == 2;
}

// ---- the findings ----------------------------------------------------------------------

RV_FINDINGS :: 1024;
RvFindings :: struct {
  n: int; file: [RV_FINDINGS] string; why: [RV_FINDINGS] string; line: [RV_FINDINGS] string;
  text: [65536] u8; used: int;    // the "check moved into ..." reasons
  need: int;                       // a file whose #authority must be known first, or -1
}
rv_find :: (o: [] RvFindings, file: string, why: string, line: string) {
  if o[0].n >= RV_FINDINGS { return; }
  o[0].file[o[0].n] = file; o[0].why[o[0].n] = why; o[0].line[o[0].n] = line; o[0].n += 1;
}
// A file's added lines with a word of removed (trimmed, split on spaces, longer than 2) nowhere in them.
rv_gate_dropped :: (d: [] RvDiff, f: int, removed: string) -> bool {
  t := rv_trim(removed); i := 0;
  while i < t.count {
    while i < t.count && rv_space(t[i]) { i += 1; }
    e := i; while e < t.count && !rv_space(t[e]) { e += 1; }
    w := t[i..<e];
    if w.count > 2 {
      found := false;
      for k: d[0].first[f]..<d[0].end[f] { if d[0].added[k] && rv_contains(d[0].line[k], w) { found = true; break; } }
      if !found { return true; }
    }
    i = e;
  }
  return false;
}
// Whether file f's added (or removed) lines include s, trimmed.
rv_has :: (d: [] RvDiff, f: int, s: string, added: bool) -> bool {
  for k: d[0].first[f]..<d[0].end[f] { if d[0].added[k] == added && rv_trim(d[0].line[k]) == s { return true; } }
  return false;
}
rv_pattern :: (path: string, line: string) -> bool {
  return ifx rv_ends(path, ".coax") then rv_check_line(line) else rv_test_line(line);
}
// The findings. auth[f] is whether file f has #authority (1, 0, or -1 unknown):
// when one is needed and unknown, o.need names it and the caller asks git and runs this again.
rv_weakenings :: (d: [] RvDiff, auth: [] int, o: [] RvFindings) {
  o[0].n = 0; o[0].used = 0; o[0].need = -1;
  for f: 0..<d[0].nf {
    path := d[0].path[f];
    if rv_is_generated(path) { continue; }
    b := 0; for i: 0..<path.count { if path[i] == '/' { b = i + 1; } }
    if path[b..<path.count] == "INVARIANTS.md" {
      for k: d[0].first[f]..<d[0].end[f] {
        t := rv_trim(d[0].line[k]);
        if !d[0].added[k] && t.count > 0 && !rv_has(d, f, t, true) { rv_find(o, path, "invariant text removed", t); }
      }
      continue;
    }
    if rv_ends(path, "tests/run.sh") {
      for k: d[0].first[f]..<d[0].end[f] {
        t := rv_trim(d[0].line[k]);
        if !d[0].added[k] && t.count > 0 && rv_gate_dropped(d, f, d[0].line[k]) { rv_find(o, path, "a gate dropped from tests/run.sh", t); }
      }
      continue;
    }
    // The mark is a Coax comment; the words elsewhere (docs, this tool) are not one.
    coax := rv_ends(path, ".coax");
    if coax { for k: d[0].first[f]..<d[0].end[f] { if d[0].added[k] && rv_mutant_mark(d[0].line[k]) { rv_find(o, path, "new 'mutant: equivalent' mark", rv_trim(d[0].line[k])); } } }
    if !coax && !rv_is_test(path) { continue; }
    gone: [RV_FINDINGS] string; gn := 0;
    for k: d[0].first[f]..<d[0].end[f] {
      if d[0].added[k] { continue; }
      t := rv_trim(d[0].line[k]);
      if !rv_pattern(path, t) || rv_has(d, f, t, true) { continue; }
      // moved: the last file adding this check line
      moved := -1;
      for g: 0..<d[0].nf { for m: d[0].first[g]..<d[0].end[g] { if d[0].added[m] && rv_check_line(d[0].line[m]) && rv_trim(d[0].line[m]) == t { moved = g; } } }
      if moved >= 0 && d[0].path[moved] != path {
        if auth[f] < 0 { o[0].need = f; return; }
        if auth[f] > 0 {
          if auth[moved] < 0 { o[0].need = moved; return; }
          if auth[moved] == 0 {
            why := "check moved into "; mp := d[0].path[moved]; tail := ", which has no #authority";
            if o[0].used + why.count + mp.count + tail.count <= 65536 {
              at := o[0].used;
              for c: why { o[0].text[o[0].used] = c; o[0].used += 1; }
              for c: mp { o[0].text[o[0].used] = c; o[0].used += 1; }
              for c: tail { o[0].text[o[0].used] = c; o[0].used += 1; }
              rv_find(o, path, cast(string) o[0].text[at..<o[0].used], t);
            }
          }
        }
        continue;
      }
      if gn < RV_FINDINGS { gone[gn] = t; gn += 1; }
    }
    // A rewritten check is not a weaker one; fewer checks are.
    fresh := 0;
    for k: d[0].first[f]..<d[0].end[f] { if d[0].added[k] && rv_pattern(path, d[0].line[k]) && !rv_has(d, f, rv_trim(d[0].line[k]), false) { fresh += 1; } }
    for i: 0..<(ifx gn - fresh > 0 then gn - fresh else 0) { rv_find(o, path, "check removed", gone[i]); }
  }
}
// Whether the commit changes code: a file that is not a doc, test, generated
// report or INVARIANTS.md; in a .coax file, a line that is not a check or a comment.
rv_changes_code :: (d: [] RvDiff) -> bool {
  for f: 0..<d[0].nf {
    path := d[0].path[f];
    if rv_is_doc(path) || rv_is_test(path) || rv_is_generated(path) || rv_ends(path, "INVARIANTS.md") { continue; }
    if !rv_ends(path, ".coax") { return true; }
    for k: d[0].first[f]..<d[0].end[f] {
      l := d[0].line[k]; t := rv_trim(l);
      if t.count > 0 && !rv_check_line(l) && !rv_starts(t, "//") { return true; }
    }
  }
  return false;
}
// The queue tasks a subject names: each "#" and four lowercase hex digits ending a word.
rv_tasks :: (subject: string, out: [] string) -> int {
  n := 0; i := 0;
  while i + 5 <= subject.count {
    if subject[i] == '#' {
      ok := true;
      for k: 1..<5 { c := subject[i + k]; if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { ok = false; } }
      if ok && (i + 5 == subject.count || !rv_word(subject[i + 5])) {
        if n < out.count { out[n] = subject[i + 1..<i + 5]; n += 1; }
        i += 5; continue;
      }
    }
    i += 1;
  }
  return n;
}

#test "a removed check with a code change is flagged; a pure move is not" {
  d_: [1] RvDiff; d := d_[..]; ls: [64] string; la: [64] bool; d[0].line = ls[..]; d[0].added = la[..]; o_: [1] RvFindings; o := o_[..]; auth: [8] int;
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert f(1)==2;\n-f :: () -> int { return 1; }\n+f :: () -> int { return 2; }\n", d);
  rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].why[0] == "check removed" && o[0].line[0] == "#assert f(1)==2;" && o[0].file[0] == "lib/a.coax" && rv_changes_code(d);
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert f(1)==2;\n+#assert f(1)==2;\n", d);
  rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
}
#test "checks moved into an unmarked helper are flagged, into an #authority file not" {
  d_: [1] RvDiff; d := d_[..]; ls: [64] string; la: [64] bool; d[0].line = ls[..]; d[0].added = la[..]; o_: [1] RvFindings; o := o_[..];
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert g(0)==0;\ndiff --git a/lib/helper.coax b/lib/helper.coax\n+#assert g(0)==0;\n", d);
  unknown := [2] int.[-1, -1];
  rv_weakenings(d, unknown[..], o);
  #assert o[0].need == 0;
  only_a := [2] int.[1, -1];
  rv_weakenings(d, only_a[..], o);
  #assert o[0].need == 1;
  only_a[1] = 0;
  rv_weakenings(d, only_a[..], o);
  #assert o[0].n == 1 && o[0].why[0] == "check moved into lib/helper.coax, which has no #authority" && o[0].need == -1;
  both := [2] int.[1, 1];
  rv_weakenings(d, both[..], o);
  #assert o[0].n == 0;
  neither := [2] int.[0, -1];
  rv_weakenings(d, neither[..], o);
  #assert o[0].n == 0 && o[0].need == -1;
}
#test "equivalence marks, invariants and gate lines are weakenings; docs alone are not code" {
  d_: [1] RvDiff; d := d_[..]; ls: [64] string; la: [64] bool; d[0].line = ls[..]; d[0].added = la[..]; o_: [1] RvFindings; o := o_[..]; auth: [8] int;
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n+x<=lo // mutant: equivalent\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].why[0] == "new 'mutant: equivalent' mark";
  rv_parse("diff --git a/coax/web/project/QUEUE.md b/coax/web/project/QUEUE.md\n+adds a `mutant: equivalent` mark\ndiff --git a/x/review.ts b/x/review.ts\n+// \"mutant: equivalent\" mark\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
  rv_parse("diff --git a/coax/INVARIANTS.md b/coax/INVARIANTS.md\n-- every mutant is killed\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].line[0] == "- every mutant is killed";
  rv_parse("diff --git a/coax/INVARIANTS.md b/coax/INVARIANTS.md\n--- every mutant is killed\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;   // a removed "-- " line reads as "---" in a diff, which the parser skips (as review.ts did)
  rv_parse("diff --git a/coax/INVARIANTS.md b/coax/INVARIANTS.md\n-every mutant is killed\n+ every mutant is killed \n-  \n-gone\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].why[0] == "invariant text removed" && o[0].line[0] == "gone";
  rv_parse("diff --git a/coax/tests/run.sh b/coax/tests/run.sh\n-python3 tests/evidence.py\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].why[0] == "a gate dropped from tests/run.sh";
  rv_parse("diff --git a/coax/tests/run.sh b/coax/tests/run.sh\n-[[ $a_rc -eq 0 ]]\n+[[ $a_rc -eq 0 && $b_rc -eq 0 ]]\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert f(1)==2;\n+#assert f(1)==3;\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
  rv_parse("diff --git a/apps/openagents-web/projects/coax/work.coax b/apps/openagents-web/projects/coax/work.coax\n-X :: \"#test a\";\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-S :: \"a #test inside a string\";\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 0;
  rv_parse("diff --git a/coax/tests/evidence.py b/coax/tests/evidence.py\n-        self.assertEqual(a, b)\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].line[0] == "self.assertEqual(a, b)";
  rv_parse("diff --git a/coax/spec.md b/coax/spec.md\n-x\ndiff --git a/coax/tests/evidence.py b/coax/tests/evidence.py\n-assert\n", d);
  #assert !rv_changes_code(d);
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert f(1)==2;\n-// note\n", d);
  #assert !rv_changes_code(d);
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-  #assert f(1)==2;\n", d);
  #assert rv_changes_code(d);   // an indented check is not a check line here, as in review.ts
  rv_parse("diff --git a/coax/src/main.cpp b/coax/src/main.cpp\n-x\n", d);
  #assert rv_changes_code(d);
  rv_parse("diff --git a/a/INVARIANTS.md b/a/INVARIANTS.md\n-x\n", d);
  #assert !rv_changes_code(d);
}
#test "two removed checks and one fresh one leave one finding" {
  d_: [1] RvDiff; d := d_[..]; ls: [64] string; la: [64] bool; d[0].line = ls[..]; d[0].added = la[..]; o_: [1] RvFindings; o := o_[..]; auth: [8] int;
  rv_parse("diff --git a/lib/a.coax b/lib/a.coax\n-#assert a;\n-#assert b;\n+#assert c;\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].line[0] == "#assert a;";
  rv_parse("diff --git a/x/tests/t.py b/x/tests/t.py\n-assert(a)\n+assert(a)\n-expect(b)\n", d); rv_weakenings(d, auth[..], o);
  #assert o[0].n == 1 && o[0].line[0] == "expect(b)";
}
#test "subjects name queue tasks" {
  t: [8] string;
  #assert rv_tasks("Fix the thing (#ab12, #00ff)", t[..]) == 2 && t[0] == "ab12" && t[1] == "00ff";
  #assert rv_tasks("#ab12x #AB12 #ab1 #ab12_ #ab12", t[..]) == 1 && t[0] == "ab12";
  #assert rv_tasks("", t[..]) == 0 && rv_tasks("#abcd#1234", t[..]) == 2;
}

// ---- independent reviews ------------------------------------------------------------------

RV_KIND :: 1111;
// Whether authors (coax/reviews/authors.json: {"pubkeys": [...]}) lists pubkey; an unreadable list lists none.
rv_author :: (authors: string, pubkey: string) -> bool {
  nodes: [4096] JvNode; d_: [1] Jv;
  if !jv_parse(d_[..], authors, nodes[..]) { return false; }
  d := d_[0];
  keys := jv_get(d, 0, "pubkeys");
  k := ifx jv_kind(d, keys) == JV_ARRAY then d.nodes[keys].first else -1;
  while k != -1 {
    b: [128] u8; n := jv_str(d, k, b[..]);
    if n >= 0 && cast(string) b[0..<n] == pubkey { return true; }
    k = d.nodes[k].next;
  }
  return false;
}
// The first tag named name: its second item ("" when there is none).
rv_tag :: (d: Jv, tags: int, name: string, out: [] u8) -> string {
  t := ifx jv_kind(d, tags) == JV_ARRAY then d.nodes[tags].first else -1;
  while t != -1 {
    b: [256] u8; n := jv_str(d, jv_at(d, t, 0), b[..]);
    if n >= 0 && cast(string) b[0..<n] == name {
      m := jv_str(d, jv_at(d, t, 1), out);
      return ifx m < 0 then "" else cast(string) out[0..<m];
    }
    t = d.nodes[t].next;
  }
  return "";
}
// A review file's standing for commit: "independent", or "invalid: <why>".
// A review is independent when it is a valid signed Nostr event (kind 1111,
// tags commit=<full hash>, t=coax-review) whose key is not an author key.
rv_review_of :: (text: string, commit: string, authors: string) -> string {
  if !json_valid(text) { return "invalid: not JSON"; }
  nodes: [4096] JvNode; d_: [1] Jv;
  if !jv_parse(d_[..], text, nodes[..]) || jv_kind(d_[0], 0) != JV_OBJECT { return "invalid: not JSON"; }
  d := d_[0];
  if jv_int(d, jv_get(d, 0, "kind"), -1) != RV_KIND { return "invalid: wrong kind"; }
  scratch: [NE_MAX_OUTPUT] u8;
  e := nostr_event_verify_vartime(text, scratch[..], false);
  if e.error != NE_OK || !e.verified { return "invalid: bad signature"; }
  tb: [256] u8;
  if rv_tag(d, jv_get(d, 0, "tags"), "commit", tb[..]) != commit { return "invalid: names another commit"; }
  if rv_tag(d, jv_get(d, 0, "tags"), "t", tb[..]) != "coax-review" { return "invalid: not a coax review"; }
  pb: [128] u8; pn := jv_str(d, jv_get(d, 0, "pubkey"), pb[..]);
  if pn >= 0 && rv_author(authors, cast(string) pb[0..<pn]) { return "invalid: signed with an author key"; }
  return "independent";
}
// A signed review, for the checks (the review agent signs with `openagents project review`).
rv_sign_fixture :: (commit: string, why: string, out: [] u8) -> int {
  key := ES_KEY; aux := ES_AUX;
  tags: [512] u8; n := 0;
  parts := [3] string.["[[\"commit\",\"", commit, "\"],[\"t\",\"coax-review\"],[\"review\",\"approve\"]]"];
  for p: parts { for c: p { tags[n] = c; n += 1; } }
  work: [1] NostrSignWork; scratch: [4096] u8;
  r := EVENT_MORE; steps := 0;
  while r == EVENT_MORE && steps < 4096 {
    r = nostr_event_sign_step(key[..], aux[..], 1793500000, RV_KIND, cast(string) tags[0..<n], why, work[..], scratch[..], out, false);
    steps += 1;
  }
  return r;
}
#test "a review is independent only with a valid signature from a non-author key" #steps 2000000000 {
  commit := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; other := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
  pub := "dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
  ev: [4096] u8; n := rv_sign_fixture(commit, "looked at it", ev[..]);
  #assert n > 0;
  text := cast(string) ev[0..<n];
  #assert rv_review_of(text, commit, "{\"pubkeys\":[]}") == "independent";
  #assert rv_review_of(text, commit, "not json") == "independent";
  #assert rv_review_of(text, other, "{}") == "invalid: names another commit";
  authors: [256] u8; an := 0;
  for c: "{\"pubkeys\":[\"" { authors[an] = c; an += 1; }
  for c: pub { authors[an] = c; an += 1; }
  for c: "\"]}" { authors[an] = c; an += 1; }
  #assert rv_review_of(text, commit, cast(string) authors[0..<an]) == "invalid: signed with an author key";
  edited := ev;
  at := -1; for i: 0..<n - 12 { if cast(string) edited[i..<i + 12] == "looked at it" { at = i; } }
  #assert at > 0;
  edited[at + 10] = 'I'; edited[at + 11] = 'T';
  #assert rv_review_of(cast(string) edited[0..<n], commit, "{}") == "invalid: bad signature";
  #assert rv_review_of("{\"kind\":1}", commit, "{}") == "invalid: wrong kind";
  #assert rv_review_of("{", commit, "{}") == "invalid: not JSON" && rv_review_of("[]", commit, "{}") == "invalid: not JSON";
}
