// openagents skill realm [--install]: the realm commands as a Claude skill (#12636).
// The text comes from REALM_COMMANDS (commands.coax), so it can't drift from
// the commands; --install writes .claude/skills/openagents-realm/SKILL.md here.

SKILL_PATH :: ".claude/skills/openagents-realm/SKILL.md";
skill_text :: (out: [] u8) -> string {
  r: [1] Rep;
  rep_put(r[..], "---\nname: openagents-realm\ndescription: Make, edit, publish and look at realms on openagents.com with the openagents CLI. Use when asked to build or change a realm (a 3D world people visit in the browser), move or place things in one, set characters' lore or quests, change who can see it, or take a picture of it.\n---\n\n");
  rep_put(r[..], "# Realms with the openagents CLI\n\n");
  rep_put(r[..], "Run `openagents realm VERB ...`. Add `--json` to get one JSON object per command. ");
  rep_put(r[..], "Install the CLI with `curl -fsSL https://openagents.com/cli/install.sh | sh` and sign in with `openagents login`.\n\n");
  rep_put(r[..], "- A new realm is private. Its owner opens it at `https://openagents.com/realms/built#SLUG`. `realm visibility SLUG unlisted` gives it a page at `/realms/SLUG`.\n");
  rep_put(r[..], "- Read before you edit: `realm doc SLUG` gives the revision. Pass it as `--rev N`; an edit fails with exit code 5 when someone changed the realm since.\n");
  rep_put(r[..], "- Look at what you made: `realm shot SLUG out.png` (add `--phone` for a phone screen), then read the picture.\n");
  rep_put(r[..], "- Exit codes: 0 done, 1 failed, 2 usage, 3 no key (run `openagents login`), 4 forbidden, 5 conflict, 6 not found, 7 slow down, 8 a needed program is missing.\n\n");
  rep_put(r[..], "## Commands\n\n");
  for c: REALM_COMMANDS {
    rep_put(r[..], "- `openagents realm "); rep_put(r[..], c.verb);
    i := 0; count := 0; while cli_field(c.arguments, count) != "" { count += 1; }
    while i < count {
      kind := cli_field(c.arguments, i); up: [32] u8; un := 0;
      for ch: mcp_arg_name(kind, mcp_kind_index(c, i)) { if un < up.count { up[un] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; un += 1; } }
      rep_put(r[..], ifx mcp_optional_at(c, i, count) then " [" else " ");
      rep_put(r[..], cast(string) up[0..<un]);
      if mcp_optional_at(c, i, count) { rep_put(r[..], "]"); }
      i += 1;
    }
    rep_put(r[..], "`");
    f := 0;
    while cli_field(c.flags, f) != "" {
      fl := cli_field(c.flags, f); colon := 0; while colon < fl.count && fl[colon] != ':' { colon += 1; }
      rep_put(r[..], ifx f == 0 then " (" else ", "); rep_put(r[..], "`"); rep_put(r[..], fl[0..<colon]); rep_put(r[..], "`");
      f += 1;
    }
    if f > 0 { rep_put(r[..], ")"); }
    rep_put(r[..], ": "); rep_put(r[..], c.help); rep_put(r[..], "\n");
  }
  rep_put(r[..], "\nThe same commands are MCP tools: `claude mcp add openagents -- openagents mcp` (add `--read-only` to offer only the commands that change nothing).\n");
  n := copy(cast(string) r[0].buf[0..<r[0].n], out);
  return cast(string) out[0..<n];
}
#test "skill: every row, with its arguments and flags" {
  out: [65536] u8; s := skill_text(out[..]);
  #assert acct_has(s, "name: openagents-realm") && acct_has(s, "`openagents realm move SLUG ENTITY X Z` (`--rev`): move an entity");
  #assert acct_has(s, "`openagents realm shot SLUG [OUT]`") && acct_has(s, "`openagents realm new [WORDS]` (`--from`)");
  for c: REALM_COMMANDS { #assert acct_has(s, c.help); }
}
skill_main :: (a: [] Args, r: [] Rep, verb: string) -> int {
  if verb != "realm" { return fail(r, EXIT_USAGE, "skill realm [--install]"); }
  out: [65536] u8; text := skill_text(out[..]);
  if !args_has(a, "--install") { print("%", text); return EXIT_OK; }
  ok := fs_mkdir(".claude") || fs_exists(".claude");
  ok = (fs_mkdir(".claude/skills") || fs_exists(".claude/skills")) && ok;
  ok = (fs_mkdir(".claude/skills/openagents-realm") || fs_exists(".claude/skills/openagents-realm")) && ok;
  if !ok || !fs_write(SKILL_PATH, text) { return fail(r, EXIT_FAIL, "could not write .claude/skills/openagents-realm/SKILL.md"); }
  rep_str(r, "skill", SKILL_PATH);
  return rep_done(r, EXIT_OK);
}
