// The transcribe domain: speech in an audio or video file to timestamped
// text, SRT, WebVTT or JSON. Design: psionic/docs/transcribe.md.
//   openagents transcribe FILE [--model tiny|base|small|medium|large-v3|large-v3-turbo]
//                              [--language en|auto|CODE] [--text|--srt|--vtt|--json]
//                              [--backend whispercpp] [--threads N]
//   openagents transcribe models          the cached models
//   openagents transcribe fetch MODEL     downloads one to ~/.cache/openagents/models/whisper
// Backends. The target is Psionic's own Whisper (psionic/lib/whisper/),
// which does not run end to end yet. Until it does, the only backend is the
// interim one, whisper.cpp's whisper-cli (Homebrew: brew install
// whisper-cpp), on the same ggml model files Psionic reads. It is removed
// when Psionic matches it (#12621, #12623).
// Decoding: ffmpeg turns any audio or video into 16 kHz mono 16-bit WAV.
// Firm reason: 6 (no Coax decoder for compressed audio and video
// containers yet); it is one program call, and the WAV it writes is all
// either backend reads.
#load "transcribe-rules.coax";

TR_HF :: "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-";

transcribe_usage :: () {
  print("%\n", "Transcribe (speech to text, on this computer):");
  print("%\n", "  transcribe FILE [--model tiny|base|small|medium|large-v3|large-v3-turbo] [--language en|auto|CODE]");
  print("%\n", "                  [--text|--srt|--vtt|--json] [--backend whispercpp] [--threads N]");
  print("%\n", "                                     audio or video; base and English by default");
  print("%\n", "  transcribe models                  the models in ~/.cache/openagents/models/whisper");
  print("%\n", "  transcribe fetch MODEL             downloads a model (transcribe fetches one it needs)");
  print("%\n", "");
}

// Big buffers for one run, kept off the small frames.
TrRun :: struct { out: [4194304] u8; text: [4194304] u8; segs: [WS_SEGMENTS_MAX] WsSegment; }

tr_cache :: (out: [] u8) -> string {
  env: [1024] u8; h: [1024] u8;
  s := proc_getenv("OPENAGENTS_MODEL_CACHE", env[..]);
  if s.count > 0 { return fs_join(s, "whisper", out); }
  return fs_join(home(h[..]), ".cache/openagents/models/whisper", out);
}
// The model file: CACHE/ggml-NAME.bin.
tr_model_path :: (name: string, out: [] u8) -> string {
  c: [1024] u8; f: [128] u8;
  w: [1] WsOut; w[0].buf = f[..];
  wsg_put(w[..], "ggml-"); wsg_put(w[..], name); wsg_put(w[..], ".bin");
  return fs_join(tr_cache(c[..]), cast(string) f[0..<w[0].n], out);
}
// A program by its environment override, else its name on PATH.
tr_program :: (env_name: string, name: string, out: [] u8) -> string {
  s := proc_getenv(env_name, out);
  return ifx s.count > 0 then s else name;
}

// Downloads ggml-NAME.bin to the cache through a .part file. 0, or an exit code.
tr_fetch :: (r: [] Rep, name: string) -> int {
  p: [1024] u8; part: [1100] u8; url: [512] u8; c: [1024] u8;
  path := tr_model_path(name, p[..]);
  if fs_kind(path) == FS_FILE { return EXIT_OK; }
  if !fs_mkdir(tr_cache(c[..])) { return fail(r, EXIT_FAIL, "cannot make the model cache directory"); }
  w: [1] WsOut; w[0].buf = part[..]; wsg_put(w[..], path); wsg_put(w[..], ".part");
  tmp := cast(string) part[0..<w[0].n];
  u: [1] WsOut; u[0].buf = url[..]; wsg_put(u[..], TR_HF); wsg_put(u[..], name); wsg_put(u[..], ".bin");
  mb: [24] u8;
  tool_err("transcribe: fetching "); tool_err(fs_base(path)); tool_err(" (about ");
  tool_err(int_text(tr_model_mb(name), mb[..])); tool_err(" MB) to "); tool_errln(fs_dir(path));
  argv := [8] string.["curl", "-fL", "--retry", "3", "-sS", "-o", tmp, cast(string) url[0..<u[0].n]];
  out: [256] u8; err: [4096] u8;
  got := proc_run(argv[..], 900000, out[..], err[..]);
  if got.started != 0 || got.status != 0 {
    rm := fs_remove(tmp);
    if got.err_n > 0 { tool_err(cast(string) err[0..<got.err_n]); }
    return fail(r, EXIT_FAIL, "the model download failed (curl)");
  }
  if !fs_rename(tmp, path) { return fail(r, EXIT_FAIL, "cannot move the downloaded model into place"); }
  return EXIT_OK;
}

transcribe_models :: (r: [] Rep) -> int {
  c: [1024] u8; dir := tr_cache(c[..]);
  rep_str(r, "cache", dir);
  l: [1] FsList; n := ifx fs_kind(dir) == FS_DIR then fs_list(dir, l[..]) else 0;
  names: [4096] u8; w: [1] WsOut; w[0].buf = names[..]; k := 0;
  for i: 0..<n {
    e := fs_entry(l[..], i);
    if e.count > 9 && cast(string) e[0..<5] == "ggml-" && cast(string) e[e.count - 4..<e.count] == ".bin" {
      if k > 0 { wsg_byte(w[..], ' '); }
      wsg_put(w[..], cast(string) e[5..<e.count - 4]); k += 1;
    }
  }
  rep_str(r, "models", cast(string) names[0..<w[0].n]);
  rep_str(r, "sizes", "tiny base small medium (each also SIZE.en) large-v3 large-v3-turbo");
  return rep_done(r, EXIT_OK);
}

transcribe_main :: (a: [] Args, r: [] Rep, verb: string) -> int {
  if verb == "" { transcribe_usage(); return EXIT_USAGE; }
  if verb == "models" { return transcribe_models(r); }
  language := args_value(a, "--language", "en");
  if !tr_language_ok(language) { return fail(r, EXIT_USAGE, "--language is en, auto, or a two or three letter code such as de"); }
  nb: [64] u8;
  if verb == "fetch" {
    name := tr_model_name(positional(a, 2), language, nb[..]);
    if name == "" { return fail(r, EXIT_USAGE, "transcribe fetch tiny|base|small|medium|large-v3|large-v3-turbo (or SIZE.en)"); }
    code := tr_fetch(r, name);
    if code != EXIT_OK { return code; }
    p: [1024] u8; rep_str(r, "model", name); rep_str(r, "path", tr_model_path(name, p[..]));
    return rep_done(r, EXIT_OK);
  }
  file := verb;
  if fs_kind(file) != FS_FILE { return fail(r, EXIT_NOT_FOUND, "no such file (openagents transcribe FILE)"); }
  name := tr_model_name(args_value(a, "--model", "base"), language, nb[..]);
  if name == "" { return fail(r, EXIT_USAGE, "--model is tiny, base, small, medium, large-v3 or large-v3-turbo; SIZE.en only with --language en"); }
  format := tr_format(args_has(a, "--text"), args_has(a, "--srt"), args_has(a, "--vtt"), r[0].json);
  if format < 0 { return fail(r, EXIT_USAGE, "pick one of --text, --srt, --vtt and --json"); }
  backend := args_value(a, "--backend", "whispercpp");
  if backend == "psionic" { return fail(r, EXIT_FAIL, "Psionic's Whisper does not run end to end yet (#12623); use --backend whispercpp"); }
  if backend != "whispercpp" { return fail(r, EXIT_USAGE, "--backend is whispercpp (psionic when it lands)"); }
  threads := args_value(a, "--threads", "8");
  if text_int(threads) < 1 || text_int(threads) > 64 { return fail(r, EXIT_USAGE, "--threads is 1 to 64"); }

  code := tr_fetch(r, name);
  if code != EXIT_OK { return code; }
  mp: [1024] u8; model := tr_model_path(name, mp[..]);

  // Decode to 16 kHz mono WAV in a private temporary directory.
  td: [1024] u8; tmp := fs_temp("openagents-transcribe", td[..]);
  if tmp == "" { return fail(r, EXIT_FAIL, "cannot make a temporary directory"); }
  wb: [1100] u8; wav := fs_join(tmp, "audio.wav", wb[..]);
  fb: [1024] u8; ffmpeg := tr_program("OPENAGENTS_FFMPEG", "ffmpeg", fb[..]);
  dec := [14] string.[ffmpeg, "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-i", file, "-vn", "-ar", "16000", "-ac", "1", wav];
  small: [256] u8; err: [8192] u8;
  got := proc_run(dec[..], 900000, small[..], err[..]);
  if got.started != 0 || got.status != 0 {
    rm := fs_remove(tmp);
    if got.err_n > 0 { tool_err(cast(string) err[0..<got.err_n]); }
    if got.started != 0 { return fail(r, EXIT_FAIL, "ffmpeg was not found (brew install ffmpeg, or set OPENAGENTS_FFMPEG)"); }
    return fail(r, EXIT_FAIL, "ffmpeg could not decode the file");
  }

  run_: [1] TrRun; run := run_[..];
  wc: [1024] u8; whisper := tr_program("OPENAGENTS_WHISPER_CLI", "whisper-cli", wc[..]);
  lang := ifx language == "" then "en" else language;
  argv := [10] string.[whisper, "-m", model, "-f", wav, "-np", "-t", threads, "-l", lang];
  t0 := proc_now_ms();
  got = proc_run(argv[..], 900000, run[0].out[..], err[..]);
  ms := proc_now_ms() - t0;
  rm := fs_remove(tmp);
  if got.started != 0 { return fail(r, EXIT_FAIL, "whisper-cli was not found (brew install whisper-cpp, or set OPENAGENTS_WHISPER_CLI)"); }
  if got.status != 0 || got.timed_out {
    if got.err_n > 0 { tool_err(cast(string) err[0..<got.err_n]); }
    return fail(r, EXIT_FAIL, "whisper-cli failed");
  }
  if got.cut { return fail(r, EXIT_FAIL, "the transcript is longer than this build holds (4 MB)"); }
  n := tr_whispercpp_segments(cast(string) run[0].out[0..<got.out_n], run[0].segs[..]);
  if n < 0 { return fail(r, EXIT_FAIL, "more than 4,096 segments; split the file"); }
  w: [1] WsOut; w[0].buf = run[0].text[..];
  segs := run[0].segs[0..<n];
  if format == cast(int) TrFormat.srt { wsg_srt(segs, w[..]); }
  else if format == cast(int) TrFormat.vtt { wsg_vtt(segs, w[..]); }
  else if format == cast(int) TrFormat.json { wsg_json(segs, name, "whispercpp", lang, w[..]); }
  else { wsg_text(segs, w[..]); }
  if w[0].full { return fail(r, EXIT_FAIL, "the transcript does not fit this build's 4 MB output"); }
  print("%", cast(string) run[0].text[0..<w[0].n]);
  if format != cast(int) TrFormat.json {
    sec: [24] u8;
    tool_err("transcribe: "); tool_err(name); tool_err(" on whisper.cpp (interim backend), ");
    tool_err(int_text(ms, sec[..])); tool_errln(" ms");
  }
  return EXIT_OK;
}
