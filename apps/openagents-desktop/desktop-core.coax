// macOS host bridge to the portable desktop core (GitHub #13794, #13787).
// All store, settings, worktree, daemon, worker and signed update logic lives in
// coax/lib/agent/desktop/; this file exports a flat C ABI for Swift.
#run_steps 200000;
#load "../../coax/lib/agent/desktop/os-posix.coax";
#load "../../coax/lib/agent/desktop/paths.coax";
#load "../../coax/lib/agent/desktop/store.coax";
#load "../../coax/lib/agent/desktop/worktree.coax";
#load "../../coax/lib/agent/desktop/daemon.coax";
#load "../../coax/lib/agent/desktop/worker-env.coax";
#load "../../coax/lib/agent/desktop/update.coax";
#load "../../coax/lib/agent/desktop/gym.coax";
#load "../../coax/lib/agent/desktop/executor-store.coax";
#load "../../coax/lib/agent/user-instructions.coax";
#load "../../psionic/lib/peer/executor-release-store.coax";

oa_dc_copy :: (s: string, out: [] u8) -> int {
  if out.count <= 0 { return 0; }
  n := ifx s.count < out.count - 1 then s.count else out.count - 1;
  for i: 0..<n { out[i] = s[i]; }
  out[n] = 0;
  return n;
}

// --- Update verification (openagents.desktop.update.v1) ---

oa_dc_update_verify :: (
  envelope: string,
  key_ids: string,
  key_hexes: string,
  current: string,
  current_build: int,
  allow_file: int,
  out_version: [] u8,
  out_build: [] int,
  out_has_build: [] int,
  out_bundle: [] u8,
  out_team: [] u8,
  out_url: [] u8,
  out_sha256: [] u8,
  out_size: [] int,
  out_notes: [] u8,
  out_err: [] u8
) -> int #export_c #effects(all) {
  keys: [8] DcKey;
  kn := 0;
  if key_ids.count > 0 && key_hexes.count > 0 {
    // Parse tab-separated key_id and hex-encoded 32-byte key pairs.
    pi := 0; ph := 0;
    while kn < 8 && pi < key_ids.count && ph < key_hexes.count {
      ei := pi; while ei < key_ids.count && key_ids[ei] != '\t' { ei += 1; }
      eh := ph; while eh < key_hexes.count && key_hexes[eh] != '\t' { eh += 1; }
      kid := cast(string) key_ids[pi..<ei];
      khex := cast(string) key_hexes[ph..<eh];
      if kid.count > 0 && khex.count == 64 {
        k: DcKey;
        k.id_n = dc_copy(k.id[..], kid);
        ok := true;
        for j: 0..<32 {
          hi := dc_hex_nibble(khex[j * 2]);
          lo := dc_hex_nibble(khex[j * 2 + 1]);
          if hi < 0 || lo < 0 { ok = false; break; }
          k.raw[j] = cast(u8) (hi * 16 + lo);
        }
        k.ok = ok;
        if ok { keys[kn] = k; kn += 1; }
      }
      pi = ifx ei < key_ids.count then ei + 1 else ei;
      ph = ifx eh < key_hexes.count then eh + 1 else eh;
    }
  }
  m: [1] DcManifest;
  code := dc_update_verify(envelope, keys[0..<kn], current, current_build, allow_file != 0, m[..]);
  if code == DC_UPD_OK {
    _ := oa_dc_copy(cast(string) m[0].version[0..<m[0].version_n], out_version);
    if out_build.count > 0 { out_build[0] = m[0].build; }
    if out_has_build.count > 0 { out_has_build[0] = ifx m[0].has_build then 1 else 0; }
    _ := oa_dc_copy(cast(string) m[0].bundle[0..<m[0].bundle_n], out_bundle);
    _ := oa_dc_copy(cast(string) m[0].team[0..<m[0].team_n], out_team);
    _ := oa_dc_copy(cast(string) m[0].url[0..<m[0].url_n], out_url);
    _ := oa_dc_copy(cast(string) m[0].sha[0..<64], out_sha256);
    if out_size.count > 0 { out_size[0] = m[0].size; }
    _ := oa_dc_copy(cast(string) m[0].notes[0..<m[0].notes_n], out_notes);
    return 0;
  }
  _ := oa_dc_copy(dc_update_words(code), out_err);
  return code;
}

dc_hex_nibble :: (c: u8) -> int {
  if c >= '0' && c <= '9' { return cast(int) (c - '0'); }
  if c >= 'a' && c <= 'f' { return cast(int) (c - 'a') + 10; }
  if c >= 'A' && c <= 'F' { return cast(int) (c - 'A') + 10; }
  return -1;
}

oa_dc_update_newer :: (candidate: string, has_build: int, build: int, current: string, current_build: int) -> int #export_c #effects(all) {
  return ifx dc_update_newer(candidate, has_build != 0, build, current, current_build) then 1 else 0;
}

oa_dc_update_archive :: (path: string, expected_size: int, expected_sha256: string, out_err: [] u8) -> int #export_c #effects(all) {
  m: [1] DcManifest;
  m[0].size = expected_size;
  _ := dc_copy(m[0].sha[..], expected_sha256);
  code := dc_update_archive(path, m[..]);
  if code != DC_UPD_OK {
    _ := oa_dc_copy(dc_update_words(code), out_err);
  }
  return code;
}

oa_dc_semver_cmp :: (a: string, b: string) -> int #export_c #effects(all) {
  pa := dc_semver(a);
  pb := dc_semver(b);
  if !pa.ok || !pb.ok { return -2; }
  if dc_semver_less(pa, pb) { return -1; }
  if dc_semver_less(pb, pa) { return 1; }
  return 0;
}

// --- Worktrees & Paths ---

oa_dc_worktrees_on :: () -> int #export_c #effects(all) {
  return ifx dc_worktrees_on() then 1 else 0;
}

oa_dc_wt_root :: (out: [] u8) -> int #export_c #effects(all) {
  hb: [DC_PATH] u8; sb: [DC_PATH] u8; rb: [DC_PATH] u8;
  home := dcos_getenv("HOME", hb[..]);
  set := dcos_getenv("CODER_WORKTREES", sb[..]);
  return oa_dc_copy(dc_worktree_root(home, set, rb[..]), out);
}

oa_dc_wt_slug :: (repo: string, out: [] u8) -> int #export_c #effects(all) {
  rb: [DC_PATH] u8; sb: [256] u8;
  r := dcos_real(repo, rb[..]);
  return oa_dc_copy(dc_slug(ifx r.count > 0 then r else repo, sb[..]), out);
}

oa_dc_wt_real :: (path: string, out: [] u8) -> int #export_c #effects(all) {
  rb: [DC_PATH] u8;
  return oa_dc_copy(dcos_real(path, rb[..]), out);
}

oa_dc_wt_branch :: (chat: string, out: [] u8) -> int #export_c #effects(all) {
