oa_dc_daemon_start_run :: (dir: string, id: string, out_why: [] u8) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], dir);
  why := dc_daemon_start_run(d[..], id, out_why);
  if why.count > 0 {
    _ := oa_dc_copy(why, out_why);
    if why == "not a repository" { return 1; }
    return -1;
  }
  return 0;
}

