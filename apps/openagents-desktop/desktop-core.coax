  return oa_dc_copy(dc_shown(branch), out);
}

oa_dc_wt_path :: (repo: string, chat: string, root: string, out: [] u8) -> int #export_c #effects(all) {
  rb: [DC_PATH] u8; pb: [DC_PATH] u8;
  r := dcos_real(repo, rb[..]);
  return oa_dc_copy(dc_worktree_path(root, ifx r.count > 0 then r else repo, chat, pb[..]), out);
}

oa_dc_wt_main_checkout :: (folder: string, out: [] u8) -> int #export_c #effects(all) {
  mb: [DC_PATH] u8;
  return oa_dc_copy(dc_main_checkout(folder, mb[..]), out);
}

oa_dc_wt_repository :: (folder: string, out: [] u8) -> int #export_c #effects(all) {
