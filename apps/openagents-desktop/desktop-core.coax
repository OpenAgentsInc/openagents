}

oa_dc_wt_cache_env :: (folder: string, out: [] u8) -> int #export_c #effects(all) {
  cb: [DC_PATH] u8;
  return oa_dc_copy(dc_cache_env(folder, cb[..]), out);
}

oa_dc_wt_create :: (repo: string, chat: string, root: string, out_path: [] u8, out_source: [] u8, out_branch: [] u8, out_why: [] u8) -> int #export_c #effects(all) {
  w: [1] DcWorktree;
  why := dc_wt_create(repo, chat, root, w[..], out_why);
  if why.count > 0 {
    _ := oa_dc_copy(why, out_why);
    if why == "not a repository" { return 1; }
    return -1;
  }
  _ := oa_dc_copy(dc_wt_path(w[..]), out_path);
  _ := oa_dc_copy(dc_wt_source(w[..]), out_source);
  _ := oa_dc_copy(dc_wt_branch(w[..]), out_branch);
  return 0;
}

oa_dc_wt_make :: (chat: string, path: string, source: string, branch: string, out_path: [] u8, out_source: [] u8, out_branch: [] u8, out_why: [] u8) -> int #export_c #effects(all) {
  w: [1] DcWorktree;
  dc_wt_set(w[..], chat, path, source, branch);
  why := dc_wt_make(w[..], out_why);
  if why.count > 0 {
    _ := oa_dc_copy(why, out_why);
    if why == "not a repository" { return 1; }
    return -1;
  }
  _ := oa_dc_copy(dc_wt_path(w[..]), out_path);
  _ := oa_dc_copy(dc_wt_source(w[..]), out_source);
  _ := oa_dc_copy(dc_wt_branch(w[..]), out_branch);
  return 0;
}

oa_dc_wt_hydrate :: (chat: string, path: string, source: string, branch: string) -> int #export_c #effects(all) {
  w: [1] DcWorktree;
  dc_wt_set(w[..], chat, path, source, branch);
  dc_wt_hydrate(w[..]);
  return 0;
}

oa_dc_wt_changes :: (chat: string, path: string, source: string, branch: string) -> int #export_c #effects(all) {
  w: [1] DcWorktree;
  dc_wt_set(w[..], chat, path, source, branch);
  return dc_wt_changes(w[..]);
}

oa_dc_wt_remove :: (chat: string, path: string, source: string, branch: string, out_changes: [] int) -> int #export_c #effects(all) {
  w: [1] DcWorktree;
  dc_wt_set(w[..], chat, path, source, branch);
  r := dc_wt_remove(w[..]);
  if out_changes.count > 0 { out_changes[0] = r.changes; }
  return r.result;
}

