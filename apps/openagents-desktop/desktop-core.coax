  return ifx dc_daemon_update_meta(d[..], session, title, folder, pinned, archived) then 1 else 0;
}

// --- Raw socket RPC through desktop core's socket seam ---
oa_dc_daemon_rpc :: (dir: string, req_json: string, out_resp: [] u8) -> int #export_c #effects(all) {
  sb: [DC_PATH] u8;
  sock := dc_daemon_socket(dir, sb[..]);
  if sock.count == 0 { return -1; }
  return dcos_unix_call(sock, req_json, out_resp, 5000);
}

// --- Worker ---

oa_dc_run_spec :: (
  program: string,
  home: string,
  env_set_lines: string,
  env_unset_lines: string,
  out_spec: [] u8
) -> int #export_c #effects(all) {
  e: [1] DcEnv;
  // parse newline-separated K=V lines
  p := 0;
  while p < env_set_lines.count && e[0].set_n < DC_ENV_MAX {
    end := p;
    while end < env_set_lines.count && env_set_lines[end] != '\n' { end += 1; }
    if end > p {
      line := cast(string) env_set_lines[p..<end];
      eq := -1;
      for i: 0..<line.count { if line[i] == '=' { eq = i; break; } }
      if eq > 0 {
        dc_env_add(e[..], cast(string) line[0..<eq], cast(string) line[eq + 1..<line.count]);
      }
    }
    p = ifx end < env_set_lines.count then end + 1 else end;
  }
  q := 0;
  while q < env_unset_lines.count && e[0].unset_n < 2 {
    end := q;
    while end < env_unset_lines.count && env_unset_lines[end] != '\n' { end += 1; }
    if end > q {
      if e[0].unset_n < e[0].unset.count { e[0].unset[e[0].unset_n] = cast(string) env_unset_lines[q..<end]; e[0].unset_n += 1; }
    }
    q = ifx end < env_unset_lines.count then end + 1 else end;
  }
  return dc_run_spec(program, home, e[..], out_spec);
}



// --- Store, keys and settings ---

oa_dc_chats_dir :: (out: [] u8) -> int #export_c #effects(all) {
  b: [DC_PATH] u8;
  return oa_dc_copy(dcos_chats_dir(b[..]), out);
}

oa_dc_coder_file :: (name: string, out: [] u8) -> int #export_c #effects(all) {
  b: [DC_PATH] u8;
  return oa_dc_copy(dcos_coder_file(name, b[..]), out);
}

oa_dc_clean_title :: (raw: string, out: [] u8) -> int #export_c #effects(all) {
  b: [512] u8;
  return oa_dc_copy(dk_clean_title(raw, b[..]), out);
}

oa_dc_store_text :: (dir: string, id: string, out: [] u8) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  _ := dc_store_open(s[..], dir, chats[..]);
  t := dc_store_text(s[..], id, out);
  if t.count == 0 {
    // Check if file actually exists as empty or missing
    fb: [DC_PATH] u8;
    p := dc_store_file(s[..], id, ".json", fb[..]);
    if p.count == 0 || dcos_kind(p) != FS_FILE { return -1; }
  }
  return t.count;
}

oa_dc_store_keep :: (
  dir: string,
  id: string,
  title: string,
  folder: string,
  text: string,
  managed: string,
  wt_path: string,
  wt_branch: string,
  repo: string
) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  // an index it could not read is never written over: that wiped a whole chat list to one chat
  if !dc_store_open(s[..], dir, chats[..]) { return 0; }
  return ifx dc_store_keep(s[..], id, title, folder, text, managed, wt_path, wt_branch, repo, dcos_now_us()) then 1 else 0;
}

oa_dc_store_register :: (
  dir: string,
  id: string,
  title: string,
  folder: string,
  managed: string
) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  // an index it could not read is never written over: that wiped a whole chat list to one chat
  if !dc_store_open(s[..], dir, chats[..]) { return 0; }
  return ifx dc_store_register(s[..], id, title, folder, managed, dcos_now_us()) then 1 else 0;
}

oa_dc_store_rename :: (dir: string, id: string, title: string) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  // an index it could not read is never written over: that wiped a whole chat list to one chat
  if !dc_store_open(s[..], dir, chats[..]) { return 0; }
