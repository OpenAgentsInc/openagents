oa_dc_worker_start_run :: (
  daemon_dir: string,
  program_path: string,
  program_name: string,
  folder: string,
  extra_env: string,
  home: string,
  had_path: string,
  claude_key: string,
  out_run_id: [] u8,
  out_failure: [] u8
) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], daemon_dir);
  d[0].owns_runs = true;
  e: [1] DcEnv;
  dc_worker_env(e[..], program_name, folder, extra_env, home, had_path, claude_key);
  w: [1] DcWorker;
  ok := dc_worker_start_run(w[..], d[..], program_path, home, e[..]);
  _ := oa_dc_copy(dc_worker_run(w[..]), out_run_id);
  _ := oa_dc_copy(dc_worker_failure(w[..]), out_failure);
  return ifx ok then 1 else 0;
}

oa_dc_worker_write_run :: (daemon_dir: string, run_id: string, line: string) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], daemon_dir);
  w: [1] DcWorker;
  dc_worker_attach(w[..], run_id, 0);
  return ifx dc_worker_write(w[..], d[..], line) then 1 else 0;
}

oa_dc_worker_touch_run :: (daemon_dir: string, run_id: string, force: int) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], daemon_dir);
  w: [1] DcWorker;
  dc_worker_attach(w[..], run_id, 0);
  dc_worker_touch(w[..], d[..], force != 0);
  return 1;
}

oa_dc_worker_detach_run :: (daemon_dir: string, run_id: string) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], daemon_dir);
  w: [1] DcWorker;
  dc_worker_attach(w[..], run_id, 0);
  dc_worker_detach(w[..], d[..]);
  return 1;
}

oa_dc_worker_stop_run :: (daemon_dir: string, run_id: string, forget: int) -> int #export_c #effects(all) {
  d: [1] DcDaemon;
  dc_daemon_open(d[..], daemon_dir);
  w: [1] DcWorker;
  dc_worker_attach(w[..], run_id, 0);
  dc_worker_stop(w[..], d[..], forget != 0);
  return 1;
}

oa_dc_wt_clone_paths :: (repo: string, out: [] u8) -> s64 #export_c #effects(all) {
  return dc_clone_paths(repo, out).count;
}

// --- The person's agent instructions (~/.openagents/instructions.md, GitHub #13808) ---
// Settings > General > Agent instructions edits them; coax/lib/agent/user-instructions.coax holds
// every rule (where the file is, the default, seeding and reset). Each returns 1 when it worked.

oa_dc_instructions_path :: (out: [] u8) -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8;
  return oa_dc_copy(uinstr_path(pb[..]), out);
}
// First run: the default into the file when there is none; an existing file is never replaced.
oa_dc_instructions_seed :: () -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8;
  return ifx uinstr_seed(uinstr_path(pb[..])) then 1 else 0;
}
// Reset to default.
oa_dc_instructions_reset :: () -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8;
  return ifx uinstr_reset(uinstr_path(pb[..])) then 1 else 0;
}
// The file's text for the editor into out (the default when there is no file), its length; -1 when
// the file is longer than out holds (out keeps a byte for its end).
oa_dc_instructions_read :: (out: [] u8) -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8; p := uinstr_path(pb[..]);
  if fs_kind(p) == FS_FILE && fs_size(p) >= out.count { return -1; }
  tb: [UINSTR_MAX_BYTES + 1] u8;
  k := fs_kind(p);
  if k == FS_FILE {
    n := fs_read_at(p, 0, tb[..]);
    if n < 0 { return -1; }
    return oa_dc_copy(cast(string) tb[0..<n], out);
  }
  return oa_dc_copy(UINSTR_DEFAULT, out);
}
// The editor's text as the whole file.
oa_dc_instructions_write :: (text: string) -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8;
  return ifx uinstr_write(uinstr_path(pb[..]), text) then 1 else 0;
}
// What Settings' row shows: "Default", "Edited", "Off (empty)" or "Edited (over 4 KB)".
oa_dc_instructions_words :: (out: [] u8) -> int #export_c #effects(all) {
  pb: [FS_PATH_MAX] u8;
  return oa_dc_copy(uinstr_state_words(uinstr_state(uinstr_path(pb[..]))), out);
}
// The most the editor holds (and an agent is told), in bytes.
oa_dc_instructions_max :: () -> int #export_c #effects(all) { return UINSTR_MAX_BYTES; }

// --- Executor Models & Compiled Weight-Module Store (GitHub #13924) ---
// Scans ~/.openagents/modules/ and ~/.openagents/models/inkling-2-mini/, verifies
// real SHA-256 digests on disk, and returns 1 ONLY when Hybrid Executor is verified Ready.
oa_dc_exec_scan :: (
  home: string, ram_mb: int,
  out_status: [] u8, out_lineage: [] u8, out_badge: [] u8, out_details: [] u8, out_counts: [] int
) -> int #export_c #effects(all) {
  return dce_scan(home, ram_mb, out_status, out_lineage, out_badge, out_details, out_counts);
}

// --- Pylon & Executor Network Dashboard + Signed Release Auto-Distribution (GitHub #13928) ---
// Reads real ~/.openagents/pylon/, reconciled settlement receipts (real_bitcoin_moved=true),
// and ~/.openagents/executor/state.json. Zero hardcoded or synthetic counters.
oa_dc_pylon_dashboard :: (
  home: string,
  out_pylon: [] u8, out_contrib: [] u8, out_sats: [] u8, out_release: [] u8, out_details: [] u8,
  out_counts: [] int
) -> int #export_c #effects(all) {
  d: [1] ErsDashboard;
  ers_read_dashboard(home, d[..]);
  ers_format_dashboard(d[..], out_pylon, out_contrib, out_sats, out_release, out_details);
  if out_counts.count >= 5 {
    out_counts[0] = d[0].settled_count;
    out_counts[1] = d[0].verified_traces;
    out_counts[2] = d[0].training_windows;
    out_counts[3] = ifx d[0].staged_sha_n == 64 && cast(string) d[0].shadow_verdict[0..<d[0].shadow_verdict_n] == "promote" then 1 else 0;
    out_counts[4] = ifx d[0].rollback_sha_n == 64 && cast(string) d[0].rollback_sha[0..<64] != cast(string) d[0].active_sha[0..<d[0].active_sha_n] then 1 else 0;
  }
  return ifx d[0].active_disk_ok then 1 else 0;
}

oa_dc_exec_release_stage :: (
  home: string, manifest_path: string, payload_path: string, trusted_pubkey: string, out_err: [] u8
) -> int #export_c #effects(all) {
  trusted := [1] string.[trusted_pubkey];
  rel: [1] ExwRelease; arena: [4096] u8;
  st := ers_stage_signed(home, manifest_path, payload_path, trusted[..], rel[..], arena[..], out_err);
  return cast(int) st;
}

oa_dc_exec_release_promote :: (home: string, out_err: [] u8) -> int #export_c #effects(all) {
  return cast(int) ers_promote_staged(home, out_err);
}

oa_dc_exec_release_rollback :: (home: string, out_err: [] u8) -> int #export_c #effects(all) {
  return cast(int) ers_rollback_active(home, out_err);
}
