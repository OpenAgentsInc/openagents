oa_dc_store_remove :: (dir: string, id: string) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  // an index it could not read is never written over: that wiped a whole chat list to one chat
  if !dc_store_open(s[..], dir, chats[..]) { return 0; }
  return ifx dc_store_remove(s[..], id) then 1 else 0;
}

oa_dc_store_index_read :: (dir: string, out: [] u8) -> int #export_c #effects(all) {
  s: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  if !dc_store_open(s[..], dir, chats[..]) { return 0; }
  o: [1] Jo;
  jo_start(o[..], out);
  dk_index_write(s[0].x[..], o[..]);
  if o[0].bad { return -1; }
  return o[0].n;
}

