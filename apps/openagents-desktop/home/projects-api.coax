// Native assembly of the shared canonical private Projects codec and account chat.
#test "private Projects create with a retained installed command identity" {
 s:[1]Starter;s[0].workspace=true;s[0].page=5;#assert na_pr_press(s[..],"projects.new") && s[0].page==11 && s[0].project[0].canonical && s[0].flight==0;
 #assert na_pr_edit(s[..],"private.name","Research") && na_pr_edit(s[..],"private.text","Be precise");#assert na_pr_press(s[..],"private.create") && s[0].flight==11;
 s[0].action=0;na_reply(s[..],11,0,"{\"command_id\":\"0123456789abcdef0123456789abcdef\",\"now_ms\":1}",false);#assert s[0].flight==4 && s[0].purpose==111 && na_project_request_path(s[..])=="/api/projects/v1";
 s[0].action=0;na_reply(s[..],4,0,"",true);#assert s[0].project[0].uncertain && na_pr_press(s[..],"private.reconcile") && s[0].purpose==111;
}
#test "canonical project chats use saved account threads and never the legacy slug link" {
 s:[1]Starter;p:=s[0].project[..];p[0].canonical=true;p[0].api[0].ni=pr_copy(p[0].api[0].id[..],"prj_0123456789abcdef0123456789abcdef");p[0].api[0].revision=1;s[0].project_thread_n=na_copy(s[0].project_thread[..],cast(string)p[0].api[0].id[..]);s[0].project_link_pending=true;s[0].thread[0].id_n=na_copy(s[0].thread[0].id[..],"m_00000000000000000001");s[0].thread[0].revision=1;
 na_complete(s[..]);#assert s[0].purpose==117 && na_project_request_path(s[..])=="/api/projects/v1/prj_0123456789abcdef0123456789abcdef/chats";
}
na_pr_id :: (s:[]Starter)->string {return cast(string)s[0].project[0].api[0].id[0..<s[0].project[0].api[0].ni];}
na_pr_get :: (s:[]Starter,op:string,purpose:int) {path:[256]u8;na_http(s,pr_route(na_pr_id(s),op,path[..]),"",purpose);}
na_pr_open :: (s:[]Starter,id:string) {na_nav_keep(s);s[0].durable_project_index[0]=CtIndex.{};s[0].durable_project_refresh=false;s[0].project_thread_n=0;s[0].project_link_pending=false;s[0].project[0]=ProjectApp.{};p:=s[0].project[..];p[0].canonical=true;p[0].api[0].ni=pr_copy(p[0].api[0].id[..],id);s[0].environments[0].active=false;s[0].navigation[0].open=false;s[0].page=11;na_pr_get(s,"",110);}
na_pr_dispatch :: (s:[]Starter) {p:=s[0].project[..];b:[131072]u8;n:=pja_pending_body(p,b[..]);if n<1 || n>60000 {pja_note(p,"This request is too large. Shorten the text.");return;}na_http(s,cast(string)p[0].pending_path[0..<p[0].pending_np],cast(string)b[0..<n],p[0].pending_purpose);}
na_pr_mutate :: (s:[]Starter,path:string,value:string,revision:int,purpose:int) {p:=s[0].project[..];if !pja_pending_begin(p,path,value,revision,purpose) {pja_note(p,"A save is pending, or this request is too large.");return;}s[0].purpose=119;na_request(s,11,"");}
na_pr_complete :: (s:[]Starter) {p:=s[0].project[..];t:=s[0].thread[..];v:[256]u8;path:[256]u8;op:[80]u8;o:[1]Jo;jo_start(o[..],op[..]);jo_put(o[..],ifx s[0].project_link_pending then "link/" else "complete/");jo_put(o[..],cast(string)t[0].id[0..<t[0].id_n]);if !s[0].project_link_pending {jo_put(o[..],"/");jo_int(o[..],t[0].revision);}
 body:[1024]u8;n:=pr_mutation(jo_text(o[..]),p[0].api[0].revision,pr_chat_value(cast(string)t[0].id[0..<t[0].id_n],ifx s[0].project_link_pending then 0 else t[0].revision,v[..]),body[..]);if n<1 {na_note(s,"Project request is too large.");return;}
 na_http(s,pr_route(na_pr_id(s),ifx s[0].project_link_pending then "chats" else "complete",path[..]),cast(string)body[0..<n],ifx s[0].project_link_pending then 117 else 5);
}
na_pr_edit :: (s:[]Starter,id:string,text:string)->bool {p:=s[0].project[..];if id=="private.name" {n:=pr_copy(p[0].api_name[..],text);if n>=0 {p[0].api_nn=n;}return true;}if id=="private.text" {n:=pr_copy(p[0].api_text[..],text);if n>=0 {p[0].api_nt=n;}return true;}if id=="private.knowledge.title" {n:=pr_copy(p[0].api_title[..],text);if n>=0 {p[0].api_nl=n;}return true;}return false;}
na_pr_press :: (s:[]Starter,id:string)->bool {
 p:=s[0].project[..];chosen:= -1;for i:0..<s[0].private_projects[0].n {b:[96]u8;if id==tr_join(b[..],"private.item.",i) {chosen=i;}}
 canonical_back:=p[0].canonical && id=="project.chat.back";
 known:=chosen>=0 || id=="projects.new" || id=="projects.publish.new" || id=="private.more" || id=="private.first" || canonical_back;
 if p[0].canonical {for key:[12]string.["private.back","private.create","private.instructions","private.save.instructions","private.knowledge","private.add.text","private.add.file","private.chats","private.chat.new","private.reconcile","private.close.edit","private.refresh"] {if id==key {known=true;}}for i:0..<p[0].knowledge[0].n {b:[96]u8;if id==tr_join(b[..],"private.remove.",i) {known=true;}if id==tr_join(b[..],"private.source.",i) {known=true;}}for i:0..<p[0].chats[0].n {b:[96]u8;if id==tr_join(b[..],"private.chat.",i) {known=true;}}}
 d:[1]Jv;nodes:[2048]JvNode;upload:= -1;if p[0].canonical && jv_parse(d[..],cast(string)p[0].drops[0..<p[0].nl],nodes[..]) {rows:=jv_get(d[0],0,"drops");for i:0..<jv_len(d[0],rows) {b:[96]u8;if id==tr_join(b[..],"private.upload.",i) {known=true;upload=i;}}}
 if !known {return false;}if s[0].flight!=0 || s[0].action!=0 || s[0].environments[0].flight || s[0].environments[0].random {s[0].navigation[0].np=ea_copy(s[0].navigation[0].pending[..],id);return true;}
 if (s[0].environments[0].uncertain || s[0].usage[0].uncertain) {nav_note(s[0].navigation[..],"Resolve the current request before changing Projects.");return true;}
 if p[0].uncertain && id!="private.reconcile" {pja_note(p,"Check the saved result before another change.");return true;}
 if upload>=0 {rows:=jv_get(d[0],0,"drops");row:=jv_at(d[0],rows,upload);p[0].ndrop=pr_string(d[0],jv_get(d[0],row,"id"),p[0].drop[..]);p[0].api_page=3;if p[0].ndrop>0 {na_project_pick(s,false);}return true;}
 if chosen>=0 {r:=s[0].private_projects[0].items[chosen];na_pr_open(s,cast(string)r.id[0..<r.ni]);return true;}
 if id=="projects.publish.new" {na_nav_keep(s);na_project_new(s,false);return true;}
 if id=="projects.new" {na_nav_keep(s);p[0]=ProjectApp.{};p[0].canonical=true;p[0].api_page=1;s[0].environments[0].active=false;s[0].navigation[0].open=false;s[0].page=11;return true;}
 if id=="private.more" || id=="private.first" {path:[160]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"/api/projects/v1");if id=="private.more" {jo_put(o[..],"?cursor=");jo_put(o[..],cast(string)s[0].private_projects[0].next[0..<s[0].private_projects[0].nn]);}na_http(s,jo_text(o[..]),"",109);return true;}
 if id=="private.back" {s[0].page=5;s[0].project_thread_n=0;na_http(s,"/api/projects","",90);return true;}
 if id=="private.refresh" {na_pr_get(s,"",110);return true;}
 if id=="private.reconcile" {if p[0].pending_purpose>0 && p[0].pending_no>0 {na_pr_dispatch(s);return true;}if p[0].nfile_id>0 {path:[96]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"files/");jo_put(o[..],cast(string)p[0].file_id[0..<p[0].nfile_id]);jo_put(o[..],"/done");na_drop_http(s,jo_text(o[..]),"{}",101);}else {na_http(s,"/api/drops","",96);}return true;}
 if canonical_back || id=="private.chats" {na_nav_keep(s);s[0].page=11;p[0].api_page=4;na_pr_get(s,"chats",116);return true;}
 if id=="private.chat.new" {na_nav_keep(s);na_new(s);s[0].world_mode=false;s[0].project_thread_n=na_copy(s[0].project_thread[..],na_pr_id(s));return true;}
 for i:0..<p[0].chats[0].n {b:[96]u8;if id==tr_join(b[..],"private.chat.",i) {r:=p[0].chats[0].items[i];s[0].project_thread_n=na_copy(s[0].project_thread[..],na_pr_id(s));path:[128]u8;na_http(s,tr_cat(path[..],"/api/chat/thread/v1?id=",cast(string)r.id[0..<r.id_n]),"",3);return true;}}
 for i:0..<p[0].knowledge[0].n {b:[96]u8;if id==tr_join(b[..],"private.source.",i) {row:=p[0].knowledge[0].items[i];path:[96]u8;o:[1]Jo;jo_start(o[..],path[..]);jo_put(o[..],"knowledge/");jo_put(o[..],cast(string)row.id[0..<row.ni]);jo_put(o[..],"/content");na_pr_get(s,jo_text(o[..]),120);return true;}}
 if id=="private.instructions" {p[0].api_nt=pr_copy(p[0].api_text[..],cast(string)p[0].api[0].instructions[0..<p[0].api[0].nt]);if p[0].api_nt<0 {p[0].api_nt=0;pja_note(p,"These instructions exceed this phone editor's 20,000-byte limit. The saved text is unchanged.");return true;}p[0].api_page=2;return true;}
 if id=="private.knowledge" {p[0].api_page=3;p[0].api_nt=0;na_pr_get(s,"knowledge",114);return true;}
 if id=="private.close.edit" {p[0].api_page=0;return true;}
 if id=="private.add.file" {if p[0].ndrop>0 {na_project_pick(s,false);}else {p[0].request=3;na_http(s,"/api/drops","{}",99);}return true;}
 path:[256]u8;value:[65536]u8;
 if id=="private.create" {if p[0].api_nn<1 {pja_note(p,"Give your Project a name.");return true;}v:=pr_value(1,cast(string)p[0].api_name[0..<p[0].api_nn],cast(string)p[0].api_text[0..<p[0].api_nt],value[..]);if v.count==0 {pja_note(p,"Shorten the instructions.");return true;}na_pr_mutate(s,"/api/projects/v1",v,-1,111);return true;}
 if id=="private.save.instructions" {v:=pr_value(3,"",cast(string)p[0].api_text[0..<p[0].api_nt],value[..]);if v.count>0 {na_pr_mutate(s,pr_route(na_pr_id(s),"instructions",path[..]),v,p[0].api[0].revision,112);}return true;}
 if id=="private.add.text" {if p[0].api_nl<1 || p[0].api_nt<1 {pja_note(p,"Give the knowledge a title and some reference text.");return true;}v:=pr_value(4,cast(string)p[0].api_title[0..<p[0].api_nl],cast(string)p[0].api_text[0..<p[0].api_nt],value[..]);if v.count>0 {na_pr_mutate(s,pr_route(na_pr_id(s),"knowledge",path[..]),v,p[0].api[0].revision,113);}return true;}
 for i:0..<p[0].knowledge[0].n {b:[96]u8;if id==tr_join(b[..],"private.remove.",i) {row:=p[0].knowledge[0].items[i];suffix:[96]u8;o:[1]Jo;jo_start(o[..],suffix[..]);jo_put(o[..],"knowledge/");jo_put(o[..],cast(string)row.id[0..<row.ni]);jo_put(o[..],"/remove");na_pr_mutate(s,pr_route(na_pr_id(s),jo_text(o[..]),path[..]),"",p[0].api[0].revision,115);return true;}}
 return true;
}
na_pr_file :: (s:[]Starter,file:string) {p:=s[0].project[..];b:[1024]u8;path:[256]u8;value:=pr_value(9,cast(string)p[0].file[0..<p[0].nfile],file,b[..]);na_pr_mutate(s,pr_route(na_pr_id(s),"knowledge",path[..]),value,p[0].api[0].revision,113);}
na_pr_reply :: (s:[]Starter,op:int,status:int,raw:string,failed:bool)->bool {
 p:=s[0].project[..];purpose:=s[0].purpose;if op==11 && purpose==119 {s[0].flight=0;s[0].purpose=0;s[0].dirty=true;d:[1]Jv;n:[16]JvNode;if failed || !jv_parse(d[..],raw,n[..]) {pja_note(p,"Could not create an operation ID.");return true;}p[0].pending_no=pr_string(d[0],jv_get(d[0],0,"command_id"),p[0].pending_operation[..]);if p[0].pending_no!=32 {pja_note(p,"Invalid operation ID.");return true;}na_pr_dispatch(s);return true;}
 if op!=4 || purpose<109 || (purpose>118 && purpose!=120 && purpose!=121) {return false;}s[0].flight=0;s[0].purpose=0;s[0].dirty=true;
 if status==401 {na_history_clear(s);s[0].page=0;s[0].account_ready=false;na_note(s,"Log in again to see Projects.");return true;}
 if failed || status<200 || status>=300 {if purpose==109 {s[0].private_projects_failed=true;return true;}if status==404 || (status==403 && (purpose==110 || purpose==114 || purpose==116 || purpose==120 || purpose==121)) {p[0].api_loaded=false;id:=p[0].api[0].id;ni:=p[0].api[0].ni;p[0].api[0]=PrProject.{};p[0].api[0].id=id;p[0].api[0].ni=ni;p[0].knowledge[0]=PrKnowledgeIndex.{};p[0].chats[0]=ChatHistory.{};s[0].thread[0]=AccountThread.{};s[0].project_thread_n=0;}
  if !failed && (status==400 || status==403 || status==404 || status==409 || status==413 || status==422) && purpose!=117 {p[0].pending_purpose=0;p[0].pending_no=0;}if purpose==117 {s[0].retry=true;na_note(s,"The Project chat link did not finish. Retry the same saved conversation.");return true;}if failed || status==0 || status>=500 {if p[0].mutation {p[0].uncertain=true;}}pja_note(p,ifx status==409 then "Project changed. Refresh before saving again." else "Project request did not finish. Check its saved result before retrying.");return true;}
 if purpose==120 {n:=pr_content_read(raw,"",p[0].api_content[..]);if n>=0 {p[0].api_nc=n;p[0].api_page=5;return true;}pja_note(p,"The complete knowledge source could not be read.");return true;}
 if purpose==109 {s[0].private_projects_failed= !pr_index_read(raw,s[0].private_projects[..]);return true;}
 if purpose==110 || purpose==111 || purpose==117 || purpose==121 {if !pr_project_read(raw,p[0].api[..]) {if purpose==111 {p[0].uncertain=true;}if purpose==117 {s[0].retry=true;}pja_note(p,"The complete Project could not be read. Check the saved result.");return true;}p[0].canonical=true;p[0].api_loaded=true;p[0].uncertain=false;if purpose==111 {p[0].api_page=0;p[0].pending_purpose=0;p[0].pending_no=0;}if purpose==121 {s[0].project_thread_n=na_copy(s[0].project_thread[..],na_pr_id(s));path:[128]u8;na_http(s,tr_cat(path[..],"/api/chat/thread/v1?id=",cast(string)p[0].resume_chat[0..<p[0].resume_n]),"",3);return true;}if purpose==117 {s[0].project_link_pending=false;na_complete(s);}return true;}
 if purpose==112 || purpose==113 || purpose==115 {valid:=pr_mutation_result(raw,ifx purpose==112 then 3 else ifx purpose==113 then 4 else 5,na_pr_id(s),"",p[0].pending_revision);if !valid {p[0].uncertain=true;pja_note(p,"The save response could not be read. Check the saved result.");return true;}p[0].uncertain=false;p[0].pending_no=0;p[0].pending_purpose=0;if purpose==113 {p[0].nfile_id=0;p[0].api_nt=0;p[0].api_nl=0;}if purpose==112 {p[0].api_page=0;}na_pr_get(s,"",118);return true;}
 if purpose==118 {if !pr_project_read(raw,p[0].api[..]) {pja_note(p,"Could not read the saved Project. Refresh it.");return true;}p[0].api_loaded=true;if p[0].api_page==3 {na_pr_get(s,"knowledge",114);}return true;}
 if purpose==114 {if !pr_knowledge_read(raw,p[0].knowledge[..]) {pja_note(p,"Knowledge could not be read completely.");}return true;}
 if purpose==116 {next:=chh_read(raw);if !next.ok {pja_note(p,"Project chats could not be read.");}else {p[0].chats[0]=next;}s[0].durable_project_refresh=true;return true;}
 return true;
}
na_pr_rows :: (s:[]Starter,t:[]Tree,u:[]Ui) {x:= -1;if s[0].private_projects_failed {x=k_text(t,u,"private.list.error",TG_P,"note","Private Projects are unavailable. Cached rows are kept.");}for i:0..<s[0].private_projects[0].n {row:=s[0].private_projects[0].items[i];id:[96]u8;x=k_row(t,u,tr_join(id[..],"private.item.",i),cast(string)row.name[0..<row.nn],"Private",false);}if s[0].private_projects[0].nn>0 {x=k_link(t,"private.more","More private Projects");}x=k_link(t,"private.first","First private Projects");}
na_pr_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 p:=s[0].project[..];a:=p[0].api[..];na_project_header(t,u,ifx p[0].api_page==1 then "New private Project" else cast(string)a[0].name[0..<a[0].nn]);x:=k_link(t,"private.back","Projects");if p[0].nn>0 {x=k_text(t,u,"private.note",TG_P,"note",cast(string)p[0].note[0..<p[0].nn]);}if p[0].uncertain {x=k_link(t,"private.reconcile","Check saved result");return;}
 if p[0].api_page==1 {x=k_input(t,u,"private.name","Project name","Name","text","");tr_attr(t,x,AT_VALUE,cast(string)p[0].api_name[0..<p[0].api_nn]);x=k_code_field(t,u,"private.text","Optional instructions","Instructions");tr_attr(t,x,AT_VALUE,cast(string)p[0].api_text[0..<p[0].api_nt]);x=k_button(t,u,"private.create","Create private Project",ifx s[0].flight==0 then BS_PRIMARY else BS_BUSY);return;}
 if !p[0].api_loaded {x=k_text(t,u,"private.loading",TG_P,"meta","Loading private Project…");x=k_link(t,"private.refresh","Refresh");return;}
 if p[0].api_page==6 {x=k_text(t,u,"private.upload.note",TG_P,"note","Choose a saved upload to continue. No new upload was started automatically.");d:[1]Jv;nodes:[2048]JvNode;if jv_parse(d[..],cast(string)p[0].drops[0..<p[0].nl],nodes[..]) {rows:=jv_get(d[0],0,"drops");for i:0..<jv_len(d[0],rows) {id:[96]u8;b:[32]u8;n:=pr_string(d[0],jv_get(d[0],jv_at(d[0],rows,i),"id"),b[..]);if n>0 {x=k_link(t,tr_join(id[..],"private.upload.",i),cast(string)b[0..<n]);}}}x=k_link(t,"private.knowledge","Knowledge");return;}
 if p[0].api_page==5 {x=k_message(t,u,"private.source.text",true,s[0].markdown[..],cast(string)p[0].api_content[0..<p[0].api_nc]);x=k_link(t,"private.knowledge","Knowledge");return;}
 if p[0].api_page==2 {x=k_code_field(t,u,"private.text","How should the agent respond?","Instructions");tr_attr(t,x,AT_VALUE,cast(string)p[0].api_text[0..<p[0].api_nt]);x=k_link(t,"private.save.instructions","Save instructions");x=k_link(t,"private.close.edit","Close");return;}
 if p[0].api_page==3 {x=k_text(t,u,"private.knowledge.limits",TG_P,"meta","Paste reference text, or attach a scanned text or Markdown file up to 64 KiB. Knowledge is private and selected for new chats.");x=k_input(t,u,"private.knowledge.title","Reference title","Knowledge title","text","");tr_attr(t,x,AT_VALUE,cast(string)p[0].api_title[0..<p[0].api_nl]);x=k_code_field(t,u,"private.text","Reference material","Knowledge text");tr_attr(t,x,AT_VALUE,cast(string)p[0].api_text[0..<p[0].api_nt]);x=k_link(t,"private.add.text","Add knowledge");x=k_link(t,"private.add.file","Attach text file");for i:0..<p[0].knowledge[0].n {row:=p[0].knowledge[0].items[i];id:[96]u8;x=k_link(t,tr_join(id[..],"private.source.",i),cast(string)row.title[0..<row.nn]);x=k_link(t,tr_join(id[..],"private.remove.",i),"Remove");}x=k_link(t,"private.close.edit","Project");return;}
 if p[0].api_page==4 {x=k_icon_button(t,"private.chat.new",IC_PLUS,"New Project chat");na_durable_rows(s,t,u,true);for i:0..<p[0].chats[0].n {row:=p[0].chats[0].items[i];id:[96]u8;x=k_row(t,u,tr_join(id[..],"private.chat.",i),cast(string)row.title[0..<row.title_n],"Personal",false);}x=k_link(t,"private.close.edit","Project");return;}
 x=k_text(t,u,"private.visibility",TG_P,"meta","Private · only your account");x=k_message(t,u,"private.instructions.preview",true,s[0].markdown[..],ifx a[0].nt>0 then cast(string)a[0].instructions[0..<a[0].nt] else "No instructions yet.");x=k_link(t,"private.instructions","Edit instructions");x=k_link(t,"private.knowledge","Knowledge");x=k_link(t,"private.chats","Project chats");x=k_icon_button(t,"private.chat.new",IC_PLUS,"New Project chat");x=k_link(t,"private.refresh","Refresh");
}

#test "later private Project turns complete without replaying the first link with a different revision" {
 s:[1]Starter;p:=s[0].project[..];p[0].canonical=true;p[0].api[0].ni=pr_copy(p[0].api[0].id[..],"prj_0123456789abcdef0123456789abcdef");p[0].api[0].revision=2;s[0].project_thread_n=na_copy(s[0].project_thread[..],na_pr_id(s[..]));s[0].thread[0].id_n=na_copy(s[0].thread[0].id[..],"m_00000000000000000001");s[0].thread[0].revision=2;s[0].thread[0].n=2;for i:0..<2 {s[0].thread[0].messages[i].n=1;s[0].thread[0].messages[i].text[0]='H';}s[0].thread[0].messages[1].assistant=true;s[0].draft_n=na_copy(s[0].draft[..],"Next");na_send(s[..]);#assert s[0].purpose==4 && !s[0].project_link_pending;s[0].action=0;
 na_reply(s[..],4,200,"{\"schema\":\"openagents.chat.thread.v1\",\"id\":\"m_00000000000000000001\",\"revision\":3,\"messages\":[{\"role\":\"user\",\"content\":\"H\"},{\"role\":\"assistant\",\"content\":\"H\"},{\"role\":\"user\",\"content\":\"Next\"}]}",false);
 #assert s[0].purpose==5 && !s[0].project_link_pending && na_project_request_path(s[..])=="/api/projects/v1/prj_0123456789abcdef0123456789abcdef/complete";
}

#test "lost file knowledge saves replay their receipt before checking the upload again" {
 s:[1]Starter;p:=s[0].project[..];p[0].canonical=true;p[0].uncertain=true;p[0].nfile_id=pr_copy(p[0].file_id[..],"f-0123456789abcdef");p[0].pending_purpose=113;p[0].pending_no=pr_copy(p[0].pending_operation[..],"one");p[0].pending_np=pr_copy(p[0].pending_path[..],"/api/projects/v1/prj_0123456789abcdef0123456789abcdef/knowledge");p[0].pending_nv=pr_copy(p[0].pending_value[..],"{}");p[0].pending_revision=1;
 #assert na_pr_press(s[..],"private.reconcile") && s[0].purpose==113 && na_project_request_path(s[..])=="/api/projects/v1/prj_0123456789abcdef0123456789abcdef/knowledge";
}
#test "refused knowledge files stay in private Projects and never open a publication draft" {
 s:[1]Starter;s[0].project[0].canonical=true;s[0].flight=4;s[0].purpose=101;s[0].page=11;na_reply(s[..],4,200,"{\"file\":{\"status\":\"refused\"}}",false);#assert s[0].page==11 && s[0].flight==0 && !s[0].project[0].uncertain;
}
#test "a denied write keeps owned reads, while a denied read clears private content and keeps the refresh address" {
 s:[1]Starter;p:=s[0].project[..];p[0].canonical=true;p[0].api_loaded=true;p[0].api[0].ni=pr_copy(p[0].api[0].id[..],"prj_0123456789abcdef0123456789abcdef");p[0].api[0].nt=pr_copy(p[0].api[0].instructions[..],"Private");s[0].flight=4;s[0].purpose=112;na_reply(s[..],4,403,"{}",false);#assert p[0].api_loaded && p[0].api[0].nt==7;
 s[0].flight=4;s[0].purpose=110;na_reply(s[..],4,404,"{}",false);#assert !p[0].api_loaded && p[0].api[0].nt==0 && p[0].api[0].ni==36;
}
