// The Linux and Windows hosts' bridge to the portable desktop core (GitHub #13781, #13782,
// #13787). All store, settings, worktree, daemon, worker and signed update logic lives in
// coax/lib/agent/desktop/; this file exposes a small C ABI for host-main.c (linux/main.c,
// windows/main.c). The same code runs on both: the core's seam picks the system at run time.
#load "../../coax/lib/agent/desktop/os-posix.coax";
#load "../../coax/lib/agent/desktop/worker-env.coax";
#load "../../coax/lib/agent/desktop/update.coax";
#load "../../coax/lib/agent/desktop/flags.coax";

OA_MAX_SUBAGENTS :: 8;

OaCore :: struct {
  store: [1] DcStore;
  chats: [DC_CHATS] DkChat;
  daemon: [1] DcDaemon;
  worker: [1] DcWorker;
  subagents: [OA_MAX_SUBAGENTS] DcWorker;
  wt: [1] DcWorktree;
  has_wt: bool;
  store_open: bool;
  store_dir: bool;
  daemon_open: bool;
}

oa_copy_out :: (s: string, out: [] u8) -> int {
  if out.count <= 0 { return 0; }
  n := ifx s.count < out.count - 1 then s.count else out.count - 1;
  for i: 0..<n { out[i] = s[i]; }
  out[n] = 0;
  return n;
}

oa_core_init :: (c: [] OaCore, store_dir: string, daemon_dir: string) -> int #export_c #effects(all) {
  sb: [DC_PATH] u8;
  sdir := ifx store_dir.count > 0 then store_dir else dcos_chats_dir(sb[..]);
  c[0].store_open = dc_store_open(c[0].store[..], sdir, c[0].chats[..]);
  c[0].store_dir = true;   // the store's folder is set even when its index could not be read
  db: [DC_PATH] u8;
  ddir := ifx daemon_dir.count > 0 then daemon_dir else dcos_daemon_dir(db[..]);
  dc_daemon_open(c[0].daemon[..], ddir);
  c[0].daemon_open = true;
  c[0].worker[0].h = -1;
  for i: 0..<OA_MAX_SUBAGENTS { c[0].subagents[i].h = -1; }
  return ifx c[0].store_open then 1 else 0;
}

oa_core_daemon_ensure :: (c: [] OaCore, program: string, wait_ms: int) -> int #export_c #effects(all) {
  if !c[0].daemon_open { return 0; }
  started: [1] int;
  if dc_daemon_ensure(c[0].daemon[..], program, wait_ms, started[..]) { return 1; }
  return 0;
}

oa_core_daemon_available :: (c: [] OaCore) -> int #export_c #effects(all) {
  if !c[0].daemon_open { return 0; }
  return ifx dc_daemon_available(c[0].daemon[..]) then 1 else 0;
}

oa_core_daemon_owns_runs :: (c: [] OaCore) -> int #export_c #effects(all) {
  if !c[0].daemon_open { return 0; }
  return ifx c[0].daemon[0].owns_runs then 1 else 0;
}

oa_core_daemon_read_foreman :: (c: [] OaCore, tier_out: [] int) -> int #export_c #effects(all) {
  if !c[0].daemon_open { return 0; }
  v: [1] DmView;
  if !dc_daemon_read_foreman(c[0].daemon[..], v[..]) || !v[0].ok { return 0; }
  if tier_out.count > 0 { tier_out[0] = v[0].foreman[0].tier; }
  return 1;
}

oa_core_daemon_update_foreman :: (c: [] OaCore, tier: int, prompt: string) -> int #export_c #effects(all) {
  if !c[0].daemon_open { return 0; }
  return ifx dc_daemon_update_foreman(c[0].daemon[..], tier, prompt) then 1 else 0;
}

// Before every write the index is read again from disk, as the Mac host opens it for each write:
// a chat another Coder process kept since this one started stays in the list, and an index that
// can't be read (damaged, or longer than the store holds) is never written over. Writing over it
// is what wiped a Mac owner's list of 74 chats to one (4b957c4de3).
oa_store_fresh :: (c: [] OaCore) -> bool #effects(all) {
  if !c[0].store_dir { return false; }
  c[0].store_open = dc_store_reload(c[0].store[..]);
  return c[0].store_open;
}

oa_core_store_path :: (c: [] OaCore, out: [] u8) -> int #export_c #effects(all) {
  if !c[0].store_dir { return 0; }
  return oa_copy_out(dc_store_dir(c[0].store[..]), out);
}

oa_core_store_ok :: (c: [] OaCore) -> int #export_c #effects(all) {
  return ifx c[0].store_open then 1 else 0;
}

oa_core_new_id :: (out: [] u8) -> int #export_c #effects(all) {
  b: [64] u8;
  return oa_copy_out(dc_new_id(b[..]), out);
}

oa_core_now_ms :: () -> int #export_c #effects(all) {
  return dcos_now_ms();
}

oa_core_store_lines :: (c: [] OaCore, out: [] u8) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  return oa_copy_out(dc_store_lines(c[0].store[..], out), out);
}

oa_core_store_count :: (c: [] OaCore) -> int #export_c #effects(all) {
  if !c[0].store_open { return 0; }
  return c[0].store[0].x[0].n;
}

oa_core_store_id :: (c: [] OaCore, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if !c[0].store_open || idx < 0 || idx >= c[0].store[0].x[0].n { return 0; }
  return oa_copy_out(dk_id(c[0].store[0].x[..], idx), out);
}

oa_core_store_folder :: (c: [] OaCore, id: string, out: [] u8) -> int #export_c #effects(all) {
  if !c[0].store_open { return 0; }
  i := dk_find(c[0].store[0].x[..], id);
  if i < 0 { return 0; }
  return oa_copy_out(dk_folder(c[0].store[0].x[..], i), out);
}

oa_core_store_text :: (c: [] OaCore, id: string, out: [] u8) -> int #export_c #effects(all) {
  if !c[0].store_open || out.count <= 1 { return 0; }
  t := dc_store_text(c[0].store[..], id, out[0..<out.count - 1]);
  out[t.count] = 0;
  return t.count;
}

oa_core_store_keep :: (c: [] OaCore, id: string, title: string, folder: string, text: string, wt_path: string, wt_branch: string, repo: string) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  // dc_store_keep takes wall-clock microseconds (it wrote seconds here before: 1970 dates)
  ok := dc_store_keep(c[0].store[..], id, title, folder, text, "", wt_path, wt_branch, repo, dcos_now_us());
  return ifx ok then 1 else 0;
}

oa_core_store_rename :: (c: [] OaCore, id: string, title: string) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  return ifx dc_store_rename(c[0].store[..], id, title) then 1 else 0;
}

oa_core_store_toggle_pin :: (c: [] OaCore, id: string) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  return ifx dc_store_toggle_pin(c[0].store[..], id) then 1 else 0;
}

oa_core_store_move_pin :: (c: [] OaCore, id: string, to: int) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  return ifx dc_store_move_pin(c[0].store[..], id, to) then 1 else 0;
}

oa_core_store_remove :: (c: [] OaCore, id: string) -> int #export_c #effects(all) {
  if !oa_store_fresh(c) { return 0; }
  return ifx dc_store_remove(c[0].store[..], id) then 1 else 0;
}

// The working folder's files the agent's @ list offers, one a line: git's list for a repository
// (what Coder's folderFiles asks first), else none. Its length.
oa_core_files :: (folder: string, out: [] u8) -> int #export_c #effects(all) {
  if out.count <= 0 { return 0; }
  argv := [4] string.["git", "-C", folder, "ls-files"]; none: [1] string;
  r := dcos_run(argv[..], none[0..<0], out[0..<out.count - 1]);
  n := ifx r.started == 0 && r.status == 0 then r.n else 0;
  out[n] = 0;
  return n;
}

oa_core_key_read :: (name: string, out: [] u8) -> int #export_c #effects(all) {
  b: [8192] u8;
  return oa_copy_out(dc_key_read(name, b[..]), out);
}

oa_core_key_save :: (name: string, key: string) -> int #export_c #effects(all) {
  return ifx dc_key_save(name, key) then 1 else 0;
}

oa_core_worktrees_on :: () -> int #export_c #effects(all) {
  return ifx dc_worktrees_on() then 1 else 0;
}

oa_core_wt_create :: (c: [] OaCore, folder: string, chat_id: string, out_path: [] u8, out_branch: [] u8, out_repo: [] u8, out_why: [] u8) -> int #export_c #effects(all) {
  rb: [DC_PATH] u8;
  repo := dc_repository(folder, rb[..]);
  if repo.count == 0 { return 0; }
  hb: [DC_PATH] u8; wb: [DC_PATH] u8;
  root := dc_worktree_root(dcos_home(hb[..]), "", wb[..]);
  why := dc_wt_create(repo, chat_id, root, c[0].wt[..], out_why);
  if why.count > 0 { return -1; }
  c[0].has_wt = true;
  _ := oa_copy_out(dc_wt_path(c[0].wt[..]), out_path);
  _ := oa_copy_out(dc_wt_branch(c[0].wt[..]), out_branch);
  _ := oa_copy_out(dc_wt_source(c[0].wt[..]), out_repo);
  return 1;
}

oa_core_worker_start :: (c: [] OaCore, program: string, folder: string, extra_env: string, err_out: [] u8) -> int #export_c #effects(all) {
  hb: [DC_PATH] u8; home := dcos_home(hb[..]);
  pb: [DC_PATH] u8; had_path := dcos_getenv("PATH", pb[..]);
  kb: [4096] u8; key := dc_claude_key(kb[..]);
  e: [1] DcEnv;
  dc_worker_env(e[..], program, folder, extra_env, home, had_path, key);
  ok := dc_worker_start(c[0].worker[..], c[0].daemon[..], program, folder, e[..]);
  if !ok {
    _ := oa_copy_out(dc_worker_failure(c[0].worker[..]), err_out);
    return 0;
  }
  return 1;
}

oa_core_worker_alive :: (c: [] OaCore) -> int #export_c #effects(all) {
  return ifx dc_worker_alive(c[0].worker[..]) then 1 else 0;
}

oa_core_worker_write :: (c: [] OaCore, line: string) -> int #export_c #effects(all) {
  return ifx dc_worker_write(c[0].worker[..], c[0].daemon[..], line) then 1 else 0;
}

oa_core_worker_read :: (c: [] OaCore, timeout_ms: int, out: [] u8) -> int #export_c #effects(all) {
  if out.count <= 1 { return -1; }
  n := dc_worker_read(c[0].worker[..], c[0].daemon[..], timeout_ms, out[0..<out.count - 1]);
  if n >= 0 { out[n] = 0; }
  return n;
}

oa_core_worker_stop :: (c: [] OaCore, forget: int) #export_c #effects(all) {
  dc_worker_stop(c[0].worker[..], c[0].daemon[..], forget != 0);
}

oa_core_subagent_start :: (c: [] OaCore, slot: int, program: string, folder: string, extra_env: string, err_out: [] u8) -> int #export_c #effects(all) {
  if slot < 0 || slot >= OA_MAX_SUBAGENTS { return 0; }
  hb: [DC_PATH] u8; home := dcos_home(hb[..]);
  pb: [DC_PATH] u8; had_path := dcos_getenv("PATH", pb[..]);
  kb: [4096] u8; key := dc_claude_key(kb[..]);
  e: [1] DcEnv;
  dc_worker_env(e[..], program, folder, extra_env, home, had_path, key);
  ok := dc_worker_start(c[0].subagents[slot..<slot + 1], c[0].daemon[..], program, folder, e[..]);
  if !ok {
    _ := oa_copy_out(dc_worker_failure(c[0].subagents[slot..<slot + 1]), err_out);
    return 0;
  }
  return 1;
}

oa_core_subagent_alive :: (c: [] OaCore, slot: int) -> int #export_c #effects(all) {
  if slot < 0 || slot >= OA_MAX_SUBAGENTS { return 0; }
  return ifx dc_worker_alive(c[0].subagents[slot..<slot + 1]) then 1 else 0;
}

oa_core_subagent_write :: (c: [] OaCore, slot: int, line: string) -> int #export_c #effects(all) {
  if slot < 0 || slot >= OA_MAX_SUBAGENTS { return 0; }
  return ifx dc_worker_write(c[0].subagents[slot..<slot + 1], c[0].daemon[..], line) then 1 else 0;
}

oa_core_subagent_read :: (c: [] OaCore, slot: int, timeout_ms: int, out: [] u8) -> int #export_c #effects(all) {
  if slot < 0 || slot >= OA_MAX_SUBAGENTS || out.count <= 1 { return -1; }
  n := dc_worker_read(c[0].subagents[slot..<slot + 1], c[0].daemon[..], timeout_ms, out[0..<out.count - 1]);
  if n >= 0 { out[n] = 0; }
  return n;
}

oa_core_subagent_stop :: (c: [] OaCore, slot: int, forget: int) #export_c #effects(all) {
  if slot < 0 || slot >= OA_MAX_SUBAGENTS { return; }
  dc_worker_stop(c[0].subagents[slot..<slot + 1], c[0].daemon[..], forget != 0);
}

oa_core_update_verify :: (envelope: string, current: string, current_build: int, allow_file: int, version_out: [] u8, url_out: [] u8, notes_out: [] u8, err_out: [] u8) -> int #export_c #effects(all) {
  keys: [1] DcKey;
  _ := dc_update_default_keys(keys[..]);
  m: [1] DcManifest;
  code := dc_update_verify(envelope, keys[..], current, current_build, allow_file != 0, m[..]);
  if code == DC_UPD_OK {
    _ := oa_copy_out(dc_manifest_version(m[..]), version_out);
    _ := oa_copy_out(dc_manifest_url(m[..]), url_out);
    _ := oa_copy_out(dc_manifest_notes(m[..]), notes_out);
    return 1;
  }
  if code == DC_UPD_NOT_NEWER { return 0; }
  _ := oa_copy_out(dc_update_words(code), err_out);
  return -1;
}

oa_core_update_verify_with_key :: (envelope: string, key_id: string, key_material: string, current: string, current_build: int, allow_file: int, version_out: [] u8, url_out: [] u8, notes_out: [] u8, err_out: [] u8) -> int #export_c #effects(all) {
  keys: [1] DcKey;
  dc_key(keys[0..<1], key_id, key_material);
  m: [1] DcManifest;
  code := dc_update_verify(envelope, keys[..], current, current_build, allow_file != 0, m[..]);
  if code == DC_UPD_OK {
    _ := oa_copy_out(dc_manifest_version(m[..]), version_out);
    _ := oa_copy_out(dc_manifest_url(m[..]), url_out);
    _ := oa_copy_out(dc_manifest_notes(m[..]), notes_out);
    return 1;
  }
  if code == DC_UPD_NOT_NEWER { return 0; }
  _ := oa_copy_out(dc_update_words(code), err_out);
  return -1;
}

oa_core_update_url :: (out: [] u8) -> int #export_c #effects(all) {
  return oa_copy_out(DC_UPDATE_URL, out);
}

oa_core_update_verify_full :: (envelope: string, current: string, current_build: int, allow_file: int, version_out: [] u8, url_out: [] u8, sha_out: [] u8, size_out: [] int, notes_out: [] u8, err_out: [] u8) -> int #export_c #effects(all) {
  keys: [1] DcKey;
  _ := dc_update_default_keys(keys[..]);
  m: [1] DcManifest;
  code := dc_update_verify(envelope, keys[..], current, current_build, allow_file != 0, m[..]);
  if code == DC_UPD_OK {
    _ := oa_copy_out(dc_manifest_version(m[..]), version_out);
    _ := oa_copy_out(dc_manifest_url(m[..]), url_out);
    _ := oa_copy_out(dc_manifest_sha(m[..]), sha_out);
    if size_out.count > 0 { size_out[0] = m[0].size; }
    _ := oa_copy_out(dc_manifest_notes(m[..]), notes_out);
    return 1;
  }
  if code == DC_UPD_NOT_NEWER { return 0; }
  _ := oa_copy_out(dc_update_words(code), err_out);
  return -1;
}

oa_core_update_verify_archive :: (path: string, expected_sha: string, expected_size: int, err_out: [] u8) -> int #export_c #effects(all) {
  if expected_sha.count != 64 || expected_size <= 0 {
    _ := oa_copy_out(dc_update_words(DC_UPD_SHA), err_out);
    return 0;
  }
  m: [1] DcManifest;
  m[0].size = expected_size;
  for i: 0..<64 { m[0].sha[i] = expected_sha[i]; }
  code := dc_update_archive(path, m[..]);
  if code == DC_UPD_OK { return 1; }
  _ := oa_copy_out(dc_update_words(code), err_out);
  return 0;
}

// Resolve desktop feature flags from settings, OA_FLAGS / OA_EXPERIMENTAL, and CLI argv lines.
oa_core_flags_resolve :: (args_nl: string) -> int #export_c #effects(all) {
  sb: [64] u8;
  exp_s := dcos_setting("experimentalFeatures", sb[..]);
  exp_on := exp_s == "1" || exp_s == "true" || exp_s == "YES";
  def_mask := 0;
  for i: 0..<DC_FLAG_COUNT {
    kb: [64] u8; kn := dc_copy(kb[..], "flag."); kn = dc_cat(kb[..], kn, dc_flag_name(i));
    vb: [32] u8; v := dcos_setting(cast(string) kb[0..<kn], vb[..]);
    if v == "1" || v == "true" || v == "YES" { def_mask = dc_flag_set(def_mask, i, true); }
  }
  eb: [512] u8; env_flags := dcos_getenv("OA_FLAGS", eb[..]);
  xb: [32] u8; env_exp := dcos_getenv("OA_EXPERIMENTAL", xb[..]);
  return dc_flags_resolve(exp_on, def_mask, env_flags, env_exp, args_nl);
}

oa_core_flags_all :: () -> int #export_c #effects(all) { return DC_FLAGS_ALL; }
oa_core_flag_on :: (mask: int, flag: int) -> int #export_c #effects(all) { return ifx dc_flag_on(mask, flag) then 1 else 0; }
oa_core_flags_any_extra_model :: (mask: int) -> int #export_c #effects(all) { return ifx dc_flags_any_extra_model(mask) then 1 else 0; }
