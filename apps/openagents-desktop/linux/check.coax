// The Linux app's checks (docs/apps/2026-11-10-apps-roadmap.md Step 1, GitHub #13153): run
// build/linux/OpenAgents offscreen for each case, compare what it prints with what the case
// expects, then its element table (--tree) row by row with goldens/linux/NAME.tree, then its
// picture with goldens/linux/NAME.png. Nothing reaches Claude
// Code, Codex or Psionic: a case is the demo conversation, an empty home with no claude on
// PATH, or the stand-in Claude Code and Codex the Mac's checks use (zeron/fixtures/),
// started through python3 or bash from PATH, since NixOS has neither /usr/bin/python3 nor /bin/bash.
//   apps/openagents-desktop/linux/build.sh                              first
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax           from the repo root
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax --update  rewrite the goldens (look at them before committing)
// The steps are coax drive operations (apps/shared/host/drive.c, linux/chat.h oa_chat_drive), run by
// --do on the agent clock: `clock settle` waits for an engine's answer, never a fixed real-time sleep.
//
// The dictation cases never open the microphone and play no sound. Most use the app's
// --dictation-fixture, which takes a recorded clip's samples (psionic/fixtures/parakeet/) on its
// own clock. The two dictation-recorder cases run in real time: the app starts a stand-in
// (tests/recorder-stand-in.coax) in pw-record's place, which writes the same clip as a recorder
// would, and the key is held while it plays. A case's recognizer is the app's stand-in, which
// answers with the clip's words, so it runs on any machine, or the pinned Parakeet model on the
// GPU: those two cases are skipped, and say so, where the shared model home (`openagents models
// ls`) has no model.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/json/json.coax";
#load "../../../coax/lib/sys/openagents-paths.coax";

LC_APP :: "apps/openagents-desktop/build/linux/OpenAgents";
LC_GOLDENS :: "apps/openagents-desktop/goldens/linux/";
LC_WORK :: "apps/openagents-desktop/build/linux/check";
LC_FIXTURES :: "apps/openagents-desktop/zeron/fixtures/";
// At most this many pixels in a thousand may differ from the golden.
LC_PIXELS :: 2;

// The dictation cases' clip, 3.2 s of LibriSpeech (psionic/fixtures/parakeet/clips.txt), and its words.
LC_CLIP :: "psionic/fixtures/parakeet/6930-75918-0011.pcm";
LC_WORDS :: "I am convinced of what I say, said the Count.";
LC_STAND_IN :: 1; LC_PARAKEET :: 2; LC_RECORDER :: 3; LC_RECORDER_PARAKEET :: 4;
// The stand-in recorder: 2.5 s of silence, then the clip. A case presses the key a second in and holds it past the clip's end.
LC_RECORDER_TOOL :: "apps/openagents-desktop/tests/recorder-stand-in.coax";
LC_LEAD :: "2500";
LC_HOLD :: "newchat ; type - Please inspect ; dictation on ; clock settle within 60000 ; clock +1000 ; dictation down ; clock +5500 ; dictation up ; clock settle within 15000 ; state draft ; state dictation";

// A case's engine: "demo" (the demo conversation), "" (an empty home with no Claude Code on PATH), or a
// folder of zeron/fixtures/ whose stand-in claude and codex are on PATH. In its steps `@H` is the case's
// home, `@P` the dictation clip and `@Q` half a second of silence. dictation: 0 none, LC_STAND_IN the
// fixture with the stand-in recognizer, LC_PARAKEET the fixture with the pinned model, LC_RECORDER the
// stand-in recorder with the stand-in recognizer, LC_RECORDER_PARAKEET the stand-in recorder with the model.
LcCase :: struct { name: string; size: string; engine: string; steps: string; expect: string; picture: bool; settings: bool; dictation: int; skin: string; }
LC_CASES :: [24] LcCase.[
  LcCase.{name = "chat-1320x880", size = "1320,880", engine = "demo", steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-900x600", size = "900,600", engine = "demo", steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-table", size = "1320,880", engine = "demo", steps = "fixture table", expect = "", picture = true, settings = false},
  LcCase.{name = "sidebar-closed", size = "1320,880", engine = "demo", steps = "fixture open ; sidebar", expect = "", picture = true, settings = false},
  // the chat set in the everglade skin (components/spec.md Phase 4): the same demo, every component in Everglade's roles
  LcCase.{name = "chat-everglade", size = "1320,880", engine = "demo", steps = "fixture open", expect = "", picture = true, settings = false, skin = "everglade"},
  LcCase.{name = "claude-missing", size = "1320,880", engine = "", steps = "clock settle ; type - Hello from Coax", expect = "", picture = true, settings = false},
  LcCase.{name = "attach", size = "1320,880", engine = "", steps = "clock settle ; attach @H/work/notes.txt ; attach @H/work/missing.bin ; type - see the file", expect = "", picture = true, settings = false},
  LcCase.{name = "turn", size = "1320,880", engine = "stream", steps = "clock settle ; send What is two plus two? ; clock settle within 10000 ; state last", expect = "last: Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = false},
  LcCase.{name = "approval-allow", size = "1320,880", engine = "asks", steps = "clock settle ; access supervised ; send list the files ; clock settle ; answer allow ; clock settle within 10000 ; state last", expect = "last: Allowed: ls found a.txt and b.txt.", picture = false, settings = false},
  LcCase.{name = "approval-deny", size = "1320,880", engine = "asks", steps = "clock settle ; access supervised ; send list the files ; clock settle ; answer deny ; clock settle within 10000 ; state last", expect = "last: Refused: The user denied this.", picture = false, settings = false},
  LcCase.{name = "room-ask", size = "1320,880", engine = "room", steps = "clock settle ; folder @H/work/zeron ; mode codex ; clock settle ; key cmd+1 ; send Ask Codex to review the diff ; clock settle within 15000 ; clock settle ; state last", expect = "last: Codex reviewed it: Review: the diff renames a to b; it reads well. (80 chars read)", picture = false, settings = false},
  LcCase.{name = "room-codex-asks", size = "1320,880", engine = "room", steps = "clock settle ; folder @H/work/zeron ; mode codex ; clock settle ; send Ask Claude whether the build is green ; clock settle within 20000 ; clock settle ; state last", expect = "last: Claude says: The build is green. (tools: agents_list, ask_agent, tell_agent, room_read)", picture = false, settings = false},
  LcCase.{name = "store-quit", size = "1320,880", engine = "stream", steps = "clock settle ; send What is two plus two? ; clock settle within 10000 ; state desk", expect = "desk: active=0 tabs=0 sessions=1 collapsed=0", picture = false, settings = true},
  LcCase.{name = "store-reopen", size = "1320,880", engine = "stream", steps = "clock settle ; send One more? ; clock settle within 10000 ; state last", expect = "last: Continuing session 5e55a0e1-0000-4000-8000-000000000001. Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = true},
  LcCase.{name = "dictation-listening", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation on ; clock settle within 10000 ; dictation down ; dictation feed @P", expect = "", picture = true, settings = false, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-key", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation on ; clock settle within 10000 ; dictation down ; dictation feed @P ; dictation up ; clock settle within 15000 ; state draft ; key cmd+z ; state draft", expect = "draft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0\ndraft: Please inspect\ndraft-state: sent=0 parts=0", picture = false, settings = false, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-mouse", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation on ; clock settle within 10000 ; dictation mousedown ; dictation feed @P ; dictation mouseup ; clock settle within 15000 ; state draft ; state dictation", expect = "draft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0\ndictation: phase=1 outcome=5 samples=0", picture = false, settings = false, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-tap", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation on ; clock settle within 10000 ; dictation down ; dictation up ; clock settle within 5000 ; state draft ; state dictation", expect = "draft: Please inspect\ndraft-state: sent=0 parts=0\ndictation: phase=1 outcome=1 samples=0", picture = false, settings = false, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-off", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation down ; dictation feed @P ; dictation up ; state draft ; state dictation", expect = "draft: Please inspect\ndraft-state: sent=0 parts=0\ndictation: phase=0 outcome=0 samples=0\ndictation-setting: enabled=0", picture = false, settings = false, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-saved", size = "1320,880", engine = "stream", steps = "state dictation ; dictation on ; clock settle within 10000 ; state dictation", expect = "dictation-setting: enabled=0\ndictation: phase=1 outcome=0 samples=0\ndictation-setting: enabled=1", picture = false, settings = true, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-restored", size = "1320,880", engine = "stream", steps = "clock settle within 10000 ; state dictation ; type - Please inspect ; dictation down ; dictation feed @P ; dictation up ; clock settle within 15000 ; state draft", expect = "dictation: phase=1 outcome=0 samples=0\ndictation-setting: enabled=1\ndraft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0", picture = false, settings = true, dictation = LC_STAND_IN},
  LcCase.{name = "dictation-parakeet", size = "1320,880", engine = "demo", steps = "newchat ; type - Please inspect ; dictation on ; clock settle within 60000 ; dictation down ; dictation feed @P ; dictation up ; clock settle within 15000 ; state draft ; key cmd+z ; state draft ; dictation feed @Q ; dictation mousedown ; dictation feed @P ; dictation mouseup ; clock settle within 15000 ; state draft", expect = "draft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0\ndraft: Please inspect\ndraft-state: sent=0 parts=0\ndraft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0", picture = false, settings = false, dictation = LC_PARAKEET},
  LcCase.{name = "dictation-recorder", size = "1320,880", engine = "demo", steps = LC_HOLD, expect = "draft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0\ndictation: phase=1 outcome=5 samples=0", picture = false, settings = false, dictation = LC_RECORDER},
  LcCase.{name = "dictation-recorder-parakeet", size = "1320,880", engine = "demo", steps = LC_HOLD, expect = "draft: Please inspect I am convinced of what I say, said the Count.\ndraft-state: sent=0 parts=0\ndictation: phase=1 outcome=5 samples=0", picture = false, settings = false, dictation = LC_RECORDER_PARAKEET}
];

// Steps with `@` and a letter replaced by a path.
lc_swap :: (steps: string, letter: u8, path: string, b: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], b); from := 0;
  for i: 0..<steps.count {
    if i + 1 < steps.count && steps[i] == '@' && steps[i + 1] == letter && i >= from { jo_put(o[..], steps[from..<i]); jo_put(o[..], path); from = i + 2; }
  }
  jo_put(o[..], steps[from..<steps.count]);
  return jo_text(o[..]);
}
// A case's steps with `@H` replaced by the home's path.
lc_steps :: (steps: string, home: string, b: [] u8) -> string { return lc_swap(steps, 'H', home, b); }
#test "a case's clip and its silence are put into its steps, and what it expects is said on one line" {
  b: [256] u8; c: [256] u8;
  #assert lc_swap(lc_swap("dictation feed @P ; dictation feed @Q ; draft", 'P', "/r/clip.pcm", b[..]), 'Q', "/w/quiet.pcm", c[..]) == "dictation feed /r/clip.pcm ; dictation feed /w/quiet.pcm ; draft";
  #assert lc_swap("feed @P", 'Q', "/x", b[..]) == "feed @P" && lc_swap("@P@P", 'P', "/x", b[..]) == "/x/x";
  #assert lc_flat("draft: a\ndraft-state: sent=0 parts=0\n", b[..]) == "draft: a | draft-state: sent=0 parts=0" && lc_flat("last: ok", b[..]) == "last: ok" && lc_flat("", b[..]) == "";
}
// What a case expects, on one line: its line ends become " | ".
lc_flat :: (expect: string, b: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], b);
  for i: 0..<expect.count {
    if expect[i] != 10 { jo_put(o[..], expect[i..<i + 1]); }
    else if i + 1 < expect.count { jo_put(o[..], " | "); }
  }
  return jo_text(o[..]);
}
#test "a case's home is put into its steps" {
  b: [256] u8;
  #assert lc_steps("wait 1 ; folder @H/work ; last", "/tmp/h", b[..]) == "wait 1 ; folder /tmp/h/work ; last";
  #assert lc_steps("fixture open", "/tmp/h", b[..]) == "fixture open" && lc_steps("@H", "/x", b[..]) == "/x";
}

lc_has :: (text: string, part: string) -> bool {
  if part.count == 0 { return true; }
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 {
    same := true;
    for k: 0..<part.count { if text[i + k] != part[k] { same = false; break; } }
    if same { return true; }
  }
  return false;
}
// The pixels in a thousand that differ, from `shot --compare`'s line ("W x H: N of 1000 pixels differ ..."); -1 when it says anything else.
lc_differ :: (line: string) -> int {
  for i: 0..<line.count {
    if line[i] != ':' { continue; }
    k := i + 1; n := 0; any := false;
    while k < line.count && line[k] == ' ' { k += 1; }
    while k < line.count && line[k] >= '0' && line[k] <= '9' { n = n * 10 + (cast(int) line[k] - 48); k += 1; any = true; }
    return ifx any && lc_has(line[k..<line.count], " of 1000 pixels differ") then n else -1;
  }
  return -1;
}
#test "the comparison's line is read, and anything else is not a pass" {
  #assert lc_differ("1320 x 880: 0 of 1000 pixels differ by more than 48 in a channel; mean difference 0 hundredths of 255") == 0;
  #assert lc_differ("900 x 600: 17 of 1000 pixels differ by more than 48 in a channel; mean difference 3 hundredths of 255") == 17;
  #assert lc_differ("different sizes: 1320 x 880 and 900 x 600") == -1 && lc_differ("") == -1 && lc_differ("x: of 1000 pixels differ") == -1;
  #assert lc_has("last: ok", "ok") && lc_has("abc", "") && !lc_has("ab", "abc") && !lc_has("last: no", "ok");
}

// text with every `from` as `to` (a case's home as ~, so a tree reads the same on every machine).
lc_replace :: (text: string, from: string, to: string, b: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], b); i := 0; last := 0;
  while from.count > 0 && i + from.count <= text.count {
    if text[i..<i + from.count] == from { jo_put(o[..], text[last..<i]); jo_put(o[..], to); i += from.count; last = i; } else { i += 1; }
  }
  jo_put(o[..], text[last..<text.count]);
  return jo_text(o[..]);
}
// The first row where two trees differ (a check's text comparison, row by row), or "" when they are the same.
lc_tree_diff :: (want: string, got: string, b: [] u8) -> string {
  i := 0; j := 0; row := 1;
  while i < want.count || j < got.count {
    i0 := i; j0 := j;
    while i < want.count && want[i] != 10 { i += 1; }
    while j < got.count && got[j] != 10 { j += 1; }
    if want[i0..<i] != got[j0..<j] {
      o: [1] Jo; jo_start(o[..], b);
      jo_put(o[..], "row "); jo_int(o[..], row); jo_put(o[..], ": want \""); jo_put(o[..], want[i0..<i]); jo_put(o[..], "\", got \""); jo_put(o[..], got[j0..<j]); jo_put(o[..], "\"");
      return jo_text(o[..]);
    }
    if i < want.count { i += 1; } if j < got.count { j += 1; }
    row += 1;
  }
  return "";
}
#test "a home in a tree reads as ~" {
  b: [256] u8;
  #assert lc_replace("x /h/a/b /h/a", "/h/a", "~", b[..]) == "x ~/b ~" && lc_replace("none", "/h", "~", b[..]) == "none";
}
#test "two trees are compared row by row" {
  b: [256] u8;
  #assert lc_tree_diff("a x\nb y\n", "a x\nb y\n", b[..]) == "";
  #assert lc_tree_diff("a x\nb y\n", "a x\nb z\n", b[..]) == "row 2: want \"b y\", got \"b z\"";
  #assert lc_tree_diff("a x\n", "a x\nc\n", b[..]) == "row 2: want \"\", got \"c\"";
}
lc_path :: (b: [] u8, a: string, c: string) -> string { o: [1] Jo; jo_start(o[..], b); jo_put(o[..], a); jo_put(o[..], c); return jo_text(o[..]); }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  update := args_has(a[..], "--update");
  if !fs_exists(LC_APP) { tool_errln("check: no build/linux/OpenAgents: run apps/openagents-desktop/linux/build.sh first, from the repo root"); return 2; }
  cwd_b: [4096] u8; root := fs_cwd(cwd_b[..]);
  pb: [24] [8192] u8; out: [65536] u8; err: [65536] u8; env_b: [16384] u8;
  work := lc_path(pb[0][..], root, lc_path(pb[1][..], "/", LC_WORK));
  rm := [3] string.["rm", "-rf", work];
  r := proc_run(rm[..], 20000, out[..], err[..]);
  home := lc_path(pb[2][..], work, "/home"); bin := lc_path(pb[3][..], work, "/bin");
  mk := [5] string.["mkdir", "-p", lc_path(pb[4][..], home, "/work"), bin, lc_path(pb[5][..], root, lc_path(pb[6][..], "/", LC_GOLDENS))];
  r = proc_run(mk[..], 20000, out[..], err[..]);
  // the stand-ins, each started by python3 wherever the session has it: bin/FIXTURE/claude and codex
  for fixture: [3] string.["stream", "asks", "room"] {
    dir := lc_path(pb[7][..], bin, lc_path(pb[8][..], "/", fixture));
    md := [3] string.["mkdir", "-p", dir];
    r = proc_run(md[..], 20000, out[..], err[..]);
    for tool: [2] string.["claude", "codex"] {
      from := lc_path(pb[9][..], root, lc_path(pb[10][..], "/", lc_path(pb[11][..], LC_FIXTURES, lc_path(pb[12][..], fixture, lc_path(pb[13][..], "/", tool)))));
      if !fs_exists(from) { continue; }
      script: [8192] u8; so: [1] Jo; jo_start(so[..], script[..]);
      // by the interpreter its first line names, found on PATH: the fixtures name /usr/bin/python3 and /bin/bash
      head: [64] u8; hn := fs_read_at(from, 0, head[..]);
      python := hn > 0 && lc_has(cast(string) head[0..<hn], "python");
      jo_put(so[..], "#!/bin/sh\nexec "); jo_put(so[..], ifx python then "python3 " else "bash "); jo_put(so[..], from); jo_put(so[..], " \"$@\"\n");
      to := lc_path(pb[14][..], dir, lc_path(pb[15][..], "/", tool));
      if !fs_write(to, jo_text(so[..])) { tool_errln("check: could not write a stand-in"); return 2; }
      ch := [3] string.["chmod", "755", to];
      r = proc_run(ch[..], 20000, out[..], err[..]);
    }
  }
  // Codex's login on disk, for the stand-in codex; and the folders the room cases open
  mk2 := [4] string.["mkdir", "-p", lc_path(pb[7][..], home, "/.codex"), lc_path(pb[8][..], home, "/work/zeron")];
  r = proc_run(mk2[..], 20000, out[..], err[..]);
  if !fs_write(lc_path(pb[7][..], home, "/.codex/auth.json"), "{}\n") { return 2; }
  if !fs_write(lc_path(pb[7][..], home, "/work/notes.txt"), "alpha\nbeta\n") { return 2; }   // the attach case's file
  path := proc_getenv("PATH", env_b[..]);
  // dictation: the recorded clip, half a second of silence (16 kHz, 16 bits), and the pinned model where the shared
  // model home has it (OPENAGENTS_PARAKEET_MODEL, else OPENAGENTS_MODEL_CACHE or ~/.openagents/models)
  db: [6] [4096] u8; zeros: [16000] u8;
  clip := lc_path(db[0][..], root, lc_path(db[1][..], "/", LC_CLIP));
  quiet := lc_path(db[2][..], work, "/quiet.pcm");
  if !fs_exists(clip) || !fs_write(quiet, cast(string) zeros[..]) { tool_errln("check: no dictation clip, or its silence could not be written"); return 2; }
  real_home := proc_getenv("HOME", db[3][..]);
  model := proc_getenv("OPENAGENTS_PARAKEET_MODEL", db[4][..]);
  if model == "" { cache_b: [4096] u8; model = oa_models_path(real_home, proc_getenv("OPENAGENTS_MODEL_CACHE", cache_b[..]), OA_PARAKEET_FOLDER, db[4][..]); }
  mw: [2] [4200] u8;
  have_model := model != "" && fs_kind(fs_join(model, "model.safetensors", mw[0][..])) == FS_FILE && fs_kind(fs_join(model, "tokenizer.json", mw[1][..])) == FS_FILE;
  // NVRTC, as the engine looks for it (psionic/platform/cuda-host.c): CUDA_HOME, else cuda-13.2 in the real home
  cuda_b: [2] [4200] u8; cuda := proc_getenv("CUDA_HOME", cuda_b[0][..]);
  if cuda == "" { cuda = lc_path(cuda_b[0][..], real_home, "/cuda-13.2"); }
  // the stand-in recorder: built now, so the app is not kept waiting for its first audio, and started by a script
  // of its own with this check's PATH
  rb: [6] [8192] u8; rs: [32768] u8;
  tool := lc_path(rb[0][..], root, "/coax/web/tool.sh");
  recorder_tool := lc_path(rb[1][..], root, lc_path(rb[2][..], "/", LC_RECORDER_TOOL));
  warm := [2] string.[tool, recorder_tool];
  r = proc_run(warm[..], 300000, out[..], err[..]);   // with no arguments it says how it is used
  recorder := lc_path(rb[3][..], bin, "/recorder");
  ro: [1] Jo; jo_start(ro[..], rs[..]);
  jo_put(ro[..], "#!/bin/sh\nPATH='"); jo_put(ro[..], path); jo_put(ro[..], "' exec "); jo_put(ro[..], tool); jo_put(ro[..], " "); jo_put(ro[..], recorder_tool);
  jo_put(ro[..], " "); jo_put(ro[..], clip); jo_put(ro[..], " "); jo_put(ro[..], LC_LEAD); jo_put(ro[..], " \"$@\"\n");
  if !fs_write(recorder, jo_text(ro[..])) { tool_errln("check: could not write the stand-in recorder"); return 2; }
  rc := [3] string.["chmod", "755", recorder];
  r = proc_run(rc[..], 20000, out[..], err[..]);
  failed := 0;
  cases := LC_CASES;
  for c: cases {
    shot := lc_path(pb[8][..], work, lc_path(pb[9][..], "/", lc_path(pb[10][..], c.name, ".png")));
    // an engine is the PATH the app starts with, in an empty home
    eb: [3] [16384] u8;
    env_home := lc_path(eb[0][..], "HOME=", home);
    standin := c.engine != "demo" && c.engine != "";
    env_path := ifx standin then lc_path(eb[1][..], "PATH=", lc_path(eb[2][..], bin, lc_path(pb[11][..], "/", lc_path(pb[7][..], c.engine, lc_path(pb[5][..], ":", path))))) else lc_path(eb[1][..], "PATH=", "/run/current-system/sw/bin:/usr/bin:/bin");
    parakeet := c.dictation == LC_PARAKEET || c.dictation == LC_RECORDER_PARAKEET;
    live := c.dictation == LC_RECORDER || c.dictation == LC_RECORDER_PARAKEET;
    if parakeet && !have_model { print("skip %: no Parakeet model in % (see `openagents models ls`)\n", c.name, model); continue; }
    argv: [32] string; n := 0; xb: [2] [8192] u8;
    for s: [5] string.["env", env_home, env_path, "BROWSER=true", "PSIONIC_HOST=none"] { argv[n] = s; n += 1; }
    if parakeet { argv[n] = lc_path(xb[0][..], "OPENAGENTS_PARAKEET_MODEL=", model); argv[n + 1] = lc_path(xb[1][..], "CUDA_HOME=", cuda); n += 2; }
    argv[n] = lc_path(pb[12][..], root, lc_path(pb[13][..], "/", LC_APP)); n += 1;
    for s: [8] string.["--shot", shot, "--size", c.size, "--dpr", "1", "--cwd", lc_path(pb[4][..], home, "/work")] { argv[n] = s; n += 1; }
    if c.engine == "demo" { argv[n] = "--demo"; n += 1; }
    if c.skin.count > 0 { argv[n] = "--skin"; argv[n + 1] = c.skin; n += 2; }
    // the dictation cases keep their setting in a file of their own
    if c.settings { argv[n] = "--settings"; argv[n + 1] = lc_path(pb[14][..], work, ifx c.dictation != 0 then "/dictation/settings.json" else "/store/settings.json"); n += 2; }
    if live { argv[n] = "--dictation-recorder"; argv[n + 1] = recorder; argv[n + 2] = "--real-time"; n += 3; }   // the recorder runs on the wall clock
    else if c.dictation != 0 { argv[n] = "--dictation-fixture"; n += 1; }
    if c.dictation != 0 && !parakeet { argv[n] = "--dictation-stand-in"; argv[n + 1] = LC_WORDS; n += 2; }
    tree := lc_path(pb[16][..], work, lc_path(pb[17][..], "/", lc_path(pb[18][..], c.name, ".tree")));
    argv[n] = "--tree"; argv[n + 1] = tree; n += 2;
    sb: [3] [8192] u8;
    argv[n] = "--do"; argv[n + 1] = lc_swap(lc_swap(lc_steps(c.steps, home, sb[0][..]), 'P', clip, sb[1][..]), 'Q', quiet, sb[2][..]); n += 2;
    r = proc_run(argv[0..<n], 120000, out[..], err[..]);
    said := cast(string) out[0..<r.out_n];
    if r.started != 0 || r.status != 0 || r.timed_out { print("FAIL %: the app ended with status %: %\n", c.name, r.status, cast(string) err[0..<r.err_n]); failed += 1; continue; }
    fb: [4096] u8;
    if !lc_has(said, c.expect) { print("FAIL %: no \"%\" in: %\n", c.name, lc_flat(c.expect, fb[..]), said); failed += 1; continue; }
    if !c.picture { print("ok   %: %\n", c.name, lc_flat(c.expect, fb[..])); continue; }
    golden := lc_path(pb[15][..], root, lc_path(pb[9][..], "/", lc_path(pb[10][..], LC_GOLDENS, lc_path(pb[11][..], c.name, ".png"))));
    golden_tree := lc_path(pb[19][..], root, lc_path(pb[20][..], "/", lc_path(pb[21][..], LC_GOLDENS, lc_path(pb[22][..], c.name, ".tree"))));
    if update {
      cp := [3] string.["cp", shot, golden];
      r = proc_run(cp[..], 20000, out[..], err[..]);
      ut: [65536] u8; un: [65536] u8; k := fs_read(tree, ut[..]);
      if k < 0 || !fs_write(golden_tree, lc_replace(cast(string) ut[0..<k], home, "~", un[..])) { print("FAIL %: could not write %\n", c.name, golden_tree); failed += 1; continue; }
      print("updated % and its .tree\n", golden); continue;
    }
    // the text first, row by row (the element table: every row's id, role, label and box), then the picture
    tw: [65536] u8; tg: [65536] u8; dfb: [1024] u8;
    wn := fs_read(golden_tree, tw[..]); gn := fs_read(tree, tg[..]);
    tn: [65536] u8;
    if gn < 0 { print("FAIL %: the app wrote no tree at %\n", c.name, tree); failed += 1; continue; }
    // a case's first run on a Vulkan host records its tree (look at it before committing it)
    if wn < 0 {
      if !fs_write(golden_tree, lc_replace(cast(string) tg[0..<gn], home, "~", tn[..])) { print("FAIL %: could not write %\n", c.name, golden_tree); failed += 1; continue; }
      print("new  %: recorded %\n", c.name, golden_tree);
      wn = fs_read(golden_tree, tw[..]);
    }
    differ := lc_tree_diff(cast(string) tw[0..<wn], lc_replace(cast(string) tg[0..<gn], home, "~", tn[..]), dfb[..]);
    if differ.count > 0 { print("FAIL %: its rows differ from %: %\n", c.name, golden_tree, differ); failed += 1; continue; }
    cmp := [5] string.[lc_path(pb[12][..], root, "/coax/web/tool.sh"), "shot", "--compare", shot, golden];
    r = proc_run(cmp[..], 300000, out[..], err[..]);
    line := cast(string) out[0..<r.out_n];
    d := lc_differ(line);
    if r.status != 0 || d < 0 || d > LC_PIXELS { print("FAIL %: % (picture: %)\n", c.name, ifx line.count > 0 then line else cast(string) err[0..<r.err_n], shot); failed += 1; continue; }
    print("ok   %: %\n", c.name, line);
  }
  return ifx failed > 0 then 1 else 0;
}
