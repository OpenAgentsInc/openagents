// The Linux app's checks (docs/apps/2026-11-10-apps-roadmap.md Step 1, GitHub #13153): run
// build/linux/OpenAgents offscreen for each case, compare what it prints with what the case
// expects, and compare its picture with the golden in goldens/linux/. Nothing reaches Claude
// Code, Codex or Psionic: a case is the demo conversation, an empty home with no claude on
// PATH, or the stand-in Claude Code and Codex the Mac's checks use (zeron/fixtures/),
// started through python3 or bash from PATH, since NixOS has neither /usr/bin/python3 nor /bin/bash.
//   apps/openagents-desktop/linux/build.sh                              first
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax           from the repo root
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax --update  rewrite the goldens (look at them before committing)
// The steps are the app's own --do steps. docs/research/exact/04-apps-audit-2026-11-10.md says
// they should become `coax drive` operations; these cases move with them.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/json/json.coax";

LC_APP :: "apps/openagents-desktop/build/linux/OpenAgents";
LC_GOLDENS :: "apps/openagents-desktop/goldens/linux/";
LC_WORK :: "apps/openagents-desktop/build/linux/check";
LC_FIXTURES :: "apps/openagents-desktop/zeron/fixtures/";
// At most this many pixels in a thousand may differ from the golden.
LC_PIXELS :: 2;

// A case's engine: "demo" (the demo conversation), "" (an empty home with no Claude Code on PATH), or a
// folder of zeron/fixtures/ whose stand-in claude and codex are on PATH. `@H` in its steps is the case's home.
LcCase :: struct { name: string; size: string; engine: string; steps: string; expect: string; picture: bool; settings: bool; }
LC_CASES :: [13] LcCase.[
  LcCase.{name = "chat-1320x880", size = "1320,880", engine = "demo", steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-900x600", size = "900,600", engine = "demo", steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-table", size = "1320,880", engine = "demo", steps = "fixture table", expect = "", picture = true, settings = false},
  LcCase.{name = "sidebar-closed", size = "1320,880", engine = "demo", steps = "fixture open ; sidebar", expect = "", picture = true, settings = false},
  LcCase.{name = "claude-missing", size = "1320,880", engine = "", steps = "wait 2 ; type Hello from Coax", expect = "", picture = true, settings = false},
  LcCase.{name = "attach", size = "1320,880", engine = "", steps = "wait 2 ; attach @H/work/notes.txt ; attach @H/work/missing.bin ; type see the file", expect = "", picture = true, settings = false},
  LcCase.{name = "turn", size = "1320,880", engine = "stream", steps = "wait 1 ; send What is two plus two? ; waitidle 10 ; last", expect = "last: Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = false},
  LcCase.{name = "approval-allow", size = "1320,880", engine = "asks", steps = "wait 1 ; access supervised ; send list the files ; wait 3 ; answer allow ; waitidle 10 ; last", expect = "last: Allowed: ls found a.txt and b.txt.", picture = false, settings = false},
  LcCase.{name = "approval-deny", size = "1320,880", engine = "asks", steps = "wait 1 ; access supervised ; send list the files ; wait 3 ; answer deny ; waitidle 10 ; last", expect = "last: Refused: The user denied this.", picture = false, settings = false},
  LcCase.{name = "room-ask", size = "1320,880", engine = "room", steps = "wait 1 ; folder @H/work/zeron ; mode codex ; wait 1 ; keyevent cmd+1 ; send Ask Codex to review the diff ; waitidle 15 ; wait 1 ; last", expect = "last: Codex reviewed it: Review: the diff renames a to b; it reads well. (80 chars read)", picture = false, settings = false},
  LcCase.{name = "room-codex-asks", size = "1320,880", engine = "room", steps = "wait 1 ; folder @H/work/zeron ; mode codex ; wait 1 ; send Ask Claude whether the build is green ; waitidle 20 ; wait 1 ; last", expect = "last: Claude says: The build is green. (tools: agents_list, ask_agent, tell_agent, room_read)", picture = false, settings = false},
  LcCase.{name = "store-quit", size = "1320,880", engine = "stream", steps = "wait 1 ; send What is two plus two? ; waitidle 10 ; desk", expect = "desk: active=0 tabs=0 sessions=1 collapsed=0", picture = false, settings = true},
  LcCase.{name = "store-reopen", size = "1320,880", engine = "stream", steps = "wait 1 ; send One more? ; waitidle 10 ; last", expect = "last: Continuing session 5e55a0e1-0000-4000-8000-000000000001. Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = true}
];

// A case's steps with `@H` replaced by the home's path.
lc_steps :: (steps: string, home: string, b: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], b); from := 0;
  for i: 0..<steps.count {
    if i + 1 < steps.count && steps[i] == '@' && steps[i + 1] == 'H' && i >= from { jo_put(o[..], steps[from..<i]); jo_put(o[..], home); from = i + 2; }
  }
  jo_put(o[..], steps[from..<steps.count]);
  return jo_text(o[..]);
}
#test "a case's home is put into its steps" {
  b: [256] u8;
  #assert lc_steps("wait 1 ; folder @H/work ; last", "/tmp/h", b[..]) == "wait 1 ; folder /tmp/h/work ; last";
  #assert lc_steps("fixture open", "/tmp/h", b[..]) == "fixture open" && lc_steps("@H", "/x", b[..]) == "/x";
}

lc_has :: (text: string, part: string) -> bool {
  if part.count == 0 { return true; }
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 {
    same := true;
    for k: 0..<part.count { if text[i + k] != part[k] { same = false; break; } }
    if same { return true; }
  }
  return false;
}
// The pixels in a thousand that differ, from `shot --compare`'s line ("W x H: N of 1000 pixels differ ..."); -1 when it says anything else.
lc_differ :: (line: string) -> int {
  for i: 0..<line.count {
    if line[i] != ':' { continue; }
    k := i + 1; n := 0; any := false;
    while k < line.count && line[k] == ' ' { k += 1; }
    while k < line.count && line[k] >= '0' && line[k] <= '9' { n = n * 10 + (cast(int) line[k] - 48); k += 1; any = true; }
    return ifx any && lc_has(line[k..<line.count], " of 1000 pixels differ") then n else -1;
  }
  return -1;
}
#test "the comparison's line is read, and anything else is not a pass" {
  #assert lc_differ("1320 x 880: 0 of 1000 pixels differ by more than 48 in a channel; mean difference 0 hundredths of 255") == 0;
  #assert lc_differ("900 x 600: 17 of 1000 pixels differ by more than 48 in a channel; mean difference 3 hundredths of 255") == 17;
  #assert lc_differ("different sizes: 1320 x 880 and 900 x 600") == -1 && lc_differ("") == -1 && lc_differ("x: of 1000 pixels differ") == -1;
  #assert lc_has("last: ok", "ok") && lc_has("abc", "") && !lc_has("ab", "abc") && !lc_has("last: no", "ok");
}

lc_path :: (b: [] u8, a: string, c: string) -> string { o: [1] Jo; jo_start(o[..], b); jo_put(o[..], a); jo_put(o[..], c); return jo_text(o[..]); }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  update := args_has(a[..], "--update");
  if !fs_exists(LC_APP) { tool_errln("check: no build/linux/OpenAgents: run apps/openagents-desktop/linux/build.sh first, from the repo root"); return 2; }
  cwd_b: [4096] u8; root := fs_cwd(cwd_b[..]);
  pb: [16] [8192] u8; out: [65536] u8; err: [65536] u8; env_b: [16384] u8;
  work := lc_path(pb[0][..], root, lc_path(pb[1][..], "/", LC_WORK));
  rm := [3] string.["rm", "-rf", work];
  r := proc_run(rm[..], 20000, out[..], err[..]);
  home := lc_path(pb[2][..], work, "/home"); bin := lc_path(pb[3][..], work, "/bin");
  mk := [5] string.["mkdir", "-p", lc_path(pb[4][..], home, "/work"), bin, lc_path(pb[5][..], root, lc_path(pb[6][..], "/", LC_GOLDENS))];
  r = proc_run(mk[..], 20000, out[..], err[..]);
  // the stand-ins, each started by python3 wherever the session has it: bin/FIXTURE/claude and codex
  for fixture: [3] string.["stream", "asks", "room"] {
    dir := lc_path(pb[7][..], bin, lc_path(pb[8][..], "/", fixture));
    md := [3] string.["mkdir", "-p", dir];
    r = proc_run(md[..], 20000, out[..], err[..]);
    for tool: [2] string.["claude", "codex"] {
      from := lc_path(pb[9][..], root, lc_path(pb[10][..], "/", lc_path(pb[11][..], LC_FIXTURES, lc_path(pb[12][..], fixture, lc_path(pb[13][..], "/", tool)))));
      if !fs_exists(from) { continue; }
      script: [8192] u8; so: [1] Jo; jo_start(so[..], script[..]);
      // by the interpreter its first line names, found on PATH: the fixtures name /usr/bin/python3 and /bin/bash
      head: [64] u8; hn := fs_read_at(from, 0, head[..]);
      python := hn > 0 && lc_has(cast(string) head[0..<hn], "python");
      jo_put(so[..], "#!/bin/sh\nexec "); jo_put(so[..], ifx python then "python3 " else "bash "); jo_put(so[..], from); jo_put(so[..], " \"$@\"\n");
      to := lc_path(pb[14][..], dir, lc_path(pb[15][..], "/", tool));
      if !fs_write(to, jo_text(so[..])) { tool_errln("check: could not write a stand-in"); return 2; }
      ch := [3] string.["chmod", "755", to];
      r = proc_run(ch[..], 20000, out[..], err[..]);
    }
  }
  // Codex's login on disk, for the stand-in codex; and the folders the room cases open
  mk2 := [4] string.["mkdir", "-p", lc_path(pb[7][..], home, "/.codex"), lc_path(pb[8][..], home, "/work/zeron")];
  r = proc_run(mk2[..], 20000, out[..], err[..]);
  if !fs_write(lc_path(pb[7][..], home, "/.codex/auth.json"), "{}\n") { return 2; }
  if !fs_write(lc_path(pb[7][..], home, "/work/notes.txt"), "alpha\nbeta\n") { return 2; }   // the attach case's file
  path := proc_getenv("PATH", env_b[..]);
  failed := 0;
  cases := LC_CASES;
  for c: cases {
    shot := lc_path(pb[8][..], work, lc_path(pb[9][..], "/", lc_path(pb[10][..], c.name, ".png")));
    // an engine is the PATH the app starts with, in an empty home
    eb: [3] [16384] u8;
    env_home := lc_path(eb[0][..], "HOME=", home);
    standin := c.engine != "demo" && c.engine != "";
    env_path := ifx standin then lc_path(eb[1][..], "PATH=", lc_path(eb[2][..], bin, lc_path(pb[11][..], "/", lc_path(pb[7][..], c.engine, lc_path(pb[5][..], ":", path))))) else lc_path(eb[1][..], "PATH=", "/run/current-system/sw/bin:/usr/bin:/bin");
    argv: [24] string; n := 0;
    for s: [5] string.["env", env_home, env_path, "BROWSER=true", "PSIONIC_HOST=none"] { argv[n] = s; n += 1; }
    argv[n] = lc_path(pb[12][..], root, lc_path(pb[13][..], "/", LC_APP)); n += 1;
    for s: [8] string.["--shot", shot, "--size", c.size, "--dpr", "1", "--cwd", lc_path(pb[4][..], home, "/work")] { argv[n] = s; n += 1; }
    if c.engine == "demo" { argv[n] = "--demo"; n += 1; }
    if c.settings { argv[n] = "--settings"; argv[n + 1] = lc_path(pb[14][..], work, "/store/settings.json"); n += 2; }
    sb: [8192] u8;
    argv[n] = "--do"; argv[n + 1] = lc_steps(c.steps, home, sb[..]); n += 2;
    r = proc_run(argv[0..<n], 120000, out[..], err[..]);
    said := cast(string) out[0..<r.out_n];
    if r.started != 0 || r.status != 0 || r.timed_out { print("FAIL %: the app ended with status %: %\n", c.name, r.status, cast(string) err[0..<r.err_n]); failed += 1; continue; }
    if !lc_has(said, c.expect) { print("FAIL %: no \"%\" in: %\n", c.name, c.expect, said); failed += 1; continue; }
    if !c.picture { print("ok   %: %\n", c.name, c.expect); continue; }
    golden := lc_path(pb[15][..], root, lc_path(pb[9][..], "/", lc_path(pb[10][..], LC_GOLDENS, lc_path(pb[11][..], c.name, ".png"))));
    if update {
      cp := [3] string.["cp", shot, golden];
      r = proc_run(cp[..], 20000, out[..], err[..]);
      print("updated %\n", golden); continue;
    }
    cmp := [5] string.[lc_path(pb[12][..], root, "/coax/web/tool.sh"), "shot", "--compare", shot, golden];
    r = proc_run(cmp[..], 300000, out[..], err[..]);
    line := cast(string) out[0..<r.out_n];
    d := lc_differ(line);
    if r.status != 0 || d < 0 || d > LC_PIXELS { print("FAIL %: % (picture: %)\n", c.name, ifx line.count > 0 then line else cast(string) err[0..<r.err_n], shot); failed += 1; continue; }
    print("ok   %: %\n", c.name, line);
  }
  return ifx failed > 0 then 1 else 0;
}
