// The Linux app's checks (docs/apps/2026-11-10-apps-roadmap.md Step 1, GitHub #13153): run
// build/linux/OpenAgents offscreen for each case, compare what it prints with what the case
// expects, and compare its picture with the golden in goldens/linux/. Nothing reaches Claude
// Code, Codex or Psionic: a case is the demo conversation, an empty home with no claude on
// PATH, or the stand-in Claude Code the Mac's checks use (zeron/fixtures/stream/claude),
// started through python3 since NixOS has no /usr/bin/python3.
//   apps/openagents-desktop/linux/build.sh                              first
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax           from the repo root
//   coax/web/tool.sh apps/openagents-desktop/linux/check.coax --update  rewrite the goldens (look at them before committing)
// The steps are the app's own --do steps. docs/research/exact/04-apps-audit-2026-11-10.md says
// they should become `coax drive` operations; these cases move with them.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/json/json.coax";

LC_APP :: "apps/openagents-desktop/build/linux/OpenAgents";
LC_GOLDENS :: "apps/openagents-desktop/goldens/linux/";
LC_WORK :: "apps/openagents-desktop/build/linux/check";
LC_STANDIN :: "apps/openagents-desktop/zeron/fixtures/stream/claude";
// At most this many pixels in a thousand may differ from the golden.
LC_PIXELS :: 2;
// A case's engine: the demo conversation, no Claude Code at all, or the stand-in.
LC_DEMO :: 0; LC_NONE :: 1; LC_STANDIN_ENGINE :: 2;

LcCase :: struct { name: string; size: string; engine: int; steps: string; expect: string; picture: bool; settings: bool; }
LC_CASES :: [8] LcCase.[
  LcCase.{name = "chat-1320x880", size = "1320,880", engine = LC_DEMO, steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-900x600", size = "900,600", engine = LC_DEMO, steps = "fixture open", expect = "", picture = true, settings = false},
  LcCase.{name = "chat-table", size = "1320,880", engine = LC_DEMO, steps = "fixture table", expect = "", picture = true, settings = false},
  LcCase.{name = "sidebar-closed", size = "1320,880", engine = LC_DEMO, steps = "fixture open ; sidebar", expect = "", picture = true, settings = false},
  LcCase.{name = "claude-missing", size = "1320,880", engine = LC_NONE, steps = "wait 2 ; type Hello from Coax", expect = "", picture = true, settings = false},
  LcCase.{name = "turn", size = "1320,880", engine = LC_STANDIN_ENGINE, steps = "wait 1 ; send What is two plus two? ; wait 4 ; last", expect = "last: Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = false},
  LcCase.{name = "store-quit", size = "1320,880", engine = LC_STANDIN_ENGINE, steps = "wait 1 ; send What is two plus two? ; wait 4 ; desk", expect = "desk: active=0 tabs=0 sessions=1 collapsed=0", picture = false, settings = true},
  LcCase.{name = "store-reopen", size = "1320,880", engine = LC_STANDIN_ENGINE, steps = "wait 1 ; send One more? ; wait 4 ; last", expect = "last: Continuing session 5e55a0e1-0000-4000-8000-000000000001. Answered by default: two plus two is four, and the sum stays four however you group it.", picture = false, settings = true}
];

lc_has :: (text: string, part: string) -> bool {
  if part.count == 0 { return true; }
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 {
    same := true;
    for k: 0..<part.count { if text[i + k] != part[k] { same = false; break; } }
    if same { return true; }
  }
  return false;
}
// The pixels in a thousand that differ, from `shot --compare`'s line ("W x H: N of 1000 pixels differ ..."); -1 when it says anything else.
lc_differ :: (line: string) -> int {
  for i: 0..<line.count {
    if line[i] != ':' { continue; }
    k := i + 1; n := 0; any := false;
    while k < line.count && line[k] == ' ' { k += 1; }
    while k < line.count && line[k] >= '0' && line[k] <= '9' { n = n * 10 + (cast(int) line[k] - 48); k += 1; any = true; }
    return ifx any && lc_has(line[k..<line.count], " of 1000 pixels differ") then n else -1;
  }
  return -1;
}
#test "the comparison's line is read, and anything else is not a pass" {
  #assert lc_differ("1320 x 880: 0 of 1000 pixels differ by more than 48 in a channel; mean difference 0 hundredths of 255") == 0;
  #assert lc_differ("900 x 600: 17 of 1000 pixels differ by more than 48 in a channel; mean difference 3 hundredths of 255") == 17;
  #assert lc_differ("different sizes: 1320 x 880 and 900 x 600") == -1 && lc_differ("") == -1 && lc_differ("x: of 1000 pixels differ") == -1;
  #assert lc_has("last: ok", "ok") && lc_has("abc", "") && !lc_has("ab", "abc") && !lc_has("last: no", "ok");
}

lc_path :: (b: [] u8, a: string, c: string) -> string { o: [1] Jo; jo_start(o[..], b); jo_put(o[..], a); jo_put(o[..], c); return jo_text(o[..]); }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  update := args_has(a[..], "--update");
  if !fs_exists(LC_APP) { tool_errln("check: no build/linux/OpenAgents: run apps/openagents-desktop/linux/build.sh first, from the repo root"); return 2; }
  cwd_b: [4096] u8; root := fs_cwd(cwd_b[..]);
  pb: [16] [8192] u8; out: [65536] u8; err: [65536] u8; env_b: [16384] u8;
  work := lc_path(pb[0][..], root, lc_path(pb[1][..], "/", LC_WORK));
  rm := [3] string.["rm", "-rf", work];
  r := proc_run(rm[..], 20000, out[..], err[..]);
  home := lc_path(pb[2][..], work, "/home"); bin := lc_path(pb[3][..], work, "/bin");
  mk := [5] string.["mkdir", "-p", lc_path(pb[4][..], home, "/work"), bin, lc_path(pb[5][..], root, lc_path(pb[6][..], "/", LC_GOLDENS))];
  r = proc_run(mk[..], 20000, out[..], err[..]);
  // the stand-in Claude Code, started by python3 wherever the session has it
  script: [8192] u8; so: [1] Jo; jo_start(so[..], script[..]);
  jo_put(so[..], "#!/bin/sh\nexec python3 "); jo_put(so[..], root); jo_put(so[..], "/"); jo_put(so[..], LC_STANDIN); jo_put(so[..], " \"$@\"\n");
  standin := lc_path(pb[7][..], bin, "/claude");
  if !fs_write(standin, jo_text(so[..])) { tool_errln("check: could not write the stand-in"); return 2; }
  ch := [3] string.["chmod", "755", standin];
  r = proc_run(ch[..], 20000, out[..], err[..]);
  path := proc_getenv("PATH", env_b[..]);
  failed := 0;
  cases := LC_CASES;
  for c: cases {
    shot := lc_path(pb[8][..], work, lc_path(pb[9][..], "/", lc_path(pb[10][..], c.name, ".png")));
    // an engine is the PATH the app starts with, in an empty home
    eb: [3] [16384] u8;
    env_home := lc_path(eb[0][..], "HOME=", home);
    env_path := ifx c.engine == LC_STANDIN_ENGINE then lc_path(eb[1][..], "PATH=", lc_path(eb[2][..], bin, lc_path(pb[11][..], ":", path))) else lc_path(eb[1][..], "PATH=", "/run/current-system/sw/bin:/usr/bin:/bin");
    argv: [24] string; n := 0;
    for s: [5] string.["env", env_home, env_path, "BROWSER=true", "PSIONIC_HOST=none"] { argv[n] = s; n += 1; }
    argv[n] = lc_path(pb[12][..], root, lc_path(pb[13][..], "/", LC_APP)); n += 1;
    for s: [8] string.["--shot", shot, "--size", c.size, "--dpr", "1", "--cwd", lc_path(pb[4][..], home, "/work")] { argv[n] = s; n += 1; }
    if c.engine == LC_DEMO { argv[n] = "--demo"; n += 1; }
    if c.settings { argv[n] = "--settings"; argv[n + 1] = lc_path(pb[14][..], work, "/store/settings.json"); n += 2; }
    argv[n] = "--do"; argv[n + 1] = c.steps; n += 2;
    r = proc_run(argv[0..<n], 120000, out[..], err[..]);
    said := cast(string) out[0..<r.out_n];
    if r.started != 0 || r.status != 0 || r.timed_out { print("FAIL %: the app ended with status %: %\n", c.name, r.status, cast(string) err[0..<r.err_n]); failed += 1; continue; }
    if !lc_has(said, c.expect) { print("FAIL %: no \"%\" in: %\n", c.name, c.expect, said); failed += 1; continue; }
    if !c.picture { print("ok   %: %\n", c.name, c.expect); continue; }
    golden := lc_path(pb[15][..], root, lc_path(pb[9][..], "/", lc_path(pb[10][..], LC_GOLDENS, lc_path(pb[11][..], c.name, ".png"))));
    if update {
      cp := [3] string.["cp", shot, golden];
      r = proc_run(cp[..], 20000, out[..], err[..]);
      print("updated %\n", golden); continue;
    }
    cmp := [5] string.[lc_path(pb[12][..], root, "/coax/web/tool.sh"), "shot", "--compare", shot, golden];
    r = proc_run(cmp[..], 300000, out[..], err[..]);
    line := cast(string) out[0..<r.out_n];
    d := lc_differ(line);
    if r.status != 0 || d < 0 || d > LC_PIXELS { print("FAIL %: % (picture: %)\n", c.name, ifx line.count > 0 then line else cast(string) err[0..<r.err_n], shot); failed += 1; continue; }
    print("ok   %: %\n", c.name, line);
  }
  return ifx failed > 0 then 1 else 0;
}
