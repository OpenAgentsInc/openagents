// The same Coax Native application as iPhone, executed as C on Linux.
// Only this projection knows the component tree's identifiers and semantics.
#load "../../openagents-ios/home/app.coax";
nd_size :: ()->int #export_c #effects(all) {return size_of(Starter);}
nd_frame :: (s:[]Starter)->int #export_c #effects(all) {_ = st_frame(s,0.016,true);return s[0].tree[0].n;}
nd_kind :: (s:[]Starter,i:int)->int #export_c #effects(all) {
  t:=s[0].tree[..];if i<0 || i>=t[0].n {return 0;}n:=t[0].nodes[i];parent:=n.parent;
  while parent>=0 {if t[0].nodes[parent].tag==TG_BUTTON {return 0;}parent=t[0].nodes[parent].parent;}
  if n.tag==TG_BUTTON {return 1;}if n.tag==TG_INPUT {return 2;}if n.tag==TG_TEXTAREA {return 4;}return ifx n.has_text then 3 else 0;
}
nd_id :: (s:[]Starter,i:int)->string #export_c #effects(all) {return tr_id(s[0].tree[..],i);}
nd_text :: (s:[]Starter,i:int,out:[]u8)->int #export_c #effects(all) {
  t:=s[0].tree[..];n:=t[0].nodes[i];at:=0;
  if n.tag==TG_INPUT || n.tag==TG_TEXTAREA {return ea_copy(out,tr_attr_of(t,i,AT_LABEL));}
  if n.has_text {return ea_copy(out,tr_text_of(t,i));}
  for j:i+1..<t[0].n {parent:=t[0].nodes[j].parent;inside:=false;while parent>=0 {if parent==i {inside=true;break;}parent=t[0].nodes[parent].parent;}if !inside {break;}text:=tr_text_of(t,j);if at+text.count>out.count {return -1;}at=mc(out,at,text);}
  return at;
}
nd_value :: (s:[]Starter,i:int)->string #export_c #effects(all) {
  id:=tr_id(s[0].tree[..],i);
  if id=="env.composer" {return cast(string)s[0].environments[0].draft[0..<s[0].environments[0].nd];}
  if id=="chat.composer" {return cast(string)s[0].draft[0..<s[0].draft_n];}
  if id=="login.email" {return cast(string)s[0].email[0..<s[0].email_n];}
  if id=="login.code" {return cast(string)s[0].code[0..<s[0].code_n];}return "";
}
nd_enabled :: (s:[]Starter,i:int)->bool #export_c #effects(all) {return !tr_has(s[0].tree[..],i,AT_DISABLED);}
nd_input :: (s:[]Starter,id:string,text:string,press:bool) #export_c #effects(all) {
  slot:=dm_find(s[0].dom[..],id);if slot<0 || text.count>s[0].inbox.count {return;}
  for c,i:text {s[0].inbox[i]=c;}st_event(s,ifx press then 1 else 2,slot,text.count);
}
nd_action :: (s:[]Starter)->int #export_c #effects(all) {return s[0].action;}
nd_body :: (s:[]Starter)->string #export_c #effects(all) {return cast(string)s[0].outbox[0..<s[0].out_n];}
nd_done :: (s:[]Starter) #export_c #effects(all) {st_done(s);}
nd_reply :: (s:[]Starter,op:int,status:int,raw:string,failed:bool) #export_c #effects(all) {na_reply(s,op,status,raw,failed);}
