#load "page/goal.coax";
#load "page/transcript.coax";
#load "page/chats.coax";
#load "page/sidebar_groups.coax";
#load "page/persist.coax";
#load "page/input.coax";
#load "page/layout/layout.coax";
#load "page/layout/titlebar.coax";
#load "page/layout/sidebar.coax";
#load "page/layout/pane.coax";
#load "page/gitdiff.coax";
#load "page/layout/review.coax";
#load "page/filepane.coax";
#load "page/filetree.coax";
#load "page/layout/conversation.coax";
#load "page/host-api.coax";
#load "page/followups.coax";
#load "page/todos.coax";
#load "page/permit.coax";
#load "page/overlay.coax";
#load "page/palette.coax";
#load "page/attach.coax";
#load "page/shows.coax";
#load "page/mention.coax";
#load "page/gitactions.coax";
#load "page/checkpoint.coax";
#load "page/notify.coax";
#load "page/find.coax";

#test "page-v1: minimal release boots Flawed-default with Inkling selectable, Settings -> Flawed, and valid frames" {
  s: [1] CoderPage;
  st: [1] CpCheckLean;
  cp_store_bind(s[..], st[0].turns[..], st[0].agents[..], st[0].asks[..], st[0].replies[..], st[0].calls[..], st[0].docs[..], st[0].long_buf[..], st[0].agent_buf[..], st[0].arena[..], st[0].scratch[..]);
  s[0].flags = 0;
  s[0].local_os_ok = true;
  s[0].local_hw_ok = true;
  s[0].local_ram_gb = 64;
  s[0].inkling = true;
  cp_init(s[..]);

  // Default: Flawed Agent (5 models: Inkling 2 Mini + 4 Gemini 4 Neon models) + local Inkling (1 model) = 6 selectable models.
  // Because s[0].inkling == true, starts on Flawed · Inkling 2 Mini!
  #assert cp_has_model_picker(s[..]) && cp_models(s[..]) == CP_FLAWED_MODELS + 1;
  #assert coder_page_model_flawed(s[..]) && coder_page_model_flawed_local(s[..]) && coder_page_model_provider(s[..]) == 8;
  mid: [64] u8;
  mn := coder_page_model_id_out(s[..], mid[..]);
  #assert cast(string) mid[0..<mn] == "flawed:inkling-2-mini";
  #assert cp_effort_count(s[..], cp_model_index(s[..])) == 5 && cp_effort_label(s[..], cp_model_index(s[..])) == "High";
  #assert cp_tr(CP_LOCALE_EN, "new_chat") == "New chat";
  #assert cp_tr(CP_LOCALE_EN, "send") == "Send";
  #assert cp_tr(CP_LOCALE_EN, "stop") == "Stop";

  // Switching to Inkling, Gemini 4 Neon, and back to Flawed Inkling works cleanly.
  #assert coder_page_pick_model(s[..], "inkling-2-mini") && !coder_page_model_flawed(s[..]) && coder_page_model_provider(s[..]) == 2;
  #assert coder_page_pick_model(s[..], "flawed:gemini-4-neon") && coder_page_model_flawed(s[..]) && !coder_page_model_flawed_local(s[..]) && coder_page_model_provider(s[..]) == 8;

  // Core v1.0 Settings pages are allowed (General, Flawed, Providers, Models, About & updates).
  #assert cp_set_page_ok_flags(0, CP_PG_GENERAL);
  #assert cp_set_page_ok_flags(0, CP_PG_FLAWED);
  #assert cp_set_page_ok_flags(0, CP_PG_PROVIDERS);
  #assert cp_set_page_ok_flags(0, CP_PG_MODELS);
  #assert cp_set_page_ok_flags(0, CP_PG_ABOUT);
  #assert !cp_set_page_ok_flags(0, CP_PG_WALLET);
  #assert !cp_set_page_ok_flags(0, CP_PG_FOREMAN);
  #assert !cp_set_page_ok_flags(0, CP_PG_ACCOUNT);
  #assert !cp_set_page_ok_flags(0, CP_PG_USAGE);
  #assert !cp_set_page_ok_flags(0, CP_PG_VOICE);
  #assert !cp_set_page_ok_flags(0, CP_PG_SCHED);

  // Enabling Antigravity does NOT expose other models until the user explicitly opts in via show_other_models.
  coder_page_set_agy(s[..], true);
  #assert cp_models(s[..]) == CP_FLAWED_MODELS + 1 && coder_page_model_flawed(s[..]);
  // Once the user opts into seeing other models, Antigravity joins the picker and switches cleanly.
  coder_page_show_other_models_set(s[..], true);
  #assert cp_has_model_picker(s[..]) && cp_models(s[..]) == CP_FLAWED_MODELS + 2;
  #assert coder_page_pick_model(s[..], "antigravity") && coder_page_model_agy(s[..]) && coder_page_model_provider(s[..]) == 1;
  #assert coder_page_pick_model(s[..], "flawed:inkling-2-mini") && coder_page_model_flawed(s[..]) && coder_page_model_flawed_local(s[..]) && coder_page_model_provider(s[..]) == 8;
  coder_page_show_other_models_set(s[..], false);
  #assert cp_models(s[..]) == CP_FLAWED_MODELS + 1 && coder_page_model_provider(s[..]) == 8;
  coder_page_set_agy(s[..], false);
  #assert cp_has_model_picker(s[..]) && coder_page_model_provider(s[..]) == 8;

  // Settings -> Flawed & Settings -> Providers open directly on the slim v1.0 page without any feature flag.
  coder_page_settings_open(s[..], CP_PG_FLAWED, "");
  #assert coder_page_settings_page(s[..]) == CP_PG_FLAWED;
  // Prefs roundtrip & press handling on Settings -> Flawed.
  pv: [CP_FLAWED_PREFS_COUNT] int;
  #assert coder_page_flawed_prefs_get(s[..], pv[..]) == CP_FLAWED_PREFS_COUNT;
  #assert pv[0] == 0 && pv[1] == 0 && pv[4] == 2 && pv[6] == 0 && pv[9] == 0 && pv[11] == 1 && pv[12] == 1 && pv[16] == 1;
  #assert cp_flawed_settings_press(s[..], "set.flawed.pmode.1") && coder_page_action(s[..]) == CP_ASK_FLAWED_PREFS;
  #assert cp_flawed_settings_press(s[..], "set.flawed.ctx1m.1") && coder_page_action(s[..]) == CP_ASK_FLAWED_PREFS;
  #assert coder_page_flawed_prefs_get(s[..], pv[..]) == CP_FLAWED_PREFS_COUNT && pv[6] == 1 && pv[18] == 1;
  coder_page_settings_open(s[..], CP_PG_PROVIDERS, "");
  #assert coder_page_settings_page(s[..]) == CP_PG_PROVIDERS;
  coder_page_settings_open(s[..], -2, "");

  // Sending a message and rendering a frame succeed cleanly on the slim page.
  #assert coder_page_set_text(s[..], "Hello Flawed");
  #assert coder_page_submit(s[..]);
  #assert coder_page_action(s[..]) == CP_ASK_SEND;
  #assert s[0].nturns == 1;
  #assert cp_rich_run_cmd(s[..], CP_CMD_FORK);
  #assert coder_page_action(s[..]) == CP_ASK_FORK;

  // Core right-pane File Viewer works unconditionally in the minimal v1.0 app with flags == 0 (#13992).
  fb: [64] u8; src := "static int main(void) { return 0; }\n";
  #assert coder_page_file_open(s[..], "/Users/me/work/inkling-gguf.c", fb[0..<cp_out(fb[..], src)], src.count);
  #assert coder_page_file_shown(s[..]);
  #assert coder_page_file_mode(s[..]) == CP_FP_READ;
  #assert coder_page_file_set_edit(s[..], true) && coder_page_file_mode(s[..]) == CP_FP_EDIT;
  coder_page_palette_set_mode(s[..], CP_PAL_MODE_FILES);
  #assert coder_page_palette_mode(s[..]) == CP_PAL_MODE_FILES;
}
