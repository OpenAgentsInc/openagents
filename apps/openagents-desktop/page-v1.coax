// Slim v1.0 desktop page root (docs/desktop/openagents-v1-spec.md §4.4, §5.6).
// Loads only the core v1.0 page modules + page/v1-stubs.coax (omitting the 19
// flagged-off panel modules and their 8 library dependencies). Full developer
// builds keep page.coax and all 846+ checks untouched.
//   coax/bin/coax test apps/openagents-desktop/page-v1.coax --library

#load "../../components/app/activity.coax";
#load "../../components/app/nav.coax";
#load "../../components/app/followups.coax";
#load "../../components/app/overlay.coax";
#load "../../components/app/palette.coax";
#load "../../components/app/toast.coax";
#load "../../components/app/cargo.coax";
#load "../../components/app/mention.coax";
#load "../shared/app/view/shell.coax";
#load "../../components/kit/foreman_hud.coax";
#load "../../components/core/edit.coax";
#load "../../components/chat/editor.coax";
#load "../../components/skin/arcade.coax";
#load "../../components/backend/gpu.coax";
#load "../../coax/lib/agent/engine/mcworker-wire.coax";
#load "../../coax/lib/gateway/card.coax";
#load "../../coax/lib/agent/desktop/flags.coax";
#load "settings.coax";

#load "page/state.coax";
#load "page/v1-stubs.coax";
#load "page/editor.coax";
#load "page/compose.coax";
#load "page/skin.coax";
#load "page/models.coax";
#load "page/goal.coax";
#load "page/transcript.coax";
#load "page/chats.coax";
#load "page/sidebar_groups.coax";
#load "page/persist.coax";
#load "page/input.coax";
#load "page/layout/layout.coax";
#load "page/layout/titlebar.coax";
#load "page/layout/sidebar.coax";
#load "page/layout/pane.coax";
#load "page/filepane.coax";
#load "page/filetree.coax";
#load "page/layout/conversation.coax";
#load "page/host-api.coax";
#load "page/followups.coax";
#load "page/todos.coax";
#load "page/permit.coax";
#load "page/overlay.coax";
#load "page/palette.coax";
#load "page/attach.coax";
#load "page/shows.coax";
#load "page/mention.coax";
#load "page/notify.coax";
#load "page/find.coax";

#test "page-v1: minimal release boots Inkling-only with zero extra model selector and valid frames" {
  s: [1] CoderPage;
  st: [1] CpCheckLean;
  cp_store_bind(s[..], st[0].turns[..], st[0].agents[..], st[0].asks[..], st[0].replies[..], st[0].calls[..], st[0].docs[..], st[0].long_buf[..], st[0].agent_buf[..], st[0].arena[..], st[0].scratch[..]);
  s[0].flags = 0;
  s[0].local_os_ok = true;
  s[0].local_hw_ok = true;
  s[0].local_ram_gb = 64;
  s[0].inkling = true;
  cp_init(s[..]);

  // Single model (Inkling 2 Mini), no model picker, all excluded flags off.
  #assert !cp_has_model_picker(s[..]);
  #assert coder_page_model_provider(s[..]) == 2;
  mid: [64] u8;
  mn := coder_page_model_id_out(s[..], mid[..]);
  #assert cast(string) mid[0..<mn] == "inkling-2-mini";
  #assert cp_tr(CP_LOCALE_EN, "new_chat") == "New chat";
  #assert cp_tr(CP_LOCALE_EN, "send") == "Send";
  #assert cp_tr(CP_LOCALE_EN, "stop") == "Stop";

  // Only v1.0 Settings pages are allowed (General, Models, About & updates).
  #assert cp_set_page_ok_flags(0, CP_PG_GENERAL);
  #assert cp_set_page_ok_flags(0, CP_PG_MODELS);
  #assert cp_set_page_ok_flags(0, CP_PG_ABOUT);
  #assert !cp_set_page_ok_flags(0, CP_PG_WALLET);
  #assert !cp_set_page_ok_flags(0, CP_PG_FOREMAN);
  #assert !cp_set_page_ok_flags(0, CP_PG_ACCOUNT);
  #assert !cp_set_page_ok_flags(0, CP_PG_USAGE);
  #assert !cp_set_page_ok_flags(0, CP_PG_VOICE);
  #assert !cp_set_page_ok_flags(0, CP_PG_SCHED);

  // Sending a message and rendering a frame succeed cleanly on the slim page.
  #assert coder_page_set_text(s[..], "Hello Inkling");
  #assert coder_page_submit(s[..]);
  #assert coder_page_action(s[..]) == CP_ASK_SEND;
  #assert s[0].nturns == 1;
  #assert cp_rich_run_cmd(s[..], CP_CMD_FORK);
  #assert coder_page_action(s[..]) == CP_ASK_FORK;
}
