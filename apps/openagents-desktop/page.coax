// Coder's page (macOS first): a conversation with Microcoder. The turns
// scroll above the shared composer; each is the person's message
// (app_message_user), the reply as Markdown (app_message_agent) and what the
// run is doing (the activity group, app_working, app_notice, app_meta), all from the app set
// (components/app/). The page keeps the draft, the turns and the scroll; it
// has no effects. Its host (host.c, App.swift) runs the Microcoder worker
// (coder/tui/mcworker.coax) and passes its lines here; the lines both ways are
// the worker's own codec (coax/lib/agent/engine/mcworker-wire.coax).
//
// What a person does reaches the host as coder_page_action: send (the host
// writes coder_page_task to the worker), focus (the host's view takes the
// keyboard: the page draws and edits its fields, page/editor.coax), stop, a new
// chat, and a code block's Copy (coder_page_copied is the text).
//   coax/bin/coax test apps/openagents-desktop/page.coax --library

#load "page/parts.coax";
#load "page/checks/transcript-checks.coax" #test;
#load "page/checks/agents-checks.coax" #test;
#load "page/checks/models-checks.coax" #test;
#load "page/checks/goal-checks.coax" #test;
#load "page/checks/persist-checks.coax" #test;
#load "page/checks/chats-checks.coax" #test;
#load "page/checks/layout-checks.coax" #test;
#load "page/checks/followups-checks.coax" #test;
#load "page/checks/todos-checks.coax" #test;
#load "page/checks/review-checks.coax" #test;
#load "page/checks/overlay-checks.coax" #test;
#load "page/checks/editor-checks.coax" #test;
#load "page/checks/palette-checks.coax" #test;
#load "page/checks/composer-checks.coax" #test;
#load "page/checks/attach-checks.coax" #test;
#load "page/checks/filepane-checks.coax" #test;
#load "page/checks/shows-checks.coax" #test;
