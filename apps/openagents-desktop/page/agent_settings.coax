// Coder Desktop page (../page.coax & ../page-v1.coax): OpenAgents compute modes,
// developer model table, Settings -> Agent screen (4 clean groups), state, press handlers,
// and host C exports.

CP_COMPUTE_MODES :: 3;
CP_COMPUTE_AUTO :: 0;
CP_COMPUTE_LOCAL :: 1;
CP_COMPUTE_CLOUD :: 2;
CP_COMPUTE_ID :: [CP_COMPUTE_MODES] string.[
  "oa:auto",
  "oa:local",
  "oa:cloud",
];
CP_COMPUTE_LABEL :: [CP_COMPUTE_MODES] string.[
  "Auto",
  "Local",
  "Cloud",
];
CP_COMPUTE_DESC :: [CP_COMPUTE_MODES] string.[
  "Cloud & local · Best available",
  "On-device Inkling 2 Mini · Psionic Metal",
  "Cloud · Gemini 4 Neon · 1M context",
];
CP_COMPUTE_META :: [CP_COMPUTE_MODES] string.[
  "OpenAgents · Auto",
  "OpenAgents · Local",
  "OpenAgents · Cloud",
];

CP_FLAWED_MODELS :: 5;
CP_FLAWED_PREFIX :: "oa:";
CP_LEGACY_FLAWED_PREFIX :: "flawed:";
CP_FLAWED_ID :: [CP_FLAWED_MODELS] string.[
  "oa:gemini-4-neon",
  "oa:gemini-4-carbon",
  "oa:gemini-4-hydrogen",
  "oa:gemini-4-argon",
  "oa:inkling-2-mini",
];
CP_FLAWED_LABEL :: [CP_FLAWED_MODELS] string.[
  "OpenAgents · Gemini 4 Neon",
  "OpenAgents · Gemini 4 Carbon",
  "OpenAgents · Gemini 4 Hydrogen",
  "OpenAgents · Gemini 4 Argon",
  "OpenAgents · Inkling 2 Mini",
];
CP_FLAWED_SHORT :: [CP_FLAWED_MODELS] string.[
  "Neon",
  "Carbon",
  "Hydrogen",
  "Argon",
  "Inkling 2 Mini",
];
CP_FLAWED_DESC :: [CP_FLAWED_MODELS] string.[
  "Frontier reasoning · 1M context · OpenAgents Cloud",
  "Deep coding · 1M context · OpenAgents Cloud",
  "Fast & light · 1M context · OpenAgents Cloud",
  "High precision · 1M context · OpenAgents Cloud",
  "Local Psionic Metal · OpenAgents",
];
CP_FLAWED_META :: [CP_FLAWED_MODELS] string.[
  "OpenAgents · Gemini 4 Neon",
  "OpenAgents · Gemini 4 Carbon",
  "OpenAgents · Gemini 4 Hydrogen",
  "OpenAgents · Gemini 4 Argon",
  "OpenAgents · Inkling 2 Mini",
];
CP_FLAWED_START_CLOUD :: 0;    // Gemini 4 Neon (always first & default for every new chat)
CP_FLAWED_START_LOCAL :: 4;    // Inkling 2 Mini (opt-in local Psionic Metal slot)
CP_FLAWED_START :: 0;
CP_FLAWED_EFFORTS :: 5;        // Low, Medium, High, X-High, Max
CP_FLAWED_EFFORT_START :: 2;   // High
CP_FLAWED_PREFS_COUNT :: 21;

// Host action codes (non-conflicting with state.coax 0..189).
CP_ASK_FLAWED_PREFS :: 190;
CP_ASK_FLAWED_KEY :: 191;
CP_ASK_FLAWED_BASE_URL :: 192;
CP_ASK_FLAWED_CUSTOM_MODEL :: 193;
CP_ASK_FLAWED_TOOLS :: 194;
CP_ASK_FLAWED_LIMITS :: 195;
CP_ASK_FLAWED_AUTH_CHECK :: 196;
CP_ASK_FLAWED_RESET :: 197;
CP_ASK_FLAWED_X_KEY :: 222;

// Composer model picker footer shortcut to Settings -> Flawed.
CP_MODEL_FLAWED :: 398;

// Zero-initialized defaults:
// default_agent=0 (Flawed), model_slot=0 (Gemini 4 Neon),
// backend=0 (Auto: Vertex AI -> Gemini API -> OpenRouter for Neon, Local Psionic for Inkling),
// thinking_mode=0 (Adaptive), effort_off=0 (High), thinking_display=0 (Summarized),
// permission_mode=0 (Allow All — no permission checks whatsoever), bypass_danger=false, sandbox_mode=0 (Off),
// git_guard_on=false (Off, opt-in), prompt_cache=0 (Global), auto_compact_off=false (On),
// auto_memory_off=false (On), bare_mode=false, output_style=0 (Default),
// hooks_mode=0 (All), mcp_defer_off=false (On), fast_mode=false,
// extended_ctx=false, remote_bridge=false.
CpFlawedSettings :: struct {
  default_agent: int;      // 0: Flawed, 1: Inky (legacy local)
  model_slot: int;         // 0..4 into CP_FLAWED_ID (0 = Gemini 4 Neon default)
  backend: int;            // 0 Auto, 1 Local Psionic, 2 Vertex AI, 3 Gemini API, 4 OpenRouter
  thinking_mode: int;      // 0 Adaptive, 1 Extended, 2 Off
  effort_off: int;         // level - CP_FLAWED_EFFORT_START (0 -> High)
  thinking_display: int;   // 0 Summarized, 1 Hidden
  permission_mode: int;    // 0 Allow All (default, no checks), 1 Ask, 2 Accept Edits, 3 Plan, 4 Don't Ask
  bypass_danger: bool;     // override any opt-in permission mode to allow all
  sandbox_mode: int;       // 0 Off, 1 Auto, 2 Enforced
  git_guard_on: bool;      // opt-in (zero-init = Off)
  prompt_cache: int;       // 0 Global, 1 Org, 2 Off
  auto_compact_off: bool;  // inverted so zero-init = On
  auto_memory_off: bool;   // inverted so zero-init = On
  bare_mode: bool;         // skip CLAUDE.md / AGENTS.md / auto-memory / hooks
  output_style: int;       // 0 Default, 1 Concise, 2 Explanatory, 3 Learning
  hooks_mode: int;         // 0 All, 1 Managed, 2 Off
  mcp_defer_off: bool;     // inverted so zero-init = On
  fast_mode: bool;         // fast mode toggle
  extended_ctx: bool;      // 1M context window preference
  remote_bridge: bool;     // Remote Control session bridge
  allow_local_harnesses: bool; // Opt-in (default Off): allow delegating sub-agents to other local harnesses (#14071)
  subagent_git_most: int;      // The most a sub-agent may do with git: 0 commit and push (default), 1 commit only, 2 neither (#14104)
  subagent_git_host: bool;     // The host keeps and applies that setting (it passes the optional 22nd number); the row shows only then
  x_tools_enabled: bool;       // Opt-in (default Off): mount read-only XSearch tool when X API v2 Bearer token is configured (#14124)
  user_picked: bool;       // true after explicit user model pick or loaded chat
  // Host-supplied display strings for Settings -> Flawed.
  auth_status: [128] u8; auth_status_n: int;
  key_label: [64] u8; key_label_n: int;
  x_key_label: [64] u8; x_key_label_n: int;
  base_url: [192] u8; base_url_n: int;
  custom_model: [128] u8; custom_model_n: int;
  tools_summary: [192] u8; tools_summary_n: int;
  limits_summary: [128] u8; limits_summary_n: int;
  claude_status: [160] u8; claude_status_n: int;
  claude_desc_buf: [384] u8;
  desc_buf: [192] u8;
  id_buf: [96] u8;
  label_buf: [128] u8;
  meta_buf: [128] u8;
}

cp_flawed_clamp :: (v: int, lo: int, hi: int) -> int {
  if v < lo { return lo; }
  if v > hi { return hi; }
  return v;
}

cp_flawed_effort :: (s: [] CoderPage) -> int {
  if s.count < 1 { return CP_FLAWED_EFFORT_START; }
  e := s[0].flawed[0].effort_off + CP_FLAWED_EFFORT_START;
  return ifx e >= 0 && e < CP_FLAWED_EFFORTS then e else CP_FLAWED_EFFORT_START;
}

cp_flawed_git_guard :: (s: [] CoderPage) -> bool { return s.count > 0 && s[0].flawed[0].git_guard_on; }
cp_flawed_allow_local_harnesses :: (s: [] CoderPage) -> bool { return s.count > 0 && s[0].flawed[0].allow_local_harnesses; }
cp_flawed_auto_compact :: (s: [] CoderPage) -> bool { return s.count < 1 || !s[0].flawed[0].auto_compact_off; }
cp_flawed_auto_memory :: (s: [] CoderPage) -> bool { return s.count < 1 || !s[0].flawed[0].auto_memory_off; }
cp_flawed_mcp_defer :: (s: [] CoderPage) -> bool { return s.count < 1 || !s[0].flawed[0].mcp_defer_off; }

cp_flawed_backend_label :: (be: int) -> string {
  if be == 1 { return "Local Psionic"; }
  if be == 2 { return "Vertex AI"; }
  if be == 3 { return "Gemini API"; }
  if be == 4 { return "OpenRouter"; }
  if be == 5 { return "OpenAgents Cloud"; }
  return "Auto";
}

cp_flawed_label_for :: (s: [] CoderPage, slot: int) -> string {
  labels := CP_FLAWED_LABEL;
  if slot == CP_FLAWED_START_LOCAL && s.count > 0 {
    n := el_put(s[0].flawed[0].label_buf[..], 0, "OpenAgents · ");
    n = el_put(s[0].flawed[0].label_buf[..], n, cp_inkling_label(s));
    return cast(string) s[0].flawed[0].label_buf[0..<n];
  }
  return ifx slot >= 0 && slot < CP_FLAWED_MODELS then labels[slot] else labels[CP_FLAWED_START_CLOUD];
}

cp_flawed_meta_for :: (s: [] CoderPage, slot: int) -> string {
  metas := CP_FLAWED_META;
  if slot == CP_FLAWED_START_LOCAL && s.count > 0 {
    n := el_put(s[0].flawed[0].meta_buf[..], 0, "OpenAgents · ");
    n = el_put(s[0].flawed[0].meta_buf[..], n, cp_inkling_label(s));
    return cast(string) s[0].flawed[0].meta_buf[0..<n];
  }
  return ifx slot >= 0 && slot < CP_FLAWED_MODELS then metas[slot] else metas[CP_FLAWED_START_CLOUD];
}

cp_flawed_id_for :: (s: [] CoderPage, slot: int) -> string {
  ids := CP_FLAWED_ID;
  if slot == CP_FLAWED_START_LOCAL && s.count > 0 {
    n := el_put(s[0].flawed[0].id_buf[..], 0, CP_FLAWED_PREFIX);
    n = el_put(s[0].flawed[0].id_buf[..], n, cp_inkling_id(s));
    return cast(string) s[0].flawed[0].id_buf[0..<n];
  }
  return ifx slot >= 0 && slot < CP_FLAWED_MODELS then ids[slot] else ids[CP_FLAWED_START_CLOUD];
}

cp_flawed_desc_for :: (s: [] CoderPage, slot: int) -> string {
  descs := CP_FLAWED_DESC;
  base := ifx slot >= 0 && slot < CP_FLAWED_MODELS then descs[slot] else descs[CP_FLAWED_START_CLOUD];
  if s.count < 1 { return base; }
  if slot == CP_FLAWED_START_LOCAL {
    if !s[0].inkling { return cp_inkling_desc(s); }
    base = cp_inkling_desc(s);
  }
  fl := s[0].flawed[..];
  has_extra := fl[0].custom_model_n > 0 || fl[0].backend != 0 || fl[0].fast_mode;
  if !has_extra { return base; }
  n := 0;
  if fl[0].custom_model_n > 0 {
    n = el_put(fl[0].desc_buf[..], n, "Override: ");
    n = el_put(fl[0].desc_buf[..], n, cast(string) fl[0].custom_model[0..<fl[0].custom_model_n]);
  } else {
    n = el_put(fl[0].desc_buf[..], n, base);
  }
  if fl[0].backend != 0 {
    n = el_put(fl[0].desc_buf[..], n, " · ");
    n = el_put(fl[0].desc_buf[..], n, cp_flawed_backend_label(fl[0].backend));
  }
  if fl[0].fast_mode { n = el_put(fl[0].desc_buf[..], n, " · Fast"); }
  return cast(string) fl[0].desc_buf[0..<n];
}

cp_compute_id_for :: (slot: int) -> string {
  ids := CP_COMPUTE_ID;
  return ifx slot >= 0 && slot < CP_COMPUTE_MODES then ids[slot] else ids[CP_COMPUTE_AUTO];
}

cp_compute_label_for :: (slot: int) -> string {
  labels := CP_COMPUTE_LABEL;
  return ifx slot >= 0 && slot < CP_COMPUTE_MODES then labels[slot] else labels[CP_COMPUTE_AUTO];
}

cp_compute_meta_for :: (slot: int) -> string {
  metas := CP_COMPUTE_META;
  return ifx slot >= 0 && slot < CP_COMPUTE_MODES then metas[slot] else metas[CP_COMPUTE_AUTO];
}

cp_compute_desc_for :: (s: [] CoderPage, slot: int) -> string {
  descs := CP_COMPUTE_DESC;
  if slot == CP_COMPUTE_LOCAL && s.count > 0 { return cp_inkling_desc(s); }
  return ifx slot >= 0 && slot < CP_COMPUTE_MODES then descs[slot] else descs[CP_COMPUTE_AUTO];
}

cp_flawed_sync_empty_chat :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  if s[0].nturns == 0 && !cp_running(s) {
    s[0].flawed[0].user_picked = false;
    s[0].model = cp_model_start(s);
    s[0].model = cp_model_index(s);
  }
}

// ---------------------------------------------------------------- Settings -> Agent drawing (4 clean groups)

cp_settings_flawed :: (s: [] CoderPage, f: [] UiFrame, x: f32, y0: f32, w: f32) -> f32 {
  t := f[0].skin.set; sh := f[0].sheet;
  fl := s[0].flawed[..];
  y := y0;

  y += set_page_head(f, "set.title", x, y, w, "Agent",
    "Configure OpenAgents compute, reasoning effort, safety permissions, memory, and developer overrides.") + t.block_gap;

  // 1. Compute & Local Model
  y += set_section_head(f, "set.flawed.compute.head", x, y, w, "Compute & Local Model",
    "Auto uses cloud compute when available and falls back to on-device Inkling 2 Mini. Switch anytime in the composer.") + t.section_gap;
  mrows: [7] SetRow;
  cmode := cp_flawed_clamp(fl[0].default_agent, 0, CP_COMPUTE_MODES - 1);
  mrows[0] = SetRow.{id = "set.flawed.agent", name = "Default compute",
    desc = ifx cmode == CP_COMPUTE_LOCAL
           then "New chats run on-device via Inkling 2 Mini (Psionic Metal) when installed."
           else ifx cmode == CP_COMPUTE_CLOUD
           then "New chats run on cloud compute (Gemini 4 Neon · 1M context)."
           else "New chats use cloud compute when configured and local Inkling 2 Mini otherwise.",
    kind = SET_ROW_CHOICE, noptions = CP_COMPUTE_MODES, chosen = cmode, action = CP_SET_ACT};
  mrows[0].options[0] = "Auto";
  mrows[0].options[1] = "Local";
  mrows[0].options[2] = "Cloud";

  elabels := CP_CLAUDE_EFFORT_LABEL;
  mrows[1] = SetRow.{id = "set.flawed.effort", name = "Reasoning effort",
    desc = "Default reasoning depth for new chats. Override per chat from the composer effort control.",
    kind = SET_ROW_CHOICE, noptions = CP_FLAWED_EFFORTS, chosen = cp_flawed_effort(s), action = CP_SET_ACT};
  for ei: 0..<CP_FLAWED_EFFORTS { mrows[1].options[ei] = elabels[ei]; }

  mrows[2] = SetRow.{id = "set.flawed.tdisp", name = "Thinking display",
    desc = "Show live streamed thought summaries in the activity timeline, or keep them hidden.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = cp_flawed_clamp(fl[0].thinking_display, 0, 1), action = CP_SET_ACT};
  mrows[2].options[0] = "Summarized"; mrows[2].options[1] = "Hidden";

  auth_val := ifx fl[0].auth_status_n > 0 then sheet_pool(sh, cast(string) fl[0].auth_status[0..<fl[0].auth_status_n]) else "Not checked yet";
  mrows[3] = SetRow.{id = "set.flawed.auth", name = "Active credentials",
    desc = "Live probe showing local Inkling 2 Mini and cloud compute readiness.",
    value = auth_val, kind = SET_ROW_BUTTON, button = "Check", action = CP_SET_ACT};

  key_val := ifx fl[0].key_label_n > 0 then sheet_pool(sh, cast(string) fl[0].key_label[0..<fl[0].key_label_n]) else "Not set";
  mrows[4] = SetRow.{id = "set.flawed.key", name = "Gemini / OpenRouter API key",
    desc = "Optional key stored locally (0600, never logged). Not needed for on-device Inkling or OpenAgents Cloud.",
    value = key_val, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};

  // Show live Claude Code availability & sign-in state next to the opt-in toggle (#14104).
  hd_n := el_put(fl[0].claude_desc_buf[..], 0, "Claude Code: ");
  if fl[0].claude_status_n > 0 {
    hd_n = el_put(fl[0].claude_desc_buf[..], hd_n, cast(string) fl[0].claude_status[0..<fl[0].claude_status_n]);
  } else if s[0].claude_sub {
    hd_n = el_put(fl[0].claude_desc_buf[..], hd_n, "Ready");
  } else {
    hd_n = el_put(fl[0].claude_desc_buf[..], hd_n, "Not detected");
  }
  hd_n = el_put(fl[0].claude_desc_buf[..], hd_n, " · Opt-in: allow OpenAgents Core to delegate sub-agent tasks to installed local harnesses (Claude Code, Codex, Antigravity, Cursor).");
  harnesses_desc := sheet_pool(sh, cast(string) fl[0].claude_desc_buf[0..<hd_n]);
  mrows[5] = SetRow.{id = "set.flawed.harnesses", name = "Allow delegating to other local harnesses",
    desc = harnesses_desc,
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].allow_local_harnesses then 1 else 0, action = CP_SET_ACT};
  mrows[5].options[0] = "Off"; mrows[5].options[1] = "On";
  mrows[6] = SetRow.{id = "set.flawed.subgit", name = "Most a sub-agent may do with git",
    desc = "A sub-agent commits or pushes only when the chat that delegates to it asks. This sets the most it can be allowed.",
    kind = SET_ROW_CHOICE, noptions = 3, chosen = cp_flawed_clamp(fl[0].subagent_git_most, 0, 2), action = CP_SET_ACT};
  mrows[6].options[0] = "Commit and push"; mrows[6].options[1] = "Commit only"; mrows[6].options[2] = "Neither";
  nmrows := ifx fl[0].subagent_git_host then 7 else 6;
  y += cp_set_group(s, f, "set.flawed.compute.group", x, y, w, mrows[0..<nmrows]) + t.block_gap;

  // 2. Safety & Permissions
  y += set_section_head(f, "set.flawed.perm.head", x, y, w, "Safety & Permissions",
    "Default is Allow All. Permission prompts, OS shell confinement, and destructive-git guards are opt-in below.") + t.section_gap;
  prows: [6] SetRow;
  pm := cp_flawed_clamp(fl[0].permission_mode, 0, 4);
  prows[0] = SetRow.{id = "set.flawed.pmode", name = "Permission mode",
    desc = ifx pm == 1 then "Ask (opt-in) — read-only tools run freely; prompt before edits, writes, and shell commands."
           else ifx pm == 2 then "Accept Edits (opt-in) — auto-approve file edits & writes; prompt before shell commands."
           else ifx pm == 3 then "Plan (opt-in) — read-only exploration and planning; block mutating tools."
           else ifx pm == 4 then "Don't Ask (opt-in) — auto-deny any tool that would prompt instead of pausing."
           else "Allow All (default) — approve every tool automatically with no prompts.",
    kind = SET_ROW_CHOICE, noptions = 5, chosen = pm, action = CP_SET_ACT};
  prows[0].options[0] = "Allow All";
  prows[0].options[1] = "Ask";
  prows[0].options[2] = "Accept Edits";
  prows[0].options[3] = "Plan";
  prows[0].options[4] = "Don't Ask";

  sb := cp_flawed_clamp(fl[0].sandbox_mode, 0, 2);
  prows[1] = SetRow.{id = "set.flawed.sandbox", name = "OS shell sandbox",
    desc = ifx sb == 1 then "Auto — wrap shell commands in macOS sandbox-exec restricting writes to workspace and /tmp."
           else ifx sb == 2 then "Enforced — require OS sandbox on every shell command and fail closed if unavailable."
           else "Off — run shell commands directly without sandbox confinement.",
    kind = SET_ROW_CHOICE, noptions = 3, chosen = sb, action = CP_SET_ACT};
  prows[1].options[0] = "Off"; prows[1].options[1] = "Auto"; prows[1].options[2] = "Enforced";

  prows[2] = SetRow.{id = "set.flawed.gitguard", name = "Git safety guard",
    desc = "Opt-in: block destructive git commands (force push to main, hard reset, clean -fd) before execution.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx cp_flawed_git_guard(s) then 1 else 0, action = CP_SET_ACT};
  prows[2].options[0] = "Off"; prows[2].options[1] = "On";

  tval := ifx fl[0].tools_summary_n > 0 then sheet_pool(sh, cast(string) fl[0].tools_summary[0..<fl[0].tools_summary_n]) else "All built-in tools";
  prows[3] = SetRow.{id = "set.flawed.tools", name = "Tool rules & directories",
    desc = "Configure allowedTools, disallowedTools (CSV), and additionalDirs accessible outside the working folder.",
    value = tval, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};

  prows[4] = SetRow.{id = "set.flawed.xtools", name = "X API tool (XSearch)",
    desc = "Opt-in read-only X API v2 search, user lookup, timelines, and posts. Zero token overhead when Off or unconfigured.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].x_tools_enabled then 1 else 0, action = CP_SET_ACT};
  prows[4].options[0] = "Off"; prows[4].options[1] = "On";

  xkey_val := ifx fl[0].x_key_label_n > 0 then sheet_pool(sh, cast(string) fl[0].x_key_label[0..<fl[0].x_key_label_n]) else "Not set";
  prows[5] = SetRow.{id = "set.flawed.xkey", name = "X API Bearer token",
    desc = "Optional X API v2 Bearer token stored locally (0600, percent-encoding preserved verbatim, never logged). Saving automatically enables XSearch.",
    value = xkey_val, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
  y += cp_set_group(s, f, "set.flawed.perm.group", x, y, w, prows[..]) + t.block_gap;

  // 3. Memory
  y += set_section_head(f, "set.flawed.ctx.head", x, y, w, "Memory",
    "Automatic context compaction, AGENTS.md discovery, custom system prompt, and response style.") + t.section_gap;
  crows: [4] SetRow;
  crows[0] = SetRow.{id = "set.flawed.compact", name = "Auto-compaction",
    desc = "Automatically compact older messages before hitting the context window limit (also available via /compact).",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx cp_flawed_auto_compact(s) then 0 else 1, action = CP_SET_ACT};
  crows[0].options[0] = "On"; crows[0].options[1] = "Off";

  crows[1] = SetRow.{id = "set.flawed.memory", name = "Auto-memory & AGENTS.md",
    desc = "Load AGENTS.md, CLAUDE.md, and ~/.openagents/instructions.md into the system prompt.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx cp_flawed_auto_memory(s) then 0 else 1, action = CP_SET_ACT};
  crows[1].options[0] = "On"; crows[1].options[1] = "Off";

  sp_val := ifx s[0].set_sysprompt_n > 0 then sheet_pool(sh, cast(string) s[0].set_sysprompt[0..<s[0].set_sysprompt_n]) else "Off";
  sp_desc := ifx s[0].set_sysprompt_preview_n > 0 then sheet_pool(sh, cast(string) s[0].set_sysprompt_preview[0..<s[0].set_sysprompt_preview_n]) else "Instructions in ~/.openagents/system-prompt.md appended to every system prompt.";
  crows[2] = SetRow.{id = "set.flawed.sysprompt", name = "Custom system prompt",
    desc = sp_desc,
    value = sp_val, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};

  ost := cp_flawed_clamp(fl[0].output_style, 0, 3);
  crows[3] = SetRow.{id = "set.flawed.style", name = "Output style",
    desc = ifx ost == 1 then "Concise — terse answers, minimal prose, code and diffs first."
           else ifx ost == 2 then "Explanatory — walk through design trade-offs and architectural rationale."
           else ifx ost == 3 then "Learning — collaborative coaching with explanations of why each change works."
           else "Default — balanced autonomous engineering style.",
    kind = SET_ROW_CHOICE, noptions = 4, chosen = ost, action = CP_SET_ACT};
  crows[3].options[0] = "Default"; crows[3].options[1] = "Concise"; crows[3].options[2] = "Explanatory"; crows[3].options[3] = "Learning";
  y += cp_set_group(s, f, "set.flawed.ctx.group", x, y, w, crows[..]) + t.block_gap;

  // 4. Developer
  y += set_section_head(f, "set.flawed.dev.head", x, y, w, "Developer",
    "Advanced model picker, backend overrides, custom endpoints, caching, hooks, and session limits.") + t.section_gap;
  drows: [16] SetRow;
  drows[0] = SetRow.{id = "set.flawed.others", name = "Show other models & harnesses",
    desc = "Expose individual cloud models, Antigravity, OpenRouter, Claude Code, Codex, Cursor, and ACP entries in the composer.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx s[0].show_other_models then 1 else 0, action = CP_SET_ACT};
  drows[0].options[0] = "Off"; drows[0].options[1] = "On";

  shorts := CP_FLAWED_SHORT;
  mslot := cp_flawed_clamp(fl[0].model_slot, 0, CP_FLAWED_MODELS - 1);
  drows[1] = SetRow.{id = "set.flawed.model", name = "Developer default model",
    desc = "Default model slot when Show other models & harnesses is enabled.",
    kind = SET_ROW_CHOICE, noptions = CP_FLAWED_MODELS, chosen = mslot, action = CP_SET_ACT};
  for i: 0..<CP_FLAWED_MODELS { drows[1].options[i] = shorts[i]; }

  be := cp_flawed_clamp(fl[0].backend, 0, 5);
  drows[2] = SetRow.{id = "set.flawed.backend", name = "Inference backend",
    desc = ifx be == 1 then "Force Local Psionic Metal server (on-device Inkling 2 Mini)."
           else ifx be == 2 then "Force Google Cloud Vertex AI (developer override)."
           else ifx be == 3 then "Force Gemini Developer API (developer override)."
           else ifx be == 4 then "Force OpenRouter Chat Completions API (developer override)."
           else ifx be == 5 then "Force OpenAgents Cloud gateway (openagents.com/api/v1/inference)."
           else "Auto-route by compute mode: OpenAgents Cloud -> Local Psionic (or BYO developer keys).",
    kind = SET_ROW_CHOICE, noptions = 6, chosen = be, action = CP_SET_ACT};
  drows[2].options[0] = "Auto"; drows[2].options[1] = "Local"; drows[2].options[2] = "Vertex"; drows[2].options[3] = "Gemini"; drows[2].options[4] = "OpenRouter"; drows[2].options[5] = "Cloud";

  cmod := ifx fl[0].custom_model_n > 0 then sheet_pool(sh, cast(string) fl[0].custom_model[0..<fl[0].custom_model_n]) else "Default (from picker)";
  drows[3] = SetRow.{id = "set.flawed.custom", name = "Custom model override",
    desc = "Override the wire model slug for Vertex AI, Gemini API, OpenRouter, or custom local Psionic models.",
    value = cmod, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};

  url_val := ifx fl[0].base_url_n > 0 then sheet_pool(sh, cast(string) fl[0].base_url[0..<fl[0].base_url_n]) else "Default endpoint";
  drows[4] = SetRow.{id = "set.flawed.url", name = "Custom API base URL",
    desc = "Optional endpoint override for Vertex/Gemini proxies, OpenRouter mirrors, or remote Psionic servers.",
    value = url_val, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};

  tm := cp_flawed_clamp(fl[0].thinking_mode, 0, 2);
  drows[5] = SetRow.{id = "set.flawed.tmode", name = "Thinking mode",
    desc = ifx tm == 0 then "Adaptive — stream native reasoning thoughts scaled by effort level."
           else ifx tm == 1 then "Extended — deeper reasoning budget scaled by effort level."
           else "Off — hide thoughts and minimize reasoning latency.",
    kind = SET_ROW_CHOICE, noptions = 3, chosen = tm, action = CP_SET_ACT};
  drows[5].options[0] = "Adaptive"; drows[5].options[1] = "Extended"; drows[5].options[2] = "Off";

  pc := cp_flawed_clamp(fl[0].prompt_cache, 0, 2);
  drows[6] = SetRow.{id = "set.flawed.cache", name = "Prompt caching",
    desc = "Maintain stable system prompt, tool definitions, and conversation prefix ordering.",
    kind = SET_ROW_CHOICE, noptions = 3, chosen = pc, action = CP_SET_ACT};
  drows[6].options[0] = "Global"; drows[6].options[1] = "Org"; drows[6].options[2] = "Off";

  hm := cp_flawed_clamp(fl[0].hooks_mode, 0, 2);
  drows[7] = SetRow.{id = "set.flawed.hooks", name = "Lifecycle hooks",
    desc = "Control PreToolUse / PostToolUse / Stop / Notification hook execution policy.",
    kind = SET_ROW_CHOICE, noptions = 3, chosen = hm, action = CP_SET_ACT};
  drows[7].options[0] = "All"; drows[7].options[1] = "Managed"; drows[7].options[2] = "Off";

  drows[8] = SetRow.{id = "set.flawed.bare", name = "Bare / simple mode",
    desc = "Minimal prompt mode: skips AGENTS.md, CLAUDE.md, auto-memory, and hooks.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].bare_mode then 1 else 0, action = CP_SET_ACT};
  drows[8].options[0] = "Off"; drows[8].options[1] = "On";

  drows[9] = SetRow.{id = "set.flawed.mcpdefer", name = "Deferred MCP ToolSearch",
    desc = "Defer MCP tool schemas behind ToolSearch when token usage exceeds 10% of the context window.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx cp_flawed_mcp_defer(s) then 0 else 1, action = CP_SET_ACT};
  drows[9].options[0] = "On"; drows[9].options[1] = "Off";

  drows[10] = SetRow.{id = "set.flawed.fast", name = "Fast mode",
    desc = "Prefer lower-latency output when supported by the active backend.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].fast_mode then 1 else 0, action = CP_SET_ACT};
  drows[10].options[0] = "Off"; drows[10].options[1] = "On";

  drows[11] = SetRow.{id = "set.flawed.ctx1m", name = "Extended 1M context",
    desc = "Gemini 4 Neon models natively support 1,048,576 input tokens (32K on local Inkling 2 Mini).",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].extended_ctx then 1 else 0, action = CP_SET_ACT};
  drows[11].options[0] = "Auto"; drows[11].options[1] = "1M";

  drows[12] = SetRow.{id = "set.flawed.bypass", name = "Bypass opt-in mode",
    desc = "Override any opt-in permission mode above and approve all tools with zero checks.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].bypass_danger then 1 else 0, action = CP_SET_ACT, danger = true};
  drows[12].options[0] = "Off"; drows[12].options[1] = "On";

  lval := ifx fl[0].limits_summary_n > 0 then sheet_pool(sh, cast(string) fl[0].limits_summary[0..<fl[0].limits_summary_n]) else "Unlimited turns · No extra cap";
  drows[13] = SetRow.{id = "set.flawed.limits", name = "Turn & budget limits",
    desc = "Set maximum agentic tool turns per request (--max-turns) and per-turn USD spend cap (--max-budget-usd).",
    value = lval, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};

  drows[14] = SetRow.{id = "set.flawed.remote", name = "Remote Control bridge",
    desc = "Allow signed mobile / companion bridge control sessions.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx fl[0].remote_bridge then 1 else 0, action = CP_SET_ACT};
  drows[14].options[0] = "Off"; drows[14].options[1] = "On";

  drows[15] = SetRow.{id = "set.flawed.reset", name = "Reset Agent settings",
    desc = "Restore all Agent settings (compute, effort, permissions, sandbox, limits) to defaults.",
    kind = SET_ROW_BUTTON, button = "Reset…", action = CP_SET_ACT, danger = true};
  y += cp_set_group(s, f, "set.flawed.dev.group", x, y, w, drows[..]);

  return y - y0;
}

// ---------------------------------------------------------------- Press handling

cp_flawed_settings_press :: (s: [] CoderPage, id: string) -> bool {
  if s.count < 1 { return false; }
  fl := s[0].flawed[..];

  // Dialog / button actions
  if id == "set.flawed.key.a" || id == "set.flawed.key" { s[0].ask = CP_ASK_FLAWED_KEY; return true; }
  if id == "set.flawed.xkey.a" || id == "set.flawed.xkey" { s[0].ask = CP_ASK_FLAWED_X_KEY; return true; }
  if id == "set.flawed.url.a" || id == "set.flawed.url" { s[0].ask = CP_ASK_FLAWED_BASE_URL; return true; }
  if id == "set.flawed.custom.a" || id == "set.flawed.custom" { s[0].ask = CP_ASK_FLAWED_CUSTOM_MODEL; return true; }
  if id == "set.flawed.tools.a" || id == "set.flawed.tools" { s[0].ask = CP_ASK_FLAWED_TOOLS; return true; }
  if id == "set.flawed.limits.a" || id == "set.flawed.limits" { s[0].ask = CP_ASK_FLAWED_LIMITS; return true; }
  if id == "set.flawed.auth.a" || id == "set.flawed.auth" { s[0].ask = CP_ASK_FLAWED_AUTH_CHECK; return true; }
  if id == "set.flawed.reset.a" || id == "set.flawed.reset" { s[0].ask = CP_ASK_FLAWED_RESET; return true; }
  if id == "set.flawed.sysprompt.a" || id == "set.flawed.sysprompt" { s[0].ask = CP_ASK_CUSTOM_PROMPT; return true; }

  // Developer toggle: Show other models & harnesses
  v := cp_number(id, "set.flawed.others.");
  if v == 0 || v == 1 {
    coder_page_show_other_models_set(s, v == 1);
    s[0].ask = CP_ASK_SHOW_OTHER_MODELS;
    return true;
  }

  // Segmented choices
  v = cp_number(id, "set.flawed.agent.");
  if v >= 0 && v < CP_COMPUTE_MODES {
    fl[0].default_agent = v;
    cp_flawed_sync_empty_chat(s);
    s[0].ask = CP_ASK_FLAWED_PREFS;
    return true;
  }
  v = cp_number(id, "set.flawed.model.");
  if v >= 0 && v < CP_FLAWED_MODELS {
    fl[0].model_slot = v;
    cp_flawed_sync_empty_chat(s);
    s[0].ask = CP_ASK_FLAWED_PREFS;
    return true;
  }
  v = cp_number(id, "set.flawed.ctx1m.");
  if v == 0 || v == 1 { fl[0].extended_ctx = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.fast.");
  if v == 0 || v == 1 { fl[0].fast_mode = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.backend.");
  if v >= 0 && v <= 5 { fl[0].backend = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.tmode.");
  if v >= 0 && v <= 2 { fl[0].thinking_mode = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.effort.");
  if v >= 0 && v < CP_FLAWED_EFFORTS { fl[0].effort_off = v - CP_FLAWED_EFFORT_START; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.tdisp.");
  if v == 0 || v == 1 { fl[0].thinking_display = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.pmode.");
  if v >= 0 && v <= 4 { fl[0].permission_mode = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.bypass.");
  if v == 0 || v == 1 { fl[0].bypass_danger = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.sandbox.");
  if v >= 0 && v <= 2 { fl[0].sandbox_mode = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.gitguard.");
  if v == 0 || v == 1 { fl[0].git_guard_on = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.cache.");
  if v >= 0 && v <= 2 { fl[0].prompt_cache = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.compact.");
  if v == 0 || v == 1 { fl[0].auto_compact_off = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.memory.");
  if v == 0 || v == 1 { fl[0].auto_memory_off = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.bare.");
  if v == 0 || v == 1 { fl[0].bare_mode = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.style.");
  if v >= 0 && v <= 3 { fl[0].output_style = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.hooks.");
  if v >= 0 && v <= 2 { fl[0].hooks_mode = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.mcpdefer.");
  if v == 0 || v == 1 { fl[0].mcp_defer_off = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.remote.");
  if v == 0 || v == 1 { fl[0].remote_bridge = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.harnesses.");
  if v == 0 || v == 1 { fl[0].allow_local_harnesses = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.subgit.");
  if v >= 0 && v <= 2 { fl[0].subagent_git_most = v; s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  v = cp_number(id, "set.flawed.xtools.");
  if v == 0 || v == 1 { fl[0].x_tools_enabled = (v == 1); s[0].ask = CP_ASK_FLAWED_PREFS; return true; }
  return false;
}

// ---------------------------------------------------------------- Host C exports

coder_page_model_flawed :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_flawed(s, cp_model_index(s));
}

coder_page_model_flawed_local :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_flawed_local(s, cp_model_index(s));
}

coder_page_flawed_prefs_set :: (s: [] CoderPage, vals: [] int) #export_c #effects(all) {
  if s.count < 1 || vals.count < CP_FLAWED_PREFS_COUNT { return; }
  fl := s[0].flawed[..];
  prev_agent := fl[0].default_agent;
  prev_slot := fl[0].model_slot;
  prev_be := fl[0].backend;
  fl[0].default_agent = cp_flawed_clamp(vals[0], 0, CP_COMPUTE_MODES - 1);
  fl[0].model_slot = cp_flawed_clamp(vals[1], 0, CP_FLAWED_MODELS - 1);
  fl[0].backend = cp_flawed_clamp(vals[2], 0, 5);
  fl[0].thinking_mode = cp_flawed_clamp(vals[3], 0, 2);
  fl[0].effort_off = cp_flawed_clamp(vals[4], 0, CP_FLAWED_EFFORTS - 1) - CP_FLAWED_EFFORT_START;
  fl[0].thinking_display = cp_flawed_clamp(vals[5], 0, 1);
  fl[0].permission_mode = cp_flawed_clamp(vals[6], 0, 4);
  fl[0].bypass_danger = vals[7] != 0;
  fl[0].sandbox_mode = cp_flawed_clamp(vals[8], 0, 2);
  fl[0].git_guard_on = vals[9] != 0;
  fl[0].prompt_cache = cp_flawed_clamp(vals[10], 0, 2);
  fl[0].auto_compact_off = vals[11] == 0;
  fl[0].auto_memory_off = vals[12] == 0;
  fl[0].bare_mode = vals[13] != 0;
  fl[0].output_style = cp_flawed_clamp(vals[14], 0, 3);
  fl[0].hooks_mode = cp_flawed_clamp(vals[15], 0, 2);
  fl[0].mcp_defer_off = vals[16] == 0;
  fl[0].fast_mode = vals[17] != 0;
  fl[0].extended_ctx = vals[18] != 0;
  fl[0].remote_bridge = vals[19] != 0;
  fl[0].allow_local_harnesses = vals[20] != 0;
  // Optional 22nd number: a host that passes it keeps and applies the sub-agent git limit.
  if vals.count > CP_FLAWED_PREFS_COUNT { fl[0].subagent_git_most = cp_flawed_clamp(vals[21], 0, 2); fl[0].subagent_git_host = true; }
  if prev_agent != fl[0].default_agent || prev_slot != fl[0].model_slot || prev_be != fl[0].backend {
    cp_flawed_sync_empty_chat(s);
  }
}

coder_page_flawed_prefs_get :: (s: [] CoderPage, out: [] int) -> int #export_c #effects(all) {
  if s.count < 1 || out.count < CP_FLAWED_PREFS_COUNT { return 0; }
  fl := s[0].flawed[..];
  out[0] = cp_flawed_clamp(fl[0].default_agent, 0, CP_COMPUTE_MODES - 1);
  out[1] = cp_flawed_clamp(fl[0].model_slot, 0, CP_FLAWED_MODELS - 1);
  out[2] = cp_flawed_clamp(fl[0].backend, 0, 5);
  out[3] = cp_flawed_clamp(fl[0].thinking_mode, 0, 2);
  out[4] = cp_flawed_effort(s);
  out[5] = cp_flawed_clamp(fl[0].thinking_display, 0, 1);
  out[6] = cp_flawed_clamp(fl[0].permission_mode, 0, 4);
  out[7] = ifx fl[0].bypass_danger then 1 else 0;
  out[8] = cp_flawed_clamp(fl[0].sandbox_mode, 0, 2);
  out[9] = ifx cp_flawed_git_guard(s) then 1 else 0;
  out[10] = cp_flawed_clamp(fl[0].prompt_cache, 0, 2);
  out[11] = ifx cp_flawed_auto_compact(s) then 1 else 0;
  out[12] = ifx cp_flawed_auto_memory(s) then 1 else 0;
  out[13] = ifx fl[0].bare_mode then 1 else 0;
  out[14] = cp_flawed_clamp(fl[0].output_style, 0, 3);
  out[15] = cp_flawed_clamp(fl[0].hooks_mode, 0, 2);
  out[16] = ifx cp_flawed_mcp_defer(s) then 1 else 0;
  out[17] = ifx fl[0].fast_mode then 1 else 0;
  out[18] = ifx fl[0].extended_ctx then 1 else 0;
  out[19] = ifx fl[0].remote_bridge then 1 else 0;
  out[20] = ifx fl[0].allow_local_harnesses then 1 else 0;
  if out.count > CP_FLAWED_PREFS_COUNT {
    out[21] = cp_flawed_clamp(fl[0].subagent_git_most, 0, 2);
    fl[0].subagent_git_host = true;
    return CP_FLAWED_PREFS_COUNT + 1;
  }
  return CP_FLAWED_PREFS_COUNT;
}

coder_page_flawed_info :: (s: [] CoderPage, auth_status: string, key_label: string, base_url: string, custom_model: string, tools_summary: string, limits_summary: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  fl := s[0].flawed[..];
  fl[0].auth_status_n = cp_out(fl[0].auth_status[..], auth_status);
  fl[0].key_label_n = cp_out(fl[0].key_label[..], key_label);
  fl[0].base_url_n = cp_out(fl[0].base_url[..], base_url);
  fl[0].custom_model_n = cp_out(fl[0].custom_model[..], custom_model);
  fl[0].tools_summary_n = cp_out(fl[0].tools_summary[..], tools_summary);
  fl[0].limits_summary_n = cp_out(fl[0].limits_summary[..], limits_summary);
  cp_model_restore_id(s, prev);
}

// Host-supplied Claude Code CLI & sign-in probe summary shown in Settings > Agent (#14104).
coder_page_set_claude_status :: (s: [] CoderPage, status: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].flawed[0].claude_status_n = cp_out(s[0].flawed[0].claude_status[..], status);
}

// Optional X API (XSearch) toggle and Bearer token status label shown in Settings > Agent (#14124).
coder_page_flawed_x_tools_set :: (s: [] CoderPage, enabled: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].flawed[0].x_tools_enabled = enabled;
}

coder_page_flawed_x_tools :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].flawed[0].x_tools_enabled;
}

coder_page_flawed_x_key :: (s: [] CoderPage, key_label: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].flawed[0].x_key_label_n = cp_out(s[0].flawed[0].x_key_label[..], key_label);
}
