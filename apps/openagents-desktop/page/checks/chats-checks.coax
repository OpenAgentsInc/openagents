// Checks for the page's chats.coax and layout/sidebar.coax: the chat list, pins, unread and busy rows, the Foreman row. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "pinned chats parse, stay distinct from recents, and reorder by drag" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  coder_page_chats(s, "p1\tAlpha\t0\t1\np2\tBeta\t0\t1\np3\tGamma\t0\t1\nr1\tRecent one\nr2\tRecent two\n");
  #assert s[0].nchats == 5 && cp_pin_count(s) == 3;
  #assert s[0].chats[0].pinned && s[0].chats[1].pinned && s[0].chats[2].pinned;
  #assert !s[0].chats[3].pinned && !s[0].chats[4].pinned;
  #assert cp_pin_index(s, 0) == 0 && cp_pin_index(s, 1) == 1 && cp_pin_index(s, 2) == 2 && cp_pin_index(s, 3) == -1;
  // Commit a layout frame so surface_hit knows the pinned rows.
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].pin_row_h > 0 && s[0].pin_top > 0;
  // Drag p1 down onto p3's slot.
  y1 := s[0].pin_top + 0.5f32 * s[0].pin_row_h;
  y3 := s[0].pin_top + 2.5f32 * s[0].pin_row_h;
  #assert coder_page_pointer(s, 80, y1, 0);
  #assert s[0].pin_drag == 1 && !s[0].pin_dragging;
  #assert coder_page_pointer(s, 80, y3, 1);
  #assert s[0].pin_dragging && s[0].pin_drop == 2;
  #assert coder_page_pointer(s, 80, y3, 2);
  #assert coder_page_action(s) == CP_ASK_REORDER_PIN;
  moved: [64] u8;
  mn := coder_page_pin_move_id(s, moved[..]);
  #assert cast(string) moved[0..<mn] == "p1" && coder_page_pin_move_to(s) == 2;
  // Internal pinned order is now p2, p3, p1 while recents stay intact.
  #assert cast(string) s[0].chats[0].id[0..<s[0].chats[0].id_n] == "chat.p2";
  #assert cast(string) s[0].chats[1].id[0..<s[0].chats[1].id_n] == "chat.p3";
  #assert cast(string) s[0].chats[2].id[0..<s[0].chats[2].id_n] == "chat.p1";
  #assert cast(string) s[0].chats[3].id[0..<s[0].chats[3].id_n] == "chat.r1";
  // Re-layout and drag p1 back up to the top slot (0).
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, true, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert coder_page_pointer(s, 80, y3, 0);
  #assert coder_page_pointer(s, 80, y1, 1);
  #assert s[0].pin_dragging && s[0].pin_drop == 0;
  #assert coder_page_pointer(s, 80, y1, 2);
  #assert coder_page_action(s) == CP_ASK_REORDER_PIN;
  mn = coder_page_pin_move_id(s, moved[..]);
  #assert cast(string) moved[0..<mn] == "p1" && coder_page_pin_move_to(s) == 0;
  #assert cast(string) s[0].chats[0].id[0..<s[0].chats[0].id_n] == "chat.p1";
  #assert cast(string) s[0].chats[1].id[0..<s[0].chats[1].id_n] == "chat.p2";
  #assert cast(string) s[0].chats[2].id[0..<s[0].chats[2].id_n] == "chat.p3";
}

#test "sidebar unread chats parse in Pinned and Recents, clear on select, and do not keep the page moving" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "p1\tPinned unread\t0\t1\t0\t1\nr1\tRecent unread\t0\t0\t0\t1\nb1\tBusy chat\t1\t0\t0\t1\nr2\tRead chat\n");
  #assert s[0].nchats == 4 && cp_pin_count(s) == 1;
  #assert s[0].chats[0].pinned && s[0].chats[0].unread && !s[0].chats[0].busy;
  #assert !s[0].chats[1].pinned && s[0].chats[1].unread && !s[0].chats[1].busy;
  #assert s[0].chats[2].busy && s[0].chats[2].unread;
  #assert !s[0].chats[3].unread && !s[0].chats[3].busy;
  // Selecting a chat clears its unread state immediately.
  coder_page_current(s, "p1");
  #assert !s[0].chats[0].unread && s[0].chats[1].unread;
  coder_page_current(s, "r1");
  #assert !s[0].chats[1].unread;
  // An unread-only sidebar does not keep the page moving.
  coder_page_chats(s, "p1\tPinned unread\t0\t1\t0\t1\nr1\tRecent unread\t0\t0\t0\t1\n");
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert !cp_side_busy(s) && !coder_page_moving(s);
}

#test "the sidebar says how many older chats are left out only when some are" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  f: [1] UiFrame;
  // one chat: no "0 older chats" line
  coder_page_chats(s, "a1\tOnly chat\n");
  #assert s[0].nchats == 1 && s[0].chats_more == 0;
  #assert cp_test_draw_side(s, f[..]);
  #assert surface_find(s[0].surface[..], "coder.chats.more") < 0;
  // no chats: the hint shows
  coder_page_chats(s, "");
  #assert cp_test_draw_side(s, f[..]);
  #assert surface_find(s[0].surface[..], "coder.chats.more") >= 0;
  // more chats than the list holds: the count shows
  lb: [CP_CHATS * 16 + 64] u8; ln := 0;
  for q: 0..<CP_CHATS + 2 { ln = el_put(lb[..], ln, "c"); ln = el_put_i(lb[..], ln, q); ln = el_put(lb[..], ln, "\tChat\n"); }
  coder_page_chats(s, cast(string) lb[0..<ln]);
  #assert s[0].chats_more == 2;
  s[0].side_scroll = 100000.0f32;   // the line sits under the list's last row
  #assert cp_test_draw_side(s, f[..]);
  #assert surface_find(s[0].surface[..], "coder.chats.more") >= 0;
  #assert surface_say(s[0].surface[..], surface_find(s[0].surface[..], "coder.chats.more")) == "2 older chats are not shown.";
}

#test "a busy sidebar chat keeps the page moving while idle" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "a1\tBackground run\t1\nb2\tIdle chat\n");
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert !cp_running(s) && s[0].side > 0 && cp_side_busy(s) && coder_page_moving(s);
  // Collapsing the sidebar or clearing the busy flag lets the page go idle.
  s[0].side = 0;
  #assert !cp_side_busy(s);
  coder_page_chats(s, "a1\tBackground run\nb2\tIdle chat\n");
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side > 0 && !cp_side_busy(s) && !coder_page_moving(s);
  // the pointer on a chat: its wash eases in (#13772), then nothing moves and the window goes idle
  i := surface_find(s[0].surface[..], "chat.b2");
  #assert i >= 0;
  r := surface_rows(s[0].surface[..]).rows[i]; hx := r.x + r.w / 2; hy := r.y + r.h / 2;
  n := 0; settled := false;
  while n < 30 && !settled {
    uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(hx, hy, true, false, "", ""), 0.032 + cast(f32) n * 0.016, 0.016, false, false);
    cp_layout(s, f[..], 1200.0f32, 800.0f32);
    s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
    #assert uiframe_end(f[..], s[0].surface[..]);
    if n == 0 { #assert coder_page_moving(s); }
    settled = !coder_page_moving(s); n += 1;
  }
  hk := keyed_find(s[0].keyed[..], "chat.b2");
  #assert settled && n <= 12 && hk >= 0 && s[0].keyed[0].rows[hk].spring[0].value == 1;
  // with reduced motion the wash leaves at once: idle on the first frame
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 1, 0.016, true, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
  #assert uiframe_end(f[..], s[0].surface[..]) && !coder_page_moving(s);
}

#test "foreman sidebar row sits above pinned and recents, dispatches CP_ASK_FOREMAN, and parses managed chats" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "p1\tPinned\t0\t1\t0\nm1\tManaged task\t1\t0\t1\nr1\tRegular\n");
  #assert s[0].nchats == 3 && !s[0].chats[0].managed && s[0].chats[1].managed && !s[0].chats[2].managed;
  coder_page_foreman(s, true, CP_FOREMAN_TIER_AUTO);
  #assert s[0].foreman_busy && s[0].foreman_tier == CP_FOREMAN_TIER_AUTO;
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert cp_side_busy(s) && coder_page_moving(s);
  // Click and hit-test the Foreman row directly below New chat and Dashboard.
  fx := 40.0f32;
  fy := cp_bar(s) + cp_skin().app.side_row * 2.5f32;   // under the title bar (layout/titlebar.coax)
  #assert coder_page_foreman_at(s, fx, fy);
  #assert !coder_page_foreman_at(s, fx, 5.0f32);
  #assert coder_page_pointer(s, fx, fy, 0);
  #assert coder_page_pointer(s, fx, fy, 2);
  #assert coder_page_action(s) == CP_ASK_FOREMAN;
  // Clearing busy on both Foreman and chats lets the page settle.
  coder_page_foreman(s, false, CP_FOREMAN_TIER_OBSERVE);
  coder_page_chats(s, "p1\tPinned\t0\t1\t0\nm1\tManaged task\t0\t0\t1\n");
  #assert !cp_side_busy(s) && s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE;
}

#test "cmd_hints renders shortcut keycap badges for foreman and first 9 sidebar chats without breaking hits" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "p1\tPinned 1\t0\t1\t0\np2\tPinned 2\t0\t1\t0\nr1\tRecent 1\nr2\tRecent 2\nr3\tRecent 3\nr4\tRecent 4\nr5\tRecent 5\nr6\tRecent 6\nr7\tRecent 7\nr8\tRecent 8\n");
  coder_page_foreman(s, false, CP_FOREMAN_TIER_OBSERVE);
  // Expand beyond the initial 5-chat page so all 10 chats are visible for the 1..9 badge check.
  s[0].sb[0].chat_limit = 10;
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 1200.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  sf0 := s[0].surface[0].front;
  base_u := s[0].surface[0].sheet[sf0].nu;
  base_o := s[0].surface[0].sheet[sf0].no;

  coder_page_cmd_hints(s, true);
  #assert s[0].cmd_hints;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 1, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 1200.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  sf1 := s[0].surface[0].front;
  // 10 badges total: ` for Foreman + 1..9 for the first 9 chats (10th chat has no shortcut).
  // Each badge adds 2 `over` prims (pill box + key text), plus 2 clip/unclip prims around the list.
  #assert s[0].surface[0].sheet[sf1].no == base_o + 22;
  // Badges are non-interactive overlays: clicking Foreman row still hits Foreman.
  fx := 40.0f32;
  fy := cp_bar(s) + cp_skin().app.side_row * 2.5f32;
  #assert coder_page_foreman_at(s, fx, fy);

  // Turning cmd_hints off immediately removes all shortcut badges.
  coder_page_cmd_hints(s, false);
  #assert !s[0].cmd_hints;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 2, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 1200.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  sf2 := s[0].surface[0].front;
  #assert s[0].surface[0].sheet[sf2].nu == base_u;
  #assert s[0].surface[0].sheet[sf2].no == base_o;
}

#test "gym sidebar icon sits in the footer bar, dispatches CP_ASK_GYM, and reports workbench rect" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  si := elt_find(t[..], "coder.me.settings");
  gi := elt_find(t[..], "coder.gym");
  #assert si >= 0 && gi >= 0;
  sb := el_box(t[0].rows[si]);
  gb := el_box(t[0].rows[gi]);
  #assert abs(gb.y - sb.y) < 0.01 && gb.x > sb.x && gb.w <= 32.0f32;
  gx := gb.x + 12.0f32;
  gy := gb.y + gb.h * 0.5f32;
  #assert coder_page_pointer(s, gx, gy, 0);
  #assert coder_page_pointer(s, gx, gy, 2);
  #assert coder_page_action(s) == CP_ASK_GYM;
  r: [4] f32;
  #assert !coder_page_gym_open(s) && !coder_page_gym_rect(s, r[..]);
  coder_page_gym_set(s, true);
  #assert coder_page_gym_open(s);
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert coder_page_gym_rect(s, r[..]) && r[0] > 100 && r[2] > 400 && r[3] > 300;
  coder_page_gym_set(s, false);
  #assert !coder_page_gym_open(s) && !coder_page_gym_rect(s, r[..]);
}

#test "antigravity chats use the Antigravity logo in the sidebar instead of the brain icon" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "a1\tAgy chat\t0\t0\t0\t0\t0\t0\t/repo\t1000\tmain\tagy\nc1\tClaude chat\t0\t0\t0\t0\t0\t0\t/repo\t900\tmain\tclaude\nx1\tCodex chat\t0\t0\t0\t0\t0\t0\t/repo\t800\tmain\tcodex\nf1\tForeman chat\t0\t0\t0\t0\t0\t0\t/repo\t700\tmain\tforeman\np1\tLocal chat\t0\t0\t0\t0\t0\t0\t/repo\t600\tmain\tpsionic\n");
  #assert s[0].nchats == 5;
  #assert s[0].chats[0].harness == ICON_ANTIGRAVITY && s[0].chats[0].harness != ICON_BRAIN;
  #assert s[0].chats[1].harness == ICON_CLAUDE;
  #assert s[0].chats[2].harness == ICON_OPENAI;
  #assert s[0].chats[3].harness == ICON_BOT;
  #assert s[0].chats[4].harness == ICON_PSIONIC;
  f: [1] UiFrame;
  #assert cp_test_draw_side(s, f[..]);
  sh := s[0].surface[0].sheet[s[0].surface[0].front];
  saw_agy := false;
  saw_brain := false;
  for i: 0..<sh.nu {
    if sh.under[i].kind == PRIM_ICON {
      if sh.under[i].id == ICON_ANTIGRAVITY_12 { saw_agy = true; }
      if sh.under[i].id == ICON_BRAIN { saw_brain = true; }
    }
  }
  #assert saw_agy && !saw_brain;
  #assert coder_page_icon_size(ICON_ANTIGRAVITY_12) == 12.0f32 && coder_page_icon_size(ICON_PSIONIC_12) == 12.0f32 && coder_page_icon_size(ICON_CLAUDE_12) == 12.0f32 && coder_page_icon_size(ICON_OPENAI_12) == 12.0f32 && coder_page_icon_size(ICON_BOT_12) == 12.0f32;
}
