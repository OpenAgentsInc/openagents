// What the page's checks share: a text search and two frames, the narrow one and one wide enough
// for the sidebar. Loaded by every checks/*.coax.
#load "../parts.coax";

// Where needle starts in text, -1 when it is not there (the checks' own).
cp_find :: (text: string, needle: string) -> int {
  i := 0;
  while i + needle.count <= text.count { if cast(string) text[i..<i + needle.count] == needle { return i; } i += 1; }
  return -1;
}
// A press and release in the middle of field `which`'s text (page/editor.coax), in units: whether the field took it.
cp_test_press_field :: (s: [] CoderPage, which: int) -> bool {
  c := s[0].fld[0].ed[which].body[..];
  if !(c[0].text_w > 0) { return false; }
  x := c[0].text_x + c[0].text_w / 2; y := c[0].text_y + c[0].view_h / 2;
  if !cp_ed_pointer(s, x, y, 0, 1, 0) { return false; }
  _ = cp_ed_pointer(s, x, y, 2, 1, 0);
  return true;
}
// a frame with the overlay over the page, as coder_page_frame paints it
cp_test_draw_over :: (s: [] CoderPage, f: [] UiFrame, dt: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, dt, false, false);
  cp_layout(s, f, 1200.0f32, 800.0f32);
  _ := cp_overlay(s, f, 1200.0f32, 800.0f32, dt);
  return uiframe_end(f, s[0].surface[..]);
}
// frames at w by h until nothing keyed moves (a sidebar or a pane has slid open or shut, #13773):
// how many it took, 60 at most
cp_test_settle :: (s: [] CoderPage, f: [] UiFrame, w: f32, h: f32) -> int {
  n := 0; moving := true;
  while moving && n < 60 {
    uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
    cp_layout(s, f, w, h);
    moving = uiframe_moving(f);
    _ := uiframe_end(f, s[0].surface[..]);
    n += 1;
  }
  return n;
}
// a frame wide enough for the sidebar
cp_test_draw_side :: (s: [] CoderPage, f: [] UiFrame) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f, 1200.0f32, 800.0f32);
  return uiframe_end(f, s[0].surface[..]);
}
// a frame wide enough for a pane beside the conversation, as Tier 3's 1440 by 900 window
cp_test_draw_wide :: (s: [] CoderPage, f: [] UiFrame) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f, 1440.0f32, 900.0f32);
  return uiframe_end(f, s[0].surface[..]);
}
cp_test_draw :: (s: [] CoderPage, f: [] UiFrame) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  s[0].think_at = 1 - s[0].think_at; s[0].think[s[0].think_at].n = 0; s[0].think[s[0].think_at].nb = 0; s[0].think[s[0].think_at].nr = 0; s[0].think[s[0].think_at].ni = 0; s[0].think[s[0].think_at].nlink = 0;
  cp_layout(s, f, 900.0f32, 2000.0f32);
  return uiframe_end(f, s[0].surface[..]);
}
