// Checks for the composer's Zeron layout (layout/conversation.coax's cp_composer, GitHub #13743):
// compact and expanded pills, the + and Send, the foot under the pill and how it folds, the
// context ring, and an empty chat's composer in the window's middle. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

// A frame w by h, the pointer at (px, py) when present.
cp_test_pill_frame :: (s: [] CoderPage, f: [] UiFrame, w: f32, h: f32, px: f32, py: f32, present: bool) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(px, py, present, false, "", ""), 0, 0.016, s[0].reduced, false);
  cp_layout(s, f, w, h);
  return uiframe_end(f, s[0].surface[..]);
}
cp_test_pill_rows :: (s: [] CoderPage) -> ElTable { return surface_rows(s[0].surface[..]); }
// A page with fonts and the keyboard; reduced motion, so a change of shape lands at once.
cp_test_composing :: (s: [] CoderPage) {
  cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  coder_page_env(s, true, true);
  coder_page_folder(s, "~/work/app");
}
// One message sent and its reply finished: the chat is no longer new.
cp_test_one_turn :: (s: [] CoderPage, f: [] UiFrame) {
  coder_page_ime_replace(s, -1, -1, "hi");
  #assert cp_test_pill_frame(s, f, 1200, 800, 0, 0, false) && coder_page_key(s, KEY_ENTER, 0) && s[0].nturns == 1;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"hello\"}") == MWW_ENDED && !cp_running(s);
}

#test "an empty chat: the expanded composer centred in the window without a heading, the foot under it, + opens the attach menu" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false) && cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  comp := elt_find(t[..], "coder.composer"); head := elt_find(t[..], "coder.empty"); model := elt_find(t[..], "coder.model"); folder := elt_find(t[..], "coder.folder");
  #assert comp >= 0 && head < 0 && model >= 0 && folder >= 0;
  #assert elt_value_of(t[..], elt_find(t[..], "coder.composer.shape")) == "expanded" && t[0].rows[comp].h == 123;   // 76 of text, 45 of controls, the border
  #assert t[0].rows[comp].y > 200 && t[0].rows[comp].y + t[0].rows[comp].h < 600;
  // T3 Code layout: model sits inside the composer's bottom row, folder sits in the quiet foot below
  #assert t[0].rows[model].y >= t[0].rows[comp].y && t[0].rows[model].y + t[0].rows[model].h <= t[0].rows[comp].y + t[0].rows[comp].h;
  #assert t[0].rows[folder].y >= t[0].rows[comp].y + t[0].rows[comp].h;
  #assert elt_find(t[..], "coder.backend") < 0 && elt_find(t[..], "coder.cost") < 0;
  add := elt_find(t[..], "coder.composer.add"); send := elt_find(t[..], "coder.composer.send");
  #assert add >= 0 && t[0].rows[add].w == 28 && t[0].rows[send].w == 32 && t[0].rows[add].x < t[0].rows[model].x && t[0].rows[model].x < t[0].rows[send].x;
  // bottom control row keeps comfortable horizontal (14pt inner) and bottom (12pt Send / 14pt chips) padding inside the card
  #assert abs((t[0].rows[add].x - t[0].rows[comp].x) - 15.0f32) < 0.01;
  #assert abs((t[0].rows[comp].y + t[0].rows[comp].h - (t[0].rows[add].y + t[0].rows[add].h)) - 15.0f32) < 0.01;
  #assert abs((t[0].rows[comp].x + t[0].rows[comp].w - (t[0].rows[send].x + t[0].rows[send].w)) - 15.0f32) < 0.01;
  #assert abs((t[0].rows[comp].y + t[0].rows[comp].h - (t[0].rows[send].y + t[0].rows[send].h)) - 13.0f32) < 0.01;
  #assert cp_press(s, add) && coder_page_action(s) == CP_ASK_ADD;
  // microphone dictation button sits beside Send (#13882)
  mic := elt_find(t[..], "coder.composer.mic");
  #assert mic >= 0 && t[0].rows[mic].w == 28 && t[0].rows[mic].x < t[0].rows[send].x;
  #assert cp_press(s, mic) && coder_page_action(s) == CP_ASK_VOICE_TOGGLE;
}
#test "a chat with messages stays in the 2-row expanded T3 composer card and grows smoothly for multi-line drafts" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s); cp_test_one_turn(s, f[..]);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  comp := elt_find(t[..], "coder.composer");
  #assert elt_value_of(t[..], elt_find(t[..], "coder.composer.shape")) == "expanded" && t[0].rows[comp].h == 123;
  // model is inside the card's bottom row, folder is in the foot under the card
  model := elt_find(t[..], "coder.model"); folder := elt_find(t[..], "coder.folder");
  #assert t[0].rows[model].y >= t[0].rows[comp].y && t[0].rows[model].y + t[0].rows[model].h <= t[0].rows[comp].y + t[0].rows[comp].h;
  #assert t[0].rows[folder].y >= t[0].rows[comp].y + t[0].rows[comp].h && t[0].rows[folder].y + t[0].rows[folder].h <= 800;
  // adding newlines expands the card taller, clearing returns to 123
  #assert coder_page_key(s, KEY_ENTER, MOD_SHIFT) && coder_page_key(s, KEY_ENTER, MOD_SHIFT) && coder_page_key(s, KEY_ENTER, MOD_SHIFT);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert elt_value_of(t[..], elt_find(t[..], "coder.composer.shape")) == "expanded" && t[0].rows[elt_find(t[..], "coder.composer")].h > 123;
  #assert coder_page_key(s, 97, MOD_CMD) && coder_page_key(s, KEY_BACKSPACE, 0);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert elt_value_of(t[..], elt_find(t[..], "coder.composer.shape")) == "expanded" && t[0].rows[elt_find(t[..], "coder.composer")].h == 123;
}
// A chat with one finished message, a branch, a paused goal and the last model call's counts
// (cp_ctx_take reads them from a worker's attempt line).
cp_test_footed :: (s: [] CoderPage, f: [] UiFrame) {
  cp_test_composing(s); cp_test_one_turn(s, f);
  coder_page_branch(s, "main");
  s[0].goal_status = CP_GOAL_PAUSED; s[0].goal_objective_n = cp_out(s[0].goal_objective[..], "ship the composer");
  s[0].ctx_in = 52000; s[0].ctx_cached = 40000; s[0].ctx_out = 428; s[0].ctx_window = 1048576;
}
#test "the home screen's foot keeps the backend inside the model dropdown only, puts the working folder on the right, and never truncates the model chip from fractional glyph widths; once the chat has a turn it shows the cost" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s);
  coder_page_set_agy(s, true); coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert coder_page_pick_model(s, "agy") && cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  model := elt_find(t[..], "coder.model"); folder := elt_find(t[..], "coder.folder");
  #assert model >= 0 && folder >= 0 && elt_find(t[..], "coder.backend") < 0 && elt_find(t[..], "coder.cost") < 0;
  // model inside the composer's bottom row, working folder flush to the right side of the composer's foot
  comp := elt_find(t[..], "coder.composer");
  #assert t[0].rows[model].y >= t[0].rows[comp].y && t[0].rows[model].y + t[0].rows[model].h <= t[0].rows[comp].y + t[0].rows[comp].h;
  #assert abs(t[0].rows[folder].x + t[0].rows[folder].w - (t[0].rows[comp].x + t[0].rows[comp].w - cast(f32) CP_FOOT_SIDE)) < 0.01;
  // working-folder chip under the composer draws its folder icon via the 11pt atlas slot ICON_FOLDER_11
  sh_f := surface_sheet(s[0].surface[..]);
  saw_small_folder := false;
  for qi: 0..<sh_f.nu {
    p_ic := sh_f.under[qi];
    if p_ic.kind == PRIM_ICON && p_ic.id == ICON_FOLDER_11 && p_ic.x >= t[0].rows[folder].x && p_ic.x <= t[0].rows[folder].x + t[0].rows[folder].w && p_ic.y >= t[0].rows[folder].y && p_ic.y <= t[0].rows[folder].y + t[0].rows[folder].h {
      #assert p_ic.w == CP_FOOT_FOLDER_ICON && p_ic.h == CP_FOOT_FOLDER_ICON;
      saw_small_folder = true;
    }
  }
  #assert saw_small_folder && coder_page_icon_size(ICON_FOLDER_11) == 11.0f32;
  // "Antigravity CLI" only appears when the model dropdown is opened
  sh0 := surface_sheet(s[0].surface[..]);
  for qi: 0..<sh0.no { #assert sh0.over[qi].kind != PRIM_TEXT || cp_find(sh0.over[qi].text, "Antigravity CLI") < 0; }
  #assert cp_press(s, model) && s[0].model_menu && cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  agy_id_b: [32] u8; agy_n := el_put(agy_id_b[..], 0, "coder.model."); agy_n = el_put_i(agy_id_b[..], agy_n, cp_agy_idx(s));
  agy_opt := elt_find(t[..], cast(string) agy_id_b[0..<agy_n]);
  #assert agy_opt >= 0 && cp_find(elt_value_of(t[..], agy_opt), "Antigravity CLI") >= 0;
  s[0].model_menu = false;
  // fractional glyph advances in a proportional font must not truncate "Antigravity" into "Antigravi…"
  fa: [1] Atlas; k := cp_skin();
  for g: 0..<GP_GLYPHS { fa[0].fonts[k.small.face].advance[g] = 6.73f32; fa[0].fonts[k.label.face].advance[g] = 7.31f32; }
  fa[0].ready = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(fa[..]), k, uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], 1200, 800);
  #assert uiframe_end(f[..], s[0].surface[..]);
  sh := surface_sheet(s[0].surface[..]);
  saw_full := false;
  for qi: 0..<sh.no {
    if sh.over[qi].kind == PRIM_TEXT {
      #assert sh.over[qi].text != "Antigravi…";
      if sh.over[qi].text == "Antigravity" { saw_full = true; }
    }
  }
  #assert saw_full;
  // one message sent: the cost and budget come back on the right, before the working folder
  cp_test_one_turn(s, f[..]);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  cost := elt_find(t[..], "coder.cost"); folder = elt_find(t[..], "coder.folder"); model = elt_find(t[..], "coder.model");
  #assert elt_find(t[..], "coder.backend") < 0 && cost >= 0 && elt_value_of(t[..], cost) == "$0.00 / $50.00";
  #assert t[0].rows[cost].x < t[0].rows[folder].x;
}
#test "the foot: goal, cost, context ring and folder › branch on the right, model inside the composer" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_footed(s, f[..]);
  #assert cp_ctx_share(s) > 0.04 && cp_ctx_share(s) < 0.06;
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  model := elt_find(t[..], "coder.model"); goal := elt_find(t[..], "coder.goal"); cost := elt_find(t[..], "coder.cost");
  ring := elt_find(t[..], "coder.context"); folder := elt_find(t[..], "coder.folder");
  #assert model >= 0 && goal >= 0 && cost >= 0 && ring >= 0 && folder >= 0;
  #assert elt_value_of(t[..], folder) == "~/work/app › main";
  #assert t[0].rows[goal].x < t[0].rows[cost].x && t[0].rows[cost].x < t[0].rows[ring].x && t[0].rows[ring].x < t[0].rows[folder].x;
  #assert elt_find(t[..], "coder.context.card") < 0;
}
#test "the context ring, hovered, shows the last call's tokens in a card over it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_footed(s, f[..]);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  ring := elt_find(t[..], "coder.context");
  rx := t[0].rows[ring].x + t[0].rows[ring].w / 2; ry := t[0].rows[ring].y + t[0].rows[ring].h / 2;
  #assert cp_test_pill_frame(s, f[..], 1200, 800, rx, ry, true);
  t[0] = cp_test_pill_rows(s);
  card := elt_find(t[..], "coder.context.card");
  #assert card >= 0;
  #assert elt_label(t[..], card) == "52.4K of 1.05M tokens · 5%";
  #assert elt_value_of(t[..], card) == "Input 52K · Cached 40K · Output 428";
  #assert t[0].rows[card].y + t[0].rows[card].h <= t[0].rows[ring].y;
}
#test "a narrow foot folds the goal first, then the cost, the context and the branch" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_footed(s, f[..]);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  gap := cp_skin().app.gap_small;
  wf := t[0].rows[elt_find(t[..], "coder.folder")].w; wm := t[0].rows[elt_find(t[..], "coder.model")].w;
  wr := t[0].rows[elt_find(t[..], "coder.context")].w; wc := t[0].rows[elt_find(t[..], "coder.cost")].w; wg := t[0].rows[elt_find(t[..], "coder.goal")].w;
  we := t[0].rows[elt_find(t[..], "coder.effort")].w;   // the effort chip beside the model, kept whole
  // the window's width for a column whose foot has `room` (its sides are 8 each)
  #assert cp_test_pill_frame(s, f[..], 400, 800, 0, 0, false);
  edge := 400 - s[0].col_w + 2 * cast(f32) CP_FOOT_SIDE;
  all := wf + wr + wc + wg + 4 * gap;
  _ = wm; _ = we;
  #assert cp_test_pill_frame(s, f[..], edge + all, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s); #assert elt_find(t[..], "coder.goal") >= 0;
  #assert cp_test_pill_frame(s, f[..], edge + all - 1, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s); #assert elt_find(t[..], "coder.goal") < 0 && elt_find(t[..], "coder.cost") >= 0;
  #assert cp_test_pill_frame(s, f[..], edge + all - wg - gap - 1, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s); #assert elt_find(t[..], "coder.cost") < 0 && elt_find(t[..], "coder.context") >= 0;
  #assert cp_test_pill_frame(s, f[..], edge + all - wg - wc - 2 * gap - 1, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s); #assert elt_find(t[..], "coder.context") < 0;
  #assert elt_value_of(t[..], elt_find(t[..], "coder.folder")) == "~/work/app › main";
  #assert cp_test_pill_frame(s, f[..], edge + all - wg - wc - wr - 3 * gap - 1, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s); #assert elt_value_of(t[..], elt_find(t[..], "coder.folder")) == "~/work/app";
}
#test "the context's counts are kept with the chat and cleared by a new one; a token count is short" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s); cp_test_one_turn(s, f[..]);
  s[0].ctx_in = 1200; s[0].ctx_cached = 800; s[0].ctx_out = 90; s[0].ctx_window = 1048576;
  kept: [16384] u8; kn := coder_page_save(s, kept[..]); #assert kn > 0;
  #assert cp_new(s) && s[0].ctx_in == 0 && s[0].ctx_window == 0;
  #assert coder_page_load(s, cast(string) kept[0..<kn]) && s[0].ctx_in == 1200 && s[0].ctx_cached == 800 && s[0].ctx_out == 90 && s[0].ctx_window == 1048576;
  b: [24] u8;
  #assert cp_tokens(b[..], 950) == "950" && cp_tokens(b[..], 12345) == "12.3K" && cp_tokens(b[..], 52000) == "52K" && cp_tokens(b[..], 128000) == "128K";
  #assert cp_tokens(b[..], 1048576) == "1.05M" && cp_tokens(b[..], 2000000) == "2M" && cp_tokens(b[..], 1500000) == "1.5M";
}

#test "the foot's effort chip beside the model: click opens the 3-option menu, Shift+Tab cycles levels, the task line names it, the chat keeps it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s);
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "agy") && cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  model := elt_find(t[..], "coder.model"); eff := elt_find(t[..], "coder.effort");
  #assert eff >= 0 && elt_value_of(t[..], eff) == "High";
  // right of the model chip, on the same line
  #assert t[0].rows[eff].x > t[0].rows[model].x + t[0].rows[model].w - 0.01 && abs(t[0].rows[eff].y - t[0].rows[model].y) < 0.01;
  // the effort set in Settings is Antigravity's default
  coder_page_settings_agy(s, "Installed", 0, "Default · medium", "Isolated profile");
  #assert cp_effort_label(s, cp_model_index(s)) == "Medium";
  coder_page_settings_agy(s, "Installed", 0, "Default", "Isolated profile");
  #assert cp_effort_label(s, cp_model_index(s)) == "High";
  // clicking the effort chip opens the dropdown menu with Low, Medium, High (does not cycle directly)
  #assert !s[0].effort_menu && cp_press(s, eff) && s[0].effort_menu && s[0].effort == CP_EFFORT_DEFAULT;
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert elt_find(t[..], "coder.effort.menu") >= 0;
  o1 := elt_find(t[..], "coder.effort.1"); o2 := elt_find(t[..], "coder.effort.2"); o3 := elt_find(t[..], "coder.effort.3");
  #assert o1 >= 0 && o2 >= 0 && o3 >= 0 && elt_find(t[..], "coder.effort.4") < 0;
  // Escape closes the effort menu without changing level
  #assert coder_page_key(s, KEY_ESCAPE, 0) && !s[0].effort_menu && s[0].effort == CP_EFFORT_DEFAULT;
  // re-open menu and pick High (option 3)
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert cp_press(s, elt_find(t[..], "coder.effort")) && s[0].effort_menu && cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert cp_press(s, elt_find(t[..], "coder.effort.3")) && !s[0].effort_menu && s[0].effort == CP_EFFORT_HIGH;
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert elt_value_of(t[..], elt_find(t[..], "coder.effort")) == "High";
  // Shift+Tab cycles High -> Low -> Medium -> High
  #assert coder_page_key(s, -15, MOD_SHIFT) && s[0].effort == CP_EFFORT_LOW && cp_effort_label(s, cp_model_index(s)) == "Low";
  #assert coder_page_key(s, -15, MOD_SHIFT) && s[0].effort == CP_EFFORT_MEDIUM && cp_effort_label(s, cp_model_index(s)) == "Medium";
  #assert coder_page_key(s, -15, MOD_SHIFT) && s[0].effort == CP_EFFORT_HIGH && cp_effort_label(s, cp_model_index(s)) == "High";
  #assert coder_page_key(s, -15, MOD_SHIFT) && s[0].effort == CP_EFFORT_LOW && cp_effort_label(s, cp_model_index(s)) == "Low";
  // the task line names the picked effort
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "fix it") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "antigravity" && back[0].effort == "low";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  // kept with the chat, and read back
  #assert coder_page_save_due(s);
  sb: [65536] u8; sn := coder_page_save(s, sb[..]);
  #assert sn > 0 && cp_find(cast(string) sb[0..<sn], "\"effort\":\"low\"") >= 0;
  q: [1] CoderPage; q_st: [1] CpCheckStore; r := cp_check_page(q[..], q_st[..]); cp_init(r); coder_page_set_agy(r, true);
  #assert coder_page_load(r, cast(string) sb[0..<sn]) && r[0].effort == CP_EFFORT_LOW && !coder_page_save_due(r);
  // a change of effort alone is a change to keep
  cp_effort_cycle(r); #assert coder_page_save_due(r);
  // a new chat starts at the default; Microcoder's default is Low, Inkling's default is Medium
  #assert cp_new(s) && s[0].effort == CP_EFFORT_DEFAULT;
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_effort_label(s, cp_model_index(s)) == "Low";
  #assert cp_task_effort(s, cp_model_index(s)) == "low";
  coder_page_set_inkling(s, true);
  #assert coder_page_pick_model(s, "inkling-2-mini") && cp_effort_label(s, cp_model_index(s)) == "Medium";
  #assert cp_task_effort(s, cp_model_index(s)) == "medium";
  s[0].effort = CP_EFFORT_HIGH; #assert cp_task_effort(s, cp_model_index(s)) == "high";
}

#test "new chat composer foot shows New worktree checkbox defaulting to false, persisting across new chats until unchecked, and hiding after send" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s);
  #assert !coder_page_worktree(s);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  comp := elt_find(t[..], "coder.composer");
  wt := elt_find(t[..], "coder.worktree");
  folder := elt_find(t[..], "coder.folder");
  #assert wt >= 0 && t[0].rows[wt].role == EL_TOGGLE && elt_has(t[..], wt, EL_S_CHECKS) && !elt_has(t[..], wt, EL_S_CHECKED);
  #assert elt_value_of(t[..], wt) == "off";
  // Sits under the input bar on the left, left of the working folder chip on the right.
  #assert t[0].rows[wt].y >= t[0].rows[comp].y + t[0].rows[comp].h;
  #assert t[0].rows[wt].x + t[0].rows[wt].w < t[0].rows[folder].x;
  // Clicking toggles ON and asks the host to persist it.
  #assert cp_press(s, wt) && coder_page_worktree(s) && coder_page_action(s) == CP_ASK_WORKTREE_TOGGLE;
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  wt = elt_find(t[..], "coder.worktree");
  #assert wt >= 0 && elt_has(t[..], wt, EL_S_CHECKED) && elt_value_of(t[..], wt) == "on";
  // Sending a turn hides the new-chat checkbox; starting a new chat keeps the checked sticky default.
  cp_test_one_turn(s, f[..]);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  #assert elt_find(t[..], "coder.worktree") < 0;
  #assert cp_new(s) && coder_page_worktree(s);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t[0] = cp_test_pill_rows(s);
  wt = elt_find(t[..], "coder.worktree");
  #assert wt >= 0 && elt_has(t[..], wt, EL_S_CHECKED) && elt_value_of(t[..], wt) == "on";
  // Clicking again toggles OFF and stays OFF for subsequent new chats.
  #assert cp_press(s, wt) && !coder_page_worktree(s) && coder_page_action(s) == CP_ASK_WORKTREE_TOGGLE;
  #assert cp_new(s) && !coder_page_worktree(s);
}

#test "monochrome stop button keeps dark stop square inside light circle so gpu_monochrome never blanks it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_test_composing(s);
  #assert coder_page_set_text(s, "run") && coder_page_submit(s);
  #assert cp_test_pill_frame(s, f[..], 1200, 800, 0, 0, false);
  t := [1] ElTable.[cp_test_pill_rows(s)];
  send_i := elt_find(t[..], "coder.composer.send");
  #assert send_i >= 0;
  sr := t[0].rows[send_i];
  sh := surface_sheet(s[0].surface[..]);
  saw_circle := false; saw_square := false;
  sq := cp_skin().cmp.stop;
  for qi: 0..<sh.nu {
    q := sh.under[qi];
    if q.kind != PRIM_BOX { continue; }
    if abs(q.x - sr.x) < 1.0f32 && abs(q.y - sr.y) < 1.0f32 && abs(q.w - sr.w) < 1.0f32 {
      #assert q.fill.r > 0.8f32;
      saw_circle = true;
    } else if abs(q.w - sq) < 1.0f32 && abs(q.h - sq) < 1.0f32 && q.x > sr.x && q.x + q.w < sr.x + sr.w && q.y > sr.y && q.y + q.h < sr.y + sr.h {
      #assert q.fill.r < 0.2f32 && q.fill.g < 0.2f32 && q.fill.b < 0.2f32;
      saw_square = true;
    }
  }
  #assert saw_circle && saw_square;
}
