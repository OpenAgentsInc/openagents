// Checks for the file in the pane (filepane.coax, GitHub #13760): it opens, an edit makes it
// Edited, Save asks the host and the saved text clears it, Close asks the host and the pane goes,
// a file the host could not read says why, and a long one is shown read-only. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

cp_fp_test_find :: (s: [] CoderPage, id: string) -> int { return surface_find(s[0].surface[..], id); }
cp_fp_test_label :: (s: [] CoderPage, id: string) -> string {
  r := cp_fp_test_find(s, id);
  if r < 0 { return ""; }
  t := surface_rows(s[0].surface[..]);
  return cast(string) t.rows[r].label[0..<t.rows[r].label_n];
}
cp_fp_test_press :: (s: [] CoderPage, id: string) -> bool { r := cp_fp_test_find(s, id); return r >= 0 && cp_press(s, r); }
// A page with fonts, the view holding the keyboard, one frame drawn.
cp_fp_test_page :: (s: [] CoderPage, f: [] UiFrame) {
  cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  coder_page_env(s, true, false);
  #assert cp_test_draw_side(s, f);
}

#test "a file opens viewer-first in the pane with its name, path, numbered lines, and toggles to Edit mode" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  b: [256] u8; src := "main :: () {\n  print(\"hi\");\n}\n";
  #assert coder_page_file_open(s, "~/work/app/main.coax", b[0..<cp_out(b[..], src)], src.count);
  // Viewer-first default (#13992): opens read-only without stealing composer focus
  #assert coder_page_file_mode(s) == CP_FP_READ && coder_page_file_shown(s) && !coder_page_file_dirty(s);
  #assert cp_ed_which(s) == CP_ED_COMPOSER;
  #assert cp_test_draw_side(s, f[..]) && s[0].pane_w > 0;
  #assert cp_fp_test_label(s, "coder.file.close.tab") == "main.coax";
  #assert cp_fp_test_label(s, "coder.file.path") == "~/work/app/main.coax";
  #assert cp_fp_test_find(s, "coder.file.body") >= 0 && cp_fp_test_find(s, "coder.ft.editors") >= 0;
  #assert cp_fp_test_find(s, "coder.file.expand") >= 0 && cp_fp_test_find(s, "coder.file.hide") >= 0 && cp_fp_test_find(s, "coder.file.add") >= 0;
  #assert cp_fp_test_find(s, "coder.file.reload") >= 0 && cp_fp_test_find(s, "coder.file.wrap") >= 0;
  // Open in Default App and Edit File live inside the ⋮ More menu
  #assert cp_fp_test_press(s, "coder.ft.editors") && cp_test_draw_side(s, f[..]);
  #assert cp_fp_test_find(s, "coder.file.external") >= 0 && cp_fp_test_find(s, "coder.file.edit_toggle") >= 0;
  // Toggle into Edit File mode -> UiEditor holds the file's four lines
  #assert cp_fp_test_press(s, "coder.file.edit_toggle") && coder_page_file_mode(s) == CP_FP_EDIT;
  #assert cp_test_draw_side(s, f[..]);
  #assert cp_fp_test_find(s, "coder.file.save") < 0;
  e := s[0].fld[0].ed[CP_ED_FILE..<CP_ED_FILE + 1];
  #assert ue_value(e) == src && e[0].body[0].lines == 4;
  name: [64] u8; #assert cast(string) name[0..<coder_page_file_name(s, name[..])] == "main.coax";
}

#test "an edit makes the file Edited with Save; Save asks the host and the saved text clears it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  b: [256] u8; src := "one\ntwo\n";
  #assert coder_page_file_open(s, "~/notes.txt", b[0..<cp_out(b[..], src)], src.count);
  #assert coder_page_file_set_edit(s, true) && cp_test_draw_side(s, f[..]);
  _ = coder_page_action(s);
  // a press in its text gives it the keyboard; the host is asked to keep the keyboard on the view
  #assert cp_test_press_field(s, CP_ED_FILE) && s[0].fld[0].kb == CP_KB_FILE && coder_page_action(s) == CP_ASK_FILE_FOCUS;
  #assert coder_page_wants_text(s) && cp_ed_which(s) == CP_ED_FILE;
  // typing, Return and Tab go into the file
  #assert coder_page_paste(s, "zero");
  #assert coder_page_key(s, KEY_ENTER, 0) && coder_page_key(s, -15, 0);
  #assert coder_page_file_dirty(s) && cp_find(cp_fp_text(s), "zero\n  ") >= 0 && s[0].nturns == 0;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_label(s, "coder.file.state") == "Edited" && cp_fp_test_find(s, "coder.file.save") >= 0;
  // what the host is handed to save is what the editor holds
  out: [64] u8; edited := cast(string) out[0..<coder_page_file_text(s, out[..])];
  #assert edited == cp_fp_text(s) && edited != src;
  // Save asks the host; the host writes what the editor holds and hands back the bytes it wrote
  #assert cp_fp_test_press(s, "coder.file.save") && coder_page_action(s) == CP_ASK_FILE_SAVE;
  kept: [64] u8; n := cp_out(kept[..], edited);
  coder_page_file_saved(s, kept[0..<n]);
  #assert !coder_page_file_dirty(s) && cp_test_draw_side(s, f[..]) && cp_fp_test_label(s, "coder.file.state") == "Saved" && cp_fp_test_find(s, "coder.file.save") < 0;
  // a save that fails says why, and the changes stay
  #assert coder_page_paste(s, "!") && coder_page_file_dirty(s);
  coder_page_file_save_failed(s, "Coder couldn't save notes.txt: the disk is full.");
  #assert coder_page_file_dirty(s) && cp_test_draw_side(s, f[..]) && cp_find(cp_fp_test_label(s, "coder.file.error"), "disk is full") >= 0;
  #assert cp_fp_test_label(s, "coder.file.state") == "Edited";
}

#test "Close asks the host, and the closed pane gives the window and the keyboard back" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  b: [256] u8; src := "x\n";
  #assert coder_page_file_open(s, "~/a.coax", b[0..<cp_out(b[..], src)], src.count) && coder_page_file_set_edit(s, true) && cp_test_draw_side(s, f[..]);
  #assert cp_test_press_field(s, CP_ED_FILE) && s[0].fld[0].kb == CP_KB_FILE;
  _ = coder_page_action(s);
  // the tab's Close asks the host (it asks first when there are changes)
  #assert cp_fp_test_press(s, "coder.file.close") && coder_page_action(s) == CP_ASK_FILE_CLOSE && s[0].fp[0].open;
  coder_page_file_close(s);
  #assert !s[0].fp[0].open && coder_page_file_mode(s) == CP_FP_NONE && s[0].fld[0].kb == CP_KB_COMPOSER;
  // the pane slides shut (#13773): its content is gone at once, its room once it has slid
  #assert cp_test_draw_side(s, f[..]) && s[0].pane_w > 0 && cp_fp_test_find(s, "coder.file.body") < 0;
  #assert cp_test_settle(s, f[..], 1200.0f32, 800.0f32) <= 16 && s[0].pane_w == 0;
  #assert cp_ed_which(s) == CP_ED_COMPOSER;
}

#test "a file the host could not read says why, with nothing to edit or save" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  coder_page_file_failed(s, "~/pic.bin", "pic.bin isn't text, so Coder can't show it here.");
  #assert coder_page_file_mode(s) == CP_FP_FAILED && coder_page_file_shown(s);
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_label(s, "coder.file.close.tab") == "pic.bin";
  #assert cp_find(cp_fp_test_label(s, "coder.file.error"), "isn't text") >= 0;
  #assert cp_fp_test_find(s, "coder.file.body") < 0 && cp_fp_test_find(s, "coder.file.save") < 0 && cp_fp_test_find(s, "coder.ft.editors") >= 0;
  #assert cp_fp_test_press(s, "coder.ft.editors") && cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.external") >= 0;
  #assert cp_fp_test_press(s, "coder.ft.editors") && cp_test_draw_side(s, f[..]);
  out: [16] u8; #assert coder_page_file_text(s, out[..]) == -1;
  // a press where its text would be gives it no keyboard
  #assert !cp_test_press_field(s, CP_ED_FILE) && cp_ed_which(s) == CP_ED_COMPOSER;
}

#test "a file past the editor's size is shown read-only, says so, and scrolls" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  big: [CP_FP_EDIT_MOST + 4000] u8; n := 0;
  while n + 40 < big.count { n = el_put(big[..], n, "a line of the long file, to be numbered\n"); }
  #assert coder_page_file_open(s, "~/long.txt", big[0..<n], n) && coder_page_file_mode(s) == CP_FP_READ;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_label(s, "coder.file.state") == "Read-only";
  #assert cp_find(cp_fp_test_label(s, "coder.file.readonly"), "up to 128 KB") >= 0;
  #assert s[0].fp[0].content > s[0].fp[0].view && s[0].fp[0].view > 0;
  // the wheel over the pane moves its text, not the conversation's
  s[0].px = s[0].pane_x + 40; s[0].py = 400;
  coder_page_wheel(s, 300);
  #assert s[0].fp[0].scroll == 300 && s[0].scroll == 0;
  out: [16] u8; #assert coder_page_file_text(s, out[..]) == -1;
}

#test "the review comes forward over the file, and the file comes back when it closes" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  #assert coder_page_set_text(s, "update foo") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"edit src/foo.coax\",\"exit\":0,\"timed_out\":false,\"output\":\"@@ -1,1 +1,1 @@\\n-old\\n+new\\n\"}") == MWW_COMMAND;
  b: [256] u8; src := "new\n";
  #assert coder_page_file_open(s, "~/src/foo.coax", b[0..<cp_out(b[..], src)], src.count) && cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.body") >= 0;
  // Review shows the changes; the file stays open behind them
  #assert cp_fp_test_press(s, "coder.review") && s[0].review && !cp_fp_shown(s) && s[0].fp[0].open;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.review.head") >= 0 && cp_fp_test_find(s, "coder.file.body") < 0;
  // closing the review shows the file again
  #assert cp_fp_test_press(s, "coder.pane.close") && !s[0].review && cp_fp_shown(s);
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.body") >= 0;
}

#test "a 3D scene file opens in CP_FP_SCENE mode and reports its body rect while shown" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  #assert coder_page_file_open_scene(s, "~/fixtures/hall.ple-scene.json");
  #assert coder_page_file_mode(s) == CP_FP_SCENE && coder_page_file_shown(s);
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_label(s, "coder.file.state") == "3D Scene";
  r: [4] f32;
  #assert coder_page_file_scene_rect(s, r[..]) && r[2] > 100 && r[3] > 100;
  coder_page_file_close(s);
  #assert !coder_page_file_scene_rect(s, r[..]) && coder_page_file_mode(s) == CP_FP_NONE;
}

#test "right-pane file viewer: unified tabs, breadcrumbs, Expand/Restore, Hide preserving tabs, Reload, Wrap, and Copy Path (#13992)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  b: [512] u8;
  src := "#include <stdint.h>\nstatic uint64_t fnv1a(const char *s, size_t n) {\n  uint64_t h = 14695981039346656037ull;\n  return h ? h : 1;\n}\n";
  path := "/Users/christopherdavid/work/openagents/psionic/platform/inkling-gguf.c";
  #assert coder_page_file_open(s, path, b[0..<cp_out(b[..], src)], src.count);
  #assert cp_test_draw_side(s, f[..]);

  // Full path export + breadcrumb directory segments + final filename path element
  pout: [256] u8;
  #assert cast(string) pout[0..<coder_page_file_path(s, pout[..])] == path;
  #assert cp_find(cp_fp_test_label(s, "coder.file.path"), "/Users/christopherdavid/work/openagents/psionic/platform") >= 0;
  #assert cp_fp_test_find(s, "coder.ft.crumb.5") >= 0;   // "platform" breadcrumb segment

  // Expand (⛶) widens right pane to full main area beside sidebar, then restores split width
  split_w := s[0].pane_w;
  #assert !coder_page_file_expanded(s) && split_w > 300.0f32 && split_w < 700.0f32;
  #assert cp_fp_test_press(s, "coder.file.expand") && coder_page_file_expanded(s);
  #assert cp_test_draw_side(s, f[..]) && s[0].pane_w > split_w + 150.0f32 && s[0].col_w == 0;
  #assert cp_fp_test_press(s, "coder.file.expand") && !coder_page_file_expanded(s);
  #assert cp_test_draw_side(s, f[..]) && s[0].pane_w == split_w && s[0].col_w > 0;

  // Hide (◫) hides the pane without losing open file or tab; center toggle restores it intact
  #assert cp_fp_test_press(s, "coder.file.hide") && coder_page_file_hidden(s) && !coder_page_file_shown(s);
  #assert s[0].fp[0].open && s[0].ft[0].ntabs == 1;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.body") < 0;
  #assert cp_fp_test_press(s, "coder.ft.toggle") && !coder_page_file_hidden(s) && coder_page_file_shown(s);
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.body") >= 0;

  // Word wrap toggle (≡), Reload (↻), Copy Path, and '+' Quick Open palette in Files mode
  was_wrap := s[0].fp[0].wrap;
  #assert cp_fp_test_press(s, "coder.file.wrap") && s[0].fp[0].wrap != was_wrap;
  #assert cp_fp_test_press(s, "coder.file.reload") && coder_page_action(s) == CP_ASK_FILE_RELOAD;
  #assert cp_fp_test_press(s, "coder.file.path") && coder_page_action(s) == CP_ASK_FILE_COPY_PATH;
  #assert cp_fp_test_press(s, "coder.file.add") && coder_page_action(s) == CP_ASK_PALETTE;
  #assert coder_page_palette_open(s) && coder_page_palette_mode(s) == CP_PAL_MODE_FILES && coder_page_palette_command(s) == 19;
}

#test "right-pane file viewer preserves RGB syntax & language badge colors under monochrome GPU pass (#13992)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; test_atlas(s[0].atlas[..]);
  coder_page_env(s, true, false);
  // Default T3 Dark is monochrome
  #assert cp_cust_is_monochrome(s);
  b: [256] u8;
  src := "static uint64_t fnv1a(const char *s, size_t n) {\n  return 14695981039346656037ull;\n}\n";
  #assert coder_page_file_open(s, "/Users/dev/openagents/psionic/platform/inkling-gguf.c", b[0..<cp_out(b[..], src)], src.count);

  // File viewer primitives preserve RGB syntax & badge colors while monochrome applies outside
  vbuf: [524288] f32;
  nv := coder_page_frame(s, vbuf[..], 1280.0f32, 800.0f32, 1.0f32, 0.016f32);
  #assert nv > 0;
  v_colored := 0;
  for i: 0..<nv {
    o := i * GP_VERTEX_FLOATS;
    r := vbuf[o + 12]; g := vbuf[o + 13]; bl := vbuf[o + 14]; a := vbuf[o + 15];
    if a > 0.1f32 && (abs(r - g) > 0.05f32 || abs(g - bl) > 0.05f32) { v_colored += 1; }
  }
  #assert v_colored >= 60;
}

#test "file viewer Phase 2 & 3: 4 MB cap, code folding, GPU selection/copy, per-tab state, jump, find, disk reload, breadcrumbs (#13992)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  #assert coder_page_file_most() == 4194304;

  // Multi-function C file with long lines and brace blocks for folding, hscroll, selection, find, and jump
  b: [2048] u8;
  src := "#include <stdint.h>\nstatic uint64_t fnv1a(const char *s, size_t n) {\n  uint64_t h = 14695981039346656037ull;\n  for (size_t i = 0; i < n; i++) {\n    h ^= (uint8_t)s[i];\n  }\n  return h ? h : 1;\n}\nstatic int alpha(void) {\n  int very_long_identifier_name_that_certainly_exceeds_even_a_wide_split_pane_viewport_width_for_testing_horizontal_scrolling_and_rails_properly = 42;\n  return very_long_identifier_name_that_certainly_exceeds_even_a_wide_split_pane_viewport_width_for_testing_horizontal_scrolling_and_rails_properly;\n}\n";
  path := "/Users/dev/openagents/psionic/platform/inkling-gguf.c";
  #assert coder_page_file_open(s, path, b[0..<cp_out(b[..], src)], src.count);
  #assert coder_page_file_mode(s) == CP_FP_READ;
  #assert s[0].fp[0].nlines >= 12 && s[0].fp[0].nfolds >= 3;
  #assert cp_test_draw_side(s, f[..]);

  // Structural folding: click fold 0 chevron collapses block; jump to inner line auto-unfolds it & highlights target range
  full_content := s[0].fp[0].content;
  #assert cp_fp_test_find(s, "coder.fp.fold.0") >= 0;
  #assert cp_fp_test_press(s, "coder.fp.fold.0") && cp_fp_fold_is_closed(s[0].fp[..], 0);
  #assert cp_test_draw_side(s, f[..]) && s[0].fp[0].content < full_content;
  coder_page_file_jump(s, 5, 6);
  #assert !cp_fp_fold_is_closed(s[0].fp[..], 0) && s[0].fp[0].hl_start == 5 && s[0].fp[0].hl_end == 6;

  // GPU text selection (CP_SEL_FILE): Cmd+A selects all file lines, Cmd+C copies code, sel_file_lines reports 1-based range
  s[0].px = s[0].pane_x + 40.0f32; s[0].py = 200.0f32;
  #assert cp_test_draw_side(s, f[..]);
  #assert cp_sel_select_all(s) && s[0].sel[0].region == CP_SEL_FILE && coder_page_has_selection(s);
  copied: [2048] u8;
  cn := coder_page_copy(s, false, copied[..]);
  #assert cn > 100 && cp_find(cast(string) copied[0..<cn], "fnv1a") >= 0;
  lr: [2] int;
  #assert coder_page_sel_file_lines(s, lr[..]) && lr[0] == 1 && lr[1] >= 10;
  cp_sel_clear(s);

  // Horizontal scroll when wrap is off (draw using test_atlas pixel metrics so long line exceeds viewport width)
  #assert !s[0].fp[0].wrap;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(s[0].atlas[..]), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 1200.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  s[0].px = s[0].pane_x + 40.0f32;
  coder_page_scroll_x(s, -60.0f32, true);
  #assert s[0].fp[0].scroll_x > 0.0f32;

  // In-file Find (Cmd+F) and Go to Line (Ctrl+G)
  coder_page_file_find_open(s);
  #assert coder_page_find_is_open(s) && s[0].find[0].file_mode && !s[0].find[0].goto_mode;
  coder_page_find_set_query(s, "return");
  #assert coder_page_find_count(s) == 2 && s[0].fp[0].hl_start == 7;
  #assert coder_page_find_step(s, 1) && s[0].fp[0].hl_start == 11;
  coder_page_find_close(s);
  #assert !coder_page_find_is_open(s);
  coder_page_file_goto_open(s);
  coder_page_find_set_query(s, "9");
  #assert coder_page_find_step(s, 1) && s[0].fp[0].hl_start == 9 && !coder_page_find_is_open(s);

  // Per-tab state preservation (scroll, fold, wrap) across tab switch + live reload preserving scroll/folds
  #assert cp_fp_fold_toggle(s, 0);
  s[0].fp[0].scroll = 36.0f32;
  b2: [128] u8; src2 := "# Title\n\n- item one\n";
  #assert coder_page_file_open(s, "/Users/dev/openagents/README.md", b2[0..<cp_out(b2[..], src2)], src2.count);
  #assert s[0].ft[0].ntabs == 2 && s[0].ft[0].active_tab == 1;
  // Switch back to inkling-gguf.c -> restores scroll=36 and fold 0 closed!
  #assert coder_page_file_open(s, path, b[0..<cp_out(b[..], src)], src.count);
  #assert s[0].fp[0].scroll == 36.0f32 && cp_fp_fold_is_closed(s[0].fp[..], 0);
  // Live reload preserves scroll & folds
  #assert coder_page_file_reload(s, b[0..<cp_out(b[..], src)], src.count);
  #assert s[0].fp[0].scroll == 36.0f32 && cp_fp_fold_is_closed(s[0].fp[..], 0);
  // Dirty disk-change banner
  coder_page_file_disk_changed(s);
  #assert s[0].fp[0].disk_changed && cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.disk.reload") >= 0;
  #assert cp_fp_test_press(s, "coder.file.disk.keep") && !s[0].fp[0].disk_changed;

  // Interactive breadcrumb sibling popover: clicking "platform" asks CP_ASK_FILE_DIR_LIST and populates entries
  #assert cp_fp_test_press(s, "coder.ft.crumb.4") && coder_page_action(s) == CP_ASK_FILE_DIR_LIST;
  dbuf: [256] u8;
  #assert cast(string) dbuf[0..<coder_page_file_crumb_dir(s, dbuf[..])] == "/Users/dev/openagents/psionic/platform";
  #assert coder_page_file_dir_set(s, "D\tsubdir\nF\tinkling-gguf.c\nF\tmetal.m\n") == 3;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.ft.cdir.2") >= 0;
  #assert cp_fp_test_press(s, "coder.ft.cdir.2") && coder_page_action(s) == CP_ASK_FILETREE_OPEN;
  req: [256] u8;
  #assert cast(string) req[0..<coder_page_filetree_req_path(s, req[..])] == "/Users/dev/openagents/psionic/platform/metal.m";
}

#test "Markdown preview renders real formatted Markdown (frontmatter, headings, tables, syntax-colored code, lists) in full RGB color" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_fp_test_page(s, f[..]);
  #assert cp_cust_is_monochrome(s);
  #assert cp_fp_md_frontmatter_end("---\n\n# Not frontmatter\n") == 0;

  b: [2048] u8;
  src := "---\nname: coax-pitfalls\ndescription: >-\n  Diagnose Coax compiler errors cleanly.\n---\n\n# Coax Pitfalls\n\n## First 10 Seconds\nDo **not** guess. Run `coax explain` first:\n\n```sh\n./coax/bin/coax explain E0366\n```\n\n| Code | Cause | Exact Fix |\n| --- | --- | --- |\n| `E0216` | Closed range | Use `0..<n`. |\n| `E0323` | Ignored return | Assign `_ = f();`. |\n\n> Tip: check `coax/spec.md`.\n\n- First bullet\n- Second bullet\n\n---\n\n1. Step one\n2. Step two\n";
  path := "/Users/dev/openagents/.agents/skills/coax-pitfalls/SKILL.md";
  #assert coder_page_file_open(s, path, b[0..<cp_out(b[..], src)], src.count);
  #assert !s[0].fp[0].md_preview;
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_find(s, "coder.file.md_toggle") >= 0;

  // Toggle Preview via Row 2 toolbar pill -> parses frontmatter + Markdown blocks
  #assert cp_fp_test_press(s, "coder.file.md_toggle") && s[0].fp[0].md_preview;
  #assert s[0].fp_md_fm_end > 0 && s[0].fp_md_blocks >= 8;
  #assert s[0].fp_md_doc[0].blocks[0].heading == 1 && s[0].fp_md_doc[0].blocks[1].heading == 2;

  // Render a full GPU frame under default monochrome T3 Noir: Markdown preview preserves full RGB colors
  vbuf: [524288] f32;
  nv := coder_page_frame(s, vbuf[..], 1280.0f32, 800.0f32, 1.0f32, 0.016f32);
  #assert nv > 0 && s[0].refused == 0;
  v_colored := 0;
  for i: 0..<nv {
    o := i * GP_VERTEX_FLOATS;
    r := vbuf[o + 12]; g := vbuf[o + 13]; bl := vbuf[o + 14]; a := vbuf[o + 15];
    if a > 0.1f32 && (abs(r - g) > 0.05f32 || abs(g - bl) > 0.05f32) { v_colored += 1; }
  }
  #assert v_colored >= 100;
  #assert s[0].fp[0].content > 200.0f32;

  // GPU text selection & copy works on rendered Markdown (no raw ** markers)
  s[0].px = s[0].pane_x + 40.0f32; s[0].py = 200.0f32;
  #assert cp_sel_select_all(s) && s[0].sel[0].region == CP_SEL_FILE;
  copied: [2048] u8;
  cn := coder_page_copy(s, false, copied[..]);
  ctext := cast(string) copied[0..<cn];
  #assert cn > 40 && cp_find(ctext, "Coax Pitfalls") >= 0 && cp_find(ctext, "**not**") < 0;
  cp_sel_clear(s);

  // Per-tab md_preview state persists across tab switch and live reload
  b2: [64] u8; src2 := "main :: () {}\n";
  #assert coder_page_file_open(s, "/Users/dev/openagents/main.coax", b2[0..<cp_out(b2[..], src2)], src2.count);
  #assert !s[0].fp[0].md_preview;
  #assert coder_page_file_open(s, path, b[0..<cp_out(b[..], src)], src.count);
  #assert s[0].fp[0].md_preview && s[0].fp_md_blocks >= 8;
  #assert coder_page_file_reload(s, b[0..<cp_out(b[..], src)], src.count);
  #assert s[0].fp[0].md_preview && s[0].fp_md_blocks >= 8;

  // Toggling back to Source clears md_preview and restores raw source view
  #assert cp_test_draw_side(s, f[..]) && cp_fp_test_press(s, "coder.file.md_toggle") && !s[0].fp[0].md_preview;
}
