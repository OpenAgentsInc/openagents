// Checks for the page's goal.coax: cost, budget and /goal. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "conversation cost formatting and attempt cost selection" {
  cb: [32] u8;
  #assert cp_cost(cb[..], 0) == "";
  #assert cp_cost(cb[..], -5) == "";
  #assert cp_cost(cb[..], 50) == "<$0.0001";
  #assert cp_cost(cb[..], 700) == "$0.0007";
  #assert cp_cost(cb[..], 9999) == "$0.01";
  #assert cp_cost(cb[..], 10000) == "$0.01";
  #assert cp_cost(cb[..], 1234567) == "$1.23";
  #assert cp_cost(cb[..], 1235000) == "$1.24";
  ab: [512] u8; ar: [1] ClArena; ar[0].buf = ab[..]; l: [1] MwwLine;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":12500}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 12500;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"openrouter\",\"outcome\":\"done\",\"status\":200,\"provider_cost_usd_micros\":7500,\"usd_micros\":9999}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 7500;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"retried\",\"status\":429}", l[..]) == MWW_ATTEMPT && cp_attempt_cost(l[0]) == 0;
}

#test "per-thread max budget defaults to $50, persists across save/load/take, auto-stops on exceed, and requires manual approval or budget increase" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  #assert coder_page_set_budget_usd_micros(s, 100000) && coder_page_budget_usd_micros(s) == 100000;
  #assert !coder_page_set_budget_usd_micros(s, 0) && !coder_page_set_budget_usd_micros(s, -5);
  // Start a turn and exceed the $0.10 budget: page automatically asks host to stop.
  #assert coder_page_set_text(s, "do work") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":100000}") == MWW_ATTEMPT;
  #assert coder_page_cost_usd_micros(s) == 100000 && coder_page_budget_exceeded(s) && coder_page_action(s) == CP_ASK_STOP;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\"}") == MWW_ENDED && !cp_running(s);
  // New turns are blocked while over budget.
  #assert coder_page_set_text(s, "more work") && !coder_page_submit(s);
  // Persist and reload preserves custom budget and cost.
  kept: [16384] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && coder_page_new(s) && coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  #assert coder_page_load(s, cast(string) kept[0..<kn]) && coder_page_budget_usd_micros(s) == 100000 && coder_page_cost_usd_micros(s) == 100000 && coder_page_budget_exceeded(s);
  // Older chats without budget_usd_micros default to $50.
  #assert coder_page_load(s, "{\"v\":1,\"cost_usd_micros\":5000,\"turns\":[{\"ask\":\"hi\",\"reply\":\"hello\"}]}") && coder_page_budget_usd_micros(s) == 50000000 && !coder_page_budget_exceeded(s);
  // Reload over-budget chat, approve continuing above budget, verify unblocked and save_due.
  #assert coder_page_load(s, cast(string) kept[0..<kn]) && coder_page_budget_exceeded(s) && !coder_page_save_due(s);
  #assert coder_page_budget_approve(s) && !coder_page_budget_exceeded(s) && coder_page_save_due(s);
  // Persist override across save/load.
  kn2 := coder_page_save(s, kept[..]);
  #assert kn2 > 0 && coder_page_load(s, cast(string) kept[0..<kn2]) && !coder_page_budget_exceeded(s) && s[0].budget_override;
  // Can now submit a new turn; raising budget above current cost clears override; lowering re-triggers exceeded + stop.
  #assert coder_page_set_text(s, "continue") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_set_budget_usd_micros(s, 500000) && !s[0].budget_override && !coder_page_budget_exceeded(s);
  #assert coder_page_set_budget_usd_micros(s, 50000) && coder_page_budget_exceeded(s) && coder_page_action(s) == CP_ASK_STOP;
}

#test "per-thread max budget and override transfer across coder_page_take and reset the source page" {
  p: [1] CoderPage; q: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); q_st: [1] CpCheckLean; b := cp_check_lean(q[..], q_st[..]);
  cp_init(s); cp_init(b);
  #assert coder_page_set_budget_usd_micros(s, 100000) && coder_page_budget_approve(s);
  #assert coder_page_set_text(s, "run") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert s[0].live_ask == 0;
  #assert coder_page_take(b, s);
  #assert b[0].live_ask == -1 && b[0].live_reply == -1;
  #assert coder_page_budget_usd_micros(b) == 100000 && b[0].budget_override;
  #assert coder_page_budget_usd_micros(s) == 50000000 && !s[0].budget_override;
}

#test "/goal slash commands manage lifecycle, prompt injection, continuation, and persistence" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  // Bare /goal with no active goal opens the goal editor.
  #assert coder_page_set_text(s, "/goal") && coder_page_submit(s);
  #assert coder_page_action(s) == CP_ASK_GOAL;
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  // Setting a goal with /goal <objective> starts an active goal turn with goal prompt context.
  #assert coder_page_set_text(s, "/goal ship the goal feature with full tests") && coder_page_submit(s);
  #assert coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  obj: [256] u8; on := coder_page_goal_objective(s, obj[..]);
  #assert cast(string) obj[0..<on] == "ship the goal feature with full tests";
  task_buf: [8192] u8;
  tn1 := coder_page_task(s, "s1", "/tmp", task_buf[..]);
  #assert tn1 > 0;
  task1 := cast(string) task_buf[0..<tn1];
  #assert cp_contains(task1, "<goal_objective>") && cp_contains(task1, "ship the goal feature with full tests");
  // When a turn ends without [GOAL_COMPLETE]/[GOAL_BLOCKED], autonomous continuation starts the next turn.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"First milestone complete, moving to tests.\"}") == MWW_ENDED;
  #assert coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_running(s);
  tn2 := coder_page_task(s, "s1", "/tmp", task_buf[..]);
  #assert tn2 > 0 && cp_contains(cast(string) task_buf[0..<tn2], "Continue working toward the active thread goal above.");
  // Pausing stops the active turn and sets status to paused.
  #assert coder_page_set_text(s, "/goal pause") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_PAUSED;
  #assert coder_page_action(s) == CP_ASK_STOP;
  // Resuming starts a continuation turn.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\",\"text\":\"stopped\"}") == MWW_ENDED;
  #assert coder_page_set_text(s, "/goal resume") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  #assert coder_page_action(s) == CP_ASK_SEND;
  // Every goal turn says what done means: the real thing, not a stand-in.
  #assert cp_contains(task1, "A toy, synthetic, miniature, stubbed, mocked, placeholder or hard-coded stand-in is not done");
  #assert cp_contains(task1, "a check that was killed, timed out or skipped did not pass");
  // A first [GOAL_COMPLETE] does not close the goal: it starts a turn that checks the work.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"All tests pass.\\n[GOAL_COMPLETE]\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  #assert coder_page_running(s);
  tn3 := coder_page_task(s, "s1", "/tmp", task_buf[..]);
  task3 := cast(string) task_buf[0..<tn3];
  #assert tn3 > 0 && cp_contains(task3, "check the work as a skeptical reviewer who did not write it");
  #assert cp_contains(task3, "gh issue view each one") && cp_contains(task3, "reopen any issue closed too early");
  // The check finds a stand-in and keeps working: the goal stays open and the next turn continues.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"The CPU run is a toy model. Reopened the issue.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  tn4 := coder_page_task(s, "s1", "/tmp", task_buf[..]);
  #assert tn4 > 0 && cp_contains(cast(string) task_buf[0..<tn4], "Continue working toward the active thread goal above.");
  // A new claim of done is checked again, and only the check's [GOAL_COMPLETE] closes the goal.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Real run works.\\n[GOAL_COMPLETE]\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Every criterion holds, evidence above.\\n[GOAL_COMPLETE]\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_COMPLETE;
  #assert !coder_page_running(s);
  // Goal state round-trips through save and load.
  #assert coder_page_save_due(s);
  kept: [4096] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && !coder_page_save_due(s);
  #assert coder_page_new(s) && coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert coder_page_load(s, cast(string) kept[0..<kn]);
  #assert coder_page_goal_status(s) == CP_GOAL_COMPLETE;
  on2 := coder_page_goal_objective(s, obj[..]);
  #assert cast(string) obj[0..<on2] == "ship the goal feature with full tests";
  // /goal clear removes the goal.
  #assert coder_page_set_text(s, "/goal clear") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert coder_page_goal_objective(s, obj[..]) == 0;
}

#test "setting a goal right after submitting a prompt attaches goal context without starting a duplicate turn" {
  store: [1] CoderPage; store_st: [1] CpCheckStore; s := cp_check_page(store[..], store_st[..]);
  #assert coder_page_set_text(s, "[From Foreman]\nImplement the fix") && coder_page_submit(s);
  #assert coder_page_running(s) && s[0].nturns == 1;
  #assert coder_page_goal_set(s, "ship foreman goal fix cleanly");
  #assert coder_page_running(s) && s[0].nturns == 1;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  obj: [256] u8;
  on := coder_page_goal_objective(s, obj[..]);
  #assert cast(string) obj[0..<on] == "ship foreman goal fix cleanly";
  #assert coder_page_action(s) == CP_ASK_SEND;
  buf: [8192] u8;
  tn := coder_page_task(s, "sess-foreman-goal", "/tmp", buf[..]);
  #assert tn > 0;
  task := cast(string) buf[0..<tn];
  #assert cp_contains(task, "<goal_objective>") && cp_contains(task, "ship foreman goal fix cleanly");
  #assert cp_contains(task, "Implement the fix");
}

#test "clearing a goal while a turn is running does not stop the ongoing message chain" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  // Start an active goal turn and consume its initial send action.
  #assert coder_page_set_text(s, "/goal finish the migration") && coder_page_submit(s);
  #assert coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_running(s) && coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  // Clearing the goal via host call while running keeps the turn going and does not request CP_ASK_STOP.
  #assert coder_page_goal_clear(s);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  obj: [128] u8;
  #assert coder_page_goal_objective(s, obj[..]) == 0;
  #assert coder_page_running(s) && !s[0].turns[s[0].nturns - 1].stopping;
  #assert coder_page_action(s) == CP_ASK_NONE;
  // The ongoing turn continues receiving output and finishes cleanly without starting another goal continuation.
  #assert coder_page_line(s, "{\"kind\":\"reply\",\"text\":\"Still working on the current message.\"}") == MWW_REPLY;
  #assert coder_page_running(s);
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Still working on the current message.\"}") == MWW_ENDED;
  #assert !coder_page_running(s) && s[0].turns[s[0].nturns - 1].state == CP_DONE;
  #assert coder_page_action(s) == CP_ASK_NONE;
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  // A queued follow-up turn from the worker can still advance the ongoing message chain.
  #assert coder_page_line(s, "{\"kind\":\"turn\",\"turn\":2,\"source\":\"queue\",\"text\":\"follow-up step\"}") == MWW_TURN;
  #assert coder_page_running(s) && s[0].nturns == 2 && coder_page_followup_began(s);
  // Clearing via /goal clear while a goal is active on a running turn also does not stop it.
  #assert coder_page_goal_set(s, "second goal");
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  #assert coder_page_set_text(s, "/goal clear") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert coder_page_running(s) && !s[0].turns[s[0].nturns - 1].stopping;
  #assert coder_page_action(s) == CP_ASK_NONE;
  // Clearing before the host consumes CP_ASK_SEND preserves the pending send action.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"done\"}") == MWW_ENDED;
  #assert coder_page_set_text(s, "/goal third goal") && coder_page_submit(s);
  #assert coder_page_goal_clear(s);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert coder_page_running(s) && !s[0].turns[s[0].nturns - 1].stopping;
  #assert coder_page_action(s) == CP_ASK_SEND;
}

#test "/goal clear aliases, status subcommand, visible-text and 4096-byte cap validation" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  // All clear aliases clear an active goal instead of starting a goal named "stop" or "cancel".
  aliases := [6] string.["clear", "stop", "OFF", "reset", "None", "Cancel"];
  for alias: aliases {
    #assert coder_page_set_text(s, "/goal finish audit") && coder_page_submit(s);
    #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
    #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\"}") == MWW_ENDED;
    cmd_buf: [32] u8;
    cn := el_put(cmd_buf[..], 0, "/goal ");
    cn = el_put(cmd_buf[..], cn, alias);
    #assert coder_page_set_text(s, cast(string) cmd_buf[0..<cn]) && coder_page_submit(s);
    #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  }
  // Control-only / invisible objective is rejected.
  ctrl := [3] u8.[1, 2, 31];
  #assert !coder_page_goal_set(s, cast(string) ctrl[..]);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  // Over-limit (> 4096 B) objective is rejected explicitly rather than silently truncated.
  big: [CP_GOAL_TEXT + 16] u8;
  for k: 0..<big.count { big[k] = 'a'; }
  #assert !coder_page_goal_set(s, cast(string) big[..]);
  #assert coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert cp_contains(cast(string) s[0].goal_notice[0..<s[0].goal_notice_n], "limited to 4096 bytes");
  // Exact 4096 B objective is accepted.
  #assert coder_page_goal_set(s, cast(string) big[0..<CP_GOAL_TEXT]);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"outcome\":\"done\",\"status\":200,\"usd_micros\":25000,\"output_tokens\":420}") == MWW_ATTEMPT;
  #assert coder_page_goal_tokens(s) == 420 && coder_page_goal_cost_usd_micros(s) == 25000;
  // /goal status prints a rich summary notice.
  #assert coder_page_set_text(s, "/goal status") && coder_page_submit(s);
  notice := cast(string) s[0].goal_notice[0..<s[0].goal_notice_n];
  #assert cp_contains(notice, "Goal (Active") && cp_contains(notice, "420 tok") && cp_contains(notice, "$0.03");
}

#test "/goal [GOAL_IMPOSSIBLE] sets CP_GOAL_FAILED, extracts reason, notifies failure, and persists across save/load/take" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  q: [1] CoderPage; q_st: [1] CpCheckLean; b := cp_check_lean(q[..], q_st[..]);
  cp_init(s); cp_init(b);
  #assert coder_page_set_text(s, "/goal build perpetual motion engine") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Violates thermodynamics.\\n[GOAL_IMPOSSIBLE] First and second laws forbid it.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_FAILED;
  #assert !coder_page_running(s);
  rb: [512] u8;
  rn := coder_page_goal_reason(s, rb[..]);
  #assert cp_contains(cast(string) rb[0..<rn], "First and second laws forbid it.");
  #assert cp_notify_goal_event(CP_GOAL_ACTIVE, CP_GOAL_FAILED) == CP_NOTIFY_EV_TURN_FAILED;
  // Save / load round-trip preserves CP_GOAL_FAILED, reason, evals, tokens, cost_start, max_consec.
  #assert coder_page_goal_set_max_consec(s, 5);
  kept: [8192] u8; kn := coder_page_save(s, kept[..]);
  #assert kn > 0 && coder_page_new(s) && coder_page_goal_status(s) == CP_GOAL_NONE;
  #assert coder_page_load(s, cast(string) kept[0..<kn]);
  #assert coder_page_goal_status(s) == CP_GOAL_FAILED;
  #assert coder_page_goal_max_consec(s) == 5;
  rn2 := coder_page_goal_reason(s, rb[..]);
  #assert cp_contains(cast(string) rb[0..<rn2], "First and second laws forbid it.");
  // Transfer via coder_page_take preserves reason & status and resets source.
  #assert coder_page_take(b, s);
  #assert coder_page_goal_status(b) == CP_GOAL_FAILED && coder_page_goal_status(s) == CP_GOAL_NONE;
  rn3 := coder_page_goal_reason(b, rb[..]);
  #assert cp_contains(cast(string) rb[0..<rn3], "First and second laws forbid it.");
}

#test "/goal reply-to-resume, consecutive-unmet cap, and audit feedback injection" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert coder_page_goal_set_max_consec(s, 2);
  #assert coder_page_set_text(s, "/goal close all gaps") && coder_page_submit(s);
  // Turn 1 ends unmet -> consec 1 -> auto-continues.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Step 1 done.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  // Turn 2 ends unmet -> consec 2 == cap -> auto-pauses with reason!
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Step 2 done.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_PAUSED && !coder_page_running(s);
  rb: [512] u8; rn := coder_page_goal_reason(s, rb[..]);
  #assert cp_contains(cast(string) rb[0..<rn], "2 consecutive autonomous turns");
  // Sending a regular user message automatically resumes the paused goal and clears the reason!
  #assert coder_page_set_text(s, "Keep going on step 3") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  #assert coder_page_goal_reason(s, rb[..]) == 0;
  // Claim done -> triggers audit (evals == 1); audit rejects -> injects <goal_feedback> in next turn.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Done now.\\n[GOAL_COMPLETE]\"}") == MWW_ENDED;
  #assert coder_page_goal_evals(s) == 1 && coder_page_running(s);
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Missing test coverage for retry exhaustion.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  tbuf: [8192] u8; tn := coder_page_task(s, "s2", "/tmp", tbuf[..]);
  #assert tn > 0 && cp_contains(cast(string) tbuf[0..<tn], "<goal_feedback>") && cp_contains(cast(string) tbuf[0..<tn], "Missing test coverage for retry exhaustion.");
  // Blocked goal also resumes on normal user reply.
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Need API token.\\n[GOAL_BLOCKED] Missing token.\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_BLOCKED && !coder_page_running(s);
  #assert coder_page_set_text(s, "Added the token to env") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
}

#test "/goal interruption recovery: transient auto-retry cap, unrecoverable auto-clear, and subagent deferral" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert coder_page_set_text(s, "/goal recover cleanly") && coder_page_submit(s);
  // 3 consecutive transient failures via coder_page_failed auto-retry; 4th pauses with reason.
  coder_page_failed(s, "HTTP 503 service unavailable");
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  coder_page_failed(s, "request timed out");
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  coder_page_failed(s, "HTTP 429 rate limit exceeded");
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  coder_page_failed(s, "connection reset by peer");
  #assert coder_page_goal_status(s) == CP_GOAL_PAUSED && !coder_page_running(s);
  rb: [512] u8; rn := coder_page_goal_reason(s, rb[..]);
  #assert cp_contains(cast(string) rb[0..<rn], "transient retries exhausted");
  // Resume and hit an unrecoverable error (401 auth) -> clears goal with warning notice.
  #assert coder_page_set_text(s, "/goal resume") && coder_page_submit(s);
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  coder_page_failed(s, "HTTP 401 invalid api key");
  #assert coder_page_goal_status(s) == CP_GOAL_NONE && !coder_page_running(s);
  #assert cp_contains(cast(string) s[0].goal_notice[0..<s[0].goal_notice_n], "unrecoverable error");
  // Subagent deferral: if a subagent is still running when [GOAL_COMPLETE] arrives, closure is deferred.
  #assert coder_page_set_text(s, "/goal verify subagents") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"ticket\":1,\"tasks\":[{\"level\":\"quick\",\"task\":\"run checks\"}]}") == MWW_DELEGATE;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"All done.\\n[GOAL_COMPLETE]\"}") == MWW_ENDED;
  #assert coder_page_goal_status(s) == CP_GOAL_ACTIVE && coder_page_running(s);
  tbuf: [8192] u8; tn := coder_page_task(s, "s3", "/tmp", tbuf[..]);
  #assert tn > 0 && cp_contains(cast(string) tbuf[0..<tn], "<goal_deferral>");
}
