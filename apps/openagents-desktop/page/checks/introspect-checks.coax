// Checks for page/introspect.coax: Universal Introspection sidebar sections
// (TUI & Terminal, Other Harnesses, Machines), collapse/expand, source-preserving merges,
// click-to-inspect live output pane, and #14071 opt-in read-only external harness notice (#14066).
#load "../parts.coax";
#load "checks-kit.coax";

cp_is_test_frame :: (s: [] CoderPage, f: [] UiFrame, w: f32, h: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0f32, 0.016f32, true, false);
  cp_layout(s, f, w, h);
  return uiframe_end(f, s[0].surface[..]);
}

#test "introspect page: sidebar sections render when populated, collapse cleanly, and preserve independent sources" {
  p: [1] CoderPage; st: [1] CpCheckStore; s := cp_check_page(p[..], st[..]);
  cp_init(s); s[0].d = 1.0f32;
  f: [1] UiFrame;

  // Empty snapshot renders none of the 3 introspection sections.
  #assert cp_is_test_frame(s, f[..], 1280, 820);
  #assert surface_find(s[0].surface[..], "coder.is.sec.tui") < 0;
  #assert surface_find(s[0].surface[..], "coder.is.sec.harness") < 0;
  #assert surface_find(s[0].surface[..], "coder.is.sec.machines") < 0;

  // Populate all three independent sources.
  tmux := "dev\t0\t0\t12345\tzsh\t/Users/chris/work/openagents\tdev-shell\t1\ndev\t0\t1\t12346\tclaude\t/Users/chris/work/openagents\tRefactor UI\t0\n";
  ps := "20001\ttty002\tS+\tcoder\tcoder tui\t/Users/chris/work/openagents\n12346\ttty001\tS+\tclaude\tclaude\t/Users/chris/work/openagents\n";
  #assert coder_page_introspect_set_tui(s, tmux, ps, false) == 3;

  har := "claude\tsess-a1\tFix Metal shader\t/Users/chris/work/openagents\tmain\trunning\t1700000100000\t4410\tCompiling\ncodex\tsess-b2\tAudit API\t/Users/chris/work/api\tfeat/auth\tidle\t1700000050000\t0\tDone\n";
  #assert coder_page_introspect_set_harnesses(s, har, "", false) == 2;

  mach := "studio\tMac Studio\t100.88.1.10\tchris\t22\ttailscale\tonline\t0\t0\tmacOS\ngpu-box\tH100 Box\t100.88.1.42\troot\t2222\tssh\toffline\t0\t0\tlinux\n";
  rem := "studio\tMac Studio\tchat-99\topenagents\tTrain Inkling\t/Users/chris/openagents\tmain\trunning\t1700000200000\tstep 420\n";
  #assert coder_page_introspect_set_machines(s, mach, rem) == 2;

  counts: [4] int;
  #assert coder_page_introspect_counts(s, counts[..]);
  #assert counts[0] == 3 && counts[1] == 2 && counts[2] == 1 && counts[3] == 2;

  // Updating TUI does not clobber harnesses or remote machines.
  #assert coder_page_introspect_set_tui(s, "dev\t0\t0\t12345\tzsh\t/Users/chris/work/openagents\tdev-shell\t1\n", "", false) == 1;
  #assert coder_page_introspect_counts(s, counts[..]);
  #assert counts[0] == 1 && counts[1] == 2 && counts[2] == 1 && counts[3] == 2;

  // All 3 collapsible sections and their items appear in the sidebar.
  #assert cp_is_test_frame(s, f[..], 1280, 960);
  tui_sec := surface_find(s[0].surface[..], "coder.is.sec.tui");
  har_sec := surface_find(s[0].surface[..], "coder.is.sec.harness");
  mac_sec := surface_find(s[0].surface[..], "coder.is.sec.machines");
  #assert tui_sec >= 0 && har_sec >= 0 && mac_sec >= 0;
  #assert surface_find(s[0].surface[..], "coder.is.m.0") >= 0;
  #assert surface_find(s[0].surface[..], "coder.is.m.1") >= 0;

  // Collapsing TUI section hides its rows cleanly.
  #assert cp_press(s, tui_sec) && s[0].introspect[0].tui_collapsed;
  #assert cp_press(s, har_sec) && s[0].introspect[0].harness_collapsed;
  #assert cp_press(s, mac_sec) && s[0].introspect[0].machines_collapsed;
  #assert cp_is_test_frame(s, f[..], 1280, 960);
  #assert surface_find(s[0].surface[..], "coder.is.m.0") < 0;
  // Re-expanding restores items.
  #assert cp_press(s, surface_find(s[0].surface[..], "coder.is.sec.tui")) && !s[0].introspect[0].tui_collapsed;
  #assert cp_press(s, surface_find(s[0].surface[..], "coder.is.sec.harness")) && !s[0].introspect[0].harness_collapsed;
  #assert cp_press(s, surface_find(s[0].surface[..], "coder.is.sec.machines")) && !s[0].introspect[0].machines_collapsed;
}

#test "introspect page: click-to-inspect opens live output pane, enforces #14071 read-only note, and closes on chat click" {
  p: [1] CoderPage; st: [1] CpCheckStore; s := cp_check_page(p[..], st[..]);
  cp_init(s); s[0].d = 1.0f32;
  s[0].flawed[0].allow_local_harnesses = false;
  f: [1] UiFrame;

  har := "claude\tsess-a1\tFix Metal shader\t/Users/chris/work/openagents\tmain\trunning\t1700000100000\t4410\tCompiling\n";
  #assert coder_page_introspect_set_harnesses(s, har, "", false) == 1;
  mach := "studio\tMac Studio\t100.88.1.10\tchris\t22\ttailscale\tonline\t0\t0\tmacOS\n";
  #assert coder_page_introspect_set_machines(s, mach, "") == 1;

  #assert cp_is_test_frame(s, f[..], 1280, 900);
  srow := surface_find(s[0].surface[..], "coder.is.s.0");
  #assert srow >= 0;
  #assert cp_press(s, srow);
  #assert coder_page_introspect_shown(s);
  #assert !coder_page_introspect_active_is_machine(s);
  #assert coder_page_introspect_active_kind(s) == IS_KIND_HARNESS;
  #assert coder_page_action(s) == CP_ASK_INTROSPECT_INSPECT;

  aid: [128] u8;
  an := coder_page_introspect_active_id(s, aid[..]);
  #assert cast(string) aid[0..<an] == "local:harness:claude:sess-a1";

  // Feed live output from host and verify inspector renders URI, live output, and #14071 read-only notice.
  #assert coder_page_introspect_set_output(s, "local:harness:claude:sess-a1", "$ coax test gpu.coax\n4 checks, 4 passed\n", "Updated · read-only tail", false);
  // Stale output for a different session id is ignored.
  #assert !coder_page_introspect_set_output(s, "local:harness:codex:other", "ignored", "stale", false);
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  #assert surface_find(s[0].surface[..], "introspect.pane.uri") >= 0;
  #assert surface_find(s[0].surface[..], "introspect.pane.output") >= 0;
  #assert surface_find(s[0].surface[..], "introspect.pane.readonly_note") >= 0;

  // Copy & Refresh buttons dispatch host asks.
  cp_btn := surface_find(s[0].surface[..], "introspect.pane.copy");
  #assert cp_btn >= 0 && cp_press(s, cp_btn) && coder_page_action(s) == CP_ASK_INTROSPECT_COPY;
  obuf: [256] u8;
  on := coder_page_introspect_output(s, obuf[..]);
  #assert cast(string) obuf[0..<on] == "$ coax test gpu.coax\n4 checks, 4 passed\n";

  // Clicking machine opens machine overview and Connect button dispatches CP_ASK_INTROSPECT_CONNECT.
  mrow := surface_find(s[0].surface[..], "coder.is.m.0");
  #assert mrow >= 0 && cp_press(s, mrow);
  #assert coder_page_introspect_shown(s) && coder_page_introspect_active_is_machine(s);
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  #assert surface_find(s[0].surface[..], "introspect.mach.host") >= 0;
  cbtn := surface_find(s[0].surface[..], "introspect.pane.connect");
  #assert cbtn >= 0 && cp_press(s, cbtn) && coder_page_action(s) == CP_ASK_INTROSPECT_CONNECT;

  // Close button dismisses inspector back to normal conversation.
  xbtn := surface_find(s[0].surface[..], "introspect.pane.close");
  #assert xbtn >= 0 && cp_press(s, xbtn) && !coder_page_introspect_shown(s);
}

#test "introspect page: direct command composer sends commands to TUI/remote sessions, preserves chat draft, and honors #14071 opt-in" {
  p: [1] CoderPage; st: [1] CpCheckStore; s := cp_check_page(p[..], st[..]);
  cp_init(s); s[0].d = 1.0f32;
  s[0].flawed[0].allow_local_harnesses = false;
  f: [1] UiFrame;

  // Keep an active main chat draft to prove introspect direct command doesn't clobber it.
  eb_set(s[0].draft[..], "main chat draft untouched");

  tmux := "dev\t0\t0\t12345\tzsh\t/Users/chris/work/openagents\tdev-shell\t1\n";
  har := "claude\tsess-a1\tFix Metal shader\t/Users/chris/work/openagents\tmain\trunning\t1700000100000\t4410\tCompiling\n";
  mach := "studio\tMac Studio\t100.88.1.10\tchris\t22\ttailscale\tonline\t0\t0\tmacOS\n";
  rem := "studio\tMac Studio\tchat-99\topenagents\tTrain Inkling\t/Users/chris/openagents\tmain\trunning\t1700000200000\tstep 420\n";
  #assert coder_page_introspect_set_tui(s, tmux, "", false) == 1;
  #assert coder_page_introspect_set_harnesses(s, har, "", false) == 1;
  #assert coder_page_introspect_set_machines(s, mach, rem) == 1;

  // 1. Open TUI tmux session -> directly commandable, renders composer/send/stop.
  #assert cp_introspect_open_session(s, 0);
  #assert coder_page_introspect_can_command(s);
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  #assert surface_find(s[0].surface[..], "introspect.pane.composer") >= 0;
  #assert surface_find(s[0].surface[..], "introspect.pane.send") >= 0;
  #assert surface_find(s[0].surface[..], "introspect.pane.stop") >= 0;

  // Type via composer and press Send button.
  #assert coder_page_introspect_set_cmd(s, "git status -sb");
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  sbtn := surface_find(s[0].surface[..], "introspect.pane.send");
  #assert sbtn >= 0 && cp_press(s, sbtn);
  #assert coder_page_action(s) == CP_ASK_INTROSPECT_SEND;
  cbuf: [128] u8;
  cn := coder_page_introspect_cmd(s, cbuf[..]);
  #assert cast(string) cbuf[0..<cn] == "git status -sb";
  #assert coder_page_introspect_cmd_done(s, "local:tmux:dev:0.0", "Sent to tmux pane", false);

  // Focus composer, type via text input, and submit with Return.
  frow := surface_find(s[0].surface[..], "introspect.pane.composer");
  #assert frow >= 0 && cp_press(s, frow);
  #assert coder_page_text_edit(s, "pwd", "", 0, 0);
  #assert coder_page_key(s, KEY_ENTER, 0);
  #assert coder_page_action(s) == CP_ASK_INTROSPECT_SEND;
  cn = coder_page_introspect_cmd(s, cbuf[..]);
  #assert cast(string) cbuf[0..<cn] == "pwd";

  // Stop button emits CP_ASK_INTROSPECT_STOP.
  stbtn := surface_find(s[0].surface[..], "introspect.pane.stop");
  #assert stbtn >= 0 && cp_press(s, stbtn) && coder_page_action(s) == CP_ASK_INTROSPECT_STOP;

  // 2. External local harness with allow_local_harnesses == false -> read-only, no composer, submit refused.
  #assert cp_introspect_open_session(s, 1);
  #assert !coder_page_introspect_can_command(s);
  #assert !coder_page_introspect_set_cmd(s, "should fail");
  #assert !coder_page_introspect_submit(s);
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  #assert surface_find(s[0].surface[..], "introspect.pane.composer") < 0;
  #assert surface_find(s[0].surface[..], "introspect.pane.readonly_note") >= 0;

  // Enabling #14071 opt-in makes external local harnesses directly commandable.
  s[0].flawed[0].allow_local_harnesses = true;
  #assert coder_page_introspect_set_harnesses(s, har, "", true) == 1;
  #assert coder_page_introspect_can_command(s);
  #assert cp_is_test_frame(s, f[..], 1280, 900);
  #assert surface_find(s[0].surface[..], "introspect.pane.composer") >= 0;
  #assert coder_page_introspect_set_cmd(s, "status check");
  #assert coder_page_introspect_submit(s) && coder_page_action(s) == CP_ASK_INTROSPECT_SEND;
  cn = coder_page_introspect_cmd(s, cbuf[..]);
  #assert cast(string) cbuf[0..<cn] == "status check";

  // 3. Remote session is directly commandable.
  #assert cp_introspect_open_session(s, 2);
  #assert coder_page_introspect_can_command(s);
  #assert coder_page_introspect_set_cmd(s, "nvidia-smi");
  #assert coder_page_introspect_submit(s) && coder_page_action(s) == CP_ASK_INTROSPECT_SEND;

  // Closing inspector preserves main chat draft completely untouched.
  coder_page_introspect_close(s);
  #assert eb_text(s[0].draft[..]) == "main chat draft untouched";
}
