// Checks for the page's skin.coax, input.coax and layout/: the skin, text size, sidebars and their widths, the HUD. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "the page lays out in points: its scale is the text size alone" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert coder_page_zoom(s, 0) == 2 && abs(coder_page_scale(s) - 1.0) < 0.001;
  #assert coder_page_zoom(s, 1) == 3 && abs(coder_page_scale(s) - 1.1) < 0.001;
  for i: 0..<9 { _ := coder_page_zoom(s, 1); }
  #assert coder_page_zoom(s, 0) == 7 && abs(coder_page_scale(s) - 2.0) < 0.001;
  for i: 0..<9 { _ := coder_page_zoom(s, -1); }
  #assert coder_page_zoom(s, 0) == 0 && coder_page_zoom_set(s, 2) == 2;
  // the composer's editor: Zeron's composer text, 14 on a 22 line, and it grows with the text size
  sk := cp_ed_skin(s, cp_skin(), CP_ED_COMPOSER);
  #assert abs(coder_page_font_size(sk.body.face) - 14.0) < 0.01 && abs(sk.cmp.line - 22.0) < 0.001;
  #assert coder_page_zoom_set(s, 5) == 5 && abs(coder_page_scale(s) - 1.5) < 0.001;
}

// The size the atlas holds a type's face at, in points.
cp_pt :: (t: UiType) -> f32 { return coder_page_font_size(t.face); }
#test "every font slot comes out at Zeron's type ramp at the usual text size" {
  k := cp_skin();
  // prose 15/24, its bold, inline code 13.5, code blocks 13/20
  #assert cp_pt(k.body) == 15 && k.body.size == 15 && k.body.line == 24 && k.md.line == 24;
  #assert cp_pt(k.strong) == 15 && k.strong.line == 24;
  #assert cp_pt(k.code) == 13.5 && k.code.size == 13.5;
  #assert cp_pt(k.mono) == 13 && k.mono.line == 20 && k.md.block_line == 20;
  // sm 12/16 (tool rows, captions, tool output), md 13/18 (labels, titles, menus, sidebar rows), xs 11/14
  #assert cp_pt(k.tool) == 12 && k.tool.line == 16 && cp_pt(k.small) == 12 && k.small.line == 16;
  #assert cp_pt(k.mono_small) == 12 && k.mono_small.line == 16 && cp_pt(k.mono_tiny) == 11 && k.mono_tiny.line == 14;
  #assert cp_pt(k.label) == 13 && k.label.line == 18 && cp_pt(k.title) == 13 && cp_pt(k.menu) == 13 && k.menu.line == 18;
  #assert cp_pt(k.app.side_text) == 13 && k.app.side_text.line == 18 && cp_pt(k.menu_small) == 11 && k.menu_small.line == 14;
  // the composer's 14/22, and settings' own faces at Zeron's 11, 12 and 20 with no correction for a scale
  #assert coder_page_font_size(CP_COMPOSER_FACE) == 14 && k.cmp.line == 22;
  #assert coder_page_font_size(FONT_SET_HEAD) == 11 && coder_page_font_size(FONT_SET_DESC) == 12 && coder_page_font_size(FONT_SET_TITLE) == 20;
  #assert k.set.title_line == coder_noir_settings().title_line && k.set.row == coder_noir_settings().row;
  // each size the face's weight is: Medium for md and the chips, SemiBold for bold, Mono for code
  w := FONT_WEIGHTS;
  #assert w[k.body.face] == 0 && w[k.strong.face] == 2 && w[k.label.face] == 1 && w[k.code.face] == 3 && w[k.mono.face] == 3;
}

#test "the window's measures are Zeron's, in points" {
  k := cp_skin();
  #assert CP_COLUMN == 660 && CP_PAD == 32 && CP_BOTTOM == 8;
  #assert CP_SIDE == 272 && CP_SIDE_LEAST == 242 && CP_SIDE_MOST == 400;
  #assert CP_PANE == 520 && CP_PANE_LEAST == 360;
  #assert k.app.side_row == 32 && k.app.side_head == 26 && k.app.row_inset == 8 && k.app.row_radius == 8 && k.app.side_pad == 16;
  // Composer: Zeron's pill (22pt line, 28pt circular send at 6pt inset, 28pt chips)
  #assert k.cmp.send == 28 && k.cmp.action_inset == 6 && k.cmp.chip_h == 28;
}

#test "Coder's skin is pure black canvas and sidebar with dark gray divider on Zeron's measures" {
  k := cp_skin(); th := cp_theme(); t3 := cp_t3_dark();
  #assert th.shell.r == t3.shell.r && th.sidebar.r == t3.sidebar.r && th.surface.r == t3.surface.r;
  // Both main canvas and sidebar are pure black (#000000), separated by a dark gray hairline (#262626).
  #assert k.canvas.r == 0 && k.canvas.g == 0 && k.canvas.b == 0 && k.canvas.a == 1;
  #assert k.sidebar.r == 0 && k.sidebar.g == 0 && k.sidebar.b == 0 && k.sidebar.a == 1;
  #assert abs(k.menu_divider.r - hex(0x262626, 1).r) < 0.001f32 && k.menu_divider.a == 1;
  #assert abs(k.set.subtle.r - hex(0x262626, 1).r) < 0.001f32 && k.set.subtle.a == 1;
  #assert k.ink.r == th.text.r && k.muted.r == th.muted.r && k.faint.r == th.faint.r && k.accent.b == th.accent.b && k.warning.g == th.warning.g;
  #assert k.raised.r == th.raised.r && k.surface.r == th.surface.r;
  #assert k.set.text.r == th.text.r && k.set.primary.r == th.primary.r && k.bubble.r == th.secondary.r;
  // T3 composer card radius 16, code blocks 12
  #assert k.cmp.radius == 16 && k.md.block_radius == 12 && k.app.code_radius == 12;
}

#test "sidebar draws pure black surface and exact 1-physical-pixel dark gray right border across DPR and zoom" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  k := cp_skin();
  scales := [3] f32.[1.0f32, 2.0f32, 2.2f32];
  for d: scales {
    s[0].d = d;
    f: [1] UiFrame;
    uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), k, uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
    cp_sidebar(s, f[..], 272.5f32, 800.0f32, false);
    #assert uiframe_end(f[..], s[0].surface[..]);
    sh := surface_sheet(s[0].surface[..]);
    #assert sh.nu >= 2;
    bg_p := sh.under[0];
    edge_p := sh.under[1];
    #assert bg_p.fill.r == 0 && bg_p.fill.g == 0 && bg_p.fill.b == 0 && bg_p.fill.a == 1;
    #assert abs(edge_p.fill.r - k.menu_divider.r) < 0.001f32 && edge_p.fill.a == 1;
    // Rasterized width in device pixels must be exactly 1.0 physical pixel.
    dev_x0 := snap(edge_p.x, d);
    dev_x1 := snap(edge_p.x + edge_p.w, d);
    #assert dev_x1 - dev_x0 == 1.0f32;
    #assert snap(bg_p.x + bg_p.w, d) == dev_x0;
  }
}

#test "sidebar footer draws demo pills stacked in the footer region" {
  u0: [64] Prim; o0: [64] Prim; l0: [16] SheetLine; h0: [16] SheetHit; p0: [512] u8; r0: [16] El;
  u1: [64] Prim; o1: [64] Prim; l1: [16] SheetLine; h1: [16] SheetHit; p1: [512] u8; r1: [16] El;
  sf: [1] UiSurface;
  sf[0] = surface_over(
    Sheet.{under = u0[..], over = o0[..], lines = l0[..], hits = h0[..], pool = p0[..]}, r0[..],
    Sheet.{under = u1[..], over = o1[..], lines = l1[..], hits = h1[..], pool = p1[..]}, r1[..]);
  keys: [16] Keyed; ks: [1] KeyedStore; ks[0] = KeyedStore.{rows = keys[..]};
  k := cp_skin();
  f: [1] UiFrame;
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  h: f32 = 660.0f32;
  // Hidden by default: footer takes zero height and emits no placeholder pills.
  #assert cp_side_footer_h(s, k) == 0.0f32;
  // Available state renders clickable update pill with detail.
  coder_page_update(s, CP_UPD_AVAILABLE, "", "v0.2.0");
  footer_h := cp_side_footer_h(s, k);
  #assert footer_h > k.cmp.chip_h;
  uiframe_begin(f[..], sf[..], ks[..], measure_cells(), k, uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_side_footer(s, f[..], 0, h - footer_h, cast(f32) CP_SIDE - k.border);
  #assert uiframe_end(f[..], sf[..]);
  u_idx := surface_find(sf[..], "coder.side.pill.update");
  #assert u_idx >= 0 && surface_find(sf[..], "coder.side.pill.provider") < 0;
  tb := surface_rows(sf[..]);
  u_row := tb.rows[u_idx];
  #assert u_row.action == CP_UPDATE;
  #assert u_row.y > h - footer_h && u_row.y + u_row.h < h;
  // Downloading state disables clicks.
  coder_page_update(s, CP_UPD_DOWNLOADING, "Downloading…", "42%");
  uiframe_begin(f[..], sf[..], ks[..], measure_cells(), k, uiinput(0, 0, false, false, "", ""), 0.016, 0.016, true, false);
  cp_side_footer(s, f[..], 0, h - footer_h, cast(f32) CP_SIDE - k.border);
  #assert uiframe_end(f[..], sf[..]);
  u_idx = surface_find(sf[..], "coder.side.pill.update");
  #assert u_idx >= 0 && surface_rows(sf[..]).rows[u_idx].action == 0;
  // Ready state is clickable through full layout and dispatches CP_ASK_UPDATE.
  coder_page_update(s, CP_UPD_READY, "", "v0.2.0");
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), k, uiinput(0, 0, false, false, "", ""), 0.032, 0.016, true, false);
  cp_layout(s, f[..], 1200.0f32, h);
  #assert uiframe_end(f[..], s[0].surface[..]);
  r_idx := surface_find(s[0].surface[..], "coder.side.pill.update");
  #assert r_idx >= 0;
  r_row := surface_rows(s[0].surface[..]).rows[r_idx];
  #assert r_row.action == CP_UPDATE;
  cx := r_row.x + r_row.w * 0.5f32;
  cy := r_row.y + r_row.h * 0.5f32;
  #assert coder_page_pointer(s, cx, cy, 0);
  #assert coder_page_pointer(s, cx, cy, 2);
  #assert coder_page_action(s) == CP_ASK_UPDATE;
}

#test "sidebar collapses below CP_SIDE_FROM and yields to transcript pane under CP_PANE_MAIN" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  f: [1] UiFrame;
  // At exactly CP_SIDE_FROM (1080 pt), the chats sidebar is visible.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], cast(f32) CP_SIDE_FROM, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side == cast(f32) CP_SIDE;
  // One pixel below CP_SIDE_FROM, the chats sidebar collapses.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, true, false);
  cp_layout(s, f[..], cast(f32) (CP_SIDE_FROM - 1), 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side == 0;
  // With a sub-agent pane open at 1000 px, chats sidebar yields first (1000 - 272 - 520 < 456) while the pane stays at CP_PANE.
  #assert coder_page_set_text(s, "check") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"inspect\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert s[0].pane_open;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, true, false);
  cp_layout(s, f[..], 1000.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side == 0 && s[0].pane_w == cast(f32) CP_PANE && s[0].col_w > 0;
  // At 600 pt, even without the chats sidebar the transcript pane cannot leave CP_PANE_MAIN, so it takes the whole window.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.048, 0.016, true, false);
  cp_layout(s, f[..], 600.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side == 0 && s[0].pane_w == 600.0f32 && s[0].col_w == 0;
}

#test "zoom and pane resize clamp to configured bounds" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  #assert coder_page_zoom_set(s, -5) == 0 && cp_scale(s) == CP_ZOOMS[0];
  #assert coder_page_zoom(s, -1) == 0;
  max_z := CP_ZOOMS.count - 1;
  #assert coder_page_zoom_set(s, 99) == max_z && cp_scale(s) == CP_ZOOMS[max_z];
  #assert coder_page_zoom(s, 1) == max_z;
  #assert coder_page_zoom_set(s, CP_ZOOM_USUAL) == CP_ZOOM_USUAL;
  // Sidebar and pane width clamping on setter.
  coder_page_sides_set(s, 50.0f32, 100.0f32);
  #assert s[0].side_w == cast(f32) CP_SIDE_LEAST && s[0].pane_user == cast(f32) CP_PANE_LEAST;
  coder_page_sides_set(s, 9999.0f32, 9999.0f32);
  #assert s[0].side_w == cast(f32) CP_SIDE_MOST && s[0].pane_user == cast(f32) CP_PANE_MOST;
  coder_page_sides_set(s, 0.0f32, 0.0f32);
  #assert s[0].side_w == 0.0f32 && s[0].pane_user == 0.0f32;
  // When pane_user leaves less than CP_PANE_MAIN, layout gives the pane the whole window; with room, it uses pane_user.
  #assert coder_page_set_text(s, "open pane") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"work\"}],\"ticket\":1}") == MWW_DELEGATE;
  coder_page_sides_set(s, 0.0f32, cast(f32) CP_PANE_MOST);
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], 1000.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].pane_w == 1000.0f32 && s[0].col_w == 0;
  coder_page_sides_set(s, 0.0f32, cast(f32) CP_PANE_LEAST);
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, true, false);
  cp_layout(s, f[..], 1000.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].pane_w == cast(f32) CP_PANE_LEAST && s[0].col_w > 0;
}

#test "foreman chat renders GPU Foreman HUD with clickable managed worker nodes and compact toggle" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  coder_page_chats(s, "m1\tManaged task\t1\t0\t1\nr1\tRegular\n");
  coder_page_foreman(s, true, CP_FOREMAN_TIER_AUTO);
  coder_page_current(s, "foreman");
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 500.0f32, 800.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  ti := surface_find(s[0].surface[..], "foreman.hud.toggle");
  n1 := surface_find(s[0].surface[..], "foreman.node.chat.m1");
  #assert ti >= 0 && n1 >= 0 && surface_find(s[0].surface[..], "foreman.node.chat.r1") < 0;
  #assert cp_press(s, n1);
  #assert coder_page_action(s) == CP_ASK_OPEN && s[0].open == 0 && cast(string) s[0].chats[0].id[5..<s[0].chats[0].id_n] == "m1";
  #assert cp_press(s, ti);
  #assert s[0].foreman_hud_collapsed;
}

#test "sidebar collapse toggle hides and restores the persistent sidebar on wide windows" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  f: [1] UiFrame;
  // Wide window starts with persistent sidebar and a Hide sidebar toggle
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 1400.0f32, 900.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side > 0 && !s[0].side_collapsed;
  row := surface_find(s[0].surface[..], "coder.side.toggle");
  #assert row >= 0 && surface_action(s[0].surface[..], row) == CP_SIDE_TOGGLE;
  // Pressing the toggle collapses the sidebar and shows the Show sidebar toggle in the main pane
  #assert cp_press(s, row) && s[0].side_collapsed;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 1400.0f32, 900.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  // it slides out (#13773), then the window goes idle with no sidebar
  full := cast(f32) CP_SIDE;
  #assert s[0].side > 0 && s[0].side < full;
  #assert cp_test_settle(s, f[..], 1400.0f32, 900.0f32) <= 16 && s[0].side == 0;
  row2 := surface_find(s[0].surface[..], "coder.side.toggle");
  #assert row2 >= 0 && surface_action(s[0].surface[..], row2) == CP_SIDE_TOGGLE;
  // Pressing again restores the persistent sidebar
  #assert cp_press(s, row2) && !s[0].side_collapsed;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.048, 0.016, false, false);
  cp_layout(s, f[..], 1400.0f32, 900.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert s[0].side > 0 && s[0].side < full;
  #assert cp_test_settle(s, f[..], 1400.0f32, 900.0f32) <= 16 && s[0].side == full;
  // with reduced motion it is gone at once
  #assert cp_press(s, surface_find(s[0].surface[..], "coder.side.toggle")) && s[0].side_collapsed;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.064, 0.016, true, false);
  cp_layout(s, f[..], 1400.0f32, 900.0f32);
  #assert !uiframe_moving(f[..]) && uiframe_end(f[..], s[0].surface[..]) && s[0].side == 0;
}
#test "a trackpad flick coasts the transcript, a gesture stays with its view, and the system's momentum goes unused" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  coder_page_now(s, 100);
  sc := cp_scale(s);
  s[0].d = 2; s[0].side = 200; s[0].px = 600; s[0].content = 5000; s[0].view = 500; s[0].scroll = 4500; s[0].stick = true;
  s[0].side_content = 3000; s[0].side_view = 500;
  // fingers up the transcript (down the screen) at 2400 points a second: it lets go of the newest message
  t: f64 = 100;
  coder_page_scroll(s, 0, true, 1, 0, t);
  for i: 0..<30 { t += 1.0f64 / 120.0f64; coder_page_scroll(s, 20 * sc, true, 2, 0, t); }
  #assert !s[0].stick && abs(s[0].scroll - 3900) < 0.5 && s[0].scr_at == CP_SCR_TALK;
  // the pointer moves over the chats mid-gesture: the gesture stays with the transcript
  s[0].px = 50;
  coder_page_scroll(s, 0, true, 3, 0, t);
  #assert s[0].scr[0].coasting && s[0].side_scroll == 0;
  was := s[0].scroll;
  coder_page_scroll(s, 30 * sc, true, 0, 2, t);
  #assert s[0].scroll == was;
  for i: 0..<300 { t += 1.0f64 / 120.0f64; coder_page_now(s, t); _ := cp_scroll_step(s, t); }
  #assert !s[0].scr[0].coasting && s[0].scroll < was - 100 && s[0].scroll == floor(s[0].scroll);
  // a mouse's notch over the chats moves them 22.75 points, and never stretches
  coder_page_scroll(s, -1, false, 0, 0, t);
  #assert abs(s[0].side_scroll - 22.75 / sc) < 0.01 && s[0].side_scr[0].stretch == 0;
  coder_page_scroll(s, 10, false, 0, 0, t);
  #assert s[0].side_scroll == 0 && s[0].side_scr[0].stretch == 0;
  // the rail keeps frames coming while it lingers, then lets them stop
  coder_page_now(s, t + 0.5); #assert cp_scroll_step(s, t + 0.5);
  coder_page_now(s, t + 3); #assert !cp_scroll_step(s, t + 3);
}

// A committed row by id (none: an empty row at -1, -1).
cp_bar_row :: (s: [] CoderPage, id: string) -> El {
  i := surface_find(s[0].surface[..], id);
  return ifx i >= 0 then surface_rows(s[0].surface[..]).rows[i] else El.{x = -1, y = -1};
}
cp_bar_draw :: (s: [] CoderPage, f: [] UiFrame, w: f32, h: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f, w, h);
  return uiframe_end(f, s[0].surface[..]);
}
#test "the title bar: 38 points, the toggle 88 in on the lights' line whether the sidebar shows or not, everything else under it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  f: [1] UiFrame;
  #assert cp_bar(s) == 38 && cp_bar_line(s) == 20 && cp_bar_toggle_x(s) == 88;
  #assert coder_page_set_text(s, "check the bar") && coder_page_submit(s);
  #assert cp_bar_draw(s, f[..], 1400, 900) && s[0].side > 0;
  // open: the toggle and search icon on the bar, 24 across, centred on the lights' line 20 down
  t := cp_bar_row(s, "coder.side.toggle");
  sr := cp_bar_row(s, "coder.search");
  #assert t.x == 88 && t.w == 24 && abs(t.y + t.h / 2 - 20) < 0.01 && t.action == CP_SIDE_TOGGLE;
  #assert cast(string) t.label[0..<t.label_n] == "Hide sidebar";
  #assert sr.x == 88 + 24 + 4 && sr.w == 24 && abs(sr.y + sr.h / 2 - 20) < 0.01 && sr.action == CP_PALETTE;
  #assert cast(string) sr.label[0..<sr.label_n] == "Search";
  // the sidebar's first row, the first message and the corners' buttons: under the bar, or on its line
  #assert cp_bar_row(s, "coder.new").y >= 38 && cp_bar_row(s, "t0.u").y >= 38;
  c := cp_bar_row(s, "coder.copy");
  #assert c.y >= 0 && c.y + c.h <= 38 && abs(c.y + c.h / 2 - 20) < 0.01;
  // the bar moves the window where nothing is: not on the toggle, search icon, a corner's button, under the bar or on the sidebar's edge
  #assert coder_page_bar_drags(s, 200, 10) && coder_page_bar_drags(s, 700, 30);
  #assert !coder_page_bar_drags(s, t.x + 4, t.y + 4) && !coder_page_bar_drags(s, sr.x + 4, sr.y + 4) && !coder_page_bar_drags(s, c.x + 4, c.y + 4);
  #assert !coder_page_bar_drags(s, 700, 38) && !coder_page_bar_drags(s, s[0].side, 10);
  // collapsed: the toggle and search stay where they were, Show sidebar, with the island behind them and the lights
  #assert cp_press(s, surface_find(s[0].surface[..], "coder.side.toggle")) && s[0].side_collapsed;
  #assert cp_bar_draw(s, f[..], 1400, 900) && cp_test_settle(s, f[..], 1400, 900) < 60 && s[0].side == 0;
  t = cp_bar_row(s, "coder.side.toggle");
  sr = cp_bar_row(s, "coder.search");
  #assert t.x == 88 && abs(t.y + t.h / 2 - 20) < 0.01 && cast(string) t.label[0..<t.label_n] == "Show sidebar";
  #assert sr.x == 88 + 24 + 4 && abs(sr.y + sr.h / 2 - 20) < 0.01;
  i := cp_island(s, true);
  #assert i.x == 6 && i.y == 4 && i.h == 32 && i.x + i.w == 88 + 24 + 4 + 24 + 10;   // zeron.island: inset 6, pad 4, two 24pt controls + 4pt gap
  #assert cp_bar_row(s, "t0.u").y >= 38 && coder_page_bar_drags(s, 170, 20);
  // a narrow window can't show the sidebar: no toggle, search icon sits past the lights in the island
  #assert cp_bar_draw(s, f[..], 900, 900) && surface_find(s[0].surface[..], "coder.side.toggle") < 0 && cp_bar_row(s, "coder.search").x == 88;
  i = cp_island(s, false);
  #assert i.x == 6 && i.x + i.w == 88 + 24 + 10;
  // full screen hides the lights: the toggle takes the window's edge and search sits beside it
  coder_page_bar_full(s, true);
  #assert cp_bar_draw(s, f[..], 1400, 900) && cp_bar_row(s, "coder.side.toggle").x == 12 && cp_bar_row(s, "coder.search").x == 12 + 24 + 4;
  coder_page_bar_full(s, false);
  // a larger text size keeps the bar's places in window points
  #assert coder_page_zoom_set(s, 7) == 7 && abs(cp_bar(s) * cp_scale(s) - 38) < 0.01 && abs(cp_bar_toggle_x(s) * cp_scale(s) - 88) < 0.01;
}
#test "settings start under the title bar, and a press on its empty part moves the window" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  f: [1] UiFrame;
  coder_page_settings_open(s, CP_PG_GENERAL, "");
  #assert cp_bar_draw(s, f[..], 1200, 700);
  #assert cp_bar_row(s, "set.back").y >= 38 && cp_bar_row(s, "set.title").y >= 38;
  #assert surface_find(s[0].surface[..], "coder.side.toggle") < 0 && coder_page_bar_drags(s, 120, 20);
}
