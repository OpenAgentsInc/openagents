// Checks for the page's models.coax: the model picker and OpenRouter models. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "OpenRouter: the set model is a picker entry and a sub-agent level, routed as openrouter: ids, kept by save/load" {
  p: [1] CoderPage; p2: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert cp_models(s) == CP_MODELS;                              // none set: no entry, no level offered
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].openrouter == "" && back[0].model == "gemini-4-neon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "moonshotai/kimi-k3");
  #assert cp_models(s) == CP_MODELS + 1 && cp_model_label(s, CP_MODEL_OR) == "deepseek-v4.1-flash-1017" && cp_model_desc(s, CP_MODEL_OR) == "OpenRouter";
  #assert cp_model_meta(s, CP_MODEL_OR) == "Microcoder · OpenRouter · deepseek/deepseek-v4.1-flash-1017";
  s[0].model = CP_MODEL_OR;
  #assert coder_page_set_text(s, "ship it") && coder_page_submit(s);
  ar[0].at = 0;
  n = coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "openrouter:deepseek/deepseek-v4.1-flash-1017" && back[0].openrouter == "moonshotai/kimi-k3";
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"openrouter\",\"task\":\"build it\"},{\"level\":\"opus\",\"task\":\"review\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert CP_LEVEL_NAME[s[0].turns[1].agents[0].level] == "OpenRouter" && !coder_page_agent_claude(s, 0) && coder_page_agent_claude(s, 1);
  #assert coder_page_agent_next(s) == 0;
  ar[0].at = 0;
  n = coder_page_agent_task(s, 0, "s-a0", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "openrouter:moonshotai/kimi-k3" && back[0].effort == "medium" && !back[0].agents;
  s[0].clock = s[0].turns[1].agents[0].heard + 4;
  wb: [256] u8;
  #assert cp_agent_wait(s, 1, 0, wb[..]) == "waiting on OpenRouter · 4s";
  // saved by its id, found again as the OpenRouter entry; clearing the setting goes back to Neon
  saved: [65536] u8; sn := coder_page_save(s, saved[..]);
  p2_st: [1] CpCheckLean; s2 := cp_check_lean(p2[..], p2_st[..]); cp_init(s2);
  coder_page_set_openrouter(s2, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert sn > 0 && coder_page_load(s2, cast(string) saved[0..<sn]) && s2[0].model == CP_MODEL_OR && s2[0].turns[1].model == CP_MODEL_OR && s2[0].turns[1].agents[0].level == CP_LEVEL_OR;
  coder_page_set_openrouter(s2, "", "");
  #assert s2[0].model == CP_MODEL_DEFAULT && cp_model_id(s2, CP_MODEL_OR) == "gemini-4-neon";
  // a launch's --model
  #assert !coder_page_pick_model(s2, "openrouter") && coder_page_pick_model(s2, "Carbon") && s2[0].model == 1 && !coder_page_pick_model(s2, "gpt");
  coder_page_set_openrouter(s2, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert coder_page_pick_model(s2, "openrouter") && s2[0].model == CP_MODEL_OR && coder_page_pick_model(s2, "gemini-4-neon") && s2[0].model == CP_MODEL_DEFAULT;
}

#test "composer model picker defaults to Neon, switches models per chat, routes tasks, and persists across save/load/take/new" {
  p: [1] CoderPage; p2: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  #assert s[0].model == CP_MODEL_DEFAULT && cp_model_id(s, s[0].model) == "gemini-4-neon";
  // First turn uses default Neon.
  #assert coder_page_set_text(s, "first") && coder_page_submit(s);
  out: [4096] u8;
  n := coder_page_task(s, "sess-1", "/w", out[..]);
  ar: [1] ClArena; ab: [2048] u8; ar[0] = ClArena.{buf = ab[..]};
  back: [1] McTask;
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "gemini-4-neon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  // Layout and open the model picker popover via the composer button.
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && !s[0].model_menu;
  #assert cp_press(s, btn);
  #assert s[0].model_menu;
  // Re-layout with popover open: all 4 model options appear.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  opt0 := surface_find(s[0].surface[..], "coder.model.0");
  opt1 := surface_find(s[0].surface[..], "coder.model.1");
  opt2 := surface_find(s[0].surface[..], "coder.model.2");
  opt3 := surface_find(s[0].surface[..], "coder.model.3");
  #assert opt0 >= 0 && opt1 >= 0 && opt2 >= 0 && opt3 >= 0;
  // Pick Gemini 4 Carbon (index 1).
  #assert cp_press(s, opt1);
  #assert !s[0].model_menu && s[0].model == 1 && cp_model_id(s, s[0].model) == "gemini-4-carbon";
  #assert coder_page_save_due(s);
  // Second turn routes to Carbon while first turn remembers Neon.
  #assert coder_page_set_text(s, "second") && coder_page_submit(s);
  n = coder_page_task(s, "sess-1", "/w", out[..]);
  ar[0].at = 0;
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "gemini-4-carbon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok2\"}") == MWW_ENDED;
  #assert s[0].turns[0].model == 0 && s[0].turns[1].model == 1;
  // Clicking outside an open popover dismisses it.
  s[0].model_menu = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert coder_page_pointer(s, 10.0f32, 10.0f32, 0);
  #assert !s[0].model_menu;
  // Save/load preserves chat model and per-turn models.
  saved: [16384] u8;
  sn := coder_page_save(s, saved[..]);
  #assert sn > 0;
  p2_st: [1] CpCheckLean; s2 := cp_check_lean(p2[..], p2_st[..]);
  cp_init(s2);
  #assert coder_page_load(s2, cast(string) saved[0..<sn]);
  #assert s2[0].model == 1 && s2[0].turns[0].model == 0 && s2[0].turns[1].model == 1;
  // coder_page_take transfers selected model and resets source to Neon.
  s3 := s;   // the chat in s goes; s2's takes its place
  #assert coder_page_take(s3, s2);
  #assert s3[0].model == 1 && s2[0].model == CP_MODEL_DEFAULT;
  // New chat resets selected model to Neon.
  #assert cp_new(s3);
  #assert s3[0].model == CP_MODEL_DEFAULT && !s3[0].model_menu;
  // Loading an older saved chat without a model field defaults to Neon.
  #assert coder_page_load(s3, "{\"turns\":[{\"ask\":\"hi\",\"reply\":\"yo\",\"state\":1}]}");
  #assert s3[0].model == CP_MODEL_DEFAULT && s3[0].turns[0].model == CP_MODEL_DEFAULT;
}

#test "OpenRouter model picker popover clears the composer, keeps presses from the composer's editor while open, and receives clicks" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); test_atlas(s[0].atlas[..]);
  s[0].d = 1.0f32;
  s[0].nturns = 1;
  coder_page_set_openrouter(s, "anthropic/claude-sonnet-4", "");
  #assert cp_models(s) == 5;
  f: [1] UiFrame;
  // Closed state: the composer's editor takes a press.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert cp_test_press_field(s, CP_ED_COMPOSER);
  // Open the model menu popover.
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && cp_press(s, btn) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  // While open, a press is the popover's, never the editor's.
  #assert !cp_test_press_field(s, CP_ED_COMPOSER);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  comp := elt_find(t[..], "coder.composer");
  menu := elt_find(t[..], "coder.model.menu");
  or_opt := elt_find(t[..], "coder.model.4");
  #assert comp >= 0 && menu >= 0 && or_opt >= 0;
  // When docked at the bottom (s[0].d == 1), popover sits above the composer (no overlap).
  #assert t[0].rows[menu].y + t[0].rows[menu].h <= t[0].rows[comp].y;
  #assert t[0].rows[or_opt].y + t[0].rows[or_opt].h <= t[0].rows[comp].y;
  // Clicking the center of the OpenRouter option hits coder.model.4 and selects OpenRouter.
  cx := t[0].rows[or_opt].x + t[0].rows[or_opt].w * 0.5f32;
  cy := t[0].rows[or_opt].y + t[0].rows[or_opt].h * 0.5f32;
  #assert surface_hit(s[0].surface[..], cx, cy) == or_opt;
  #assert coder_page_pointer(s, cx, cy, 0);
  #assert coder_page_pointer(s, cx, cy, 2);
  #assert !s[0].model_menu && s[0].model == CP_MODEL_OR;
  // Once closed, the editor takes presses again.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert cp_test_press_field(s, CP_ED_COMPOSER);
}

#test "Centred new chat opens the model picker popover below the model chip" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); test_atlas(s[0].atlas[..]);
  s[0].d = 0.0f32;
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && cp_press(s, btn) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  comp := elt_find(t[..], "coder.composer");
  chip := elt_find(t[..], "coder.model");
  menu := elt_find(t[..], "coder.model.menu");
  #assert comp >= 0 && chip >= 0 && menu >= 0;
  #assert t[0].rows[menu].y >= t[0].rows[chip].y + t[0].rows[chip].h;
  #assert t[0].rows[menu].y >= t[0].rows[comp].y + t[0].rows[comp].h;
}

#test "Antigravity appears in the model picker when installed, is selectable, and persists" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  s[0].experimental = true; s[0].cloud_authed = true;
  #assert !coder_page_model_agy(s) && cp_models(s) == CP_MODELS;
  #assert !coder_page_pick_model(s, "antigravity");
  coder_page_set_agy(s, true);
  #assert cp_models(s) == CP_MODELS + 1;
  #assert cp_model_label(s, CP_MODELS) == "Antigravity";
  #assert cp_model_id(s, CP_MODELS) == "antigravity";
  // the row names the CLI and the mode picked in Settings
  // never "default model": before agy has said which model it runs, the row says so
  #assert cp_model_desc(s, CP_MODELS) == "Antigravity CLI · Auto" && cp_model_meta(s, CP_MODELS) == "Antigravity CLI · model not reported yet";
  coder_page_settings_agy(s, "v1.5.12 (ready)", 0, "Default", "Google sign-in");
  #assert cp_model_meta(s, CP_MODELS) == "Antigravity CLI · model not reported yet";
  // what agy opens a session on with no model set (agyworker --probe): its real model
  coder_page_agy_seen(s, "gemini-4-carbon-low", "Gemini 4 Carbon (Low)");
  #assert cp_model_meta(s, CP_MODELS) == "Antigravity CLI · Gemini 4 Carbon (Low)" && cp_model_desc(s, CP_MODELS) == "Antigravity CLI · Gemini 4 Carbon (Low) · Auto";
  // a model set in Settings and not probed yet: that model
  coder_page_agy_seen(s, "", "");
  coder_page_settings_agy(s, "v1.5.12 (ready)", 0, "gemini-4-hydrogen · high", "Google sign-in");
  #assert cp_model_meta(s, CP_MODELS) == "Antigravity CLI · gemini-4-hydrogen · high";
  s[0].set_agy_mode = 2;
  #assert cp_model_desc(s, CP_MODELS) == "Antigravity CLI · gemini-4-hydrogen · high · Plan";
  s[0].set_agy_mode = 1;
  #assert cp_model_desc(s, CP_MODELS) == "Antigravity CLI · gemini-4-hydrogen · high · Default";
  s[0].set_agy_mode = 0;
  #assert coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
  // Also works alongside OpenRouter without shifting OpenRouter's index.
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash", "");
  #assert cp_models(s) == CP_MODELS + 2 && cp_is_or(s, CP_MODEL_OR) && cp_is_agy(s, CP_MODELS + 1);
  #assert coder_page_pick_model(s, "agy") && coder_page_model_agy(s);
  // Removing Antigravity resets the selection back to default.
  coder_page_set_agy(s, false);
  #assert !coder_page_model_agy(s) && s[0].model == CP_MODEL_DEFAULT;
}

#test "cloud models require experimental && cloud_authed; otherwise local-harness-only (Antigravity)" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  // Default unauthed / experimental off: no cloud models.
  coder_page_experimental_set(s, false);
  coder_page_set_cloud_authed(s, false);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 0 && !coder_page_pick_model(s, "gemini-4-neon");
  // With Antigravity installed, it is the sole entry and selected automatically.
  coder_page_set_agy(s, true);
  #assert cp_models(s) == 1 && coder_page_model_agy(s) && cp_model_label(s, 0) == "Antigravity";
  // Experimental on alone (not logged in) still hides cloud models.
  coder_page_experimental_set(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 1 && coder_page_model_agy(s);
  // Logged in alone (experimental off) still hides cloud models.
  coder_page_experimental_set(s, false);
  coder_page_set_cloud_authed(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 1 && coder_page_model_agy(s);
  // Both experimental && logged in: cloud models appear and Antigravity stays selected.
  coder_page_experimental_set(s, true);
  #assert coder_page_cloud_ok(s) && cp_models(s) == CP_MODELS + 1 && coder_page_model_agy(s);
  #assert coder_page_pick_model(s, "gemini-4-neon") && !coder_page_model_agy(s);
  // Logging out drops back to Antigravity.
  coder_page_set_cloud_authed(s, false);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 1 && coder_page_model_agy(s);
}

#test "the backend label names what runs the next message: Antigravity CLI, OpenRouter, the Gemini API, nothing with no model" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  // no Gemini key, not signed in, no agy: no model, no label
  coder_page_experimental_set(s, false); coder_page_set_cloud_authed(s, false);
  #assert cp_model_index(s) < 0 && cp_backend_label(s) == "";
  // agy installed and the only entry
  coder_page_set_agy(s, true);
  #assert cp_backend_label(s) == "Antigravity CLI";
  // a Gemini key set in Settings: Gemini models run on Microcoder through the Gemini API, shown in the dropdown
  s[0].set_gemini_n = cp_out(s[0].set_gemini[..], "Ends 1a2b"); s[0].model = cp_model_index(s);
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Gemini API" && cp_model_desc(s, 0) == "Fast frontier · Gemini API";
  #assert coder_page_pick_model(s, "agy") && cp_backend_label(s) == "Antigravity CLI";
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert coder_page_pick_model(s, "openrouter") && cp_backend_label(s) == "OpenRouter" && cp_model_desc(s, CP_MODEL_OR) == "OpenRouter";
  // no key, signed in with Experimental features: still Gemini
  s[0].set_gemini_n = 0; coder_page_experimental_set(s, true); coder_page_set_cloud_authed(s, true);
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Gemini API";
  // Microcoder will answer on Vertex AI (a service account on disk, mcworker --auth): the dropdown says so
  coder_page_settings_gauth(s, "vertex", "Vertex AI (service account, project openagentsgemini)");
  #assert cp_backend_label(s) == "Vertex AI" && cp_model_desc(s, 0) == "Fast frontier · Vertex AI";
  coder_page_settings_gauth(s, "key", "API key ending 1a2b (~/work/.secrets)");
  #assert cp_backend_label(s) == "Gemini API" && cp_model_desc(s, 0) == "Fast frontier · Gemini API";
  // the menu and the palette keep each row's line, so one row's line never becomes another's
  d0 := cp_model_desc(s, 0); d1 := cp_model_desc(s, 1); da := cp_model_desc(s, CP_MODELS);
  #assert d0 == "Fast frontier · Gemini API" && d1 == "Deep reasoning · Gemini API" && cp_model_desc(s, 3) == "Heavyweight · Gemini API";
  #assert d0 != d1 && da.count > 0 && d0 != da;
}

#test "a Vertex AI or API key sign-in Microcoder finds on its own runs Gemini models with no key in Settings" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  coder_page_experimental_set(s, false); coder_page_set_cloud_authed(s, false);
  coder_page_set_agy(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 1;
  // the owner's setup: ~/work/.secrets/vertex-sa-inference.json and gcloud, no key in Settings
  coder_page_settings_gauth(s, "vertex", "Vertex AI (service account, project openagentsgemini)");
  #assert coder_page_cloud_ok(s) && cp_models(s) == CP_MODELS + 1 && coder_page_model_agy(s);
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Vertex AI";
  // a Gemini API key in ~/work/.secrets or the environment counts too
  coder_page_settings_gauth(s, "key", "API key ending 1a2b (GEMINI_API_KEY)");
  #assert coder_page_cloud_ok(s) && !s[0].gauth_vertex;
  // none found: back to Antigravity alone
  coder_page_settings_gauth(s, "none", "");
  #assert !coder_page_cloud_ok(s) && cp_models(s) == 1 && coder_page_model_agy(s);
}

#test "a reply's label names the model Antigravity reported running, and keeps it with the chat" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "antigravity");
  coder_page_agy_seen(s, "gemini-4-carbon-low", "Gemini 4 Carbon (Low)");
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  _ = coder_page_line(s, "{\"kind\":\"attempt\",\"schema\":\"coder.observability.v2\",\"scope\":\"request_attempt\",\"engine\":null,\"gateway\":\"antigravity\",\"model\":\"gemini-4-argon-high\",\"model_source\":\"attempt_configuration\",\"requested_effort\":null,\"outcome\":\"configured\",\"status\":0,\"usd_micros\":-1}");
  #assert cp_turn_meta(s, 0) == "Antigravity CLI · gemini-4-argon-high";
  // the probe's model: its name
  _ = coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"antigravity\",\"model\":\"gemini-4-carbon-low\",\"outcome\":\"configured\",\"status\":0}");
  #assert cp_turn_meta(s, 0) == "Antigravity CLI · Gemini 4 Carbon (Low)";
}

#test "an Antigravity turn's task line names no effort, so Settings or agyworker's medium decides; Microcoder's names low" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "gemini-4-neon" && back[0].effort == "low";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "antigravity");
  #assert coder_page_set_text(s, "fix the test") && coder_page_submit(s);
  ar[0].at = 0;
  n = coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "antigravity" && back[0].effort == "";
  #assert !cp_contains(cast(string) out[0..<n], "\"effort\"");
}
