// Checks for the page's models.coax: the model picker and OpenRouter models. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "OpenRouter: the set model is a picker entry and a sub-agent level, routed as openrouter: ids, kept by save/load" {
  p: [1] CoderPage; p2: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS;        // Flawed (0..3) + Inkling (4) + 4 Gemini (5..8); no OpenRouter yet
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_pick_model(s, "gemini-4-neon");
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].openrouter == "" && back[0].model == "gemini-4-neon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "moonshotai/kimi-k3");
  or_i := CP_FLAWED_MODELS + 1 + CP_MODEL_OR;
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 1 && cp_model_label(s, or_i) == "deepseek-v4.1-flash-1017" && cp_model_desc(s, or_i) == "OpenRouter";
  #assert cp_model_meta(s, or_i) == "Microcoder · OpenRouter · deepseek/deepseek-v4.1-flash-1017";
  s[0].model = or_i;
  #assert coder_page_set_text(s, "ship it") && coder_page_submit(s);
  ar[0].at = 0;
  n = coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "openrouter:deepseek/deepseek-v4.1-flash-1017" && back[0].openrouter == "moonshotai/kimi-k3";
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"openrouter\",\"task\":\"build it\"},{\"level\":\"opus\",\"task\":\"review\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert CP_LEVEL_NAME[s[0].turns[1].agents[0].level] == "OpenRouter" && !coder_page_agent_claude(s, 0) && coder_page_agent_claude(s, 1);
  #assert coder_page_agent_next(s) == 0;
  ar[0].at = 0;
  n = coder_page_agent_task(s, 0, "s-a0", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "openrouter:moonshotai/kimi-k3" && back[0].effort == "medium" && !back[0].agents;
  s[0].clock = s[0].turns[1].agents[0].heard + 4;
  wb: [256] u8;
  #assert cp_agent_wait(s, 1, 0, wb[..]) == "waiting on OpenRouter · 4s";
  // saved by its id, found again as the OpenRouter entry; clearing the setting goes back to start model
  saved: [65536] u8; sn := coder_page_save(s, saved[..]);
  p2_st: [1] CpCheckLean; s2 := cp_check_lean(p2[..], p2_st[..]); cp_init(s2);
  coder_page_set_openrouter(s2, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert sn > 0 && coder_page_load(s2, cast(string) saved[0..<sn]) && s2[0].model == or_i && s2[0].turns[1].model == or_i && s2[0].turns[1].agents[0].level == CP_LEVEL_OR;
  coder_page_set_openrouter(s2, "", "");
  #assert s2[0].model == cp_model_start(s2) && cp_model_id(s2, s2[0].model) == "flawed:gemini-4-neon";
  // a launch's --model
  #assert !coder_page_pick_model(s2, "openrouter") && coder_page_pick_model(s2, "Carbon") && cp_model_id(s2, s2[0].model) == "gemini-4-carbon" && !coder_page_pick_model(s2, "gpt");
  coder_page_set_openrouter(s2, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert coder_page_pick_model(s2, "openrouter") && s2[0].model == or_i && coder_page_pick_model(s2, "gemini-4-neon") && cp_model_id(s2, s2[0].model) == "gemini-4-neon";
  // Inkling 2 Mini local model (#13825) is ALWAYS present in the picker (entry CP_FLAWED_MODELS), even before download
  #assert coder_page_pick_model(s2, "inkling-2-mini") && coder_page_model_inkling(s2) && s2[0].model == CP_FLAWED_MODELS;
  coder_page_set_inkling(s2, true);
  #assert coder_page_pick_model(s2, "inkling-2-mini");
  #assert coder_page_model_inkling(s2);
  #assert cp_model_id(s2, s2[0].model) == "inkling-2-mini";
  #assert cp_model_label(s2, s2[0].model) == "Inkling 2 Mini";
  #assert cp_backend_label(s2) == "Psionic Metal";
  #assert coder_page_set_text(s2, "hello inkling") && coder_page_submit(s2);
  n = coder_page_task(s2, "sess-local", "/w", out[..]);
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].local && back[0].model == "inkling-2-mini";
  #assert coder_page_line(s2, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_set_inkling(s2, false);
  // Still stays on Inkling entry (always visible so user can re-download if needed).
  #assert coder_page_model_inkling(s2) && s2[0].model == CP_FLAWED_MODELS;
}

#test "composer model picker switches models per chat, routes tasks, and persists across save/load/take/new" {
  p: [1] CoderPage; p2: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  s[0].d = 1.0f32;
  s[0].ready = true;
  flaw_i := cp_model_find_exact(s, "flawed:gemini-4-neon");
  neon_i := cp_model_find_exact(s, "gemini-4-neon");
  carb_i := cp_model_find_exact(s, "gemini-4-carbon");
  #assert s[0].model == flaw_i && cp_model_id(s, s[0].model) == "flawed:gemini-4-neon";
  // First turn uses default Flawed · Gemini 4 Neon (inkling not installed).
  #assert coder_page_set_text(s, "first") && coder_page_submit(s);
  out: [4096] u8;
  n := coder_page_task(s, "sess-1", "/w", out[..]);
  ar: [1] ClArena; ab: [2048] u8; ar[0] = ClArena.{buf = ab[..]};
  back: [1] McTask;
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "flawed:gemini-4-neon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  // Layout and open the model picker popover via the composer button.
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && !s[0].model_menu;
  #assert cp_press(s, btn);
  #assert s[0].model_menu;
  // Re-layout with popover open: Flawed (0..3) + Inkling (4) + all 4 Gemini options (5..8) appear.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  opt0 := surface_find(s[0].surface[..], "coder.model.0");
  opt1 := surface_find(s[0].surface[..], "coder.model.1");
  opt2 := surface_find(s[0].surface[..], "coder.model.2");
  opt3 := surface_find(s[0].surface[..], "coder.model.3");
  opt4 := surface_find(s[0].surface[..], "coder.model.4");
  opt_carb := surface_find(s[0].surface[..], "coder.model.7");
  #assert opt0 >= 0 && opt1 >= 0 && opt2 >= 0 && opt3 >= 0 && opt4 >= 0 && opt_carb >= 0;
  // Pick Gemini 4 Carbon (index 7).
  #assert cp_press(s, opt_carb);
  #assert !s[0].model_menu && s[0].model == carb_i && cp_model_id(s, s[0].model) == "gemini-4-carbon";
  #assert coder_page_save_due(s);
  // Second turn routes to Carbon while first turn remembers Flawed.
  #assert coder_page_set_text(s, "second") && coder_page_submit(s);
  n = coder_page_task(s, "sess-1", "/w", out[..]);
  ar[0].at = 0;
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "gemini-4-carbon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok2\"}") == MWW_ENDED;
  #assert s[0].turns[0].model == flaw_i && s[0].turns[1].model == carb_i;
  // Clicking outside an open popover dismisses it.
  s[0].model_menu = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert coder_page_pointer(s, 10.0f32, 10.0f32, 0);
  #assert !s[0].model_menu;
  // Save/load preserves chat model and per-turn models.
  saved: [16384] u8;
  sn := coder_page_save(s, saved[..]);
  #assert sn > 0;
  p2_st: [1] CpCheckLean; s2 := cp_check_lean(p2[..], p2_st[..]);
  cp_init(s2);
  #assert coder_page_load(s2, cast(string) saved[0..<sn]);
  #assert s2[0].model == carb_i && s2[0].turns[0].model == flaw_i && s2[0].turns[1].model == carb_i;
  // coder_page_take transfers selected model and resets source to start model.
  s3 := s;   // the chat in s goes; s2's takes its place
  #assert coder_page_take(s3, s2);
  #assert s3[0].model == carb_i && s2[0].model == flaw_i;
  // New chat resets selected model to start model.
  #assert cp_new(s3);
  #assert s3[0].model == flaw_i && !s3[0].model_menu;
  // Loading an older saved chat without a model field defaults to start model.
  #assert coder_page_load(s3, "{\"turns\":[{\"ask\":\"hi\",\"reply\":\"yo\",\"state\":1}]}");
  #assert s3[0].model == flaw_i && s3[0].turns[0].model == flaw_i;
  _ = neon_i;
}

#test "OpenRouter model picker popover clears the composer, keeps presses from the composer's editor while open, and receives clicks" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); test_atlas(s[0].atlas[..]);
  s[0].d = 1.0f32;
  s[0].nturns = 1;
  coder_page_set_openrouter(s, "anthropic/claude-sonnet-4", "");
  #assert cp_models(s) == CP_FLAWED_MODELS + 6;
  f: [1] UiFrame;
  // Closed state: the composer's editor takes a press.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert cp_test_press_field(s, CP_ED_COMPOSER);
  // Open the model menu popover.
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && cp_press(s, btn) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  // While open, a press is the popover's, never the editor's.
  #assert !cp_test_press_field(s, CP_ED_COMPOSER);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  comp := elt_find(t[..], "coder.composer");
  menu := elt_find(t[..], "coder.model.menu");
  or_opt := elt_find(t[..], "coder.model.10");
  #assert comp >= 0 && menu >= 0 && or_opt >= 0;
  // When docked at the bottom (s[0].d == 1), popover sits above the composer (no overlap).
  #assert t[0].rows[menu].y + t[0].rows[menu].h <= t[0].rows[comp].y;
  #assert t[0].rows[or_opt].y + t[0].rows[or_opt].h <= t[0].rows[comp].y;
  // Clicking the center of the OpenRouter option hits coder.model.10 and selects OpenRouter.
  cx := t[0].rows[or_opt].x + t[0].rows[or_opt].w * 0.5f32;
  cy := t[0].rows[or_opt].y + t[0].rows[or_opt].h * 0.5f32;
  #assert surface_hit(s[0].surface[..], cx, cy) == or_opt;
  #assert coder_page_pointer(s, cx, cy, 0);
  #assert coder_page_pointer(s, cx, cy, 2);
  #assert !s[0].model_menu && s[0].model == CP_FLAWED_MODELS + 1 + CP_MODEL_OR;
  // Once closed, the editor takes presses again.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  #assert cp_test_press_field(s, CP_ED_COMPOSER);
}

#test "Centred new chat opens the model picker popover below the model chip" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); test_atlas(s[0].atlas[..]);
  coder_page_show_other_models_set(s, false);
  s[0].d = 0.0f32;
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && cp_press(s, btn) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  comp := elt_find(t[..], "coder.composer");
  chip := elt_find(t[..], "coder.model");
  menu := elt_find(t[..], "coder.model.menu");
  #assert comp >= 0 && chip >= 0 && menu >= 0;
  #assert t[0].rows[menu].y >= t[0].rows[chip].y + t[0].rows[chip].h;
  #assert t[0].rows[menu].y >= t[0].rows[comp].y + t[0].rows[comp].h;
}

#test "Antigravity appears in the model picker when installed and show_other_models is enabled, is selectable, and persists" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  coder_page_show_other_models_set(s, true);
  coder_page_experimental_set(s, true); s[0].cloud_authed = true;
  #assert !coder_page_model_agy(s) && cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS;
  #assert !coder_page_pick_model(s, "antigravity");
  coder_page_set_agy(s, true);
  agy_i := CP_FLAWED_MODELS + 1 + CP_MODELS;
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 1;
  #assert cp_model_label(s, agy_i) == "Antigravity";
  #assert cp_model_id(s, agy_i) == "antigravity";
  // the row names the CLI and the mode picked in Settings
  // never "default model": before agy has said which model it runs, the row says so
  #assert cp_model_desc(s, agy_i) == "Antigravity CLI · Auto" && cp_model_meta(s, agy_i) == "Antigravity CLI · model not reported yet";
  coder_page_settings_agy(s, "v1.5.12 (ready)", 0, "Default", "Google sign-in");
  #assert cp_model_meta(s, agy_i) == "Antigravity CLI · model not reported yet";
  // what agy opens a session on with no model set (agyworker --probe): its real model
  coder_page_agy_seen(s, "gemini-4-carbon-low", "Gemini 4 Carbon (Low)");
  #assert cp_model_meta(s, agy_i) == "Antigravity CLI · Gemini 4 Carbon (Low)" && cp_model_desc(s, agy_i) == "Antigravity CLI · Gemini 4 Carbon (Low) · Auto";
  // a model set in Settings and not probed yet: that model
  coder_page_agy_seen(s, "", "");
  coder_page_settings_agy(s, "v1.5.12 (ready)", 0, "gemini-4-hydrogen · high", "Google sign-in");
  #assert cp_model_meta(s, agy_i) == "Antigravity CLI · gemini-4-hydrogen · high";
  s[0].set_agy_mode = 2;
  #assert cp_model_desc(s, agy_i) == "Antigravity CLI · gemini-4-hydrogen · high · Plan";
  s[0].set_agy_mode = 1;
  #assert cp_model_desc(s, agy_i) == "Antigravity CLI · gemini-4-hydrogen · high · Default";
  s[0].set_agy_mode = 0;
  #assert coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
  // Also works alongside OpenRouter without shifting OpenRouter's index.
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash", "");
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 2 && cp_is_or(s, CP_FLAWED_MODELS + 1 + CP_MODEL_OR) && cp_is_agy(s, CP_FLAWED_MODELS + 1 + CP_MODELS + 1);
  #assert coder_page_pick_model(s, "agy") && coder_page_model_agy(s);
  // Removing Antigravity resets the selection back to start model.
  coder_page_set_agy(s, false);
  #assert !coder_page_model_agy(s) && s[0].model == cp_model_start(s);
}

#test "cloud models require models.gemini + auth + show_other_models; default mode is Flawed + Inkling" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  s[0].local_os_ok = true; s[0].local_hw_ok = true;
  // Default (flags = 0, show_other_models = false): Flawed (5) + Inkling (1) = 6 core models, starting on Flawed · Gemini 4 Neon.
  coder_page_experimental_set(s, false);
  coder_page_set_cloud_authed(s, false);
  #assert !coder_page_cloud_ok(s) && cp_has_model_picker(s) && cp_models(s) == CP_FLAWED_MODELS + 1 && cp_model_id(s, 0) == "flawed:gemini-4-neon" && cp_model_id(s, CP_FLAWED_MODELS) == "inkling-2-mini";
  #assert !coder_page_pick_model(s, "gemini-4-neon");
  // Setting agy while show_other_models == false STILL hides Antigravity.
  coder_page_set_agy(s, true);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 && !coder_page_model_agy(s);
  // Explicitly opting into show_other_models exposes Antigravity alongside Flawed & Inkling.
  coder_page_show_other_models_set(s, true);
  #assert cp_has_model_picker(s) && cp_models(s) == CP_FLAWED_MODELS + 2 && cp_model_label(s, 0) == "Flawed · Gemini 4 Neon" && cp_model_label(s, CP_FLAWED_MODELS) == "Inkling 2 Mini" && cp_model_label(s, CP_FLAWED_MODELS + 1) == "Antigravity";
  #assert coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
  // Experimental on alone (not logged in) still hides cloud models.
  coder_page_experimental_set(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 2 && coder_page_model_agy(s);
  // Logged in alone (experimental off) still hides cloud models, keeping Antigravity available.
  coder_page_experimental_set(s, false);
  coder_page_set_cloud_authed(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 2 && coder_page_model_agy(s);
  // Disabling Antigravity with experimental off returns to core Flawed + Inkling.
  coder_page_set_agy(s, false);
  #assert cp_has_model_picker(s) && cp_models(s) == CP_FLAWED_MODELS + 1 && cp_model_id(s, 0) == "flawed:gemini-4-neon";
  coder_page_set_agy(s, true);
  // Both experimental && logged in: cloud models appear alongside Flawed, Inkling, and Antigravity.
  coder_page_experimental_set(s, true);
  #assert coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 1 && coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
  #assert coder_page_pick_model(s, "gemini-4-neon") && !coder_page_model_agy(s);
  // Logging out drops cloud models; falls back to default Flawed while Antigravity remains selectable.
  coder_page_set_cloud_authed(s, false);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 2 && coder_page_model_flawed(s) && coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
}

#test "the backend label names what runs the next message: Flawed Agent, Psionic Metal, Antigravity CLI, OpenRouter, Gemini API" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  s[0].local_os_ok = true; s[0].local_hw_ok = true;
  // Release default: Flawed Agent (Gemini 4 Neon at slot 0); Inkling 2 Mini is Psionic Metal.
  coder_page_experimental_set(s, false); coder_page_set_cloud_authed(s, false);
  #assert cp_model_index(s) == 0 && cp_backend_label(s) == "Flawed Agent";
  #assert coder_page_pick_model(s, "inkling-2-mini") && cp_backend_label(s) == "Psionic Metal";
  // Even with developer flags and show_other_models on, Flawed & Inkling stay at the top.
  coder_page_show_other_models_set(s, true);
  coder_page_experimental_set(s, true);
  #assert cp_backend_label(s) == "Psionic Metal";
  // agy installed alongside Flawed & Inkling
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "agy") && cp_backend_label(s) == "Antigravity CLI";
  // a Gemini key set in Settings: Gemini models run on Microcoder through the Gemini API, shown in the dropdown
  s[0].set_gemini_n = cp_out(s[0].set_gemini[..], "Ends 1a2b"); s[0].model = cp_model_index(s);
  g0 := CP_FLAWED_MODELS + 1;
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Gemini API" && cp_model_desc(s, g0) == "Fast frontier · Gemini API";
  #assert coder_page_pick_model(s, "agy") && cp_backend_label(s) == "Antigravity CLI";
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert coder_page_pick_model(s, "openrouter") && cp_backend_label(s) == "OpenRouter" && cp_model_desc(s, g0 + CP_MODEL_OR) == "OpenRouter";
  // no key, signed in with Experimental features: still Gemini
  s[0].set_gemini_n = 0; coder_page_experimental_set(s, true); coder_page_set_cloud_authed(s, true);
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Gemini API";
  // Microcoder will answer on Vertex AI (a service account on disk, mcworker --auth): the dropdown says so
  coder_page_settings_gauth(s, "vertex", "Vertex AI (service account, project openagentsgemini)");
  #assert cp_backend_label(s) == "Vertex AI" && cp_model_desc(s, g0) == "Fast frontier · Vertex AI";
  coder_page_settings_gauth(s, "key", "API key ending 1a2b (~/work/.secrets)");
  #assert cp_backend_label(s) == "Gemini API" && cp_model_desc(s, g0) == "Fast frontier · Gemini API";
  // the menu and the palette keep each row's line, so one row's line never becomes another's
  d0 := cp_model_desc(s, g0); d1 := cp_model_desc(s, g0 + 1); da := cp_model_desc(s, g0 + CP_MODELS);
  #assert d0 == "Fast frontier · Gemini API" && d1 == "Deep reasoning · Gemini API" && cp_model_desc(s, g0 + 3) == "Heavyweight · Gemini API";
  #assert d0 != d1 && da.count > 0 && d0 != da;
}

#test "a Vertex AI or API key sign-in Microcoder finds on its own runs Gemini models when models.gemini is enabled" {
  st := [1] CoderPage.[CoderPage.{}];
  s := st[..];
  coder_page_init(s);
  s[0].local_os_ok = true; s[0].local_hw_ok = true;
  coder_page_show_other_models_set(s, true);
  coder_page_flags_set(s, dc_flag_bit(DC_FLAG_MODELS_GEMINI) | dc_flag_bit(DC_FLAG_MODELS_ANTIGRAVITY));
  coder_page_set_cloud_authed(s, false);
  coder_page_set_agy(s, true);
  #assert !coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 2;
  #assert coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
  // the owner's setup: ~/work/.secrets/vertex-sa-inference.json and gcloud, no key in Settings
  coder_page_settings_gauth(s, "vertex", "Vertex AI (service account, project openagentsgemini)");
  #assert coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 1 && coder_page_model_agy(s);
  #assert coder_page_pick_model(s, "gemini-4-neon") && cp_backend_label(s) == "Vertex AI";
  // a Gemini API key in ~/work/.secrets or the environment counts too
  coder_page_settings_gauth(s, "key", "API key ending 1a2b (GEMINI_API_KEY)");
  #assert coder_page_cloud_ok(s) && !s[0].gauth_vertex;
  // none found: drops Gemini, falls back to Flawed while Antigravity remains selectable
  coder_page_settings_gauth(s, "none", "");
  #assert !coder_page_cloud_ok(s) && cp_models(s) == CP_FLAWED_MODELS + 2 && coder_page_model_flawed(s) && coder_page_pick_model(s, "antigravity") && coder_page_model_agy(s);
}

#test "a reply's label names the model Antigravity reported running, and keeps it with the chat" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "antigravity");
  coder_page_agy_seen(s, "gemini-4-carbon-low", "Gemini 4 Carbon (Low)");
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  _ = coder_page_line(s, "{\"kind\":\"attempt\",\"schema\":\"coder.observability.v2\",\"scope\":\"request_attempt\",\"engine\":null,\"gateway\":\"antigravity\",\"model\":\"gemini-4-argon-high\",\"model_source\":\"attempt_configuration\",\"requested_effort\":null,\"outcome\":\"configured\",\"status\":0,\"usd_micros\":-1}");
  #assert cp_turn_meta(s, 0) == "Antigravity CLI · gemini-4-argon-high";
  // the probe's model: its name
  _ = coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"antigravity\",\"model\":\"gemini-4-carbon-low\",\"outcome\":\"configured\",\"status\":0}");
  #assert cp_turn_meta(s, 0) == "Antigravity CLI · Gemini 4 Carbon (Low)";
}

#test "an Antigravity turn's task line names no effort, so Settings or agyworker's high decides; Microcoder's names low" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  #assert coder_page_pick_model(s, "gemini-4-neon");
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "gemini-4-neon" && back[0].effort == "low";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_set_agy(s, true);
  #assert coder_page_pick_model(s, "antigravity");
  #assert coder_page_set_text(s, "fix the test") && coder_page_submit(s);
  ar[0].at = 0;
  n = coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "antigravity" && back[0].effort == "";
  #assert !cp_contains(cast(string) out[0..<n], "\"effort\"");
}

#test "Hybrid Executor (hybrid-exec-v1) gates picker selection, routes local task, and renders Settings > Models Executor section (#13924)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // Not selectable until verified Ready (no lying UI)
  #assert !coder_page_model_hybrid(s) && !coder_page_pick_model(s, "hybrid-exec-v1");

  // Once verified Ready on disk: appears in picker, preserves selection across cloud/agy/inkling toggles
  coder_page_settings_executor(s, "Ready · Exact Replay [E] (4/4)", "diff:606049b8 · schema:5293cf74 · dep:7a821819 · bud:a93a4b53", "Exact Replay [E]");
  coder_page_set_inkling(s, true);
  coder_page_set_hybrid_exec(s, true);
  #assert coder_page_pick_model(s, "hybrid-exec-v1") && coder_page_model_hybrid(s);
  idx := cp_model_index(s);
  #assert cp_model_id(s, idx) == "hybrid-exec-v1";
  #assert cp_model_label(s, idx) == "Hybrid Executor [E]";
  #assert cp_model_desc(s, idx) == "Psionic Metal · hybrid-exec-v1 · Exact Replay [E]";
  #assert cp_model_meta(s, idx) == "Psionic Metal · Hybrid Executor [E]";
  #assert cp_backend_label(s) == "Psionic Metal · [E]";
  #assert cp_model_provider_kind(s, idx) == CP_PROV_HYBRID;

  // Selection survives cloud/agy changes while models.hybrid is enabled
  coder_page_set_agy(s, true);
  #assert coder_page_model_hybrid(s);
  coder_page_set_cloud_authed(s, false);
  #assert coder_page_model_hybrid(s);

  // Task JSON sets local:true and model:"hybrid-exec-v1"
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "verify the diff") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].local && back[0].model == "hybrid-exec-v1";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;

  // Settings > Models renders Executor Models & Weight Modules section, matches search, dispatches CP_ASK_EXECUTOR_MODELS
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  hn := cp_set_hits_flags("safetensors", hits[..], s[0].flags);
  #assert hn >= 1 && es[hits[0]].id == "set.exec.modules";
  hn = cp_set_hits_flags("hybrid-exec-v1", hits[..], s[0].flags);
  #assert hn >= 1 && es[hits[0]].id == "set.exec.hybrid";

  coder_page_settings_open(s, CP_PG_MODELS, "set.exec.hybrid");
  f: [1] UiFrame;
  #assert cp_test_frame(s, f[..], 1200, 1400, true);
  #assert surface_find(s[0].surface[..], "set.exec.head") >= 0;
  #assert surface_find(s[0].surface[..], "set.exec.hybrid.a") >= 0;
  #assert surface_find(s[0].surface[..], "set.exec.modules.a") >= 0;
  #assert cp_settings_press(s, CP_SET_ACT, "set.exec.hybrid.a") && coder_page_action(s) == CP_ASK_EXECUTOR_MODELS;
  #assert cp_settings_press(s, CP_SET_ACT, "set.exec.modules.a") && coder_page_action(s) == CP_ASK_EXECUTOR_MODELS;

  // Revoking readiness (e.g., on tamper refusal) immediately removes Hybrid Executor from picker
  coder_page_set_hybrid_exec(s, false);
  #assert !coder_page_model_hybrid(s) && !coder_page_pick_model(s, "hybrid-exec-v1");
}

#test "Settings > Models Pylon & Executor Network section renders truthful live status and dispatches CP_ASK_PYLON_EXECUTOR (#13928)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_settings_pylon(s, "Off", "12 traces · 3 windows", "1100 sats [regtest]", "sha256:59f86da6263e · promoted");

  hits: [CP_SET_HITS] int; es := cp_set_entries();
  hn := cp_set_hits("pylon", hits[..]);
  #assert hn >= 1 && es[hits[0]].page == CP_PG_MODELS;
  hn = cp_set_hits("rollback", hits[..]);
  #assert hn >= 1 && es[hits[0]].id == "set.pylon.release";

  coder_page_settings_open(s, CP_PG_MODELS, "set.pylon.release");
  f: [1] UiFrame;
  #assert cp_test_frame(s, f[..], 1200, 1600, true);
  #assert surface_find(s[0].surface[..], "set.pylon.head") >= 0;
  #assert surface_find(s[0].surface[..], "set.pylon.state.a") >= 0;
  #assert surface_find(s[0].surface[..], "set.pylon.contrib.a") >= 0;
  #assert surface_find(s[0].surface[..], "set.pylon.sats.a") >= 0;
  #assert surface_find(s[0].surface[..], "set.pylon.release.a") >= 0;
  #assert cp_settings_press(s, CP_SET_ACT, "set.pylon.state.a") && coder_page_action(s) == CP_ASK_PYLON_EXECUTOR;
  #assert cp_settings_press(s, CP_SET_ACT, "set.pylon.sats.a") && coder_page_action(s) == CP_ASK_PYLON_EXECUTOR;
  #assert cp_settings_press(s, CP_SET_ACT, "set.pylon.release.a") && coder_page_action(s) == CP_ASK_PYLON_EXECUTOR;
}

#test "inkling-neon hybrid combo model selects cleanly, emits inkling-neon task, and routes level inkling sub-agents locally" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // Not selectable until local inkling is enabled alongside cloud
  #assert !coder_page_pick_model(s, "inkling-neon");
  coder_page_set_inkling(s, true);
  #assert coder_page_pick_model(s, "inkling-neon");
  idx := cp_model_index(s);
  #assert cp_model_id(s, idx) == "inkling-neon" && cp_model_label(s, idx) == "Inkling + Neon (Hybrid)";
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "fix it") && coder_page_submit(s);
  n := coder_page_task(s, "sess-combo", "/w", out[..]);
  #assert n > 0 && mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && !back[0].local && back[0].model == "inkling-neon";
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  // Neon delegating to level inkling produces local:true inkling-2-mini sub-agent task
  #assert coder_page_pick_model(s, "gemini-4-neon");
  #assert coder_page_set_text(s, "delegate search") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"ticket\":1,\"tasks\":[{\"level\":\"inkling\",\"task\":\"grep foo\"}]}") == MWW_DELEGATE;
  #assert s[0].turns[1].nagents == 1 && s[0].turns[1].agents[0].level == CP_LEVEL_INKLING && CP_LEVEL_NAME[CP_LEVEL_INKLING] == "Inkling";
  ar[0].at = 0;
  an := coder_page_agent_task(s, 0, "sess-sub", "/w", out[..]);
  #assert an > 0 && mww_task_read(ar[..], cast(string) out[0..<an - 1], back[..]) && back[0].local && back[0].model == "inkling-2-mini";
}

#test "Claude as a chat's main model: four picker entries when Claude Code is here, its task line, and the model new chats start on" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  flaw_i := cp_model_find_exact(s, "flawed:gemini-4-neon");
  neon_i := cp_model_find_exact(s, "gemini-4-neon");
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS && cp_model_start(s) == flaw_i && !coder_page_pick_model(s, "claude-opus-5-5") && cp_model_find_s(s, "claude-opus-5-5") == flaw_i;
  coder_page_set_claude(s, true);
  base := cp_claude_base_idx(s);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + CP_CLAUDE_MODELS && base == CP_FLAWED_MODELS + 1 + CP_MODELS && s[0].model == flaw_i;
  #assert cp_model_label(s, base) == "Claude Fable 5.2" && cp_model_label(s, base + 1) == "Claude Opus 5.5" && cp_model_label(s, base + 2) == "Claude Sonnet 5.5" && cp_model_label(s, base + 3) == "Claude Haiku 5.5";
  #assert cp_model_id(s, base) == "claude-fable-5-2" && cp_model_id(s, base + 1) == "claude-opus-5-5" && cp_model_id(s, base + 2) == "claude-sonnet-5-5" && cp_model_id(s, base + 3) == "claude-haiku-5-5";
  #assert cp_model_desc(s, base + 1) == "Deep reasoning · Claude Code" && cp_model_meta(s, base) == "Claude Code · Claude Fable 5.2";
  #assert cp_model_provider_kind(s, base + 3) == CP_PROV_CLAUDE && cp_model_provider_kind(s, neon_i) == CP_PROV_CLOUD && !cp_is_claude(s, base + 4) && !cp_is_claude(s, base - 1);
  // by name: an id, a label, a short name
  #assert coder_page_pick_model(s, "opus") && s[0].model == base + 1 && coder_page_model_claude(s) && coder_page_model_provider(s) == CP_PROV_CLAUDE && cp_backend_label(s) == "Claude Code";
  #assert cp_model_find_s(s, "claude-fable-5-2") == base && cp_model_find_s(s, "Claude Haiku 5.5") == base + 3;
  // its task line: the model's id, sub-agents with the Claude levels, high effort, and no skills note
  coder_page_skills(s, "SKILLS NOTE\n");
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "claude-opus-5-5" && back[0].agents && back[0].claude && back[0].effort == "high" && back[0].task == "hi";
  // the worker's lines read as Microcoder's: its reply, and a delegate call's sub-agents by level
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"claude\",\"model\":\"claude-opus-5-5\",\"outcome\":\"started\",\"status\":200,\"input_tokens\":1200,\"cached_tokens\":1000}") == MWW_ATTEMPT;
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"fable\",\"task\":\"prove it\"},{\"level\":\"haiku\",\"task\":\"count\"},{\"level\":\"sonnet\",\"task\":\"build\"},{\"level\":\"opus\",\"task\":\"review\"}],\"ticket\":1}") == MWW_DELEGATE;
  #assert s[0].turns[0].nagents == 4 && coder_page_agent_claude(s, 0) && coder_page_agent_claude(s, 3);
  #assert CP_LEVEL_NAME[s[0].turns[0].agents[0].level] == "Claude Fable 5.2" && CP_LEVEL_NAME[s[0].turns[0].agents[1].level] == "Claude Haiku 5.5" && CP_LEVEL_NAME[s[0].turns[0].agents[2].level] == "Claude Sonnet 5.5" && CP_LEVEL_NAME[s[0].turns[0].agents[3].level] == "Claude Opus 5.5";
  ar[0].at = 0;
  n = coder_page_agent_task(s, 0, "s-a0", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "fable" && !back[0].agents;
  // a chat on Claude stays on it when an entry joins before it
  coder_page_set_openrouter(s, "deepseek/deepseek-v4.1-flash-1017", "");
  #assert cp_claude_base_idx(s) == CP_FLAWED_MODELS + 1 + CP_MODELS + 1 && s[0].model == CP_FLAWED_MODELS + 1 + CP_MODELS + 2 && cp_model_id(s, cp_model_index(s)) == "claude-opus-5-5";
  coder_page_set_openrouter(s, "", "");
  #assert s[0].model == base + 1;
}

#test "Settings picks the model new chats start on: Flawed default until Claude is picked, and a chat with messages keeps its own" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  flaw_i := cp_model_find_exact(s, "flawed:gemini-4-neon");
  // picked before the host says Claude Code is here: it takes hold when it does
  coder_page_orchestrator_set(s, true, 0);
  #assert coder_page_orchestrator(s) == 1 && coder_page_orchestrator_model(s) == 0 && cp_model_index(s) == flaw_i && cp_model_start(s) == flaw_i;
  coder_page_set_claude(s, true);
  #assert cp_model_id(s, cp_model_index(s)) == "claude-fable-5-2";
  coder_page_orchestrator_set(s, true, 2);
  #assert cp_model_id(s, cp_model_index(s)) == "claude-sonnet-5-5";
  coder_page_orchestrator_set(s, true, 9);
  #assert coder_page_orchestrator_model(s) == CP_CLAUDE_START && cp_model_id(s, cp_model_index(s)) == "claude-opus-5-5";
  // a chat with a message keeps its model; the next new chat starts on the pick
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  coder_page_orchestrator_set(s, false, 3);
  #assert cp_model_id(s, cp_model_index(s)) == "claude-opus-5-5" && cp_model_start(s) == flaw_i;
  #assert cp_new(s) && cp_model_id(s, cp_model_index(s)) == "flawed:gemini-4-neon";
  coder_page_orchestrator_set(s, true, 3);
  #assert cp_model_id(s, cp_model_index(s)) == "claude-haiku-5-5";
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  #assert cp_new(s) && cp_model_id(s, cp_model_index(s)) == "claude-haiku-5-5";
  // Claude Code gone: new chats start on default again
  coder_page_set_claude(s, false);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 + CP_MODELS && cp_model_index(s) == flaw_i;
}

#test "composer model picker shows real-time Local Models row and opens Local Models manager (#13826)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); coder_page_flags_set(s, DC_FLAGS_ALL); test_atlas(s[0].atlas[..]);
  s[0].d = 1.0f32;
  coder_page_settings_local(s, "Downloading 42% · 7.4 / 17.6 GB · 85 MB/s");
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  btn := surface_find(s[0].surface[..], "coder.model");
  #assert btn >= 0 && cp_press(s, btn) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  loc := elt_find(t[..], "coder.model.local");
  #assert loc >= 0 && cast(string) t[0].rows[loc].label[0..<t[0].rows[loc].label_n] == "Manage Local Models…";
  #assert cast(string) t[0].rows[loc].value[0..<t[0].rows[loc].value_n] == "Downloading 42% · 7.4 / 17.6 GB · 85 MB/s";
  // Clicking the Local Models footer row closes the menu and asks the host to open Local Models UI.
  cx := t[0].rows[loc].x + t[0].rows[loc].w * 0.5f32;
  cy := t[0].rows[loc].y + t[0].rows[loc].h * 0.5f32;
  #assert coder_page_pointer(s, cx, cy, 0);
  #assert coder_page_pointer(s, cx, cy, 2);
  #assert !s[0].model_menu && coder_page_action(s) == CP_ASK_LOCAL_MODELS;
  // Once installed & verified, Inkling becomes ready and Manage Local Models keeps live status.
  coder_page_set_inkling(s, true);
  coder_page_settings_local(s, "Installed (17.63 GB · SHA-256 verified)");
  s[0].model_menu = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t2 := [1] ElTable.[surface_rows(s[0].surface[..])];
  loc2 := elt_find(t2[..], "coder.model.local");
  #assert loc2 >= 0 && cast(string) t2[0].rows[loc2].label[0..<t2[0].rows[loc2].label_n] == "Manage Local Models…";
  #assert cast(string) t2[0].rows[loc2].value[0..<t2[0].rows[loc2].value_n] == "Installed (17.63 GB · SHA-256 verified)";
}

#test "active uncensored Inkling variant shows in input bar picker by default, hides other models until requested, and downloads on pick when not installed" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); test_atlas(s[0].atlas[..]);
  s[0].d = 1.0f32;
  // Simulate default launch state: show_other_models == false, active best model is Uncensored LoRA (not downloaded yet).
  coder_page_show_other_models_set(s, false);
  coder_page_set_agy(s, true);
  coder_page_set_claude(s, true);
  coder_page_set_inkling(s, false);
  coder_page_set_inkling_info(s, "inkling-2-mini-uncensored-lora", "Inkling 2 Mini Uncensored (LoRA)", "Not downloaded (17.67 GB) · Click to download");
  coder_page_local_state(s, true, true, 64, CP_LOCAL_NOT_INSTALLED, 0, 0, 16853, "");

  // 1. Flawed (0..4) + active uncensored Inkling variant (5) are shown (even though flags/agy/claude/cloud are set).
  ink_i := CP_FLAWED_MODELS;
  #assert !coder_page_show_other_models(s) && cp_has_model_picker(s);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 && cp_model_index(s) == 0 && coder_page_model_flawed(s) && !coder_page_model_flawed_local(s);
  #assert cp_model_id(s, ink_i) == "inkling-2-mini-uncensored-lora";
  #assert cp_model_label(s, ink_i) == "Inkling 2 Mini Uncensored (LoRA)";
  #assert cp_model_desc(s, ink_i) == "Not downloaded (17.67 GB) · Click to download";
  #assert cp_model_meta(s, ink_i) == "Psionic Metal · Inkling 2 Mini Uncensored (LoRA)";
  #assert cp_model_known_label("inkling-2-mini-uncensored-lora") == "Inkling 2 Mini Uncensored (LoRA)";
  #assert cp_model_known_label("inkling-2-mini-uncensored-maple") == "Inkling 2 Mini Uncensored (Maple)";
  #assert cp_model_known_meta("inkling-2-mini-uncensored-maple") == "Psionic Metal · Inkling 2 Mini Uncensored (Maple)";
  #assert cp_model_known_label("flawed:inkling-2-mini-uncensored-maple") == "Flawed · Inkling 2 Mini Uncensored (Maple)";
  #assert cp_model_known_meta("flawed:inkling-2-mini-uncensored-maple") == "Flawed Agent · Inkling 2 Mini Uncensored (Maple)";
  #assert cp_model_known_label("inkling-2-mini-uncensored-q4k") == "Inkling 2 Mini Uncensored (AD-Q4_K)";

  // 2. Composer & model picker chip are visible even before download, showing Flawed + active Inkling variant!
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.0, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  mchip := surface_find(s[0].surface[..], "coder.model");
  #assert mchip >= 0;
  #assert cp_press(s, mchip) && s[0].model_menu;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.016, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  opt_ink := elt_find(t[..], "coder.model.5");
  #assert opt_ink >= 0 && elt_find(t[..], "coder.model.6") < 0;
  #assert cast(string) t[0].rows[opt_ink].label[0..<t[0].rows[opt_ink].label_n] == "Inkling 2 Mini Uncensored (LoRA)";
  #assert cast(string) t[0].rows[opt_ink].value[0..<t[0].rows[opt_ink].value_n] == "Not downloaded (17.67 GB) · Click to download";

  // 3. Picking the undownloaded Inkling model in the dropdown dispatches CP_ASK_LOCAL_DOWNLOAD immediately!
  #assert cp_press(s, opt_ink) && !s[0].model_menu && coder_page_action(s) == CP_ASK_LOCAL_DOWNLOAD;

  // 4. Clicking "Show other models…" reveals other models while keeping the menu open and Flawed + Inkling at top.
  s[0].model_menu = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.032, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  others := surface_find(s[0].surface[..], "coder.model.others");
  #assert others >= 0 && cp_press(s, others);
  #assert coder_page_show_other_models(s) && coder_page_action(s) == CP_ASK_SHOW_OTHER_MODELS && s[0].model_menu;
  #assert cp_models(s) > CP_FLAWED_MODELS + 1 && cp_model_id(s, ink_i) == "inkling-2-mini-uncensored-lora";

  // 5. Clicking "Hide other models" collapses back to core Flawed + active uncensored Inkling variant.
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.048, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  hide_btn := surface_find(s[0].surface[..], "coder.model.others");
  #assert hide_btn >= 0 && surface_say(s[0].surface[..], hide_btn) == "Hide other models";
  #assert cp_press(s, hide_btn) && !coder_page_show_other_models(s) && coder_page_action(s) == CP_ASK_SHOW_OTHER_MODELS && !s[0].model_menu && cp_models(s) == CP_FLAWED_MODELS + 1;

  // 6. Once downloaded, clicking the model does NOT re-trigger download, and switching variant updates the label immediately.
  coder_page_set_inkling(s, true);
  coder_page_set_inkling_info(s, "inkling-2-mini-uncensored-q4k", "Inkling 2 Mini Uncensored (AD-Q4_K)", "Psionic Metal · AD-Q4_K GGUF · Local");
  s[0].model_menu = true;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0.064, 0.016, false, false);
  cp_layout(s, f[..], 900.0f32, 700.0f32);
  #assert uiframe_end(f[..], s[0].surface[..]);
  q4_opt := surface_find(s[0].surface[..], "coder.model.5");
  #assert q4_opt >= 0 && surface_say(s[0].surface[..], q4_opt) == "Inkling 2 Mini Uncensored (AD-Q4_K)";
  #assert cp_press(s, q4_opt) && coder_page_action(s) == CP_ASK_NONE;
}

#test "Flawed Agent: Gemini 4 Neon always default even when Inkling is installed, switching, and save/load roundtrip" {
  p: [1] CoderPage; p2: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s);
  coder_page_flags_set(s, 0);
  coder_page_show_other_models_set(s, false);
  // Before Inkling is detected: defaults to Flawed · Gemini 4 Neon.
  #assert coder_page_model_flawed(s) && !coder_page_model_flawed_local(s) && coder_page_model_provider(s) == CP_PROV_FLAWED;
  #assert cp_model_id(s, cp_model_index(s)) == "flawed:gemini-4-neon";
  // Even after Inkling weights are verified on startup, untouched fresh chat stays on Flawed · Gemini 4 Neon!
  coder_page_set_inkling(s, true);
  #assert coder_page_model_flawed(s) && !coder_page_model_flawed_local(s) && cp_model_id(s, cp_model_index(s)) == "flawed:gemini-4-neon";
  // Uncensored Inkling variants propagate ID, label, description, and 32K context window cleanly through Flawed local slot.
  coder_page_set_inkling_info(s, "inkling-2-mini-uncensored-lora", "Inkling 2 Mini Uncensored (LoRA)", "Psionic Metal · IQ4_NL + LoRA · Local");
  #assert cp_model_id(s, CP_FLAWED_START_LOCAL) == "flawed:inkling-2-mini-uncensored-lora";
  #assert cp_model_label(s, CP_FLAWED_START_LOCAL) == "Flawed · Inkling 2 Mini Uncensored (LoRA)";
  #assert cp_contains(cp_model_desc(s, CP_FLAWED_START_LOCAL), "IQ4_NL + LoRA");
  #assert cp_model_known_label("flawed:inkling-2-mini-uncensored-q4k") == "Flawed · Inkling 2 Mini Uncensored (AD-Q4_K)";
  #assert cp_model_known_meta("flawed:inkling-2-mini-uncensored-lora") == "Flawed Agent · Inkling 2 Mini Uncensored (LoRA)";
  #assert cp_effort_count(s, cp_model_index(s)) == 5 && cp_effort_label(s, cp_model_index(s)) == "High";
  // Default permission mode is Allow All (0) and git_guard is Off (0, opt-in).
  vals: [CP_FLAWED_PREFS_COUNT] int;
  #assert coder_page_flawed_prefs_get(s, vals[..]) == CP_FLAWED_PREFS_COUNT && vals[6] == 0 && vals[9] == 0;
  vals[4] = 4;   // Max
  vals[17] = 1;  // Fast mode
  coder_page_flawed_prefs_set(s, vals[..]);
  #assert cp_effort_label(s, cp_model_index(s)) == "Max" && cp_task_effort(s, cp_model_index(s)) == "max";
  #assert cp_contains(cp_model_desc(s, 0), "Fast");
  // Attempt on uncensored local Inkling reports 32K context window (32,768 tokens).
  #assert coder_page_pick_model(s, "flawed:inkling-2-mini-uncensored-lora") && coder_page_model_flawed_local(s);
  #assert coder_page_set_text(s, "check") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"local\",\"model\":\"inkling-2-mini-uncensored-lora\",\"outcome\":\"done\",\"status\":200,\"input_tokens\":1200,\"cached_tokens\":0,\"output_tokens\":100}") == MWW_ATTEMPT;
  #assert s[0].ctx_window == 32768;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;
  // Attempt on Gemini 4 Neon reports 1M context window (1,048,576 tokens).
  #assert coder_page_pick_model(s, "flawed:gemini-4-neon") && !coder_page_model_flawed_local(s);
  #assert coder_page_set_text(s, "refactor") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"attempt\",\"gateway\":\"vertex\",\"model\":\"gemini-4-neon\",\"outcome\":\"done\",\"status\":200,\"input_tokens\":5000,\"cached_tokens\":3000,\"output_tokens\":200}") == MWW_ATTEMPT;
  #assert s[0].ctx_window == 1048576;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"done\"}") == MWW_ENDED;
  // Save & load preserves flawed:gemini-4-carbon cleanly.
  #assert coder_page_pick_model(s, "flawed:gemini-4-carbon");
  saved: [16384] u8; sn := coder_page_save(s, saved[..]);
  p2_st: [1] CpCheckLean; s2 := cp_check_lean(p2[..], p2_st[..]); cp_init(s2);
  #assert sn > 0 && coder_page_load(s2, cast(string) saved[0..<sn]) && cp_model_id(s2, cp_model_index(s2)) == "flawed:gemini-4-carbon";
}
