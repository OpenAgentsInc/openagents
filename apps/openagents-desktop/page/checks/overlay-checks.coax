// Checks for the page's overlay.coax: dialogs and right-click menus over the page (GitHub #13746). Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

cp_test_budget :: (s: [] CoderPage) {
  coder_page_dialog_begin(s, 0, "Chat Max Budget", "Set the maximum spend (USD) for this chat thread. Current spend: $0.00.");
  #assert coder_page_dialog_field(s, "", "50.00", "50.00", false, 1);
  #assert coder_page_dialog_button(s, "Cancel", 1, false) && coder_page_dialog_button(s, "Save", 0, false);
  coder_page_dialog_show(s, 1, 0, 0);
}

#test "a dialog the host asks for is drawn over the page at Zeron's sm width, and the composer's editor gives up the keyboard under it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  #assert cp_test_draw_over(s, f[..], 0.016) && cp_test_press_field(s, CP_ED_COMPOSER) && cp_ed_which(s) == CP_ED_COMPOSER;
  cp_test_budget(s);
  #assert coder_page_overlay_open(s) && !cp_test_press_field(s, CP_ED_COMPOSER);
  #assert cp_test_draw_over(s, f[..], 1);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  #assert elt_find(t[..], "dialog") >= 0 && elt_find(t[..], "dialog.button.1") >= 0 && elt_value_of(t[..], elt_find(t[..], "dialog.field.0")) == "50.00";
  #assert abs(s[0].ov[0].dlg[0].w - 380) < 0.01;
  // at rest, the field with the keyboard is the page's editor, drawn in its box in the label face
  #assert cp_test_draw_over(s, f[..], 0.016);
  #assert cp_ed_which(s) == CP_ED_DIALOG && s[0].ov[0].dlg[0].editing && s[0].fld[0].ed[CP_ED_DIALOG].body[0].text_w > 300;
  #assert ue_value(s[0].fld[0].ed[CP_ED_DIALOG..<CP_ED_DIALOG + 1]) == "50.00" && cp_ed_skin(s, cp_skin(), CP_ED_DIALOG).body.face == cp_skin().label.face;
  // drawn flat it is solid; where the host composes, the panel frosts what is behind it (#13772),
  // and reduced transparency takes it back to solid
  fl := surface_sheet(s[0].surface[..]); #assert !cp_has_layer(fl.over[0..<fl.no]);
  s[0].cmp_gpu[0].w = 1200; s[0].cmp_gpu[0].h = 800; coder_page_compose(s, true);
  #assert cp_test_draw_over(s, f[..], 0.016);
  sh := surface_sheet(s[0].surface[..]); #assert cp_has_layer(sh.over[0..<sh.no]);
  coder_page_frost(s, false);   // what the host says under reduced transparency
  #assert cp_test_draw_over(s, f[..], 0.016);
  sh = surface_sheet(s[0].surface[..]); #assert !cp_has_layer(sh.over[0..<sh.no]);
}
#test "Return answers the dialog's confirm with the editor's text; Escape and a click on the dim cancel" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_init(s); s[0].d = 1; out: [64] u8;
  cp_test_budget(s); #assert cp_test_draw_over(s, f[..], 1);
  #assert coder_page_dialog_answer(s) == APP_DLG_NONE && coder_page_dialog_set(s, 0, "12.50");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_dialog_answer(s) == 1;
  n := coder_page_dialog_value(s, 0, out[..]); #assert n == 5 && cast(string) out[0..<n] == "12.50";
  cp_test_budget(s); #assert cp_test_draw_over(s, f[..], 1);
  #assert coder_page_overlay_key(s, APP_OV_ESCAPE, 0) && coder_page_dialog_answer(s) == APP_DLG_CANCEL;
  // it leaves over 130 ms, then the page has the pointer again
  #assert coder_page_overlay_open(s) && cp_test_draw_over(s, f[..], 0.2) && cp_test_draw_over(s, f[..], 0.016) && !coder_page_overlay_open(s);
  cp_test_budget(s); #assert cp_test_draw_over(s, f[..], 1);
  #assert coder_page_overlay_pointer(s, 2, 2, 0) && coder_page_overlay_pointer(s, 2, 2, 2) && coder_page_dialog_answer(s) == APP_DLG_CANCEL;
}
#test "a right-click menu opens at the pointer, takes the keys, and gives the host the item chosen" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_init(s); s[0].d = 2;
  coder_page_menu_begin(s);
  #assert coder_page_menu_item(s, "Pin Chat", 0, false, false, false) && coder_page_menu_item(s, "Rename Chat…", 0, false, false, false);
  #assert coder_page_menu_item(s, "", 2, false, false, false) && coder_page_menu_item(s, "Delete Chat…", 0, false, true, false);
  coder_page_menu_show(s, 400, 300);
  #assert coder_page_overlay_open(s) && cp_test_draw_over(s, f[..], 1);
  #assert s[0].ov[0].menu[0].x == 200 && s[0].ov[0].menu[0].y == 150 && abs(s[0].ov[0].menu[0].w - 232) < 0.01;
  // Delete is disabled: down goes round to Pin
  #assert coder_page_overlay_key(s, APP_OV_DOWN, 0) && coder_page_overlay_key(s, APP_OV_DOWN, 0) && coder_page_overlay_key(s, APP_OV_DOWN, 0);
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_menu_answer(s) == 0 && !coder_page_overlay_open(s);
  // a press outside closes it with none, and no press reaches the page
  coder_page_menu_show(s, 400, 300); #assert cp_test_draw_over(s, f[..], 1);
  #assert coder_page_overlay_pointer(s, 10, 10, 0) && coder_page_menu_answer(s) == APP_MENU_NONE && s[0].pressed_n == 0;
  // no menu over a dialog
  cp_test_budget(s); coder_page_menu_show(s, 400, 300); #assert !s[0].ov[0].menu[0].open;
}
#test "settings' search gives up the keyboard and presses while a dialog is up" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  coder_page_settings_open(s, 0, ""); #assert cp_test_draw_over(s, f[..], 0.016) && cp_test_press_field(s, CP_ED_SEARCH) && cp_ed_which(s) == CP_ED_SEARCH;
  cp_test_budget(s); #assert cp_ed_which(s) != CP_ED_SEARCH && !cp_test_press_field(s, CP_ED_SEARCH);
}

#test "a toast shows at the window's foot, idles while it stands, wakes the host when due, and Close sends it away (#13774)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  #assert cp_test_draw_over(s, f[..], 0.016) && coder_page_blink(s) < 0;   // nothing due
  coder_page_update(s, CP_UPD_READY, "", "");
  coder_page_update(s, CP_UPD_READY, "", "");   // ready once, one toast
  #assert s[0].toasts[0].n == 1;
  #assert cp_test_draw_over(s, f[..], 0.016);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  r := elt_find(t[..], "toast.1");
  #assert r >= 0 && t[0].rows[r].x + t[0].rows[r].w <= 1200 && t[0].rows[r].y + t[0].rows[r].h <= 800 && t[0].rows[r].y > 600;
  // it stands still: no frame runs, and the host is told when it is due to leave
  for i: 0..<30 { s[0].clock += 0.016; #assert cp_test_draw_over(s, f[..], 0.016); }
  #assert !uiframe_moving(f[..]);
  due := coder_page_blink(s);
  #assert due > 0 && due <= cp_skin().motion.toast;
  // Close sends it away, and once it is gone nothing is due
  c := elt_find(t[..], "toast.1.close");
  t[0] = surface_rows(s[0].surface[..]); c = elt_find(t[..], "toast.1.close");
  #assert c >= 0 && cp_press(s, c);
  for i: 0..<20 { s[0].clock += 0.016; #assert cp_test_draw_over(s, f[..], 0.016); }
  #assert s[0].toasts[0].n == 0 && coder_page_blink(s) < 0;
  t[0] = surface_rows(s[0].surface[..]); #assert elt_find(t[..], "toast.1") < 0;
  // a host's toast about a failure joins the stack
  coder_page_toast(s, "Couldn't make this chat's worktree", 1);
  #assert s[0].toasts[0].n == 1 && s[0].toasts[0].items[0].tone == APP_TOAST_ERROR;
}
