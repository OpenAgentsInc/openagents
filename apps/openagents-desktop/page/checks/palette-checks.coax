// Checks for the page's palette.coax: the command palette over the page (GitHub #13700). Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

cp_pal_test_draw :: (s: [] CoderPage, f: [] UiFrame, dt: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, dt, false, false);
  cp_layout(s, f, 1200.0f32, 800.0f32);
  _ := cp_overlay(s, f, 1200.0f32, 800.0f32, dt);
  return uiframe_end(f, s[0].surface[..]);
}
cp_pal_test_page :: (s: [] CoderPage) {
  cp_init(s); s[0].d = 1;
  coder_page_chats(s, "p1\tPinned plan\t0\t1\t0\nr1\tFix the build\nr2\tWrite the release notes\n");
  coder_page_current(s, "r1");
}
// Typed into the palette's field, as the input method commits it.
cp_pal_test_type :: (s: [] CoderPage, text: string) -> bool { coder_page_ime_replace(s, -1, -1, text); return app_palette_query(cp_pal(s)) == text; }
// The row of the palette's list whose item has this label, -1 for none.
cp_pal_test_row :: (s: [] CoderPage, label: string) -> int {
  p := cp_pal(s);
  for r: 0..<p[0].nrows { if p[0].rows[r].kind == APP_PAL_ITEM && app_pal_label(p, p[0].rows[r].item) == label { return r; } }
  return -1;
}

#test "⌘K opens it on All with the chats, the commands that work and settings; ⌘K again closes it" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); f: [1] UiFrame; cp_pal_test_page(s);
  #assert coder_page_palette_toggle(s, APP_PAL_ALL) && coder_page_overlay_open(s) && coder_page_action(s) == CP_ASK_NONE;
  p := cp_pal(s);
  #assert app_palette_count(p, APP_PAL_SESSIONS) == 4 && app_palette_count(p, APP_PAL_SETTINGS) == CP_SET_ENTRIES;
  // Foreman and the pinned chat lead; nothing runs, so Stop reply is not offered
  #assert p[0].rows[0].head == 1 && app_pal_label(p, p[0].rows[1].item) == "Foreman" && app_pal_label(p, p[0].rows[2].item) == "Pinned plan";
  #assert cp_pal_test_row(s, "Stop reply") < 0 && cp_pal_test_row(s, "New chat") > 0 && cp_pal_test_row(s, "Rename chat…") > 0;
  #assert cp_pal_test_draw(s, f[..], 1);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  #assert elt_find(t[..], "palette") >= 0 && elt_find(t[..], "palette.scope.3") >= 0;
  #assert abs(p[0].w - 640) < 0.01 && abs(p[0].y - 88) < 0.01;
  #assert !coder_page_palette_toggle(s, APP_PAL_ALL) && !coder_page_palette_open(s);
}
#test "the title bar's Search icon opens it on Sessions and asks the host to watch it" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); f: [1] UiFrame; cp_pal_test_page(s);
  #assert cp_pal_test_draw(s, f[..], 0.016);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  si := elt_find(t[..], "coder.search");
  ti := elt_find(t[..], "coder.side.toggle");
  #assert si >= 0 && ti >= 0 && elt_label(t[..], si) == "Search";
  sr := t[0].rows[si]; tr := t[0].rows[ti];
  #assert sr.y + sr.h <= cp_bar(s) && sr.x > tr.x + tr.w;
  cx := sr.x + sr.w * 0.5f32; cy := sr.y + sr.h * 0.5f32;
  #assert coder_page_pointer(s, cx, cy, 0) && coder_page_pointer(s, cx, cy, 2);
  #assert coder_page_action(s) == CP_ASK_PALETTE && coder_page_palette_command(s) == 0;
  #assert coder_page_palette_open(s) && cp_pal(s)[0].scope == APP_PAL_SESSIONS;
}
#test "the field is the page's fourth editor: typing narrows, Backspace edits, Return opens the chat" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); f: [1] UiFrame; cp_pal_test_page(s);
  test_atlas(s[0].atlas[..]); coder_page_env(s, true, false);
  // the first frame at rest places the field; the next draws the editor in it
  #assert coder_page_palette_toggle(s, APP_PAL_ALL) && cp_pal_test_draw(s, f[..], 1) && cp_pal_test_draw(s, f[..], 0.016);
  p := cp_pal(s);
  #assert coder_page_wants_text(s) && cp_ed_which(s) == CP_ED_PALETTE && p[0].editing;
  c := s[0].fld[0].ed[CP_ED_PALETTE].body[..];
  #assert c[0].placeholder == "Search sessions, commands and settings…" && c[0].text_w > 400 && c[0].focused;
  coder_page_ime_replace(s, -1, -1, "releasex");
  #assert coder_page_key(s, KEY_BACKSPACE, 0) && app_palette_query(p) == "release" && p[0].depth == 0;
  #assert p[0].nrows >= 1 && app_pal_label(p, p[0].rows[p[0].lit].item) == "Write the release notes";
  #assert coder_page_key(s, KEY_ENTER, 0) && !coder_page_palette_open(s);
  #assert coder_page_action(s) == CP_ASK_OPEN && s[0].open == 2;
}
#test "Switch model drills in with the model lit; Backspace goes back; a model chosen is the chat's" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); f: [1] UiFrame; cp_pal_test_page(s);
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS) && cp_pal_test_draw(s, f[..], 1);
  p := cp_pal(s);
  coder_page_ime_replace(s, -1, -1, "model"); #assert app_palette_query(p) == "model";
  p[0].lit = cp_pal_test_row(s, "Switch model");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_palette_open(s) && p[0].depth == 1;
  // the field is emptied: the editor opens again on nothing
  #assert cp_pal_test_draw(s, f[..], 1) && ue_value(s[0].fld[0].ed[CP_ED_PALETTE..<CP_ED_PALETTE + 1]) == "";
  #assert p[0].nrows == cp_models(s) && p[0].items[p[0].rows[p[0].lit].item].code == CP_PAL_MODEL + cp_model_index(s);
  #assert coder_page_overlay_key(s, APP_OV_BACKSPACE, 0) && p[0].depth == 0;
  p[0].lit = cp_pal_test_row(s, "Switch model");
  start_m := cp_model_index(s);
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_overlay_key(s, APP_OV_DOWN, 0) && coder_page_overlay_key(s, APP_OV_ENTER, 0);
  #assert !coder_page_palette_open(s) && s[0].model == start_m + 1;
}
#test "a setting opens settings at its row; rename asks the host; Escape closes with nothing done" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); cp_pal_test_page(s);
  #assert coder_page_palette_toggle(s, APP_PAL_SETTINGS) && cp_pal_test_type(s, "text size");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_SETTINGS;
  #assert coder_page_settings_page(s) == CP_PG_GENERAL && cast(string) s[0].set_target[0..<s[0].set_target_n] == "set.zoom";
  #assert coder_page_palette_toggle(s, APP_PAL_ALL) && cp_pal_test_type(s, "rename");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_PALETTE && coder_page_palette_command(s) == CP_PC_RENAME;
  #assert coder_page_palette_toggle(s, APP_PAL_ALL) && coder_page_overlay_key(s, APP_OV_ESCAPE, 0) && coder_page_action(s) == CP_ASK_NONE;
}
#test "Bigger text, Smaller text and Actual size show ⌘ +, ⌘ - and ⌘ 0 and ask zoom in, out and reset" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); cp_pal_test_page(s);
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  p := cp_pal(s);
  bi := p[0].rows[cp_pal_test_row(s, "Bigger text")].item;
  sm := p[0].rows[cp_pal_test_row(s, "Smaller text")].item;
  ac := p[0].rows[cp_pal_test_row(s, "Actual size")].item;
  #assert p[0].items[bi].keys == "⌘ +" && p[0].items[sm].keys == "⌘ -" && p[0].items[ac].keys == "⌘ 0";
  p[0].lit = cp_pal_test_row(s, "Bigger text");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_ZOOM_IN;
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  p[0].lit = cp_pal_test_row(s, "Smaller text");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_ZOOM_OUT;
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  p[0].lit = cp_pal_test_row(s, "Actual size");
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_ZOOM_RESET;
}
#test "⌃Tab and ⌃⇧Tab step through Foreman, the pinned chats and the rest, round the ends" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); cp_pal_test_page(s);
  #assert coder_page_chat_step(s, 1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 2;
  #assert coder_page_chat_step(s, -1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 0;
  coder_page_current(s, "r2");
  #assert coder_page_chat_step(s, 1) && coder_page_action(s) == CP_ASK_FOREMAN;
  coder_page_current(s, "foreman");
  #assert coder_page_chat_step(s, 1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 0;
  coder_page_toggle_sidebar(s); #assert s[0].side_collapsed;
  coder_page_toggle_models(s); #assert s[0].model_menu;
}
#test "experimental features off: the palette has no Foreman, Switch model, or gated settings, and ⌃Tab skips Foreman" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); cp_pal_test_page(s);
  coder_page_experimental_set(s, false);
  #assert coder_page_palette_toggle(s, APP_PAL_ALL);
  p := cp_pal(s);
  es := cp_set_entries(); expected_set := 0;
  for e: es { if cp_set_entry_ok_flags(dc_flags_defaults(), e) { expected_set += 1; } }
  #assert app_palette_count(p, APP_PAL_SESSIONS) == 3 && app_palette_count(p, APP_PAL_SETTINGS) == expected_set;
  #assert app_pal_label(p, p[0].rows[1].item) == "Pinned plan";
  #assert cp_pal_test_row(s, "Open Foreman") < 0 && cp_pal_test_row(s, "Foreman permission tier") < 0 && cp_pal_test_row(s, "View Foreman audit log") < 0;
  #assert cp_pal_test_row(s, "Switch model") >= 0;
  #assert cp_pal_test_row(s, "Experimental features") > 0 && cp_pal_test_row(s, "New chat") > 0;
  #assert !coder_page_palette_toggle(s, APP_PAL_ALL);
  #assert !cp_pal_open_chat(s, -1);
  // r1 shown: the order is p1, r1, r2 with no Foreman, round the ends
  #assert coder_page_chat_step(s, 1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 2;
  coder_page_current(s, "r2");
  #assert coder_page_chat_step(s, 1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 0;
  coder_page_current(s, "p1");
  #assert coder_page_chat_step(s, -1) && coder_page_action(s) == CP_ASK_OPEN && s[0].open == 2;
}
#test "Fork chat appears in the palette when a non-Foreman chat has turns and asks CP_ASK_FORK" {
  pg: [1] CoderPage; pg_st: [1] CpCheckStore; s := cp_check_page(pg[..], pg_st[..]); cp_pal_test_page(s);
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  #assert cp_pal_test_row(s, "Fork chat") < 0;
  #assert !coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  s[0].nturns = 1;
  #assert coder_page_palette_toggle(s, APP_PAL_COMMANDS);
  p := cp_pal(s);
  r := cp_pal_test_row(s, "Fork chat");
  #assert r >= 0;
  p[0].lit = r;
  #assert coder_page_overlay_key(s, APP_OV_ENTER, 0) && coder_page_action(s) == CP_ASK_FORK;
}
#test "CP_ASK_FORK is a distinct non-zero host action" {
  #assert CP_ASK_FORK != CP_ASK_NONE;
  #assert CP_ASK_FORK == 37;
}
