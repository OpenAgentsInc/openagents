// Checks for Settings -> Providers screen & Add provider 3-step modal wizard (page/providers_settings.coax).
#load "../parts.coax";
#load "checks-kit.coax";

cp_ps_test_frame :: (s: [] CoderPage, w: f32, h: f32) -> bool {
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin_for(s), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], w, h);
  return uiframe_end(f[..], s[0].surface[..]);
}

#test "providers settings: renders native single-column settings cards matching General/Models, supports toggles, auth method, env vars, models, and 3-step wizard" #steps 60000000 {
  p: [1] CoderPage; st: [1] CpCheckStore; s := cp_check_page(p[..], st[..]);
  cp_init(s); s[0].d = 1.0f32;

  // Always available in core basic flow (flags == 0) as well as with feature flags enabled.
  #assert cp_set_page_ok_flags(0, CP_PG_PROVIDERS);
  #assert cp_set_page_ok_flags(DC_FLAG_MODELS_ANTIGRAVITY, CP_PG_PROVIDERS);
  #assert cp_set_page_ok_flags(DC_FLAGS_ALL, CP_PG_PROVIDERS);
  coder_page_flags_set(s, 0);

  // Default seed shows only Antigravity (Claude and Codex hidden).
  #assert s[0].ps[0].ninst == 1 && s[0].ps[0].selected == 0 && s[0].ps[0].insts[0].driver == CP_PS_DRV_ANTIGRAVITY;

  // Populate realistic Antigravity-only state.
  coder_page_ps_set_meta(s, "Christopher's MacBook Pro (2)", "All projects", "Checked 1h ago", false);
  coder_page_ps_clear(s);
  #assert coder_page_ps_add_instance(s, "antigravity", CP_PS_DRV_ANTIGRAVITY, "Antigravity", "v1.5.2", true, true, CP_PS_ST_WARNING, "Needs attention", "Antigravity is installed. Connect with Agent Platform to load models.", 0) == 0;
  coder_page_ps_select(s, 0);
  coder_page_ps_set_detail_config(s, "Antigravity", 0, CP_PS_AUTH_VERTEX, false, "openagents-gemini", "us-central1", "", "");
  coder_page_ps_set_detail_runtime(s, CP_PS_RT_INSTALLED, "Installed.", "Install managed runtime", -1, false, "");
  coder_page_ps_set_detail_auth(s, CP_PS_AS_FAILED, "Connect on Christopher's MacBook Pro (2) to load models.", "Antigravity could not authenticate with the configured credentials.", "Retry connection", false, "");
  coder_page_ps_models_clear(s);
  #assert coder_page_ps_models_add(s, "gemini-4-neon", "Gemini 4 Neon", true, true, true, false) == 0;
  #assert coder_page_ps_models_add(s, "gemini-4-carbon", "Gemini 4 Carbon", true, false, true, false) == 1;

  // Measure General's column & header so we can verify exact structural alignment with Providers.
  coder_page_settings_open(s, CP_PG_GENERAL, "");
  #assert cp_ps_test_frame(s, 1280, 840);
  gt_idx := surface_find(s[0].surface[..], "set.title");
  gg_idx := surface_find(s[0].surface[..], "set.general.group");
  #assert gt_idx >= 0 && gg_idx >= 0;
  gt_rows := surface_rows(s[0].surface[..]);
  gen_title_x := gt_rows.rows[gt_idx].x;
  gen_title_y := gt_rows.rows[gt_idx].y;
  gen_title_w := gt_rows.rows[gt_idx].w;
  gen_card_x := gt_rows.rows[gg_idx].x;
  gen_card_w := gt_rows.rows[gg_idx].w;

  // Open Settings -> Providers and render upper view.
  coder_page_settings_open(s, CP_PG_PROVIDERS, "");
  #assert coder_page_settings_page(s) == CP_PG_PROVIDERS;
  #assert cp_ps_test_frame(s, 1280, 840);
  // Exact column & page-header parity with General, and zero T3 breadcrumb/scope chrome.
  pt_idx := surface_find(s[0].surface[..], "set.title");
  pg_idx := surface_find(s[0].surface[..], "ps.providers.group");
  #assert pt_idx >= 0 && pg_idx >= 0;
  #assert surface_find(s[0].surface[..], "ps.close") < 0 && surface_find(s[0].surface[..], "ps.add.top") < 0;
  pt_rows := surface_rows(s[0].surface[..]);
  #assert pt_rows.rows[pt_idx].x == gen_title_x && pt_rows.rows[pt_idx].y == gen_title_y && pt_rows.rows[pt_idx].w == gen_title_w;
  #assert pt_rows.rows[pg_idx].x == gen_card_x && pt_rows.rows[pg_idx].w == gen_card_w && pt_rows.rows[pg_idx].h > 40.0f32;
  #assert surface_find(s[0].surface[..], "ps.inst.0") >= 0;
  #assert surface_find(s[0].surface[..], "ps.inst.1") < 0;
  #assert surface_find(s[0].surface[..], "ps.tog.0") >= 0;
  #assert surface_find(s[0].surface[..], "ps.add.list") >= 0;
  #assert surface_find(s[0].surface[..], "ps.refresh") >= 0;
  #assert surface_find(s[0].surface[..], "ps.rt.act") >= 0;
  #assert surface_find(s[0].surface[..], "ps.auth.act") >= 0;
  #assert surface_find(s[0].surface[..], "ps.am.btn") >= 0;

  // Toggle Antigravity off then back on -> dispatches CP_ASK_PS_TOGGLE.
  t0 := surface_find(s[0].surface[..], "ps.tog.0");
  #assert t0 >= 0 && cp_press(s, t0) && coder_page_action(s) == CP_ASK_PS_TOGGLE;
  #assert coder_page_ps_action_idx(s) == 0 && !coder_page_ps_inst_enabled(s, 0);
  #assert cp_press(s, t0) && coder_page_action(s) == CP_ASK_PS_TOGGLE && coder_page_ps_inst_enabled(s, 0);

  // Open Sign-in method menu -> pick Gemini Enterprise -> dispatches CP_ASK_PS_CONFIG.
  amb := surface_find(s[0].surface[..], "ps.am.btn");
  #assert amb >= 0 && cp_press(s, amb) && s[0].ps[0].auth_menu_open;
  #assert cp_ps_test_frame(s, 1280, 840);
  am1 := surface_find(s[0].surface[..], "ps.am.1");
  #assert am1 >= 0 && cp_press(s, am1) && !s[0].ps[0].auth_menu_open;
  #assert coder_page_action(s) == CP_ASK_PS_CONFIG && coder_page_ps_int(s, 1) == CP_PS_AUTH_BUSINESS;

  // Focus GCP project inline editor via REAL (x, y) pointer click, verify I-beam cursor & CP_ASK_PS_FOCUS
  // (never CP_ASK_FOCUS which would clobber keyboard focus back to the composer!), simulate host focus,
  // type via IME, then click straight into GCP location and verify CP_ASK_PS_CONFIG is NOT lost.
  s[0].ps[0].detail_scroll = 300;
  #assert cp_ps_test_frame(s, 1280, 840);
  proj_ed := surface_find(s[0].surface[..], "ps.ed.3");
  #assert proj_ed >= 0;
  tb := surface_rows(s[0].surface[..]);
  pr := tb.rows[proj_ed];
  px := pr.x + pr.w * 0.5f32;
  py := pr.y + pr.h * 0.5f32;
  // Hover over GCP project box -> I-beam cursor (1).
  _ = coder_page_press(s, px, py, 1, 0, 0);
  #assert coder_page_cursor(s) == 1;
  // Click GCP project box -> focuses immediately on mouseDown, emits CP_ASK_PS_FOCUS (188), NOT CP_ASK_FOCUS (2).
  #assert coder_page_press(s, px, py, 0, 1, 0);
  #assert coder_page_action(s) == CP_ASK_PS_FOCUS;
  // Simulate host handling CP_ASK_PS_FOCUS -> calls coder_page_focus(s, CP_KB_PROV).
  coder_page_focus(s, CP_KB_PROV);
  _ = coder_page_press(s, px, py, 2, 1, 0);
  #assert coder_page_wants_text(s) && cp_ed_which(s) == CP_ED_PROV && s[0].ps[0].ed_field == CP_PS_ED_GCP_PROJECT;
  // Type via IME and paste, verify text updates live.
  coder_page_ime_replace(s, -1, -1, "-prod");
  buf: [128] u8;
  bn := coder_page_ps_field(s, 2, buf[..]);
  #assert cast(string) buf[0..<bn] == "openagents-gemini-prod";
  // Click directly from dirty GCP project into GCP location -> commits GCP project (CP_ASK_PS_CONFIG preserved!)
  // while keeping keyboard focus in GCP location.
  #assert cp_ps_test_frame(s, 1280, 840);
  loc_ed := surface_find(s[0].surface[..], "ps.ed.4");
  #assert loc_ed >= 0;
  tb2 := surface_rows(s[0].surface[..]);
  lr := tb2.rows[loc_ed];
  #assert coder_page_press(s, lr.x + lr.w * 0.5f32, lr.y + lr.h * 0.5f32, 0, 1, 0);
  #assert coder_page_action(s) == CP_ASK_PS_CONFIG;
  _ = coder_page_press(s, lr.x + lr.w * 0.5f32, lr.y + lr.h * 0.5f32, 2, 1, 0);
  #assert coder_page_wants_text(s) && cp_ed_which(s) == CP_ED_PROV && s[0].ps[0].ed_field == CP_PS_ED_GCP_LOCATION;
  // Tab advances from GCP location -> Binary path; Enter blurs and commits cleanly.
  #assert coder_page_key(s, -15, 0) && s[0].ps[0].ed_field == CP_PS_ED_BINARY_PATH && cp_ed_which(s) == CP_ED_PROV;
  #assert coder_page_key(s, KEY_ENTER, 0) && s[0].ps[0].ed_field == CP_PS_ED_NONE && !coder_page_wants_text(s);

  // Add environment variable, mark secret, then remove.
  #assert cp_ps_test_frame(s, 1280, 840);
  env_add := surface_find(s[0].surface[..], "ps.env.add");
  #assert env_add >= 0 && cp_press(s, env_add) && coder_page_ps_int(s, 5) == 1;
  #assert cp_ps_test_frame(s, 1280, 840);
  env_sec := surface_find(s[0].surface[..], "ps.envs.0");
  #assert env_sec >= 0 && cp_press(s, env_sec) && coder_page_action(s) == CP_ASK_PS_ENV_SAVE;
  #assert s[0].ps[0].detail[0].envs[0].secret;

  // Model toggle + reorder.
  s[0].ps[0].detail_scroll = 520;
  #assert cp_ps_test_frame(s, 1280, 840);
  m_star := surface_find(s[0].surface[..], "ps.ms.1");
  #assert m_star >= 0 && cp_press(s, m_star) && coder_page_action(s) == CP_ASK_PS_MODELS_SAVE;
  #assert s[0].ps[0].detail[0].models[1].favorite;

  // Open Add provider 3-step modal wizard: Step 1 shows only Antigravity (Claude/Codex hidden).
  add_btn := surface_find(s[0].surface[..], "ps.add.list");
  #assert add_btn >= 0 && cp_press(s, add_btn) && s[0].ps[0].wiz[0].open && s[0].ps[0].wiz[0].step == 0;
  #assert cp_ps_test_frame(s, 1280, 840);
  #assert surface_find(s[0].surface[..], "ps.wd.0") >= 0;
  #assert surface_find(s[0].surface[..], "ps.wd.1") < 0 && surface_find(s[0].surface[..], "ps.wd.2") < 0;
  next1 := surface_find(s[0].surface[..], "ps.wiz.next");
  #assert next1 >= 0 && cp_press(s, next1) && s[0].ps[0].wiz[0].step == 1;
  #assert cp_ps_test_frame(s, 1280, 840);
  next2 := surface_find(s[0].surface[..], "ps.wiz.next");
  #assert next2 >= 0 && cp_press(s, next2) && s[0].ps[0].wiz[0].step == 2;
  #assert cp_ps_test_frame(s, 1280, 840);
  #assert surface_find(s[0].surface[..], "ps.wam.btn") >= 0;
  next3 := surface_find(s[0].surface[..], "ps.wiz.next");
  #assert next3 >= 0 && cp_press(s, next3) && !s[0].ps[0].wiz[0].open;
  #assert coder_page_action(s) == CP_ASK_PS_WIZ_CREATE;
}

#test "providers settings: loaded Antigravity models surface individually in composer picker with per-model X-High and Providers shortcut" #steps 60000000 {
  p: [1] CoderPage; st: [1] CpCheckStore; s := cp_check_page(p[..], st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_flags_set(s, 0);
  coder_page_local_state(s, true, true, 64, CP_LOCAL_READY, 100, 16811, 16811, "");
  coder_page_set_inkling(s, true);

  // 1. Default (show_other_models == false): Flawed (4 models) + Inkling (1) = 5 models are shown,
  //    Flawed Settings + Manage Local Models + Show other models… appear in the footer,
  //    and Providers shortcut appears once the user clicks Show other models…
  coder_page_show_other_models_set(s, false);
  #assert cp_models(s) == CP_FLAWED_MODELS + 1 && coder_page_model_flawed(s) && !cp_model_agy_test(s);
  coder_page_toggle_models(s);
  #assert cp_ps_test_frame(s, 1200, 800);
  #assert surface_find(s[0].surface[..], "coder.model.flawed") >= 0;
  #assert surface_find(s[0].surface[..], "coder.model.providers") < 0;
  others_row := surface_find(s[0].surface[..], "coder.model.others");
  #assert others_row >= 0 && surface_say(s[0].surface[..], others_row) == "Show other models…";
  // Pressing Show other models… opts in, keeps the menu open, and reveals Connect Antigravity…
  #assert cp_press(s, others_row) && coder_page_show_other_models(s) && coder_page_action(s) == CP_ASK_SHOW_OTHER_MODELS && s[0].model_menu;
  #assert cp_ps_test_frame(s, 1200, 800);
  prov_row := surface_find(s[0].surface[..], "coder.model.providers");
  #assert prov_row >= 0 && surface_say(s[0].surface[..], prov_row) == "Connect Antigravity…";
  // Pressing Connect Antigravity... opens Settings -> Providers directly.
  #assert cp_press(s, prov_row) && !s[0].model_menu && s[0].set_open && coder_page_settings_page(s) == CP_PG_PROVIDERS;

  // Entering OAuth WAITING state auto-focuses the code paste input box.
  coder_page_ps_set_detail_auth(s, CP_PS_AS_WAITING, "Finish sign-in", "", "Cancel", false, "https://accounts.google.com/o/oauth2/auth?state=s1");
  #assert s[0].ps[0].ed_field == CP_PS_ED_OAUTH_CODE && cp_ed_which(s) == CP_ED_PROV;
  cp_settings_show(s, false, CP_PG_PROVIDERS);

  // 2. After Antigravity auth with show_other_models enabled: only Gemini 4 models are admitted,
  //    Flawed stays default (0..3), Inkling at 4, and Gemini 4 Neon & Carbon appear below them (5..6).
  coder_page_agy_models_clear(s);
  #assert coder_page_agy_models_add(s, "antigravity", "Antigravity", "gemini-3.8-flash", "Gemini 3.8 Flash", CP_EFF_BIT_LOW | CP_EFF_BIT_MED | CP_EFF_BIT_HIGH, CP_EFFORT_MEDIUM, false) == -1;
  #assert coder_page_agy_models_add(s, "antigravity", "Antigravity", "gemini-pro-orchestrator", "Orchestrator", 0, CP_EFFORT_MEDIUM, false) == -1;
  #assert coder_page_agy_models_add(s, "antigravity", "Antigravity", "gemini-4-neon", "Gemini 4 Neon", CP_EFF_BIT_LOW | CP_EFF_BIT_MED | CP_EFF_BIT_HIGH | CP_EFF_BIT_XHIGH, CP_EFFORT_HIGH, false) == 0;
  #assert coder_page_agy_models_add(s, "antigravity-work", "Work", "gemini-4-carbon", "Gemini 4 Carbon", CP_EFF_BIT_LOW | CP_EFF_BIT_MED | CP_EFF_BIT_HIGH, CP_EFFORT_HIGH, true) == 1;
  coder_page_set_agy(s, true);
  #assert cp_has_model_picker(s) && cp_models(s) == CP_FLAWED_MODELS + 3;
  #assert cp_model_label(s, 0) == "OpenAgents · Gemini 4 Neon" && cp_model_id(s, 0) == "oa:gemini-4-neon";
  #assert cp_model_label(s, CP_FLAWED_START_LOCAL) == "OpenAgents · Inkling 2 Mini" && cp_model_id(s, CP_FLAWED_START_LOCAL) == "oa:inkling-2-mini";
  #assert cp_model_label(s, CP_FLAWED_MODELS) == "Inkling 2 Mini" && cp_model_id(s, CP_FLAWED_MODELS) == "inkling-2-mini";
  neon_i := CP_FLAWED_MODELS + 1;
  carb_i := CP_FLAWED_MODELS + 2;
  #assert cp_model_label(s, neon_i) == "Gemini 4 Neon" && cp_model_id(s, neon_i) == "agy:gemini-4-neon";
  #assert cp_model_label(s, carb_i) == "Gemini 4 Carbon" && cp_model_id(s, carb_i) == "agy:gemini-4-carbon";
  // Empty new chat stays on default OpenAgents · Gemini 4 Neon (Antigravity never hijacks it).
  #assert !coder_page_model_agy(s) && cp_model_id(s, cp_model_index(s)) == "oa:gemini-4-neon";
  #assert cp_model_start(s) == 0;

  // Neon supports 4 thinking levels (including X-High); Carbon supports 3.
  #assert cp_effort_count(s, neon_i) == 4 && cp_effort_count(s, carb_i) == 3;
  #assert coder_page_pick_model(s, "agy:gemini-4-neon") && coder_page_model_agy(s);
  #assert cp_effort_label(s, cp_model_index(s)) == "High" && cp_task_effort(s, cp_model_index(s)) == "high";
  ib: [64] u8;
  #assert cast(string) ib[0..<coder_page_model_inst_id(s, ib[..])] == "antigravity";
  s[0].effort = CP_EFFORT_XHIGH;
  #assert cp_effort_label(s, cp_model_index(s)) == "X-High";
  // Task line sends agy:gemini-4-neon + xhigh.
  #assert coder_page_set_text(s, "hello neon") && coder_page_submit(s);
  tb: [8192] u8; tn := coder_page_task(s, "s-agy", "/w", tb[..]);
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; back: [1] McTask;
  #assert tn > 0 && mww_task_read(ar[..], cast(string) tb[0..<tn - 1], back[..]);
  #assert back[0].model == "agy:gemini-4-neon" && back[0].effort == "xhigh" && !back[0].local;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"ok\"}") == MWW_ENDED;

  // Switching to Carbon clamps X-High down to High and reports instance "antigravity-work".
  #assert coder_page_pick_model(s, "agy:gemini-4-carbon");
  #assert cp_effort_label(s, cp_model_index(s)) == "High";
  #assert cast(string) ib[0..<coder_page_model_inst_id(s, ib[..])] == "antigravity-work";

  // Refreshing the model list preserves the active selection ("agy:gemini-4-carbon").
  coder_page_agy_models_clear(s);
  _ = coder_page_agy_models_add(s, "antigravity", "Antigravity", "gemini-4-neon", "Gemini 4 Neon", CP_EFF_BIT_LOW | CP_EFF_BIT_MED | CP_EFF_BIT_HIGH | CP_EFF_BIT_XHIGH, CP_EFFORT_HIGH, false);
  _ = coder_page_agy_models_add(s, "antigravity-work", "Work", "gemini-4-carbon", "Gemini 4 Carbon", CP_EFF_BIT_LOW | CP_EFF_BIT_MED | CP_EFF_BIT_HIGH, CP_EFFORT_HIGH, true);
  coder_page_set_agy(s, true);
  #assert cp_model_id(s, cp_model_index(s)) == "agy:gemini-4-carbon";

  // Model menu footer updates to "Manage Providers…" and each row keeps its own pooled subtitle.
  coder_page_toggle_models(s);
  #assert cp_ps_test_frame(s, 1200, 800);
  prov_row2 := surface_find(s[0].surface[..], "coder.model.providers");
  #assert prov_row2 >= 0 && surface_say(s[0].surface[..], prov_row2) == "Manage Providers…";
  m1 := surface_find(s[0].surface[..], "coder.model.6");
  m2 := surface_find(s[0].surface[..], "coder.model.7");
  #assert m1 >= 0 && m2 >= 0;
  mt := [1] ElTable.[surface_rows(s[0].surface[..])];
  #assert cast(string) mt[0].rows[m1].value[0..<mt[0].rows[m1].value_n] == "Antigravity · gemini-4-neon";
  #assert cast(string) mt[0].rows[m2].value[0..<mt[0].rows[m2].value_n] == "Work · gemini-4-carbon";

  // Starting a new chat always defaults to Flawed · Gemini 4 Neon (even when s[0].inkling is true).
  #assert coder_page_new(s) && !coder_page_model_agy(s) && cp_model_id(s, cp_model_index(s)) == "oa:gemini-4-neon";

  // Hiding other models collapses right back to Flawed + Inkling.
  coder_page_show_other_models_set(s, false);
  #assert cp_has_model_picker(s) && cp_models(s) == CP_FLAWED_MODELS + 1 && cp_model_id(s, cp_model_index(s)) == "oa:gemini-4-neon";
}

cp_model_agy_test :: (s: [] CoderPage) -> bool { return coder_page_model_agy(s); }
