// Checks for the pictures a command shows inline (shows.coax, GitHub #13792 chat slice): which
// lines ask for a picture, the card under the message's activity, and what a press opens. Example data only.
#load "../parts.coax";
#load "checks-kit.coax";

#test "shows: OA-SHOW lines name pictures, with their captions and what a press opens; others are passed over" {
  out: [CP_SHOWS] CpShow;
  text := "Routed 4 feeders\nOA-SHOW: /r/before.jpg\nOA-SHOW-CAPTION: Before  \nOA-SHOW-OPEN: /r/step_000.ple-scene.json\nOA-SHOW: relative.jpg\nOA-SHOW: /r/notes.txt\nOA-SHOW: /r/after.png\nOA-SHOW-OPEN: not/whole\n";
  n := cp_shows_parse(text, out[..], 0);
  #assert n == 2;
  #assert out[0].pic == "/r/before.jpg" && out[0].caption == "Before" && out[0].open == "/r/step_000.ple-scene.json";
  #assert out[1].pic == "/r/after.png" && out[1].caption.count == 0 && out[1].open.count == 0;
  // a caption with no picture before it in its own output is not some other command's
  #assert cp_shows_parse("OA-SHOW-CAPTION: stray\n", out[..], 2) == 2 && out[1].caption.count == 0;
  // past CP_SHOWS the newest are kept
  many := "OA-SHOW: /a.jpg\nOA-SHOW: /b.jpg\nOA-SHOW: /c.jpg\nOA-SHOW: /d.jpg\nOA-SHOW: /e.jpg\n";
  #assert cp_shows_parse(many, out[..], 0) == CP_SHOWS && out[0].pic == "/b.jpg" && out[CP_SHOWS - 1].pic == "/e.jpg";
  #assert cp_show_scene("/r/run.ple-scene.json") && !cp_show_scene("/r/after.jpg");
}

#test "shows: a command's pictures stand over the reply, and a press opens the run's scene" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  f: [1] UiFrame;
  #assert coder_page_set_text(s, "trigger a run and show me") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, "{\"kind\":\"turn\",\"turn\":1,\"source\":\"message\",\"id\":\"\",\"text\":\"\"}") == MWW_TURN;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"ple-run feeders\",\"exit\":0,\"timed_out\":false,\"output\":\"Routed 4\\nOA-SHOW: /r/before.jpg\\nOA-SHOW-CAPTION: Before\\nOA-SHOW-OPEN: /r/step_000.ple-scene.json\\nOA-SHOW: /r/after.jpg\\nOA-SHOW-CAPTION: After\\nOA-SHOW-OPEN: /r/run.ple-scene.json\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"reply\",\"text\":\"Here it is.\"}") > 0;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Here it is.\"}") == MWW_ENDED;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]);
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  a := elt_find(t[..], "t0.show0"); b := elt_find(t[..], "t0.show1");
  #assert a >= 0 && b >= 0 && el_box(t[0].rows[a]).y < el_box(t[0].rows[b]).y;
  // shown while the activity group is folded, and above the reply
  #assert s[0].turns[0].ay > el_box(t[0].rows[b]).y;
  // the host is asked to decode each picture
  #assert s[0].cmp_gpu[0].img_state[0] == CP_IMG_PENDING || s[0].cmp_gpu[0].img_state[1] == CP_IMG_PENDING;
  #assert cp_press(s, surface_find(s[0].surface[..], "t0.show1")) && coder_page_action(s) == CP_ASK_OPEN_FILE;
  #assert cp_open_path(s) == "/r/run.ple-scene.json";
  // a file a reply names still opens as before once a picture was pressed
  #assert cp_open_file(s, -1, 0, 0) == (cp_open_path(s).count > 0) && s[0].open_show == -1;
}

#test "shows: a live card is the scene the host mounts its 3D viewport over, the newest on screen" {
  out: [CP_SHOWS] CpShow;
  #assert cp_shows_parse("OA-SHOW: /r/a.jpg\nOA-SHOW-OPEN: /r/run.ple-scene.json\nOA-SHOW-LIVE: on\nOA-SHOW: /r/b.jpg\nOA-SHOW-LIVE: off\n", out[..], 0) == 2;
  #assert out[0].live && out[0].open == "/r/run.ple-scene.json" && !out[1].live;
  #assert cp_shows_parse("OA-SHOW-LIVE: on\n", out[..], 0) == 0;
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s);
  f: [1] UiFrame;
  #assert coder_page_set_text(s, "show me the run live") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, "{\"kind\":\"turn\",\"turn\":1,\"source\":\"message\",\"id\":\"\",\"text\":\"\"}") == MWW_TURN;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"ple-run show\",\"exit\":0,\"timed_out\":false,\"output\":\"OA-SHOW: /r/before.jpg\\nOA-SHOW-OPEN: /r/step_000.ple-scene.json\\nOA-SHOW-LIVE: on\\nOA-SHOW: /r/after.jpg\\nOA-SHOW-OPEN: /r/run.ple-scene.json\\nOA-SHOW-LIVE: on\\nOA-SHOW: /r/x.jpg\\nOA-SHOW-OPEN: /r/x.txt\\nOA-SHOW-LIVE: on\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Done.\"}") == MWW_ENDED;
  r: [8] f32; pb: [256] u8;
  // off while Experimental features are: the cards are pictures, as any other
  s[0].experimental = false;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]);
  #assert coder_page_live_scene(s, r[..], pb[..]) == 0;
  s[0].experimental = true;
  #assert cp_test_draw(s, f[..]);
  n := coder_page_live_scene(s, r[..], pb[..]);
  #assert n > 0 && cast(string) pb[0..<n] == "/r/run.ple-scene.json";
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  b := elt_find(t[..], "t0.show1");
  sc := cp_scale(s);
  #assert b >= 0 && r[0] == el_box(t[0].rows[b]).x * sc && r[1] == el_box(t[0].rows[b]).y * sc && r[2] == el_box(t[0].rows[b]).w * sc && r[3] == el_box(t[0].rows[b]).h * sc;
  // the clip is the conversation's, which holds the card
  #assert r[5] <= r[1] && r[1] + r[3] <= r[5] + r[7] && r[4] <= r[0] && r[0] + r[2] <= r[4] + r[6];
  // too small a path buffer, and a card scrolled out of the conversation, give none
  small: [8] u8;
  #assert coder_page_live_scene(s, r[..], small[..]) == 0;
  s[0].live_r[5] = r[1] + r[3]; s[0].live_r[7] = 10;
  #assert !cp_show_live(s, out[0], 0, r[1] / sc, 10, r[3] / sc);
  s[0].live_r[5] = 0; s[0].live_r[7] = r[1];
  #assert !cp_show_live(s, out[0], 0, r[1] / sc, 10, r[3] / sc);
  #assert cp_show_live(s, out[0], 0, r[1] / sc - 1, 10, r[3] / sc);
  // a card inside a clip that does not start at the top
  s[0].live_r[5] = 100 * sc; s[0].live_r[7] = 50 * sc;
  #assert cp_show_live(s, out[0], 0, 120, 10, 10) && !cp_show_live(s, out[0], 0, 150, 10, 10) && !cp_show_live(s, out[0], 0, 90, 10, 10);
  // a scene path past what the page keeps is a picture
  lp: [CP_IMG_PATH + 1] u8;
  for k: 0..<lp.count { lp[k] = 'a'; }
  lp[0] = '/'; tail := ".ple-scene.json";
  for k: 0..<tail.count { lp[lp.count - tail.count + k] = tail[k]; }
  long := out[0]; long.open = cast(string) lp[..];
  #assert !cp_show_live(s, long, 0, 120, 10, 10);
  long.open = cast(string) lp[1..<lp.count];   // CP_IMG_PATH bytes: kept whole
  #assert cp_show_live(s, long, 0, 120, 10, 10) && s[0].live_path_n == CP_IMG_PATH && s[0].live_path[CP_IMG_PATH - 1] == 'n';
  long.open = cast(string) lp[0..<lp.count - 1];
  #assert !cp_show_live(s, long, 0, 120, 10, 10);   // not a scene's name
  // with Settings open the conversation is not drawn, so no card is live
  s[0].set_open = true;
  #assert cp_test_draw(s, f[..]) && coder_page_live_scene(s, r[..], pb[..]) == 0;
}

#test "over rects: what the page draws over everything, merged where it touches, for a native view to leave uncovered" {
  l: [16] Prim; n := 0; c := rgba(1, 1, 1, 1);
  n = uiskin_shadow(l[..], n, 0, 0, 100, 50, 8, cp_skin().shadows.menu);   // a shadow is not the box
  n = prim_box(l[..], n, 10, 10, 100, 50, 8, 1, c, c);
  n = prim_text(l[..], n, 20, 20, 400, 16, 0, c, "x");                    // text inside it is not counted
  n = prim_box(l[..], n, 100, 40, 20, 40, 0, 0, c, c);                      // touches the first: one rect
  n = prim_alpha(l[..], n, 0); n = prim_box(l[..], n, 300, 300, 10, 10, 0, 0, c, c); n = prim_unalpha(l[..], n);   // unseen
  n = prim_image(l[..], n, 1, 200, 0, 10, 10);
  n = prim_backdrop(l[..], n, 400, 0, 20, 20, 4, 8);
  n = prim_box(l[..], n, 500, 0, 0, 10, 0, 0, c, c);                        // empty
  out: [16] f32;
  #assert cp_over_rects(l[0..<n], 2, out[..]) == 3;
  #assert out[0] == 20 && out[1] == 20 && out[2] == 220 && out[3] == 140;
  #assert out[4] == 400 && out[5] == 0 && out[6] == 20 && out[7] == 20 && out[8] == 800 && out[10] == 40;
  // past what out holds, the rest join its last
  few: [8] f32;
  #assert cp_over_rects(l[0..<n], 1, few[..]) == 2 && few[4] == 200 && few[6] == 220 && few[7] == 20;
  none: [2] f32;
  #assert cp_over_rects(l[0..<n], 1, none[..]) == 0;
}

#test "over rects: a menu over a live 3D card is handed to the host; none while nothing is over it" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_test_composing(s);
  #assert coder_page_set_text(s, "show me the run live") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"turn\",\"turn\":1,\"source\":\"message\",\"id\":\"\",\"text\":\"\"}") == MWW_TURN;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"ple-run show\",\"exit\":0,\"timed_out\":false,\"output\":\"OA-SHOW: /r/after.jpg\\nOA-SHOW-OPEN: /r/run.ple-scene.json\\nOA-SHOW-LIVE: on\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Done.\"}") == MWW_ENDED;
  out: [262144] f32; r: [8] f32; pb: [256] u8; o: [32] f32;
  for i: 0..<3 { _v := coder_page_frame(s, out[..], 1200, 800, 1, 0); }
  #assert coder_page_live_scene(s, r[..], pb[..]) > 0;
  k := coder_page_over_rects(s, o[..]);
  for i: 0..<k { #assert !(o[i * 4] < r[0] + r[2] && o[i * 4] + o[i * 4 + 2] > r[0] && o[i * 4 + 1] < r[1] + r[3] && o[i * 4 + 1] + o[i * 4 + 3] > r[1]); }
  coder_page_menu_begin(s);
  #assert coder_page_menu_item(s, "Copy", 0, false, false, false) && coder_page_menu_item(s, "Open", 0, false, false, false);
  coder_page_menu_show(s, r[0] + 20, r[1] + 20);
  for i: 0..<20 { _v := coder_page_frame(s, out[..], 1200, 800, 1, 0.05); }
  k = coder_page_over_rects(s, o[..]);
  hit := false;
  for i: 0..<k { if o[i * 4] < r[0] + r[2] && o[i * 4] + o[i * 4 + 2] > r[0] && o[i * 4 + 1] < r[1] + r[3] && o[i * 4 + 1] + o[i * 4 + 3] > r[1] && o[i * 4 + 1] >= r[1] { hit = true; } }
  #assert k > 0 && hit;
  small: [4] f32;
  #assert coder_page_over_rects(s, small[..]) == 1 && coder_page_over_rects(s[0..<0], o[..]) == 0;
}
