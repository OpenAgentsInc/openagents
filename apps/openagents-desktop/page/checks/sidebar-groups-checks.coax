// Checks for page/sidebar_groups.coax and layout/sidebar.coax (GitHub #13875):
// flat chronological chat list (most recent message first, no project grouping),
// lifted 50-chat cap, Working shelf, archive/unarchive view, snooze auto-wake,
// multi-select bulk actions, and undo toast.
#load "../parts.coax";
#load "checks-kit.coax";

cp_sb_test_frame :: (s: [] CoderPage, f: [] UiFrame, t: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), t, 0.016f32, true, false);
  cp_layout(s, f, 1200.0f32, 1600.0f32);
  _ = cp_overlay(s, f, 1200.0f32, 1600.0f32, 0.016f32);
  return uiframe_end(f, s[0].surface[..]);
}

cp_sb_click_id :: (s: [] CoderPage, id: string, mods: int) -> bool {
  idx := surface_find(s[0].surface[..], id);
  if idx < 0 { return false; }
  r := surface_rows(s[0].surface[..]).rows[idx];
  cx := r.x + r.w * 0.5f32;
  cy := r.y + r.h * 0.5f32;
  if !coder_page_press(s, cx, cy, 0, 1, mods) { return false; }
  return coder_page_press(s, cx, cy, 2, 1, mods);
}

#test "sidebar renders one flat chronological chat list sorted by most recent message with no projects UI and lifted 50-chat cap" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // Mixed working folders and out-of-order updated_ms timestamps (column 10) + one pinned chat.
  coder_page_chats(s, "p1\tPinned task\t0\t1\t0\t0\t0\t0\t/Users/dev/work/openagents\t1000\na1\tOlder chat\t0\t0\t0\t0\t0\t0\t/Users/dev/work/openagents\t2000\nb1\tNewest chat\t0\t0\t0\t0\t0\t0\t/Users/dev/work/app-ios\t5000\ng1\tMiddle chat\t0\t0\t0\t0\t0\t0\t\t3500\n");
  #assert s[0].nchats == 4;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Zero project UI: no Projects heading, no Add project button, no project folder rows.
  #assert surface_find(s[0].surface[..], "coder.projects") < 0;
  #assert surface_find(s[0].surface[..], "coder.sb.add_project") < 0;
  #assert surface_find(s[0].surface[..], "coder.proj.0") < 0;
  #assert surface_find(s[0].surface[..], "coder.proj.1") < 0;
  // Footer retains unified icon-only Settings button; no legacy Active/Archived tabs or footer archive button.
  #assert surface_find(s[0].surface[..], "coder.sb.tab.active") < 0 && surface_find(s[0].surface[..], "coder.sb.tab.archived") < 0;
  #assert surface_find(s[0].surface[..], "coder.sb.archived") < 0;
  #assert surface_find(s[0].surface[..], "coder.me") < 0 && surface_find(s[0].surface[..], "coder.me.settings") >= 0;
  // All chats are visible immediately in one list without expanding any folder.
  i_p1 := surface_find(s[0].surface[..], "chat.p1");
  i_b1 := surface_find(s[0].surface[..], "chat.b1");
  i_g1 := surface_find(s[0].surface[..], "chat.g1");
  i_a1 := surface_find(s[0].surface[..], "chat.a1");
  #assert i_p1 >= 0 && i_b1 >= 0 && i_g1 >= 0 && i_a1 >= 0;
  // Chronological order from most recent message: b1 (5000) above g1 (3500) above a1 (2000).
  rows := surface_rows(s[0].surface[..]).rows;
  #assert rows[i_b1].y < rows[i_g1].y && rows[i_g1].y < rows[i_a1].y;
  // Lift 50-chat visibility cap: 75 chats load with chats_more == 0.
  lb: [4096] u8; ln := 0;
  for i: 0..<75 {
    ln = el_put(lb[..], ln, "c"); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\tChat "); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\t0\t0\t0\t0\t0\t0\t/tmp/repo\t");
    ln = el_put_i(lb[..], ln, 1000 + i);
    ln = el_put(lb[..], ln, "\n");
  }
  coder_page_chats(s, cast(string) lb[0..<ln]);
  #assert s[0].nchats == 75 && s[0].chats_more == 0;
  // Highest updated_ms (c74) sorts to the top.
  #assert cast(string) s[0].chats[0].id[0..<s[0].chats[0].id_n] == "chat.c74";
}

#test "archived chats hide from active list, show in Archived view, and undo toast restores or expires" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tActive thread\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc2\tArchived thread\t0\t0\t0\t0\t1\t0\t/tmp/repo\n");
  #assert cp_sb_archived_count(s) == 1;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Active view shows c1 immediately and hides c2.
  #assert surface_find(s[0].surface[..], "coder.sb.tab.active") < 0 && surface_find(s[0].surface[..], "coder.sb.tab.archived") < 0;
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") < 0;
  // Archived view shows c2 and hides c1.
  coder_page_sb_set_view(s, CP_SB_VIEW_ARCHIVED);
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ARCHIVED;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c1") < 0;
  // Switch back to Active view.
  coder_page_sb_set_view(s, CP_SB_VIEW_ACTIVE);
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ACTIVE;
  // Undo toast: show, click Undo -> dispatches CP_ASK_SIDEBAR + CP_SB_OP_UNDO.
  s[0].clock = 10.0f32;
  coder_page_sb_undo_show(s, "Archived \"Archived thread\"", CP_SB_UNDO_ARCHIVE, 5.0f32);
  #assert cp_sb_test_frame(s, f[..], 10.0f32);
  #assert surface_find(s[0].surface[..], "coder.sb.undo.btn") >= 0;
  #assert cp_sb_click_id(s, "coder.sb.undo.btn", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_UNDO;
  #assert !s[0].sb[0].undo[0].active;
  // Undo toast auto-dismisses when clock advances past duration.
  s[0].clock = 20.0f32;
  coder_page_sb_undo_show(s, "Deleted chat", CP_SB_UNDO_DELETE, 4.0f32);
  #assert cp_sb_undo_wake(s) > 3.9f32;
  s[0].clock = 24.5f32;
  #assert cp_sb_test_frame(s, f[..], 24.5f32);
  #assert !s[0].sb[0].undo[0].active;
  #assert surface_find(s[0].surface[..], "coder.sb.undo.btn") < 0;
}

#test "snoozed chats hide until wake time and resurface automatically" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_sb_now_ms(s, 1000000);
  coder_page_chats(s, "c1\tAwake chat\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc2\tSnoozed chat\t0\t0\t0\t0\t0\t2000000\t/tmp/repo\n");
  #assert cp_sb_snoozed_count(s) == 1;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") < 0;
  // Advance wall-clock past snoozed_until_ms -> c2 resurfaces automatically.
  coder_page_sb_now_ms(s, 2000000);
  #assert cp_sb_snoozed_count(s) == 0;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
}

#test "multi-select with Cmd-click and Shift-click supports bulk archive, restore, pin, and delete" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tFirst\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc2\tSecond\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc3\tThird\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc4\tFourth\t0\t0\t0\t0\t0\t0\t/tmp/repo\n");
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Cmd-click (mods=8) on c1 selects c1 without opening it.
  #assert cp_sb_click_id(s, "chat.c1", 8);
  #assert coder_page_sb_sel_count(s) == 1;
  #assert coder_page_action(s) == CP_ASK_NONE;
  // Shift-click (mods=1) on c3 selects contiguous range c1, c2, c3.
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert cp_sb_click_id(s, "chat.c3", 1);
  #assert coder_page_sb_sel_count(s) == 3;
  // Cmd-click c2 toggles it off -> c1 and c3 remain selected.
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert cp_sb_click_id(s, "chat.c2", 8);
  #assert coder_page_sb_sel_count(s) == 2;
  // Bulk action bar appears; click Archive -> captures "c1\nc3", clears selection, asks host.
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert surface_find(s[0].surface[..], "coder.sb.bulk.archive") >= 0;
  #assert cp_sb_click_id(s, "coder.sb.bulk.archive", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_BULK_ARCHIVE;
  #assert coder_page_sb_sel_count(s) == 0;
  ids: [256] u8;
  idn := coder_page_sb_selected_ids(s, ids[..]);
  #assert cast(string) ids[0..<idn] == "c1\nc3";
  // Select c2 and c4, click Delete -> captures "c2\nc4" and dispatches CP_SB_OP_BULK_DELETE.
  #assert cp_sb_test_frame(s, f[..], 0.08f32);
  #assert cp_sb_click_id(s, "chat.c2", 8);
  #assert cp_sb_click_id(s, "chat.c4", 8);
  #assert cp_sb_test_frame(s, f[..], 0.10f32);
  #assert cp_sb_click_id(s, "coder.sb.bulk.delete", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_BULK_DELETE;
  idn = coder_page_sb_selected_ids(s, ids[..]);
  #assert cast(string) ids[0..<idn] == "c2\nc4";
  // Select c1, click Clear -> clears selection with no host ask.
  #assert cp_sb_test_frame(s, f[..], 0.12f32);
  #assert cp_sb_click_id(s, "chat.c1", 8);
  #assert cp_sb_test_frame(s, f[..], 0.14f32);
  #assert cp_sb_click_id(s, "coder.sb.bulk.clear", 0);
  #assert coder_page_sb_sel_count(s) == 0 && coder_page_action(s) == CP_ASK_NONE;
}

#test "working chats move to top Working shelf by default and return to the flat list on input or completion" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // c1 and g1 are running; c2 is idle.
  coder_page_chats(s, "c1\tdoes this work\t1\t0\t0\t0\t0\t0\t/tmp/openagents\nc2\tIdle chat\t0\t0\t0\t0\t0\t0\t/tmp/openagents\ng1\tQuick task\t1\t0\t0\t0\t0\t0\t\n");
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Working shelf is expanded by default at top with count 2; c2 sits in Recents below.
  w_idx := surface_find(s[0].surface[..], "coder.working");
  #assert w_idx >= 0;
  #assert (surface_rows(s[0].surface[..]).rows[w_idx].state & (EL_S_EXPANDS | EL_S_EXPANDED | EL_S_BUSY)) == (EL_S_EXPANDS | EL_S_EXPANDED | EL_S_BUSY);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0 && surface_find(s[0].surface[..], "chat.g1") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
  #assert surface_find(s[0].surface[..], "coder.projects") < 0 && surface_find(s[0].surface[..], "coder.proj.0") < 0;
  // Clicking Working collapses it and hides c1 and g1 from the Working shelf while c2 stays visible.
  #assert cp_sb_click_id(s, "coder.working", 0);
  #assert s[0].sb[0].working_collapsed;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c1") < 0 && surface_find(s[0].surface[..], "chat.g1") < 0;
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
  // Clicking Working again re-expands it.
  #assert cp_sb_click_id(s, "coder.working", 0);
  #assert !s[0].sb[0].working_collapsed;
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  // When c1 is the active chat and opens a permission/input prompt, it leaves Working into Recents.
  coder_page_current(s, "c1");
  s[0].permit[0].open = true;
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  // Once all chats finish, the Working shelf disappears and all three chats sit in Recents.
  s[0].permit[0].open = false;
  coder_page_chats(s, "c1\tdoes this work\t0\t0\t0\t0\t0\t0\t/tmp/openagents\nc2\tIdle chat\t0\t0\t0\t0\t0\t0\t/tmp/openagents\ng1\tQuick task\t0\t0\t0\t0\t0\t0\t\n");
  #assert cp_sb_test_frame(s, f[..], 0.08f32);
  #assert surface_find(s[0].surface[..], "coder.working") < 0;
  #assert surface_find(s[0].surface[..], "coder.chats") >= 0 && surface_find(s[0].surface[..], "chat.c1") >= 0 && surface_find(s[0].surface[..], "chat.g1") >= 0;
}

#test "sidebar caps visible chats at 5 with Load more pagination and shows Command+N shortcut on New chat" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  lb: [2048] u8; ln := 0;
  for i: 0..<12 {
    ln = el_put(lb[..], ln, "c"); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\tChat "); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\t0\t0\t0\t0\t0\t0\t/tmp/repo\t");
    ln = el_put_i(lb[..], ln, 1000 + i);
    ln = el_put(lb[..], ln, "\n");
  }
  coder_page_chats(s, cast(string) lb[0..<ln]);
  #assert s[0].nchats == 12;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // New chat row is present with CP_NEW action and renders the Command icon + "N" keycap.
  new_idx := surface_find(s[0].surface[..], "coder.new");
  #assert new_idx >= 0 && surface_action(s[0].surface[..], new_idx) == CP_NEW;
  sh := surface_sheet(s[0].surface[..]);
  has_cmd_icon := false;
  has_n_key := false;
  for i: 0..<sh.nu {
    if sh.under[i].kind == PRIM_ICON && sh.under[i].id == ICON_SET_COMMAND { has_cmd_icon = true; }
    if sh.under[i].kind == PRIM_TEXT && sh.under[i].text == "N" { has_n_key = true; }
  }
  for i: 0..<sh.no {
    if sh.over[i].kind == PRIM_ICON && sh.over[i].id == ICON_SET_COMMAND { has_cmd_icon = true; }
    if sh.over[i].kind == PRIM_TEXT && sh.over[i].text == "N" { has_n_key = true; }
  }
  #assert has_cmd_icon && has_n_key;
  // Initially only the 5 most recent chats (c11..c7) are shown, plus quiet "Load more (7)".
  #assert s[0].sb[0].vis_n == 5;
  #assert surface_find(s[0].surface[..], "chat.c11") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c7") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c6") < 0;
  lm_idx := surface_find(s[0].surface[..], "coder.sb.load_more");
  #assert lm_idx >= 0 && surface_action(s[0].surface[..], lm_idx) == CP_SB_LOAD_MORE_ACT;
  saw_lm_inline := false; saw_lm_right := false; lm_faint := false;
  sk := cp_skin();
  for i: 0..<sh.no {
    if sh.over[i].kind == PRIM_TEXT {
      if sh.over[i].text == "Load more (7)" {
        saw_lm_inline = true;
        lm_faint = sh.over[i].fill.r == sk.faint.r && sh.over[i].fill.g == sk.faint.g && sh.over[i].fill.b == sk.faint.b && sh.over[i].fill.a == sk.faint.a;
      }
      if sh.over[i].text == "7 more" { saw_lm_right = true; }
    }
  }
  #assert saw_lm_inline && !saw_lm_right && lm_faint;
  // Click Load more -> shows 10 chats (c11..c2) and Load more ("2 more").
  #assert cp_sb_click_id(s, "coder.sb.load_more", 0);
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert s[0].sb[0].vis_n == 10;
  #assert surface_find(s[0].surface[..], "chat.c6") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c1") < 0;
  #assert surface_find(s[0].surface[..], "coder.sb.load_more") >= 0;
  // Click Load more again -> shows all 12 chats and hides Load more.
  #assert cp_sb_click_id(s, "coder.sb.load_more", 0);
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert s[0].sb[0].vis_n == 12;
  #assert surface_find(s[0].surface[..], "chat.c0") >= 0;
  #assert surface_find(s[0].surface[..], "coder.sb.load_more") < 0;
  // Switching views resets chat_limit back to 5.
  coder_page_sb_set_view(s, CP_SB_VIEW_ARCHIVED);
  coder_page_sb_set_view(s, CP_SB_VIEW_ACTIVE);
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert s[0].sb[0].vis_n == 5 && surface_find(s[0].surface[..], "coder.sb.load_more") >= 0;
}

#test "sidebar polish: Cmd+Z triggers active undo toast when composer is empty, and multi-select stays distinct from current (#14029)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tActive\nc2\tOther\n");
  coder_page_current(s, "c1");
  s[0].sb[0].sel[1] = true; s[0].sb[0].sel_count = 1;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Multi-selected c2 does NOT carry EL_S_CURRENT (distinct fill from active c1).
  r1 := surface_find(s[0].surface[..], "chat.c1");
  r2 := surface_find(s[0].surface[..], "chat.c2");
  #assert r1 >= 0 && r2 >= 0;
  #assert (surface_rows(s[0].surface[..]).rows[r1].state & EL_S_CURRENT) != 0;
  #assert (surface_rows(s[0].surface[..]).rows[r2].state & EL_S_CURRENT) == 0;

  // Cmd+Z dispatches CP_SB_OP_UNDO when undo toast is active and composer is empty.
  coder_page_sb_undo_show(s, "Archived 1 chat", CP_SB_UNDO_ARCHIVE, 6.0f32);
  #assert s[0].sb[0].undo[0].active;
  #assert coder_page_key(s, 'z', MOD_CMD);
  #assert !s[0].sb[0].undo[0].active && s[0].sb[0].op == CP_SB_OP_UNDO && s[0].ask == CP_ASK_SIDEBAR;
}

#test "working shelf keeps stable row order when clicking between two working chats or receiving mid-turn updates" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // Two working chats: c1 (first, updated=2000) and c2 (second, updated=1000). c2 is currently shown.
  coder_page_chats(s, "c1\tFirst working\t1\t0\t0\t0\t0\t0\t/tmp/repo\t2000\nc2\tSecond working\t1\t0\t0\t0\t0\t0\t/tmp/repo\t1000\n");
  coder_page_current(s, "c2");
  f: [1] UiFrame;
  s[0].clock = 1.0f32;
  #assert cp_sb_test_frame(s, f[..], 1.0f32);
  rows := surface_rows(s[0].surface[..]).rows;
  i1 := surface_find(s[0].surface[..], "chat.c1");
  i2 := surface_find(s[0].surface[..], "chat.c2");
  #assert i1 >= 0 && i2 >= 0 && rows[i1].y < rows[i2].y;
  // Click the first working chat (c1).
  #assert cp_sb_click_id(s, "chat.c1", 0);
  #assert coder_page_action(s) == CP_ASK_OPEN;
  oid: [64] u8;
  on := coder_page_open_id(s, oid[..]);
  #assert cast(string) oid[0..<on] == "c1";
  // Even if the host refreshes the list with c2's updated_ms bumped above c1, c1 MUST stay above c2.
  coder_page_current(s, "c1");
  coder_page_chats(s, "c1\tFirst working\t1\t0\t0\t0\t0\t0\t/tmp/repo\t2000\nc2\tSecond working\t1\t0\t0\t0\t0\t0\t/tmp/repo\t5000\n");
  s[0].clock = 1.05f32;
  #assert cp_sb_test_frame(s, f[..], 1.05f32);
  rows = surface_rows(s[0].surface[..]).rows;
  i1 = surface_find(s[0].surface[..], "chat.c1");
  i2 = surface_find(s[0].surface[..], "chat.c2");
  #assert i1 >= 0 && i2 >= 0 && rows[i1].y < rows[i2].y;
  // ShiftGuard must NOT arm when the visual Working order stayed unchanged.
  #assert s[0].sb[0].shift_until <= s[0].clock;
  // Clicking the first row (c1) again does NOT toggle to c2 (c1 is already current -> no CP_ASK_OPEN).
  #assert !cp_sb_click_id(s, "chat.c1", 0);
  #assert coder_page_action(s) == CP_ASK_NONE;
  // Clicking the second row (c2) immediately opens c2 without being swallowed by ShiftGuard.
  #assert cp_sb_click_id(s, "chat.c2", 0);
  #assert coder_page_action(s) == CP_ASK_OPEN;
  on = coder_page_open_id(s, oid[..]);
  #assert cast(string) oid[0..<on] == "c2";
}

#test "sidebar view setting toggles between Expanded (2-line card) and Condensed (top line only)" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_sb_now_ms(s, 600000);
  coder_page_chats(s, "c1\tFirst chat\t0\t0\t0\t0\t0\t0\t/Users/dev/work/openagents\t540000\tmain\n");
  #assert !coder_page_sb_condensed(s);

  // Expanded (default): 2-line card renders both title and repo/branch line.
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  r_exp := surface_find(s[0].surface[..], "chat.c1");
  #assert r_exp >= 0;
  #assert surface_rows(s[0].surface[..]).rows[r_exp].h == APP_SIDE_CARD_H;
  #assert s[0].pin_row_h == APP_SIDE_CARD_H;
  sh := surface_sheet(s[0].surface[..]);
  saw_title := false; saw_repo := false; saw_age := false;
  for i: 0..<sh.no {
    if sh.over[i].kind == PRIM_TEXT {
      if sh.over[i].text == "First chat" { saw_title = true; }
      if sh.over[i].text == "openagents" { saw_repo = true; }
      if sh.over[i].text == "1m" { saw_age = true; }
    }
  }
  #assert saw_title && saw_repo && saw_age;

  // Settings > General > Sidebar view -> Condensed.
  #assert cp_settings_press(s, CP_SET_ACT, "set.sidebar.view.1");
  #assert coder_page_action(s) == CP_ASK_SIDEBAR_VIEW;
  #assert coder_page_sb_condensed(s);
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  r_cond := surface_find(s[0].surface[..], "chat.c1");
  #assert r_cond >= 0;
  #assert surface_rows(s[0].surface[..]).rows[r_cond].h == APP_SIDE_CARD_CONDENSED_H;
  #assert s[0].pin_row_h == APP_SIDE_CARD_CONDENSED_H;
  sh2 := surface_sheet(s[0].surface[..]);
  saw_title = false; saw_repo = false; saw_age = false;
  for i: 0..<sh2.no {
    if sh2.over[i].kind == PRIM_TEXT {
      if sh2.over[i].text == "First chat" { saw_title = true; }
      if sh2.over[i].text == "openagents" { saw_repo = true; }
      if sh2.over[i].text == "1m" { saw_age = true; }
    }
  }
  #assert saw_title && saw_age && !saw_repo;

  // Settings > General > Sidebar view -> Expanded restores 2-line card.
  #assert cp_settings_press(s, CP_SET_ACT, "set.sidebar.view.0");
  #assert coder_page_action(s) == CP_ASK_SIDEBAR_VIEW;
  #assert !coder_page_sb_condensed(s);
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  r_back := surface_find(s[0].surface[..], "chat.c1");
  #assert r_back >= 0 && surface_rows(s[0].surface[..]).rows[r_back].h == APP_SIDE_CARD_H;

  // Settings search discovers Sidebar view via "condensed".
  hits: [CP_SET_HITS] int;
  hn := cp_set_hits_flags("condensed", hits[..], 0);
  #assert hn >= 1 && cp_set_entries()[hits[0]].id == "set.sidebar.view";
}

#test "archived chats entry moves out of footer into Settings > General and returns via Archived heading back button" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tActive thread\t0\t0\t0\t0\t0\t0\t/tmp/repo\nc2\tArchived thread\t0\t0\t0\t0\t1\t0\t/tmp/repo\n");
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Footer has no archive button.
  #assert surface_find(s[0].surface[..], "coder.sb.archived") < 0;
  // Settings search finds Archived chats under General.
  hits: [CP_SET_HITS] int;
  hn := cp_set_hits_flags("archived", hits[..], 0);
  #assert hn >= 1 && cp_set_entries()[hits[0]].id == "set.sidebar.archived";
  // Open Settings > General and verify the Archived chats button row renders.
  cp_settings_show(s, true, CP_PG_GENERAL);
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "set.sidebar.archived.a") >= 0;
  // Clicking Archived chats View button switches sidebar to Archived view and closes Settings.
  #assert cp_settings_press(s, CP_SET_ACT, "set.sidebar.archived.a");
  #assert !s[0].set_open;
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ARCHIVED;
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0 && surface_find(s[0].surface[..], "chat.c1") < 0;
  // Clicking the Archived heading close/back button returns to Active chats.
  #assert surface_find(s[0].surface[..], "coder.archived.back") >= 0;
  #assert cp_sb_click_id(s, "coder.archived.back", 0);
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ACTIVE;
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0 && surface_find(s[0].surface[..], "chat.c2") < 0;
}
