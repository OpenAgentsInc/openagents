// Checks for page/sidebar_groups.coax and layout/sidebar.coax (GitHub #13875):
// project/repo grouping, collapsible headers, lifted 50-chat cap, folder drop/add,
// archive/unarchive view, snooze auto-wake, multi-select bulk actions, and undo toast.
#load "../parts.coax";
#load "checks-kit.coax";

cp_sb_test_frame :: (s: [] CoderPage, f: [] UiFrame, t: f32) -> bool {
  uiframe_begin(f, s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), t, 0.016f32, true, false);
  cp_layout(s, f, 1200.0f32, 800.0f32);
  _ = cp_overlay(s, f, 1200.0f32, 800.0f32, 0.016f32);
  return uiframe_end(f, s[0].surface[..]);
}

cp_sb_click_id :: (s: [] CoderPage, id: string, mods: int) -> bool {
  idx := surface_find(s[0].surface[..], id);
  if idx < 0 { return false; }
  r := surface_rows(s[0].surface[..]).rows[idx];
  cx := r.x + r.w * 0.5f32;
  cy := r.y + r.h * 0.5f32;
  if !coder_page_press(s, cx, cy, 0, 1, mods) { return false; }
  return coder_page_press(s, cx, cy, 2, 1, mods);
}

#test "sidebar groups chats by project folder, defaults collapsed, caps expanded projects at 10 with See all, and lifts the 50-chat cap" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  // Two projects + one pinned chat + one unassigned chat.
  coder_page_chats(s, "p1\tPinned task\t0\t1\t0\t0\t0\t0\t/Users/dev/work/openagents\na1\tFix sidebar\t0\t0\t0\t0\t0\t0\t/Users/dev/work/openagents\na2\tAdd tests\t0\t0\t0\t0\t0\t0\t/Users/dev/work/openagents/\nb1\tShip iOS\t0\t0\t0\t0\t0\t0\t/Users/dev/work/app-ios\ng1\tQuick note\t0\t0\t0\t0\t0\t0\t\n");
  #assert s[0].nchats == 5 && s[0].sb[0].nprojects == 2;
  #assert s[0].sb[0].projects[0].collapsed && s[0].sb[0].projects[1].collapsed;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Both project headers are visible and collapsed by default; Pinned stays at top, Projects heading + folder-add sit above folders.
  #assert surface_find(s[0].surface[..], "coder.pinned") >= 0;
  #assert surface_find(s[0].surface[..], "chat.p1") >= 0;
  #assert surface_find(s[0].surface[..], "coder.projects") >= 0;
  #assert surface_find(s[0].surface[..], "coder.sb.add_project") >= 0;
  // The old Active/Archived toolbar and split Local account pill are gone; single unified Settings footer remains.
  #assert surface_find(s[0].surface[..], "coder.sb.tab.active") < 0 && surface_find(s[0].surface[..], "coder.sb.tab.archived") < 0;
  #assert surface_find(s[0].surface[..], "coder.me") < 0 && surface_find(s[0].surface[..], "coder.me.settings") >= 0;
  // Projects heading and folder-plus button sit on the same horizontal row.
  ph := surface_rows(s[0].surface[..]).rows[surface_find(s[0].surface[..], "coder.projects")];
  pb := surface_rows(s[0].surface[..]).rows[surface_find(s[0].surface[..], "coder.sb.add_project")];
  #assert pb.x > ph.x && pb.y >= ph.y && pb.y + pb.h <= ph.y + ph.h + 1.0f32;
  #assert surface_find(s[0].surface[..], "coder.proj.0") >= 0;
  #assert surface_find(s[0].surface[..], "coder.proj.1") >= 0;
  // Project chats stay hidden until their project folder is expanded; unassigned g1 stays visible.
  #assert surface_find(s[0].surface[..], "chat.a1") < 0 && surface_find(s[0].surface[..], "chat.a2") < 0;
  #assert surface_find(s[0].surface[..], "chat.b1") < 0 && surface_find(s[0].surface[..], "chat.g1") >= 0;
  // Click project 0 header to expand it: a1 and a2 appear, b1 stays collapsed.
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert !s[0].sb[0].projects[0].collapsed && s[0].sb[0].projects[1].collapsed;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.a1") >= 0 && surface_find(s[0].surface[..], "chat.a2") >= 0;
  #assert surface_find(s[0].surface[..], "chat.b1") < 0;
  // Reloading chats preserves the expanded state of project 0 and collapsed state of project 1.
  coder_page_chats(s, "a1\tFix sidebar\t0\t0\t0\t0\t0\t0\t/Users/dev/work/openagents\nb1\tShip iOS\t0\t0\t0\t0\t0\t0\t/Users/dev/work/app-ios\n");
  #assert !s[0].sb[0].projects[0].collapsed && s[0].sb[0].projects[1].collapsed;
  // Click project 0 header again to collapse it.
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert s[0].sb[0].projects[0].collapsed;
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert surface_find(s[0].surface[..], "chat.a1") < 0;
  // Lift 50-chat visibility cap: 75 chats load with chats_more == 0.
  lb: [4096] u8; ln := 0;
  for i: 0..<75 {
    ln = el_put(lb[..], ln, "c"); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\tChat "); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\t0\t0\t0\t0\t0\t0\t/tmp/repo\n");
  }
  coder_page_chats(s, cast(string) lb[0..<ln]);
  #assert s[0].nchats == 75 && s[0].chats_more == 0;
}

#test "expanded project shows at most 10 chats with a See all button that expands the rest" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  lb: [2048] u8; ln := 0;
  for i: 0..<14 {
    ln = el_put(lb[..], ln, "c"); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\tThread "); ln = el_put_i(lb[..], ln, i);
    ln = el_put(lb[..], ln, "\t0\t0\t0\t0\t0\t0\t/tmp/bigproj\n");
  }
  coder_page_chats(s, cast(string) lb[0..<ln]);
  #assert s[0].nchats == 14 && s[0].sb[0].nprojects == 1 && s[0].sb[0].projects[0].collapsed;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  #assert surface_find(s[0].surface[..], "chat.c0") < 0 && surface_find(s[0].surface[..], "coder.proj.all.0") < 0;
  // Expand project 0 -> shows c0..c9 plus "See all", hides c10..c13.
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c0") >= 0 && surface_find(s[0].surface[..], "chat.c9") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c10") < 0 && surface_find(s[0].surface[..], "chat.c13") < 0;
  see_all := surface_find(s[0].surface[..], "coder.proj.all.0");
  #assert see_all >= 0 && surface_say(s[0].surface[..], see_all) == "See all";
  // Click "See all" -> reveals c10..c13 and hides the "See all" button.
  #assert cp_sb_click_id(s, "coder.proj.all.0", 0);
  #assert s[0].sb[0].projects[0].show_all;
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert surface_find(s[0].surface[..], "chat.c10") >= 0 && surface_find(s[0].surface[..], "chat.c13") >= 0;
  #assert surface_find(s[0].surface[..], "coder.proj.all.0") < 0;
  // Collapsing and re-expanding resets back to the 10-chat cap + "See all".
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert s[0].sb[0].projects[0].collapsed && !s[0].sb[0].projects[0].show_all;
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert cp_sb_test_frame(s, f[..], 0.08f32);
  #assert surface_find(s[0].surface[..], "chat.c9") >= 0 && surface_find(s[0].surface[..], "chat.c10") < 0;
  #assert surface_find(s[0].surface[..], "coder.proj.all.0") >= 0;
}

#test "adding projects via + Project button and folder drag-and-drop works" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  // Press "+ Project" toolbar button -> asks host for folder picker.
  #assert cp_sb_click_id(s, "coder.sb.add_project", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_ADD_PROJECT;
  // Explicit project added even with zero chats shows as a project header.
  #assert coder_page_sb_add_project(s, "/Users/dev/work/empty-repo/");
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "coder.proj.0") >= 0;
  // Drag-and-drop folder onto sidebar registers project and notifies host.
  #assert coder_page_sb_drop_folder(s, "/Users/dev/work/dropped-repo/");
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_DROP_PROJECT;
  dp: [CP_CHAT_FOLDER] u8;
  dn := coder_page_sb_drop_path(s, dp[..]);
  #assert cast(string) dp[0..<dn] == "/Users/dev/work/dropped-repo";
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert surface_find(s[0].surface[..], "coder.proj.1") >= 0;
}

#test "archived chats hide from active list, show in Archived view, and undo toast restores or expires" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tActive thread\t0\t0\t0\t0\t0\t0\t/tmp/proj\nc2\tArchived thread\t0\t0\t0\t0\t1\t0\t/tmp/proj\n");
  #assert cp_sb_archived_count(s) == 1;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert cp_sb_test_frame(s, f[..], 0.01f32);
  // Active view shows c1 and hides c2; no Active/Archived toolbar tabs are rendered.
  #assert surface_find(s[0].surface[..], "coder.sb.tab.active") < 0 && surface_find(s[0].surface[..], "coder.sb.tab.archived") < 0;
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") < 0;
  // Programmatic Archived view still shows c2 and hides c1.
  coder_page_sb_set_view(s, CP_SB_VIEW_ARCHIVED);
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ARCHIVED;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c1") < 0;
  // Switch back to Active view.
  coder_page_sb_set_view(s, CP_SB_VIEW_ACTIVE);
  #assert coder_page_sb_view(s) == CP_SB_VIEW_ACTIVE;
  // Undo toast: show, click Undo -> dispatches CP_ASK_SIDEBAR + CP_SB_OP_UNDO.
  s[0].clock = 10.0f32;
  coder_page_sb_undo_show(s, "Archived \"Archived thread\"", CP_SB_UNDO_ARCHIVE, 5.0f32);
  #assert cp_sb_test_frame(s, f[..], 10.0f32);
  #assert surface_find(s[0].surface[..], "coder.sb.undo.btn") >= 0;
  #assert cp_sb_click_id(s, "coder.sb.undo.btn", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_UNDO;
  #assert !s[0].sb[0].undo[0].active;
  // Undo toast auto-dismisses when clock advances past duration.
  s[0].clock = 20.0f32;
  coder_page_sb_undo_show(s, "Deleted chat", CP_SB_UNDO_DELETE, 4.0f32);
  #assert cp_sb_undo_wake(s) > 3.9f32;
  s[0].clock = 24.5f32;
  #assert cp_sb_test_frame(s, f[..], 24.5f32);
  #assert !s[0].sb[0].undo[0].active;
  #assert surface_find(s[0].surface[..], "coder.sb.undo.btn") < 0;
}

#test "snoozed chats hide until wake time and resurface automatically" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_sb_now_ms(s, 1000000);
  coder_page_chats(s, "c1\tAwake chat\t0\t0\t0\t0\t0\t0\t/tmp/proj\nc2\tSnoozed chat\t0\t0\t0\t0\t0\t2000000\t/tmp/proj\n");
  #assert cp_sb_snoozed_count(s) == 1;
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert cp_sb_test_frame(s, f[..], 0.01f32);
  #assert surface_find(s[0].surface[..], "chat.c1") >= 0;
  #assert surface_find(s[0].surface[..], "chat.c2") < 0;
  // Advance wall-clock past snoozed_until_ms -> c2 resurfaces automatically!
  coder_page_sb_now_ms(s, 2000000);
  #assert cp_sb_snoozed_count(s) == 0;
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert surface_find(s[0].surface[..], "chat.c2") >= 0;
}

#test "multi-select with Cmd-click and Shift-click supports bulk archive, restore, pin, and delete" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32; s[0].ready = true;
  coder_page_chats(s, "c1\tFirst\t0\t0\t0\t0\t0\t0\t/tmp/proj\nc2\tSecond\t0\t0\t0\t0\t0\t0\t/tmp/proj\nc3\tThird\t0\t0\t0\t0\t0\t0\t/tmp/proj\nc4\tFourth\t0\t0\t0\t0\t0\t0\t/tmp/proj\n");
  f: [1] UiFrame;
  #assert cp_sb_test_frame(s, f[..], 0.0f32);
  #assert cp_sb_click_id(s, "coder.proj.0", 0);
  #assert cp_sb_test_frame(s, f[..], 0.01f32);
  // Cmd-click (mods=8) on c1 selects c1 without opening it.
  #assert cp_sb_click_id(s, "chat.c1", 8);
  #assert coder_page_sb_sel_count(s) == 1;
  #assert coder_page_action(s) == CP_ASK_NONE;
  // Shift-click (mods=1) on c3 selects contiguous range c1, c2, c3.
  #assert cp_sb_test_frame(s, f[..], 0.02f32);
  #assert cp_sb_click_id(s, "chat.c3", 1);
  #assert coder_page_sb_sel_count(s) == 3;
  // Cmd-click c2 toggles it off -> c1 and c3 remain selected.
  #assert cp_sb_test_frame(s, f[..], 0.04f32);
  #assert cp_sb_click_id(s, "chat.c2", 8);
  #assert coder_page_sb_sel_count(s) == 2;
  // Bulk action bar appears; click Archive -> captures "c1\nc3", clears selection, asks host.
  #assert cp_sb_test_frame(s, f[..], 0.06f32);
  #assert surface_find(s[0].surface[..], "coder.sb.bulk.archive") >= 0;
  #assert cp_sb_click_id(s, "coder.sb.bulk.archive", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_BULK_ARCHIVE;
  #assert coder_page_sb_sel_count(s) == 0;
  ids: [256] u8;
  idn := coder_page_sb_selected_ids(s, ids[..]);
  #assert cast(string) ids[0..<idn] == "c1\nc3";
  // Select c2 and c4, click Delete -> captures "c2\nc4" and dispatches CP_SB_OP_BULK_DELETE.
  #assert cp_sb_test_frame(s, f[..], 0.08f32);
  #assert cp_sb_click_id(s, "chat.c2", 8);
  #assert cp_sb_click_id(s, "chat.c4", 8);
  #assert cp_sb_test_frame(s, f[..], 0.10f32);
  #assert cp_sb_click_id(s, "coder.sb.bulk.delete", 0);
  #assert coder_page_action(s) == CP_ASK_SIDEBAR;
  #assert coder_page_sb_op(s) == CP_SB_OP_BULK_DELETE;
  idn = coder_page_sb_selected_ids(s, ids[..]);
  #assert cast(string) ids[0..<idn] == "c2\nc4";
  // Select c1, click Clear -> clears selection with no host ask.
  #assert cp_sb_test_frame(s, f[..], 0.12f32);
  #assert cp_sb_click_id(s, "chat.c1", 8);
  #assert cp_sb_test_frame(s, f[..], 0.14f32);
  #assert cp_sb_click_id(s, "coder.sb.bulk.clear", 0);
  #assert coder_page_sb_sel_count(s) == 0 && coder_page_action(s) == CP_ASK_NONE;
}
