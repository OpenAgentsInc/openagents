// Checks for the iOS Simulator in the pane (simpane.coax, GitHub #13811): the page says hello
// and asks for the list when the host reaches the helper; a booted device shows its screen
// aspect-fit (portrait and landscape, narrow and wide) and asks for stills; an overlay covers
// it; an agent's ask opens the pane with the card and each answer writes its line; Stop revokes;
// the pane's precedence with a file and a sub-agent; the notices. The helper's lines are ones
// proto/coder/sim-host-lines-v1.json holds, or shaped as they are.
#load "../parts.coax";
#load "checks-kit.coax";

cp_sim_test_find :: (s: [] CoderPage, id: string) -> int { return surface_find(s[0].surface[..], id); }
cp_sim_test_press :: (s: [] CoderPage, id: string) -> bool { r := cp_sim_test_find(s, id); return r >= 0 && cp_press(s, r); }
cp_sim_test_page :: (s: [] CoderPage, f: [] UiFrame) {
  cp_init(s); s[0].d = 1; test_atlas(s[0].atlas[..]);
  coder_page_env(s, true, false);
  coder_page_sim_setup(s, "/h/.openagents/sim/stills", "/w/app/.openagents/shots");
  #assert cp_test_draw_side(s, f);
}
// What the page queued for the helper, as text (and taken off the queue).
cp_sim_test_out :: (s: [] CoderPage, out: [] u8) -> string { n := coder_page_sim_out(s, out); return ifx n > 0 then cast(string) out[0..<n] else ""; }
CP_SIM_TEST_LIST :: "{\"id\":3,\"ok\":true,\"devices\":[{\"udid\":\"U1\",\"name\":\"iPhone 17\",\"runtime\":\"iOS 26.5\",\"state\":\"booted\",\"booted_by_us\":false},{\"udid\":\"U2\",\"name\":\"iPad Air\",\"runtime\":\"iOS 26.5\",\"state\":\"shutdown\",\"booted_by_us\":false}]}";
// connected, hello answered, the list in
cp_sim_test_up :: (s: [] CoderPage) {
  out: [4096] u8;
  coder_page_sim_show(s, true);
  coder_page_sim_connected(s, true, "");
  q := cp_sim_test_out(s, out[..]);
  #assert q == "{\"id\":1,\"op\":\"hello\",\"client\":\"app\",\"version\":1}\n{\"id\":2,\"op\":\"subscribe\"}\n{\"id\":3,\"op\":\"list\"}\n";
  #assert coder_page_sim_line(s, "{\"id\":1,\"ok\":true,\"version\":1,\"helper_pid\":7,\"capabilities\":{\"display\":\"stills\",\"input\":\"none\",\"describe\":false},\"xcode\":\"26.6\"}");
  #assert coder_page_sim_line(s, "{\"id\":2,\"ok\":true}");
  #assert coder_page_sim_line(s, CP_SIM_TEST_LIST);
}

#test "the host reaches the helper: hello, subscribe, list; a booted device shows and asks for stills" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  #assert coder_page_action(s) == CP_ASK_NONE;
  cp_sim_test_up(s);
  #assert coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_OPENED && coder_page_sim_open(s);
  #assert s[0].sim[0].state == CP_SIM_BOOTED && cp_sim_udid(s) == "U1";
  out: [4096] u8;
  // booted: a still and the appearance are asked for
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":4,\"op\":\"screenshot\",\"device\":\"U1\",\"out\":\"/h/.openagents/sim/stills/still-0.png\"}\n{\"id\":5,\"op\":\"appearance\",\"device\":\"U1\"}\n";
  // one still at a time
  coder_page_sim_tick(s); #assert cp_sim_test_out(s, out[..]) == "";
  #assert coder_page_sim_line(s, "{\"id\":4,\"ok\":true,\"path\":\"/h/.openagents/sim/stills/still-0.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":34754}");
  #assert coder_page_sim_line(s, "{\"id\":5,\"ok\":true,\"appearance\":\"dark\"}") && s[0].sim[0].dark;
  pb: [256] u8; #assert coder_page_sim_still(s, pb[..]) == 1 && cast(string) pb[0..<cp_find(cast(string) pb[..], "\0")] == "/h/.openagents/sim/stills/still-0.png";
  // stills (no framebuffer): one each fourth tick of the host's fifteen a second
  coder_page_sim_tick(s); #assert cp_sim_test_out(s, out[..]) == "";
  coder_page_sim_tick(s); #assert cp_sim_test_out(s, out[..]) == "";
  coder_page_sim_tick(s); #assert cp_find(cp_sim_test_out(s, out[..]), "still-1.png") >= 0;
  // the screen: aspect-fit, on screen, the tab names the device
  #assert cp_test_draw_side(s, f[..]) && s[0].pane_w > 0;
  r: [6] f32; #assert coder_page_sim_rect(s, r[..]) && r[4] == 0 && r[5] > 0 && cp_abs(r[5] / r[2] - 17.0f32 / 402.0f32) < 0.001f32;
  #assert r[2] > 0 && r[3] > 0 && cp_abs(r[2] / r[3] - 402.0f32 / 874.0f32) < 0.001f32;
  #assert r[0] >= s[0].pane_x && r[0] + r[2] <= s[0].pane_x + s[0].pane_w + 0.5f32;
  #assert cp_sim_test_find(s, "coder.sim.screen") >= 0 && cp_sim_test_find(s, "coder.sim.shot") >= 0 && cp_sim_test_find(s, "coder.sim.home") < 0;
  // an overlay over the page covers the screen: the host hides its view
  s[0].ov[0].menu[0].open = true; #assert coder_page_sim_rect(s, r[..]) && r[4] == 1; s[0].ov[0].menu[0].open = false;
}

#test "the fit: the device in its frame, portrait and landscape, narrow and wide, centred with room round it" {
  r: [5] f32;
  // 300 wide less the room: 276 for the frame, 402 + 34 device points
  cp_sim_fit(402, 874, 100, 50, 300, 900, r[..]);
  k := 276.0f32 / 436.0f32;
  #assert cp_abs(r[2] / r[3] - 402.0f32 / 874.0f32) < 0.001f32 && cp_abs(r[2] - 402 * k) < 0.01f32 && cp_abs(r[4] - 17 * k) < 0.01f32;
  #assert cp_abs(r[0] - r[4] - 112) < 0.01f32 && r[0] + r[2] + r[4] < 388.01f32 && r[1] - r[4] >= 62;
  cp_sim_fit(874, 402, 100, 50, 300, 900, r[..]);
  #assert cp_abs(r[2] / r[3] - 874.0f32 / 402.0f32) < 0.001f32 && cp_abs(r[2] + 2 * r[4] - 276) < 0.01f32;
  // short and wide: the height decides; the device sits in the middle
  cp_sim_fit(402, 874, 0, 0, 1200, 400, r[..]);
  #assert cp_abs(r[3] + 2 * r[4] - 376) < 0.01f32 && cp_abs(r[0] + r[2] / 2 - 600) < 0.01f32 && cp_abs(r[1] - r[4] - 12) < 0.01f32;
  cp_sim_fit(402, 874, 0, 0, 10, 10, r[..]); #assert r[2] == 0 && r[3] == 0 && r[4] == 0;
}

#test "the header and the toolbar: icon buttons with their tooltips, the zoom between the fit and its least" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s); s[0].sim[0].input = true;
  #assert cp_test_draw_side(s, f[..]);
  for id: [9] string.["coder.sim.pick", "coder.sim.zoom_out", "coder.sim.fit", "coder.sim.zoom_in", "coder.sim.home", "coder.sim.rotate", "coder.sim.shot", "coder.sim.record", "coder.sim.more"] { #assert cp_sim_test_find(s, id) >= 0; }
  tb: [1024] u8; t := cast(string) tb[0..<coder_page_sim_tips(s, tb[..])];
  #assert cp_find(t, "\tChoose a Device\n") >= 0 && cp_find(t, "\tZoom Out\n") >= 0 && cp_find(t, "\tHome\n") >= 0 && cp_find(t, "\tRotate\n") >= 0 && cp_find(t, "\tScreenshot\n") >= 0 && cp_find(t, "\tRecord\n") >= 0 && cp_find(t, "\tMore\n") >= 0;
  #assert cp_sim_test_find(s, "coder.sim.tab.0") < 0;   // one device booted: no tabs
  r: [6] f32; #assert coder_page_sim_rect(s, r[..]); w0 := r[2];
  // fit is where it starts: zoom in and fit do nothing; zoom out to its least, then back
  #assert cp_sim_test_press(s, "coder.sim.zoom_out") && cp_test_draw_side(s, f[..]) && coder_page_sim_rect(s, r[..]) && cp_abs(r[2] - w0 * 0.8f32) < 0.5f32;
  for i: 0..<8 { _ = cp_sim_press(s, CP_SIM_ZOOM_OUT); }
  #assert cp_abs(cp_sim_zoom(s) - CP_SIM_ZOOM_MIN) < 0.001f32;
  #assert cp_sim_test_press(s, "coder.sim.fit") && cp_test_draw_side(s, f[..]) && coder_page_sim_rect(s, r[..]) && cp_abs(r[2] - w0) < 0.01f32;
  _ = cp_sim_press(s, CP_SIM_ZOOM_IN); #assert cp_sim_zoom(s) == 1;
  s[0].ov[0].menu[0].open = true; #assert coder_page_sim_tips(s, tb[..]) == 0; s[0].ov[0].menu[0].open = false;
}

#test "an agent's ask opens the pane with the card; each answer writes its line" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s); out: [4096] u8; _ = cp_sim_test_out(s, out[..]);
  coder_page_sim_show(s, false); _ = coder_page_action(s); _ = coder_page_sim_op(s);
  #assert !coder_page_sim_open(s);
  #assert coder_page_sim_line(s, "{\"event\":\"ask\",\"op\":\"set_appearance\",\"chat\":\"check-chat\",\"engine\":\"Microcoder\",\"device\":\"U1\",\"name\":\"iPhone 17\"}");
  #assert coder_page_sim_open(s) && cp_sim_shown(s);
  r: [6] f32; #assert cp_test_draw_side(s, f[..]) && !coder_page_sim_rect(s, r[..]);   // the card stands where the screen would
  #assert cp_sim_test_find(s, "coder.sim.ask") >= 0 && cp_sim_test_find(s, "coder.sim.allow") >= 0 && cp_sim_test_find(s, "coder.sim.deny") >= 0;
  _ = cp_sim_test_out(s, out[..]);   // the list it asked for as it opened
  #assert cp_sim_test_press(s, "coder.sim.allow");
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":7,\"op\":\"grant\",\"chat\":\"check-chat\",\"device\":\"U1\",\"scope\":\"chat\"}\n";
  #assert s[0].sim[0].nasks == 0 && s[0].sim[0].agent == CP_SIM_AGENT_ALLOWED;
  // the agent's op: the badge with Stop; Stop revokes the chat
  #assert coder_page_sim_line(s, "{\"event\":\"agent\",\"op\":\"tap\",\"chat\":\"check-chat\",\"engine\":\"Microcoder\",\"device\":\"U1\",\"x\":201,\"y\":640}");
  #assert cp_sim_s(s[0].sim[0].agent_op[..], s[0].sim[0].agent_op_n) == "Tapping (201, 640)";
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_find(s, "coder.sim.badge") >= 0 && cp_sim_word(s) == "Agent";
  #assert cp_sim_test_press(s, "coder.sim.stop") && cp_sim_test_out(s, out[..]) == "{\"id\":8,\"op\":\"revoke\",\"chat\":\"check-chat\"}\n";
  #assert s[0].sim[0].agent == CP_SIM_AGENT_NONE;
  // Allow once and Don't allow
  #assert coder_page_sim_line(s, "{\"event\":\"ask\",\"op\":\"open_url\",\"chat\":\"c2\",\"engine\":\"Claude\",\"device\":\"U1\",\"name\":\"iPhone 17\"}");
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "coder.sim.once") && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"grant\",\"chat\":\"c2\",\"device\":\"U1\",\"scope\":\"once\"") >= 0;
  #assert coder_page_sim_line(s, "{\"event\":\"ask\",\"op\":\"open_url\",\"chat\":\"c3\",\"engine\":\"Claude\",\"device\":\"U1\",\"name\":\"iPhone 17\"}");
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "coder.sim.deny") && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"deny\",\"chat\":\"c3\"") >= 0;
  // Close: an agent's op doesn't open the pane again
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "coder.sim.close.tab") || cp_sim_test_press(s, "coder.sim.close");
  #assert !coder_page_sim_open(s);
  #assert coder_page_sim_line(s, "{\"event\":\"agent\",\"op\":\"tap\",\"chat\":\"c2\",\"engine\":\"Claude\",\"device\":\"U1\",\"x\":1,\"y\":2}") && !coder_page_sim_open(s);
}

#test "the person's controls: boot, screenshot into the working folder, appearance, the device menu" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s); out: [4096] u8; _ = cp_sim_test_out(s, out[..]);
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "coder.sim.shot");
  q := cp_sim_test_out(s, out[..]);
  #assert cp_find(q, "\"op\":\"screenshot\",\"device\":\"U1\",\"out\":\"/w/app/.openagents/shots/simulator-") >= 0;
  id := s[0].sim[0].next_id; lb: [256] u8; ln := el_put(lb[..], 0, "{\"id\":"); ln = el_put_i(lb[..], ln, id); ln = el_put(lb[..], ln, ",\"ok\":true,\"path\":\"/w/app/.openagents/shots/s.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":9}");
  _ = coder_page_action(s); _ = coder_page_sim_op(s);
  #assert coder_page_sim_line(s, cast(string) lb[0..<ln]) && coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_SAVED;
  sv: [256] u8; #assert cast(string) sv[0..<coder_page_sim_saved(s, sv[..])] == "/w/app/.openagents/shots/s.png";
  // More: Shut Down and the look (Lock too once the helper has input), in a menu the host shows
  #assert cp_sim_test_press(s, "coder.sim.more") && coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_MENU;
  mm: [256] u8; #assert cast(string) mm[0..<coder_page_sim_menu(s, mm[..])] == "Shut Down\t\t0\nDark Appearance\t\t0\n";
  #assert coder_page_sim_pick(s, 1) && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"set_appearance\",\"device\":\"U1\",\"state\":\"dark\"") >= 0;
  #assert cp_sim_test_press(s, "coder.sim.more") && cast(string) mm[0..<coder_page_sim_menu(s, mm[..])] == "Shut Down\t\t0\nLight Appearance\t\t0\n" && !coder_page_sim_pick(s, 5);
  s[0].sim[0].input = true;
  #assert cp_sim_test_press(s, "coder.sim.more") && cp_find(cast(string) mm[0..<coder_page_sim_menu(s, mm[..])], "Lock\t\t0\n") >= 0 && coder_page_sim_pick(s, 2);
  #assert cp_find(cp_sim_test_out(s, out[..]), "\"name\":\"LOCK\"") >= 0;
  s[0].sim[0].input = false;
  // the menu: the host shows the rows; picking the shut-down iPad shows Boot
  #assert cp_sim_test_press(s, "coder.sim.pick") && coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_MENU;
  mb: [512] u8; #assert cast(string) mb[0..<coder_page_sim_menu(s, mb[..])] == "iPhone 17 · iOS 26.5\tBooted\t1\niPad Air · iOS 26.5\tShut down\t0\n";
  #assert coder_page_sim_pick(s, 1) && s[0].sim[0].state == CP_SIM_SHUTDOWN;
  r: [6] f32; #assert cp_test_draw_side(s, f[..]) && !coder_page_sim_rect(s, r[..]) && cp_sim_test_find(s, "coder.sim.notice") >= 0;
  #assert cp_sim_test_press(s, "coder.sim.boot") && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"boot\",\"device\":\"U2\"}\n") >= 0 && s[0].sim[0].state == CP_SIM_BOOTING;
  #assert cp_test_draw_side(s, f[..]) && cp_sim_word(s) == "Booting";
  bt: [256] u8; bn := el_put(bt[..], 0, "{\"id\":"); bn = el_put_i(bt[..], bn, s[0].sim[0].next_id); bn = el_put(bt[..], bn, ",\"ok\":false,\"code\":\"timeout\",\"why\":\"the simulator did not finish booting in 180 s\"}");
  #assert coder_page_sim_line(s, cast(string) bt[0..<bn]) && s[0].sim[0].state == CP_SIM_FAILED;
}

#test "precedence: the one brought forward last shows; the notices when there is no screen" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s);
  b: [64] u8; src := "one\n";
  #assert coder_page_file_open(s, "~/a.txt", b[0..<cp_out(b[..], src)], src.count);
  #assert coder_page_file_shown(s) && !cp_sim_shown(s);
  coder_page_sim_show(s, true); #assert cp_sim_shown(s) && !coder_page_file_shown(s);
  #assert coder_page_file_front(s) && coder_page_file_shown(s) && !cp_sim_shown(s);
  coder_page_file_close(s); #assert cp_sim_shown(s);
  // the helper down; no Xcode
  coder_page_sim_connected(s, false, "the simulator helper could not be started");
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_find(s, "coder.sim.notice") >= 0 && s[0].sim[0].state == CP_SIM_DOWN;
  coder_page_sim_connected(s, true, ""); out: [4096] u8; _ = cp_sim_test_out(s, out[..]);
  hb: [256] u8; hn := el_put(hb[..], 0, "{\"id\":"); hn = el_put_i(hb[..], hn, s[0].sim[0].pend[0].id); hn = el_put(hb[..], hn, ",\"ok\":true,\"version\":1,\"helper_pid\":7,\"capabilities\":{\"display\":\"stills\",\"input\":\"none\",\"describe\":false}}");
  #assert coder_page_sim_line(s, cast(string) hb[0..<hn]) && s[0].sim[0].state == CP_SIM_NO_XCODE;
  #assert !coder_page_sim_line(s, "not json");
}
cp_abs :: (v: f32) -> f32 { return ifx v < 0 then -v else v; }

#test "frames: a still each tick, naming the gen it has; an unchanged screen keeps the still" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  out: [4096] u8;
  coder_page_sim_show(s, true); coder_page_sim_connected(s, true, ""); _ = cp_sim_test_out(s, out[..]);
  #assert coder_page_sim_line(s, "{\"id\":1,\"ok\":true,\"version\":1,\"helper_pid\":7,\"capabilities\":{\"display\":\"frames\",\"input\":\"indigo\",\"describe\":false},\"xcode\":\"26.6\"}");
  #assert s[0].sim[0].display_live && s[0].sim[0].input;
  #assert coder_page_sim_line(s, CP_SIM_TEST_LIST);
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":4,\"op\":\"screenshot\",\"device\":\"U1\",\"out\":\"/h/.openagents/sim/stills/still-0.png\"}\n{\"id\":5,\"op\":\"appearance\",\"device\":\"U1\"}\n";
  #assert coder_page_sim_line(s, "{\"id\":4,\"ok\":true,\"path\":\"/h/.openagents/sim/stills/still-0.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":34754,\"gen\":91}");
  pb: [256] u8; #assert coder_page_sim_still(s, pb[..]) == 1;
  coder_page_sim_tick(s);
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":6,\"op\":\"screenshot\",\"device\":\"U1\",\"gen\":91,\"out\":\"/h/.openagents/sim/stills/still-1.png\"}\n";
  // unchanged: the same still, and the next asks for the same file
  #assert coder_page_sim_line(s, "{\"id\":6,\"ok\":true,\"gen\":91}");
  #assert coder_page_sim_still(s, pb[..]) == 1 && cast(string) pb[0..<cp_find(cast(string) pb[..], "\0")] == "/h/.openagents/sim/stills/still-0.png";
  coder_page_sim_tick(s); #assert cp_find(cp_sim_test_out(s, out[..]), "\"gen\":91,\"out\":\"/h/.openagents/sim/stills/still-1.png\"") >= 0;
  // changed: the new still and its gen
  #assert coder_page_sim_line(s, "{\"id\":7,\"ok\":true,\"path\":\"/h/.openagents/sim/stills/still-1.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":34000,\"gen\":92}");
  #assert coder_page_sim_still(s, pb[..]) == 2 && s[0].sim[0].frame == 92;
  coder_page_sim_tick(s); #assert cp_find(cp_sim_test_out(s, out[..]), "\"gen\":92,\"out\":\"/h/.openagents/sim/stills/still-0.png\"") >= 0;
}

#test "the person's finger and keys: device points, no reply wanted; nothing without input" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  out: [4096] u8;
  cp_sim_test_up(s); _ = cp_sim_test_out(s, out[..]);
  // "input":"none": the view's mouse goes nowhere
  #assert !coder_page_sim_touch(s, 0, 10.0, 10.0, 201.0, 437.0) && !coder_page_sim_key(s, 0, "a") && cp_sim_test_out(s, out[..]) == "";
  #assert coder_page_sim_line(s, "{\"id\":4,\"ok\":true,\"path\":\"/h/.openagents/sim/stills/still-0.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":34754}");
  s[0].sim[0].input = true;
  // a view half the device's size: (100.5, 200) is the device's (201, 400)
  #assert coder_page_sim_touch(s, 0, 100.5, 200.0, 201.0, 437.0);
  #assert coder_page_sim_touch(s, 1, 0.0, 0.0, 201.0, 437.0) && coder_page_sim_touch(s, 2, 201.0, 437.0, 201.0, 437.0);
  #assert !coder_page_sim_touch(s, 3, 1.0, 1.0, 201.0, 437.0);
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"down\",\"pointer\":0,\"x\":201,\"y\":400}\n{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"move\",\"pointer\":0,\"x\":0,\"y\":0}\n{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"up\",\"pointer\":0,\"x\":402,\"y\":874}\n";
  // keys: a named one by its Mac code, a character as text, anything else not taken
  #assert coder_page_sim_key(s, 36, "\r") && coder_page_sim_key(s, 0, "a") && !coder_page_sim_key(s, 0, "");
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":0,\"op\":\"press_key\",\"device\":\"U1\",\"key\":\"return\"}\n{\"id\":0,\"op\":\"text\",\"device\":\"U1\",\"text\":\"a\"}\n";
  // shut down: nothing goes
  s[0].sim[0].state = CP_SIM_SHUTDOWN;
  #assert !coder_page_sim_touch(s, 0, 1.0, 1.0, 201.0, 437.0) && !coder_page_sim_key(s, 36, "");
}

#test "a message sent while the pane is open and its helper there may drive the device; otherwise not" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  out: [8192] u8;
  #assert coder_page_set_text(s, "tap Settings") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w/app", out[..]);
  #assert n > 0 && cp_find(cast(string) out[0..<n], "\"device\":true") < 0;
  coder_page_sim_show(s, true);
  n = coder_page_task(s, "s", "/w/app", out[..]);
  #assert n > 0 && cp_find(cast(string) out[0..<n], "\"device\":true") < 0;
  coder_page_sim_connected(s, true, "");
  n = coder_page_task(s, "s", "/w/app", out[..]);
  #assert n > 0 && cp_find(cast(string) out[0..<n], ",\"device\":true}") > 0;
  coder_page_sim_show(s, false);
  n = coder_page_task(s, "s", "/w/app", out[..]);
  #assert n > 0 && cp_find(cast(string) out[0..<n], "\"device\":true") < 0;
}

#test "an oasim command's row, and its device line, bring the pane to the front when pressed; a failed one opens" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  #assert coder_page_set_text(s, "tap Settings") && coder_page_submit(s);
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"oasim tap 340 420\",\"exit\":0,\"timed_out\":false,\"output\":\"{\\\"id\\\":2,\\\"ok\\\":true}\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"device\",\"op\":\"tap\",\"ok\":true}") == MWW_DEVICE;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"oasim tap 1 2\",\"exit\":1,\"timed_out\":false,\"output\":\"{\\\"ok\\\":false,\\\"code\\\":\\\"no_grant\\\"}\"}") == MWW_COMMAND;
  #assert coder_page_line(s, "{\"kind\":\"command\",\"command\":\"ls\",\"exit\":0,\"timed_out\":false,\"output\":\"a\"}") == MWW_COMMAND;
  q := s[0].turns[0].head - 1;
  #assert cp_row_act(s, q, 5) == CP_SIM_ROW && cp_row_act(s, s[0].calls[q].next - 1, 5) == 5;
  #assert cp_row_act(s, s[0].calls[s[0].calls[q].next - 1].next - 1, 5) == 5;
  #assert !s[0].sim[0].open && cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "t0.x0") && s[0].sim[0].open && s[0].sim[0].front;
  // closed by the person, a press opens it again
  s[0].sim[0].closed_by_person = true; cp_sim_hide(s);
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "t0.x0") && s[0].sim[0].open && !s[0].sim[0].closed_by_person;
}

#test "the person's Option-drag pinches, a scroll drags, Simulator.app's Command shortcuts; an accent types" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  out: [4096] u8;
  cp_sim_test_up(s); _ = cp_sim_test_out(s, out[..]);
  #assert coder_page_sim_line(s, "{\"id\":4,\"ok\":true,\"path\":\"/h/.openagents/sim/stills/still-0.png\",\"points\":{\"w\":402,\"h\":874},\"bytes\":34754}");
  #assert !coder_page_sim_pinch(s, 0, 50.0, 100.0, 201.0, 437.0) && !coder_page_sim_scroll(s, 0, 1.0, 1.0, 0.0, 0.0, 201.0, 437.0) && !coder_page_sim_command(s, 37, "l", false);
  s[0].sim[0].input = true;
  // the pointer at (100, 200) device points, its mirror at (302, 674)
  #assert coder_page_sim_pinch(s, 0, 50.0, 100.0, 201.0, 437.0);
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"down\",\"pointer\":0,\"x\":100,\"y\":200,\"x2\":302,\"y2\":674}\n";
  #assert !coder_page_sim_pinch(s, 3, 50.0, 100.0, 201.0, 437.0);
  // a scroll: down where it began, moved by its deltas (kept on the view), up
  #assert !coder_page_sim_scroll(s, 1, 0.0, 0.0, 5.0, 5.0, 201.0, 437.0);
  #assert coder_page_sim_scroll(s, 0, 100.0, 200.0, 0.0, 0.0, 201.0, 437.0) && coder_page_sim_scroll(s, 1, 0.0, 0.0, 0.5, -300.0, 201.0, 437.0) && coder_page_sim_scroll(s, 2, 0.0, 0.0, 0.0, 0.0, 201.0, 437.0);
  #assert cp_sim_test_out(s, out[..]) == "{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"down\",\"pointer\":0,\"x\":200,\"y\":400}\n{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"move\",\"pointer\":0,\"x\":201,\"y\":0}\n{\"id\":0,\"op\":\"touch\",\"device\":\"U1\",\"phase\":\"up\",\"pointer\":0,\"x\":201,\"y\":0}\n";
  #assert !coder_page_sim_scroll(s, 1, 0.0, 0.0, 1.0, 1.0, 201.0, 437.0);
  // shortcuts: home, lock, turn each way, the software keyboard on and off; others stay the app's
  #assert coder_page_sim_command(s, 4, "h", true) && coder_page_sim_command(s, 37, "l", false) && coder_page_sim_command(s, 123, "", false) && coder_page_sim_command(s, 124, "", false);
  #assert coder_page_sim_command(s, 40, "k", false) && s[0].sim[0].soft_kbd && coder_page_sim_command(s, 40, "k", false) && !s[0].sim[0].soft_kbd;
  #assert !coder_page_sim_command(s, 4, "h", false) && !coder_page_sim_command(s, 9, "v", false) && !coder_page_sim_command(s, 37, "l", true);
  q := cp_sim_test_out(s, out[..]);
  #assert cp_find(q, "\"op\":\"button\",\"device\":\"U1\",\"name\":\"HOME\"") >= 0 && cp_find(q, "\"name\":\"LOCK\"") >= 0;
  #assert cp_find(q, "\"op\":\"rotate\",\"device\":\"U1\",\"direction\":\"left\"") >= 0 && cp_find(q, "\"direction\":\"right\"") >= 0;
  #assert cp_find(q, "\"op\":\"set_keyboard\",\"device\":\"U1\",\"state\":\"show\"") >= 0 && cp_find(q, "\"state\":\"hide\"") >= 0;
  // Command-S: a screenshot into the working folder
  #assert coder_page_sim_command(s, 1, "s", false) && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"screenshot\"") >= 0;
  // a key with an accent goes as text (the helper pastes it)
  #assert coder_page_sim_key(s, 0, "é") && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"text\"") >= 0;
}

#test "Record: start into the working folder, the button turns to Stop, the stop saves; two booted devices get tabs" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s); out: [4096] u8; _ = cp_sim_test_out(s, out[..]);
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_press(s, "coder.sim.record") && s[0].sim[0].recording;
  #assert cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"record_start\",\"device\":\"U1\",\"out\":\"/w/app/.openagents/shots/simulator-") >= 0;
  id := s[0].sim[0].next_id; lb: [256] u8; ln := el_put(lb[..], 0, "{\"id\":"); ln = el_put_i(lb[..], ln, id); ln = el_put(lb[..], ln, ",\"ok\":true}");
  #assert coder_page_sim_line(s, cast(string) lb[0..<ln]) && s[0].sim[0].recording;
  tb: [1024] u8; #assert cp_test_draw_side(s, f[..]) && cp_find(cast(string) tb[0..<coder_page_sim_tips(s, tb[..])], "\tStop Recording\n") >= 0;
  _ = coder_page_action(s); _ = coder_page_sim_op(s);
  #assert cp_sim_test_press(s, "coder.sim.record") && cp_find(cp_sim_test_out(s, out[..]), "\"op\":\"record_stop\",\"device\":\"U1\"") >= 0;
  id = s[0].sim[0].next_id; ln = el_put(lb[..], 0, "{\"id\":"); ln = el_put_i(lb[..], ln, id); ln = el_put(lb[..], ln, ",\"ok\":true,\"path\":\"/w/app/.openagents/shots/r.mp4\"}");
  #assert coder_page_sim_line(s, cast(string) lb[0..<ln]) && !s[0].sim[0].recording && coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_SAVED;
  sv: [256] u8; #assert cast(string) sv[0..<coder_page_sim_saved(s, sv[..])] == "/w/app/.openagents/shots/r.mp4";
  // a second device boots: a tab each; the other's tab moves the pane to it
  s[0].sim[0].devices[1].state = CP_SIM_BOOTED;   // as the next list says
  #assert cp_test_draw_side(s, f[..]) && cp_sim_test_find(s, "coder.sim.tab.0") >= 0 && cp_sim_test_find(s, "coder.sim.tab.1") >= 0;
  #assert !cp_sim_test_press(s, "coder.sim.tab.0") && cp_sim_udid(s) == "U1";
  #assert cp_sim_test_press(s, "coder.sim.tab.1") && cp_sim_udid(s) == "U2";
}

#test "programmatic attach event opens the pane (even after manual close) and selects the requested device" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); f: [1] UiFrame; cp_sim_test_page(s, f[..]);
  cp_sim_test_up(s); out: [4096] u8; _ = cp_sim_test_out(s, out[..]);
  // Close manually (sets closed_by_person = true)
  #assert cp_test_draw_side(s, f[..]);
  _ = cp_sim_press(s, CP_SIM_CLOSE);
  _ = coder_page_action(s); _ = coder_page_sim_op(s);
  #assert !coder_page_sim_open(s) && s[0].sim[0].closed_by_person;
  // attach opens the pane, clears closed_by_person, selects U2, and asks the host to start
  #assert coder_page_sim_line(s, "{\"event\":\"attach\",\"chat\":\"agent-1\",\"engine\":\"OpenAgents\",\"device\":\"U2\"}");
  #assert coder_page_sim_open(s) && cp_sim_shown(s) && !s[0].sim[0].closed_by_person;
  #assert coder_page_action(s) == CP_ASK_SIM && coder_page_sim_op(s) == CP_SIM_OP_OPENED;
  #assert cp_sim_udid(s) == "U2";
  // attach naming a newly-created device U3 before list arrives picks U3 once list returns
  _ = cp_sim_test_out(s, out[..]);
  #assert coder_page_sim_line(s, "{\"event\":\"attach\",\"chat\":\"agent-1\",\"engine\":\"OpenAgents\",\"device\":\"U3\"}");
  list_id := s[0].sim[0].next_id;
  lb: [512] u8; ln := el_put(lb[..], 0, "{\"id\":"); ln = el_put_i(lb[..], ln, list_id);
  ln = el_put(lb[..], ln, ",\"ok\":true,\"devices\":[{\"udid\":\"U1\",\"name\":\"iPhone 17\",\"runtime\":\"iOS 26.5\",\"state\":\"booted\",\"booted_by_us\":false},{\"udid\":\"U3\",\"name\":\"New Phone\",\"runtime\":\"iOS 26.5\",\"state\":\"booted\",\"booted_by_us\":true}]}");
  #assert coder_page_sim_line(s, cast(string) lb[0..<ln]);
  #assert cp_sim_udid(s) == "U3" && s[0].sim[0].want_udid_n == 0;
}
