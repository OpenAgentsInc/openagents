// Checks for the live agent to-do checklist (todos.coax).
#load "../parts.coax";
#load "checks-kit.coax";

#test "todos: MWW_TODOS updates the checklist, draws the tray, collapses and resets on new chat" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); f: [1] UiFrame;
  #assert coder_page_set_text(s, "build feature") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_todo_count(s) == 0;
  line := "{\"kind\":\"todos\",\"todos\":[{\"id\":\"1\",\"content\":\"Inspect schema\",\"status\":\"completed\"},{\"id\":\"2\",\"content\":\"Wire UI\",\"status\":\"in_progress\"},{\"id\":\"3\",\"content\":\"Run tests\",\"status\":\"pending\"}]}";
  #assert coder_page_line(s, line) == MWW_TODOS;
  #assert coder_page_todo_count(s) == 3 && coder_page_todo_done_count(s) == 1;
  #assert coder_page_todo_status(s, 0) == CP_TODO_DONE && coder_page_todo_status(s, 1) == CP_TODO_ACTIVE && coder_page_todo_status(s, 2) == CP_TODO_PENDING;
  buf: [128] u8;
  n := coder_page_todo_content(s, 1, buf[..]);
  #assert cast(string) buf[0..<n] == "Wire UI";
  sf := s[0].surface[..];
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]);
  #assert surface_find(sf, "coder.todos") >= 0 && surface_find(sf, "coder.todos.toggle") >= 0;
  #assert surface_find(sf, "coder.todos.0") >= 0 && surface_find(sf, "coder.todos.1") >= 0 && surface_find(sf, "coder.todos.2") >= 0;
  h_open := s[0].todos[0].tray_h;
  #assert h_open > 0;
  // Collapse the tray
  #assert cp_press(s, surface_find(sf, "coder.todos.toggle")) && s[0].todos[0].collapsed;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]);
  #assert surface_find(sf, "coder.todos.0") < 0 && s[0].todos[0].tray_h > 0 && s[0].todos[0].tray_h < h_open;
  // Empty todos clears the tray
  #assert coder_page_line(s, "{\"kind\":\"todos\",\"todos\":[]}") == MWW_TODOS;
  #assert coder_page_todo_count(s) == 0;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && surface_find(sf, "coder.todos") < 0 && s[0].todos[0].tray_h == 0;
}

#test "todos: MWW_ENDED (finished, stopped) and coder_page_failed clear the todos tray" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); f: [1] UiFrame;
  sf := s[0].surface[..];
  todos_line := "{\"kind\":\"todos\",\"todos\":[{\"id\":\"1\",\"content\":\"Step one\",\"status\":\"in_progress\"},{\"id\":\"2\",\"content\":\"Step two\",\"status\":\"pending\"}]}";
  // 1. MWW_ENDED (finished)
  #assert coder_page_set_text(s, "first") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, todos_line) == MWW_TODOS && s[0].todos[0].n == 2;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h > 0;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Done.\"}") == MWW_ENDED;
  #assert s[0].todos[0].n == 0;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h == 0 && surface_find(sf, "coder.todos") < 0;
  // 2. MWW_ENDED (stopped)
  #assert coder_page_set_text(s, "second") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, todos_line) == MWW_TODOS && s[0].todos[0].n == 2;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h > 0;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\",\"text\":\"\"}") == MWW_ENDED;
  #assert s[0].todos[0].n == 0;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h == 0 && surface_find(sf, "coder.todos") < 0;
  // 3. coder_page_failed
  #assert coder_page_set_text(s, "third") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, todos_line) == MWW_TODOS && s[0].todos[0].n == 2;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h > 0;
  coder_page_failed(s, "worker exited");
  #assert s[0].todos[0].n == 0;
  #assert cp_test_draw(s, f[..]) && cp_test_draw(s, f[..]) && s[0].todos[0].tray_h == 0 && surface_find(sf, "coder.todos") < 0;
}

#test "todos: renders in the right sidebar at the top, with any sub-agent transcript underneath" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]); cp_init(s); f: [1] UiFrame;
  sf := s[0].surface[..];
  #assert coder_page_set_text(s, "ship sidebar") && coder_page_submit(s) && coder_page_action(s) == CP_ASK_SEND;
  #assert coder_page_line(s, "{\"kind\":\"todos\",\"todos\":[{\"id\":\"1\",\"content\":\"Move tasks\",\"status\":\"in_progress\"},{\"id\":\"2\",\"content\":\"Verify layout\",\"status\":\"pending\"}]}") == MWW_TODOS;
  #assert cp_test_settle(s, f[..], 1440.0f32, 900.0f32) > 0;
  #assert s[0].pane_w > 0 && s[0].pane_x > 0;
  tr: [8] f32;
  ti := surface_find(sf, "coder.todos");
  #assert ti >= 0 && surface_access_row(sf, ti, 1, tr[..]) && tr[0] >= s[0].pane_x;
  // Open a sub-agent transcript alongside todos: both share the single right sidebar, todos above the transcript
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"Check files\"}]}") == MWW_DELEGATE;
  #assert s[0].pane_open;
  #assert cp_test_draw_wide(s, f[..]) && cp_test_draw_wide(s, f[..]);
  ti2 := surface_find(sf, "coder.todos");
  ui := surface_find(sf, "p0.0.u");
  tr2: [8] f32; ur: [8] f32;
  #assert ti2 >= 0 && ui >= 0 && surface_access_row(sf, ti2, 1, tr2[..]) && surface_access_row(sf, ui, 1, ur[..]);
  #assert tr2[0] >= s[0].pane_x && ur[0] >= s[0].pane_x;
  #assert tr2[1] + tr2[3] <= ur[1];
}
