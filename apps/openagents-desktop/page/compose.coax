// Coder Desktop page: Zeron's elevation. Shadows are the skin's tokens (components/skin/skin.coax
// UiShadows) drawn with the shared analytic shadow; a frosted surface (the models' menu) blurs what
// is behind it through composition-v1 (coax/native/gpu-composition.coax, prim_backdrop), which the
// Mac host draws when the page hands it a plan (host.c coder_page_plan). A frame with no backdrop,
// or one the planner refuses (a window past 4096 device pixels, the resource budget), draws flat
// as before, and the surface falls back to its solid fill. So does every frosted surface when the Mac
// asks for reduced transparency: the host then says there is no frost (coder_page_frost, host.c
// cd_on_frame). Pictures still compose then (an attachment's thumbnail, a command's OA-SHOW card),
// since reduced transparency asks for no blur, not for no pictures. A frame the planner can't take
// (a window past 4096 device pixels, a plan the GPU refused, one past the planner's budget) draws
// its pictures flat where the host can (coder_page_flat_pictures, the Mac's): GP_IMAGE quads in the
// flat vertices (gpu_draw_with) the host draws through composition-v1's shader with each picture
// bound. Elsewhere, or once the GPU refused such a frame too, its cards show their icon.
#load "../../../coax/native/gpu-composition.coax";

CP_BLUR_DEVICE :: 31.5;       // the planner's bounded kernel: at most 32 device pixels (sigma a third of it)

CP_IMAGES :: 16;              // matches UI_MAX_IMAGES in ui-host.h (slots 0..15 -> source 64..79)
CP_IMG_PATH :: 512;
CP_IMG_EMPTY :: 0;
CP_IMG_PENDING :: 1;
CP_IMG_READY :: 2;
CP_IMG_FAILED :: 3;

CpCompose :: struct {
  plan: [1] UcPlan;
  list: [CP_UNDER + CP_OVER + 2] Prim;
  images: [CP_IMAGES] UcImage;
  active: [CP_IMAGES] UcImage;
  active_slot: [CP_IMAGES] int;
  active_n: int;
  img_path: [CP_IMAGES][CP_IMG_PATH] u8;
  img_path_n: [CP_IMAGES] int;
  img_state: [CP_IMAGES] int;
  img_next: int;              // next slot to evict when all CP_IMAGES slots are full
  on: bool;                   // the host has composition-v1's shader (coder_page_compose)
  off: bool;                  // the host refused a composed frame: draw flat from now on
  opaque: bool;               // reduced transparency: no frost, but pictures still compose
  used: bool;                 // this frame is the plan's
  flat_pics: bool;            // the host draws pictures in a flat frame (coder_page_flat_pictures)
  flat_off: bool;             // it refused a flat frame with pictures: no pictures flat from now on
  flat_used: bool;            // this flat frame has pictures
  w: f32; h: f32;             // the frame's device pixels
}

// Whether this frame can blur behind a surface: the host draws composition-v1 and the window fits it.
cp_glass :: (s: [] CoderPage) -> bool { return cp_composes(s) && !s[0].cmp_gpu[0].opaque; }
// Whether this frame can be composition-v1's plan at all (frost or not): the pictures' path.
cp_composes :: (s: [] CoderPage) -> bool {
  c := s[0].cmp_gpu[0];
  return c.on && !c.off && uc_extent(cast(int) c.w, cast(int) c.h);
}
// A backdrop's blur radius in the page's units: the bounded kernel's widest.
cp_glass_blur :: (s: [] CoderPage) -> f32 { return ifx s[0].d > 0 then CP_BLUR_DEVICE / s[0].d else 0.0f32; }

cp_has_layer :: (list: [] Prim) -> bool {
  for p: list { if p.kind == PRIM_LAYER { return true; } }
  return false;
}
cp_has_image :: (list: [] Prim) -> bool {
  for p: list { if p.kind == PRIM_IMAGE { return true; } }
  return false;
}
cp_has_ext_texture :: (list: [] Prim) -> bool {
  for p: list { if p.kind == PRIM_EXT_TEXTURE { return true; } }
  return false;
}
cp_needs_compose :: (s: [] CoderPage, under: [] Prim, over: [] Prim) -> bool {
  return cp_glass(s) && cp_has_layer(over) || cp_composes(s) && (cp_has_image(under) || cp_has_image(over) || cp_has_ext_texture(under) || cp_has_ext_texture(over));
}
// Look up a file path in the image slot table, queuing it for the host to decode if not yet seen.
// Returns UcImage.{id = slot + 1, w, h} when ready, or zero UcImage while pending or failed, and
// while this frame can't compose (cp_composes): a flat frame draws no picture, so its card keeps
// its icon instead of an empty frame.
cp_image_request :: (s: [] CoderPage, path: string) -> UcImage {
  img := cp_image_slot(s, path);
  return ifx cp_composes(s) || cp_flat_ok(s) then img else UcImage.{};
}
// Current decode state for path in the image slot table (CP_IMG_EMPTY if not queued).
cp_image_status :: (s: [] CoderPage, path: string) -> int {
  if path.count == 0 || path.count > CP_IMG_PATH { return CP_IMG_EMPTY; }
  c := s[0].cmp_gpu[..];
  for i: 0..<CP_IMAGES {
    if c[0].img_state[i] != CP_IMG_EMPTY && c[0].img_path_n[i] == path.count {
      same := true;
      for j: 0..<path.count { if c[0].img_path[i][j] != path[j] { same = false; break; } }
      if same { return c[0].img_state[i]; }
    }
  }
  return CP_IMG_EMPTY;
}
// Drops any cached decode for path so the next cp_image_request reloads it from disk.
cp_image_invalidate :: (s: [] CoderPage, path: string) {
  if path.count == 0 || path.count > CP_IMG_PATH { return; }
  c := s[0].cmp_gpu[..];
  for i: 0..<CP_IMAGES {
    if c[0].img_state[i] != CP_IMG_EMPTY && c[0].img_path_n[i] == path.count {
      same := true;
      for j: 0..<path.count { if c[0].img_path[i][j] != path[j] { same = false; break; } }
      if same {
        c[0].img_state[i] = CP_IMG_EMPTY;
        c[0].img_path_n[i] = 0;
        c[0].images[i] = UcImage.{};
      }
    }
  }
}
// Whether a flat frame can hold pictures: the host draws them and has not refused one.
cp_flat_ok :: (s: [] CoderPage) -> bool { return s[0].cmp_gpu[0].flat_pics && !s[0].cmp_gpu[0].flat_off; }
// The decoded pictures, packed for the host (active, active_slot: coder_page_image_slot maps an
// index back to its slot), their ids into ids. Returns how many.
cp_pack_images :: (s: [] CoderPage, ids: [] int) -> int {
  c := s[0].cmp_gpu[..];
  na := 0;
  for i: 0..<CP_IMAGES {
    if c[0].img_state[i] == CP_IMG_READY && c[0].images[i].id > 0 && c[0].images[i].w > 0 && c[0].images[i].h > 0 {
      c[0].active[na] = c[0].images[i];
      c[0].active_slot[na] = i;
      ids[na] = c[0].images[i].id;
      na += 1;
    }
  }
  c[0].active_n = na;
  return na;
}
// The pictures a flat frame draws (into ids, for gpu_draw_with): the decoded ones while the host
// draws pictures flat and the lists hold one; none otherwise. Marks the frame as having them.
cp_flat_images :: (s: [] CoderPage, under: [] Prim, over: [] Prim, ids: [] int) -> int {
  s[0].cmp_gpu[0].flat_used = false;
  if !cp_flat_ok(s) || !(cp_has_image(under) || cp_has_image(over)) { return 0; }
  n := cp_pack_images(s, ids);
  s[0].cmp_gpu[0].flat_used = n > 0;
  return n;
}
cp_image_slot :: (s: [] CoderPage, path: string) -> UcImage {
  if path.count == 0 || path.count > CP_IMG_PATH { return UcImage.{}; }
  c := s[0].cmp_gpu[..];
  for i: 0..<CP_IMAGES {
    if c[0].img_state[i] != CP_IMG_EMPTY && c[0].img_path_n[i] == path.count {
      same := true;
      for j: 0..<path.count { if c[0].img_path[i][j] != path[j] { same = false; break; } }
      if same {
        if c[0].img_state[i] == CP_IMG_READY { return c[0].images[i]; }
        return UcImage.{};
      }
    }
  }
  slot := -1;
  for i: 0..<CP_IMAGES { if c[0].img_state[i] == CP_IMG_EMPTY { slot = i; break; } }
  if slot < 0 { slot = c[0].img_next % CP_IMAGES; c[0].img_next += 1; }
  for j: 0..<path.count { c[0].img_path[slot][j] = path[j]; }
  c[0].img_path_n[slot] = path.count;
  c[0].img_state[slot] = CP_IMG_PENDING;
  c[0].images[slot] = UcImage.{};
  return UcImage.{};
}
// The composed frame: the canvas and both lists, culled to the band the flat path draws, planned
// into out. Returns the vertex count, or -1 when the frame draws flat. flat is the flat frame's.
cp_compose :: (s: [] CoderPage, out: [] f32, a: [] Atlas, d: f32, w: f32, h: f32, canvas: Rgba, under: [] Prim, over: [] Prim, flat: int) -> int {
  c := s[0].cmp_gpu[..];
  c[0].used = false;
  if !cp_needs_compose(s, under, over) { return -1; }
  l := c[0].list[..];
  n := prim_fill(l, 0, 0, 0, w, h, 0, canvas);
  y0: f32 = -8; y1 := h + 8;
  for pass: 0..<2 {
    src := ifx pass == 0 then under else over;
    for p: src {
      structural := p.kind == PRIM_CLIP || p.kind == PRIM_FADE || p.kind == PRIM_ALPHA || p.kind == PRIM_LAYER;
      if !structural && (p.y > y1 || p.y + prim_extent(p) < y0) { continue; }
      k := prim_put(l, n, p);
      if k == n { return -1; }
      n = k;
    }
  }
  // pack only ready image slots so uc_lease never sees empty 0x0 entries
  ids: [CP_IMAGES] int;
  na := cp_pack_images(s, ids[..]);
  // charge the planner only for the vertices this frame can need, so the targets fit its budget
  cap := (flat * 2 + 4096) * GP_VERTEX_FLOATS;
  if cap > out.count { cap = out.count; }
  if !uc_build(c[0].plan[..], out[0..<cap], a, l[0..<n], c[0].active[0..<na], cast(int) c[0].w, cast(int) c[0].h, d) { return -1; }
  c[0].used = true;
  return c[0].plan[0].v;
}

// The host: whether it can draw composition-v1 (its shader loaded), and that it refused a composed frame.
coder_page_compose :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].cmp_gpu[0].on = on; } }
// The host: whether surfaces may frost (false under reduced transparency). Pictures compose either way.
coder_page_frost :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].cmp_gpu[0].opaque = !on; } }
// A refused frame: a composed one turns composing off, a flat one with pictures the flat pictures.
coder_page_compose_refused :: (s: [] CoderPage) #export_c #effects(all) {
  if s.count < 1 { return; }
  c := s[0].cmp_gpu[..];
  if c[0].used { c[0].off = true; c[0].used = false; }
  else if c[0].flat_used { c[0].flat_off = true; c[0].flat_used = false; }
}
// The host: whether it draws a flat frame's pictures (GP_IMAGE quads, components/backend/gpu.coax).
coder_page_flat_pictures :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].cmp_gpu[0].flat_pics = on; } }
// Whether the last frame is the plan's (host.c reads cmp_gpu.plan then).
coder_page_composed :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].cmp_gpu[0].used && s[0].cmp_gpu[0].plan[0].ok; }
// If image slot is pending host decode, copies its path into out and returns its length; else 0.
coder_page_image_pending :: (s: [] CoderPage, slot: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || slot < 0 || slot >= CP_IMAGES { return 0; }
  c := s[0].cmp_gpu[..];
  if c[0].img_state[slot] != CP_IMG_PENDING { return 0; }
  n := c[0].img_path_n[slot];
  if n <= 0 || n > out.count { return 0; }
  for j: 0..<n { out[j] = c[0].img_path[slot][j]; }
  return n;
}
// Host reports decode result for image slot: ok && w > 0 && h > 0 marks it ready with id = slot + 1.
coder_page_image_loaded :: (s: [] CoderPage, slot: int, w: int, h: int, ok: bool) #export_c #effects(all) {
  if s.count < 1 || slot < 0 || slot >= CP_IMAGES { return; }
  c := s[0].cmp_gpu[..];
  if ok && w > 0 && h > 0 {
    c[0].img_state[slot] = CP_IMG_READY;
    c[0].images[slot] = UcImage.{id = slot + 1, w = w, h = h};
  } else {
    c[0].img_state[slot] = CP_IMG_FAILED;
    c[0].images[slot] = UcImage.{};
  }
}
// Map a dense composition-v1 image index (source - 64) back to its cache slot, or -1.
coder_page_image_slot :: (s: [] CoderPage, index: int) -> int #export_c #effects(all) {
  if s.count < 1 || index < 0 || index >= s[0].cmp_gpu[0].active_n { return -1; }
  return s[0].cmp_gpu[0].active_slot[index];
}

#test "the glass needs the host's composition shader, a window that fits and no refusal" {
  s: [1] CoderPage;
  s[0].cmp_gpu[0].w = 2400; s[0].cmp_gpu[0].h = 1600;
  #assert !cp_glass(s[..]);
  coder_page_compose(s[..], true); #assert cp_glass(s[..]);
  s[0].cmp_gpu[0].w = 5120; #assert !cp_glass(s[..]);
  s[0].cmp_gpu[0].w = 2400; s[0].cmp_gpu[0].used = true; coder_page_compose_refused(s[..]);
  #assert !cp_glass(s[..]) && !coder_page_composed(s[..]);
  s[0].d = 2; #assert cp_glass_blur(s[..]) * 2 <= 32;
  // reduced transparency: no frost, so solid, until the system says otherwise; pictures still compose
  s[0].cmp_gpu[0].off = false; #assert cp_glass(s[..]);
  coder_page_frost(s[..], false); #assert !cp_glass(s[..]) && cp_composes(s[..]);
  coder_page_frost(s[..], true); #assert cp_glass(s[..]);
  coder_page_compose(s[..], false); #assert !cp_glass(s[..]) && !cp_composes(s[..]);
  coder_page_compose(s[..], true); #assert cp_glass(s[..]);
}

#test "a picture composes under reduced transparency; a frosted layer does not" {
  s: [1] CoderPage;
  s[0].cmp_gpu[0].w = 1200; s[0].cmp_gpu[0].h = 800; coder_page_compose(s[..], true);
  pic: [2] Prim; np := prim_image(pic[..], 0, 1, 0, 0, 10, 10);
  box: [2] Prim; nb := prim_box(box[..], 0, 0, 0, 10, 10, 0, 0, Rgba.{}, Rgba.{});
  lay: [4] Prim; nl := prim_backdrop(lay[..], 0, 0, 0, 10, 10, 0, 4);
  #assert np == 1 && nb == 1 && nl > 0;
  #assert cp_needs_compose(s[..], pic[0..<np], box[0..<0]) && cp_needs_compose(s[..], box[0..<nb], pic[0..<np]) && cp_needs_compose(s[..], box[0..<nb], lay[0..<nl]);
  #assert !cp_needs_compose(s[..], box[0..<nb], box[0..<nb]);
  coder_page_frost(s[..], false);
  #assert cp_needs_compose(s[..], pic[0..<np], box[0..<0]) && cp_needs_compose(s[..], box[0..<nb], pic[0..<np]) && !cp_needs_compose(s[..], box[0..<nb], lay[0..<nl]);
  s[0].cmp_gpu[0].w = 5120;   // past what the planner takes: flat, no picture
  #assert !cp_needs_compose(s[..], pic[0..<np], box[0..<0]);
  // a decoded picture is handed out only to a frame that composes; a flat one gets the icon
  s[0].cmp_gpu[0].w = 1200;
  #assert cp_image_request(s[..], "/p/a.png").id == 0;   // queued for the host
  coder_page_image_loaded(s[..], 0, 64, 32, true);
  #assert cp_image_request(s[..], "/p/a.png").id == 1 && cp_image_request(s[..], "/p/a.png").w == 64;
  s[0].cmp_gpu[0].w = 5120;
  #assert cp_image_request(s[..], "/p/a.png").id == 0 && cp_image_slot(s[..], "/p/a.png").id == 1;
}
