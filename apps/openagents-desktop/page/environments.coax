// Coder Desktop page (../page.coax): Remote SSH environments, Boats, Windows WSL2 backend
// & path translation, Server Exposure (Local-only / LAN / Tailscale), authorized mobile
// devices with revoke, and OS Keep-Awake policy (GitHub #13883).

// Host asks (CP_ASK_* in state.coax; 90..96 are free after filetree 86..89).
CP_ASK_ENV_SELECT :: 90;      // Active environment changed (host connects/switches Local/SSH/Boat/WSL)
CP_ASK_ENV_REFRESH :: 91;     // Re-scan ~/.ssh/config, Boats, WSL2 distros, and paired mobile devices
CP_ASK_ENV_CONNECT :: 92;     // Connect/configure/folder-pick target environment at env_target
CP_ASK_ENV_EXPOSE :: 93;      // Server Exposure mode changed (CP_EXPOSE_LOCAL / _LAN / _TAILSCALE)
CP_ASK_ENV_PAIR :: 94;        // Generate / show mobile pairing code / QR link
CP_ASK_ENV_REVOKE :: 95;      // Revoke authorized mobile device at dev_target
CP_ASK_ENV_KEEP_AWAKE :: 96;  // Keep-Awake toggle changed (keep_awake)

// Row action IDs (260, free after CP_FANOUT_TOGGLE :: 252).
CP_ENV_PICK :: 260;

// Environment kinds.
CP_ENV_LOCAL :: 0;
CP_ENV_SSH :: 1;
CP_ENV_BOAT :: 2;
CP_ENV_WSL :: 3;

// Environment connection states.
CP_ENV_ST_READY :: 0;
CP_ENV_ST_DISCONNECTED :: 1;
CP_ENV_ST_CONNECTING :: 2;
CP_ENV_ST_CONNECTED :: 3;
CP_ENV_ST_ERROR :: 4;

// Server Exposure modes.
CP_EXPOSE_LOCAL :: 0;
CP_EXPOSE_LAN :: 1;
CP_EXPOSE_TAILSCALE :: 2;

// Capacities.
CP_ENV_MAX :: 32;
CP_ENV_NAME :: 64;
CP_ENV_HOST :: 128;
CP_ENV_USER :: 64;
CP_ENV_PATH :: 256;
CP_ENV_ERR :: 128;

CP_DEV_MAX :: 16;
CP_DEV_ID :: 64;
CP_DEV_NAME :: 64;
CP_DEV_DETAIL :: 96;

CpEnv :: struct {
  kind: int;                                     // CP_ENV_*
  name: [CP_ENV_NAME] u8; name_n: int;           // display alias (e.g. "Local", "gpu-box", "boat-bx_1", "Ubuntu")
  hostname: [CP_ENV_HOST] u8; hostname_n: int;   // SSH HostName, Boat ID, or WSL distro
  user: [CP_ENV_USER] u8; user_n: int;           // SSH user
  port: int;                                     // SSH port (default 22)
  remote_folder: [CP_ENV_PATH] u8; remote_folder_n: int;
  state: int;                                    // CP_ENV_ST_*
  error: [CP_ENV_ERR] u8; error_n: int;
}

CpMobileDevice :: struct {
  id: [CP_DEV_ID] u8; id_n: int;
  name: [CP_DEV_NAME] u8; name_n: int;
  detail: [CP_DEV_DETAIL] u8; detail_n: int;
  revoked: bool;
}

CpEnvState :: struct {
  envs: [CP_ENV_MAX] CpEnv;
  nenvs: int;
  active: int;                                   // index in envs (0 = Local)
  env_target: int;                               // index for CP_ASK_ENV_CONNECT

  expose_mode: int;                              // CP_EXPOSE_*
  expose_status: [128] u8; expose_status_n: int;
  pair_code: [128] u8; pair_code_n: int;

  devices: [CP_DEV_MAX] CpMobileDevice;
  ndevices: int;
  dev_target: int;                               // index for CP_ASK_ENV_REVOKE

  keep_awake: bool;                              // default true: inhibit OS sleep during active runs
  awake_active: bool;                            // true while OS sleep assertion is currently held
}

// ---------------------------------------------------------------- helpers

cp_env_str :: (buf: [] const u8, n: int) -> string {
  k := n;
  if k < 0 { k = 0; }
  if k > buf.count { k = buf.count; }
  return cast(string) buf[0..<k];
}

cp_env_kind_label :: (kind: int) -> string {
  if kind == CP_ENV_SSH { return "SSH"; }
  if kind == CP_ENV_BOAT { return "Boat"; }
  if kind == CP_ENV_WSL { return "WSL2"; }
  return "Local";
}

cp_env_expose_label :: (mode: int) -> string {
  if mode == CP_EXPOSE_LAN { return "LAN"; }
  if mode == CP_EXPOSE_TAILSCALE { return "Tailscale"; }
  return "Local-only";
}

cp_env_clamp_expose :: (mode: int) -> int {
  if mode < CP_EXPOSE_LOCAL || mode > CP_EXPOSE_TAILSCALE { return CP_EXPOSE_LOCAL; }
  return mode;
}

cp_env_state_label :: (e: CpEnv, out: [] u8) -> string {
  n := 0;
  if e.state == CP_ENV_ST_READY {
    n = el_put(out, n, "Ready");
  } else if e.state == CP_ENV_ST_CONNECTED {
    n = el_put(out, n, "Connected");
  } else if e.state == CP_ENV_ST_CONNECTING {
    n = el_put(out, n, "Connecting…");
  } else if e.state == CP_ENV_ST_ERROR {
    n = el_put(out, n, "Error");
    if e.error_n > 0 {
      n = el_put(out, n, ": ");
      n = el_put(out, n, cp_env_str(e.error[..], e.error_n));
    }
  } else {
    n = el_put(out, n, "Disconnected");
  }
  return cast(string) out[0..<n];
}

// Initializes CpEnvState with the Local environment at slot 0 and Keep-Awake enabled by default.
cp_env_init :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  ev := s[0].env[..];
  ev[0] = CpEnvState.{};
  ev[0].envs[0] = CpEnv.{kind = CP_ENV_LOCAL, state = CP_ENV_ST_READY};
  ev[0].envs[0].name_n = cp_out(ev[0].envs[0].name[..], "Local");
  ev[0].envs[0].hostname_n = cp_out(ev[0].envs[0].hostname[..], "This computer");
  ev[0].nenvs = 1;
  ev[0].active = 0;
  ev[0].env_target = -1;
  ev[0].expose_mode = CP_EXPOSE_TAILSCALE;
  ev[0].dev_target = -1;
  ev[0].keep_awake = true;
  ev[0].awake_active = false;
}

// ---------------------------------------------------------------- SSH ~/.ssh/config parser

cp_env_is_wildcard :: (s: string) -> bool {
  if s.count == 0 { return true; }
  for c: s {
    if c == '*' || c == '?' || c == '!' { return true; }
  }
  return false;
}

cp_env_strip_quotes :: (s: string) -> string {
  t := cp_trim(s);
  if t.count >= 2 && ((t[0] == '"' && t[t.count - 1] == '"') || (t[0] == '\'' && t[t.count - 1] == '\'')) {
    return cast(string) t[1..<t.count - 1];
  }
  return t;
}

cp_env_parse_port :: (s: string) -> int {
  t := cp_env_strip_quotes(s);
  if t.count == 0 { return 22; }
  v := 0;
  for c: t {
    if c < '0' || c > '9' { return 22; }
    v = v * 10 + cast(int) (c - '0');
    if v > 65535 { return 22; }
  }
  return ifx v >= 1 && v <= 65535 then v else 22;
}

// Parses OpenSSH ~/.ssh/config text into `out` (up to out.count and CP_ENV_MAX hosts).
// Extracts non-wildcard `Host` aliases, `HostName`, `User`, and `Port`.
// Returns the number of hosts written to `out`.
cp_env_parse_ssh_config :: (config: string, out: [] CpEnv) -> int {
  cap := out.count;
  if cap > CP_ENV_MAX { cap = CP_ENV_MAX; }
  if cap <= 0 || config.count == 0 { return 0; }
  n := 0;
  block_start := -1;
  block_end := -1;
  pos := 0;
  while pos < config.count {
    line_start := pos;
    while pos < config.count && config[pos] != '\n' { pos += 1; }
    line_end := pos;
    if pos < config.count && config[pos] == '\n' { pos += 1; }
    // Strip CR and inline # comments.
    if line_end > line_start && config[line_end - 1] == '\r' { line_end -= 1; }
    cpos := line_start;
    in_quote := false;
    while cpos < line_end {
      ch := config[cpos];
      if ch == '"' { in_quote = !in_quote; }
      else if ch == '#' && !in_quote { line_end = cpos; break; }
      cpos += 1;
    }
    line := cp_trim(cast(string) config[line_start..<line_end]);
    if line.count == 0 { continue; }
    // Split keyword and remainder (separated by whitespace or '=').
    kw_end := 0;
    while kw_end < line.count && !cp_is_space(line[kw_end]) && line[kw_end] != '=' { kw_end += 1; }
    kw := cast(string) line[0..<kw_end];
    rest_at := kw_end;
    while rest_at < line.count && (cp_is_space(line[rest_at]) || line[rest_at] == '=') { rest_at += 1; }
    val := cp_trim(cast(string) line[rest_at..<line.count]);
    if val.count == 0 { continue; }
    if cp_eq_ci(kw, "host") {
      block_start = n;
      // Split whitespace-separated host patterns on this Host line.
      vi := 0;
      while vi < val.count && n < cap {
        while vi < val.count && cp_is_space(val[vi]) { vi += 1; }
        ts := vi;
        while vi < val.count && !cp_is_space(val[vi]) { vi += 1; }
        tok := cp_env_strip_quotes(cast(string) val[ts..<vi]);
        if tok.count == 0 || cp_env_is_wildcard(tok) { continue; }
        // Deduplicate by alias name.
        dup := false;
        for k: 0..<n {
          if cp_env_str(out[k].name[..], out[k].name_n) == tok { dup = true; break; }
        }
        if dup { continue; }
        out[n] = CpEnv.{kind = CP_ENV_SSH, port = 22, state = CP_ENV_ST_DISCONNECTED};
        if cp_starts_ci(tok, 0, "boat-") { out[n].kind = CP_ENV_BOAT; }
        out[n].name_n = cp_out(out[n].name[..], tok);
        out[n].hostname_n = cp_out(out[n].hostname[..], tok);
        n += 1;
      }
      block_end = n;
    } else if cp_eq_ci(kw, "match") {
      // Match blocks are conditional and do not apply to previous Host entries.
      block_start = -1;
      block_end = -1;
    } else if block_start >= 0 && block_end > block_start {
      clean := cp_env_strip_quotes(val);
      if cp_eq_ci(kw, "hostname") {
        for k: block_start..<block_end {
          out[k].hostname_n = cp_out(out[k].hostname[..], clean);
        }
      } else if cp_eq_ci(kw, "user") {
        for k: block_start..<block_end {
          out[k].user_n = cp_out(out[k].user[..], clean);
        }
      } else if cp_eq_ci(kw, "port") {
        p := cp_env_parse_port(clean);
        for k: block_start..<block_end {
          out[k].port = p;
        }
      }
    }
  }
  return n;
}

// ---------------------------------------------------------------- Windows <-> WSL2 path translation

cp_env_is_alpha :: (c: u8) -> bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

cp_env_upper :: (c: u8) -> u8 {
  return ifx c >= 'a' && c <= 'z' then c - 32 else c;
}

// Translates a Windows path to a WSL2 POSIX path:
//   C:\Users\me\repo       -> /mnt/c/Users/me/repo
//   c:/Users/me/repo       -> /mnt/c/Users/me/repo
//   \\wsl$\Ubuntu\home\me  -> /home/me
//   \\wsl.localhost\Ubuntu\home\me -> /home/me
// Already-POSIX paths (/...) are copied unchanged.
cp_env_win_to_wsl :: (path: string, out: [] u8) -> int {
  if out.count == 0 || path.count == 0 { return 0; }
  // Drive letter path: X:\... or X:/... or X:
  if path.count >= 2 && cp_env_is_alpha(path[0]) && path[1] == ':' && (path.count == 2 || path[2] == '\\' || path[2] == '/') {
    n := el_put(out, 0, "/mnt/");
    if n < out.count { out[n] = cp_lower(path[0]); n += 1; }
    i := 2;
    while i < path.count && n < out.count {
      c := path[i];
      if c == '\\' { c = '/'; }
      if c == '/' && n > 0 && out[n - 1] == '/' { i += 1; continue; }
      out[n] = c;
      n += 1;
      i += 1;
    }
    while n > 6 && out[n - 1] == '/' { n -= 1; }
    return n;
  }
  // UNC WSL path: \\wsl$\<distro>\... or \\wsl.localhost\<distro>\...
  if cp_starts_ci(path, 0, "\\\\wsl$\\") || cp_starts_ci(path, 0, "\\\\wsl.localhost\\") {
    i := ifx cp_starts_ci(path, 0, "\\\\wsl$\\") then 7 else 16;
    // Skip distro name up to next separator.
    while i < path.count && path[i] != '\\' && path[i] != '/' { i += 1; }
    if i >= path.count {
      return el_put(out, 0, "/");
    }
    n := 0;
    while i < path.count && n < out.count {
      c := path[i];
      if c == '\\' { c = '/'; }
      if c == '/' && n > 0 && out[n - 1] == '/' { i += 1; continue; }
      out[n] = c;
      n += 1;
      i += 1;
    }
    if n == 0 { return el_put(out, 0, "/"); }
    while n > 1 && out[n - 1] == '/' { n -= 1; }
    return n;
  }
  // Already POSIX or relative: normalize backslashes to forward slashes.
  n := 0;
  for c: path {
    if n >= out.count { break; }
    out[n] = ifx c == '\\' then '/' else c;
    n += 1;
  }
  return n;
}

// Translates a WSL2 POSIX path to a Windows path:
//   /mnt/c/Users/me/repo -> C:\Users\me\repo
//   /mnt/c               -> C:\
//   /home/me/repo (with distro "Ubuntu") -> \\wsl.localhost\Ubuntu\home\me\repo
// Already-Windows paths (X:\...) are copied unchanged.
cp_env_wsl_to_win :: (path: string, distro: string, out: [] u8) -> int {
  if out.count == 0 || path.count == 0 { return 0; }
  // Already a Windows drive path.
  if path.count >= 2 && cp_env_is_alpha(path[0]) && path[1] == ':' {
    n := 0;
    for c: path {
      if n >= out.count { break; }
      out[n] = ifx c == '/' then '\\' else c;
      n += 1;
    }
    return n;
  }
  // /mnt/<drive> or /mnt/<drive>/...
  if path.count >= 6 && cp_starts_ci(path, 0, "/mnt/") && cp_env_is_alpha(path[5]) && (path.count == 6 || path[6] == '/') {
    n := 0;
    if n < out.count { out[n] = cp_env_upper(path[5]); n += 1; }
    if n < out.count { out[n] = ':'; n += 1; }
    if path.count == 6 || (path.count == 7 && path[6] == '/') {
      if n < out.count { out[n] = '\\'; n += 1; }
      return n;
    }
    i := 6;
    while i < path.count && n < out.count {
      c := path[i];
      if c == '/' { c = '\\'; }
      if c == '\\' && n > 2 && out[n - 1] == '\\' { i += 1; continue; }
      out[n] = c;
      n += 1;
      i += 1;
    }
    while n > 3 && out[n - 1] == '\\' { n -= 1; }
    return n;
  }
  // Native WSL root path (/home/...) -> \\wsl.localhost\<distro>\...
  if path[0] == '/' && distro.count > 0 {
    n := el_put(out, 0, "\\\\wsl.localhost\\");
    n = el_put(out, n, distro);
    i := 0;
    while i < path.count && n < out.count {
      c := path[i];
      if c == '/' { c = '\\'; }
      if c == '\\' && n > 0 && out[n - 1] == '\\' { i += 1; continue; }
      out[n] = c;
      n += 1;
      i += 1;
    }
    return n;
  }
  // Fallback copy with slashes converted.
  n := 0;
  for c: path {
    if n >= out.count { break; }
    out[n] = ifx c == '/' then '\\' else c;
    n += 1;
  }
  return n;
}

// ---------------------------------------------------------------- Environment catalog mutations

cp_env_find :: (s: [] CoderPage, name: string) -> int {
  if s.count < 1 || name.count == 0 { return -1; }
  ev := s[0].env[..];
  for i: 0..<ev[0].nenvs {
    if cp_env_str(ev[0].envs[i].name[..], ev[0].envs[i].name_n) == name { return i; }
  }
  return -1;
}

cp_env_clear_remote :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  ev := s[0].env[..];
  if ev[0].nenvs <= 0 {
    cp_env_init(s);
    return;
  }
  for i: 1..<ev[0].nenvs { ev[0].envs[i] = CpEnv.{}; }
  ev[0].nenvs = 1;
  if ev[0].active >= ev[0].nenvs { ev[0].active = 0; }
}

cp_env_add :: (s: [] CoderPage, kind: int, name: string, hostname: string, user: string, port: int, remote_folder: string) -> int {
  if s.count < 1 || name.count == 0 { return -1; }
  ev := s[0].env[..];
  if ev[0].nenvs == 0 { cp_env_init(s); }
  idx := cp_env_find(s, name);
  if idx < 0 {
    if ev[0].nenvs >= CP_ENV_MAX { return -1; }
    idx = ev[0].nenvs;
    ev[0].envs[idx] = CpEnv.{};
    ev[0].nenvs += 1;
  }
  k := kind;
  if k < CP_ENV_LOCAL || k > CP_ENV_WSL { k = CP_ENV_SSH; }
  ev[0].envs[idx].kind = k;
  ev[0].envs[idx].name_n = cp_out(ev[0].envs[idx].name[..], name);
  ev[0].envs[idx].hostname_n = cp_out(ev[0].envs[idx].hostname[..], ifx hostname.count > 0 then hostname else name);
  ev[0].envs[idx].user_n = cp_out(ev[0].envs[idx].user[..], user);
  ev[0].envs[idx].port = ifx port >= 1 && port <= 65535 then port else 22;
  if remote_folder.count > 0 {
    ev[0].envs[idx].remote_folder_n = cp_out(ev[0].envs[idx].remote_folder[..], remote_folder);
  }
  if k == CP_ENV_LOCAL {
    ev[0].envs[idx].state = CP_ENV_ST_READY;
  } else if ev[0].envs[idx].state == CP_ENV_ST_READY {
    ev[0].envs[idx].state = CP_ENV_ST_DISCONNECTED;
  }
  return idx;
}

cp_env_load_ssh_config :: (s: [] CoderPage, config: string) -> int {
  if s.count < 1 { return 0; }
  parsed: [CP_ENV_MAX] CpEnv;
  n := cp_env_parse_ssh_config(config, parsed[..]);
  added := 0;
  for i: 0..<n {
    e := parsed[i];
    idx := cp_env_add(s, e.kind,
      cp_env_str(e.name[..], e.name_n),
      cp_env_str(e.hostname[..], e.hostname_n),
      cp_env_str(e.user[..], e.user_n),
      e.port, "");
    if idx >= 0 { added += 1; }
  }
  return added;
}

cp_env_set_state :: (s: [] CoderPage, idx: int, state: int, error_msg: string) -> bool {
  if s.count < 1 { return false; }
  ev := s[0].env[..];
  if idx < 0 || idx >= ev[0].nenvs { return false; }
  st := state;
  if st < CP_ENV_ST_READY || st > CP_ENV_ST_ERROR { st = CP_ENV_ST_ERROR; }
  ev[0].envs[idx].state = st;
  ev[0].envs[idx].error_n = cp_out(ev[0].envs[idx].error[..], error_msg);
  return true;
}

cp_env_select :: (s: [] CoderPage, idx: int) -> bool {
  if s.count < 1 { return false; }
  ev := s[0].env[..];
  if idx < 0 || idx >= ev[0].nenvs { return false; }
  ev[0].active = idx;
  return true;
}

// ---------------------------------------------------------------- Authorized mobile devices

cp_env_device_clear :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  ev := s[0].env[..];
  for i: 0..<ev[0].ndevices { ev[0].devices[i] = CpMobileDevice.{}; }
  ev[0].ndevices = 0;
  ev[0].dev_target = -1;
}

cp_env_device_add :: (s: [] CoderPage, id: string, name: string, detail: string) -> int {
  if s.count < 1 || id.count == 0 { return -1; }
  ev := s[0].env[..];
  for i: 0..<ev[0].ndevices {
    if cp_env_str(ev[0].devices[i].id[..], ev[0].devices[i].id_n) == id {
      ev[0].devices[i].name_n = cp_out(ev[0].devices[i].name[..], ifx name.count > 0 then name else id);
      ev[0].devices[i].detail_n = cp_out(ev[0].devices[i].detail[..], detail);
      ev[0].devices[i].revoked = false;
      return i;
    }
  }
  if ev[0].ndevices >= CP_DEV_MAX { return -1; }
  idx := ev[0].ndevices;
  ev[0].devices[idx] = CpMobileDevice.{};
  ev[0].devices[idx].id_n = cp_out(ev[0].devices[idx].id[..], id);
  ev[0].devices[idx].name_n = cp_out(ev[0].devices[idx].name[..], ifx name.count > 0 then name else id);
  ev[0].devices[idx].detail_n = cp_out(ev[0].devices[idx].detail[..], detail);
  ev[0].devices[idx].revoked = false;
  ev[0].ndevices += 1;
  return idx;
}

cp_env_device_revoke :: (s: [] CoderPage, idx: int) -> bool {
  if s.count < 1 { return false; }
  ev := s[0].env[..];
  if idx < 0 || idx >= ev[0].ndevices { return false; }
  for i: idx..<ev[0].ndevices - 1 {
    ev[0].devices[i] = ev[0].devices[i + 1];
  }
  ev[0].ndevices -= 1;
  ev[0].devices[ev[0].ndevices] = CpMobileDevice.{};
  return true;
}

// ---------------------------------------------------------------- Keep-Awake policy

// Pure decision: should OS sleep be inhibited right now?
cp_env_should_keep_awake :: (keep_awake: bool, running_runs: int, goal_active: bool) -> bool {
  return keep_awake && (running_runs > 0 || goal_active);
}

// Page-level Keep-Awake decision combining foreground turn, background runs, and active /goal.
cp_env_keep_awake_needed :: (s: [] CoderPage, bg_running: int) -> bool {
  if s.count < 1 { return false; }
  runs := ifx bg_running > 0 then bg_running else 0;
  if cp_running(s) { runs += 1; }
  return cp_env_should_keep_awake(s[0].env[0].keep_awake, runs, s[0].goal_status == CP_GOAL_ACTIVE);
}

// ---------------------------------------------------------------- Settings -> Connections UI

cp_settings_connections :: (s: [] CoderPage, f: [] UiFrame, x: f32, y0: f32, w: f32) -> f32 {
  t := f[0].skin.set;
  sh := f[0].sheet;
  ev := s[0].env[..];
  y := y0;

  y += set_page_head(f, "set.title", x, y, w, "Connections", "Remote SSH hosts, Boats, WSL2 backends, LAN/Tailscale pairing, and sleep prevention during active runs.") + t.block_gap;

  // 1. Environments section
  act_idx := ifx ev[0].active >= 0 && ev[0].active < ev[0].nenvs then ev[0].active else 0;
  act_name := ifx ev[0].nenvs > 0 then sheet_pool(sh, cp_env_str(ev[0].envs[act_idx].name[..], ev[0].envs[act_idx].name_n)) else "Local";
  y += set_section_head(f, "set.env.head", x, y, w, "Environments", "Select where new chats execute: this computer, ~/.ssh/config hosts, Boats, or Windows WSL2 distros.") + t.section_gap;
  hdr: [1] SetRow;
  hdr[0] = SetRow.{id = "set.env.active", name = "Active environment",
    desc = "Chats and worktrees run in the active environment. Refresh re-reads ~/.ssh/config and Boats.",
    value = act_name, kind = SET_ROW_BUTTON, button = "Refresh", action = CP_SET_ACT};
  y += cp_set_group(s, f, "set.env.active.group", x, y, w, hdr[..]) + t.section_gap;

  if ev[0].nenvs > 0 {
    erows: [CP_ENV_MAX] SetRow;
    for i: 0..<ev[0].nenvs {
      e := ev[0].envs[i];
      ib: [32] u8; in_n := el_put(ib[..], 0, "set.env.item."); in_n = el_put_i(ib[..], in_n, i);
      db: [320] u8; dn := 0;
      dn = el_put(db[..], dn, cp_env_kind_label(e.kind));
      if e.user_n > 0 {
        dn = el_put(db[..], dn, " · ");
        dn = el_put(db[..], dn, cp_env_str(e.user[..], e.user_n));
        dn = el_put(db[..], dn, "@");
        dn = el_put(db[..], dn, cp_env_str(e.hostname[..], e.hostname_n));
      } else if e.hostname_n > 0 {
        dn = el_put(db[..], dn, " · ");
        dn = el_put(db[..], dn, cp_env_str(e.hostname[..], e.hostname_n));
      }
      if (e.kind == CP_ENV_SSH || e.kind == CP_ENV_BOAT) && e.port > 0 && e.port != 22 {
        dn = el_put(db[..], dn, ":");
        dn = el_put_i(db[..], dn, e.port);
      }
      sb: [160] u8;
      dn = el_put(db[..], dn, " · ");
      dn = el_put(db[..], dn, cp_env_state_label(e, sb[..]));
      is_active := i == act_idx;
      if e.kind == CP_ENV_LOCAL {
        erows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
          name = sheet_pool(sh, cp_env_str(e.name[..], e.name_n)),
          desc = sheet_pool(sh, cast(string) db[0..<dn]),
          kind = SET_ROW_CHOICE, noptions = 1, chosen = ifx is_active then 0 else -1, action = CP_SET_ACT};
        erows[i].options[0] = ifx is_active then "Active" else "Use";
      } else {
        erows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
          name = sheet_pool(sh, cp_env_str(e.name[..], e.name_n)),
          desc = sheet_pool(sh, cast(string) db[0..<dn]),
          kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx is_active then 0 else -1, action = CP_SET_ACT};
        erows[i].options[0] = ifx is_active then "Active" else "Use";
        erows[i].options[1] = ifx e.state == CP_ENV_ST_CONNECTED then "Folder…" else "Connect";
      }
    }
    y += cp_set_group(s, f, "set.env.list.group", x, y, w, erows[0..<ev[0].nenvs]) + t.block_gap;
  }

  // 2. Server Exposure & Mobile Pairing section
  emode := cp_env_clamp_expose(ev[0].expose_mode);
  est := ifx ev[0].expose_status_n > 0 then sheet_pool(sh, cp_env_str(ev[0].expose_status[..], ev[0].expose_status_n))
         else ifx emode == CP_EXPOSE_LOCAL then "Local-only — bound to 127.0.0.1; mobile pairing disabled."
         else ifx emode == CP_EXPOSE_LAN then "LAN — reachable on your local network for paired devices."
         else "Tailscale — zero-config pairing with your own Tailscale devices.";
  pcode := ifx ev[0].pair_code_n > 0 then sheet_pool(sh, cp_env_str(ev[0].pair_code[..], ev[0].pair_code_n)) else "Ready";
  y += set_section_head(f, "set.env.expose.head", x, y, w, "Server Exposure & Mobile Pairing", "Control how OpenAgents Desktop accepts connections from your phone or other devices.") + t.section_gap;
  prows: [2] SetRow;
  prows[0] = SetRow.{id = "set.env.expose", name = "Server exposure", desc = est,
    kind = SET_ROW_CHOICE, noptions = 3, chosen = emode, action = CP_SET_ACT};
  prows[0].options[0] = "Local-only"; prows[0].options[1] = "LAN"; prows[0].options[2] = "Tailscale";
  prows[1] = SetRow.{id = "set.env.pair", name = "Pair mobile device",
    desc = "Generate a pairing link and code for OpenAgents iOS to connect to this computer's daemon.",
    value = pcode, kind = SET_ROW_BUTTON, button = "Pair…", action = CP_SET_ACT,
    state = ifx emode == CP_EXPOSE_LOCAL then EL_S_DISABLED else 0};
  y += cp_set_group(s, f, "set.env.expose.group", x, y, w, prows[..]) + t.section_gap;

  // Authorized mobile devices list
  y += set_section_head(f, "set.env.devs.head", x, y, w, "Authorized devices", ifx ev[0].ndevices > 0 then "Paired mobile devices authorized to reach this computer." else "No mobile devices paired yet.") + t.section_gap;
  if ev[0].ndevices > 0 {
    drows: [CP_DEV_MAX] SetRow;
    for i: 0..<ev[0].ndevices {
      d := ev[0].devices[i];
      ib: [32] u8; in_n := el_put(ib[..], 0, "set.env.dev."); in_n = el_put_i(ib[..], in_n, i);
      drows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
        name = sheet_pool(sh, cp_env_str(d.name[..], d.name_n)),
        desc = sheet_pool(sh, cp_env_str(d.detail[..], d.detail_n)),
        kind = SET_ROW_BUTTON, button = "Revoke", action = CP_SET_ACT, danger = true};
    }
    y += cp_set_group(s, f, "set.env.devs.group", x, y, w, drows[0..<ev[0].ndevices]) + t.block_gap;
  } else {
    empty_dev: [1] SetRow;
    empty_dev[0] = SetRow.{id = "set.env.dev.none", name = "No authorized devices", desc = "Switch exposure to LAN or Tailscale and press Pair… to connect your phone.", kind = SET_ROW_PLAIN};
    y += cp_set_group(s, f, "set.env.devs.empty", x, y, w, empty_dev[..]) + t.block_gap;
  }

  // 3. Power & Keep-Awake section
  y += set_section_head(f, "set.env.power.head", x, y, w, "Power", "Prevent idle system sleep while an agent turn or /goal is running.") + t.section_gap;
  krows: [1] SetRow;
  krows[0] = SetRow.{id = "set.env.awake", name = "Keep awake during runs",
    desc = ifx !ev[0].keep_awake then "Off — macOS may sleep while agents are running."
           else ifx ev[0].awake_active then "Active — preventing system idle sleep while runs are in progress."
           else "On — automatically prevents idle sleep when any turn or /goal runs, and releases as soon as all runs finish.",
    kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx ev[0].keep_awake then 1 else 0, action = CP_SET_ACT};
  krows[0].options[0] = "Off"; krows[0].options[1] = "On";
  y += cp_set_group(s, f, "set.env.power.group", x, y, w, krows[..]);

  return y - y0;
}

// Handles Settings -> Connections row presses (called from cp_settings_press).
cp_env_settings_press :: (s: [] CoderPage, id: string) -> bool {
  if s.count < 1 { return false; }
  ev := s[0].env[..];
  if id == "set.env.active.a" { s[0].ask = CP_ASK_ENV_REFRESH; return true; }
  if id == "set.env.pair.a" {
    if cp_env_clamp_expose(ev[0].expose_mode) == CP_EXPOSE_LOCAL { return false; }
    s[0].ask = CP_ASK_ENV_PAIR;
    return true;
  }
  emode := cp_number(id, "set.env.expose.");
  if emode >= CP_EXPOSE_LOCAL && emode <= CP_EXPOSE_TAILSCALE {
    ev[0].expose_mode = emode;
    s[0].ask = CP_ASK_ENV_EXPOSE;
    return true;
  }
  aw := cp_number(id, "set.env.awake.");
  if aw == 0 || aw == 1 {
    ev[0].keep_awake = (aw == 1);
    s[0].ask = CP_ASK_ENV_KEEP_AWAKE;
    return true;
  }
  eidx := cp_number(id, "set.env.item.");
  if eidx >= 0 && eidx < ev[0].nenvs && id.count >= 2 && id[id.count - 2] == '.' {
    opt := cast(int) (id[id.count - 1] - '0');
    if opt == 0 {
      ev[0].active = eidx;
      ev[0].env_target = eidx;
      s[0].ask = CP_ASK_ENV_SELECT;
      return true;
    }
    if opt == 1 {
      ev[0].env_target = eidx;
      s[0].ask = CP_ASK_ENV_CONNECT;
      return true;
    }
  }
  didx := cp_number(id, "set.env.dev.");
  if didx >= 0 && didx < ev[0].ndevices && cp_contains(id, ".a") {
    ev[0].dev_target = didx;
    s[0].ask = CP_ASK_ENV_REVOKE;
    return true;
  }
  return false;
}

// ---------------------------------------------------------------- C exports

coder_page_env_load_ssh_config :: (s: [] CoderPage, config: string) -> int #export_c #effects(all) {
  return cp_env_load_ssh_config(s, config);
}

coder_page_env_clear_remote :: (s: [] CoderPage) #export_c #effects(all) {
  cp_env_clear_remote(s);
}

coder_page_env_add :: (s: [] CoderPage, kind: int, name: string, hostname: string, user: string, port: int, remote_folder: string) -> int #export_c #effects(all) {
  return cp_env_add(s, kind, name, hostname, user, port, remote_folder);
}

coder_page_env_set_state :: (s: [] CoderPage, idx: int, state: int, error_msg: string) -> bool #export_c #effects(all) {
  return cp_env_set_state(s, idx, state, error_msg);
}

coder_page_env_select :: (s: [] CoderPage, idx: int) -> bool #export_c #effects(all) {
  return cp_env_select(s, idx);
}

coder_page_env_active :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return s[0].env[0].active;
}

coder_page_env_target :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  return s[0].env[0].env_target;
}

coder_page_env_count :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return s[0].env[0].nenvs;
}

coder_page_env_kind :: (s: [] CoderPage, idx: int) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].env[0].nenvs { return CP_ENV_LOCAL; }
  return s[0].env[0].envs[idx].kind;
}

coder_page_env_name :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].env[0].nenvs { return 0; }
  return cp_out(out, cp_env_str(s[0].env[0].envs[idx].name[..], s[0].env[0].envs[idx].name_n));
}

coder_page_env_host :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].env[0].nenvs { return 0; }
  return cp_out(out, cp_env_str(s[0].env[0].envs[idx].hostname[..], s[0].env[0].envs[idx].hostname_n));
}

coder_page_env_expose_set :: (s: [] CoderPage, mode: int, status: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].env[0].expose_mode = cp_env_clamp_expose(mode);
  s[0].env[0].expose_status_n = cp_out(s[0].env[0].expose_status[..], status);
}

coder_page_env_expose_mode :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return CP_EXPOSE_LOCAL; }
  return cp_env_clamp_expose(s[0].env[0].expose_mode);
}

coder_page_env_pair_code_set :: (s: [] CoderPage, code: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].env[0].pair_code_n = cp_out(s[0].env[0].pair_code[..], code);
}

coder_page_env_device_clear :: (s: [] CoderPage) #export_c #effects(all) {
  cp_env_device_clear(s);
}

coder_page_env_device_add :: (s: [] CoderPage, id: string, name: string, detail: string) -> int #export_c #effects(all) {
  return cp_env_device_add(s, id, name, detail);
}

coder_page_env_device_revoke :: (s: [] CoderPage, idx: int) -> bool #export_c #effects(all) {
  return cp_env_device_revoke(s, idx);
}

coder_page_env_device_target :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  return s[0].env[0].dev_target;
}

coder_page_env_device_id :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].env[0].ndevices { return 0; }
  return cp_out(out, cp_env_str(s[0].env[0].devices[idx].id[..], s[0].env[0].devices[idx].id_n));
}

coder_page_env_device_count :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return s[0].env[0].ndevices;
}

coder_page_env_keep_awake_set :: (s: [] CoderPage, enabled: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].env[0].keep_awake = enabled;
}

coder_page_env_keep_awake :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return s[0].env[0].keep_awake;
}

coder_page_env_awake_active_set :: (s: [] CoderPage, active: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].env[0].awake_active = active;
}

coder_page_env_should_keep_awake :: (s: [] CoderPage, bg_running: int) -> bool #export_c #effects(all) {
  return cp_env_keep_awake_needed(s, bg_running);
}

coder_page_env_win_to_wsl :: (path: string, out: [] u8) -> int #export_c #effects(all) {
  return cp_env_win_to_wsl(path, out);
}

coder_page_env_wsl_to_win :: (path: string, distro: string, out: [] u8) -> int #export_c #effects(all) {
  return cp_env_wsl_to_win(path, distro, out);
}
