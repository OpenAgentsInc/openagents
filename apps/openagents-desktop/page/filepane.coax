// OpenAgents Desktop page (../page.coax): Antigravity-style right-pane File Viewer & Editor
// (GitHub #13760, #13881, #13992): unified top tab bar with colored language badges, '+' quick-open,
// Expand/Restore (⛶) and Hide-preserving-tabs (◫), interactive path breadcrumbs + inline toolbar
// (⋮ More/Editors, ↻ Reload, ≡ Word Wrap), full-color multi-language syntax highlighting, collapsible
// File Explorer tree, inline editing up to 128 KB / 4,096 lines, and rich read-only previews.

CP_FP_MOST :: 4194304;       // bytes the pane shows (4 MB, lifted from 512 KB in #13992)
CP_FP_EDIT_MOST :: 131072;   // bytes a file may have to be edited inline (128 KB, lifted from 16 KB in #13881)
CP_FP_EDIT_LINES :: 4096;    // lines a file may have to be edited inline (4,096 lines, lifted from 512 in #13881)
CP_FP_SMALL_LINES :: 512;    // lines fitting in the shared UiEditor; larger files use large_edit mode
CP_FP_PATH :: 1024;          // bytes of the path it shows
CP_FP_BAR1_H :: 38.0f32;     // Row 1: unified top tab bar height (level with window titlebar)
CP_FP_BAR2_H :: 30.0f32;     // Row 2: breadcrumb trail & inline action bar height
CP_FP_FOLD_W :: 14.0f32;     // fold chevron lane width between line numbers and code (#13992)
CP_FP_MAX_LINES :: 32768;    // indexed line starts for O(visible lines) virtualization (#13992)
CP_FP_CP_STEP :: 64;         // lines per multi-line block-comment/docstring state checkpoint
CP_FP_MAX_CP :: 512;         // CP_FP_MAX_LINES / CP_FP_CP_STEP
CP_FP_FOLDS :: 512;          // structural code-fold ranges per file (#13992)
CP_FP_SEL_LINES :: 256;      // visible SheetLine -> 1-based source line map for Copy with Path:Line
CP_FP_NONE :: 0; CP_FP_EDIT :: 1; CP_FP_READ :: 2; CP_FP_FAILED :: 3; CP_FP_SCENE :: 4;   // what the pane holds
// UI actions dispatched by filepane controls (80..89 + 450..459)
CP_FP_CLOSE :: 80; CP_FP_SAVE :: 81; CP_FP_EXTERNAL :: 82; CP_FP_LEAN_GOAL :: 83;
CP_FP_EXPAND :: 84;          // ⛶ toggle full-width expanded file viewer
CP_FP_HIDE :: 85;            // ◫ hide right pane while preserving open tabs & active file
CP_FP_ADD_TAB :: 86;         // + open Command Palette in Files mode to add another tab
CP_FP_RELOAD :: 87;          // ↻ reload active file from disk preserving scroll
CP_FP_WRAP :: 88;            // ≡ toggle word wrap in code viewer
CP_FP_COPY_PATH :: 89;       // copy active file path to clipboard
CP_FP_FOLD_TOGGLE :: 450;    // ▾/▸ toggle structural fold range (coder.fp.fold.<fi>)
CP_FP_TOGGLE_EDIT :: 451;    // ⋮ menu: Edit File / Switch to Read-Only
CP_FP_DISK_RELOAD :: 452;    // dirty disk-change banner: Reload from disk
CP_FP_DISK_KEEP :: 453;      // dirty disk-change banner: Keep Mine
CP_FP_COPY_REL_PATH :: 454;  // ⋮ menu: Copy Relative Path
CP_FP_COPY_CONTENTS :: 455;  // ⋮ menu: Copy Contents
CP_FP_REVEAL :: 456;         // ⋮ menu: Reveal in Finder / Explorer
CP_FP_GOTO_LINE :: 457;      // ⋮ menu / Ctrl+G: Go to Line…
CP_FP_MD_PREVIEW :: 458;     // ⋮ menu: Preview Markdown / View Source
CP_FP_EXT_LAST :: 459;
// Host asks (coder_page_action)
CP_ASK_FILE_SAVE :: 40; CP_ASK_FILE_EXTERNAL :: 41; CP_ASK_FILE_CLOSE :: 42; CP_ASK_FILE_FOCUS :: 43;
CP_ASK_FILE_LEAN_GOAL :: 157;
CP_ASK_FILE_RELOAD :: 164;        // host re-reads active file from disk and calls coder_page_file_reload
CP_ASK_FILE_COPY_PATH :: 165;     // host copies coder_page_file_path to the OS clipboard
CP_ASK_FILE_DIR_LIST :: 166;      // host lists coder_page_file_crumb_dir -> coder_page_file_dir_set (#13992)
CP_ASK_FILE_COPY_REL :: 167;      // host copies repo-relative path to clipboard (#13992)
CP_ASK_FILE_COPY_CONTENT :: 168;  // host copies active file contents to clipboard (#13992)
CP_ASK_FILE_REVEAL :: 169;        // host reveals active file in Finder/Explorer (#13992)
CP_FP_LEAN_STRIP_H :: 54.0f32;
CP_KB_FILE :: 3;             // the file's editor has the keyboard (editor.coax's CP_KB_*)
CP_SCR_FILE :: 5;            // the wheel over the pane (input.coax's CP_SCR_*)

CpFoldRange :: struct {
  start_line: int;           // 1-based start line (header showing ▾/▸)
  end_line: int;             // 1-based inclusive end line folded away
}

CpFilePane :: struct {
  open: bool;
  front: bool;                // in front of a sub-agent's transcript or the review
  hidden: bool;               // collapsed via ◫ while preserving open tabs, active file & scroll (#13992)
  expanded: bool;             // expanded via ⛶ across the main area beside the left sidebar (#13992)
  wrap: bool;                 // soft-wrap long lines in viewer mode (toggled via ≡, #13992)
  md_preview: bool;           // formatted Markdown preview toggle for .md files (#13992)
  disk_changed: bool;         // true when external disk edit occurred while dirty (#13992)
  mode: int;                  // CP_FP_*
  large_edit: bool;           // true when editing a file > EB_TEXT or > CP_FP_SMALL_LINES (up to 128 KB / 4,096 lines)
  path: [CP_FP_PATH] u8; path_n: int;   // full or tilde path shown in breadcrumbs
  src: [] u8;                 // the file as last read or saved, in the host's buffer (it keeps it until the next)
  size: int;                  // its bytes on disk
  why: [512] u8; why_n: int;  // why it could not be read, or why the last save failed
  save_failed: bool;
  text: [CP_FP_EDIT_MOST] u8; text_n: int;   // what the editor holds, as it last published it
  caret: int;                 // byte offset of caret in large_edit mode
  dirty: bool;                // text is not what the file holds
  saved: bool;                // saved since it opened, with no change after
  scroll: f32; content: f32; view: f32;   // the read-only / large-edit view's vertical scroll
  scroll_x: f32; content_w: f32;          // horizontal scroll offset and max line width when !wrap (#13992)
  scr: [1] UiScroll;                      // smooth vertical momentum & scroll rail (#13992)
  body_x: f32; body_y: f32; body_w: f32; body_h: f32; cell_w: f32;   // the pane body rect and mono cell width in logical points
  // Target-line jump highlight (1-based inclusive range; 0 = none, #13992)
  hl_start: int;
  hl_end: int;
  // Virtualized line-offset index, multi-line block-state checkpoints & structural folds (#13992)
  line_starts: [CP_FP_MAX_LINES] int;
  nlines: int;
  max_cols: int;
  block_cp: [CP_FP_MAX_CP] u8;
  folds: [CP_FP_FOLDS] CpFoldRange;
  nfolds: int;
  fold_bits: [8] u64;
  // Visible SheetLine -> 1-based line number map for Copy with Path:Line (#13992)
  sel_l0: int;
  sel_line_map: [CP_FP_SEL_LINES] int;
  sel_line_n: int;
  // Live Lean 4 Goal Strip state (#13947: populated asynchronously via oa-leanhost)
  lean_goal: [256] u8; lean_goal_n: int;
  lean_goal_line: int;
  lean_goal_ok: bool;
  lean_goal_done: bool;
  lean_goal_busy: bool;
}

cp_fp_is_lean :: (s: [] CoderPage) -> bool {
  n := s[0].fp[0].path_n;
  if n < 5 { return false; }
  p := cast(string) s[0].fp[0].path[0..<n];
  return p[n - 5] == '.' && p[n - 4] == 'l' && p[n - 3] == 'e' && p[n - 2] == 'a' && p[n - 1] == 'n';
}

cp_fp_is_markdown :: (s: [] CoderPage) -> bool {
  p := cast(string) s[0].fp[0].path[0..<s[0].fp[0].path_n];
  return cp_ft_ends_ci(p, ".md") || cp_ft_ends_ci(p, ".markdown");
}

// Formats Markdown text into clean readable preview blocks inside ft[0].preview_buf (#13992).
cp_fp_format_md_preview :: (src: string, out: [] u8) -> int {
  n := 0; i := 0; in_fence := false;
  while i < src.count && n + 16 < out.count {
    end := i;
    while end < src.count && src[end] != '\n' { end += 1; }
    stop := ifx end > i && src[end - 1] == '\r' then end - 1 else end;
    ln := cast(string) src[i..<stop];
    i = end + 1;
    if ln.count >= 3 && ln[0] == '`' && ln[1] == '`' && ln[2] == '`' {
      in_fence = !in_fence;
      if in_fence { n = el_put(out, n, "── code ────────────────────────────\n"); }
      else { n = el_put(out, n, "────────────────────────────────────\n"); }
      continue;
    }
    if in_fence {
      n = el_put(out, n, "  ");
      n = el_put(out, n, ln);
      n = cp_ft_put_ch(out, n, '\n');
      continue;
    }
    if ln.count > 0 && ln[0] == '#' {
      lvl := 0;
      while lvl < ln.count && ln[lvl] == '#' { lvl += 1; }
      t0 := lvl;
      while t0 < ln.count && ln[t0] == ' ' { t0 += 1; }
      title := cast(string) ln[t0..<ln.count];
      if lvl == 1 {
        n = el_put(out, n, "▸ ");
        n = el_put(out, n, title);
        n = el_put(out, n, "\n════════════════════════════════════\n");
      } else {
        n = el_put(out, n, "▪ ");
        n = el_put(out, n, title);
        n = cp_ft_put_ch(out, n, '\n');
      }
      continue;
    }
    if ln.count >= 2 && (ln[0] == '-' || ln[0] == '*') && ln[1] == ' ' {
      n = el_put(out, n, "  • ");
      n = el_put(out, n, cast(string) ln[2..<ln.count]);
      n = cp_ft_put_ch(out, n, '\n');
      continue;
    }
    if ln.count >= 2 && ln[0] == '>' && ln[1] == ' ' {
      n = el_put(out, n, "│ ");
      n = el_put(out, n, cast(string) ln[2..<ln.count]);
      n = cp_ft_put_ch(out, n, '\n');
      continue;
    }
    n = el_put(out, n, ln);
    n = cp_ft_put_ch(out, n, '\n');
  }
  return n;
}

// Active text rendered & searched by the File Viewer (#13992).
cp_fp_view_src :: (s: [] CoderPage) -> string {
  fp := s[0].fp[..]; ft := s[0].ft[..];
  if fp[0].mode == CP_FP_EDIT { return cp_fp_text(s); }
  if fp[0].md_preview && ft[0].preview_n > 0 { return cast(string) ft[0].preview_buf[0..<ft[0].preview_n]; }
  if ft[0].preview_kind != CP_FT_PREV_NONE && !ft[0].preview_raw && ft[0].preview_n > 0 {
    return cast(string) ft[0].preview_buf[0..<ft[0].preview_n];
  }
  return cast(string) fp[0].src;
}

// ---------------------------------------------------------------- what the rest of the page asks

// Whether the pane draws the file or file explorer: open, not hidden, in front, or nothing else wants the pane.
cp_fp_shown :: (s: [] CoderPage) -> bool {
  fp := s[0].fp[..]; ft := s[0].ft[..];
  if fp[0].hidden { return false; }
  fp_open := fp[0].open && (fp[0].mode != CP_FP_SCENE || cp_flag(s, DC_FLAG_SCENES));
  any_open := fp_open || ft[0].open;
  any_front := (fp_open && fp[0].front) || (ft[0].open && ft[0].front);
  return any_open && !cp_sim_front(s) && !cp_term_front(s) && (any_front || !(s[0].pane_open || s[0].review));
}
// Whether the file's editor is on screen: the keyboard can go to it.
cp_fp_editing :: (s: [] CoderPage) -> bool {
  return cp_fp_shown(s) && s[0].fp[0].open && s[0].fp[0].mode == CP_FP_EDIT && !s[0].set_open;
}
cp_fp_name :: (s: [] CoderPage) -> string {
  p := cast(string) s[0].fp[0].path[0..<s[0].fp[0].path_n];
  at := p.count;
  while at > 0 && p[at - 1] != '/' { at -= 1; }
  return cast(string) p[at..<p.count];
}
// What the status badge says: Edited, Saved, Preview, Read-only (when past edit cap), or nothing.
cp_fp_state :: (s: [] CoderPage) -> string {
  fp := s[0].fp[..];
  if fp[0].mode == CP_FP_SCENE { return "3D Scene"; }
  if fp[0].mode == CP_FP_READ {
    if fp[0].md_preview { return "Preview"; }
    pk := s[0].ft[0].preview_kind;
    if pk == CP_FT_PREV_CSV { return "Table"; }
    if pk == CP_FT_PREV_IPYNB { return "Notebook"; }
    if pk == CP_FT_PREV_HEX { return "Hex"; }
    if pk == CP_FT_PREV_IMAGE { return "Image"; }
    if pk == CP_FT_PREV_PDF { return "PDF"; }
    if fp[0].src.count > CP_FP_EDIT_MOST || fp[0].nlines > CP_FP_EDIT_LINES { return "Read-only"; }
    return "";
  }
  if fp[0].mode != CP_FP_EDIT { return ""; }
  return ifx fp[0].dirty then "Edited" else ifx fp[0].saved then "Saved" else "Editing";
}
// The editor's text, as the page keeps it (editor.coax opens the field on it for small files).
cp_fp_text :: (s: [] CoderPage) -> string { return cast(string) s[0].fp[0].text[0..<s[0].fp[0].text_n]; }
// Current 1-based caret line number in the open file (for Open-in-Editor at line).
cp_fp_caret_line :: (s: [] CoderPage) -> int {
  fp := s[0].fp[..];
  if !fp[0].open { return 1; }
  if fp[0].mode != CP_FP_EDIT { return ifx fp[0].hl_start > 0 then fp[0].hl_start else 1; }
  t := cp_fp_text(s);
  cpos := ifx fp[0].large_edit then fp[0].caret else s[0].fld[0].ed[CP_ED_FILE].body[0].ed[0].caret;
  if cpos > t.count { cpos = t.count; }
  if cpos < 0 { cpos = 0; }
  ln := 1;
  for i: 0..<cpos { if t[i] == '\n' { ln += 1; } }
  return ln;
}

// ---------------------------------------------------------------- line-offset virtualization & structural folding (#13992)

cp_fp_fold_is_closed :: (fp: [] CpFilePane, fi: int) -> bool {
  if fi < 0 || fi >= fp[0].nfolds || fi >= 512 { return false; }
  return ((fp[0].fold_bits[fi >> 6] >> cast(u64) (fi & 63)) & 1) != 0;
}

cp_fp_fold_set_closed :: (fp: [] CpFilePane, fi: int, closed: bool) {
  if fi < 0 || fi >= fp[0].nfolds || fi >= 512 { return; }
  bit := cast(u64) 1 << cast(u64) (fi & 63);
  if closed { fp[0].fold_bits[fi >> 6] |= bit; }
  else { fp[0].fold_bits[fi >> 6] &= (bit ^ 0xFFFFFFFFFFFFFFFF); }
}

cp_fp_fold_toggle :: (s: [] CoderPage, fi: int) -> bool {
  fp := s[0].fp[..];
  if fi < 0 || fi >= fp[0].nfolds || fi >= 512 { return false; }
  cp_fp_fold_set_closed(fp, fi, !cp_fp_fold_is_closed(fp, fi));
  cp_ft_tab_save_active(s);
  return true;
}

cp_fp_fold_at_line :: (fp: [] CpFilePane, line1: int) -> int {
  // folds are sorted ascending by start_line -> binary search O(log nfolds)
  lo := 0; hi := fp[0].nfolds - 1;
  while lo <= hi {
    mid := (lo + hi) >> 1;
    sl := fp[0].folds[mid].start_line;
    if sl == line1 { return mid; }
    if sl < line1 { lo = mid + 1; }
    else { hi = mid - 1; }
  }
  return -1;
}

cp_fp_unfold_enclosing :: (s: [] CoderPage, line1: int) {
  fp := s[0].fp[..];
  for fi: 0..<fp[0].nfolds {
    if cp_fp_fold_is_closed(fp, fi) && line1 > fp[0].folds[fi].start_line && line1 <= fp[0].folds[fi].end_line {
      cp_fp_fold_set_closed(fp, fi, false);
    }
  }
}

cp_fp_line_end :: (fp: [] CpFilePane, src: string, li: int) -> int {
  if li < 0 || li >= fp[0].nlines { return src.count; }
  end := ifx li + 1 < fp[0].nlines then fp[0].line_starts[li + 1] - 1 else src.count;
  if end < fp[0].line_starts[li] { end = fp[0].line_starts[li]; }
  if end > fp[0].line_starts[li] && src[end - 1] == '\r' { end -= 1; }
  return end;
}

cp_fp_add_fold :: (fp: [] CpFilePane, start_line: int, end_line: int) {
  if end_line <= start_line || fp[0].nfolds >= CP_FP_FOLDS { return; }
  // Maintain ascending start_line order; skip duplicate start_line.
  at := fp[0].nfolds;
  while at > 0 && fp[0].folds[at - 1].start_line > start_line { at -= 1; }
  if at > 0 && fp[0].folds[at - 1].start_line == start_line {
    if end_line > fp[0].folds[at - 1].end_line { fp[0].folds[at - 1].end_line = end_line; }
    return;
  }
  i := fp[0].nfolds;
  while i > at { fp[0].folds[i] = fp[0].folds[i - 1]; i -= 1; }
  fp[0].folds[at] = CpFoldRange.{ start_line = start_line, end_line = end_line };
  fp[0].nfolds += 1;
}

// Advances SYN_BLK_* multi-line comment/docstring state across one source line without allocating runs.
cp_fp_advance_blk :: (lang: int, code: string, blk: [] u8) {
  if blk.count < 1 || code.count == 0 { return; }
  c_like := (lang == SYN_LANG_C || lang == SYN_LANG_COAX || lang == SYN_LANG_RUST || lang == SYN_LANG_SWIFT || lang == SYN_LANG_JS || lang == SYN_LANG_JSON);
  lean := (lang == SYN_LANG_LEAN);
  py := (lang == SYN_LANG_PYTHON);
  if !c_like && !lean && !py { return; }
  i := 0; n := code.count;
  while i < n {
    if blk[0] == SYN_BLK_COMMENT {
      if c_like && i + 1 < n && code[i] == '*' && code[i + 1] == '/' { blk[0] = SYN_BLK_NONE; i += 2; continue; }
      if lean && i + 1 < n && code[i] == '-' && code[i + 1] == '/' { blk[0] = SYN_BLK_NONE; i += 2; continue; }
      i += 1; continue;
    }
    if blk[0] == SYN_BLK_PY_DQUOTE || blk[0] == SYN_BLK_PY_SQUOTE {
      q: u8 = ifx blk[0] == SYN_BLK_PY_DQUOTE then '"' else '\'';
      if code[i] == '\\' && i + 1 < n { i += 2; continue; }
      if i + 2 < n && code[i] == q && code[i + 1] == q && code[i + 2] == q { blk[0] = SYN_BLK_NONE; i += 3; continue; }
      i += 1; continue;
    }
    if py {
      if code[i] == '#' { return; }
      if i + 2 < n && code[i] == '"' && code[i + 1] == '"' && code[i + 2] == '"' { blk[0] = SYN_BLK_PY_DQUOTE; i += 3; continue; }
      if i + 2 < n && code[i] == '\'' && code[i + 1] == '\'' && code[i + 2] == '\'' { blk[0] = SYN_BLK_PY_SQUOTE; i += 3; continue; }
      if code[i] == '"' || code[i] == '\'' {
        q := code[i]; i += 1;
        while i < n && code[i] != q { if code[i] == '\\' { i += 1; } i += 1; }
        i += 1; continue;
      }
      i += 1; continue;
    }
    if code[i] == '"' {
      i += 1;
      while i < n && code[i] != '"' { if code[i] == '\\' { i += 1; } i += 1; }
      i += 1; continue;
    }
    if c_like && i + 1 < n && code[i] == '/' && code[i + 1] == '/' { return; }
    if lean && i + 1 < n && code[i] == '-' && code[i + 1] == '-' { return; }
    if c_like && i + 1 < n && code[i] == '/' && code[i + 1] == '*' { blk[0] = SYN_BLK_COMMENT; i += 2; continue; }
    if lean && i + 1 < n && code[i] == '/' && code[i + 1] == '-' { blk[0] = SYN_BLK_COMMENT; i += 2; continue; }
    i += 1;
  }
}

// Computes structural fold ranges once on load/reload (brace blocks, Python/YAML indentation, Markdown headings).
cp_fp_build_folds :: (s: [] CoderPage, src: string, lang: int) {
  fp := s[0].fp[..];
  fp[0].nfolds = 0;
  nl := fp[0].nlines;
  if nl < 2 || lang == SYN_LANG_PLAIN { return; }
  c_like := (lang == SYN_LANG_C || lang == SYN_LANG_COAX || lang == SYN_LANG_RUST || lang == SYN_LANG_SWIFT || lang == SYN_LANG_JS || lang == SYN_LANG_JSON);
  if c_like {
    stk: [64] int; sp := 0;
    blk: [1] u8;
    for li: 0..<nl {
      a := fp[0].line_starts[li]; b := cp_fp_line_end(fp, src, li);
      i := a;
      while i < b {
        if blk[0] == SYN_BLK_COMMENT {
          if i + 1 < b && src[i] == '*' && src[i + 1] == '/' { blk[0] = SYN_BLK_NONE; i += 2; continue; }
          i += 1; continue;
        }
        if src[i] == '"' || src[i] == '\'' {
          q := src[i]; i += 1;
          while i < b && src[i] != q { if src[i] == '\\' { i += 1; } i += 1; }
          i += 1; continue;
        }
        if i + 1 < b && src[i] == '/' && src[i + 1] == '/' { break; }
        if i + 1 < b && src[i] == '/' && src[i + 1] == '*' { blk[0] = SYN_BLK_COMMENT; i += 2; continue; }
        if src[i] == '{' {
          if sp < 64 { stk[sp] = li + 1; sp += 1; }
        } else if src[i] == '}' {
          if sp > 0 {
            sp -= 1;
            cp_fp_add_fold(fp, stk[sp], li + 1);
          }
        }
        i += 1;
      }
    }
    return;
  }
  if lang == SYN_LANG_MD {
    h_line: [6] int; h_lvl: [6] int; sp := 0;
    for li: 0..<nl {
      a := fp[0].line_starts[li]; b := cp_fp_line_end(fp, src, li);
      if a < b && src[a] == '#' {
        lvl := 0; while a + lvl < b && src[a + lvl] == '#' && lvl < 6 { lvl += 1; }
        if a + lvl < b && src[a + lvl] == ' ' {
          while sp > 0 && h_lvl[sp - 1] >= lvl {
            sp -= 1;
            cp_fp_add_fold(fp, h_line[sp], li);
          }
          if sp < 6 { h_line[sp] = li + 1; h_lvl[sp] = lvl; sp += 1; }
        }
      }
    }
    while sp > 0 { sp -= 1; cp_fp_add_fold(fp, h_line[sp], nl); }
    return;
  }
  if lang == SYN_LANG_PYTHON || lang == SYN_LANG_CONFIG {
    // Indentation-based fold ranges: whenever the next non-blank line indents deeper, fold to the last line before dedent.
    for li: 0..<nl {
      if fp[0].nfolds >= CP_FP_FOLDS { break; }
      a := fp[0].line_starts[li]; b := cp_fp_line_end(fp, src, li);
      ind := 0; while a + ind < b && (src[a + ind] == ' ' || src[a + ind] == '\t') { ind += 1; }
      if a + ind >= b || src[a + ind] == '#' { continue; }
      // Find first non-blank line after li
      nxt := li + 1; nxt_ind := -1;
      while nxt < nl {
        na := fp[0].line_starts[nxt]; nb := cp_fp_line_end(fp, src, nxt);
        ni := 0; while na + ni < nb && (src[na + ni] == ' ' || src[na + ni] == '\t') { ni += 1; }
        if na + ni < nb && src[na + ni] != '#' { nxt_ind = ni; break; }
        nxt += 1;
      }
      if nxt_ind <= ind { continue; }
      last_body := nxt;
      k := nxt + 1;
      while k < nl {
        ka := fp[0].line_starts[k]; kb := cp_fp_line_end(fp, src, k);
        ki := 0; while ka + ki < kb && (src[ka + ki] == ' ' || src[ka + ki] == '\t') { ki += 1; }
        if ka + ki >= kb { k += 1; continue; }
        if ki <= ind { break; }
        last_body = k;
        k += 1;
      }
      if last_body > li { cp_fp_add_fold(fp, li + 1, last_body + 1); }
    }
  }
}

// Builds line_starts[], max_cols, block_cp[] checkpoints, and structural folds once on open/reload/edit (#13992).
cp_fp_build_index :: (s: [] CoderPage, src: string, lang: int) {
  fp := s[0].fp[..];
  fp[0].nlines = 0; fp[0].max_cols = 0; fp[0].nfolds = 0;
  blk: [1] u8;
  at := 0; li := 0;
  while li < CP_FP_MAX_LINES {
    fp[0].line_starts[li] = at;
    if (li & (CP_FP_CP_STEP - 1)) == 0 {
      cp := li / CP_FP_CP_STEP;
      if cp < CP_FP_MAX_CP { fp[0].block_cp[cp] = blk[0]; }
    }
    end := at;
    while end < src.count && src[end] != '\n' { end += 1; }
    stop := ifx end > at && src[end - 1] == '\r' then end - 1 else end;
    cols := stop - at;
    if cols > fp[0].max_cols { fp[0].max_cols = cols; }
    if lang != SYN_LANG_PLAIN && stop > at {
      cp_fp_advance_blk(lang, cast(string) src[at..<stop], blk[..]);
    }
    li += 1;
    if end >= src.count { break; }
    at = end + 1;
  }
  fp[0].nlines = li;
  cp_fp_build_folds(s, src, lang);
}

// Restores block-comment/docstring state at 0-based line `target_li` in O(CP_FP_CP_STEP) using checkpoints.
cp_fp_block_state_at :: (fp: [] CpFilePane, src: string, lang: int, target_li: int) -> u8 {
  if lang == SYN_LANG_PLAIN || target_li <= 0 || fp[0].nlines <= 0 { return SYN_BLK_NONE; }
  cp := target_li / CP_FP_CP_STEP;
  if cp >= CP_FP_MAX_CP { cp = CP_FP_MAX_CP - 1; }
  base_li := cp * CP_FP_CP_STEP;
  blk: [1] u8; blk[0] = fp[0].block_cp[cp];
  li := base_li;
  while li < target_li && li < fp[0].nlines {
    a := fp[0].line_starts[li]; b := cp_fp_line_end(fp, src, li);
    if b > a { cp_fp_advance_blk(lang, cast(string) src[a..<b], blk[..]); }
    li += 1;
  }
  return blk[0];
}

// Jumps smoothly to 1-based [start_line, end_line], unfolding enclosing folds and lighting the target lines (#13992).
cp_fp_jump :: (s: [] CoderPage, start_line: int, end_line: int) {
  fp := s[0].fp[..];
  if !fp[0].open || start_line <= 0 { return; }
  sl := start_line;
  if fp[0].nlines > 0 && sl > fp[0].nlines { sl = fp[0].nlines; }
  el := ifx end_line >= sl then end_line else sl;
  if fp[0].nlines > 0 && el > fp[0].nlines { el = fp[0].nlines; }
  cp_fp_unfold_enclosing(s, sl);
  fp[0].hl_start = sl;
  fp[0].hl_end = el;
  // Count visible rows before sl (skipping collapsed fold interiors)
  vis_row := 0; ln := 1;
  while ln < sl {
    fi := cp_fp_fold_at_line(fp, ln);
    if fi >= 0 && cp_fp_fold_is_closed(fp, fi) && fp[0].folds[fi].end_line < sl {
      ln = fp[0].folds[fi].end_line + 1;
    } else {
      ln += 1;
    }
    vis_row += 1;
  }
  k := cp_skin();
  lh := ifx k.mono.line > 0 then k.mono.line else 18.0f32;
  target := cast(f32) (vis_row - 4) * lh;
  if target < 0.0f32 { target = 0.0f32; }
  total_est := cast(f32) fp[0].nlines * lh;
  if total_est > fp[0].content { fp[0].content = total_est; }
  fp[0].scr[0].coasting = false;
  fp[0].scr[0].spring = false;
  fp[0].scroll = ifx fp[0].view > 0 then scroll_clamp(target, fp[0].content, fp[0].view) else target;
  if fp[0].mode == CP_FP_EDIT && !fp[0].large_edit {
    c := s[0].fld[0].ed[CP_ED_FILE].body[..];
    c[0].follow = false;
    c[0].scroll = target;
  }
}

// Switches the open file between Viewer (CP_FP_READ) and Inline Edit (CP_FP_EDIT) modes (#13992).
cp_fp_set_edit :: (s: [] CoderPage, on: bool) -> bool {
  fp := s[0].fp[..]; ft := s[0].ft[..];
  if !fp[0].open || fp[0].mode == CP_FP_FAILED || fp[0].mode == CP_FP_SCENE { return false; }
  if !on {
    if fp[0].mode != CP_FP_EDIT { return true; }
    fp[0].mode = CP_FP_READ;
    fp[0].large_edit = false;
    if s[0].fld[0].kb == CP_KB_FILE { s[0].fld[0].kb = CP_KB_COMPOSER; }
    path := cast(string) fp[0].path[0..<fp[0].path_n];
    cp_fp_build_index(s, cp_fp_view_src(s), cp_fp_lang(path, ft[0].preview_kind));
    cp_ft_tab_save_active(s);
    return true;
  }
  if ft[0].preview_kind != CP_FT_PREV_NONE { return false; }
  text := cast(string) fp[0].src;
  nl := ifx fp[0].nlines > 0 then fp[0].nlines else cp_fp_lines(text);
  if text.count > CP_FP_EDIT_MOST || nl > CP_FP_EDIT_LINES { return false; }
  fp[0].md_preview = false;
  fp[0].mode = CP_FP_EDIT;
  if fp[0].text_n == 0 || !fp[0].dirty {
    fp[0].text_n = cp_out(fp[0].text[..], text);
  }
  fp[0].large_edit = (fp[0].text_n > EB_TEXT || nl > CP_FP_SMALL_LINES);
  fp[0].caret = 0;
  ue_close(s[0].fld[0].ed[CP_ED_FILE..<CP_ED_FILE + 1]);
  cp_ed_focus(s, CP_KB_FILE);
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  cp_fp_build_index(s, cp_fp_text(s), cp_fp_lang(path, CP_FT_PREV_NONE));
  cp_ft_tab_save_active(s);
  return true;
}

// What the editor holds becomes the page's: changed when it is not the file's text.
cp_fp_publish :: (s: [] CoderPage, text: string) {
  fp := s[0].fp[..];
  fp[0].text_n = cp_out(fp[0].text[..], text);
  dirty := text != cast(string) fp[0].src;
  if dirty { fp[0].saved = false; }
  fp[0].dirty = dirty;
  cp_ft_tab_set_dirty(s, cast(string) fp[0].path[0..<fp[0].path_n], dirty);
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  cp_fp_build_index(s, cp_fp_text(s), cp_fp_lang(path, CP_FT_PREV_NONE));
}
// The file editor's skin: the code face on its own line, no room above the text for a scroll.
// Text ink is transparent when syntax highlighting paints colored runs on top.
cp_fp_skin :: (k: UiSkin) -> UiSkin {
  sk := k;
  sk.body.face = k.mono.face; sk.body.line = k.mono.line; sk.cmp.line = k.mono.line; sk.cmp.pad_top = 0;
  sk.ink = Rgba.{};   // selection, caret, and IME underline draw from UiEditor; colored syntax runs draw over it
  return sk;
}
// A press on a sub-agent's row or the Review button while the file is in front: that pane comes
// forward (the file stays open behind it). True when the press did all it asked.
cp_fp_yield :: (s: [] CoderPage, act: int, id: string) -> bool {
  fp := s[0].fp[..]; ft := s[0].ft[..];
  if (!fp[0].open && !ft[0].open) || (!fp[0].front && !ft[0].front) || act != CP_REVIEW && act != CP_AGENT { return false; }
  fp[0].front = false; fp[0].expanded = false; ft[0].front = false; ft[0].editor_menu = false; ft[0].crumb_menu = false;
  if act == CP_REVIEW && s[0].review { s[0].pane_tab = CP_TAB_CHANGES; return true; }
  if act == CP_AGENT && s[0].pane_open && s[0].pane_turn == cp_number(id, "t") && s[0].pane_agent == cp_number(id, ".g") { s[0].pane_tab = CP_TAB_AGENT; return true; }
  return false;
}
cp_fp_press :: (s: [] CoderPage, act: int, id: string) -> bool {
  fp := s[0].fp[..]; ft := s[0].ft[..];
  if act == CP_FP_EXPAND {
    if !cp_fp_shown(s) { return false; }
    fp[0].expanded = !fp[0].expanded;
    ft[0].editor_menu = false; ft[0].crumb_menu = false;
    return true;
  }
  if act == CP_FP_HIDE {
    if !fp[0].open && !ft[0].open { return false; }
    cp_ft_tab_save_active(s);
    fp[0].hidden = true;
    fp[0].expanded = false;
    ft[0].editor_menu = false; ft[0].crumb_menu = false;
    if s[0].fld[0].kb == CP_KB_FILE || s[0].fld[0].kb == CP_KB_FT_FILTER { s[0].fld[0].kb = CP_KB_COMPOSER; }
    return true;
  }
  if act == CP_FP_ADD_TAB {
    ft[0].editor_menu = false; ft[0].crumb_menu = false;
    cp_palette_show(s, APP_PAL_ALL);
    cp_palette_set_mode(s, CP_PAL_MODE_FILES);
    s[0].ov[0].pal_cmd = 19;   // host watches palette AND lists workspace files if needed
    s[0].ask = CP_ASK_PALETTE;
    return true;
  }
  if !fp[0].open { return false; }
  if act == CP_FP_CLOSE { ft[0].editor_menu = false; ft[0].crumb_menu = false; s[0].ask = CP_ASK_FILE_CLOSE; return true; }
  if act == CP_FP_SAVE { if !fp[0].dirty { return false; } s[0].ask = CP_ASK_FILE_SAVE; return true; }
  if act == CP_FP_EXTERNAL { ft[0].editor_menu = false; s[0].ask = CP_ASK_FILE_EXTERNAL; return true; }
  if act == CP_FP_RELOAD || act == CP_FP_DISK_RELOAD { ft[0].editor_menu = false; fp[0].disk_changed = false; s[0].ask = CP_ASK_FILE_RELOAD; return true; }
  if act == CP_FP_DISK_KEEP { fp[0].disk_changed = false; return true; }
  if act == CP_FP_WRAP { fp[0].wrap = !fp[0].wrap; fp[0].scroll_x = 0.0f32; cp_ft_tab_save_active(s); return true; }
  if act == CP_FP_COPY_PATH {
    ft[0].editor_menu = false;
    s[0].ask = CP_ASK_FILE_COPY_PATH;
    _ := app_toast_push(s[0].toasts[..], "Copied path", APP_TOAST_PLAIN);
    return true;
  }
  if act == CP_FP_COPY_REL_PATH {
    ft[0].editor_menu = false;
    s[0].ask = CP_ASK_FILE_COPY_REL;
    _ := app_toast_push(s[0].toasts[..], "Copied relative path", APP_TOAST_PLAIN);
    return true;
  }
  if act == CP_FP_COPY_CONTENTS {
    ft[0].editor_menu = false;
    s[0].ask = CP_ASK_FILE_COPY_CONTENT;
    _ := app_toast_push(s[0].toasts[..], "Copied file contents", APP_TOAST_PLAIN);
    return true;
  }
  if act == CP_FP_REVEAL { ft[0].editor_menu = false; s[0].ask = CP_ASK_FILE_REVEAL; return true; }
  if act == CP_FP_GOTO_LINE { ft[0].editor_menu = false; cp_find_file_open(s, true); return true; }
  if act == CP_FP_TOGGLE_EDIT {
    ft[0].editor_menu = false;
    return cp_fp_set_edit(s, fp[0].mode != CP_FP_EDIT);
  }
  if act == CP_FP_MD_PREVIEW {
    ft[0].editor_menu = false;
    if !cp_fp_is_markdown(s) { return false; }
    fp[0].md_preview = !fp[0].md_preview;
    if fp[0].md_preview {
      if fp[0].mode == CP_FP_EDIT { _ = cp_fp_set_edit(s, false); }
      ft[0].preview_n = cp_fp_format_md_preview(cast(string) fp[0].src, ft[0].preview_buf[..]);
      fp[0].wrap = true;
    }
    path := cast(string) fp[0].path[0..<fp[0].path_n];
    cp_fp_build_index(s, cp_fp_view_src(s), ifx fp[0].md_preview then SYN_LANG_PLAIN else cp_fp_lang(path, ft[0].preview_kind));
    return true;
  }
  if act == CP_FP_FOLD_TOGGLE {
    fi := cp_number(id, "coder.fp.fold.");
    return cp_fp_fold_toggle(s, fi);
  }
  if act == CP_FP_LEAN_GOAL { if !cp_flag(s, DC_FLAG_GYM) { return false; } fp[0].lean_goal_busy = true; s[0].ask = CP_ASK_FILE_LEAN_GOAL; return true; }
  return false;
}
// Vertical wheel/trackpad scroll over the file viewer with smooth UiScroll momentum (#13992).
cp_fp_scroll_at :: (s: [] CoderPage, delta: f32, kind: int, time: f64) {
  fp := s[0].fp[..];
  if fp[0].open && fp[0].mode == CP_FP_EDIT && !fp[0].large_edit {
    c := s[0].fld[0].ed[CP_ED_FILE].body[..];
    c[0].follow = false; c[0].scroll += delta;
    most := cast(f32) c[0].lines * composer_line(c) - c[0].view_h;
    if c[0].scroll > most { c[0].scroll = most; }
    if c[0].scroll < 0 { c[0].scroll = 0; }
    return;
  }
  fp[0].scroll = ui_scroll_by(fp[0].scr[..], scroll_clamp(fp[0].scroll, fp[0].content, fp[0].view), delta, fp[0].content, fp[0].view, kind, time, s[0].reduced);
}
cp_fp_scroll :: (s: [] CoderPage, delta: f32) {
  cp_fp_scroll_at(s, delta, UI_SCROLL_WHEEL, s[0].now);
}
// Horizontal scroll over the file viewer when word wrap is off (#13992).
cp_fp_scroll_x :: (s: [] CoderPage, delta: f32) {
  fp := s[0].fp[..];
  if !fp[0].open || fp[0].wrap { return; }
  most := fp[0].content_w - fp[0].body_w;
  if most < 0.0f32 { most = 0.0f32; }
  nx := fp[0].scroll_x + delta;
  if nx < 0.0f32 { nx = 0.0f32; }
  if nx > most { nx = most; }
  fp[0].scroll_x = nx;
}

// ---------------------------------------------------------------- large-file (>16 KB) inline editing

cp_fp_large_sync_dirty :: (s: [] CoderPage) {
  fp := s[0].fp[..];
  dirty := cp_fp_text(s) != cast(string) fp[0].src;
  if dirty { fp[0].saved = false; }
  fp[0].dirty = dirty;
  cp_ft_tab_set_dirty(s, cast(string) fp[0].path[0..<fp[0].path_n], dirty);
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  cp_fp_build_index(s, cp_fp_text(s), cp_fp_lang(path, CP_FT_PREV_NONE));
}

cp_fp_large_insert :: (s: [] CoderPage, ins: string) -> bool {
  fp := s[0].fp[..];
  if !fp[0].open || fp[0].mode != CP_FP_EDIT || !fp[0].large_edit { return false; }
  if ins.count == 0 { return true; }
  if fp[0].text_n + ins.count > CP_FP_EDIT_MOST { return false; }
  pos := fp[0].caret;
  if pos < 0 { pos = 0; }
  if pos > fp[0].text_n { pos = fp[0].text_n; }
  // shift tail right
  i := fp[0].text_n - 1;
  while i >= pos {
    fp[0].text[i + ins.count] = fp[0].text[i];
    i -= 1;
  }
  for k: 0..<ins.count { fp[0].text[pos + k] = ins[k]; }
  fp[0].text_n += ins.count;
  fp[0].caret = pos + ins.count;
  cp_fp_large_sync_dirty(s);
  return true;
}

cp_fp_large_key :: (s: [] CoderPage, key: int, mods: int) -> bool {
  fp := s[0].fp[..];
  if !fp[0].open || fp[0].mode != CP_FP_EDIT || !fp[0].large_edit { return false; }
  pos := fp[0].caret;
  if pos < 0 { pos = 0; }
  if pos > fp[0].text_n { pos = fp[0].text_n; }
  if key == KEY_ENTER && mods == 0 { return cp_fp_large_insert(s, "\n"); }
  if key == -15 && mods == 0 { return cp_fp_large_insert(s, "  "); }
  if key == KEY_BACKSPACE {
    if pos == 0 { return true; }
    del := pos - 1;
    while del > 0 && (fp[0].text[del] & 0xC0) == 0x80 { del -= 1; }
    span := pos - del;
    for i: pos..<fp[0].text_n { fp[0].text[i - span] = fp[0].text[i]; }
    fp[0].text_n -= span;
    fp[0].caret = del;
    cp_fp_large_sync_dirty(s);
    return true;
  }
  if key == KEY_DELETE {
    if pos >= fp[0].text_n { return true; }
    end := pos + 1;
    while end < fp[0].text_n && (fp[0].text[end] & 0xC0) == 0x80 { end += 1; }
    span := end - pos;
    for i: end..<fp[0].text_n { fp[0].text[i - span] = fp[0].text[i]; }
    fp[0].text_n -= span;
    cp_fp_large_sync_dirty(s);
    return true;
  }
  if key == KEY_LEFT {
    if (mods & MOD_CMD) != 0 {
      while pos > 0 && fp[0].text[pos - 1] != '\n' { pos -= 1; }
      fp[0].caret = pos; return true;
    }
    if pos > 0 { pos -= 1; while pos > 0 && (fp[0].text[pos] & 0xC0) == 0x80 { pos -= 1; } }
    fp[0].caret = pos; return true;
  }
  if key == KEY_RIGHT {
    if (mods & MOD_CMD) != 0 {
      while pos < fp[0].text_n && fp[0].text[pos] != '\n' { pos += 1; }
      fp[0].caret = pos; return true;
    }
    if pos < fp[0].text_n { pos += 1; while pos < fp[0].text_n && (fp[0].text[pos] & 0xC0) == 0x80 { pos += 1; } }
    fp[0].caret = pos; return true;
  }
  if key == KEY_UP || key == KEY_DOWN {
    ls := pos; while ls > 0 && fp[0].text[ls - 1] != '\n' { ls -= 1; }
    col := pos - ls;
    if key == KEY_UP {
      if ls == 0 { fp[0].caret = 0; return true; }
      pe := ls - 1;
      ps := pe; while ps > 0 && fp[0].text[ps - 1] != '\n' { ps -= 1; }
      plen := pe - ps;
      fp[0].caret = ps + (ifx col < plen then col else plen);
    } else {
      le := pos; while le < fp[0].text_n && fp[0].text[le] != '\n' { le += 1; }
      if le >= fp[0].text_n { fp[0].caret = fp[0].text_n; return true; }
      ns := le + 1;
      ne := ns; while ne < fp[0].text_n && fp[0].text[ne] != '\n' { ne += 1; }
      nlen := ne - ns;
      fp[0].caret = ns + (ifx col < nlen then col else nlen);
    }
    return true;
  }
  return false;
}

cp_fp_large_pointer :: (s: [] CoderPage, x: f32, y: f32, phase: int) -> bool {
  fp := s[0].fp[..];
  if phase != 0 || !cp_fp_editing(s) || !fp[0].large_edit { return false; }
  if !(fp[0].body_w > 0 && fp[0].body_h > 0) { return false; }
  if x < fp[0].body_x || x >= fp[0].body_x + fp[0].body_w || y < fp[0].body_y || y >= fp[0].body_y + fp[0].body_h { return false; }
  cp_ed_focus(s, CP_KB_FILE);
  k := cp_skin();
  lh := ifx k.mono.line > 0 then k.mono.line else 18.0f32;
  cell := ifx fp[0].cell_w > 0 then fp[0].cell_w else 8.0f32;
  if !(cell > 0) { cell = 8.0f32; }
  target_ln := cast(int) ((y - fp[0].body_y + fp[0].scroll) / lh);
  if target_ln < 0 { target_ln = 0; }
  target_col := cast(int) ((x - fp[0].body_x) / cell);
  if target_col < 0 { target_col = 0; }
  t := cp_fp_text(s);
  at := 0; ln := 0;
  while at < t.count && ln < target_ln {
    if t[at] == '\n' { ln += 1; }
    at += 1;
  }
  c := 0;
  while at < t.count && t[at] != '\n' && c < target_col {
    at += 1;
    while at < t.count && (t[at] & 0xC0) == 0x80 { at += 1; }
    c += 1;
  }
  fp[0].caret = at;
  return true;
}

// ---------------------------------------------------------------- language badge & multi-language syntax

// Draws a compact colored language monogram or file icon (16pt wide) for tabs & breadcrumbs (#13992).
cp_fp_lang_badge :: (f: [] UiFrame, path: string, x: f32, y: f32, box_h: f32) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  slot := 16.0f32;
  tag := "";
  col := k.muted;
  if cp_ft_ends_ci(path, ".rs") {
    ic := 13.0f32;
    sheet_icon(sh, ICON_RUST, x + (slot - ic) / 2.0f32, y + (box_h - ic) / 2.0f32, ic, hex(0xdea584, 1));
    return slot;
  }
  if cp_ft_ends_ci(path, ".png") || cp_ft_ends_ci(path, ".jpg") || cp_ft_ends_ci(path, ".jpeg") ||
     cp_ft_ends_ci(path, ".webp") || cp_ft_ends_ci(path, ".gif") {
    ic := 13.0f32;
    sheet_icon(sh, ICON_GALLERY, x + (slot - ic) / 2.0f32, y + (box_h - ic) / 2.0f32, ic, hex(0xc586c0, 1));
    return slot;
  }
  if cp_ft_ends_ci(path, ".c") { tag = "c"; col = hex(0x569cd6, 1); }
  else if cp_ft_ends_ci(path, ".h") || cp_ft_ends_ci(path, ".hpp") || cp_ft_ends_ci(path, ".hh") { tag = "h"; col = hex(0xc586c0, 1); }
  else if cp_ft_ends_ci(path, ".cpp") || cp_ft_ends_ci(path, ".cc") || cp_ft_ends_ci(path, ".cxx") { tag = "c+"; col = hex(0x569cd6, 1); }
  else if cp_ft_ends_ci(path, ".m") || cp_ft_ends_ci(path, ".mm") { tag = "m"; col = hex(0x569cd6, 1); }
  else if cp_ft_ends_ci(path, ".metal") || cp_ft_ends_ci(path, ".cu") || cp_ft_ends_ci(path, ".cuh") { tag = "mt"; col = hex(0xe37933, 1); }
  else if cp_ft_ends_ci(path, ".coax") { tag = "cx"; col = hex(0x74cfd1, 1); }
  else if cp_ft_ends_ci(path, ".swift") { tag = "sw"; col = hex(0xf05138, 1); }
  else if cp_ft_ends_ci(path, ".py") || cp_ft_ends_ci(path, ".pyi") { tag = "py"; col = hex(0xffd43b, 1); }
  else if cp_ft_ends_ci(path, ".ts") || cp_ft_ends_ci(path, ".tsx") { tag = "ts"; col = hex(0x3178c6, 1); }
  else if cp_ft_ends_ci(path, ".js") || cp_ft_ends_ci(path, ".jsx") || cp_ft_ends_ci(path, ".mjs") || cp_ft_ends_ci(path, ".cjs") { tag = "js"; col = hex(0xf7df1e, 1); }
  else if cp_ft_ends_ci(path, ".json") || cp_ft_ends_ci(path, ".jsonc") { tag = "{}"; col = hex(0xcbcb41, 1); }
  else if cp_ft_ends_ci(path, ".md") || cp_ft_ends_ci(path, ".markdown") { tag = "md"; col = hex(0x569cd6, 1); }
  else if cp_ft_ends_ci(path, ".sh") || cp_ft_ends_ci(path, ".bash") || cp_ft_ends_ci(path, ".zsh") { tag = "$"; col = hex(0x89e051, 1); }
  else if cp_ft_ends_ci(path, ".lean") { tag = "ln"; col = hex(0x74cfd1, 1); }
  else if cp_ft_ends_ci(path, ".csv") || cp_ft_ends_ci(path, ".tsv") { tag = "tb"; col = hex(0x89e051, 1); }
  else if cp_ft_ends_ci(path, ".ipynb") { tag = "nb"; col = hex(0xf37626, 1); }

  if tag.count > 0 {
    tw := measure_width(m, k.mono_tiny.face, tag);
    _ := sheet_text(sh, m, -1, x + (slot - tw) / 2.0f32, y + (box_h - k.mono_tiny.line) / 2.0f32, k.mono_tiny.line, k.mono_tiny.face, col, tag);
    return slot;
  }
  ic := 13.0f32;
  sheet_icon(sh, ICON_FILE_TEXT, x + (slot - ic) / 2.0f32, y + (box_h - ic) / 2.0f32, ic, k.muted);
  return slot;
}

// How many lines text has (one more than its newlines).
cp_fp_lines :: (text: string) -> int { n := 1; for c: text { if c == '\n' { n += 1; } } return n; }

// Line number n right-aligned to `right` on the row at y, in the gutter's face; the caret's line in the ink.
cp_fp_number :: (f: [] UiFrame, n: int, right: f32, y: f32, line: f32, lit: bool) {
  k := f[0].skin; sh := f[0].sheet;
  b: [16] u8; t := sheet_pool(sh, cast(string) b[0..<text_put_int(b[..], 0, n)]);
  w := measure_width(f[0].m, k.mono_tiny.face, t);
  _ := sheet_text(sh, f[0].m, -1, right - w, y, line, k.mono_tiny.face, ifx lit then k.muted else k.faint, t);
}

// Paints one line of source code using multi-language components/core/syntax.coax roles + uiskin_syntax palette,
// carrying SYN_BLK_* multi-line comment/docstring state. Always records a SheetLine for CP_SEL_FILE selection.
cp_fp_syntax_line_state :: (f: [] UiFrame, lang: int, blk: [] u8, x: f32, y: f32, lh: f32, face: int, plain: Rgba, code: string, hard: bool, out_pen: [] f32) -> int {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  ln := sheet_line(sh, x, y, lh, hard);
  if code.count == 0 {
    if out_pen.count > 0 { out_pen[0] = x; }
    return 0;
  }
  runs: [96] MdRun;
  st: [1] int; st[0] = cast(int) blk[0];
  nr := syn_tokenize_line_state(lang, code, st[..], runs[..]);
  blk[0] = cast(u8) st[0];
  pen := x; i := 0;
  for r: 0..<nr {
    if runs[r].from > i { pen += sheet_text(sh, m, ln, pen, y, lh, face, plain, cast(string) code[i..<runs[r].from]); }
    pen += sheet_text(sh, m, ln, pen, y, lh, face, uiskin_syntax(k, runs[r].style, plain), cast(string) code[runs[r].from..<runs[r].to]);
    i = runs[r].to;
  }
  if i < code.count { pen += sheet_text(sh, m, ln, pen, y, lh, face, plain, cast(string) code[i..<code.count]); }
  if out_pen.count > 0 { out_pen[0] = pen; }
  return nr;
}

// Backward-compatible bool-block wrapper used by cp_fp_edit_view & tests.
cp_fp_syntax_line_lang :: (f: [] UiFrame, lang: int, in_block: [] bool, x: f32, y: f32, lh: f32, face: int, plain: Rgba, code: string) -> int {
  blk: [1] u8;
  if in_block.count > 0 && in_block[0] { blk[0] = SYN_BLK_COMMENT; }
  pen: [1] f32;
  nr := cp_fp_syntax_line_state(f, lang, blk[..], x, y, lh, face, plain, code, true, pen[..]);
  if in_block.count > 0 { in_block[0] = (blk[0] != SYN_BLK_NONE); }
  return nr;
}

// Backward-compatible wrapper (defaults to Rust tokenizer) for callers/checks without path context.
cp_fp_syntax_line :: (f: [] UiFrame, x: f32, y: f32, lh: f32, face: int, plain: Rgba, code: string) -> int {
  blk: [1] bool;
  return cp_fp_syntax_line_lang(f, SYN_LANG_RUST, blk[..], x, y, lh, face, plain, code);
}

// Paints a plain-text code line recording a SheetLine so CP_SEL_FILE selection works in plain text & previews too.
cp_fp_plain_line :: (f: [] UiFrame, x: f32, y: f32, lh: f32, face: int, plain: Rgba, code: string, hard: bool, out_pen: [] f32) {
  sh := f[0].sheet; m := f[0].m;
  ln := sheet_line(sh, x, y, lh, hard);
  pen := x;
  if code.count > 0 { pen += sheet_text(sh, m, ln, x, y, lh, face, plain, code); }
  if out_pen.count > 0 { out_pen[0] = pen; }
}

// Records the 1-based source line number of the SheetLine just created for Copy with Path:Line (#13992).
cp_fp_sel_track_line :: (fp: [] CpFilePane, line1: int) {
  if fp[0].sel_line_n < CP_FP_SEL_LINES {
    fp[0].sel_line_map[fp[0].sel_line_n] = line1;
    fp[0].sel_line_n += 1;
  }
}

// Highlights visible in-file Find matches on a rendered source segment (#13992).
cp_fp_draw_find_hits :: (s: [] CoderPage, f: [] UiFrame, seg_at: int, seg: string, x: f32, y: f32, lh: f32, face: int) {
  fd := s[0].find[..];
  if !fd[0].open || !fd[0].file_mode || fd[0].goto_mode || fd[0].nfile_hits <= 0 { return; }
  qlen := fd[0].query_n;
  if qlen <= 0 || seg.count < qlen { return; }
  seg_end := seg_at + seg.count;
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  for hi: 0..<fd[0].nfile_hits {
    hp := fd[0].file_hits[hi];
    if hp >= seg_end { break; }
    if hp + qlen <= seg_at { continue; }
    loc0 := ifx hp > seg_at then hp - seg_at else 0;
    loc1 := ifx hp + qlen < seg_end then (hp + qlen) - seg_at else seg.count;
    if loc1 <= loc0 { continue; }
    hx0 := x + measure_width(m, face, cast(string) seg[0..<loc0]);
    hw := measure_width(m, face, cast(string) seg[loc0..<loc1]);
    col := ifx hi == fd[0].cur then opacity(k.warning, 0.45f32) else opacity(k.warning, 0.20f32);
    sheet_fill(sh, hx0, y + 1.0f32, hw, lh - 2.0f32, 2.0f32, col);
  }
}

// Draws a clickable ▾ / ▸ structural fold chevron in the fold lane (#13992).
cp_fp_draw_fold_chevron :: (s: [] CoderPage, f: [] UiFrame, fi: int, x: f32, y: f32, lh: f32) {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m; fp := s[0].fp[..];
  closed := cp_fp_fold_is_closed(fp, fi);
  fb: [32] u8;
  fid := sheet_pool(sh, cast(string) fb[0..<el_put_i(fb[..], el_put(fb[..], 0, "coder.fp.fold."), fi)]);
  hov := uiframe_hovered(f, fid);
  ch := ifx closed then "▸" else "▾";
  col := ifx closed || hov then k.ink else k.faint;
  _ := sheet_text(sh, m, -1, x + 2.0f32, y, lh, k.mono_tiny.face, col, ch);
  row := uiframe_semantic(f, fid, EL_BUTTON, ifx closed then "Expand fold" else "Collapse fold", x, y, CP_FP_FOLD_W, lh, 0, CP_FP_FOLD_TOGGLE);
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, CP_FP_FOLD_W, lh);
}

// Language for a file path in the viewer (SYN_LANG_PLAIN disables highlighting for previews / .txt / .log).
cp_fp_lang :: (path: string, preview_kind: int) -> int {
  if preview_kind != CP_FT_PREV_NONE { return SYN_LANG_PLAIN; }
  return syn_lang_for_path(path);
}

// ---------------------------------------------------------------- unified Row 1 tab bar & Row 2 breadcrumb bar (#13992)

// Draws one tab pill in Row 1 (rounded capsule, colored language badge, filename, preview indicator, dirty dot, × close).
cp_fp_draw_tab_pill :: (f: [] UiFrame, x: f32, y: f32, h: f32, max_w: f32, path: string, label: string, dirty: bool, pinned: bool, active: bool, tab_id: string, tab_act: int, close_id: string, close_act: int) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  nb: [128] u8;
  nn := el_put(nb[..], 0, label);
  if dirty { nn = el_put(nb[..], nn, " •"); }
  shown := sheet_pool(sh, cast(string) nb[0..<nn]);
  badge_w := 16.0f32;
  close_slot := 18.0f32;
  tw := measure_width(m, k.tool.face, shown);
  if tw > 148.0f32 { tw = 148.0f32; }
  w := 8.0f32 + badge_w + 5.0f32 + tw + 4.0f32 + close_slot + 4.0f32;
  if w > max_w { w = max_w; }
  if w < 52.0f32 { return 0.0f32; }

  hov_tab := uiframe_hovered(f, tab_id);
  hov_x := uiframe_hovered(f, close_id);
  if active {
    sheet_fill(sh, x, y, w, h, 8.0f32, ifx k.set.selected.a > 0 then k.set.selected else k.hover);
  } else if hov_tab || hov_x {
    sheet_fill(sh, x, y, w, h, 8.0f32, k.hover);
  }

  _ := cp_fp_lang_badge(f, path, x + 7.0f32, y, h);
  lx := x + 7.0f32 + badge_w + 5.0f32;
  text_max := x + w - close_slot - 6.0f32 - lx;
  if text_max > 8.0f32 {
    fit := app_fit(f, k.tool.face, shown, text_max);
    // Transient preview tabs use a softer muted tint until pinned by double-click/edit/explicit open
    ink := ifx !pinned then (ifx active then opacity(k.ink, 0.78f32) else k.faint) else (ifx active || hov_tab then k.ink else k.muted);
    _ := sheet_text(sh, m, -1, lx, y + (h - k.tool.line) / 2.0f32, k.tool.line, k.tool.face, ink, fit);
    if !pinned && active {
      sheet_fill(sh, lx, y + h - 3.0f32, measure_width(m, k.tool.face, fit), 1.0f32, 0, opacity(k.muted, 0.45f32));
    }
  }
  tab_row := uiframe_semantic(f, tab_id, EL_TAB, label, x, y, w - close_slot - 2.0f32, h, ifx active then EL_S_CURRENT else 0, ifx active then 0 else tab_act);
  sheet_hit(sh, UIFRAME_HIT, tab_row, 0, x, y, w - close_slot - 2.0f32, h);

  // Close × slot (always drawn on active tab, or on hover for inactive tabs; hit target always active)
  cx := x + w - close_slot - 4.0f32;
  cy := y + (h - close_slot) / 2.0f32;
  if active || hov_tab || hov_x {
    if hov_x { sheet_fill(sh, cx, cy, close_slot, close_slot, 4.0f32, k.hover); }
    ic := 11.0f32;
    sheet_icon(sh, ICON_CLOSE, cx + (close_slot - ic) / 2.0f32, cy + (close_slot - ic) / 2.0f32, ic, ifx hov_x then k.ink else k.muted);
  }
  xrow := uiframe_semantic(f, close_id, EL_BUTTON, "Close", cx, cy, close_slot, close_slot, 0, close_act);
  sheet_hit(sh, UIFRAME_HIT, xrow, 0, cx, cy, close_slot, close_slot);
  return w;
}

// Row 1 (38pt): Unified horizontal tab strip (with overflow chevrons) + '+' quick-open + Expand (⛶) and Hide (◫).
cp_fp_draw_bar1 :: (s: [] CoderPage, f: [] UiFrame, px: f32, top: f32, pw: f32) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m; fp := s[0].fp[..]; ft := s[0].ft[..];
  bh := CP_FP_BAR1_H;
  sheet_fill(sh, px, top + bh - k.border, pw, k.border, 0, k.menu_divider);

  // Reset per-tab hit rects before drawing
  for i: 0..<CP_FT_TABS { ft[0].tabs[i].rw = 0.0f32; }

  side := k.app.icon_button;
  by := top + (bh - side) / 2.0f32;
  hide_x := px + pw - CP_CORNER - side;
  exp_x := hide_x - 4.0f32 - side;

  _ := app_icon_button(f, "coder.file.expand", exp_x, by, ifx fp[0].expanded then ICON_COLLAPSE else ICON_SIM_FIT,
                       ifx fp[0].expanded then "Restore split view" else "Expand file pane", APP_BUTTON_QUIET,
                       ifx fp[0].expanded then EL_S_CURRENT else 0, CP_FP_EXPAND);
  _ := app_icon_button(f, "coder.file.hide", hide_x, by, ICON_SIDEBAR_RIGHT, "Hide file pane", APP_BUTTON_QUIET, 0, CP_FP_HIDE);

  cx := px + 8.0f32;
  tabs_end := exp_x - 8.0f32;
  add_w := 26.0f32;
  ov_w := 20.0f32;
  tab_h := 28.0f32;
  ty := top + (bh - tab_h) / 2.0f32;

  if !fp[0].open {
    w := app_pane_tab(f, cx, ty, ICON_FOLDER, "Files", "coder.ft.close", CP_FT_CLOSE, 1.0f32);
    cx += w + 4.0f32;
  } else if ft[0].ntabs <= 1 {
    p := cast(string) fp[0].path[0..<fp[0].path_n];
    avail := tabs_end - cx - add_w - 4.0f32;
    if avail < 64.0f32 { avail = tabs_end - cx; }
    pinned := ifx ft[0].ntabs == 1 then ft[0].tabs[0].pinned else true;
    w := cp_fp_draw_tab_pill(f, cx, ty, tab_h, avail, p, cp_fp_name(s), fp[0].dirty, pinned, true,
                             "coder.file.close.tab", 0, "coder.file.close", CP_FP_CLOSE);
    if ft[0].ntabs == 1 { ft[0].tabs[0].rx = cx; ft[0].tabs[0].ry = ty; ft[0].tabs[0].rw = w; ft[0].tabs[0].rh = tab_h; }
    cx += w + 4.0f32;
  } else {
    if ft[0].tab_scroll < 0 { ft[0].tab_scroll = 0; }
    if ft[0].tab_scroll >= ft[0].ntabs { ft[0].tab_scroll = ft[0].ntabs - 1; }
    if ft[0].tab_scroll > 0 {
      pr := uiframe_semantic(f, "coder.ft.tab.prev", EL_BUTTON, "Previous tabs", cx, ty, ov_w, tab_h, 0, CP_FT_TAB_PREV);
      sheet_hit(sh, UIFRAME_HIT, pr, 0, cx, ty, ov_w, tab_h);
      _ := sheet_text(sh, m, -1, cx + 6.0f32, ty + (tab_h - k.small.line) / 2.0f32, k.small.line, k.small.face, k.muted, "‹");
      cx += ov_w + 2.0f32;
    }
    overflowed := false;
    for i: ft[0].tab_scroll..<ft[0].ntabs {
      reserve := add_w + 4.0f32 + (ifx i + 1 < ft[0].ntabs then ov_w + 2.0f32 else 0.0f32);
      rem := tabs_end - cx - reserve;
      if rem < 56.0f32 { overflowed = true; break; }
      tp := cp_ft_tab_path(s, i);
      tn := cp_ft_tab_name(s, i);
      ib: [32] u8;
      tid := sheet_pool(sh, cast(string) ib[0..<el_put_i(ib[..], el_put(ib[..], 0, "coder.ft.tab."), i)]);
      xb: [32] u8;
      xid := sheet_pool(sh, cast(string) xb[0..<el_put_i(xb[..], el_put(xb[..], 0, "coder.ft.tabx."), i)]);
      active := i == ft[0].active_tab;
      w := cp_fp_draw_tab_pill(f, cx, ty, tab_h, rem, tp, tn, ft[0].tabs[i].dirty, ft[0].tabs[i].pinned, active,
                               tid, CP_FT_TAB, xid, CP_FT_TAB_CLOSE);
      if w <= 0 { overflowed = true; break; }
      ft[0].tabs[i].rx = cx; ft[0].tabs[i].ry = ty; ft[0].tabs[i].rw = w; ft[0].tabs[i].rh = tab_h;
      cx += w + 4.0f32;
    }
    if overflowed && cx + ov_w <= tabs_end {
      nr := uiframe_semantic(f, "coder.ft.tab.next", EL_BUTTON, "More tabs", cx, ty, ov_w, tab_h, 0, CP_FT_TAB_NEXT);
      sheet_hit(sh, UIFRAME_HIT, nr, 0, cx, ty, ov_w, tab_h);
      _ := sheet_text(sh, m, -1, cx + 6.0f32, ty + (tab_h - k.small.line) / 2.0f32, k.small.line, k.small.face, k.muted, "›");
      cx += ov_w + 2.0f32;
    }
  }

  // '+' Quick-Open button immediately right of the last tab pill
  if cx + add_w <= tabs_end {
    keep := f[0].skin;
    f[0].skin.app.icon_button = add_w; f[0].skin.app.icon_well = add_w;
    _ := app_icon_button(f, "coder.file.add", cx, top + (bh - add_w) / 2.0f32, ICON_PLUS, "Open file…", APP_BUTTON_QUIET, 0, CP_FP_ADD_TAB);
    f[0].skin = keep;
  }

  return top + bh;
}

// Row 2 (30pt): Interactive path breadcrumbs (Users › ... › [icon] file) + inline Save, ⋮ More, ↻ Reload, ≡ Wrap.
cp_fp_draw_bar2 :: (s: [] CoderPage, f: [] UiFrame, fx: f32, y2: f32, fw: f32) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m; fp := s[0].fp[..]; ft := s[0].ft[..];
  bh := CP_FP_BAR2_H;
  sheet_fill(sh, fx, y2 + bh - k.border, fw, k.border, 0, k.menu_divider);
  ft[0].crumb_y = y2 + bh;

  // Compact 24pt action buttons on the right: ≡ Wrap, ↻ Reload, ⋮ More/Editors, plus Save & state when active
  bside := 24.0f32;
  by := y2 + (bh - bside) / 2.0f32;
  wrap_x := fx + fw - CP_CORNER - bside;
  reload_x := wrap_x - 2.0f32 - bside;
  more_x := reload_x - 2.0f32 - bside;
  right := more_x - 6.0f32;

  keep := f[0].skin;
  f[0].skin.app.icon_button = bside; f[0].skin.app.icon_well = bside;
  ft[0].editor_btn_x = more_x; ft[0].editor_btn_y = by;
  _ := app_icon_button(f, "coder.ft.editors", more_x, by, ICON_MORE_V, "File actions", APP_BUTTON_QUIET, ifx ft[0].editor_menu then EL_S_CURRENT else 0, CP_FT_EDITOR_MENU);
  _ := app_icon_button(f, "coder.file.reload", reload_x, by, ICON_RELOAD, "Reload from disk", APP_BUTTON_QUIET, 0, CP_FP_RELOAD);
  _ := app_icon_button(f, "coder.file.wrap", wrap_x, by, ICON_WRAP, ifx fp[0].wrap then "Disable word wrap" else "Enable word wrap", APP_BUTTON_QUIET, ifx fp[0].wrap then EL_S_CURRENT else 0, CP_FP_WRAP);
  f[0].skin = keep;

  if fp[0].mode == CP_FP_EDIT && fp[0].dirty {
    bw := app_button_width(f, -1, "Save");
    right -= bw;
    _ := app_button(f, "coder.file.save", right, y2 + (bh - k.control_h) / 2.0f32, bw, -1, "Save", APP_BUTTON_PRIMARY, 0, CP_FP_SAVE);
    right -= 6.0f32;
  }
  st := cp_fp_state(s);
  if st.count > 0 {
    sw := measure_width(m, k.small.face, st) + 4.0f32;
    if right - sw > fx + 80.0f32 {
      right -= sw;
      _ := app_meta(f, "coder.file.state", right, y2 + (bh - k.small.line) / 2.0f32, sw, st, false);
      right -= 6.0f32;
    }
  }

  // Left side: segmented path breadcrumbs using › chevrons (eliding leftmost directories when narrow)
  full := cast(string) fp[0].path[0..<fp[0].path_n];
  bx := fx + 12.0f32;
  avail := right - bx;
  if avail <= 24.0f32 || full.count == 0 { return y2 + bh; }

  seg_at: [32] int; seg_len: [32] int; nseg := 0;
  p_i := 0;
  while p_i < full.count && nseg < 32 {
    while p_i < full.count && full[p_i] == '/' { p_i += 1; }
    end := p_i;
    while end < full.count && full[end] != '/' { end += 1; }
    if end > p_i {
      seg_at[nseg] = p_i; seg_len[nseg] = end - p_i; nseg += 1;
    }
    p_i = end;
  }
  if nseg == 0 { return y2 + bh; }

  sep_w := measure_width(m, k.tool.face, " › ");
  ell_w := measure_width(m, k.tool.face, "… › ");
  badge_w := 16.0f32 + 4.0f32;
  first := nseg - 1;
  need := badge_w + measure_width(m, k.tool.face, cast(string) full[seg_at[first]..<seg_at[first] + seg_len[first]]);
  while first > 0 {
    prev := first - 1;
    pw_seg := measure_width(m, k.tool.face, cast(string) full[seg_at[prev]..<seg_at[prev] + seg_len[prev]]) + sep_w;
    prefix_w := ifx prev > 0 then ell_w else 0.0f32;
    if need + pw_seg + prefix_w <= avail {
      need += pw_seg;
      first = prev;
    } else {
      break;
    }
  }

  cx := bx;
  ty := y2 + (bh - k.tool.line) / 2.0f32;
  if first > 0 {
    cx += sheet_text(sh, m, -1, cx, ty, k.tool.line, k.tool.face, k.faint, "…");
    cx += sheet_text(sh, m, -1, cx, ty, k.tool.line, k.tool.face, k.faint, " › ");
  }
  for si: first..<(nseg - 1) {
    seg := cast(string) full[seg_at[si]..<seg_at[si] + seg_len[si]];
    cb: [32] u8;
    cid := sheet_pool(sh, cast(string) cb[0..<el_put_i(cb[..], el_put(cb[..], 0, "coder.ft.crumb."), si)]);
    sw := measure_width(m, k.tool.face, seg);
    hov := uiframe_hovered(f, cid);
    ft[0].crumb_seg_x[si] = cx;
    _ := sheet_text(sh, m, -1, cx, ty, k.tool.line, k.tool.face, ifx hov then k.ink else k.muted, seg);
    row := uiframe_semantic(f, cid, EL_BUTTON, seg, cx, y2 + 2, sw, bh - 4, 0, CP_FT_CRUMB_DIR);
    sheet_hit(sh, UIFRAME_HIT, row, 0, cx, y2 + 2, sw, bh - 4);
    cx += sw;
    cx += sheet_text(sh, m, -1, cx, ty, k.tool.line, k.tool.face, k.faint, " › ");
  }
  // Final segment: colored language badge + filename (carries full path under "coder.file.path" & copies on click)
  fname := cast(string) full[seg_at[nseg - 1]..<seg_at[nseg - 1] + seg_len[nseg - 1]];
  _ := cp_fp_lang_badge(f, full, cx, y2, bh);
  fx_name := cx + 16.0f32 + 4.0f32;
  rem_name := right - fx_name;
  if rem_name > 8.0f32 {
    fit := app_fit(f, k.tool.face, fname, rem_name);
    nw := measure_width(m, k.tool.face, fit);
    _ := sheet_text(sh, m, -1, fx_name, ty, k.tool.line, k.tool.face, k.ink, fit);
    prow := uiframe_semantic(f, "coder.file.path", EL_BUTTON, full, cx, y2 + 2, (fx_name - cx) + nw, bh - 4, 0, CP_FP_COPY_PATH);
    sheet_hit(sh, UIFRAME_HIT, prow, 0, cx, y2 + 2, (fx_name - cx) + nw, bh - 4);
  }
  return y2 + bh;
}

// Non-destructive inline banner shown when a dirty open file changed on disk (#13992).
cp_fp_draw_disk_banner :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  bh := 32.0f32;
  _ = sheet_box(sh, x, y, w, bh, 6.0f32, k.border, k.sunk, opacity(k.warning, 0.55f32));
  _ := uiframe_semantic(f, "coder.file.disk_banner", EL_REGION, "File changed on disk", x, y, w, bh, 0, 0);
  keep_w := app_button_width(f, -1, "Keep Mine");
  rel_w := app_button_width(f, -1, "Reload");
  kx := x + w - keep_w - 6.0f32;
  rx := kx - rel_w - 6.0f32;
  by := y + (bh - k.control_h) / 2.0f32;
  _ := app_button(f, "coder.file.disk.reload", rx, by, rel_w, -1, "Reload", APP_BUTTON_PRIMARY, 0, CP_FP_DISK_RELOAD);
  _ := app_button(f, "coder.file.disk.keep", kx, by, keep_w, -1, "Keep Mine", APP_BUTTON_QUIET, 0, CP_FP_DISK_KEEP);
  msg_w := rx - (x + 10.0f32) - 6.0f32;
  if msg_w > 40.0f32 {
    _ := sheet_text(sh, m, -1, x + 10.0f32, y + (bh - k.small.line) / 2.0f32, k.small.line, k.small.face, k.warning,
                    app_fit(f, k.small.face, "File changed on disk", msg_w));
  }
  return bh + 6.0f32;
}

// ---------------------------------------------------------------- main pane draw

cp_filepane :: (s: [] CoderPage, f: [] UiFrame, px: f32, pw: f32, h: f32) {
  k := f[0].skin; a := k.app; sh := f[0].sheet; fp := s[0].fp[..]; ft := s[0].ft[..];
  top := ifx px > 0 then 0.0f32 else cp_bar(s);

  // Record color-exempt primitive range so monochrome GPU pass keeps syntax & language badge colors (#13992).
  s[0].fp_color_u0 = sh[0].nu;
  s[0].fp_color_o0 = sh[0].no;

  if px > 0 { cp_side_border_left(s, sh, px, 0, h, k.menu_divider); }

  // Row 1: unified top tab bar (+ quick-open, Expand ⛶, Hide ◫)
  stop := cp_fp_draw_bar1(s, f, px, top, pw);

  // When only the File Explorer tree is open (no file loaded yet): draw tree full-width below Row 1
  if !fp[0].open {
    cp_ft_draw_tree(s, f, px, stop, pw, h - stop);
    s[0].fp_color_u1 = sh[0].nu;
    s[0].fp_color_o1 = sh[0].no;
    cp_ft_draw_editor_menu(s, f);
    return;
  }

  // Optional collapsible File Explorer directory tree column on the left side of the file pane
  fx := px; fw := pw;
  ft[0].tree_w = 0;
  if ft[0].tree_visible && pw >= 420.0f32 {
    tw_col := CP_FT_TREE_W;
    cp_ft_draw_tree(s, f, px, stop, tw_col, h - stop);
    fx = px + tw_col;
    fw = pw - tw_col;
  }

  // Row 2: interactive path breadcrumbs + Save / ⋮ / ↻ / ≡
  y := cp_fp_draw_bar2(s, f, fx, stop, fw) + 6.0f32;
  x := fx + a.gap; cw := fw - 2 * a.gap;
  why := cast(string) fp[0].why[0..<fp[0].why_n];
  if fp[0].mode == CP_FP_FAILED {
    y += app_notice(f, "coder.file.error", x, y, cw, why, APP_NOTICE_ERROR) + a.gap;
    s[0].fp_color_u1 = sh[0].nu;
    s[0].fp_color_o1 = sh[0].no;
    cp_ft_draw_editor_menu(s, f);
    return;
  }
  if fp[0].mode == CP_FP_SCENE {
    sx := fx + k.border; sw := fw - k.border; sh_h := h - y;
    fp[0].body_x = sx; fp[0].body_y = y; fp[0].body_w = ifx sw > 0 then sw else 0.0f32; fp[0].body_h = ifx sh_h > 0 then sh_h else 0.0f32;
    if fp[0].body_w > 0 && fp[0].body_h > 0 {
      _ := uiframe_semantic(f, "coder.file.scene", EL_REGION, cp_fp_name(s), sx, y, fp[0].body_w, fp[0].body_h, 0, 0);
    }
    s[0].fp_color_u1 = sh[0].nu;
    s[0].fp_color_o1 = sh[0].no;
    cp_ft_draw_editor_menu(s, f);
    return;
  }
  if fp[0].save_failed { y += app_notice(f, "coder.file.error", x, y, cw, why, APP_NOTICE_ERROR) + a.gap_small; }
  if fp[0].disk_changed { y += cp_fp_draw_disk_banner(s, f, x, y, cw); }
  pk := ft[0].preview_kind;
  if fp[0].mode == CP_FP_READ {
    if pk != CP_FT_PREV_NONE && !ft[0].preview_raw {
      pmsg := ifx pk == CP_FT_PREV_CSV then "CSV/TSV table preview (read-only)."
              else ifx pk == CP_FT_PREV_IPYNB then "Jupyter notebook cell preview (read-only)."
              else ifx pk == CP_FT_PREV_HEX then "Binary hex dump preview (read-only)."
              else ifx pk == CP_FT_PREV_IMAGE then "Image metadata preview (read-only)."
              else "PDF document metadata preview (read-only).";
      y += app_meta(f, "coder.file.readonly", x, y, cw, pmsg, false) + a.gap_small;
    } else if fp[0].src.count > CP_FP_EDIT_MOST || fp[0].nlines > CP_FP_EDIT_LINES {
      b: [160] u8; n := el_put(b[..], 0, "Coder edits files up to 128 KB and 4096 lines here; this one is ");
      n = el_put_i(b[..], n, (fp[0].size + 1023) / 1024); n = el_put(b[..], n, " KB with ");
      n = el_put_i(b[..], n, ifx fp[0].nlines > 0 then fp[0].nlines else cp_fp_lines(cast(string) fp[0].src));
      n = el_put(b[..], n, " lines.");
      y += app_meta(f, "coder.file.readonly", x, y, cw, sheet_pool(sh, cast(string) b[0..<n]), false) + a.gap_small;
    }
  }
  // Source text to display
  src := cp_fp_view_src(s);
  total_lines := ifx fp[0].nlines > 0 then fp[0].nlines else cp_fp_lines(src);
  digits := 3; d := total_lines; while d >= 1000 { digits += 1; d /= 10; }
  gw := cast(f32) digits * measure_width(f[0].m, k.mono_tiny.face, "0");
  gx := x + gw;
  fold_x := gx + 4.0f32;
  tx := fold_x + CP_FP_FOLD_W + 4.0f32;
  tw := fx + fw - a.gap - tx;
  body := y;
  show_lean_strip := cp_flag(s, DC_FLAG_GYM) && cp_fp_is_lean(s) && (h - body) > CP_FP_LEAN_STRIP_H + 80.0f32;
  bh := h - a.gap_small - body - (ifx show_lean_strip then CP_FP_LEAN_STRIP_H + 6.0f32 else 0.0f32);
  if !(bh > 0) || !(tw > 0) {
    s[0].fp_color_u1 = sh[0].nu;
    s[0].fp_color_o1 = sh[0].no;
    cp_ft_draw_editor_menu(s, f);
    return;
  }
  fp[0].body_x = tx; fp[0].body_y = body; fp[0].body_w = tw; fp[0].body_h = bh;
  _ := uiframe_semantic(f, "coder.file.body", EL_TEXT, cp_fp_name(s), tx, body, tw, bh, 0, 0);
  if fp[0].mode == CP_FP_EDIT {
    if fp[0].large_edit { cp_fp_large_edit_view(s, f, src, fx, gx, tx, body, tw, bh); }
    else { cp_fp_edit_view(s, f, fx, gx, tx, body, tw, bh); }
  } else {
    cp_fp_read_view(s, f, src, fx, gx, fold_x, tx, body, tw, bh);
  }
  if show_lean_strip {
    cp_fp_draw_lean_strip(s, f, fx + a.gap, body + bh + 4.0f32, fw - 2 * a.gap, CP_FP_LEAN_STRIP_H);
  }
  s[0].fp_color_u1 = sh[0].nu;
  s[0].fp_color_o1 = sh[0].no;
  cp_find_file_bar(s, f, fx, body, fw);
  cp_ft_draw_editor_menu(s, f);
}

// Collapsible bottom Lean 4 Goal Strip inside the File Pane whenever a .lean file is open (#13947).
cp_fp_draw_lean_strip :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32, h: f32) {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  fp := s[0].fp[..];
  tone := ifx fp[0].lean_goal_done then k.success else ifx fp[0].lean_goal_ok then k.syntax[4] else k.warning;
  _ := sheet_box(sh, x, y, w, h, 8.0f32, k.border, k.sunk, opacity(tone, 0.55f32));
  sheet_fill(sh, x, y + 8.0f32, 3.0f32, h - 16.0f32, 1.5f32, tone);

  line_no := ifx fp[0].lean_goal_line > 0 then fp[0].lean_goal_line else cp_fp_caret_line(s);
  hb: [96] u8; hn := el_put(hb[..], 0, "LEAN 4 GOAL · Line ");
  hn = el_put_i(hb[..], hn, line_no);
  if rh_contains_ci(cast(string) fp[0].path[0..<fp[0].path_n], "riemann-hypothesis") {
    hn = el_put(hb[..], hn, "  ·  RH Corpus (Tier B Infoview)");
  }
  _ := sheet_text(sh, m, -1, x + 12.0f32, y + 6.0f32, k.small.line, k.small.face, tone, app_fit(f, k.small.face, sheet_pool(sh, cast(string) hb[0..<hn]), w - 126.0f32));

  btn_lbl := ifx fp[0].lean_goal_busy then "Querying..." else "Refresh Goal";
  bw := measure_width(m, k.small.face, btn_lbl) + 16.0f32;
  if w > bw + 140.0f32 {
    _ := cp_lr_pill(f, "coder.file.lean.refresh", x + w - bw - 8.0f32, y + 5.0f32, btn_lbl, fp[0].lean_goal_busy, tone, CP_FP_LEAN_GOAL);
  }

  gtext := ifx fp[0].lean_goal_n > 0 then cast(string) fp[0].lean_goal[0..<fp[0].lean_goal_n]
           else "Click Refresh Goal (or save) to query live $/lean/plainGoal via oa-leanhost";
  _ := sheet_text(sh, m, -1, x + 12.0f32, y + 28.0f32, k.mono_small.line, k.mono_small.face, k.ink, app_fit(f, k.mono_small.face, gtext, w - 24.0f32));
}

// The file in its shared UiEditor (<= 16 KB, <= 512 lines): selection & caret from UiEditor,
// line numbers in the gutter, and multi-language syntax-highlighted runs painted per visible line.
cp_fp_edit_view :: (s: [] CoderPage, f: [] UiFrame, px: f32, gx: f32, tx: f32, body: f32, tw: f32, bh: f32) {
  cp_ed_draw(s, f, CP_ED_FILE, tx, body, tw, bh, "");
  c := s[0].fld[0].ed[CP_ED_FILE].body[..];
  if !(c[0].text_w > 0) { return; }
  k := f[0].skin; fp := s[0].fp[..];
  t := typed(c); lh := composer_line(c); top := c[0].text_y - c[0].scroll;
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  lang := cp_fp_lang(path, CP_FT_PREV_NONE);
  blk: [1] u8;
  lit := -1;
  if c[0].focused { lit = 1; for i: 0..<(ifx c[0].ed[0].caret < t.count then c[0].ed[0].caret else t.count) { if t[i] == '\n' { lit += 1; } } }
  uiframe_clip(f, px, body, tx + tw, body + bh);
  ln := 0; pen: [1] f32;
  for r: 0..<c[0].lines {
    at := c[0].line_at[r]; end := c[0].line_end[r];
    starts := r == 0 || at > 0 && t[at - 1] == '\n';
    if starts { ln += 1; }
    ry := top + cast(f32) r * lh;
    seg := ifx end > at then cast(string) t[at..<end] else "";
    if ry + lh < body {
      if lang != SYN_LANG_PLAIN && seg.count > 0 { cp_fp_advance_blk(lang, seg, blk[..]); }
      continue;
    }
    if ry > body + bh { break; }
    if fp[0].hl_start > 0 && ln >= fp[0].hl_start && ln <= fp[0].hl_end {
      sheet_fill(f[0].sheet, tx - 4.0f32, ry, tw + 4.0f32, lh, 2.0f32, opacity(k.accent, 0.14f32));
    }
    cp_fp_draw_find_hits(s, f, at, seg, tx, ry, lh, k.mono.face);
    if starts { cp_fp_number(f, ln, gx, ry, lh, ln == lit || (fp[0].hl_start > 0 && ln >= fp[0].hl_start && ln <= fp[0].hl_end)); }
    if seg.count > 0 {
      if lang != SYN_LANG_PLAIN { _ = cp_fp_syntax_line_state(f, lang, blk[..], tx, ry, lh, k.mono.face, k.ink, seg, true, pen[..]); }
      else { _ := sheet_text(f[0].sheet, f[0].m, -1, tx, ry, lh, k.mono.face, k.ink, seg); }
    }
  }
  uiframe_unclip(f);
}

// Draws horizontal scroll rail at bottom of viewport when !wrap && content_w > tw (#13992).
cp_fp_draw_hrail :: (f: [] UiFrame, fp: [] CpFilePane, tx: f32, body: f32, tw: f32, bh: f32) {
  if fp[0].wrap || !(fp[0].content_w > tw + 2.0f32) || !(bh > 12.0f32) { return; }
  k := f[0].skin; sh := f[0].sheet;
  max_x := fp[0].content_w - tw;
  if !(max_x > 0) { return; }
  track_w := tw - 12.0f32;
  if !(track_w > 24.0f32) { return; }
  thumb_w := track_w * (tw / fp[0].content_w);
  if thumb_w < 28.0f32 { thumb_w = 28.0f32; }
  if thumb_w > track_w { thumb_w = track_w; }
  frac := fp[0].scroll_x / max_x;
  if frac < 0.0f32 { frac = 0.0f32; }
  if frac > 1.0f32 { frac = 1.0f32; }
  hx := tx + 4.0f32 + frac * (track_w - thumb_w);
  hy := body + bh - 5.0f32;
  sheet_fill(sh, hx, hy, thumb_w, 3.5f32, 1.75f32, opacity(k.muted, 0.45f32));
}

// Large-file (>16 KB or >512 lines, up to 128 KB / 4,096 lines) virtualized O(visible lines) inline editor view
// with horizontal scrolling, CP_SEL_FILE selection, find highlights, and smooth vertical scroll rail (#13992).
cp_fp_large_edit_view :: (s: [] CoderPage, f: [] UiFrame, src: string, px: f32, gx: f32, tx: f32, body: f32, tw: f32, bh: f32) {
  k := f[0].skin; sh := f[0].sheet; fp := s[0].fp[..];
  face := k.mono.face; lh := k.mono.line;
  cell := measure_width(f[0].m, face, "0");
  fp[0].cell_w = cell;
  focused := s[0].fld[0].active && cp_ed_which(s) == CP_ED_FILE;
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  lang := cp_fp_lang(path, CP_FT_PREV_NONE);
  if fp[0].nlines <= 0 { cp_fp_build_index(s, src, lang); }
  nl := fp[0].nlines;
  lit := ifx focused then cp_fp_caret_line(s) else -1;
  fp[0].view = bh;
  fp[0].content = cast(f32) nl * lh;
  fp[0].content_w = cast(f32) fp[0].max_cols * cell + 24.0f32;
  fp[0].scroll = scroll_clamp(fp[0].scroll, fp[0].content, fp[0].view);
  if fp[0].scroll_x > fp[0].content_w - tw { fp[0].scroll_x = ifx fp[0].content_w > tw then fp[0].content_w - tw else 0.0f32; }
  if fp[0].scroll_x < 0.0f32 { fp[0].scroll_x = 0.0f32; }

  first_li := cast(int) (fp[0].scroll / lh);
  if first_li < 0 { first_li = 0; }
  if first_li >= nl { first_li = nl - 1; }
  vis_rows := cast(int) (bh / lh) + 3;
  last_li := first_li + vis_rows;
  if last_li > nl { last_li = nl; }

  blk: [1] u8;
  blk[0] = cp_fp_block_state_at(fp, src, lang, first_li);
  l0 := sh[0].nl;
  fp[0].sel_l0 = l0; fp[0].sel_line_n = 0;
  uiframe_clip(f, px, body, tx + tw, body + bh);
  pen: [1] f32;
  for li: first_li..<last_li {
    ln := li + 1;
    at := fp[0].line_starts[li];
    stop := cp_fp_line_end(fp, src, li);
    seg := ifx stop > at then cast(string) src[at..<stop] else "";
    y := body + cast(f32) li * lh - fp[0].scroll;
    if y + lh <= body || y >= body + bh {
      if lang != SYN_LANG_PLAIN && seg.count > 0 { cp_fp_advance_blk(lang, seg, blk[..]); }
      continue;
    }
    in_hl := fp[0].hl_start > 0 && ln >= fp[0].hl_start && ln <= fp[0].hl_end;
    if in_hl { sheet_fill(sh, tx - 4.0f32, y, tw + 4.0f32, lh, 2.0f32, opacity(k.accent, 0.14f32)); }
    cx0 := tx - fp[0].scroll_x;
    cp_fp_draw_find_hits(s, f, at, seg, cx0, y, lh, face);
    cp_fp_number(f, ln, gx, y, lh, ln == lit || in_hl);
    cp_fp_sel_track_line(fp, ln);
    if lang != SYN_LANG_PLAIN { _ = cp_fp_syntax_line_state(f, lang, blk[..], cx0, y, lh, face, k.ink, seg, true, pen[..]); }
    else { cp_fp_plain_line(f, cx0, y, lh, face, k.ink, seg, true, pen[..]); }
    if focused && fp[0].caret >= at && fp[0].caret <= stop {
      cx := cx0 + measure_width(f[0].m, face, cast(string) src[at..<fp[0].caret]);
      sheet_fill(sh, cx, y + 1, k.cmp.caret, lh - 2, 0, k.accent);
    }
  }
  l1 := sh[0].nl;
  cp_sel_record(s, CP_SEL_FILE, l0, l1, tx, body, tx + tw, body + bh, fp[0].scroll);
  cp_sel_paint(s, f, CP_SEL_FILE, l0, l1, fp[0].scroll);
  cp_fp_draw_hrail(f, fp, tx, body, tw, bh);
  uiframe_unclip(f);
  app_scroll_rail(f, fp[0].scr[..], tx + tw, body, fp[0].scroll, fp[0].content, fp[0].view, bh, s[0].now, s[0].reduced);
}

// Virtualized O(visible lines) read-only file & preview viewer: multi-language syntax color,
// structural code folding (▾/▸ + … N lines pill), target-line highlight, in-file Find highlights,
// CP_SEL_FILE GPU selection, horizontal scroll + Word Wrap toggle, and vertical/horizontal rails (#13992).
cp_fp_read_view :: (s: [] CoderPage, f: [] UiFrame, src: string, px: f32, gx: f32, fold_x: f32, tx: f32, body: f32, tw: f32, bh: f32) {
  k := f[0].skin; sh := f[0].sheet; fp := s[0].fp[..];
  face := k.mono.face; lh := k.mono.line;
  cell := measure_width(f[0].m, face, "0");
  fp[0].cell_w = cell;
  cols := ifx cell > 0 then cast(int) floor(tw / cell) else 80;
  if cols < 1 { cols = 1; }
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  lang := ifx fp[0].md_preview then SYN_LANG_PLAIN else cp_fp_lang(path, s[0].ft[0].preview_kind);
  if fp[0].nlines <= 0 { cp_fp_build_index(s, src, lang); }
  nl := fp[0].nlines;
  wrap_on := fp[0].wrap;
  fp[0].view = bh;
  fp[0].content_w = ifx wrap_on then tw else cast(f32) fp[0].max_cols * cell + 36.0f32;
  if wrap_on { fp[0].scroll_x = 0.0f32; }
  else {
    if fp[0].scroll_x > fp[0].content_w - tw { fp[0].scroll_x = ifx fp[0].content_w > tw then fp[0].content_w - tw else 0.0f32; }
    if fp[0].scroll_x < 0.0f32 { fp[0].scroll_x = 0.0f32; }
  }

  // Fast check whether any fold is currently collapsed
  any_folded := false;
  for k8: 0..<8 { if fp[0].fold_bits[k8] != 0 { any_folded = true; break; } }

  l0 := sh[0].nl;
  fp[0].sel_l0 = l0; fp[0].sel_line_n = 0;
  uiframe_clip(f, px, body, tx + tw, body + bh);
  pen: [1] f32;

  if !wrap_on && !any_folded {
    // Pure O(visible lines) fast path: jump directly to first visible line using line_starts[] + block_cp[]
    fp[0].content = cast(f32) nl * lh;
    fp[0].scroll = scroll_clamp(fp[0].scroll, fp[0].content, fp[0].view);
    first_li := cast(int) (fp[0].scroll / lh);
    if first_li < 0 { first_li = 0; }
    if first_li >= nl { first_li = nl - 1; }
    vis_rows := cast(int) (bh / lh) + 3;
    last_li := first_li + vis_rows;
    if last_li > nl { last_li = nl; }
    blk: [1] u8;
    blk[0] = cp_fp_block_state_at(fp, src, lang, first_li);
    for li: first_li..<last_li {
      ln := li + 1;
      at := fp[0].line_starts[li];
      stop := cp_fp_line_end(fp, src, li);
      seg := ifx stop > at then cast(string) src[at..<stop] else "";
      y := body + cast(f32) li * lh - fp[0].scroll;
      if y + lh <= body || y >= body + bh {
        if lang != SYN_LANG_PLAIN && seg.count > 0 { cp_fp_advance_blk(lang, seg, blk[..]); }
        continue;
      }
      in_hl := fp[0].hl_start > 0 && ln >= fp[0].hl_start && ln <= fp[0].hl_end;
      if in_hl { sheet_fill(sh, tx - 4.0f32, y, tw + 4.0f32, lh, 2.0f32, opacity(k.accent, 0.14f32)); }
      cx0 := tx - fp[0].scroll_x;
      cp_fp_draw_find_hits(s, f, at, seg, cx0, y, lh, face);
      cp_fp_number(f, ln, gx, y, lh, in_hl);
      fi := cp_fp_fold_at_line(fp, ln);
      if fi >= 0 { cp_fp_draw_fold_chevron(s, f, fi, fold_x, y, lh); }
      cp_fp_sel_track_line(fp, ln);
      if lang != SYN_LANG_PLAIN { _ = cp_fp_syntax_line_state(f, lang, blk[..], cx0, y, lh, face, k.ink, seg, true, pen[..]); }
      else { cp_fp_plain_line(f, cx0, y, lh, face, k.ink, seg, true, pen[..]); }
    }
  } else {
    // General indexed path (word wrap and/or collapsed folds): O(nlines) integer skips, O(visible lines) tokenization
    fp[0].scroll = scroll_clamp(fp[0].scroll, fp[0].content, fp[0].view);
    y := body - fp[0].scroll;
    li := 0;
    blk: [1] u8;
    blk_li := -1;
    while li < nl {
      ln := li + 1;
      at := fp[0].line_starts[li];
      stop := cp_fp_line_end(fp, src, li);
      fi := cp_fp_fold_at_line(fp, ln);
      closed := fi >= 0 && cp_fp_fold_is_closed(fp, fi);
      rows := 1;
      if wrap_on && !closed {
        nch := 0; for i: at..<stop { if (src[i] & 0xC0) != 0x80 { nch += 1; } }
        rows = ifx nch == 0 then 1 else (nch + cols - 1) / cols;
      }
      row_h := cast(f32) rows * lh;
      if y + row_h > body && y < body + bh {
        if blk_li != li { blk[0] = cp_fp_block_state_at(fp, src, lang, li); }
        seg := ifx stop > at then cast(string) src[at..<stop] else "";
        in_hl := fp[0].hl_start > 0 && ln >= fp[0].hl_start && ln <= fp[0].hl_end;
        if in_hl { sheet_fill(sh, tx - 4.0f32, y, tw + 4.0f32, row_h, 2.0f32, opacity(k.accent, 0.14f32)); }
        cp_fp_number(f, ln, gx, y, lh, in_hl);
        if fi >= 0 { cp_fp_draw_fold_chevron(s, f, fi, fold_x, y, lh); }
        if !wrap_on || closed {
          cx0 := tx - fp[0].scroll_x;
          cp_fp_draw_find_hits(s, f, at, seg, cx0, y, lh, face);
          cp_fp_sel_track_line(fp, ln);
          if lang != SYN_LANG_PLAIN { _ = cp_fp_syntax_line_state(f, lang, blk[..], cx0, y, lh, face, k.ink, seg, true, pen[..]); }
          else { cp_fp_plain_line(f, cx0, y, lh, face, k.ink, seg, true, pen[..]); }
          if closed {
            hidden_n := fp[0].folds[fi].end_line - fp[0].folds[fi].start_line;
            pb: [32] u8; pn := el_put(pb[..], 0, " … (");
            pn = el_put_i(pb[..], pn, hidden_n);
            pn = el_put(pb[..], pn, " lines) ");
            pill := sheet_pool(sh, cast(string) pb[0..<pn]);
            pw_pill := measure_width(f[0].m, k.mono_tiny.face, pill);
            px_pill := pen[0] + 6.0f32;
            sheet_fill(sh, px_pill, y + 2.0f32, pw_pill, lh - 4.0f32, 4.0f32, k.hover);
            _ := sheet_text(sh, f[0].m, -1, px_pill, y, lh, k.mono_tiny.face, k.muted, pill);
          }
        } else {
          i := at;
          for r: 0..<rows {
            j := i; mc := 0; while j < stop && mc < cols { j += 1; while j < stop && (src[j] & 0xC0) == 0x80 { j += 1; } mc += 1; }
            ry := y + cast(f32) r * lh;
            if ry + lh > body && ry < body + bh {
              part := ifx j > i then cast(string) src[i..<j] else "";
              cp_fp_draw_find_hits(s, f, i, part, tx, ry, lh, face);
              cp_fp_sel_track_line(fp, ln);
              if lang != SYN_LANG_PLAIN { _ = cp_fp_syntax_line_state(f, lang, blk[..], tx, ry, lh, face, k.ink, part, r + 1 == rows, pen[..]); }
              else { cp_fp_plain_line(f, tx, ry, lh, face, k.ink, part, r + 1 == rows, pen[..]); }
            }
            i = j;
          }
        }
        blk_li = li + 1;
      }
      y += row_h;
      if closed {
        li = fp[0].folds[fi].end_line;   // end_line is 1-based inclusive -> next 0-based index is end_line
        blk_li = -1;
      } else {
        li += 1;
      }
    }
    fp[0].content = y + fp[0].scroll - body;
  }

  l1 := sh[0].nl;
  cp_sel_record(s, CP_SEL_FILE, l0, l1, tx, body, tx + tw, body + bh, fp[0].scroll);
  cp_sel_paint(s, f, CP_SEL_FILE, l0, l1, fp[0].scroll);
  cp_fp_draw_hrail(f, fp, tx, body, tw, bh);
  uiframe_unclip(f);
  app_scroll_rail(f, fp[0].scr[..], tx + tw, body, fp[0].scroll, fp[0].content, fp[0].view, bh, s[0].now, s[0].reduced);
}

// ---------------------------------------------------------------- the host's calls

// The bytes the pane shows at most: the host does not read a longer file (4 MB).
coder_page_file_most :: () -> int #export_c #effects(all) { return CP_FP_MOST; }
// The bytes the pane edits inline at most (128 KB).
coder_page_file_edit_most :: () -> int #export_c #effects(all) { return CP_FP_EDIT_MOST; }
// Current 1-based caret or highlighted line in the open file.
coder_page_file_line :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then cp_fp_caret_line(s) else 1; }
// Whether the file viewer pane is currently expanded (⛶) or hidden (◫).
coder_page_file_expanded :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].fp[0].expanded; }
coder_page_file_hidden :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].fp[0].hidden; }
coder_page_file_toggle_expand :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_fp_press(s, CP_FP_EXPAND, ""); }
coder_page_file_toggle_hide :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return cp_ft_press(s, CP_FT_TOGGLE, "");
}
coder_page_file_set_edit :: (s: [] CoderPage, on: bool) -> bool #export_c #effects(all) { return s.count > 0 && cp_fp_set_edit(s, on); }
coder_page_file_jump :: (s: [] CoderPage, start_line: int, end_line: int) #export_c #effects(all) {
  if s.count > 0 { cp_fp_jump(s, start_line, end_line); }
}
coder_page_file_set_preview_next :: (s: [] CoderPage, preview: bool) #export_c #effects(all) {
  if s.count > 0 { s[0].ft[0].open_as_preview = preview; }
}

// A file the host read: opens Viewer-first (CP_FP_READ) by default without stealing composer focus;
// preserves & restores per-tab scroll, wrap, edit mode, and fold state across tab switches (#13992).
coder_page_file_open :: (s: [] CoderPage, path: string, bytes: [] u8, size: int) -> bool #export_c #effects(all) {
  if s.count < 1 || bytes.count > CP_FP_MOST { return false; }
  if !s[0].ready { cp_init(s); }
  cp_ft_tab_save_active(s);
  prev_tab := cp_ft_tab_find(s, path);
  has_saved := prev_tab >= 0;
  saved_sy := ifx has_saved then s[0].ft[0].tabs[prev_tab].scroll_y else 0.0f32;
  saved_sx := ifx has_saved then s[0].ft[0].tabs[prev_tab].scroll_x else 0.0f32;
  saved_wrap_set := ifx has_saved then s[0].ft[0].tabs[prev_tab].wrap_set else false;
  saved_wrap := ifx has_saved then s[0].ft[0].tabs[prev_tab].wrap else false;
  saved_edit := ifx has_saved then s[0].ft[0].tabs[prev_tab].edit_mode else false;
  saved_folds: [8] u64;
  if has_saved { for k: 0..<8 { saved_folds[k] = s[0].ft[0].tabs[prev_tab].fold_bits[k]; } }

  cp_fp_begin(s, path);
  fp := s[0].fp[..];
  fp[0].src = bytes; fp[0].size = size;
  fp[0].scroll = saved_sy;
  fp[0].scroll_x = saved_sx;
  for k: 0..<8 { fp[0].fold_bits[k] = saved_folds[k]; }
  _ = cp_ft_tab_open(s, path);
  pk := cp_ft_prepare_preview(s, path, bytes, size);
  if pk != CP_FT_PREV_NONE {
    fp[0].mode = CP_FP_READ;
    fp[0].wrap = ifx saved_wrap_set then saved_wrap else true;
    cp_fp_build_index(s, cp_fp_view_src(s), SYN_LANG_PLAIN);
    return true;
  }
  fp[0].mode = CP_FP_READ;
  fp[0].wrap = ifx saved_wrap_set then saved_wrap else (syn_lang_for_path(path) == SYN_LANG_PLAIN);
  cp_fp_build_index(s, cast(string) bytes, cp_fp_lang(path, CP_FT_PREV_NONE));
  if saved_edit { _ = cp_fp_set_edit(s, true); }
  return true;
}

// Live reload of the active file from disk preserving scroll offset, horizontal scroll, folds, and target highlight (#13992).
coder_page_file_reload :: (s: [] CoderPage, bytes: [] u8, size: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open || bytes.count > CP_FP_MOST { return false; }
  fp := s[0].fp[..]; ft := s[0].ft[..];
  path := cast(string) fp[0].path[0..<fp[0].path_n];
  was_edit := fp[0].mode == CP_FP_EDIT;
  keep_sy := fp[0].scroll; keep_sx := fp[0].scroll_x;
  keep_hl0 := fp[0].hl_start; keep_hl1 := fp[0].hl_end;
  keep_folds: [8] u64;
  for k: 0..<8 { keep_folds[k] = fp[0].fold_bits[k]; }

  fp[0].src = bytes; fp[0].size = size;
  fp[0].dirty = false; fp[0].saved = false; fp[0].save_failed = false; fp[0].disk_changed = false;
  cp_ft_tab_set_dirty(s, path, false);
  pk := cp_ft_prepare_preview(s, path, bytes, size);
  if pk != CP_FT_PREV_NONE {
    fp[0].mode = CP_FP_READ;
    cp_fp_build_index(s, cp_fp_view_src(s), SYN_LANG_PLAIN);
  } else {
    if fp[0].md_preview {
      ft[0].preview_n = cp_fp_format_md_preview(cast(string) bytes, ft[0].preview_buf[..]);
      fp[0].mode = CP_FP_READ;
      cp_fp_build_index(s, cp_fp_view_src(s), SYN_LANG_PLAIN);
    } else if was_edit && bytes.count <= CP_FP_EDIT_MOST && cp_fp_lines(cast(string) bytes) <= CP_FP_EDIT_LINES {
      fp[0].mode = CP_FP_EDIT;
      fp[0].text_n = cp_out(fp[0].text[..], cast(string) bytes);
      fp[0].large_edit = (fp[0].text_n > EB_TEXT || cp_fp_lines(cast(string) bytes) > CP_FP_SMALL_LINES);
      ue_close(s[0].fld[0].ed[CP_ED_FILE..<CP_ED_FILE + 1]);
      cp_fp_build_index(s, cp_fp_text(s), cp_fp_lang(path, CP_FT_PREV_NONE));
    } else {
      fp[0].mode = CP_FP_READ;
      cp_fp_build_index(s, cast(string) bytes, cp_fp_lang(path, CP_FT_PREV_NONE));
    }
  }
  fp[0].scroll = keep_sy; fp[0].scroll_x = keep_sx;
  fp[0].hl_start = keep_hl0; fp[0].hl_end = keep_hl1;
  for k: 0..<8 { fp[0].fold_bits[k] = keep_folds[k]; }
  if s[0].find[0].open && s[0].find[0].file_mode && !s[0].find[0].goto_mode { cp_find_scan_file(s); }
  return true;
}

// Marks the active dirty file as modified externally on disk (displays non-destructive Reload / Keep Mine banner, #13992).
coder_page_file_disk_changed :: (s: [] CoderPage) #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open { return; }
  s[0].fp[0].disk_changed = true;
}

// A 3D scene file (ple-scene.v1.json) opened in the pane: the host mounts the Metal viewport over its body rect.
coder_page_file_open_scene :: (s: [] CoderPage, path: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  if !s[0].ready { cp_init(s); }
  if !cp_flag(s, DC_FLAG_SCENES) { return false; }
  cp_ft_tab_save_active(s);
  cp_fp_begin(s, path);
  _ = cp_ft_tab_open(s, path);
  s[0].fp[0].mode = CP_FP_SCENE;
  return true;
}
// The 3D scene viewport rect (x, y, w, h in logical points, top-left origin) while the scene is on screen.
coder_page_file_scene_rect :: (s: [] CoderPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 || s[0].set_open || !cp_flag(s, DC_FLAG_SCENES) { return false; }
  fp := s[0].fp[..];
  if !cp_fp_shown(s) || fp[0].mode != CP_FP_SCENE || !(fp[0].body_w > 0) || !(fp[0].body_h > 0) { return false; }
  out[0] = fp[0].body_x; out[1] = fp[0].body_y; out[2] = fp[0].body_w; out[3] = fp[0].body_h;
  return true;
}
// A file the host could not read (missing, a folder, not text, too long): the pane says why.
coder_page_file_failed :: (s: [] CoderPage, path: string, why: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  cp_fp_begin(s, path);
  s[0].fp[0].mode = CP_FP_FAILED; s[0].fp[0].why_n = cp_out(s[0].fp[0].why[..], why);
}
cp_fp_begin :: (s: [] CoderPage, path: string) {
  fp := s[0].fp[..];
  was_expanded := fp[0].expanded;
  was_wrap := fp[0].wrap;
  if s[0].fld[0].kb == CP_KB_FILE { s[0].fld[0].kb = CP_KB_COMPOSER; }
  ue_close(s[0].fld[0].ed[CP_ED_FILE..<CP_ED_FILE + 1]);   // a new file is a new field: no undo into the last one
  fp[0] = CpFilePane.{};
  fp[0].open = true; fp[0].front = true; fp[0].hidden = false;
  fp[0].expanded = was_expanded;
  fp[0].wrap = was_wrap;
  s[0].ft[0].editor_menu = false;
  s[0].ft[0].crumb_menu = false;
  s[0].ft[0].preview_kind = CP_FT_PREV_NONE;
  s[0].ft[0].preview_n = 0;
  s[0].sim[0].front = false; s[0].term[0].front = false;   // the file comes in front of the simulator and terminal
  fp[0].path_n = cp_out(fp[0].path[..], path);
  if s[0].sel[0].region == CP_SEL_FILE { cp_sel_clear(s); }
}
// The editor's text, to be saved: its length in out, -1 when out does not hold it or nothing is edited.
coder_page_file_text :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open || s[0].fp[0].mode != CP_FP_EDIT { return -1; }
  t := cp_fp_text(s);
  if t.count > out.count { return -1; }
  return cp_out(out, t);
}
// The host wrote the file: bytes are what it holds now (the host keeps them). Edits made since the
// text was taken stay changes.
coder_page_file_saved :: (s: [] CoderPage, bytes: [] u8) #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open { return; }
  fp := s[0].fp[..];
  fp[0].src = bytes; fp[0].size = bytes.count; fp[0].save_failed = false; fp[0].why_n = 0; fp[0].disk_changed = false;
  fp[0].dirty = cp_fp_text(s) != cast(string) bytes;
  fp[0].saved = !fp[0].dirty;
  cp_ft_tab_set_dirty(s, cast(string) fp[0].path[0..<fp[0].path_n], fp[0].dirty);
}
// The host could not write the file: the pane says why, and the changes stay.
coder_page_file_save_failed :: (s: [] CoderPage, why: string) #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open { return; }
  s[0].fp[0].save_failed = true; s[0].fp[0].why_n = cp_out(s[0].fp[0].why[..], why);
}
// The pane closes; the composer takes the keyboard back if the file had it.
coder_page_file_close :: (s: [] CoderPage) #export_c #effects(all) {
  if s.count < 1 { return; }
  if s[0].fld[0].kb == CP_KB_FILE { s[0].fld[0].kb = CP_KB_COMPOSER; }
  if s[0].find[0].open && s[0].find[0].file_mode { cp_find_close(s); }
  if s[0].sel[0].region == CP_SEL_FILE { cp_sel_clear(s); }
  ue_close(s[0].fld[0].ed[CP_ED_FILE..<CP_ED_FILE + 1]);
  p := cast(string) s[0].fp[0].path[0..<s[0].fp[0].path_n];
  tidx := cp_ft_tab_find(s, p);
  if tidx >= 0 { _ = cp_ft_tab_remove(s, tidx); }
  s[0].fp[0] = CpFilePane.{};
}
// The open file comes forward in the pane (it was open behind another or hidden). False when none is open.
coder_page_file_front :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open { return false; }
  s[0].fp[0].front = true; s[0].fp[0].hidden = false; s[0].sim[0].front = false; s[0].term[0].front = false; return true;
}
// What the pane holds (CP_FP_*: 0 none, 1 edited here, 2 read-only, 3 could not be read).
coder_page_file_mode :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].fp[0].open then s[0].fp[0].mode else CP_FP_NONE; }
// Whether the open file has changes that are not saved.
coder_page_file_dirty :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].fp[0].open && s[0].fp[0].dirty; }
// Whether the pane shows the file now (File > Save works then).
coder_page_file_shown :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_fp_shown(s); }
// The open file's basename, its length in out.
coder_page_file_name :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].fp[0].open then cp_out(out, cp_fp_name(s)) else 0; }
// The open file's full displayed path, its length in out (#13992).
coder_page_file_path :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].fp[0].open then cp_out(out, cast(string) s[0].fp[0].path[0..<s[0].fp[0].path_n]) else 0; }
// Updates the File Pane's live Lean 4 Goal Strip from oa-leanhost (#13947).
coder_page_file_lean_goal :: (s: [] CoderPage, line: int, ok: bool, accomplished: bool, summary: string) #export_c #effects(all) {
  if s.count < 1 || !s[0].fp[0].open { return; }
  fp := s[0].fp[..];
  fp[0].lean_goal_line = line;
  fp[0].lean_goal_ok = ok;
  fp[0].lean_goal_done = accomplished;
  fp[0].lean_goal_busy = false;
  fp[0].lean_goal_n = cp_out(fp[0].lean_goal[..], summary);
}
