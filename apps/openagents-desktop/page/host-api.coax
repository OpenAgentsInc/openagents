// Coder Desktop page (../page.coax): the rest of the calls the host makes: the editor, frames, icons
// and fonts, actions, the worker's task and lines, Copy, and the text size.

// ---------------------------------------------------------------- the host's calls

// Whether the page's view has the keyboard (its window key, the view first responder); reduced motion.
coder_page_env :: (s: [] CoderPage, active: bool, reduced: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].fld[0].active = active; s[0].reduced = reduced;
}
// Whether to show the sidebar keyboard shortcut badges (held Command > 1s).
coder_page_cmd_hints :: (s: [] CoderPage, shown: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].cmd_hints = shown;
}
// The draft set from the host (a follow-up taken back to edit). One longer than a draft may be is refused.
coder_page_set_text :: (s: [] CoderPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 || text.count > EB_TEXT { return false; }
  if text != eb_text(s[0].draft[..]) { eb_set(s[0].draft[..], text); }
  return true;
}
// The same as a press on Send. True when the draft was sent.
coder_page_submit :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_send(s); }
// One frame of width by height device pixels. Returns the vertex count.
coder_page_frame :: (s: [] CoderPage, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  if !s[0].ready { cp_init(s); }
  a := s[0].atlas[..];
  d := (ifx dpr < 1 then 1.0f32 else dpr) * cp_scale(s);
  w := width / d; h := height / d;
  s[0].d = d; s[0].cmp_gpu[0].w = width; s[0].cmp_gpu[0].h = height;
  t := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  if !s[0].reduced { s[0].time += t; }
  s[0].clock += t;
  // the views' coasts and springs, where they are when this refresh shows (a refresh after this one's dt)
  if !s[0].now_host { s[0].now = cast(f64) s[0].clock; }
  cp_ed_tick(s, s[0].now);
  live := cp_scroll_step(s, s[0].now + cast(f64) (ifx t > 0.004 && t < 0.034 then t else 0.0083f32));
  if (s[0].copied_kind == CP_COPIED_ASK || s[0].copied_kind == CP_COPIED_REPLY) && s[0].clock - s[0].copied_at >= 1.2f32 {
    s[0].copied_kind = CP_COPIED_NONE; s[0].copied_turn = -1;
  }
  a[0].frame += 1;
  k := cp_skin_for(s);
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas);
  if !a[0].ready { return v; }
  f: [1] UiFrame;
  present := (s[0].pointer_in || s[0].touching) && s[0].px >= 0 && s[0].py >= 0 && s[0].px < w && s[0].py < h;
  input := uiinput(s[0].px, s[0].py, present, s[0].touching, cast(string) s[0].pressed[0..<s[0].pressed_n], ifx cp_composer_focused(s) then "coder.composer" else "");
  s[0].think_at = 1 - s[0].think_at;
  s[0].think[s[0].think_at].n = 0; s[0].think[s[0].think_at].nb = 0; s[0].think[s[0].think_at].nr = 0; s[0].think[s[0].think_at].ni = 0; s[0].think[s[0].think_at].nlink = 0;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(a), k, input, s[0].time, t, s[0].reduced, false);
  cp_layout(s, f[..], w, h);
  copy_ticking := (s[0].copied_kind == CP_COPIED_ASK || s[0].copied_kind == CP_COPIED_REPLY) && s[0].clock - s[0].copied_at < 1.2f32;
  veil_ticking := !s[0].reduced && s[0].veil_turn >= 0 && veil_is_fading(s[0].veil[..], s[0].clock);
  s[0].moving = uiframe_moving(f[..]) || cp_running(s) || cp_side_busy(s) || s[0].set_due || s[0].anim || copy_ticking || veil_ticking;
  s[0].scr_live = live;
  s[0].set_due = false;
  if cp_overlay(s, f[..], w, h, t) { s[0].moving = true; }
  if !uiframe_end(f[..], s[0].surface[..]) { s[0].refused += 1; }
  cp_clamp(s);
  sh := surface_sheet(s[0].surface[..]);
  s[0].over_n = cp_over_rects(sh.over[0..<sh.no], cp_scale(s), s[0].over_r[..]);
  // a flat frame's pictures, where the host draws them (compose.coax)
  ids: [CP_IMAGES] int;
  s[0].cmp_gpu[0].flat_used = false;
  ni := ifx cp_composes(s) then 0 else cp_flat_images(s, sh.under[0..<sh.nu], sh.over[0..<sh.no], ids[..]);
  v = gpu_draw_with(out, v, a, d, sh.under[0..<sh.nu], 0, 0, -8, h + 8, ids[0..<ni]);
  v = gpu_draw_with(out, v, a, d, sh.over[0..<sh.no], 0, 0, -8, h + 8, ids[0..<ni]);
  // a frosted surface on screen: the same frame as composition-v1's plan (compose.coax), else flat
  composed := cp_compose(s, out, a, d, w, h, k.canvas, sh.under[0..<sh.nu], sh.over[0..<sh.no], v);
  if composed >= 0 { v = composed; }
  else if cp_needs_compose(s, sh.under[0..<sh.nu], sh.over[0..<sh.no]) {
    // a refused plan wrote over the flat frame: draw it again, with its pictures where the host draws them
    ni = cp_flat_images(s, sh.under[0..<sh.nu], sh.over[0..<sh.no], ids[..]);
    v = paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas);
    v = gpu_draw_with(out, v, a, d, sh.under[0..<sh.nu], 0, 0, -8, h + 8, ids[0..<ni]);
    v = gpu_draw_with(out, v, a, d, sh.over[0..<sh.no], 0, 0, -8, h + 8, ids[0..<ni]);
  }
  // Preserve semantic scientific color roles inside Lean 4 & RH Proof Workbench (#13946)
  // and provider brand/status/accent colors on Settings -> Providers.
  if cp_cust_is_monochrome(s) && !(s[0].gym_open && s[0].gym_mode == CP_GYM_LEAN) && !(s[0].set_open && s[0].set_page == CP_PG_PROVIDERS) { gpu_monochrome(out, v); }
  return v;
}
// An icon's size in the atlas, in points. An icon draws at this size wherever it is, so the ones that
// sit together in the window's top corners and under messages (folder, copy, its check, new chat) are
// one size; the rest keep the component library's (Zeron's, in points).
CP_ICON :: 18;
coder_page_icon_size :: (i: int) -> f32 #export_c #effects(all) {
  if i == ICON_FOLDER || i == ICON_COPY || i == ICON_CHECK || i == ICON_COMPOSE || i == ICON_CLOSE { return CP_ICON; }
  sizes := ICON_SIZES;
  return ifx i >= 0 && i < ICON_COUNT then sizes[i] else 16.0f32;
}
// A font's size in the atlas, in points: Zeron's type ramp (CP_FONT_SIZES, skin.coax).
coder_page_font_size :: (k: int) -> f32 #export_c #effects(all) {
  sizes := CP_FONT_SIZES;
  if k < 0 || k >= sizes.count { return 12.0f32; }
  return sizes[k];
}
// What the page asks of the host (CP_ASK_*), once.
coder_page_action :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  ask := s[0].ask; s[0].ask = CP_ASK_NONE;
  return ask;
}
// What done means, sent with every goal turn: the real thing, not a stand-in that passes its own tests.
CP_GOAL_DONE_TEXT :: "Done means the real thing works for the user as the goal and every requirement or acceptance criterion it names say. A toy, synthetic, miniature, stubbed, mocked, placeholder or hard-coded stand-in is not done, and neither is code that only compiles or only passes tests and fixtures written for it. If the real thing cannot be done here (missing weights, hardware, secrets, access or time), say so plainly and end with [GOAL_BLOCKED]; never swap in a smaller task and report it as the original. Do not close an issue or mark work implemented until every one of its acceptance criteria holds. Report only checks you ran, with their real result: a check that was killed, timed out or skipped did not pass.\n\n";
// The turn a [GOAL_COMPLETE] starts (goal.coax): a skeptical check of the work before the goal closes.
CP_GOAL_AUDIT_TEXT :: "You said the goal above is done. Before it closes, check the work as a skeptical reviewer who did not write it. Re-read the goal and every issue, spec or request it names (gh issue view each one) and list every requirement and acceptance criterion. For each, run the real thing end to end the way the user would use it, and quote the command and its actual output. Anything that is a stand-in (toy sizes, synthetic data, a stub, a mock, a placeholder file, a fixture you wrote) or that only compiles is not done: say so plainly, reopen any issue closed too early, and keep working on it in this turn, or end with [GOAL_BLOCKED] naming exactly what is missing if it cannot be done here. End with [GOAL_COMPLETE] only if every criterion holds for real, with the evidence above it.\n\n";
// The newest message as the worker's task line (mcworker-wire.coax): its length in out, 0 for none.
coder_page_task :: (s: [] CoderPage, session: string, cwd: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return 0; }
  i := s[0].nturns - 1;
  return cp_task_message(s, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n], cp_refs(s, i), s[0].turns[i].model, session, cwd, out);
}
// ask as the worker's task line, with the model at index model: what a message sends, and what a
// queued follow-up carries (followups.coax).
cp_task_message :: (s: [] CoderPage, ask: string, refs: string, model: int, session: string, cwd: string, out: [] u8) -> int {
  // the note on installed skills, optional active thread goal context, then the message and the
  // note on its attachments and the files it mentions (attach.coax)
  whole: [CP_SKILLS + CP_GOAL_TEXT + EB_TEXT + CP_REFS + 4096] u8;
  // Claude Code finds its skills itself, and MCP/skills injection is gated by the mcp flag.
  n := ifx cp_is_claude(s, model) || !cp_flag(s, DC_FLAG_MCP) then 0 else cp_out(whole[..], cast(string) s[0].skills[0..<s[0].skills_n]);
  if s[0].goal_status == CP_GOAL_ACTIVE && s[0].goal_objective_n > 0 {
    n += cp_out(whole[n..<whole.count], "<goal_objective>\n");
    n += cp_out(whole[n..<whole.count], cast(string) s[0].goal_objective[0..<s[0].goal_objective_n]);
    n += cp_out(whole[n..<whole.count], "\n</goal_objective>\n");
    if s[0].goal_prompt_kind == CP_GOAL_PROMPT_AUDIT {
      n += cp_out(whole[n..<whole.count], CP_GOAL_AUDIT_TEXT);
    } else if s[0].goal_prompt_kind == CP_GOAL_PROMPT_CONTINUE {
      n += cp_out(whole[n..<whole.count], "Continue working toward the active thread goal above. Make concrete, verified progress without stopping early. Do not ask the user for permission to continue. When the goal is completely achieved and verified, include [GOAL_COMPLETE] at the end of your reply. If you are truly blocked and need user input, include [GOAL_BLOCKED] and explain what is needed.\n\n");
    } else if s[0].goal_prompt_kind == CP_GOAL_PROMPT_UPDATED {
      n += cp_out(whole[n..<whole.count], "The user updated the active thread goal above. Realign your work to the updated objective. When the updated goal is completely achieved and verified, include [GOAL_COMPLETE] at the end of your reply. If blocked on user input, include [GOAL_BLOCKED].\n\n");
    } else {
      n += cp_out(whole[n..<whole.count], "Work autonomously toward the active thread goal above. Make concrete, verified progress across turns until finished. When the goal is completely achieved and verified, include [GOAL_COMPLETE] at the end of your reply. If you are truly blocked and need user input, include [GOAL_BLOCKED].\n\n");
    }
    n += cp_out(whole[n..<whole.count], CP_GOAL_DONE_TEXT);
  }
  for c: ask { if n < whole.count { whole[n] = c; n += 1; } }
  if refs.count > 0 { n += cp_out(whole[n..<whole.count], "\n\n"); n += cp_out(whole[n..<whole.count], refs); }
  is_local := cp_is_inkling(s, model) || cp_is_hybrid(s, model);
  is_combo := cp_is_inkling_neon(s, model);
  use_agents := !is_local && !is_combo;
  t := McTask.{task = cast(string) whole[0..<n], session = session, cwd = cwd, sandbox = "danger-full-access",
               ceiling = 3, gated = true, edits = true, unlimited = true, no_ask = true, agents = use_agents, claude = use_agents && cp_flag(s, DC_FLAG_MODELS_CLAUDE) && s[0].claude, local = is_local, model = cp_model_id(s, model), effort = cp_task_effort(s, model), openrouter = ifx use_agents && cp_flag(s, DC_FLAG_MODELS_OPENROUTER) then cp_or_sub(s) else ""};
  // the simulator pane open and its helper there: the run may drive the device (GitHub #13811)
  t.device = cp_flag(s, DC_FLAG_SIMULATOR) && cp_sim(s)[0].open && cp_sim(s)[0].connected;
  return mww_task(out, t);
}
// What the host found installed on this computer (skills and their files), in words for Microcoder.
// It goes ahead of every message's task and is not shown. At most 4,000 bytes are kept.
coder_page_skills :: (s: [] CoderPage, note: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].skills_n = cp_out(s[0].skills[..], note);
}
// The working folder as the host shows it (~/work/app). Commands start there: the host passes its
// whole path as the task's cwd. At most 512 bytes are kept.
coder_page_folder :: (s: [] CoderPage, shown: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if cast(string) s[0].folder[0..<s[0].folder_n] != shown { cp_files_forget(s); }   // the @ list was the old folder's
  s[0].folder_n = cp_out(s[0].folder[..], shown);
}
// The working folder's Git branch, as the host read it ("" for none): the composer's foot shows it
// after the folder (#13743).
coder_page_branch :: (s: [] CoderPage, name: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].branch_n = cp_out(s[0].branch[..], name);
}
// Sticky new-chat git worktree preference (default false; persisted by host on toggle).
coder_page_worktree_set :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].new_chat_worktree = on;
}
coder_page_worktree :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].new_chat_worktree;
}
// The answer the worker is owed for the command it asked about: yes, run it. The page shows every
// command as it starts; it does not hold one back. Its length in out, 0 when none is owed.
coder_page_answer_line :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if s[0].results_due && cp_running(s) {
    i := s[0].nturns - 1;
    s[0].results_due = false; s[0].turns[i].waiting = false; s[0].turns[i].h = 0;
    return cp_results(s, i, out);
  }
  if s[0].permit[0].answer_due { return cp_permit_answer_line(s, out); }
  if !s[0].answer_due { return 0; }
  s[0].answer_due = false;
  return mww_answer(out, true, s[0].answer, "");
}
// The worker's line to stop the run, and the one to forget the conversation.
coder_page_stop_line :: (out: [] u8) -> int #export_c #effects(all) { return cp_out(out, MWW_STOP_LINE); }
coder_page_forget_line :: (out: [] u8) -> int #export_c #effects(all) { return cp_out(out, MWW_FORGET_LINE); }
// One line from the worker. Returns its kind (MWW_*).
coder_page_line :: (s: [] CoderPage, line: string) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  ar := [1] ClArena.[ClArena.{buf = s[0].arena[..]}];
  l: [1] MwwLine;
  kind := mww_read(ar[..], line, l[..]);
  if cp_fu_line(s, kind, l[0]) { return kind; }
  if !cp_running(s) { return kind; }
  i := s[0].nturns - 1;
  if kind != 0 {
    s[0].turns[i].loading_model = false;
    s[0].turns[i].heard = true;   // the turn has begun: no longer Loading model… / Sending…
  }
  if kind != MWW_NONE && kind != MWW_THOUGHT && kind != MWW_TODOS { s[0].turns[i].thought_open = false; }
  // Each model request streams its own text. What one wrote before it ran commands is not the
  // reply: the next request's text takes its place, as the ended line's whole reply does.
  if kind == MWW_REPLY {
    if s[0].turns[i].first_tok < 0 { s[0].turns[i].first_tok = s[0].clock; }
    cp_reply_set(s, i, l[0].text, !s[0].turns[i].fresh); s[0].turns[i].fresh = false;
  }
  else if kind == MWW_ATTEMPT && l[0].gateway == "antigravity" {
    s[0].turns[i].ran_n = cp_out(s[0].turns[i].ran[..], l[0].model);
    if l[0].output_tokens.ok && l[0].output_tokens.value > 0 { s[0].turns[i].attempt_tokens += l[0].output_tokens.value; }
  }   // the model agy opened the session on: the reply's label
  else if kind == MWW_ATTEMPT {
    s[0].turns[i].fresh = true; cp_add_cost(s, cp_attempt_cost(l[0])); cp_ctx_take(s, l[0]);
    if l[0].output_tokens.ok && l[0].output_tokens.value > 0 { s[0].turns[i].attempt_tokens += l[0].output_tokens.value; }
  }
  else if kind == MWW_STATS {
    if l[0].ttft_ms.ok && l[0].ttft_ms.value > 0 && s[0].turns[i].ttft_ms <= 0 { s[0].turns[i].ttft_ms = l[0].ttft_ms.value; }
    if l[0].output_tokens.ok && l[0].output_tokens.value > 0 && l[0].decode_ms.ok && l[0].decode_ms.value > 0 {
      s[0].turns[i].stat_tokens += l[0].output_tokens.value;
      s[0].turns[i].stat_decode_ms += l[0].decode_ms.value;
      s[0].turns[i].tok_s_x10 = (s[0].turns[i].stat_tokens * 10000 + s[0].turns[i].stat_decode_ms / 2) / s[0].turns[i].stat_decode_ms;
      if s[0].turns[i].tok_s_x10 < 1 { s[0].turns[i].tok_s_x10 = 1; }
    }
  }
  else if kind == MWW_ASK { cp_cmd_asked(s, i, l[0].command, l[0].ticket.value); }
  else if kind == MWW_PERMIT { cp_permit_take_line(s, -1, "", l[0], line); }
  else if kind == MWW_DELEGATE { cp_delegate(s, i, l[0].tasks, l[0].ticket.value); }
  else if kind == MWW_STOP_AGENT { if l[0].agent.ok { cp_agent_stopped_by_run(s, i, l[0].agent.value); } }
  else if kind == MWW_COMMAND { cp_cmd_done(s, i, l[0].command, l[0].output, l[0].timed_out.value || l[0].exit.value != 0); }
  else if kind == MWW_THOUGHT {
    if s[0].turns[i].first_tok < 0 { s[0].turns[i].first_tok = s[0].clock; }
    cp_thought_stream(s, i, -1, l[0].text);
  }
  else if kind == MWW_TODOS { cp_todos_take(s, l[0].todos); }
  else if kind == MWW_VIEW { cp_cmd_add(s, i, l[0].path, ifx l[0].found.value then "" else "No such file.", true, !l[0].found.value); }
  else if kind == MWW_ENDED {
    if l[0].ending == "finished" || l[0].ending == "asked" {
      // Transition to CP_DONE before updating final text so cp_reply_set clears the streaming
      // veil instead of restarting a full-reply fade-in from alpha 0.
      s[0].turns[i].state = CP_DONE;
      if l[0].text.count > 0 { cp_reply_set(s, i, l[0].text, false); }
      else if s[0].veil_turn == i { s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; }
    } else if s[0].turns[i].stopping || l[0].ending == "stopped" {
      s[0].turns[i].state = CP_STOPPED;
      if s[0].veil_turn == i { s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; }
    }   // a stop from the paired phone sets no stopping here (#13756)
    else {
      s[0].turns[i].note_n = cp_out(s[0].turns[i].note[..], cp_ended_why(l[0].ending, l[0].text, false));
      s[0].turns[i].state = CP_FAILED;
      s[0].live_reply = i;
      if s[0].veil_turn == i { s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; }
    }
    cp_cmds_end(s, i);
    cp_todos_reset(s);
    cp_permit_reset(s);
    s[0].turns[i].h = 0; s[0].turns[i].took = s[0].clock - s[0].turns[i].began;
    if s[0].sb[0].now_ms > 0 { s[0].turns[i].done_ms = s[0].sb[0].now_ms; }
    if s[0].turns[i].ttft_ms <= 0 && s[0].turns[i].first_tok >= s[0].turns[i].began {
      fms := cast(int) ((s[0].turns[i].first_tok - s[0].turns[i].began) * 1000.0f32 + 0.5f32);
      if fms > 0 { s[0].turns[i].ttft_ms = fms; }
    }
    if s[0].turns[i].tok_s_x10 <= 0 && s[0].turns[i].attempt_tokens > 0 {
      t_start := ifx s[0].turns[i].first_tok >= s[0].turns[i].began then s[0].turns[i].first_tok else s[0].turns[i].began;
      dms := cast(int) ((s[0].clock - t_start) * 1000.0f32 + 0.5f32);
      if dms >= 50 {
        s[0].turns[i].tok_s_x10 = (s[0].turns[i].attempt_tokens * 10000 + dms / 2) / dms;
        if s[0].turns[i].tok_s_x10 < 1 { s[0].turns[i].tok_s_x10 = 1; }
      }
    }
    cp_goal_on_turn_end(s, i, l[0].ending, l[0].text);
  }
  return kind;
}
// Host tells the active running turn whether the local model is still loading/warming up.
// When loading finishes (loading == false), reset `began` so model-load time is excluded
// from both "Worked for Ns" and fallback TTFT.
coder_page_turn_loading_model :: (s: [] CoderPage, loading: bool) #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return; }
  i := s[0].nturns - 1;
  was := s[0].turns[i].loading_model;
  s[0].turns[i].loading_model = loading;
  if was && !loading {
    s[0].turns[i].began = s[0].clock;
    s[0].turns[i].first_tok = -1;
    if s[0].goal_status == CP_GOAL_ACTIVE && s[0].goal_turn_began > 0 {
      s[0].goal_turn_began = ifx s[0].clock > 0 then s[0].clock else 0.001f32;
    }
  }
  if loading { s[0].anim = true; }
}
// The worker could not start or went away: the running turn says why.
coder_page_failed :: (s: [] CoderPage, why: string) #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return; }
  i := s[0].nturns - 1;
  s[0].turns[i].loading_model = false;
  s[0].turns[i].note_n = cp_out(s[0].turns[i].note[..], why); s[0].turns[i].state = CP_FAILED; s[0].live_reply = i; s[0].turns[i].h = 0;
  if s[0].veil_turn == i { s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; }
  s[0].turns[i].took = s[0].clock - s[0].turns[i].began;
  if s[0].sb[0].now_ms > 0 { s[0].turns[i].done_ms = s[0].sb[0].now_ms; }
  cp_cmds_end(s, i);
  cp_todos_reset(s);
  cp_permit_reset(s);
}
// What the last Copy took: a code block, a person's message, a reply as its Markdown, or the whole
// chat (each message under "You:", each command under "Ran:", each reply under "Microcoder:"). Its length in out.
coder_page_copied :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].copied_turn < 0 || s[0].copied_turn >= s[0].nturns { return 0; }
  i := s[0].copied_turn; kind := s[0].copied_kind;
  if kind == CP_COPIED_PANE {
    if !s[0].pane_open || s[0].copied_block < 0 || s[0].copied_block >= s[0].pane_blocks { return 0; }
    return cp_out(out, md_block_text(s[0].pane_doc[..], s[0].copied_block));
  }
  if kind == CP_COPIED_SAID {
    // parsed again into the transcript's reply document, which the next frame parses afresh
    q := s[0].copied_row;
    if q < 0 || !s[0].calls[q].said { return 0; }
    s[0].pane_doc[0].n = 0; s[0].pane_doc[0].nb = 0; s[0].pane_doc[0].nr = 0; s[0].pane_doc[0].ni = 0; s[0].pane_doc[0].nlink = 0; s[0].pane_parsed = -1;
    blocks := md_parse(s[0].pane_doc[..], cp_call_text(s, q), 0);
    if s[0].copied_block < 0 || s[0].copied_block >= blocks || s[0].pane_doc[0].blocks[s[0].copied_block].kind != MB_CODE { return 0; }
    return cp_out(out, md_block_text(s[0].pane_doc[..], s[0].copied_block));
  }
  if kind == CP_COPIED_BLOCK {
    if s[0].copied_block < 0 || s[0].copied_block >= s[0].turns[i].blocks { return 0; }
    return cp_out(out, md_block_text(cp_doc(s, i), s[0].copied_block));
  }
  if kind == CP_COPIED_ASK { return cp_out(out, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n]); }
  if kind == CP_COPIED_REPLY { return cp_out(out, cast(string) s[0].turns[i].reply[0..<s[0].turns[i].reply_n]); }
  if kind != CP_COPIED_ALL { return 0; }
  n := 0;
  for j: 0..<s[0].nturns {
    n += cp_out(out[n..<out.count], "You:\n"); n += cp_out(out[n..<out.count], cast(string) s[0].turns[j].ask[0..<s[0].turns[j].ask_n]); n += cp_out(out[n..<out.count], "\n\n");
    q := s[0].turns[j].head - 1;
    while q >= 0 {
      if !s[0].calls[q].thought && !s[0].calls[q].said {
        n += cp_out(out[n..<out.count], ifx s[0].calls[q].read then "Read: " else "Ran: ");
        n += cp_out(out[n..<out.count], cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]); n += cp_out(out[n..<out.count], "\n");
      }
      q = s[0].calls[q].next - 1;
    }
    if s[0].turns[j].ncmds > 0 { n += cp_out(out[n..<out.count], "\n"); }
    if s[0].turns[j].reply_n > 0 {
      n += cp_out(out[n..<out.count], "Microcoder:\n"); n += cp_out(out[n..<out.count], cast(string) s[0].turns[j].reply[0..<s[0].turns[j].reply_n]); n += cp_out(out[n..<out.count], "\n\n");
    }
  }
  while n > 0 && out[n - 1] == 10 { n -= 1; }
  return n;
}
// The drawn box of the row with this id, in points (x, y from the content's top-left, w, h): for a
// test driver that presses what a person sees (evals/openagents-desktop/tier3/probe). False when no
// row has the id or none of it shows.
coder_page_box :: (s: [] CoderPage, id: string, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 { return false; }
  t := [1] ElTable.[surface_rows(s[0].surface[..])];
  i := elt_find(t[..], id);
  if i < 0 { return false; }
  b := el_box(t[0].rows[i]); u: f32 = cp_scale(s);
  if !b.visible { return false; }
  out[0] = b.x * u; out[1] = b.y * u; out[2] = b.w * u; out[3] = b.h * u;
  return true;
}
coder_page_running :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_running(s); }
coder_page_moving :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && (!s[0].ready || !s[0].reduced && s[0].moving || s[0].scr_live); }
// The host's clock before a frame, in seconds (the one its scroll events are stamped on).
coder_page_now :: (s: [] CoderPage, now: f64) #export_c #effects(all) { if s.count > 0 { s[0].now = now; s[0].now_host = true; } }
coder_page_refused :: (s: [] CoderPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].refused; }
coder_page_max_vertices :: () -> int #export_c #effects(all) { return CP_MAX_VERTICES; }
coder_page_scale :: (s: [] CoderPage) -> f32 #export_c #effects(all) { if s.count < 1 { return 1.0f32; } return cp_scale(s); }
// The text size: a row of CP_ZOOMS (0 to 7; 2 is the usual size). by moves it a row up or down and
// 0 leaves it; coder_page_zoom_set names the row. Each returns the row it is at now.
coder_page_zoom :: (s: [] CoderPage, by: int) -> int #export_c #effects(all) {
  if s.count < 1 { return CP_ZOOM_USUAL; }
  if !s[0].ready { cp_init(s); }
  return coder_page_zoom_set(s, s[0].zoom + by);
}
coder_page_zoom_set :: (s: [] CoderPage, row: int) -> int #export_c #effects(all) {
  if s.count < 1 { return CP_ZOOM_USUAL; }
  if !s[0].ready { cp_init(s); }
  r := ifx row < 0 then 0 else ifx row > 7 then 7 else row;
  if r != s[0].zoom { s[0].zoom = r; for i: 0..<s[0].nturns { s[0].turns[i].h = 0; } }
  return s[0].zoom;
}

// Feature flag mask from coax/lib/agent/desktop/flags.coax. Off features are hidden and closed.
coder_page_flags_set :: (s: [] CoderPage, mask: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].flags = mask & DC_FLAGS_ALL;
  s[0].experimental = s[0].flags == DC_FLAGS_ALL;
  cp_model_restore_id(s, prev);
  if cp_models(s) == 0 { s[0].model_menu = false; }
  if !cp_flag(s, DC_FLAG_GYM) { s[0].gym_open = false; }
  if !cp_flag(s, DC_FLAG_FORGE) { s[0].forge[0].open = false; }
  if !cp_flag(s, DC_FLAG_TERMINAL) { s[0].term[0].open = false; }
  if !cp_flag(s, DC_FLAG_SIMULATOR) { s[0].sim[0].open = false; }
  if !cp_flag(s, DC_FLAG_PREVIEW) { s[0].preview[0].open = false; }
  if !cp_flag(s, DC_FLAG_GIT) { s[0].review = false; }
  if !cp_flag(s, DC_FLAG_FILES) {
    if !(cp_flag(s, DC_FLAG_SCENES) && s[0].fp[0].mode == CP_FP_SCENE) { s[0].fp[0].open = false; }
    s[0].ft[0].open = false;
  }
  if !cp_flag(s, DC_FLAG_RICH) { s[0].rich[0].side_open = false; }
  if !cp_flag(s, DC_FLAG_USAGE) { s[0].usage[0].popover_open = false; }
  if !cp_set_page_ok_flags(s[0].flags, s[0].set_page) { s[0].set_page = CP_PG_GENERAL; s[0].set_scroll = 0; }
}
coder_page_flags :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].flags else 0; }

// First-run / local Inkling hardware and download status pushed from the host.
coder_page_local_state :: (s: [] CoderPage, os_ok: bool, hw_ok: bool, ram_gb: int, dl_state: int, pct: int, dl_mb: int, total_mb: int, err: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].local_os_ok = os_ok;
  s[0].local_hw_ok = hw_ok;
  s[0].local_ram_gb = ram_gb;
  s[0].local_dl_state = dl_state;
  s[0].local_dl_pct = pct;
  s[0].local_dl_mb = dl_mb;
  s[0].local_dl_total_mb = total_mb;
  s[0].local_dl_err_n = cp_out(s[0].local_dl_err[..], err);
}

// The onboarding's Antigravity connection (Connect Google Antigravity, CP_AGY_CONNECT): whether this
// build can offer it (agyworker is bundled), CP_AGY_IDLE / _BUSY / _FAILED, and the step it is on or
// why it failed. The onboarding shows it only where Inkling cannot run.
// While the Antigravity CLI downloads, pct is how far (0..100) with dl_mb of total_mb (0: unknown);
// pct -1 otherwise.
coder_page_agy_connect :: (s: [] CoderPage, avail: bool, state: int, msg: string, pct: int, dl_mb: int, total_mb: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].agy_avail = avail;
  s[0].agy_conn = ifx state == CP_AGY_BUSY || state == CP_AGY_FAILED then state else CP_AGY_IDLE;
  s[0].agy_conn_msg_n = cp_out(s[0].agy_conn_msg[..], msg);
  s[0].agy_dl_pct = ifx s[0].agy_conn == CP_AGY_BUSY && pct >= 0 then (ifx pct > 100 then 100 else pct) else -1;
  s[0].agy_dl_mb = dl_mb; s[0].agy_dl_total_mb = total_mb;
  s[0].anim = true;
}

// Experimental features (Settings > General): developer alias turning every flag on or off.
coder_page_experimental_set :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  coder_page_flags_set(s, ifx on then DC_FLAGS_ALL else 0);
}
coder_page_experimental :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].experimental; }

// Gym / 3D PLE Workbench mode (#13792): toggled by the sidebar's Gym row (CP_ASK_GYM) or the host.
coder_page_gym_set :: (s: [] CoderPage, open: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].gym_open = open && cp_flag(s, DC_FLAG_GYM);
  if open && s[0].gym_open { s[0].set_open = false; }
}
coder_page_gym_open :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].gym_open;
}
// The live 3D card on screen (shows.coax, #13812): out gets its rect, then the conversation's clip
// the host cuts its viewport to (x, y, w, h each, host points from the top left), and path the
// scene file. Returns the path's length; 0 when no live card showed in the last frame.
coder_page_live_scene :: (s: [] CoderPage, out: [] f32, path: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || out.count < 8 || !s[0].live_on || s[0].live_path_n > path.count { return 0; }
  for k: 0..<8 { out[k] = s[0].live_r[k]; }
  for k: 0..<s[0].live_path_n { path[k] = s[0].live_path[k]; }
  return s[0].live_path_n;
}
coder_page_gym_rect :: (s: [] CoderPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 || s[0].set_open || !s[0].gym_open || !(s[0].gym_w > 0) || !(s[0].gym_h > 0) { return false; }
  out[0] = s[0].gym_x; out[1] = s[0].gym_y; out[2] = s[0].gym_w; out[3] = s[0].gym_h;
  return true;
}
