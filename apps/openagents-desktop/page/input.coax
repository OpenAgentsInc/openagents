// Coder Desktop page (../page.coax): presses, the pointer, the wheel, and the sidebars' edges.

// A file a row reads (call q) or a reply names (turn i's nth): the host opens it
// (CP_ASK_OPEN_FILE, coder_page_open_path). False for none.
cp_open_file :: (s: [] CoderPage, q: int, i: int, n: int) -> bool {
  s[0].open_call = q; s[0].open_turn = i; s[0].open_file = n; s[0].open_cargo = -1; s[0].open_show = -1; s[0].open_term_path = false; s[0].find[0].open_file_path_n = 0;
  if cp_open_path(s).count == 0 { return false; }
  s[0].ask = CP_ASK_OPEN_FILE;
  return true;
}
cp_open_path :: (s: [] CoderPage) -> string {
  q := s[0].open_call; i := s[0].open_turn;
  if s[0].find[0].open_file_path_n > 0 { return cast(string) s[0].find[0].open_file_path[0..<s[0].find[0].open_file_path_n]; }
  if s[0].open_term_path { return cp_term_click_path(s); }   // a file path clicked in the terminal pane (termpane.coax)
  if s[0].open_show >= 0 { return cp_show_open_path(s, i, s[0].open_show); }   // a picture a command showed (shows.coax)
  if s[0].open_cargo >= 0 && s[0].open_cargo < cp_cargo_n(s) { return at_path(s[0].cargo[0].files[..], s[0].open_cargo); }   // an attachment's chip (attach.coax)
  if q >= 0 && q < s[0].calls_n { t := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; return cast(string) t[cp_edit_at(t)..<t.count]; }
  if q < 0 && i >= 0 && i < s[0].nturns { return app_message_path(cp_doc(s, i), 0, s[0].turns[i].blocks, s[0].open_file); }
  return "";
}
// An http(s) link a reply or sub-agent message carries: the host opens it in the browser
// (CP_ASK_OPEN_URL, coder_page_open_url). False for none.
cp_open_url :: (s: [] CoderPage, pane: bool, i: int, n: int) -> bool {
  s[0].open_url_pane = pane; s[0].open_url_turn = i; s[0].open_url = n; s[0].open_url_term = false;
  if cp_open_url_str(s).count == 0 { return false; }
  s[0].ask = CP_ASK_OPEN_URL;
  return true;
}
cp_open_url_str :: (s: [] CoderPage) -> string {
  if s[0].open_url_term { return cp_term_click_url(s); }
  if s[0].open_url_pane { return app_message_url(s[0].pane_doc[..], 0, s[0].pane_blocks, s[0].open_url); }
  i := s[0].open_url_turn;
  if i >= 0 && i < s[0].nturns { return app_message_url(cp_doc(s, i), 0, s[0].turns[i].blocks, s[0].open_url); }
  return "";
}
// Row k of turn i's own rows (cp_row_id's k, counted from the rows that went) as its place in the page's calls, -1 for none.
cp_turn_call :: (s: [] CoderPage, i: int, k: int) -> int {
  q := s[0].turns[i].head - 1; at := s[0].turns[i].early_cmds;
  while q >= 0 { if at == k { return q; } q = s[0].calls[q].next - 1; at += 1; }
  return -1;
}
cp_press :: (s: [] CoderPage, row: int) -> bool {
  act := surface_action(s[0].surface[..], row);
  if act >= CP_SET_BACK && act <= CP_SET_ACT { return cp_settings_press(s, act, surface_id(s[0].surface[..], row)); }
  if act >= CP_FP_CLOSE && act <= CP_FP_EXTERNAL { return cp_fp_press(s, act); }   // the file in the pane (filepane.coax)
  if act >= CP_FT_TOGGLE && act <= CP_FT_PREVIEW_RAW { return cp_ft_press(s, act, surface_id(s[0].surface[..], row)); }   // File Explorer tree, tabs & Open-in-Editor (filetree.coax; #13881)
  if act >= CP_SIM_CLOSE && act < CP_SIM_TAB + CP_SIM_DEVICES && act != 100 { return cp_sim_press(s, act); }   // the simulator in the pane (simpane.coax)
  if act >= CP_GIT_BRANCH && act <= CP_GIT_STOP { return cp_git_press(s, act); }   // Git Actions toolbar (gitactions.coax; #13871)
  if act >= CP_TERM_TOGGLE && act <= CP_TERM_LINK { return cp_term_press(s, act, surface_id(s[0].surface[..], row)); }   // the terminal in the pane (termpane.coax)
  if act >= CP_CKPT_DIFF && act <= CP_CKPT_DIFF_ALL { return cp_ckpt_press(s, act, surface_id(s[0].surface[..], row)); }   // Per-turn checkpoints (checkpoint.coax; #13872)
  if act >= CP_SB_GROUP_TOGGLE && act <= CP_SB_UNDO_CLOSE_ACT { return cp_sb_press(s, act, surface_id(s[0].surface[..], row)); }   // Sidebar groups, archive, bulk & undo (sidebar_groups.coax; #13875)
  if act >= CP_FIND_PREV && act <= CP_MINIMAP_TRACK { return cp_find_press(s, act); }   // In-thread Find & Minimap (find.coax; #13876)
  if act >= CP_VOICE_MIC && act <= CP_VOICE_CANCEL { return cp_voice_press(s, act); }  // Voice dictation (voice.coax; #13882)
  if act >= CP_RICH_STASH_POP && act <= CP_RICH_SIDE_OPEN_MAIN { return cp_rich_press(s, act, surface_id(s[0].surface[..], row)); } // Rich composer & Side Chat (rich.coax; #13884)
  if act >= CP_SCHED_ACT_ADD && act <= CP_SCHED_ACT_UPDATE_ALL { return cp_sched_press(s, act, surface_id(s[0].surface[..], row)); }  // Scheduled Tasks & Update Everything (scheduled.coax; #13885)
  if act >= CP_PREVIEW_CLOSE && act < CP_PREVIEW_PORT_BASE + CP_PREVIEW_MAX_PORTS { return cp_preview_press(s, act); } // Embedded Web Preview Pane (preview.coax; #13888)
  _ = cp_preview_yield(s, act);
  if act >= CP_FORGE_TOGGLE && act <= CP_FORGE_ISS_CHAT { return cp_forge_press(s, act, surface_id(s[0].surface[..], row)); }  // Pull Requests & Issues (forge.coax; #13886)
  if act >= CP_GYM_MODE_ACT && act <= CP_LEAN_JUMP_ATLAS { return cp_lean_press(s, act, surface_id(s[0].surface[..], row)); }  // Gym mode bar & Lean · RH Workbench (gym-lean.coax; #13946)
  _ = cp_forge_yield(s, act);
  _ = cp_term_yield(s, act);
  _ = cp_sim_yield(s, act);
  _ = cp_ft_yield(s, act);
  if cp_fp_yield(s, act, surface_id(s[0].surface[..], row)) { return true; }
  if act == CP_TOOL {
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); k := cp_number(id, ".x");
    if turn < 0 || turn >= s[0].nturns || k < 0 { return false; }
    tb: [EL_ID] u8; rid := cp_row_id(tb[..], turn, k);
    if app_act_path_pressed(rid, id) {
      q := cp_turn_call(s, turn, k);
      return q >= 0 && cp_open_file(s, q, turn, -1);
    }
    s[0].turns[turn].h = 0;
    return app_act_press(s[0].keyed[..], rid, id);
  }
  if act == CP_SHOW {
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); n := cp_number(id, ".show");
    if turn < 0 || turn >= s[0].nturns || n < 0 { return false; }
    s[0].open_call = -1; s[0].open_turn = turn; s[0].open_file = -1; s[0].open_cargo = -1; s[0].open_show = n;
    if cp_open_path(s).count == 0 { s[0].open_show = -1; return false; }
    s[0].ask = CP_ASK_OPEN_FILE;
    return true;
  }
  if act == CP_PATH {
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); n := cp_number(id, ".path.");
    if turn < 0 || turn >= s[0].nturns || n < 0 { return false; }
    return cp_open_file(s, -1, turn, n);
  }
  if act == CP_URL {
    id := surface_id(s[0].surface[..], row);
    n := cp_number(id, ".url.");
    if n < 0 { return false; }
    if id.count > 0 && id[0] == 'p' {
      if !s[0].pane_open { return false; }
      return cp_open_url(s, true, s[0].pane_turn, n);
    }
    turn := cp_number(id, "t");
    if turn < 0 || turn >= s[0].nturns { return false; }
    return cp_open_url(s, false, turn, n);
  }
  if act == CP_GROUP {
    gid := surface_id(s[0].surface[..], row);
    if gid.count > 0 && gid[0] == 'p' {
      // the open sub-agent's, in the pane (#13744)
      pb: [EL_ID] u8;
      if !s[0].pane_open || gid != cp_pane_id(pb[..], s, ".grp", -1) { return false; }
      ti := s[0].pane_turn; aj := s[0].pane_agent;
      s[0].turns[ti].agents[aj].fold = app_act_choose(s[0].turns[ti].agents[aj].fold, s[0].turns[ti].agents[aj].state == CP_RUNNING);
      return true;
    }
    turn := cp_number(gid, "t");
    if turn < 0 || turn >= s[0].nturns { return false; }
    s[0].turns[turn].fold = app_act_choose(s[0].turns[turn].fold, s[0].turns[turn].state == CP_RUNNING);
    s[0].turns[turn].h = 0;
    return true;
  }
  if act == CP_BUBBLE_FOLD {
    turn := cp_number(surface_id(s[0].surface[..], row), "t");
    if turn < 0 || turn >= s[0].nturns { return false; }
    s[0].turns[turn].ask_open = !s[0].turns[turn].ask_open; s[0].turns[turn].h = 0;
    return true;
  }
  if act == CP_JUMP { cp_glide_end(s); return true; }
  if act == CP_AGENT {
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); j := cp_number(id, ".g");
    if turn < 0 || turn >= s[0].nturns || j < 0 || j >= s[0].turns[turn].nagents { return false; }
    // its transcript opens on the window's right; a press on the one that is open closes it
    s[0].pane_manual = true;
    if s[0].pane_open && s[0].pane_turn == turn && s[0].pane_agent == j { s[0].pane_open = false; return true; }
    cp_pane_open(s, turn, j);
    return true;
  }
  if act == CP_PANE_CLOSE { s[0].pane_open = false; s[0].pane_manual = true; return true; }
  if act == CP_AGENT_STOP {
    // the same stop as the pane's, for the sub-agent the row names
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); j := cp_number(id, ".s");
    if cp_running(s) && turn == s[0].nturns - 1 && j >= 0 && j < s[0].turns[turn].nagents && s[0].turns[turn].agents[j].state == CP_RUNNING { s[0].stop_agent = j; s[0].ask = CP_ASK_STOP_AGENT; }
    return true;
  }
  if act == CP_PANE_STOP { if cp_running(s) && s[0].pane_turn == s[0].nturns - 1 && s[0].pane_agent >= 0 && s[0].pane_agent < s[0].turns[s[0].pane_turn].nagents && s[0].turns[s[0].pane_turn].agents[s[0].pane_agent].state == CP_RUNNING { s[0].stop_agent = s[0].pane_agent; s[0].ask = CP_ASK_STOP_AGENT; } return true; }
  if act == CP_REVIEW {
    // the code review opens in the pane, its tab in front; a press while it shows closes it
    if s[0].review && cp_review_shown(s) { s[0].review = false; return true; }
    s[0].review = true; s[0].pane_tab = CP_TAB_CHANGES;
    s[0].ask = CP_ASK_GIT_DIFF;
    return true;
  }
  if act == CP_PANE_TAB {
    tab := cp_number(surface_id(s[0].surface[..], row), "coder.pane.tab.");
    if tab < 0 || !s[0].review || !s[0].pane_open { return false; }
    s[0].pane_tab = ifx tab == 0 then CP_TAB_AGENT else CP_TAB_CHANGES;
    return true;
  }
  if act == CP_REVIEW_FILE { return app_diff_press(s[0].keyed[..], "coder.review", surface_id(s[0].surface[..], row)); }
  if act >= CP_REVIEW_REFRESH && act <= CP_REVIEW_CLEAR { return cp_gd_press(s, act, surface_id(s[0].surface[..], row)); }
  if act == CP_PANE_TOOL {
    // a row of the open sub-agent's activity group (#13744): it opens, or its file opens
    id := surface_id(s[0].surface[..], row);
    k := cp_number(id, ".x"); tb: [EL_ID] u8;
    if !s[0].pane_open || k < 0 { return false; }
    rid := cp_pane_id(tb[..], s, ".x", k);
    if app_act_path_pressed(rid, id) {
      q := cp_nth(s, s[0].pane_turn, s[0].pane_agent, k - s[0].turns[s[0].pane_turn].agents[s[0].pane_agent].early_rows);
      return q >= 0 && cp_open_file(s, q, s[0].pane_turn, -1);
    }
    return app_act_press(s[0].keyed[..], rid, id);
  }
  if act == CP_PANE_COPY {
    block := cp_number(surface_id(s[0].surface[..], row), ".code.");
    if !s[0].pane_open || block < 0 { return false; }
    s[0].copied_turn = s[0].pane_turn; s[0].copied_block = block; s[0].copied_kind = CP_COPIED_PANE; s[0].ask = CP_ASK_COPY; return true;
  }
  if act == CP_CHAT {
    id := surface_id(s[0].surface[..], row);
    for q: 0..<s[0].nchats {
      if id == cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n] {
        if cp_sb_chat_click(s, q) { return true; }
        if id == cast(string) s[0].current[0..<s[0].current_n] { return false; }
        s[0].open = q; s[0].ask = CP_ASK_OPEN; return true;
      }
    }
    return false;
  }
  if act == CP_FU { return cp_fu_press(s, surface_id(s[0].surface[..], row)); }
  if act == CP_FU_DRAFT {
    if !cp_running(s) || eb_text(s[0].draft[..]).count == 0 { return false; }
    return cp_fu_ask(s, ifx surface_id(s[0].surface[..], row) == "coder.fu.queue" then CP_FUO_QUEUE else CP_FUO_STEER, -1);
  }
  if act == CP_TODOS_TOGGLE { return cp_todos_toggle(s); }
  if act == CP_PERMIT_OPT {
    idx := cp_number(surface_id(s[0].surface[..], row), "coder.permit.opt.");
    return cp_permit_choose(s, true, idx);
  }
  if act == CP_PERMIT_DENY { return cp_permit_choose(s, false, -1); }
  if act == CP_PERMIT_PLAN_APPROVE || act == CP_PERMIT_PLAN_REVISE { return cp_permit_plan_action(s, act); }
  if act == CP_PERMIT_SECRET_ENTER { return cp_permit_secret_enter(s); }
  if act == CP_MCP_OAUTH_SIGNIN || act == CP_MCP_OAUTH_DISMISS { return cp_mcp_oauth_press(s, act); }
  if act == CP_FIELD { cp_ed_focus(s, CP_KB_COMPOSER); return true; }
  if act == CP_SEND {
    if cp_running(s) { s[0].turns[s[0].nturns - 1].stopping = true; s[0].ask = CP_ASK_STOP; return true; }
    return cp_send(s);
  }
  if act == CP_NEW { return cp_new(s); }
  if act == CP_PALETTE { cp_palette_show(s, APP_PAL_SESSIONS); return true; }
  if act == CP_FOREMAN { s[0].ask = CP_ASK_FOREMAN; return true; }
  if act == CP_GYM { s[0].ask = CP_ASK_GYM; return true; }
  if act == CP_UPDATE { s[0].ask = CP_ASK_UPDATE; return true; }
  if act == CP_SIDE_TOGGLE { s[0].side_collapsed = !s[0].side_collapsed; return true; }
  if act == CP_FOREMAN_HUD_TOGGLE { s[0].foreman_hud_collapsed = !s[0].foreman_hud_collapsed; return true; }
  if act == CP_FOREMAN_HUD_OPEN {
    id := surface_id(s[0].surface[..], row);
    prefix := "foreman.node.";
    if id.count > prefix.count && id[0..<prefix.count] == prefix {
      cid := id[prefix.count..<id.count];
      for q: 0..<s[0].nchats {
        if cid == cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n] { s[0].open = q; s[0].ask = CP_ASK_OPEN; return true; }
      }
    }
    return false;
  }
  if act == CP_FOLDER { if cp_running(s) { return false; } s[0].model_menu = false; s[0].ask = CP_ASK_FOLDER; return true; }
  if act == CP_ASK_ADD_PRESS { s[0].model_menu = false; s[0].ask = CP_ASK_ADD; return true; }
  if act == CP_CARGO || act == CP_CARGO_REMOVE { return cp_cargo_press(s, surface_id(s[0].surface[..], row), act == CP_CARGO_REMOVE); }
  if act == CP_TOAST_CLOSE { return app_toast_dismiss(s[0].toasts[..], app_toast_pressed(surface_id(s[0].surface[..], row)), s[0].clock); }
  if act == CP_MENTION { return cp_mn_pick(s, app_mn_pressed("coder.mention", surface_id(s[0].surface[..], row))); }
  if act == CP_EFFORT_CYCLE { s[0].model_menu = false; cp_effort_cycle(s); return true; }
  if act == CP_FRESH_TOGGLE { s[0].model_menu = false; s[0].prov[0].fresh_session = !s[0].prov[0].fresh_session; return true; }
  if act == CP_FANOUT_OPEN { s[0].model_menu = false; s[0].ask = CP_ASK_FANOUT_PICK; return true; }
  if act == CP_MODEL_MENU {
    s[0].usage[0].popover_open = false;
    s[0].model_menu = !s[0].model_menu;
    return true;
  }
  if act == CP_USAGE_POPOVER {
    s[0].model_menu = false;
    s[0].usage[0].popover_open = !s[0].usage[0].popover_open;
    return true;
  }
  if act == CP_USAGE_OPEN {
    s[0].usage[0].popover_open = false;
    cp_settings_show(s, true, CP_PG_USAGE);
    return true;
  }
  if act == CP_USAGE_REFRESH {
    s[0].ask = CP_ASK_USAGE_REFRESH;
    return true;
  }
  if act == CP_MODEL_PICK {
    idx := cp_number(surface_id(s[0].surface[..], row), "coder.model.");
    s[0].model_menu = false;
    if idx < 0 || idx >= cp_models(s) { return false; }
    s[0].model = idx;
    return true;
  }
  if act == CP_COPY {
    id := surface_id(s[0].surface[..], row);
    turn := cp_number(id, "t"); block := cp_number(id, ".code.");
    if turn < 0 || turn >= s[0].nturns || block < 0 { return false; }
    s[0].copied_turn = turn; s[0].copied_block = block; s[0].copied_kind = CP_COPIED_BLOCK; s[0].ask = CP_ASK_COPY; return true;
  }
  if act == CP_COPY_ASK || act == CP_COPY_REPLY {
    turn := cp_number(surface_id(s[0].surface[..], row), "t");
    if turn < 0 || turn >= s[0].nturns { return false; }
    s[0].copied_turn = turn; s[0].copied_block = -1; s[0].copied_kind = ifx act == CP_COPY_ASK then CP_COPIED_ASK else CP_COPIED_REPLY; s[0].copied_at = s[0].clock; s[0].ask = CP_ASK_COPY; return true;
  }
  if act == CP_COPY_ALL {
    if s[0].nturns == 0 { return false; }
    s[0].copied_turn = 0; s[0].copied_block = -1; s[0].copied_kind = CP_COPIED_ALL; s[0].ask = CP_ASK_COPY; return true;
  }
  if act == CP_BUDGET_EDIT { s[0].ask = CP_ASK_BUDGET; return true; }
  if act == CP_BUDGET_APPROVE {
    s[0].budget_override = true;
    if s[0].goal_status == CP_GOAL_BUDGET_LIMITED { s[0].goal_status = CP_GOAL_ACTIVE; }
    return true;
  }
  if act == CP_GOAL_OPEN { s[0].ask = CP_ASK_GOAL; return true; }
  if act == CP_GOAL_TOGGLE {
    if s[0].goal_status == CP_GOAL_ACTIVE { return cp_goal_set_status(s, CP_GOAL_PAUSED); }
    if s[0].goal_status != CP_GOAL_NONE { return cp_goal_set_status(s, CP_GOAL_ACTIVE); }
    return false;
  }
  if act == CP_GOAL_COMPLETE_ACT { return cp_goal_set_status(s, CP_GOAL_COMPLETE); }
  if act == CP_GOAL_CLEAR_ACT { return cp_goal_clear(s); }
  return false;
}


// Which sidebar's edge is at x: 1 the chats', 2 a sub-agent's transcript's, 0 neither. A
// transcript that takes the whole window has no edge.
cp_edge :: (s: [] CoderPage, ux: f32) -> int {
  if s[0].side > 0 && abs(ux - s[0].side) <= CP_EDGE { return 1; }
  if (s[0].pane_open || s[0].review || s[0].fp[0].open || s[0].ft[0].open || s[0].sim[0].open || s[0].term[0].open || s[0].rich[0].side_open || s[0].forge[0].open || s[0].todos[0].n > 0) && s[0].pane_w > 0 && s[0].pane_x > 0 && abs(ux - s[0].pane_x) <= CP_EDGE { return 2; }
  return 0;
}
// True while the pointer is on a sidebar's edge or drags one: the host shows the resize cursor.
coder_page_edge :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && (s[0].drag != 0 || s[0].hover != 0);
}
// The sidebars' widths as dragged, into out[0] (the chats') and out[1] (the transcript's), 0 for
// one never dragged. True once after a drag ends: the host keeps them.
coder_page_sides :: (s: [] CoderPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 2 { return false; }
  out[0] = s[0].side_w; out[1] = s[0].pane_user;
  due := s[0].sides_due; s[0].sides_due = false;
  return due;
}
// The widths the host kept. One outside its limits is put inside them; 0 leaves the usual width.
coder_page_sides_set :: (s: [] CoderPage, left: f32, right: f32) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].side_w = app_sidebar_clamp(left, cp_sidebar_spec());
  s[0].pane_user = app_pane_clamp(right, cp_pane_spec());
}
// A click, in device pixels: phase 0 down, 1 moved, 2 up, 3 cancelled, routed through the committed rows.
coder_page_pointer :: (s: [] CoderPage, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return false; }
  ux := x / s[0].d; uy := y / s[0].d;
  s[0].px = ux; s[0].py = uy;
  if cp_minimap_pointer(s, ux, uy, phase) { return true; }
  row := surface_hit(s[0].surface[..], ux, uy);
  id := surface_id(s[0].surface[..], row);
  acts := surface_action(s[0].surface[..], row) != 0;
  was := cast(string) s[0].pressed[0..<s[0].pressed_n];
  // a sidebar's edge: a press on it takes hold, a move drags it, and the conversation keeps 380 points
  if phase == 0 { s[0].drag = cp_edge(s, ux); if s[0].drag != 0 { s[0].touching = false; s[0].pressed_n = 0; return true; } }
  if s[0].drag != 0 {
    if phase == 1 {
      if s[0].drag == 1 {
        s[0].side_w = app_sidebar_drag(ux, s[0].win_w, s[0].pane_w, cp_sidebar_spec());
      } else {
        s[0].pane_user = app_pane_drag(ux, s[0].win_w, s[0].side, cp_pane_spec());
      }
      return true;
    }
    s[0].drag = 0; s[0].sides_due = true; s[0].hover = cp_edge(s, ux);
    return true;
  }
  if phase == 1 { s[0].hover = cp_edge(s, ux); }
  if phase == 0 { s[0].dx = ux; s[0].dy = uy; }
  // a click on a reply, where nothing else takes it, shows or hides who wrote it
  if phase == 2 && !acts && s[0].pressed_n == 0 && abs(ux - s[0].dx) < 3 && abs(uy - s[0].dy) < 3 && ux >= s[0].col_x && ux < s[0].col_x + s[0].col_w {
    for i: 0..<s[0].nturns {
      if s[0].turns[i].ah > 0 && uy >= s[0].turns[i].ay && uy < s[0].turns[i].ay + s[0].turns[i].ah && uy < s[0].view {
        s[0].turns[i].info = !s[0].turns[i].info; s[0].touching = false; return true;
      }
    }
  }
  if phase == 0 && s[0].model_menu {
    act := surface_action(s[0].surface[..], row);
    if act != CP_MODEL_MENU && act != CP_MODEL_PICK {
      s[0].model_menu = false;
      return true;
    }
  }
  if phase == 0 && s[0].usage[0].popover_open {
    act := surface_action(s[0].surface[..], row);
    if act != CP_USAGE_POPOVER && act != CP_USAGE_OPEN && act != CP_USAGE_REFRESH && id != "coder.usage.popover" {
      s[0].usage[0].popover_open = false;
      return true;
    }
  }
  if phase == 0 && s[0].ft[0].editor_menu {
    act := surface_action(s[0].surface[..], row);
    if act != CP_FT_EDITOR_MENU && act != CP_FT_EDITOR_PICK && id != "coder.ft.edmenu" {
      s[0].ft[0].editor_menu = false;
      return true;
    }
  }
  if phase == 0 {
    s[0].touching = true;
    s[0].pressed_n = ifx acts then el_copy(s[0].pressed[..], id) else 0;
    s[0].pin_drag = 0; s[0].pin_dragging = false;
    if surface_action(s[0].surface[..], row) == CP_CHAT && cp_pin_count(s) > 1 {
      for q: 0..<s[0].nchats {
        if s[0].chats[q].pinned && id == cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n] {
          s[0].pin_drag = q + 1;
          s[0].pin_drop = cp_pin_index(s, q);
          break;
        }
      }
    }
    return acts;
  }
  if phase == 1 {
    if s[0].touching && s[0].pin_drag > 0 {
      if !s[0].pin_dragging && abs(uy - s[0].dy) >= 4.0f32 {
        s[0].pin_dragging = true;
        s[0].pressed_n = 0;
      }
      if s[0].pin_dragging {
        np := cp_pin_count(s);
        rh := ifx s[0].pin_row_h > 0 then s[0].pin_row_h else 32.0f32;
        idx := ifx uy <= s[0].pin_top then 0 else cast(int) ((uy - s[0].pin_top) / rh);
        if idx >= np { idx = np - 1; }
        if idx < 0 { idx = 0; }
        s[0].pin_drop = idx;
        return true;
      }
    }
    if was != id { s[0].pressed_n = 0; }
    return s[0].pressed_n > 0;
  }
  if s[0].pin_drag > 0 {
    q := s[0].pin_drag - 1;
    was_dragging := s[0].pin_dragging;
    target := s[0].pin_drop;
    s[0].pin_drag = 0; s[0].pin_dragging = false;
    if was_dragging {
      s[0].touching = false; s[0].pressed_n = 0;
      if q >= 0 && q < s[0].nchats && s[0].chats[q].pinned {
        tmp: [CP_CHAT_ID] u8;
        tmp_n := cp_out(tmp[..], cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n]);
        if cp_pin_reorder(s, q, target) {
          s[0].pin_move_id_n = cp_out(s[0].pin_move_id[..], cast(string) tmp[0..<tmp_n]);
          s[0].pin_move_to = target;
          s[0].ask = CP_ASK_REORDER_PIN;
        }
      }
      return true;
    }
  }
  held := s[0].pressed_n > 0 && was == id;
  s[0].touching = false; s[0].pressed_n = 0;
  return phase == 2 && held && cp_press(s, row);
}
// The wheel, in device pixels, down positive: a mouse's notch (it never stretches or coasts).
coder_page_wheel :: (s: [] CoderPage, dy: f32) #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return; }
  cp_scroll_at(s, cp_scroll_under(s), dy / s[0].d, UI_SCROLL_WHEEL, s[0].now);
}
// The wheel as the platform reports it, with its trackpad gesture (ui-host.h scroll_gesture): dy in
// points the fingers' way (a mouse's notches in lines), phase and momentum 0 none, 1 touched, 2 moved,
// 3 lifted, time on the host's clock. The transcript, the chats and a sub-agent's pane coast, stretch
// and show their rail (components/core/scroll.coax); settings' lists move as the deltas come.
coder_page_scroll :: (s: [] CoderPage, dy: f32, precise: bool, phase: int, momentum: int, time: f64) #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return; }
  delta := -dy * (ifx precise then 1.0f32 else CP_WHEEL_LINE) / cp_scale(s);
  kind := ifx momentum != 0 then UI_SCROLL_MOMENTUM else ifx phase == 1 then UI_SCROLL_BEGAN else ifx phase == 2 then UI_SCROLL_MOVED else ifx phase == 3 then UI_SCROLL_ENDED else UI_SCROLL_WHEEL;
  if s[0].set_open { cp_scroll_at(s, CP_SCR_SETTINGS, delta, kind, time); return; }
  // a gesture stays with the view it began over
  if kind == UI_SCROLL_WHEEL || kind == UI_SCROLL_BEGAN { s[0].scr_at = cp_scroll_under(s); }
  cp_scroll_at(s, s[0].scr_at, delta, kind, time);
}
CP_WHEEL_LINE :: 22.75f32;   // GPUI's line, in points: a mouse's notch
CP_SCR_TALK :: 0; CP_SCR_SIDE :: 1; CP_SCR_PANE :: 2; CP_SCR_SETTINGS :: 3; CP_SCR_REVIEW :: 4;
// The view under the pointer.
cp_scroll_under :: (s: [] CoderPage) -> int {
  if s[0].set_open { return CP_SCR_SETTINGS; }
  if s[0].side > 0 && s[0].px < s[0].side { return CP_SCR_SIDE; }
  if s[0].gym_open && s[0].gym_mode == CP_GYM_LEAN { return CP_SCR_LEAN; }
  if cp_forge_shown(s) && s[0].pane_w > 0 && s[0].px >= s[0].pane_x { return CP_SCR_FORGE; }
  if cp_side_chat_shown(s) && s[0].pane_w > 0 && s[0].px >= s[0].pane_x { return CP_SCR_SIDE_CHAT; }
  if cp_term_shown(s) && s[0].pane_w > 0 && s[0].px >= s[0].pane_x { return CP_SCR_TERM; }
  if cp_fp_shown(s) && s[0].pane_w > 0 && s[0].px >= s[0].pane_x {
    if s[0].ft[0].tree_w > 0 && s[0].px >= s[0].ft[0].tree_x && s[0].px < s[0].ft[0].tree_x + s[0].ft[0].tree_w { return CP_SCR_FILETREE; }
    return CP_SCR_FILE;
  }
  if cp_review_shown(s) && s[0].pane_w > 0 && s[0].px >= s[0].pane_x { return CP_SCR_REVIEW; }
  if s[0].pane_open && s[0].pane_w > 0 && s[0].px >= s[0].pane_x { return CP_SCR_PANE; }
  return CP_SCR_TALK;
}
// delta points (down positive) of kind UI_SCROLL_* to a view. Scrolling up lets go of the newest message.
cp_scroll_at :: (s: [] CoderPage, view: int, delta: f32, kind: int, time: f64) {
  r := s[0].reduced;
  moved := delta != 0 && kind != UI_SCROLL_MOMENTUM;
  if view == CP_SCR_SETTINGS {
    // in settings the wheel moves the list of pages or the page
    if s[0].px < s[0].side { s[0].set_list_scroll = scroll_clamp(s[0].set_list_scroll + delta, s[0].set_list_content, s[0].set_list_view); }
    else { s[0].set_scroll = scroll_clamp(s[0].set_scroll + delta, s[0].set_content, s[0].set_view); }
    return;
  }
  if view == CP_SCR_SIDE { s[0].side_scroll = ui_scroll_by(s[0].side_scr[..], scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view), delta, s[0].side_content, s[0].side_view, kind, time, r); return; }
  // the code review moves as the deltas come, the platform's own coast included
  if view == CP_SCR_FORGE { cp_forge_scroll(s, delta); return; }
  if view == CP_SCR_LEAN { _ = cp_lean_wheel(s, -delta); return; }
  if view == CP_SCR_SIDE_CHAT { cp_side_chat_scroll(s, delta); return; }
  if view == CP_SCR_TERM { cp_term_scroll(s, delta); return; }
  if view == CP_SCR_FILETREE { cp_ft_scroll(s, delta); return; }
  if view == CP_SCR_FILE { cp_fp_scroll(s, delta); return; }
  if view == CP_SCR_REVIEW { s[0].review_scroll = scroll_clamp(s[0].review_scroll + delta, s[0].review_content, s[0].pane_view); return; }
  if view == CP_SCR_PANE {
    if !s[0].pane_open { return; }
    s[0].pane_scroll = ui_scroll_by(s[0].pane_scr[..], s[0].pane_scroll, delta, s[0].pane_content, s[0].pane_view, kind, time, r);
    if moved { s[0].pane_stick = s[0].pane_scroll >= s[0].pane_content - s[0].pane_view - 1; }
    return;
  }
  if moved { s[0].glide_on = false; }   // a scroll takes the view from a glide
  s[0].scroll = ui_scroll_by(s[0].scr[..], s[0].scroll, delta, s[0].content, s[0].view, kind, time, r);
  if moved && delta < 0 { s[0].stick = false; }
  if moved && s[0].scroll >= s[0].content - s[0].view - 1 { s[0].stick = true; }
}
// The transcript goes to its end (#13745): it glides there over CP_GLIDE (outQuad), as a send
// does in Zeron, and rests there; from more than three views up it lands at once, and with
// Reduce Motion it is there at once.
cp_glide_end :: (s: [] CoderPage) {
  end := s[0].content - s[0].view; if end < 0 { end = 0; }
  s[0].scr[0].coasting = false;
  if s[0].reduced || s[0].view <= 0 || end - s[0].scroll <= 0.5 || end - s[0].scroll > 3 * s[0].view { s[0].stick = true; s[0].glide_on = false; return; }
  s[0].glide_on = true; s[0].glide_from = s[0].scroll; s[0].glide_t = 0; s[0].stick = false;
}
// A chat shown afresh: no glide, at its end, nothing unseen.
cp_glide_reset :: (s: [] CoderPage) { s[0].glide_on = false; s[0].away_t = 0; s[0].unseen = false; s[0].at_end = true; }
// Each view's coast and spring for a refresh shown at `shows`; whether any still moves.
cp_scroll_step :: (s: [] CoderPage, shows: f64) -> bool {
  r := s[0].reduced;
  if s[0].scr[0].coasting || s[0].scr[0].spring {
    was := s[0].scroll;
    s[0].scroll = ui_scroll_step(s[0].scr[..], s[0].scroll, s[0].content, s[0].view, shows, r);
    if s[0].scroll < was { s[0].stick = false; }
    else if s[0].scroll >= s[0].content - s[0].view - 1 { s[0].stick = true; }
  }
  if s[0].side_scr[0].coasting || s[0].side_scr[0].spring { s[0].side_scroll = ui_scroll_step(s[0].side_scr[..], scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view), s[0].side_content, s[0].side_view, shows, r); }
  if s[0].pane_open && (s[0].pane_scr[0].coasting || s[0].pane_scr[0].spring) {
    s[0].pane_scroll = ui_scroll_step(s[0].pane_scr[..], s[0].pane_scroll, s[0].pane_content, s[0].pane_view, shows, r);
    s[0].pane_stick = s[0].pane_scroll >= s[0].pane_content - s[0].pane_view - 1;
  }
  return ui_scroll_moving(s[0].scr[..], s[0].now) || ui_scroll_moving(s[0].side_scr[..], s[0].now) || s[0].pane_open && ui_scroll_moving(s[0].pane_scr[..], s[0].now);
}
