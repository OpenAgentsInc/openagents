// Coder Desktop page (../page.coax): Universal Introspection sidebar sections
// (TUI & Terminal, Other Harnesses, Machines) and main-pane live output inspector
// (docs/desktop/2026-11-26-unfettered-harness-spec.md §3.3, GitHub #14066).
// Reconciled with #14071: external local harnesses are discovered strictly read-only
// and default non-commandable unless opted in via Settings -> Agent.

CP_SCR_INTROSPECT :: 15;

// Host asks (free after CP_ASK_BR_LAST :: 249).
CP_ASK_INTROSPECT_REFRESH :: 250; // Re-scan local tmux/TUI/harnesses and remote machines
CP_ASK_INTROSPECT_INSPECT :: 251; // Fetch/refresh live output for active_id
CP_ASK_INTROSPECT_SEND :: 252;    // Send direct command/prompt/keystrokes to active_id (#14067)
CP_ASK_INTROSPECT_CONNECT :: 253; // Connect or open Settings -> Connections for active machine
CP_ASK_INTROSPECT_COPY :: 254;    // Copy inspected live output to clipboard
CP_ASK_INTROSPECT_STOP :: 255;    // Stop / send Ctrl-C to active_id (#14067)

// Row actions (free after CP_BR_ACT_LAST :: 579).
CP_IS_ACT_FIRST :: 580;
CP_IS_TOGGLE_TUI :: 580;
CP_IS_TOGGLE_HARNESS :: 581;
CP_IS_TOGGLE_MACHINES :: 582;
CP_IS_TOGGLE_MACHINE :: 583;
CP_IS_SELECT_SESSION :: 584;
CP_IS_INSPECT_CLOSE :: 585;
CP_IS_INSPECT_REFRESH :: 586;
CP_IS_INSPECT_COPY :: 587;
CP_IS_INSPECT_CONNECT :: 588;
CP_IS_INSPECT_SETTINGS :: 589;
CP_IS_INSPECT_SEND :: 590;
CP_IS_INSPECT_STOP :: 591;
CP_IS_INSPECT_FOCUS :: 592;
CP_IS_ACT_LAST :: 595;

CP_IS_OUTPUT_MAX :: 16384;
CP_IS_MAX_LINES :: 260;
CP_IS_CMD_MAX :: 4096;

CpIntrospect :: struct {
  snap: [1] IntrospectSnapshot;
  tui_collapsed: bool;
  harness_collapsed: bool;
  machines_collapsed: bool;
  machine_collapsed: [IS_MAX_MACHINES] bool;
  open: bool;
  inspect_is_machine: bool;
  active_id: [IS_ID_MAX] u8; active_id_n: int;
  output: [CP_IS_OUTPUT_MAX] u8; output_n: int;
  output_status: [128] u8; output_status_n: int;
  loading: bool;
  cmd_draft: [CP_IS_CMD_MAX] u8; cmd_draft_n: int;
  pending_cmd: [CP_IS_CMD_MAX] u8; pending_cmd_n: int;
  cmd_sending: bool;
  cmd_note: [256] u8; cmd_note_n: int;
  cmd_note_err: bool;
  scroll: f32; content: f32; view: f32; stick: bool;
  scr: [1] UiScroll;
}

// ---------------------------------------------------------------- lifecycle & helpers

cp_introspect_init :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  s[0].introspect[0] = CpIntrospect.{};
  s[0].introspect[0].stick = true;
}

cp_introspect_close :: (s: [] CoderPage) {
  if s.count < 1 { return; }
  s[0].introspect[0].open = false;
}

cp_introspect_scroll :: (s: [] CoderPage, delta: f32) {
  if s.count < 1 || !s[0].introspect[0].open { return; }
  ip := s[0].introspect[..];
  ip[0].scroll = scroll_clamp(ip[0].scroll + delta, ip[0].content, ip[0].view);
  if delta < 0.0f32 { ip[0].stick = false; }
  else if ip[0].scroll >= ip[0].content - ip[0].view - 1.0f32 { ip[0].stick = true; }
}

cp_introspect_harness_icon :: (h: int) -> int {
  if h == IS_HARNESS_CLAUDE { return ICON_CLAUDE; }
  if h == IS_HARNESS_CODEX { return ICON_OPENAI; }
  if h == IS_HARNESS_AGY { return ICON_ANTIGRAVITY; }
  if h == IS_HARNESS_INKLING || h == IS_HARNESS_OPENAGENTS { return ICON_PSIONIC; }
  if h == IS_HARNESS_TMUX || h == IS_HARNESS_TUI { return ICON_TERMINAL; }
  return ICON_BOT;
}

cp_introspect_side_busy :: (s: [] CoderPage) -> bool {
  if s.count < 1 { return false; }
  snap := s[0].introspect[0].snap[..];
  for i: 0..<snap[0].nsessions {
    if snap[0].sessions[i].status == IS_ST_RUNNING { return true; }
  }
  return false;
}

cp_introspect_active_id :: (s: [] CoderPage) -> string {
  if s.count < 1 { return ""; }
  return is_str(s[0].introspect[0].active_id[..], s[0].introspect[0].active_id_n);
}

// Whether the currently inspected session accepts direct commands (#14067).
// Reconciled with #14071: external local harnesses require allow_local_harnesses opt-in.
cp_introspect_can_command :: (s: [] CoderPage) -> bool {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if !ip[0].open || ip[0].inspect_is_machine { return false; }
  idx := is_find_session(ip[0].snap[..], cp_introspect_active_id(s));
  if idx < 0 { return false; }
  sess := ip[0].snap[0].sessions[idx];
  if is_harness_is_external(sess.harness) {
    return cp_flawed_allow_local_harnesses(s) && sess.commandable;
  }
  return sess.commandable;
}

cp_introspect_composer_active :: (s: [] CoderPage) -> bool {
  return cp_introspect_can_command(s);
}

cp_introspect_cmd_draft :: (s: [] CoderPage) -> string {
  if s.count < 1 { return ""; }
  return cast(string) s[0].introspect[0].cmd_draft[0..<s[0].introspect[0].cmd_draft_n];
}

cp_introspect_cmd_draft_set :: (s: [] CoderPage, text: string) {
  if s.count < 1 { return; }
  s[0].introspect[0].cmd_draft_n = is_copy(s[0].introspect[0].cmd_draft[..], text);
}

cp_introspect_submit :: (s: [] CoderPage) -> bool {
  if !cp_introspect_can_command(s) { return false; }
  ip := s[0].introspect[..];
  cmd := cast(string) ip[0].cmd_draft[0..<ip[0].cmd_draft_n];
  if is_trim(cmd).count == 0 { return false; }
  ip[0].pending_cmd_n = is_copy(ip[0].pending_cmd[..], cmd);
  ip[0].cmd_draft_n = 0;
  ip[0].cmd_sending = true;
  ip[0].cmd_note_n = is_copy(ip[0].cmd_note[..], "Sending command…");
  ip[0].cmd_note_err = false;
  s[0].ask = CP_ASK_INTROSPECT_SEND;
  return true;
}

// Replaces all sessions of `kind` with `fresh` while preserving all other kinds in order.
cp_introspect_replace_kind :: (s: [] CoderPage, kind: int, fresh: [] IntrospectSession) {
  if s.count < 1 { return; }
  snap := s[0].introspect[0].snap[..];
  merged: [IS_MAX_SESSIONS] IntrospectSession;
  n := 0;
  for i: 0..<snap[0].nsessions {
    if snap[0].sessions[i].kind != kind && n < IS_MAX_SESSIONS {
      merged[n] = snap[0].sessions[i];
      n += 1;
    }
  }
  for j: 0..<fresh.count {
    if n >= IS_MAX_SESSIONS { break; }
    fid := is_str(fresh[j].id[..], fresh[j].id_n);
    if fid.count == 0 { continue; }
    dup := false;
    for k: 0..<n {
      if is_str(merged[k].id[..], merged[k].id_n) == fid { dup = true; break; }
    }
    if dup { continue; }
    merged[n] = fresh[j];
    n += 1;
  }
  for i: 0..<n { snap[0].sessions[i] = merged[i]; }
  for i: n..<IS_MAX_SESSIONS { snap[0].sessions[i] = IntrospectSession.{}; }
  snap[0].nsessions = n;
}

// Builds one compact 2-line sidebar card row for an introspected session.
cp_introspect_session_row :: (s: [] CoderPage, f: [] UiFrame, idx: int, tree_line: bool) -> AppSideRow {
  ip := s[0].introspect[..];
  sess := ip[0].snap[0].sessions[idx];
  sh := f[0].sheet;
  sid := is_str(sess.id[..], sess.id_n);
  is_cur := ip[0].open && !ip[0].inspect_is_machine && sid.count > 0 && sid == cp_introspect_active_id(s);

  rb_id: [32] u8;
  rn := el_put(rb_id[..], 0, "coder.is.s.");
  rn = el_put_i(rb_id[..], rn, idx);
  row_id := sheet_pool(sh, cast(string) rb_id[0..<rn]);

  title_s := sheet_pool(sh, is_str(sess.title[..], sess.title_n));
  cwd_s := is_str(sess.cwd[..], sess.cwd_n);
  br_s := is_str(sess.branch[..], sess.branch_n);
  prev_s := is_str(sess.preview[..], sess.preview_n);
  repo_base := is_basename(cwd_s);
  repo_s := "";
  branch_s := "";
  lead_icon := -1;
  if repo_base.count > 0 {
    repo_s = sheet_pool(sh, repo_base);
    lead_icon = ifx sess.kind == IS_KIND_TUI then ICON_TERMINAL else ICON_FOLDER_11;
    if br_s.count > 0 { branch_s = sheet_pool(sh, br_s); }
    else if prev_s.count > 0 && prev_s != cwd_s { branch_s = sheet_pool(sh, prev_s); }
    else { branch_s = is_harness_label(sess.harness); }
  } else {
    repo_s = is_harness_label(sess.harness);
    lead_icon = ifx sess.kind == IS_KIND_TUI then ICON_TERMINAL else -1;
    if br_s.count > 0 { branch_s = sheet_pool(sh, br_s); }
    else if prev_s.count > 0 { branch_s = sheet_pool(sh, prev_s); }
  }

  st_str := "";
  if sess.updated_ms > 0 && s[0].sb[0].now_ms > 0 {
    ab: [12] u8;
    age := app_side_age(s[0].sb[0].now_ms, sess.updated_ms, ab[..]);
    if age.count > 0 { st_str = sheet_pool(sh, age); }
  } else if sess.status != IS_ST_RUNNING {
    st_str = is_status_label(sess.status);
  }

  skind := APP_SIDE_STATUS_NONE;
  busy := false;
  if sess.status == IS_ST_RUNNING {
    busy = true;
  } else if sess.status == IS_ST_WAITING {
    skind = APP_SIDE_STATUS_INPUT;
  } else if sess.status == IS_ST_ERROR {
    skind = APP_SIDE_STATUS_FAILED;
  } else if sess.kind == IS_KIND_TUI && sess.status == IS_ST_IDLE {
    skind = APP_SIDE_STATUS_ONLINE;
  }

  row_state := (ifx is_cur then EL_S_CURRENT else 0) | (ifx busy then EL_S_BUSY else 0);
  return AppSideRow.{
    id = row_id,
    title = title_s,
    state = row_state,
    status = st_str,
    icon = lead_icon,
    tree_line = tree_line,
    card = true,
    card_condensed = s[0].sb[0].condensed,
    repo = repo_s,
    branch = branch_s,
    harness_icon = cp_introspect_harness_icon(sess.harness),
    status_kind = skind,
    action = CP_IS_SELECT_SESSION
  };
}

// ---------------------------------------------------------------- sidebar sections

// Appends Universal Introspection collapsible sections (TUI & Terminal, Other Harnesses,
// Machines) to the sidebar row array whenever any items exist in each section.
cp_introspect_sidebar_rows :: (s: [] CoderPage, f: [] UiFrame, rows: [] AppSideRow, nrows_in: int) -> int {
  if s.count < 1 { return nrows_in; }
  ip := s[0].introspect[..];
  snap := ip[0].snap[..];
  sh := f[0].sheet;
  nrows := nrows_in;

  // 1. TUI & Terminal (tmux panes + standalone TUI sessions)
  ntui := is_count_kind(snap, IS_KIND_TUI);
  if ntui > 0 && nrows < rows.count {
    col := ip[0].tui_collapsed;
    cb: [16] u8; cn := el_put_i(cb[..], 0, ntui);
    tui_run := is_count_running(snap, IS_KIND_TUI) > 0;
    rows[nrows] = AppSideRow.{
      id = "coder.is.sec.tui",
      title = "TUI & Terminal",
      status = sheet_pool(sh, cast(string) cb[0..<cn]),
      icon = ICON_TERMINAL,
      state = EL_S_EXPANDS | (ifx !col then EL_S_EXPANDED else 0) | (ifx tui_run then EL_S_BUSY else 0),
      trail_icon = ifx col then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
      action = CP_IS_TOGGLE_TUI
    };
    nrows += 1;
    if !col {
      for i: 0..<snap[0].nsessions {
        if nrows >= rows.count { break; }
        if snap[0].sessions[i].kind != IS_KIND_TUI { continue; }
        rows[nrows] = cp_introspect_session_row(s, f, i, false);
        nrows += 1;
      }
    }
  }

  // 2. Other Harnesses (Claude Code, Codex, Antigravity, Cursor, OpenCode — read-only discovery)
  nhar := is_count_kind(snap, IS_KIND_HARNESS);
  if nhar > 0 && nrows < rows.count {
    col := ip[0].harness_collapsed;
    cb: [16] u8; cn := el_put_i(cb[..], 0, nhar);
    har_run := is_count_running(snap, IS_KIND_HARNESS) > 0;
    rows[nrows] = AppSideRow.{
      id = "coder.is.sec.harness",
      title = "Other Harnesses",
      status = sheet_pool(sh, cast(string) cb[0..<cn]),
      icon = ICON_BOT,
      state = EL_S_EXPANDS | (ifx !col then EL_S_EXPANDED else 0) | (ifx har_run then EL_S_BUSY else 0),
      trail_icon = ifx col then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
      action = CP_IS_TOGGLE_HARNESS
    };
    nrows += 1;
    if !col {
      for i: 0..<snap[0].nsessions {
        if nrows >= rows.count { break; }
        if snap[0].sessions[i].kind != IS_KIND_HARNESS { continue; }
        rows[nrows] = cp_introspect_session_row(s, f, i, false);
        nrows += 1;
      }
    }
  }

  // 3. Machines (Tailscale peers, SSH hosts, Boats, and their remote sessions)
  nmach := snap[0].nmachines;
  if nmach > 0 && nrows < rows.count {
    col := ip[0].machines_collapsed;
    cb: [16] u8; cn := el_put_i(cb[..], 0, nmach);
    rem_run := is_count_running(snap, IS_KIND_REMOTE) > 0;
    rows[nrows] = AppSideRow.{
      id = "coder.is.sec.machines",
      title = "Machines",
      status = sheet_pool(sh, cast(string) cb[0..<cn]),
      icon = ICON_GLOBAL,
      state = EL_S_EXPANDS | (ifx !col then EL_S_EXPANDED else 0) | (ifx rem_run then EL_S_BUSY else 0),
      trail_icon = ifx col then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
      action = CP_IS_TOGGLE_MACHINES
    };
    nrows += 1;
    if !col {
      act_id := cp_introspect_active_id(s);
      for mi: 0..<nmach {
        if nrows >= rows.count { break; }
        m := snap[0].machines[mi];
        mid := is_str(m.id[..], m.id_n);
        mname := is_str(m.label[..], m.label_n);
        if mname.count == 0 { mname = is_str(m.host[..], m.host_n); }
        m_col := ip[0].machine_collapsed[mi];
        is_mcur := ip[0].open && ip[0].inspect_is_machine && mid.count > 0 && mid == act_id;
        mb_id: [32] u8;
        mn := el_put(mb_id[..], 0, "coder.is.m.");
        mn = el_put_i(mb_id[..], mn, mi);

        st_txt := "";
        if m.session_count > 0 {
          sb: [16] u8; sn := el_put_i(sb[..], 0, m.session_count);
          st_txt = sheet_pool(sh, cast(string) sb[0..<sn]);
        } else {
          st_txt = is_machine_status_label(m.status);
        }

        mskind := APP_SIDE_STATUS_NONE;
        if m.status == IS_MACH_ONLINE { mskind = APP_SIDE_STATUS_ONLINE; }
        else if m.status == IS_MACH_CONNECTING { mskind = APP_SIDE_STATUS_APPROVAL; }
        else if m.status == IS_MACH_ERROR { mskind = APP_SIDE_STATUS_FAILED; }

        mstate := (ifx is_mcur then EL_S_CURRENT else 0) |
                  (ifx m.session_count > 0 then (EL_S_EXPANDS | (ifx !m_col then EL_S_EXPANDED else 0)) else 0);
        rows[nrows] = AppSideRow.{
          id = sheet_pool(sh, cast(string) mb_id[0..<mn]),
          title = sheet_pool(sh, mname),
          status = st_txt,
          icon = ICON_GLOBAL,
          trail_icon = ifx m.session_count > 0 then (ifx m_col then ICON_CHEVRON_RIGHT else ICON_CHEVRON) else -1,
          status_kind = mskind,
          state = mstate,
          quiet = m.status == IS_MACH_OFFLINE,
          action = CP_IS_TOGGLE_MACHINE
        };
        nrows += 1;

        if !m_col && m.session_count > 0 {
          for si: 0..<snap[0].nsessions {
            if nrows >= rows.count { break; }
            if snap[0].sessions[si].kind != IS_KIND_REMOTE { continue; }
            smid := is_str(snap[0].sessions[si].machine_id[..], snap[0].sessions[si].machine_id_n);
            if smid != mid { continue; }
            rows[nrows] = cp_introspect_session_row(s, f, si, true);
            nrows += 1;
          }
        }
      }
    }
  }
  return nrows;
}

// ---------------------------------------------------------------- actions & press dispatch

cp_introspect_open_session :: (s: [] CoderPage, idx: int) -> bool {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if idx < 0 || idx >= ip[0].snap[0].nsessions { return false; }
  sess := ip[0].snap[0].sessions[idx];
  sid := is_str(sess.id[..], sess.id_n);
  if sid.count == 0 { return false; }
  same := ip[0].open && !ip[0].inspect_is_machine && sid == cp_introspect_active_id(s);
  s[0].set_open = false;
  s[0].dash[0].open = false;
  s[0].wallet[0].open = false;
  s[0].gym_open = false;
  s[0].model_menu = false;
  s[0].effort_menu = false;
  s[0].side_drawer = false;
  ip[0].open = true;
  ip[0].inspect_is_machine = false;
  ip[0].active_id_n = is_copy(ip[0].active_id[..], sid);
  if !same {
    ip[0].output_n = 0;
    ip[0].output_status_n = is_copy(ip[0].output_status[..], "Loading live output…");
    ip[0].loading = true;
    ip[0].cmd_draft_n = 0;
    ip[0].pending_cmd_n = 0;
    ip[0].cmd_sending = false;
    ip[0].cmd_note_n = 0;
    ip[0].cmd_note_err = false;
    ip[0].scroll = 0.0f32;
    ip[0].stick = true;
  }
  if cp_introspect_can_command(s) {
    s[0].fld[0].kb = CP_KB_COMPOSER;
  }
  s[0].ask = CP_ASK_INTROSPECT_INSPECT;
  return true;
}

cp_introspect_open_machine :: (s: [] CoderPage, mi: int) -> bool {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if mi < 0 || mi >= ip[0].snap[0].nmachines { return false; }
  m := ip[0].snap[0].machines[mi];
  mid := is_str(m.id[..], m.id_n);
  if mid.count == 0 { return false; }
  same := ip[0].open && ip[0].inspect_is_machine && mid == cp_introspect_active_id(s);
  if m.session_count > 0 {
    if same {
      ip[0].machine_collapsed[mi] = !ip[0].machine_collapsed[mi];
      s[0].sb[0].shift_suppress = true;
      return true;
    }
    ip[0].machine_collapsed[mi] = false;
    s[0].sb[0].shift_suppress = true;
  }
  s[0].set_open = false;
  s[0].dash[0].open = false;
  s[0].wallet[0].open = false;
  s[0].gym_open = false;
  s[0].model_menu = false;
  s[0].effort_menu = false;
  s[0].side_drawer = false;
  ip[0].open = true;
  ip[0].inspect_is_machine = true;
  ip[0].active_id_n = is_copy(ip[0].active_id[..], mid);
  ip[0].loading = false;
  ip[0].scroll = 0.0f32;
  ip[0].stick = false;
  s[0].ask = CP_ASK_INTROSPECT_INSPECT;
  return true;
}

cp_introspect_press :: (s: [] CoderPage, act: int, id: string) -> bool {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if act == CP_IS_TOGGLE_TUI {
    ip[0].tui_collapsed = !ip[0].tui_collapsed;
    s[0].sb[0].shift_suppress = true;
    return true;
  }
  if act == CP_IS_TOGGLE_HARNESS {
    ip[0].harness_collapsed = !ip[0].harness_collapsed;
    s[0].sb[0].shift_suppress = true;
    return true;
  }
  if act == CP_IS_TOGGLE_MACHINES {
    ip[0].machines_collapsed = !ip[0].machines_collapsed;
    s[0].sb[0].shift_suppress = true;
    return true;
  }
  if act == CP_IS_TOGGLE_MACHINE {
    mi := cp_number(id, "coder.is.m.");
    return cp_introspect_open_machine(s, mi);
  }
  if act == CP_IS_SELECT_SESSION {
    si := cp_number(id, "coder.is.s.");
    return cp_introspect_open_session(s, si);
  }
  if act == CP_IS_INSPECT_CLOSE {
    ip[0].open = false;
    return true;
  }
  if act == CP_IS_INSPECT_REFRESH {
    ip[0].loading = true;
    s[0].ask = CP_ASK_INTROSPECT_INSPECT;
    return true;
  }
  if act == CP_IS_INSPECT_COPY {
    if ip[0].output_n <= 0 { return false; }
    s[0].ask = CP_ASK_INTROSPECT_COPY;
    return true;
  }
  if act == CP_IS_INSPECT_CONNECT {
    s[0].ask = CP_ASK_INTROSPECT_CONNECT;
    return true;
  }
  if act == CP_IS_INSPECT_SETTINGS {
    cp_settings_show(s, true, CP_PG_FLAWED);
    return true;
  }
  if act == CP_IS_INSPECT_SEND {
    return cp_introspect_submit(s);
  }
  if act == CP_IS_INSPECT_STOP {
    if !cp_introspect_can_command(s) { return false; }
    ip[0].cmd_note_n = is_copy(ip[0].cmd_note[..], "Sending interrupt (Ctrl-C)…");
    ip[0].cmd_note_err = false;
    s[0].ask = CP_ASK_INTROSPECT_STOP;
    return true;
  }
  if act == CP_IS_INSPECT_FOCUS {
    if !cp_introspect_can_command(s) { return false; }
    cp_ed_focus(s, CP_KB_COMPOSER);
    return true;
  }
  return false;
}

// ---------------------------------------------------------------- main-pane live inspector

cp_introspect_kv :: (f: [] UiFrame, id: string, label: string, value: string, mono: bool, x: f32, y_in: f32, w: f32, divider: bool) -> f32 {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  y := y_in;
  if divider {
    sheet_fill(sh, x, y, w, k.border, 0, k.hairline);
    y += 10.0f32;
  }
  val_face := ifx mono then FONT_MONO_12 else k.body.face;
  val_line := ifx mono then 17.0f32 else k.body.line;
  _ := sheet_text(sh, m, -1, x, y, k.small.line, k.small.face, k.muted, app_fit(f, k.small.face, label, w));
  y += k.small.line + 3.0f32;
  _ := uiframe_semantic(f, id, EL_TEXT, value, x, y_in, w, (y - y_in) + val_line, 0, 0);
  _ := sheet_text(sh, m, -1, x, y, val_line, val_face, k.ink, app_fit(f, val_face, value, w));
  return (y + val_line) - y_in;
}

cp_introspect_pane :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, h: f32) {
  if s.count < 1 { return; }
  k := f[0].skin; t := k.set; sh := f[0].sheet; m := f[0].m;
  ip := s[0].introspect[..];
  snap := ip[0].snap[..];
  area_w := w - left;
  if area_w <= 0.0f32 || h <= 0.0f32 { return; }

  sheet_fill(sh, left, 0, area_w, h, 0, k.canvas);

  act_id := cp_introspect_active_id(s);
  sidx := ifx !ip[0].inspect_is_machine then is_find_session(snap, act_id) else -1;
  midx := ifx ip[0].inspect_is_machine then is_find_machine(snap, act_id) else -1;

  hdr_title := "Introspection";
  if sidx >= 0 {
    hdr_title = sheet_pool(sh, is_str(snap[0].sessions[sidx].title[..], snap[0].sessions[sidx].title_n));
  } else if midx >= 0 {
    mn := is_str(snap[0].machines[midx].label[..], snap[0].machines[midx].label_n);
    if mn.count == 0 { mn = is_str(snap[0].machines[midx].host[..], snap[0].machines[midx].host_n); }
    hdr_title = sheet_pool(sh, mn);
  }
  cp_header_bar(s, f, left, w, hdr_title, w - CP_CORNER);

  can_cmd := !ip[0].inspect_is_machine && sidx >= 0 && cp_introspect_can_command(s);
  cmd_bar_h: f32 = ifx can_cmd then 92.0f32 else 0.0f32;

  top := cp_bar(s);
  view := h - top - cmd_bar_h;
  if view < 0.0f32 { view = 0.0f32; }
  ip[0].view = view;
  if ip[0].stick && ip[0].content > view {
    ip[0].scroll = ip[0].content - view;
  }
  ip[0].scroll = scroll_clamp(ip[0].scroll, ip[0].content, view);
  at := ip[0].scroll;

  uiframe_clip(f, left, top, w, h - cmd_bar_h);

  pad_x: f32 = 28.0f32;
  max_col: f32 = 860.0f32;
  cw := area_w - 2.0f32 * pad_x;
  if cw > max_col { cw = max_col; }
  if cw < 240.0f32 { cw = area_w - 20.0f32; }
  if cw < 160.0f32 { cw = area_w; }
  cx := left + (area_w - cw) * 0.5f32;
  y := top + 24.0f32 - at;
  y0 := y;

  // Top action toolbar row
  close_w := app_button_width(f, ICON_CLOSE, "Close");
  ref_w := app_button_width(f, ICON_RELOAD, "Refresh");
  rx := cx + cw;
  rx -= close_w;
  _ := app_button(f, "introspect.pane.close", rx, y, close_w, ICON_CLOSE, "Close", APP_BUTTON_QUIET, 0, CP_IS_INSPECT_CLOSE);
  rx -= ref_w + 8.0f32;
  _ := app_button(f, "introspect.pane.refresh", rx, y, ref_w, ICON_RELOAD, "Refresh", APP_BUTTON_DEFAULT, 0, CP_IS_INSPECT_REFRESH);
  if can_cmd {
    st_w := app_button_width(f, ICON_STOP, "Stop");
    rx -= st_w + 8.0f32;
    _ := app_button(f, "introspect.pane.stop", rx, y, st_w, ICON_STOP, "Stop", APP_BUTTON_DEFAULT, 0, CP_IS_INSPECT_STOP);
  }
  if !ip[0].inspect_is_machine && ip[0].output_n > 0 {
    cp_w := app_button_width(f, ICON_COPY, "Copy");
    rx -= cp_w + 8.0f32;
    _ := app_button(f, "introspect.pane.copy", rx, y, cp_w, ICON_COPY, "Copy", APP_BUTTON_DEFAULT, 0, CP_IS_INSPECT_COPY);
  }
  if ip[0].inspect_is_machine || (sidx >= 0 && snap[0].sessions[sidx].kind == IS_KIND_REMOTE) {
    cn_w := app_button_width(f, ICON_GLOBAL, "Connections");
    rx -= cn_w + 8.0f32;
    _ := app_button(f, "introspect.pane.connect", rx, y, cn_w, ICON_GLOBAL, "Connections", APP_BUTTON_DEFAULT, 0, CP_IS_INSPECT_CONNECT);
  }

  title_room := rx - cx - 12.0f32;
  if title_room < 80.0f32 { title_room = cw; }
  _ := uiframe_semantic(f, "introspect.pane.title", EL_TEXT, hdr_title, cx, y, title_room, t.title_line, 0, 0);
  _ := sheet_text(sh, m, -1, cx, y, t.title_line, t.title_face, k.ink, app_fit(f, t.title_face, hdr_title, title_room));
  y += t.title_line + 16.0f32;

  card_pad: f32 = 18.0f32;
  inner_w := cw - 2.0f32 * card_pad;
  if inner_w < 120.0f32 { inner_w = 120.0f32; }

  if ip[0].inspect_is_machine && midx >= 0 {
    mach := snap[0].machines[midx];
    // Machine metadata card
    kv_h := k.small.line + 3.0f32 + 17.0f32;
    c1_h := card_pad + k.small.line + 14.0f32 + kv_h + 2.0f32 * (10.0f32 + kv_h) + card_pad;
    _ := sheet_box(sh, cx, y, cw, c1_h, 12.0f32, k.border, k.raised, k.hairline);
    ix := cx + card_pad;
    iy := y + card_pad;

    // Status dot + header
    dot_c := ifx mach.status == IS_MACH_ONLINE then k.success
             else ifx mach.status == IS_MACH_ERROR then rgba(239, 68, 68, 0.95f32)
             else ifx mach.status == IS_MACH_CONNECTING then rgba(245, 158, 11, 0.95f32)
             else k.faint;
    sheet_fill(sh, ix, iy + (k.small.line - 7.0f32) * 0.5f32, 7.0f32, 7.0f32, 3.5f32, dot_c);
    mh_buf: [128] u8; mhn := el_put(mh_buf[..], 0, "MACHINE · ");
    mhn = el_put(mh_buf[..], mhn, is_machine_status_label(mach.status));
    mhn = el_put(mh_buf[..], mhn, " · ");
    mhn = el_put(mh_buf[..], mhn, is_transport_label(mach.transport));
    _ := sheet_text(sh, m, -1, ix + 14.0f32, iy, k.small.line, t.head_face, k.muted, app_fit(f, t.head_face, sheet_pool(sh, cast(string) mh_buf[0..<mhn]), inner_w - 14.0f32));
    iy += k.small.line + 14.0f32;

    addr_b: [192] u8; an := 0;
    if mach.user_n > 0 { an = el_put(addr_b[..], an, is_str(mach.user[..], mach.user_n)); an = el_put(addr_b[..], an, "@"); }
    an = el_put(addr_b[..], an, is_str(mach.host[..], mach.host_n));
    if mach.port > 0 && mach.port != 22 { an = el_put(addr_b[..], an, ":"); an = el_put_i(addr_b[..], an, mach.port); }
    iy += cp_introspect_kv(f, "introspect.mach.host", "Address", sheet_pool(sh, cast(string) addr_b[0..<an]), true, ix, iy, inner_w, false);

    os_s := ifx mach.os_n > 0 then sheet_pool(sh, is_str(mach.os[..], mach.os_n)) else "Unknown OS";
    iy += cp_introspect_kv(f, "introspect.mach.os", "Platform & Transport", os_s, false, ix, iy, inner_w, true);

    sc_b: [64] u8; scn := el_put_i(sc_b[..], 0, mach.session_count);
    scn = el_put(sc_b[..], scn, " total · ");
    scn = el_put_i(sc_b[..], scn, mach.running_count);
    scn = el_put(sc_b[..], scn, " running");
    _ := cp_introspect_kv(f, "introspect.mach.counts", "Remote Sessions", sheet_pool(sh, cast(string) sc_b[0..<scn]), false, ix, iy, inner_w, true);
    y += c1_h + 16.0f32;

    // Remote sessions list on this machine
    _ := sheet_text(sh, m, -1, cx, y, k.small.line, t.head_face, k.muted, "SESSIONS ON THIS MACHINE");
    y += k.small.line + 10.0f32;
    shown_r := 0;
    mach_id_s := is_str(mach.id[..], mach.id_n);
    for si: 0..<snap[0].nsessions {
      if snap[0].sessions[si].kind != IS_KIND_REMOTE { continue; }
      if is_str(snap[0].sessions[si].machine_id[..], snap[0].sessions[si].machine_id_n) != mach_id_s { continue; }
      rrow := cp_introspect_session_row(s, f, si, false);
      y += app_side_row_item(f, rrow, cx, y, cw, rrow.title, rrow.detail, CP_IS_SELECT_SESSION) + 4.0f32;
      shown_r += 1;
    }
    if shown_r == 0 {
      _ := sheet_box(sh, cx, y, cw, 64.0f32, 10.0f32, k.border, k.raised, k.hairline);
      _ := sheet_text(sh, m, -1, cx + card_pad, y + 22.0f32, k.small.line, k.small.face, k.muted,
        app_fit(f, k.small.face, "No active remote sessions reported. Open Connections to link this machine.", inner_w));
      y += 72.0f32;
    }
  } else if sidx >= 0 {
    sess := snap[0].sessions[sidx];
    // Session metadata card
    kv_h := k.small.line + 3.0f32 + 17.0f32;
    nfields := 2;
    if sess.cwd_n > 0 { nfields += 1; }
    if sess.machine_label_n > 0 { nfields += 1; }
    c1_h := card_pad + k.small.line + 14.0f32 + kv_h + cast(f32) (nfields - 1) * (10.0f32 + kv_h) + card_pad;
    _ := sheet_box(sh, cx, y, cw, c1_h, 12.0f32, k.border, k.raised, k.hairline);
    ix := cx + card_pad;
    iy := y + card_pad;

    dot_c := ifx sess.status == IS_ST_RUNNING || sess.status == IS_ST_IDLE then k.success
             else ifx sess.status == IS_ST_ERROR then rgba(239, 68, 68, 0.95f32)
             else ifx sess.status == IS_ST_WAITING then rgba(99, 102, 241, 0.95f32)
             else k.faint;
    sheet_fill(sh, ix, iy + (k.small.line - 7.0f32) * 0.5f32, 7.0f32, 7.0f32, 3.5f32, dot_c);
    sh_b: [160] u8; shn := el_put(sh_b[..], 0, is_kind_label(sess.kind));
    shn = el_put(sh_b[..], shn, " · ");
    shn = el_put(sh_b[..], shn, is_harness_label(sess.harness));
    shn = el_put(sh_b[..], shn, " · ");
    shn = el_put(sh_b[..], shn, is_status_label(sess.status));
    if sess.pid > 0 { shn = el_put(sh_b[..], shn, " · PID "); shn = el_put_i(sh_b[..], shn, sess.pid); }
    _ := sheet_text(sh, m, -1, ix + 14.0f32, iy, k.small.line, t.head_face, k.muted, app_fit(f, t.head_face, sheet_pool(sh, cast(string) sh_b[0..<shn]), inner_w - 14.0f32));
    iy += k.small.line + 14.0f32;

    iy += cp_introspect_kv(f, "introspect.pane.uri", "Session URI", sheet_pool(sh, is_str(sess.id[..], sess.id_n)), true, ix, iy, inner_w, false);

    mode_s := ifx can_cmd then "Interactive control (live output + direct commands)" else "Read-only live inspection";
    iy += cp_introspect_kv(f, "introspect.pane.mode", "Access", mode_s, false, ix, iy, inner_w, true);

    if sess.cwd_n > 0 {
      cwdb: [IS_CWD_MAX + IS_BRANCH_MAX + 8] u8;
      cn := el_put(cwdb[..], 0, is_str(sess.cwd[..], sess.cwd_n));
      if sess.branch_n > 0 { cn = el_put(cwdb[..], cn, "  ("); cn = el_put(cwdb[..], cn, is_str(sess.branch[..], sess.branch_n)); cn = el_put(cwdb[..], cn, ")"); }
      iy += cp_introspect_kv(f, "introspect.pane.cwd", "Working Folder", sheet_pool(sh, cast(string) cwdb[0..<cn]), true, ix, iy, inner_w, true);
    }
    if sess.machine_label_n > 0 {
      _ := cp_introspect_kv(f, "introspect.pane.machine", "Machine", sheet_pool(sh, is_str(sess.machine_label[..], sess.machine_label_n)), false, ix, iy, inner_w, true);
    }
    y += c1_h + 14.0f32;

    // #14071 opt-in notice for external local harnesses when delegation is Off.
    if is_harness_is_external(sess.harness) && !cp_flawed_allow_local_harnesses(s) {
      nb_h: f32 = 52.0f32;
      _ := sheet_box(sh, cx, y, cw, nb_h, 10.0f32, k.border, k.raised, k.hairline);
      sb_w := app_button_width(f, ICON_SETTINGS, "Agent Settings");
      _ := app_button(f, "introspect.pane.settings", cx + cw - card_pad - sb_w, y + (nb_h - 26.0f32) * 0.5f32, sb_w, ICON_SETTINGS, "Agent Settings", APP_BUTTON_QUIET, 0, CP_IS_INSPECT_SETTINGS);
      note_room := cw - 2.0f32 * card_pad - sb_w - 12.0f32;
      if note_room > 60.0f32 {
        _ := uiframe_semantic(f, "introspect.pane.readonly_note", EL_TEXT, "External local harnesses are read-only by default.", cx + card_pad, y, note_room, nb_h, 0, 0);
        _ := sheet_text(sh, m, -1, cx + card_pad, y + 10.0f32, k.small.line, k.small.face, k.ink, app_fit(f, k.small.face, "Read-only inspection (external harnesses off by default)", note_room));
        _ := sheet_text(sh, m, -1, cx + card_pad, y + 10.0f32 + k.small.line + 2.0f32, k.small.line, k.small.face, k.muted, app_fit(f, k.small.face, "Core chat stays on OpenAgents Core. Enable delegation in Settings -> Agent.", note_room));
      }
      y += nb_h + 14.0f32;
    }

    // Live output card
    out_text := cast(string) ip[0].output[0..<ip[0].output_n];
    line_h: f32 = 17.0f32;
    nlines := 0;
    if out_text.count > 0 {
      pos := 0;
      while pos < out_text.count && nlines < CP_IS_MAX_LINES {
        while pos < out_text.count && out_text[pos] != '\n' { pos += 1; }
        nlines += 1;
        if pos < out_text.count && out_text[pos] == '\n' { pos += 1; }
      }
    }
    body_lines := ifx nlines > 0 then nlines else 1;
    c2_h := card_pad + k.small.line + 12.0f32 + cast(f32) body_lines * line_h + card_pad;
    _ := sheet_box(sh, cx, y, cw, c2_h, 12.0f32, k.border, k.raised, k.hairline);
    ox := cx + card_pad;
    oy := y + card_pad;

    status_s := ifx ip[0].output_status_n > 0 then sheet_pool(sh, is_str(ip[0].output_status[..], ip[0].output_status_n))
                else ifx ip[0].loading then "Loading…" else "Live output";
    sw_txt := measure_width(m, k.small.face, status_s);
    if sw_txt < inner_w - 100.0f32 {
      _ := sheet_text(sh, m, -1, ox + inner_w - sw_txt, oy, k.small.line, k.small.face, k.faint, status_s);
    }
    _ := sheet_text(sh, m, -1, ox, oy, k.small.line, t.head_face, k.muted, "LIVE OUTPUT");
    oy += k.small.line + 12.0f32;

    if out_text.count == 0 {
      empty_msg := ifx ip[0].loading then "Capturing live output…" else "No output captured yet. Press Refresh to poll.";
      _ := uiframe_semantic(f, "introspect.pane.output", EL_TEXT, empty_msg, ox, oy, inner_w, line_h, 0, 0);
      _ := sheet_text(sh, m, -1, ox, oy, line_h, FONT_MONO_12, k.muted, app_fit(f, FONT_MONO_12, empty_msg, inner_w));
    } else {
      _ := uiframe_semantic(f, "introspect.pane.output", EL_TEXT, app_fit(f, FONT_MONO_12, out_text, 4096.0f32), ox, oy, inner_w, cast(f32) nlines * line_h, 0, 0);
      pos := 0;
      li := 0;
      while pos < out_text.count && li < CP_IS_MAX_LINES {
        ls := pos;
        while pos < out_text.count && out_text[pos] != '\n' { pos += 1; }
        le := pos;
        if le > ls && out_text[le - 1] == '\r' { le -= 1; }
        if pos < out_text.count && out_text[pos] == '\n' { pos += 1; }
        if oy + line_h > top && oy < h {
          line_s := cast(string) out_text[ls..<le];
          if line_s.count > 0 {
            _ := sheet_text(sh, m, -1, ox, oy, line_h, FONT_MONO_12, k.ink, app_fit(f, FONT_MONO_12, line_s, inner_w));
          }
        }
        oy += line_h;
        li += 1;
      }
    }
    y += c2_h + 24.0f32;
  } else {
    // Session disappeared after poll refresh
    _ := sheet_box(sh, cx, y, cw, 72.0f32, 12.0f32, k.border, k.raised, k.hairline);
    _ := sheet_text(sh, m, -1, cx + card_pad, y + 26.0f32, k.body.line, k.body.face, k.muted,
      app_fit(f, k.body.face, "This session is no longer active. Select another session in the sidebar or press Close.", inner_w));
    y += 88.0f32;
  }

  uiframe_unclip(f);
  ip[0].content = (y - y0) + 28.0f32;
  app_scroll_rail(f, ip[0].scr[..], w, top, ip[0].scroll, ip[0].content, view, view, s[0].now, s[0].reduced);

  // Docked Borderless Direct Command Composer for any commandable introspected session (#14067).
  if can_cmd && h > top + cmd_bar_h {
    by := h - cmd_bar_h;
    sheet_fill(sh, left, by, area_w, cmd_bar_h, 0, k.canvas);
    sheet_fill(sh, left, by, area_w, k.border, 0, k.hairline);

    note_y := by + 8.0f32;
    note_txt := ifx ip[0].cmd_note_n > 0 then sheet_pool(sh, is_str(ip[0].cmd_note[..], ip[0].cmd_note_n))
                else "Direct session command — type and press Return to send";
    note_col := ifx ip[0].cmd_note_err then rgba(239, 68, 68, 0.95f32) else k.muted;
    _ := uiframe_semantic(f, "introspect.pane.cmd_note", EL_TEXT, note_txt, cx, note_y, cw, k.small.line, 0, 0);
    _ := sheet_text(sh, m, -1, cx, note_y, k.small.line, k.small.face, note_col, app_fit(f, k.small.face, note_txt, cw));

    box_y := note_y + k.small.line + 8.0f32;
    box_h: f32 = 44.0f32;
    focused := cp_composer_focused(s);
    border_c := ifx focused then k.accent else k.hairline;
    _ := sheet_box(sh, cx, box_y, cw, box_h, 12.0f32, k.border, k.raised, border_c);

    send_w := app_button_width(f, ICON_ARROW_UP, "Send");
    send_x := cx + cw - send_w - 8.0f32;
    send_y := box_y + (box_h - 28.0f32) * 0.5f32;
    has_draft := is_trim(cp_introspect_cmd_draft(s)).count > 0;
    send_st := ifx has_draft then 0 else EL_S_DISABLED;
    _ := app_button(f, "introspect.pane.send", send_x, send_y, send_w, ICON_ARROW_UP, "Send", APP_BUTTON_PRIMARY, send_st, CP_IS_INSPECT_SEND);

    ed_x := cx + 14.0f32;
    ed_w := send_x - ed_x - 10.0f32;
    if ed_w < 60.0f32 { ed_w = 60.0f32; }
    ed_y := box_y + 10.0f32;
    ed_h := box_h - 20.0f32;
    frow := uiframe_semantic(f, "introspect.pane.composer", EL_FIELD, "Direct session command", cx, box_y, send_x - cx - 4.0f32, box_h, ifx focused then EL_S_FOCUSED else 0, CP_IS_INSPECT_FOCUS);
    sheet_hit(sh, UIFRAME_HIT, frow, 0, cx, box_y, send_x - cx - 4.0f32, box_h);

    ph_b: [160] u8;
    phn := el_put(ph_b[..], 0, "Command ");
    phn = el_put(ph_b[..], phn, act_id);
    phn = el_put(ph_b[..], phn, "…");
    cp_ed_draw(s, f, CP_ED_COMPOSER, ed_x, ed_y, ed_w, ed_h, sheet_pool(sh, cast(string) ph_b[0..<phn]));
  }
}

// ---------------------------------------------------------------- C exports

coder_page_introspect_set_tui :: (s: [] CoderPage, tmux_raw: string, ps_raw: string, allow_ext: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  tmp: [IS_MAX_SESSIONS] IntrospectSession;
  nt := is_parse_tmux_panes(tmux_raw, tmp[..]);
  skip_pids: [IS_MAX_SESSIONS] int;
  nskip := 0;
  for i: 0..<nt {
    if tmp[i].pid > 0 && nskip < IS_MAX_SESSIONS { skip_pids[nskip] = tmp[i].pid; nskip += 1; }
  }
  if ps_raw.count > 0 && nt < IS_MAX_SESSIONS {
    pbuf: [IS_MAX_SESSIONS] IntrospectSession;
    np := is_parse_process_rows(ps_raw, allow_ext, skip_pids[0..<nskip], pbuf[..]);
    for i: 0..<np {
      if nt >= IS_MAX_SESSIONS { break; }
      if pbuf[i].kind != IS_KIND_TUI { continue; }
      tmp[nt] = pbuf[i];
      nt += 1;
    }
  }
  cp_introspect_replace_kind(s, IS_KIND_TUI, tmp[0..<nt]);
  return nt;
}

coder_page_introspect_set_harnesses :: (s: [] CoderPage, harness_tsv: string, ps_raw: string, allow_ext: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  tmp: [IS_MAX_SESSIONS] IntrospectSession;
  nh := is_parse_harness_rows(harness_tsv, allow_ext, tmp[..]);
  if ps_raw.count > 0 && nh < IS_MAX_SESSIONS {
    skip_pids: [IS_MAX_SESSIONS] int;
    nskip := 0;
    snap := s[0].introspect[0].snap[..];
    for i: 0..<snap[0].nsessions {
      if snap[0].sessions[i].kind == IS_KIND_TUI && snap[0].sessions[i].pid > 0 && nskip < IS_MAX_SESSIONS {
        skip_pids[nskip] = snap[0].sessions[i].pid;
        nskip += 1;
      }
    }
    for i: 0..<nh {
      if tmp[i].pid > 0 && nskip < IS_MAX_SESSIONS {
        skip_pids[nskip] = tmp[i].pid;
        nskip += 1;
      }
    }
    pbuf: [IS_MAX_SESSIONS] IntrospectSession;
    np := is_parse_process_rows(ps_raw, allow_ext, skip_pids[0..<nskip], pbuf[..]);
    for i: 0..<np {
      if nh >= IS_MAX_SESSIONS { break; }
      if pbuf[i].kind != IS_KIND_HARNESS { continue; }
      tmp[nh] = pbuf[i];
      nh += 1;
    }
  }
  cp_introspect_replace_kind(s, IS_KIND_HARNESS, tmp[0..<nh]);
  return nh;
}

coder_page_introspect_set_machines :: (s: [] CoderPage, machines_tsv: string, remote_sessions_tsv: string) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  ip := s[0].introspect[..];
  snap := ip[0].snap[..];
  old_m: [IS_MAX_MACHINES] IntrospectMachine;
  old_col: [IS_MAX_MACHINES] bool;
  old_n := snap[0].nmachines;
  for i: 0..<old_n { old_m[i] = snap[0].machines[i]; old_col[i] = ip[0].machine_collapsed[i]; }

  new_m: [IS_MAX_MACHINES] IntrospectMachine;
  nm := is_parse_machines(machines_tsv, new_m[..]);
  for i: 0..<nm {
    snap[0].machines[i] = new_m[i];
    ip[0].machine_collapsed[i] = false;
    nid := is_str(new_m[i].id[..], new_m[i].id_n);
    for oi: 0..<old_n {
      if is_str(old_m[oi].id[..], old_m[oi].id_n) == nid {
        ip[0].machine_collapsed[i] = old_col[oi];
        break;
      }
    }
  }
  for i: nm..<IS_MAX_MACHINES { snap[0].machines[i] = IntrospectMachine.{}; ip[0].machine_collapsed[i] = false; }
  snap[0].nmachines = nm;

  rbuf: [IS_MAX_SESSIONS] IntrospectSession;
  nr := is_parse_remote_sessions(remote_sessions_tsv, rbuf[..]);
  cp_introspect_replace_kind(s, IS_KIND_REMOTE, rbuf[0..<nr]);
  is_recount_machines(snap);
  return nm;
}

coder_page_introspect_set_output :: (s: [] CoderPage, session_id: string, output: string, status: string, loading: bool) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if session_id.count > 0 && session_id != cp_introspect_active_id(s) { return false; }
  // Keep the tail when output exceeds CP_IS_OUTPUT_MAX so latest lines are always shown.
  start := 0;
  if output.count > CP_IS_OUTPUT_MAX {
    start = output.count - CP_IS_OUTPUT_MAX;
    while start < output.count && output[start] != '\n' { start += 1; }
    if start < output.count && output[start] == '\n' { start += 1; }
  }
  ip[0].output_n = is_copy(ip[0].output[..], cast(string) output[start..<output.count]);
  ip[0].output_status_n = is_copy(ip[0].output_status[..], status);
  ip[0].loading = loading;
  return true;
}

coder_page_introspect_active_id :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cp_out(out, cp_introspect_active_id(s));
}

coder_page_introspect_active_kind :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 || !s[0].introspect[0].open { return -1; }
  if s[0].introspect[0].inspect_is_machine { return IS_KIND_REMOTE; }
  idx := is_find_session(s[0].introspect[0].snap[..], cp_introspect_active_id(s));
  if idx < 0 { return -1; }
  return s[0].introspect[0].snap[0].sessions[idx].kind;
}

coder_page_introspect_active_is_machine :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].introspect[0].open && s[0].introspect[0].inspect_is_machine;
}

coder_page_introspect_shown :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].introspect[0].open;
}

coder_page_introspect_close :: (s: [] CoderPage) #export_c #effects(all) {
  cp_introspect_close(s);
}

coder_page_introspect_output :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cp_out(out, cast(string) s[0].introspect[0].output[0..<s[0].introspect[0].output_n]);
}

coder_page_introspect_counts :: (s: [] CoderPage, out4: [] int) -> bool #export_c #effects(all) {
  if s.count < 1 || out4.count < 4 { return false; }
  snap := s[0].introspect[0].snap[..];
  out4[0] = is_count_kind(snap, IS_KIND_TUI);
  out4[1] = is_count_kind(snap, IS_KIND_HARNESS);
  out4[2] = is_count_kind(snap, IS_KIND_REMOTE);
  out4[3] = snap[0].nmachines;
  return true;
}

coder_page_introspect_can_command :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return cp_introspect_can_command(s);
}

coder_page_introspect_cmd :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cp_out(out, cast(string) s[0].introspect[0].pending_cmd[0..<s[0].introspect[0].pending_cmd_n]);
}

coder_page_introspect_set_cmd :: (s: [] CoderPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 || !cp_introspect_can_command(s) { return false; }
  cp_introspect_cmd_draft_set(s, text);
  return true;
}

coder_page_introspect_submit :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return cp_introspect_submit(s);
}

coder_page_introspect_cmd_done :: (s: [] CoderPage, session_id: string, note: string, failed: bool) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  ip := s[0].introspect[..];
  if session_id.count > 0 && session_id != cp_introspect_active_id(s) { return false; }
  ip[0].cmd_sending = false;
  ip[0].cmd_note_n = is_copy(ip[0].cmd_note[..], note);
  ip[0].cmd_note_err = failed;
  return true;
}
