// Coder Desktop page (../../page.coax): the conversation: a message's activity group, the
// messages and replies, the notices, the corner buttons and the composer.

// Extract a compact deterministic replay-verification pill from an edit or executor tool output
// (e.g. "[E] replay verified · sha256:a1b2c3d4e5f6" or "[E] replay refused · sha256:...", #13924).
cp_exec_hex :: (c: u8) -> bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }
cp_exec_replay_pill :: (output: string, bad: [] bool) -> string {
  bad[0] = false;
  v_mid := "] replay verified · sha256:";
  r_mid := "] replay refused · sha256:";
  i := 0;
  while i + 4 < output.count {
    if output[i] == '[' {
      cls := output[i + 1];
      if cls == 'E' || cls == 'D' || cls == 'S' || cls == 'N' {
        if i + 2 + v_mid.count + 12 <= output.count && cast(string) output[i + 2..<i + 2 + v_mid.count] == v_mid {
          hex0 := i + 2 + v_mid.count;
          ok := true;
          for k: 0..<12 { if !cp_exec_hex(output[hex0 + k]) { ok = false; break; } }
          if ok { bad[0] = false; return cast(string) output[i..<hex0 + 12]; }
        }
        if i + 2 + r_mid.count + 12 <= output.count && cast(string) output[i + 2..<i + 2 + r_mid.count] == r_mid {
          hex0 := i + 2 + r_mid.count;
          ok := true;
          for k: 0..<12 { if !cp_exec_hex(output[hex0 + k]) { ok = false; break; } }
          if ok { bad[0] = true; return cast(string) output[i..<hex0 + 12]; }
        }
      }
    }
    i += 1;
  }
  return "";
}

// Row q of a message as its activity group shows it (#13731): a thought's words, a file read by
// its name, or a command on one line that opens onto the whole of it and what came back.
cp_act_row :: (s: [] CoderPage, f: [] UiFrame, q: int, w: f32) -> AppActRow {
  sh := f[0].sheet;
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; output := cp_call_text(s, q);
  if s[0].calls[q].thought || s[0].calls[q].said {
    shown_out := output;
    is_streaming := false;
    if s[0].calls[q].thought {
      revealing := s[0].thought_row == q && !s[0].reduced && s[0].thought_shown < output.count;
      if revealing {
        n_vis := ifx s[0].thought_shown < 0 then 0 else s[0].thought_shown;
        shown_out = cast(string) output[0..<n_vis];
      }
      is_streaming = revealing || cp_call_thought_live(s, q);
    }
    r := AppActRow.{kind = APP_ACT_THOUGHT, verb = ifx s[0].calls[q].said then "Agent message" else "Thought process", output = shown_out, said = s[0].calls[q].said, running = is_streaming};
    // its words read as a reply does: its Markdown, parsed into this frame's document
    at := s[0].think_at; b0 := s[0].think[at].nb; n0 := s[0].think[at].n;
    r.blocks = md_parse(s[0].think[at..<at + 1], shown_out, 0);
    if r.blocks > 0 {
      r.doc = s[0].think[at..<at + 1]; r.block0 = b0;
      if s[0].calls[q].thought && s[0].thought_row == q && !s[0].reduced {
        cur_md := s[0].think[at].n - n0;
        if cur_md > s[0].thought_md_n {
          veil_push(s[0].thought_veil[..], s[0].thought_md_n, cur_md, s[0].clock);
          s[0].thought_md_n = cur_md;
        }
        r.veil = MdVeil.{veil = s[0].thought_veil[..], now = s[0].clock, base = n0};
      }
    } else {
      // the document is full: its words as they are, wrapped to the row
      wb := s[0].scratch[..];
      per := cast(int) ((w - f[0].skin.act.gutter) / measure_width(f[0].m, f[0].skin.body.face, "0")) - 1; if per < 8 { per = 8; }
      wn := cp_wrap(wb, shown_out, per);
      r.output = sheet_pool(sh, cast(string) wb[0..<wn]);
    }
    return r;
  }
  read_at := ifx s[0].calls[q].read then 0 else cp_read_at(text);
  if s[0].calls[q].read || read_at > 0 {
    // a file by its name; the row opens onto its whole path and what was read
    path := cast(string) text[read_at..<text.count];
    base := 0;
    for c, ci: path { if c == '/' && ci + 1 < path.count { base = ci + 1; } }
    return AppActRow.{kind = APP_ACT_READ, verb = "Read", target = sheet_pool(sh, cast(string) path[base..<path.count]),
                      call = ifx base > 0 then path else "", output = output, failed = s[0].calls[q].failed,
                      timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q), path = ifx s[0].calls[q].failed then "" else path};
  }
  if cp_edit_at(text) > 0 { return cp_act_edit(s, f, q); }
  // an oasim command says what it did to the simulator (spec 7.5): "Tapped (201, 640)"
  if cp_flag(s, DC_FLAG_SIMULATOR) {
    stb: [256] u8; sim := cp_sim_cmd(text, stb[..]);
    if sim.verb.count > 0 {
      return AppActRow.{kind = APP_ACT_EXEC, verb = sim.verb, target = sheet_single_line(sh, sim.target), call = text, output = output,
                        failed = s[0].calls[q].failed, running = s[0].calls[q].running, timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q)};
    }
  }
  // Typed TK_WORLD rows for GameBuilder & 3D scene commands (#14039)
  if cp_flag(s, DC_FLAG_GAMEBUILDER) || cp_flag(s, DC_FLAG_METAVERSE) || cp_flag(s, DC_FLAG_SCENES) {
    wtb: [256] u8; wbb: [32] u8;
    ww := cp_world_cmd(text, output, wtb[..], wbb[..]);
    if ww.verb.count > 0 && (!ww.is_gb || cp_flag(s, DC_FLAG_GAMEBUILDER)) {
      return AppActRow.{kind = APP_ACT_EXEC, verb = ww.verb, target = sheet_single_line(sh, ww.target), call = text, output = output,
                        badge = ifx ww.badge.count > 0 then sheet_pool(sh, ww.badge) else "", badge_bad = s[0].calls[q].failed,
                        failed = s[0].calls[q].failed, running = s[0].calls[q].running, timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q)};
    }
  }
  pbad := [1] bool.[false];
  pill := ifx cp_flag(s, DC_FLAG_MODELS_EXECUTOR) then cp_exec_replay_pill(output, pbad[..]) else "";
  return AppActRow.{kind = APP_ACT_EXEC, verb = ifx s[0].calls[q].running then "Running" else "Ran", target = sheet_single_line(sh, text), call = text, output = output,
                    badge = ifx pill.count > 0 then sheet_pool(sh, pill) else "", badge_bad = pbad[0],
                    failed = s[0].calls[q].failed, running = s[0].calls[q].running, timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q)};
}
// What a press on row q does: an oasim command that went brings the simulator pane to the front
// (spec 7.5, GitHub #13811); any other row does what its group's rows do.
cp_row_act :: (s: [] CoderPage, q: int, row: int) -> int {
  if s[0].calls[q].thought || s[0].calls[q].said || s[0].calls[q].read || s[0].calls[q].failed || s[0].calls[q].running { return row; }
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n];
  if cp_edit_at(text) > 0 || cp_read_at(text) > 0 { return row; }
  if cp_flag(s, DC_FLAG_SIMULATOR) {
    tb: [256] u8;
    if cp_sim_cmd(text, tb[..]).verb.count > 0 { return CP_SIM_ROW; }
  }
  if cp_flag(s, DC_FLAG_METAVERSE) || cp_flag(s, DC_FLAG_GAMEBUILDER) {
    wtb: [256] u8; wbb: [32] u8;
    ww := cp_world_cmd(text, "", wtb[..], wbb[..]);
    if ww.verb.count > 0 && (!ww.is_gb || cp_flag(s, DC_FLAG_GAMEBUILDER)) { return CP_WORLD_CARD_ACT; }
  }
  return row;
}
// An edit's row (#13696): "Edited" or "Wrote" and the file's name, a link to the file; its lines
// added and removed at its end, and it opens onto its diff.
cp_act_edit :: (s: [] CoderPage, f: [] UiFrame, q: int) -> AppActRow {
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; at := cp_edit_at(text);
  path := cast(string) text[at..<text.count]; write := at == 6;
  running := s[0].calls[q].running; failed := s[0].calls[q].failed;
  verb := ifx failed then (ifx write then "Could not write" else "Could not edit")
          else ifx running then (ifx write then "Writing" else "Editing") else ifx write then "Wrote" else "Edited";
  // a diff is the row's change, drawn as hunks; anything else (why it failed) is its output
  diff := cp_edit_diff(s, q) > 0; out := cp_call_text(s, q);
  pbad := [1] bool.[false];
  pill := ifx cp_flag(s, DC_FLAG_MODELS_EXECUTOR) then cp_exec_replay_pill(out, pbad[..]) else "";
  return AppActRow.{kind = ifx write then APP_ACT_WRITE else APP_ACT_EDIT, verb = verb, target = sheet_pool(f[0].sheet, app_diff_base(path)),
                    badge = ifx pill.count > 0 then sheet_pool(f[0].sheet, pill) else "", badge_bad = pbad[0],
                    output = ifx diff then "" else out, diff = ifx diff then out else "", failed = failed, running = running,
                    timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q), path = ifx failed then "" else path};
}
// Whether row q says how long it took: while it runs, and once done when it took a second or more.
cp_call_timed :: (s: [] CoderPage, q: int) -> bool { return s[0].calls[q].running || s[0].calls[q].took >= 1; }
// How long row q took, or has run so far, in seconds; 0 when it was not timed.
cp_call_took :: (s: [] CoderPage, q: int) -> f32 {
  if s[0].calls[q].running { return s[0].clock - s[0].calls[q].began; }
  return ifx s[0].calls[q].took > 0 then s[0].calls[q].took else 0.0f32;
}
// Sub-agent j of turn i as a row of its message's group: "Ran a subagent", its model and its
// task's first line; a press opens its transcript beside the conversation.
cp_act_agent :: (s: [] CoderPage, f: [] UiFrame, i: int, j: int) -> AppActRow {
  g := s[0].turns[i].agents[j];
  lbl := ifx g.desc_n > 0 then sheet_single_line(f[0].sheet, cast(string) g.desc[0..<g.desc_n]) else sheet_single_line(f[0].sheet, cast(string) g.task[0..<g.task_n]);
  badge := ifx g.subagent_type_n > 0 then cast(string) g.subagent_type[0..<g.subagent_type_n] else CP_LEVEL_NAME[g.level];
  tb: [CP_AGENT_TASK + 160] u8; n := el_put(tb[..], 0, badge);
  if g.wt_branch_n > 0 {
    n = el_put(tb[..], n, " ["); n = el_put(tb[..], n, cast(string) g.wt_branch[0..<g.wt_branch_n]); n = el_put(tb[..], n, "]");
  }
  if lbl.count > 0 { n = el_put(tb[..], n, " · "); n = el_put(tb[..], n, lbl); }
  waiting_permit := g.state == CP_RUNNING && cp_permit_agent_waiting(s, j);
  verb := ifx waiting_permit then "Waiting for approval" else ifx g.is_background && g.state == CP_RUNNING then "Background subagent" else "Ran a subagent";
  return AppActRow.{kind = APP_ACT_AGENT, verb = verb, target = sheet_pool(f[0].sheet, cast(string) tb[0..<n]),
                    failed = g.state == CP_FAILED, running = g.state == CP_RUNNING && !g.paused, opens = true};
}
// "t7" + ".x" + 12: a part of an activity group, under the group's name ("t7" a message's, "p3.1"
// a sub-agent's) and, when k is not negative, its number.
cp_named :: (out: [] u8, name: string, part: string, k: int) -> string {
  n := el_put(out, 0, name); n = el_put(out, n, part);
  if k >= 0 { n = el_put_i(out, n, k); }
  return cast(string) out[0..<n];
}
// Turn i's activity group at (x, y), cw wide (#13731): the summary, counted in Zeron's words, and
// once the message is done "Worked for 42s · " before it (#13745); open while the message works or
// when the person opened it, its thoughts, commands, reads and sub-agents in the order they came, a
// tree down their left. Rows out of view between top and bottom keep their place and are not
// drawn. Returns its height, 0 when it did nothing.
cp_group :: (s: [] CoderPage, f: [] UiFrame, i: int, x: f32, y0: f32, cw: f32, top: f32, bottom: f32) -> f32 {
  nb: [EL_ID] u8; name := cp_named(nb[..], "t", "", i);
  live := s[0].turns[i].state == CP_RUNNING;
  worked := ifx live || s[0].turns[i].took < 0 then -1 else cp_whole(s[0].turns[i].took);
  done := [1] int.[0];
  h := cp_act_group(s, f, name, s[0].turns[i].head, s[0].turns[i].ncmds, s[0].turns[i].early_cmds, s[0].turns[i].more_cmds,
                    i, s[0].turns[i].nagents, live, app_act_open(s[0].turns[i].fold, live), worked, x, y0, cw, top, bottom, CP_TOOL, i, done[..]);
  // the steers taken after its last row, or all of them while it is folded, under it (#13809)
  if s[0].turns[i].steered_n > 0 {
    gap := ifx h > 0 then f[0].skin.app.gap else 0.0f32;
    sh := cp_fu_steered(s, f, i, x, y0 + h + gap, cw, -1, done[..]);
    if sh > 0 { h += gap + sh - f[0].skin.app.gap; }   // the caller adds the gap after the group
  }
  return h;
}
// One activity group at (x, y0), cw wide, as the conversation and a sub-agent's pane both draw
// it (#13731, #13744): the summary over the nrows rows from call head on (a place in the page's
// calls plus 1, 0 for none), the early rows that went and the more that were not kept said
// above and below them, and turn i's nagents sub-agents (0 for a sub-agent's own group) each in
// its place among them; `worked`, when not negative, is the seconds it took, said before the
// summary ("Worked for 42s · Ran 3 commands"). Its parts are named under `name`: name + ".grp" the summary (CP_GROUP),
// name + ".x" + k each row (`row` its action), name + ".g" + j each sub-agent (CP_AGENT). Rows
// out of view between top and bottom keep their place and are not drawn. Returns its height,
// 0 when it did nothing. steers, when not negative, is the turn whose steers stand among the rows
// where each was taken (#13809), done[0] counting those drawn; the caller draws the rest.
// Critically damped glide duration for expanding/collapsing an activity group (~280ms visible settle).
CP_ACT_FOLD_DUR :: 0.50f32;
cp_act_group :: (s: [] CoderPage, f: [] UiFrame, name: string, head: int, nrows: int, early: int, more: int, i: int, nagents: int,
                 live: bool, open: bool, worked: int, x: f32, y0: f32, cw: f32, top: f32, bottom: f32, row: int, steers: int, done: [] int) -> f32 {
  a := f[0].skin.act; sh := f[0].sheet;
  if nrows + nagents + early + more == 0 { return 0; }
  // the summary: every kind it did, counted
  c := [1] AppActCount.[AppActCount.{}];
  q := head - 1;
  while q >= 0 {
    if s[0].calls[q].said { q = s[0].calls[q].next - 1; continue; }
    txt := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n];
    edit := cp_edit_at(txt);
    kind := ifx s[0].calls[q].thought then APP_ACT_THOUGHT else ifx s[0].calls[q].read || cp_read_at(txt) > 0 then APP_ACT_READ
            else ifx edit == 5 then APP_ACT_EDIT else ifx edit == 6 then APP_ACT_WRITE else APP_ACT_EXEC;
    app_act_count(c[..], kind, s[0].calls[q].failed);
    q = s[0].calls[q].next - 1;
  }
  for j: 0..<nagents { app_act_count(c[..], APP_ACT_AGENT, s[0].turns[i].agents[j].state == CP_FAILED); }
  sb: [256] u8; sn := 0;
  said := 0;   // "Worked for 42s", once done
  if worked >= 0 {
    said = el_put(sb[..], 0, "Worked for "); said = el_put_i(sb[..], said, worked); said = el_put(sb[..], said, "s");
    c[0].thoughts = 0;   // finished summary keeps "Worked for Ns" without a redundant "Thought process" suffix
  }
  wn := ifx said > 0 then el_put(sb[..], said, " · ") else 0;
  sn = wn + app_act_summary(sb[wn..<sb.count], c[0]);
  if sn == wn { sn = ifx said > 0 then said else el_put(sb[..], 0, "Worked"); }   // nothing counted: "Worked for 42s" alone
  ib: [EL_ID] u8; tb: [EL_ID] u8; fb: [EL_ID] u8;
  y := y0;
  y += app_act_head(f, cp_named(ib[..], name, ".grp", -1), x, y, cw, sheet_pool(sh, cast(string) sb[0..<sn]), live, open, CP_GROUP);
  // Smoothly animate collapse/expand on a critically damped spring (snaps on chat switch,
  // newly mounted rows, and reduced motion).
  gk := uiframe_key(f, cp_named(fb[..], name, ".fold", -1));
  target := ifx open then 1.0f32 else 0.0f32;
  if keyed_ok(f[0].keyed, gk) {
    gen := cast(f32) s[0].chat_gen;
    if keyed_fresh(f[0].keyed, gk) || keyed_slot(f[0].keyed, gk, 0) != gen {
      keyed_spring_set(f[0].keyed, gk, target);
      keyed_slot_set(f[0].keyed, gk, 0, gen);
    }
  }
  p := keyed_glide(f[0].keyed, gk, target, CP_ACT_FOLD_DUR, target);
  if p < 0.0f32 { p = 0.0f32; } else if p > 1.0f32 { p = 1.0f32; }
  if !open && p <= 0.003f32 { return y - y0; }
  animating := !open || p < 0.997f32;
  if animating { s[0].anim = true; }
  body_y := y;
  from := app_slide_mark(f);
  from_nl := sh[0].nl;
  from_focus := ifx f[0].rows.count > 0 then f[0].rows[0].focus_n else 0;
  clip_u := -1; clip_o := -1; paint_u := sh[0].nu; paint_o := sh[0].no;
  if animating {
    uiframe_clip(f, x - 4.0f32, body_y, x + cw + 4.0f32, PRIM_OPEN);
    clip_u = sh[0].nu - 1; clip_o = sh[0].no - 1;
    paint_u = sh[0].nu; paint_o = sh[0].no;
  }
  steers_here := ifx open then steers else -1;
  // the tree's rows: its sub-agents each in its place among the message's own, after the rows
  // that came before it was handed over
  last := nrows + nagents - 1; pos := 0; drawn := 0;
  if early > 0 {
    eb: [96] u8; en := el_put_i(eb[..], 0, early); en = el_put(eb[..], en, ifx early == 1 then " earlier row is not shown. A chat keeps 6,000 tool calls and thoughts." else " earlier rows are not shown. A chat keeps 6,000 tool calls and thoughts.");
    y += app_meta(f, cp_named(ib[..], name, ".xe", -1), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) eb[0..<en]), false);
  }
  q = head - 1; at := early;
  while q >= 0 || drawn < nagents {
    if drawn < nagents && (q < 0 || s[0].turns[i].agents[drawn].after <= at) {
      y += app_act_row(f, cp_named(tb[..], name, ".g", drawn), x, y, cw, cp_act_agent(s, f, i, drawn), pos < last, CP_AGENT);
      // a running sub-agent of the running message can be stopped alone, as from its pane (#13766)
      if nagents > 0 && cp_running(s) && i == s[0].nturns - 1 && s[0].turns[i].agents[drawn].state == CP_RUNNING {
        sw := app_button_width(f, -1, "Stop sub-agent");
        y += app_button(f, cp_named(tb[..], name, ".s", drawn), x + a.gutter, y, sw, -1, "Stop sub-agent", APP_BUTTON_DEFAULT, 0, CP_AGENT_STOP) + f[0].skin.app.gap;
      }
      drawn += 1; pos += 1; continue;
    }
    nx := s[0].calls[q].next - 1;
    // a steer taken before this row stands above it, as the person's message (#13809)
    if steers_here >= 0 { sth := cp_fu_steered(s, f, steers_here, x, y, cw, at, done); if sth > 0 { y += sth; } }
    // a row out of view keeps its place and is not drawn, so a long run costs what shows
    rh := s[0].calls[q].h;
    if rh > 0 && (y + rh < top - CP_PANE_MARGIN || y > bottom + CP_PANE_MARGIN) { y += rh; q = nx; at += 1; pos += 1; continue; }
    rh = app_act_row(f, cp_named(tb[..], name, ".x", at), x, y, cw, cp_act_row(s, f, q, cw), pos < last, cp_row_act(s, q, row));   // a row keeps its id when older ones go, so an open row stays open
    s[0].calls[q].h = rh; y += rh;
    q = nx; at += 1; pos += 1;
  }
  if more > 0 {
    mb: [96] u8; mn := el_put_i(mb[..], 0, more); mn = el_put(mb[..], mn, " more ran after these and were not kept.");
    y += app_meta(f, cp_named(ib[..], name, ".xm", -1), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) mb[0..<mn]), false);
  }
  if animating {
    body_h := y - body_y;
    shown_h := body_h * p;
    clip_bottom := body_y + shown_h;
    if clip_u >= 0 && clip_u < sh[0].nu && sh[0].under[clip_u].kind == PRIM_CLIP { sh[0].under[clip_u].b = clip_bottom; }
    if clip_o >= 0 && clip_o < sh[0].no && sh[0].over[clip_o].kind == PRIM_CLIP { sh[0].over[clip_o].b = clip_bottom; }
    tuck_max := ifx body_h < 6.0f32 then body_h else 6.0f32;
    tuck := (1.0f32 - p) * tuck_max;
    alpha := p * (0.35f32 + 0.65f32 * p);
    if tuck > 0.0f32 {
      prim_move(sh[0].under, paint_u, sh[0].nu, 0, -tuck);
      prim_move(sh[0].over, paint_o, sh[0].no, 0, -tuck);
      if open {
        sheet_hits_move(sh, from.nh, 0, -tuck);
        elt_move(f[0].rows, from.nr, 0, -tuck);
        for li: from_nl..<sh[0].nl { sh[0].lines[li].y -= tuck; }
      }
    }
    prim_opacity(sh[0].under, paint_u, sh[0].nu, alpha);
    prim_opacity(sh[0].over, paint_o, sh[0].no, alpha);
    uiframe_unclip(f);
    if !open {
      sh[0].nh = from.nh;
      sh[0].nl = from_nl;
      for oi: paint_o..<sh[0].no { if sh[0].over[oi].kind == PRIM_TEXT { sh[0].over[oi].line = -1; } }
      if f[0].rows.count > 0 { f[0].rows[0].n = from.nr; f[0].rows[0].focus_n = from_focus; }
    } else if f[0].rows.count > 0 {
      for ri: from.nr..<f[0].rows[0].n {
        if f[0].rows[0].rows[ri].clipped {
          if f[0].rows[0].rows[ri].ct < body_y { f[0].rows[0].rows[ri].ct = body_y; }
          if f[0].rows[0].rows[ri].cb > clip_bottom { f[0].rows[0].rows[ri].cb = clip_bottom; }
        }
      }
    }
    y = clip_bottom;
  }
  return y - y0;
}
// Zeron's message hover lane (transcript.luau): 32pt tall (8pt top gap + 24pt button),
// always reserved so nothing shifts; button shows only while the message or its lane is
// hovered (or during the 1.2s Copied confirmation). 24x24 rounded-md (6pt) transparent
// button with 14pt copy/check icon, flush with the message's edge (right for user, left for reply).
// The lane's height, reserved under a message whether or not its button shows: a sub-agent's pane
// keeps it under its task too, so the pane's work stands level with the conversation's (#13770).
cp_copy_lane_h :: () -> f32 { return 32.0f32 / ARCADE_PHONE_SCALE; }
cp_copy_lane :: (f: [] UiFrame, id: string, bx: f32, y: f32, visible: bool, copied: bool, action: int) -> f32 {
  u: f32 = ARCADE_PHONE_SCALE;
  lane := cp_copy_lane_h();
  if !visible { return lane; }
  k := f[0].skin; sh := f[0].sheet;
  side := 24.0f32 / u;
  top := 8.0f32 / u;
  rad := 6.0f32 / u;
  ico := 14.0f32 / u;
  by := y + top;
  label := ifx copied then "Copied" else "Copy message";
  key := uiframe_key(f, id);
  p := uiframe_press(f, key, id);
  hov := uiframe_hover(f, key, id);   // the wash eases in and out (kit/frame.coax)
  row := uiframe_semantic(f, id, EL_BUTTON, label, bx, by, side, side, 0, action);
  if p > 0 { sheet_fill(sh, bx, by, side, side, rad, k.raised); }
  else if hov > 0 { sheet_fill(sh, bx, by, side, side, rad, opacity(k.hover, hov)); }
  ink := ifx p > 0 then k.ink else rgba_mix(k.muted, k.ink, hov);
  // Copy crossfades into its check and back (components/app/base.coax app_icon_swap)
  mb: [EL_ID] u8;
  app_icon_swap(f, app_id(mb[..], id, ".mark"), bx + (side - ico) / 2, by + (side - ico) / 2, ico, k.icon_copy, k.icon_check, copied, ink);
  sheet_hit(sh, UIFRAME_HIT, row, 0, bx, by, side, side);
  return lane;
}
// Quiet 24x24 hover-lane info button beside Copy: hovering or clicking reveals the model/harness metadata.
cp_info_button :: (f: [] UiFrame, id: string, bx: f32, y: f32, visible: bool, active: bool, action: int) {
  if !visible { return; }
  u: f32 = ARCADE_PHONE_SCALE;
  k := f[0].skin; sh := f[0].sheet;
  side := 24.0f32 / u;
  top := 8.0f32 / u;
  rad := 6.0f32 / u;
  ico := 14.0f32 / u;
  by := y + top;
  key := uiframe_key(f, id);
  p := uiframe_press(f, key, id);
  hov := uiframe_hover(f, key, id);
  row := uiframe_semantic(f, id, EL_BUTTON, "Model info", bx, by, side, side, ifx active then EL_S_CURRENT else 0, action);
  if p > 0 || active { sheet_fill(sh, bx, by, side, side, rad, k.raised); }
  else if hov > 0 { sheet_fill(sh, bx, by, side, side, rad, opacity(k.hover, hov)); }
  ink := ifx p > 0 || active then k.ink else rgba_mix(k.muted, k.ink, hov);
  sheet_icon(sh, ICON_SET_ABOUT, bx + (side - ico) / 2, by + (side - ico) / 2, ico, ink);
  sheet_hit(sh, UIFRAME_HIT, row, 0, bx, by, side, side);
}
// The conversation from x, cw wide, in the window up to w: the messages, their groups and replies,
// the notices, the goal and the budget, scrolling above the composer.
cp_conversation :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  u: f32 = ARCADE_PHONE_SCALE;
  lane := cp_copy_lane_h(); lane_top := 8.0f32 / u; lane_btn := 24.0f32 / u;
  bar := ifx s[0].bar_h > 0 then s[0].bar_h else 80.0f32;   // the composer and its foot
  todos_h := ifx s[0].todos[0].docked then 0.0f32 else s[0].todos[0].tray_h;   // the task list over the composer, when it is not in the right sidebar
  git_tray := ifx cp_flag(s, DC_FLAG_GIT) then s[0].git[0].tray_h else 0.0f32;
  oauth_tray := ifx cp_flag(s, DC_FLAG_MCP) then s[0].mcp_skills[0].oauth_tray_h else 0.0f32;
  voice_tray := s[0].voice[0].pill_h;
  rich_tray := ifx cp_flag(s, DC_FLAG_RICH) then s[0].rich[0].tray_h else 0.0f32;
  bottom := h - CP_BOTTOM - bar - s[0].fu[0].tray_h - todos_h - git_tray - s[0].permit[0].tray_h - oauth_tray - voice_tray - rich_tray - 10.0f32;   // what scrolls stops 10pt above the trays and the composer
  top := cp_bar(s);
  if bottom < top { bottom = top; }
  s[0].view = bottom - top;
  s[0].frame_n += 1; s[0].anim = false;
  cp_follow(s, f[0].dt);
  uiframe_clip(f, left, top, w, bottom);
  from_conv := app_slide_mark(f);
  conv_nl := f[0].sheet[0].nl;
  // what scrolls, where a live 3D card's viewport is cut off (shows.coax)
  sc := cp_scale(s);
  s[0].live_r[4] = left * sc; s[0].live_r[5] = top * sc; s[0].live_r[6] = (w - left) * sc; s[0].live_r[7] = (bottom - top) * sc;
  in_view := s[0].px >= x && s[0].px <= x + cw && s[0].py >= top && s[0].py < bottom;
  y := top - s[0].scroll - s[0].scr[0].stretch + a.gap;
  is_foreman := cp_flag(s, DC_FLAG_FOREMAN) && cast(string) s[0].current[0..<s[0].current_n] == "chat.foreman";
  if is_foreman { y += cp_foreman_hud(s, f, x, y, cw, running, exceeded); }
  // an empty chat's heading stands over its composer (cp_composer); Foreman's here, its composer at the foot
  if s[0].nturns == 0 && is_foreman {
    _ := app_empty(f, "coder.empty", x, y + a.gap, cw, ICON_BOT, "Foreman is standing by", "Describe a goal or delegate work across managed chats.");
  }
  ib: [EL_ID] u8;
  culled_top := false; culled_bot := false;
  // Every message stands at its height as last measured, or CP_ROW_ESTIMATE before that, and only
  // the ones near the view are laid out (#13745): a long chat costs what shows. One above the view
  // measured at a new height moves the scroll with it, so what is read stays where it is.
  for i: 0..<s[0].nturns {
    known := s[0].turns[i].h > 0 && s[0].turns[i].hw == cw;
    th := ifx known then s[0].turns[i].h else ifx s[0].turns[i].seen_h > 0 then s[0].turns[i].seen_h else cast(f32) CP_ROW_ESTIMATE;
    margin := ifx known then 160.0f32 else cast(f32) CP_PANE_MARGIN;
    if y + th < top - margin || y > bottom + margin {
      if y + th < top - margin { culled_top = true; } else { culled_bot = true; }
      y += th; s[0].turns[i].ah = 0;
    }
    else {
      y0 := y;
      enter := f[0].skin.motion.enter;
      if s[0].live_ask != i { f[0].skin.motion.enter = 0; }
      y += cp_turn_images(s, f, i, x, y, cw);
      y += app_message_user_fold(f, cp_id(ib[..], i, ".u"), x, y, cw, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n], s[0].turns[i].ask_open, CP_BUBBLE_FOLD);
      f[0].skin.motion.enter = enter; if s[0].live_ask == i { s[0].live_ask = -1; }
      asked := s[0].copied_kind == CP_COPIED_ASK && s[0].copied_turn == i;
      u_hov := in_view && s[0].py >= y0 && s[0].py < y + lane;
      // Hover-revealed Edit & resend action beside Copy on user bubbles (#14144)
      if u_hov && !running {
        _ := app_icon_button(f, cp_id(ib[..], i, ".edit"), x + cw - 2.0f32 * lane_btn - a.gap_small, y + lane_top, ICON_PEN, "Edit & resend", APP_BUTTON_QUIET, 0, CP_TURN_EDIT);
      }
      y += cp_copy_lane(f, cp_id(ib[..], i, ".uc"), x + cw - lane_btn, y, u_hov || asked, asked, CP_COPY_ASK);
      // what it did on its way to the reply: one activity group (#13731)
      gh := cp_group(s, f, i, x, y, cw, top, bottom);
      if gh > 0 { y += gh + a.gap; }
      // the pictures its commands showed (shows.coax), over the reply
      y += cp_shows_draw(s, f, i, x, y, cw);
      if s[0].turns[i].reply_n > 0 {
        s[0].turns[i].ay = y;
        f[0].skin.motion.enter = 0;
        vv := ifx s[0].veil_turn == i then MdVeil.{ veil = s[0].veil[..], now = s[0].clock } else MdVeil.{};
        if cp_flag(s, DC_FLAG_RICH) {
          y += cp_rich_message_agent(f, cp_id(ib[..], i, ".a"), x, y, cw, cp_doc_drawn(s, i), 0, s[0].turns[i].blocks,
                                     ifx s[0].copied_kind == CP_COPIED_BLOCK && s[0].copied_turn == i then s[0].copied_block else -1, CP_COPY, CP_PATH, CP_URL, vv);
        } else {
          y += app_message_agent_linked_veiled(f, cp_id(ib[..], i, ".a"), x, y, cw, cp_doc_drawn(s, i), 0, s[0].turns[i].blocks,
                                               ifx s[0].copied_kind == CP_COPIED_BLOCK && s[0].copied_turn == i then s[0].copied_block else -1, CP_COPY, CP_PATH, CP_URL, vv);
        }
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
        s[0].turns[i].ah = y - s[0].turns[i].ay;
        if s[0].turns[i].state != CP_RUNNING {
          did := s[0].copied_kind == CP_COPIED_REPLY && s[0].copied_turn == i;
          ck_w := ifx cp_flag(s, DC_FLAG_GIT) then cp_ckpt_turn_actions(s, f, i, x + cw, y) else 0.0f32;
          q_vis := true;
          has_quote := cp_flag(s, DC_FLAG_RICH);
          q_off := ifx has_quote then lane_btn + a.gap_small else 0.0f32;
          info_x := x + lane_btn + q_off + a.gap_small;
          info_ib: [EL_ID] u8; info_id := cp_id(info_ib[..], i, ".ai");
          info_hov := uiframe_hovered(f, info_id) || (in_view && s[0].px >= info_x && s[0].px < info_x + lane_btn && s[0].py >= y + lane_top && s[0].py < y + lane_top + lane_btn);
          show_meta := info_hov || s[0].turns[i].info;
          meta_x := info_x + lane_btn + a.gap_small;
          meta_y := y + lane_top + (lane_btn - k.small.line) / 2;
          meta_right := x + cw - (ifx ck_w > 0 then ck_w + a.gap_small else 0.0f32);
          cur_x := meta_x;
          ts_b: [24] u8;
          ts_raw := cp_turn_age(s[0].sb[0].now_ms, cp_turn_done_ms(s, i), ts_b[..]);
          if ts_raw.count > 0 && meta_right - cur_x > 16 {
            ts_txt := sheet_pool(f[0].sheet, ts_raw);
            ts_w := measure_width(f[0].m, k.small.face, ts_txt);
            draw_w := ifx ts_w + 0.5f32 < meta_right - cur_x then ts_w + 0.5f32 else meta_right - cur_x;
            _ := app_meta(f, cp_id(ib[..], i, ".ts"), cur_x, meta_y, draw_w, ts_txt, false);
            cur_x += ifx ts_w < meta_right - cur_x then ts_w else meta_right - cur_x;
          }
          // Model/harness metadata (with tok/s and TTFT) stays hidden behind the info icon until hovered or toggled.
          if show_meta {
            sep := " · ";
            sep_w := ifx ts_raw.count > 0 then measure_width(f[0].m, k.small.face, sep) else 0.0f32;
            if meta_right - cur_x > sep_w + 24 {
              if ts_raw.count > 0 {
                _ := sheet_text(f[0].sheet, f[0].m, -1, cur_x, meta_y, k.small.line, k.small.face, k.faint, sep);
                cur_x += sep_w;
              }
              mb: [160] u8;
              info_txt := sheet_pool(f[0].sheet, cp_turn_info_text(s, i, mb[..]));
              _ := app_meta(f, cp_id(ib[..], i, ".m"), cur_x, meta_y, meta_right - cur_x, info_txt, false);
            }
          }
          cp_info_button(f, info_id, info_x, y, q_vis, s[0].turns[i].info, CP_TURN_INFO);
          // Inline Retry & Fork actions on completed assistant turns (#14144)
          if !running && meta_right - info_x > 3.0f32 * lane_btn {
            _ := app_icon_button(f, cp_id(ib[..], i, ".retry"), meta_right - 2.0f32 * lane_btn - a.gap_small, y + lane_top, ICON_ARROW_UP, "Retry", APP_BUTTON_QUIET, 0, CP_TURN_RETRY);
            _ := app_icon_button(f, cp_id(ib[..], i, ".fork"), meta_right - lane_btn, y + lane_top, ICON_SHARE, "Fork", APP_BUTTON_QUIET, 0, CP_TURN_FORK);
          }
          if has_quote { cp_quote_button(f, cp_id(ib[..], i, ".aq"), x + lane_btn + a.gap_small, y, q_vis); }
          y += cp_copy_lane(f, cp_id(ib[..], i, ".ac"), x, y, q_vis, did, CP_COPY_REPLY);
        } else { y += a.gap; }
      } else {
        s[0].turns[i].ah = 0;
        if cp_flag(s, DC_FLAG_GIT) && s[0].turns[i].state != CP_RUNNING && cp_ckpt_has(s, i) {
          _ := cp_ckpt_turn_actions(s, f, i, x + cw, y);
          y += lane;
        }
      }
      if s[0].turns[i].cut {
        f[0].skin.motion.enter = 0;
        y += app_notice(f, cp_id(ib[..], i, ".c"), x, y, cw, "This reply is longer than 60,000 bytes. The rest is not shown.", APP_NOTICE_INFO) + a.gap;
        f[0].skin.motion.enter = enter;
      }
      st := s[0].turns[i].state;
      if st == CP_RUNNING {
        y += cp_fu_pending_steers(s, f, i, x, y, cw);
        // before its worker's first line (or while loading the local model) the turn has not begun: no clock
        no_clock := (s[0].turns[i].loading_model || !s[0].turns[i].heard) && !s[0].turns[i].stopping;
        y += app_working(f, cp_id(ib[..], i, ".t"), x, y, ifx no_clock then -1 else cast(int) (s[0].clock - s[0].turns[i].began),
                         cp_working_word(s, i)) + a.gap;
      }
      else if st == CP_FAILED {
        if s[0].live_reply != i { f[0].skin.motion.enter = 0; }
        y += app_notice(f, cp_id(ib[..], i, ".n"), x, y, cw, cast(string) s[0].turns[i].note[0..<s[0].turns[i].note_n], APP_NOTICE_ERROR) + a.gap;
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
      }
      else if st == CP_STOPPED { y += app_meta(f, cp_id(ib[..], i, ".s"), x, y, cw, "Stopped", false) + a.gap; }
      if i + 1 < s[0].nturns { y += a.gap; }
      real := y - y0;
      hit := cp_find_turn_has_hit(s, i);
      if hit > 0 && real > 4.0f32 {
        sheet_fill(f[0].sheet, x - 10.0f32, y0, 3.0f32, real - a.gap, 1.5f32, ifx hit == 2 then k.accent else opacity(k.accent, 0.45f32));
      }
      if abs(real - th) > 0.5 {
        s[0].anim = true;   // the content's height changed: one more frame settles it
        if !s[0].stick && !s[0].glide_on && y0 + th <= top { s[0].scroll += real - th; y -= real - th; }
      }
      s[0].turns[i].seen_h = real;
      s[0].turns[i].h = ifx st == CP_RUNNING then 0.0f32 else real; s[0].turns[i].hw = cw;
    }
  }
  enter0 := f[0].skin.motion.enter;
  if full && !running {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.full", x, y, cw, "This chat holds 1,000 messages. Start a new chat to send more.", APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0 {
    gb: [1024] u8; tb_el: [32] u8; gcb: [32] u8; gtkb: [32] u8;
    gn := el_put(gb[..], 0, "Goal ("); gn = el_put(gb[..], gn, cp_goal_status_label(s[0].goal_status));
    gn = el_put(gb[..], gn, " · "); gn = el_put(gb[..], gn, cp_goal_elapsed(tb_el[..], s[0].goal_time_seconds));
    if s[0].goal_turns > 0 {
      gn = el_put(gb[..], gn, " · "); gn = el_put_i(gb[..], gn, s[0].goal_turns);
      gn = el_put(gb[..], gn, ifx s[0].goal_turns == 1 then " turn" else " turns");
    }
    if s[0].goal_evals > 0 {
      gn = el_put(gb[..], gn, " · "); gn = el_put_i(gb[..], gn, s[0].goal_evals);
      gn = el_put(gb[..], gn, ifx s[0].goal_evals == 1 then " check" else " checks");
    }
    gcost := cp_goal_cost_delta(s);
    if gcost > 0 { gn = el_put(gb[..], gn, " · "); gn = el_put(gb[..], gn, cp_cost(gcb[..], gcost)); }
    if s[0].goal_tokens > 0 { gn = el_put(gb[..], gn, " · "); gn = el_put(gb[..], gn, cp_tokens(gtkb[..], s[0].goal_tokens)); gn = el_put(gb[..], gn, " tok"); }
    gn = el_put(gb[..], gn, "): ");
    obj_cut := ifx s[0].goal_objective_n > 280 then 280 else s[0].goal_objective_n;
    gn += cp_out(gb[gn..<gb.count], cast(string) s[0].goal_objective[0..<obj_cut]);
    if s[0].goal_objective_n > 280 { gn = el_put(gb[..], gn, "..."); }
    if s[0].goal_reason_n > 0 {
      gn = el_put(gb[..], gn, " — ");
      rcut := ifx s[0].goal_reason_n > 220 then 220 else s[0].goal_reason_n;
      gn += cp_out(gb[gn..<gb.count], cast(string) s[0].goal_reason[0..<rcut]);
      if s[0].goal_reason_n > 220 { gn = el_put(gb[..], gn, "..."); }
    }
    f[0].skin.motion.enter = 0;
    gkind := ifx s[0].goal_status == CP_GOAL_BLOCKED || s[0].goal_status == CP_GOAL_BUDGET_LIMITED || s[0].goal_status == CP_GOAL_FAILED then APP_NOTICE_ERROR else APP_NOTICE_INFO;
    y += app_notice(f, "coder.goal.banner", x, y, cw, sheet_pool(f[0].sheet, cast(string) gb[0..<gn]), gkind) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    tlabel := ifx s[0].goal_status == CP_GOAL_ACTIVE then "Pause goal" else "Resume goal";
    tw := app_button_width(f, -1, tlabel);
    ew := app_button_width(f, -1, "Edit goal");
    cw_btn := app_button_width(f, -1, "Complete");
    xw := app_button_width(f, -1, "Clear");
    bx := x;
    bh := app_button(f, "coder.goal.toggle", bx, y, tw, -1, tlabel, APP_BUTTON_DEFAULT, 0, CP_GOAL_TOGGLE);
    bx += tw + a.gap_small;
    if bx + ew <= x + cw { _ := app_button(f, "coder.goal.edit", bx, y, ew, -1, "Edit goal", APP_BUTTON_DEFAULT, 0, CP_GOAL_OPEN); bx += ew + a.gap_small; }
    if s[0].goal_status != CP_GOAL_COMPLETE && s[0].goal_status != CP_GOAL_FAILED && bx + cw_btn <= x + cw { _ := app_button(f, "coder.goal.complete", bx, y, cw_btn, -1, "Complete", APP_BUTTON_DEFAULT, 0, CP_GOAL_COMPLETE_ACT); bx += cw_btn + a.gap_small; }
    if bx + xw <= x + cw { _ := app_button(f, "coder.goal.clear", bx, y, xw, -1, "Clear", APP_BUTTON_DEFAULT, 0, CP_GOAL_CLEAR_ACT); }
    y += bh + a.gap;
  }
  if s[0].goal_notice_n > 0 {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.goal.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) s[0].goal_notice[0..<s[0].goal_notice_n]), APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if exceeded && cp_flag(s, DC_FLAG_USAGE) {
    cb1: [32] u8; bb1: [32] u8; nb: [160] u8;
    c_str := ifx s[0].cost_usd_micros > 0 then cp_cost(cb1[..], s[0].cost_usd_micros) else "$0.00";
    b_str := cp_cost(bb1[..], cp_budget(s));
    nn := el_put(nb[..], 0, "Chat budget reached ("); nn = el_put(nb[..], nn, c_str); nn = el_put(nb[..], nn, " / "); nn = el_put(nb[..], nn, b_str);
    nn = el_put(nb[..], nn, "). Approve continuing above budget or increase the limit.");
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.budget.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) nb[0..<nn]), APP_NOTICE_ERROR) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    aw := app_button_width(f, -1, "Continue above budget");
    ew := app_button_width(f, -1, "Edit budget");
    if aw + a.gap_small + ew <= cw {
      bh := app_button(f, "coder.budget.approve", x, y, aw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE);
      _ := app_button(f, "coder.budget.edit", x + aw + a.gap_small, y, ew, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT);
      y += bh + a.gap;
    } else {
      y += app_button(f, "coder.budget.approve", x, y, cw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE) + a.gap_small;
      y += app_button(f, "coder.budget.edit", x, y, cw, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT) + a.gap;
    }
  }
  // Same-frame scroll settle: keep the transcript bottom-locked when stick is true and never
  // paint a frame overscrolled past new_end when content shrinks (e.g. streaming finishes and
  // the activity group collapses).
  new_content := y + s[0].scroll + s[0].scr[0].stretch - top;
  new_end := new_content - s[0].view; if new_end < 0 { new_end = 0; }
  if s[0].stick || (!s[0].glide_on && s[0].scroll > new_end) {
    want := new_end;
    delta := s[0].scroll - want;
    if abs(delta) > 0.01f32 {
      can_shift := s[0].content > 0 && ((delta > 0 && (!culled_top || delta <= 160.0f32)) || (delta < 0 && (!culled_bot || -delta <= 160.0f32)));
      if can_shift {
        sh := f[0].sheet;
        prim_move(sh[0].under, from_conv.nu, sh[0].nu, 0, delta);
        prim_move(sh[0].over, from_conv.no, sh[0].no, 0, delta);
        sheet_hits_move(sh, from_conv.nh, 0, delta);
        if f[0].rows.count > 0 {
          t := f[0].rows;
          for ri: from_conv.nr..<t[0].n {
            t[0].rows[ri].y += delta;
            if t[0].rows[ri].clipped {
              if t[0].rows[ri].ct > top {
                t[0].rows[ri].ct += delta;
                if t[0].rows[ri].ct < top { t[0].rows[ri].ct = top; }
              }
              if t[0].rows[ri].cb < bottom {
                t[0].rows[ri].cb += delta;
                if t[0].rows[ri].cb > bottom { t[0].rows[ri].cb = bottom; }
              }
            }
            if t[0].rows[ri].transformed {
              for pk: 0..<t[0].rows[ri].polygon_n { t[0].rows[ri].polygon[pk * 2 + 1] += delta; }
            }
          }
        }
        for li: conv_nl..<sh[0].nl { sh[0].lines[li].y += delta; }
        for ti: 0..<s[0].nturns { if s[0].turns[ti].ah > 0 { s[0].turns[ti].ay += delta; } }
        if s[0].live_on { s[0].live_r[1] += delta * sc; }
        s[0].scroll = want;
        y += delta;
      } else {
        s[0].scroll = want;
        s[0].anim = true;
      }
    }
  }
  conv_scroll := s[0].scroll + s[0].scr[0].stretch;
  cp_sel_record(s, CP_SEL_CONV, conv_nl, f[0].sheet[0].nl, left, top, w, bottom, conv_scroll);
  cp_sel_paint(s, f, CP_SEL_CONV, conv_nl, f[0].sheet[0].nl, conv_scroll);
  uiframe_unclip(f);
  s[0].content = new_content;
  // 28pt scroll-edge alpha fade masks into #000000 canvas (#14139)
  if s[0].nturns > 0 && s[0].view > 0 && s[0].content > s[0].view {
    cp_scroll_fade(f[0].sheet, left, top, w - left, bottom - top, f[0].skin.canvas,
                   s[0].scroll > 1.0f32, s[0].scroll + s[0].view < s[0].content - 1.0f32);
  }
  app_scroll_rail(f, s[0].scr[..], w, top, s[0].scroll, s[0].content, s[0].view, s[0].view, s[0].now, s[0].reduced);
  cp_minimap_draw(s, f, w, 0.0f32, bottom);
  cp_find_bar(s, f, left, w, 0.0f32);
  // away from the end long enough to mean it: the way back floats over the transcript's foot,
  // "New reply" while one is written or came meanwhile (#13745)
  s[0].at_end = s[0].stick || s[0].glide_on || s[0].scroll >= s[0].content - s[0].view - 2;
  if s[0].at_end { s[0].away_t = 0; s[0].unseen = false; }
  else if s[0].away_t < CP_AWAY { s[0].away_t += f[0].dt; s[0].anim = true; }
  writing := running || s[0].unseen;
  _ := app_jump_pill(f, "coder.jump", x + cw / 2, bottom - a.pill_lift, ifx writing then "New reply" else "Jump to latest", writing,
                     s[0].nturns > 0 && !s[0].at_end && s[0].away_t >= CP_AWAY, CP_JUMP);
}
// Where the transcript's view rests this frame (#13745): a glide toward the end under way (outQuad
// over CP_GLIDE, toward the end as it is now, resting there once it lands), else at the end while
// it sticks there.
cp_follow :: (s: [] CoderPage, dt: f32) {
  end := s[0].content - s[0].view; if end < 0 { end = 0; }
  if s[0].glide_on {
    s[0].glide_t += dt;
    p := ifx s[0].reduced then 1.0f32 else s[0].glide_t / cast(f32) CP_GLIDE;
    if p >= 1 { s[0].glide_on = false; s[0].stick = true; }
    else { s[0].scroll = s[0].glide_from + (end - s[0].glide_from) * ar_ease(AM_OUT_QUAD, p); s[0].anim = true; }
  }
  if s[0].stick { s[0].scroll = end; }
}
// The Foreman chat's HUD at (x, y), cw wide: its tier, budget and managed chats. Returns the height it takes.
cp_foreman_hud :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, cw: f32, running: bool, exceeded: bool) -> f32 {
  a := f[0].skin.app;
  hud: [1] FhudData;
  hud[0].tier_label = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then "Observe" else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then "Auto" else "Managed";
  hud[0].tier_status = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then FHUD_IDLE else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then FHUD_WARN else FHUD_RUNNING;
  hud[0].foreman_busy = s[0].foreman_busy || running;
  hud[0].collapsed = s[0].foreman_hud_collapsed;
  hud[0].toggle_action = CP_FOREMAN_HUD_TOGGLE;
  for ti: 0..<s[0].nturns {
    for ai: 0..<s[0].turns[ti].nagents {
      if s[0].turns[ti].agents[ai].state == CP_RUNNING { hud[0].agents_active += 1; }
    }
  }
  fcost := ifx s[0].cost_usd_micros > 0 then cp_cost(s[0].scratch[0..<32], s[0].cost_usd_micros) else "$0.00";
  fbud := cp_cost(s[0].scratch[32..<64], cp_budget(s));
  fln := el_put(s[0].scratch[64..<128], 0, fcost); fln = el_put(s[0].scratch[64..<128], fln, " / "); fln = el_put(s[0].scratch[64..<128], fln, fbud);
  hud[0].budget_text = sheet_pool(f[0].sheet, cast(string) s[0].scratch[64..<64 + fln]);
  b_lim := cp_budget(s);
  hud[0].budget_ratio = ifx b_lim > 0 then cast(f32) s[0].cost_usd_micros / cast(f32) b_lim else 0.0f32;
  if hud[0].budget_ratio > 1.0f32 { hud[0].budget_ratio = 1.0f32; }
  hud[0].budget_status = ifx exceeded then FHUD_FAILED else ifx hud[0].budget_ratio >= 0.8f32 then FHUD_WARN else FHUD_DONE;
  for q: 0..<s[0].nchats {
    if !s[0].chats[q].managed { continue; }
    hud[0].managed_total += 1;
    if s[0].chats[q].busy { hud[0].managed_busy += 1; }
    if hud[0].nnodes < FHUD_MAX_NODES {
      nn := el_put(s[0].scratch[0..<EL_ID], 0, "foreman.node.");
      nn = el_put(s[0].scratch[0..<EL_ID], nn, cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n]);
      ntitle := cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n];
      if ntitle.count == 0 { ntitle = "Managed chat"; }
      hud[0].nodes[hud[0].nnodes] = FhudNode.{
        id = sheet_pool(f[0].sheet, cast(string) s[0].scratch[0..<nn]),
        title = sheet_pool(f[0].sheet, ntitle),
        subtitle = ifx s[0].chats[q].busy then "Running · Managed" else "Standby · Managed",
        status = ifx s[0].chats[q].busy then FHUD_RUNNING else FHUD_DONE,
        action = CP_FOREMAN_HUD_OPEN,
      };
      hud[0].nnodes += 1;
    }
  }
  return fhud_hud(f, x, y, cw, hud[..]) + a.gap;
}
// The active thread's title for the chat header bar's top-left.
cp_chat_title :: (s: [] CoderPage, f: [] UiFrame) -> string {
  cur := cast(string) s[0].current[0..<s[0].current_n];
  if cp_flag(s, DC_FLAG_FOREMAN) && cur == "chat.foreman" { return "Foreman"; }
  if cur.count > 0 {
    for q: 0..<s[0].nchats {
      id := cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n];
      if id == cur && s[0].chats[q].title_n > 0 {
        return sheet_pool(f[0].sheet, cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n]);
      }
    }
  }
  if s[0].nturns > 0 && s[0].turns[0].ask_n > 0 {
    return sheet_single_line(f[0].sheet, cast(string) s[0].turns[0].ask[0..<s[0].turns[0].ask_n]);
  }
  return "New chat";
}
// The full-width chat header bar: opaque surface + crisp bottom border, thread title top-left,
// New worktree toggle on new chats, optional Git toolbar, and right-side corner icon buttons.
cp_corners :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, window_w: f32, running: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  side := a.icon_button;
  // the corners' buttons stand on the window's title bar, on its line, clear of its controls at the left
  cy := cp_bar_y(s, side);
  all := s[0].copied_kind == CP_COPIED_ALL;
  has_new := left == 0;
  has_copy := s[0].nturns > 0;
  // the code review (#13696): its button shows once an edit changed a file, or while it is open (git flag)
  review := cp_flag(s, DC_FLAG_GIT) && (s[0].review || cp_has_edits(s));
  has_term := cp_flag(s, DC_FLAG_TERMINAL);
  has_mv := cp_mv_enabled(s);
  // Pack visible corner buttons right-to-left with no dead gaps.
  rx := w - CP_CORNER;
  pane_btn_x: f32 = 0; new_x: f32 = 0; copy_x: f32 = 0; rev_x: f32 = 0; term_x: f32 = 0; mv_x: f32 = 0; ft_x: f32 = 0;
  rx -= side; pane_btn_x = rx;
  if has_new   { rx -= side; new_x = rx; }
  if has_copy  { rx -= side; copy_x = rx; }
  if review    { rx -= side; rev_x = rx; }
  if has_term  { rx -= side; term_x = rx; }
  if has_mv    { rx -= side; mv_x = rx; }
  rx -= side; ft_x = rx;
  // New worktree checkbox sits in the header bar on new chats, left of the corner icons.
  home := s[0].nturns == 0 && cast(string) s[0].current[0..<s[0].current_n] != "chat.foreman";
  show_wt := home && !running;
  w_wt := ifx show_wt then cp_foot_checkbox_width(f, "New worktree") else 0.0f32;
  min_left := ifx left >= 180.0f32 then left + 16.0f32 else cp_bar_clear(s);
  wt_x: f32 = 0;
  wt_drawn := false;
  right_for_title := rx - a.gap;
  if show_wt && rx - a.gap_small - w_wt >= min_left {
    wt_x = rx - a.gap_small - w_wt;
    wt_drawn = true;
    right_for_title = wt_x - a.gap;
  }
  git_right := ifx wt_drawn then wt_x - a.gap_small else rx - a.gap_small;
  title := cp_chat_title(s, f);
  // Reserve room for the header's title before drawing Git toolbar chips when Git is enabled.
  title_w := ceil(measure_width(f[0].m, k.title.face, title));
  if title_w > 220.0f32 { title_w = 220.0f32; }
  git_min := min_left + title_w + a.gap;
  if cp_flag(s, DC_FLAG_GIT) && s[0].git[0].in_repo && git_right - git_min >= 120.0f32 {
    right_for_title = git_min - a.gap;
  }
  // Quiet empty-chat canvas (#14138): omit heavy bottom border on a clean unscrolled empty chat.
  quiet_empty := home && s[0].scroll <= 1.0f32;
  cp_header_bar_styled(s, f, left, w, title, right_for_title, !quiet_empty);
  if wt_drawn {
    wy := cp_bar_y(s, k.cmp.chip_h);
    _ := cp_foot_checkbox(f, "coder.worktree", "Create a new git worktree for this chat", wt_x, wy, w_wt, "New worktree", s[0].new_chat_worktree, CP_WORKTREE_TOGGLE);
  }
  // Reserve space for visible corner buttons so Git toolbar chips never overlap them.
  if cp_flag(s, DC_FLAG_GIT) {
    cp_git_toolbar(s, f, git_min, git_right, cy);
  }
  if review {
    shown := cp_review_shown(s);
    _ := app_icon_button(f, "coder.review", rev_x, cy, ICON_PEN, ifx shown then "Close review" else "Review changes", APP_BUTTON_QUIET, ifx shown then EL_S_CURRENT else 0, CP_REVIEW);
  }
  if has_term {
    term_shown := cp_term_shown(s);
    _ := app_icon_button(f, "coder.term.toggle", term_x, cy, ICON_TERMINAL, ifx term_shown then "Hide terminal" else "Show terminal", APP_BUTTON_QUIET, ifx term_shown then EL_S_CURRENT else 0, CP_TERM_TOGGLE);
  }
  if has_mv {
    mv_shown := cp_mv_shown(s);
    _ := app_icon_button(f, "coder.mv.toggle", mv_x, cy, ICON_WIDGET, ifx mv_shown then "Hide Metaverse pane" else "Show Metaverse pane", APP_BUTTON_QUIET, ifx mv_shown then EL_S_CURRENT else 0, CP_MV_TOGGLE);
  }
  ft_shown := cp_fp_shown(s);
  _ := app_icon_button(f, "coder.ft.toggle", ft_x, cy, ICON_FOLDER, ifx ft_shown then "Hide file viewer" else "Show file viewer", APP_BUTTON_QUIET, ifx ft_shown then EL_S_CURRENT else 0, CP_FT_TOGGLE);
  if has_copy {
    _ := app_icon_button(f, "coder.copy", copy_x, cy, ifx all then k.icon_check else k.icon_copy, ifx all then "Copied" else "Copy chat", APP_BUTTON_QUIET,
                         0, CP_COPY_ALL);
  }
  if has_new {
    loc := ifx cp_flag(s, DC_FLAG_CUSTOMIZE) then s[0].cust[0].locale.active else CP_LOCALE_EN;
    _ := app_icon_button(f, "coder.new", new_x, cy, ICON_COMPOSE, cp_tr(loc, "new_chat"), APP_BUTTON_QUIET,
                         ifx s[0].nturns == 0 then EL_S_DISABLED else 0, CP_NEW);
  }
  // Discoverable top-right right-pane toggle (Opt+Cmd+S / click, #14138)
  any_pane := cp_other_pane_open(s);
  _ := app_icon_button(f, "coder.pane.toggle", pane_btn_x, cy, ICON_SIDEBAR_RIGHT,
                       ifx any_pane then "Hide workspace pane" else "Show workspace pane",
                       APP_BUTTON_QUIET, ifx any_pane then EL_S_CURRENT else 0, CP_RIGHT_PANE_TOGGLE);
}
// True on a clean empty chat when neither OpenAgents Cloud / BYO cloud credentials nor local
// Inkling weights are ready yet (unless the user explicitly opted into Developer -> Show other models
// or explicitly picked Local/Inkling in the composer). Every chat is a cloud chat (#14087); local
// Inkling 2 Mini is an optional $0 compute accelerator rather than a separate local-only mode.
cp_needs_cloud_onboarding :: (s: [] CoderPage) -> bool {
  if s.count < 1 || s[0].nturns != 0 || s[0].show_other_models { return false; }
  if cp_has_cloud_compute(s) || s[0].inkling { return false; }
  idx := cp_model_index(s);
  if cp_is_inkling(s, idx) || cp_is_flawed_local(s, idx) { return false; }
  return true;
}

CP_CLOUD_ONBOARD_TITLE :: "OpenAgents";
CP_CLOUD_ONBOARD_SUB :: "Sign in to start chatting with OpenAgents Cloud";
CP_CLOUD_ONBOARD_BODY :: "Frontier models on any machine with synced cloud chats and transparent usage. No local model download required.";
CP_CLOUD_ONBOARD_LOCAL_HEAD :: "Optional · Free ($0) local compute";
CP_CLOUD_ONBOARD_LOCAL_BODY :: "Download Inkling 2 Mini so Auto can run fast $0 on-device turns alongside OpenAgents Cloud.";

// Unified cloud-first onboarding card (#14087): replaces the legacy Inkling-only + Google
// Antigravity fallback card across macOS, Linux, and Windows.
cp_cloud_onboarding :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, h: f32) {
  k := f[0].skin; a := k.app; sh := f[0].sheet; th := cp_theme();
  card_w := ifx cw < 540.0f32 then cw else 540.0f32;
  cx := x + (cw - card_w) / 2.0f32;
  pad := 22.0f32;
  iw := card_w - 2.0f32 * pad;
  est_h := ifx s[0].local_os_ok && s[0].local_hw_ok then 330.0f32 else 230.0f32;
  cy := (h - est_h) / 2.0f32;
  min_y := cp_bar(s) + a.gap;
  if cy < min_y { cy = min_y; }
  card := sheet_box(sh, cx, cy, card_w, est_h, 16.0f32, 1.0f32, th.surface, th.border);
  region := uiframe_semantic(f, "coder.onboarding", EL_REGION, "OpenAgents Cloud sign-in", cx, cy, card_w, est_h, 0, 0);
  y := cy + pad;
  _ := sheet_text(sh, f[0].m, -1, cx + pad, y, k.strong.line, k.strong.face, th.text, app_fit(f, k.strong.face, CP_CLOUD_ONBOARD_TITLE, iw));
  y += k.strong.line + a.gap_small;
  _ := sheet_text(sh, f[0].m, -1, cx + pad, y, k.small.line, k.small.face, th.muted, app_fit(f, k.small.face, CP_CLOUD_ONBOARD_SUB, iw));
  y += k.small.line + a.gap;
  bh := control_copy(sh, f[0].m, k.small, th.muted, cx + pad, y, iw, CP_CLOUD_ONBOARD_BODY);
  _ := uiframe_semantic(f, "coder.onboarding.body", EL_TEXT, CP_CLOUD_ONBOARD_BODY, cx + pad, y, iw, bh, 0, 0);
  y += bh + a.gap;
  login_lbl := "Sign in to OpenAgents";
  byo_lbl := "Use your own API key";
  login_w := app_button_width(f, -1, login_lbl);
  byo_w := app_button_width(f, -1, byo_lbl);
  if login_w + a.gap_small + byo_w <= iw {
    bh1 := app_button(f, "coder.onboarding.login", cx + pad, y, login_w, -1, login_lbl, APP_BUTTON_PRIMARY, 0, CP_CLOUD_LOGIN);
    _ := app_button(f, "coder.onboarding.byo", cx + pad + login_w + a.gap_small, y, byo_w, -1, byo_lbl, APP_BUTTON_DEFAULT, 0, CP_CLOUD_BYO);
    y += bh1;
  } else {
    y += app_button(f, "coder.onboarding.login", cx + pad, y, iw, -1, login_lbl, APP_BUTTON_PRIMARY, 0, CP_CLOUD_LOGIN) + a.gap_small;
    y += app_button(f, "coder.onboarding.byo", cx + pad, y, iw, -1, byo_lbl, APP_BUTTON_DEFAULT, 0, CP_CLOUD_BYO);
  }
  y += a.gap;
  y += app_divider(f, cx + pad, y, iw) + a.gap;
  if s[0].local_os_ok && s[0].local_hw_ok {
    _ := uiframe_semantic(f, "coder.onboarding.local.head", EL_HEADING, CP_CLOUD_ONBOARD_LOCAL_HEAD, cx + pad, y, iw, k.label.line, 0, 0);
    _ := sheet_text(sh, f[0].m, -1, cx + pad, y, k.label.line, k.label.face, th.text, app_fit(f, k.label.face, CP_CLOUD_ONBOARD_LOCAL_HEAD, iw));
    y += k.label.line + a.gap_small;
    lh := control_copy(sh, f[0].m, k.small, th.muted, cx + pad, y, iw, CP_CLOUD_ONBOARD_LOCAL_BODY);
    _ := uiframe_semantic(f, "coder.onboarding.local.body", EL_TEXT, CP_CLOUD_ONBOARD_LOCAL_BODY, cx + pad, y, iw, lh, 0, 0);
    y += lh + a.gap;
    if s[0].local_dl_state == CP_LOCAL_DOWNLOADING {
      s[0].anim = true;
      pb: [128] u8; pn := el_put(pb[..], 0, "Downloading Inkling 2 Mini — ");
      if s[0].local_dl_total_mb > 0 {
        pn = el_put_i(pb[..], pn, s[0].local_dl_mb); pn = el_put(pb[..], pn, " / ");
        pn = el_put_i(pb[..], pn, s[0].local_dl_total_mb); pn = el_put(pb[..], pn, " MB (");
        pn = el_put_i(pb[..], pn, s[0].local_dl_pct); pn = el_put(pb[..], pn, "%)");
      } else {
        pn = el_put_i(pb[..], pn, s[0].local_dl_pct); pn = el_put(pb[..], pn, "%");
      }
      ptext := sheet_pool(sh, cast(string) pb[0..<pn]);
      y += app_meta(f, "coder.onboarding.status", cx + pad, y, iw, ptext, false) + a.gap_small;
      bar_h := 8.0f32;
      pct_clamped := ifx s[0].local_dl_pct < 0 then 0 else ifx s[0].local_dl_pct > 100 then 100 else s[0].local_dl_pct;
      share := cast(f32) pct_clamped / 100.0f32;
      prow := uiframe_semantic(f, "coder.onboarding.progress", EL_PROGRESS, "Download progress", cx + pad, y, iw, bar_h, 0, 0);
      elt_value_share(f[0].rows, prow, share);
      sheet_fill(sh, cx + pad, y, iw, bar_h, 4.0f32, th.raised);
      if share > 0 { sheet_fill(sh, cx + pad, y, iw * share, bar_h, 4.0f32, th.accent); }
      y += bar_h + a.gap;
      cw_btn := app_button_width(f, -1, "Cancel download");
      y += app_button(f, "coder.local.cancel", cx + pad, y, cw_btn, -1, "Cancel download", APP_BUTTON_DEFAULT, 0, CP_LOCAL_CANCEL);
    } else if s[0].local_dl_state == CP_LOCAL_VERIFYING {
      s[0].anim = true;
      activity(sh, k, cx + pad, y, a.icon, f[0].clock, f[0].reduced_motion);
      y += app_meta(f, "coder.onboarding.verifying", cx + pad + a.icon + a.gap_small, y, iw - a.icon - a.gap_small,
                    "Verifying SHA-256 checksum of local GGUF checkpoint…", false);
    } else if s[0].local_dl_state == CP_LOCAL_STARTING {
      s[0].anim = true;
      activity(sh, k, cx + pad, y, a.icon, f[0].clock, f[0].reduced_motion);
      y += app_meta(f, "coder.onboarding.starting", cx + pad + a.icon + a.gap_small, y, iw - a.icon - a.gap_small,
                    "Loading local Inkling 2 Mini…", false);
    } else if s[0].local_dl_state == CP_LOCAL_SERVER_ERROR {
      emsg := ifx s[0].local_dl_err_n > 0 then sheet_pool(sh, cast(string) s[0].local_dl_err[0..<s[0].local_dl_err_n])
              else "Inkling 2 Mini could not start. Click Retry to try again.";
      y += app_notice(f, "coder.onboarding.error", cx + pad, y, iw, emsg, APP_NOTICE_ERROR) + a.gap_small;
      bw := app_button_width(f, -1, "Retry");
      y += app_button(f, "coder.local.dl", cx + pad, y, bw, -1, "Retry", APP_BUTTON_DEFAULT, 0, CP_LOCAL_DL);
    } else if s[0].local_dl_state == CP_LOCAL_ERROR {
      emsg := ifx s[0].local_dl_err_n > 0 then sheet_pool(sh, cast(string) s[0].local_dl_err[0..<s[0].local_dl_err_n])
              else "Download failed. Check your internet connection and free disk space, then try again.";
      y += app_notice(f, "coder.onboarding.error", cx + pad, y, iw, emsg, APP_NOTICE_ERROR) + a.gap_small;
      bw := app_button_width(f, -1, "Retry download");
      y += app_button(f, "coder.local.dl", cx + pad, y, bw, -1, "Retry download", APP_BUTTON_DEFAULT, 0, CP_LOCAL_DL);
    } else {
      dl_lbl := "Download Inkling 2 Mini ($0)";
      bw := app_button_width(f, -1, dl_lbl);
      y += app_button(f, "coder.local.dl", cx + pad, y, bw, -1, dl_lbl, APP_BUTTON_DEFAULT, 0, CP_LOCAL_DL);
    }
  } else {
    y += app_meta(f, "coder.onboarding.cloud_note", cx + pad, y, iw,
                  "OpenAgents Cloud runs frontier models on this computer with no local model download required.", false);
  }
  final_h := y + pad - cy;
  if card >= 0 { sh[0].under[card].h = final_h; }
  if region >= 0 { f[0].rows[0].rows[region].h = final_h; }
  s[0].bar_h = 0.0f32;
}

// Bottom control row inset inside the composer card (decoupled from k.cmp.radius = 16 so the
// 28pt paperclip/chips sit 14pt from the inner side/bottom edges and the 32pt Send button sits
// 14pt from the right and 12pt from the bottom instead of collapsing to 1pt/-1pt).
CP_COMPOSER_FOOT_INSET :: 14;
CP_COMPOSER_FOOT_CORNER :: CP_COMPOSER_FOOT_INSET + ZC_CONTROL / 2;

// The composer, x and cw as the conversation (#13743): Zeron's pill (components/zeron/composer.coax's
// zc_pill), compact on one 49 row while the draft fits and expanded over it, and its foot under it:
// the model (Command-/ opens its menu, when extra model flags are enabled) on the left, and on the right
// the chat's goal, its cost (when usage is on), how full the context is, and the working folder.
cp_composer :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  is_foreman := cp_flag(s, DC_FLAG_FOREMAN) && cast(string) s[0].current[0..<s[0].current_n] == "chat.foreman";
  // On a fresh profile with no cloud sign-in/credentials and no local Inkling weights ready,
  // present unified cloud-first onboarding (no Antigravity fallback, no mandatory 17 GB wait; #14087).
  if !is_foreman && cp_needs_cloud_onboarding(s) {
    cp_cloud_onboarding(s, f, x, cw, h);
    return;
  }
  centred := s[0].nturns == 0 && !is_foreman;
  foot := k.cmp.chip_h + a.gap_small;
  g := cp_pill_shape(s, f, cw);
  box_y := h - cast(f32) CP_BOTTOM - foot - g.height;
  if centred {
    least := zc_pill(cw, 0, 0, k.cmp.line, cast(f32) ZC_TRAILING, cast(f32) CP_COMPOSER_FOOT_CORNER, true, false, false).height;
    top := (h - least - foot) / 2;
    if top < cast(f32) CP_CORNER + a.icon_button { top = cast(f32) CP_CORNER + a.icon_button; }
    if top < box_y { box_y = top; }
  }
  no_local := cp_local_unavailable(s);
  s[0].box = cp_zeron_composer(s, f, x, box_y, cw, g, running, full || exceeded || no_local);
  s[0].bar_h = h - cast(f32) CP_BOTTOM - box_y;
  cp_fu_tray(s, f, x, box_y - a.gap_small, cw, running);
  todos_h: f32 = 0.0f32;
  if !s[0].todos[0].docked { todos_h = cp_todos_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h, cw, true); }
  git_h := ifx cp_flag(s, DC_FLAG_GIT) then cp_git_output_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h, cw) else 0.0f32;
  permit_h := cp_permit_card(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h, cw);
  oauth_h := ifx cp_flag(s, DC_FLAG_MCP) then cp_mcp_oauth_card(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h, cw) else 0.0f32;
  voice_h := cp_voice_pill(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h - oauth_h, cw);
  stash_h := ifx cp_flag(s, DC_FLAG_RICH) then cp_stash_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h - oauth_h - voice_h, cw) else 0.0f32;
  tray_top := box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h - oauth_h - voice_h - stash_h;
  // Quiet, borderless readiness / download progress caption above the composer.
  loading_bg := !no_local && !running && s[0].inkling && s[0].local_dl_state == CP_LOCAL_STARTING && (cp_is_inkling(s, cp_model_index(s)) || cp_is_flawed_local(s, cp_model_index(s)));
  if no_local || loading_bg {
    sh := f[0].sheet; th := cp_theme();
    st := s[0].local_dl_state;
    mname := cp_inkling_label(s);
    if st == CP_LOCAL_DOWNLOADING {
      s[0].anim = true;
      pb: [192] u8; pn := el_put(pb[..], 0, "Downloading ");
      pn = el_put(pb[..], pn, mname);
      pn = el_put(pb[..], pn, " — ");
      if s[0].local_dl_total_mb > 0 {
        pn = el_put_i(pb[..], pn, s[0].local_dl_mb); pn = el_put(pb[..], pn, " / ");
        pn = el_put_i(pb[..], pn, s[0].local_dl_total_mb); pn = el_put(pb[..], pn, " MB (");
        pn = el_put_i(pb[..], pn, s[0].local_dl_pct); pn = el_put(pb[..], pn, "%)");
      } else {
        pn = el_put_i(pb[..], pn, s[0].local_dl_pct); pn = el_put(pb[..], pn, "%");
      }
      ptext := sheet_pool(sh, cast(string) pb[0..<pn]);
      cancel_w := cp_foot_chip_width(f, -1, "Cancel", false);
      bar_h := 6.0f32;
      cap_h := k.cmp.chip_h + bar_h + 6.0f32;
      cap_y := tray_top - cap_h - 4.0f32;
      avail_w := cw - a.icon - a.gap_small - cancel_w - a.gap_small - 16.0f32;
      if avail_w < 80.0f32 { avail_w = 80.0f32; }
      mfit := app_fit(f, k.small.face, ptext, avail_w);
      mw := ceil(measure_width(f[0].m, k.small.face, mfit));
      row_w := a.icon + a.gap_small + mw + a.gap_small + cancel_w;
      rx := x + (cw - row_w) / 2.0f32;
      ty := cap_y + (k.cmp.chip_h - k.small.line) / 2.0f32;
      activity(sh, k, rx, cap_y + (k.cmp.chip_h - a.icon) / 2.0f32, a.icon, f[0].clock, f[0].reduced_motion);
      _ := uiframe_semantic(f, "coder.local.status", EL_TEXT, mfit, rx + a.icon + a.gap_small, ty, mw, k.small.line, 0, 0);
      _ := sheet_text(sh, f[0].m, -1, rx + a.icon + a.gap_small, ty, k.small.line, k.small.face, th.muted, mfit);
      _ := cp_foot_chip(f, "coder.local.cancel", "Cancel download", rx + a.icon + a.gap_small + mw + a.gap_small, cap_y, cancel_w, -1, "Cancel", false, 0, CP_LOCAL_CANCEL);
      bar_w := ifx cw < 420.0f32 then cw - 16.0f32 else 420.0f32;
      bx := x + (cw - bar_w) / 2.0f32;
      by := cap_y + k.cmp.chip_h + 4.0f32;
      pct_clamped := ifx s[0].local_dl_pct < 0 then 0 else ifx s[0].local_dl_pct > 100 then 100 else s[0].local_dl_pct;
      share := cast(f32) pct_clamped / 100.0f32;
      prow := uiframe_semantic(f, "coder.onboarding.progress", EL_PROGRESS, "Download progress", bx, by, bar_w, bar_h, 0, 0);
      elt_value_share(f[0].rows, prow, share);
      sheet_fill(sh, bx, by, bar_w, bar_h, 3.0f32, th.raised);
      if share > 0 { sheet_fill(sh, bx, by, bar_w * share, bar_h, 3.0f32, th.accent); }
      s[0].bar_h += cap_h + a.gap_small + 4.0f32;
    } else if st == CP_LOCAL_STARTING || st == CP_LOCAL_VERIFYING {
      s[0].anim = true;
      cap_h := k.small.line;
      cap_y := tray_top - cap_h - 4.0f32;
      vb: [160] u8; vn := 0;
      if st == CP_LOCAL_STARTING {
        vn = el_put(vb[..], 0, "Loading model…");
      } else {
        vn = el_put(vb[..], 0, "Verifying ");
        vn = el_put(vb[..], vn, mname);
        vn = el_put(vb[..], vn, " SHA-256…");
      }
      msg := sheet_pool(sh, cast(string) vb[0..<vn]);
      mfit := app_fit(f, k.small.face, msg, cw - a.icon - a.gap_small - 16.0f32);
      mw := ceil(measure_width(f[0].m, k.small.face, mfit));
      row_w := a.icon + a.gap_small + mw;
      rx := x + (cw - row_w) / 2.0f32;
      activity(sh, k, rx, cap_y + (cap_h - a.icon) / 2.0f32, a.icon, f[0].clock, f[0].reduced_motion);
      sid := ifx st == CP_LOCAL_VERIFYING then "coder.onboarding.verifying" else "coder.local.status";
      _ := uiframe_semantic(f, sid, EL_TEXT, mfit, rx + a.icon + a.gap_small, cap_y, mw, k.small.line, 0, 0);
      _ := sheet_text(sh, f[0].m, -1, rx + a.icon + a.gap_small, cap_y, k.small.line, k.small.face, th.muted, mfit);
      s[0].bar_h += cap_h + a.gap_small + 4.0f32;
    } else {
      show_action := s[0].local_os_ok && s[0].local_hw_ok;
      cap_h := ifx show_action then k.cmp.chip_h else k.small.line;
      cap_y := tray_top - cap_h - 4.0f32;
      is_err := st == CP_LOCAL_SERVER_ERROR || st == CP_LOCAL_ERROR;
      btn_lbl := ifx is_err then "Retry" else "Download";
      btn_w := ifx show_action then cp_foot_chip_width(f, -1, btn_lbl, false) else 0.0f32;
      nb: [192] u8; nn := 0;
      raw_msg := "";
      if s[0].local_dl_err_n > 0 {
        raw_msg = sheet_pool(sh, cast(string) s[0].local_dl_err[0..<s[0].local_dl_err_n]);
      } else if !s[0].local_os_ok || !s[0].local_hw_ok {
        nn = el_put(nb[..], 0, mname); nn = el_put(nb[..], nn, " is not supported on this Mac");
        raw_msg = sheet_pool(sh, cast(string) nb[0..<nn]);
      } else {
        nn = el_put(nb[..], 0, mname); nn = el_put(nb[..], nn, " is not downloaded");
        raw_msg = sheet_pool(sh, cast(string) nb[0..<nn]);
      }
      avail_w := cw - (ifx show_action then btn_w + a.gap_small else 0.0f32) - 16.0f32;
      if avail_w < 60.0f32 { avail_w = 60.0f32; }
      mfit := app_fit(f, k.small.face, raw_msg, avail_w);
      mw := ceil(measure_width(f[0].m, k.small.face, mfit));
      row_w := mw + (ifx show_action then a.gap_small + btn_w else 0.0f32);
      rx := x + (cw - row_w) / 2.0f32;
      ty := cap_y + (cap_h - k.small.line) / 2.0f32;
      sid := ifx is_err then "coder.onboarding.error" else "coder.local.status";
      _ := uiframe_semantic(f, sid, EL_TEXT, mfit, rx, ty, mw, k.small.line, 0, 0);
      _ := sheet_text(sh, f[0].m, -1, rx, ty, k.small.line, k.small.face, ifx is_err then th.danger else th.muted, mfit);
      if show_action {
        _ := cp_foot_chip(f, "coder.local.dl", btn_lbl, rx + mw + a.gap_small, cap_y, btn_w, -1, btn_lbl, false, 0, CP_LOCAL_DL);
      }
      s[0].bar_h += cap_h + a.gap_small + 4.0f32;
    }
  } else if s[0].migrated_from_n > 0 && s[0].nturns > 0 {
    sh := f[0].sheet; th := cp_theme();
    from_id := cast(string) s[0].migrated_from[0..<s[0].migrated_from_n];
    mb: [160] u8; mn := el_put(mb[..], 0, "Started on ");
    mn = el_put(mb[..], mn, cp_model_known_label(from_id));
    mn = el_put(mb[..], mn, " · continues on ");
    mn = el_put(mb[..], mn, cp_inkling_label(s));
    mfit := app_fit(f, k.small.face, sheet_pool(sh, cast(string) mb[0..<mn]), cw - 16.0f32);
    mw := ceil(measure_width(f[0].m, k.small.face, mfit));
    mx := x + (cw - mw) / 2.0f32;
    cap_y := tray_top - k.small.line - 4.0f32;
    _ := uiframe_semantic(f, "coder.migrated", EL_TEXT, mfit, mx, cap_y, mw, k.small.line, 0, 0);
    _ := sheet_text(sh, f[0].m, -1, mx, cap_y, k.small.line, k.small.face, th.faint, mfit);
    s[0].bar_h += k.small.line + a.gap_small + 4.0f32;
  }
  foot_y := box_y + g.height + a.gap_small;
  m_x := cp_composer_foot(s, f, x, foot_y, cw, running, exceeded);
  if centred && s[0].art[0].n > 0 && foot_y + k.cmp.chip_h + 110.0f32 < h {
    _ := cp_recent_artifacts_strip(s, f, x, foot_y + k.cmp.chip_h + 24.0f32, cw);
  }
  if cp_models(s) > 0 && s[0].model_menu { cp_model_menu(s, f, x, cw, s[0].model_x, box_y, foot_y, h); }
  if s[0].effort_menu { cp_effort_menu(s, f, x, cw, s[0].effort_x, box_y, foot_y, h); }
  _ = m_x;
  if s[0].usage[0].popover_open { cp_usage_popover(s, f, x, cw, box_y, foot_y, h); }
  // the @ and / popover at the draft's token (mention.coax, #13699)
  cp_mn_sync(s); cp_mn_due(s);
  if !(cp_models(s) > 0 && s[0].model_menu) && !s[0].effort_menu && !s[0].usage[0].popover_open { cp_mn_paint(s, f, x, cw); }
}
// The pill's shape this frame for a column cw wide: the draft's width on one line and its rows at
// the expanded text width, the shape that makes, and the run toward it (220 ms, none with reduced
// motion). A new chat keeps it expanded; a draft of lines expands it.
cp_pill_shape :: (s: [] CoderPage, f: [] UiFrame, cw: f32) -> ZcPill {
  k := f[0].skin; a := s[0].atlas[..];
  text := eb_text(s[0].draft[..]);
  lines := false; for c: text { if c == 10 { lines = true; break; } }
  line := k.cmp.line;
  wide: f32 = 0;
  if !lines {
    if !a[0].ready { wide = cast(f32) text.count * line / 2; }
    else if text.count > CP_PILL_MEASURE { wide = cw; }   // far past a line: no need to measure it all
    else { wide = text_width(a, CP_COMPOSER_FACE, text); }
  }
  open_w := cw - cast(f32) (ZC_BORDER * 2 + ZC_TEXT_OPEN_SIDE * 2);
  rows := cast(f32) cp_ed_lines(s, k, open_w) * line;
  cargo := cp_cargo_n(s) > 0;   // attachments keep it expanded, their strip over the text (#13699)
  // Always use the 2-row expanded T3 Code card layout (prompt area on top, controls row inside bottom).
  target := zc_pill(cw, wide, rows, line, cast(f32) ZC_TRAILING, cast(f32) CP_COMPOSER_FOOT_CORNER, true, lines, s[0].pill_next);
  s[0].pill_next = target.next_text;
  if cargo { target = zc_with_cargo(target, cp_cargo_height(s, f, cw)); }
  g := zc_motion_step(s[0].pill[..], target, f[0].dt, s[0].reduced);
  if zc_moving(s[0].pill[..]) { s[0].anim = true; }
  return g;
}

// Zeron's chat composer pill (ds/composer.luau, ds/composer_layout.luau) in the page's theme (cp_theme(), Coder Noir)
// at (x, y), w wide, in shape g: its radius (26, at most half its height), the composer's solid and
// edge (firmer with the keyboard), its 0 12 32 shadow, the 28 round + (a working folder) at its
// start, the text, the 28 round mic dictation button (#13882), and the 32 round Send / Stop at its end.
cp_zeron_composer :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32, g: ZcPill, running: bool, off: bool) -> ComposerBox {
  k := f[0].skin; sh := f[0].sheet;
  border := cast(f32) ZC_BORDER;
  radius := k.cmp.radius; if radius > g.height / 2 { radius = g.height / 2; }
  text := eb_text(s[0].draft[..]);
  editing := cp_composer_focused(s) && !s[0].model_menu && !s[0].effort_menu;
  th := cp_theme();
  z_solid := th.surface; z_edge := th.border; z_edge_focus := th.line_strong;
  z_pri_bg := th.primary; z_pri_hov := th.primary_hover; z_pri_prs := th.primary_active; z_pri_ink := th.bg;
  z_dis_bg := th.secondary; z_dis_ink := th.disabled;
  sheet_under(sh, uiskin_shadow(sh[0].under, sh[0].nu, x, y, w, g.height, radius, k.shadows.composer));
  field_state := (ifx editing then EL_S_FOCUSED else 0) | (ifx off then EL_S_DISABLED else 0);
  field_row := uiframe_semantic(f, "coder.composer", EL_FIELD, "Message", x, y, w, g.height, field_state, CP_FIELD);
  elt_value(f[0].rows, field_row, text);
  elt_value(f[0].rows, uiframe_semantic(f, "coder.composer.shape", EL_REGION, ifx g.expanded then "Expanded" else "Compact", x, y, w, g.height, 0, 0), ifx g.expanded then "expanded" else "compact");
  _ := sheet_box(sh, x, y, w, g.height, radius, border, z_solid, ifx editing && !off then z_edge_focus else z_edge);
  sheet_hit(sh, UIFRAME_HIT, field_row, 0, x, y, w, g.height);
  // Clean minimal placeholder (never cluttered with shortcut hints).
  hint := "Message OpenAgents";
  if !running && cp_local_unavailable(s) {
    st := s[0].local_dl_state;
    hint = ifx st == CP_LOCAL_STARTING then "Loading model…"
           else ifx st == CP_LOCAL_VERIFYING then "Verifying local model…"
           else ifx st == CP_LOCAL_DOWNLOADING then "Downloading local model…"
           else "Click the model below to download";
  }
  has_voice := cp_flag(s, DC_FLAG_VOICE);
  mic_side := cast(f32) ZC_CONTROL; mic_gap := 6.0f32;
  tx := border + g.text_left; tw := w - 2 * border - g.text_left - g.text_right - (ifx g.expanded || !has_voice then 0.0f32 else mic_side + mic_gap);
  if tw < g.line { tw = g.line; }
  cp_ed_draw(s, f, CP_ED_COMPOSER, x + tx, y + border + g.text_top, tw, g.text_h, hint);
  // the draft's attachments over its text (attach.coax)
  if cp_cargo_n(s) > 0 && g.expanded { cp_cargo_draw(s, f, x, y, w); }
  // Bottom-left paperclip attach button (T3 Code layout; opens attach files / change folder menu)
  control := cast(f32) ZC_CONTROL;
  lx := x + border + g.lead_left; ly := y + g.height - border - g.lead_bottom - control;
  s[0].add_x = lx + control / 2; s[0].add_y = ly + control;
  lead_off := false;
  lead_row := uiframe_semantic(f, "coder.composer.add", EL_BUTTON, "Attach files or change the folder", lx, ly, control, control, 0, CP_ASK_ADD_PRESS);
  lead_hov := !lead_off && uiframe_hovered(f, "coder.composer.add");
  lead_prs := !lead_off && uiframe_pressed(f, "coder.composer.add");
  if lead_prs || lead_hov { sheet_fill(sh, lx, ly, control, control, control / 2, ifx lead_prs then th.pressed else th.hover); }
  lead_ink := ifx lead_off then th.faint else ifx lead_hov || lead_prs then th.text else th.muted;
  clip_ic := 16.0f32;
  sheet_icon(sh, ICON_PAPERCLIP, lx + (control - clip_ic) / 2, ly + (control - clip_ic) / 2, clip_ic, lead_ink);
  if !lead_off { sheet_hit(sh, UIFRAME_HIT, lead_row, 0, lx, ly, control, control); }
  // Bottom-right cluster (T3 Code layout): [Model] [Effort] [Mic] [Send / Red Stop]
  send := cast(f32) ZC_TRAILING;
  sx := x + w - border - g.trail_right - send; sy := y + g.height - border - g.trail_bottom - send;
  right_x := sx;
  if has_voice {
    right_x -= mic_gap + mic_side;
    cp_voice_mic_button(s, f, right_x, sy + (send - mic_side) / 2, mic_side);
  }
  chip_y := sy + (send - k.cmp.chip_h) / 2;
  min_chip_x := lx + control + 8.0f32;
  e_label := cp_effort_label(s, cp_model_index(s));
  w_effort := cp_foot_chip_width(f, -1, e_label, true);
  if right_x - 6.0f32 - w_effort >= min_chip_x {
    right_x -= 6.0f32 + w_effort;
    s[0].effort_x = right_x;
    _ := cp_foot_chip(f, "coder.effort", "Thinking level (⇧Tab)", right_x, chip_y, w_effort, -1, e_label, true, ifx s[0].effort_menu then EL_S_CURRENT else 0, CP_EFFORT_MENU);
  } else {
    s[0].effort_x = right_x;
  }
  show_model := cp_models(s) > 0;
  if show_model {
    m_label := cp_model_label(s, cp_model_index(s));
    w_model := cp_foot_chip_width(f, -1, m_label, true);
    avail_m := right_x - 4.0f32 - min_chip_x;
    if avail_m > 48.0f32 {
      mw := ifx w_model < avail_m then w_model else avail_m;
      right_x -= 4.0f32 + mw;
      s[0].model_x = right_x;
      _ := cp_foot_chip(f, "coder.model", ifx s[0].ctrl_keys then "Model (Ctrl+/)" else "Model (⌘/)", right_x, chip_y, mw, -1, m_label, true, ifx s[0].model_menu then EL_S_CURRENT else 0, CP_MODEL_MENU);
    } else {
      s[0].model_x = min_chip_x;
    }
  } else {
    s[0].model_x = min_chip_x;
  }
  can_send := running || (!off && (text.count > 0 || cp_cargo_n(s) > 0));
  loc := ifx cp_flag(s, DC_FLAG_CUSTOMIZE) then s[0].cust[0].locale.active else CP_LOCALE_EN;
  send_label := ifx running then cp_tr(loc, "stop") else cp_tr(loc, "send");
  send_row := uiframe_semantic(f, "coder.composer.send", EL_BUTTON, send_label, sx, sy, send, send, ifx !can_send then EL_S_DISABLED else 0, CP_SEND);
  send_hov := can_send && uiframe_hovered(f, "coder.composer.send");
  send_prs := can_send && uiframe_pressed(f, "coder.composer.send");
  mono := cp_cust_is_monochrome(s);
  stop_bg := ifx mono
    then (ifx send_prs then z_pri_prs else ifx send_hov then z_pri_hov else z_pri_bg)
    else (ifx send_prs then noir_mix(th.danger, 0, 0.16) else ifx send_hov then noir_mix(th.danger, 1, 0.14) else th.danger);
  send_bg := ifx running then stop_bg else ifx !can_send then z_dis_bg else ifx send_prs then z_pri_prs else ifx send_hov then z_pri_hov else z_pri_bg;
  send_ink := ifx running then (ifx mono then z_pri_ink else hex(0xffffff, 1)) else ifx !can_send then z_dis_ink else z_pri_ink;
  sheet_fill(sh, sx, sy, send, send, send / 2, send_bg);
  if running {
    sq := k.cmp.stop;
    sheet_fill(sh, sx + (send - sq) / 2, sy + (send - sq) / 2, sq, sq, k.cmp.stop_radius, send_ink);
  } else {
    ic := cast(f32) CP_SEND_ICON;
    sheet_icon(sh, ICON_ARROW_UP, sx + (send - ic) / 2, sy + (send - ic) / 2, ic, send_ink);
  }
  sheet_hit(sh, UIFRAME_HIT, send_row, 0, sx, sy, send, send);
  return ComposerBox.{height = g.height, text_x = tx, text_y = border + g.text_top, text_w = tw, text_h = g.text_h, inset = 0.0f32, line = g.line,
                      row_y = sy - y, send_x = sx - x, send = send};
}

CP_FOOT_FOLDER_ICON :: 11.0f32;
CP_FOOT_FOLDER_GAP :: 6.0f32;
cp_foot_chip_icon_size :: (c: UiComposer, icon: int) -> f32 { return ifx icon == ICON_FOLDER_11 || icon == ICON_FOLDER then CP_FOOT_FOLDER_ICON else c.chip_icon; }
cp_foot_chip_icon_gap :: (c: UiComposer, icon: int) -> f32 { return ifx icon == ICON_FOLDER_11 || icon == ICON_FOLDER then CP_FOOT_FOLDER_GAP else c.chip_gap; }

// A chip of the composer's foot (Zeron's quiet chip): no ground until hovered or pressed; an icon
// (-1: none), its text cut to w, a chevron when it opens a menu. EL_S_CURRENT holds it lit,
// EL_S_DISABLED dims it and takes no press. Returns its width.
cp_foot_chip :: (f: [] UiFrame, id: string, label: string, x: f32, y: f32, w: f32, icon: int, text: string, chevron: bool, state: int, action: int) -> f32 {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme(); c := k.cmp;
  off := (state & EL_S_DISABLED) != 0; on := (state & EL_S_CURRENT) != 0;
  row := uiframe_semantic(f, id, EL_BUTTON, label, x, y, w, c.chip_h, state, ifx off then 0 else action);
  elt_value(f[0].rows, row, text);
  hov := !off && uiframe_hovered(f, id); prs := !off && uiframe_pressed(f, id);
  if prs || hov || on { sheet_fill(sh, x, y, w, c.chip_h, c.chip_radius, ifx prs then th.pressed else th.hover); }
  ink := ifx off then th.faint else ifx on || hov || prs then th.text else th.muted;
  tx := x + c.chip_pad; room := w - 2 * c.chip_pad;
  if icon >= 0 {
    ic := cp_foot_chip_icon_size(c, icon);
    ig := cp_foot_chip_icon_gap(c, icon);
    sheet_icon(sh, icon, tx, y + (c.chip_h - ic) / 2, ic, ink);
    tx += ic + ig; room -= ic + ig;
  }
  chev := cast(f32) CP_CHEVRON;
  if chevron { room -= chev + c.chip_gap; sheet_icon(sh, ICON_CHEVRON, x + w - c.chip_pad - chev, y + (c.chip_h - chev) / 2, chev, ink); }
  if room > 0 { _ := sheet_text(sh, f[0].m, -1, tx, y + (c.chip_h - k.small.line) / 2, k.small.line, k.small.face, ink, app_fit(f, k.small.face, text, room + 0.5f32)); }
  if !off { sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, c.chip_h); }
  return w;
}
cp_foot_chip_width :: (f: [] UiFrame, icon: int, text: string, chevron: bool) -> f32 {
  k := f[0].skin; c := k.cmp;
  w := 2 * c.chip_pad + ceil(measure_width(f[0].m, k.small.face, text));
  if icon >= 0 { w += cp_foot_chip_icon_size(c, icon) + cp_foot_chip_icon_gap(c, icon); }
  if chevron { w += cast(f32) CP_CHEVRON + c.chip_gap; }
  return w;
}
CP_FOOT_CHECKBOX_BOX :: 13.0f32;
CP_FOOT_CHECKBOX_GAP :: 6.0f32;
CP_FOOT_CHECKBOX_MARK :: 9.0f32;
cp_foot_checkbox_width :: (f: [] UiFrame, text: string) -> f32 {
  k := f[0].skin; c := k.cmp;
  return 2 * c.chip_pad + CP_FOOT_CHECKBOX_BOX + CP_FOOT_CHECKBOX_GAP + ceil(measure_width(f[0].m, k.small.face, text));
}
cp_foot_checkbox :: (f: [] UiFrame, id: string, label: string, x: f32, y: f32, w: f32, text: string, checked: bool, action: int) -> f32 {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme(); c := k.cmp;
  st := EL_S_CHECKS | (ifx checked then EL_S_CHECKED else 0);
  row := uiframe_semantic(f, id, EL_TOGGLE, label, x, y, w, c.chip_h, st, action);
  elt_value(f[0].rows, row, ifx checked then "on" else "off");
  hov := uiframe_hovered(f, id); prs := uiframe_pressed(f, id);
  if prs || hov { sheet_fill(sh, x, y, w, c.chip_h, c.chip_radius, ifx prs then th.pressed else th.hover); }
  bx := x + c.chip_pad;
  by := y + (c.chip_h - CP_FOOT_CHECKBOX_BOX) / 2;
  if checked {
    sheet_fill(sh, bx, by, CP_FOOT_CHECKBOX_BOX, CP_FOOT_CHECKBOX_BOX, 3.5f32, th.primary);
    mk := CP_FOOT_CHECKBOX_MARK;
    sheet_icon(sh, ICON_CHECK, bx + (CP_FOOT_CHECKBOX_BOX - mk) / 2, by + (CP_FOOT_CHECKBOX_BOX - mk) / 2, mk, th.bg);
  } else {
    edge := ifx hov || prs then th.text else th.muted;
    _ := sheet_box(sh, bx, by, CP_FOOT_CHECKBOX_BOX, CP_FOOT_CHECKBOX_BOX, 3.5f32, 1.0f32, Rgba.{}, edge);
  }
  ink := ifx checked || hov || prs then th.text else th.muted;
  tx := bx + CP_FOOT_CHECKBOX_BOX + CP_FOOT_CHECKBOX_GAP;
  room := w - 2 * c.chip_pad - CP_FOOT_CHECKBOX_BOX - CP_FOOT_CHECKBOX_GAP;
  if room > 0 { _ := sheet_text(sh, f[0].m, -1, tx, y + (c.chip_h - k.small.line) / 2, k.small.line, k.small.face, ink, app_fit(f, k.small.face, text, room + 0.5f32)); }
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, c.chip_h);
  return w;
}
// The composer's foot at y: on the left the model (and while a reply runs, Steer and Queue for a
// draft); on the right the chat's goal, its cost (once a chat has a turn, or in Foreman), how full
// the context is, and the working folder › its branch. Which harness or backend runs a model shows
// inside the model dropdown (cp_model_desc), not permanently in the foot. Too narrow, it folds the
// goal, then the cost, the context and the branch. Returns the model chip's x, for its menu.
cp_composer_foot :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, cw: f32, running: bool, exceeded: bool) -> f32 {
  k := f[0].skin; a := k.app; c := k.cmp;
  side := cast(f32) CP_FOOT_SIDE; gap := a.gap_small;
  // what each part says
  fb: [CP_FOLDER_TEXT + CP_BRANCH_TEXT + 8] u8;
  fn := el_put(fb[..], 0, cast(string) s[0].folder[0..<s[0].folder_n]);
  short_n := fn;
  if s[0].branch_n > 0 { fn = el_put(fb[..], fn, " › "); fn = el_put(fb[..], fn, cast(string) s[0].branch[0..<s[0].branch_n]); }
  m_label := cp_model_label(s, cp_model_index(s));
  e_label := cp_effort_label(s, cp_model_index(s));   // the chat's thinking level, beside the model
  cb: [32] u8; bb: [32] u8; lb: [64] u8;
  ln := el_put(lb[..], 0, ifx s[0].cost_usd_micros > 0 then cp_cost(cb[..], s[0].cost_usd_micros) else "$0.00");
  ln = el_put(lb[..], ln, " / "); ln = el_put(lb[..], ln, cp_cost(bb[..], cp_budget(s)));
  home := s[0].nturns == 0 && cast(string) s[0].current[0..<s[0].current_n] != "chat.foreman";
  cost := sheet_pool(f[0].sheet, cast(string) lb[0..<ln]);
  has_goal := s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0;
  glb: [64] u8; gtb: [32] u8; gln := 0;
  if has_goal {
    gln = el_put(glb[..], 0, "Goal · "); gln = el_put(glb[..], gln, cp_goal_status_label(s[0].goal_status));
    if s[0].goal_time_seconds > 0 { gln = el_put(glb[..], gln, " · "); gln = el_put(glb[..], gln, cp_goal_elapsed(gtb[..], s[0].goal_time_seconds)); }
  }
  goal := sheet_pool(f[0].sheet, cast(string) glb[0..<gln]);
  // their widths, and what folds
  show_fu_draft := running && eb_text(s[0].draft[..]).count > 0 && s[0].fu[0].editing == 0;
  show_folder := s[0].folder_n > 0 && !show_fu_draft;
  w_folder := ifx show_folder then cp_foot_chip_width(f, ICON_FOLDER_11, cast(string) fb[0..<fn], false) else 0.0f32;
  w_short := ifx show_folder then cp_foot_chip_width(f, ICON_FOLDER_11, cast(string) fb[0..<short_n], false) else 0.0f32;
  cap := cast(f32) CP_FOLDER_MOST;
  if w_folder > cap { w_folder = cap; } if w_short > cap { w_short = cap; }
  w_fu := ifx show_fu_draft then app_chip_width(f, -1, "Steer", 0) + gap + app_chip_width(f, -1, "Queue", 0) else 0.0f32;
  has_picker := cp_has_model_picker(s);
  show_model := cp_models(s) > 0;
  w_model := ifx show_model then cp_foot_chip_width(f, -1, m_label, true) else 0.0f32;
  w_effort := cp_foot_chip_width(f, -1, e_label, true);
  w_ring := c.chip_h;
  w_usage := c.chip_h;
  w_cost := cp_foot_chip_width(f, -1, cost, false);
  w_goal := ifx has_goal then cp_foot_chip_width(f, -1, goal, false) else 0.0f32;
  show_goal := has_goal;
  show_cost := !home;
  show_ring := s[0].ctx_in > 0;
  show_usage := cp_flag(s, DC_FLAG_USAGE);
  show_branch := cp_flag(s, DC_FLAG_GIT) && show_folder && s[0].branch_n > 0 && !running;
  room := cw - 2 * side;
  for step: 0..<6 {
    need := 0.0f32;
    if show_fu_draft { need += w_fu; }
    if show_folder { need += gap + (ifx show_branch then w_folder else w_short); }
    if show_usage { need += gap + w_usage; }
    if show_ring { need += gap + w_ring; } if show_cost { need += gap + w_cost; } if show_goal { need += gap + w_goal; }
    if need <= room { break; }
    if show_usage { show_usage = false; } else if show_goal { show_goal = false; } else if show_cost { show_cost = false; } else if show_ring { show_ring = false; } else { show_branch = false; }
  }
  // the left side: Steer & Queue (while a reply runs with a draft), Fresh & Fan-out when enabled.
  // Model and Effort live inside the composer card's bottom bar; New worktree lives in the header bar.
  fx := x + side;
  end_x := x + cw - side;
  if show_fu_draft {
    sw := app_chip_width(f, -1, "Steer", 0); qw := app_chip_width(f, -1, "Queue", 0);
    if fx + sw + qw + gap <= end_x {
      _ := app_chip(f, "coder.fu.steer", fx, y, 0, -1, "Steer the reply with the draft (Return)", "Steer", EL_S_CURRENT, CP_FU_DRAFT);
      _ := app_chip(f, "coder.fu.queue", fx + sw + gap, y, 0, -1, "Queue the draft for after the reply (⇧Return)", "Queue", 0, CP_FU_DRAFT);
      fx += sw + qw + 2 * gap;
    }
  }
  m_x := s[0].model_x;
  _ = m_label; _ = e_label; _ = show_model; _ = w_model; _ = w_effort;
  // the right side, from the end: working folder at the far right, then context ring, cost, and goal;
  // when space is tight, the working folder shrinks before the left chips ever truncate
  rx := end_x;
  other_right: f32 = 0;
  if show_usage { other_right += w_usage + gap; }
  if show_ring { other_right += w_ring + gap; }
  if show_cost { other_right += w_cost + gap; }
  if show_goal { other_right += w_goal + gap; }
  fw := ifx show_branch then w_folder else w_short;
  right_total := other_right + (ifx show_folder then fw + gap else 0.0f32);
  // Inline Permission Mode chip below composer (Ask | Auto-edit | Full Auto, #14144)
  if !running && !show_fu_draft {
    pm_lbl := ifx s[0].perm_mode == CP_PERM_FULL_AUTO then "Full Auto" else ifx s[0].perm_mode == CP_PERM_AUTO_EDIT then "Auto-edit" else "Ask";
    w_pm := cp_foot_chip_width(f, -1, pm_lbl, false);
    if fx + w_pm + right_total <= end_x {
      if fx > x + side { fx += gap; }
      fx += cp_foot_chip(f, "coder.perm.mode", "Permission mode (Ask / Auto-edit / Full Auto)", fx, y, w_pm, -1, pm_lbl, false, ifx s[0].perm_mode != CP_PERM_ASK then EL_S_CURRENT else 0, CP_PERM_CYCLE);
    }
  }
  // Fresh Session toggle & Multi-model fan-out chips: gated by models.external
  if cp_flag(s, DC_FLAG_MODELS_EXTERNAL) && !running && (s[0].nturns > 0 || s[0].prov[0].fresh_session) {
    fresh_lbl := ifx s[0].prov[0].fresh_session then "Fresh ✓" else "Fresh";
    w_fresh := cp_foot_chip_width(f, -1, fresh_lbl, false);
    if fx + gap + w_fresh + right_total <= end_x {
      fx += gap;
      fx += cp_foot_chip(f, "coder.fresh", "Fresh Session (skip prior history on next send)", fx, y, w_fresh, -1, fresh_lbl, false, ifx s[0].prov[0].fresh_session then EL_S_CURRENT else 0, CP_FRESH_TOGGLE);
    }
  }
  if cp_flag(s, DC_FLAG_MODELS_EXTERNAL) && has_picker && !running && (cp_models(s) >= 2 || cp_fanout_ready(s)) {
    fob: [24] u8; fon := 0;
    if cp_fanout_ready(s) {
      fon = el_put(fob[..], 0, "Fan-out (");
      fon = el_put_i(fob[..], fon, cp_fanout_count(s));
      fon = el_put(fob[..], fon, ")");
    } else {
      fon = el_put(fob[..], 0, "Fan-out");
    }
    fo_lbl := sheet_pool(f[0].sheet, cast(string) fob[0..<fon]);
    w_fo := cp_foot_chip_width(f, -1, fo_lbl, false);
    if fx + gap + w_fo + right_total <= end_x {
      fx += gap;
      fx += cp_foot_chip(f, "coder.fanout", "Multi-model fan-out (send to 2–4 models in parallel)", fx, y, w_fo, -1, fo_lbl, false, ifx cp_fanout_ready(s) then EL_S_CURRENT else 0, CP_FANOUT_OPEN);
    }
  }
  max_fw := rx - fx - (ifx fx > x + side then gap else 0.0f32) - other_right;
  if fw > max_fw { fw = max_fw; }
  if show_folder && fw > 2 * c.chip_pad {
    rx -= fw;
    shown := sheet_pool(f[0].sheet, cast(string) fb[0..<(ifx show_branch then fn else short_n)]);
    _ := cp_foot_chip(f, "coder.folder", "Working folder", rx, y, fw, ICON_FOLDER_11, shown, false, 0, CP_FOLDER);
    rx -= gap;
  }
  if show_usage && rx - w_usage >= fx { rx -= w_usage; cp_usage_ring(s, f, rx, y); rx -= gap; }
  if show_ring && rx - w_ring >= fx { rx -= w_ring; cp_context_ring(s, f, rx, y, x, cw); rx -= gap; }
  if show_cost && rx - w_cost >= fx { rx -= w_cost; _ := cp_foot_chip(f, "coder.cost", "Chat budget", rx, y, w_cost, -1, cost, false, ifx exceeded then EL_S_CURRENT else 0, CP_BUDGET_EDIT); rx -= gap; }
  if show_goal && rx - w_goal >= fx { rx -= w_goal; _ := cp_foot_chip(f, "coder.goal", "Thread goal", rx, y, w_goal, -1, goal, false, ifx s[0].goal_status == CP_GOAL_ACTIVE then EL_S_CURRENT else 0, CP_GOAL_OPEN); rx -= gap; }
  return m_x;
}
// How full the context is, a ring at (x, y) in the foot; hovered, a card over it with the last
// model call's tokens: its input of the model's window, then input, cached and output.
cp_context_ring :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, col_x: f32, cw: f32) {
  k := f[0].skin; c := k.cmp; sh := f[0].sheet; th := cp_theme();
  side := c.chip_h; ring := c.chip_icon;
  share := cp_ctx_share(s);
  ub: [24] u8; wb: [24] u8; l1: [96] u8;
  n1 := el_put(l1[..], 0, cp_tokens(ub[..], s[0].ctx_in + s[0].ctx_out));
  if s[0].ctx_window > 0 {
    n1 = el_put(l1[..], n1, " of "); n1 = el_put(l1[..], n1, cp_tokens(wb[..], s[0].ctx_window)); n1 = el_put(l1[..], n1, " tokens · ");
    pct := cast(int) (share * 100 + 0.5);   // not a size
    if pct == 0 && share > 0 { n1 = el_put(l1[..], n1, "<1"); } else { n1 = el_put_i(l1[..], n1, pct); }
    n1 = el_put(l1[..], n1, "%");
  } else { n1 = el_put(l1[..], n1, " tokens"); }
  line1 := sheet_pool(sh, cast(string) l1[0..<n1]);
  row := uiframe_semantic(f, "coder.context", EL_PROGRESS, "Context used", x, y, side, side, 0, 0);
  elt_value_share(f[0].rows, row, share);
  hov := uiframe_hovered(f, "coder.context");
  if hov { sheet_fill(sh, x, y, side, side, c.chip_radius, th.hover); }
  progress_ring(sh, k, x + (side - ring) / 2, y + (side - ring) / 2, ring, share);
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, side, side);
  if !hov { return; }
  ib: [24] u8; cb: [24] u8; ob: [24] u8; l2: [128] u8;
  n2 := el_put(l2[..], 0, "Input "); n2 = el_put(l2[..], n2, cp_tokens(ib[..], s[0].ctx_in));
  n2 = el_put(l2[..], n2, " · Cached "); n2 = el_put(l2[..], n2, cp_tokens(cb[..], s[0].ctx_cached));
  n2 = el_put(l2[..], n2, " · Output "); n2 = el_put(l2[..], n2, cp_tokens(ob[..], s[0].ctx_out));
  line2 := sheet_pool(sh, cast(string) l2[0..<n2]);
  pad := cast(f32) CP_CARD_PAD;
  w1 := measure_width(f[0].m, k.label.face, line1); w2 := measure_width(f[0].m, k.small.face, line2);
  pw := (ifx w1 > w2 then w1 else w2) + 2 * pad; if pw > cw { pw = cw; }
  ph := 2 * pad + k.label.line + k.small.line;
  px := x + side - pw; if px < col_x { px = col_x; }
  py := y - ph - k.app.gap_small;
  r := c.chip_radius;
  sheet_over_n(sh, uiskin_shadow(sh[0].over, sh[0].no, px, py, pw, ph, r, k.shadows.menu));
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, r, 1.0f32, th.menu, th.line));
  card := uiframe_semantic(f, "coder.context.card", EL_REGION, line1, px, py, pw, ph, 0, 0);
  elt_value(f[0].rows, card, line2);
  _ := sheet_text(sh, f[0].m, -1, px + pad, py + pad, k.label.line, k.label.face, th.text, app_fit(f, k.label.face, line1, pw - 2 * pad));
  _ := sheet_text(sh, f[0].m, -1, px + pad, py + pad + k.label.line, k.small.line, k.small.face, th.muted, app_fit(f, k.small.face, line2, pw - 2 * pad));
}
// The models' menu, anchored to the model chip at (m_x, foot_y): below the chip when there is room
// (as on a centred new chat, matching Zeron's ModelPicker), else above the composer at box_y.
cp_model_menu :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, m_x: f32, box_y: f32, foot_y: f32, h: f32) {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme();
  z_ink := th.text; z_sec := th.muted; z_hov := th.hover;
  glass := cp_glass(s);   // the models' menu frosted: a blur of what is behind it (compose.coax)
  pw := 316.0f32;
  if pw > cw { pw = cw; }
  compact := s[0].show_other_models;
  pad := 5.0f32;
  nm := cp_models(s);
  rh := ifx !compact then (ifx nm > 5 then 31.0f32 else ifx nm > 3 then 34.0f32 else 42.0f32) else ifx nm > 8 then 30.0f32 else 32.0f32;
  div_h := 5.0f32;
  frh := 24.0f32;
  lrh := ifx compact || nm > 5 then 26.0f32 else 32.0f32;
  prh := 24.0f32;
  orh := ifx compact || nm > 5 then 24.0f32 else 30.0f32;
  show_flawed_row := true;
  show_local_row := true;
  show_others_row := s[0].show_other_models;
  show_prov_row := s[0].show_other_models && cp_flag(s, DC_FLAG_MODELS_EXTERNAL);
  footer_h := div_h
            + (ifx show_flawed_row then frh else 0.0f32)
            + (ifx show_local_row then lrh else 0.0f32)
            + (ifx show_prov_row then prh else 0.0f32)
            + (ifx show_others_row then orh else 0.0f32);
  ph := pad * 2 + cast(f32) nm * rh + footer_h;
  px := m_x;
  if px + pw > x + cw { px = x + cw - pw; }
  if px < x { px = x; }
  below_y := foot_y;
  py := ifx below_y + ph <= h - 8.0f32 then below_y else box_y - ph - 6.0f32;
  if py < 8.0f32 { py = 8.0f32; }
  menu_r := 12.0f32;
  // zeron.menu: its shadow (the skin's, 0 20 56), then, frosted, its solid over a blur of what is
  // behind it, at 80% (Zeron's tint sits over macOS's popover frost, which this window has no layer of)
  sheet_over_n(sh, uiskin_shadow(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, k.shadows.menu));
  if glass {
    sheet_over_n(sh, prim_clip(sh[0].over, sh[0].no, px, py, px + pw, py + ph));
    sheet_over_n(sh, prim_backdrop(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, cp_glass_blur(s)));
  }
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, 1.0f32, ifx glass then opacity(th.menu, 0.8) else th.menu, th.line));
  card_row := uiframe_semantic(f, "coder.model.menu", EL_REGION, "Models", px, py, pw, ph, 0, 0);
  sheet_hit(sh, UIFRAME_HIT, card_row, 0, px, py, pw, ph);
  sub_face := ifx compact then k.menu_small.face else k.small.face;
  sub_line := ifx compact then k.menu_small.line else k.small.line;
  mb: [32] u8;
  for mi: 0..<cp_models(s) {
    ry := py + pad + cast(f32) mi * rh;
    mn := el_put(mb[..], 0, "coder.model."); mn = el_put_i(mb[..], mn, mi);
    mid := sheet_pool(sh, cast(string) mb[0..<mn]);
    sel := mi == cp_model_index(s);
    hov := uiframe_hover(f, KEYED_LAZY, mid);   // the wash eases in and out (kit/frame.coax)
    label := sheet_pool(sh, cp_model_label(s, mi));
    desc := sheet_pool(sh, cp_model_desc(s, mi));
    mrow := uiframe_semantic(f, mid, EL_BUTTON, label, px + pad, ry, pw - 2 * pad, rh, ifx sel then EL_S_CURRENT else 0, CP_MODEL_PICK);
    elt_value(f[0].rows, mrow, desc);
    if hov > 0 || sel {
      fill := ifx sel then rgba_mix(th.menu_selected, z_hov, hov) else opacity(z_hov, hov);
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, ry + 1.0f32, pw - 2 * pad, rh - 2.0f32, k.cmp.chip_radius, 0, fill, Rgba.{}));
    }
    tx := px + pad + 10.0f32;
    tw := pw - 2 * pad - 34.0f32;
    ty1 := ifx !compact then (ifx nm > 3 then 2.0f32 else 4.0f32) else ifx nm > 8 then 1.0f32 else 2.0f32;
    ty2 := ifx !compact then (ifx nm > 3 then 18.0f32 else 22.0f32) else ifx nm > 8 then 17.0f32 else 18.0f32;
    _ := sheet_text(sh, f[0].m, -1, tx, ry + ty1, k.label.line, k.label.face, z_ink, app_fit(f, k.label.face, label, tw));
    _ := sheet_text(sh, f[0].m, -1, tx, ry + ty2, sub_line, sub_face, z_sec, app_fit(f, sub_face, desc, tw));
    if sel {
      ck := 14.0f32;
      sheet_over_n(sh, prim_icon(sh[0].over, sh[0].no, ICON_CHECK, px + pw - pad - 10.0f32 - ck, ry + (rh - ck) / 2, ck, ck, z_ink));
    }
    sheet_hit(sh, UIFRAME_HIT, mrow, 0, px + pad, ry, pw - 2 * pad, rh);
  }
  fy := py + pad + cast(f32) nm * rh;
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad + 6.0f32, fy + (div_h - 1.0f32) / 2.0f32, pw - 2 * pad - 12.0f32, 1.0f32, 0, 0, th.line, Rgba.{}));
  fy += div_h;
  // Flawed Settings shortcut row: opens Settings -> Flawed directly.
  if show_flawed_row {
    fhov := uiframe_hover(f, KEYED_LAZY, "coder.model.flawed");
    flabel := "Agent Settings…";
    fdesc := "Configure model, thinking, permissions & sandbox";
    frow := uiframe_semantic(f, "coder.model.flawed", EL_BUTTON, flabel, px + pad, fy, pw - 2 * pad, frh, 0, CP_MODEL_FLAWED);
    elt_value(f[0].rows, frow, fdesc);
    if fhov > 0 {
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, fy + 1.0f32, pw - 2 * pad, frh - 2.0f32, k.cmp.chip_radius, 0, opacity(z_hov, fhov), Rgba.{}));
    }
    ftx := px + pad + 10.0f32;
    ftw := pw - 2 * pad - 20.0f32;
    _ := sheet_text(sh, f[0].m, -1, ftx, fy + (frh - k.label.line) / 2.0f32, k.label.line, k.label.face, z_sec, app_fit(f, k.label.face, flabel, ftw));
    sheet_hit(sh, UIFRAME_HIT, frow, 0, px + pad, fy, pw - 2 * pad, frh);
    fy += frh;
  }
  // Local Models action row (#13826, #14028): always reachable to switch Inkling variants, verify SHA-256, or manage storage.
  if show_local_row {
    lry := fy;
    lhov := uiframe_hover(f, KEYED_LAZY, "coder.model.local");
    llabel := "Manage Local Models…";
    ldesc := ifx s[0].set_local_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_local_status[0..<s[0].set_local_status_n]) else ifx s[0].inkling then "Installed · Switch variants & manage storage" else "Switch variants, download or import .gguf";
    lrow := uiframe_semantic(f, "coder.model.local", EL_BUTTON, llabel, px + pad, lry, pw - 2 * pad, lrh, 0, CP_MODEL_LOCAL);
    elt_value(f[0].rows, lrow, ldesc);
    if lhov > 0 {
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, lry + 1.0f32, pw - 2 * pad, lrh - 2.0f32, k.cmp.chip_radius, 0, opacity(z_hov, lhov), Rgba.{}));
    }
    ltx := px + pad + 10.0f32;
    ltw := pw - 2 * pad - 20.0f32;
    lty1 := ifx compact then 1.0f32 else 2.0f32;
    lty2 := ifx compact then 17.0f32 else 19.0f32;
    _ := sheet_text(sh, f[0].m, -1, ltx, lry + lty1, k.label.line, k.label.face, z_sec, app_fit(f, k.label.face, llabel, ltw));
    _ := sheet_text(sh, f[0].m, -1, ltx, lry + lty2, sub_line, sub_face, z_sec, app_fit(f, sub_face, ldesc, ltw));
    sheet_hit(sh, UIFRAME_HIT, lrow, 0, px + pad, lry, pw - 2 * pad, lrh);
    fy += lrh;
  }
  // Providers action row: shown only after the user opts into seeing other models.
  if show_prov_row {
    phov := uiframe_hover(f, KEYED_LAZY, "coder.model.providers");
    plabel := ifx s[0].agy_models_n > 0 then "Manage Providers…" else "Connect Antigravity…";
    pdesc := ifx s[0].agy_models_n > 0 then "Configure Antigravity & models" else "Sign in in Settings → Providers to load models";
    prow := uiframe_semantic(f, "coder.model.providers", EL_BUTTON, plabel, px + pad, fy, pw - 2 * pad, prh, 0, CP_MODEL_PROVIDERS);
    elt_value(f[0].rows, prow, pdesc);
    if phov > 0 {
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, fy + 1.0f32, pw - 2 * pad, prh - 2.0f32, k.cmp.chip_radius, 0, opacity(z_hov, phov), Rgba.{}));
    }
    ptx := px + pad + 10.0f32;
    ptw := pw - 2 * pad - 20.0f32;
    _ := sheet_text(sh, f[0].m, -1, ptx, fy + (prh - k.label.line) / 2.0f32, k.label.line, k.label.face, ifx s[0].agy_models_n > 0 then z_sec else z_ink, app_fit(f, k.label.face, plabel, ptw));
    sheet_hit(sh, UIFRAME_HIT, prow, 0, px + pad, fy, pw - 2 * pad, prh);
    fy += prh;
  }
  // Explicit user opt-in toggle to show/hide non-Inkling models.
  if show_others_row {
    ohov := uiframe_hover(f, KEYED_LAZY, "coder.model.others");
    olabel := ifx s[0].show_other_models then "Hide other models" else "Show other models…";
    odesc := ifx s[0].show_other_models then "Show only OpenAgents & local Inkling" else "Antigravity, cloud & external CLI models";
    orow := uiframe_semantic(f, "coder.model.others", EL_BUTTON, olabel, px + pad, fy, pw - 2 * pad, orh, 0, CP_MODEL_TOGGLE_OTHERS);
    elt_value(f[0].rows, orow, odesc);
    if ohov > 0 {
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, fy + 1.0f32, pw - 2 * pad, orh - 2.0f32, k.cmp.chip_radius, 0, opacity(z_hov, ohov), Rgba.{}));
    }
    otx := px + pad + 10.0f32;
    otw := pw - 2 * pad - 20.0f32;
    if compact {
      _ := sheet_text(sh, f[0].m, -1, otx, fy + (orh - k.label.line) / 2.0f32, k.label.line, k.label.face, z_sec, app_fit(f, k.label.face, olabel, otw));
    } else {
      _ := sheet_text(sh, f[0].m, -1, otx, fy + 2.0f32, k.label.line, k.label.face, z_sec, app_fit(f, k.label.face, olabel, otw));
      _ := sheet_text(sh, f[0].m, -1, otx, fy + 19.0f32, sub_line, sub_face, z_sec, app_fit(f, sub_face, odesc, otw));
    }
    sheet_hit(sh, UIFRAME_HIT, orow, 0, px + pad, fy, pw - 2 * pad, orh);
    fy += orh;
  }
  if glass { sheet_over_n(sh, prim_unlayer(sh[0].over, sh[0].no)); sheet_over_n(sh, prim_unclip(sh[0].over, sh[0].no)); }
}
// The thinking-level menu, anchored to the effort chip at (e_x, foot_y): shows Low, Medium, High
// (and X-High, Max on Claude models), styled to match cp_model_menu.
cp_effort_menu :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, e_x: f32, box_y: f32, foot_y: f32, h: f32) {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme();
  z_ink := th.text; z_sec := th.muted; z_hov := th.hover;
  glass := cp_glass(s);
  idx := cp_model_index(s);
  count := cp_effort_count(s, idx);
  cur := cp_effort_at(s, idx);
  pw := 216.0f32;
  if pw > cw { pw = cw; }
  pad := 6.0f32;
  rh := 40.0f32;
  ph := pad * 2 + cast(f32) count * rh;
  px := e_x;
  if px + pw > x + cw { px = x + cw - pw; }
  if px < x { px = x; }
  below_y := foot_y;
  py := ifx below_y + ph <= h - 8.0f32 then below_y else box_y - ph - 6.0f32;
  if py < 8.0f32 { py = 8.0f32; }
  menu_r := 12.0f32;
  sheet_over_n(sh, uiskin_shadow(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, k.shadows.menu));
  if glass {
    sheet_over_n(sh, prim_clip(sh[0].over, sh[0].no, px, py, px + pw, py + ph));
    sheet_over_n(sh, prim_backdrop(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, cp_glass_blur(s)));
  }
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, 1.0f32, ifx glass then opacity(th.menu, 0.8) else th.menu, th.line));
  card_row := uiframe_semantic(f, "coder.effort.menu", EL_REGION, "Thinking level", px, py, pw, ph, 0, 0);
  sheet_hit(sh, UIFRAME_HIT, card_row, 0, px, py, pw, ph);
  labels := CP_EFFORT_LABEL;
  eb: [32] u8;
  for ei: 0..<count {
    lvl := CP_EFFORT_LOW + ei;
    ry := py + pad + cast(f32) ei * rh;
    en := el_put(eb[..], 0, "coder.effort."); en = el_put_i(eb[..], en, lvl);
    eid := sheet_pool(sh, cast(string) eb[0..<en]);
    sel := lvl == cur;
    hov := uiframe_hover(f, KEYED_LAZY, eid);
    label := labels[lvl];
    desc := cp_effort_desc(lvl);
    erow := uiframe_semantic(f, eid, EL_BUTTON, label, px + pad, ry, pw - 2 * pad, rh, ifx sel then EL_S_CURRENT else 0, CP_EFFORT_PICK);
    elt_value(f[0].rows, erow, desc);
    if hov > 0 || sel {
      fill := ifx sel then rgba_mix(th.menu_selected, z_hov, hov) else opacity(z_hov, hov);
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, ry + 1.0f32, pw - 2 * pad, rh - 2.0f32, k.cmp.chip_radius, 0, fill, Rgba.{}));
    }
    tx := px + pad + 10.0f32;
    tw := pw - 2 * pad - 34.0f32;
    _ := sheet_text(sh, f[0].m, -1, tx, ry + 3.0f32, k.label.line, k.label.face, z_ink, app_fit(f, k.label.face, label, tw));
    _ := sheet_text(sh, f[0].m, -1, tx, ry + 21.0f32, k.small.line, k.small.face, z_sec, app_fit(f, k.small.face, desc, tw));
    if sel {
      ck := 14.0f32;
      sheet_over_n(sh, prim_icon(sh[0].over, sh[0].no, ICON_CHECK, px + pw - pad - 10.0f32 - ck, ry + (rh - ck) / 2, ck, ck, z_ink));
    }
    sheet_hit(sh, UIFRAME_HIT, erow, 0, px + pad, ry, pw - 2 * pad, rh);
  }
  if glass { sheet_over_n(sh, prim_unlayer(sh[0].over, sh[0].no)); sheet_over_n(sh, prim_unclip(sh[0].over, sh[0].no)); }
}
