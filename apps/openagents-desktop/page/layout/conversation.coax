// Coder Desktop page (../../page.coax): the conversation: a message's activity group, the
// messages and replies, the notices, the corner buttons and the composer.

// Row q of a message as its activity group shows it (#13731): a thought's words, a file read by
// its name, or a command on one line that opens onto the whole of it and what came back.
cp_act_row :: (s: [] CoderPage, f: [] UiFrame, q: int, w: f32) -> AppActRow {
  sh := f[0].sheet;
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; output := cp_call_text(s, q);
  if s[0].calls[q].thought || s[0].calls[q].said {
    r := AppActRow.{kind = APP_ACT_THOUGHT, verb = "Thought process", output = output};
    // its words read as a reply does: its Markdown, parsed into this frame's document
    at := s[0].think_at; b0 := s[0].think[at].nb;
    r.blocks = md_parse(s[0].think[at..<at + 1], output, 0);
    if r.blocks > 0 { r.doc = s[0].think[at..<at + 1]; r.block0 = b0; }
    else {
      // the document is full: its words as they are, wrapped to the row
      wb := s[0].scratch[..];
      per := cast(int) ((w - f[0].skin.act.gutter) / measure_width(f[0].m, f[0].skin.body.face, "0")) - 1; if per < 8 { per = 8; }
      wn := cp_wrap(wb, output, per);
      r.output = sheet_pool(sh, cast(string) wb[0..<wn]);
    }
    return r;
  }
  if s[0].calls[q].read {
    // a file by its name; the row opens onto its whole path and what was read
    base := 0;
    for c, ci: text { if c == '/' && ci + 1 < text.count { base = ci + 1; } }
    return AppActRow.{kind = APP_ACT_READ, verb = "Read", target = sheet_pool(sh, cast(string) text[base..<text.count]),
                      call = ifx base > 0 then text else "", output = output, failed = s[0].calls[q].failed,
                      timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q), path = ifx s[0].calls[q].failed then "" else text};
  }
  if cp_edit_at(text) > 0 { return cp_act_edit(s, f, q); }
  // an oasim command says what it did to the simulator (spec 7.5): "Tapped (201, 640)"
  stb: [256] u8; sim := cp_sim_cmd(text, stb[..]);
  if sim.verb.count > 0 {
    return AppActRow.{kind = APP_ACT_EXEC, verb = sim.verb, target = sheet_single_line(sh, sim.target), call = text, output = output,
                      failed = s[0].calls[q].failed, running = s[0].calls[q].running, timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q)};
  }
  return AppActRow.{kind = APP_ACT_EXEC, verb = "Ran", target = sheet_single_line(sh, text), call = text, output = output,
                    failed = s[0].calls[q].failed, running = s[0].calls[q].running, timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q)};
}
// What a press on row q does: an oasim command that went brings the simulator pane to the front
// (spec 7.5, GitHub #13811); any other row does what its group's rows do.
cp_row_act :: (s: [] CoderPage, q: int, row: int) -> int {
  if s[0].calls[q].thought || s[0].calls[q].said || s[0].calls[q].read || s[0].calls[q].failed || s[0].calls[q].running { return row; }
  tb: [256] u8;
  return ifx cp_sim_cmd(cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n], tb[..]).verb.count > 0 then CP_SIM_ROW else row;
}
// An edit's row (#13696): "Edited" or "Wrote" and the file's name, a link to the file; its lines
// added and removed at its end, and it opens onto its diff.
cp_act_edit :: (s: [] CoderPage, f: [] UiFrame, q: int) -> AppActRow {
  text := cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]; at := cp_edit_at(text);
  path := cast(string) text[at..<text.count]; write := at == 6;
  running := s[0].calls[q].running; failed := s[0].calls[q].failed;
  verb := ifx failed then (ifx write then "Could not write" else "Could not edit")
          else ifx running then (ifx write then "Writing" else "Editing") else ifx write then "Wrote" else "Edited";
  // a diff is the row's change, drawn as hunks; anything else (why it failed) is its output
  diff := cp_edit_diff(s, q) > 0; out := cp_call_text(s, q);
  return AppActRow.{kind = ifx write then APP_ACT_WRITE else APP_ACT_EDIT, verb = verb, target = sheet_pool(f[0].sheet, app_diff_base(path)),
                    output = ifx diff then "" else out, diff = ifx diff then out else "", failed = failed, running = running,
                    timed = cp_call_timed(s, q), secs = cast(int) cp_call_took(s, q), path = ifx failed then "" else path};
}
// Whether row q says how long it took: while it runs, and once done when it took a second or more.
cp_call_timed :: (s: [] CoderPage, q: int) -> bool { return s[0].calls[q].running || s[0].calls[q].took >= 1; }
// How long row q took, or has run so far, in seconds; 0 when it was not timed.
cp_call_took :: (s: [] CoderPage, q: int) -> f32 {
  if s[0].calls[q].running { return s[0].clock - s[0].calls[q].began; }
  return ifx s[0].calls[q].took > 0 then s[0].calls[q].took else 0.0f32;
}
// Sub-agent j of turn i as a row of its message's group: "Ran a subagent", its model and its
// task's first line; a press opens its transcript beside the conversation.
cp_act_agent :: (s: [] CoderPage, f: [] UiFrame, i: int, j: int) -> AppActRow {
  g := s[0].turns[i].agents[j];
  task := sheet_single_line(f[0].sheet, cast(string) g.task[0..<g.task_n]);
  tb: [CP_AGENT_TASK + 32] u8; n := el_put(tb[..], 0, CP_LEVEL_NAME[g.level]);
  if task.count > 0 { n = el_put(tb[..], n, " · "); n = el_put(tb[..], n, task); }
  waiting_permit := g.state == CP_RUNNING && cp_permit_agent_waiting(s, j);
  verb := ifx waiting_permit then "Waiting for approval" else "Ran a subagent";
  return AppActRow.{kind = APP_ACT_AGENT, verb = verb, target = sheet_pool(f[0].sheet, cast(string) tb[0..<n]),
                    failed = g.state == CP_FAILED, running = g.state == CP_RUNNING && !g.paused, opens = true};
}
// "t7" + ".x" + 12: a part of an activity group, under the group's name ("t7" a message's, "p3.1"
// a sub-agent's) and, when k is not negative, its number.
cp_named :: (out: [] u8, name: string, part: string, k: int) -> string {
  n := el_put(out, 0, name); n = el_put(out, n, part);
  if k >= 0 { n = el_put_i(out, n, k); }
  return cast(string) out[0..<n];
}
// Turn i's activity group at (x, y), cw wide (#13731): the summary, counted in Zeron's words, and
// once the message is done "Worked for 42s · " before it (#13745); open while the message works or
// when the person opened it, its thoughts, commands, reads and sub-agents in the order they came, a
// tree down their left. Rows out of view between top and bottom keep their place and are not
// drawn. Returns its height, 0 when it did nothing.
cp_group :: (s: [] CoderPage, f: [] UiFrame, i: int, x: f32, y0: f32, cw: f32, top: f32, bottom: f32) -> f32 {
  nb: [EL_ID] u8; name := cp_named(nb[..], "t", "", i);
  live := s[0].turns[i].state == CP_RUNNING;
  worked := ifx live || s[0].turns[i].took < 0 then -1 else cp_whole(s[0].turns[i].took);
  done := [1] int.[0];
  h := cp_act_group(s, f, name, s[0].turns[i].head, s[0].turns[i].ncmds, s[0].turns[i].early_cmds, s[0].turns[i].more_cmds,
                    i, s[0].turns[i].nagents, live, app_act_open(s[0].turns[i].fold, live), worked, x, y0, cw, top, bottom, CP_TOOL, i, done[..]);
  // the steers taken after its last row, or all of them while it is folded, under it (#13809)
  if s[0].turns[i].steered_n > 0 {
    gap := ifx h > 0 then f[0].skin.app.gap else 0.0f32;
    sh := cp_fu_steered(s, f, i, x, y0 + h + gap, cw, -1, done[..]);
    if sh > 0 { h += gap + sh - f[0].skin.app.gap; }   // the caller adds the gap after the group
  }
  return h;
}
// One activity group at (x, y0), cw wide, as the conversation and a sub-agent's pane both draw
// it (#13731, #13744): the summary over the nrows rows from call head on (a place in the page's
// calls plus 1, 0 for none), the early rows that went and the more that were not kept said
// above and below them, and turn i's nagents sub-agents (0 for a sub-agent's own group) each in
// its place among them; `worked`, when not negative, is the seconds it took, said before the
// summary ("Worked for 42s · Ran 3 commands"). Its parts are named under `name`: name + ".grp" the summary (CP_GROUP),
// name + ".x" + k each row (`row` its action), name + ".g" + j each sub-agent (CP_AGENT). Rows
// out of view between top and bottom keep their place and are not drawn. Returns its height,
// 0 when it did nothing. steers, when not negative, is the turn whose steers stand among the rows
// where each was taken (#13809), done[0] counting those drawn; the caller draws the rest.
cp_act_group :: (s: [] CoderPage, f: [] UiFrame, name: string, head: int, nrows: int, early: int, more: int, i: int, nagents: int,
                 live: bool, open: bool, worked: int, x: f32, y0: f32, cw: f32, top: f32, bottom: f32, row: int, steers: int, done: [] int) -> f32 {
  a := f[0].skin.act; sh := f[0].sheet;
  if nrows + nagents + early + more == 0 { return 0; }
  // the summary: every kind it did, counted
  c := [1] AppActCount.[AppActCount.{}];
  q := head - 1;
  while q >= 0 {
    edit := cp_edit_at(cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]);
    kind := ifx s[0].calls[q].thought || s[0].calls[q].said then APP_ACT_THOUGHT else ifx s[0].calls[q].read then APP_ACT_READ
            else ifx edit == 5 then APP_ACT_EDIT else ifx edit == 6 then APP_ACT_WRITE else APP_ACT_EXEC;
    app_act_count(c[..], kind, s[0].calls[q].failed);
    q = s[0].calls[q].next - 1;
  }
  for j: 0..<nagents { app_act_count(c[..], APP_ACT_AGENT, s[0].turns[i].agents[j].state == CP_FAILED); }
  sb: [256] u8; sn := 0;
  said := 0;   // "Worked for 42s", once done
  if worked >= 0 { said = el_put(sb[..], 0, "Worked for "); said = el_put_i(sb[..], said, worked); said = el_put(sb[..], said, "s"); }
  wn := ifx said > 0 then el_put(sb[..], said, " · ") else 0;
  sn = wn + app_act_summary(sb[wn..<sb.count], c[0]);
  if sn == wn { sn = ifx said > 0 then said else el_put(sb[..], 0, "Worked"); }   // nothing counted: "Worked for 42s" alone
  ib: [EL_ID] u8; tb: [EL_ID] u8;
  y := y0;
  y += app_act_head(f, cp_named(ib[..], name, ".grp", -1), x, y, cw, sheet_pool(sh, cast(string) sb[0..<sn]), live, open, CP_GROUP);
  if !open { return y - y0; }
  // the tree's rows: its sub-agents each in its place among the message's own, after the rows
  // that came before it was handed over
  last := nrows + nagents - 1; pos := 0; drawn := 0;
  if early > 0 {
    eb: [96] u8; en := el_put_i(eb[..], 0, early); en = el_put(eb[..], en, ifx early == 1 then " earlier row is not shown. A chat keeps 6,000 tool calls and thoughts." else " earlier rows are not shown. A chat keeps 6,000 tool calls and thoughts.");
    y += app_meta(f, cp_named(ib[..], name, ".xe", -1), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) eb[0..<en]), false);
  }
  q = head - 1; at := early;
  while q >= 0 || drawn < nagents {
    if drawn < nagents && (q < 0 || s[0].turns[i].agents[drawn].after <= at) {
      y += app_act_row(f, cp_named(tb[..], name, ".g", drawn), x, y, cw, cp_act_agent(s, f, i, drawn), pos < last, CP_AGENT);
      // a running sub-agent of the running message can be stopped alone, as from its pane (#13766)
      if nagents > 0 && cp_running(s) && i == s[0].nturns - 1 && s[0].turns[i].agents[drawn].state == CP_RUNNING {
        sw := app_button_width(f, -1, "Stop sub-agent");
        y += app_button(f, cp_named(tb[..], name, ".s", drawn), x + a.gutter, y, sw, -1, "Stop sub-agent", APP_BUTTON_DEFAULT, 0, CP_AGENT_STOP) + f[0].skin.app.gap;
      }
      drawn += 1; pos += 1; continue;
    }
    nx := s[0].calls[q].next - 1;
    // a steer taken before this row stands above it, as the person's message (#13809)
    if steers >= 0 { sth := cp_fu_steered(s, f, steers, x, y, cw, at, done); if sth > 0 { y += sth; } }
    // a row out of view keeps its place and is not drawn, so a long run costs what shows
    rh := s[0].calls[q].h;
    if rh > 0 && (y + rh < top - CP_PANE_MARGIN || y > bottom + CP_PANE_MARGIN) { y += rh; q = nx; at += 1; pos += 1; continue; }
    rh = app_act_row(f, cp_named(tb[..], name, ".x", at), x, y, cw, cp_act_row(s, f, q, cw), pos < last, cp_row_act(s, q, row));   // a row keeps its id when older ones go, so an open row stays open
    s[0].calls[q].h = rh; y += rh;
    q = nx; at += 1; pos += 1;
  }
  if more > 0 {
    mb: [96] u8; mn := el_put_i(mb[..], 0, more); mn = el_put(mb[..], mn, " more ran after these and were not kept.");
    y += app_meta(f, cp_named(ib[..], name, ".xm", -1), x + a.gutter, y, cw - a.gutter, sheet_pool(sh, cast(string) mb[0..<mn]), false);
  }
  return y - y0;
}
// Zeron's message hover lane (transcript.luau): 32pt tall (8pt top gap + 24pt button),
// always reserved so nothing shifts; button shows only while the message or its lane is
// hovered (or during the 1.2s Copied confirmation). 24x24 rounded-md (6pt) transparent
// button with 14pt copy/check icon, flush with the message's edge (right for user, left for reply).
// The lane's height, reserved under a message whether or not its button shows: a sub-agent's pane
// keeps it under its task too, so the pane's work stands level with the conversation's (#13770).
cp_copy_lane_h :: () -> f32 { return 32.0f32 / ARCADE_PHONE_SCALE; }
cp_copy_lane :: (f: [] UiFrame, id: string, bx: f32, y: f32, visible: bool, copied: bool, action: int) -> f32 {
  u: f32 = ARCADE_PHONE_SCALE;
  lane := cp_copy_lane_h();
  if !visible { return lane; }
  k := f[0].skin; sh := f[0].sheet;
  side := 24.0f32 / u;
  top := 8.0f32 / u;
  rad := 6.0f32 / u;
  ico := 14.0f32 / u;
  by := y + top;
  label := ifx copied then "Copied" else "Copy message";
  key := uiframe_key(f, id);
  p := uiframe_press(f, key, id);
  hov := uiframe_hover(f, key, id);   // the wash eases in and out (kit/frame.coax)
  row := uiframe_semantic(f, id, EL_BUTTON, label, bx, by, side, side, 0, action);
  if p > 0 { sheet_fill(sh, bx, by, side, side, rad, k.raised); }
  else if hov > 0 { sheet_fill(sh, bx, by, side, side, rad, opacity(k.hover, hov)); }
  ink := ifx p > 0 then k.ink else rgba_mix(k.muted, k.ink, hov);
  // Copy crossfades into its check and back (components/app/base.coax app_icon_swap)
  mb: [EL_ID] u8;
  app_icon_swap(f, app_id(mb[..], id, ".mark"), bx + (side - ico) / 2, by + (side - ico) / 2, ico, k.icon_copy, k.icon_check, copied, ink);
  sheet_hit(sh, UIFRAME_HIT, row, 0, bx, by, side, side);
  return lane;
}
// The conversation from x, cw wide, in the window up to w: the messages, their groups and replies,
// the notices, the goal and the budget, scrolling above the composer.
cp_conversation :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  u: f32 = ARCADE_PHONE_SCALE;
  lane := cp_copy_lane_h(); lane_top := 8.0f32 / u; lane_btn := 24.0f32 / u;
  bar := ifx s[0].bar_h > 0 then s[0].bar_h else 80.0f32;   // the composer and its foot
  todos_h := ifx s[0].todos[0].docked then 0.0f32 else s[0].todos[0].tray_h;   // the task list over the composer, when it is not in the right sidebar
  bottom := h - CP_BOTTOM - bar - s[0].fu[0].tray_h - todos_h - s[0].git[0].tray_h - s[0].permit[0].tray_h - s[0].mcp_skills[0].oauth_tray_h - s[0].voice[0].pill_h - s[0].rich[0].tray_h;   // what scrolls runs up to the trays and the bar
  top: f32 = 0;
  s[0].view = bottom - top;
  s[0].frame_n += 1; s[0].anim = false;
  cp_follow(s, f[0].dt);
  uiframe_clip(f, left, top, w, bottom);
  // what scrolls, where a live 3D card's viewport is cut off (shows.coax)
  sc := cp_scale(s);
  s[0].live_r[4] = left * sc; s[0].live_r[5] = top * sc; s[0].live_r[6] = (w - left) * sc; s[0].live_r[7] = (bottom - top) * sc;
  in_view := s[0].px >= x && s[0].px <= x + cw && s[0].py >= top && s[0].py < bottom;
  y := top - s[0].scroll - s[0].scr[0].stretch + a.gap;
  // the first message starts under the window's title bar, which holds the corners' buttons (titlebar.coax)
  y += cp_bar(s);
  is_foreman := cast(string) s[0].current[0..<s[0].current_n] == "chat.foreman";
  if is_foreman { y += cp_foreman_hud(s, f, x, y, cw, running, exceeded); }
  // an empty chat's heading stands over its composer (cp_composer); Foreman's here, its composer at the foot
  if s[0].nturns == 0 && is_foreman {
    _ := app_empty(f, "coder.empty", x, y + a.gap, cw, ICON_BOT, "Foreman is standing by", "Describe a goal or delegate work across managed chats.");
  }
  ib: [EL_ID] u8;
  // Every message stands at its height as last measured, or CP_ROW_ESTIMATE before that, and only
  // the ones near the view are laid out (#13745): a long chat costs what shows. One above the view
  // measured at a new height moves the scroll with it, so what is read stays where it is.
  for i: 0..<s[0].nturns {
    known := s[0].turns[i].h > 0 && s[0].turns[i].hw == cw;
    th := ifx known then s[0].turns[i].h else ifx s[0].turns[i].seen_h > 0 then s[0].turns[i].seen_h else cast(f32) CP_ROW_ESTIMATE;
    margin := ifx known then 0.0f32 else cast(f32) CP_PANE_MARGIN;
    if y + th < top - margin || y > bottom + margin { y += th; s[0].turns[i].ah = 0; }
    else {
      y0 := y;
      enter := f[0].skin.motion.enter;
      if s[0].live_ask != i { f[0].skin.motion.enter = 0; }
      y += cp_turn_images(s, f, i, x, y, cw);
      y += app_message_user_fold(f, cp_id(ib[..], i, ".u"), x, y, cw, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n], s[0].turns[i].ask_open, CP_BUBBLE_FOLD);
      f[0].skin.motion.enter = enter; if s[0].live_ask == i { s[0].live_ask = -1; }
      asked := s[0].copied_kind == CP_COPIED_ASK && s[0].copied_turn == i;
      u_hov := in_view && s[0].py >= y0 && s[0].py < y + lane;
      y += cp_copy_lane(f, cp_id(ib[..], i, ".uc"), x + cw - lane_btn, y, u_hov || asked, asked, CP_COPY_ASK);
      // what it did on its way to the reply: one activity group (#13731)
      gh := cp_group(s, f, i, x, y, cw, top, bottom);
      if gh > 0 { y += gh + a.gap; }
      // the pictures its commands showed (shows.coax), over the reply
      y += cp_shows_draw(s, f, i, x, y, cw);
      if s[0].turns[i].reply_n > 0 {
        s[0].turns[i].ay = y;
        f[0].skin.motion.enter = 0;
        vv := ifx s[0].veil_turn == i then MdVeil.{ veil = s[0].veil[..], now = s[0].clock } else MdVeil.{};
        y += cp_rich_message_agent(f, cp_id(ib[..], i, ".a"), x, y, cw, cp_doc_drawn(s, i), 0, s[0].turns[i].blocks,
                                   ifx s[0].copied_kind == CP_COPIED_BLOCK && s[0].copied_turn == i then s[0].copied_block else -1, CP_COPY, CP_PATH, CP_URL, vv);
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
        s[0].turns[i].ah = y - s[0].turns[i].ay;
        if s[0].turns[i].state != CP_RUNNING {
          did := s[0].copied_kind == CP_COPIED_REPLY && s[0].copied_turn == i;
          a_hov := in_view && s[0].py >= s[0].turns[i].ay && s[0].py < y + lane;
          ck_w := cp_ckpt_turn_actions(s, f, i, x + cw, y);
          q_vis := a_hov || did || s[0].turns[i].info;
          q_off := ifx q_vis then lane_btn + a.gap_small else 0.0f32;
          meta_w := cw - lane_btn - q_off - a.gap_small - (ifx ck_w > 0 then ck_w + a.gap_small else 0.0f32);
          // who wrote it, always beside Copy/Quote: the harness and its model
          if meta_w > 24 { _ := app_meta(f, cp_id(ib[..], i, ".m"), x + lane_btn + q_off + a.gap_small, y + lane_top + (lane_btn - k.small.line) / 2, meta_w, cp_turn_meta(s, i), false); }
          cp_quote_button(f, cp_id(ib[..], i, ".aq"), x + lane_btn + a.gap_small, y, q_vis);
          y += cp_copy_lane(f, cp_id(ib[..], i, ".ac"), x, y, q_vis, did, CP_COPY_REPLY);
        } else { y += a.gap; }
      } else {
        s[0].turns[i].ah = 0;
        if s[0].turns[i].state != CP_RUNNING && cp_ckpt_has(s, i) {
          _ := cp_ckpt_turn_actions(s, f, i, x + cw, y);
          y += lane;
        }
      }
      if s[0].turns[i].cut {
        f[0].skin.motion.enter = 0;
        y += app_notice(f, cp_id(ib[..], i, ".c"), x, y, cw, "This reply is longer than 60,000 bytes. The rest is not shown.", APP_NOTICE_INFO) + a.gap;
        f[0].skin.motion.enter = enter;
      }
      st := s[0].turns[i].state;
      if st == CP_RUNNING {
        // before its worker's first line the turn has not begun: Sending…, no clock (Zeron's sending bridge)
        sending := !s[0].turns[i].heard && !s[0].turns[i].stopping;
        y += app_working(f, cp_id(ib[..], i, ".t"), x, y, ifx sending then -1 else cast(int) (s[0].clock - s[0].turns[i].began),
                         cp_working_word(s, i)) + a.gap;
      }
      else if st == CP_FAILED {
        if s[0].live_reply != i { f[0].skin.motion.enter = 0; }
        y += app_notice(f, cp_id(ib[..], i, ".n"), x, y, cw, cast(string) s[0].turns[i].note[0..<s[0].turns[i].note_n], APP_NOTICE_ERROR) + a.gap;
        f[0].skin.motion.enter = enter; if s[0].live_reply == i { s[0].live_reply = -1; }
      }
      else if st == CP_STOPPED { y += app_meta(f, cp_id(ib[..], i, ".s"), x, y, cw, "Stopped", false) + a.gap; }
      if i + 1 < s[0].nturns { y += a.gap; }
      real := y - y0;
      hit := cp_find_turn_has_hit(s, i);
      if hit > 0 && real > 4.0f32 {
        sheet_fill(f[0].sheet, x - 10.0f32, y0, 3.0f32, real - a.gap, 1.5f32, ifx hit == 2 then k.accent else opacity(k.accent, 0.45f32));
      }
      if abs(real - th) > 0.5 {
        s[0].anim = true;   // the content's height changed: one more frame settles it
        if !s[0].stick && !s[0].glide_on && y0 + th <= top { s[0].scroll += real - th; y -= real - th; }
      }
      s[0].turns[i].seen_h = real;
      s[0].turns[i].h = ifx st == CP_RUNNING then 0.0f32 else real; s[0].turns[i].hw = cw;
    }
  }
  enter0 := f[0].skin.motion.enter;
  if full && !running {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.full", x, y, cw, "This chat holds 1,000 messages. Start a new chat to send more.", APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0 {
    gb: [640] u8; tb_el: [32] u8;
    gn := el_put(gb[..], 0, "Goal ("); gn = el_put(gb[..], gn, cp_goal_status_label(s[0].goal_status));
    gn = el_put(gb[..], gn, " · "); gn = el_put(gb[..], gn, cp_goal_elapsed(tb_el[..], s[0].goal_time_seconds));
    gn = el_put(gb[..], gn, "): ");
    obj_cut := ifx s[0].goal_objective_n > 280 then 280 else s[0].goal_objective_n;
    gn += cp_out(gb[gn..<gb.count], cast(string) s[0].goal_objective[0..<obj_cut]);
    if s[0].goal_objective_n > 280 { gn = el_put(gb[..], gn, "..."); }
    f[0].skin.motion.enter = 0;
    gkind := ifx s[0].goal_status == CP_GOAL_BLOCKED || s[0].goal_status == CP_GOAL_BUDGET_LIMITED then APP_NOTICE_ERROR else APP_NOTICE_INFO;
    y += app_notice(f, "coder.goal.banner", x, y, cw, sheet_pool(f[0].sheet, cast(string) gb[0..<gn]), gkind) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    tlabel := ifx s[0].goal_status == CP_GOAL_ACTIVE then "Pause goal" else "Resume goal";
    tw := app_button_width(f, -1, tlabel);
    ew := app_button_width(f, -1, "Edit goal");
    cw_btn := app_button_width(f, -1, "Complete");
    xw := app_button_width(f, -1, "Clear");
    bx := x;
    bh := app_button(f, "coder.goal.toggle", bx, y, tw, -1, tlabel, APP_BUTTON_DEFAULT, 0, CP_GOAL_TOGGLE);
    bx += tw + a.gap_small;
    if bx + ew <= x + cw { _ := app_button(f, "coder.goal.edit", bx, y, ew, -1, "Edit goal", APP_BUTTON_DEFAULT, 0, CP_GOAL_OPEN); bx += ew + a.gap_small; }
    if s[0].goal_status != CP_GOAL_COMPLETE && bx + cw_btn <= x + cw { _ := app_button(f, "coder.goal.complete", bx, y, cw_btn, -1, "Complete", APP_BUTTON_DEFAULT, 0, CP_GOAL_COMPLETE_ACT); bx += cw_btn + a.gap_small; }
    if bx + xw <= x + cw { _ := app_button(f, "coder.goal.clear", bx, y, xw, -1, "Clear", APP_BUTTON_DEFAULT, 0, CP_GOAL_CLEAR_ACT); }
    y += bh + a.gap;
  }
  if s[0].goal_notice_n > 0 {
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.goal.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) s[0].goal_notice[0..<s[0].goal_notice_n]), APP_NOTICE_INFO) + a.gap;
    f[0].skin.motion.enter = enter0;
  }
  if exceeded {
    cb1: [32] u8; bb1: [32] u8; nb: [160] u8;
    c_str := ifx s[0].cost_usd_micros > 0 then cp_cost(cb1[..], s[0].cost_usd_micros) else "$0.00";
    b_str := cp_cost(bb1[..], cp_budget(s));
    nn := el_put(nb[..], 0, "Chat budget reached ("); nn = el_put(nb[..], nn, c_str); nn = el_put(nb[..], nn, " / "); nn = el_put(nb[..], nn, b_str);
    nn = el_put(nb[..], nn, "). Approve continuing above budget or increase the limit.");
    f[0].skin.motion.enter = 0;
    y += app_notice(f, "coder.budget.notice", x, y, cw, sheet_pool(f[0].sheet, cast(string) nb[0..<nn]), APP_NOTICE_ERROR) + a.gap_small;
    f[0].skin.motion.enter = enter0;
    aw := app_button_width(f, -1, "Continue above budget");
    ew := app_button_width(f, -1, "Edit budget");
    if aw + a.gap_small + ew <= cw {
      bh := app_button(f, "coder.budget.approve", x, y, aw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE);
      _ := app_button(f, "coder.budget.edit", x + aw + a.gap_small, y, ew, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT);
      y += bh + a.gap;
    } else {
      y += app_button(f, "coder.budget.approve", x, y, cw, -1, "Continue above budget", APP_BUTTON_PRIMARY, 0, CP_BUDGET_APPROVE) + a.gap_small;
      y += app_button(f, "coder.budget.edit", x, y, cw, -1, "Edit budget", APP_BUTTON_DEFAULT, 0, CP_BUDGET_EDIT) + a.gap;
    }
  }
  uiframe_unclip(f);
  s[0].content = y + s[0].scroll + s[0].scr[0].stretch - top;
  app_scroll_rail(f, s[0].scr[..], w, top, s[0].scroll, s[0].content, s[0].view, s[0].view, s[0].now, s[0].reduced);
  cp_minimap_draw(s, f, w, top, bottom);
  cp_find_bar(s, f, left, w, top);
  // away from the end long enough to mean it: the way back floats over the transcript's foot,
  // "New reply" while one is written or came meanwhile (#13745)
  s[0].at_end = s[0].stick || s[0].glide_on || s[0].scroll >= s[0].content - s[0].view - 2;
  if s[0].at_end { s[0].away_t = 0; s[0].unseen = false; }
  else if s[0].away_t < CP_AWAY { s[0].away_t += f[0].dt; s[0].anim = true; }
  writing := running || s[0].unseen;
  _ := app_jump_pill(f, "coder.jump", x + cw / 2, bottom - a.pill_lift, ifx writing then "New reply" else "Jump to latest", writing,
                     s[0].nturns > 0 && !s[0].at_end && s[0].away_t >= CP_AWAY, CP_JUMP);
}
// Where the transcript's view rests this frame (#13745): a glide toward the end under way (outQuad
// over CP_GLIDE, toward the end as it is now, resting there once it lands), else at the end while
// it sticks there.
cp_follow :: (s: [] CoderPage, dt: f32) {
  end := s[0].content - s[0].view; if end < 0 { end = 0; }
  if s[0].glide_on {
    s[0].glide_t += dt;
    p := ifx s[0].reduced then 1.0f32 else s[0].glide_t / cast(f32) CP_GLIDE;
    if p >= 1 { s[0].glide_on = false; s[0].stick = true; }
    else { s[0].scroll = s[0].glide_from + (end - s[0].glide_from) * ar_ease(AM_OUT_QUAD, p); s[0].anim = true; }
  }
  if s[0].stick { s[0].scroll = end; }
}
// The Foreman chat's HUD at (x, y), cw wide: its tier, budget and managed chats. Returns the height it takes.
cp_foreman_hud :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, cw: f32, running: bool, exceeded: bool) -> f32 {
  a := f[0].skin.app;
  hud: [1] FhudData;
  hud[0].tier_label = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then "Observe" else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then "Auto" else "Managed";
  hud[0].tier_status = ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then FHUD_IDLE else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then FHUD_WARN else FHUD_RUNNING;
  hud[0].foreman_busy = s[0].foreman_busy || running;
  hud[0].collapsed = s[0].foreman_hud_collapsed;
  hud[0].toggle_action = CP_FOREMAN_HUD_TOGGLE;
  for ti: 0..<s[0].nturns {
    for ai: 0..<s[0].turns[ti].nagents {
      if s[0].turns[ti].agents[ai].state == CP_RUNNING { hud[0].agents_active += 1; }
    }
  }
  fcost := ifx s[0].cost_usd_micros > 0 then cp_cost(s[0].scratch[0..<32], s[0].cost_usd_micros) else "$0.00";
  fbud := cp_cost(s[0].scratch[32..<64], cp_budget(s));
  fln := el_put(s[0].scratch[64..<128], 0, fcost); fln = el_put(s[0].scratch[64..<128], fln, " / "); fln = el_put(s[0].scratch[64..<128], fln, fbud);
  hud[0].budget_text = sheet_pool(f[0].sheet, cast(string) s[0].scratch[64..<64 + fln]);
  b_lim := cp_budget(s);
  hud[0].budget_ratio = ifx b_lim > 0 then cast(f32) s[0].cost_usd_micros / cast(f32) b_lim else 0.0f32;
  if hud[0].budget_ratio > 1.0f32 { hud[0].budget_ratio = 1.0f32; }
  hud[0].budget_status = ifx exceeded then FHUD_FAILED else ifx hud[0].budget_ratio >= 0.8f32 then FHUD_WARN else FHUD_DONE;
  for q: 0..<s[0].nchats {
    if !s[0].chats[q].managed { continue; }
    hud[0].managed_total += 1;
    if s[0].chats[q].busy { hud[0].managed_busy += 1; }
    if hud[0].nnodes < FHUD_MAX_NODES {
      nn := el_put(s[0].scratch[0..<EL_ID], 0, "foreman.node.");
      nn = el_put(s[0].scratch[0..<EL_ID], nn, cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n]);
      ntitle := cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n];
      if ntitle.count == 0 { ntitle = "Managed chat"; }
      hud[0].nodes[hud[0].nnodes] = FhudNode.{
        id = sheet_pool(f[0].sheet, cast(string) s[0].scratch[0..<nn]),
        title = sheet_pool(f[0].sheet, ntitle),
        subtitle = ifx s[0].chats[q].busy then "Running · Managed" else "Standby · Managed",
        status = ifx s[0].chats[q].busy then FHUD_RUNNING else FHUD_DONE,
        action = CP_FOREMAN_HUD_OPEN,
      };
      hud[0].nnodes += 1;
    }
  }
  return fhud_hud(f, x, y, cw, hud[..]) + a.gap;
}
// The buttons in the window's top corners (the chat's cost and goal are in the composer's foot): Copy chat, and with no sidebar
// Show sidebar and New chat.
cp_corners :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, window_w: f32, exceeded: bool) {
  k := f[0].skin; a := k.app;
  side := a.icon_button;
  // the corners' buttons stand on the window's title bar, on its line, clear of its controls at the left
  cy := cp_bar_y(s, side);
  // New chat floats in the window's top right corner, over what scrolls
  all := s[0].copied_kind == CP_COPIED_ALL;
  copy_x := ifx left > 0 then w - a.icon_button - CP_CORNER else w - 2 * a.icon_button - CP_CORNER;
  // the code review (#13696): its button shows once an edit changed a file, or while it is open
  review := s[0].review || cp_has_edits(s);
  lead_x := ifx review then copy_x - side else copy_x;
  // Reserve space for both terminal (lead_x - side) and files (lead_x - 2*side) toggle buttons so Git toolbar chips never overlap them.
  cp_git_toolbar(s, f, ifx left > 0 then left + 12.0f32 else cp_bar_clear(s), lead_x - 2 * side - a.gap_small, cy);
  if review {
    shown := cp_review_shown(s);
    _ := app_icon_button(f, "coder.review", lead_x, cy, ICON_PEN, ifx shown then "Close review" else "Review changes", APP_BUTTON_QUIET, ifx shown then EL_S_CURRENT else 0, CP_REVIEW);
  }
  term_shown := cp_term_shown(s);
  _ := app_icon_button(f, "coder.term.toggle", lead_x - side, cy, ICON_TERMINAL, ifx term_shown then "Hide terminal" else "Show terminal", APP_BUTTON_QUIET, ifx term_shown then EL_S_CURRENT else 0, CP_TERM_TOGGLE);
  ft_shown := cp_ft_shown(s);
  _ := app_icon_button(f, "coder.ft.toggle", lead_x - 2 * side, cy, ICON_FOLDER, ifx ft_shown then "Hide files" else "Show files", APP_BUTTON_QUIET, ifx ft_shown then EL_S_CURRENT else 0, CP_FT_TOGGLE);
  _ := app_icon_button(f, "coder.copy", copy_x, cy, ifx all then k.icon_check else k.icon_copy, ifx all then "Copied" else "Copy chat", APP_BUTTON_QUIET,
                       ifx s[0].nturns == 0 then EL_S_DISABLED else 0, CP_COPY_ALL);
  if left == 0 {
    _ := app_icon_button(f, "coder.new", w - a.icon_button - CP_CORNER, cy, ICON_COMPOSE, cp_tr(s[0].cust[0].locale.active, "new_chat"), APP_BUTTON_QUIET,
                         ifx s[0].nturns == 0 then EL_S_DISABLED else 0, CP_NEW);
  }
}
// The composer, x and cw as the conversation (#13743): Zeron's pill (components/zeron/composer.coax's
// zc_pill), compact on one 49 row while the draft fits and expanded over it, and its foot under it:
// the model (Command-/ opens its menu) on the left, and on the right the chat's goal, its cost, how
// full the context is, and the working folder and its branch. A narrow foot folds the goal first,
// then the cost, the context and the branch. An empty chat (not Foreman's) holds the composer,
// expanded, in the window's middle under its heading; it grows down from there.
cp_composer :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, h: f32, running: bool, full: bool, exceeded: bool) {
  k := f[0].skin; a := k.app;
  is_foreman := cast(string) s[0].current[0..<s[0].current_n] == "chat.foreman";
  centred := s[0].nturns == 0 && !is_foreman;
  foot := k.cmp.chip_h + a.gap_small;
  g := cp_pill_shape(s, f, cw);
  box_y := h - cast(f32) CP_BOTTOM - foot - g.height;
  if centred {
    least := zc_pill(cw, 0, 0, k.cmp.line, cast(f32) ZC_TRAILING, k.cmp.radius - cast(f32) ZC_BORDER, true, false, false).height;
    top := (h - s[0].empty_h - a.gap - least - foot) / 2;
    if top < cast(f32) CP_CORNER + a.icon_button { top = cast(f32) CP_CORNER + a.icon_button; }
    eh := app_centred(f, k.strong, k.ink, x, top, cw, "Let's build");
    _ := uiframe_semantic(f, "coder.empty", EL_HEADING, "Let's build", x, top, cw, eh, 0, 0);
    if abs(eh - s[0].empty_h) > 0.5 { s[0].empty_h = eh; s[0].anim = true; }
    if top + eh + a.gap < box_y { box_y = top + eh + a.gap; }
  }
  s[0].box = cp_zeron_composer(s, f, x, box_y, cw, g, running, full || exceeded);
  s[0].bar_h = h - cast(f32) CP_BOTTOM - box_y;
  cp_fu_tray(s, f, x, box_y - a.gap_small, cw, running);
  todos_h: f32 = 0.0f32;
  if !s[0].todos[0].docked { todos_h = cp_todos_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h, cw, true); }
  git_h := cp_git_output_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h, cw);
  permit_h := cp_permit_card(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h, cw);
  oauth_h := cp_mcp_oauth_card(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h, cw);
  voice_h := cp_voice_pill(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h - oauth_h, cw);
  _ := cp_stash_tray(s, f, x, box_y - a.gap_small - s[0].fu[0].tray_h - todos_h - git_h - permit_h - oauth_h - voice_h, cw);
  foot_y := box_y + g.height + a.gap_small;
  m_x := cp_composer_foot(s, f, x, foot_y, cw, running, exceeded);
  if s[0].model_menu { cp_model_menu(s, f, x, cw, m_x, box_y, foot_y, h); }
  if s[0].usage[0].popover_open { cp_usage_popover(s, f, x, cw, box_y, foot_y, h); }
  // the @ and / popover at the draft's token (mention.coax, #13699)
  cp_mn_sync(s); cp_mn_due(s);
  if !s[0].model_menu && !s[0].usage[0].popover_open { cp_mn_paint(s, f, x, cw); }
}
// The pill's shape this frame for a column cw wide: the draft's width on one line and its rows at
// the expanded text width, the shape that makes, and the run toward it (220 ms, none with reduced
// motion). A new chat keeps it expanded; a draft of lines expands it.
cp_pill_shape :: (s: [] CoderPage, f: [] UiFrame, cw: f32) -> ZcPill {
  k := f[0].skin; a := s[0].atlas[..];
  text := eb_text(s[0].draft[..]);
  lines := false; for c: text { if c == 10 { lines = true; break; } }
  line := k.cmp.line;
  wide: f32 = 0;
  if !lines {
    if !a[0].ready { wide = cast(f32) text.count * line / 2; }
    else if text.count > CP_PILL_MEASURE { wide = cw; }   // far past a line: no need to measure it all
    else { wide = text_width(a, CP_COMPOSER_FACE, text); }
  }
  open_w := cw - cast(f32) (ZC_BORDER * 2 + ZC_TEXT_OPEN_SIDE * 2);
  rows := cast(f32) cp_ed_lines(s, k, open_w) * line;
  cargo := cp_cargo_n(s) > 0;   // attachments keep it expanded, their strip over the text (#13699)
  target := zc_pill(cw, wide, rows, line, cast(f32) ZC_TRAILING, k.cmp.radius - cast(f32) ZC_BORDER, s[0].nturns == 0 || cargo, lines, s[0].pill_next);
  s[0].pill_next = target.next_text;
  if cargo { target = zc_with_cargo(target, cp_cargo_height(s, f, cw)); }
  g := zc_motion_step(s[0].pill[..], target, f[0].dt, s[0].reduced);
  if zc_moving(s[0].pill[..]) { s[0].anim = true; }
  return g;
}

// Zeron's chat composer pill (ds/composer.luau, ds/composer_layout.luau) in the page's theme (cp_theme(), Coder Noir)
// at (x, y), w wide, in shape g: its radius (26, at most half its height), the composer's solid and
// edge (firmer with the keyboard), its 0 12 32 shadow, the 28 round + (a working folder) at its
// start, the text, the 28 round mic dictation button (#13882), and the 32 round Send / Stop at its end.
cp_zeron_composer :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32, g: ZcPill, running: bool, off: bool) -> ComposerBox {
  k := f[0].skin; sh := f[0].sheet;
  border := cast(f32) ZC_BORDER;
  radius := k.cmp.radius; if radius > g.height / 2 { radius = g.height / 2; }
  text := eb_text(s[0].draft[..]);
  editing := cp_composer_focused(s) && !s[0].model_menu;
  th := cp_theme();
  z_solid := th.surface; z_edge := th.border; z_edge_focus := th.line_strong;
  z_pri_bg := th.primary; z_pri_hov := th.primary_hover; z_pri_prs := th.primary_active; z_pri_ink := th.bg;
  z_dis_bg := th.secondary; z_dis_ink := th.disabled;
  sheet_under(sh, uiskin_shadow(sh[0].under, sh[0].nu, x, y, w, g.height, radius, k.shadows.composer));
  field_state := (ifx editing then EL_S_FOCUSED else 0) | (ifx off then EL_S_DISABLED else 0);
  field_row := uiframe_semantic(f, "coder.composer", EL_FIELD, "Message", x, y, w, g.height, field_state, CP_FIELD);
  elt_value(f[0].rows, field_row, text);
  elt_value(f[0].rows, uiframe_semantic(f, "coder.composer.shape", EL_REGION, ifx g.expanded then "Expanded" else "Compact", x, y, w, g.height, 0, 0), ifx g.expanded then "expanded" else "compact");
  _ := sheet_box(sh, x, y, w, g.height, radius, border, z_solid, ifx editing then z_edge_focus else z_edge);
  sheet_hit(sh, UIFRAME_HIT, field_row, 0, x, y, w, g.height);
  // the draft in the page's editor (editor.coax); empty, the placeholder, which while a reply runs
  // says what Return does (#13717)
  hint := ifx !running then "Do anything…" else "Steer the reply · ⇧Return queues · Esc stops";
  mic_side := cast(f32) ZC_CONTROL; mic_gap := 6.0f32;
  tx := border + g.text_left; tw := w - 2 * border - g.text_left - g.text_right - (ifx g.expanded then 0.0f32 else mic_side + mic_gap);
  if tw < g.line { tw = g.line; }
  cp_ed_draw(s, f, CP_ED_COMPOSER, x + tx, y + border + g.text_top, tw, g.text_h, hint);
  // the draft's attachments over its text (attach.coax)
  if cp_cargo_n(s) > 0 && g.expanded { cp_cargo_draw(s, f, x, y, w); }
  // + : its menu attaches files or changes the working folder (attach.coax, #13699)
  control := cast(f32) ZC_CONTROL;
  lx := x + border + g.lead_left; ly := y + g.height - border - g.lead_bottom - control;
  s[0].add_x = lx + control / 2; s[0].add_y = ly + control;
  lead_off := false;
  lead_row := uiframe_semantic(f, "coder.composer.add", EL_BUTTON, "Attach files or change the folder", lx, ly, control, control, 0, CP_ASK_ADD_PRESS);
  lead_hov := !lead_off && uiframe_hovered(f, "coder.composer.add");
  lead_prs := !lead_off && uiframe_pressed(f, "coder.composer.add");
  if lead_prs || lead_hov { sheet_fill(sh, lx, ly, control, control, control / 2, ifx lead_prs then th.pressed else th.hover); }
  lead_ink := ifx lead_off then th.faint else ifx lead_hov || lead_prs then th.text else th.muted;
  arm := cast(f32) CP_PLUS; bar := cast(f32) CP_PLUS_STROKE;
  sheet_fill(sh, lx + (control - arm) / 2, ly + (control - bar) / 2, arm, bar, bar / 2, lead_ink);
  sheet_fill(sh, lx + (control - bar) / 2, ly + (control - arm) / 2, bar, arm, bar / 2, lead_ink);
  if !lead_off { sheet_hit(sh, UIFRAME_HIT, lead_row, 0, lx, ly, control, control); }
  // Send / Stop, with the voice dictation mic button beside it (#13882)
  send := cast(f32) ZC_TRAILING;
  sx := x + w - border - g.trail_right - send; sy := y + g.height - border - g.trail_bottom - send;
  cp_voice_mic_button(s, f, sx - mic_gap - mic_side, sy + (send - mic_side) / 2, mic_side);
  can_send := running || (!off && (text.count > 0 || cp_cargo_n(s) > 0));
  loc := s[0].cust[0].locale.active;
  send_label := ifx running then cp_tr(loc, "stop") else cp_tr(loc, "send");
  send_row := uiframe_semantic(f, "coder.composer.send", EL_BUTTON, send_label, sx, sy, send, send, ifx !can_send then EL_S_DISABLED else 0, CP_SEND);
  send_hov := can_send && uiframe_hovered(f, "coder.composer.send");
  send_prs := can_send && uiframe_pressed(f, "coder.composer.send");
  send_bg := ifx !can_send then z_dis_bg else ifx send_prs then z_pri_prs else ifx send_hov then z_pri_hov else z_pri_bg;
  send_ink := ifx !can_send then z_dis_ink else z_pri_ink;
  sheet_fill(sh, sx, sy, send, send, send / 2, send_bg);
  if running {
    sq := k.cmp.stop;
    sheet_fill(sh, sx + (send - sq) / 2, sy + (send - sq) / 2, sq, sq, k.cmp.stop_radius, send_ink);
  } else {
    ic := cast(f32) CP_SEND_ICON;
    sheet_icon(sh, ICON_ARROW_UP, sx + (send - ic) / 2, sy + (send - ic) / 2, ic, send_ink);
  }
  sheet_hit(sh, UIFRAME_HIT, send_row, 0, sx, sy, send, send);
  return ComposerBox.{height = g.height, text_x = tx, text_y = border + g.text_top, text_w = tw, text_h = g.text_h, inset = 0.0f32, line = g.line,
                      row_y = sy - y, send_x = sx - x, send = send};
}

// A chip of the composer's foot (Zeron's quiet chip): no ground until hovered or pressed; an icon
// (-1: none), its text cut to w, a chevron when it opens a menu. EL_S_CURRENT holds it lit,
// EL_S_DISABLED dims it and takes no press. Returns its width.
cp_foot_chip :: (f: [] UiFrame, id: string, label: string, x: f32, y: f32, w: f32, icon: int, text: string, chevron: bool, state: int, action: int) -> f32 {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme(); c := k.cmp;
  off := (state & EL_S_DISABLED) != 0; on := (state & EL_S_CURRENT) != 0;
  row := uiframe_semantic(f, id, EL_BUTTON, label, x, y, w, c.chip_h, state, ifx off then 0 else action);
  elt_value(f[0].rows, row, text);
  hov := !off && uiframe_hovered(f, id); prs := !off && uiframe_pressed(f, id);
  if prs || hov || on { sheet_fill(sh, x, y, w, c.chip_h, c.chip_radius, ifx prs then th.pressed else th.hover); }
  ink := ifx off then th.faint else ifx on || hov || prs then th.text else th.muted;
  tx := x + c.chip_pad; room := w - 2 * c.chip_pad;
  if icon >= 0 { sheet_icon(sh, icon, tx, y + (c.chip_h - c.chip_icon) / 2, c.chip_icon, ink); tx += c.chip_icon + c.chip_gap; room -= c.chip_icon + c.chip_gap; }
  chev := cast(f32) CP_CHEVRON;
  if chevron { room -= chev + c.chip_gap; sheet_icon(sh, ICON_CHEVRON, x + w - c.chip_pad - chev, y + (c.chip_h - chev) / 2, chev, ink); }
  if room > 0 { _ := sheet_text(sh, f[0].m, -1, tx, y + (c.chip_h - k.small.line) / 2, k.small.line, k.small.face, ink, app_fit(f, k.small.face, text, room + 0.5f32)); }
  if !off { sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, c.chip_h); }
  return w;
}
cp_foot_chip_width :: (f: [] UiFrame, icon: int, text: string, chevron: bool) -> f32 {
  k := f[0].skin; c := k.cmp;
  w := 2 * c.chip_pad + ceil(measure_width(f[0].m, k.small.face, text));
  if icon >= 0 { w += c.chip_icon + c.chip_gap; }
  if chevron { w += cast(f32) CP_CHEVRON + c.chip_gap; }
  return w;
}
// The composer's foot at y: on the left the model (and while a reply runs, Steer and Queue for a
// draft); on the right the chat's goal, its cost (once a chat has a turn, or in Foreman), how full
// the context is, and the working folder › its branch. Which harness or backend runs a model shows
// inside the model dropdown (cp_model_desc), not permanently in the foot. Too narrow, it folds the
// goal, then the cost, the context and the branch. Returns the model chip's x, for its menu.
cp_composer_foot :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, cw: f32, running: bool, exceeded: bool) -> f32 {
  k := f[0].skin; a := k.app; c := k.cmp;
  side := cast(f32) CP_FOOT_SIDE; gap := a.gap_small;
  // what each part says
  fb: [CP_FOLDER_TEXT + CP_BRANCH_TEXT + 8] u8;
  fn := el_put(fb[..], 0, cast(string) s[0].folder[0..<s[0].folder_n]);
  short_n := fn;
  if s[0].branch_n > 0 { fn = el_put(fb[..], fn, " › "); fn = el_put(fb[..], fn, cast(string) s[0].branch[0..<s[0].branch_n]); }
  m_label := cp_model_label(s, cp_model_index(s));
  e_label := cp_effort_label(s, cp_model_index(s));   // the chat's thinking level, beside the model
  cb: [32] u8; bb: [32] u8; lb: [64] u8;
  ln := el_put(lb[..], 0, ifx s[0].cost_usd_micros > 0 then cp_cost(cb[..], s[0].cost_usd_micros) else "$0.00");
  ln = el_put(lb[..], ln, " / "); ln = el_put(lb[..], ln, cp_cost(bb[..], cp_budget(s)));
  home := s[0].nturns == 0 && cast(string) s[0].current[0..<s[0].current_n] != "chat.foreman";
  cost := sheet_pool(f[0].sheet, cast(string) lb[0..<ln]);
  has_goal := s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0;
  glb: [64] u8; gtb: [32] u8; gln := 0;
  if has_goal {
    gln = el_put(glb[..], 0, "Goal · "); gln = el_put(glb[..], gln, cp_goal_status_label(s[0].goal_status));
    if s[0].goal_time_seconds > 0 { gln = el_put(glb[..], gln, " · "); gln = el_put(glb[..], gln, cp_goal_elapsed(gtb[..], s[0].goal_time_seconds)); }
  }
  goal := sheet_pool(f[0].sheet, cast(string) glb[0..<gln]);
  // their widths, and what folds
  show_fu_draft := running && eb_text(s[0].draft[..]).count > 0 && s[0].fu[0].editing == 0;
  show_folder := s[0].folder_n > 0 && !show_fu_draft;
  w_folder := ifx show_folder then cp_foot_chip_width(f, ICON_FOLDER, cast(string) fb[0..<fn], false) else 0.0f32;
  w_short := ifx show_folder then cp_foot_chip_width(f, ICON_FOLDER, cast(string) fb[0..<short_n], false) else 0.0f32;
  cap := cast(f32) CP_FOLDER_MOST;
  if w_folder > cap { w_folder = cap; } if w_short > cap { w_short = cap; }
  w_fu := ifx show_fu_draft then app_chip_width(f, -1, "Steer", 0) + gap + app_chip_width(f, -1, "Queue", 0) else 0.0f32;
  w_model := cp_foot_chip_width(f, -1, m_label, true);
  w_effort := cp_foot_chip_width(f, -1, e_label, false);
  w_ring := c.chip_h;
  w_usage := c.chip_h;
  w_cost := cp_foot_chip_width(f, -1, cost, false);
  w_goal := ifx has_goal then cp_foot_chip_width(f, -1, goal, false) else 0.0f32;
  show_goal := has_goal; show_cost := !home; show_ring := s[0].ctx_in > 0; show_usage := s[0].usage[0].naccts > 0 || s[0].usage[0].popover_open; show_branch := show_folder && s[0].branch_n > 0 && !running;
  room := cw - 2 * side;
  for step: 0..<6 {
    need := w_model + gap + w_effort;
    if show_fu_draft { need += gap + w_fu; }
    if show_folder { need += gap + (ifx show_branch then w_folder else w_short); }
    if show_usage { need += gap + w_usage; }
    if show_ring { need += gap + w_ring; } if show_cost { need += gap + w_cost; } if show_goal { need += gap + w_goal; }
    if need <= room { break; }
    if show_usage { show_usage = false; } else if show_goal { show_goal = false; } else if show_cost { show_cost = false; } else if show_ring { show_ring = false; } else { show_branch = false; }
  }
  // the left side: Steer & Queue (while a reply runs with a draft) and the model chip, kept whole
  // before the working folder is shortened
  fx := x + side;
  end_x := x + cw - side;
  if show_fu_draft {
    sw := app_chip_width(f, -1, "Steer", 0); qw := app_chip_width(f, -1, "Queue", 0);
    if fx + sw + qw + 2 * gap + w_model <= end_x {
      _ := app_chip(f, "coder.fu.steer", fx, y, 0, -1, "Steer the reply with the draft (Return)", "Steer", EL_S_CURRENT, CP_FU_DRAFT);
      _ := app_chip(f, "coder.fu.queue", fx + sw + gap, y, 0, -1, "Queue the draft for after the reply (⇧Return)", "Queue", 0, CP_FU_DRAFT);
      fx += sw + qw + 2 * gap;
    }
  }
  m_x := fx;
  mw := w_model;
  if mw > end_x - m_x { mw = end_x - m_x; }
  if mw > 0 { fx += cp_foot_chip(f, "coder.model", "Model (⌘/)", m_x, y, mw, -1, m_label, true, ifx s[0].model_menu then EL_S_CURRENT else 0, CP_MODEL_MENU); }
  // the effort, as Zeron and Claude Code show it next to the model: a press steps low, medium, high
  if mw > 0 && fx + gap + w_effort <= end_x {
    fx += gap;
    fx += cp_foot_chip(f, "coder.effort", "Effort (low, medium, high)", fx, y, w_effort, -1, e_label, false, 0, CP_EFFORT_CYCLE);
  }
  // the right side, from the end: working folder at the far right, then context ring, cost, and goal;
  // when space is tight, the working folder shrinks before the model chip ever truncates
  rx := end_x;
  other_right: f32 = 0;
  if show_usage { other_right += w_usage + gap; }
  if show_ring { other_right += w_ring + gap; }
  if show_cost { other_right += w_cost + gap; }
  if show_goal { other_right += w_goal + gap; }
  fw := ifx show_branch then w_folder else w_short;
  right_total := other_right + (ifx show_folder then fw + gap else 0.0f32);
  // Fresh Session toggle & Multi-model fan-out chips: fold before goal/cost/context/folder
  if !running && (s[0].nturns > 0 || s[0].prov[0].fresh_session) {
    fresh_lbl := ifx s[0].prov[0].fresh_session then "Fresh ✓" else "Fresh";
    w_fresh := cp_foot_chip_width(f, -1, fresh_lbl, false);
    if fx + gap + w_fresh + right_total <= end_x {
      fx += gap;
      fx += cp_foot_chip(f, "coder.fresh", "Fresh Session (skip prior history on next send)", fx, y, w_fresh, -1, fresh_lbl, false, ifx s[0].prov[0].fresh_session then EL_S_CURRENT else 0, CP_FRESH_TOGGLE);
    }
  }
  if !running && (cp_models(s) >= 2 || cp_fanout_ready(s)) {
    fob: [24] u8; fon := 0;
    if cp_fanout_ready(s) {
      fon = el_put(fob[..], 0, "Fan-out (");
      fon = el_put_i(fob[..], fon, cp_fanout_count(s));
      fon = el_put(fob[..], fon, ")");
    } else {
      fon = el_put(fob[..], 0, "Fan-out");
    }
    fo_lbl := sheet_pool(f[0].sheet, cast(string) fob[0..<fon]);
    w_fo := cp_foot_chip_width(f, -1, fo_lbl, false);
    if fx + gap + w_fo + right_total <= end_x {
      fx += gap;
      fx += cp_foot_chip(f, "coder.fanout", "Multi-model fan-out (send to 2–4 models in parallel)", fx, y, w_fo, -1, fo_lbl, false, ifx cp_fanout_ready(s) then EL_S_CURRENT else 0, CP_FANOUT_OPEN);
    }
  }
  max_fw := rx - fx - (ifx mw > 0 then gap else 0.0f32) - other_right;
  if fw > max_fw { fw = max_fw; }
  if show_folder && fw > 2 * c.chip_pad {
    rx -= fw;
    shown := sheet_pool(f[0].sheet, cast(string) fb[0..<(ifx show_branch then fn else short_n)]);
    _ := cp_foot_chip(f, "coder.folder", "Working folder", rx, y, fw, ICON_FOLDER, shown, false, 0, CP_FOLDER);
    rx -= gap;
  }
  if show_usage && rx - w_usage >= fx { rx -= w_usage; cp_usage_ring(s, f, rx, y); rx -= gap; }
  if show_ring && rx - w_ring >= fx { rx -= w_ring; cp_context_ring(s, f, rx, y, x, cw); rx -= gap; }
  if show_cost && rx - w_cost >= fx { rx -= w_cost; _ := cp_foot_chip(f, "coder.cost", "Chat budget", rx, y, w_cost, -1, cost, false, ifx exceeded then EL_S_CURRENT else 0, CP_BUDGET_EDIT); rx -= gap; }
  if show_goal && rx - w_goal >= fx { rx -= w_goal; _ := cp_foot_chip(f, "coder.goal", "Thread goal", rx, y, w_goal, -1, goal, false, ifx s[0].goal_status == CP_GOAL_ACTIVE then EL_S_CURRENT else 0, CP_GOAL_OPEN); rx -= gap; }
  return m_x;
}
// How full the context is, a ring at (x, y) in the foot; hovered, a card over it with the last
// model call's tokens: its input of the model's window, then input, cached and output.
cp_context_ring :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, col_x: f32, cw: f32) {
  k := f[0].skin; c := k.cmp; sh := f[0].sheet; th := cp_theme();
  side := c.chip_h; ring := c.chip_icon;
  share := cp_ctx_share(s);
  ub: [24] u8; wb: [24] u8; l1: [96] u8;
  n1 := el_put(l1[..], 0, cp_tokens(ub[..], s[0].ctx_in + s[0].ctx_out));
  if s[0].ctx_window > 0 {
    n1 = el_put(l1[..], n1, " of "); n1 = el_put(l1[..], n1, cp_tokens(wb[..], s[0].ctx_window)); n1 = el_put(l1[..], n1, " tokens · ");
    pct := cast(int) (share * 100 + 0.5);   // not a size
    if pct == 0 && share > 0 { n1 = el_put(l1[..], n1, "<1"); } else { n1 = el_put_i(l1[..], n1, pct); }
    n1 = el_put(l1[..], n1, "%");
  } else { n1 = el_put(l1[..], n1, " tokens"); }
  line1 := sheet_pool(sh, cast(string) l1[0..<n1]);
  row := uiframe_semantic(f, "coder.context", EL_PROGRESS, "Context used", x, y, side, side, 0, 0);
  elt_value_share(f[0].rows, row, share);
  hov := uiframe_hovered(f, "coder.context");
  if hov { sheet_fill(sh, x, y, side, side, c.chip_radius, th.hover); }
  progress_ring(sh, k, x + (side - ring) / 2, y + (side - ring) / 2, ring, share);
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, side, side);
  if !hov { return; }
  ib: [24] u8; cb: [24] u8; ob: [24] u8; l2: [128] u8;
  n2 := el_put(l2[..], 0, "Input "); n2 = el_put(l2[..], n2, cp_tokens(ib[..], s[0].ctx_in));
  n2 = el_put(l2[..], n2, " · Cached "); n2 = el_put(l2[..], n2, cp_tokens(cb[..], s[0].ctx_cached));
  n2 = el_put(l2[..], n2, " · Output "); n2 = el_put(l2[..], n2, cp_tokens(ob[..], s[0].ctx_out));
  line2 := sheet_pool(sh, cast(string) l2[0..<n2]);
  pad := cast(f32) CP_CARD_PAD;
  w1 := measure_width(f[0].m, k.label.face, line1); w2 := measure_width(f[0].m, k.small.face, line2);
  pw := (ifx w1 > w2 then w1 else w2) + 2 * pad; if pw > cw { pw = cw; }
  ph := 2 * pad + k.label.line + k.small.line;
  px := x + side - pw; if px < col_x { px = col_x; }
  py := y - ph - k.app.gap_small;
  r := c.chip_radius;
  sheet_over_n(sh, uiskin_shadow(sh[0].over, sh[0].no, px, py, pw, ph, r, k.shadows.menu));
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, r, 1.0f32, th.menu, th.line));
  card := uiframe_semantic(f, "coder.context.card", EL_REGION, line1, px, py, pw, ph, 0, 0);
  elt_value(f[0].rows, card, line2);
  _ := sheet_text(sh, f[0].m, -1, px + pad, py + pad, k.label.line, k.label.face, th.text, app_fit(f, k.label.face, line1, pw - 2 * pad));
  _ := sheet_text(sh, f[0].m, -1, px + pad, py + pad + k.label.line, k.small.line, k.small.face, th.muted, app_fit(f, k.small.face, line2, pw - 2 * pad));
}
// The models' menu, anchored to the model chip at (m_x, foot_y): below the chip when there is room
// (as on a centred new chat, matching Zeron's ModelPicker), else above the composer at box_y.
cp_model_menu :: (s: [] CoderPage, f: [] UiFrame, x: f32, cw: f32, m_x: f32, box_y: f32, foot_y: f32, h: f32) {
  k := f[0].skin; sh := f[0].sheet; th := cp_theme();
  z_ink := th.text; z_sec := th.muted; z_hov := th.hover;
  glass := cp_glass(s);   // the models' menu frosted: a blur of what is behind it (compose.coax)
  pw := 240.0f32;
  if pw > cw { pw = cw; }
  pad := 6.0f32;
  rh := 42.0f32;
  ph := pad * 2 + cast(f32) cp_models(s) * rh;
  px := m_x;
  if px + pw > x + cw { px = x + cw - pw; }
  if px < x { px = x; }
  below_y := foot_y + k.cmp.chip_h + 6.0f32;
  py := ifx below_y + ph <= h - 8.0f32 then below_y else box_y - ph - 6.0f32;
  if py < 8.0f32 { py = 8.0f32; }
  menu_r := 12.0f32;
  // zeron.menu: its shadow (the skin's, 0 20 56), then, frosted, its solid over a blur of what is
  // behind it, at 80% (Zeron's tint sits over macOS's popover frost, which this window has no layer of)
  sheet_over_n(sh, uiskin_shadow(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, k.shadows.menu));
  if glass {
    sheet_over_n(sh, prim_clip(sh[0].over, sh[0].no, px, py, px + pw, py + ph));
    sheet_over_n(sh, prim_backdrop(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, cp_glass_blur(s)));
  }
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px, py, pw, ph, menu_r, 1.0f32, ifx glass then opacity(th.menu, 0.8) else th.menu, th.line));
  card_row := uiframe_semantic(f, "coder.model.menu", EL_REGION, "Models", px, py, pw, ph, 0, 0);
  sheet_hit(sh, UIFRAME_HIT, card_row, 0, px, py, pw, ph);
  mb: [32] u8;
  for mi: 0..<cp_models(s) {
    ry := py + pad + cast(f32) mi * rh;
    mn := el_put(mb[..], 0, "coder.model."); mn = el_put_i(mb[..], mn, mi);
    mid := sheet_pool(sh, cast(string) mb[0..<mn]);
    sel := mi == cp_model_index(s);
    hov := uiframe_hover(f, KEYED_LAZY, mid);   // the wash eases in and out (kit/frame.coax)
    label := cp_model_label(s, mi);
    desc := cp_model_desc(s, mi);
    mrow := uiframe_semantic(f, mid, EL_BUTTON, label, px + pad, ry, pw - 2 * pad, rh, ifx sel then EL_S_CURRENT else 0, CP_MODEL_PICK);
    elt_value(f[0].rows, mrow, desc);
    if hov > 0 || sel {
      fill := ifx sel then rgba_mix(th.menu_selected, z_hov, hov) else opacity(z_hov, hov);
      sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, px + pad, ry + 1.0f32, pw - 2 * pad, rh - 2.0f32, k.cmp.chip_radius, 0, fill, Rgba.{}));
    }
    tx := px + pad + 10.0f32;
    tw := pw - 2 * pad - 34.0f32;
    _ := sheet_text(sh, f[0].m, -1, tx, ry + 4.0f32, k.label.line, k.label.face, z_ink, app_fit(f, k.label.face, label, tw));
    _ := sheet_text(sh, f[0].m, -1, tx, ry + 22.0f32, k.small.line, k.small.face, z_sec, app_fit(f, k.small.face, desc, tw));
    if sel {
      ck := 14.0f32;
      sheet_over_n(sh, prim_icon(sh[0].over, sh[0].no, ICON_CHECK, px + pw - pad - 10.0f32 - ck, ry + (rh - ck) / 2, ck, ck, z_ink));
    }
    sheet_hit(sh, UIFRAME_HIT, mrow, 0, px + pad, ry, pw - 2 * pad, rh);
  }
  if glass { sheet_over_n(sh, prim_unlayer(sh[0].over, sh[0].no)); sheet_over_n(sh, prim_unclip(sh[0].over, sh[0].no)); }
}
