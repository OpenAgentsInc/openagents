// Coder Desktop page (../../page.coax): the chats' sidebar: New chat, the Foreman row, Pinned and
// Recents, the line under them, and its foot (the update pill and the account row).

cp_side_chat_row :: (s: [] CoderPage, f: [] UiFrame, q: int, cur: string, running: bool) -> AppSideRow {
  id := cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n];
  is := !(cp_flag(s, DC_FLAG_GYM) && s[0].gym_open) && cur.count > 0 && id == cur;
  sel := s[0].sb[0].sel[q];
  t_str := cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n];
  if cp_flag(s, DC_FLAG_FOREMAN) && s[0].chats[q].managed {
    tb: [CP_CHAT_TITLE + 8] u8; tn := el_put(tb[..], 0, t_str); tn = el_put(tb[..], tn, " · F");
    t_str = sheet_pool(f[0].sheet, cast(string) tb[0..<tn]);
  }
  if s[0].sb[0].vis_n < CP_CHATS { s[0].sb[0].vis_order[s[0].sb[0].vis_n] = q; s[0].sb[0].vis_n += 1; }
  return AppSideRow.{id = id, title = t_str,
                     state = (ifx is || sel then EL_S_CURRENT else 0) | (ifx (is && running) || s[0].chats[q].busy then EL_S_BUSY else 0),
                     unread = s[0].chats[q].unread && !is,
                     status = ifx sel then "✓" else "",
                     attention = sel};
}

  // the sidebar: Claude Desktop's structural hierarchy (surface separation, top primary action,
  // section header, 32pt rows with 8pt inset/radius) in Coder's monochrome palette.
cp_sidebar :: (s: [] CoderPage, f: [] UiFrame, left: f32, h: f32, running: bool) {
  k := f[0].skin; a := k.app;
  sw := app_sidebar_surface(f, 0, 0, left, h);
  // under the window's title bar, which holds the sidebar's toggle (titlebar.coax)
  sy := cp_bar(s);
  loc := ifx cp_flag(s, DC_FLAG_CUSTOMIZE) then s[0].cust[0].locale.active else CP_LOCALE_EN;
  sy += app_side_action(f, "coder.new", 0, sy, sw, ICON_COMPOSE, cp_tr(loc, "new_chat"), 0, CP_NEW);
  sy += app_side_action(f, "coder.search", 0, sy, sw, ICON_SET_SEARCH, cp_tr(loc, "search"), 0, CP_PALETTE);
  cur := cast(string) s[0].current[0..<s[0].current_n];
  // Flag-gated sidebar destinations: off in the Inkling first release.
  if cp_flag(s, DC_FLAG_FOREMAN) {
    sy += cp_side_foreman(s, f, sw, sy, cur, running);
  }
  if cp_flag(s, DC_FLAG_GYM) {
    sy += app_side_action(f, "coder.gym", 0, sy, sw, ICON_WIDGET, "Gym", ifx s[0].gym_open then EL_S_CURRENT else 0, CP_GYM);
  }
  if cp_flag(s, DC_FLAG_FORGE) {
    sy += app_side_action(f, "coder.forge", 0, sy, sw, ICON_SHARE, "PRs & Issues", ifx cp_forge_shown(s) then EL_S_CURRENT else 0, CP_FORGE_TOGGLE);
  }
  sy += 4.0f32;
  sy += cp_sb_bulk_bar(s, f, sw, sy);
  stop := sy + 2.0f32;
  rows: [CP_CHATS + CP_SB_MAX_GROUPS + 8] AppSideRow;
  nrows := 0;
  s[0].sb[0].vis_n = 0;
  now_ms := s[0].sb[0].now_ms;
  is_arch := s[0].sb[0].view_mode == CP_SB_VIEW_ARCHIVED;
  npinned := ifx is_arch then 0 else cp_pin_count(s);
  has_projects := !is_arch && cp_sb_has_projects(s);
  visible_chats := 0;
  if is_arch {
    rows[nrows] = AppSideRow.{id = "coder.archived", title = "Archived", heading = true};
    nrows += 1;
    for q: 0..<s[0].nchats {
      if !s[0].chats[q].archived { continue; }
      rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
      nrows += 1; visible_chats += 1;
    }
  } else {
    if npinned > 0 {
      rows[nrows] = AppSideRow.{id = "coder.pinned", title = "Pinned", heading = true};
      nrows += 1;
      for q: 0..<s[0].nchats {
        if !s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) { continue; }
        rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
        nrows += 1; visible_chats += 1;
      }
    }
    // Projects section (Antigravity layout): heading with trailing folder-plus button, then folder rows.
    rows[nrows] = AppSideRow.{id = "coder.projects", title = "Projects", heading = true,
                              trail_icon = ICON_FOLDER_ADD,
                              head_btn_id = "coder.sb.add_project",
                              head_btn_label = "Add project",
                              head_btn_action = CP_SB_ADD_PROJECT_ACT};
    nrows += 1;
    if has_projects {
      for g: 0..<s[0].sb[0].nprojects {
        ppath := cast(string) s[0].sb[0].projects[g].path[0..<s[0].sb[0].projects[g].path_n];
        gcount := 0;
        for q: 0..<s[0].nchats {
          if s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) { continue; }
          if cast(string) s[0].chats[q].folder[0..<s[0].chats[q].folder_n] == ppath { gcount += 1; }
        }
        if gcount == 0 && !s[0].sb[0].projects[g].added { continue; }
        pid_b: [32] u8; pn := el_put(pid_b[..], 0, "coder.proj."); pn = el_put_i(pid_b[..], pn, g);
        cnt_s := "";
        if gcount > 0 {
          cnt_b: [16] u8; cn := el_put_i(cnt_b[..], 0, gcount);
          cnt_s = sheet_pool(f[0].sheet, cast(string) cnt_b[0..<cn]);
        }
        collapsed := s[0].sb[0].projects[g].collapsed;
        rows[nrows] = AppSideRow.{id = sheet_pool(f[0].sheet, cast(string) pid_b[0..<pn]),
                                  title = cast(string) s[0].sb[0].projects[g].label[0..<s[0].sb[0].projects[g].label_n],
                                  status = cnt_s,
                                  state = EL_S_EXPANDS | (ifx !collapsed then EL_S_EXPANDED else 0),
                                  icon = ICON_FOLDER,
                                  trail_icon = ifx collapsed then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
                                  action = CP_SB_GROUP_TOGGLE};
        nrows += 1;
        if !collapsed {
          for q: 0..<s[0].nchats {
            if s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) { continue; }
            if cast(string) s[0].chats[q].folder[0..<s[0].chats[q].folder_n] == ppath {
              cr := cp_side_chat_row(s, f, q, cur, running);
              cr.indent = a.icon + a.row_inset;
              cr.tree_line = true;
              rows[nrows] = cr;
              nrows += 1; visible_chats += 1;
            }
          }
        }
      }
      // Active non-pinned chats without a folder go in a trailing General section.
      unassigned := 0;
      for q: 0..<s[0].nchats {
        if !s[0].chats[q].pinned && cp_sb_is_visible_active(s[0].chats[q], now_ms) && s[0].chats[q].folder_n == 0 { unassigned += 1; }
      }
      if unassigned > 0 {
        rows[nrows] = AppSideRow.{id = "coder.chats", title = "General", heading = true};
        nrows += 1;
        for q: 0..<s[0].nchats {
          if !s[0].chats[q].pinned && cp_sb_is_visible_active(s[0].chats[q], now_ms) && s[0].chats[q].folder_n == 0 {
            rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
            nrows += 1; visible_chats += 1;
          }
        }
      }
    } else {
      nrecent := 0;
      for q: 0..<s[0].nchats {
        if !s[0].chats[q].pinned && cp_sb_is_visible_active(s[0].chats[q], now_ms) { nrecent += 1; }
      }
      if nrecent > 0 || s[0].chats_more > 0 {
        rows[nrows] = AppSideRow.{id = "coder.chats", title = "Recents", heading = true};
        nrows += 1;
        for q: 0..<s[0].nchats {
          if s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) { continue; }
          rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
          nrows += 1; visible_chats += 1;
        }
      }
    }
  }
  // the foot: the update pill when there is one, then the unified Settings row
  st := k.set;
  me_h := st.account_top + st.account + st.list_pad;
  footer_h := cp_side_footer_h(s, k);
  if stop + footer_h + me_h > h { footer_h = 0; }
  if stop + me_h > h { me_h = 0; }
  s[0].side_view = h - stop - footer_h - me_h;
  bottom_pad := 16.0f32;
  show_tail := (is_arch && visible_chats == 0) || (!is_arch && visible_chats == 0 && !has_projects) || (!is_arch && s[0].chats_more > 0);
  tail := ifx show_tail then k.small.line + 2 * a.gap + bottom_pad else bottom_pad;
  s[0].side_content = app_side_window_at(f, 0, stop, sw, s[0].side_view, rows[0..<nrows], s[0].side_scroll, s[0].side_scr[0].stretch, tail, CP_CHAT);
  if s[0].cmd_hints && s[0].side_view > 0 {
    at := scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) + s[0].side_scr[0].stretch;
    uiframe_clip(f, 0, stop, sw, stop + s[0].side_view);
    cursor: f32 = 0;
    slot := 0;
    for r: rows[0..<nrows] {
      rh := ifx r.heading then a.side_head else a.side_row;
      ry := stop + cursor - at;
      cursor += rh;
      if r.heading || r.action == CP_SB_GROUP_TOGGLE { continue; }
      slot += 1;
      if slot > 9 { break; }
      if ry + rh <= stop || ry >= stop + s[0].side_view { continue; }
      kb: [4] u8;
      kn := el_put_i(kb[..], 0, slot);
      cp_side_key_badge(f, sw - a.side_pad, ry, rh, sheet_pool(f[0].sheet, cast(string) kb[0..<kn]));
    }
    uiframe_unclip(f);
  }
  app_scroll_rail(f, s[0].side_scr[..], sw, stop, scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view), s[0].side_content, s[0].side_view, s[0].side_view, s[0].now, s[0].reduced);
  s[0].pin_row_h = a.side_row;
  s[0].pin_top = stop + a.side_head - scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) - s[0].side_scr[0].stretch;
  if s[0].pin_dragging && s[0].pin_drag > 0 && npinned > 1 {
    from := cp_pin_index(s, s[0].pin_drag - 1);
    if from >= 0 {
      dy := s[0].pin_top + cast(f32) from * a.side_row;
      if dy + a.side_row > stop && dy < stop + s[0].side_view {
        sheet_fill(f[0].sheet, a.row_inset, dy, sw - 2 * a.row_inset, a.side_row, a.row_radius, opacity(k.hover, 0.6));
      }
      to := s[0].pin_drop;
      if to >= 0 && to < npinned && to != from {
        line_slot := ifx to > from then to + 1 else to;
        ly := s[0].pin_top + cast(f32) line_slot * a.side_row - 1.0f32;
        if ly >= stop && ly <= stop + s[0].side_view {
          sheet_fill(f[0].sheet, a.row_inset, ly, sw - 2 * a.row_inset, 2.0f32, 1.0f32, k.ink);
        }
      }
    }
  }
  // the line under the list: the empty list's hint, or how many older chats are left out; none when every chat shows
  if show_tail {
    mb: [96] u8; mn := 0;
    if is_arch { mn = el_put(mb[..], 0, "No archived chats."); }
    else if visible_chats == 0 { mn = el_put(mb[..], 0, "Your chats show here."); }
    else { mn = el_put_i(mb[..], 0, s[0].chats_more); mn = el_put(mb[..], mn, ifx s[0].chats_more == 1 then " older chat is not shown." else " older chats are not shown."); }
    my := stop + s[0].side_content - tail + a.gap - scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) - s[0].side_scr[0].stretch;
    if my + k.small.line > stop && my < stop + s[0].side_view { _ := app_meta(f, "coder.chats.more", a.side_pad, my, sw - 2 * a.side_pad, sheet_pool(f[0].sheet, cast(string) mb[0..<mn]), false); }
  }
  if footer_h > 0 { cp_side_footer(s, f, 0, h - me_h - footer_h, sw); }
  if me_h > 0 { _ := cp_side_settings_row(f, "coder.me.settings", 0, h - st.list_pad - st.account, sw, st.account, false, CP_SET_TOGGLE); }
}
// Unified bottom-left Settings row (Antigravity style): single gear icon + "Settings" label aligned
// with the sidebar's action/folder rail, linking directly to Settings.
cp_side_settings_row :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, row_h: f32, open: bool, action: int) -> f32 {
  k := f[0].skin; a := k.app; sh := f[0].sheet; m := f[0].m;
  kk := uiframe_key(f, id);
  p := uiframe_press(f, kk, id);
  hv := uiframe_hover(f, kk, id);
  if open { sheet_fill(sh, x + a.row_inset, y, w - 2.0f32 * a.row_inset, row_h, a.row_radius, k.raised); }
  else if hv > 0 { sheet_fill(sh, x + a.row_inset, y, w - 2.0f32 * a.row_inset, row_h, a.row_radius, opacity(k.raised, 0.75f32 * hv)); }
  if p > 0 { sheet_fill(sh, x + a.row_inset, y, w - 2.0f32 * a.row_inset, row_h, a.row_radius, opacity(k.hover, p)); }
  state := EL_S_TOGGLES | (ifx open then EL_S_PRESSED | EL_S_CURRENT else 0);
  row := uiframe_semantic(f, id, EL_BUTTON, "Settings", x, y, w, row_h, state, action);
  tf := ifx a.side_text.line > 0 then a.side_text else k.body;
  tx := x + a.side_pad;
  mark := a.icon;
  ink := ifx open then k.ink else rgba_mix(k.muted, k.ink, hv);
  sheet_icon(sh, ICON_SETTINGS, tx, y + (row_h - mark) / 2.0f32, mark, ink);
  tx += mark + a.row_inset;
  room := x + w - a.side_pad - tx;
  if room > 0 {
    _ := sheet_text(sh, m, -1, tx, y + (row_h - tf.line) / 2.0f32, tf.line, tf.face, ink, app_fit(f, tf.face, "Settings", room));
  }
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, row_h);
  return row_h;
}
// The Foreman row at the sidebar's top, above Pinned and Recents, sw wide at sy: its tier, or how many
// managed chats run. Returns its height.
cp_side_foreman :: (s: [] CoderPage, f: [] UiFrame, sw: f32, sy: f32, cur: string, running: bool) -> f32 {
  k := f[0].skin; a := k.app;
  f_cur := !s[0].gym_open && cur == "chat.foreman";
  f_busy := s[0].foreman_busy || (f_cur && running);
  f_state := (ifx f_cur then EL_S_CURRENT else 0) | (ifx f_busy then EL_S_BUSY else 0);
  fh := a.side_row;
  fk := uiframe_key(f, "coder.foreman");
  fp := uiframe_press(f, fk, "coder.foreman");
  fhov := uiframe_hover(f, fk, "coder.foreman");   // the wash eases in and out (kit/frame.coax)
  if f_cur { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, k.raised); }
  else if fhov > 0 { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, opacity(k.raised, 0.75 * fhov)); }
  if fp > 0 { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, opacity(k.hover, fp)); }
  frow := uiframe_semantic(f, "coder.foreman", EL_BUTTON, "Foreman", 0, sy, sw, fh, f_state, CP_FOREMAN);
  tf := a.side_text;
  tx := a.side_pad;
  mark := a.icon;
  sheet_icon(f[0].sheet, ICON_BOT, tx, sy + (fh - mark) / 2, mark, ifx f_cur then k.ink else rgba_mix(k.muted, k.ink, fhov));
  tx += mark + a.row_inset;
  managed_busy := 0;
  for q: 0..<s[0].nchats {
    if s[0].chats[q].managed && s[0].chats[q].busy { managed_busy += 1; }
  }
  tier_base := ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then "Observe" else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then "Auto" else "Managed";
  tb_lbl: [32] u8;
  tier_lbl := tier_base;
  if managed_busy > 0 {
    tn := el_put_i(tb_lbl[..], 0, managed_busy);
    tn = el_put(tb_lbl[..], tn, " · ");
    tn = el_put(tb_lbl[..], tn, tier_base);
    tier_lbl = sheet_pool(f[0].sheet, cast(string) tb_lbl[0..<tn]);
  }
  badge_w := ifx f_busy then a.icon + a.gap else measure_width(f[0].m, k.small.face, tier_lbl) + a.gap;
  froom := sw - a.side_pad - tx - badge_w;
  if froom > 0 { _ := sheet_text(f[0].sheet, f[0].m, -1, tx, sy + (fh - tf.line) / 2, tf.line, tf.face, k.ink, app_fit(f, tf.face, "Foreman", froom)); }
  if f_busy {
    activity(f[0].sheet, k, sw - a.side_pad - a.icon, sy + (fh - a.icon) / 2, a.icon, f[0].clock, f[0].reduced_motion);
  } else {
    tw := measure_width(f[0].m, k.small.face, tier_lbl);
    _ := sheet_text(f[0].sheet, f[0].m, -1, sw - a.side_pad - tw, sy + (fh - k.small.line) / 2, k.small.line, k.small.face, ifx managed_busy > 0 then k.muted else k.faint, tier_lbl);
  }
  if s[0].cmd_hints {
    cp_side_key_badge(f, sw - a.side_pad, sy, fh, "`");
  }
  sheet_hit(f[0].sheet, UIFRAME_HIT, frow, 0, 0, sy, sw, fh);
  return fh;
}
// Subtle floating keycap badge on the right side of a sidebar row while Command is held (>1s).
cp_side_key_badge :: (f: [] UiFrame, right: f32, y: f32, row_h: f32, key: string) {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  bh := 18.0f32;
  pad := 5.0f32;
  tw := measure_width(m, k.small.face, key);
  bw := ceil(tw) + 2.0f32 * pad;
  if bw < bh { bw = bh; }
  bx := right - bw;
  by := y + (row_h - bh) / 2.0f32;
  // Paint the pill in `over` so it floats cleanly above any long chat title or tier label.
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, bx, by, bw, bh, 5.0f32, k.border, k.surface, k.field_edge));
  _ := sheet_text(sh, m, -1, bx + (bw - tw) / 2.0f32, by + (bh - k.small.line) / 2.0f32, k.small.line, k.small.face, k.ink, key);
}

// Bottom-of-sidebar desktop auto-updater pill (hidden when no update is active).
cp_side_footer_h :: (s: [] CoderPage, k: UiSkin) -> f32 {
  if s.count < 1 || s[0].update_state == CP_UPD_HIDDEN { return 0.0f32; }
  pad_v := 10.0f32;
  return k.border + pad_v + k.cmp.chip_h + pad_v;
}
cp_side_pill :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, icon: int, label: string, detail: string, action: int, highlighted: bool) {
  k := f[0].skin; c := k.cmp; sh := f[0].sheet; m := f[0].m;
  h := c.chip_h; r := h / 2.0f32;
  hv := uiframe_hover_on(f, KEYED_LAZY, id, action != 0 && uiframe_hovered(f, id));
  row := uiframe_semantic(f, id, EL_BUTTON, label, x, y, w, h, 0, action);
  elt_value(f[0].rows, row, detail);
  bg := rgba_mix(k.raised, k.hover, hv);
  border := ifx highlighted then k.accent else k.hairline;
  _ := sheet_box(sh, x, y, w, h, r, k.border, bg, border);
  ink := ifx highlighted then k.ink else rgba_mix(k.muted, k.ink, hv);
  icon_ink := ifx highlighted then k.accent else ink;
  pad := 10.0f32;
  tx := x + pad;
  if icon >= 0 {
    sheet_icon(sh, icon, tx, y + (h - c.chip_icon) / 2.0f32, c.chip_icon, icon_ink);
    tx += c.chip_icon + c.chip_gap;
  }
  right := x + w - pad;
  if detail.count > 0 {
    dw := measure_width(m, k.label.face, detail);
    if right - dw > tx + c.chip_gap {
      _ := sheet_text(sh, m, -1, right - dw, y + (h - k.label.line) / 2.0f32, k.label.line, k.label.face, k.faint, detail);
      right -= dw + c.chip_gap;
    }
  }
  room := right - tx;
  if room > 0 {
    _ := sheet_text(sh, m, -1, tx, y + (h - k.small.line) / 2.0f32, k.small.line, k.small.face, ink, app_fit(f, k.small.face, label, room));
  }
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, h);
}
cp_side_footer :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32) {
  if s.count < 1 || s[0].update_state == CP_UPD_HIDDEN { return; }
  k := f[0].skin; a := k.app;
  pad_v := 10.0f32;
  sheet_fill(f[0].sheet, x, y, w, k.border, 0, k.menu_divider);
  px := x + a.row_inset;
  pw := w - 2.0f32 * a.row_inset;
  if pw <= 0 { return; }
  py := y + k.border + pad_v;
  st := s[0].update_state;
  icon := ICON_ARROW_UP;
  def_label := "Update available";
  action := CP_UPDATE;
  highlighted := false;
  if st == CP_UPD_AVAILABLE { highlighted = true; }
  else if st == CP_UPD_DOWNLOADING { def_label = "Updating…"; action = 0; }
  else if st == CP_UPD_READY { icon = ICON_CHECK; def_label = "Restart to update"; highlighted = true; }
  else if st == CP_UPD_ERROR { icon = ICON_DANGER; def_label = "Update failed"; }
  label := ifx s[0].update_label_n > 0 then sheet_pool(f[0].sheet, cast(string) s[0].update_label[0..<s[0].update_label_n]) else def_label;
  detail := ifx s[0].update_detail_n > 0 then sheet_pool(f[0].sheet, cast(string) s[0].update_detail[0..<s[0].update_detail_n]) else "";
  cp_side_pill(f, "coder.side.pill.update", px, py, pw, icon, label, detail, action, highlighted);
}
