// Coder Desktop page (../../page.coax): the chats' sidebar: New chat, the Foreman row, Pinned and
// Recents, the line under them, and its foot (the update pill and the account row).

cp_side_chat_row :: (s: [] CoderPage, f: [] UiFrame, q: int, cur: string, running: bool) -> AppSideRow {
  id := cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n];
  is := !(cp_flag(s, DC_FLAG_GYM) && s[0].gym_open) && cur.count > 0 && id == cur;
  sel := s[0].sb[0].sel[q];
  t_str := cast(string) s[0].chats[q].title[0..<s[0].chats[q].title_n];
  if cp_flag(s, DC_FLAG_FOREMAN) && s[0].chats[q].managed {
    tb: [CP_CHAT_TITLE + 8] u8; tn := el_put(tb[..], 0, t_str); tn = el_put(tb[..], tn, " · F");
    t_str = sheet_pool(f[0].sheet, cast(string) tb[0..<tn]);
  }
  rb: [64] u8; rn := ifx s[0].chats[q].folder_n > 0 then cp_sb_folder_label(cast(string) s[0].chats[q].folder[0..<s[0].chats[q].folder_n], rb[..]) else 0;
  repo_str := ifx rn > 0 then sheet_pool(f[0].sheet, cast(string) rb[0..<rn]) else "";
  br_str := ifx s[0].chats[q].branch_n > 0 then cast(string) s[0].chats[q].branch[0..<s[0].chats[q].branch_n] else "";
  st_str := "";
  if sel {
    st_str = "✓";
  } else if s[0].chats[q].updated_ms > 0 && s[0].sb[0].now_ms > 0 {
    ab: [12] u8;
    age := app_side_age(s[0].sb[0].now_ms, s[0].chats[q].updated_ms, ab[..]);
    if age.count > 0 { st_str = sheet_pool(f[0].sheet, age); }
  }
  h_icon := ifx s[0].chats[q].harness >= 0 then s[0].chats[q].harness else ICON_PSIONIC;
  skind := APP_SIDE_STATUS_NONE;
  if is {
    if s[0].permit[0].open {
      skind = ifx s[0].permit[0].question then APP_SIDE_STATUS_INPUT else APP_SIDE_STATUS_APPROVAL;
    } else if s[0].nturns > 0 && s[0].turns[s[0].nturns - 1].state == CP_FAILED {
      skind = APP_SIDE_STATUS_FAILED;
    }
  }
  if s[0].sb[0].vis_n < CP_CHATS { s[0].sb[0].vis_order[s[0].sb[0].vis_n] = q; s[0].sb[0].vis_n += 1; }
  return AppSideRow.{id = id, title = t_str,
                     state = (ifx is then EL_S_CURRENT else 0) | (ifx (is && running) || s[0].chats[q].busy then EL_S_BUSY else 0),
                     unread = s[0].chats[q].unread && !is,
                     status = st_str,
                     attention = sel,
                     icon = ifx rn > 0 then ICON_FOLDER_11 else -1,
                     card = true,
                     repo = repo_str,
                     branch = br_str,
                     harness_icon = h_icon,
                     status_kind = skind,
                     selected = sel};
}

// One physical device pixel in page units (1pt fallback when s[0].d is unset in headless checks).
cp_px :: (s: [] CoderPage) -> f32 {
  return ifx s.count > 0 && s[0].d > 0.0f32 then 1.0f32 / s[0].d else 1.0f32;
}
// Crisp single-physical-pixel vertical border whose right edge aligns with edge_x.
// Returns the usable x left of the border so sidebar content never overlaps it.
cp_side_border :: (s: [] CoderPage, sh: [] Sheet, edge_x: f32, y: f32, h: f32, color: Rgba) -> f32 {
  d := ifx s.count > 0 && s[0].d > 0.0f32 then s[0].d else 1.0f32;
  ex := snap(edge_x, d);
  x0 := (ex - 1.0f32) / d;
  if x0 < 0.0f32 { x0 = 0.0f32; }
  x1 := ex / d;
  if x1 > x0 && h > 0.0f32 { sheet_fill(sh, x0, y, x1 - x0, h, 0, color); }
  return x0;
}
// Crisp single-physical-pixel vertical border whose left edge aligns with edge_x (for right-side panes).
cp_side_border_left :: (s: [] CoderPage, sh: [] Sheet, edge_x: f32, y: f32, h: f32, color: Rgba) {
  d := ifx s.count > 0 && s[0].d > 0.0f32 then s[0].d else 1.0f32;
  ex := snap(edge_x, d);
  x0 := ex / d;
  x1 := (ex + 1.0f32) / d;
  if x1 > x0 && h > 0.0f32 { sheet_fill(sh, x0, y, x1 - x0, h, 0, color); }
}

// Primary sidebar action row with trailing macOS keycap chips (e.g. ⌘ N for New chat).
cp_side_action_keys :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, icon: int, title: string, key: string, state: int, action: int) -> f32 {
  k := f[0].skin; a := k.app; t := k.set; sh := f[0].sheet; m := f[0].m;
  off := (state & EL_S_DISABLED) != 0;
  h := a.side_row;
  kk := uiframe_key(f, id);
  p := ifx off then 0.0f32 else uiframe_press(f, kk, id);
  hv := ifx off then 0.0f32 else uiframe_hover(f, kk, id);
  if hv > 0 { sheet_fill(sh, x + a.row_inset, y, w - 2.0f32 * a.row_inset, h, a.row_radius, opacity(k.raised, 0.75f32 * hv)); }
  if p > 0 { sheet_fill(sh, x + a.row_inset, y, w - 2.0f32 * a.row_inset, h, a.row_radius, opacity(k.hover, p)); }
  row := uiframe_semantic(f, id, EL_BUTTON, title, x, y, w, h, state, ifx off then 0 else action);
  tf := ifx a.side_text.line > 0 then a.side_text else k.body;
  ink := ifx off then k.faint else k.ink;
  tx := x + a.side_pad;
  if icon >= 0 {
    mark := a.icon;
    sheet_icon(sh, icon, tx, y + (h - mark) / 2.0f32, mark, ifx off then k.faint else rgba_mix(k.muted, k.ink, hv));
    tx += mark + a.row_inset;
  }
  right := x + w - a.side_pad;
  if key.count > 0 && t.key_h > 0.0f32 {
    kw2 := ceil(measure_width(m, t.head_face, key)) + 2.0f32 * t.key_pad;
    if kw2 < t.key_h { kw2 = t.key_h; }
    kw1 := t.key_icon + 2.0f32 * t.key_pad;
    if kw1 < t.key_h { kw1 = t.key_h; }
    caps_w := kw1 + t.key_gap + kw2;
    if right - caps_w - a.gap > tx + 24.0f32 {
      ky := y + (h - t.key_h) / 2.0f32;
      key_ink := rgba_mix(t.tertiary, k.muted, hv);
      cx := right - kw2;
      sheet_fill(sh, cx, ky, kw2, t.key_h, t.key_radius, t.well);
      tw2 := measure_width(m, t.head_face, key);
      _ := sheet_text(sh, m, -1, cx + (kw2 - tw2) / 2.0f32, y + (h - t.head_line) / 2.0f32, t.head_line, t.head_face, key_ink, key);
      cx -= t.key_gap + kw1;
      sheet_fill(sh, cx, ky, kw1, t.key_h, t.key_radius, t.well);
      sheet_icon(sh, ICON_SET_COMMAND, cx + (kw1 - t.key_icon) / 2.0f32, y + (h - t.key_icon) / 2.0f32, t.key_icon, key_ink);
      right = cx - a.gap;
    }
  }
  room := right - tx;
  if room > 0 { _ := sheet_text(sh, m, -1, tx, y + (h - tf.line) / 2.0f32, tf.line, tf.face, ink, app_fit(f, tf.face, title, room)); }
  if !off { sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, h); }
  return h;
}

  // the sidebar: pure black surface with a tiny single-pixel dark gray right border.
cp_sidebar :: (s: [] CoderPage, f: [] UiFrame, left: f32, h: f32, running: bool) {
  k := f[0].skin; a := k.app; sh := f[0].sheet;
  bg := ifx k.sidebar.a > 0 then k.sidebar else k.surface;
  edge_c := ifx s[0].hover == 1 || s[0].drag == 1 then k.set.strong else k.menu_divider;
  d := ifx s.count > 0 && s[0].d > 0.0f32 then s[0].d else 1.0f32;
  sw := (snap(left, d) - 1.0f32) / d;
  if sw < 0.0f32 { sw = 0.0f32; }
  if sw > 0.0f32 && h > 0.0f32 { sheet_fill(sh, 0, 0, sw, h, 0, bg); }
  _ := cp_side_border(s, sh, left, 0, h, edge_c);
  // under the window's title bar, which holds the sidebar's toggle (titlebar.coax)
  sy := cp_bar(s);
  loc := ifx cp_flag(s, DC_FLAG_CUSTOMIZE) then s[0].cust[0].locale.active else CP_LOCALE_EN;
  sy += cp_side_action_keys(f, "coder.new", 0, sy, sw, ICON_COMPOSE, cp_tr(loc, "new_chat"), "N", 0, CP_NEW);
  cur := cast(string) s[0].current[0..<s[0].current_n];
  // Flag-gated sidebar destinations: Foreman stays at top; Gym and PRs & Issues live in the icon-only footer bar.
  if cp_flag(s, DC_FLAG_FOREMAN) {
    sy += cp_side_foreman(s, f, sw, sy, cur, running);
  }
  sy += 4.0f32;
  sy += cp_sb_bulk_bar(s, f, sw, sy);
  stop := sy + 2.0f32;
  rows: [CP_CHATS + 12] AppSideRow;
  nrows := 0;
  s[0].sb[0].vis_n = 0;
  now_ms := s[0].sb[0].now_ms;
  is_arch := s[0].sb[0].view_mode == CP_SB_VIEW_ARCHIVED;
  nworking := ifx is_arch then 0 else cp_sb_working_count(s, cur, running);
  npinned := 0;
  if !is_arch {
    for q: 0..<s[0].nchats {
      if s[0].chats[q].pinned && cp_sb_is_visible_active(s[0].chats[q], now_ms) && !cp_sb_is_working(s, q, cur, running) { npinned += 1; }
    }
  }
  visible_chats := 0;
  hidden_chats := 0;
  limit := cp_sb_chat_limit(s);
  pin_start_y := a.side_head;
  if is_arch {
    rows[nrows] = AppSideRow.{id = "coder.archived", title = "Archived", heading = true};
    nrows += 1;
    for q: 0..<s[0].nchats {
      if !s[0].chats[q].archived { continue; }
      if visible_chats >= limit { hidden_chats += 1; continue; }
      rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
      nrows += 1; visible_chats += 1;
    }
  } else {
    // Working section (default-on, T3 Code Working shelf): in-progress chats move here until they
    // need user input/permission or finish, so sending off threads clears the main list.
    if nworking > 0 {
      w_collapsed := s[0].sb[0].working_collapsed;
      wcnt_b: [16] u8; wcn := el_put_i(wcnt_b[..], 0, nworking);
      rows[nrows] = AppSideRow.{id = "coder.working",
                                title = "Working",
                                status = sheet_pool(f[0].sheet, cast(string) wcnt_b[0..<wcn]),
                                state = EL_S_EXPANDS | (ifx !w_collapsed then EL_S_EXPANDED else 0) | EL_S_BUSY,
                                trail_icon = ifx w_collapsed then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
                                action = CP_SB_WORKING_TOGGLE};
      nrows += 1;
      if !w_collapsed {
        for q: 0..<s[0].nchats {
          if !cp_sb_is_working(s, q, cur, running) { continue; }
          if visible_chats >= limit { hidden_chats += 1; continue; }
          rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
          nrows += 1; visible_chats += 1;
        }
      }
    }
    if npinned > 0 {
      if visible_chats < limit {
        pin_start_y = app_side_content(f, rows[0..<nrows]) + a.side_head;
        rows[nrows] = AppSideRow.{id = "coder.pinned", title = "Pinned", heading = true};
        nrows += 1;
      }
      for q: 0..<s[0].nchats {
        if !s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) || cp_sb_is_working(s, q, cur, running) { continue; }
        if visible_chats >= limit { hidden_chats += 1; continue; }
        rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
        nrows += 1; visible_chats += 1;
      }
    }
    // Single chronological list of all active chats, most recent message first.
    nrecent := 0;
    for q: 0..<s[0].nchats {
      if !s[0].chats[q].pinned && cp_sb_is_visible_active(s[0].chats[q], now_ms) && !cp_sb_is_working(s, q, cur, running) { nrecent += 1; }
    }
    if nrecent > 0 || s[0].chats_more > 0 {
      if visible_chats < limit || (nrecent == 0 && s[0].chats_more > 0) {
        rows[nrows] = AppSideRow.{id = "coder.chats", title = "Recents", heading = true};
        nrows += 1;
      }
      for q: 0..<s[0].nchats {
        if s[0].chats[q].pinned || !cp_sb_is_visible_active(s[0].chats[q], now_ms) || cp_sb_is_working(s, q, cur, running) { continue; }
        if visible_chats >= limit { hidden_chats += 1; continue; }
        rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
        nrows += 1; visible_chats += 1;
      }
    }
    // Collapsible Snoozed shelf (only shown when nsnoozed > 0 so no snoozed chat is ever unreachable; #14025).
    nsnoozed := cp_sb_snoozed_count(s);
    if nsnoozed > 0 && nrows < rows.count {
      s_collapsed := s[0].sb[0].snoozed_collapsed;
      scnt_b: [16] u8; scn := el_put_i(scnt_b[..], 0, nsnoozed);
      rows[nrows] = AppSideRow.{id = "coder.snoozed",
                                title = "Snoozed",
                                status = sheet_pool(f[0].sheet, cast(string) scnt_b[0..<scn]),
                                state = EL_S_EXPANDS | (ifx !s_collapsed then EL_S_EXPANDED else 0),
                                trail_icon = ifx s_collapsed then ICON_CHEVRON_RIGHT else ICON_CHEVRON,
                                action = CP_SB_SNOOZED_TOGGLE};
      nrows += 1;
      if !s_collapsed {
        for q: 0..<s[0].nchats {
          if nrows >= rows.count { break; }
          if s[0].chats[q].archived || !cp_sb_is_snoozed(s[0].chats[q], now_ms) { continue; }
          rows[nrows] = cp_side_chat_row(s, f, q, cur, running);
          nrows += 1;
        }
      }
    }
  }
  // ShiftGuard (#14025): detect involuntary sidebar row-order shifts (e.g. a chat moving into/out of Working)
  // and arm a 500ms misclick swallow window unless suppressed by an intentional sidebar control action.
  sh_h := (s[0].sb[0].vis_n * 31 + nworking * 7 + 17) & 0x3FFFFFF;
  for i: 0..<s[0].sb[0].vis_n {
    q := s[0].sb[0].vis_order[i];
    sh_h = (sh_h * 131 + q + 1) & 0x3FFFFFF;
    if q >= 0 && q < s[0].nchats {
      for b: 0..<s[0].chats[q].id_n {
        sh_h = (sh_h * 31 + cast(int) s[0].chats[q].id[b]) & 0x3FFFFFF;
      }
    }
  }
  if s[0].sb[0].shift_init && sh_h != s[0].sb[0].shift_hash && !s[0].sb[0].shift_suppress && s[0].clock > 0.0f32 {
    s[0].sb[0].shift_until = s[0].clock + CP_SB_SHIFT_GUARD_S;
  }
  s[0].sb[0].shift_hash = sh_h;
  s[0].sb[0].shift_init = true;
  s[0].sb[0].shift_suppress = false;
  if hidden_chats > 0 {
    lmb: [24] u8;
    lmn := el_put_i(lmb[..], 0, hidden_chats);
    lmn = el_put(lmb[..], lmn, " more");
    rows[nrows] = AppSideRow.{id = "coder.sb.load_more",
                              title = "Load more",
                              status = sheet_pool(f[0].sheet, cast(string) lmb[0..<lmn]),
                              action = CP_SB_LOAD_MORE_ACT};
    nrows += 1;
  }
  // the foot: the update pill when there is one, then the unified Settings row
  st := k.set;
  me_h := st.account_top + st.account + st.list_pad;
  footer_h := cp_side_footer_h(s, k);
  if stop + footer_h + me_h > h { footer_h = 0; }
  if stop + me_h > h { me_h = 0; }
  s[0].side_view = h - stop - footer_h - me_h;
  bottom_pad := 16.0f32;
  show_tail := (is_arch && visible_chats == 0) || (!is_arch && visible_chats == 0 && nworking == 0) || (!is_arch && s[0].chats_more > 0);
  tail := ifx show_tail then k.small.line + 2 * a.gap + bottom_pad else bottom_pad;
  s[0].side_content = app_side_window_at(f, 0, stop, sw, s[0].side_view, rows[0..<nrows], s[0].side_scroll, s[0].side_scr[0].stretch, tail, CP_CHAT);
  if s[0].cmd_hints && s[0].side_view > 0 {
    at := scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) + s[0].side_scr[0].stretch;
    uiframe_clip(f, 0, stop, sw, stop + s[0].side_view);
    cursor: f32 = 0;
    slot := 0;
    for r: rows[0..<nrows] {
      rh := app_side_height(f, r);
      ry := stop + cursor - at;
      cursor += rh;
      if r.heading || r.action == CP_SB_WORKING_TOGGLE || r.action == CP_SB_LOAD_MORE_ACT { continue; }
      slot += 1;
      if slot > 9 { break; }
      if ry + rh <= stop || ry >= stop + s[0].side_view { continue; }
      kb: [4] u8;
      kn := el_put_i(kb[..], 0, slot);
      cp_side_key_badge(f, sw - a.side_pad, ry, rh, sheet_pool(f[0].sheet, cast(string) kb[0..<kn]));
    }
    uiframe_unclip(f);
  }
  app_scroll_rail(f, s[0].side_scr[..], sw, stop, scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view), s[0].side_content, s[0].side_view, s[0].side_view, s[0].now, s[0].reduced);
  s[0].pin_row_h = APP_SIDE_CARD_H;
  s[0].pin_top = stop + pin_start_y - scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) - s[0].side_scr[0].stretch;
  if s[0].pin_dragging && s[0].pin_drag > 0 && npinned > 1 {
    from := cp_pin_index(s, s[0].pin_drag - 1);
    if from >= 0 {
      dy := s[0].pin_top + cast(f32) from * s[0].pin_row_h;
      if dy + s[0].pin_row_h > stop && dy < stop + s[0].side_view {
        sheet_fill(f[0].sheet, a.row_inset, dy, sw - 2 * a.row_inset, s[0].pin_row_h, a.row_radius, opacity(k.hover, 0.6));
      }
      to := s[0].pin_drop;
      if to >= 0 && to < npinned && to != from {
        line_slot := ifx to > from then to + 1 else to;
        ly := s[0].pin_top + cast(f32) line_slot * s[0].pin_row_h - 1.0f32;
        if ly >= stop && ly <= stop + s[0].side_view {
          sheet_fill(f[0].sheet, a.row_inset, ly, sw - 2 * a.row_inset, 2.0f32, 1.0f32, k.ink);
        }
      }
    }
  }
  // the line under the list: the empty list's hint, or how many older chats are left out; none when every chat shows
  if show_tail {
    mb: [96] u8; mn := 0;
    if is_arch { mn = el_put(mb[..], 0, "No archived chats."); }
    else if visible_chats == 0 { mn = el_put(mb[..], 0, "Your chats show here."); }
    else { mn = el_put_i(mb[..], 0, s[0].chats_more); mn = el_put(mb[..], mn, ifx s[0].chats_more == 1 then " older chat is not shown." else " older chats are not shown."); }
    my := stop + s[0].side_content - tail + a.gap - scroll_clamp(s[0].side_scroll, s[0].side_content, s[0].side_view) - s[0].side_scr[0].stretch;
    if my + k.small.line > stop && my < stop + s[0].side_view { _ := app_meta(f, "coder.chats.more", a.side_pad, my, sw - 2 * a.side_pad, sheet_pool(f[0].sheet, cast(string) mb[0..<mn]), false); }
  }
  if footer_h > 0 { cp_side_footer(s, f, 0, h - me_h - footer_h, sw); }
  if me_h > 0 { _ := cp_side_utility_bar(s, f, 0, h - st.list_pad - st.account, sw, st.account); }
}
// Quiet icon-only utility button for the sidebar footer (T3 Code SidebarUtilityMenu style: 28x28pt, no text label).
cp_side_icon_btn :: (f: [] UiFrame, id: string, label: string, x: f32, y: f32, side: f32, icon: int, active: bool, action: int) -> f32 {
  k := f[0].skin; a := k.app; sh := f[0].sheet;
  kk := uiframe_key(f, id);
  p := uiframe_press(f, kk, id);
  hv := uiframe_hover(f, kk, id);
  r := 6.0f32;
  if active { sheet_fill(sh, x, y, side, side, r, k.raised); }
  else if hv > 0 { sheet_fill(sh, x, y, side, side, r, opacity(k.raised, 0.85f32 * hv)); }
  if p > 0 { sheet_fill(sh, x, y, side, side, r, opacity(k.hover, p)); }
  state := EL_S_TOGGLES | (ifx active then EL_S_PRESSED | EL_S_CURRENT else 0);
  row := uiframe_semantic(f, id, EL_BUTTON, label, x, y, side, side, state, action);
  mark := a.icon;
  ink := ifx active then k.ink else rgba_mix(k.muted, k.ink, hv);
  sheet_icon(sh, icon, x + (side - mark) / 2.0f32, y + (side - mark) / 2.0f32, mark, ink);
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, side, side);
  return side;
}
// Icon-only Settings button (also used by settings.coax's sidebar footer).
cp_side_settings_row :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, row_h: f32, open: bool, action: int) -> f32 {
  k := f[0].skin; a := k.app;
  sheet_fill(f[0].sheet, x, y - 4.0f32, w, 1.0f32, 0, k.hairline);
  side := ifx row_h < 28.0f32 then row_h else 28.0f32;
  _ := cp_side_icon_btn(f, id, "Settings", x + a.row_inset, y + (row_h - side) / 2.0f32, side, ICON_SETTINGS, open, action);
  return row_h;
}
// T3 Code-style horizontal icon-only sidebar footer bar: Settings, Archived toggle, and flag-gated PRs/Issues & Gym.
cp_side_utility_bar :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32, row_h: f32) -> f32 {
  k := f[0].skin; a := k.app;
  sheet_fill(f[0].sheet, x, y - 4.0f32, w, cp_px(s), 0, k.hairline);
  side := ifx row_h < 28.0f32 then row_h else 28.0f32;
  by := y + (row_h - side) / 2.0f32;
  bx := x + a.row_inset;
  gap := 4.0f32;
  bx += cp_side_icon_btn(f, "coder.me.settings", "Settings", bx, by, side, ICON_SETTINGS, false, CP_SET_TOGGLE) + gap;
  is_arch := s[0].sb[0].view_mode == CP_SB_VIEW_ARCHIVED;
  if bx + side <= x + w - a.row_inset {
    bx += cp_side_icon_btn(f, "coder.sb.archived", ifx is_arch then "Active chats" else "Archived chats", bx, by, side, ICON_ARCHIVE, is_arch, ifx is_arch then CP_SB_VIEW_ACTIVE_ACT else CP_SB_VIEW_ARCHIVED_ACT) + gap;
  }
  if cp_flag(s, DC_FLAG_FORGE) && bx + side <= x + w - a.row_inset {
    bx += cp_side_icon_btn(f, "coder.forge", "PRs & Issues", bx, by, side, ICON_SHARE, cp_forge_shown(s), CP_FORGE_TOGGLE) + gap;
  }
  if cp_flag(s, DC_FLAG_GYM) && bx + side <= x + w - a.row_inset {
    bx += cp_side_icon_btn(f, "coder.gym", "Gym", bx, by, side, ICON_WIDGET, s[0].gym_open, CP_GYM) + gap;
  }
  return row_h;
}
// The Foreman row at the sidebar's top, above Pinned and Recents, sw wide at sy: its tier, or how many
// managed chats run. Returns its height.
cp_side_foreman :: (s: [] CoderPage, f: [] UiFrame, sw: f32, sy: f32, cur: string, running: bool) -> f32 {
  k := f[0].skin; a := k.app;
  f_cur := !s[0].gym_open && cur == "chat.foreman";
  f_busy := s[0].foreman_busy || (f_cur && running);
  f_state := (ifx f_cur then EL_S_CURRENT else 0) | (ifx f_busy then EL_S_BUSY else 0);
  fh := a.side_row;
  fk := uiframe_key(f, "coder.foreman");
  fp := uiframe_press(f, fk, "coder.foreman");
  fhov := uiframe_hover(f, fk, "coder.foreman");   // the wash eases in and out (kit/frame.coax)
  if f_cur { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, k.raised); }
  else if fhov > 0 { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, opacity(k.raised, 0.75 * fhov)); }
  if fp > 0 { sheet_fill(f[0].sheet, a.row_inset, sy, sw - 2 * a.row_inset, fh, a.row_radius, opacity(k.hover, fp)); }
  frow := uiframe_semantic(f, "coder.foreman", EL_BUTTON, "Foreman", 0, sy, sw, fh, f_state, CP_FOREMAN);
  tf := a.side_text;
  tx := a.side_pad;
  mark := a.icon;
  sheet_icon(f[0].sheet, ICON_BOT, tx, sy + (fh - mark) / 2, mark, ifx f_cur then k.ink else rgba_mix(k.muted, k.ink, fhov));
  tx += mark + a.row_inset;
  managed_busy := 0;
  for q: 0..<s[0].nchats {
    if s[0].chats[q].managed && s[0].chats[q].busy { managed_busy += 1; }
  }
  tier_base := ifx s[0].foreman_tier == CP_FOREMAN_TIER_OBSERVE then "Observe" else ifx s[0].foreman_tier == CP_FOREMAN_TIER_AUTO then "Auto" else "Managed";
  tb_lbl: [32] u8;
  tier_lbl := tier_base;
  if managed_busy > 0 {
    tn := el_put_i(tb_lbl[..], 0, managed_busy);
    tn = el_put(tb_lbl[..], tn, " · ");
    tn = el_put(tb_lbl[..], tn, tier_base);
    tier_lbl = sheet_pool(f[0].sheet, cast(string) tb_lbl[0..<tn]);
  }
  badge_w := ifx f_busy then a.icon + a.gap else measure_width(f[0].m, k.small.face, tier_lbl) + a.gap;
  froom := sw - a.side_pad - tx - badge_w;
  if froom > 0 { _ := sheet_text(f[0].sheet, f[0].m, -1, tx, sy + (fh - tf.line) / 2, tf.line, tf.face, k.ink, app_fit(f, tf.face, "Foreman", froom)); }
  if f_busy {
    activity(f[0].sheet, k, sw - a.side_pad - a.icon, sy + (fh - a.icon) / 2, a.icon, f[0].clock, f[0].reduced_motion);
  } else {
    tw := measure_width(f[0].m, k.small.face, tier_lbl);
    _ := sheet_text(f[0].sheet, f[0].m, -1, sw - a.side_pad - tw, sy + (fh - k.small.line) / 2, k.small.line, k.small.face, ifx managed_busy > 0 then k.muted else k.faint, tier_lbl);
  }
  if s[0].cmd_hints {
    cp_side_key_badge(f, sw - a.side_pad, sy, fh, "`");
  }
  sheet_hit(f[0].sheet, UIFRAME_HIT, frow, 0, 0, sy, sw, fh);
  return fh;
}
// Subtle floating keycap badge on the right side of a sidebar row while Command is held (>1s).
cp_side_key_badge :: (f: [] UiFrame, right: f32, y: f32, row_h: f32, key: string) {
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  bh := 18.0f32;
  pad := 5.0f32;
  tw := measure_width(m, k.small.face, key);
  bw := ceil(tw) + 2.0f32 * pad;
  if bw < bh { bw = bh; }
  bx := right - bw;
  by := y + (row_h - bh) / 2.0f32;
  // Paint the pill in `over` so it floats cleanly above any long chat title or tier label.
  sheet_over_n(sh, prim_box(sh[0].over, sh[0].no, bx, by, bw, bh, 5.0f32, k.border, k.surface, k.field_edge));
  _ := sheet_text(sh, m, -1, bx + (bw - tw) / 2.0f32, by + (bh - k.small.line) / 2.0f32, k.small.line, k.small.face, k.ink, key);
}

// Bottom-of-sidebar desktop auto-updater pill (hidden when no update is active).
cp_side_footer_h :: (s: [] CoderPage, k: UiSkin) -> f32 {
  if s.count < 1 || s[0].update_state == CP_UPD_HIDDEN { return 0.0f32; }
  pad_v := 10.0f32;
  return k.border + pad_v + k.cmp.chip_h + pad_v;
}
cp_side_pill :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, icon: int, label: string, detail: string, action: int, highlighted: bool) {
  k := f[0].skin; c := k.cmp; sh := f[0].sheet; m := f[0].m;
  h := c.chip_h; r := h / 2.0f32;
  hv := uiframe_hover_on(f, KEYED_LAZY, id, action != 0 && uiframe_hovered(f, id));
  row := uiframe_semantic(f, id, EL_BUTTON, label, x, y, w, h, 0, action);
  elt_value(f[0].rows, row, detail);
  bg := rgba_mix(k.raised, k.hover, hv);
  border := ifx highlighted then k.accent else k.hairline;
  _ := sheet_box(sh, x, y, w, h, r, k.border, bg, border);
  ink := ifx highlighted then k.ink else rgba_mix(k.muted, k.ink, hv);
  icon_ink := ifx highlighted then k.accent else ink;
  pad := 10.0f32;
  tx := x + pad;
  if icon >= 0 {
    sheet_icon(sh, icon, tx, y + (h - c.chip_icon) / 2.0f32, c.chip_icon, icon_ink);
    tx += c.chip_icon + c.chip_gap;
  }
  right := x + w - pad;
  if detail.count > 0 {
    dw := measure_width(m, k.label.face, detail);
    if right - dw > tx + c.chip_gap {
      _ := sheet_text(sh, m, -1, right - dw, y + (h - k.label.line) / 2.0f32, k.label.line, k.label.face, k.faint, detail);
      right -= dw + c.chip_gap;
    }
  }
  room := right - tx;
  if room > 0 {
    _ := sheet_text(sh, m, -1, tx, y + (h - k.small.line) / 2.0f32, k.small.line, k.small.face, ink, app_fit(f, k.small.face, label, room));
  }
  sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, w, h);
}
cp_side_footer :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32) {
  if s.count < 1 || s[0].update_state == CP_UPD_HIDDEN { return; }
  k := f[0].skin; a := k.app;
  pad_v := 10.0f32;
  sheet_fill(f[0].sheet, x, y, w, k.border, 0, k.menu_divider);
  px := x + a.row_inset;
  pw := w - 2.0f32 * a.row_inset;
  if pw <= 0 { return; }
  py := y + k.border + pad_v;
  st := s[0].update_state;
  icon := ICON_ARROW_UP;
  def_label := "Update available";
  action := CP_UPDATE;
  highlighted := false;
  if st == CP_UPD_AVAILABLE { highlighted = true; }
  else if st == CP_UPD_DOWNLOADING { def_label = "Updating…"; action = 0; }
  else if st == CP_UPD_READY { icon = ICON_CHECK; def_label = "Restart to update"; highlighted = true; }
  else if st == CP_UPD_ERROR { icon = ICON_DANGER; def_label = "Update failed"; }
  label := ifx s[0].update_label_n > 0 then sheet_pool(f[0].sheet, cast(string) s[0].update_label[0..<s[0].update_label_n]) else def_label;
  detail := ifx s[0].update_detail_n > 0 then sheet_pool(f[0].sheet, cast(string) s[0].update_detail[0..<s[0].update_detail_n]) else "";
  cp_side_pill(f, "coder.side.pill.update", px, py, pw, icon, label, detail, action, highlighted);
}
