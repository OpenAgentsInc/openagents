// Coder Desktop page (../../page.coax): the window's title bar (GitHub #13741), drawn by the page as
// Zeron's is (zgx ui/ds/title_bar.luau, ui/ds/island.luau). The window runs the page under a
// transparent title bar (Window+TitleBar.swift), whose own buttons, the traffic lights, stand 14
// points across at x 21, 44 and 67 on the bar's line 20 points down. Beside them, 88 in, the
// sidebar's toggle, in the same place whether the sidebar is open or not; with the sidebar
// collapsed, an island gathers behind the lights and the toggle. What lies under the bar starts
// 38 points down. Its measures are window points, as the lights are, so the page's units (points at
// the text size, cp_scale) divide them by the scale. No back or forward: Coder keeps no history
// of where it was to go back to.

CP_BAR_PT :: 38.0f32;          // the bar's height (Zeron's TITLE_H)
CP_BAR_LINE_PT :: 20.0f32;     // its line: the traffic lights' middle (zgx's inset strip)
CP_BAR_TOGGLE_PT :: 88.0f32;   // the toggle's left edge, past the lights (titlebar_cluster_start)
CP_BAR_FULL_PT :: 12.0f32;     // in full screen the lights hide and the toggle takes the edge
CP_BAR_LIGHTS_PT :: 14.0f32;   // the lights' left edge: Close's middle 21 less half its 14
CP_BAR_LIGHTS_END_PT :: 74.0f32;   // their right edge: Zoom's middle 67 and half its 14
CP_BAR_GAP_PT :: 4.0f32;       // gap between left-cluster title bar icon buttons (toggle, search)
CP_BAR_ROW_PAD_PT :: 10.0f32;  // the island's room past its last control (TITLEBAR_CLUSTER_PAD)
// zeron.island: its corner, its inset from the window's edge, its padding round its controls and
// their size (the sidebar toggle and the search button).
CP_ISLAND_RADIUS :: 12.0f32; CP_ISLAND_INSET :: 6.0f32; CP_ISLAND_PAD :: 4.0f32; CP_ISLAND_CONTROL :: 24.0f32;

// The bar's height, its line, the toggle's and search button's left edges, in the page's units.
cp_bar :: (s: [] CoderPage) -> f32 { return CP_BAR_PT / cp_scale(s); }
cp_bar_line :: (s: [] CoderPage) -> f32 { return CP_BAR_LINE_PT / cp_scale(s); }
cp_bar_toggle_x :: (s: [] CoderPage) -> f32 { return (ifx s[0].bar_full then CP_BAR_FULL_PT else CP_BAR_TOGGLE_PT) / cp_scale(s); }
cp_bar_search_x :: (s: [] CoderPage, has_toggle: bool) -> f32 {
  return cp_bar_toggle_x(s) + (ifx has_toggle then CP_ISLAND_CONTROL + CP_BAR_GAP_PT / cp_scale(s) else 0.0f32);
}
cp_bar_back_x :: (s: [] CoderPage, has_toggle: bool) -> f32 {
  return cp_bar_search_x(s, has_toggle) + CP_ISLAND_CONTROL + CP_BAR_GAP_PT / cp_scale(s);
}
cp_bar_fwd_x :: (s: [] CoderPage, has_toggle: bool) -> f32 {
  return cp_bar_back_x(s, has_toggle) + CP_ISLAND_CONTROL + CP_BAR_GAP_PT / cp_scale(s);
}
cp_bar_mode_x :: (s: [] CoderPage, has_toggle: bool) -> f32 {
  return cp_bar_fwd_x(s, has_toggle) + CP_ISLAND_CONTROL + (CP_BAR_GAP_PT + 4.0f32) / cp_scale(s);
}
CP_BAR_MODE_W :: 112.0f32;
// Where the bar's controls at the left end, with the room past them: what shares the line starts past it.
cp_bar_clear :: (s: [] CoderPage) -> f32 {
  return cp_bar_mode_x(s, true) + CP_BAR_MODE_W + CP_BAR_ROW_PAD_PT / cp_scale(s);
}
// A control on the bar's line, size tall, from the top: never above the window's edge.
cp_bar_y :: (s: [] CoderPage, size: f32) -> f32 { y := cp_bar_line(s) - size / 2; return ifx y < 0 then 0.0f32 else y; }

// Navigation history ring/stack (#14138): tracks recent views and chats for < / > and Cmd+[ / Cmd+].
cp_nav_can_back :: (s: [] CoderPage) -> bool { return s.count > 0 && s[0].nav_n > 1 && s[0].nav_at > 0; }
cp_nav_can_fwd :: (s: [] CoderPage) -> bool { return s.count > 0 && s[0].nav_at >= 0 && s[0].nav_at + 1 < s[0].nav_n; }
cp_nav_entry_eq :: (a: CpNavEntry, b: CpNavEntry) -> bool {
  if a.view != b.view || a.catalog != b.catalog || a.mode != b.mode || a.chat_id_n != b.chat_id_n { return false; }
  for i: 0..<a.chat_id_n { if a.chat_id[i] != b.chat_id[i] { return false; } }
  return true;
}
cp_nav_make :: (view: int, chat_id: string, catalog: int, mode: int) -> CpNavEntry {
  e := CpNavEntry.{view = view, catalog = catalog, mode = mode};
  e.chat_id_n = cp_out(e.chat_id[..], chat_id);
  return e;
}
cp_nav_push :: (s: [] CoderPage, view: int, chat_id: string, catalog: int) {
  if s.count < 1 || s[0].nav_suppress { return; }
  e := cp_nav_make(view, chat_id, catalog, s[0].work_mode);
  if s[0].nav_n > 0 && s[0].nav_at >= 0 && s[0].nav_at < s[0].nav_n {
    if cp_nav_entry_eq(s[0].nav_hist[s[0].nav_at], e) { return; }
  }
  // Truncate forward tail when pushing from a back position.
  next_n := ifx s[0].nav_at >= 0 && s[0].nav_at < s[0].nav_n then s[0].nav_at + 1 else s[0].nav_n;
  if next_n >= CP_NAV_HIST_MAX {
    for i: 1..<CP_NAV_HIST_MAX { s[0].nav_hist[i - 1] = s[0].nav_hist[i]; }
    next_n = CP_NAV_HIST_MAX - 1;
  }
  s[0].nav_hist[next_n] = e;
  s[0].nav_n = next_n + 1;
  s[0].nav_at = next_n;
}
cp_nav_record_current :: (s: [] CoderPage) {
  if s.count < 1 || s[0].nav_suppress { return; }
  view := CP_NAV_CHAT;
  if s[0].dash[0].open { view = CP_NAV_DASHBOARD; }
  else if s[0].wallet[0].open { view = CP_NAV_WALLET; }
  else if s[0].introspect[0].open { view = CP_NAV_INTROSPECT; }
  cid := ifx view == CP_NAV_CHAT then cast(string) s[0].current[0..<s[0].current_n] else "";
  cp_nav_push(s, view, cid, 0);
}
cp_nav_go :: (s: [] CoderPage, delta: int) -> bool {
  if s.count < 1 || s[0].nav_n < 2 { return false; }
  target := s[0].nav_at + delta;
  if target < 0 || target >= s[0].nav_n { return false; }
  s[0].nav_at = target;
  e := s[0].nav_hist[target];
  s[0].nav_suppress = true;
  s[0].work_mode = e.mode;
  s[0].dash[0].open = false;
  s[0].wallet[0].open = false;
  s[0].introspect[0].open = false;
  s[0].catalog_view = CP_CAT_NONE;
  if e.view == CP_NAV_CATALOG {
    s[0].catalog_view = e.catalog;
  } else if e.view == CP_NAV_DASHBOARD {
    s[0].dash[0].open = true;
    s[0].ask = CP_ASK_DASHBOARD;
  } else if e.view == CP_NAV_WALLET {
    s[0].wallet[0].open = true;
    s[0].ask = CP_ASK_WALLET_OPEN;
  } else if e.view == CP_NAV_INTROSPECT {
    s[0].introspect[0].open = true;
  } else {
    cid := cast(string) e.chat_id[0..<e.chat_id_n];
    cur := cast(string) s[0].current[0..<s[0].current_n];
    if cid.count == 0 {
      if cur.count > 0 || s[0].nturns > 0 { _ = cp_new(s); }
    } else if cid != cur {
      for q: 0..<s[0].nchats {
        if cid == cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n] {
          s[0].open = q;
          s[0].ask = CP_ASK_OPEN;
          break;
        }
      }
    }
  }
  s[0].nav_suppress = false;
  return true;
}

// Crisp segmented [Chat | </> Code] workspace mode pill in OpenAgents pure-black Geist skin (#14138).
cp_mode_switch :: (s: [] CoderPage, f: [] UiFrame, x: f32, y: f32, w: f32, h: f32) {
  if w < 64.0f32 || h < 18.0f32 { return; }
  k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  pad := 2.0f32;
  r := 8.0f32;
  _ := sheet_box(sh, x, y, w, h, r, k.border, k.surface, k.menu_divider);
  seg_w := (w - 2.0f32 * pad) * 0.5f32;
  seg_h := h - 2.0f32 * pad;
  if seg_w <= 0 || seg_h <= 0 { return; }
  is_code := s[0].work_mode == CP_MODE_CODE;
  labels := [2] string.["Chat", "Code"];
  ids := [2] string.["coder.mode.chat", "coder.mode.code"];
  acts := [2] int.[CP_MODE_CHAT_ACT, CP_MODE_CODE_ACT];
  icons := [2] int.[ICON_CHATS, ICON_TERMINAL];
  for idx: 0..<2 {
    sx := x + pad + cast(f32) idx * seg_w;
    sy := y + pad;
    active := (idx == 0 && !is_code) || (idx == 1 && is_code);
    kk := uiframe_key(f, ids[idx]);
    hv := uiframe_hover(f, kk, ids[idx]);
    if active {
      _ := sheet_box(sh, sx, sy, seg_w, seg_h, r - 2.0f32, k.border, k.raised, rgba_mix(k.menu_divider, k.accent, 0.35f32));
    } else if hv > 0 {
      sheet_fill(sh, sx, sy, seg_w, seg_h, r - 2.0f32, opacity(k.raised, 0.55f32 * hv));
    }
    ink := ifx active then k.ink else rgba_mix(k.muted, k.ink, hv);
    tf := k.small;
    tw := measure_width(m, tf.face, labels[idx]);
    show_icon := seg_w >= tw + 26.0f32;
    ico_sz := 12.0f32;
    gap := 4.0f32;
    tot_w := tw + (ifx show_icon then ico_sz + gap else 0.0f32);
    cx := sx + (seg_w - tot_w) * 0.5f32;
    if show_icon {
      sheet_icon(sh, icons[idx], cx, sy + (seg_h - ico_sz) * 0.5f32, ico_sz, ifx active then k.accent else ink);
      cx += ico_sz + gap;
    }
    _ := sheet_text(sh, m, -1, cx, sy + (seg_h - tf.line) * 0.5f32, tf.line, tf.face, ink, labels[idx]);
    row := uiframe_semantic(f, ids[idx], EL_BUTTON, labels[idx], sx, sy, seg_w, seg_h, ifx active then EL_S_CURRENT else 0, acts[idx]);
    sheet_hit(sh, UIFRAME_HIT, row, 0, sx, sy, seg_w, seg_h);
  }
}

// Crisp single-physical-pixel horizontal border whose bottom edge aligns with edge_y (matching cp_side_border).
cp_bar_border :: (s: [] CoderPage, sh: [] Sheet, x: f32, w: f32, edge_y: f32, color: Rgba) {
  d := ifx s.count > 0 && s[0].d > 0.0f32 then s[0].d else 1.0f32;
  ey := snap(edge_y, d);
  y0 := (ey - 1.0f32) / d;
  if y0 < 0.0f32 { y0 = 0.0f32; }
  y1 := ey / d;
  if y1 > y0 && w > 0.0f32 { sheet_fill(sh, x, y0, w, y1 - y0, 0, color); }
}

// Full-width main-area header bar from `left` to `w`: opaque surface, optional crisp 1-physical-pixel
// bottom border matching the sidebar divider, and the page or thread title on the top-left clear of controls.
cp_header_bar_styled :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, title: string, right_limit: f32, draw_border: bool) {
  k := f[0].skin; sh := f[0].sheet;
  bar_h := cp_bar(s);
  bw := w - left;
  if bw <= 0.0f32 || bar_h <= 0.0f32 { return; }
  bg := k.canvas;
  d := ifx s.count > 0 && s[0].d > 0.0f32 then s[0].d else 1.0f32;
  bh := ifx draw_border then (snap(bar_h, d) - 1.0f32) / d else bar_h;
  if bh < 0.0f32 { bh = 0.0f32; }
  if bh > 0.0f32 { sheet_fill(sh, left, 0, bw, bh, 0, bg); }
  if draw_border { cp_bar_border(s, sh, left, bw, bar_h, k.menu_divider); }
  if title.count > 0 {
    tx := ifx left >= 180.0f32 then left + 16.0f32 else cp_bar_clear(s);
    room := right_limit - tx;
    if room > 16.0f32 {
      tf := k.title;
      fit := app_fit(f, tf.face, title, room);
      tw := ceil(measure_width(f[0].m, tf.face, fit));
      if tw > room { tw = room; }
      ty := cp_bar_y(s, tf.line);
      _ := uiframe_semantic(f, "coder.header.title", EL_TEXT, fit, tx, ty, tw, tf.line, 0, 0);
      _ := sheet_text(sh, f[0].m, -1, tx, ty, tf.line, tf.face, k.ink, fit);
    }
  }
}
cp_header_bar :: (s: [] CoderPage, f: [] UiFrame, left: f32, w: f32, title: string, right_limit: f32) {
  cp_header_bar_styled(s, f, left, w, title, right_limit, true);
}

// The island behind the bar's controls at the window's top left (zeron.island), toggle or not:
// from its inset to the row's end, a control and its padding tall, on the bar's line. Opaque:
// zeron.menu.solid and shadow.sm, Zeron's island with its glass turned solid (island.luau `glass`),
// over what scrolls under the bar. Its blur (composition-v1, compose.coax) would put every frame with
// the sidebar collapsed through the planner for a backdrop that is the plain canvas almost always.
CpIsland :: struct { x: f32; y: f32; w: f32; h: f32; }
cp_island :: (s: [] CoderPage, toggle: bool) -> CpIsland {
  sc := cp_scale(s); c := CP_ISLAND_CONTROL; pad := CP_ISLAND_PAD / sc;
  x := CP_ISLAND_INSET / sc;
  end := cp_bar_search_x(s, toggle) + c + CP_BAR_ROW_PAD_PT / sc;
  h := c + 2 * pad;
  return CpIsland.{x = x, y = cp_bar_y(s, h), w = end - x, h = h};
}

// The bar over the page: the toggle (when the sidebar is open or the window can show it) and search
// icon stand on the full-width pure black header bar, with no floating gray island pill behind the
// traffic lights when the sidebar is collapsed. Drawn after the page's parts.
cp_title_bar :: (s: [] CoderPage, f: [] UiFrame, left: f32, toggle: bool) {
  k := f[0].skin;
  has_toggle := toggle || left > 0;
  loc := ifx cp_flag(s, DC_FLAG_CUSTOMIZE) then s[0].cust[0].locale.active else CP_LOCALE_EN;
  // left-cluster controls: the app's icon buttons at the island's control size
  keep := f[0].skin;
  f[0].skin.app.icon_button = CP_ISLAND_CONTROL; f[0].skin.app.icon_well = CP_ISLAND_CONTROL;
  by := cp_bar_y(s, CP_ISLAND_CONTROL);
  if has_toggle {
    _ := app_icon_button(f, "coder.side.toggle", cp_bar_toggle_x(s), by, k.app.icon_nav,
                         ifx left >= 180.0f32 then "Hide sidebar" else "Show sidebar", APP_BUTTON_QUIET, 0, CP_SIDE_TOGGLE);
  }
  _ := app_icon_button(f, "coder.search", cp_bar_search_x(s, has_toggle), by, ICON_MAGNIFER,
                       cp_tr(loc, "search"), APP_BUTTON_QUIET, 0, CP_PALETTE);
  back_st := ifx cp_nav_can_back(s) then 0 else EL_S_DISABLED;
  fwd_st := ifx cp_nav_can_fwd(s) then 0 else EL_S_DISABLED;
  _ := app_icon_button(f, "coder.nav.back", cp_bar_back_x(s, has_toggle), by, ICON_BACK,
                       "Back", APP_BUTTON_QUIET, back_st, CP_NAV_BACK);
  _ := app_icon_button(f, "coder.nav.fwd", cp_bar_fwd_x(s, has_toggle), by, ICON_CHEVRON_RIGHT,
                       "Forward", APP_BUTTON_QUIET, fwd_st, CP_NAV_FWD);
  if left < 180.0f32 {
    cp_mode_switch(s, f, cp_bar_mode_x(s, has_toggle), by, CP_BAR_MODE_W, CP_ISLAND_CONTROL);
  }
  f[0].skin = keep;
}

// Whether a press at (x, y), in window points from its top left, is on the bar where nothing of the
// page's takes it: the host then moves the window, or a double-click zooms it as the system says
// (Window+TitleBar.swift). A dialog, a menu or a sidebar's edge keeps its press.
coder_page_bar_drags :: (s: [] CoderPage, x: f32, y: f32) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].ready || cp_overlay_open(s) || s[0].model_menu || s[0].effort_menu { return false; }
  sc := cp_scale(s); ux := x / sc; uy := y / sc;
  if uy < 0 || uy >= cp_bar(s) || cp_edge(s, ux) != 0 { return false; }
  return surface_action(s[0].surface[..], surface_hit(s[0].surface[..], ux, uy)) == 0;
}
// The window went into full screen (on) or came out: the lights hide there, so the toggle takes the
// window's edge.
coder_page_bar_full :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].bar_full = on; } }
// A Linux or Windows window: key hints read Ctrl, and Ctrl-N starts a new chat (editor.coax).
coder_page_ctrl_keys :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].ctrl_keys = on; } }
// The local model's name with the variant in use, for the model chip ("" for the plain name).
coder_page_inkling_label :: (s: [] CoderPage, label: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  n := 0;
  for c: label { if n < s[0].inkling_label.count { s[0].inkling_label[n] = c; n += 1; } }
  s[0].inkling_label_n = n;
}
