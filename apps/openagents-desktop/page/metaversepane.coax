CP_MV_KIND_SCENE       :: 5;
CP_MV_KIND_REALM       :: 6;
CP_MV_KIND_GAMEBUILDER :: 7;

// Active modes (aligned with MV_MODE_*)
CP_MV_MODE_INSPECT :: 0;
CP_MV_MODE_BUILD   :: 1;
CP_MV_MODE_PLAY    :: 2;

// Drawer sub-tabs
CP_MV_DRW_TREE    :: 0;
CP_MV_DRW_INSPECT :: 1;
