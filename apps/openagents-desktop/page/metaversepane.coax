CpMvTab :: struct {
  used: bool;
  kind: int;
  mode: int;
  path: [CP_MV_PATH] u8; path_n: int;
  title: [CP_MV_TITLE] u8; title_n: int;
  game_id: [64] u8; game_id_n: int;
  level_id: [64] u8; level_id_n: int;
  badge: [4] u8; badge_n: int;
  saved_rev: int;
  rendered_rev: int;
  rev_state: int;
  dirty: bool;
  read_only: bool;
  agent_active: bool;
  change_count: int;
  playing: bool;
  muted: bool;
  has_anim: bool;
  has_assembly: bool;
  cam_fly: bool;
  shading: int;
  overlay_mask: int;
  z_slice: f32;
  stats: [CP_MV_STATUS] u8; stats_n: int;
  err: [256] u8; err_n: int;
}

CpMvTreeRow :: struct {
  depth: int;
  visible: bool;
  selected: bool;
  id: [48] u8; id_n: int;
  label: [64] u8; label_n: int;
}

CP_GB_STUDIO_ROWS :: 24;
CpGbStudioRow :: struct {
  tag: [4] u8; tag_n: int;
  text: [88] u8; text_n: int;
}

CpGbUiState :: struct {
  tool: int;
  snap_idx: int;
  can_undo: bool;
  can_redo: bool;
  template_id: int;
  match_mode: int;
  fighter_class: int;
  bot_team_size: int;
  sel_count: int;
  sel_kind: int;
  sel_fields: [CP_MV_FIELDS] int;
  sel_label: [64] u8; sel_label_n: int;
  share_code: [16] u8; share_code_n: int;
  attach_connected: int;
  picker_open: bool;
  hotbar_open: bool;
  playtest_running: bool;
  playtest_summary: [128] u8; playtest_summary_n: int;
  playtest_stuck: int;
  hydrating: bool;
  hydrate_pct: int;
  // Phase 4A Studio Drawer live state (#14045)
  agents_count: int;
  agents_running: int;
  claims_count: int;
  agents_account_on: bool;
  replay_steps: int;
  replay_at: int;
