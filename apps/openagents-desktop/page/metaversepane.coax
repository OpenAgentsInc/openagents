// OpenAgents Desktop page (../page.coax): Expandable right-side Metaverse Viewer & GameBuilder Pane
// (Spec: docs/desktop/metaverse-viewer-and-gamebuilder-pane-spec.md; GitHub #14037, #14040).
// Mirrors page/filepane.coax (#13992): Row 1 (38pt) unified multi-tab strip with RGB badges,
// '+' quick-open/New Game, Expand/Restore (⛶) taking full main area beside sidebar, Hide-preserving-
// tabs (◫), collapsible Studio/Inspector drawer (◧); Row 2 (30pt) breadcrumbs, mode switcher
// (Inspect | Build | Play or Orbit | Fly), revision truthfulness pill, camera/view menus, and
// Snapshot-to-Chat; Row 3 (30pt) contextual Build toolbar (GB_CONTROLS) / Play bar / Read-Only banner.

CP_MV_TABS      :: 12;
CP_MV_PATH      :: 1024;
CP_MV_TITLE     :: 96;
CP_MV_STATUS    :: 128;
CP_MV_BAR1_H    :: 38.0f32;
CP_MV_BAR2_H    :: 30.0f32;
CP_MV_BAR3_H    :: 30.0f32;
CP_MV_DRAWER_W  :: 260.0f32;
CP_MV_TREE_MAX  :: 128;
CP_MV_FIELDS    :: 11;

