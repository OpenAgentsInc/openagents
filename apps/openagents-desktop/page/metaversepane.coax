CP_MV_DRW_LEVELS  :: 3;
CP_MV_DRW_AGENTS  :: 4;
CP_MV_DRW_SHARE   :: 5;
CP_MV_DRW_LOBBY   :: 6;

// Revision truthfulness state (Spec Invariant I-4)
CP_MV_REV_SYNCED      :: 0;
CP_MV_REV_RENDERING   :: 1;
