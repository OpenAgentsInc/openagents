// Coder Desktop page (../page.coax): the single model list, model lookups,
// OpenRouter main/sub-agent models, effort level, and the picker's host calls.
//
// Single-list design (Audit §3.5): cp_model_list builds the enabled entries once,
// gated by the flag registry (coax/lib/agent/desktop/flags.coax). Every index,
// label, id, description, provider kind and selection repair reads from that list.
// When every extra model flag is off (the Inkling-only first release), Inkling 2 Mini
// is the sole model and no model selector is shown.

CP_MK_NONE :: -1;
CP_MK_GEMINI :: 0;
CP_MK_OPENROUTER :: 1;
CP_MK_AGY :: 2;
CP_MK_INKLING :: 3;
CP_MK_HYBRID :: 4;
CP_MK_INKLING_NEON :: 5;
CP_MK_CODEX :: 6;
CP_MK_CURSOR :: 7;
CP_MK_ACP :: 8;
CP_MK_CLAUDE :: 9;
CP_MK_CORE :: 10;
CP_MK_COMPUTE :: 11;
CP_MODEL_LIST_MAX :: 48;

CpModelEntry :: struct {
  kind: int;    // CP_MK_*
  slot: int;    // sub-index: 0..3 for Gemini/Claude, ACP slot for ACP, else 0
}

// Cloud/Microcoder Gemini models require the models.gemini flag plus either a Gemini key
// in Settings, a sign-in mcworker --auth found (Vertex SA/ADC/env), or an OpenAgents account
// login when the account flag is also on.
cp_cloud_ok :: (s: [] CoderPage) -> bool {
  if s.count < 1 || !cp_flag(s, DC_FLAG_MODELS_GEMINI) { return false; }
  return s[0].set_gemini_n > 0 || s[0].set_gauth_n > 0 || (cp_flag(s, DC_FLAG_ACCOUNT) && s[0].cloud_authed);
}

cp_has_inkling_neon :: (s: [] CoderPage) -> bool {
  return s.count > 0 && cp_flag(s, DC_FLAG_MODELS_INKLING_NEON) && cp_cloud_ok(s) && s[0].inkling;
}

// Active local Inkling variant metadata pushed from host (falls back to generic Inkling 2 Mini when unset).
cp_inkling_id :: (s: [] CoderPage) -> string {
  if s.count > 0 && s[0].inkling_id_n > 0 { return cast(string) s[0].inkling_id[0..<s[0].inkling_id_n]; }
  return "inkling-2-mini";
}
cp_inkling_label :: (s: [] CoderPage) -> string {
  if s.count > 0 && s[0].inkling_label_n > 0 { return cast(string) s[0].inkling_label[0..<s[0].inkling_label_n]; }
  return "Inkling 2 Mini";
}
cp_inkling_desc :: (s: [] CoderPage) -> string {
  if s.count > 0 && s[0].inkling_desc_n > 0 { return cast(string) s[0].inkling_desc[0..<s[0].inkling_desc_n]; }
  if s.count > 0 && !s[0].inkling {
    if s[0].local_dl_state == CP_LOCAL_DOWNLOADING { return "Downloading…"; }
    if s[0].local_dl_state == CP_LOCAL_VERIFYING { return "Verifying SHA-256…"; }
    if !s[0].local_os_ok || !s[0].local_hw_ok { return "Requires Apple Silicon with 12 GB+ RAM"; }
    return "Not downloaded · Click to download";
  }
  return "Psionic Metal · Local · 26.4B/3.4B MoE";
}
cp_is_inkling_id :: (name: string) -> bool {
  if name == "inkling-2-mini" || name == "inkling" || name == "Inkling 2 Mini" || name == "Inkling 2 Mini (Local)" { return true; }
  if name.count > 15 && cast(string) name[0..<15] == "inkling-2-mini-" { return true; }
  if name.count > 15 && cast(string) name[0..<15] == "Inkling 2 Mini " { return true; }
  return false;
}
// True when the currently selected model requires local Inkling weights and they are not ready to send.
cp_local_unavailable :: (s: [] CoderPage) -> bool {
  if s.count < 1 || s[0].inkling { return false; }
  idx := cp_model_index(s);
  return cp_is_inkling(s, idx) || cp_is_flawed_local(s, idx);
}

// True when any cloud compute credential is configured for OpenAgents.
cp_has_cloud_compute :: (s: [] CoderPage) -> bool {
  if s.count < 1 { return false; }
  if s[0].cloud_authed || s[0].set_gemini_n > 0 || s[0].set_gauth_n > 0 { return true; }
  fl := s[0].flawed[..];
  if fl[0].key_label_n > 0 {
    kl := cast(string) fl[0].key_label[0..<fl[0].key_label_n];
    if kl != "Not set" && kl != "" { return true; }
  }
  if fl[0].auth_status_n > 0 {
    ast := cast(string) fl[0].auth_status[0..<fl[0].auth_status_n];
    if cp_contains(ast, "Vertex") || cp_contains(ast, "Gemini") || cp_contains(ast, "OpenRouter") { return true; }
  }
  return false;
}

// True when only local Inkling 2 Mini is available (hides the default compute picker).
cp_local_only_compute :: (s: [] CoderPage) -> bool {
  if s.count < 1 { return false; }
  if s[0].flawed[0].backend == 1 { return true; }
  return s[0].inkling && !cp_has_cloud_compute(s);
}

// Builds the single canonical list of currently available entries in picker order.
// Default UX (show_other_models == false) exposes ONLY a clean OpenAgents compute control
// (Auto | Local | Cloud), automatically collapsing to a single Local entry (hidden picker)
// when only local Inkling 2 Mini is available.
// Developer mode (show_other_models == true) exposes individual OpenAgents models & external harnesses.
cp_model_list :: (s: [] CoderPage, out: [] CpModelEntry) -> int {
  if s.count < 1 { return 0; }
  n := 0;
  if !s[0].show_other_models {
    if cp_local_only_compute(s) {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_COMPUTE, slot = CP_COMPUTE_LOCAL}; n += 1; }
      return n;
    }
    for i: 0..<CP_COMPUTE_MODES {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_COMPUTE, slot = i}; n += 1; }
    }
    return n;
  }
  for i: 0..<CP_FLAWED_MODELS {
    if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_CORE, slot = i}; n += 1; }
  }
  if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_INKLING, slot = 0}; n += 1; }
  if cp_cloud_ok(s) {
    for i: 0..<CP_MODELS {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_GEMINI, slot = i}; n += 1; }
    }
    if cp_flag(s, DC_FLAG_MODELS_OPENROUTER) && s[0].or_main_n > 0 {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_OPENROUTER, slot = 0}; n += 1; }
    }
  }
  if s[0].agy_models_n > 0 {
    for i: 0..<s[0].agy_models_n {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_AGY, slot = i}; n += 1; }
    }
  } else if s[0].agy {
    if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_AGY, slot = 0}; n += 1; }
  }
  if cp_flag(s, DC_FLAG_MODELS_EXECUTOR) && s[0].hybrid_exec {
    if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_HYBRID, slot = 0}; n += 1; }
  }
  if cp_has_inkling_neon(s) {
    if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_INKLING_NEON, slot = 0}; n += 1; }
  }
  if cp_flag(s, DC_FLAG_MODELS_EXTERNAL) {
    if s[0].prov[0].codex {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_CODEX, slot = 0}; n += 1; }
    }
    if s[0].prov[0].cursor {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_CURSOR, slot = 0}; n += 1; }
    }
    en := cp_acp_enabled_count(s);
    for k: 0..<en {
      slot := cp_acp_nth_enabled(s, k);
      if slot >= 0 && n < out.count { out[n] = CpModelEntry.{kind = CP_MK_ACP, slot = slot}; n += 1; }
    }
  }
  if cp_flag(s, DC_FLAG_MODELS_CLAUDE) && s[0].claude {
    for i: 0..<CP_CLAUDE_MODELS {
      if n < out.count { out[n] = CpModelEntry.{kind = CP_MK_CLAUDE, slot = i}; n += 1; }
    }
  }
  return n;
}

cp_models :: (s: [] CoderPage) -> int {
  list: [CP_MODEL_LIST_MAX] CpModelEntry;
  return cp_model_list(s, list[..]);
}

cp_model_entry :: (s: [] CoderPage, idx: int) -> CpModelEntry {
  if s.count < 1 || idx < 0 { return CpModelEntry.{kind = CP_MK_NONE, slot = -1}; }
  list: [CP_MODEL_LIST_MAX] CpModelEntry;
  n := cp_model_list(s, list[..]);
  if idx >= n { return CpModelEntry.{kind = CP_MK_NONE, slot = -1}; }
  return list[idx];
}

cp_model_idx_of :: (s: [] CoderPage, kind: int, slot: int) -> int {
  if s.count < 1 { return -1; }
  list: [CP_MODEL_LIST_MAX] CpModelEntry;
  n := cp_model_list(s, list[..]);
  for i: 0..<n {
    if list[i].kind == kind && (slot < 0 || list[i].slot == slot) { return i; }
  }
  return -1;
}

// Single-list accessors (zero duplicate counting arithmetic).
cp_compute_slot :: (s: [] CoderPage, idx: int) -> int {
  e := cp_model_entry(s, idx);
  return ifx e.kind == CP_MK_COMPUTE then e.slot else -1;
}
cp_flawed_slot :: (s: [] CoderPage, idx: int) -> int {
  e := cp_model_entry(s, idx);
  return ifx e.kind == CP_MK_CORE then e.slot else -1;
}
cp_is_flawed :: (s: [] CoderPage, idx: int) -> bool {
  e := cp_model_entry(s, idx);
  return e.kind == CP_MK_COMPUTE || e.kind == CP_MK_CORE;
}
cp_is_flawed_local :: (s: [] CoderPage, idx: int) -> bool {
  e := cp_model_entry(s, idx);
  if e.kind == CP_MK_COMPUTE { return e.slot == CP_COMPUTE_LOCAL; }
  return e.kind == CP_MK_CORE && e.slot == CP_FLAWED_START_LOCAL;
}
cp_flawed_idx :: (s: [] CoderPage) -> int {
  if s.count < 1 { return -1; }
  if !s[0].show_other_models {
    if cp_local_only_compute(s) { return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_LOCAL); }
    cm := s[0].flawed[0].default_agent;
    if cm == CP_COMPUTE_LOCAL {
      slot := ifx s[0].inkling then CP_COMPUTE_LOCAL else CP_COMPUTE_AUTO;
      return cp_model_idx_of(s, CP_MK_COMPUTE, slot);
    }
    if cm == CP_COMPUTE_CLOUD || s[0].flawed[0].backend >= 2 {
      return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_CLOUD);
    }
    return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_AUTO);
  }
  slot := ifx s[0].flawed[0].model_slot >= 0 && s[0].flawed[0].model_slot < CP_FLAWED_MODELS then s[0].flawed[0].model_slot else CP_FLAWED_START;
  if s[0].flawed[0].default_agent == CP_COMPUTE_LOCAL { slot = CP_FLAWED_START_LOCAL; }
  if slot == CP_FLAWED_START_LOCAL && !s[0].inkling { slot = CP_FLAWED_START_CLOUD; }
  return cp_model_idx_of(s, CP_MK_CORE, slot);
}
cp_compute_find :: (name: string) -> int {
  if name == "oa:auto" || name == "auto" || name == "Auto" { return CP_COMPUTE_AUTO; }
  if name == "oa:local" || name == "local" || name == "Local" { return CP_COMPUTE_LOCAL; }
  if name == "oa:cloud" || name == "cloud" || name == "Cloud" { return CP_COMPUTE_CLOUD; }
  return -1;
}
cp_flawed_find :: (name: string) -> int {
  if name == "oa" || name == "openagents" || name == "OpenAgents" || name == "flawed" || name == "Flawed" || name == "oa:auto" || name == "oa:cloud" { return CP_FLAWED_START; }
  if name == "oa:local" || name == "local" { return CP_FLAWED_START_LOCAL; }
  ids := CP_FLAWED_ID; labels := CP_FLAWED_LABEL;
  for i: 0..<CP_FLAWED_MODELS {
    if name == ids[i] || name == labels[i] { return i; }
  }
  bare := "";
  if name.count > CP_FLAWED_PREFIX.count && cast(string) name[0..<CP_FLAWED_PREFIX.count] == CP_FLAWED_PREFIX {
    bare = cast(string) name[CP_FLAWED_PREFIX.count..<name.count];
  } else if name.count > CP_LEGACY_FLAWED_PREFIX.count && cast(string) name[0..<CP_LEGACY_FLAWED_PREFIX.count] == CP_LEGACY_FLAWED_PREFIX {
    bare = cast(string) name[CP_LEGACY_FLAWED_PREFIX.count..<name.count];
  }
  if bare.count > 0 {
    if bare == "gemini-4-neon" || bare == "neon" { return 0; }
    if bare == "gemini-4-carbon" || bare == "carbon" { return 1; }
    if bare == "gemini-4-hydrogen" || bare == "hydrogen" { return 2; }
    if bare == "gemini-4-argon" || bare == "argon" { return 3; }
    if cp_is_inkling_id(bare) || bare == "local" { return CP_FLAWED_START_LOCAL; }
    return CP_FLAWED_START_CLOUD;
  }
  return -1;
}
cp_claude_base_idx :: (s: [] CoderPage) -> int { return cp_model_idx_of(s, CP_MK_CLAUDE, 0); }
cp_claude_slot :: (s: [] CoderPage, idx: int) -> int {
  e := cp_model_entry(s, idx);
  return ifx e.kind == CP_MK_CLAUDE then e.slot else -1;
}
cp_is_claude :: (s: [] CoderPage, idx: int) -> bool { return cp_claude_slot(s, idx) >= 0; }
cp_claude_find :: (name: string) -> int {
  ids := CP_CLAUDE_ID; labels := CP_CLAUDE_LABEL; alias := CP_CLAUDE_ALIAS;
  for i: 0..<CP_CLAUDE_MODELS { if name == ids[i] || name == labels[i] || name == alias[i] { return i; } }
  return -1;
}
cp_claude_keep :: (s: [] CoderPage, slot: int) {
  idx := cp_model_idx_of(s, CP_MK_CLAUDE, slot);
  if slot >= 0 && idx >= 0 { s[0].model = idx; }
}
cp_agy_ascii_eq_ci :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count {
    ca := a[i]; if ca >= 'A' && ca <= 'Z' { ca += 32; }
    cb := b[i]; if cb >= 'A' && cb <= 'Z' { cb += 32; }
    if ca != cb { return false; }
  }
  return true;
}
cp_agy_ascii_pre_ci :: (s: string, pre: string) -> bool {
  if s.count < pre.count { return false; }
  return cp_agy_ascii_eq_ci(cast(string) s[0..<pre.count], pre);
}
cp_agy_is_gemini4 :: (slug: string, name: string) -> bool {
  if cp_agy_ascii_pre_ci(slug, "gemini-4-") || cp_agy_ascii_pre_ci(slug, "gemini-4.") || cp_agy_ascii_eq_ci(slug, "gemini-4") { return true; }
  if cp_agy_ascii_pre_ci(name, "gemini 4 ") || cp_agy_ascii_eq_ci(name, "gemini 4") { return true; }
  return false;
}
cp_agy_is_neon :: (slug: string, name: string) -> bool {
  if cp_agy_ascii_eq_ci(slug, "gemini-4-neon") || cp_agy_ascii_pre_ci(slug, "gemini-4-neon-") { return true; }
  if cp_agy_ascii_eq_ci(name, "gemini 4 neon") || cp_agy_ascii_pre_ci(name, "gemini 4 neon ") { return true; }
  return false;
}
cp_agy_idx :: (s: [] CoderPage) -> int { return cp_model_idx_of(s, CP_MK_AGY, 0); }
cp_agy_default_idx :: (s: [] CoderPage) -> int {
  if s.count < 1 { return -1; }
  if s[0].agy_models_n > 0 {
    // Always default Antigravity to Gemini 4 Neon whenever available.
    for i: 0..<s[0].agy_models_n {
      slug := cast(string) s[0].agy_models[i].slug[0..<s[0].agy_models[i].slug_n];
      name := cast(string) s[0].agy_models[i].name[0..<s[0].agy_models[i].name_n];
      if cp_agy_is_neon(slug, name) {
        idx := cp_model_idx_of(s, CP_MK_AGY, i);
        if idx >= 0 { return idx; }
      }
    }
    for i: 0..<s[0].agy_models_n {
      if s[0].agy_models[i].is_default {
        idx := cp_model_idx_of(s, CP_MK_AGY, i);
        if idx >= 0 { return idx; }
      }
    }
    return cp_model_idx_of(s, CP_MK_AGY, 0);
  }
  return cp_model_idx_of(s, CP_MK_AGY, 0);
}
cp_agy_loaded_slot :: (s: [] CoderPage, idx: int) -> int {
  e := cp_model_entry(s, idx);
  return ifx e.kind == CP_MK_AGY && e.slot >= 0 && e.slot < s[0].agy_models_n then e.slot else -1;
}
cp_is_agy :: (s: [] CoderPage, idx: int) -> bool { return cp_model_entry(s, idx).kind == CP_MK_AGY; }
cp_inkling_idx :: (s: [] CoderPage) -> int { return cp_model_idx_of(s, CP_MK_INKLING, 0); }
cp_is_inkling :: (s: [] CoderPage, idx: int) -> bool { return cp_model_entry(s, idx).kind == CP_MK_INKLING; }
cp_hybrid_idx :: (s: [] CoderPage) -> int { return cp_model_idx_of(s, CP_MK_HYBRID, 0); }
cp_is_hybrid :: (s: [] CoderPage, idx: int) -> bool { return cp_model_entry(s, idx).kind == CP_MK_HYBRID; }
cp_inkling_neon_idx :: (s: [] CoderPage) -> int { return cp_model_idx_of(s, CP_MK_INKLING_NEON, 0); }
cp_is_inkling_neon :: (s: [] CoderPage, idx: int) -> bool { return cp_model_entry(s, idx).kind == CP_MK_INKLING_NEON; }
cp_is_or :: (s: [] CoderPage, idx: int) -> bool { return cp_model_entry(s, idx).kind == CP_MK_OPENROUTER; }
cp_or_main :: (s: [] CoderPage) -> string { return cast(string) s[0].or_main[0..<s[0].or_main_n]; }
cp_or_sub :: (s: [] CoderPage) -> string { return cast(string) s[0].or_sub[0..<s[0].or_sub_n]; }

// Save the active model id before toggling a flag/provider, then restore it cleanly from the new list.
cp_model_save_id :: (s: [] CoderPage, out: [] u8) -> string {
  if s.count < 1 { return ""; }
  idx := cp_model_index(s);
  if idx < 0 { return ""; }
  n := cp_out(out, cp_model_id(s, idx));
  return cast(string) out[0..<n];
}
cp_model_restore_id :: (s: [] CoderPage, prev: string) {
  if s.count < 1 { return; }
  if prev.count > 0 {
    idx := cp_model_find_exact(s, prev);
    if idx >= 0 { s[0].model = idx; return; }
  }
  s[0].model = cp_model_start(s);
  s[0].model = cp_model_index(s);
}

// The entry a new chat starts on:
// - Claude Code orchestrator if the user explicitly opted into Developer -> Show other models and set orch_claude;
// - Otherwise OpenAgents compute mode (Auto / Local / Cloud) or Developer default model.
cp_model_start :: (s: [] CoderPage) -> int {
  if s.count < 1 { return -1; }
  if s[0].show_other_models && cp_flag(s, DC_FLAG_MODELS_CLAUDE) && s[0].orch_claude && s[0].claude {
    k := ifx s[0].orch_model >= 0 && s[0].orch_model < CP_CLAUDE_MODELS then s[0].orch_model else CP_CLAUDE_START;
    idx := cp_model_idx_of(s, CP_MK_CLAUDE, k);
    if idx >= 0 { return idx; }
  }
  fi := cp_flawed_idx(s);
  if fi >= 0 { return fi; }
  ink := cp_inkling_idx(s);
  if ink >= 0 { return ink; }
  return ifx cp_models(s) > 0 then 0 else -1;
}

// Settings > Models: whether new chats start on Claude, and on which Claude model (0 Fable 5.2,
// 1 Opus 5.5, 2 Sonnet 5.5, 3 Haiku 5.5). A chat with no message yet moves to it now.
coder_page_orchestrator_set :: (s: [] CoderPage, claude: bool, model: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].orch_claude = claude;
  s[0].orch_model = ifx model >= 0 && model < CP_CLAUDE_MODELS then model else CP_CLAUDE_START;
  if s[0].nturns == 0 && !cp_running(s) { s[0].model = cp_model_start(s); s[0].model = cp_model_index(s); }
}
coder_page_orchestrator :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].orch_claude then 1 else 0; }
coder_page_orchestrator_model :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].orch_model else CP_CLAUDE_START; }

cp_model_index :: (s: [] CoderPage) -> int {
  n := cp_models(s);
  if s.count > 0 && s[0].model >= 0 && s[0].model < n { return s[0].model; }
  st := cp_model_start(s);
  if st >= 0 && st < n { return st; }
  return ifx n > 0 then 0 else -1;
}

// A kept Gemini/OpenRouter name's slot (legacy helper kept for compatibility).
cp_model_find :: (name: string) -> int {
  if name.count > CP_OR_PREFIX.count && cast(string) name[0..<CP_OR_PREFIX.count] == CP_OR_PREFIX { return CP_MODEL_OR; }
  ids := CP_MODEL_ID; shorts := CP_MODEL_SHORT;
  for i: 0..<CP_MODELS {
    if name == ids[i] || name == shorts[i] { return i; }
  }
  return CP_MODEL_DEFAULT;
}

// Exact lookup of `name` against the currently enabled model list. Returns -1 when not present.
cp_model_find_exact :: (s: [] CoderPage, name: string) -> int {
  if s.count < 1 || name.count == 0 { return -1; }
  if !s[0].show_other_models {
    cslot := cp_compute_find(name);
    if cslot >= 0 { return cp_model_idx_of(s, CP_MK_COMPUTE, cslot); }
    fslot := cp_flawed_find(name);
    if fslot >= 0 {
      if fslot == CP_FLAWED_START_LOCAL { return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_LOCAL); }
      if name == "oa" || name == "openagents" || name == "OpenAgents" || name == "flawed" || name == "Flawed" {
        ai := cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_AUTO);
        if ai >= 0 { return ai; }
      }
      ci := cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_CLOUD);
      if ci >= 0 { return ci; }
      return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_LOCAL);
    }
    if name == cp_inkling_id(s) || name == cp_inkling_label(s) || cp_is_inkling_id(name) {
      return cp_model_idx_of(s, CP_MK_COMPUTE, CP_COMPUTE_LOCAL);
    }
    return -1;
  }
  fslot := cp_flawed_find(name);
  if fslot >= 0 { return cp_model_idx_of(s, CP_MK_CORE, fslot); }
  if name.count > CP_AGY_PREFIX.count && cast(string) name[0..<CP_AGY_PREFIX.count] == CP_AGY_PREFIX {
    slug := cast(string) name[CP_AGY_PREFIX.count..<name.count];
    for i: 0..<s[0].agy_models_n {
      if cast(string) s[0].agy_models[i].slug[0..<s[0].agy_models[i].slug_n] == slug {
        return cp_model_idx_of(s, CP_MK_AGY, i);
      }
    }
    return -1;
  }
  if name == "antigravity" || name == "Antigravity" || name == "agy" { return cp_agy_default_idx(s); }
  if name == cp_inkling_id(s) || name == cp_inkling_label(s) || cp_is_inkling_id(name) { return cp_model_idx_of(s, CP_MK_INKLING, 0); }
  if name == "hybrid-exec-v1" || name == "hybrid-executor" || name == "Hybrid Executor" || name == "Hybrid Executor [E]" { return cp_model_idx_of(s, CP_MK_HYBRID, 0); }
  if name == "inkling-neon" || name == "hybrid-neon" || name == "inkling+neon" || name == "Inkling + Neon" { return cp_model_idx_of(s, CP_MK_INKLING_NEON, 0); }
  if name == "codex" || name == "Codex" { return cp_model_idx_of(s, CP_MK_CODEX, 0); }
  if name == "cursor" || name == "Cursor" { return cp_model_idx_of(s, CP_MK_CURSOR, 0); }
  if name.count > CP_ACP_PREFIX.count && cast(string) name[0..<CP_ACP_PREFIX.count] == CP_ACP_PREFIX {
    aid := cast(string) name[CP_ACP_PREFIX.count..<name.count];
    list: [CP_MODEL_LIST_MAX] CpModelEntry;
    n := cp_model_list(s, list[..]);
    for i: 0..<n {
      if list[i].kind == CP_MK_ACP {
        slot := list[i].slot;
        if cast(string) s[0].prov[0].acp[slot].id[0..<s[0].prov[0].acp[slot].id_n] == aid { return i; }
      }
    }
    return -1;
  }
  cslot := cp_claude_find(name);
  if cslot >= 0 { return cp_model_idx_of(s, CP_MK_CLAUDE, cslot); }
  if name == "openrouter" || (name.count > CP_OR_PREFIX.count && cast(string) name[0..<CP_OR_PREFIX.count] == CP_OR_PREFIX) {
    return cp_model_idx_of(s, CP_MK_OPENROUTER, 0);
  }
  ids := CP_MODEL_ID; shorts := CP_MODEL_SHORT; labels := CP_MODEL_LABEL;
  for i: 0..<CP_MODELS {
    if name == ids[i] || name == shorts[i] || name == labels[i] {
      gi := cp_model_idx_of(s, CP_MK_GEMINI, i);
      if gi >= 0 { return gi; }
    }
  }
  for i: 0..<s[0].agy_models_n {
    if cast(string) s[0].agy_models[i].slug[0..<s[0].agy_models[i].slug_n] == name ||
       cast(string) s[0].agy_models[i].name[0..<s[0].agy_models[i].name_n] == name {
      return cp_model_idx_of(s, CP_MK_AGY, i);
    }
  }
  return -1;
}

// Resolve `name` in the current list, falling back to the start model when unavailable.
cp_model_find_s :: (s: [] CoderPage, name: string) -> int {
  exact := cp_model_find_exact(s, name);
  if exact >= 0 { return exact; }
  return cp_model_start(s);
}

// Human-readable display name for any saved model id (including models whose flag is off,
// for kept-chat turn bylines and migration notices).
cp_model_known_label :: (name: string) -> string {
  cslot := cp_compute_find(name);
  if cslot >= 0 { return cp_compute_label_for(cslot); }
  fids := CP_FLAWED_ID; flabels := CP_FLAWED_LABEL;
  for i: 0..<CP_FLAWED_MODELS { if name == fids[i] { return flabels[i]; } }
  if name == "oa" || name == "openagents" || name == "flawed" { return "OpenAgents"; }
  bare := "";
  if name.count > CP_FLAWED_PREFIX.count && cast(string) name[0..<CP_FLAWED_PREFIX.count] == CP_FLAWED_PREFIX {
    bare = cast(string) name[CP_FLAWED_PREFIX.count..<name.count];
  } else if name.count > CP_LEGACY_FLAWED_PREFIX.count && cast(string) name[0..<CP_LEGACY_FLAWED_PREFIX.count] == CP_LEGACY_FLAWED_PREFIX {
    bare = cast(string) name[CP_LEGACY_FLAWED_PREFIX.count..<name.count];
  }
  if bare.count > 0 {
    if bare == "gemini-4-neon" { return flabels[0]; }
    if bare == "gemini-4-carbon" { return flabels[1]; }
    if bare == "gemini-4-hydrogen" { return flabels[2]; }
    if bare == "gemini-4-argon" { return flabels[3]; }
    if bare == "inkling-2-mini" { return flabels[4]; }
    if bare == "inkling-2-mini-uncensored-lora" { return "OpenAgents · Inkling 2 Mini Uncensored (LoRA)"; }
    if bare == "inkling-2-mini-uncensored-maple" { return "OpenAgents · Inkling 2 Mini Uncensored (Maple)"; }
    if bare == "inkling-2-mini-uncensored-q4k" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-Q4_K)"; }
    if bare == "inkling-2-mini-uncensored-iq3s" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-IQ3_S)"; }
    if bare == "inkling-2-mini-uncensored-iq2m" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-IQ2_M)"; }
    if bare == "inkling-2-mini-abliterated-mix16g" { return "OpenAgents · Inkling 2 Mini Abliterated (Mix-16G)"; }
    if bare == "inkling-2-mini-abliterated-mix12g" { return "OpenAgents · Inkling 2 Mini Abliterated (Mix-12G)"; }
    if bare == "inkling-2-mini-custom" { return "OpenAgents · Inkling 2 Mini (Custom Local .gguf)"; }
    return bare;
  }
  if name == "inkling-2-mini-uncensored-lora" { return "Inkling 2 Mini Uncensored (LoRA)"; }
  if name == "inkling-2-mini-uncensored-maple" { return "Inkling 2 Mini Uncensored (Maple)"; }
  if name == "inkling-2-mini-uncensored-q4k" { return "Inkling 2 Mini Uncensored (AD-Q4_K)"; }
  if name == "inkling-2-mini-uncensored-iq3s" { return "Inkling 2 Mini Uncensored (AD-IQ3_S)"; }
  if name == "inkling-2-mini-uncensored-iq2m" { return "Inkling 2 Mini Uncensored (AD-IQ2_M)"; }
  if name == "inkling-2-mini-abliterated-mix16g" { return "Inkling 2 Mini Abliterated (Mix-16G)"; }
  if name == "inkling-2-mini-abliterated-mix12g" { return "Inkling 2 Mini Abliterated (Mix-12G)"; }
  if name == "inkling-2-mini-custom" { return "Inkling 2 Mini (Custom Local .gguf)"; }
  if name == "inkling-2-mini" || name == "inkling" { return "Inkling 2 Mini"; }
  if name == "hybrid-exec-v1" || name == "hybrid-executor" { return "Hybrid Executor [E]"; }
  if name == "inkling-neon" || name == "hybrid-neon" { return "Inkling + Neon"; }
  if name.count > CP_AGY_PREFIX.count && cast(string) name[0..<CP_AGY_PREFIX.count] == CP_AGY_PREFIX {
    slug := cast(string) name[CP_AGY_PREFIX.count..<name.count];
    ids := CP_MODEL_ID; labels := CP_MODEL_LABEL;
    for i: 0..<CP_MODELS { if slug == ids[i] { return labels[i]; } }
    if slug == "gemini-3.8-flash" { return "Gemini 3.8 Flash"; }
    return slug;
  }
  if name == "antigravity" || name == "agy" { return "Antigravity"; }
  if name == "codex" { return "Codex"; }
  if name == "cursor" { return "Cursor"; }
  ids := CP_MODEL_ID; labels := CP_MODEL_LABEL;
  for i: 0..<CP_MODELS { if name == ids[i] { return labels[i]; } }
  cids := CP_CLAUDE_ID; clabels := CP_CLAUDE_LABEL;
  for i: 0..<CP_CLAUDE_MODELS { if name == cids[i] { return clabels[i]; } }
  if name.count > CP_OR_PREFIX.count && cast(string) name[0..<CP_OR_PREFIX.count] == CP_OR_PREFIX {
    return cast(string) name[CP_OR_PREFIX.count..<name.count];
  }
  if name.count > CP_ACP_PREFIX.count && cast(string) name[0..<CP_ACP_PREFIX.count] == CP_ACP_PREFIX {
    return cast(string) name[CP_ACP_PREFIX.count..<name.count];
  }
  return name;
}

cp_model_known_meta :: (name: string) -> string {
  cslot := cp_compute_find(name);
  if cslot >= 0 { return cp_compute_meta_for(cslot); }
  fids := CP_FLAWED_ID; fmetas := CP_FLAWED_META;
  for i: 0..<CP_FLAWED_MODELS { if name == fids[i] { return fmetas[i]; } }
  if name == "oa" || name == "openagents" || name == "flawed" { return "OpenAgents"; }
  bare := "";
  if name.count > CP_FLAWED_PREFIX.count && cast(string) name[0..<CP_FLAWED_PREFIX.count] == CP_FLAWED_PREFIX {
    bare = cast(string) name[CP_FLAWED_PREFIX.count..<name.count];
  } else if name.count > CP_LEGACY_FLAWED_PREFIX.count && cast(string) name[0..<CP_LEGACY_FLAWED_PREFIX.count] == CP_LEGACY_FLAWED_PREFIX {
    bare = cast(string) name[CP_LEGACY_FLAWED_PREFIX.count..<name.count];
  }
  if bare.count > 0 {
    if bare == "gemini-4-neon" { return fmetas[0]; }
    if bare == "gemini-4-carbon" { return fmetas[1]; }
    if bare == "gemini-4-hydrogen" { return fmetas[2]; }
    if bare == "gemini-4-argon" { return fmetas[3]; }
    if bare == "inkling-2-mini" { return fmetas[4]; }
    if bare == "inkling-2-mini-uncensored-lora" { return "OpenAgents · Inkling 2 Mini Uncensored (LoRA)"; }
    if bare == "inkling-2-mini-uncensored-maple" { return "OpenAgents · Inkling 2 Mini Uncensored (Maple)"; }
    if bare == "inkling-2-mini-uncensored-q4k" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-Q4_K)"; }
    if bare == "inkling-2-mini-uncensored-iq3s" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-IQ3_S)"; }
    if bare == "inkling-2-mini-uncensored-iq2m" { return "OpenAgents · Inkling 2 Mini Uncensored (AD-IQ2_M)"; }
    if bare == "inkling-2-mini-abliterated-mix16g" { return "OpenAgents · Inkling 2 Mini Abliterated (Mix-16G)"; }
    if bare == "inkling-2-mini-abliterated-mix12g" { return "OpenAgents · Inkling 2 Mini Abliterated (Mix-12G)"; }
    if bare == "inkling-2-mini-custom" { return "OpenAgents · Inkling 2 Mini (Custom Local .gguf)"; }
    return bare;
  }
  if name == "inkling-2-mini-uncensored-lora" { return "Psionic Metal · Inkling 2 Mini Uncensored (LoRA)"; }
  if name == "inkling-2-mini-uncensored-maple" { return "Psionic Metal · Inkling 2 Mini Uncensored (Maple)"; }
  if name == "inkling-2-mini-uncensored-q4k" { return "Psionic Metal · Inkling 2 Mini Uncensored (AD-Q4_K)"; }
  if name == "inkling-2-mini-uncensored-iq3s" { return "Psionic Metal · Inkling 2 Mini Uncensored (AD-IQ3_S)"; }
  if name == "inkling-2-mini-uncensored-iq2m" { return "Psionic Metal · Inkling 2 Mini Uncensored (AD-IQ2_M)"; }
  if name == "inkling-2-mini-abliterated-mix16g" { return "Psionic Metal · Inkling 2 Mini Abliterated (Mix-16G)"; }
  if name == "inkling-2-mini-abliterated-mix12g" { return "Psionic Metal · Inkling 2 Mini Abliterated (Mix-12G)"; }
  if name == "inkling-2-mini-custom" { return "Psionic Metal · Inkling 2 Mini (Custom Local .gguf)"; }
  if name == "inkling-2-mini" || name == "inkling" { return "Psionic Metal · Inkling 2 Mini"; }
  if name == "hybrid-exec-v1" || name == "hybrid-executor" { return "Psionic Metal · Hybrid Executor [E]"; }
  if name == "inkling-neon" || name == "hybrid-neon" { return "Hybrid · Inkling + Gemini 4 Neon"; }
  if name == "antigravity" || name == "agy" { return "Antigravity CLI"; }
  if name == "codex" { return "Codex CLI"; }
  if name == "cursor" { return "Cursor ACP"; }
  ids := CP_MODEL_ID; metas := CP_MODEL_META;
  for i: 0..<CP_MODELS { if name == ids[i] { return metas[i]; } }
  cids := CP_CLAUDE_ID; cmetas := CP_CLAUDE_META;
  for i: 0..<CP_CLAUDE_MODELS { if name == cids[i] { return cmetas[i]; } }
  return cp_model_known_label(name);
}

// The worker's model id for an entry.
cp_model_id :: (s: [] CoderPage, idx: int) -> string {
  e := cp_model_entry(s, idx);
  if e.kind == CP_MK_GEMINI { ids := CP_MODEL_ID; return ids[e.slot]; }
  if e.kind == CP_MK_OPENROUTER {
    return cast(string) s[0].or_id[0..<cp_out(s[0].or_id[..], CP_OR_PREFIX) + cp_out(s[0].or_id[CP_OR_PREFIX.count..<s[0].or_id.count], cp_or_main(s))];
  }
  if e.kind == CP_MK_AGY {
    if e.slot >= 0 && e.slot < s[0].agy_models_n {
      n := cp_out(s[0].agy_id_buf[..], CP_AGY_PREFIX);
      n += cp_out(s[0].agy_id_buf[n..<s[0].agy_id_buf.count], cast(string) s[0].agy_models[e.slot].slug[0..<s[0].agy_models[e.slot].slug_n]);
      return cast(string) s[0].agy_id_buf[0..<n];
    }
    return "antigravity";
  }
  if e.kind == CP_MK_INKLING { return cp_inkling_id(s); }
  if e.kind == CP_MK_HYBRID { return "hybrid-exec-v1"; }
  if e.kind == CP_MK_INKLING_NEON { return "inkling-neon"; }
  if e.kind == CP_MK_CODEX { return "codex"; }
  if e.kind == CP_MK_CURSOR { return "cursor"; }
  if e.kind == CP_MK_ACP {
    n := cp_out(s[0].prov[0].acp_id_buf[..], CP_ACP_PREFIX);
    n += cp_out(s[0].prov[0].acp_id_buf[n..<s[0].prov[0].acp_id_buf.count], cast(string) s[0].prov[0].acp[e.slot].id[0..<s[0].prov[0].acp[e.slot].id_n]);
    return cast(string) s[0].prov[0].acp_id_buf[0..<n];
  }
  if e.kind == CP_MK_CLAUDE { cids := CP_CLAUDE_ID; return cids[e.slot]; }
  if e.kind == CP_MK_COMPUTE { return cp_compute_id_for(e.slot); }
  if e.kind == CP_MK_CORE { return cp_flawed_id_for(s, e.slot); }
  st := cp_model_start(s);
  if st >= 0 && st != idx { return cp_model_id(s, st); }
  return cp_inkling_id(s);
}

cp_model_label :: (s: [] CoderPage, idx: int) -> string {
  e := cp_model_entry(s, idx);
  if e.kind == CP_MK_GEMINI { labels := CP_MODEL_LABEL; return labels[e.slot]; }
  if e.kind == CP_MK_OPENROUTER {
    m := cp_or_main(s); at := 0;
    for c, i: m { if c == '/' { at = i + 1; } }
    return ifx at < m.count then cast(string) m[at..<m.count] else m;
  }
  if e.kind == CP_MK_AGY {
    if e.slot >= 0 && e.slot < s[0].agy_models_n {
      return cast(string) s[0].agy_models[e.slot].name[0..<s[0].agy_models[e.slot].name_n];
    }
    return "Antigravity";
  }
  if e.kind == CP_MK_INKLING { return cp_inkling_label(s); }
  if e.kind == CP_MK_HYBRID { return "Hybrid Executor [E]"; }
  if e.kind == CP_MK_INKLING_NEON { return "Inkling + Neon (Hybrid)"; }
  if e.kind == CP_MK_CODEX { return "Codex"; }
  if e.kind == CP_MK_CURSOR { return "Cursor"; }
  if e.kind == CP_MK_ACP { return cast(string) s[0].prov[0].acp[e.slot].name[0..<s[0].prov[0].acp[e.slot].name_n]; }
  if e.kind == CP_MK_CLAUDE { clabels := CP_CLAUDE_LABEL; return clabels[e.slot]; }
  if e.kind == CP_MK_COMPUTE { return cp_compute_label_for(e.slot); }
  if e.kind == CP_MK_CORE { return cp_flawed_label_for(s, e.slot); }
  return "No model";
}

cp_model_short :: (idx: int) -> string {
  shorts := CP_MODEL_SHORT;
  return ifx idx >= 0 && idx < CP_MODELS then shorts[idx] else shorts[CP_MODEL_DEFAULT];
}

cp_model_desc :: (s: [] CoderPage, idx: int) -> string {
  e := cp_model_entry(s, idx);
  if e.kind == CP_MK_GEMINI {
    vx := CP_MODEL_DESC_VERTEX; api := CP_MODEL_DESC_API;
    return ifx s[0].gauth_vertex then vx[e.slot] else api[e.slot];
  }
  if e.kind == CP_MK_OPENROUTER { return "OpenRouter"; }
  if e.kind == CP_MK_AGY {
    if e.slot >= 0 && e.slot < s[0].agy_models_n {
      m := s[0].agy_models[e.slot];
      iname := ifx m.inst_name_n > 0 then cast(string) m.inst_name[0..<m.inst_name_n] else "Antigravity";
      n := cp_out(s[0].agy_desc[..], iname);
      n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], " · ");
      n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], cast(string) m.slug[0..<m.slug_n]);
      return cast(string) s[0].agy_desc[0..<n];
    }
    mode := ifx s[0].set_agy_mode == 1 then "Default" else ifx s[0].set_agy_mode == 2 then "Plan" else "Auto";
    n := cp_out(s[0].agy_desc[..], "Antigravity CLI · ");
    m := cp_agy_shown(s);
    if m.count > 0 { n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], m); n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], " · "); }
    n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], mode);
    return cast(string) s[0].agy_desc[0..<n];
  }
  if e.kind == CP_MK_INKLING { return cp_inkling_desc(s); }
  if e.kind == CP_MK_HYBRID {
    badge := ifx s[0].set_exec_badge_n > 0 then cast(string) s[0].set_exec_badge[0..<s[0].set_exec_badge_n] else "Exact Replay [E]";
    n := cp_out(s[0].hybrid_desc[..], "Psionic Metal · hybrid-exec-v1 · ");
    n += cp_out(s[0].hybrid_desc[n..<s[0].hybrid_desc.count], badge);
    return cast(string) s[0].hybrid_desc[0..<n];
  }
  if e.kind == CP_MK_INKLING_NEON { return "Local Inkling scout · Vertex Neon escalation · Free finish"; }
  if e.kind == CP_MK_CODEX { return "OpenAI Codex CLI · app-server"; }
  if e.kind == CP_MK_CURSOR { return "Cursor ACP CLI · agent acp"; }
  if e.kind == CP_MK_ACP {
    n := cp_out(s[0].prov[0].acp_desc_buf[..], "ACP Registry · ");
    n += cp_out(s[0].prov[0].acp_desc_buf[n..<s[0].prov[0].acp_desc_buf.count], cast(string) s[0].prov[0].acp[e.slot].program[0..<s[0].prov[0].acp[e.slot].program_n]);
    return cast(string) s[0].prov[0].acp_desc_buf[0..<n];
  }
  if e.kind == CP_MK_CLAUDE { cdescs := CP_CLAUDE_DESC; return cdescs[e.slot]; }
  if e.kind == CP_MK_COMPUTE { return cp_compute_desc_for(s, e.slot); }
  if e.kind == CP_MK_CORE { return cp_flawed_desc_for(s, e.slot); }
  return "Download Inkling 2 Mini in Settings → Models";
}

cp_agy_shown :: (s: [] CoderPage) -> string {
  if s[0].agy_seen_name_n > 0 { return cast(string) s[0].agy_seen_name[0..<s[0].agy_seen_name_n]; }
  if s[0].agy_seen_n > 0 { return cast(string) s[0].agy_seen[0..<s[0].agy_seen_n]; }
  m := cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n];
  return ifx m == "Default" then "" else m;
}
cp_agy_meta :: (s: [] CoderPage, model: string) -> string {
  n := cp_out(s[0].agy_meta[..], "Antigravity CLI · ");
  n += cp_out(s[0].agy_meta[n..<s[0].agy_meta.count], ifx model.count > 0 then model else "model not reported yet");
  return cast(string) s[0].agy_meta[0..<n];
}

// Who wrote turn i's reply: preserves the saved model id for kept chats even when that model's flag is off.
cp_turn_meta :: (s: [] CoderPage, i: int) -> string {
  t := s[0].turns[i].model;
  saved := cast(string) s[0].turns[i].saved_model[0..<s[0].turns[i].saved_model_n];
  if (cp_is_agy(s, t) || saved == "antigravity" || (saved.count > CP_AGY_PREFIX.count && cast(string) saved[0..<CP_AGY_PREFIX.count] == CP_AGY_PREFIX)) && s[0].turns[i].ran_n > 0 {
    ran := cast(string) s[0].turns[i].ran[0..<s[0].turns[i].ran_n];
    seen := cast(string) s[0].agy_seen[0..<s[0].agy_seen_n];
    return cp_agy_meta(s, ifx ran == seen && s[0].agy_seen_name_n > 0 then cast(string) s[0].agy_seen_name[0..<s[0].agy_seen_name_n] else ran);
  }
  if saved.count > 0 {
    idx := cp_model_find_exact(s, saved);
    if idx >= 0 { return cp_model_meta(s, idx); }
    return cp_model_known_meta(saved);
  }
  return cp_model_meta(s, t);
}

// Reply hover-lane info line: model/harness label plus measured decode speed (tok/s) and TTFT when available.
cp_turn_info_text :: (s: [] CoderPage, i: int, out: [] u8) -> string {
  n := el_put(out, 0, cp_turn_meta(s, i));
  tps := s[0].turns[i].tok_s_x10;
  if tps > 0 {
    n = el_put(out, n, " · ");
    n = el_put_i(out, n, tps / 10);
    n = el_put(out, n, ".");
    n = el_put_i(out, n, tps % 10);
    n = el_put(out, n, " tok/s");
  }
  ttft := s[0].turns[i].ttft_ms;
  if ttft > 0 {
    n = el_put(out, n, " · ");
    if ttft < 1000 {
      n = el_put_i(out, n, ttft);
      n = el_put(out, n, "ms TTFT");
    } else {
      ds := (ttft + 50) / 100;
      n = el_put_i(out, n, ds / 10);
      n = el_put(out, n, ".");
      n = el_put_i(out, n, ds % 10);
      n = el_put(out, n, "s TTFT");
    }
  }
  return cast(string) out[0..<n];
}

// Epoch ms when turn i finished. For legacy chats saved before per-turn done_ms existed,
// falls back to the active chat's updated_ms on the latest finished turn only.
cp_turn_done_ms :: (s: [] CoderPage, i: int) -> int {
  if i < 0 || i >= s[0].nturns { return 0; }
  if s[0].turns[i].done_ms > 0 { return s[0].turns[i].done_ms; }
  last_done := -1;
  for k: 0..<s[0].nturns {
    if s[0].turns[k].state != CP_RUNNING { last_done = k; }
  }
  if i != last_done || s[0].current_n <= 0 { return 0; }
  cur := cast(string) s[0].current[0..<s[0].current_n];
  for q: 0..<s[0].nchats {
    if cast(string) s[0].chats[q].id[0..<s[0].chats[q].id_n] == cur {
      return s[0].chats[q].updated_ms;
    }
  }
  return 0;
}

// Concise relative timestamp next to reply action buttons: "just now", "2m ago", "5h ago", "3d ago", "2w ago", "1y ago".
cp_turn_age :: (now_ms: int, at_ms: int, out: [] u8) -> string {
  if now_ms <= 0 || at_ms <= 0 || out.count < 16 { return ""; }
  sec := (now_ms - at_ms) / 1000;
  if sec < 0 { sec = 0; }
  if sec < 60 { return "just now"; }
  v := sec / 60; u: u8 = 'm';
  if sec >= 365 * 86400 { v = sec / (365 * 86400); u = 'y'; }
  else if sec >= 14 * 86400 { v = sec / (7 * 86400); u = 'w'; }
  else if sec >= 86400 { v = sec / 86400; u = 'd'; }
  else if sec >= 3600 { v = sec / 3600; u = 'h'; }
  n := el_put_i(out, 0, v);
  if n + 5 > out.count { return ""; }
  out[n] = u; n += 1;
  n = el_put(out, n, " ago");
  return cast(string) out[0..<n];
}

coder_page_agy_seen :: (s: [] CoderPage, id: string, name: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].agy_seen_n = cp_out(s[0].agy_seen[..], id);
  s[0].agy_seen_name_n = cp_out(s[0].agy_seen_name[..], name);
}

coder_page_settings_gauth :: (s: [] CoderPage, kind: string, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  ok := kind == "vertex" || kind == "key";
  s[0].set_gauth_n = ifx ok then cp_out(s[0].set_gauth[..], text) else 0;
  s[0].gauth_vertex = kind == "vertex";
  cp_model_restore_id(s, prev);
}

cp_model_meta :: (s: [] CoderPage, idx: int) -> string {
  e := cp_model_entry(s, idx);
  if e.kind == CP_MK_GEMINI { metas := CP_MODEL_META; return metas[e.slot]; }
  if e.kind == CP_MK_OPENROUTER {
    n := cp_out(s[0].or_meta[..], "OpenAgents · OpenRouter · ");
    n += cp_out(s[0].or_meta[n..<s[0].or_meta.count], cp_or_main(s));
    return cast(string) s[0].or_meta[0..<n];
  }
  if e.kind == CP_MK_AGY {
    if e.slot >= 0 && e.slot < s[0].agy_models_n {
      m := s[0].agy_models[e.slot];
      iname := ifx m.inst_name_n > 0 then cast(string) m.inst_name[0..<m.inst_name_n] else "Antigravity";
      n := cp_out(s[0].agy_meta[..], iname);
      n += cp_out(s[0].agy_meta[n..<s[0].agy_meta.count], " · ");
      n += cp_out(s[0].agy_meta[n..<s[0].agy_meta.count], cast(string) m.name[0..<m.name_n]);
      return cast(string) s[0].agy_meta[0..<n];
    }
    return cp_agy_meta(s, cp_agy_shown(s));
  }
  if e.kind == CP_MK_INKLING {
    n := cp_out(s[0].inkling_meta[..], "Psionic Metal · ");
    n += cp_out(s[0].inkling_meta[n..<s[0].inkling_meta.count], cp_inkling_label(s));
    return cast(string) s[0].inkling_meta[0..<n];
  }
  if e.kind == CP_MK_HYBRID { return "Psionic Metal · Hybrid Executor [E]"; }
  if e.kind == CP_MK_INKLING_NEON { return "Hybrid · Inkling + Gemini 4 Neon"; }
  if e.kind == CP_MK_CODEX { return "Codex CLI"; }
  if e.kind == CP_MK_CURSOR { return "Cursor ACP"; }
  if e.kind == CP_MK_ACP {
    n := cp_out(s[0].prov[0].acp_meta_buf[..], "ACP · ");
    n += cp_out(s[0].prov[0].acp_meta_buf[n..<s[0].prov[0].acp_meta_buf.count], cast(string) s[0].prov[0].acp[e.slot].name[0..<s[0].prov[0].acp[e.slot].name_n]);
    return cast(string) s[0].prov[0].acp_meta_buf[0..<n];
  }
  if e.kind == CP_MK_CLAUDE { cmetas := CP_CLAUDE_META; return cmetas[e.slot]; }
  if e.kind == CP_MK_COMPUTE { return cp_compute_meta_for(e.slot); }
  if e.kind == CP_MK_CORE { return cp_flawed_meta_for(s, e.slot); }
  return "No model";
}

coder_page_pick_model :: (s: [] CoderPage, name: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  idx := cp_model_find_exact(s, name);
  if idx < 0 { return false; }
  s[0].model = idx;
  s[0].flawed[0].user_picked = true;
  return true;
}

coder_page_set_openrouter :: (s: [] CoderPage, main: string, sub: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].or_main_n = ifx main.count <= CP_OR_ID then cp_out(s[0].or_main[..], main) else 0;
  s[0].or_sub_n = ifx sub.count <= CP_OR_ID then cp_out(s[0].or_sub[..], sub) else 0;
  cp_model_restore_id(s, prev);
}

coder_page_agy_models_clear :: (s: [] CoderPage) #export_c #effects(all) {
  if s.count < 1 { return; }
  prev := cp_model_save_id(s, s[0].agy_prev_id[..]);
  s[0].agy_prev_id_n = prev.count;
  s[0].agy_models_n = 0;
}

coder_page_agy_models_add :: (s: [] CoderPage, inst_id: string, inst_name: string, slug: string, name: string, efforts_mask: int, default_effort: int, is_default: bool) -> int #export_c #effects(all) {
  if s.count < 1 || slug.count == 0 || s[0].agy_models_n >= CP_AGY_MODELS_MAX { return -1; }
  if !cp_agy_is_gemini4(slug, name) { return -1; }
  i := s[0].agy_models_n;
  s[0].agy_models[i] = CpAgyModel.{};
  s[0].agy_models[i].inst_id_n = cp_out(s[0].agy_models[i].inst_id[..], inst_id);
  s[0].agy_models[i].inst_name_n = cp_out(s[0].agy_models[i].inst_name[..], ifx inst_name.count > 0 then inst_name else "Antigravity");
  s[0].agy_models[i].slug_n = cp_out(s[0].agy_models[i].slug[..], slug);
  s[0].agy_models[i].name_n = cp_out(s[0].agy_models[i].name[..], ifx name.count > 0 then name else slug);
  s[0].agy_models[i].efforts_mask = efforts_mask;
  s[0].agy_models[i].default_effort = default_effort;
  s[0].agy_models[i].is_default = is_default;
  s[0].agy_models_n += 1;
  return i;
}

coder_page_model_inst_id :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || out.count < 1 { return 0; }
  slot := cp_agy_loaded_slot(s, cp_model_index(s));
  if slot < 0 { return 0; }
  return cp_out(out, cast(string) s[0].agy_models[slot].inst_id[0..<s[0].agy_models[slot].inst_id_n]);
}

coder_page_set_agy :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [128] u8;
  prev := "";
  if s[0].agy_prev_id_n > 0 {
    prev = cast(string) pb[0..<cp_out(pb[..], cast(string) s[0].agy_prev_id[0..<s[0].agy_prev_id_n])];
    s[0].agy_prev_id_n = 0;
  } else {
    prev = cp_model_save_id(s, pb[..]);
  }
  s[0].agy = on;
  // On a machine where local Inkling cannot run (!local_os_ok || !local_hw_ok), connecting
  // Antigravity from onboarding opts into showing it and selects Antigravity cleanly.
  if on && !s[0].inkling && (!s[0].local_os_ok || !s[0].local_hw_ok) {
    s[0].show_other_models = true;
    agy_def := cp_agy_default_idx(s);
    if agy_def >= 0 { s[0].model = agy_def; return; }
  }
  cp_model_restore_id(s, prev);
}

coder_page_set_inkling :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  was := s[0].inkling;
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].inkling = on;
  // Promote an untouched fresh chat from Neon fallback -> Flawed Inkling 2 Mini once weights verify (or fall back if uninstalled).
  if was != on && s[0].nturns == 0 && !cp_running(s) && !s[0].flawed[0].user_picked && s[0].flawed[0].default_agent == 0 && s[0].flawed[0].model_slot == CP_FLAWED_START_LOCAL {
    s[0].model = cp_model_start(s);
    s[0].model = cp_model_index(s);
    return;
  }
  cp_model_restore_id(s, prev);
}

coder_page_set_inkling_info :: (s: [] CoderPage, id: string, label: string, desc: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].inkling_id_n = cp_out(s[0].inkling_id[..], id);
  s[0].inkling_label_n = cp_out(s[0].inkling_label[..], label);
  s[0].inkling_desc_n = cp_out(s[0].inkling_desc[..], desc);
}

coder_page_show_other_models_set :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [128] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].show_other_models = on;
  cp_model_restore_id(s, prev);
}

coder_page_show_other_models :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && s[0].show_other_models;
}

coder_page_set_hybrid_exec :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].hybrid_exec = on;
  cp_model_restore_id(s, prev);
}

coder_page_set_cloud_authed :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].cloud_authed = on;
  cp_model_restore_id(s, prev);
}

cp_backend_label :: (s: [] CoderPage) -> string {
  e := cp_model_entry(s, cp_model_index(s));
  if e.kind == CP_MK_NONE { return ""; }
  if e.kind == CP_MK_AGY { return "Antigravity CLI"; }
  if e.kind == CP_MK_INKLING { return "Psionic Metal"; }
  if e.kind == CP_MK_HYBRID { return "Psionic Metal · [E]"; }
  if e.kind == CP_MK_INKLING_NEON { return "Inkling + Vertex AI"; }
  if e.kind == CP_MK_CODEX { return "Codex CLI"; }
  if e.kind == CP_MK_CURSOR { return "Cursor ACP"; }
  if e.kind == CP_MK_ACP { return "ACP Registry"; }
  if e.kind == CP_MK_CLAUDE { return "Claude Code"; }
  if e.kind == CP_MK_CORE || e.kind == CP_MK_COMPUTE { return "OpenAgents"; }
  if e.kind == CP_MK_OPENROUTER { return "OpenRouter"; }
  if s[0].gauth_vertex { return "Vertex AI"; }
  return "Gemini API";
}

coder_page_cloud_ok :: (s: [] CoderPage) -> bool #export_c #effects(all) { return cp_cloud_ok(s); }
coder_page_model_agy :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_is_agy(s, cp_model_index(s)); }
coder_page_model_inkling :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_is_inkling(s, cp_model_index(s)); }
coder_page_model_hybrid :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_is_hybrid(s, cp_model_index(s)); }
coder_page_model_claude :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_is_claude(s, cp_model_index(s)); }

// ---------------------------------------------------------------- effort

// The chat's thinking level, beside the model in the composer's foot as Zeron and Claude Code show
// it: CP_EFFORT_DEFAULT until the person picks one, then low, medium or high, kept with the chat.
// A chat on a Claude model has two more, x-high and max (Claude Code's --effort levels); on any
// other model they run as high.
CP_EFFORT_DEFAULT :: 0; CP_EFFORT_LOW :: 1; CP_EFFORT_MEDIUM :: 2; CP_EFFORT_HIGH :: 3; CP_EFFORT_XHIGH :: 4; CP_EFFORT_MAX :: 5;
CP_EFFORT_WORD :: [6] string.["", "low", "medium", "high", "xhigh", "max"];
CP_EFFORT_LABEL :: [6] string.["", "Low", "Medium", "High", "X-High", "Max"];
CP_EFFORT_DESC :: [6] string.["", "Fast, minimal reasoning", "Balanced speed & depth", "Deep reasoning", "Extra-deep reasoning", "Maximum reasoning"];
cp_agy_has_xhigh :: (s: [] CoderPage, idx: int) -> bool {
  slot := cp_agy_loaded_slot(s, idx);
  return slot >= 0 && (s[0].agy_models[slot].efforts_mask & CP_EFF_BIT_XHIGH) != 0;
}
cp_effort_count :: (s: [] CoderPage, idx: int) -> int {
  if cp_is_claude(s, idx) || cp_is_flawed(s, idx) { return CP_CLAUDE_EFFORTS; }
  if cp_agy_has_xhigh(s, idx) { return 4; }
  return 3;
}
cp_effort_desc :: (level: int) -> string {
  descs := CP_EFFORT_DESC;
  return ifx level >= CP_EFFORT_LOW && level <= CP_EFFORT_MAX then descs[level] else "";
}
// The thinking level Settings set for Claude model slot (which of CP_CLAUDE_ID), 0..<CP_CLAUDE_EFFORTS.
cp_claude_effort :: (s: [] CoderPage, slot: int) -> int {
  if s.count < 1 || slot < 0 || slot >= CP_CLAUDE_MODELS { return CP_CLAUDE_EFFORT_START; }
  e := s[0].claude_effort[slot] + CP_CLAUDE_EFFORT_START;
  return ifx e >= 0 && e < CP_CLAUDE_EFFORTS then e else CP_CLAUDE_EFFORT_START;
}
// Settings > Models: Claude model slot (0 Fable 5.2, 1 Opus 5.5, 2 Sonnet 5.5, 3 Haiku 5.5) runs at
// level (0 low, 1 medium, 2 high, 3 x-high, 4 max), as the chat's main model and as a sub-agent.
coder_page_claude_effort_set :: (s: [] CoderPage, slot: int, level: int) #export_c #effects(all) {
  if s.count < 1 || slot < 0 || slot >= CP_CLAUDE_MODELS { return; }
  s[0].claude_effort[slot] = (ifx level >= 0 && level < CP_CLAUDE_EFFORTS then level else CP_CLAUDE_EFFORT_START) - CP_CLAUDE_EFFORT_START;
}
coder_page_claude_effort :: (s: [] CoderPage, slot: int) -> int #export_c #effects(all) { return cp_claude_effort(s, slot); }
cp_effort_of :: (word: string) -> int {
  words := CP_EFFORT_WORD;
  for i: 1..<6 { if word == words[i] { return i; } }
  return CP_EFFORT_DEFAULT;
}
// The level a model runs at when the chat names none: for Antigravity, the effort Settings sets
// (its model summary, "MODEL · high"), else agyworker's own, high; a Claude model's, the level
// Settings set for it (high until then); Inkling / Hybrid Executor models, medium; Microcoder's
// cloud models, low.
cp_effort_default :: (s: [] CoderPage, idx: int) -> int {
  if cp_is_flawed(s, idx) { return cp_flawed_effort(s) + CP_EFFORT_LOW; }
  cslot := cp_claude_slot(s, idx);
  if cslot >= 0 { return cp_claude_effort(s, cslot) + CP_EFFORT_LOW; }   // the level Settings set for this Claude model
  if cp_is_inkling(s, idx) || cp_is_hybrid(s, idx) || cp_is_inkling_neon(s, idx) { return CP_EFFORT_MEDIUM; }
  if !cp_is_agy(s, idx) { return CP_EFFORT_LOW; }
  aslot := cp_agy_loaded_slot(s, idx);
  if aslot >= 0 {
    def_e := s[0].agy_models[aslot].default_effort;
    top := CP_EFFORT_LOW + cp_effort_count(s, idx) - 1;
    if def_e >= CP_EFFORT_LOW && def_e <= top { return def_e; }
    return CP_EFFORT_HIGH;
  }
  m := cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n];
  dot := " · ";
  if m.count > dot.count {
    for i: 0..<m.count - dot.count + 1 {
      if cast(string) m[i..<i + dot.count] == dot { e := cp_effort_of(cast(string) m[i + dot.count..<m.count]); if e != CP_EFFORT_DEFAULT { return e; } }
    }
  }
  return CP_EFFORT_HIGH;
}
cp_effort_at :: (s: [] CoderPage, idx: int) -> int {
  e := s[0].effort;
  top := CP_EFFORT_LOW + cp_effort_count(s, idx) - 1;
  if e >= CP_EFFORT_LOW && e <= CP_EFFORT_MAX { return ifx e > top then top else e; }
  return cp_effort_default(s, idx);
}
cp_effort_label :: (s: [] CoderPage, idx: int) -> string { labels := CP_EFFORT_LABEL; return labels[cp_effort_at(s, idx)]; }
cp_task_effort :: (s: [] CoderPage, model: int) -> string {
  words := CP_EFFORT_WORD;
  if s[0].effort >= CP_EFFORT_LOW && s[0].effort <= CP_EFFORT_MAX { return words[cp_effort_at(s, model)]; }
  if cp_agy_loaded_slot(s, model) >= 0 { return words[cp_effort_default(s, model)]; }
  if cp_is_flawed(s, model) || cp_is_claude(s, model) || cp_is_inkling(s, model) || cp_is_hybrid(s, model) || cp_is_inkling_neon(s, model) { return words[cp_effort_default(s, model)]; }
  return ifx cp_is_agy(s, model) then "" else "low";
}
// A press on the effort chip: the next level after the one shown, the top one wrapping to low:
// high, x-high for Antigravity models that support it, or max for a chat on a Claude model.
cp_effort_cycle :: (s: [] CoderPage) {
  idx := cp_model_index(s);
  e := cp_effort_at(s, idx);
  top := CP_EFFORT_LOW + cp_effort_count(s, idx) - 1;
  s[0].effort = ifx e >= top then CP_EFFORT_LOW else e + 1;
}
