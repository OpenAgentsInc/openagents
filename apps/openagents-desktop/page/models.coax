// Coder Desktop page (../page.coax): the composer's model list, the OpenRouter main and sub-agent
// models, and the picker's host calls.

// Cloud/Microcoder models (Gemini + OpenRouter) are available when the user has entered their own
// Gemini API key in Settings, or when Experimental features are on and the user is signed into an
// OpenAgents account. Otherwise the app is local-harness-only (Antigravity).
// The sign-in mcworker --auth finds (Vertex AI from a service account or ADC, or a Gemini API key
// in ~/work/.secrets or the environment) counts the same as a key set in Settings.
cp_cloud_ok :: (s: [] CoderPage) -> bool { return s.count > 0 && (s[0].set_gemini_n > 0 || s[0].set_gauth_n > 0 || (s[0].experimental && s[0].cloud_authed)); }
// How many entries the picker has: cloud models when authed (Gemini + optional OpenRouter), and Antigravity when installed.
cp_models :: (s: [] CoderPage) -> int {
  if !cp_cloud_ok(s) {
    n := 0;
    if s.count > 0 && s[0].agy { n += 1; }
    if s.count > 0 && s[0].inkling { n += 1; }
    if s.count > 0 && s[0].hybrid_exec { n += 1; }
    if s.count > 0 && s[0].prov[0].codex { n += 1; }
    if s.count > 0 && s[0].prov[0].cursor { n += 1; }
    n += cp_acp_enabled_count(s);
    if s.count > 0 && s[0].claude { n += CP_CLAUDE_MODELS; }
    return n;
  }
  n := CP_MODELS;
  if s[0].or_main_n > 0 { n += 1; }
  if s[0].agy { n += 1; }
  if s[0].inkling { n += 1; }
  if s[0].hybrid_exec { n += 1; }
  if cp_has_inkling_neon(s) { n += 1; }
  if s[0].prov[0].codex { n += 1; }
  if s[0].prov[0].cursor { n += 1; }
  n += cp_acp_enabled_count(s);
  if s[0].claude { n += CP_CLAUDE_MODELS; }
  return n;
}
// The Claude entries, after every other: where they start, which of them the entry at idx is
// (-1: none), and one by a name (its id, its label, or fable, opus, sonnet, haiku; -1: none).
cp_claude_base_idx :: (s: [] CoderPage) -> int { return cp_acp_base_idx(s) + cp_acp_enabled_count(s); }
cp_claude_slot :: (s: [] CoderPage, idx: int) -> int {
  if s.count < 1 || !s[0].claude { return -1; }
  k := idx - cp_claude_base_idx(s);
  return ifx k >= 0 && k < CP_CLAUDE_MODELS then k else -1;
}
cp_is_claude :: (s: [] CoderPage, idx: int) -> bool { return cp_claude_slot(s, idx) >= 0; }
cp_claude_find :: (name: string) -> int {
  ids := CP_CLAUDE_ID; labels := CP_CLAUDE_LABEL; alias := CP_CLAUDE_ALIAS;
  for i: 0..<CP_CLAUDE_MODELS { if name == ids[i] || name == labels[i] || name == alias[i] { return i; } }
  return -1;
}
// A chat on a Claude entry stays on it when the entries before it change: slot is what
// cp_claude_slot said before the change.
cp_claude_keep :: (s: [] CoderPage, slot: int) { if slot >= 0 && s[0].claude { s[0].model = cp_claude_base_idx(s) + slot; } }
// The entry a new chat starts on: the Claude model Settings picked when Claude Code is installed, else Neon.
cp_model_start :: (s: [] CoderPage) -> int {
  if s.count > 0 && s[0].orch_claude && s[0].claude {
    k := ifx s[0].orch_model >= 0 && s[0].orch_model < CP_CLAUDE_MODELS then s[0].orch_model else CP_CLAUDE_START;
    return cp_claude_base_idx(s) + k;
  }
  return CP_MODEL_DEFAULT;
}
// Settings > Models: whether new chats start on Claude, and on which Claude model (0 Fable 5.2,
// 1 Opus 5.5, 2 Sonnet 5.5, 3 Haiku 5.5). A chat with no message yet moves to it now.
coder_page_orchestrator_set :: (s: [] CoderPage, claude: bool, model: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].orch_claude = claude;
  s[0].orch_model = ifx model >= 0 && model < CP_CLAUDE_MODELS then model else CP_CLAUDE_START;
  if s[0].nturns == 0 && !cp_running(s) { s[0].model = cp_model_start(s); s[0].model = cp_model_index(s); }
}
// What Settings picked: 0 Neon, 1 Claude; and the Claude model.
coder_page_orchestrator :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].orch_claude then 1 else 0; }
coder_page_orchestrator_model :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].orch_model else CP_CLAUDE_START; }
cp_agy_idx :: (s: [] CoderPage) -> int {
  if s.count < 1 || !s[0].agy { return -1; }
  if !cp_cloud_ok(s) { return 0; }
  return ifx s[0].or_main_n > 0 then CP_MODELS + 1 else CP_MODELS;
}
cp_is_agy :: (s: [] CoderPage, idx: int) -> bool { return s.count > 0 && s[0].agy && idx == cp_agy_idx(s); }
cp_inkling_idx :: (s: [] CoderPage) -> int {
  if s.count < 1 || !s[0].inkling { return -1; }
  if !cp_cloud_ok(s) { return ifx s[0].agy then 1 else 0; }
  n := CP_MODELS;
  if s[0].or_main_n > 0 { n += 1; }
  if s[0].agy { n += 1; }
  return n;
}
cp_is_inkling :: (s: [] CoderPage, idx: int) -> bool { return s.count > 0 && s[0].inkling && idx == cp_inkling_idx(s); }
cp_hybrid_idx :: (s: [] CoderPage) -> int {
  if s.count < 1 || !s[0].hybrid_exec { return -1; }
  n := 0;
  if cp_cloud_ok(s) {
    n = CP_MODELS;
    if s[0].or_main_n > 0 { n += 1; }
  }
  if s[0].agy { n += 1; }
  if s[0].inkling { n += 1; }
  return n;
}
cp_is_hybrid :: (s: [] CoderPage, idx: int) -> bool { return s.count > 0 && s[0].hybrid_exec && idx == cp_hybrid_idx(s); }
cp_has_inkling_neon :: (s: [] CoderPage) -> bool { return s.count > 0 && cp_cloud_ok(s) && s[0].inkling; }
cp_inkling_neon_idx :: (s: [] CoderPage) -> int {
  if !cp_has_inkling_neon(s) { return -1; }
  n := CP_MODELS;
  if s[0].or_main_n > 0 { n += 1; }
  if s[0].agy { n += 1; }
  if s[0].inkling { n += 1; }
  if s[0].hybrid_exec { n += 1; }
  return n;
}
cp_is_inkling_neon :: (s: [] CoderPage, idx: int) -> bool { return cp_has_inkling_neon(s) && idx == cp_inkling_neon_idx(s); }
cp_model_index :: (s: [] CoderPage) -> int {
  n := cp_models(s);
  if s.count > 0 && s[0].model >= 0 && s[0].model < n { return s[0].model; }
  if !cp_cloud_ok(s) { return ifx n > 0 then 0 else -1; }
  return CP_MODEL_DEFAULT;
}
// A kept model's entry: a Gemini id or short name, or any "openrouter:" id (CP_MODEL_OR).
cp_model_find :: (name: string) -> int {
  if name.count > CP_OR_PREFIX.count && cast(string) name[0..<CP_OR_PREFIX.count] == CP_OR_PREFIX { return CP_MODEL_OR; }
  ids := CP_MODEL_ID; shorts := CP_MODEL_SHORT;
  for i: 0..<CP_MODELS {
    if name == ids[i] || name == shorts[i] { return i; }
  }
  return CP_MODEL_DEFAULT;
}
cp_model_find_s :: (s: [] CoderPage, name: string) -> int {
  if name == "antigravity" || name == "Antigravity" || name == "agy" {
    if s.count > 0 && s[0].agy { return cp_agy_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name == "inkling-2-mini" || name == "inkling" || name == "Inkling 2 Mini" {
    if s.count > 0 && s[0].inkling { return cp_inkling_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name == "hybrid-exec-v1" || name == "hybrid-executor" || name == "Hybrid Executor" || name == "Hybrid Executor [E]" {
    if s.count > 0 && s[0].hybrid_exec { return cp_hybrid_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name == "inkling-neon" || name == "hybrid-neon" || name == "inkling+neon" || name == "Inkling + Neon" {
    if cp_has_inkling_neon(s) { return cp_inkling_neon_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name == "codex" || name == "Codex" {
    if s.count > 0 && s[0].prov[0].codex { return cp_codex_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name == "cursor" || name == "Cursor" {
    if s.count > 0 && s[0].prov[0].cursor { return cp_cursor_idx(s); }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if name.count > CP_ACP_PREFIX.count && cast(string) name[0..<CP_ACP_PREFIX.count] == CP_ACP_PREFIX {
    aid := cast(string) name[CP_ACP_PREFIX.count..<name.count];
    en := cp_acp_enabled_count(s);
    base := cp_acp_base_idx(s);
    for k: 0..<en {
      slot := cp_acp_nth_enabled(s, k);
      if slot >= 0 && cast(string) s[0].prov[0].acp[slot].id[0..<s[0].prov[0].acp[slot].id_n] == aid {
        return base + k;
      }
    }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  cslot := cp_claude_find(name);
  if cslot >= 0 {
    if s.count > 0 && s[0].claude { return cp_claude_base_idx(s) + cslot; }
    return ifx cp_cloud_ok(s) then CP_MODEL_DEFAULT else -1;
  }
  if !cp_cloud_ok(s) { return ifx cp_models(s) > 0 then 0 else -1; }
  return cp_model_find(name);
}
cp_or_main :: (s: [] CoderPage) -> string { return cast(string) s[0].or_main[0..<s[0].or_main_n]; }
cp_or_sub :: (s: [] CoderPage) -> string { return cast(string) s[0].or_sub[0..<s[0].or_sub_n]; }
cp_is_or :: (s: [] CoderPage, idx: int) -> bool { return cp_cloud_ok(s) && idx == CP_MODEL_OR && s[0].or_main_n > 0; }
// The worker's model id for an entry: "openrouter:VENDOR/MODEL" for OpenRouter, "antigravity" for Antigravity.
cp_model_id :: (s: [] CoderPage, idx: int) -> string {
  if cp_is_agy(s, idx) { return "antigravity"; }
  if cp_is_inkling(s, idx) { return "inkling-2-mini"; }
  if cp_is_hybrid(s, idx) { return "hybrid-exec-v1"; }
  if cp_is_inkling_neon(s, idx) { return "inkling-neon"; }
  if cp_is_codex(s, idx) { return "codex"; }
  if cp_is_cursor(s, idx) { return "cursor"; }
  acp_slot := cp_acp_slot_for_model(s, idx);
  if acp_slot >= 0 {
    n := cp_out(s[0].prov[0].acp_id_buf[..], CP_ACP_PREFIX);
    n += cp_out(s[0].prov[0].acp_id_buf[n..<s[0].prov[0].acp_id_buf.count], cast(string) s[0].prov[0].acp[acp_slot].id[0..<s[0].prov[0].acp[acp_slot].id_n]);
    return cast(string) s[0].prov[0].acp_id_buf[0..<n];
  }
  cslot := cp_claude_slot(s, idx);
  if cslot >= 0 { cids := CP_CLAUDE_ID; return cids[cslot]; }
  if !cp_cloud_ok(s) { return ""; }
  if cp_is_or(s, idx) { return cast(string) s[0].or_id[0..<cp_out(s[0].or_id[..], CP_OR_PREFIX) + cp_out(s[0].or_id[CP_OR_PREFIX.count..<s[0].or_id.count], cp_or_main(s))]; }
  ids := CP_MODEL_ID;
  return ifx idx >= 0 && idx < CP_MODELS then ids[idx] else ids[CP_MODEL_DEFAULT];
}
// The OpenRouter entry's label is the model's name after its vendor (deepseek-v4.1-flash-1017).
cp_model_label :: (s: [] CoderPage, idx: int) -> string {
  if cp_is_agy(s, idx) { return "Antigravity"; }
  if cp_is_inkling(s, idx) { return "Inkling 2 Mini (Local)"; }
  if cp_is_hybrid(s, idx) { return "Hybrid Executor [E]"; }
  if cp_is_inkling_neon(s, idx) { return "Inkling + Neon (Hybrid)"; }
  if cp_is_codex(s, idx) { return "Codex"; }
  if cp_is_cursor(s, idx) { return "Cursor"; }
  acp_slot := cp_acp_slot_for_model(s, idx);
  if acp_slot >= 0 { return cast(string) s[0].prov[0].acp[acp_slot].name[0..<s[0].prov[0].acp[acp_slot].name_n]; }
  cslot := cp_claude_slot(s, idx);
  if cslot >= 0 { clabels := CP_CLAUDE_LABEL; return clabels[cslot]; }
  if !cp_cloud_ok(s) { return "No model"; }
  if cp_is_or(s, idx) {
    m := cp_or_main(s); at := 0;
    for c, i: m { if c == '/' { at = i + 1; } }
    return ifx at < m.count then cast(string) m[at..<m.count] else m;
  }
  labels := CP_MODEL_LABEL;
  return ifx idx >= 0 && idx < CP_MODELS then labels[idx] else labels[CP_MODEL_DEFAULT];
}
cp_model_short :: (idx: int) -> string {
  shorts := CP_MODEL_SHORT;
  return ifx idx >= 0 && idx < CP_MODELS then shorts[idx] else shorts[CP_MODEL_DEFAULT];
}
cp_model_desc :: (s: [] CoderPage, idx: int) -> string {
  // the Antigravity CLI and the review mode picked in Settings, never the protocol's name
  if cp_is_agy(s, idx) {
    mode := ifx s[0].set_agy_mode == 1 then "Default" else ifx s[0].set_agy_mode == 2 then "Plan" else "Auto";
    n := cp_out(s[0].agy_desc[..], "Antigravity CLI · ");
    m := cp_agy_shown(s);
    if m.count > 0 { n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], m); n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], " · "); }
    n += cp_out(s[0].agy_desc[n..<s[0].agy_desc.count], mode);
    return cast(string) s[0].agy_desc[0..<n];
  }
  if cp_is_inkling(s, idx) { return "Psionic Metal · Local · 26.4B/3.4B MoE"; }
  if cp_is_hybrid(s, idx) {
    badge := ifx s[0].set_exec_badge_n > 0 then cast(string) s[0].set_exec_badge[0..<s[0].set_exec_badge_n] else "Exact Replay [E]";
    n := cp_out(s[0].hybrid_desc[..], "Psionic Metal · hybrid-exec-v1 · ");
    n += cp_out(s[0].hybrid_desc[n..<s[0].hybrid_desc.count], badge);
    return cast(string) s[0].hybrid_desc[0..<n];
  }
  if cp_is_inkling_neon(s, idx) { return "Local Inkling scout · Vertex Neon escalation · Free finish"; }
  if cp_is_codex(s, idx) { return "OpenAI Codex CLI · app-server"; }
  if cp_is_cursor(s, idx) { return "Cursor ACP CLI · agent acp"; }
  acp_slot := cp_acp_slot_for_model(s, idx);
  if acp_slot >= 0 {
    n := cp_out(s[0].prov[0].acp_desc_buf[..], "ACP Registry · ");
    n += cp_out(s[0].prov[0].acp_desc_buf[n..<s[0].prov[0].acp_desc_buf.count], cast(string) s[0].prov[0].acp[acp_slot].program[0..<s[0].prov[0].acp[acp_slot].program_n]);
    return cast(string) s[0].prov[0].acp_desc_buf[0..<n];
  }
  cslot := cp_claude_slot(s, idx);
  if cslot >= 0 { cdescs := CP_CLAUDE_DESC; return cdescs[cslot]; }
  if !cp_cloud_ok(s) { return "Install Antigravity CLI (agy) or download a Local Model"; }
  if cp_is_or(s, idx) { return "OpenRouter"; }
  // fixed strings per model and backend: the palette and the menu keep these strings, so one shared
  // buffer would give every row the last model's line
  vx := CP_MODEL_DESC_VERTEX; api := CP_MODEL_DESC_API;
  i := ifx idx >= 0 && idx < CP_MODELS then idx else CP_MODEL_DEFAULT;
  return ifx s[0].gauth_vertex then vx[i] else api[i];
}
// The model Antigravity runs, never "default": what agy said it opens a session on with these
// settings (agyworker --probe), else the model Settings names for it, else "" (not known yet).
cp_agy_shown :: (s: [] CoderPage) -> string {
  if s[0].agy_seen_name_n > 0 { return cast(string) s[0].agy_seen_name[0..<s[0].agy_seen_name_n]; }
  if s[0].agy_seen_n > 0 { return cast(string) s[0].agy_seen[0..<s[0].agy_seen_n]; }
  m := cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n];
  return ifx m == "Default" then "" else m;
}
cp_agy_meta :: (s: [] CoderPage, model: string) -> string {
  n := cp_out(s[0].agy_meta[..], "Antigravity CLI · ");
  n += cp_out(s[0].agy_meta[n..<s[0].agy_meta.count], ifx model.count > 0 then model else "model not reported yet");
  return cast(string) s[0].agy_meta[0..<n];
}
// Who wrote turn i's reply: its harness and the model it reported running on, else its entry's.
cp_turn_meta :: (s: [] CoderPage, i: int) -> string {
  t := s[0].turns[i].model;
  if cp_is_agy(s, t) && s[0].turns[i].ran_n > 0 {
    ran := cast(string) s[0].turns[i].ran[0..<s[0].turns[i].ran_n];
    seen := cast(string) s[0].agy_seen[0..<s[0].agy_seen_n];
    return cp_agy_meta(s, ifx ran == seen && s[0].agy_seen_name_n > 0 then cast(string) s[0].agy_seen_name[0..<s[0].agy_seen_name_n] else ran);
  }
  return cp_model_meta(s, t);
}
// The model the host's Antigravity probe found (id, name; "" not known), for the picker and Settings.
coder_page_agy_seen :: (s: [] CoderPage, id: string, name: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].agy_seen_n = cp_out(s[0].agy_seen[..], id);
  s[0].agy_seen_name_n = cp_out(s[0].agy_seen_name[..], name);
}
// The sign-in Gemini models run on, from mcworker --auth: kind "vertex", "key" or "none", and its text.
coder_page_settings_gauth :: (s: [] CoderPage, kind: string, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_agy := cp_is_agy(s, s[0].model);
  was_inkling := cp_is_inkling(s, s[0].model);
  was_hybrid := cp_is_hybrid(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  ok := kind == "vertex" || kind == "key";
  s[0].set_gauth_n = ifx ok then cp_out(s[0].set_gauth[..], text) else 0;
  s[0].gauth_vertex = kind == "vertex";
  if was_agy { s[0].model = cp_agy_idx(s); }
  if was_inkling { s[0].model = cp_inkling_idx(s); }
  if was_hybrid { s[0].model = cp_hybrid_idx(s); }
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
cp_model_meta :: (s: [] CoderPage, idx: int) -> string {
  if cp_is_agy(s, idx) {
    return cp_agy_meta(s, cp_agy_shown(s));
  }
  if cp_is_inkling(s, idx) { return "Psionic Metal · Inkling 2 Mini"; }
  if cp_is_hybrid(s, idx) { return "Psionic Metal · Hybrid Executor [E]"; }
  if cp_is_inkling_neon(s, idx) { return "Hybrid · Inkling + Gemini 4 Neon"; }
  if cp_is_codex(s, idx) { return "Codex CLI"; }
  if cp_is_cursor(s, idx) { return "Cursor ACP"; }
  acp_slot := cp_acp_slot_for_model(s, idx);
  if acp_slot >= 0 {
    n := cp_out(s[0].prov[0].acp_meta_buf[..], "ACP · ");
    n += cp_out(s[0].prov[0].acp_meta_buf[n..<s[0].prov[0].acp_meta_buf.count], cast(string) s[0].prov[0].acp[acp_slot].name[0..<s[0].prov[0].acp[acp_slot].name_n]);
    return cast(string) s[0].prov[0].acp_meta_buf[0..<n];
  }
  cslot := cp_claude_slot(s, idx);
  if cslot >= 0 { cmetas := CP_CLAUDE_META; return cmetas[cslot]; }
  if !cp_cloud_ok(s) { return "No model"; }
  if cp_is_or(s, idx) {
    n := cp_out(s[0].or_meta[..], "Microcoder · OpenRouter · ");
    n += cp_out(s[0].or_meta[n..<s[0].or_meta.count], cp_or_main(s));
    return cast(string) s[0].or_meta[0..<n];
  }
  metas := CP_MODEL_META;
  return ifx idx >= 0 && idx < CP_MODELS then metas[idx] else metas[CP_MODEL_DEFAULT];
}
// The OpenRouter models the person set (Coder > OpenRouter Models): main for Microcoder, sub for
// sub-agents, each "" for none. A chat on the OpenRouter entry goes back to Neon when main is cleared.
// The shown chat's model by name (a launch's --model): a Gemini id or short name, "openrouter"
// (or an "openrouter:" id), or "antigravity"/"agy". False when no entry has that name.
coder_page_pick_model :: (s: [] CoderPage, name: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  if name == "antigravity" || name == "Antigravity" || name == "agy" {
    if !s[0].agy { return false; }
    s[0].model = cp_agy_idx(s);
    return true;
  }
  if name == "inkling-2-mini" || name == "inkling" || name == "Inkling 2 Mini" {
    if !s[0].inkling { return false; }
    s[0].model = cp_inkling_idx(s);
    return true;
  }
  if name == "hybrid-exec-v1" || name == "hybrid-executor" || name == "Hybrid Executor" || name == "Hybrid Executor [E]" {
    if !s[0].hybrid_exec { return false; }
    s[0].model = cp_hybrid_idx(s);
    return true;
  }
  if name == "inkling-neon" || name == "hybrid-neon" || name == "inkling+neon" || name == "Inkling + Neon" {
    if !cp_has_inkling_neon(s) { return false; }
    s[0].model = cp_inkling_neon_idx(s);
    return true;
  }
  if name == "codex" || name == "Codex" {
    if !s[0].prov[0].codex { return false; }
    s[0].model = cp_codex_idx(s);
    return true;
  }
  if name == "cursor" || name == "Cursor" {
    if !s[0].prov[0].cursor { return false; }
    s[0].model = cp_cursor_idx(s);
    return true;
  }
  if name.count > CP_ACP_PREFIX.count && cast(string) name[0..<CP_ACP_PREFIX.count] == CP_ACP_PREFIX {
    aid := cast(string) name[CP_ACP_PREFIX.count..<name.count];
    en := cp_acp_enabled_count(s);
    base := cp_acp_base_idx(s);
    for k: 0..<en {
      slot := cp_acp_nth_enabled(s, k);
      if slot >= 0 && cast(string) s[0].prov[0].acp[slot].id[0..<s[0].prov[0].acp[slot].id_n] == aid {
        s[0].model = base + k;
        return true;
      }
    }
    return false;
  }
  cslot := cp_claude_find(name);
  if cslot >= 0 {
    if !s[0].claude { return false; }
    s[0].model = cp_claude_base_idx(s) + cslot;
    return true;
  }
  if !cp_cloud_ok(s) { return false; }
  idx := ifx name == "openrouter" then CP_MODEL_OR else cp_model_find(name);
  if idx == CP_MODEL_DEFAULT && name != cp_model_id(s, CP_MODEL_DEFAULT) && name != cp_model_short(CP_MODEL_DEFAULT) { return false; }
  if idx >= cp_models(s) { return false; }
  s[0].model = idx;
  return true;
}
coder_page_set_openrouter :: (s: [] CoderPage, main: string, sub: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_agy := cp_is_agy(s, s[0].model);
  was_inkling := cp_is_inkling(s, s[0].model);
  was_hybrid := cp_is_hybrid(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  s[0].or_main_n = ifx main.count <= CP_OR_ID then cp_out(s[0].or_main[..], main) else 0;
  s[0].or_sub_n = ifx sub.count <= CP_OR_ID then cp_out(s[0].or_sub[..], sub) else 0;
  if was_agy { s[0].model = cp_agy_idx(s); }
  if was_inkling { s[0].model = cp_inkling_idx(s); }
  if was_hybrid { s[0].model = cp_hybrid_idx(s); }
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
coder_page_set_agy :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_inkling := cp_is_inkling(s, s[0].model);
  was_hybrid := cp_is_hybrid(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  s[0].agy = on;
  if was_inkling { s[0].model = cp_inkling_idx(s); }
  if was_hybrid { s[0].model = cp_hybrid_idx(s); }
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
coder_page_set_inkling :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_hybrid := cp_is_hybrid(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  s[0].inkling = on;
  if was_hybrid { s[0].model = cp_hybrid_idx(s); }
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
coder_page_set_hybrid_exec :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  s[0].hybrid_exec = on;
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
coder_page_set_cloud_authed :: (s: [] CoderPage, on: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  claude_slot := cp_claude_slot(s, s[0].model);
  was_agy := cp_is_agy(s, s[0].model);
  was_inkling := cp_is_inkling(s, s[0].model);
  was_hybrid := cp_is_hybrid(s, s[0].model);
  was_combo := cp_is_inkling_neon(s, s[0].model);
  s[0].cloud_authed = on;
  if was_agy { s[0].model = cp_agy_idx(s); }
  if was_inkling { s[0].model = cp_inkling_idx(s); }
  if was_hybrid { s[0].model = cp_hybrid_idx(s); }
  if was_combo { s[0].model = cp_inkling_neon_idx(s); }
  cp_claude_keep(s, claude_slot);
  s[0].model = cp_model_index(s);
}
// The name of what runs the next message: the Antigravity CLI (agyworker), or Microcoder (mcworker)
// on OpenRouter or the Gemini API / Vertex AI for the picked entry; "" with no model. Shown inside
// the model picker dropdown (cp_model_desc), never as a separate chip in the composer's foot.
cp_backend_label :: (s: [] CoderPage) -> string {
  idx := cp_model_index(s);
  if idx < 0 { return ""; }
  if cp_is_agy(s, idx) { return "Antigravity CLI"; }
  if cp_is_inkling(s, idx) { return "Psionic Metal"; }
  if cp_is_hybrid(s, idx) { return "Psionic Metal · [E]"; }
  if cp_is_inkling_neon(s, idx) { return "Inkling + Vertex AI"; }
  if cp_is_codex(s, idx) { return "Codex CLI"; }
  if cp_is_cursor(s, idx) { return "Cursor ACP"; }
  if cp_is_acp(s, idx) { return "ACP Registry"; }
  if cp_is_claude(s, idx) { return "Claude Code"; }
  if cp_is_or(s, idx) { return "OpenRouter"; }
  if s[0].gauth_vertex { return "Vertex AI"; }                // Microcoder tries Vertex before any key (microcoder_keys.coax mk_plan)
  return "Gemini API";                                         // a Gemini API key, or Microcoder's own credentials with Experimental features
}
coder_page_cloud_ok :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return cp_cloud_ok(s);
}
coder_page_model_agy :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_agy(s, cp_model_index(s));
}
coder_page_model_inkling :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_inkling(s, cp_model_index(s));
}
coder_page_model_hybrid :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_hybrid(s, cp_model_index(s));
}
coder_page_model_claude :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_is_claude(s, cp_model_index(s));
}

// ---------------------------------------------------------------- effort

// The chat's thinking level, beside the model in the composer's foot as Zeron and Claude Code show
// it: CP_EFFORT_DEFAULT until the person picks one, then low, medium or high, kept with the chat.
CP_EFFORT_DEFAULT :: 0; CP_EFFORT_LOW :: 1; CP_EFFORT_MEDIUM :: 2; CP_EFFORT_HIGH :: 3;
CP_EFFORT_WORD :: [4] string.["", "low", "medium", "high"];
CP_EFFORT_LABEL :: [4] string.["", "Low", "Medium", "High"];
cp_effort_of :: (word: string) -> int {
  words := CP_EFFORT_WORD;
  for i: 1..<4 { if word == words[i] { return i; } }
  return CP_EFFORT_DEFAULT;
}
// The level a model runs at when the chat names none: for Antigravity, the effort Settings sets
// (its model summary, "MODEL · high"), else agyworker's own, medium; Claude's, high, as Claude Code
// runs it; Microcoder's models, low.
cp_effort_default :: (s: [] CoderPage, idx: int) -> int {
  if cp_is_claude(s, idx) { return CP_EFFORT_HIGH; }
  if !cp_is_agy(s, idx) { return CP_EFFORT_LOW; }
  m := cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n];
  dot := " · ";
  if m.count > dot.count {
    for i: 0..<m.count - dot.count + 1 {
      if cast(string) m[i..<i + dot.count] == dot { e := cp_effort_of(cast(string) m[i + dot.count..<m.count]); if e != CP_EFFORT_DEFAULT { return e; } }
    }
  }
  return CP_EFFORT_MEDIUM;
}
// The level the model at idx runs at in this chat: the one picked, else its default.
cp_effort_at :: (s: [] CoderPage, idx: int) -> int {
  e := s[0].effort;
  return ifx e >= CP_EFFORT_LOW && e <= CP_EFFORT_HIGH then e else cp_effort_default(s, idx);
}
cp_effort_label :: (s: [] CoderPage, idx: int) -> string { labels := CP_EFFORT_LABEL; return labels[cp_effort_at(s, idx)]; }
// The effort a task line names for the model at index model: the chat's pick; with none, nothing
// for Antigravity, so Settings' effort (CODER_AGY_EFFORT) or agyworker's medium decides (a forced
// low made agy think not at all), and low for Microcoder.
cp_task_effort :: (s: [] CoderPage, model: int) -> string {
  words := CP_EFFORT_WORD;
  if s[0].effort >= CP_EFFORT_LOW && s[0].effort <= CP_EFFORT_HIGH { return words[s[0].effort]; }
  if cp_is_claude(s, model) { return "high"; }
  return ifx cp_is_agy(s, model) then "" else "low";
}
// A press on the effort chip: the next level after the one shown, high wrapping to low.
cp_effort_cycle :: (s: [] CoderPage) {
  e := cp_effort_at(s, cp_model_index(s));
  s[0].effort = ifx e >= CP_EFFORT_HIGH then CP_EFFORT_LOW else e + 1;
}
