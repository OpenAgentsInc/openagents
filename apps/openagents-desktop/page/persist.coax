// Coder Desktop page (../page.coax): keeping a chat and reading it back, the recall line, a new
// chat, and moving a chat between pages.

// Whether the chat changed in a way the host keeps: a message was sent, or a run ended. Once each.
coder_page_save_due :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  r := cp_running(s);
  b := cp_budget(s);
  m := cp_model_index(s);
  if s[0].nturns == 0 && s[0].goal_status == CP_GOAL_NONE { s[0].kept_turns = 0; s[0].kept_running = false; s[0].kept_cost = 0; s[0].kept_budget = b; s[0].kept_override = s[0].budget_override; s[0].kept_model = m; s[0].kept_effort = s[0].effort; s[0].kept_goal_status = CP_GOAL_NONE; s[0].kept_goal_n = 0; s[0].kept_goal_time = 0; s[0].kept_pane_open = false; s[0].kept_pane_turn = 0; s[0].kept_pane_agent = 0; s[0].kept_pane_manual = false; return false; }
  pane_same := r || (s[0].pane_open == s[0].kept_pane_open && s[0].pane_turn == s[0].kept_pane_turn && s[0].pane_agent == s[0].kept_pane_agent && s[0].pane_manual == s[0].kept_pane_manual);
  if r == s[0].kept_running && s[0].nturns == s[0].kept_turns && s[0].cost_usd_micros == s[0].kept_cost && b == s[0].kept_budget && s[0].budget_override == s[0].kept_override && m == s[0].kept_model && s[0].effort == s[0].kept_effort && s[0].goal_status == s[0].kept_goal_status && s[0].goal_objective_n == s[0].kept_goal_n && s[0].goal_time_seconds == s[0].kept_goal_time && pane_same { return false; }
  s[0].kept_running = r; s[0].kept_turns = s[0].nturns; s[0].kept_cost = s[0].cost_usd_micros; s[0].kept_budget = b; s[0].kept_override = s[0].budget_override; s[0].kept_model = m; s[0].kept_effort = s[0].effort;
  s[0].kept_goal_status = s[0].goal_status; s[0].kept_goal_n = s[0].goal_objective_n; s[0].kept_goal_time = s[0].goal_time_seconds;
  s[0].kept_pane_open = s[0].pane_open; s[0].kept_pane_turn = s[0].pane_turn; s[0].kept_pane_agent = s[0].pane_agent; s[0].kept_pane_manual = s[0].pane_manual;
  return true;
}
cp_whole :: (seconds: f32) -> int { return ifx seconds < 0 then -1 else cast(int) seconds; }
// The chat as text the host keeps: every message, reply, command and sub-agent, as shown. Its
// length in out, 0 when it does not fit.
// A list's rows as a kept chat has them, from the place `head` names.
cp_save_rows :: (s: [] CoderPage, out: [] u8, from: int, head: int) -> int {
  n := from; q := head - 1; at := 0;
  while q >= 0 {
    n = json_raw(out, n, ifx at > 0 then ",{\"text\":" else "{\"text\":"); n = json_write_string(out, n, cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]);
    n = json_raw(out, n, ",\"out\":"); n = json_write_string(out, n, cp_call_text(s, q));
    n = json_raw(out, n, ifx s[0].calls[q].read then ",\"read\":true" else ",\"read\":false");
    n = json_raw(out, n, ifx s[0].calls[q].failed then ",\"failed\":true" else ",\"failed\":false");
    if s[0].calls[q].thought { n = json_raw(out, n, ",\"thought\":true"); }
    if s[0].calls[q].said { n = json_raw(out, n, ",\"said\":true"); }
    n = json_raw(out, n, ",\"took\":"); n = json_write_int(out, n, cp_whole(s[0].calls[q].took)); n = json_raw(out, n, "}");
    q = s[0].calls[q].next - 1; at += 1;
  }
  return n;
}
coder_page_save :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  n := json_raw(out, 0, "{\"v\":1,\"cost_usd_micros\":");
  n = json_write_int(out, n, s[0].cost_usd_micros);
  n = json_raw(out, n, ",\"budget_usd_micros\":");
  n = json_write_int(out, n, cp_budget(s));
  if s[0].budget_override { n = json_raw(out, n, ",\"budget_override\":true"); }
  n = json_raw(out, n, ",\"model\":");
  n = json_write_string(out, n, cp_model_id(s, cp_model_index(s)));
  if s[0].effort != CP_EFFORT_DEFAULT { ew := CP_EFFORT_WORD; n = json_raw(out, n, ",\"effort\":"); n = json_write_string(out, n, ew[s[0].effort]); }
  if s[0].ctx_in > 0 {
    n = json_raw(out, n, ",\"ctx_in\":"); n = json_write_int(out, n, s[0].ctx_in);
    n = json_raw(out, n, ",\"ctx_cached\":"); n = json_write_int(out, n, s[0].ctx_cached);
    n = json_raw(out, n, ",\"ctx_out\":"); n = json_write_int(out, n, s[0].ctx_out);
    n = json_raw(out, n, ",\"ctx_window\":"); n = json_write_int(out, n, s[0].ctx_window);
  }
  if s[0].goal_status != CP_GOAL_NONE && s[0].goal_objective_n > 0 {
    n = json_raw(out, n, ",\"goal_status\":"); n = json_write_int(out, n, s[0].goal_status);
    n = json_raw(out, n, ",\"goal_time\":"); n = json_write_int(out, n, s[0].goal_time_seconds);
    n = json_raw(out, n, ",\"goal_turns\":"); n = json_write_int(out, n, s[0].goal_turns);
    n = json_raw(out, n, ",\"goal_objective\":"); n = json_write_string(out, n, cast(string) s[0].goal_objective[0..<s[0].goal_objective_n]);
  }
  if s[0].pane_open {
    n = json_raw(out, n, ",\"pane_open\":true,\"pane_turn\":"); n = json_write_int(out, n, s[0].pane_turn);
    n = json_raw(out, n, ",\"pane_agent\":"); n = json_write_int(out, n, s[0].pane_agent);
  }
  if s[0].pane_manual { n = json_raw(out, n, ",\"pane_manual\":true"); }
  n = json_raw(out, n, ",\"turns\":[");
  for i: 0..<s[0].nturns {
    n = json_raw(out, n, ifx i > 0 then ",{\"ask\":" else "{\"ask\":"); n = json_write_string(out, n, cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n]);
    n = json_raw(out, n, ",\"reply\":"); n = json_write_string(out, n, cast(string) s[0].turns[i].reply[0..<s[0].turns[i].reply_n]);
    n = json_raw(out, n, ifx s[0].turns[i].cut then ",\"cut\":true" else ",\"cut\":false");
    n = json_raw(out, n, ",\"state\":"); n = json_write_int(out, n, s[0].turns[i].state);
    tmid := ifx s[0].turns[i].saved_model_n > 0 then cast(string) s[0].turns[i].saved_model[0..<s[0].turns[i].saved_model_n] else cp_model_id(s, s[0].turns[i].model);
    n = json_raw(out, n, ",\"model\":"); n = json_write_string(out, n, tmid);
    if s[0].turns[i].ran_n > 0 { n = json_raw(out, n, ",\"ran\":"); n = json_write_string(out, n, cast(string) s[0].turns[i].ran[0..<s[0].turns[i].ran_n]); }
    if s[0].turns[i].tok_s_x10 > 0 { n = json_raw(out, n, ",\"tok_s_x10\":"); n = json_write_int(out, n, s[0].turns[i].tok_s_x10); }
    if s[0].turns[i].ttft_ms > 0 { n = json_raw(out, n, ",\"ttft_ms\":"); n = json_write_int(out, n, s[0].turns[i].ttft_ms); }
    if s[0].turns[i].done_ms > 0 { n = json_raw(out, n, ",\"done_ms\":"); n = json_write_int(out, n, s[0].turns[i].done_ms); }
    if s[0].turns[i].state != CP_RUNNING && s[0].turns[i].took >= 0 { n = json_raw(out, n, ",\"worked\":"); n = json_write_int(out, n, cp_whole(s[0].turns[i].took)); }
    n = json_raw(out, n, ",\"note\":"); n = json_write_string(out, n, cast(string) s[0].turns[i].note[0..<s[0].turns[i].note_n]);
    if s[0].turns[i].refs_n > 0 { n = json_raw(out, n, ",\"refs\":"); n = json_write_string(out, n, cp_refs(s, i)); }
    if s[0].turns[i].steered_n > 0 {
      n = json_raw(out, n, ",\"steers\":["); from := 0; k := 0;
      for at: 0..<s[0].turns[i].steered_n {
        if s[0].turns[i].steered[at] != 0 { continue; }
        if k > 0 { n = json_raw(out, n, ","); }
        n = json_write_string(out, n, cast(string) s[0].turns[i].steered[from..<at]); from = at + 1; k += 1;
      }
      n = json_raw(out, n, "],\"steer_rows\":[");
      for j: 0..<k { if j > 0 { n = json_raw(out, n, ","); } n = json_write_int(out, n, cp_fu_steer_row(s, i, j)); }
      n = json_raw(out, n, "]");
    }
    n = json_raw(out, n, ",\"more\":"); n = json_write_int(out, n, s[0].turns[i].more_cmds);
    n = json_raw(out, n, ",\"earlier\":"); n = json_write_int(out, n, s[0].turns[i].early_cmds);
    n = json_raw(out, n, ",\"cmds\":[");
    n = cp_save_rows(s, out, n, s[0].turns[i].head);
    n = json_raw(out, n, "],\"agents\":[");
    for j: 0..<s[0].turns[i].nagents {
      n = json_raw(out, n, ifx j > 0 then ",{\"level\":" else "{\"level\":"); n = json_write_string(out, n, CP_LEVEL[s[0].turns[i].agents[j].level]);
      n = json_raw(out, n, ",\"task\":"); n = json_write_string(out, n, cast(string) s[0].turns[i].agents[j].task[0..<s[0].turns[i].agents[j].task_n]);
      n = json_raw(out, n, ",\"state\":"); n = json_write_int(out, n, s[0].turns[i].agents[j].state);
      n = json_raw(out, n, ",\"reply\":"); n = json_write_string(out, n, cp_agent_reply(s, i, j));
      n = json_raw(out, n, ",\"more\":"); n = json_write_int(out, n, s[0].turns[i].agents[j].more_rows);
      n = json_raw(out, n, ",\"earlier\":"); n = json_write_int(out, n, s[0].turns[i].agents[j].early_rows);
      n = json_raw(out, n, ",\"after\":"); n = json_write_int(out, n, s[0].turns[i].agents[j].after);
      n = json_raw(out, n, ",\"rows\":[");
      n = cp_save_rows(s, out, n, s[0].turns[i].agents[j].head);
      n = json_raw(out, n, "]");
      n = json_raw(out, n, ",\"calls\":"); n = json_write_int(out, n, s[0].turns[i].agents[j].calls);
      n = json_raw(out, n, ",\"took\":"); n = json_write_int(out, n, cp_whole(s[0].turns[i].agents[j].took)); n = json_raw(out, n, "}");
    }
    n = json_raw(out, n, "]}");
  }
  n = json_raw(out, n, "]}");
  return ifx n < 0 then 0 else n;
}
// One kept row joins the list it was kept from.
cp_load_row :: (s: [] CoderPage, i: int, j: int, c: string) {
  ar := [1] ClArena.[ClArena.{buf = s[0].arena[..]}];
  what := cl_str(ar[..], c, "text"); output := cl_str(ar[..], c, "out");
  read := cl_bool(c, "read"); failed := cl_bool(c, "failed"); took := cl_int(c, "took"); thought := cl_bool(c, "thought"); said := cl_bool(c, "said");
  q := cp_call_add(s, i, j, what, "", read.ok && read.value, failed.ok && failed.value, false);
  if q < 0 { return; }
  if (thought.ok && thought.value) || (said.ok && said.value) || cp_edit_at(what) > 0 && app_is_diff(output) { cp_long_set(s, q, output); }
  else { s[0].calls[q].out_n = cp_out(s[0].calls[q].out[..], output); }
  s[0].calls[q].thought = thought.ok && thought.value; s[0].calls[q].said = said.ok && said.value;
  s[0].calls[q].began = 0; s[0].calls[q].took = ifx took.ok then cast(f32) took.value else -1.0f32; s[0].live_call = -1;
}
// A kept chat (coder_page_save's text) becomes the chat that is shown. A message that was still
// running when it was kept shows as stopped. False while a run is going or when the text is not a chat.
coder_page_load :: (s: [] CoderPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 || cp_running(s) || cl_at(text, "turns").tok != JSON_ARRAY { return false; }
  turns := cl_raw(text, "turns");
  count := cl_count(turns); if count > s[0].turns.count { count = s[0].turns.count; }
  ar := [1] ClArena.[ClArena.{buf = s[0].arena[..]}];
  mar := [1] ClArena.[ClArena.{buf = s[0].scratch[..]}];
  chat_model_raw := cl_str(mar[..], text, "model");
  chat_model_buf: [64] u8;
  chat_model_n := cp_out(chat_model_buf[..], chat_model_raw);
  chat_model_str := cast(string) chat_model_buf[0..<chat_model_n];
  s[0].nturns = 0; s[0].chat_gen += 1; cp_calls_reset(s); cp_fu_reset(s); cp_todos_reset(s); cp_docs_reset(s); cp_ckpt_reset(s);
  for i: 0..<count {
    s[0].nturns = i + 1; s[0].turns[i].nagents = 0;
    worked := cl_int(cl_json(turns, cl_item(turns, i)), "worked");
    s[0].turns[i].took = ifx worked.ok && worked.value >= 0 then cast(f32) worked.value else -1.0f32;
    s[0].turns[i].ask_open = false; s[0].turns[i].fold = APP_ACT_UNCHOSEN; s[0].turns[i].heard = true; s[0].turns[i].seen_h = 0;
    t := cl_json(turns, cl_item(turns, i));
    ar[0].at = 0; ar[0].full = false;
    s[0].turns[i].ask_n = cp_out(s[0].turns[i].ask[..], cl_str(ar[..], t, "ask"));
    ar[0].at = 0;
    s[0].turns[i].cut = false;
    cp_reply_set(s, i, cl_str(ar[..], t, "reply"), false);
    cut := cl_bool(t, "cut"); if cut.ok && cut.value { s[0].turns[i].cut = true; }
    ar[0].at = 0;
    s[0].turns[i].note_n = cp_out(s[0].turns[i].note[..], cl_str(ar[..], t, "note"));
    ar[0].at = 0;
    _ = cp_refs_set(s, i, cl_str(ar[..], t, "refs"));
    s[0].turns[i].steered_n = 0;
    steers := cl_raw(t, "steers"); ns := ifx steers.count > 0 then cl_count(steers) else 0;
    srows := cl_raw(t, "steer_rows"); nsr := ifx srows.count > 0 then cl_count(srows) else 0;   // a chat kept before #13809 has none: its steers go after the rows
    for k: 0..<ns {
      rv := ifx k < nsr then cl_int_of(srows, cl_item(srows, k)) else JsonInt.{};
      ar[0].at = 0; ar[0].full = false; cp_fu_steered_add(s, i, cl_text(ar[..], steers, cl_item(steers, k)), ifx rv.ok then rv.value else -1);
    }
    ar[0].at = 0;
    tm := cl_str(ar[..], t, "model");
    eff_tm := ifx tm.count > 0 then tm else chat_model_str;
    s[0].turns[i].saved_model_n = cp_out(s[0].turns[i].saved_model[..], eff_tm);
    s[0].turns[i].model = ifx eff_tm.count > 0 then cp_model_find_s(s, eff_tm) else cp_model_start(s);
    ar[0].at = 0;
    s[0].turns[i].ran_n = cp_out(s[0].turns[i].ran[..], cl_str(ar[..], t, "ran"));
    tps := cl_int(t, "tok_s_x10"); s[0].turns[i].tok_s_x10 = ifx tps.ok && tps.value > 0 then tps.value else 0;
    ttft := cl_int(t, "ttft_ms"); s[0].turns[i].ttft_ms = ifx ttft.ok && ttft.value > 0 then ttft.value else 0;
    dms := cl_int(t, "done_ms"); s[0].turns[i].done_ms = ifx dms.ok && dms.value > 0 then dms.value else 0;
    s[0].turns[i].stat_tokens = 0; s[0].turns[i].stat_decode_ms = 0; s[0].turns[i].attempt_tokens = 0; s[0].turns[i].first_tok = -1;
    state := cl_int(t, "state"); more := cl_int(t, "more");
    was_running := state.ok && state.value == CP_RUNNING;
    s[0].turns[i].state = ifx state.ok && state.value > CP_RUNNING && state.value <= CP_STOPPED then state.value else CP_STOPPED;
    if was_running && s[0].turns[i].note_n == 0 && s[0].turns[i].reply_n == 0 {
      s[0].turns[i].note_n = cp_out(s[0].turns[i].note[..], "Interrupted before the reply finished.");
    }
    s[0].turns[i].more_cmds = ifx more.ok && more.value > 0 then more.value else 0;
    te := cl_int(t, "earlier"); s[0].turns[i].early_cmds = ifx te.ok && te.value > 0 then te.value else 0;
    s[0].turns[i].head = 0; s[0].turns[i].tail = 0; s[0].turns[i].ncmds = 0; s[0].turns[i].stopping = false; s[0].turns[i].fresh = false; s[0].turns[i].thought_open = false; s[0].turns[i].info = false; s[0].turns[i].h = 0; s[0].turns[i].ah = 0;
    s[0].turns[i].round_asked = 0; s[0].turns[i].waiting = false;
    cmds := cl_raw(t, "cmds"); nc := ifx cmds.count > 0 then cl_count(cmds) else 0;
    for at: 0..<nc { cp_load_row(s, i, -1, cl_json(cmds, cl_item(cmds, at))); }
    agents := cl_raw(t, "agents"); na := ifx agents.count > 0 then cl_count(agents) else 0; if na > s[0].turns[i].agents.count { na = s[0].turns[i].agents.count; }
    for j: 0..<na {
      g := cl_json(agents, cl_item(agents, j));
      s[0].turns[i].agents[j] = CpAgent.{}; s[0].turns[i].nagents = j + 1;
      ar[0].at = 0;
      level := cl_str(ar[..], g, "level");
      for name, q2: CP_LEVEL { if name == level { s[0].turns[i].agents[j].level = q2; } }
      for name, q2: CP_LEVEL_OLD { if name == level { s[0].turns[i].agents[j].level = q2; } }
      ar[0].at = 0;
      s[0].turns[i].agents[j].task_n = cp_out(s[0].turns[i].agents[j].task[..], cl_str(ar[..], g, "task"));
      ar[0].at = 0;
      cp_agent_reply_set(s, i, j, cl_str(ar[..], g, "reply"));
      // its tool calls; a chat kept before 2026-11-17 has them as a list of lines, with no output
      rows := cl_raw(g, "rows"); nr := ifx rows.count > 0 then cl_count(rows) else 0; 
      for at: 0..<nr { cp_load_row(s, i, j, cl_json(rows, cl_item(rows, at))); }
      if nr == 0 {
        ar[0].at = 0; old := cl_str(ar[..], g, "log"); from := 0;
        for at: 0..<old.count {
          if old[at] != 10 { continue; }
          if at > from && old[from] != '[' { _ = cp_call_add(s, i, j, cast(string) old[from..<at], "", false, false, false); }
          from = at + 1;
        }
      }
      gm := cl_int(g, "more"); s[0].turns[i].agents[j].more_rows = ifx gm.ok && gm.value > 0 then gm.value else 0;
      ge := cl_int(g, "earlier"); s[0].turns[i].agents[j].early_rows = ifx ge.ok && ge.value > 0 then ge.value else 0;
      gf := cl_int(g, "after"); s[0].turns[i].agents[j].after = ifx gf.ok && gf.value > 0 then gf.value else 0;   // a chat kept before it: first
      gs := cl_int(g, "state"); calls := cl_int(g, "calls"); took := cl_int(g, "took");
      s[0].turns[i].agents[j].state = ifx gs.ok && gs.value > CP_RUNNING && gs.value <= CP_STOPPED then gs.value else CP_STOPPED;
      s[0].turns[i].agents[j].calls = ifx calls.ok then calls.value else 0;
      s[0].turns[i].agents[j].took = ifx took.ok then cast(f32) took.value else -1.0f32;
    }
    s[0].turns[i].nagents = na;
  }
  cost := cl_int(text, "cost_usd_micros");
  s[0].cost_usd_micros = ifx cost.ok && cost.value > 0 then cost.value else 0;
  budget := cl_int(text, "budget_usd_micros");
  s[0].budget_usd_micros = ifx budget.ok && budget.value > 0 then budget.value else CP_BUDGET_DEFAULT;
  ov := cl_bool(text, "budget_override");
  s[0].budget_override = ov.ok && ov.value;
  matched_model := cp_model_find_exact(s, chat_model_str);
  if chat_model_str.count > 0 && matched_model < 0 {
    s[0].migrated_from_n = cp_out(s[0].migrated_from[..], chat_model_str);
    s[0].model = cp_model_start(s);
    s[0].flawed[0].user_picked = false;
  } else {
    s[0].migrated_from_n = 0;
    s[0].model = ifx matched_model >= 0 then matched_model else cp_model_start(s);
    s[0].flawed[0].user_picked = matched_model >= 0;
  }
  mar[0].at = 0;
  s[0].effort = cp_effort_of(cl_str(mar[..], text, "effort")); s[0].kept_effort = s[0].effort;
  s[0].model_menu = false; s[0].effort_menu = false;
  cp_ctx_reset(s);
  ci := cl_int(text, "ctx_in");
  if ci.ok && ci.value > 0 {
    cc := cl_int(text, "ctx_cached"); co := cl_int(text, "ctx_out"); cwin := cl_int(text, "ctx_window");
    s[0].ctx_in = ci.value; s[0].ctx_cached = ifx cc.ok && cc.value > 0 then cc.value else 0;
    s[0].ctx_out = ifx co.ok && co.value > 0 then co.value else 0; s[0].ctx_window = ifx cwin.ok && cwin.value > 0 then cwin.value else 0;
  }
  cp_goal_reset(s);
  gs := cl_int(text, "goal_status");
  if gs.ok && gs.value >= CP_GOAL_ACTIVE && gs.value <= CP_GOAL_BUDGET_LIMITED {
    gar := [1] ClArena.[ClArena.{buf = s[0].scratch[..]}];
    go := cl_str(gar[..], text, "goal_objective");
    if go.count > 0 {
      s[0].goal_status = gs.value;
      s[0].goal_objective_n = cp_out(s[0].goal_objective[..], go);
      gt := cl_int(text, "goal_time"); s[0].goal_time_seconds = ifx gt.ok && gt.value > 0 then gt.value else 0;
      gturns := cl_int(text, "goal_turns"); s[0].goal_turns = ifx gturns.ok && gturns.value > 0 then gturns.value else 0;
    }
  }
  s[0].nturns = count; s[0].scroll = 0; s[0].stick = true; cp_glide_reset(s); s[0].copied_turn = -1; s[0].copied_kind = CP_COPIED_NONE; s[0].results_due = false; s[0].answer_due = false;
  s[0].live_ask = -1; s[0].live_reply = -1; s[0].live_call = -1; s[0].live_pane = -1; s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; cp_sel_clear(s);
  s[0].kept_turns = count; s[0].kept_running = false; s[0].kept_cost = s[0].cost_usd_micros; s[0].kept_budget = s[0].budget_usd_micros; s[0].kept_override = s[0].budget_override; s[0].kept_model = s[0].model;
  s[0].kept_goal_status = s[0].goal_status; s[0].kept_goal_n = s[0].goal_objective_n; s[0].kept_goal_time = s[0].goal_time_seconds;
  po := cl_bool(text, "pane_open"); pt := cl_int(text, "pane_turn"); pa := cl_int(text, "pane_agent"); pm := cl_bool(text, "pane_manual");
  s[0].pane_open = false; s[0].pane_turn = 0; s[0].pane_agent = 0; s[0].pane_manual = pm.ok && pm.value;
  if po.ok && po.value && pt.ok && pa.ok && pt.value >= 0 && pt.value < count && pa.value >= 0 && pa.value < s[0].turns[pt.value].nagents {
    cp_pane_open(s, pt.value, pa.value);
  }
  s[0].kept_pane_open = s[0].pane_open; s[0].kept_pane_turn = s[0].pane_turn; s[0].kept_pane_agent = s[0].pane_agent; s[0].kept_pane_manual = s[0].pane_manual;
  return true;
}
// The chat's finished turns as the worker's recall line, so Microcoder knows a chat that was
// opened again: the newest 6 (the most it keeps), each message and reply up to CP_RECALL_TEXT bytes,
// as the TUI keeps them (MK_TURN_TEXT, MK_CUT). A longer one is cut on a character and ends in
// CP_RECALL_CUT, so the model knows it goes on. 0 for none.
CP_RECALL_TEXT :: 8000;
CP_RECALL_CUT :: " [cut here: the rest is not kept]";
cp_recall_text :: (t: [] u8, s: string) -> string {
  if s.count <= t.count { return s; }
  k := text_byte_floor(s, t.count - CP_RECALL_CUT.count);
  for i: 0..<k { t[i] = s[i]; }
  for i: 0..<CP_RECALL_CUT.count { t[k + i] = CP_RECALL_CUT[i]; }
  return cast(string) t[0..<k + CP_RECALL_CUT.count];
}
cp_recall_ended :: (state: int) -> string {
  if state == CP_STOPPED { return "[stopped by the user before a reply]"; }
  if state == CP_FAILED { return "[the run failed before a reply]"; }
  return "[the run ended before a reply]";
}
coder_page_recall_line :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].prov[0].fresh_session { return 0; }
  b := s[0].scratch[..]; n := json_raw(b, 0, "["); some := false;
  first := ifx s[0].nturns > 6 then s[0].nturns - 6 else 0;
  for i: first..<s[0].nturns {
    if s[0].turns[i].state == CP_RUNNING || s[0].turns[i].ask_n == 0 { continue; }
    t: [CP_RECALL_TEXT] u8;
    // a turn stopped or failed before a reply still counts: the next message ("go") is read with it
    reply := ifx s[0].turns[i].reply_n > 0 then cast(string) s[0].turns[i].reply[0..<s[0].turns[i].reply_n] else cp_recall_ended(s[0].turns[i].state);
    n = json_raw(b, n, ifx some then ",{\"task\":" else "{\"task\":"); n = json_write_string(b, n, cp_recall_text(t[..], cast(string) s[0].turns[i].ask[0..<s[0].turns[i].ask_n]));
    n = json_raw(b, n, ",\"reply\":"); n = json_write_string(b, n, cp_recall_text(t[..], reply)); n = json_raw(b, n, "}");
    some = true;
  }
  n = json_raw(b, n, "]");
  if n < 0 || !some { return 0; }
  return mww_recall(out, cast(string) b[0..<n]);
}
// A new chat: the window clears and the host has the worker forget. While a run is going the
// host first moves that chat out of view (coder_page_take), where its run goes on.
cp_new :: (s: [] CoderPage) -> bool {
  if cp_running(s) { s[0].ask = CP_ASK_NEW; return true; }
  s[0].nturns = 0; s[0].chat_gen += 1; cp_calls_reset(s); cp_fu_reset(s); cp_todos_reset(s); cp_ckpt_reset(s); cp_permit_new_chat(s); cp_prov_reset_chat(s); s[0].cost_usd_micros = 0; s[0].kept_cost = 0; cp_ctx_reset(s);
  s[0].budget_usd_micros = CP_BUDGET_DEFAULT; s[0].budget_override = false; s[0].kept_budget = CP_BUDGET_DEFAULT; s[0].kept_override = false;
  s[0].flawed[0].user_picked = false;
  s[0].model = cp_model_start(s); s[0].kept_model = s[0].model; s[0].model_menu = false; s[0].effort_menu = false; s[0].migrated_from_n = 0; s[0].effort = CP_EFFORT_DEFAULT; s[0].kept_effort = CP_EFFORT_DEFAULT;
  cp_goal_reset(s); s[0].kept_goal_status = CP_GOAL_NONE; s[0].kept_goal_n = 0; s[0].kept_goal_time = 0;
  s[0].live_ask = -1; s[0].live_reply = -1; s[0].live_call = -1; s[0].live_pane = -1; s[0].veil[0] = Veil.{}; s[0].veil_turn = -1; cp_sel_clear(s);
  s[0].scroll = 0; s[0].stick = true; cp_glide_reset(s); s[0].copied_turn = -1; s[0].copied_kind = CP_COPIED_NONE; s[0].pane_open = false; s[0].pane_turn = 0; s[0].pane_agent = 0; s[0].pane_manual = false; s[0].kept_pane_open = false; s[0].kept_pane_turn = 0; s[0].kept_pane_agent = 0; s[0].kept_pane_manual = false; s[0].ask = CP_ASK_NEW; return true;
}
coder_page_new :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && cp_new(s); }
// A page with no window, for a chat whose reply runs out of view.
coder_page_init :: (s: [] CoderPage) #export_c #effects(all) { if s.count > 0 { cp_init(s); } }
// Seconds pass on a page with no window: its run's tool calls and waits count them.
coder_page_tick :: (s: [] CoderPage, dt: f32) #export_c #effects(all) { if s.count > 0 && dt > 0 { s[0].clock += dt; } }
// The chat in `from` moves to `to`, run and all: its turns, sub-agents, tool calls and what the
// worker is owed. `from` is left a new chat, with nothing to ask the host. False when `to` holds a
// running chat. The clock's times shift to `to`'s clock.
// Turn i of `from` becomes turn i of `to`: its fields, and its message, reply and sub-agents copied
// into `to`'s own storage.
cp_turn_copy :: (to: [] CoderPage, i: int, from: [] CoderPage) {
  ag := to[0].turns[i].agents; ak := to[0].turns[i].ask; rp := to[0].turns[i].reply;
  to[0].turns[i] = from[0].turns[i];
  to[0].turns[i].agents = ag; to[0].turns[i].ask = ak; to[0].turns[i].reply = rp;
  t := from[0].turns[i];
  to[0].turns[i].ask_n = cp_out(ak, cast(string) t.ask[0..<t.ask_n]);
  to[0].turns[i].reply_n = cp_out(rp, cast(string) t.reply[0..<t.reply_n]);
  if t.reply_n > rp.count { to[0].turns[i].cut = true; }
  if t.nagents > ag.count { to[0].turns[i].nagents = ag.count; }
  for j: 0..<to[0].turns[i].nagents { ag[j] = t.agents[j]; }
}
coder_page_take :: (to: [] CoderPage, from: [] CoderPage) -> bool #export_c #effects(all) {
  if to.count < 1 || from.count < 1 || cp_running(to) { return false; }
  if !to[0].ready { cp_init(to); }
  shift := to[0].clock - from[0].clock;
  for i: 0..<from[0].nturns {
    cp_turn_copy(to, i, from);
    if to[0].turns[i].first_tok >= 0 { to[0].turns[i].first_tok += shift; }
    for j: 0..<to[0].turns[i].nagents { to[0].turns[i].agents[j].began += shift; to[0].turns[i].agents[j].heard += shift; }
  }
  for q: 0..<from[0].calls_n { to[0].calls[q] = from[0].calls[q]; to[0].calls[q].began += shift; }
  for k: 0..<from[0].long_n { to[0].long_buf[k] = from[0].long_buf[k]; }
  ka := ifx from[0].agent_n < to[0].agent_buf.count then from[0].agent_n else to[0].agent_buf.count;
  for k: 0..<ka { to[0].agent_buf[k] = from[0].agent_buf[k]; }
  to[0].agent_n = ka;   // a reply past a smaller pool (a check's) is dropped by cp_agent_reply
  to[0].nturns = from[0].nturns; to[0].chat_gen += 1; to[0].calls_n = from[0].calls_n; to[0].calls_free = from[0].calls_free; to[0].calls_order = from[0].calls_order; to[0].long_n = from[0].long_n;
  if from[0].sb[0].now_ms > to[0].sb[0].now_ms { to[0].sb[0].now_ms = from[0].sb[0].now_ms; }
  to[0].current_n = cp_out(to[0].current[..], cast(string) from[0].current[0..<from[0].current_n]);
  to[0].kept_turns = from[0].kept_turns; to[0].kept_running = from[0].kept_running; to[0].kept_cost = from[0].kept_cost;
  to[0].kept_budget = from[0].kept_budget; to[0].kept_override = from[0].kept_override; to[0].kept_model = from[0].kept_model; to[0].kept_effort = from[0].kept_effort;
  to[0].kept_goal_status = from[0].kept_goal_status; to[0].kept_goal_n = from[0].kept_goal_n; to[0].kept_goal_time = from[0].kept_goal_time;
  to[0].kept_pane_open = from[0].kept_pane_open; to[0].kept_pane_turn = from[0].kept_pane_turn; to[0].kept_pane_agent = from[0].kept_pane_agent; to[0].kept_pane_manual = from[0].kept_pane_manual;
  to[0].ctx_in = from[0].ctx_in; to[0].ctx_cached = from[0].ctx_cached; to[0].ctx_out = from[0].ctx_out; to[0].ctx_window = from[0].ctx_window; cp_ctx_reset(from);
  to[0].flags = from[0].flags; to[0].experimental = from[0].experimental; to[0].cloud_authed = from[0].cloud_authed;
  to[0].claude = from[0].claude; to[0].agy = from[0].agy; to[0].inkling = from[0].inkling; to[0].hybrid_exec = from[0].hybrid_exec; to[0].new_chat_worktree = from[0].new_chat_worktree;
  to[0].migrated_from_n = cp_out(to[0].migrated_from[..], cast(string) from[0].migrated_from[0..<from[0].migrated_from_n]);
  from[0].migrated_from_n = 0;
  to[0].cost_usd_micros = from[0].cost_usd_micros; to[0].budget_usd_micros = cp_budget(from); to[0].budget_override = from[0].budget_override; to[0].model = cp_model_index(from); to[0].model_menu = false; to[0].effort_menu = false; to[0].effort = from[0].effort;
  to[0].goal_status = from[0].goal_status; to[0].goal_time_seconds = from[0].goal_time_seconds; to[0].goal_turns = from[0].goal_turns; to[0].goal_prompt_kind = from[0].goal_prompt_kind; to[0].goal_turn_began = ifx from[0].goal_turn_began > 0 then from[0].goal_turn_began + shift else 0;
  to[0].goal_objective_n = cp_out(to[0].goal_objective[..], cast(string) from[0].goal_objective[0..<from[0].goal_objective_n]);
  to[0].goal_notice_n = cp_out(to[0].goal_notice[..], cast(string) from[0].goal_notice[0..<from[0].goal_notice_n]);
  to[0].answer = from[0].answer; to[0].answer_due = from[0].answer_due; to[0].results_due = from[0].results_due;
  to[0].fu[0] = from[0].fu[0]; from[0].fu[0] = CpFollow.{};     // the follow-ups go with the worker
  to[0].todos[0] = from[0].todos[0]; from[0].todos[0] = CpTodos.{};
  to[0].ckpt[0] = from[0].ckpt[0]; cp_ckpt_reset(from);
  to[0].permit[0] = from[0].permit[0]; cp_permit_new_chat(from);
  to[0].live_ask = -1; to[0].live_reply = -1; to[0].live_call = -1; to[0].live_pane = -1; to[0].veil[0] = Veil.{}; to[0].veil_turn = -1; cp_sel_clear(to);
  from[0].live_ask = -1; from[0].live_reply = -1; from[0].live_call = -1; from[0].live_pane = -1; from[0].veil[0] = Veil.{}; from[0].veil_turn = -1; cp_sel_clear(from);
  cp_docs_reset(to); cp_docs_reset(from);   // the replies' documents are parsed again where they now show
  if from[0].rev_n > to[0].rev_n { to[0].rev_n = from[0].rev_n; }   // a reply's mark stays its own
  to[0].scroll = 0; to[0].stick = true; cp_glide_reset(to); to[0].copied_turn = -1; to[0].copied_kind = CP_COPIED_NONE;
  to[0].pane_open = false; to[0].pane_turn = 0; to[0].pane_agent = 0; to[0].pane_manual = from[0].pane_manual;
  if from[0].pane_open && from[0].pane_turn >= 0 && from[0].pane_turn < to[0].nturns && from[0].pane_agent >= 0 && from[0].pane_agent < to[0].turns[from[0].pane_turn].nagents {
    cp_pane_open(to, from[0].pane_turn, from[0].pane_agent);
  }
  from[0].nturns = 0; from[0].chat_gen += 1; cp_calls_reset(from); from[0].current_n = 0; from[0].answer_due = false; from[0].results_due = false;
  from[0].kept_turns = 0; from[0].kept_running = false; from[0].kept_cost = 0; from[0].cost_usd_micros = 0;
  from[0].budget_usd_micros = CP_BUDGET_DEFAULT; from[0].budget_override = false; from[0].kept_budget = CP_BUDGET_DEFAULT; from[0].kept_override = false;
  from[0].flawed[0].user_picked = false;
  from[0].model = cp_model_start(from); from[0].kept_model = from[0].model; from[0].model_menu = false; from[0].effort_menu = false; from[0].effort = CP_EFFORT_DEFAULT; from[0].kept_effort = CP_EFFORT_DEFAULT;
  cp_goal_reset(from); from[0].kept_goal_status = CP_GOAL_NONE; from[0].kept_goal_n = 0; from[0].kept_goal_time = 0;
  from[0].live_ask = -1; from[0].live_reply = -1; from[0].live_call = -1; from[0].live_pane = -1;
  from[0].pane_open = false; from[0].pane_turn = 0; from[0].pane_agent = 0; from[0].pane_manual = false;
  from[0].kept_pane_open = false; from[0].kept_pane_turn = 0; from[0].kept_pane_agent = 0; from[0].kept_pane_manual = false;
  from[0].copied_turn = -1; from[0].copied_kind = CP_COPIED_NONE;
