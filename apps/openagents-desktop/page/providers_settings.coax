CP_PS_ED_DISPLAY_NAME :: 1;
CP_PS_ED_API_KEY :: 2;
CP_PS_ED_GCP_PROJECT :: 3;
CP_PS_ED_GCP_LOCATION :: 4;
CP_PS_ED_BINARY_PATH :: 5;
CP_PS_ED_EXTRA_PATH :: 6;
CP_PS_ED_OAUTH_CODE :: 7;
CP_PS_ED_CUSTOM_MODEL :: 8;
CP_PS_ED_ENV_KEY_BASE :: 20;
CP_PS_ED_ENV_VAL_BASE :: 40;
CP_PS_ED_WIZ_LABEL :: 60;
CP_PS_ED_WIZ_ID :: 61;
CP_PS_ED_WIZ_API_KEY :: 62;
CP_PS_ED_WIZ_GCP_PROJ :: 63;
CP_PS_ED_WIZ_GCP_LOC :: 64;
CP_PS_ED_WIZ_BIN :: 65;
CP_PS_ED_WIZ_EXTRA :: 66;

// Host asks (CP_ASK_*, free range 170..189).
CP_ASK_PS_REFRESH :: 170;
CP_ASK_PS_SELECT :: 171;
CP_ASK_PS_TOGGLE :: 172;
CP_ASK_PS_CONFIG :: 173;
CP_ASK_PS_API_CLEAR :: 174;
CP_ASK_PS_RESET :: 175;
CP_ASK_PS_DELETE :: 176;
CP_ASK_PS_RT_ACTION :: 177;
CP_ASK_PS_RT_REMOVE :: 178;
CP_ASK_PS_AUTH_START :: 179;
CP_ASK_PS_AUTH_CANCEL :: 180;
CP_ASK_PS_AUTH_SIGNOUT :: 181;
CP_ASK_PS_AUTH_OPEN_URL :: 182;
CP_ASK_PS_AUTH_COPY_URL :: 183;
CP_ASK_PS_AUTH_SUBMIT :: 184;
CP_ASK_PS_ENV_SAVE :: 185;
CP_ASK_PS_MODELS_SAVE :: 186;
CP_ASK_PS_WIZ_CREATE :: 187;

// Row dispatch actions (CP_*, free range 410..448).
CP_PS_FIRST :: 410;
CP_PS_SELECT :: 410;
CP_PS_TOGGLE :: 411;
CP_PS_REFRESH :: 412;
CP_PS_ADD_OPEN :: 413;
CP_PS_RESET :: 414;
CP_PS_DELETE :: 415;
CP_PS_ACCENT_OPEN :: 416;
CP_PS_ACCENT_PICK :: 417;
CP_PS_ENABLE_NOW :: 418;
CP_PS_RT_ACTION :: 419;
CP_PS_RT_REMOVE :: 420;
CP_PS_AUTH_PRIMARY :: 421;
