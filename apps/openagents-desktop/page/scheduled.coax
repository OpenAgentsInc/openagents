// Desktop Scheduled Tasks, Webhook Automations, and "Update Everything" coordinator (GitHub #13885).
// Reuses 5-field cron matching (coax/lib/agent/desktop/scheduled.coax) and #authority HMAC-SHA256
// webhook signature verification & 64-entry delivery deduplication (coax/lib/agent/desktop/webhook-auth.coax).
// Native persistence (~/.openagents/desktop/scheduled-tasks.json), 60s scheduler timer, dialogs,
// and CLI version probes live in Window+Scheduled.swift.

CP_SCHED_MAX :: 32;
CP_SCHED_ID :: 64;
CP_SCHED_NAME :: 96;
CP_SCHED_CRON :: 64;
CP_SCHED_FOLDER :: 256;
CP_SCHED_PROMPT :: 512;
CP_SCHED_CHAT_ID :: 64;
CP_SCHED_WH_STATUS :: 128;

CP_UPD_TARGET_DESKTOP :: 0;
CP_UPD_TARGET_AGY :: 1;
CP_UPD_TARGET_CLAUDE :: 2;
CP_UPD_TARGET_CODEX :: 3;
CP_UPD_TARGETS :: 4;

// Host asks (allocated in 110..116 after rich.coax 100..105).
CP_ASK_SCHED_ADD :: 110;          // Settings -> Scheduled Tasks: Add Task dialog
CP_ASK_SCHED_TOGGLE :: 111;       // Settings -> Scheduled Tasks: Toggle enabled/paused on sched_target
CP_ASK_SCHED_RUN :: 112;          // Settings -> Scheduled Tasks: Run Now on sched_target
CP_ASK_SCHED_DELETE :: 113;       // Settings -> Scheduled Tasks: Delete sched_target
CP_ASK_SCHED_WEBHOOK :: 114;      // Settings -> Scheduled Tasks: Configure webhook secret/listener
CP_ASK_SCHED_UPDATE_ALL :: 115;   // Settings -> About & updates: Apply "Update Everything"
CP_ASK_SCHED_UPDATE_CHECK :: 116; // Settings -> About & updates: Probe all CLI & Desktop updates

// Row action IDs (allocated in 300..304 after rich.coax 290..294).
CP_SCHED_ACT_ADD :: 300;
CP_SCHED_ACT_TOGGLE :: 301;
CP_SCHED_ACT_RUN :: 302;
CP_SCHED_ACT_DELETE :: 303;
CP_SCHED_ACT_UPDATE_ALL :: 304;

CpSchedTask :: struct {
  id: [CP_SCHED_ID] u8; id_n: int;
  name: [CP_SCHED_NAME] u8; name_n: int;
  cron: [CP_SCHED_CRON] u8; cron_n: int;
  folder: [CP_SCHED_FOLDER] u8; folder_n: int;
  prompt: [CP_SCHED_PROMPT] u8; prompt_n: int;
  enabled: bool;
  last_run_ms: int;
  last_chat_id: [CP_SCHED_CHAT_ID] u8; last_chat_id_n: int;
}

CpUpdTarget :: struct {
  current: [48] u8; current_n: int;
  latest: [48] u8; latest_n: int;
  available: bool;
  active_leases: int;
  atomic_switch: bool;
  status: [96] u8; status_n: int;
}

CpSchedState :: struct {
  tasks: [CP_SCHED_MAX] CpSchedTask;
  ntasks: int;
  target: int;                                        // selected task index for CP_ASK_SCHED_TOGGLE/RUN/DELETE
  dedup: [1] SchedDedup;                              // rolling 64-delivery webhook deduplication ring
  webhook_enabled: bool;
  webhook_status: [CP_SCHED_WH_STATUS] u8; webhook_status_n: int;
  upd: [CP_UPD_TARGETS] CpUpdTarget;                  // Desktop, agy, claude, codex
  upd_busy: bool;
}

cp_sched_init :: (s: [] CoderPage) {
  st := s[0].sched[..];
  st[0].ntasks = 0;
  st[0].target = -1;
  st[0].dedup[0] = SchedDedup.{};
  st[0].webhook_enabled = false;
  st[0].webhook_status_n = cp_out(st[0].webhook_status[..], "Not configured");
  st[0].upd_busy = false;
  for i: 0..<CP_UPD_TARGETS {
    st[0].upd[i] = CpUpdTarget.{};
  }
  st[0].upd[CP_UPD_TARGET_AGY].atomic_switch = true;
  st[0].upd[CP_UPD_TARGET_DESKTOP].status_n = cp_out(st[0].upd[CP_UPD_TARGET_DESKTOP].status[..], "Not checked");
  st[0].upd[CP_UPD_TARGET_AGY].status_n = cp_out(st[0].upd[CP_UPD_TARGET_AGY].status[..], "Not checked");
  st[0].upd[CP_UPD_TARGET_CLAUDE].status_n = cp_out(st[0].upd[CP_UPD_TARGET_CLAUDE].status[..], "Not checked");
  st[0].upd[CP_UPD_TARGET_CODEX].status_n = cp_out(st[0].upd[CP_UPD_TARGET_CODEX].status[..], "Not checked");
}

// ---------------------------------------------------------------- cron wrappers

cp_cron_valid :: (expr: string) -> bool {
  return sched_cron_valid(expr);
}

cp_cron_matches :: (expr: string, minute: int, hour: int, dom: int, month: int, dow: int) -> bool {
  return sched_cron_matches(expr, minute, hour, dom, month, dow);
}

// ---------------------------------------------------------------- task store & JSON codec

cp_sched_add :: (s: [] CoderPage, id: string, name: string, cron: string, folder: string, prompt: string, enabled: bool) -> int {
  st := s[0].sched[..];
  if id.count == 0 || !cp_cron_valid(cron) { return -1; }
  // Update existing task if id matches.
  slot := -1;
  for i: 0..<st[0].ntasks {
    if cast(string) st[0].tasks[i].id[0..<st[0].tasks[i].id_n] == id {
      slot = i;
      break;
    }
  }
  if slot < 0 {
    if st[0].ntasks >= CP_SCHED_MAX { return -1; }
    slot = st[0].ntasks;
    st[0].ntasks += 1;
    st[0].tasks[slot] = CpSchedTask.{};
  }
  st[0].tasks[slot].id_n = cp_out(st[0].tasks[slot].id[..], id);
  st[0].tasks[slot].name_n = cp_out(st[0].tasks[slot].name[..], ifx name.count > 0 then name else id);
  st[0].tasks[slot].cron_n = cp_out(st[0].tasks[slot].cron[..], cron);
  st[0].tasks[slot].folder_n = cp_out(st[0].tasks[slot].folder[..], folder);
  st[0].tasks[slot].prompt_n = cp_out(st[0].tasks[slot].prompt[..], prompt);
  st[0].tasks[slot].enabled = enabled;
  return slot;
}

cp_sched_toggle :: (s: [] CoderPage, idx: int) -> bool {
  st := s[0].sched[..];
  if idx < 0 || idx >= st[0].ntasks { return false; }
  st[0].tasks[idx].enabled = !st[0].tasks[idx].enabled;
  return true;
}

cp_sched_remove :: (s: [] CoderPage, idx: int) -> bool {
  st := s[0].sched[..];
  if idx < 0 || idx >= st[0].ntasks { return false; }
  for i: idx..<st[0].ntasks - 1 {
    st[0].tasks[i] = st[0].tasks[i + 1];
  }
  st[0].ntasks -= 1;
  st[0].tasks[st[0].ntasks] = CpSchedTask.{};
  return true;
}

cp_sched_mark_run :: (s: [] CoderPage, idx: int, now_ms: int, chat_id: string) -> bool {
  st := s[0].sched[..];
  if idx < 0 || idx >= st[0].ntasks { return false; }
  st[0].tasks[idx].last_run_ms = now_ms;
  st[0].tasks[idx].last_chat_id_n = cp_out(st[0].tasks[idx].last_chat_id[..], chat_id);
  return true;
}

// Returns count of due enabled tasks for the given UTC wall-clock minute, writing their indices to out_indices.
// Deduplicates within the same epoch minute (last_run_ms / 60000 == now_ms / 60000).
cp_sched_due :: (s: [] CoderPage, now_ms: int, minute: int, hour: int, dom: int, month: int, dow: int, out_indices: [] int) -> int {
  st := s[0].sched[..];
  if now_ms <= 0 { return 0; }
  now_min := now_ms / 60000;
  n := 0;
  for i: 0..<st[0].ntasks {
    t := st[0].tasks[i];
    if !t.enabled { continue; }
    if t.last_run_ms > 0 && (t.last_run_ms / 60000) == now_min { continue; }
    if cp_cron_matches(cast(string) t.cron[0..<t.cron_n], minute, hour, dom, month, dow) {
      if n < out_indices.count { out_indices[n] = i; }
      n += 1;
    }
  }
  return n;
}

// Serialize all scheduled tasks as JSON: {"tasks":[{...},...]}
cp_sched_save_json :: (s: [] CoderPage, out: [] u8) -> int {
  st := s[0].sched[..];
  n := sched_put(out, 0, "{\"tasks\":[");
  for i: 0..<st[0].ntasks {
    t := st[0].tasks[i];
    if i > 0 { n = sched_put(out, n, ","); }
    n = sched_put(out, n, "{\"id\":");
    n = sched_put_jstr(out, n, cast(string) t.id[0..<t.id_n]);
    n = sched_put(out, n, ",\"name\":");
    n = sched_put_jstr(out, n, cast(string) t.name[0..<t.name_n]);
    n = sched_put(out, n, ",\"cron\":");
    n = sched_put_jstr(out, n, cast(string) t.cron[0..<t.cron_n]);
    n = sched_put(out, n, ",\"folder\":");
    n = sched_put_jstr(out, n, cast(string) t.folder[0..<t.folder_n]);
    n = sched_put(out, n, ",\"prompt\":");
    n = sched_put_jstr(out, n, cast(string) t.prompt[0..<t.prompt_n]);
    n = sched_put(out, n, ",\"enabled\":");
    n = sched_put(out, n, ifx t.enabled then "true" else "false");
    n = sched_put(out, n, ",\"last_run_ms\":");
    n = sched_put_int(out, n, t.last_run_ms);
    n = sched_put(out, n, ",\"last_chat_id\":");
    n = sched_put_jstr(out, n, cast(string) t.last_chat_id[0..<t.last_chat_id_n]);
    n = sched_put(out, n, "}");
  }
  n = sched_put(out, n, "]}");
  return ifx n < out.count then n else 0;
}

// Parse JSON task list (either {"tasks":[{...},...]} or [{...},...]) into s[0].sched.
// Replaces existing tasks and returns count loaded.
cp_sched_load_json :: (s: [] CoderPage, json: string) -> int {
  st := s[0].sched[..];
  st[0].ntasks = 0;
  // Find array '[' start; if absent, scan from 0 for object '{'.
  at := 0;
  for k: 0..<json.count {
    if json[k] == '[' { at = k + 1; break; }
  }
  while at < json.count && st[0].ntasks < CP_SCHED_MAX {
    while at < json.count && json[at] != '{' { at += 1; }
    if at >= json.count { break; }
    start := at;
    depth := 0;
    in_str := false;
    esc := false;
    end := -1;
    i := start;
    while i < json.count {
      c := json[i];
      if in_str {
        if esc { esc = false; }
        else if c == '\\' { esc = true; }
        else if c == '"' { in_str = false; }
      } else {
        if c == '"' { in_str = true; }
        else if c == '{' { depth += 1; }
        else if c == '}' {
          depth -= 1;
          if depth == 0 { end = i + 1; break; }
        }
      }
      i += 1;
    }
    if end < 0 { break; }
    obj := cast(string) json[start..<end];
    t: CpSchedTask;
    id_n := sched_jstr(obj, "id", t.id[..]);
    cr_n := sched_jstr(obj, "cron", t.cron[..]);
    if id_n > 0 && cr_n > 0 && cp_cron_valid(cast(string) t.cron[0..<cr_n]) {
      t.id_n = id_n;
      t.cron_n = cr_n;
      nm_n := sched_jstr(obj, "name", t.name[..]);
      t.name_n = ifx nm_n > 0 then nm_n else cp_out(t.name[..], cast(string) t.id[0..<id_n]);
      fl_n := sched_jstr(obj, "folder", t.folder[..]);
      t.folder_n = ifx fl_n > 0 then fl_n else 0;
      pr_n := sched_jstr(obj, "prompt", t.prompt[..]);
      t.prompt_n = ifx pr_n > 0 then pr_n else 0;
      t.enabled = sched_jbool(obj, "enabled");
      t.last_run_ms = sched_jint(obj, "last_run_ms", 0);
      lc_n := sched_jstr(obj, "last_chat_id", t.last_chat_id[..]);
      t.last_chat_id_n = ifx lc_n > 0 then lc_n else 0;
      st[0].tasks[st[0].ntasks] = t;
      st[0].ntasks += 1;
    }
    at = end;
  }
  return st[0].ntasks;
}

// ---------------------------------------------------------------- webhook verification & dedup

// Constant-time HMAC-SHA256 verification accepting either "sha256=<64-hex>" or raw "<64-hex>".
cp_webhook_verify_hmac :: (secret: string, body: string, sig_hex: string) -> bool {
  if sig_hex.count == 71 {
    return sched_webhook_verify(secret, body, sig_hex);
  }
  if sig_hex.count == 64 {
    hdr: [71] u8;
    _ = sched_put(hdr[..], 0, "sha256=");
    for i: 0..<64 { hdr[7 + i] = sig_hex[i]; }
    return sched_webhook_verify(secret, body, cast(string) hdr[0..<71]);
  }
  return false;
}

// Verify HMAC-SHA256 signature and check/record delivery_id in the 64-entry rolling dedup ring.
// Returns SCHED_WH_OK (0), SCHED_WH_BAD_SIG (1), SCHED_WH_DUPLICATE (2), SCHED_WH_EMPTY_SECRET (3), or SCHED_WH_BAD_ID (4).
cp_webhook_admit :: (s: [] CoderPage, secret: string, delivery_id: string, body: string, sig_hex: string) -> int {
  st := s[0].sched[..];
  if sig_hex.count == 64 {
    hdr: [71] u8;
    _ = sched_put(hdr[..], 0, "sha256=");
    for i: 0..<64 { hdr[7 + i] = sig_hex[i]; }
    return sched_webhook_admit(st[0].dedup[..], secret, delivery_id, body, cast(string) hdr[0..<71]);
  }
  return sched_webhook_admit(st[0].dedup[..], secret, delivery_id, body, sig_hex);
}

// ---------------------------------------------------------------- "Update Everything" coordinator

cp_upd_all_decision :: (s: [] CoderPage, target: int) -> int {
  if target < 0 || target >= CP_UPD_TARGETS { return UPD_UP_TO_DATE; }
  u := s[0].sched[0].upd[target];
  if !u.available { return UPD_UP_TO_DATE; }
  item: [1] UpdItem;
  item[0].current_n = sched_copy(item[0].current[..], cast(string) u.current[0..<u.current_n]);
  lat := cast(string) u.latest[0..<u.latest_n];
  item[0].latest_n = sched_copy(item[0].latest[..], ifx lat.count > 0 then lat else "available");
  item[0].active_leases = u.active_leases;
  item[0].supports_atomic_switch = u.atomic_switch;
  return upd_decide_apply(item[..]);
}

cp_upd_all_can_apply :: (s: [] CoderPage, target: int) -> bool {
  return cp_upd_all_decision(s, target) == UPD_APPLY_NOW;
}

cp_upd_all_available_count :: (s: [] CoderPage) -> int {
  n := 0;
  for i: 0..<CP_UPD_TARGETS {
    if cp_upd_all_decision(s, i) != UPD_UP_TO_DATE { n += 1; }
  }
  return n;
}

cp_upd_all_ready_count :: (s: [] CoderPage) -> int {
  n := 0;
  for i: 0..<CP_UPD_TARGETS {
    if cp_upd_all_decision(s, i) == UPD_APPLY_NOW { n += 1; }
  }
  return n;
}

cp_upd_all_blocked_count :: (s: [] CoderPage) -> int {
  n := 0;
  for i: 0..<CP_UPD_TARGETS {
    if cp_upd_all_decision(s, i) == UPD_DEFER_LEASED { n += 1; }
  }
  return n;
}

cp_upd_all_summary :: (s: [] CoderPage, out: [] u8) -> string {
  if s[0].sched[0].upd_busy { return cast(string) out[0..<el_put(out, 0, "Checking Desktop and managed provider CLIs (agy, claude, codex)…")]; }
  ready := cp_upd_all_ready_count(s);
  blocked := cp_upd_all_blocked_count(s);
  if ready == 0 && blocked == 0 {
    return cast(string) out[0..<el_put(out, 0, "OpenAgents Desktop and managed provider CLIs (agy, claude, codex) are up to date.")];
  }
  n := 0;
  if ready > 0 {
    n = el_put_i(out, n, ready);
    n = el_put(out, n, ifx ready == 1 then " update ready to apply" else " updates ready to apply");
  }
  if blocked > 0 {
    if n > 0 { n = el_put(out, n, " · "); }
    n = el_put_i(out, n, blocked);
    n = el_put(out, n, ifx blocked == 1 then " deferred by active session lease" else " deferred by active session leases");
  }
  n = el_put(out, n, ".");
  return cast(string) out[0..<n];
}

// ---------------------------------------------------------------- Settings -> Scheduled Tasks & About -> Update Everything

cp_sched_press :: (s: [] CoderPage, act: int, id: string) -> bool {
  if act == CP_SCHED_ACT_ADD { s[0].ask = CP_ASK_SCHED_ADD; return true; }
  if act == CP_SCHED_ACT_UPDATE_ALL {
    s[0].ask = ifx cp_upd_all_ready_count(s) > 0 then CP_ASK_SCHED_UPDATE_ALL else CP_ASK_SCHED_UPDATE_CHECK;
    return true;
  }
  if act == CP_SCHED_ACT_TOGGLE || act == CP_SCHED_ACT_RUN || act == CP_SCHED_ACT_DELETE {
    idx := cp_number(id, "set.sched.t.");
    if idx < 0 || idx >= s[0].sched[0].ntasks { return false; }
    s[0].sched[0].target = idx;
    if act == CP_SCHED_ACT_TOGGLE { _ = cp_sched_toggle(s, idx); s[0].ask = CP_ASK_SCHED_TOGGLE; return true; }
    if act == CP_SCHED_ACT_RUN { s[0].ask = CP_ASK_SCHED_RUN; return true; }
    s[0].ask = CP_ASK_SCHED_DELETE;
    return true;
  }
  return false;
}

cp_settings_sched_press :: (s: [] CoderPage, id: string) -> bool {
  if id == "set.sched.add.a" || id == "set.sched.add" { s[0].ask = CP_ASK_SCHED_ADD; return true; }
  if id == "set.sched.webhook.a" || id == "set.sched.webhook" { s[0].ask = CP_ASK_SCHED_WEBHOOK; return true; }
  if id == "set.update.all.a" || id == "set.update.all" {
    s[0].ask = ifx cp_upd_all_ready_count(s) > 0 then CP_ASK_SCHED_UPDATE_ALL else CP_ASK_SCHED_UPDATE_CHECK;
    return true;
  }
  ti := cp_number(id, "set.sched.t.");
  if ti >= 0 && ti < s[0].sched[0].ntasks && id.count >= 2 && id[id.count - 2] == '.' {
    opt := cast(int) (id[id.count - 1] - '0');
    s[0].sched[0].target = ti;
    if opt == 0 || opt == 1 {
      want := opt == 1;
      if s[0].sched[0].tasks[ti].enabled != want { _ = cp_sched_toggle(s, ti); }
      s[0].ask = CP_ASK_SCHED_TOGGLE;
      return true;
    }
    if opt == 2 { s[0].ask = CP_ASK_SCHED_RUN; return true; }
    if opt == 3 { s[0].ask = CP_ASK_SCHED_DELETE; return true; }
  }
  return false;
}

cp_settings_scheduled :: (s: [] CoderPage, f: [] UiFrame, x: f32, y0: f32, w: f32) -> f32 {
  t := f[0].skin.set; sh := f[0].sheet; st := s[0].sched[..];
  y := y0;
  y += set_page_head(f, "set.title", x, y, w, "Scheduled Tasks", "Run recurring 5-field UTC cron schedules and signed HMAC-SHA256 webhook automations in your projects.") + t.block_gap;
  wh_st := ifx st[0].webhook_status_n > 0 then sheet_pool(sh, cast(string) st[0].webhook_status[0..<st[0].webhook_status_n]) else "Not configured";
  arows: [2] SetRow;
  arows[0] = SetRow.{id = "set.sched.add", name = "Add scheduled task", desc = "Create a recurring 5-field UTC cron schedule tied to a project folder and prompt.",
    kind = SET_ROW_BUTTON, button = "Add task…", action = CP_SET_ACT};
  arows[1] = SetRow.{id = "set.sched.webhook", name = "Webhook triggers", desc = "Verify X-OpenAgents-Signature (HMAC-SHA256) and deduplicate redeliveries.",
    value = wh_st, kind = SET_ROW_BUTTON, button = "Configure…", action = CP_SET_ACT};
  y += cp_set_group(s, f, "set.sched.actions.group", x, y, w, arows[..]) + t.block_gap;

  y += set_section_head(f, "set.sched.list.head", x, y, w, "Configured tasks",
    ifx st[0].ntasks > 0 then "Pause, resume, run immediately, or delete scheduled tasks. Stored in ~/.openagents/desktop/scheduled-tasks.json."
    else "No scheduled tasks configured yet.") + t.section_gap;
  if st[0].ntasks > 0 {
    trows: [CP_SCHED_MAX] SetRow;
    for i: 0..<st[0].ntasks {
      tk := st[0].tasks[i];
      ib: [32] u8; in_n := el_put(ib[..], 0, "set.sched.t."); in_n = el_put_i(ib[..], in_n, i);
      db: [320] u8; dn := 0;
      dn = el_put(db[..], dn, cast(string) tk.cron[0..<tk.cron_n]);
      if tk.folder_n > 0 {
        dn = el_put(db[..], dn, " · ");
        dn = el_put(db[..], dn, cast(string) tk.folder[0..<tk.folder_n]);
      }
      if tk.prompt_n > 0 {
        dn = el_put(db[..], dn, " · ");
        pn := ifx tk.prompt_n > 80 then 80 else tk.prompt_n;
        dn = el_put(db[..], dn, cast(string) tk.prompt[0..<pn]);
      }
      trows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
        name = sheet_pool(sh, cast(string) tk.name[0..<tk.name_n]),
        desc = sheet_pool(sh, cast(string) db[0..<dn]),
        kind = SET_ROW_CHOICE, noptions = 4, chosen = ifx tk.enabled then 1 else 0, action = CP_SET_ACT};
      trows[i].options[0] = "Paused";
      trows[i].options[1] = "Active";
      trows[i].options[2] = "Run now";
      trows[i].options[3] = "Delete";
    }
    y += cp_set_group(s, f, "set.sched.tasks.group", x, y, w, trows[0..<st[0].ntasks]);
  }
  return y - y0;
}

cp_upd_target_label :: (u: CpUpdTarget, out: [] u8) -> string {
  lu := u;
  if lu.status_n > 0 { return cast(string) out[0..<el_put(out, 0, cast(string) lu.status[0..<lu.status_n])]; }
  if lu.current_n == 0 { return cast(string) out[0..<el_put(out, 0, "Not installed")]; }
  n := el_put(out, 0, cast(string) lu.current[0..<lu.current_n]);
  if lu.available && lu.latest_n > 0 {
    n = el_put(out, n, " → ");
    n = el_put(out, n, cast(string) lu.latest[0..<lu.latest_n]);
    if lu.active_leases > 0 && !lu.atomic_switch { n = el_put(out, n, " (deferred)"); }
  }
  return cast(string) out[0..<n];
}

cp_settings_update_everything :: (s: [] CoderPage, f: [] UiFrame, x: f32, y0: f32, w: f32) -> f32 {
  t := f[0].skin.set; sh := f[0].sheet; st := s[0].sched[..];
  y := y0;
  y += set_section_head(f, "set.update.all.head", x, y, w, "Update Everything", "Check and update OpenAgents Desktop and managed provider CLIs (agy, claude, codex) safely with active-session leases.") + t.section_gap;
  sb: [200] u8;
  sum := sheet_pool(sh, cp_upd_all_summary(s, sb[..]));
  ready := cp_upd_all_ready_count(s);
  btn := ifx st[0].upd_busy then "Checking…" else ifx ready > 0 then "Update all" else "Check all";
  ab: [128] u8; cb: [128] u8; xb: [128] u8;
  urows: [4] SetRow;
  urows[0] = SetRow.{id = "set.update.all", name = "Update Everything", desc = sum,
    kind = SET_ROW_BUTTON, button = btn, action = CP_SET_ACT,
    state = ifx st[0].upd_busy then EL_S_DISABLED else 0};
  urows[1] = SetRow.{id = "set.update.agy", name = "Antigravity CLI (agy)", desc = "Managed atomic runtime switch (~/.openagents/runtimes/agy).",
    value = sheet_pool(sh, cp_upd_target_label(st[0].upd[CP_UPD_TARGET_AGY], ab[..])), kind = SET_ROW_PLAIN};
  urows[2] = SetRow.{id = "set.update.claude", name = "Claude Code CLI", desc = "Managed provider CLI; deferred while active Claude runs hold leases.",
    value = sheet_pool(sh, cp_upd_target_label(st[0].upd[CP_UPD_TARGET_CLAUDE], cb[..])), kind = SET_ROW_PLAIN};
  urows[3] = SetRow.{id = "set.update.codex", name = "Codex CLI", desc = "Managed provider CLI; deferred while active Codex runs hold leases.",
    value = sheet_pool(sh, cp_upd_target_label(st[0].upd[CP_UPD_TARGET_CODEX], xb[..])), kind = SET_ROW_PLAIN};
  y += cp_set_group(s, f, "set.update.all.group", x, y, w, urows[..]);
  return y - y0;
}

// ---------------------------------------------------------------- C exports

coder_page_sched_load_json :: (s: [] CoderPage, json: string) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cp_sched_load_json(s, json);
}
coder_page_sched_save_json :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || out.count < 1 { return 0; }
  return cp_sched_save_json(s, out);
}
coder_page_sched_count :: (s: [] CoderPage) -> int #export_c #effects(all) {
  return ifx s.count > 0 then s[0].sched[0].ntasks else 0;
}
coder_page_sched_target :: (s: [] CoderPage) -> int #export_c #effects(all) {
  return ifx s.count > 0 then s[0].sched[0].target else -1;
}
coder_page_sched_add :: (s: [] CoderPage, id: string, name: string, cron: string, folder: string, prompt: string, enabled: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  return cp_sched_add(s, id, name, cron, folder, prompt, enabled);
}
coder_page_sched_toggle :: (s: [] CoderPage, idx: int) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_sched_toggle(s, idx);
}
coder_page_sched_remove :: (s: [] CoderPage, idx: int) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_sched_remove(s, idx);
}
coder_page_sched_mark_run :: (s: [] CoderPage, idx: int, now_ms: int, chat_id: string) -> bool #export_c #effects(all) {
  return s.count > 0 && cp_sched_mark_run(s, idx, now_ms, chat_id);
}
coder_page_sched_get_id :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].sched[0].ntasks { return 0; }
  return cp_out(out, cast(string) s[0].sched[0].tasks[idx].id[0..<s[0].sched[0].tasks[idx].id_n]);
}
coder_page_sched_get_name :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].sched[0].ntasks { return 0; }
  return cp_out(out, cast(string) s[0].sched[0].tasks[idx].name[0..<s[0].sched[0].tasks[idx].name_n]);
}
coder_page_sched_get_cron :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].sched[0].ntasks { return 0; }
  return cp_out(out, cast(string) s[0].sched[0].tasks[idx].cron[0..<s[0].sched[0].tasks[idx].cron_n]);
}
coder_page_sched_get_folder :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].sched[0].ntasks { return 0; }
  return cp_out(out, cast(string) s[0].sched[0].tasks[idx].folder[0..<s[0].sched[0].tasks[idx].folder_n]);
}
coder_page_sched_get_prompt :: (s: [] CoderPage, idx: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || idx < 0 || idx >= s[0].sched[0].ntasks { return 0; }
  return cp_out(out, cast(string) s[0].sched[0].tasks[idx].prompt[0..<s[0].sched[0].tasks[idx].prompt_n]);
}
coder_page_sched_is_enabled :: (s: [] CoderPage, idx: int) -> bool #export_c #effects(all) {
  return s.count > 0 && idx >= 0 && idx < s[0].sched[0].ntasks && s[0].sched[0].tasks[idx].enabled;
}
coder_page_sched_cron_valid :: (expr: string) -> bool #export_c #effects(all) {
  return cp_cron_valid(expr);
}
coder_page_sched_cron_matches :: (expr: string, minute: int, hour: int, dom: int, month: int, dow: int) -> bool #export_c #effects(all) {
  return cp_cron_matches(expr, minute, hour, dom, month, dow);
}
coder_page_sched_due :: (s: [] CoderPage, now_ms: int, minute: int, hour: int, dom: int, month: int, dow: int, out_indices: [] int) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cp_sched_due(s, now_ms, minute, hour, dom, month, dow, out_indices);
}
coder_page_sched_webhook_set :: (s: [] CoderPage, enabled: bool, status: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].sched[0].webhook_enabled = enabled;
  s[0].sched[0].webhook_status_n = cp_out(s[0].sched[0].webhook_status[..], status);
}
coder_page_sched_webhook_admit :: (s: [] CoderPage, secret: string, delivery_id: string, body: string, sig_hex: string) -> int #export_c #effects(all) {
  if s.count < 1 { return SCHED_WH_BAD_SIG; }
  return cp_webhook_admit(s, secret, delivery_id, body, sig_hex);
}
coder_page_upd_all_set :: (s: [] CoderPage, target: int, current: string, latest: string, available: bool, leases: int, atomic_switch: bool, status: string) #export_c #effects(all) {
  if s.count < 1 || target < 0 || target >= CP_UPD_TARGETS { return; }
  u := s[0].sched[0].upd[..];
  u[target].current_n = cp_out(u[target].current[..], current);
  u[target].latest_n = cp_out(u[target].latest[..], latest);
  u[target].available = available;
  u[target].active_leases = leases;
  u[target].atomic_switch = atomic_switch;
  u[target].status_n = cp_out(u[target].status[..], status);
}
coder_page_upd_all_decision :: (s: [] CoderPage, target: int) -> int #export_c #effects(all) {
  if s.count < 1 { return UPD_UP_TO_DATE; }
  return cp_upd_all_decision(s, target);
}
coder_page_upd_all_busy_set :: (s: [] CoderPage, busy: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].sched[0].upd_busy = busy;
}
