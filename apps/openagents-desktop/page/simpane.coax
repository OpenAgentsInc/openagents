// Coder Desktop page (../page.coax): the iOS Simulator in the pane on the window's right
// (docs/desktop/ios-simulator-spec.md section 5; GitHub #13811). The page holds the pane's state
// and speaks to the simulator helper (oasim serve) itself: the host hands it every line the
// helper writes (coder_page_sim_line) and writes to the helper what the page queues
// (coder_page_sim_out), both through coax/lib/agent/device/sim-wire.coax. The host does only
// effects: the socket, starting the helper, the device menu, and the native view that shows the
// device's screen over coder_page_sim_rect (a still in Phase 0, the live surface after).
//
// The pane: a tab (the device's name and runtime, its state, Close); a toolbar (the device menu,
// Boot or Shut Down, Screenshot, Light or Dark; Home, Lock and Rotate once input works); the
// screen, aspect-fit, or what stands in for it (no simulator, booting, no Xcode, a failure); an
// agent's badge with Stop over the screen while a chat drives it; and the permission card when an
// agent first asks to control a device in a chat. The pane takes the window's right side over a
// sub-agent's transcript, the code review and a file, whichever came to the front last.

CP_SIM_DEVICES :: 16;
CP_SIM_ASKS :: 4;            // permission cards waiting, the first shown
CP_SIM_PEND :: 16;           // requests waiting for their replies
CP_SIM_OUT :: 16384;         // bytes of queued request lines
CP_SIM_PATH :: 1024;
CP_SIM_PAD :: 12;            // room round the device
CP_SIM_BEZEL :: 17.0;        // the device's frame round its screen, device points: Xcode's phone chrome
                             // (DeviceKit phone11's PhoneComposite, 436 x 908 round a 402 x 874 screen)
CP_SIM_DRIVE_S :: 2.0;       // an agent's op is "driving" this long

// what the pane says it is
CP_SIM_NONE :: 0; CP_SIM_STARTING :: 1; CP_SIM_DOWN :: 2; CP_SIM_NO_XCODE :: 3; CP_SIM_NO_DEVICE :: 4;
CP_SIM_SHUTDOWN :: 5; CP_SIM_BOOTING :: 6; CP_SIM_BOOTED :: 7; CP_SIM_FAILED :: 8;
// an agent on the shown device
CP_SIM_AGENT_NONE :: 0; CP_SIM_AGENT_ALLOWED :: 1; CP_SIM_AGENT_DRIVING :: 2;
// what its controls dispatch (rows' actions)
CP_SIM_CLOSE :: 90; CP_SIM_PICK :: 91; CP_SIM_BOOT :: 92; CP_SIM_SHUTDOWN_ACT :: 93; CP_SIM_SHOT :: 94;
CP_SIM_APPEARANCE :: 95; CP_SIM_STOP :: 96; CP_SIM_ALLOW_CHAT :: 97; CP_SIM_ALLOW_ONCE :: 98; CP_SIM_DENY :: 99;
CP_SIM_HOME :: 101; CP_SIM_LOCK :: 102; CP_SIM_ROTATE :: 103;
CP_SIM_ROW :: 104;          // a transcript row of an oasim command that went: the pane comes to the front (spec 7.5)
CP_SIM_ZOOM_OUT :: 105; CP_SIM_ZOOM_IN :: 106; CP_SIM_FIT :: 107; CP_SIM_MORE :: 108; CP_SIM_RECORD :: 109;
CP_SIM_TAB :: 110;          // the device tab strip: CP_SIM_TAB + the device's place in the list (to 125)
CP_SIM_ZOOM_STEP :: 0.8;    // a zoom out: the device this much smaller; zoom in undoes it, up to the fit
CP_SIM_ZOOM_MIN :: 0.4;
CP_SIM_TIPS :: 12;          // the icon buttons' tooltips the host shows (coder_page_sim_tips)
// what the page asks of the host (CP_ASK_SIM, with coder_page_sim_op saying which)
CP_ASK_SIM :: 46;
CP_SIM_OP_NONE :: 0; CP_SIM_OP_MENU :: 1; CP_SIM_OP_SAVED :: 2; CP_SIM_OP_CLOSED :: 3; CP_SIM_OP_OPENED :: 4;
// what a request waits for
CP_SIM_R_HELLO :: 1; CP_SIM_R_LIST :: 2; CP_SIM_R_BOOT :: 3; CP_SIM_R_STILL :: 4; CP_SIM_R_SHOT :: 5; CP_SIM_R_APPEARANCE :: 6; CP_SIM_R_OTHER :: 7;
CP_SIM_R_RECORD :: 8; CP_SIM_R_RECORDED :: 9;

CpSimDevice :: struct { udid: [40] u8; udid_n: int; name: [64] u8; name_n: int; runtime: [24] u8; runtime_n: int; state: int; }
CpSimAsk :: struct { chat: [64] u8; chat_n: int; engine: [48] u8; engine_n: int; device: [40] u8; device_n: int; name: [64] u8; name_n: int; op: [24] u8; op_n: int; }
CpSimPend :: struct { id: int; kind: int; }
CpSimTip :: struct { x: f32; y: f32; w: f32; h: f32; text: string; }   // text: a literal
CpSimPane :: struct {
  open: bool;
  front: bool;                // in front of a sub-agent's transcript, the review and a file
  closed_by_person: bool;     // Close was pressed: an agent's op doesn't open it again
  connected: bool;
  devices: [CP_SIM_DEVICES] CpSimDevice; ndevices: int;
  pick: int;                  // the device shown, -1 none
  want_udid: [40] u8; want_udid_n: int;   // device asked for by attach/ask before list arrives
  state: int;                 // CP_SIM_*
  why: [512] u8; why_n: int;  // the last failure, as the helper said it
  display_live: bool; input: bool; xcode: [24] u8; xcode_n: int;   // the helper's capabilities
  agent: int;                 // CP_SIM_AGENT_*
  agent_op: [96] u8; agent_op_n: int;   // "Tapping (201, 640)"
  agent_engine: [48] u8; agent_engine_n: int;
  agent_chat: [64] u8; agent_chat_n: int;
  agent_at: f64;              // the page's clock at its last op
  asks: [CP_SIM_ASKS] CpSimAsk; nasks: int;
  dark: bool;
  screen_w: f32; screen_h: f32;   // device points
  body_x: f32; body_y: f32; body_w: f32; body_h: f32;   // the screen rect, logical points, top-left
  bezel: f32;                 // the device's frame round it, the same points
  zoom: f32;                  // the device's size as a share of the fit (0 or 1: fit)
  recording: bool;            // the shown device's screen is being recorded (Record, again to stop)
  more: bool;                 // the menu the host shows is More's (Shut Down, the look, Lock), not the devices
  more_acts: [4] int; nmore: int;
  tips: [CP_SIM_TIPS] CpSimTip; ntips: int;
  still: [CP_SIM_PATH] u8; still_n: int; still_gen: int; still_flip: int;
  frame: int; frame_known: bool; ticks: int;   // the framebuffer's gen the still shows ("frames" display)
  saved: [CP_SIM_PATH] u8; saved_n: int;   // the person's last Screenshot
  stills_dir: [CP_SIM_PATH] u8; stills_dir_n: int;
  shots_dir: [CP_SIM_PATH] u8; shots_dir_n: int;
  pend: [CP_SIM_PEND] CpSimPend; npend: int; next_id: int;
  out: [CP_SIM_OUT] u8; out_n: int;
  op: int;                    // CP_SIM_OP_*: what CP_ASK_SIM asks
  soft_kbd: bool;             // Command-K showed the software keyboard
  scroll_on: bool; scroll_x: f32; scroll_y: f32;   // the finger a two-finger scroll moves, in view points
}

cp_sim :: (s: [] CoderPage) -> [] CpSimPane { return s[0].sim[..]; }
cp_sim_s :: (b: [] u8, n: int) -> string { return cast(string) b[0..<n]; }
cp_sim_put :: (b: [] u8, n: [] int, s: string) { n[0] = cp_out(b, s); }

// ---------------------------------------------------------------- what the rest of the page asks

// Whether the pane draws the simulator: open, in front, or nothing else wants the pane.
cp_sim_shown :: (s: [] CoderPage) -> bool { m := cp_sim(s); return m[0].open && !cp_term_front(s) && (m[0].front || !(s[0].pane_open || s[0].review || s[0].fp[0].open)); }
cp_sim_front :: (s: [] CoderPage) -> bool { return s[0].sim[0].open && s[0].sim[0].front; }
// The simulator comes to the front (View > iOS Simulator, the palette, an agent's op).
cp_sim_show :: (s: [] CoderPage) {
  m := cp_sim(s);
  was := m[0].open;
  m[0].open = true; m[0].front = true; s[0].fp[0].front = false; s[0].term[0].front = false;
  if !was { m[0].op = CP_SIM_OP_OPENED; s[0].ask = CP_ASK_SIM; }
  if m[0].connected { cp_sim_queue_list(s); }
}
cp_sim_hide :: (s: [] CoderPage) {
  m := cp_sim(s);
  if !m[0].open { return; }
  m[0].open = false; m[0].front = false;
  m[0].op = CP_SIM_OP_CLOSED; s[0].ask = CP_ASK_SIM;
}
// A press on a sub-agent's row or Review while the simulator is in front: that pane comes forward.
cp_sim_yield :: (s: [] CoderPage, act: int) -> bool {
  m := cp_sim(s);
  if !m[0].open || !m[0].front || act != CP_REVIEW && act != CP_AGENT { return false; }
  m[0].front = false;
  return false;   // the press goes on to do what it does
}
cp_sim_booted_count :: (s: [] CoderPage) -> int { m := cp_sim(s); n := 0; for i: 0..<m[0].ndevices { if m[0].devices[i].state == CP_SIM_BOOTED { n += 1; } } return n; }
cp_sim_device :: (s: [] CoderPage) -> int { m := cp_sim(s); return ifx m[0].pick >= 0 && m[0].pick < m[0].ndevices then m[0].pick else -1; }
cp_sim_udid :: (s: [] CoderPage) -> string { m := cp_sim(s); d := cp_sim_device(s); return ifx d >= 0 then cp_sim_s(m[0].devices[d].udid[..], m[0].devices[d].udid_n) else ""; }
cp_sim_name :: (s: [] CoderPage) -> string { m := cp_sim(s); d := cp_sim_device(s); return ifx d >= 0 then cp_sim_s(m[0].devices[d].name[..], m[0].devices[d].name_n) else "iOS Simulator"; }
// The tab's word: Booting, Shut down, Agent, or nothing.
cp_sim_word :: (s: [] CoderPage) -> string {
  m := cp_sim(s);
  if m[0].agent == CP_SIM_AGENT_DRIVING && s[0].now - m[0].agent_at < CP_SIM_DRIVE_S { return "Agent"; }
  if m[0].state == CP_SIM_BOOTING { return "Booting"; }
  if m[0].state == CP_SIM_SHUTDOWN { return "Shut down"; }
  if m[0].state == CP_SIM_STARTING { return "Starting"; }
  return "";
}

// ---------------------------------------------------------------- requests to the helper

cp_sim_send :: (s: [] CoderPage, m: [] SwMsg, kind: int) -> int {
  p := cp_sim(s);
  p[0].next_id += 1; id := p[0].next_id;
  sw_set_int(m, SW_F_ID, id);
  line: [8192] u8; n := sw_write(m, line[..]);
  if n < 0 || p[0].out_n + n + 1 > CP_SIM_OUT { return -1; }
  for i: 0..<n { p[0].out[p[0].out_n + i] = line[i]; }
  p[0].out_n += n; p[0].out[p[0].out_n] = 10; p[0].out_n += 1;
  if kind != CP_SIM_R_OTHER {
    if p[0].npend == CP_SIM_PEND { for i: 1..<CP_SIM_PEND { p[0].pend[i - 1] = p[0].pend[i]; } p[0].npend -= 1; }
    p[0].pend[p[0].npend] = CpSimPend.{id = id, kind = kind}; p[0].npend += 1;
  }
  return id;
}
cp_sim_req :: (m: [] SwMsg, op: string) { sw_clear(m); _ = sw_set_str(m, SW_F_OP, op); }
cp_sim_waiting :: (s: [] CoderPage, kind: int) -> bool { p := cp_sim(s); for i: 0..<p[0].npend { if p[0].pend[i].kind == kind { return true; } } return false; }
cp_sim_take :: (s: [] CoderPage, id: int) -> int {
  p := cp_sim(s);
  for i: 0..<p[0].npend {
    if p[0].pend[i].id != id { continue; }
    k := p[0].pend[i].kind;
    for j: i + 1..<p[0].npend { p[0].pend[j - 1] = p[0].pend[j]; }
    p[0].npend -= 1;
    return k;
  }
  return 0;
}
cp_sim_queue_list :: (s: [] CoderPage) {
  if cp_sim_waiting(s, CP_SIM_R_LIST) { return; }
  m: [1] SwMsg; cp_sim_req(m[..], "list"); _ = cp_sim_send(s, m[..], CP_SIM_R_LIST);
}
cp_sim_with_device :: (s: [] CoderPage, m: [] SwMsg) { u := cp_sim_udid(s); if u.count > 0 { _ = sw_set_str(m, SW_F_DEVICE, u); } }
// A still of the shown device for the view, into one of two files (the host reads one while the
// next is written).
cp_sim_queue_still :: (s: [] CoderPage) {
  p := cp_sim(s);
  if p[0].state != CP_SIM_BOOTED || p[0].stills_dir_n == 0 || cp_sim_waiting(s, CP_SIM_R_STILL) { return; }
  b: [CP_SIM_PATH] u8; n := el_put(b[..], 0, cp_sim_s(p[0].stills_dir[..], p[0].stills_dir_n));
  n = el_put(b[..], n, ifx p[0].still_flip == 0 then "/still-0.png" else "/still-1.png");
  m: [1] SwMsg; cp_sim_req(m[..], "screenshot"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_OUT, cast(string) b[0..<n]);
  if p[0].display_live && p[0].frame_known { sw_set_int(m[..], SW_F_GEN, p[0].frame); }   // nothing is written when the screen is unchanged
  _ = cp_sim_send(s, m[..], CP_SIM_R_STILL);
}

// ---------------------------------------------------------------- the helper's lines

cp_sim_state_of :: (word: string) -> int {
  if word == "booted" { return CP_SIM_BOOTED; }
  if word == "booting" { return CP_SIM_BOOTING; }
  if word == "shutting_down" || word == "shutdown" { return CP_SIM_SHUTDOWN; }
  return CP_SIM_NONE;
}
cp_sim_failed :: (s: [] CoderPage, why: string) { p := cp_sim(s); p[0].state = CP_SIM_FAILED; p[0].why_n = cp_out(p[0].why[..], why); }
cp_sim_follow :: (s: [] CoderPage) {
  // the pane's state follows the shown device's
  p := cp_sim(s); d := cp_sim_device(s);
  if p[0].state == CP_SIM_NO_XCODE { return; }
  if d < 0 { p[0].state = ifx p[0].ndevices == 0 then CP_SIM_NO_DEVICE else CP_SIM_SHUTDOWN; return; }
  was := p[0].state;
  p[0].state = p[0].devices[d].state;
  if p[0].state == CP_SIM_BOOTED && was != CP_SIM_BOOTED {
    cp_sim_queue_still(s);
    m: [1] SwMsg; cp_sim_req(m[..], "appearance"); cp_sim_with_device(s, m[..]); _ = cp_sim_send(s, m[..], CP_SIM_R_APPEARANCE);
  }
}
cp_sim_list :: (s: [] CoderPage, m: [] SwMsg) {
  p := cp_sim(s);
  keep := cp_sim_udid(s);
  if p[0].want_udid_n > 0 { keep = cp_sim_s(p[0].want_udid[..], p[0].want_udid_n); }
  kb: [40] u8; keep = cast(string) kb[0..<cp_out(kb[..], keep)];
  p[0].ndevices = 0; p[0].pick = -1;
  for i: 0..<m[0].ndevs {
    if p[0].ndevices == CP_SIM_DEVICES { break; }
    d := p[0].devices[p[0].ndevices..<p[0].ndevices + 1];
    d[0].udid_n = cp_out(d[0].udid[..], sw_dev_udid(m, i)); d[0].name_n = cp_out(d[0].name[..], sw_dev_name(m, i));
    d[0].runtime_n = cp_out(d[0].runtime[..], sw_dev_runtime(m, i)); d[0].state = cp_sim_state_of(sw_dev_state(m, i));
    if sw_dev_udid(m, i) == keep { p[0].pick = p[0].ndevices; p[0].want_udid_n = 0; }
    p[0].ndevices += 1;
  }
  // else the first booted one
  if p[0].pick < 0 { for i: 0..<p[0].ndevices { if p[0].devices[i].state == CP_SIM_BOOTED { p[0].pick = i; break; } } }
  if p[0].pick < 0 && p[0].ndevices > 0 && keep.count == 0 { p[0].pick = 0; }
  cp_sim_follow(s);
}
cp_sim_reply :: (s: [] CoderPage, m: [] SwMsg) {
  p := cp_sim(s);
  kind := cp_sim_take(s, sw_int(m, SW_F_ID, 0));
  ok := sw_bool(m, SW_F_OK);
  if kind == CP_SIM_R_HELLO {
    if !ok { cp_sim_failed(s, sw_str(m, SW_F_WHY)); return; }
    p[0].display_live = sw_display(m) == "surface" || sw_display(m) == "frames"; p[0].input = sw_input(m).count > 0 && sw_input(m) != "none";
    p[0].xcode_n = cp_out(p[0].xcode[..], sw_str(m, SW_F_XCODE));
    if p[0].xcode_n == 0 { p[0].state = CP_SIM_NO_XCODE; }
    return;
  }
  if kind == CP_SIM_R_LIST { if ok { cp_sim_list(s, m); } return; }
  if kind == CP_SIM_R_BOOT {
    if !ok { cp_sim_failed(s, sw_str(m, SW_F_WHY)); return; }
    if m[0].has[SW_F_SIZE] { p[0].screen_w = cast(f32) m[0].size_w; p[0].screen_h = cast(f32) m[0].size_h; }
    cp_sim_queue_list(s); return;
  }
  if kind == CP_SIM_R_STILL {
    if !ok { if sw_str(m, SW_F_CODE) == "not_booted" { cp_sim_queue_list(s); } return; }
    if sw_has(m, SW_F_GEN) { p[0].frame = sw_int(m, SW_F_GEN, 0); p[0].frame_known = true; }
    if !sw_has(m, SW_F_PATH) { return; }   // the screen is as the still shows it
    p[0].still_n = cp_out(p[0].still[..], sw_str(m, SW_F_PATH)); p[0].still_gen += 1; p[0].still_flip = 1 - p[0].still_flip;
    if m[0].has[SW_F_SIZE] { p[0].screen_w = cast(f32) m[0].size_w; p[0].screen_h = cast(f32) m[0].size_h; }
    return;
  }
  if kind == CP_SIM_R_RECORD { if !ok { p[0].recording = false; } return; }
  if kind == CP_SIM_R_RECORDED {
    p[0].recording = false;
    if !ok { return; }
    p[0].saved_n = cp_out(p[0].saved[..], sw_str(m, SW_F_PATH)); p[0].op = CP_SIM_OP_SAVED; s[0].ask = CP_ASK_SIM;
    return;
  }
  if kind == CP_SIM_R_SHOT {
    if !ok { cp_sim_failed(s, sw_str(m, SW_F_WHY)); return; }
    p[0].saved_n = cp_out(p[0].saved[..], sw_str(m, SW_F_PATH)); p[0].op = CP_SIM_OP_SAVED; s[0].ask = CP_ASK_SIM;
    return;
  }
  if kind == CP_SIM_R_APPEARANCE { if ok { p[0].dark = sw_str(m, SW_F_APPEARANCE) == "dark"; } return; }
}
// An agent's op, as the badge says it.
cp_sim_doing :: (op: string, m: [] SwMsg, out: [] u8) -> int {
  n := 0;
  if op == "tap" { n = el_put(out, 0, "Tapping ("); n = el_put_i(out, n, sw_int(m, SW_F_X, 0)); n = el_put(out, n, ", "); n = el_put_i(out, n, sw_int(m, SW_F_Y, 0)); return el_put(out, n, ")"); }
  if op == "swipe" || op == "touch_path" || op == "touch2_path" { return el_put(out, 0, "Swiping"); }
  if op == "text" { return el_put(out, 0, "Typing"); }
  if op == "launch" || op == "install" { return el_put(out, 0, "Launching an app"); }
  if op == "open_url" { return el_put(out, 0, "Opening a link"); }
  if op == "boot" { return el_put(out, 0, "Booting"); }
  if op == "set_appearance" { return el_put(out, 0, "Changing the appearance"); }
  n = el_put(out, 0, "Running "); return el_put(out, n, op);
}
cp_sim_event :: (s: [] CoderPage, m: [] SwMsg) {
  p := cp_sim(s);
  ev := sw_str(m, SW_F_EVENT);
  if ev == "state" {
    for i: 0..<p[0].ndevices {
      if cp_sim_s(p[0].devices[i].udid[..], p[0].devices[i].udid_n) == sw_str(m, SW_F_DEVICE) { p[0].devices[i].state = cp_sim_state_of(sw_str(m, SW_F_STATE)); }
    }
    cp_sim_follow(s); cp_sim_queue_list(s); return;
  }
  if ev == "attach" {
    dev := sw_str(m, SW_F_DEVICE);
    found := false;
    if dev.count > 0 {
      for i: 0..<p[0].ndevices { if cp_sim_s(p[0].devices[i].udid[..], p[0].devices[i].udid_n) == dev { p[0].pick = i; found = true; } }
      p[0].want_udid_n = ifx found then 0 else cp_out(p[0].want_udid[..], dev);
    }
    p[0].closed_by_person = false;
    cp_sim_show(s); cp_sim_follow(s);
    return;
  }
  if ev == "ask" {
    if p[0].nasks == CP_SIM_ASKS { return; }   // the helper refuses it when its two minutes pass
    a := p[0].asks[p[0].nasks..<p[0].nasks + 1];
    a[0].chat_n = cp_out(a[0].chat[..], sw_str(m, SW_F_CHAT)); a[0].engine_n = cp_out(a[0].engine[..], sw_str(m, SW_F_ENGINE));
    a[0].device_n = cp_out(a[0].device[..], sw_str(m, SW_F_DEVICE)); a[0].name_n = cp_out(a[0].name[..], sw_str(m, SW_F_NAME));
    a[0].op_n = cp_out(a[0].op[..], sw_str(m, SW_F_OP));
    p[0].nasks += 1;
    // the card is seen: the pane opens and comes forward, on the device asked about
    dev := sw_str(m, SW_F_DEVICE);
    found := false;
    for i: 0..<p[0].ndevices { if cp_sim_s(p[0].devices[i].udid[..], p[0].devices[i].udid_n) == dev { p[0].pick = i; found = true; } }
    if dev.count > 0 && !found { p[0].want_udid_n = cp_out(p[0].want_udid[..], dev); }
    cp_sim_show(s); cp_sim_follow(s);
    return;
  }
  if ev == "agent" {
    if sw_str(m, SW_F_DEVICE) != cp_sim_udid(s) && p[0].ndevices > 0 { cp_sim_queue_list(s); }
    p[0].agent = CP_SIM_AGENT_DRIVING; p[0].agent_at = s[0].now;
    p[0].agent_chat_n = cp_out(p[0].agent_chat[..], sw_str(m, SW_F_CHAT));
    p[0].agent_engine_n = cp_out(p[0].agent_engine[..], sw_str(m, SW_F_ENGINE));
    p[0].agent_op_n = cp_sim_doing(sw_str(m, SW_F_OP), m, p[0].agent_op[..]);
    if !p[0].closed_by_person && !p[0].open { cp_sim_show(s); }
    if sw_str(m, SW_F_OP) == "boot" || sw_str(m, SW_F_OP) == "shutdown" { cp_sim_queue_list(s); }
    if sw_str(m, SW_F_OP) == "set_appearance" && !cp_sim_waiting(s, CP_SIM_R_APPEARANCE) {
      // its answer is not ours to see: ask the device, so Light or Dark says the other one
      r: [1] SwMsg; cp_sim_req(r[..], "appearance"); cp_sim_with_device(s, r[..]); _ = cp_sim_send(s, r[..], CP_SIM_R_APPEARANCE);
    }
    return;
  }
  if ev == "revoked" {
    if sw_str(m, SW_F_CHAT) == cp_sim_s(p[0].agent_chat[..], p[0].agent_chat_n) { p[0].agent = CP_SIM_AGENT_NONE; }
    return;
  }
}

// ---------------------------------------------------------------- presses

cp_sim_grant :: (s: [] CoderPage, op: string, scope: string) {
  p := cp_sim(s);
  if p[0].nasks == 0 { return; }
  a := p[0].asks[0..<1];
  m: [1] SwMsg; cp_sim_req(m[..], op);
  _ = sw_set_str(m[..], SW_F_CHAT, cp_sim_s(a[0].chat[..], a[0].chat_n)); _ = sw_set_str(m[..], SW_F_DEVICE, cp_sim_s(a[0].device[..], a[0].device_n));
  _ = sw_set_str(m[..], SW_F_SCOPE, scope);
  _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER);
  if op == "grant" {
    p[0].agent = CP_SIM_AGENT_ALLOWED; p[0].agent_chat_n = cp_out(p[0].agent_chat[..], cp_sim_s(a[0].chat[..], a[0].chat_n));
    p[0].agent_engine_n = cp_out(p[0].agent_engine[..], cp_sim_s(a[0].engine[..], a[0].engine_n));
  }
  // the answer is for the chat on that device: the cards that ask the same go too
  ch: [64] u8; chn := cp_out(ch[..], cp_sim_s(a[0].chat[..], a[0].chat_n)); dv: [40] u8; dvn := cp_out(dv[..], cp_sim_s(a[0].device[..], a[0].device_n));
  k := 0;
  for i: 0..<p[0].nasks {
    same := cp_sim_s(p[0].asks[i].chat[..], p[0].asks[i].chat_n) == cast(string) ch[0..<chn] && cp_sim_s(p[0].asks[i].device[..], p[0].asks[i].device_n) == cast(string) dv[0..<dvn];
    if !same { p[0].asks[k] = p[0].asks[i]; k += 1; }
  }
  p[0].nasks = k;
}
cp_sim_press :: (s: [] CoderPage, act: int) -> bool {
  p := cp_sim(s);
  if act == CP_SIM_ROW { p[0].closed_by_person = false; cp_sim_show(s); return true; }
  if !p[0].open { return false; }
  m: [1] SwMsg;
  if act == CP_SIM_CLOSE { p[0].closed_by_person = true; cp_sim_hide(s); return true; }
  if act == CP_SIM_PICK { p[0].more = false; p[0].op = CP_SIM_OP_MENU; s[0].ask = CP_ASK_SIM; return true; }
  if act == CP_SIM_FIT { p[0].zoom = 1; return true; }
  if act >= CP_SIM_TAB && act < CP_SIM_TAB + CP_SIM_DEVICES {
    if act - CP_SIM_TAB == p[0].pick { return false; }
    // a recording stops (and is kept) before the pane leaves its device
    if p[0].recording { cp_sim_req(m[..], "record_stop"); cp_sim_with_device(s, m[..]); _ = cp_sim_send(s, m[..], CP_SIM_R_RECORDED); p[0].recording = false; }
    p[0].more = false;
    return coder_page_sim_pick(s, act - CP_SIM_TAB);
  }
  if act == CP_SIM_ZOOM_OUT { z := cp_sim_zoom(s) * CP_SIM_ZOOM_STEP; p[0].zoom = ifx z < CP_SIM_ZOOM_MIN then CP_SIM_ZOOM_MIN else z; return true; }
  if act == CP_SIM_ZOOM_IN { z := cp_sim_zoom(s) / CP_SIM_ZOOM_STEP; p[0].zoom = ifx z > 0.999f32 then 1.0f32 else z; return true; }
  if act == CP_SIM_MORE {
    if p[0].state != CP_SIM_BOOTED { return false; }
    p[0].nmore = 0;
    p[0].more_acts[p[0].nmore] = CP_SIM_SHUTDOWN_ACT; p[0].nmore += 1;
    p[0].more_acts[p[0].nmore] = CP_SIM_APPEARANCE; p[0].nmore += 1;
    if p[0].input { p[0].more_acts[p[0].nmore] = CP_SIM_LOCK; p[0].nmore += 1; }
    p[0].more = true; p[0].op = CP_SIM_OP_MENU; s[0].ask = CP_ASK_SIM; return true;
  }
  if act == CP_SIM_ALLOW_CHAT { cp_sim_grant(s, "grant", "chat"); return true; }
  if act == CP_SIM_ALLOW_ONCE { cp_sim_grant(s, "grant", "once"); return true; }
  if act == CP_SIM_DENY { cp_sim_grant(s, "deny", "once"); return true; }
  if act == CP_SIM_STOP {
    if p[0].agent_chat_n == 0 { return false; }
    cp_sim_req(m[..], "revoke"); _ = sw_set_str(m[..], SW_F_CHAT, cp_sim_s(p[0].agent_chat[..], p[0].agent_chat_n));
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER); p[0].agent = CP_SIM_AGENT_NONE;
    return true;
  }
  if cp_sim_device(s) < 0 { return false; }
  if act == CP_SIM_BOOT {
    cp_sim_req(m[..], "boot"); cp_sim_with_device(s, m[..]); _ = cp_sim_send(s, m[..], CP_SIM_R_BOOT);
    p[0].state = CP_SIM_BOOTING; p[0].why_n = 0;
    return true;
  }
  if act == CP_SIM_SHUTDOWN_ACT {
    cp_sim_req(m[..], "shutdown"); cp_sim_with_device(s, m[..]); _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER);
    return true;
  }
  if p[0].state != CP_SIM_BOOTED { return false; }
  if act == CP_SIM_SHOT {
    if p[0].shots_dir_n == 0 { return false; }
    b: [CP_SIM_PATH] u8; n := el_put(b[..], 0, cp_sim_s(p[0].shots_dir[..], p[0].shots_dir_n));
    n = el_put(b[..], n, "/simulator-"); n = el_put_i(b[..], n, cast(int) s[0].now); n = el_put(b[..], n, "-"); n = el_put_i(b[..], n, p[0].next_id + 1); n = el_put(b[..], n, ".png");
    cp_sim_req(m[..], "screenshot"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_OUT, cast(string) b[0..<n]);
    _ = cp_sim_send(s, m[..], CP_SIM_R_SHOT);
    return true;
  }
  if act == CP_SIM_RECORD {
    if p[0].recording { cp_sim_req(m[..], "record_stop"); cp_sim_with_device(s, m[..]); _ = cp_sim_send(s, m[..], CP_SIM_R_RECORDED); return true; }
    if p[0].shots_dir_n == 0 { return false; }
    b: [CP_SIM_PATH] u8; n := el_put(b[..], 0, cp_sim_s(p[0].shots_dir[..], p[0].shots_dir_n));
    n = el_put(b[..], n, "/simulator-"); n = el_put_i(b[..], n, cast(int) s[0].now); n = el_put(b[..], n, "-"); n = el_put_i(b[..], n, p[0].next_id + 1); n = el_put(b[..], n, ".mp4");
    cp_sim_req(m[..], "record_start"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_OUT, cast(string) b[0..<n]);
    _ = cp_sim_send(s, m[..], CP_SIM_R_RECORD); p[0].recording = true;
    return true;
  }
  if act == CP_SIM_APPEARANCE {
    p[0].dark = !p[0].dark;
    cp_sim_req(m[..], "set_appearance"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_STATE, ifx p[0].dark then "dark" else "light");
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER);
    return true;
  }
  if p[0].input && (act == CP_SIM_HOME || act == CP_SIM_LOCK) {
    cp_sim_req(m[..], "button"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_NAME, ifx act == CP_SIM_HOME then "HOME" else "LOCK");
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER); return true;
  }
  if p[0].input && act == CP_SIM_ROTATE {
    cp_sim_req(m[..], "rotate"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_DIRECTION, "left");
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER); return true;
  }
  return false;
}

// ---------------------------------------------------------------- drawing

cp_sim_zoom :: (s: [] CoderPage) -> f32 { z := s[0].sim[0].zoom; return ifx z > 0 && z <= 1 then z else 1.0f32; }
cp_sim_more_title :: (s: [] CoderPage, act: int) -> string {
  if act == CP_SIM_SHUTDOWN_ACT { return "Shut Down"; }
  if act == CP_SIM_APPEARANCE { return ifx s[0].sim[0].dark then "Light Appearance" else "Dark Appearance"; }
  if act == CP_SIM_LOCK { return "Lock"; }
  return "";
}
// An icon button of the pane, with its tooltip for the host (coder_page_sim_tips).
cp_sim_icon :: (s: [] CoderPage, f: [] UiFrame, id: string, x: f32, y: f32, icon: int, tip: string, state: int, act: int) -> f32 {
  w := app_icon_button(f, id, x, y, icon, tip, APP_BUTTON_QUIET, state, act);
  p := cp_sim(s);
  if p[0].ntips < CP_SIM_TIPS { p[0].tips[p[0].ntips] = CpSimTip.{x = x, y = y, w = w, h = w, text = tip}; p[0].ntips += 1; }
  return w;
}

// The screen's rect: the device, its screen sw x sh device points in a CP_SIM_BEZEL frame, aspect-fit
// inside (x, y, w, h) with CP_SIM_PAD round it; out[4] is the frame's width round the screen, in
// the same points as the rect (the host draws the device's chrome there).
cp_sim_fit :: (sw: f32, sh: f32, x: f32, y: f32, w: f32, h: f32, out: [] f32) { cp_sim_fit_z(sw, sh, x, y, w, h, 1, out); }
// The same at z of the fit (0 < z <= 1), centred where the fit would be.
cp_sim_fit_z :: (sw: f32, sh: f32, x: f32, y: f32, w: f32, h: f32, z: f32, out: [] f32) {
  aw := w - 2 * CP_SIM_PAD; ah := h - 2 * CP_SIM_PAD;
  out[0] = x; out[1] = y; out[2] = 0; out[3] = 0; out[4] = 0;
  if !(aw > 0) || !(ah > 0) || !(sw > 0) || !(sh > 0) { return; }
  fw := sw + 2 * CP_SIM_BEZEL; fh := sh + 2 * CP_SIM_BEZEL;
  k := aw / fw; if ah / fh < k { k = ah / fh; }
  k *= z;
  out[4] = CP_SIM_BEZEL * k;
  out[2] = sw * k; out[3] = sh * k;
  out[0] = x + (w - out[2]) / 2; out[1] = y + CP_SIM_PAD + (ah - fh * k) / 2 + out[4];
}
cp_simpane :: (s: [] CoderPage, f: [] UiFrame, px: f32, pw: f32, h: f32) {
  k := f[0].skin; a := k.app; p := cp_sim(s); sh := f[0].sheet;
  top := ifx px > 0 then 0.0f32 else cp_bar(s);
  d := cp_sim_device(s);
  y := app_pane_tab_shell(f, px, top, pw, h, ICON_SET_PHONE, "Simulator", "coder.sim.state", cp_sim_word(s), "coder.sim.close", CP_SIM_CLOSE, CP_CORNER, 1.0f32);
  p[0].ntips = 0;
  // the header: the device chooser (its name, its iOS under it, a chevron), the zoom at the right
  x := px + a.gap; cw := pw - 2 * a.gap; y += a.gap_small;
  booted := p[0].state == CP_SIM_BOOTED;
  ib := a.icon_button; m := f[0].m;
  ch := ib;
  zx := x + cw;
  if booted {
    zx -= ib; _ := cp_sim_icon(s, f, "coder.sim.zoom_in", zx, y, ICON_SIM_ZOOM_IN, "Zoom In", ifx cp_sim_zoom(s) < 0.999f32 then 0 else EL_S_DISABLED, CP_SIM_ZOOM_IN);
    zx -= ib; _ := cp_sim_icon(s, f, "coder.sim.fit", zx, y, ICON_SIM_FIT, "Fit to Pane", ifx cp_sim_zoom(s) < 0.999f32 then 0 else EL_S_DISABLED, CP_SIM_FIT);
    zx -= ib; _ := cp_sim_icon(s, f, "coder.sim.zoom_out", zx, y, ICON_SIM_ZOOM_OUT, "Zoom Out", ifx cp_sim_zoom(s) > CP_SIM_ZOOM_MIN + 0.001f32 then 0 else EL_S_DISABLED, CP_SIM_ZOOM_OUT);
  }
  {
    name := cp_sim_name(s);
    ver := ifx d >= 0 && p[0].devices[d].runtime_n > 0 then cp_sim_s(p[0].devices[d].runtime[..], p[0].devices[d].runtime_n) else "";
    lh := k.body.line + (ifx ver.count > 0 then k.small.line else 0.0f32);
    most := zx - x - a.gap - a.icon;
    shown := app_fit(f, k.body.face, name, most);
    nw := measure_width(m, k.body.face, shown);
    bw := nw + a.gap_small + a.icon;
    off := p[0].ndevices == 0;
    cid := "coder.sim.pick";
    ck := uiframe_key(f, cid);
    lb: [200] u8; ln := el_put(lb[..], 0, "Device: "); ln = el_put(lb[..], ln, name); if ver.count > 0 { ln = el_put(lb[..], ln, ", "); ln = el_put(lb[..], ln, ver); }
    row := uiframe_semantic(f, cid, EL_BUTTON, sheet_pool(sh, cast(string) lb[0..<ln]), x, y, bw, ch, ifx off then EL_S_DISABLED else 0, ifx off then 0 else CP_SIM_PICK);
    ink := app_ground(f, cid, ck, x - a.gap_small, y, bw + 2 * a.gap_small, ch, k.radius_control, APP_BUTTON_QUIET, off);
    ty := y + (ch - lh) / 2;
    _ := sheet_text(sh, m, -1, x, ty, k.body.line, k.body.face, ifx off then k.faint else k.ink, shown);
    sheet_icon(sh, ICON_CHEVRON, x + nw + a.gap_small, ty + (k.body.line - a.icon) / 2, a.icon, ink);
    if ver.count > 0 { _ := sheet_text(sh, m, -1, x, ty + k.body.line, k.small.line, k.small.face, k.faint, app_fit(f, k.small.face, ver, most)); }
    if !off { sheet_hit(sh, UIFRAME_HIT, row, 0, x, y, bw, ch); }
    if p[0].ntips < CP_SIM_TIPS { p[0].tips[p[0].ntips] = CpSimTip.{x = x, y = y, w = bw, h = ch, text = "Choose a Device"}; p[0].ntips += 1; }
  }
  y += ch + a.gap_small;
  // with two or more devices booted, a tab for each, so the person flips between them
  if cp_sim_booted_count(s) >= 2 {
    tx := x; tch := k.cmp.chip_h;
    for i: 0..<p[0].ndevices {
      if p[0].devices[i].state != CP_SIM_BOOTED { continue; }
      v := cp_sim_s(p[0].devices[i].name[..], p[0].devices[i].name_n);
      tw := app_chip_width(f, ICON_SET_PHONE, v, cw / 2);
      if tx + tw > x + cw { break; }
      ib2: [24] u8; il := el_put(ib2[..], 0, "coder.sim.tab."); il = el_put_i(ib2[..], il, i);
      tx += app_chip(f, sheet_pool(sh, cast(string) ib2[0..<il]), tx, y, cw / 2, ICON_SET_PHONE, "Device", v, ifx i == d then EL_S_CURRENT else 0, CP_SIM_TAB + i) + a.gap_small;
    }
    y += tch + a.gap_small;
  }
  // an agent's badge, above the screen (never over the native view)
  if p[0].agent != CP_SIM_AGENT_NONE && p[0].nasks == 0 {
    eb: [200] u8; en := el_put(eb[..], 0, ifx p[0].agent_engine_n > 0 then cp_sim_s(p[0].agent_engine[..], p[0].agent_engine_n) else "An agent");
    en = el_put(eb[..], en, " is using the simulator");
    if p[0].agent == CP_SIM_AGENT_DRIVING && s[0].now - p[0].agent_at < CP_SIM_DRIVE_S && p[0].agent_op_n > 0 { en = el_put(eb[..], en, ": "); en = el_put(eb[..], en, cp_sim_s(p[0].agent_op[..], p[0].agent_op_n)); }
    sw := app_button_width(f, ICON_STOP, "Stop");
    _ := app_button(f, "coder.sim.stop", x + cw - sw, y, sw, ICON_STOP, "Stop", APP_BUTTON_DEFAULT, 0, CP_SIM_STOP);
    _ := app_meta(f, "coder.sim.badge", x, y + (ch - k.body.line) / 2, cw - sw - a.gap, sheet_pool(sh, cast(string) eb[0..<en]), false);
    y += ch + a.gap_small;
  }
  bh := h - y;
  p[0].body_w = 0; p[0].body_h = 0;
  // the permission card stands where the screen would
  if p[0].nasks > 0 {
    q := p[0].asks[0..<1];
    cb: [256] u8; cn := el_put(cb[..], 0, ifx q[0].engine_n > 0 then cp_sim_s(q[0].engine[..], q[0].engine_n) else "An agent");
    cn = el_put(cb[..], cn, " wants to control "); cn = el_put(cb[..], cn, ifx q[0].name_n > 0 then cp_sim_s(q[0].name[..], q[0].name_n) else "the simulator");
    cy := y + a.gap;
    cy += app_notice(f, "coder.sim.ask", x, cy, cw, sheet_pool(sh, cast(string) cb[0..<cn]), APP_NOTICE_INFO) + a.gap_small;
    w1 := app_button_width(f, -1, "Allow for this chat"); w2 := app_button_width(f, -1, "Allow once"); w3 := app_button_width(f, -1, "Don't allow");
    _ := app_button(f, "coder.sim.allow", x, cy, w1, -1, "Allow for this chat", APP_BUTTON_PRIMARY, 0, CP_SIM_ALLOW_CHAT);
    _ := app_button(f, "coder.sim.once", x + w1 + a.gap_small, cy, w2, -1, "Allow once", APP_BUTTON_DEFAULT, 0, CP_SIM_ALLOW_ONCE);
    _ := app_button(f, "coder.sim.deny", x + w1 + w2 + 2 * a.gap_small, cy, w3, -1, "Don't allow", APP_BUTTON_QUIET, 0, CP_SIM_DENY);
    return;
  }
  // what stands in for the screen while there is none
  if !booted || !p[0].connected {
    msg := "";
    if !p[0].connected { msg = ifx p[0].state == CP_SIM_DOWN then cp_sim_s(p[0].why[..], p[0].why_n) else "Starting the simulator helper…"; }
    else if p[0].state == CP_SIM_NO_XCODE { msg = "Xcode is not installed. Install Xcode from the App Store, then choose it with xcode-select -s /Applications/Xcode.app."; }
    else if p[0].state == CP_SIM_NO_DEVICE { msg = "No iOS simulator. Install an iOS runtime in Xcode > Settings > Components."; }
    else if p[0].state == CP_SIM_BOOTING { mb: [128] u8; mn := el_put(mb[..], 0, "Booting "); mn = el_put(mb[..], mn, cp_sim_name(s)); mn = el_put(mb[..], mn, "…"); msg = sheet_pool(sh, cast(string) mb[0..<mn]); }
    else if p[0].state == CP_SIM_FAILED { msg = cp_sim_s(p[0].why[..], p[0].why_n); }
    else { msg = "No simulator booted."; }
    ny := y + a.gap;
    ny += app_notice(f, "coder.sim.notice", x, ny, cw, msg, ifx p[0].state == CP_SIM_FAILED || p[0].state == CP_SIM_DOWN then APP_NOTICE_ERROR else APP_NOTICE_INFO) + a.gap_small;
    if p[0].connected && d >= 0 && (p[0].state == CP_SIM_SHUTDOWN || p[0].state == CP_SIM_FAILED) {
      w := app_button_width(f, -1, "Boot");
      _ := app_button(f, "coder.sim.boot", x, ny, w, -1, "Boot", APP_BUTTON_PRIMARY, 0, CP_SIM_BOOT);
    }
    return;
  }
  // the device, with room under it for its toolbar: a floating pill of icon buttons
  pad := a.gap_small / 2;
  th := ib + 2 * pad;
  r: [5] f32;
  cp_sim_fit_z(ifx p[0].screen_w > 0 then p[0].screen_w else 402.0f32, ifx p[0].screen_h > 0 then p[0].screen_h else 874.0f32, px, y, pw, bh - th - a.gap, cp_sim_zoom(s), r[..]);
  p[0].body_x = r[0]; p[0].body_y = r[1]; p[0].body_w = r[2]; p[0].body_h = r[3]; p[0].bezel = r[4];
  if !(r[2] > 0) || !(r[3] > 0) { return; }
  _ := uiframe_semantic(f, "coder.sim.screen", EL_REGION, cp_sim_name(s), r[0], r[1], r[2], r[3], 0, 0);
  n := 3 + (ifx p[0].input then 2 else 0);
  tw := cast(f32) n * ib + 2 * pad;
  tx := px + (pw - tw) / 2; ty := r[1] + r[3] + r[4] + a.gap;
  _ := sheet_box(sh, tx, ty, tw, th, th / 2, k.border, k.raised, k.field_edge);
  bx := tx + pad; by := ty + pad;
  if p[0].input {
    bx += cp_sim_icon(s, f, "coder.sim.home", bx, by, ICON_SIM_HOME, "Home", 0, CP_SIM_HOME);
    bx += cp_sim_icon(s, f, "coder.sim.rotate", bx, by, ICON_SIM_ROTATE, "Rotate", 0, CP_SIM_ROTATE);
  }
  bx += cp_sim_icon(s, f, "coder.sim.shot", bx, by, ICON_SIM_CAMERA, "Screenshot", ifx p[0].shots_dir_n > 0 then 0 else EL_S_DISABLED, CP_SIM_SHOT);
  bx += cp_sim_icon(s, f, "coder.sim.record", bx, by, ifx p[0].recording then ICON_STOP else ICON_SIM_RECORD, ifx p[0].recording then "Stop Recording" else "Record",
                    ifx p[0].recording then EL_S_CURRENT else ifx p[0].shots_dir_n > 0 then 0 else EL_S_DISABLED, CP_SIM_RECORD);
  bx += cp_sim_icon(s, f, "coder.sim.more", bx, by, ICON_SIM_MORE, "More", 0, CP_SIM_MORE);
}

// ---------------------------------------------------------------- the host's calls

// Where stills go (the host's own folder) and where the person's screenshots go (the working
// folder's .openagents/shots).
coder_page_sim_setup :: (s: [] CoderPage, stills: string, shots: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  p := cp_sim(s); p[0].stills_dir_n = cp_out(p[0].stills_dir[..], stills); p[0].shots_dir_n = cp_out(p[0].shots_dir[..], shots);
}
// View > iOS Simulator and the palette: shown (true) or closed.
coder_page_sim_show :: (s: [] CoderPage, open: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  if open { s[0].sim[0].closed_by_person = false; cp_sim_show(s); } else { cp_sim_hide(s); }
}
coder_page_sim_open :: (s: [] CoderPage) -> bool #export_c #effects(all) { return s.count > 0 && s[0].sim[0].open; }
// The host reached the helper (ok) or could not (why): the page says hello and asks for the list.
coder_page_sim_connected :: (s: [] CoderPage, ok: bool, why: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  p := cp_sim(s);
  p[0].connected = ok; p[0].npend = 0; p[0].out_n = 0;
  if !ok { p[0].state = CP_SIM_DOWN; p[0].why_n = cp_out(p[0].why[..], why); p[0].nasks = 0; p[0].agent = CP_SIM_AGENT_NONE; return; }
  if p[0].state == CP_SIM_DOWN || p[0].state == CP_SIM_NONE { p[0].state = CP_SIM_STARTING; }
  m: [1] SwMsg; cp_sim_req(m[..], "hello"); _ = sw_set_str(m[..], SW_F_CLIENT, "app"); sw_set_int(m[..], SW_F_VERSION, 1);
  _ = cp_sim_send(s, m[..], CP_SIM_R_HELLO);
  cp_sim_req(m[..], "subscribe"); _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER);
  cp_sim_queue_list(s);
}
// A line the helper wrote. False when it could not be read.
coder_page_sim_line :: (s: [] CoderPage, line: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  m: [1] SwMsg; w: [1] SwText;
  if !sw_read(line, m[..], w[..]) { return false; }
  if sw_has(m[..], SW_F_EVENT) { cp_sim_event(s, m[..]); } else { cp_sim_reply(s, m[..]); }
  return true;
}
// The request lines the page queued for the helper, each ending in a line feed, into out (and
// taken off the queue). Their length, 0 for none, -1 when out is too short.
coder_page_sim_out :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  p := cp_sim(s);
  if p[0].out_n > out.count { return -1; }
  n := p[0].out_n;
  for i: 0..<n { out[i] = p[0].out[i]; }
  p[0].out_n = 0;
  return n;
}
// The host's clock while the screen shows (up to 4 a second): the next still is asked for.
// The host's clock, fifteen times a second while the pane is open: a still each tick when the
// helper has the framebuffer ("frames": it writes one only when the screen changed), else four a second.
coder_page_sim_tick :: (s: [] CoderPage) #export_c #effects(all) {
  if s.count < 1 || !cp_sim_shown(s) || s[0].set_open { return; }
  p := cp_sim(s); p[0].ticks += 1;
  if p[0].display_live || p[0].ticks % 4 == 0 { cp_sim_queue_still(s); }
}

// ---------------------------------------------------------------- the person's hand on the screen

// A request with no id: the helper answers nothing (a finger's moves never wait on a reply).
cp_sim_send0 :: (s: [] CoderPage, m: [] SwMsg) {
  p := cp_sim(s);
  sw_set_int(m, SW_F_ID, 0);
  line: [8192] u8; n := sw_write(m, line[..]);
  if n < 0 || p[0].out_n + n + 1 > CP_SIM_OUT { return; }
  for i: 0..<n { p[0].out[p[0].out_n + i] = line[i]; }
  p[0].out_n += n; p[0].out[p[0].out_n] = 10; p[0].out_n += 1;
}
// The person's finger on the screen's view (vw x vh, its point vx, vy from the top left): phase
// 0 down, 1 moved, 2 up, as a touch in device points. False when the helper has no input.
coder_page_sim_touch :: (s: [] CoderPage, phase: int, vx: f32, vy: f32, vw: f32, vh: f32) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  p := cp_sim(s);
  if !p[0].input || p[0].state != CP_SIM_BOOTED || !(p[0].screen_w > 0.0) || phase < 0 || phase > 2 { return false; }
  d := sg_view_to_device(cast(f64) vx, cast(f64) vy, cast(f64) vw, cast(f64) vh, cast(f64) p[0].screen_w, cast(f64) p[0].screen_h);
  m: [1] SwMsg; cp_sim_req(m[..], "touch"); cp_sim_with_device(s, m[..]);
  _ = sw_set_str(m[..], SW_F_PHASE, ifx phase == 0 then "down" else ifx phase == 2 then "up" else "move");
  sw_set_int(m[..], SW_F_POINTER, 0); sw_set_num(m[..], SW_F_X, d.x); sw_set_num(m[..], SW_F_Y, d.y);
  cp_sim_send0(s, m[..]);
  return true;
}
// Characters a key types: no control bytes (an accent or another script goes by the pasteboard).
cp_sim_printable :: (t: string) -> bool { for c: t { if c < 32 || c == 127 { return false; } } return true; }
// The person's Option-drag (spec 4.3): two fingers, the pointer's and its mirror through the
// screen's centre, as Simulator.app pinches. Phases as coder_page_sim_touch.
coder_page_sim_pinch :: (s: [] CoderPage, phase: int, vx: f32, vy: f32, vw: f32, vh: f32) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  p := cp_sim(s);
  if !p[0].input || p[0].state != CP_SIM_BOOTED || !(p[0].screen_w > 0.0) || phase < 0 || phase > 2 { return false; }
  d := sg_view_to_device(cast(f64) vx, cast(f64) vy, cast(f64) vw, cast(f64) vh, cast(f64) p[0].screen_w, cast(f64) p[0].screen_h);
  m: [1] SwMsg; cp_sim_req(m[..], "touch"); cp_sim_with_device(s, m[..]);
  _ = sw_set_str(m[..], SW_F_PHASE, ifx phase == 0 then "down" else ifx phase == 2 then "up" else "move");
  sw_set_int(m[..], SW_F_POINTER, 0); sw_set_num(m[..], SW_F_X, d.x); sw_set_num(m[..], SW_F_Y, d.y);
  sw_set_num(m[..], SW_F_X2, cast(f64) p[0].screen_w - d.x); sw_set_num(m[..], SW_F_Y2, cast(f64) p[0].screen_h - d.y);
  cp_sim_send0(s, m[..]);
  return true;
}
// The person's scroll on the view (a trackpad's two fingers, a mouse's wheel) as a finger that
// drags the content: down where the scroll began, moved by each delta (view points, content
// following the fingers), up when it ends. phase 0 began, 1 changed, 2 ended. A wheel with no
// phases sends all three at once.
coder_page_sim_scroll :: (s: [] CoderPage, phase: int, vx: f32, vy: f32, dx: f32, dy: f32, vw: f32, vh: f32) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  p := cp_sim(s);
  if !p[0].input || p[0].state != CP_SIM_BOOTED || phase < 0 || phase > 2 { return false; }
  if phase == 0 { p[0].scroll_on = true; p[0].scroll_x = vx; p[0].scroll_y = vy; return coder_page_sim_touch(s, 0, vx, vy, vw, vh); }
  if !p[0].scroll_on { return false; }
  p[0].scroll_x = cp_sim_clampf(p[0].scroll_x + dx, 0.0f32, vw); p[0].scroll_y = cp_sim_clampf(p[0].scroll_y + dy, 0.0f32, vh);
  if phase == 2 { p[0].scroll_on = false; }
  return coder_page_sim_touch(s, phase, p[0].scroll_x, p[0].scroll_y, vw, vh);
}
cp_sim_clampf :: (v: f32, lo: f32, hi: f32) -> f32 { return ifx v < lo then lo else ifx v > hi then hi else v; }
// A Command shortcut while the view has the keyboard, as Simulator.app's: Shift-Command-H home,
// Command-L lock, Command-Left and Command-Right turn, Command-K the software keyboard, Command-S a
// screenshot into the working folder. False for any other (it stays the app's).
coder_page_sim_command :: (s: [] CoderPage, code: int, chars: string, shift: bool) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  p := cp_sim(s);
  if p[0].state != CP_SIM_BOOTED { return false; }
  if chars == "s" && !shift { return cp_sim_press(s, CP_SIM_SHOT); }
  if !p[0].input { return false; }
  m: [1] SwMsg;
  if (chars == "h" || chars == "H") && shift { return cp_sim_press(s, CP_SIM_HOME); }
  if chars == "l" && !shift { return cp_sim_press(s, CP_SIM_LOCK); }
  if code == 123 || code == 124 {
    cp_sim_req(m[..], "rotate"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_DIRECTION, ifx code == 123 then "left" else "right");
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER); return true;
  }
  if chars == "k" && !shift {
    p[0].soft_kbd = !p[0].soft_kbd;
    cp_sim_req(m[..], "set_keyboard"); cp_sim_with_device(s, m[..]); _ = sw_set_str(m[..], SW_F_STATE, ifx p[0].soft_kbd then "show" else "hide");
    _ = cp_sim_send(s, m[..], CP_SIM_R_OTHER); return true;
  }
  return false;
}
// A Mac key code's name for press_key ("" when it types a character instead).
cp_sim_mac_key :: (code: int) -> string {
  codes := [13] int.[36, 76, 51, 117, 53, 48, 123, 124, 125, 126, 115, 119, 116];
  names := [13] string.["return", "enter", "delete", "forward_delete", "escape", "tab", "left", "right", "down", "up", "home", "end", "page_up"];
  for i: 0..<codes.count { if codes[i] == code { return names[i]; } }
  if code == 121 { return "page_down"; }
  return "";
}
#test "Mac key codes to the helper's key names" {
  #assert cp_sim_mac_key(36) == "return" && cp_sim_mac_key(76) == "enter" && cp_sim_mac_key(51) == "delete" && cp_sim_mac_key(117) == "forward_delete";
  #assert cp_sim_mac_key(53) == "escape" && cp_sim_mac_key(48) == "tab" && cp_sim_mac_key(123) == "left" && cp_sim_mac_key(124) == "right";
  #assert cp_sim_mac_key(125) == "down" && cp_sim_mac_key(126) == "up" && cp_sim_mac_key(115) == "home" && cp_sim_mac_key(119) == "end";
  #assert cp_sim_mac_key(116) == "page_up" && cp_sim_mac_key(121) == "page_down" && cp_sim_mac_key(0) == "" && cp_sim_mac_key(49) == "";
}
// A key the person pressed while the screen's view has the keyboard: its Mac key code and the
// characters it types. A named key goes as press_key, typeable text as text. False when neither.
coder_page_sim_key :: (s: [] CoderPage, code: int, chars: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  p := cp_sim(s);
  if !p[0].input || p[0].state != CP_SIM_BOOTED { return false; }
  m: [1] SwMsg;
  name := cp_sim_mac_key(code);
  if name.count > 0 { cp_sim_req(m[..], "press_key"); _ = sw_set_str(m[..], SW_F_KEY, name); }
  else if chars.count > 0 && cp_sim_printable(chars) { cp_sim_req(m[..], "text"); _ = sw_set_str(m[..], SW_F_TEXT, chars); }
  else { return false; }
  cp_sim_with_device(s, m[..]);
  cp_sim_send0(s, m[..]);
  return true;
}
// The screen's rect (x, y, w, h in logical points, top-left) and whether something covers it
// (an overlay, settings: the host then hides its view). False while no screen shows.
coder_page_sim_rect :: (s: [] CoderPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 6 { return false; }
  p := cp_sim(s);
  if !cp_sim_shown(s) || !(p[0].body_w > 0) || !(p[0].body_h > 0) || p[0].state != CP_SIM_BOOTED || p[0].nasks > 0 { return false; }
  out[0] = p[0].body_x; out[1] = p[0].body_y; out[2] = p[0].body_w; out[3] = p[0].body_h;
  out[4] = ifx s[0].set_open || cp_overlay_open(s) then 1.0f32 else 0.0f32;
  out[5] = p[0].bezel;
  return true;
}
// The newest still: its path into out; the count of stills so far (a new one when it grows).
coder_page_sim_still :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  p := cp_sim(s); _ = cp_out(out, cp_sim_s(p[0].still[..], p[0].still_n));
  if p[0].still_n < out.count { out[p[0].still_n] = 0; }
  return p[0].still_gen;
}
// What CP_ASK_SIM asks: CP_SIM_OP_MENU (the device menu), _SAVED (a screenshot was saved:
// coder_page_sim_saved), _CLOSED and _OPENED (the pane).
coder_page_sim_op :: (s: [] CoderPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } o := s[0].sim[0].op; s[0].sim[0].op = CP_SIM_OP_NONE; return o; }
coder_page_sim_saved :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) { return ifx s.count > 0 then cp_out(out, cp_sim_s(s[0].sim[0].saved[..], s[0].sim[0].saved_n)) else 0; }
// The menu's rows, one a line: the device menu's "name · runtime\tstate word\t1 when shown", or
// More's "title\t\t0" (Shut Down, Dark or Light Appearance, Lock).
coder_page_sim_menu :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  p := cp_sim(s); n := 0;
  if p[0].more {
    for i: 0..<p[0].nmore { n = el_put(out, n, cp_sim_more_title(s, p[0].more_acts[i])); n = el_put(out, n, "\t\t0\n"); }
    return n;
  }
  words := [9] string.["", "", "", "", "", "Shut down", "Booting", "Booted", ""];
  for i: 0..<p[0].ndevices {
    d := p[0].devices[i..<i + 1];
    n = el_put(out, n, cp_sim_s(d[0].name[..], d[0].name_n));
    if d[0].runtime_n > 0 { n = el_put(out, n, " · "); n = el_put(out, n, cp_sim_s(d[0].runtime[..], d[0].runtime_n)); }
    n = el_put(out, n, "\t"); n = el_put(out, n, words[d[0].state]); n = el_put(out, n, ifx i == p[0].pick then "\t1\n" else "\t0\n");
  }
  return n;
}
// The person picked row i of the device menu.
coder_page_sim_pick :: (s: [] CoderPage, i: int) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  if s[0].sim[0].more { s[0].sim[0].more = false; return i >= 0 && i < s[0].sim[0].nmore && cp_sim_press(s, s[0].sim[0].more_acts[i]); }
  if i < 0 || i >= s[0].sim[0].ndevices { return false; }
  p := cp_sim(s);
  p[0].pick = i; p[0].still_n = 0; p[0].screen_w = 0; p[0].screen_h = 0; p[0].state = CP_SIM_NONE;
  cp_sim_follow(s);
  return true;
}
// The pane's icon buttons' tooltips for the host to show, one a line: "x\ty\tw\th\ttext" (top-left
// points), as the last frame drew them; none while the screen is covered.
coder_page_sim_tips :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_sim_shown(s) || s[0].set_open || cp_overlay_open(s) { return 0; }
  p := cp_sim(s); n := 0;
  for i: 0..<p[0].ntips {
    t := p[0].tips[i];
    n = el_put_i(out, n, cast(int) t.x); n = el_put(out, n, "\t"); n = el_put_i(out, n, cast(int) t.y); n = el_put(out, n, "\t");
    n = el_put_i(out, n, cast(int) t.w); n = el_put(out, n, "\t"); n = el_put_i(out, n, cast(int) t.h); n = el_put(out, n, "\t");
    n = el_put(out, n, t.text); n = el_put(out, n, "\n");
  }
  return n;
}
// The device the pane shows (its UDID into out), for the chat's run.
coder_page_sim_device :: (s: [] CoderPage, out: [] u8) -> int #export_c #effects(all) { return ifx s.count > 0 then cp_out(out, cp_sim_udid(s)) else 0; }

// ---------------------------------------------------------------- oasim in the transcript

// An `oasim` command row's words (spec 7.5): the verb ("Tapped") into vb and what it was done to
// ("(201, 640)") into tb, from the command's text. False when the command is not oasim's.
CpSimWords :: struct { verb: string; target: string; }
cp_sim_word_at :: (t: string, k: int) -> string {
  // the k-th space-separated word of t ("" when there is none)
  i := 0; n := 0;
  while i < t.count {
    while i < t.count && t[i] == ' ' { i += 1; }
    if i >= t.count { break; }
    j := i; while j < t.count && t[j] != ' ' { j += 1; }
    if n == k { return t[i..<j]; }
    n += 1; i = j;
  }
  return "";
}
cp_sim_rest :: (t: string, k: int) -> string {
  // t from its k-th word on
  i := 0; n := 0;
  while i < t.count {
    while i < t.count && t[i] == ' ' { i += 1; }
    if i >= t.count { break; }
    if n == k { return t[i..<t.count]; }
    while i < t.count && t[i] != ' ' { i += 1; }
    n += 1;
  }
  return "";
}
cp_sim_cmd :: (text: string, tb: [] u8) -> CpSimWords {
  prog := cp_sim_word_at(text, 0);
  base := 0; for c, ci: prog { if c == '/' { base = ci + 1; } }
  if prog[base..<prog.count] != "oasim" { return CpSimWords.{}; }
  v := cp_sim_word_at(text, 1);
  n := 0;
  if v == "tap" || v == "swipe" {
    n = el_put(tb, 0, "("); n = el_put(tb, n, cp_sim_word_at(text, 2)); n = el_put(tb, n, ", "); n = el_put(tb, n, cp_sim_word_at(text, 3)); n = el_put(tb, n, ")");
    if v == "swipe" { n = el_put(tb, n, " to ("); n = el_put(tb, n, cp_sim_word_at(text, 4)); n = el_put(tb, n, ", "); n = el_put(tb, n, cp_sim_word_at(text, 5)); n = el_put(tb, n, ")"); }
    return CpSimWords.{verb = ifx v == "tap" then "Tapped" else "Swiped", target = cast(string) tb[0..<n]};
  }
  if v == "screenshot" { return CpSimWords.{verb = "Took a screenshot", target = "of the simulator"}; }
  if v == "text" { return CpSimWords.{verb = "Typed", target = cp_sim_rest(text, 2)}; }
  if v == "press_key" || v == "button" { return CpSimWords.{verb = "Pressed", target = cp_sim_word_at(text, 2)}; }
  if v == "boot" { return CpSimWords.{verb = "Booted", target = cp_sim_rest(text, 2)}; }
  if v == "shutdown" { return CpSimWords.{verb = "Shut down", target = "the simulator"}; }
  if v == "launch" { return CpSimWords.{verb = "Launched", target = cp_sim_rest(text, 2)}; }
  if v == "open_url" { return CpSimWords.{verb = "Opened", target = cp_sim_word_at(text, 2)}; }
  if v == "set_appearance" { return CpSimWords.{verb = "Set the simulator to", target = cp_sim_word_at(text, 2)}; }
  if v == "build" || v == "run" {
    // the scheme names what was built
    sch := ""; i := 2;
    while cp_sim_word_at(text, i).count > 0 { if cp_sim_word_at(text, i) == "--scheme" { sch = cp_sim_word_at(text, i + 1); } i += 1; }
    return CpSimWords.{verb = ifx v == "build" then "Built" else "Built and ran", target = ifx sch.count > 0 then sch else "the app"};
  }
  if v == "list" { return CpSimWords.{verb = "Listed", target = "the simulators"}; }
  if v == "describe" { return CpSimWords.{verb = "Read", target = "the screen's accessibility"}; }
  if v == "logs" { return CpSimWords.{verb = "Read", target = "the simulator's log"}; }
  if v == "rotate" { return CpSimWords.{verb = "Turned the simulator", target = cp_sim_word_at(text, 2)}; }
  if v == "record" { return CpSimWords.{verb = ifx cp_sim_word_at(text, 2) == "stop" then "Stopped recording" else "Started recording", target = "the simulator"}; }
  return CpSimWords.{verb = "Ran oasim", target = cp_sim_rest(text, 1)};
}
#test "oasim commands in the transcript say what they did" {
  tb: [256] u8;
  w := cp_sim_cmd("oasim tap 201 640", tb[..]); #assert w.verb == "Tapped" && w.target == "(201, 640)";
  #assert cp_sim_cmd("oasim describe", tb[..]).target == "the screen's accessibility" && cp_sim_cmd("oasim logs --bundle a", tb[..]).target == "the simulator's log";
  #assert cp_sim_cmd("oasim record stop", tb[..]).verb == "Stopped recording" && cp_sim_cmd("oasim record start", tb[..]).verb == "Started recording" && cp_sim_cmd("oasim rotate left", tb[..]).target == "left";
  w = cp_sim_cmd("/x/Resources/oasim swipe 10 700 10 200 --device U", tb[..]); #assert w.verb == "Swiped" && w.target == "(10, 700) to (10, 200)";
  w = cp_sim_cmd("oasim screenshot --out /t/a.png", tb[..]); #assert w.verb == "Took a screenshot";
  w = cp_sim_cmd("oasim text hello  there", tb[..]); #assert w.verb == "Typed" && w.target == "hello  there";
  w = cp_sim_cmd("oasim press_key return", tb[..]); #assert w.verb == "Pressed" && w.target == "return";
  w = cp_sim_cmd("oasim button HOME", tb[..]); #assert w.verb == "Pressed" && w.target == "HOME";
  w = cp_sim_cmd("oasim boot iPhone 17", tb[..]); #assert w.verb == "Booted" && w.target == "iPhone 17";
  w = cp_sim_cmd("oasim shutdown", tb[..]); #assert w.verb == "Shut down";
  w = cp_sim_cmd("oasim launch --bundle com.a.b", tb[..]); #assert w.verb == "Launched" && w.target == "--bundle com.a.b";
  w = cp_sim_cmd("oasim open_url https://x.y", tb[..]); #assert w.verb == "Opened" && w.target == "https://x.y";
  w = cp_sim_cmd("oasim set_appearance dark", tb[..]); #assert w.verb == "Set the simulator to" && w.target == "dark";
  w = cp_sim_cmd("oasim build --project P --scheme OpenAgents", tb[..]); #assert w.verb == "Built" && w.target == "OpenAgents";
  w = cp_sim_cmd("oasim run --project P", tb[..]); #assert w.verb == "Built and ran" && w.target == "the app";
  w = cp_sim_cmd("oasim list", tb[..]); #assert w.verb == "Listed";
  w = cp_sim_cmd("oasim quit", tb[..]); #assert w.verb == "Ran oasim" && w.target == "quit";
  #assert cp_sim_cmd("ls oasim", tb[..]).verb == "" && cp_sim_cmd("oasimx tap 1 2", tb[..]).verb == "" && cp_sim_cmd("", tb[..]).verb == "";
  #assert cp_sim_word_at(" a  b ", 1) == "b" && cp_sim_word_at("a", 3) == "" && cp_sim_rest("a b c", 1) == "b c" && cp_sim_rest("a", 2) == "";
}
