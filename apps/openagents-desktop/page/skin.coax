// Coder Desktop page (../page.coax): the layout scale and the page's skin.
#load "../../../components/skin/noir.coax";

// Points to a unit of the page's layout: the page lays out in points (Zeron's), so this is the text size alone (#13737).
cp_scale :: (s: [] CoderPage) -> f32 { return CP_ZOOMS[ifx s[0].ready then s[0].zoom else CP_ZOOM_USUAL]; }
// The atlas's sizes for Coder, in points: Zeron's type ramp (ds/tokens.luau) on the component library's slots.
// Prose 15 (Geist, SemiBold for **bold**), inline code 13.5, code blocks 13, tool output 12 and gutters 11 (Mono),
// sm 12 (tool rows, captions; Medium for chips), md 13 Medium (labels, menus, sidebar rows), xs 11 Medium,
// 14 (the composer's draft, as the platform editor sets it; the menus' search), then the library's display faces.
CP_FONT_SIZES :: [16] f32.[15, 12, 12, 15, 13.5, 13, 12, 11, 14, 13, 11, 14, 24, 11, 12, 20];
CP_COMPOSER_FACE :: FONT_SMALL;   // Geist 14: the composer's draft and placeholder when the platform editor is not showing
// T3 Code Dark palette with pure black backgrounds:
// pure black canvas & sidebar (#000000), crisp dark-gray 1px borders (#262626),
// low-glare #111111 composer & cards, #1a1b1b active rows, #141414 bubbles & menus,
// #f5f5f5 ink, #818181 muted, #346bf1 accent, and #fb414a red stop/error.
cp_t3_dark :: () -> Theme {
  text := hex(0xf5f5f5, 1);
  accent := hex(0x346bf1, 1);
  return Theme.{
    shell = hex(0x000000, 1),
    surface = hex(0x111111, 1),
    border = hex(0x222222, 1),
    text = text, muted = hex(0x818181, 1), faint = hex(0x656565, 1),
    disabled = opacity(text, 0.28),
    accent = accent,
    accent_hover = hex(0x4b7cf3, 1), accent_active = hex(0x2858d0, 1),
    selection = opacity(accent, 0.35),
    focus_ring = opacity(accent, 0.6),
    bg = hex(0x000000, 1),
    claude = hex(0xd97757, 1),
    line = hex(0x222222, 1),
    line_subtle = hex(0x262626, 1),
    line_strong = hex(0x383838, 1),
    hover = rgba(1, 1, 1, 0.06),
    pressed = rgba(1, 1, 1, 0.12),
    selected = hex(0x1a1b1b, 1),
    raised = hex(0x1a1b1b, 1),
    base = hex(0x111111, 1),
    sidebar = hex(0x000000, 1),
    row_selected = hex(0x1a1b1b, 1),
    primary = hex(0xf5f5f5, 1), primary_hover = hex(0xffffff, 1), primary_active = hex(0xd4d4d8, 1),
    secondary = hex(0x141414, 1), secondary_hover = hex(0x1e1e1e, 1),
    menu = hex(0x141414, 1), menu_selected = rgba(1, 1, 1, 0.08),
    popover = hex(0x141414, 1),
    composer_tint = hex(0x111111, 1),
    shadow_sm = rgba(0, 0, 0, 0x59 / 255.0), shadow_md = rgba(0, 0, 0, 0x66 / 255.0), shadow_lg = rgba(0, 0, 0, 0x80 / 255.0),
    composer_shadow = rgba(0, 0, 0, 0x70 / 255.0), menu_shadow = rgba(0, 0, 0, 0x52 / 255.0), dialog_shadow = rgba(0, 0, 0, 0x80 / 255.0),
    danger = hex(0xfb414a, 1), warning = hex(0xfe9a00, 1), success = hex(0x34d399, 1),
    info = hex(0x51a2ff, 1),
    connecting = hex(0x51a2ff, 1), input = hex(0x818cf8, 1), approval = hex(0xffb900, 1),
    plan = hex(0xad98fe, 1), done = hex(0x34d399, 1), failed = hex(0xff6467, 1),
    limited = hex(0xfe9a00, 1)};
}
cp_theme :: () -> Theme { return cp_t3_dark(); }
// Builds Coder Desktop's UiSkin over any resolved Theme (T3 Dark default, Daylight, Grove, Ocean, Ember, or imported VS Code theme).
cp_skin_from :: (th: Theme, base_noir: bool) -> UiSkin {
  src := ifx base_noir then cp_t3_dark() else th;
  k := zeron_skin_from(src);
  if base_noir {
    k.name = "t3-dark";
    k.danger_muted = src.danger; k.warning_muted = src.warning;
    k.code_wash = rgba(1, 1, 1, 0.08);
    k.hunk_wash = opacity(src.accent, 0.22);
    k.file_tint = src.warning;
    k.doc_tint = src.muted;
    k.menu_divider = hex(0x262626, 1);
    k.field_edge = hex(0x2a2a2a, 1);
    // Crisp dark code syntax palette for the right-pane File Viewer (#13992):
    // comment, keyword, string, number, type, function, property, variable, punctuation, tag, attribute, invalid.
    palette := [12] int.[0x737b86, 0x63b3ed, 0x8fd48a, 0xb794f4, 0xe5c07b, 0x79c0ff,
                         0x9cdcfe, 0xededed, 0xb0b8c4, 0xf472b6, 0xd2a8ff, 0xfb414a];
    for i: 0..<UISKIN_SYNTAX { k.syntax[i] = hex(palette[i], 1); }
    k.spinner[0] = src.info; k.spinner[1] = hex(0x93c5fd, 1); k.spinner[2] = src.muted;
  }
  k.chat.enabled = true;
  // Sidebar: 32pt rows, 26pt headers, 8pt inset/radius, 16pt pad, 15pt icons.
  k.app.side_row = 32.0f32;
  k.app.side_row_two = 48.0f32;
  k.app.side_head = 26.0f32;
  k.app.row_inset = 8.0f32;
  k.app.row_radius = 8.0f32;
  k.app.side_pad = 16.0f32;
  k.app.icon = 15.0f32;
  // Zeron's type ramp in points (ds/tokens.luau): prose 15/24, code 13/20, inline code 13.5, sm 12/16, md 13/18, xs 11/14.
  k.body.face = FONT_INPUT; k.body.size = 15; k.body.line = 24;
  k.strong.face = FONT_BOLD; k.strong.size = 15; k.strong.line = 24;
  k.code.face = FONT_MONO_14; k.code.size = 13.5; k.code.line = 24;
  k.mono.face = FONT_CODE; k.mono.size = 13; k.mono.line = 20;
  k.mono_small.face = FONT_MONO_12; k.mono_small.size = 12; k.mono_small.line = 16;
  k.mono_tiny.face = FONT_MONO_11; k.mono_tiny.size = 11; k.mono_tiny.line = 14;
  k.tool.face = FONT_TOOL; k.tool.size = 12; k.tool.line = 16;
  k.small.face = FONT_TOOL; k.small.size = 12; k.small.line = 16;
  k.label.face = FONT_MENU; k.label.size = 13; k.label.line = 18;
  k.title.face = FONT_MENU; k.title.size = 13; k.title.line = 18;
  k.menu.face = FONT_MENU; k.menu.size = 13; k.menu.line = 18;
  k.menu_small.face = FONT_MENU_SMALL; k.menu_small.size = 11; k.menu_small.line = 14;
  k.search.face = FONT_SEARCH; k.search.size = 14; k.search.line = 22;
  k.app.side_text = UiType.{face = FONT_MENU, size = 13, line = 18};   // a sidebar row: md, Zeron's main UI weight
  // Main transcript: Zeron proportions (ds/markdown.luau, ds/user_message.luau, ds/activity.luau).
  k.md.line = 24;
  k.md.block_line = 20;
  k.md.block_gap = 16.0f32;
  k.md.code_pad_x = 4.0f32;
  k.md.code_inset_y = 1.5f32;
  k.md.code_radius = 4.5f32;
  k.md.block_header = 32.0f32;
  k.md.block_pad_x = 14.0f32;
  k.md.block_pad_y = 12.0f32;
  k.md.block_radius = 12.0f32;   // radius.xl
  k.md.quote_rail = 2.0f32;
  k.app.gap = 12.0f32;
  k.app.gap_small = 4.0f32;
  k.app.icon_button = 28.0f32;
  k.app.bubble_pad_x = 14.0f32;
  k.app.bubble_pad_y = 10.0f32;
  k.app.bubble_radius = 16.0f32;
  k.app.bubble_share = 0.80f32;
  k.bubble = src.secondary;           // the bubble's ground (zeron.prose.bubble.bg)
  k.float_ground = src.menu;          // Jump to latest on the menus' solid ground (zeron.menu.solid)
  k.app.pill_lift = 8.0f32;
  k.app.code_head = 32.0f32;
  k.app.code_pad = 14.0f32;
  k.app.code_radius = 12.0f32;
  k.app.code_copy_h = 24.0f32; k.app.code_copy_x = 8.0f32; k.app.code_copy_icon = 12.0f32; k.app.code_copy_gap = 4.0f32; k.app.code_copy_edge = 5.0f32;
  k.app.tool_h = 26.0f32;
  k.app.tool_pad = 10.0f32;
  k.app.tool_body_pad = 10.0f32;
  k.app.tool_radius = 8.0f32;
  k.app.tool_icon = 14.0f32;
  k.app.tool_chevron = 12.0f32;
  k.tr.bubble_pad_x = 14.0f32;
  k.tr.bubble_pad_y = 10.0f32;
  k.tr.bubble_radius = 16.0f32;
  // Minimal live message entrance (120ms, 3pt); non-live messages suppress enter completely.
  k.motion.enter = 0.12f32;
  k.app.rise = 3.0f32;
  // Composer: T3 Code 2-row rounded-rectangle card (16pt radius, 22pt input line, 14pt side pad,
  // 12pt top pad, 40pt action strip, 6pt concentric inset, 28pt circular send/stop, 10pt stop square r=3, 28pt chips).
  k.cmp.radius = 16.0f32;
  k.cmp.line = 22.0f32;
  k.cmp.text_inset = 14.0f32;
  k.cmp.pad_top = 12.0f32;
  k.cmp.pad_v = 12.0f32;
  k.cmp.actions_row = 28.0f32;
  k.cmp.actions_bottom = 6.0f32;
  k.cmp.action_inset = 6.0f32;
  k.cmp.send = 28.0f32;
  k.cmp.stop = 10.0f32;
  k.cmp.stop_radius = 3.0f32;
  k.cmp.chip_h = 28.0f32;
  k.cmp.chip_radius = 8.0f32;
  k.cmp.chip_pad = 8.0f32;
  k.cmp.chip_icon = 14.0f32;
  k.cmp.chip_gap = 6.0f32;
  // The transcript's activity groups (#13731) and settings (settings.coax): Zeron's measures, in points as the page is.
  k.act = UiActivity.{};
  k.act.fade = 40.0f32;
  // a thought's words a step smaller than a reply's, as Zeron's (prose.small 14/20, ds/activity.luau): Geist 14,
  // Medium 14 for **bold** (the atlas has no SemiBold 14), code 13
  k.act.thought_face = CP_COMPOSER_FACE; k.act.thought_bold = FONT_SEARCH; k.act.thought_code = FONT_CODE;
  st := zeron_settings_from(src);
  st.tint = src.base; st.field = src.surface; st.field_edge = src.border;
  k.set = st;
  return k;
}
// Coder Desktop's default skin (T3 Dark): kept for tests and callers without page state.
cp_skin :: () -> UiSkin { return cp_skin_from(cp_t3_dark(), true); }
// Coder Desktop's live skin for the active theme state (customize.coax; #13887).
cp_skin_for :: (s: [] CoderPage) -> UiSkin {
  k := cp_skin_base(s);
  if s.count > 0 { k.set.key_ctrl = s[0].ctrl_keys; }
  return k;
}
cp_skin_base :: (s: [] CoderPage) -> UiSkin {
  if s.count < 1 || !cp_flag(s, DC_FLAG_CUSTOMIZE) { return cp_skin(); }
  th := cp_cust_theme(s);
  is_default_noir := cp_cust_is_monochrome(s) && !s[0].cust[0].theme[0].high_contrast;
  if cp_cust_is_monochrome(s) && !is_default_noir {
    th.shell = hex(0x000000, 1);
    th.bg = hex(0x000000, 1);
    th.sidebar = hex(0x000000, 1);
  }
  return cp_skin_from(th, is_default_noir);
}
