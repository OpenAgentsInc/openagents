// Coder Desktop page (../page.coax): a chat's turns and their rows: sending, the reply, commands,
// tool calls, thoughts and what sub-agents say, sub-agents and their workers, and the results.

// /fork in the composer: forks the shown chat into a new independent copy.
cp_fork_slash :: (s: [] CoderPage, text: string) -> bool {
  a := 0; b := text.count;
  while a < b && (text[a] == ' ' || text[a] == '\t' || text[a] == '\n' || text[a] == '\r') { a += 1; }
  while b > a && (text[b - 1] == ' ' || text[b - 1] == '\t' || text[b - 1] == '\n' || text[b - 1] == '\r') { b -= 1; }
  if b - a != 5 { return false; }
  if text[a] != '/' || text[a + 1] != 'f' || text[a + 2] != 'o' || text[a + 3] != 'r' || text[a + 4] != 'k' { return false; }
  cur := cast(string) s[0].current[0..<s[0].current_n];
  if cur == "chat.foreman" || s[0].nturns == 0 { return false; }
  eb_set(s[0].draft[..], "");
  s[0].ask = CP_ASK_FORK;
  return true;
}
// The draft becomes a turn. False when there is nothing to send or nowhere to put it.
cp_send :: (s: [] CoderPage) -> bool {
  text := eb_text(s[0].draft[..]);
  if text.count == 0 && cp_cargo_n(s) == 0 { return false; }
  if text.count > 0 && cp_goal_slash(s, text) { return true; }
  if text.count > 0 && cp_fork_slash(s, text) { return true; }
  if text.count > 0 && cp_rich_slash(s, text) { return true; }
  if cp_running(s) || cp_full(s) || cp_budget_exceeded(s) { return false; }
  if text.count > 0 && cp_fanout_submit(s, text) { cp_hist_record(s, text); return true; }
  // the message takes the draft's attachments and the files it mentions (attach.coax, #13699)
  if !cp_start_turn(s, ifx text.count > 0 then text else CP_ATTACHED_ONLY, CP_GOAL_PROMPT_NONE) { return false; }
  if text.count > 0 { cp_hist_record(s, text); }
  cp_refs_take(s, s[0].nturns - 1, text);
  eb_set(s[0].draft[..], "");
  return true;
}
cp_reply_set :: (s: [] CoderPage, i: int, text: string, more: bool) {
  was := s[0].turns[i].reply_n;
  prev_n := ifx s[0].turns[i].state == CP_RUNNING && more && was > 0 then cp_doc(s, i)[0].n else 0;
  n := ifx more then was else 0;
  if was == 0 && text.count > 0 { s[0].live_reply = i; }
  for c: text { if n >= s[0].turns[i].reply.count { s[0].turns[i].cut = true; break; } s[0].turns[i].reply[n] = c; n += 1; }
  s[0].turns[i].reply_n = n; s[0].turns[i].h = 0;
  s[0].rev_n += 1; s[0].turns[i].rev = s[0].rev_n;
  if !s[0].at_end && text.count > 0 { s[0].unseen = true; }   // Jump to latest says New reply
  doc := cp_doc(s, i);   // its blocks, now
  if s[0].turns[i].state == CP_RUNNING {
    if !more || s[0].veil_turn != i { s[0].veil[0] = Veil.{}; s[0].veil_turn = i; prev_n = 0; }
    if doc[0].n > prev_n { veil_push(s[0].veil[..], prev_n, doc[0].n, s[0].clock); }
  } else if s[0].veil_turn == i {
    s[0].veil[0] = Veil.{}; s[0].veil_turn = -1;
  }
}
// A command or a file read joins the running turn.
cp_cmd_add :: (s: [] CoderPage, i: int, text: string, output: string, read: bool, failed: bool) { _ = cp_call_add(s, i, -1, text, output, read, failed, false); }
// The worker asks before it runs a command: the command shows at once as running. When approval
// mode is active (permit.coax; #13873), it prompts interactively instead of auto-approving.
cp_cmd_asked :: (s: [] CoderPage, i: int, text: string, ticket: int) {
  _ = cp_call_add(s, i, -1, text, "", false, false, true);
  if cp_permit_should_gate(s) {
    cp_permit_take_gated(s, -1, "", ticket, text);
    return;
  }
  s[0].answer = ticket; s[0].answer_due = true;
}
// A command finished: the running row with its text takes the output, else it is a new row.
cp_cmd_done :: (s: [] CoderPage, i: int, text: string, output: string, failed: bool) {
  if cp_call_done(s, i, -1, text, output, failed) { s[0].turns[i].h = 0; return; }
  cp_cmd_add(s, i, text, output, false, failed);
}
// The working line's word while turn i runs: Stopping… once asked to stop, Sending… before its
// worker's first line, Working while one of its tool calls or sub-agents runs, and Thinking
// between them. Between tool calls the model is at work, and a harness that streams no thoughts
// there (Antigravity at low effort sends none) would show nothing else: the turn never looks dead.
cp_working_word :: (s: [] CoderPage, i: int) -> string {
  if s[0].turns[i].stopping { return "Stopping…"; }
  if !s[0].turns[i].heard { return "Sending…"; }
  if s[0].turns[i].waiting { return "Working"; }
  for j: 0..<s[0].turns[i].nagents { if s[0].turns[i].agents[j].state == CP_RUNNING { return "Working"; } }
  q := s[0].turns[i].head - 1;
  while q >= 0 { if s[0].calls[q].running { return "Working"; } q = s[0].calls[q].next - 1; }
  return "Thinking";
}
// The run is over: nothing is still running.
cp_cmds_end :: (s: [] CoderPage, i: int) {
  cp_calls_end(s, i, -1, true);
  for j: 0..<s[0].turns[i].nagents {
    if s[0].turns[i].agents[j].state == CP_RUNNING { s[0].turns[i].agents[j].state = CP_STOPPED; s[0].turns[i].agents[j].took = s[0].clock - s[0].turns[i].agents[j].began; cp_calls_end(s, i, j, true); }
    s[0].turns[i].agents[j].start_due = false; s[0].turns[i].agents[j].answer_due = false; s[0].turns[i].agents[j].now_running = false; s[0].turns[i].agents[j].paused = false; s[0].turns[i].agents[j].deny_due = false;
  }
  s[0].turns[i].waiting = false; s[0].results_due = false;
}
// How long a tool call took, in words: 12s, 1m 05s. "" for one that was not timed.
cp_took :: (out: [] u8, seconds: f32) -> string {
  if seconds < 0 { return ""; }
  whole := cast(int) seconds; n := 0;
  if whole >= 60 { n = el_put_i(out, n, whole / 60); n = el_put(out, n, "m "); if whole % 60 < 10 { n = el_put(out, n, "0"); } }
  n = el_put_i(out, n, whole % 60); n = el_put(out, n, "s");
  return cast(string) out[0..<n];
}

// While sub-agent j runs and is not running a tool, it waits on its model: "waiting on Gemini 4
// Carbon · 3m 05s", counted from its worker's last line, with a call that was sent again after
// it. "" while it runs a tool, is paused, has ended, or heard from its worker under 3 seconds ago.
cp_agent_wait :: (s: [] CoderPage, i: int, j: int, out: [] u8) -> string {
  g := s[0].turns[i].agents[j];
  if g.state != CP_RUNNING || g.now_running || g.paused || s[0].clock - g.heard < CP_WAIT_SHOWN { return ""; }
  tb: [24] u8;
  n := cp_out(out, "waiting on ");
  if g.level < CP_LEVEL_OR { n += cp_out(out[n..<out.count], "Gemini 4 "); }
  n += cp_out(out[n..<out.count], CP_LEVEL_NAME[g.level]); n += cp_out(out[n..<out.count], " · ");
  n += cp_out(out[n..<out.count], cp_took(tb[..], s[0].clock - g.heard));
  if g.again_n > 0 { n += cp_out(out[n..<out.count], " · "); n += cp_out(out[n..<out.count], cast(string) g.again[0..<g.again_n]); }
  return cast(string) out[0..<n];
}
CP_WAIT_SHOWN :: 3.0;

// ---- sub-agents (GitHub #13655). Microcoder hands tasks over in one line (MWW_DELEGATE); the
// host starts a worker for each, all at once, and feeds their lines back here; when every one
// has ended, the page owes Microcoder their results (coder_page_answer_line).
// A row joins a list, and its place in the page's calls comes back: sub-agent j's transcript, or
// with j under 0 the message's own rows. When the chat holds 6,000, the oldest row in the chat
// goes first, and its message or sub-agent counts it.
cp_head :: (s: [] CoderPage, i: int, j: int) -> int { return ifx j < 0 then s[0].turns[i].head else s[0].turns[i].agents[j].head; }
cp_call_add :: (s: [] CoderPage, i: int, j: int, text: string, output: string, read: bool, failed: bool, running: bool) -> int {
  q := -1;
  if s[0].calls_free > 0 { q = s[0].calls_free - 1; s[0].calls_free = s[0].calls[q].next; }
  else if s[0].calls_n < s[0].calls.count { q = s[0].calls_n; s[0].calls_n += 1; }
  else {
    // the oldest row in the chat is the head of its list
    for ti: 0..<s[0].nturns {
      hd := s[0].turns[ti].head - 1;
      if hd >= 0 && (q < 0 || s[0].calls[hd].order < s[0].calls[q].order) { q = hd; }
    }
    for ti: 0..<s[0].nturns { for tj: 0..<s[0].turns[ti].nagents {
      hd := s[0].turns[ti].agents[tj].head - 1;
      if hd >= 0 && (q < 0 || s[0].calls[hd].order < s[0].calls[q].order) { q = hd; }
    } }
    if q < 0 { return -1; }
    for ti: 0..<s[0].nturns {
      if s[0].turns[ti].head - 1 != q { continue; }
      s[0].turns[ti].head = s[0].calls[q].next; s[0].turns[ti].ncmds -= 1; s[0].turns[ti].early_cmds += 1; s[0].turns[ti].h = 0;
      if s[0].turns[ti].head == 0 { s[0].turns[ti].tail = 0; }
    }
    for ti: 0..<s[0].nturns { for tj: 0..<s[0].turns[ti].nagents {
      if s[0].turns[ti].agents[tj].head - 1 != q { continue; }
      s[0].turns[ti].agents[tj].head = s[0].calls[q].next; s[0].turns[ti].agents[tj].nrows -= 1; s[0].turns[ti].agents[tj].early_rows += 1;
      if s[0].turns[ti].agents[tj].head == 0 { s[0].turns[ti].agents[tj].tail = 0; }
    } }
  }
  s[0].calls[q].text_n = cp_out(s[0].calls[q].text[..], text);
  s[0].calls[q].long_at = 0; s[0].calls[q].long_n = 0;
  cp_call_out(s, q, output);
  s[0].calls[q].read = read; s[0].calls[q].failed = failed; s[0].calls[q].running = running; s[0].calls[q].thought = false; s[0].calls[q].said = false;
  s[0].calls[q].began = s[0].clock; s[0].calls[q].took = -1; s[0].calls[q].next = 0; s[0].calls[q].h = 0; s[0].live_call = q;
  s[0].calls_order += 1; s[0].calls[q].order = s[0].calls_order;
  if j < 0 {
    if s[0].turns[i].tail > 0 { s[0].calls[s[0].turns[i].tail - 1].next = q + 1; } else { s[0].turns[i].head = q + 1; }
    s[0].turns[i].tail = q + 1; s[0].turns[i].ncmds += 1; s[0].turns[i].h = 0;
    return q;
  }
  if s[0].turns[i].agents[j].tail > 0 { s[0].calls[s[0].turns[i].agents[j].tail - 1].next = q + 1; } else { s[0].turns[i].agents[j].head = q + 1; }
  s[0].turns[i].agents[j].tail = q + 1; s[0].turns[i].agents[j].nrows += 1;
  return q;
}
// A row's stored body text: from long_buf when it exceeded CP_CMD_OUT, else from calls[q].out.
cp_call_text :: (s: [] CoderPage, q: int) -> string {
  if s[0].calls[q].long_n > 0 {
    at := s[0].calls[q].long_at;
    return cast(string) s[0].long_buf[at..<at + s[0].calls[q].long_n];
  }
  return cast(string) s[0].calls[q].out[0..<s[0].calls[q].out_n];
}
// Store a thought's or sub-agent note's body on row q: inline in calls[q].out when <= CP_CMD_OUT,
// else in the page's long_buf up to CP_THOUGHT_MAX bytes so a single thought is never split.
cp_long_set :: (s: [] CoderPage, q: int, text: string) {
  s[0].calls[q].long_at = 0; s[0].calls[q].long_n = 0;
  if text.count <= CP_CMD_OUT {
    s[0].calls[q].out_n = cp_out(s[0].calls[q].out[..], text);
    return;
  }
  limit := ifx text.count > CP_THOUGHT_MAX then CP_THOUGHT_MAX else text.count;
  if limit < text.count {
    while limit > 1 && text[limit] >= 128 && text[limit] < 192 { limit -= 1; }
  }
  if s[0].long_n + limit <= s[0].long_buf.count {
    at := s[0].long_n;
    for k: 0..<limit { s[0].long_buf[at + k] = text[k]; }
    s[0].long_n = at + limit;
    s[0].calls[q].long_at = at; s[0].calls[q].long_n = limit;
    s[0].calls[q].out_n = 0;
    return;
  }
  cut := CP_CMD_OUT;
  while cut > 1 && text[cut] >= 128 && text[cut] < 192 { cut -= 1; }
  s[0].calls[q].out_n = cp_out(s[0].calls[q].out[..], cast(string) text[0..<cut]);
}
// A model's thinking joins a list as one row marked as a thought (GitHub #13671), up to
// CP_THOUGHT_MAX bytes without splitting mid-sentence. A row is named by its first line, without
// Markdown's marks. said: what a sub-agent said between its tool calls, shown as a reply does.
// A row's name: the first line of its text, without Markdown marks.
cp_row_head :: (text: string, hb: [] u8) -> int {
  hn := 0; at := 0;
  while at < text.count && (text[at] == 10 || text[at] == 32) { at += 1; }
  while at < text.count && text[at] != 10 && hn < hb.count {
    c := text[at]; at += 1;
    if c == '*' || c == '#' || c == '`' || c == 32 && hn == 0 { continue; }
    hb[hn] = c; hn += 1;
  }
  return hn;
}
cp_thought_add :: (s: [] CoderPage, i: int, j: int, text: string, said: bool) {
  if text.count == 0 { return; }
  hb: [CP_CMD] u8; hn := cp_row_head(text, hb[..]);
  q := cp_call_add(s, i, j, cast(string) hb[0..<hn], "", false, false, false);
  if q >= 0 {
    s[0].calls[q].thought = !said; s[0].calls[q].said = said;
    cp_long_set(s, q, text);
  }
}
// A piece of what sub-agent j says, as its model streams it: one model call's pieces are one row
// (a model that streams a few bytes at a time made a row of each). In place at the pool's end when
// the row's text is there, else the row's text and the piece are kept again.
cp_said_add :: (s: [] CoderPage, i: int, j: int, piece: string) {
  if piece.count == 0 { return; }
  q := s[0].turns[i].agents[j].tail - 1;
  if !s[0].turns[i].agents[j].said_open || q < 0 || !s[0].calls[q].said {
    cp_thought_add(s, i, j, piece, true);
    s[0].turns[i].agents[j].said_open = true;
    return;
  }
  c := s[0].calls[q];
  room := CP_THOUGHT_MAX - cp_call_text(s, q).count;
  take := ifx piece.count < room then piece.count else room;
  while take > 0 && take < piece.count && piece[take] >= 128 && piece[take] < 192 { take -= 1; }
  if take <= 0 { return; }
  if c.long_n == 0 && c.out_n + take <= CP_CMD_OUT {
    for k: 0..<take { s[0].calls[q].out[c.out_n + k] = piece[k]; }
    s[0].calls[q].out_n = c.out_n + take;
  } else if c.long_n > 0 && c.long_at + c.long_n == s[0].long_n && s[0].long_n + take <= s[0].long_buf.count {
    for k: 0..<take { s[0].long_buf[s[0].long_n + k] = piece[k]; }
    s[0].long_n += take; s[0].calls[q].long_n = c.long_n + take;
  } else {
    jb: [CP_THOUGHT_MAX] u8; old := cp_call_text(s, q);
    n := cp_out(jb[..], old); for k: 0..<take { if n < jb.count { jb[n] = piece[k]; n += 1; } }
    cp_long_set(s, q, cast(string) jb[0..<n]);
  }
  hb: [CP_CMD] u8; hn := cp_row_head(cp_call_text(s, q), hb[..]);
  s[0].calls[q].text_n = cp_out(s[0].calls[q].text[..], cast(string) hb[0..<hn]);
}
// The text without spaces and new lines at either end.
cp_trimmed :: (t: string) -> string {
  a := 0; b := t.count;
  while a < b && (t[a] == 32 || t[a] == 10 || t[a] == 13 || t[a] == 9) { a += 1; }
  while b > a && (t[b - 1] == 32 || t[b - 1] == 10 || t[b - 1] == 13 || t[b - 1] == 9) { b -= 1; }
  return cast(string) t[a..<b];
}
// Sub-agent j finished: its newest row, when it is what the last model call said (nothing came
// after it), was the reply as it streamed and goes, so the transcript shows the reply once and
// the summary does not count it as a thought (#13754). The ended line's text is the whole reply
// and takes its place, as it does in the conversation; with none, the words it streamed are the
// reply: kept as its reply (keep), their length returned (0 when no row went).
cp_said_drop_reply :: (s: [] CoderPage, i: int, j: int, keep: bool) -> int {
  q := s[0].turns[i].agents[j].tail - 1;
  if q < 0 || !s[0].calls[q].said { return 0; }
  kept := 0;
  if keep { cp_agent_reply_set(s, i, j, cp_trimmed(cp_call_text(s, q))); kept = s[0].turns[i].agents[j].reply_n; }
  prev := -1; at := s[0].turns[i].agents[j].head - 1;
  while at >= 0 && at != q { prev = at; at = s[0].calls[at].next - 1; }
  if at != q { return 0; }
  if prev < 0 { s[0].turns[i].agents[j].head = 0; s[0].turns[i].agents[j].tail = 0; }
  else { s[0].calls[prev].next = 0; s[0].turns[i].agents[j].tail = prev + 1; }
  s[0].turns[i].agents[j].nrows -= 1;
  s[0].calls[q].next = s[0].calls_free; s[0].calls_free = q + 1;
  s[0].calls[q].said = false; s[0].calls[q].text_n = 0; s[0].calls[q].out_n = 0; s[0].calls[q].long_n = 0;
  if s[0].live_call == q { s[0].live_call = -1; }
  return kept;
}
// Text with a new line wherever a line would pass `per` bytes, at a word's end where it has one.
cp_wrap :: (out: [] u8, text: string, per: int) -> int {
  n := 0; col := 0; space := -1;
  for c: text {
    if n + 2 >= out.count { break; }
    out[n] = c; n += 1;
    if c == 10 { col = 0; space = -1; continue; }
    col += 1; if c == 32 { space = n - 1; }
    if col <= per { continue; }
    if space >= 0 { out[space] = 10; col = n - 1 - space; space = -1; }
    else { out[n] = out[n - 1]; out[n - 1] = 10; n += 1; col = 1; }
  }
  return n;
}
// Where a sub-agent's nth kept call, oldest first, is in the page's calls; -1 when it has no such call.
cp_nth :: (s: [] CoderPage, i: int, j: int, n: int) -> int {
  q := cp_head(s, i, j) - 1;
  for step: 0..<n { if q < 0 { return -1; } q = s[0].calls[q].next - 1; }
  return q;
}
// A chat's calls are all let go, as the chat is.
cp_calls_reset :: (s: [] CoderPage) { s[0].calls_n = 0; s[0].calls_free = 0; s[0].calls_order = 0; s[0].long_n = 0; s[0].agent_n = 0; }
cp_call_out :: (s: [] CoderPage, q: int, output: string) {
  // an edit's diff is kept whole (up to 64 KB), so its row and the review show every line
  if output.count > CP_CMD_OUT && cp_edit_at(cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n]) > 0 && app_is_diff(output) { cp_long_set(s, q, output); return; }
  s[0].calls[q].long_n = 0;
  n := cp_out(s[0].calls[q].out[0..<CP_CMD_OUT], output);
  if n < output.count { n += cp_out(s[0].calls[q].out[n..<CP_CMD_OUT + 64], "\n[The output is cut at 2,000 bytes.]"); }
  s[0].calls[q].out_n = n;
}
// An edit's row is named "edit PATH" or "write PATH" (Microcoder's edits, Claude Code's Edit and
// Write): where its path starts, 0 for any other row.
cp_edit_at :: (text: string) -> int {
  if text.count > 5 && cast(string) text[0..<5] == "edit " { return 5; }
  if text.count > 6 && cast(string) text[0..<6] == "write " { return 6; }
  return 0;
}
// Where row q's path starts when it is an edit that changed a file and its output is the diff; 0 otherwise.
cp_edit_diff :: (s: [] CoderPage, q: int) -> int {
  c := s[0].calls[q];
  if c.read || c.thought || c.said || c.failed || c.running { return 0; }
  at := cp_edit_at(cast(string) c.text[0..<c.text_n]);
  if at == 0 || !app_is_diff(cp_call_text(s, q)) { return 0; }
  return at;
}
// A sub-agent's tool call ended: its running row takes the output. False when no row is running with that text.
cp_call_done :: (s: [] CoderPage, i: int, j: int, text: string, output: string, failed: bool) -> bool {
  cut := cast(string) text[0..<(ifx text.count < CP_CMD then text.count else CP_CMD)];
  q := cp_head(s, i, j) - 1;
  while q >= 0 {
    nx := s[0].calls[q].next - 1;
    if !s[0].calls[q].running || cast(string) s[0].calls[q].text[0..<s[0].calls[q].text_n] != cut { q = nx; continue; }
    cp_call_out(s, q, output);
    s[0].calls[q].failed = failed; s[0].calls[q].running = false;
    s[0].calls[q].took = s[0].clock - s[0].calls[q].began;
    return true;
  }
  return false;
}
// A sub-agent ended: none of its tool calls is still running.
cp_calls_end :: (s: [] CoderPage, i: int, j: int, failed: bool) {
  q := cp_head(s, i, j) - 1;
  while q >= 0 {
    nx := s[0].calls[q].next - 1;
    if !s[0].calls[q].running { q = nx; continue; }
    s[0].calls[q].running = false; s[0].calls[q].failed = failed;
    s[0].calls[q].took = s[0].clock - s[0].calls[q].began;
    q = nx;
  }
}
cp_pane_open :: (s: [] CoderPage, turn: int, j: int) {
  s[0].live_pane = -1; s[0].live_call = -1; s[0].pane_tab = CP_TAB_AGENT;
  s[0].pane_open = true; s[0].pane_turn = turn; s[0].pane_agent = j; s[0].pane_parsed = -1;
  s[0].pane_scroll = 0; s[0].pane_content = 0; s[0].pane_stick = s[0].turns[turn].agents[j].state == CP_RUNNING;
}
cp_delegate :: (s: [] CoderPage, i: int, tasks: string, ticket: int) {
  asked := ifx tasks.count > 1 && tasks[0] == '[' then cl_count(tasks) else 0;
  if asked > CP_ROUND { asked = CP_ROUND; }
  s[0].turns[i].round_asked = asked; s[0].turns[i].ticket = ticket; s[0].turns[i].waiting = true;
  first := -1;
  for q: 0..<asked {
    one := cl_json(tasks, cl_item(tasks, q));
    ar := [1] ClArena.[ClArena.{buf = s[0].scratch[..]}];
    s[0].turns[i].round_who[q] = 0;
    // a task with resume lets a paused sub-agent go on, with the task as a note to it (GitHub #13676);
    // one still running is waited for, and one that has ended gives its result again (#13766);
    // a running one is sent the task as a note, a steer of its parent's (#13776)
    resume := cl_int(one, "resume");
    if resume.ok && resume.value > 0 {
      g := resume.value - 1;
      s[0].turns[i].round_who[q] = -1;
      if g < s[0].turns[i].nagents && !(s[0].turns[i].agents[g].state == CP_RUNNING && s[0].turns[i].agents[g].paused) {
        s[0].turns[i].round_who[q] = g + 1;
        if s[0].turns[i].agents[g].state == CP_RUNNING { cp_agent_note(s, i, g, cl_str(ar[..], one, "task")); }
        continue;
      }
      if g < s[0].turns[i].nagents && s[0].turns[i].agents[g].state == CP_RUNNING && s[0].turns[i].agents[g].paused {
        s[0].turns[i].agents[g].paused = false; s[0].turns[i].agents[g].quiet = 0; s[0].turns[i].agents[g].deny_due = true;
        s[0].turns[i].agents[g].say_n = cp_out(s[0].turns[i].agents[g].say[..], cl_str(ar[..], one, "task"));
        s[0].turns[i].agents[g].now_n = cp_out(s[0].turns[i].agents[g].now[..], "going on");
        s[0].turns[i].round_who[q] = g + 1;
        if first < 0 { first = g; }
      }
      continue;
    }
    j := s[0].turns[i].nagents;
    if j >= s[0].turns[i].agents.count { continue; }
    s[0].turns[i].agents[j] = CpAgent.{};
    s[0].turns[i].agents[j].task_n = cp_out(s[0].turns[i].agents[j].task[..], cl_str(ar[..], one, "task"));
    level := cl_str(ar[..], one, "level");
    for name, q2: CP_LEVEL { if name == level { s[0].turns[i].agents[j].level = q2; } }
    for name, q2: CP_LEVEL_OLD { if name == level { s[0].turns[i].agents[j].level = q2; } }
    s[0].turns[i].agents[j].state = CP_RUNNING; s[0].turns[i].agents[j].start_due = true;
    s[0].turns[i].agents[j].began = s[0].clock; s[0].turns[i].agents[j].took = -1; s[0].turns[i].agents[j].heard = s[0].clock;
    s[0].turns[i].agents[j].after = s[0].turns[i].early_cmds + s[0].turns[i].ncmds;
    s[0].turns[i].nagents = j + 1; s[0].turns[i].round_who[q] = j + 1;
    if first < 0 { first = j; }
  }
  if first >= 0 && !s[0].pane_manual && !(s[0].pane_open && s[0].pane_turn == i && s[0].pane_agent == first) {
    cp_pane_open(s, i, first);
  }
  s[0].turns[i].h = 0;
  cp_round_check(s, i);
}
// Microcoder's note for running sub-agent j (#13776): due to its worker as a parent's steer
// (mww_note, sent by coder_page_agent_answer_line). A Claude level's worker takes no steers: the
// note is refused at once and Microcoder is told. An empty note only waits.
cp_agent_note :: (s: [] CoderPage, i: int, j: int, note: string) {
  if note.count == 0 { return; }
  a := s[0].turns[i].agents[j..<j + 1];
  if a[0].level >= CP_LEVEL_CLAUDE {
    a[0].note = CP_NOTE_REFUSED; a[0].note_why_n = cp_out(a[0].note_why[..], "a Claude sub-agent takes no notes while it runs"); return;
  }
  a[0].say_n = cp_out(a[0].say[..], note); a[0].note = CP_NOTE_DUE; a[0].notes += 1;
}
// Every sub-agent of the round has ended or paused, or any one has ended (finished, failed or
// stopped) while its siblings run on: the worker is owed results (#13766).
cp_round_check :: (s: [] CoderPage, i: int) {
  if !s[0].turns[i].waiting { return; }
  all_ready := true;
  for q: 0..<s[0].turns[i].round_asked {
    w := s[0].turns[i].round_who[q];
    if w > 0 {
      st := s[0].turns[i].agents[w - 1].state;
      if st == CP_DONE || st == CP_FAILED || st == CP_STOPPED { s[0].results_due = true; return; }
      if st == CP_RUNNING && s[0].turns[i].agents[w - 1].note == CP_NOTE_REFUSED { s[0].results_due = true; return; }   // its note did not reach it (#13776)
      if st == CP_RUNNING && !s[0].turns[i].agents[w - 1].paused { all_ready = false; }
    }
  }
  if all_ready { s[0].results_due = true; }
}
// Sub-agent j's reply, whole, from the page's pool of sub-agent replies.
cp_agent_reply :: (s: [] CoderPage, i: int, j: int) -> string {
  at := s[0].turns[i].agents[j].reply_at; n := s[0].turns[i].agents[j].reply_n;
  if n <= 0 || at < 0 || at + n > s[0].agent_n { return ""; }
  return cast(string) s[0].agent_buf[at..<at + n];
}
// Keeps text whole as sub-agent j's reply: added to the end of the chat's pool. A reply is never cut
// to a size of its own. When the pool is full, the replies superseded since (a resumed sub-agent's
// earlier one) are squeezed out first; only a chat past CP_AGENT_POOL in all loses the end of one,
// and the reply says so. text must not be in the pool itself.
CP_AGENT_FULL :: "\n[This chat's sub-agent replies filled the app's 32 MB for them: the rest of this reply is not kept here.]";
cp_agent_reply_set :: (s: [] CoderPage, i: int, j: int, text: string) {
  s[0].turns[i].agents[j].reply_at = 0; s[0].turns[i].agents[j].reply_n = 0;
  if text.count == 0 { return; }
  if s[0].agent_n + text.count > s[0].agent_buf.count { cp_agent_pack(s); }
  at := s[0].agent_n; room := s[0].agent_buf.count - at;
  n := text.count; cut := false;
  if n > room {
    cut = true; n = room - CP_AGENT_FULL.count;
    if n < 0 { n = 0; }
    while n > 0 && n < text.count && (text[n] & 0xC0) == 0x80 { n -= 1; }
  }
  for k: 0..<n { s[0].agent_buf[at + k] = text[k]; }
  if cut && room - n >= CP_AGENT_FULL.count { for c, k: CP_AGENT_FULL { s[0].agent_buf[at + n + k] = c; } n += CP_AGENT_FULL.count; }
  s[0].turns[i].agents[j].reply_at = at; s[0].turns[i].agents[j].reply_n = n; s[0].agent_n = at + n;
}
// The pool holds only the replies some sub-agent still has, in their order, from its start.
cp_agent_pack :: (s: [] CoderPage) {
  to := 0; last := -1;
  while true {
    bi := -1; bj := -1; best := -1;
    for ti: 0..<s[0].nturns { for tj: 0..<s[0].turns[ti].nagents {
      a := s[0].turns[ti].agents[tj].reply_at;
      if s[0].turns[ti].agents[tj].reply_n > 0 && a > last && (best < 0 || a < best) { best = a; bi = ti; bj = tj; }
    } }
    if bi < 0 { break; }
    n := s[0].turns[bi].agents[bj].reply_n;
    if best != to { for k: 0..<n { s[0].agent_buf[to + k] = s[0].agent_buf[best + k]; } }
    s[0].turns[bi].agents[bj].reply_at = to; to += n; last = best;
  }
  s[0].agent_n = to;
}
cp_agent_end :: (s: [] CoderPage, i: int, j: int, state: int, text: string) {
  cp_agent_reply_set(s, i, j, text);
  cp_agent_finish(s, i, j, state);
}
// Sub-agent j ended with the reply it already has.
cp_agent_finish :: (s: [] CoderPage, i: int, j: int, state: int) {
  s[0].turns[i].agents[j].state = state; s[0].turns[i].agents[j].took = s[0].clock - s[0].turns[i].agents[j].began;
  s[0].turns[i].agents[j].now_running = false; s[0].turns[i].agents[j].answer_due = false; s[0].turns[i].agents[j].paused = false; s[0].turns[i].agents[j].deny_due = false;
  cp_calls_end(s, i, j, state != CP_DONE);
  n := s[0].turns[i].agents[j].reply_n; if n > 0 && s[0].pane_open && s[0].pane_turn == i && s[0].pane_agent == j { s[0].live_pane = i * CP_AGENTS + j; } s[0].turns[i].h = 0;
  cp_round_check(s, i);
}
// The next sub-agent the host is to start a worker for (once each), -1 for none.
coder_page_agent_next :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return -1; }
  i := s[0].nturns - 1;
  for j: 0..<s[0].turns[i].nagents { if s[0].turns[i].agents[j].start_due { s[0].turns[i].agents[j].start_due = false; return j; } }
  return -1;
}
// Whether Claude Code is installed on this computer: with it, Microcoder may pick a Claude level.
coder_page_set_claude :: (s: [] CoderPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].claude = on; } }
// Whether sub-agent j runs in Claude Code: the host starts the Claude worker for it, not Microcoder's.
coder_page_agent_claude :: (s: [] CoderPage, j: int) -> bool #export_c #effects(all) {
  if s.count < 1 || s[0].nturns < 1 { return false; }
  i := s[0].nturns - 1;
  return j >= 0 && j < s[0].turns[i].nagents && s[0].turns[i].agents[j].level >= CP_LEVEL_CLAUDE;
}
// Sub-agent j's task line for its worker: a simple task on Hydrogen, a complex one on Carbon, a
// neon one on Gemini 4 Neon, an openrouter one on the OpenRouter model set for sub-agents, a Claude level's on that Claude model (the task alone: Claude Code finds the skills itself).
// It has no sub-agents of its own.
coder_page_agent_task :: (s: [] CoderPage, j: int, session: string, cwd: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return 0; }
  i := s[0].nturns - 1;
  if j < 0 || j >= s[0].turns[i].nagents { return 0; }
  whole: [CP_SKILLS + CP_AGENT_TASK] u8;
  n := cp_out(whole[..], cast(string) s[0].skills[0..<s[0].skills_n]);
  n += cp_out(whole[n..<whole.count], cast(string) s[0].turns[i].agents[j].task[0..<s[0].turns[i].agents[j].task_n]);
  level := s[0].turns[i].agents[j].level;
  if level >= CP_LEVEL_CLAUDE { return mww_task(out, McTask.{task = cast(string) s[0].turns[i].agents[j].task[0..<s[0].turns[i].agents[j].task_n], session = session, cwd = cwd, sandbox = "danger-full-access", ceiling = 3, no_ask = true, model = CP_LEVEL[level], no_steer = true}); }
  t := McTask.{task = cast(string) whole[0..<n], session = session, cwd = cwd, sandbox = "danger-full-access", ceiling = 3, gated = true, edits = true, unlimited = true, no_ask = true,
               model = CP_MODEL_SIMPLE, effort = "low", no_steer = true};
  if level == 1 { t.model = CP_MODEL_COMPLEX; t.effort = "medium"; }
  if level == 2 { t.model = CP_MODEL_NEON; t.effort = "medium"; }
  if level == CP_LEVEL_OR && s[0].or_sub_n > 0 {
    k := cp_out(s[0].or_sub_id[..], CP_OR_PREFIX); k += cp_out(s[0].or_sub_id[k..<s[0].or_sub_id.count], cp_or_sub(s));
    t.model = cast(string) s[0].or_sub_id[0..<k]; t.effort = "medium";
  }
  if level == CP_LEVEL_INKLING {
    t.local = true; t.model = "inkling-2-mini"; t.effort = "low";
  }
  return mww_task(out, t);
}
// Whether a shell command that succeeded changed a file (for the sub-agent CP_QUIET counter).
cp_str_has :: (s: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if s.count < needle.count { return false; }
  for i: 0..<(s.count - needle.count + 1) {
    if cast(string) s[i..<(i + needle.count)] == needle { return true; }
  }
  return false;
}
cp_str_starts :: (s: string, head: string) -> bool {
  return s.count >= head.count && cast(string) s[0..<head.count] == head;
}
cp_cmd_base :: (s: string) -> string {
  i := s.count;
  while i > 0 && s[i - 1] != '/' { i -= 1; }
  return cast(string) s[i..<s.count];
}
cp_cmd_unquote :: (s: string) -> string {
  if s.count >= 2 && (s[0] == '"' || s[0] == '\'') && s[s.count - 1] == s[0] {
    return cast(string) s[1..<(s.count - 1)];
  }
  return s;
}
cp_cmd_assign :: (s: string) -> bool {
  if s.count < 2 || s[0] == '=' { return false; }
  for i: 0..<s.count {
    c := s[i];
    if c == '=' { return i > 0; }
    if !((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') { return false; }
  }
  return false;
}
cp_py_writes :: (code: string) -> bool {
  if cp_str_has(code, "write_text(") || cp_str_has(code, "write_bytes(") ||
     cp_str_has(code, ".write(") || cp_str_has(code, "writelines(") ||
     cp_str_has(code, "shutil.copy") || cp_str_has(code, "shutil.move") || cp_str_has(code, "shutil.rmtree") ||
     cp_str_has(code, "os.replace(") || cp_str_has(code, "os.rename(") ||
     cp_str_has(code, "os.remove(") || cp_str_has(code, "os.unlink(") ||
     cp_str_has(code, "os.mkdir(") || cp_str_has(code, "os.makedirs(") ||
     cp_str_has(code, ".unlink(") || cp_str_has(code, ".replace(") ||
     cp_str_has(code, ".rename(") || cp_str_has(code, ".mkdir(") ||
     cp_str_has(code, ".truncate(") || cp_str_has(code, "inplace=True") { return true; }
  if cp_str_has(code, "open(") && (
     cp_str_has(code, "'w'") || cp_str_has(code, "\"w\"") || cp_str_has(code, "'wb'") || cp_str_has(code, "\"wb\"") ||
     cp_str_has(code, "'a'") || cp_str_has(code, "\"a\"") || cp_str_has(code, "'ab'") || cp_str_has(code, "\"ab\"") ||
     cp_str_has(code, "'r+'") || cp_str_has(code, "\"r+\"") || cp_str_has(code, "'w+'") || cp_str_has(code, "\"w+\"") ||
     cp_str_has(code, "'x'") || cp_str_has(code, "\"x\"") || cp_str_has(code, "mode='w") || cp_str_has(code, "mode=\"w") ||
     cp_str_has(code, "mode='a") || cp_str_has(code, "mode=\"a")) { return true; }
  return false;
}
cp_script_writes :: (code: string) -> bool {
  return cp_str_has(code, "writeFile") || cp_str_has(code, "appendFile") ||
         cp_str_has(code, "renameSync") || cp_str_has(code, "unlinkSync") ||
         cp_str_has(code, "mkdirSync") || cp_str_has(code, "copyFile") ||
         cp_str_has(code, "File.write") || cp_str_has(code, "File.open");
}
// Checks one simple command (words wa[0..<nw]..wb[0..<nw] in cmd).
cp_simple_edits_file :: (cmd: string, wa: [] int, wb: [] int, nw: int) -> bool {
  i := 0;
  while i < nw {
    w := cp_cmd_unquote(cast(string) cmd[wa[i]..<wb[i]]);
    if cp_cmd_assign(w) || w == "env" || w == "time" || w == "nice" || w == "nohup" || w == "command" || w == "sudo" { i += 1; continue; }
    if w == "timeout" { i += 2; continue; }
    if cp_cmd_base(w) == "remote.sh" {
      k := i + 1;
      while k < nw && cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]) != "--" { k += 1; }
      i = k + 1; continue;
    }
    break;
  }
  if i >= nw { return false; }
  prog := cp_cmd_base(cp_cmd_unquote(cast(string) cmd[wa[i]..<wb[i]]));
  if prog == "tee" || prog == "cp" || prog == "mv" || prog == "rm" || prog == "mkdir" ||
     prog == "touch" || prog == "install" || prog == "ln" || prog == "patch" ||
     prog == "truncate" || prog == "dd" || prog == "chmod" || prog == "chown" || prog == "rsync" {
    return true;
  }
  if prog == "sed" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-i" || a == "--in-place" || cp_str_starts(a, "-i") || cp_str_starts(a, "--in-place=") { return true; }
    }
    return false;
  }
  if prog == "awk" || prog == "gawk" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-i" && k + 1 < nw && cp_cmd_unquote(cast(string) cmd[wa[k + 1]..<wb[k + 1]]) == "inplace" { return true; }
    }
    return false;
  }
  if prog == "perl" || prog == "ruby" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-i" || cp_str_starts(a, "-i") || a == "-pi" || cp_str_starts(a, "-pi") || a == "-pni" { return true; }
    }
    return cp_script_writes(cmd);
  }
  if cp_str_starts(prog, "python") {
    if cp_py_writes(cmd) { return true; }
    return false;
  }
  if prog == "node" || prog == "bun" || prog == "deno" {
    return cp_script_writes(cmd);
  }
  if prog == "git" {
    k := i + 1;
    while k < nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-C" || a == "-c" { k += 2; continue; }
      if cp_str_starts(a, "-") { k += 1; continue; }
      break;
    }
    if k >= nw { return false; }
    sub := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
    if sub == "apply" || sub == "checkout" || sub == "restore" || sub == "cherry-pick" ||
       sub == "revert" || sub == "merge" || sub == "rebase" || sub == "reset" ||
       sub == "rm" || sub == "mv" || sub == "am" || sub == "clean" || sub == "switch" {
      return true;
    }
    return false;
  }
  if prog == "gofmt" || prog == "prettier" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-w" || a == "--write" { return true; }
    }
    return false;
  }
  if prog == "clang-format" || prog == "swift-format" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "-i" || a == "--in-place" { return true; }
    }
    return false;
  }
  if prog == "rustfmt" || prog == "black" { return true; }
  if prog == "ruff" || prog == "eslint" {
    for k: (i + 1)..<nw {
      a := cp_cmd_unquote(cast(string) cmd[wa[k]..<wb[k]]);
      if a == "format" || a == "--fix" { return true; }
    }
    return false;
  }
  return false;
}
cp_cmd_edits_file :: (cmd: string) -> bool {
  n := cmd.count;
  i := 0;
  wa: [32] int; wb: [32] int; nw := 0;
  hd_a := 0; hd_b := 0;
  while i <= n {
    // skip spaces and tabs
    while i < n && (cmd[i] == ' ' || cmd[i] == '\t') { i += 1; }
    // end of simple command?
    if i == n || cmd[i] == ';' || cmd[i] == '\n' || cmd[i] == '|' || cmd[i] == '&' {
      if nw > 0 && cp_simple_edits_file(cmd, wa[..], wb[..], nw) { return true; }
      nw = 0;
      if i == n { break; }
      if cmd[i] == '\n' && hd_b > hd_a {
        delim := cast(string) cmd[hd_a..<hd_b];
        hd_a = 0; hd_b = 0;
        i += 1;
        while i < n {
          la := i;
          while i < n && cmd[i] != '\n' { i += 1; }
          lb := i;
          while la < lb && (cmd[la] == '\t' || cmd[la] == ' ') { la += 1; }
          while lb > la && cmd[lb - 1] == '\r' { lb -= 1; }
          if i < n { i += 1; }
          if cast(string) cmd[la..<lb] == delim { break; }
        }
        continue;
      }
      if (cmd[i] == '|' || cmd[i] == '&') && i + 1 < n && cmd[i + 1] == cmd[i] { i += 2; } else { i += 1; }
      continue;
    }
    // heredoc (<<DELIM or <<-DELIM): remember delimiter to skip body after newline
    if cmd[i] == '<' && i + 1 < n && cmd[i + 1] == '<' && !(i + 2 < n && cmd[i + 2] == '<') {
      i += 2;
      if i < n && cmd[i] == '-' { i += 1; }
      while i < n && (cmd[i] == ' ' || cmd[i] == '\t') { i += 1; }
      da := i;
      while i < n && cmd[i] != ' ' && cmd[i] != '\t' && cmd[i] != ';' && cmd[i] != '\n' && cmd[i] != '|' && cmd[i] != '&' && cmd[i] != '>' {
        if cmd[i] == '\'' || cmd[i] == '"' {
          q := cmd[i]; i += 1;
          while i < n && cmd[i] != q { i += 1; }
          if i < n { i += 1; }
        } else {
          i += 1;
        }
      }
      db := i;
      if db - da >= 2 && (cmd[da] == '\'' || cmd[da] == '"') && cmd[db - 1] == cmd[da] { da += 1; db -= 1; }
      if db > da && hd_b == hd_a { hd_a = da; hd_b = db; }
      continue;
    }
    // output redirection (> or >>) outside quotes, ignoring fd dups (>&) and /dev/null
    is_redir := false;
    rj := i;
    if cmd[rj] >= '0' && cmd[rj] <= '9' && rj + 1 < n && cmd[rj + 1] == '>' { rj += 1; }
    if cmd[rj] == '>' { is_redir = true; }
    if is_redir {
      rj += 1;
      if rj < n && cmd[rj] == '>' { rj += 1; }
      if rj < n && cmd[rj] == '&' {
        // fd dup like 2>&1, skip token
        rj += 1;
        while rj < n && cmd[rj] != ' ' && cmd[rj] != '\t' && cmd[rj] != ';' && cmd[rj] != '\n' && cmd[rj] != '|' && cmd[rj] != '&' { rj += 1; }
        i = rj;
        continue;
      }
      while rj < n && (cmd[rj] == ' ' || cmd[rj] == '\t') { rj += 1; }
      ta := rj;
      while rj < n && cmd[rj] != ' ' && cmd[rj] != '\t' && cmd[rj] != ';' && cmd[rj] != '\n' && cmd[rj] != '|' && cmd[rj] != '&' {
        if cmd[rj] == '\'' || cmd[rj] == '"' {
          q := cmd[rj]; rj += 1;
          while rj < n && cmd[rj] != q {
            if q == '"' && cmd[rj] == '\\' && rj + 1 < n { rj += 2; continue; }
            rj += 1;
          }
          if rj < n { rj += 1; }
        } else {
          rj += 1;
        }
      }
      target := cp_cmd_unquote(cast(string) cmd[ta..<rj]);
      if target.count > 0 && target != "/dev/null" { return true; }
      i = rj;
      continue;
    }
    // read one word
    start := i;
    while i < n && cmd[i] != ' ' && cmd[i] != '\t' && cmd[i] != ';' && cmd[i] != '\n' && cmd[i] != '|' && cmd[i] != '&' && cmd[i] != '>' {
      if cmd[i] == '\'' || cmd[i] == '"' {
        q := cmd[i]; i += 1;
        while i < n && cmd[i] != q {
          if q == '"' && cmd[i] == '\\' && i + 1 < n { i += 2; continue; }
          i += 1;
        }
        if i < n { i += 1; }
      } else if cmd[i] == '\\' && i + 1 < n {
        i += 2;
      } else {
        i += 1;
      }
    }
    if i > start && nw < 32 {
      wa[nw] = start; wb[nw] = i; nw += 1;
    }
  }
  return false;
}
// One line from sub-agent j's worker. Returns its kind (MWW_*).
coder_page_agent_line :: (s: [] CoderPage, j: int, line: string) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return 0; }
  i := s[0].nturns - 1;
  if j < 0 || j >= s[0].turns[i].nagents || s[0].turns[i].agents[j].state != CP_RUNNING { return 0; }
  ar := [1] ClArena.[ClArena.{buf = s[0].arena[..]}];
  l: [1] MwwLine;
  kind := mww_read(ar[..], line, l[..]);
  claude := s[0].turns[i].agents[j].level >= CP_LEVEL_CLAUDE;   // its worker's ask is a tool call starting: no answer is owed
  waited := s[0].clock - s[0].turns[i].agents[j].heard; s[0].turns[i].agents[j].heard = s[0].clock;
  if kind != MWW_REPLY { s[0].turns[i].agents[j].said_open = false; }   // a model call or a tool call ended what it was saying
  if kind == MWW_ATTEMPT { cp_add_cost(s, cp_attempt_cost(l[0])); }
  if kind == MWW_ATTEMPT && l[0].outcome == "retried" {
    // a model call that failed before its answer and goes again: the row says so until the sub-agent moves on
    tb: [24] u8; ab := s[0].turns[i].agents[j].again[..]; n := 0;
    st := ifx l[0].status.ok then l[0].status.value else 0;
    if st == 429 { n = cp_out(ab, "a call was rate-limited and is being sent again"); }
    else if st == 0 { n = cp_out(ab, "a call got no answer in "); n += cp_out(ab[n..<ab.count], cp_took(tb[..], waited)); n += cp_out(ab[n..<ab.count], " and is being sent again"); }
    else { n = cp_out(ab, "a call failed (HTTP "); n = el_put_i(ab, n, st); n += cp_out(ab[n..<ab.count], ") and is being sent again"); }
    s[0].turns[i].agents[j].again_n = n;
  } else if kind != MWW_ATTEMPT { s[0].turns[i].agents[j].again_n = 0; }
  if kind == MWW_ASK && !claude && s[0].turns[i].agents[j].quiet >= CP_QUIET {
    // 100 tool calls in a row with no file changed: this command waits, and Microcoder decides (GitHub #13676)
    s[0].turns[i].agents[j].answer = l[0].ticket.value; s[0].turns[i].agents[j].answer_due = false; s[0].turns[i].agents[j].paused = true;
    s[0].turns[i].agents[j].now_n = cp_out(s[0].turns[i].agents[j].now[..], "paused: Microcoder decides whether it goes on"); s[0].turns[i].agents[j].now_running = false;
    s[0].turns[i].h = 0;
    cp_round_check(s, i);
  } else if kind == MWW_ASK {
    s[0].turns[i].agents[j].quiet += 1;
    s[0].turns[i].agents[j].answer = l[0].ticket.value;
    s[0].turns[i].agents[j].now_n = cp_out(s[0].turns[i].agents[j].now[..], l[0].command); s[0].turns[i].agents[j].now_running = true;
    s[0].turns[i].agents[j].calls += 1; _ = cp_call_add(s, i, j, l[0].command, "", false, false, true);
    if !claude && cp_permit_should_gate(s) {
      s[0].turns[i].agents[j].answer_due = false;
      anb: [CP_PERMIT_AGENT_NAME] u8;
      cp_permit_take_gated(s, j, cp_permit_agent_label(s, i, j, anb[..]), l[0].ticket.value, l[0].command);
    } else {
      s[0].turns[i].agents[j].answer_due = !claude;
    }
  } else if kind == MWW_PERMIT {
    anb: [CP_PERMIT_AGENT_NAME] u8;
    cp_permit_take_line(s, j, cp_permit_agent_label(s, i, j, anb[..]), l[0], line);
  } else if kind == MWW_COMMAND {
    failed := l[0].timed_out.value || l[0].exit.value != 0;
    // an edit, or a command the worker ran before the first call, was not asked about
    if cp_call_done(s, i, j, l[0].command, l[0].output, failed) {
      if !claude && !failed && cp_cmd_edits_file(l[0].command) { s[0].turns[i].agents[j].quiet = 0; }
    } else if !claude && !s[0].turns[i].agents[j].now_running {
      s[0].turns[i].agents[j].quiet = ifx failed then s[0].turns[i].agents[j].quiet + 1 else 0;   // an edit that took changed a file
      s[0].turns[i].agents[j].now_n = cp_out(s[0].turns[i].agents[j].now[..], l[0].command); s[0].turns[i].agents[j].calls += 1;
      _ = cp_call_add(s, i, j, l[0].command, l[0].output, false, failed, false);
    }
    s[0].turns[i].agents[j].now_running = false;
  } else if kind == MWW_VIEW {
    vb: [CP_CMD] u8; vn := cp_out(vb[..], "read "); vn += cp_out(vb[vn..<CP_CMD], l[0].path);
    s[0].turns[i].agents[j].now_n = cp_out(s[0].turns[i].agents[j].now[..], cast(string) vb[0..<vn]); s[0].turns[i].agents[j].now_running = false;
    s[0].turns[i].agents[j].quiet += 1;
    s[0].turns[i].agents[j].calls += 1; _ = cp_call_add(s, i, j, l[0].path, ifx l[0].found.value then "" else "No such file.", true, !l[0].found.value, false);
  } else if kind == MWW_STEERED && l[0].id.count > 5 && cast(string) l[0].id[0..<5] == "note-" {
    // its worker's answer to Microcoder's note (#13776): taken, or refused with why (an older worker refuses it)
    if l[0].steer_status == "rejected" {
      s[0].turns[i].agents[j].note = CP_NOTE_REFUSED;
      s[0].turns[i].agents[j].note_why_n = cp_out(s[0].turns[i].agents[j].note_why[..], ifx l[0].reason.count > 0 then l[0].reason else "refused");
      cp_round_check(s, i);
    } else if s[0].turns[i].agents[j].note == CP_NOTE_SENT { s[0].turns[i].agents[j].note = 0; }
  } else if kind == MWW_THOUGHT { cp_thought_add(s, i, j, l[0].text, false);
  } else if kind == MWW_REPLY { cp_said_add(s, i, j, l[0].text);   // said between tool calls; the reply comes in ended
  } else if kind == MWW_ENDED {
    done := l[0].ending == "finished" || l[0].ending == "asked";
    sn := 0;
    if done { sn = cp_said_drop_reply(s, i, j, l[0].text.count == 0); }
    // the reply it streamed stands as written: it is its reply already
    if sn > 0 { cp_agent_finish(s, i, j, ifx done then CP_DONE else CP_FAILED); }
    else { cp_agent_end(s, i, j, ifx done then CP_DONE else CP_FAILED, cp_ended_why(l[0].ending, l[0].text, true)); }
  }
  return kind;
}
cp_ended_why :: (ending: string, text: string, sub: bool) -> string {
  if text.count > 0 { return text; }
  if ending == "bad_replies" { return ifx sub then "The sub-agent stopped after three unreadable model replies." else "The run stopped after three unreadable model replies."; }
  if ending == "idle" { return ifx sub then "The sub-agent stopped after three empty steps." else "The run stopped after three empty steps."; }
  if ending == "no_capacity" { return ifx sub then "The sub-agent could not reach a model." else "The run could not reach a model."; }
  if ending == "limit" { return ifx sub then "The sub-agent reached its step limit." else "The run reached its step limit."; }
  return ifx sub then "The sub-agent ended before a reply." else "The run ended before a reply.";
}
// Sub-agent j's worker could not start or went away.
coder_page_agent_failed :: (s: [] CoderPage, j: int, why: string) #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return; }
  i := s[0].nturns - 1;
  if j < 0 || j >= s[0].turns[i].nagents || s[0].turns[i].agents[j].state != CP_RUNNING { return; }
  cp_agent_end(s, i, j, CP_FAILED, why);
}
// Whether sub-agent j is still running (the host stops the worker of one that is not).
coder_page_agent_running :: (s: [] CoderPage, j: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return false; }
  i := s[0].nturns - 1;
  return j >= 0 && j < s[0].turns[i].nagents && s[0].turns[i].agents[j].state == CP_RUNNING;
}
// The yes sub-agent j's worker is owed for the command it asked about, once.
coder_page_agent_answer_line :: (s: [] CoderPage, j: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return 0; }
  i := s[0].nturns - 1;
  if j < 0 || j >= s[0].turns[i].nagents { return 0; }
  // Microcoder's note for it goes first, as a parent's steer (#13776); an answer owed follows it
  at := 0;
  if s[0].turns[i].agents[j].note == CP_NOTE_DUE {
    s[0].turns[i].agents[j].note = CP_NOTE_SENT;
    ib: [48] u8; k := cp_out(ib[..], "note-"); k = el_put_i(ib[..], k, j + 1); k += cp_out(ib[k..<ib.count], "-"); k = el_put_i(ib[..], k, s[0].turns[i].agents[j].notes);
    w := mww_note(out, cast(string) ib[0..<k], cast(string) s[0].turns[i].agents[j].say[0..<s[0].turns[i].agents[j].say_n]);
    if w > 0 { at = w; }
  }
  rest := out[at..<out.count];
  if s[0].turns[i].agents[j].deny_due {
    // the command that waited through the pause is not run: its answer carries Microcoder's note
    s[0].turns[i].agents[j].deny_due = false;
    wb: [CP_AGENT_TASK + 256] u8; wn := cp_out(wb[..], "This command was not run. You were paused after 100 tool calls in a row with no file changed, and Microcoder let you go on. Its note: ");
    wn += cp_out(wb[wn..<wb.count], cast(string) s[0].turns[i].agents[j].say[0..<s[0].turns[i].agents[j].say_n]);
    w := mww_answer(rest, false, s[0].turns[i].agents[j].answer, cast(string) wb[0..<wn]);
    return ifx w > 0 then at + w else at;
  }
  pw := cp_permit_agent_answer_line(s, j, rest);
  if pw > 0 { return at + pw; }
  if !s[0].turns[i].agents[j].answer_due { return at; }
  s[0].turns[i].agents[j].answer_due = false;
  w := mww_answer(rest, true, s[0].turns[i].agents[j].answer, "");
  return ifx w > 0 then at + w else at;
}
// What Microcoder is told of a paused sub-agent: that it paused and why, its number, its newest 12
// rows, and how to let it go on. The text is in the page's arena until the next worker line.
cp_paused :: (s: [] CoderPage, i: int, j: int) -> string {
  b := s[0].arena[..]; n := cp_out(b, "paused, not finished. Sub-agent number ");
  n = el_put_i(b, n, j + 1); n += cp_out(b[n..<b.count], " has made "); n = el_put_i(b, n, CP_QUIET);
  n += cp_out(b[n..<b.count], " tool calls in a row without changing a file ("); n = el_put_i(b, n, s[0].turns[i].agents[j].calls);
  n += cp_out(b[n..<b.count], " in all). Its newest rows, oldest first:");
  skip := ifx s[0].turns[i].agents[j].nrows > 12 then s[0].turns[i].agents[j].nrows - 12 else 0;
  q := cp_nth(s, i, j, skip);
  while q >= 0 {
    n += cp_out(b[n..<b.count], ifx s[0].calls[q].thought then "\n- thought: " else ifx s[0].calls[q].said then "\n- said: " else ifx s[0].calls[q].read then "\n- read " else "\n- ");
    n += cp_out(b[n..<b.count], cast(string) s[0].calls[q].text[0..<(ifx s[0].calls[q].text_n < 160 then s[0].calls[q].text_n else 160)]);
    q = s[0].calls[q].next - 1;
  }
  n += cp_out(b[n..<b.count], "\nDecide now whether this serves the task. To let it go on, delegate one task with resume ");
  n = el_put_i(b, n, j + 1); n += cp_out(b[n..<b.count], ", level "); n += cp_out(b[n..<b.count], CP_LEVEL[s[0].turns[i].agents[j].level]);
  n += cp_out(b[n..<b.count], ", and as its task a note that tells it what to do next. To stop it, do not resume it.");
  return cast(string) b[0..<n];
}
// What Microcoder is told of a sibling sub-agent still running in the background on an early wakeup.
cp_running_bg :: (s: [] CoderPage, i: int, j: int) -> string {
  b := s[0].arena[..]; n := cp_out(b, "still running in the background (sub-agent #");
  n = el_put_i(b, n, j + 1);
  n += cp_out(b[n..<b.count], "). It was left running; you can continue without waiting for it. To wait for it, delegate one task with resume ");
  n = el_put_i(b, n, j + 1); n += cp_out(b[n..<b.count], ", level "); n += cp_out(b[n..<b.count], CP_LEVEL[s[0].turns[i].agents[j].level]);
  if s[0].turns[i].agents[j].level < CP_LEVEL_CLAUDE { n += cp_out(b[n..<b.count], ", and as its task a note it is sent, or nothing"); }
  n += cp_out(b[n..<b.count], ". To stop it, delegate resume "); n = el_put_i(b, n, j + 1); n += cp_out(b[n..<b.count], " with stop true. It is stopped when you finish.");
  return cast(string) b[0..<n];
}
// The round's results as the worker's line: each sub-agent's reply, whole, or why it has none. Only
// when the replies together pass the worker's line (CP_SCRATCH, 1 MB) does each get an equal share,
// with a line saying how much was left out and that resuming the sub-agent gets the rest.
cp_results :: (s: [] CoderPage, i: int, out: [] u8) -> int {
  b := s[0].scratch[..]; n := cp_results_list(s, i, b, -1);
  if n < 0 {
    k := ifx s[0].turns[i].round_asked > 0 then s[0].turns[i].round_asked else 1;
    n = cp_results_list(s, i, b, (b.count - 65536) / (2 * k));
  }
  if n < 0 { return 0; }
  return mww_results(out, s[0].turns[i].ticket, cast(string) b[0..<n]);
}
// A reply cut to most bytes (on a character), with the line that says so; whole when most < 0 or it fits.
cp_results_reply :: (s: [] CoderPage, i: int, j: int, b: [] u8, n: int, most: int) -> int {
  text := cp_agent_reply(s, i, j);
  if most < 0 || text.count <= most { return json_write_string(b, n, text); }
  k := most; while k > 0 && (text[k] & 0xC0) == 0x80 { k -= 1; }
  nb: [256] u8; m := cp_out(nb[..], "\n[The rest of this reply, "); m = el_put_i(nb[..], m, text.count - k);
  m += cp_out(nb[m..<nb.count], " bytes, did not fit: one step's results reach Microcoder in one 1 MB line. Resume sub-agent ");
  m = el_put_i(nb[..], m, j + 1); m += cp_out(nb[m..<nb.count], " and ask it for the part you need.]");
  w := json_write_string(b, n, cast(string) text[0..<k]);
  if w < 0 { return -1; }
  // the note goes on the same string: written over the closing quote, its own opening quote dropped
  e := json_write_string(b, w - 1, cast(string) nb[0..<m]);
  if e < 0 { return -1; }
  for q: w - 1..<e - 1 { b[q] = b[q + 1]; }
  return e - 1;
}
cp_results_list :: (s: [] CoderPage, i: int, b: [] u8, most: int) -> int {
  n := json_raw(b, 0, "[");
  for q: 0..<s[0].turns[i].round_asked {
    n = json_raw(b, n, ifx q > 0 then ",{\"exit\":" else "{\"exit\":");
    w := s[0].turns[i].round_who[q];
    if w > 0 && s[0].turns[i].agents[w - 1].state == CP_RUNNING && s[0].turns[i].agents[w - 1].paused {
      n = json_raw(b, n, "1,\"output\":"); n = json_write_string(b, n, cp_paused(s, i, w - 1));
    } else if w > 0 && s[0].turns[i].agents[w - 1].state == CP_RUNNING && s[0].turns[i].agents[w - 1].note == CP_NOTE_REFUSED {
      // its note did not reach it (#13776): Microcoder is told why, once, and that it still runs
      a := s[0].turns[i].agents[w - 1..<w]; a[0].note = 0;
      nb: [640] u8; k := cp_out(nb[..], "Your note did not reach it: "); k += cp_out(nb[k..<nb.count], cast(string) a[0].note_why[0..<a[0].note_why_n]);
      k += cp_out(nb[k..<nb.count], ". It is "); k += cp_out(nb[k..<nb.count], cp_running_bg(s, i, w - 1));
      n = json_raw(b, n, "1,\"output\":"); n = json_write_string(b, n, cast(string) nb[0..<k]);
    } else if w > 0 && s[0].turns[i].agents[w - 1].state == CP_RUNNING {
      n = json_raw(b, n, "1,\"output\":"); n = json_write_string(b, n, cp_running_bg(s, i, w - 1));
    } else if w > 0 {
      j := w - 1;
      n = json_raw(b, n, ifx s[0].turns[i].agents[j].state == CP_DONE then "0" else "1"); n = json_raw(b, n, ",\"output\":");
      n = cp_results_reply(s, i, j, b, n, most);
    } else if w < 0 { n = json_raw(b, n, "1,\"output\":\"not run: no sub-agent has that number\""); }
    else { n = json_raw(b, n, "1,\"output\":\"not run: one message starts at most 12 sub-agents\""); }
    n = json_raw(b, n, "}");
  }
  return json_raw(b, n, "]");
}

// Stop one running sub-agent without stopping the parent turn or sibling sub-agents (#13766).
coder_page_agent_cancel :: (s: [] CoderPage, agent: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !cp_running(s) { return false; }
  i := s[0].nturns - 1;
  if agent < 0 || agent >= s[0].turns[i].nagents { return false; }
  if s[0].turns[i].agents[agent].state != CP_RUNNING { return false; }
  cp_agent_end(s, i, agent, CP_STOPPED, "Stopped by user.");
  return true;
}
// Microcoder stopped sub-agent number n, from 1 (a stop_agent line, #13766): it alone ends; the host
// stops its worker as it does any ended sub-agent's, and its siblings and the turn go on.
cp_agent_stopped_by_run :: (s: [] CoderPage, i: int, n: int) {
  j := n - 1;
  if j < 0 || j >= s[0].turns[i].nagents || s[0].turns[i].agents[j].state != CP_RUNNING { return; }
  cp_agent_end(s, i, j, CP_STOPPED, "Stopped by Microcoder.");
}
// The 0-based sub-agent to cancel for CP_ASK_STOP_AGENT (-1 when none).
coder_page_stop_agent :: (s: [] CoderPage) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  j := s[0].stop_agent; s[0].stop_agent = -1;
  return j;
}
