cp_tr :: (locale: int, key: string) -> string {
  if key == "new_chat" { return "New chat"; }
  if key == "search" { return "Search"; }
  if key == "send" { return "Send"; }
  if key == "stop" { return "Stop"; }
  if key == "back_to_chats" { return "Back to chats"; }
  if key == "search_settings" { return "Search settings"; }
  if key == "general" { return "General"; }
  if key == "models" { return "Models"; }
  if key == "about" { return "About & updates"; }
  return key;
}
cp_set_page_label :: (s: [] CoderPage, page: int) -> string {
  names := CP_SET_NAME;
  if page >= 0 && page < CP_SET_PAGES { return names[page]; }
  return "";
}
