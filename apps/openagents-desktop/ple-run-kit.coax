// ple-run's real PLE runs (GitHub #13812; docs/desktop/steer-ple-from-chat.md). A ple-kit eval
// (ple-kit's eval/run.py: Docker, Harbor, a model proxy, often hours) outlives a chat command's
// 30 s, so `ple-run kit start` starts it in its own session and returns; the chat checks on it with
// `ple-run status`, which shows the run's model when it has one.
//
//   ple-run kit start [--task TASK] [--kit DIR] [--harness DIR] [--env-file FILE] [--name NAME]
//       ple-kit's eval/run.py on one task (data-hall-mep-routing unless --task), the harness
//       --harness, $PLE_HARNESS, or the first of ../ple and ../my-harness beside the kit with a
//       submission.yaml; the kit --kit, $PLE_KIT or ~/work/ple-kit; the env file --env-file, else the
//       kit's local.env when it has one. It runs `uv run python eval/run.py HARNESS --tasks TASK
//       [--env-file FILE] --out RUN/eval` in the kit, its output in RUN/run.log, its pid in
//       RUN/run.pid, what was started in RUN/kit-run.json; RUN is ~/.openagents/ple/runs/NAME
//       (kit-TASK-<ms> unless --name), where the Gym lists it. uv is $PLE_UV, else on PATH, else
//       ~/.local/bin/uv. It spends what the kit spends (the model, the judge): a person asks for it.
//   ple-run status NAME|DIR
//       running, finished (the task's score and status from RUN/eval/results.json) or ended
//       without results; the log's last lines. Once an IFC model is in the run (its artifacts or a
//       trial's output), it is read (metaverse-engine/import/ple-ifc.coax) into
//       RUN/model.ple-scene.json, pictured, and shown inline.
//   ple-run stop NAME|DIR        a TERM to the run (Harbor cancels its trials)
//   ple-run ifc FILE.ifc [--out SCENE] [--task TASK]   any IFC model as a scene, and its picture
// ple-run.coax, the tool, loads what this needs (the IFC reader, the wall clock).

PR_KIT_TASK :: "data-hall-mep-routing";
PR_IFC_BYTES :: 268435456;      // an IFC model read at most (256 MiB)
PR_IFC_ENTS :: 2097152;         // its entities indexed at most
PR_KIT_DEPTH :: 12;             // folders deep an IFC is looked for in a run

// What results.json says of one task.
PrKitResult :: struct { found: bool; measured: bool; score: f32; status: [96] u8; status_n: int; }

// The task's line of a ple-kit results.json (its "tasks": [{id, score, measured, status}]).
pr_kit_result :: (text: string, task: string) -> PrKitResult {
  r: PrKitResult;
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) { return r; }
  tasks := jv_get(d[0], 0, "tasks");
  for k: 0..<jv_len(d[0], tasks) {
    t := jv_at(d[0], tasks, k);
    ib: [128] u8; n := jv_str(d[0], jv_get(d[0], t, "id"), ib[..]);
    if n < 0 || cast(string) ib[0..<n] != task { continue; }
    r.found = true;
    r.measured = jv_bool(d[0], jv_get(d[0], t, "measured"));
    sc: [1] f32; if ple_jv_f32(d[0], jv_get(d[0], t, "score"), sc[..]) { r.score = sc[0]; }
    m := jv_str(d[0], jv_get(d[0], t, "status"), r.status[..]);
    r.status_n = ifx m > 0 then m else 0;
    return r;
  }
  return r;
}
// What a run is: running while its pid lives; finished once results.json names its task; else ended.
pr_kit_state :: (alive: bool, r: PrKitResult) -> string {
  if alive { return "running"; }
  if r.found { return ifx r.measured then "finished" else "finished, not measured"; }
  return "ended without results";
}
// The last lines of a log's tail (at most lines of them).
pr_kit_tail :: (text: string, lines: int) -> string {
  e := text.count;
  while e > 0 && (text[e - 1] == 10 || text[e - 1] == 13 || text[e - 1] == ' ') { e -= 1; }
  b := e; seen := 0;
  while b > 0 {
    if text[b - 1] == 10 { seen += 1; if seen >= lines { break; } }
    b -= 1;
  }
  return cast(string) text[b..<e];
}
// A run's name or folder to its folder: a name (no '/') is under runs.
pr_kit_dir :: (arg: string, runs: string, out: [] u8) -> string {
  if arg.count == 0 { return ""; }
  for c: arg { if c == '/' { return arg; } }
  return pr_join(runs, arg, out);
}
pr_kit_ifc_name :: (name: string) -> bool {
  return name.count > 4 && (cast(string) name[name.count - 4..<name.count] == ".ifc" || cast(string) name[name.count - 4..<name.count] == ".IFC");
}

// ---- effects

pr_runs :: (out: [] u8) -> string {
  hb: [1024] u8; home := proc_getenv("HOME", hb[..]);
  return pr_join(home, ".openagents/ple/runs", out);
}
pr_alive :: (pid: int) -> bool {
  if pid <= 1 { return false; }
  pb: [32] u8; p := cast(string) pb[0..<pr_int(pb[..], 0, pid)];
  argv := [3] string.["/bin/kill", "-0", p];
  ob: [256] u8; eb: [256] u8;
  r := proc_run(argv[..], 5000, ob[..], eb[..]);
  return r.started == 0 && r.status == 0;
}
// The first existing file of a few places, or "".
pr_first :: (a: string, b: string, c: string) -> string {
  if a.count > 0 && fs_kind(a) == FS_FILE { return a; }
  if b.count > 0 && fs_kind(b) == FS_FILE { return b; }
  if c.count > 0 && fs_kind(c) == FS_FILE { return c; }
  return "";
}
// The newest .ifc under dir (depth folders deep), into best (its mtime in when[0]).
pr_find_ifc :: (dir: string, depth: int, best: [] u8, best_n: [] int, when: [] int) {
  if depth > PR_KIT_DEPTH { return; }
  l: [1] FsList;
  if fs_list(dir, l[..]) < 0 { return; }
  for i: 0..<l[0].n {
    name := fs_entry(l[..], i);
    if name.count == 0 || name[0] == '.' { continue; }
    pb: [4096] u8; p := pr_join(dir, name, pb[..]);
    k := fs_kind(p);
    if k == FS_DIR { pr_find_ifc(p, depth + 1, best, best_n, when); continue; }
    if k != FS_FILE || !pr_kit_ifc_name(name) || p.count > best.count { continue; }
    t := fs_mtime_ns(p);
    if t > when[0] { when[0] = t; for j: 0..<p.count { best[j] = p[j]; } best_n[0] = p.count; }
  }
}
// An IFC file as a scene: read, indexed and converted. "" when it went, else what went wrong.
pr_ifc_scene :: (path: string, task: string, sc: [] PleScene, st: [] PleIfcStats) -> string {
  size := fs_size(path);
  if size <= 0 { return "could not read the IFC file"; }
  if size > PR_IFC_BYTES { return "the IFC file is over 256 MiB"; }
  buf: [PR_IFC_BYTES] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { return "could not read the IFC file"; }
  ents: [PR_IFC_ENTS] PleIfcEnt; table: [PR_IFC_ENTS * 2] int; f: [1] PleIfc;
  if !ple_ifc_index(cast(string) buf[0..<n], ents[..], table[..], f[..]) { return "not an IFC (STEP) file"; }
  if !ple_ifc_scene(f[..], task, sc, st) { return "could not make a scene"; }
  if sc[0].element_count == 0 { return "no product in it has a shape this reader knows"; }
  return "";
}
// The conversion's one line: kept, boxed, without a shape.
pr_ifc_said :: (st: PleIfcStats, out: [] u8) -> string {
  n := pr_int(out, 0, st.kept); n = pr_cat(out, n, " of "); n = pr_int(out, n, st.products); n = pr_cat(out, n, " products as elements");
  if st.boxed > 0 { n = pr_cat(out, n, " ("); n = pr_int(out, n, st.boxed); n = pr_cat(out, n, " as the box around them)"); }
  if st.no_shape > 0 { n = pr_cat(out, n, ", "); n = pr_int(out, n, st.no_shape); n = pr_cat(out, n, " without a shape it reads"); }
  if st.kept + st.no_shape < st.products { n = pr_cat(out, n, ", the rest past the scene's 512"); }
  return cast(string) out[0..<n];
}
// Writes the scene and its picture beside it, and prints the lines that show it.
pr_ifc_out :: (sc: [] PleScene, scene_path: string, caption: string) -> bool {
  out: [PR_OUT_BYTES] u8;
  if !pr_write_scene(scene_path, sc, out[..]) { tool_errln("ple-run: could not write the scene."); return false; }
  stem := scene_path;
  if stem.count > 15 && cast(string) stem[stem.count - 15..<stem.count] == ".ple-scene.json" { stem = stem[0..<stem.count - 15]; }
  jb: [4096] u8; k := pr_cat(jb[..], 0, stem); k = pr_cat(jb[..], k, ".iso.jpg");
  picture := cast(string) jb[0..<k];
  if !pr_picture(sc, PleCameraPreset.iso, "", picture) { tool_errln("ple-run: could not write the picture."); return false; }
  pr_show(picture, caption, scene_path, false);
  return true;
}

pr_ifc_cmd :: (a: [] Args) -> int {
  path := args_at(a, 1);
  if path.count == 0 || path[0] == '-' { tool_errln("ple-run ifc FILE.ifc [--out SCENE] [--task TASK]"); return 2; }
  sc: [1] PleScene; st: [1] PleIfcStats;
  task := args_value(a, "--task", "ifc");
  why := pr_ifc_scene(path, task, sc[..], st[..]);
  if why.count > 0 { tool_err("ple-run: "); tool_errln(why); return 1; }
  ob: [4096] u8; scene_path := args_value(a, "--out", "");
  if scene_path.count == 0 {
    stem := path;
    if pr_kit_ifc_name(stem) { stem = stem[0..<stem.count - 4]; }
    k := pr_cat(ob[..], 0, stem); k = pr_cat(ob[..], k, ".ple-scene.json"); scene_path = cast(string) ob[0..<k];
  }
  sb: [256] u8; said := pr_ifc_said(st[0], sb[..]);
  print("Read % into %: %\n", path, scene_path, said);
  return ifx pr_ifc_out(sc[..], scene_path, said) then 0 else 1;
}

// The harness to run: --harness, $PLE_HARNESS, else ../ple or ../my-harness beside the kit with a submission.yaml.
pr_kit_harness :: (a: [] Args, kit: string, out: [] u8) -> string {
  h := args_value(a, "--harness", "");
  if h.count > 0 { return h; }
  eb: [4096] u8; e := proc_getenv("PLE_HARNESS", eb[..]);
  if e.count > 0 { for j: 0..<e.count { out[j] = e[j]; } return cast(string) out[0..<e.count]; }
  up := fs_dir(kit);
  names := [2] string.["ple", "my-harness"];
  for name: names {
    pb: [4096] u8; p := pr_join(up, name, out);
    if fs_kind(pr_join(p, "submission.yaml", pb[..])) == FS_FILE { return p; }
  }
  return "";
}
pr_kit_start :: (a: [] Args) -> int {
  hb: [1024] u8; home := proc_getenv("HOME", hb[..]);
  kb: [4096] u8; kit := args_value(a, "--kit", "");
  if kit.count == 0 { kit = proc_getenv("PLE_KIT", kb[..]); }
  if kit.count == 0 { kit = pr_join(home, "work/ple-kit", kb[..]); }
  eb: [4096] u8;
  if fs_kind(pr_join(kit, "eval/run.py", eb[..])) != FS_FILE { tool_err("ple-run: no ple-kit at "); tool_errln(kit); tool_errln("Pass --kit DIR (a clone of ple-kit) or set PLE_KIT."); return 2; }
  harb: [4096] u8; harness := pr_kit_harness(a, kit, harb[..]);
  if harness.count == 0 || fs_kind(harness) != FS_DIR { tool_errln("ple-run: no harness. Pass --harness DIR (your entry: a folder with submission.yaml) or set PLE_HARNESS."); return 2; }
  task := args_value(a, "--task", PR_KIT_TASK);
  envb: [4096] u8; env := args_value(a, "--env-file", "");
  if env.count == 0 { env = pr_join(kit, "local.env", envb[..]); if fs_kind(env) != FS_FILE { env = ""; } }
  ub: [4096] u8; uv := proc_getenv("PLE_UV", ub[..]);
  if uv.count == 0 { lb: [4096] u8; local := pr_join(home, ".local/bin/uv", lb[..]); uv = ifx fs_kind(local) == FS_FILE then local else "uv"; for j: 0..<uv.count { ub[j] = uv[j]; } uv = cast(string) ub[0..<uv.count]; }
  nb: [256] u8; name := args_value(a, "--name", "");
  if name.count == 0 { k := pr_cat(nb[..], 0, "kit-"); k = pr_cat(nb[..], k, task); k = pr_cat(nb[..], k, "-"); k = pr_int(nb[..], k, cxproc_wall_us() / 1000); name = cast(string) nb[0..<k]; }
  rb: [4096] u8; db: [4096] u8; dir := pr_join(pr_runs(rb[..]), name, db[..]);
  if fs_kind(dir) != FS_NONE { tool_err("ple-run: a run is already at "); tool_errln(dir); return 2; }
  if !fs_mkdir_all(dir) { tool_errln("ple-run: could not make the run's folder."); return 2; }
  lb2: [4096] u8; logp := pr_join(dir, "run.log", lb2[..]);
  ob: [4096] u8; outp := pr_join(dir, "eval", ob[..]);
  // sh runs it with its output in the log; the arguments go as "$@", never through the shell's words
  h := proc_new();
  if h < 0 { tool_errln("ple-run: no process slot."); return 1; }
  shell := "exec \"$@\" >> \"$PLE_RUN_LOG\" 2>&1 < /dev/null";
  ok := proc_arg(h, "/bin/sh") && proc_arg(h, "-c") && proc_arg(h, shell) && proc_arg(h, "sh");
  ok = ok && proc_arg(h, uv) && proc_arg(h, "run") && proc_arg(h, "python") && proc_arg(h, "eval/run.py") && proc_arg(h, harness) && proc_arg(h, "--tasks") && proc_arg(h, task);
  if env.count > 0 { ok = ok && proc_arg(h, "--env-file") && proc_arg(h, env); }
  ok = ok && proc_arg(h, "--out") && proc_arg(h, outp);
  ek: [4200] u8; ekn := pr_cat(ek[..], 0, "PLE_RUN_LOG="); ekn = pr_cat(ek[..], ekn, logp);
  ok = ok && proc_env(h, cast(string) ek[0..<ekn]) && proc_cwd(h, kit) && proc_detach(h) && proc_quiet(h);
  if !ok { _done := proc_release(h); tool_errln("ple-run: the command is too long."); return 1; }
  pr_log(logp, "ple-run kit start: ", true); pr_log(logp, task, false); pr_log(logp, "\n", false);
  if proc_start(h) != 0 { _gone := proc_release(h); tool_errln("ple-run: could not start /bin/sh."); return 1; }
  pid := proc_pid(h);
  _left := proc_release(h);
  pidb: [32] u8; pb: [4096] u8; _w := fs_write(pr_join(dir, "run.pid", pb[..]), cast(string) pidb[0..<pr_int(pidb[..], 0, pid)]);
  // what was started, for status
  jb: [16384] u8; o: [1] Jo; jo_start(o[..], jb[..]);
  jo_obj(o[..]);
  jo_key(o[..], "version"); jo_str(o[..], "ple-kit-run.v1");
  jo_key(o[..], "task"); jo_str(o[..], task);
  jo_key(o[..], "kit"); jo_str(o[..], kit);
  jo_key(o[..], "harness"); jo_str(o[..], harness);
  jo_key(o[..], "env_file"); jo_str(o[..], env);
  jo_key(o[..], "out"); jo_str(o[..], outp);
  jo_key(o[..], "log"); jo_str(o[..], logp);
  jo_key(o[..], "pid"); jo_int(o[..], pid);
  jo_key(o[..], "started_ms"); jo_int(o[..], cxproc_wall_us() / 1000);
  jo_end(o[..]);
  jp: [4096] u8; _j := fs_write(pr_join(dir, "kit-run.json", jp[..]), jo_text(o[..]));
  print("Started the ple-kit eval of % (pid %). It runs on its own: it can take hours, and it spends what the kit spends.\n", task, pid);
  print("Run: % (log: %)\n", name, logp);
  print("Check on it: ple-run status %   Stop it: ple-run stop %\n", name, name);
  return 0;
}
// A run's kit-run.json into its fields: the task and pid.
pr_kit_read :: (dir: string, task: [] u8, task_n: [] int, pid: [] int) -> bool {
  jb: [16384] u8; pb: [4096] u8;
  n := fs_read(pr_join(dir, "kit-run.json", pb[..]), jb[..]);
  if n <= 0 { return false; }
  nodes: [256] JvNode; d: [1] Jv;
  if !jv_parse(d[..], cast(string) jb[0..<n], nodes[..]) { return false; }
  task_n[0] = jv_str(d[0], jv_get(d[0], 0, "task"), task);
  pid[0] = jv_int(d[0], jv_get(d[0], 0, "pid"), 0);
  return task_n[0] > 0;
}
pr_kit_status :: (a: [] Args) -> int {
  rb: [4096] u8; db: [4096] u8; dir := pr_kit_dir(args_at(a, 1), pr_runs(rb[..]), db[..]);
  if dir.count == 0 { tool_errln("ple-run status NAME|DIR   (a run ple-run kit start made)"); return 2; }
  tb: [128] u8; tn: [1] int; pid: [1] int;
  if !pr_kit_read(dir, tb[..], tn[..], pid[..]) { tool_err("ple-run: no kit run at "); tool_errln(dir); return 2; }
  task := cast(string) tb[0..<tn[0]];
  alive := pr_alive(pid[0]);
  res: PrKitResult;
  resb: [1048576] u8; pb: [4096] u8;
  rn := fs_read(pr_join(dir, "eval/results.json", pb[..]), resb[..]);
  if rn > 0 { res = pr_kit_result(cast(string) resb[0..<rn], task); }
  state := pr_kit_state(alive, res);
  print("ple-kit run of %: %", task, state);
  if res.found { print(" (score %, %)", res.score, cast(string) res.status[0..<res.status_n]); }
  print("\n");
  // the log's end
  lb: [4096] u8; logp := pr_join(dir, "run.log", lb[..]);
  size := fs_size(logp);
  if size > 0 {
    tail: [4096] u8; from := ifx size > tail.count then size - tail.count else 0;
    k := fs_read_at(logp, from, tail[..]);
    if k > 0 { print("Log (%):\n%\n", logp, pr_kit_tail(cast(string) tail[0..<k], 8)); }
  }
  // its model, once there is one
  best: [4096] u8; best_n := [1] int.[0]; when := [1] int.[-1];
  ob: [4096] u8; pr_find_ifc(pr_join(dir, "eval", ob[..]), 0, best[..], best_n[..], when[..]);
  if best_n[0] == 0 { if !alive { print("No IFC model in the run.\n"); } return 0; }
  ifc := cast(string) best[0..<best_n[0]];
  sb: [4096] u8; scene_path := pr_join(dir, "model.ple-scene.json", sb[..]);
  if fs_kind(scene_path) == FS_FILE && fs_mtime_ns(scene_path) >= when[0] {
    jb: [4096] u8; k := pr_cat(jb[..], 0, scene_path); k = pr_cat(jb[..], k - 15, ".iso.jpg");
    pr_show(cast(string) jb[0..<k], "The run's model", scene_path, true);
    return 0;
  }
  sc: [1] PleScene; st: [1] PleIfcStats;
  why := pr_ifc_scene(ifc, task, sc[..], st[..]);
  if why.count > 0 { print("Its model % could not be shown: %\n", ifc, why); return 1; }
  if res.found { sc[0].run.score = res.score; }
  cb: [256] u8; said := pr_ifc_said(st[0], cb[..]);
  print("Its model: % (%)\n", ifc, said);
  capb: [256] u8; c := pr_cat(capb[..], 0, task); c = pr_cat(capb[..], c, ": the run's model");
  if res.found { c = pr_cat(capb[..], c, ", score "); c = pr_num(capb[..], c, res.score, 2); }
  return ifx pr_ifc_out(sc[..], scene_path, cast(string) capb[0..<c]) then 0 else 1;
}
pr_kit_stop :: (a: [] Args) -> int {
  rb: [4096] u8; db: [4096] u8; dir := pr_kit_dir(args_at(a, 1), pr_runs(rb[..]), db[..]);
  tb: [128] u8; tn: [1] int; pid: [1] int;
  if dir.count == 0 || !pr_kit_read(dir, tb[..], tn[..], pid[..]) { tool_errln("ple-run stop NAME|DIR   (a run ple-run kit start made)"); return 2; }
  if !pr_alive(pid[0]) { print("The run has already ended.\n"); return 0; }
  pb: [32] u8; p := cast(string) pb[0..<pr_int(pb[..], 0, pid[0])];
  argv := [3] string.["/bin/kill", "-TERM", p];
  ob: [256] u8; eb: [256] u8;
  r := proc_run(argv[..], 5000, ob[..], eb[..]);
  if r.status != 0 { tool_errln("ple-run: could not stop it."); return 1; }
  print("Asked the run to stop (TERM to pid %); Harbor cancels its trials, which can take two minutes.\n", pid[0]);
  return 0;
}

// ---- checks

PR_KIT_RESULTS :: "{\"submission\":\"my-harness\",\"score\":0.5,\"tasks\":[{\"id\":\"other\",\"score\":0.9,\"measured\":true,\"status\":\"ok\"},{\"id\":\"data-hall-mep-routing\",\"score\":0.62,\"measured\":true,\"status\":\"graded\"}]}";

#test "ple-run kit: a task's result, the run's state, the log's end, a run's folder" {
  r := pr_kit_result(PR_KIT_RESULTS, "data-hall-mep-routing");
  #assert r.found && r.measured && near(r.score, 0.62, 0.0001) && cast(string) r.status[0..<r.status_n] == "graded";
  #assert !pr_kit_result(PR_KIT_RESULTS, "nope").found && !pr_kit_result("{", PR_KIT_TASK).found && !pr_kit_result("{\"tasks\":3}", PR_KIT_TASK).found;
  unmeasured := pr_kit_result("{\"tasks\":[{\"id\":\"t\",\"score\":0,\"measured\":false,\"status\":\"evaluator: RuntimeError\"}]}", "t");
  #assert unmeasured.found && !unmeasured.measured && cast(string) unmeasured.status[0..<unmeasured.status_n] == "evaluator: RuntimeError";
  #assert pr_kit_state(true, r) == "running" && pr_kit_state(false, r) == "finished" && pr_kit_state(false, unmeasured) == "finished, not measured" && pr_kit_state(false, PrKitResult.{}) == "ended without results";
  #assert pr_kit_tail("a\nb\nc\nd\n\n", 2) == "c\nd" && pr_kit_tail("one", 3) == "one" && pr_kit_tail("", 3) == "" && pr_kit_tail("a\nb", 1) == "b";
  b: [256] u8;
  #assert pr_kit_dir("kit-x-1", "/h/.openagents/ple/runs", b[..]) == "/h/.openagents/ple/runs/kit-x-1" && pr_kit_dir("/tmp/r", "/h/runs", b[..]) == "/tmp/r" && pr_kit_dir("", "/h", b[..]) == "";
  #assert pr_kit_ifc_name("a/model.ifc") && pr_kit_ifc_name("M.IFC") && !pr_kit_ifc_name(".ifc") && !pr_kit_ifc_name("model.ifcx");
  st := PleIfcStats.{products = 600, kept = 512, no_shape = 3, boxed = 2};
  #assert pr_ifc_said(st, b[..]) == "512 of 600 products as elements (2 as the box around them), 3 without a shape it reads, the rest past the scene's 512";
  #assert pr_ifc_said(PleIfcStats.{products = 4, kept = 4}, b[..]) == "4 of 4 products as elements";
}
