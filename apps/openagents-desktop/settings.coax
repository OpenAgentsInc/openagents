#test "settings: experimental features off hides Foreman and Gym while keeping Account enabled by default" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_experimental_set(s, false);
  #assert !coder_page_experimental(s) && s[0].flags == dc_flags_defaults();
  // the sidebar: no Foreman row, no Gym row; Account stays enabled by default (#14087)
  #assert cp_set_test_frame(s, 1200, 700);
  #assert surface_find(s[0].surface[..], "coder.foreman") < 0 && surface_find(s[0].surface[..], "coder.gym") < 0;
  #assert surface_find(s[0].surface[..], "coder.new") >= 0;
  coder_page_gym_set(s, true);
  #assert !coder_page_gym_open(s);
  #assert cp_settings_press(s, CP_SET_ACCOUNT, "coder.me") && s[0].set_open && s[0].set_page == CP_PG_ACCOUNT;
  // the list: General, Account, Providers, Models and About; Foreman opens General
  #assert cp_set_test_frame(s, 1200, 700);
  #assert surface_find(s[0].surface[..], "set.page.0") >= 0 && surface_find(s[0].surface[..], "set.page.1") >= 0 && surface_find(s[0].surface[..], "set.page.3") >= 0 && surface_find(s[0].surface[..], "set.page.14") >= 0 && surface_find(s[0].surface[..], "set.page.4") >= 0;
  #assert surface_find(s[0].surface[..], "set.page.2") < 0;
  coder_page_settings_open(s, CP_PG_FOREMAN, "");
  #assert coder_page_settings_page(s) == CP_PG_GENERAL;
  coder_page_settings_open(s, CP_PG_ACCOUNT, "");
  #assert coder_page_settings_page(s) == CP_PG_ACCOUNT;
  #assert !cp_settings_press(s, CP_SET_ACT, "set.tier.2") && cp_settings_press(s, CP_SET_ACT, "set.login") && coder_page_action(s) == CP_ASK_LOGIN;
  #assert cp_settings_press(s, CP_SET_ACT, "set.update.a") && coder_page_action(s) == CP_ASK_CHECK_UPDATES;
  // the search: Foreman stays hidden while Account is searchable by default
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  #assert cp_set_hits_in("tier", hits[..], false) == 0 && cp_set_hits_in("tier", hits[..], true) == 1;
  n := cp_set_hits_in("account", hits[..], false);
  #assert n >= 1 && es[hits[0]].page == CP_PG_ACCOUNT;
  #assert cp_set_page_ok(false, CP_PG_GENERAL) && cp_set_page_ok(false, CP_PG_MODELS) && cp_set_page_ok(false, CP_PG_ABOUT) && cp_set_page_ok(false, CP_PG_ACCOUNT);
  #assert !cp_set_page_ok(false, CP_PG_FOREMAN) && !cp_set_page_ok_flags(0, CP_PG_ACCOUNT) && cp_set_page_ok(true, CP_PG_ACCOUNT);
  // General's row: Off shown; On turns them on and asks the host to keep it
  coder_page_settings_open(s, CP_PG_GENERAL, "");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.exp.1").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.exp.0").state & EL_S_CURRENT != 0;
  #assert cp_settings_press(s, CP_SET_ACT, "set.exp.1") && coder_page_action(s) == CP_ASK_EXPERIMENTAL && coder_page_experimental(s);
  coder_page_settings_open(s, CP_PG_FOREMAN, "");
  #assert coder_page_settings_page(s) == CP_PG_FOREMAN;
  // Off again while Foreman is shown and the Gym open: General shows and the Gym closes
  coder_page_gym_set(s, true);
  #assert cp_settings_press(s, CP_SET_ACT, "set.exp.0") && coder_page_action(s) == CP_ASK_EXPERIMENTAL && !coder_page_experimental(s);
  #assert s[0].set_page == CP_PG_GENERAL && !coder_page_gym_open(s);
}

#test "settings: Wallet page is flag-gated, searchable when wallet flag is on, and dispatches wallet asks" {
  state: [1] CoderPage; s := state[..];
  cp_init(s);
  // Release default (flags = 0): Wallet is hidden and unsearchable.
  #assert !cp_set_page_ok(false, CP_PG_WALLET);
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  #assert cp_set_hits_in("wallet", hits[..], false) == 0;
  #assert cp_set_hits_in("bitcoin", hits[..], false) == 0;
  // Enable wallet flag: visible, searchable, and dispatches wallet asks.
  wflag := dc_flag_bit(DC_FLAG_WALLET);
  coder_page_flags_set(s, wflag);
  #assert cp_set_page_ok_flags(wflag, CP_PG_WALLET);
  n := cp_set_hits_flags("wallet", hits[..], wflag);
  #assert n >= 2 && es[hits[0]].page == CP_PG_WALLET;
  n = cp_set_hits_flags("bitcoin", hits[..], wflag);
  #assert n >= 3 && es[hits[0]].page == CP_PG_WALLET;
  coder_page_settings_open(s, CP_PG_WALLET, "");
  #assert coder_page_settings_page(s) == CP_PG_WALLET;
  #assert cp_set_test_frame(s, 1200, 700);
  #assert surface_find(s[0].surface[..], "set.wallet.status") >= 0;
  #assert surface_find(s[0].surface[..], "set.wallet.receive") >= 0;
  #assert surface_find(s[0].surface[..], "set.wallet.send") >= 0;
  #assert surface_find(s[0].surface[..], "set.wallet.limit") >= 0;
  #assert surface_find(s[0].surface[..], "set.wallet.backup") >= 0;
  // Disconnected -> status button asks to connect; ready -> asks to sync/refresh
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.status.a") && coder_page_action(s) == CP_ASK_WALLET_CONNECT;
  coder_page_settings_wallet(s, "Connected (Spark mainnet)", "₿1,000", "spark1abc", "npub1xyz", "₿100,000 / day", "Backed up", "Received ₿1,000", true);
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.status.a") && coder_page_action(s) == CP_ASK_WALLET_REFRESH;
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.receive.a") && coder_page_action(s) == CP_ASK_WALLET_RECEIVE;
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.send.a") && coder_page_action(s) == CP_ASK_WALLET_SEND;
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.limit.a") && coder_page_action(s) == CP_ASK_WALLET_LIMIT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.wallet.backup.a") && coder_page_action(s) == CP_ASK_WALLET_BACKUP;
}

#test "settings: Models picks the model new chats start on, Neon or one of the four Claude models" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_open(s, CP_PG_MODELS, "");
  // Claude Code not here: the row says how to install it, and picks nothing
  #assert cp_set_test_frame(s, 1200, 2400);
  #assert surface_find(s[0].surface[..], "set.orch") >= 0 && surface_find(s[0].surface[..], "set.orch.model") < 0;
  #assert !cp_settings_press(s, CP_SET_ACT, "set.orch.1") && !s[0].orch_claude;
  coder_page_set_claude(s, true);
  #assert cp_set_test_frame(s, 1200, 2400);
  #assert surface_find(s[0].surface[..], "set.orch.model") >= 0;
  #assert cp_settings_press(s, CP_SET_ACT, "set.orch.1") && coder_page_action(s) == CP_ASK_ORCHESTRATOR && coder_page_orchestrator(s) == 1 && cp_model_id(s, cp_model_index(s)) == "claude-opus-5-5";
  #assert cp_settings_press(s, CP_SET_ACT, "set.orch.model.0") && coder_page_action(s) == CP_ASK_ORCHESTRATOR && coder_page_orchestrator_model(s) == 0 && cp_model_id(s, cp_model_index(s)) == "claude-fable-5-2";
  #assert cp_settings_press(s, CP_SET_ACT, "set.orch.model.3") && coder_page_action(s) == CP_ASK_ORCHESTRATOR && cp_model_id(s, cp_model_index(s)) == "claude-haiku-5-5";
  #assert !cp_settings_press(s, CP_SET_ACT, "set.orch.model.4");
  #assert cp_settings_press(s, CP_SET_ACT, "set.orch.0") && coder_page_action(s) == CP_ASK_ORCHESTRATOR && coder_page_orchestrator(s) == 0 && cp_model_id(s, cp_model_index(s)) == "oa:gemini-4-neon";
}

#test "settings: each Claude model has a thinking level, which a chat on it and a sub-agent on it run at" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_open(s, CP_PG_MODELS, "");
  #assert cp_set_test_frame(s, 1200, 2400) && surface_find(s[0].surface[..], "set.claude.effort.0") < 0;   // no Claude Code: no rows
  coder_page_set_claude(s, true);
  #assert cp_set_test_frame(s, 1200, 2400);
  #assert surface_find(s[0].surface[..], "set.claude.effort.0") >= 0 && surface_find(s[0].surface[..], "set.claude.effort.3") >= 0 && surface_find(s[0].surface[..], "set.claude.effort.0.4") >= 0;
  for k: 0..<CP_CLAUDE_MODELS { #assert coder_page_claude_effort(s, k) == CP_CLAUDE_EFFORT_START; }
  #assert cp_settings_press(s, CP_SET_ACT, "set.claude.effort.0.4") && coder_page_action(s) == CP_ASK_CLAUDE_EFFORT && coder_page_claude_effort(s, 0) == 4;
  #assert cp_settings_press(s, CP_SET_ACT, "set.claude.effort.3.0") && coder_page_action(s) == CP_ASK_CLAUDE_EFFORT && coder_page_claude_effort(s, 3) == 0 && coder_page_claude_effort(s, 1) == 2;
  #assert !cp_settings_press(s, CP_SET_ACT, "set.claude.effort.1.5") && !cp_settings_press(s, CP_SET_ACT, "set.claude.effort.4.1");
  coder_page_claude_effort_set(s, 2, 9);
  #assert coder_page_claude_effort(s, 2) == CP_CLAUDE_EFFORT_START;
  // a chat on Fable runs at max, and its chip says so; a pick in the chat wins, through all five levels
  out: [8192] u8; ab: [8192] u8; ar: [1] ClArena; ar[0].buf = ab[..]; back: [1] McTask;
  #assert coder_page_pick_model(s, "fable") && cp_effort_label(s, cp_model_index(s)) == "Max";
  #assert coder_page_set_text(s, "hi") && coder_page_submit(s);
  n := coder_page_task(s, "s", "/w", out[..]);
  #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].model == "claude-fable-5-2" && back[0].effort == "max";
  // its sub-agents run at their own model's level: Haiku low, Opus high, Fable max
  #assert coder_page_line(s, "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"haiku\",\"task\":\"count\"},{\"level\":\"opus\",\"task\":\"review\"},{\"level\":\"fable\",\"task\":\"prove\"},{\"level\":\"sonnet\",\"task\":\"build\"}],\"ticket\":1}") == MWW_DELEGATE;
  want := [4] string.["low", "high", "max", "high"];
  for j: 0..<4 {
    ar[0].at = 0;
    n = coder_page_agent_task(s, j, "s-a", "/w", out[..]);
    #assert mww_task_read(ar[..], cast(string) out[0..<n - 1], back[..]) && back[0].effort == want[j];
  }
  #assert coder_page_line(s, "{\"kind\":\"results\"}") != MWW_ENDED;
  #assert coder_page_line(s, "{\"kind\":\"ended\",\"ending\":\"stopped\",\"text\":\"\"}") == MWW_ENDED;
  cp_effort_cycle(s);
  #assert s[0].effort == CP_EFFORT_LOW && cp_task_effort(s, cp_model_index(s)) == "low";
  for k: 0..<3 { cp_effort_cycle(s); }
  #assert s[0].effort == CP_EFFORT_XHIGH && cp_effort_label(s, cp_model_index(s)) == "X-High" && cp_task_effort(s, cp_model_index(s)) == "xhigh";
  cp_effort_cycle(s); cp_effort_cycle(s);
  #assert s[0].effort == CP_EFFORT_LOW;
  // x-high on a model that has no such level (e.g. Gemini) runs as high, and its chip wraps from high
  gi := cp_model_find_exact(s, "gemini-4-neon");
  #assert gi >= 0;
  s[0].effort = CP_EFFORT_MAX; s[0].model = gi;
  #assert cp_effort_label(s, gi) == "High" && cp_task_effort(s, gi) == "high";
  cp_effort_cycle(s);
  #assert s[0].effort == CP_EFFORT_LOW && cp_effort_of("xhigh") == CP_EFFORT_XHIGH && cp_effort_of("max") == CP_EFFORT_MAX;
}

#test "settings: Flawed page renders all Claude-Code-parity controls, responds to search, and updates prefs" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_flags_set(s, 0);
  coder_page_flawed_info(s, "Local Psionic · Vertex AI (openagentsgemini)", "Not set", "Default endpoint", "", "All built-in tools", "Unlimited turns");
  coder_page_settings_open(s, CP_PG_FLAWED, "");
  #assert coder_page_settings_page(s) == CP_PG_FLAWED;
  #assert cp_set_test_frame(s, 1200, 3200);
  #assert surface_find(s[0].surface[..], "set.flawed.agent") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.model") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.backend") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.tmode") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.pmode") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.bypass") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.sandbox") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.cache") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.style") >= 0;
  #assert surface_find(s[0].surface[..], "set.flawed.reset") >= 0;
  // Switching default compute between Local, Auto, and Cloud updates an empty chat cleanly.
  coder_page_set_inkling(s, true);
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.agent.1") && coder_page_action(s) == CP_ASK_FLAWED_PREFS && coder_page_model_flawed_local(s);
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.agent.0") && coder_page_action(s) == CP_ASK_FLAWED_PREFS && coder_page_model_flawed(s);
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.others.1") && coder_page_action(s) == CP_ASK_SHOW_OTHER_MODELS && coder_page_show_other_models(s);
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.model.1") && coder_page_action(s) == CP_ASK_FLAWED_PREFS && cp_model_id(s, cp_model_index(s)) == "oa:gemini-4-carbon";
  // Dialog actions dispatch cleanly.
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.key.a") && coder_page_action(s) == CP_ASK_FLAWED_KEY;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.url.a") && coder_page_action(s) == CP_ASK_FLAWED_BASE_URL;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.custom.a") && coder_page_action(s) == CP_ASK_FLAWED_CUSTOM_MODEL;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.tools.a") && coder_page_action(s) == CP_ASK_FLAWED_TOOLS;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.limits.a") && coder_page_action(s) == CP_ASK_FLAWED_LIMITS;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.auth.a") && coder_page_action(s) == CP_ASK_FLAWED_AUTH_CHECK;
  #assert cp_settings_press(s, CP_SET_ACT, "set.flawed.reset.a") && coder_page_action(s) == CP_ASK_FLAWED_RESET;
  // Search finds Agent settings even with flags == 0.
  hits: [CP_SET_HITS] int;
  #assert cp_set_hits_flags("agent", hits[..], 0) >= 1;
  #assert cp_set_hits_flags("sandbox", hits[..], 0) >= 1;
}
