// Whether a settings page is visible for the active flag bitmask.
// Core release pages (flags == 0): General, Flawed, Providers, Models (Local), and About & updates.
cp_set_page_ok_flags :: (flags: int, page: int) -> bool {
  if page == CP_PG_GENERAL || page == CP_PG_FLAWED || page == CP_PG_MODELS || page == CP_PG_PROVIDERS || page == CP_PG_ABOUT { return true; }
  if page == CP_PG_FOREMAN { return dc_flag_on(flags, DC_FLAG_FOREMAN); }
  if page == CP_PG_ACCOUNT { return dc_flag_on(flags, DC_FLAG_ACCOUNT); }
  if page == CP_PG_WALLET { return dc_flag_on(flags, DC_FLAG_WALLET); }
  if page == CP_PG_USAGE { return true; }
  if page == CP_PG_MCP || page == CP_PG_SKILLS { return dc_flag_on(flags, DC_FLAG_MCP); }
  if page == CP_PG_VOICE { return true; }
  if page == CP_PG_CONNECTIONS { return dc_flag_on(flags, DC_FLAG_ENVIRONMENTS) || dc_flag_on(flags, DC_FLAG_PAIRING); }
  if page == CP_PG_SCHED { return dc_flag_on(flags, DC_FLAG_SCHEDULED); }
  if page == CP_PG_APPEARANCE || page == CP_PG_KEYBINDINGS { return dc_flag_on(flags, DC_FLAG_CUSTOMIZE); }
  return false;
}
// Whether a specific settings entry (page or row) is visible and searchable for the active flags.
cp_set_entry_ok_flags :: (flags: int, e: CpSetEntry) -> bool {
  if !cp_set_page_ok_flags(flags, e.page) { return false; }
  if e.page == CP_PG_MODELS {
    if e.id == "set.gemini" || e.id == "set.gemini.auth" { return dc_flag_on(flags, DC_FLAG_MODELS_GEMINI); }
    if e.id == "set.orch" || e.id == "set.orch.model" || e.id == "set.claude" || e.id == "set.claude.effort.1" { return dc_flag_on(flags, DC_FLAG_MODELS_CLAUDE); }
    if e.id == "set.or" || e.id == "set.or.main" || e.id == "set.or.sub" { return dc_flag_on(flags, DC_FLAG_MODELS_OPENROUTER); }
    if e.id == "set.agy.status" || e.id == "set.agy.mode" || e.id == "set.agy.model" || e.id == "set.agy.auth" { return dc_flag_on(flags, DC_FLAG_MODELS_ANTIGRAVITY); }
    if e.id == "set.codex" || e.id == "set.cursor" || e.id == "set.acp" { return dc_flag_on(flags, DC_FLAG_MODELS_EXTERNAL); }
    if e.id == "set.exec.hybrid" || e.id == "set.exec.modules" || e.id == "set.pylon.state" || e.id == "set.pylon.contrib" || e.id == "set.pylon.sats" || e.id == "set.pylon.release" { return dc_flag_on(flags, DC_FLAG_MODELS_EXECUTOR); }
  } else if e.page == CP_PG_CONNECTIONS {
    if e.id == "set.env.active" || e.id == "set.env.awake" { return dc_flag_on(flags, DC_FLAG_ENVIRONMENTS); }
    if e.id == "set.env.expose" || e.id == "set.env.pair" { return dc_flag_on(flags, DC_FLAG_PAIRING); }
  } else if e.page == CP_PG_ABOUT {
    if e.id == "set.update.all" { return dc_flag_on(flags, DC_FLAG_SCHEDULED); }
  }
  return true;
}
cp_set_page_ok :: (experimental: bool, page: int) -> bool { return cp_set_page_ok_flags(ifx experimental then DC_FLAGS_ALL else dc_flags_defaults(), page); }
cp_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
// Where needle starts in text, by letters (any case); -1 when it doesn't.
cp_find_ci :: (text: string, needle: string) -> int {
  if needle.count == 0 || needle.count > text.count { return -1; }
  for i: 0..<text.count - needle.count + 1 {
    if cp_starts_ci(text, i, needle) { return i; }
  }
  return -1;
}
// Whether text has needle at `at`, by letters (any case).
cp_starts_ci :: (text: string, at: int, needle: string) -> bool {
  if at < 0 || at + needle.count > text.count { return false; }
  for j: 0..<needle.count { if cp_lower(text[at + j]) != cp_lower(needle[j]) { return false; } }
  return true;
}
// How well an entry answers a search (Zeron's ranking: the name's start, then a word's start in
// it, then anywhere in it or its words); 0 not at all.
cp_set_score :: (e: CpSetEntry, q: string) -> int {
  if cp_starts_ci(e.name, 0, q) { return 3; }
  for i: 1..<e.name.count { if e.name[i - 1] == ' ' && cp_starts_ci(e.name, i, q) { return 2; } }
  if cp_find_ci(e.name, q) >= 0 || cp_find_ci(e.terms, q) >= 0 { return 1; }
  return 0;
}
// The search's results, best first, into out (entry indexes), every page's. Returns how many.
cp_set_hits :: (q: string, out: [] int) -> int { return cp_set_hits_flags(q, out, DC_FLAGS_ALL); }
// The same, filtered to entries whose feature flag is on.
cp_set_hits_flags :: (q: string, out: [] int, flags: int) -> int {
  if q.count == 0 { return 0; }
  es := cp_set_entries(); n := 0;
  for want: 0..<3 {
    score := 3 - want;
    for e, i: es { if n < out.count && cp_set_entry_ok_flags(flags, e) && cp_set_score(e, q) == score { out[n] = i; n += 1; } }
  }
  return n;
}
cp_set_hits_in :: (q: string, out: [] int, experimental: bool) -> int {
  return cp_set_hits_flags(q, out, ifx experimental then DC_FLAGS_ALL else dc_flags_defaults());
}
cp_set_query :: (s: [] CoderPage) -> string { return cast(string) s[0].set_query[0..<s[0].set_query_n]; }

// Opens settings on a page (-1: the one shown last), or closes it (`open` false). The chat that
// was shown stays as it was. The keyboard leaves the composer while it is open (Command-F or a
// press gives it to the search) and comes back to it after; the host is asked to move it.
cp_settings_show :: (s: [] CoderPage, open: bool, page: int) {
  if open && page >= 0 && page < CP_SET_PAGES { if page != s[0].set_page { cp_ps_blur_ed(s); s[0].set_scroll = 0; s[0].ps[0].detail_scroll = 0; } s[0].set_page = page; }
  if open && !cp_set_page_ok_flags(s[0].flags, s[0].set_page) { s[0].set_page = CP_PG_GENERAL; s[0].set_scroll = 0; }
  if open == s[0].set_open { return; }
  s[0].set_open = open; s[0].model_menu = false; s[0].effort_menu = false; s[0].usage[0].popover_open = false;
  if !open { cp_ps_close_popups(s); s[0].set_query_n = 0; s[0].set_target_n = 0; }
  s[0].fld[0].kb = ifx open then CP_KB_NONE else CP_KB_COMPOSER;
  s[0].ask = CP_ASK_SETTINGS;
}
cp_settings_press :: (s: [] CoderPage, act: int, id: string) -> bool {
  if act == CP_SET_TOGGLE { cp_settings_show(s, !s[0].set_open, -1); return true; }
  if act == CP_SET_BACK { cp_settings_show(s, false, -1); return true; }
  if act == CP_SET_ACCOUNT { cp_settings_show(s, true, CP_PG_ACCOUNT); return true; }
  if act == CP_SET_SEARCH { cp_ed_focus(s, CP_KB_SEARCH); return true; }
  if act == CP_SET_PAGE {
    p := cp_number(id, "set.page.");
    if p < 0 || p >= CP_SET_PAGES { return false; }
    cp_settings_show(s, true, p); return true;
  }
  if act == CP_SET_HIT {
    n := cp_number(id, "set.hit.");
    es := cp_set_entries();
    if n < 0 || n >= CP_SET_ENTRIES { return false; }
    cp_settings_show(s, true, es[n].page);
    s[0].set_target_n = cp_out(s[0].set_target[..], es[n].id); s[0].set_scroll = 0;
    return true;
  }
  if act != CP_SET_ACT { return false; }
  if cp_flawed_settings_press(s, id) { return true; }
  if id == "set.folder.a" { if cp_running(s) { return false; } s[0].ask = CP_ASK_FOLDER; return true; }
  if id == "set.zoom.a" { s[0].ask = CP_ASK_ZOOM_OUT; return true; }
  if id == "set.zoom.b" { s[0].ask = CP_ASK_ZOOM_IN; return true; }
  sbv := cp_number(id, "set.sidebar.view.");
  if sbv == 0 || sbv == 1 { coder_page_sb_condensed_set(s, sbv == 1); s[0].ask = CP_ASK_SIDEBAR_VIEW; return true; }
  if id == "set.sidebar.archived.a" {
    next_act := ifx s[0].sb[0].view_mode == CP_SB_VIEW_ARCHIVED then CP_SB_VIEW_ACTIVE_ACT else CP_SB_VIEW_ARCHIVED_ACT;
    _ = cp_sb_press(s, next_act, id);
    cp_settings_show(s, false, -1);
    return true;
  }
  nmode := cp_number(id, "set.notify.");
  if nmode >= CP_NOTIFY_OFF && nmode <= CP_NOTIFY_BOTH { s[0].notify_mode = nmode; s[0].ask = CP_ASK_NOTIFY; return true; }
  ex := cp_number(id, "set.exp.");
  if ex == 0 || ex == 1 { coder_page_experimental_set(s, ex == 1); s[0].ask = CP_ASK_EXPERIMENTAL; return true; }
  if id == "set.instr.a" { s[0].ask = CP_ASK_INSTRUCTIONS; return true; }
  if id == "set.instr.reset.a" { s[0].ask = CP_ASK_INSTRUCTIONS_RESET; return true; }
  if id == "set.sysprompt.a" || id == "set.sysprompt" { s[0].ask = CP_ASK_CUSTOM_PROMPT; return true; }
  if id == "set.sysprompt.clear.a" || id == "set.sysprompt.clear" { s[0].ask = CP_ASK_CUSTOM_PROMPT_CLEAR; return true; }
  if id == "set.local.a" { s[0].ask = CP_ASK_LOCAL_MODELS; return true; }
  if id == "set.gemini.a" { if !cp_flag(s, DC_FLAG_MODELS_GEMINI) { return false; } s[0].ask = CP_ASK_GEMINI_KEY; return true; }
  if id == "set.exec.hybrid.a" || id == "set.exec.modules.a" { if !cp_flag(s, DC_FLAG_MODELS_EXECUTOR) { return false; } s[0].ask = CP_ASK_EXECUTOR_MODELS; return true; }
  if id == "set.pylon.state.a" || id == "set.pylon.contrib.a" || id == "set.pylon.sats.a" || id == "set.pylon.release.a" { if !cp_flag(s, DC_FLAG_MODELS_EXECUTOR) { return false; } s[0].ask = CP_ASK_PYLON_EXECUTOR; return true; }
  if id == "set.wallet.status.a" { if !cp_flag(s, DC_FLAG_WALLET) { return false; } s[0].ask = ifx s[0].set_wallet_ready then CP_ASK_WALLET_REFRESH else CP_ASK_WALLET_CONNECT; return true; }
  if id == "set.wallet.receive.a" { if !cp_flag(s, DC_FLAG_WALLET) { return false; } s[0].ask = CP_ASK_WALLET_RECEIVE; return true; }
  if id == "set.wallet.send.a" { if !cp_flag(s, DC_FLAG_WALLET) { return false; } s[0].ask = CP_ASK_WALLET_SEND; return true; }
  if id == "set.wallet.limit.a" { if !cp_flag(s, DC_FLAG_WALLET) { return false; } s[0].ask = CP_ASK_WALLET_LIMIT; return true; }
  if id == "set.wallet.backup.a" { if !cp_flag(s, DC_FLAG_WALLET) { return false; } s[0].ask = CP_ASK_WALLET_BACKUP; return true; }
  if id == "set.usage.refresh.a" { s[0].ask = CP_ASK_USAGE_REFRESH; return true; }
  if id == "set.usage.prices.a" { s[0].ask = CP_ASK_USAGE_PRICES; return true; }
  upool := cp_number(id, "set.usage.pool.");
  if upool == 0 || upool == 1 { s[0].usage[0].pool_enabled = (upool == 1); s[0].ask = CP_ASK_USAGE_POOL; return true; }
  urec := cp_number(id, "set.usage.recovery.");
  if urec == 0 || urec == 1 { s[0].usage[0].recovery_enabled = (urec == 1); s[0].ask = CP_ASK_USAGE_RECOVERY; return true; }
  if cp_flag(s, DC_FLAG_MODELS_CLAUDE) {
    if id == "set.claude.a" { s[0].ask = CP_ASK_CLAUDE_KEY; return true; }
    eslot := cp_number(id, "set.claude.effort.");
    if eslot >= 0 && eslot < CP_CLAUDE_MODELS && id.count == "set.claude.effort.0.0".count {
      elevel := cast(int) (id[id.count - 1] - '0');
      if elevel < 0 || elevel >= CP_CLAUDE_EFFORTS { return false; }
      coder_page_claude_effort_set(s, eslot, elevel); s[0].ask = CP_ASK_CLAUDE_EFFORT; return true;
    }
    omodel := cp_number(id, "set.orch.model.");
    if omodel >= 0 && omodel < CP_CLAUDE_MODELS { coder_page_orchestrator_set(s, s[0].orch_claude, omodel); s[0].ask = CP_ASK_ORCHESTRATOR; return true; }
    omain := cp_number(id, "set.orch.");
    if id.count == "set.orch.0".count && (omain == 0 || (omain == 1 && s[0].claude)) { coder_page_orchestrator_set(s, omain == 1, s[0].orch_model); s[0].ask = CP_ASK_ORCHESTRATOR; return true; }
  }
  if id == "set.or.a" || id == "set.or.main" || id == "set.or.sub" { if !cp_flag(s, DC_FLAG_MODELS_OPENROUTER) { return false; } s[0].ask = CP_ASK_OPENROUTER; return true; }
  if cp_flag(s, DC_FLAG_MODELS_ANTIGRAVITY) {
    if id == "set.agy.status.a" || id == "set.agy.model" { s[0].ask = CP_ASK_AGY; return true; }
    amode := cp_number(id, "set.agy.mode.");
    if amode >= 0 && amode <= 2 { s[0].set_agy_mode = amode; s[0].ask = CP_ASK_AGY_MODE; return true; }
    if id == "set.agy.auth.a" || id == "set.agy.auth" { s[0].ask = CP_ASK_AGY_AUTH; return true; }
  }
  // Settings -> MCP & Skills (#13879)
  if cp_flag(s, DC_FLAG_MCP) {
    if id == "set.mcp.add.a" { s[0].ask = CP_ASK_MCP_ADD; return true; }
    msrv := cp_number(id, "set.mcp.srv.");
    if msrv >= 0 && msrv < s[0].mcp_skills[0].nservers && id.count >= 2 && id[id.count - 2] == '.' {
      opt := cast(int) (id[id.count - 1] - '0');
      s[0].mcp_skills[0].mcp_target = msrv;
      if opt == 0 || opt == 1 {
        want := opt == 1;
        if s[0].mcp_skills[0].servers[msrv].enabled != want { _ = cp_mcp_toggle(s, msrv); }
        s[0].ask = CP_ASK_MCP_TOGGLE;
        return true;
      }
      if opt == 2 { s[0].ask = CP_ASK_MCP_OAUTH; return true; }
      if opt == 3 { s[0].ask = CP_ASK_MCP_REMOVE; return true; }
    }
    mskill := cp_number(id, "set.skill.");
    if mskill >= 0 && mskill < s[0].mcp_skills[0].nskills && id.count >= 2 && id[id.count - 2] == '.' {
      opt := cast(int) (id[id.count - 1] - '0');
      if opt == 0 || opt == 1 {
        s[0].mcp_skills[0].skill_target = mskill;
        want := opt == 1;
        if s[0].mcp_skills[0].skills[mskill].enabled != want { _ = cp_skills_toggle(s, mskill); }
        s[0].ask = CP_ASK_SKILL_TOGGLE;
        return true;
      }
    }
  }
  if cp_flag(s, DC_FLAG_MODELS_EXTERNAL) {
    if id == "set.codex.a" || id == "set.codex" { s[0].ask = CP_ASK_CODEX; return true; }
    if id == "set.cursor.a" || id == "set.cursor" { s[0].ask = CP_ASK_CURSOR; return true; }
    if id == "set.acp.a" || id == "set.acp" { s[0].ask = CP_ASK_ACP_REGISTRY; return true; }
  }
  // Settings -> Voice (#13882, promoted to --minimal in #14065)
  vb := cp_number(id, "set.voice.backend.");
  if vb == CP_VOICE_BACKEND_APPLE || vb == CP_VOICE_BACKEND_WHISPER { s[0].voice[0].backend = vb; s[0].ask = CP_ASK_VOICE_BACKEND; return true; }
  vm := cp_number(id, "set.voice.mode.");
  if vm == CP_VOICE_MODE_TOGGLE || vm == CP_VOICE_MODE_HOLD { s[0].voice[0].mode = vm; s[0].ask = CP_ASK_VOICE_PREFS; return true; }
  vf := cp_number(id, "set.voice.fillers.");
  if vf == 0 || vf == 1 { s[0].voice[0].strip_fillers = (vf == 1); s[0].ask = CP_ASK_VOICE_PREFS; return true; }
  if id == "set.voice.mic.a" || id == "set.voice.mic" { s[0].ask = CP_ASK_VOICE_MIC; return true; }
  if id == "set.voice.dict.a" || id == "set.voice.dict" { s[0].ask = CP_ASK_VOICE_DICT; return true; }
  // Settings -> Connections (#13883)
  if (cp_flag(s, DC_FLAG_ENVIRONMENTS) || cp_flag(s, DC_FLAG_PAIRING)) && cp_env_settings_press(s, id) { return true; }
  // Settings -> Scheduled Tasks & About -> Update Everything (#13885)
  if cp_flag(s, DC_FLAG_SCHEDULED) && cp_settings_sched_press(s, id) { return true; }
  // Settings -> Appearance & Keybindings (#13887)
  if cp_flag(s, DC_FLAG_CUSTOMIZE) && cp_cust_settings_press(s, id) { return true; }
  if id == "set.update.a" {
    st := s[0].update_state;
    s[0].ask = ifx st == CP_UPD_AVAILABLE || st == CP_UPD_READY then CP_ASK_UPDATE else CP_ASK_CHECK_UPDATES;
    return true;
  }
  if cp_flag(s, DC_FLAG_FOREMAN) {
    tier := cp_number(id, "set.tier.");
    if tier >= 0 && tier <= CP_FOREMAN_TIER_AUTO { s[0].set_tier = tier; s[0].ask = CP_ASK_TIER; return true; }
    if id == "set.audit.a" { s[0].ask = CP_ASK_AUDIT; return true; }
    if id == "set.clear.a" { s[0].ask = CP_ASK_CLEAR_FOREMAN; return true; }
  }
  if cp_flag(s, DC_FLAG_ACCOUNT) && id == "set.login" { s[0].ask = CP_ASK_LOGIN; return true; }
  return false;
}

// ---------------------------------------------------------------- drawing

// The list of pages from x 0, lw wide, the window's height h.
cp_settings_list :: (s: [] CoderPage, f: [] UiFrame, lw: f32, h: f32) {
  k := f[0].skin; t := k.set; sh := f[0].sheet;
  sheet_fill(sh, 0, 0, lw, h, 0, ifx k.sidebar.a > 0 then k.sidebar else k.surface);
  x := t.list_pad; w := lw - 2 * t.list_pad;
  y := cp_bar(s) + t.list_pad;   // under the window's title bar (page/layout/titlebar.coax)
  loc := s[0].cust[0].locale.active;
  y += set_nav_row(f, "set.back", x, y, w, ICON_SET_BACK, cp_tr(loc, "back_to_chats"), false, true, CP_SET_BACK) + t.list_gap;
  keys := [2] string.["⌘", "F"];
  q := cp_set_query(s);
  _ := set_search(f, "set.search", x, y, w, cp_tr(loc, "search_settings"), q.count == 0, keys[..], CP_SET_SEARCH);
  b := set_search_box(t, x, y, w);
  s[0].set_box[0] = b.x; s[0].set_box[1] = b.y; s[0].set_box[2] = b.w; s[0].set_box[3] = b.h;
  cp_ed_draw(s, f, CP_ED_SEARCH, b.x, b.y, b.w, b.h, "");   // its words, caret and selection (page/editor.coax)
  y += t.search_h + t.list_gap;
  foot := h - t.list_pad - t.account - t.account_top;
  view := foot - y;
  s[0].set_list_view = view;
  uiframe_clip(f, 0, y, lw, foot);
  at := scroll_clamp(s[0].set_list_scroll, s[0].set_list_content, view);
  ry := y - at;
  if q.count > 0 {
    // the results stand in the pages' place
    hits: [CP_SET_HITS] int;
    n := cp_set_hits_flags(q, hits[..], s[0].flags);
    es := cp_set_entries(); icons := CP_SET_ICON;
    ry += set_nav_head(f, "set.found", x, ry, w, ifx n > 0 then "Settings found" else "No settings match.") + t.list_gap;
    hb: [24] u8;
    for i: 0..<n {
      e := es[hits[i]];
      hn := el_put(hb[..], 0, "set.hit."); hn = el_put_i(hb[..], hn, hits[i]);
      ry += set_nav_row(f, sheet_pool(sh, cast(string) hb[0..<hn]), x, ry, w, icons[e.page], e.name, false, false, CP_SET_HIT) + t.list_gap;
    }
  } else {
    names := CP_SET_NAME; icons := CP_SET_ICON; order := CP_SET_ORDER; within := CP_SET_IN; groups := CP_SET_GROUP;
    gb: [24] u8; pb: [24] u8;
    headed := -1;   // the group whose heading is drawn last: a group with no page shown has none
    for i: 0..<CP_SET_PAGES {
      p := order[i];
      if !cp_set_page_ok_flags(s[0].flags, p) { continue; }
      if within[i] != headed {
        headed = within[i];
        gn := el_put(gb[..], 0, "set.group."); gn = el_put_i(gb[..], gn, within[i]);
        ry += set_nav_head(f, sheet_pool(sh, cast(string) gb[0..<gn]), x, ry, w, groups[within[i]]) + t.list_gap;
      }
      pn := el_put(pb[..], 0, "set.page."); pn = el_put_i(pb[..], pn, p);
      ry += set_nav_row(f, sheet_pool(sh, cast(string) pb[0..<pn]), x, ry, w, icons[p], cp_set_page_label(s, p), p == s[0].set_page, false, CP_SET_PAGE) + t.list_gap;
    }
  }
  uiframe_unclip(f);
  s[0].set_list_content = ry + at - y;
  _ := cp_side_settings_row(f, "set.me", 0, h - t.list_pad - t.account, lw - cp_px(s), t.account, true, CP_SET_TOGGLE);
  _ := cp_side_border(s, sh, lw, 0, h, ifx s[0].hover == 1 || s[0].drag == 1 then t.strong else t.subtle);
}
// One row, and where it is when the search asked for it.
cp_set_row :: (s: [] CoderPage, f: [] UiFrame, r: SetRow, x: f32, y: f32, w: f32) -> f32 {
  if s[0].set_target_n > 0 && r.id == cast(string) s[0].set_target[0..<s[0].set_target_n] { s[0].set_target_y = y; }
  return set_row(f, r, x, y, w);
}
// A group (card) of rows, marking the one the search asked for.
cp_set_group :: (s: [] CoderPage, f: [] UiFrame, id: string, x: f32, y: f32, w: f32, rows: [] SetRow) -> f32 {
  t := f[0].skin.set;
  if s[0].set_target_n > 0 {
    ry := y + t.card_edge;
    for r, i: rows {
      if i > 0 { ry += t.card_edge; }
      if r.id == cast(string) s[0].set_target[0..<s[0].set_target_n] { s[0].set_target_y = ry; }
      ry += set_row_fit(f, r, w - 2 * t.card_edge).h;
    }
  }
  return set_group(f, id, x, y, w, rows);
}
cp_zoom_text :: (s: [] CoderPage, out: [] u8) -> string {
  n := el_put_i(out, 0, cast(int) floor(CP_ZOOMS[s[0].zoom] * 100 + 0.5)); n = el_put(out, n, "%");
  return cast(string) out[0..<n];
}
cp_or_shown :: (v: string) -> string { return ifx v.count > 0 then v else "None"; }
// The page that is open, from x, w wide, the window's height h.
cp_settings_page :: (s: [] CoderPage, f: [] UiFrame, px: f32, pw: f32, h: f32) {
  k := f[0].skin; t := k.set; sh := f[0].sheet;
  top := cp_bar(s);   // under the window's title bar (page/layout/titlebar.coax)
  if s[0].set_page == CP_PG_PROVIDERS {
    cp_settings_providers(s, f, px, pw, top, h);
    return;
  }
  view := h - top;
  s[0].set_view = view;
  c := set_column(t, px, pw);
  x := c.x; w := c.w;
  at := scroll_clamp(s[0].set_scroll, s[0].set_content, view);
  uiframe_clip(f, px, top, px + pw, h);
  y0 := top + t.page_top - at; y := y0;
  s[0].set_target_y = -1;
  page := s[0].set_page; names := CP_SET_NAME;
  nb: [CP_SET_QUERY + 16] u8;
  if page == CP_PG_GENERAL {
    y += set_page_head(f, "set.title", x, y, w, names[page], "How Coder works on this computer.") + t.block_gap;
    rows: [6] SetRow;
    folder := ifx s[0].folder_n > 0 then sheet_pool(sh, cast(string) s[0].folder[0..<s[0].folder_n]) else "Home folder";
    rows[0] = SetRow.{id = "set.folder", name = "Working folder", desc = "Where OpenAgents runs its commands. New chats start here too.",
      value = folder, kind = SET_ROW_BUTTON, button = "Choose…", action = CP_SET_ACT, state = ifx cp_running(s) then EL_S_DISABLED else 0};
    rows[1] = SetRow.{id = "set.zoom", name = "Text size", desc = "Bigger and smaller words everywhere in Coder.",
      value = sheet_pool(sh, cp_zoom_text(s, nb[..])), kind = SET_ROW_STEPPER, button = "−", button2 = "+", action = CP_SET_ACT, action2 = CP_SET_ACT};
    rows[2] = SetRow.{id = "set.sidebar.view", name = "Sidebar view",
      desc = ifx s[0].sb[0].condensed then "Condensed — show only the chat title and status line." else "Expanded — show chat title, repository, branch, and model icon.",
      kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx s[0].sb[0].condensed then 1 else 0, action = CP_SET_ACT};
    rows[2].options[0] = "Expanded"; rows[2].options[1] = "Condensed";
    narch := cp_sb_archived_count(s);
    is_arch := s[0].sb[0].view_mode == CP_SB_VIEW_ARCHIVED;
    ab: [24] u8;
    arch_val := "None";
    if narch > 0 {
      an := el_put_i(ab[..], 0, narch);
      an = el_put(ab[..], an, ifx narch == 1 then " chat" else " chats");
      arch_val = sheet_pool(sh, cast(string) ab[0..<an]);
    }
    rows[3] = SetRow.{id = "set.sidebar.archived", name = "Archived chats",
      desc = ifx is_arch then "Currently showing archived chats in the sidebar." else "View and restore chats you have archived.",
      value = arch_val, kind = SET_ROW_BUTTON, button = ifx is_arch then "Show active" else "View", action = CP_SET_ACT};
    nmode := cp_notify_clamp_mode(s[0].notify_mode);
    rows[4] = SetRow.{id = "set.notify", name = "Notifications",
      desc = ifx nmode == CP_NOTIFY_OFF then "Off — no OS notifications or audio chimes."
             else ifx nmode == CP_NOTIFY_OS then "Notifications — OS alerts when unfocused or in background chats."
             else ifx nmode == CP_NOTIFY_SOUND then "Sound — subtle chimes when turns finish or need input."
             else "Notifications & Sound — OS alerts and subtle chimes when turns finish or need input.",
      kind = SET_ROW_CHOICE, noptions = 4, chosen = nmode, action = CP_SET_ACT};
    rows[4].options[0] = "Off"; rows[4].options[1] = "Notify"; rows[4].options[2] = "Sound"; rows[4].options[3] = "Both";
    rows[5] = SetRow.{id = "set.exp", name = "Experimental features", desc = "Log in, account, Gym and Foreman.",
      kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx s[0].experimental then 1 else 0, action = CP_SET_ACT};
    rows[5].options[0] = "Off"; rows[5].options[1] = "On";
    y += cp_set_group(s, f, "set.general.group", x, y, w, rows[..]) + t.block_gap;
    // Custom system prompt appended to every single system prompt (~/.openagents/system-prompt.md)
    y += set_section_head(f, "set.sysprompt.head", x, y, w, "Custom system prompt", "Extra instructions appended to every system prompt across OpenAgents and any connected external harnesses in every chat and folder.") + t.section_gap;
    sysp_val := ifx s[0].set_sysprompt_n > 0 then sheet_pool(sh, cast(string) s[0].set_sysprompt[0..<s[0].set_sysprompt_n]) else "Off";
    sysp_desc := ifx s[0].set_sysprompt_preview_n > 0 then sheet_pool(sh, cast(string) s[0].set_sysprompt_preview[0..<s[0].set_sysprompt_preview_n]) else "Kept in ~/.openagents/system-prompt.md. Leave empty to disable; edits apply from the very next message.";
    sprows: [2] SetRow;
    sprows[0] = SetRow.{id = "set.sysprompt", name = "Custom system prompt", desc = sysp_desc,
      value = sysp_val, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};
    sprows[1] = SetRow.{id = "set.sysprompt.clear", name = "Clear custom system prompt", desc = "Removes your custom system prompt instructions so nothing extra is appended.",
      kind = SET_ROW_BUTTON, button = "Clear…", action = CP_SET_ACT, danger = true};
    y += cp_set_group(s, f, "set.sysprompt.group", x, y, w, sprows[..]) + t.block_gap;
    // what every agent is told in every chat (~/.openagents/instructions.md, GitHub #13808)
    y += set_section_head(f, "set.instr.head", x, y, w, "Agent instructions", "What OpenAgents and any connected external harnesses are told in every chat, in every folder. A repository's own AGENTS.md wins where they differ.") + t.section_gap;
    instr := ifx s[0].set_instr_n > 0 then sheet_pool(sh, cast(string) s[0].set_instr[0..<s[0].set_instr_n]) else "Default";
    irows: [2] SetRow;
    irows[0] = SetRow.{id = "set.instr", name = "Agent instructions", desc = "Kept in ~/.openagents/instructions.md. The default: commit finished work and push it in a git repository.",
      value = instr, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};
    irows[1] = SetRow.{id = "set.instr.reset", name = "Reset to default", desc = "Puts OpenAgents' default instructions back in place of yours.",
      kind = SET_ROW_BUTTON, button = "Reset…", action = CP_SET_ACT, danger = true};
    y += cp_set_group(s, f, "set.instr.group", x, y, w, irows[..]);
  } else if page == CP_PG_FLAWED {
    y += cp_settings_flawed(s, f, x, y, w);
  } else if page == CP_PG_MODELS {
    models_sub := ifx cp_has_model_picker(s) then "The local runtime and optional cloud or CLI models." else "Inkling 2 Mini runs locally on this Mac through Psionic Metal.";
    y += set_page_head(f, "set.title", x, y, w, names[page], models_sub) + t.block_gap;
    local_st := ifx s[0].set_local_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_local_status[0..<s[0].set_local_status_n]) else "Not downloaded";
    local_name := sheet_pool(sh, cp_inkling_label(s));
    y += set_section_head(f, "set.local.head", x, y, w, "Local Model", "Download, verify (SHA-256), and switch Inkling 2 Mini variants on Psionic Metal (~/.openagents/models).") + t.section_gap;
    lrows: [1] SetRow;
    lrows[0] = SetRow.{id = "set.local", name = local_name, desc = "26.4B total / 3.4B active looped MoE (Uncensored LoRA, AD quants, Official IQ4_NL, or Custom .gguf · SHA-256 verified · native Psionic Metal). Requires >= 12 GB Apple Silicon Mac.",
      value = local_st, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.local.group", x, y, w, lrows[..]) + t.block_gap;
    if cp_flag(s, DC_FLAG_MODELS_GEMINI) {
      gemini := ifx s[0].set_gemini_n > 0 then sheet_pool(sh, cast(string) s[0].set_gemini[0..<s[0].set_gemini_n]) else "Not set";
      y += set_section_head(f, "set.gemini.head", x, y, w, "Gemini", "OpenAgents runs Gemini models on Vertex AI when this Mac has a Google Cloud service account, else on a Gemini API key.") + t.section_gap;
      gauth := ifx s[0].set_gauth_n > 0 then sheet_pool(sh, cast(string) s[0].set_gauth[0..<s[0].set_gauth_n]) else "None found";
      gone: [2] SetRow;
      gone[0] = SetRow.{id = "set.gemini.auth", name = "Signed in with",
        desc = "Vertex AI: the service account in ~/.openagents/coder/antigravity.env or ~/work/.secrets/vertex-sa-inference.json, through gcloud. Else the key below.",
        value = gauth, kind = SET_ROW_PLAIN};
      gone[1] = SetRow.{id = "set.gemini", name = "Gemini API key", desc = "Paste a key from Google AI Studio. Kept in a file only you can read.",
        value = gemini, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.gemini.group", x, y, w, gone[..]) + t.block_gap;
    }
    if cp_flag(s, DC_FLAG_MODELS_CLAUDE) {
      claude := ifx s[0].set_claude_n > 0 then sheet_pool(sh, cast(string) s[0].set_claude[0..<s[0].set_claude_n]) else "Not set";
      y += set_section_head(f, "set.claude.head", x, y, w, "Claude", "A chat can run on Claude through Claude Code on this computer, and any chat can hand tasks to Claude sub-agents: Haiku 5.5, Sonnet 5.5, Opus 5.5 or Fable 5.2.") + t.section_gap;
      one: [3 + CP_CLAUDE_MODELS] SetRow; cn := 0;
      on_claude := s[0].orch_claude && s[0].claude;
      one[cn] = SetRow.{id = "set.orch", name = "New chats start on",
        desc = ifx !s[0].claude then "Claude Code is not installed on this computer. To install it, run: curl -fsSL https://claude.ai/install.sh | bash"
               else ifx on_claude then "Claude runs each new chat and hands tasks to sub-agents. Change one chat's model in its composer."
               else "Default model runs each new chat. Change one chat's model in its composer.",
        kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx on_claude then 1 else 0, action = CP_SET_ACT, state = ifx s[0].claude then 0 else EL_S_DISABLED};
      one[cn].options[0] = "Default"; one[cn].options[1] = "Claude";
      cn += 1;
      if s[0].claude {
        shorts := CP_CLAUDE_SHORT;
        om := ifx s[0].orch_model >= 0 && s[0].orch_model < CP_CLAUDE_MODELS then s[0].orch_model else CP_CLAUDE_START;
        one[cn] = SetRow.{id = "set.orch.model", name = "Claude model",
          desc = ifx on_claude then "The Claude model new chats start on." else "The Claude model new chats start on when Claude is picked above.",
          kind = SET_ROW_CHOICE, noptions = CP_CLAUDE_MODELS, chosen = om, action = CP_SET_ACT};
        for ci: 0..<CP_CLAUDE_MODELS { one[cn].options[ci] = shorts[ci]; }
        cn += 1;
        enames := [CP_CLAUDE_MODELS] string.["Fable 5.2 thinking", "Opus 5.5 thinking", "Sonnet 5.5 thinking", "Haiku 5.5 thinking"];
        eids := [CP_CLAUDE_MODELS] string.["set.claude.effort.0", "set.claude.effort.1", "set.claude.effort.2", "set.claude.effort.3"];
        elabels := CP_CLAUDE_EFFORT_LABEL;
        for ek: 0..<CP_CLAUDE_MODELS {
          one[cn] = SetRow.{id = eids[ek], name = enames[ek],
            desc = ifx ek == 0 then "How hard the model thinks, in a chat and as a sub-agent. A chat's composer can pick another level for that chat." else "",
            kind = SET_ROW_CHOICE, noptions = CP_CLAUDE_EFFORTS, chosen = cp_claude_effort(s, ek), action = CP_SET_ACT};
          for ei: 0..<CP_CLAUDE_EFFORTS { one[cn].options[ei] = elabels[ei]; }
          cn += 1;
        }
      }
      one[cn] = SetRow.{id = "set.claude", name = "Claude key", desc = "Claude chats and sub-agents use it in place of the Claude Code login on this computer.",
        value = claude, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
      cn += 1;
      y += cp_set_group(s, f, "set.claude.group", x, y, w, one[0..<cn]) + t.block_gap;
    }
    if cp_flag(s, DC_FLAG_MODELS_OPENROUTER) {
      orkey := ifx s[0].set_orkey_n > 0 then sheet_pool(sh, cast(string) s[0].set_orkey[0..<s[0].set_orkey_n]) else "Not set";
      y += set_section_head(f, "set.or.head", x, y, w, "OpenRouter", "Run OpenAgents or its sub-agents on an OpenRouter model that takes a strict JSON schema.") + t.section_gap;
      rows: [3] SetRow;
      rows[0] = SetRow.{id = "set.or", name = "OpenRouter key", desc = "Kept in a file only you can read.", value = orkey, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
      rows[1] = SetRow.{id = "set.or.main", name = "Model for OpenAgents", desc = "Joins the developer model picker.", value = sheet_pool(sh, cp_or_shown(cp_or_main(s))), kind = SET_ROW_LINK, action = CP_SET_ACT};
      rows[2] = SetRow.{id = "set.or.sub", name = "Model for sub-agents", desc = "One more level OpenAgents can hand tasks to.", value = sheet_pool(sh, cp_or_shown(cp_or_sub(s))), kind = SET_ROW_LINK, action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.or.group", x, y, w, rows[..]) + t.block_gap;
    }
    if cp_flag(s, DC_FLAG_MODELS_ANTIGRAVITY) {
      agy_st := ifx s[0].set_agy_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_agy_status[0..<s[0].set_agy_status_n]) else "Not installed";
      agy_shown := cp_agy_shown(s);
      agy_mod := sheet_pool(sh, ifx agy_shown.count > 0 then agy_shown else "Checking…");
      agy_au := ifx s[0].set_agy_auth_n > 0 then sheet_pool(sh, cast(string) s[0].set_agy_auth[0..<s[0].set_agy_auth_n]) else "Isolated profile";
      amode := ifx s[0].set_agy_mode >= 0 && s[0].set_agy_mode <= 2 then s[0].set_agy_mode else 0;
      y += set_section_head(f, "set.agy.head", x, y, w, "Antigravity", "Run tasks with the Antigravity CLI (agy >= 1.5.0) in an isolated profile.") + t.section_gap;
      arows: [4] SetRow;
      arows[0] = SetRow.{id = "set.agy.status", name = "Antigravity CLI", desc = "Binary path and detected version (requires >= 1.5.0).",
        value = agy_st, kind = SET_ROW_BUTTON, button = "Configure…", action = CP_SET_ACT};
      arows[1] = SetRow.{id = "set.agy.mode", name = "Review mode",
        desc = ifx amode == 1 then "Pause for review before risky edits." else ifx amode == 2 then "Propose a plan before making edits." else "Apply edits and run commands automatically.",
        kind = SET_ROW_CHOICE, noptions = 3, chosen = amode, action = CP_SET_ACT};
      arows[1].options[0] = "Auto"; arows[1].options[1] = "Default"; arows[1].options[2] = "Plan";
      arows[2] = SetRow.{id = "set.agy.model", name = "Model & effort", desc = ifx s[0].set_agy_model_n == 0 || cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n] == "Default" then "None set: agy's own default model, at high effort, which streams its thinking. Set a model id and effort to change it." else "The Antigravity model id and reasoning effort (low, medium, high) you set.",
        value = agy_mod, kind = SET_ROW_LINK, action = CP_SET_ACT};
      arows[3] = SetRow.{id = "set.agy.auth", name = "Sign-in & profile", desc = "Google sign-in, isolated profile directory, or antigravity.env ADC.",
        value = agy_au, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.agy.group", x, y, w, arows[..]) + t.block_gap;
    }
    if cp_flag(s, DC_FLAG_MODELS_EXECUTOR) {
      exec_st := ifx s[0].set_exec_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_exec_status[0..<s[0].set_exec_status_n]) else "Not verified";
      exec_lin := ifx s[0].set_exec_lineage_n > 0 then sheet_pool(sh, cast(string) s[0].set_exec_lineage[0..<s[0].set_exec_lineage_n]) else "0/4 modules verified";
      exec_bdg := ifx s[0].set_exec_badge_n > 0 then sheet_pool(sh, cast(string) s[0].set_exec_badge[0..<s[0].set_exec_badge_n]) else "Unverified [N]";
      ed: [192] u8; edn := el_put(ed[..], 0, "Verification class: "); edn = el_put(ed[..], edn, exec_bdg);
      edn = el_put(ed[..], edn, ". Selectable in picker only when base checkpoint and 4/4 SHA-256 modules pass.");
      y += set_section_head(f, "set.exec.head", x, y, w, "Executor Models & Weight Modules", "SHA-256 verified compiled dense F64 weight modules (~/.openagents/modules) and Hybrid Executor (hybrid-exec-v1).") + t.section_gap;
      erows: [2] SetRow;
      erows[0] = SetRow.{id = "set.exec.hybrid", name = "Hybrid Executor (hybrid-exec-v1)",
        desc = sheet_pool(sh, cast(string) ed[0..<edn]),
        value = exec_st, kind = SET_ROW_BUTTON, button = "Verify…", action = CP_SET_ACT};
      erows[1] = SetRow.{id = "set.exec.modules", name = "Compiled Weight Modules",
        desc = "Class-E dense F64 modules: oa-exec-diff-verify, oa-exec-json-schema, oa-exec-dep-sched, oa-exec-arith-budget.",
        value = exec_lin, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.exec.group", x, y, w, erows[..]) + t.block_gap;
      py_st := ifx s[0].set_pylon_state_n > 0 then sheet_pool(sh, cast(string) s[0].set_pylon_state[0..<s[0].set_pylon_state_n]) else "Off";
      py_co := ifx s[0].set_pylon_contrib_n > 0 then sheet_pool(sh, cast(string) s[0].set_pylon_contrib[0..<s[0].set_pylon_contrib_n]) else "0 traces · 0 windows";
      py_sa := ifx s[0].set_pylon_sats_n > 0 then sheet_pool(sh, cast(string) s[0].set_pylon_sats[0..<s[0].set_pylon_sats_n]) else "0 sats settled";
      py_rl := ifx s[0].set_pylon_release_n > 0 then sheet_pool(sh, cast(string) s[0].set_pylon_release[0..<s[0].set_pylon_release_n]) else "No promoted release yet";
      y += set_section_head(f, "set.pylon.head", x, y, w, "Pylon & Executor Network", "Live on-disk Pylon runtime state, verified training contributions, reconciled Spark sats (real_bitcoin_moved=true), and signed Ch 224 shadow rollout.") + t.section_gap;
      pyrows: [4] SetRow;
      pyrows[0] = SetRow.{id = "set.pylon.state", name = "Local Pylon",
        desc = "Runtime state from ~/.openagents/pylon/state/ (Off / Self-testing / Executing / Validating / Training).",
        value = py_st, kind = SET_ROW_BUTTON, button = "Details…", action = CP_SET_ACT};
      pyrows[1] = SetRow.{id = "set.pylon.contrib", name = "Verified Traces & Training Windows",
        desc = "Independent replay-verified traces and bounded W5 DiLoCo training windows contributed by this device.",
        value = py_co, kind = SET_ROW_BUTTON, button = "Inspect…", action = CP_SET_ACT};
      pyrows[2] = SetRow.{id = "set.pylon.sats", name = "Spark Satoshis Settled",
        desc = "Reconciled from ~/.openagents/pylon/settlement/receipts.jsonl (real_bitcoin_moved=true only; test networks strictly separated from mainnet).",
        value = py_sa, kind = SET_ROW_BUTTON, button = "Ledger…", action = CP_SET_ACT};
      pyrows[3] = SetRow.{id = "set.pylon.release", name = "Executor Checkpoint & Shadow Rollout",
        desc = "Signed openagents.executor-release.v1 SHA-256 lineage with Ch 224 shadow-to-promote & atomic rollback.",
        value = py_rl, kind = SET_ROW_BUTTON, button = "Rollout…", action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.pylon.group", x, y, w, pyrows[..]) + t.block_gap;
    }
    if cp_flag(s, DC_FLAG_MODELS_EXTERNAL) {
      codex_st := ifx s[0].prov[0].codex_status_n > 0 then sheet_pool(sh, cast(string) s[0].prov[0].codex_status[0..<s[0].prov[0].codex_status_n]) else "Not installed";
      codex_au := ifx s[0].prov[0].codex_auth_n > 0 then sheet_pool(sh, cast(string) s[0].prov[0].codex_auth[0..<s[0].prov[0].codex_auth_n]) else "Run `codex login` to sign in";
      cursor_st := ifx s[0].prov[0].cursor_status_n > 0 then sheet_pool(sh, cast(string) s[0].prov[0].cursor_status[0..<s[0].prov[0].cursor_status_n]) else "Not installed";
      cursor_au := ifx s[0].prov[0].cursor_auth_n > 0 then sheet_pool(sh, cast(string) s[0].prov[0].cursor_auth[0..<s[0].prov[0].cursor_auth_n]) else "Run `agent login` to sign in";
      acp_st := ifx s[0].prov[0].acp_status_n > 0 then sheet_pool(sh, cast(string) s[0].prov[0].acp_status[0..<s[0].prov[0].acp_status_n]) else "None registered";
      y += set_section_head(f, "set.providers.head", x, y, w, "External CLI & ACP Providers", "Wire Codex, Cursor, or any ACP-compliant CLI agent (OpenCode, Kiro, custom binaries) into the model picker.") + t.section_gap;
      provs: [3] SetRow;
      provs[0] = SetRow.{id = "set.codex", name = "Codex CLI", desc = codex_au,
        value = codex_st, kind = SET_ROW_BUTTON, button = "Status…", action = CP_SET_ACT};
      provs[1] = SetRow.{id = "set.cursor", name = "Cursor ACP CLI", desc = cursor_au,
        value = cursor_st, kind = SET_ROW_BUTTON, button = "Status…", action = CP_SET_ACT};
      provs[2] = SetRow.{id = "set.acp", name = "ACP Registry", desc = "Custom ACP binaries (~/.openagents/desktop/acp-registry.json).",
        value = acp_st, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
      y += cp_set_group(s, f, "set.providers.group", x, y, w, provs[..]);
    }
  } else if page == CP_PG_FOREMAN {
    y += set_page_head(f, "set.title", x, y, w, names[page], "How much Foreman may do across your chats.") + t.block_gap;
    tier := s[0].foreman_tier;
    rows: [3] SetRow;
    rows[0] = SetRow.{id = "set.tier", name = "Permission tier",
      desc = ifx tier == CP_FOREMAN_TIER_OBSERVE then "Foreman reads chats and changes nothing." else ifx tier == CP_FOREMAN_TIER_AUTO then "Foreman starts, sends to and stops any chat." else "Foreman changes only the chats it manages.",
      kind = SET_ROW_CHOICE, noptions = 3, chosen = tier, action = CP_SET_ACT};
    rows[0].options[0] = "Observe"; rows[0].options[1] = "Managed"; rows[0].options[2] = "Auto";
    rows[1] = SetRow.{id = "set.audit", name = "Audit log", desc = "Every step Foreman took, in a file.", kind = SET_ROW_BUTTON, button = "Open", action = CP_SET_ACT};
    rows[2] = SetRow.{id = "set.clear", name = "Clear history", desc = "Removes the Foreman conversation. Managed chats stay.", kind = SET_ROW_BUTTON, button = "Clear…", action = CP_SET_ACT, danger = true};
    y += cp_set_group(s, f, "set.foreman.group", x, y, w, rows[..]);
  } else if page == CP_PG_ACCOUNT {
    narrow := w < t.aside_narrow;
    y += set_page_head(f, "set.title", x, y, w, names[page], "Sign in to OpenAgents Cloud for frontier models, synced cloud chats, and transparent usage metering.") + t.block_gap;
    gw := ifx narrow then w else w - t.block_gap - t.aside_w;
    gx := x;
    card_tag := ifx s[0].cloud_authed then "OpenAgents Cloud" else "Not signed in";
    card_name := ifx s[0].cloud_authed then "Signed in" else "Sign in";
    card_sub := ifx s[0].cloud_authed then "Connected to OpenAgents Cloud" else "Email code, passkey, or Mac key";
    if narrow {
      // the card stands over the rows, centred
      y += set_member_card(f, "set.card", x + (w - t.aside_w) / 2, y, t.aside_w, t.aside_h, card_tag, card_name, card_sub) + t.block_gap;
    } else {
      _ := set_member_card(f, "set.card", x + w - t.aside_w, y, t.aside_w, t.aside_h, card_tag, card_name, card_sub);
    }
    rows: [3] SetRow;
    rows[0] = SetRow.{id = "set.you", icon = ICON_SET_ACCOUNT, name = "OpenAgents Cloud", desc = ifx s[0].cloud_authed then "Signed in. Cloud turns route through OpenAgents Cloud; local Inkling turns stay $0." else "Sign in with email code, passkey, or this Mac's Nostr key to start chatting."};
    rows[1] = SetRow.{id = "set.keys", icon = ICON_SET_TAG, name = "Credentials", desc = "Session tokens and BYO keys stay in 0600 files under ~/.openagents/."};
    rows[2] = SetRow.{id = "set.chats", icon = ICON_SET_PHONE, name = "Cloud chats & local compute", desc = "Chats use OpenAgents Cloud with optional $0 local Inkling 2 Mini acceleration."};
    gy := y;
    y += cp_set_group(s, f, "set.account.group", gx, y, gw, rows[..]);
    btn_lbl := ifx s[0].cloud_authed then "Switch account…" else "Sign in to OpenAgents";
    bw := set_button_w(f, btn_lbl);
    _ := set_button(f, "set.login", gx + gw - bw, y + t.button_top, btn_lbl, true, 0, CP_SET_ACT);
    y += t.button_top + t.button_h;
    if !narrow { aside_end := gy + t.aside_h + t.caption_gap + t.desc_line; if aside_end > y { y = aside_end; } }
  } else if page == CP_PG_WALLET {
    y += set_page_head(f, "set.title", x, y, w, names[page], "Self-custodial Bitcoin & Lightning wallet on Breez Spark. Payment rules are enforced by pay/wallet.coax.") + t.block_gap;
    wst := ifx s[0].set_wallet_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_status[0..<s[0].set_wallet_status_n]) else "Not connected";
    wbal := ifx s[0].set_wallet_balance_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_balance[0..<s[0].set_wallet_balance_n]) else "—";
    waddr := ifx s[0].set_wallet_addr_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_addr[0..<s[0].set_wallet_addr_n]) else "Connect wallet to view Spark address";
    whist := ifx s[0].set_wallet_history_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_history[0..<s[0].set_wallet_history_n]) else "No payments yet.";
    wlim := ifx s[0].set_wallet_limit_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_limit[0..<s[0].set_wallet_limit_n]) else "₿100,000 / day";
    wbak := ifx s[0].set_wallet_backup_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_backup[0..<s[0].set_wallet_backup_n]) else "Not backed up";
    wnpub := ifx s[0].set_wallet_npub_n > 0 then sheet_pool(sh, cast(string) s[0].set_wallet_npub[0..<s[0].set_wallet_npub_n]) else "Derived from the same 12 BIP-39 words";
    y += set_section_head(f, "set.wallet.head", x, y, w, "Balance & Activity", "Bitcoin, Lightning, and Spark mainnet only. Keys stay in this Mac's Keychain.") + t.section_gap;
    brows: [3] SetRow;
    brows[0] = SetRow.{id = "set.wallet.status", name = "Bitcoin balance", desc = wst,
      value = wbal, kind = SET_ROW_BUTTON, button = ifx s[0].set_wallet_ready then "Sync" else "Connect…", action = CP_SET_ACT};
    brows[1] = SetRow.{id = "set.wallet.addr", name = "Spark address", desc = "Share to receive Spark transfers, or create a BOLT11 Lightning invoice below.",
      value = waddr, kind = SET_ROW_PLAIN};
    brows[2] = SetRow.{id = "set.wallet.history", name = "Recent payments", desc = whist, kind = SET_ROW_PLAIN};
    y += cp_set_group(s, f, "set.wallet.balance.group", x, y, w, brows[..]) + t.block_gap;
    y += set_section_head(f, "set.wallet.pay.head", x, y, w, "Receive & Send", "Every send is quoted first and gated by pay/wallet.coax and your daily spend limit.") + t.section_gap;
    prows: [2] SetRow;
    prows[0] = SetRow.{id = "set.wallet.receive", name = "Receive Bitcoin", desc = "Create a BOLT11 Lightning invoice or copy your Spark / Bitcoin address.",
      kind = SET_ROW_BUTTON, button = "Receive…", action = CP_SET_ACT, state = ifx s[0].set_wallet_ready then 0 else EL_S_DISABLED};
    prows[1] = SetRow.{id = "set.wallet.send", name = "Send Bitcoin", desc = "Paste a BOLT11 invoice, Lightning Address, LNURL, or Spark address.",
      kind = SET_ROW_BUTTON, button = "Send…", action = CP_SET_ACT, state = ifx s[0].set_wallet_ready then 0 else EL_S_DISABLED};
    y += cp_set_group(s, f, "set.wallet.pay.group", x, y, w, prows[..]) + t.block_gap;
    y += set_section_head(f, "set.wallet.custody.head", x, y, w, "Limits & Custody", "One 12-word BIP-39 seed powers both your Spark wallet and your NIP-06 Nostr identity.") + t.section_gap;
    crows: [3] SetRow;
    crows[0] = SetRow.{id = "set.wallet.limit", name = "Daily spend limit", desc = "Maximum sats allowed per UTC day before refusal.",
      value = wlim, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
    crows[1] = SetRow.{id = "set.wallet.backup", name = "Backup & recovery", desc = "Stored in Keychain (com.openagents.app.spark, this device only). Words are never logged.",
      value = wbak, kind = SET_ROW_BUTTON, button = "Backup…", action = CP_SET_ACT};
    crows[2] = SetRow.{id = "set.wallet.npub", name = "Nostr identity", desc = "NIP-06 key paired with this wallet's seed.",
      value = wnpub, kind = SET_ROW_PLAIN};
    y += cp_set_group(s, f, "set.wallet.custody.group", x, y, w, crows[..]);
  } else if page == CP_PG_USAGE {
    y += cp_settings_usage(s, f, x, y, w);
  } else if page == CP_PG_VOICE {
    y += cp_settings_voice(s, f, x, y, w);
  } else if page == CP_PG_SCHED {
    y += cp_settings_scheduled(s, f, x, y, w);
  } else if page == CP_PG_MCP {
    y += set_page_head(f, "set.title", x, y, w, names[page], "Configure HTTP and stdio Model Context Protocol servers for OpenAgents and connected external harnesses. Bearer tokens are stored in 0600 files and never logged.") + t.block_gap;
    add_one: [1] SetRow;
    add_one[0] = SetRow.{id = "set.mcp.add", name = "Add MCP server", desc = "Connect an HTTP URL or local stdio command. Enabled servers are injected into active workers.",
      kind = SET_ROW_BUTTON, button = "Add server…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.mcp.add.group", x, y, w, add_one[..]) + t.block_gap;
    ms := s[0].mcp_skills[..];
    y += set_section_head(f, "set.mcp.list.head", x, y, w, "Configured servers", ifx ms[0].nservers > 0 then "Toggle servers on or off, sign in via OAuth, or remove them." else "No MCP servers configured yet.") + t.section_gap;
    if ms[0].nservers > 0 {
      mrows: [CP_MCP_MAX] SetRow;
      for i: 0..<ms[0].nservers {
        srv := ms[0].servers[i];
        ib: [32] u8; in_n := el_put(ib[..], 0, "set.mcp.srv."); in_n = el_put_i(ib[..], in_n, i);
        db: [320] u8; dn := 0;
        dn = el_put(db[..], dn, cp_mcp_transport_name(srv.transport));
        dn = el_put(db[..], dn, " · ");
        dn = el_put(db[..], dn, cp_mcp_str(srv.endpoint[..], srv.endpoint_n));
        sb: [160] u8;
        st_lbl := cp_mcp_status_label(srv, sb[..]);
        dn = el_put(db[..], dn, " · ");
        dn = el_put(db[..], dn, st_lbl);
        mrows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
          name = sheet_pool(sh, cp_mcp_str(srv.name[..], srv.name_n)),
          desc = sheet_pool(sh, cast(string) db[0..<dn]),
          kind = SET_ROW_CHOICE, noptions = 4, chosen = ifx srv.enabled then 1 else 0, action = CP_SET_ACT};
        mrows[i].options[0] = "Off";
        mrows[i].options[1] = "On";
        mrows[i].options[2] = "Sign in";
        mrows[i].options[3] = "Remove";
      }
      y += cp_set_group(s, f, "set.mcp.servers.group", x, y, w, mrows[0..<ms[0].nservers]);
    }
  } else if page == CP_PG_SKILLS {
    y += set_page_head(f, "set.title", x, y, w, names[page], "Browse and toggle user (~/.claude/skills) and project (.claude/skills) skills. Type / in the composer to search and insert enabled skills.") + t.block_gap;
    ms := s[0].mcp_skills[..];
    y += set_section_head(f, "set.skills.head", x, y, w, "Installed skills", ifx ms[0].nskills > 0 then "Enabled skills are injected into worker prompts and searchable via / in the composer." else "No skills found in ~/.claude/skills or this repository's .claude/skills.") + t.section_gap;
    if ms[0].nskills > 0 {
      srows: [CP_SKILLS_MAX] SetRow;
      for i: 0..<ms[0].nskills {
        sk := ms[0].skills[i];
        ib: [32] u8; in_n := el_put(ib[..], 0, "set.skill."); in_n = el_put_i(ib[..], in_n, i);
        db: [256] u8; dn := 0;
        dn = el_put(db[..], dn, cp_skill_source_label(sk.source));
        if sk.desc_n > 0 {
          dn = el_put(db[..], dn, " · ");
          dn = el_put(db[..], dn, cp_mcp_str(sk.desc[..], sk.desc_n));
        }
        srows[i] = SetRow.{id = sheet_pool(sh, cast(string) ib[0..<in_n]),
          name = sheet_pool(sh, cp_mcp_str(sk.name[..], sk.name_n)),
          desc = sheet_pool(sh, cast(string) db[0..<dn]),
          kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx sk.enabled then 1 else 0, action = CP_SET_ACT};
        srows[i].options[0] = "Off";
        srows[i].options[1] = "On";
      }
      y += cp_set_group(s, f, "set.skills.group", x, y, w, srows[0..<ms[0].nskills]);
    }
  } else if page == CP_PG_CONNECTIONS {
    y += cp_settings_connections(s, f, x, y, w);
  } else if page == CP_PG_APPEARANCE {
    y += cp_settings_appearance(s, f, x, y, w);
  } else if page == CP_PG_KEYBINDINGS {
    y += cp_settings_keybindings(s, f, x, y, w);
  } else {
    y += set_page_head(f, "set.title", x, y, w, names[CP_PG_ABOUT], "Coder's version and its updates.") + t.block_gap;
    ver := ifx s[0].set_version_n > 0 then sheet_pool(sh, cast(string) s[0].set_version[0..<s[0].set_version_n]) else "";
    one: [1] SetRow;
    one[0] = SetRow.{id = "set.version", name = "Version", desc = "The Coder app on this computer.", value = ver};
    y += cp_set_group(s, f, "set.version.group", x, y, w, one[..]) + t.block_gap;
    y += set_section_head(f, "set.update.head", x, y, w, "Updates", "") + t.section_gap;
    st := s[0].update_state;
    label := ifx s[0].update_label_n > 0 then sheet_pool(sh, cast(string) s[0].update_label[0..<s[0].update_label_n]) else "";
    detail := ifx s[0].update_detail_n > 0 then sheet_pool(sh, cast(string) s[0].update_detail[0..<s[0].update_detail_n]) else "";
    ub: [160] u8; un := 0;
    if st == CP_UPD_AVAILABLE {
      if detail.count > 0 { un = el_put(ub[..], 0, "Update "); un = el_put(ub[..], un, detail); un = el_put(ub[..], un, " is ready to download."); }
      else if label.count > 0 { un = el_put(ub[..], 0, label); }
      else { un = el_put(ub[..], 0, "A new version is ready to download."); }
    } else if st == CP_UPD_DOWNLOADING {
      if detail.count > 0 { un = el_put(ub[..], 0, "Downloading update ("); un = el_put(ub[..], un, detail); un = el_put(ub[..], un, ")…"); }
      else { un = el_put(ub[..], 0, "Downloading the new version."); }
    } else if st == CP_UPD_READY {
      if detail.count > 0 { un = el_put(ub[..], 0, "Update "); un = el_put(ub[..], un, detail); un = el_put(ub[..], un, " is ready. OpenAgents restarts to use it."); }
      else { un = el_put(ub[..], 0, "The new version is downloaded. OpenAgents restarts to use it."); }
    } else if st == CP_UPD_ERROR {
      un = el_put(ub[..], 0, ifx label.count > 0 then label else "The last check failed.");
    } else {
      un = el_put(ub[..], 0, "OpenAgents looks for a new version every 15 minutes.");
    }
    desc := sheet_pool(sh, cast(string) ub[0..<un]);
    button := ifx st == CP_UPD_AVAILABLE then "Update" else ifx st == CP_UPD_READY then "Restart to update" else ifx st == CP_UPD_DOWNLOADING then "Updating…" else "Check now";
    one[0] = SetRow.{id = "set.update", name = "Check for updates", desc = desc, kind = SET_ROW_BUTTON, button = button, action = CP_SET_ACT,
      state = ifx st == CP_UPD_DOWNLOADING then EL_S_DISABLED else 0};
    y += cp_set_group(s, f, "set.update.group", x, y, w, one[..]) + t.block_gap;
    if cp_flag(s, DC_FLAG_SCHEDULED) { y += cp_settings_update_everything(s, f, x, y, w); }
  }
  y += t.page_bottom;
  uiframe_unclip(f);
  s[0].set_content = y - y0 + t.page_top;
  // a search's row: the page scrolls it into view, under the page's top padding
  if s[0].set_target_n > 0 {
    if s[0].set_target_y >= 0 { s[0].set_scroll = scroll_clamp(s[0].set_target_y + at - top - t.page_top, s[0].set_content, view); }
    s[0].set_target_n = 0; s[0].set_due = true;
  }
}
// The settings screen in the window: the list at the chats' sidebar's width, the page beside it.
cp_settings :: (s: [] CoderPage, f: [] UiFrame, window_w: f32, h: f32) {
  spec := cp_sidebar_spec();
  lw := ifx s[0].side_w > 0 then s[0].side_w else spec.default_w;
  most := window_w - spec.main_min;
  if lw > most { lw = ifx most > spec.min_w then most else spec.min_w; }
  if lw > window_w { lw = window_w; }
  s[0].side = lw; s[0].pane_w = 0; s[0].col_w = 0;
  cp_settings_page(s, f, lw, window_w - lw, h);
  cp_settings_list(s, f, lw, h);
  cp_ps_overlay(s, f, window_w, h);
}

// ---------------------------------------------------------------- the host's calls

// Opens settings on a page (0 General, 1 Models, 2 Foreman, 3 Account, 4 About & updates; -1 the
// one shown last), scrolled to a row by its id ("" the top); or closes it (page < -1).
coder_page_settings_open :: (s: [] CoderPage, page: int, row: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  if page < -1 { cp_settings_show(s, false, -1); return; }
  cp_settings_show(s, true, page);
  s[0].set_target_n = ifx row.count <= EL_ID then cp_out(s[0].set_target[..], row) else 0;
  if s[0].set_target_n > 0 { s[0].set_scroll = 0; }
}
// Whether settings is open, and the page it shows (-1: closed).
coder_page_settings_page :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].set_open then s[0].set_page else -1; }
// What the pages show that the host knows: the Claude key's state ("Ends 1a2b", "" not set), the
// OpenRouter key's and the app's version.
coder_page_settings_info :: (s: [] CoderPage, claude: string, openrouter: string, version: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_claude_n = cp_out(s[0].set_claude[..], claude);
  s[0].set_orkey_n = cp_out(s[0].set_orkey[..], openrouter);
  s[0].set_version_n = cp_out(s[0].set_version[..], version);
}
// The Gemini API key's state ("Ends 1a2b", "" not set); also updates model picker availability.
coder_page_settings_gemini :: (s: [] CoderPage, gemini: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  pb: [96] u8; prev := cp_model_save_id(s, pb[..]);
  s[0].set_gemini_n = cp_out(s[0].set_gemini[..], gemini);
  cp_model_restore_id(s, prev);
}
// Local Models status in Settings > Models ("Inkling 2 Mini installed (~20 GB)", "None downloaded"; #13826).
coder_page_settings_local :: (s: [] CoderPage, status: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_local_status_n = cp_out(s[0].set_local_status[..], status);
}
// Executor Models & Weight Modules status, SHA-256 lineage, and truthful badge in Settings > Models (#13924).
coder_page_settings_executor :: (s: [] CoderPage, status: string, lineage: string, badge: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_exec_status_n = cp_out(s[0].set_exec_status[..], status);
  s[0].set_exec_lineage_n = cp_out(s[0].set_exec_lineage[..], lineage);
  s[0].set_exec_badge_n = cp_out(s[0].set_exec_badge[..], badge);
}
// Pylon & Executor Network dashboard + Ch 224 shadow rollout state in Settings > Models (#13928).
coder_page_settings_pylon :: (s: [] CoderPage, state: string, contrib: string, sats: string, release: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_pylon_state_n = cp_out(s[0].set_pylon_state[..], state);
  s[0].set_pylon_contrib_n = cp_out(s[0].set_pylon_contrib[..], contrib);
  s[0].set_pylon_sats_n = cp_out(s[0].set_pylon_sats[..], sats);
  s[0].set_pylon_release_n = cp_out(s[0].set_pylon_release[..], release);
}
// Bitcoin/Lightning Wallet status in Settings > Wallet (#13900).
coder_page_settings_wallet :: (s: [] CoderPage, status: string, balance: string, addr: string, npub: string, limit: string, backup: string, history: string, ready: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_wallet_status_n = cp_out(s[0].set_wallet_status[..], status);
  s[0].set_wallet_balance_n = cp_out(s[0].set_wallet_balance[..], balance);
  s[0].set_wallet_addr_n = cp_out(s[0].set_wallet_addr[..], addr);
  s[0].set_wallet_npub_n = cp_out(s[0].set_wallet_npub[..], npub);
  s[0].set_wallet_limit_n = cp_out(s[0].set_wallet_limit[..], limit);
  s[0].set_wallet_backup_n = cp_out(s[0].set_wallet_backup[..], backup);
  s[0].set_wallet_history_n = cp_out(s[0].set_wallet_history[..], history);
  s[0].set_wallet_ready = ready;
}
// The agent instructions' state for General's row ("Default", "Edited", "Off (empty)"; #13808).
coder_page_settings_instructions :: (s: [] CoderPage, words: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_instr_n = cp_out(s[0].set_instr[..], words);
}
// The custom system prompt's state and 1-line preview ("Off", "Active", "Active (over 8 KB)").
coder_page_settings_custom_prompt :: (s: [] CoderPage, words: string, preview: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_sysprompt_n = cp_out(s[0].set_sysprompt[..], words);
  s[0].set_sysprompt_preview_n = cp_out(s[0].set_sysprompt_preview[..], preview);
}
// Antigravity status, review mode (0 Auto, 1 Default, 2 Plan), model/effort and auth/profile summary (#13803).
coder_page_settings_agy :: (s: [] CoderPage, status: string, mode: int, model: string, auth: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_agy_status_n = cp_out(s[0].set_agy_status[..], status);
  s[0].set_agy_mode = ifx mode >= 0 && mode <= 2 then mode else 0;
  s[0].set_agy_model_n = cp_out(s[0].set_agy_model[..], model);
  s[0].set_agy_auth_n = cp_out(s[0].set_agy_auth[..], auth);
}
// The Antigravity review mode a press on Models' page chose (CP_ASK_AGY_MODE).
coder_page_settings_agy_mode :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].set_agy_mode else 0; }
// The tier a press on Foreman's page chose (CP_ASK_TIER).
coder_page_settings_tier :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].set_tier else 0; }
// Esc in settings: a search with words is emptied and keeps the keyboard. False when it was empty.
coder_page_search_clear :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].set_open || s[0].set_query_n == 0 { return false; }
  coder_page_search_set(s, ""); s[0].fld[0].kb = CP_KB_SEARCH;
  return true;
}
// The search's text after an edit: the list shows what it finds.
coder_page_search_set :: (s: [] CoderPage, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_query_n = cp_out(s[0].set_query[..], text); s[0].set_list_scroll = 0;
}
// Return in the search: its best result opens. False when it found nothing.
coder_page_search_submit :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].set_open { return false; }
  hits: [1] int;
  if cp_set_hits_flags(cp_set_query(s), hits[..], s[0].flags) < 1 { return false; }
  es := cp_set_entries(); e := es[hits[0]];
  cp_settings_show(s, true, e.page);
  s[0].set_target_n = cp_out(s[0].set_target[..], e.id); s[0].set_scroll = 0;
  return true;
}

#test "settings: the search ranks a name's start, then a word's start, then any match; terms count too" {
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  n := cp_set_hits("model", hits[..]);
  #assert n >= 3 && es[hits[0]].name == "Models" && (es[hits[1]].name == "Model for OpenAgents" || es[hits[1]].name == "Model for sub-agents");
  n = cp_set_hits("KEY", hits[..]);
  #assert n >= 3 && (es[hits[0]].name == "Keybindings" || es[hits[0]].name == "Gemini API key" || es[hits[0]].name == "Claude key" || es[hits[0]].name == "OpenRouter key");
  n = cp_set_hits("zoom", hits[..]);
  #assert n == 1 && es[hits[0]].id == "set.zoom";
  #assert cp_set_hits("", hits[..]) == 0 && cp_set_hits("nothing like this", hits[..]) == 0;
}

cp_set_test_frame :: (s: [] CoderPage, w: f32, h: f32) -> bool {
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], w, h);
  return uiframe_end(f[..], s[0].surface[..]);
}
cp_set_test_row :: (s: [] CoderPage, id: string) -> El {
  i := surface_find(s[0].surface[..], id);
  if i < 0 { return El.{}; }
  return surface_rows(s[0].surface[..]).rows[i];
}
#test "settings: the gear opens the list in the sidebar's place at its width, Back closes it, and the chat stays" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_sides_set(s, 300, 0);
  h: f32 = 700;
  #assert cp_set_test_frame(s, 1200, h);
  gear := cp_set_test_row(s, "coder.me.settings");
  #assert gear.action == CP_SET_TOGGLE && gear.y + gear.h <= h && gear.x + gear.w <= s[0].side;
  s[0].scroll = 40;
  #assert cp_settings_press(s, CP_SET_TOGGLE, "coder.me.settings") && s[0].set_open && coder_page_action(s) == CP_ASK_SETTINGS;
  #assert cp_set_test_frame(s, 1200, h);
  #assert s[0].side == s[0].side_w && surface_find(s[0].surface[..], "coder.composer") < 0;
  back := cp_set_test_row(s, "set.back");
  #assert back.action == CP_SET_BACK && back.x < s[0].side;
  for i: 0..<CP_SET_PAGES {
    pb: [16] u8; n := el_put(pb[..], 0, "set.page."); n = el_put_i(pb[..], n, i);
    #assert cp_set_test_row(s, cast(string) pb[0..<n]).action == CP_SET_PAGE;
  }
  me := cp_set_test_row(s, "set.me");
  t := cp_skin().set;
  #assert me.action == CP_SET_TOGGLE && me.w <= 32.0f32 && me.y >= h - t.account - t.list_pad - 0.01 && me.y + me.h <= h - t.list_pad + 0.01;
  #assert abs(me.y - gear.y) < 0.01;   // the settings footer stays where it was
  #assert cp_set_test_row(s, "set.title").w > 0 && cp_set_test_row(s, "set.folder.a").action == CP_SET_ACT;
  // Back: the chat as it was
  #assert cp_settings_press(s, CP_SET_BACK, "set.back") && !s[0].set_open && s[0].scroll == 40;
  #assert coder_page_settings_page(s) == -1;
}
#test "settings: every page draws its rows, the search opens a row's page, and Account keeps its card beside or over the rows" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_info(s, "Ends 1a2b", "", "0.1.0 (1)");
  coder_page_settings_open(s, CP_PG_MODELS, "");
  #assert coder_page_settings_page(s) == CP_PG_MODELS && cp_set_test_frame(s, 1200, 700);
  #assert cp_set_test_row(s, "set.claude.a").action == CP_SET_ACT && cp_set_test_row(s, "set.or.main").action == CP_SET_ACT;
  coder_page_settings_open(s, CP_PG_FOREMAN, "");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.tier.2").action == CP_SET_ACT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.tier.2") && coder_page_action(s) == CP_ASK_TIER && coder_page_settings_tier(s) == 2;
  coder_page_settings_open(s, CP_PG_ABOUT, "");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.update.a").action == CP_SET_ACT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.update.a") && coder_page_action(s) == CP_ASK_CHECK_UPDATES;
  coder_page_settings_open(s, CP_PG_ACCOUNT, "");
  #assert cp_set_test_frame(s, 1200, 700);
  card := cp_set_test_row(s, "set.card"); you := cp_set_test_row(s, "set.login");
  #assert card.w > 0 && you.action == CP_SET_ACT && card.x > you.x;   // wide: the card beside the rows
  #assert cp_set_test_frame(s, 760, 700);
  card = cp_set_test_row(s, "set.card"); you = cp_set_test_row(s, "set.login");
  #assert card.y + card.h < you.y;   // narrow: over them
  #assert cp_settings_press(s, CP_SET_ACT, "set.login") && coder_page_action(s) == CP_ASK_LOGIN;
  // the search: results in the list, Return opens the best one's page
  coder_page_search_set(s, "zoom");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.hit.2").action == CP_SET_HIT;
  #assert coder_page_search_submit(s) && s[0].set_page == CP_PG_GENERAL;
  #assert cp_set_test_frame(s, 1200, 700) && s[0].set_target_n == 0;
  #assert s[0].set_box[2] > 0 && cp_ed_which(s) == -1;   // the search's box; the keyboard with neither field until a press or Command-F
  coder_page_settings_open(s, -2, "");
  #assert !s[0].set_open && s[0].set_query_n == 0 && cp_ed_which(s) == CP_ED_COMPOSER;
}
