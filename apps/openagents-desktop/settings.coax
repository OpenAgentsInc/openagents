// Coder's settings screen (GitHub #13726): Zeron's desktop settings, drawn by
// the app set's settings parts (components/app/settings.coax) in the skin's
// settings measures (skin.set, Zeron's in points, divided by the page's
// scale in cp_skin). The list of pages takes the chats' sidebar's place at
// its width and edge: Back to chats, the search field (⌘F), the grouped
// pages and the account row at its foot; the page stands beside it. Back to
// chats, Esc, ⌘[ and the gear go back to the chat that was shown, as it was.
//
// What a row does reaches the host as an ask (CP_ASK_*): the working folder,
// the text size, the keys, Foreman's tier, its audit log and history, the
// log in page and the update check. The host tells the page what it shows
// with coder_page_settings_info. The page, its rows and the search are here;
// the host's menus (Coder > Settings…, and the old dialogs' items) open them.
//   coax/bin/coax test apps/coder-desktop/page.coax --library

#load "../../components/app/settings.coax";

CP_PG_GENERAL :: 0; CP_PG_MODELS :: 1; CP_PG_FOREMAN :: 2; CP_PG_ACCOUNT :: 3; CP_PG_ABOUT :: 4;
CP_SET_PAGES :: 5;
CP_SET_NAME :: [CP_SET_PAGES] string.["General", "Models", "Foreman", "Account", "About & updates"];
CP_SET_ICON :: [CP_SET_PAGES] int.[ICON_SET_GENERAL, ICON_SET_MODELS, ICON_SET_FOREMAN, ICON_SET_ACCOUNT, ICON_SET_ABOUT];
// The list's groups, in order, and their pages (Zeron's names where they mean the same).
CP_SET_GROUPS :: 3;
CP_SET_GROUP :: [CP_SET_GROUPS] string.["Personal", "Agents", "Coder"];
CP_SET_ORDER :: [CP_SET_PAGES] int.[CP_PG_GENERAL, CP_PG_ACCOUNT, CP_PG_MODELS, CP_PG_FOREMAN, CP_PG_ABOUT];
CP_SET_IN :: [CP_SET_PAGES] int.[0, 0, 1, 1, 2];   // the group of each place in CP_SET_ORDER
CP_SET_QUERY :: 64;           // bytes of a search kept
CP_SET_HITS :: 8;             // search results shown
CP_LOGIN_URL :: "https://openagents.com/login";

// What the search finds: a page or one of its rows, its name and the words it also answers to.
CpSetEntry :: struct { page: int; id: string; name: string; terms: string; }
CP_SET_ENTRIES :: 25;
cp_set_entries :: () -> [CP_SET_ENTRIES] CpSetEntry {
  return [CP_SET_ENTRIES] CpSetEntry.[
    CpSetEntry.{page = CP_PG_GENERAL, id = "", name = "General", terms = "preferences"},
    CpSetEntry.{page = CP_PG_GENERAL, id = "set.folder", name = "Working folder", terms = "folder directory project open cwd"},
    CpSetEntry.{page = CP_PG_GENERAL, id = "set.zoom", name = "Text size", terms = "zoom bigger smaller font scale"},
    CpSetEntry.{page = CP_PG_MODELS, id = "", name = "Models", terms = "providers keys gemini antigravity agy"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.gemini", name = "Gemini API key", terms = "gemini google api key microcoder aistudio"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.gemini.auth", name = "Gemini sign-in", terms = "vertex adc gcloud google cloud gemini sign-in credentials"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.claude", name = "Claude key", terms = "anthropic api token login sub-agents"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.or", name = "OpenRouter key", terms = "openrouter api"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.or.main", name = "Model for Microcoder", terms = "openrouter model main"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.or.sub", name = "Model for sub-agents", terms = "openrouter model level"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.agy.status", name = "Antigravity CLI", terms = "antigravity agy binary path version cli status"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.agy.mode", name = "Antigravity review mode", terms = "antigravity agy mode auto default plan review"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.agy.model", name = "Antigravity model & effort", terms = "antigravity agy model effort low medium high gemini"},
    CpSetEntry.{page = CP_PG_MODELS, id = "set.agy.auth", name = "Antigravity sign-in & profile", terms = "antigravity agy auth google login profile adc env"},
    CpSetEntry.{page = CP_PG_FOREMAN, id = "", name = "Foreman", terms = "manager"},
    CpSetEntry.{page = CP_PG_FOREMAN, id = "set.tier", name = "Permission tier", terms = "observe managed auto autonomous read-only"},
    CpSetEntry.{page = CP_PG_FOREMAN, id = "set.audit", name = "Audit log", terms = "history actions"},
    CpSetEntry.{page = CP_PG_FOREMAN, id = "set.clear", name = "Clear history", terms = "forget delete"},
    CpSetEntry.{page = CP_PG_ACCOUNT, id = "set.login", name = "Account", terms = "log in login profile you me"},
    CpSetEntry.{page = CP_PG_ABOUT, id = "set.version", name = "Version", terms = "about build"},
    CpSetEntry.{page = CP_PG_ABOUT, id = "set.update", name = "Check for updates", terms = "update upgrade release install restart"},
    CpSetEntry.{page = CP_PG_ABOUT, id = "", name = "About & updates", terms = "about"},
    CpSetEntry.{page = CP_PG_GENERAL, id = "set.exp", name = "Experimental features", terms = "experimental labs flag account login gym foreman"},
    CpSetEntry.{page = CP_PG_GENERAL, id = "set.instr", name = "Agent instructions", terms = "system prompt instructions rules commit push git agents.md claude.md default"},
    CpSetEntry.{page = CP_PG_GENERAL, id = "set.instr.reset", name = "Reset agent instructions", terms = "default restore instructions system prompt"}];
}
// Whether a page shows: Foreman's and Account's are experimental features (General's last row).
cp_set_page_ok :: (experimental: bool, page: int) -> bool { return experimental || (page != CP_PG_FOREMAN && page != CP_PG_ACCOUNT); }
cp_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
// Where needle starts in text, by letters (any case); -1 when it doesn't.
cp_find_ci :: (text: string, needle: string) -> int {
  if needle.count == 0 || needle.count > text.count { return -1; }
  for i: 0..<text.count - needle.count + 1 {
    if cp_starts_ci(text, i, needle) { return i; }
  }
  return -1;
}
// Whether text has needle at `at`, by letters (any case).
cp_starts_ci :: (text: string, at: int, needle: string) -> bool {
  if at < 0 || at + needle.count > text.count { return false; }
  for j: 0..<needle.count { if cp_lower(text[at + j]) != cp_lower(needle[j]) { return false; } }
  return true;
}
// How well an entry answers a search (Zeron's ranking: the name's start, then a word's start in
// it, then anywhere in it or its words); 0 not at all.
cp_set_score :: (e: CpSetEntry, q: string) -> int {
  if cp_starts_ci(e.name, 0, q) { return 3; }
  for i: 1..<e.name.count { if e.name[i - 1] == ' ' && cp_starts_ci(e.name, i, q) { return 2; } }
  if cp_find_ci(e.name, q) >= 0 || cp_find_ci(e.terms, q) >= 0 { return 1; }
  return 0;
}
// The search's results, best first, into out (entry indexes), every page's. Returns how many.
cp_set_hits :: (q: string, out: [] int) -> int { return cp_set_hits_in(q, out, true); }
// The same, leaving out the experimental pages' entries unless experimental.
cp_set_hits_in :: (q: string, out: [] int, experimental: bool) -> int {
  if q.count == 0 { return 0; }
  es := cp_set_entries(); n := 0;
  for want: 0..<3 {
    score := 3 - want;
    for e, i: es { if n < out.count && cp_set_page_ok(experimental, e.page) && cp_set_score(e, q) == score { out[n] = i; n += 1; } }
  }
  return n;
}
cp_set_query :: (s: [] CoderPage) -> string { return cast(string) s[0].set_query[0..<s[0].set_query_n]; }

// Opens settings on a page (-1: the one shown last), or closes it (`open` false). The chat that
// was shown stays as it was. The keyboard leaves the composer while it is open (Command-F or a
// press gives it to the search) and comes back to it after; the host is asked to move it.
cp_settings_show :: (s: [] CoderPage, open: bool, page: int) {
  if open && page >= 0 && page < CP_SET_PAGES { if page != s[0].set_page { s[0].set_scroll = 0; } s[0].set_page = page; }
  if open && !cp_set_page_ok(s[0].experimental, s[0].set_page) { s[0].set_page = CP_PG_GENERAL; s[0].set_scroll = 0; }
  if open == s[0].set_open { return; }
  s[0].set_open = open; s[0].model_menu = false;
  if !open { s[0].set_query_n = 0; s[0].set_target_n = 0; }
  s[0].fld[0].kb = ifx open then CP_KB_NONE else CP_KB_COMPOSER;
  s[0].ask = CP_ASK_SETTINGS;
}
cp_settings_press :: (s: [] CoderPage, act: int, id: string) -> bool {
  if act == CP_SET_TOGGLE { cp_settings_show(s, !s[0].set_open, -1); return true; }
  if act == CP_SET_BACK { cp_settings_show(s, false, -1); return true; }
  if act == CP_SET_ACCOUNT { cp_settings_show(s, true, CP_PG_ACCOUNT); return true; }
  if act == CP_SET_SEARCH { cp_ed_focus(s, CP_KB_SEARCH); return true; }
  if act == CP_SET_PAGE {
    p := cp_number(id, "set.page.");
    if p < 0 || p >= CP_SET_PAGES { return false; }
    cp_settings_show(s, true, p); return true;
  }
  if act == CP_SET_HIT {
    n := cp_number(id, "set.hit.");
    es := cp_set_entries();
    if n < 0 || n >= CP_SET_ENTRIES { return false; }
    cp_settings_show(s, true, es[n].page);
    s[0].set_target_n = cp_out(s[0].set_target[..], es[n].id); s[0].set_scroll = 0;
    return true;
  }
  if act != CP_SET_ACT { return false; }
  if id == "set.folder.a" { if cp_running(s) { return false; } s[0].ask = CP_ASK_FOLDER; return true; }
  if id == "set.zoom.a" { s[0].ask = CP_ASK_ZOOM_OUT; return true; }
  if id == "set.zoom.b" { s[0].ask = CP_ASK_ZOOM_IN; return true; }
  ex := cp_number(id, "set.exp.");
  if ex == 0 || ex == 1 { coder_page_experimental_set(s, ex == 1); s[0].ask = CP_ASK_EXPERIMENTAL; return true; }
  if id == "set.instr.a" { s[0].ask = CP_ASK_INSTRUCTIONS; return true; }
  if id == "set.instr.reset.a" { s[0].ask = CP_ASK_INSTRUCTIONS_RESET; return true; }
  if id == "set.gemini.a" { s[0].ask = CP_ASK_GEMINI_KEY; return true; }
  if id == "set.local.a" { s[0].ask = CP_ASK_LOCAL_MODELS; return true; }
  if id == "set.claude.a" { s[0].ask = CP_ASK_CLAUDE_KEY; return true; }
  if id == "set.or.a" || id == "set.or.main" || id == "set.or.sub" { s[0].ask = CP_ASK_OPENROUTER; return true; }
  if id == "set.agy.status.a" || id == "set.agy.model" { s[0].ask = CP_ASK_AGY; return true; }
  amode := cp_number(id, "set.agy.mode.");
  if amode >= 0 && amode <= 2 { s[0].set_agy_mode = amode; s[0].ask = CP_ASK_AGY_MODE; return true; }
  if id == "set.agy.auth.a" || id == "set.agy.auth" { s[0].ask = CP_ASK_AGY_AUTH; return true; }
  if id == "set.update.a" {
    st := s[0].update_state;
    s[0].ask = ifx st == CP_UPD_AVAILABLE || st == CP_UPD_READY then CP_ASK_UPDATE else CP_ASK_CHECK_UPDATES;
    return true;
  }
  if !s[0].experimental { return false; }   // Foreman's rows and Log in below are experimental
  tier := cp_number(id, "set.tier.");
  if tier >= 0 && tier <= CP_FOREMAN_TIER_AUTO { s[0].set_tier = tier; s[0].ask = CP_ASK_TIER; return true; }
  if id == "set.audit.a" { s[0].ask = CP_ASK_AUDIT; return true; }
  if id == "set.clear.a" { s[0].ask = CP_ASK_CLEAR_FOREMAN; return true; }
  if id == "set.login" { s[0].ask = CP_ASK_LOGIN; return true; }
  return false;
}

// ---------------------------------------------------------------- drawing

// The list of pages from x 0, lw wide, the window's height h.
cp_settings_list :: (s: [] CoderPage, f: [] UiFrame, lw: f32, h: f32) {
  k := f[0].skin; t := k.set; sh := f[0].sheet;
  sheet_fill(sh, 0, 0, lw, h, 0, ifx k.sidebar.a > 0 then k.sidebar else k.surface);
  x := t.list_pad; w := lw - 2 * t.list_pad;
  y := cp_bar(s) + t.list_pad;   // under the window's title bar (page/layout/titlebar.coax)
  y += set_nav_row(f, "set.back", x, y, w, ICON_SET_BACK, "Back to chats", false, true, CP_SET_BACK) + t.list_gap;
  keys := [2] string.["⌘", "F"];
  q := cp_set_query(s);
  _ := set_search(f, "set.search", x, y, w, "Search settings", q.count == 0, keys[..], CP_SET_SEARCH);
  b := set_search_box(t, x, y, w);
  s[0].set_box[0] = b.x; s[0].set_box[1] = b.y; s[0].set_box[2] = b.w; s[0].set_box[3] = b.h;
  cp_ed_draw(s, f, CP_ED_SEARCH, b.x, b.y, b.w, b.h, "");   // its words, caret and selection (page/editor.coax)
  y += t.search_h + t.list_gap;
  foot := h - t.list_pad - t.account - t.account_top;
  view := foot - y;
  s[0].set_list_view = view;
  uiframe_clip(f, 0, y, lw, foot);
  at := scroll_clamp(s[0].set_list_scroll, s[0].set_list_content, view);
  ry := y - at;
  if q.count > 0 {
    // the results stand in the pages' place
    hits: [CP_SET_HITS] int;
    n := cp_set_hits_in(q, hits[..], s[0].experimental);
    es := cp_set_entries(); icons := CP_SET_ICON;
    ry += set_nav_head(f, "set.found", x, ry, w, ifx n > 0 then "Settings found" else "No settings match.") + t.list_gap;
    hb: [24] u8;
    for i: 0..<n {
      e := es[hits[i]];
      hn := el_put(hb[..], 0, "set.hit."); hn = el_put_i(hb[..], hn, hits[i]);
      ry += set_nav_row(f, sheet_pool(sh, cast(string) hb[0..<hn]), x, ry, w, icons[e.page], e.name, false, false, CP_SET_HIT) + t.list_gap;
    }
  } else {
    names := CP_SET_NAME; icons := CP_SET_ICON; order := CP_SET_ORDER; within := CP_SET_IN; groups := CP_SET_GROUP;
    gb: [24] u8; pb: [24] u8;
    headed := -1;   // the group whose heading is drawn last: a group with no page shown has none
    for i: 0..<CP_SET_PAGES {
      p := order[i];
      if !cp_set_page_ok(s[0].experimental, p) { continue; }
      if within[i] != headed {
        headed = within[i];
        gn := el_put(gb[..], 0, "set.group."); gn = el_put_i(gb[..], gn, within[i]);
        ry += set_nav_head(f, sheet_pool(sh, cast(string) gb[0..<gn]), x, ry, w, groups[within[i]]) + t.list_gap;
      }
      pn := el_put(pb[..], 0, "set.page."); pn = el_put_i(pb[..], pn, p);
      ry += set_nav_row(f, sheet_pool(sh, cast(string) pb[0..<pn]), x, ry, w, icons[p], names[p], p == s[0].set_page, false, CP_SET_PAGE) + t.list_gap;
    }
  }
  uiframe_unclip(f);
  s[0].set_list_content = ry + at - y;
  _ := set_account_row(f, "set.me", x, h - t.list_pad - t.account, w, "Local", "L", s[0].set_page == CP_PG_ACCOUNT, true, CP_SET_ACCOUNT, CP_SET_TOGGLE);
  set_nav_edge(f, lw, 0, h, s[0].hover == 1 || s[0].drag == 1);
}
// One row, and where it is when the search asked for it.
cp_set_row :: (s: [] CoderPage, f: [] UiFrame, r: SetRow, x: f32, y: f32, w: f32) -> f32 {
  if s[0].set_target_n > 0 && r.id == cast(string) s[0].set_target[0..<s[0].set_target_n] { s[0].set_target_y = y; }
  return set_row(f, r, x, y, w);
}
// A group (card) of rows, marking the one the search asked for.
cp_set_group :: (s: [] CoderPage, f: [] UiFrame, id: string, x: f32, y: f32, w: f32, rows: [] SetRow) -> f32 {
  t := f[0].skin.set;
  if s[0].set_target_n > 0 {
    ry := y + t.card_edge;
    for r, i: rows {
      if i > 0 { ry += t.card_edge; }
      if r.id == cast(string) s[0].set_target[0..<s[0].set_target_n] { s[0].set_target_y = ry; }
      ry += set_row_fit(f, r, w - 2 * t.card_edge).h;
    }
  }
  return set_group(f, id, x, y, w, rows);
}
cp_zoom_text :: (s: [] CoderPage, out: [] u8) -> string {
  n := el_put_i(out, 0, cast(int) floor(CP_ZOOMS[s[0].zoom] * 100 + 0.5)); n = el_put(out, n, "%");
  return cast(string) out[0..<n];
}
cp_or_shown :: (v: string) -> string { return ifx v.count > 0 then v else "None"; }
// The page that is open, from x, w wide, the window's height h.
cp_settings_page :: (s: [] CoderPage, f: [] UiFrame, px: f32, pw: f32, h: f32) {
  k := f[0].skin; t := k.set; sh := f[0].sheet;
  top := cp_bar(s);   // under the window's title bar (page/layout/titlebar.coax)
  view := h - top;
  s[0].set_view = view;
  c := set_column(t, px, pw);
  x := c.x; w := c.w;
  at := scroll_clamp(s[0].set_scroll, s[0].set_content, view);
  uiframe_clip(f, px, top, px + pw, h);
  y0 := top + t.page_top - at; y := y0;
  s[0].set_target_y = -1;
  page := s[0].set_page; names := CP_SET_NAME;
  nb: [CP_SET_QUERY + 16] u8;
  if page == CP_PG_GENERAL {
    y += set_page_head(f, "set.title", x, y, w, names[page], "How Coder works on this computer.") + t.block_gap;
    rows: [3] SetRow;
    folder := ifx s[0].folder_n > 0 then sheet_pool(sh, cast(string) s[0].folder[0..<s[0].folder_n]) else "Home folder";
    rows[0] = SetRow.{id = "set.folder", name = "Working folder", desc = "Where Microcoder runs its commands. New chats start here too.",
      value = folder, kind = SET_ROW_BUTTON, button = "Choose…", action = CP_SET_ACT, state = ifx cp_running(s) then EL_S_DISABLED else 0};
    rows[1] = SetRow.{id = "set.zoom", name = "Text size", desc = "Bigger and smaller words everywhere in Coder.",
      value = sheet_pool(sh, cp_zoom_text(s, nb[..])), kind = SET_ROW_STEPPER, button = "−", button2 = "+", action = CP_SET_ACT, action2 = CP_SET_ACT};
    rows[2] = SetRow.{id = "set.exp", name = "Experimental features", desc = "Log in, account, Gym and Foreman.",
      kind = SET_ROW_CHOICE, noptions = 2, chosen = ifx s[0].experimental then 1 else 0, action = CP_SET_ACT};
    rows[2].options[0] = "Off"; rows[2].options[1] = "On";
    y += cp_set_group(s, f, "set.general.group", x, y, w, rows[..]) + t.block_gap;
    // what every agent is told in every chat (~/.openagents/instructions.md, GitHub #13808)
    y += set_section_head(f, "set.instr.head", x, y, w, "Agent instructions", "What Microcoder, Claude and Antigravity are told in every chat, in every folder. A repository's own AGENTS.md wins where they differ.") + t.section_gap;
    instr := ifx s[0].set_instr_n > 0 then sheet_pool(sh, cast(string) s[0].set_instr[0..<s[0].set_instr_n]) else "Default";
    irows: [2] SetRow;
    irows[0] = SetRow.{id = "set.instr", name = "Agent instructions", desc = "Kept in ~/.openagents/instructions.md. The default: commit finished work and push it in a git repository.",
      value = instr, kind = SET_ROW_BUTTON, button = "Edit…", action = CP_SET_ACT};
    irows[1] = SetRow.{id = "set.instr.reset", name = "Reset to default", desc = "Puts OpenAgents' default instructions back in place of yours.",
      kind = SET_ROW_BUTTON, button = "Reset…", action = CP_SET_ACT, danger = true};
    y += cp_set_group(s, f, "set.instr.group", x, y, w, irows[..]);
  } else if page == CP_PG_MODELS {
    y += set_page_head(f, "set.title", x, y, w, names[page], "The keys and models Microcoder and its sub-agents run on.") + t.block_gap;
    gemini := ifx s[0].set_gemini_n > 0 then sheet_pool(sh, cast(string) s[0].set_gemini[0..<s[0].set_gemini_n]) else "Not set";
    y += set_section_head(f, "set.gemini.head", x, y, w, "Gemini", "Microcoder runs Gemini models on Vertex AI when this Mac has a Google Cloud service account, else on a Gemini API key.") + t.section_gap;
    gauth := ifx s[0].set_gauth_n > 0 then sheet_pool(sh, cast(string) s[0].set_gauth[0..<s[0].set_gauth_n]) else "None found";
    gone: [2] SetRow;
    gone[0] = SetRow.{id = "set.gemini.auth", name = "Signed in with",
      desc = "Vertex AI: the service account in ~/.openagents/coder/antigravity.env or ~/work/.secrets/vertex-sa-inference.json, through gcloud. Else the key below.",
      value = gauth, kind = SET_ROW_PLAIN};
    gone[1] = SetRow.{id = "set.gemini", name = "Gemini API key", desc = "Paste a key from Google AI Studio. Kept in a file only you can read.",
      value = gemini, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.gemini.group", x, y, w, gone[..]) + t.block_gap;
    claude := ifx s[0].set_claude_n > 0 then sheet_pool(sh, cast(string) s[0].set_claude[0..<s[0].set_claude_n]) else "Not set";
    y += set_section_head(f, "set.claude.head", x, y, w, "Claude", "") + t.section_gap;
    one: [1] SetRow;
    one[0] = SetRow.{id = "set.claude", name = "Claude key", desc = "Claude sub-agents use it in place of the Claude Code login on this computer.",
      value = claude, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.claude.group", x, y, w, one[..]) + t.block_gap;
    orkey := ifx s[0].set_orkey_n > 0 then sheet_pool(sh, cast(string) s[0].set_orkey[0..<s[0].set_orkey_n]) else "Not set";
    y += set_section_head(f, "set.or.head", x, y, w, "OpenRouter", "Run Microcoder or its sub-agents on an OpenRouter model that takes a strict JSON schema.") + t.section_gap;
    rows: [3] SetRow;
    rows[0] = SetRow.{id = "set.or", name = "OpenRouter key", desc = "Kept in a file only you can read.", value = orkey, kind = SET_ROW_BUTTON, button = "Change…", action = CP_SET_ACT};
    rows[1] = SetRow.{id = "set.or.main", name = "Model for Microcoder", desc = "Joins the composer's model picker.", value = sheet_pool(sh, cp_or_shown(cp_or_main(s))), kind = SET_ROW_LINK, action = CP_SET_ACT};
    rows[2] = SetRow.{id = "set.or.sub", name = "Model for sub-agents", desc = "One more level Microcoder can hand tasks to.", value = sheet_pool(sh, cp_or_shown(cp_or_sub(s))), kind = SET_ROW_LINK, action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.or.group", x, y, w, rows[..]) + t.block_gap;
    agy_st := ifx s[0].set_agy_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_agy_status[0..<s[0].set_agy_status_n]) else "Not installed";
    // the model agy really opens a session on with these settings, not "Default" (agyworker --probe)
    agy_shown := cp_agy_shown(s);
    agy_mod := sheet_pool(sh, ifx agy_shown.count > 0 then agy_shown else "Checking…");
    agy_au := ifx s[0].set_agy_auth_n > 0 then sheet_pool(sh, cast(string) s[0].set_agy_auth[0..<s[0].set_agy_auth_n]) else "Isolated profile";
    amode := ifx s[0].set_agy_mode >= 0 && s[0].set_agy_mode <= 2 then s[0].set_agy_mode else 0;
    y += set_section_head(f, "set.agy.head", x, y, w, "Antigravity", "Run tasks with the Antigravity CLI (agy >= 1.5.0) in an isolated profile.") + t.section_gap;
    arows: [4] SetRow;
    arows[0] = SetRow.{id = "set.agy.status", name = "Antigravity CLI", desc = "Binary path and detected version (requires >= 1.5.0).",
      value = agy_st, kind = SET_ROW_BUTTON, button = "Configure…", action = CP_SET_ACT};
    arows[1] = SetRow.{id = "set.agy.mode", name = "Review mode",
      desc = ifx amode == 1 then "Pause for review before risky edits." else ifx amode == 2 then "Propose a plan before making edits." else "Apply edits and run commands automatically.",
      kind = SET_ROW_CHOICE, noptions = 3, chosen = amode, action = CP_SET_ACT};
    arows[1].options[0] = "Auto"; arows[1].options[1] = "Default"; arows[1].options[2] = "Plan";
    arows[2] = SetRow.{id = "set.agy.model", name = "Model & effort", desc = ifx s[0].set_agy_model_n == 0 || cast(string) s[0].set_agy_model[0..<s[0].set_agy_model_n] == "Default" then "None set: agy's own default model, at medium effort, which streams its thinking. Set a model id and effort to change it." else "The Antigravity model id and reasoning effort (low, medium, high) you set.",
      value = agy_mod, kind = SET_ROW_LINK, action = CP_SET_ACT};
    arows[3] = SetRow.{id = "set.agy.auth", name = "Sign-in & profile", desc = "Google sign-in, isolated profile directory, or antigravity.env ADC.",
      value = agy_au, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.agy.group", x, y, w, arows[..]) + t.block_gap;
    local_st := ifx s[0].set_local_status_n > 0 then sheet_pool(sh, cast(string) s[0].set_local_status[0..<s[0].set_local_status_n]) else "None downloaded";
    y += set_section_head(f, "set.local.head", x, y, w, "Local Models", "Download, verify, and manage local Psionic Metal checkpoints (~/.openagents/models).") + t.section_gap;
    lrows: [1] SetRow;
    lrows[0] = SetRow.{id = "set.local", name = "Inkling 2 Mini (Local)", desc = "26.4B total / 3.4B active looped MoE (~20 GB NVFP4+MXFP8). Requires >= 32 GB Apple Silicon Mac.",
      value = local_st, kind = SET_ROW_BUTTON, button = "Manage…", action = CP_SET_ACT};
    y += cp_set_group(s, f, "set.local.group", x, y, w, lrows[..]);
  } else if page == CP_PG_FOREMAN {
    y += set_page_head(f, "set.title", x, y, w, names[page], "How much Foreman may do across your chats.") + t.block_gap;
    tier := s[0].foreman_tier;
    rows: [3] SetRow;
    rows[0] = SetRow.{id = "set.tier", name = "Permission tier",
      desc = ifx tier == CP_FOREMAN_TIER_OBSERVE then "Foreman reads chats and changes nothing." else ifx tier == CP_FOREMAN_TIER_AUTO then "Foreman starts, sends to and stops any chat." else "Foreman changes only the chats it manages.",
      kind = SET_ROW_CHOICE, noptions = 3, chosen = tier, action = CP_SET_ACT};
    rows[0].options[0] = "Observe"; rows[0].options[1] = "Managed"; rows[0].options[2] = "Auto";
    rows[1] = SetRow.{id = "set.audit", name = "Audit log", desc = "Every step Foreman took, in a file.", kind = SET_ROW_BUTTON, button = "Open", action = CP_SET_ACT};
    rows[2] = SetRow.{id = "set.clear", name = "Clear history", desc = "Removes the Foreman conversation. Managed chats stay.", kind = SET_ROW_BUTTON, button = "Clear…", action = CP_SET_ACT, danger = true};
    y += cp_set_group(s, f, "set.foreman.group", x, y, w, rows[..]);
  } else if page == CP_PG_ACCOUNT {
    narrow := w < t.aside_narrow;
    y += set_page_head(f, "set.title", x, y, w, names[page], "Coder works on this computer without an account. Log in to use OpenAgents on the web.") + t.block_gap;
    gw := ifx narrow then w else w - t.block_gap - t.aside_w;
    gx := x;
    if narrow {
      // the card stands over the rows, centred
      y += set_member_card(f, "set.card", x + (w - t.aside_w) / 2, y, t.aside_w, t.aside_h, "Local", "This computer", "Coder on this computer") + t.block_gap;
    } else {
      _ := set_member_card(f, "set.card", x + w - t.aside_w, y, t.aside_w, t.aside_h, "Local", "This computer", "Coder on this computer");
    }
    rows: [3] SetRow;
    rows[0] = SetRow.{id = "set.you", icon = ICON_SET_ACCOUNT, name = "You, on this computer", desc = "Coder runs as you, with your own logins."};
    rows[1] = SetRow.{id = "set.keys", icon = ICON_SET_TAG, name = "Your keys", desc = "Claude and OpenRouter keys stay in files only you can read."};
    rows[2] = SetRow.{id = "set.chats", icon = ICON_SET_PHONE, name = "Your chats", desc = "Kept on this computer, in Coder's own folder."};
    gy := y;
    y += cp_set_group(s, f, "set.account.group", gx, y, gw, rows[..]);
    bw := set_button_w(f, "Log in");
    _ := set_button(f, "set.login", gx + gw - bw, y + t.button_top, "Log in", true, 0, CP_SET_ACT);
    y += t.button_top + t.button_h;
    if !narrow { aside_end := gy + t.aside_h + t.caption_gap + t.desc_line; if aside_end > y { y = aside_end; } }
  } else {
    y += set_page_head(f, "set.title", x, y, w, names[CP_PG_ABOUT], "Coder's version and its updates.") + t.block_gap;
    ver := ifx s[0].set_version_n > 0 then sheet_pool(sh, cast(string) s[0].set_version[0..<s[0].set_version_n]) else "";
    one: [1] SetRow;
    one[0] = SetRow.{id = "set.version", name = "Version", desc = "The Coder app on this computer.", value = ver};
    y += cp_set_group(s, f, "set.version.group", x, y, w, one[..]) + t.block_gap;
    y += set_section_head(f, "set.update.head", x, y, w, "Updates", "") + t.section_gap;
    st := s[0].update_state;
    label := ifx s[0].update_label_n > 0 then sheet_pool(sh, cast(string) s[0].update_label[0..<s[0].update_label_n]) else "";
    desc := ifx st == CP_UPD_AVAILABLE then (ifx label.count > 0 then label else "A new version is ready to download.")
       else ifx st == CP_UPD_DOWNLOADING then "Downloading the new version."
       else ifx st == CP_UPD_READY then "The new version is downloaded. Coder restarts to use it."
       else ifx st == CP_UPD_ERROR then (ifx label.count > 0 then label else "The last check failed.")
       else "Coder looks for a new version every 15 minutes.";
    button := ifx st == CP_UPD_AVAILABLE then "Update" else ifx st == CP_UPD_READY then "Restart to update" else ifx st == CP_UPD_DOWNLOADING then "Updating…" else "Check now";
    one[0] = SetRow.{id = "set.update", name = "Check for updates", desc = desc, kind = SET_ROW_BUTTON, button = button, action = CP_SET_ACT,
      state = ifx st == CP_UPD_DOWNLOADING then EL_S_DISABLED else 0};
    y += cp_set_group(s, f, "set.update.group", x, y, w, one[..]);
  }
  y += t.page_bottom;
  uiframe_unclip(f);
  s[0].set_content = y - y0 + t.page_top;
  // a search's row: the page scrolls it into view, under the page's top padding
  if s[0].set_target_n > 0 {
    if s[0].set_target_y >= 0 { s[0].set_scroll = scroll_clamp(s[0].set_target_y + at - top - t.page_top, s[0].set_content, view); }
    s[0].set_target_n = 0; s[0].set_due = true;
  }
}
// The settings screen in the window: the list at the chats' sidebar's width, the page beside it.
cp_settings :: (s: [] CoderPage, f: [] UiFrame, window_w: f32, h: f32) {
  spec := cp_sidebar_spec();
  lw := ifx s[0].side_w > 0 then s[0].side_w else spec.default_w;
  most := window_w - spec.main_min;
  if lw > most { lw = ifx most > spec.min_w then most else spec.min_w; }
  if lw > window_w { lw = window_w; }
  s[0].side = lw; s[0].pane_w = 0; s[0].col_w = 0;
  cp_settings_page(s, f, lw, window_w - lw, h);
  cp_settings_list(s, f, lw, h);
}

// ---------------------------------------------------------------- the host's calls

// Opens settings on a page (0 General, 1 Models, 2 Foreman, 3 Account, 4 About & updates; -1 the
// one shown last), scrolled to a row by its id ("" the top); or closes it (page < -1).
coder_page_settings_open :: (s: [] CoderPage, page: int, row: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { cp_init(s); }
  if page < -1 { cp_settings_show(s, false, -1); return; }
  cp_settings_show(s, true, page);
  s[0].set_target_n = ifx row.count <= EL_ID then cp_out(s[0].set_target[..], row) else 0;
  if s[0].set_target_n > 0 { s[0].set_scroll = 0; }
}
// Whether settings is open, and the page it shows (-1: closed).
coder_page_settings_page :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].set_open then s[0].set_page else -1; }
// What the pages show that the host knows: the Claude key's state ("Ends 1a2b", "" not set), the
// OpenRouter key's and the app's version.
coder_page_settings_info :: (s: [] CoderPage, claude: string, openrouter: string, version: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_claude_n = cp_out(s[0].set_claude[..], claude);
  s[0].set_orkey_n = cp_out(s[0].set_orkey[..], openrouter);
  s[0].set_version_n = cp_out(s[0].set_version[..], version);
}
// The Gemini API key's state ("Ends 1a2b", "" not set); also updates model picker availability.
coder_page_settings_gemini :: (s: [] CoderPage, gemini: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  was_agy := cp_is_agy(s, s[0].model);
  was_inkling := cp_is_inkling(s, s[0].model);
  s[0].set_gemini_n = cp_out(s[0].set_gemini[..], gemini);
  if was_agy { s[0].model = cp_agy_idx(s); }
  if was_inkling { s[0].model = cp_inkling_idx(s); }
  s[0].model = cp_model_index(s);
}
// Local Models status in Settings > Models ("Inkling 2 Mini installed (~20 GB)", "None downloaded"; #13826).
coder_page_settings_local :: (s: [] CoderPage, status: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_local_status_n = cp_out(s[0].set_local_status[..], status);
}
// The agent instructions' state for General's row ("Default", "Edited", "Off (empty)"; #13808).
coder_page_settings_instructions :: (s: [] CoderPage, words: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_instr_n = cp_out(s[0].set_instr[..], words);
}
// Antigravity status, review mode (0 Auto, 1 Default, 2 Plan), model/effort and auth/profile summary (#13803).
coder_page_settings_agy :: (s: [] CoderPage, status: string, mode: int, model: string, auth: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_agy_status_n = cp_out(s[0].set_agy_status[..], status);
  s[0].set_agy_mode = ifx mode >= 0 && mode <= 2 then mode else 0;
  s[0].set_agy_model_n = cp_out(s[0].set_agy_model[..], model);
  s[0].set_agy_auth_n = cp_out(s[0].set_agy_auth[..], auth);
}
// The Antigravity review mode a press on Models' page chose (CP_ASK_AGY_MODE).
coder_page_settings_agy_mode :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].set_agy_mode else 0; }
// The tier a press on Foreman's page chose (CP_ASK_TIER).
coder_page_settings_tier :: (s: [] CoderPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].set_tier else 0; }
// Esc in settings: a search with words is emptied and keeps the keyboard. False when it was empty.
coder_page_search_clear :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].set_open || s[0].set_query_n == 0 { return false; }
  coder_page_search_set(s, ""); s[0].fld[0].kb = CP_KB_SEARCH;
  return true;
}
// The search's text after an edit: the list shows what it finds.
coder_page_search_set :: (s: [] CoderPage, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].set_query_n = cp_out(s[0].set_query[..], text); s[0].set_list_scroll = 0;
}
// Return in the search: its best result opens. False when it found nothing.
coder_page_search_submit :: (s: [] CoderPage) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].set_open { return false; }
  hits: [1] int;
  if cp_set_hits_in(cp_set_query(s), hits[..], s[0].experimental) < 1 { return false; }
  es := cp_set_entries(); e := es[hits[0]];
  cp_settings_show(s, true, e.page);
  s[0].set_target_n = cp_out(s[0].set_target[..], e.id); s[0].set_scroll = 0;
  return true;
}

#test "settings: the search ranks a name's start, then a word's start, then any match; terms count too" {
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  n := cp_set_hits("model", hits[..]);
  #assert n >= 3 && es[hits[0]].name == "Models" && (es[hits[1]].name == "Model for Microcoder" || es[hits[1]].name == "Model for sub-agents");
  n = cp_set_hits("KEY", hits[..]);
  #assert n >= 3 && (es[hits[0]].name == "Gemini API key" || es[hits[0]].name == "Claude key" || es[hits[0]].name == "OpenRouter key");
  n = cp_set_hits("zoom", hits[..]);
  #assert n == 1 && es[hits[0]].id == "set.zoom";
  #assert cp_set_hits("", hits[..]) == 0 && cp_set_hits("nothing like this", hits[..]) == 0;
}

cp_set_test_frame :: (s: [] CoderPage, w: f32, h: f32) -> bool {
  f: [1] UiFrame;
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_cells(), cp_skin(), uiinput(0, 0, false, false, "", ""), 0, 0.016, true, false);
  cp_layout(s, f[..], w, h);
  return uiframe_end(f[..], s[0].surface[..]);
}
cp_set_test_row :: (s: [] CoderPage, id: string) -> El {
  i := surface_find(s[0].surface[..], id);
  if i < 0 { return El.{}; }
  return surface_rows(s[0].surface[..]).rows[i];
}
#test "settings: the gear opens the list in the sidebar's place at its width, Back closes it, and the chat stays" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_sides_set(s, 300, 0);
  h: f32 = 700;
  #assert cp_set_test_frame(s, 1200, h);
  gear := cp_set_test_row(s, "coder.me.settings");
  #assert gear.action == CP_SET_TOGGLE && gear.y + gear.h <= h && gear.x + gear.w <= s[0].side;
  s[0].scroll = 40;
  #assert cp_settings_press(s, CP_SET_TOGGLE, "coder.me.settings") && s[0].set_open && coder_page_action(s) == CP_ASK_SETTINGS;
  #assert cp_set_test_frame(s, 1200, h);
  #assert s[0].side == s[0].side_w && surface_find(s[0].surface[..], "coder.composer") < 0;
  back := cp_set_test_row(s, "set.back");
  #assert back.action == CP_SET_BACK && back.x < s[0].side;
  for i: 0..<CP_SET_PAGES {
    pb: [16] u8; n := el_put(pb[..], 0, "set.page."); n = el_put_i(pb[..], n, i);
    #assert cp_set_test_row(s, cast(string) pb[0..<n]).action == CP_SET_PAGE;
  }
  me := cp_set_test_row(s, "set.me");
  t := cp_skin().set;
  #assert me.action == CP_SET_ACCOUNT && abs(me.y + t.account + t.list_pad - h) < 0.01;
  #assert abs(me.y - gear.y) < 0.01;   // the account row stays where it was
  #assert cp_set_test_row(s, "set.title").w > 0 && cp_set_test_row(s, "set.folder.a").action == CP_SET_ACT;
  // Back: the chat as it was
  #assert cp_settings_press(s, CP_SET_BACK, "set.back") && !s[0].set_open && s[0].scroll == 40;
  #assert coder_page_settings_page(s) == -1;
}
#test "settings: every page draws its rows, the search opens a row's page, and Account keeps its card beside or over the rows" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_info(s, "Ends 1a2b", "", "0.1.0 (1)");
  coder_page_settings_open(s, CP_PG_MODELS, "");
  #assert coder_page_settings_page(s) == CP_PG_MODELS && cp_set_test_frame(s, 1200, 700);
  #assert cp_set_test_row(s, "set.claude.a").action == CP_SET_ACT && cp_set_test_row(s, "set.or.main").action == CP_SET_ACT;
  coder_page_settings_open(s, CP_PG_FOREMAN, "");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.tier.2").action == CP_SET_ACT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.tier.2") && coder_page_action(s) == CP_ASK_TIER && coder_page_settings_tier(s) == 2;
  coder_page_settings_open(s, CP_PG_ABOUT, "");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.update.a").action == CP_SET_ACT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.update.a") && coder_page_action(s) == CP_ASK_CHECK_UPDATES;
  coder_page_settings_open(s, CP_PG_ACCOUNT, "");
  #assert cp_set_test_frame(s, 1200, 700);
  card := cp_set_test_row(s, "set.card"); you := cp_set_test_row(s, "set.login");
  #assert card.w > 0 && you.action == CP_SET_ACT && card.x > you.x;   // wide: the card beside the rows
  #assert cp_set_test_frame(s, 760, 700);
  card = cp_set_test_row(s, "set.card"); you = cp_set_test_row(s, "set.login");
  #assert card.y + card.h < you.y;   // narrow: over them
  #assert cp_settings_press(s, CP_SET_ACT, "set.login") && coder_page_action(s) == CP_ASK_LOGIN;
  // the search: results in the list, Return opens the best one's page
  coder_page_search_set(s, "zoom");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.hit.2").action == CP_SET_HIT;
  #assert coder_page_search_submit(s) && s[0].set_page == CP_PG_GENERAL;
  #assert cp_set_test_frame(s, 1200, 700) && s[0].set_target_n == 0;
  #assert s[0].set_box[2] > 0 && cp_ed_which(s) == -1;   // the search's box; the keyboard with neither field until a press or Command-F
  coder_page_settings_open(s, -2, "");
  #assert !s[0].set_open && s[0].set_query_n == 0 && cp_ed_which(s) == CP_ED_COMPOSER;
}
#test "settings: General's Agent instructions rows show their state, ask for the editor and the reset, and the search finds them" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_open(s, CP_PG_GENERAL, "");
  #assert cp_set_test_frame(s, 1200, 900);
  #assert cp_set_test_row(s, "set.instr.a").action == CP_SET_ACT && cp_set_test_row(s, "set.instr.reset.a").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.instr.head").w > 0;
  #assert cp_set_test_row(s, "set.instr.a").y > cp_set_test_row(s, "set.exp.1").y;   // under the general rows
  coder_page_settings_instructions(s, "Edited");
  #assert cast(string) s[0].set_instr[0..<s[0].set_instr_n] == "Edited";
  #assert cp_settings_press(s, CP_SET_ACT, "set.instr.a") && coder_page_action(s) == CP_ASK_INSTRUCTIONS;
  #assert cp_settings_press(s, CP_SET_ACT, "set.instr.reset.a") && coder_page_action(s) == CP_ASK_INSTRUCTIONS_RESET;
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  n := cp_set_hits_in("instructions", hits[..], false);
  #assert n == 2 && es[hits[0]].id == "set.instr" && es[hits[1]].id == "set.instr.reset";
  n = cp_set_hits_in("push", hits[..], false);
  #assert n >= 1 && es[hits[0]].id == "set.instr" && es[hits[0]].page == CP_PG_GENERAL;
  coder_page_search_set(s, "agent instructions");
  #assert coder_page_search_submit(s) && s[0].set_page == CP_PG_GENERAL;
}
#test "settings: Antigravity rows render under Models, dispatch actions, and match search for antigravity and agy" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_settings_agy(s, "v1.5.2 (ready)", 1, "gemini-4-hydrogen · high", "antigravity.env (ADC)");
  coder_page_settings_open(s, CP_PG_MODELS, "");
  #assert cp_set_test_frame(s, 1200, 1100);
  #assert cp_set_test_row(s, "set.agy.status.a").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.agy.mode.0").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.agy.mode.1").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.agy.mode.2").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.agy.model").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.agy.auth.a").action == CP_SET_ACT;
  #assert cp_settings_press(s, CP_SET_ACT, "set.agy.status.a") && coder_page_action(s) == CP_ASK_AGY;
  #assert cp_settings_press(s, CP_SET_ACT, "set.agy.model") && coder_page_action(s) == CP_ASK_AGY;
  #assert cp_settings_press(s, CP_SET_ACT, "set.agy.mode.2") && coder_page_action(s) == CP_ASK_AGY_MODE && coder_page_settings_agy_mode(s) == 2;
  #assert cp_settings_press(s, CP_SET_ACT, "set.agy.auth.a") && coder_page_action(s) == CP_ASK_AGY_AUTH;
  // Search for "antigravity" and "agy" finds the Antigravity rows under Models
  coder_page_search_set(s, "antigravity");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.hit.10").action == CP_SET_HIT;
  #assert coder_page_search_submit(s) && s[0].set_page == CP_PG_MODELS;
  coder_page_search_set(s, "agy");
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.hit.10").action == CP_SET_HIT;
}
#test "settings: experimental features off hides Foreman, Gym and Account everywhere, and General's row turns them on" {
  p: [1] CoderPage; p_st: [1] CpCheckStore; s := cp_check_page(p[..], p_st[..]);
  cp_init(s); s[0].d = 1.0f32;
  coder_page_experimental_set(s, false);
  #assert !coder_page_experimental(s);
  // the sidebar: no Foreman row, no Gym row; the account row's press opens General
  #assert cp_set_test_frame(s, 1200, 700);
  #assert surface_find(s[0].surface[..], "coder.foreman") < 0 && surface_find(s[0].surface[..], "coder.gym") < 0;
  #assert surface_find(s[0].surface[..], "coder.new") >= 0;
  coder_page_gym_set(s, true);
  #assert !coder_page_gym_open(s);
  #assert cp_settings_press(s, CP_SET_ACCOUNT, "coder.me") && s[0].set_open && s[0].set_page == CP_PG_GENERAL;
  // the list: General, Models and About only; Foreman's and Account's pages open General
  #assert cp_set_test_frame(s, 1200, 700);
  #assert surface_find(s[0].surface[..], "set.page.0") >= 0 && surface_find(s[0].surface[..], "set.page.1") >= 0 && surface_find(s[0].surface[..], "set.page.4") >= 0;
  #assert surface_find(s[0].surface[..], "set.page.2") < 0 && surface_find(s[0].surface[..], "set.page.3") < 0;
  coder_page_settings_open(s, CP_PG_FOREMAN, "");
  #assert coder_page_settings_page(s) == CP_PG_GENERAL;
  coder_page_settings_open(s, CP_PG_ACCOUNT, "");
  #assert coder_page_settings_page(s) == CP_PG_GENERAL;
  #assert !cp_settings_press(s, CP_SET_ACT, "set.tier.2") && !cp_settings_press(s, CP_SET_ACT, "set.login");
  #assert cp_settings_press(s, CP_SET_ACT, "set.update.a") && coder_page_action(s) == CP_ASK_CHECK_UPDATES;
  // the search: no Foreman or Account entries; "account" finds the toggle
  hits: [CP_SET_HITS] int; es := cp_set_entries();
  #assert cp_set_hits_in("tier", hits[..], false) == 0 && cp_set_hits_in("tier", hits[..], true) == 1;
  n := cp_set_hits_in("account", hits[..], false);
  #assert n == 1 && es[hits[0]].id == "set.exp";
  #assert cp_set_page_ok(false, CP_PG_GENERAL) && cp_set_page_ok(false, CP_PG_MODELS) && cp_set_page_ok(false, CP_PG_ABOUT);
  #assert !cp_set_page_ok(false, CP_PG_FOREMAN) && !cp_set_page_ok(false, CP_PG_ACCOUNT) && cp_set_page_ok(true, CP_PG_ACCOUNT);
  // General's row: Off shown; On turns them on and asks the host to keep it
  #assert cp_set_test_frame(s, 1200, 700) && cp_set_test_row(s, "set.exp.1").action == CP_SET_ACT;
  #assert cp_set_test_row(s, "set.exp.0").state & EL_S_CURRENT != 0;
  #assert cp_settings_press(s, CP_SET_ACT, "set.exp.1") && coder_page_action(s) == CP_ASK_EXPERIMENTAL && coder_page_experimental(s);
  coder_page_settings_open(s, CP_PG_ACCOUNT, "");
  #assert coder_page_settings_page(s) == CP_PG_ACCOUNT;
  // Off again while Account is shown and the Gym open: General shows and the Gym closes
  coder_page_gym_set(s, true);
  #assert cp_settings_press(s, CP_SET_ACT, "set.exp.0") && coder_page_action(s) == CP_ASK_EXPERIMENTAL && !coder_page_experimental(s);
  #assert s[0].set_page == CP_PG_GENERAL && !coder_page_gym_open(s);
}
