// Desktop Surface Register & Built-in Tester Agent Definition
// (docs/apps/2026-11-20-simulated-tester-spec.md §3, §8.1; GitHub #13892).
#load "../../../../coax/lib/agent/tester/schema.coax";

DT_SCENARIO_COUNT :: 30;

DtScenario :: struct {
  id: string;
  area: string;
  title: string;
  required: bool;
}

dt_scenarios :: () -> [DT_SCENARIO_COUNT] DtScenario {
  return [DT_SCENARIO_COUNT] DtScenario.[
    DtScenario.{id = "desktop.launch.cold", area = "launch", title = "Cold launch, window geometry, zero focus stealing, composer ready", required = true},
    DtScenario.{id = "desktop.composer.type-and-multiline", area = "composer", title = "Type text, Shift-Return newline, select-all and clear", required = true},
    DtScenario.{id = "desktop.palette.open-and-dismiss", area = "palette", title = "Cmd+K command palette open, filter, and Escape dismiss", required = true},
    DtScenario.{id = "desktop.settings.pages-and-search", area = "settings", title = "Cmd+, Settings open, search, and Escape close", required = true},
    DtScenario.{id = "desktop.zoom.step-and-reset", area = "zoom", title = "Cmd+/Cmd-/Cmd+0 text zoom steps and reset", required = true},
    DtScenario.{id = "desktop.layout.narrow-and-wide", area = "layout", title = "Resize 1400x860 -> 760x640 narrow -> 1280x820 wide", required = true},
    DtScenario.{id = "desktop.sidebar.toggle", area = "sidebar", title = "Cmd+B toggle sidebar off and on", required = true},
    DtScenario.{id = "desktop.models.picker", area = "models", title = "Cmd+/ model picker open and Escape dismiss", required = true},
    DtScenario.{id = "desktop.simulator.pane-toggle", area = "simulator", title = "Opt+Cmd+S iOS Simulator pane toggle", required = true},
    DtScenario.{id = "desktop.files.open-edit-dirty", area = "files", title = "Open scratch file in right pane, edit, dirty=true, Cmd+S save to disk", required = true},
    DtScenario.{id = "desktop.chat.mock-send-and-stream", area = "chat", title = "Send prompt via composer, stream mock worker reply, settle", required = true},
    DtScenario.{id = "desktop.git.toolbar-visible", area = "git", title = "Git Actions toolbar chips (branch, mode, commit, actions) drawn cleanly", required = true},
    DtScenario.{id = "desktop.git.mode-toggle", area = "git", title = "Click Local vs. Worktree mode chip and verify toggle", required = true},
    DtScenario.{id = "desktop.git.branch-and-commit-guard", area = "git", title = "Branch picker menu, Escape dismiss, and Commit dialog on main", required = true},
    DtScenario.{id = "desktop.git.worktree-per-chat", area = "git", title = "New chat in git repo creates isolated coder/<id> worktree under CODER_WORKTREES", required = true},
    DtScenario.{id = "desktop.composer.undo-redo", area = "composer", title = "Cmd+A + Cmd+X cut, Cmd+Z undo restores text, Shift+Cmd+Z redo clears again", required = true},
    DtScenario.{id = "desktop.find.in-thread", area = "find", title = "Cmd+F in-thread Find open, type query, Escape restores composer focus", required = true},
    DtScenario.{id = "desktop.terminal.toggle", area = "terminal", title = "Cmd+J toggle embedded terminal pane open and closed cleanly", required = true},
    DtScenario.{id = "desktop.settings.usage-dashboard", area = "settings", title = "Open Settings -> Usage via Cmd+K jump, verify Usage dashboard renders and Escape closes", required = true},
    DtScenario.{id = "desktop.chat.multi-switch", area = "chat", title = "Create two chats, switch via Cmd+1/Cmd+2, verify independent draft isolation", required = true},
    DtScenario.{id = "desktop.git.output-tray", area = "git", title = "Open Git Actions menu from toolbar chip and dismiss cleanly with Escape", required = true},
    DtScenario.{id = "desktop.composer.slash-commands", area = "composer", title = "Type / in composer to open slash-command popover, dismiss with Escape, clear cleanly", required = true},
    DtScenario.{id = "desktop.files.tree-toggle", area = "files", title = "Click Files toolbar button (coder.ft.toggle) to open and close right-hand file tree pane", required = true},
    DtScenario.{id = "desktop.settings.wallet-page", area = "settings", title = "Open Settings -> Wallet via Cmd+K jump, capture frame, Escape restores composer focus", required = true},
    DtScenario.{id = "desktop.settings.scheduled-tasks", area = "settings", title = "Open Settings -> Scheduled Tasks via Cmd+K jump, capture frame, Escape restores focus", required = true},
    DtScenario.{id = "desktop.zoom.settings-stress", area = "zoom", title = "Zoom in 2x, open Settings, Escape, reset zoom with Cmd+0 cleanly", required = true},
    DtScenario.{id = "desktop.composer.mention-at", area = "composer", title = "Type @ in composer to trigger file mention popover, Escape and clear cleanly", required = true},
    DtScenario.{id = "desktop.settings.voice-page", area = "settings", title = "Open Settings -> Voice via Cmd+K jump, capture frame, Escape restores focus", required = true},
    DtScenario.{id = "desktop.settings.keybindings-page", area = "settings", title = "Open Settings -> Keybindings via Cmd+K jump, capture frame, Escape restores focus", required = true},
    DtScenario.{id = "desktop.settings.mcp-page", area = "settings", title = "Open Settings -> MCP via Cmd+K jump, capture frame, Escape restores focus", required = true}
  ];
}

dt_agent_definition :: () -> ArDefRecord {
  return ArDefRecord.{
    agent_id = "desktop-journey-tester",
    name = "Desktop Journey Tester",
    description = "Deterministic Coax agent driving compiled OpenAgents.app through required desktop UI journeys without stealing focus",
    version = 1,
    kind = "tester",
    execution_mode = "deterministic",
    runtime = "coax-tool:apps/shared/tester/cli.coax",
    input_contract = "tester.run_request.v1",
    output_contract = "tester.result.v1",
    max_depth = 2,
    max_concurrency = 4,
    budget = ArBudget.{wall_ms = 300000, turns = 0, tokens = 0, cost_usd_e6 = 0},
    model_hint = ""
  };
}

#test "desktop surface register has unique non-empty ids and valid agent definition" {
  sc := dt_scenarios();
  for i: 0..<DT_SCENARIO_COUNT {
    #assert sc[i].id.count > 0 && sc[i].area.count > 0 && sc[i].title.count > 0 && sc[i].required;
    for j: i + 1..<DT_SCENARIO_COUNT {
      #assert sc[i].id != sc[j].id;
    }
  }
  d := dt_agent_definition();
  #assert ar_kind_of(d.kind) == AR_KIND_TESTER;
  #assert ar_mode_of(d.execution_mode) == AR_MODE_DETERMINISTIC;
  #assert d.version == 1 && d.max_depth == 2 && d.max_concurrency == 4;
  #assert d.budget.wall_ms == 300000 && d.budget.turns == 0 && d.budget.tokens == 0 && d.budget.cost_usd_e6 == 0;
}
