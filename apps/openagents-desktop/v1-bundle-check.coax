// OpenAgents Desktop v1.0 minimal release bundle verification gate
// (docs/desktop/openagents-v1-spec.md §4.5; GitHub #13965).
//
// Verifies a --minimal release bundle on macOS, Linux, or Windows:
//   1. Unpacked size budget (macOS Stage 1 <= 18 MiB, Stage 2 <= 14 MiB; Linux/Windows <= 12 MiB)
//   2. Optional archive size budget (--archive PATH: <= 7 MiB Stage 1, <= 5 MiB Stage 2 / Linux / Windows)
//   3. Zero bundled frameworks on macOS (Contents/Frameworks absent or empty)
//   4. Strict shipped-files allowlist & required core artifacts
//   5. Strict dynamic-link denylist (otool -L on macOS, ldd on Linux, objdump -p on Windows)
//
// Usage:
//   coax/web/tool.sh apps/openagents-desktop/v1-bundle-check.coax [--platform macos|linux|windows] [--stage 1|2] [--archive FILE] [--skip-ld] PATH
//   coax/bin/coax test apps/openagents-desktop/v1-bundle-policy.coax --library
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "v1-bundle-policy.coax";

// ---- Filesystem & process helpers ----

vbc_walk_bytes :: (path: string, depth: int) -> int {
  if depth > 16 { return 0; }
  k := fs_kind(path);
  if k == FS_FILE {
    sz := fs_size(path);
    return ifx sz > 0 then sz else 0;
  }
  if k != FS_DIR { return 0; }
  entries: [1] FsList;
  n := fs_list(path, entries[..]);
  if n <= 0 { return 0; }
  total := 0;
  child: [FS_PATH_MAX] u8;
  for i: 0..<n {
    name := fs_entry(entries[..], i);
    full := fs_join(path, name, child[..]);
    if full.count > 0 {
      total += vbc_walk_bytes(full, depth + 1);
    }
  }
  return total;
}

vbc_measure_unpacked_bytes :: (path: string) -> int {
  argv := [3] string.["du", "-sk", path];
  out: [4096] u8;
  err: [1024] u8;
  r := proc_run(argv[..], 15000, out[..], err[..]);
  if r.started == 0 && r.status == 0 {
    kib := vbc_parse_du_kib(cast(string) out[0..<r.out_n]);
    if kib >= 0 { return kib * 1024; }
  }
  return vbc_walk_bytes(path, 0);
}

vbc_check_required :: (base: string, rel: string, label: string) -> int {
  buf: [FS_PATH_MAX] u8;
  p := fs_join(base, rel, buf[..]);
  if fs_kind(p) <= 0 {
    print("FAIL [missing] required v1.0 artifact absent: %\n", label);
    return 1;
  }
  return 0;
}

vbc_check_binary_links :: (platform: int, stage: int, bin_path: string, label: string) -> int {
  if fs_kind(bin_path) != FS_FILE { return 0; }
  out: [65536] u8;
  err: [4096] u8;
  if platform == VBC_MAC {
    argv := [3] string.["otool", "-L", bin_path];
    r := proc_run(argv[..], 15000, out[..], err[..]);
    if r.started != 0 || r.status != 0 {
      print("FAIL [dylib] could not run otool -L on %\n", label);
      return 1;
    }
    return vbc_scan_link_output(VBC_MAC, stage, cast(string) out[0..<r.out_n], label, true);
  }
  if platform == VBC_LINUX {
    argv := [2] string.["ldd", bin_path];
    r := proc_run(argv[..], 15000, out[..], err[..]);
    if r.started != 0 || r.status != 0 {
      print("FAIL [dylib] could not run ldd on %\n", label);
      return 1;
    }
    return vbc_scan_link_output(VBC_LINUX, stage, cast(string) out[0..<r.out_n], label, true);
  }
  if platform == VBC_WINDOWS {
    tools := [3] string.["objdump", "llvm-objdump", "x86_64-w64-mingw32-objdump"];
    for i: 0..<3 {
      argv := [3] string.[tools[i], "-p", bin_path];
      r := proc_run(argv[..], 15000, out[..], err[..]);
      if r.started == 0 && r.status == 0 {
        return vbc_scan_link_output(VBC_WINDOWS, stage, cast(string) out[0..<r.out_n], label, true);
      }
    }
    print("FAIL [dylib] could not run objdump/llvm-objdump on %\n", label);
    return 1;
  }
  return 0;
}

vbc_usage :: () {
  print("usage: v1-bundle-check [--platform macos|linux|windows] [--stage 1|2] [--archive FILE] [--skip-ld] PATH\n");
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("v1-bundle-check: arguments did not fit"); return 2; }

  platform := 0;
  stage := 2;
  archive := "";
  target := "";
  skip_ld := false;

  i := 0;
  while i < a[0].n {
    arg := args_at(a[..], i);
    if arg == "-h" || arg == "--help" { vbc_usage(); return 0; }
    if arg == "--platform" && i + 1 < a[0].n {
      platform = vbc_parse_platform(args_at(a[..], i + 1));
      if platform == 0 { tool_errln("v1-bundle-check: unknown --platform (use macos, linux, or windows)"); return 2; }
      i += 2; continue;
    }
    if arg == "--stage" && i + 1 < a[0].n {
      stage = vbc_parse_stage(args_at(a[..], i + 1));
      if stage == 0 { tool_errln("v1-bundle-check: unknown --stage (use 1 or 2)"); return 2; }
      i += 2; continue;
    }
    if arg == "--archive" && i + 1 < a[0].n {
      archive = args_at(a[..], i + 1);
      i += 2; continue;
    }
    if arg == "--skip-ld" {
      skip_ld = true;
      i += 1; continue;
    }
    if arg.count > 0 && arg[0] == '-' {
      tool_err("v1-bundle-check: unknown flag: "); tool_errln(arg);
      return 2;
    }
    target = arg;
    i += 1;
  }

  if target.count == 0 { vbc_usage(); return 2; }
  if platform == 0 { platform = VBC_MAC; }

  if fs_kind(target) != FS_DIR {
    tool_err("v1-bundle-check: bundle directory not found: "); tool_errln(target);
    return 2;
  }

  violations := 0;

  // 1. Unpacked size budget
  unpacked_bytes := vbc_measure_unpacked_bytes(target);
  max_unpacked := vbc_max_unpacked_bytes(platform, stage);
  if unpacked_bytes > max_unpacked {
    print("FAIL [size] unpacked bundle is % bytes (% MiB), exceeds % MiB budget\n",
          unpacked_bytes, unpacked_bytes / VBC_MIB, max_unpacked / VBC_MIB);
    violations += 1;
  }

  // 2. Optional archive size budget
  if archive.count > 0 {
    arc_sz := fs_size(archive);
    max_arc := vbc_max_archive_bytes(platform, stage);
    if arc_sz < 0 {
      print("FAIL [archive] archive not found or unreadable: %\n", archive);
      violations += 1;
    } else if arc_sz > max_arc {
      print("FAIL [archive] archive is % bytes (% MiB), exceeds % MiB budget\n",
            arc_sz, arc_sz / VBC_MIB, max_arc / VBC_MIB);
      violations += 1;
    }
  }

  // 3. Platform structure, frameworks, required files & allowlists
  pbuf: [FS_PATH_MAX] u8;
  pbuf2: [FS_PATH_MAX] u8;
  list: [1] FsList;

  if platform == VBC_MAC {
    contents := fs_join(target, "Contents", pbuf[..]);
    if fs_kind(contents) != FS_DIR {
      print("FAIL [structure] missing Contents/ inside %\n", target);
      violations += 1;
    } else {
      // Check top-level Contents/ allowlist
      nc := fs_list(contents, list[..]);
      for k: 0..<nc {
        nm := fs_entry(list[..], k);
        if !vbc_macos_contents_allowed(nm) {
          print("FAIL [structure] unexpected entry in Contents/: %\n", nm);
          violations += 1;
        }
      }

      // Required core files
      violations += vbc_check_required(contents, "Info.plist", "Contents/Info.plist");
      violations += vbc_check_required(contents, "MacOS/OpenAgents", "Contents/MacOS/OpenAgents");
      violations += vbc_check_required(contents, "Resources/coder-host", "Contents/Resources/coder-host");
      violations += vbc_check_required(contents, "Resources/oa-worker", "Contents/Resources/oa-worker");
      violations += vbc_check_required(contents, "Resources/psionic-inkling-serve", "Contents/Resources/psionic-inkling-serve");
      violations += vbc_check_required(contents, "Resources/inkling-kernels.metal", "Contents/Resources/inkling-kernels.metal");
      violations += vbc_check_required(contents, "Resources/Components", "Contents/Resources/Components");

      // Contents/Frameworks must be absent or empty
      fw_dir := fs_join(contents, "Frameworks", pbuf2[..]);
      if fs_kind(fw_dir) == FS_DIR {
        nf := fs_list(fw_dir, list[..]);
        for k: 0..<nf {
          nm := fs_entry(list[..], k);
          print("FAIL [frameworks] disallowed framework bundled: Contents/Frameworks/%\n", nm);
          violations += 1;
        }
      }

      // Contents/MacOS allowlist
      macos_dir := fs_join(contents, "MacOS", pbuf2[..]);
      if fs_kind(macos_dir) == FS_DIR {
        nm_cnt := fs_list(macos_dir, list[..]);
        for k: 0..<nm_cnt {
          nm := fs_entry(list[..], k);
          if !vbc_macos_binary_allowed(nm) {
            print("FAIL [macos] unexpected binary in Contents/MacOS/: %\n", nm);
            violations += 1;
          }
        }
      }

      // Contents/Resources allowlist
      res_dir := fs_join(contents, "Resources", pbuf2[..]);
      if fs_kind(res_dir) == FS_DIR {
        nr := fs_list(res_dir, list[..]);
        for k: 0..<nr {
          nm := fs_entry(list[..], k);
          if !vbc_resource_allowed(VBC_MAC, nm) {
            print("FAIL [resources] disallowed artifact in Contents/Resources/: %\n", nm);
            violations += 1;
          }
        }
      }

      // Dynamic link check
      if !skip_ld {
        main_bin := fs_join(contents, "MacOS/OpenAgents", pbuf2[..]);
        violations += vbc_check_binary_links(VBC_MAC, stage, main_bin, "Contents/MacOS/OpenAgents");
        srv_bin := fs_join(contents, "Resources/psionic-inkling-serve", pbuf2[..]);
        violations += vbc_check_binary_links(VBC_MAC, stage, srv_bin, "Contents/Resources/psionic-inkling-serve");
      }
    }
  } else if platform == VBC_LINUX {
    violations += vbc_check_required(target, "OpenAgents", "OpenAgents");
    violations += vbc_check_required(target, "coder-host", "coder-host");
    violations += vbc_check_required(target, "oa-worker", "oa-worker");
    violations += vbc_check_required(target, "psionic-inkling-serve", "psionic-inkling-serve");

    nl := fs_list(target, list[..]);
    for k: 0..<nl {
      nm := fs_entry(list[..], k);
      if !vbc_resource_allowed(VBC_LINUX, nm) {
        print("FAIL [resources] disallowed artifact in Linux bundle: %\n", nm);
        violations += 1;
      }
    }
    if !skip_ld {
      main_bin := fs_join(target, "OpenAgents", pbuf[..]);
      violations += vbc_check_binary_links(VBC_LINUX, stage, main_bin, "OpenAgents");
      srv_bin := fs_join(target, "psionic-inkling-serve", pbuf[..]);
      violations += vbc_check_binary_links(VBC_LINUX, stage, srv_bin, "psionic-inkling-serve");
    }
  } else if platform == VBC_WINDOWS {
    violations += vbc_check_required(target, "OpenAgents.exe", "OpenAgents.exe");
    violations += vbc_check_required(target, "coder-host.exe", "coder-host.exe");
    violations += vbc_check_required(target, "oa-worker.exe", "oa-worker.exe");
    violations += vbc_check_required(target, "psionic-inkling-serve.exe", "psionic-inkling-serve.exe");

    nw := fs_list(target, list[..]);
    for k: 0..<nw {
      nm := fs_entry(list[..], k);
      if !vbc_resource_allowed(VBC_WINDOWS, nm) {
        print("FAIL [resources] disallowed artifact in Windows bundle: %\n", nm);
        violations += 1;
      }
    }
    if !skip_ld {
      main_bin := fs_join(target, "OpenAgents.exe", pbuf[..]);
      violations += vbc_check_binary_links(VBC_WINDOWS, stage, main_bin, "OpenAgents.exe");
      srv_bin := fs_join(target, "psionic-inkling-serve.exe", pbuf[..]);
      violations += vbc_check_binary_links(VBC_WINDOWS, stage, srv_bin, "psionic-inkling-serve.exe");
    }
  }

  if violations == 0 {
    print("PASS v1-bundle-check (% stage %, unpacked=% bytes / % MiB budget)\n",
          vbc_platform_name(platform), stage, unpacked_bytes, max_unpacked / VBC_MIB);
    return 0;
  }
  print("FAIL v1-bundle-check: % violation(s) on % stage % (%)\n",
        violations, vbc_platform_name(platform), stage, target);
  return 1;
}
