// How a conversation's session record becomes the transcript's rows. The
// record (coax/lib/agent/session/session.coax) is written by the engines
// (coax/lib/agent/engine/: Claude Code, Codex, Psionic, the Lab); this file
// only reads it, as Zeron's ui/src/transcript.rs reads its document.
//
// Unlike Zeron's fold, which keeps chips one-liners, a call keeps its output
// and an edit or write its diff, so the chip opens onto them. Consecutive
// thoughts and calls fold into one tool group (reasoning joins the group),
// summarized as tool_group_summary does; the trailing group stays open
// while the turn streams, and a thought while it is the live tail.
// Based on Zeron by Wing, MIT.

#load "../../../components/zeron/transcript.coax";
#load "../../../components/zeron/picker.coax";
#load "../../../components/zeron/attachments.coax";
#load "../../../coax/lib/agent/engine/claude.coax";

CLAUDE_TINT :: Rgba.{r = 0.851, g = 0.467, b = 0.341, a = 1};          // #d97757, the mark's brand tone

// An engine's catalog as the picker shows it: the same rows, with the brand
// mark and tint the engine does not carry.
pk_of :: (c: AgCatalog, icon: int, tint: Rgba) -> PkCatalog {
  p := PkCatalog.{provider = c.provider, icon = icon, tint = tint, n = c.n, levels = c.levels, default_level = c.default_level,
                  access = c.access, full_access = c.full_access, plan = c.plan};
  for k: 0..<c.n { p.id[k] = c.id[k]; p.label[k] = c.label[k]; p.desc[k] = c.desc[k]; p.ladder[k] = c.ladder[k]; }
  for k: 0..<c.levels { p.level_id[k] = c.level_id[k]; p.level_label[k] = c.level_label[k]; }
  for k: 0..<c.access { p.access_label[k] = c.access_label[k]; p.access_desc[k] = c.access_desc[k]; p.access_value[k] = c.access_value[k]; }
  return p;
}

// ---------------------------------------------------------------- into the transcript

// The open state each group and chip had when last built, and whether the
// user has since set it (a press flips what was built: from then on it is theirs).
SUi :: struct {
  first: int;                       // the part the transcript starts at (older ones scrolled off its capacity)
  g_set: [T_GROUPS] bool; g_user: [T_GROUPS] int;    // 0 auto, 1 open, 2 closed
  t_set: [T_TOOLS] bool; t_user: [T_TOOLS] int;
  built_groups: int; built_tools: int;
}

plural :: (t: [] Transcript, n: int, one: string, many: string, out: [] u8, at: int) -> int {
  k := put_int(out, at, n); out[k] = ' '; k += 1;
  w := ifx n == 1 then one else many;
  for c: w { out[k] = c; k += 1; }
  return k;
}
seg_sep :: (out: [] u8, k: int) -> int {
  if k == 0 { return 0; }
  out[k] = ' '; out[k + 1] = 0xC2; out[k + 2] = 0xB7; out[k + 3] = ' ';
  return k + 4;
}
seg_word :: (out: [] u8, k: int, w: string) -> int { j := k; for c: w { out[j] = c; j += 1; } return j; }
// The group's summary (tool_group_summary): "Thought process · Ran 2 commands · edited 1 file · 1 failed".
s_summary :: (s: [] Session, t: [] Transcript, from: int, to: int) -> string {
  thoughts := 0; commands := 0; edited := 0; reads := 0; searches := 0; fetches := 0; todos := 0; other := 0; failed := 0; calls := 0;
  for k: from..<to {
    p := s[0].parts[k];
    if p.kind == P_THINK { thoughts += 1; continue; }
    calls += 1;
    if p.failed { failed += 1; }
    if p.tk == TK_EXEC { commands += 1; }
    else if p.tk == TK_EDIT || p.tk == TK_WRITE {
      seen := false;
      for j: from..<k { q := s[0].parts[j]; if q.kind == P_TOOL && (q.tk == TK_EDIT || q.tk == TK_WRITE) && q.arg == p.arg { seen = true; } }
      if !seen { edited += 1; }
    }
    else if p.tk == TK_READ { reads += 1; }
    else if p.tk == TK_SEARCH || p.tk == TK_GLOB || p.tk == TK_WEB { searches += 1; }
    else if p.tk == TK_FETCH { fetches += 1; }
    else if p.tk == TK_TODO { todos += 1; }
    else { other += 1; }
  }
  out: [512] u8; k := 0;
  if thoughts == 1 { k = seg_word(out[..], k, "thought process"); }
  else if thoughts > 1 { k = seg_word(out[..], k, "thought "); k = plural(t, thoughts, "time", "times", out[..], k); }
  if calls > 0 {
    base := k;
    if commands > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "ran "); k = plural(t, commands, "command", "commands", out[..], k); }
    if edited > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "edited "); k = plural(t, edited, "file", "files", out[..], k); }
    if reads > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "read "); k = plural(t, reads, "file", "files", out[..], k); }
    if searches > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "searched "); k = plural(t, searches, "time", "times", out[..], k); }
    if fetches > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "fetched "); k = plural(t, fetches, "page", "pages", out[..], k); }
    if todos > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "updated todos"); }
    if other > 0 { k = seg_sep(out[..], k); k = seg_word(out[..], k, "called "); k = plural(t, other, "tool", "tools", out[..], k); }
    if k == base { k = seg_sep(out[..], k); k = plural(t, calls, "tool", "tools", out[..], k); }
    if failed > 0 { k = seg_sep(out[..], k); k = put_int(out[..], k, failed); k = seg_word(out[..], k, " failed"); }
    // the shared summary arrives capitalized ("Thought process · Ran 2 commands")
    first := ifx base > 0 then base + 4 else 0;
    if first < k && out[first] >= 'a' && out[first] <= 'z' { out[first] = out[first] - 32; }
  }
  if k > 0 && out[0] >= 'a' && out[0] <= 'z' { out[0] = out[0] - 32; }
  return t_pool(t, cast(string) out[0..<k]);
}

// Lines of a text, at most max (a trailing newline ends the last).
s_lines :: (text: string, out: [] ToolLine, max: int) -> int {
  n := 0; i := 0;
  if text.count == 0 { return 0; }
  while i < text.count && n < max && n < out.count {
    j := i; while j < text.count && text[j] != '\n' { j += 1; }
    out[n] = ToolLine.{from = i, to = j}; n += 1;
    i = j + 1;
  }
  return n;
}
// An edit's diff (changes.rs, one hunk): the longest common subsequence of
// the old and new lines, then deletions before additions between matches; a
// write is all additions. Numbers count from the strings' first line.
s_diff :: (t: [] Transcript, old: string, new: string, hunk_out: [] u8) -> int {
  a: [S_DIFF_MAX] ToolLine; b: [S_DIFF_MAX] ToolLine;
  na := s_lines(old, a[..], S_DIFF_MAX); nb := s_lines(new, b[..], S_DIFF_MAX);
  lcs: [1681] int;   // (S_DIFF_MAX + 1)^2
  w := nb + 1;
  i := na;
  while i >= 0 {
    j := nb;
    while j >= 0 {
      v := 0;
      if i < na && j < nb {
        if cast(string) old[a[i].from..<a[i].to] == cast(string) new[b[j].from..<b[j].to] { v = 1 + lcs[(i + 1) * w + j + 1]; }
        else { x := lcs[(i + 1) * w + j]; y := lcs[i * w + j + 1]; v = ifx x > y then x else y; }
      }
      lcs[i * w + j] = v;
      j -= 1;
    }
    i -= 1;
  }
  i = 0; j := 0; lines := 0;
  while i < na || j < nb {
    if i < na && j < nb && cast(string) old[a[i].from..<a[i].to] == cast(string) new[b[j].from..<b[j].to] {
      t_diff_line(t, DL_CONTEXT, i + 1, j + 1, cast(string) old[a[i].from..<a[i].to]); i += 1; j += 1;
    } else if i < na && (j >= nb || lcs[(i + 1) * w + j] >= lcs[i * w + j + 1]) {
      t_diff_line(t, DL_DEL, i + 1, 0, cast(string) old[a[i].from..<a[i].to]); i += 1;
    } else {
      t_diff_line(t, DL_ADD, 0, j + 1, cast(string) new[b[j].from..<b[j].to]); j += 1;
    }
    lines += 1;
  }
  // @@ -1,na +1,nb @@
  k := seg_word(hunk_out, 0, "@@ -");
  k = put_int(hunk_out, k, ifx na > 0 then 1 else 0); hunk_out[k] = ','; k += 1; k = put_int(hunk_out, k, na);
  k = seg_word(hunk_out, k, " +"); k = put_int(hunk_out, k, ifx nb > 0 then 1 else 0); hunk_out[k] = ','; k += 1; k = put_int(hunk_out, k, nb);
  k = seg_word(hunk_out, k, " @@");
  return k * 1000 + lines;
}

// A unified diff as the chip's lines (Codex's fileChange diff): each hunk's
// lines numbered from its header, the first header as the chip's hunk; file
// headers (---, +++) and "\ No newline" skipped; at most S_DIFF_MAX * 2
// lines. Text with no hunk header is a new file's content: all additions.
S_PATCH_MAX :: 80;
s_patch :: (t: [] Transcript, patch: string, hunk_out: [] u8) -> int {
  has := false;
  for i: 0..<patch.count - 1 { if patch[i] == '@' && patch[i + 1] == '@' && (i == 0 || patch[i - 1] == '\n') { has = true; break; } }
  if !has { return s_diff(t, "", patch, hunk_out); }
  k := 0; lines := 0; old_no := 0; new_no := 0; i := 0;
  while i < patch.count && lines < S_PATCH_MAX {
    j := i; while j < patch.count && patch[j] != '\n' { j += 1; }
    l := cast(string) patch[i..<j];
    i = j + 1;
    if l.count >= 2 && l[0] == '@' && l[1] == '@' {
      // @@ -a,b +c,d @@
      q := 2; while q < l.count && l[q] != '-' { q += 1; }
      q += 1; old_no = 0; while q < l.count && l[q] >= '0' && l[q] <= '9' { old_no = old_no * 10 + cast(int) (l[q] - '0'); q += 1; }
      while q < l.count && l[q] != '+' { q += 1; }
      q += 1; new_no = 0; while q < l.count && l[q] >= '0' && l[q] <= '9' { new_no = new_no * 10 + cast(int) (l[q] - '0'); q += 1; }
      if k == 0 {
        e := 2; while e + 1 < l.count && !(l[e] == '@' && l[e + 1] == '@') { e += 1; }
        e = ifx e + 1 < l.count then e + 2 else l.count;
        if e > hunk_out.count { e = hunk_out.count; }
        for c: 0..<e { hunk_out[c] = l[c]; }
        k = e;
      }
      continue;
    }
    if l.count == 0 && i >= patch.count { break; }
    if l.count >= 3 && (cast(string) l[0..<3] == "---" || cast(string) l[0..<3] == "+++") { continue; }
    if l.count > 0 && l[0] == '\\' { continue; }
    body := ifx l.count > 0 then cast(string) l[1..<l.count] else l;
    if l.count > 0 && l[0] == '+' { t_diff_line(t, DL_ADD, 0, new_no, body); new_no += 1; }
    else if l.count > 0 && l[0] == '-' { t_diff_line(t, DL_DEL, old_no, 0, body); old_no += 1; }
    else { t_diff_line(t, DL_CONTEXT, old_no, new_no, body); old_no += 1; new_no += 1; }
    lines += 1;
  }
  return k * 1000 + lines;
}

// Rebuilds the transcript from the session's parts (from ui.first on).
s_build :: (s: [] Session, ui: [] SUi, t: [] Transcript) {
  // what the user changed since the last build is theirs
  for g: 0..<t[0].ng { if g < ui[0].built_groups && t[0].groups[g].open != ui[0].g_set[g] { ui[0].g_user[g] = ifx t[0].groups[g].open then 1 else 2; } }
  for k: 0..<t[0].nt { if k < ui[0].built_tools && t[0].tools[k].open != ui[0].t_set[k] { ui[0].t_user[k] = ifx t[0].tools[k].open then 1 else 2; } }
  t_reset(t);
  i := ui[0].first;
  in_assistant := false;
  while i < s[0].n {
    p := s[0].parts[i];
    if p.kind == P_USER { t_user(t, s_text_of(s, i)); in_assistant = false; i += 1; continue; }
    if !in_assistant { t_entry(t); in_assistant = true; }
    if p.kind == P_TEXT { t_text(t, s_text_of(s, i)); i += 1; continue; }
    if p.kind == P_NOTICE { n := t_notice(t, p.notice, s_text_of(s, i)); i += 1; continue; }
    if p.kind == P_ROUTE {
      g := t_group(t, s_text_of(s, i));
      if g < 0 { break; }
      ti := t_tool(t, g, Tool.{kind = ifx p.tk == TK_LOAD then TK_LOAD else TK_ROUTE, arg = p.arg, detail = p.detail, output = p.output, failed = p.failed, resolved = p.tk != TK_LOAD || p.resolved});
      if ti < 0 { break; }
      tu := ifx ti < T_TOOLS then ui[0].t_user[ti] else 0;
      t[0].tools[ti].open = tu == 1; ui[0].t_set[ti] = t[0].tools[ti].open;
      gu := ui[0].g_user[g];
      t[0].groups[g].open = gu == 1; ui[0].g_set[g] = t[0].groups[g].open;
      i += 1; continue;
    }
    // a run of thoughts and calls: one group
    j := i;
    while j < s[0].n && (s[0].parts[j].kind == P_THINK || s[0].parts[j].kind == P_TOOL) { j += 1; }
    g := t_group(t, s_summary(s, t, i, j));
    if g < 0 { break; }
    tail := s[0].live && j == s[0].n;
    for k: i..<j {
      q := s[0].parts[k];
      tool: Tool;
      if q.kind == P_THINK { tool = Tool.{kind = TK_THOUGHT, arg = s_text_of(s, k), resolved = true}; }
      else {
        tool = Tool.{kind = q.tk, arg = q.arg, detail = q.detail, output = q.output, failed = q.failed, resolved = q.resolved};
        if (q.tk == TK_EDIT || q.tk == TK_WRITE) && q.input.count > 0 && q.input[0] != 123 {
          hunk: [64] u8;
          d0 := t[0].nd;
          r := s_patch(t, q.input, hunk[..]);
          tool.hunk = t_pool(t, cast(string) hunk[0..<r / 1000]); tool.diff_from = d0; tool.diff_lines = t[0].nd - d0;
        } else if (q.tk == TK_EDIT || q.tk == TK_WRITE) && (q.before.count > 0 || q.after.count > 0) {
          hunk: [64] u8;
          d0 := t[0].nd;
          r := s_diff(t, q.before, q.after, hunk[..]);
          tool.hunk = t_pool(t, cast(string) hunk[0..<r / 1000]); tool.diff_from = d0; tool.diff_lines = t[0].nd - d0;
        }
      }
      ti := t_tool(t, g, tool);
      if ti < 0 { break; }
      // a thought opens while it is the live tail (keeping it in view)
      auto := tail && k + 1 == j && q.kind == P_THINK;
      u := ifx ti < T_TOOLS then ui[0].t_user[ti] else 0;
      t[0].tools[ti].open = ifx u == 0 then auto else u == 1;
      ui[0].t_set[ti] = t[0].tools[ti].open;
    }
    // the trailing group of a streaming entry stays open
    u := ui[0].g_user[g];
    t[0].groups[g].open = ifx u == 0 then tail else u == 1;
    ui[0].g_set[g] = t[0].groups[g].open;
    i = j;
  }
  ui[0].built_groups = t[0].ng; ui[0].built_tools = t[0].nt;
  t[0].pinned = t[0].pinned || s[0].live;
  s[0].changed = false;
}
// Whether the last build ran out of the transcript's room.
s_overflowed :: (t: [] Transcript) -> bool {
  return t[0].nr >= T_ROWS || t[0].ng >= T_GROUPS || t[0].nt >= T_TOOLS || t[0].nn >= T_NOTICES
      || t[0].md[0].nb >= MD_BLOCKS || t[0].md[0].n >= MD_TEXT || t[0].md[0].nr >= MD_RUNS || t[0].md[0].ni >= MD_ITEMS
      || t[0].ntext >= T_TEXTS || t[0].nbox >= T_BOXES || t[0].nsel >= T_SELS || t[0].nhit >= T_HITS;
}
// Starts the transcript at the next user message (the oldest turn leaves it); whether one is left.
s_drop_turn :: (s: [] Session, ui: [] SUi) -> bool {
  k := ui[0].first + 1;
  while k < s[0].n && s[0].parts[k].kind != P_USER { k += 1; }
  if k >= s[0].n { return false; }
  ui[0].first = k;
  for g: 0..<T_GROUPS { ui[0].g_user[g] = 0; }
  for q: 0..<T_TOOLS { ui[0].t_user[q] = 0; }
  ui[0].built_groups = 0; ui[0].built_tools = 0;
  return true;
}
// ---------------------------------------------------------------- checks

#test "the parts become Zeron's rows: the bubble, one tool group with its summary, chips open on output and diff" {
  q: [1] ClQuery; line: [8] u8; arena: [65536] u8; out: [4096] u8;
  cl_init(q[..], line[..], arena[..], out[..]);
  q[0].streaming = true;
  s: [1] Session; pool: [65536] u8;
  s_init(s[..], pool[..]);
  s_user(s[..], "Look around this folder and fix the typo in notes.txt");
  fx := CLAUDE_FIXTURE;
  s_test_feed(s[..], q[..], fx[..]);
  t: [1] Transcript; a: [1] Atlas; ui: [1] SUi;
  md_test_atlas(a[..]);
  for k: 0..<ICON_COUNT { a[0].icons[k] = GpIcon.{x = 0, y = 0, w = 36, h = 36}; }
  s_build(s[..], ui[..], t[..]);
  #assert t[0].rows[0].kind == R_USER && t[0].rows[1].kind == R_GROUP;
  g := t[0].groups[0];
  #assert g.tools == 7 && !g.open;
  #assert g.summary == "Thought process · Ran 3 commands · edited 1 file · read 1 file · searched 1 time · 1 failed";
  // the edit's chip holds its diff: the old line out, the new one in
  ed := -1;
  for k: 0..<g.tools { if t[0].tools[g.tool0 + k].kind == TK_EDIT { ed = g.tool0 + k; } }
  #assert ed >= 0 && t[0].tools[ed].diff_lines == 2 && t[0].tools[ed].hunk == "@@ -1,1 +1,1 @@";
  #assert t[0].diff[t[0].tools[ed].diff_from].kind == DL_DEL && t[0].diff[t[0].tools[ed].diff_from + 1].text == "- bread";
  // the reply follows as Markdown rows; laying it all out fits the transcript
  #assert t[0].rows[t[0].nr - 1].kind == R_MD;
  t[0].view_h = 880;
  t_set_open(t[..], 0, -1, true);
  for k: 0..<g.tools { t_set_open(t[..], 0, k, true); }
  t_layout(t[..], a[..], zeron_dark(), 292, 736, 145);
  #assert !s_overflowed(t[..]) && t[0].rows[1].h > 26 + 2 + 7 * 32;
  // opened by the user, the group stays open through the next build
  s_build(s[..], ui[..], t[..]);
  #assert t[0].groups[0].open && t[0].tools[ed].open;
}

#test "a live turn streams: the trailing group open, the thought open while it is the tail, the working trailer" {
  s: [1] Session; pool: [8192] u8;
  s_init(s[..], pool[..]);
  t: [1] Transcript; a: [1] Atlas; ui: [1] SUi;
  md_test_atlas(a[..]);
  for k: 0..<ICON_COUNT { a[0].icons[k] = GpIcon.{x = 0, y = 0, w = 36, h = 36}; }
  s_user(s[..], "hi");
  s_delta(s[..], P_THINK, "Let me ");
  s_delta(s[..], P_THINK, "look.");
  s_build(s[..], ui[..], t[..]);
  #assert s[0].n == 2 && s_text_of(s[..], 1) == "Let me look." && t[0].groups[0].open && t[0].tools[0].open;
  s_delta(s[..], P_TEXT, "Hello **there**");
  s_delta(s[..], P_TEXT, ".");
  s_build(s[..], ui[..], t[..]);
  #assert s[0].n == 3 && !t[0].groups[0].open && !t[0].tools[0].open && t[0].rows[2].kind == R_MD;
  t[0].working = true; t[0].work_secs = 75; t[0].view_h = 880;
  t_layout(t[..], a[..], zeron_dark(), 292, 736, 145);
  // the trailer: nine spinner cells, the word and "1m 15s"
  found := false;
  for k: 0..<t[0].ntext { if t[0].texts[k].text == "1m 15s" { found = true; } }
  #assert found;
  s_turn_end(s[..], false, "");
  #assert !s[0].live && s[0].parts[s[0].n - 1].kind == P_TEXT;
}

#test "STOP marks the turn stopped; a failed turn's chip reads signed out or a limit and offers Log in" {
  s: [1] Session; pool: [8192] u8;
  s_init(s[..], pool[..]);
  e: [1] Engine;
  s_user(s[..], "write a long story");
  s_delta(s[..], P_TEXT, "Once upon");
  e_stop(e[..], s[..]);
  #assert !s[0].live && s[0].parts[s[0].n - 1].kind == P_NOTICE && s[0].parts[s[0].n - 1].notice == N_STOPPED;
  s_user(s[..], "again");
  s_turn_end(s[..], true, "Not logged in · Please run /login");
  #assert s[0].parts[s[0].n - 1].notice == N_SIGNED_OUT;
  s_user(s[..], "again");
  s_turn_end(s[..], true, "You've hit your usage limit.");
  #assert s[0].parts[s[0].n - 1].notice == N_LIMIT;
  #assert s_problem("exit status 2") == N_ERROR && s_problem("HTTP 401 Unauthorized") == N_SIGNED_OUT;
  t: [1] Transcript; a: [1] Atlas; ui: [1] SUi;
  md_test_atlas(a[..]);
  for k: 0..<ICON_COUNT { a[0].icons[k] = GpIcon.{x = 0, y = 0, w = 36, h = 36}; }
  s_build(s[..], ui[..], t[..]);
  t[0].view_h = 880;
  t_layout(t[..], a[..], zeron_dark(), 292, 736, 145); t_clamp(t[..]);
  r := t[0].nr - 1;
  #assert t[0].rows[r].kind == R_NOTICE && t[0].notices[t[0].rows[r].notice].kind == N_LIMIT;
  // its Log in button asks the screen to sign in
  hit := -1;
  for k: 0..<t[0].nhit { if t[0].hits[k].kind == H_ACTION && t[0].hits[k].b == 0 && t[0].hits[k].a == t[0].rows[r].notice { hit = k; } }
  #assert hit >= 0;
  h := t[0].hits[hit];
  t_pointer(t[..], a[..], h.x + 4, h.y + t[0].offset + 4, 0, 1, false);
  t_pointer(t[..], a[..], h.x + 4, h.y + t[0].offset + 4, 2, 1, false);
  #assert t[0].action == A_LOGIN;
}

#test "tool calls decode as Zeron's harness decodes them" {
  q: [1] ClQuery; line: [8] u8; arena: [8192] u8; out: [64] u8;
  cl_init(q[..], line[..], arena[..], out[..]);
  s: [1] Session; pool: [8192] u8;
  s_init(s[..], pool[..]);
  ar := q[0].ar[..];
  s_tool_use(s[..], ar, "a", "Grep", "{\"pattern\":\"fn main\",\"path\":\"src\"}");
  s_tool_use(s[..], ar, "b", "TodoWrite", "{\"todos\":[{\"content\":\"one\",\"status\":\"completed\"},{\"content\":\"two\",\"status\":\"pending\"}]}");
  s_tool_use(s[..], ar, "c", "mcp__github__create_issue", "{\"title\":\"x\"}");
  s_tool_use(s[..], ar, "d", "Task", "{\"description\":\"Scan the repo\",\"prompt\":\"look\"}");
  s_tool_use(s[..], ar, "e", "Bash", "{\"command\":\"ls\\n  -la\"}");
  s_tool_use(s[..], ar, "f", "Frobnicate", "{}");
  #assert s[0].parts[0].tk == TK_SEARCH && s[0].parts[0].detail == "fn main in src";
  #assert s[0].parts[1].tk == TK_TODO && s[0].parts[1].detail == "1/2 done" && s[0].parts[1].arg == "[x] one\n[ ] two";
  #assert s[0].parts[2].tk == TK_MCP && s[0].parts[2].detail == "github · create_issue";
  #assert s[0].parts[3].tk == TK_AGENT && s[0].parts[3].detail == "Scan the repo";
  #assert s[0].parts[4].arg == "ls\n  -la" && s[0].parts[4].detail == "ls -la";
  #assert s[0].parts[5].tk == TK_TOOL && s[0].parts[5].detail == "Frobnicate";
  t: [1] Transcript;
  #assert s_summary(s[..], t[..], 0, 6) == "Ran 1 command · searched 1 time · updated todos · called 3 tools";
  // a write is all additions
  hunk: [64] u8;
  r := s_diff(t[..], "", "a\nb", hunk[..]);
  #assert r % 1000 == 2 && t[0].diff[0].kind == DL_ADD && cast(string) hunk[0..<r / 1000] == "@@ -0,0 +1,2 @@";
}

#test "a Codex file change's chip: the hunk header from its unified diff, its lines numbered from it" {
  s: [1] Session; pool: [1024] u8;
  s_init(s[..], pool[..]);
  s_user(s[..], "swap the milk");
  k := s_part(s[..], P_TOOL);
  // as the Codex engine leaves a fileChange (coax/lib/agent/engine/codex.coax cxe_item): the diff in input
  s[0].parts[k].tk = TK_EDIT; s[0].parts[k].id = s_put(s[..], "e1"); s[0].parts[k].arg = s_put(s[..], "/tmp/demo/work/notes.txt");
  s[0].parts[k].input = s_put(s[..], "@@ -2,2 +2,2 @@\n - bread\n-- milk\n+- oat milk\n"); s[0].parts[k].resolved = true;
  t: [1] Transcript; ui: [1] SUi;
  s_build(s[..], ui[..], t[..]);
  ed := -1;
  for j: 0..<t[0].nt { if t[0].tools[j].kind == TK_EDIT { ed = j; } }
  #assert ed >= 0 && t[0].tools[ed].hunk == "@@ -2,2 +2,2 @@" && t[0].tools[ed].diff_lines == 3;
  d := t[0].tools[ed].diff_from;
  #assert t[0].diff[d].kind == DL_CONTEXT && t[0].diff[d].text == "- bread" && t[0].diff[d + 1].kind == DL_DEL && t[0].diff[d + 1].text == "- milk";
  #assert t[0].diff[d + 2].kind == DL_ADD && t[0].diff[d + 2].text == "- oat milk";
}
