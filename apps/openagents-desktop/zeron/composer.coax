// Zeron's composer (crates/ui/src/composer.rs, its expanded new-chat form),
// drawn with gpui.coax: the 26px pill with its hairline and Tailwind's
// shadow-lg, the text area (Geist 14 on a 22.75 line, "Do anything…" in the
// faint tone, the accent caret 2px wide), and the actions row: the
// paperclip on the left; Full access, the Claude mark with the model and
// its effort, and Send on the right. Measurements are Zeron's constants;
// colors are Zeron Dark's (crates/theme/src/builtins.rs) on its opaque
// surface. It is connected to nothing: Enter clears the text.
// Based on Zeron by Wing, MIT.

#load "gpui.coax";

// composer.rs
TEXTAREA_PAD_TOP :: 16.0;   // pt-4
TEXTAREA_PAD_V :: 20.0;     // pt-4 pb-1
TEXTAREA_MIN :: 76.0;
TEXTAREA_MAX :: 260.0;
ACTIONS_ROW_HEIGHT :: 42.0; // 2 + 32 + 8
ACTIONS_BOTTOM_PAD :: 8.0;
PILL_BORDER_V :: 2.0;
COMPOSER_RADIUS :: 26.0;
COMPOSER_MAX_WIDTH :: 768.0;
INPUT_LINE_HEIGHT :: 22.75;
INPUT_TEXT_SIZE :: 14.0;
CARET_BLINK :: 0.5;
ACTION_INSET :: 12.0;       // morph_cluster_inset, expanded: 8 + CLUSTER_X_DELTA
ACTION_PRIMARY_GAP :: 8.0;  // Theme::SPACE_SM
// pickers.rs trigger_chip: h-8 rounded-lg, 12px medium, 16px icon, gap 6
CHIP_HEIGHT :: 32.0;
CHIP_GAP :: 6.0;
CHIP_PAD :: 10.0;
MODEL_CHIP_PAD :: 6.0;
CHIP_ICON :: 16.0;
CHIP_TEXT_SIZE :: 12.0;
PICKERS_GAP :: 4.0;
SEND_SIZE :: 28.0;

PLACEHOLDER :: "Do anything…";
ACCESS_LABEL :: "Full access";
MODEL_LABEL :: "Default (recommended)";
EFFORT_LABEL :: "High";

FONT_INPUT :: 0;            // Geist 14
FONT_CHIP :: 1;             // Geist Medium 12
ICON_PAPERCLIP :: 0; ICON_ARROW_UP :: 1; ICON_CLAUDE :: 2;
ICON_NAMES :: [3] string.["paperclip", "arrow-up", "claude-mark"];
ICON_SIZES :: [3] f32.[18, 14, 16];
FONT_SIZES :: [2] f32.[14, 12];
FONT_WEIGHTS :: [2] int.[0, 1];   // 0 Geist, 1 Geist Medium

COMPOSER_TEXT :: 8000;
COMPOSER_LINES :: 64;

// Zeron Dark, opaque (builtins.rs zeron_dark and theme.rs's derived roles).
Theme :: struct {
  shell: Rgba;          // the window's canvas
  surface: Rgba;        // composer_surface_bg
  border: Rgba;         // composer_surface_border
  text: Rgba; muted: Rgba; faint: Rgba;
  accent: Rgba;         // the caret
  bg: Rgba;             // Send's arrow
  claude: Rgba;         // the Claude mark (icons.rs claude_brand)
}
zeron_dark :: () -> Theme {
  return Theme.{
    shell = hex(0x0d0d0d, 1), surface = hex(0x27272a, 1), border = rgba(1, 1, 1, 26.0 / 255.0),   // zeron_theme stores alpha as a byte: 0.10 is 26
    text = hex(0xe8e8ea, 1), muted = hex(0xa9a9ae, 1), faint = hex(0x85858a, 1),
    accent = hex(0x8b7cf6, 1), bg = hex(0x060606, 1), claude = hex(0xd97757, 1)};
}

Composer :: struct {
  text: [COMPOSER_TEXT] u8; n: int;
  caret: int;                   // a byte offset on a code point boundary
  focused: bool;
  since: f32;                   // seconds since the last keystroke or caret move (the blink)
  sent: int;                    // messages Enter has cleared
  // where it was last drawn (logical px), for the pointer
  x: f32; y: f32; w: f32; h: f32;
  text_x: f32; text_y: f32; text_w: f32;
  line_at: [COMPOSER_LINES] int; line_end: [COMPOSER_LINES] int; lines: int;
}

typed :: (c: [] Composer) -> string { return cast(string) c[0].text[0..<c[0].n]; }

// ---------------------------------------------------------------- editing

composer_insert :: (c: [] Composer, s: string) {
  if s.count == 0 || c[0].n + s.count > COMPOSER_TEXT { return; }
  k := c[0].n;
  while k > c[0].caret { k -= 1; c[0].text[k + s.count] = c[0].text[k]; }
  for i: 0..<s.count { c[0].text[c[0].caret + i] = s[i]; }
  c[0].n += s.count; c[0].caret += s.count; c[0].since = 0;
}
// Removes bytes [from, to).
composer_cut :: (c: [] Composer, from: int, to: int) {
  if from < 0 || to > c[0].n || from >= to { return; }
  gone := to - from;
  for k: to..<c[0].n { c[0].text[k - gone] = c[0].text[k]; }
  c[0].n -= gone;
  if c[0].caret >= to { c[0].caret -= gone; } else if c[0].caret > from { c[0].caret = from; }
  c[0].since = 0;
}
// The code point boundary before / after byte i.
prev_boundary :: (c: [] Composer, i: int) -> int {
  if i <= 0 { return 0; }
  k := i - 1;
  while k > 0 && (c[0].text[k] & 0xC0) == 0x80 { k -= 1; }
  return k;
}
next_boundary :: (c: [] Composer, i: int) -> int {
  if i >= c[0].n { return c[0].n; }
  k := i + 1;
  while k < c[0].n && (c[0].text[k] & 0xC0) == 0x80 { k += 1; }
  return k;
}
// The start of the word before byte i (Alt+Backspace, Alt+Left).
word_start :: (c: [] Composer, i: int) -> int {
  k := i;
  while k > 0 && (c[0].text[k - 1] == ' ' || c[0].text[k - 1] == '\n') { k -= 1; }
  while k > 0 && c[0].text[k - 1] != ' ' && c[0].text[k - 1] != '\n' { k -= 1; }
  return k;
}
word_end :: (c: [] Composer, i: int) -> int {
  k := i;
  while k < c[0].n && (c[0].text[k] == ' ' || c[0].text[k] == '\n') { k += 1; }
  while k < c[0].n && c[0].text[k] != ' ' && c[0].text[k] != '\n' { k += 1; }
  return k;
}

// Keys (ui.coax's numbering: -1 Escape, -2 Enter, -3 Backspace, -4 Left,
// -5 Right, -6 Up, -7 Down, -8 Home, -9 End, -12 Delete; mods 1 Shift,
// 2 Ctrl, 4 Alt, 8 Cmd). Whether the composer used the key.
composer_key :: (c: [] Composer, key: int, mods: int) -> bool {
  if !c[0].focused { return false; }
  word := (mods & 6) != 0; line := (mods & 8) != 0;
  if key == -2 {
    if c[0].n > 0 { c[0].sent += 1; c[0].n = 0; c[0].caret = 0; c[0].since = 0; }   // Send: connected to nothing
    return true;
  }
  if key == -3 {
    from := ifx line then 0 else ifx word then word_start(c, c[0].caret) else prev_boundary(c, c[0].caret);
    composer_cut(c, from, c[0].caret);
    return true;
  }
  if key == -12 {
    to := ifx line then c[0].n else ifx word then word_end(c, c[0].caret) else next_boundary(c, c[0].caret);
    composer_cut(c, c[0].caret, to);
    return true;
  }
  if key == -4 { c[0].caret = ifx line then 0 else ifx word then word_start(c, c[0].caret) else prev_boundary(c, c[0].caret); c[0].since = 0; return true; }
  if key == -5 { c[0].caret = ifx line then c[0].n else ifx word then word_end(c, c[0].caret) else next_boundary(c, c[0].caret); c[0].since = 0; return true; }
  if key == -8 || key == -6 { c[0].caret = 0; c[0].since = 0; return true; }
  if key == -9 || key == -7 { c[0].caret = c[0].n; c[0].since = 0; return true; }
  if key == -1 { c[0].focused = false; return true; }
  return false;
}

// ---------------------------------------------------------------- layout

// Wraps the text to width w (logical px) at spaces, and at newlines: each
// line's byte range into line_at / line_end. Always at least one line.
composer_wrap :: (c: [] Composer, f: GpFont, w: f32) {
  t := typed(c);
  c[0].lines = 0;
  start := 0;
  while c[0].lines < COMPOSER_LINES {
    stop := start; brk := -1; i := start;
    while i < t.count && t[i] != '\n' {
      j := next_boundary(c, i);
      if text_width(f, cast(string) t[start..<j]) > w && i > start {
        if brk > start { stop = brk; } else { stop = i; }
        break;
      }
      if t[i] == ' ' { brk = j; }
      i = j; stop = i;
    }
    c[0].line_at[c[0].lines] = start; c[0].line_end[c[0].lines] = stop; c[0].lines += 1;
    if stop >= t.count { break; }
    start = ifx t[stop] == '\n' then stop + 1 else stop;
    if start >= t.count && t[stop] == '\n' && c[0].lines < COMPOSER_LINES {
      c[0].line_at[c[0].lines] = start; c[0].line_end[c[0].lines] = start; c[0].lines += 1;
      break;
    }
  }
}

// The border-box height for the wrapped text: the text box (lines + pt-4 pb-1)
// clamps to 76..260, then the actions row and the hairline (composer.rs).
composer_height :: (lines: int) -> f32 {
  box := cast(f32) (ifx lines < 1 then 1 else lines) * INPUT_LINE_HEIGHT + TEXTAREA_PAD_V;
  if box < TEXTAREA_MIN { box = TEXTAREA_MIN; }
  if box > TEXTAREA_MAX { box = TEXTAREA_MAX; }
  return box + ACTIONS_ROW_HEIGHT + PILL_BORDER_V;
}

// The line holding byte offset i.
line_of :: (c: [] Composer, i: int) -> int {
  for k: 0..<c[0].lines {
    if i <= c[0].line_end[k] && (k + 1 >= c[0].lines || i < c[0].line_at[k + 1]) { return k; }
  }
  return c[0].lines - 1;
}

// A press at logical (x, y): focuses the composer when inside it and puts
// the caret nearest the press. Whether it was inside.
composer_press :: (c: [] Composer, a: [] Atlas, x: f32, y: f32) -> bool {
  inside := x >= c[0].x && x < c[0].x + c[0].w && y >= c[0].y && y < c[0].y + c[0].h;
  c[0].focused = inside;
  if !inside || !a[0].ready { return inside; }
  f := a[0].fonts[FONT_INPUT];
  k := cast(int) floor((y - c[0].text_y) / INPUT_LINE_HEIGHT);
  if k < 0 { k = 0; }
  if k >= c[0].lines { k = c[0].lines - 1; }
  t := typed(c);
  from := c[0].line_at[k];
  c[0].caret = from + text_offset(f, cast(string) t[from..<c[0].line_end[k]], x - c[0].text_x);
  c[0].since = 0;
  return true;
}

// ---------------------------------------------------------------- paint

// A trigger chip's width: padding, the optional icon and gap, the label, and
// the suffix with its gap (pickers.rs model_chip_width ceils each text).
chip_label_width :: (f: GpFont, s: string) -> f32 { return ceil(text_width(f, s)); }

// The composer at logical (x, y), width w, the column it centers in; returns
// the vertex count. dt advances the caret's blink.
paint_composer :: (out: [] f32, at: int, c: [] Composer, a: [] Atlas, th: Theme, d: f32, x: f32, y: f32, w: f32) -> int {
  if !a[0].ready { return at; }
  fi := a[0].fonts[FONT_INPUT]; fc := a[0].fonts[FONT_CHIP];
  left := x + 1 + 16; text_w := w - 2 - 32;
  composer_wrap(c, fi, text_w);
  h := composer_height(c[0].lines);
  c[0].x = x; c[0].y = y; c[0].w = w; c[0].h = h;
  c[0].text_x = left; c[0].text_y = y + 1 + TEXTAREA_PAD_TOP; c[0].text_w = text_w;
  // shadow-lg, then the pill (theme.rs: no shadow on frost, this is opaque)
  v := paint_shadow(out, at, d, x, y, w, h, COMPOSER_RADIUS, 0, 10, 15, -3, rgba(0, 0, 0, 0.1));
  v = paint_shadow(out, v, d, x, y, w, h, COMPOSER_RADIUS, 0, 4, 6, -4, rgba(0, 0, 0, 0.1));
  v = paint_quad(out, v, d, x, y, w, h, COMPOSER_RADIUS, 1, th.surface, th.border);
  // the text, or the placeholder; the caret
  t := typed(c);
  top := c[0].text_y;
  box_bottom := y + h - 1 - ACTIONS_ROW_HEIGHT - 4;
  if c[0].n == 0 {
    v = paint_text(out, v, a, d, FONT_INPUT, PLACEHOLDER, left, top, INPUT_LINE_HEIGHT, th.faint);
  } else {
    for k: 0..<c[0].lines {
      ly := top + cast(f32) k * INPUT_LINE_HEIGHT;
      if ly + INPUT_LINE_HEIGHT > box_bottom + 0.5 { break; }
      v = paint_text(out, v, a, d, FONT_INPUT, cast(string) t[c[0].line_at[k]..<c[0].line_end[k]], left, ly, INPUT_LINE_HEIGHT, th.text);
    }
  }
  if c[0].focused && cast(int) floor(c[0].since / CARET_BLINK) % 2 == 0 {
    k := line_of(c, c[0].caret);
    from := c[0].line_at[k];
    cx := left + text_x_of(fi, t, from, c[0].caret);
    v = paint_quad(out, v, d, cx, top + cast(f32) k * INPUT_LINE_HEIGHT, 2, INPUT_LINE_HEIGHT, 0, 0, th.accent, th.accent);
  }
  // the actions row: 42 tall at the pill's bottom inside the hairline, 32px items centered
  row_mid := y + h - 1 - ACTIONS_BOTTOM_PAD - CHIP_HEIGHT / 2;
  v = paint_icon(out, v, a, d, ICON_PAPERCLIP, x + 1 + ACTION_INSET, row_mid - SEND_SIZE / 2, SEND_SIZE, SEND_SIZE, th.muted);
  send_x := x + w - 1 - ACTION_INSET - SEND_SIZE;
  v = paint_quad(out, v, d, send_x, row_mid - SEND_SIZE / 2, SEND_SIZE, SEND_SIZE, SEND_SIZE / 2, 0, th.text, th.text);
  v = paint_icon(out, v, a, d, ICON_ARROW_UP, send_x, row_mid - SEND_SIZE / 2, SEND_SIZE, SEND_SIZE, th.bg);
  // the model chip: brand mark, the model in the text tone at 0.9, the effort muted at 0.7
  model_w := 2 * MODEL_CHIP_PAD + CHIP_ICON + CHIP_GAP + chip_label_width(fc, MODEL_LABEL) + CHIP_GAP + chip_label_width(fc, EFFORT_LABEL);
  mx := send_x - ACTION_PRIMARY_GAP - model_w;
  chip_top := row_mid - CHIP_HEIGHT / 2;
  lh: f32 = CHIP_TEXT_SIZE * 1.618034;   // GPUI's default line height, phi
  // Taffy rounds each layout box to whole logical pixels (GPUI layouts with rounding on)
  ly := round_half_toward_zero(row_mid - lh / 2);
  v = paint_icon(out, v, a, d, ICON_CLAUDE, mx + MODEL_CHIP_PAD, chip_top + (CHIP_HEIGHT - CHIP_ICON) / 2, CHIP_ICON, CHIP_ICON, th.claude);
  lx := mx + MODEL_CHIP_PAD + CHIP_ICON + CHIP_GAP;
  v = paint_text(out, v, a, d, FONT_CHIP, MODEL_LABEL, lx, ly, lh, opacity(th.text, 0.9));
  v = paint_text(out, v, a, d, FONT_CHIP, EFFORT_LABEL, lx + chip_label_width(fc, MODEL_LABEL) + CHIP_GAP, ly, lh, opacity(th.muted, 0.7));
  // Full access: a chip without an icon, muted while it is full access
  access_w := 2 * CHIP_PAD + text_width(fc, ACCESS_LABEL);
  ax := round_half_toward_zero(mx - PICKERS_GAP - access_w);
  v = paint_text(out, v, a, d, FONT_CHIP, ACCESS_LABEL, ax + CHIP_PAD, ly, lh, th.muted);
  return v;
}

// The pen x from byte `from` to byte `to` of t.
text_x_of :: (f: GpFont, t: string, from: int, to: int) -> f32 {
  if to <= from { return 0; }
  return text_width(f, cast(string) t[from..<to]);
}

// ---------------------------------------------------------------- checks

test_font :: (f: [] GpFont) {
  for g: 0..<GP_GLYPHS { f[0].advance[g] = 8; }
  f[0].size = 14; f[0].ascent = 13; f[0].descent = 3;
}

#test "typing inserts at the caret; Backspace and Delete take a character, a word or the line" {
  c: [1] Composer;
  c[0].focused = true;
  composer_insert(c[..], "hello world");
  #assert typed(c[..]) == "hello world" && c[0].caret == 11;
  #assert composer_key(c[..], -3, 0) && typed(c[..]) == "hello worl";
  #assert composer_key(c[..], -3, 4) && typed(c[..]) == "hello ";
  #assert composer_key(c[..], -4, 0) && composer_key(c[..], -4, 0);
  composer_insert(c[..], "X");
  #assert typed(c[..]) == "hellXo " && c[0].caret == 5;
  #assert composer_key(c[..], -12, 0) && typed(c[..]) == "hellX ";
  #assert composer_key(c[..], -3, 8) && typed(c[..]) == " " && c[0].caret == 0;
  #assert composer_key(c[..], -9, 0);
  composer_insert(c[..], "é");
  #assert c[0].n == 3 && composer_key(c[..], -3, 0) && c[0].n == 1;
}
#test "Enter sends nothing anywhere: it clears the text; an unfocused composer takes no keys" {
  c: [1] Composer;
  c[0].focused = true;
  composer_insert(c[..], "do it");
  #assert composer_key(c[..], -2, 0) && c[0].n == 0 && c[0].caret == 0 && c[0].sent == 1;
  #assert composer_key(c[..], -2, 0) && c[0].sent == 1;
  #assert composer_key(c[..], -1, 0) && !c[0].focused;
  #assert !composer_key(c[..], -3, 0);
}
#test "the height is Zeron's: 120 empty, growing a line at a time up to 304" {
  #assert composer_height(1) == 120 && composer_height(2) == 120;
  #assert composer_height(3) == 22.75 * 3 + 20 + 44;
  #assert composer_height(20) == 304;
}
#test "text wraps at spaces and at newlines" {
  f: [1] GpFont; test_font(f[..]);
  c: [1] Composer;
  composer_insert(c[..], "aaaa bbbb cc");
  composer_wrap(c[..], f[0], 80);
  #assert c[0].lines == 2 && c[0].line_at[1] == 10 && c[0].line_end[0] == 10;
  c[0].n = 0; c[0].caret = 0;
  composer_insert(c[..], "ab\ncd\n");
  composer_wrap(c[..], f[0], 800);
  #assert c[0].lines == 3 && c[0].line_end[0] == 2 && c[0].line_at[1] == 3 && c[0].line_at[2] == 6;
  #assert line_of(c[..], 6) == 2 && line_of(c[..], 1) == 0;
  c[0].n = 0; c[0].caret = 0;
  composer_wrap(c[..], f[0], 800);
  #assert c[0].lines == 1;
}
#test "the empty composer paints its pill, shadows, placeholder and actions" {
  a: [1] Atlas;
  a[0].ready = true; a[0].width = 4096; a[0].height = 4096;
  for k: 0..<GP_FONTS { for g: 0..<GP_GLYPHS { a[0].fonts[k].advance[g] = 7; } a[0].fonts[k].cell = 64; a[0].fonts[k].cols = 64; }
  for k: 0..<3 { a[0].icons[k] = GpIcon.{x = 0, y = 0, w = 36, h = 36}; }
  c: [1] Composer;
  out: [40000] f32;
  n := paint_composer(out[..], 0, c[..], a[..], zeron_dark(), 2, 292, 368, 736);
  // 2 shadows + pill + 11 placeholder glyphs (the space draws nothing) + paperclip + send + arrow + mark + 20 + 4 + 10 label glyphs
  #assert n == 6 * (3 + 11 + 4 + 20 + 4 + 10);
  #assert c[0].h == 120 && out[GP_VERTEX_FLOATS * 12 + 4] == 584 && out[GP_VERTEX_FLOATS * 12 + 5] == 736;
  #assert composer_press(c[..], a[..], 300, 400) && c[0].focused && c[0].caret == 0;
  #assert !composer_press(c[..], a[..], 10, 10) && !c[0].focused;
}
