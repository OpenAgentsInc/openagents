// The desk (docs/desktop/coax-desktop.md, "The UI, first version"): every
// session in the window, each a whole chat (screen.coax: its own composer,
// transcript and engines, running whether shown or not), the sidebar that
// lists them by folder (each row its harness mark, title, status dot and
// time; "New session" on top) and the tabs of the open ones across the top.
// The shown session draws in the space right of the sidebar: it is laid out
// at that width and its vertices moved over (dsk_shift); the pointer goes to
// it moved back. The sidebar is 208 to 400 px (256 by default), resized by
// dragging its edge and collapsed with Cmd+S. Keys: Cmd+1..9 a tab (9 the
// last), Shift+Up/Down the session above or below in the sidebar (while the
// composer is empty: there they would select). The host makes each
// session's chat (zr_new, zr_attach) and hands it over (dsk_add); New
// session, Cmd+N and Cmd+W come from its menus. Based on Zeron by Wing, MIT.

#load "screen.coax";
#load "room.coax";

DSK_MAX :: 64;
DSK_SIDEBAR_MIN :: 208.0; DSK_SIDEBAR_MAX :: 400.0; DSK_SIDEBAR_DEFAULT :: 256.0;
DSK_ROW :: 29.0;            // a session row (Zeron's compact sidebar row)
DSK_GAP :: 2.0;             // between rows (SIDEBAR_LIST_GAP)
DSK_HEADER :: 28.0;         // a folder's header (SIDEBAR_DISCLOSURE_HEADER_HEIGHT)
DSK_SECTION_GAP :: 12.0;
DSK_PAD :: 8.0;             // the sidebar's side padding
DSK_MARK :: 13.0;           // a harness mark (SIDEBAR_ACTIVE_HARNESS_ICON_SIZE)
DSK_LIGHTS :: 80.0;         // the traffic lights' width, where tabs start with the sidebar collapsed
DSK_TAB_H :: 28.0; DSK_TAB_MAX :: 200.0; DSK_TAB_MIN :: 96.0;
DSK_EDGE :: 4.0;            // the resize handle's half width
DSK_TITLE :: 160;           // bytes of a title kept
// What the host is asked to do (dsk_take_action).
DSK_HOST_NONE :: 0; DSK_HOST_PICK_FOLDER :: 1;
// A session's status.
DSK_IDLE :: 0; DSK_WORKING :: 1; DSK_WAITING :: 2; DSK_ERROR :: 3;
// What a press is on.
DSK_ON_NONE :: 0; DSK_ON_NEW :: 1; DSK_ON_ROW :: 2; DSK_ON_TAB :: 3; DSK_ON_EDGE :: 4;

DskChat :: struct {
  s: [] ZeronState;
  cwd: [1024] u8; cwd_n: int;
  active_at: f32;           // the desk's clock at its last activity
  seen_n: int;              // its session's parts at that time
  opened: f32;              // the desk's clock when it was made (its order among equals)
  was_live: bool;           // its turn was running last frame
  stops: int;               // its STOPs already passed to the room
  turn_from: int;           // its session's parts when the room's ask started there
  // a room tool it called, until answered: from its Claude Code (conn -1) or its Codex's MCP server (the host's connection)
  call_on: bool; call: int; call_conn: int; call_ask: int;
  call_args: [8192] u8; call_n: int;
  call_rpc: [64] u8; call_rpc_n: int;  // the MCP request's id, raw JSON, echoed in the answer
  title: [DSK_TITLE] u8; title_n: int;  // its title from settings.json, until a message gives it one
}
// An answer to a Codex MCP server, for the host to write to its connection.
DskOut :: struct { conn: int; line: [RM_ANSWER + 512] u8; n: int; }
DSK_OUTS :: 8;
DskHit :: struct { kind: int; i: int; x: f32; y: f32; w: f32; h: f32; }

Desk :: struct {
  chats: [DSK_MAX] DskChat; n: int;
  active: int;
  tabs: [DSK_MAX] int; ntabs: int;
  width: f32;               // the sidebar's width when open
  collapsed: bool;
  clock: f32;
  w: f32; h: f32; d: f32;   // the window, logical px, and its scale
  lx: f32; ly: f32;         // the pointer, logical px
  press: int;               // DSK_ON_* of the press in progress
  chat_press: bool;         // the press went to the shown chat (its drag and release follow)
  drag_x: f32; drag_w: f32;
  scroll: f32;              // the sidebar list scrolled up, px
  list_h: f32;              // the list's height last frame
  order: [DSK_MAX] int; norder: int;    // the sessions as the sidebar lists them, top down
  hits: [DSK_MAX * 2 + 8] DskHit; nhit: int;
  host_action: int;
  cursor: int;              // 0 arrow, 1 I-beam, 2 pointing hand, 3 resize left-right
  text: [256] u8;           // a label fitted to its width
  room: [1] Room;           // the agents' room (room.coax): agent i is chats[i]
  room_exe: [1024] u8; room_exe_n: int;     // the app's binary, which Codex runs as the room's MCP server
  room_sock: [1024] u8; room_sock_n: int;   // the host's socket it talks to
  outs: [DSK_OUTS] DskOut; nout: int;
}

dsk_init :: (k: [] Desk) {
  if k[0].width < DSK_SIDEBAR_MIN { k[0].width = DSK_SIDEBAR_DEFAULT; }
}
// The sidebar's width as drawn (0 collapsed).
dsk_side :: (k: [] Desk) -> f32 { return ifx k[0].collapsed then 0.0f32 else k[0].width; }

// A chat joins the desk, opened in a tab and shown. Its index, or -1 when full.
dsk_add :: (k: [] Desk, s: [] ZeronState, cwd: string) -> int {
  dsk_init(k);
  if k[0].n >= DSK_MAX || s.count < 1 { return -1; }
  i := k[0].n; k[0].n += 1;
  k[0].chats[i] = DskChat.{s = s, active_at = k[0].clock, opened = k[0].clock};
  n := 0;
  for c: cwd { if n < k[0].chats[i].cwd.count { k[0].chats[i].cwd[n] = c; n += 1; } }
  k[0].chats[i].cwd_n = n;
  dsk_show(k, i);
  return i;
}
dsk_chat :: (k: [] Desk) -> [] ZeronState { return k[0].chats[k[0].active].s; }
dsk_tab_of :: (k: [] Desk, i: int) -> int { for t: 0..<k[0].ntabs { if k[0].tabs[t] == i { return t; } } return -1; }
// Shows a session, opening its tab after the shown one's when it has none.
dsk_show :: (k: [] Desk, i: int) {
  if i < 0 || i >= k[0].n { return; }
  if dsk_tab_of(k, i) < 0 && k[0].ntabs < DSK_MAX {
    at := dsk_tab_of(k, k[0].active) + 1;
    if at <= 0 || at > k[0].ntabs { at = k[0].ntabs; }
    j := k[0].ntabs;
    while j > at { k[0].tabs[j] = k[0].tabs[j - 1]; j -= 1; }
    k[0].tabs[at] = i; k[0].ntabs += 1;
  }
  k[0].active = i;
  dsk_reveal(k, i);
}
// Cmd+W: the shown tab closes and its neighbour shows (the session stays in
// the sidebar, still running). False for the last tab (the host closes the window).
dsk_close_tab :: (k: [] Desk) -> bool {
  t := dsk_tab_of(k, k[0].active);
  if t < 0 || k[0].ntabs <= 1 { return false; }
  for j: t..<k[0].ntabs - 1 { k[0].tabs[j] = k[0].tabs[j + 1]; }
  k[0].ntabs -= 1;
  next := ifx t < k[0].ntabs then t else k[0].ntabs - 1;
  k[0].active = k[0].tabs[next];
  dsk_reveal(k, k[0].active);
  return true;
}
// Cmd+1..9: tab n (1-based); 9 the last.
dsk_pick_tab :: (k: [] Desk, n: int) -> bool {
  if n < 1 || n > 9 || k[0].ntabs == 0 { return false; }
  t := ifx n == 9 || n > k[0].ntabs then k[0].ntabs - 1 else n - 1;
  if n != 9 && n > k[0].ntabs { return false; }
  k[0].active = k[0].tabs[t];
  dsk_reveal(k, k[0].active);
  return true;
}
// Shift+Up/Down: the session above or below in the sidebar.
dsk_step :: (k: [] Desk, by: int) -> bool {
  dsk_sort(k);
  at := -1;
  for j: 0..<k[0].norder { if k[0].order[j] == k[0].active { at = j; } }
  to := at + by;
  if at < 0 || to < 0 || to >= k[0].norder { return false; }
  dsk_show(k, k[0].order[to]);
  return true;
}
dsk_toggle :: (k: [] Desk) { dsk_init(k); k[0].collapsed = !k[0].collapsed; }

// ---------------------------------------------------------------- a session's face

dsk_cwd :: (k: [] Desk, i: int) -> string { return cast(string) k[0].chats[i].cwd[0..<k[0].chats[i].cwd_n]; }
// The folder's last path component ("~" for the home folder's own name would hide it: the name as it is).
dsk_folder_name :: (path: string) -> string {
  end := path.count;
  while end > 1 && path[end - 1] == '/' { end -= 1; }
  start := end;
  while start > 0 && path[start - 1] != '/' { start -= 1; }
  if start >= end { return "/"; }
  return cast(string) path[start..<end];
}
dsk_same_folder :: (k: [] Desk, a: int, b: int) -> bool { return dsk_cwd(k, a) == dsk_cwd(k, b); }
// Its title: the first message, on one line; "New session" before one.
dsk_title :: (k: [] Desk, i: int) -> string {
  s := k[0].chats[i].s;
  if s[0].demo { return "Zeron's demo conversation"; }
  ss := s[0].session[..];
  for p: 0..<ss[0].n {
    if ss[0].parts[p].kind == P_USER {
      t := s_text_of(ss, p);
      e := 0;
      while e < t.count && t[e] != '\n' && e < DSK_TITLE { e += 1; }
      while e > 0 && e < t.count && (t[e] & 0xC0) == 0x80 { e -= 1; }
      return cast(string) t[0..<e];
    }
  }
  if k[0].chats[i].title_n > 0 { return cast(string) k[0].chats[i].title[0..<k[0].chats[i].title_n]; }
  return "New session";
}
dsk_status :: (k: [] Desk, i: int) -> int {
  s := k[0].chats[i].s; ss := s[0].session[..];
  if s[0].demo { return DSK_IDLE; }
  if ss[0].asking >= 0 { return DSK_WAITING; }
  if ss[0].live { return DSK_WORKING; }
  if ss[0].n > 0 && !ss[0].hint {
    p := ss[0].parts[ss[0].n - 1];
    if p.kind == P_NOTICE && p.notice != N_STOPPED && p.notice != N_META { return DSK_ERROR; }
  }
  return DSK_IDLE;
}
dsk_dot :: (status: int) -> Rgba {
  th := zeron_dark();
  if status == DSK_WORKING { return th.accent; }
  if status == DSK_WAITING { return hex(WARNING, 1); }
  if status == DSK_ERROR { return hex(DANGER, 1); }
  return opacity(th.faint, 0.5);
}
// Its time since its last activity: now, 5m, 3h, 2d.
dsk_age :: (secs: f32, out: [] u8) -> string {
  if secs < 60 { return "now"; }
  v := 0; unit: u8 = 'm';
  if secs < 3600 { v = cast(int) (secs / 60); }
  else if secs < 86400 { v = cast(int) (secs / 3600); unit = 'h'; }
  else { v = cast(int) (secs / 86400); unit = 'd'; }
  digits: [12] u8; nd := 0;
  while v > 0 || nd == 0 { digits[nd] = cast(u8) ('0' + v % 10); v /= 10; nd += 1; }
  n := 0;
  while nd > 0 && n < out.count - 1 { nd -= 1; out[n] = digits[nd]; n += 1; }
  out[n] = unit; n += 1;
  return cast(string) out[0..<n];
}
dsk_mark :: (k: [] Desk, i: int) -> int {
  s := k[0].chats[i].s;
  return mode_tab_icon(ifx s[0].demo then MODE_CLAUDE else s[0].mode);
}
dsk_mark_tint :: (k: [] Desk, i: int) -> Rgba {
  s := k[0].chats[i].s;
  return mode_tab_tint(ifx s[0].demo then MODE_CLAUDE else s[0].mode);
}

// The sidebar's order: folders by their newest session, sessions newest first.
dsk_newer :: (k: [] Desk, a: int, b: int) -> bool {
  x := k[0].chats[a]; y := k[0].chats[b];
  if x.active_at != y.active_at { return x.active_at > y.active_at; }
  if x.opened != y.opened { return x.opened > y.opened; }
  return a > b;
}
dsk_sort :: (k: [] Desk) {
  // the sessions newest first
  idx: [DSK_MAX] int;
  for i: 0..<k[0].n { idx[i] = i; }
  for i: 1..<k[0].n {
    j := i;
    while j > 0 && dsk_newer(k, idx[j], idx[j - 1]) { tmp := idx[j]; idx[j] = idx[j - 1]; idx[j - 1] = tmp; j -= 1; }
  }
  // then grouped: each folder where its newest session falls, its sessions after it
  taken: [DSK_MAX] bool;
  m := 0;
  for a: 0..<k[0].n {
    if taken[idx[a]] { continue; }
    for b: a..<k[0].n {
      if !taken[idx[b]] && dsk_same_folder(k, idx[a], idx[b]) { taken[idx[b]] = true; k[0].order[m] = idx[b]; m += 1; }
    }
  }
  k[0].norder = m;
}

// ---------------------------------------------------------------- the frame

// Every session's frame; the shown one drawn right of the sidebar, then the sidebar and tabs over it.
// An agent's name in the room: its harness and its place among that harness's sessions ("Claude 2").
dsk_agent_name :: (k: [] Desk, i: int, out: [] u8) -> string {
  names := MODE_NAMES;
  m := k[0].chats[i].s[0].mode;
  nth := 1;
  for j: 0..<i { if k[0].chats[j].s[0].mode == m { nth += 1; } }
  n := e_copy(out, 0, names[m]); n = e_copy(out, n, " ");
  n = zr_put_int(out, n, nth);
  return cast(string) out[0..<n];
}
// The agent that has that name, or -1 (any case).
dsk_agent :: (k: [] Desk, name: string) -> int {
  buf: [64] u8;
  for i: 0..<k[0].n {
    a := dsk_agent_name(k, i, buf[..]);
    if a.count != name.count { continue; }
    same := true;
    for c: 0..<a.count { x := a[c]; y := name[c]; if x >= 'A' && x <= 'Z' { x += 32; } if y >= 'A' && y <= 'Z' { y += 32; } if x != y { same = false; break; } }
    if same { return i; }
  }
  return -1;
}
// The final answer of a session's turn: its text parts since the turn began (the last one, as the SDK's result is).
dsk_turn_text :: (k: [] Desk, i: int) -> string {
  ss := k[0].chats[i].s[0].session[..];
  p := ss[0].n - 1;
  while p >= k[0].chats[i].turn_from && p >= 0 {
    if ss[0].parts[p].kind == P_TEXT { return s_text_of(ss, p); }
    if ss[0].parts[p].kind == P_NOTICE { return ""; }
    p -= 1;
  }
  return "";
}
// The room each frame: STOPs cancel asks, finished turns answer theirs, idle agents take the next ask, notes wait in the preface.
dsk_room :: (k: [] Desk) {
  r := k[0].room[..];
  r[0].agents = k[0].n;
  for i: 0..<k[0].n {
    s := k[0].chats[i].s; ss := s[0].session[..];
    s[0].engine[0].room = true;
    dsk_codex_room(k, i);
    if !s[0].ready { continue; }    // its first frame sets it up
    if s[0].stops != k[0].chats[i].stops { k[0].chats[i].stops = s[0].stops; rm_stop(r, i); }
    dsk_room_call(k, i);
    if k[0].chats[i].was_live && !ss[0].live && rm_running(r, i) >= 0 {
      t := dsk_turn_text(k, i);
      if t.count > 0 { rm_answer(r, i, false, t); }
      else { rm_answer(r, i, true, "The agent's turn ended without an answer."); }
    }
    k[0].chats[i].was_live = ss[0].live;
    if ss[0].live { continue; }
    j := rm_next(r, i);
    if j >= 0 {
      buf: [RM_TEXT + 160] u8; nb: [64] u8;
      n := e_copy(buf[..], 0, "Ask from "); n = e_copy(buf[..], n, dsk_agent_name(k, r[0].asks[j].from, nb[..]));
      n = e_copy(buf[..], n, " (your answer goes back to it): ");
      n = e_copy(buf[..], n, cast(string) r[0].asks[j].text[0..<r[0].asks[j].n]);
      dsk_take_notes(k, i);
      rm_started(r, j);
      k[0].chats[i].turn_from = ss[0].n;
      if !zr_send(s, cast(string) buf[0..<n]) { rm_answer(r, i, true, "That agent couldn't start a turn."); }
      k[0].chats[i].was_live = ss[0].live;
    } else { dsk_take_notes(k, i); }
  }
}
// A room tool an agent called (claude.coax e_room_tools): answered now, or for ask_agent when the other agent has answered.
dsk_room_call :: (k: [] Desk, i: int) {
  s := k[0].chats[i].s; e := s[0].engine[..];
  c := i;
  if !k[0].chats[c].call_on && e[0].calling {
    k[0].chats[c].call_on = true; k[0].chats[c].call = e[0].call; k[0].chats[c].call_conn = -1; k[0].chats[c].call_ask = -1;
    k[0].chats[c].call_n = e_set(k[0].chats[c].call_args[..], 0, e_call_args(e));
  }
  if !k[0].chats[c].call_on { return; }
  r := k[0].room[..];
  if k[0].chats[c].call_ask >= 0 {
    ans: [RM_ANSWER] u8; an: [1] int;
    st := rm_result(r, k[0].chats[c].call_ask, ans[..], an[..]);
    if st == RM_DONE { dsk_reply(k, i, cast(string) ans[0..<an[0]], false); }
    else if st == RM_FAILED { dsk_reply(k, i, cast(string) ans[0..<an[0]], true); }
    else if st == RM_FREE { dsk_reply(k, i, "The ask was lost.", true); }
    return;
  }
  abuf: [16384] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  args := cast(string) k[0].chats[c].call_args[0..<k[0].chats[c].call_n];
  out: [RM_ANSWER] u8; n := 0; nb: [64] u8;
  if k[0].chats[c].call == ROOM_AGENTS {
    for j: 0..<k[0].n {
      if j == i { continue; }
      names := MODE_NAMES;
      if n > 0 { n = e_copy(out[..], n, "\n"); }
      n = e_copy(out[..], n, dsk_agent_name(k, j, nb[..])); n = e_copy(out[..], n, " · ");
      n = e_copy(out[..], n, names[k[0].chats[j].s[0].mode]); n = e_copy(out[..], n, " · ");
      n = e_copy(out[..], n, dsk_cwd(k, j)); n = e_copy(out[..], n, " · ");
      n = e_copy(out[..], n, ifx k[0].chats[j].s[0].session[0].live then "busy" else "idle");
    }
    if n == 0 { n = e_copy(out[..], 0, "No other agents are in this window."); }
    dsk_reply(k, i, cast(string) out[0..<n], false);
    return;
  }
  if k[0].chats[c].call == ROOM_READ {
    since := cl_int(args, "since");
    from := rm_since(r, ifx since.ok then since.value else 0);
    for m: from..<r[0].count {
      if n > 0 { n = e_copy(out[..], n, "\n"); }
      n = e_copy(out[..], n, "#"); n = zr_put_int(out[..], n, rm_seq(r, m)); n = e_copy(out[..], n, " ");
      n = e_copy(out[..], n, dsk_agent_name(k, rm_from(r, m), nb[..])); n = e_copy(out[..], n, " → ");
      n = e_copy(out[..], n, dsk_agent_name(k, rm_to(r, m), nb[..]));
      kinds := [5] string.["", " asks", " tells", " answers", " cancels"];
      n = e_copy(out[..], n, kinds[rm_kind(r, m)]); n = e_copy(out[..], n, ": ");
      n = e_copy(out[..], n, rm_text(r, m));
    }
    if n == 0 { n = e_copy(out[..], 0, "No messages yet."); }
    dsk_reply(k, i, cast(string) out[0..<n], false);
    return;
  }
  name := cl_str(ar[..], args, "name");
  message := cl_str(ar[..], args, "message");
  to := dsk_agent(k, name);
  if to < 0 { dsk_reply(k, i, rm_error(RM_ERR_AGENT), true); return; }
  if message.count == 0 { dsk_reply(k, i, "The message is empty.", true); return; }
  if k[0].chats[c].call == ROOM_TELL {
    got := dsk_tell(k, i, to, message);
    if got < 0 { dsk_reply(k, i, rm_error(got), true); return; }
    n = e_copy(out[..], 0, "Left the note for "); n = e_copy(out[..], n, dsk_agent_name(k, to, nb[..])); n = e_copy(out[..], n, ".");
    dsk_reply(k, i, cast(string) out[0..<n], false);
    return;
  }
  id := dsk_ask(k, i, to, message);
  if id < 0 { dsk_reply(k, i, rm_error(id), true); return; }
  k[0].chats[c].call_ask = id;
}
// The answer to the room tool agent i called: to its Claude Code, or queued for the host to its Codex's MCP server.
dsk_reply :: (k: [] Desk, i: int, text: string, is_error: bool) {
  if !k[0].chats[i].call_on { return; }
  k[0].chats[i].call_on = false; k[0].chats[i].call_ask = -1;
  if k[0].chats[i].call_conn < 0 { e_room_reply(k[0].chats[i].s[0].engine[..], text, is_error); return; }
  if k[0].nout >= DSK_OUTS { return; }
  o := k[0].nout; k[0].nout += 1;
  k[0].outs[o].conn = k[0].chats[i].call_conn;
  w: [1] ClOut; w[0].buf = k[0].outs[o].line[..];
  cl_put(w[..], "{\"rpc\":"); cl_put(w[..], cast(string) k[0].chats[i].call_rpc[0..<k[0].chats[i].call_rpc_n]);
  cl_put(w[..], ",\"text\":"); cl_put_string(w[..], text);
  cl_put(w[..], ifx is_error then ",\"error\":true}" else ",\"error\":false}");
  k[0].outs[o].n = w[0].len;
}
// A line from a Codex MCP server on the host's connection: {"agent":A,"rpc":ID,"tool":NAME,"arguments":{...}}.
dsk_room_line :: (k: [] Desk, conn: int, line: string) -> bool {
  abuf: [4096] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  rpc := cl_raw(line, "rpc");
  a := cl_int(line, "agent");
  if !a.ok || a.value < 0 || a.value >= k[0].n { dsk_out_error(k, conn, rpc, "This session is no longer open in the app."); return false; }
  i := cast(int) a.value;
  if k[0].chats[i].call_on { dsk_out_error(k, conn, rpc, "Another room call from this session is still waiting."); return false; }
  names := [4] string.["agents_list", "ask_agent", "tell_agent", "room_read"];
  tool := cl_str(ar[..], line, "tool");
  t := -1;
  for j: 0..<4 { if names[j] == tool { t = j; } }
  if t < 0 { dsk_out_error(k, conn, rpc, "The room has no such tool."); return false; }
  k[0].chats[i].call_on = true; k[0].chats[i].call = t; k[0].chats[i].call_conn = conn; k[0].chats[i].call_ask = -1;
  k[0].chats[i].call_n = e_set(k[0].chats[i].call_args[..], 0, cl_raw(line, "arguments"));
  k[0].chats[i].call_rpc_n = e_set(k[0].chats[i].call_rpc[..], 0, rpc);
  return true;
}
dsk_out_error :: (k: [] Desk, conn: int, rpc: string, why: string) {
  if k[0].nout >= DSK_OUTS { return; }
  o := k[0].nout; k[0].nout += 1;
  k[0].outs[o].conn = conn;
  w: [1] ClOut; w[0].buf = k[0].outs[o].line[..];
  cl_put(w[..], "{\"rpc\":"); cl_put(w[..], ifx rpc.count > 0 then rpc else "null");
  cl_put(w[..], ",\"text\":"); cl_put_string(w[..], why); cl_put(w[..], ",\"error\":true}");
  k[0].outs[o].n = w[0].len;
}
// The Codex config that runs the room's MCP server for agent i ("" until the host gave the binary and socket).
dsk_codex_room :: (k: [] Desk, i: int) {
  x := k[0].chats[i].s[0].codex;
  if x.count < 1 { return; }
  if k[0].room_exe_n == 0 || k[0].room_sock_n == 0 { x[0].room_n = 0; return; }
  w: [1] ClOut; w[0].buf = x[0].room[..];
  num: [24] u8; nn := zr_put_int(num[..], 0, i);
  cl_put(w[..], "{\"mcp_servers.openagents_room\":{\"command\":"); cl_put_string(w[..], cast(string) k[0].room_exe[0..<k[0].room_exe_n]);
  cl_put(w[..], ",\"args\":[\"--mcp-room\","); cl_put_string(w[..], cast(string) k[0].room_sock[0..<k[0].room_sock_n]);
  cl_put(w[..], ","); cl_put_string(w[..], cast(string) num[0..<nn]);
  cl_put(w[..], "],\"tool_timeout_sec\":86400}}");
  x[0].room_n = ifx w[0].failed then 0 else w[0].len;
}

// Notes for an agent move into its chat's preface (sent before its next message).
dsk_take_notes :: (k: [] Desk, i: int) {
  s := k[0].chats[i].s;
  if r_notes(k, i) == 0 { return; }
  tmp: [RM_NOTES] u8;
  n := rm_take_notes(k[0].room[..], i, tmp[..]);
  at := s[0].preface_n;
  if at > 0 { at = e_copy(s[0].preface[..], at, "\n\n"); }
  s[0].preface_n = e_copy(s[0].preface[..], at, cast(string) tmp[0..<n]);
}
r_notes :: (k: [] Desk, i: int) -> int { return ifx i < 64 then k[0].room[0].notes[i].n else 0; }
// A tell from agent from: "Note from Claude 1: ...", queued.
dsk_tell :: (k: [] Desk, from: int, to: int, text: string) -> int {
  buf: [RM_TEXT] u8; nb: [64] u8;
  if from < 0 || from >= k[0].n { return RM_ERR_AGENT; }
  n := e_copy(buf[..], 0, "Note from "); n = e_copy(buf[..], n, dsk_agent_name(k, from, nb[..])); n = e_copy(buf[..], n, ": ");
  n = e_copy(buf[..], n, text);
  k[0].room[0].agents = k[0].n;
  return rm_tell(k[0].room[..], from, to, cast(string) buf[0..<n]);
}
dsk_ask :: (k: [] Desk, from: int, to: int, text: string) -> int {
  k[0].room[0].agents = k[0].n;
  return rm_ask(k[0].room[..], from, to, text);
}

dsk_frame :: (k: [] Desk, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int {
  dsk_init(k);
  if k[0].n == 0 { return 0; }
  d := ifx dpr < 1 then 1.0f32 else dpr;
  k[0].d = d; k[0].w = width / d; k[0].h = height / d;
  dt1 := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  k[0].clock += dt1;
  side := dsk_side(k);
  // the chat's width: the window's less the sidebar, in device px (at least a column's worth)
  cw := width - side * d;
  if cw < 320 * d { cw = 320 * d; }
  dsk_room(k);
  for i: 0..<k[0].n {
    s := k[0].chats[i].s;
    zr_tick(s, cw, height, dpr, dt1);
    ss := s[0].session[..];
    if ss[0].live || ss[0].n != k[0].chats[i].seen_n { k[0].chats[i].active_at = k[0].clock; k[0].chats[i].seen_n = ss[0].n; }
  }
  s := dsk_chat(k);
  v := zr_paint(s, out);
  dsk_shift(out, 0, v, side * d);
  a := s[0].atlas[..];
  if !a[0].ready { return v; }
  dsk_sort(k);
  k[0].nhit = 0;
  if !k[0].collapsed { v = dsk_paint_sidebar(k, out, v, a); }
  v = dsk_paint_tabs(k, out, v, a);
  dsk_update_cursor(k);
  return v;
}
// Moves vertices from..<to right by dx device px: positions, bounds, an elbow's ends, content masks.
dsk_shift :: (out: [] f32, from: int, to: int, dx: f32) {
  if dx == 0 { return; }
  for k: from..<to {
    o := k * GP_VERTEX_FLOATS;
    if o + GP_VERTEX_FLOATS > out.count { return; }
    out[o] += dx; out[o + 4] += dx;
    if out[o + 2] == GP_ELBOW { out[o + 7] += dx; }
    if out[o + 20] > -GP_NO_CLIP { out[o + 20] += dx; }
    if out[o + 22] < GP_NO_CLIP { out[o + 22] += dx; }
  }
}
dsk_hit :: (k: [] Desk, kind: int, i: int, x: f32, y: f32, w: f32, h: f32) {
  if k[0].nhit < k[0].hits.count { k[0].hits[k[0].nhit] = DskHit.{kind = kind, i = i, x = x, y = y, w = w, h = h}; k[0].nhit += 1; }
}
dsk_over :: (k: [] Desk, x: f32, y: f32, w: f32, h: f32) -> bool { return k[0].lx >= x && k[0].lx < x + w && k[0].ly >= y && k[0].ly < y + h; }
// text cut to w with "…" (on a character boundary)
dsk_fit :: (k: [] Desk, a: [] Atlas, font: int, text: string, w: f32) -> string {
  if text_width(a, font, text) <= w { return text; }
  dots := "…";
  n := text.count;
  if n > k[0].text.count - dots.count { n = k[0].text.count - dots.count; }
  while n > 0 {
    n -= 1;
    while n > 0 && (text[n] & 0xC0) == 0x80 { n -= 1; }
    for j: 0..<n { k[0].text[j] = text[j]; }
    for j: 0..<dots.count { k[0].text[n + j] = dots[j]; }
    s := cast(string) k[0].text[0..<n + dots.count];
    if text_width(a, font, s) <= w { return s; }
  }
  return dots;
}

dsk_paint_sidebar :: (k: [] Desk, out: [] f32, at: int, a: [] Atlas) -> int {
  th := zeron_dark(); d := k[0].d;
  w := k[0].width; h := k[0].h;
  v := paint_quad(out, at, d, 0, 0, w, h, 0, 0, th.bg, th.bg);
  v = paint_quad(out, v, d, w - 1, 0, 1, h, 0, 0, th.border, th.border);
  y: f32 = TITLEBAR_HEIGHT + 4;
  // New session
  x: f32 = DSK_PAD; rw := w - 2 * DSK_PAD;
  if dsk_over(k, x, y, rw, DSK_ROW) { v = paint_quad(out, v, d, x, y, rw, DSK_ROW, 6, 0, rgba(1, 1, 1, 0.06), rgba(1, 1, 1, 0.06)); }
  v = paint_icon(out, v, a, d, ICON_PEN, x + 8, y + (DSK_ROW - 14) / 2, 14, 14, th.muted);
  v = paint_text(out, v, a, d, FONT_MENU, "New session", x + 8 + 14 + 8, y, DSK_ROW, th.text);
  dsk_hit(k, DSK_ON_NEW, -1, x, y, rw, DSK_ROW);
  y += DSK_ROW + DSK_SECTION_GAP;
  // the list, scrolled, under New session
  top := y;
  first := v;
  total: f32 = 0;
  ly := top - k[0].scroll;
  prev := -1;
  age: [16] u8;
  for j: 0..<k[0].norder {
    i := k[0].order[j];
    if prev < 0 || !dsk_same_folder(k, prev, i) {
      if prev >= 0 { ly += DSK_SECTION_GAP; total += DSK_SECTION_GAP; }
      v = paint_icon(out, v, a, d, ICON_FOLDER, x + 8, ly + (DSK_HEADER - DSK_MARK) / 2, DSK_MARK, DSK_MARK, th.faint);
      v = paint_text(out, v, a, d, FONT_CHIP, dsk_fit(k, a, FONT_CHIP, dsk_folder_name(dsk_cwd(k, i)), rw - 16 - DSK_MARK - 8), x + 8 + DSK_MARK + 8, ly, DSK_HEADER, th.faint);
      ly += DSK_HEADER; total += DSK_HEADER;
    }
    prev = i;
    shown := i == k[0].active;
    hover := dsk_over(k, x, ly, rw, DSK_ROW) && k[0].ly >= top;
    if shown || hover { fill := rgba(1, 1, 1, ifx shown then 0.08f32 else 0.05f32); v = paint_quad(out, v, d, x, ly, rw, DSK_ROW, 6, 0, fill, fill); }
    v = paint_icon(out, v, a, d, dsk_mark(k, i), x + 8, ly + (DSK_ROW - DSK_MARK) / 2, DSK_MARK, DSK_MARK, dsk_mark_tint(k, i));
    when := dsk_age(k[0].clock - k[0].chats[i].active_at, age[..]);
    tw := text_width(a, FONT_SMALL, when);
    tx := x + rw - 8 - tw;
    v = paint_text(out, v, a, d, FONT_SMALL, when, tx, ly, DSK_ROW, th.faint);
    dot := 6.0f32; dx := tx - 8 - dot;
    v = paint_quad(out, v, d, dx, ly + (DSK_ROW - dot) / 2, dot, dot, dot / 2, 0, dsk_dot(dsk_status(k, i)), dsk_dot(dsk_status(k, i)));
    title_x := x + 8 + DSK_MARK + 8;
    v = paint_text(out, v, a, d, FONT_MENU, dsk_fit(k, a, FONT_MENU, dsk_title(k, i), dx - 8 - title_x), title_x, ly, DSK_ROW, ifx shown then th.text else th.muted);
    if ly + DSK_ROW > top && ly < h { dsk_hit(k, DSK_ON_ROW, i, x, ly, rw, DSK_ROW); }
    ly += DSK_ROW + DSK_GAP; total += DSK_ROW + DSK_GAP;
  }
  k[0].list_h = total;
  gp_clip(out, first, v, d, 0, top, w, h - top);
  // the edge: drag to resize
  dsk_hit(k, DSK_ON_EDGE, -1, w - DSK_EDGE, 0, 2 * DSK_EDGE, h);
  return v;
}

dsk_paint_tabs :: (k: [] Desk, out: [] f32, at: int, a: [] Atlas) -> int {
  th := zeron_dark(); d := k[0].d;
  x0: f32 = DSK_LIGHTS;
  if !k[0].collapsed { x0 = k[0].width + DSK_PAD; }
  avail := k[0].w - x0 - DSK_PAD;
  if k[0].ntabs == 0 || avail <= 0 { return at; }
  tw := avail / cast(f32) k[0].ntabs;
  if tw > DSK_TAB_MAX { tw = DSK_TAB_MAX; }
  if tw < DSK_TAB_MIN { tw = DSK_TAB_MIN; }
  tw = round_layout(tw);
  y := round_layout((TITLEBAR_HEIGHT - DSK_TAB_H) / 2);
  v := at;
  first := v;
  for t: 0..<k[0].ntabs {
    i := k[0].tabs[t];
    x := x0 + cast(f32) t * (tw + 4);
    if x >= x0 + avail { break; }
    shown := i == k[0].active;
    hover := dsk_over(k, x, y, tw, DSK_TAB_H);
    if shown || hover {
      fill := rgba(1, 1, 1, ifx shown then 0.08f32 else 0.04f32);
      v = paint_quad(out, v, d, x, y, tw, DSK_TAB_H, 6, ifx shown then 1.0f32 else 0.0f32, fill, th.border);
    }
    v = paint_icon(out, v, a, d, dsk_mark(k, i), x + 10, y + (DSK_TAB_H - DSK_MARK) / 2, DSK_MARK, DSK_MARK, dsk_mark_tint(k, i));
    right := x + tw - 10;
    status := dsk_status(k, i);
    if status != DSK_IDLE {
      dot := 6.0f32;
      v = paint_quad(out, v, d, right - dot, y + (DSK_TAB_H - dot) / 2, dot, dot, dot / 2, 0, dsk_dot(status), dsk_dot(status));
      right -= dot + 8;
    }
    lx := x + 10 + DSK_MARK + 8;
    v = paint_text(out, v, a, d, FONT_CHIP, dsk_fit(k, a, FONT_CHIP, dsk_title(k, i), right - lx), lx, y, DSK_TAB_H, ifx shown then th.text else th.muted);
    dsk_hit(k, DSK_ON_TAB, i, x, y, tw, DSK_TAB_H);
  }
  gp_clip(out, first, v, d, x0, 0, avail, TITLEBAR_HEIGHT);
  return v;
}

dsk_at :: (k: [] Desk, x: f32, y: f32) -> int {
  j := k[0].nhit - 1;
  while j >= 0 {
    h := k[0].hits[j];
    if x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h { return j; }
    j -= 1;
  }
  return -1;
}
dsk_update_cursor :: (k: [] Desk) {
  j := dsk_at(k, k[0].lx, k[0].ly);
  if k[0].press == DSK_ON_EDGE || j >= 0 && k[0].hits[j].kind == DSK_ON_EDGE { k[0].cursor = 3; return; }
  if j >= 0 { k[0].cursor = 0; return; }
  if k[0].lx < dsk_side(k) { k[0].cursor = 0; return; }
  k[0].cursor = -1;     // the chat's own
}

// ---------------------------------------------------------------- input

// The pointer, device px (phase 0 down, 1 move, 2 up). A press on the sidebar
// or a tab is the desk's; any other goes to the shown chat, moved left by the
// sidebar, as do its drag and release. Whether the chat's composer took it.
dsk_pointer :: (k: [] Desk, x: f32, y: f32, phase: int, clicks: int, mods: int) -> bool {
  if k[0].n == 0 { return false; }
  d := ifx k[0].d < 1 then 1.0f32 else k[0].d;
  k[0].lx = x / d; k[0].ly = y / d;
  side := dsk_side(k);
  s := dsk_chat(k);
  if phase == 0 {
    j := dsk_at(k, k[0].lx, k[0].ly);
    if j >= 0 || k[0].lx < side {
      k[0].chat_press = false;
      k[0].press = ifx j >= 0 then k[0].hits[j].kind else DSK_ON_NONE;
      if j >= 0 {
        h := k[0].hits[j];
        if h.kind == DSK_ON_NEW { k[0].host_action = DSK_HOST_PICK_FOLDER; }
        else if h.kind == DSK_ON_ROW || h.kind == DSK_ON_TAB { dsk_show(k, h.i); }
        else if h.kind == DSK_ON_EDGE { k[0].drag_x = k[0].lx; k[0].drag_w = k[0].width; }
      }
      dsk_update_cursor(k);
      return false;
    }
    k[0].chat_press = true; k[0].press = DSK_ON_NONE;
    return coaxial_zeron_pointer(s, x - side * d, y, phase, clicks, mods);
  }
  if k[0].press == DSK_ON_EDGE {
    w := k[0].drag_w + k[0].lx - k[0].drag_x;
    k[0].width = ifx w < DSK_SIDEBAR_MIN then DSK_SIDEBAR_MIN else ifx w > DSK_SIDEBAR_MAX then DSK_SIDEBAR_MAX else w;
    if phase == 2 { k[0].press = DSK_ON_NONE; }
    dsk_update_cursor(k);
    return false;
  }
  if phase == 2 && !k[0].chat_press { k[0].press = DSK_ON_NONE; dsk_update_cursor(k); return false; }
  took := false;
  // a move over the sidebar or the tabs is the desk's hover; the chat sees it only while it holds a press
  if k[0].chat_press || (k[0].lx >= side && dsk_at(k, k[0].lx, k[0].ly) < 0) { took = coaxial_zeron_pointer(s, x - side * d, y, phase, clicks, mods); }
  if phase == 2 { k[0].chat_press = false; }
  dsk_update_cursor(k);
  return took;
}
// The wheel over the sidebar scrolls its list; elsewhere the chat's.
dsk_wheel :: (k: [] Desk, dy: f32) -> bool {
  if k[0].n == 0 { return false; }
  if k[0].lx < dsk_side(k) {
    room := k[0].h - (TITLEBAR_HEIGHT + 4 + DSK_ROW + DSK_SECTION_GAP);
    most := k[0].list_h - room;
    if most < 0 { most = 0; }
    was := k[0].scroll;
    k[0].scroll -= dy;
    if k[0].scroll < 0 { k[0].scroll = 0; }
    if k[0].scroll > most { k[0].scroll = most; }
    return k[0].scroll != was;
  }
  return coaxial_zeron_wheel(dsk_chat(k), dy);
}
// A key the desk binds: Cmd+1..9 and Cmd+S; Shift+Up/Down while the composer is empty.
dsk_key :: (k: [] Desk, key: int, mods: int) -> bool {
  if k[0].n == 0 { return false; }
  if mods == MOD_CMD && key >= '1' && key <= '9' { return dsk_pick_tab(k, key - '0'); }
  if mods == MOD_CMD && (key == 's' || key == 'S') { dsk_toggle(k); return true; }
  if mods == MOD_SHIFT && (key == KEY_UP || key == KEY_DOWN) {
    s := dsk_chat(k);
    if s[0].composer[0].n > 0 || pk_is_open(s[0].picker[..]) { return false; }
    return dsk_step(k, ifx key == KEY_UP then -1 else 1);
  }
  return false;
}
// Before the scroll is clamped, a shown row stays in view.
dsk_reveal :: (k: [] Desk, i: int) {
  dsk_sort(k);
  y: f32 = 0; prev := -1;
  for j: 0..<k[0].norder {
    c := k[0].order[j];
    if prev < 0 || !dsk_same_folder(k, prev, c) { if prev >= 0 { y += DSK_SECTION_GAP; } y += DSK_HEADER; }
    prev = c;
    if c == i {
      room := k[0].h - (TITLEBAR_HEIGHT + 4 + DSK_ROW + DSK_SECTION_GAP);
      if y < k[0].scroll { k[0].scroll = y; }
      if room > 0 && y + DSK_ROW > k[0].scroll + room { k[0].scroll = y + DSK_ROW - room; }
      return;
    }
    y += DSK_ROW + DSK_GAP;
  }
}

// ---------------------------------------------------------------- the host's calls

coaxial_desk_add :: (k: [] Desk, s: [] ZeronState, cwd: string) -> int #export_c { if k.count < 1 { return -1; } return dsk_add(k, s, cwd); }
coaxial_desk_frame :: (k: [] Desk, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c {
  if k.count < 1 || width < 1 || height < 1 { return 0; }
  return dsk_frame(k, out, width, height, dpr, dt);
}
coaxial_desk_pointer :: (k: [] Desk, x: f32, y: f32, phase: int, clicks: int, mods: int) -> bool #export_c { return k.count > 0 && dsk_pointer(k, x, y, phase, clicks, mods); }
coaxial_desk_wheel :: (k: [] Desk, dy: f32) -> bool #export_c { return k.count > 0 && dsk_wheel(k, dy); }
coaxial_desk_key :: (k: [] Desk, key: int, mods: int) -> bool #export_c { return k.count > 0 && dsk_key(k, key, mods); }
coaxial_desk_close_tab :: (k: [] Desk) -> bool #export_c { return k.count > 0 && dsk_close_tab(k); }
coaxial_desk_toggle :: (k: [] Desk) #export_c { if k.count > 0 { dsk_toggle(k); } }
coaxial_desk_active :: (k: [] Desk) -> int #export_c { return ifx k.count > 0 then k[0].active else -1; }
coaxial_desk_count :: (k: [] Desk) -> int #export_c { return ifx k.count > 0 then k[0].n else 0; }
coaxial_desk_tabs :: (k: [] Desk) -> int #export_c { return ifx k.count > 0 then k[0].ntabs else 0; }
coaxial_desk_tab :: (k: [] Desk, t: int) -> int #export_c { return ifx k.count > 0 && t >= 0 && t < k[0].ntabs then k[0].tabs[t] else -1; }
coaxial_desk_collapsed :: (k: [] Desk) -> bool #export_c { return k.count > 0 && k[0].collapsed; }
// The sidebar's width as drawn, logical px (the host moves IME rectangles by it).
coaxial_desk_side :: (k: [] Desk) -> f32 #export_c { return ifx k.count > 0 then dsk_side(k) else 0.0f32; }
// -1: the chat's own cursor; else 0 arrow, 3 resize left-right.
coaxial_desk_cursor :: (k: [] Desk) -> int #export_c { return ifx k.count > 0 then k[0].cursor else -1; }
coaxial_desk_take_action :: (k: [] Desk) -> int #export_c {
  if k.count < 1 { return 0; }
  a := k[0].host_action; k[0].host_action = DSK_HOST_NONE;
  return a;
}
// The shown session's folder, for the folder picker's start and Cmd+N.
coaxial_desk_cwd :: (k: [] Desk, out: [] u8) -> int #export_c {
  if k.count < 1 || k[0].n == 0 { return 0; }
  c := dsk_cwd(k, k[0].active);
  n := 0;
  for b: c { if n < out.count { out[n] = b; n += 1; } }
  return n;
}
// The room's MCP server for Codex: the app's binary and the host's socket.
coaxial_desk_set_room :: (k: [] Desk, exe: string, sock: string) #export_c {
  if k.count < 1 { return; }
  k[0].room_exe_n = e_set(k[0].room_exe[..], 0, exe); k[0].room_sock_n = e_set(k[0].room_sock[..], 0, sock);
}
coaxial_desk_room_line :: (k: [] Desk, conn: int, line: string) -> bool #export_c { return k.count > 0 && dsk_room_line(k, conn, line); }
// The next answer for a connection: its length (0 for none) and the connection in conn[0].
coaxial_desk_room_out :: (k: [] Desk, conn: [] int, out: [] u8) -> int #export_c {
  if k.count < 1 || k[0].nout == 0 { return 0; }
  n := e_copy(out, 0, cast(string) k[0].outs[0].line[0..<k[0].outs[0].n]);
  conn[0] = k[0].outs[0].conn;
  for j: 1..<k[0].nout { k[0].outs[j - 1] = k[0].outs[j]; }
  k[0].nout -= 1;
  return n;
}
// The app run as Codex's MCP server for the room (OpenAgents --mcp-room SOCKET AGENT): a JSON-RPC line from
// Codex in; 1 with the answer in out, 2 with the line for the app's socket in out, 0 for nothing (a notification).
coaxial_room_mcp :: (line: string, agent: int, out: [] u8, n: [] int) -> int #export_c {
  o: [1] ClOptions;
  e_room_tools(o[..]);
  server := o[0].servers[0];
  abuf: [16384] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  c := cl_mcp_call_of(ar[..], server, line);
  w: [1] ClOut; w[0].buf = out;
  if !c.reply { n[0] = 0; return 0; }
  if c.method == "tools/call" && c.tool >= 0 {
    num: [24] u8; nn := zr_put_int(num[..], 0, agent);
    cl_put(w[..], "{\"agent\":"); cl_put(w[..], cast(string) num[0..<nn]);
    cl_put(w[..], ",\"rpc\":"); cl_put(w[..], c.id);
    cl_put(w[..], ",\"tool\":"); cl_put_string(w[..], server.tools[c.tool].name);
    cl_put(w[..], ",\"arguments\":"); cl_put(w[..], ifx c.arguments.count > 0 then c.arguments else "{}"); cl_put(w[..], "}");
    n[0] = w[0].len; return 2;
  }
  done := cl_put_mcp_answer(w[..], ar[..], server, line, c);
  n[0] = w[0].len; return 1;
}
// The app's answer ({"rpc":ID,"text":T,"error":B}) as the JSON-RPC result Codex reads.
coaxial_room_mcp_result :: (reply: string, out: [] u8) -> int #export_c {
  abuf: [16384] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  w: [1] ClOut; w[0].buf = out;
  cl_put(w[..], "{\"jsonrpc\":\"2.0\",\"id\":"); cl_put(w[..], cl_raw(reply, "rpc")); cl_put(w[..], ",\"result\":");
  cl_put_tool_text(w[..], cl_str(ar[..], reply, "text"), cl_bool(reply, "error").value);
  cl_put(w[..], "}");
  return w[0].len;
}
coaxial_desk_quit :: (k: [] Desk) #export_c {
  if k.count < 1 { return; }
  for i: 0..<k[0].n { coaxial_zeron_quit(k[0].chats[i].s); }
}

// ---------------------------------------------------------------- checks

dsk_test_chat :: (s: [] ZeronState) { zr_test_screen(s); }

#test "sessions: each added one shows in a tab; Cmd+W closes the tab, never the last; Cmd+1..9 picks; Shift+Up/Down walks the sidebar" {
  k: [1] Desk;
  a: [1] ZeronState; b: [1] ZeronState; c: [1] ZeronState;
  dsk_test_chat(a[..]); dsk_test_chat(b[..]); dsk_test_chat(c[..]);
  out: [200000] f32;
  #assert dsk_add(k[..], a[..], "/Users/me/work/openagents") == 0;
  n := dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert n > 0 && k[0].ntabs == 1 && k[0].active == 0;
  #assert dsk_add(k[..], b[..], "/Users/me/work/openagents") == 1;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 1);
  #assert dsk_add(k[..], c[..], "/Users/me/zeron") == 2;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 1);
  #assert k[0].ntabs == 3 && k[0].active == 2 && k[0].tabs[2] == 2;
  // the sidebar: the newest folder first, its sessions newest first
  #assert k[0].norder == 3 && k[0].order[0] == 2 && k[0].order[1] == 1 && k[0].order[2] == 0;
  #assert dsk_folder_name(dsk_cwd(k[..], 2)) == "zeron" && dsk_folder_name("/Users/me/work/openagents/") == "openagents";
  #assert dsk_title(k[..], 0) == "New session";
  // Cmd+1, Cmd+9 (the last)
  #assert dsk_key(k[..], '1', MOD_CMD) && k[0].active == 0;
  #assert dsk_key(k[..], '9', MOD_CMD) && k[0].active == 2;
  #assert !dsk_key(k[..], '5', MOD_CMD) && k[0].active == 2;
  // Shift+Down from the top row: the next session in the sidebar
  #assert dsk_key(k[..], KEY_DOWN, MOD_SHIFT) && k[0].active == 1;
  #assert dsk_key(k[..], KEY_UP, MOD_SHIFT) && k[0].active == 2;
  #assert !dsk_key(k[..], KEY_UP, MOD_SHIFT);
  // not while the composer has text (Shift+Up selects there)
  coaxial_zeron_text(c[..], "hi");
  #assert !dsk_key(k[..], KEY_DOWN, MOD_SHIFT) && k[0].active == 2;
  // Cmd+W: the tab closes, its neighbour shows, the session stays listed
  #assert dsk_close_tab(k[..]) && k[0].ntabs == 2 && k[0].active == 1 && k[0].n == 3;
  #assert dsk_close_tab(k[..]) && k[0].ntabs == 1 && k[0].active == 0;
  #assert !dsk_close_tab(k[..]) && k[0].ntabs == 1;
  // a closed session's row opens it again in a tab
  dsk_show(k[..], 2);
  #assert k[0].ntabs == 2 && k[0].active == 2 && k[0].tabs[1] == 2;
}

#test "the sidebar: rows and tabs take presses, the edge resizes within 208..400, Cmd+S collapses it, the chat gets the rest" {
  k: [1] Desk;
  a: [1] ZeronState; b: [1] ZeronState;
  dsk_test_chat(a[..]); dsk_test_chat(b[..]);
  out: [200000] f32;
  i := dsk_add(k[..], a[..], "/w/one");
  i = dsk_add(k[..], b[..], "/w/two");
  n := dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  // the chat is laid out right of the 256px sidebar: its composer's column centred in 1064px
  #assert a[0].width == 2640 - 512 && b[0].width == 2640 - 512;
  #assert b[0].composer[0].x == round_layout((1064 - 736) / 2);
  // New session asks the host for a folder
  nh := -1; row := -1; tab := -1;
  for j: 0..<k[0].nhit {
    if k[0].hits[j].kind == DSK_ON_NEW { nh = j; }
    if k[0].hits[j].kind == DSK_ON_ROW && k[0].hits[j].i == 0 { row = j; }
    if k[0].hits[j].kind == DSK_ON_TAB && k[0].hits[j].i == 0 { tab = j; }
  }
  #assert nh >= 0 && row >= 0 && tab >= 0;
  h := k[0].hits[nh];
  took := dsk_pointer(k[..], (h.x + 4) * 2, (h.y + 4) * 2, 0, 1, 0);
  took = dsk_pointer(k[..], (h.x + 4) * 2, (h.y + 4) * 2, 2, 1, 0);
  #assert coaxial_desk_take_action(k[..]) == DSK_HOST_PICK_FOLDER && coaxial_desk_take_action(k[..]) == DSK_HOST_NONE;
  h = k[0].hits[row];
  took = dsk_pointer(k[..], (h.x + 4) * 2, (h.y + 4) * 2, 0, 1, 0);
  #assert k[0].active == 0;
  took = dsk_pointer(k[..], (h.x + 4) * 2, (h.y + 4) * 2, 2, 1, 0);
  // the edge: dragged far right stops at 400, far left at 208
  took = dsk_pointer(k[..], 256 * 2, 400 * 2, 0, 1, 0);
  #assert k[0].press == DSK_ON_EDGE && coaxial_desk_cursor(k[..]) == 3;
  took = dsk_pointer(k[..], 900 * 2, 400 * 2, 1, 1, 0);
  #assert k[0].width == DSK_SIDEBAR_MAX;
  took = dsk_pointer(k[..], 10 * 2, 400 * 2, 2, 1, 0);
  #assert k[0].width == DSK_SIDEBAR_MIN && k[0].press == DSK_ON_NONE;
  // Cmd+S: collapsed, the chat takes the whole width and the tabs start after the traffic lights
  #assert dsk_key(k[..], 's', MOD_CMD) && k[0].collapsed;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert a[0].width == 2640;
  for j: 0..<k[0].nhit { #assert k[0].hits[j].kind == DSK_ON_TAB && k[0].hits[j].x >= DSK_LIGHTS; }
  // a press in the chat goes to it, moved by the sidebar: the composer takes it
  #assert dsk_key(k[..], 's', MOD_CMD) && !k[0].collapsed;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  c := a[0].composer[..];
  px := (DSK_SIDEBAR_MIN + c[0].x + 40) * 2; py := (c[0].y + 20) * 2;
  #assert dsk_pointer(k[..], px, py, 0, 1, 0);
  took = dsk_pointer(k[..], px, py, 2, 1, 0);
}

#test "a session's face: its title is its first message's first line, its dot its state, its time since it was last busy" {
  age: [16] u8;
  #assert dsk_age(5, age[..]) == "now" && dsk_age(125, age[..]) == "2m" && dsk_age(7300, age[..]) == "2h" && dsk_age(200000, age[..]) == "2d";
  k: [1] Desk;
  a: [1] ZeronState;
  dsk_test_chat(a[..]);
  out: [200000] f32;
  i := dsk_add(k[..], a[..], "/w");
  n := dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  ss := a[0].session[..];
  s_user(ss, "Fix the sidebar\nand the tabs");
  #assert dsk_title(k[..], 0) == "Fix the sidebar" && dsk_status(k[..], 0) == DSK_WORKING;
  ss[0].asking = 0;
  #assert dsk_status(k[..], 0) == DSK_WAITING;
  ss[0].asking = -1;
  s_turn_end(ss, true, "exit status 2");
  #assert dsk_status(k[..], 0) == DSK_ERROR;
  s_user(ss, "again"); s_turn_end(ss, false, "");
  #assert dsk_status(k[..], 0) == DSK_IDLE;
  // shifted vertices: positions, bounds and masks move; a clip at infinity stays
  v: [56] f32;
  v[0] = 10; v[4] = 10; v[20] = -GP_NO_CLIP; v[22] = 50;
  v[28] = 1; v[30] = GP_ELBOW; v[32] = 2; v[35] = 3; v[48] = 4; v[50] = GP_NO_CLIP;
  dsk_shift(v[..], 0, 2, 100);
  #assert v[0] == 110 && v[4] == 110 && v[20] == -GP_NO_CLIP && v[22] == 150;
  #assert v[28] == 101 && v[32] == 102 && v[35] == 103 && v[48] == 104 && v[50] == GP_NO_CLIP;
}

#test "the room on the desk: an ask runs as a turn in the other session and its final text comes back; a note goes before the next message; STOP cancels" {
  k: [1] Desk;
  a: [1] ZeronState; b: [1] ZeronState;
  dsk_test_chat(a[..]); dsk_test_chat(b[..]);
  out: [200000] f32;
  i := dsk_add(k[..], a[..], "/w/one");
  i = dsk_add(k[..], b[..], "/w/two");
  nb: [64] u8;
  #assert dsk_agent_name(k[..], 0, nb[..]) == "Claude 1" && dsk_agent(k[..], "claude 2") == 1 && dsk_agent(k[..], "Codex 1") == -1;
  n := dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  id := dsk_ask(k[..], 0, 1, "Review the diff");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  bs := b[0].session[..];
  // the ask is agent 1's message now, from agent 0, and its turn is running
  #assert bs[0].live && bs[0].parts[bs[0].n - 1].kind == P_USER && s_text_of(bs, bs[0].n - 1) == "Ask from Claude 1 (your answer goes back to it): Review the diff";
  #assert dsk_ask(k[..], 1, 0, "which diff?") == RM_ERR_CYCLE;
  // its turn answers and ends
  s_delta(bs, P_TEXT, "One nit: rename x.");
  s_turn_end(bs, false, "");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  ans: [RM_ANSWER] u8; an: [1] int;
  #assert rm_result(k[0].room[..], id, ans[..], an[..]) == RM_DONE && cast(string) ans[0..<an[0]] == "One nit: rename x.";
  // a note waits for agent 0's next message, which carries it
  #assert dsk_tell(k[..], 1, 0, "Tests pass on main.") == 0;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert a[0].preface_n > 0 && zr_send(a[..], "ship it");
  as := a[0].session[..];
  #assert s_text_of(as, as[0].n - 1) == "Note from Claude 2: Tests pass on main.\n\nship it" && a[0].preface_n == 0;
  // STOP on agent 0 cancels what it waits on
  s_turn_end(as, false, "");
  id = dsk_ask(k[..], 0, 1, "again?");
  #assert id >= 0;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  zr_stop(a[..]);
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert rm_result(k[0].room[..], id, ans[..], an[..]) == RM_FAILED;
}

#test "the room's tools: an agent's ask_agent call waits for the other's answer and gets it as the tool result" {
  k: [1] Desk;
  a: [1] ZeronState; b: [1] ZeronState;
  dsk_test_chat(a[..]); dsk_test_chat(b[..]);
  out: [200000] f32;
  i := dsk_add(k[..], a[..], "/w/one");
  i = dsk_add(k[..], b[..], "/w/two");
  n := dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  e := a[0].engine[..];
  #assert e[0].room;
  // agents_list answers at once
  e[0].calling = true; e[0].call = ROOM_AGENTS; e[0].call_n = e_set(e[0].call_args[..], 0, "{}");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert !e[0].calling;
  // ask_agent waits
  e[0].calling = true; e[0].call = ROOM_ASK; e[0].call_n = e_set(e[0].call_args[..], 0, "{\"name\":\"Claude 2\",\"message\":\"Review the diff\"}");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert e[0].calling && k[0].chats[0].call_ask >= 0;
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  bs := b[0].session[..];
  #assert bs[0].live && s_text_of(bs, bs[0].n - 1) == "Ask from Claude 1 (your answer goes back to it): Review the diff";
  s_delta(bs, P_TEXT, "LGTM."); s_turn_end(bs, false, "");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert !e[0].calling && !k[0].chats[0].call_on;
  // an unknown name is an error at once
  e[0].calling = true; e[0].call = ROOM_TELL; e[0].call_n = e_set(e[0].call_args[..], 0, "{\"name\":\"Nobody\",\"message\":\"hi\"}");
  n = dsk_frame(k[..], out[..], 2640, 1760, 2, 0.016);
  #assert !e[0].calling;
}

#test "Codex's room tools: its MCP server's call goes to the app as a line, the answer comes back as the JSON-RPC result" {
  out: [20000] u8; n: [1] int;
  #assert coaxial_room_mcp("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\"}}", 1, out[..], n[..]) == 1;
  #assert coaxial_room_mcp("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}", 1, out[..], n[..]) == 0;
  #assert coaxial_room_mcp("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}", 1, out[..], n[..]) == 1;
  listed := cast(string) out[0..<n[0]];
  #assert cl_str_is(listed, "result.tools.1.name", "ask_agent");
  #assert coaxial_room_mcp("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"ask_agent\",\"arguments\":{\"name\":\"Claude 1\",\"message\":\"Is the build green?\"}}}", 1, out[..], n[..]) == 2;
  line: [20000] u8; ln := e_copy(line[..], 0, cast(string) out[0..<n[0]]);
  // the app: agent 1 (Codex) asks agent 0
  k: [1] Desk;
  a: [1] ZeronState; b: [1] ZeronState;
  dsk_test_chat(a[..]); dsk_test_chat(b[..]);
  fo: [200000] f32;
  i := dsk_add(k[..], a[..], "/w/one"); i = dsk_add(k[..], b[..], "/w/two");
  coaxial_desk_set_room(k[..], "/Applications/OpenAgents.app/Contents/MacOS/OpenAgents", "/tmp/oa-room.sock");
  f := dsk_frame(k[..], fo[..], 2640, 1760, 2, 0.016);
  #assert b[0].codex.count == 0 || b[0].codex[0].room_n > 0;
  #assert coaxial_desk_room_line(k[..], 7, cast(string) line[0..<ln]);
  f = dsk_frame(k[..], fo[..], 2640, 1760, 2, 0.016);
  f = dsk_frame(k[..], fo[..], 2640, 1760, 2, 0.016);
  as := a[0].session[..];
  #assert as[0].live && s_text_of(as, as[0].n - 1) == "Ask from Claude 2 (your answer goes back to it): Is the build green?";
  s_delta(as, P_TEXT, "Yes, green."); s_turn_end(as, false, "");
  f = dsk_frame(k[..], fo[..], 2640, 1760, 2, 0.016);
  f = dsk_frame(k[..], fo[..], 2640, 1760, 2, 0.016);
  conn: [1] int;
  rn := coaxial_desk_room_out(k[..], conn[..], out[..]);
  #assert rn > 0 && conn[0] == 7;
  res: [20000] u8;
  m := coaxial_room_mcp_result(cast(string) out[0..<rn], res[..]);
  #assert cast(string) res[0..<m] == "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"Yes, green.\"}]}}";
}
cl_str_is :: (text: string, path: string, want: string) -> bool { abuf: [4096] u8; ar: [1] ClArena; ar[0].buf = abuf[..]; return cl_str(ar[..], text, path) == want; }
