// The Linux app's dictation unit. linux/build.sh compiles this file to dictation.c, as the
// Mac's build compiles apps/shared/dictation.coax: the shared controller behind
// dictation-face.h, and what the Linux host (linux/dictation.c) asks before an effect.
// Which recorder runs for the microphone and when its pipe has failed are the CLI's rules
// (apps/openagents-cli/dictate-rules.coax). A recorder's pipe has no clock, so the time of a
// buffer's first sample is counted from the samples delivered, as `openagents dictate`
// counts it, and a recorder whose count has left the wall clock is started again. The pinned
// model is found in the shared model home
// (coax/lib/sys/openagents-paths.coax). Nothing here records, reads a file or runs a program.
//   coax/bin/coax test apps/openagents-desktop/zeron/dictation-linux.coax --library
//   coax/bin/coax mutate apps/openagents-desktop/zeron/dictation-linux.coax --root-only
#load "../../shared/dictation.coax";
#load "../../openagents-cli/dictate-rules.coax";
#load "../../../coax/lib/sys/openagents-paths.coax";
#authority;

#test "the Linux recorder is PipeWire's for the default microphone, one argument at a time" {
 want:=[13]string.["pw-record","--raw","--rate","48000","--channels","1","--format","f32","--latency","20ms","--media-category","Capture","-"];
 b:[64]u8;
 for i:0..<13 {n:=zdl_recorder_arg(i,b[..]);#assert n==want[i].count && cast(string)b[0..<n]==want[i];}
 #assert zdl_recorder_arg(13,b[..])==0 && zdl_recorder_arg(14,b[..])==0 && zdl_recorder_arg(-1,b[..])==0;
 #assert zdl_recorder_arg(0,b[0..<9])==9 && zdl_recorder_arg(0,b[0..<8])== -1 && zdl_recorder_arg(12,b[0..<0])== -1;
}
#test "a buffer's first sample is timed from the samples delivered, not from when it was read" {
 // 960 samples at 48 kHz are 20 ms: the first buffer ended when it was read
 #assert zdl_anchor(5000,960,48000)==4980 && zdl_anchor(5000,0,48000)==5000 && zdl_anchor(5000,48000,48000)==4000;
 #assert zdl_anchor(5000,320,16000)==4980 && zdl_anchor(5000,960,0)==5000 && zdl_anchor(5000,960,-1)==5000 && zdl_anchor(5000,3,1)==2000;
 #assert zdl_stamp(4980,0,48000)==4980 && zdl_stamp(4980,960,48000)==5000 && zdl_stamp(4980,48000,48000)==5980;
 #assert zdl_stamp(4980,479,48000)==4989 && zdl_stamp(4980,320,16000)==5000 && zdl_stamp(4980,960,0)==4980 && zdl_stamp(4980,960,-1)==4980 && zdl_stamp(4980,2,1)==6980;
}
#test "a recorder that delivers nothing has failed: 2 s for its first audio, 1 s between buffers" {
 #assert !zdl_stalled(2000,0,0,false) && zdl_stalled(2001,0,0,false);
 #assert !zdl_stalled(9000,0,8000,true) && zdl_stalled(9001,0,8000,true);
 #assert !zdl_stalled(3000,1000,0,false) && zdl_stalled(3001,1000,0,false);
}
#test "a recorder whose clock has left the wall clock by a quarter of a second is started again, between requests only" {
 // 48000 samples after an anchor of 1000 end at 2000
 #assert !zdl_adrift(1,2000,1000,48000,48000) && !zdl_adrift(1,2250,1000,48000,48000) && zdl_adrift(1,2251,1000,48000,48000);
 #assert !zdl_adrift(1,1750,1000,48000,48000) && zdl_adrift(1,1749,1000,48000,48000);
 for phase:[5]int.[0,2,3,4,5] {#assert !zdl_adrift(phase,9000,1000,48000,48000) && !zdl_adrift(phase,0,1000,48000,48000);}
}
#test "the model is the named folder, else the pinned one in the shared model home" {
 b:[256]u8;
 n:=zdl_model_dir("","","/home/me",b[..]);#assert cast(string)b[0..<n]=="/home/me/.openagents/models/parakeet/parakeet-tdt-0.6b-v3-541d1f99";
 n=zdl_model_dir("","/disk/models","/home/me",b[..]);#assert cast(string)b[0..<n]=="/disk/models/parakeet/parakeet-tdt-0.6b-v3-541d1f99";
 c:[16]u8;n=zdl_model_dir("x/parakeet","/disk/models","/home/me",c[..]);#assert n==10 && cast(string)c[0..<n]=="x/parakeet";
 n=zdl_model_dir("m","/disk/models","/home/me",c[..]);#assert n==1 && c[0]=='m';
 #assert zdl_model_dir("","","",b[..])==0 && zdl_model_dir("/x/parakeet","","",b[0..<10])==0 && zdl_model_dir("/x/parakeet","","",b[0..<11])==11;
 #assert zdl_model_dir("","","/home/me",b[0..<20])==0;
}

// Argument i of the recorder for the system's default microphone: its bytes in out, 0 past
// the last one, -1 when out is too short.
zdl_recorder_arg :: (i:int,out:[]u8)->int #export_c #effects(all) {
 argv:[DC_ARGS]string;n:=dc_recorder(DC_PIPEWIRE,"",argv[..]);
 for a:0..<n {
  if a!=i {continue;}
  if argv[a].count>out.count {return -1;}
  for k:0..<argv[a].count {out[k]=argv[a][k];}
  return argv[a].count;
 }
 return 0;
}
// When the first buffer's first sample was: the buffer ended as it was read.
zdl_anchor :: (now:int,count:int,rate:int)->int #export_c #effects(all) {return ifx rate>0 then now-count*1000/rate else now;}
// When the first sample of the buffer after `delivered` samples was.
zdl_stamp :: (anchor:int,delivered:int,rate:int)->int #export_c #effects(all) {return ifx rate>0 then anchor+delivered*1000/rate else anchor;}
zdl_stalled :: (now:int,opened:int,last_audio:int,any:bool)->bool #export_c #effects(all) {return dc_input_stalled(now,opened,last_audio,any);}
// The recorder's clock has left the wall clock: with its pipe read empty, its newest sample is timed more
// than 250 ms from now. Samples were dropped while the pipe was full, or its clock runs fast or slow; a
// request would then keep the wrong stretch of audio. The host starts the recorder again, which times it
// afresh, between requests only (the controller idle): mid-request that would lose the clip.
zdl_adrift :: (phase:int,now:int,anchor:int,delivered:int,rate:int)->bool #export_c #effects(all) {
 if phase!=DCT_IDLE {return false;}
 late:=now-zdl_stamp(anchor,delivered,rate);
 return late>250 || late< -250;
}
// The model's folder into out, its length, or 0 when there is none to name: OPENAGENTS_PARAKEET_MODEL
// (named) when set, else the pinned folder under OPENAGENTS_MODEL_CACHE (cache) or ~/.openagents/models.
zdl_model_dir :: (named:string,cache:string,home:string,out:[]u8)->int #export_c #effects(all) {
 if named.count>0 {
  if named.count>out.count {return 0;}
  for k:0..<named.count {out[k]=named[k];}
  return named.count;
 }
 return oa_models_path(home,cache,OA_PARAKEET_FOLDER,out).count;
}
