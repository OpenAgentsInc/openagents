// GPUI's drawing model in Coax, for the Zeron-fork UI (docs/desktop/coax-desktop.md).
// GPUI (zeronsh/zui, the renderer Zeron draws with) paints a frame as
// primitives: quads (a rounded rect with a fill and a border), drop shadows
// (a gaussian-blurred rounded rect) and monochrome sprites (glyphs and SVG
// icons, alpha masks in an atlas, tinted). These are the same three, written
// as vertices for apps/openagents-desktop/Zeron.metal, which ports GPUI's
// fragment shaders. Layout is in logical pixels; a primitive's bounds snap to
// device pixels the way GPUI's window.rs does (snap_bounds, cover_bounds).
// Two more for the transcript: the activity rail's elbow (paint_elbow, a
// quadratic bend into a straight branch, as transcript.rs paints it with a
// path) and Zeron's EdgeFade, a per-vertex fade band at the top and bottom
// of the transcript (gp_fade, floats 24..27 of a vertex). And two for
// Zeron's glass (glass.rs Plate): a vertical gradient fill (GPUI's
// linear_gradient at 180 degrees) and an inset shadow without blur, the
// lit top edge (paint_inset_shadows). An attachment chip in a line of text
// is one code point in Supplementary Private Use Area-A (GP_CHIP_BASE + its
// number): it measures and paints as Zeron's chip (composer/chip.rs), its
// label padded with no-break spaces over a pill with the icon's well.
//
// The host is GPUI's platform layer: it rasterizes Zeron's font (Geist) with
// CoreText exactly as gpui_macos/text_system.rs does (four subpixel x
// positions, the font-smoothing dilation picked from the text's luminance)
// and Zeron's SVG icons at twice their device size, into one atlas, and
// gives Coax each font's metrics and each icon's tile (gp_font_*, gp_icon).
// Based on Zeron by Wing, MIT.

GP_VERTEX_FLOATS :: 28;
GP_QUAD :: 0.0; GP_SHADOW :: 1.0; GP_SPRITE :: 2.0; GP_COLOR_SPRITE :: 3.0; GP_ELBOW :: 4.0; GP_GRADIENT :: 5.0; GP_INSET :: 6.0;
GP_NO_CLIP :: 1000000.0;
GP_SUBPIXEL :: 4;           // gpui text_system.rs SUBPIXEL_VARIANTS_X
GP_DILATIONS :: 5;          // gpui_macos glyph_dilation_for_color: levels 0..4
GP_SVG_SCALE :: 2.0;        // gpui svg_renderer.rs SMOOTH_SVG_SCALE_FACTOR
GP_FONTS :: 12;
GP_ICONS :: 40;

// The glyphs the atlas holds, in order: ASCII 32..126, then these.
GP_EXTRA :: [3] u32.[0x2026, 0x2022, 0x00A0];   // … • no-break space
GP_GLYPHS :: 98;

// The glyph cache (below): graphemes, and their rasterized cells.
GP_DYN_SLOTS :: 512;
GP_DYN_HASH :: 1024;
GP_DYN_VARIANTS :: 20;      // GP_DILATIONS * GP_SUBPIXEL
GP_DYN_MONO :: 2048;        // cells 0..<2048 in the main atlas
GP_DYN_CELLS :: 2304;       // then 256 in the color atlas
GP_CLUSTER_MAX :: 32;

// Attachment chips (composer/chip.rs): GP_CHIP_BASE + k is chip k, whose
// label and icon the composer registers (gp_set_chip). Its display is the
// side pad and the five-space icon slot, the label, two spaces of trailing
// room, all no-break spaces in the run's font.
GP_CHIPS :: 32;
GP_CHIP_LABEL :: 96;
GP_CHIP_BASE :: 0xF0000;
GP_CHIP_LEAD :: 6;          // MENTION_SIDE_PAD + CHIP_ICON_SLOT
GP_CHIP_TRAIL :: 2;         // CHIP_TRAILING_PAD
GP_NBSP :: 97;              // the no-break space's glyph
GpChip :: struct { n: int; label: [GP_CHIP_LABEL] u8; icon: int; tint: Rgba; }

// A grapheme the atlas lacks: its bytes in a font, the advance the host
// measured, whether it is a color glyph, and its cells (cell + 1 for each
// dilation and subpixel; a color glyph has one). state 0 free, 1 waiting
// for the host to measure, 2 measured.
GpCluster :: struct {
  font: int; n: int; bytes: [GP_CLUSTER_MAX] u8;
  advance: f32; color: bool; state: int; used: int;
  cell: [GP_DYN_VARIANTS] int;
}
// A rasterized cell of a cached grapheme. state 0 free, 1 waiting for the
// host to draw it, 2 ready.
GpCell :: struct { slot: int; level: int; variant: int; state: int; used: int; }

Rgba :: struct { r: f32; g: f32; b: f32; a: f32; }

// One font as the host rasterized it: its size, ascent and descent (logical
// px), each glyph's advance and the kerning of each pair (logical px), and
// where its cells are: cell device pixels square, the pen at (pen_x, pen_y)
// in a cell, the first cell at y0, cols cells to a row. A cell's index is
// (dilation * GP_SUBPIXEL + subpixel) * GP_GLYPHS + glyph.
GpFont :: struct {
  size: f32; ascent: f32; descent: f32;
  cell: f32; pen_x: f32; pen_y: f32; y0: f32; cols: int;
  advance: [GP_GLYPHS] f32;
  kern: [9604] f32;          // GP_GLYPHS * GP_GLYPHS
}

// An icon's tile in the atlas (device pixels, at GP_SVG_SCALE times its size).
GpIcon :: struct { x: f32; y: f32; w: f32; h: f32; }

Atlas :: struct {
  width: f32; height: f32;
  fonts: [GP_FONTS] GpFont;
  icons: [GP_ICONS] GpIcon;
  ready: bool;
  // the glyph cache: dyn_size-pixel cells with the pen at (dyn_pen_x,
  // dyn_pen_y), mono ones from dyn_y0 in dyn_cols columns, color ones in the
  // color atlas (color_width x color_height) in color_cols columns
  frame: int;
  clusters: [GP_DYN_SLOTS] GpCluster;
  hash: [GP_DYN_HASH] int; tombs: int;
  cells: [GP_DYN_CELLS] GpCell;
  dyn_size: f32; dyn_pen_x: f32; dyn_pen_y: f32; dyn_y0: f32; dyn_cols: int;
  color_cols: int; color_width: f32; color_height: f32;
  chips: [GP_CHIPS] GpChip;
  chip_inset: f32;          // a chip's pill inset from its row, top and bottom
}

// ---------------------------------------------------------------- colors

rgba :: (r: f32, g: f32, b: f32, a: f32) -> Rgba { return Rgba.{r = r, g = g, b = b, a = a}; }
// #rrggbb
hex :: (v: int, a: f32) -> Rgba {
  return Rgba.{r = cast(f32) ((v >> 16) & 255) / 255, g = cast(f32) ((v >> 8) & 255) / 255, b = cast(f32) (v & 255) / 255, a = a};
}
// GPUI's Hsla::opacity: the alpha times o.
opacity :: (c: Rgba, o: f32) -> Rgba { return Rgba.{r = c.r, g = c.g, b = c.b, a = c.a * o}; }
// A color over another, as one opaque color (zeron theme.rs flatten).
flatten :: (top: Rgba, under: Rgba) -> Rgba {
  a := top.a;
  return Rgba.{r = top.r * a + under.r * (1 - a), g = top.g * a + under.g * (1 - a), b = top.b * a + under.b * (1 - a), a = 1};
}
// gpui_macos glyph_dilation_for_color: CoreGraphics thickens light text more.
dilation :: (c: Rgba) -> int {
  l := 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
  level := cast(int) floor(4 * l + 0.5);
  if level < 0 { return 0; }
  if level > 4 { return 4; }
  return level;
}

// ---------------------------------------------------------------- snapping

ceil :: (v: f32) -> f32 { return -floor(-v); }

// gpui util.rs round_half_toward_zero, and the device-pixel snaps on it.
round_half_toward_zero :: (v: f32) -> f32 {
  m := ceil(abs(v) - 0.5);
  return ifx v < 0 then -m else m;
}
// Taffy's layout rounding (GPUI lays out with rounding on): each box's edges
// land on whole logical pixels, rounded half away from zero.
round_layout :: (v: f32) -> f32 { return ifx v < 0 then -floor(-v + 0.5) else floor(v + 0.5); }
snap :: (v: f32, d: f32) -> f32 { return round_half_toward_zero(v * d); }
snap_stroke :: (v: f32, d: f32) -> f32 {
  if v == 0 { return 0; }
  s := snap(v, d);
  return ifx s < 1 then 1.0f32 else s;
}

// ---------------------------------------------------------------- vertices

// Six vertices over the device rectangle (x0, y0)-(x1, y1), all carrying the
// primitive's bounds and paint; a sprite's uv runs from (u0, v0) to (u1, v1).
emit :: (out: [] f32, at: int, x0: f32, y0: f32, x1: f32, y1: f32, kind: f32, blur: f32,
         bx: f32, by: f32, bw: f32, bh: f32, radius: f32, border: f32,
         u0: f32, v0: f32, u1: f32, v1: f32, fill: Rgba, edge: Rgba) -> int {
  if at < 0 || (at + 6) * GP_VERTEX_FLOATS > out.count { return at; }
  xs := [6] f32.[x0, x1, x1, x0, x1, x0];
  ys := [6] f32.[y0, y0, y1, y0, y1, y1];
  us := [6] f32.[u0, u1, u1, u0, u1, u0];
  vs := [6] f32.[v0, v0, v1, v0, v1, v1];
  for k: 0..<6 {
    o := (at + k) * GP_VERTEX_FLOATS;
    out[o] = xs[k]; out[o + 1] = ys[k]; out[o + 2] = kind; out[o + 3] = blur;
    out[o + 4] = bx; out[o + 5] = by; out[o + 6] = bw; out[o + 7] = bh;
    out[o + 8] = radius; out[o + 9] = border; out[o + 10] = us[k]; out[o + 11] = vs[k];
    out[o + 12] = fill.r; out[o + 13] = fill.g; out[o + 14] = fill.b; out[o + 15] = fill.a;
    out[o + 16] = edge.r; out[o + 17] = edge.g; out[o + 18] = edge.b; out[o + 19] = edge.a;
    out[o + 20] = -GP_NO_CLIP; out[o + 21] = -GP_NO_CLIP; out[o + 22] = GP_NO_CLIP; out[o + 23] = GP_NO_CLIP;
    out[o + 24] = 0; out[o + 25] = 0; out[o + 26] = 0; out[o + 27] = 0;
  }
  return at + 6;
}

// GPUI's content mask: vertices from..<to draw only inside the logical
// rectangle (snapped as window.rs snapped_content_mask does).
gp_clip :: (out: [] f32, from: int, to: int, d: f32, x: f32, y: f32, w: f32, h: f32) {
  x0 := snap(x, d); y0 := snap(y, d); x1 := snap(x + w, d); y1 := snap(y + h, d);
  for k: from..<to {
    o := k * GP_VERTEX_FLOATS;
    if o + GP_VERTEX_FLOATS > out.count { return; }
    if x0 > out[o + 20] { out[o + 20] = x0; }
    if y0 > out[o + 21] { out[o + 21] = y0; }
    if x1 < out[o + 22] { out[o + 22] = x1; }
    if y1 < out[o + 23] { out[o + 23] = y1; }
  }
}

// GPUI's EdgeFade (zui shaders.metal edge_fade_alpha): vertices from..<to
// fade out toward a top and a bottom edge (logical y), each over its band;
// the alpha is the ramp squared. A band of 0 leaves that edge alone.
gp_fade :: (out: [] f32, from: int, to: int, d: f32, top: f32, band_top: f32, bottom: f32, band_bottom: f32) {
  for k: from..<to {
    o := k * GP_VERTEX_FLOATS;
    if o + GP_VERTEX_FLOATS > out.count { return; }
    out[o + 24] = top * d; out[o + 25] = band_top * d; out[o + 26] = bottom * d; out[o + 27] = band_bottom * d;
  }
}

// GPUI paint_quad: a rect of logical bounds, corner radius and border width,
// snapped to device pixels.
paint_quad :: (out: [] f32, at: int, d: f32, x: f32, y: f32, w: f32, h: f32, radius: f32, border: f32, fill: Rgba, edge: Rgba) -> int {
  if fill.a <= 0 && (border <= 0 || edge.a <= 0) { return at; }
  x0 := snap(x, d); y0 := snap(y, d);
  x1 := snap(x + w, d); y1 := snap(y + h, d);
  if x1 < x0 { x1 = x0; }
  if y1 < y0 { y1 = y0; }
  return emit(out, at, x0, y0, x1, y1, GP_QUAD, 0, x0, y0, x1 - x0, y1 - y0, radius * d, snap_stroke(border, d), 0, 0, 0, 0, fill, edge);
}

// GPUI paint_shadows for one BoxShadow under an element of logical bounds and
// radius: offset, blur radius, spread and color as in Tailwind's shadows.
paint_shadow :: (out: [] f32, at: int, d: f32, x: f32, y: f32, w: f32, h: f32, radius: f32,
                 dx: f32, dy: f32, blur: f32, spread: f32, color: Rgba) -> int {
  if color.a <= 0 { return at; }
  sx := x + dx - spread; sy := y + dy - spread;
  x0 := floor(sx * d); y0 := floor(sy * d);
  x1 := ceil((sx + w + 2 * spread) * d); y1 := ceil((sy + h + 2 * spread) * d);
  b := blur * d;
  m := 3 * b;
  return emit(out, at, x0 - m, y0 - m, x1 + m, y1 + m, GP_SHADOW, b, x0, y0, x1 - x0, y1 - y0, radius * d, 0, 0, 0, 0, 0, color, color);
}

// A quad filled with GPUI's vertical linear gradient, top to bottom (no border).
paint_gradient :: (out: [] f32, at: int, d: f32, x: f32, y: f32, w: f32, h: f32, radius: f32, top: Rgba, bottom: Rgba) -> int {
  if top.a <= 0 && bottom.a <= 0 { return at; }
  x0 := snap(x, d); y0 := snap(y, d);
  x1 := snap(x + w, d); y1 := snap(y + h, d);
  return emit(out, at, x0, y0, x1, y1, GP_GRADIENT, 0, x0, y0, x1 - x0, y1 - y0, radius * d, 0, 0, 0, 0, 0, top, bottom);
}
// GPUI paint_inset_shadows for an unblurred inset shadow offset dy down:
// the band of the shape the shape moved dy down leaves uncovered (dy 1, the
// lit top edge).
paint_inset :: (out: [] f32, at: int, d: f32, x: f32, y: f32, w: f32, h: f32, radius: f32, dy: f32, color: Rgba) -> int {
  if color.a <= 0 { return at; }
  x0 := snap(x, d); y0 := snap(y, d);
  x1 := snap(x + w, d); y1 := snap(y + h, d);
  return emit(out, at, x0, y0, x1, y1, GP_INSET, dy * d, x0, y0, x1 - x0, y1 - y0, radius * d, 0, 0, 0, 0, 0, color, color);
}

// One glass surface (glass.rs Plate): a vertical gradient, a 1px rim, an
// unblurred inset light dy down, and a soft drop under it.
GpPlate :: struct {
  top: Rgba; bottom: Rgba; rim: Rgba;
  inset: Rgba; inset_dy: f32;
  drop: Rgba; drop_dy: f32; drop_blur: f32;
}
// Plate::paint: the drop beneath, the fill with its rim, the inset light above.
paint_plate :: (out: [] f32, at: int, d: f32, x: f32, y: f32, w: f32, h: f32, radius: f32, p: GpPlate) -> int {
  v := paint_shadow(out, at, d, x, y, w, h, radius, 0, p.drop_dy, p.drop_blur, 0, p.drop);
  v = paint_gradient(out, v, d, x, y, w, h, radius, p.top, p.bottom);
  v = paint_quad(out, v, d, x, y, w, h, radius, 1, rgba(0, 0, 0, 0), p.rim);
  return paint_inset(out, v, d, x, y, w, h, radius, p.inset_dy, p.inset);
}

// The activity rail's elbow (transcript.rs activity_ribbon): a 1px ribbon
// from (x, y) down and round to (x + r, y + r) along GPUI's quadratic
// (r t^2, r (2t - t^2)), then straight on to end_x, filled as GPUI fills the
// path (antialiased coverage of a 1px-wide band). joined: the trunk carries
// on down through x, so the ribbon there is not painted twice.
paint_elbow :: (out: [] f32, at: int, d: f32, x: f32, y: f32, r: f32, end_x: f32, joined: bool, color: Rgba) -> int {
  if color.a <= 0 { return at; }
  x0 := floor((x - 1) * d); y0 := floor(y * d);
  x1 := ceil((end_x + 1) * d); y1 := ceil((y + r + 1) * d);
  return emit(out, at, x0, y0, x1, y1, GP_ELBOW, 0, x * d, y * d, r * d, end_x * d, d, ifx joined then 1.0f32 else 0.0f32, 0, 0, 0, 0, color, color);
}

// A tinted alpha mask: device rectangle, atlas tile in texels.
paint_sprite :: (out: [] f32, at: int, a: [] Atlas, x0: f32, y0: f32, x1: f32, y1: f32,
                 tx: f32, ty: f32, tw: f32, th: f32, color: Rgba) -> int {
  if color.a <= 0 || a[0].width <= 0 { return at; }
  W := a[0].width; H := a[0].height;
  return emit(out, at, x0, y0, x1, y1, GP_SPRITE, 0, x0, y0, x1 - x0, y1 - y0, 0, 0,
              tx / W, ty / H, (tx + tw) / W, (ty + th) / H, color, color);
}

// A color glyph from the color atlas, its own colors at the opacity (GPUI
// paint_emoji, polychrome_sprite_fragment).
paint_color_sprite :: (out: [] f32, at: int, a: [] Atlas, x0: f32, y0: f32, x1: f32, y1: f32,
                       tx: f32, ty: f32, tw: f32, th: f32, alpha: f32) -> int {
  if alpha <= 0 || a[0].color_width <= 0 { return at; }
  W := a[0].color_width; H := a[0].color_height;
  return emit(out, at, x0, y0, x1, y1, GP_COLOR_SPRITE, 0, x0, y0, x1 - x0, y1 - y0, 0, 0,
              tx / W, ty / H, (tx + tw) / W, (ty + th) / H, rgba(1, 1, 1, alpha), rgba(1, 1, 1, alpha));
}

// GPUI paint_svg: an icon of logical size centered in a logical box. The
// tile is GP_SVG_SCALE times the device size, drawn at half.
paint_icon :: (out: [] f32, at: int, a: [] Atlas, d: f32, icon: int, x: f32, y: f32, w: f32, h: f32, color: Rgba) -> int {
  if icon < 0 || icon >= GP_ICONS { return at; }
  t := a[0].icons[icon];
  if t.w <= 0 { return at; }
  bx := snap(x, d); by := snap(y, d); bw := snap(x + w, d) - bx; bh := snap(y + h, d) - by;
  sw := t.w / GP_SVG_SCALE; sh := t.h / GP_SVG_SCALE;
  ox := round_half_toward_zero(bx + bw / 2 - sw / 2);
  oy := round_half_toward_zero(by + bh / 2 - sh / 2);
  return paint_sprite(out, at, a, ox, oy, ox + ceil(sw), oy + ceil(sh), t.x, t.y, t.w, t.h, color);
}

// ---------------------------------------------------------------- text

Rune :: struct { code: u32; len: int; }

// The code point at byte i of UTF-8 text; a malformed byte reads as itself.
rune_at :: (text: string, i: int) -> Rune {
  b := cast(u32) text[i];
  if b < 0x80 { return Rune.{code = b, len = 1}; }
  n := ifx b >= 0xF0 then 4 else ifx b >= 0xE0 then 3 else 2;
  if b < 0xC0 || i + n > text.count { return Rune.{code = b, len = 1}; }
  mask: u32 = ifx n == 2 then 31 else ifx n == 3 then 15 else 7;
  c := b & mask;
  for k: 1..<n { c = (c << 6) | (cast(u32) text[i + k] & 63); }
  return Rune.{code = c, len = n};
}

// A code point that joins the one before it into one grapheme: combining
// marks, variation selectors, emoji skin tones and tags.
is_extend :: (c: u32) -> bool {
  return (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5C7) ||
         (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F) || (c >= 0x1AB0 && c <= 0x1AFF) ||
         (c >= 0x1DC0 && c <= 0x1DFF) || (c >= 0x20D0 && c <= 0x20FF) || (c >= 0x3099 && c <= 0x309A) ||
         (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || (c >= 0x1F3FB && c <= 0x1F3FF) ||
         (c >= 0xE0020 && c <= 0xE007F) || (c >= 0xE0100 && c <= 0xE01EF);
}
is_regional :: (c: u32) -> bool { return c >= 0x1F1E6 && c <= 0x1F1FF; }

// The bytes of the grapheme at byte i (what GPUI's caret steps over: a
// letter with its marks, an emoji with its modifiers and joiners, a flag,
// CR LF). 0 at the end.
cluster_len :: (text: string, i: int) -> int {
  if i >= text.count { return 0; }
  r := rune_at(text, i);
  k := i + r.len;
  if r.code == '\r' && k < text.count && text[k] == '\n' { return 2; }
  if r.code < 0x80 && (k >= text.count || text[k] < 0x80) { return r.len; }
  if is_regional(r.code) && k < text.count {
    r2 := rune_at(text, k);
    if is_regional(r2.code) { k += r2.len; }
  }
  while k < text.count {
    r2 := rune_at(text, k);
    if r2.code == 0x200D {
      k += r2.len;
      if k < text.count { k += rune_at(text, k).len; }
    } else if is_extend(r2.code) {
      k += r2.len;
    } else {
      break;
    }
  }
  return k - i;
}

// A code point's glyph in the atlas, or -1.
glyph_of :: (code: u32) -> int {
  if code >= 32 && code <= 126 { return cast(int) code - 32; }
  extra := GP_EXTRA;
  for k: 0..<3 { if extra[k] == code { return 95 + k; } }
  return -1;
}

// ---------------------------------------------------------------- the glyph cache
//
// Everything else (accents, other scripts, emoji: what IME and paste bring)
// is GPUI's glyph cache: a grapheme the atlas lacks gets a cluster slot the
// first frame it is measured, the host shapes it with CoreText (its advance,
// and whether it is a color glyph) and rasterizes the cells painted with it,
// in the dynamic part of the atlas (or the color atlas for emoji). It shows
// from the next frame. Slots and cells are reused least recently used.

dyn_hash_of :: (font: int, text: string, i: int, n: int) -> int {
  h := font + 7;
  for k: 0..<n { h = (h * 31 + cast(int) text[i + k]) % 1000003; }
  return h % GP_DYN_HASH;
}
dyn_same :: (c: GpCluster, font: int, text: string, i: int, n: int) -> bool {
  if c.font != font || c.n != n { return false; }
  for k: 0..<n { if c.bytes[k] != text[i + k] { return false; } }
  return true;
}
// The slot holding text[i..<i+n] in font, or -1.
dyn_find :: (a: [] Atlas, font: int, text: string, i: int, n: int) -> int {
  h := dyn_hash_of(font, text, i, n);
  for probe: 0..<GP_DYN_HASH {
    e := a[0].hash[(h + probe) % GP_DYN_HASH];
    if e == 0 { return -1; }
    if e > 0 && dyn_same(a[0].clusters[e - 1], font, text, i, n) { return e - 1; }
  }
  return -1;
}
dyn_insert :: (a: [] Atlas, slot: int) {
  c := a[0].clusters[slot];
  h := dyn_hash_of(c.font, cast(string) c.bytes[0..<c.n], 0, c.n);
  for probe: 0..<GP_DYN_HASH {
    k := (h + probe) % GP_DYN_HASH;
    if a[0].hash[k] <= 0 {
      if a[0].hash[k] < 0 { a[0].tombs -= 1; }
      a[0].hash[k] = slot + 1;
      return;
    }
  }
}
dyn_rehash :: (a: [] Atlas) {
  for k: 0..<GP_DYN_HASH { a[0].hash[k] = 0; }
  a[0].tombs = 0;
  for s: 0..<GP_DYN_SLOTS { if a[0].clusters[s].state != 0 { dyn_insert(a, s); } }
}
dyn_free_cell :: (a: [] Atlas, cell: int) {
  s := a[0].cells[cell].slot;
  if a[0].cells[cell].state != 0 && s >= 0 && s < GP_DYN_SLOTS {
    k := a[0].cells[cell].level * GP_SUBPIXEL + a[0].cells[cell].variant;
    if a[0].clusters[s].cell[k] == cell + 1 { a[0].clusters[s].cell[k] = 0; }
  }
  a[0].cells[cell].state = 0;
}
// Frees the least recently used slot not used this frame; -1 when every slot is.
dyn_alloc :: (a: [] Atlas) -> int {
  best := -1;
  for s: 0..<GP_DYN_SLOTS {
    if a[0].clusters[s].state == 0 { return s; }
    if a[0].clusters[s].used < a[0].frame && (best < 0 || a[0].clusters[s].used < a[0].clusters[best].used) { best = s; }
  }
  if best < 0 { return -1; }
  for k: 0..<GP_DYN_VARIANTS { if a[0].clusters[best].cell[k] > 0 { dyn_free_cell(a, a[0].clusters[best].cell[k] - 1); } }
  // its hash entry becomes a tombstone
  c := a[0].clusters[best];
  h := dyn_hash_of(c.font, cast(string) c.bytes[0..<c.n], 0, c.n);
  for probe: 0..<GP_DYN_HASH {
    k := (h + probe) % GP_DYN_HASH;
    if a[0].hash[k] == 0 { break; }
    if a[0].hash[k] == best + 1 { a[0].hash[k] = -1; a[0].tombs += 1; break; }
  }
  a[0].clusters[best].state = 0;
  if a[0].tombs > GP_DYN_HASH / 4 { dyn_rehash(a); }
  return best;
}
// The slot for a grapheme, made (and wanted from the host) when new; -1 when
// the cache is full this frame or the grapheme is too long.
dyn_slot :: (a: [] Atlas, font: int, text: string, i: int, n: int) -> int {
  if n > GP_CLUSTER_MAX { return -1; }
  s := dyn_find(a, font, text, i, n);
  if s < 0 {
    s = dyn_alloc(a);
    if s < 0 { return -1; }
    a[0].clusters[s].font = font; a[0].clusters[s].n = n;
    for k: 0..<n { a[0].clusters[s].bytes[k] = text[i + k]; }
    for k: 0..<GP_DYN_VARIANTS { a[0].clusters[s].cell[k] = 0; }
    a[0].clusters[s].state = 1; a[0].clusters[s].advance = 0; a[0].clusters[s].color = false;
    dyn_insert(a, s);
  }
  a[0].clusters[s].used = a[0].frame;
  return s;
}
// A ready cell of slot s for (level, variant), asking for it when missing; -1 until ready.
dyn_cell :: (a: [] Atlas, s: int, level: int, variant: int) -> int {
  color := a[0].clusters[s].color;
  k := ifx color then 0 else level * GP_SUBPIXEL + variant;
  have := a[0].clusters[s].cell[k];
  if have > 0 {
    a[0].cells[have - 1].used = a[0].frame;
    return ifx a[0].cells[have - 1].state == 2 then have - 1 else -1;
  }
  from := ifx color then GP_DYN_MONO else 0;
  to := ifx color then GP_DYN_CELLS else GP_DYN_MONO;
  best := -1;
  for c: from..<to {
    if a[0].cells[c].state == 0 { best = c; break; }
    if a[0].cells[c].used < a[0].frame && (best < 0 || a[0].cells[c].used < a[0].cells[best].used) { best = c; }
  }
  if best < 0 { return -1; }
  dyn_free_cell(a, best);
  a[0].cells[best] = GpCell.{slot = s, level = ifx color then 0 else level, variant = ifx color then 0 else variant, state = 1, used = a[0].frame};
  a[0].clusters[s].cell[k] = best + 1;
  return -1;
}
// A dynamic cell's texel origin: mono cells in the main atlas below the
// fonts and icons, color cells in the color atlas.
dyn_cell_x :: (a: [] Atlas, cell: int) -> f32 {
  if cell >= GP_DYN_MONO { return cast(f32) ((cell - GP_DYN_MONO) % a[0].color_cols) * a[0].dyn_size; }
  return cast(f32) (cell % a[0].dyn_cols) * a[0].dyn_size;
}
dyn_cell_y :: (a: [] Atlas, cell: int) -> f32 {
  if cell >= GP_DYN_MONO { return cast(f32) ((cell - GP_DYN_MONO) / a[0].color_cols) * a[0].dyn_size; }
  return a[0].dyn_y0 + cast(f32) (cell / a[0].dyn_cols) * a[0].dyn_size;
}

// One step of a shaped line: the grapheme at byte i, its bytes, its glyph
// (>= 0 in the atlas) or cache slot (slot >= 0), or attachment chip (chip
// k + 1), and its advance with any kerning against the glyph before it.
GpStep :: struct { len: int; glyph: int; slot: int; advance: f32; chip: int; }

// ---------------------------------------------------------------- attachment chips

// Registers chip k: its label and its icon (an icon slot, tinted).
gp_set_chip :: (a: [] Atlas, k: int, label: string, icon: int, tint: Rgba) {
  if k < 0 || k >= GP_CHIPS { return; }
  n := ifx label.count < GP_CHIP_LABEL then label.count else GP_CHIP_LABEL;
  // never cut a code point
  while n > 0 && n < label.count && (cast(int) label[n] & 0xC0) == 0x80 { n -= 1; }
  for i: 0..<n { a[0].chips[k].label[i] = label[i]; }
  a[0].chips[k].n = n; a[0].chips[k].icon = icon; a[0].chips[k].tint = tint;
}
gp_chip_label :: (a: [] Atlas, k: int) -> string { return cast(string) a[0].chips[k].label[0..<a[0].chips[k].n]; }
// The chip a code point is, or -1.
gp_chip_of :: (code: u32) -> int {
  if code < GP_CHIP_BASE || code >= GP_CHIP_BASE + GP_CHIPS { return -1; }
  return cast(int) (code - GP_CHIP_BASE);
}
// A chip's code point as UTF-8 (four bytes) into out at i; the next offset.
gp_chip_utf8 :: (k: int, out: [] u8, i: int) -> int {
  if i + 4 > out.count { return i; }
  c := GP_CHIP_BASE + cast(u32) k;
  out[i] = cast(u8) (0xF0 | (c >> 18)); out[i + 1] = cast(u8) (0x80 | ((c >> 12) & 63));
  out[i + 2] = cast(u8) (0x80 | ((c >> 6) & 63)); out[i + 3] = cast(u8) (0x80 | (c & 63));
  return i + 4;
}
// The chip's width in a font: the padding's no-break spaces and the label.
gp_chip_width :: (a: [] Atlas, font: int, k: int) -> f32 {
  return cast(f32) (GP_CHIP_LEAD + GP_CHIP_TRAIL) * a[0].fonts[font].advance[GP_NBSP] + text_width(a, font, gp_chip_label(a, k));
}
// paint_chip: the pill over the chip's whole display (inset from its row,
// radius 5, ink 0.09), the well (1px in, the pill's height less 2, radius
// 4, black 0.16) and the icon (14px, less for a short line) centered in it;
// then the label after the icon slot, in the run's color.
paint_chip :: (out: [] f32, at: int, a: [] Atlas, d: f32, font: int, k: int, x: f32, top: f32, line_height: f32, color: Rgba) -> int {
  inset := ifx a[0].chip_inset > 0 then a[0].chip_inset else 1.5f32;
  w := gp_chip_width(a, font, k);
  ph := line_height - 2 * inset; py := top + inset;
  v := paint_quad(out, at, d, x, py, w, ph, 5, 0, rgba(1, 1, 1, 0.09), rgba(0, 0, 0, 0));
  well := ph - 2;
  v = paint_quad(out, v, d, x + 1, py + 1, well, well, 4, 0, rgba(0, 0, 0, 0.16), rgba(0, 0, 0, 0));
  side := ifx well - 4 < 14 then well - 4 else 14.0f32;
  v = paint_icon(out, v, a, d, a[0].chips[k].icon, x + 1 + (well - side) / 2, py + 1 + (well - side) / 2, side, side, a[0].chips[k].tint);
  lead := cast(f32) GP_CHIP_LEAD * a[0].fonts[font].advance[GP_NBSP];
  return paint_text(out, v, a, d, font, gp_chip_label(a, k), x + lead, top, line_height, color);
}

gp_step :: (a: [] Atlas, font: int, text: string, i: int, prev: int) -> GpStep {
  n := cluster_len(text, i);
  r := rune_at(text, i);
  ck := gp_chip_of(r.code);
  if ck >= 0 { return GpStep.{len = n, glyph = -1, slot = -1, advance = gp_chip_width(a, font, ck), chip = ck + 1}; }
  g := ifx n == r.len then glyph_of(r.code) else -1;
  if g >= 0 {
    k := ifx prev >= 0 then a[0].fonts[font].kern[prev * GP_GLYPHS + g] else 0.0f32;
    return GpStep.{len = n, glyph = g, slot = -1, advance = k + a[0].fonts[font].advance[g]};
  }
  if r.code < 32 { return GpStep.{len = n, glyph = -1, slot = -1, advance = 0}; }   // controls draw nothing
  s := dyn_slot(a, font, text, i, n);
  if s < 0 {
    q := glyph_of('?');
    return GpStep.{len = n, glyph = q, slot = -1, advance = a[0].fonts[font].advance[q]};
  }
  adv := ifx a[0].clusters[s].state == 2 then a[0].clusters[s].advance else 0.0f32;
  return GpStep.{len = n, glyph = -1, slot = s, advance = adv};
}

// The width of text (logical px): CoreText's advances and kerning, as GPUI's
// shaped line places them.
text_width :: (a: [] Atlas, font: int, text: string) -> f32 {
  x: f32 = 0; prev := -1; i := 0;
  while i < text.count {
    st := gp_step(a, font, text, i, prev);
    x += st.advance; prev = st.glyph; i += st.len;
  }
  return x;
}

// The pen x at byte offset `upto` of text (logical px from the start).
text_x :: (a: [] Atlas, font: int, text: string, upto: int) -> f32 {
  n := ifx upto < text.count then upto else text.count;
  return text_width(a, font, cast(string) text[0..<n]);
}

// The x of the glyph at byte `upto` (its kerning included, as CoreText
// positions it; GPUI's x_for_index), or the width at the end.
text_x_at :: (a: [] Atlas, font: int, text: string, upto: int) -> f32 {
  pen: f32 = 0; prev := -1; i := 0;
  while i < text.count {
    st := gp_step(a, font, text, i, prev);
    if i >= upto { return pen + (ifx st.glyph >= 0 then st.advance - a[0].fonts[font].advance[st.glyph] else 0.0f32); }
    pen += st.advance; prev = st.glyph; i += st.len;
  }
  return pen;
}

// GPUI's closest_index_for_x: the first glyph whose x is at or past x, or
// the one before it, whichever x is nearer; past every glyph's x, the end.
text_offset :: (a: [] Atlas, font: int, text: string, x: f32) -> int {
  pen: f32 = 0; prev := -1; i := 0;
  prev_index := 0; prev_x: f32 = 0;
  while i < text.count {
    st := gp_step(a, font, text, i, prev);
    origin := pen + (ifx st.glyph >= 0 then st.advance - a[0].fonts[font].advance[st.glyph] else 0.0f32);
    if origin >= x { return ifx origin - x < x - prev_x then i else prev_index; }
    prev_index = i; prev_x = origin;
    pen += st.advance; prev = st.glyph; i += st.len;
  }
  return text.count;
}

// GPUI's line paint: glyphs of font slot `font` from logical (x, top) in a
// line box of line_height, the baseline centered as gpui line.rs does
// (top + (line_height - ascent - descent) / 2 + ascent). Each glyph's origin
// snaps to a quarter device pixel in x and a whole one in y, as
// window.rs paint_glyph does, and draws the cell rasterized for that
// subpixel and for the color's dilation. A color glyph (emoji) lands on a
// whole pixel and draws its own colors (paint_emoji).
paint_text :: (out: [] f32, at: int, a: [] Atlas, d: f32, font: int, text: string, x: f32, top: f32, line_height: f32, color: Rgba) -> int {
  if font < 0 || font >= GP_FONTS || !a[0].ready { return at; }
  baseline := top + (line_height - a[0].fonts[font].ascent - a[0].fonts[font].descent) / 2 + a[0].fonts[font].ascent;
  level := dilation(color);
  v := at; pen := x; prev := -1; i := 0;
  sub := cast(f32) GP_SUBPIXEL;
  cols := a[0].fonts[font].cols; size := a[0].fonts[font].cell;
  while i < text.count {
    st := gp_step(a, font, text, i, prev);
    r := rune_at(text, i);
    pen += st.advance - (ifx st.glyph >= 0 then a[0].fonts[font].advance[st.glyph] else st.advance);   // the kerning first
    qx := round_half_toward_zero(pen * d * sub) / sub;
    qy := round_half_toward_zero(baseline * d);
    variant := cast(int) ((qx - floor(qx)) * sub);
    ox := floor(qx); oy := qy;
    if st.chip > 0 {
      v = paint_chip(out, v, a, d, font, st.chip - 1, pen, top, line_height, color);
    } else if st.glyph >= 0 && r.code != ' ' && r.code != 0xA0 {
      cell := (level * GP_SUBPIXEL + variant) * GP_GLYPHS + st.glyph;
      tx := cast(f32) (cell % cols) * size;
      ty := a[0].fonts[font].y0 + cast(f32) (cell / cols) * size;
      v = paint_sprite(out, v, a, ox - a[0].fonts[font].pen_x, oy - a[0].fonts[font].pen_y, ox - a[0].fonts[font].pen_x + size, oy - a[0].fonts[font].pen_y + size, tx, ty, size, size, color);
    } else if st.slot >= 0 && a[0].clusters[st.slot].state == 2 && a[0].dyn_size > 0 {
      c := dyn_cell(a, st.slot, level, variant);
      if c >= 0 {
        ds := a[0].dyn_size; px := a[0].dyn_pen_x; py := a[0].dyn_pen_y;
        if c >= GP_DYN_MONO {
          ex := floor(pen * d);
          v = paint_color_sprite(out, v, a, ex - px, oy - py, ex - px + ds, oy - py + ds, dyn_cell_x(a, c), dyn_cell_y(a, c), ds, ds, color.a);
        } else {
          v = paint_sprite(out, v, a, ox - px, oy - py, ox - px + ds, oy - py + ds, dyn_cell_x(a, c), dyn_cell_y(a, c), ds, ds, color);
        }
      }
    }
    pen += ifx st.glyph >= 0 then a[0].fonts[font].advance[st.glyph] else st.advance;
    prev = st.glyph; i += st.len;
  }
  return v;
}
// ---------------------------------------------------------------- checks

#test "colors, opacity and flattening are GPUI's" {
  c := hex(0xe8e8ea, 1);
  #assert abs(c.r - 232.0 / 255.0) < 0.0001 && c.a == 1;
  #assert opacity(c, 0.35).a == 0.35;
  w := flatten(rgba(1, 1, 1, 0.1), hex(0x000000, 1));
  #assert abs(w.r - 0.1) < 0.0001 && w.a == 1;
  #assert dilation(hex(0xe8e8ea, 1)) == 4 && dilation(hex(0x060606, 1)) == 0 && dilation(hex(0xa9a9ae, 1)) == 3;
}
#test "bounds snap half toward zero, strokes to at least a device pixel" {
  #assert round_half_toward_zero(2.5) == 2 && round_half_toward_zero(2.51) == 3 && round_half_toward_zero(-2.5) == -2;
  #assert snap(10.25, 2) == 20 && snap(10.3, 2) == 21;
  #assert snap_stroke(0.25, 2) == 1 && snap_stroke(1, 2) == 2 && snap_stroke(0, 2) == 0;
}
#test "a quad is six vertices carrying its snapped bounds, radius and border" {
  out: [168] f32;
  n := paint_quad(out[..], 0, 2, 10, 20, 100, 50, 26, 1, hex(0x343438, 1), rgba(1, 1, 1, 0.1));
  #assert n == 6;
  #assert out[4] == 20 && out[5] == 40 && out[6] == 200 && out[7] == 100 && out[8] == 52 && out[9] == 2;
  #assert out[0] == 20 && out[GP_VERTEX_FLOATS * 2] == 220 && out[GP_VERTEX_FLOATS * 2 + 1] == 140;
  #assert paint_quad(out[..], 0, 2, 0, 0, 10, 10, 0, 0, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0)) == 0;
  #assert paint_quad(out[..], 18, 2, 0, 0, 10, 10, 0, 0, hex(0, 1), hex(0, 1)) == 18;   // no room
}
#test "a shadow covers three blurs past its spread bounds" {
  out: [168] f32;
  n := paint_shadow(out[..], 0, 2, 0, 0, 100, 50, 26, 0, 10, 15, -3, rgba(0, 0, 0, 0.1));
  #assert n == 6 && out[2] == GP_SHADOW && out[3] == 30;
  #assert out[4] == 6 && out[5] == 26 && out[6] == 188 && out[7] == 88;
  #assert out[0] == 6 - 90;
}
#test "text measures with advances and kerning, and finds offsets" {
  a: [1] Atlas;
  for g: 0..<GP_GLYPHS { a[0].fonts[0].advance[g] = 7; }
  a[0].fonts[0].kern[glyph_of('A') * GP_GLYPHS + glyph_of('V')] = -1;
  #assert text_width(a[..], 0, "AV") == 13 && text_width(a[..], 0, "VA") == 14;
  #assert text_width(a[..], 0, "a…") == 14;   // the ellipsis is one glyph
  #assert text_x(a[..], 0, "abc", 2) == 14 && text_x(a[..], 0, "abc", 9) == 21;
  #assert text_offset(a[..], 0, "abc", 0) == 0 && text_offset(a[..], 0, "abc", 4) == 1 && text_offset(a[..], 0, "abc", 100) == 3;
  #assert text_offset(a[..], 0, "abc", 15) == 3;            // past the last glyph's x: the end, as GPUI does
  #assert text_x_at(a[..], 0, "AV", 1) == 6 && text_x_at(a[..], 0, "AV", 2) == 13;   // the V sits kerned
  #assert glyph_of(' ') == 0 && glyph_of('~') == 94 && glyph_of(0x2026) == 95 && glyph_of(0x4e00) == -1;
}
#test "graphemes: a letter with its marks, emoji with modifiers and joiners, flags, CR LF" {
  #assert cluster_len("ab", 0) == 1 && cluster_len("", 0) == 0;
  #assert cluster_len("éx", 0) == 3;            // e + combining acute
  #assert cluster_len("👍🏽", 0) == 8;    // thumbs up, medium skin
  #assert cluster_len("👨‍👩", 0) == 11;   // man ZWJ woman
  #assert cluster_len("🇯🇵🇺", 0) == 8;   // JP, then a lone U
  #assert cluster_len("\r\nx", 0) == 2 && cluster_len("日本", 0) == 3;
}
#test "a grapheme the atlas lacks is measured by the host, then drawn from its cell" {
  a: [1] Atlas;
  a[0].ready = true; a[0].width = 1024; a[0].height = 1024; a[0].frame = 1;
  a[0].dyn_size = 48; a[0].dyn_pen_x = 10; a[0].dyn_pen_y = 34; a[0].dyn_y0 = 512; a[0].dyn_cols = 20;
  a[0].color_cols = 20; a[0].color_width = 1024; a[0].color_height = 256;
  a[0].fonts[0].ascent = 13; a[0].fonts[0].descent = 3; a[0].fonts[0].cell = 48; a[0].fonts[0].cols = 20;
  for g: 0..<GP_GLYPHS { a[0].fonts[0].advance[g] = 7; }
  #assert text_width(a[..], 0, "a日b") == 14;           // not measured yet
  s := dyn_find(a[..], 0, "日", 0, 3);
  #assert s >= 0 && a[0].clusters[s].state == 1;
  a[0].clusters[s].advance = 14; a[0].clusters[s].state = 2;
  #assert text_width(a[..], 0, "a日b") == 28 && text_offset(a[..], 0, "a日b", 12) == 1 && text_offset(a[..], 0, "a日b", 15) == 4;
  out: [560] f32;
  #assert paint_text(out[..], 0, a[..], 2, 0, "日", 0, 0, 20, hex(0xffffff, 1)) == 0;   // its cell is wanted
  c := a[0].clusters[s].cell[4 * GP_SUBPIXEL] - 1;
  #assert c >= 0 && a[0].cells[c].state == 1 && a[0].cells[c].level == 4;
  a[0].cells[c].state = 2;
  #assert paint_text(out[..], 0, a[..], 2, 0, "日", 0, 0, 20, hex(0xffffff, 1)) == 6 && out[2] == GP_SPRITE;
  // an emoji is a color glyph: one cell in the color atlas
  e := dyn_slot(a[..], 0, "😀", 0, 4);
  a[0].clusters[e].advance = 18; a[0].clusters[e].color = true; a[0].clusters[e].state = 2;
  #assert paint_text(out[..], 0, a[..], 2, 0, "😀", 0, 0, 20, hex(0xffffff, 1)) == 0;
  ce := a[0].clusters[e].cell[0] - 1;
  #assert ce >= GP_DYN_MONO;
  a[0].cells[ce].state = 2;
  #assert paint_text(out[..], 0, a[..], 2, 0, "😀", 0, 0, 20, hex(0xffffff, 1)) == 6 && out[2] == GP_COLOR_SPRITE;
  // full: the least recently used slot goes, and its hash entry with it
  for k: 0..<GP_DYN_SLOTS { if a[0].clusters[k].state == 0 { a[0].clusters[k].state = 2; a[0].clusters[k].used = 1; a[0].clusters[k].n = 0; } }
  a[0].clusters[s].used = 0; a[0].frame = 2;
  t := dyn_slot(a[..], 0, "本", 0, 3);
  #assert t == s && dyn_find(a[..], 0, "日", 0, 3) == -1 && dyn_find(a[..], 0, "本", 0, 3) == t;
}
#test "a content mask narrows the vertices it covers" {
  out: [336] f32;
  n := paint_quad(out[..], 0, 2, 0, 0, 100, 100, 0, 0, hex(0, 1), hex(0, 1));
  #assert out[20] == -GP_NO_CLIP && out[25] == 0;
  gp_clip(out[..], 0, n, 2, 10, 20, 30, 40);
  #assert out[20] == 20 && out[21] == 40 && out[22] == 80 && out[23] == 120 && out[GP_VERTEX_FLOATS * 5 + 23] == 120;
  gp_fade(out[..], 0, n, 2, 38, 24, 880, 89);
  #assert out[24] == 76 && out[25] == 48 && out[26] == 1760 && out[GP_VERTEX_FLOATS * 5 + 27] == 178;
  m := paint_elbow(out[..], n, 2, 304.5, 100, 6, 320, true, rgba(1, 1, 1, 0.12));
  #assert m == n + 6 && out[n * GP_VERTEX_FLOATS + 2] == GP_ELBOW && out[n * GP_VERTEX_FLOATS + 4] == 609 && out[n * GP_VERTEX_FLOATS + 9] == 1;
}
#test "a glyph lands on a quarter device pixel, in the cell for its subpixel and dilation" {
  a: [1] Atlas;
  a[0].width = 1024; a[0].height = 1024; a[0].ready = true;
  a[0].fonts[0].size = 14; a[0].fonts[0].ascent = 13; a[0].fonts[0].descent = 3;
  a[0].fonts[0].cell = 48; a[0].fonts[0].pen_x = 8; a[0].fonts[0].pen_y = 36; a[0].fonts[0].cols = 20;
  for g: 0..<GP_GLYPHS { a[0].fonts[0].advance[g] = 7.1; }
  out: [336] f32;
  n := paint_text(out[..], 0, a[..], 2, 0, "ab", 10.1, 0, 22.75, hex(0x000000, 1));
  #assert n == 12;
  // 'a' at x 20.2 device: quantized 20.25, variant 1; baseline 2 * (3.375 + 13) = 32.75, rounded 33
  #assert out[0] == 20 - 8 && out[1] == 33 - 36;
  cell := (0 * GP_SUBPIXEL + 1) * GP_GLYPHS + glyph_of('a');
  #assert abs(out[10] - cast(f32) (cell % 20) * 48 / 1024) < 0.00001;
  #assert paint_text(out[..], 0, a[..], 2, 0, " ", 0, 0, 20, hex(0, 1)) == 0;   // a space draws nothing
}
