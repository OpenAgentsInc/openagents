LAB_TEST_ANSWER :: "{\"model\":\"elephant-1\",\"answers\":{\"harness\":{\"type\":\"choice\",\"choice\":\"claude_code\",\"confidence\":0.994958694,\"probabilities\":{\"claude_code\":0.994958694,\"psionic\":0.005041306}},\"difficulty\":{\"type\":\"score\",\"score\":1.882631565,\"confidence\":0.493983513,\"selected\":\"2\",\"legend\":{\"0\":\"Trivial: a one-line answer\",\"1\":\"Easy: a short answer or a small edit\",\"2\":\"Moderate: a few files or steps\",\"3\":\"Hard: many files, debugging or design\",\"4\":\"Very hard: a long, open-ended or risky task\"},\"probabilities\":{\"0\":0.044380083,\"1\":0.25351843,\"2\":0.493983513,\"3\":0.191325787,\"4\":0.016792186}},\"effort\":{\"type\":\"choice\",\"choice\":\"medium\",\"confidence\":0.434657295,\"probabilities\":{\"low\":0.090798155,\"medium\":0.434657295,\"high\":0.356523652,\"xhigh\":0.080537392,\"max\":0.037483506}},\"claude_model\":{\"type\":\"choice\",\"choice\":\"claude-sonnet-5-5\",\"confidence\":0.646685903,\"probabilities\":{\"claude-opus-5-5\":0.148796558,\"claude-sonnet-5-5\":0.646685903,\"claude-haiku-5-5\":0.204517539}},\"local_work\":{\"type\":\"noul\",\"noul\":0.982787513}},\"usage\":null,\"service\":{\"door\":\"psionic\",\"version\":\"psionic-serve-v1\",\"identity\":\"elephant-1@sha256:682f02348dfe4617dd21bba2915c12e805de8cf16327a61e895a831ea681d0ba\"},\"latency_ms\":1819}";

#test "Elephant's recorded answer becomes the decision, its headline and its distributions" {
  buf: [8192] u8; st: [1400] u8; b: [1] SoBody;
