// The Mac app's chat screen, the Zeron-fork UI (docs/desktop/coax-desktop.md):
// Zeron Dark's canvas, opening on Zeron's empty new chat (its composer, the
// new-chat form, alone in the middle). A sent message starts the chat: the
// user's own Claude Code answers it (claude.coax), streaming into the
// transcript (transcript.coax) in the 736px column, the composer docked
// under it as Zeron docks it in a chat. The composer's chips open Zeron's
// menus (picker.coax): the model chip its compact model picker (the effort
// slider over the model list), the access chip the access menu; the
// paperclip asks the host for files to attach (attachments.coax: drops and
// pastes come the same way), each an inline chip until sent. Send turns
// into Stop while the turn runs, and Stop or Escape interrupts it. The model
// chip also carries the chat's mode (modes.coax): Claude, or Psionic, our
// own gpt-oss-20b through the Psionic Responses API (psionic.coax); an
// empty chat's model list has a tab per mode, and a conversation keeps its
// mode. The Lab (lab.coax), the third mode, has our own Elephant route
// each message to Claude Code, Psionic or Codex and shows the decision.
// Codex (codex.coax), the fourth, is the user's own Codex as Zeron drives
// it: codex app-server on their ChatGPT login. Zeron's demo
// conversation stays as a fixture (--demo, and
// the transcript-fixture capture's `fixture` step). The host
// (Sources/Zeron.swift, through zeron-face.c) builds the atlas from the
// fonts and icons listed here, gives the engine its buffers and working
// folder, then each frame asks for the vertices. Based on Zeron by Wing, MIT.

#load "modes.coax";

ZR_MAX_VERTICES :: 200000;
ZR_COLUMN_PAD :: 16.0;
// The docked composer's bottom margin (Zeron's composer stack: the pill,
// then 40px under it) and the status strip above it.
ZR_DOCK_BOTTOM :: 40.0;
// Where Zeron's new-chat composer sits: (viewport - height) / 2, less this
// (measured from Zeron at 1320x880: the pill's top at 368).
ZR_HERO_LIFT :: 12.0;
// The coalescing of a streaming turn's redraws of the transcript (seconds).
ZR_COALESCE :: 0.12;
// What the host is asked to do (coaxial_zeron_take_action).
HOST_NONE :: 0; HOST_LOGIN :: 1; HOST_INSTALL :: 2; HOST_ATTACH :: 3;
HOST_CODEX_LOGIN :: 4; HOST_CODEX_INSTALL :: 5;     // Terminal running `codex login`, the npm install line

ZeronState :: struct {
  ready: bool;
  width: f32; height: f32; d: f32;
  atlas: [1] Atlas;
  composer: [1] Composer;
  transcript: [1] Transcript;
  seen_sent: int;                // the composer's sends already appended
  want_scroll: f32;              // a scroll_to for the next layout (< 0: none)
  lx: f32; ly: f32;              // the pointer (logical px)
  cursor: int;                   // 0 arrow, 1 I-beam, 2 pointing hand
  on_composer: bool;             // the press went to the composer
  // the chat
  session: [1] Session;
  engine: [1] Engine;
  ui: [1] SUi;
  demo: bool;                    // Zeron's demo conversation instead of a chat
  since_build: f32;              // seconds since the transcript was rebuilt
  host_action: int;              // HOST_*, until the host takes it
  own_pool: [3072] u8;           // the conversation's text until the host attaches its pool (3 KiB: the checks run at the compile-time aggregate limit)
  // the mode, and the Psionic engine with its buffers
  mode: int;                     // MODE_*
  lab: [1] Lab;                  // the Lab's routing (MODE_LAB)
  gpu: [1] GpuSwitch;            // which model the shared GPU holds (gpu.coax)
  psionic: [1] PsEngine;
  codex: [] CxEngine;            // the Codex engine, the host's (MODE_CODEX, and the Lab's Codex routes; none in the checks)
  // the open menu and the catalogs it shows, the attachments
  picker: [1] Picker;
  cats: [MODE_COUNT] PkCatalog;
  cat_gen: int;                    // the engine's catalog these copy
  cx_gen: int;                     // the Codex engine's catalog these copy
  ps_place_gen: int;               // the Psionic engine's place these copy
  att: [1] Attachments;
  own_store: [256] u8;           // the attachments' bytes until the host attaches its store
  prompt: [] u8;                 // a message as its engine reads it (the store's last 512 KiB)
  own_prompt: [256] u8; 
  swallow: bool;                 // the press closed a menu on its own chip: it goes nowhere
}
// The Psionic engine's buffers, carved from the end of the host's pool:
// curl's lines, decoded strings, the request body, an event's data, the replay.
ZR_PS_BUF :: 65536;
ZR_PROMPT :: 524288;

zr_labels :: (s: [] ZeronState) {
  c := s[0].composer[..]; e := s[0].engine[..];
  access := ACCESS_NAMES;
  // the demo keeps the capture's chip (the chat's model id, nothing else)
  if s[0].demo { c[0].model_label = ""; c[0].effort_label = ""; c[0].access_label = ""; c[0].brand = 0; c[0].no_effort = false; c[0].access_set = false; c[0].plan = false; return; }
  brands := MODE_BRANDS;
  c[0].brand = brands[s[0].mode];
  c[0].access_label = access[e[0].access];
  c[0].access_set = e[0].access != ACC_FULL;
  c[0].plan = (s[0].mode == MODE_CLAUDE && e[0].plan) || (s[0].mode == MODE_CODEX && s[0].codex.count > 0 && s[0].codex[0].plan);
  sel := zr_sel(s, s[0].mode);
  cat := s[0].cats[s[0].mode..<s[0].mode + 1];
  c[0].model_label = cat[0].label[sel.model];
  lv := pk_level_for(cat, sel.model, sel.level);
  c[0].no_effort = lv < 0;
  c[0].effort_label = ifx lv >= 0 then cat[0].level_label[lv] else "";
  if s[0].mode == MODE_LAB { c[0].no_effort = false; c[0].effort_label = LAB_EFFORT; }   // the panel has no slider
}
// What is chosen in a mode, as the picker reads it (access as the menu's row).
zr_sel :: (s: [] ZeronState, mode: int) -> PkSel {
  e := s[0].engine[..];
  row := 0;
  for k: 0..<s[0].cats[mode].access { if s[0].cats[mode].access_value[k] == e[0].access { row = k; } }
  if mode == MODE_PSIONIC { return PkSel.{model = 0, level = s[0].psionic[0].effort, access = row, plan = false}; }
  if mode == MODE_LAB { return PkSel.{model = 0, level = 0, access = row, plan = false}; }
  if mode == MODE_CODEX {
    if s[0].codex.count < 1 { return PkSel.{model = 0, level = CX_LV_HIGH, access = row, plan = false}; }
    x := s[0].codex; return PkSel.{model = x[0].model, level = x[0].effort, access = row, plan = x[0].plan};
  }
  return PkSel.{model = e[0].model, level = e[0].effort, access = row, plan = e[0].plan};
}
// The mode the picker shows: its tab while the chat is empty, else the chat's.
zr_view :: (s: [] ZeronState) -> int { return ifx s[0].picker[0].tabs > 1 then s[0].picker[0].view else s[0].mode; }
zr_view_sel :: (s: [] ZeronState) -> PkSel {
  v := zr_view(s);
  sel := zr_sel(s, v);
  // the list on another mode's tab has nothing chosen; the panel always shows the chat's
  if v != s[0].mode && s[0].picker[0].list { sel.model = -1; }
  return sel;
}
zr_view_cat :: (s: [] ZeronState) -> [] PkCatalog {
  v := ifx s[0].picker[0].list then zr_view(s) else s[0].mode;
  return s[0].cats[v..<v + 1];
}
zr_menu_sel :: (s: [] ZeronState) -> PkSel { return ifx s[0].picker[0].list then zr_view_sel(s) else zr_sel(s, s[0].mode); }
// Opens a chip's menu (or closes it when it is open): new chat's below, a chat's above unless there is no room.
zr_open_menu :: (s: [] ZeronState, which: int) {
  p := s[0].picker[..]; c := s[0].composer[..];
  kind := ifx which == CH_MODEL then PK_MODEL else PK_ACCESS_MENU;
  if p[0].kind == kind { pk_close(p); c[0].open = -1; return; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  cat := s[0].cats[s[0].mode..<s[0].mode + 1];
  pk_open(p, kind, cat, zr_sel(s, s[0].mode), c[0].chip_x[which], c[0].chip_y[which], c[0].chip_w[which], c[0].chip_h[which], s[0].height / d, zr_fresh(s));
  pk_tabs(p, ifx zr_fresh(s) then MODE_COUNT else 1, ifx zr_fresh(s) then s[0].mode else 0);
  if zr_fresh(s) { for m: 0..<MODE_COUNT { pk_tab(p, m, mode_tab_icon(m), mode_tab_tint(m)); } }
  else { pk_tab(p, 0, mode_tab_icon(s[0].mode), mode_tab_tint(s[0].mode)); }
  c[0].open = which;
}
// What the menu picked: the model (on another tab, the mode first), the level, the access, plan mode.
zr_take_picks :: (s: [] ZeronState) {
  p := s[0].picker[..]; e := s[0].engine[..];
  view := zr_view(s);
  if p[0].pick_model >= 0 {
    if view != s[0].mode { b := zr_set_mode(s, view); }
    if s[0].mode == MODE_CLAUDE { e_set_model(e, p[0].pick_model); }
    if s[0].mode == MODE_CODEX { cxe_set_model(s[0].codex, p[0].pick_model); }
  }
  if p[0].pick_level >= 0 {
    if s[0].mode == MODE_PSIONIC { s[0].psionic[0].effort = p[0].pick_level; }
    else if s[0].mode == MODE_CLAUDE { e[0].effort = p[0].pick_level; }   // the Lab's: Elephant decides
    else if s[0].mode == MODE_CODEX && s[0].codex.count > 0 { s[0].codex[0].effort = p[0].pick_level; }
  }
  if p[0].pick_access >= 0 { e_set_access(e, s[0].cats[s[0].mode].access_value[p[0].pick_access]); }
  if p[0].flip_plan && s[0].mode == MODE_CLAUDE { e_set_plan(e, !e[0].plan); }
  if p[0].flip_plan && s[0].mode == MODE_CODEX && s[0].codex.count > 0 { s[0].codex[0].plan = !s[0].codex[0].plan; }
  p[0].pick_model = -1; p[0].pick_level = -1; p[0].pick_access = -1; p[0].flip_plan = false;
  if !pk_is_open(p) { s[0].composer[0].open = -1; }
  zr_labels(s);
}
// Changes an empty chat's mode (a conversation keeps its own); whether it changed.
zr_set_mode :: (s: [] ZeronState, mode: int) -> bool {
  if mode < 0 || mode >= MODE_COUNT || (!zr_fresh(s) && mode != s[0].mode) || s[0].demo { return false; }
  s[0].mode = mode;
  zr_labels(s);
  return true;
}
// A message, Stop and the pump go to the chat's engine: the bubble shows
// the text with its chips, the engine reads it with its attachments
// (Claude: their labels, paths and images; Psionic: text files inline, an
// image refused, the message then back in the composer). Whether it went.
zr_send :: (s: [] ZeronState, raw: string) -> bool {
  t := s[0].att[..]; a := s[0].atlas[..];
  // the message trimmed (a chip leaves a space after it)
  lo := 0; hi := raw.count;
  while lo < hi && (raw[lo] == ' ' || raw[lo] == '\n') { lo += 1; }
  while hi > lo &&  (raw[hi - 1] == ' ' || raw[hi - 1] == '\n') { hi -= 1; }
  text := cast(string) raw[lo..<hi];
  n := at_take(t, text);
  if s[0].mode == MODE_PSIONIC {
    if n == 0 { zr_ps_send(s, text, text); return true; }
    why: [512] u8; wn: [1] int;
    msg := at_text_only(t, a, text, PS_MODEL, s[0].prompt[..], why[..], wn[..]);
    if msg.count == 0 {
      // nothing went: the draft and its attachments come back, with why
      at_restore(t);
      composer_insert(s[0].composer[..], raw);
      zr_fail(s, cast(string) why[0..<wn[0]]);
      return false;
    }
    zr_ps_send(s, text, msg);
    at_delivered(t);
    return true;
  }
  if s[0].mode == MODE_LAB {
    if n > 0 {
      at_restore(t);
      composer_insert(s[0].composer[..], raw);
      zr_fail(s, "The Lab doesn't take attachments yet. Pick a Claude model to send files.");
      return false;
    }
    lab_send(s[0].lab[..], s[0].engine[..], s[0].psionic[..], s[0].gpu[..], s[0].session[..], text);
    return true;
  }
  // Codex reads the attachments as Zeron sends them: their paths in the text
  if s[0].mode == MODE_CODEX { cxe_send_as(s[0].codex, s[0].session[..], text, at_prompt(t, a, text, s[0].prompt[..])); return true; }
  e_send_as(s[0].engine[..], s[0].session[..], text, at_prompt(t, a, text, s[0].prompt[..]));
  return true;
}
// The notice above the composer (an attachment that could not be staged or sent).
zr_fail :: (s: [] ZeronState, why: string) {
  c := s[0].composer[..];
  c[0].failure_n = e_copy(c[0].failure[..], 0, why);
}
// A Psionic message: gpt-oss-20b must be on the GPU first (the switch may be holding Elephant there).
zr_ps_send :: (s: [] ZeronState, shown: string, text: string) {
  p := s[0].psionic[..]; ss := s[0].session[..]; l := s[0].lab[..];
  s_user(ss, shown);
  if p[0].on { ps_configure(p); lab_door(l); p[0].hold = gs_want(s[0].gpu[..], ss, GS_GPTOSS, GT_PSIONIC, lab_url(l), ps_url(p)); }
  ps_forward(p, ss, text);
}
zr_stop :: (s: [] ZeronState) {
  if gs_stop(s[0].gpu[..], s[0].session[..]) { s[0].psionic[0].hold = false; }
  if s[0].mode == MODE_PSIONIC || zr_lab_psionic(s) { ps_stop(s[0].psionic[..], s[0].session[..]); return; }
  if s[0].mode == MODE_LAB && lab_stop(s[0].lab[..], s[0].session[..]) { return; }
  if zr_codex(s) { cxe_stop(s[0].codex, s[0].session[..]); return; }
  e_stop(s[0].engine[..], s[0].session[..]);
}
// The chat's message is running on Codex (the Codex mode, or the Lab's Codex route): its Stop, approvals and sign-in go there.
zr_codex :: (s: [] ZeronState) -> bool { return s[0].mode == MODE_CODEX || (s[0].mode == MODE_LAB && s[0].lab[0].via == 2); }
// The Lab's message is running on Psionic (its Stop and approvals go there).
zr_lab_psionic :: (s: [] ZeronState) -> bool { return s[0].mode == MODE_LAB && s[0].lab[0].via == 1 && !s[0].lab[0].fallback;
}
// Cmd+N (File > New Chat): Zeron's empty new chat. A running turn stops;
// each engine forgets the conversation (Claude's session, Codex's thread,
// Psionic's replay) so the next message starts a new one; the draft stays.
zr_new_chat :: (s: [] ZeronState) {
  if s[0].session[0].live { zr_stop(s); }
  e := s[0].engine[..];
  if e[0].running { e_close(e); }
  e[0].sid_n = 0; e[0].pend = -1;
  ps_close(s[0].psionic[..]); s[0].psionic[0].ni = 0; s[0].psionic[0].nh = 0; s[0].psionic[0].hold = false;
  if s[0].codex.count > 0 { s[0].codex[0].tid_n = 0; }
  ss := s[0].session[..];
  s_init(ss, ss[0].pool);
  ss[0].live = false; ss[0].stopping = false; ss[0].noticed = false; ss[0].secs = 0; ss[0].turns = 0; ss[0].cost = 0; ss[0].turn_ms = 0;
  ss[0].changed = true;
  t := s[0].transcript[..];
  t_reset(t); t[0].working = false;
  s[0].demo = false;
  s[0].composer[0].docked = false; s[0].composer[0].compact = false;
  s[0].want_scroll = -1;
  zr_labels(s);
}
coaxial_zeron_new_chat :: (s: [] ZeronState) #export_c { if s.count > 0 { zr_new_chat(s); } }
// The demo conversation, as the transcript-fixture capture opens it.
zr_demo :: (s: [] ZeronState) {
  if s[0].demo { return; }
  s[0].demo = true;
  t := s[0].transcript[..];
  t_reset(t);
  t[0].working = false;
  t_demo(t);
  s[0].composer[0].docked = true;
  zr_labels(s);
}
// Whether the screen shows Zeron's empty new chat (no message yet).
zr_empty :: (s: [] ZeronState) -> bool { return !s[0].demo && s[0].session[0].n == 0; }
// Whether no message has been sent yet (the mode can still change): empty, or only the install hint.
zr_fresh :: (s: [] ZeronState) -> bool { return zr_empty(s) || !s[0].demo && s[0].session[0].hint; }
// A chip or Send pressed in the composer.
zr_chip :: (s: [] ZeronState, which: int) {
  c := s[0].composer[..]; e := s[0].engine[..]; ss := s[0].session[..];
  if which == CH_SEND {
    if ss[0].live && c[0].n == 0 { zr_stop(s); } else { composer_submit(c); }
  }
  else if which == CH_MODEL || which == CH_ACCESS { if !s[0].demo { zr_open_menu(s, which); } }
  else if which == CH_ATTACH { if !s[0].demo { s[0].host_action = HOST_ATTACH; } }
  zr_labels(s);
}

// The composer's box this frame, and whether a point is over it.
zr_on_composer :: (s: [] ZeronState, x: f32, y: f32) -> bool {
  c := s[0].composer[..];
  return x >= c[0].x && x < c[0].x + c[0].w && y >= c[0].y && y < c[0].y + c[0].h;
}
// The transcript takes the pointer between the titlebar and the composer's stack.
zr_on_transcript :: (s: [] ZeronState, x: f32, y: f32) -> bool {
  return y >= TITLEBAR_HEIGHT && y < s[0].composer[0].y - STATUS_STRIP_HEIGHT;
}
zr_update_cursor :: (s: [] ZeronState) {
  c := s[0].composer[..];
  x := s[0].lx; y := s[0].ly;
  s[0].cursor = 0;
  if zr_on_composer(s, x, y) {
    // the text area: an I-beam (the compact form's row between paperclip and chip)
    if c[0].compact { s[0].cursor = ifx x >= c[0].text_x - COMPACT_TEXT_PAD && x < c[0].text_x + c[0].text_w + COMPACT_TEXT_PAD then 1 else 0; }
    else { s[0].cursor = ifx x >= c[0].text_x - 16 && y < c[0].y + c[0].h - ACTIONS_ROW_HEIGHT then 1 else 0; }
  } else if zr_on_transcript(s, x, y) {
    s[0].cursor = t_cursor(s[0].transcript[..], x, y);
  }
}

zr_frame :: (s: [] ZeronState, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int {
  t := s[0].transcript[..]; c := s[0].composer[..]; e := s[0].engine[..]; ss := s[0].session[..];
  if !s[0].ready {
    s[0].ready = true; c[0].focused = true; c[0].clicked = -1;
    s[0].want_scroll = -1;
    if ss[0].pool.count == 0 { s_init(ss, s[0].own_pool[..]); }
    ss[0].asking = -1;
    e_init(e);   // Claude's catalog at High, Zeron's default (attach does it before the host's flags)
    zr_catalogs(s);
    if s[0].att[0].store.count == 0 { s[0].att[0].store = s[0].own_store[..]; }
    if s[0].prompt.count == 0 { s[0].prompt = s[0].own_prompt[..]; }
    e[0].att = s[0].att[..]; e[0].prompt = s[0].prompt;
    cxe_init(s[0].codex);
    if s[0].codex.count > 0 { s[0].codex[0].att = s[0].att[..]; s[0].codex[0].prompt = s[0].prompt; }
    if !s[0].psionic[0].on { ps_init(s[0].psionic[..]); }
    if !s[0].gpu[0].on { gs_init(s[0].gpu[..]); }
    t[0].seed = 1;
    zr_labels(s);
  }
  d := ifx dpr < 1 then 1.0f32 else dpr;
  s[0].width = width; s[0].height = height; s[0].d = d;
  dt1 := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  c[0].since += dt1;
  s[0].picker[0].since += dt1;
  c[0].clock += dt1;
  s[0].atlas[0].frame += 1;
  // the engines: what Claude Code (or curl, for Psionic) wrote since the last frame
  e_pump(e, ss);
  // Claude Code isn't installed: an empty Claude chat says so at once, with the install line and Install
  if s[0].mode == MODE_CLAUDE && !s[0].demo && e[0].on && e[0].probed && e[0].claude_n == 0 { s_hint_install(ss); }
  else if ss[0].hint { s_drop_hint(ss); s[0].transcript[0].nr = 0; }
  if e[0].cat_gen != s[0].cat_gen { s[0].cat_gen = e[0].cat_gen; zr_catalogs(s); zr_labels(s); }   // the CLI listed its models
  s[0].psionic[0].access = e[0].access;
  ps_pump(s[0].psionic[..], ss, dt1);
  if s[0].psionic[0].place_gen != s[0].ps_place_gen { zr_catalogs(s); }   // it found where gpt-oss-20b answers from
  // Codex: started ahead of a message once its tab is in view (its model/list fills the picker)
  cx := s[0].codex;
  if cx.count > 0 {
    cx[0].access = e[0].access;
    cx[0].want_warm = cx[0].want_warm || s[0].mode == MODE_CODEX || (pk_is_open(s[0].picker[..]) && zr_view(s) == MODE_CODEX);
    cxe_pump(cx, e, ss);
    if cx[0].cat_gen != s[0].cx_gen { s[0].cx_gen = cx[0].cat_gen; zr_catalogs(s); zr_labels(s); }   // Codex listed its models
  }
  lab_pump(s[0].lab[..], e, s[0].psionic[..], s[0].gpu[..], ss, dt1);
  // the Lab routed a message to Codex: the Codex engine runs it at the decided effort, on its default model
  if s[0].lab[0].codex_due && cx.count > 0 {
    s[0].lab[0].codex_due = false;
    lv := s[0].lab[0].codex_effort + 1;      // EFFORT_IDS low..max are Codex's levels 1..5
    cx[0].effort = ifx lv >= 1 && lv <= 5 then lv else CX_LV_HIGH; cx[0].model = 0;
    cxe_forward(cx, ss, s[0].lab[0].part);
  }
  lab_gpu_pump(s[0].lab[..], e, s[0].psionic[..], s[0].gpu[..], ss, dt1);
  // Send, Stop and the chips
  if c[0].clicked >= 0 { k := c[0].clicked; c[0].clicked = -1; zr_chip(s, k); }
  // a sent message joins the transcript as the user's bubble (and goes to Claude Code), and the view follows it
  if c[0].sent != s[0].seen_sent {
    s[0].seen_sent = c[0].sent;
    text := cast(string) c[0].last[0..<c[0].last_n];
    if s[0].demo { t_user(t, t_pool(t, text)); }
    else if zr_send(s, text) { s[0].since_build = ZR_COALESCE; }
    t[0].pinned = true;
  }
  // a notice's buttons
  if t[0].action != A_NONE {
    if t[0].action == A_ALLOW || t[0].action == A_DENY {
      if s[0].mode == MODE_PSIONIC || zr_lab_psionic(s) { ps_answer(s[0].psionic[..], ss, t[0].action == A_ALLOW); }
      else if zr_codex(s) { cxe_answer(s[0].codex, ss, t[0].action == A_ALLOW); }
      else { e_answer(e, ss, t[0].action == A_ALLOW); }
    }
    else if zr_codex(s) { s[0].host_action = ifx t[0].action == A_INSTALL then HOST_CODEX_INSTALL else HOST_CODEX_LOGIN; }
    else { s[0].host_action = ifx t[0].action == A_INSTALL then HOST_INSTALL else HOST_LOGIN; }
    t[0].action = A_NONE;
  }
  // the transcript follows the session, its redraws coalesced while a turn streams
  if ss[0].live { ss[0].secs += dt1; }
  s[0].since_build += dt1;
  if !s[0].demo && ss[0].changed && (s[0].since_build >= ZR_COALESCE || !ss[0].live) {
    s_build(ss, s[0].ui[..], t);
    s[0].since_build = 0;
  }
  t[0].working = ss[0].live && !s[0].demo;
  t[0].work_secs = ss[0].secs; t[0].spin += dt1;
  c[0].running = ss[0].live && !s[0].demo;
  th := zeron_dark();
  w := width / d; h := height / d;
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, th.shell, th.shell);
  if !s[0].atlas[0].ready { return v; }
  column := ifx w < COMPOSER_MAX_WIDTH then w else COMPOSER_MAX_WIDTH;
  cw := column - 2 * ZR_COLUMN_PAD;
  x := round_layout((w - cw) / 2);
  if zr_empty(s) {
    // Zeron's new chat: the expanded composer, centered a little high
    c[0].docked = false;
    composer_wrap(c, s[0].atlas[..], cw - 34);
    y := round_layout((h - composer_height(c[0].lines)) / 2 - ZR_HERO_LIFT);
    t[0].nr = 0; t[0].nbox = 0; t[0].ntext = 0; t[0].nsel = 0; t[0].nhit = 0;
    v = paint_composer(out, v, c, s[0].atlas[..], th, d, x, y, cw);
    v = zr_paint_failure(out, v, s, th, d, x, y, cw);
    v = pk_paint(out, v, s[0].picker[..], zr_view_cat(s), zr_menu_sel(s), s[0].atlas[..], th, d, w, h);
    zr_update_cursor(s);
    return v;
  }
  ch := docked_height(c, s[0].atlas[..], cw);
  stack := STATUS_STRIP_HEIGHT + ch + ZR_DOCK_BOTTOM;
  t[0].view_h = h;
  t_layout(t, s[0].atlas[..], th, x, cw, stack + TRANSCRIPT_FADE_BAND + SPACE_SM);
  // a chat longer than the transcript holds starts at a later turn
  if !s[0].demo && s_overflowed(t) && s_drop_turn(ss, s[0].ui[..]) { ss[0].changed = true; }
  if s[0].want_scroll >= 0 { t_scroll_to(t, s[0].want_scroll); s[0].want_scroll = -1; }
  t_clamp(t);
  v = t_paint(out, v, t, s[0].atlas[..], th, d, h, stack - STATUS_STRIP_HEIGHT);
  v = paint_composer_docked(out, v, c, s[0].atlas[..], th, d, x, h - ZR_DOCK_BOTTOM, cw);
  v = zr_paint_failure(out, v, s, th, d, x, c[0].y, cw);
  v = pk_paint(out, v, s[0].picker[..], zr_view_cat(s), zr_menu_sel(s), s[0].atlas[..], th, d, w, h);
  zr_update_cursor(s);
  return v;
}

// The catalogs the menus show, one per mode (Claude's is the engine's).
zr_catalogs :: (s: [] ZeronState) {
  s[0].cats[MODE_CLAUDE] = s[0].engine[0].cat[0];
  s[0].cats[MODE_PSIONIC] = mode_catalog(MODE_PSIONIC);
  s[0].cats[MODE_PSIONIC].place = ps_where(s[0].psionic[..]);   // "coderos-4080 · RTX 4080"
  s[0].ps_place_gen = s[0].psionic[0].place_gen;
  s[0].cats[MODE_LAB] = mode_catalog(MODE_LAB);
  cxe_init(s[0].codex);
  s[0].cats[MODE_CODEX] = ifx s[0].codex.count > 0 then s[0].codex[0].cat[0] else codex_catalog();
}
// Zeron's failure notice above the composer (mx 4, 6 over it): the danger
// wash, the tile with its mark, "Error", the message under it; a press
// dismisses it.
zr_paint_failure :: (out: [] f32, at: int, s: [] ZeronState, th: Theme, d: f32, x: f32, composer_y: f32, cw: f32) -> int {
  c := s[0].composer[..]; a := s[0].atlas[..];
  if c[0].failure_n == 0 { c[0].failure_h = 0; return at; }
  msg := cast(string) c[0].failure[0..<c[0].failure_n];
  accent := hex(DANGER, 1); muted := hex(DANGER_MUTED, 1);
  w := cw - 8;
  no_runs: [1] MdRun;
  lines: [16] MdLine;
  nl := md_wrap(a, msg, no_runs[0..<0], w - 2 * NOTICE_PAD, true, lines[..]);
  h := NOTICE_PY + NOTICE_TILE + NOTICE_GAP + cast(f32) nl * NOTICE_LINE + NOTICE_PY;
  y := composer_y - 6 - h;
  c[0].failure_y = y; c[0].failure_h = h;
  v := paint_quad(out, at, d, x + 4, y, w, h, 10, 0, flatten(opacity(accent, 0.1), th.shell), flatten(opacity(accent, 0.1), th.shell));
  hy := y + NOTICE_PY;
  v = paint_quad(out, v, d, x + 4 + NOTICE_PAD, hy, NOTICE_TILE, NOTICE_TILE, 6, 0, opacity(accent, 0.12), opacity(accent, 0.12));
  v = paint_icon(out, v, a, d, ICON_DANGER, x + 4 + NOTICE_PAD + 4, hy + 4, 12, 12, opacity(muted, 0.8));
  v = paint_text(out, v, a, d, FONT_CHIP, "Error", x + 4 + NOTICE_PAD + NOTICE_TILE + 8, hy + (NOTICE_TILE - NOTICE_LINE) / 2, NOTICE_LINE, opacity(muted, 0.8));
  my := hy + NOTICE_TILE + NOTICE_GAP;
  for q: 0..<nl {
    seg := cast(string) msg[lines[q].from..<lines[q].to];
    v = paint_text(out, v, a, d, FONT_TOOL, seg, x + 4 + NOTICE_PAD, my + cast(f32) q * NOTICE_LINE, NOTICE_LINE, muted);
  }
  return v;
}

// ---------------------------------------------------------------- the host's calls

coaxial_zeron_frame :: (s: [] ZeronState, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  return zr_frame(s, out, width, height, dpr, dt);
}
// phase 0 down, 1 move (or drag), 2 up; device pixels; the press's click
// count and modifiers (1 Shift). A press over the composer goes to it, any
// other to the transcript (selecting its text, opening its groups and
// chips); moves and the release follow the press. Whether the composer took it.
coaxial_zeron_pointer :: (s: [] ZeronState, x: f32, y: f32, phase: int, clicks: int, mods: int) -> bool #export_c {
  if s.count < 1 { return false; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  c := s[0].composer[..]; t := s[0].transcript[..];
  lx := x / d; ly := y / d;
  s[0].lx = lx; s[0].ly = ly;
  shift := (mods & MOD_SHIFT) != 0;
  p := s[0].picker[..];
  if phase == 0 {
    s[0].swallow = false;
    // an open menu takes the press; outside it, the press closes it and goes on (unless it was on the menu's own chip)
    if pk_is_open(p) {
      opened := c[0].open;
      sel := zr_menu_sel(s);
      took := pk_press(p, zr_view_cat(s), sel, lx, ly);
      zr_take_picks(s);
      if took { return true; }
      if opened >= 0 && composer_chip_hit(c, lx, ly) == opened { s[0].swallow = true; return true; }
    }
    // the failure notice: a press dismisses it
    if c[0].failure_n > 0 && ly >= c[0].failure_y && ly < c[0].failure_y + c[0].failure_h && lx >= c[0].x && lx < c[0].x + c[0].w { c[0].failure_n = 0; return true; }
    s[0].on_composer = zr_on_composer(s, lx, ly);
    if s[0].on_composer { t[0].has_sel = false; t_hover(t, -1, -1); }
    took := composer_press(c, s[0].atlas[..], lx, ly, clicks, shift);
    if !s[0].on_composer && zr_on_transcript(s, lx, ly) { t_pointer(t, s[0].atlas[..], lx, ly, 0, clicks, shift); }
    zr_update_cursor(s);
    return took;
  }
  if phase == 1 {
    if pk_is_open(p) { pk_move(p, zr_view_cat(s), zr_menu_sel(s), lx, ly); zr_take_picks(s); }
    // the chips' hover wash (trigger_chip)
    h := composer_chip_hit(c, lx, ly);
    c[0].hover = ifx h == CH_MODEL || h == CH_ACCESS || h == CH_ATTACH then h else -1;
    if pk_is_open(p) && pk_inside(p, lx, ly) { c[0].hover = -1; }
    if c[0].selecting { composer_drag(c, s[0].atlas[..], lx, ly); zr_update_cursor(s); return true; }
    if t[0].selecting || t[0].press_kind != 0 || zr_on_transcript(s, lx, ly) { t_pointer(t, s[0].atlas[..], lx, ly, 1, clicks, shift); }
    else { t_hover(t, -1, -1); }
    zr_update_cursor(s);
    return false;
  }
  if pk_is_open(p) { pk_release(p); }
  if s[0].swallow { s[0].swallow = false; return false; }
  composer_release(c);
  if t[0].selecting || t[0].press_kind != 0 { t_pointer(t, s[0].atlas[..], lx, ly, 2, clicks, shift); }
  zr_update_cursor(s);
  return false;
}
// A wheel's pixel delta: the composer's text scrolls when the pointer is
// over it and it overflows; otherwise the transcript.
coaxial_zeron_wheel :: (s: [] ZeronState, dy: f32) -> bool #export_c {
  if s.count < 1 { return false; }
  if pk_is_open(s[0].picker[..]) { return pk_wheel(s[0].picker[..], zr_view_cat(s), dy); }
  if zr_on_composer(s, s[0].lx, s[0].ly) && composer_wheel(s[0].composer[..], dy) { return true; }
  moved := t_wheel(s[0].transcript[..], dy);
  t_hover(s[0].transcript[..], s[0].lx, s[0].ly);
  return moved;
}
coaxial_zeron_key :: (s: [] ZeronState, key_code: int, mods: int) -> bool #export_c {
  if s.count < 1 { return false; }
  // an open menu holds the keyboard
  p := s[0].picker[..];
  if pk_is_open(p) {
    took := pk_key(p, zr_view_cat(s), zr_menu_sel(s), key_code, mods);
    zr_take_picks(s);
    return took;
  }
  // Escape stops a running turn (Enter never does: it sends, and the CLI queues it)
  if key_code == KEY_ESCAPE && mods == 0 && s[0].session[0].live && !s[0].demo { zr_stop(s); return true; }
  return composer_key(s[0].composer[..], s[0].atlas[..], key_code, mods);
}
// Typing: text with no range (replaces the selection or the composition).
coaxial_zeron_text :: (s: [] ZeronState, text: string) #export_c {
  if s.count > 0 && pk_is_open(s[0].picker[..]) { b := pk_text(s[0].picker[..], zr_view_cat(s), text); return; }
  if s.count < 1 || !s[0].composer[0].focused { return; }
  composer_insert(s[0].composer[..], text);
}

// The Edit menu.
coaxial_zeron_undo :: (s: [] ZeronState) #export_c { if s.count > 0 { composer_undo(s[0].composer[..]); } }
coaxial_zeron_redo :: (s: [] ZeronState) #export_c { if s.count > 0 { composer_redo(s[0].composer[..]); } }
coaxial_zeron_can_undo :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && can_undo(s[0].composer[..]); }
coaxial_zeron_can_redo :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && can_redo(s[0].composer[..]); }
// Select All: the focused composer's text, else the whole transcript.
coaxial_zeron_select_all :: (s: [] ZeronState) #export_c {
  if s.count < 1 { return; }
  if s[0].composer[0].focused { composer_select_all(s[0].composer[..]); return; }
  t := s[0].transcript[..];
  if t[0].nsel == 0 { return; }
  t[0].anchor = SelPos.{line = 0, off = 0};
  t[0].focus = SelPos.{line = t[0].nsel - 1, off = t_line_len(t, t[0].nsel - 1)};
  t[0].has_sel = true;
}
// The selection's bytes, for Copy and Cut (0 when nothing is selected):
// the focused composer's, else the transcript's.
zr_composer_selects :: (s: [] ZeronState) -> bool { return s[0].composer[0].focused && sel_hi(s[0].composer[..]) > sel_lo(s[0].composer[..]); }
coaxial_zeron_selected :: (s: [] ZeronState, out: [] u8) -> int #export_c {
  if s.count < 1 { return 0; }
  if !zr_composer_selects(s) {
    n := t_selected(s[0].transcript[..], out);
    return ifx n > out.count then 0 else n;
  }
  t := selected(s[0].composer[..]);
  if t.count > out.count { return 0; }
  for k: 0..<t.count { out[k] = t[k]; }
  return t.count;
}
coaxial_zeron_selected_count :: (s: [] ZeronState) -> int #export_c {
  if s.count < 1 { return 0; }
  if !zr_composer_selects(s) { none: [1] u8; return t_selected(s[0].transcript[..], none[0..<0]); }
  return sel_hi(s[0].composer[..]) - sel_lo(s[0].composer[..]);
}
// Whether Cut applies (only the composer's text can be cut).
coaxial_zeron_can_cut :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && zr_composer_selects(s); }
// A code block's Copy, pressed: its code's bytes, once (0 when none waits).
coaxial_zeron_take_copy :: (s: [] ZeronState, out: [] u8) -> int #export_c {
  if s.count < 1 { return 0; }
  t := s[0].transcript[..];
  // a notice's copy: its message
  if t[0].copy_notice > 0 {
    msg := t[0].notices[t[0].copy_notice - 1].text;
    t[0].copy_notice = 0;
    if msg.count > out.count { return 0; }
    for k: 0..<msg.count { out[k] = msg[k]; }
    return msg.count;
  }
  b := t[0].copy_code - 1;
  if b < 0 { return 0; }
  code := md_block_text(t[0].md[..], b);
  if code.count > out.count { return 0; }
  t[0].copy_code = 0;
  for k: 0..<code.count { out[k] = code[k]; }
  return code.count;
}
// The demo as the transcript-fixture capture opens it (every group open,
// and the thought, the failed run and the edit, then the first run of the
// second group), or all closed again; and a scroll from the top in px.
coaxial_zeron_fixture :: (s: [] ZeronState, open: bool) #export_c {
  if s.count < 1 { return; }
  zr_demo(s);
  t := s[0].transcript[..];
  for g: 0..<t[0].ng { t_set_open(t, g, -1, open); for k: 0..<t[0].groups[g].tools { t_set_open(t, g, k, false); } }
  if open { t_set_open(t, 0, 0, true); t_set_open(t, 0, 3, true); t_set_open(t, 0, 4, true); t_set_open(t, 1, 0, true); }
}
// The shot step `fixture table`: a reply with GFM tables.
coaxial_zeron_fixture_table :: (s: [] ZeronState) #export_c {
  if s.count < 1 { return; }
  zr_demo(s);
  t := s[0].transcript[..];
  t_reset(t);
  t_table_demo(t);
}
// The engine's buffers (the host allocates them: a conversation's text, a
// stdout line, its decoded strings, the frames owed to the CLI, the
// argument list) and the folder Claude Code works in. Without them (the
// checks here) a sent message only joins the transcript.
coaxial_zeron_attach :: (s: [] ZeronState, pool: [] u8, line: [] u8, arena: [] u8, out: [] u8, scratch: [] u8, cwd: string) #export_c {
  if s.count < 1 { return; }
  e := s[0].engine[..];
  // the last five 64 KiB of the pool are the Psionic engine's, and before them the Lab's request, response and curl's stderr
  ps := pool.count - 5 * ZR_PS_BUF;
  lab := ps - LAB_BODY - LAB_OUT - LAB_ERR - GS_LOG;
  s_init(s[0].session[..], ifx lab > ZR_PS_BUF then pool[0..<lab] else pool);
  if lab > ZR_PS_BUF { lab_attach(s[0].lab[..], pool[lab..<lab + LAB_BODY], pool[lab + LAB_BODY..<lab + LAB_BODY + LAB_OUT], pool[lab + LAB_BODY + LAB_OUT..<ps - GS_LOG]); }
  e[0].line = line; e[0].arena = arena; e[0].out = out; e[0].scratch = scratch;
  e[0].p[0].handle = -1; e[0].probe = -1; e[0].pend = -1;
  e[0].cwd_n = e_set(e[0].cwd[..], 0, cwd);
  e_init(e);
  zr_catalogs(s);
  e[0].att = s[0].att[..];
  e[0].on = true;
  e_probe_start(e);
  p := s[0].psionic[..];
  ps_init(p);
  gs_init(s[0].gpu[..]);
  if lab > ZR_PS_BUF { gs_attach(s[0].gpu[..], pool[ps - GS_LOG..<ps]); }
  if ps > ZR_PS_BUF {
    b := ZR_PS_BUF;
    ps_attach(p, pool[ps..<ps + b], pool[ps + b..<ps + 2 * b], pool[ps + 2 * b..<ps + 3 * b], pool[ps + 3 * b..<ps + 4 * b], pool[ps + 4 * b..<ps + 5 * b], e_str(e[0].cwd[..], e[0].cwd_n));
  }
}
// The Codex engine and its buffers (the host allocates them: the engine itself, a stdout line, its
// decoded strings, the requests owed to the server, its own CX_MEM bytes); it works in the chat's folder.
coaxial_zeron_attach_codex :: (s: [] ZeronState, x: [] CxEngine, line: [] u8, arena: [] u8, out: [] u8, mem: [] u8) #export_c {
  if s.count < 1 || x.count < 1 { return; }
  e := s[0].engine[..];
  s[0].codex = x;
  cxe_attach(x, line, arena, out, mem, e_str(e[0].cwd[..], e[0].cwd_n));
  x[0].att = s[0].att[..]; x[0].prompt = s[0].prompt;
  zr_catalogs(s);
}
// Microcoder for the Lab's other route (microcoder.coax), the host's for the app's life; it works in the chat's folder.
coaxial_zeron_attach_mc :: (s: [] ZeronState, m: [] LabMc) #export_c {
  if s.count < 1 || m.count < 1 { return; }
  e := s[0].engine[..];
  m[0].ncwd = e_set(m[0].cwd[..], 0, e_str(e[0].cwd[..], e[0].cwd_n));
  s[0].lab[0].mc = m;
}
// The bytes the Codex engine's own buffer needs (the mem above).
coaxial_zeron_codex_mem :: () -> int #export_c { return CX_MEM; }
// The demo conversation (--demo).
coaxial_zeron_demo :: (s: [] ZeronState) #export_c { if s.count > 0 { zr_demo(s); } }
// Picks a chip's choice among the mode's (coaxial_zeron_option_*): which 1
// the model (its row in the mode's catalog: Claude's 13, Psionic's
// gpt-oss-20b), 2 the effort (the catalog's level: Claude 0 Low .. 6
// Ultrathink; Psionic 0 Low, 1 Medium, 2 High), 3 access (0 Full access, 1
// Auto-accept edits, 2 Supervised), 4 the mode (MODE_*, an empty chat
// only), 5 plan mode (0 off, 1 on).
coaxial_zeron_choose :: (s: [] ZeronState, which: int, index: int) #export_c {
  if s.count < 1 || index < 0 { return; }
  e := s[0].engine[..];
  if which == CH_MODE { b := zr_set_mode(s, index); return; }
  if which == 5 && s[0].mode == MODE_CODEX { if s[0].codex.count > 0 { s[0].codex[0].plan = index != 0; } zr_labels(s); return; }
  if which == 5 { e_set_plan(e, index != 0); zr_labels(s); return; }
  if s[0].mode == MODE_CODEX {
    // the engine's catalog (Codex's model/list once it has answered)
    if which == CH_MODEL { cxe_set_model(s[0].codex, index); }
    if which == CH_EFFORT && s[0].codex.count > 0 && index < s[0].codex[0].cat[0].levels { s[0].codex[0].effort = index; }
    if which == CH_ACCESS && index < 3 { e_set_access(e, index); }
    zr_labels(s);
    return;
  }
  if index >= mode_option_count(s[0].mode, which) { return; }
  if s[0].mode == MODE_PSIONIC {
    if which == CH_EFFORT { s[0].psionic[0].effort = index; }
  } else if s[0].mode != MODE_LAB {
    if which == CH_MODEL { e_set_model(e, index); }
    if which == CH_EFFORT { e[0].effort = index; }
  }
  if which == CH_ACCESS { e_set_access(e, index); }
  zr_labels(s);
}
// The same by name (the host's --model and --effort): a model's id or
// name, or the start of its name ("haiku"); a level's id or name. Whether one matched.
coaxial_zeron_choose_named :: (s: [] ZeronState, which: int, name: string) -> bool #export_c {
  if s.count < 1 || name.count == 0 { return false; }
  cat := s[0].cats[s[0].mode..<s[0].mode + 1];
  if cat[0].n == 0 { zr_catalogs(s); }
  n := ifx which == CH_MODEL then cat[0].n else ifx which == CH_EFFORT then cat[0].levels else 0;
  for pass: 0..<3 {
    for k: 0..<n {
      id := ifx which == CH_MODEL then cat[0].id[k] else cat[0].level_id[k];
      label := ifx which == CH_MODEL then cat[0].label[k] else cat[0].level_label[k];
      hit := ifx pass == 0 then id.count > 0 && zr_same(id, name) else ifx pass == 1 then zr_same(label, name) else label.count >= name.count && zr_same(cast(string) label[0..<name.count], name);
      if hit { coaxial_zeron_choose(s, which, k); return true; }
    }
  }
  return false;
}
zr_same :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count { if pk_lower(a[i]) != pk_lower(b[i]) { return false; } }
  return true;
}
// A chip's menu, opened as a press on it would (1 the model, 3 the access).
coaxial_zeron_open_menu :: (s: [] ZeronState, which: int) #export_c {
  if s.count < 1 || (which != CH_MODEL && which != CH_ACCESS) { return; }
  if s[0].picker[0].kind == PK_NONE || s[0].composer[0].open != which { zr_open_menu(s, which); }
}
// The attachments' store (the host's buffer for their bytes).
coaxial_zeron_attach_store :: (s: [] ZeronState, store: [] u8) #export_c {
  if s.count < 1 { return; }
  room := ZR_PROMPT;
  if store.count <= 2 * room { s[0].att[0].store = store; s[0].att[0].used = 0; return; }
  s[0].att[0].store = store[0..<store.count - room]; s[0].att[0].used = 0;
  s[0].prompt = store[store.count - room..<store.count];
  s[0].engine[0].prompt = s[0].prompt;
  if s[0].codex.count > 0 { s[0].codex[0].prompt = s[0].prompt; }
}
// A file the host staged (attachments.coax): its staged path, its name and
// (up to 5 MB) its bytes join the draft as a chip at the caret; failure 1
// (too large), 2 (not a file) or 3 (unreadable) shows Zeron's notice instead.
coaxial_zeron_attach_file :: (s: [] ZeronState, path: string, name: string, bytes: [] u8, failure: int) #export_c {
  if s.count < 1 || s[0].demo { return; }
  c := s[0].composer[..];
  if failure > 0 { buf: [512] u8; zr_fail(s, cast(string) buf[0..<at_failure(name, failure, buf[..])]); return; }
  if s[0].att[0].store.count == 0 { s[0].att[0].store = s[0].own_store[..]; }
  chip: [8] u8;
  n := at_add(s[0].att[..], s[0].atlas[..], path, name, bytes, chip[..]);
  if n == 0 { return; }
  chip[n] = ' ';
  c[0].focused = true;
  composer_insert(c, cast(string) chip[0..<n + 1]);
  c[0].failure_n = 0;
}
// The chips' choices for the chat's mode, for a picker menu (which as for
// coaxial_zeron_choose): how many, each label, the chosen one.
coaxial_zeron_option_count :: (s: [] ZeronState, which: int) -> int #export_c { if s.count < 1 { return 0; } return mode_option_count(s[0].mode, which); }
coaxial_zeron_option_label :: (s: [] ZeronState, which: int, i: int, out: [] u8) -> int #export_c {
  if s.count < 1 { return 0; }
  l := mode_option_label(s[0].mode, which, i);
  n := ifx l.count < out.count then l.count else out.count;
  for k: 0..<n { out[k] = l[k]; }
  return n;
}
coaxial_zeron_option_selected :: (s: [] ZeronState, which: int) -> int #export_c {
  if s.count < 1 { return -1; }
  e := s[0].engine[..];
  if which == CH_MODE { return s[0].mode; }
  if which == CH_ACCESS { return e[0].access; }
  if s[0].mode == MODE_PSIONIC { return ifx which == CH_MODEL then 0 else ifx which == CH_EFFORT then s[0].psionic[0].effort else -1; }
  if s[0].mode == MODE_LAB { return ifx which == CH_MODEL || which == CH_EFFORT then 0 else -1; }
  if s[0].mode == MODE_CODEX && s[0].codex.count > 0 { x := s[0].codex; return ifx which == CH_MODEL then x[0].model else ifx which == CH_EFFORT then x[0].effort else -1; }
  return ifx which == CH_MODEL then e[0].model else ifx which == CH_EFFORT then e[0].effort else -1;
}
// The chat's mode (MODE_*), and whether it can still change (the chat is empty).
coaxial_zeron_mode :: (s: [] ZeronState) -> int #export_c { if s.count < 1 { return 0; } return s[0].mode; }
coaxial_zeron_mode_open :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && zr_fresh(s); }
// Each mode's mark (an icon index; 0 the Claude mark in its brand tone).
coaxial_zeron_mode_brand :: (mode: int) -> int #export_c { brands := MODE_BRANDS; return ifx mode >= 0 && mode < MODE_COUNT then brands[mode] else 0; }
// Whether a turn is running (the --shot steps wait on it).
coaxial_zeron_live :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && s[0].session[0].live; }
// What the host should do for a notice's button (HOST_LOGIN: Terminal running `claude /login`; HOST_INSTALL: the install line;
// HOST_CODEX_LOGIN and HOST_CODEX_INSTALL the same for Codex: `codex login`, its npm line), once.
coaxial_zeron_take_action :: (s: [] ZeronState) -> int #export_c {
  if s.count < 1 { return 0; }
  a := s[0].host_action; s[0].host_action = HOST_NONE;
  return a;
}
// The app is quitting: Claude Code's process group goes with it.
coaxial_zeron_quit :: (s: [] ZeronState) #export_c { if s.count > 0 && s[0].engine[0].on { e_close(s[0].engine[..]); ps_close(s[0].psionic[..]); so_cancel(s[0].lab[0].call[..]); gs_close(s[0].gpu[..]); cxe_close(s[0].codex); } }
coaxial_zeron_scroll_to :: (s: [] ZeronState, px: f32) #export_c { if s.count > 0 { s[0].want_scroll = ifx px < 0 then 0.0f32 else px; } }
coaxial_zeron_cut :: (s: [] ZeronState) #export_c { if s.count > 0 { composer_cut_selection(s[0].composer[..]); } }
coaxial_zeron_paste :: (s: [] ZeronState, text: string) #export_c {
  if s.count < 1 || !s[0].composer[0].focused { return; }
  composer_paste(s[0].composer[..], text);
}

// NSTextInputClient, in UTF-16 offsets (from < 0: no range given).
coaxial_zeron_replace :: (s: [] ZeronState, from16: int, to16: int, text: string) #export_c {
  if s.count > 0 && pk_is_open(s[0].picker[..]) { b := pk_text(s[0].picker[..], zr_view_cat(s), text); return; }
  if s.count < 1 || !s[0].composer[0].focused { return; }
  c := s[0].composer[..];
  if from16 < 0 { composer_replace(c, -1, -1, text); return; }
  composer_replace(c, byte_of(c, from16), byte_of(c, to16), text);
}
coaxial_zeron_mark :: (s: [] ZeronState, from16: int, to16: int, text: string, sel_from16: int, sel_to16: int) #export_c {
  if s.count < 1 || !s[0].composer[0].focused || pk_is_open(s[0].picker[..]) { return; }
  c := s[0].composer[..];
  sf := ifx sel_from16 < 0 then -1 else byte_in(text, sel_from16);
  st := ifx sel_from16 < 0 then -1 else byte_in(text, sel_to16);
  if from16 < 0 { composer_mark(c, -1, -1, text, sf, st); return; }
  composer_mark(c, byte_of(c, from16), byte_of(c, to16), text, sf, st);
}
coaxial_zeron_unmark :: (s: [] ZeronState) #export_c { if s.count > 0 { composer_unmark(s[0].composer[..]); } }
// which 0: the selection's start, 1 its end, 2 the composition's start, 3 its end (-1 without one), 4 the text's length.
coaxial_zeron_range16 :: (s: [] ZeronState, which: int) -> int #export_c {
  if s.count < 1 { return -1; }
  c := s[0].composer[..];
  if which == 0 { return u16_of(c, sel_lo(c)); }
  if which == 1 { return u16_of(c, sel_hi(c)); }
  if which == 2 { return ifx c[0].marked then u16_of(c, c[0].marked_at) else -1; }
  if which == 3 { return ifx c[0].marked then u16_of(c, c[0].marked_end) else -1; }
  return u16_of(c, c[0].n);
}
// The bytes of a UTF-16 range (attributedSubstringForProposedRange).
coaxial_zeron_text16 :: (s: [] ZeronState, from16: int, to16: int, out: [] u8) -> int #export_c {
  if s.count < 1 { return 0; }
  c := s[0].composer[..];
  a := byte_of(c, from16); b := byte_of(c, to16);
  if b < a || b - a > out.count { return 0; }
  for k: a..<b { out[k - a] = c[0].text[k]; }
  return b - a;
}
// bounds_for_range: the caret-sized rect (logical px, the view's top-left
// origin) at a UTF-16 offset, where the IME puts its candidates.
coaxial_zeron_rect16 :: (s: [] ZeronState, at16: int, out: [] f32) -> bool #export_c {
  if s.count < 1 || out.count < 4 || !s[0].atlas[0].ready { return false; }
  c := s[0].composer[..];
  i := byte_of(c, at16);
  k := ifx i == c[0].caret then row_of(c, i, c[0].upstream) else row_of(c, i, false);
  out[0] = c[0].text_x + x_in_row(c, s[0].atlas[..], k, i);
  out[1] = c[0].text_y - c[0].scroll + cast(f32) k * INPUT_LINE_HEIGHT;
  out[2] = 2; out[3] = INPUT_LINE_HEIGHT;
  return true;
}
// character_index_for_point: the UTF-16 offset under a device point.
coaxial_zeron_index16 :: (s: [] ZeronState, x: f32, y: f32) -> int #export_c {
  if s.count < 1 || !s[0].atlas[0].ready { return 0; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  c := s[0].composer[..];
  return u16_of(c, content_hit(c, s[0].atlas[..], x / d, y / d).at);
}
coaxial_zeron_wants_text :: (s: [] ZeronState) -> bool #export_c { return s.count > 0 && (s[0].composer[0].focused || pk_is_open(s[0].picker[..])); }
coaxial_zeron_cursor :: (s: [] ZeronState) -> int #export_c { if s.count < 1 { return 0; } return s[0].cursor; }
coaxial_zeron_max_vertices :: () -> int #export_c { return ZR_MAX_VERTICES; }
coaxial_zeron_vertex_floats :: () -> int #export_c { return GP_VERTEX_FLOATS; }

// What the atlas holds: the glyphs, the fonts (size, weight), the icons (name, size).
coaxial_zeron_glyph_count :: () -> int #export_c { return GP_GLYPHS; }
coaxial_zeron_glyph_code :: (g: int) -> int #export_c {
  if g < 95 { return g + 32; }
  extra := GP_EXTRA;
  return ifx g - 95 < 3 then cast(int) extra[g - 95] else 63;
}
coaxial_zeron_font_count :: () -> int #export_c { return GP_FONTS; }
coaxial_zeron_font_size :: (k: int) -> f32 #export_c { sizes := FONT_SIZES; return ifx k >= 0 && k < GP_FONTS then sizes[k] else 14.0f32; }
coaxial_zeron_font_weight :: (k: int) -> int #export_c { weights := FONT_WEIGHTS; return ifx k >= 0 && k < GP_FONTS then weights[k] else 0; }
coaxial_zeron_icon_count :: () -> int #export_c { return ICON_COUNT; }
coaxial_zeron_icon_size :: (i: int) -> f32 #export_c { sizes := ICON_SIZES; return ifx i >= 0 && i < ICON_COUNT then sizes[i] else 16.0f32; }
coaxial_zeron_icon_name :: (i: int, out: [] u8) -> int #export_c {
  if i < 0 || i >= ICON_COUNT { return 0; }
  names := ICON_NAMES;
  n := ifx names[i].count < out.count then names[i].count else out.count;
  for k: 0..<n { out[k] = names[i][k]; }
  return n;
}

// The host's measurements of a font: header is ascent, descent, cell,
// pen x, pen y, first cell's y, columns; then the advances and kerning.
coaxial_zeron_set_font :: (s: [] ZeronState, slot: int, header: [] f32, advance: [] f32, kern: [] f32) #export_c {
  if s.count < 1 || slot < 0 || slot >= GP_FONTS || header.count < 7 || advance.count < GP_GLYPHS || kern.count < GP_GLYPHS * GP_GLYPHS { return; }
  sizes := FONT_SIZES;
  s[0].atlas[0].fonts[slot].size = sizes[slot];
  s[0].atlas[0].fonts[slot].ascent = header[0]; s[0].atlas[0].fonts[slot].descent = header[1];
  s[0].atlas[0].fonts[slot].cell = header[2]; s[0].atlas[0].fonts[slot].pen_x = header[3]; s[0].atlas[0].fonts[slot].pen_y = header[4];
  s[0].atlas[0].fonts[slot].y0 = header[5]; s[0].atlas[0].fonts[slot].cols = cast(int) header[6];
  for g: 0..<GP_GLYPHS { s[0].atlas[0].fonts[slot].advance[g] = advance[g]; }
  for k: 0..<GP_GLYPHS * GP_GLYPHS { s[0].atlas[0].fonts[slot].kern[k] = kern[k]; }
}
coaxial_zeron_set_icon :: (s: [] ZeronState, i: int, x: f32, y: f32, w: f32, h: f32) #export_c {
  if s.count < 1 || i < 0 || i >= GP_ICONS { return; }
  s[0].atlas[0].icons[i] = GpIcon.{x = x, y = y, w = w, h = h};
}
coaxial_zeron_set_atlas :: (s: [] ZeronState, width: f32, height: f32) #export_c {
  if s.count < 1 { return; }
  s[0].atlas[0].width = width; s[0].atlas[0].height = height; s[0].atlas[0].ready = width > 0 && height > 0;
}

// The glyph cache (gpui.coax): the host measures each new grapheme and
// draws each wanted cell, then says so.
coaxial_zeron_set_dynamic :: (s: [] ZeronState, size: f32, pen_x: f32, pen_y: f32, y0: f32, cols: int, color_cols: int, color_width: f32, color_height: f32) #export_c {
  if s.count < 1 { return; }
  s[0].atlas[0].dyn_size = size; s[0].atlas[0].dyn_pen_x = pen_x; s[0].atlas[0].dyn_pen_y = pen_y;
  s[0].atlas[0].dyn_y0 = y0; s[0].atlas[0].dyn_cols = cols;
  s[0].atlas[0].color_cols = color_cols; s[0].atlas[0].color_width = color_width; s[0].atlas[0].color_height = color_height;
  // a new atlas: every cell is drawn again
  for k: 0..<GP_DYN_CELLS { dyn_free_cell(s[0].atlas[..], k); }
}
coaxial_zeron_next_cluster :: (s: [] ZeronState) -> int #export_c {
  if s.count < 1 { return -1; }
  for k: 0..<GP_DYN_SLOTS { if s[0].atlas[0].clusters[k].state == 1 { return k; } }
  return -1;
}
// A slot's bytes (and its font in out's first return: font * 256 + count).
coaxial_zeron_cluster :: (s: [] ZeronState, slot: int, out: [] u8) -> int #export_c {
  if s.count < 1 || slot < 0 || slot >= GP_DYN_SLOTS { return 0; }
  n := s[0].atlas[0].clusters[slot].n;
  if n > out.count { return 0; }
  for k: 0..<n { out[k] = s[0].atlas[0].clusters[slot].bytes[k]; }
  return s[0].atlas[0].clusters[slot].font * 256 + n;
}
coaxial_zeron_measured :: (s: [] ZeronState, slot: int, advance: f32, color: bool) #export_c {
  if s.count < 1 || slot < 0 || slot >= GP_DYN_SLOTS { return; }
  s[0].atlas[0].clusters[slot].advance = advance; s[0].atlas[0].clusters[slot].color = color;
  s[0].atlas[0].clusters[slot].state = 2;
}
coaxial_zeron_next_cell :: (s: [] ZeronState) -> int #export_c {
  if s.count < 1 { return -1; }
  for k: 0..<GP_DYN_CELLS { if s[0].atlas[0].cells[k].state == 1 { return k; } }
  return -1;
}
// A wanted cell: its slot, dilation, subpixel, whether color, and its texel origin.
coaxial_zeron_cell :: (s: [] ZeronState, cell: int, out: [] f32) -> bool #export_c {
  if s.count < 1 || cell < 0 || cell >= GP_DYN_CELLS || out.count < 6 { return false; }
  g := s[0].atlas[0].cells[cell];
  out[0] = cast(f32) g.slot; out[1] = cast(f32) g.level; out[2] = cast(f32) g.variant;
  out[3] = ifx cell >= GP_DYN_MONO then 1.0f32 else 0.0f32;
  out[4] = dyn_cell_x(s[0].atlas[..], cell); out[5] = dyn_cell_y(s[0].atlas[..], cell);
  return true;
}
coaxial_zeron_cell_ready :: (s: [] ZeronState, cell: int) #export_c {
  if s.count < 1 || cell < 0 || cell >= GP_DYN_CELLS { return; }
  if s[0].atlas[0].cells[cell].state == 1 { s[0].atlas[0].cells[cell].state = 2; }
}

zr_test_screen :: (s: [] ZeronState) {
  header := [7] f32.[13, 3, 64, 12, 44, 0, 64];
  adv: [GP_GLYPHS] f32;
  for g: 0..<GP_GLYPHS { adv[g] = 7; }
  kern: [9604] f32;
  for k: 0..<GP_FONTS { coaxial_zeron_set_font(s, k, header[..], adv[..], kern[..]); }
  for i: 0..<ICON_COUNT { coaxial_zeron_set_icon(s, i, 0, 0, 36, 36); }
  coaxial_zeron_set_atlas(s, 8192, 2048);
}

#test "Psionic reads text alone: a message with an image stays in the composer, with why" {
  s: [1] ZeronState;
  out: [200000] f32;
  png := [8] u8.[0x89, 'P', 'N', 'G', 13, 10, 26, 10];
  c := s[0].composer[..];
  zr_test_screen(s[..]);
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  coaxial_zeron_choose(s[..], CH_MODE, MODE_PSIONIC);
  coaxial_zeron_attach_file(s[..], "/up/1a2b3c4d-red-blue.png", "red-blue.png", png[..], 0);
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert s[0].session[0].n == 0 && c[0].n == 5 && s[0].att[0].n == 1 && s[0].att[0].sn == 0;
  #assert cast(string) c[0].failure[0..<c[0].failure_n] == "gpt-oss-20b reads text only, so it can't see Image 1. Remove it, or switch the chat to Claude.";
}

#test "the screen opens on Zeron's empty new chat; a sent message starts the chat, the composer docked under it" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  #assert n > 100 && coaxial_zeron_wants_text(s[..]) && !c[0].docked && !c[0].compact && t[0].nr == 0;
  #assert c[0].x == 292 && c[0].w == 736 && c[0].y == round_layout((880 - c[0].h) / 2 - 12);
  #assert c[0].model_label == "Claude" && c[0].effort_label == "High" && c[0].access_label == "Full access";
  // the model chip opens the compact picker under it (a new chat's menus open below)
  p := s[0].picker[..];
  px := (c[0].chip_x[CH_MODEL] + 3) * 2; py := (c[0].chip_y[CH_MODEL] + 3) * 2;
  #assert coaxial_zeron_pointer(s[..], px, py, 0, 1, 0);
  #assert !coaxial_zeron_pointer(s[..], px, py, 2, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert p[0].kind == PK_MODEL && p[0].below && c[0].open == CH_MODEL && coaxial_zeron_wants_text(s[..]);
  #assert p[0].y == c[0].chip_y[CH_MODEL] + c[0].chip_h[CH_MODEL] + 6 && p[0].x + p[0].w == c[0].chip_x[CH_MODEL] + c[0].chip_w[CH_MODEL];
  // Right steps the effort; Down opens the list on the next model, Enter picks it
  #assert coaxial_zeron_key(s[..], KEY_RIGHT, 0) && c[0].effort_label == "X-High";
  #assert coaxial_zeron_key(s[..], KEY_DOWN, 0) && p[0].list;
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0) && c[0].model_label == "Fable 5.1" && !p[0].list;
  // typing searches the list
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0) && p[0].list;
  coaxial_zeron_text(s[..], "sonnet");
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0) && c[0].model_label == "Sonnet 5" && c[0].effort_label == "X-High";
  // a press on its chip closes it, and goes nowhere else
  #assert coaxial_zeron_pointer(s[..], px, py, 0, 1, 0) && !pk_is_open(p) && c[0].open == -1;
  #assert !coaxial_zeron_pointer(s[..], px, py, 2, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert !pk_is_open(p);
  // the access menu: Up from Full access is Auto-accept edits
  ax := (c[0].chip_x[CH_ACCESS] + 3) * 2; ay := (c[0].chip_y[CH_ACCESS] + 3) * 2;
  #assert coaxial_zeron_pointer(s[..], ax, ay, 0, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert p[0].kind == PK_ACCESS_MENU && p[0].w == 288;
  #assert coaxial_zeron_key(s[..], KEY_UP, 0) && coaxial_zeron_key(s[..], KEY_ENTER, 0);
  #assert c[0].access_label == "Auto-accept edits" && s[0].engine[0].access == ACC_EDITS && !pk_is_open(p);
  // the paperclip asks the host for files
  cx := (c[0].chip_x[CH_ATTACH] + 3) * 2; cy := (c[0].chip_y[CH_ATTACH] + 3) * 2;
  #assert coaxial_zeron_pointer(s[..], cx, cy, 0, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert coaxial_zeron_take_action(s[..]) == HOST_ATTACH && coaxial_zeron_take_action(s[..]) == HOST_NONE;
  #assert coaxial_zeron_choose_named(s[..], CH_MODEL, "haiku") && c[0].model_label == "Haiku 4.5" && c[0].no_effort && c[0].effort_label == "";
  #assert coaxial_zeron_choose_named(s[..], CH_MODEL, "opus") && c[0].model_label == "Opus 5.5" && s[0].engine[0].model == 3;
  coaxial_zeron_text(s[..], "hi");
  #assert c[0].n == 2 && coaxial_zeron_key(s[..], -3, 0) && c[0].n == 1;
  // Enter sends: the message joins the transcript as a bubble, the turn runs
  #assert coaxial_zeron_key(s[..], -2, 0) && c[0].n == 0;
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert t[0].nr == 1 && t[0].rows[0].kind == R_USER && t[0].rows[0].text == "h";
  #assert c[0].docked && c[0].compact && c[0].running && t[0].working && coaxial_zeron_live(s[..]);
  #assert c[0].h == 49 && c[0].y == 880 - 40 - 49;
  // Send is Stop now: pressing it stops the turn, and the transcript says so
  sx := (c[0].chip_x[CH_SEND] + 14) * 2; sy := (c[0].chip_y[CH_SEND] + 14) * 2;
  #assert coaxial_zeron_pointer(s[..], sx, sy, 0, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert !coaxial_zeron_live(s[..]) && !c[0].running && t[0].nr == 2 && t[0].rows[1].kind == R_NOTICE;
  #assert t[0].notices[t[0].rows[1].notice].kind == N_STOPPED;
}

#test "--demo opens Zeron's demo chat, the composer docked and focused under it" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  coaxial_zeron_demo(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert n > 600 && coaxial_zeron_wants_text(s[..]);
  c := s[0].composer[..]; t := s[0].transcript[..];
  #assert c[0].compact && c[0].x == 292 && c[0].w == 736 && c[0].h == 49 && c[0].y == 880 - 40 - 49;
  #assert t[0].nr == 9 && t[0].rows[0].y == 64;
  // short content sits at the bottom, clear of the composer's stack
  #assert t[0].offset > 0 && t[0].content_h + t[0].offset == 880;
  coaxial_zeron_text(s[..], "hi");
  #assert coaxial_zeron_key(s[..], -2, 0) && c[0].n == 0;
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert t[0].nr == 10 && t[0].rows[9].kind == R_USER && t[0].rows[9].text == "hi" && !coaxial_zeron_live(s[..]);
}

#test "the pointer opens a group, selects transcript text for Copy; the wheel scrolls" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  coaxial_zeron_demo(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  t := s[0].transcript[..];
  // the first group's header, in device px
  hy := (t[0].rows[1].y + t[0].offset + 13) * 2;
  #assert !coaxial_zeron_pointer(s[..], 800, hy, 1, 1, 0) && coaxial_zeron_cursor(s[..]) == 2;
  #assert !coaxial_zeron_pointer(s[..], 800, hy, 0, 1, 0) && !coaxial_zeron_wants_text(s[..]);
  #assert !coaxial_zeron_pointer(s[..], 800, hy, 2, 1, 0) && t[0].groups[0].open;
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  // the last bubble: a triple click takes its line, Copy gets it
  by := (t[0].rows[6].y + t[0].offset + 21) * 2;
  #assert !coaxial_zeron_pointer(s[..], 1900, by, 0, 3, 0);
  #assert !coaxial_zeron_pointer(s[..], 1900, by, 2, 3, 0);
  buf: [256] u8;
  #assert coaxial_zeron_selected_count(s[..]) == 24 && coaxial_zeron_selected(s[..], buf[..]) == 24 && !coaxial_zeron_can_cut(s[..]);
  #assert cast(string) buf[0..<24] == "Ship it and open the PR.";
  // everything open: taller than the window, pinned to the bottom; the wheel moves it
  coaxial_zeron_fixture(s[..], true);
  coaxial_zeron_scroll_to(s[..], 500);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert t[0].scroll == 500 && t[0].offset == -500;
  #assert coaxial_zeron_wheel(s[..], 100) && t[0].scroll == 400;
  // a code block's Copy hands the host its code
  t[0].copy_code = t[0].rows[4].block + 1;
  #assert coaxial_zeron_take_copy(s[..], buf[..]) == 83 && coaxial_zeron_take_copy(s[..], buf[..]) == 0;
  name: [32] u8;
  #assert coaxial_zeron_icon_name(2, name[..]) == 11 && coaxial_zeron_icon_count() == ICON_COUNT && coaxial_zeron_font_size(5) == 12.5;
  #assert coaxial_zeron_glyph_code(0) == 32 && coaxial_zeron_glyph_code(95) == 0x2026;
}

#test "the model chip carries the mode: an empty chat's model list has a tab per mode; a conversation keeps its mode" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  #assert coaxial_zeron_mode(s[..]) == MODE_CLAUDE && c[0].brand == 0 && coaxial_zeron_mode_open(s[..]);
  // an empty chat's model list has a tab per mode: Tab, then Enter picks gpt-oss-20b, its mark and its own efforts
  p := s[0].picker[..];
  coaxial_zeron_open_menu(s[..], CH_MODEL);
  #assert p[0].tabs == MODE_COUNT && p[0].view == MODE_CLAUDE;
  #assert coaxial_zeron_key(s[..], KEY_TAB, 0) && p[0].list && p[0].view == MODE_PSIONIC;
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0) && !p[0].list && pk_is_open(p);
  #assert coaxial_zeron_mode(s[..]) == MODE_PSIONIC && c[0].model_label == "gpt-oss-20b" && c[0].effort_label == "Medium" && c[0].brand == ICON_PSIONIC;
  #assert coaxial_zeron_option_count(s[..], CH_MODEL) == 1 && coaxial_zeron_option_count(s[..], CH_EFFORT) == 3 && coaxial_zeron_option_selected(s[..], CH_EFFORT) == 1;
  buf: [32] u8;
  #assert coaxial_zeron_option_label(s[..], CH_EFFORT, 2, buf[..]) == 4 && cast(string) buf[0..<4] == "High";
  #assert coaxial_zeron_option_label(s[..], CH_MODE, 1, buf[..]) == 7 && coaxial_zeron_mode_brand(MODE_PSIONIC) == ICON_PSIONIC;
  // the panel's slider is Psionic's three efforts
  #assert coaxial_zeron_key(s[..], KEY_END, 0) && c[0].effort_label == "High" && s[0].psionic[0].effort == 2 && s[0].engine[0].effort == 2;
  // the Lab's tab, then back to Claude's: its first model
  #assert coaxial_zeron_key(s[..], KEY_TAB, 0) && p[0].view == MODE_LAB;
  #assert coaxial_zeron_key(s[..], KEY_TAB, 0) && p[0].view == MODE_CODEX && p[0].tab_icon[MODE_CODEX] == ICON_OPENAI;
  #assert coaxial_zeron_key(s[..], KEY_TAB, 0) && p[0].view == MODE_CLAUDE;
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0) && coaxial_zeron_key(s[..], KEY_ESCAPE, 0) && !pk_is_open(p);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert coaxial_zeron_mode(s[..]) == MODE_CLAUDE && c[0].model_label == "Claude" && c[0].effort_label == "High" && c[0].brand == 0;
  coaxial_zeron_choose(s[..], CH_MODE, MODE_PSIONIC);
  coaxial_zeron_choose(s[..], CH_EFFORT, 0);
  #assert coaxial_zeron_mode(s[..]) == MODE_PSIONIC && c[0].effort_label == "Low";
  // a message: the chat is Psionic's now, and stays so
  coaxial_zeron_text(s[..], "hi");
  #assert coaxial_zeron_key(s[..], -2, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert coaxial_zeron_live(s[..]) && t[0].rows[0].kind == R_USER && s[0].psionic[0].turn == 1 && !coaxial_zeron_mode_open(s[..]);
  coaxial_zeron_choose(s[..], CH_MODE, MODE_CLAUDE);
  #assert coaxial_zeron_mode(s[..]) == MODE_PSIONIC;
  // the chat has its mode: the list offers its tab alone
  coaxial_zeron_open_menu(s[..], CH_MODEL);
  #assert p[0].tabs == 1 && !p[0].below;
  #assert coaxial_zeron_key(s[..], KEY_ESCAPE, 0) && !pk_is_open(p);
  // Stop (the docked chip is Psionic's too)
  #assert c[0].model_label == "gpt-oss-20b" && c[0].brand == ICON_PSIONIC;
  sx := (c[0].chip_x[CH_SEND] + 14) * 2; sy := (c[0].chip_y[CH_SEND] + 14) * 2;
  #assert coaxial_zeron_pointer(s[..], sx, sy, 0, 1, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert !coaxial_zeron_live(s[..]) && t[0].notices[t[0].rows[1].notice].kind == N_STOPPED;
}

#test "a Lab message joins the transcript and waits for Elephant; the conversation keeps the Lab; Escape ends it" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  coaxial_zeron_choose(s[..], CH_MODE, MODE_LAB);
  #assert coaxial_zeron_mode(s[..]) == MODE_LAB && c[0].model_label == "Lab" && c[0].effort_label == LAB_EFFORT && c[0].brand == ICON_PSIONIC;
  #assert coaxial_zeron_option_count(s[..], CH_EFFORT) == 1 && coaxial_zeron_option_selected(s[..], CH_MODEL) == 0;
  coaxial_zeron_text(s[..], "hi");
  #assert coaxial_zeron_key(s[..], -2, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert t[0].nr == 1 && t[0].rows[0].kind == R_USER && coaxial_zeron_live(s[..]) && s[0].psionic[0].turn == 0;
  coaxial_zeron_choose(s[..], CH_MODE, MODE_CLAUDE);
  #assert coaxial_zeron_mode(s[..]) == MODE_LAB;
  #assert coaxial_zeron_key(s[..], KEY_ESCAPE, 0) && !coaxial_zeron_live(s[..]);
}

#test "attachments: staged files become chips in the draft; Claude gets their labels, paths and images; Psionic refuses an image" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  png := [8] u8.[0x89, 'P', 'N', 'G', 13, 10, 26, 10];
  coaxial_zeron_attach_file(s[..], "/up/1a2b3c4d-red-blue.png", "red-blue.png", png[..], 0);
  note := [5] u8.['h', 'e', 'l', 'l', 'o'];
  coaxial_zeron_attach_file(s[..], "/up/5e6f7a8b-notes.txt", "notes.txt", note[..], 0);
  #assert c[0].n == 10 && s[0].att[0].n == 2 && c[0].focused;
  coaxial_zeron_text(s[..], "what's in these?");
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  // a file too large: Zeron's notice above the composer, dismissed by a press
  coaxial_zeron_attach_file(s[..], "", "movie.mov", png[0..<0], 1);
  #assert cast(string) c[0].failure[0..<c[0].failure_n] == "movie.mov is too large (24 MB max).";
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert c[0].failure_h > 0 && c[0].failure_y + c[0].failure_h == c[0].y - 6;
  #assert coaxial_zeron_pointer(s[..], (c[0].x + 40) * 2, (c[0].failure_y + 5) * 2, 0, 1, 0) && c[0].failure_n == 0;
  #assert !coaxial_zeron_pointer(s[..], (c[0].x + 40) * 2, (c[0].failure_y + 5) * 2, 2, 1, 0);
  #assert coaxial_zeron_key(s[..], KEY_ENTER, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  // the bubble shows the chips; Claude reads their labels and paths
  #assert t[0].rows[0].kind == R_USER && s_text_of(s[0].session[..], 0).count == 10 + 16;   // the chips, their spaces and the text
  e := s[0].engine[..];
  #assert cast(string) e[0].prompt[0..<e[0].prompt_n] == "Image 1 notes.txt what's in these?\n\nAttached images (local files — open them to view):\n- /up/1a2b3c4d-red-blue.png\n- /up/5e6f7a8b-notes.txt";
  #assert s[0].att[0].n == 0;
}

#test "Codex is a mode: the OpenAI mark on the chip, Codex's models and levels, plan mode, its Stop and its sign-in" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  cx: [1] CxEngine; cxe_init(cx[..]);
  s[0].codex = cx[..];
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  coaxial_zeron_choose(s[..], CH_MODE, MODE_CODEX);
  #assert coaxial_zeron_mode(s[..]) == MODE_CODEX && c[0].brand == ICON_OPENAI && coaxial_zeron_mode_brand(MODE_CODEX) == ICON_OPENAI;
  #assert c[0].model_label == "GPT-6-Astra" && c[0].effort_label == "High" && !c[0].access_set;
  #assert s[0].cats[MODE_CODEX].provider == "Codex" && s[0].cats[MODE_CODEX].icon == ICON_OPENAI_14;
  #assert coaxial_zeron_choose_named(s[..], CH_MODEL, "gpt-5.5") && c[0].model_label == "GPT-5.5" && s[0].codex[0].model == 5;
  #assert coaxial_zeron_choose_named(s[..], CH_EFFORT, "x-high") && c[0].effort_label == "X-High" && coaxial_zeron_option_selected(s[..], CH_EFFORT) == 4;
  coaxial_zeron_choose(s[..], 5, 1);
  #assert s[0].codex[0].plan && c[0].plan && !s[0].engine[0].plan;
  coaxial_zeron_choose(s[..], 5, 0);
  // a message is Codex's: Stop ends it (no server in the checks), Stopped under it
  coaxial_zeron_text(s[..], "hi");
  #assert coaxial_zeron_key(s[..], -2, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert coaxial_zeron_live(s[..]) && !coaxial_zeron_mode_open(s[..]);
  #assert coaxial_zeron_key(s[..], KEY_ESCAPE, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert !coaxial_zeron_live(s[..]) && t[0].notices[t[0].rows[1].notice].kind == N_STOPPED;
  // a signed-out chip's Log in asks the host for `codex login`
  t[0].action = A_LOGIN;
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert coaxial_zeron_take_action(s[..]) == HOST_CODEX_LOGIN;
}

#test "Cmd+N (New Chat) stops the turn and opens Zeron's empty new chat; the next message starts a new conversation" {
  s: [1] ZeronState;
  zr_test_screen(s[..]);
  out: [200000] f32;
  n := coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  c := s[0].composer[..]; t := s[0].transcript[..];
  coaxial_zeron_text(s[..], "hi");
  #assert coaxial_zeron_key(s[..], -2, 0);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert t[0].nr == 1 && c[0].docked && coaxial_zeron_live(s[..]) && !zr_empty(s[..]);
  s[0].engine[0].sid_n = 4;
  coaxial_zeron_new_chat(s[..]);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert zr_empty(s[..]) && !coaxial_zeron_live(s[..]) && t[0].nr == 0 && !t[0].working;
  #assert !c[0].docked && !c[0].compact && !c[0].running && s[0].engine[0].sid_n == 0 && coaxial_zeron_wants_text(s[..]);
  // from the demo chat too
  coaxial_zeron_demo(s[..]);
  coaxial_zeron_new_chat(s[..]);
  n = coaxial_zeron_frame(s[..], out[..], 2640, 1760, 2, 0.016);
  #assert zr_empty(s[..]) && t[0].nr == 0 && !c[0].docked;
}
