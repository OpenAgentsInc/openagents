// Conversations kept locally (docs/desktop/coax-desktop.md, "Storage"): each
// session's transcript appends to sessions/<id>.jsonl beside settings.json,
// in the shared session log format (coax/lib/agent/session/log.coax: Coder's
// JSONL, one line a part and one at each turn's end with its cost and time,
// after a header naming the session, its engine and its folder). The host
// appends what st_take gives it after every finished turn and at quit, and
// at launch hands each restored session its file (st_load), which rebuilds
// the same transcript; the next message resumes the harness's own session
// (settings.json keeps Claude Code's session id and Codex's thread).

#load "desk.coax";
#load "../../../coax/lib/agent/session/log.coax";

// The lines are the shared session log (coax/lib/agent/session/log.coax: Coder's JSONL with the keys a
// record needs to come back whole); st_load also reads the files this app wrote before that format.
st_lines :: (s: [] Session, from: int, to: int, ended: bool, out: [] u8) -> int { return sl_lines(s, from, to, ended, out); }
st_load :: (s: [] Session, text: string) { sl_load(s, text); }
ST_ENGINES :: [MODE_COUNT] string.["claude", "psionic", "lab", "codex"];

// Chat i's new lines for its file: its finished turns (at quit, force: what there is). Its length.
st_take :: (k: [] Desk, i: int, force: bool, out: [] u8) -> int {
  if i < 0 || i >= k[0].n || k[0].chats[i].store_n == 0 { return 0; }
  z := k[0].chats[i].s;
  if z[0].demo { return 0; }
  s := z[0].session[..];
  if s[0].hint || (s[0].live && !force) { return 0; }
  if k[0].chats[i].stored > s[0].n { k[0].chats[i].stored = s[0].n; }
  from := k[0].chats[i].stored;
  if from == s[0].n { return 0; }
  // a new file starts with the log's header: the session's id, its engine and its folder
  h := 0;
  if from == 0 {
    engines := ST_ENGINES; e := z[0].engine[..];
    h = sl_header(out, cast(string) k[0].chats[i].store[0..<k[0].chats[i].store_n], engines[z[0].mode], e_str(e[0].cwd[..], e[0].cwd_n), 0);
    if h == 0 { return 0; }
  }
  n := st_lines(s, from, s[0].n, !s[0].live, out[h..<out.count]);
  if n > 0 { k[0].chats[i].stored = s[0].n; }
  return ifx n > 0 then h + n else 0;
}

coaxial_desk_set_store :: (k: [] Desk, i: int, id: string) #export_c #effects(all) {
  if k.count < 1 || i < 0 || i >= k[0].n { return; }
  k[0].chats[i].store_n = e_copy(k[0].chats[i].store[..], 0, id);
}
coaxial_desk_store_id :: (k: [] Desk, i: int, out: [] u8) -> int #export_c #effects(all) {
  if k.count < 1 || i < 0 || i >= k[0].n { return 0; }
  return e_copy(out, 0, cast(string) k[0].chats[i].store[0..<k[0].chats[i].store_n]);
}
coaxial_desk_store_take :: (k: [] Desk, i: int, force: bool, out: [] u8) -> int #export_c #effects(all) { if k.count < 1 { return 0; } return st_take(k, i, force, out); }
coaxial_desk_store_load :: (k: [] Desk, i: int, text: string) #export_c #effects(all) {
  if k.count < 1 || i < 0 || i >= k[0].n { return; }
  s := k[0].chats[i].s[0].session[..];
  st_load(s, text);
  k[0].chats[i].stored = s[0].n;
}

#test "a recorded file reads back into the same transcript: messages, text, thoughts, tool calls with their output, notices, cost" {
  s: [1] Session; pool: [65536] u8; s_init(s[..], pool[..]);
  abuf: [16384] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  s_user(s[..], "Fix the \"sidebar\" width\nplease");
  s_delta(s[..], P_THINK, "Looking at desk.coax");
  s_tool_use(s[..], ar[..], "t1", "Edit", "{\"file_path\":\"/w/desk.coax\",\"old_string\":\"220\",\"new_string\":\"240\"}");
  s_tool_result(s[..], ar[..], "{\"tool_use_id\":\"t1\",\"content\":\"ok\"}");
  s_tool_use(s[..], ar[..], "t2", "Bash", "{\"command\":\"ls\\n -la\"}");
  s_tool_result(s[..], ar[..], "{\"tool_use_id\":\"t2\",\"content\":\"denied\",\"is_error\":true}");
  s_delta(s[..], P_TEXT, "Done: the sidebar is 240 px. ✓");
  s[0].cost = 0.031; s[0].turn_ms = 12500;
  s_turn_end(s[..], false, "");
  s_user(s[..], "again");
  s[0].stopping = true;
  s_turn_end(s[..], false, "");
  out: [65536] u8;
  // the first turn, then the second appended after it
  n1 := st_lines(s[..], 0, 5, true, out[..]);
  n2 := st_lines(s[..], 5, s[0].n, true, out[n1..<out.count]);
  #assert n1 > 0 && n2 > 0;
  file := cast(string) out[0..<n1 + n2];
  r: [1] Session; rpool: [65536] u8; s_init(r[..], rpool[..]);
  st_load(r[..], file);
  #assert r[0].n == s[0].n && r[0].turns == 2 && r[0].turn_ms == 12500 && r[0].cost > 0.0309 && r[0].cost < 0.0311;
  for k: 0..<s[0].n {
    a := s[0].parts[k]; b := r[0].parts[k];
    #assert a.kind == b.kind && s_text_of(s[..], k) == s_text_of(r[..], k) && a.notice == b.notice;
    #assert a.tk == b.tk && a.id == b.id && a.arg == b.arg && a.detail == b.detail && a.before == b.before && a.after == b.after;
    #assert a.input == b.input && a.output == b.output && a.failed == b.failed && a.resolved == b.resolved;
  }
  #assert s_text_of(r[..], 0) == "Fix the \"sidebar\" width\nplease" && r[0].parts[3].failed && r[0].parts[6].kind == P_NOTICE && r[0].parts[6].notice == N_STOPPED;
}

#test "a chat's file starts with the log's header, then only what is new each time; a running turn waits" {
  k: [1] Desk; a: [1] ZeronState;
  dsk_test_chat(a[..]);
  i := dsk_add(k[..], a[..], "/w/one");
  out: [8192] u8;
  s := a[0].session[..];
  pool: [1024] u8; s_init(s, pool[..]);
  s_user(s, "hello");
  #assert st_take(k[..], i, false, out[..]) == 0;          // no file named yet
  coaxial_desk_set_store(k[..], i, "20261110-1");
  #assert st_take(k[..], i, false, out[..]) == 0;          // the turn is still running
  s_delta(s, P_TEXT, "Hi.");
  s_turn_end(s, false, "");
  n := st_take(k[..], i, false, out[..]);
  first := cast(string) out[0..<n];
  #assert s_has(first, "{\"kind\":\"session\",\"schema\":\"openagents.session.v1\",\"id\":\"20261110-1\",\"engine\":\"claude\"");
  #assert s_has(first, "{\"kind\":\"user\",\"text\":\"hello\"}\n{\"kind\":\"reply\",\"text\":\"hi.\"}\n{\"kind\":\"end\",\"ending\":\"finished\"");
  both: [8192] u8; q := 0;                                 // the file, as the host appends each piece
  for c: first { both[q] = c; q += 1; }
  #assert st_take(k[..], i, true, out[..]) == 0;           // nothing new
  s_user(s, "again");
  m := st_take(k[..], i, true, out[..]);                   // at quit: what there is, without an end
  second := cast(string) out[0..<m];
  #assert m > 0 && !s_has(second, "\"kind\":\"session\"") && !s_has(second, "\"kind\":\"end\"") && s_has(second, "{\"kind\":\"user\",\"text\":\"again\"}");
  // the two pieces, as the host appends them, restore the conversation
  for c: second { both[q] = c; q += 1; }
  b: [1] ZeronState; dsk_test_chat(b[..]);
  k2: [1] Desk; j := dsk_add(k2[..], b[..], "/w/one");
  r := b[0].session[..];
  rpool: [1024] u8; s_init(r, rpool[..]);
  coaxial_desk_store_load(k2[..], j, cast(string) both[0..<q]);
  #assert r[0].n == 3 && s_text_of(r, 1) == "Hi." && r[0].turns == 2 && k2[0].chats[j].stored == 3;
}
