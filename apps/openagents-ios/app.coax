// The compiled Coax linked into the OpenAgents iOS app, one generated library
// (components/gpu-components.md; GitHub #13645): the chat page, with the atlas
// builder and its tables for the shared carrier
// (components/gallery/linux/main.c, built without the gallery's page).
// generate.sh compiles this file to Generated/gallery.c.
#run_steps 250000000;
#load "../../components/raster/host-tables.coax";
#load "chat.coax";
#load "editor.coax";
#load "../shared/app/settings/identity-sdk.coax";
#load "../../coax/native/account-view-wire.coax";
// The shared app core (apps/shared/app/README.md): state, dispatch, the effect outbox and the
// host ABI that core-host.c wraps.
#load "../shared/app/core/core.coax";
// The phone's end of pairing and of its own computer's environment runtime (dv_*): the device
// service (apps/shared/native/AppDeviceLink.swift) calls them through core-host.c with the device
// key for one call. Their secp256k1 tables are built at compile time.
#load "../shared/app/device/seal.coax";

// The installed CLI supplies this public key; use the shared canonical hex
// check before a native adapter advertises it as this computer.
#test "native host metadata uses the shared canonical public-key format" {
 #assert oa_root_host_key("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
 #assert !oa_root_host_key("") && !oa_root_host_key("abc") && !oa_root_host_key("79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798");
}
oa_root_host_key :: (key:string)->bool #export_c #effects(all) {return key.count==64 && es_hex(key);}

// Read-only desktop qualification uses the same request/view codec as the lane.
#test "native resident probe refuses mismatched hosts and non-view bytes" {
 v:[1]EaView;h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";v[0].nh=ea_copy(v[0].host[..],h);v[0].nm=ea_copy(v[0].method[..],"ListSessions");v[0].complete=true;raw:[4096]u8;n:=ea_view_write(v[..],raw[..]);
 #assert n>0 && oa_root_resident_count(h,"ListSessions",cast(string)raw[0..<n])==0;
 #assert oa_root_resident_count(h,"ReadSession",cast(string)raw[0..<n])<0 && oa_root_resident_count(h,"ListSessions","{}")<0;
 #assert oa_root_resident_count("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","ListSessions",cast(string)raw[0..<n])<0;
}
oa_root_resident_count :: (host:string,method:string,raw:string)->int #export_c #effects(all) {
 v:[1]EaView;if !oa_root_host_key(host) || !ea_view_read(raw,v[..]) || cast(string)v[0].host[0..<v[0].nh]!=host || cast(string)v[0].method[0..<v[0].nm]!=method || v[0].ne>0 {return -1;}return v[0].ns;
}


// A dispatch answered APP_GUEST with no page to take it (core-host.c oa_core_on_guest: the chat page
// routes the environment picker's reads itself): the root releases it.
oa_root_guest :: (c: [] AppCore) #export_c #effects(all) { app_guest_done(c); }

// coax drive's cases on the real app (apps/shared/app/cases/INTEGRATION.md, "In the iOS app"; debug
// builds start it on -OADrive): each operation runs through the shared driver against the chat page,
// and while the driver holds the clock a frame gets only the time it grants.
#load "../shared/app/cases/chat-page.coax";
OaDrive :: struct { r: [1] CpRun; d: [1] GdDrive; v: [CH_MAX_VERTICES * GP_VERTEX_FLOATS] f32; }
// The session opens on the page, in a window w by h device pixels at dpr. The host plays its own part
// (the keyboard), so the adapter does not.
oa_drive_open :: (x: [] OaDrive, s: [] ChatPage, w: f32, h: f32, dpr: f32) #export_c #effects(all) {
  if x.count < 1 || s.count < 1 { return; }
  cp_open(x[0].r[..], s, x[0].v[..], x[0].d[..], s[0].core, "ios-simulator", 0, false);
  cp_window(x[0].r[..], s, x[0].v[..], x[0].d[..], w, h, dpr);
}
// One operation's answer in out: its length.
oa_drive_op :: (x: [] OaDrive, s: [] ChatPage, op: string, out: [] u8) -> int #export_c #effects(all) {
  if x.count < 1 || s.count < 1 { return 0; }
  if !cp_drive(x[0].r[..], s, x[0].v[..], x[0].d[..], op) { return el_put(out, 0, "the operation did not finish"); }
  return el_put(out, 0, gd_answer(x[0].d[..]));
}
// The time the display's own frame gets: none but what the clock grants, while the driver holds it.
oa_drive_dt :: (x: [] OaDrive, host_dt: f32) -> f32 #export_c #effects(all) {
  if x.count < 1 { return host_dt; }
  return gd_frame_dt(x[0].d[..], host_dt);
}
// One frame of the C driver's `clock +MS` (phone-drive.c), drawn off screen with that time.
oa_drive_frame :: (x: [] OaDrive, s: [] ChatPage, dt: f32) #export_c #effects(all) {
  if x.count < 1 || s.count < 1 { return; }
  _ := chat_frame(s, x[0].v[..], x[0].r[0].w, x[0].r[0].h, x[0].r[0].dpr, dt);
}

// The dev menu (debug builds open it): every app component on example data (DevGallery.swift).
#load "../../components/app/gallery/gallery.coax";
