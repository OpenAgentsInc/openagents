// Synthetic public histories only; no account, relay or Git operation runs.
#test "conversation pin rename archive and restore use stable saved identity and preserve the draft" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);c[0].auth=AUTH_IN;c[0].foreground=false;
 ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");c[0].chat[0].id_n=el_copy(c[0].chat[0].id[..],"cnv_0123456789abcdef0123456789abcdef");c[0].chat[0].loaded=true;
 _:=chat_set_text(s[..],"Keep this draft");_=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"chat.options");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"thread.pin");
 #assert s[0].library[0].n==1 && s[0].library[0].rows[0].pinned && ch_draft(s[..])=="Keep this draft";
 _=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"chat.options");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"thread.rename.open");_=ch_test_frame(s[..],o[..]);
 chat_env(s[..],59,34,320,true,0,true);_=chat_frame(s[..],o[0].v[..],1206,2622,3,0);rect:[4]f32;facts:[8]f32;
 #assert chat_field_box(s[..],rect[..]) && rect[1]+rect[3]<=554;#assert chat_row(s[..],surface_find(ch_live(s[..]),"thread.done"),facts[..]) && facts[1]+facts[3]<=554;
 #assert chat_field_kind(s[..])==APP_FIELD_PLAIN && chat_set_field(s[..],"Garden plans") && chat_submit(s[..]);_=ch_test_frame(s[..],o[..]);#assert ch_conversation_title(s[..])=="Garden plans" && ch_draft(s[..])=="Keep this draft";
 #assert chat_activate(s[..],"chat.options");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"thread.archive");_=ch_test_frame(s[..],o[..]);#assert s[0].section==2 && s[0].library[0].rows[0].archived;
 #assert chat_activate(s[..],"history.filter");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"history.filter.pinned");_=ch_test_frame(s[..],o[..]);#assert s[0].library_filter==1 && ch_test_has(s[..],"library.empty");
 #assert chat_activate(s[..],"history.filter");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"history.filter.archived");_=ch_test_frame(s[..],o[..]);#assert s[0].library_filter==2 && ch_test_has(s[..],"cnv_0123456789abcdef0123456789abcdef");
 // Return to the same saved chat without dispatching a network write in this fixture.
 s[0].section=0;_=ch_test_frame(s[..],o[..]);#assert ch_test_has(s[..],"chat.restore") && !ch_test_has(s[..],VIEW_COMPOSER_ID);
 #assert ch_test_tap(s[..],"chat.restore");_=ch_test_frame(s[..],o[..]);#assert !s[0].library[0].rows[0].archived && ch_test_has(s[..],VIEW_COMPOSER_ID) && ch_draft(s[..])=="Keep this draft";
}
#test "library partition restore clears the prior account's menu and aliases" #steps 2000000000 {
 s:[1]ChatPage;o:[1]ChOut;ch_test_atlas(s[0].atlas[..]);_=ch_test_frame(s[..],o[..]);
 #assert chlib_change(s[0].library[..],"account/cnv_0123456789abcdef0123456789abcdef","Private alias",3);s[0].rename=true;s[0].thread_menu=true;
 #assert chat_library_restore(s[..],"") && s[0].library[0].n==0 && !s[0].rename && !s[0].thread_menu;
 s[0].rename=true;s[0].thread_menu=true;#assert !chat_library_restore(s[..],"broken") && s[0].library[0].n==0 && !s[0].rename && !s[0].thread_menu;
}
#test "native workspace controls preserve a chat draft and never generate a Claude prompt" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;app_init(c[..]);chat_attach(s[..],c[..],"");_=chat_set_text(s[..],"Kept draft");h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
 #assert wsc_open(s[0].sc[0].workspaces[..],h,false) && ch_draft(s[..])=="Kept draft";
 s[0].sc[0].workspaces[0].form=1;#assert wsc_edit(s[0].sc[0].workspaces[..],"workspace.branch","feature/native") && wsc_edit(s[0].sc[0].workspaces[..],"workspace.base","main");
 #assert ch_draft(s[..])=="Kept draft" && fx_held(c[0].out[..])==0;
}
#test "the drawer opens Foreman on the paired computer and Back returns to the chat with its draft" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);c[0].auth=AUTH_IN;c[0].foreground=true;ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");chat_experimental_set(s[..],true);_=chat_set_text(s[..],"Kept draft");
 _=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"nav.menu");_=ch_test_frame(s[..],o[..]);#assert ch_test_tap(s[..],"drawer.foreman");_=ch_test_frame(s[..],o[..]);
 // nothing paired: the page says so and asks no computer
 #assert s[0].sc[0].foreman[0].open && !s[0].drawer && ch_test_has(s[..],"foreman.none") && c[0].guest_due[OWN_FOREMAN]==0;
 #assert ch_test_tap(s[..],"foreman.back");_=ch_test_frame(s[..],o[..]);#assert !s[0].sc[0].foreman[0].open && ch_test_has(s[..],VIEW_COMPOSER_ID) && ch_draft(s[..])=="Kept draft";
}
#test "a computer session's sub-agent row opens its transcript, read from that computer, and Back returns to the chat" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;lane:[1]DeviceLane;app_init(c[..]);#assert app_device_attach(c[..],lane[..]);c[0].foreground=true;c[0].mono_ms=1000;c[0].wall_ms=1700000000000;
 h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";lane[0].np=1;_=ea_copy(lane[0].paired[0].host[..],h);lane[0].on=true;_=ea_copy(lane[0].host[..],h);
 e:=lane[0].e[..];e[0].active=true;e[0].ns=el_copy(e[0].session[..],"0123456789abcdef0123456789abcdef");v:=e[0].view[..];v[0].ok=true;v[0].ns=1;
 v[0].sessions[0].ni=el_copy(v[0].sessions[0].id[..],"0123456789abcdef0123456789abcdef");v[0].sessions[0].managed=true;v[0].sessions[0].busy=true;
 m:=v[0].items[0];m.ni=el_copy(m.id[..],"1:0");m.nr=el_copy(m.role[..],"tool");m.nk=el_copy(m.tool[..],"Task");m.text_at=ea_text_put(v,"Find the config");m.nt=15;m.complete=false;m.calls=2;v[0].items[0]=m;v[0].ni=1;
 ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");_=ch_test_frame(s[..],o[..]);
 #assert ch_test_tap(s[..],"dev.1-0.call.0");
 _=ch_test_frame(s[..],o[..]);
 #assert s[0].sc[0].subagent[0].open && cast(string)s[0].sc[0].subagent[0].item[0..<s[0].sc[0].subagent[0].nit]=="1:0" && cast(string)s[0].sc[0].subagent[0].title[0..<s[0].sc[0].subagent[0].nt]=="Find the config";
 #assert ch_test_has(s[..],"subagent.back") && ch_test_has(s[..],"subagent.close") && ch_test_has(s[..],"subagent.loading");
 // the page asks that computer for the agent's transcript
 at:=fx_find(c[0].out[..],s[0].sc[0].subagent[0].op);q:[1]EaRequest;#assert at>=0 && ea_read(fx_body(c[0].out[..],at),q[..]) && cast(string)q[0].method[0..<q[0].nm]=="ReadSubagent";
 #assert ch_test_tap(s[..],"subagent.back");_=ch_test_frame(s[..],o[..]);#assert !s[0].sc[0].subagent[0].open && ch_test_has(s[..],VIEW_COMPOSER_ID);
}
// Synthetic drawer rows for a paired computer's chats.
crow_t_rows :: (s:[]ChatPage,n:int) {
 h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";titles:=[3]string.["Alpha chat","Beta chat","Gamma chat"];ids:=[3]string.["alpha","beta","gamma"];
 nv:=s[0].sc[0].devices[0].nav[..];b:=nv[0].browser[..];b[0].catalog[0].n=1;_=ea_copy(b[0].catalog[0].entries[0].host[..],h);b[0].catalog[0].entries[0].nl=ea_copy(b[0].catalog[0].entries[0].label[..],"Mac");
 nv[0].groups[0].loaded=true;nv[0].groups[0].complete=true;
 for i:0..<n {r:=nv[0].rows[i];r.host=0;r.session.ni=el_copy(r.session.id[..],ids[i]);r.session.nt=el_copy(r.session.title[..],titles[i]);r.session.nc=el_copy(r.session.control[..],"x");if i==1 {r.session.nw=el_copy(r.session.workspace[..],"openagents");}nv[0].rows[i]=r;}
 nv[0].n=n;
}
crow_t_id :: (s:[]ChatPage,i:int,buf:[]u8)->string {return dh_row_id(s[0].sc[0].devices[..],i,buf);}
#test "a computer's chat in the drawer: its project under its title; a long press opens Pin, Rename and Archive for that row, and a swipe right along it pins it" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);c[0].auth=AUTH_IN;c[0].foreground=false;
 ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");_=ch_test_frame(s[..],o[..]);
 #assert chat_activate(s[..],"nav.menu");_=ch_test_frame(s[..],o[..]);crow_t_rows(s[..],3);_=ch_test_frame(s[..],o[..]);
 b0:[64]u8;b1:[64]u8;a:=crow_t_id(s[..],0,b0[..]);g:=crow_t_id(s[..],2,b1[..]);
 #assert ch_test_text(s[..],"Recents")==1 && ch_test_text(s[..],"Alpha chat")==1 && ch_test_text(s[..],"openagents")==1;i:=surface_find(ch_live(s[..]),a);#assert i>=0;r:=ch_rows(s[..]).rows[i];x:=(r.x+r.w/2)*s[0].d;y:=(r.y+r.h/2)*s[0].d;
 // held still: the row's actions open, and the release opens no chat
 _=chat_pointer(s[..],x,y,0);#assert s[0].touching;#assert s[0].pressed_n>0;#assert ch_row_target(s[..],a);#assert !s[0].scrolling && !s[0].swiped;_=ch_test_frame(s[..],o[..]);
 #assert s[0].row_menu;_=chat_pointer(s[..],x,y,2);_=ch_test_frame(s[..],o[..]);
 #assert s[0].drawer && ch_test_has(s[..],"drawer.row.menu") && ch_test_text(s[..],"Pin")==1 && ch_test_has(s[..],"drawer.row.rename");
 #assert ch_test_tap(s[..],"drawer.row.pin");_=ch_test_frame(s[..],o[..]);
 #assert !s[0].row_menu && s[0].library[0].n==1 && s[0].library[0].rows[0].pinned && ch_test_text(s[..],"Pinned")==1;
 // a swipe right along another row pins it too, and the drawer stays
 j:=surface_find(ch_live(s[..]),g);#assert j>=0;q:=ch_rows(s[..]).rows[j];qx:=(q.x+20)*s[0].d;qy:=(q.y+q.h/2)*s[0].d;
 _=chat_pointer(s[..],qx,qy,0);_=chat_pointer(s[..],qx+60*s[0].d,qy,1);_=chat_pointer(s[..],qx+60*s[0].d,qy,2);_=ch_test_frame(s[..],o[..]);
 #assert s[0].drawer && s[0].library[0].n==2;
 // held again: Archive, and the row leaves the list
 i=surface_find(ch_live(s[..]),a);r=ch_rows(s[..]).rows[i];x=(r.x+r.w/2)*s[0].d;y=(r.y+r.h/2)*s[0].d;
 _=chat_pointer(s[..],x,y,0);_=ch_test_frame(s[..],o[..]);_=ch_test_frame(s[..],o[..]);_=chat_pointer(s[..],x,y,2);_=ch_test_frame(s[..],o[..]);
 #assert ch_test_text(s[..],"Unpin")==1 && ch_test_tap(s[..],"drawer.row.archive");_=ch_test_frame(s[..],o[..]);
 #assert surface_find(ch_live(s[..]),a)<0 && surface_find(ch_live(s[..]),g)>=0;
}
