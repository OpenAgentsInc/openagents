  #assert bare < painted && ch_test_has(s[..], "nav.menu");
  m: [6] f32; #assert chat_menu(s[..], m[..]) && m[2] > 30 && m[3] == 0 && m[4] == 0;
  #assert ch_test_tap(s[..], "nav.menu") && s[0].drawer; _ := ch_test_frame(s[..], o[..]); _ := ch_test_frame(s[..], o[..]);
  #assert chat_menu(s[..], m[..]) && m[3] > 100 && m[4] == 1;
  #assert surface_find(ch_live(s[..]),"nav.menu")>=0 && chat_activate(s[..],"nav.menu") && !s[0].drawer;
  _:=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"nav.menu");_:=ch_test_frame(s[..],o[..]);
  #assert chat_activate(s[..], "drawer.scrim") && !s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  chat_experimental_set(s[..], true); core[0].auth = AUTH_IN; chat_step(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert chat_activate(s[..], "composer.environment") && chat_sheet(s[..]) == ES_SHEET_ENV;
  before := ch_test_text(s[..], "Where it runs"); _ := ch_test_frame(s[..], o[..]);
  #assert before == 0 && ch_test_text(s[..], "Where it runs") == 0 && ch_test_has(s[..], "env.default") && chat_refused(s[..]) == 0;
  box: [4] f32; #assert chat_find(s[..], "composer.environment", box[..]) && box[2] > 40;
  t := [1] ElTable.[ch_rows(s[..])]; i := elt_find(t[..], "env.default");
  v: [64] u8; #assert i >= 0 && (t[0].rows[i].state & EL_S_CHECKED) != 0 && chat_row_value(s[..], i, v[..]) > 0;
  #assert chat_activate(s[..], "env.default") && chat_sheet(s[..]) == ES_SHEET_NONE;
}

// Abort a staged composed surface when physical resources cannot be reserved.
chat_render_commit :: (s:[]ChatPage,accepted:bool) #export_c #effects(all) {
 if s.count<1 {return;}
 if !s[0].render_staged {if accepted {s[0].shown_renderer=s[0].frame_renderer;}return;}
 if accepted {for i:0..<2 {s[0].surface[i].front=s[0].candidate_front[i];s[0].surface[i].generation=s[0].candidate_generation[i];}s[0].shown_renderer=s[0].candidate_renderer;}
 else {if s[0].renderer==s[0].candidate_renderer {s[0].renderer=s[0].shown_renderer;}s[0].renderer_error=true;s[0].again=true;s[0].refused+=1;}
 s[0].render_staged=false;s[0].stamp=ch_stamp(s)+ch_layer(s);
}
