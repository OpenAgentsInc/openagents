// The OpenAgents iOS chat page (components/gpu-components.md; GitHub #13645):
// the whole screen, compiled Coax drawn by the shared GPU kit in one Metal
// view: the shared chat page (apps/shared/app/view/page.coax, the transcript
// over the composer), the navigation button at the top left that opens the
// drawer, and the login page. Nothing here runs in JavaScript
// and nothing is a platform control except the platform editor over the field
// that holds the keyboard, and, on the phone, the menu button and the chips' picker (chat_native:
// legacy hosts may project them as system controls; the current iOS host uses GPU rows).
//
// The drawer slides in from the left over a scrim; a press on the scrim or a
// swipe to the left closes it, a swipe right from the left edge opens it. It
// matches Coder Desktop's sidebar (apps/openagents-desktop/page/layout/sidebar.coax):
// New chat, Search, Pinned and Recents, and the "Local" row with its gear (Settings)
// at the foot. Experimental features (Settings, off unless turned on, as on the
// desktop) add log in, the account, Projects, Foreman and the Nostr keys; off, the
// phone needs no account: it works with the computers it is paired with.
// Log in is a full page over the chat, not a card over it: the login flow's
// form (apps/shared/app/login/, lf_card) under a Back button where the menu
// button was. Only Default (where we choose) needs an account, so a Send on
// Default while logged out opens the same page. Back, a swipe right from the
// left edge, or Cancel close it. The flow works through the shared app core
// the host attaches (chat_attach). The chat page reads
// the same core; its presses go to the core as actions (view_press,
// view_dispatch), and the composer's text is the core's draft.
//
// The keyboard rule is the kit's (kit/frame.coax): the page keeps
// uiframe_focus as its focused id, a press on a field gives it the keyboard
// and any other press takes it away. The host shows the platform editor over
// the focused field (chat_focus) and hides the keyboard when there is none.
//   coax/bin/coax test apps/openagents-ios/chat.coax

#load "../shared/app/view/page.coax";
#load "../../components/app/nav.coax";
#load "../../components/app/sidebar.coax";
#load "../../components/app/settings.coax";   // the sidebar foot's account row (set_account_row), as on the desktop
#load "../../components/skin/noir-phone.coax";   // the conversation skin on Coder Noir's colours
#load "../shared/app/login/card.coax";
#load "../shared/app/login/bridge.coax";
#load "../shared/app/environment/bridge.coax";
#load "../shared/app/environment/view.coax";
#load "../../coax/lib/agent/chat-library-sync.coax";
#load "../../coax/lib/agent/chat-library.coax";
#load "../shared/app/view/screens.coax";   // Settings, Usage, Foreman, Workspace, Projects and the drawer's lists
#load "../shared/app/fields.coax";
#load "../../components/app/identity.coax";
#load "../../components/core/edit.coax";
#load "../../components/skin/arcade.coax";
#load "../../components/backend/gpu.coax";
#load "../../components/app/renderer.coax";
#load "../../coax/native/gpu-composition.coax";

CH_MAX_VERTICES :: 160000;
// The cover's declared capacity, a generation: primitives, runs of text, selectable lines, hits,
// pooled bytes and semantic rows. Then keyed ids.
CH_UNDER :: 512; CH_OVER :: 2048; CH_LINES :: 256; CH_HITS :: 32; CH_POOL :: 8192; CH_ROWS :: 48; CH_KEYED :: 32;
// The page's: the whole transcript in view, with its overscan.
CH_P_UNDER :: 2048; CH_P_OVER :: 8192; CH_P_LINES :: 4096; CH_P_HITS :: 256; CH_P_POOL :: 262144; CH_P_ROWS :: 512; CH_P_KEYED :: 256;
CH_MOVE :: 8.0;     // layout units a touch travels before it scrolls instead of pressing
CH_ACT_NONE :: 0; CH_ACT_FOCUS :: 1;
// The page's own actions start at 100: the login card's rows carry the flow's LF_ACT_ values (1 to 7).
CH_HIT_TEXT :: 101; CH_HIT_SEND :: 102; CH_HIT_MENU :: 103; CH_HIT_SCRIM :: 104; CH_HIT_LOGIN :: 105; CH_HIT_LOGOUT :: 106; CH_HIT_NEW :: 107; CH_HIT_ENV :: 109; CH_HIT_REPO :: 110; CH_HIT_BACK :: 111; CH_HIT_FOREMAN :: 412; CH_HIT_FOREMAN_BACK :: 413; CH_HIT_SUBAGENT_BACK :: 414; CH_HIT_EXPERIMENTAL :: 415;
CH_ZOOM_MAX :: 2.5;  // the largest text size the page draws, against the default (the host's Dynamic Type)
CH_SWIPE :: 30.0;   // layout units a swipe travels to close or open the drawer
CH_EDGE :: 18.0;    // the left edge a swipe that opens the drawer starts in

ChGeneration :: struct { under: [CH_UNDER] Prim; over: [CH_OVER] Prim; lines: [CH_LINES] SheetLine; hits: [CH_HITS] SheetHit; pool: [CH_POOL] u8; rows: [CH_ROWS] El; }
ChPageGeneration :: struct { under: [CH_P_UNDER] Prim; over: [CH_P_OVER] Prim; lines: [CH_P_LINES] SheetLine; hits: [CH_P_HITS] SheetHit; pool: [CH_P_POOL] u8; rows: [CH_P_ROWS] El; }
ChatPage :: struct {
  ready: bool; time: f32; d: f32;
  renderer:bool;renderer_tapped:bool;frame_renderer:bool;shown_renderer:bool;renderer_error:bool;reduced_transparency:bool; render_plan:[1]UcPlan;render_list:[CH_P_UNDER+CH_P_OVER+1]Prim;
  staged_front:[2]int;staged_generation:[2]int;candidate_front:[2]int;candidate_generation:[2]int;candidate_renderer:bool;render_staged:bool;
  atlas: [1] Atlas;
  // two layers, each a surface with its keyed store: 0 the page, 1 what covers it (the login card,
  // the drawer). A layer paints all of its sheet over the one below, so the page's words never
  // show through the card or the drawer.
  page: [2] ChPageGeneration; gen: [2] ChGeneration; surface: [2] UiSurface;
  page_keys: [CH_P_KEYED] Keyed; keys: [CH_KEYED] Keyed; keyed: [2] KeyedStore;
  // the chat page's own state (about 2 MiB; the host allocates the page on the heap)
  view: [1] ChatView; again: bool;
  // a touch on the page that travelled scrolls the transcript
  down_y: f32; last_y: f32; scrolling: bool;
  // the window's facts, in points; the platform editor
  safe_top: f32; safe_bottom: f32; keyboard: f32; focused: bool; editor_h: f32; reduced: bool;
  px: f32; py: f32; touching: bool; pressed: [EL_ID] u8; pressed_n: int;
  down_x: f32; swiped: bool;
  // the field that holds the keyboard (the kit's focus rule), "" for none
  focus: [EL_ID] u8; focus_n: int;
  // the drawer: whether it is open, and how far it is out
  drawer: bool; share: f32;
  thread_menu:bool;thread_details:bool;
  library:[1]ChatLibrary;library_sync:[1]ClSync;library_filter:int;rename:bool;workspace:bool;rename_text:[CHLIB_TITLE]u8;rename_n:int;target:[CHLIB_KEY]u8;target_n:int;library_note:bool;filter_menu:bool;
  menu_content:f32;menu_viewport:f32;
  search:[128]u8;search_n:int;
  initials: [4] u8; initials_n: int;
  // the environment and repository chips over the composer, and their picker (apps/shared/app/environment/)
  env: [1] EnvSelect; eb: [1] EsBridge; picker: EsPickerSize;
  // the shared app core the host attaches, and the login flow over it
  core: [] AppCore; lb: [1] LoginBridge; lf: [1] LoginFlow;
  sc:[1]AppScreens;   // the pages beside the chat (apps/shared/app/view/screens.coax)
  history_content:f32;history_viewport:f32;
  section:int;section_content:f32;section_viewport:f32;
  native_scroll:bool; settings_content:f32; settings_viewport:f32; login_content:f32; login_viewport:f32; reveal_focus:bool;
  action: int;
  box: ComposerBox; stamp: int; moving: bool; refused: int;
  // the host draws the menu button and the chips' picker as system controls (chat_native): the
  // page keeps their rows and hits for VoiceOver and the driver, and paints neither
  native: bool; page_w: f32; menu_x: f32; menu_y: f32; menu_side: f32;
  // the text size the person chose (Dynamic Type), against the default: 1 to CH_ZOOM_MAX. The
  // whole page draws larger, as Display Zoom does, so every component scales with its text.
  zoom: f32;
  // Experimental features (Settings; the host keeps it as experimentalFeatures): log in, the
  // account, Projects, Foreman and the Nostr keys. Off, the phone is local only (no Default).
  experimental: bool;
}

ch_init :: (s: [] ChatPage) {
  s[0].ready = true;
  p := s[0].page[..]; g := s[0].gen[..];
  s[0].surface[0] = surface_over(
    Sheet.{under = p[0].under[..], over = p[0].over[..], lines = p[0].lines[..], hits = p[0].hits[..], pool = p[0].pool[..]}, p[0].rows[..],
    Sheet.{under = p[1].under[..], over = p[1].over[..], lines = p[1].lines[..], hits = p[1].hits[..], pool = p[1].pool[..]}, p[1].rows[..]);
  s[0].surface[1] = surface_over(
    Sheet.{under = g[0].under[..], over = g[0].over[..], lines = g[0].lines[..], hits = g[0].hits[..], pool = g[0].pool[..]}, g[0].rows[..],
    Sheet.{under = g[1].under[..], over = g[1].over[..], lines = g[1].lines[..], hits = g[1].hits[..], pool = g[1].pool[..]}, g[1].rows[..]);
  s[0].keyed[0] = KeyedStore.{rows = s[0].page_keys[..]};
  s[0].keyed[1] = KeyedStore.{rows = s[0].keys[..]};
  lf_begin(s[0].lf[..]);
  s[0].env[0] = es_new();
}
// Points a layout unit takes: the phone's scale, times the text size.
ch_u :: (s: [] ChatPage) -> f32 { return ARCADE_PHONE_SCALE * (ifx s[0].zoom > 1 then s[0].zoom else 1.0f32); }
ch_focus :: (s: [] ChatPage) -> string { return cast(string) s[0].focus[0..<s[0].focus_n]; }
chat_ui_scale :: (s:[]ChatPage)->f32 #export_c #effects(all) {return ifx s.count>0 then ch_u(s) else ARCADE_PHONE_SCALE;}
ch_reveal :: (s:[]ChatPage,f:[]UiFrame,key:int,top:f32,bottom:f32,content:f32,offset:f32) {
 next:=scroll_clamp(offset,content,bottom-top);i:=elt_find(f[0].rows,ch_focus(s));
 if i>=0 && s[0].reveal_focus {r:=f[0].rows[0].rows[i];next=scroll_reveal(next,content,bottom-top,r.y+offset-top,r.y+r.h+offset-top);}
 if next!=offset {keyed_scroll_set(f[0].keyed,key,next);s[0].again=true;}
}
ch_login_field :: (id: string) -> int { return ifx id == "login.email" then LF_FIELD_EMAIL else ifx id == "login.code" then LF_FIELD_CODE else LF_FIELD_NONE; }
// The flow over the core, after anything that may have moved either.
// The flow and the chips' choice over the core, after anything that may have moved either (never inside a dispatch).
ch_step :: (s: [] ChatPage) {
  if s[0].core.count < 1 { return; }
  s[0].core[0].local_only = !s[0].experimental; s[0].env[0].local = !s[0].experimental;
  lfc_step(s[0].lb[..], s[0].lf[..], s[0].core);
  es_bridge_sync(s[0].core, s[0].eb[..], s[0].env[..]);
  query:=ifx s[0].section==2 && !s[0].drawer && s[0].library_filter==0 then cast(string)s[0].search[0..<s[0].search_n] else "";
  app_screens_sync(s[0].sc[..],s[0].core,AppScreensShown.{covered=s[0].drawer || s[0].lf[0].open,lists=s[0].drawer || s[0].section==2,projects=s[0].section==1,query=query},s[0].library[..]);
}
// One scroll window for computer groups and account chats; each title is one
// line. Stable IDs follow the full host/session, not the host's current index.
ch_library_row_id :: (r:[]ClEntry,out:[]u8)->string {key:=cast(string)r[0].key[0..<r[0].nk];if key.count==44 {n:=el_copy(out,cast(string)r[0].key[8..<44]);return cast(string)out[0..<n];}return nav_session_id(cast(string)r[0].key[7..<71],cast(string)r[0].key[72..<r[0].nk],out);}
ch_open_library :: (s:[]ChatPage,key:string)->bool {
 c:=s[0].core;if c.count<1 || !chlib_key(key) || app_navigation_blocked(c) {return false;}code:=ACT_OPEN;text:=cast(string)key[8..<44];buf:[193]u8;
 if key[0..<7]=="device/" {code=ACT_DEVICE_REJOIN;_=el_copy(buf[..],cast(string)key[7..<71]);buf[64]='\t';for ch,i:key[72..<key.count] {buf[65+i]=ch;}text=cast(string)buf[0..<key.count-7];}
 else {if app_dispatch(c,AppEvent.{kind=EV_ACTION,code=ACT_ENVIRONMENT,more="Default",mono_ms=c[0].mono_ms,wall_ms=c[0].wall_ms})!=APP_OK {return false;}}
 if app_dispatch(c,AppEvent.{kind=EV_ACTION,code=code,text=text,mono_ms=c[0].mono_ms,wall_ms=c[0].wall_ms})!=APP_OK {return false;}ch_main(s);s[0].section=0;s[0].drawer=false;ch_set_focus(s,"");ch_step(s);return true;
}
ch_history :: (s:[]ChatPage,f:[]UiFrame,x:f32,y:f32,w:f32,bottom:f32) {
 rows:[640]AppSideRow;ids:[640][64]u8;count:=0;h:=s[0].sc[0].devices[..];n:=h[0].nav[..];b:=n[0].browser[..];c:=s[0].core;
 query:=ifx s[0].section==2 && !s[0].drawer then cast(string)s[0].search[0..<s[0].search_n] else "";
 filter:=ifx s[0].section==2 && !s[0].drawer then s[0].library_filter else 0;
 if filter>0 {for i:0..<s[0].library[0].n {r:=s[0].library[0].rows[i];if (filter==1 && (!r.pinned || r.archived)) || (filter==2 && !r.archived) {continue;}
   title:=ifx r.nt>0 then cast(string)s[0].library[0].rows[i].title[0..<r.nt] else "Saved chat";if !text_contains_ascii(title,query) {continue;}rid:=ch_library_row_id(s[0].library[0].rows[i..<i+1],ids[count][..]);rows[count]=AppSideRow.{id=rid,title=title,action=466};count+=1;
  }if count==0 {rows[count]=AppSideRow.{id="library.empty",title="No chats",state=EL_S_DISABLED};count+=1;}
 }else {
 // Pinned, then Recents, as on the desktop: every paired computer's chats together, each row naming
 // its computer when there is more than one (never a section per computer)
 multi:=b[0].catalog[0].n>1;
 for pass:0..<2 {
  head_at:=count;rows[count]=AppSideRow.{id=ifx pass==0 then "history.pinned" else "history.recents",title=ifx pass==0 then "Pinned" else "Recents",heading=true,action=0};count+=1;shown:=0;
  for host:0..<b[0].catalog[0].n {entry:=b[0].catalog[0].entries[host];
   for i:0..<n[0].n {r:=n[0].rows[i];if r.host!=host || count>=rows.count-4 {continue;}sid:=cast(string)n[0].rows[i].session.id[0..<r.session.ni];
    keybuf:[CHLIB_KEY]u8;target_key:=chlib_device_key(cast(string)entry.host[..],sid,keybuf[..]);flags:=chlib_flags(s[0].library[..],target_key);
    if (flags&2)!=0 || (ifx (flags&1)!=0 then 0 else 1)!=pass {continue;}
    title:=chlib_label(s[0].library[..],target_key,cast(string)n[0].rows[i].session.title[0..<r.session.nt]);if !text_contains_ascii(title,query) {continue;}
    shown_title:=ifx title.count>0 then title else "New chat";
    if multi {tb:[CHLIB_TITLE+96]u8;tn:=el_put(tb[..],0,shown_title);tn=el_put(tb[..],tn," · ");tn=el_put(tb[..],tn,cast(string)b[0].catalog[0].entries[host].label[0..<entry.nl]);shown_title=sheet_pool(f[0].sheet,cast(string)tb[0..<tn]);}
    key:=dh_row_id(h,i,ids[count][..]);rows[count]=AppSideRow.{id=key,title=shown_title,state=(ifx app_device_on(c) && app_environment(c)==cast(string)entry.host[..] && cast(string)app_device_env(c)[0].session[0..<app_device_env(c)[0].ns]==sid then EL_S_CURRENT else 0) | (ifx r.session.busy then EL_S_BUSY else 0),action=343};count+=1;shown+=1;
   }
  }
  if shown==0 && pass==0 {count=head_at;}
  if shown==0 && pass==1 {
   failed:=false;loaded:=b[0].catalog[0].n>0;complete:=true;
   for host:0..<b[0].catalog[0].n {g:=n[0].groups[host];if g.failed {failed=true;}if !g.loaded {loaded=false;}if !g.complete {complete=false;}}
   rows[count]=AppSideRow.{id="history.recents.empty",title=ifx b[0].catalog[0].n==0 then "No chats yet" else ifx failed && !loaded then "Unavailable" else ifx h[0].nq>0 && !complete then "Searching…" else ifx h[0].nq>0 then "No matches" else ifx loaded then "No chats yet" else "Loading…",state=EL_S_DISABLED,action=0};count+=1;
  }
 }
 // a computer with older chats: its More row, under Recents
 for host:0..<b[0].catalog[0].n {entry:=b[0].catalog[0].entries[host];
  if h[0].nq==0 && n[0].groups[host].nc>0 {key:=nav_session_id(cast(string)entry.host[..],"more",ids[count][..]);ids[count][4]='m';ids[count][5]='o';ids[count][6]='r';ids[count][7]='e';
   more:="More";if multi {tb:[96]u8;tn:=el_put(tb[..],0,"More from ");tn=el_put(tb[..],tn,cast(string)b[0].catalog[0].entries[host].label[0..<entry.nl]);more=sheet_pool(f[0].sheet,cast(string)tb[0..<tn]);}
   rows[count]=AppSideRow.{id=key,title=more,state=ifx h[0].op>0 then EL_S_DISABLED else 0,action=344};count+=1;}
 }
 hf:=s[0].sc[0].history[..];hi:=ifx hf[0].nq>0 then hf[0].found[..] else hf[0].page[..];
 if lf_logged_in(s[0].lf[..]) && s[0].experimental {
  rows[count]=AppSideRow.{id="history.title",title="Account chats",heading=true,action=0};count+=1;
  if hf[0].nq==0 && hf[0].cursor_n>0 {rows[count]=AppSideRow.{id="history.first",title="Latest chats",state=ifx hf[0].op>0 then EL_S_DISABLED else 0,action=342};count+=1;}
  for pass:0..<2 {for i:0..<hi[0].n {keybuf:[CHLIB_KEY]u8;target_key:=chlib_account_key(cast(string)hi[0].items[i].id[..],keybuf[..]);flags:=chlib_flags(s[0].library[..],target_key);if (flags&2)!=0 || (ifx (flags&1)!=0 then 0 else 1)!=pass {continue;}title:=chlib_label(s[0].library[..],target_key,cast(string)hi[0].items[i].title[0..<hi[0].items[i].title_n]);if !text_contains_ascii(title,query) {continue;}rows[count]=AppSideRow.{id=cast(string)hi[0].items[i].id[..],title=ifx title.count>0 then title else "New chat",state=ifx !app_device_on(c) && cast(string)hi[0].items[i].id[..]==app_conversation(c) then EL_S_CURRENT else 0,action=340};count+=1;}}
  if hi[0].next_n>0 || hf[0].nq>0 && !hf[0].scan && !hf[0].scan_done && !hf[0].scan_limit && !hf[0].note {rows[count]=AppSideRow.{id="history.more",title="More",state=ifx hf[0].op>0 then EL_S_DISABLED else 0,action=341};count+=1;}
  if hi[0].n==0 {rows[count]=AppSideRow.{id="history.empty",title=ifx hf[0].note then "Search unavailable" else ifx hf[0].nq>0 && !hf[0].scan_done then "Searching…" else ifx hf[0].nq>0 then "No matches" else ifx !hf[0].loaded then "Loading…" else "No chats yet",state=EL_S_DISABLED,action=0};count+=1;}
 }
 }
 if query.count>0 && filter==0 {account_scanning:=s[0].sc[0].history[0].nq>0 && s[0].sc[0].history[0].scan;device_scanning:=h[0].op>0 || h[0].nav[0].next<b[0].catalog[0].n;
  if account_scanning || device_scanning || h[0].scan_limit || s[0].sc[0].history[0].scan_limit {rows[count]=AppSideRow.{id="history.scan",title=ifx h[0].scan_limit || s[0].sc[0].history[0].scan_limit then "Search limit reached — refine search" else "Searching titles…",state=EL_S_DISABLED};count+=1;}
 }
 s[0].history_viewport=ifx bottom>y then bottom-y else 0.0f32;s[0].history_content=app_side_content(f,rows[0..<count]);
 key:=uiframe_key(f,"history.viewport");offset:=scroll_clamp(keyed_scroll(f[0].keyed,key),s[0].history_content,s[0].history_viewport);keyed_scroll_set(f[0].keyed,key,offset);
 _:=app_side_window(f,x,y,w,s[0].history_viewport,rows[0..<count],offset,0,0);
}
// The picker is open.
ch_picking :: (s: [] ChatPage) -> bool { return s[0].env[0].sheet != ES_SHEET_NONE; }
ch_now :: (s: [] ChatPage) -> int { return ifx s[0].core.count > 0 then s[0].core[0].mono_ms else 0; }
// The page's focus moved: the flow's field follows it.
ch_set_focus :: (s: [] ChatPage, id: string) {
  if id!=ch_focus(s) {s[0].reveal_focus=true;}
  s[0].focus_n = el_copy(s[0].focus[..], id);
  l := s[0].lf[..]; want := ch_login_field(id);
  if want == LF_FIELD_NONE { lf_blur(l); }
  else if l[0].focus != want { _ := lf_press(l, ifx want == LF_FIELD_EMAIL then LF_ACT_EMAIL else LF_ACT_CODE); }
}
// Before a frame: the card's own focus moves (to the code field after a code is sent) feed the input.
ch_take_flow_focus :: (s: [] ChatPage) {
  l := s[0].lf[..]; mine := ch_login_field(ch_focus(s));
  if !l[0].open { if mine != LF_FIELD_NONE { s[0].focus_n = 0; } return; }
  flow := lf_focus_id(l);
  if (flow.count > 0 || mine != LF_FIELD_NONE) && flow!=ch_focus(s) {ch_set_focus(s,flow);}
}
ch_out :: (out: [] u8, text: string) -> int {
  n := 0;
  for c: text { if n >= out.count { break; } out[n] = c; n += 1; }
  return n;
}
// The composer's text: the core's draft of the current conversation.
ch_draft :: (s: [] ChatPage) -> string { return ifx s[0].core.count > 0 then view_draft_of(s[0].core) else ""; }
// An action for the core, with the core's own clock facts, then the flow follows it.
ch_dispatch :: (s: [] ChatPage, what: int, text: string) -> bool {
  c := s[0].core; if c.count < 1 { return false; }
  _ := view_dispatch(c, what, text, c[0].mono_ms, c[0].wall_ms); ch_step(s);
  return true;
}
// The layer that takes presses and is read out: the cover while the drawer or the card shows, else the page.
ch_layer :: (s: [] ChatPage) -> int { return ifx s[0].share > 0 || s[0].drawer || s[0].thread_menu || s[0].thread_details || s[0].filter_menu || s[0].lf[0].open || ch_picking(s) then 1 else 0; }

// Prefer the catalog's real title; a newly started conversation uses its
// first user message until the next automatic catalog read supplies it.
ch_workspace_ready :: (s:[]ChatPage)->bool {if s[0].core.count<1 || !app_device_on(s[0].core) || ch_draft(s).count>0 {return false;}return !view_facts(s[0].core).readonly && !app_navigation_blocked(s[0].core);}
ch_library_key :: (s:[]ChatPage,out:[]u8)->string {c:=s[0].core;if c.count<1 {return "";}if app_device_on(c) {e:=app_device_env(c);return chlib_device_key(app_environment(c),cast(string)e[0].session[0..<e[0].ns],out);}return chlib_account_key(app_conversation(c),out);}
ch_press_action_rename :: (s:[]ChatPage)->bool {key:=cast(string)s[0].target[0..<s[0].target_n];if !chlib_change(s[0].library[..],key,cast(string)s[0].rename_text[0..<s[0].rename_n],chlib_flags(s[0].library[..],key)) {s[0].library_note=true;return false;}s[0].rename=false;s[0].thread_menu=false;ch_set_focus(s,"");return true;}
ch_library_show :: (s:[]ChatPage,key:string,pass:int)->bool {flags:=chlib_flags(s[0].library[..],key);if s[0].library_filter==2 {return (flags&2)!=0 && pass==0;}if (flags&2)!=0 {return false;}if s[0].library_filter==1 {return (flags&1)!=0 && pass==0;}return (ifx (flags&1)!=0 then 0 else 1)==pass;}
ch_conversation_title :: (s:[]ChatPage)->string {
 c:=s[0].core;if c.count<1 {return "";}
 keybuf:[CHLIB_KEY]u8;key:=ch_library_key(s,keybuf[..]);alias:=chlib_label(s[0].library[..],key,"");if alias.count>0 {return alias;}
 if app_device_on(c) {e:=app_device_env(c);sid:=cast(string)e[0].session[0..<e[0].ns];h:=s[0].sc[0].devices[0].nav[..];
  for i:0..<h[0].n {r:=h[0].rows[i];if cast(string)h[0].browser[0].catalog[0].entries[r.host].host[..]==app_environment(c) && cast(string)r.session.id[0..<r.session.ni]==sid && r.session.nt>0 {return cast(string)h[0].rows[i].session.title[0..<r.session.nt];}}
  current:=eu_current(e);if current>=0 && e[0].view[0].sessions[current].nt>0 {return cast(string)e[0].view[0].sessions[current].title[0..<e[0].view[0].sessions[current].nt];}
 }else {h:=s[0].sc[0].history[0].page[..];for i:0..<h[0].n {r:=h[0].items[i];if cast(string)r.id[..]==app_conversation(c) && r.title_n>0 {return cast(string)h[0].items[i].title[0..<r.title_n];}}}
 v:=s[0].view[..];for i:0..<v[0].model[0].n {r:=v[0].model[0].rows[i];if (r.kind==VK_MESSAGE || r.kind==VK_DEVICE_MESSAGE || r.kind==VK_SENT || r.kind==VK_DEVICE_SENT) && !r.assistant {return view_row_text(v,view_chat_of(c),r);}}
 return ifx app_conversation(c).count>0 || app_device_on(c) then "New chat" else "";
}
ch_sf :: (s: [] ChatPage, layer: int) -> [] UiSurface { return s[0].surface[layer..<layer + 1]; }
ch_live :: (s: [] ChatPage) -> [] UiSurface { return ch_sf(s, ch_layer(s)); }
ch_rows :: (s: [] ChatPage) -> ElTable { return surface_rows(ch_live(s)); }

ch_layout :: (s: [] ChatPage, f: [] UiFrame, w: f32, h: f32) {
  k := f[0].skin; a := k.app;
  u := ch_u(s);
  top := s[0].safe_top / u;
  // the composer docks over the keyboard (or the safe area); the transcript starts under the navigation button
  under := ifx s[0].keyboard > s[0].safe_bottom then s[0].keyboard else s[0].safe_bottom;
  bottom := h - under / u - 6 / u;
  nav_y := top;   // the bar's buttons stand at the top of the safe area, as a navigation bar's do
  s[0].again=false;
  if s[0].sc[0].workspaces[0].open {
    s[0].menu_side=0;nav:=k.app.icon_button;
    _=app_icon_button(f,"workspace.back",16/u,nav_y,ICON_BACK,"Back",APP_BUTTON_QUIET,0,WSC_ACTION);
    tw:=measure_width(f[0].m,k.title.face,"Workspace");_=app_text(f,"workspace.title.heading",(w-tw)/2,nav_y+(nav-k.title.line)/2,tw,APP_TEXT_TITLE,"Workspace");
    area_top:=nav_y+nav+k.app.gap;key:=uiframe_key(f,"section.viewport");offset:=keyed_scroll(f[0].keyed,key);s[0].section_viewport=bottom-area_top;
    uiframe_clip(f,0,area_top,w,bottom);s[0].section_content=wsc_view(s[0].sc[0].workspaces[..],f,16/u,area_top-offset,w-32/u,area_top,bottom,ch_focus(s));
    ch_reveal(s,f,key,area_top,bottom,s[0].section_content,offset);uiframe_unclip(f);return;
  }
  if s[0].sc[0].subagent[0].open {
    s[0].menu_side=0;nav:=k.app.icon_button;
    _:=app_icon_button(f,"subagent.back",16/u,nav_y,ICON_BACK,"Back to chat",APP_BUTTON_QUIET,0,CH_HIT_SUBAGENT_BACK);
    _=sav_head(s[0].sc[0].subagent[..],f,16/u+nav+k.app.gap,nav_y,nav,CH_HIT_SUBAGENT_BACK);
    area_top:=nav_y+nav+k.app.gap;key:=uiframe_key(f,"section.viewport");offset:=keyed_scroll(f[0].keyed,key);s[0].section_viewport=bottom-area_top;
    uiframe_clip(f,0,area_top,w,bottom);s[0].section_content=sav_view(s[0].sc[0].subagent[..],f,16/u,area_top-offset,w-32/u);
    ch_reveal(s,f,key,area_top,bottom,s[0].section_content,offset);uiframe_unclip(f);return;
  }
  if s[0].sc[0].foreman[0].open && s[0].experimental {
    s[0].menu_side=0;nav:=k.app.icon_button;
    _:=app_icon_button(f,"foreman.back",16/u,nav_y,ICON_BACK,"Back to chat",APP_BUTTON_QUIET,0,CH_HIT_FOREMAN_BACK);
    tw:=measure_width(f[0].m,k.title.face,"Foreman");_=app_text(f,"foreman.title",(w-tw)/2,nav_y+(nav-k.title.line)/2,tw,APP_TEXT_TITLE,"Foreman");
    area_top:=nav_y+nav+k.app.gap;key:=uiframe_key(f,"section.viewport");offset:=keyed_scroll(f[0].keyed,key);s[0].section_viewport=bottom-area_top;
    uiframe_clip(f,0,area_top,w,bottom);s[0].section_content=fmv_view(s[0].sc[0].foreman[..],f,16/u,area_top-offset,w-32/u);
    ch_reveal(s,f,key,area_top,bottom,s[0].section_content,offset);uiframe_unclip(f);return;
  }
  if s[0].sc[0].usage[0].open {
    s[0].menu_side=0;nav:=k.app.icon_button;
    _:=app_icon_button(f,"usage.back",16/u,nav_y,ICON_BACK,ifx s[0].sc[0].identity[0].open then "Back to Settings" else "Back to chat",APP_BUTTON_QUIET,0,US_ACTION);
    tw:=measure_width(f[0].m,k.title.face,"Usage");_=app_text(f,"usage.title",(w-tw)/2,nav_y+(nav-k.title.line)/2,tw,APP_TEXT_TITLE,"Usage");
    area_top:=nav_y+nav+k.app.gap;key:=uiframe_key(f,"section.viewport");offset:=keyed_scroll(f[0].keyed,key);s[0].section_viewport=bottom-area_top;
    uiframe_clip(f,0,area_top,w,bottom);s[0].section_content=us_view(s[0].sc[0].usage[..],f,16/u,area_top-offset,w-32/u,area_top,bottom,ch_focus(s));
    ch_reveal(s,f,key,area_top,bottom,s[0].section_content,offset);uiframe_unclip(f);return;
  }
  if s[0].sc[0].identity[0].open {
    s[0].menu_side=0;
    key:=uiframe_key(f,"settings.viewport");offset:=keyed_scroll(f[0].keyed,key);
    s[0].settings_viewport=bottom-nav_y;
    uiframe_clip(f,0,nav_y,w,bottom);
    // the Nostr keys need the account: an experimental feature, as log in is
    if s[0].experimental && s[0].core.count>0 && s[0].core[0].auth==AUTH_IN {
      v:=s[0].sc[0].identity[..];
      s[0].settings_content=app_identity(f,16/u,nav_y-offset,w-32/u,AppIdentity.{pubkey=iks_pubkey(v),managed=v[0].source==2,busy=v[0].op!=0,confirm=ifx v[0].confirm>0 then v[0].confirm+300 else 0,secret_ready=v[0].secret_ready,backup=v[0].backup,unknown=v[0].unknown,note=iks_words(v)},
        AppIdentityActions.{back=IKS_BACK,back_icon=ICON_BACK,copy=IKS_COPY,backup=302,rotate=303,restore=304,confirm=IKS_CONFIRM,cancel=IKS_CANCEL,secret=IKS_SECRET,retry=305,discard=306});
    } else {
      _:=app_icon_button(f,"settings.back",16/u,nav_y,ICON_BACK,"Back",APP_BUTTON_DEFAULT,0,IKS_BACK);
      yy:=nav_y-offset+k.app.icon_button+k.app.gap;
      yy+=app_text(f,"settings.title",16/u,yy,w-32/u,APP_TEXT_TITLE,"Settings")+k.app.gap;
      if s[0].experimental {yy+=app_button(f,"settings.login",16/u,yy,w-32/u,-1,"Log in",APP_BUTTON_PRIMARY,0,CH_HIT_LOGIN)+k.app.gap;}
      s[0].settings_content=yy-k.app.gap-(nav_y-offset);
    }
    if s[0].sc[0].identity[0].confirm==0 && !s[0].sc[0].identity[0].backup {
      yy:=nav_y-offset+s[0].settings_content+k.app.gap;
      s[0].settings_content+=k.app.gap+app_button(f,"usage.open",16/u,yy,w-32/u,-1,"Usage",APP_BUTTON_DEFAULT,0,US_OPEN);
      // Experimental features, as on the desktop (Settings > General): off unless turned on
      yy=nav_y-offset+s[0].settings_content+2*k.app.gap;
      sw:=app_switch(f,"settings.experimental",16/u,yy,w-32/u,"Experimental features",s[0].experimental,0,CH_HIT_EXPERIMENTAL);
      s[0].settings_content+=2*k.app.gap+sw;
      s[0].settings_content+=app_text(f,"settings.experimental.note",16/u,nav_y-offset+s[0].settings_content,w-32/u,APP_TEXT_CAPTION,"Log in, account, Projects, Foreman and Nostr keys.");
    }
    ch_reveal(s,f,key,nav_y,bottom,s[0].settings_content,offset);uiframe_unclip(f);
    return;
  }
  if s[0].section==1 && s[0].experimental {
    p:=s[0].sc[0].projects[..];project:=p[0].p[..];gap:=k.app.gap;nav:=k.app.icon_button;
    title:=ifx p[0].page==0 then "Projects" else ifx p[0].page==1 then "New Project" else ifx project[0].api_loaded then cast(string)project[0].api[0].name[0..<project[0].api[0].nn] else "Project";
    shown:=app_fit(f,k.title.face,title,w-2*(nav+gap));tw:=measure_width(f[0].m,k.title.face,shown);
    _:=app_text(f,"projects.title",(w-tw)/2,nav_y+(nav-k.title.line)/2,tw,APP_TEXT_TITLE,shown);
    if p[0].page==0 {_:=app_button(f,"project.new",w-nav-12/u,nav_y,nav,-1,"+",APP_BUTTON_QUIET,ifx !p[0].signed_in || ps_blocked(p) || p[0].op>0 then EL_S_DISABLED else 0,PS_ACTION);uiframe_say_set(f,elt_find(f[0].rows,"project.new"),"New Project");}
    else {_:=app_icon_button(f,"project.back",w-nav-12/u,nav_y,ICON_BACK,"Back",APP_BUTTON_QUIET,ifx ps_blocked(p) then EL_S_DISABLED else 0,PS_ACTION);}
    area_top:=nav_y+nav+gap;key:=uiframe_key(f,"section.viewport");offset:=keyed_scroll(f[0].keyed,key);s[0].section_viewport=bottom-area_top;
    uiframe_clip(f,0,area_top,w,bottom);
    s[0].section_content=ps_view(p,f,16/u,area_top-offset,w-32/u,area_top,bottom,ifx s[0].focused then ch_focus(s) else "");
    if !p[0].signed_in {_:=app_button(f,"projects.login",16/u,area_top+2*k.control_h,w-32/u,-1,"Log in",APP_BUTTON_PRIMARY,0,CH_HIT_LOGIN);s[0].section_content+=3*k.control_h;}
    ch_reveal(s,f,key,area_top,bottom,s[0].section_content,offset);uiframe_unclip(f);
    s[0].menu_x=12/u;s[0].menu_y=nav_y;s[0].menu_side=k.app.nav;
    if s[0].native {ch_menu_row(s,f,s[0].menu_x,nav_y);}else {_:=app_nav_button(f,"nav.menu",s[0].menu_x,nav_y,s[0].drawer,0,CH_HIT_MENU);}
    return;
  }
  if s[0].section==2 {
    title:=ifx s[0].library_filter==1 then "Pinned" else ifx s[0].library_filter==2 then "Archived" else "Recents";_=app_icon_button(f,"history.filter",w-k.chat.inset-a.icon_button,nav_y,ifx s[0].library_filter==1 then ICON_PIN else ifx s[0].library_filter==2 then ICON_ARCHIVE else ICON_CHATS,"Filter chats",APP_BUTTON_QUIET,0,465);tw:=measure_width(f[0].m,k.title.face,title);_=app_text(f,"history.title",(w-tw)/2,nav_y+(a.nav-k.title.line)/2,tw,APP_TEXT_TITLE,title);
    field_y:=bottom-k.control_h;_=app_field(f,"history.search",k.chat.inset,field_y,w-2*k.chat.inset,"Search chat titles",cast(string)s[0].search[0..<s[0].search_n],"Search chats",false,s[0].focused && ch_focus(s)=="history.search","",0,456);
    by:=field_y-a.gap-k.control_h;_=app_sidebar_new(f,"history.new",w-k.chat.inset-app_button_width(f,ICON_COMPOSE,"New chat"),by,ICON_COMPOSE,"New chat",CH_HIT_NEW);
    ch_history(s,f,k.chat.inset,nav_y+a.nav+a.gap,w-2*k.chat.inset,by-a.gap);
    s[0].menu_x=12/u;s[0].menu_y=nav_y;s[0].menu_side=a.nav;_=app_nav_button(f,"nav.menu",s[0].menu_x,nav_y,s[0].drawer,0,CH_HIT_MENU);return;
  }
  s[0].again = false;
  if s[0].core.count > 0 {
    // the chips show once logged in, or whenever this phone can run on its own computer (a paired
    // one, or one it can pair with): that needs no account. Logged out, only Default asks for a login.
    chips := s[0].core[0].auth == AUTH_IN || app_device_pairable(s[0].core) || app_device_count(s[0].core) > 0;
    keybuf:[CHLIB_KEY]u8;target_key:=ch_library_key(s,keybuf[..]);
    lay := ViewLayout.{archived=(chlib_flags(s[0].library[..],target_key)&2)!=0,restore_action=468,x = 0, top = nav_y + a.icon_button + a.gap, fade_top = top + 18 / u, w = w, bottom = bottom, chips_h = ifx chips then k.cmp.chip_h else 0.0f32,
      editing = s[0].focused && ch_focus(s) == VIEW_COMPOSER_ID, editor_h = s[0].editor_h / u, unit = u};
    out := view_page(f, s[0].view[..], s[0].core, lay);
    s[0].box = out.composer; s[0].again = out.again;
    if chips && !out.readonly && out.chips_w > 0 {
      e := es_chips(s[0].env[..]);
      _ := app_composer_chips(f, "composer.environment", "composer.repo", out.chips_x, out.chips_y, out.chips_w, ICON_GLOBAL, e.environment, ICON_FOLDER, e.repository,
        0, CH_HIT_ENV, ifx e.repository_on then CH_HIT_REPO else 0);
    }
  }
  // the navigation button at the top left opens the drawer
  s[0].menu_x = k.chat.header_pad; s[0].menu_y = nav_y; s[0].menu_side = k.app.nav;
  bar := f[0].sheet[0].nu;
  if s[0].core.count>0 {c:=s[0].core;title:=sheet_pool(f[0].sheet,ch_conversation_title(s));subtitle:=sheet_pool(f[0].sheet,ifx app_device_on(c) then view_device_name(c) else ifx app_conversation(c).count>0 then "Account chat" else "");
    app_conversation_header(f,0,nav_y,w,title,subtitle,s[0].view[0].model[0].rejoining,450,451);}
  if s[0].native { ch_menu_row(s, f, s[0].menu_x, nav_y); } else { _ := app_nav_button(f, "nav.menu", s[0].menu_x, nav_y, s[0].drawer, 0, CH_HIT_MENU); }
  ch_lift(f, bar);
}
// The bar's grounds and marks over the transcript's words: a sheet paints all its fills and icons
// (under) before any text (over), so the glass buttons would show the words fading under the bar
// through them. What the bar put under since `from` moves to the end of over, in order.
ch_lift :: (f: [] UiFrame, from: int) {
  sh := f[0].sheet; n := sh[0].no;
  for i: from..<sh[0].nu { if n >= sh[0].over.count { sh[0].lost += 1; break; } sh[0].over[n] = sh[0].under[i]; n += 1; }
  sh[0].no = n; sh[0].nu = from;
}
// The menu button's row and hit with no paint: the host's system button stands over it.
ch_menu_row :: (s: [] ChatPage, f: [] UiFrame, x: f32, y: f32) {
  side := f[0].skin.app.nav; open := s[0].drawer;
  row := uiframe_semantic(f, "nav.menu", EL_BUTTON, ifx open then "Close sidebar" else "Open sidebar", x, y, side, side, EL_S_EXPANDS | (ifx open then EL_S_EXPANDED else 0), CH_HIT_MENU);
  sheet_hit(f[0].sheet, UIFRAME_HIT, row, 0, x, y, side, side);
}
// The cover: the chips' picker or the login card over a dimmed page, and the sidebar.
ch_layout_cover :: (s: [] ChatPage, f: [] UiFrame, w: f32, h: f32) {
  k := f[0].skin; u := ch_u(s); top := s[0].safe_top / u;
  if s[0].thread_menu || s[0].thread_details || s[0].filter_menu {
    sheet_fill(f[0].sheet,0,0,w,h,0,opacity(k.canvas,0.65));
    r:=uiframe_semantic(f,"thread.scrim",EL_BUTTON,"Close conversation options",0,0,w,h,0,452);sheet_hit(f[0].sheet,UIFRAME_HIT,r,0,0,0,w,h);
    if s[0].filter_menu {
      mw:=ifx k.chat.menu_w<w-2*k.chat.inset then k.chat.menu_w else w-2*k.chat.inset;mh:=3*k.control_h+2*k.app.card_pad;
      in:=app_card(f,"history.filters",w-k.chat.inset-mw,top+k.app.nav+k.app.gap,mw,mh,"Filter chats");
      for i:0..<3 {title:=ifx i==0 then "All" else ifx i==1 then "Pinned" else "Archived";id:=ifx i==0 then "history.filter.all" else ifx i==1 then "history.filter.pinned" else "history.filter.archived";
        _:=app_icon_menu_row(f,id,in.x,in.y+cast(f32)i*k.control_h,in.w,ifx i==s[0].library_filter then ICON_CHECK else ifx i==1 then ICON_PIN else ifx i==2 then ICON_ARCHIVE else ICON_CHATS,title,ifx i==s[0].library_filter then EL_S_CURRENT else 0,480+i);}
      s[0].menu_content=3*k.control_h;s[0].menu_viewport=s[0].menu_content;app_card_end(f);
    }else if s[0].thread_details || s[0].rename || s[0].workspace {sh:=k.app.icon_button+cast(f32)(ifx s[0].rename then 3 else ifx s[0].workspace then 8 else 5)*(k.control_h+k.app.gap);covered:=ifx s[0].rename && s[0].keyboard>s[0].safe_bottom then s[0].keyboard else s[0].safe_bottom;available:=h-top-covered/u-2*k.app.gap;if sh>available {sh=available;}y:=h-covered/u-sh;
      in:=app_sheet(f,"thread.details",k.chat.inset,y,w-2*k.chat.inset,sh,ifx s[0].workspace then "Workspace" else ifx s[0].rename then "Rename" else "Session details");
      _:=app_text(f,"thread.details.title",in.x,in.y,in.w,APP_TEXT_TITLE,ifx s[0].workspace then "Workspace" else ifx s[0].rename then "Rename" else "Session details");body_top:=in.y+k.title.line+k.app.gap;done_y:=y+sh-k.control_h-k.app.card_pad;
      s[0].menu_viewport=ifx done_y-body_top-k.app.gap>0 then done_y-body_top-k.app.gap else 0.0f32;
      key:=uiframe_key(f,"thread.viewport");offset:=keyed_scroll(f[0].keyed,key);yy:=body_top-offset;uiframe_clip(f,in.x,body_top,in.x+in.w,body_top+s[0].menu_viewport);
      if s[0].rename {
       yy+=app_field(f,"thread.rename",in.x,yy,in.w,"Name",cast(string)s[0].rename_text[0..<s[0].rename_n],"Conversation name",false,s[0].focused && ch_focus(s)=="thread.rename","",0,461)+k.app.gap;
       yy+=app_text(f,"thread.local",in.x,yy,in.w,APP_TEXT_CAPTION,"Saved on this device");if s[0].library_note {yy+=k.app.gap;yy+=app_notice(f,"thread.save.error",in.x,yy,in.w,"Saved-chat preferences are full",APP_NOTICE_ERROR);}
      }else if s[0].core.count>0 {c:=s[0].core;e:=es_chips(s[0].env[..]);
       yy+=app_text(f,"thread.computer",in.x,yy,in.w,APP_TEXT_BODY,e.environment)+k.app.gap;
       if e.repository.count>0 {yy+=app_text(f,"thread.repository",in.x,yy,in.w,APP_TEXT_CAPTION,e.repository)+k.app.gap;}
       if app_device_on(c) {yy+=app_text(f,"thread.control",in.x,yy,in.w,APP_TEXT_CAPTION,"Connected computer")+k.app.gap;}
       yy+=app_button(f,"thread.usage",in.x,yy,in.w,ICON_CHECKLIST,"Usage",APP_BUTTON_DEFAULT,0,457);
      }
      uiframe_unclip(f);s[0].menu_content=yy-body_top+offset;ch_reveal(s,f,key,body_top,body_top+s[0].menu_viewport,s[0].menu_content,offset);
      _:=app_button(f,"thread.done",in.x,done_y,in.w,-1,ifx s[0].rename then "Save" else "Done",APP_BUTTON_DEFAULT,0,ifx s[0].rename then 462 else 452);app_card_end(f);
    }else {
      keybuf:[CHLIB_KEY]u8;target_key:=ch_library_key(s,keybuf[..]);active:=chlib_key(target_key);paired:=s[0].core.count>0 && app_device_on(s[0].core);total:=ifx active then (ifx s[0].core.count>0 then 6 else 5) else 3;
      mw:=ifx k.chat.menu_w<w-2*k.chat.inset then k.chat.menu_w else w-2*k.chat.inset;mh:=cast(f32)total*k.control_h+2*k.app.card_pad;
      available:=h-top-k.app.nav-s[0].safe_bottom/u-2*k.app.gap;if mh>available {mh=available;}
      in:=app_card(f,"thread.menu",w-k.chat.inset-mw,top+k.app.nav+k.app.gap,mw,mh,"Conversation options");
      s[0].menu_content=cast(f32)total*k.control_h;s[0].menu_viewport=ifx mh>2*k.app.card_pad then mh-2*k.app.card_pad else 0.0f32;
      key:=uiframe_key(f,"thread.viewport");offset:=scroll_clamp(keyed_scroll(f[0].keyed,key),s[0].menu_content,s[0].menu_viewport);keyed_scroll_set(f[0].keyed,key,offset);
      uiframe_clip(f,in.x,in.y,in.x+in.w,in.y+s[0].menu_viewport);yy:=in.y-offset;
      if active {flags:=chlib_flags(s[0].library[..],target_key);empty:=ifx s[0].view[0].model[0].empty then EL_S_DISABLED else 0;
       _:=app_icon_menu_row(f,"thread.share",in.x,yy,in.w,ICON_SHARE,"Share excerpt",empty,463);
       _:=app_icon_menu_row(f,"thread.copy",in.x,yy+k.control_h,in.w,ICON_COPY,"Copy messages",empty,454);
       _:=app_icon_menu_row(f,"thread.pin",in.x,yy+2*k.control_h,in.w,ICON_PIN,ifx (flags&1)!=0 then "Unpin" else "Pin",0,458);
       _:=app_icon_menu_row(f,"thread.rename.open",in.x,yy+3*k.control_h,in.w,ICON_PEN,"Rename",0,460);
       _:=app_icon_menu_row(f,"thread.archive",in.x,yy+4*k.control_h,in.w,ICON_ARCHIVE,ifx (flags&2)!=0 then "Unarchive" else "Archive",ifx app_navigation_blocked(s[0].core) then EL_S_DISABLED else 0,459);
       if s[0].core.count>0 {_:=app_icon_menu_row(f,"thread.workspace",in.x,yy+5*k.control_h,in.w,ICON_FOLDER,"Workspace",0,467);}
      }else {
       _:=app_icon_menu_row(f,"thread.computer",in.x,yy,in.w,ICON_GLOBAL,"Choose computer",0,453);
       _:=app_icon_menu_row(f,"thread.recents",in.x,yy+k.control_h,in.w,ICON_CHATS,"Recent chats",0,455);
       _=app_icon_menu_row(f,"thread.workspace",in.x,yy+2*k.control_h,in.w,ICON_FOLDER,"Workspace",0,467);
      }
      uiframe_unclip(f);app_card_end(f);
    }
    return;
  }
  if ch_picking(s) {
    // a press beside the picker closes it (es_press "env.scrim")
    if !s[0].native { sheet_fill(f[0].sheet, 0, 0, w, h, 0, opacity(Rgba.{r = 0, g = 0, b = 0, a = 1}, APP_SIDEBAR_DIM)); }
    scrim:=uiframe_semantic(f, "env.scrim", EL_BUTTON, "Close", 0, 0, w, h, 0, 0);sheet_hit(f[0].sheet,UIFRAME_HIT,scrim,0,0,0,w,h);
    py := ifx k.chat.enabled then top+(h-top)*0.35f32 else top + 56 / u; ph := h - s[0].safe_bottom / u - 12 / u - py;
    sh := f[0].sheet; nu := sh[0].nu; no := sh[0].no; nl := sh[0].nl;
    s[0].picker = es_picker(f, s[0].env[..], 12 / u, py, w - 24 / u, ph, ICON_CHECK);
    // the host's popover shows these rows (chat_row, chat_row_value): the picker keeps them and paints nothing
    if s[0].native { sh[0].nu = nu; sh[0].no = no; sh[0].nl = nl; }
  }
  l := s[0].lf[..];
  if l[0].open { ch_login_page(s, f, w, h); }
  // the sidebar: it pushes the page right. Coder Desktop's sidebar (apps/openagents-desktop/page/layout/
  // sidebar.coax): New chat and Search, then Pinned and Recents, and the "Local" row and its gear
  // (Settings) at the foot. Experimental features add Projects, Foreman, and Log in or Log out.
  in := app_sidebar(f, "drawer", "drawer.scrim", 0, 0, w, h, top, s[0].share, "Menu", CH_HIT_SCRIM);
  if in.w > 0 {
    a := k.app; st := k.set;
    iy := in.y + 4 / u;
    iy += app_side_action(f, "drawer.new", in.x, iy, in.w, ICON_COMPOSE, "New chat", 0, CH_HIT_NEW);
    iy += app_side_action(f, "drawer.search", in.x, iy, in.w, ICON_SET_SEARCH, "Search", ifx s[0].section==2 then EL_S_CURRENT else 0, 455);
    if s[0].experimental {
      iy += app_side_action(f, "drawer.projects", in.x, iy, in.w, ICON_FOLDER, "Projects", ifx s[0].section==1 then EL_S_CURRENT else 0, 411);
      iy += app_side_action(f, "drawer.foreman", in.x, iy, in.w, ICON_BOT, "Foreman", ifx s[0].sc[0].foreman[0].open then EL_S_CURRENT else 0, CH_HIT_FOREMAN);
    }
    foot := h - s[0].safe_bottom / u - a.gap - st.account;
    bottom := foot - st.account_top;
    who := ""; logged := s[0].experimental && lf_logged_in(l);
    if logged {
      who = lf_who(l); s[0].initials_n = app_initials(who, s[0].initials[..]);
      bottom -= a.side_row; _ := app_side_action(f, "drawer.logout", in.x, bottom, in.w, -1, "Log out", 0, CH_HIT_LOGOUT);
    } else if s[0].experimental && lf_known(l) {
      bottom -= a.side_row; _ := app_side_action(f, "drawer.login", in.x, bottom, in.w, -1, "Log in", 0, CH_HIT_LOGIN);
    }
    ch_history(s, f, in.x, iy + a.gap, in.w, bottom - a.gap);
    name := ifx logged && who.count > 0 then who else "Local";
    initial := ifx logged && s[0].initials_n > 0 then cast(string) s[0].initials[0..<s[0].initials_n] else "L";
    _ := set_account_row(f, "drawer.me", in.x, foot, in.w, name, initial, false, s[0].sc[0].identity[0].open, 211, 211);
    app_sidebar_end(f, in);
  }
  // The floating control remains visible over the pushed page. Keep it in
  // the live cover's semantics too, so accessibility can reach and close it.
  if s[0].drawer && s[0].menu_side>0 {if s[0].native {ch_menu_row(s,f,s[0].menu_x+app_sidebar_shift(w,s[0].share),s[0].menu_y);}else {_:=app_nav_button(f,"nav.menu",s[0].menu_x+app_sidebar_shift(w,s[0].share),s[0].menu_y,true,0,CH_HIT_MENU);}}
}
// The login page: the whole screen over the chat, its Back button where the menu button was, and the
// login flow's form under it. It holds every press while it shows.
ch_login_page :: (s: [] ChatPage, f: [] UiFrame, w: f32, h: f32) {
  k := f[0].skin; u := ch_u(s); top := s[0].safe_top / u; l := s[0].lf[..];
  sheet_fill(f[0].sheet, 0, 0, w, h, 0, k.canvas);
  _ := uiframe_semantic(f, "login.page", EL_REGION, "Log in", 0, 0, w, h, 0, 0);
  // with chat_native the host draws Back as a Liquid Glass button where the menu button stands
  // on a legacy host: the page keeps its row and hit and paints nothing
  if s[0].native {
    side := k.app.nav; by := top + 4 / u;
    row := uiframe_semantic(f, "login.back", EL_BUTTON, "Back", s[0].menu_x, by, side, side, 0, CH_HIT_BACK);
    sheet_hit(f[0].sheet, UIFRAME_HIT, row, 0, s[0].menu_x, by, side, side);
  } else { _ := app_icon_button(f, "login.back", s[0].menu_x, top + 4 / u, ICON_BACK, "Back", APP_BUTTON_DEFAULT, 0, CH_HIT_BACK); }
  cw := ifx w - 32 / u > 480 then 480.0f32 else w - 32 / u;
  key:=uiframe_key(f,"login.viewport");offset:=keyed_scroll(f[0].keyed,key);
  ly:=top+4/u+k.app.icon_button+24/u;under:=ifx s[0].keyboard>s[0].safe_bottom then s[0].keyboard else s[0].safe_bottom;lb:=h-under/u-12/u;
  s[0].login_viewport=lb-ly;uiframe_clip(f,0,ly,w,lb);
  s[0].login_content=lf_card(f,l,(w-cw)/2,ly-offset,cw,s[0].focused && ch_login_field(ch_focus(s))!=LF_FIELD_NONE);
  ch_reveal(s,f,key,ly,lb,s[0].login_content,offset);uiframe_unclip(f);
}
// Close the login page: the flow's Cancel ends the attempt, and a login field gives up the keyboard.
ch_login_close :: (s: [] ChatPage) -> bool {
  l := s[0].lf[..]; done := lf_press(l, LF_ACT_CANCEL); ch_step(s);
  if ch_login_field(ch_focus(s)) != LF_FIELD_NONE { s[0].focus_n = 0; }
  return done || !l[0].open;
}
ch_stamp :: (s: [] ChatPage) -> int { return surface_stamp(ch_live(s)); }
// A drawer destination leaves Settings, including its nested Usage page.
ch_main :: (s:[]ChatPage) {app_screens_close(s[0].sc[..]);s[0].thread_menu=false;s[0].thread_details=false;s[0].rename=false;s[0].workspace=false;s[0].filter_menu=false;s[0].renderer=false;}
// A file a computer session changed: that computer's workspace opens on its changes (the Diff tab).
ch_open_changes :: (s:[]ChatPage)->bool {
 if s[0].core.count<1 || !app_device_on(s[0].core) {return false;}host:=app_environment(s[0].core);
 if !wsc_open(s[0].sc[0].workspaces[..],host,false) {return false;}s[0].sc[0].workspaces[0].tab=0;s[0].sc[0].workspaces[0].cursor=0;s[0].workspace=false;s[0].thread_menu=false;s[0].thread_details=false;
 ch_set_focus(s,"");keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),0);ch_step(s);return true;
}
// A computer session's sub-agent row: its own transcript opens over the chat (subagent/flow.coax).
ch_open_subagent :: (s:[]ChatPage,item:string)->bool {
 c:=s[0].core;if c.count<1 || !app_device_on(c) {return false;}e:=c[0].device[0].e[..];
 title:="";for i:0..<e[0].view[0].ni {m:=e[0].view[0].items[i];if cast(string)e[0].view[0].items[i].id[0..<m.ni]==item {title=view_first_line(ea_item_text(e[0].view[..],i));}}
 if !sa_open(s[0].sc[0].subagent[..],c,cast(string)e[0].session[0..<e[0].ns],item,title) {return false;}
 s[0].workspace=false;s[0].thread_menu=false;s[0].thread_details=false;
 ch_set_focus(s,"");keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),0);ch_step(s);return true;
}
// A press on a committed row; platform effects go through the shared core.
ch_press :: (s: [] ChatPage, row: int) -> bool {
  sf := ch_live(s); act := surface_action(sf, row); l := s[0].lf[..];
  if act==WSC_ACTION {ok:=wsc_press(s[0].sc[0].workspaces[..],s[0].core,surface_id(sf,row));ch_set_focus(s,"");ch_step(s);return ok;}
  if act==WSC_FIELD {ch_set_focus(s,surface_id(sf,row));return true;}
  if act==FM_ACTION {ok:=fm_press(s[0].sc[0].foreman[..],surface_id(sf,row));ch_step(s);return ok;}
  if act==SA_ACTION {ok:=sav_press(s[0].sc[0].subagent[..],s[0].keyed[0..<1],surface_id(sf,row));ch_step(s);return ok;}
  if act==CH_HIT_SUBAGENT_BACK {s[0].sc[0].subagent[0].open=false;ch_set_focus(s,"");ch_step(s);return true;}
  if act==CH_HIT_FOREMAN {if !s[0].experimental {return false;}ch_main(s);s[0].drawer=false;_=fm_open(s[0].sc[0].foreman[..],s[0].core);ch_set_focus(s,"");keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),0);ch_step(s);return true;}
  if act==CH_HIT_FOREMAN_BACK {ch_main(s);ch_set_focus(s,"");ch_step(s);return true;}
  if act==450 || act==451 {s[0].rename=false;s[0].workspace=false;s[0].library_note=false;s[0].thread_menu=act==450;s[0].thread_details=act==451;keyed_scroll_set(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"thread.viewport"),0);ch_set_focus(s,"");return true;}
  if act==452 {s[0].filter_menu=false;s[0].thread_menu=false;s[0].thread_details=false;s[0].rename=false;s[0].workspace=false;ch_set_focus(s,"");return true;}
  if act==455 {ch_main(s);s[0].drawer=false;s[0].section=2;ch_set_focus(s,"");ch_step(s);return true;}
  if act==456 {ch_set_focus(s,"history.search");return true;}
  if act==457 {s[0].thread_details=false;s[0].thread_menu=false;s[0].sc[0].usage[0].open=true;ch_set_focus(s,"");ch_step(s);return true;}
  if act==453 {s[0].thread_menu=false;s[0].thread_details=false;_=es_press(s[0].env[..],"composer.environment",ch_now(s));ch_step(s);return true;}
  if act==468 {keybuf:[CHLIB_KEY]u8;key:=ch_library_key(s,keybuf[..]);return chlib_change(s[0].library[..],key,chlib_label(s[0].library[..],key,""),chlib_flags(s[0].library[..],key)&1);}
  if act==467 {if s[0].core.count<1 {return false;}host:=app_environment(s[0].core);if !ea_id(host,64) {host="";}if !wsc_open(s[0].sc[0].workspaces[..],host,!app_device_on(s[0].core)) {return false;}s[0].workspace=false;s[0].thread_menu=false;s[0].thread_details=false;ch_set_focus(s,"");ch_step(s);return true;}

  if act==458 || act==459 || act==460 {
    keybuf:[CHLIB_KEY]u8;key:=ch_library_key(s,keybuf[..]);if !chlib_key(key) {return false;}flags:=chlib_flags(s[0].library[..],key);
    if act==460 {s[0].target_n=el_copy(s[0].target[..],key);title:=chlib_label(s[0].library[..],key,ch_conversation_title(s));s[0].rename_n=text_single_line(cast(string)title[0..<text_byte_floor(title,ifx title.count<CHLIB_TITLE then title.count else CHLIB_TITLE)],s[0].rename_text[..]);s[0].rename=true;ch_set_focus(s,"thread.rename");return true;}
    if act==459 && app_navigation_blocked(s[0].core) {return false;}
    snap:[CHLIB_TITLE]u8;original:=ch_conversation_title(s);cut:=ifx original.count<CHLIB_TITLE then original.count else CHLIB_TITLE;sn:=text_single_line(cast(string)original[0..<text_byte_floor(original,cut)],snap[..]);title:=chlib_label(s[0].library[..],key,ifx sn>0 then cast(string)snap[0..<sn] else "New chat");ok:=chlib_change(s[0].library[..],key,title,flags^(ifx act==458 then 1 else 2));s[0].library_note=!ok;if !ok {app_say(s[0].core,"Saved-chat preferences are full.");return false;}
    s[0].thread_menu=false;if act==459 {s[0].section=2;ch_step(s);}return true;
  }
  if act==461 {ch_set_focus(s,"thread.rename");return true;}
  if act==462 {key:=cast(string)s[0].target[0..<s[0].target_n];if !chlib_change(s[0].library[..],key,cast(string)s[0].rename_text[0..<s[0].rename_n],chlib_flags(s[0].library[..],key)) {s[0].library_note=true;return false;}s[0].rename=false;s[0].thread_menu=false;ch_set_focus(s,"");return true;}
  if act==466 {id:=surface_id(sf,row);buf:[64]u8;for i:0..<s[0].library[0].n {if ch_library_row_id(s[0].library[0].rows[i..<i+1],buf[..])==id {return ch_open_library(s,cast(string)s[0].library[0].rows[i].key[0..<s[0].library[0].rows[i].nk]);}}return false;}
  if act==465 {s[0].filter_menu=true;ch_set_focus(s,"");return true;}
  if act>=480 && act<483 {if !s[0].filter_menu {return false;}s[0].library_filter=act-480;s[0].filter_menu=false;ch_step(s);keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"history.viewport"),0);return true;}

  if act==454 || act==463 {v:=s[0].view[..];n:=ifx act==463 then el_copy(v[0].copy[..],"OpenAgents — loaded conversation excerpt\n\n") else 0;for i:0..<v[0].model[0].n {r:=v[0].model[0].rows[i];if r.kind==VK_MESSAGE || r.kind==VK_REPLY || r.kind==VK_SENT || r.kind==VK_DEVICE_MESSAGE || r.kind==VK_DEVICE_SENT {text:=view_row_text(v,view_chat_of(s[0].core),r);if n+text.count+2>v[0].copy.count {return false;}if n>0 {n=el_put(v[0].copy[..],n,"\n\n");}n=el_put(v[0].copy[..],n,text);}}
    if n<1 {return false;}c:=s[0].core;ok:=app_dispatch(c,AppEvent.{kind=EV_ACTION,code=ifx act==463 then ACT_SHARE else ACT_COPY,text=cast(string)v[0].copy[0..<n],mono_ms=c[0].mono_ms,wall_ms=c[0].wall_ms})==APP_OK;if ok {s[0].thread_menu=false;}return ok;}
  // a field pressed through VoiceOver or the driver gets the keyboard as a tap's would
  t := [1] ElTable.[ch_rows(s)];
  if !elt_ok(t[..],row) || (t[0].rows[row].state & EL_S_DISABLED)!=0 {return false;}
  if !elt_visible(t[..],row).visible && !(s[0].native && ch_picking(s) && ch_env_row(surface_id(sf,row))) {return false;}
  if elt_ok(t[..], row) && t[0].rows[row].role == EL_FIELD && act != 0 { ch_set_focus(s, surface_id(sf, row)); }
  if act==CH_HIT_EXPERIMENTAL {chat_experimental_set(s,!s[0].experimental);return true;}
  if act==411 {
    if !s[0].experimental || ps_blocked(s[0].sc[0].projects[..]) {return false;}ch_main(s);s[0].section=1;ps_open(s[0].sc[0].projects[..]);
    s[0].drawer=false;ch_set_focus(s,"");ch_step(s);return true;
  }
  if act==PS_FIELD {return ps_editing(surface_id(sf,row));}
  if act==PS_ACTION {
    result:=ps_press(s[0].sc[0].projects[..],s[0].core,surface_id(sf,row));if result==0 {return false;}
    if result==2 {s[0].section=0;}ch_set_focus(s,"");
    keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),0);ch_step(s);return true;
  }
  if act==340 {
    if s[0].core.count<1 || app_navigation_blocked(s[0].core) {return false;}
    id:=surface_id(sf,row);if !ct_id(id,"cnv_",32) {return false;}
    _:=app_dispatch(s[0].core,AppEvent.{kind=EV_ACTION,code=ACT_ENVIRONMENT,more="Default",mono_ms=ch_now(s),wall_ms=s[0].core[0].wall_ms});
    opened:=app_dispatch(s[0].core,AppEvent.{kind=EV_ACTION,code=ACT_OPEN,text=id,mono_ms=ch_now(s),wall_ms=s[0].core[0].wall_ms});if opened<1 {return false;}ch_main(s);s[0].section=0;s[0].drawer=false;ch_set_focus(s,"");ch_step(s);return true;
  }
  if act==343 {
    c:=s[0].core;if c.count<1 || app_navigation_blocked(c) {return false;}
    h:=s[0].sc[0].devices[..];id:=surface_id(sf,row);buf:[64]u8;
    for i:0..<h[0].nav[0].n {if dh_row_id(h,i,buf[..])!=id {continue;}r:=h[0].nav[0].rows[i];entry:=h[0].nav[0].browser[0].catalog[0].entries[r.host];key:[193]u8;
      for j:0..<64 {key[j]=entry.host[j];}key[64]='\t';for j:0..<r.session.ni {key[65+j]=r.session.id[j];}
      opened:=app_dispatch(c,AppEvent.{kind=EV_ACTION,code=ACT_DEVICE_REJOIN,text=cast(string)key[0..<65+r.session.ni],mono_ms=ch_now(s),wall_ms=c[0].wall_ms});if opened<1 {return false;}
      ch_main(s);s[0].section=0;s[0].drawer=false;ch_set_focus(s,"");ch_step(s);return true;
    }return false;
  }
  if act==344 {
    h:=s[0].sc[0].devices[..];buf:[64]u8;id:=surface_id(sf,row);
    for i:0..<h[0].nav[0].browser[0].catalog[0].n {key:=nav_session_id(cast(string)h[0].nav[0].browser[0].catalog[0].entries[i].host[..],"more",buf[..]);buf[4]='m';buf[5]='o';buf[6]='r';buf[7]='e';if id==key {done:=dh_more(h,s[0].core,i);ch_step(s);return done;}}
    return false;
  }
  if act==342 {done:=hi_first(s[0].sc[0].history[..],s[0].core);if done {chat_scroll_to(s,0);}ch_step(s);return done;}
  if act==341 {done:=hi_more(s[0].sc[0].history[..],s[0].core);ch_step(s);return done;}
  if act==211 {s[0].sc[0].usage[0].open=false;s[0].drawer=false;s[0].sc[0].identity[0].open=true;if s[0].sc[0].identity[0].op==0 {s[0].sc[0].identity[0].loaded=false;s[0].sc[0].identity[0].note_n=0;}ch_set_focus(s,"");ch_step(s);return true;}
  if act==US_OPEN {s[0].sc[0].usage[0].open=true;ch_set_focus(s,"");keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),0);ch_step(s);return true;}
  if act==US_FIELD {return surface_id(sf,row)=="usage.label" || surface_id(sf,row)=="usage.code";}
  if act==US_ACTION {
    done:=us_press(s[0].sc[0].usage[..],s[0].core,surface_id(sf,row));if done {ch_set_focus(s,"");ch_step(s);}return done;
  }
  if act==IKS_SECRET {ch_set_focus(s,"identity.secret");return true;}
  if (act>=IKS_BACK && act<=IKS_CANCEL) || (act>=302 && act<=306) {
    if s[0].core.count<1 {return false;}
    done:=iks_request(s[0].sc[0].identity[..],s[0].core,ifx act>=302 then act-300 else act);ch_step(s);return done;
  }
  // the chat page's own rows (VIEW_A_*), on the page layer
  if ch_layer(s) == 0 && act > 0 && act < CH_HIT_TEXT {
    if s[0].core.count < 1 { return false; }
    p := view_press(s[0].view[..], s[0].core, s[0].keyed[0..<1], surface_id(sf, row), act);
    if p.kind == VIEW_P_FOCUS { ch_set_focus(s, VIEW_COMPOSER_ID); s[0].action = CH_ACT_FOCUS; return true; }
    if p.kind == VIEW_P_DISPATCH && p.what == VIEW_C_FILE { return ch_open_changes(s); }
    if p.kind == VIEW_P_DISPATCH && p.what == VIEW_C_SUBAGENT { return ch_open_subagent(s, p.text); }
    if p.kind == VIEW_P_DISPATCH { return ch_dispatch(s, p.what, p.text); }
    return p.kind == VIEW_P_LOCAL;
  }
  // the chips and the picker's rows go by their ids (environment/select.coax es_press)
  id := surface_id(sf, row);
  if act == CH_HIT_ENV || act == CH_HIT_REPO || (ch_picking(s) && ch_env_row(id)) {
    if !es_press(s[0].env[..], id, ch_now(s)) { return false; }
    ch_step(s); return true;
  }
  if act == CH_HIT_MENU { s[0].drawer = !s[0].drawer;ch_step(s); return true; }
  if act == CH_HIT_SCRIM { s[0].drawer = false;ch_step(s); return true; }
  if act == CH_HIT_LOGIN { if !s[0].experimental { return false; } s[0].drawer = false; lf_open(l); ch_step(s); return true; }
  if act == CH_HIT_BACK { return ch_login_close(s); }
  if act == CH_HIT_LOGOUT { if !s[0].experimental { return false; } s[0].drawer = false; _ := lf_logout(l); ch_step(s); return true; }
  // New chat: a new, empty conversation in the core, and the sidebar closes onto it
  if act == CH_HIT_NEW {
    c := s[0].core; if c.count < 1 { return false; }
    if ps_blocked(s[0].sc[0].projects[..]) {return false;}
    if app_dispatch(c, AppEvent.{kind = EV_ACTION, code = ACT_NEW, mono_ms = c[0].mono_ms, wall_ms = c[0].wall_ms})!=APP_OK {return false;}
    ch_main(s);s[0].section=0;s[0].drawer = false; ch_step(s); return true;
  }
  if act >= LF_ACT_EMAIL && act <= LF_ACT_CANCEL {
    done := lf_press(l, act); ch_step(s);
    if !l[0].open && ch_login_field(ch_focus(s)) != LF_FIELD_NONE { s[0].focus_n = 0; }
    return done;
  }
  return false;
}

// ---------------------------------------------------------------- the host's calls

// The window's facts in points, the platform editor (whether it holds the keyboard and its own text
// height) and reduced motion.
chat_env :: (s: [] ChatPage, safe_top: f32, safe_bottom: f32, keyboard: f32, focused: bool, editor_height: f32, reduced: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  if keyboard!=s[0].keyboard {s[0].reveal_focus=true;}
  s[0].safe_top = ifx safe_top > 0 then safe_top else 0.0f32; s[0].safe_bottom = ifx safe_bottom > 0 then safe_bottom else 0.0f32;
  s[0].keyboard = ifx keyboard > 0 then keyboard else 0.0f32; s[0].focused = focused;
  s[0].editor_h = ifx focused && editor_height > 0 then editor_height else 0.0f32; s[0].reduced = reduced;
}
// One frame of width by height device pixels. Returns the vertex count.
chat_frame :: (s: [] ChatPage, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  if !s[0].ready { ch_init(s); }
  s[0].render_staged=false;s[0].frame_renderer=s[0].renderer;
  for i:0..<2 {s[0].staged_front[i]=s[0].surface[i].front;s[0].staged_generation[i]=s[0].surface[i].generation;}
  a := s[0].atlas[..];
  d := (ifx dpr < 1 then 1.0f32 else dpr) * ch_u(s);
  w := width / d; h := height / d;if w!=s[0].page_w {s[0].reveal_focus=true;}s[0].page_w = w;
  s[0].d = d;
  t := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  if !s[0].reduced { s[0].time += t; }
  a[0].frame += 1;
  k := noir_phone_skin();
  // the sidebar's open share for this frame first: the ground, the push and the dim all draw from it
  s[0].share = app_sidebar_ease(s[0].share, s[0].drawer, t, s[0].reduced);
  // the page's ground lightens while the sidebar pushes it, so it reads apart from the black panel
  ground := app_sidebar_ground(k.canvas, s[0].share);
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, ground, ground);
  if !a[0].ready { return v; }
  live := ch_layer(s);
  shift := app_sidebar_shift(w, s[0].share);
  ch_take_flow_focus(s);
  moving := s[0].share != (ifx s[0].drawer then 1.0f32 else 0.0f32);
  for layer: 0..<2 {
    f: [1] UiFrame;
    // only the layer that took the press sees it, so the focus rule runs once
    mine := layer == live;
    input := uiinput(s[0].px, s[0].py, mine && s[0].touching, mine && s[0].touching, ifx mine then cast(string) s[0].pressed[0..<s[0].pressed_n] else "", ch_focus(s));
    uiframe_begin(f[..], ch_sf(s, layer), s[0].keyed[layer..<layer + 1], measure_font(a), k, input, s[0].time, t, s[0].reduced, s[0].reduced_transparency);
    if mine && uiframe_focus(f[..]) != ch_focus(s) { ch_set_focus(s, uiframe_focus(f[..])); }
    if layer == 0 { ch_layout(s, f[..], w, h); } else { ch_layout_cover(s, f[..], w, h); }
    moving = moving || uiframe_moving(f[..]);
    committed:=uiframe_end(f[..],ch_sf(s,layer));
    if !committed {s[0].refused+=1;if s[0].renderer {s[0].render_plan[0].ok=false;s[0].render_staged=true;v=0;break;}}
    sh := surface_sheet(ch_sf(s, layer));
    // the page moves right with the sidebar
    ox := ifx layer == 0 then shift else 0.0f32;
    if s[0].renderer && layer==0 {
      n:=prim_fill(s[0].render_list[..],0,0,0,w,h,0,k.canvas);
      for p:sh.under[0..<sh.nu] {n=prim_put(s[0].render_list[..],n,p);}
      for p:sh.over[0..<sh.no] {n=prim_put(s[0].render_list[..],n,p);}
      images:=[1]UcImage.[UcImage.{id=1,w=16,h=16}];s[0].render_staged=true;
      if uc_build(s[0].render_plan[..],out,a,s[0].render_list[0..<n],images[..],cast(int)width,cast(int)height,d) {v=s[0].render_plan[0].v;} else {v=0;}
      break;
    }
    v = gpu_draw(out, v, a, d, sh.under[0..<sh.nu], ox, 0, -8, h + 8);
    v = gpu_draw(out, v, a, d, sh.over[0..<sh.no], ox, 0, -8, h + 8);
  }
  s[0].moving = moving || s[0].again || (s[0].renderer && !s[0].reduced);
  s[0].reveal_focus=false;
  gpu_monochrome(out, v);
  if s[0].render_staged {s[0].candidate_renderer=s[0].renderer;for i:0..<2 {s[0].candidate_front[i]=s[0].surface[i].front;s[0].candidate_generation[i]=s[0].surface[i].generation;s[0].surface[i].front=s[0].staged_front[i];s[0].surface[i].generation=s[0].staged_generation[i];}}
  s[0].stamp=ch_stamp(s)+ch_layer(s);
  return v;
}
// A touch, in device pixels: phase 0 down, 1 moved, 2 up, 3 cancelled. A press is routed through the committed rows.
chat_pointer :: (s: [] ChatPage, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return false; }
  ux := x / s[0].d; uy := y / s[0].d;
  sf := ch_live(s);
  row := surface_hit(sf, ux, uy);
  id := surface_id(sf, row);
  was := cast(string) s[0].pressed[0..<s[0].pressed_n];
  s[0].px = ux; s[0].py = uy;
  if phase == 0 {
    s[0].touching = true; s[0].down_x = ux; s[0].swiped = false;
    s[0].down_y = uy; s[0].last_y = uy; s[0].scrolling = false;
    s[0].pressed_n = ifx surface_action(sf, row) != 0 || (ch_picking(s) && ch_env_row(id)) then el_copy(s[0].pressed[..], id) else 0;
    // the focus rule at once, so a tap that begins and ends between two frames still moves the keyboard
    ins := [1] UiInput.[uiinput(ux, uy, true, true, cast(string) s[0].pressed[0..<s[0].pressed_n], ch_focus(s))];
    if uiframe_press_focus(sf, ins[..]) { ch_set_focus(s, cast(string) ins[0].focused[0..<ins[0].focused_n]); }
    return true;
  }
  if phase == 1 {
    if was != id && !uiframe_field_capture(sf,was,ch_focus(s),ux-s[0].down_x,uy-s[0].down_y,CH_MOVE) { s[0].pressed_n = 0; }
    // a swipe left closes the open drawer; a swipe right from the left edge opens it
    if !s[0].swiped && s[0].drawer && ux - s[0].down_x < -CH_SWIPE { s[0].drawer = false; s[0].swiped = true; s[0].pressed_n = 0;ch_step(s); }
    if !s[0].swiped && !s[0].drawer && !s[0].lf[0].open && !ch_picking(s) && s[0].down_x < CH_EDGE && ux - s[0].down_x > CH_SWIPE { s[0].drawer = true; s[0].swiped = true; s[0].pressed_n = 0;ch_step(s); }
    // on the login page the same swipe goes back to the chat
    if !s[0].swiped && s[0].lf[0].open && s[0].down_x < CH_EDGE && ux - s[0].down_x > CH_SWIPE { _ := ch_login_close(s); s[0].swiped = true; s[0].pressed_n = 0;ch_step(s); }
    // on the page, a touch that travels up or down scrolls the transcript (up: toward the latest message)
    if !s[0].swiped && (ch_layer(s) == 0 || s[0].thread_menu || s[0].thread_details || s[0].filter_menu) && (s[0].scrolling || abs(uy - s[0].down_y) > CH_MOVE) {
      s[0].scrolling = true; s[0].pressed_n = 0;
      if !s[0].native_scroll {chat_scroll_to(s,ch_scroll_offset(s)+s[0].last_y-uy);}
    }
    // in the picker, it scrolls the picker's list
    if ch_picking(s) && (s[0].scrolling || abs(uy - s[0].down_y) > CH_MOVE) {
      s[0].scrolling = true; s[0].pressed_n = 0;
      es_scroll(s[0].env[..], s[0].last_y - uy, s[0].picker.content, s[0].picker.view);
    }
    s[0].last_y = uy;
    return true;
  }
  captured:=uiframe_field_capture(sf,was,ch_focus(s),ux-s[0].down_x,uy-s[0].down_y,CH_MOVE);
  held := s[0].pressed_n > 0 && (was == id || captured);
  if captured {row=surface_find(sf,was);}
  s[0].touching = false; s[0].pressed_n = 0;
  return phase == 2 && held && ch_press(s, row);
}
// A row of the picker's ("env.*"): it carries no action number; es_press reads its id.
ch_env_row :: (id: string) -> bool { return id.count > 4 && cast(string) id[0..<4] == "env."; }
// The shared app core the host made, and the typed email it kept at the last save (lf_draft).
// Call once, before the core's launch; then chat_step after every call into the core.
chat_attach :: (s: [] ChatPage, c: [] AppCore, kept: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { ch_init(s); }
  s[0].core = c; _ := lf_restore(s[0].lf[..], kept);
}
chat_step :: (s: [] ChatPage) #export_c #effects(all) { if s.count > 0 && s[0].ready { ch_step(s); } }
// The core answered APP_GUEST with this body (the done event's text): the picker's read first, else
// the guest is let go. Then the flow and the chips follow.
chat_guest :: (s: [] ChatPage, body: string) #export_c #effects(all) {
  if s.count < 1 || s[0].core.count < 1 { return; }
  if !app_screens_guest(s[0].sc[..],s[0].core,body) && !es_bridge_guest(s[0].core, s[0].eb[..], s[0].env[..], body, ch_now(s)) { app_guest_done(s[0].core); }
  if s[0].sc[0].history[0].changed {s[0].sc[0].history[0].changed=false;keyed_scroll_set(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"history.viewport"),0);}
  ch_step(s);
}
// The chips' choices per draft, as plain text to keep across launches (es_save), and back (es_restore).
chat_env_save :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 || !s[0].ready { return 0; } return es_save(s[0].env[..], out); }
chat_env_restore :: (s: [] ChatPage, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  if !s[0].ready { ch_init(s); }
  _ := es_restore(s[0].env[..], text); ch_step(s);
}
chat_library_restore :: (s:[]ChatPage,raw:string)->bool #export_c #effects(all) {
 if s.count<1 {return false;}if !s[0].ready {ch_init(s);}
 // Partition changes clear the previous account's overlays even if the new file is corrupt.
 s[0].library[0]=ChatLibrary.{};s[0].sc[0].workspaces[0]=WorkspaceScreen.{};s[0].rename=false;s[0].workspace=false;s[0].target_n=0;s[0].rename_n=0;s[0].search_n=0;s[0].library_filter=0;s[0].thread_menu=false;s[0].thread_details=false;s[0].filter_menu=false;ch_set_focus(s,"");
 return chlib_read(s[0].library[..],raw);
}
chat_library_save :: (s:[]ChatPage,out:[]u8)->int #export_c #effects(all) {if s.count<1 {return -1;}return chlib_write(s[0].library[..],out);}
chat_library_revision :: (s:[]ChatPage)->int #export_c #effects(all) {return ifx s.count<1 then -1 else s[0].library[0].revision;}

// The login draft to keep: a number that changes when it does, and its bytes (0: forget it).
chat_draft_rev :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 || !s[0].ready { return 0; } return lf_draft_rev(s[0].lf[..]); }
chat_draft :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 || !s[0].ready { return 0; } return lf_draft(s[0].lf[..], out); }
// The id of the field that holds the keyboard ("" none: the host hides the keyboard): chat.composer,
// login.email or login.code. Its box in points (x, y, w, h) for a login field.
chat_focus :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_out(out, ch_focus(s)); }
chat_field_box :: (s: [] ChatPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 || app_field_kind(ch_focus(s))<0 { return false; }
  t := [1] ElTable.[ch_rows(s)]; i := elt_find(t[..], ch_focus(s));
  if i < 0 || t[0].rows[i].role!=EL_FIELD { return false; }
  r := t[0].rows[i]; u := ch_u(s);
  out[0] = r.x * u; out[1] = r.y * u; out[2] = r.w * u; out[3] = r.h * u;
  return true;
}
// The content rectangle in points, from the same skin and committed row as
// the painter. SDK adapters add only their editor's own native text insets.
chat_field_text_box :: (s:[]ChatPage,out:[]f32)->bool #export_c #effects(all) {
 if !chat_field_box(s,out) {return false;}k:=noir_phone_skin();u:=ch_u(s);pad:=k.chrome.field_pad*u;
 out[0]+=pad;out[2]-=2*pad;
 if chat_field_kind(s)==4 {out[1]+=pad;out[3]-=2*pad;}
 else {height:=k.body.line*u;out[1]+=(out[3]-height)/2;out[3]=height;}
 return out[2]>0 && out[3]>0;
}
// A login field's value, and its whole value after an edit (false: not taken; show the flow's again).
chat_field_text :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; } f := ch_login_field(ch_focus(s)); l := s[0].lf[..];
  if s[0].sc[0].workspaces[0].open {return ch_out(out,wsc_field(s[0].sc[0].workspaces[..],ch_focus(s)));}
  if ch_focus(s)=="thread.rename" {return ch_out(out,cast(string)s[0].rename_text[0..<s[0].rename_n]);}
  if ch_focus(s)=="history.search" {return ch_out(out,cast(string)s[0].search[0..<s[0].search_n]);}
  if s[0].sc[0].usage[0].open && ch_focus(s)=="usage.label" {return ch_out(out,cast(string)s[0].sc[0].usage[0].label[0..<s[0].sc[0].usage[0].nl]);}
  return ch_out(out, ifx f == LF_FIELD_EMAIL then lf_email(l) else ifx f == LF_FIELD_CODE then lf_code(l) else ps_field(s[0].sc[0].projects[..],ch_focus(s)));
}
chat_set_field :: (s: [] ChatPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; } f := ch_login_field(ch_focus(s));
  if s[0].sc[0].workspaces[0].open {return wsc_edit(s[0].sc[0].workspaces[..],ch_focus(s),text);}
  if ch_focus(s)=="thread.rename" {if !chlib_title(text) {return false;}s[0].rename_n=el_copy(s[0].rename_text[..],text);s[0].library_note=false;return true;}
  if ch_focus(s)=="history.search" {if text.count>s[0].search.count {return false;}s[0].search_n=el_copy(s[0].search[..],text);ch_step(s);keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"history.viewport"),0);return true;}
  if s[0].sc[0].usage[0].open && ch_focus(s)=="usage.label" {n:=pa_copy(s[0].sc[0].usage[0].label[..],text);if n<0 {return false;}s[0].sc[0].usage[0].nl=n;return true;}
  if s[0].section==1 && ps_editing(ch_focus(s)) {return ps_edit(s[0].sc[0].projects[..],ch_focus(s),text);}
  return f != LF_FIELD_NONE && lf_set(s[0].lf[..], f, text);
}
// Return in a login field: the card's step action.
chat_submit :: (s: [] ChatPage) -> bool #export_c #effects(all) {
  if s.count>0 && ch_focus(s)=="thread.rename" {return ch_press_action_rename(s);}
  if s.count>0 && ch_focus(s)=="history.search" {ch_set_focus(s,"");return true;}
  if s.count>0 && (s[0].sc[0].workspaces[0].open || ps_editing(ch_focus(s)) || ch_focus(s)=="usage.label") {ch_set_focus(s,"");return true;}
  if s.count < 1 || ch_login_field(ch_focus(s)) == LF_FIELD_NONE { return false; }
  done := lf_submit(s[0].lf[..]); ch_step(s); return done;
}
// KitFieldKind's existing SDK values, plus a multiline platform text view.
chat_field_kind :: (s:[]ChatPage)->int #export_c #effects(all) {
 if s.count<1 {return -1;}id:=ch_focus(s);
 return app_field_kind(id);
}
// The platform editor gave up the keyboard by itself (the keyboard's own dismissal).
chat_blur :: (s: [] ChatPage) #export_c #effects(all) { if s.count > 0 { ch_set_focus(s, ""); } }
// A presence fact, never private text. The platform editor owns the private bytes.
chat_secret_ready :: (s:[]ChatPage,ready:bool) #export_c #effects(all) {if s.count>0 {if s[0].sc[0].usage[0].open {s[0].sc[0].usage[0].code_ready=ready;}else {s[0].sc[0].identity[0].secret_ready=ready;}}}
chat_private_mode :: (s:[]ChatPage)->int #export_c #effects(all) {
 if s.count<1 {return 0;}
 if s[0].sc[0].usage[0].open {return ifx cast(string)s[0].sc[0].usage[0].flow[0].state[0..<s[0].sc[0].usage[0].flow[0].ns]=="awaiting_code" then 3 else 0;}
 if !s[0].sc[0].identity[0].open {return 0;}
 v:=s[0].sc[0].identity[0];return ifx v.backup then 2 else ifx v.confirm==IKS_RESTORE then 1 else 0;
}
ch_scroll_offset :: (s:[]ChatPage)->f32 {
 if s[0].thread_menu || s[0].thread_details || s[0].filter_menu {return keyed_scroll(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"thread.viewport"));}
 if s[0].drawer {return keyed_scroll(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"history.viewport"));}
 if s[0].lf[0].open {return keyed_scroll(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"login.viewport"));}
 if app_screens_nested(s[0].sc[..]) || s[0].renderer {return keyed_scroll(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"));}
 if s[0].sc[0].identity[0].open {return keyed_scroll(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"settings.viewport"));}
 if s[0].section==2 {return keyed_scroll(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"history.viewport"));}
 if s[0].section>0 {return keyed_scroll(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"));}
 return s[0].view[0].list[0].top;
}
ch_scroll_max :: (s:[]ChatPage)->f32 {
 if s[0].thread_menu || s[0].thread_details || s[0].filter_menu {return scroll_max(s[0].menu_content,s[0].menu_viewport);}
 if s[0].drawer {return scroll_max(s[0].history_content,s[0].history_viewport);}
 if s[0].lf[0].open {return scroll_max(s[0].login_content,s[0].login_viewport);}
 if app_screens_nested(s[0].sc[..]) || s[0].renderer {return scroll_max(s[0].section_content,s[0].section_viewport);}
 if s[0].sc[0].identity[0].open {return scroll_max(s[0].settings_content,s[0].settings_viewport);}
 if s[0].section==2 {return scroll_max(s[0].history_content,s[0].history_viewport);}
 if s[0].section>0 {return scroll_max(s[0].section_content,s[0].section_viewport);}
 l:=s[0].view[0].list[0];return scroll_max(l.content,l.viewport);
}
chat_scroll_to :: (s:[]ChatPage,offset:f32) #export_c #effects(all) {
 if s.count<1 || (ch_layer(s)!=0 && !s[0].lf[0].open && !s[0].drawer && !s[0].thread_menu && !s[0].thread_details) {return;}
 value:=ifx offset<0 then 0.0f32 else ifx offset>ch_scroll_max(s) then ch_scroll_max(s) else offset;
 if s[0].thread_menu || s[0].thread_details || s[0].filter_menu {keyed_scroll_set(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"thread.viewport"),value);}
 else if s[0].drawer {keyed_scroll_set(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"history.viewport"),value);}
 else if s[0].lf[0].open {keyed_scroll_set(s[0].keyed[1..<2],keyed_find(s[0].keyed[1..<2],"login.viewport"),value);}
 else if app_screens_nested(s[0].sc[..]) || s[0].renderer {keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),value);}
 else if s[0].sc[0].identity[0].open {keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"settings.viewport"),value);}
 else if s[0].section==2 {keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"history.viewport"),value);}
 else if s[0].section>0 {keyed_scroll_set(s[0].keyed[0..<1],keyed_find(s[0].keyed[0..<1],"section.viewport"),value);}
 else {view_scroll(s[0].view[..],value-ch_scroll_offset(s));}
}
chat_scroll_info :: (s:[]ChatPage,out:[]f32)->bool #export_c #effects(all) {
 if s.count<1 || out.count<3 {return false;}
 out[0]=ifx ch_layer(s)==0 || s[0].lf[0].open || s[0].drawer || s[0].thread_menu || s[0].thread_details || s[0].filter_menu then 1.0f32 else 0.0f32;out[1]=ch_scroll_offset(s)*ch_u(s);out[2]=ch_scroll_max(s)*ch_u(s);return true;
}
chat_native_scroll :: (s:[]ChatPage,on:bool) #export_c #effects(all) {if s.count>0 {s[0].native_scroll=on;}}
chat_action :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } act := s[0].action; s[0].action = CH_ACT_NONE; return act; }
// The draft: the whole text after an edit in the platform editor, and the page's own (a sent draft is cleared).
chat_set_text :: (s: [] ChatPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 || s[0].core.count < 1 { return false; }
  c := s[0].core;
  if text != ch_draft(s) { _ := app_dispatch(c, AppEvent.{kind = EV_ACTION, code = ACT_DRAFT, text = text, mono_ms = c[0].mono_ms, wall_ms = c[0].wall_ms}); }
  return ch_draft(s) == text;
}
chat_text :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_out(out, ch_draft(s)); }
// The text's committed box for the platform editor, in points: x, y, w, h, the first line's inset and a line's height.
chat_editor :: (s: [] ChatPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 6 { return false; }
  t := [1] ElTable.[surface_rows(ch_sf(s, 0))];
  i := elt_find(t[..], "chat.composer");
  if i < 0 { return false; }
  b := s[0].box; u := ch_u(s);
  out[0] = (t[0].rows[i].x + b.text_x) * u; out[1] = (t[0].rows[i].y + b.text_y) * u; out[2] = b.text_w * u; out[3] = b.text_h * u;
  out[4] = b.inset * u; out[5] = b.line * u;
  return true;
}
// How the platform editor is styled, from the skin: the text's size and line (points), then the ink,
// the placeholder's ink and the caret's, each straight RGBA.
chat_style :: (out: [] f32) -> bool #export_c #effects(all) {
  if out.count < 14 { return false; }
  k := noir_phone_skin();
  out[0] = k.body.size * ARCADE_PHONE_SCALE; out[1] = 23;
  out[2] = k.ink.r; out[3] = k.ink.g; out[4] = k.ink.b; out[5] = k.ink.a;
  out[6] = k.faint.r; out[7] = k.faint.g; out[8] = k.faint.b; out[9] = k.faint.a;
  out[10] = k.accent.r; out[11] = k.accent.g; out[12] = k.accent.b; out[13] = k.accent.a;
  return true;
}
// Whether the next frame differs with no input: kit motion.
chat_moving :: (s: [] ChatPage) -> bool #export_c #effects(all) { return s.count > 0 && (!s[0].ready || s[0].render_staged || s[0].again || !s[0].reduced && s[0].moving); }
chat_refused :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].refused; }
chat_access_capacity :: ()->int #export_c #effects(all) {return CH_P_ROWS;}
chat_max_vertices :: () -> int #export_c #effects(all) { return CH_MAX_VERTICES; }
chat_scale :: () -> f32 #export_c #effects(all) { return ARCADE_PHONE_SCALE; }
// The text size the person chose against the default (the host's Dynamic Type), kept to 1 to
// CH_ZOOM_MAX. Returns the size the page draws at; the host rasterizes the atlas at its scale.
chat_text_zoom :: (s: [] ChatPage, zoom: f32) -> f32 #export_c #effects(all) {
  if s.count < 1 { return 1; }
  s[0].reveal_focus=true;
  s[0].zoom = ifx !(zoom > 1) then 1.0f32 else ifx zoom > CH_ZOOM_MAX then CH_ZOOM_MAX else zoom;
  return s[0].zoom;
}

// ---- the system controls the host draws over the page (chat_native)

// The host draws the menu button and the chips' picker as system controls: the page keeps their
// rows and hits and paints neither.
chat_native :: (s: [] ChatPage, on: bool) #export_c #effects(all) { if s.count > 0 { s[0].native = on; } }
// The menu button: x, y, side, the page's push to the right while the sidebar opens (points), then
// 1 when the sidebar is open and 1 when it hides (the login card covers the page).
chat_menu :: (s: [] ChatPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 6 { return false; }
  u := ch_u(s);
  // Settings has no sidebar control (menu_side == 0), but opening its login
  // page still needs the native Back button. Read that committed row directly.
  if s[0].lf[0].open {
    t:=[1]ElTable.[ch_rows(s)];i:=elt_find(t[..],"login.back");if i<0 || !elt_visible(t[..],i).visible {return false;}
    r:=t[0].rows[i];out[0]=r.x*u;out[1]=r.y*u;out[2]=r.w*u;out[3]=0;out[4]=0;out[5]=1;return true;
  }
  if !(s[0].menu_side > 0) {return false;}
  out[0] = s[0].menu_x * u; out[1] = s[0].menu_y * u; out[2] = s[0].menu_side * u;
  out[3] = app_sidebar_shift(s[0].page_w, s[0].share) * u;
  out[4] = ifx s[0].drawer then 1.0f32 else 0.0f32; out[5] = ifx s[0].lf[0].open then 1.0f32 else 0.0f32;
  return true;
}
// The open picker: 0 none, 1 where it runs, 2 the repository.
chat_sheet :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 || !s[0].ready { return 0; } return s[0].env[0].sheet; }
// A committed row's box in points, on either layer (a chip the popover points at).
chat_find :: (s: [] ChatPage, id: string, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 { return false; }
  u := ch_u(s);
  for layer: 0..<2 {
    t := [1] ElTable.[surface_rows(ch_sf(s, layer))]; i := elt_find(t[..], id);
    if i < 0 { continue; }
    r := t[0].rows[i]; out[0] = r.x * u; out[1] = r.y * u; out[2] = r.w * u; out[3] = r.h * u;
    return true;
  }
  return false;
}

// ---- the committed semantic rows, for the accessibility bridge and the driver

chat_rows :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_rows(s).n; }
chat_row_visible :: (s:[]ChatPage,i:int)->bool #export_c #effects(all) {if s.count<1 {return false;}t:=[1]ElTable.[ch_rows(s)];return elt_visible(t[..],i).visible;}
chat_rows_stamp :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].stamp; }
// Row i in points (paint/surface.coax surface_access_row): the part of its box its clips leave,
// its role (components/core/elements.coax EL_*), its state (EL_S_* bits), its parent and its focus place.
chat_row :: (s: [] ChatPage, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return surface_access_row(ch_live(s), i, ch_u(s), out);
}
chat_row_id :: (s: [] ChatPage, i: int, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } t := [1] ElTable.[ch_rows(s)]; return ch_out(out, elt_id(t[..], i)); }
// What a screen reader speaks for row i: its whole text (kit/frame.coax uiframe_say), or its label.
chat_row_label :: (s: [] ChatPage, i: int, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_out(out, surface_say(ch_live(s), i)); }
// The layer the rows are of: 0 the page, 1 what covers it (the sidebar, the login card, the picker).
chat_layer :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 || !s[0].ready { return 0; } return ch_layer(s); }
// VoiceOver's scroll: the transcript a page up (dir 1, toward the latest) or down (-1). True when it moved.
chat_scroll_page :: (s: [] ChatPage, dir: int) -> bool #export_c #effects(all) {
  if s.count<1 || !s[0].ready {return false;}
  if s[0].thread_menu || s[0].thread_details || s[0].filter_menu {before:=ch_scroll_offset(s);chat_scroll_to(s,before+cast(f32)dir*s[0].menu_viewport*0.8);return before!=ch_scroll_offset(s);}
  if s[0].sc[0].identity[0].open || s[0].lf[0].open || s[0].drawer || s[0].section>0 {before:=ch_scroll_offset(s);height:=ifx s[0].drawer then s[0].history_viewport else ifx s[0].lf[0].open then s[0].login_viewport else ifx s[0].sc[0].identity[0].open then s[0].settings_viewport else s[0].section_viewport;chat_scroll_to(s,before+cast(f32)dir*height*0.8);return before!=ch_scroll_offset(s);}
  if ch_layer(s)!=0 || s[0].view[0].viewport<=0 {return false;}
  view_scroll(s[0].view[..], cast(f32) dir * s[0].view[0].viewport * 0.8);
  return true;
}
// Row i's value: what a picker's row says under its name.
chat_row_value :: (s: [] ChatPage, i: int, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } t := [1] ElTable.[ch_rows(s)]; return ch_out(out, elt_value_of(t[..], i)); }
chat_activate :: (s: [] ChatPage, id: string) -> bool #export_c #effects(all) { if s.count < 1 { return false; } return ch_press(s, surface_find(ch_live(s), id)); }
// coax drive: `tree` and `counts` over the same rows. The answer's length, or -1.
chat_drive :: (s: [] ChatPage, op: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  if op == "tree" { return surface_tree(ch_live(s), out); }
  if op == "counts" { l := ch_layer(s); return uiframe_counts(ch_sf(s, l), s[0].keyed[l..<l + 1], out); }
  return -1;
}

// ---------------------------------------------------------------- checks

// The checks' vertex buffer: room for these small pages, a quarter of the host's (compile-time storage is bounded).
CH_TEST_VERTICES :: 40000;
ChOut :: struct { v: [CH_TEST_VERTICES * GP_VERTEX_FLOATS] f32; }
ch_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }
// A 402 by 874 point phone at 3x, logged in or not, reduced motion (one frame settles).
ch_test_frame :: (s: [] ChatPage, o: [] ChOut) -> int { chat_env(s, 59, 34, 0, false, 0, true); return chat_frame(s, o[0].v[..], 1206, 2622, 3, 0.5); }
ch_test_text :: (s: [] ChatPage, text: string) -> int {
  n := 0;
  for layer: 0..<2 { sh := surface_sheet(ch_sf(s, layer)); for i: 0..<sh.no { if sh.over[i].kind == PRIM_TEXT && sh.over[i].text == text { n += 1; } } }
  return n;
}
ch_test_tap :: (s: [] ChatPage, id: string) -> bool {
  i := surface_find(ch_live(s), id); if i < 0 { return false; }
  r := ch_rows(s).rows[i]; x := (r.x + r.w / 2) * s[0].d; y := (r.y + r.h / 2) * s[0].d;
  _ := chat_pointer(s, x, y, 0);
  return chat_pointer(s, x, y, 2);
}

ch_test_has :: (s: [] ChatPage, id: string) -> bool { return surface_find(ch_sf(s, 0), id) >= 0 || surface_find(ch_sf(s, 1), id) >= 0; }

#test "Recents search uses the declared native editor contract and returns to chat without losing its draft" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");_=ch_test_frame(s[..],o[..]);
 #assert chat_set_text(s[..],"Kept draft");#assert chat_activate(s[..],"chat.options");_=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"thread.recents");_=ch_test_frame(s[..],o[..]);
 #assert ch_test_tap(s[..],"history.search");_=ch_test_frame(s[..],o[..]);box:[4]f32;
 #assert chat_field_kind(s[..])==APP_FIELD_PLAIN && chat_field_text_box(s[..],box[..]) && box[2]>0;
 #assert chat_set_field(s[..],"notes") && s[0].search_n==5;#assert chat_submit(s[..]);_=ch_test_frame(s[..],o[..]);
 #assert chat_activate(s[..],"nav.menu");_=ch_test_frame(s[..],o[..]);#assert chat_activate(s[..],"drawer.new");_=ch_test_frame(s[..],o[..]);
 #assert s[0].section==0 && ch_draft(s[..])=="Kept draft" && ch_test_has(s[..],VIEW_COMPOSER_ID);
}

#test "a long chat scrolls through the phone's scroll view: back to its first message and down to its last" #steps 8000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");
 raw:[16384]u8;j:[1]Jo;jo_start(j[..],raw[..]);
 jo_put(j[..],"{\"schema\":\"openagents.chat.conversation.v2alpha1\",\"id\":\"cnv_0123456789abcdef0123456789abcdef\",\"revision\":2,\"project_id\":null,\"legacy_thread_id\":null,\"legacy_thread_revision\":null,\"messages\":[");
 for k:0..<24 {if k>0 {jo_put(j[..],",");}jo_put(j[..],"{\"id\":\"cnv_0123456789abcdef0123456789abcdef.legacy.");jo_int(j[..],k);jo_put(j[..],"\",\"turn_id\":\"\",\"role\":\"");jo_put(j[..],ifx k%2==0 then "user" else "assistant");jo_put(j[..],"\",\"content\":[{\"type\":\"text\",\"text\":\"Line ");jo_int(j[..],k);jo_put(j[..],"\"}],\"created_at_ms\":10}");}
 jo_put(j[..],"],\"active_turn_id\":null,\"created_at_ms\":1,\"updated_at_ms\":10,\"next_cursor\":null}");
 d:=c[0].chat[..];d[0].id_n=el_copy(d[0].id[..],"cnv_0123456789abcdef0123456789abcdef");#assert ctr_history_read(jo_text(j[..]),d[0].history[..]);d[0].loaded=true;
 chat_native_scroll(s[..],true);chat_env(s[..],59,34,0,false,0,true);_=chat_frame(s[..],o[0].v[..],1206,2622,3,0);_=chat_frame(s[..],o[0].v[..],1206,2622,3,0);
 // the host's UIScrollView reads this: scrolling on, at the end, with room above
 f:[3]f32;#assert chat_scroll_info(s[..],f[..]) && f[0]==1 && f[2]>0 && f[1]==f[2];
 #assert ch_test_has(s[..],"m.legacy.23") && !ch_test_has(s[..],"m.legacy.0");
 // drags to the top (the scroll view's offset 0; rows above are measured as they come into view)
 // reach the first message
 for k:0..<4 {chat_scroll_to(s[..],0);_=chat_frame(s[..],o[0].v[..],1206,2622,3,0);}
 #assert chat_scroll_info(s[..],f[..]) && f[1]==0 && ch_test_has(s[..],"m.legacy.0") && !ch_test_has(s[..],"m.legacy.23");
 // and back to the bottom shows the last
 for k:0..<4 {chat_scroll_to(s[..],ch_scroll_max(s[..]));_=chat_frame(s[..],o[0].v[..],1206,2622,3,0);}
 #assert ch_test_has(s[..],"m.legacy.23");
}

#test "conversation options scroll on a small phone at maximum text size" #steps 2000000000 {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;app_init(c[..]);ch_test_atlas(s[0].atlas[..]);chat_attach(s[..],c[..],"");c[0].chat[0].id_n=el_copy(c[0].chat[0].id[..],"cnv_0123456789abcdef0123456789abcdef");c[0].chat[0].loaded=true;_=chat_text_zoom(s[..],CH_ZOOM_MAX);
 chat_env(s[..],20,20,0,false,0,true);_=chat_frame(s[..],o[0].v[..],960,1704,3,0);#assert chat_activate(s[..],"chat.options");
 _=chat_frame(s[..],o[0].v[..],960,1704,3,0);#assert ch_scroll_max(s[..])>0 && s[0].menu_viewport>0;
 chat_scroll_to(s[..],ch_scroll_max(s[..]));_=chat_frame(s[..],o[0].v[..],960,1704,3,0);
 #assert ch_test_has(s[..],"thread.workspace") && !ch_test_has(s[..],"thread.feedback");
 chat_scroll_to(s[..],3*noir_phone_skin().control_h);_=chat_frame(s[..],o[0].v[..],960,1704,3,0);
 #assert ch_test_tap(s[..],"thread.rename.open") && s[0].rename && chat_refused(s[..])==0;
}

#test "chat page: the menu button opens the drawer; the scrim and a swipe close it; logged out it holds Log in, which pushes the login page; Back and a swipe go back; a tap outside a field takes the keyboard" #steps 2000000000 {
  s: [1] ChatPage; o: [1] ChOut; ch_test_atlas(s[0].atlas[..]);
  _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "nav.menu") && !ch_test_has(s[..], "drawer") && !ch_test_has(s[..], "drawer.login");
  #assert ch_test_tap(s[..], "nav.menu") && s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  // before the host says who is logged in, neither Log in nor Log out shows
  #assert ch_test_has(s[..], "drawer") && ch_test_has(s[..], "drawer.scrim") && !ch_test_has(s[..], "drawer.login") && !ch_test_has(s[..], "drawer.logout") && chat_refused(s[..]) == 0;
  // the desktop's sidebar: New chat, Search, the "Local" row and its gear; no Chat row, no Projects or Foreman
  #assert ch_test_has(s[..], "drawer.new") && ch_test_has(s[..], "drawer.search") && ch_test_has(s[..], "drawer.me") && ch_test_has(s[..], "drawer.me.settings") && ch_test_text(s[..], "Local") == 1;
  #assert !ch_test_has(s[..], "drawer.chat") && !ch_test_has(s[..], "drawer.projects") && !ch_test_has(s[..], "drawer.foreman") && !ch_test_has(s[..], "drawer.settings");
  #assert ch_test_tap(s[..], "drawer.scrim") && !s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_has(s[..], "drawer");
  // a swipe right from the left edge opens it, a swipe left closes it
  _ := chat_pointer(s[..], 3, 900, 0); _ := chat_pointer(s[..], 200, 900, 1); _ := chat_pointer(s[..], 200, 900, 2);
  #assert s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  _ := chat_pointer(s[..], 600, 900, 0); _ := chat_pointer(s[..], 300, 900, 1); _ := chat_pointer(s[..], 300, 900, 2);
  #assert !s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  // logged out with Experimental features off, there is no Log in anywhere
  lf_t_out(s[0].lf[..]);   // the host answered: nobody is logged in
  #assert chat_activate(s[..], "nav.menu"); _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_has(s[..], "drawer.login") && !chat_activate(s[..], "drawer.login");
  #assert chat_activate(s[..], "drawer.scrim"); _ := ch_test_frame(s[..], o[..]);
  // with them on, the drawer holds Log in; it closes the drawer and pushes the login page
  chat_experimental_set(s[..], true);
  #assert chat_activate(s[..], "nav.menu"); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "drawer.projects") && ch_test_has(s[..], "drawer.foreman");
  #assert ch_test_has(s[..], "drawer.login") && !ch_test_has(s[..], "drawer.logout");
  #assert ch_test_tap(s[..], "drawer.login") && !s[0].drawer && s[0].lf[0].open; _ := ch_test_frame(s[..], o[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "login.page") && ch_test_has(s[..], "login.back") && ch_test_has(s[..], "login.email") && ch_test_has(s[..], "login.send") && !ch_test_has(s[..], "drawer");
  // the menu button hides while the page shows: Back stands where it was
  m: [6] f32; #assert chat_menu(s[..], m[..]) && m[5] == 1;
  // a press on the email field gives it the keyboard; the host reads its box and sets its value
  #assert ch_test_tap(s[..], "login.email"); _ := ch_test_frame(s[..], o[..]);
  id: [EL_ID] u8; n := chat_focus(s[..], id[..]); #assert cast(string) id[0..<n] == "login.email" && s[0].lf[0].focus == LF_FIELD_EMAIL;
  box: [4] f32; #assert chat_field_box(s[..], box[..]) && box[2] > 100;
  #assert chat_set_field(s[..], "a@b.test") && lf_email(s[0].lf[..]) == "a@b.test" && chat_draft_rev(s[..]) > 0;
  // a tap outside the field takes the keyboard away
  _ := chat_pointer(s[..], 600, 2000, 0); _ := chat_pointer(s[..], 600, 2000, 2); _ := ch_test_frame(s[..], o[..]);
  #assert chat_focus(s[..], id[..]) == 0 && s[0].lf[0].focus == LF_FIELD_NONE;
  // Back goes back to the chat
  #assert ch_test_tap(s[..], "login.back") && !s[0].lf[0].open; _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_has(s[..], "login.page") && ch_test_has(s[..], "nav.menu");
  // so does a swipe right from the left edge, and Cancel
  lf_open(s[0].lf[..]); ch_step(s[..]); _ := ch_test_frame(s[..], o[..]);
  _ := chat_pointer(s[..], 3, 900, 0); _ := chat_pointer(s[..], 200, 900, 1); _ := chat_pointer(s[..], 200, 900, 2);
  #assert !s[0].lf[0].open && !s[0].drawer; _ := ch_test_frame(s[..], o[..]);
  lf_open(s[0].lf[..]); ch_step(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_tap(s[..], "login.cancel") && !s[0].lf[0].open; _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_has(s[..], "login.page");
  // logged in: the drawer has the account and Log out, with no Log in
  lf_in(s[0].lf[..], "ada@example.com");
  #assert chat_activate(s[..], "nav.menu"); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "drawer.me") && ch_test_has(s[..], "drawer.logout") && !ch_test_has(s[..], "drawer.login") && ch_test_text(s[..], "A") == 1;
}

