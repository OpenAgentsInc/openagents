// The OpenAgents iOS chat page (components/gpu-components.md; GitHub #13645):
// the whole screen, compiled Coax drawn by the shared GPU kit in one Metal
// view. For now it is a title over the composer. Nothing here runs in
// JavaScript and nothing is a platform control except the composer's editor
// while it holds the keyboard.
//
// Send does nothing yet: the page makes no chat request and has no
// transcript and no login. The native host (host.c, App.swift) owns the GPU
// surface and the keyboard: each frame it gives the window's facts
// (chat_env) and asks for the vertices (chat_frame), and it places the
// platform editor over the composer's text while it holds the keyboard,
// sending back the whole draft on each edit.
//   coax/bin/coax test apps/openagents-ios/chat.coax

#load "../../components/kit/composer.coax";
#load "../../components/core/edit.coax";
#load "../../components/skin/arcade.coax";
#load "../../components/backend/gpu.coax";

CH_MAX_VERTICES :: 40000;
// The surface's declared capacity, a generation: primitives, runs of text, selectable lines, hits,
// pooled bytes and semantic rows. Then keyed ids.
CH_UNDER :: 256; CH_OVER :: 1024; CH_LINES :: 256; CH_HITS :: 8; CH_POOL :: 4096; CH_ROWS :: 16; CH_KEYED :: 8;
CH_ACT_NONE :: 0; CH_ACT_FOCUS :: 1;
CH_HIT_TEXT :: 1; CH_HIT_SEND :: 2;

ChGeneration :: struct { under: [CH_UNDER] Prim; over: [CH_OVER] Prim; lines: [CH_LINES] SheetLine; hits: [CH_HITS] SheetHit; pool: [CH_POOL] u8; rows: [CH_ROWS] El; }
ChatPage :: struct {
  ready: bool; time: f32; d: f32;
  atlas: [1] Atlas;
  gen: [2] ChGeneration; surface: [1] UiSurface;
  keys: [CH_KEYED] Keyed; keyed: [1] KeyedStore;
  draft: [1] EditBuf;
  // the window's facts, in points; the platform editor
  safe_top: f32; safe_bottom: f32; keyboard: f32; focused: bool; editor_h: f32; reduced: bool;
  px: f32; py: f32; touching: bool; pressed: [EL_ID] u8; pressed_n: int;
  action: int;
  box: ComposerBox; stamp: int; moving: bool; refused: int;
}

ch_init :: (s: [] ChatPage) {
  s[0].ready = true;
  g := s[0].gen[..];
  s[0].surface[0] = surface_over(
    Sheet.{under = g[0].under[..], over = g[0].over[..], lines = g[0].lines[..], hits = g[0].hits[..], pool = g[0].pool[..]}, g[0].rows[..],
    Sheet.{under = g[1].under[..], over = g[1].over[..], lines = g[1].lines[..], hits = g[1].hits[..], pool = g[1].pool[..]}, g[1].rows[..]);
  s[0].keyed[0] = KeyedStore.{rows = s[0].keys[..]};
}
ch_out :: (out: [] u8, text: string) -> int {
  n := 0;
  for c: text { if n >= out.count { break; } out[n] = c; n += 1; }
  return n;
}
ch_draft :: (s: [] ChatPage) -> string { return eb_text(s[0].draft[..]); }
ch_rows :: (s: [] ChatPage) -> ElTable { return surface_rows(s[0].surface[..]); }

ch_layout :: (s: [] ChatPage, f: [] UiFrame, w: f32, h: f32) {
  k := f[0].skin; m := f[0].m;
  u: f32 = ARCADE_PHONE_SCALE;
  // the composer docks over the keyboard (or the safe area)
  under := ifx s[0].keyboard > s[0].safe_bottom then s[0].keyboard else s[0].safe_bottom;
  look := ComposerLook.{placeholder = "Message", text = ch_draft(s), editing = s[0].focused, editor_h = s[0].editor_h / u, enabled = ch_draft(s).count > 0, unit = u};
  bottom := h - under / u - 6 / u;
  s[0].box = ctx_composer(f, "chat.composer", "chat.composer.send", 10 / u, bottom, w - 20 / u, look, CH_HIT_TEXT, CH_HIT_SEND);
  // a plain title in the middle of the canvas above it
  top := s[0].safe_top / u; view_h := bottom - s[0].box.height - k.space - top;
  title := "OpenAgents"; tw := measure_width(m, k.title.face, title);
  ty := top + (view_h - k.title.line) / 2;
  if ty >= top {
    _ := sheet_text(f[0].sheet, m, -1, (w - tw) / 2, ty, k.title.line, k.title.face, k.ink, title);
    _ := uiframe_semantic(f, "chat.title", EL_HEADING, title, (w - tw) / 2, ty, tw, k.title.line, 0, 0);
  }
}
ch_stamp :: (s: [] ChatPage) -> int {
  t := [1] ElTable.[ch_rows(s)];
  st := 17;
  for i: 0..<t[0].n {
    r := t[0].rows[i];
    for c: elt_id(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    for c: elt_label(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    for c: elt_value_of(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    st = (st * 31 + r.state) & 0x3fffffff;
    st = (st * 31 + el_round(r.x) + 7 * el_round(r.y) + 13 * el_round(r.w) + 17 * el_round(r.h)) & 0x3fffffff;
  }
  return st;
}
// A press on a committed row. Send does nothing yet.
ch_press :: (s: [] ChatPage, row: int) -> bool {
  if surface_action(s[0].surface[..], row) == CH_HIT_TEXT { s[0].action = CH_ACT_FOCUS; return true; }
  return false;
}

// ---------------------------------------------------------------- the host's calls

// The window's facts in points, the platform editor (whether it holds the keyboard and its own text
// height) and reduced motion.
chat_env :: (s: [] ChatPage, safe_top: f32, safe_bottom: f32, keyboard: f32, focused: bool, editor_height: f32, reduced: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].safe_top = ifx safe_top > 0 then safe_top else 0.0f32; s[0].safe_bottom = ifx safe_bottom > 0 then safe_bottom else 0.0f32;
  s[0].keyboard = ifx keyboard > 0 then keyboard else 0.0f32; s[0].focused = focused;
  s[0].editor_h = ifx focused && editor_height > 0 then editor_height else 0.0f32; s[0].reduced = reduced;
}
// One frame of width by height device pixels. Returns the vertex count.
chat_frame :: (s: [] ChatPage, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  if !s[0].ready { ch_init(s); }
  a := s[0].atlas[..];
  d := (ifx dpr < 1 then 1.0f32 else dpr) * ARCADE_PHONE_SCALE;
  w := width / d; h := height / d;
  s[0].d = d;
  t := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  if !s[0].reduced { s[0].time += t; }
  a[0].frame += 1;
  k := arcade_phone_skin();
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas);
  if !a[0].ready { return v; }
  f: [1] UiFrame;
  input := uiinput(s[0].px, s[0].py, s[0].touching, s[0].touching, cast(string) s[0].pressed[0..<s[0].pressed_n], ifx s[0].focused then "chat.composer" else "");
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(a), k, input, s[0].time, t, s[0].reduced, false);
  ch_layout(s, f[..], w, h);
  s[0].moving = uiframe_moving(f[..]);
  if !uiframe_end(f[..], s[0].surface[..]) { s[0].refused += 1; }
  s[0].stamp = ch_stamp(s);
  sh := surface_sheet(s[0].surface[..]);
  v = gpu_draw(out, v, a, d, sh.under[0..<sh.nu], 0, 0, -8, h + 8);
  v = gpu_draw(out, v, a, d, sh.over[0..<sh.no], 0, 0, -8, h + 8);
  gpu_monochrome(out, v);
  return v;
}
// A touch, in device pixels: phase 0 down, 1 moved, 2 up, 3 cancelled. A press is routed through the committed rows.
chat_pointer :: (s: [] ChatPage, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return false; }
  ux := x / s[0].d; uy := y / s[0].d;
  row := surface_hit(s[0].surface[..], ux, uy);
  id := surface_id(s[0].surface[..], row);
  was := cast(string) s[0].pressed[0..<s[0].pressed_n];
  s[0].px = ux; s[0].py = uy;
  if phase == 0 { s[0].touching = true; s[0].pressed_n = ifx surface_action(s[0].surface[..], row) != 0 then el_copy(s[0].pressed[..], id) else 0; return true; }
  if phase == 1 { if was != id { s[0].pressed_n = 0; } return true; }
  held := s[0].pressed_n > 0 && was == id;
  s[0].touching = false; s[0].pressed_n = 0;
  return phase == 2 && held && ch_press(s, row);
}
chat_action :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } act := s[0].action; s[0].action = CH_ACT_NONE; return act; }
// The draft: the whole text after an edit in the platform editor, and the page's own (a sent draft is cleared).
chat_set_text :: (s: [] ChatPage, text: string) -> bool #export_c #effects(all) {
  if s.count < 1 || text.count > EB_TEXT { return false; }
  if text != ch_draft(s) { eb_set(s[0].draft[..], text); }
  return true;
}
chat_text :: (s: [] ChatPage, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_out(out, ch_draft(s)); }
// The text's committed box for the platform editor, in points: x, y, w, h, the first line's inset and a line's height.
chat_editor :: (s: [] ChatPage, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 6 { return false; }
  t := [1] ElTable.[ch_rows(s)];
  i := elt_find(t[..], "chat.composer");
  if i < 0 { return false; }
  b := s[0].box; u: f32 = ARCADE_PHONE_SCALE;
  out[0] = (t[0].rows[i].x + b.text_x) * u; out[1] = (t[0].rows[i].y + b.text_y) * u; out[2] = b.text_w * u; out[3] = b.text_h * u;
  out[4] = b.inset * u; out[5] = b.line * u;
  return true;
}
// How the platform editor is styled, from the skin: the text's size and line (points), then the ink,
// the placeholder's ink and the caret's, each straight RGBA.
chat_style :: (out: [] f32) -> bool #export_c #effects(all) {
  if out.count < 14 { return false; }
  k := arcade_phone_skin();
  out[0] = k.body.size * ARCADE_PHONE_SCALE; out[1] = 23;
  out[2] = k.ink.r; out[3] = k.ink.g; out[4] = k.ink.b; out[5] = k.ink.a;
  out[6] = k.faint.r; out[7] = k.faint.g; out[8] = k.faint.b; out[9] = k.faint.a;
  out[10] = k.accent.r; out[11] = k.accent.g; out[12] = k.accent.b; out[13] = k.accent.a;
  return true;
}
// Whether the next frame differs with no input: kit motion.
chat_moving :: (s: [] ChatPage) -> bool #export_c #effects(all) { return s.count > 0 && (!s[0].ready || !s[0].reduced && s[0].moving); }
chat_refused :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].refused; }
chat_max_vertices :: () -> int #export_c #effects(all) { return CH_MAX_VERTICES; }
chat_scale :: () -> f32 #export_c #effects(all) { return ARCADE_PHONE_SCALE; }

// ---- the committed semantic rows, for the accessibility bridge and the driver

chat_rows :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return ch_rows(s).n; }
chat_rows_stamp :: (s: [] ChatPage) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].stamp; }
// Row i: its box in points, its role (components/core/elements.coax EL_*), its state (EL_S_* bits) and its parent.
chat_row :: (s: [] ChatPage, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 7 { return false; }
  t := [1] ElTable.[ch_rows(s)];
  if !elt_ok(t[..], i) { return false; }
  r := t[0].rows[i]; u: f32 = ARCADE_PHONE_SCALE;
  out[0] = r.x * u; out[1] = r.y * u; out[2] = r.w * u; out[3] = r.h * u;
  out[4] = cast(f32) r.role; out[5] = cast(f32) r.state; out[6] = cast(f32) r.parent;
  return true;
}
chat_row_id :: (s: [] ChatPage, i: int, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } t := [1] ElTable.[ch_rows(s)]; return ch_out(out, elt_id(t[..], i)); }
chat_row_label :: (s: [] ChatPage, i: int, out: [] u8) -> int #export_c #effects(all) { if s.count < 1 { return 0; } t := [1] ElTable.[ch_rows(s)]; return ch_out(out, elt_label(t[..], i)); }
chat_activate :: (s: [] ChatPage, id: string) -> bool #export_c #effects(all) { if s.count < 1 { return false; } return ch_press(s, surface_find(s[0].surface[..], id)); }
// coax drive: `tree` and `counts` over the same rows. The answer's length, or -1.
chat_drive :: (s: [] ChatPage, op: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  if op == "tree" { return surface_tree(s[0].surface[..], out); }
  if op == "counts" { return uiframe_counts(s[0].surface[..], s[0].keyed[..], out); }
  return -1;
}

// ---------------------------------------------------------------- checks

ChOut :: struct { v: [CH_MAX_VERTICES * GP_VERTEX_FLOATS] f32; }
ch_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }
// A 402 by 874 point phone at 3x, logged in or not, reduced motion (one frame settles).
ch_test_frame :: (s: [] ChatPage, o: [] ChOut) -> int { chat_env(s, 59, 34, 0, false, 0, true); return chat_frame(s, o[0].v[..], 1206, 2622, 3, 0.5); }
ch_test_text :: (s: [] ChatPage, text: string) -> int {
  sh := surface_sheet(s[0].surface[..]); n := 0;
  for i: 0..<sh.no { if sh.over[i].kind == PRIM_TEXT && sh.over[i].text == text { n += 1; } }
  return n;
}
ch_test_tap :: (s: [] ChatPage, id: string) -> bool {
  i := surface_find(s[0].surface[..], id); if i < 0 { return false; }
  r := ch_rows(s).rows[i]; x := (r.x + r.w / 2) * s[0].d; y := (r.y + r.h / 2) * s[0].d;
  _ := chat_pointer(s, x, y, 0);
  return chat_pointer(s, x, y, 2);
}

#test "chat page: it shows its title and the composer, the text asks for the keyboard, the draft is kept, and Send does nothing" #steps 2000000000 {
  s: [1] ChatPage; o: [1] ChOut; ch_test_atlas(s[0].atlas[..]);
  n := ch_test_frame(s[..], o[..]);
  #assert n > 0 && ch_test_text(s[..], "OpenAgents") == 1 && ch_test_text(s[..], "Message") == 1 && chat_refused(s[..]) == 0;
  #assert surface_find(s[0].surface[..], "chat.composer") >= 0 && surface_find(s[0].surface[..], "chat.composer.send") >= 0 && surface_find(s[0].surface[..], "chat.title") >= 0;
  #assert ch_test_tap(s[..], "chat.composer") && chat_action(s[..]) == CH_ACT_FOCUS && chat_action(s[..]) == CH_ACT_NONE;
  #assert chat_set_text(s[..], "Hello\nthere"); _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_tap(s[..], "chat.composer.send") && !chat_activate(s[..], "chat.composer.send") && ch_draft(s[..]) == "Hello\nthere";
  text: [64] u8; #assert chat_text(s[..], text[..]) == 11;
  box: [6] f32; #assert chat_editor(s[..], box[..]) && box[2] > 300 && abs(box[5] - 23) < 0.01;
  // every vertex is grey, and a still page draws the same frame again
  a: [1] ChOut; n = ch_test_frame(s[..], a[..]); m := ch_test_frame(s[..], o[..]);
  #assert n == m && !chat_moving(s[..]);
  for i: 0..<n { at := i * GP_VERTEX_FLOATS; #assert a[0].v[at + 12] == a[0].v[at + 13] && a[0].v[at + 13] == a[0].v[at + 14] && a[0].v[at] == o[0].v[at]; }
}
