  s: [1] ChatPage; o: [1] ChOut; ch_test_atlas(s[0].atlas[..]);
  core: [1] AppCore; app_init(core[..]); chat_attach(s[..], core[..], "");
  core[0].auth = AUTH_IN; chat_step(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert chat_activate(s[..], "nav.menu"); _ := ch_test_frame(s[..], o[..]); #assert chat_activate(s[..], "drawer.me.settings"); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "settings.back") && ch_test_has(s[..], "usage.open") && ch_test_has(s[..], "settings.experimental") && ch_test_text(s[..], "Experimental features") == 1;
  #assert !ch_test_has(s[..], "settings.login") && ch_test_text(s[..], "Nostr keys") == 0 && !ch_test_has(s[..], "renderer.open") && !chat_activate(s[..], "settings.login");
  #assert chat_activate(s[..], "settings.experimental") && chat_experimental(s[..]) && !core[0].local_only; _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_text(s[..], "Nostr keys") == 1 && ch_test_has(s[..], "settings.experimental");
  #assert chat_activate(s[..], "settings.experimental") && !chat_experimental(s[..]) && core[0].local_only; _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_text(s[..], "Nostr keys") == 0 && ch_test_text(s[..], "Settings") == 1;
}
chat_transparency :: (s:[]ChatPage,reduced:bool) #export_c #effects(all) {if s.count>0 {s[0].reduced_transparency=reduced;}}
// Experimental features on or off (the host reads experimentalFeatures at launch, and keeps what
// chat_experimental says after a change). Off leaves the pages that need them and closes login.
chat_experimental_set :: (s:[]ChatPage,on:bool) #export_c #effects(all) {
 if s.count<1 || s[0].experimental==on {return;}
 s[0].experimental=on;
 if !on {if s[0].section==1 {s[0].section=0;s[0].sc[0].projects[0].open=false;}s[0].sc[0].foreman[0].open=false;if s[0].lf[0].open {_:=ch_login_close(s);}}
 ch_step(s);s[0].again=true;
}
chat_experimental :: (s:[]ChatPage)->bool #export_c #effects(all) {return s.count>0 && s[0].experimental;}

#load "chat-library-checks.coax" #test;

chat_library_sync_restore :: (s:[]ChatPage,raw:string)->bool #export_c #effects(all) {return cls_state_read(s[0].library_sync[..],s[0].library[..],raw);}
chat_library_sync_save :: (s:[]ChatPage,out:[]u8)->int #export_c #effects(all) {return cls_state_write(s[0].library_sync[..],s[0].library[..],out);}
chat_library_sync_request :: (s:[]ChatPage,command:string,out:[]u8)->int #export_c #effects(all) {return cls_request(s[0].library_sync[..],s[0].library[..],command,out);}
chat_library_sync_answer :: (s:[]ChatPage,status:int,raw:string)->bool #export_c #effects(all) {return cls_answer(s[0].library_sync[..],s[0].library[..],status,raw);}
