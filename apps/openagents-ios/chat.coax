#test "chat page: the shared chat page over the core: the empty title and the composer, the text asks for the keyboard, the draft is the core's" #steps 2000000000 {
  s: [1] ChatPage; o: [1] ChOut; ch_test_atlas(s[0].atlas[..]);
  core: [1] AppCore; app_init(core[..]);
  chat_attach(s[..], core[..], "");
  n := ch_test_frame(s[..], o[..]);
  #assert n > 0 && ch_test_text(s[..], "Let's build") == 1 && ch_test_text(s[..], "Message") == 1 && chat_refused(s[..]) == 0;
  #assert ch_test_has(s[..], "chat.composer") && ch_test_has(s[..], "chat.composer.send") && ch_test_has(s[..], "chat.empty") && ch_test_has(s[..], "nav.menu");
  #assert ch_test_tap(s[..], "chat.composer") && chat_action(s[..]) == CH_ACT_FOCUS && chat_action(s[..]) == CH_ACT_NONE;
  id: [EL_ID] u8; k := chat_focus(s[..], id[..]); #assert cast(string) id[0..<k] == "chat.composer";
  #assert chat_set_text(s[..], "Hello\nthere") && app_draft(core[..]) == "Hello\nthere"; _ := ch_test_frame(s[..], o[..]);
  text: [64] u8; #assert chat_text(s[..], text[..]) == 11;
  box: [6] f32; #assert chat_editor(s[..], box[..]) && box[2] > 300;
  // a drag on the page scrolls instead of pressing
  _ := chat_pointer(s[..], 600, 1200, 0); _ := chat_pointer(s[..], 600, 1000, 1); #assert s[0].scrolling && s[0].pressed_n == 0; _ := chat_pointer(s[..], 600, 1000, 2);
  // a still page draws the same frame again, every vertex grey
  a: [1] ChOut; n = ch_test_frame(s[..], a[..]); m := ch_test_frame(s[..], o[..]);
  #assert n == m && !chat_moving(s[..]);
  for i: 0..<n { at := i * GP_VERTEX_FLOATS; #assert a[0].v[at + 12] == a[0].v[at + 13] && a[0].v[at + 13] == a[0].v[at + 14] && a[0].v[at] == o[0].v[at]; }
}

#test "chat page: logged in, the chips sit over the composer; a chip opens its picker, a row chooses and closes it, so do Done and a press beside it" #steps 2000000000 {
  s: [1] ChatPage; o: [1] ChOut; ch_test_atlas(s[0].atlas[..]);
  core: [1] AppCore; app_init(core[..]);
  chat_attach(s[..], core[..], "");
  _ := ch_test_frame(s[..], o[..]);
  #assert !ch_test_has(s[..], "composer.environment");   // logged out: no chips
  chat_experimental_set(s[..], true); core[0].auth = AUTH_IN; chat_step(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "composer.environment") && ch_test_has(s[..], "composer.repo") && ch_test_text(s[..], "Default") == 1;
  // the repository chip takes no press while a request cannot carry a repository
  #assert !ch_test_tap(s[..], "composer.repo") && !ch_picking(s[..]);
  #assert ch_test_tap(s[..], "composer.environment") && ch_picking(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_has(s[..], "env.panel") && ch_test_has(s[..], "env.default") && ch_test_has(s[..], "env.close") && chat_refused(s[..]) == 0;
  // choosing a row closes the picker; so does Done
  #assert ch_test_tap(s[..], "env.default") && !ch_picking(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_tap(s[..], "composer.environment") && ch_picking(s[..]); _ := ch_test_frame(s[..], o[..]);
  #assert ch_test_tap(s[..], "env.close") && !ch_picking(s[..]); _ := ch_test_frame(s[..], o[..]);
  // a press beside the open picker closes it
  #assert ch_test_tap(s[..], "composer.environment") && ch_picking(s[..]); _ := ch_test_frame(s[..], o[..]);
  _ := chat_pointer(s[..], 600, 60, 0); _ := chat_pointer(s[..], 600, 60, 2);
  #assert !ch_picking(s[..]);
  saved: [256] u8; _ := chat_env_save(s[..], saved[..]);
}

