// Chapter 1-3 — OpenAgents mobile (iOS) chat screen.
//
// Thin mobile consumer of the shared chat state, actions, composer surface,
// and transcript surface in `apps/shared/chat/screen.coax`. The primary app
// is `apps/openagents-desktop/chat_screen.coax`; both desktop and iOS execute
// the same shared state transitions, dirty-surface tracking, markdown
// rendering, and scrolling rules.
//
// Verified by:
//   coax/bin/coax test apps/openagents-ios/composer_screen.coax

#load "../shared/chat/screen.coax";

CS_SCALE :: 1.35f32;

// ---------------------------------------------------------------- C host API

composer_env :: (s: [] ComposerScreen, top: f32, bottom: f32, keyboard: f32, reduced_motion: bool, reduced_transparency: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].form_factor = CHAT_FORM_MOBILE;
  if s[0].safe_top != top || s[0].safe_bottom != bottom || s[0].keyboard != keyboard || s[0].reduced_motion != reduced_motion || s[0].reduced_transparency != reduced_transparency {
    s[0].dirty_composer = true;
    s[0].dirty_transcript = true;
  }
  s[0].safe_top = top;
  s[0].safe_bottom = bottom;
  s[0].keyboard = keyboard;
  s[0].reduced_motion = reduced_motion;
  s[0].reduced_transparency = reduced_transparency;
}

composer_screen_frame :: (s: [] ComposerScreen, out: [] f32, px_w: int, px_h: int, scale: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count >= 1 { s[0].form_factor = CHAT_FORM_MOBILE; }
  return cs_render(s, out, px_w, px_h, scale, dt, false);
}

composer_pointer :: (s: [] ComposerScreen, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  return cs_pointer(s, x, y, phase);
}

composer_scroll :: (s: [] ComposerScreen, delta_y: f32) -> bool #export_c #effects(all) {
  return cs_scroll(s, delta_y);
}

composer_focus :: (s: [] ComposerScreen) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return s[0].focused;
}

composer_blur :: (s: [] ComposerScreen) #export_c #effects(all) {
  if s.count < 1 { return; }
  if s[0].focused { s[0].dirty_composer = true; }
  s[0].focused = false;
}

composer_field_rect :: (s: [] ComposerScreen, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 { return false; }
  i := cs_find_composer(s, "composer.input");
  if i < 0 { return false; }
  r := cs_rows(s).rows[i];
  out[0] = r.x * CS_SCALE;
  out[1] = r.y * CS_SCALE;
  out[2] = r.w * CS_SCALE;
  out[3] = r.h * CS_SCALE;
  return true;
}

composer_set_text :: (s: [] ComposerScreen, text: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  _ := cs_dispatch(s, ChatAction.{kind = CS_ACT_EDIT, text = text});
}

composer_text :: (s: [] ComposerScreen, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cs_out(out, cs_draft(s));
}

composer_rows :: (s: [] ComposerScreen) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return cs_trows(s).n + cs_rows(s).n;
}

composer_row_id :: (s: [] ComposerScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  tr := [1] ElTable.[cs_trows(s)];
  if i < tr[0].n { return cs_out(out, elt_id(tr[..], i)); }
  t := [1] ElTable.[cs_rows(s)];
  return cs_out(out, elt_id(t[..], i - tr[0].n));
}

composer_row_label :: (s: [] ComposerScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  tr := [1] ElTable.[cs_trows(s)];
  if i < tr[0].n { return cs_out(out, elt_label(tr[..], i)); }
  t := [1] ElTable.[cs_rows(s)];
  return cs_out(out, elt_label(t[..], i - tr[0].n));
}

composer_row_value :: (s: [] ComposerScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  tr := [1] ElTable.[cs_trows(s)];
  if i < tr[0].n { return cs_out(out, elt_value_of(tr[..], i)); }
  t := [1] ElTable.[cs_rows(s)];
  return cs_out(out, elt_value_of(t[..], i - tr[0].n));
}

composer_row_rect :: (s: [] ComposerScreen, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 4 { return false; }
  tr := cs_trows(s);
  if i >= 0 && i < tr.n {
    r := tr.rows[i];
    out[0] = r.x * CS_SCALE;
    out[1] = r.y * CS_SCALE;
    out[2] = r.w * CS_SCALE;
    out[3] = r.h * CS_SCALE;
    return true;
  }
  ci := i - tr.n;
  t := cs_rows(s);
  if ci < 0 || ci >= t.n { return false; }
  r := t.rows[ci];
  out[0] = r.x * CS_SCALE;
  out[1] = r.y * CS_SCALE;
  out[2] = r.w * CS_SCALE;
  out[3] = r.h * CS_SCALE;
  return true;
}

composer_activate :: (s: [] ComposerScreen, id: string) -> bool #export_c #effects(all) {
  return cs_activate(s, id);
}

composer_refused :: (s: [] ComposerScreen) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  return s[0].surface[0].refused + s[0].transcript[0].refused;
}

composer_needs_redraw :: (s: [] ComposerScreen) -> bool #export_c #effects(all) {
  return cs_dirty(s);
}

composer_drive :: (s: [] ComposerScreen, op: string, out: [] u8) -> int #export_c #effects(all) {
  return cs_drive(s, op, out);
}

// ---------------------------------------------------------------- checks

cs_test_frame :: (s: [] ComposerScreen, o: [] CsOut) -> int {
  return composer_screen_frame(s, o[0].v[..], 1206, 2622, 3, 0.016);
}

cs_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    ok := true;
    for j: 0..<needle.count {
      if hay[i + j] != needle[j] { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

#test "chapter 1 trace: tree, type composer.input hello, state draft, counts" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  composer_env(s[..], 59, 34, 0, true, true);
  n := cs_test_frame(s[..], o[..]);
  #assert n > 0 && composer_rows(s[..]) == 2 && composer_refused(s[..]) == 0;

  buf: [512] u8;
  tn := composer_drive(s[..], "tree", buf[..]);
  tree := cast(string) buf[0..<tn];
  #assert cs_contains(tree, "composer.input field \"Message\"");
  #assert cs_contains(tree, "composer.send button \"Send\"");

  yn := composer_drive(s[..], "type composer.input hello", buf[..]);
  #assert cast(string) buf[0..<yn] == "typed\n";

  sn := composer_drive(s[..], "state draft", buf[..]);
  #assert cast(string) buf[0..<sn] == "hello\n";

  _ := cs_test_frame(s[..], o[..]);
  fi := cs_find(s[..], "composer.input");
  vn := composer_row_value(s[..], fi, buf[..]);
  #assert cast(string) buf[0..<vn] == "hello";
  cn := composer_drive(s[..], "counts", buf[..]);
  counts := cast(string) buf[0..<cn];
  #assert cs_contains(counts, "refused 0");
}

#test "chapter 1 refusal: duplicate composer.input id keeps last committed frame and counts prints refusal" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  composer_env(s[..], 59, 34, 0, true, true);

  composer_set_text(s[..], "keep");
  n1 := cs_test_frame(s[..], o[..]);
  #assert n1 > 0 && s[0].surface[0].generation == 1 && composer_refused(s[..]) == 0;

  composer_set_text(s[..], "dropped");
  _ := cs_render(s[..], o[0].v[..], 1206, 2622, 3, 0.016, true);
  #assert composer_refused(s[..]) == 1 && s[0].surface[0].generation == 1;

  buf: [512] u8;
  #assert composer_rows(s[..]) == 2;
  fi := cs_find(s[..], "composer.input");
  vn := composer_row_value(s[..], fi, buf[..]);
  #assert cast(string) buf[0..<vn] == "keep";

  cn := composer_drive(s[..], "counts", buf[..]);
  counts := cast(string) buf[0..<cn];
  #assert cs_contains(counts, "refused 1");
}

#test "chapter 1 pointer and accessibility activation focus the composer" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  composer_env(s[..], 59, 34, 0, true, true);
  _ := cs_test_frame(s[..], o[..]);
  #assert !composer_focus(s[..]);
  #assert composer_activate(s[..], "composer.input") && composer_focus(s[..]);
  composer_blur(s[..]);
  #assert !composer_focus(s[..]);
  r := cs_rows(s[..]).rows[0];
  x := (r.x + r.w / 2) * s[0].d;
  y := (r.y + r.h / 2) * s[0].d;
  #assert composer_pointer(s[..], x, y, 0);
  #assert composer_pointer(s[..], x, y, 2);
  #assert composer_focus(s[..]);
}

#test "chapter 2 trace and refusal: empty send refused, type + send appends message.1 and clears draft" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  composer_env(s[..], 59, 34, 0, true, true);
  n0 := cs_test_frame(s[..], o[..]);
  #assert n0 > 0 && !composer_needs_redraw(s[..]);
  #assert s[0].surface[0].generation == 1 && s[0].transcript[0].generation == 1;
  #assert !s[0].state[0].send_enabled && s[0].state[0].message_count == 0;

  #assert cs_test_frame(s[..], o[..]) == 0;
  #assert s[0].redraws == 1 && s[0].surface[0].generation == 1 && s[0].transcript[0].generation == 1;

  buf: [1024] u8;
  rn := composer_drive(s[..], "tap composer.send", buf[..]);
  #assert cast(string) buf[0..<rn] == "composer.send can't be pressed now\n";
  #assert s[0].actions_refused == 1 && s[0].action_seq == 0 && s[0].state[0].message_count == 0;
  #assert !composer_needs_redraw(s[..]) && cs_test_frame(s[..], o[..]) == 0;

  tn := composer_drive(s[..], "type composer.input hello", buf[..]);
  #assert cast(string) buf[0..<tn] == "typed\n";
  #assert s[0].state[0].send_enabled && s[0].dirty_composer && !s[0].dirty_transcript;
  n1 := cs_test_frame(s[..], o[..]);
  #assert n1 > 0 && s[0].surface[0].generation == 2 && s[0].transcript[0].generation == 1;
  #assert !composer_needs_redraw(s[..]);

  sn := composer_drive(s[..], "tap composer.send", buf[..]);
  #assert cast(string) buf[0..<sn] == "tapped composer.send\n";
  #assert !s[0].state[0].send_enabled && s[0].dirty_composer && s[0].dirty_transcript;
  n2 := cs_test_frame(s[..], o[..]);
  #assert n2 > 0 && s[0].surface[0].generation == 3 && s[0].transcript[0].generation == 2;
  #assert !composer_needs_redraw(s[..]) && cs_test_frame(s[..], o[..]) == 0;

  mn := composer_drive(s[..], "state messages", buf[..]);
  #assert cast(string) buf[0..<mn] == "you: hello\n";
  dn := composer_drive(s[..], "state draft", buf[..]);
  #assert cast(string) buf[0..<dn] == "\n";
  trn := composer_drive(s[..], "tree", buf[..]);
  tree := cast(string) buf[0..<trn];
  #assert cs_contains(tree, "message.1") && cs_contains(tree, "you: hello");
  #assert cs_contains(tree, "composer.input") && cs_contains(tree, "composer.send");
}

#test "chapter 2 incremental frame and full rebuild commit the same rows" #steps 400000000 {
  inc: [1] ComposerScreen;
  o1: [1] CsOut;
  cs_test_atlas(inc[0].atlas[..]);
  composer_env(inc[..], 59, 34, 0, true, true);
  _ := cs_test_frame(inc[..], o1[..]);

  buf: [1024] u8;
  _ := composer_drive(inc[..], "type composer.input first", buf[..]);
  _ := cs_test_frame(inc[..], o1[..]);
  _ := composer_drive(inc[..], "tap composer.send", buf[..]);
  _ := cs_test_frame(inc[..], o1[..]);
  _ := composer_drive(inc[..], "type composer.input second", buf[..]);
  _ := cs_test_frame(inc[..], o1[..]);
  #assert inc[0].transcript[0].generation == 2 && inc[0].surface[0].generation == 4;

  full: [1] ComposerScreen;
  o2: [1] CsOut;
  cs_test_atlas(full[0].atlas[..]);
  composer_env(full[..], 59, 34, 0, true, true);
  _ := cs_dispatch(full[..], ChatAction.{kind = CS_ACT_EDIT, text = "first"});
  _ := cs_dispatch(full[..], ChatAction.{kind = CS_ACT_SEND});
  _ := cs_dispatch(full[..], ChatAction.{kind = CS_ACT_EDIT, text = "second"});
  _ := cs_test_frame(full[..], o2[..]);
  #assert full[0].transcript[0].generation == 1 && full[0].surface[0].generation == 1;

  b1: [1024] u8;
  b2: [1024] u8;
  n1 := composer_drive(inc[..], "tree", b1[..]);
  n2 := composer_drive(full[..], "tree", b2[..]);
  #assert n1 == n2 && cast(string) b1[0..<n1] == cast(string) b2[0..<n2];
}

#forall "chapter 2: any sequence of refused actions leaves the state equal to its start" seed:0..<64 {
  st: [1] ChatState;
  prior := seed % 4;
  for i: 0..<prior {
    _ := chat_state_apply(st[..], ChatAction.{kind = CS_ACT_EDIT, text = "msg"});
    _ := chat_state_apply(st[..], ChatAction.{kind = CS_ACT_SEND});
  }
  snap := [1] ChatState.[st[0]];
  steps := 1 + ((seed / 4) % 8);
  for k: 0..<steps {
    kind := ifx ((seed + k) % 3) == 0 then CS_ACT_SEND else ifx ((seed + k) % 3) == 1 then 0 else 99;
    res := chat_state_apply(st[..], ChatAction.{kind = kind, text = "ignored"});
    #assert !res.accepted && !res.dirty_composer && !res.dirty_transcript;
  }
  #assert chat_state_equal(st[..], snap[..]);
}

#test "chapter 3 mobile consumer: transcript scrolling and jump-to-bottom share desktop behavior" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  composer_env(s[..], 59, 34, 0, true, true);
  _ := cs_test_frame(s[..], o[..]);

  buf: [1024] u8;
  _ := composer_drive(s[..], "type composer.input hello", buf[..]);
  _ := composer_drive(s[..], "tap composer.send", buf[..]);
  for i: 0..<8 {
    _ := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_APPEND, role = CHAT_ROLE_ASSISTANT, text = "# Reply\n\nMarkdown with **bold** and `code`.\n\n- one\n- two"});
  }
  _ := cs_test_frame(s[..], o[..]);
  #assert s[0].state[0].content_h > s[0].state[0].viewport_h;
  #assert chat_state_pinned(s[0].state[..]);

  sn := composer_drive(s[..], "scroll -150", buf[..]);
  #assert cast(string) buf[0..<sn] == "scrolled\n";
  _ := cs_test_frame(s[..], o[..]);
  pn := composer_drive(s[..], "state pinned", buf[..]);
  #assert cast(string) buf[0..<pn] == "false\n";

  jn := composer_drive(s[..], "tap transcript.jump_bottom", buf[..]);
  #assert cast(string) buf[0..<jn] == "tapped transcript.jump_bottom\n";
  _ := cs_test_frame(s[..], o[..]);
  pn2 := composer_drive(s[..], "state pinned", buf[..]);
  #assert cast(string) buf[0..<pn2] == "true\n";
}
