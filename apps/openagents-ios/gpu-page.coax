// OpenAgents iOS GPU surface: pure-black Coder Noir GPU chat,
// slide-out sidebar (Universal Introspection, Account, Spark Wallet, Tailscale),
// activity trees, Markdown replies, composer & floating pickers.
//   coax/bin/coax test apps/openagents-ios/gpu-page.coax

#load "../../components/skin/noir-phone.coax";
#load "../../components/app/conversation.coax";
#load "../../components/app/sidebar.coax";
#load "../../components/app/activity.coax";
#load "../../components/backend/gpu.coax";

IOS_MAX_VERTICES :: 160000;
IOS_P_UNDER :: 2048; IOS_P_OVER :: 8192; IOS_P_LINES :: 4096; IOS_P_HITS :: 256; IOS_P_POOL :: 262144; IOS_P_ROWS :: 512; IOS_P_KEYED :: 256;
IOS_C_UNDER :: 1024; IOS_C_OVER :: 4096; IOS_C_LINES :: 512;  IOS_C_HITS :: 128; IOS_C_POOL :: 32768;  IOS_C_ROWS :: 128; IOS_C_KEYED :: 96;

IOS_MAX_SESSIONS :: 64;
IOS_MAX_INTRO :: 48;
IOS_MAX_MACHINES :: 16;
IOS_SIDE_CAP :: IOS_MAX_SESSIONS + IOS_MAX_INTRO + IOS_MAX_MACHINES + 24;
IOS_MAX_ITEMS :: 192;
IOS_MAX_MODELS :: 24;
IOS_MAX_EFFORTS :: 8;
IOS_MAX_MODES :: 6;
IOS_MAX_FOLDERS :: 32;
IOS_MAX_SUGGESTIONS :: 8;
IOS_MAX_TODOS :: 16;
IOS_MAX_APPROVAL_OPTS :: 6;
IOS_ITEM_POOL :: 262144;
IOS_DRAFT_CAP :: 16384;
IOS_COPY_CAP :: 16384;
IOS_FOLDS :: 16;
IOS_ACT_MAX :: 48;

IOS_TODO_PENDING :: 0;
IOS_TODO_IN_PROGRESS :: 1;
IOS_TODO_COMPLETED :: 2;

IOS_INTRO_TUI :: 0;
IOS_INTRO_HARNESS :: 1;

IOS_VOICE_OFF :: 0;
IOS_VOICE_LISTENING :: 1;
IOS_VOICE_THINKING :: 2;
IOS_VOICE_SPEAKING :: 3;

IOS_MOVE :: 8.0f32;
IOS_SWIPE :: 30.0f32;
IOS_EDGE :: 20.0f32;
IOS_ZOOM_MAX :: 2.5f32;
IOS_WIDE_BREAKPOINT :: 700.0f32;

