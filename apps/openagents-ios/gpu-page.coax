  s[0].machines[i].name_n = ios_copy(s[0].machines[i].name[..], name);
  s[0].machines[i].detail_n = ios_copy(s[0].machines[i].detail[..], detail);
  s[0].machines[i].reachability = reachability;
  s[0].machines[i].session_count = session_count;
  s[0].machines[i].current = current;
