IOS_HIT_NONE :: 0;
IOS_HIT_SIDEBAR :: 1;
IOS_HIT_SCRIM :: 2;
IOS_HIT_COMPUTERS :: 3;
IOS_HIT_WORKSPACE :: 4;
IOS_HIT_NEW_CHAT :: 5;
IOS_HIT_HUB :: 6;
IOS_HIT_COMPOSER :: 7;
