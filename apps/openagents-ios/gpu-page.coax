IOS_ROLE_ASSISTANT :: 1;
IOS_ROLE_THOUGHT :: 2;
IOS_ROLE_TOOL :: 3;
IOS_ROLE_NOTICE :: 4;

// Reachability states for header & sidebar status dots.
IOS_REACH_UNKNOWN :: 0;
IOS_REACH_CHECKING :: 1;
IOS_REACH_OK :: 2;
IOS_REACH_BAD :: 3;

