  s[0].suggestions_is_mention = is_mention;
}
ios_suggestions_push :: (s: [] IosPhonePage, id: string, label: string, detail: string) #export_c #effects(all) {
  if s.count < 1 || s[0].suggestions_n >= IOS_MAX_SUGGESTIONS { return; }
  i := s[0].suggestions_n;
  s[0].suggestions[i].id_n = ios_copy(s[0].suggestions[i].id[..], id);
  s[0].suggestions[i].label_n = ios_copy(s[0].suggestions[i].label[..], label);
  s[0].suggestions[i].detail_n = ios_copy(s[0].suggestions[i].detail[..], detail);
  s[0].suggestions_n = i + 1;
}
ios_todos_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].todos_n = 0; } }
ios_todos_push :: (s: [] IosPhonePage, content: string, status: int) #export_c #effects(all) {
  if s.count < 1 || s[0].todos_n >= IOS_MAX_TODOS { return; }
  i := s[0].todos_n;
  s[0].todos[i].content_n = ios_copy(s[0].todos[i].content[..], content);
  s[0].todos[i].status = status;
  s[0].todos_n = i + 1;
}
ios_folders_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].folders_n = 0; } }
ios_folders_push :: (s: [] IosPhonePage, path: string, label: string, selected: bool) #export_c #effects(all) {
  if s.count < 1 || s[0].folders_n >= IOS_MAX_FOLDERS { return; }
  i := s[0].folders_n;
  s[0].folders[i].id_n = ios_copy(s[0].folders[i].id[..], path);
  s[0].folders[i].label_n = ios_copy(s[0].folders[i].label[..], label);
  s[0].folders[i].detail_n = ios_copy(s[0].folders[i].detail[..], path);
  s[0].folders[i].selected = selected;
  s[0].folders_n = i + 1;
}
ios_sessions_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].sessions_n = 0; } }
ios_sessions_push :: (s: [] IosPhonePage, id: string, title: string, repo: string, branch: string, status: string, busy: bool, current: bool, attention: bool, unread: bool) #export_c #effects(all) {
  if s.count < 1 || s[0].sessions_n >= IOS_MAX_SESSIONS { return; }
  i := s[0].sessions_n;
  s[0].sessions[i].id_n = ios_copy(s[0].sessions[i].id[..], id);
  s[0].sessions[i].title_n = ios_copy(s[0].sessions[i].title[..], title);
  s[0].sessions[i].repo_n = ios_copy(s[0].sessions[i].repo[..], repo);
  s[0].sessions[i].branch_n = ios_copy(s[0].sessions[i].branch[..], branch);
  s[0].sessions[i].status_n = ios_copy(s[0].sessions[i].status[..], status);
  s[0].sessions[i].ask_n = 0;
  s[0].sessions[i].activity_n = 0;
  s[0].sessions[i].reply_n = 0;
  s[0].sessions[i].busy = busy;
  s[0].sessions[i].current = current;
  s[0].sessions[i].attention = attention;
  s[0].sessions[i].unread = unread;
  s[0].sessions_n = i + 1;
}
ios_session_set_preview :: (s: [] IosPhonePage, id: string, ask: string, activity: string, reply: string) #export_c #effects(all) {
  if s.count < 1 { return; }
  for i: 0..<s[0].sessions_n {
    if cast(string) s[0].sessions[i].id[0..<s[0].sessions[i].id_n] == id {
      s[0].sessions[i].ask_n = ios_copy(s[0].sessions[i].ask[..], ask);
      s[0].sessions[i].activity_n = ios_copy(s[0].sessions[i].activity[..], activity);
      s[0].sessions[i].reply_n = ios_copy(s[0].sessions[i].reply[..], reply);
      return;
    }
  }
}
ios_items_clear :: (s: [] IosPhonePage, reset_scroll: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].items_n = 0;
  s[0].item_pool_n = 0;
  if reset_scroll { s[0].stick_bottom = true; s[0].chat_scroll = 0; s[0].chat_content = 0; }
}
ios_items_push :: (s: [] IosPhonePage, role: int, id: string, text: string, tool: string, path: string, diff: string, complete: bool, failed: bool, is_subagent: bool, diff_cut: bool, subagent_calls: int, elapsed_secs: int) #export_c #effects(all) {
  if s.count < 1 || s[0].items_n >= IOS_MAX_ITEMS { return; }
  i := s[0].items_n;
  at: [1] int; nn: [1] int;
  ios_pool_put(s, id, at[..], nn[..]); s[0].items[i].id_at = at[0]; s[0].items[i].id_n = nn[0];
  ios_pool_put(s, text, at[..], nn[..]); s[0].items[i].text_at = at[0]; s[0].items[i].text_n = nn[0];
  ios_pool_put(s, tool, at[..], nn[..]); s[0].items[i].tool_at = at[0]; s[0].items[i].tool_n = nn[0];
  ios_pool_put(s, path, at[..], nn[..]); s[0].items[i].path_at = at[0]; s[0].items[i].path_n = nn[0];
  ios_pool_put(s, diff, at[..], nn[..]); s[0].items[i].diff_at = at[0]; s[0].items[i].diff_n = nn[0];
  s[0].items[i].role = role;
  s[0].items[i].complete = complete;
  s[0].items[i].failed = failed;
  s[0].items[i].is_subagent = is_subagent;
  s[0].items[i].diff_cut = diff_cut;
  s[0].items[i].subagent_calls = subagent_calls;
  s[0].items[i].elapsed_secs = elapsed_secs;
  s[0].items_n = i + 1;
}
ios_models_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].models_n = 0; } }
ios_models_push :: (s: [] IosPhonePage, id: string, label: string, detail: string, selected: bool) #export_c #effects(all) {
  if s.count < 1 || s[0].models_n >= IOS_MAX_MODELS { return; }
  i := s[0].models_n;
  s[0].models[i].id_n = ios_copy(s[0].models[i].id[..], id);
  s[0].models[i].label_n = ios_copy(s[0].models[i].label[..], label);
  s[0].models[i].detail_n = ios_copy(s[0].models[i].detail[..], detail);
  s[0].models[i].selected = selected;
  s[0].models_n = i + 1;
}
ios_efforts_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].efforts_n = 0; } }
ios_efforts_push :: (s: [] IosPhonePage, id: string, label: string, detail: string, selected: bool) #export_c #effects(all) {
  if s.count < 1 || s[0].efforts_n >= IOS_MAX_EFFORTS { return; }
  i := s[0].efforts_n;
  s[0].efforts[i].id_n = ios_copy(s[0].efforts[i].id[..], id);
  s[0].efforts[i].label_n = ios_copy(s[0].efforts[i].label[..], label);
  s[0].efforts[i].detail_n = ios_copy(s[0].efforts[i].detail[..], detail);
  s[0].efforts[i].selected = selected;
  s[0].efforts_n = i + 1;
}
ios_modes_clear :: (s: [] IosPhonePage) #export_c #effects(all) { if s.count > 0 { s[0].modes_n = 0; } }
ios_modes_push :: (s: [] IosPhonePage, id: string, label: string, detail: string, selected: bool) #export_c #effects(all) {
  if s.count < 1 || s[0].modes_n >= IOS_MAX_MODES { return; }
  i := s[0].modes_n;
  s[0].modes[i].id_n = ios_copy(s[0].modes[i].id[..], id);
  s[0].modes[i].label_n = ios_copy(s[0].modes[i].label[..], label);
  s[0].modes[i].detail_n = ios_copy(s[0].modes[i].detail[..], detail);
  s[0].modes[i].selected = selected;
  s[0].modes_n = i + 1;
}

// ---------------------------------------------------------------- unit checks

IOS_TEST_VERTS :: 40000;
IosTestOut :: struct { v: [IOS_TEST_VERTS * GP_VERTEX_FLOATS] f32; }
ios_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }
ios_test_frame :: (s: [] IosPhonePage, o: [] IosTestOut) -> int {
  ios_env(s, 59, 34, 0, false, 0, true);
  return ios_frame(s, o[0].v[..], 1206, 2622, 3, 0.5f32);
}
ios_test_has :: (s: [] IosPhonePage, id: string) -> bool {
  return surface_find(ios_sf(s, 0), id) >= 0 || surface_find(ios_sf(s, 1), id) >= 0;
}

#test "GPU iOS page renders pure-black empty state, drawer cards, picker, and transcript activity" #steps 2000000000 {
  s: [1] IosPhonePage; o: [1] IosTestOut;
  ios_test_atlas(s[0].atlas[..]);
  ios_set_header(s[..], "Christopher's MacBook Pro", "", "openagents", IOS_REACH_OK, 1, false, false, false);
  ios_set_composer(s[..], "Gemini 4 Neon", "Medium", "Auto", 0, false);
  ios_models_push(s[..], "gemini-4-neon", "Gemini 4 Neon", "Gemini 4 · Default", true);
  ios_models_push(s[..], "gemini-4-carbon", "Gemini 4 Carbon", "Gemini 4 · Coding", false);
  ios_efforts_push(s[..], "medium", "Medium", "Balanced", true);
  ios_modes_push(s[..], "auto", "Auto", "Approve workspace tools automatically", true);
  ios_sessions_push(s[..], "s1", "Fix Metal shader", "openagents", "main", "2m", false, true, false, false);

  v := ios_test_frame(s[..], o[..]);
  #assert v > 0 && s[0].refused == 0;
  #assert ios_test_has(s[..], "nav.sidebar") && ios_test_has(s[..], "nav.computerPill") && ios_test_has(s[..], "chat.composer") && ios_test_has(s[..], "chat.modelPicker");

  // Open drawer via sidebar button and verify Account, Wallet, Hub, and session card
  #assert ios_activate(s[..], "nav.sidebar") && s[0].drawer;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "drawer") && ios_test_has(s[..], "ses.s1") && ios_test_has(s[..], "sidebar.account") && ios_test_has(s[..], "sidebar.wallet") && ios_test_has(s[..], "sidebar.hub");
  #assert ios_activate(s[..], "sidebar.account") && !s[0].drawer && ios_take_action(s[..]) == IOS_ACT_OPEN_ACCOUNT;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "nav.sidebar") && s[0].drawer;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "sidebar.wallet") && !s[0].drawer && ios_take_action(s[..]) == IOS_ACT_OPEN_WALLET;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "nav.sidebar") && s[0].drawer;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "ses.s1") && !s[0].drawer;
  #assert ios_take_action(s[..]) == IOS_ACT_SELECT_SESSION;
  arg: [64] u8; #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "s1";

  // Open model picker and select second model
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "chat.modelPicker") && s[0].picker == 1;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "pick.1");
  #assert ios_activate(s[..], "pick.1") && s[0].picker == 0;
  #assert ios_take_action(s[..]) == IOS_ACT_CHOSE_MODEL;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "gemini-4-carbon";

  // Push conversation items (user, thought, tool, assistant markdown with code block)
  ios_items_clear(s[..], true);
  ios_items_push(s[..], IOS_ROLE_USER, "u1", "Check the shader", "", "", "", true, false, false, false, 0, 0);
  ios_items_push(s[..], IOS_ROLE_THOUGHT, "t1", "Inspecting gpu-shader.coax", "", "", "", true, false, false, false, 0, 0);
  ios_items_push(s[..], IOS_ROLE_TOOL, "tl1", "rg chat_fx_fs components/", "Bash", "", "", true, false, false, false, 0, 2);
  ios_items_push(s[..], IOS_ROLE_ASSISTANT, "a1", "Here is the code:\n```swift\nlet x = 1\n```", "", "", "", true, false, false, false, 0, 0);
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "m.u1") && ios_test_has(s[..], "act.t1") && ios_test_has(s[..], "m.a1");
  #assert s[0].refused == 0;

  // Copy code block from Markdown reply
  #assert ios_activate(s[..], "m.a1.code.1.copy") && ios_take_action(s[..]) == IOS_ACT_COPY_TEXT;
  cb: [64] u8; #assert cast(string) cb[0..<ios_copy_get(s[..], cb[..])] == "let x = 1";

  // Verify Dashboard home screen, active mini-window card, and tap-to-open
  ios_sessions_clear(s[..]);
  ios_sessions_push(s[..], "live-1", "Build iOS parity", "openagents", "gemini-4-neon", "now", true, false, false, false);
  ios_session_set_preview(s[..], "live-1", "Bring mobile app up to parity", "Edited gpu-page.coax", "Added Dashboard and autocomplete.");
  #assert ios_activate(s[..], "nav.sidebar") && s[0].drawer;
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "sidebar.dashboard");
  #assert ios_activate(s[..], "sidebar.dashboard") && s[0].dashboard && !s[0].drawer;
  _ = ios_take_action(s[..]);
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "dash.live-1");
  #assert ios_activate(s[..], "dash.live-1") && !s[0].dashboard;
  #assert ios_take_action(s[..]) == IOS_ACT_SELECT_SESSION;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "live-1";

  // Verify @ mention autocomplete, Todos card, Queued follow-up, and Multi-option approval
  ios_suggestions_clear(s[..], true);
  ios_suggestions_push(s[..], "dir-apps/openagents-ios", "@apps/openagents-ios", "Folder");
  ios_todos_clear(s[..]);
  ios_todos_push(s[..], "Add Dashboard grid", IOS_TODO_COMPLETED);
  ios_todos_push(s[..], "Verify Simulator tests", IOS_TODO_IN_PROGRESS);
  ios_set_queued(s[..], "Then push to TestFlight");
  ios_set_usage(s[..], "ctx 12% · Today $0.42 · Quota 68%", 12);
  ios_set_header(s[..], "Christopher's MacBook Pro", "Build iOS parity", "openagents", IOS_REACH_OK, 1, true, false, false);
  ios_set_approval(s[..], true, "Allow running xcodebuild?", "");
  ios_approval_options_clear(s[..]);
  ios_approval_options_push(s[..], "allow_once", "Allow once", "allow");
  ios_approval_options_push(s[..], "reject_once", "Reject", "reject");

  // Full Auto defaults ON and suppresses the approval card while Always-On Usage & Live Voice render (#14068)
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_full_auto(s[..]);
  #assert ios_test_has(s[..], "chat.fullAuto") && ios_test_has(s[..], "chat.usageBar") && ios_test_has(s[..], "chat.liveVoiceButton");
  #assert !ios_test_has(s[..], "approval.opt.0");

  // Tapping Always-On Usage strip emits IOS_ACT_OPEN_USAGE
  #assert ios_activate(s[..], "chat.usageBar") && ios_take_action(s[..]) == IOS_ACT_OPEN_USAGE;

  // Tapping Live Voice button emits IOS_ACT_TOGGLE_LIVE_VOICE and renders active duplex pill when speaking
  #assert ios_activate(s[..], "chat.liveVoiceButton") && ios_take_action(s[..]) == IOS_ACT_TOGGLE_LIVE_VOICE;
  ios_set_voice_duplex(s[..], IOS_VOICE_SPEAKING, 0.72f32);
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "chat.liveVoicePill") && ios_test_has(s[..], "chat.liveVoiceEnd");
  ios_set_voice_duplex(s[..], IOS_VOICE_OFF, 0.0f32);

  // Toggling Full Auto OFF reveals the interactive approval card
  #assert ios_activate(s[..], "chat.fullAuto") && !ios_full_auto(s[..]);
  #assert ios_take_action(s[..]) == IOS_ACT_TOGGLE_FULL_AUTO;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "0";
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "chat.folderMenu") && ios_test_has(s[..], "sug.0") && ios_test_has(s[..], "chat.todos") && ios_test_has(s[..], "composer.queued.clear") && ios_test_has(s[..], "approval.opt.0") && ios_test_has(s[..], "chat.usageBar");
  #assert ios_activate(s[..], "sug.0") && ios_take_action(s[..]) == IOS_ACT_APPLY_SUGGESTION;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "dir-apps/openagents-ios";
  #assert ios_activate(s[..], "approval.opt.0") && ios_take_action(s[..]) == IOS_ACT_APPROVAL_OPTION;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "allow_once";
  #assert ios_activate(s[..], "chat.todos") && s[0].todos_expanded;
  #assert ios_activate(s[..], "composer.queued.clear") && ios_take_action(s[..]) == IOS_ACT_CLEAR_QUEUED;

  // Verify Universal Introspection sidebar: Working, Chats, TUI & Terminal, Other Harnesses, Machines (#14068)
  ios_intro_clear(s[..]);
  ios_intro_push(s[..], IOS_INTRO_TUI, "tmux:dev:0.0", "dev:0.0", "tmux", "/repo/openagents", "zsh", false, false);
  ios_intro_push(s[..], IOS_INTRO_HARNESS, "claude:abc", "Claude Refactor", "claude", "/repo/openagents", "idle", false, false);
  ios_machines_clear(s[..]);
  ios_machines_push(s[..], "mac-studio", "Studio Mac", "studio.ts.net", IOS_REACH_OK, 3, true);
  ios_drawer_set(s[..], true);
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_test_has(s[..], "side.sec.0") && ios_test_has(s[..], "side.sec.1") && ios_test_has(s[..], "side.sec.2") && ios_test_has(s[..], "side.sec.3") && ios_test_has(s[..], "side.sec.4");
  #assert ios_test_has(s[..], "intro.tmux:dev:0.0") && ios_test_has(s[..], "intro.claude:abc") && ios_test_has(s[..], "mach.mac-studio");

  // Collapse TUI section and verify its row hides, then re-expand and tap it
  #assert ios_activate(s[..], "side.sec.2") && s[0].sec_collapsed[2];
  _ = ios_test_frame(s[..], o[..]);
  #assert !ios_test_has(s[..], "intro.tmux:dev:0.0");
  #assert ios_activate(s[..], "side.sec.2") && !s[0].sec_collapsed[2];
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "intro.tmux:dev:0.0") && ios_take_action(s[..]) == IOS_ACT_SELECT_INTRO;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "tmux:dev:0.0";

  // Select machine from Machines section
  ios_drawer_set(s[..], true);
  _ = ios_test_frame(s[..], o[..]);
  #assert ios_activate(s[..], "mach.mac-studio") && ios_take_action(s[..]) == IOS_ACT_SELECT_MACHINE;
  #assert cast(string) arg[0..<ios_action_arg(s[..], arg[..])] == "mac-studio";
  #assert s[0].refused == 0;
}
