// OpenAgents' mobile account surface. Auth effects/tokens stay in the installed
// native host; UI, requests and transitions update as Coax/Wasm.
#load "../../../components/kit/frames.coax";
#load "../../../components/backend/dom.coax";
#load "../../../coax/lib/json/json.coax";
#load "../../shared/app-login.coax";
#load "../../../coax/web/api/account-chat-wire.coax";
#load "../../../coax/native/text-services-wire.coax";
#load "../../../coax/native/text-link-policy.coax";
#load "../../../coax/web/api/chat-history-wire.coax"; // shared account-history codec
#load "../../shared/environment-app.coax";

Starter :: struct {
  ready:bool;dirty:bool=true;time:f32;action:int;flight:int;purpose:int;page:int= -1;
  email:[254]u8;email_n:int;code:[32]u8;code_n:int;pending:[256]u8;pending_n:int;
  note:[512]u8;note_n:int;outbox:[131072]u8;out_n:int;inbox:[1048576]u8;
  chats:[1]ChatHistory;selected:int= -1;
  thread:[1]AccountThread;draft:[4096]u8;draft_n:int;wire:[65536]u8;retry:bool;
  markdown:[1]MdDoc;copied:[96]u8;copied_n:int;text_busy:bool;
  environments:[1]EnvironmentApp;
  local_available:bool;account_ready:bool;
  tree:[1]Tree;dom:[1]Dom;ui:[1]Ui;sets:[MF_COUNT]AfSettings;css:[24576]u8;
}
na_copy :: (out:[]u8,text:string)->int {n:=ifx text.count<out.count then text.count else out.count;for i:0..<n {out[i]=text[i];}return n;}
na_note :: (s:[]Starter,text:string) {s[0].note_n=na_copy(s[0].note[..],text);s[0].dirty=true;}
na_history_clear :: (s:[]Starter) {empty:ChatHistory;s[0].chats[0]=empty;thread:AccountThread;s[0].thread[0]=thread;for i:0..<s[0].draft.count {s[0].draft[i]=0;}s[0].draft_n=0;s[0].retry=false;dm_value(s[0].dom[..],"chat.composer","");}
na_secrets_clear :: (s:[]Starter) {
  for i:0..<s[0].email.count {s[0].email[i]=0;}s[0].email_n=0;
  dm_value(s[0].dom[..],"login.email","");
  for i:0..<s[0].code.count {s[0].code[i]=0;}s[0].code_n=0;
  for i:0..<s[0].pending.count {s[0].pending[i]=0;}s[0].pending_n=0;
  for i:0..<s[0].inbox.count {s[0].inbox[i]=0;}
  dm_value(s[0].dom[..],"login.code","");
}
na_request :: (s:[]Starter,op:int,path:string) {
  if s[0].flight!=0 {return;}
  n:= -1;
  if op==2 {n=al_email_start_body(cast(string)s[0].email[0..<s[0].email_n],s[0].outbox[..]);}
  else if op==3 {n=al_email_verify_body(cast(string)s[0].code[0..<s[0].code_n],cast(string)s[0].pending[0..<s[0].pending_n],s[0].outbox[..]);}
  else {
    o:[1]Jo;jo_start(o[..],s[0].outbox[..]);jo_obj(o[..]);
    if op==4 {jo_key(o[..],"path");jo_str(o[..],path);jo_key(o[..],"method");jo_str(o[..],"GET");}
    jo_end(o[..]);n=ifx o[0].bad then -1 else o[0].n;
  }
  if n<0 {na_note(s,ifx op==3 then "Type the 6 digits from the email." else "Type your email address.");return;}
  s[0].out_n=n;s[0].action=op;s[0].flight=op;s[0].dirty=true;
}
na_list :: (s:[]Starter) {s[0].account_ready=true;s[0].page=2;s[0].purpose=1;na_request(s,4,"/api/chat/history/v1");}
na_start :: (s:[]Starter) {
  if s[0].flight!=0 {return;}
  if s[0].email_n==0 {na_note(s,"Type your email address.");return;}
  na_note(s,"");na_request(s,2,"");
}
na_verify :: (s:[]Starter) {
  if s[0].flight!=0 {return;}
  if s[0].pending_n==0 {s[0].page=0;na_note(s,"Ask for a new email code.");return;}
  na_note(s,"");na_request(s,3,"");
}
na_http :: (s:[]Starter,path:string,body:string,purpose:int) {
  if s[0].flight!=0 {return;}
  o:[1]Jo;jo_start(o[..],s[0].outbox[..]);jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],path);jo_key(o[..],"method");jo_str(o[..],ifx body.count>0 then "POST" else "GET");
  if body.count>0 {jo_key(o[..],"body");jo_str(o[..],body);}jo_end(o[..]);
  if o[0].bad {na_note(s,"This chat is full. Start a new chat.");return;}
  s[0].out_n=o[0].n;s[0].purpose=purpose;s[0].action=4;s[0].flight=4;s[0].dirty=true;
}
na_new :: (s:[]Starter) {
  if s[0].flight!=0 {return;}empty:AccountThread;s[0].thread[0]=empty;s[0].draft_n=0;s[0].retry=false;s[0].page=3;
  dm_value(s[0].dom[..],"chat.composer","");na_note(s,"");
}
na_save :: (s:[]Starter,purpose:int) {
  n:=act_write(s[0].thread[..],s[0].wire[..]);if n<1 {na_note(s,"This chat is full. Start a new chat.");return;}
  na_http(s,"/api/chat/thread/v1",cast(string)s[0].wire[0..<n],purpose);
}
na_complete :: (s:[]Starter) {
  n:=act_write(s[0].thread[..],s[0].wire[..]);if n<1 {return;}
  na_http(s,"/api/chat/complete/v1",cast(string)s[0].wire[0..<n],5);na_note(s,"");s[0].retry=false;
}
na_send :: (s:[]Starter) {
  if s[0].flight!=0 || s[0].draft_n==0 {return;}
  // A bounded transcript reserves room for the next answer. No hidden clipping.
  t:=s[0].thread[..];total:=s[0].draft_n;for i:0..<t[0].n {total+=t[0].messages[i].n;}
  if t[0].n>=31 || total>30000 {na_note(s,"This chat is full. Start a new chat to continue.");return;}
  i:=t[0].n;t[0].messages[i].assistant=false;t[0].messages[i].n=na_copy(t[0].messages[i].text[..],cast(string)s[0].draft[0..<s[0].draft_n]);t[0].n+=1;
  na_save(s,4);if s[0].flight==0 {t[0].n-=1;}
}
#test "send persists the user before inference, clears only accepted draft, and saves the reply" {
  s:[1]Starter;s[0].page=3;s[0].draft_n=na_copy(s[0].draft[..],"Hello");na_send(s[..]);#assert s[0].purpose==4 && s[0].draft_n==5;
  na_reply(s[..],4,200,"{\"schema\":\"openagents.chat.thread.v1\",\"id\":\"m_12345678901234567890\",\"revision\":1,\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}]}",false);
  #assert s[0].purpose==5 && s[0].flight==4 && s[0].draft_n==0;
  na_reply(s[..],4,200,"{\"choices\":[{\"message\":{\"content\":\"Hi!\"},\"finish_reason\":\"stop\"}]}",false);
  #assert s[0].purpose==6 && s[0].thread[0].n==2 && s[0].thread[0].messages[1].assistant;
}
#test "save failure retains draft, model failure offers explicit retry without duplicating user" {
  s:[1]Starter;s[0].page=3;s[0].draft_n=na_copy(s[0].draft[..],"Hello");na_send(s[..]);na_reply(s[..],4,503,"{}",false);
  #assert s[0].draft_n==5 && s[0].thread[0].n==0 && s[0].flight==0;
  s[0].flight=4;s[0].purpose=5;na_reply(s[..],4,429,"{}",false);#assert s[0].retry && s[0].flight==0;
}
// Text effects may complete alongside a model request; they never replace its
// flight/purpose or trigger a model retry.
na_text_effect :: (s:[]Starter,link:bool,value:string,id:string) {
  if s[0].text_busy || s[0].action!=0 {return;}
  if link && !nt_link(value) {na_note(s,"This link cannot be opened.");return;}
  n:=nt_service_body(link,value,s[0].outbox[..]);if n<0 {na_note(s,"Text action is too large.");return;}
  s[0].out_n=n;s[0].action=ifx link then 10 else 9;s[0].text_busy=true;
  if !link {s[0].copied_n=na_copy(s[0].copied[..],id);}s[0].dirty=true;
}
#test "copy while an answer is pending cannot replace the model request" {
  s:[1]Starter;s[0].flight=4;s[0].purpose=5;na_text_effect(s[..],false,"literal **source**","message.0.copy");
  #assert s[0].action==9 && s[0].flight==4 && s[0].purpose==5;
  na_reply(s[..],9,0,"{}",false);#assert !s[0].text_busy && s[0].flight==4 && s[0].purpose==5;
}
na_reply :: (s:[]Starter,op:int,status:int,raw:string,failed:bool) {
  if op==11 || op==12 || op==14 || (op==4 && s[0].environments[0].active && s[0].environments[0].flight) {
    eu_reply(s[0].environments[..],op,status,raw,failed);s[0].dirty=true;
    dm_value(s[0].dom[..],"env.composer",cast(string)s[0].environments[0].draft[0..<s[0].environments[0].nd]);return;
  }
  if op==8 && s[0].purpose==40 {s[0].flight=0;s[0].environments[0]=EnvironmentApp.{};if s[0].account_ready {na_list(s);}else {s[0].page=0;}return;}
  if op==9 || op==10 {s[0].text_busy=false;if failed {s[0].copied_n=0;na_note(s,"The text action could not finish.");}s[0].dirty=true;return;}
  if op!=s[0].flight {return;}s[0].flight=0;s[0].dirty=true;
  nodes:[48]JvNode;d:[1]Jv;ok:=jv_parse(d[..],raw,nodes[..]);v:=d[0];
  if op==8 {s[0].purpose=0;s[0].retry=true;na_note(s,"Stopped. You can retry this turn.");return;}
  if op==4 && s[0].purpose>=3 {
    purpose:=s[0].purpose;s[0].purpose=0;
    if status==401 {na_history_clear(s);na_new(s);s[0].page=0;na_secrets_clear(s);na_note(s,"Log in again to continue.");return;}
    if failed || status!=200 {
      if purpose==4 && s[0].thread[0].n>0 {s[0].thread[0].n-=1;}
      if purpose==5 {s[0].retry=true;}
      na_note(s,ifx status==409 then "Chat changed on another device. Go back and reopen it." else ifx status==403 then "Agent chat is currently available to the team beta." else ifx purpose==6 then "Reply received but not saved. Tap Save reply to retry." else "Chat request failed. Check your connection and try again.");
      if purpose==6 {s[0].purpose=6;}return;
    }
    if purpose==5 {
      t:=s[0].thread[..];i:=t[0].n;n:=ifx i<32 then act_answer(raw,t[0].messages[i].text[..]) else -1;
      if n<1 {s[0].retry=true;na_note(s,"The agent did not return an answer. Retry this turn.");return;}
      t[0].messages[i].n=n;t[0].messages[i].assistant=true;t[0].n+=1;na_save(s,6);return;
    }
    if !act_read(raw,s[0].thread[..]) {na_note(s,"The chat service returned an unreadable conversation.");return;}
    if purpose==4 {s[0].draft_n=0;dm_value(s[0].dom[..],"chat.composer","");na_complete(s);return;}
    s[0].page=3;s[0].retry=false;na_note(s,"");return;
  }
  if failed {
    n:=ifx ok then jv_str(v,jv_get(v,0,"error"),s[0].note[..]) else -1;
    s[0].note_n=ifx n>0 then n else na_copy(s[0].note[..],"OpenAgents is unavailable. Check your connection and try again.");
    if op==1 {s[0].page=0;na_history_clear(s);na_secrets_clear(s);}
    if op==4 {s[0].purpose=2;na_request(s,1,"");}return;
  }
  if op==1 {
    s[0].local_available=ok && jv_bool(v,jv_get(v,0,"localEnvironment"));s[0].account_ready=ok && jv_bool(v,jv_get(v,0,"loggedIn"));
    if ok && jv_bool(v,jv_get(v,0,"loggedIn")) {if s[0].purpose==2 {s[0].purpose=0;s[0].page=2;}else {na_list(s);}}else {s[0].page=0;na_history_clear(s);na_secrets_clear(s);}return;
  }
  if op==2 {
    n:=ifx ok then jv_str(v,jv_get(v,0,"pending"),s[0].pending[..]) else -1;
    if n<1 {na_note(s,"The email could not be requested. Try again.");return;}
    s[0].pending_n=n;s[0].page=1;s[0].code_n=0;
    dm_value(s[0].dom[..],"login.code","");dm_focus(s[0].dom[..],"login.code");return;
  }
  if op==3 {
    if ok && jv_bool(v,jv_get(v,0,"loggedIn")) {na_secrets_clear(s);na_history_clear(s);na_list(s);}
    else {na_note(s,"The code was not accepted. Try again.");}return;
  }
  if op==5 {na_new(s);na_secrets_clear(s);na_history_clear(s);s[0].page=0;na_note(s,"");return;}
  if op==6 || op==7 {n:=ifx ok then jv_str(v,jv_get(v,0,"message"),s[0].note[..]) else -1;s[0].note_n=ifx n>0 then n else 0;return;}
  if op==4 {
    if status==401 {na_history_clear(s);s[0].page=0;na_secrets_clear(s);na_note(s,"Log in again to see your chats.");return;}
    if status!=200 {na_note(s,ifx status==403 then "This account cannot access these saved chats." else "Your chats could not be loaded. Refresh to try again.");return;}
    s[0].chats[0]=chh_read(raw);
    if !s[0].chats[0].ok {na_note(s,"The chat service returned an unreadable list. Refresh to try again.");return;}
    na_note(s,"");
  }
}
#test "email code cannot verify before request, wrong code retries, and login then loads saved chats" {
  s:[1]Starter;s[0].page=0;
  s[0].email_n=na_copy(s[0].email[..],"ada@example.com");na_start(s[..]);#assert s[0].action==2;
  na_reply(s[..],2,0,"{\"pending\":\"test-challenge\"}",false);#assert s[0].page==1 && s[0].pending_n>0;
  s[0].code_n=na_copy(s[0].code[..],"123");na_verify(s[..]);#assert s[0].flight==0;
  s[0].code_n=na_copy(s[0].code[..],"123 456");na_verify(s[..]);#assert s[0].flight==3;
  na_reply(s[..],3,0,"{\"error\":\"Wrong code.\"}",true);#assert s[0].page==1 && s[0].pending_n>0;
  na_verify(s[..]);na_reply(s[..],3,0,"{\"loggedIn\":true}",false);
  #assert s[0].page==2 && s[0].action==4 && s[0].pending_n==0 && s[0].code_n==0;
  na_reply(s[..],4,200,"{\"schema\":\"openagents.chat.history.v1\",\"chats\":[{\"id\":\"1\",\"title\":\"A chat\",\"model\":\"m\",\"folder\":\"\",\"updated_ms\":0,\"busy\":false}]}",false);
  #assert s[0].chats[0].ok && s[0].chats[0].n==1;
}
#test "an unavailable history probes native expiry once and permits manual refresh" {
  s:[1]Starter;s[0].page=2;na_list(s[..]);
  na_reply(s[..],4,0,"{}",true);#assert s[0].flight==1 && s[0].purpose==2;
  na_reply(s[..],1,0,"{\"loggedIn\":true}",false);#assert s[0].flight==0 && s[0].page==2;
  na_list(s[..]);na_reply(s[..],4,0,"{}",true);
  na_reply(s[..],1,0,"{\"loggedIn\":false}",false);#assert s[0].page==0 && s[0].flight==0;
}
#test "expired sessions and a new login erase all prior account history" {
  s:[1]Starter;s[0].page=2;s[0].chats[0].n=1;s[0].chats[0].items[0].title[0]='X';s[0].email[0]='a';s[0].email_n=1;
  na_list(s[..]);na_reply(s[..],4,401,"{}",false);
  #assert s[0].page==0 && s[0].chats[0].n==0 && s[0].chats[0].items[0].title[0]==0 && s[0].email_n==0 && s[0].email[0]==0;
  s[0].chats[0].n=1;s[0].chats[0].items[0].title[0]='Y';s[0].flight=3;
  na_reply(s[..],3,0,"{\"loggedIn\":true}",false);
  #assert s[0].page==2 && s[0].flight==4 && s[0].chats[0].n==0 && s[0].chats[0].items[0].title[0]==0;
}
st_done :: (s:[]Starter) #export_c #effects(all) {s[0].action=0;for i:0..<s[0].out_n {s[0].outbox[i]=0;}s[0].out_n=0;}
st_frame :: (s:[]Starter,dt:f32,reduced:bool)->int #export_c #effects(all) {
  if !s[0].ready {s[0].ready=true;n:=mono_frames(s[0].sets[..]);na_request(s,1,"");}
  if dt>0 && dt<1 {s[0].time+=dt;}if !s[0].dirty && !s[0].ui[0].busy {return 0;}
  t:=s[0].tree[..];u:=s[0].ui[..];d:=s[0].dom[..];
  if !d[0].styled {
    n:=mono_css(s[0].css[..]);n=mc(s[0].css[..],n,"body{padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}.account-app{max-width:600px;margin:auto;padding:88px 24px 40px;display:flex;flex-direction:column;gap:22px}.account-app>*{margin:0}.account-app h1{font-size:32px;line-height:1.2}.account-app p{color:var(--ink-muted)}.account-app .btn{min-height:48px}.account-app .chat-row{text-align:left;text-transform:none;letter-spacing:normal}.account-app .note{white-space:pre-wrap}.account-app input{font-size:18px}.account-app footer{display:flex;flex-direction:column;gap:12px;margin-top:32px}");dm_style(d,cast(string)s[0].css[0..<n]);
  }
  // Account fields stay still while the keyboard moves and code replies arrive.
  ui_begin(u,s[0].time,true);tr_begin(t);root:=tr_open(t,"account.app",TG_MAIN,"account-app");
  if s[0].page!=3 && !(s[0].page==4 && s[0].environments[0].page==2) {x:=k_text(t,u,"account.brand",TG_P,"","OPENAGENTS");}x:= -1;busy:=s[0].flight!=0;
  if s[0].page<0 {x=k_text(t,u,"account.starting",TG_P,"","Opening your account…");}
  else if s[0].page==0 {
    x=k_text(t,u,"login.title",TG_H1,"","Log in");x=k_text(t,u,"login.about",TG_P,"","Use the same email as openagents.com. We'll send you a 6-digit code.");
    x=k_input(t,u,"login.email","you@example.com","Email address","email","email");if busy {tr_attr(t,x,AT_DISABLED,"disabled");}
    x=k_button(t,u,"login.send",ifx busy then "Sending code…" else "Send code",ifx busy then BS_DISABLED else BS_PRIMARY);
    if s[0].local_available {x=k_button(t,u,"environments.local","Use this computer",ifx busy then BS_DISABLED else BS_PLAIN);}
  } else if s[0].page==1 {
    x=k_text(t,u,"login.title",TG_H1,"","Check your email");x=k_text(t,u,"login.sent",TG_P,"",cast(string)s[0].email[0..<s[0].email_n]);
    x=k_text(t,u,"login.help",TG_P,"","Enter the 6-digit code from your email. It works for 10 minutes and 5 tries.");
    x=k_input(t,u,"login.code","000000","Email code","tel","one-time-code");if busy {tr_attr(t,x,AT_DISABLED,"disabled");}
    x=k_button(t,u,"login.verify",ifx busy then "Checking code…" else "Log in",ifx busy then BS_DISABLED else BS_PRIMARY);
    x=k_button(t,u,"login.resend","Send a new code",ifx busy then BS_DISABLED else BS_PLAIN);
    x=k_button(t,u,"login.change","Use another email",ifx busy then BS_DISABLED else BS_PLAIN);
  } else if s[0].page==4 {
    eu_render(s[0].environments[..],t,u,s[0].markdown[..]);
  } else if s[0].page==3 {
    x=tr_open(t,"chat.header",TG_HEADER,"");tr_attr(t,x,AT_ROLE,"toolbar");
    x=k_button(t,u,"chat.back","Your chats",ifx busy then BS_DISABLED else BS_PLAIN);x=k_text(t,u,"chat.name",TG_SPAN,"","OpenAgents");tr_close(t);
    x=tr_open(t,"chat.messages",TG_SECTION,"transcript");tr_attr(t,x,AT_STATE,ifx s[0].thread[0].id_n>0 then cast(string)s[0].thread[0].id[0..<s[0].thread[0].id_n] else "new");
    if s[0].thread[0].n==0 {x=k_text(t,u,"chat.welcome",TG_P,"","What would you like to work on?");}
    for k:0..<s[0].thread[0].n {id:[96]u8;m:=s[0].thread[0].messages[k];
      x=k_message(t,u,tr_join(id[..],"message.",k),m.assistant,s[0].markdown[..],cast(string)m.text[0..<m.n]);
    }
    if s[0].purpose==5 && busy {x=k_reply_open(t,"chat.thinking",true,true);x=k_text(t,u,"chat.thinking.text",TG_P,"","Thinking…");tr_close(t);}
    tr_close(t);
    if s[0].retry {x=k_button(t,u,"chat.retry","Retry this turn",ifx busy then BS_DISABLED else BS_PLAIN);}
    if s[0].purpose==6 && !busy {x=k_button(t,u,"chat.save","Save reply",BS_PRIMARY);}
    f:=k_composer_begin(t,u,"chat.composer","Message");if busy {tr_attr(t,f,AT_DISABLED,"disabled");}
    k_composer_end(t,u,"chat.composer",ifx s[0].purpose==5 && busy then "Stop" else "Send",(s[0].purpose==5 && busy) || (!busy && s[0].draft_n>0 && s[0].purpose!=6));
  } else {
    x=k_text(t,u,"chats.title",TG_H1,"","Your chats");
    x=k_button(t,u,"environments.open","Your computers",ifx busy then BS_DISABLED else BS_PRIMARY);
    if s[0].local_available {x=k_button(t,u,"environments.local","This computer · offline access",ifx busy then BS_DISABLED else BS_PLAIN);}
    x=k_button(t,u,"chats.refresh",ifx busy then "Loading chats…" else "Refresh chats",ifx busy then BS_DISABLED else BS_PLAIN);
    x=k_button(t,u,"chat.new","New chat",ifx busy then BS_DISABLED else BS_PRIMARY);
    count:=s[0].chats[0].n;
    if count==0 && !busy && s[0].note_n==0 {x=k_text(t,u,"chats.empty",TG_P,"","No saved account chats yet.");}
    for k:0..<count {
      id:[96]u8;row:=s[0].chats[0].items[k];label:=cast(string)row.title[0..<row.title_n];
      x=k_button(t,u,tr_join(id[..],"chat.",k),ifx label.count>0 then label else "Untitled chat",ifx busy then BS_DISABLED else BS_PLAIN);
    }
    x=k_button(t,u,"account.logout","Log out",ifx busy then BS_DISABLED else BS_PLAIN);
  }
  if s[0].note_n>0 {x=k_text(t,u,"account.note",TG_P,"note",cast(string)s[0].note[0..<s[0].note_n]);tr_attr(t,x,AT_LIVE,"polite");}
  if s[0].page!=3 && s[0].page!=4 {x=tr_open(t,"app.tools",TG_FOOTER,"");x=k_button(t,u,"app.updates","Check for updates",ifx busy then BS_DISABLED else BS_PLAIN);x=k_button(t,u,"app.details","Build details",ifx busy then BS_DISABLED else BS_PLAIN);tr_close(t);}
  tr_close(t);
  if s[0].copied_n>0 {copy:=tr_find(t,cast(string)s[0].copied[0..<s[0].copied_n]);if copy>=0 {tr_attr(t,copy,AT_LABEL,"Copied");for k:copy+1..<t[0].n {if t[0].nodes[k].parent==copy && t[0].nodes[k].tag==TG_SPAN {tr_text(t,k,"Copied");break;}}}}
  if s[0].action==0 && s[0].environments[0].action!=0 {e:=s[0].environments[..];s[0].action=e[0].action;s[0].out_n=na_copy(s[0].outbox[..],cast(string)e[0].body[0..<e[0].nb]);e[0].action=0;}
  ui_end(u);s[0].dirty=false;return dm_flush(d,t,s[0].sets[..]);
}
st_event :: (s:[]Starter,kind:int,slot:int,n:int) #export_c #effects(all) {
  if kind>=100 && kind<215 {op:=ifx kind>=200 then kind-200 else kind-100;if n>=0 && n<=1048576 {na_reply(s,op,slot,cast(string)s[0].inbox[0..<n],kind>=200);}return;}
  i:= -1;for k:0..<s[0].tree[0].n {if s[0].dom[0].of[k]==slot {i=k;break;}}id:=tr_id(s[0].tree[..],i);
  if s[0].environments[0].active && (kind==1 || kind==2) {
    e:=s[0].environments[..];
    if kind==1 && id=="env.close" {e[0].active=false;e[0].timer=false;e[0].flight=false;s[0].purpose=40;na_request(s,8,"");return;}
    if kind==2 && id=="env.composer" && n>=0 {if n<=16384 {e[0].nd=ea_copy(e[0].draft[..],cast(string)s[0].inbox[0..<n]);}else {dm_value(s[0].dom[..],"env.composer",cast(string)e[0].draft[0..<e[0].nd]);eu_note(e,"Messages can be at most 16,384 bytes.");}s[0].dirty=true;return;}
    if kind==1 {eu_press(e,id);s[0].dirty=true;}
  }
  if kind==2 && n>=0 && s[0].flight==0 {
    if id=="login.email" && n<=254 {s[0].email_n=na_copy(s[0].email[..],cast(string)s[0].inbox[0..<n]);}
    if id=="login.code" && n<=32 {s[0].code_n=na_copy(s[0].code[..],cast(string)s[0].inbox[0..<n]);}
  }
  if kind==2 && id=="chat.composer" && s[0].flight==0 && n>=0 {
    if n<=4096 {s[0].draft_n=na_copy(s[0].draft[..],cast(string)s[0].inbox[0..<n]);}
    else {dm_value(s[0].dom[..],"chat.composer",cast(string)s[0].draft[0..<s[0].draft_n]);na_note(s,"Messages can be up to 4,096 bytes.");}
  }
  if kind==1 {
    if s[0].environments[0].active {for k:0..<s[0].environments[0].view[0].ni {a:[96]u8;b:[96]u8;if id==tr_cat(b[..],tr_join(a[..],"environment.message.",k),".copy") {m:=s[0].environments[0].view[0].items[k];na_text_effect(s,false,ea_item_text(s[0].environments[0].view[..],k),id);return;}}}
    for k:0..<s[0].thread[0].n {a:[96]u8;b:[96]u8;if id==tr_cat(b[..],tr_join(a[..],"message.",k),".copy") {m:=s[0].thread[0].messages[k];na_text_effect(s,false,cast(string)m.text[0..<m.n],id);return;}}
    code:=k_code_copy(s[0].tree[..],i);if code.count>0 {na_text_effect(s,false,code,id);return;}
    if i>=0 && s[0].tree[0].nodes[i].tag==TG_A {na_text_effect(s,true,tr_attr_of(s[0].tree[..],i,AT_HREF),id);return;}
  }
  if kind==1 && id=="chat.composer.send" && s[0].purpose==5 && s[0].flight==4 {s[0].flight=0;na_request(s,8,"");return;}
  if kind==1 && s[0].flight==0 {
    if id=="environments.open" {eu_enter(s[0].environments[..]);s[0].page=4;na_note(s,"");}
    if id=="environments.local" && s[0].local_available {eu_enter_local(s[0].environments[..]);s[0].page=4;na_note(s,"");}
    if id=="chat.new" {na_new(s);}if id=="chat.back" {na_list(s);}
    if id=="chat.clear" {s[0].draft_n=0;dm_value(s[0].dom[..],"chat.composer","");}
    if id=="chat.composer.send" {na_send(s);}if id=="chat.retry" {na_complete(s);}if id=="chat.save" {na_save(s,6);}
    for k:0..<s[0].chats[0].n {b:[96]u8;if id==tr_join(b[..],"chat.",k) {
      row:=s[0].chats[0].items[k];rid:=cast(string)row.id[0..<row.id_n];
      if rid.count==22 && rid[0]=='m' && rid[1]=='_' {path:[96]u8;at:=mc(path[..],0,"/api/chat/thread/v1?id=");at=mc(path[..],at,rid);na_http(s,cast(string)path[0..<at],"",3);}
      else {na_note(s,"Open this older conversation on openagents.com/chat. New mobile chats open here.");}
    }}
    if id=="login.send" || id=="login.resend" {na_start(s);}
    if id=="login.verify" {na_verify(s);}
    if id=="login.change" {na_secrets_clear(s);s[0].page=0;na_note(s,"");dm_value(s[0].dom[..],"login.email",cast(string)s[0].email[0..<s[0].email_n]);}
    if id=="chats.refresh" {na_list(s);}
    if id=="account.logout" {na_request(s,5,"");}
    if id=="app.updates" {na_request(s,6,"");}if id=="app.details" {na_request(s,7,"");}
  }
  if kind==3 {if id=="login.email" {na_start(s);}if id=="login.code" {na_verify(s);}}
  s[0].dirty=true;
}
st_size :: (s:[]Starter,slot:int,w:f32,h:f32) #export_c #effects(all) {if dm_size(s[0].dom[..],slot,w,h) {s[0].dirty=true;}}
