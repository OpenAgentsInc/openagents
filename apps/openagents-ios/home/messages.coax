// Native assembly of the shared messenger and existing account/history UI.
// SDK21/22/23 have their own owner; ordinary account HTTP keeps its flight.
#test "queued foreground navigation takes priority over private background bootstrap" {
 s:[1]Starter;s[0].workspace=true;s[0].account_ready=true;s[0].page=13;s[0].navigation[0].open=true;s[0].navigation[0].np=na_copy(s[0].navigation[0].pending[..],"nav.home");
 s[0].account_settings[0].loaded=true;s[0].account_settings[0].np=64;s[0].account_settings[0].na=1;
 na_dm_tick(s[..],0);#assert s[0].action==0 && !s[0].messenger[0].started;na_nav_tick(s[..]);#assert s[0].page==2 && s[0].navigation[0].np==0;
}
na_dm_clear :: (s:[]Starter) {
 ndm_clear(s[0].messenger[..]);ndv_clear(s[0].dm_view[..]);s[0].dm_wanted=false;s[0].dm_entropy_generation= -1;s[0].dm_entropy_na=0;
 s[0].markdown[0]=MdDoc.{};secure_zero(s[0].inbox[..]);secure_zero(s[0].outbox[..]);s[0].out_n=0;
 secure_zero(s[0].dm_entropy_account[..]);secure_zero(s[0].dm_entropy_identity[..]);dm_value(s[0].dom[..],"dm.composer","");dm_value(s[0].dom[..],"dm.recipient","");
}
na_dm_entropy :: (s:[]Starter,sending:bool)->bool {
 a:=s[0].account_settings[..];e:=s[0].environments[..];if s[0].flight!=0 || s[0].action!=0 || e[0].random || e[0].flight || a[0].np!=64 || a[0].na==0 {return false;}
 s[0].dm_entropy_generation=s[0].messenger[0].inbox[0].generation;s[0].dm_entropy_na=na_copy(s[0].dm_entropy_account[..],cast(string)a[0].account[0..<a[0].na]);_=na_copy(s[0].dm_entropy_identity[..],cast(string)a[0].pub[..]);
 s[0].purpose=ifx sending then 161 else 160;na_request(s,11,"");return true;
}
na_dm_tick :: (s:[]Starter,dt:f32) {
 m:=s[0].messenger[..];a:=s[0].account_settings[..];f:=s[0].feed[..];
 if s[0].page==13 {s[0].dm_wanted=true;}
 if !s[0].workspace || !s[0].account_ready || !s[0].dm_wanted || s[0].world_mode {return;}
 if s[0].navigation[0].np>0 {return;}
 if !a[0].loaded {if !a[0].busy {acs_request(a,"snapshot","","");}return;}
 if m[0].started && (cast(string)m[0].inbox[0].identity[..]!=cast(string)a[0].pub[0..<a[0].np] || cast(string)m[0].inbox[0].account[0..<m[0].inbox[0].na]!=cast(string)a[0].account[0..<a[0].na]) {na_dm_clear(s);s[0].dm_wanted=s[0].page==13;}
 if !m[0].started {if s[0].page!=12 && !f[0].busy && !f[0].reset_all {_=na_dm_entropy(s,false);}return;}
 urls:[6]string;for i:0..<a[0].saved[0].relays_n {urls[i]=asw_relay(a[0].saved[..],i);}_=ndm_settings(m,urls[0..<a[0].saved[0].relays_n]);
 paused:=s[0].page==12 || f[0].active || f[0].busy || f[0].reset_all;
 if paused && m[0].active {ndm_pause(m);}
 if !paused && !m[0].active && m[0].flight==0 {m[0].active=true;_=ndm_pool(m,ifx m[0].own_ready then 1 else 0,"");m[0].head_wanted=true;m[0].head_peer=false;}
 m[0].http_available=s[0].flight==0 && s[0].action==0 && !s[0].environments[0].flight && !s[0].environments[0].random;
 if ndm_tick(m,dt) || m[0].dirty {s[0].dirty=true;m[0].dirty=false;}
 if m[0].action==0 || s[0].action!=0 {return;}
 if m[0].action==4 {
  if !m[0].http_available {return;}na_http(s,ifx m[0].flight==12 then "/api/auth/nostr/read/v1" else "/api/auth/nostr/delivery/v1alpha1",cast(string)m[0].body[0..<m[0].nb],162);if s[0].action==4 {m[0].action=0;}
 }else {s[0].action=m[0].action;s[0].out_n=na_copy(s[0].outbox[..],cast(string)m[0].body[0..<m[0].nb]);m[0].action=0;}
}
na_dm_reply :: (s:[]Starter,op:int,status:int,raw:string,failed:bool)->bool {
 m:=s[0].messenger[..];v:=s[0].dm_view[..];
 if op==11 && s[0].flight==11 && (s[0].purpose==160 || s[0].purpose==161) {
  sending:=s[0].purpose==161;s[0].flight=0;s[0].purpose=0;a:=s[0].account_settings[..];
  current:=s[0].account_ready && s[0].dm_entropy_generation==m[0].inbox[0].generation && cast(string)s[0].dm_entropy_account[0..<s[0].dm_entropy_na]==cast(string)a[0].account[0..<a[0].na] && cast(string)s[0].dm_entropy_identity[..]==cast(string)a[0].pub[0..<a[0].np];
  if failed || !current {ndm_cancel_prepared(m);return true;}
  d:[1]Jv;nodes:[16]JvNode;seed:[64]u8;command:[32]u8;session:[32]u8;
  if !jv_parse(d[..],raw,nodes[..]) || js_string(d[0],jv_get(d[0],0,"command_id"),command[..])!=32 || js_string(d[0],jv_get(d[0],0,"session_id"),session[..])!=32 {ndm_cancel_prepared(m);return true;}
  for i:0..<32 {seed[i]=command[i];seed[32+i]=session[i];}if !aw_hex(cast(string)seed[..],64) {ndm_cancel_prepared(m);return true;}
  if sending {created:=jv_int(d[0],jv_get(d[0],0,"now_ms"),0)/1000;if !ndm_submit_prepared(m,cast(string)seed[..],created) {ndm_cancel_prepared(m);ndm_note(m,"Couldn't send");}}
  else {urls:[6]string;for i:0..<a[0].saved[0].relays_n {urls[i]=asw_relay(a[0].saved[..],i);}if !ndm_start(m,cast(string)a[0].account[0..<a[0].na],cast(string)a[0].pub[..],cast(string)seed[..],urls[0..<a[0].saved[0].relays_n]) {ndm_note(m,"Check relays");}}
  return true;
 }
 if op==21 || op==22 || op==23 || op==4 && s[0].purpose==162 {
  if op==4 {s[0].flight=0;s[0].purpose=0;}
  before:=m[0].outgoing[0].phase;_=ndm_reply(m,op,m[0].generation,status,raw,failed);
  if before!=3 && m[0].outgoing[0].phase==3 && v[0].open && cast(string)v[0].peer[..]==cast(string)m[0].outgoing[0].peer[..] && cast(string)v[0].draft[0..<v[0].nd]==cast(string)m[0].outgoing[0].text[0..<m[0].outgoing[0].nt] {v[0].nd=0;v[0].nr=0;secure_zero(v[0].draft[..]);dm_value(s[0].dom[..],"dm.composer","");}
  return true;
 }return false;
}
na_dm_nav :: (s:[]Starter,id:string)->bool {
 if id!="dm.open" && id!="dm.new" && !(id.count==72 && id[0..<8]=="dm.room.") {return false;}
 e:=s[0].environments[..];n:=s[0].navigation[..];
 if dca_blocked(s[0].durable[..]) || e[0].uncertain || s[0].project[0].uncertain {nav_note(n,"Check the current request first");return true;}
 if s[0].flight!=0 || e[0].flight || e[0].random {n[0].np=na_copy(n[0].pending[..],id);return true;}
 na_nav_keep(s);s[0].page=13;s[0].dm_wanted=true;n[0].open=false;n[0].creating=false;s[0].usage[0].active=false;e[0].active=false;
 v:=s[0].dm_view[..];m:=s[0].messenger[..];
 if id=="dm.new" {ndv_clear(v);v[0].choosing=true;}
 else if id=="dm.open" {ndv_clear(v);}
 else {for i:0..<m[0].inbox[0].n {b:[96]u8;if id==ndv_id("dm.room.",m[0].inbox[0].messages[i].message.room[..],b[..]) {if ndv_select(m[0].inbox[..],v,i) {_=ndm_peer(m,cast(string)v[0].peer[..]);na_nav_restore(s);}break;}}}
 s[0].dirty=true;return true;
}
na_dm_event :: (s:[]Starter,kind:int,id:string,n:int)->bool {
 if kind==1 && na_dm_nav(s,id) {return true;}if s[0].page!=13 {return false;}m:=s[0].messenger[..];v:=s[0].dm_view[..];
 if kind==2 && n>=0 {
  raw:=cast(string)s[0].inbox[0..<n];if id=="dm.recipient" && n<=96 {if n>=4 && (raw[0]|32)=='n' && (raw[1]|32)=='s' && (raw[2]|32)=='e' && (raw[3]|32)=='c' {v[0].recipient_n=0;secure_zero(v[0].recipient[..]);dm_value(s[0].dom[..],id,"");ndm_note(m,"Use a public key");}else {v[0].recipient_n=ndi_copy(v[0].recipient[..],raw);}return true;}
  if id=="dm.composer" {if n<=16384 {v[0].nd=ndi_copy(v[0].draft[..],raw);}else {dm_value(s[0].dom[..],id,cast(string)v[0].draft[0..<v[0].nd]);ndm_note(m,"Message too long");}return true;}
 }
 if kind!=1 && kind!=3 {return false;}
 if id=="dm.recipient.open" || kind==3 && id=="dm.recipient" {if ndv_peer(m[0].inbox[..],v,cast(string)v[0].recipient[0..<v[0].recipient_n]) {v[0].choosing=false;_=ndm_peer(m,cast(string)v[0].peer[..]);na_nav_restore(s);ndm_note(m,"");}else {ndm_note(m,ifx m[0].started then "Use an npub or public key" else "Connecting…");}return true;}
 if id=="dm.enable" {_=ndm_enable(m);return true;}
 if id=="dm.retry" {_=ndm_retry(m);return true;}
 if id=="dm.latest" {v[0].before=0;return true;}
 if id=="dm.earlier" {if v[0].before<128 {v[0].before+=12;}return true;}
 if id=="dm.reply.cancel" {v[0].nr=0;secure_zero(v[0].reply[..]);return true;}
 if id=="dm.composer.send" {if s[0].flight==0 && ndm_prepare(m,cast(string)v[0].draft[0..<v[0].nd],cast(string)v[0].reply[0..<v[0].nr]) {if !na_dm_entropy(s,true) {ndm_cancel_prepared(m);}}return true;}
 for i:0..<m[0].inbox[0].n {row:=m[0].inbox[0].messages[i];a:[96]u8;b:[96]u8;
  if id==ndv_id("dm.reply.",row.message.rumor_id[..],a[..]) && v[0].open && n17_same(row.message.room[..],v[0].room[..]) {v[0].nr=hex_encode_checked(cast(string)row.message.rumor_id[..],v[0].reply[..],false).written;return true;}
  if id==tr_cat(b[..],ndv_id("dm.message.",row.message.rumor_id[..],a[..]),".copy") {na_text_effect(s,false,cast(string)row.body[0..<row.n],id);return true;}
 }return false;
}
na_dm_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 m:=s[0].messenger[..];v:=s[0].dm_view[..];v[0].send_ready=ndm_can_send(m);
 if v[0].open && v[0].before==0 {_=nrp_visible(m[0].read_positions[..],m[0].inbox[..],v[0].room[..]);}
 ndv_render(m[0].inbox[..],v,m[0].delivery[..],m[0].outgoing[..],m[0].read_positions[..],t,u,s[0].markdown[..],ndm_ready(m),m[0].prepared[0].pending || m[0].outgoing[0].phase==1);
 if m[0].started && !m[0].own_ready && !m[0].head_wanted {x:=k_button(t,u,"dm.enable","Enable messages",BS_PRIMARY);}
 if m[0].nn>0 {x:=k_text(t,u,"dm.note",TG_P,"meta",cast(string)m[0].note[0..<m[0].nn]);}
 if m[0].outgoing[0].phase==2 || m[0].retry {x:=k_link(t,"dm.retry","Retry");}
}
#test "Nostr failure events keep the exact send and cannot consume an account inference flight" {
 s:[1]Starter;m:=s[0].messenger[..];me:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";peer:="79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";
 #assert ndi_bind(m[0].inbox[..],"a",me) && ndo_begin(m[0].outgoing[..],m[0].inbox[..],peer,peer,1730000000,"Unsent","");
 m[0].generation=1;m[0].flight=3;m[0].op=21;s[0].flight=4;s[0].purpose=5;
 st_event(s[..],221,0,0);#assert m[0].flight==0 && m[0].outgoing[0].phase==2 && m[0].outgoing[0].nr>0 && s[0].flight==4 && s[0].purpose==5;
}
#test "Nostr navigation uses exact typed draft scopes and clears private state with the account" {
 s:[1]Starter;s[0].workspace=true;s[0].account_ready=true;s[0].page=3;s[0].draft_n=na_copy(s[0].draft[..],"Agent draft");
 #assert na_dm_nav(s[..],"dm.new") && s[0].page==13 && s[0].dm_view[0].choosing && s[0].draft_n==11;
 me:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";peer:="79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";
 #assert ndi_bind(s[0].messenger[0].inbox[..],"a",me) && ndv_peer(s[0].messenger[0].inbox[..],s[0].dm_view[..],peer);
 s[0].dm_view[0].nd=na_copy(s[0].dm_view[0].draft[..],"Private draft");na_nav_keep(s[..]);s[0].dm_view[0].nd=0;na_nav_restore(s[..]);#assert s[0].dm_view[0].nd==13;
 na_history_clear(s[..]);#assert s[0].dm_view[0].nd==0 && s[0].dm_view[0].draft[0]==0 && s[0].messenger[0].inbox[0].na==0 && s[0].navigation[0].drafts[0].nb==0;
}
