// Durable native tasks use the existing authenticated HTTP, IDs and wait
// services. Purpose 140..146 belongs to this adapter, not the legacy session UI.
#load "../../shared/chat-task-protocol.coax";
na_task_clear :: (s:[]Starter) {
 s[0].durable[0].native[0]=NativeTaskApp.{};
 for i:0..<XH_LOG_MAX {s[0].task_data[i]=0;s[0].task_pools[0][i]=0;s[0].task_pools[1][i]=0;s[0].task_decode[i]=0;}
}
// The wait callback accounts for its one second even in zero-delta frames.
// UIKit's regular frame clock must not count that same interval twice.
na_task_clock :: (s:[]Starter,dt:f32) {n:=s[0].durable[0].native[..];if s[0].purpose!=146 && dt>0 && dt<=30 {n[0].elapsed+=dt;n[0].now+=cast(int)(dt*1000);}}
na_task_tick :: (s:[]Starter)->bool {
 d:=s[0].durable[..];n:=d[0].native[..];
 if !d[0].enabled || !s[0].workspace || !s[0].account_ready || s[0].page!=3 || s[0].world_mode || s[0].navigation[0].open || s[0].account_settings[0].active || s[0].usage[0].active || s[0].flight!=0 || s[0].action!=0 || d[0].pending!=0 || d[0].preparing {return false;}
 if dca_working(d) && !n[0].pane && (!n[0].selected || cast(string)n[0].turn[..]!=cast(string)d[0].view[0].turn[..]) {_=nta_select(n,cast(string)d[0].view[0].turn[..],dca_id(d));}
 if !n[0].selected {return false;}path:[512]u8;
 if n[0].preparing {s[0].purpose=144;na_request(s,11,"");return true;}
 if n[0].body_n>0 && !n[0].uncertain {nta_sent(n);na_http(s,nta_path(n,3,path[..]),cast(string)n[0].body[0..<n[0].body_n],145);return true;}
 if n[0].elapsed<0 {return false;}
 if n[0].yield_events && dca_working(d) && d[0].elapsed>=0.4 {n[0].yield_events=false;return false;}
 if n[0].body_n>0 {if n[0].elapsed<2 {return false;}n[0].need=2;}
 if n[0].need==0 && n[0].elapsed>=2 {if !n[0].bound {if dca_working(d) && cast(string)n[0].turn[..]==cast(string)d[0].view[0].turn[..] || n[0].pane && !n[0].absent {n[0].need=1;}}else if !n[0].has_status || !xt_terminal(n[0].status[0].state) {n[0].need=2;}}
 if n[0].need==1 && n[0].elapsed>=2 {na_http(s,nta_path(n,1,path[..]),"",140);return true;}
 if n[0].need==2 {na_http(s,nta_path(n,2,path[..]),"",141);return true;}
 if n[0].need==3 {s[0].purpose=142;na_request(s,11,"");return true;}
 if n[0].need==4 {na_http(s,nta_path(n,4,path[..]),"",143);return true;}
 return false;
}
na_task_wait :: (s:[]Starter) {
 d:=s[0].durable[..];n:=d[0].native[..];if s[0].flight==0 && s[0].action==0 && (dca_working(d) || n[0].pane && !n[0].bound && !n[0].absent || n[0].bound && (n[0].reading || n[0].need>0 || !n[0].has_status || !xt_terminal(n[0].status[0].state))) {s[0].purpose=146;na_request(s,12,"");}
}
na_task_reply :: (s:[]Starter,op:int,status:int,raw:string,failed:bool)->bool {
 purpose:=s[0].purpose;if purpose<140 || purpose>146 || op!=s[0].flight {return false;}
 s[0].flight=0;s[0].purpose=0;s[0].dirty=true;d:=s[0].durable[..];n:=d[0].native[..];
 if purpose==146 {n[0].elapsed+=1;n[0].now+=1000;d[0].elapsed+=1;return true;}
 if op==4 && status==401 {na_history_clear(s);na_secrets_clear(s);s[0].account_ready=false;s[0].page=0;na_note(s,"Log in again to see your task.");return true;}
 if failed || op==4 && (status<200 || status>=300) {
  n[0].elapsed= -2;
  if purpose==145 {n[0].uncertain=true;n[0].need=0;nta_note(n,"The control may have applied. Retry the original control or reconnect to observe it.");}
  else if purpose==144 {n[0].preparing=false;n[0].verb="";nta_note(n,"Could not prepare the control. No request was sent.");}
  else if purpose==140 && status==404 {n[0].absent=true;n[0].need=0;n[0].elapsed=0;if n[0].pane {nta_note(n,"No computer task is recorded for this message.");}}
  else if purpose==142 {n[0].need=3;nta_note(n,"Could not prepare a history read. Reconnect to retry.");}
  else {if status==403 || status==404 {n[0].available=false;}n[0].need=ifx purpose==143 && status!=409 then 4 else ifx purpose==143 then 3 else ifx purpose==140 then 1 else 2;nta_note(n,"Task connection unavailable. Saved history is kept; reconnect to retry.");}
  return true;
 }
 n[0].elapsed=0;
 if purpose==140 {if nta_binding(n,raw) {nta_note(n,"");}else {n[0].need=1;n[0].elapsed= -2;nta_note(n,"The complete owned task association could not be read.");}return true;}
 if purpose==141 {
  if !nta_observe(n,raw,"") {n[0].available=false;n[0].need=2;n[0].elapsed= -2;nta_note(n,"Task status changed or could not be verified. Reconnect to reconcile.");return true;}
  _=nta_reconcile(n);n[0].yield_events=true;
  if nta_pending(n) {n[0].need=0;return true;}
  n[0].need=ifx n[0].has_session && xt_terminal(n[0].status[0].state) && cast(string)n[0].captured[0..<n[0].captured_n]==cast(string)n[0].canonical[0..<n[0].canonical_n] then 0 else 3;nta_note(n,"");return true;
 }
 if purpose==142 {if nta_pending(n) {n[0].need=0;return true;}if !nta_capture_begin(n,raw,s[0].task_data[..]) {n[0].need=3;n[0].elapsed= -2;nta_note(n,"The task history read could not be prepared.");}return true;}
 if purpose==143 {
  if !nta_capture_page(n,raw) {n[0].need=3;n[0].elapsed= -2;nta_note(n,"Task history did not match its complete capture. Reconnect to read it again.");return true;}
  n[0].yield_events=true;
  if n[0].capture[0].client[0].done {if nta_publish(n,s[0].task_pools[1-n[0].pool_index][..],s[0].task_decode[..]) {nta_note(n,"");}else {n[0].need=3;n[0].elapsed= -2;nta_note(n,"The complete task history could not be decoded. Saved history is kept.");}}
  return true;
 }
 if purpose==144 {if !nta_command(n,raw) {n[0].preparing=false;n[0].verb="";nta_note(n,"The control identity was invalid. No request was sent.");}return true;}
 if purpose==145 {if nta_control_reply(n,raw) {nta_note(n,"");}else {n[0].uncertain=true;n[0].need=0;nta_note(n,"Unreadable control result. Retry the original control to reconcile.");}return true;}
 return true;
}
na_task_relevant :: (p:SPart)->bool {return p.kind==P_TOOL || p.kind==P_NOTICE;}
na_task_step :: (n:[]NativeTaskApp,direction:int) {
 at:=n[0].part+direction;while at>=0 && at<n[0].shown[0].n {if na_task_relevant(n[0].shown[0].parts[at]) {n[0].part=at;n[0].input_page=0;n[0].output_page=0;return;}at+=direction;}
}
na_task_press :: (s:[]Starter,id:string)->bool {
 d:=s[0].durable[..];n:=d[0].native[..];
 if id.count==51 && id[0..<15]=="native.details." {if s[0].flight!=0 && !nta_pending(n) {s[0].navigation[0].np=ea_copy(s[0].navigation[0].pending[..],id);return true;}if s[0].flight==0 && nta_select(n,id[15..<51],dca_id(d)) {n[0].pane=true;n[0].elapsed=2;n[0].need=ifx n[0].bound then 2 else 1;}return true;}
 if id=="native.open" || id=="native.review" {n[0].pane=true;if id=="native.review" && n[0].has_session {n[0].part=n[0].shown[0].asking;n[0].input_page=0;n[0].output_page=0;}return true;}
 if id=="native.close" {n[0].pane=false;return true;}
 if id=="native.reconnect" {n[0].elapsed=2;n[0].need=ifx !n[0].bound then 1 else ifx n[0].need==4 && n[0].capture[0].client[0].on && !n[0].capture[0].client[0].done then 4 else 2;return true;}
 if id=="native.retry" {if n[0].body_n>0 {n[0].uncertain=false;}return true;}
 if id=="native.approve" || id=="native.deny" || id=="native.stop" {
  if id=="native.stop" && dca_working(d) && cast(string)n[0].turn[..]==cast(string)d[0].view[0].turn[..] {nta_hold_for_stop(n);d[0].want_stop=true;return true;}
  if s[0].flight==0 || s[0].purpose==146 {_=nta_intent(n,ifx id=="native.stop" then "stop" else ifx id=="native.approve" then "approve" else "deny");}return true;
 }
 if id=="native.previous" || id=="native.next" {if n[0].has_session {na_task_step(n,ifx id=="native.previous" then -1 else 1);}return true;}
 if n[0].has_session && n[0].part>=0 && n[0].part<n[0].shown[0].n {
  p:=n[0].shown[0].parts[n[0].part];input:=p.input;output:=ifx p.kind==P_TOOL then p.output else s_text_of(n[0].shown[..],n[0].part);
  if id=="native.input.copy" || id=="native.activity.copy" {na_text_effect(s,false,nta_text_page(ifx id=="native.input.copy" then input else output,ifx id=="native.input.copy" then n[0].input_page else n[0].output_page),id);return true;}
  for which:0..<2 {is_input:=which==0;page:=ifx is_input then n[0].input_page else n[0].output_page;text:=ifx is_input then input else output;
   previous:=ifx is_input then "native.input.previous" else "native.output.previous";next:=ifx is_input then "native.input.next" else "native.output.next";
   if id==previous || id==next {if id==previous && page>0 {page-=1;}if id==next && (page+1)*NTA_PAGE_BYTES<text.count {page+=1;}if is_input {n[0].input_page=page;}else {n[0].output_page=page;}return true;}
  }
 }
 return false;
}
na_task_controls :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 d:=s[0].durable[..];n:=d[0].native[..];busy:=nta_pending(n) || s[0].flight!=0 && s[0].purpose!=146;x:= -1;
 if nta_permission(n) {x=k_link(t,"native.review","Review request");x=k_button(t,u,"native.approve","Allow once",ifx busy || !nta_reviewable(n) then BS_DISABLED else BS_PRIMARY);x=k_button(t,u,"native.deny","Deny",ifx busy then BS_DISABLED else BS_PLAIN);if !nta_reviewable(n) {x=k_meta(t,"native.review.required","Read the complete current request before allowing it. Deny and Stop remain available.");}}
 current:=dca_working(d) && cast(string)n[0].turn[..]==cast(string)d[0].view[0].turn[..];
 if n[0].pane && n[0].has_status && !xt_terminal(n[0].status[0].state) {x=k_button(t,u,"native.stop","Stop task",ifx busy && !current then BS_DISABLED else BS_PLAIN);}
 if n[0].body_n>0 && n[0].uncertain {x=k_link(t,"native.retry","Retry original control");}
 if n[0].note_n>0 {x=k_meta(t,"native.note",cast(string)n[0].note[0..<n[0].note_n]);}
}
na_task_summary :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 n:=s[0].durable[0].native[..];if !n[0].bound {return;}line:[1024]u8;o:[1]Jo;jo_start(o[..],line[..]);jo_put(o[..],cast(string)n[0].host_label[0..<n[0].host_label_n]);jo_put(o[..]," · ");jo_put(o[..],n[0].b[0].engine);jo_put(o[..]," · ");jo_put(o[..],n[0].b[0].model);if n[0].b[0].effort!="" {jo_put(o[..]," · ");jo_put(o[..],n[0].b[0].effort);}if n[0].has_status {jo_put(o[..]," · ");jo_put(o[..],ifx n[0].status[0].stop && !xt_terminal(n[0].status[0].state) then "stopping" else xt_name(n[0].status[0].state));}
 x:=k_meta(t,"native.selection",jo_text(o[..]));na_task_controls(s,t,u);
}
na_task_pages :: (t:[]Tree,u:[]Ui,input:bool,text:string,page:int) {
 prefix:=ifx input then "native.input" else "native.output";label:[96]u8;o:[1]Jo;jo_start(o[..],label[..]);jo_put(o[..],ifx input then "Input " else "Output ");jo_int(o[..],page+1);jo_put(o[..]," / ");jo_int(o[..],ifx text.count==0 then 1 else (text.count+NTA_PAGE_BYTES-1)/NTA_PAGE_BYTES);id:[96]u8;x:=k_meta(t,tr_cat(id[..],prefix,".page"),jo_text(o[..]));
 if page>0 {a:[96]u8;x=k_link(t,tr_cat(a[..],prefix,".previous"),ifx input then "Previous input page" else "Previous output page");}
 if (page+1)*NTA_PAGE_BYTES<text.count {a:[96]u8;x=k_link(t,tr_cat(a[..],prefix,".next"),ifx input then "Next input page" else "Next output page");}
}
na_task_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 n:=s[0].durable[0].native[..];x:=k_link(t,"native.close","Back to chat");x=k_text(t,u,"native.title",TG_H2,"","Task activity");na_task_summary(s,t,u);x=k_link(t,"native.reconnect","Reconnect task");
 if !n[0].bound {x=k_meta(t,"native.loading",ifx n[0].absent then "No computer task is recorded for this message." else "Reading the saved task…");return;}
 if n[0].reading {b:[128]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_put(o[..],"Reading history: ");jo_int(o[..],n[0].capture[0].client[0].n);jo_put(o[..]," bytes");x=k_meta(t,"native.progress",jo_text(o[..]));}
 if !n[0].has_session {return;}parts:=n[0].shown[..];first:= -1;count:=0;selected:=0;
 for i:0..<parts[0].n {if na_task_relevant(parts[0].parts[i]) {if first<0 {first=i;}count+=1;if i<=n[0].part {selected=count;}}}
 if first<0 {x=k_meta(t,"native.empty","No tool activity has been recorded.");return;}
 if n[0].part<0 || n[0].part>=parts[0].n || !na_task_relevant(parts[0].parts[n[0].part]) {n[0].part=ifx nta_permission(n) && parts[0].asking>=0 then parts[0].asking else first;n[0].input_page=0;n[0].output_page=0;selected=1;for i:0..<n[0].part {if na_task_relevant(parts[0].parts[i]) {selected+=1;}}}
 line:[96]u8;o:[1]Jo;jo_start(o[..],line[..]);jo_put(o[..],"Activity ");jo_int(o[..],selected);jo_put(o[..]," / ");jo_int(o[..],count);x=k_meta(t,"native.position",jo_text(o[..]));if selected>1 {x=k_link(t,"native.previous","Previous activity");}if selected<count {x=k_link(t,"native.next","Next activity");}
 p:=parts[0].parts[n[0].part];output:=ifx p.kind==P_TOOL then p.output else s_text_of(parts,n[0].part);if n[0].output_page>output.count/NTA_PAGE_BYTES {n[0].output_page=0;}
 if p.kind==P_TOOL {
  if n[0].input_page>p.input.count/NTA_PAGE_BYTES {n[0].input_page=0;}label:[256]u8;title:=sl_label(parts,n[0].part,label[..]);x=k_tool_line(t,u,"native.activity",title,ifx !p.resolved then "Running" else ifx p.failed then "Failed" else "Complete",ifx !p.resolved then TL_RUN else ifx p.failed then TL_NO else TL_OK,true,nta_text_page(p.input,n[0].input_page),nta_text_page(p.output,n[0].output_page));
  copy:=tr_find(t,"native.activity.copy");tr_attr(t,copy,AT_LABEL,"Copy output page");x=k_meta(t,"native.call",p.id);na_task_pages(t,u,true,p.input,n[0].input_page);x=k_button(t,u,"native.input.copy","Copy input page",BS_PLAIN);
 }else {x=k_notice(t,u,"native.activity",ifx p.notice==N_ASK then "Permission request" else "Task notice",nta_text_page(output,n[0].output_page));tr_close(t);}
 na_task_pages(t,u,false,output,n[0].output_page);
}
