// App assembly of the shared sidebar and the existing domain applications.
// Included by app.coax, after Starter. No new request or execution protocol.
#test "opening history keeps the current draft and original uncertain request" {
 s:[1]Starter;s[0].workspace=true;s[0].page=4;s[0].account_ready=true;e:=s[0].environments[..];e[0].active=true;e[0].page=2;e[0].uncertain=true;e[0].nd=ea_copy(e[0].draft[..],"Keep this draft");
 #assert na_nav_press(s[..],"nav.toggle") && s[0].navigation[0].open && e[0].nd==15;
 #assert na_nav_press(s[..],"nav.new") && e[0].uncertain && e[0].page==2 && e[0].nd==15;
 #assert na_nav_press(s[..],"nav.close") && !s[0].navigation[0].open;
}
#test "opening navigation shows the full drawer and keeps recent chats available" {
 s:[1]Starter;s[0].workspace=true;s[0].page=2;
 #assert na_nav_press(s[..],"nav.toggle") && s[0].navigation[0].open && !s[0].navigation[0].rail;
 t:[1]Tree;u:[1]Ui;ui_begin(u[..],0,true);tr_begin(t[..]);na_nav_render(s[..],t[..],u[..]);
 #assert tr_find(t[..],"nav.home")>=0 && tr_find(t[..],"nav.projects")>=0;
 #assert tr_find(t[..],"nav.search")<0 && tr_find(t[..],"nav.close")<0 && tr_find(t[..],"nav.history")<0;
 #assert tr_find(t[..],"nav.recents.label")>=0 && tr_find(t[..],"nav.compose")>=0 && tr_find(t[..],"nav.settings")>=0;
 #assert t[0].nodes[tr_find(t[..],"nav.compose")].parent==tr_find(t[..],"nav.footer");
}
#test "history selection is deferred while its metadata request owns HTTP" {
 s:[1]Starter;s[0].workspace=true;s[0].flight=4;s[0].purpose=70;
 #assert na_nav_press(s[..],"nav.account.new") && s[0].navigation[0].np>0 && s[0].page== -1;
 s[0].flight=0;s[0].purpose=0;s[0].dirty=false;na_nav_pending(s[..]);#assert s[0].page==3 && s[0].navigation[0].np==0 && s[0].dirty;
}
#test "settings keeps update feedback inside its presented panel" {
 s:[1]Starter;s[0].account_settings[0].active=true;acs_note(s[0].account_settings[..],"You have the latest compatible update.");t:[1]Tree;u:[1]Ui;ui_begin(u[..],0,true);tr_begin(t[..]);acs_render(s[0].account_settings[..],t[..],u[..]);at:=tr_find(t[..],"nav.settings.note");
 #assert at>=0;
 #assert t[0].nodes[at].parent==tr_find(t[..],"nav.settings.panel");
 #assert tr_text_of(t[..],tr_find(t[..],"nav.settings.note.t"))=="You have the latest compatible update.";
}
na_nav_key :: (s:[]Starter,out:[]u8)->string {
 e:=s[0].environments[..];n:=0;
 if s[0].page==13 {n=ndv_reference(s[0].messenger[0].inbox[..],s[0].dm_view[..],out);return ifx n>=0 then cast(string)out[0..<n] else "";}
 if s[0].page==4 && e[0].page==2 && e[0].selected>=0 {n=mc(out,0,cast(string)e[0].catalog[0].entries[e[0].selected].host[..]);n=mc(out,n,"/");n=mc(out,n,cast(string)e[0].session[0..<e[0].ns]);}
 else if s[0].page==2 || s[0].page==3 {n=mc(out,0,"account/");if s[0].durable[0].enabled && s[0].durable[0].id_n>0 {n=mc(out,n,dca_id(s[0].durable[..]));}else if s[0].thread[0].id_n>0 {n=mc(out,n,cast(string)s[0].thread[0].id[0..<s[0].thread[0].id_n]);}else if s[0].project_thread_n==36 {n=mc(out,n,cast(string)s[0].project_thread[0..<36]);}}
 return cast(string)out[0..<n];
}
na_nav_keep :: (s:[]Starter) {key:[224]u8;k:=na_nav_key(s,key[..]);e:=s[0].environments[..];nav_keep_draft(s[0].navigation[..],k,ifx s[0].page==13 then cast(string)s[0].dm_view[0].draft[0..<s[0].dm_view[0].nd] else ifx s[0].page==4 then cast(string)e[0].draft[0..<e[0].nd] else cast(string)s[0].draft[0..<s[0].draft_n]);}
na_nav_restore :: (s:[]Starter) {
 key:[224]u8;k:=na_nav_key(s,key[..]);text:=nav_draft(s[0].navigation[..],k);
 if s[0].page==13 {s[0].dm_view[0].nd=ndi_copy(s[0].dm_view[0].draft[..],text);dm_value(s[0].dom[..],"dm.composer",text);return;}
 if s[0].page==4 {s[0].environments[0].nd=ea_copy(s[0].environments[0].draft[..],text);dm_value(s[0].dom[..],"env.composer",text);}
 else {s[0].draft_n=na_copy(s[0].draft[..],text);dm_value(s[0].dom[..],"chat.composer",text);}
}
na_nav_tick :: (s:[]Starter) {
 n:=s[0].navigation[..];e:=s[0].environments[..];
 if s[0].usage[0].active || !s[0].account_ready || s[0].page<2 || !n[0].open || s[0].flight!=0 || e[0].flight || e[0].random || e[0].action!=0 || s[0].action!=0 {return;}
 if n[0].np>0 {na_nav_pending(s);return;}
 if n[0].account_refresh {n[0].account_refresh=false;na_http(s,"/api/chat/history/v1","",71);return;}
 nav_next(n);b:=n[0].browser[..];if b[0].action==4 {s[0].action=4;s[0].flight=4;s[0].purpose=70;s[0].out_n=na_copy(s[0].outbox[..],cast(string)b[0].body[0..<b[0].nb]);b[0].action=0;}
}
na_nav_pending :: (s:[]Starter) {n:=s[0].navigation[..];if n[0].np==0 || s[0].flight!=0 {return;}b:[96]u8;size:=na_copy(b[..],cast(string)n[0].pending[0..<n[0].np]);n[0].np=0;_:=na_nav_press(s,cast(string)b[0..<size]);s[0].dirty=true;}
na_nav_press :: (s:[]Starter,id:string)->bool {
 n:=s[0].navigation[..];e:=s[0].environments[..];
 if na_dm_nav(s,id) {return true;}
 if na_durable_press(s,id) {return true;}
 if dca_blocked(s[0].durable[..]) && (id.count>=4 && id[0..<4]=="nav." || id.count>=8 && id[0..<8]=="private." || id.count>=9 && id[0..<9]=="projects.") && id!="nav.toggle" && id!="nav.close" && id!="nav.settings" {nav_note(n,"Check the saved chat request before changing conversations.");return true;}
 if id=="account.logout" || id=="app.updates" || id=="app.details" {
  if s[0].flight!=0 || e[0].flight || e[0].random || s[0].action!=0 {n[0].np=ea_copy(n[0].pending[..],id);return true;}
  na_request(s,ifx id=="account.logout" then 5 else ifx id=="app.updates" then 6 else 7,"");return true;
 }
 if na_pr_press(s,id) {return true;}
 if na_project_press(s,id) {return true;}
 if na_shell_press(s,id) {return true;}
 if id=="nav.history" {n[0].history_open = !n[0].history_open;return true;}
 if id=="nav.toggle" {n[0].open = !n[0].open;n[0].rail=false;n[0].creating=false;return true;}
 if id=="nav.recent" {n[0].rail=false;n[0].open=true;n[0].history_open=true;return true;}
 if id=="nav.close" {n[0].open=false;n[0].creating=false;return true;}
 if id=="app.components" {na_text_effect(s,true,"https://openagents.com/components-gpu",id);return true;}
 if id=="nav.settings" {n[0].open=false;n[0].settings=false;acs_open(s[0].account_settings[..],false);return true;}
 if id=="nav.settings.close" || id=="extras.more" {n[0].settings=false;return id!="extras.more";}
 if id=="nav.refresh" {if s[0].flight==0 && !e[0].flight && !e[0].random {n[0].open=true;n[0].refresh=true;na_http(s,"/api/chat/history/v1","",71);}return true;}
 if id=="nav.account.older" {n[0].account_at+=n[0].page_size;return true;}
 if id=="nav.account.latest" {n[0].account_at=0;return true;}
 for i:0..<64 {a:[96]u8;if id==tr_join(a[..],"nav.latest.",i) {n[0].groups[i].offset=0;return true;}}
 if id=="nav.new" || id=="nav.compose" {if !e[0].uncertain && !e[0].random {n[0].rail=false;n[0].open=true;n[0].creating=true;n[0].nq=0;dm_value(s[0].dom[..],"nav.search","");}else {nav_note(n,"Reconnect to resolve the current command before changing chats.");}return true;}
 recognized:=id=="nav.account.new";host:= -1;row:= -1;account:= -1;
 for i:0..<n[0].browser[0].catalog[0].n {b:[96]u8;if id==tr_join(b[..],"nav.new.",i) {host=i;recognized=true;}}
 for i:0..<n[0].n {b:[96]u8;if id==nav_row_id(n,i,b[..]) {row=i;host=n[0].rows[i].host;recognized=true;}}
 for i:0..<s[0].chats[0].n {b:[96]u8;if id==tr_join(b[..],"nav.account.",i) {account=i;recognized=true;}}
 for i:0..<n[0].browser[0].catalog[0].n {buf:[96]u8;if id==tr_join(buf[..],"nav.more.",i) {
  count:=0;entry:=n[0].browser[0].catalog[0].entries[i];for r:0..<n[0].n {item:=n[0].rows[r];if item.host==i && nav_match(n,cast(string)item.session.title[0..<item.session.nt],cast(string)entry.label[0..<entry.nl]) {count+=1;}}
  if n[0].groups[i].offset+n[0].page_size<count {n[0].groups[i].offset+=n[0].page_size;return true;}
  if n[0].groups[i].nc==0 {return true;}
  if s[0].flight!=0 || e[0].flight || e[0].random {nav_note(n,"Wait for the current request before loading more history.");return true;}
  n[0].groups[i].offset=count;b:=n[0].browser[..];b[0].selected=i;b[0].view[0].nc=ea_copy(b[0].view[0].cursor[..],cast(string)n[0].groups[i].cursor[0..<n[0].groups[i].nc]);b[0].uncertain=false;eu_press(b,"env.more");na_nav_tick(s);return true;
 }}
 if !recognized {return false;}
 if e[0].flight && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="ReadSession" && !e[0].uncertain {n[0].np=ea_copy(n[0].pending[..],id);return true;}
 if e[0].uncertain || e[0].random || e[0].flight || e[0].action!=0 && e[0].action!=12 {nav_note(n,"Wait for the current request, or reconnect before changing chats.");return true;}
 if s[0].flight!=0 {if s[0].purpose==70 || s[0].purpose==71 || s[0].purpose>=132 && s[0].purpose<=137 || s[0].purpose>=140 && s[0].purpose<=143 || s[0].purpose==146 {n[0].np=ea_copy(n[0].pending[..],id);}else {nav_note(n,"Wait for the current turn before changing chats.");}return true;}
 s[0].usage[0].active=false;na_nav_keep(s);s[0].project_thread_n=0;s[0].project_link_pending=false;
 if host>=0 {
  e[0]=EnvironmentApp.{};e[0].active=true;e[0].workspace=true;e[0].page=2;e[0].selected=host;e[0].catalog[0]=n[0].browser[0].catalog[0];e[0].offer[0]=n[0].groups[host].offer;s[0].page=4;
  if row>=0 {summary:=n[0].rows[row].session;e[0].ns=ea_copy(e[0].session[..],cast(string)summary.id[0..<summary.ni]);e[0].view[0].sessions[0]=summary;e[0].view[0].ns=1;eu_request(e,"ReadSession");eu_http(e,false);}
  na_nav_restore(s);
 }else if account>=0 {
  item:=s[0].chats[0].items[account];rid:=cast(string)item.id[0..<item.id_n];
  if rid.count!=22 || rid[0]!='m' || rid[1]!='_' {nav_note(n,"This older account chat opens on openagents.com/chat.");return true;}
  e[0].active=false;s[0].selected=account;folder:=cast(string)item.folder[0..<item.folder_n];if folder.count==36 && folder[0..<4]=="prj_" {na_pr_open(s,folder);s[0].purpose=121;s[0].project[0].resume_n=pr_copy(s[0].project[0].resume_chat[..],rid);return true;}s[0].project_thread_n=0;s[0].project[0].canonical=false;path:[96]u8;at:=mc(path[..],0,"/api/chat/thread/v1?id=");at=mc(path[..],at,rid);na_http(s,cast(string)path[0..<at],"",3);
 }else {e[0].active=false;na_new(s);na_nav_restore(s);}
 n[0].open=false;n[0].creating=false;nav_note(n,"");return true;
}
na_nav_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 n:=s[0].navigation[..];b:=n[0].browser[..];x:=k_side(t,"nav.sidebar","Navigation");tr_attr(t,x,AT_STATE,ifx n[0].open then "open" else "closed");
 tr_attr(t,x,AT_TYPE,ifx n[0].rail then "rail" else "history");
 if n[0].rail {
  x=tr_open(t,"nav.rail.header",TG_HEADER,"");tr_attr(t,x,AT_ROLE,"toolbar");x=k_icon_button(t,"nav.close",IC_MENU,"Close navigation");tr_close(t);
  x=k_side_places(t,"nav.rail");x=k_icon_button(t,"nav.home",IC_CHAT,"Chat");tr_attr(t,x,AT_STATE,"rail");tr_attr(t,x,AT_CURRENT,ifx s[0].page<5 then "true" else "false");
  x=k_icon_button(t,"nav.projects",IC_FOLDER,"Projects");tr_attr(t,x,AT_STATE,"rail");tr_attr(t,x,AT_CURRENT,ifx ((s[0].page>=5 && s[0].page<=9) || s[0].page==11) then "true" else "false");
  x=k_icon_button(t,"nav.feed",IC_NEWS_PAPER,"Feed");tr_attr(t,x,AT_STATE,"rail");tr_attr(t,x,AT_CURRENT,ifx s[0].page==12 then "true" else "false");
  if s[0].worlds_available {x=k_icon_button(t,"world.library",IC_GLOBE,"Worlds");tr_attr(t,x,AT_STATE,"rail");}
  x=k_icon_button(t,"nav.recent",IC_HISTORY,"Recent chats");tr_attr(t,x,AT_STATE,"rail");tr_close(t);
  x=tr_open(t,"nav.rail.footer",TG_FOOTER,"side-f");x=k_icon_button(t,"nav.settings",IC_SETTINGS,"Settings");tr_attr(t,x,AT_STATE,"rail");tr_close(t);tr_close(t);return;
 }
 x=k_side_head(t,"nav.header","OpenAgents","/");tr_attr(t,x,AT_ROLE,"toolbar");tr_close(t);
 x=k_side_places(t,"nav.sidebar");x=k_icon_row(t,u,"nav.home",IC_CHAT,"Chat",s[0].page<5);x=k_icon_row(t,u,"nav.projects",IC_FOLDER,"Projects",((s[0].page>=5 && s[0].page<=9) || s[0].page==11));if s[0].worlds_available {x=k_icon_row(t,u,"world.library",IC_GLOBE,"Worlds",s[0].page==10);}x=k_icon_row(t,u,"nav.feed",IC_NEWS_PAPER,"Feed",s[0].page==12);tr_close(t);
 x=tr_open(t,"nav.history.header",TG_HEADER,"navigation-search");x=k_text(t,u,"nav.recents.label",TG_H3,"meta","Recents");tr_close(t);
 {
 x=k_side_folds(t,"nav.sidebar");visible:=0;account_matches:=0;for i:0..<s[0].chats[0].n {r:=s[0].chats[0].items[i];if nav_match(n,cast(string)r.title[0..<r.title_n],"Account") {account_matches+=1;}}
 n[0].page_size=nav_page_size(n,account_matches>0);budget:=n[0].page_size;
 if n[0].creating {x=k_text(t,u,"nav.new.title",TG_H2,"","Choose computer");}
 for host:0..<b[0].catalog[0].n {
  entry:=b[0].catalog[0].entries[host];name:=cast(string)entry.label[0..<entry.nl];g:=n[0].groups[host];count:=0;
  for i:0..<n[0].n {r:=n[0].rows[i];if r.host==host && nav_match(n,cast(string)r.session.title[0..<r.session.nt],name) {count+=1;}}
  if n[0].creating {id:[96]u8;x=k_row(t,u,tr_join(id[..],"nav.new.",host),name,"Claude Code",false);continue;}
  if n[0].nq>0 && count==0 {continue;}
  
  if !g.loaded {a:[96]u8;x=k_text(t,u,tr_join(a[..],"nav.loading.",host),TG_P,"meta","Loading chats…");}
  else if g.failed {a:[96]u8;x=k_text(t,u,tr_join(a[..],"nav.failed.",host),TG_P,"meta","Offline");}
  else if count==0 {a:[96]u8;x=k_text(t,u,tr_join(a[..],"nav.empty.",host),TG_P,"meta",ifx g.complete then "No chats yet" else "Incomplete history");}
  matched:=0;shown:=0;for i:0..<n[0].n {r:=n[0].rows[i];if r.host!=host || !nav_match(n,cast(string)r.session.title[0..<r.session.nt],name) || visible>=NAV_VISIBLE {continue;}matched+=1;if matched<=g.offset || shown>=budget {continue;}shown+=1;
   a:[96]u8;current:=s[0].page==4 && s[0].environments[0].selected>=0 && cast(string)s[0].environments[0].catalog[0].entries[s[0].environments[0].selected].host[..]==cast(string)entry.host[..] && cast(string)s[0].environments[0].session[0..<s[0].environments[0].ns]==cast(string)r.session.id[0..<r.session.ni];
   x=k_row(t,u,nav_row_id(n,i,a[..]),cast(string)r.session.title[0..<r.session.nt],ifx r.session.busy then "Working" else ifx !r.session.managed then "Read only" else "",current);visible+=1;
  }
  if g.offset>0 {latest:[96]u8;x=k_link(t,tr_join(latest[..],"nav.latest.",host),"Latest");}
  if count>g.offset+shown || g.nc>0 {more:[96]u8;x=k_link(t,tr_join(more[..],"nav.more.",host),"Earlier");}
  else if g.loaded && !g.complete && !g.failed {partial:[96]u8;x=k_text(t,u,tr_join(partial[..],"nav.partial.",host),TG_P,"meta","Incomplete history");}
 }
 if n[0].creating {x=k_row(t,u,"nav.account.new","OpenAgents","Account chat",false);x=k_row(t,u,"dm.new","Message someone","",false);}
 else {
  x=k_link(t,"dm.open","Messages");visible+=ndv_rows(s[0].messenger[0].inbox[..],s[0].dm_view[..],s[0].messenger[0].read_positions[..],t,u,budget,cast(string)n[0].query[0..<n[0].nq]);
  na_durable_rows(s,t,u,false);
  matched:=0;shown:=0;for i:0..<s[0].chats[0].n {r:=s[0].chats[0].items[i];if visible>=NAV_VISIBLE || !nav_match(n,cast(string)r.title[0..<r.title_n],"Account") {continue;}matched+=1;if matched<=n[0].account_at || shown>=budget {continue;}shown+=1;id:[96]u8;x=k_row(t,u,tr_join(id[..],"nav.account.",i),cast(string)r.title[0..<r.title_n],"",s[0].page==3 && cast(string)s[0].thread[0].id[0..<s[0].thread[0].id_n]==cast(string)r.id[0..<r.id_n]);visible+=1;}
  if n[0].account_at>0 {x=k_link(t,"nav.account.latest","Latest");}
  if account_matches>n[0].account_at+shown {x=k_link(t,"nav.account.older","Earlier");}
  if visible==0 && n[0].started && !b[0].flight && n[0].next>=b[0].catalog[0].n {x=k_text(t,u,"nav.no-results",TG_P,"meta",ifx n[0].nq>0 then "No matching titles" else "No chats yet");}
 }
 if n[0].nn>0 {x=k_text(t,u,"nav.note",TG_P,"meta",cast(string)n[0].note[0..<n[0].nn]);}
 k_side_end(t);}
 x=tr_open(t,"nav.footer",TG_FOOTER,"side-f");x=k_icon_button(t,"nav.settings",IC_AVATAR_PROFILE,"Settings");x=k_button(t,u,"nav.compose","New chat",BS_PRIMARY);tr_close(t);tr_close(t);
 if n[0].settings {
  x=tr_open(t,"nav.settings.panel",TG_SECTION,"");tr_attr(t,x,AT_ROLE,"dialog");tr_attr(t,x,AT_LABEL,"Settings");x=k_text(t,u,"nav.settings.title",TG_H2,"","Settings");
  x=k_icon_button(t,"nav.settings.close",IC_X,"Close settings");x=k_link(t,"app.updates","Updates");x=k_link(t,"app.details","About");x=k_link(t,"usage.open","Usage");x=k_link(t,"app.components","Components");x=k_link(t,"extras.more","Extras");x=k_link(t,"account.logout","Log out");if s[0].note_n>0 {x=k_text(t,u,"nav.settings.note",TG_P,"meta",cast(string)s[0].note[0..<s[0].note_n]);}tr_close(t);
 }
}

#test "settings opens shared component gallery through the existing link contract" {
 s:[1]Starter;s[0].navigation[0].settings=true;#assert na_nav_press(s[..],"app.components");
 #assert s[0].action==10 && s[0].text_busy && s[0].flight==0;
 na_reply(s[..],10,0,"{\"opened\":true}",false);#assert !s[0].text_busy;
}
