na_project_header :: (t:[]Tree,u:[]Ui,label:string) {x:=tr_open(t,"project.header",TG_HEADER,"");tr_attr(t,x,AT_ROLE,"toolbar");x=k_side_open(t,"nav.toggle","Show navigation");x=k_text(t,u,"project.title",TG_SPAN,"",label);tr_close(t);}
na_project_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 p:=s[0].project[..];na_project_header(t,u,ifx s[0].page==7 then (ifx p[0].grow then "Add files" else "New project") else ifx s[0].page==8 then "Review" else cast(string)p[0].title[0..<p[0].nt]);x:=k_link(t,"project.back","Projects");
 if p[0].nn>0 {x=k_text(t,u,"project.note",TG_P,"note",cast(string)p[0].note[0..<p[0].nn]);}
 if p[0].uncertain {x=k_icon_button(t,"project.reconnect",IC_ARROW_ROTATE_CW,"Check saved result");return;}
 if p[0].confirm>0 {x=k_text(t,u,"project.confirm.title",TG_H2,"",ifx p[0].confirm==1 then "Publish draft?" else "Delete draft + files?");x=k_text(t,u,"project.confirm.about",TG_P,"",ifx p[0].confirm==1 then "Contents become public." else "Cannot be undone.");x=k_button(t,u,"project.confirm",ifx p[0].confirm==1 then "Publish" else "Delete",ifx p[0].confirm==1 then BS_PRIMARY else BS_DESTRUCTIVE);x=k_icon_button(t,"project.cancel",IC_X,"Cancel");return;}
 if s[0].page==7 {na_project_drop_render(s,t,u);return;}
 if s[0].page==8 {na_project_review_render(s,t,u);return;}
 if s[0].page==9 {na_project_talk_render(s,t,u);return;}
 if !p[0].loaded {x=k_text(t,u,"project.loading",TG_P,"meta","Loading…");return;}
 if p[0].private_project {
  x=k_link(t,"project.chat","Chat");
  for i:0..<p[0].rows {row:=cast(string)p[0].data[p[0].starts[i]..<p[0].ends[i]];id:[96]u8;text:[4096]u8;o:[1]Jo;jo_start(o[..],text[..]);
   if row[0]=='P' {x=k_text(t,u,tr_join(id[..],"project.summary.",i),TG_P,"",pj_cell(row,2));}
   if row[0]=='G' {jo_put(o[..],pj_cell(row,4));jo_put(o[..]," · ");jo_put(o[..],pj_cell(row,2));}
   if row[0]=='D' {x=k_text(t,u,tr_join(id[..],"project.day.",i),TG_H2,"",pj_cell(row,2));}
   if row[0]=='M' {jo_put(o[..],pj_cell(row,5));jo_put(o[..]," · ");jo_put(o[..],pj_cell(row,3));jo_put(o[..],"\n");jo_put(o[..],pj_cell(row,6));}
   if row[0]=='I' {jo_put(o[..],pj_cell(row,4));jo_put(o[..]," · ");jo_put(o[..],pj_cell(row,3));jo_put(o[..],"\n");jo_put(o[..],pj_cell(row,5));}
   if row[0]=='C' {x=k_text(t,u,tr_join(id[..],"project.list.",i),TG_H2,"",pj_cell(row,2));}
   if o[0].n>0 {x=k_text(t,u,tr_join(id[..],"project.fact.",i),TG_P,"",jo_text(o[..]));}
  }
 }else {x=k_link(t,"project.grow","Add files");x=k_link(t,"project.chats","Chats");if p[0].request==1 {x=k_icon_button(t,"project.chat.new",IC_PLUS,"New project chat");for i:0..<p[0].chats[0].n {b:[96]u8;r:=p[0].chats[0].items[i];x=k_row(t,u,tr_join(b[..],"project.saved.",i),cast(string)r.title[0..<r.title_n],"",false);}}x=k_message(t,u,"project.document",true,s[0].markdown[..],cast(string)p[0].article[0..<p[0].na]);}
}
na_project_drop_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 p:=s[0].project[..];x:= -1;
 if !p[0].may {return;}
 x=k_code_field(t,u,"project.notes","","Notes");tr_attr(t,x,AT_VALUE,cast(string)p[0].notes[0..<p[0].nnotes]);x=k_link(t,"project.notes.add","Add notes");x=k_link(t,"project.files.add","Attach file");
 d:[1]Jv;nodes:[2048]JvNode;if jv_parse(d[..],cast(string)p[0].drop_info[0..<p[0].ninfo],nodes[..]) {v:=d[0];list:=jv_get(v,0,"files");for i:0..<jv_len(v,list) {b:[96]u8;name:[256]u8;status:[64]u8;row:=jv_at(v,list,i);x=k_text(t,u,tr_join(b[..],"project.file.",i),TG_P,"",pjw_text(v,jv_get(v,row,"name"),name[..]));x=k_text(t,u,tr_join(b[..],"project.file.status.",i),TG_P,"meta",pjw_text(v,jv_get(v,row,"status"),status[..]));}}
 if p[0].ndrop>0 {x=k_link(t,"project.read","Draft");x=k_link(t,"project.discard","Discard");}
 if jv_parse(d[..],cast(string)p[0].drops[0..<p[0].nl],nodes[..]) {v:=d[0];list:=jv_get(v,0,"drops");x=k_text(t,u,"project.drafts.title",TG_H2,"","Saved drafts");for i:0..<jv_len(v,list) {row:=jv_at(v,list,i);status:=jv_raw(v,jv_get(v,row,"status"));if status!="open" && status!="approved" {continue;}target:=jv_get(v,row,"project");if (p[0].grow && jv_raw(v,target)!=pja_slug(p)) || (!p[0].grow && jv_kind(v,target)==JV_STRING && jv_raw(v,target).count>0) {continue;}b:[96]u8;name:[80]u8;x=k_row(t,u,tr_join(b[..],"project.resume.",i),pjw_text(v,jv_get(v,row,"id"),name[..]),"Continue draft",false);}}
}
na_project_review_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 x:= -1;p:=s[0].project[..];if p[0].field>=0 {label:[512]u8;x=k_text(t,u,"project.field.title",TG_H2,"",pj_label(pja_jv(p),p[0].form[..],p[0].field,label[..]));x=k_code_field(t,u,"project.edit","","Value");tr_attr(t,x,AT_VALUE,cast(string)p[0].edit[0..<p[0].ne]);x=k_link(t,"project.field.save","Save");x=k_icon_button(t,"project.field.close",IC_X,"Cancel edit");return;}
 v:=pja_jv(p);if !v.ok {return;}if jv_raw(v,jv_get(v,0,"status"))!="ready" {x=k_text(t,u,"project.draft.waiting",TG_P,"meta","Drafting…");return;}
 // the website's rows (coax/lib/project/draft.coax): a notice, section headings, groups, and the fields a member changes
 for i:p[0].field_at..<p[0].form[0].n {if i>=p[0].field_at+16 {break;}kind:=p[0].form[0].rows[i].kind;label:[512]u8;value:[1024]u8;id:[96]u8;name:=pj_label(v,p[0].form[..],i,label[..]);
  if kind=='N' {x=k_text(t,u,tr_join(id[..],"project.notice.",i),TG_P,"meta",name);continue;}
  if kind=='H' {x=k_text(t,u,tr_join(id[..],"project.section.",i),TG_H3,"",name);continue;}
  if kind=='G' {x=k_text(t,u,tr_join(id[..],"project.group.",i),TG_P,"meta",name);continue;}
  preview:=ifx kind=='A' then "Add" else pj_preview(v,p[0].form[..],i,p[0].scratch[..],value[..]);x=k_row(t,u,tr_join(id[..],"project.field.",i),name,ifx preview.count>0 then preview else "Edit",false);}
 if p[0].field_at>0 {x=k_link(t,"project.fields.prev","Previous");}if p[0].field_at+16<p[0].form[0].n {x=k_link(t,"project.fields.next","More");}
 x=k_link(t,"project.publish",ifx p[0].grow then "Accept" else "Publish");x=k_link(t,"project.discard","Discard");
}
na_project_talk_render :: (s:[]Starter,t:[]Tree,u:[]Ui) {
 x:= -1;p:=s[0].project[..];x=k_link(t,"project.chat.back","Project");x=tr_open(t,"project.transcript",TG_SECTION,"transcript");tr_attr(t,x,AT_STATE,pja_slug(p));
 for i:0..<p[0].turns {row:=cast(string)p[0].talk[p[0].ts[i]..<p[0].te[i]];id:[96]u8;
  if row[0]=='U' {x=k_message(t,u,tr_join(id[..],"project.user.",i),false,s[0].markdown[..],pj_cell(row,6));answer:=pj_cell(row,7);if answer.count>0 {x=k_message(t,u,tr_join(id[..],"project.answer.",i),true,s[0].markdown[..],answer);}state:=pj_cell(row,3);if state=="queued" || state=="running" {x=k_text(t,u,tr_join(id[..],"project.working.",i),TG_P,"meta",pj_cell(row,13));x=k_link(t,tr_join(id[..],"project.stop.",i),"Stop turn");}if pj_cell(row,11)=="1" {x=k_link(t,tr_join(id[..],"project.undo.",i),"Undo turn");}err:=pj_cell(row,8);if err.count>0 {x=k_text(t,u,tr_join(id[..],"project.turn.error.",i),TG_P,"note",err);}}
  if row[0]=='E' {x=k_tool(t,u,tr_join(id[..],"project.tool.",i),ifx pj_cell(row,3)=="agent.edit" then "Edit" else "Agent",pj_cell(row,1),p[0].tools[i],"",pj_cell(row,4));}
  if row[0]=='G' {for g:0..<p[0].rows {goal:=cast(string)p[0].data[p[0].starts[g]..<p[0].ends[g]];if goal[0]=='G' && pj_cell(goal,1)==pj_cell(row,1) {x=k_text(t,u,tr_join(id[..],"project.proposal.",i),TG_P,"",pj_cell(goal,4));}}x=k_link(t,tr_join(id[..],"project.agree.",i),"Agree to proposed goal");x=k_text(t,u,tr_join(id[..],"project.agreement.",i),TG_P,"meta",pj_cell(row,2));}
 }tr_close(t);
 if p[0].agent {f:=k_composer_begin(t,u,"project.message","Message");k_composer_end(t,u,"project.message","Send",p[0].nm>0 && !p[0].busy && (s[0].flight==0 || s[0].flight==12));}else {x=k_text(t,u,"project.no-agent",TG_P,"meta","Agent unavailable");}
}
#test "draft publication needs a ready draft and an explicit confirmation" {
 s:[1]Starter;s[0].workspace=true;s[0].page=8;#assert na_project_press(s[..],"project.publish") && s[0].flight==0 && s[0].project[0].confirm==0;
 p:=s[0].project[..];p[0].ndrop=pja_copy(p[0].drop[..],"d_123");#assert pja_load_draft(p,"{\"status\":\"ready\",\"draft\":{\"card\":{\"name\":\"Test\"}}}");#assert na_project_press(s[..],"project.publish") && p[0].confirm==1 && s[0].flight==0;
 #assert na_project_press(s[..],"project.confirm") && s[0].purpose==102 && na_project_request_path(s[..])=="/api/drops/d_123/publish";
}
#test "a lost draft mutation checks the saved result without repeating the write" {
 s:[1]Starter;s[0].workspace=true;s[0].page=8;p:=s[0].project[..];p[0].ndrop=pja_copy(p[0].drop[..],"d_123");na_drop_http(s[..],"draft/edit","{}",98);s[0].action=0;na_reply(s[..],4,0,"",true);#assert p[0].uncertain;
 #assert na_project_press(s[..],"project.reconnect") && s[0].purpose==97 && na_project_request_path(s[..])=="/api/drops/d_123" && !p[0].mutation;
}
#test "project inference cannot begin before its saved transcript is linked" {
 s:[1]Starter;s[0].workspace=true;s[0].page=3;s[0].project_thread_n=na_copy(s[0].project_thread[..],"mobile-kit");s[0].project_link_pending=true;_:=na_copy(s[0].thread[0].id[..],"m_00000000000000000001");s[0].thread[0].id_n=22;
 na_complete(s[..]);#assert s[0].purpose==94 && na_project_request_path(s[..])=="/api/chat/project/v1";
 s[0].action=0;na_reply(s[..],4,503,"{}",false);#assert s[0].retry && s[0].project_link_pending && s[0].flight==0;
}

#test "draft field edits encode a complete JSON value after their path" {
 s:[1]Starter;s[0].workspace=true;p:=s[0].project[..];p[0].ndrop=pja_copy(p[0].drop[..],"d_123");#assert pja_load_draft(p,"{\"status\":\"ready\",\"draft\":{\"card\":{\"name\":\"A\"}}}");p[0].field=1;p[0].ne=pja_copy(p[0].edit[..],"New name");#assert na_project_press(s[..],"project.field.save");d:[1]Jv;n:[64]JvNode;body:[24000]u8;#assert jv_parse(d[..],cast(string)s[0].outbox[0..<s[0].out_n],n[..]);size:=jv_str(d[0],jv_get(d[0],0,"body"),body[..]);#assert size>0 && jv_parse(d[..],cast(string)body[0..<size],n[..]) && jv_len(d[0],jv_get(d[0],0,"path"))==2 && jv_raw(d[0],jv_get(d[0],0,"value"))=="New name";
 #assert cast(string)body[0..<size]=="{\"path\":[\"card\",\"name\"],\"value\":\"New name\"}";
}

#test "the draft review draws the website's rows: headings, groups, readable names and add rows" {
 s:[1]Starter;s[0].workspace=true;s[0].page=8;p:=s[0].project[..];
 #assert pja_load_draft(p,"{\"status\":\"ready\",\"draft\":{\"roadmap\":{\"milestones\":[{\"title\":\"First\",\"tasks\":[{\"title\":\"Build\",\"acceptance\":[\"works\"]}]}]},\"card\":{\"name\":\"Moon\",\"line\":\"A moon\"},\"mechanics\":[\"Walk\"]}}");
 t:[1]Tree;u:[1]Ui;ui_begin(u[..],0,true);tr_begin(t[..]);na_project_review_render(s[..],t[..],u[..]);
 #assert tr_text_of(t[..],tr_find(t[..],"project.section.0"))=="CARD" && tr_text_of(t[..],tr_find(t[..],"project.field.1.t"))=="Name" && tr_text_of(t[..],tr_find(t[..],"project.field.1.m"))=="Moon";
 #assert tr_text_of(t[..],tr_find(t[..],"project.field.2.t"))=="One line" && tr_text_of(t[..],tr_find(t[..],"project.section.3"))=="MECHANICS" && tr_text_of(t[..],tr_find(t[..],"project.field.4.t"))=="Mechanic 1";
 #assert tr_text_of(t[..],tr_find(t[..],"project.field.5.t"))=="+ add a mechanic" && tr_text_of(t[..],tr_find(t[..],"project.field.5.m"))=="Add" && tr_text_of(t[..],tr_find(t[..],"project.section.6"))=="ROADMAP";
 #assert tr_text_of(t[..],tr_find(t[..],"project.group.7"))=="MILESTONE 1  First" && tr_text_of(t[..],tr_find(t[..],"project.group.9"))=="TASK 1  Build" && tr_text_of(t[..],tr_find(t[..],"project.field.11.t"))=="Check 1";
 #assert tr_find(t[..],"project.field.0")<0 && !na_project_press(s[..],"project.field.0") && na_project_press(s[..],"project.field.1") && p[0].field==1 && cast(string)p[0].edit[0..<p[0].ne]=="Moon";
 #assert na_project_press(s[..],"project.field.close") && na_project_press(s[..],"project.field.5") && p[0].ne==0;
}
#test "project recovery remains blocked until a saved response is readable" {
 s:[1]Starter;s[0].workspace=true;s[0].page=8;p:=s[0].project[..];p[0].ndrop=pja_copy(p[0].drop[..],"d_123");p[0].uncertain=true;#assert na_project_press(s[..],"project.reconnect");s[0].action=0;na_reply(s[..],4,0,"",true);#assert p[0].uncertain && s[0].action==0;#assert na_project_press(s[..],"project.reconnect");s[0].action=0;na_reply(s[..],4,200,"{\"files\":[]}",false);#assert p[0].uncertain && s[0].purpose==98;s[0].action=0;na_reply(s[..],4,200,"{\"status\":\"ready\",\"draft\":{\"card\":{\"name\":\"Saved\"}}}",false);#assert !p[0].uncertain && s[0].action==0;
}

#test "quote-heavy project notes refuse an overflowing effect instead of trapping" {
 s:[1]Starter;s[0].workspace=true;s[0].page=7;p:=s[0].project[..];p[0].ndrop=pja_copy(p[0].drop[..],"d_123");for i:0..<p[0].notes.count {p[0].notes[i]='"';}p[0].nnotes=p[0].notes.count;#assert na_project_press(s[..],"project.notes.add") && s[0].action==0 && s[0].flight==0 && p[0].nn>0;
}
