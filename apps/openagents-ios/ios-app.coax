// Unified Coax root for OpenAgents iOS (100% OpenAgents Cloud mode):
// compiles Spark wallet & NIP-06 #authority policies, Cloud Chat v2 wire codec,
// Tier 1 Cloud Tools allowlist, Auto placement policy, Full Auto & Voice Duplex policies,
// component atlas tables, and GPU iOS page into one C library (Generated/gallery.c + Generated/gallery.h).
//   coax/bin/coax test apps/openagents-ios/ios-app.coax
#run_steps 250000000;
#load "../../components/raster/host-tables.coax";
#load "../../pay/wallet.coax";
#load "../../pay/wallet-backup.coax";
#load "../../coax/lib/nostr/nip06.coax";
#load "../../coax/web/api/account-chat-cloud-wire.coax";
#load "../../coax/lib/cloud/tool-wire.coax";
#load "../../coax/lib/agent/engine/placement-policy.coax";
#load "../../coax/lib/agent/desktop/full-auto.coax";
#load "../../coax/lib/agent/desktop/voice-duplex.coax";
#load "gpu-page.coax";

ios_cc_copy :: (out: [] u8, src: string) -> int #effects(all) {
  if src.count > out.count { return -1; }
  for c, i: src { out[i] = c; }
  return src.count;
}

ios_cc_submit_write :: (
  operation: string,
  conversation: string,
  revision: int,
  project: string,
  project_revision: int,
  prompt: string,
  out: [] u8
) -> int #export_c #effects(all) {
  texts := [1] string.[prompt];
  return ct_submit_write(operation, conversation, revision, project, project_revision, "", -1, texts[..], out);
}

ios_cc_stop_write :: (operation: string, turn: string, out: [] u8) -> int #export_c #effects(all) {
  return ct_stop_write(operation, turn, out);
}

ios_cc_tool_kind_valid :: (tool: string) -> bool #export_c #effects(all) {
  return cld_tool_kind(tool) != CLD_TOOL_NONE;
}

ios_cc_web_tools_json :: (out: [] u8) -> int #export_c #effects(all) {
  return ios_cc_copy(out, CLD_WEB_TOOLS_JSON);
}

ios_cc_classify_prompt :: (prompt: string) -> int #export_c #effects(all) {
  return pl_classify_prompt(prompt);
}

ios_cc_fa_should_gate :: (full_auto: bool, approval_mode: bool) -> bool #export_c #effects(all) {
  pol := FaPolicy.{full_auto = full_auto, auto_answer_questions = true, unrestricted_paths = true};
  return fa_should_gate(pol, approval_mode, 0, false);
}

ios_cc_fa_decide_prompt :: (full_auto: bool, auto_answer_questions: bool, kind: int) -> int #export_c #effects(all) {
  pol := FaPolicy.{full_auto = full_auto, auto_answer_questions = auto_answer_questions, unrestricted_paths = true};
  return fa_decide_prompt(pol, kind);
}

ios_cc_vd_vad_step :: (state_io: [] int, rms_bp: int, dt_ms: int) -> int #export_c #effects(all) {
  if state_io.count < 7 { return VD_EV_NONE; }
  st: [1] VdState;
  st[0] = VdState.{
    state = state_io[0],
    speech_seen = state_io[1] != 0,
    silence_ms = state_io[2],
    barge_frames = state_io[3],
    silence_commit_ms = ifx state_io[4] > 0 then state_io[4] else VD_DEFAULT_SILENCE_MS,
    vad_floor_bp = ifx state_io[5] > 0 then state_io[5] else 800,
    barge_floor_bp = ifx state_io[6] > 0 then state_io[6] else 2200,
  };
  ev := vd_vad_step(st[..], rms_bp, dt_ms);
  state_io[0] = st[0].state;
  state_io[1] = ifx st[0].speech_seen then 1 else 0;
  state_io[2] = st[0].silence_ms;
  state_io[3] = st[0].barge_frames;
  state_io[4] = st[0].silence_commit_ms;
  state_io[5] = st[0].vad_floor_bp;
  state_io[6] = st[0].barge_floor_bp;
  return ev;
}

ios_cc_vd_sanitize_speech :: (src: string, out: [] u8) -> int #export_c #effects(all) {
  return vd_sanitize_speech(src, out);
}

ios_cc_vd_sentence_end :: (src: string) -> int #export_c #effects(all) {
  return vd_sentence_end(src);
}

#test "OpenAgents iOS Cloud root exports submit, stop, tools, placement, Full Auto, and Voice Duplex policies" {
  buf: [4096] u8;
  sn := ios_cc_submit_write("ios-op-1", "", 0, "", -1, "Check the build", buf[..]);
  #assert sn > 0;
  stn := ios_cc_stop_write("ios-stop-1", "trn_0123456789abcdef0123456789abcdef", buf[..]);
  #assert stn > 0;
  #assert ios_cc_tool_kind_valid("web_search") && ios_cc_tool_kind_valid("github_read_file") && !ios_cc_tool_kind_valid("bash");
  #assert ios_cc_web_tools_json(buf[..]) > 100;
  #assert ios_cc_classify_prompt("Explain Coax") == PL_WORK_READ_ONLY;
  #assert ios_cc_classify_prompt("Run coax test and fix the build") == PL_WORK_CODE_EXEC;
  #assert !ios_cc_fa_should_gate(true, true) && ios_cc_fa_should_gate(false, true);
  #assert ios_cc_fa_decide_prompt(true, true, 0) == FA_DECIDE_AUTO_ALLOW;
  #assert ios_cc_fa_decide_prompt(false, true, 0) == FA_DECIDE_PROMPT;
  vd := [7] int.[1, 0, 0, 0, 1200, 800, 2200];
  #assert ios_cc_vd_vad_step(vd[..], 1500, 100) == VD_EV_NONE;
  #assert ios_cc_vd_vad_step(vd[..], 100, 1300) == VD_EV_AUTO_SEND;
  #assert ios_cc_vd_sentence_end("Hello world. Next") == 12;
  #assert ios_cc_vd_sanitize_speech("**Hi** `there`", buf[..]) > 0;
}
