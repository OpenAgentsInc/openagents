// Lean compiled Coax C core for OpenAgents for iOS (GitHub #13993, Option 2).
// Compiles to Generated/mobile_core.c + Generated/mobile_core.h with ZERO GPU
// renderer, ZERO AppCore/durable-chat/account-view-wire, and ZERO relay code.
//
// Exports the protocol, cryptography, Tailscale framing, and Antigravity-only
// model/effort policy rules that the native SwiftUI shell calls via mobile-core-bridge.c:
//   - NIP-44 device identity & request/reply sealing/opening (apps/shared/app/device/seal.coax)
//   - Tailscale admission & direct transport codecs (coax/lib/nostr/host/tailnet.coax)
//   - Environment runtime wire & request builder (coax/lib/agent/environment/wire.coax)
//   - Workspace wire (coax/lib/agent/workspace/wire.coax)
//   - Antigravity-only model & effort policy (coax/lib/agent/environment/phone-agent-policy.coax)
//
//   coax/bin/coax test apps/openagents-ios/mobile-core.coax
#run_steps 250000000;
#load "../shared/app/device/seal.coax";
#load "../../coax/lib/nostr/host/tailnet.coax";
#load "../../coax/lib/agent/environment/phone-agent-policy.coax";

mc_copy :: (out: [] u8, s: string) -> int #effects(all) {
  if s.count > out.count { return -1; }
  for c, i: s { out[i] = c; }
  return s.count;
}

// Canonical 64-char lowercase hex host public key check.
mc_host_key_ok :: (key: string) -> bool #export_c #effects(all) {
  return hb_hex64(key);
}

// Antigravity-only mobile model policy (#13993): only Antigravity / Gemini models are permitted.
mc_is_agy_model :: (id: string) -> bool #export_c #effects(all) {
  return pa_mobile_agy_allowed(id);
}

// Normalizes a model choice strictly within Antigravity (defaults to "gemini-4-neon").
mc_normalize_agy_model :: (want: string, out: [] u8) -> int #export_c #effects(all) {
  return mc_copy(out, pa_mobile_agy_model(want));
}

// Normalizes a thinking effort level for Antigravity ("low" | "medium" | "high" | "xhigh").
mc_normalize_agy_effort :: (model: string, want: string, out: [] u8) -> int #export_c #effects(all) {
  return mc_copy(out, pa_effort(PA_AGY, model, want));
}

// Plain relative workspace folder validation for OpenSession.
mc_folder_ok :: (folder: string) -> bool #export_c #effects(all) {
  return ea_folder_ok(folder);
}

// Builds a bounded, policy-checked EaRequest JSON payload using caller-owned scratch q.
// Enforces at the wire boundary that any specified model is an Antigravity model (never Claude
// or Inkling), effort is valid for Antigravity, folder is only passed on OpenSession, and
// item_id is only passed on ReadSubagent / StopSubagent.
mc_env_request :: (
  q: [] EaRequest,
  method: string,
  session: string,
  command: string,
  generation: int,
  revision: int,
  text: string,
  interaction: string,
  allow: bool,
  before: int,
  issued: int,
  expires: int,
  model: string,
  effort: string,
  folder: string,
  item: string,
  out: [] u8
) -> int #export_c #effects(all) {
  if q.count < 1 || ea_right(method) < 0 { return -1; }
  if generation < 0 || revision < 0 || before < 0 || issued < 0 || expires < 0 { return -1; }
  q[0] = EaRequest.{};
  q[0].nm = ea_copy(q[0].method[..], method);
  q[0].nw = ea_copy(q[0].workspace[..], "default");
  q[0].ns = ea_copy(q[0].session[..], session);
  q[0].nc = ea_copy(q[0].command[..], command);
  q[0].nt = ea_copy(q[0].text[..], text);
  q[0].ni = ea_copy(q[0].interaction[..], interaction);
  if q[0].nm < 1 || q[0].nw < 1 || q[0].ns < 0 || q[0].nc < 0 || q[0].nt < 0 || q[0].ni < 0 { return -1; }
  q[0].generation = generation;
  q[0].revision = revision;
  q[0].allow = allow;
  q[0].before = before;
  q[0].issued = issued;
  q[0].expires = expires;
  if model.count > 0 {
    if !pa_mobile_agy_allowed(model) { return -1; }
    resolved := pa_mobile_agy_model(model);
    if !ea_choice(resolved) { return -1; }
    q[0].nmo = ea_copy(q[0].model[..], resolved);
    if q[0].nmo < 1 { return -1; }
  }
  if effort.count > 0 {
    resolved_effort := pa_effort(PA_AGY, ifx model.count > 0 then pa_mobile_agy_model(model) else PA_AGY_DEFAULT, effort);
    if !ea_choice(resolved_effort) { return -1; }
    q[0].nef = ea_copy(q[0].effort[..], resolved_effort);
    if q[0].nef < 1 { return -1; }
  }
  if folder.count > 0 {
    if method != "OpenSession" || !ea_folder_ok(folder) { return -1; }
    q[0].nf = ea_copy(q[0].folder[..], folder);
    if q[0].nf < 1 { return -1; }
  }
  sub := method == "ReadSubagent" || method == "StopSubagent";
  if sub {
    if item.count < 1 { return -1; }
    q[0].nit = ea_copy(q[0].item[..], item);
    if q[0].nit < 1 { return -1; }
  } else if item.count > 0 {
    return -1;
  }
  return ea_write(q, out);
}

// Validates an EaView JSON response matches the expected host public key and RPC method.
// Uses caller-owned scratch v so stack frames remain small.
mc_view_valid :: (v: [] EaView, host: string, method: string, raw: string) -> bool #export_c #effects(all) {
  if v.count < 1 || !hb_hex64(host) || !ea_view_read(raw, v) { return false; }
  return cast(string) v[0].host[0..<v[0].nh] == host && cast(string) v[0].method[0..<v[0].nm] == method;
}

#test "mobile core enforces Antigravity-only models and effort normalization" {
  #assert mc_is_agy_model("gemini-4-neon") && mc_is_agy_model("gemini-4-carbon") && mc_is_agy_model("antigravity");
  #assert !mc_is_agy_model("inkling-2-mini") && !mc_is_agy_model("claude-opus-5-5") && !mc_is_agy_model("default") && !mc_is_agy_model("");
  b: [64] u8;
  n := mc_normalize_agy_model("gemini-4-hydrogen", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "gemini-4-hydrogen";
  n = mc_normalize_agy_model("antigravity", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "gemini-4-neon";
  n = mc_normalize_agy_model("claude-opus-5-5", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "gemini-4-neon";
  n = mc_normalize_agy_effort("gemini-4-neon", "xhigh", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "xhigh";
  n = mc_normalize_agy_effort("gemini-4-neon", "bogus", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "medium";
}

#test "mobile core host key and relative folder validators enforce wire rules" {
  #assert mc_host_key_ok("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
  #assert !mc_host_key_ok("") && !mc_host_key_ok("79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798");
  #assert mc_folder_ok("apps/openagents-ios") && !mc_folder_ok("../etc") && !mc_folder_ok(".git");
}

#test "mc_env_request encodes valid Antigravity OpenSession and rejects non-Antigravity models" {
  q: [1] EaRequest;
  out: [24576] u8;
  r: [1] EaRequest;
  n := mc_env_request(q[..], "OpenSession", "", "0123456789abcdef0123456789abcdef", 1, 0, "Audit Tailscale transport", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "high", "apps/openagents-ios", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]);
  #assert cast(string) r[0].method[0..<r[0].nm] == "OpenSession";
  #assert cast(string) r[0].model[0..<r[0].nmo] == "gemini-4-neon";
  #assert cast(string) r[0].effort[0..<r[0].nef] == "high";
  #assert cast(string) r[0].folder[0..<r[0].nf] == "apps/openagents-ios";
  // Generic "antigravity" normalizes to "gemini-4-neon"
  n = mc_env_request(q[..], "OpenSession", "", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "antigravity", "xhigh", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "gemini-4-neon" && cast(string) r[0].effort[0..<r[0].nef] == "xhigh";
  // Non-Antigravity models are refused at the wire boundary
  #assert mc_env_request(q[..], "OpenSession", "", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "claude-opus-5-5", "high", "", "", out[..]) < 0;
  #assert mc_env_request(q[..], "OpenSession", "", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "inkling-2-mini", "medium", "", "", out[..]) < 0;
  #assert mc_env_request(q[..], "OpenSession", "", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "default", "medium", "", "", out[..]) < 0;
  // Folder rejected outside OpenSession; item_id required on ReadSubagent and rejected elsewhere
  #assert mc_env_request(q[..], "SendMessage", "sess-1", "0123456789abcdef0123456789abcdef", 1, 1, "hi", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "medium", "apps", "", out[..]) < 0;
  #assert mc_env_request(q[..], "ReadSubagent", "sess-1", "", 0, 0, "", "", false, 0, 0, 0, "", "", "", "", out[..]) < 0;
  n = mc_env_request(q[..], "ReadSubagent", "sess-1", "", 0, 0, "", "", false, 0, 0, 0, "", "", "", "item-42", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].item[0..<r[0].nit] == "item-42";
  #assert mc_env_request(q[..], "ListSessions", "", "", 0, 0, "", "", false, 0, 0, 0, "", "", "", "item-42", out[..]) < 0;
}

#test "mc_view_valid accepts matching host and method and refuses mismatches" {
  v: [1] EaView;
  h := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  v[0].nh = ea_copy(v[0].host[..], h);
  v[0].nm = ea_copy(v[0].method[..], "ListSessions");
  v[0].complete = true;
  raw: [4096] u8;
  n := ea_view_write(v[..], raw[..]);
  check: [1] EaView;
  #assert n > 0 && mc_view_valid(check[..], h, "ListSessions", cast(string) raw[0..<n]);
  #assert !mc_view_valid(check[..], h, "ReadSession", cast(string) raw[0..<n]);
  #assert !mc_view_valid(check[..], "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "ListSessions", cast(string) raw[0..<n]);
  #assert !mc_view_valid(check[..], h, "ListSessions", "{}");
}
