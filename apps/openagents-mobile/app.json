{
  "expo": {
    "name": "OpenAgents",
    "slug": "openagents-mobile",
    "scheme": "openagents",
    "version": "0.5.2",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05070d",
    "extra": {
      "openagents": {
        "pushProjectId": "9b2d1e62-fd84-4fa4-928f-fce07b733014"
      }
    },
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#05070d",
      "resizeMode": "contain"
    },
    "ios": {
      "appleTeamId": "HQWSG26L43",
      "bundleIdentifier": "com.openagents.app",
      "supportsTablet": true,
      "associatedDomains": ["applinks:openagents.com"],
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)com.openagents.app"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "133"
    },
    "android": {
      "package": "com.openagents.app"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "./plugins/with-source-built-expo-modules.cjs",
      "expo-notifications",
      "expo-live-activity",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10
          },
          "androidIntentFilters": ["text/*", "image/*"],
          "androidMultiIntentFilters": ["image/*"]
        }
      ],
      "expo-updates",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenAgents to scan an Omega desktop pairing code",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow OpenAgents to use the microphone for live conversations with Sarah.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
