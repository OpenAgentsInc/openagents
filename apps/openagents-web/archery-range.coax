// The Archery Range (openagents.com/worlds/archery-range, everglade/docs/archery-range-spec.md): a
// realm and a module of its own on the open meadow, where you shoot the Ranger's Longbow at straw
// butts for points, on foot, from horseback and from dragonback. Only the range lives here: where it
// stands, which arrows count, the tally. Nothing about drawing, aiming, flying arrows, hitting or
// riding is written here. The module is an Everglade zone (everglade/zone.coax) and the range:
//
//   the zone walks you, draws the meadow and your Ranger, holds the Longbow's rules and takes the
//   keys, the pointer and the host's messages (archery-range-face.c hands them to it);
//   the bow, its reticle, camera, pose, arrows and sounds are bow combat's (docs/verse/bow-combat.md:
//   the engine's metaverse-engine/action/bow.coax and archery.coax, Everglade's longbow.coax, zone-bow.coax and
//   held-kit.coax), with the controls every realm has;
//   a face is the engine's static target (metaverse-engine/action/target.coax): the reticle rests on it and the
//   arrow that crosses it sticks in it;
//   the butts, poles and posts are the zone's standing things (metaverse-engine/world/props.coax): you walk
//   into them, a mount goes round them, an arrow sticks in them;
//   the horse and the red dragon are Everglade's mounts (everglade/mounts.coax, zone-ride.coax),
//   standing where the range puts them (everglade/zone-mounts.coax xh_stand);
//   the layout, the faces, the points and the tally are the range's (everglade/range/);
//   the tally is drawn with the game's HUD parts, and an arrow's points rise off its face as a hit's
//   number does (metaverse-engine/action/floats.coax).
//   coax/remote/remote.sh run -- coax/bin/coax test --library apps/openagents-web/archery-range.coax --only "archery range"
#load "../../everglade/zone.coax";
#load "../../everglade/range/score.coax";
#load "../../everglade/range/place.coax";

XR_PATHS :: [2] string.["/worlds/archery-range", "/worlds/archery-range/"];
XR_BAND_NAME :: [RG_BANDS] string.["TO 15 M", "TO 25 M", "TO 40 M", "TO 60 M", "PAST 60 M"];
XR_MODE_NAME :: [RG_MODES] string.["ON FOOT", "FROM HORSEBACK", "FROM DRAGONBACK"];

// An arrow of yours in the air: how you were shooting when it left, where it left from and where
// it was last seen.
XrShot :: struct { live: bool; mode: int; from: [3] f32; last: [3] f32; }
// The realm's state: the zone it runs on, and the range.
Range :: struct {
  z: [1] EgZone;
  on: bool;
  stood: bool;                         // the faces, the boxes and the mounts are in place
  ground: [RG_PIECES] f32;             // the meadow's height under each piece (rg_piece_at)
  score: [1] RgScore;
  shot: [bow.ARROWS] XrShot;
  seen: int;                           // the arrows you have loosed that the tally has taken in
  stage_face: int = -1;                // ?range-hit=N (shots and clips): an arrow from where you stand lands in face N, once, a second in
  want: int = -1;                      // a phone's FOOT, HORSE or DRAGON button: the way of shooting asked for (RG_*), -1 none
  want_at: f32; want_put: bool;        // when it was asked, and whether you have been put beside the mount
  tally_box: cc.Box;                   // the tally (or its line) this frame, px: a tap on an upright phone opens and shuts it
  tally_foot: f32;                     // the tally's foot this frame, px: the phone's buttons sit under it
  open: bool;                          // an upright phone: the tally and its buttons are open (else one line)
}

xr_page :: (facts: string) -> bool { for p: XR_PATHS { if cc.page_path(facts, p) { return true; } } return false; }

// The page: the open meadow, a Ranger, standing behind the shooting line and looking downrange.
xr_enter :: (r: [] Range) {
  s := r[0].z[..]; s[0].creator[0].field = true;
  x := s[0].xc[..];
  if r[0].on { return; }
  r[0].on = true; x[0].own_kit = true; x[0].klass = FB_CL_RANGER; x[0].open = false;
  if x[0].started { xc_set_class(x, FB_CL_RANGER); }
  s[0].put_on = true; s[0].put_x = f32(RG_AT_X) + f32(RG_START_X); s[0].put_y = 0; s[0].put_z = f32(RG_AT_Z) + f32(RG_START_Z); s[0].put_face = 3.1415927;
}
// How you are shooting now.
xr_mode :: (r: [] Range) -> int {
  m := r[0].z[0].creator[0].mounts[0];
  return ifx egm.eg_on_dragon(m) then RG_DRAGON else ifx m.riding >= 0 then RG_HORSE else RG_FOOT;
}
// Stands the range on the meadow: its faces as the bow's targets, its boxes as the zone's standing
// things, its mesh in the scene, and the mounts behind the line. No monsters come here.
xr_stand :: (r: [] Range) {
  s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..]; g := r[0].ground[..];
  for i: 0..<RG_PIECES { at := rg_piece_at(i); g[i] = meadow_y(at[0], at[1]); }
  rg_targets(x[0].ar[0].targets[..], g);
  boxes: [RG_BOXES * 6] f32; n := rg_boxes(g, 0, boxes[..], 0);
  _ := wprops.props_set(cr[0].props[..], boxes[..], n);
  cr[0].range_on = true;
  cr[0].field_clear = [4] f32.[f32(RG_AT_X) + RG_CLEAR[0], f32(RG_AT_Z) + RG_CLEAR[1], f32(RG_AT_X) + RG_CLEAR[2], f32(RG_AT_Z) + RG_CLEAR[3]];   // open grass: no rocks in the lanes
  cr[0].field_band = RG_ROCK_BAND; cr[0].field_keep = RG_ROCK_KEEP;   // a few at its edge, none past it
  // the horse and the dragon wait looking downrange, so you sit facing the butts
  cc.xh_stand(cr, f32(RG_AT_X) + f32(RG_HORSE_X), f32(RG_AT_Z) + f32(RG_HORSE_Z), 3.1415927, f32(RG_AT_X) + f32(RG_DRAGON_X), f32(RG_AT_Z) + f32(RG_DRAGON_Z), 3.1415927);
  r[0].stood = true;
}
// The face nearest a point on the ground, for a miss's distance.
xr_nearest :: (t: tg.Targets, p: [3] f32) -> int {
  best := 0; near := 1e9f32;
  for i: 0..<t.n { dx := t.face[i].x - p[0]; dz := t.face[i].z - p[2]; d := dx * dx + dz * dz; if d < near { near = d; best = i; } }
  return best;
}
xr_far :: (f: tg.TargetFace, p: [3] f32) -> f32 { dx := f.x - p[0]; dy := f.y - p[1]; dz := f.z - p[2]; return sqrt(dx * dx + dy * dy + dz * dz); }
// One arrow has landed (or flown out): into the tally. In a face (mark), its ring's points rise off
// it; anywhere else, a miss at the distance of the face nearest where it came down.
xr_land :: (r: [] Range, sh: XrShot, mark: int, off: f32, at: [3] f32) {
  s := r[0].z[..]; x := s[0].xc[..]; now := s[0].creator[0].clock; t := x[0].ar[0].targets[0];
  if t.n == 0 { return; }
  if mark >= 0 && mark < t.n {
    f := t.face[mark]; points := rg_points(off, f.radius);
    rg_record(r[0].score[..], sh.mode, xr_far(f, sh.from), points, now);
    _ := cc.eg_numbers_mark(x[0].floats[..], at[0], at[1] + 0.25, at[2], now, points);   // Everglade's numbers (everglade/hud/numbers.coax): shown however far the face
    return;
  }
  rg_record(r[0].score[..], sh.mode, xr_far(t.face[xr_nearest(t, at)], sh.from), 0, now);
}
// Each frame, after the zone's (range_frame): the range stands, and every arrow of yours is followed until it lands.
xr_frame :: (r: [] Range, dt: f32) {
  s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  if !r[0].on || !x[0].started { return; }
  if !r[0].stood { xr_stand(r); }
  for i: 0..<XC_FOES { if !h[0].enemies[i].dead { h[0].enemies[i].dead = true; h[0].enemies[i].died = -100; h[0].enemies[i].awake = false; } }
  now := cr[0].clock; rg := r[0].shot[..];
  // ?range-hit=N: the hit a shot or clip shows, through the same landing as a loosed arrow's (xr_land)
  f := r[0].stage_face; ft := x[0].ar[0].targets[0];
  if f >= 0 && f < ft.n && now > 1 {
    r[0].stage_face = -1; c := ft.face[f];
    xr_land(r, XrShot.{live = true, mode = xr_mode(r), from = [3] f32.[s[0].you_x, s[0].you_y + 1.5, s[0].you_z]}, f, 0, [3] f32.[c.x, c.y, c.z]);
  }
  if x[0].ar[0].shots != r[0].seen {
    r[0].seen = x[0].ar[0].shots; i := x[0].ar[0].last;
    if i >= 0 && i < bow.ARROWS {
      if rg[i].live { xr_land(r, rg[i], -1, 0, rg[i].last); }   // the pool gave its slot to the new arrow
      a := x[0].ar[0].arrows[0].a[i]; rg[i] = XrShot.{live = true, mode = xr_mode(r), from = a.from, last = a.from};
    }
  }
  for i: 0..<bow.ARROWS {
    if !rg[i].live { continue; }
    a := x[0].ar[0].arrows[0].a[i];
    if a.state == bow.ARROW_FLYING { rg[i].last = bow.arrow_pos(a, now - a.t0); continue; }
    if a.state == bow.ARROW_STUCK { xr_land(r, rg[i], a.mark, a.off, a.at); } else { xr_land(r, rg[i], -1, 0, rg[i].last); }
    rg[i].live = false;
  }
}

// ---- a phone's buttons, under the tally (section 6 of the spec): FOOT, HORSE and DRAGON choose
// how you shoot, and RESET clears the tally and puts you back behind the line. A button only asks:
// each frame xr_want_step does what a player would, through the zone's own keys (zone-ride.coax).
// The dragon comes down first (X), you get off the mount you ride (E), you are put beside the mount
// you asked for, and E mounts it.
XR_BTN :: 4; XR_BTN_H :: 44.0; XR_BTN_GAP :: 6.0; XR_WANT_S :: 12.0;
XR_BTN_NAME :: [XR_BTN] string.["FOOT", "HORSE", "DRAGON", "RESET"];
xr_touch :: (r: [] Range) -> bool { return r[0].on && r[0].z[0].xc[0].started && zt_on(r[0].z[..]); }
// An upright phone (everglade/zone-touch.coax zone_compact, #13189): the tally is one line, a raised
// plate; a tap opens it whole with FOOT, HORSE, DRAGON and RESET under it, and a tap on it shuts it.
xr_folded :: (r: [] Range) -> bool { return zone_compact(r[0].z[..]) && !r[0].open; }
// The line, device px.
xr_line_box :: (r: [] Range, top: f32, k: f32, wide: f32) -> cc.Box { return cc.Box.{x0 = 12 * k, y0 = top, x1 = 12 * k + wide + 28 * k, y1 = top + 44 * k}; }
// Its words: "ON FOOT · 3/5 HITS · 27 PTS".
xr_short :: (b: [] u8, sc: RgScore, mode: int) -> int {
  t := rg_sum(sc, mode, -1);
  n := xr_text(b, 0, XR_MODE_NAME[mode]); n = xr_text(b, n, "  ·  "); n = xr_num(b, n, t.hits); n = xr_text(b, n, "/"); n = xr_num(b, n, t.shots);
  n = xr_text(b, n, " HITS  ·  "); n = xr_num(b, n, rg_sum(sc, -1, -1).points); n = xr_text(b, n, " PTS");
  return n;
}
xr_button :: (r: [] Range, i: int) -> cc.Box {
  k := r[0].z[0].creator[0].scale; wide := (f32(XR_WIDE) - f32(XR_BTN - 1) * f32(XR_BTN_GAP)) / f32(XR_BTN);
  x0 := (12 + f32(i) * (wide + f32(XR_BTN_GAP))) * k; y0 := r[0].tally_foot + f32(XR_BTN_GAP) * k;
  return cc.Box.{x0 = x0, y0 = y0, x1 = x0 + wide * k, y1 = y0 + f32(XR_BTN_H) * k};
}
// The mount a way of shooting rides: its slot among the zone's mounts, -1 on foot or before it stands.
xr_mount :: (r: [] Range, mode: int) -> int {
  cr := r[0].z[0].creator[..]; m := cr[0].mounts[0];
  if mode == RG_DRAGON { return cc.xh_dragon(cr); }
  if mode == RG_HORSE { for k: 0..<m.n { if m.kind[k] != egm.EG_DRAGON { return k; } } }
  return -1;
}
// Back behind the line with a clean tally (on foot; from the saddle, the tally alone).
xr_reset :: (r: [] Range) {
  s := r[0].z[..];
  r[0].score[0] = RgScore.{}; r[0].want = -1;
  for i: 0..<bow.ARROWS { r[0].shot[i].live = false; }
  if s[0].creator[0].mounts[0].riding < 0 {
    s[0].put_on = true; s[0].put_x = f32(RG_AT_X) + f32(RG_START_X); s[0].put_y = 0; s[0].put_z = f32(RG_AT_Z) + f32(RG_START_Z); s[0].put_face = 3.1415927;
    s[0].creator[0].yaw = 0; s[0].creator[0].pitch = 0.35;
  }
}
// A finger down on one of the buttons.
xr_press :: (r: [] Range, x: f32, y: f32, phase: int) -> bool {
  if phase != 0 || !xr_touch(r) { return false; }
  if zone_compact(r[0].z[..]) {
    if x >= r[0].tally_box.x0 && x <= r[0].tally_box.x1 && y >= r[0].tally_box.y0 && y <= r[0].tally_box.y1 { r[0].open = !r[0].open; return true; }
    if !r[0].open { return false; }
  }
  for i: 0..<XR_BTN {
    b := xr_button(r, i);
    if x < b.x0 || x > b.x1 || y < b.y0 || y > b.y1 { continue; }
    r[0].open = false;   // the world again
    if i == 3 { xr_reset(r); return true; }
    _ := xc_bow_cancel(r[0].z[..]);
    r[0].want = i; r[0].want_at = r[0].z[0].creator[0].clock; r[0].want_put = false;
    return true;
  }
  return false;
}
// A frame of what a button asked.
xr_want_step :: (r: [] Range) {
  if r[0].want < 0 { return; }
  s := r[0].z[..]; cr := s[0].creator[..]; m := cr[0].mounts[0]; now := cr[0].clock;
  if xr_mode(r) == r[0].want || now - r[0].want_at > f32(XR_WANT_S) { r[0].want = -1; return; }
  if m.riding >= 0 {
    if egm.eg_aloft(m) { _ := zone_land_key(s); return; }
    if egm.eg_mount_prompt(m, cr[0].player_x, cr[0].player_z, now, true) == "DISMOUNT" { _ := zone_mount_key(s); }
    return;
  }
  k := xr_mount(r, r[0].want); if k < 0 { r[0].want = -1; return; }
  if s[0].put_on { return; }   // the face hasn't put you there yet
  if egm.eg_mount_nearest(m, cr[0].player_x, cr[0].player_z) == k { _ := zone_mount_key(s); return; }
  if r[0].want_put { return; }
  // beside it, on the side the line is on: the nearest place in its reach
  h := m.mounts[k];
  for step: 2..<16 {
    d := f32(step) * 0.5; px := h.x + sin(h.face + 1.5708) * d; pz := h.z + cos(h.face + 1.5708) * d;
    if egm.eg_mount_nearest(m, px, pz) != k { continue; }
    s[0].put_on = true; s[0].put_x = px; s[0].put_y = 0; s[0].put_z = pz; s[0].put_face = h.face; r[0].want_put = true;
    return;
  }
  r[0].want = -1;
}
xr_buttons_draw :: (r: [] Range, out: [] f32, n0: int) -> int {
  if !xr_touch(r) || xr_folded(r) { return n0; }
  s := r[0].z[..]; k := s[0].creator[0].scale; ui := s[0].creator[0].ui; mode := xr_mode(r);
  t := cc.eg_tokens(); l: [1] cc.HudList; ws: [1] cc.HudWords; ws[0].ui = ui;
  for i: 0..<XR_BTN {
    q := xr_button(r, i); b := cc.hud_box(q.x0, q.y0, q.x1, q.y1); name := XR_BTN_NAME[i];
    cc.hud_button(l[..], t, b, k, i == mode || i == r[0].want);
    ws[0].parent = cc.uit_put(ui, cc.UIT_NONE, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, name);
    c := 9.5 * k; wide := cc.face_width(name, c, cc.HUD_FACE_TITLE) + 10 * k; if wide > b.x1 - b.x0 { c = c * (b.x1 - b.x0) / wide; }
    cc.hud_word(ws[..], name, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + c * 0.5, c, cc.HUD_TEXT_TITLE, true);
  }
  ws[0].parent = cc.UIT_NONE;
  s[0].zt_top = xr_button(r, 0).y1 + f32(XR_BTN_GAP) * k;   // the thumb's side begins under them (everglade/zone-touch.coax)
  return cc.hud_draw(out, n0, l[..], ws[..], 1, k);
}

// ---- the tally, top left where the CLASSES picker is elsewhere (the range has one class)
XR_WIDE :: 262.0; XR_ROW :: 17.0; XR_PAD :: 10.0;   // CSS px
xr_num :: (b: [] u8, n0: int, v: int) -> int { return rs_put_int(b, n0, v); }
xr_text :: (b: [] u8, n0: int, t: string) -> int { return rs_put(b, n0, t); }
// A tally's line: "ARROWS 12   HITS 9   75%   64 PTS".
xr_line :: (b: [] u8, t: RgTally) -> int {
  n := xr_text(b, 0, "ARROWS "); n = xr_num(b, n, t.shots); n = xr_text(b, n, "   HITS "); n = xr_num(b, n, t.hits);
  n = xr_text(b, n, "   "); n = xr_num(b, n, rg_accuracy(t)); n = xr_text(b, n, "%   "); n = xr_num(b, n, t.points); n = xr_text(b, n, " PTS");
  return n;
}
// A band's row: "3 / 4   75%   27 PTS".
xr_row :: (b: [] u8, t: RgTally) -> int {
  n := xr_num(b, 0, t.hits); n = xr_text(b, n, " / "); n = xr_num(b, n, t.shots); n = xr_text(b, n, "   "); n = xr_num(b, n, rg_accuracy(t));
  n = xr_text(b, n, "%   "); n = xr_num(b, n, t.points); n = xr_text(b, n, " PTS");
  return n;
}
// The rows the panel shows now: the three lines over all, the way you shoot now, a row for each
// band you have shot in that way, and the last arrow.
xr_rows :: (sc: RgScore, mode: int) -> int {
  n := 5;
  for b: 0..<RG_BANDS { if rg_sum(sc, mode, b).shots > 0 { n += 1; } }
  if sc.last_points >= 0 { n += 1; }
  return n;
}
xr_panel :: (sc: RgScore, mode: int, top: f32, k: f32) -> cc.Box {
  return cc.Box.{x0 = 12 * k, y0 = top, x1 = (12 + f32(XR_WIDE)) * k, y1 = top + (f32(xr_rows(sc, mode)) * f32(XR_ROW) + 2 * f32(XR_PAD)) * k};
}
xr_tally_draw :: (r: [] Range, out: [] f32, n0: int, w: f32, h: f32, k: f32) -> int {
  s := r[0].z[..]; x := s[0].xc[..];
  if !r[0].on || !x[0].started { return n0; }
  sc := r[0].score[0]; mode := xr_mode(r); now := s[0].creator[0].clock;
  t := cc.eg_tokens(); l: [1] cc.HudList; ws: [1] cc.HudWords; ui := s[0].creator[0].ui;
  top := ifx x[0].top > 0 then x[0].top else 20 * k;   // where the picker's top is (under a developer's ANIMATIONS bar)
  if xr_folded(r) {
    b: [96] u8; m := xr_short(b[..], sc, mode); line := cast(string) b[0..<m]; cap := 9.5 * k;
    box := xr_line_box(r, top, k, cc.face_width(line, cap, cc.HUD_FACE_TITLE));
    r[0].tally_box = box; r[0].tally_foot = box.y1; s[0].zt_top = box.y1 + f32(XR_BTN_GAP) * k;   // the thumb's side begins under it
    cc.hud_button(l[..], t, cc.hud_box(box.x0, box.y0, box.x1, box.y1), k, false);
    ws[0].ui = ui; ws[0].parent = cc.uit_put(ui, cc.UIT_NONE, cc.UIT_BUTTON, box.x0, box.y0, box.x1, box.y1, "ARCHERY RANGE");
    cc.hud_word(ws[..], line, (box.x0 + box.x1) * 0.5, (box.y0 + box.y1) * 0.5 + cap * 0.5, cap, cc.HUD_TEXT_TITLE, true);
    return cc.hud_draw(out, n0, l[..], ws[..], 1, k);
  }
  box := xr_panel(sc, mode, top, k);
  r[0].tally_box = box; r[0].tally_foot = box.y1;
  cc.hud_panel(l[..], t, cc.hud_box(box.x0, box.y0, box.x1, box.y1), k);
  ws[0].ui = ui; ws[0].parent = cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, box.x0, box.y0, box.x1, box.y1, "ARCHERY RANGE");
  left := box.x0 + f32(XR_PAD) * k; y := box.y0 + (f32(XR_PAD) + 11) * k; row := f32(XR_ROW) * k; b: [96] u8;
  cc.hud_word(ws[..], "ARCHERY RANGE", left, y, 10 * k, cc.HUD_TEXT_TITLE, false); y += row;
  all := rg_sum(sc, -1, -1);
  m := xr_line(b[..], all); cc.hud_word(ws[..], cast(string) b[0..<m], left, y, 8.5 * k, cc.HUD_TEXT_NUMBER, false); y += row;
  m = xr_text(b[..], 0, "RUN "); m = xr_num(b[..], m, sc.run); m = xr_text(b[..], m, "   BEST "); m = xr_num(b[..], m, sc.best_run); m = xr_text(b[..], m, "   GOLDS "); m = xr_num(b[..], m, all.golds);
  avg := rg_average_tenths(all); m = xr_text(b[..], m, "   AVG "); m = xr_num(b[..], m, avg / 10); m = xr_text(b[..], m, "."); m = xr_num(b[..], m, avg % 10);
  cc.hud_word(ws[..], cast(string) b[0..<m], left, y, 8.5 * k, cc.HUD_TEXT_NUMBER, false); y += row * 1.25;
  cc.hud_word(ws[..], XR_MODE_NAME[mode], left, y, 9 * k, cc.HUD_TEXT_TITLE, false); y += row;
  mine := rg_sum(sc, mode, -1);
  m = xr_line(b[..], mine); cc.hud_word(ws[..], cast(string) b[0..<m], left, y, 8.5 * k, cc.HUD_TEXT_NUMBER, false); y += row;
  for band: 0..<RG_BANDS {
    bt := rg_sum(sc, mode, band); if bt.shots == 0 { continue; }
    cc.hud_word(ws[..], XR_BAND_NAME[band], left, y, 8 * k, cc.HUD_TEXT_LABEL, false);
    m = xr_row(b[..], bt); cc.hud_word(ws[..], cast(string) b[0..<m], left + 78 * k, y, 8.5 * k, cc.HUD_TEXT_NUMBER, false); y += row;
  }
  if sc.last_points >= 0 {
    m = xr_text(b[..], 0, ifx sc.last_points > 0 then "LAST ARROW  " else "LAST ARROW  MISS");
    if sc.last_points > 0 { m = xr_num(b[..], m, sc.last_points); }
    m = xr_text(b[..], m, "  AT "); m = xr_num(b[..], m, cast(int) (sc.last_distance + 0.5)); m = xr_text(b[..], m, " M");
    // a gold is lit green for a moment, at the line's own size (the heal role's size is a floating number's)
    cc.hud_word_ink(ws[..], cast(string) b[0..<m], left, y - row * 0.1, 8.5 * k, cc.HUD_TEXT_LABEL, false, now - sc.last_at < 2.5 && sc.last_points >= 9, cc.hud_rgba(0.45, 0.95, 0.5, 1));
  }
  return cc.hud_draw(out, n0, l[..], ws[..], 1, k);
}


// ---- the realm: what archery-range-face.c calls that isn't the zone's alone
coaxial_range_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_range_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_range_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }
// The frame: the zone's, then in the world the range's arrows and its tally over the zone's HUD.
range_frame :: (r: [] Range, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  s := r[0].z[..];
  if !s[0].creator[0].on { return 0; }
  zone_begin(s);
  n := zone_draw(s, out, u, width, height, dpr, dt, still);
  if zone_world(s) { xr_want_step(r); xr_frame(r, ifx still then 0.0f32 else dt); n = xr_tally_draw(r, out, n, width, height, hi(dpr, 0.5)); n = xr_buttons_draw(r, out, n); }
  return zone_finish(s, out, u, n, dt, still);
}
// A pointer: a phone's buttons under the tally, then the zone's.
range_pointer :: (r: [] Range, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  s := r[0].z[..];
  if kind != 0 && s[0].creator[0].on && xr_press(r, x, y, phase) { s[0].zt_thumb = false; return true; }
  return zone_pointer(s, x, y, phase, kind, id);
}
range_pointer_buttons :: (r: [] Range, x: f32, y: f32, phase: int, kind: int, id: int, button: int) -> bool #export_c #effects(all) {
  if kind != 0 { return range_pointer(r, x, y, phase, kind, id); }
  return zone_pointer_buttons(r[0].z[..], x, y, phase, kind, id, button);
}
// A message from the host: the zone's, or the page's facts, which stand the range (this module has one page).
range_message :: (r: [] Range, kind: int, t: string) #export_c #effects(all) {
  s := r[0].z[..];
  if zone_message(s, kind, t) { return; }
  if kind == HOST_PAGE { xr_enter(r); zone_enter(s, t); xr_staged(r, t); }
}
// On a local page, ?range-hit=N stages a hit in face N (rg_piece order) for shots and clips.
xr_staged :: (r: [] Range, facts: string) {
  if !cc.dev_local(facts) { return; }
  key := "range-hit="; i := 0;
  while i + 1 + key.count < facts.count {
    if (facts[i] == '?' || facts[i] == '&') && facts[i + 1..<i + 1 + key.count] == key {
      j := i + 1 + key.count; v := 0; any := false;
      while j < facts.count && facts[j] >= '0' && facts[j] <= '9' && v < 1000 { v = v * 10 + cast(int) (facts[j] - '0'); j += 1; any = true; }
      if any { r[0].stage_face = v; }
      return;
    }
    i += 1;
  }
}

// ---- checks
xr_test_lab :: (r: [] Range) {
  xr_enter(r); s := r[0].z[..];
  cr := s[0].creator[..]; cr[0].experimental = true; hostile.hostile_test_start(cr[0].hostiles[..]);
  xc_start(s[0].xc[..], s[0].xc[0].klass);
  w := zone_walk(s); cr[0].player_x = w.x; cr[0].player_z = w.z; cr[0].player_y = 0;
  cr[0].yaw = 0; cr[0].pitch = 0; s[0].xc[0].seen = true;
}
// The camera's eye at your shoulder and its ray toward a world point, as the frame's uniforms give them.
xr_test_look :: (r: [] Range, to: [3] f32) {
  s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[0];
  eye := [3] f32.[cr.player_x, meadow_y(cr.player_x, cr.player_z) + cr.player_y + 1.6, cr.player_z + 0.6];
  d := [3] f32.[to[0] - eye[0], to[1] - eye[1], to[2] - eye[2]]; l := sqrt(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
  x[0].u[16] = eye[0]; x[0].u[17] = eye[1]; x[0].u[18] = eye[2]; x[0].u[20] = d[0] / l; x[0].u[21] = d[1] / l; x[0].u[22] = d[2] / l;
}
xr_test_fly :: (r: [] Range, seconds: f32) {
  s := r[0].z[..];
  for k: 0..<cast(int) (seconds * 60) { s[0].creator[0].clock += 1.0 / 60; xc_bow_step(s, 1.0 / 60); xr_frame(r, 1.0 / 60); }
}
#test "archery range: the page is its own, a Ranger arrives behind the line on the open meadow, and no monster is left" #steps 400000000 {
  #assert xr_page("url=https://openagents.com/worlds/archery-range\n") && xr_page("url=http://127.0.0.1:9431/worlds/archery-range/?x=1\n") && !xr_page("url=https://openagents.com/worlds/everglade-experimental\n");
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..];
  #assert cr[0].field && x[0].klass == FB_CL_RANGER && xc_has_bow(s) && xc_own_kit(x);
  #assert cr[0].player_x == RG_AT_X + RG_START_X && cr[0].player_z == RG_AT_Z + RG_START_Z;
  xr_frame(r[..], 1.0 / 60);
  #assert cr[0].field_band == RG_ROCK_BAND && cr[0].field_keep == RG_ROCK_KEEP && cr[0].field_clear[0] == RG_AT_X + RG_CLEAR[0] && cr[0].field_clear[3] == RG_AT_Z + RG_CLEAR[3] && cr[0].field_clear[2] > cr[0].field_clear[0];
  #assert r[0].stood && x[0].ar[0].targets[0].n == RG_TARGETS && cr[0].props[0].n == RG_BOXES && cr[0].range_on;
  for i: 0..<XC_FOES { #assert cr[0].hostiles[0].enemies[i].dead; }
  // each face stands on the meadow under it
  f := x[0].ar[0].targets[0].face[2]; #assert abs(f.y - meadow_y(f.x, f.z) - RG_FACE_Y) < 0.001;
  // the zone's boxes are the walker's walls by the butt, and none back at the line
  w := zone_move_world(s, f.x, f.z + 1); #assert w.walls >= 1;
  w = zone_move_world(s, cr[0].player_x, cr[0].player_z); #assert w.walls == 0;
}
#test "archery range: a full draw at the 20 m gold sticks in the face and scores it on foot; one into the grass is a miss" #steps 2000000000 {
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..];
  xr_frame(r[..], 1.0 / 60);
  f := x[0].ar[0].targets[0].face[1];
  xr_test_look(r[..], [3] f32.[f.x, f.y, f.z]);
  aim := xc_bow_point(s); #assert aim.mark == 1 && aim.foe < 0 && abs(aim.at[2] - f.z) < 0.02;
  #assert xc_bow_begin(s, false); xr_test_fly(r[..], 1.0); #assert xc_bow_loose(s) && x[0].ar[0].last >= 0;
  xr_test_fly(r[..], 1.5);
  a := x[0].ar[0].arrows[0].a[x[0].ar[0].last];
  #assert x[0].ar[0].marks == 1 && a.state == bow.ARROW_STUCK && a.mark == 1 && abs(a.at[2] - f.z) < 0.05;
  all := rg_sum(r[0].score[0], -1, -1); foot := rg_sum(r[0].score[0], RG_FOOT, -1);
  #assert all.shots == 1 && all.hits == 1 && all.points >= 9 && foot.shots == 1 && r[0].score[0].run == 1;
  #assert rg_sum(r[0].score[0], RG_FOOT, rg_band(xr_far(f, a.from))).hits == 1 && x[0].floats[0].shown >= 1;
  // the same arrow is never counted twice while it stays stuck
  xr_test_fly(r[..], 1.0); #assert rg_sum(r[0].score[0], -1, -1).shots == 1;
  // into the grass short of the butt: a miss, and the run ends
  x[0].cool_at = -100;
  xr_test_look(r[..], [3] f32.[f.x + 3, meadow_y(f.x + 3, f.z + 8), f.z + 8]);
  #assert xc_bow_point(s).mark == -1;
  #assert xc_bow_begin(s, false); xr_test_fly(r[..], 1.0); #assert xc_bow_loose(s);
  xr_test_fly(r[..], 1.5);
  all = rg_sum(r[0].score[0], -1, -1); #assert all.shots == 2 && all.hits == 1 && r[0].score[0].run == 0 && r[0].score[0].last_points == 0;
}
#test "archery range: a hit on the 70 m butt rises as a number shown however far, never culled by sight (?range-hit)" #steps 2000000000 {
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..];
  xr_frame(r[..], 1.0 / 60);
  xr_staged(r[..], "url=http://127.0.0.1/worlds/archery-range?range-hit=4\n"); #assert r[0].stage_face == 4;
  { o: [1] Range; xr_staged(o[..], "url=https://openagents.com/worlds/archery-range?range-hit=4\n"); #assert o[0].stage_face == -1; }
  cr[0].clock = 2; xr_frame(r[..], 1.0 / 60);
  #assert r[0].stage_face == -1 && rg_sum(r[0].score[0], -1, -1).hits == 1 && x[0].floats[0].shown == 1;
  q := -1; for i: 0..<fl.FLOATS { if x[0].floats[0].items[i].on { q = i; } }
  #assert q >= 0 && cc.eg_numbers_always(x[0].floats[..], q) && abs(x[0].floats[0].items[q].z - x[0].ar[0].targets[0].face[4].z) < 0.01;
}
#test "archery range: an arrow into the straw beside the face sticks in the butt and misses; a half-drawn one drops short" #steps 2000000000 {
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; x := s[0].xc[..];
  xr_frame(r[..], 1.0 / 60);
  f := x[0].ar[0].targets[0].face[0]; edge := f.radius + f32(RG_BUTT_MARGIN) * 0.5;
  xr_test_look(r[..], [3] f32.[f.x + edge * 0.72, f.y + edge * 0.72, f.z]);   // the straw's corner, outside the rim
  aim := xc_bow_point(s); #assert aim.mark == -1 && abs(aim.at[2] - f.z) < 0.6;
  #assert xc_bow_begin(s, false); xr_test_fly(r[..], 1.0); #assert xc_bow_loose(s);
  xr_test_fly(r[..], 1.5);
  a := x[0].ar[0].arrows[0].a[x[0].ar[0].last];
  #assert a.state == bow.ARROW_STUCK && a.mark == -1 && a.at[2] < f.z + 0.5 && a.at[1] > meadow_y(f.x, f.z) + 1.0;
  #assert rg_sum(r[0].score[0], -1, -1).shots == 1 && rg_sum(r[0].score[0], -1, -1).hits == 0;
  // a tap's worth of draw at the 50 m gold comes down in the grass
  far := x[0].ar[0].targets[0].face[3]; x[0].cool_at = -100;
  xr_test_look(r[..], [3] f32.[far.x, far.y, far.z]);
  #assert xc_bow_begin(s, false); xr_test_fly(r[..], 0.1); #assert xc_bow_loose(s);
  xr_test_fly(r[..], 4.0);
  #assert x[0].ar[0].marks == 0 && rg_sum(r[0].score[0], -1, -1).shots == 2 && rg_sum(r[0].score[0], -1, -1).hits == 0;
}
#test "archery range: from the saddle a shot is tallied from horseback, and the tally's panel grows a row for its band" #steps 2000000000 {
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; x := s[0].xc[..]; cr := s[0].creator[..];
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  xr_frame(r[..], 1.0 / 60);
  h := cr[0].mounts[0].mounts[0]; #assert cr[0].mounts[0].n == 1 && h.x == RG_AT_X + RG_HORSE_X && h.z == RG_AT_Z + RG_HORSE_Z;
  cr[0].player_x = h.x + cos(h.face) * 1.6; cr[0].player_z = h.z - sin(h.face) * 1.6;
  #assert zone_mount_key(s) && cr[0].mounts[0].riding == 0 && xr_mode(r[..]) == RG_HORSE;
  rows := xr_rows(r[0].score[0], RG_HORSE);
  f := x[0].ar[0].targets[0].face[0];
  xr_test_look(r[..], [3] f32.[f.x, f.y, f.z]);
  #assert xc_bow_begin(s, false); xr_test_fly(r[..], 1.0); #assert xc_bow_loose(s);
  xr_test_fly(r[..], 1.5);
  #assert rg_sum(r[0].score[0], RG_HORSE, -1).shots == 1 && rg_sum(r[0].score[0], RG_FOOT, -1).shots == 0;
  #assert xr_rows(r[0].score[0], RG_HORSE) == rows + 2;   // its band's row, and the last arrow
  p := xr_panel(r[0].score[0], RG_HORSE, 20, 1); #assert p.y1 - p.y0 > 100 && p.x1 - p.x0 == XR_WIDE;
}
#test "archery range: a phone's HORSE puts you beside the horse and mounts it, FOOT gets you off, and RESET clears the tally and takes you back behind the line" #steps 2000000000 {
  r: [1] Range; xr_test_lab(r[..]); s := r[0].z[..]; cr := s[0].creator[..]; x := s[0].xc[..];
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  cr[0].on = true; cr[0].width = 1170; cr[0].height = 2532; cr[0].scale = 3; x[0].w = 1170; x[0].h = 2532; x[0].k = 3; x[0].seen = true;
  xr_frame(r[..], 1.0 / 60); #assert r[0].stood && xr_mount(r[..], RG_HORSE) == 0;
  out: [8192 * 16] f32; n := xr_tally_draw(r[..], out[..], 0, 1170, 2532, 3); #assert r[0].tally_foot > 0;
  // no finger has touched the page: no buttons, and a press there is the zone's
  b := xr_button(r[..], RG_HORSE); #assert !xr_press(r[..], b.x0 + 9, b.y0 + 9, 0) && xr_buttons_draw(r[..], out[..], 0) == 0;
  s[0].touch = true;
  // an upright phone (#13189): the tally is one line, a finger tall, and no buttons until a tap opens it
  #assert xr_folded(r[..]) && xr_buttons_draw(r[..], out[..], 0) == 0;
  n = xr_tally_draw(r[..], out[..], 0, 1170, 2532, 3); lb := r[0].tally_box;
  #assert n > 0 && lb.y1 - lb.y0 >= 44 * 3 && lb.x1 < 1170 && r[0].tally_foot == lb.y1 && s[0].zt_top > lb.y1;
  #assert range_pointer(r[..], lb.x0 + 9, lb.y0 + 9, 0, 1, 4) && r[0].open && !xr_folded(r[..]); _ = range_pointer(r[..], lb.x0 + 9, lb.y0 + 9, 2, 1, 4);
  n = xr_tally_draw(r[..], out[..], 0, 1170, 2532, 3); #assert r[0].tally_foot > lb.y1 && xr_buttons_draw(r[..], out[..], 0) > 0;
  // a tap on the open tally shuts it
  pb := r[0].tally_box; _ = xr_press(r[..], pb.x0 + 9, pb.y0 + 9, 0); #assert !r[0].open; _ = xr_press(r[..], pb.x0 + 9, pb.y0 + 9, 0); #assert r[0].open;
  for i: 0..<XR_BTN { q := xr_button(r[..], i); #assert q.x1 - q.x0 >= 44 * 3 && q.y1 - q.y0 >= 44 * 3 && q.y0 > r[0].tally_foot; if i > 0 { #assert q.x0 > xr_button(r[..], i - 1).x1; } }
  // HORSE: put beside it, then E
  #assert range_pointer(r[..], b.x0 + 9, b.y0 + 9, 0, 1, 5) && r[0].want == RG_HORSE && !zone_thumb(s) && !r[0].open;   // a choice gives the world back
  body := EgBody.{ground = true};
  for k: 0..<240 {
    cr[0].clock = f32(k) / 60; xr_want_step(r[..]);
    w := zone_walk(s); if w.put { body.x = w.x; body.z = w.z; }
    body = zone_keep_body(s, body, body); cr[0].player_x = body.x; cr[0].player_z = body.z;
  }
  h := cr[0].mounts[0].mounts[0];
  #assert xr_mode(r[..]) == RG_HORSE && r[0].want == -1 && abs(body.x - h.x) < 0.6 && abs(body.z - h.z) < 0.6;
  // FOOT: off again
  _ = xr_press(r[..], pb.x0 + 9, pb.y0 + 9, 0);
  f := xr_button(r[..], RG_FOOT); #assert range_pointer(r[..], f.x0 + 9, f.y0 + 9, 0, 1, 6) && r[0].want == RG_FOOT;
  for k: 240..<480 {
    cr[0].clock = f32(k) / 60; xr_want_step(r[..]);
    body = zone_keep_body(s, body, body); cr[0].player_x = body.x; cr[0].player_z = body.z;
  }
  #assert xr_mode(r[..]) == RG_FOOT && r[0].want == -1;
  // RESET: a clean tally, back behind the line
  rg_record(r[0].score[..], RG_FOOT, 20, 9, cr[0].clock); #assert rg_sum(r[0].score[0], -1, -1).shots == 1;
  _ = xr_press(r[..], pb.x0 + 9, pb.y0 + 9, 0);
  q := xr_button(r[..], 3); #assert range_pointer(r[..], q.x0 + 9, q.y0 + 9, 0, 1, 7);
  #assert rg_sum(r[0].score[0], -1, -1).shots == 0 && r[0].score[0].last_points == -1;
  w := zone_walk(s); #assert w.put && w.x == RG_AT_X + RG_START_X && w.z == RG_AT_Z + RG_START_Z;
}
// The range's routes (the range's frame: x across, z from the line, downrange negative). The horse:
// from where it waits, down between the 15 m and the 30 m lanes, past the 50 m butt, out beyond the
// 70 m one and back up the east side. The dragon on foot: over the 30 m lane's distance post (a
// 1.6 m stick: nothing to a dragon) and on downrange; then on the wing over the far butts and down.
XR_ROUTE_HORSE :: [16] f32.[-4, -15,  -4, -35,  4, -47,  4, -58,  10, -70,  12, -80,  22, -80,  22, -35];
XR_ROUTE_DRAGON :: [8] f32.[5, -15,  -3.6, -24,  -3.6, -40,  4, -52];
XR_ROUTE_WING :: [6] f32.[12, -75,  0, -100,  -20, -60];
xr_test_route :: (r: [] Range, k: int, pts: [] f32, fly: bool, now: f32) -> cc.XhWalk {
  cr := r[0].z[0].creator[..]; w: [16] f32; n := ifx pts.count < 16 then pts.count else 16;
  for i: 0..<n / 2 { w[i * 2] = f32(RG_AT_X) + pts[i * 2]; w[i * 2 + 1] = f32(RG_AT_Z) + pts[i * 2 + 1]; }
  cc.xh_test_seat(cr, k);
  return cc.xh_route(cr, w[0..<n], fly, now);
}
#test "archery range: route walk, the horse rides down the lanes and back and the dragon walks over a post, flies the butts and lands, with no snag" #steps 4000000000 {
  r: [1] Range; xr_test_lab(r[..]); cr := r[0].z[0].creator[..];
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  xr_frame(r[..], 1.0 / 60); #assert cr[0].mounts[0].n == 2 && cr[0].props[0].n == RG_BOXES;
  a := XR_ROUTE_HORSE; h := xr_test_route(r[..], 0, a[..], false, 0);
  #assert h.reached == a.count / 2 && h.blocked == 0;
  b := XR_ROUTE_DRAGON; d := xr_test_route(r[..], 1, b[..], false, 200);
  #assert d.reached == b.count / 2 && d.blocked == 0 && d.over > 0;   // the post it walked over
  c := XR_ROUTE_WING; f := xr_test_route(r[..], 1, c[..], true, 400);
  #assert f.reached == c.count / 2 && f.blocked == 0 && f.landed;
  // a butt is still a butt: the horse ridden straight at the 30 m one stops at its straw
  m := cr[0].mounts[0].mounts[0..<1]; face := r[0].z[0].xc[0].ar[0].targets[0].face[2];
  m[0].x = face.x; m[0].z = face.z + 8; m[0].face = 3.1415927; m[0].speed = 0;
  g := [2] f32.[face.x - f32(RG_AT_X), face.z - f32(RG_AT_Z) - 6]; s := xr_test_route(r[..], 0, g[..], false, 600);
  #assert s.reached == 0 && s.blocked > 0 && m[0].z > face.z;
}
