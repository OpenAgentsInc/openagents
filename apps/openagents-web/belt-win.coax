// Belt 2200's win conditions (b22-win), checked a day at a time:
//   - CONTROL THE ICE: two years running, we bring home twice the Mars Union's ice (and it, ours: lost).
//   - STARVE A CAPITAL: the Union's yard on Ceres eats from the ice its miners bring home (it keeps
//     RIVAL_STORE_CAP); its stores empty for STARVE_DAYS and the Union is starved out. Cripple its
//     miners (a ship of ours arriving at a rock where one works fights it there) and it goes hungry.
//   - THE UNKNOWN (?unknown=1): something at Jupiter's leading Trojan point. The Union sends a ship
//     at the start; whoever has more ships parked there holds it, and HOLD_DAYS held wins it.
// At 7 D/S a year is under a minute, so the ice is decided over several years: about 45 minutes'
// play with the pauses and the slower speeds a match takes.
//   coax/bin/coax test apps/openagents-web/belt.coax --only win

WIN_NONE :: 0; WIN_ICE :: 1; WIN_STARVE :: 2; WIN_UNKNOWN :: 3; LOST_ICE :: 4; LOST_UNKNOWN :: 5;
ICE_YEAR :: 365.25;          // days a ledger year
ICE_LEAD :: 2.0;             // the ice a year one side brings home over the other's
ICE_MIN :: 5000.0;           // t: a year under this decides nothing
ICE_YEARS :: 2;              // years running
RIVAL_EAT :: 4.0;            // t of ice a day the Union's yard eats,
RIVAL_EAT_SHIP :: 2.0;       // and more for each of its miners' crews
RIVAL_STORES :: 1500.0;      // t it starts with
STARVE_DAYS :: 60.0;
P_UNKNOWN :: 19;
HOLD_DAYS :: 120.0;
UNK_R :: 0.55f32; UNK_G :: 1.0f32; UNK_B :: 0.85f32;

WIN_HEAD :: [6] string.["", "THE FREE BELT CONTROLS THE ICE", "THE MARS UNION IS STARVED OUT", "THE UNKNOWN IS OURS", "THE MARS UNION CONTROLS THE ICE", "THE MARS UNION HOLDS THE UNKNOWN"];
WIN_LINE :: [6] string.["", "TWO YEARS RUNNING, TWICE THE UNION'S ICE BROUGHT HOME", "ITS YARD ON CERES RAN OUT OF ICE FOR 60 DAYS", "HELD FOR 120 DAYS", "TWO YEARS RUNNING, IT BROUGHT HOME TWICE OUR ICE", "IT HELD IT FOR 120 DAYS"];
won :: (over: int) -> bool { return over >= WIN_ICE && over <= WIN_UNKNOWN; }

// The Unknown on the map: a ring that pulses, in its own colour, and its name.
draw_unknown :: (s: [] Belt, out: [] f32, d: [] Draw) {
  if !s[0].unknown { return; }
  k := d[0].k;
  c := screen_of(s, place_state(s, P_UNKNOWN, s[0].t).r);
  x := pix(c.x); y := pix(c.y);
  hot := s[0].dest == P_UNKNOWN;
  r := (5.0 + 1.2 * sin(s[0].clock * 2.0)) * k;
  ring(out, d, x, y, r, 32, 0.9 * k, 0.95, UNK_R, UNK_G, UNK_B);
  dot(out, d, x, y, 1.6 * k, 0.95, UNK_R, UNK_G, UNK_B);
  if hot { ring(out, d, x, y, r * 1.6 + 4 * k, 32, 0.8 * k, 0.9, BELT_R, BELT_G, BELT_B); }
  block(d, x, y, r);
  tag(d, "THE UNKNOWN", x, y, r, 7 * k, ifx hot then 1.0f32 else 0.8f32, UNK_R, UNK_G, UNK_B, ifx hot then PRIO_HOT else PRIO_WORLD);
}
// The match's end: a panel in the middle, its result and why, and PLAY ON to go back to the map.
draw_over :: (s: [] Belt, out: [] f32, u: [] f32, d: [] Draw) {
  if s[0].over == WIN_NONE || s[0].over_seen || s[0].tac[0].on { return; }
  k := d[0].k; w := d[0].w; h := d[0].h;
  pw := lo(w - 32 * k, 520 * k); ph := 132 * k;
  x0 := (w - pw) / 2; y0 := (h - ph) / 2;
  panel(s, u, x0, y0, x0 + pw, y0 + ph, 0.92, false);
  head := WIN_HEAD[s[0].over];
  centred(out, d, head, w / 2, y0 + 36 * k, fit_cap(head, 11 * k, pw - 32 * k), 0.95, ifx won(s[0].over) then INK_R else MARS_R, ifx won(s[0].over) then INK_G else MARS_G, ifx won(s[0].over) then INK_B else MARS_B);
  line := WIN_LINE[s[0].over];
  centred(out, d, line, w / 2, y0 + 62 * k, fit_cap(line, 7 * k, pw - 32 * k), 0.75, BELT_R, BELT_G, BELT_B);
  bw := 150 * k;
  button(s, out, d, w / 2 - bw / 2, y0 + ph - 48 * k, w / 2 + bw / 2, y0 + ph - 16 * k, B_OVER, 0, "PLAY ON", 8 * k, true);
}

// The Unknown's orbit: Jupiter's, sixty degrees ahead of it.
unknown_orbit :: (t: f64) -> Orbit {
  j := orbit_body_state(BODY_JUPITER, t);
  axis := d3_unit(d3_cross(j.r, j.v));
  return orbit_from_state(orbit_state_of(turn_about(j.r, axis, 60.0 * DEG), turn_about(j.v, axis, 60.0 * DEG)), GM_SUN, t);
}
// ?unknown=1: the Unknown on, and the Union's IRONWAKE bound for it.
unknown_on :: (s: [] Belt) {
  s[0].unknown = true;
  s[0].unk = unknown_orbit(ORBIT_2200);
  for k: 0..<s[0].ship_n {
    if s[0].ships[k].name == "IRONWAKE" { s[0].ships[k].route = [3] int.[P_UNKNOWN, P_UNKNOWN, P_UNKNOWN]; s[0].ships[k].route_n = 1; s[0].ships[k].route_k = -1; }
  }
}
// Ships of a side parked at the Unknown.
parked_at :: (s: [] Belt, p: int, ours: bool) -> int {
  n := 0;
  for k: 0..<s[0].ship_n {
    sh := s[0].ships[k];
    if sh.mode == PARKED && sh.at == p && (sh.faction == FREE_BELT) == ours && sh.hull > 0.0 { n += 1; }
  }
  return n;
}
// A day (or `days`) of the match: the Union eats, the ledger year closes, the Unknown is held.
win_step :: (s: [] Belt, days: f64) {
  if days <= 0.0 { return; }
  eat := (RIVAL_EAT + RIVAL_EAT_SHIP * f64(rival_count(s))) * days;
  s[0].rival[0].ice = fmax(0.0, s[0].rival[0].ice - eat);
  s[0].rhungry = ifx s[0].rival[0].ice <= 0.0 then s[0].rhungry + days else 0.0;
  if s[0].unknown {
    ours := parked_at(s, P_UNKNOWN, true); theirs := parked_at(s, P_UNKNOWN, false);
    if ours > theirs { s[0].hold_ours += days; } else { s[0].hold_ours = 0.0; }
    if theirs > ours { s[0].hold_theirs += days; } else { s[0].hold_theirs = 0.0; }
  }
  if s[0].t - s[0].year_t >= ICE_YEAR * DAY {
    a := s[0].delivered - s[0].year_ours; b := s[0].rdelivered - s[0].year_theirs;
    s[0].ahead_years = ifx a >= ICE_MIN && a >= ICE_LEAD * b then s[0].ahead_years + 1 else 0;
    s[0].behind_years = ifx b >= ICE_MIN && b >= ICE_LEAD * a then s[0].behind_years + 1 else 0;
    s[0].year_t = s[0].t; s[0].year_ours = s[0].delivered; s[0].year_theirs = s[0].rdelivered;
    if s[0].over == WIN_NONE && s[0].ahead_years == 1 { say(s, "A YEAR OF TWICE THE UNION'S ICE: ONE MORE TO CONTROL IT"); }
    if s[0].over == WIN_NONE && s[0].behind_years == 1 { say(s, "THE UNION BROUGHT HOME TWICE OUR ICE THIS YEAR"); }
  }
  if s[0].over != WIN_NONE { return; }
  over := WIN_NONE;
  if s[0].ahead_years >= ICE_YEARS { over = WIN_ICE; }
  else if s[0].rhungry >= STARVE_DAYS { over = WIN_STARVE; }
  else if s[0].hold_ours >= HOLD_DAYS { over = WIN_UNKNOWN; }
  else if s[0].behind_years >= ICE_YEARS { over = LOST_ICE; }
  else if s[0].hold_theirs >= HOLD_DAYS { over = LOST_UNKNOWN; }
  if over == WIN_NONE { return; }
  s[0].over = over; s[0].over_seen = false;
  s[0].speed = 0;
  s[0].dirty = true;
  say(s, WIN_HEAD[over]);
  if track_begin(s[0].track[..], "over") { track_int(s[0].track[..], "how", over); track_int(s[0].track[..], "days", safe_int((s[0].t - ORBIT_2200) / DAY)); track_end(s[0].track[..]); }
}

#test "win: each condition ends a match: twice the Union's ice two years running, its yard starved, the Unknown held; and their mirrors lose" {
  s: [1] Belt;
  belt_start(s[..]);
  // the ice: two ledger years of twice the Union's
  for y: 0..<2 {
    s[0].delivered += 12000.0; s[0].rdelivered += 5000.0;
    s[0].t += ICE_YEAR * DAY; win_step(s[..], 1.0);
  }
  #assert s[0].over == WIN_ICE && s[0].speed == 0 && won(s[0].over);
  // one year is not enough, and a close year starts the count again
  belt_start(s[..]);
  s[0].delivered += 12000.0; s[0].t += ICE_YEAR * DAY; win_step(s[..], 1.0);
  s[0].delivered += 9000.0; s[0].rdelivered += 6000.0; s[0].t += ICE_YEAR * DAY; win_step(s[..], 1.0);
  #assert s[0].over == WIN_NONE && s[0].ahead_years == 0;
  // and the Union's twice ours loses
  for y: 0..<2 { s[0].rdelivered += 14000.0; s[0].t += ICE_YEAR * DAY; win_step(s[..], 1.0); }
  #assert s[0].over == LOST_ICE && !won(s[0].over);
  // starved: its stores run out and stay out
  belt_start(s[..]);
  #assert s[0].rival[0].ice == RIVAL_STORES;
  for d: 0..<400 { s[0].t += DAY; win_step(s[..], 1.0); }
  #assert s[0].over == WIN_STARVE;
  // a load home in time feeds it
  belt_start(s[..]);
  for d: 0..<400 { s[0].t += DAY; if d % 60 == 0 { s[0].rival[0].ice += 600.0; } win_step(s[..], 1.0); }
  #assert s[0].over == WIN_NONE;
  // the Unknown: more of ours parked there, HOLD_DAYS
  belt_start(s[..]);
  unknown_on(s[..]);
  #assert s[0].unknown && place_name(P_UNKNOWN) == "THE UNKNOWN";
  s[0].rival[0].ice = 99999.0;
  s[0].ships[0].mode = PARKED; s[0].ships[0].at = P_UNKNOWN;
  s[0].ships[2].mode = PARKED; s[0].ships[2].at = P_UNKNOWN;
  s[0].ships[3].mode = PARKED; s[0].ships[3].at = P_UNKNOWN;   // IRONWAKE: two to one
  for d: 0..<121 { s[0].t += DAY; win_step(s[..], 1.0); }
  #assert s[0].over == WIN_UNKNOWN;
  // one each holds nothing; theirs alone, they win it
  belt_start(s[..]);
  unknown_on(s[..]);
  s[0].rival[0].ice = 99999.0;
  s[0].ships[2].mode = PARKED; s[0].ships[2].at = P_UNKNOWN;
  s[0].ships[3].mode = PARKED; s[0].ships[3].at = P_UNKNOWN;
  for d: 0..<200 { s[0].t += DAY; win_step(s[..], 1.0); }
  #assert s[0].over == WIN_NONE;
  s[0].ships[2].at = P_STATION;
  for d: 0..<121 { s[0].t += DAY; win_step(s[..], 1.0); }
  #assert s[0].over == LOST_UNKNOWN;
}

#test "win: a ship of ours arriving at a rock where a Union miner works fights it there, and a crippled miner limps home" {
  s: [1] Belt;
  belt_start(s[..]);
  m := SHIP_BASE - 1;   // RUST HARROW, mining at KESTREL
  rock := P_ICE;
  s[0].ships[m].mode = MINING; s[0].ships[m].at = rock; s[0].ships[m].cargo = 300.0;
  kite := 2;
  p := plan_for(s[..], kite, rock, true);
  #assert launch(s[..], kite, rock, p);
  guard := 0;
  while s[0].ships[kite].mode == FLYING && guard < 400 { s[0].t += DAY; step_ships(s[..], DAY); guard += 1; }
  #assert s[0].tac[0].on && s[0].engaged[kite] == m && s[0].speed == 0;
  // the battle ends with the miner out of it
  for q: 0..<s[0].tac[0].n { if s[0].tac[0].units[q].ship == m { s[0].tac[0].units[q].live = false; s[0].tac[0].units[q].hull = 0.0; } }
  s[0].tac[0].end = TAC_WON;
  tac_apply(s[..]);
  #assert !s[0].tac[0].on && s[0].ships[m].mode == FLYING && s[0].ships[m].at == RIVAL_HOME && s[0].ships[m].cargo == 0.0;
  #assert s[0].engaged[kite] == -1 && s[0].engaged[m] == -1;
}
