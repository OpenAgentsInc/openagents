// Belt 2200, openagents.com/realms/belt-2200: the first playable of the hard
// sci-fi RTS (docs/verse/game-ideas/belt-2200.md). This file is the game's
// rules and its drawing only; the space is the engine's: verse/orbit.coax
// (Kepler orbits, the ephemeris, Lambert transfers, the rocket equation),
// verse/spacecam.coax (the floating origin and twelve decades of zoom) and
// verse/stars.coax (the sky, in belt.wgsl). docs/verse/space.md lists them.
//
// You run the Free Belt's Hearth Station at Ceres and three ships. Select a
// ship (tap, click, or drag a box on a desktop), pick where it goes (tap a
// world, a rock or the station; MINE ICE; HOME), and the planner offers an
// economy and a fast transfer with their delta-v, propellant and time; the
// ship burns, coasts on its arc and burns again on arrival. A ship at an ice
// rock mines until it is full, brings the ice home, refuels and goes back.
// The Mars Union and the Terran Compact fly their own routes.
//
// The map is glowing strokes in screen pixels (belt.wgsl fx, the homepage's
// newland.wgsl style) over the sky pass, which shades the worlds and ice
// rocks as discs and draws the Belt's dust (belt.wgsl world, belt_dust).
// Labels are placed most important first where they overlap nothing.
// belt-face.c binds it for the browser.
//   coax/bin/coax test apps/openagents-web/belt.coax --library --steps 2000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/orbit.coax";
#load "../../verse/spacecam.coax";
#load "../../verse/command.coax";
#load "belt-station.coax";

VERTEX_FLOATS :: 12;
MAX_VERTICES :: 90000;
PANELS :: 8;
DISCS :: 12;
// The uniforms: width, height, time, fade; the Sun (x, y, radius in pixels, dpr);
// the stars' drift (x, y), the panel count, the disc count; per panel its rectangle and
// (cut, alpha, tint, 0); the Belt's dust (the Sun x, y, an AU in pixels, its turn); then per
// world on screen (x, y, radius, kind) and (sunward x, y, seed, spin), all in device pixels.
U_PANEL :: 12;
U_BELT :: U_PANEL + PANELS * 8;
U_DISC :: U_BELT + 4;
UNIFORM_FLOATS :: U_DISC + DISCS * 8;

OUTBOX_CAP :: 4096;
ACT_NAVIGATE :: 1;
ACT_KEEP :: 4;          // host.js keeps the text in this browser and gives it back as message 4
HOST_KEPT :: 4;
SAVE_EVERY :: 5.0;      // real seconds between saves while the game runs
KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7; KEY_SHIFT :: -13;

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }

// Colours: grey line art, the Free Belt's electric blue (the homepage's accent), the rivals' own.
// Orange is Bitcoin's: nothing here is orange but the maker's TIP (the Mars Union is crimson, fuel is green).
INK_R :: 0.86f32; INK_G :: 0.88f32; INK_B :: 0.92f32;
DIM_R :: 0.5f32; DIM_G :: 0.53f32; DIM_B :: 0.58f32;
BELT_R :: 0.216f32; BELT_G :: 0.851f32; BELT_B :: 0.851f32;
MARS_R :: 0.96f32; MARS_G :: 0.32f32; MARS_B :: 0.42f32;
TERRA_R :: 0.62f32; TERRA_G :: 0.74f32; TERRA_B :: 1.0f32;
ICE_R :: 0.7f32; ICE_G :: 0.95f32; ICE_B :: 1.0f32;
FUEL_R :: 0.5f32; FUEL_G :: 0.95f32; FUEL_B :: 0.6f32;
FAST_R :: 0.76f32; FAST_G :: 0.6f32; FAST_B :: 1.0f32;
LOW_R :: 1.0f32; LOW_G :: 0.42f32; LOW_B :: 0.52f32;
PLUME_R :: 0.78f32; PLUME_G :: 0.9f32; PLUME_B :: 1.0f32;
TIP_R :: 1.0f32; TIP_G :: 0.55f32; TIP_B :: 0.12f32;   // ui.coax's orange: a tip is Bitcoin
MAKER_KIND :: 608;   // the realm's claimed maker's display name (coax/web/host.js, docs/verse/makers.md)
MAKER_BYTES :: 160;  // its 40 characters of UTF-8

FREE_BELT :: 0; MARS_UNION :: 1; TERRAN :: 2;

// Places a ship can be: the bodies (1..9), the station, the ice rocks.
P_STATION :: 10;
P_ICE :: 11;
ICE_ROCKS :: 8;
PLACES :: 19;
ICE_NAMES :: [8] string.["KESTREL", "MOROZ", "ANVIL", "TALLOW", "BRINE", "HOLLOW", "SABLE", "WICK"];
ICE_RADII :: [8] f64.[2400.0, 1700.0, 3100.0, 1300.0, 2200.0, 2800.0, 1500.0, 1900.0];   // m
STATION_ORBIT :: 1200000.0;   // m from Ceres's centre
ROCKS :: 5000;                // the Belt's field, drawn
ROCKS_FIRST :: 900;           // the first field's rocks, from the stream the ice rocks follow
SHIPS :: 10;            // the seven at the start, and up to three freighters from the yard
SHIP_BASE :: 7;
LONG_PRESS :: 0.45;     // seconds a finger rests on a ship to add it to the selection
// Light lag: what a faction sees of a ship is where it was distance / c ago. Each ship keeps its
// last SIGHT_N states (position and velocity, one a step: at most two days apart) for where-was-it
// queries; the same history can serve replay. Bodies and rocks need none: their orbits answer for any time.
C_LIGHT :: 299792458.0;
SIGHT_N :: 64;
Sight :: struct { t: f64; r: D3; v: D3; }
PATH :: 48;

PARKED :: 0; FLYING :: 1; MINING :: 2;
WORK_NONE :: 0; WORK_MINE :: 1;

// Time: days of game time a second of real time.
SPEEDS :: [4] f64.[0.0, 1.0, 7.0, 30.0];

Ship :: struct {
  faction: int;
  name: string;
  mode: int;
  at: int;               // the place it is parked or mining at, or flying to
  slot: int;             // its berth there
  from: int;
  crew: int;             // people aboard, off the station's shifts while it is away
  dry: f64; fuel: f64; fuel_cap: f64; isp: f64; cargo: f64; cargo_cap: f64; mine_rate: f64;   // t, t, t, s, t, t, t/day
  t0: f64; tof: f64; burn2: f64;   // the transfer: its start, time of flight, and propellant for the arrival burn (t)
  arc: Orbit;            // the coast, about the Sun
  dep: Orbit; dep_body: int;   // leaving a world: the hyperbola about it (patched conics), 0 none
  arr: Orbit; arr_body: int;   // and arriving at one
  path: [PATH] D3;
  work: int; work_rock: int;
  route: [3] int; route_n: int; route_k: int; idle_until: f64;   // a rival's standing route
}

// A field rock, kept for drawing five thousand a frame: its orbit's axes scaled (a·P, b·Q, the
// perifocal frame in the ecliptic's), so where it is takes one Kepler step and two products.
Rock :: struct { p: D3; q: D3; e: f64; n: f64; m0: f64; }

Plan :: struct { ok: bool; tr: Transfer; fuel: f64; burn2: f64; enough: bool; }

Btn :: struct { x0: f32; y0: f32; x1: f32; y1: f32; id: int; arg: int; }
BUTTONS :: 24;
B_SPEED :: 1; B_CARD :: 2; B_MINE :: 3; B_HOME :: 4; B_FOLLOW :: 5; B_GO :: 6; B_CANCEL :: 7; B_GALAXY :: 8; B_NEW :: 9; B_SYSTEM :: 10; B_ROCK :: 11; B_BUILD :: 12;

Finger :: struct { id: int = -1; x: f32; y: f32; sx: f32; sy: f32; }

Belt :: struct {
  started: bool; golden: bool; facts: bool; framed: bool;
  card: bool;   // ?card=1: the map without the HUD, for a link's card (coax/web/og-render.ts)
  t: f64;                // seconds since J2000
  speed: int = 2;
  clock: f32;            // real seconds, for the sky's twinkle
  cam: SpaceCam;
  w: f32; h: f32; dpr: f32; touch: bool;
  claim: [ICE_ROCKS] bool; stock: [ICE_ROCKS] f64;   // a miner leaves a rig at each rock it works; its ice waits for haulers
  engaged: [SHIPS] int;  // the hostile ship each is in combat range of, -1 none (b22-intercepts)
  engage_t: [SHIPS] f64; // when it came in range
  building: f64;         // days until the yard's freighter is done, 0 none
  station: [1] Station;  // Hearth Station's stores, refinery and people (belt-station.coax)
  delivered: f64;
  ships: [SHIPS] Ship; ship_n: int;
  rocks: [ROCKS] Rock;
  ices: [ICE_ROCKS] Orbit;
  cmd: [1] Command;      // which ships are chosen, the control groups and each ship's queue of orders (verse/command.coax)
  press_t: f32;          // when a finger went down, for a long-press
  dest: int = -1;        // the destination being planned, -1 none
  eco: Plan; fast: Plan; replan: f32;
  sight: [SHIPS * SIGHT_N] Sight; sight_head: [SHIPS] int; sight_n: [SHIPS] int;
  // The ice rocks in reach of the selected ship, for the row of their names: the fast plan's
  // days, whether it has the propellant, and whether that's worked out yet (one rock a frame)
  reach_days: [ICE_ROCKS] f64; reach_ok: [ICE_ROCKS] bool; reach_have: [ICE_ROCKS] bool;
  reach_ship: int; reach_next: int;
  follow: int = -1;
  follow_place: int = -1;  // the place the view rides with, -1 none
  // Without a ship or place followed, the view still moves with the system: the whole-system view
  // keeps the Sun and Hearth framed as Ceres goes round (system), and a view zoomed in or panned
  // rides with the place nearest its middle (ride, where it was last frame: ride_r), so the
  // station you zoomed in on doesn't fly off the screen at eighteen kilometres a second.
  system: bool; ride: int = -1; ride_r: D3;
  // input
  btn: [BUTTONS] Btn; btn_n: int; press: int = -1; hover: int = -1;
  fingers: [2] Finger;
  mouse_down: bool; mx: f32; my: f32; dx0: f32; dy0: f32; dragging: bool; boxing: bool; shift: bool;
  pinch: f32;
  held: int;
  toast: [96] u8; toast_n: int; toast_t: f32; toast_y: f32;
  arrive: [32] u8; arrive_n: int;   // the planned arrival's label, kept for the frame's labels
  panel_n: int;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  // the maker's line, MADE BY <NAME> · TIP: the name (608), TIP's box and the finger on it
  maker: [MAKER_BYTES] u8; maker_n: int;
  tip_x0: f32; tip_y0: f32; tip_x1: f32; tip_y1: f32; tip_shown: bool; tip_down: bool; tip_id: int; tip_hover: bool;
  dirty: bool; save_t: f32; restored: bool; new_armed: f32;
  track: [1] Track;
  stage: int; stage_t: f64; stage_ship: int;   // a staged moment (?stage=NAME), its real seconds, its ship
}

// ---- small things

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
  }
  return true;
}

GAP :: 0.5; SPACE :: 1.2;
ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.55 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
// cap, or smaller so the text fits in room.
fit_cap :: (text: string, cap: f32, room: f32) -> f32 { w := text_width(text, cap); return ifx w > room && w > 0 then cap * room / w else cap; }

put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n >= buf.count { break; } buf[n] = c; n += 1; }
  return n;
}
put_int :: (buf: [] u8, at: int, v: int) -> int {
  n := at;
  x := v;
  if x < 0 { if n < buf.count { buf[n] = 45; n += 1; } x = -x; }
  digits: [20] u8; d := 0;
  if x == 0 { digits[0] = 48; d = 1; }
  while x > 0 && d < 20 { digits[d] = cast(u8) (48 + x % 10); x = x / 10; d += 1; }
  while d > 0 { d -= 1; if n < buf.count { buf[n] = digits[d]; n += 1; } }
  return n;
}
safe_int :: (v: f64) -> int {
  if !is_finite(v) { return 0; }
  return int(fclamp(floor(v + 0.5), -1000000000.0, 1000000000.0));
}
// A number with thousands separated by commas.
put_count :: (buf: [] u8, at: int, v: f64) -> int {
  x := safe_int(v);
  if x < 1000 { return put_int(buf, at, x); }
  n := put_count(buf, at, f64(x / 1000));
  n = put(buf, n, ",");
  r := x % 1000;
  if r < 100 { n = put(buf, n, "0"); }
  if r < 10 { n = put(buf, n, "0"); }
  return put_int(buf, n, r);
}
// One decimal.
put_tenths :: (buf: [] u8, at: int, v: f64) -> int {
  x := safe_int(v * 10.0);
  n := at;
  if x < 0 { n = put(buf, n, "-"); x = -x; }
  n = put_int(buf, n, x / 10);
  n = put(buf, n, ".");
  return put_int(buf, n, x % 10);
}
// A device pixel from f64, never a trap: far things land far off screen.
pix :: (v: f64) -> f32 {
  if !is_finite(v) { return -10000000; }
  return f32(fclamp(v, -10000000.0, 10000000.0));
}

say :: (s: [] Belt, text: string) {
  s[0].toast_n = put(s[0].toast[..], 0, text);
  s[0].toast_t = 4.0;
}

// The date of t (seconds since J2000) as "14 MAR 2200".
MONTHS :: [12] string.["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
Date :: struct { year: int; month: int; day: int; }
date_of :: (t: f64) -> Date {
  days := safe_int(floor(t / DAY + 0.5));
  z := days + 10957 + 719468;
  era := z / 146097;
  doe := z - era * 146097;
  yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  y := yoe + era * 400;
  doy := doe - (365 * yoe + yoe / 4 - yoe / 100);
  mp := (5 * doy + 2) / 153;
  d := doy - (153 * mp + 2) / 5 + 1;
  m := ifx mp < 10 then mp + 3 else mp - 9;
  if m <= 2 { y += 1; }
  return Date.{year = y, month = m, day = d};
}

// A small deterministic random stream for the rocks.
Rand :: struct { x: int = 12345; }
rand_next :: (r: [] Rand) -> f64 {
  r[0].x = (r[0].x * 1103515245 + 12345) % 2147483648;
  return f64(r[0].x) / 2147483648.0;
}

// ---- places

place_name :: (p: int) -> string {
  if p == P_STATION { return "HEARTH STATION"; }
  if p >= P_ICE && p < P_ICE + ICE_ROCKS { return ICE_NAMES[p - P_ICE]; }
  if p >= 1 && p < BODIES { return BODY_NAMES[p]; }
  return "";
}
is_ice :: (p: int) -> bool { return p >= P_ICE && p < P_ICE + ICE_ROCKS; }

place_state :: (s: [] Belt, p: int, t: f64) -> State {
  if is_ice(p) { return orbit_state(s[0].ices[p - P_ICE], t); }
  if p == P_STATION {
    c := orbit_body_state(BODY_CERES, t);
    w := sqrt(BODY_GM[BODY_CERES] / (STATION_ORBIT * STATION_ORBIT * STATION_ORBIT));
    a := w * t;
    off := d3(cos(a) * STATION_ORBIT, sin(a) * STATION_ORBIT, 0.0);
    vel := d3(-sin(a) * STATION_ORBIT * w, cos(a) * STATION_ORBIT * w, 0.0);
    return orbit_state_of(d3_add(c.r, off), d3_add(c.v, vel));
  }
  return orbit_body_state(p, t);
}
// The heliocentric orbit the planner aims at.
place_orbit :: (s: [] Belt, p: int) -> Orbit {
  if is_ice(p) { return s[0].ices[p - P_ICE]; }
  if p == P_STATION { return orbit_body(BODY_CERES); }
  if p == BODY_MOON { return orbit_body(BODY_EARTH); }
  return orbit_body(p);
}
// How far from a place's centre its berths are, m.
berth_radius :: (p: int) -> f64 {
  if p == P_STATION { return 700.0; }
  if is_ice(p) { return ICE_RADII[p - P_ICE] * 1.9; }
  if p >= 1 && p < BODIES { return BODY_RADIUS[p] * 2.5; }
  return 1000.0;
}

ship_state :: (s: [] Belt, k: int, t: f64) -> State {
  sh := s[0].ships[k];
  if sh.mode == FLYING { return flight_state(sh, t); }
  base := place_state(s, sh.at, t);
  a := f64(sh.slot) * 1.1 + f64(k) * 0.37;
  r := berth_radius(sh.at) * (1.0 + 0.45 * f64(sh.slot));
  return orbit_state_of(d3_add(base.r, d3(cos(a) * r, sin(a) * r, 0.0)), base.v);
}

// A ship in flight: its heliocentric coast, handed over to a hyperbola about the world it
// leaves or reaches inside that world's sphere of influence (verse/orbit.coax), so it swings
// out from its world and in to its periapsis instead of flying through the centres.
is_world :: (p: int) -> bool { return p >= 1 && p < BODIES; }
flight_state :: (sh: Ship, t: f64) -> State {
  out := orbit_state(sh.arc, t);
  if sh.dep_body > 0 {
    h := orbit_state(sh.dep, t);
    w := orbit_soi_blend(d3_len(h.r), orbit_body_soi(sh.dep_body));
    if w < 1.0 { out = state_mix(orbit_absolute(h, orbit_body_state(sh.dep_body, t)), out, w); }
  }
  if sh.arr_body > 0 {
    h := orbit_arrival_state(sh.arr, sh.t0 + sh.tof, t);
    w := orbit_soi_blend(d3_len(h.r), orbit_body_soi(sh.arr_body));
    if w < 1.0 { out = state_mix(orbit_absolute(h, orbit_body_state(sh.arr_body, t)), out, w); }
  }
  return out;
}
state_mix :: (a: State, b: State, w: f64) -> State {
  return orbit_state_of(d3_add(a.r, d3_scale(d3_sub(b.r, a.r), w)), d3_add(a.v, d3_scale(d3_sub(b.v, a.v), w)));
}
// The hyperbolas for a ship's transfer: periapsis at its berth's distance, the asymptotes the
// transfer's velocity relative to each world at the burns.
ship_hyperbolas :: (s: [] Belt, k: int) {
  sh := s[0].ships[k];
  sh.dep_body = 0; sh.arr_body = 0;
  if is_world(sh.from) {
    b := orbit_body_state(sh.from, sh.t0);
    sh.dep = orbit_departure(BODY_GM[sh.from], berth_radius(sh.from), d3_sub(orbit_state(sh.arc, sh.t0).v, b.v), sh.t0);
    if sh.dep.a != 0.0 { sh.dep_body = sh.from; }
  }
  if is_world(sh.at) {
    tf := sh.t0 + sh.tof;
    b := orbit_body_state(sh.at, tf);
    sh.arr = orbit_arrival(BODY_GM[sh.at], berth_radius(sh.at), d3_sub(orbit_state(sh.arc, tf).v, b.v), tf);
    if sh.arr.a != 0.0 { sh.arr_body = sh.at; }
  }
  for i: 0..<PATH { sh.path[i] = flight_state(sh, sh.t0 + sh.tof * f64(i) / f64(PATH - 1)).r; }
  s[0].ships[k] = sh;
}

// ---- the world at the start

ship_new :: (faction: int, name: string, at: int, dry: f64, fuel: f64, isp: f64, cargo: f64, rate: f64) -> Ship {
  sh: Ship;
  sh.faction = faction; sh.name = name; sh.at = at; sh.from = at;
  sh.dry = dry; sh.fuel = fuel; sh.fuel_cap = fuel; sh.isp = isp; sh.cargo_cap = cargo; sh.mine_rate = rate;
  return sh;
}

belt_start :: (s: [] Belt) {
  belt_reset(s);
  track_init(s[0].track[..], "belt-2200");
}
// The game as it begins: 2 March 2200, Hearth Station with 1,200 t of ice and three ships.
belt_reset :: (s: [] Belt) {
  s[0].started = true;
  s[0].t = ORBIT_2200 + 60.0 * DAY;
  s[0].delivered = 0.0;
  for j: 0..<SHIPS { s[0].cmd[0].selected[j] = false; }
  s[0].toast_n = 0; s[0].toast_t = 0;
  s[0].speed = 2;
  s[0].station[0] = station_new();
  s[0].building = 0.0;
  for j: 0..<SHIPS { s[0].engaged[j] = -1; s[0].engage_t[j] = 0.0; }
  for j: 0..<ICE_ROCKS { s[0].claim[j] = false; s[0].stock[j] = 0.0; }
  s[0].dest = -1; s[0].follow = -1; s[0].follow_place = -1; s[0].press = -1; s[0].hover = -1;
  s[0].reach_ship = -1;
  for i: 0..<2 { s[0].fingers[i].id = -1; }
  r: [1] Rand;
  // The Belt's field: the first rocks from the stream the ice rocks follow (so they stay where
  // they were), the rest from their own.
  more: [1] Rand; more[0].x = 777;
  for k: 0..<ROCKS {
    o: Orbit;
    o.mu = GM_SUN;
    if k < ROCKS_FIRST { o = field_orbit(r[..]); } else { o = field_orbit(more[..]); }
    s[0].rocks[k] = rock_of(o);
  }
  // The ice rocks, near Ceres along its orbit, so the first trips are short: Ceres's own state
  // turned about its orbit's axis and a hair out of its plane, at Ceres's speed: the same energy,
  // so the same year, and they stay beside Ceres however many years a game runs (a hair faster
  // or slower and they spread round the whole orbit in a century). A rock on another plane or
  // out of round costs kilometres a second to reach however near it looks.
  cs := orbit_state(orbit_body(BODY_CERES), s[0].t);
  axis := d3_unit(d3_cross(cs.r, cs.v));
  for k: 0..<ICE_ROCKS {
    side := ifx k % 2 == 0 then 1.0 else -1.0;
    ang := side * (0.012 + 0.012 * f64(k / 2) + 0.006 * rand_next(r[..]));
    tilt := (rand_next(r[..]) - 0.5) * 0.6 * DEG;
    speed := 1.0 + 0.0 * rand_next(r[..]);   // the draw kept: the rocks after it stay where they were
    pr := turn_about(cs.r, axis, ang);
    pv := d3_scale(turn_about(cs.v, axis, ang), speed);
    pv = turn_about(pv, d3_unit(pr), tilt);
    s[0].ices[k] = orbit_from_state(orbit_state_of(pr, pv), GM_SUN, s[0].t);
  }
  // The Free Belt's three, the Mars Union's and the Compact's.
  n := 0;
  s[0].ships[n] = ship_new(FREE_BELT, "RASP", P_STATION, 300.0, 500.0, 8000.0, 600.0, 60.0); s[0].ships[n].slot = 0; s[0].ships[n].crew = 6; n += 1;
  s[0].ships[n] = ship_new(FREE_BELT, "LANTERN", P_STATION, 500.0, 800.0, 8000.0, 1200.0, 50.0); s[0].ships[n].slot = 1; s[0].ships[n].crew = 8; n += 1;
  s[0].ships[n] = ship_new(FREE_BELT, "KITE", P_STATION, 120.0, 260.0, 9000.0, 0.0, 0.0); s[0].ships[n].slot = 2; s[0].ships[n].crew = 3; n += 1;
  s[0].ships[n] = ship_new(MARS_UNION, "IRONWAKE", BODY_MARS, 600.0, 2000.0, 5000.0, 0.0, 0.0);
  s[0].ships[n].route = [3] int.[BODY_MARS, BODY_CERES, BODY_VESTA]; s[0].ships[n].route_n = 3; s[0].ships[n].idle_until = s[0].t + 3.0 * DAY; n += 1;
  s[0].ships[n] = ship_new(MARS_UNION, "RED LEDGER", BODY_MARS, 600.0, 2000.0, 5000.0, 0.0, 0.0);
  s[0].ships[n].route = [3] int.[BODY_MARS, BODY_EARTH, BODY_MARS]; s[0].ships[n].route_n = 2; s[0].ships[n].slot = 1; s[0].ships[n].idle_until = s[0].t + 12.0 * DAY; n += 1;
  s[0].ships[n] = ship_new(TERRAN, "MERIDIAN", BODY_EARTH, 800.0, 2400.0, 5000.0, 0.0, 0.0);
  s[0].ships[n].route = [3] int.[BODY_EARTH, BODY_MARS, BODY_VENUS]; s[0].ships[n].route_n = 3; s[0].ships[n].idle_until = s[0].t + 6.0 * DAY; n += 1;
  s[0].ships[n] = ship_new(TERRAN, "HALCYON", BODY_EARTH, 800.0, 2400.0, 5000.0, 0.0, 0.0);
  s[0].ships[n].route = [3] int.[BODY_EARTH, BODY_VESTA, BODY_EARTH]; s[0].ships[n].route_n = 2; s[0].ships[n].slot = 1; s[0].ships[n].idle_until = s[0].t + 20.0 * DAY; n += 1;
  s[0].ship_n = n;
  // The view: the Sun to the Belt.
  s[0].cam.center = D3_ZERO; s[0].cam.goal_center = D3_ZERO;
  s[0].cam.scale = 0.000000001; s[0].cam.goal_scale = 0.000000001;
  s[0].cam.tilt = 0.0;
}
started :: (s: [] Belt) { if !s[0].started { belt_start(s); } }
field_orbit :: (r: [] Rand) -> Orbit {
  o: Orbit;
  o.mu = GM_SUN;
  o.a = (2.15 + 1.1 * rand_next(r)) * AU;
  o.e = 0.2 * rand_next(r) * rand_next(r);
  o.i = 0.25 * rand_next(r) * rand_next(r);
  o.node = TAU_D * rand_next(r);
  o.peri = TAU_D * rand_next(r);
  o.m0 = TAU_D * rand_next(r);
  return o;
}
rock_of :: (o: Orbit) -> Rock {
  k: Rock;
  k.p = perifocal(o, d3(o.a, 0.0, 0.0));
  k.q = perifocal(o, d3(0.0, o.a * sqrt(1.0 - o.e * o.e), 0.0));
  k.e = o.e; k.n = orbit_mean_motion(o); k.m0 = o.m0;
  return k;
}
// Where a field rock is at t: Kepler's equation by two Newton steps from E = M + e sin M, which
// at the field's e (0.2 at most) is within a few metres per AU of the exact solution.
rock_at :: (k: Rock, t: f64) -> D3 {
  m := k.m0 + k.n * t;
  ea := m + k.e * sin(m);
  for i: 0..<2 { ea -= (ea - k.e * sin(ea) - m) / (1.0 - k.e * cos(ea)); }
  c := cos(ea) - k.e; sn := sin(ea);
  return d3(k.p.x * c + k.q.x * sn, k.p.y * c + k.q.y * sn, k.p.z * c + k.q.z * sn);
}
// v turned by a radians about the unit axis k (Rodrigues).
turn_about :: (v: D3, k: D3, a: f64) -> D3 {
  c := cos(a); sn := sin(a);
  return d3_add(d3_add(d3_scale(v, c), d3_scale(d3_cross(k, v), sn)), d3_scale(k, d3_dot(k, v) * (1.0 - c)));
}

// ---- the planner over the game's ships

ship_mass :: (sh: Ship) -> f64 { return sh.dry + sh.cargo + sh.fuel; }

NEAR_TOF :: 200.0 * DAY;   // the longest trip planned to a place near the ship's own orbit
plan_for :: (s: [] Belt, k: int, dest: int, fast: bool) -> Plan { return plan_with(s, k, dest, fast, 0.85); }
plan_with :: (s: [] Belt, k: int, dest: int, fast: bool, share: f64) -> Plan {
  p: Plan;
  sh := s[0].ships[k];
  if dest == sh.at && sh.mode != FLYING { return p; }
  from := ship_state(s, k, s[0].t);
  target := place_orbit(s, dest);
  a1 := d3_len(from.r);
  hoh := orbit_hohmann_time(a1, target.a, GM_SUN);
  tmin := fmax(20.0 * DAY, 0.12 * hoh);
  tmax := fmax(tmin + 30.0 * DAY, 1.25 * hoh);
  // A place on nearly the ship's own orbit (a rock beside Ceres): the cheapest trip there is a
  // phasing loop most of the way round the Sun, years for a hop. Such a hop is planned within NEAR_TOF.
  // Within NEAR_TOF, and from 15 days: GO FAST to a rock a few degrees along is weeks.
  if abs(target.a - a1) < 0.25 * a1 { tmin = 15.0 * DAY; tmax = fmin(tmax, fmax(tmin + 30.0 * DAY, NEAR_TOF)); }
  m0 := ship_mass(sh);
  budget := ifx sh.fuel > 0.0 then orbit_delta_v(sh.isp, m0, m0 - share * sh.fuel) else 0.0;
  if sh.faction != FREE_BELT { budget = 25000.0; }
  tr := orbit_plan(from, target, s[0].t, GM_SUN, tmin, tmax, 40, fast, budget);
  if !tr.ok { return p; }
  p.ok = true; p.tr = tr;
  u1 := orbit_propellant_from(sh.isp, m0, d3_len(tr.dv1));
  u2 := orbit_propellant_from(sh.isp, m0 - u1, d3_len(tr.dv2));
  p.fuel = u1 + u2; p.burn2 = u2;
  p.enough = p.fuel <= sh.fuel || sh.faction != FREE_BELT;
  return p;
}

launch :: (s: [] Belt, k: int, dest: int, p: Plan) -> bool {
  if !p.ok || !p.enough { return false; }
  sh := s[0].ships[k];
  if sh.faction == FREE_BELT { sh.fuel -= p.fuel - p.burn2; }
  sh.from = sh.at;
  sh.mode = FLYING; sh.at = dest;
  sh.t0 = p.tr.t0; sh.tof = p.tr.tof; sh.burn2 = p.burn2;
  sh.arc = orbit_from_state(p.tr.depart, GM_SUN, p.tr.t0);
  s[0].ships[k] = sh;
  ship_hyperbolas(s, k);
  s[0].dirty = true;
  return true;
}

// The ice rock this ship reaches soonest, or -1.
nearest_ice :: (s: [] Belt, k: int) -> int {
  best := -1; best_t := 0.0;
  for j: 0..<ICE_ROCKS {
    p := plan_for(s, k, P_ICE + j, true);
    if !p.ok || !p.enough { continue; }
    if best < 0 || p.tr.tof < best_t { best = P_ICE + j; best_t = p.tr.tof; }
  }
  return best;
}

// A free berth at a place.
berth :: (s: [] Belt, k: int, p: int) -> int {
  for b: 0..<SHIPS {
    taken := false;
    for j: 0..<s[0].ship_n { if j != k && s[0].ships[j].mode != FLYING && s[0].ships[j].at == p && s[0].ships[j].slot == b { taken = true; } }
    if !taken { return b; }
  }
  return 0;
}

arrive :: (s: [] Belt, k: int) {
  sh := s[0].ships[k];
  if sh.faction == FREE_BELT { sh.fuel = fmax(0.0, sh.fuel - sh.burn2); }
  sh.mode = PARKED; sh.burn2 = 0.0; sh.dep_body = 0; sh.arr_body = 0;
  s[0].ships[k] = sh;
  s[0].dirty = true;
  s[0].ships[k].slot = berth(s, k, sh.at);
  buf: [96] u8;
  if sh.faction != FREE_BELT { s[0].ships[k].idle_until = s[0].t + 25.0 * DAY; return; }
  queued := verse_command_queued(s[0].cmd[..], k) > 0;
  if is_ice(sh.at) && !queued && sh.cargo_cap > 0.0 && sh.cargo < sh.cargo_cap {
    s[0].ships[k].mode = MINING;
    s[0].ships[k].work = WORK_MINE; s[0].ships[k].work_rock = sh.at;
    if sh.mine_rate > 0.0 { s[0].claim[sh.at - P_ICE] = true; }
    n := put(buf[..], 0, sh.name); n = put(buf[..], n, " MINING AT "); n = put(buf[..], n, place_name(sh.at));
    say(s, cast(string) buf[0..<n]);
    return;
  }
  if sh.at == P_STATION {
    n := put(buf[..], 0, sh.name);
    if sh.cargo > 0.0 {
      s[0].station[0] = station_deliver(s[0].station[0], sh.cargo); s[0].delivered += sh.cargo;
      n = put(buf[..], n, " DELIVERED "); n = put_count(buf[..], n, sh.cargo); n = put(buf[..], n, " T ICE");
      if track_begin(s[0].track[..], "delivered") { track_int(s[0].track[..], "tonnes", safe_int(sh.cargo)); track_end(s[0].track[..]); }
      s[0].ships[k].cargo = 0.0;
    } else {
      n = put(buf[..], n, " DOCKED AT HEARTH");
    }
    // Refuel from the refinery's reaction mass.
    s[0].ships[k].fuel += station_fuel(s[0].station[..], s[0].ships[k].fuel_cap - s[0].ships[k].fuel);
    say(s, cast(string) buf[0..<n]);
    if next_order(s, k) { return; }
    if sh.work == WORK_MINE && is_ice(sh.work_rock) {
      p := plan_with(s, k, sh.work_rock, true, 0.4);
      if !launch(s, k, sh.work_rock, p) { s[0].ships[k].work = WORK_NONE; }
    }
    return;
  }
  n := put(buf[..], 0, sh.name); n = put(buf[..], n, " ARRIVED AT "); n = put(buf[..], n, place_name(sh.at));
  say(s, cast(string) buf[0..<n]);
  ok := next_order(s, k);
}

// The ships over dt seconds of game time.
step_ships :: (s: [] Belt, dt: f64) {
  t := s[0].t;
  for k: 0..<s[0].ship_n { sight_record(s, k); }
  intercepts(s, dt);
  // The refinery, worked by whoever is home.
  away := 0;
  for k: 0..<s[0].ship_n {
    sh := s[0].ships[k];
    if sh.faction == FREE_BELT && !(sh.mode == PARKED && sh.at == P_STATION) { away += sh.crew; }
  }
  s[0].station[0].away = away;
  s[0].station[0] = station_step(s[0].station[0], dt / DAY);
  rigs_step(s, dt / DAY);
  yard_step(s, dt / DAY);
  for k: 0..<s[0].ship_n {
    sh := s[0].ships[k];
    if sh.mode == FLYING && t >= sh.t0 + sh.tof { arrive(s, k); continue; }
    if sh.mode == MINING {
      r := sh.at - P_ICE;
      take := fmin(s[0].stock[r], sh.cargo_cap - sh.cargo);
      s[0].stock[r] -= take;
      s[0].ships[k].cargo = fmin(sh.cargo_cap, sh.cargo + take + sh.mine_rate * dt / DAY);
      // a miner fills its hold; a hauler leaves when it has emptied the rig's stock of a worthwhile load
      hauled := sh.mine_rate <= 0.0 && s[0].stock[r] < 1.0 && s[0].ships[k].cargo >= HAUL_LOAD;
      if s[0].ships[k].cargo >= sh.cargo_cap || hauled {
        p := plan_with(s, k, P_STATION, true, 0.4);
        if !p.enough { p = plan_for(s, k, P_STATION, true); }
        if launch(s, k, P_STATION, p) {
          buf: [96] u8;
          n := put(buf[..], 0, sh.name); n = put(buf[..], n, ifx hauled then " LOADED: " else " FULL: "); n = put_count(buf[..], n, s[0].ships[k].cargo); n = put(buf[..], n, " T ICE, HEADING HOME");
          say(s, cast(string) buf[0..<n]);
        } else {
          s[0].ships[k].mode = PARKED;
        }
      }
      continue;
    }
    if sh.faction != FREE_BELT && sh.mode == PARKED && t >= sh.idle_until && sh.route_n > 0 {
      next := (sh.route_k + 1) % sh.route_n;
      dest := sh.route[next];
      p := plan_for(s, k, dest, false);
      if launch(s, k, dest, p) { s[0].ships[k].route_k = next; } else { s[0].ships[k].idle_until = t + 10.0 * DAY; }
    }
  }
}

// ---- the save: one text, kept in this browser (host.js action 4) and given back on the next
// visit. Integers only (times in ms, masses in grams, the coast's start in mm and um/s), so it
// reads back exactly; the rocks and the start come from belt_start, which is deterministic.
SAVE_TAG :: "BELT2200 3";   // 1: the station kept only ice; 2: no yard or rigs
qi :: (v: f64, scale: f64) -> int {
  x := v * scale;
  if !is_finite(x) { return 0; }
  return int(fclamp(floor(x + 0.5), -9000000000000000000.0, 9000000000000000000.0));
}
put_field :: (buf: [] u8, at: int, v: int) -> int { n := put(buf, at, "|"); return put_int(buf, n, v); }
save_game :: (s: [] Belt, buf: [] u8) -> int {
  n := put(buf, 0, SAVE_TAG);
  n = put_field(buf, n, qi(s[0].t, 1000.0)); n = put_field(buf, n, s[0].speed);
  hs := s[0].station[0];
  n = put_field(buf, n, qi(hs.ice, 1000000.0)); n = put_field(buf, n, qi(s[0].delivered, 1000000.0));
  n = put_field(buf, n, qi(hs.mass, 1000000.0)); n = put_field(buf, n, qi(hs.metal, 1000000.0));
  n = put_field(buf, n, qi(hs.water, 1000000.0)); n = put_field(buf, n, qi(hs.air, 1000000.0));
  n = put_field(buf, n, qi(s[0].building, 1000.0));
  claims := 0;
  for j: 0..<ICE_ROCKS { if s[0].claim[j] { claims = claims | (1 << j); } }
  n = put_field(buf, n, claims);
  for j: 0..<ICE_ROCKS { n = put_field(buf, n, qi(s[0].stock[j], 1000.0)); }
  n = put_field(buf, n, s[0].ship_n);
  for k: 0..<s[0].ship_n {
    sh := s[0].ships[k];
    n = put(buf, n, "\n"); n = put_int(buf, n, sh.mode);
    n = put_field(buf, n, sh.at); n = put_field(buf, n, sh.slot); n = put_field(buf, n, sh.from);
    n = put_field(buf, n, qi(sh.fuel, 1000000.0)); n = put_field(buf, n, qi(sh.cargo, 1000000.0));
    n = put_field(buf, n, qi(sh.t0, 1000.0)); n = put_field(buf, n, qi(sh.tof, 1000.0)); n = put_field(buf, n, qi(sh.burn2, 1000000.0));
    n = put_field(buf, n, sh.work); n = put_field(buf, n, sh.work_rock); n = put_field(buf, n, sh.route_k); n = put_field(buf, n, qi(sh.idle_until, 1000.0));
    st: State;
    if sh.mode == FLYING { st = orbit_state(sh.arc, sh.t0); }
    n = put_field(buf, n, qi(st.r.x, 1000.0)); n = put_field(buf, n, qi(st.r.y, 1000.0)); n = put_field(buf, n, qi(st.r.z, 1000.0));
    n = put_field(buf, n, qi(st.v.x, 1000000.0)); n = put_field(buf, n, qi(st.v.y, 1000000.0)); n = put_field(buf, n, qi(st.v.z, 1000000.0));
  }
  return n;
}
Cur :: struct { at: int; ok: bool = true; }
read_int :: (text: string, c: [] Cur) -> int {
  i := c[0].at;
  while i < text.count && (text[i] == '|' || text[i] == 10 || text[i] == ' ') { i += 1; }
  neg := false;
  if i < text.count && text[i] == '-' { neg = true; i += 1; }
  v := 0; digits := 0;
  while i < text.count && text[i] >= '0' && text[i] <= '9' { v = v * 10 + (cast(int) text[i] - '0'); i += 1; digits += 1; }
  if digits == 0 { c[0].ok = false; }
  c[0].at = i;
  return ifx neg then -v else v;
}
// Read a save into a fresh start; a text that isn't a whole save of this kind changes nothing.
load_game :: (s: [] Belt, text: string) -> bool {
  if text.count < SAVE_TAG.count + 2 { return false; }
  for i: 0..<SAVE_TAG.count - 1 { if text[i] != SAVE_TAG[i] { return false; } }
  version := cast(int) text[SAVE_TAG.count - 1] - '0';
  if version < 1 || version > 3 { return false; }
  c: [1] Cur; c[0].at = SAVE_TAG.count;
  ships: [SHIPS] Ship;
  t := f64(read_int(text, c[..])) / 1000.0;
  sp := read_int(text, c[..]);
  ice := f64(read_int(text, c[..])) / 1000000.0;
  delivered := f64(read_int(text, c[..])) / 1000000.0;
  st := station_new();
  if version == 1 {
    // the station's ice was all it kept, its tanks' mass among it: the start's split of it
    st.ice = ice * station_new().ice / (station_new().ice + station_new().mass); st.mass = ice - st.ice;
  } else {
    st.ice = ice;
    st.mass = f64(read_int(text, c[..])) / 1000000.0; st.metal = f64(read_int(text, c[..])) / 1000000.0;
    st.water = f64(read_int(text, c[..])) / 1000000.0; st.air = f64(read_int(text, c[..])) / 1000000.0;
  }
  building := 0.0; claims := 0; stock: [ICE_ROCKS] f64;
  if version >= 3 {
    building = f64(read_int(text, c[..])) / 1000.0;
    claims = read_int(text, c[..]);
    for j: 0..<ICE_ROCKS { stock[j] = fclamp(f64(read_int(text, c[..])) / 1000.0, 0.0, RIG_STOCK); }
  }
  saved_n := read_int(text, c[..]);
  if saved_n < SHIP_BASE || saved_n > SHIPS || (version < 3 && saved_n != SHIP_BASE) || !c[0].ok || t < ORBIT_2200 { return false; }
  for k: 0..<saved_n {
    sh := ifx k < SHIP_BASE then s[0].ships[k] else freighter_new(k - SHIP_BASE);
    sh.mode = read_int(text, c[..]); sh.at = read_int(text, c[..]); sh.slot = read_int(text, c[..]); sh.from = read_int(text, c[..]);
    sh.fuel = f64(read_int(text, c[..])) / 1000000.0; sh.cargo = f64(read_int(text, c[..])) / 1000000.0;
    sh.t0 = f64(read_int(text, c[..])) / 1000.0; sh.tof = f64(read_int(text, c[..])) / 1000.0; sh.burn2 = f64(read_int(text, c[..])) / 1000000.0;
    sh.work = read_int(text, c[..]); sh.work_rock = read_int(text, c[..]); sh.route_k = read_int(text, c[..]); sh.idle_until = f64(read_int(text, c[..])) / 1000.0;
    r := d3(f64(read_int(text, c[..])) / 1000.0, f64(read_int(text, c[..])) / 1000.0, f64(read_int(text, c[..])) / 1000.0);
    v := d3(f64(read_int(text, c[..])) / 1000000.0, f64(read_int(text, c[..])) / 1000000.0, f64(read_int(text, c[..])) / 1000000.0);
    if !c[0].ok || sh.mode < PARKED || sh.mode > MINING || sh.at < 1 || sh.at >= PLACES || sh.from < 1 || sh.from >= PLACES { return false; }
    if sh.mode == FLYING && (sh.tof <= 0.0 || d3_len(r) <= 0.0) { return false; }
    sh.slot = sh.slot % SHIPS; if sh.slot < 0 { sh.slot = 0; }
    sh.fuel = fclamp(sh.fuel, 0.0, sh.fuel_cap); sh.cargo = fclamp(sh.cargo, 0.0, sh.cargo_cap);
    if sh.route_n > 0 { sh.route_k = sh.route_k % sh.route_n; if sh.route_k < 0 { sh.route_k = 0; } }
    sh.path[0] = r; sh.path[1] = v;   // the coast's start, made into its orbit once the whole save has read
    ships[k] = sh;
  }
  s[0].t = t; s[0].speed = ifx sp >= 0 && sp < 4 then sp else 2;
  st.ice = fmax(st.ice, 0.0); st.mass = fmax(st.mass, 0.0); st.metal = fmax(st.metal, 0.0); st.water = fmax(st.water, 0.0); st.air = fmax(st.air, 0.0);
  s[0].station[0] = st; s[0].delivered = fmax(delivered, 0.0);
  s[0].building = fclamp(building, 0.0, FREIGHTER_DAYS);
  for j: 0..<ICE_ROCKS { s[0].claim[j] = (claims & (1 << j)) != 0; s[0].stock[j] = stock[j]; }
  s[0].ship_n = saved_n;
  s[0].framed = false;   // the next frame frames the saved date's Hearth, not the start's
  for k: 0..<s[0].ship_n {
    sh := ships[k];
    if sh.mode == FLYING { sh.arc = orbit_from_state(orbit_state_of(sh.path[0], sh.path[1]), GM_SUN, sh.t0); }
    s[0].ships[k] = sh;
    if sh.mode == FLYING { ship_hyperbolas(s, k); }
  }
  return true;
}
// Keep the game now and then while it runs (and at once after an order or an arrival).
autosave :: (s: [] Belt, real: f32) {
  if s[0].golden || s[0].stage != STAGE_NONE || s[0].action != 0 { return; }
  s[0].save_t -= real;
  // every few seconds, or a second after something changed
  if !(s[0].save_t <= 0 || (s[0].dirty && s[0].save_t <= SAVE_EVERY - 1.0)) { return; }
  s[0].out_n = save_game(s, s[0].outbox[..]);
  s[0].action = ACT_KEEP;
  s[0].save_t = SAVE_EVERY; s[0].dirty = false;
}
new_game :: (s: [] Belt) {
  belt_reset(s);
  s[0].framed = false; s[0].restored = true; s[0].dirty = true;
  say(s, "A NEW GAME");
  if track_begin(s[0].track[..], "new-game") { track_end(s[0].track[..]); }
}

// ---- orders

selected_count :: (s: [] Belt) -> int {
  n := 0;
  for k: 0..<s[0].ship_n { if s[0].cmd[0].selected[k] { n += 1; } }
  return n;
}
first_selected :: (s: [] Belt) -> int {
  for k: 0..<s[0].ship_n { if s[0].cmd[0].selected[k] { return k; } }
  return -1;
}
select_only :: (s: [] Belt, k: int) {
  for j: 0..<SHIPS { s[0].cmd[0].selected[j] = false; }
  if k >= 0 { s[0].cmd[0].selected[k] = true; }
  s[0].dest = -1;
}

set_dest :: (s: [] Belt, p: int) {
  k := first_selected(s);
  if k < 0 { return; }
  s[0].dest = p;
  s[0].eco = plan_for(s, k, p, false);
  s[0].fast = plan_for(s, k, p, true);
  s[0].replan = 0.25;
  if !s[0].eco.ok { s[0].dest = -1; say(s, "ALREADY THERE"); }
}

go :: (s: [] Belt, fast: bool) {
  if s[0].dest < 0 { return; }
  sent := 0; queued := 0;
  for k: 0..<s[0].ship_n {
    if !s[0].cmd[0].selected[k] { continue; }
    if s[0].shift && s[0].ships[k].mode == FLYING {
      // Shift and an order: it waits until this ship arrives
      if verse_command_push(s[0].cmd[..], k, CmdOrder.{target = s[0].dest, arg = ifx fast then 1 else 0}) { queued += 1; }
      continue;
    }
    if !s[0].shift { verse_command_clear(s[0].cmd[..], k); }
    p := plan_for(s, k, s[0].dest, fast);
    if launch(s, k, s[0].dest, p) {
      sent += 1;
      s[0].ships[k].work = ifx is_ice(s[0].dest) && s[0].ships[k].cargo_cap > 0.0 then WORK_MINE else WORK_NONE;
      s[0].ships[k].work_rock = s[0].dest;
    }
  }
  buf: [96] u8;
  if sent > 0 {
    n := put(buf[..], 0, ifx sent == 1 then s[0].ships[first_selected(s)].name else "SHIPS");
    n = put(buf[..], n, " BURNING FOR "); n = put(buf[..], n, place_name(s[0].dest));
    say(s, cast(string) buf[0..<n]);
    if track_begin(s[0].track[..], "order") { track_str(s[0].track[..], "to", place_name(s[0].dest)); track_bool(s[0].track[..], "fast", fast); track_int(s[0].track[..], "ships", sent); track_end(s[0].track[..]); }
  } else if queued > 0 {
    n := put(buf[..], 0, ifx queued == 1 then "NEXT: " else "THEN ALL TO ");
    n = put(buf[..], n, place_name(s[0].dest));
    say(s, cast(string) buf[0..<n]);
  } else {
    say(s, "NOT ENOUGH PROPELLANT");
  }
  s[0].dest = -1;
}
// A ship that has arrived takes the next order off its queue: true when it burned for it.
next_order :: (s: [] Belt, k: int) -> bool {
  while verse_command_queued(s[0].cmd[..], k) > 0 {
    o := verse_command_pop(s[0].cmd[..], k);
    p := plan_for(s, k, o.target, o.arg == 1);
    if launch(s, k, o.target, p) {
      s[0].ships[k].work = ifx is_ice(o.target) && s[0].ships[k].cargo_cap > 0.0 then WORK_MINE else WORK_NONE;
      s[0].ships[k].work_rock = o.target;
      buf: [96] u8;
      n := put(buf[..], 0, s[0].ships[k].name); n = put(buf[..], n, " BURNING FOR "); n = put(buf[..], n, place_name(o.target));
      say(s, cast(string) buf[0..<n]);
      return true;
    }
  }
  return false;
}

// ---- intercepts: two hostile ships in flight whose paths bring them within COMBAT_RANGE engage
COMBAT_RANGE :: 10000000.0;   // m: 10,000 km, a rail gun's reach
Pass :: struct { tau: f64; dist: f64; }
// The closest two straight-line motions come over [0, span]: a at ra moving va, b at rb moving vb.
closest_pass :: (ra: D3, va: D3, rb: D3, vb: D3, span: f64) -> Pass {
  r := d3_sub(rb, ra); v := d3_sub(vb, va);
  vv := d3_dot(v, v);
  tau := ifx vv > 0.0 then fclamp(-d3_dot(r, v) / vv, 0.0, span) else 0.0;
  return Pass.{tau = tau, dist = d3_len(d3_add(r, d3_scale(v, tau)))};
}
hostile :: (a: Ship, b: Ship) -> bool { return a.faction != b.faction; }
hi_int :: (a: int, b: int) -> int { return ifx a > b then a else b; }
// Over the step just taken (the clock now at s[0].t), a day at a time: pairs coming in range engage
// at the moment they do; pairs well apart again part.
intercepts :: (s: [] Belt, dt: f64) {
  n := s[0].ship_n;
  pieces := hi_int(1, int(dt / DAY + 0.999));
  span := dt / f64(pieces);
  st: [SHIPS] State;
  for p: 0..<pieces {
    t0 := s[0].t - dt + f64(p) * span;
    for k: 0..<n { if s[0].ships[k].mode == FLYING { st[k] = flight_state(s[0].ships[k], t0); } }
    for i: 0..<n {
      a := s[0].ships[i];
      if a.mode != FLYING { continue; }
      for j: i + 1..<n {
        b := s[0].ships[j];
        if b.mode != FLYING || !hostile(a, b) { continue; }
        if s[0].engaged[i] == j {
          if d3_dist(st[i].r, st[j].r) > 2.0 * COMBAT_RANGE { s[0].engaged[i] = -1; s[0].engaged[j] = -1; }
          continue;
        }
        if s[0].engaged[i] >= 0 || s[0].engaged[j] >= 0 { continue; }
        // a straight-line pass is close enough over a day (the Sun bends it by a few thousand km)
        pass := closest_pass(st[i].r, st[i].v, st[j].r, st[j].v, span);
        if pass.dist > COMBAT_RANGE { continue; }
        // the moment it came in range: where the gap first closed to COMBAT_RANGE
        r := d3_sub(st[j].r, st[i].r); v := d3_sub(st[j].v, st[i].v);
        vv := d3_dot(v, v); rv := d3_dot(r, v); rr := d3_dot(r, r) - COMBAT_RANGE * COMBAT_RANGE;
        tin := 0.0;
        if rr > 0.0 && vv > 0.0 { dd := rv * rv - vv * rr; tin = fclamp((-rv - sqrt(fmax(dd, 0.0))) / vv, 0.0, span); }
        engage(s, i, j, t0 + tin);
      }
    }
  }
}
engage :: (s: [] Belt, i: int, j: int, t: f64) {
  s[0].engaged[i] = j; s[0].engaged[j] = i;
  s[0].engage_t[i] = t; s[0].engage_t[j] = t;
  a := s[0].ships[i]; b := s[0].ships[j];
  if a.faction != FREE_BELT && b.faction != FREE_BELT { return; }
  // one of ours: say so and stop the clock
  mine := ifx a.faction == FREE_BELT then a else b; them := ifx a.faction == FREE_BELT then b else a;
  buf: [96] u8;
  n := put(buf[..], 0, them.name); n = put(buf[..], n, " IN RANGE OF "); n = put(buf[..], n, mine.name);
  say(s, cast(string) buf[0..<n]);
  s[0].speed = 0;
  if track_begin(s[0].track[..], "engaged") { track_str(s[0].track[..], "ours", mine.name); track_str(s[0].track[..], "theirs", them.name); track_end(s[0].track[..]); }
}

// ---- the yard: freighters from metal and people
FREIGHTER_NAMES :: [3] string.["DRAY", "TALLY", "HAWSER"];
freighter_new :: (i: int) -> Ship {
  sh := ship_new(FREE_BELT, FREIGHTER_NAMES[i % 3], P_STATION, 400.0, 900.0, 8000.0, 2000.0, 0.0);
  sh.crew = FREIGHTER_CREW;
  return sh;
}
// The station's people not crewing a ship (or a ship on the slips).
free_hands :: (s: [] Belt) -> int {
  n := s[0].station[0].people;
  for k: 0..<s[0].ship_n { if s[0].ships[k].faction == FREE_BELT { n -= s[0].ships[k].crew; } }
  if s[0].building > 0.0 { n -= FREIGHTER_CREW; }
  return n;
}
YARD_OK :: 0; YARD_METAL :: 1; YARD_HANDS :: 2; YARD_BUSY :: 3; YARD_FULL :: 4;
yard_can :: (s: [] Belt) -> int {
  if s[0].building > 0.0 { return YARD_BUSY; }
  if s[0].ship_n >= SHIPS { return YARD_FULL; }
  if s[0].station[0].metal < FREIGHTER_METAL { return YARD_METAL; }
  if free_hands(s) < FREIGHTER_CREW { return YARD_HANDS; }
  return YARD_OK;
}
// Lay down a freighter: its metal now, its crew off the shifts, done in FREIGHTER_DAYS.
yard_build :: (s: [] Belt) -> bool {
  if yard_can(s) != YARD_OK { return false; }
  s[0].station[0].metal -= FREIGHTER_METAL;
  s[0].building = FREIGHTER_DAYS;
  s[0].dirty = true;
  say(s, "FREIGHTER LAID DOWN AT HEARTH");
  return true;
}
yard_step :: (s: [] Belt, days: f64) {
  if s[0].building <= 0.0 { return; }
  s[0].building -= days;
  if s[0].building > 0.0 { return; }
  s[0].building = 0.0;
  if s[0].ship_n >= SHIPS { return; }
  k := s[0].ship_n;
  s[0].ships[k] = freighter_new(k - SHIP_BASE);
  s[0].ship_n += 1;
  s[0].ships[k].slot = berth(s, k, P_STATION);
  s[0].dirty = true;
  buf: [64] u8;
  n := put(buf[..], 0, s[0].ships[k].name); n = put(buf[..], n, " LAUNCHED AT HEARTH");
  say(s, cast(string) buf[0..<n]);
}
// The rigs: each rock a miner has worked drills on, into its stock.
rigs_step :: (s: [] Belt, days: f64) {
  for j: 0..<ICE_ROCKS { if s[0].claim[j] { s[0].stock[j] = fmin(RIG_STOCK, s[0].stock[j] + RIG_RATE * days); } }
}
// A hauler's soonest rock with a rig, or -1.
nearest_rig :: (s: [] Belt, k: int) -> int {
  best := -1; best_t := 0.0;
  for j: 0..<ICE_ROCKS {
    if !s[0].claim[j] { continue; }
    p := plan_for(s, k, P_ICE + j, true);
    if !p.ok || !p.enough { continue; }
    if best < 0 || p.tr.tof < best_t { best = P_ICE + j; best_t = p.tr.tof; }
  }
  return best;
}
// Where MINE ICE (HAUL ICE for a freighter) sends ship k: a miner's soonest rock, a hauler's soonest rig.
ice_for :: (s: [] Belt, k: int) -> int {
  return ifx s[0].ships[k].mine_rate > 0.0 then nearest_ice(s, k) else nearest_rig(s, k);
}

// MINE ICE. One ship: plan its trip to the ice rock it reaches soonest, for GO ECONOMY or GO FAST.
// Several: each goes now on its own plan from where it is: a full hold flies home to unload,
// a ship already mining keeps at it, one with no hold stays, the rest to their own soonest rock.
mine_order :: (s: [] Belt) {
  k := first_selected(s);
  if k < 0 { return; }
  if selected_count(s) > 1 { fleet_mine(s); return; }
  sh := s[0].ships[k];
  if sh.cargo_cap <= 0.0 { say(s, "KITE CARRIES NO CARGO"); return; }
  if hold_full(sh) { set_dest(s, P_STATION); say(s, "HOLD FULL: HOME TO UNLOAD"); return; }
  j := ice_for(s, k);
  if j < 0 { say(s, ifx sh.mine_rate > 0.0 then "NO ICE IN REACH" else "NO RIG IN REACH: A MINER SETS ONE WHERE IT MINES"); return; }
  set_dest(s, j);
}
hold_full :: (sh: Ship) -> bool { return sh.cargo_cap > 0.0 && sh.cargo >= sh.cargo_cap - 0.001; }
// A ship's own trip for a fleet order: the auto-miner's plan, or the fastest it can afford.
send_ship :: (s: [] Belt, k: int, dest: int, work: int) -> bool {
  p := plan_with(s, k, dest, true, 0.4);
  if !p.ok || !p.enough { p = plan_for(s, k, dest, true); }
  if !p.ok || !p.enough { p = plan_for(s, k, dest, false); }
  if !launch(s, k, dest, p) { return false; }
  verse_command_clear(s[0].cmd[..], k);
  s[0].ships[k].work = work; s[0].ships[k].work_rock = dest;
  return true;
}
fleet_mine :: (s: [] Belt) {
  mining := 0; home := 0; stuck := 0;
  for k: 0..<s[0].ship_n {
    if !s[0].cmd[0].selected[k] { continue; }
    sh := s[0].ships[k];
    if sh.faction != FREE_BELT || sh.cargo_cap <= 0.0 { continue; }
    if sh.mode == MINING && !hold_full(sh) { mining += 1; continue; }
    if hold_full(sh) {
      if sh.mode == FLYING && sh.at == P_STATION { home += 1; continue; }
      if send_ship(s, k, P_STATION, WORK_MINE) { s[0].ships[k].work_rock = ifx is_ice(sh.at) then sh.at else sh.work_rock; home += 1; } else { stuck += 1; }
      continue;
    }
    j := ice_for(s, k);
    if j < 0 || !send_ship(s, k, j, WORK_MINE) { stuck += 1; continue; }
    mining += 1;
  }
  buf: [96] u8;
  n := 0;
  if mining > 0 { n = put_count(buf[..], n, f64(mining)); n = put(buf[..], n, " TO ICE"); }
  if home > 0 { if n > 0 { n = put(buf[..], n, " · "); } n = put_count(buf[..], n, f64(home)); n = put(buf[..], n, " HOME TO UNLOAD"); }
  if stuck > 0 { if n > 0 { n = put(buf[..], n, " · "); } n = put_count(buf[..], n, f64(stuck)); n = put(buf[..], n, " SHORT OF PROPELLANT"); }
  if n == 0 { n = put(buf[..], 0, "NO SHIP HERE CARRIES CARGO"); }
  say(s, cast(string) buf[0..<n]);
  s[0].dest = -1;
}

// A ship's state now, into its history.
sight_record :: (s: [] Belt, k: int) {
  st := ship_state(s, k, s[0].t);
  h := (s[0].sight_head[k] + 1) % SIGHT_N;
  s[0].sight[k * SIGHT_N + h] = Sight.{t = s[0].t, r = st.r, v = st.v};
  s[0].sight_head[k] = h;
  if s[0].sight_n[k] < SIGHT_N { s[0].sight_n[k] += 1; }
}
// Where ship k was at time t: from its history (cubic Hermite between the two states either side),
// its present course after the newest one, the oldest one before that.
sight_at :: (s: [] Belt, k: int, t: f64) -> D3 {
  n := s[0].sight_n[k];
  if n == 0 { return ship_state(s, k, t).r; }
  newest := s[0].sight[k * SIGHT_N + s[0].sight_head[k]];
  if t >= newest.t { return ship_state(s, k, t).r; }
  for j: 1..<n {
    b := s[0].sight[k * SIGHT_N + (s[0].sight_head[k] - j + 1 + SIGHT_N) % SIGHT_N];
    a := s[0].sight[k * SIGHT_N + (s[0].sight_head[k] - j + SIGHT_N) % SIGHT_N];
    if t >= a.t {
      h := b.t - a.t;
      if h <= 0.0 { return a.r; }
      u := (t - a.t) / h;
      u2 := u * u; u3 := u2 * u;
      p := d3_scale(a.r, 2.0 * u3 - 3.0 * u2 + 1.0);
      p = d3_add(p, d3_scale(a.v, (u3 - 2.0 * u2 + u) * h));
      p = d3_add(p, d3_scale(b.r, -2.0 * u3 + 3.0 * u2));
      return d3_add(p, d3_scale(b.v, (u3 - u2) * h));
    }
  }
  return s[0].sight[k * SIGHT_N + (s[0].sight_head[k] - n + 1 + SIGHT_N) % SIGHT_N].r;
}
// Where an observer at eye sees ship k now: where it was when the light left it.
sight_seen :: (s: [] Belt, k: int, eye: D3) -> D3 {
  p := ship_state(s, k, s[0].t).r;
  for i: 0..<4 { p = sight_at(s, k, s[0].t - d3_dist(eye, p) / C_LIGHT); }
  return p;
}

// One ice rock's fast plan for the selected ship a frame, for the row of rock names.
reach_step :: (s: [] Belt) {
  sk := first_selected(s);
  if sk != s[0].reach_ship {
    s[0].reach_ship = sk;
    for i: 0..<ICE_ROCKS { s[0].reach_have[i] = false; }
  }
  if sk < 0 || s[0].dest >= 0 { return; }
  i := s[0].reach_next % ICE_ROCKS;
  s[0].reach_next = (i + 1) % ICE_ROCKS;
  p := plan_for(s, sk, P_ICE + i, true);   // the quickest trip in reach: economy is always the slow one
  s[0].reach_days[i] = ifx p.ok then p.tr.tof / DAY else 0.0;
  s[0].reach_ok[i] = p.ok && p.enough;
  s[0].reach_have[i] = true;
}

follow_ship :: (s: [] Belt, k: int) {
  if k < 0 { return; }
  s[0].follow = k; s[0].follow_place = -1; s[0].system = false; s[0].ride = -1;
  s[0].cam = spacecam_look(s[0].cam, ship_state(s, k, s[0].t).r, 1.4 * f64(hi(s[0].dpr, 0.5)));
  s[0].cam.following = true;
}

// ---- in from the host

belt_message :: (s: [] Belt, kind: int, text: string) #export_c {
  started(s);
  if kind == HOST_PAGE {
    s[0].facts = true;
    if fact_of(text, "coarse") == "1" { s[0].touch = true; }
    if stage_of(fact_of(text, "url")) == STAGE_HIGHLIGHT { stage_highlight(s); }
    if query_word(fact_of(text, "url"), "card=1") { s[0].card = true; }
  }
  if kind == HOST_HIDDEN { s[0].held = 0; }
  if kind == HOST_KEPT && !s[0].golden && !s[0].restored && s[0].stage == STAGE_NONE { s[0].restored = load_game(s, text); }
  if kind == MAKER_KIND { take_maker(s, text); }
  t := track_message(s[0].track[..], kind, text);
  if kind == HOST_PAGE { track_world(s[0].track[..], "belt-2200"); }
}

// The maker's name, as sent (never read): up to MAKER_BYTES, not cutting a character.
take_maker :: (s: [] Belt, text: string) {
  n := ifx text.count < MAKER_BYTES then text.count else MAKER_BYTES;
  if n < text.count { while n > 0 && (text[n] & 0xC0) == 0x80 { n -= 1; } }
  for i: 0..<n { s[0].maker[i] = text[i]; }
  s[0].maker_n = n;
}

// A finger or the mouse on TIP (the maker's tip page): only TIP's own presses are taken.
tip_pointer :: (s: [] Belt, x: f32, y: f32, phase: int, kind: int, id: int) -> bool {
  on := s[0].tip_shown && x >= s[0].tip_x0 && x <= s[0].tip_x1 && y >= s[0].tip_y0 && y <= s[0].tip_y1;
  if kind == 0 && !s[0].mouse_down { s[0].tip_hover = on && phase != 3; }
  if phase == 0 && on && s[0].press < 0 { s[0].tip_down = true; s[0].tip_id = id; return true; }
  if !s[0].tip_down || id != s[0].tip_id { return false; }
  if phase == 1 { return true; }
  s[0].tip_down = false;
  if phase == 2 && on && s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/realms/belt-2200/tip"); s[0].action = ACT_NAVIGATE; }
  return true;
}
belt_golden :: (s: [] Belt, on: bool) #export_c { s[0].golden = on; }
belt_action :: (s: [] Belt) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
belt_action_done :: (s: [] Belt) #export_c { s[0].out_n = 0; }

HOLD_LEFT :: 1; HOLD_RIGHT :: 2; HOLD_UP :: 4; HOLD_DOWN :: 8; HOLD_IN :: 16; HOLD_OUT :: 32;
hold_bit :: (key: int) -> int {
  if key == KEY_LEFT || key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == KEY_RIGHT || key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == KEY_UP || key == 'w' || key == 'W' { return HOLD_UP; }
  if key == KEY_DOWN || key == 's' || key == 'S' { return HOLD_DOWN; }
  if key == '=' || key == '+' || key == 'e' || key == 'E' { return HOLD_IN; }
  if key == '-' || key == '_' || key == 'q' || key == 'Q' { return HOLD_OUT; }
  return 0;
}

// Ctrl (or Cmd) and 4-9 makes the selection a group; the digit alone selects it again
// (1-3 and 0 stay the clock's speeds).
group_key :: (s: [] Belt, g: int, set: bool) {
  buf: [48] u8;
  n := put(buf[..], 0, "GROUP "); n = put_count(buf[..], n, f64(g));
  if set {
    if selected_count(s) == 0 { return; }
    ok := verse_command_group_set(s[0].cmd[..], g);
    n = put(buf[..], n, ": "); n = put_count(buf[..], n, f64(selected_count(s))); n = put(buf[..], n, ifx selected_count(s) == 1 then " SHIP" else " SHIPS");
    say(s, cast(string) buf[0..<n]);
    return;
  }
  if verse_command_group_recall(s[0].cmd[..], g) { s[0].dest = -1; say(s, cast(string) buf[0..<n]); }
}
belt_key :: (s: [] Belt, key: int, mods: int) -> bool #export_c {
  started(s);
  track_key(s[0].track[..], key, false);
  if key == KEY_SHIFT { s[0].shift = true; return true; }
  b := hold_bit(key);
  if b != 0 { s[0].held = s[0].held | b; return true; }
  if key == ' ' { s[0].speed = ifx s[0].speed == 0 then 2 else 0; return true; }
  if key >= '4' && key <= '9' { group_key(s, key - '0', (mods & 10) != 0); return true; }
  if key == '1' || key == '2' || key == '3' { s[0].speed = key - '0'; return true; }
  if key == '0' { s[0].speed = 0; return true; }
  if key == KEY_ESCAPE {
    if s[0].dest >= 0 { s[0].dest = -1; } else { select_only(s, -1); }
    return true;
  }
  if key == KEY_ENTER { go(s, false); return true; }
  if key == 'f' || key == 'F' { follow_ship(s, first_selected(s)); return true; }
  if key == 'h' || key == 'H' { if first_selected(s) >= 0 { set_dest(s, P_STATION); } return true; }
  if key == 'm' || key == 'M' { mine_order(s); return true; }
  if key == 'c' || key == 'C' { look_at_system(s); return true; }
  if key == 9 {
    // the next Free Belt ship
    k := first_selected(s);
    for i: 1..<s[0].ship_n + 1 {
      j := (k + i + s[0].ship_n) % s[0].ship_n;
      if s[0].ships[j].faction == FREE_BELT { select_only(s, j); return true; }
    }
  }
  return false;
}
belt_key_up :: (s: [] Belt, key: int, mods: int) -> bool #export_c {
  track_key_up(s[0].track[..], key);
  if key == KEY_SHIFT { s[0].shift = false; return true; }
  b := hold_bit(key);
  if b != 0 { s[0].held = s[0].held & (63 - b); return true; }
  return false;
}
belt_blur :: (s: [] Belt) #export_c { s[0].held = 0; s[0].shift = false; s[0].mouse_down = false; track_blur(s[0].track[..]); for i: 0..<2 { s[0].fingers[i].id = -1; } }

button_at :: (s: [] Belt, x: f32, y: f32) -> int {
  for i: 0..<s[0].btn_n {
    b := s[0].btn[i];
    if x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1 { return i; }
  }
  return -1;
}

press_button :: (s: [] Belt, i: int) {
  b := s[0].btn[i];
  if b.id == B_SPEED { s[0].speed = b.arg; }
  if b.id == B_CARD {
    if s[0].shift { s[0].cmd[0].selected[b.arg] = !s[0].cmd[0].selected[b.arg]; s[0].dest = -1; }
    else if s[0].cmd[0].selected[b.arg] && selected_count(s) == 1 { follow_ship(s, b.arg); }
    else { select_only(s, b.arg); }
  }
  if b.id == B_MINE { mine_order(s); }
  if b.id == B_HOME { set_dest(s, P_STATION); }
  if b.id == B_FOLLOW { follow_ship(s, first_selected(s)); }
  if b.id == B_GO { go(s, b.arg == 1); }
  if b.id == B_CANCEL { s[0].dest = -1; }
  if b.id == B_ROCK { set_dest(s, P_ICE + b.arg); }
  if b.id == B_SYSTEM { look_at_system(s); }
  if b.id == B_BUILD { ok := yard_build(s); }
  if b.id == B_NEW {
    // twice to start over: the first press asks
    if s[0].new_armed > 0 { s[0].new_armed = 0; new_game(s); } else { s[0].new_armed = 3.0; }
  }
  if b.id == B_GALAXY && s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/verse/galaxy"); s[0].action = ACT_NAVIGATE; }
}

screen_of :: (s: [] Belt, p: D3) -> D2 { return spacecam_screen(s[0].cam, p, f64(s[0].w), f64(s[0].h)); }

// The ship of a faction (or any, -1) nearest a pixel, within reach.
// The ship nearest (x, y) within reach, or within its hull's ring when it is drawn bigger.
ship_at :: (s: [] Belt, x: f32, y: f32, reach: f32, faction: int) -> int {
  best := -1; bd := 0.0f32;
  for k: 0..<s[0].ship_n {
    if faction >= 0 && s[0].ships[k].faction != faction { continue; }
    q := ship_screen(s, k);
    dx := pix(q.x) - x; dy := pix(q.y) - y;
    d := dx * dx + dy * dy;
    r := hi(reach, ship_hull_px(s, k) * 0.625);
    if d < r * r && (best < 0 || d < bd) { bd = d; best = k; }
  }
  return best;
}
// The hull's length on the screen, as draw_ship draws it.
ship_hull_px :: (s: [] Belt, k: int) -> f32 {
  return hi(pix(spacecam_pixels(s[0].cam, ifx s[0].ships[k].dry > 400.0 then 180.0 else 120.0)), stage_hull(s, k));
}
// The place nearest a pixel, within reach (or inside a world's disc).
place_at :: (s: [] Belt, x: f32, y: f32, reach: f32) -> int {
  best := -1; bd := reach * reach;
  for p: 1..<PLACES {
    q := screen_of(s, place_state(s, p, s[0].t).r);
    dx := pix(q.x) - x; dy := pix(q.y) - y;
    d := dx * dx + dy * dy;
    if p == BODY_MOON {
      // drawn only when it stands apart from the Earth; until then a tap there means the Earth
      e := screen_of(s, orbit_body_position(BODY_EARTH, s[0].t));
      if pix(sqrt((e.x - q.x) * (e.x - q.x) + (e.y - q.y) * (e.y - q.y))) < 14 * hi(s[0].dpr, 0.5) { continue; }
    }
    if p < BODIES {
      r := pix(spacecam_pixels(s[0].cam, BODY_RADIUS[p]));
      if d < r * r { d = 0; }
    }
    if p == P_STATION { d = d * 0.5; }
    if d < bd { bd = d; best = p; }
  }
  return best;
}

map_tap :: (s: [] Belt, x: f32, y: f32) {
  k := hi(s[0].dpr, 0.5);
  own := ship_at(s, x, y, 16 * k, FREE_BELT);
  if own >= 0 {
    if s[0].shift { s[0].cmd[0].selected[own] = !s[0].cmd[0].selected[own]; s[0].dest = -1; } else { select_only(s, own); }
    return;
  }
  if selected_count(s) > 0 {
    p := place_at(s, x, y, 22 * k);
    if p >= 0 { set_dest(s, p); return; }
  }
  other := ship_at(s, x, y, 14 * k, -1);
  if other >= 0 {
    sh := s[0].ships[other];
    buf: [96] u8;
    n := put(buf[..], 0, ifx sh.faction == MARS_UNION then "MARS UNION " else "TERRAN COMPACT ");
    n = put(buf[..], n, sh.name);
    n = put(buf[..], n, ifx sh.mode == FLYING then " BOUND FOR " else " AT ");
    n = put(buf[..], n, place_name(sh.at));
    say(s, cast(string) buf[0..<n]);
    return;
  }
  if s[0].dest >= 0 { s[0].dest = -1; return; }
  // nothing selected: a tap on a world, a rock or the station flies the view to it
  if selected_count(s) == 0 {
    p := place_at(s, x, y, 22 * k);
    if p >= 0 { look_at_place(s, p); }
  }
}

// The view flies to a place and rides with it: a world a fifth of the screen across, a rock or
// the station with room around it.
look_at_place :: (s: [] Belt, p: int) {
  size := ifx is_world(p) then BODY_RADIUS[p] * 5.0 else ifx is_ice(p) then ICE_RADII[p - P_ICE] * 8.0 else 4000.0;
  s[0].follow = -1; s[0].system = false; s[0].ride = -1;
  s[0].follow_place = p;
  s[0].cam = spacecam_look(s[0].cam, place_state(s, p, s[0].t).r, f64(lo(s[0].w, s[0].h)) / size);
  s[0].cam.following = true;
}
// The whole system again: the Sun and Hearth Station, the inner worlds between.
SYSTEM_SPAN :: 1.6;
system_scale :: (s: [] Belt) -> f64 { return f64(lo(s[0].w, s[0].h * 0.75)) / (d3_len(place_state(s, P_STATION, s[0].t).r) * SYSTEM_SPAN); }
look_at_system :: (s: [] Belt) {
  s[0].follow = -1; s[0].follow_place = -1; s[0].ride = -1; s[0].system = true;
  s[0].cam = spacecam_look(s[0].cam, d3_scale(place_state(s, P_STATION, s[0].t).r, 0.5), system_scale(s));
  s[0].cam.following = false;
}
// After the player pans or zooms: in close (past a few times the system's scale) the view rides
// with the place nearest (x, y); out at the system's scale it stays put about the Sun.
RIDE_ZOOM :: 3.0;
pick_ride :: (s: [] Belt, x: f32, y: f32) {
  s[0].system = false;
  s[0].ride = -1;
  if s[0].follow >= 0 || s[0].follow_place >= 0 || s[0].w <= 0 || s[0].h <= 0 { return; }
  if s[0].cam.goal_scale < RIDE_ZOOM * system_scale(s) { return; }
  p := place_at(s, x, y, s[0].w + s[0].h);
  if p < 0 { return; }
  s[0].ride = p;
  s[0].ride_r = place_state(s, p, s[0].t).r;
}
// The view's frame, every step: the system view re-framed as Hearth goes round, or the view
// moved by as much as the place it rides with moved.
ride_step :: (s: [] Belt) {
  if s[0].follow >= 0 || s[0].follow_place >= 0 || s[0].w <= 0 || s[0].h <= 0 { return; }
  if s[0].system {
    s[0].cam.goal_center = d3_scale(place_state(s, P_STATION, s[0].t).r, 0.5);
    s[0].cam.goal_scale = system_scale(s);
    return;
  }
  if s[0].ride < 0 { return; }
  now := place_state(s, s[0].ride, s[0].t).r;
  moved := d3_sub(now, s[0].ride_r);
  s[0].cam.center = d3_add(s[0].cam.center, moved);
  s[0].cam.goal_center = d3_add(s[0].cam.goal_center, moved);
  s[0].ride_r = now;
}

box_select :: (s: [] Belt, x0: f32, y0: f32, x1: f32, y1: f32) {
  xs: [SHIPS] f32; ys: [SHIPS] f32; mine: [SHIPS] bool;
  for k: 0..<s[0].ship_n {
    q := ship_screen(s, k);
    xs[k] = pix(q.x); ys[k] = pix(q.y); mine[k] = s[0].ships[k].faction == FREE_BELT;
  }
  n := verse_command_box(s[0].cmd[..], xs[0..<s[0].ship_n], ys[0..<s[0].ship_n], mine[0..<s[0].ship_n], x0, y0, x1, y1, s[0].shift);
  s[0].dest = -1;
}

zoom_at :: (s: [] Belt, factor: f64, x: f32, y: f32) {
  s[0].cam = spacecam_zoom_at(s[0].cam, factor, f64(x), f64(y), f64(s[0].w), f64(s[0].h));
  pick_ride(s, x, y);
}
pan :: (s: [] Belt, dx: f32, dy: f32) {
  s[0].cam = spacecam_pan(s[0].cam, f64(dx), f64(dy));
  s[0].follow = -1; s[0].follow_place = -1;
  pick_ride(s, s[0].w / 2, s[0].h / 2);
}

belt_pointer :: (s: [] Belt, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  started(s);
  if tip_pointer(s, x, y, phase, kind, id) { s[0].hover = -1; return true; }
  k := hi(s[0].dpr, 0.5);
  on := button_at(s, x, y);
  track_pointer(s[0].track[..], x, y, phase, kind, ifx on >= 0 then "button" else "");
  if kind == 0 {
    if phase == 1 && !s[0].mouse_down { s[0].hover = on; s[0].mx = x; s[0].my = y; return on >= 0; }
    if phase == 0 {
      s[0].mx = x; s[0].my = y;
      if on >= 0 { s[0].press = on; return true; }
      s[0].mouse_down = true; s[0].dx0 = x; s[0].dy0 = y; s[0].dragging = false; s[0].boxing = false;
      return true;
    }
    if phase == 1 {
      if s[0].press >= 0 { return true; }
      ddx := x - s[0].dx0; ddy := y - s[0].dy0;
      if !s[0].dragging && ddx * ddx + ddy * ddy > 36 * k * k {
        s[0].dragging = true;
        // A drag that starts on your ship, or with Shift, draws a box; otherwise it pans.
        s[0].boxing = s[0].shift || ship_at(s, s[0].dx0, s[0].dy0, 16 * k, FREE_BELT) >= 0 || selected_count(s) == 0;
      }
      if s[0].dragging && !s[0].boxing { pan(s, x - s[0].mx, y - s[0].my); }
      s[0].mx = x; s[0].my = y;
      return true;
    }
    if phase == 2 || phase == 3 {
      if s[0].press >= 0 {
        p := s[0].press; s[0].press = -1;
        if phase == 2 && button_at(s, x, y) == p { press_button(s, p); }
        return true;
      }
      if !s[0].mouse_down { return false; }
      s[0].mouse_down = false;
      if phase == 2 {
        if s[0].dragging && s[0].boxing { box_select(s, s[0].dx0, s[0].dy0, x, y); }
        else if !s[0].dragging { map_tap(s, x, y); }
      }
      s[0].dragging = false; s[0].boxing = false;
      return true;
    }
    return false;
  }
  // Fingers: one taps or pans, two pinch.
  if phase == 0 {
    s[0].touch = true; s[0].press_t = s[0].clock;
    if on >= 0 && s[0].fingers[0].id < 0 { s[0].press = on; return true; }
    for i: 0..<2 {
      if s[0].fingers[i].id < 0 {
        s[0].fingers[i] = Finger.{id = id, x = x, y = y, sx = x, sy = y};
        if s[0].fingers[0].id >= 0 && s[0].fingers[1].id >= 0 {
          ex := s[0].fingers[0].x - s[0].fingers[1].x; ey := s[0].fingers[0].y - s[0].fingers[1].y;
          s[0].pinch = sqrt(ex * ex + ey * ey);
          s[0].dragging = true;
        } else { s[0].dragging = false; }
        return true;
      }
    }
    return true;
  }
  f := -1;
  for i: 0..<2 { if s[0].fingers[i].id == id { f = i; } }
  if s[0].press >= 0 && f < 0 {
    if phase == 2 || phase == 3 {
      p := s[0].press; s[0].press = -1;
      if phase == 2 && button_at(s, x, y) == p { press_button(s, p); }
    }
    return true;
  }
  if f < 0 { return false; }
  if phase == 1 {
    both := s[0].fingers[0].id >= 0 && s[0].fingers[1].id >= 0;
    if both {
      ox := s[0].fingers[0].x; oy := s[0].fingers[0].y; px1 := s[0].fingers[1].x; py1 := s[0].fingers[1].y;
      mx0 := (ox + px1) / 2; my0 := (oy + py1) / 2;
      s[0].fingers[f].x = x; s[0].fingers[f].y = y;
      nx := (s[0].fingers[0].x + s[0].fingers[1].x) / 2; ny := (s[0].fingers[0].y + s[0].fingers[1].y) / 2;
      ex := s[0].fingers[0].x - s[0].fingers[1].x; ey := s[0].fingers[0].y - s[0].fingers[1].y;
      d := sqrt(ex * ex + ey * ey);
      pan(s, nx - mx0, ny - my0);
      if s[0].pinch > 1 && d > 1 { zoom_at(s, f64(d / s[0].pinch), nx, ny); s[0].cam = spacecam_settle(s[0].cam); }
      s[0].pinch = d;
      return true;
    }
    ddx := x - s[0].fingers[f].sx; ddy := y - s[0].fingers[f].sy;
    if !s[0].dragging && ddx * ddx + ddy * ddy > 100 * k * k { s[0].dragging = true; }
    if s[0].dragging { pan(s, x - s[0].fingers[f].x, y - s[0].fingers[f].y); s[0].cam = spacecam_settle(s[0].cam); }
    s[0].fingers[f].x = x; s[0].fingers[f].y = y;
    return true;
  }
  if phase == 2 || phase == 3 {
    both := s[0].fingers[0].id >= 0 && s[0].fingers[1].id >= 0;
    if phase == 2 && !both && !s[0].dragging {
      // a long-press on your ship adds it to the selection, or takes it out
      own := ship_at(s, x, y, 16 * k, FREE_BELT);
      if own >= 0 && s[0].clock - s[0].press_t >= LONG_PRESS { verse_command_toggle(s[0].cmd[..], own); s[0].dest = -1; }
      else { map_tap(s, x, y); }
    }
    s[0].fingers[f].id = -1;
    if !both { s[0].dragging = false; }
    return true;
  }
  return false;
}

belt_wheel :: (s: [] Belt, dy: f32) -> bool #export_c {
  started(s);
  zoom_at(s, exp(-f64(dy) * 0.0018), s[0].mx, s[0].my);
  return true;
}
belt_cursor :: (s: [] Belt) -> int #export_c {
  if s[0].hover >= 0 || s[0].tip_hover { return 1; }
  if s[0].boxing { return 2; }
  return 0;
}

// ---- drawing: the map

// A frame's drawing: its strokes, the labels waiting to be placed (most important first, each
// where it overlaps nothing placed before it), what they must not cover, and the worlds as discs.
Tag :: struct { text: string; x: f32; y: f32; r: f32; cap: f32; light: f32; red: f32; green: f32; blue: f32; prio: int; }
Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
TAGS :: 48;
BLOCKS :: 128;
Draw :: struct { n: int; k: f32; w: f32; h: f32; under: f32; tags: [TAGS] Tag; tag_n: int; blocks: [BLOCKS] Rect; block_n: int; disc_n: int; }

// Labels by importance: the one you are planning or have selected, yours, the worlds, the rivals.
PRIO_HOT :: 10; PRIO_OWN :: 8; PRIO_WORLD :: 6; PRIO_ICE :: 4; PRIO_RIVAL :: 3; PRIO_PARKED :: 1;
PRIO_ALWAYS :: 10;  // at or above this a label is drawn even when it must overlap

tag :: (d: [] Draw, text: string, x: f32, y: f32, r: f32, cap: f32, light: f32, red: f32, green: f32, blue: f32, prio: int) {
  if d[0].tag_n >= TAGS { return; }
  if x < -300 || y < -100 || x > d[0].w + 100 || y > d[0].h + 100 { return; }
  d[0].tags[d[0].tag_n] = Tag.{text = text, x = x, y = y, r = r, cap = cap, light = light, red = red, green = green, blue = blue, prio = prio};
  d[0].tag_n += 1;
}
block_rect :: (d: [] Draw, x0: f32, y0: f32, x1: f32, y1: f32) {
  if d[0].block_n >= BLOCKS { return; }
  d[0].blocks[d[0].block_n] = Rect.{x0 = x0, y0 = y0, x1 = x1, y1 = y1};
  d[0].block_n += 1;
}
// Something drawn at x, y, r across, that labels keep clear of.
block :: (d: [] Draw, x: f32, y: f32, r: f32) {
  if x + r < 0 || y + r < 0 || x - r > d[0].w || y - r > d[0].h { return; }
  block_rect(d, x - r, y - r, x + r, y + r);
}
covers :: (d: [] Draw, a: Rect) -> bool {
  for i: 0..<d[0].block_n {
    b := d[0].blocks[i];
    if a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0 { return true; }
  }
  return false;
}
// Place the labels: most important first, to the right of their thing, else left, below or
// above; one that fits nowhere is left out unless it matters (PRIO_ALWAYS).
place_tags :: (s: [] Belt, out: [] f32, u: [] f32, d: [] Draw) {
  k := d[0].k;
  // the HUD's panels, buttons and the toast are kept clear
  for i: 0..<s[0].panel_n { o := U_PANEL + i * 8; block_rect(d, u[o], u[o + 1], u[o + 2], u[o + 3]); }
  for i: 0..<s[0].btn_n { b := s[0].btn[i]; block_rect(d, b.x0, b.y0, b.x1, b.y1); }
  if s[0].toast_t > 0 { block_rect(d, 0, s[0].toast_y - 12 * k, d[0].w, s[0].toast_y + 4 * k); }
  done: [TAGS] bool;
  for round: 0..<d[0].tag_n {
    best := -1;
    for i: 0..<d[0].tag_n { if !done[i] && (best < 0 || d[0].tags[i].prio > d[0].tags[best].prio) { best = i; } }
    if best < 0 { break; }
    done[best] = true;
    g := d[0].tags[best];
    tw := text_width(g.text, g.cap);
    gap := g.r + 5 * k; pad := 2 * k;
    xs := [4] f32.[g.x + gap, g.x - gap - tw, g.x - tw / 2, g.x - tw / 2];
    bs := [4] f32.[g.y + g.cap / 2, g.y + g.cap / 2, g.y + gap + g.cap, g.y - gap];
    chosen := -1;
    for c: 0..<4 {
      rc := Rect.{x0 = xs[c] - pad, y0 = bs[c] - g.cap - pad, x1 = xs[c] + tw + pad, y1 = bs[c] + pad};
      if rc.x0 < 0 || rc.y0 < 0 || rc.x1 > d[0].w || rc.y1 > d[0].h { continue; }
      if !covers(d, rc) { chosen = c; break; }
    }
    if chosen < 0 {
      if g.prio < PRIO_ALWAYS || xs[0] < 0 || xs[0] + tw > d[0].w { continue; }
      chosen = 0;
    }
    block_rect(d, xs[chosen] - pad, bs[chosen] - g.cap - pad, xs[chosen] + tw + pad, bs[chosen] + pad);
    words(out, d, g.text, xs[chosen], bs[chosen], g.cap, g.light, g.red, g.green, g.blue);
  }
}

// A world as a shaded disc, drawn by the sky's pass (belt.wgsl world()).
disc :: (s: [] Belt, u: [] f32, d: [] Draw, at: D2, r: f64, kind: int, seed: f32, spin: f32) {
  if d[0].disc_n >= DISCS { return; }
  w := f64(d[0].w); h := f64(d[0].h);
  rr := r * 2.4 + 6.0;
  if at.x + rr < 0.0 || at.y + rr < 0.0 || at.x - rr > w || at.y - rr > h || r > 5000000.0 { return; }
  sun := screen_of(s, D3_ZERO);
  lx := sun.x - at.x; ly := sun.y - at.y;
  ll := sqrt(lx * lx + ly * ly);
  if ll <= 0.0 { lx = 1.0; ly = 0.0; ll = 1.0; }
  o := U_DISC + d[0].disc_n * 8;
  u[o] = pix(at.x); u[o + 1] = pix(at.y); u[o + 2] = pix(r); u[o + 3] = f32(kind);
  u[o + 4] = f32(lx / ll); u[o + 5] = f32(ly / ll); u[o + 6] = seed; u[o + 7] = spin;
  d[0].disc_n += 1;
}
DISC_KIND :: [10] int.[0, 1, 2, 3, 4, 5, 8, 9, 6, 7];
// The least a world is drawn across at system zoom, in pixels at dpr 1.
DISC_MIN :: [10] f32.[0.0, 3.6, 5.2, 5.6, 2.6, 4.8, 3.0, 2.6, 10.0, 8.5];

stroke :: (out: [] f32, d: [] Draw, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, red: f32, green: f32, blue: f32) {
  stroke_g(out, d, ax, ay, bx, by, core, light, 1.4 * d[0].k, red, green, blue);
}
stroke_g :: (out: [] f32, d: [] Draw, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) {
  // cull what is wholly off screen
  m := glow + core + 2;
  if (ax < -m && bx < -m) || (ay < -m && by < -m) || (ax > d[0].w + m && bx > d[0].w + m) || (ay > d[0].h + m && by > d[0].h + m) { return; }
  if lit(out, d[0].n, ax, ay, bx, by, core, light, glow, red, green, blue, d[0].under) { d[0].n += 6; }
}
dot :: (out: [] f32, d: [] Draw, x: f32, y: f32, r: f32, light: f32, red: f32, green: f32, blue: f32) {
  stroke_g(out, d, x - 0.01, y, x + 0.01, y, r, light, 1.5 * d[0].k, red, green, blue);
}
ring :: (out: [] f32, d: [] Draw, x: f32, y: f32, r: f32, sides: int, core: f32, light: f32, red: f32, green: f32, blue: f32) {
  if x + r < 0 || y + r < 0 || x - r > d[0].w || y - r > d[0].h { return; }
  for i: 0..<sides {
    a0 := f32(i) * 6.2831853 / f32(sides); a1 := f32(i + 1) * 6.2831853 / f32(sides);
    stroke_g(out, d, x + cos(a0) * r, y + sin(a0) * r, x + cos(a1) * r, y + sin(a1) * r, core, light, 1.2 * d[0].k, red, green, blue);
  }
}
words :: (out: [] f32, d: [] Draw, text: string, x: f32, base: f32, cap: f32, light: f32, red: f32, green: f32, blue: f32) {
  d[0].n = draw_text(out, d[0].n, text, x, base, cap, GAP, SPACE, ink(d[0].k, light, red, green, blue), false, false);
}
centred :: (out: [] f32, d: [] Draw, text: string, x: f32, base: f32, cap: f32, light: f32, red: f32, green: f32, blue: f32) {
  words(out, d, text, x - text_width(text, cap) / 2, base, cap, light, red, green, blue);
}

faction_rgb :: (f: int) -> Point3 {
  if f == MARS_UNION { return Point3.{x = MARS_R, y = MARS_G, z = MARS_B}; }
  if f == TERRAN { return Point3.{x = TERRA_R, y = TERRA_G, z = TERRA_B}; }
  return Point3.{x = BELT_R, y = BELT_G, z = BELT_B};
}
Point3 :: struct { x: f32; y: f32; z: f32; }

// An orbit's ellipse: whole when it fits the screen many times over; near
// the view's centre, finely, when it is huge, so the line stays on its orbit.
draw_orbit :: (s: [] Belt, out: [] f32, d: [] Draw, o: Orbit, origin: D3, light: f32, red: f32, green: f32, blue: f32) {
  if o.e >= 1.0 { return; }
  big := spacecam_pixels(s[0].cam, o.a * (1.0 + o.e));
  if big < 3.0 { return; }
  cn := cos(o.node); sn := sin(o.node); ci := cos(o.i); si := sin(o.i); cw := cos(o.peri); sw := sin(o.peri);
  p := d3(cn * cw - sn * sw * ci, sn * cw + cn * sw * ci, sw * si);
  q := d3(-cn * sw - sn * cw * ci, -sn * sw + cn * cw * ci, cw * si);
  b := o.a * sqrt(1.0 - o.e * o.e);
  e0 := 0.0; span := TAU_D; sides := 160;
  diag := sqrt(f64(d[0].w * d[0].w + d[0].h * d[0].h));
  if big > 6.0 * diag {
    rel := d3_sub(s[0].cam.center, origin);
    cx := d3_dot(rel, p); cy := d3_dot(rel, q);
    e0 = atan2_d(cy / b, cx / o.a + o.e);
    span = fmin(TAU_D, 4.0 * diag / big);
    e0 = e0 - span / 2.0;
    sides = 96;
  }
  prev: D2;
  for i: 0..<sides + 1 {
    ea := e0 + span * f64(i) / f64(sides);
    pt := d3_add(origin, d3_add(d3_scale(p, o.a * (cos(ea) - o.e)), d3_scale(q, b * sin(ea))));
    sc := screen_of(s, pt);
    if i > 0 { stroke_g(out, d, pix(prev.x), pix(prev.y), pix(sc.x), pix(sc.y), 0.55 * d[0].k, light, 1.0 * d[0].k, red, green, blue); }
    prev = sc;
  }
}

draw_path :: (s: [] Belt, out: [] f32, d: [] Draw, pts: [] D3, from: int, light: f32, dashed: bool, red: f32, green: f32, blue: f32) {
  for i: from + 1..<pts.count {
    if dashed && i % 2 == 0 { continue; }
    a := screen_of(s, pts[i - 1]); b := screen_of(s, pts[i]);
    stroke_g(out, d, pix(a.x), pix(a.y), pix(b.x), pix(b.y), 0.7 * d[0].k, light, 1.6 * d[0].k, red, green, blue);
  }
}

// A planned transfer: the coast brightening toward the arrival, a tick every 30 days, the
// departure burn, and the crosshair where ship and target meet with the date.
TRANSFER_PTS :: 72;
draw_transfer :: (s: [] Belt, out: [] f32, d: [] Draw, p: Plan, light: f32, main: bool, red: f32, green: f32, blue: f32) {
  k := d[0].k;
  arc := orbit_from_state(p.tr.depart, GM_SUN, p.tr.t0);
  prev := screen_of(s, p.tr.depart.r);
  first := prev;
  for i: 1..<TRANSFER_PTS {
    f := f64(i) / f64(TRANSFER_PTS - 1);
    q := screen_of(s, orbit_position(arc, p.tr.t0 + p.tr.tof * f));
    l := light * (0.35 + 0.65 * f32(f));
    stroke_g(out, d, pix(prev.x), pix(prev.y), pix(q.x), pix(q.y), (ifx main then 0.9f32 else 0.6f32) * k, l, 2.2 * k, red, green, blue);
    prev = q;
  }
  // a tick every 30 days, across the line
  if main {
    days := 30.0 * DAY;
    tt := days;
    while tt < p.tr.tof - DAY * 5.0 {
      a := screen_of(s, orbit_position(arc, p.tr.t0 + tt));
      b := screen_of(s, orbit_position(arc, p.tr.t0 + tt + DAY));
      dx := pix(b.x - a.x); dy := pix(b.y - a.y);
      ln := sqrt(dx * dx + dy * dy);
      if ln > 0.0001 {
        nx := -dy / ln * 4 * k; ny := dx / ln * 4 * k;
        stroke(out, d, pix(a.x) - nx, pix(a.y) - ny, pix(a.x) + nx, pix(a.y) + ny, 0.6 * k, light * 0.7, red, green, blue);
      }
      tt += days;
    }
  }
  bx := pix(prev.x); by := pix(prev.y);
  stroke(out, d, bx - 6 * k, by, bx - 2 * k, by, 0.9 * k, light, red, green, blue);
  stroke(out, d, bx + 2 * k, by, bx + 6 * k, by, 0.9 * k, light, red, green, blue);
  stroke(out, d, bx, by - 6 * k, bx, by - 2 * k, 0.9 * k, light, red, green, blue);
  stroke(out, d, bx, by + 2 * k, bx, by + 6 * k, 0.9 * k, light, red, green, blue);
  ring(out, d, bx, by, 9 * k, 24, 0.7 * k, light * 0.8, red, green, blue);
  if main {
    ax := pix(first.x); ay := pix(first.y);
    dot(out, d, ax, ay, 2.2 * k, light, red, green, blue);
    ring(out, d, ax, ay, 5 * k, 16, 0.6 * k, light * 0.7, red, green, blue);
    dt := date_of(p.tr.t0 + p.tr.tof);
    n := put(s[0].arrive[..], 0, "ARRIVE "); n = put_int(s[0].arrive[..], n, dt.day); n = put(s[0].arrive[..], n, " "); n = put(s[0].arrive[..], n, MONTHS[(dt.month - 1) % 12]);
    s[0].arrive_n = n;
    tag(d, cast(string) s[0].arrive[0..<n], bx, by, 10 * k, 6 * k, 0.9, red, green, blue, PRIO_HOT - 1);
  }
  block(d, bx, by, 9 * k);
}

// The station: a ring with spokes and two arms when it is big enough, else a diamond.
draw_station :: (s: [] Belt, out: [] f32, d: [] Draw, at: D3) {
  c := screen_of(s, at);
  x := pix(c.x); y := pix(c.y); k := d[0].k;
  rr := pix(spacecam_pixels(s[0].cam, 450.0));
  if rr > 10 * k {
    ring(out, d, x, y, rr, 64, 1.0 * k, 0.9, BELT_R, BELT_G, BELT_B);
    ring(out, d, x, y, rr * 0.86, 64, 0.6 * k, 0.5, BELT_R, BELT_G, BELT_B);
    ring(out, d, x, y, rr * 0.13, 24, 0.9 * k, 0.9, INK_R, INK_G, INK_B);
    for i: 0..<6 {
      a := f32(i) * 1.0471976 + f32(wrap_tau(s[0].t / 600.0));
      stroke(out, d, x + cos(a) * rr * 0.13, y + sin(a) * rr * 0.13, x + cos(a) * rr * 0.86, y + sin(a) * rr * 0.86, 0.6 * k, 0.6, INK_R, INK_G, INK_B);
    }
    stroke(out, d, x - rr * 1.5, y, x - rr * 0.13, y, 0.8 * k, 0.7, INK_R, INK_G, INK_B);
    stroke(out, d, x + rr * 0.13, y, x + rr * 1.5, y, 0.8 * k, 0.7, INK_R, INK_G, INK_B);
  } else {
    r := 6 * k;
    stroke(out, d, x, y - r, x + r, y, 1.0 * k, 0.95, BELT_R, BELT_G, BELT_B);
    stroke(out, d, x + r, y, x, y + r, 1.0 * k, 0.95, BELT_R, BELT_G, BELT_B);
    stroke(out, d, x, y + r, x - r, y, 1.0 * k, 0.95, BELT_R, BELT_G, BELT_B);
    stroke(out, d, x - r, y, x, y - r, 1.0 * k, 0.95, BELT_R, BELT_G, BELT_B);
  }
  reach := hi(rr * 1.5, 7 * k);
  block(d, x, y, reach);
  // Home is always named, first: your ships and the ice crowd round it, and would leave it no free
  // side; the selected ship's name then finds a side of its own.
  if reach < 160 * k { tag(d, "HEARTH", x, y, reach, 7 * k, 0.9, BELT_R, BELT_G, BELT_B, PRIO_HOT + 1); }
}

// A ship: a chevron along its heading, or its hull in metres when close.
// Where a ship is drawn: where it is, except that one sitting at a world or the station
// when the view is far stands just outside that world's disc (its berth's side), not on it.
ship_screen :: (s: [] Belt, k: int) -> D2 {
  sh := s[0].ships[k];
  c := screen_of(s, ship_state(s, k, s[0].t).r);
  if sh.mode == FLYING { return c; }
  u := f64(hi(s[0].dpr, 0.5));
  home := screen_of(s, place_state(s, sh.at, s[0].t).r);
  least := ifx is_world(sh.at) then fmax(spacecam_pixels(s[0].cam, BODY_RADIUS[sh.at]), f64(DISC_MIN[sh.at]) * u) + 13.0 * u else 11.0 * u;
  least += f64(sh.slot) * 9.0 * u;
  dx := c.x - home.x; dy := c.y - home.y;
  dd := sqrt(dx * dx + dy * dy);
  if dd >= least { return c; }
  a := f64(sh.slot) * 1.1 + f64(k) * 0.37 + 0.6;
  return d2(home.x + cos(a) * least, home.y - sin(a) * least);
}

// A line in a hull's own frame: along a, across n, as fractions of its length h.
hull_line :: (out: [] f32, d: [] Draw, x: f32, y: f32, h: f32, ch: f32, sn: f32, a0: f32, n0: f32, a1: f32, n1: f32, core: f32, light: f32, r: f32, g: f32, b: f32) {
  stroke(out, d, x + (ch * a0 - sn * n0) * h, y + (sn * a0 + ch * n0) * h, x + (ch * a1 - sn * n1) * h, y + (sn * a1 + ch * n1) * h, core, light, r, g, b);
}
// A hull, h pixels long along (ch, sh): a drive bell, tanks in pairs, radiators across the
// spine, a crew ring and the command module at the bow, in its faction's colour.
draw_hull :: (out: [] f32, d: [] Draw, x: f32, y: f32, h: f32, ch: f32, sn: f32, big: bool, col: Point3) {
  u := d[0].k;
  nx := -sn; ny := ch;
  cw := 0.8 * u; thin := 0.6 * u;
  // the spine
  hull_line(out, d, x, y, h, ch, sn, -0.4, 0.0, 0.3, 0.0, 1.0 * u, 0.9, col.x, col.y, col.z);
  // the drive bell
  hull_line(out, d, x, y, h, ch, sn, -0.4, 0.035, -0.5, 0.09, cw, 0.9, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, -0.4, -0.035, -0.5, -0.09, cw, 0.9, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, -0.5, 0.09, -0.5, -0.09, thin, 0.7, col.x, col.y, col.z);
  // tanks: two pairs (one on the small hull)
  pairs := ifx big then 2 else 1;
  for p: 0..<pairs {
    a := -0.27 + f32(p) * 0.15;
    for side: 0..<2 {
      sg := ifx side == 0 then 1.0f32 else -1.0f32;
      cx := x + (ch * a - sn * 0.075 * sg) * h; cy := y + (sn * a + ch * 0.075 * sg) * h;
      ring(out, d, cx, cy, 0.06 * h, 16, thin, 0.75, INK_R, INK_G, INK_B);
    }
  }
  // radiators: thin panels across the spine
  for side: 0..<2 {
    sg := ifx side == 0 then 1.0f32 else -1.0f32;
    hull_line(out, d, x, y, h, ch, sn, 0.02, 0.04 * sg, 0.02, 0.3 * sg, thin, 0.55, ICE_R, ICE_G, ICE_B);
    hull_line(out, d, x, y, h, ch, sn, 0.08, 0.04 * sg, 0.08, 0.3 * sg, thin, 0.55, ICE_R, ICE_G, ICE_B);
    hull_line(out, d, x, y, h, ch, sn, 0.02, 0.3 * sg, 0.08, 0.3 * sg, thin, 0.55, ICE_R, ICE_G, ICE_B);
    for r: 1..<4 { hull_line(out, d, x, y, h, ch, sn, 0.02, (0.04 + 0.065 * f32(r)) * sg, 0.08, (0.04 + 0.065 * f32(r)) * sg, 0.4 * u, 0.3, ICE_R, ICE_G, ICE_B); }
  }
  // the crew ring, edge on
  hull_line(out, d, x, y, h, ch, sn, 0.2, -0.17, 0.2, 0.17, cw, 0.85, INK_R, INK_G, INK_B);
  hull_line(out, d, x, y, h, ch, sn, 0.245, -0.17, 0.245, 0.17, cw, 0.85, INK_R, INK_G, INK_B);
  hull_line(out, d, x, y, h, ch, sn, 0.2, 0.17, 0.245, 0.17, thin, 0.85, INK_R, INK_G, INK_B);
  hull_line(out, d, x, y, h, ch, sn, 0.2, -0.17, 0.245, -0.17, thin, 0.85, INK_R, INK_G, INK_B);
  // the command module and its nose
  hull_line(out, d, x, y, h, ch, sn, 0.3, 0.06, 0.43, 0.06, cw, 0.9, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, 0.3, -0.06, 0.43, -0.06, cw, 0.9, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, 0.3, 0.06, 0.3, -0.06, thin, 0.8, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, 0.43, 0.06, 0.5, 0.0, cw, 0.9, col.x, col.y, col.z);
  hull_line(out, d, x, y, h, ch, sn, 0.43, -0.06, 0.5, 0.0, cw, 0.9, col.x, col.y, col.z);
}

draw_ship :: (s: [] Belt, out: [] f32, d: [] Draw, k: int, sel: bool) {
  sh := s[0].ships[k];
  st := ship_state(s, k, s[0].t);
  c := ship_screen(s, k);
  x := pix(c.x); y := pix(c.y); u := d[0].k;
  col := faction_rgb(sh.faction);
  heading := 0.0f32;
  burn := ship_burn(s, k);
  if sh.mode == FLYING {
    rel := st.v;
    heading = f32(atan2_d(-rel.y * cos(s[0].cam.tilt), rel.x));
    // braking for the arrival, the ship turns about and burns against its motion
    if burn < 0 { heading += 3.1415927; }
  }
  ch := cos(heading); shd := sin(heading);
  // a staged moment keeps its ship's hull readable however far the view pulls back
  hull := ship_hull_px(s, k);
  if hull > 22 * u {
    // the hull, in metres
    hl := hull / 2;
    draw_hull(out, d, x, y, hull, ch, shd, sh.dry > 400.0, col);
    bx := x - ch * hl; by := y - shd * hl;
    if burn != 0 {
      // the drive's plume out of the bell, flickering
      f := plume_flicker(s, k);
      stroke_g(out, d, bx, by, bx - ch * hull * (0.45 + 0.15 * f), by - shd * hull * (0.45 + 0.15 * f), 0.05 * hull, 1.0, 0.12 * hull, PLUME_R, PLUME_G, PLUME_B);
      stroke_g(out, d, bx, by, bx - ch * hull * (1.2 + 0.3 * f), by - shd * hull * (1.2 + 0.3 * f), 0.015 * hull, 0.7, 0.06 * hull, PLUME_R, PLUME_G, PLUME_B);
    }
    if sel { ring(out, d, x, y, hl * 1.25, 48, 0.9 * u, 0.9, col.x, col.y, col.z); }
    block(d, x, y, hl);
    tag(d, sh.name, x, y, hl * 1.1, 8 * u, 0.9, col.x, col.y, col.z, ifx sel then PRIO_HOT else ifx sh.faction == FREE_BELT then PRIO_OWN else PRIO_RIVAL);
    return;
  }
  r := 7 * u;
  ax := x + ch * r; ay := y + shd * r;
  lx := x - ch * r * 0.7 + shd * r * 0.7; ly := y - shd * r * 0.7 - ch * r * 0.7;
  rx := x - ch * r * 0.7 - shd * r * 0.7; ry := y - shd * r * 0.7 + ch * r * 0.7;
  bright: f32 = ifx sh.faction == FREE_BELT then 1.0f32 else 0.75f32;
  if burn != 0 {
    f := plume_flicker(s, k);
    tx := x - ch * r * 0.35; ty := y - shd * r * 0.35;
    stroke_g(out, d, tx, ty, x - ch * r * (1.5 + 0.35 * f), y - shd * r * (1.5 + 0.35 * f), 1.3 * u, 1.0, 3.0 * u, PLUME_R, PLUME_G, PLUME_B);
  }
  stroke(out, d, lx, ly, ax, ay, 1.0 * u, bright, col.x, col.y, col.z);
  stroke(out, d, ax, ay, rx, ry, 1.0 * u, bright, col.x, col.y, col.z);
  stroke(out, d, rx, ry, x - ch * r * 0.25, y - shd * r * 0.25, 1.0 * u, bright, col.x, col.y, col.z);
  stroke(out, d, x - ch * r * 0.25, y - shd * r * 0.25, lx, ly, 1.0 * u, bright, col.x, col.y, col.z);
  if sel { ring(out, d, x, y, 13 * u, 28, 0.9 * u, 0.95, col.x, col.y, col.z); }
  block(d, x, y, 7.5 * u);   // the arrow's tip and wings, all of it
  // a ship sitting on its world or station is not named until the view is close enough to tell them
  // apart, selected or not (its card and its ring say which it is; the place's name stays readable)
  if sh.mode != FLYING && spacecam_pixels(s[0].cam, berth_radius(sh.at)) < 14.0 * f64(u) { return; }
  prio := ifx sel then PRIO_HOT else ifx sh.faction == FREE_BELT then PRIO_OWN else ifx sh.mode == FLYING then PRIO_RIVAL else PRIO_PARKED;
  tag(d, sh.name, x, y, ifx sel then 14.0f32 * u else 8.0f32 * u, 6.5 * u, ifx sel then 0.95f32 else ifx sh.faction == FREE_BELT then 0.8f32 else 0.6f32, col.x, col.y, col.z, prio);
}

// A ship burning: 1 for the departure burn, -1 for the arrival's (it brakes), 0 coasting.
BURN_DAYS :: 1.2;
ship_burn :: (s: [] Belt, k: int) -> int {
  sh := s[0].ships[k];
  if sh.mode != FLYING { return 0; }
  if s[0].t - sh.t0 < BURN_DAYS * DAY { return 1; }
  if sh.t0 + sh.tof - s[0].t < BURN_DAYS * DAY { return -1; }
  return 0;
}
plume_flicker :: (s: [] Belt, k: int) -> f32 { return 0.5 + 0.5 * sin(s[0].clock * 31.0 + f32(k) * 1.7) * sin(s[0].clock * 17.0 + f32(k)); }

draw_map :: (s: [] Belt, out: [] f32, u: [] f32, d: [] Draw) {
  k := d[0].k;
  t := s[0].t;
  // Orbits: the worlds', faint; the ice rocks', fainter, in their own colour.
  for b: 1..<BODIES {
    if b == BODY_MOON { draw_orbit(s, out, d, orbit_body(b), orbit_body_position(BODY_EARTH, t), 0.18, DIM_R, DIM_G, DIM_B); continue; }
    draw_orbit(s, out, d, orbit_body(b), D3_ZERO, ifx b == BODY_CERES then 0.3f32 else 0.22f32, DIM_R, DIM_G, DIM_B);
  }
  for j: 0..<ICE_ROCKS {
    hot := s[0].dest == P_ICE + j;
    draw_orbit(s, out, d, s[0].ices[j], D3_ZERO, ifx hot then 0.35f32 else 0.08f32, ICE_R, ICE_G, ICE_B);
  }
  // The field: rocks of every brightness, the faint ones many (the dust between is belt.wgsl's).
  // Five thousand: each is culled off screen before it costs a quad, and the many are fainter.
  w := d[0].w; hh := d[0].h; m := 4 * k;
  for j: 0..<ROCKS {
    c := screen_of(s, rock_at(s[0].rocks[j], t));
    x := pix(c.x); y := pix(c.y);
    if x < -m || y < -m || x > w + m || y > hh + m { continue; }
    h := f32((j * 7919 + 13) % 1000) / 1000.0;
    dot(out, d, x, y, (0.4 + 0.6 * h * h) * k, 0.2 + 0.5 * h * h, 0.8, 0.8, 0.82);
  }
  // The worlds: shaded discs (bigger than life when far, so they read), a ring on the one you aim at.
  spin_k := s[0].clock * 0.04;
  for b: 1..<BODIES {
    c := screen_of(s, orbit_body_position(b, t));
    x := pix(c.x); y := pix(c.y);
    rp := spacecam_pixels(s[0].cam, BODY_RADIUS[b]);
    r := fmax(rp, f64(DISC_MIN[b] * k));
    if b == BODY_MOON {
      e := screen_of(s, orbit_body_position(BODY_EARTH, t));
      sep := pix(sqrt((e.x - c.x) * (e.x - c.x) + (e.y - c.y) * (e.y - c.y)));
      if sep < 14 * k { continue; }
    }
    hot := s[0].dest == b;
    disc(s, u, d, c, r, DISC_KIND[b], f32(b) * 0.37, spin_k * f32(b % 4 + 1));
    rf := pix(r);
    if hot && rf < 4000 * k { ring(out, d, x, y, rf * 1.35 + 4 * k, ifx rf > 60 * k then 96 else 32, 0.8 * k, 0.9, BELT_R, BELT_G, BELT_B); }
    reach := ifx b == BODY_SATURN then rf * 2.0 else rf;
    block(d, x, y, reach);
    if b == BODY_CERES {
      st := screen_of(s, place_state(s, P_STATION, t).r);
      if abs(pix(st.x) - x) + abs(pix(st.y) - y) < 60 * k { continue; }
    }
    if rf < 2000 * k { tag(d, BODY_NAMES[b], x, y, reach, 7 * k, ifx hot then 1.0f32 else 0.62f32, INK_R, INK_G, INK_B, ifx hot then PRIO_HOT else PRIO_WORLD); }
  }
  // The ice rocks: a diamond far off, the rock itself (lumpy, cratered, icy) close in.
  for j: 0..<ICE_ROCKS {
    c := screen_of(s, orbit_position(s[0].ices[j], t));
    x := pix(c.x); y := pix(c.y);
    hot := s[0].dest == P_ICE + j;
    rr := spacecam_pixels(s[0].cam, ICE_RADII[j]);
    r := 3.5 * k;
    if rr > 2.0 * f64(k) {
      disc(s, u, d, c, rr, 10, f32(j) * 0.61 + 0.2, spin_k * 3.0 + f32(j));
      r = hi(pix(rr), r);
    }
    if rr < 6.0 * f64(k) {
      stroke(out, d, x, y - r, x + r, y, 0.8 * k, 0.9, ICE_R, ICE_G, ICE_B);
      stroke(out, d, x + r, y, x, y + r, 0.8 * k, 0.9, ICE_R, ICE_G, ICE_B);
      stroke(out, d, x, y + r, x - r, y, 0.8 * k, 0.9, ICE_R, ICE_G, ICE_B);
      stroke(out, d, x - r, y, x, y - r, 0.8 * k, 0.9, ICE_R, ICE_G, ICE_B);
    }
    if hot && r < 2000 * k { ring(out, d, x, y, r * 1.4 + 4 * k, 32, 0.8 * k, 0.9, BELT_R, BELT_G, BELT_B); }
    block(d, x, y, r);
    if hot || s[0].cam.scale * AU > 1400.0 * f64(k) {
      tag(d, ICE_NAMES[j], x, y, r, 6 * k, ifx hot then 1.0f32 else 0.6f32, ICE_R, ICE_G, ICE_B, ifx hot then PRIO_HOT else PRIO_ICE);
    }
  }
  draw_station(s, out, d, place_state(s, P_STATION, t).r);
  // Coasting ships' arcs, from where they are on (not in a staged close-up, where they are stray lines).
  for j: 0..<s[0].ship_n {
    if s[0].stage != STAGE_NONE { break; }
    sh := s[0].ships[j];
    if sh.mode != FLYING { continue; }
    col := faction_rgb(sh.faction);
    done := int(fclamp((t - sh.t0) / sh.tof * f64(PATH - 1), 0.0, f64(PATH - 1)));
    light: f32 = ifx s[0].cmd[0].selected[j] then 0.7f32 else 0.28f32;
    draw_path(s, out, d, sh.path[..], done, light, false, col.x, col.y, col.z);
    e := screen_of(s, sh.path[PATH - 1]);
    ring(out, d, pix(e.x), pix(e.y), 4 * k, 12, 0.7 * k, light, col.x, col.y, col.z);
  }
  // The plan being made: its arc dashed, its burns, and where the target will be.
  if s[0].dest >= 0 && s[0].eco.ok {
    for opt: 0..<2 {
      p := ifx opt == 0 then s[0].eco else s[0].fast;
      if !p.ok { continue; }
      if opt == 1 && abs(p.tr.tof - s[0].eco.tr.tof) < DAY { continue; }
      light: f32 = ifx opt == 0 then 0.95f32 else 0.6f32;
      red := ifx opt == 0 then BELT_R else FAST_R; green := ifx opt == 0 then BELT_G else FAST_G; blue := ifx opt == 0 then BELT_B else FAST_B;
      draw_transfer(s, out, d, p, light, opt == 0, red, green, blue);
    }
  }
  // A ship mining: its tether down to the rock, ice coming up it.
  for j: 0..<s[0].ship_n {
    sh := s[0].ships[j];
    if sh.mode != MINING || !is_ice(sh.at) { continue; }
    rock := screen_of(s, place_state(s, sh.at, t).r);
    me := screen_of(s, ship_state(s, j, t).r);
    rr := spacecam_pixels(s[0].cam, ICE_RADII[sh.at - P_ICE]);
    dx := pix(rock.x - me.x); dy := pix(rock.y - me.y);
    ln := sqrt(dx * dx + dy * dy);
    if rr < 3.0 * f64(k) || ln < 1 { continue; }
    reach := hi(ln - pix(rr) * 0.85, 0);
    ux := dx / ln; uy := dy / ln;
    mx := pix(me.x); my := pix(me.y);
    stroke(out, d, mx, my, mx + ux * reach, my + uy * reach, 0.5 * k, 0.45, ICE_R, ICE_G, ICE_B);
    for g: 0..<4 {
      f := (f32(g) / 4.0 + s[0].clock * 0.35) - floor(f32(g) / 4.0 + s[0].clock * 0.35);
      px := mx + ux * reach * (1.0 - f); py := my + uy * reach * (1.0 - f);
      dot(out, d, px, py, 1.4 * k, 0.9, ICE_R, ICE_G, ICE_B);
    }
  }
  // Ships in combat range: a line between them.
  for j: 0..<s[0].ship_n {
    e := s[0].engaged[j];
    if e <= j { continue; }
    a := ship_screen(s, j); b := ship_screen(s, e);
    stroke_g(out, d, pix(a.x), pix(a.y), pix(b.x), pix(b.y), 1.2 * d[0].k, 0.9, 4 * d[0].k, LOW_R, LOW_G, LOW_B);
  }
  // The ships, the selected last.
  for j: 0..<s[0].ship_n { if !s[0].cmd[0].selected[j] { draw_ship(s, out, d, j, false); } }
  for j: 0..<s[0].ship_n { if s[0].cmd[0].selected[j] { draw_ship(s, out, d, j, true); } }
}

// ---- drawing: the HUD

panel :: (s: [] Belt, u: [] f32, x0: f32, y0: f32, x1: f32, y1: f32, alpha: f32, warm: bool) {
  n := s[0].panel_n;
  if n >= PANELS { return; }
  o := U_PANEL + n * 8;
  u[o] = x0; u[o + 1] = y0; u[o + 2] = x1; u[o + 3] = y1;
  u[o + 4] = 10 * hi(s[0].dpr, 0.5); u[o + 5] = alpha; u[o + 6] = ifx warm then 1.0f32 else 0.0f32; u[o + 7] = 0;
  s[0].panel_n = n + 1;
}
add_button :: (s: [] Belt, x0: f32, y0: f32, x1: f32, y1: f32, id: int, arg: int) -> int {
  if s[0].btn_n >= BUTTONS { return -1; }
  i := s[0].btn_n;
  s[0].btn[i] = Btn.{x0 = x0, y0 = y0, x1 = x1, y1 = y1, id = id, arg = arg};
  s[0].btn_n += 1;
  return i;
}
// A button: its outline with the HUD's clipped corners, its word centred.
// A button's cut-corner outline.
ring_box :: (out: [] f32, d: [] Draw, x0: f32, y0: f32, x1: f32, y1: f32, k: f32, light: f32, red: f32, green: f32, blue: f32) {
  c := 5 * k;
  stroke(out, d, x0, y0, x1 - c, y0, 0.7 * k, light, red, green, blue);
  stroke(out, d, x1 - c, y0, x1, y0 + c, 0.7 * k, light, red, green, blue);
  stroke(out, d, x1, y0 + c, x1, y1, 0.7 * k, light, red, green, blue);
  stroke(out, d, x1, y1, x0 + c, y1, 0.7 * k, light, red, green, blue);
  stroke(out, d, x0 + c, y1, x0, y1 - c, 0.7 * k, light, red, green, blue);
  stroke(out, d, x0, y1 - c, x0, y0, 0.7 * k, light, red, green, blue);
}
button :: (s: [] Belt, out: [] f32, d: [] Draw, x0: f32, y0: f32, x1: f32, y1: f32, id: int, arg: int, word: string, cap: f32, on: bool) {
  i := add_button(s, x0, y0, x1, y1, id, arg);
  k := d[0].k;
  lit_ := ifx on then 0.95f32 else ifx s[0].hover == i || s[0].press == i then 0.8f32 else 0.42f32;
  red := ifx on then BELT_R else INK_R; green := ifx on then BELT_G else INK_G; blue := ifx on then BELT_B else INK_B;
  c := 6 * k;
  stroke(out, d, x0, y0, x1 - c, y0, 0.7 * k, lit_, red, green, blue);
  stroke(out, d, x1 - c, y0, x1, y0 + c, 0.7 * k, lit_, red, green, blue);
  stroke(out, d, x1, y0 + c, x1, y1, 0.7 * k, lit_, red, green, blue);
  stroke(out, d, x1, y1, x0 + c, y1, 0.7 * k, lit_, red, green, blue);
  stroke(out, d, x0 + c, y1, x0, y1 - c, 0.7 * k, lit_, red, green, blue);
  stroke(out, d, x0, y1 - c, x0, y0, 0.7 * k, lit_, red, green, blue);
  centred(out, d, word, (x0 + x1) / 2, (y0 + y1) / 2 + cap / 2, cap, ifx on then 1.0f32 else 0.85f32, red, green, blue);
}
meter :: (out: [] f32, d: [] Draw, x: f32, y: f32, w: f32, full: f32, red: f32, green: f32, blue: f32) {
  k := d[0].k;
  stroke(out, d, x, y, x + w, y, 1.0 * k, 0.16, INK_R, INK_G, INK_B);
  f := clamp(full, 0, 1);
  if f > 0.005 { stroke(out, d, x, y, x + w * f, y, 1.3 * k, 0.95, red, green, blue); }
}

// A labelled meter: the word on the left, the value on the right, the bar under them.
gauge :: (out: [] f32, d: [] Draw, x: f32, y: f32, w: f32, cap: f32, word: string, value: string, full: f32, red: f32, green: f32, blue: f32) {
  k := d[0].k;
  words(out, d, word, x, y, cap, 0.65, red, green, blue);
  words(out, d, value, x + w - text_width(value, cap), y, cap, 0.85, INK_R, INK_G, INK_B);
  meter(out, d, x, y + 5 * k, w, full, red, green, blue);
}
place_short :: (p: int) -> string { if p == P_STATION { return "HEARTH"; } return place_name(p); }
// A ship's card: where it is or is going (line), and how long or how full (side).
ship_status :: (s: [] Belt, k: int, buf: [] u8) -> int {
  sh := s[0].ships[k];
  n := 0;
  if sh.mode == FLYING { n = put(buf, 0, "TO "); }
  else if sh.mode == MINING { n = put(buf, 0, ifx sh.mine_rate > 0.0 then "MINING " else "LOADING "); }
  else { n = put(buf, 0, "AT "); }
  return put(buf, n, place_short(sh.at));
}
ship_side :: (s: [] Belt, k: int, buf: [] u8) -> int {
  sh := s[0].ships[k];
  if sh.mode == FLYING {
    n := put_int(buf, 0, safe_int(fmax((sh.t0 + sh.tof - s[0].t) / DAY, 0.0)));
    return put(buf, n, " D");
  }
  if sh.mode == MINING && sh.cargo_cap > 0.0 {
    n := put_int(buf, 0, safe_int(100.0 * sh.cargo / sh.cargo_cap));
    return put(buf, n, "%");
  }
  return 0;
}

plan_text :: (p: Plan, buf: [] u8, top: bool) -> int {
  n := 0;
  if top {
    n = put_int(buf, 0, safe_int(p.tr.tof / DAY)); n = put(buf, n, " DAYS");
    return n;
  }
  n = put(buf, 0, "DV "); n = put_tenths(buf, n, p.tr.dv / 1000.0); n = put(buf, n, " KM/S · ");
  n = put_count(buf, n, p.fuel); n = put(buf, n, " T");
  return n;
}

// The Free Belt's ships as cards along the bottom: one row on a desktop, three a row on a phone.
CardLayout :: struct { per_row: int; rows: int; cw: f32; ch: f32; x0: f32; y0: f32; x1: f32; }
card_layout :: (s: [] Belt, w: f32, h: f32, k: f32, phone: bool) -> CardLayout {
  m := 12 * k;
  cards := 0;
  for j: 0..<s[0].ship_n { if s[0].ships[j].faction == FREE_BELT { cards += 1; } }
  if cards < 1 { cards = 1; }
  l: CardLayout;
  l.per_row = ifx phone then 3 else cards;
  l.rows = (cards + l.per_row - 1) / l.per_row;
  l.cw = ifx phone then (w - 2 * m - 2 * 8 * k) / 3 else lo(200 * k, (w - 2 * m - f32(cards - 1) * 8 * k) / f32(cards));
  l.ch = ifx phone then 80 * k else 76 * k;
  in_row := ifx cards < l.per_row then cards else l.per_row;
  total := f32(in_row) * l.cw + f32(in_row - 1) * 8 * k;
  l.x0 = (w - total) / 2; l.x1 = l.x0 + total;
  l.y0 = h - m - f32(l.rows) * l.ch - f32(l.rows - 1) * 8 * k - (ifx phone then 8 * k else 0);
  return l;
}
hud :: (s: [] Belt, out: [] f32, u: [] f32, d: [] Draw) {
  k := d[0].k; w := d[0].w; h := d[0].h;
  phone := w / k < 700;
  m := 12 * k;
  s[0].btn_n = 0;
  buf: [96] u8;
  // The title and the date, top left.
  tw := ifx phone then (w - 3 * m) / 2 else 230 * k;
  panel(s, u, m, m, m + tw, m + 50 * k, 0.85, false);
  words(out, d, "BELT 2200", m + 12 * k, m + 20 * k, 10 * k, 0.95, INK_R, INK_G, INK_B);
  dt := date_of(s[0].t);
  n := put_int(buf[..], 0, dt.day); n = put(buf[..], n, " "); n = put(buf[..], n, MONTHS[(dt.month - 1) % 12]); n = put(buf[..], n, " "); n = put_int(buf[..], n, dt.year);
  words(out, d, cast(string) buf[0..<n], m + 12 * k, m + 38 * k, 7.5 * k, 0.75, BELT_R, BELT_G, BELT_B);
  armed := s[0].new_armed > 0;
  button(s, out, d, m + tw - 54 * k, m + 13 * k, m + tw - 8 * k, m + 37 * k, B_NEW, 0, ifx armed then "SURE?" else "NEW", 6 * k, armed);
  // The station's ice, top right.
  rx0 := w - m - tw;
  panel(s, u, rx0, m, w - m, m + 50 * k, 0.85, false);
  st := s[0].station[0];
  room := tw - 24 * k;
  n = put(buf[..], 0, "MASS "); n = put_count(buf[..], n, st.mass); n = put(buf[..], n, " T · ICE "); n = put_count(buf[..], n, st.ice); n = put(buf[..], n, " T");
  words(out, d, cast(string) buf[0..<n], rx0 + 12 * k, m + 20 * k, fit_cap(cast(string) buf[0..<n], 10 * k, room), 0.95, ICE_R, ICE_G, ICE_B);
  n = put(buf[..], 0, "METAL "); n = put_count(buf[..], n, st.metal); n = put(buf[..], n, " T · WORKERS ");
  n = put_int(buf[..], n, ifx station_workers(st) < STATION_SHIFTS then station_workers(st) else STATION_SHIFTS); n = put(buf[..], n, "/"); n = put_int(buf[..], n, STATION_SHIFTS);
  words(out, d, cast(string) buf[0..<n], rx0 + 12 * k, m + 38 * k, fit_cap(cast(string) buf[0..<n], 7 * k, room), 0.6, INK_R, INK_G, INK_B);
  // Time: pause and three speeds.
  sy := m + 58 * k;
  bw := ifx phone then (w - 2 * m - 3 * 6 * k - 52 * k) / 4 else 64 * k;
  labels := [4] string.["PAUSE", "1 D/S", "7 D/S", "30 D/S"];
  for i: 0..<4 {
    x0 := m + f32(i) * (bw + 6 * k);
    button(s, out, d, x0, sy, x0 + bw, sy + 28 * k, B_SPEED, i, labels[i], 6.5 * k, s[0].speed == i);
  }
  gx := m + 4 * (bw + 6 * k);
  button(s, out, d, ifx phone then w - m - 46 * k else gx, sy, ifx phone then w - m else gx + 70 * k, sy + 28 * k, B_GALAXY, 0, ifx phone then "EXIT" else "GALAXY", 6.5 * k, false);
  // Zoomed in or riding with something: a way back to the whole system.
  away := s[0].cam.goal_scale > system_scale(s) * 4.0 || s[0].cam.goal_scale < system_scale(s) / 3.0 || s[0].follow >= 0 || s[0].follow_place >= 0;
  toast_at := sy + 52 * k;
  if away {
    vy := ifx phone then sy + 34 * k else sy;
    button(s, out, d, w - m - 84 * k, vy, w - m, vy + 28 * k, B_SYSTEM, 0, "SYSTEM", 6.5 * k, false);
    if phone { toast_at = sy + 86 * k; }
  }
  // The yard: a freighter when there is metal and people for one, else what it waits on.
  yy := ifx phone then sy + 34 * k else sy;
  yx0 := ifx phone then m else w - m - tw;
  yx1 := ifx phone then m + 150 * k else w - m - 92 * k;
  yc := yard_can(s);
  if yc == YARD_OK {
    button(s, out, d, yx0, yy, yx1, yy + 28 * k, B_BUILD, 0, "BUILD FREIGHTER", 6.5 * k, false);
    if phone { toast_at = sy + 86 * k; }
  } else if yc != YARD_FULL {
    if yc == YARD_BUSY { n = put(buf[..], 0, "FREIGHTER IN "); n = put_count(buf[..], n, fmax(1.0, -floor(-s[0].building))); n = put(buf[..], n, " D"); }
    else if yc == YARD_METAL { n = put(buf[..], 0, "FREIGHTER: "); n = put_count(buf[..], n, FREIGHTER_METAL); n = put(buf[..], n, " T METAL"); }
    else { n = put(buf[..], 0, "FREIGHTER: "); n = put_int(buf[..], n, FREIGHTER_CREW); n = put(buf[..], n, " FREE HANDS"); }
    words(out, d, cast(string) buf[0..<n], yx0 + 4 * k, yy + 18 * k, 6.5 * k, ifx yc == YARD_BUSY then 0.8f32 else 0.5f32, INK_R, INK_G, INK_B);
    if phone { toast_at = sy + 86 * k; }
  }
  // The toast.
  if s[0].toast_t > 0 && s[0].toast_n > 0 {
    a := clamp(s[0].toast_t, 0, 1);
    s[0].toast_y = toast_at;
    centred(out, d, cast(string) s[0].toast[0..<s[0].toast_n], w / 2, s[0].toast_y, 7.5 * k, 0.95 * a, INK_R, INK_G, INK_B);
  }
  // The Free Belt's ships, as cards along the bottom.
  cl := card_layout(s, w, h, k, phone);
  cw := cl.cw; chh := cl.ch;
  cy0 := cl.y0;
  c := 0;
  for j: 0..<s[0].ship_n {
    sh := s[0].ships[j];
    if sh.faction != FREE_BELT { continue; }
    x0 := cl.x0 + f32(c % cl.per_row) * (cw + 8 * k);
    cy0 = cl.y0 + f32(c / cl.per_row) * (chh + 8 * k);
    sel := s[0].cmd[0].selected[j];
    panel(s, u, x0, cy0, x0 + cw, cy0 + chh, ifx sel then 0.95f32 else 0.75f32, sel);
    card := add_button(s, x0, cy0, x0 + cw, cy0 + chh, B_CARD, j);
    pad := 10 * k;
    words(out, d, sh.name, x0 + pad, cy0 + 18 * k, 8.5 * k, 1.0, ifx sel then BELT_R else INK_R, ifx sel then BELT_G else INK_G, ifx sel then BELT_B else INK_B);
    n = ship_side(s, j, buf[..]);
    if n > 0 { side := cast(string) buf[0..<n]; words(out, d, side, x0 + cw - pad - text_width(side, 6.5 * k), cy0 + 18 * k, 6.5 * k, 0.8, INK_R, INK_G, INK_B); }
    n = ship_status(s, j, buf[..]);
    words(out, d, cast(string) buf[0..<n], x0 + pad, cy0 + 33 * k, ifx phone then 5.5f32 * k else 6.5f32 * k, 0.7, INK_R, INK_G, INK_B);
    // fuel and ice: a word, the tonnes, and a meter
    mw := cw - 2 * pad;
    vc := ifx phone then 4.8f32 * k else 5.5f32 * k;
    n = put_count(buf[..], 0, sh.fuel); n = put(buf[..], n, " T");
    low := sh.fuel < 0.2 * sh.fuel_cap;
    gauge(out, d, x0 + pad, cy0 + 47 * k, mw, vc, "FUEL", cast(string) buf[0..<n], f32(sh.fuel / sh.fuel_cap),
          ifx low then LOW_R else FUEL_R, ifx low then LOW_G else FUEL_G, ifx low then LOW_B else FUEL_B);
    if sh.cargo_cap > 0.0 {
      n = put_count(buf[..], 0, sh.cargo); n = put(buf[..], n, "/"); n = put_count(buf[..], n, sh.cargo_cap);
      if !phone { n = put(buf[..], n, " T"); }
      gauge(out, d, x0 + pad, cy0 + 64 * k, mw, vc, "ICE", cast(string) buf[0..<n], f32(sh.cargo / sh.cargo_cap), ICE_R, ICE_G, ICE_B);
    }
    c += 1;
  }
  cy0 = cl.y0;
  // Orders for the selection.
  sk := first_selected(s);
  if sk < 0 {
    centred(out, d, "SELECT A SHIP", w / 2, cy0 - 12 * k, 7 * k, 0.55, INK_R, INK_G, INK_B);
    block_rect(d, w / 2 - 90 * k, cy0 - 12 * k - 10 * k, w / 2 + 90 * k, cy0 - 12 * k + 3 * k);   // no name over the hint
    return;
  }
  pw := ifx phone then w - 2 * m else 470 * k;
  px0 := (w - pw) / 2;
  if s[0].dest < 0 {
    ph := 40 * k;
    py0 := cy0 - 8 * k - ph;
    panel(s, u, px0, py0, px0 + pw, py0 + ph, 0.85, false);
    bw2 := (pw - 4 * 8 * k) / 3;
    can_mine := s[0].ships[sk].cargo_cap > 0.0;
    labels2 := [3] string.["MINE ICE", "HOME", "FOLLOW"];
    if s[0].ships[sk].mine_rate <= 0.0 { labels2[0] = "HAUL ICE"; }
    ids := [3] int.[B_MINE, B_HOME, B_FOLLOW];
    for i: 0..<3 {
      if i == 0 && !can_mine { continue; }
      x0 := px0 + 8 * k + f32(i) * (bw2 + 8 * k);
      button(s, out, d, x0, py0 + 7 * k, x0 + bw2, py0 + ph - 7 * k, ids[i], 0, labels2[i], 7 * k, false);
    }
    // the ice rocks by name, each with its fast trip's days: a tap plans the trip
    cols := ifx phone then 4 else ICE_ROCKS;
    rows := (ICE_ROCKS + cols - 1) / cols;
    rh := 30 * k;
    rp := 6 * k;
    qh := f32(rows) * rh + f32(rows + 1) * rp;
    qy0 := py0 - 6 * k - qh;
    panel(s, u, px0, qy0, px0 + pw, qy0 + qh, 0.85, false);
    rw := (pw - f32(cols + 1) * rp) / f32(cols);
    for j: 0..<ICE_ROCKS {
      x0 := px0 + rp + f32(j % cols) * (rw + rp);
      y0 := qy0 + rp + f32(j / cols) * (rh + rp);
      i := add_button(s, x0, y0, x0 + rw, y0 + rh, B_ROCK, j);
      have := s[0].reach_have[j];
      ok := have && s[0].reach_ok[j];
      lit_: f32 = ifx have && !ok then 0.3f32 else ifx s[0].hover == i || s[0].press == i then 1.0f32 else 0.65f32;
      ring_box(out, d, x0, y0, x0 + rw, y0 + rh, k, lit_, ICE_R, ICE_G, ICE_B);
      nc := lo(6 * k, (rw - 8 * k) / hi(text_width(ICE_NAMES[j], 1), 1));
      centred(out, d, ICE_NAMES[j], x0 + rw / 2, y0 + 13 * k, nc, lit_ + 0.15, ICE_R, ICE_G, ICE_B);
      if have {
        n = 0;
        if !s[0].reach_ok[j] { n = put(buf[..], 0, ifx s[0].reach_days[j] > 0.0 then "LOW FUEL" else "NO ROUTE"); }
        else { n = put_int(buf[..], 0, safe_int(s[0].reach_days[j])); n = put(buf[..], n, " DAYS"); }
        centred(out, d, cast(string) buf[0..<n], x0 + rw / 2, y0 + 24 * k, lo(5 * k, (rw - 6 * k) / hi(text_width(cast(string) buf[0..<n], 1), 1)), lit_ * 0.9, INK_R, INK_G, INK_B);
      }
    }
    centred(out, d, "OR TAP A DESTINATION", w / 2, qy0 - 10 * k, 6.5 * k, 0.55, INK_R, INK_G, INK_B);
    block_rect(d, w / 2 - 90 * k, qy0 - 10 * k - 10 * k, w / 2 + 90 * k, qy0 - 10 * k + 3 * k);   // no name over the hint
    return;
  }
  // A plan: economy and fast, each a button that launches it.
  ph := 92 * k;
  py0 := cy0 - 8 * k - ph;
  panel(s, u, px0, py0, px0 + pw, py0 + ph, 0.92, true);
  n = put(buf[..], 0, s[0].ships[sk].name);
  if selected_count(s) > 1 { n = put(buf[..], n, " +"); n = put_int(buf[..], n, selected_count(s) - 1); }
  n = put(buf[..], n, " TO "); n = put(buf[..], n, place_name(s[0].dest));
  words(out, d, cast(string) buf[0..<n], px0 + 12 * k, py0 + 18 * k, 8 * k, 0.95, INK_R, INK_G, INK_B);
  button(s, out, d, px0 + pw - 70 * k, py0 + 6 * k, px0 + pw - 8 * k, py0 + 24 * k, B_CANCEL, 0, "CANCEL", 5.5 * k, false);
  ow := (pw - 3 * 8 * k) / 2;
  for opt: 0..<2 {
    p := ifx opt == 0 then s[0].eco else s[0].fast;
    x0 := px0 + 8 * k + f32(opt) * (ow + 8 * k);
    y0 := py0 + 32 * k; y1 := py0 + ph - 8 * k;
    word := ifx opt == 0 then "GO ECONOMY" else "GO FAST";
    i := add_button(s, x0, y0, x0 + ow, y1, B_GO, opt);
    ok := p.ok && p.enough;
    lit_: f32 = ifx !ok then 0.3f32 else ifx s[0].hover == i || s[0].press == i then 1.0f32 else 0.7f32;
    red := ifx opt == 0 then BELT_R else FAST_R; green := ifx opt == 0 then BELT_G else FAST_G; blue := ifx opt == 0 then BELT_B else FAST_B;
    cc := 6 * k;
    stroke(out, d, x0, y0, x0 + ow - cc, y0, 0.7 * k, lit_, red, green, blue);
    stroke(out, d, x0 + ow - cc, y0, x0 + ow, y0 + cc, 0.7 * k, lit_, red, green, blue);
    stroke(out, d, x0 + ow, y0 + cc, x0 + ow, y1, 0.7 * k, lit_, red, green, blue);
    stroke(out, d, x0 + ow, y1, x0 + cc, y1, 0.7 * k, lit_, red, green, blue);
    stroke(out, d, x0 + cc, y1, x0, y1 - cc, 0.7 * k, lit_, red, green, blue);
    stroke(out, d, x0, y1 - cc, x0, y0, 0.7 * k, lit_, red, green, blue);
    words(out, d, word, x0 + 8 * k, y0 + 15 * k, 7.5 * k, lit_ + 0.1, red, green, blue);
    if p.ok {
      n = plan_text(p, buf[..], true);
      if !p.enough { n = put(buf[..], 0, "NOT ENOUGH FUEL"); }
      words(out, d, cast(string) buf[0..<n], x0 + 8 * k, y0 + 30 * k, 6.5 * k, ifx p.enough then lit_ else 0.85f32, ifx p.enough then INK_R else LOW_R, ifx p.enough then INK_G else LOW_G, ifx p.enough then INK_B else LOW_B);
      n = plan_text(p, buf[..], false);
      words(out, d, cast(string) buf[0..<n], x0 + 8 * k, y0 + 43 * k, ifx phone then 5.0f32 * k else 6.0f32 * k, lit_ * 0.9, INK_R, INK_G, INK_B);
    }
  }
}

// MADE BY <NAME> · TIP (small, dim; TIP in Bitcoin's orange) at the bottom: beside the ship
// cards when there is room (a desktop), else in the strip under them. Nothing without a maker.
maker_line :: (s: [] Belt, out: [] f32, d: [] Draw) {
  s[0].tip_shown = false;
  if s[0].maker_n == 0 { return; }
  k := d[0].k; w := d[0].w; h := d[0].h;
  phone := w / k < 700;
  m := 12 * k;
  // the cards, as hud lays them out
  cards_x1 := card_layout(s, w, h, k, phone).x1;
  lead: [MAKER_BYTES + 16] u8;
  n := put(lead[..], 0, "MADE BY "); n = put(lead[..], n, cast(string) s[0].maker[0..<s[0].maker_n]); n = put(lead[..], n, " · ");
  left := cast(string) lead[0..<n];
  lw := measure(left, GAP, SPACE, false); tw := measure("TIP", GAP, SPACE, false);
  // beside the cards: right of them, bottom aligned; else the strip under them
  x0 := cards_x1 + 16 * k; x1 := w - m; y0 := h - m - 30 * k; y1 := h;
  if (x1 - x0) < (lw + tw) * 5 * k {
    x0 = m; x1 = w - m; y0 = h - (ifx phone then 20 * k else 12 * k); y1 = h;
  }
  cap := lo(lo(6 * k, y1 - y0 - 6 * k), (x1 - x0) / hi(lw + tw, 1));
  base := ifx y1 - y0 > 24 * k then h - m - 4 * k else (y0 + y1) * 0.5 + cap * 0.5;
  x := (x0 + x1) * 0.5 - (lw + tw) * cap * 0.5;
  words(out, d, left, x, base, cap, 0.55, INK_R, INK_G, INK_B);
  tx := x + lw * cap;
  hot := s[0].tip_hover || s[0].tip_down;
  words(out, d, "TIP", tx, base, cap, ifx hot then 1.0f32 else 0.8f32, TIP_R, TIP_G, TIP_B);
  s[0].tip_x0 = tx - 8 * k; s[0].tip_x1 = tx + tw * cap + 8 * k; s[0].tip_y0 = y0 + 1 * k; s[0].tip_y1 = y1;
  block_rect(d, x, base - cap - 2 * k, tx + tw * cap, base + 2 * k);   // no name is written over it
  s[0].tip_shown = true;
}

// ---- the frame

coaxial_belt_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_belt_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_belt_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

belt_step :: (s: [] Belt, dt: f32) {
  real := f64(clamp(dt, 0, 0.1));
  // Time: game days a real second, stepped in pieces of at most two days so arrivals and mining are seen in order.
  game := ifx s[0].golden then 0.0 else SPEEDS[s[0].speed] * DAY * real;
  if s[0].stage != STAGE_NONE { game = stage_game(s, real); }
  while game > 0.0 {
    piece := fmin(game, 2.0 * DAY);
    s[0].t += piece;
    step_ships(s, piece);
    game -= piece;
  }
  if s[0].toast_t > 0 { s[0].toast_t -= f32(real); }
  if s[0].new_armed > 0 { s[0].new_armed -= f32(real); }
  autosave(s, f32(real));
  reach_step(s);
  // A plan being shown follows the clock.
  if s[0].dest >= 0 && SPEEDS[s[0].speed] > 0.0 {
    s[0].replan -= f32(real);
    if s[0].replan <= 0 { set_dest(s, s[0].dest); }
  }
  // Keys pan and zoom.
  k := f64(hi(s[0].dpr, 0.5));
  hp := 700.0 * k * real;
  if s[0].held & HOLD_LEFT != 0 { pan(s, f32(hp), 0); }
  if s[0].held & HOLD_RIGHT != 0 { pan(s, f32(-hp), 0); }
  if s[0].held & HOLD_UP != 0 { pan(s, 0, f32(hp)); }
  if s[0].held & HOLD_DOWN != 0 { pan(s, 0, f32(-hp)); }
  if s[0].held & HOLD_IN != 0 { zoom_at(s, exp(2.5 * real), s[0].w / 2, s[0].h / 2); }
  if s[0].held & HOLD_OUT != 0 { zoom_at(s, exp(-2.5 * real), s[0].w / 2, s[0].h / 2); }
  ride_step(s);
  // Riding with a ship or a place: the view moves with it (its frame), and eases in from where it was.
  was := s[0].cam.goal_center;
  riding := s[0].cam.following;
  if s[0].follow >= 0 { s[0].cam = spacecam_follow(s[0].cam, ship_state(s, s[0].follow, s[0].t).r); }
  if s[0].follow_place >= 0 { s[0].cam = spacecam_follow(s[0].cam, place_state(s, s[0].follow_place, s[0].t).r); }
  if riding && (s[0].follow >= 0 || s[0].follow_place >= 0) { s[0].cam.center = d3_add(s[0].cam.center, d3_sub(s[0].cam.goal_center, was)); }
  s[0].cam = ifx s[0].golden then spacecam_settle(s[0].cam) else spacecam_ease(s[0].cam, real);
  // Locked on: the floating origin is the ship itself, exactly.
  if (s[0].follow >= 0 || s[0].follow_place >= 0) && s[0].cam.following && d3_dist(s[0].cam.center, s[0].cam.goal_center) * s[0].cam.scale < 0.5 { s[0].cam.center = s[0].cam.goal_center; }
  if s[0].stage != STAGE_NONE { stage_camera(s); }
}

belt_frame :: (s: [] Belt, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  started(s);
  s[0].w = width; s[0].h = height; s[0].dpr = dpr;
  if !s[0].framed && width > 0 && height > 0 {
    // The first view: the Sun and Hearth Station, the inner worlds between.
    s[0].framed = true; s[0].system = true; s[0].ride = -1; s[0].follow = -1; s[0].follow_place = -1;
    home := place_state(s, P_STATION, s[0].t).r;
    s[0].cam.goal_center = d3_scale(home, 0.5);
    s[0].cam.goal_scale = system_scale(s);
    s[0].cam = spacecam_settle(s[0].cam);
  }
  if !s[0].golden { s[0].clock += clamp(dt, 0, 0.1); }
  belt_step(s, dt);
  s[0].panel_n = 0;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  d: [1] Draw;
  d[0].k = hi(dpr, 0.5); d[0].w = width; d[0].h = height;
  // the map's strokes are mode 1: belt.wgsl dims them under the HUD's panels, so an orbit or a
  // rock never draws over a ship's card
  d[0].under = 1;
  draw_map(s, out, u, d[..]);
  d[0].under = 0;
  if s[0].stage != STAGE_NONE { stage_rocks(s, u, d[..]); }
  // The box being drawn.
  if s[0].boxing && s[0].dragging {
    x0 := s[0].dx0; y0 := s[0].dy0; x1 := s[0].mx; y1 := s[0].my; kk := d[0].k;
    stroke(out, d[..], x0, y0, x1, y0, 0.6 * kk, 0.7, BELT_R, BELT_G, BELT_B);
    stroke(out, d[..], x1, y0, x1, y1, 0.6 * kk, 0.7, BELT_R, BELT_G, BELT_B);
    stroke(out, d[..], x1, y1, x0, y1, 0.6 * kk, 0.7, BELT_R, BELT_G, BELT_B);
    stroke(out, d[..], x0, y1, x0, y0, 0.6 * kk, 0.7, BELT_R, BELT_G, BELT_B);
  }
  s[0].tip_shown = false;
  if s[0].card { s[0].btn_n = 0; } else if s[0].stage == STAGE_NONE { hud(s, out, u, d[..]); maker_line(s, out, d[..]); } else { stage_hud(s, out, u, d[..]); }
  // the Sun's disc and its bright core: no name is written over it
  sun_at := screen_of(s, D3_ZERO);
  block(d[..], pix(sun_at.x), pix(sun_at.y), hi(pix(spacecam_pixels(s[0].cam, BODY_RADIUS[BODY_SUN])) * 1.2, 9 * d[0].k));
  place_tags(s, out, u, d[..]);
  // The uniforms.
  sun := screen_of(s, D3_ZERO);
  u[0] = width; u[1] = height; u[2] = ifx s[0].golden then 0.0f32 else s[0].clock; u[3] = 1;
  // A Sun far off screen is brought within a million pixels along its direction, its radius shrunk
  // by as much, so the shader's falloff (which goes by distance over radius) stays true in f32.
  sx := sun.x - f64(width) / 2.0; sy := sun.y - f64(height) / 2.0;
  sd := sqrt(sx * sx + sy * sy);
  sr := spacecam_pixels(s[0].cam, BODY_RADIUS[BODY_SUN]);
  if sd > 1000000.0 { f := 1000000.0 / sd; sx *= f; sy *= f; sr *= f; }
  u[4] = pix(f64(width) / 2.0 + sx); u[5] = pix(f64(height) / 2.0 + sy); u[6] = pix(sr); u[7] = d[0].k;
  u[8] = f32(fclamp(s[0].cam.center.x / AU * 40.0, -100000.0, 100000.0)); u[9] = f32(fclamp(-s[0].cam.center.y / AU * 40.0, -100000.0, 100000.0));
  u[10] = f32(s[0].panel_n);
  u[11] = f32(d[0].disc_n);
  // The Belt's dust: about the Sun, while the Sun is near enough for f32; it turns at the
  // middle of the Belt's rate (2.7 AU), as its rocks do.
  au := s[0].cam.scale * AU;
  if abs(sun.x) < 1000000.0 && abs(sun.y) < 1000000.0 && au < 60000.0 {
    u[U_BELT] = pix(sun.x); u[U_BELT + 1] = pix(sun.y); u[U_BELT + 2] = f32(au);
    u[U_BELT + 3] = f32(wrap_tau(s[0].t * sqrt(GM_SUN / (2.7 * AU * 2.7 * AU * 2.7 * AU))));
  }
  track_frame(s[0].track[..], dt, width, height, dpr);
  if d[0].n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  return d[0].n;
}

// ---- staged moments (?stage=NAME, docs/verse/clips.md): a fixed scene to record a clip of.
// A staged page never reads or writes the player's save (autosave and HOST_KEPT skip it), and
// without the parameter nothing here runs.
//   highlight: LANTERN braking hard into Saturn just outside the rings, its drive burning against
// its fall, the Mars Union's IRONWAKE on its tail, ring ice tumbling past the lens, and the view
// drifting in with them. The ships are drawn bigger than life (as the map draws far worlds), so a
// hull reads beside a planet.
STAGE_NONE :: 0; STAGE_HIGHLIGHT :: 1;
STAGE_SECONDS :: 3.0;            // the dolly's length in real seconds; after it the view holds
STAGE_RATE :: 700.0;             // game seconds a real second, so the swing past the rings is seen
STAGE_LEAD :: 2400.0;            // game seconds before periapsis the moment starts
STAGE_STOP :: 120.0;             // and the clock stops this long before it, so the ship never parks
STAGE_SHIP :: 1;                 // LANTERN, the big hull
STAGE_RIVAL :: 3;                // IRONWAKE, made to fly LANTERN's arrival this far behind it
STAGE_TRAIL :: 500.0;
STAGE_SWING :: 0.3;              // radians
STAGE_ROCKS :: 5;
// ring ice near the lens, in screen fractions and per second: x, y, dx, dy, radius (of the short side), spin
STAGE_ROCK :: [30] f64.[
  1.08, 0.05, -0.24, 0.0, 0.055, 1.3,
  -0.10, 0.84, 0.13, -0.025, 0.085, -0.9,
  0.86, 1.10, -0.05, -0.07, 0.032, 2.1,
  0.30, -0.06, 0.09, 0.05, 0.022, -2.6,
  1.04, 0.62, -0.16, 0.0, 0.018, 3.0];

query_word :: (url: string, pair: string) -> bool {
  i := 0;
  while i < url.count && url[i] != '?' { i += 1; }
  while i < url.count && url[i] != '#' {
    i += 1;
    e := i; while e < url.count && url[e] != '&' && url[e] != '#' { e += 1; }
    if url[i..<e] == pair { return true; }
    i = e;
  }
  return false;
}
stage_of :: (url: string) -> int {
  if query_word(url, "stage=highlight") { return STAGE_HIGHLIGHT; }
  return STAGE_NONE;
}

stage_highlight :: (s: [] Belt) {
  belt_reset(s);
  s[0].stage = STAGE_HIGHLIGHT; s[0].stage_t = 0.0; s[0].stage_ship = STAGE_SHIP;
  s[0].restored = true; s[0].dirty = false; s[0].action = 0; s[0].out_n = 0;
  s[0].framed = true; s[0].speed = 1;
  k := STAGE_SHIP;
  // planned with tanks to spare (the stage is about the arrival, not the bill), then left a third full
  s[0].ships[k].fuel = 1000000.0;
  p := plan_with(s, k, BODY_SATURN, false, 0.85);
  p.enough = true;
  if !launch(s, k, BODY_SATURN, p) { return; }
  s[0].ships[k].fuel = 0.35 * s[0].ships[k].fuel_cap;
  // the rival: the same arrival, STAGE_TRAIL later, in the Mars Union's colours
  r := s[0].ships[k];
  was := s[0].ships[STAGE_RIVAL];
  r.faction = MARS_UNION; r.name = was.name; r.dry = was.dry; r.isp = was.isp; r.fuel = was.fuel; r.fuel_cap = was.fuel_cap;
  r.cargo = 0.0; r.cargo_cap = 0.0; r.mine_rate = 0.0; r.route = was.route; r.route_n = was.route_n; r.route_k = 0;
  r.t0 += STAGE_TRAIL; r.arc.epoch += STAGE_TRAIL; r.work = WORK_NONE;
  s[0].ships[STAGE_RIVAL] = r;
  ship_hyperbolas(s, STAGE_RIVAL);
  // and swung about Saturn a little, so it comes in on its own line, over the rings
  s[0].ships[STAGE_RIVAL].arr.node += STAGE_SWING;
  sh := s[0].ships[k];
  s[0].t = sh.t0 + sh.tof - STAGE_LEAD;
  // the other rivals' standing routes start from here, not years before
  for j: 0..<s[0].ship_n { if s[0].ships[j].faction != FREE_BELT { s[0].ships[j].idle_until = s[0].t + 30.0 * DAY; } }
  s[0].follow = -1; s[0].follow_place = -1; s[0].cam.following = false; s[0].cam.tilt = 0.0;
  stage_camera(s);
}

// The staged clock: STAGE_RATE, stopping short of the arrival.
stage_game :: (s: [] Belt, real: f64) -> f64 {
  s[0].stage_t += real;
  sh := s[0].ships[s[0].stage_ship];
  if sh.mode != FLYING { return 0.0; }
  return fclamp(fmin(STAGE_RATE * real, sh.t0 + sh.tof - STAGE_STOP - s[0].t), 0.0, STAGE_RATE * real);
}

stage_ease :: (x: f64) -> f64 { y := fclamp(x, 0.0, 1.0); return y * y * (3.0 - 2.0 * y); }
// The dolly: Saturn big from the first frame, the view centred a third of the way from it to the
// ship (so it rides along as the ship swings in) and pushing in slowly.
stage_camera :: (s: [] Belt) {
  if s[0].w <= 0 || s[0].h <= 0 { return; }
  f := stage_ease(s[0].stage_t / STAGE_SECONDS);
  ship := ship_state(s, s[0].stage_ship, s[0].t).r;
  sat := orbit_body_position(BODY_SATURN, s[0].t);
  // Saturn's radius on screen: big, with the rings and the ship both across the frame
  big := fmin(f64(s[0].h) * 0.27, f64(s[0].w) * 0.18) * (1.0 + 0.14 * f);
  scale := big / BODY_RADIUS[BODY_SATURN];
  c := d3_add(sat, d3_scale(d3_sub(ship, sat), 0.3 + 0.06 * f));
  s[0].cam.center = c; s[0].cam.goal_center = c;
  s[0].cam.scale = scale; s[0].cam.goal_scale = scale;
  s[0].cam.following = false;
}
// The least a staged ship's hull is drawn, in pixels (LANTERN big, the rival behind it smaller).
stage_hull :: (s: [] Belt, k: int) -> f32 {
  if s[0].stage == STAGE_NONE { return 0; }
  // by Saturn's radius on screen, so the shot keeps its proportions in any frame
  big := pix(spacecam_pixels(s[0].cam, BODY_RADIUS[BODY_SATURN]));
  if k == s[0].stage_ship { return big * 0.85; }
  if k == STAGE_RIVAL { return big * 0.53; }
  return 0;
}
// Ring ice tumbling past near the lens: lumpy icy discs (belt.wgsl kind 10) drifting across.
stage_rocks :: (s: [] Belt, u: [] f32, d: [] Draw) {
  short := f64(lo(s[0].w, s[0].h));
  t := s[0].stage_t;
  for i: 0..<STAGE_ROCKS {
    o := i * 6;
    x := (STAGE_ROCK[o] + STAGE_ROCK[o + 2] * t) * f64(s[0].w);
    y := (STAGE_ROCK[o + 1] + STAGE_ROCK[o + 3] * t) * f64(s[0].h);
    disc(s, u, d, d2(x, y), STAGE_ROCK[o + 4] * short, 10, f32(i) * 0.73 + 0.4, f32(STAGE_ROCK[o + 5] * t));
  }
}

// A staged moment's only HUD: the title and the date.
stage_hud :: (s: [] Belt, out: [] f32, u: [] f32, d: [] Draw) {
  k := d[0].k;
  m := 12 * k;
  s[0].btn_n = 0;
  buf: [96] u8;
  panel(s, u, m, m, m + 170 * k, m + 50 * k, 0.85, false);
  words(out, d, "BELT 2200", m + 12 * k, m + 20 * k, 10 * k, 0.95, INK_R, INK_G, INK_B);
  dt := date_of(s[0].t);
  n := put_int(buf[..], 0, dt.day); n = put(buf[..], n, " "); n = put(buf[..], n, MONTHS[(dt.month - 1) % 12]); n = put(buf[..], n, " "); n = put_int(buf[..], n, dt.year);
  words(out, d, cast(string) buf[0..<n], m + 12 * k, m + 38 * k, 7.5 * k, 0.75, BELT_R, BELT_G, BELT_B);
}

// ---- checks

#test "the calendar: J2000 and 1 January 2200" {
  a := date_of(0.0);
  #assert a.year == 2000 && a.month == 1 && a.day == 1;
  b := date_of(ORBIT_2200);
  #assert b.year == 2200 && b.month == 1 && b.day == 1;
  c := date_of(ORBIT_2200 + 59.0 * DAY);
  #assert c.year == 2200 && c.month == 3 && c.day == 1;
}

#test "a trip to any ice rock near Ceres is planned in months, not a loop round the Sun" {
  s: [1] Belt;
  belt_start(s[..]);
  for j: 0..<ICE_ROCKS {
    for fast: 0..<2 {
      p := plan_for(s[..], 0, P_ICE + j, fast == 1);
      #assert p.ok && p.tr.tof <= NEAR_TOF + DAY;
    }
  }
}

#test "an ice rock beside Ceres is a cheap hop: a few km/s on the economy plan, well inside RASP's tanks" {
  s: [1] Belt;
  belt_start(s[..]);
  for j: 0..<ICE_ROCKS {
    p := plan_for(s[..], 0, P_ICE + j, false);
    #assert p.ok && p.enough && p.tr.dv < 4000.0 && p.fuel < 0.5 * s[0].ships[0].fuel;
  }
}

#test "GO FAST to the nearest ice rock is weeks, within RASP's propellant" {
  s: [1] Belt;
  belt_start(s[..]);
  select_only(s[..], 0);
  j := nearest_ice(s[..], 0);
  #assert j >= 0;
  p := plan_for(s[..], 0, j, true);
  e := plan_for(s[..], 0, j, false);
  #assert p.ok && p.enough && p.tr.tof < 60.0 * DAY && p.fuel < s[0].ships[0].fuel;
  #assert e.ok && e.tr.dv <= p.tr.dv;
}

#test "the ice rocks keep Ceres's year: a century on they are still within a few degrees of Hearth" {
  s: [1] Belt;
  belt_start(s[..]);
  for k: 0..<ICE_ROCKS {
    o := s[0].ices[k];
    c := orbit_body(BODY_CERES);
    #assert abs(o.a / c.a - 1.0) < 0.000001;
    t := s[0].t + 100.0 * 365.25 * DAY;
    h := place_state(s[..], P_STATION, t).r;
    p := orbit_position(o, t);
    cosang := d3_dot(h, p) / (d3_len(h) * d3_len(p));
    #assert cosang > cos(8.0 * DEG);
  }
}

#test "light lag: a ship ten light-minutes away is seen where it was ten minutes before" {
  s: [1] Belt;
  belt_start(s[..]);
  select_only(s[..], 0);
  mine_order(s[..]);
  go(s[..], true);
  for i: 0..<20 { belt_step(s[..], 0.05); }   // days of flight in its history
  now := ship_state(s[..], 0, s[0].t).r;
  eye := d3_add(now, d3(C_LIGHT * 600.0, 0.0, 0.0));
  seen := sight_seen(s[..], 0, eye);
  tau := d3_dist(eye, seen) / C_LIGHT;
  #assert abs(tau - 600.0) < 1.0;
  was := ship_state(s[..], 0, s[0].t - tau).r;
  #assert d3_dist(seen, was) < 1000.0 && d3_dist(seen, now) > 5000.0;
  // and a day ago, from the history
  #assert d3_dist(sight_at(s[..], 0, s[0].t - DAY), ship_state(s[..], 0, s[0].t - DAY).r) < 1000.0;
}

#test "the field: five thousand rocks where their orbits put them, each a quad, all within the vertex budget" {
  s: [1] Belt;
  belt_start(s[..]);
  r: [1] Rand;
  t := s[0].t + 400.0 * DAY;
  for j: 0..<ROCKS_FIRST {
    o := field_orbit(r[..]);
    #assert d3_dist(rock_at(s[0].rocks[j], t), orbit_position(o, t)) < 1000.0;
  }
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := belt_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
  #assert n > ROCKS_FIRST * 6 && n < MAX_VERTICES;
}

#test "the system view keeps Hearth on the screen as Ceres goes round; a view zoomed in rides with what it was on" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 1280; s[0].h = 800; s[0].dpr = 1;
  look_at_system(s[..]);
  s[0].cam = spacecam_settle(s[0].cam);
  s[0].speed = 3;
  for i: 0..<2000 { belt_step(s[..], 0.05); }   // 3,000 days: two thirds of Ceres's year
  q := screen_of(s[..], place_state(s[..], P_STATION, s[0].t).r);
  #assert q.x > 0.0 && q.x < 1280.0 && q.y > 0.0 && q.y < 800.0;
  // zoomed in on Hearth: it stays near the middle while the days run
  h := screen_of(s[..], place_state(s[..], P_STATION, s[0].t).r);
  zoom_at(s[..], 2000.0, pix(h.x), pix(h.y));
  #assert s[0].ride == P_STATION && !s[0].system;
  s[0].cam = spacecam_settle(s[0].cam);
  before := screen_of(s[..], place_state(s[..], P_STATION, s[0].t).r);
  for i: 0..<200 { belt_step(s[..], 0.05); }
  after := screen_of(s[..], place_state(s[..], P_STATION, s[0].t).r);
  #assert abs(after.x - before.x) < 2.0 && abs(after.y - before.y) < 2.0;
  // a reload frames the saved date's Hearth
  buf: [OUTBOX_CAP] u8;
  n := save_game(s[..], buf[..]);
  b: [1] Belt;
  belt_start(b[..]);
  b[0].framed = true;
  #assert load_game(b[..], cast(string) buf[0..<n]) && !b[0].framed;
}

#test "with a ship selected, each of the eight ice rocks is a named button that plans the trip, on a phone and a desktop" {
  sizes := [2] D2.[D2.{x = 1170, y = 2532}, D2.{x = 1280, y = 800}];
  dprs := [2] f32.[3, 1];
  for z: 0..<2 {
    s: [1] Belt;
    belt_start(s[..]);
    out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
    w := f32(sizes[z].x); h := f32(sizes[z].y);
    n := belt_frame(s[..], out[..], u[..], w, h, dprs[z], 0.016, false);
    select_only(s[..], 0);
    for f: 0..<10 { n = belt_frame(s[..], out[..], u[..], w, h, dprs[z], 0.016, false); }
    for j: 0..<ICE_ROCKS {
      #assert s[0].reach_have[j] && s[0].reach_ok[j] && s[0].reach_days[j] > 0.0;
      b := -1;
      for i: 0..<s[0].btn_n { if s[0].btn[i].id == B_ROCK && s[0].btn[i].arg == j { b = i; } }
      #assert b >= 0;
      r := s[0].btn[b];
      #assert r.x0 >= 0 && r.x1 <= w && r.y0 >= 0 && r.y1 <= h && r.x1 - r.x0 >= 40 * dprs[z] && r.y1 - r.y0 >= 28 * dprs[z];
      x := (r.x0 + r.x1) / 2; y := (r.y0 + r.y1) / 2;
      #assert belt_pointer(s[..], x, y, 0, 1, 7);
      ok := belt_pointer(s[..], x, y, 2, 1, 7);
      #assert s[0].dest == P_ICE + j && s[0].eco.ok;
      s[0].dest = -1;
      n = belt_frame(s[..], out[..], u[..], w, h, dprs[z], 0.016, false);
    }
  }
}

#test "from the whole system down to a 300 m hull in flight: the followed ship holds its pixel, frame after frame" {
  s: [1] Belt;
  belt_start(s[..]);
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := belt_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
  select_only(s[..], 0);
  mine_order(s[..]);
  go(s[..], true);
  for i: 0..<40 { belt_step(s[..], 0.05); }   // well under way
  #assert s[0].ships[0].mode == FLYING;
  follow_ship(s[..], 0);
  s[0].cam.goal_scale = 1.0;   // a pixel a metre: the hull 120-180 px long at 2.7 AU from the Sun
  s[0].speed = 1;
  s[0].cam = spacecam_settle(s[0].cam);
  for i: 0..<8 {
    n = belt_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
    q := ship_screen(s[..], 0);
    #assert abs(q.x - 640.0) < 0.5 && abs(q.y - 400.0) < 0.5 && n > 0;
  }
}

#test "a miner sent for ice mines at the rock, flies home and delivers it, and the rivals fly" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 1440; s[0].h = 900; s[0].dpr = 1;
  select_only(s[..], 0);
  mine_order(s[..]);
  #assert is_ice(s[0].dest) && s[0].eco.ok && s[0].fast.ok;
  #assert s[0].fast.tr.tof <= s[0].eco.tr.tof && s[0].fast.fuel > 0.0 && s[0].fast.fuel < s[0].ships[0].fuel;
  fuel0 := s[0].ships[0].fuel;
  go(s[..], true);
  #assert s[0].ships[0].mode == FLYING && s[0].ships[0].fuel < fuel0;
  mined := false;
  for i: 0..<3000 {
    s[0].t += DAY;
    step_ships(s[..], DAY);
    if s[0].ships[0].mode == MINING { mined = true; }
    if s[0].delivered > 0.0 { break; }
  }
  #assert mined && s[0].delivered == 600.0;
  // It refuelled from the station's ice and went back for more.
  #assert s[0].ships[0].mode == FLYING && s[0].ships[0].work == WORK_MINE;
  rivals := 0;
  for k: 0..<s[0].ship_n { if s[0].ships[k].faction != FREE_BELT && s[0].ships[k].route_k != 0 { rivals += 1; } }
  #assert rivals > 0;
}

#test "fleets: a box takes all three ships and one order sends them all; Ctrl+4 keeps them as a group; Shift queues the next order" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 1440; s[0].h = 900; s[0].dpr = 1;
  box_select(s[..], -100000, -100000, 100000, 100000);
  #assert selected_count(s[..]) == 3;   // the Free Belt's three, not the rivals
  #assert belt_key(s[..], '4', 2) && verse_command_group_size(s[0].cmd[..], 4) == 3;
  select_only(s[..], 1);
  #assert belt_key(s[..], '4', 0) && selected_count(s[..]) == 3;
  #assert belt_key(s[..], '2', 0) && s[0].speed == 2;   // 1-3 stay the clock
  rock := P_ICE;
  set_dest(s[..], rock);
  go(s[..], true);
  for k: 0..<3 { #assert s[0].ships[k].mode == FLYING && s[0].ships[k].at == rock; }
  // Shift and an order while RASP flies: home to Hearth once it gets there
  select_only(s[..], 0);
  s[0].shift = true;
  set_dest(s[..], P_STATION);
  go(s[..], false);
  s[0].shift = false;
  #assert s[0].ships[0].at == rock && verse_command_queued(s[0].cmd[..], 0) == 1;
  turned := false;
  for i: 0..<400 {
    s[0].t += DAY;
    step_ships(s[..], DAY);
    if s[0].ships[0].mode == FLYING && s[0].ships[0].at == P_STATION { turned = true; break; }
  }
  #assert turned && verse_command_queued(s[0].cmd[..], 0) == 0;
}

#test "MINE ICE with several ships: each plans from where it is, and a full hold flies home to unload" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 1440; s[0].h = 900; s[0].dpr = 1;
  // RASP full at a far rock, LANTERN empty at Hearth, KITE (no hold) at Hearth
  far := P_ICE + 5;
  s[0].ships[0].mode = MINING; s[0].ships[0].at = far; s[0].ships[0].work = WORK_MINE; s[0].ships[0].work_rock = far;
  s[0].ships[0].cargo = s[0].ships[0].cargo_cap;
  near := nearest_ice(s[..], 1);
  verse_command_only(s[0].cmd[..], 0); verse_command_toggle(s[0].cmd[..], 1); verse_command_toggle(s[0].cmd[..], 2);
  mine_order(s[..]);
  #assert s[0].ships[0].mode == FLYING && s[0].ships[0].at == P_STATION && s[0].ships[0].work_rock == far;
  #assert s[0].ships[1].mode == FLYING && s[0].ships[1].at == near && s[0].ships[1].work == WORK_MINE;
  #assert s[0].ships[2].mode == PARKED && s[0].dest < 0;
  // one ship alone, full: it plans the trip home instead
  b: [1] Belt;
  belt_start(b[..]);
  b[0].ships[1].cargo = b[0].ships[1].cargo_cap; b[0].ships[1].mode = MINING; b[0].ships[1].at = far;
  select_only(b[..], 1);
  mine_order(b[..]);
  #assert b[0].dest == P_STATION;
}

#test "on a phone, a long-press on your ship adds it to the selection or takes it out; a short tap selects it alone" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 390; s[0].h = 844; s[0].dpr = 3;
  // send LANTERN and KITE off so RASP stands alone at Hearth
  verse_command_only(s[0].cmd[..], 1); verse_command_toggle(s[0].cmd[..], 2);
  set_dest(s[..], P_ICE); go(s[..], true);
  for i: 0..<40 { s[0].t += DAY; step_ships(s[..], DAY); }
  q := ship_screen(s[..], 0);
  x := pix(q.x); y := pix(q.y);
  #assert ship_at(s[..], x, y, 48, FREE_BELT) == 0;
  verse_command_only(s[0].cmd[..], 1);
  #assert belt_pointer(s[..], x, y, 0, 1, 7);
  s[0].clock += 0.6;
  #assert belt_pointer(s[..], x, y, 2, 1, 7);
  #assert selected_count(s[..]) == 2 && s[0].cmd[0].selected[0] && s[0].cmd[0].selected[1];
  #assert belt_pointer(s[..], x, y, 0, 1, 8); s[0].clock += 0.6; #assert belt_pointer(s[..], x, y, 2, 1, 8);
  #assert selected_count(s[..]) == 1 && !s[0].cmd[0].selected[0];
  #assert belt_pointer(s[..], x, y, 0, 1, 9); s[0].clock += 0.1; #assert belt_pointer(s[..], x, y, 2, 1, 9);
  #assert selected_count(s[..]) == 1 && s[0].cmd[0].selected[0];
}

#test "the yard: a freighter spends its metal and crew and appears at Hearth when it is done, and the save keeps it" {
  s: [1] Belt;
  belt_start(s[..]);
  #assert yard_can(s[..]) == YARD_METAL && !yard_build(s[..]);
  s[0].station[0].metal = 200.0;
  hands := free_hands(s[..]);
  #assert yard_can(s[..]) == YARD_OK && yard_build(s[..]);
  #assert s[0].station[0].metal == 50.0 && free_hands(s[..]) == hands - FREIGHTER_CREW && yard_can(s[..]) == YARD_BUSY && s[0].ship_n == SHIP_BASE;
  for i: 0..<19 { s[0].t += DAY; step_ships(s[..], DAY); }
  #assert s[0].ship_n == SHIP_BASE;
  s[0].t += DAY; step_ships(s[..], DAY);
  f := SHIP_BASE;
  #assert s[0].ship_n == SHIP_BASE + 1 && s[0].ships[f].faction == FREE_BELT && s[0].ships[f].mode == PARKED && s[0].ships[f].at == P_STATION;
  #assert s[0].ships[f].crew == FREIGHTER_CREW && free_hands(s[..]) == hands - FREIGHTER_CREW && s[0].ships[f].slot != s[0].ships[0].slot;
  buf: [OUTBOX_CAP] u8;
  n := save_game(s[..], buf[..]);
  b: [1] Belt;
  belt_start(b[..]);
  #assert load_game(b[..], cast(string) buf[0..<n]) && b[0].ship_n == SHIP_BASE + 1 && b[0].ships[f].name == s[0].ships[f].name && b[0].ships[f].cargo_cap == 2000.0;
}

#test "a freighter on a standing route hauls a rig's ice home again and again without new orders" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].w = 1440; s[0].h = 900; s[0].dpr = 1;
  // no rig yet: nowhere to haul from
  s[0].ships[SHIP_BASE] = freighter_new(0); s[0].ship_n = SHIP_BASE + 1; s[0].ships[SHIP_BASE].slot = 3;
  select_only(s[..], SHIP_BASE);
  mine_order(s[..]);
  #assert s[0].dest < 0;
  // RASP mines a rock and leaves its rig there
  rock := nearest_ice(s[..], 0);
  select_only(s[..], 0); set_dest(s[..], rock); go(s[..], true);
  for i: 0..<200 { s[0].t += DAY; step_ships(s[..], DAY); if s[0].claim[rock - P_ICE] { break; } }
  #assert s[0].claim[rock - P_ICE];
  // the freighter: HAUL ICE, once
  select_only(s[..], SHIP_BASE);
  #assert ice_for(s[..], SHIP_BASE) == rock;
  mine_order(s[..]);
  #assert s[0].dest == rock;
  go(s[..], false);
  #assert s[0].ships[SHIP_BASE].mode == FLYING;
  // then two years of it hauling: it delivers more than once with no order given
  hauled := 0; was := s[0].ships[SHIP_BASE].cargo;
  for i: 0..<730 {
    s[0].t += DAY; step_ships(s[..], DAY);
    c := s[0].ships[SHIP_BASE].cargo;
    if was > 0.0 && c == 0.0 { hauled += 1; }   // unloaded at Hearth, and off again
    was = c;
  }
  #assert hauled >= 2 && s[0].ships[SHIP_BASE].work == WORK_MINE && s[0].ships[SHIP_BASE].work_rock == rock;
}

#test "intercepts: two hostile ships whose paths cross engage at the moment they come in range, stop the clock, and part after" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].speed = 2;
  tc := s[0].t + 10.0 * DAY;
  p := d3(400000000000.0, 0.0, 0.0);
  va := d3(0.0, 18000.0, 0.0); vb := d3(0.0, 16000.0, 3000.0);
  for q: 0..<2 {
    k := ifx q == 0 then 0 else 3;   // RASP and IRONWAKE
    s[0].ships[k].mode = FLYING; s[0].ships[k].t0 = s[0].t; s[0].ships[k].tof = 100.0 * DAY;
    s[0].ships[k].dep_body = 0; s[0].ships[k].arr_body = 0; s[0].ships[k].at = P_STATION;
    s[0].ships[k].arc = orbit_from_state(orbit_state_of(p, ifx q == 0 then va else vb), GM_SUN, tc);
  }
  for i: 0..<9 { s[0].t += DAY; step_ships(s[..], DAY); }
  #assert s[0].engaged[0] == -1 && s[0].speed == 2;
  s[0].t += 2.0 * DAY; step_ships(s[..], 2.0 * DAY);   // a step longer than a day still finds the moment
  rel := d3_len(d3_sub(va, vb));
  #assert s[0].engaged[0] == 3 && s[0].engaged[3] == 0 && s[0].speed == 0;
  #assert abs(s[0].engage_t[0] - (tc - COMBAT_RANGE / rel)) < 600.0;
  for i: 0..<3 { s[0].t += DAY; step_ships(s[..], DAY); }
  #assert s[0].engaged[0] == -1;
  // a straight pass: the closest approach and when
  c := closest_pass(d3(0.0, 0.0, 0.0), d3(1.0, 0.0, 0.0), d3(10.0, 5.0, 0.0), d3(-1.0, 0.0, 0.0), 100.0);
  #assert abs(c.tau - 5.0) < 0.0001 && abs(c.dist - 5.0) < 0.0001;
}

#test "Hearth refines its ice into reaction mass at the refinery's rate, a shift short while the crews are away, and an old save still reads" {
  s: [1] Belt;
  belt_start(s[..]);
  s[0].station[0].ice = 1000.0;
  m0 := s[0].station[0].mass;
  for i: 0..<5 { s[0].t += DAY; step_ships(s[..], DAY); }
  #assert s[0].station[0].away == 0 && abs(s[0].station[0].mass - m0 - 5.0 * REFINE_RATE * REFINE_MASS) < 0.01;
  box_select(s[..], -100000, -100000, 100000, 100000);
  set_dest(s[..], P_ICE);
  go(s[..], true);
  m1 := s[0].station[0].mass;
  s[0].t += DAY; step_ships(s[..], DAY);
  #assert s[0].station[0].away == 6 + 8 + 3 && station_workers(s[0].station[0]) == 46 - 17;
  #assert abs(s[0].station[0].mass - m1 - REFINE_RATE * REFINE_MASS * 29.0 / 30.0) < 0.01;
  // the first saves kept only the station's ice
  buf: [OUTBOX_CAP] u8;
  b: [1] Belt;
  belt_start(b[..]);
  n := save_game(b[..], buf[..]);
  buf[SAVE_TAG.count - 1] = '1';
  // drop the fields after delivered that version 1 didn't have: mass to the rigs' stocks
  bars := 0; cut0 := 0; cut1 := 0;
  for i: 0..<n { if buf[i] == '|' { bars += 1; if bars == 5 { cut0 = i; } if bars == 19 { cut1 = i; } } }
  old: [OUTBOX_CAP] u8; m := 0;
  for i: 0..<n { if i < cut0 || i >= cut1 { old[m] = buf[i]; m += 1; } }
  c: [1] Belt;
  belt_start(c[..]);
  #assert load_game(c[..], cast(string) old[0..<m]);
  #assert abs(c[0].station[0].ice + c[0].station[0].mass - b[0].station[0].ice) < 0.01;
}

#test "a rival leaves its world on a hyperbola and arrives at its periapsis, with no jump at the handoff" {
  s: [1] Belt;
  belt_start(s[..]);
  k := 3;   // IRONWAKE at Mars, bound for Ceres
  p := plan_for(s[..], k, BODY_CERES, false);
  #assert launch(s[..], k, BODY_CERES, p);
  sh := s[0].ships[k];
  #assert sh.dep_body == BODY_MARS && sh.arr_body == BODY_CERES;
  t0 := sh.t0; tf := sh.t0 + sh.tof;
  // it starts at its berth's distance from Mars and ends at its berth's distance from Ceres
  d0 := d3_dist(flight_state(sh, t0).r, orbit_body_position(BODY_MARS, t0));
  #assert abs(d0 - berth_radius(BODY_MARS)) < 1.0;
  d1 := d3_dist(flight_state(sh, tf).r, orbit_body_position(BODY_CERES, tf));
  #assert abs(d1 - berth_radius(BODY_CERES)) < 1.0;
  // no jump: step by step it moves no farther than its speed allows (twice over, for the blend)
  dt := 600.0;
  prev := flight_state(sh, t0);
  worst := 0.0;
  tt := t0 + dt;
  // (measured from Mars, which moves on at 24 km/s under it)
  prev_rel := d3_sub(prev.r, orbit_body_position(BODY_MARS, t0));
  while tt < t0 + 20.0 * DAY {
    m := orbit_body_state(BODY_MARS, tt);
    st := flight_state(sh, tt);
    rel := d3_sub(st.r, m.r);
    step := d3_dist(rel, prev_rel);
    allowed := 2.0 * d3_len(d3_sub(st.v, m.v)) * dt + 1000.0;
    worst = fmax(worst, step / allowed);
    prev_rel = rel; tt += dt;
  }
  #assert worst < 1.0;
}

#test "a save mid-flight reads back to the same game, and a broken one changes nothing" {
  s: [1] Belt;
  belt_start(s[..]);
  select_only(s[..], 1);
  mine_order(s[..]);
  go(s[..], true);
  for i: 0..<30 { s[0].t += DAY; step_ships(s[..], DAY); }
  buf: [OUTBOX_CAP] u8;
  n := save_game(s[..], buf[..]);
  #assert n > 0 && n < OUTBOX_CAP;
  b: [1] Belt;
  belt_start(b[..]);
  #assert load_game(b[..], cast(string) buf[0..<n]);
  #assert abs(b[0].t - s[0].t) < 0.001 && abs(b[0].station[0].ice - s[0].station[0].ice) < 0.001 && abs(b[0].station[0].mass - s[0].station[0].mass) < 0.001;
  for k: 0..<s[0].ship_n {
    #assert b[0].ships[k].mode == s[0].ships[k].mode && b[0].ships[k].at == s[0].ships[k].at;
    #assert abs(b[0].ships[k].fuel - s[0].ships[k].fuel) < 0.001;
    #assert d3_dist(ship_state(b[..], k, s[0].t).r, ship_state(s[..], k, s[0].t).r) < 50.0;
  }
  c: [1] Belt;
  belt_start(c[..]);
  t0 := c[0].t;
  #assert !load_game(c[..], cast(string) buf[0..<n / 2]);
  #assert !load_game(c[..], "BELT2200 1|nonsense");
  #assert c[0].t == t0;
}

#test "the highlight stage: LANTERN braking hard past Saturn's rings with IRONWAKE on its tail, Saturn big in every frame, and the save untouched" {
  // without the parameter nothing is staged
  #assert stage_of("https://openagents.com/realms/belt-2200") == STAGE_NONE;
  #assert stage_of("https://openagents.com/realms/belt-2200?stage=other") == STAGE_NONE;
  #assert stage_of("https://openagents.com/realms/belt-2200?x=1&stage=highlight#a") == STAGE_HIGHLIGHT;
  s: [1] Belt;
  belt_start(s[..]);
  #assert stage_hull(s[..], STAGE_SHIP) == 0;
  s[0].w = 1280; s[0].h = 720; s[0].dpr = 1;
  belt_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/belt-2200?stage=highlight");
  #assert s[0].stage == STAGE_HIGHLIGHT;
  k := s[0].stage_ship;
  sh := s[0].ships[k];
  #assert sh.mode == FLYING && sh.at == BODY_SATURN && sh.arr_body == BODY_SATURN;
  rv := s[0].ships[STAGE_RIVAL];
  #assert rv.faction == MARS_UNION && rv.mode == FLYING && rv.arr_body == BODY_SATURN;
  // a save the browser gives back after staging is not read
  t0 := s[0].t;
  belt_message(s[..], HOST_KEPT, "BELT2200 1|6311433600000|2|1200000000|0|7");
  #assert s[0].t == t0;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  for i: 0..<90 {
    n := belt_frame(s[..], out[..], u[..], 1280, 720, 1, 1.0 / 30.0, false);
    #assert n > 0;
    // both ships in frame and burning, Saturn big and in frame, the rocks drawn: every frame
    for j: 0..<2 {
      q := ship_screen(s[..], ifx j == 0 then k else STAGE_RIVAL);
      #assert q.x > 0.0 && q.x < 1280.0 && q.y > 0.0 && q.y < 720.0;
    }
    #assert ship_burn(s[..], k) == -1 && ship_burn(s[..], STAGE_RIVAL) == -1;
    sat := screen_of(s[..], orbit_body_position(BODY_SATURN, s[0].t));
    #assert sat.x > 0.0 && sat.x < 1280.0 && sat.y > 0.0 && sat.y < 720.0;
    #assert spacecam_pixels(s[0].cam, BODY_RADIUS[BODY_SATURN]) > 180.0;
    #assert u[11] >= f32(1 + STAGE_ROCKS) - 2.0;
  }
  #assert s[0].ships[k].mode == FLYING && s[0].t > t0 + 2.5 * STAGE_RATE;
  // and nothing was kept in the browser
  #assert s[0].action == 0 && s[0].out_n == 0;
}

#test "a claimed maker's name draws MADE BY <NAME> · TIP, and TIP goes to the tip page" {
  ss: [2] Belt;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for dims: 0..<2 {
    s := ss[dims..<dims + 1];
    belt_start(s);
    w: f32 = ifx dims == 0 then 1440 else 390 * 3; h: f32 = ifx dims == 0 then 900 else 844 * 3; dpr: f32 = ifx dims == 0 then 1 else 3;
    a := belt_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert !s[0].tip_shown;
    belt_message(s, MAKER_KIND, "Topher");
    b := belt_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert b > a && s[0].tip_shown;
    for i: 0..<s[0].btn_n { r := s[0].btn[i]; #assert s[0].tip_x1 < r.x0 || s[0].tip_x0 > r.x1 || s[0].tip_y1 < r.y0 || s[0].tip_y0 > r.y1; }
    #assert s[0].tip_x0 >= 0 && s[0].tip_x1 <= w && s[0].tip_y1 <= h;
    cx := (s[0].tip_x0 + s[0].tip_x1) * 0.5; cy := (s[0].tip_y0 + s[0].tip_y1) * 0.5;
    kind := ifx dims == 0 then 0 else 1;
    // the host takes any save the frames asked to keep first
    kept := belt_action(s); belt_action_done(s);
    #assert belt_pointer(s, cx, cy, 0, kind, 4) && !s[0].mouse_down && s[0].fingers[0].id < 0;
    #assert belt_pointer(s, cx, cy, 2, kind, 4) && s[0].action == ACT_NAVIGATE;
    #assert cast(string) s[0].outbox[0..<s[0].out_n] == "/realms/belt-2200/tip";
  }
}
