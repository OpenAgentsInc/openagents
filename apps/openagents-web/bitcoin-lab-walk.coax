// Bitcoin Lab (openagents.com/worlds/bitcoin-lab, unlisted): the first chapter of the Bitcoin book
// as a short walk on the Grid. You walk your own character down one lit lane past six stations and a
// short chain of blocks:
//   1 a byte: eight bits, its value as a number, in hex and as a letter
//   2 hex: the genesis block's 80 header bytes, two digits a byte, a nibble at a time
//   3 base64: three of those bytes regrouped into four sextets, and the letters they name
//   4 byte order: the header's time field little-endian on the wire, and the number it means
//   5 SHA-256: the 80 bytes into SHA-256, 32 bytes out
//   6 SHA-256d: the digest hashed again, shown reversed, its leading zeros against the target
//   7 the chain: the recorded regtest chain's last blocks, each joined to the one before by its
//     previous-block hash
// Every number is worked out at run time by the book's own Coax (bitcoin-lab-lesson.coax).
//
// The walking, the camera, the HUD, WORLDS, the slabs, the skyline and the Grid are the lab walk's
// (verse/lab-walk.coax), shared with Nostr Lab; this module names the stations and draws their
// lessons and the chain's cubes. Its C face is bitcoin-lab-walk-face.c over lab-walk-face.h.
//   coax/remote/remote.sh run -- coax/bin/coax test --library apps/openagents-web/bitcoin-lab-walk.coax --only "bitcoin lab walk"
#load "../../verse/lab-walk.coax";
#load "bitcoin-lab-lesson.coax";

BW_PATHS :: [2] string.["/worlds/bitcoin-lab", "/worlds/bitcoin-lab/"];
// The walk: you start at the lane's start facing down it (toward -z). Stations stand beside the lane,
// their faces toward you as you come, on alternate sides.
BW_STATIONS :: 7;
BW_STATION_Z :: [BW_STATIONS] f32.[-10, -25, -40, -55, -70, -85, -100];
BW_STATION_SIDE :: [BW_STATIONS] f32.[-1, 1, -1, 1, -1, 1, 1];
BW_NAME :: [BW_STATIONS] string.["A BYTE", "HEX", "BASE64", "BYTE ORDER", "SHA-256", "SHA-256D", "THE CHAIN"];
BW_LINE :: [BW_STATIONS] string.[
  "Eight bits: 0 to 255, two hex digits, one letter.",
  "The genesis block's 80 header bytes, two hex digits a byte.",
  "Three bytes are 24 bits: four 6-bit letters.",
  "The time field is little-endian: read its bytes backwards.",
  "80 bytes in, 32 bytes out, computed here in Coax.",
  "Hash the hash: a block's hash must be under its target.",
  "Each block names the hash of the one before it.",
];
BW_INTRO :: "Walk the lane: chapter 1, then the hash, then the chain.";
// The chain: cubes on the left of the lane past the last station, oldest first.
BW_LINK_Y :: 2.0f32;   // the links' height: over the hash on the faces
BW_CUBE :: 2.4f32; BW_CHAIN_X :: -5.4f32; BW_CHAIN_Z0 :: -108.0f32; BW_CHAIN_STEP :: 10.0f32;
BW_WORD :: "BITCOIN";
BW_FIELD_INK :: [BL_FIELDS] LabRgb.[LabRgb.{r = 0.35, g = 0.95, b = 1.25}, LabRgb.{r = 0.32, g = 0.40, b = 0.48}, LabRgb.{r = 0.55, g = 0.85, b = 1.1}, LabRgb.{r = 1.35, g = 0.6, b = 0.12}, LabRgb.{r = 0.8, g = 0.5, b = 1.3}, LabRgb.{r = 0.4, g = 1.25, b = 0.6}];
BW_FIELD_SHORT :: [BL_FIELDS] string.["VERSION", "PREV HASH", "MERKLE ROOT", "TIME", "BITS", "NONCE"];

BitcoinWalk :: struct {
  w: [1] LabWalk;
  lesson: [1] Lesson;
}
bw_page :: (facts: string) -> bool { for p: BW_PATHS { if cc.page_path(facts, p) { return true; } } return false; }
// The walk's stations and words: set on every call in, so a fresh state has them.
bw_conf :: (bk: [] BitcoinWalk) -> [] LabWalk {
  w := bk[0].w[..];
  if w[0].n == 0 { lab_conf(w, "BITCOIN LAB", BW_INTRO, "CHAPTER 1: BYTES, HEX AND BASE64", "CHAPTER 1", BW_STATION_Z[..], BW_STATION_SIDE[..], BW_NAME[..], BW_LINE[..]); }
  return w;
}

// ---- the stations' lessons
// 1 a byte: the letters of BW_WORD in turn once you are there.
bw_byte :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); t := lab_anim(w, i);
  k := ifx t > 0 then (cast(int) (t / 1.6)) % BW_WORD.count else 0; v := cast(int) BW_WORD[k];
  cell := 0.72f32; gap := 0.12f32; u0 := (LAB_PANEL_W - (8 * cell + 7 * gap)) * 0.5;
  pv := [8] string.["128", "64", "32", "16", "8", "4", "2", "1"];
  for bit: 0..<8 {
    on := bl_bit(cast,trunc(u8) v, bit); cx := x0 + u0 + f32(bit) * (cell + gap) + cell * 0.5;
    lab_face_z(w, cx, 2.25, z + 0.01, cell * 0.5, 0.48, ifx on then LAB_ORANGE else LAB_DIM, ifx on then 0.55 else 0.12, ifx on then 1.4 else 0.6, 1);
    lab_say_mid(w, ifx on then "1" else "0", x0, z + 0.01, cx - x0, 2.0, 0.5, ifx on then LabRgb.{r = 1.6, g = 1.2, b = 0.7} else LAB_CYAN, ifx on then 1.6 else 0.6);
    lab_say_mid(w, pv[bit], x0, z, cx - x0, 1.42, 0.17, LAB_CYAN, 0.7);
  }
  b: [48] u8; n := bl_int(b[..], 0, v); n = bl_str(b[..], n, "  =  0x"); lab_hex2(b[n..<n + 2], v); n += 2; n = bl_str(b[..], n, "  =  '"); b[n] = cast,trunc(u8) v; n += 1; n = bl_str(b[..], n, "'");
  lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 0.5, 0.42, LAB_GOLD, 1.3 + lit);
}
// 2 hex: the header's bytes, five rows of sixteen, coloured by field; one byte at a time shows its nibbles.
bw_hex :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0]; t := lab_anim(w, i);
  h := 0.2f32; adv := h * 6 / 7; pitch := 2 * adv + 0.07; u0 := (LAB_PANEL_W - (16 * pitch - 0.07)) * 0.5;
  // the byte shown up close: the header's bytes that aren't zero, one after another
  pick := BL_TIME_AT;
  if t > 0 { live := 0; for a: 0..<BL_HEADER { if l.header[a] != 0 { live += 1; } } want := (cast(int) (t * 1.25)) % (ifx live > 0 then live else 1); for a: 0..<BL_HEADER { if l.header[a] != 0 { if want == 0 { pick = a; break; } want -= 1; } } }
  for r: 0..<5 { for c: 0..<16 {
    at := r * 16 + c; f := bl_field(at); u := u0 + f32(c) * pitch; v := 3.05 - f32(r) * 0.4;
    ink := BW_FIELD_INK[f]; light := 0.9f32;
    if at == pick { lab_face_z(w, x0 + u + adv - 0.02, v + h * 0.5, z + 0.01, adv + 0.03, h * 0.75, ink, 0.35, 1.2, 0.85); ink = LabRgb.{r = 1.6, g = 1.6, b = 1.6}; light = 1.8; }
    lab_say(w, cast(string) l.header_hex[at * 2..<at * 2 + 2], x0, z + 0.01, u, v, h, ink, light);
  } }
  // the legend: each field's name in its colour
  lu := 0.35f32; lh := 0.13f32;
  for f: 0..<BL_FIELDS { lab_say(w, BW_FIELD_SHORT[f], x0, z, lu, 1.12, lh, BW_FIELD_INK[f], 0.9); lu += lab_text_w(BW_FIELD_SHORT[f].count + 2, lh); }
  // the picked byte: two hex digits, two nibbles of four bits
  b: [48] u8; v := cast(int) l.header[pick]; n := 0; lab_hex2(b[0..<2], v); n = 2; n = bl_str(b[..], n, "  =  ");
  n = lab_bits(b[..], n, v, 8, 4); n = bl_str(b[..], n, " "); n = lab_bits(b[..], n, v, 4, 4);
  lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 0.45, 0.36, LAB_GOLD, 1.3 + lit);
}
// 3 base64: three bytes, their 24 bits regrouping from bytes into sextets as you arrive, four letters.
bw_b64 :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0]; t := lab_anim(w, i);
  g := lab_ease((t - 0.8) / 1.6);   // 0: grouped as bytes, 1: as sextets
  cell := 0.19f32; step := 0.235f32; gap := 0.22f32; u0 := (LAB_PANEL_W - (24 * step + 3 * gap)) * 0.5;
  for k: 0..<24 {
    on := bl_b64_bit(l, k); gb := f32(k / 8) * 1.5; gs := f32(k / 6); u := u0 + f32(k) * step + (gb + (gs - gb) * g) * gap;
    col := lab_mix(LAB_CYAN, ifx (k / 6) % 2 == 0 then LAB_ORANGE else LAB_GOLD, g);
    lab_face_z(w, x0 + u + cell * 0.5, 2.3, z + 0.01, cell * 0.5, 0.28, ifx on then lab_scale(col, 0.55) else LAB_DIM, ifx on then 0.35 else 0.06, 0.8, 1);
    lab_say_mid(w, ifx on then "1" else "0", x0, z + 0.01, u + cell * 0.5, 2.21, 0.18, ifx on then lab_mix(col, LabRgb.{r = 1.6, g = 1.6, b = 1.6}, 0.5) else LAB_CYAN, ifx on then 1.3 else 0.45);
  }
  b: [8] u8;
  for k: 0..<3 {   // the bytes over their eight bits, fading as the sextets take over
    lab_hex2(b[0..<2], cast(int) l.header[BL_B64_AT + k]); mid := u0 + (f32(k) * 8 + 4) * step + f32(k) * 1.5 * gap - step * 0.5 + cell * 0.5;
    lab_say_mid(w, cast(string) b[0..<2], x0, z, mid, 2.95, 0.34, LAB_CYAN, 1.2 * (1 - g) + 0.15);
  }
  alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  for k: 0..<4 {   // the sextets' values and their letters, rising as they form
    v := bl_sextet(l, k); mid := u0 + (f32(k) * 6 + 3) * step + f32(k) * gap - step * 0.5 + cell * 0.5; n := bl_int(b[..], 0, v);
    lab_say_mid(w, cast(string) b[0..<n], x0, z, mid, 1.55, 0.26, LAB_GOLD, 1.2 * g + 0.1);
    b[0] = alphabet[v]; lab_say_mid(w, cast(string) b[0..<1], x0, z, mid, 0.45, 0.62, LAB_ORANGE, 1.9 * g + 0.15);
  }
}
// 4 byte order: the time field's four bytes as they are on the wire move into the order of the number.
bw_order :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0]; t := lab_anim(w, i);
  g := lab_ease((t - 0.8) / 1.8);
  cell := 1.1f32; gap := 0.25f32; u0 := (LAB_PANEL_W - (4 * cell + 3 * gap)) * 0.5;
  lab_say_mid(w, "ON THE WIRE", x0, z, LAB_PANEL_W * 0.5, 3.0, 0.17, LAB_CYAN, 0.9 * (1 - g) + 0.2);
  lab_say_mid(w, "AS THE NUMBER", x0, z, LAB_PANEL_W * 0.5, 1.15, 0.17, LAB_GOLD, 0.9 * g + 0.2);
  b: [48] u8;
  for k: 0..<4 {
    from := u0 + f32(k) * (cell + gap); to := u0 + f32(3 - k) * (cell + gap); u := from + (to - from) * g;
    v := 2.05 + sin(g * 3.14159) * (ifx k < 2 then 0.55f32 else -0.55f32);
    col := lab_mix(LAB_CYAN, LAB_ORANGE, g);
    lab_face_z(w, x0 + u + cell * 0.5, v, z + 0.01, cell * 0.5, 0.42, col, 0.3, 1.2, 1);
    lab_hex2(b[0..<2], cast(int) l.header[BL_TIME_AT + k]); lab_say_mid(w, cast(string) b[0..<2], x0, z + 0.01, u + cell * 0.5, v - 0.2, 0.4, LabRgb.{r = 1.5, g = 1.5, b = 1.5}, 1.4);
  }
  n := bl_str(b[..], 0, "0x"); for k: 0..<4 { lab_hex2(b[n..<n + 2], cast(int) l.header[BL_TIME_AT + 3 - k]); n += 2; } n = bl_str(b[..], n, " = "); n = bl_int(b[..], n, l.time);
  lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 0.78, 0.26, LAB_GOLD, 1.3 * g + 0.15);
  n = bl_date(b[..], l.time); lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 0.33, 0.26, LAB_ICE, 1.1 * g + 0.1);
}
// 5 SHA-256: the header's bytes flow into the hash and its 32 bytes come out.
bw_sha :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0]; t := lab_anim(w, i); now := lab_clock(w);
  // in: the 80 bytes, small
  h := 0.085f32; for r: 0..<10 { lab_say(w, cast(string) l.header_hex[r * 16..<r * 16 + 16], x0, z, 0.35, 3.0 - f32(r) * 0.17, h, LAB_CYAN, 0.8); }
  lab_say(w, "80 BYTES", x0, z, 0.35, 1.0, 0.17, LAB_CYAN, 1.0);
  // the hash: a lit box
  bx := x0 + 3.55; lab_face_z(w, bx, 2.25, z + 0.01, 0.7, 0.6, LAB_ORANGE, 0.35 + 0.15 * lit, 1.5, 1);
  lab_say_mid(w, "SHA", x0, z + 0.01, 3.55, 2.32, 0.24, LabRgb.{r = 1.6, g = 1.5, b = 1.3}, 1.6);
  lab_say_mid(w, "256", x0, z + 0.01, 3.55, 1.95, 0.24, LabRgb.{r = 1.6, g = 1.5, b = 1.3}, 1.6);
  // the flow: a beam in and a beam out, a light running along each
  lab_beam(w, lab_v(x0 + 1.95, 2.25, z + 0.015), lab_v(bx - 0.72, 2.25, z + 0.015), 0.06, LAB_CYAN, 1.6, false);
  lab_beam(w, lab_v(bx + 0.72, 2.25, z + 0.015), lab_v(x0 + 4.75, 2.25, z + 0.015), 0.06, LAB_ORANGE, 1.6, false);
  run := now * 0.7 - floor(now * 0.7);
  lab_lamp(w, x0 + 1.95 + (bx - 0.72 - x0 - 1.95) * run, 2.25, z + 0.02, 0.16, LAB_CYAN, 2.2);
  lab_lamp(w, bx + 0.72 + (x0 + 4.75 - bx - 0.72) * run, 2.25, z + 0.02, 0.16, LAB_ORANGE, 2.2);
  // out: the digest, four rows of sixteen digits, appearing as you arrive
  shown := cast(int) lab_clamp((t - 0.5) * 40, 0, 64);
  for r: 0..<4 { a := r * 16; e := a + 16; if e > shown { e = shown; } if e > a { lab_say(w, cast(string) l.first_hex[a..<e], x0, z, 4.85, 2.75 - f32(r) * 0.3, 0.15, LAB_GOLD, 1.2); } }
  lab_say(w, "32 BYTES", x0, z, 4.85, 1.0, 0.17, LAB_GOLD, 1.0);
  lab_say_mid(w, "THE SAME BYTES IN, THE SAME HASH OUT", x0, z, LAB_PANEL_W * 0.5, 0.42, 0.16, LAB_ICE, 0.9);
}
// 6 SHA-256d: SHA-256 of the digest, shown reversed as a block's hash, its zeros against the target.
bw_target :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0]; t := lab_anim(w, i);
  h := 0.19f32; adv := h * 6 / 7; u0 := (LAB_PANEL_W - lab_text_w(32, h)) * 0.5;
  lab_say(w, "BLOCK HASH", x0, z, u0, 3.1, 0.15, LAB_ICE, 0.9);
  lab_say(w, "TARGET", x0, z, u0, 1.85, 0.15, LAB_ICE, 0.9);
  zeros := l.zeros; glow := lab_ease((t - 0.6) / 1.2);
  for r: 0..<2 { for c: 0..<32 {
    at := r * 32 + c; ch := l.hash_hex[at..<at + 1];
    zero := at < zeros;
    lab_say(w, cast(string) ch, x0, z, u0 + f32(c) * adv, 2.75 - f32(r) * 0.3, h, ifx zero then lab_mix(LAB_CYAN, LAB_GREEN, glow) else LAB_CYAN, ifx zero then 1.0 + glow else 0.9);
    tc := l.target_hex[at..<at + 1]; tz := tc[0] == '0';
    lab_say(w, cast(string) tc, x0, z, u0 + f32(c) * adv, 1.5 - f32(r) * 0.3, h, ifx tz then LAB_DIM else LAB_VIOLET, ifx tz then 0.8 else 1.1);
  } }
  b: [64] u8; n := bl_int(b[..], 0, zeros); n = bl_str(b[..], n, " LEADING ZEROS:  HASH  <  TARGET");
  lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 0.42, 0.22, ifx l.valid then LAB_GREEN else LAB_ORANGE, 0.6 + 1.0 * glow);
}
// 7 the chain's sign: which blocks they are.
bw_chain_sign :: (bk: [] BitcoinWalk, i: int, lit: f32) {
  w := bk[0].w[..];
  x0 := lab_left(w, i); z := lab_face(w, i); l := bk[0].lesson[0];
  if l.chain_n == 0 { return; }
  first := LAB_BLOCKS[l.chain[0]].height; last := LAB_BLOCKS[l.chain[l.chain_n - 1]].height;
  b: [48] u8; n := bl_str(b[..], 0, "REGTEST BLOCKS "); n = bl_int(b[..], n, first); n = bl_str(b[..], n, " TO "); n = bl_int(b[..], n, last);
  lab_say_mid(w, cast(string) b[0..<n], x0, z, LAB_PANEL_W * 0.5, 2.55, 0.26, LAB_ICE, 1.1);
  lab_say_mid(w, "EACH NAMES THE HASH", x0, z, LAB_PANEL_W * 0.5, 1.75, 0.3, LAB_ORANGE, 1.3 + lit);
  lab_say_mid(w, "OF THE ONE BEFORE", x0, z, LAB_PANEL_W * 0.5, 1.25, 0.3, LAB_ORANGE, 1.3 + lit);
  lab_say_mid(w, "RECORDED FROM BITCOIN CORE", x0, z, LAB_PANEL_W * 0.5, 0.45, 0.16, LAB_CYAN, 0.8);
}
// The chain: a lit cube for each block, its height and hash on the faces you see, and from each to
// the one before a bar of light labelled with the hash it names.
bw_cube_z :: (k: int) -> f32 { return BW_CHAIN_Z0 - f32(k) * BW_CHAIN_STEP; }
bw_chain :: (bk: [] BitcoinWalk) {
  w := bk[0].w[..];
  l := bk[0].lesson[0]; now := lab_clock(w); hc := BW_CUBE * 0.5; e := w[0].eye;
  for k: 0..<l.chain_n {
    row := LAB_BLOCKS[l.chain[k]]; cz := bw_cube_z(k); cx := f32(BW_CHAIN_X); tip := k == l.chain_n - 1;
    // the link to the block before: behind this cube, toward where you came from
    if k > 0 {
      a := lab_v(cx, BW_LINK_Y, cz + hc); b := lab_v(cx, BW_LINK_Y, cz + BW_CHAIN_STEP - hc);
      lab_group(w, cx, BW_LINK_Y, cz + BW_CHAIN_STEP * 0.5);
      lab_box(w, cx, BW_LINK_Y, cz + BW_CHAIN_STEP * 0.5, 0.05, 0.05, (BW_CHAIN_STEP - BW_CUBE) * 0.5, lab_scale(LAB_ORANGE, 0.22), 0.5, 0.5);
      lab_beam(w, a, b, 0.2, LAB_ORANGE, 0.3, true);
      run := now * 0.45 + f32(k) * 0.13; run = run - floor(run);
      lab_quad(w, QK_GLOW, cx + 0.02, BW_LINK_Y, cz + hc + (BW_CHAIN_STEP - BW_CUBE) * run, lab_v(0, 0, 0.22), 0, lab_v(0, 0.22, 0), 0, LAB_ORANGE, 2.0);
      pb: [24] u8; pn := bl_str(pb[..], 0, "PREV "); for c: 0..<8 { ch := row.previous[c]; pb[pn] = ifx ch >= 'a' && ch <= 'f' then ch - 32 else ch; pn += 1; }
      // along the bar, read from the lane (+x), first letter nearest you
      tw := lab_text_w(pn, 0.2); mid := cz + BW_CHAIN_STEP * 0.5;
      lab_text(w, cast(string) pb[0..<pn], cx + 0.03, BW_LINK_Y + 0.22, mid + tw * 0.5, 0, -1, 0.2, LAB_GOLD, 1.2);
    }
    lab_group(w, cx, hc, cz);
    lab_pool(w, cx + 1.2, cz, 2.6, ifx tip then LAB_ORANGE else LAB_CYAN, 0.16);
    lab_box(w, cx, hc, cz, hc, hc, hc, LabRgb.{r = 0.035, g = 0.08, b = 0.12}, 0.35, ifx tip then 1.9 else 1.2);
    hb: [24] u8; hn := bl_str(hb[..], 0, "#"); hn = bl_int(hb[..], hn, row.height);
    xb: [16] u8; for c: 0..<8 { ch := row.hash[c]; xb[c] = ifx ch >= 'a' && ch <= 'f' then ch - 32 else ch; }
    // the face toward you (+z), and the face toward the lane (+x)
    if e[2] > cz + hc {
      lab_text(w, cast(string) hb[0..<hn], cx - lab_text_w(hn, 0.42) * 0.5, 1.45, cz + hc + 0.02, 1, 0, 0.42, ifx tip then LAB_ORANGE else LAB_ICE, 1.5);
      lab_text(w, cast(string) xb[0..<8], cx - lab_text_w(8, 0.22) * 0.5, 0.75, cz + hc + 0.02, 1, 0, 0.22, LAB_GOLD, 1.2);
    }
    if e[0] > cx + hc {
      lab_text(w, cast(string) hb[0..<hn], cx + hc + 0.02, 1.45, cz + lab_text_w(hn, 0.42) * 0.5, 0, -1, 0.42, ifx tip then LAB_ORANGE else LAB_ICE, 1.5);
      lab_text(w, cast(string) xb[0..<8], cx + hc + 0.02, 0.75, cz + lab_text_w(8, 0.22) * 0.5, 0, -1, 0.22, LAB_GOLD, 1.2);
    }
    if tip { lab_text(w, "TIP", cx - lab_text_w(3, 0.3) * 0.5, BW_CUBE + 0.35, cz, 1, 0, 0.3, LAB_ORANGE, 1.6); }
  }
}
bw_station :: (bk: [] BitcoinWalk, i: int) {
  lit := lab_station(bk[0].w[..], i);
  if i == 0 { bw_byte(bk, i, lit); } else if i == 1 { bw_hex(bk, i, lit); } else if i == 2 { bw_b64(bk, i, lit); }
  else if i == 3 { bw_order(bk, i, lit); } else if i == 4 { bw_sha(bk, i, lit); } else if i == 5 { bw_target(bk, i, lit); } else { bw_chain_sign(bk, i, lit); }
}
bw_list :: (bk: [] BitcoinWalk, u: [] f32) {
  w := bw_conf(bk);
  lab_list_begin(w, u);
  for i: 0..<BW_STATIONS { bw_station(bk, i); }
  bw_chain(bk);
  lab_list_end(w);
}
// Standing the world: the slabs and the towers (lab_stand), and the chain's cubes.
bw_stand :: (bk: [] BitcoinWalk) {
  w := bw_conf(bk);
  _ := bl_ready(bk[0].lesson[..]);
  boxes: [LAB_EXTRA * 6] f32; n := 0;
  for k: 0..<bk[0].lesson[0].chain_n {
    if n >= LAB_EXTRA { break; }
    o := n * 6; hc := BW_CUBE * 0.5; cz := bw_cube_z(k);
    boxes[o] = BW_CHAIN_X - hc; boxes[o + 1] = -0.4; boxes[o + 2] = cz - hc; boxes[o + 3] = BW_CHAIN_X + hc; boxes[o + 4] = BW_CUBE; boxes[o + 5] = cz + hc; n += 1;
  }
  lab_stand(w, boxes[..], n);
}

// ---- the realm: what bitcoin-lab-walk-face.c calls
btc_frame :: (bk: [] BitcoinWalk, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  w := bw_conf(bk); s := w[0].z[..];
  if !s[0].creator[0].on { w[0].quad_n = 0; return 0; }
  if !w[0].stood { bw_stand(bk); }
  n := lab_frame(w, out, u, width, height, dpr, dt, still);
  if u.count >= 32 { bw_list(bk, u); }
  return n;
}
btc_pointer :: (bk: [] BitcoinWalk, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) { return lab_pointer(bw_conf(bk), x, y, phase, kind, id); }
btc_pointer_buttons :: (bk: [] BitcoinWalk, x: f32, y: f32, phase: int, kind: int, id: int, button: int) -> bool #export_c #effects(all) { return lab_pointer_buttons(bw_conf(bk), x, y, phase, kind, id, button); }
// On a local page, ?at=N stands you before station N (1 to 7; 8 the chain's tip) for shots and clips.
btc_message :: (bk: [] BitcoinWalk, kind: int, t: string) #export_c #effects(all) {
  w := bw_conf(bk);
  if !lab_message(w, kind, t) { return; }
  if lab_staged(w, t) == BW_STATIONS + 1 { s := w[0].z[..]; s[0].put_z = bw_cube_z(BL_CHAIN - 1) + 9; s[0].put_x = -1.5; }
}

// ---- checks
bw_test_lab :: (bk: [] BitcoinWalk) {
  w := bw_conf(bk);
  w[0].z[0].creator[0].width = 1280; w[0].z[0].creator[0].height = 720; w[0].z[0].creator[0].scale = 1;
  btc_message(bk, HOST_PAGE, "url=https://openagents.com/worlds/bitcoin-lab\n");
}
#test "bitcoin lab walk: the page stands a level, bare zone and puts you at the lane's start facing down it" #steps 400000000 {
  bk: [1] BitcoinWalk; bw_test_lab(bk[..]); w := bk[0].w[..]; s := w[0].z[..];
  #assert w[0].on && s[0].creator[0].field && s[0].creator[0].flat && s[0].bare && s[0].creator[0].on;
  #assert s[0].put_on && s[0].put_z == w[0].start_z && abs(s[0].put_face - 3.1415927) < 0.001;
  #assert w[0].n == BW_STATIONS && w[0].name[4] == "SHA-256" && w[0].title == "BITCOIN LAB";
  #assert bw_page("url=x\npath=/worlds/bitcoin-lab\n") || !bw_page("path=/worlds/archery-range\n");
}
#test "bitcoin lab walk: every slab and cube is a box you walk round, and none stands on the lane" #steps 400000000 {
  bk: [1] BitcoinWalk; bw_test_lab(bk[..]); bw_stand(bk[..]); w := bk[0].w[..];
  p := w[0].z[0].creator[0].props[0]; #assert p.n == BW_STATIONS + BL_CHAIN + LAB_TOWERS && p.n <= wprops.PROPS;
  for i: 0..<p.n { o := i * 6; #assert p.box[o + 3] <= -LAB_LANE || p.box[o] >= LAB_LANE; #assert p.box[o + 4] > 2; }
  // you stand in the lane's middle with nothing round you; beside a slab, you are inside it
  #assert !wprops.props_inside(p, 0, 1, BW_STATION_Z[0]) && wprops.props_inside(p, lab_left(w, 0) + 1, 1, BW_STATION_Z[0]);
}
#test "bitcoin lab walk: the stations come in order down the lane, the chain after the last" #steps 400000000 {
  bk: [1] BitcoinWalk; w := bw_conf(bk[..]);
  #assert lab_at(w, w[0].start_z) == -1 && lab_at(w, BW_STATION_Z[0] + 8) == 0 && lab_at(w, BW_STATION_Z[3] + 2) == 3 && lab_at(w, BW_STATION_Z[3] - 3) == 4 && lab_at(w, bw_cube_z(5)) == BW_STATIONS - 1;
  for i: 1..<BW_STATIONS { #assert BW_STATION_Z[i] < BW_STATION_Z[i - 1] - 10; #assert BW_STATION_SIDE[i] == 1 || BW_STATION_SIDE[i] == -1; }
  #assert BW_CHAIN_Z0 < BW_STATION_Z[BW_STATIONS - 1];
}
#test "bitcoin lab walk: the frame's quads begin with the sky and the floor and run far to near, in budget" #steps 400000000 {
  bk: [1] BitcoinWalk; bw_test_lab(bk[..]); bw_stand(bk[..]); w := bk[0].w[..];
  u: [64] f32; u[16] = 0; u[17] = 2.5; u[18] = w[0].start_z + 4; w[0].z[0].creator[0].player_z = w[0].start_z;
  bw_list(bk[..], u[..]);
  q := w[0].quads[..]; n := w[0].quad_n;
  #assert n > 200 && n < LAB_QUADS && q[3] == QK_SKY && q[LAB_QF + 3] == QK_FLOOR && w[0].build[0].g_n < LAB_GROUPS;
  // the first group listed after the floor is further than the last
  l := w[0].build[0]; far := -1.0f32; near := 1e9f32;
  for g: 0..<l.g_n { if l.g_d[g] > far { far = l.g_d[g]; } if l.g_d[g] < near { near = l.g_d[g]; } }
  #assert far > near;
  // the lesson's numbers are on the faces: the genesis hash's first digits are among the glyphs
  #assert bk[0].lesson[0].ready && cast(string) bk[0].lesson[0].hash_hex[0..<4] == "0000";
}
