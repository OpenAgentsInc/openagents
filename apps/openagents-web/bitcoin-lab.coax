// Bitcoin Lab: an unlisted, recorded regtest block explorer on the shared Grid.
// The shared Grid session owns walking, fixed steps, input, follow camera and replay.
// The Metaverse Engine's HUD renderer and UI tree own strokes, text, picking and focus.
#load "../../metaverse/gridwalk.coax" as gw;
#load "../../metaverse-engine/core/points.coax";
#load "../../metaverse-engine/ui/draw.coax";
#load "../../metaverse-engine/ui/tree.coax";
#load "../../metaverse-engine/core/budget.coax";
#load "bitcoin-lab-chapters.coax";
#load "bitcoin-lab-blocks.coax";
#load "bitcoin-lab-remote.coax";

LAB_VERTICES :: 72000;
LAB_UNIFORMS :: 88;
LAB_BUDGET :: FrameBudget.{steps=8,vertices=70000,draws=3,bytes=16000000};
LAB_NAMES :: [7]string.["Chain","Transactions / UTXOs","Proof / Script","Node","Mempool / Mining","Wallets","Lightning"];
LAB_SHORT :: [7]string.["Chain","UTXOs","Proof","Node","Mining","Wallets","Lightning"];
LAB_X :: [7]f32.[0,-8,8,-12,12,-8,8];
LAB_Z :: [7]f32.[0,7,7,15,15,23,23];
LAB_NODES :: 160;
BitcoinLab :: struct {
  ready:bool;session:[1]gw.GridWalk;
  w:f32;h:f32;d:f32=1;keys:int;look:f32;
  selected:int;chapter:int;map:bool=true;focus:int=-1;
  nodes:[LAB_NODES]UiNode;count:int;
  pointers:[4]int;press:[4]int;active:[4]bool;
  action:int;out_n:int;outbox:[1024]u8;
  eye:Point;forward:Point;right:Point;up:Point;
  used:int;steps:int;world_vertices:int;
  meter:[1]BudgetMeter;
  explorer:[1]LabExplore;
  remote:[1]LabRemote;
  mesh:[32768]f32;mesh_n:int;draws:[4]u32;
  world_top:f32;world_bottom:f32;world_scale:f32;
  inbox:[LAB_REPLY_MAX]u8;field_box:[4]f32;
  shown:int;
  table_rows:int;table_lines:int;table_text:[8192]u8;table_n:int;
}

#test "Bitcoin Lab has all 125 book states, separate from exercises" {
  counts:[3]int;
  for i:0..<125 {
    c:=LAB_CHAPTERS[i];#assert c.title!="" && c.file!="" && c.station>=0 && c.station<7;
    if c.status=="implemented" {counts[0]+=1;}
    else if c.status=="partly implemented" {counts[1]+=1;}
    else {#assert c.status=="planned";counts[2]+=1;}
    #assert lab_exercise(i)=="not available";
  }
  #assert counts[0]==100 && counts[1]==3 && counts[2]==22;
  #assert LAB_CHAPTERS[81].status=="partly implemented" && LAB_CHAPTERS[89].status=="partly implemented" && LAB_CHAPTERS[90].status=="partly implemented";
}
#test "Bitcoin Lab station, chapter, source and exit navigation stay bounded" {
  s:[1]BitcoinLab;lab_start(s[..]);
  for station:0..<7 {lab_do(s[..],station+1);#assert s[0].selected==station && LAB_CHAPTERS[s[0].chapter].station==station;}
  s[0].chapter=0;lab_do(s[..],8);#assert s[0].chapter==124;
  lab_do(s[..],9);#assert s[0].chapter==0;
  lab_do(s[..],10);#assert s[0].action==1 && lab_out(s[..])=="https://github.com/OpenAgentsInc/openagents/blob/main/bitcoin/book/ch001-bytes-hex-and-base64.md";
  lab_do(s[..],11);#assert lab_out(s[..])=="/worlds";
  lab_do(s[..],12);#assert !s[0].map;
}
#test "Bitcoin Lab keyboard and touch selection never leave walking held" {
  s:[1]BitcoinLab;lab_start(s[..]);lab_layout(s[..],390,844,1);
  #assert ui_check(s[0].nodes[0..<s[0].count]).reason==UI_OK;
  #assert lab_key(s[..],119,true,0) && s[0].keys==1;
  #assert lab_key(s[..],-15,true,0) && s[0].keys==0 && s[0].focus>=0;
  #assert lab_key(s[..],-2,true,0) && s[0].keys==0;
  b:=s[0].nodes[1].box;
  #assert lab_pointer(s[..],b.x+2,b.y+2,0,1,81);
  #assert !s[0].session[0].thumbs.move_on && !s[0].session[0].thumbs.look_on;
  #assert lab_pointer(s[..],b.x+2,b.y+2,2,1,81) && s[0].selected==1;
  #assert lab_pointer(s[..],30,660,0,1,82);
  #assert !s[0].session[0].thumbs.move_on;
  #assert lab_pointer(s[..],30,660,3,1,82);
  lab_blur(s[..]);#assert s[0].keys==0 && !s[0].active[0];
}
#test "Bitcoin Lab walks from spawn to chain and back on the replayable Grid session" {
  s:[1]BitcoinLab;lab_start(s[..]);
  for i:0..<128 {gw.gridwalk_frame(s[0].session[..],0,1,true,false,0,0,0,1440,900,1,1.0/64.0,false);}
  feet:=gw.gridwalk_feet(s[0].session[..]);#assert feet.z> -1.5 && feet.z<1 && abs(feet.x)<0.01;
  for i:0..<128 {gw.gridwalk_frame(s[0].session[..],0,-1,true,false,0,0,0,1440,900,1,1.0/64.0,false);}
  feet=gw.gridwalk_feet(s[0].session[..]);#assert feet.z< -6 && feet.z> -9;
  again:[1]gw.GridWalk;#assert gw.gridwalk_replay(s[0].session[..],again[..]);
}
#test "Bitcoin Lab desktop and phone frames fit declared buffers and touch targets" #steps 100000000 {
  s:[1]BitcoinLab;out:[LAB_VERTICES*12]f32;u:[LAB_UNIFORMS]f32;
  for d:[3]f32.[1,2,3] {
    n:=lab_frame(s[..],out[..],u[..],390*d,844*d,d,0.016,true);
    #assert n>0 && n<=LAB_BUDGET.vertices && n%6==0;
    #assert budget_ok(s[0].meter[0]);
    for i:0..<7 {b:=s[0].nodes[i].box;#assert b.width>=44 && b.height>=44 && b.x>=0 && b.x+b.width<=390;}
  }
  n:=lab_frame(s[..],out[..],u[..],1440,900,1,0.25,false);
  #assert n<=LAB_BUDGET.vertices && s[0].steps<=LAB_BUDGET.steps;
  #assert budget_ok(s[0].meter[0]);
  #assert budget_declared(LAB_BUDGET,LAB_VERTICES)==BUDGET_NONE;
  #assert budget_arena_bytes(size_of(BitcoinLab),LAB_VERTICES,12,LAB_UNIFORMS)<=LAB_BUDGET.bytes;
}
#test "Bitcoin Lab share routes and pasted searches retain exact occurrences across reorgs" {
  s:[1]BitcoinLab;lab_start(s[..]);lab_do(s[..],202);lab_do(s[..],205);
  text:="e97304753dd67dc61b2f1ba8d782e19f0ae9b596729ed868428f076061267d35";
  for i:0..<text.count {s[0].inbox[i]=text[i];}lab_message(s[..],1,text.count);
  #assert lab_key(s[..],-2,true,0) && s[0].explorer[0].tx>=0 && LAB_BLOCKS[s[0].explorer[0].block].active;
  lab_do(s[..],214);#assert s[0].action==3 && s[0].out_n==139;
  other:[1]BitcoinLab;for i:0..<139 {other[0].inbox[i]=s[0].outbox[i];}lab_hash(other[..],139);
  #assert other[0].explorer[0].phase==2 && other[0].explorer[0].tx==s[0].explorer[0].tx;
  lab_do(s[..],213);#assert LAB_TXS[s[0].explorer[0].tx].order==2;
  lab_do(s[..],201);lab_do(s[..],205);
  for i:0..<text.count {s[0].inbox[i]=text[i];}lab_message(s[..],1,text.count);#assert lab_key(s[..],-2,true,0);
  #assert LAB_BLOCKS[s[0].explorer[0].block].active;
  lab_do(s[..],206);lab_do(s[..],208);#assert LAB_BLOCKS[s[0].explorer[0].block].height==100;
}
#test "Bitcoin Lab solid meshes fit short phones and every reorg viewport" #steps 100000000 {
  s:[1]BitcoinLab;out:[LAB_VERTICES*12]f32;u:[LAB_UNIFORMS]f32;
  for phase:0..<3 {for screen:0..<3 {
    lab_start(s[..]);lab_do(s[..],200+phase);
    n:=lab_frame(s[..],out[..],u[..],[3]f32.[320,390,1440][screen],[3]f32.[568,844,900][screen],1,0,false);
    #assert n>0 && budget_ok(s[0].meter[0]) && s[0].mesh_n>=216 && s[0].mesh_n<=4096 && s[0].world_scale>0;
    #assert s[0].draws[1]==cast(u32)s[0].mesh_n && s[0].draws[2]==0x80000000 && s[0].draws[3]==1;
    for f:s[0].mesh[0..<s[0].mesh_n*8] {#assert f==f && abs(f)<1000000;}
  }}
  s[0].map=true;used:=lab_frame(s[..],out[..],u[..],320,568,1,0,false);
  #assert used>0 && s[0].world_scale>0 && lab_scene_ready(s[..]) && budget_ok(s[0].meter[0]);
}
#test "Bitcoin Lab script text stops at the inspector's visible bound" {
  s:[1]BitcoinLab;s[0].w=1440;text:[65536]u8;for i:0..<text.count {text[i]='0';}out:[LAB_VERTICES*12]f32;
  n:=lab_identifier(s[..],out[..],0,cast(string)text[..],20,HdPen.{d=1,top=0,bottom=60,cyan=true});#assert n>0 && n<10000;
}

lab_exercise :: (chapter:int)->string {return "not available";}
lab_start :: (s:[]BitcoinLab) {
  if s[0].ready {return;}s[0].ready=true;s[0].map=false;s[0].focus=-1;lb_start(s[0].explorer[..]);
  gw.gridwalk_place(s[0].session[..],0,-7,0,1.08,9);
  s[0].meter[0]=budget_meter(LAB_BUDGET);
  s[0].chapter=45;
}
lab_out :: (s:[]BitcoinLab)->string {return cast(string)s[0].outbox[0..<s[0].out_n];}
lab_send :: (s:[]BitcoinLab,text:string) {
  s[0].out_n=0;
  for c:text {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}
  s[0].action=1;
}
lab_stop :: (s:[]BitcoinLab) {s[0].keys=0;s[0].look=0;gw.gridwalk_blur(s[0].session[..]);}
lab_blur :: (s:[]BitcoinLab) #export_c #effects(all) {
  lab_stop(s);for i:0..<4 {s[0].active[i]=false;}
}
lab_do :: (s:[]BitcoinLab,action:int) {
  lab_stop(s);
  if action>=220 && action<=222 {lr_select(s[0].remote[..],action-220,s[0].explorer[0].phase);s[0].map=false;return;}
  if s[0].remote[0].active && lab_remote_do(s,action) {return;}
  e:=s[0].explorer[..];
  if action>=4000 && e[0].tx>=0 {index:=action-4000;if index<LAB_TXS[e[0].tx].no {e[0].output=index;}return;}
  if action>=3000 && e[0].tx>=0 {
    tx:=LAB_TXS[e[0].tx];i:=action-3000;if i>=tx.ni {return;}input:=LAB_INPUTS[tx.input+i];
    parent:=lb_parent_tx(e[0].phase,tx.block,input.txid,tx.order);if parent>=0 {lb_select(e,LAB_TXS[parent].block);e[0].tx=parent;e[0].output=input.vout;}return;
  }
  if action>=2000 {index:=action-2000;if index>=LAB_TXS.count {return;}b:=LAB_TXS[index].block;snap:=LAB_SNAPSHOTS[e[0].phase];if b<snap.first || b>=snap.first+snap.count {return;}lb_select(e,b);e[0].tx=index;return;}
  if action>=1000 {lb_select(e,action-1000);s[0].map=false;return;}
  if action>=200 && action<=202 {lb_phase(e,action-200);e[0].playing=false;return;}
  if action==203 {e[0].playing=!e[0].playing;return;}
  if action==204 {lb_phase(e,(e[0].phase+1)%3);return;}
  if action==205 {e[0].search=!e[0].search;e[0].n=0;e[0].miss=false;return;}
  if action==214 {
    s[0].out_n=0;
    for c:"regtest/" {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}
    s[0].outbox[s[0].out_n]=cast(u8)(48+e[0].phase);s[0].out_n+=1;s[0].outbox[s[0].out_n]='/';s[0].out_n+=1;
    for c:LAB_BLOCKS[e[0].block].hash {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}
    if e[0].tx>=0 {s[0].outbox[s[0].out_n]='/';s[0].out_n+=1;for c:LAB_TXS[e[0].tx].txid {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}}
    s[0].action=3;return;
  }
  if action==206 {e[0].tx=-1;return;}
  if action==207 {e[0].tx=LAB_BLOCKS[e[0].block].tx;e[0].output=0;return;}
  if action==208 || action==209 {
    row:=LAB_BLOCKS[e[0].block];height:=row.height+(ifx action==208 then -1 else 1);b:=lb_height(e[0].phase,height);
    if b>=0 {lb_select(e,b);}return;
  }
  if action==210 || action==211 {
    row:=LAB_BLOCKS[e[0].block];if e[0].tx<0 {e[0].tx=row.tx;}
    else {e[0].tx=row.tx+(e[0].tx-row.tx+(ifx action==210 then row.count-1 else 1))%row.count;}e[0].output=0;return;
  }
  if action==212 && e[0].tx>=0 {e[0].output=(e[0].output+1)%LAB_TXS[e[0].tx].no;return;}
  if action==213 && e[0].tx>=0 {
    out:=LAB_OUTPUTS[LAB_TXS[e[0].tx].output+e[0].output];block:=lb_block(e[0].phase,out.spend_block);
    if block>=0 {row:=LAB_BLOCKS[block];for t:row.tx..<row.tx+row.count {if LAB_TXS[t].txid==out.spend {lb_select(e,block);e[0].tx=t;break;}}}return;
  }
  if action>=1 && action<=7 {
    s[0].selected=action-1;s[0].map=true;
    for i:0..<125 {if LAB_CHAPTERS[i].station==s[0].selected {s[0].chapter=i;break;}}
  }
  if action==8 || action==9 {
    s[0].chapter=(s[0].chapter+(ifx action==8 then 124 else 1))%125;
    s[0].selected=LAB_CHAPTERS[s[0].chapter].station;
  }
  if action==10 {
    prefix:="https://github.com/OpenAgentsInc/openagents/blob/main/bitcoin/book/";
    s[0].out_n=0;
    for c:prefix {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}
    for c:LAB_CHAPTERS[s[0].chapter].file {s[0].outbox[s[0].out_n]=c;s[0].out_n+=1;}
    s[0].action=1;
  }
  if action==11 {lab_send(s,"/worlds");}
  if action==12 {s[0].map=!s[0].map;}
}
lab_node :: (s:[]BitcoinLab,b:HudBox,action:int) {
  i:=s[0].count;if i>=LAB_NODES {return;}
  s[0].nodes[i]=UiNode.{box=b,role=UI_BUTTON,label=action,action=action};s[0].count+=1;
}
lab_layout :: (s:[]BitcoinLab,w:f32,h:f32,d:f32) {
  s[0].w=w;s[0].h=h;s[0].d=d;s[0].count=0;
  cols:=ifx w<700 then 3 else 7;cw:=(w-32)/cast(f32)cols;
  if !s[0].remote[0].active || s[0].map {for i:0..<7 {lab_node(s,HudBox.{x=16+cast(f32)(i%cols)*cw,y=124+cast(f32)(i/cols)*48,width=cw-4,height=44},i+1);}}
  for i:0..<3 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/3,y=76,width=(w-32)/3-4,height=44},220+i);}
  bottom:=h-194;
  if s[0].map {
    for i:0..<3 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/3,y=h-82,width=(w-32)/3-4,height=44},i+8);}
  }
  lab_node(s,HudBox.{x=w-96,y=16,width=80,height=44},11);
  lab_node(s,HudBox.{x=ifx w<360 then w-96 else w-180,y=ifx w<360 then h-230 else 16,width=76,height=44},12);
  if !s[0].map {
    if s[0].remote[0].active {
      for row:0..<4 {if row==3 && h<700 {continue;}for i:0..<(ifx row==3 then 6 else 5) {action:=ifx i==5 then 240 else [20]int.[232,224,225,205,231,235,236,229,230,234,233,238,237,243,244,200,201,202,203,204][row*5+i];
        if row==3 && i<5 && s[0].remote[0].model[0].source!=1 {action=[5]int.[226,223,227,228,239][i];}
        row_cols:=ifx row==3 then 6.0f32 else 5.0f32;lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/row_cols,y=h-76-cast(f32)row*48,width=(w-32)/row_cols-4,height=44},action);
      }}
      for i:0..<5 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/5,y=124,width=(w-32)/5-4,height=44},[5]int.[226,223,227,228,239][i]);}
      return;
    }
    for i:0..<5 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/5,y=h-76,width=(w-32)/5-4,height=44},200+i);}
    for i:0..<5 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/5,y=h-124,width=(w-32)/5-4,height=44},[5]int.[208,209,205,ifx s[0].explorer[0].tx<0 then 207 else 206,214][i]);}
    if s[0].explorer[0].tx>=0 {for i:0..<4 {lab_node(s,HudBox.{x=16+cast(f32)i*(w-32)/4,y=h-172,width=(w-32)/4-4,height=44},[4]int.[210,211,212,213][i]);}}
  }
}
lab_key :: (s:[]BitcoinLab,key:int,down:bool,mods:int)->bool #export_c #effects(all) {
  lab_start(s);bit:=0;
  if s[0].remote[0].active && s[0].remote[0].search {
    r:=s[0].remote[..];if !down {return true;}if key== -1 {r[0].search=false;return true;}
    if key== -2 {r[0].search=false;lr_query(r,7,cast(string)r[0].query[0..<r[0].qn],0);return true;}
    if key== -3 || key==8 {if r[0].qn>0 {r[0].qn-=1;}return true;}
    if key>=33 && key<=126 && r[0].qn<256 {r[0].query[r[0].qn]=cast(u8)key;r[0].qn+=1;}return true;
  }
  e:=s[0].explorer[..];
  if e[0].search {
    if !down {return true;}
    if key== -1 {e[0].search=false;return true;}
    if key== -2 {e[0].miss=!lb_find(e,cast(string)e[0].query[0..<e[0].n]);e[0].search=false;return true;}
    if key== -3 || key==8 {if e[0].n>0 {e[0].n-=1;}return true;}
    if key>=32 && key<=126 && e[0].n<128 {e[0].query[e[0].n]=cast(u8)key;e[0].n+=1;}return true;
  }
  if key==119 || key==87 {bit=1;}if key==115 || key==83 {bit=2;}
  if key==97 || key==65 {bit=4;}if key==100 || key==68 {bit=8;}
  if key==32 {bit=16;}if key== -13 {bit=32;}
  if bit!=0 {
    if down && s[0].focus<0 {s[0].keys|=bit;}else {s[0].keys=(s[0].keys|bit)-bit;}return true;
  }
  if !down {return false;}
  if s[0].remote[0].active && !s[0].map {
    if key== -10 || key== -11 {lab_do(s,ifx key== -10 then 243 else 244);return true;}
    if key== -3 || key==8 {lab_do(s,232);return true;}
    if key==98 || key==66 {lab_do(s,238);return true;}
    if key==116 || key==84 {lab_do(s,231);return true;}
    if key==112 || key==80 {lab_do(s,203);return true;}
    if key==118 || key==86 {lab_do(s,240);return true;}
  }
  if key==47 {lab_do(s,205);return true;}
  if key==91 {lab_do(s,208);return true;}if key==93 {lab_do(s,209);return true;}
  if key==114 || key==82 {lab_do(s,204);return true;}
  if key== -15 {lab_stop(s);s[0].focus=ui_focus_next(s[0].nodes[0..<s[0].count],s[0].focus,(mods&1)!=0,UI_NONE);return true;}
  if key== -2 && s[0].focus>=0 {lab_do(s,ui_activate(s[0].nodes[0..<s[0].count],s[0].focus,UI_NONE));return true;}
  if key>=49 && key<=55 {lab_do(s,key-48);return true;}
  if key== -10 || key== -11 {lab_do(s,ifx key== -10 then 8 else 9);return true;}
  if key==109 || key==77 {lab_do(s,12);return true;}
  if key== -1 {if s[0].focus>=0 {s[0].focus=-1;}else {lab_do(s,11);}return true;}
  if key==110 || key==78 {lab_do(s,(s[0].selected+1)%7+1);return true;}
  if key== -4 {s[0].look+=0.12;return true;}if key== -5 {s[0].look-=0.12;return true;}
  return false;
}
lab_pointer :: (s:[]BitcoinLab,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c #effects(all) {
  lab_start(s);cx:=x/s[0].d;cy:=y/s[0].d;slot:=-1;
  for i:0..<4 {if s[0].active[i] && s[0].pointers[i]==id {slot=i;}}
  if phase==0 {
    for i:0..<4 {if !s[0].active[i] {slot=i;break;}}
    if slot<0 {return false;}
    s[0].active[slot]=true;s[0].pointers[slot]=id;
    s[0].press[slot]=ui_tap(s[0].nodes[0..<s[0].count],cx,cy,UI_NONE);
    bottom:=ifx s[0].world_bottom>0 then s[0].world_bottom else s[0].h-364;
    top:=ifx s[0].world_top>0 then s[0].world_top else ifx s[0].w<700 then 284.0f32 else 156.0f32;
    if s[0].press[slot]==0 && (cy<top || cy>=bottom) {s[0].press[slot]=-1;}
    s[0].focus=-1;
    if s[0].press[slot]!=0 {lab_stop(s);}
  }
  if slot<0 {return false;}
  action:=s[0].press[slot];
  if action!=0 {
    if action>0 && phase==2 && ui_tap(s[0].nodes[0..<s[0].count],cx,cy,UI_NONE)==action {lab_do(s,action);}
  }else {gw.gridwalk_touch(s[0].session[..],slot,phase,x,y);}
  if phase==2 || phase==3 {s[0].active[slot]=false;}
  return true;
}
// Perspective projection of the shared follow shot; the mesh is a bounded wire fixture.
LabPoint :: struct {x:f32;y:f32;depth:f32;}
lab_project :: (s:[]BitcoinLab,p:Point)->LabPoint {
  rel:=sub(p,s[0].eye);depth:=dot(rel,s[0].forward);
  if depth<=0.2 {return LabPoint.{depth=depth};}
  scale:=s[0].world_scale;
  return LabPoint.{x=s[0].w*0.5+dot(rel,s[0].right)*scale/depth,y=s[0].world_top*0.3+s[0].world_bottom*0.7-dot(rel,s[0].up)*scale/depth,depth=depth};
}
lab_line :: (s:[]BitcoinLab,out:[]f32,n:int,a:Point,b:Point,pen:HdPen,kind:int)->int {
  p:=lab_project(s,a);q:=lab_project(s,b);
  if p.depth<=0.2 || q.depth<=0.2 {return n;}
  if abs(p.x)>s[0].w*4 || abs(q.x)>s[0].w*4 {return n;}
  return hd_line(out,n,p.x,p.y,q.x,q.y,pen,kind,0.7);
}
lab_cube :: (s:[]BitcoinLab,out:[]f32,n:int,x:f32,y:f32,z:f32,r:f32,pen:HdPen,kind:int)->int {
  at:=n;
  for i:0..<8 {
    a:=v3(x+(ifx (i&1)==0 then -r else r),y+(ifx (i&2)==0 then 0.0f32 else r*2),z+(ifx (i&4)==0 then -r else r));
    for bit:[3]int.[1,2,4] {if (i&bit)==0 {
      j:=i|bit;b:=v3(x+(ifx (j&1)==0 then -r else r),y+(ifx (j&2)==0 then 0.0f32 else r*2),z+(ifx (j&4)==0 then -r else r));
      at=lab_line(s,out,at,a,b,pen,kind);
    }}
  }
  return at;
}
lab_mesh_vertex :: (s:[]BitcoinLab,p:Point,c:Point) {
  if s[0].mesh_n>=4096 {return;}rel:=sub(p,s[0].eye);depth:=dot(rel,s[0].forward);at:=s[0].mesh_n*8;
  s[0].mesh[at]=2*dot(rel,s[0].right)*s[0].world_scale/s[0].w;
  s[0].mesh[at+1]=2*dot(rel,s[0].up)*s[0].world_scale/s[0].h+(1-(s[0].world_top*0.6+s[0].world_bottom*1.4)/s[0].h)*depth;
  s[0].mesh[at+2]=160.0/159.8*(depth-0.2);s[0].mesh[at+3]=depth;
  s[0].mesh[at+4]=c.x;s[0].mesh[at+5]=c.y;s[0].mesh[at+6]=c.z;s[0].mesh[at+7]=1;s[0].mesh_n+=1;
}
lab_slab :: (s:[]BitcoinLab,x:f32,y:f32,z:f32,rx:f32,ry:f32,rz:f32,colour:Point) {
  #assert s[0].mesh_n+36<=4096;
  corners:[8]Point;for i:0..<8 {corners[i]=v3(x+(ifx (i&1)==0 then -rx else rx),y+(ifx (i&2)==0 then 0.0f32 else ry),z+(ifx (i&4)==0 then -rz else rz));}
  faces:=[36]int.[0,1,3,0,3,2,4,6,7,4,7,5,0,4,5,0,5,1,2,3,7,2,7,6,0,2,6,0,6,4,1,5,7,1,7,3];
  for i:0..<36 {light:=[6]f32.[0.70,0.58,0.45,1,0.64,0.82][i/6];lab_mesh_vertex(s,corners[faces[i]],times(colour,light));}
}
lab_draw_blocks :: (s:[]BitcoinLab,out:[]f32,n:int,pen:HdPen)->int {
  if s[0].remote[0].active {return lab_remote_draw(s,out,n,pen);}
  at:=n;e:=s[0].explorer[..];snap:=LAB_SNAPSHOTS[e[0].phase];selected:=LAB_BLOCKS[e[0].block];s[0].shown=0;
  visible:=ifx s[0].w<700 then 6 else 10;low:=selected.height-visible/2;if low<0 {low=0;}if low+visible>snap.height+1 {low=snap.height+1-visible;if low<0 {low=0;}}
  for b:snap.first..<snap.first+snap.count {
    row:=LAB_BLOCKS[b];if row.height<low || row.height>=low+visible {continue;}
    s[0].shown+=1;
    x:=(cast(f32)(row.height-low)-cast(f32)(visible-1)*0.5)*1.5;z:=ifx row.active then 1.5f32 else 5.0f32;
    colour:=ifx b==e[0].block then v3(1,0.48,0.12) else ifx row.active then v3(0.12,0.53,0.72) else v3(0.55,0.24,0.08);
    lab_slab(s,x,0.5,z,0.63,0.85,0.34,colour);
    if row.active && row.height>low {at=lab_line(s,out,at,v3(x-0.87,0.8,z),v3(x-0.63,0.8,z),pen,2);}
    p:=lab_project(s,v3(x,0.9,z));
    if p.depth>0.2 && p.x>=24 && p.x<s[0].w-24 && p.y>=pen.top+22 && p.y<pen.bottom-22 {
      box:=HudBox.{x=p.x-23,y=p.y-22,width=46,height=44};lab_node(s,box,1000+b);
      at=hd_panel(out,at,box,pen,b==e[0].block);buf:[32]u8;k:=lab_decimal(buf[..],row.height);
      at=hd_text_fit(out,at,cast(string)buf[0..<k],box.x+6,box.y+27,12,34,pen,ifx row.active then 0 else 2);
    }
  }
  // Transaction tiles belong to the selected block only. Their width is
  // proportional to weight, with a declared 12% visibility floor.
  if e[0].tx>=0 {
    row:=LAB_BLOCKS[e[0].block];largest:=1;for t:row.tx..<row.tx+row.count {if LAB_TXS[t].weight>largest {largest=LAB_TXS[t].weight;}}
    for j:0..<row.count {
      t:=row.tx+j;width:=hi(0.12f32,cast(f32)LAB_TXS[t].weight/cast(f32)largest);
      lab_slab(s,(cast(f32)j-cast(f32)(row.count-1)*0.5)*2,0.5,-1.8,0.8*width,0.28,0.4,ifx t==e[0].tx then v3(1,0.62,0.18) else v3(0.1,0.6,0.45));
      p:=lab_project(s,v3((cast(f32)j-cast(f32)(row.count-1)*0.5)*2,1.0,-1.8));
      if p.depth>0.2 && p.y>pen.top+22 && p.y<pen.bottom-22 && p.x>=24 && p.x<s[0].w-24 {
        box:=HudBox.{x=p.x-23,y=p.y-22,width=46,height=44};lab_node(s,box,2000+t);at=hd_panel(out,at,box,pen,t==e[0].tx);
        at=hd_text(out,at,"T",box.x+6,box.y+27,11,pen,1);at=lab_number_at(out,at,j,box.x+22,box.y+27,12,pen,0);
      }
    }
    tx:=LAB_TXS[e[0].tx];
    for i:0..<tx.ni {
      x:=(cast(f32)i-cast(f32)(tx.ni-1)*0.5)*1.8;lab_slab(s,x,0.45,0.1,0.4,0.22,0.25,v3(0.58,0.5,0.24));
      at=lab_line(s,out,at,v3(x,0.6,-0.15),v3(0,0.6,-1.4),pen,2);p:=lab_project(s,v3(x,0.9,0.1));
      if p.depth>0.2 && p.y>pen.top+22 && p.y<pen.bottom-22 && p.x>=24 && p.x<s[0].w-24 {
        box:=HudBox.{x=p.x-23,y=p.y-22,width=46,height=44};lab_node(s,box,3000+i);at=hd_panel(out,at,box,pen,false);
        at=hd_text(out,at,"I",box.x+6,box.y+27,11,pen,1);at=lab_number_at(out,at,i,box.x+22,box.y+27,12,pen,0);
      }
    }
    for o:0..<tx.no {
      x:=(cast(f32)o-cast(f32)(tx.no-1)*0.5)*1.8;output:=LAB_OUTPUTS[tx.output+o];
      colour:=ifx output.status=="unspent" then v3(0.1,0.65,0.35) else ifx output.status=="stale" then v3(0.5,0.25,0.08) else v3(0.42,0.22,0.42);
      lab_slab(s,x,0.35,-4.6,0.48,0.25,0.3,colour);
      at=lab_line(s,out,at,v3(0,0.6,-2.2),v3(x,0.5,-4.3),pen,2);
      p:=lab_project(s,v3(x,0.8,-4.6));
      if p.depth>0.2 && p.y>pen.top+22 && p.y<pen.bottom-22 && p.x>=24 && p.x<s[0].w-24 {
        box:=HudBox.{x=p.x-23,y=p.y-22,width=46,height=44};lab_node(s,box,4000+o);at=hd_panel(out,at,box,pen,o==e[0].output);at=hd_text(out,at,"O",box.x+6,box.y+27,11,pen,1);at=lab_number_at(out,at,o,box.x+22,box.y+27,12,pen,0);
      }
    }
  }
  return at;
}
lab_number_at :: (out:[]f32,n:int,value:int,x:f32,y:f32,size:f32,pen:HdPen,kind:int)->int {
  buf:[32]u8;count:=lab_decimal(buf[..],value);return hd_text(out,n,cast(string)buf[0..<count],x,y,size,pen,kind);
}
lab_identifier :: (s:[]BitcoinLab,out:[]f32,n:int,text:string,y:f32,pen:HdPen)->int {
  at:=n;step:=ifx s[0].w<700 then 32 else 64;
  for i:0..<(text.count+step-1)/step {if y+cast(f32)i*16>pen.bottom {break;}a:=i*step;b:=a+step;if b>text.count {b=text.count;}at=hd_text(out,at,text[a..<b],16,y+cast(f32)i*16,11,pen,0);}return at;
}
lab_inspector :: (s:[]BitcoinLab,out:[]f32,n:int,pen:HdPen)->int {
  if s[0].remote[0].active {return lab_remote_inspector(s,out,n,pen);}
  at:=n;e:=s[0].explorer[..];row:=LAB_BLOCKS[e[0].block];snap:=LAB_SNAPSHOTS[e[0].phase];phone:=s[0].w<700;
  y:=s[0].world_bottom+24;line:=ifx phone then 32.0f32 else 16.0f32;
  if e[0].search {
    at=hd_text(out,at,"SEARCH HEIGHT / HASH / TXID / ADDRESS",16,y,12,pen,2);
    at=hd_text_fit(out,at,cast(string)e[0].query[0..<e[0].n],16,y+28,13,s[0].w-32,pen,0);
    return hd_text_fit(out,at,"Type or paste an identifier; Enter selects, Esc cancels.",16,y+52,11,s[0].w-32,pen,1);
  }
  if s[0].h<700 {
    at=hd_text(out,at,"BLOCK",16,y,12,pen,2);at=lab_number_at(out,at,row.height,72,y,12,pen,0);
    at=hd_text(out,at,ifx row.active then "ACTIVE" else "STALE",132,y,11,pen,2);
    return lab_identifier(s,out,at,row.hash,y+18,pen);
  }
  if phone {
    if e[0].tx<0 {
      at=hd_text(out,at,"BLOCK",16,y,12,pen,2);at=lab_number_at(out,at,row.height,76,y,12,pen,0);at=hd_text(out,at,ifx row.active then "ACTIVE" else "STALE",150,y,11,pen,2);
      at=lab_identifier(s,out,at,row.hash,y+20,pen);at=hd_text(out,at,"TRANSACTIONS",16,y+60,11,pen,1);return lab_number_at(out,at,row.count,150,y+60,11,pen,0);
    }
    tx:=LAB_TXS[e[0].tx];output:=LAB_OUTPUTS[tx.output+e[0].output];at=lab_identifier(s,out,at,tx.txid,y,pen);y+=38;
    at=hd_text(out,at,"OUT",16,y,11,pen,1);at=lab_number_at(out,at,e[0].output,52,y,11,pen,0);at=lab_number_at(out,at,output.value_sat,94,y,11,pen,0);at=hd_text(out,at,"SAT",220,y,11,pen,1);
    at=hd_text(out,at,ifx output.status=="unspent" && tx.order==0 && row.height+100>snap.height then "immature" else output.status,16,y+22,11,pen,2);
    return lab_identifier(s,out,at,output.script_hex,y+44,pen);
  }
  if e[0].tx<0 {
    at=hd_text(out,at,"BLOCK",16,y,14,pen,2);at=lab_number_at(out,at,row.height,76,y,14,pen,0);
    at=hd_text(out,at,ifx row.active then "ACTIVE" else "STALE",150,y,12,pen,ifx row.active then 0 else 2);
    at=lab_identifier(s,out,at,row.hash,y+20,pen);y+=line+36;
    at=hd_text(out,at,"TX",16,y,11,pen,1);at=lab_number_at(out,at,row.count,38,y,12,pen,0);
    at=hd_text(out,at,"BYTES",88,y,11,pen,1);at=lab_number_at(out,at,row.size,132,y,12,pen,0);
    at=hd_text(out,at,"WU",206,y,11,pen,1);at=lab_number_at(out,at,row.weight,232,y,12,pen,0);
    at=hd_text(out,at,"HEADER UNIX TIME",16,y+22,11,pen,1);at=lab_number_at(out,at,row.time,146,y+22,11,pen,0);
    at=hd_text(out,at,"CHAINWORK",16,y+44,11,pen,1);at=lab_identifier(s,out,at,row.chainwork,y+62,pen);
    fees:=0;for t:row.tx+1..<row.tx+row.count {f:=lb_fee(e[0].phase,t);if f<0 {fees=-1;break;}fees+=f;}
    bottom:=y+line+83;
    at=hd_text(out,at,"SUBSIDY 5000000000 SAT / FEES",16,bottom,10,pen,1);
    if fees>=0 {at=lab_number_at(out,at,fees,256,bottom,10,pen,0);}else {at=hd_text(out,at,"UNKNOWN",256,bottom,10,pen,1);}
    at=hd_text_fit(out,at,"Equal slabs: 1 block each. Blue active / amber stale. Select a slab or use < >.",16,bottom+21,10,s[0].w-32,pen,1);
  }else {
    tx:=LAB_TXS[e[0].tx];output:=LAB_OUTPUTS[tx.output+e[0].output];
    at=hd_text(out,at,"TRANSACTION",16,y,13,pen,2);at=lab_number_at(out,at,tx.order,144,y,13,pen,0);
    at=lab_identifier(s,out,at,tx.txid,y+19,pen);y+=line+32;
    at=hd_text(out,at,"WU",16,y,10,pen,1);at=lab_number_at(out,at,tx.weight,40,y,11,pen,0);
    fee:=lb_fee(e[0].phase,e[0].tx);at=hd_text(out,at,ifx tx.order==0 then "COINBASE" else "FEE SAT",112,y,10,pen,1);
    if fee>=0 {at=lab_number_at(out,at,fee,184,y,11,pen,0);}
    at=hd_text(out,at,"OUT",16,y+22,10,pen,1);at=lab_number_at(out,at,e[0].output,48,y+22,11,pen,0);
    at=lab_number_at(out,at,output.value_sat,80,y+22,11,pen,0);at=hd_text(out,at,"SAT",184,y+22,10,pen,1);
    status:=ifx output.status=="unspent" && tx.order==0 && row.height+100>snap.height then "immature" else output.status;
    at=hd_text(out,at,status,224,y+22,11,pen,2);
    at=hd_text(out,at,"SCRIPT",16,y+43,10,pen,1);at=lab_identifier(s,out,at,output.script_hex,y+61,pen);
    at=hd_text_fit(out,at,ifx output.address=="" then "No standard address for this script." else output.address,16,y+line+82,10,s[0].w-32,pen,0);
    at=hd_text_fit(out,at,"Tile width = relative weight (12% floor). Exact outputs; no ownership inference.",16,y+line+103,10,s[0].w-32,pen,1);
  }
  if e[0].miss {at=hd_text_fit(out,at,"Identifier unavailable in this bounded recording.",16,s[0].h-168,11,s[0].w-32,pen,2);}
  return at;
}
lab_frame :: (s:[]BitcoinLab,out:[]f32,u:[]f32,w:f32,h:f32,d:f32,dt:f32,still:bool)->int #export_c #effects(all) {
  lab_start(s);if !(d>0) || !(w>0) || !(h>0) || u.count<LAB_UNIFORMS {return 0;}
  e:=s[0].explorer[..];
  lr_frame(s[0].remote[..],dt);
  lbr_frame(s[0].remote[0].replay[..],dt);
  if s[0].remote[0].active && s[0].remote[0].replay[0].playing && s[0].remote[0].model[0].ready {
    s[0].remote[0].replay[0].clock+=lo(dt,0.25f32);if s[0].remote[0].replay[0].clock>=6 {lr_phase(s[0].remote[..],(s[0].remote[0].model[0].phase+1)%3);}
  }
  if e[0].playing {e[0].clock+=lo(dt,0.25f32);if e[0].clock>=6 {lb_phase(e,(e[0].phase+1)%3);}}
  if !s[0].remote[0].table {s[0].table_n=0;}
  lab_layout(s,w/d,h/d,d);
  s[0].world_top=ifx s[0].w<700 then 332.0f32 else 204.0f32;
  s[0].world_bottom=ifx s[0].map then s[0].h-246 else s[0].h-(ifx s[0].h<700 then 190.0f32 else ifx e[0].tx<0 then 364.0f32 else 430.0f32);
  if s[0].map && s[0].h<700 {s[0].world_bottom=s[0].h-190;}
  if s[0].w<700 && s[0].h>=700 {s[0].world_bottom+=48;}
  if s[0].remote[0].active && s[0].remote[0].kind!=2 && s[0].h>=700 {s[0].world_bottom-=66;}
  if s[0].remote[0].active && !s[0].map {s[0].world_top=240;s[0].world_bottom=ifx s[0].h<700 then s[0].h-252 else s[0].h-440;}
  s[0].world_scale=lo(s[0].h*0.78,(s[0].world_bottom-s[0].world_top)*2.5);
  s[0].field_box=[4]f32.[16*d,(s[0].world_bottom+28)*d,(s[0].w-16)*d,(s[0].world_bottom+72)*d];
  keys:=s[0].keys;before:=s[0].session[0].you.body.clock.ticks;
  gw.gridwalk_frame(s[0].session[..],cast(f32)((ifx (keys&8)!=0 then 1 else 0)-(ifx (keys&4)!=0 then 1 else 0)),cast(f32)((ifx (keys&1)!=0 then 1 else 0)-(ifx (keys&2)!=0 then 1 else 0)),(keys&32)!=0,(keys&16)!=0,s[0].look,0,0,w,h,d,dt,false);
  s[0].look=0;s[0].steps=s[0].session[0].you.body.clock.ticks-before;
  eye:=gw.gridwalk_eye(s[0].session[..]);at:=gw.gridwalk_at(s[0].session[..]);
  s[0].eye=v3(eye.x,eye.y,eye.z);
  s[0].forward=unit_or(sub(v3(at.x,at.y,at.z),s[0].eye),v3(0,0,1));
  s[0].right=unit_or(cross(s[0].forward,v3(0,1,0)),v3(-1,0,0));s[0].up=cross(s[0].right,s[0].forward);
  for i:0..<LAB_UNIFORMS {u[i]=0;}u[0]=w;u[1]=h;u[3]=1;
  floor_pen:=HdPen.{d=d,top=s[0].world_top,bottom=s[0].world_bottom,cyan=true,sans=false};
  u[80]=floor_pen.top*d;u[81]=floor_pen.bottom*d;s[0].mesh_n=0;
  n:=0;
  if !s[0].remote[0].table {
  for i: -16..<37 {
    v:=cast(f32)i*2;
    n=lab_line(s,out,n,v3(-32,0,v),v3(32,0,v),floor_pen,3);
    n=lab_line(s,out,n,v3(v,0,-32),v3(v,0,72),floor_pen,3);
  }
  for i:0..<7 {
    if i!=0 {n=lab_cube(s,out,n,LAB_X[i],0,LAB_Z[i],1.2,floor_pen,ifx s[0].selected==i then 2 else 0);}
    p:=lab_project(s,v3(LAB_X[i],3.2,LAB_Z[i]));
    if p.depth>0.2 && p.x>80 && p.x<s[0].w-80 && p.y>floor_pen.top+14 && p.y<floor_pen.bottom-44 {
      b:=HudBox.{x=p.x-78,y=p.y-20,width=156,height=44};
      lab_node(s,b,i+1);n=hd_panel(out,n,b,floor_pen,s[0].selected==i);
      n=hd_text_fit(out,n,LAB_SHORT[i],b.x+10,b.y+27,13,136,floor_pen,0);
    }
  }
  n=lab_draw_blocks(s,out,n,floor_pen);
  feet:=gw.gridwalk_feet(s[0].session[..]);
  n=lab_cube(s,out,n,feet.x,feet.y,feet.z,0.3,floor_pen,2);
  }
  s[0].world_vertices=n;
  pen:=HdPen.{d=d,top=0,bottom=s[0].h,cyan=true,sans=false};
  thumbs:=s[0].session[0].thumbs;
  if thumbs.move_on {
    n=hd_ring(out,n,thumbs.ox/d,thumbs.oy/d,44,44,0,6.2831853,pen,2);
    n=hd_ring(out,n,thumbs.ox/d+thumbs.pad_x*44,thumbs.oy/d-thumbs.pad_y*44,12,12,0,6.2831853,pen,0);
  }
  n=hd_text(out,n,ifx s[0].remote[0].table then "BITCOIN EXPLORER" else "BITCOIN LAB",16,34,ifx s[0].remote[0].table then 14.0f32 else 18.0f32,pen,0);
  n=hd_text(out,n,lab_source_label(s),16,72,11,pen,2);
  snap:=LAB_SNAPSHOTS[e[0].phase];sy:=ifx s[0].remote[0].active && !s[0].map then 190.0f32 else ifx s[0].w<700 then 284.0f32 else 190.0f32;
  if s[0].remote[0].active {n=lab_remote_status(s,out,n,sy,pen);}else {
  n=hd_text(out,n,"TIP",16,sy,10,pen,1);n=lab_number_at(out,n,snap.height,42,sy,11,pen,0);
  n=hd_text_fit(out,n,ifx e[0].playing then "REPLAYING / OBSERVATION UNKNOWN" else "PAUSED / OBSERVATION UNKNOWN",90,sy,10,s[0].w-106,pen,1);
  if s[0].w<700 {n=lab_identifier(s,out,n,snap.hash,302,pen);}else {n=hd_text(out,n,snap.hash,430,sy,10,pen,0);}
  n=hd_text(out,n,"WINDOW",16,s[0].world_bottom-12,10,pen,1);n=lab_number_at(out,n,s[0].shown,76,s[0].world_bottom-12,10,pen,0);
  n=hd_text(out,n,"/",100,s[0].world_bottom-12,10,pen,1);n=lab_number_at(out,n,snap.count,114,s[0].world_bottom-12,10,pen,0);
  n=hd_text(out,n,"RETAINED; OMITTED",150,s[0].world_bottom-12,10,pen,1);n=lab_number_at(out,n,snap.count-s[0].shown,288,s[0].world_bottom-12,10,pen,0);
  }
  for i:0..<s[0].count {
    node:=s[0].nodes[i];if node.action>=1000 {continue;}if i>=12 && node.action<=7 {continue;}
    b:=node.box;active:=s[0].focus==i || node.action==s[0].selected+1;
    n=hd_panel(out,n,b,pen,active);
    label:="";
    if node.action<=7 {label=LAB_SHORT[node.action-1];}
    if node.action==8 {label="< PREV";}if node.action==9 {label="NEXT >";}if node.action==10 {label="SOURCE";}
    if node.action==11 {label="WORLDS";}if node.action==12 {label="MAP";}
    if node.action>=200 {label=lab_label(node.action);active=active || node.action==200+(ifx s[0].remote[0].active then s[0].remote[0].model[0].phase else e[0].phase);}
    if node.action>=220 && node.action<=222 {active=active || node.action==220+(ifx s[0].remote[0].active then s[0].remote[0].model[0].source else 0);}
    if node.action==203 && e[0].playing {label="PAUSE";}
    if node.action==223 && s[0].remote[0].model[0].ready {label="STATUS";}
    if node.action==231 && s[0].remote[0].table {label="GRID";}
    if node.action==237 && s[0].remote[0].kind==3 {label="TXS";}
    if node.action==240 {label=ifx s[0].remote[0].replay[0].reduced then "MOTION OFF" else "MOTION ON";}
    if node.action==203 && s[0].remote[0].replay[0].playing {label="PAUSE";}
    n=hd_text_fit(out,n,label,b.x+8,b.y+27,12,b.width-16,pen,ifx active then 2 else 0);
  }
  if s[0].map {
    y:=s[0].h-194;chapter:=LAB_CHAPTERS[s[0].chapter];
    n=hd_text_fit(out,n,LAB_NAMES[s[0].selected],16,y,18,s[0].w-32,pen,2);
    buf:[32]u8;num:[1]int;num[0]=s[0].chapter+1;
    // Filament's integer writer is supplied locally to keep the display bounded.
    digits:=lab_decimal(buf[..],num[0]);
    n=hd_text(out,n,"CH",16,y+27,12,pen,1);n=hd_text(out,n,cast(string)buf[0..<digits],40,y+27,12,pen,0);
    n=hd_text_fit(out,n,chapter.title,80,y+27,13,s[0].w-96,pen,0);
    n=hd_text(out,n,"BOOK:",16,y+51,12,pen,1);n=hd_text(out,n,chapter.status,64,y+51,12,pen,0);
    n=hd_text(out,n,"VISUAL EXERCISE: not available",16,y+75,12,pen,1);
    n=hd_text_fit(out,n,"Recorded validated regtest blocks. Visual exercises are tracked separately.",16,y+96,11,s[0].w-32,pen,1);
  }else {if s[0].remote[0].table {n=lab_table(s,out,n,pen);}else {n=lab_inspector(s,out,n,pen);}}
  n=hd_text_fit(out,n,ifx s[0].w<700 then "Left thumb: walk / right: look. Tap station." else "WASD walk / arrows look / 1-7 stations / N next / Tab + Enter / M map / Esc exit",16,s[0].h-18,11,s[0].w-32,pen,1);
  s[0].draws[0]=0;s[0].draws[1]=cast(u32)s[0].mesh_n;s[0].draws[2]=0x80000000;s[0].draws[3]=1;
  budget_measure(s[0].meter[..],n+s[0].mesh_n,3,budget_arena_bytes(size_of(BitcoinLab),LAB_VERTICES,12,LAB_UNIFORMS));
  _:=budget_take(s[0].meter[..],BUDGET_STEPS,s[0].steps);
  s[0].used=n;return n;
}
lab_decimal :: (out:[]u8,value:int)->int {
  digits:[16]u8;v:=value;n:=0;
  while true {digits[n]=cast(u8)(48+v%10);n+=1;v/=10;if v==0 {break;}}
  for i:0..<n {out[i]=digits[n-1-i];}return n;
}
lab_label :: (action:int)->string {
  if action>=1 && action<=7 {return LAB_NAMES[action-1];}
  if action==8 {return "Previous chapter";}if action==9 {return "Next chapter";}
  if action==10 {return "Read source chapter";}if action==11 {return "Exit to worlds";}
  if action>=200 && action<=202 {return [3]string.["A:102","B:103","C:104"][action-200];}
  if action==203 {return "PLAY";}if action==204 {return "STEP";}if action==205 {return "FIND";}
  if action==206 {return "BLOCK";}if action==207 {return "TXS";}if action==208 {return "< BLK";}if action==209 {return "BLK >";}
  if action==210 {return "< TX";}if action==211 {return "TX >";}if action==212 {return "OUTPUT";}if action==213 {return "SPEND";}
  if action==214 {return "LINK";}
  if action>=220 && action<=230 {return [11]string.["RECORDING","FIXTURE API","OWN NODE","RETRY","< PAGE","PAGE >","WINDOW","< TX","TX >","HISTORY","UTXOS"][action-220];}
  if action>=231 && action<=244 {return [14]string.["EXPLORER","BACK","LINK","SPEND","INPUTS","OUTPUTS","DETAILS","BLOCK","SCRIPT","MOTION","SCRUB B","SCRUB C","< ROWS","ROWS >"][action-231];}
  if action>=1000 {return "Select recorded block";}
  return "Show or hide chapter map";
}
lab_text :: (out:[]u8,at:int,text:string)->int {
  n:=at;for c:text {if n>=out.count {return n;}out[n]=c;n+=1;}return n;
}
lab_a11y :: (s:[]BitcoinLab,out:[]u8)->int #export_c #effects(all) {
  lab_start(s);n:=0;number:[16]u8;
  if s[0].remote[0].active {return lab_remote_a11y(s,out);}
  for action:220..<223 {digits:=lab_decimal(number[..],action);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," button - ");n=lab_text(out,n,lab_label(action));n=lab_text(out,n,"\n");}
  for action:1..<13 {
    if !s[0].map && action>=8 && action<=10 {continue;}
    digits:=lab_decimal(number[..],action);n=lab_text(out,n,cast(string)number[0..<digits]);
    n=lab_text(out,n," button - ");n=lab_text(out,n,lab_label(action));n=lab_text(out,n,"\n");
  }
  if !s[0].map {for action:200..<215 {
    digits:=lab_decimal(number[..],action);n=lab_text(out,n,cast(string)number[0..<digits]);
    n=lab_text(out,n," button - ");n=lab_text(out,n,lab_label(action));n=lab_text(out,n,"\n");
  }}
  n=lab_text(out,n,"100 status - RECORDED REGTEST / VALIDATED-V1. Unlisted Bitcoin Lab. Observation time unknown. Station: ");
  n=lab_text(out,n,LAB_NAMES[s[0].selected]);n=lab_text(out,n,". Chapter ");
  digits:=lab_decimal(number[..],s[0].chapter+1);n=lab_text(out,n,cast(string)number[0..<digits]);
  n=lab_text(out,n,": ");n=lab_text(out,n,LAB_CHAPTERS[s[0].chapter].title);
  n=lab_text(out,n,". Book: ");n=lab_text(out,n,LAB_CHAPTERS[s[0].chapter].status);
  n=lab_text(out,n,". Visual exercise: not available. Snapshot ");
  e:=s[0].explorer[..];snap:=LAB_SNAPSHOTS[e[0].phase];n=lab_text(out,n,snap.hash);n=lab_text(out,n,". Selected block ");
  row:=LAB_BLOCKS[e[0].block];digits=lab_decimal(number[..],row.height);n=lab_text(out,n,cast(string)number[0..<digits]);
  n=lab_text(out,n," ");n=lab_text(out,n,row.hash);n=lab_text(out,n,ifx row.active then " ACTIVE. " else " STALE. ");
  if e[0].tx>=0 {
    tx:=LAB_TXS[e[0].tx];n=lab_text(out,n,"Transaction ");n=lab_text(out,n,tx.txid);n=lab_text(out,n,". Inputs: ");
    for i:tx.input..<tx.input+tx.ni {
      input:=LAB_INPUTS[i];n=lab_text(out,n,input.txid);n=lab_text(out,n,":");digits=lab_decimal(number[..],input.vout);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," ");
    }n=lab_text(out,n,". Outputs: ");
    for i:tx.output..<tx.output+tx.no {
      output:=LAB_OUTPUTS[i];digits=lab_decimal(number[..],output.value_sat);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," sat ");
      n=lab_text(out,n,ifx output.status=="unspent" && tx.order==0 && row.height+100>snap.height then "immature" else output.status);n=lab_text(out,n," script ");n=lab_text(out,n,output.script_hex);n=lab_text(out,n," address ");n=lab_text(out,n,output.address);n=lab_text(out,n," spender ");n=lab_text(out,n,output.spend);n=lab_text(out,n," in block ");n=lab_text(out,n,output.spend_block);n=lab_text(out,n,"; ");
    }
  }
  return lab_text(out,n,"\n");
}
lab_access :: (s:[]BitcoinLab,action:int,activate:bool) #export_c #effects(all) {
  lab_stop(s);s[0].focus=-1;
  for i:0..<s[0].count {if s[0].nodes[i].action==action {s[0].focus=i;break;}}
  if activate && ((action>=1 && action<=12) || (action>=200 && action<=244) || action>=1000) {lab_do(s,action);}
}
lab_guard :: (s:[]BitcoinLab,field:int)->int #export_c #effects(all) {
  if field==40 {return ifx s[0].remote[0].replay[0].reduced then 1 else 0;}if field==41 {return cast(int)(s[0].remote[0].replay[0].anim*1000);}
  if field>=30 && field<=39 {r:=s[0].remote[..];return [10]int.[ifx r[0].table then 1 else 0,r[0].table_page,s[0].table_lines,r[0].offset,r[0].returned,r[0].total,r[0].notice,r[0].replay[0].detached,r[0].replay[0].attached,r[0].history_n][field-30];}
  if field>=20 && field<=29 {r:=s[0].remote[..];return [10]int.[ifx r[0].active then 1 else 0,ifx r[0].model[0].ready then 1 else 0,r[0].kind,r[0].model[0].error,r[0].model[0].identity.height,r[0].wn,r[0].model[0].base[0].serial,r[0].selected,r[0].model[0].source,r[0].model[0].phase][field-20];}
  if field==0 {return s[0].selected;}if field==1 {return s[0].chapter+1;}
  if field>=2 && field<=4 {return cast(int)(gw.gridwalk_pose(s[0].session[..],field-2)*1000);}
  if field==5 {return s[0].keys;}if field==6 {return s[0].used;}
  if field==7 {return s[0].meter[0].refused;}
  if field==8 {return s[0].session[0].you.body.clock.ticks;}
  if field==9 {return s[0].focus;}
  e:=s[0].explorer[..];
  if field==10 {return e[0].phase;}if field==11 {return LAB_BLOCKS[e[0].block].height;}
  if field==12 {return ifx e[0].tx<0 then -1 else LAB_TXS[e[0].tx].order;}
  if field==13 {return ifx LAB_BLOCKS[e[0].block].active then 1 else 0;}if field==14 {return s[0].mesh_n;}
  if field>=16 && field<=18 {
    for node:s[0].nodes[0..<s[0].count] {if node.action>=1000 && node.action<2000 && node.action!=1000+e[0].block {
      if field==16 {return cast(int)(node.box.x+node.box.width/2);}if field==17 {return cast(int)(node.box.y+node.box.height/2);}return LAB_BLOCKS[node.action-1000].height;
    }}return -1;
  }
  return -1;
}
lab_scene_ready :: (s:[]BitcoinLab)->bool #export_c #effects(all) {return s[0].used>0 && (s[0].remote[0].table || (s[0].world_vertices>0 && s[0].world_vertices<=s[0].used));}
lab_message :: (s:[]BitcoinLab,kind:int,n:int) #export_c #effects(all) {
  if kind==600 {lr_rebind(s[0].remote[..]);return;}
  if kind>=512 && kind<520 && n>=0 && n<=LAB_REPLY_MAX {lr_receive(s[0].remote[..],kind-512,cast(string)s[0].inbox[0..<n]);return;}
  if kind==1 && s[0].remote[0].active && s[0].remote[0].search && n>=0 && n<=256-s[0].remote[0].qn {
    r:=s[0].remote[..];for c:s[0].inbox[0..<n] {if !((c>='a' && c<='z')||(c>='A' && c<='Z')||(c>='0' && c<='9')||c=='-'||c=='_') {return;}}
    for c:s[0].inbox[0..<n] {r[0].query[r[0].qn]=c;r[0].qn+=1;}return;
  }
  if kind!=1 || n<0 || n>128 || !s[0].explorer[0].search {return;}e:=s[0].explorer[..];
  if n>128-e[0].n {return;}for c:s[0].inbox[0..<n] {if c<33 || c>126 {return;}}
  for c:s[0].inbox[0..<n] {e[0].query[e[0].n]=c;e[0].n+=1;}
}
lab_hash :: (s:[]BitcoinLab,n:int) #export_c #effects(all) {
  lab_start(s);if n<0 || n>1024 {return;}text:=cast(string)s[0].inbox[0..<n];
  if n>=5 && text[0..<5]=="lab1/" {p:=lsp_read(text);if p.ok {lr_restore(s[0].remote[..],p);s[0].map=false;}return;}
  if n!=74 && n!=139 {return;}
  if text[0..<8]!="regtest/" || text[8]<'0' || text[8]>'2' || text[9]!='/' {return;}
  phase:=cast(int)(text[8]-'0');block:=lb_block(phase,text[10..<74]);if block<0 {return;}
  lr_select(s[0].remote[..],0,0);
  lb_phase(s[0].explorer[..],phase);lb_select(s[0].explorer[..],block);s[0].map=false;
  if n==139 && text[74]=='/' {row:=LAB_BLOCKS[block];for t:row.tx..<row.tx+row.count {if LAB_TXS[t].txid==text[75..<139] {s[0].explorer[0].tx=t;}}}
}

lab_source_label :: (s:[]BitcoinLab)->string {
  r:=s[0].remote[..];if !r[0].active {return "RECORDED REGTEST / VALIDATED-V1";}
  if !r[0].model[0].ready {if r[0].model[0].error!=0 {return ifx r[0].model[0].source==1 then "FIXTURE API / UNAVAILABLE" else "OWN NODE / UNAVAILABLE";}return ifx r[0].model[0].source==1 then "FIXTURE API / WAITING FOR SNAPSHOT" else "OWN NODE / WAITING FOR SNAPSHOT";}
  return ifx r[0].model[0].source==1 then "FIXTURE API / VALIDATED-V1" else ifx r[0].model[0].identity.profile==2 then "OWN NODE / LIVE / VALIDATED-V1" else ifx r[0].model[0].identity.profile==3 then "OWN NODE / SNAPSHOT / BACKGROUND VALIDATION" else "OWN NODE / LIVE / POW-ONLY";
}
lab_remote_do :: (s:[]BitcoinLab,action:int)->bool {
  r:=s[0].remote[..];if action<200 {return false;}
  if action==205 {r[0].search=!r[0].search;r[0].qn=0;return true;}
  if action==240 {r[0].replay[0].reduced=!r[0].replay[0].reduced;if r[0].replay[0].reduced {r[0].replay[0].anim=1;}return true;}
  if action==231 {r[0].table=!r[0].table;r[0].table_page=0;return true;}
  if action==232 {lr_back(r);return true;}
  if action==233 || action==214 {if !r[0].model[0].ready {r[0].notice=503;return true;}p:=lr_exact(r);n:=lsp_write(p,s[0].outbox[..]);if n>0 {s[0].out_n=n;s[0].action=3;}return true;}
  if action==243 || action==244 {next:=r[0].table_page+(ifx action==243 then -1 else 1);if next>=0 && next*s[0].table_rows<s[0].table_lines {r[0].table_page=next;}return true;}
  if action==235 || action==236 || action==237 || action==239 {r[0].detail=ifx action==235 then 1 else ifx action==236 then 2 else ifx action==239 then 3 else 0;r[0].table=true;r[0].table_page=0;return true;}
  if action==223 && r[0].model[0].ready {r[0].info=!r[0].info;r[0].table=true;r[0].table_page=0;return true;}
  if action==226 {lr_push(r);lr_cancel(r);r[0].info=false;r[0].kind=2;r[0].window_offset=ifx r[0].model[0].source==1 then ((LAB_SNAPSHOTS[r[0].model[0].phase].count-1)/24)*24 else 0;lr_queue(r,1);return true;}
  if action>=200 && action<=204 {if r[0].model[0].source==1 {if action==203 {r[0].replay[0].playing=!r[0].replay[0].playing;}else {r[0].replay[0].playing=false;lr_phase(r,ifx action<=202 then action-200 else (r[0].model[0].phase+1)%3);}}return true;}
  if !r[0].model[0].ready {return true;}
  if action==224 || action==225 {
    cap:=ifx r[0].kind==2 then 24 else ifx r[0].kind==4 || r[0].kind==6 then 16 else 32;
    total:=ifx r[0].kind==2 then r[0].window_total else r[0].total;offset:=ifx r[0].kind==2 then r[0].window_offset else r[0].offset;
    if r[0].kind==4 {tx:=lr_tx(r,0);ip:=jv_get(lr_document(r),tx,"input_page");inputs:=lr_int(r,ip,"total");if inputs>total {total=inputs;}}
    offset+=ifx action==224 then -cap else cap;if offset<0 {offset=0;}if offset>=total {return true;}
    if r[0].kind==2 {r[0].window_offset=offset;}else {r[0].offset=offset;}r[0].table_page=0;lr_queue(r,1);return true;
  }
  if action>=1000 && action<2000 {i:=action-1000;if i<r[0].wn {b:=r[0].window[i];lr_visit(r,3,cast(string)b.hash[..],0);}return true;}
  count:=ifx r[0].kind==4 then 1 else ifx r[0].kind==6 then lr_size(r,0,"outputs") else lr_size(r,0,"transactions");
  if action>=2000 && action<3000 {i:=action-2000;if i<count {tx:=lr_tx(r,i);lr_occurrence(r,lr_text(r,tx,"txid"),lr_text(r,tx,"block"),0);}return true;}
  if action>=6000 && action<7000 {i:=action-6000;node:=lr_child(r,0,"outputs",i);output:=jv_get(lr_document(r),node,"output");if node>=0 {lr_occurrence(r,lr_text(r,node,"txid"),lr_text(r,node,"block"),lr_int(r,output,"vout"));}return true;}
  if action==227 || action==228 {if count>0 {r[0].selected=(r[0].selected+(ifx action==227 then count-1 else 1))%count;r[0].output=0;r[0].table_page=0;}return true;}
  if action==238 {if r[0].kind==3 {r[0].selected= -1;r[0].detail=4;r[0].table=true;r[0].table_page=0;}else if r[0].has_block {b:=r[0].block;lr_visit(r,3,cast(string)b.hash[..],0);}return true;}
  if (action==229 || action==230) && (r[0].kind==5 || r[0].kind==6) {lr_visit(r,ifx action==229 then 5 else 6,cast(string)r[0].key[0..<r[0].kn],0);return true;}
  if r[0].selected<0 || r[0].kind==6 {return true;}tx:=lr_tx(r,r[0].selected);
  if action==212 {count=lr_size(r,tx,"outputs");if count>0 {r[0].output=(r[0].output+1)%count;}return true;}
  if action>=4000 && action<5000 {i:=action-4000;if i<lr_size(r,tx,"outputs") {r[0].output=i;r[0].detail=2;r[0].table_page=0;}return true;}
  if action>=3000 && action<4000 {
    input:=lr_child(r,tx,"inputs",action-3000);d:=lr_document(r);if input>=0 && !jv_bool(d,jv_get(d,input,"coinbase")) {lr_occurrence(r,lr_text(r,input,"txid"),lr_text(r,input,"block"),lr_int(r,input,"vout"));}else {r[0].notice=404;}return true;
  }
  output:=lr_child(r,tx,"outputs",r[0].output);
  if action==213 || action==234 {lr_occurrence(r,lr_text(r,output,"spender"),lr_text(r,output,"spend_block"),0);return true;}
  if action==229 || action==230 {key:=lr_text(r,output,"script_hex");if key.count==0 || key.count>256 {r[0].notice=413;return true;}lr_visit(r,ifx action==229 then 5 else 6,key,0);return true;}
  return true;
}
lab_remote_status :: (s:[]BitcoinLab,out:[]f32,n:int,y:f32,pen:HdPen)->int {
  at:=n;r:=s[0].remote[..];if !r[0].model[0].ready {return hd_text_fit(out,at,ifx r[0].model[0].error!=0 then "SOURCE UNAVAILABLE / RETRYING; RECORDING AVAILABLE ABOVE" else "LOADING A COHERENT SNAPSHOT",16,y,10,s[0].w-32,pen,2);}
  identity:=r[0].model[0].identity;
  at=hd_text(out,at,UX_CHAINS[identity.chain],16,y,10,pen,2);at=lab_number_at(out,at,identity.height,94,y,10,pen,0);
  at=hd_text_fit(out,at,"OBSERVATION TIME UNKNOWN",160,y,10,s[0].w-176,pen,1);
  if s[0].w<700 {at=lab_identifier(s,out,at,cast(string)identity.hash[..],y+18,pen);}else {at=hd_text(out,at,cast(string)identity.hash[..],430,y,10,pen,0);}
  return at;
}
lab_remote_tile :: (s:[]BitcoinLab,out:[]f32,n:int,x:f32,z:f32,label:string,index:int,action:int,selected:bool,pen:HdPen,colour:Point)->int {
  at:=n;lab_slab(s,x,0.4,z,0.45,0.35,0.3,colour);p:=lab_project(s,v3(x,1,z));
  if p.depth>0.2 && p.x>=24 && p.x<s[0].w-24 && p.y>=pen.top+22 && p.y<pen.bottom-22 {
    box:=HudBox.{x=p.x-23,y=p.y-22,width=46,height=44};lab_node(s,box,action);at=hd_panel(out,at,box,pen,selected);
    at=hd_text(out,at,label,box.x+5,box.y+27,10,pen,1);at=lab_number_at(out,at,index,box.x+16,box.y+27,10,pen,0);
  }return at;
}
#test "Lab fee colors use rounded virtual bytes and leave unavailable fees unknown" {
  #assert lab_fee_band(-1,40)==0 && lab_fee_band(1000,0)==0;
  #assert lab_fee_band(11,41)==1 && lab_fee_band(110,41)==2 && lab_fee_band(111,41)==3;
}
lab_fee_band :: (fee:int,weight:int)->int {
  if fee<0 || weight<=0 {return 0;}vbytes:=(weight+3)/4;if fee<=vbytes {return 1;}if fee<=10*vbytes {return 2;}return 3;
}
lab_remote_draw :: (s:[]BitcoinLab,out:[]f32,n:int,pen:HdPen)->int {
  at:=n;r:=s[0].remote[..];if !r[0].model[0].ready {return at;}
  min_height:=2147483647;max_height:=0;for i:0..<r[0].wn {height:=r[0].window[i].height;if height<min_height {min_height=height;}if height>max_height {max_height=height;}}
  for i:0..<r[0].wn {b:=r[0].window[i];z:=ifx b.active then 1.8f32 else 4.8f32;
    if r[0].model[0].source==1 && r[0].replay[0].anim<1 {old:=ifx lbr_active(r[0].replay[0].from,cast(string)b.hash[..]) then 1.8f32 else 4.8f32;z=old+(z-old)*r[0].replay[0].anim;}
    at=lab_remote_tile(s,out,at,(cast(f32)b.height-cast(f32)(min_height+max_height)/2)*1.4,z,"",b.height,1000+i,false,pen,ifx b.active then v3(0.1,0.53,0.72) else v3(0.55,0.24,0.08));
  }
  if r[0].kind!=3 && r[0].kind!=4 && r[0].kind!=5 {return at;}
  count:=ifx r[0].kind==4 then 1 else lr_size(r,0,"transactions");largest:=1;for i:0..<count {weight:=lr_int(r,lr_tx(r,i),"weight");if weight>largest {largest=weight;}}
  for i:0..<count {t:=lr_tx(r,i);ratio:=cast(f32)lr_int(r,t,"weight")/cast(f32)largest;if ratio<0.12 {ratio=0.12;}
    x:=(cast(f32)(i%16)-cast(f32)(lo(cast(f32)count,16)-1)/2)*1.2;z:= -1.8-cast(f32)(i/16)*1.2;fee:=lr_int(r,t,"fee_sat");weight:=lr_int(r,t,"weight");band:=lab_fee_band(fee,weight);colour:=ifx band==0 then v3(0.36,0.4,0.44) else ifx band==1 then v3(0.1,0.6,0.45) else ifx band==2 then v3(0.65,0.44,0.13) else v3(0.75,0.15,0.1);
    lab_slab(s,x,0.4,z,0.45*ratio,0.35,0.3,colour);pos:=lab_project(s,v3(x,1,z));
    if pos.depth>0.2 && pos.x>=24 && pos.x<s[0].w-24 && pos.y>=pen.top+22 && pos.y<pen.bottom-22 {box:=HudBox.{x=pos.x-23,y=pos.y-22,width=46,height=44};lab_node(s,box,2000+i);at=hd_panel(out,at,box,pen,i==r[0].selected);at=lab_number_at(out,at,r[0].offset+i,box.x+5,box.y+27,10,pen,0);}
  }
  if r[0].kind!=4 || r[0].selected<0 {return at;}tx:=lr_tx(r,r[0].selected);ni:=lr_size(r,tx,"inputs");no:=lr_size(r,tx,"outputs");
  for i:0..<ni {x:=(cast(f32)i-cast(f32)(ni-1)/2)*1.4;at=lab_remote_tile(s,out,at,x,0.1,"I",ifx r[0].kind==4 then r[0].offset+i else i,3000+i,false,pen,v3(0.58,0.5,0.24));at=lab_line(s,out,at,v3(x,0.6,0),v3(0,0.6,-1.5),pen,2);}
  for i:0..<no {x:=(cast(f32)i-cast(f32)(no-1)/2)*1.4;node:=lr_child(r,tx,"outputs",i);status:=lr_text(r,node,"status");colour:=ifx status=="unspent" then v3(0.1,0.65,0.35) else ifx status=="immature" then v3(0.7,0.6,0.15) else ifx status=="unspendable" then v3(0.4,0.4,0.4) else ifx status=="stale" then v3(0.62,0.28,0.08) else ifx status=="replaced" then v3(0.6,0.2,0.6) else v3(0.5,0.25,0.3);
    at=lab_remote_tile(s,out,at,x,-4.8,"O",lr_int(r,node,"vout"),4000+i,i==r[0].output,pen,colour);at=lab_line(s,out,at,v3(0,0.6,-2.2),v3(x,0.6,-4.5),pen,2);}
  return at;
}
lab_remote_inspector :: (s:[]BitcoinLab,out:[]f32,n:int,input_pen:HdPen)->int {
  pen:=input_pen;pen.bottom=s[0].h-(ifx s[0].h<700 then 172.0f32 else 220.0f32)-4;
  at:=n;r:=s[0].remote[..];y:=s[0].world_bottom+24;
  if r[0].search {at=hd_text_fit(out,at,"FIND HEIGHT / HASH / TXID / EXACT SCRIPT / ADDRESS",16,y,11,s[0].w-32,pen,2);return hd_text_fit(out,at,cast(string)r[0].query[0..<r[0].qn],16,y+24,12,s[0].w-32,pen,0);}
  if !r[0].model[0].ready {return hd_text_fit(out,at,"No amounts admitted. RETRY or select RECORDING.",16,y,12,s[0].w-32,pen,1);}
  if r[0].notice!=0 {at=hd_text(out,at,"EXACT SELECTION UNAVAILABLE",16,y,11,pen,2);at=lab_number_at(out,at,r[0].notice,260,y,11,pen,0);y+=22;}
  at=hd_text_fit(out,at,"TILE WIDTH = PAGE-RELATIVE WEIGHT (12% FLOOR). FEE RATE: GRAY UNKNOWN / GREEN <=1 / AMBER <=10 / RED >10 SAT/VB.",16,y,10,s[0].w-32,pen,1);y+=22;
  if r[0].model[0].source==1 {replay:=r[0].replay[0];at=hd_text(out,at,"DETACH / ATTACH",16,y,10,pen,1);at=lab_number_at(out,at,replay.detached,150,y,10,pen,0);at=lab_number_at(out,at,replay.attached,190,y,10,pen,0);at=hd_text_fit(out,at,ifx lbr_work(replay.from,replay.to)<0 then "WORK INCREASED" else ifx lbr_work(replay.from,replay.to)>0 then "WORK DECREASED" else "SAME WORK",230,y,10,s[0].w-246,pen,2);y+=22;}
  if r[0].info {
    identity:=r[0].model[0].identity;at=hd_text(out,at,"SNAPSHOT CURSOR",16,y,11,pen,2);at=lab_identifier(s,out,at,cast(string)identity.cursor[0..<identity.cn],y+20,pen);y+=ifx s[0].w<700 then 76 else 60;
    at=hd_text(out,at,"VALIDATED HEIGHT",16,y,11,pen,1);at=lab_number_at(out,at,identity.validated,160,y,11,pen,0);y+=22;
    at=hd_text(out,at,"BACKGROUND",16,y,11,pen,1);if identity.background<0 {at=hd_text(out,at,"UNKNOWN",160,y,11,pen,1);}else {at=lab_number_at(out,at,identity.background,160,y,11,pen,0);}y+=22;
    return hd_text_fit(out,at,"Complete acknowledged view. Observation time unknown.",16,y,11,s[0].w-32,pen,1);
  }
  at=hd_text(out,at,"PAGE",16,y,11,pen,1);offset:=ifx r[0].kind==2 then r[0].window_offset else r[0].offset;total:=ifx r[0].kind==2 then r[0].window_total else r[0].total;
  at=lab_number_at(out,at,offset,60,y,11,pen,0);at=hd_text(out,at,"OF",120,y,11,pen,1);at=lab_number_at(out,at,total,146,y,11,pen,0);y+=24;
  if r[0].kind==2 {return hd_text_fit(out,at,"One slab per block: blue active lane / amber stale lane. BLOCK shows full facts.",16,y,11,s[0].w-32,pen,1);}
  if r[0].kind==6 {
    count:=lr_size(r,0,"outputs");for i:0..<count {if y+22>s[0].h-132 {break;}node:=lr_child(r,0,"outputs",i);o:=jv_get(lr_document(r),node,"output");at=lab_number_at(out,at,lr_int(r,o,"value_sat"),16,y,11,pen,0);at=hd_text(out,at,"SAT",142,y,10,pen,1);at=hd_text(out,at,lr_text(r,o,"status"),180,y,11,pen,2);y+=22;}
    return at;
  }
  if r[0].selected<0 {return hd_text(out,at,"No matching transactions in this page.",16,y,11,pen,1);}
  tx:=lr_tx(r,r[0].selected);at=lab_identifier(s,out,at,lr_text(r,tx,"txid"),y,pen);y+=ifx s[0].w<700 then 38 else 22;
  at=hd_text(out,at,"BLOCK",16,y,10,pen,1);at=lab_number_at(out,at,lr_int(r,tx,"height"),68,y,11,pen,0);at=hd_text(out,at,ifx jv_bool(lr_document(r),jv_get(lr_document(r),tx,"active")) then "ACTIVE" else "STALE",150,y,11,pen,2);y+=22;
  node:=lr_child(r,tx,"outputs",r[0].output);if node<0 {return at;}
  at=hd_text(out,at,"OUT",16,y,11,pen,1);at=lab_number_at(out,at,lr_int(r,node,"vout"),52,y,11,pen,0);at=lab_number_at(out,at,lr_int(r,node,"value_sat"),94,y,11,pen,0);at=hd_text(out,at,"SAT",220,y,11,pen,1);y+=22;
  at=hd_text(out,at,lr_text(r,node,"status"),16,y,11,pen,2);y+=22;
  if y+44<s[0].h-132 {at=lab_identifier(s,out,at,lr_text(r,node,"script_hex"),y,pen);}
  return at;
}
lab_remote_a11y :: (s:[]BitcoinLab,out:[]u8)->int {
  n:=0;number:[32]u8;for action:200..<245 {if action>214 && action<220 {continue;}digits:=lab_decimal(number[..],action);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," button - ");n=lab_text(out,n,lab_label(action));n=lab_text(out,n,"\n");}
  r:=s[0].remote[..];if r[0].model[0].ready {
    for i:0..<r[0].wn {digits:=lab_decimal(number[..],1000+i);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," button - Block ");digits=lab_decimal(number[..],r[0].window[i].height);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," ");n=lab_text(out,n,cast(string)r[0].window[i].hash[..]);n=lab_text(out,n,"\n");}
    if r[0].kind==3 || r[0].kind==5 {for i:0..<lr_size(r,0,"transactions") {digits:=lab_decimal(number[..],2000+i);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," button - Transaction ");n=lab_text(out,n,lr_text(r,lr_tx(r,i),"txid"));n=lab_text(out,n,"\n");}}
    if r[0].kind==6 {for i:0..<lr_size(r,0,"outputs") {digits:=lab_decimal(number[..],6000+i);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n," button - Output occurrence ");node:=lr_child(r,0,"outputs",i);n=lab_text(out,n,lr_text(r,node,"txid"));n=lab_text(out,n,"\n");}}
    if r[0].selected>=0 && r[0].kind!=6 {tx:=lr_tx(r,r[0].selected);for name,side:[2]string.["inputs","outputs"] {for i:0..<lr_size(r,tx,name) {digits:=lab_decimal(number[..],(ifx side==0 then 3000 else 4000)+i);n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n,ifx side==0 then " button - Previous outpoint " else " button - Select output ");node:=lr_child(r,tx,name,i);n=lab_text(out,n,ifx side==0 then lr_text(r,node,"txid") else lr_text(r,node,"status"));digits=lab_decimal(number[..],lr_int(r,node,"vout"));n=lab_text(out,n," VOUT ");n=lab_text(out,n,cast(string)number[0..<digits]);n=lab_text(out,n,"\n");}}}
  }
  n=lab_text(out,n,"100 status - ");n=lab_text(out,n,lab_source_label(s));n=lab_text(out,n,". ");
  if r[0].model[0].ready {id:=r[0].model[0].identity;n=lab_text(out,n,"Snapshot ");n=lab_text(out,n,cast(string)id.hash[..]);if r[0].selected>=0 && r[0].kind!=6 {tx:=lr_tx(r,r[0].selected);n=lab_text(out,n," Transaction ");n=lab_text(out,n,lr_text(r,tx,"txid"));n=lab_text(out,n," Block ");n=lab_text(out,n,lr_text(r,tx,"block"));n=lab_text(out,n,ifx jv_bool(lr_document(r),jv_get(lr_document(r),tx,"active")) then " ACTIVE" else " STALE / RETAINED OCCURRENCE");}n=lab_text(out,n,". Visible table rows: ");for c:s[0].table_text[0..<s[0].table_n] {if c=='\n' {n=lab_text(out,n,"; ");}else {if n<out.count {out[n]=c;n+=1;}}}}
  return lab_text(out,n,"\n");
}

#load "bitcoin-lab-table.coax";
