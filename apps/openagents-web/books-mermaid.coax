" y=\"77\" width=\"104\" height=\"31\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"496\" y=\"92\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"11\"><tspan x=\"496\" y=\"95\">Three</tspan></text></g><rect x=\"230\" y=\"36\" width=\"156\" height=\"32\" fill=\"#0a0a0a\" stroke=\"#2a2a2a\" stroke-width=\"1\"/><text x=\"308\" y=\"52\" text-anchor=\"middle\" fill=\"#b8b8b8\" font-size=\"10\"><tspan x=\"308\" y=\"49\">Long edge label wrapping</tspan><tspan x=\"308\" y=\"62\">across two lines cleanly</tspan></text></svg></div>";
