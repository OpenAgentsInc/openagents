  sd2 := "sequenceDiagram\n  participant P1 as \"Long Participant Label\"\n  participant P2\n  participant P3\n  participant P4\n  participant P5\n  P1->>P2: \"Adjacent message over 24 chars\"\n  P1->>P5: \"Wide span message exceeding sixty four characters to exercise the 64 clamp\"\n  Note over P1,P2: \"A longer note spanning two lines cleanly\"\n";
  #assert mm_render_svg(hb9[..], sd2, "s1") && !hb9[0].overflow;
  want_sd2 := "<div class=\"bk-mermaid-wrap\"><svg class=\"bk-mermaid\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Sequence diagram\" viewBox=\"0 0 780 292\" width=\"780\" height=\"292\"><defs><marker id=\"s1-arr\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 1.5 L9 5 L0 8.5 Z\" fill=\"#c8c8c8\"/></marker><marker id=\"s1-x\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M2 2 L8 8 M8 2 L2 8\" stroke=\"#fff\" stroke-width=\"1.6\"/></marker></defs><line x1=\"94\" y1=\"64\" x2=\"94\" y2=\"228\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"28\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"94\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"94\" y=\"39\">Long Participant</tspan><tspan x=\"94\" y=\"52\">Label</tspan></text><rect x=\"28\" y=\"228\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"94\" y=\"250\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"94\" y=\"247\">Long Participant</tspan><tspan x=\"94\" y=\"260\">Label</tspan></text><line x1=\"242\" y1=\"64\" x2=\"242\" y2=\"228\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"176\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"242\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"242\" y=\"45\">P2</tspan></text><rect x=\"176\" y=\"228\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"242\" y=\"250\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"242\" y=\"253\">P2</tspan></text><line x1=\"390\" y1=\"64\" x2=\"390\" y2=\"228\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"324\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"390\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"390\" y=\"45\">P3</tspan></text><rect x=\"324\" y=\"228\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"390\" y=\"250\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"390\" y=\"253\">P3</tspan></text><line x1=\"538\" y1=\"64\" x2=\"538\" y2=\"228\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"472\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"538\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"538\" y=\"45\">P4</tspan></text><rect x=\"472\" y=\"228\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"538\" y=\"250\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"538\" y=\"253\">P4</tspan></text><line x1=\"686\" y1=\"64\" x2=\"686\" y2=\"228\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"620\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"686\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"686\" y=\"45\">P5</tspan></text><rect x=\"620\" y=\"228\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"686\" y=\"250\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"686\" y=\"253\">P5</tspan></text><line x1=\"94\" y1=\"110\" x2=\"242\" y2=\"110\" stroke=\"#c8c8c8\" stroke-width=\"1.2\" marker-end=\"url(#s1-arr)\"/><text x=\"168\" y=\"97\" text-anchor=\"middle\" fill=\"#e6e6e6\" font-size=\"10\"><tspan x=\"168\" y=\"94\">Adjacent message over 24</tspan><tspan x=\"168\" y=\"106\">chars</tspan></text><line x1=\"94\" y1=\"152\" x2=\"686\" y2=\"152\" stroke=\"#c8c8c8\" stroke-width=\"1.2\" marker-end=\"url(#s1-arr)\"/><text x=\"390\" y=\"139\" text-anchor=\"middle\" fill=\"#e6e6e6\" font-size=\"10\"><tspan x=\"390\" y=\"136\">Wide span message exceeding sixty four characters to exercise</tspan><tspan x=\"390\" y=\"148\">the 64 clamp</tspan></text><rect x=\"39\" y=\"174\" width=\"258\" height=\"28\" fill=\"#161616\" stroke=\"#6b6b6b\" stroke-width=\"1\"/><text x=\"168\" y=\"188\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"168\" y=\"185\">A longer note spanning two lines</tspan><tspan x=\"168\" y=\"197\">cleanly</tspan></text></svg></div>";
  #assert cast(string) out[0..<hb9[0].n] == want_sd2;

  // 9. Exact 27-char node (wrap@26), 29-char edge (wrap@28), 19-char participant (wrap@18), 33-char note (wrap@32)
  hbw := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hbw[..], "flowchart TD\n  A[\"012345678901234567890123456\"] -->|\"01234567890123456789012345678\"| B[\"b\"]\n", "w0");
  #assert cast(string) out[0..<hbw[0].n] == "<div class=\"bk-mermaid-wrap\"><svg class=\"bk-mermaid\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Flowchart diagram\" viewBox=\"0 0 256 173\" width=\"256\" height=\"173\"><defs><marker id=\"w0-arr\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 1.5 L9 5 L0 8.5 Z\" fill=\"#c8c8c8\"/></marker><marker id=\"w0-x\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M2 2 L8 8 M8 2 L2 8\" stroke=\"#fff\" stroke-width=\"1.6\"/></marker></defs><path d=\"M128 70 C128 94,128 94,128 118\" fill=\"none\" stroke=\"#8a8a8a\" stroke-width=\"1.2\" marker-end=\"url(#w0-arr)\"/><g class=\"mm-node\"><rect x=\"24\" y=\"24\" width=\"208\" height=\"46\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"128\" y=\"47\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"11\"><tspan x=\"128\" y=\"43\">01234567890123456789012345</tspan><tspan x=\"128\" y=\"58\">6</tspan></text></g><g class=\"mm-node\"><rect x=\"76\" y=\"118\" width=\"104\" height=\"31\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"128\" y=\"133\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"11\"><tspan x=\"128\" y=\"136\">b</tspan></text></g><rect x=\"38\" y=\"74\" width=\"180\" height=\"32\" fill=\"#0a0a0a\" stroke=\"#2a2a2a\" stroke-width=\"1\"/><text x=\"128\" y=\"90\" text-anchor=\"middle\" fill=\"#b8b8b8\" font-size=\"10\"><tspan x=\"128\" y=\"87\">0123456789012345678901234567</tspan><tspan x=\"128\" y=\"100\">8</tspan></text></svg></div>";
  hbs := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hbs[..], "sequenceDiagram\n  participant A as \"0123456789012345678\"\n  participant B\n  A->>B: x\n  Note over A,B: \"012345678901234567890123456789012\"\n", "s2");
  #assert cast(string) out[0..<hbs[0].n] == "<div class=\"bk-mermaid-wrap\"><svg class=\"bk-mermaid\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Sequence diagram\" viewBox=\"0 0 336 250\" width=\"336\" height=\"250\"><defs><marker id=\"s2-arr\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 1.5 L9 5 L0 8.5 Z\" fill=\"#c8c8c8\"/></marker><marker id=\"s2-x\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M2 2 L8 8 M8 2 L2 8\" stroke=\"#fff\" stroke-width=\"1.6\"/></marker></defs><line x1=\"94\" y1=\"64\" x2=\"94\" y2=\"186\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"28\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"94\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"94\" y=\"39\">012345678901234567</tspan><tspan x=\"94\" y=\"52\">8</tspan></text><rect x=\"28\" y=\"186\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"94\" y=\"208\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"94\" y=\"205\">012345678901234567</tspan><tspan x=\"94\" y=\"218\">8</tspan></text><line x1=\"242\" y1=\"64\" x2=\"242\" y2=\"186\" stroke=\"#2a2a2a\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/><rect x=\"176\" y=\"20\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"242\" y=\"42\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"242\" y=\"45\">B</tspan></text><rect x=\"176\" y=\"186\" width=\"132\" height=\"44\" fill=\"#141414\" stroke=\"#6b6b6b\" stroke-width=\"1.1\"/><text x=\"242\" y=\"208\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"242\" y=\"211\">B</tspan></text><line x1=\"94\" y1=\"110\" x2=\"242\" y2=\"110\" stroke=\"#c8c8c8\" stroke-width=\"1.2\" marker-end=\"url(#s2-arr)\"/><text x=\"168\" y=\"97\" text-anchor=\"middle\" fill=\"#e6e6e6\" font-size=\"10\"><tspan x=\"168\" y=\"100\">x</tspan></text><rect x=\"39\" y=\"132\" width=\"258\" height=\"28\" fill=\"#161616\" stroke=\"#6b6b6b\" stroke-width=\"1\"/><text x=\"168\" y=\"146\" text-anchor=\"middle\" fill=\"#f2f2f2\" font-size=\"10\"><tspan x=\"168\" y=\"143\">01234567890123456789012345678901</tspan><tspan x=\"168\" y=\"155\">2</tspan></text></svg></div>";
}

#test "mm_render_svg handles unsupported syntax, capacity overflows, and tight-buffer rollback" {
  out: [65536] u8;
  hb_bad := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  ht_put(hb_bad[..], "keep");
  #assert !mm_render_svg(hb_bad[..], "pie title Pets\n  \"Dogs\" : 386\n", "x");
  #assert !mm_render_svg(hb_bad[..], "flowchart XX\n  A --> B\n", "x");
  #assert !mm_render_svg(hb_bad[..], "flowchart TD\n", "x");
  #assert !mm_render_svg(hb_bad[..], "sequenceDiagram\n", "x");
  #assert hb_bad[0].n == 4 && !hb_bad[0].overflow;

  // Tight buffer overflow rolls back cleanly and returns false
  tiny: [32] u8;
  hb_tiny := [1] HtBuf.[HtBuf.{bytes = tiny[..]}];
  ht_put(hb_tiny[..], "ok");
  #assert !mm_render_svg(hb_tiny[..], "flowchart TD\n  A --> B\n", "t");
  #assert hb_tiny[0].n == 2 && !hb_tiny[0].overflow;
  #assert !mm_render_svg(hb_tiny[..], "sequenceDiagram\n  A->>B: hi\n", "t");
  #assert hb_tiny[0].n == 2 && !hb_tiny[0].overflow;

  // Direct mm_find_arrow exact end-of-string and bracket/quote boundaries
  #assert mm_find_arrow("A<-->", 0).style == MM_EDGE_BIDIR && mm_find_arrow("A<-->", 0).end == 5;
  #assert mm_find_arrow("A-.->", 0).style == MM_EDGE_DASHED && mm_find_arrow("A-.->", 0).end == 5;
  #assert mm_find_arrow("A==>", 0).style == MM_EDGE_THICK && mm_find_arrow("A==>", 0).end == 4;
  #assert mm_find_arrow("A-->", 0).style == MM_EDGE_SOLID && mm_find_arrow("A-->", 0).end == 4;
  #assert mm_find_arrow("A-->|x|", 0).lbl_from == 5 && mm_find_arrow("A-->|x|", 0).end == 7;
  #assert mm_find_arrow("A-->||", 0).end == 6 && mm_find_arrow("A-->||", 0).lbl_from == 5 && mm_find_arrow("A-->||", 0).lbl_to == 5;
  #assert !mm_find_arrow("A--", 0).found && !mm_find_arrow("A-- ", 0).found && !mm_find_arrow("A-- unclosed", 0).found && mm_find_arrow("A-- -->", 0).start == 1 && mm_find_arrow("A-- -->", 0).end == 7;
  ar_x := mm_find_arrow("A-- x-->", 0);
  #assert ar_x.found && ar_x.start == 1 && ar_x.lbl_from == 4 && ar_x.lbl_to == 5 && ar_x.end == 8;
  ar_q := mm_find_arrow("A-- \"a\"-->", 0);
  #assert ar_q.found && ar_q.start == 1 && ar_q.lbl_from == 4 && ar_q.lbl_to == 7 && ar_q.end == 10;
  #assert !mm_find_arrow("A[-->] B(-->) C{-->} \"-->\" ]", 0).found;
  #assert mm_find_arrow("]A-->B", 0).found && mm_find_arrow("A[x]-->B", 0).start == 4;

  // Direct parser edge cases: brackets/quotes inside labels & groups, chained edges, 1-char labels, double-bracket empty/1-char, subgraph edge cases
  fl: [1] MmFlow;
  fl[0].nn = 3; fl[0].overflow = true;
  edge_src := "flowchart TB\n  A[\"x --> y & (z)\"] & B(\"p & q\") & C{\"r & s\"} -- \"a --> b\" --> D --> |x| E[e]\n  E -->|unclosed\n  X --> Y1 & Y2 --> Z\n  \"Qa\"-->Qb\n  W\n  class A foo\n  style A fill:#000\n  linkStyle 0 stroke:#fff\n  click A\n  direction LR\n  F[unclosed\n  G[[]]\n  H[a]\n  ;\n  [noid]\n  subgraph [bad]\n    S0[\"x\"]\n  end\n  subgraph S1[unclosed\n  end\n  subgraph \"Q\"\n    Q[\"q\"]\n  end\n  subgraph [[dbl]]\n  end\n  subgraph K[Title]\n  end\n";
  #assert mm_flow_parse(fl[..], edge_src) && fl[0].ns == 5;
  #assert mm_flow_str(fl[..], fl[0].subs[0].id) == "[bad]" && mm_flow_str(fl[..], fl[0].subs[1].id) == "S1[unclosed";
  #assert mm_flow_str(fl[..], fl[0].subs[2].title) == "Q" && mm_flow_str(fl[..], fl[0].subs[3].id) == "[[dbl]]" && mm_flow_str(fl[..], fl[0].subs[4].title) == "Title";
  #assert fl[0].ne == 10 && mm_flow_str(fl[..], fl[0].edges[0].label) == "a --> b" && mm_flow_str(fl[..], fl[0].edges[3].label) == "x";
  #assert fl[0].edges[3].from == mm_flow_find_node(fl[..], "D") && fl[0].edges[3].to == mm_flow_find_node(fl[..], "E");
  #assert fl[0].edges[7].from == mm_flow_find_node(fl[..], "Y1") && fl[0].edges[8].from == mm_flow_find_node(fl[..], "Y2") && fl[0].edges[9].to == mm_flow_find_node(fl[..], "Qb");
  #assert mm_flow_find_node(fl[..], "W") >= 0 && mm_flow_find_node(fl[..], ";") == -1;
  // Node inside subgraph Q (sub == 2) keeps alias_sub == -1; sub == 0 node S0 keeps sub == 0 when re-added to sub 1
  q_idx := mm_flow_find_node(fl[..], "Q");
  #assert q_idx >= 0 && fl[0].nodes[q_idx].alias_sub == -1 && fl[0].nodes[q_idx].sub == 2;
  #assert mm_flow_add_node(fl[..], "Q", "q", MM_SHAPE_RECT, 0) == q_idx && fl[0].nodes[q_idx].sub == 2;
  s0_idx := mm_flow_find_node(fl[..], "S0");
  #assert mm_flow_add_node(fl[..], "S0", "", MM_SHAPE_RECT, 1) == s0_idx && fl[0].nodes[s0_idx].sub == 0;
  #assert mm_flow_add_node(fl[..], "", "x", MM_SHAPE_RECT, -1) == -1;
  f_idx := mm_flow_find_node(fl[..], "F");
  #assert mm_flow_str(fl[..], fl[0].nodes[f_idx].label) == "F";
  #assert mm_flow_add_node(fl[..], "F", "z", MM_SHAPE_ROUND, 0) == f_idx && mm_flow_str(fl[..], fl[0].nodes[f_idx].label) == "z" && fl[0].nodes[f_idx].shape == MM_SHAPE_ROUND && fl[0].nodes[f_idx].sub == 0;
  // Direct mm_flow_parse_node boundaries: ";", "[noid]", bare shape, double-bracket exact checks
  #assert mm_flow_parse_node(fl[..], ";", -1) == -1 && mm_flow_parse_node(fl[..], "[noid]", -1) == -1;
  bare_i := mm_flow_parse_node(fl[..], "BareNode", -1);
  #assert bare_i >= 0 && fl[0].nodes[bare_i].shape == MM_SHAPE_RECT;
  g1_i := mm_flow_parse_node(fl[..], "G1[[]]", -1);
  g2_i := mm_flow_parse_node(fl[..], "G2[[a]]", -1);
  g3_i := mm_flow_parse_node(fl[..], "G3[[a]", -1);
  g4_i := mm_flow_parse_node(fl[..], "G4[a]]", -1);
  #assert mm_flow_str(fl[..], fl[0].nodes[g1_i].label) == "G1" && mm_flow_str(fl[..], fl[0].nodes[g2_i].label) == "a";
  #assert mm_flow_str(fl[..], fl[0].nodes[g3_i].label) == "[a" && mm_flow_str(fl[..], fl[0].nodes[g4_i].label) == "a]";
  // mm_flow_parse_group cap + quote/bracket/depth protection + exact IDs
  gids: [2] int;
  #assert mm_flow_parse_group(fl[..], "A[x] &  & B{y} & C(z) & ]", -1, gids[..]) == 2 && gids[0] == mm_flow_find_node(fl[..], "A") && gids[1] == mm_flow_find_node(fl[..], "B");
  g6: [6] int;
  #assert mm_flow_parse_group(fl[..], "&P0", -1, g6[..]) == 1 && g6[0] == mm_flow_find_node(fl[..], "P0");
  #assert mm_flow_parse_group(fl[..], "P1\"a&b\" & Q1[c&d] & R1(e&f) & S9{g&h}&T9 & ]U9", -1, g6[..]) == 6;
  #assert g6[0] == mm_flow_find_node(fl[..], "P1\"a&b\"") && g6[1] == mm_flow_find_node(fl[..], "Q1") && g6[2] == mm_flow_find_node(fl[..], "R1") && g6[3] == mm_flow_find_node(fl[..], "S9") && g6[4] == mm_flow_find_node(fl[..], "T9") && g6[5] == mm_flow_find_node(fl[..], "]U9");
  #assert mm_flow_parse_group(fl[..], "]V1 & V2", -1, g6[..]) == 2 && g6[1] == mm_flow_find_node(fl[..], "V2");
  // Alias at node 0 + node inside sub 0 matching sub 1 id + <br/> empty-wrap measure
  fa: [1] MmFlow;
  #assert mm_flow_parse(fa[..], "flowchart TD\n  S0 --> N[\"<br/>\"]\n  subgraph S0\n    S1\n  end\n  subgraph S1\n    X\n  end\n");
  #assert fa[0].nodes[0].alias_sub == 0 && fa[0].nodes[2].alias_sub == -1 && fa[0].nodes[2].sub == 0;
  mm_flow_measure(fa[..]);
  #assert fa[0].nodes[1].h == 31;
  // Back-edge at edge 0 (non-subgraph) + self-loop adx == ady == 0
  hb_sl := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hb_sl[..], "flowchart TD\n  B --> A\n  A --> B\n  C --> A\n  A --> A\n", "sl");
  sl_s := cast(string) out[0..<hb_sl[0].n];
  #assert mm_has(sl_s, "C112 158,112 158,76 134") && mm_has(sl_s, "M76 134 C112 118,112 118,76 103");
  // Cluster layout edge cases: Out(0)->N1b(member 1), internal N2(member 2)->N1(member 0), LR 2-node same-rank stack, alias to sub 1, ungrouped node at i>0
  fl_lr: [1] MmFlow;
  #assert mm_flow_parse(fl_lr[..], "flowchart LR\n  Out\n  subgraph S0\n    N1\n    N1b\n    N2\n    N2 --> N1\n  end\n  subgraph S1\n    M1\n  end\n  Out --> N1b\n  S0 --> S1\n  S1 --> Tail\n");
  _ = mm_flow_layout(fl_lr[..]);
  // N1b and N2 are both rank 0 (Out->N1b is external, not N1->N1b) stacked vertically; N2(member 2)->N1(member 0) places N1 below both; Tail is ungrouped node i>0 right of S1
  n1_i := mm_flow_find_node(fl_lr[..], "N1");
  n1b_i := mm_flow_find_node(fl_lr[..], "N1b");
  n2_i := mm_flow_find_node(fl_lr[..], "N2");
  tail_i := mm_flow_find_node(fl_lr[..], "Tail");
  #assert fl_lr[0].nodes[n2_i].y < fl_lr[0].nodes[n1_i].y && fl_lr[0].nodes[n1b_i].y < fl_lr[0].nodes[n1_i].y && fl_lr[0].nodes[n1b_i].x == fl_lr[0].nodes[n2_i].x && fl_lr[0].nodes[n1b_i].y != fl_lr[0].nodes[n2_i].y;
  #assert fl_lr[0].nodes[tail_i].x > fl_lr[0].subs[1].x;
  // Alias to sub 1 (alias_sub == 1) + outgoing edge from alias uses s.h + same-y self-loop in TD and BT
  fl_td: [1] MmFlow;
  #assert mm_flow_parse(fl_td[..], "flowchart TD\n  subgraph S0\n    A\n  end\n  subgraph S1\n    B\n  end\n  subgraph S2\n    C\n  end\n  S0 --> S1\n  S0 --> S2\n  A --> A\n");
  _ = mm_flow_layout(fl_td[..]);
  #assert fl_td[0].nodes[mm_flow_find_node(fl_td[..], "S0")].h == fl_td[0].subs[0].h && !fl_td[0].edges[2].back;
  hb_td2 := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hb_td2[..], "flowchart TD\n  subgraph S0\n    A\n  end\n  subgraph S1\n    B\n  end\n  subgraph S2\n    C\n  end\n  S0 --> S1\n  S0 --> S2\n  A --> A\n", "t2");
  #assert mm_has(cast(string) out[0..<hb_td2[0].n], "M172 113 C");
  fl_bt: [1] MmFlow;
  #assert mm_flow_parse(fl_bt[..], "flowchart BT\n  subgraph S0\n    A\n  end\n  subgraph S1\n    B\n  end\n  S0 --> S1\n  A --> A\n");
  _ = mm_flow_layout(fl_bt[..]);
  #assert !fl_bt[0].edges[1].back;
  // mm_flow_add_edge rejects negative endpoints and sets overflow at cap
  ne0 := fl[0].ne;
  mm_flow_add_edge(fl[..], -1, 0, MM_EDGE_SOLID, "");
  mm_flow_add_edge(fl[..], 0, -1, MM_EDGE_SOLID, "");
  #assert fl[0].ne == ne0;
  fl[0].nn = MM_MAX_NODES;
  #assert mm_flow_add_node(fl[..], "Z99", "z", MM_SHAPE_RECT, -1) == -1 && fl[0].overflow;
  fl[0].overflow = false; fl[0].ne = MM_MAX_EDGES;
  mm_flow_add_edge(fl[..], 0, 1, MM_EDGE_SOLID, "");
  #assert fl[0].overflow;
  // Pool overflow in mm_flow_pool sets fl[0].overflow
  fl[0].overflow = false; fl[0].tn = MM_TEXT_CAP;
  _ = mm_flow_pool(fl[..], "x");
  #assert fl[0].overflow;
  // Subgraph cap overflow (17 subgraphs -> refused) and 65-node overflow -> mm_flow_parse returns false
  sub17: [512] u8; s17 := 0;
  for c: "flowchart TD\n" { sub17[s17] = c; s17 += 1; }
  for k: 0..<17 { for c: "subgraph S\nend\n" { sub17[s17] = c; s17 += 1; } }
  #assert !mm_flow_parse(fl[..], cast(string) sub17[0..<s17]) && fl[0].overflow;
  #assert !mm_flow_parse(fl[..], "A --> B\n");

  // Sequence parser edge cases: pre-dirty reset, 1-char IDs/aliases/else/notes, arrows at exact end of head, no-header, 0-part, 0-event, 1-part/1-ev, overflow, nested 17 frames + stray end
  sq: [1] MmSeq;
  sq[0].np = 3; sq[0].overflow = true;
  #assert !mm_seq_parse(sq[..], "A->>B: x\n");
  #assert !mm_seq_parse(sq[..], "sequenceDiagram\n  participant A\n");
  #assert !mm_seq_parse(sq[..], "sequenceDiagram\n  loop L\n  end\n");
  #assert mm_seq_parse(sq[..], "sequenceDiagram\n  A->>A: self\n") && sq[0].np == 1 && sq[0].ne == 1;
  seq_edge := "sequenceDiagram\n  participant A as B\n  :A->>B: bad\n  nocolon\n  A B: noarrow\n  ->>A->>B: nofrom\n  A--: bad\n  Z1--x: no_to\n  Z2-->>: no_to\n  Z3->>: no_to\n  Z4-->: no_to\n  Z5-x: no_to\n  Z6->: no_to\n  Note bad\n  Note :empty\n  Note over ,A: bad\n  Note over A,: bad\n  Note A:n\n  Note right of A:m\n  alt x\n    A->>B:1\n  else y\n    B->>A:2\n  end\n  end\n";
  #assert mm_seq_parse(sq[..], seq_edge) && sq[0].np == 2 && sq[0].ne == 8 && mm_seq_str(sq[..], sq[0].parts[0].label) == "B";
  #assert mm_seq_str(sq[..], sq[0].evs[0].label) == "n" && mm_seq_str(sq[..], sq[0].evs[1].label) == "m";
  #assert mm_seq_str(sq[..], sq[0].evs[3].label) == "1" && mm_seq_str(sq[..], sq[0].evs[4].label) == "y";
  hb_el := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hb_el[..], "sequenceDiagram\n  alt a\n    A->>B: 1\n  else x\n    B->>A: 2\n  end\n", "e1") && mm_has(cast(string) out[0..<hb_el[0].n], "[else x]");
  // Render sequence with 17 nested loops + stray end (hits MM_MAX_FRAMES cap and f_sp == 0 guard cleanly)
  f17: [512] u8; fn17 := 0;
  for c: "sequenceDiagram\n  A->>B: x\n" { f17[fn17] = c; fn17 += 1; }
  for k: 0..<17 { for c: "loop L\n" { f17[fn17] = c; fn17 += 1; } }
  for k: 0..<18 { for c: "end\n" { f17[fn17] = c; fn17 += 1; } }
  hbf := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  #assert mm_render_svg(hbf[..], cast(string) f17[0..<fn17], "f17") && !hbf[0].overflow;
  // Direct capacity & pool overflow checks for MmSeq
  #assert mm_seq_part(sq[..], "", "x") == -1;
  #assert mm_seq_part(sq[..], "A", "Z") == 0 && mm_seq_str(sq[..], sq[0].parts[0].label) == "Z";
  sq[0].np = MM_MAX_PARTS;
  #assert mm_seq_part(sq[..], "Over", "") == -1 && sq[0].overflow;
  sq[0].overflow = false; sq[0].ne = MM_MAX_EVENTS;
  mm_seq_push_ev(sq[..], MmSeqEv.{});
  #assert sq[0].overflow;
  sq[0].overflow = false; sq[0].tn = MM_TEXT_CAP;
  _ = mm_seq_pool(sq[..], "x");
  #assert sq[0].overflow;
  p17: [512] u8; pn17 := 0;
  for c: "sequenceDiagram\n" { p17[pn17] = c; pn17 += 1; }
  for k: 0..<16 { for c: "participant P" { p17[pn17] = c; pn17 += 1; } p17[pn17] = cast(u8) ('a' + k); pn17 += 1; p17[pn17] = '\n'; pn17 += 1; }
  for c: "Pa->>Pb: ok\nPa->>NewP: x\n" { p17[pn17] = c; pn17 += 1; }
  #assert !mm_seq_parse(sq[..], cast(string) p17[0..<pn17]) && sq[0].overflow && sq[0].ne == 1;
}
