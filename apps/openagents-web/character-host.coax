// The character runtime the host runs beside a world (coax/web/host.js, the "character pass"
// section; docs/metaverse/2026-11-06-native-hero-characters.md, Design 3). A world that places a
// character asks for her pack by name (coaxial_character_pack_v1); the host loads this module and
// the pack only then, so a world's own wasm and memory carry none of it (Everglade's wasm has about
// 150 KB of its budget left, and Echo's rig, face and catalog take about 46 MB of memory). Each
// frame the host copies the world's SceneLights block (metaverse-engine/render/scene-lights.coax) in here;
// this places her where the world's stage put her (the block's feet and heading), steps her on a
// 1/64 s clock, fills the block's character slots (the hair's share, the morph switch, the head
// profile) and her palette, and names her draws. Her body and face run on Aethyr's character
// runtime (metaverse-engine/character/), with Echo's declarations (metaverse/valley/echo.coax): her rig's idle
// clip looped (clip 0), her idle face segments on their cycle, and her idle life over them (blinks,
// glances and breath, metaverse-engine/character/idle.coax) on the joints and targets ECHO_IDLE_RIG names.
// When the world moves her (the block's motion slots, #12996: the Cultist Raid's room runs her) her
// body runs her own locomotion graph at the world's pace; a cast plays her TF0290 wind-up (the
// shot's source frames ECHO_WINDUP_FIRST..ECHO_WINDUP_LAST) to its bar's end; and the fix layers
// (metaverse-engine/character/fix.coax) plant her feet on the world's ground, turn her head to the spell's
// point and reach her orb hand toward it.
//   coax/bin/coax test apps/openagents-web/character-host.coax
#load "../../metaverse/valley/echo.coax";
#load "../../metaverse/valley/canyon-pack-policy.coax";
#load "../../metaverse/valley/slay-gpu-policy.coax";
#load "../../metaverse-engine/render/scene-lights.coax";
#load "../../metaverse-engine/character/idle.coax";
#load "../../metaverse-engine/character/detail.coax" as detail;
#load "../../metaverse-engine/character/fix.coax";
#load "../../metaverse/valley/slay-shot-play.coax";

// The valley-slay pack's parts and Echo's draws in its index buffer (Valley Lab's canyon_frame): her
// body, her strands (drawn blended) and her strands again for the world's shadow map.
CHARACTER_INDEX_BYTES :: 73674948;
CHARACTER_LAYERS :: 35;
CHARACTER_DRAWS :: 3;
CHARACTER_BODY :: [4]u32.[2999985, 522009, 0, 1];
CHARACTER_GROOM :: [4]u32.[4470303, 13811136, 0, 1];
CHARACTER_STEP :: 1.0f32 / 64.0f32;
// Her eyes over her feet, for the head's height on screen.
CHARACTER_HEAD :: 1.6f32;
// The hair's share by the head's height on screen (Valley Lab's canyon_hair_share): the strands per
// pixel stay about the same below 300 pixels; small heads take the shared far tier.
CHARACTER_HAIR_FULL :: 300.0f32;
CHARACTER_HAIR_MAX :: 0.5f32;
// Groom levels (#12988). Her strands come in 251 groups (a strand's group is its curve number mod
// 251, its seed); the host orders the strands' index range group by group (character_groom_group)
// at load, so the strands a share keeps are a prefix of the range and the draw runs only those (the
// whole range ran before, the vertex shader dropping the rest). Draws round up to whole groups;
// the last group's opacity fades continuously, and ribbons widen by the effective share.
// The shadow map takes at most CHARACTER_GROOM_SHADOW of them, a prefix of the same order.
CHARACTER_GROOM_GROUPS :: 251;
CHARACTER_GROOM_STRIDE :: 97;      // the order's step through the groups (251 is prime: every group once)
CHARACTER_GROOM_SEED :: 13573820 + 8 + 10;   // a segment's seed word (metaverse-engine/render/character.coax's ECHO_GROOM_WORD + 8, then 10)
CHARACTER_GROOM_SEGMENT_WORDS :: 12;          // words a segment
CHARACTER_GROOM_SHADOW :: 0.25f32;            // the shadow map's share at most (character.coax's CV_SHADOW_HAIR_SHARE)
// Echo's idle life: her ARKit blink targets, her face rig's eye joints and her mid spine for the breath.
// Each eye turns about its local y (yaw) and x (pitch); the spine rocks about its local z.
ECHO_IDLE_RIG :: CharacterIdleRig.{blink_left = "eyeblinkleft", blink_right = "eyeblinkright", eye_left = "facial_l_eye", eye_right = "facial_r_eye",
  breath = "spine_03", eye_yaw = Point.{y = 1}, eye_pitch = Point.{x = 1}, breath_axis = Point.{z = 1}, seed = 2987};

// Her fixes' joints (Echo's skin names): the orb hand is her left.
ECHO_FIX_RIG :: CharacterFixRig.{pelvis = "pelvis", neck = "neck_01", head = "head", legs = [6]string.["thigh_l", "calf_l", "foot_l", "thigh_r", "calf_r", "foot_r"],
  arm = [3]string.["upperarm_l", "lowerarm_l", "hand_l"]};
// Her cast's wind-up: TF0290's source frames 1126 to 1152 (the shot's 24 fps), ending as the bar ends.
ECHO_WINDUP_FIRST :: 1126;
ECHO_WINDUP_LAST :: 1152;
CHARACTER_CAST_IN :: 0.25f32;     // s the wind-up takes to blend in from her body
CHARACTER_CAST_HOLD :: 0.6f32;    // s past the bar she holds the release
CHARACTER_CAST_OUT :: 0.5f32;     // s it then takes to blend back
CHARACTER_REACH_IN :: 0.4f32;     // s before the bar's end the orb hand starts toward the point
CHARACTER_PACE :: 0.15f32;        // s: the world's pace smoothed over this, so a frame's jitter doesn't change her gait
CharacterHost :: struct {
  echo: [1] Character; pack: [1] CharacterPack; idle: [1] CharacterIdle; idle_parts: int;
  block: [SCL_FLOATS] f32; draws: [CHARACTER_DRAWS * 4] u32;
  groups: [CHARACTER_GROOM_GROUPS] u32; grouped: bool; kept: int; shadow_kept: int;   // the strands' segments per group
  digest: [32] u8; verified: bool; failed: bool; assets: [4] int;
  clock: f32; share: f32; frames: int;
  shot: [1] SlayShot; fix: [1] CharacterFix; fix_parts: int; pace: f32;
  cast_w: f32; worst: f32;   // the wind-up's share last frame; the farthest a planted foot strayed (m)
}

// The catalog's landing place (the face's one static scratch), named so the face's header has its type.
character_catalog_capacity :: (scratch: [] EchoCatalogScratch) -> int #export_c #effects(all) { return scratch[0].bytes.count; }
character_pack_gate :: (s: [] CharacterHost, bytes: int) -> bool #export_c #effects(all) {
  s[0].verified = canyon_pack_accept(s[0].digest[..], bytes);
  if !s[0].verified { s[0].failed = true; }
  return s[0].verified;
}
character_catalog :: (s: [] CharacterHost, b: [] u8) -> bool #export_c #effects(all) {
  s[0].assets[0] = b.count;
  if !s[0].verified || !echo_catalog_admit(s[0].pack[..], 0, b) || !echo_spawn(s[0].echo[..], s[0].pack[..], 0) { s[0].failed = true; return false; }
  // ECP3 carries TF0290's shot after the rig and the face (Valley Lab's canyon_catalog): her wind-up
  if scan_u32(b, 0) == 0x33504345 {
    at := 20 + cast(int) scan_u32(b, 4) + cast(int) scan_u32(b, 8);
    _ := shot_admit(s[0].shot[..], b[at..<b.count], character_face_bytes(s[0].echo[..], s[0].pack[..]));
  }
  character_idle_start(s);
  return true;
}
// The pack's other parts, by their sizes: the vertex words, the indices, the texture layers.
character_asset :: (s: [] CharacterHost, index: int, bytes: int) #export_c #effects(all) {
  if index < 1 || index > 3 { return; }
  s[0].assets[index] = bytes;
  want := ifx index == 1 then slay_gpu_storage() else ifx index == 2 then CHARACTER_INDEX_BYTES else CHARACTER_LAYERS;
  if bytes != want { s[0].failed = true; }
}
character_ready :: (s: [] CharacterHost) -> bool #export_c #effects(all) {
  return s[0].verified && !s[0].failed && s[0].echo[0].ready && s[0].assets[1] == slay_gpu_storage() && s[0].assets[2] == CHARACTER_INDEX_BYTES && s[0].assets[3] == CHARACTER_LAYERS;
}
#test "Wide groom tier keeps coverage with fewer curves and joins near detail continuously" {
 #assert character_hair_share(0)==0.004f32 && character_hair_share(48)==0.004f32;
 #assert character_hair_share(64)<0.006 && abs(character_hair_share(96)-(96.0f32/300)*(96.0f32/300))<0.00001;
 previous:f32=0;for px:0..<301 {next:=character_hair_share(cast(f32)px);#assert next>=previous && next<=0.5 && next-previous<0.009;previous=next;}
}
character_hair_share :: (head: f32) -> f32 {
  return detail.detail_hair(head);
}
// Her head's height on screen in pixels, from the block's camera.
character_head_pixels :: (b: [] f32) -> f32 {
  hx := b[SCL_AT] - b[SCL_EYE]; hy := b[SCL_AT + 1] + CHARACTER_HEAD - b[SCL_EYE + 1]; hz := b[SCL_AT + 2] - b[SCL_EYE + 2];
  z := hx * b[SCL_FORWARD] + hy * b[SCL_FORWARD + 1] + hz * b[SCL_FORWARD + 2];
  if z <= 0.05 { return 100000; }
  return 0.25 * b[SCL_FOCAL_Y] / z * b[SCL_SIZE + 1] * 0.5;
}
// Subpixel facial detail fades rather than switching at a distance boundary.
#test "Character face detail fades continuously from a wide head to a readable face" {
  #assert character_face_detail(0)==0 && character_face_detail(32)==0;
  #assert character_face_detail(48)==0.5 && character_face_detail(64)==1 && character_face_detail(300)==1;
  previous:f32=0;for px:0..<101 {next:=character_face_detail(cast(f32)px);#assert next>=previous && next-previous<0.05;previous=next;}
}
character_face_detail :: (head:f32)->f32 {return detail.detail_face(head);}
// Her body on its idle clip, and her idle life bound to her pack's names (how many of the five it found).
character_idle_start :: (s: [] CharacterHost) {
  e := s[0].echo[..];
  e[0].mode = CHARACTER_IDLE; e[0].idle_clip = 0;
  s[0].idle_parts = character_idle_bind(s[0].idle[..], e, s[0].pack[..], ECHO_IDLE_RIG);
  s[0].fix_parts = character_fix_bind(s[0].fix[..], e, s[0].pack[..], ECHO_FIX_RIG);
}
// Whether her shot holds the wind-up's frames.
character_windup_ok :: (s: [] CharacterHost) -> bool {
  if !s[0].shot[0].ready { return false; }
  f := shot_info(s[0].shot[0].data[0..<s[0].shot[0].bytes]);
  return f.source_first <= ECHO_WINDUP_FIRST && ECHO_WINDUP_LAST < f.source_first + f.frames;
}
// The wind-up's share of her body `t` s into a cast whose bar is `bar` s.
character_cast_share :: (t: f32, bar: f32) -> f32 {
  if t < 0 { return 0; }
  return pose_fade(t, CHARACTER_CAST_IN) * (1 - pose_fade(t - bar - CHARACTER_CAST_HOLD, CHARACTER_CAST_OUT));
}
// The wind-up's source frame `t` s into a cast: its first frame held, then its frames run to end as the bar does.
character_cast_frame :: (t: f32, bar: f32) -> f32 {
  length := f32(ECHO_WINDUP_LAST - ECHO_WINDUP_FIRST) / 24.0f32;
  start := hi(0, bar - length);
  u := clamp01((t - start) / hi(bar - start, 0.05f32));
  return f32(ECHO_WINDUP_FIRST) + u * f32(ECHO_WINDUP_LAST - ECHO_WINDUP_FIRST);
}
// Her pose with the world's motion on it: the wind-up over her body (its rotations; her root and
// hips keep her own place), then the fixes, then the palette.
character_motion :: (s: [] CharacterHost, dt: f32) {
  e := s[0].echo[..];
  b := s[0].block[..];
  s[0].cast_w = 0;
  t := b[SCL_CAST_T]; bar := b[SCL_CAST_BAR];
  casting := b[SCL_MOVED] > 0.5 && b[SCL_CAST] >= 0;
  if casting && character_windup_ok(s) {
    w := character_cast_share(t, bar);
    sh := s[0].shot[..];
    d := sh[0].data[0..<sh[0].bytes];
    f := shot_info(d);
    sh[0].frame = character_cast_frame(t, bar) - f32(f.source_first);
    frame := slay_shot_frame(sh);
    a := cast(int) floor(frame); c := ifx a + 1 < f.frames then a + 1 else a;
    first := e[0].joints;
    hips := s[0].fix[0].pelvis;
    for k: 0..<f.bones {
      j := cast(int) face_word(d, f.names + k * 68 + 64);
      if j <= 0 || j >= e[0].joints { continue; }
      l := pose_blend(face_local(d, f.data + a * f.stride + k * 28), face_local(d, f.data + c * f.stride + k * 28), frame - f32(a));
      if j == hips { l.t = e[0].pose[j].t; }
      e[0].pose[j] = pose_blend(e[0].pose[j], l, w);
      if j < first { first = j; }
    }
    character_rechain(e, first);
    s[0].cast_w = w;
  }
  ground := CharacterGround.{y = b[SCL_AT + 1], rise_x = b[SCL_SLOPE], rise_z = b[SCL_SLOPE + 1]};
  character_fix_feet(e, s[0].fix[..], ground, dt);
  s[0].worst = hi(s[0].worst, s[0].fix[0].error);
  if casting {
    aim := v3(b[SCL_AIM], b[SCL_AIM + 1], b[SCL_AIM + 2]);
    look := pose_fade(t, 0.3) * (1 - pose_fade(t - bar - CHARACTER_CAST_HOLD, CHARACTER_CAST_OUT));
    character_fix_look(e, s[0].fix[..], add(aim, v3(0, 1, 0)), look);
    reach := pose_fade(t - bar + CHARACTER_REACH_IN, CHARACTER_REACH_IN) * (1 - pose_fade(t - bar - CHARACTER_CAST_HOLD, CHARACTER_CAST_OUT));
    _ := character_fix_reach(e, s[0].fix[..], add(aim, v3(0, 1, 0)), reach);
  }
  character_fix_present(e);
}
// One frame: her place from the block, her clock on by dt in whole 1/64 s steps (her idle clip, her
// idle face cycle, her idle life), then the block's character slots and the draws. Returns how many
// draws (0 until she is ready).
character_frame :: (s: [] CharacterHost, dt: f32) -> int #export_c #effects(all) {
  if !character_ready(s) { return 0; }
  e := s[0].echo[..];
  step := ifx dt > 0 && dt < 0.25 then dt else 0.0f32;
  s[0].clock += step;
  p := s[0].pack[..];
  b := s[0].block[..];
  character_place(e, v3(b[SCL_AT], b[SCL_AT + 1], b[SCL_AT + 2]), atan2(b[SCL_HEADING + 1], b[SCL_HEADING]));
  // the world's motion (#12996): her locomotion graph at its pace, else her idle clip
  moved := b[SCL_MOVED] > 0.5;
  e[0].mode = ifx moved then CHARACTER_LOCOMOTION else CHARACTER_IDLE;
  s[0].pace += (hi(b[SCL_SPEED], 0) - s[0].pace) * clamp01(step / CHARACTER_PACE);
  e[0].speed = ifx moved then s[0].pace else 0.0f32; e[0].turn = 0;
  stepped := s[0].clock >= CHARACTER_STEP;
  while s[0].clock >= CHARACTER_STEP {
    s[0].clock -= CHARACTER_STEP;
    character_step(e, p, CHARACTER_STEP);
    character_idle_step(s[0].idle[..], e, p, CHARACTER_STEP);
  }
  if stepped && moved { character_motion(s, step); }
  s[0].frames += 1;
  head:=character_head_pixels(b);
  s[0].share = character_hair_share(head);
  b[SCL_HAIR] = character_groom_level(s, s[0].share);
  // the morphs run while a face clip or a blink shows
  b[SCL_MORPH] = ifx (e[0].face[0].enabled && e[0].face[0].fade > 0) || s[0].idle[0].weight > 0 then character_face_detail(head) else 0.0f32;
  b[SCL_RIG] = 0; b[SCL_PROFILE] = 1;
  for k: 0..<4 { s[0].draws[k] = CHARACTER_BODY[k]; s[0].draws[4 + k] = CHARACTER_GROOM[k]; s[0].draws[8 + k] = CHARACTER_GROOM[k]; }
  s[0].draws[5] = cast(u32) (s[0].kept * 6); s[0].draws[9] = cast(u32) (s[0].shadow_kept * 6);
  return CHARACTER_DRAWS;
}
// The group drawn at place `rank` in the order.
character_groom_group :: (rank: int) -> int #export_c #effects(all) { return (rank * CHARACTER_GROOM_STRIDE) % CHARACTER_GROOM_GROUPS; }
// The second triangle reuses the first triangle's identical ribbon corners.
#test "Groom index reuse keeps two triangles with four distinct corners" {
 #assert character_groom_corner(0)==0 && character_groom_corner(1)==1 && character_groom_corner(2)==2;
 #assert character_groom_corner(3)==2 && character_groom_corner(4)==1 && character_groom_corner(5)==5;
}
character_groom_corner :: (corner:int)->int #export_c #effects(all) {return ifx corner==3 then 2 else ifx corner==4 then 1 else corner;}
// The host's layout for ordering: 0 the groups, 1 the first segment's seed word, 2 words a segment,
// 3 her strands' first index, 4 their indices.
character_groom_layout :: (field: int) -> int #export_c #effects(all) {
  if field == 0 { return CHARACTER_GROOM_GROUPS; }
  if field == 1 { return CHARACTER_GROOM_SEED; }
  if field == 2 { return CHARACTER_GROOM_SEGMENT_WORDS; }
  return cast(int) CHARACTER_GROOM[ifx field == 3 then 0 else 1];
}
// A segment's group from its seed ((curve mod 251) / 251).
character_groom_group_of :: (seed: f32) -> int {
  g := cast(int) (seed * cast(f32) CHARACTER_GROOM_GROUPS + 0.5);
  return ((g % CHARACTER_GROOM_GROUPS) + CHARACTER_GROOM_GROUPS) % CHARACTER_GROOM_GROUPS;
}
// The host's count of each group's segments, once ordered: they must add up to her strands' range.
character_groom_admit :: (s: [] CharacterHost) -> bool #export_c #effects(all) {
  total := 0;
  for g: 0..<CHARACTER_GROOM_GROUPS { total += cast(int) s[0].groups[g]; }
  s[0].grouped = total * 6 == cast(int) CHARACTER_GROOM[1];
  return s[0].grouped;
}
// Draw the first ceil(share*251) groups; the shader fades the fractional boundary group.
character_groom_prefix :: (s: [] CharacterHost, share: f32) -> int {
  kept := 0;
  for rank: 0..<CHARACTER_GROOM_GROUPS {
    if cast(f32)rank >= share*cast(f32)CHARACTER_GROOM_GROUPS { break; }
    kept += cast(int) s[0].groups[character_groom_group(rank)];
  }
  return kept;
}
// This frame's level: the strands kept for her and for the shadow map; returns the share actually
// effective (the block's hair slot: ribbons widen by its inverse). Ungrouped, every strand draws.
character_groom_level :: (s: [] CharacterHost, share: f32) -> f32 {
  total := cast(int) CHARACTER_GROOM[1] / 6;
  if !s[0].grouped { s[0].kept = total; s[0].shadow_kept = total; return 1; }
  s[0].kept = character_groom_prefix(s, share);
  s[0].shadow_kept = character_groom_prefix(s, ifx share < CHARACTER_GROOM_SHADOW then share else CHARACTER_GROOM_SHADOW);
  return share;
}
e_clip :: (s: [] CharacterHost) -> int { return s[0].echo[0].clip; }
// 0 opaque, 2 blended over what is behind (host.js's scene blend profiles), 3 the shadow map only.
character_draw_blend :: (index: int) -> int #export_c #effects(all) { return ifx index == 1 then 2 else ifx index == 2 then 3 else 0; }
character_probe :: (s: [] CharacterHost, field: int) -> int #export_c #effects(all) {
  if field == 0 { return ifx character_ready(s) then 1 else 0; }
  if field == 1 { return s[0].echo[0].clip; }
  if field == 2 { return cast(int) (s[0].share * 1000); }
  if field == 3 { return ifx s[0].echo[0].face[0].enabled then 1 else 0; }
  if field == 4 { return s[0].frames; }
  if field == 5 { return ifx s[0].failed then 1 else 0; }
  if field == 6 { return s[0].idle_parts; }
  if field == 7 { return s[0].idle[0].draws; }
  if field >= 10 && field < 14 { return s[0].assets[field - 10]; }
  // the motion (#12996): the fixes' joints, the wind-up ready, its share now (thousandths), the
  // farthest a planted foot strayed and the most one travelled (tenths of a millimetre), the plants, her pace (mm/s)
  if field == 20 { return s[0].fix_parts; }
  if field == 21 { return ifx character_windup_ok(s) then 1 else 0; }
  if field == 22 { return cast(int) (s[0].cast_w * 1000); }
  if field == 23 { return cast(int) (s[0].worst * 10000); }
  if field == 24 { return cast(int) (hi(s[0].fix[0].legs[0].most, s[0].fix[0].legs[1].most) * 10000); }
  if field == 25 { return s[0].fix[0].legs[0].plants + s[0].fix[0].legs[1].plants; }
  if field == 26 { return cast(int) (s[0].pace * 1000); }
  if field == 27 { return e_clip(s); }
  // groom levels (#12988): her strands grouped, the segments drawn and in the shadow map
  if field == 28 { return ifx s[0].grouped then 1 else 0; }
  if field == 29 { return s[0].kept; }
  if field == 30 { return s[0].shadow_kept; }
  if field == 31 {return cast(int)(s[0].block[SCL_MORPH]*1000);}
  if field == 32 {return cast(int)(character_head_pixels(s[0].block[..])*1000);}
  if field == 33 {return cast(int)(s[0].share*1000000);}
  if field==34 || field==35 {
    b:=s[0].block[..];x:=b[SCL_AT];y:=b[SCL_AT+1]+CHARACTER_HEAD;z:=b[SCL_AT+2];a:=SCL_CLIP+(ifx field==34 then 0 else 4);
    q:=b[a]*x+b[a+1]*y+b[a+2]*z+b[a+3];w:=b[SCL_CLIP+12]*x+b[SCL_CLIP+13]*y+b[SCL_CLIP+14]*z+b[SCL_CLIP+15];if w<=0.05 {return -1;}
    return cast(int)((0.5+(ifx field==34 then q else -q)/w*0.5)*b[SCL_SIZE+(ifx field==34 then 0 else 1)]);
  }
  return -1;
}

#test "She draws once her digest, catalog and three parts are in; her clock runs in whole steps; the hair's share falls with her head's size" #steps 1000000000 {
  s: [1] CharacterHost;
  #assert !character_ready(s[..]) && character_frame(s[..], 0.1) == 0;
  #assert !character_pack_gate(s[..], 12) && s[0].failed;
  s[0].failed = false;
  n := echo_rig_fixture(s[0].pack[0].data[..], 1);
  s[0].verified = true;
  #assert character_pack_rig(s[0].pack[..], 0, n) && echo_spawn(s[0].echo[..], s[0].pack[..], 0);
  character_idle_start(s[..]);
  character_asset(s[..], 1, slay_gpu_storage()); character_asset(s[..], 2, CHARACTER_INDEX_BYTES);
  #assert !character_ready(s[..]);
  character_asset(s[..], 3, CHARACTER_LAYERS);
  #assert character_ready(s[..]);
  b := s[0].block[..];
  b[SCL_SIZE + 1] = 720; b[SCL_FOCAL_Y] = 1.25; b[SCL_FORWARD + 2] = 1; b[SCL_AT + 2] = 0.3;   // close
  // ungrouped: every strand, unwidened
  #assert character_frame(s[..], 0.02) == CHARACTER_DRAWS && s[0].draws[1] == 522009 && s[0].draws[5] == 13811136 && s[0].draws[9] == 13811136;
  #assert abs(s[0].clock - (0.02 - CHARACTER_STEP)) < 0.00001;
  #assert b[SCL_HAIR] == 1 && b[SCL_PROFILE] == 1 && b[SCL_RIG] == 0 && s[0].share == CHARACTER_HAIR_MAX;
  b[SCL_AT + 2] = 30;
  _ := character_frame(s[..], 0);
  #assert s[0].share == 0.004f32;
  #assert character_hair_share(10) == 0.004f32 && character_hair_share(600) == CHARACTER_HAIR_MAX && abs(character_hair_share(150) - 0.25) < 0.00001;
  #assert character_draw_blend(0) == 0 && character_draw_blend(1) == 2 && character_draw_blend(2) == 3;
  // the world's stage places her (the block's feet and heading), and her body loops its idle clip
  scl_place(b, 2, 0.5, -96, 3.14159265);
  _ = character_frame(s[..], 0);
  e := s[0].echo[..];
  #assert e[0].at.x == 2 && e[0].at.y == 0.5 && e[0].at.z == -96 && abs(abs(e[0].heading) - 3.14159265) < 0.001;
  #assert e[0].mode == CHARACTER_IDLE && e[0].clip == 0 && s[0].idle_parts == 0;
  character_asset(s[..], 2, 4);
  #assert !character_ready(s[..]) && s[0].failed;
}
#test "Groom levels draw a prefix of whole groups, at least the share, and widen by the share kept" #steps 100000000 {
  s: [1] CharacterHost;
  // the order visits every group once
  seen: [CHARACTER_GROOM_GROUPS] bool;
  for r: 0..<CHARACTER_GROOM_GROUPS { seen[character_groom_group(r)] = true; }
  for g: 0..<CHARACTER_GROOM_GROUPS { #assert seen[g]; }
  #assert character_groom_group_of(0) == 0 && character_groom_group_of(250.0 / 251.0) == 250 && character_groom_group_of(37.0 / 251.0) == 37;
  // her strands' segments spread over the groups as her pack spreads them
  total := cast(int) CHARACTER_GROOM[1] / 6; left := total;
  for g: 0..<CHARACTER_GROOM_GROUPS { n := ifx g == CHARACTER_GROOM_GROUPS - 1 then left else total / CHARACTER_GROOM_GROUPS; s[0].groups[g] = cast(u32) n; left -= n; }
  #assert character_groom_admit(s[..]);
  for share: [3]f32.[0.02, 0.183, 0.5] {
    kept := character_groom_level(s[..], share);
    #assert kept == share && cast(f32)s[0].kept/cast(f32)total>=share && cast(f32)s[0].kept/cast(f32)total<share+0.005;
    #assert cast(f32) s[0].shadow_kept / cast(f32) total >= (ifx kept < 0.25 then kept else 0.25) - 0.00001 && s[0].shadow_kept <= s[0].kept;
  }
  // a small change of share moves the draw by at most one group
  a := character_groom_level(s[..], 0.1); ka := s[0].kept;
  b := character_groom_level(s[..], 0.101); #assert s[0].kept - ka <= total / CHARACTER_GROOM_GROUPS + 1 && b >= a;
  // a count that doesn't add up to her range is refused, and every strand draws
  s[0].groups[0] += 1;
  #assert !character_groom_admit(s[..]) && character_groom_level(s[..], 0.1) == 1 && s[0].kept == total;
}
