// The walk from Character Create into Everglade (docs/verse/character-creator.md, "The road to
// Everglade"). After USE IN EVERGLADE's save is confirmed, the controls fade, the camera swings
// behind the saved character and it walks the glade path, through the notch in the back ridge, to
// the town gate in about 30 seconds. Meanwhile the host opens Everglade itself out of sight under
// this page (action 18, coax/web/zone-host.js): its engine, shaders, packs, textures and room seat,
// up to its first drawn frame. As the walk reaches the gate the host cross-fades to that running
// Everglade in place (action 1): no loading screen and no black. If Everglade isn't ready yet the
// character waits at the gate. Only a warm-up that failed (or a host that never answered) fades to
// black and goes to Everglade the ordinary way. Everything here is a function of the walk's own
// clock and the road.
// Loaded into charactercreator.coax, so it shares its Creator, glade and figs.

CC_WALK_SECONDS :: 30.0;   // from the first step to the end of the road, inside the gate
CC_WALK_LEAD :: 0.35;      // the controls fade and the character turns before it steps off
CC_WALK_ACCEL :: 1.2;      // seconds to reach walking pace
CC_WALK_STRIDE :: 1.3;     // metres a walk cycle covers (the engine's gait, fivelab-bodies.coax)
CC_WALK_UI :: 0.5;         // seconds the controls take to fade
CC_WALK_CAMERA :: 3.0;     // seconds the camera takes to swing behind the character
CC_WALK_FADE :: 0.9;       // seconds of the host's cross-fade into Everglade (or the fade to black before the page changes)
CC_WALK_ACK :: 3.0;        // a host that never answers the warm-up (no action 18) is not waited on
CC_WALK_HOLD :: 20.0;      // the longest wait at the gate: Everglade's own loader takes over after it
CC_WALK_STUCK :: 4.0;      // still here this long after asking to leave: put the studio back
CC_WALK_STEP :: 0.1;       // metres between road samples
CC_WALK_N :: 516;          // samples from 6 m behind the start to 8 m past the end of the road
CC_WALK_BEHIND :: 60;      // the sample at the character's spot (z 0)

CcWalk :: struct {
  on:bool; t:f32; clock0:f32; yaw0:f32; length:f32; still:bool;
  along:[CC_WALK_N]f32;   // road distance at each sample, 0 at the character's spot
  captured:bool; eye0:[3]f32; fwd0:[3]f32; focal0:f32; cx0:f32; cy0:f32;
  request:bool; asked:bool; asked_at:f32; acked:bool; done:bool; failed:bool; loaded:int; total:int;
  arrived_at:f32 = -1; fade_at:f32 = -1; go:bool; went:bool; went_at:f32;
}

#test "walk road starts at the character, ends inside the gate and takes thirty seconds" {
  w:[1]CcWalk;w[0]=walk_road(w[0]);
  #assert w[0].along[CC_WALK_BEHIND]==0 && w[0].length>33 && w[0].length<44;
  p:=walk_point(w[0],0);#assert abs(p[0])<0.001 && abs(p[2])<0.001;
  e:=walk_point(w[0],w[0].length);#assert abs(e[2]-walk_end_z())<0.01 && e[2]<glade.CG_GATE_Z;
  #assert walk_distance(w[0],0)==0 && walk_distance(w[0],CC_WALK_LEAD)==0;
  #assert abs(walk_distance(w[0],CC_WALK_LEAD+CC_WALK_SECONDS)-w[0].length)<0.001;
  #assert walk_distance(w[0],CC_WALK_LEAD+CC_WALK_SECONDS*0.5)<w[0].length*0.53 && walk_distance(w[0],CC_WALK_LEAD+CC_WALK_SECONDS*0.5)>w[0].length*0.47;
  // Pace stays an even walk: never faster than the arrival average allows, never backwards.
  last:f32=0;for i:1..<620 {d:=walk_distance(w[0],f32(i)*0.05);#assert d>=last && d-last<0.05*1.45;last=d;}
}
#test "walk road follows the glade path and stays on the ground" {
  w:[1]CcWalk;w[0]=walk_road(w[0]);
  for i:0..<80 {d:=f32(i)*w[0].length/80;p:=walk_point(w[0],d);
    #assert abs(p[0]-glade.cg_walk_x(p[2]))<0.01 && abs(p[1]-glade.cg_height(p[0],p[2]))<0.01;
    if p[2]< -4 {#assert glade.cg_path(p[0],p[2])>0.3;}
  }
  // A road distance maps back to the same point however it is sampled.
  a:=walk_point(w[0],12.34);b:=walk_point(w[0],12.35);#assert abs(a[2]-b[2])<0.02 && a[2]>b[2];
}

walk_end_z :: ()->f32 {return glade.CG_GATE_Z-3.0;}
walk_sample_z :: (i:int)->f32 {return 6.0-f32(i)*CC_WALK_STEP;}
walk_road :: (w0:CcWalk)->CcWalk {
  w:=w0;w.along[0]=0;
  for i:1..<CC_WALK_N {a:=walk_sample_z(i-1);b:=walk_sample_z(i);dx:=glade.cg_walk_x(b)-glade.cg_walk_x(a);dz:=b-a;w.along[i]=w.along[i-1]+sqrt(dx*dx+dz*dz);}
  zero:=w.along[CC_WALK_BEHIND];for i:0..<CC_WALK_N {w.along[i]-=zero;}
  w.length=walk_z_along(w,walk_end_z());return w;
}
// Road distance at z, between samples.
walk_z_along :: (w:CcWalk,z:f32)->f32 {
  f:=(6.0-z)/CC_WALK_STEP;i:=int(floor(f64(f)));if i<0 {i=0;}if i>CC_WALK_N-2 {i=CC_WALK_N-2;}
  return w.along[i]+(w.along[i+1]-w.along[i])*(f-f32(i));
}
// The point at road distance d (x, ground height, z); beyond the samples it carries straight on.
walk_point :: (w:CcWalk,d:f32)->[3]f32 {
  lo:=0;hi:=CC_WALK_N-1;
  if d<=w.along[0] {lo=0;hi=1;} else if d>=w.along[CC_WALK_N-1] {lo=CC_WALK_N-2;hi=CC_WALK_N-1;}
  else {while hi-lo>1 {mid:=(lo+hi)/2;if w.along[mid]<=d {lo=mid;} else {hi=mid;}}}
  span:=w.along[hi]-w.along[lo];f:=ifx span>0 then (d-w.along[lo])/span else 0;
  z:=walk_sample_z(lo)+(walk_sample_z(hi)-walk_sample_z(lo))*f;x:=glade.cg_walk_x(z);
  return [3]f32.[x,glade.cg_height(x,z),z];
}
// Distance walked t seconds after the walk began: an even start, then a steady pace that reaches the
// end of the road exactly CC_WALK_SECONDS after the first step.
walk_distance :: (w:CcWalk,t:f32)->f32 {
  a:f32=CC_WALK_ACCEL;v:=w.length/(f32(CC_WALK_SECONDS)-a*0.5);tau:=t-f32(CC_WALK_LEAD);
  if tau<=0 {return 0;}
  d:=ifx tau<a then v*tau*tau/(2*a) else v*(tau-a*0.5);
  return ifx d>w.length then w.length else d;
}
walk_heading :: (w:CcWalk,d:f32)->f32 {a:=walk_point(w,d-0.5);b:=walk_point(w,d+0.5);return walk_atan2(b[0]-a[0],b[2]-a[2]);}
// The angle of (x, y) from +x in [-pi, pi], within 2e-5 rad (aethyr/points.coax's polynomial).
walk_atan2 :: (y:f32,x:f32)->f32 {
  ax:=abs(x);ay:=abs(y);if ax==0 && ay==0 {return 0;}t:=ifx ay>ax then ax/ay else ay/ax;q:=t*t;
  a:=t*(0.99997726+q*(-0.33262347+q*(0.19354346+q*(-0.11643287+q*(0.05265332+q*-0.01172120)))));
  if ay>ax {a=1.5707964-a;}if x<0 {a=3.1415927-a;}if y<0 {a= -a;}return a;
}
walk_wrap :: (a:f32)->f32 {v:=a;while v>3.14159265 {v-=6.2831853;}while v< -3.14159265 {v+=6.2831853;}return v;}
walk_ease :: (v:f32)->f32 {t:=cc_clamp(v,0,1);return t*t*(3-2*t);}

#test "walk hands off in place only after the save and once Everglade is up, and never waits forever" {
  s:[1]Creator;ensure(s[..]);request_player(s[..],true);bytes:[64]u8;for i:0..<56 {bytes[i]=s[0].profile_bytes[i];}
  player_reply(s[..],cast(string)bytes[0..<56]);#assert s[0].profile_go && !s[0].walk.on;
  walk_begin(s[..],false);#assert s[0].walk.on && !s[0].profile_go && s[0].walk.request && !walk_leave(s[..]);
  #assert walk_ask(s[..]) && !walk_ask(s[..]) && s[0].walk.asked;
  walk_reply(s[..],"0 0 9000000");
  for i:0..<300 {walk_step(s[..],0.1);#assert !walk_leave(s[..]);}
  // At the gate: Everglade still loading, so the character waits there.
  for i:0..<20 {walk_step(s[..],0.1);}#assert s[0].walk.arrived_at>0 && s[0].walk.fade_at<0 && !walk_leave(s[..]);
  // Everglade is up: the host cross-fades to it in place at once, and this page never goes black.
  walk_reply(s[..],"1 100 100");walk_step(s[..],0.1);#assert s[0].walk.fade_at>0 && walk_veil(s[0].walk)==0;
  #assert walk_leave(s[..]) && !walk_leave(s[..]);
  for i:0..<12 {walk_step(s[..],0.1);#assert walk_veil(s[0].walk)==0;}
  // If the page never changes, the studio comes back.
  for i:0..<40 {walk_step(s[..],0.1);}#assert !s[0].walk.on && s[0].walk.fade_at<0;
}
#test "walk fades to black and goes the ordinary way only when Everglade can't open in place" {
  s:[1]Creator;ensure(s[..]);s[0].profile_go=true;walk_begin(s[..],false);used:=walk_ask(s[..]);walk_reply(s[..],"0 40 100");
  for i:0..<300 {walk_step(s[..],0.1);}walk_reply(s[..],"2 40 100");walk_step(s[..],0.1);#assert s[0].walk.fade_at>0;
  for i:0..<8 {walk_step(s[..],0.1);#assert !walk_leave(s[..]);}#assert walk_veil(s[0].walk)>0.5;
  for i:0..<4 {walk_step(s[..],0.1);}#assert walk_leave(s[..]) && walk_veil(s[0].walk)==1;
}
#test "walk proceeds without a host that cannot warm up and after a stalled warm-up" {
  s:[1]Creator;ensure(s[..]);s[0].profile_go=true;walk_begin(s[..],false);used:=walk_ask(s[..]);
  for i:0..<318 {walk_step(s[..],0.1);}#assert s[0].walk.fade_at>0 && s[0].walk.fade_at<CC_WALK_LEAD+CC_WALK_SECONDS;
  t:[1]Creator;ensure(t[..]);t[0].profile_go=true;walk_begin(t[..],false);used=walk_ask(t[..]);walk_reply(t[..],"0 10 100");
  for i:0..<320 {walk_step(t[..],0.1);}#assert t[0].walk.arrived_at>0 && t[0].walk.fade_at<0;
  for i:0..<210 {walk_step(t[..],0.1);}#assert t[0].walk.fade_at>0;
  // A failed warm-up is no reason to wait: Everglade's own loader still loads it.
  f:[1]Creator;ensure(f[..]);f[0].profile_go=true;walk_begin(f[..],false);used=walk_ask(f[..]);walk_reply(f[..],"2 0 0");
  for i:0..<318 {walk_step(f[..],0.1);}#assert f[0].walk.fade_at>0;
}
#test "walk with reduced motion skips the walk and leaves once Everglade is warm" {
  s:[1]Creator;ensure(s[..]);s[0].profile_go=true;walk_begin(s[..],true);used:=walk_ask(s[..]);walk_reply(s[..],"1 5 5");
  for i:0..<5 {walk_step(s[..],0.1);}#assert s[0].walk.fade_at>0 && s[0].walk.still;a:figs.BdAnim;#assert walk_figure(s[0],a).z==0;
  for i:0..<12 {walk_step(s[..],0.1);}#assert walk_leave(s[..]);
}

// USE IN EVERGLADE's confirmed save starts the walk; the shared profile is already written.
walk_begin :: (s:[]Creator,still:bool) {
  if s[0].walk.on || !s[0].profile_go {return;}
  s[0].profile_go=false;w:CcWalk;w.on=true;w.still=still;w.clock0=s[0].clock;w.yaw0=s[0].yaw;w.request=true;
  s[0].walk=walk_road(w);s[0].dragging=false;s[0].down=-1;
}
// The warm-up ask (action 18): once.
walk_ask :: (s:[]Creator)->bool {if !s[0].walk.on || !s[0].walk.request {return false;}s[0].walk.request=false;s[0].walk.asked=true;s[0].walk.asked_at=s[0].walk.t;return true;}
// The host's answer, "STATE LOADED TOTAL": 0 under way, 1 done, 2 failed.
walk_reply :: (s:[]Creator,t:string) {
  if !s[0].walk.on {return;}v:[3]int;n:=0;at:=0;
  while at<t.count && n<3 {while at<t.count && t[at]==' ' {at+=1;}if at>=t.count {break;}x:=0;digits:=0;while at<t.count && t[at]>='0' && t[at]<='9' && digits<12 {x=x*10+int(t[at]-'0');at+=1;digits+=1;}if digits==0 {return;}v[n]=x;n+=1;}
  if n!=3 || v[0]>2 {return;}
  s[0].walk.acked=true;s[0].walk.loaded=v[1];s[0].walk.total=v[2];if v[0]==1 {s[0].walk.done=true;}if v[0]==2 {s[0].walk.failed=true;}
}
walk_ready :: (w:CcWalk)->bool {
  if w.done || w.failed {return true;}
  if !w.acked && w.asked && w.t-w.asked_at>CC_WALK_ACK {return true;}
  return w.arrived_at>=0 && w.t-w.arrived_at>CC_WALK_HOLD;
}
walk_step :: (s:[]Creator,dt:f32) {
  if !s[0].walk.on || dt<=0 || dt>=1 {return;}w:=s[0].walk;w.t+=dt;
  if w.went {if w.t-w.went_at>CC_WALK_STUCK {s[0].walk=CcWalk.{};return;}s[0].walk=w;return;}
  end:=ifx w.still then f32(CC_WALK_UI) else f32(CC_WALK_LEAD)+f32(CC_WALK_SECONDS);
  if w.arrived_at<0 && w.t>=end {w.arrived_at=w.t;}
  // The fade starts just before the end of the road, so the hand-off ends as the walk does. A
  // warm Everglade is handed over at once: the host's cross-fade is the fade. Otherwise this page
  // fades to black first and the host goes to Everglade the ordinary way.
  if w.fade_at<0 && walk_ready(w) && (w.still && w.t>=CC_WALK_UI || w.t>=end-f32(CC_WALK_FADE)) {w.fade_at=w.t;}
  if w.fade_at>=0 && !w.go && (w.done || w.t-w.fade_at>=CC_WALK_FADE) {w.go=true;}
  s[0].walk=w;
}
// True once, when the screen is black: the page goes to Everglade.
walk_leave :: (s:[]Creator)->bool {if !s[0].walk.on || !s[0].walk.go || s[0].walk.went {return false;}s[0].walk.went=true;s[0].walk.went_at=s[0].walk.t;return true;}
// The fade to black, only on the way out the ordinary way (a warm Everglade is cross-faded to in place).
walk_veil :: (w:CcWalk)->f32 {if w.fade_at<0 || w.done {return 0;}return walk_ease((w.t-w.fade_at)/f32(CC_WALK_FADE));}
walk_controls :: (w:CcWalk)->f32 {return 1-walk_ease(w.t/f32(CC_WALK_UI));}

#test "walk figure turns to the road, walks it in step and waits at the gate" {
  s:[1]Creator;ensure(s[..]);s[0].yaw=2.5;s[0].profile_go=true;walk_begin(s[..],false);
  a:figs.BdAnim;a.yaw=s[0].yaw;b:=walk_figure(s[0],a);#assert b.yaw==2.5 && abs(b.x)<0.001 && abs(b.z)<0.001;
  for i:0..<100 {walk_step(s[..],0.1);s[0].clock+=0.1;}
  b=walk_figure(s[0],a);d:=walk_distance(s[0].walk,s[0].walk.t);p:=walk_point(s[0].walk,d);
  #assert b.clip==figs.BD_WALK && b.x==p[0] && b.z==p[2] && b.y==p[1] && abs(b.phase-d/CC_WALK_STRIDE)<0.0001;
  #assert abs(walk_wrap(b.yaw-walk_heading(s[0].walk,d)))<0.0001;
  s[0].walk.acked=true;for i:0..<230 {walk_step(s[..],0.1);s[0].clock+=0.1;}
  b=walk_figure(s[0],a);#assert b.clip==figs.BD_IDLE && b.prev==figs.BD_WALK && b.z<glade.CG_GATE_Z;
}
walk_figure :: (s:Creator,a0:figs.BdAnim)->figs.BdAnim {
  w:=s.walk;a:=a0;if w.still {return a;}
  d:=walk_distance(w,w.t);p:=walk_point(w,d);a.x=p[0];a.y=p[1];a.z=p[2];
  turn:=walk_ease(w.t/0.9);a.yaw=w.yaw0+walk_wrap(walk_heading(w,d)-w.yaw0)*turn;
  start:=w.clock0+f32(CC_WALK_LEAD);
  if s.clock<start {return a;}
  a.prev=a0.clip;a.pt0=a0.t0;a.pphase=a0.phase;a.fade_at=start;
  a.clip=figs.BD_WALK;a.t0=start;a.phase=d/f32(CC_WALK_STRIDE);
  if w.arrived_at>=0 {
    stop:=w.clock0+w.arrived_at;a.prev=figs.BD_WALK;a.pt0=start;a.pphase=d/f32(CC_WALK_STRIDE);a.fade_at=stop;a.clip=figs.BD_IDLE;a.t0=stop;a.phase=(s.clock-stop)/figs.bd_seconds(figs.BD_IDLE);
  }
  return a;
}

#test "walk camera swings from the studio shot to behind the walker and stays above the ground" {
  s:[1]Creator;ensure(s[..]);u:[104]f32;out:[64000]f32;n:=frame(s[..],out[..],u[..],1440,900,1,0,true);
  studio:=[3]f32.[u[16],u[17],u[18]];s[0].profile_go=true;walk_begin(s[..],false);
  walk_camera(s[..],u[..],1440,900,1);#assert abs(u[16]-studio[0])<0.001 && abs(u[18]-studio[2])<0.001;
  for i:0..<330 {walk_step(s[..],0.1);
    camera(s[0],u[..],1440,900,1);walk_camera(s[..],u[..],1440,900,1);
    #assert u[17]>=glade.cg_height(u[16],u[18])+0.99;
    f:=[3]f32.[u[20],u[21],u[22]];#assert abs(f[0]*f[0]+f[1]*f[1]+f[2]*f[2]-1)<0.001 && f[2]< -0.5;
    #assert abs(u[24]*f[0]+u[25]*f[1]+u[26]*f[2])<0.001 && abs(u[28]*f[0]+u[29]*f[1]+u[30]*f[2])<0.001 && u[29]>0.8;
    if i>40 {p:=walk_point(s[0].walk,walk_distance(s[0].walk,s[0].walk.t));#assert u[18]>p[2]+2 && u[18]<p[2]+6;}
  }
}
// Behind the walker and above, looking a little past it down the road.
walk_camera :: (s:[]Creator,u:[]f32,w:f32,h:f32,k:f32) {
  if !s[0].walk.on {return;}
  if !s[0].walk.captured {s[0].walk.captured=true;for i:0..<3 {s[0].walk.eye0[i]=u[16+i];s[0].walk.fwd0[i]=u[20+i];}s[0].walk.focal0=u[19];s[0].walk.cx0=u[23];s[0].walk.cy0=u[27];}
  c:=s[0].walk;if c.still {for i:0..<3 {u[16+i]=c.eye0[i];}return;}
  d:=walk_distance(c,c.t);back:=walk_point(c,d-4.2);ahead:=walk_point(c,d+2.6);
  eye:=[3]f32.[back[0],back[1]+2.1,back[2]];target:=[3]f32.[ahead[0],ahead[1]+1.3,ahead[2]];
  b:=walk_ease(c.t/f32(CC_WALK_CAMERA));fwd:[3]f32;
  for i:0..<3 {fwd[i]=target[i]-eye[i];}fl:=sqrt(fwd[0]*fwd[0]+fwd[1]*fwd[1]+fwd[2]*fwd[2]);
  for i:0..<3 {eye[i]=c.eye0[i]+(eye[i]-c.eye0[i])*b;fwd[i]=c.fwd0[i]+(fwd[i]/fl-c.fwd0[i])*b;}
  fl=sqrt(fwd[0]*fwd[0]+fwd[1]*fwd[1]+fwd[2]*fwd[2]);for i:0..<3 {fwd[i]/=fl;}
  floor_y:=glade.cg_height(eye[0],eye[2])+1.0;if eye[1]<floor_y {eye[1]=floor_y;}
  // right = forward x up, up = right x forward (the studio camera's frame, turned).
  rl:=sqrt(fwd[2]*fwd[2]+fwd[0]*fwd[0]);r:=[3]f32.[-fwd[2]/rl,0,fwd[0]/rl];
  up:=[3]f32.[r[1]*fwd[2]-r[2]*fwd[1],r[2]*fwd[0]-r[0]*fwd[2],r[0]*fwd[1]-r[1]*fwd[0]];
  for i:0..<3 {u[16+i]=eye[i];u[20+i]=fwd[i];u[24+i]=r[i];u[28+i]=up[i];}
  // The controls are gone, so the shot fills the screen.
  full_focal:=ifx h*0.89<w*1.25 then h*0.89 else w*1.25;
  u[19]=c.focal0+(full_focal-c.focal0)*b;u[23]=c.cx0+(w*0.5-c.cx0)*b;u[27]=c.cy0+(h*0.5-c.cy0)*b;
}

// The frame while walking: the shot, the controls fading, and (only while waiting at the gate) a
// quiet line saying Everglade is still loading.
walk_frame :: (s:[]Creator,out:[]f32,u:[]f32,w:f32,h:f32,k:f32,dt:f32,still:bool)->int {
  walk_begin(s,still);
  if !still && dt>0 && dt<1 {s[0].clock+=dt;}
  walk_step(s,dt);
  for i:0..<u.count {u[i]=0;}
  u[0]=w;u[1]=h;u[2]=s[0].clock;u[4]=k;u[10]=2;u[11]=ifx s[0].scene_only then 1 else 0;
  camera(s[0],u,w,h,k);walk_camera(s,u,w,h,k);
  c:=s[0].walk;controls:=walk_controls(c);
  // u[40] fades the control panel's glass, u[41] is the fade to black (gpu/character-glade.coax).
  u[40]=1-controls;u[41]=walk_veil(c);
  n:=0;waiting:=c.arrived_at>=0 && c.fade_at<0;
  if controls>0.001 && !s[0].scene_only {n=walk_controls_text(s,out,w,h,k);}
  if waiting {
    shown:=walk_ease((c.t-c.arrived_at)/0.6);label:[48]u8;m:=walk_put(label[..],0,"ENTERING EVERGLADE");
    if c.total>0 {m=walk_put(label[..],m,"  ");m=walk_int(label[..],m,int(cc_clamp(f32(c.loaded)*100/f32(c.total),0,99)));m=walk_put(label[..],m,"%");}
    n=text(out,n,cast(string)label[0..<m],w*0.5-92*k,h-44*k,9*k,ink(k,0.92,0.86,0.70));u[3]=shown;return n;
  }
  u[3]=controls;return n;
}
// The studio's own labels while they fade (the same layout as frame's).
walk_controls_text :: (s:[]Creator,out:[]f32,w:f32,h:f32,k:f32)->int {
  n:=0;white:=ink(k,0.91,0.92,0.9);gold:=ink(k,0.83,0.69,0.43);
  n=text(out,n,"Character Create",24*k,54*k,(ifx s[0].mobile then 18 else 22)*k,white);
  for i:0..<13 {b:=s[0].boxes[i];n=text(out,n,value(s[0],i),b.x0+(ifx s[0].mobile then 25.0f32 else 138.0f32)*k,b.y0+20*k,(ifx i==10 then 8.5f32 else 10.0f32)*k,white);}
  b:=s[0].boxes[17];n=text(out,n,"USE IN EVERGLADE",b.x0+8*k,b.y0+23*k,9*k,gold);
  return n;
}
walk_put :: (b:[]u8,at:int,t:string)->int {n:=at;for ch:t {if n<b.count {b[n]=ch;n+=1;}}return n;}
walk_int :: (b:[]u8,at:int,v:int)->int {d:[12]u8;n:=0;x:=ifx v<0 then 0 else v;while true {d[n]=cast(u8)('0'+x%10);n+=1;x/=10;if x==0 || n>=12 {break;}}m:=at;while n>0 {n-=1;if m<b.count {b[m]=d[n];m+=1;}}return m;}

// Probes for the browser journey (charactercreator.coax probe 20..25).
walk_probe :: (s:Creator,f:int)->int {
  w:=s.walk;
  if f==20 {return ifx !w.on then 0 else ifx w.went then 5 else ifx w.fade_at>=0 then 4 else ifx w.arrived_at>=0 then 3 else ifx w.t<CC_WALK_LEAD then 1 else 2;}
  if f==21 {return int(w.t*1000);}
  if f==22 {return int(walk_distance(w,w.t)*1000);}
  if f==23 {return ifx w.done then 1 else ifx w.failed then 2 else ifx w.acked then 0 else -1;}
  if f==24 {return w.loaded;}
  if f==25 {return w.total;}
  return -1;
}
