 s:[1]Creator;catalog(s[..],"C glade/nwn-biomes 9 60 244 20 12 0\n");#assert s[0].biomes_present;
 catalog(s[..],"C glade/nwn-biomes 9 0 244 20 0 0\n");#assert !s[0].biomes_present;
 catalog(s[..],"C glade/environment 3 6 250 20 3 0\n");#assert !s[0].biomes_present;
}
#test "comparison labels require their loaded catalog marker and reset on replacement" {
 s:[1]Creator;catalog(s[..],"C glade/environment 3 6 250 20 3 0\n");#assert !s[0].comparison_present;
 catalog(s[..],"C glade/nwn-comparison 9 60 247 20 12 0\n");#assert s[0].comparison_present;
 catalog(s[..],"C glade/nwn-comparison 9 0 247 20 0 0\n");#assert !s[0].comparison_present;
 catalog(s[..],"C glade/environment 3 6 250 20 3 0\n");#assert !s[0].comparison_present;
}
