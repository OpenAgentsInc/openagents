#test "creator explicit player save waits for storage confirmation and preserves a snapshot" {
  s:[1]Creator;ensure(s[..]);change(s[..],0,1);change(s[..],12,3);request_player(s[..],true);
  #assert s[0].profile_pending && s[0].profile_request && !s[0].profile_ok;
  bytes:[64]u8;for i:0..<56 {bytes[i]=s[0].profile_bytes[i];}
  change(s[..],4,1);player_reply(s[..],cast(string)bytes[0..<56]);
  #assert s[0].profile_ok && s[0].profile_go && s[0].profile_revision!=s[0].revision;
  request_player(s[..],false);player_reply(s[..],"");#assert s[0].profile_failed && !s[0].profile_pending && !s[0].profile_go;
}

// The explicit shared player profile is separate from automatic draft saving.
request_player :: (s:[]Creator,go:bool) {
 if s[0].profile_pending {return;}ensure(s);n:=save(s[0],s[0].profile_bytes[..]);if n!=56 {return;}
 s[0].profile_at=s[0].revision;s[0].profile_pending=true;s[0].profile_request=true;s[0].profile_want_go=go;s[0].profile_go=false;s[0].profile_failed=false;
}
player_reply :: (s:[]Creator,t:string) {
 if !s[0].profile_pending {return;}s[0].profile_pending=false;s[0].profile_request=false;
 same:=t.count==56;if same {for i:0..<56 {if t[i]!=s[0].profile_bytes[i] {same=false;}}}
 s[0].profile_failed=!same;s[0].profile_ok=same;s[0].profile_go=same && s[0].profile_want_go;
 if same {s[0].profile_revision=s[0].profile_at;}
}
load_player :: (s:[]Creator,t:string) {
 a:[1]appearance.CharacterAppearance;if !appearance.ca_restore(a[..],t) {return;}
 if !s[0].configured {ok:=restore(s,t);}
 b:[64]u8;n:=save(s[0],b[..]);same:=n==t.count;if same {for i:0..<n {if b[i]!=t[i] {same=false;}}}
 s[0].profile_ok=true;s[0].profile_revision=ifx same then s[0].revision else -1;
}
#test "creator shared player loads without overwriting a different working draft" {
 a:[1]Creator;ensure(a[..]);a[0].female=true;a[0].eye_color=3;b:[64]u8;n:=save(a[0],b[..]);
 s:[1]Creator;load_player(s[..],cast(string)b[0..<n]);#assert s[0].female && s[0].profile_ok && s[0].profile_revision==s[0].revision;
 change(s[..],4,1);load_player(s[..],cast(string)b[0..<n]);#assert s[0].dye==0 && s[0].profile_revision<0;
}
#test "creator source grass instances use a separate bounded static draw" {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
 catalog(s[..],"C glade/environment 9 12 250 100 8 0\nC glade/grass 21 465 250 164 20000 0\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;
 n:=scene(s[..],b[..],out[..]);#assert out[(n-1)*24+15]==17 && out[(n-1)*24]==164;
 #assert b[0].draws[(n-1)*4+2]==cast(u32)(n<<16) && b[0].draws[(n-1)*4+3]==20000;
 s[0].scene_only=true;n=scene(s[..],b[..],out[..]);#assert n==2;
 catalog(s[..],"C glade/grass 0 465 250 100 65536 0\n");#assert s[0].grass_groups==0;
}

#test "creator texture detail is bounded independently for desktop and phone layouts" {
 s:Creator;s.on=true;s.width=1440;#assert texture_side(s)==1024;
 s.width=390;#assert texture_side(s)==512;s.on=false;#assert texture_side(s)==0;
}
texture_side :: (s:Creator)->int {if !s.on {return 0;}return ifx s.width>=840*s.scale then 1024 else 512;}

#test "creator camera stays above terrain at every zoom pitch and pan limit" {
 s:[1]Creator;u:[104]f32;out:[64000]f32;
 for i:0..<3 {for j:0..<3 {for py:0..<3 {for px:0..<3 {
  s[0].dist=[3]f32.[0.65,3.1,6][i];s[0].pitch=[3]f32.[-0.2,0.1,0.6][j];s[0].pan_y=cast(f32)(py-1)*2;s[0].pan_x=cast(f32)(px-1)*2;
  camera(s[0],u[..],1440,900,1);
  #assert u[17]>=glade.cg_height(u[16],u[18])+0.2799 && u[22]<0;
 }}}}
}

#test "combat health labels retain class maximum and separate temporary HP" {
  b: [96] u8;
  #assert cc_hp_label(b[..],7,12,0)=="HP 7 / 12";
  #assert cc_hp_label(b[..],100,120,9)=="HP 100 / 120 + 9 TEMP";
  #assert cc_hp_label(b[..],0,30,0)=="HP 0 / 30";
}

#test "0 A.D. scene geometry keeps its distinct source catalog entry" {
 s:[1]Creator;catalog(s[..],"C glade/environment 9 12 250 100 8 0\nC glade/0ad 21 30 255 100 8 0\n");
 #assert s[0].glade_count==12 && s[0].zero_ad_first==21 && s[0].zero_ad_count==30;
}

#test "creator optional native Aribeth emits one bounded static frame" {
 storage:[1]aribeth.Aribeth;
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);s[0].aribeth=storage[..];
 catalog(s[..],"C glade/aribeth0 10 3 248 20 0 0\nC glade/aribeth1 13 3 248 28 0 0\nA aribeth walk 0 2 1000\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;s[0].scene_only=true;
 #assert scene(s[..],b[..],out[..])==0;s[0].experimental=true;s[0].clock=0.5;
 #assert scene(s[..],b[..],out[..])==1 && b[0].draw_n==1;
 #assert b[0].draws[0]==13 && b[0].draws[1]==3 && b[0].draws[3]==1;
 #assert out[7]==28 && out[15]==16 && out[23]==0;
 catalog(s[..],"");for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
 #assert scene(s[..],b[..],out[..])==0;
}
#test "creator scene reserves requested world draw slots" {
  s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);
  for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
  s[0].scene_only=true;s[0].experimental=true;s[0].glade_count=3;s[0].glade_word=100;
  s[0].grass_groups=3;for i:0..<3 {s[0].grass[i].first=3;s[0].grass[i].count=3;s[0].grass[i].n=1;}
  b[0].ready=true;n:=scene_reserved(s[..],b[..],out[..],43);
  #assert n==1 && b[0].draw_n==n;
}
