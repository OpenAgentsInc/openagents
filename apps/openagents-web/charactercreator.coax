 n:=frame(s[..],out[..],u[..],1920,1080,1,0,true);
 horizon:=u[27]+u[21]*u[19]/u[29];#assert horizon>1080*0.56 && horizon<1080*0.64;
 s[0].dist=0.65;n=frame(s[..],out[..],u[..],1920,1080,1,0,true);#assert u[21]<0;
}
#test "creator scene capture is a transient exact query flag" {
 #assert scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=1\n");
 #assert !scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=10\n");
 #assert !scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=0\n");
}
scene_capture :: (facts:string)->bool {
 if facts.count<8 {return false;}
 for i:0..<facts.count-7 {if facts[i..<i+8]=="?scene=1" || facts[i..<i+8]=="&scene=1" {e:=i+8;if e==facts.count || facts[e]=='\n' || facts[e]=='&' || facts[e]=='#' {return true;}}}return false;
}

#test "animation heading uses the smaller creator font and plus minus toggle" {
 s:Creator;s.preview_collapsed=true;s.height=720;s.scale=1;
 out:[64000]f32;expected:[4096]f32;n:=dev_hud(s,out[..],1280,720,1);
 e:=text(expected[..],0,"+ ANIMATIONS",32,45,10,ink(1,0.95,0.9,0.7));#assert n==e;
 for i:0..<n*16 {#assert out[i]==expected[i];}
 s.preview_collapsed=false;n=dev_hud(s,out[..],1280,720,1);
 e=text(expected[..],0,"- ANIMATIONS",32,45,10,ink(1,0.95,0.9,0.7));#assert n>e;
 for i:0..<e*16 {#assert out[i]==expected[i];}
}

