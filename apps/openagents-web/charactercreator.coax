// Aethyr's live Quaternius wardrobe. Shared people parts, skinning and baked clips;
// no cloned geometry or per-outfit skeleton. Used by fivelab's character-creator route.
#module "openagents.charactercreator";
#load "font.coax";
#load "charactercreator-parts.coax";
VERTEX_FLOATS :: 16;
#load "fivelab-bodies.coax" as figs;

Box :: struct { x0:f32; y0:f32; x1:f32; y1:f32; }
Creator :: struct {
  on:bool; configured:bool; female:bool; worn:[40]bool; piece:int = 18; source_first:[80]int; source_count:[80]int; source_word:[80]int; source_n:int; outfit:int = 2; hood:bool; hair:int; beard:bool;
  dye:int = 8; skin:int = 1; hair_color:int; eye_color:int; variant:int; pose:int;
  yaw:f32 = -0.22; pitch:f32 = 0.1; dist:f32 = 3.1;
  clock:f32; pose_at:f32; revision:int; saved:int; focused:int;
  width:f32; height:f32; scale:f32 = 1; mobile:bool;
  pan_mode:bool; drag_pan:bool; drag_button:int; pan_x:f32; pan_y:f32; boxes:[16]Box; down:int = -1; dragging:bool; drag_id:int; dx:f32; dy:f32;
}
DYES :: [9][3]f32.[[3]f32.[0.06,0.22,0.18],[3]f32.[0.38,0.04,0.065],[3]f32.[0.06,0.12,0.38],[3]f32.[0.72,0.65,0.48],[3]f32.[0.29,0.08,0.34],[3]f32.[0.055,0.055,0.07],[3]f32.[0.65,0.29,0.05],[3]f32.[0.22,0.36,0.46],[3]f32.[1,1,1]];
SKINS :: [6][3]f32.[[3]f32.[1,0.94,0.87],[3]f32.[0.91,0.79,0.67],[3]f32.[0.76,0.6,0.46],[3]f32.[0.61,0.43,0.31],[3]f32.[0.43,0.28,0.2],[3]f32.[0.28,0.17,0.13]];
HAIRS :: [6][3]f32.[[3]f32.[0.08,0.05,0.035],[3]f32.[0.29,0.13,0.055],[3]f32.[0.65,0.42,0.15],[3]f32.[0.48,0.085,0.035],[3]f32.[0.62,0.65,0.69],[3]f32.[0.23,0.075,0.3]];
EYES :: [6][3]f32.[[3]f32.[0.24,0.1,0.035],[3]f32.[0.08,0.35,0.75],[3]f32.[0.06,0.48,0.23],[3]f32.[0.8,0.48,0.06],[3]f32.[0.45,0.5,0.56],[3]f32.[0.45,0.12,0.65]];
FIELD_NAMES :: [13]string.["BODY", "CLOTHES", "HOOD", "COLORWAY", "CLOTH DYE", "SKIN TONE", "HAIR STYLE", "HAIR COLOR", "BEARD", "ANIMATION", "MODULAR PART", "WEAR SELECTED PART", "EYE COLOR"];

#test "creator body changes preserve choices and bind only matching parts" {
  s:[1]Creator;
  s[0].hood=true; s[0].beard=true; s[0].hair=2;
  a:=look(s[0]); #assert a.head==figs.BP_MALE_HEAD && a.extra==figs.BP_BEARD && a.hair<0;
  change(s[..],0,1); b:=look(s[0]);
  #assert b.female && b.outfit==figs.BP_FEMALE_PEASANT && b.robe==figs.BP_FEMALE_ROBE && b.extra==figs.BP_FEMALE_HOOD;
  change(s[..],2,1); b=look(s[0]); #assert b.extra<0 && b.hair==figs.BP_HAIR_BUZZED_FEMALE;
  #assert s[0].beard && s[0].hair==2;
}
#test "creator every outfit detail and color stays valid through wraparound" {
  s:[1]Creator;
  for field:0..<10 {
    for j:0..<17 { change(s[..],field,-1); l:=look(s[0]); p:[5]int; n:=figs.bd_parts(l,false,p[..]);
      #assert n>=2 && n<=5;
      for i:0..<n { #assert p[i]>=0 && p[i]<16; for k:0..<i { #assert p[k]!=p[i]; } }
      for c:0..<3 { #assert l.skin[c]>0 && l.skin[c]<=1 && l.dye[c]>=0 && l.dye[c]<=1; }
    }
  }
  before:=s[0].revision; change(s[..],-1,1); change(s[..],13,1); #assert s[0].revision==before;
}
#test "creator hit testing cancellation and narrow layout keep controls usable" {
  s:[1]Creator; layout(s[..],390,844,1);
  for i:0..<16 { b:=s[0].boxes[i]; #assert b.x0>=0 && b.x1<=390 && b.y1<=844 && b.y1-b.y0>=36; }
  b:=s[0].boxes[1]; x:=(b.x0+b.x1)/2; y:=(b.y0+b.y1)/2;
  handled:=pointer(s[..],x,y,0,7); handled=pointer(s[..],x,y,3,7); #assert s[0].outfit==2;
  handled=pointer(s[..],x,y,0,7); handled=pointer(s[..],x,y,2,7); #assert s[0].outfit==3;
}

cc_wrap :: (v:int,n:int)->int { return (v%n+n)%n; }
change :: (s:[]Creator,f:int,delta:int) {
  if f<0 || f>=13 { return; }
  if f==0 { s[0].female=!s[0].female; if !s[0].female && s[0].hair>2 {s[0].hair=2;} if !available(s[0],s[0].piece) {s[0].piece=18;} }
  if f==1 { s[0].outfit=cc_wrap(s[0].outfit+delta,4); preset(s,s[0].outfit); }
  if f==2 {s[0].hood=!s[0].hood; s[0].worn[26]=s[0].hood;}
  if f==3 { s[0].variant=cc_wrap(s[0].variant+delta,3); }
  if f==4 { s[0].dye=cc_wrap(s[0].dye+delta,9); }
  if f==5 { s[0].skin=cc_wrap(s[0].skin+delta,6); }
  if f==6 { s[0].hair=cc_wrap(s[0].hair+delta,ifx s[0].female then 4 else 3); }
  if f==7 { s[0].hair_color=cc_wrap(s[0].hair_color+delta,6); }
  if f==8 { s[0].beard=!s[0].beard; }
  if f==9 { s[0].pose=cc_wrap(s[0].pose+delta,4); s[0].pose_at=s[0].clock; }
  if f==10 { for attempt:0..<40 {s[0].piece=cc_wrap(s[0].piece+(ifx delta<0 then -1 else 1),40);if available(s[0],s[0].piece) {break;}} }
  if f==12 {s[0].eye_color=cc_wrap(s[0].eye_color+delta,6);}
  if f==11 && available(s[0],s[0].piece) { s[0].worn[s[0].piece]=!s[0].worn[s[0].piece]; s[0].hood=s[0].worn[26]; }
  s[0].focused=f; s[0].revision+=1;
}
look :: (s:Creator)->figs.BdLook {
  l:=figs.bd_look(6,ifx s.female then 0 else 1);
  l.female=s.female; l.outfit=ifx s.female then figs.BP_FEMALE_PEASANT else figs.BP_MALE_PEASANT;
  if s.outfit==1 { l.outfit=ifx s.female then figs.BP_FEMALE_RANGER else figs.BP_MALE_RANGER; }
  l.robe=ifx s.outfit==2 then (ifx s.female then figs.BP_FEMALE_ROBE else figs.BP_MALE_ROBE) else -1;
  l.head=ifx s.female then figs.BP_FEMALE_HEAD else figs.BP_MALE_HEAD;
  l.hair=-1; l.extra=-1;
  if s.hair<(ifx s.female then 3 else 2) {
    l.hair=ifx s.female then [3]int.[figs.BP_HAIR_LONG,figs.BP_HAIR_BUNS,figs.BP_HAIR_BUZZED_FEMALE][s.hair] else [3]int.[figs.BP_HAIR_PARTED,figs.BP_HAIR_BUZZED,figs.BP_HAIR_PARTED][s.hair];
  }
  if s.beard && !s.female { l.extra=figs.BP_BEARD; }
  if s.hood { l.hair=-1; if s.female || !s.beard {l.extra=ifx s.female then figs.BP_FEMALE_HOOD else figs.BP_MALE_HOOD;} }
  l.variant=s.variant; l.skin=SKINS[s.skin]; l.hair_rgb=HAIRS[s.hair_color];
  l.dye=[4]f32.[DYES[s.dye][0],DYES[s.dye][1],DYES[s.dye][2],ifx s.dye==8 then 0 else 1];
  return l;
}
// One preview, using the existing instance format and actual Quaternius skinned parts.
scene :: (s:Creator,b:[]figs.Bodies,out:[]f32)->int {
  b[0].draw_n=0;
  if !b[0].ready || !catalog_ready(s) { return 0; }
  l:=look(s); l.variant=0;
  a:figs.BdAnim; a.on=true; a.clip=[4]int.[figs.BD_IDLE,figs.BD_WALK,figs.BD_RUN,figs.BD_SPELL][s.pose];
  a.t0=s.pose_at; a.fade_at=-100; a.phase=(s.clock-s.pose_at)/figs.bd_seconds(a.clip); a.yaw=s.yaw;
  if s.pose==3 { dur:=figs.bd_seconds(figs.BD_SPELL); a.t0=s.pose_at+floor((s.clock-s.pose_at)/dur)*dur; }
  n:=0;
  for i:0..<40 { if s.worn[i] && available(s,i) && s.source_count[i+(ifx s.female then 0 else 40)]>0 {
    p:=i+ifx s.female then 0 else 40;
    figs.bd_record(a,l,s.source_word[p],false,s.clock,out,n);out[n*24+11]=f32(s.variant);
    b[0].draws[n*4]=cast(u32)s.source_first[p];b[0].draws[n*4+1]=cast(u32)s.source_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  } }
  parts:[3]int;pn:=0;
  if !s.worn[7] { parts[pn]=l.head;pn+=1; }
  if l.hair>=0 && !s.worn[7] && !s.worn[26] {parts[pn]=l.hair;pn+=1;}
  if l.extra==figs.BP_BEARD && !s.worn[7] {parts[pn]=l.extra;pn+=1;}
  for i:0..<pn {
    p:=parts[i];figs.bd_record(a,l,b[0].part_word[p],false,s.clock,out,n);
    b[0].draws[n*4]=cast(u32)b[0].part_first[p];b[0].draws[n*4+1]=cast(u32)b[0].part_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  for i:0..<n {for k:0..<3 {out[i*24+20+k]=EYES[s.eye_color][k];}out[i*24+23]=2;}
  b[0].draw_n=n;return n;
}

inside :: (b:Box,x:f32,y:f32)->bool { return x>=b.x0 && x<=b.x1 && y>=b.y0 && y<=b.y1; }
layout :: (s:[]Creator,w:f32,h:f32,k:f32) {
  s[0].width=w; s[0].height=h; s[0].scale=k; s[0].mobile=w<840*k;
  for i:0..<13 {
    col:=i/7; row:=i%7; x:=24*k+f32(col)*(w-286*k); y:=(164+f32(row)*76)*k;
    bw:=238*k; bh:=53*k;
    if s[0].mobile { col=i%2; row=i/2; bw=(w-36*k)/2; x=12*k+f32(col)*(bw+12*k); y=h-484*k+f32(row)*60*k; bh=42*k; }
    s[0].boxes[i]=Box.{x0=x,y0=y,x1=x+bw,y1=y+bh};
  }
  by:=h-56*k;
  s[0].boxes[13]=Box.{x0=24*k,y0=by,x1=150*k,y1=by+36*k};
  s[0].boxes[14]=Box.{x0=w-174*k,y0=by,x1=w-24*k,y1=by+36*k};
  s[0].boxes[15]=ifx s[0].mobile then Box.{x0=w/2+6*k,y0=h-124*k,x1=w-12*k,y1=h-82*k} else Box.{x0=w/2-110*k,y0=by,x1=w/2+110*k,y1=by+36*k};
}
value :: (s:Creator,f:int)->string {
  if f==0 { return ifx s.female then "FEMALE" else "MALE"; }
  if f==1 { return [4]string.["PEASANT","RANGER","WIZARD","NOBLE"][s.outfit]; }
  if f==2 { return ifx s.hood then "HOODED" else "UNCOVERED"; }
  if f==3 { return [3]string.["ORIGINAL","COLOR II","COLOR III"][s.variant]; }
  if f==4 { return [9]string.["PINE","WINE","MIDNIGHT","IVORY","PLUM","INK","OCHRE","SLATE","NO DYE"][s.dye]; }
  if f==5 { return [6]string.["PORCELAIN","SAND","HONEY","COPPER","UMBER","EBONY"][s.skin]; }
  if f==6 { if s.hood { return "UNDER HOOD"; } return ifx s.female then [4]string.["LONG","BUNS","CROPPED","NONE"][s.hair] else [3]string.["PARTED","CROPPED","NONE"][s.hair]; }
  if f==7 { return [6]string.["DARK","CHESTNUT","GOLD","AUBURN","SILVER","VIOLET"][s.hair_color]; }
  if f==8 { if s.female { return "MALE ONLY"; } return ifx s.beard then "BEARDED" else "CLEAN SHAVEN"; }
  if f==12 {return [6]string.["BROWN","BLUE","GREEN","AMBER","GRAY","VIOLET"][s.eye_color];}
  if f==10 { return PART_LABELS[s.piece]; }
  if f==11 {if !available(s,s.piece) {return "MALE ONLY";}return ifx s.worn[s.piece] then "ON" else "OFF";}
  return [4]string.["IDLE","WALK","RUN","CAST"][s.pose];
}
ink :: (k:f32,r:f32,g:f32,b:f32)->Ink { return Ink.{core=0.55*k,light=1,glow=0.5*k,red=r,green=g,blue=b,scale=k,sans=false}; }
text :: (out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,k:Ink)->int { return draw_text(out,n,t,x,y,cap,0.5,1.2,k,false,false); }
line :: (out:[]f32,n:int,x:f32,y:f32,bx:f32,by:f32,k:f32,r:f32,g:f32,b:f32)->int {
  if lit(out,n,x,y,bx,by,0.6*k,1,0,r,g,b,0) { return n+6; } return n;
}
frame :: (s:[]Creator,out:[]f32,u:[]f32,w:f32,h:f32,k:f32,dt:f32,still:bool)->int {
  ensure(s); layout(s,w,h,k); if !still && dt>0 && dt<1 { s[0].clock+=dt; }
  n:=0; white:=ink(k,0.91,0.92,0.9); dim:=ink(k,0.48,0.56,0.59); gold:=ink(k,0.83,0.69,0.43);
  n=text(out,n,"Character Create",24*k,54*k,(ifx s[0].mobile then 18 else 22)*k,white);
  for i:0..<13 {
    b:=s[0].boxes[i]; cap:=ifx s[0].mobile then 10.0f32 else 12.0f32;
    n=text(out,n,FIELD_NAMES[i],b.x0,b.y0-7*k,8*k,dim);
    selected:=s[0].focused==i;
    c:=ifx selected then gold else dim;
    n=line(out,n,b.x0,b.y1,b.x1,b.y1,k,c.red,c.green,c.blue);
    n=text(out,n,"<",b.x0+4*k,b.y0+cap*k+10*k,cap*k,c);
    value_cap:=ifx i==10 then (ifx s[0].mobile then 6.5f32 else 8.5f32) else cap;
    n=text(out,n,value(s[0],i),b.x0+25*k,b.y0+cap*k+10*k,value_cap*k,white);
    n=text(out,n,">",b.x1-14*k,b.y0+cap*k+10*k,cap*k,c);
    if i==4 || i==5 || i==7 || i==12 {
      rgb:=ifx i==4 then DYES[s[0].dye] else ifx i==5 then SKINS[s[0].skin] else ifx i==12 then EYES[s[0].eye_color] else HAIRS[s[0].hair_color];
      if lit(out,n,b.x0+26*k,b.y1-7*k,b.x1-26*k,b.y1-7*k,2*k,1,0,rgb[0],rgb[1],rgb[2],0) { n+=6; }
    }
  }
  for i:13..<15 { b:=s[0].boxes[i]; n=text(out,n,ifx i==13 then "RESET" else "SURPRISE ME",b.x0+10*k,b.y0+23*k,10*k,gold); }
  if s[0].mobile {b:=s[0].boxes[15];n=text(out,n,ifx s[0].pan_mode then "DRAG: PAN" else "DRAG: ROTATE",b.x0+10*k,b.y0+23*k,10*k,gold);}
  if !s[0].mobile {n=text(out,n,"LEFT DRAG: ROTATE / RIGHT DRAG: PAN / SCROLL: ZOOM",w*0.5-230*k,h-77*k,9*k,dim);}
  for i:0..<u.count { u[i]=0; }
  u[0]=w;u[1]=h;u[2]=s[0].clock;u[3]=1;u[4]=k;u[10]=2;u[11]=0;
  // A steady studio camera; dragging turns the figure, the wheel changes distance.
  dist:=s[0].dist; target:=1.0+0.58*cc_clamp((2.2-dist)/1.55,0,1);
  ey:=target+0.1+sin(s[0].pitch)*dist; ez:=cos(s[0].pitch)*dist;
  fy:=target-ey; fz:=-ez; length:=sqrt(fy*fy+fz*fz); fy/=length; fz/=length;
  focal:=ifx s[0].mobile then (h-624*k)*1.3 else h*0.89;
  u[16]=s[0].pan_x;u[17]=ey+s[0].pan_y*(-fz);u[18]=ez+s[0].pan_y*fy;u[19]=focal;
  u[20]=0;u[21]=fy;u[22]=fz;u[23]=w*0.5;
  u[24]=1;u[25]=0;u[26]=0;u[27]=ifx s[0].mobile then (h-384*k)*0.5 else h*0.52;
  u[28]=0;u[29]=-fz;u[30]=fy;
  u[32]=-0.4;u[33]=0.8;u[34]=0.6;
  return n;
}
pointer :: (s:[]Creator,x:f32,y:f32,phase:int,id:int)->bool {
  if phase==0 {
    for i:0..<(ifx s[0].mobile then 16 else 15) { if inside(s[0].boxes[i],x,y) { s[0].down=i; s[0].drag_id=id; return true; } }
    s[0].drag_pan=s[0].pan_mode;s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;return true;
  }
  if id!=s[0].drag_id { return true; }
  if phase==1 && s[0].dragging { if s[0].drag_pan {
      focal:=ifx s[0].mobile then (s[0].height-624*s[0].scale)*1.3 else s[0].height*0.89;
      units:=s[0].dist/(ifx focal>1 then focal else 1);
      s[0].pan_x=cc_clamp(s[0].pan_x-(x-s[0].dx)*units,-2,2);
      s[0].pan_y=cc_clamp(s[0].pan_y+(y-s[0].dy)*units,-2,2);
    } else {s[0].yaw+=(x-s[0].dx)*0.008/s[0].scale; s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.003/s[0].scale,-0.2,0.6); } s[0].dx=x;s[0].dy=y;return true; }
  if phase==2 || phase==3 {
    i:=s[0].down;s[0].down=-1;s[0].dragging=false;
    if phase==2 && i>=0 && inside(s[0].boxes[i],x,y) {
      if i<13 { change(s,i,ifx x<s[0].boxes[i].x0+22*s[0].scale then -1 else 1); }
      else if i==13 { reset(s); }
      else if i==15 {s[0].pan_mode=!s[0].pan_mode;}
      else { seed:=s[0].revision+7;for f:0..<9 { change(s,f,seed+f*3); } }
    }
  }
  return true;
}
key :: (s:[]Creator,k:int)->bool {
  if k=='p' || k=='P' {s[0].pan_mode=!s[0].pan_mode;return true;}
  if k==-15 { s[0].focused=(s[0].focused+1)%13;return true; }
  if k==-4 || k==-5 { change(s,s[0].focused,ifx k==-4 then -1 else 1);return true; }
  if k==' ' { change(s,9,1);return true; }
  return false;
}
wheel :: (s:[]Creator,dy:f32) { s[0].dist=cc_clamp(s[0].dist+dy*0.003,0.65,6); }
// Page identity is a bounded host fact, not a search over arbitrary message content.
page :: (facts:string)->bool {
  at:=0;
  while at<facts.count { e:=at;while e<facts.count && facts[e]!='\n' { e+=1; } fact:=facts[at..<e];at=e+1;
    if fact.count>=4 && fact[0..<4]=="url=" { url:=fact[4..<fact.count];start:=0;for j:0..<url.count-2 {if url[j..<j+3]=="://" {start=j+3;while start<url.count && url[start]!='/' {start+=1;} break;}}end:=start;while end<url.count && url[end]!='?' && url[end]!='#' { end+=1; } return url[start..<end]=="/worlds/character-creator" || url[start..<end]=="/worlds/character-creator/"; }
  }
  return false;
}

cc_clamp :: (v:f32,a:f32,b:f32)->f32 { if v<a {return a;} if v>b {return b;} return v; }

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { size = 0.01; dx = 0.01; dy = 0; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}

preset :: (s:[]Creator,family:int) {
  for i:0..<40 { s[0].worn[i]=false; }
  for i:0..<8 {p:=PART_PRESETS[family][i];if p>=0 && (!s[0].female || PART_NAMES[p].count>0) {s[0].worn[p]=true;}}
  s[0].hood=false;s[0].configured=true;
}
ensure :: (s:[]Creator) {if !s[0].configured {preset(s,s[0].outfit);}}
reset :: (s:[]Creator) { s[0].pan_x=0;s[0].pan_y=0;s[0].pan_mode=false;s[0].piece=18;s[0].female=false;s[0].outfit=2;s[0].hood=false;s[0].hair=0;s[0].beard=false;s[0].dye=8;s[0].skin=1;s[0].hair_color=0;s[0].eye_color=0;s[0].variant=0;s[0].pose=0;s[0].pose_at=s[0].clock;s[0].yaw=-0.22;s[0].pitch=0.1;s[0].dist=3.1;preset(s,2);s[0].revision+=1; }
catalog :: (s:[]Creator,t:string) {
  s[0].source_n=0;
  for i:0..<80 {s[0].source_count[i]=0;}
  at:=0;
  while at<t.count {e:=at;while e<t.count && t[e]!='\n' {e+=1;} row:=t[at..<e];at=e+1;
    if row.count<9 || row[0..<2]!="C " {continue;}
    ne:=figs.bd_word_end(row,2);name:=row[2..<ne];
    for i:0..<80 {if name==PART_NAMES[i] {
      p:=ne;s[0].source_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);
      s[0].source_count[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);
      s[0].source_word[i]=figs.bd_whole_at(row,p);
    }}
  }
  for i:0..<80 {if s[0].source_count[i]>0 {s[0].source_n+=1;}}
}
#test "creator available garments are selectable on both sexes and presets cover four outfits" {
  s:[1]Creator;ensure(s[..]);
  for family:0..<4 {preset(s[..],family);n:=0;for i:0..<40 {if s[0].worn[i] {n+=1;}}#assert n>=1 && n<=8;}
  for i:0..<40 {if !available(s[0],i) {continue;}s[0].piece=i;s[0].worn[i]=false;change(s[..],11,1);#assert s[0].worn[i];#assert PART_NAMES[i+40].count>8;}
}

#test "creator page identity accepts absolute host URLs and rejects other routes" { #assert page("url=http://127.0.0.1:8812/worlds/character-creator?x=1\n");#assert page("url=/worlds/character-creator/\n");#assert !page("url=https://openagents.com/worlds/5e-lab?next=/worlds/character-creator\n"); }

probe :: (s:Creator,f:int)->int {
  if f==0 {return s.source_n;} if f==1 {return s.outfit;}if f==2 {return ifx s.female then 1 else 0;}
  if f==3 {return s.variant;}if f==4 {return s.dye;}if f==5 {return s.skin;}if f==6 {return s.pose;}
  if f==7 {return s.piece;}if f==8 {return ifx s.worn[s.piece] then 1 else 0;}if f==9 {return s.revision;}if f==10 {return s.eye_color;}if f==11 {return int(s.pan_x*1000);}if f==12 {return int(s.pan_y*1000);}if f==13 {return int(s.yaw*1000);}
  return -1;
}
append :: (out:[]u8,at:int,t:string)->int {for i:0..<t.count {out[at+i]=t[i];}return at+t.count;}
#test "creator catalog resolves 76 source meshes and every worn part reaches a bounded GPU draw" {
  s:[1]Creator;b:[1]figs.Bodies;buf:[16384]u8;at:=0;
  for i:0..<80 {if PART_NAMES[i].count>0 {at=append(buf[..],at,"C ");at=append(buf[..],at,PART_NAMES[i]);at=append(buf[..],at," 100 300 7 600 100 65\n");}}
  catalog(s[..],cast(string)buf[0..<at]);#assert s[0].source_n==76;
  for i:0..<80 {if PART_NAMES[i].count>0 {#assert s[0].source_first[i]==100 && s[0].source_count[i]==300 && s[0].source_word[i]==600;}}
  b[0].ready=true;for i:0..<39 {s[0].worn[i]=true;}out:[44*24]f32;
  for body:0..<2 {s[0].female=body==1;n:=scene(s[0],b[..],out[..]);#assert n==26-body*1 && b[0].draw_n==n;
    for i:0..<n {#assert b[0].draws[i*4+2]==cast(u32)i && b[0].draws[i*4+3]==1;}
  }
}

// Versioned appearance only: no asset offsets, clocks or borrowed renderer state are persisted.
save :: (s:Creator,out:[]u8)->int {
  if out.count<56 {return 0;}
  out[0]='C';out[1]='C';out[2]='2';
  v:=[10]int.[ifx s.female then 1 else 0,s.outfit,ifx s.hood then 1 else 0,s.hair,ifx s.beard then 1 else 0,s.dye,s.skin,s.hair_color,s.variant,s.pose];
  for i:0..<10 {out[3+i]=cast(u8)('0'+v[i]);}
  out[13]=cast(u8)('0'+s.piece/10);out[14]=cast(u8)('0'+s.piece%10);
  for i:0..<40 {out[15+i]=ifx s.worn[i] then '1' else '0';}
  out[55]=cast(u8)(48+s.eye_color);return 56;
}
restore :: (s:[]Creator,t:string)->bool {
  legacy:=t.count==54 && t[0..<3]=="CC1";
  if !legacy && (t.count!=56 || t[0..<3]!="CC2") {return false;}
  if !legacy && (t[55]<'0' || t[55]>'5') {return false;}
  limits:=[12]int.[1,4,1,3,1,8,5,5,2,3,3,9];
  for i:0..<12 {if t[3+i]<'0' || int(t[3+i])>48+limits[i] {return false;}}
  piece:=int(t[13]-'0')*10+int(t[14]-'0');if piece>=40 {return false;}
  if t[3]=='0' && t[6]>'2' {return false;}
  for i:0..<(ifx legacy then 39 else 40) {if t[15+i]!='0' && t[15+i]!='1' {return false;}}
  if (t[5]=='1')!=((t[41]=='1') || (!legacy && t[54]=='1')) {return false;}
  next:=s[0];next.female=t[3]=='1';next.outfit=int(t[4]-'0');next.hood=t[5]=='1';next.hair=int(t[6]-'0');next.beard=t[7]=='1';next.dye=int(t[8]-'0');next.skin=int(t[9]-'0');next.hair_color=int(t[10]-'0');next.variant=int(t[11]-'0');next.pose=int(t[12]-'0');next.piece=piece;
  for i:0..<40 {next.worn[i]=i<(ifx legacy then 39 else 40) && t[15+i]=='1' && available(next,i);}
  next.eye_color=ifx legacy then 0 else int(t[55]-'0');
  if legacy {if next.outfit==3 {for i:0..<40 {next.worn[i]=i>=18 && i<=21;}next.hood=false;next.outfit=0;}else if next.outfit==4 {next.outfit=3;}}
  if !legacy && (next.outfit==4 || t[54]=='1') {for i:0..<40 {next.worn[i]=i==28 || i==29 || i==30 || i==31 || i==37 || i==38;}next.outfit=2;next.hood=false;}
  if !available(next,next.piece) {next.piece=18;}
  next.configured=true;next.pose_at=next.clock;next.revision+=1;next.saved=next.revision;s[0]=next;return true;
}
#test "creator appearance save round trips and malformed saves preserve the live choices" {
  a:[1]Creator;ensure(a[..]);change(a[..],1,1);change(a[..],3,2);change(a[..],4,3);a[0].piece=38;change(a[..],11,1);
  out:[64]u8;n:=save(a[0],out[..]);b:[1]Creator;ok:=restore(b[..],cast(string)out[0..<n]);#assert ok && b[0].outfit==a[0].outfit && b[0].variant==2 && b[0].piece==38 && b[0].worn[38]==a[0].worn[38];
  for i:0..<56 {old:=out[i];out[i]='x';before:=b[0].revision;#assert !restore(b[..],cast(string)out[0..<n]) && b[0].revision==before;out[i]=old;}
  #assert !restore(b[..],cast(string)out[0..<53]);
}

available :: (s:Creator,p:int)->bool {return p>=0 && p<40 && PART_SELECTABLE[p] && PART_NAMES[p+(ifx s.female then 0 else 40)]!="";}
catalog_ready :: (s:Creator)->bool {for i:0..<80 {if PART_NAMES[i]!="" && s.source_count[i]<=0 {return false;}}return true;}


#test "creator hood keeps beard in actual draw list and crown cannot be worn" {
  s:[1]Creator;ensure(s[..]);change(s[..],8,1);change(s[..],2,1);
  #assert s[0].beard && s[0].hood && look(s[0]).extra==figs.BP_BEARD;
  b:[1]figs.Bodies;b[0].ready=true;s[0].source_n=76;for i:0..<80 {if PART_NAMES[i]!="" {s[0].source_count[i]=1;}}b[0].part_word[figs.BP_BEARD]=12345;
  out:[44*24]f32;n:=scene(s[0],b[..],out[..]);found:=false;
  for i:0..<n {if out[i*24+7]==12345 {found=true;}}#assert found;
  s[0].piece=15;change(s[..],10,1);#assert s[0].piece==17;
  s[0].piece=16;change(s[..],11,1);#assert !s[0].worn[16] && !available(s[0],16);
  bytes:[64]u8;s[0].worn[16]=true;size:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<size]) && !t[0].worn[16] && t[0].beard && t[0].hood;
}
#test "creator zoom reaches face distance and stays bounded" {
  s:[1]Creator;wheel(s[..],-10000);#assert s[0].dist>=0.6 && s[0].dist<=0.7;
  wheel(s[..],10000);#assert s[0].dist==6;
}

#test "creator pan moves camera without turning and reset centers it" {
  s:[1]Creator;layout(s[..],1440,900,1);s[0].dist=0.65;
  #assert key(s[..],'p') && s[0].pan_mode;
  yaw:=s[0].yaw;pitch:=s[0].pitch;
  ok:=pointer(s[..],700,400,0,31);ok=pointer(s[..],800,550,1,31);ok=pointer(s[..],800,550,2,31);
  #assert s[0].pan_x<0 && s[0].pan_y>0 && s[0].yaw==yaw && s[0].pitch==pitch;
  reset(s[..]);#assert s[0].pan_x==0 && s[0].pan_y==0 && !s[0].pan_mode;
}
#test "creator removed outfit saves migrate and removed part stays unavailable" {
  s:[1]Creator;ensure(s[..]);s[0].outfit=4;s[0].worn[39]=true;s[0].hood=true;s[0].eye_color=3;
  bytes:[64]u8;n:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<n]) && t[0].outfit==2 && !t[0].worn[39] && t[0].eye_color==3;
  #assert !available(t[0],39);
}

#test "creator mouse buttons select rotate or pan per drag without a toggle" {
  s:[1]Creator;layout(s[..],1440,900,1);s[0].pan_mode=true;
  yaw:=s[0].yaw;ok:=mouse_pointer(s[..],700,400,0,31,0);ok=mouse_pointer(s[..],800,450,1,31,-1);ok=mouse_pointer(s[..],800,450,2,31,0);
  #assert s[0].yaw>yaw && s[0].pan_x==0 && s[0].pan_y==0;
  yaw=s[0].yaw;pitch:=s[0].pitch;
  ok=mouse_pointer(s[..],700,400,0,31,2);ok=mouse_pointer(s[..],800,550,1,31,-1);
  #assert s[0].pan_x<0 && s[0].pan_y>0 && s[0].yaw==yaw && s[0].pitch==pitch;
  ok=mouse_pointer(s[..],800,550,2,31,0);#assert s[0].dragging;
  ok=mouse_pointer(s[..],800,550,2,31,2);#assert !s[0].dragging;
  before:=s[0].outfit;ok=mouse_pointer(s[..],250,250,0,31,2);ok=mouse_pointer(s[..],250,250,2,31,2);#assert s[0].outfit==before;
}

// DOM button numbers: left 0, right 2. Latch the gesture on down; moves may report -1.
mouse_pointer :: (s:[]Creator,x:f32,y:f32,phase:int,id:int,button:int)->bool {
  if phase==0 {
    if s[0].dragging || (button!=0 && button!=2) {return true;}
    s[0].drag_button=button;
    if button==2 {s[0].down=-1;s[0].dragging=true;s[0].drag_pan=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;return true;}
    used:=pointer(s,x,y,phase,id);s[0].drag_pan=false;return used;
  }
  if phase==2 && button!=s[0].drag_button {return true;}
  return pointer(s,x,y,phase,id);
}

#test "creator registry identities preserve CC2 wardrobe keys and require complete referenced meshes" {
  #assert PART_IDS[19]=="quaternius/fantasy/female-peasant-body";
  #assert PART_IDS[59]=="quaternius/fantasy/male-peasant-body";
  #assert !PART_SELECTABLE[16] && !PART_SELECTABLE[39];
  s:[1]Creator;b:[65536]u8;n:=0;
  for i:0..<80 {if PART_NAMES[i]!="" {n=append(b[..],n,"C ");n=append(b[..],n,PART_NAMES[i]);n=append(b[..],n," 100 300 7 600 100 65\n");}}
  catalog(s[..],cast(string)b[0..<n]);#assert catalog_ready(s[0]);
  s[0].source_count[19]=0;#assert !catalog_ready(s[0]);
  s[0].worn[19]=true;bytes:[64]u8;size:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<size]) && t[0].worn[19];
}
