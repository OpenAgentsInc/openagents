  #assert n>1 && out[(n-1)*24+15]==16 && out[(n-1)*24+7]==100;
  #assert b[0].draws[(n-1)*4]==9 && b[0].draws[(n-1)*4+1]==12;
  saved:[64]u8;size:=save(s[0],saved[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)saved[0..<size]) && t[0].glade_count==0;
  catalog(s[..],"C other 0 3 1 0 3 65\n");#assert s[0].glade_count==0;
}

