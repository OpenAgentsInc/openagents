  #assert s[0].beard && s[0].hood && look(s[0]).extra==figs.BP_BEARD;
  b:[1]figs.Bodies;b[0].ready=true;s[0].source_n=76;for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=1;}}b[0].part_word[figs.BP_BEARD]=12345;
  out:[44*24]f32;n:=scene(s[0],b[..],out[..]);found:=false;
  for i:0..<n {if out[i*24+7]==12345 {found=true;}}#assert found;
  s[0].piece=15;change(s[..],10,1);#assert s[0].piece==17;
  s[0].piece=16;change(s[..],11,1);#assert !s[0].worn[16] && !available(s[0],16);
  bytes:[64]u8;s[0].worn[16]=true;size:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<size]) && !t[0].worn[16] && t[0].beard && t[0].hood;
}
