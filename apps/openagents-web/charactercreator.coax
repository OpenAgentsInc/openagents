// Aethyr's live Quaternius wardrobe. Shared people parts, skinning and baked clips;
// no cloned geometry or per-outfit skeleton. Used by fivelab's character-creator route.
#module "openagents.charactercreator";
#load "font.coax";
#load "../../verse/character-glade.coax" as glade;
#load "../../verse/experimental-terrain.coax" as meadow;
#load "../../verse/experimental-village.coax" as village;
#load "../../aethyr/follow.coax" as follow;
#load "../../aethyr/query.coax" as query;
#load "../../aethyr/space.coax" as world;
#load "charactercreator-font.coax";
#load "../../verse/experimental-hostiles.coax" as hostile;
#load "charactercreator-walk.coax";
#load "../../aethyr/character-appearance.coax" as appearance;
VERTEX_FLOATS :: 16;
#load "fivelab-bodies.coax" as figs;

// Shared with Everglade II: sampled frames over the last half second.
FpsCounter :: struct {fps:f32;frames:int;time:f32;}
#test "shared FPS counts real frames and draws at the bottom right" {
 f:[1]FpsCounter;for i:0..<40 {fps_count(f[..],1.0f32/60);}#assert abs(f[0].fps-60)<0.5;
 for i:0..<30 {fps_count(f[..],1.0f32/30);}#assert abs(f[0].fps-30)<0.5;
 before:=f[0];fps_count(f[..],0);fps_count(f[..],1.1);#assert f[0].frames==before.frames && f[0].time==before.time;
 out:[4096]f32;n:=fps_draw(f[0],out[..],0,1280,720,1);#assert n>0;
 for i:0..<n {#assert out[i*16]>=1050 && out[i*16+1]>=650 && out[i*16+11]==MODE_SANS;}
}
fps_count :: (f:[]FpsCounter,dt:f32) {
 if !(dt>0) || dt>1 {return;}f[0].frames+=1;f[0].time+=dt;
 if f[0].time>=0.5 {f[0].fps=f32(f[0].frames)/f[0].time;f[0].frames=0;f[0].time=0;}
}
fps_draw :: (f:FpsCounter,out:[]f32,at:int,w:f32,h:f32,k:f32)->int {
 buf:[16]u8;n:=0;v:=cast(int)(f.fps+0.5);if v>999 {v=999;}
 if v>=100 {buf[n]=cast(u8)(48+v/100);n+=1;}if v>=10 {buf[n]=cast(u8)(48+v/10%10);n+=1;}buf[n]=cast(u8)(48+v%10);n+=1;
 buf[n]=32;buf[n+1]=70;buf[n+2]=80;buf[n+3]=83;n+=4;cap:=13*k;em:=sans_em(cap);wide:f32=0;
 for i:0..<n {wide+=f32(CC_FONT_WIDTH[cast(int)buf[i]-32])/f32(CC_FONT_UPM)*em;}
 return text(out,at,cast(string)buf[0..<n],w-16*k-wide,h-16*k,cap,ink(k,0.95,0.93,0.82));
}
Box :: struct { x0:f32; y0:f32; x1:f32; y1:f32; }
GrassDraw :: struct {first:int;count:int;word:int;n:int;}
Creator :: struct {
  experimental:bool; fps:[1]FpsCounter; dev_animations:bool; preview_collapsed:bool; preview_hover:bool; preview_clip:int = -1; preview_scroll:int; preview_down:int = -1; preview_at:f32; airborne:bool; air_at:f32; land_at:f32 = -100; player_x:f32; player_y:f32; player_z:f32; player_face:f32; moving:bool;
  on:bool; configured:bool; scene_only:bool; female:bool; worn:[40]bool; piece:int = 18; source_first:[80]int; source_count:[80]int; source_word:[80]int; source_n:int;glade_first:int;glade_count:int;glade_word:int;animal_first:[10]int;animal_count:[10]int;animal_n:int;monster_first:[48]int;monster_count:[48]int;monster_n:int;npc_first:[2][48]int;npc_count:[2][48]int;npc_n:[2]int;hostiles:[1]hostile.Hostiles;grass:[3]GrassDraw;grass_groups:int; outfit:int = 2; hood:bool; hair:int; beard:bool;
  dye:int = 8; skin:int = 1; hair_color:int; eye_color:int; variant:int; pose:int;
  yaw:f32 = -0.22; pitch:f32 = 0.1; dist:f32 = 3.1; camera_room:f32 = -1;
  clock:f32; surprise_seed:int; pose_at:f32; revision:int; saved:int; focused:int;
  width:f32; height:f32; scale:f32 = 1; mobile:bool;
  pan_mode:bool; drag_pan:bool; drag_button:int; pan_x:f32; pan_y:f32; profile_request:bool;profile_pending:bool;profile_ok:bool;profile_failed:bool;profile_go:bool;profile_want_go:bool;profile_revision:int = -1;profile_at:int;profile_bytes:[56]u8; boxes:[18]Box; down:int = -1; dragging:bool; drag_id:int; dx:f32; dy:f32;
  klass:int = -1;
  dev_below:f32;   // CSS px under the ANIMATIONS browser kept for Experimental's CLASSES column (experimental-combat.coax)   // the SRD 5.2.1 class the record keeps (CC3, aethyr/character-appearance.coax), -1 none (CC2)
  walk:CcWalk;   // the walk into Everglade after USE IN EVERGLADE (charactercreator-walk.coax)
  shadow:[1]CcShadow;   // the key light's two shadow tiles (shadow_frame)
}
// World-space feet, in metres. Match the FPS counter's right edge and font.
coord_number :: (out:[]u8,at:int,number:f32)->int {
 n:=at;q:=cast(int)(abs(number)*10+0.5);if number<0 && q>0 {out[n]='-';n+=1;}
 whole:=q/10;digits:[12]u8;count:=0;while whole>=10 {digits[count]=cast(u8)(48+whole%10);count+=1;whole/=10;}digits[count]=cast(u8)(48+whole);count+=1;
 while count>0 {count-=1;out[n]=digits[count];n+=1;}out[n]='.';out[n+1]=cast(u8)(48+q%10);return n+2;
}
coord_label :: (out:[]u8,x:f32,y:f32,z:f32)->string {
 n:=0;out[n]='X';out[n+1]=' ';n=coord_number(out,n+2,x);out[n]=' ';out[n+1]=' ';out[n+2]='Y';out[n+3]=' ';n=coord_number(out,n+4,y);out[n]=' ';out[n+1]=' ';out[n+2]='Z';out[n+3]=' ';n=coord_number(out,n+4,z);return cast(string)out[0..<n];
}
coord_draw :: (s:Creator,out:[]f32,at:int,w:f32,h:f32,k:f32)->int {
 b:[64]u8;label:=coord_label(b[..],s.player_x,meadow.exp_height(s.player_x,s.player_z)+s.player_y,s.player_z);cap:=10*k;em:=sans_em(cap);wide:f32=0;
 for c:label {wide+=f32(CC_FONT_WIDTH[cast(int)c-32])/f32(CC_FONT_UPM)*em;}
 return text(out,at,label,w-16*k-wide,h-38*k,cap,ink(k,0.95,0.93,0.82));
}
#test "coordinates show signed world positions at one decimal" {
 b:[64]u8;#assert coord_label(b[..],-32.37,5.0,0)=="X -32.4  Y 5.0  Z 0.0";
 #assert coord_label(b[..],0.04,-0.05,12.25)=="X 0.0  Y -0.1  Z 12.3";
}
#test "coordinates sit above the bottom-right FPS counter" {
 s:Creator;s.player_x= -32;s.player_z= -48;out:[4096]f32;n:=coord_draw(s,out[..],0,1280,720,1);#assert n>0;
 for i:0..<n {#assert out[i*16]>850 && out[i*16+1]>620 && out[i*16+1]<700 && out[i*16+11]==MODE_SANS;}
}
// ---- the key light's shadow tiles (#13016, as Everglade's: aethyr/render/cascades.coax)
// The glade holds still and the sun is fixed, so its shadow map is drawn once, into the atlas's left
// tile, and again only when a pack installs (at most once every CC_SHADOW_STALE frames). Only the
// player moves: she is drawn every frame into the right tile, through the same projection
// (gpu/character-glade.coax cg_shadow_clip), and a surface takes the darker of the two. Until the
// host opens the atlas (shadow_event 0) the one map is drawn every frame, as before.
CC_SHADOW_STALE :: 30;
CcShadow :: struct { on:bool; coarse:bool; glade:bool; now:bool; frame:int; pending:bool; last:int = -30; }
// The size of a tile: the one map's, 2048 (1024 on a phone).
cc_shadow_tile :: (coarse:bool)->int {return ifx coarse then 1024 else 2048;}
shadow_atlas :: (s:Creator,coarse:bool,which:int)->int {
  if !s.on {return 0;}
  return cc_shadow_tile(coarse)*(ifx which==0 then 2 else 1);
}
// The frame: whether the glade's tile is drawn too (u[10] 3) or only hers (4); 2 without tiles.
shadow_frame :: (s:[]Creator)->f32 {
  h:=s[0].shadow[..];
  if !h[0].on {return 2;}
  h[0].frame+=1;
  if h[0].pending && h[0].frame-h[0].last>=CC_SHADOW_STALE {h[0].glade=true;h[0].pending=false;h[0].last=h[0].frame;}
  h[0].now=h[0].glade;h[0].glade=false;
  return ifx h[0].now then 3.0f32 else 4.0f32;
}
// The host's fields (Everglade's: everglade.coax everglade_shadow_field): 0 the tile drawn (1 hers,
// 0 when the glade's is drawn too), 1 to 4 the rect drawn in, 5 her character pass (none here), 6
// the tiles, 7 those cleared first, 16 + 4 k tile k's rect.
shadow_field :: (s:Creator,field:int)->int {
  h:=s.shadow[0];
  if !s.on || !h.on {return -1;}
  t:=cc_shadow_tile(h.coarse);
  if field==6 {return 2;}
  if field>=16 && field<24 {j:=(field-16)%4;k:=(field-16)/4;return ifx j==0 then k*t else ifx j==1 then 0 else t;}
  if field==0 {return ifx h.now then 0 else 1;}
  if field==1 {return ifx h.now then 0 else t;}
  if field==2 {return 0;}
  if field==3 {return ifx h.now then 2*t else t;}
  if field==4 {return t;}
  if field==5 {return 0;}
  if field==7 {return ifx h.now then 3 else 2;}
  return -1;
}
// kind 0 the host made the atlas (arg 1 a phone's): the glade is drawn next frame; 1 geometry
// installed; 2 it could not draw this frame: the glade again if it was due.
shadow_event :: (s:[]Creator,kind:int,arg:int) {
  h:=s[0].shadow[..];
  if kind==0 {h[0]=CcShadow.{on=true,coarse=arg!=0,glade=true};}
  else if kind==1 {h[0].pending=true;}
  else if kind==2 {if h[0].now {h[0].glade=true;} h[0].now=false;}
}
#test "Character Create's shadow tiles: the glade once and on installs, rate-limited; her tile every frame" {
  c:[1]Creator;
  #assert shadow_frame(c[..])==2 && shadow_field(c[0],0)==-1 && shadow_atlas(c[0],false,0)==0;
  c[0].on=true;
  #assert shadow_atlas(c[0],false,0)==4096 && shadow_atlas(c[0],false,1)==2048 && shadow_atlas(c[0],true,0)==2048 && shadow_atlas(c[0],true,1)==1024;
  shadow_event(c[..],0,0);
  #assert shadow_frame(c[..])==3 && shadow_field(c[0],0)==0 && shadow_field(c[0],7)==3 && shadow_field(c[0],3)==4096 && shadow_field(c[0],1)==0;
  for f:0..<200 {#assert shadow_frame(c[..])==4 && shadow_field(c[0],0)==1 && shadow_field(c[0],7)==2 && shadow_field(c[0],1)==2048 && shadow_field(c[0],3)==2048;}
  #assert shadow_field(c[0],6)==2 && shadow_field(c[0],16)==0 && shadow_field(c[0],20)==2048 && shadow_field(c[0],23)==2048 && shadow_field(c[0],21)==0 && shadow_field(c[0],5)==0 && shadow_field(c[0],24)==-1;
  // a pack a frame: the glade at most once in CC_SHADOW_STALE frames
  glade:=0;
  for f:0..<CC_SHADOW_STALE*4 {shadow_event(c[..],1,0);if shadow_frame(c[..])==3 {glade+=1;}}
  #assert glade>=3 && glade<=4;
  // a dropped glade frame draws it again next
  c[0].shadow[0].pending=false;c[0].shadow[0].glade=true;
  #assert shadow_frame(c[..])==3;
  shadow_event(c[..],2,0);
  #assert shadow_frame(c[..])==3 && shadow_frame(c[..])==4;
  shadow_event(c[..],2,0);   // her frame dropped: nothing owed
  #assert shadow_frame(c[..])==4;
  // a phone's tiles
  shadow_event(c[..],0,1);_:=shadow_frame(c[..]);
  #assert shadow_field(c[0],3)==2048 && shadow_field(c[0],4)==1024;
}
DYES :: appearance.CA_DYES;
SKINS :: appearance.CA_SKINS;
HAIRS :: appearance.CA_HAIRS;
EYES :: appearance.CA_EYES;
FIELD_NAMES :: [13]string.["BODY", "CLOTHES", "HOOD", "COLORWAY", "CLOTH DYE", "SKIN TONE", "HAIR STYLE", "HAIR COLOR", "BEARD", "ANIMATION", "MODULAR PART", "WEAR SELECTED PART", "EYE COLOR"];

#test "creator body changes preserve choices and bind only matching parts" {
  s:[1]Creator;
  s[0].hood=true; s[0].beard=true; s[0].hair=2;
  a:=look(s[0]); #assert a.head==figs.BP_MALE_HEAD && a.extra==figs.BP_BEARD && a.hair<0;
  change(s[..],0,1); b:=look(s[0]);
  #assert b.female && b.outfit==figs.BP_FEMALE_PEASANT && b.robe==figs.BP_FEMALE_ROBE && b.extra==figs.BP_FEMALE_HOOD;
  change(s[..],2,1); b=look(s[0]); #assert b.extra<0 && b.hair==figs.BP_HAIR_BUZZED_FEMALE;
  #assert s[0].beard && s[0].hair==2;
}
#test "creator every outfit detail and color stays valid through wraparound" {
  s:[1]Creator;
  for field:0..<10 {
    for j:0..<17 { change(s[..],field,-1); l:=look(s[0]); p:[5]int; n:=figs.bd_parts(l,false,p[..]);
      #assert n>=2 && n<=5;
      for i:0..<n { #assert p[i]>=0 && p[i]<16; for k:0..<i { #assert p[k]!=p[i]; } }
      for c:0..<3 { #assert l.skin[c]>0 && l.skin[c]<=1 && l.dye[c]>=0 && l.dye[c]<=1; }
    }
  }
  before:=s[0].revision; change(s[..],-1,1); change(s[..],13,1); #assert s[0].revision==before;
}
#test "creator hit testing cancellation and narrow layout keep controls usable" {
  s:[1]Creator; layout(s[..],390,844,1);
  for i:0..<18 { b:=s[0].boxes[i]; #assert b.x0>=0 && b.x1<=390 && b.y1<=844 && b.y1-b.y0>=36; }
  b:=s[0].boxes[1]; x:=(b.x0+b.x1)/2; y:=(b.y0+b.y1)/2;
  handled:=pointer(s[..],x,y,0,7); handled=pointer(s[..],x,y,3,7); #assert s[0].outfit==2;
  handled=pointer(s[..],x,y,0,7); handled=pointer(s[..],x,y,2,7); #assert s[0].outfit==3;
}

#test "creator Surprise Me independently varies hood body outfits and eye colors" {
 s:[1]Creator;ensure(s[..]);layout(s[..],1440,900,1);
 h:[2]bool;bodies:[2]bool;outfits:[4]bool;eyes:[6]bool;repeated_hood:=false;last:=false;
 for i:0..<96 {b:=s[0].boxes[14];used:=pointer(s[..],b.x0+20,b.y0+18,0,1);used=pointer(s[..],b.x0+20,b.y0+18,2,1);
  h[ifx s[0].hood then 1 else 0]=true;bodies[ifx s[0].female then 1 else 0]=true;outfits[s[0].outfit]=true;eyes[s[0].eye_color]=true;
  #assert s[0].worn[26]==s[0].hood && s[0].hair<(ifx s[0].female then 4 else 3);
  if i>0 && s[0].hood==last {repeated_hood=true;}last=s[0].hood;
 }
 #assert h[0] && h[1] && bodies[0] && bodies[1] && repeated_hood;
 for seen:outfits {#assert seen;}for seen:eyes {#assert seen;}
}

// Separate draws choose values directly; preset selection must precede the hood draw.
// The UI clock seeds a persistent Park-Miller sequence; edits do not reset it.
surprise_pick :: (s:[]Creator,n:int)->int {
 if s[0].surprise_seed<=0 {s[0].surprise_seed=cc_wrap(int(s[0].clock*1000)+s[0].revision+1,2147483646)+1;}
 s[0].surprise_seed=(s[0].surprise_seed*48271)%2147483647;return s[0].surprise_seed%n;
}
surprise :: (s:[]Creator) {
 s[0].female=surprise_pick(s,2)==1;s[0].outfit=surprise_pick(s,4);preset(s,s[0].outfit);
 s[0].hood=surprise_pick(s,2)==1;s[0].worn[26]=s[0].hood;
 s[0].variant=surprise_pick(s,3);s[0].dye=surprise_pick(s,9);s[0].skin=surprise_pick(s,6);
 s[0].hair=surprise_pick(s,ifx s[0].female then 4 else 3);s[0].hair_color=surprise_pick(s,6);s[0].beard=surprise_pick(s,2)==1;s[0].eye_color=surprise_pick(s,6);
 if !available(s[0],s[0].piece) {s[0].piece=18;}s[0].revision+=1;
}

cc_wrap :: (v:int,n:int)->int { return (v%n+n)%n; }
change :: (s:[]Creator,f:int,delta:int) {
  if f<0 || f>=13 { return; }
  if f==0 { s[0].female=!s[0].female; if !s[0].female && s[0].hair>2 {s[0].hair=2;} if !available(s[0],s[0].piece) {s[0].piece=18;} }
  if f==1 { s[0].outfit=cc_wrap(s[0].outfit+delta,4); preset(s,s[0].outfit); }
  if f==2 {s[0].hood=!s[0].hood; s[0].worn[26]=s[0].hood;}
  if f==3 { s[0].variant=cc_wrap(s[0].variant+delta,3); }
  if f==4 { s[0].dye=cc_wrap(s[0].dye+delta,9); }
  if f==5 { s[0].skin=cc_wrap(s[0].skin+delta,6); }
  if f==6 { s[0].hair=cc_wrap(s[0].hair+delta,ifx s[0].female then 4 else 3); }
  if f==7 { s[0].hair_color=cc_wrap(s[0].hair_color+delta,6); }
  if f==8 { s[0].beard=!s[0].beard; }
  if f==9 { s[0].pose=cc_wrap(s[0].pose+delta,4); s[0].pose_at=s[0].clock; }
  if f==10 { for attempt:0..<40 {s[0].piece=cc_wrap(s[0].piece+(ifx delta<0 then -1 else 1),40);if available(s[0],s[0].piece) {break;}} }
  if f==12 {s[0].eye_color=cc_wrap(s[0].eye_color+delta,6);}
  if f==11 && available(s[0],s[0].piece) { s[0].worn[s[0].piece]=!s[0].worn[s[0].piece]; s[0].hood=s[0].worn[26]; }
  s[0].focused=f; s[0].revision+=1;
}
look :: (s:Creator)->figs.BdLook {
  l:=figs.bd_look(6,ifx s.female then 0 else 1);
  l.female=s.female; l.outfit=ifx s.female then figs.BP_FEMALE_PEASANT else figs.BP_MALE_PEASANT;
  if s.outfit==1 { l.outfit=ifx s.female then figs.BP_FEMALE_RANGER else figs.BP_MALE_RANGER; }
  l.robe=ifx s.outfit==2 then (ifx s.female then figs.BP_FEMALE_ROBE else figs.BP_MALE_ROBE) else -1;
  l.head=ifx s.female then figs.BP_FEMALE_HEAD else figs.BP_MALE_HEAD;
  l.hair=-1; l.extra=-1;
  if s.hair<(ifx s.female then 3 else 2) {
    l.hair=ifx s.female then [3]int.[figs.BP_HAIR_LONG,figs.BP_HAIR_BUNS,figs.BP_HAIR_BUZZED_FEMALE][s.hair] else [3]int.[figs.BP_HAIR_PARTED,figs.BP_HAIR_BUZZED,figs.BP_HAIR_PARTED][s.hair];
  }
  if s.beard && !s.female { l.extra=figs.BP_BEARD; }
  if s.hood { l.hair=-1; if s.female || !s.beard {l.extra=ifx s.female then figs.BP_FEMALE_HOOD else figs.BP_MALE_HOOD;} }
  l.variant=s.variant; l.skin=SKINS[s.skin]; l.hair_rgb=HAIRS[s.hair_color];
  l.dye=[4]f32.[DYES[s.dye][0],DYES[s.dye][1],DYES[s.dye][2],ifx s.dye==8 then 0 else 1];
  return l;
}
// One preview, using the existing instance format and actual Quaternius skinned parts.
// The local-only animation browser uses the Character Create font atlas.
// dev_below: CSS px kept free under the browser (Experimental's CLASSES column, experimental-combat.coax)
dev_visible :: (s:Creator)->int {n:=cast(int)((s.height/s.scale-116-s.dev_below)/24);if n<1 {return 1;}if n>figs.PREVIEW_BAKED {return figs.PREVIEW_BAKED;}return n;}
dev_scroll :: (s:[]Creator,dy:f32) {
 n:=s[0].preview_scroll+cast(int)(dy/32);if n==s[0].preview_scroll && dy!=0 {n+=ifx dy>0 then 1 else -1;}
 limit:=figs.PREVIEW_BAKED-dev_visible(s[0]);if n<0 {n=0;}if n>limit {n=limit;}s[0].preview_scroll=n;
}
dev_pointer :: (s:[]Creator,x:f32,y:f32,phase:int)->bool {
 if !s[0].dev_animations {return false;}k:=s[0].scale;
 bottom:=ifx s[0].preview_collapsed then 52*k else s[0].height-(20+s[0].dev_below)*k;inside_panel:=x>=12*k && x<=370*k && y>=20*k && y<=bottom;
 s[0].preview_hover=inside_panel && !s[0].preview_collapsed;
 if phase==0 {s[0].preview_down= -1;if !inside_panel {return false;}
  if y<52*k {s[0].preview_down= -3;return true;}
  if y>=58*k && y<86*k {s[0].preview_down= -2;return true;}
  row:=cast(int)((y/k-92)/24);if y>=92*k && row>=0 && row<dev_visible(s[0]) {s[0].preview_down=s[0].preview_scroll+row;}return true;}
 if s[0].preview_down== -1 {return inside_panel;}
 if phase==2 {p:=s[0].preview_down;if p== -3 && x>=12*k && x<=370*k && y>=20*k && y<52*k {s[0].preview_collapsed=!s[0].preview_collapsed;s[0].preview_hover=false;}
  else if p== -2 && y>=58*k && y<86*k {s[0].preview_clip= -1;}
  else if p>=0 && x>=12*k && x<=370*k && y>=92*k && cast(int)((y/k-92)/24)+s[0].preview_scroll==p {s[0].preview_clip=p;s[0].preview_at=s[0].clock;}}
 if phase==2 || phase==3 {s[0].preview_down= -1;}return true;
}
dev_hud :: (s:Creator,out:[]f32,w:f32,h:f32,k:f32)->int {
 n:=0;
 n=text(out,n,ifx s.preview_collapsed then "+ ANIMATIONS" else "- ANIMATIONS",32*k,45*k,10*k,ink(k,0.95,0.9,0.7));
 if s.preview_collapsed {return n;}
 n=text(out,n,ifx s.preview_clip<0 then "> AUTO (MOVEMENT)" else "  AUTO (MOVEMENT)",32*k,77*k,10*k,ink(k,0.94,0.8,0.48));
 for row:0..<dev_visible(s) {i:=s.preview_scroll+row;if i>=figs.PREVIEW_BAKED {break;}
  y:=(109+f32(row)*24)*k;n=text(out,n,ifx i==s.preview_clip then ">" else " ",24*k,y,10*k,ink(k,0.95,0.8,0.4));
  n=text(out,n,figs.PREVIEW_CLIP_NAME[i],40*k,y,10*k,ink(k,0.91,0.93,0.88));
 }
 return n;
}
// Like Everglade's watch HUD, keep HP legible and lift recent damage over the player.
combat_hud :: (s:Creator,out:[]f32,u:[]f32,at:int,w:f32,k:f32)->int {
 n:=at;hp:=s.hostiles[0].hp;if hp<0 {hp=0;}if hp>44 {hp=44;}
 x:=w-226*k;y:=39*k;
 label:[10]u8=[10]u8.[72,80,32,48,48,32,47,32,52,52];label[3]=cast(u8)(48+hp/10);label[4]=cast(u8)(48+hp%10);
 n=text(out,n,cast(string)label[..],x+10*k,y-1*k,10*k,ink(k,0.98,0.94,0.85));
 bx:=x+104*k;end:=x+190*k;by:=y+8*k;if lit(out,n,bx,by,end,by,3*k,1,0,0.35,0.22,0.20,0) {n+=6;}
 if hp>0 && lit(out,n,bx,by,bx+(end-bx)*f32(hp)/44,by,3*k,1,0,0.85,0.13,0.10,0) {n+=6;}
 if hp==0 {n=text(out,n,"YOU DIED",w*0.5-50*k,95*k,15*k,ink(k,1,0.3,0.25));n=text(out,n,"R / CLICK TO RESPAWN",w*0.5-100*k,137*k,10*k,ink(k,0.98,0.94,0.82));}
 for i:0..<8 {p:=s.hostiles[0].pops[i];age:=s.hostiles[0].time-p.born;if p.amount<=0 || age<0 || age>=1.2 {continue;}
  t:=age/1.2;rise:=0.8*(1-(1-t)*(1-t));rx:=p.x-u[16];ry:=p.y+rise-u[17];rz:=p.z-u[18];depth:=rx*u[20]+ry*u[21]+rz*u[22];if depth<=0.5 {continue;}
  sx:=u[23]+u[19]*(rx*u[24]+ry*u[25]+rz*u[26])/depth;sy:=u[27]-u[19]*(rx*u[28]+ry*u[29]+rz*u[30])/depth;
  if sx<0 || sx>w || sy<0 || sy>s.height {continue;}v:=p.amount;if v>99 {v=99;}digits:[3]u8=[3]u8.[45,48,48];digits[1]=cast(u8)(48+v/10);digits[2]=cast(u8)(48+v%10);
  shade:=ink(k,1,0.2,0.15);shade.light=cc_clamp((1.2-age)/0.35,0,1);n=text(out,n,ifx v<10 then cast(string)digits[0..<1] else cast(string)digits[..],sx-10*k,sy,13*k,shade);
  if v<10 {n=text(out,n,cast(string)digits[2..<3],sx,sy,13*k,shade);}
 }
 return n;
}
#test "combat HUD shows health and projects a recent damage number" {
 s:Creator;s.height=600;s.hostiles[0].ready=true;s.hostiles[0].hp=39;s.hostiles[0].time=1;
 u:[104]f32;u[19]=300;u[22]=1;u[23]=480;u[24]=1;u[27]=300;u[29]=1;
 out:[4096]f32;base:=combat_hud(s,out[..],u[..],0,960,1);#assert base>0;
 s.hostiles[0].pops[0]=hostile.DamagePop.{amount=5,x=0,y=0,z=4,born=1};hit:=combat_hud(s,out[..],u[..],0,960,1);#assert hit>base;
 s.hostiles[0].time=2.3;#assert combat_hud(s,out[..],u[..],0,960,1)==base;
}
experimental_air :: (s:[]Creator,air:bool) {
 if air && !s[0].airborne {s[0].air_at=s[0].clock;}
 if !air && s[0].airborne {s[0].land_at=s[0].clock;}
 s[0].airborne=air;
}
experimental_clip :: (s:Creator)->int {
 if s.airborne {return ifx s.clock-s.air_at<0.2 then figs.BD_JUMP_START else figs.BD_JUMP_LOOP;}
 if s.clock-s.land_at<0.35 {return figs.BD_JUMP_LAND;}
 return ifx s.moving then figs.BD_RUN else figs.BD_IDLE;
}
// Blend the authored jump over the locomotion pose, easing in during takeoff and
// back out shortly after landing. The jump never fully replaces the arms.
experimental_jump_weight :: (s:Creator)->f32 {
 if s.airborne {return 0.45*cc_clamp((s.clock-s.air_at)/0.12,0,1);}
 return 0.45*(1-cc_clamp((s.clock-s.land_at)/0.18,0,1));
}
experimental_figure :: (s:Creator,a0:figs.BdAnim)->figs.BdAnim {
 a:=a0;a.x=s.player_x;a.z=s.player_z;a.y=meadow.exp_height(a.x,a.z)+s.player_y;a.yaw=s.player_face;
 if s.hostiles[0].ready && s.hostiles[0].hp<=0 {a.clip=figs.BD_DIE;a.t0=s.clock-(s.hostiles[0].time-s.hostiles[0].died_at);a.prev= -1;return a;}
 a.clip=ifx s.dev_animations && s.preview_clip>=0 then figs.BD_CLIPS+s.preview_clip else experimental_clip(s);
 a.t0=ifx a.clip==figs.BD_JUMP_START then s.clock-(s.clock-s.air_at)*figs.bd_seconds(a.clip)/0.2 else ifx a.clip==figs.BD_JUMP_LAND then s.clock-(s.clock-s.land_at)*figs.bd_seconds(a.clip)/0.35 else 0;
 a.phase=(s.clock-(ifx s.dev_animations && s.preview_clip>=0 then s.preview_at else 0))/figs.bd_seconds(a.clip);
 if !(s.dev_animations && s.preview_clip>=0) && (s.airborne || s.clock-s.land_at<0.35) {
  a.prev=ifx s.moving then figs.BD_RUN else figs.BD_IDLE;a.pt0=0;a.pphase=s.clock/figs.bd_seconds(a.prev);
  a.fade_at=s.clock-f32(figs.BD_FADE)*experimental_jump_weight(s);
 }
 return a;
}
#test "animation browser is enabled only for local development origins" {
 #assert dev_local("url=http://127.0.0.1:8891/worlds/everglade-experimental\n");
 #assert dev_local("url=http://localhost/worlds/everglade-experimental\n");
 #assert !dev_local("url=https://openagents.com/worlds/everglade-experimental?next=http://localhost/\n");
 #assert !dev_local("url=http://localhost.example/worlds/everglade-experimental\n");
}
#test "animation browser selects and scrolls every registered clip" {
 s:[1]Creator;s[0].experimental=true;s[0].dev_animations=true;s[0].width=1280;s[0].height=720;s[0].scale=1;
 #assert dev_visible(s[0])>0 && s[0].preview_clip== -1;
 _:=pointer(s[..],40,105,0,1);_=pointer(s[..],40,105,2,1);
 #assert s[0].preview_clip==0;
 dev_scroll(s[..],10000);#assert s[0].preview_scroll+dev_visible(s[0])==figs.PREVIEW_BAKED;
 _=pointer(s[..],40,105,0,1);_=pointer(s[..],40,105,2,1);
 #assert s[0].preview_clip==s[0].preview_scroll;
 last_y:=f32(92+(dev_visible(s[0])-1)*24+5);_=pointer(s[..],40,last_y,0,1);_=pointer(s[..],40,last_y,2,1);
 #assert s[0].preview_clip==figs.PREVIEW_BAKED-1;
 _=pointer(s[..],40,70,0,1);_=pointer(s[..],40,70,2,1);#assert s[0].preview_clip== -1;
 olddist:=s[0].dist;_=pointer(s[..],500,300,1,1);wheel(s[..],100);#assert s[0].dist>olddist;
 dev_scroll(s[..], -10000);#assert s[0].preview_scroll==0;
}
#test "animation browser collapses and reopens without capturing the world" {
 s:[1]Creator;s[0].experimental=true;s[0].dev_animations=true;s[0].width=1280;s[0].height=720;s[0].scale=1;s[0].preview_clip=4;s[0].preview_scroll=7;
 _:=pointer(s[..],40,35,0,1);_=pointer(s[..],40,35,2,1);#assert s[0].preview_collapsed && s[0].preview_clip==4 && s[0].preview_scroll==7;
 _=pointer(s[..],40,105,0,1);#assert s[0].dragging && !s[0].preview_hover;_=pointer(s[..],40,105,2,1);
 _=pointer(s[..],40,35,0,1);_=pointer(s[..],40,35,2,1);#assert !s[0].preview_collapsed && s[0].preview_clip==4 && s[0].preview_scroll==7;
}
#test "experimental jumps ease in and out over the moving or idle pose" {
 s:[1]Creator;s[0].experimental=true;s[0].clock=1;experimental_air(s[..],true);
 #assert experimental_jump_weight(s[0])==0;
 s[0].clock=1.06;w:=experimental_jump_weight(s[0]);#assert w>0 && w<0.45;
 s[0].clock=1.3;#assert abs(experimental_jump_weight(s[0])-0.45)<0.001;
 a:=experimental_figure(s[0],figs.BdAnim.{});#assert a.clip==figs.BD_JUMP_LOOP && a.prev==figs.BD_IDLE;
 out:[24]f32;figs.bd_record(a,figs.BdLook.{},0,false,s[0].clock,out[..],0);#assert out[6]>0.55 && out[6]<0.60;
 s[0].moving=true;a=experimental_figure(s[0],figs.BdAnim.{});#assert a.prev==figs.BD_RUN;
 s[0].dev_animations=true;s[0].preview_clip=0;a=experimental_figure(s[0],figs.BdAnim.{});#assert a.prev== -1;
 s[0].preview_clip= -1;
 experimental_air(s[..],false);s[0].clock=1.39;w=experimental_jump_weight(s[0]);#assert w>0 && w<0.45;
 s[0].clock=1.49;#assert experimental_jump_weight(s[0])==0;
}
#test "death overrides animation previews and holds the death pose" {
 s:Creator;s.experimental=true;s.hostiles[0].ready=true;s.hostiles[0].hp=0;s.hostiles[0].time=2;s.hostiles[0].died_at=1;s.clock=9;s.dev_animations=true;s.preview_clip=4;s.airborne=true;
 a:=experimental_figure(s,figs.BdAnim.{});#assert a.clip==figs.BD_DIE && a.t0==8 && a.prev== -1;
 #assert figs.bd_frame_of(a.clip,a.t0,0,s.clock+100)==figs.BD_FRAMES[figs.BD_DIE]-1;
}
#test "experimental character selects jump takeoff air and landing" {
 s:[1]Creator;s[0].experimental=true;s[0].clock=1;experimental_air(s[..],true);
 #assert experimental_clip(s[0])==figs.BD_JUMP_START;
 s[0].clock=1.3;#assert experimental_clip(s[0])==figs.BD_JUMP_LOOP;
 experimental_air(s[..],false);#assert experimental_clip(s[0])==figs.BD_JUMP_LAND;
 s[0].clock=2;#assert experimental_clip(s[0])==figs.BD_IDLE;
}
#test "showcase animals loop through all ten baked run frames" {
 #assert animal_frame(0)==0 && animal_frame(0.3)==5 && animal_frame(0.6)==0;
 s:[1]Creator;catalog(s[..],"C glade/animal0 80 6 253 20 0 0\nC glade/animal9 200 9 253 20 0 0\n");
 #assert s[0].animal_n==2 && s[0].animal_first[0]==80 && s[0].animal_count[9]==9;
}
#test "npc catalog keeps imp and gremlin draws distinct" {
 s:[1]Creator;catalog(s[..],"C glade/imp0 80 6 254 20 0 0\nC glade/gremlin0 86 9 254 20 0 0\n");
 #assert s[0].npc_n[0]==1 && s[0].npc_n[1]==1 && s[0].npc_first[0][0]==80 && s[0].npc_first[1][0]==86;
}
#test "monsters cycle animations every three seconds" {
 #assert monster_frame(0)==0 && monster_frame(0.5)==4 && monster_frame(3)==8 && monster_frame(18)==0;
 s:[1]Creator;catalog(s[..],"C glade/monster0 80 6 254 20 0 0\nC glade/monster47 200 9 254 20 0 0\n");
 #assert s[0].monster_n==2 && s[0].monster_first[0]==80 && s[0].monster_count[47]==9;
}
monster_frame :: (clock:f32)->int {clip:=int(floor(clock/3))%6;sample:=int(floor(clock*8))%8;return clip*8+sample;}
animal_frame :: (clock:f32)->int {return int(floor(clock*(10.0/0.6)))%10;}
scene :: (s:Creator,b:[]figs.Bodies,out:[]f32)->int {
  b[0].draw_n=0;
  if !b[0].ready || !catalog_ready(s) { return 0; }
  l:=look(s); l.variant=0;
  a:figs.BdAnim; a.on=true; a.clip=[4]int.[figs.BD_IDLE,figs.BD_WALK,figs.BD_RUN,figs.BD_SPELL][s.pose];
  a.t0=s.pose_at; a.fade_at=-100; a.phase=(s.clock-s.pose_at)/figs.bd_seconds(a.clip); a.yaw=s.yaw;
  if s.pose==3 { dur:=figs.bd_seconds(figs.BD_SPELL); a.t0=s.pose_at+floor((s.clock-s.pose_at)/dur)*dur; }
  if s.walk.on {a=walk_figure(s,a);}
  if s.experimental {a=experimental_figure(s,a);}
  n:=0;
  for i:0..<40 { if s.worn[i] && available(s,i) && s.source_count[i+(ifx s.female then 0 else 40)]>0 {
    p:=i+ifx s.female then 0 else 40;
    figs.bd_record(a,l,s.source_word[p],false,s.clock,out,n);out[n*24+11]=f32(s.variant);
    b[0].draws[n*4]=cast(u32)s.source_first[p];b[0].draws[n*4+1]=cast(u32)s.source_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  } }
  parts:[3]int;pn:=0;
  if !s.worn[7] { parts[pn]=l.head;pn+=1; }
  if l.hair>=0 && !s.worn[7] && !s.worn[26] {parts[pn]=l.hair;pn+=1;}
  if l.extra==figs.BP_BEARD && !s.worn[7] {parts[pn]=l.extra;pn+=1;}
  for i:0..<pn {
    p:=parts[i];figs.bd_record(a,l,b[0].part_word[p],false,s.clock,out,n);
    b[0].draws[n*4]=cast(u32)b[0].part_first[p];b[0].draws[n*4+1]=cast(u32)b[0].part_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  for i:0..<n {for k:0..<3 {out[i*24+20+k]=EYES[s.eye_color][k];}out[i*24+23]=2;}
  if s.scene_only {n=0;}
  if s.glade_count>0 && n<43 {
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s.glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s.glade_first;b[0].draws[n*4+1]=cast(u32)s.glade_count;b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s.experimental && s.animal_n==10 && n<43 {
    take:=animal_frame(s.clock);for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s.glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s.animal_first[take];b[0].draws[n*4+1]=cast(u32)s.animal_count[take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s.experimental && s.monster_n==48 && n<43 {
    take:=monster_frame(s.clock);for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s.glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s.monster_first[take];b[0].draws[n*4+1]=cast(u32)s.monster_count[take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s.experimental && s.npc_n[0]==48 && s.npc_n[1]==48 {for i:0..<6 {if n>=41 {break;}e:=s.hostiles[0].enemies[i];sink:=ifx e.dead then (s.clock-e.died)*0.9 else 0.0f32;if e.dead && s.clock-e.died>2.4 {continue;}kind:=ifx i<3 then 0 else 1;take:=(ifx e.swing>=0 then 32 else ifx e.moving then 16 else 0)+int(floor(s.clock*8))%8;
    for k:0..<24 {out[n*24+k]=0;}out[n*24]=e.x;out[n*24+1]=meadow.exp_height(e.x,e.z)-sink;out[n*24+2]=e.z;out[n*24+8]=e.face_x;out[n*24+9]=e.face_z;
    out[n*24+4]=ifx kind==0 then 6 else 9;out[n*24+5]=meadow.exp_height(out[n*24+4],-7);out[n*24+6]= -7;out[n*24+7]=f32(s.glade_word);out[n*24+15]=18;
    b[0].draws[n*4]=cast(u32)s.npc_first[kind][take];b[0].draws[n*4+1]=cast(u32)s.npc_count[kind][take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }}
  for gi:0..<s.grass_groups {if n>=44 {break;}g:=s.grass[gi];
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24]=f32(g.word);out[n*24+7]=f32(s.glade_word);out[n*24+15]=17;
    b[0].draws[n*4]=cast(u32)g.first;b[0].draws[n*4+1]=cast(u32)g.count;
    b[0].draws[n*4+2]=cast(u32)((n+1)<<16);b[0].draws[n*4+3]=cast(u32)g.n;n+=1;
  }
  b[0].draw_n=n;return n;
}

inside :: (b:Box,x:f32,y:f32)->bool { return x>=b.x0 && x<=b.x1 && y>=b.y0 && y<=b.y1; }
#test "creator desktop controls share one compact left sidebar without overlapping actions" {
 s:[1]Creator;layout(s[..],1440,900,1);
 for i:0..<13 {b:=s[0].boxes[i];#assert b.x0==28 && b.x1==332 && b.y1-b.y0==36;if i>0 {#assert b.y0>=s[0].boxes[i-1].y1+4;}}
 for i:13..<18 {if i==15 {continue;}b:=s[0].boxes[i];#assert b.x0>=28 && b.x1<=332 && b.y1<=714;}
 #assert s[0].boxes[13].y0>s[0].boxes[12].y1 && s[0].boxes[16].y0>s[0].boxes[13].y1;
}
layout :: (s:[]Creator,w:f32,h:f32,k:f32) {
 s[0].width=w;s[0].height=h;s[0].scale=k;s[0].mobile=w<840*k || h<760*k;
 for i:0..<13 {
  x:=28*k;y:=(102+f32(i)*40)*k;bw:=304*k;bh:=36*k;
  if s[0].mobile {col:=i%2;row:=i/2;bw=(w-36*k)/2;x=12*k+f32(col)*(bw+12*k);y=h-484*k+f32(row)*60*k;bh=42*k;}
  s[0].boxes[i]=Box.{x0=x,y0=y,x1=x+bw,y1=y+bh};
 }
 by:=ifx s[0].mobile then h-56*k else 634*k;
 s[0].boxes[13]=Box.{x0=28*k,y0=by,x1=172*k,y1=by+36*k};
 s[0].boxes[14]=ifx s[0].mobile then Box.{x0=w-174*k,y0=by,x1=w-24*k,y1=by+36*k} else Box.{x0=188*k,y0=by,x1=332*k,y1=by+36*k};
 s[0].boxes[16]=ifx s[0].mobile then Box.{x0=12*k,y0=82*k,x1=w/2-6*k,y1=124*k} else Box.{x0=28*k,y0=678*k,x1=172*k,y1=714*k};
 s[0].boxes[17]=ifx s[0].mobile then Box.{x0=w/2+6*k,y0=82*k,x1=w-12*k,y1=124*k} else Box.{x0=188*k,y0=678*k,x1=332*k,y1=714*k};
 s[0].boxes[15]=ifx s[0].mobile then Box.{x0=w/2+6*k,y0=h-124*k,x1=w-12*k,y1=h-82*k} else Box.{x0=28*k,y0=by,x1=172*k,y1=by+36*k};
}
value :: (s:Creator,f:int)->string {
  if f==0 { return ifx s.female then "FEMALE" else "MALE"; }
  if f==1 { return [4]string.["PEASANT","RANGER","WIZARD","NOBLE"][s.outfit]; }
  if f==2 { return ifx s.hood then "HOODED" else "UNCOVERED"; }
  if f==3 { return [3]string.["ORIGINAL","COLOR II","COLOR III"][s.variant]; }
  if f==4 { return [9]string.["PINE","WINE","MIDNIGHT","IVORY","PLUM","INK","OCHRE","SLATE","NO DYE"][s.dye]; }
  if f==5 { return [6]string.["PORCELAIN","SAND","HONEY","COPPER","UMBER","EBONY"][s.skin]; }
  if f==6 { if s.hood { return "UNDER HOOD"; } return ifx s.female then [4]string.["LONG","BUNS","CROPPED","NONE"][s.hair] else [3]string.["PARTED","CROPPED","NONE"][s.hair]; }
  if f==7 { return [6]string.["DARK","CHESTNUT","GOLD","AUBURN","SILVER","VIOLET"][s.hair_color]; }
  if f==8 { if s.female { return "MALE ONLY"; } return ifx s.beard then "BEARDED" else "CLEAN SHAVEN"; }
  if f==12 {return [6]string.["BROWN","BLUE","GREEN","AMBER","GRAY","VIOLET"][s.eye_color];}
  if f==10 { return appearance.PART_LABELS[s.piece]; }
  if f==11 {if !available(s,s.piece) {return "MALE ONLY";}return ifx s.worn[s.piece] then "ON" else "OFF";}
  return [4]string.["IDLE","WALK","RUN","CAST"][s.pose];
}
ink :: (k:f32,r:f32,g:f32,b:f32)->Ink { return Ink.{core=0.55*k,light=1,glow=0.5*k,red=r,green=g,blue=b,scale=k,sans=false}; }
// Every Character Create label uses AR Kai C; other realms retain their own font.
text :: (out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,k:Ink)->int {
  pen:=x;v:=n;i:=0;em:=sans_em(cap);
  while i<t.count {d:=decode(t,i);end:=i+d.len;code:=d.code;
    v=draw_sans(out,v,t[i..<end],pen,y,cap,k);
    advance:=ifx code>=32 && code<=126 then int(CC_FONT_WIDTH[int(code)-32]) else int(CC_FONT_WIDTH[31]);
    pen+=f32(advance)/f32(CC_FONT_UPM)*em;i=end;
  }
  return v;
}
line :: (out:[]f32,n:int,x:f32,y:f32,bx:f32,by:f32,k:f32,r:f32,g:f32,b:f32)->int {
  if lit(out,n,x,y,bx,by,0.6*k,1,0,r,g,b,0) { return n+6; } return n;
}
frame :: (s:[]Creator,out:[]f32,u:[]f32,w:f32,h:f32,k:f32,dt:f32,still:bool)->int {
  if s[0].walk.on || s[0].profile_go {ensure(s);layout(s,w,h,k);return walk_frame(s,out,u,w,h,k,dt,still);}
  if s[0].experimental {
    ensure(s);layout(s,w,h,k);hostile.hostile_start(s[0].hostiles[..]);if !still && dt>0 && dt<1 {s[0].clock+=dt;hostile.hostile_tick(s[0].hostiles[..],s[0].player_x,s[0].player_y,s[0].player_z,ifx dt>0.25 then 0.25 else dt);}
    for i:0..<u.count {u[i]=0;}u[0]=w;u[1]=h;u[2]=s[0].clock;u[3]=1;u[4]=k;u[42]=1;u[10]=shadow_frame(s);u[11]=ifx !s[0].dev_animations then 1 else ifx s[0].preview_collapsed then 3 else 2;
    if s[0].camera_room>=0 && !still && dt>0 && dt<1 {s[0].camera_room+=dt*4;}
    camera(s[0],u,w,h,k);dx:=u[16]-s[0].player_x;dy:=u[17]-(meadow.exp_height(s[0].player_x,s[0].player_z)+s[0].player_y+1.2);dz:=u[18]-s[0].player_z;s[0].camera_room=sqrt(dx*dx+dy*dy+dz*dz);n:=ifx s[0].dev_animations then dev_hud(s[0],out,w,h,k) else 0;n=combat_hud(s[0],out,u,n,w,k);fps_count(s[0].fps[..],dt);n=coord_draw(s[0],out,n,w,h,k);return fps_draw(s[0].fps[0],out,n,w,h,k);
  }
  ensure(s); layout(s,w,h,k); if !still && dt>0 && dt<1 { s[0].clock+=dt; }
  n:=0; white:=ink(k,0.91,0.92,0.9); dim:=ink(k,0.70,0.76,0.74); gold:=ink(k,0.83,0.69,0.43);
  n=text(out,n,"Character Create",(ifx s[0].mobile then 24.0f32 else 30.0f32)*k,(ifx s[0].mobile then 58.0f32 else 60.0f32)*k,(ifx s[0].mobile then 18 else 22)*k,white);
  if !s[0].mobile {n=line(out,n,30*k,78*k,334*k,78*k,k,gold.red,gold.green,gold.blue);}
  for i:0..<13 {
    b:=s[0].boxes[i]; cap:=10.0f32;
    if s[0].mobile {n=text(out,n,FIELD_NAMES[i],b.x0,b.y0-7*k,8*k,dim);}else {n=text(out,n,(ifx i==11 then "WEAR PART" else FIELD_NAMES[i]),b.x0,b.y0+22*k,7.4*k,ink(k,0.93,0.88,0.72));}
    selected:=s[0].focused==i;
    c:=ifx selected then gold else dim;
    n=line(out,n,b.x0,b.y1,b.x1,b.y1,k,c.red,c.green,c.blue);
    n=text(out,n,"<",b.x0+(ifx s[0].mobile then 4.0f32 else 116.0f32)*k,b.y0+cap*k+10*k,cap*k,c);
    value_cap:=ifx i==10 then (ifx s[0].mobile then 6.5f32 else 8.5f32) else cap;
    n=text(out,n,value(s[0],i),b.x0+(ifx s[0].mobile then 25.0f32 else 138.0f32)*k,b.y0+cap*k+10*k,value_cap*k,white);
    n=text(out,n,">",b.x1-14*k,b.y0+cap*k+10*k,cap*k,c);
    if i==4 || i==5 || i==7 || i==12 {
      rgb:=ifx i==4 then DYES[s[0].dye] else ifx i==5 then SKINS[s[0].skin] else ifx i==12 then EYES[s[0].eye_color] else HAIRS[s[0].hair_color];
      if lit(out,n,b.x0+(ifx s[0].mobile then 26.0f32 else 138.0f32)*k,b.y1-5*k,b.x1-26*k,b.y1-5*k,2*k,1,0,rgb[0],rgb[1],rgb[2],0) { n+=6; }
    }
  }
  for i:13..<15 { b:=s[0].boxes[i]; n=text(out,n,ifx i==13 then "RESET" else "SURPRISE ME",b.x0+10*k,b.y0+23*k,10*k,gold); }
  if s[0].mobile {b:=s[0].boxes[15];n=text(out,n,ifx s[0].pan_mode then "DRAG: PAN" else "DRAG: ROTATE",b.x0+10*k,b.y0+23*k,10*k,gold);}
  for i:16..<18 {b:=s[0].boxes[i];label:=ifx i==17 then "USE IN EVERGLADE" else ifx s[0].profile_pending then "SAVING..." else ifx s[0].profile_failed then "RETRY SAVE" else ifx s[0].profile_ok && s[0].profile_revision==s[0].revision then "PLAYER SAVED" else "SAVE PLAYER";n=text(out,n,label,b.x0+8*k,b.y0+23*k,9*k,gold);}
  if !s[0].mobile {n=text(out,n,"LEFT DRAG: ROTATE / RIGHT DRAG: PAN / SCROLL: ZOOM",w*0.5-230*k,h-77*k,9*k,ink(k,0.20,0.23,0.15));}
  for i:0..<u.count { u[i]=0; }
  u[0]=w;u[1]=h;u[2]=s[0].clock;u[3]=1;u[4]=k;u[10]=shadow_frame(s);u[11]=ifx s[0].scene_only then 1 else 0;
  camera(s[0],u,w,h,k);
  if s[0].scene_only {return 0;}
  return n;
}
#test "experimental mouse and touch look up while the camera stays above ground" {
 s:[1]Creator;s[0].experimental=true;s[0].dist=4;s[0].pitch=0.35;
 used:=mouse_pointer(s[..],700,400,0,1,0);used=mouse_pointer(s[..],700,0,1,1,-1);
 #assert s[0].pitch< -1.0;
 u:[40]f32;camera(s[0],u[..],1280,720,1);#assert u[21]>0.8 && u[17]>=meadow.exp_height(u[16],u[18])+0.19;
 s[0].dragging=false;s[0].pitch=0.35;used=pointer(s[..],700,400,0,2);used=pointer(s[..],700,0,1,2);#assert s[0].pitch< -1.0;
}
#test "experimental camera pulls in before a wall and keeps the shoulder clear" {
 wall:=[6]f32.[-2,0,1,2,3,1.2];
 blocked:=cc_camera_boom(wall[..],0,1.2,0,[3]f32.[0,0,4]);
 #assert blocked>0.7 && blocked<0.81;
 clear:=cc_camera_boom(wall[..],0,1.2,0,[3]f32.[0,0,-4]);#assert clear==4;
 side:=[6]f32.[0.8,0,-2,1.0,3,2];
 shoulder:=cc_camera_boom(side[..],0,1.2,0,[3]f32.[2,0,0]);#assert shoulder>0.5 && shoulder<0.61;
}
#test "experimental camera follows the real village collision geometry" {
 s:[1]Creator;s[0].experimental=true;s[0].player_x= -23;s[0].player_z= -25;s[0].yaw=0;s[0].pitch=0.1;s[0].dist=6;
 near:[1]village.EvNear;village.ev_camera_near(near[..],s[0].player_x,s[0].player_z);
 #assert !near[0].overflow && near[0].wall_n>0;
 u:[40]f32;camera(s[0],u[..],1280,720,1);
 dx:=u[16]-s[0].player_x;dy:=u[17]-meadow.exp_height(s[0].player_x,s[0].player_z)-1.2;dz:=u[18]-s[0].player_z;
 length:=sqrt(dx*dx+dy*dy+dz*dz);#assert length<5.9;
 clear:=cc_camera_boom(near[0].walls[0..<near[0].wall_n*6],s[0].player_x,1.2,s[0].player_z,[3]f32.[dx,dy,dz]);#assert clear+0.001>=length;
}
#test "experimental camera stays close as it eases back into open space" {
 s:[1]Creator;s[0].experimental=true;s[0].camera_room=0.8;s[0].dist=4;s[0].yaw=0;s[0].pitch=0.1;
 u:[40]f32;camera(s[0],u[..],1280,720,1);
 dx:=u[16]-s[0].player_x;dy:=u[17]-meadow.exp_height(s[0].player_x,s[0].player_z)-1.2;dz:=u[18]-s[0].player_z;
 #assert abs(sqrt(dx*dx+dy*dy+dz*dz)-0.8)<0.001;
}
cc_camera_boom :: (walls:[]f32,x:f32,y:f32,z:f32,boom:[3]f32)->f32 {
 length:=sqrt(boom[0]*boom[0]+boom[1]*boom[1]+boom[2]*boom[2]);if length<0.00001 {return 0;}
 target:=world.world_point(x,y,z);direction:=world.world_point(boom[0]/length,boom[1]/length,boom[2]/length);
 return follow.follow_room(query.Colliders.{boxes=walls,ground_enabled=false},length,target,direction,length);
}
camera :: (s:Creator,u:[]f32,w:f32,h:f32,k:f32) {
  if s.experimental {
    target:=meadow.exp_height(s.player_x,s.player_z)+s.player_y+1.2;
    cy:=cos(s.pitch); sy:=sin(s.pitch); sx:=sin(s.yaw); cz:=cos(s.yaw);
    dist:=s.dist;shoulder:=cc_clamp(-sy*3.0,0,2.5);ox:=cz*shoulder;oz:= -sx*shoulder;
    // Shorten the orbit as it approaches the ground, preserving the look angle.
    if sy<0 {lo:=0.0f32;hi:=dist;for i:0..<12 {mid:=(lo+hi)*0.5;x:=s.player_x+ox+sx*cy*mid;z:=s.player_z+oz+cz*cy*mid;if target+sy*mid>=meadow.exp_height(x,z)+0.2 {lo=mid;}else {hi=mid;}}dist=lo;}
    boom:=[3]f32.[ox+sx*cy*dist,sy*dist,oz+cz*cy*dist];length:=sqrt(boom[0]*boom[0]+boom[1]*boom[1]+boom[2]*boom[2]);near:[1]village.EvNear;village.ev_camera_near(near[..],s.player_x,s.player_z);room:=cc_camera_boom(near[0].walls[0..<near[0].wall_n*6],s.player_x,s.player_y+1.2,s.player_z,boom);if s.camera_room>=0 && s.camera_room<room {room=s.camera_room;}share:=ifx length>0 then cc_clamp(room/length,0,1) else 0;
    u[16]=s.player_x+boom[0]*share;u[17]=target+boom[1]*share;u[18]=s.player_z+boom[2]*share;u[19]=h*0.89;
    u[20]= -sx*cy;u[21]= -sy;u[22]= -cz*cy;u[23]=w*0.5;
    u[24]=cz;u[25]=0;u[26]= -sx;u[27]=h*0.48;
    u[28]= -sx*sy;u[29]=cy;u[30]= -cz*sy;
    u[32]= -0.45;u[33]=0.78;u[34]= -0.42;return;
  }
  // A steady studio camera; dragging turns the figure, the wheel changes distance.
  dist:=s.dist; close:=cc_clamp((2.2-dist)/1.55,0,1);target:=1.2+0.58*close;
  ey:=target-0.4+0.50*close+sin(s.pitch-0.1)*dist;ez:=cos(s.pitch-0.1)*dist;
  fy:=target-ey; fz:=-ez; length:=sqrt(fy*fy+fz*fz); fy/=length; fz/=length;
  focal:=ifx s.mobile then (h-624*k)*1.3 else h*0.89;
  u[16]=s.pan_x;u[17]=ey+s.pan_y*(-fz);u[18]=ez+s.pan_y*fy;u[19]=focal;
  floor_y:=glade.cg_height(u[16],u[18])+0.28;if u[17]<floor_y {u[17]=floor_y;}
  u[20]=0;u[21]=fy;u[22]=fz;u[23]=w*0.5;
  u[24]=1;u[25]=0;u[26]=0;u[27]=ifx s.mobile then (h-384*k)*0.5 else h*0.48;
  u[28]=0;u[29]=-fz;u[30]=fy;
  u[32]=-0.45;u[33]=0.78;u[34]=-0.42;
}
pointer :: (s:[]Creator,x:f32,y:f32,phase:int,id:int)->bool {
  if s[0].walk.on {return true;}
  if s[0].experimental {
    if dev_pointer(s,x,y,phase) {return true;}
    if phase==0 {s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;}
    else if id==s[0].drag_id && phase==1 && s[0].dragging {s[0].yaw-=(x-s[0].dx)*0.0055;s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.0055,-1.2,1.2);s[0].dx=x;s[0].dy=y;}
    else if phase==2 || phase==3 {s[0].dragging=false;}return true;
  }
  if phase==0 {
    for i:0..<18 { if i==15 && !s[0].mobile {continue;}if inside(s[0].boxes[i],x,y) { s[0].down=i; s[0].drag_id=id; return true; } }
    s[0].drag_pan=s[0].pan_mode;s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;return true;
  }
  if id!=s[0].drag_id { return true; }
  if phase==1 && s[0].dragging { if s[0].drag_pan {
      focal:=ifx s[0].mobile then (s[0].height-624*s[0].scale)*1.3 else s[0].height*0.89;
      units:=s[0].dist/(ifx focal>1 then focal else 1);
      s[0].pan_x=cc_clamp(s[0].pan_x-(x-s[0].dx)*units,-2,2);
      s[0].pan_y=cc_clamp(s[0].pan_y+(y-s[0].dy)*units,-2,2);
    } else {s[0].yaw+=(x-s[0].dx)*0.008/s[0].scale; s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.003/s[0].scale,-0.2,0.6); } s[0].dx=x;s[0].dy=y;return true; }
  if phase==2 || phase==3 {
    i:=s[0].down;s[0].down=-1;s[0].dragging=false;
    if phase==2 && i>=0 && inside(s[0].boxes[i],x,y) {
      if i<13 { change(s,i,ifx x<s[0].boxes[i].x0+(ifx s[0].mobile then 22.0f32 else 136.0f32)*s[0].scale then -1 else 1); }
      else if i==13 { reset(s); }
      else if i==16 || i==17 {request_player(s,i==17);}
      else if i==15 {s[0].pan_mode=!s[0].pan_mode;}
      else { surprise(s); }
    }
  }
  return true;
}
key :: (s:[]Creator,k:int)->bool {
  if s[0].walk.on {return true;}
  if k=='p' || k=='P' {s[0].pan_mode=!s[0].pan_mode;return true;}
  if k==-15 { s[0].focused=(s[0].focused+1)%13;return true; }
  if k==-4 || k==-5 { change(s,s[0].focused,ifx k==-4 then -1 else 1);return true; }
  if k==' ' { change(s,9,1);return true; }
  return false;
}
wheel :: (s:[]Creator,dy:f32) { if s[0].walk.on {return;} if s[0].dev_animations && s[0].preview_hover {dev_scroll(s,dy);return;} s[0].dist=cc_clamp(s[0].dist+dy*0.003,0.65,6); }
// Page identity is a bounded host fact, not a search over arbitrary message content.
page_path :: (facts:string,path:string)->bool {
  at:=0;
  while at<facts.count { e:=at;while e<facts.count && facts[e]!='\n' { e+=1; } fact:=facts[at..<e];at=e+1;
    if fact.count>=4 && fact[0..<4]=="url=" { url:=fact[4..<fact.count];start:=0;for j:0..<url.count-2 {if url[j..<j+3]=="://" {start=j+3;while start<url.count && url[start]!='/' {start+=1;} break;}}end:=start;while end<url.count && url[end]!='?' && url[end]!='#' { end+=1; } return url[start..<end]==path; }
  }
  return false;
}

page :: (facts:string)->bool {return page_path(facts,"/worlds/character-creator") || page_path(facts,"/worlds/character-creator/");}
dev_local :: (facts:string)->bool {
 at:=0;while at<facts.count {e:=at;while e<facts.count && facts[e]!='\n' {e+=1;}fact:=facts[at..<e];at=e+1;
  for host:[4]string.["url=http://localhost", "url=https://localhost", "url=http://127.0.0.1", "url=https://127.0.0.1"] {
   if fact.count>host.count && fact[0..<host.count]==host && (fact[host.count]==':' || fact[host.count]=='/') {return true;}
  }}return false;
}
experimental_page :: (facts:string)->bool {return page_path(facts,"/worlds/everglade-experimental") || page_path(facts,"/worlds/everglade-experimental/");}

cc_clamp :: (v:f32,a:f32,b:f32)->f32 { if v<a {return a;} if v>b {return b;} return v; }

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { size = 0.01; dx = 0.01; dy = 0; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}

preset :: (s:[]Creator,family:int) {
  for i:0..<40 { s[0].worn[i]=false; }
  for i:0..<8 {p:=appearance.PART_PRESETS[family][i];if p>=0 && (!s[0].female || appearance.PART_NAMES[p].count>0) {s[0].worn[p]=true;}}
  s[0].hood=false;s[0].configured=true;
}
ensure :: (s:[]Creator) {if !s[0].configured {preset(s,s[0].outfit);}}
reset :: (s:[]Creator) { s[0].pan_x=0;s[0].pan_y=0;s[0].pan_mode=false;s[0].piece=18;s[0].female=false;s[0].outfit=2;s[0].hood=false;s[0].hair=0;s[0].beard=false;s[0].dye=8;s[0].skin=1;s[0].hair_color=0;s[0].eye_color=0;s[0].variant=0;s[0].pose=0;s[0].pose_at=s[0].clock;s[0].yaw=-0.22;s[0].pitch=0.1;s[0].dist=3.1;preset(s,2);s[0].revision+=1; }
catalog :: (s:[]Creator,t:string) {
  s[0].source_n=0;s[0].glade_count=0;s[0].grass_groups=0;s[0].animal_n=0;s[0].monster_n=0;s[0].npc_n=[2]int.[0,0];for k:0..<2 {for i:0..<48 {s[0].npc_count[k][i]=0;}}for i:0..<48 {s[0].monster_count[i]=0;}for i:0..<10 {s[0].animal_count[i]=0;}
  for i:0..<80 {s[0].source_count[i]=0;}
  at:=0;
  while at<t.count {e:=at;while e<t.count && t[e]!='\n' {e+=1;} row:=t[at..<e];at=e+1;
    if row.count<9 || row[0..<2]!="C " {continue;}
    ne:=figs.bd_word_end(row,2);name:=row[2..<ne];
    if name=="glade/environment" {
      p:=ne;s[0].glade_first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].glade_count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].glade_word=figs.bd_whole_at(row,p);
    }
    if name.count>12 && name[0..<12]=="glade/animal" {
      i:=figs.bd_whole_at(name,12);if i>=0 && i<10 {p:=ne;s[0].animal_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].animal_count[i]=figs.bd_whole_at(row,p);if s[0].animal_count[i]>0 {s[0].animal_n+=1;}}
    }
    if name.count>13 && name[0..<13]=="glade/monster" {
      i:=figs.bd_whole_at(name,13);if i>=0 && i<48 {p:=ne;s[0].monster_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].monster_count[i]=figs.bd_whole_at(row,p);if s[0].monster_count[i]>0 {s[0].monster_n+=1;}}
    }
    if (name.count>9 && name[0..<9]=="glade/imp") || (name.count>13 && name[0..<13]=="glade/gremlin") {
      kind:=ifx name[6]=='i' then 0 else 1;offset:=ifx kind==0 then 9 else 13;i:=figs.bd_whole_at(name,offset);if i>=0 && i<48 {p:=ne;s[0].npc_first[kind][i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].npc_count[kind][i]=figs.bd_whole_at(row,p);if s[0].npc_count[kind][i]>0 {s[0].npc_n[kind]+=1;}}
    }
    if name.count>=11 && name[0..<11]=="glade/grass" && s[0].grass_groups<3 {
      g:GrassDraw;p:=ne;g.first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);g.count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);g.word=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);g.n=figs.bd_whole_at(row,p);
      if g.n>=1 && g.n<=65535 && g.count>=3 {s[0].grass[s[0].grass_groups]=g;s[0].grass_groups+=1;}
    }
    for i:0..<80 {if name==appearance.PART_NAMES[i] {
      p:=ne;s[0].source_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);
      s[0].source_count[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);
      s[0].source_word[i]=figs.bd_whole_at(row,p);
    }}
  }
  for i:0..<80 {if s[0].source_count[i]>0 {s[0].source_n+=1;}}
}
#test "creator available garments are selectable on both sexes and presets cover four outfits" {
  s:[1]Creator;ensure(s[..]);
  for family:0..<4 {preset(s[..],family);n:=0;for i:0..<40 {if s[0].worn[i] {n+=1;}}#assert n>=1 && n<=8;}
  for i:0..<40 {if !available(s[0],i) {continue;}s[0].piece=i;s[0].worn[i]=false;change(s[..],11,1);#assert s[0].worn[i];#assert appearance.PART_NAMES[i+40].count>8;}
}

#test "creator page identity accepts absolute host URLs and rejects other routes" { #assert page("url=http://127.0.0.1:8812/worlds/character-creator?x=1\n");#assert page("url=/worlds/character-creator/\n");#assert !page("url=https://openagents.com/worlds/5e-lab?next=/worlds/character-creator\n"); }

probe :: (s:Creator,f:int)->int {
  if f==0 {return s.source_n;} if f==1 {return s.outfit;}if f==2 {return ifx s.female then 1 else 0;}
  if f==3 {return s.variant;}if f==4 {return s.dye;}if f==5 {return s.skin;}if f==6 {return s.pose;}
  if f==7 {return s.piece;}if f==8 {return ifx s.worn[s.piece] then 1 else 0;}if f==9 {return s.revision;}if f==10 {return s.eye_color;}if f==11 {return int(s.pan_x*1000);}if f==12 {return int(s.pan_y*1000);}if f==13 {return int(s.yaw*1000);}if f==18 {return ifx s.profile_ok then 1 else 0;}if f==19 {return ifx s.profile_failed then 1 else 0;}if f==14 {return s.glade_count;}
  if f==29 && s.experimental {return s.preview_clip;}
  if f==30 && s.experimental {return s.preview_scroll;}
  if f==28 && s.experimental {return experimental_clip(s);}
  if f==26 && s.experimental {return int(s.player_x*1000);}
  if f==27 && s.experimental {return int(s.player_z*1000);}
  if f>=20 && f<=25 {return walk_probe(s,f);}
  return -1;
}
append :: (out:[]u8,at:int,t:string)->int {for i:0..<t.count {out[at+i]=t[i];}return at+t.count;}
#test "creator catalog resolves 76 source meshes and every worn part reaches a bounded GPU draw" {
  s:[1]Creator;b:[1]figs.Bodies;buf:[16384]u8;at:=0;
  for i:0..<80 {if appearance.PART_NAMES[i].count>0 {at=append(buf[..],at,"C ");at=append(buf[..],at,appearance.PART_NAMES[i]);at=append(buf[..],at," 100 300 7 600 100 65\n");}}
  catalog(s[..],cast(string)buf[0..<at]);#assert s[0].source_n==76;
  for i:0..<80 {if appearance.PART_NAMES[i].count>0 {#assert s[0].source_first[i]==100 && s[0].source_count[i]==300 && s[0].source_word[i]==600;}}
  b[0].ready=true;for i:0..<39 {s[0].worn[i]=true;}out:[44*24]f32;
  for body:0..<2 {s[0].female=body==1;n:=scene(s[0],b[..],out[..]);#assert n==26-body*1 && b[0].draw_n==n;
    for i:0..<n {#assert b[0].draws[i*4+2]==cast(u32)i && b[0].draws[i*4+3]==1;}
  }
}

// Versioned appearance only: no asset offsets, clocks or borrowed renderer state are persisted.
to_appearance :: (s:Creator)->appearance.CharacterAppearance {a:appearance.CharacterAppearance;a.configured=s.configured;a.female=s.female;a.worn=s.worn;a.piece=s.piece;a.outfit=s.outfit;a.hood=s.hood;a.hair=s.hair;a.beard=s.beard;a.dye=s.dye;a.skin=s.skin;a.hair_color=s.hair_color;a.eye_color=s.eye_color;a.variant=s.variant;a.pose=s.pose;a.source_first=s.source_first;a.source_count=s.source_count;a.source_word=s.source_word;a.source_n=s.source_n;a.klass=s.klass;return a;}
save :: (s:Creator,out:[]u8)->int {return appearance.ca_save(to_appearance(s),out);}
restore :: (s:[]Creator,t:string)->bool {a:[1]appearance.CharacterAppearance;a[0]=to_appearance(s[0]);if !appearance.ca_restore(a[..],t) {return false;}s[0].configured=a[0].configured;s[0].female=a[0].female;s[0].worn=a[0].worn;s[0].piece=a[0].piece;s[0].outfit=a[0].outfit;s[0].hood=a[0].hood;s[0].hair=a[0].hair;s[0].beard=a[0].beard;s[0].dye=a[0].dye;s[0].skin=a[0].skin;s[0].hair_color=a[0].hair_color;s[0].eye_color=a[0].eye_color;s[0].variant=a[0].variant;s[0].pose=a[0].pose;s[0].source_first=a[0].source_first;s[0].source_count=a[0].source_count;s[0].source_word=a[0].source_word;s[0].source_n=a[0].source_n;s[0].klass=a[0].klass;s[0].pose_at=s[0].clock;s[0].revision+=1;s[0].saved=s[0].revision;return true;}
#test "creator appearance save round trips and malformed saves preserve the live choices" {
  a:[1]Creator;ensure(a[..]);change(a[..],1,1);change(a[..],3,2);change(a[..],4,3);a[0].piece=38;change(a[..],11,1);
  out:[64]u8;n:=save(a[0],out[..]);b:[1]Creator;ok:=restore(b[..],cast(string)out[0..<n]);#assert ok && b[0].outfit==a[0].outfit && b[0].variant==2 && b[0].piece==38 && b[0].worn[38]==a[0].worn[38];
  for i:0..<56 {old:=out[i];out[i]='x';before:=b[0].revision;#assert !restore(b[..],cast(string)out[0..<n]) && b[0].revision==before;out[i]=old;}
  #assert !restore(b[..],cast(string)out[0..<53]);
}

available :: (s:Creator,p:int)->bool {return p>=0 && p<40 && appearance.PART_SELECTABLE[p] && appearance.PART_NAMES[p+(ifx s.female then 0 else 40)]!="";}
catalog_ready :: (s:Creator)->bool {for i:0..<80 {if appearance.PART_NAMES[i]!="" && s.source_count[i]<=0 {return false;}}return true;}


#test "creator hood keeps beard in actual draw list and crown cannot be worn" {
