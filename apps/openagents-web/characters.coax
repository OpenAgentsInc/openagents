// The characters realm, openagents.com/realm/characters: the Verse
// engine's figures (verse/figure.coax) in a night garden, drawn by
// characters.wgsl. Two shadow visitors (soft silhouettes, black, fuzzy at
// the edge and lit only at the rim), a lit one to compare, a dog and a fox;
// tap or click a figure to choose it, then its gait (STAND, WALK, TROT for
// an animal, RUN), its look (SOFT or LIT), an emote (verse/motion.coax: a
// person's WAVE, BOW, CHEER, SHRUG, DANCE; an animal's SIT, LIE, DIG,
// FETCH, BOW, WAG), played over its gait, and its SHAPE: a slider for each
// of its build's numbers, its pattern and its colours. An agent sets the
// same through the link: /realm/characters#motion=<a motion document>, or
// #shape=<a shape> (figure.coax verse_figure_shape_read) for the chosen
// figure; each is checked, and the page says why if it is refused. Drag
// turns the view, the wheel zooms.
//
// State lives in the host's memory (a Chars the face keeps), so the dev
// server can swap this code in while the page runs.

#load "font.coax";
#load "analytics.coax";
#load "../../verse/motion.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, 0, 0, 0, 0
MAX_VERTICES :: 24000;
PLATES :: 28;
FIGS :: 6;
FIG_FLOATS :: 20;      // bound (4); coat, look; marks, pattern; x, y, z, yaw; bones, blend, size, glow
// width, height, time, fade; figures, plates, dpr, chosen; the eye and the
// view's half-height tangent; right, up, ahead; toward the moon; 0 (4); the
// plates (PLATES × 8: x0, y0, x1, y1, scale, alpha, look, 0); the figures;
// their bones (FIGS × MAX_PARTS × BONE_FLOATS).
PANEL_AT :: 32;
FIG_AT :: PANEL_AT + PLATES * 8;
BONE_AT :: FIG_AT + FIGS * FIG_FLOATS;
UNIFORM_FLOATS :: BONE_AT + FIGS * MAX_PARTS * BONE_FLOATS;
INBOX :: 4096;

MODE_STROKE :: 0.0;
GAP :: 0.5; SPACE :: 1.2;
PARCH_R :: 0.91; PARCH_G :: 0.863; PARCH_B :: 0.753;
GOLD_R :: 0.80; GOLD_G :: 0.64; GOLD_B :: 0.36;
LOOK_PLAIN :: 0.0; LOOK_LIT_UP :: 1.0; LOOK_HOVER :: 2.0;

RING :: 2.2;           // metres: the gravel ring walkers follow
FADE_GAIT :: 0.35;     // seconds one gait takes to blend into the next
TARGET_Y :: 0.75;      // the height the view turns round

// The buttons.
BTN_STAND :: 0; BTN_WALK :: 1; BTN_TROT :: 2; BTN_RUN :: 3; BTN_LOOK :: 4; BTN_SHAPE :: 5; BTN_PATTERN :: 6;
BTN_COAT :: 7;         // a swatch each: COATS
BTN_MARKS :: BTN_COAT + COATS;
BTN_EMOTE :: BTN_MARKS + MARKS;   // then one per emote the chosen figure's rig has
EMOTES :: 8;
COATS :: 6; MARKS :: 4;
COAT_COLOURS :: [18] f32.[0.85, 0.74, 0.52,  0.6, 0.36, 0.13,  0.24, 0.12, 0.05,  0.03, 0.028, 0.03,  0.36, 0.37, 0.39,  0.66, 0.24, 0.06];
MARK_COLOURS :: [12] f32.[0.92, 0.9, 0.86,  0.03, 0.028, 0.03,  0.5, 0.3, 0.12,  0.45, 0.46, 0.48];
BUTTONS :: BTN_EMOTE + EMOTES;
MOTIONS :: 16;         // the motion library: the engine's own, then the one from the link
NOTICE :: 9.0;         // seconds a notice shows

Walker :: struct {
  name: string;
  shape: Shape;
  skel: Skeleton;
  gait: Gait = Gait.stand;
  was: Gait = Gait.stand;  // the gait it is blending from
  since: f32 = 10;         // seconds since the gait changed
  phase: f32;
  at: Place;
  angle: f32;              // round the ring, radians
  radius: f32 = RING;
  bound: [4] f32;
  now: Play;               // the emote playing
  last: Play;              // the one fading out under it
}

Chars :: struct {
  time: f32;
  frames: int;
  width: f32; height: f32; dpr: f32 = 1;
  touch: bool;
  yaw: f32 = 0.5; pitch: f32 = 0.3; dist: f32 = 6.5;
  idle: f32;                 // seconds since a touch, a drag or a key
  down: bool; down_id: int; lx: f32; ly: f32; travel: f32;
  press: int = -1; hover: int = -1;
  built: bool;
  figs: [FIGS] Walker; fig_n: int; chosen: int;
  eye: Fv; right: Fv; up: Fv; ahead: Fv; tv: f32 = 0.45;
  plate_n: int; plates: [PLATES] Box; plate_alpha: [PLATES] f32; plate_look: [PLATES] f32;
  boxes: [BUTTONS] Box; shown: [BUTTONS] bool;
  motions: [MOTIONS] Motion; motion_n: int;
  linked: int = -1;          // the library's slot for the motion from the link
  pending: [INBOX] u8; pending_n: int;   // a link's motion, until the cast is built
  notice: [256] u8; notice_n: int; notice_until: f32; notice_bad: bool;
  shaping: bool;                 // the SHAPE panel is open
  sliding: int = -1;             // the slider being dragged
  sliders: [SHAPE_NUMBERS] Box; slider_n: int; slider_of: [SHAPE_NUMBERS] int;
  inbox: [INBOX] u8;
}
Box :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

coaxial_chars_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_chars_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_chars_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }
coaxial_chars_inbox_cap :: () -> int #export_c { return INBOX; }

// ---- strokes (font.coax draws words with these)

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}
ink_of :: (k: f32, light: f32, gold: bool) -> Ink {
  return Ink.{core = 0.55 * k, light = light, glow = 1.2 * k, red = ifx gold then GOLD_R else PARCH_R,
              green = ifx gold then GOLD_G else PARCH_G, blue = ifx gold then GOLD_B else PARCH_B, mode = MODE_STROKE, scale = k};
}
words :: (out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, at, text, x, base, cap, GAP, SPACE, k, false, false);
}
centred :: (out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return words(out, at, text, x - measure(text, GAP, SPACE, false) * cap * 0.5, base, cap, k);
}
plate :: (c: [] Chars, b: Box, alpha: f32, look: f32) {
  n := c[0].plate_n;
  if n >= PLATES { return; }
  c[0].plates[n] = b; c[0].plate_alpha[n] = alpha; c[0].plate_look[n] = look; c[0].plate_n = n + 1;
}
button :: (c: [] Chars, out: [] f32, at: int, i: int, b: Box, label: string, on: bool) -> int {
  k := c[0].dpr;
  c[0].boxes[i] = b; c[0].shown[i] = true;
  look: f32 = ifx on then LOOK_LIT_UP else LOOK_PLAIN;
  if c[0].press == i || c[0].hover == i { look += LOOK_HOVER; }
  plate(c, b, 0.9, look);
  cap := lo(8.5 * k, (b.x1 - b.x0 - 10 * k) / hi(measure(label, GAP, SPACE, false), 0.001));
  return centred(out, at, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, ink_of(k, ifx on then 1.0f32 else 0.85f32, on));
}
inside :: (b: Box, x: f32, y: f32) -> bool { return x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
phone :: (c: [] Chars) -> bool { return c[0].touch || c[0].width < 640 * c[0].dpr; }

// ---- the cast

walker :: (name: string, s: Shape, at: Place) -> Walker {
  w: Walker; w.name = name; w.shape = verse_figure_shape_fix(s); w.skel = verse_figure_skeleton(w.shape); w.at = at;
  w.angle = angle_of(at.z, at.x); w.radius = hi(1.2, sqrt(at.x * at.x + at.z * at.z));
  return w;
}
// The host's memory starts as zeros, so the first frame sets what Chars's defaults say.
build :: (c: [] Chars) {
  c[0].yaw = 0.5; c[0].pitch = 0.3; c[0].dist = 6.5; c[0].press = -1; c[0].hover = -1; c[0].tv = 0.45;
  visitor: Shape; visitor.look = LOOK_SOFT; visitor.girth = 0.9;
  c[0].figs[0] = walker("THE VISITOR", visitor, Place.{x = RING, z = 0});
  c[0].figs[0].gait = Gait.walk; c[0].figs[0].was = Gait.walk;
  tall := visitor; tall.size = 1.1; tall.girth = 0.75; tall.head = 0.9;
  c[0].figs[1] = walker("THE TALL ONE", tall, Place.{x = -0.9, z = 0.5, yaw = 0.5});
  guest: Shape; guest.coat = fv(0.34, 0.12, 0.08); guest.marks = fv(0.2, 0.17, 0.14); guest.girth = 1.05;
  c[0].figs[2] = walker("A GUEST", guest, Place.{x = 0.8, z = -0.6, yaw = -0.4});
  dog: Shape; dog.rig = Rig.animal; dog.coat = fv(0.6, 0.36, 0.13); dog.marks = fv(0.92, 0.9, 0.86); dog.pattern = PATTERN_SOCKS; dog.ears = 0.85; dog.ear_size = 1.1;
  c[0].figs[3] = walker("THE DOG", dog, Place.{x = 0.3, z = 1.2, yaw = 0.9});
  fox: Shape; fox.rig = Rig.animal; fox.size = 0.7; fox.legs = 0.85; fox.snout = 1.35; fox.ear_size = 1.5; fox.tail = 1.6; fox.fluff = 1.9;
  fox.coat = fv(0.66, 0.24, 0.06); fox.marks = fv(0.03, 0.028, 0.03); fox.pattern = PATTERN_POINTS;
  c[0].figs[4] = walker("THE FOX", fox, Place.{x = -1.45, z = 0.2});
  c[0].figs[4].gait = Gait.trot; c[0].figs[4].was = Gait.trot;
  c[0].fig_n = 5;
  for i: 0..<c[0].fig_n { c[0].figs[i].now = Play.{}; c[0].figs[i].last = Play.{}; }
  c[0].sliding = -1;
  c[0].motion_n = 0;
  for i: 0..<PERSON_MOTIONS { if verse_motion_read(c[0].motions[c[0].motion_n..<c[0].motion_n + 1], PERSON_MOTION_TEXT[i]) { c[0].motion_n += 1; } }
  for i: 0..<ANIMAL_MOTIONS { if verse_motion_read(c[0].motions[c[0].motion_n..<c[0].motion_n + 1], ANIMAL_MOTION_TEXT[i]) { c[0].motion_n += 1; } }
  c[0].linked = -1;
  c[0].built = true;
  if c[0].pending_n > 0 { take_link(c, cast(string) c[0].pending[0..<c[0].pending_n]); c[0].pending_n = 0; }
}

set_gait :: (c: [] Chars, i: int, g: Gait) {
  if i < 0 || i >= c[0].fig_n || c[0].figs[i].gait == g { return; }
  w := c[0].figs[i];
  if w.gait == Gait.stand {   // setting off: round the ring from where it is
    w.angle = angle_of(w.at.z, w.at.x); w.radius = hi(1.2, sqrt(w.at.x * w.at.x + w.at.z * w.at.z));
  }
  w.was = w.gait; w.gait = g; w.since = 0;
  c[0].figs[i] = w;
}

step :: (w: Walker, dt: f32) -> Walker {
  r := w;
  r.since += dt;
  g := ifx r.gait == Gait.stand && r.since < FADE_GAIT then r.was else r.gait;
  r.phase = fract(r.phase + verse_figure_stride_rate(r.shape, g) * dt);
  speed := verse_figure_speed(r.shape, r.gait);
  if r.since < FADE_GAIT { speed = verse_figure_speed(r.shape, r.was) + (speed - verse_figure_speed(r.shape, r.was)) * r.since / FADE_GAIT; }
  if speed > 0 {
    r.angle += speed / r.radius * dt;
    r.at.x = cos(r.angle) * r.radius; r.at.z = sin(r.angle) * r.radius; r.at.yaw = -r.angle;
  }
  return r;
}
gait_pose :: (w: Walker, clock: f32) -> Pose {
  now := verse_figure_gait(w.shape.rig, w.gait, w.phase, clock);
  if w.since >= FADE_GAIT { return now; }
  return verse_figure_blend(verse_figure_gait(w.shape.rig, w.was, w.phase, clock), now, smooth01(w.since / FADE_GAIT));
}
// The gait, then the emote fading out, then the one playing, over it.
pose_of :: (c: [] Chars, w: Walker) -> Pose {
  p := gait_pose(w, c[0].time);
  for play: [2] Play.[w.last, w.now] {
    if play.motion < 0 || play.motion >= c[0].motion_n { continue; }
    m := c[0].motions[play.motion..<play.motion + 1];
    if m[0].rig != w.shape.rig { continue; }
    p = verse_motion_over(m, play, p, c[0].time);
  }
  return p;
}

// ---- emotes

// The library's motions for a rig, in order: which slot is the n-th.
emote_slot :: (c: [] Chars, rig: Rig, n: int) -> int {
  k := 0;
  for i: 0..<c[0].motion_n {
    if c[0].motions[i].rig != rig { continue; }
    if k == n { return i; }
    k += 1;
  }
  return -1;
}
// Plays motion slot on figure i: the one playing fades out under it. The
// same loop again stops it.
emote :: (c: [] Chars, i: int, slot: int) {
  if i < 0 || i >= c[0].fig_n || slot < 0 || slot >= c[0].motion_n { return; }
  if c[0].motions[slot].rig != c[0].figs[i].shape.rig { return; }
  w := c[0].figs[i];
  now := c[0].time;
  m := c[0].motions[slot..<slot + 1];
  if w.now.motion == slot && w.now.stop < 0 && !verse_motion_done(m, w.now, now) && m[0].mode != MODE_ONCE {
    w.now.stop = now; c[0].figs[i] = w; return;
  }
  if w.now.motion >= 0 && w.now.stop < 0 { w.now.stop = now; }
  w.last = w.now;
  w.now = Play.{motion = slot, start = now};
  c[0].figs[i] = w;
  if m[0].still { set_gait(c, i, Gait.stand); }
}
// A gait set while a still emote plays ends the emote.
gait_for :: (c: [] Chars, i: int, g: Gait) {
  if i < 0 || i >= c[0].fig_n { return; }
  w := c[0].figs[i];
  if g != Gait.stand && w.now.motion >= 0 && w.now.motion < c[0].motion_n && c[0].motions[w.now.motion].still && w.now.stop < 0 {
    c[0].figs[i].now.stop = c[0].time;
  }
  set_gait(c, i, g);
}
reshape :: (c: [] Chars, i: int, s: Shape) {
  if i < 0 || i >= c[0].fig_n { return; }
  c[0].figs[i].shape = verse_figure_shape_fix(s);
  c[0].figs[i].skel = verse_figure_skeleton(c[0].figs[i].shape);
}
// Ends finished plays.
settle :: (c: [] Chars, i: int) {
  w := c[0].figs[i];
  for k: 0..<2 {
    play := ifx k == 0 then w.last else w.now;
    if play.motion < 0 { continue; }
    if play.motion >= c[0].motion_n || verse_motion_done(c[0].motions[play.motion..<play.motion + 1], play, c[0].time) {
      if k == 0 { w.last = Play.{}; } else { w.now = Play.{}; }
    }
  }
  c[0].figs[i] = w;
}
playing :: (c: [] Chars, i: int, slot: int) -> bool {
  w := c[0].figs[i];
  return w.now.motion == slot && w.now.stop < 0;
}
say :: (c: [] Chars, a: string, b: string, bad: bool) {
  n := motion_put(c[0].notice[..], 0, a); n = motion_put(c[0].notice[..], n, b);
  c[0].notice_n = n; c[0].notice_until = c[0].time + NOTICE; c[0].notice_bad = bad;
}
// The link's hash is a motion document, its first space an = if the writer
// likes (#motion=nod; rig person; ...): it is read into the library's last
// slot and plays on the chosen figure, or the first of its rig.
take_link :: (c: [] Chars, hash: string) {
  if hash.count > 6 && hash[0..<6] == "shape=" {
    i := c[0].chosen;
    r := verse_figure_shape_read(c[0].figs[i].shape, hash[6..<hash.count]);
    if !r.ok {
      buf: [96] u8;
      n := motion_put(buf[..], 0, "line "); n = motion_put_int(buf[..], n, r.line); n = motion_put(buf[..], n, ": "); n = motion_put(buf[..], n, r.why);
      say(c, "YOUR SHAPE WAS REFUSED · ", cast(string) buf[0..<n], true); return;
    }
    reshape(c, i, r.shape);
    say(c, "SHAPE SET · ", c[0].figs[i].name, false);
    return;
  }
  key := "motion";
  if hash.count <= key.count + 1 || hash[0..<key.count] != key || (hash[key.count] != '=' && hash[key.count] != ' ') { return; }
  doc: [INBOX] u8;
  n := 0;
  for ch: hash { if n < INBOX { doc[n] = ch; n += 1; } }
  doc[key.count] = ' ';
  text := cast(string) doc[0..<n];
  slot := ifx c[0].linked >= 0 then c[0].linked else c[0].motion_n;
  if slot >= MOTIONS { return; }
  m := c[0].motions[slot..<slot + 1];
  if !verse_motion_read(m, text) {
    say(c, "YOUR MOTION WAS REFUSED · ", verse_motion_error(m), true);
    if c[0].linked < 0 { blank: Motion; m[0] = blank; }
    else { for i: 0..<c[0].fig_n { if c[0].figs[i].now.motion == slot { c[0].figs[i].now = Play.{}; } if c[0].figs[i].last.motion == slot { c[0].figs[i].last = Play.{}; } } c[0].linked = -1; c[0].motion_n = slot; }
    return;
  }
  if c[0].linked < 0 { c[0].linked = slot; c[0].motion_n = slot + 1; }
  who := -1;
  if c[0].figs[c[0].chosen].shape.rig == m[0].rig { who = c[0].chosen; }
  for i: 0..<c[0].fig_n { if who < 0 && c[0].figs[i].shape.rig == m[0].rig { who = i; } }
  if who < 0 { say(c, "YOUR MOTION IS FOR A RIG NOT HERE · ", verse_motion_name(m), true); return; }
  c[0].chosen = who;
  emote(c, who, slot);
  say(c, "PLAYING YOUR MOTION · ", verse_motion_name(m), false);
}
coaxial_chars_hash :: (c: [] Chars, length: int) #export_c {
  n := clamp(cast(f32) length, 0, cast(f32) INBOX);
  count := cast(int) n;
  if !c[0].built {
    for i: 0..<count { c[0].pending[i] = c[0].inbox[i]; }
    c[0].pending_n = count; return;
  }
  take_link(c, cast(string) c[0].inbox[0..<count]);
}

// ---- the view

view :: (c: [] Chars) {
  cp := cos(c[0].pitch); sp := sin(c[0].pitch);
  eye := fv(sin(c[0].yaw) * cp * c[0].dist, TARGET_Y + sp * c[0].dist, cos(c[0].yaw) * cp * c[0].dist);
  ahead := fv_times(fv_sub(fv(0, TARGET_Y, 0), eye), 1.0 / c[0].dist);
  right := fv(-ahead.z, 0, ahead.x);
  rl := hi(fv_length(right), 0.0001); right = fv_times(right, 1.0 / rl);
  up := fv(right.y * ahead.z - right.z * ahead.y, right.z * ahead.x - right.x * ahead.z, right.x * ahead.y - right.y * ahead.x);
  c[0].eye = eye; c[0].ahead = ahead; c[0].right = right; c[0].up = up;
  aspect := c[0].width / hi(c[0].height, 1);
  c[0].tv = hi(0.42, 0.36 / hi(aspect, 0.1));
}
// The figure under device pixel x, y (its bound sphere nearest the eye), or -1.
pick :: (c: [] Chars, x: f32, y: f32) -> int {
  aspect := c[0].width / hi(c[0].height, 1);
  nx := x / hi(c[0].width, 1) * 2 - 1; ny := 1 - y / hi(c[0].height, 1) * 2;
  d := fv_add(c[0].ahead, fv_add(fv_times(c[0].right, nx * aspect * c[0].tv), fv_times(c[0].up, ny * c[0].tv)));
  d = fv_times(d, 1.0 / fv_length(d));
  best := -1; near: f32 = 1000000;
  for i: 0..<c[0].fig_n {
    b := c[0].figs[i].bound;
    oc := fv_sub(c[0].eye, fv(b[0], b[1], b[2]));
    bb := oc.x * d.x + oc.y * d.y + oc.z * d.z;
    disc := bb * bb - (oc.x * oc.x + oc.y * oc.y + oc.z * oc.z) + b[3] * b[3] * 0.7;
    if disc <= 0 { continue; }
    t := -bb - sqrt(disc);
    if t > 0 && t < near { near = t; best = i; }
  }
  return best;
}

// ---- the SHAPE panel: a slider for each number the rig reads, then the
// pattern and the coat's and the marks' colours. It sits on the right on
// a computer, above the buttons on a phone.

shape_rows :: (rig: Rig) -> int { return ifx rig == Rig.animal then SHAPE_NUMBERS else 5; }
swatch :: (c: [] Chars, out: [] f32, at: int, i: int, b: Box, r: f32, g: f32, bl: f32, on: bool) -> int {
  k := c[0].dpr;
  c[0].boxes[i] = b; c[0].shown[i] = true;
  look: f32 = ifx on then LOOK_LIT_UP else LOOK_PLAIN;
  if c[0].press == i || c[0].hover == i { look += LOOK_HOVER; }
  plate(c, b, 0.9, look);
  cx := (b.x0 + b.x1) * 0.5; cy := (b.y0 + b.y1) * 0.5;
  rad := lo(b.x1 - b.x0, b.y1 - b.y0) * 0.3;
  if lit(out, at, cx - 0.5, cy, cx + 0.5, cy, rad, 1, 0.5 * k, sqrt(r), sqrt(g), sqrt(bl), MODE_STROKE) { return at + 6; }
  return at;
}
shape_panel :: (c: [] Chars, out: [] f32, at: int, w: Walker, m: f32, bottom: f32) -> int {
  k := c[0].dpr;
  rows := shape_rows(w.shape.rig);
  rh := ifx phone(c) then 21 * k else 25 * k;
  sw := ifx phone(c) then 30 * k else 32 * k;
  pw := ifx phone(c) then c[0].width - 2 * m else 300 * k;
  ph := cast(f32) rows * rh + 2 * (sw + 8 * k) + 22 * k;
  x0 := c[0].width - m - pw;
  y0 := ifx phone(c) then bottom - ph else hi(m + 100 * k, bottom - ph);
  panel := Box.{x0 = x0, y0 = y0, x1 = x0 + pw, y1 = y0 + ph};
  plate(c, panel, 0.82, LOOK_PLAIN);
  v := at;
  pad := 12 * k; label_w := 74 * k;
  for r: 0..<rows {
    at_number := ifx w.shape.rig == Rig.animal then r else ifx r < 5 then r else 0;
    y := y0 + 10 * k + cast(f32) r * rh + rh * 0.5;
    v = words(out, v, SHAPE_NAMES[at_number], x0 + pad, y + 3.2 * k, 6.5 * k, ink_of(k, 0.8, false));
    tx0 := x0 + pad + label_w; tx1 := x0 + pw - pad;
    range := shape_range(at_number);
    f := clamp((verse_figure_shape_get(w.shape, at_number) - range.x) / hi(range.y - range.x, 0.001), 0, 1);
    kx := tx0 + (tx1 - tx0) * f;
    if lit(out, v, tx0, y, tx1, y, 0.6 * k, 0.35, 1.5 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { v += 6; }
    if kx > tx0 + 0.5 && lit(out, v, tx0, y, kx, y, 1.0 * k, 0.9, 2 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { v += 6; }
    if lit(out, v, kx - 0.5, y, kx + 0.5, y, (ifx c[0].sliding == r then 6.5f32 else 5.0f32) * k, 1, 3 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { v += 6; }
    c[0].sliders[r] = Box.{x0 = tx0 - 10 * k, y0 = y - rh * 0.5, x1 = tx1 + 10 * k, y1 = y + rh * 0.5};
    c[0].slider_of[r] = at_number;
  }
  c[0].slider_n = rows;
  y := y0 + 10 * k + cast(f32) rows * rh + 4 * k;
  pb := Box.{x0 = x0 + pad, y0 = y, x1 = x0 + pad + label_w + 20 * k, y1 = y + sw};
  v = button(c, out, v, BTN_PATTERN, pb, PATTERN_NAMES[w.shape.pattern], false);
  gap := 6 * k;
  room := x0 + pw - pad - (pb.x1 + 10 * k);
  size := lo(sw, (room - gap * cast(f32) (COATS - 1)) / cast(f32) COATS);
  sx := pb.x1 + 10 * k;
  for i: 0..<COATS {
    col := fv(COAT_COLOURS[i * 3], COAT_COLOURS[i * 3 + 1], COAT_COLOURS[i * 3 + 2]);
    on := abs(col.x - w.shape.coat.x) + abs(col.y - w.shape.coat.y) + abs(col.z - w.shape.coat.z) < 0.01;
    v = swatch(c, out, v, BTN_COAT + i, Box.{x0 = sx, y0 = y + (sw - size) * 0.5, x1 = sx + size, y1 = y + (sw + size) * 0.5}, col.x, col.y, col.z, on);
    sx += size + gap;
  }
  y += sw + 8 * k;
  v = words(out, v, "MARKS", x0 + pad, y + sw * 0.5 + 3.2 * k, 6.5 * k, ink_of(k, 0.8, false));
  sx = pb.x1 + 10 * k;
  for i: 0..<MARKS {
    col := fv(MARK_COLOURS[i * 3], MARK_COLOURS[i * 3 + 1], MARK_COLOURS[i * 3 + 2]);
    on := abs(col.x - w.shape.marks.x) + abs(col.y - w.shape.marks.y) + abs(col.z - w.shape.marks.z) < 0.01;
    v = swatch(c, out, v, BTN_MARKS + i, Box.{x0 = sx, y0 = y + (sw - size) * 0.5, x1 = sx + size, y1 = y + (sw + size) * 0.5}, col.x, col.y, col.z, on);
    sx += size + gap;
  }
  return v;
}
slide :: (c: [] Chars, r: int, x: f32) {
  if r < 0 || r >= c[0].slider_n { return; }
  b := c[0].sliders[r];
  k := c[0].dpr;
  f := clamp((x - (b.x0 + 10 * k)) / hi(b.x1 - b.x0 - 20 * k, 1), 0, 1);
  at := c[0].slider_of[r];
  range := shape_range(at);
  i := c[0].chosen;
  reshape(c, i, verse_figure_shape_set(c[0].figs[i].shape, at, range.x + (range.y - range.x) * f));
}
slider_at :: (c: [] Chars, x: f32, y: f32) -> int {
  if !c[0].shaping { return -1; }
  for r: 0..<c[0].slider_n { if inside(c[0].sliders[r], x, y) { return r; } }
  return -1;
}

// ---- the frame

coaxial_chars_frame :: (c: [] Chars, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if !c[0].built { build(c); }
  step_dt := clamp(ifx finite(dt) then dt else 0, 0, 0.1);
  if still { step_dt = 0; }
  c[0].time += step_dt; c[0].frames += 1; c[0].idle += step_dt;
  c[0].width = width; c[0].height = height; c[0].dpr = hi(dpr, 0.5);
  if c[0].idle > 6 { c[0].yaw += 0.05 * step_dt; }
  if phone(c) && c[0].frames == 1 { c[0].dist = 7.5; }
  for i: 0..<c[0].fig_n { c[0].figs[i] = step(c[0].figs[i], step_dt); settle(c, i); }
  view(c);

  for i: 0..<u.count { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = c[0].time; u[3] = smooth01(c[0].time / 1.2);
  u[4] = cast(f32) c[0].fig_n; u[6] = c[0].dpr; u[7] = cast(f32) c[0].chosen;
  u[8] = c[0].eye.x; u[9] = c[0].eye.y; u[10] = c[0].eye.z; u[11] = c[0].tv;
  u[12] = c[0].right.x; u[13] = c[0].right.y; u[14] = c[0].right.z;
  u[16] = c[0].up.x; u[17] = c[0].up.y; u[18] = c[0].up.z;
  u[20] = c[0].ahead.x; u[21] = c[0].ahead.y; u[22] = c[0].ahead.z;
  u[24] = -0.45; u[25] = 0.62; u[26] = -0.64;
  for i: 0..<c[0].fig_n {
    w := c[0].figs[i];
    if (i + 1) * FIG_FLOATS > FIGS * FIG_FLOATS { break; }
    bones := u[BONE_AT + i * MAX_PARTS * BONE_FLOATS ..< BONE_AT + (i + 1) * MAX_PARTS * BONE_FLOATS];
    n := verse_figure_place(w.skel, pose_of(c, w), w.at, bones, c[0].figs[i].bound[..]);
    o := FIG_AT + i * FIG_FLOATS;
    b := c[0].figs[i].bound;
    u[o] = b[0]; u[o + 1] = b[1]; u[o + 2] = b[2]; u[o + 3] = b[3];
    u[o + 4] = w.shape.coat.x; u[o + 5] = w.shape.coat.y; u[o + 6] = w.shape.coat.z; u[o + 7] = cast(f32) w.shape.look;
    u[o + 8] = w.shape.marks.x; u[o + 9] = w.shape.marks.y; u[o + 10] = w.shape.marks.z; u[o + 11] = cast(f32) w.shape.pattern;
    u[o + 12] = w.at.x; u[o + 13] = w.at.y; u[o + 14] = w.at.z; u[o + 15] = w.at.yaw;
    u[o + 16] = cast(f32) n; u[o + 17] = ifx w.shape.look == LOOK_SOFT then w.skel.blend * 2.5 else w.skel.blend; u[o + 18] = w.shape.size;
    u[o + 19] = ifx i == c[0].chosen && w.shape.look == LOOK_LIT then 0.02f32 else 0;
  }

  // the HUD
  c[0].plate_n = 0;
  for i: 0..<BUTTONS { c[0].shown[i] = false; }
  k := c[0].dpr;
  m := ifx phone(c) then 16 * k else 28 * k;
  vertices := 0;
  vertices = words(out, vertices, "CHARACTERS", m, m + 14 * k, 14 * k, ink_of(k, 1, true));
  w := c[0].figs[c[0].chosen];
  vertices = words(out, vertices, w.name, m, m + 36 * k, 9 * k, ink_of(k, 0.95, false));
  hint := ifx phone(c) then "TAP A FIGURE · DRAG TO TURN" else "CLICK A FIGURE TO CHOOSE IT · DRAG TO TURN · 1 2 3 T GAIT · L LOOK · S SHAPE · 4 TO 9 EMOTES";
  vertices = words(out, vertices, hint, m, m + 54 * k, 6.5 * k, ink_of(k, 0.55, false));
  if c[0].notice_n > 0 && c[0].time < c[0].notice_until {
    // on a phone, two lines: what happened, then why
    note := cast(string) c[0].notice[0..<c[0].notice_n];
    cut := -1;
    for i: 0..<note.count - 2 { if cut < 0 && note[i] == ' ' && note[i + 1] == 0xC2 && note[i + 2] == 0xB7 { cut = i; } }
    room := width - 2 * m;
    if phone(c) && cut > 0 && cut + 4 < note.count {
      a := note[0..<cut]; b := note[cut + 4..<note.count];
      vertices = words(out, vertices, a, m, m + 74 * k, lo(7 * k, room / hi(measure(a, GAP, SPACE, false), 0.001)), ink_of(k, 0.95, !c[0].notice_bad));
      vertices = words(out, vertices, b, m, m + 88 * k, lo(7 * k, room / hi(measure(b, GAP, SPACE, false), 0.001)), ink_of(k, 0.95, !c[0].notice_bad));
    } else {
      vertices = words(out, vertices, note, m, m + 74 * k, lo(7 * k, room / hi(measure(note, GAP, SPACE, false), 0.001)), ink_of(k, 0.95, !c[0].notice_bad));
    }
  }
  // the gaits, the look and SHAPE; a person doesn't trot
  four := w.shape.rig == Rig.animal;
  row := [6] int.[BTN_STAND, BTN_WALK, BTN_TROT, BTN_RUN, BTN_LOOK, BTN_SHAPE];
  count := 6;
  if !four { row = [6] int.[BTN_STAND, BTN_WALK, BTN_RUN, BTN_LOOK, BTN_SHAPE, 0]; count = 5; }
  gap := 8 * k; bh := ifx phone(c) then 32 * k else 34 * k;
  bw := lo(92 * k, (width - 2 * m - cast(f32) (count - 1) * gap) / cast(f32) count);
  x := (width - (bw * cast(f32) count + gap * cast(f32) (count - 1))) * 0.5; y := height - m - bh;
  for r: 0..<count {
    i := row[r];
    b := Box.{x0 = x, y0 = y, x1 = x + bw, y1 = y + bh};
    if i == BTN_LOOK { vertices = button(c, out, vertices, i, b, ifx w.shape.look == LOOK_SOFT then "SOFT" else "LIT", w.shape.look == LOOK_SOFT); }
    else if i == BTN_SHAPE { vertices = button(c, out, vertices, i, b, "SHAPE", c[0].shaping); }
    else {
      g := ifx i == BTN_STAND then Gait.stand else ifx i == BTN_WALK then Gait.walk else ifx i == BTN_TROT then Gait.trot else Gait.run;
      label := ifx i == BTN_STAND then "STAND" else ifx i == BTN_WALK then "WALK" else ifx i == BTN_TROT then "TROT" else "RUN";
      vertices = button(c, out, vertices, i, b, label, w.gait == g);
    }
    x += bw + gap;
  }
  // the chosen figure's emotes, a row above
  emotes := 0;
  for e: 0..<EMOTES { if emote_slot(c, w.shape.rig, e) >= 0 { emotes += 1; } }
  top := y;
  if emotes > 0 {
    ew := lo(92 * k, (width - 2 * m - cast(f32) (emotes - 1) * gap) / cast(f32) emotes);
    ex := (width - (ew * cast(f32) emotes + gap * cast(f32) (emotes - 1))) * 0.5;
    ey := y - bh - gap; top = ey;
    for e: 0..<emotes {
      slot := emote_slot(c, w.shape.rig, e);
      label := ifx slot == c[0].linked then "YOURS" else ifx !four && e < PERSON_MOTIONS then PERSON_MOTION_LABELS[e]
               else ifx four && e < ANIMAL_MOTIONS then ANIMAL_MOTION_LABELS[e] else verse_motion_name(c[0].motions[slot..<slot + 1]);
      vertices = button(c, out, vertices, BTN_EMOTE + e, Box.{x0 = ex, y0 = ey, x1 = ex + ew, y1 = ey + bh}, label, playing(c, c[0].chosen, slot));
      ex += ew + gap;
    }
  }
  c[0].slider_n = 0;
  if c[0].shaping { vertices = shape_panel(c, out, vertices, w, m, top - gap); }
  for p: 0..<c[0].plate_n {
    o := PANEL_AT + p * 8; b := c[0].plates[p];
    u[o] = b.x0; u[o + 1] = b.y0; u[o + 2] = b.x1; u[o + 3] = b.y1;
    u[o + 4] = k; u[o + 5] = c[0].plate_alpha[p]; u[o + 6] = c[0].plate_look[p];
  }
  u[5] = cast(f32) c[0].plate_n;
  return vertices;
}

// ---- input

act :: (c: [] Chars, i: int) {
  ch := c[0].chosen;
  if i == BTN_STAND { gait_for(c, ch, Gait.stand); }
  else if i == BTN_WALK { gait_for(c, ch, Gait.walk); }
  else if i == BTN_TROT { if c[0].figs[ch].shape.rig == Rig.animal { gait_for(c, ch, Gait.trot); } }
  else if i == BTN_RUN { gait_for(c, ch, Gait.run); }
  else if i == BTN_SHAPE { c[0].shaping = !c[0].shaping; }
  else if i == BTN_PATTERN { s := c[0].figs[ch].shape; s.pattern = (s.pattern + 1) % PATTERNS; reshape(c, ch, s); }
  else if i >= BTN_COAT && i < BTN_COAT + COATS { s := c[0].figs[ch].shape; o := (i - BTN_COAT) * 3; s.coat = fv(COAT_COLOURS[o], COAT_COLOURS[o + 1], COAT_COLOURS[o + 2]); reshape(c, ch, s); }
  else if i >= BTN_MARKS && i < BTN_MARKS + MARKS { s := c[0].figs[ch].shape; o := (i - BTN_MARKS) * 3; s.marks = fv(MARK_COLOURS[o], MARK_COLOURS[o + 1], MARK_COLOURS[o + 2]); reshape(c, ch, s); }
  else if i >= BTN_EMOTE && i < BTN_EMOTE + EMOTES {
    emote(c, c[0].chosen, emote_slot(c, c[0].figs[c[0].chosen].shape.rig, i - BTN_EMOTE));
  }
  else if i == BTN_LOOK {
    s := c[0].figs[c[0].chosen].shape;
    s.look = ifx s.look == LOOK_SOFT then LOOK_LIT else LOOK_SOFT;
    c[0].figs[c[0].chosen].shape = s;
  }
}
button_at :: (c: [] Chars, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if c[0].shown[i] && inside(c[0].boxes[i], x, y) { return i; } }
  return -1;
}
coaxial_chars_pointer :: (c: [] Chars, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if kind == 1 { c[0].touch = true; }
  if phase == 0 {
    c[0].idle = 0;
    if c[0].down { return true; }
    c[0].press = button_at(c, x, y);
    c[0].sliding = ifx c[0].press < 0 then slider_at(c, x, y) else -1;
    if c[0].sliding >= 0 { slide(c, c[0].sliding, x); }
    c[0].down = true; c[0].down_id = id; c[0].lx = x; c[0].ly = y; c[0].travel = 0;
    return true;
  }
  if phase == 1 {
    if !c[0].down { c[0].hover = button_at(c, x, y); if c[0].hover < 0 && slider_at(c, x, y) >= 0 { c[0].hover = BUTTONS; } return false; }
    if id != c[0].down_id { return true; }
    dx := x - c[0].lx; dy := y - c[0].ly;
    c[0].travel += abs(dx) + abs(dy);
    if c[0].sliding >= 0 { slide(c, c[0].sliding, x); }
    else if c[0].press < 0 {
      k := c[0].dpr;
      c[0].yaw -= dx / k * 0.008;
      c[0].pitch = clamp(c[0].pitch + dy / k * 0.006, 0.05, 1.2);
    }
    c[0].lx = x; c[0].ly = y; c[0].idle = 0;
    return true;
  }
  if !c[0].down || id != c[0].down_id { return false; }
  c[0].down = false;
  pressed := c[0].press; c[0].press = -1;
  was_sliding := c[0].sliding >= 0; c[0].sliding = -1;
  if phase == 3 || was_sliding { return true; }
  if pressed >= 0 { if inside(c[0].boxes[pressed], x, y) { act(c, pressed); } return true; }
  if c[0].travel < 10 * c[0].dpr {
    f := pick(c, x, y);
    if f >= 0 { c[0].chosen = f; }
  }
  return true;
}
coaxial_chars_wheel :: (c: [] Chars, dy: f32) #export_c {
  c[0].dist = clamp(c[0].dist * exp(clamp(dy, -200, 200) * 0.0015), 2.5, 16);
  c[0].idle = 0;
}
coaxial_chars_key :: (c: [] Chars, key: int, mods: int) -> bool #export_c {
  c[0].idle = 0;
  if key == '1' { act(c, BTN_STAND); return true; }
  if key == '2' { act(c, BTN_WALK); return true; }
  if key == '3' { act(c, BTN_RUN); return true; }
  if key == 't' || key == 'T' { act(c, BTN_TROT); return true; }
  if key == 's' || key == 'S' { act(c, BTN_SHAPE); return true; }
  if key == 'l' || key == 'L' { act(c, BTN_LOOK); return true; }
  if key >= '4' && key <= '9' { act(c, BTN_EMOTE + key - '4'); return true; }
  if key == 9 || key == -5 { c[0].chosen = (c[0].chosen + 1) % (ifx c[0].fig_n > 0 then c[0].fig_n else 1); return true; }
  if key == -4 { c[0].chosen = (c[0].chosen + c[0].fig_n - 1) % (ifx c[0].fig_n > 0 then c[0].fig_n else 1); return true; }
  return false;
}
coaxial_chars_cursor :: (c: [] Chars) -> int #export_c { return ifx c[0].hover >= 0 then 1 else 0; }

#test "the cast is built once, and a gait change walks the chosen figure off" {
  cs: [1] Chars; c := cs[..];
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.016, false);
  #assert n > 0 && c[0].fig_n == 5 && u[4] == 5 && u[5] == 5 + PERSON_MOTIONS;
  #assert u[FIG_AT + 7] == 1 && u[FIG_AT + FIG_FLOATS * 2 + 7] == 0 && u[FIG_AT + 16] > 15;
  x0 := c[0].figs[1].at.x;
  c[0].chosen = 1;
  #assert coaxial_chars_key(c, '2', 0);
  for f: 0..<5 { n = coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.1, false); }
  #assert c[0].figs[1].gait == Gait.walk && abs(c[0].figs[1].at.x - x0) > 0.1;
  #assert coaxial_chars_key(c, 'l', 0) && c[0].figs[1].shape.look == LOOK_LIT;
}
#test "a tap on a button acts; a tap on a figure chooses it" {
  cs: [1] Chars; c := cs[..];
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.016, false);
  b := c[0].boxes[BTN_RUN];
  #assert coaxial_chars_pointer(c, b.x0 + 4, b.y0 + 4, 0, 0, 1) && coaxial_chars_pointer(c, b.x0 + 4, b.y0 + 4, 2, 0, 1);
  #assert c[0].figs[0].gait == Gait.run;
  // the guest, from where it stands on screen
  w := c[0].figs[2].bound;
  p := fv_sub(fv(w[0], w[1], w[2]), c[0].eye);
  z := p.x * c[0].ahead.x + p.y * c[0].ahead.y + p.z * c[0].ahead.z;
  sx := (p.x * c[0].right.x + p.y * c[0].right.y + p.z * c[0].right.z) / z / c[0].tv / (1280.0 / 800.0);
  sy := (p.x * c[0].up.x + p.y * c[0].up.y + p.z * c[0].up.z) / z / c[0].tv;
  px := (sx + 1) * 0.5 * 1280; py := (1 - sy) * 0.5 * 800;
  #assert coaxial_chars_pointer(c, px, py, 0, 0, 1) && coaxial_chars_pointer(c, px, py, 2, 0, 1);
  #assert c[0].chosen == 2;
}
#test "an emote plays over the gait and fades; a motion from the link plays or says why not" {
  cs: [1] Chars; c := cs[..];
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for i: 0..<12 { c[0].inbox[i] = "motion=bogus"[i]; }
  coaxial_chars_hash(c, 12);
  n := coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.016, false);
  #assert c[0].motion_n == PERSON_MOTIONS + ANIMAL_MOTIONS && c[0].notice_bad && c[0].shown[BTN_EMOTE + 4];
  #assert coaxial_chars_key(c, '4', 0) && c[0].figs[0].now.motion == 0;
  c[0].time += 0.6;
  w := c[0].figs[0];
  p := pose_of(c, w);
  #assert p.turn[P_R_SHOULDER].z < -1.5;
  c[0].time += 3; settle(c, 0);
  #assert c[0].figs[0].now.motion == -1;
  text := "motion=nod; rig person; seconds 1; loop; at 0; head 20 0 0; at 0.5; head -20 0 0";
  for i: 0..<text.count { c[0].inbox[i] = text[i]; }
  coaxial_chars_hash(c, text.count);
  #assert !c[0].notice_bad && c[0].linked == PERSON_MOTIONS + ANIMAL_MOTIONS && c[0].figs[c[0].chosen].now.motion == c[0].linked;
  bad := "motion nod; rig person; seconds 1; at 0; head 99 0 0";
  for i: 0..<bad.count { c[0].inbox[i] = bad[i]; }
  coaxial_chars_hash(c, bad.count);
  #assert c[0].notice_bad && c[0].linked == -1 && c[0].motion_n == PERSON_MOTIONS + ANIMAL_MOTIONS;
}
#test "an animal trots, sits still to an emote, and takes a shape from sliders and from the link" {
  cs: [1] Chars; c := cs[..];
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.016, false);
  c[0].chosen = 3;
  #assert coaxial_chars_key(c, 't', 0) && c[0].figs[3].gait == Gait.trot;
  #assert coaxial_chars_key(c, '4', 0) && c[0].figs[3].gait == Gait.stand && c[0].motions[c[0].figs[3].now.motion].still;
  #assert coaxial_chars_key(c, 's', 0) && c[0].shaping;
  n = coaxial_chars_frame(c, out[..], u[..], 1280, 800, 1, 0.016, false);
  #assert c[0].slider_n == SHAPE_NUMBERS && c[0].shown[BTN_PATTERN] && c[0].shown[BTN_COAT + 5];
  b := c[0].sliders[0];
  #assert coaxial_chars_pointer(c, b.x1, (b.y0 + b.y1) * 0.5, 0, 0, 1) && coaxial_chars_pointer(c, b.x1, (b.y0 + b.y1) * 0.5, 2, 0, 1);
  #assert c[0].figs[3].shape.size == 1.8 && c[0].figs[3].skel.size == 1.8;
  p := c[0].boxes[BTN_PATTERN];
  #assert coaxial_chars_pointer(c, p.x0 + 2, p.y0 + 2, 0, 0, 1) && coaxial_chars_pointer(c, p.x0 + 2, p.y0 + 2, 2, 0, 1);
  #assert c[0].figs[3].shape.pattern == (PATTERN_SOCKS + 1) % PATTERNS;
  text := "shape=size 0.6; ears 0; pattern stripes";
  for i: 0..<text.count { c[0].inbox[i] = text[i]; }
  coaxial_chars_hash(c, text.count);
  #assert c[0].figs[3].shape.size == 0.6 && c[0].figs[3].shape.pattern == PATTERN_STRIPES && !c[0].notice_bad;
  bad := "shape=size 0.6; legs 7";
  for i: 0..<bad.count { c[0].inbox[i] = bad[i]; }
  coaxial_chars_hash(c, bad.count);
  #assert c[0].notice_bad && c[0].figs[3].shape.legs == 1;
}
