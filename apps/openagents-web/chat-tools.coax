// The chat's tool calls (GitHub #13481): what each call an agent made is, as the transcript keeps it and as a
// person reads it. A run of calls is kept as records, one a call: how it stands, when it started and how long
// it took, its kind and its own name, its ID, the argument that matters, words that name it (a Gemini world
// step's own), what it sent and what came back. The three sources fill them: a local agent's session log
// (`tool` and `result` lines: coax/lib/agent/session/log.coax), the hosted agent's turn (its tools' names and
// details) and a Gemini turn's world plan in the editor (coax/lib/agent/world/turn.coax).
//
// What a call is called is a lookup on typed fields, never words matched in text: one of our realm tools by its
// exact name in the command table's copy (realm-tools.coax, from REALM_COMMANDS), its label filled from the
// call's own input; an engine's tool by the session log's kind (SL_TOOLS) or its exact name; anything else by
// its cleaned name and first short argument. A realm tool's answer is read as realm.result.v1
// (metaverse-engine/editor/op-result.coax), so a dry run, a refusal, a wait for approval and an unknown outcome
// each say so. The rows are the kit's (components/kit/work.coax).
//   coax/bin/coax test apps/openagents-web/chat-tools.coax

#load "../../components/kit/work.coax";
#load "../../metaverse-engine/editor/op-result.coax";   // realm.result.v1: the realm tools' answers
#load "realm-tools.coax";                                // the command table's tool words (generated)

CQ_FS :: 31; CQ_RS :: 30;     // a record's fields end with the unit separator, a record with the record separator
CQ_ARG :: 240;                // bytes of a call's argument kept
CQ_LABEL :: 200;              // and of its own words
CQ_INPUT :: 2000;             // and of what it sent
CQ_OUTPUT :: 3000;            // and of what came back (a session log keeps 4000)
CQ_MOST :: 96;                // calls of one run drawn
CQ_GROUPS :: 48;              // groups of one run drawn
CQ_OPENS :: 64;               // rows a page keeps open

// One call, its strings in the record it was read from.
CqCall :: struct { state: int; t0: int; ms: int = -1; kind: string; name: string; id: string; arg: string; label: string; input: string; output: string; }

// ---------------------------------------------------------------- records

cq_put :: (out: [] u8, at: int, text: string, most: int) -> int {
  if at < 0 { return -1; }
  cut := ifx text.count > most then most else text.count;
  while cut > 0 && cut < text.count && (text[cut] & 0xC0) == 0x80 { cut -= 1; }
  n := at;
  for i: 0..<cut {
    c := text[i];
    if c == CQ_FS || c == CQ_RS { continue; }
    if n >= out.count { return -1; }
    out[n] = c; n += 1;
  }
  if n >= out.count { return -1; }
  out[n] = CQ_FS;
  return n + 1;
}
cq_num :: (out: [] u8, at: int, v: int) -> int { num: [24] u8; return cq_put(out, at, tr_join(num[..], ifx v < 0 then "-" else "", ifx v < 0 then -v else v), 24); }
// A call as a record into out at `at`: where it ends, or -1 when it doesn't fit.
cq_write :: (out: [] u8, at: int, c: CqCall) -> int {
  n := cq_num(out, at, c.state); n = cq_num(out, n, c.t0); n = cq_num(out, n, c.ms);
  n = cq_put(out, n, c.kind, 24); n = cq_put(out, n, c.name, 120); n = cq_put(out, n, c.id, 80);
  n = cq_put(out, n, c.arg, CQ_ARG); n = cq_put(out, n, c.label, CQ_LABEL);
  n = cq_put(out, n, c.input, CQ_INPUT); n = cq_put(out, n, c.output, CQ_OUTPUT);
  if n < 0 || n >= out.count { return -1; }
  out[n - 1] = CQ_RS;   // the last field's end is the record's
  return n;
}
cq_int :: (s: string) -> int {
  neg := s.count > 0 && s[0] == '-'; v := 0;
  for i: (ifx neg then 1 else 0)..<s.count { if s[i] < '0' || s[i] > '9' { return 0; } v = v * 10 + cast(int) (s[i] - '0'); }
  return ifx neg then -v else v;
}
// The record at `at` in text into c: where the next one starts, or -1 when there is none.
cq_read :: (text: string, at: int, c: [] CqCall) -> int {
  if at < 0 || at >= text.count { return -1; }
  f: [10] string; k := 0; from := at; i := at;
  while i < text.count {
    ch := text[i];
    if ch == CQ_FS || ch == CQ_RS {
      if k < 10 { f[k] = text[from..<i]; k += 1; }
      from = i + 1;
      if ch == CQ_RS { break; }
    }
    i += 1;
  }
  if k != 10 { return -1; }
  c[0] = CqCall.{state = cq_int(f[0]), t0 = cq_int(f[1]), ms = cq_int(f[2]), kind = f[3], name = f[4], id = f[5], arg = f[6], label = f[7], input = f[8], output = f[9]};
  return i + 1;
}
// The calls of a run into calls: how many (at most calls.count).
cq_calls :: (text: string, calls: [] CqCall) -> int {
  n := 0; at := 0;
  while n < calls.count {
    next := cq_read(text, at, calls[n..<n + 1]);
    if next < 0 { break; }
    n += 1; at = next;
  }
  return n;
}
// Where record i starts in text, or -1.
cq_at :: (text: string, i: int) -> int {
  at := 0; c: [1] CqCall;
  for k: 0..<i { at = cq_read(text, at, c[..]); if at < 0 { return -1; } }
  return ifx at < text.count then at else -1;
}

// ---------------------------------------------------------------- what a call is called

// An engine's tools by the session log's kind (SL_TOOLS, coax/lib/agent/session/log.coax): what one call does,
// what a run of them does, and its icon. The kinds are exact words the log writes, not text read for meaning.
CQ_KINDS :: [16] string.["thought", "exec", "read", "edit", "search", "fetch", "write", "glob", "web", "todo", "mcp", "agent", "tool", "route", "load", "find-tools"];
CQ_KIND_LABEL :: [16] string.["Think", "Run a command", "Read a file", "Edit a file", "Search the code", "Fetch a page", "Write a file", "Find files", "Search the web", "Update the to-do list", "Call a tool", "Start an agent", "Use a tool", "Route", "Load a model", "Look up tools"];
CQ_KIND_MANY :: [16] string.["Thoughts", "Run commands", "Read files", "Edit files", "Search the code", "Fetch pages", "Write files", "Find files", "Search the web", "Update the to-do list", "Call tools", "Start agents", "Use tools", "Route", "Load models", "Look up tools"];
CQ_KIND_ICON :: [16] int.[IC_BRAIN, IC_TERMINAL, IC_EYE, IC_EDIT_PENCIL, IC_SEARCH, IC_GLOBE, IC_EDIT_PENCIL, IC_FOLDER_OPEN, IC_GLOBE, IC_NOTEBOOK_CHECK, IC_TOOLS, IC_ROBOT, IC_TOOLS, IC_COMPASS, IC_CUBE, IC_SEARCH];
// A tool's exact name, as an engine or the hosted agent calls it, and its kind: for a source that names its
// tools but not their kinds (the hosted agent; the repo tools are its read-only ones).
CQ_NAMES :: [24] string.["Bash", "Read", "Edit", "MultiEdit", "NotebookEdit", "Write", "Grep", "Glob", "WebSearch", "WebFetch", "TodoWrite", "Task", "Agent", "ToolSearch",
  "tree", "read", "find", "search", "log", "show", "diff", "blame", "web_search", "web_fetch"];
CQ_NAME_KIND :: [24] string.["exec", "read", "edit", "edit", "edit", "write", "search", "glob", "web", "fetch", "todo", "agent", "agent", "find-tools",
  "glob", "read", "glob", "search", "read", "read", "read", "read", "web", "fetch"];
// A realm tool's icon, by its row's effect (commands.coax RC_EFFECTS).
CQ_EFFECTS :: [6] string.["read", "write", "publish", "player-facing", "spend", "destructive"];
CQ_EFFECT_ICON :: [6] int.[IC_EYE, IC_EDIT_PENCIL, IC_GLOBE, IC_USER, IC_SPARKLE, IC_TRASH];

cq_index :: (list: [] const string, word: string) -> int { for w, i: list { if w == word { return i; } } return -1; }
// The tool's own name without the prefix an agent gives a server's tools ("mcp__openagents__realm_world_plan" is
// realm_world_plan), and the server's name ("openagents"; "" when it has none).
cq_tail :: (name: string) -> string {
  if name.count < 6 || cast(string) name[0..<5] != "mcp__" { return name; }
  for i: 5..<name.count - 1 { if name[i] == '_' && name[i + 1] == '_' { return name[i + 2..<name.count]; } }
  return name;
}
cq_server :: (name: string) -> string {
  if name.count < 6 || cast(string) name[0..<5] != "mcp__" { return ""; }
  for i: 5..<name.count - 1 { if name[i] == '_' && name[i + 1] == '_' { return name[5..<i]; } }
  return "";
}
// The command table's row for a realm tool, by its exact name, or -1.
cq_realm :: (name: string) -> int {
  tail := cq_tail(name);
  for r, i: REALM_TOOLS { if r.name == tail { return i; } }
  return -1;
}
// A call of realm_call (apps/openagents-cli/mcp.coax, #13439) is a call of the realm tool it names, with the
// arguments inside it: the chat words it as that tool. Any other call is itself.
cq_inner :: (c: CqCall) -> CqCall {
  if cq_tail(c.name) != "realm_call" { return c; }
  nodes: [96] JvNode; d: [1] Jv;
  if c.input.count == 0 || !jv_parse(d[..], c.input, nodes[..]) { return c; }
  at := jv_get(d[0], 0, "name");
  if jv_kind(d[0], at) != JV_STRING { return c; }
  raw := jv_raw(d[0], at);
  for ch: raw { if ch == '\\' { return c; } }
  if raw.count == 0 { return c; }
  r := c; r.name = raw;
  args := jv_get(d[0], 0, "arguments");
  r.input = ifx jv_kind(d[0], args) == JV_OBJECT then jv_raw(d[0], args) else "";
  return r;
}
// The call's kind in CQ_KINDS: its own, else its exact name's, else -1.
cq_kind :: (c: CqCall) -> int {
  if cq_tail(c.name) == "realm_find" { return cq_index(CQ_KINDS[..], "find-tools"); }
  k := cq_index(CQ_KINDS[..], c.kind);
  if k >= 0 && c.kind != "mcp" && c.kind != "tool" { return k; }
  j := cq_index(CQ_NAMES[..], c.name);
  if j >= 0 { return cq_index(CQ_KINDS[..], CQ_NAME_KIND[j]); }
  return k;
}
// One property of a call's input as text: a string's own text, a number or a boolean as written; "" when the
// input has no such property, or it is an object, an array or null.
cq_prop :: (input: string, name: string, out: [] u8) -> string {
  nodes: [96] JvNode; d: [1] Jv;
  if input.count == 0 || !jv_parse(d[..], input, nodes[..]) { return ""; }
  at := jv_get(d[0], 0, name); kind := jv_kind(d[0], at);
  if kind == JV_STRING { n := jv_str(d[0], at, out); return ifx n < 0 then "" else cast(string) out[0..<n]; }
  if kind == JV_NUMBER || kind == JV_TRUE || kind == JV_FALSE {
    raw := jv_raw(d[0], at); n := 0;
    for ch: raw { if n < out.count { out[n] = ch; n += 1; } }
    return cast(string) out[0..<n];
  }
  return "";
}
// A row's label with the call's values: each {PROP} the input's property; a [part] is left out when a property in
// it has none, and a {PROP} outside a part with none reads "?".
cq_fill :: (template: string, input: string, out: [] u8) -> string {
  n := 0; part_at := -1; part_ok := true; i := 0;
  while i < template.count {
    ch := template[i];
    if ch == '[' { part_at = n; part_ok = true; i += 1; continue; }
    if ch == ']' { if !part_ok { n = part_at; } part_at = -1; i += 1; continue; }
    if ch == '{' {
      e := i + 1;
      while e < template.count && template[e] != '}' { e += 1; }
      v: [CQ_ARG] u8;
      value := cq_prop(input, template[i + 1..<e], v[..]);
      if value.count == 0 { if part_at >= 0 { part_ok = false; } else { value = "?"; } }
      n = kw_put(out, n, value);
      if n < 0 { return ""; }
      i = e + 1; continue;
    }
    if n < out.count { out[n] = ch; n += 1; }
    i += 1;
  }
  return cast(string) out[0..<n];
}
// A name a person can read: "do_thing" is "Do thing" (underscores and dashes are spaces, the first letter a capital).
cq_clean :: (name: string, out: [] u8) -> string {
  n := 0;
  for ch: name {
    if n >= out.count { break; }
    c := ifx ch == '_' || ch == '-' then cast(u8) ' ' else ch;
    if n == 0 && c >= 'a' && c <= 'z' { c = c - 32; }
    out[n] = c; n += 1;
  }
  return cast(string) out[0..<n];
}
// What one call did, in words.
cq_label :: (call: CqCall, out: [] u8) -> string {
  if call.label.count > 0 { return call.label; }
  c := cq_inner(call);
  if cq_tail(c.name) == "realm_find" { return CQ_KIND_LABEL[cq_kind(c)]; }
  r := cq_realm(c.name);
  if r >= 0 { return cq_fill(REALM_TOOLS[r].label, c.input, out); }
  k := cq_kind(c);
  if k >= 0 && c.kind != "mcp" && c.kind != "tool" || k >= 0 && cq_index(CQ_NAMES[..], c.name) >= 0 { return CQ_KIND_LABEL[k]; }
  // a tool we don't know: its server and its name, cleaned
  server := cq_server(c.name); n := 0;
  if server.count > 0 { s := cq_clean(server, out); n = s.count; n = kw_put(out, n, ": "); if n < 0 { return ""; } }
  t := cq_clean(cq_tail(ifx c.name.count > 0 then c.name else "tool"), out[n..<out.count]);
  if server.count > 0 && t.count > 0 && out[n] >= 'A' && out[n] <= 'Z' { out[n] = out[n] + 32; }
  return cast(string) out[0..<n + t.count];
}
// What a run of calls of this tool did, in words.
cq_many :: (call: CqCall, out: [] u8) -> string {
  c := cq_inner(call);
  if cq_tail(c.name) == "realm_find" { return CQ_KIND_MANY[cq_kind(c)]; }
  r := cq_realm(c.name);
  if r >= 0 { return REALM_TOOLS[r].many; }
  if c.label.count > 0 { return cq_label(c, out); }
  k := cq_kind(c);
  if k >= 0 && (c.kind != "mcp" && c.kind != "tool" || cq_index(CQ_NAMES[..], c.name) >= 0) { return CQ_KIND_MANY[k]; }
  return cq_label(c, out);
}
cq_icon :: (call: CqCall) -> int {
  c := cq_inner(call);
  r := cq_realm(c.name);
  if r >= 0 { e := cq_index(CQ_EFFECTS[..], REALM_TOOLS[r].effect); return ifx e >= 0 then CQ_EFFECT_ICON[e] else IC_TOOLS; }
  k := cq_kind(c);
  return ifx k >= 0 then CQ_KIND_ICON[k] else IC_TOOLS;
}
// The argument that matters: the realm or world a realm tool worked on; an engine tool's own (the command, the
// path, the pattern); else the first short text the call sent.
cq_arg :: (call: CqCall, out: [] u8) -> string {
  c := cq_inner(call);
  if cq_realm(c.name) >= 0 { return cq_prop(c.input, "slug", out); }
  if c.arg.count > 0 { return c.arg; }
  nodes: [96] JvNode; d: [1] Jv;
  if c.input.count == 0 || !jv_parse(d[..], c.input, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return ""; }
  for i: 0..<jv_len(d[0], 0) {
    at := jv_at(d[0], 0, i);
    if jv_kind(d[0], at) != JV_STRING { continue; }
    n := jv_str(d[0], at, out);
    if n > 0 && n <= 120 { return cast(string) out[0..<n]; }
  }
  return "";
}

// ---------------------------------------------------------------- how it stands

// A realm tool's answer (the CLI's report with "result": realm.result.v1) into r, and whether it is one.
cq_realm_result :: (output: string, r: [] OpResult, words: [] OpRead) -> bool {
  nodes: [64] JvNode; d: [1] Jv;
  if output.count == 0 || output.count > 8192 || !jv_parse(d[..], output, nodes[..]) { return false; }
  at := jv_get(d[0], 0, "result");
  if jv_kind(d[0], at) != JV_OBJECT { return false; }
  r[0] = or_read(jv_raw(d[0], at), words);
  return r[0].ok;
}
// How a call stands once its answer has come: from a realm tool's result when it has one, else failed or done.
cq_state :: (output: string, failed: bool) -> int {
  r: [1] OpResult; w: [1] OpRead;
  if cq_realm_result(output, r[..], w[..]) {
    s := r[0].state;
    if s == OR_DONE { return KW_DONE; }
    if s == OR_RUNNING { return KW_RUN; }
    if s == OR_NEEDS_APPROVAL { return KW_ASK; }
    if s == OR_DRY_RUN { return KW_DRY; }
    if s == OR_REFUSED { return KW_REFUSED; }
    return KW_UNKNOWN;
  }
  return ifx failed then KW_FAILED else KW_DONE;
}
// Why a call stands as it does, in words, when it didn't simply work: a refusal's own words and whether a retry
// can help, how far a dry run went, a wait for approval, an unknown outcome, or a failure's first line.
cq_why :: (c: CqCall, out: [] u8) -> string {
  if c.state == KW_RUN || c.state == KW_DONE { return ""; }
  r: [1] OpResult; w: [1] OpRead; n := 0;
  if cq_realm_result(c.output, r[..], w[..]) {
    words := or_words(w[..]);
    if c.state == KW_DRY {
      levels := [4] string.["the arguments are a well-formed request", "checked against the world as it stands", "the change was worked out", "carried out whole in a throwaway copy of the world"];
      n = kw_put(out, 0, "Nothing was saved: "); n = kw_put(out, n, levels[ifx r[0].level >= 0 && r[0].level <= ORL_COPY then r[0].level else 0]); n = kw_put(out, n, ".");
    } else if c.state == KW_ASK { n = kw_put(out, 0, "Nothing was done. It runs once it is approved."); }
    else {
      n = kw_put(out, 0, ifx words.words.count > 0 then words.words else "No reason was given");
      n = kw_put(out, n, ifx c.state == KW_UNKNOWN then ". It may have been saved: read the world before trying again." else ifx r[0].retry then ". Trying again can help." else ". Trying again won't help.");
    }
    return ifx n < 0 then "" else cast(string) out[0..<n];
  }
  if c.state == KW_UNKNOWN { return "No answer came before the turn ended."; }
  if c.state != KW_FAILED { return ""; }
  e := 0; while e < c.output.count && e < 240 && c.output[e] != '\n' { e += 1; }
  while e > 0 && e < c.output.count && (c.output[e] & 0xC0) == 0x80 { e -= 1; }
  return ifx e == 0 then "It failed and said nothing." else cast(string) c.output[0..<e];
}

// ---------------------------------------------------------------- a run, drawn

// Whether the row with this id is open: the page keeps the open ones' hashes (cq_toggle).
cq_open :: (opens: [] int, id: string) -> bool { h := tr_hash(id); for o: opens { if o == h { return true; } } return false; }
// Opens or closes the row with this id: how many are open after. A full list forgets its oldest.
cq_toggle :: (opens: [] int, n: int, id: string) -> int {
  h := tr_hash(id); m := ifx n > opens.count then opens.count else n;
  for i: 0..<m {
    if opens[i] == h { for j: i + 1..<m { opens[j - 1] = opens[j]; } return m - 1; }
  }
  if opens.count == 0 { return 0; }
  if m == opens.count { for j: 1..<m { opens[j - 1] = opens[j]; } m -= 1; }
  opens[m] = h;
  return m + 1;
}
// What groups calls: the tool's own name, else (a step that is only its words) the words.
cq_key :: (c: CqCall) -> int { return tr_hash(ifx c.name.count > 0 then c.name else c.label); }
// A run's groups: consecutive calls of one tool. Their starts into starts; how many.
cq_groups :: (calls: [] CqCall, starts: [] int) -> int {
  keys: [CQ_MOST] int;
  n := ifx calls.count > CQ_MOST then CQ_MOST else calls.count;
  for i: 0..<n { keys[i] = cq_key(calls[i]); }
  return kw_runs(keys[0..<n], starts);
}
// A finished run in one line: the two tools used most (a run of one tool by its many and a count, one call by its
// own words), and how many more.
cq_summary :: (calls: [] CqCall, out: [] u8) -> string {
  seen: [CQ_MOST] int; cnt: [CQ_MOST] int; first: [CQ_MOST] int; m := 0;
  for c, i: calls {
    h := cq_key(c); k := -1;
    for j: 0..<m { if seen[j] == h { k = j; } }
    if k < 0 { if m >= CQ_MOST { continue; } k = m; seen[m] = h; cnt[m] = 0; first[m] = i; m += 1; }
    cnt[k] += 1;
  }
  n := 0; used: [2] int; used[0] = -1; used[1] = -1;
  for pick: 0..<2 {
    best := -1;
    for j: 0..<m { if j != used[0] && (best < 0 || cnt[j] > cnt[best]) { best = j; } }
    if best < 0 { break; }
    used[pick] = best;
    b: [CQ_LABEL] u8; num: [24] u8;
    if pick > 0 { n = kw_put(out, n, ", "); }
    c := calls[first[best]];
    n = kw_put(out, n, ifx cnt[best] > 1 then cq_many(c, b[..]) else cq_label(c, b[..]));
    if cnt[best] > 1 { n = kw_put(out, n, " ×"); n = kw_put(out, n, tr_join(num[..], "", cnt[best])); }
  }
  if m > 2 { num: [24] u8; n = kw_put(out, n, ", and "); n = kw_put(out, n, tr_join(num[..], "", m - 2)); n = kw_put(out, n, ifx m - 2 == 1 then " more tool" else " more tools"); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// The first call of the tool a run used most (the first such tool on a tie): the run's line takes its icon.
cq_top :: (calls: [] CqCall) -> int {
  best := 0; most := 0;
  for c, i: calls {
    k := cq_key(c); m := 0;
    for d: calls { if cq_key(d) == k { m += 1; } }
    if m > most { most = m; best = i; }
  }
  return best;
}
// The running call's words, for the line under the transcript, or "".
cq_now :: (text: string, out: [] u8) -> string {
  calls: [CQ_MOST] CqCall; n := cq_calls(text, calls[..]);
  for k: 0..<n { i := n - 1 - k; if calls[i].state == KW_RUN { return cq_label(calls[i], out); } }
  return "";
}
// One call's row: id is the row's own ("m.7.c.3").
cq_row :: (t: [] Tree, u: [] Ui, id: string, c: CqCall, opens: [] int) {
  lb: [CQ_LABEL + CQ_ARG] u8; ab: [CQ_ARG] u8; wb: [OR_WORDS + 160] u8; all: [UI_ID] u8;
  r := k_work_row(t, u, id, cq_icon(c), cq_label(c, lb[..]), cq_arg(c, ab[..]), c.state, cq_why(c, wb[..]), c.ms, cq_open(opens, id), c.input, c.output, cq_open(opens, tr_cat(all[..], id, ".all")));
}
// A run of calls as the node id ("m.7"): while it is live, its groups (a tool used once is its row); once done, one
// line that opens onto them. A group opens onto its rows; a row onto what it sent and what came back. A call still
// running shows how long it has run (now and its start in ms); one still running once the run is over had no answer.
cq_draw :: (t: [] Tree, u: [] Ui, id: string, text: string, live: bool, opens: [] int, now: int) {
  calls: [CQ_MOST] CqCall; starts: [CQ_GROUPS] int;
  n := cq_calls(text, calls[..]);
  if n == 0 { return; }
  idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  box := tr_open(t, id, TG_DIV, "wk-log");
  states: [CQ_MOST] int;
  for i: 0..<n {
    if calls[i].state == KW_RUN && !live { calls[i].state = KW_UNKNOWN; }
    if calls[i].state == KW_RUN && calls[i].t0 > 0 && now > calls[i].t0 { calls[i].ms = now - calls[i].t0; }
    states[i] = calls[i].state;
  }
  sum := tr_cat(idb[..], id, ".w");
  open := live || cq_open(opens, sum);
  if !live {
    sb: [400] u8;
    g := k_work_group_begin(t, u, sum, cq_icon(calls[cq_top(calls[0..<n])]), cq_summary(calls[0..<n], sb[..]), n, "", kw_worst(states[0..<n]), open);
  }
  if open {
    groups := cq_groups(calls[0..<n], starts[..]);
    for gi: 0..<groups {
      from := starts[gi]; to := ifx gi + 1 < groups then starts[gi + 1] else n;
      if to - from == 1 {
        cq_row(t, u, tr_join(idd[..], tr_cat(idc[..], id, ".c."), from), calls[from], opens);
        continue;
      }
      gid := tr_join(idd[..], tr_cat(idc[..], id, ".g."), from);
      gopen := cq_open(opens, gid);
      mb: [CQ_LABEL] u8; lb: [CQ_LABEL + CQ_ARG] u8;
      newest := calls[to - 1];
      g := k_work_group_begin(t, u, gid, cq_icon(newest), cq_many(newest, mb[..]), to - from, cq_label(newest, lb[..]), kw_worst(states[from..<to]), gopen);
      if gopen {
        for i: from..<to { rid: [UI_ID] u8; rb: [UI_ID] u8; cq_row(t, u, tr_join(rid[..], tr_cat(rb[..], id, ".c."), i), calls[i], opens); }
      }
      k_work_group_end(t, gopen);
    }
  }
  if !live { k_work_group_end(t, open); }
  tr_close(t);
}
// The call a row's id names ("m.7.c.3", with what follows it: ".all", ".copy"): its number in the run, or -1.
cq_call_of :: (id: string, run: string) -> int {
  if id.count < run.count + 4 || cast(string) id[0..<run.count] != run || cast(string) id[run.count..<run.count + 3] != ".c." { return -1; }
  v := 0; i := run.count + 3; digits := 0;
  while i < id.count && id[i] >= '0' && id[i] <= '9' && digits < 4 { v = v * 10 + cast(int) (id[i] - '0'); i += 1; digits += 1; }
  return ifx digits == 0 then -1 else v;
}

// What a press on a run's id does: 1 opens or closes it (a run's line "m.7.w", a group "m.7.g.3", a row
// "m.7.c.3", its Show all "m.7.c.3.all"), 2 copies what a call got back ("m.7.c.3.copy"), 0 it isn't one of a run's.
cq_press :: (id: string) -> int {
  if id.count < 5 || cast(string) id[0..<2] != "m." { return 0; }
  if cq_ends(id, ".copy") { return ifx cq_ends_call(cast(string) id[0..<id.count - 5]) then 2 else 0; }
  if cq_ends(id, ".all") { return ifx cq_ends_call(cast(string) id[0..<id.count - 4]) then 1 else 0; }
  if cq_ends(id, ".w") || cq_ends_call(id) { return 1; }
  e := id.count; while e > 0 && id[e - 1] >= '0' && id[e - 1] <= '9' { e -= 1; }
  return ifx e < id.count && e >= 3 && cast(string) id[e - 3..<e] == ".g." then 1 else 0;
}
cq_ends :: (id: string, tail: string) -> bool { return id.count > tail.count && cast(string) id[id.count - tail.count..<id.count] == tail; }
cq_ends_call :: (id: string) -> bool {
  e := id.count; while e > 0 && id[e - 1] >= '0' && id[e - 1] <= '9' { e -= 1; }
  return e < id.count && e >= 3 && cast(string) id[e - 3..<e] == ".c.";
}
// A record's most bytes: what one call can take.
CQ_RECORD :: CQ_ARG + CQ_LABEL + CQ_INPUT + CQ_OUTPUT + 120 + 80 + 24 + 3 * 24 + 10;
// The run in text with its answer into out: the call with this id (with none, the newest still running) gets what
// came back and how it stands, and how long it took when it started at a time before now (ms). Its length, or -1
// when no call takes it or the run doesn't fit.
cq_answer :: (text: string, out: [] u8, id: string, output: string, failed: bool, open: bool, now: int) -> int {
  calls: [CQ_MOST] CqCall; n := cq_calls(text, calls[..]); hit := -1;
  for k: 0..<n {
    i := n - 1 - k;
    if id.count > 0 && calls[i].id == id || id.count == 0 && calls[i].state == KW_RUN { hit = i; break; }
  }
  if hit < 0 { return -1; }
  calls[hit].output = output;
  calls[hit].state = ifx open then KW_RUN else cq_state(output, failed);
  if !open && calls[hit].t0 > 0 && now > calls[hit].t0 { calls[hit].ms = now - calls[hit].t0; }
  m := 0;
  for i: 0..<n { m = cq_write(out, m, calls[i]); if m < 0 { return -1; } }
  return m;
}
// The run in text, its turn over, into out: a call still running with an ID had no answer, one without is done
// (a step that gets none). Its length, or -1.
cq_close :: (text: string, out: [] u8) -> int {
  calls: [CQ_MOST] CqCall; n := cq_calls(text, calls[..]); m := 0;
  for i: 0..<n {
    if calls[i].state == KW_RUN { calls[i].state = ifx calls[i].id.count > 0 then KW_UNKNOWN else KW_DONE; }
    m = cq_write(out, m, calls[i]); if m < 0 { return -1; }
  }
  return m;
}

// ---------------------------------------------------------------- checks

CqTest :: struct { t: [1] Tree; u: [1] Ui; buf: [32768] u8; }

cq_test_plan :: (foe: int, when: string, act: string, out: [] u8) -> string {
  num: [24] u8; n := kw_put(out, 0, "{\"slug\":\"splice\",\"foe\":"); n = kw_put(out, n, tr_join(num[..], "", foe));
  n = kw_put(out, n, ",\"daytime\":\""); n = kw_put(out, n, when); n = kw_put(out, n, "\",\"act\":\""); n = kw_put(out, n, act); n = kw_put(out, n, "\"}");
  return cast(string) out[0..<n];
}

cq_test_wrap :: (r: string, out: [] u8) -> string { n := kw_put(out, 0, "{\"ok\":true,\"result\":"); n = kw_put(out, n, r); n = kw_put(out, n, ",\"state\":\"x\"}"); return cast(string) out[0..<n]; }

#test "a call is a record and reads back the same; separators in its text are dropped and long text is cut" {
  b: [4096] u8; c: [1] CqCall;
  a := CqCall.{state = KW_RUN, t0 = 1234, ms = -1, kind = "mcp", name = "mcp__openagents__realm_world_plan", id = "toolu_1", arg = "", label = "", input = "{\"slug\":\"splice\"}", output = ""};
  n := cq_write(b[..], 0, a);
  sep: [7] u8; for ch, i: "ls! -la" { sep[i] = ifx ch == '!' then cast(u8) CQ_FS else ch; }
  m := cq_write(b[..], n, CqCall.{state = KW_DONE, ms = 2400, kind = "exec", name = "Bash", arg = cast(string) sep[..], output = "a\nb"});
  #assert n > 0 && m > n && b[n - 1] == CQ_RS && b[m - 1] == CQ_RS;
  text := cast(string) b[0..<m];
  next := cq_read(text, 0, c[..]);
  #assert next == n && c[0].state == KW_RUN && c[0].t0 == 1234 && c[0].ms == -1 && c[0].kind == "mcp" && c[0].name == a.name && c[0].id == "toolu_1" && c[0].input == a.input && c[0].output == "";
  #assert cq_read(text, next, c[..]) == m && c[0].state == KW_DONE && c[0].ms == 2400 && c[0].arg == "ls -la" && c[0].output == "a\nb" && cq_read(text, m, c[..]) == -1;
  calls: [4] CqCall;
  #assert cq_calls(text, calls[..]) == 2 && cq_calls(text, calls[0..<1]) == 1 && cq_calls("", calls[..]) == 0 && cq_calls(cast(string) sep[2..<4], calls[..]) == 0;
  #assert cq_at(text, 0) == 0 && cq_at(text, 1) == n && cq_at(text, 2) == -1;
  long: [CQ_OUTPUT + 100] u8; for i: 0..<long.count { long[i] = 'x'; }
  k := cq_write(b[..], 0, CqCall.{output = cast(string) long[..]});
  #assert cq_read(cast(string) b[0..<k], 0, c[..]) == k && c[0].output.count == CQ_OUTPUT && cq_write(b[0..<20], 0, a) == -1;
  #assert cq_int("-12") == -12 && cq_int("7") == 7 && cq_int("x") == 0 && cq_int("") == 0;
}
#test "our realm tools are named from the command table with their own arguments; a [part] goes when its value is missing" {
  b: [256] u8; p: [256] u8;
  c := CqCall.{kind = "mcp", name = "mcp__openagents__realm_world_plan", input = cq_test_plan(3, "night", "patrol", p[..])};
  #assert cq_realm(c.name) >= 0 && cq_label(c, b[..]) == "Set foe 3's night plan: patrol" && cq_many(c, b[..]) == "Set foe plans" && cq_icon(c) == IC_EDIT_PENCIL && cq_arg(c, b[..]) == "splice";
  #assert cq_tail("mcp__openagents__realm_world_plan") == "realm_world_plan" && cq_server("mcp__openagents__realm_world_plan") == "openagents" && cq_tail("Bash") == "Bash" && cq_server("Bash") == "";
  w := CqCall.{name = "realm_world", input = "{\"slug\":\"splice\"}"};
  #assert cq_label(w, b[..]) == "Read the world splice" && cq_icon(w) == IC_EYE && cq_realm("mcp__coder__realm_worlds") < 0;
  #assert cq_fill("Walk[ to {target}]", "{\"slug\":\"g\"}", b[..]) == "Walk" && cq_fill("Walk[ to {target}]", "{\"target\":\"Bram\"}", b[..]) == "Walk to Bram";
  #assert cq_fill("Move thing {id} to {x}, {z}", "{\"id\":4,\"x\":-120,\"z\":30}", b[..]) == "Move thing 4 to -120, 30" && cq_fill("Remove thing {id}", "", b[..]) == "Remove thing ?";
  #assert cq_fill("Say \"{words}\"", "{\"words\":\"hi \\\"there\\\"\"}", b[..]) == "Say \"hi \"there\"\"" && cq_fill("{a}", "{\"a\":true}", b[..]) == "true" && cq_fill("{a}", "{\"a\":{}}", b[..]) == "?";
  #assert cq_prop("{\"a\":null}", "a", b[..]) == "" && cq_prop("not json", "a", b[..]) == "" && cq_prop("{\"a\":\"x\"}", "a", b[0..<0]) == "";
  pub := CqCall.{name = "mcp__openagents__realm_world_publish", input = "{\"slug\":\"splice\",\"when\":\"now\"}"};
  #assert cq_label(pub, b[..]) == "Publish splice now" && cq_icon(pub) == IC_GLOBE && cq_icon(CqCall.{name = "realm_detach"}) == IC_TRASH;
}
#test "a realm tool called through realm_call reads as the tool itself, and realm_find as a lookup (#13439)" {
  b: [256] u8;
  c := CqCall.{kind = "mcp", name = "mcp__openagents__realm_call", input = "{\"name\":\"realm_world_publish\",\"arguments\":{\"slug\":\"splice\",\"when\":\"now\"}}"};
  #assert cq_label(c, b[..]) == "Publish splice now" && cq_icon(c) == IC_GLOBE && cq_arg(c, b[..]) == "splice" && cq_many(c, b[..]) == cq_many(CqCall.{name = "realm_world_publish"}, b[..]);
  // a name that is no row, or an input that can't be read, stays a call of realm_call
  u := CqCall.{kind = "mcp", name = "mcp__openagents__realm_call", input = "{\"name\":\"realm_nope\",\"arguments\":{}}"};
  #assert cq_realm(cq_inner(u).name) < 0 && cq_inner(CqCall.{name = "realm_call", input = "not json"}).name == "realm_call" && cq_inner(CqCall.{name = "realm_call", input = "{\"name\":7}"}).name == "realm_call";
  #assert cq_inner(CqCall.{name = "realm_call", input = "{\"name\":\"realm_list\"}"}).input == "" && cq_label(CqCall.{name = "realm_call", input = "{\"name\":\"realm_list\"}"}, b[..]) == cq_label(CqCall.{name = "realm_list"}, b[..]);
  f := CqCall.{kind = "mcp", name = "mcp__openagents__realm_find", input = "{\"area\":\"files\"}"};
  #assert cq_label(f, b[..]) == "Look up tools" && cq_many(f, b[..]) == "Look up tools" && cq_icon(f) == IC_SEARCH;
}
#test "an engine's tools by their kind or exact name; one we don't know by its cleaned name and first short argument" {
  b: [256] u8;
  bash := CqCall.{kind = "exec", name = "Bash", arg = "ls -la"};
  #assert cq_label(bash, b[..]) == "Run a command" && cq_many(bash, b[..]) == "Run commands" && cq_icon(bash) == IC_TERMINAL && cq_arg(bash, b[..]) == "ls -la";
  read := CqCall.{name = "Read", arg = "docs/chat.md"};
  #assert cq_kind(read) == 2 && cq_label(read, b[..]) == "Read a file" && cq_icon(read) == IC_EYE;
  ts := CqCall.{kind = "tool", name = "ToolSearch", input = "{\"query\":\"select:realm_world\"}"};
  #assert cq_label(ts, b[..]) == "Look up tools" && cq_many(ts, b[..]) == "Look up tools" && cq_arg(ts, b[..]) == "select:realm_world";
  repo := CqCall.{name = "search", arg = "wc_ask"};
  #assert cq_label(repo, b[..]) == "Search the code" && cq_icon(repo) == IC_SEARCH;
  other := CqCall.{kind = "mcp", name = "mcp__github__create_issue", input = "{\"n\":3,\"title\":\"Fix it\",\"body\":\"long\"}"};
  #assert cq_label(other, b[..]) == "Github: create issue" && cq_many(other, b[..]) == "Github: create issue" && cq_icon(other) == IC_TOOLS && cq_arg(other, b[..]) == "Fix it";
  #assert cq_label(CqCall.{kind = "tool", name = "do_thing"}, b[..]) == "Do thing" && cq_label(CqCall.{}, b[..]) == "Tool" && cq_arg(CqCall.{input = "[1]"}, b[..]) == "";
  step := CqCall.{name = "realm_world_place", label = "Place Cargo crate at 420, -75"};
  #assert cq_label(step, b[..]) == "Place Cargo crate at 420, -75" && cq_many(step, b[..]) == "Place things" && cq_many(CqCall.{label = "Undo"}, b[..]) == "Undo";
  #assert cq_clean("do_thing-now", b[..]) == "Do thing now" && cq_clean("x", b[0..<0]) == "";
}
#test "a realm tool's answer says how it stands: saved, a dry run with its level, refused with why, waiting, unknown" {
  b: [400] u8; fx := OR_FIXTURE; rep: [2048] u8;
  #assert cq_state(cq_test_wrap(fx[OR_DONE], rep[..]), false) == KW_DONE && cq_state(cq_test_wrap(fx[OR_DRY_RUN], rep[..]), false) == KW_DRY && cq_state(cq_test_wrap(fx[OR_RUNNING], rep[..]), false) == KW_RUN;
  #assert cq_state(cq_test_wrap(fx[OR_REFUSED], rep[..]), true) == KW_REFUSED && cq_state(cq_test_wrap(fx[OR_NEEDS_APPROVAL], rep[..]), true) == KW_ASK && cq_state(cq_test_wrap(fx[OR_UNKNOWN], rep[..]), true) == KW_UNKNOWN;
  #assert cq_state("error: no such realm", true) == KW_FAILED && cq_state("ok", false) == KW_DONE && cq_state("{\"result\":{}}", false) == KW_DONE;
  c := CqCall.{state = KW_REFUSED, output = cq_test_wrap(fx[OR_REFUSED], rep[..])};
  #assert cq_why(c, b[..]) == "in the kept-clear zone 'Scanner gate'. Trying again won't help.";
  c.state = KW_DRY; c.output = cq_test_wrap(fx[OR_DRY_RUN], rep[..]); #assert cq_why(c, b[..]) == "Nothing was saved: carried out whole in a throwaway copy of the world.";
  c.state = KW_ASK; c.output = cq_test_wrap(fx[OR_NEEDS_APPROVAL], rep[..]); #assert cq_why(c, b[..]) == "Nothing was done. It runs once it is approved.";
  c.state = KW_UNKNOWN; c.output = cq_test_wrap(fx[OR_UNKNOWN], rep[..]); #assert cq_why(c, b[..]) == "no answer came. It may have been saved: read the world before trying again.";
  #assert cq_why(CqCall.{state = KW_FAILED, output = "permission denied\nmore"}, b[..]) == "permission denied" && cq_why(CqCall.{state = KW_FAILED}, b[..]) == "It failed and said nothing.";
  #assert cq_why(CqCall.{state = KW_UNKNOWN}, b[..]) == "No answer came before the turn ended." && cq_why(CqCall.{state = KW_DONE, output = "x"}, b[..]) == "";
}
#test "twelve plans in a row are one group with a count; a finished run is one line that opens onto its groups" {
  h: [1] CqTest; t := h[0].t[..]; u := h[0].u[..]; out := h[0].buf[..]; p: [256] u8;
  n := cq_write(out, 0, CqCall.{state = KW_DONE, kind = "tool", name = "ToolSearch", input = "{\"query\":\"realm\"}"});
  n = cq_write(out, n, CqCall.{state = KW_DONE, kind = "mcp", name = "mcp__openagents__realm_world", input = "{\"slug\":\"splice\"}"});
  n = cq_write(out, n, CqCall.{state = KW_DONE, kind = "mcp", name = "mcp__openagents__realm_world_foes", input = "{\"slug\":\"splice\"}"});
  whens := [4] string.["dawn", "day", "dusk", "night"];
  for k: 0..<12 { n = cq_write(out, n, CqCall.{state = ifx k == 11 then KW_RUN else KW_DONE, kind = "mcp", name = "mcp__openagents__realm_world_plan", input = cq_test_plan(k / 4 + 1, whens[k % 4], "patrol", p[..])}); }
  text := cast(string) out[0..<n];
  calls: [CQ_MOST] CqCall; starts: [CQ_GROUPS] int; sb: [400] u8; lb: [200] u8;
  m := cq_calls(text, calls[..]);
  #assert m == 15 && cq_groups(calls[0..<m], starts[..]) == 4 && starts[3] == 3;
  #assert cq_top(calls[0..<m]) == 3 && cq_top(calls[0..<3]) == 0 && cq_top(calls[0..<0]) == 0;
  #assert cq_summary(calls[0..<m], sb[..]) == "Set foe plans ×12, Look up tools, and 2 more tools" && cq_now(text, lb[..]) == "Set foe 3's night plan: patrol";
  opens: [CQ_OPENS] int; no := 0;
  ui_begin(u, 0, true); tr_begin(t);
  cq_draw(t, u, "m.4", text, true, opens[0..<no], 0);
  // live: the groups, the plans one row with their count and the newest plan's words, turning
  #assert tr_find(t, "m.4.w") < 0 && tr_text_of(t, tr_find(t, "m.4.c.0.l")) == "Look up tools" && tr_text_of(t, tr_find(t, "m.4.c.1.l")) == "Read the world splice";
  #assert tr_text_of(t, tr_find(t, "m.4.g.3.l")) == "Set foe plans" && tr_text_of(t, tr_find(t, "m.4.g.3.n")) == "12" && tr_text_of(t, tr_find(t, "m.4.g.3.a")) == "Set foe 3's night plan: patrol";
  #assert tr_find(t, "m.4.g.3.g") > 0 && tr_find(t, "m.4.c.3.row") < 0 && t[0].depth == 0;
  no = cq_toggle(opens[..], no, "m.4.g.3");
  tr_begin(t);
  cq_draw(t, u, "m.4", text, true, opens[0..<no], 0);
  #assert tr_text_of(t, tr_find(t, "m.4.c.3.l")) == "Set foe 1's dawn plan: patrol" && tr_text_of(t, tr_find(t, "m.4.c.14.l")) == "Set foe 3's night plan: patrol" && tr_find(t, "m.4.c.14.g") > 0;
  // done: one line, closed, that names what was done most and how many calls
  tr_begin(t);
  cq_draw(t, u, "m.4", text, false, opens[0..<no], 0);
  #assert tr_text_of(t, tr_find(t, "m.4.w.l")) == "Set foe plans ×12, Look up tools, and 2 more tools" && tr_text_of(t, tr_find(t, "m.4.w.n")) == "15" && tr_find(t, "m.4.g.3") < 0 && tr_find(t, "m.4.c.0") < 0;
  no = cq_toggle(opens[..], no, "m.4.w");
  tr_begin(t);
  cq_draw(t, u, "m.4", text, false, opens[0..<no], 0);
  #assert tr_find(t, "m.4.g.3") > 0 && tr_find(t, "m.4.c.0") > 0 && t[0].depth == 0 && t[0].lost == 0;
  #assert cq_call_of("m.4.c.14.copy", "m.4") == 14 && cq_call_of("m.4.c.3", "m.4") == 3 && cq_call_of("m.4.g.3", "m.4") == -1 && cq_call_of("m.4.c.", "m.4") == -1 && cq_call_of("m.44.c.1", "m.4") == -1;
}
#test "an answer finds its call by ID, or the newest still running; how it stands follows what came back; a run ends" {
  a: [8192] u8; b: [8192] u8; calls: [4] CqCall; fx := OR_FIXTURE; rep: [2048] u8;
  n := cq_write(a[..], 0, CqCall.{state = KW_RUN, t0 = 1000, name = "mcp__openagents__realm_world_place", id = "t1"});
  n = cq_write(a[..], n, CqCall.{state = KW_RUN, t0 = 1500, name = "Bash", id = "t2"});
  m := cq_answer(cast(string) a[0..<n], b[..], "t1", cq_test_wrap(fx[OR_REFUSED], rep[..]), true, false, 4000);
  #assert m > 0 && cq_calls(cast(string) b[0..<m], calls[..]) == 2 && calls[0].state == KW_REFUSED && calls[0].ms == 3000 && calls[1].state == KW_RUN && calls[1].ms == -1;
  m2 := cq_answer(cast(string) b[0..<m], a[..], "", "partial", false, true, 4000);
  #assert m2 > 0 && cq_calls(cast(string) a[0..<m2], calls[..]) == 2 && calls[1].state == KW_RUN && calls[1].output == "partial";
  #assert cq_answer(cast(string) a[0..<m2], b[..], "t9", "x", false, false, 0) == -1 && cq_answer(cast(string) a[0..<m2], b[0..<10], "t2", "x", false, false, 0) == -1;
  k := cq_close(cast(string) a[0..<m2], b[..]);
  #assert k > 0 && cq_calls(cast(string) b[0..<k], calls[..]) == 2 && calls[0].state == KW_REFUSED && calls[1].state == KW_UNKNOWN && cq_close(cast(string) a[0..<m2], b[0..<10]) == -1;
  n = cq_write(a[..], 0, CqCall.{state = KW_RUN, label = "Thought"});
  k = cq_close(cast(string) a[0..<n], b[..]);
  #assert cq_calls(cast(string) b[0..<k], calls[..]) == 1 && calls[0].state == KW_DONE && CQ_RECORD > CQ_OUTPUT;
}
#test "a press on a run's line, a group, a row or its Show all opens or closes it; on its Copy it copies" {
  #assert cq_press("m.7.w") == 1 && cq_press("m.7.g.3") == 1 && cq_press("m.7.c.12") == 1 && cq_press("m.7.c.3.all") == 1 && cq_press("m.7.calls.c.3.all") == 1;
  #assert cq_press("m.7.c.3.copy") == 2 && cq_press("m.7.copy") == 0 && cq_press("m.7.md.b.2.copy") == 0 && cq_press("s.12") == 0 && cq_press("m.7.c.") == 0 && cq_press("m.7.acts") == 0 && cq_press("m.7.x.all") == 0;
}
#test "a page keeps which rows are open, forgetting the oldest when full" {
  o: [3] int; n := 0;
  n = cq_toggle(o[..], n, "a"); n = cq_toggle(o[..], n, "b");
  #assert n == 2 && cq_open(o[0..<n], "a") && cq_open(o[0..<n], "b") && !cq_open(o[0..<n], "c");
  n = cq_toggle(o[..], n, "a"); #assert n == 1 && !cq_open(o[0..<n], "a") && cq_open(o[0..<n], "b");
  n = cq_toggle(o[..], n, "c"); n = cq_toggle(o[..], n, "d"); n = cq_toggle(o[..], n, "e");
  #assert n == 3 && !cq_open(o[0..<n], "b") && cq_open(o[0..<n], "c") && cq_open(o[0..<n], "e") && cq_toggle(o[0..<0], 0, "x") == 0;
}
