// openagents.com/chat, rebuilt from nothing (docs/audits/2026-11-11-chat-zero-base-audit.md).
// The page is the composer at the foot of the window, a real text field and
// Send, under a transcript. Enter or Send puts your message in the
// transcript and asks the model: the answer comes in under it as it is
// written, as Markdown. While it comes, Send is Stop. Under a finished
// answer, Copy copies it. The page before this one is /chat-gpu (chat.coax).
//
// Who answers is the model chosen in the menu at the composer's foot:
// - Gemini (3.8 Flash, 4 Argon, 4 Carbon): one model call with the
//   conversation so far, streamed, through OpenAgents' own inference route
//   (coax/web/api/inference.c: Vertex, its caps and its metering) by /chat's
//   door to it, POST /api/chat/complete. No tools, no memory.
// - Claude (Haiku, Sonnet, Opus 5.5), offered once a Claude account is
//   connected: a turn of /chat's hosted agent (POST /api/chat/send, then GET
//   /api/chat/turn?t=ID each second), which runs the Claude CLI through the
//   Coax Claude Agent SDK (coax/web/agent/chat.coax) on the person's own
//   credential. It reads the public openagents repository and the web, and
//   its tools show while it works. Its answer comes whole when the turn ends,
//   and it remembers its own turns of this visit, not Gemini's.
// - Microcoder on Gemini 3.8 Flash (offered once the repo service is live,
//   CW_REPO_LIVE): a turn of the same hosted agent with no account needed, run by Microcoder's loop with the repo tool host
//   (coax/web/agent/chat-micro.coax): it reads the public openagents
//   repository at one commit through the repo service (oa-repo), with no
//   checkout, and its commands show while it works.
// The gear opens Settings at Agents and models (/settings/models, chat-settings.coax, docs/app-shell.md):
// connected accounts, where an Anthropic API key or a Claude subscription token is pasted,
// checked and sealed by the runner (POST /api/chat/key), and never shown again.
// Requests and streams are built and read by the gateway's codecs
// (coax/lib/gateway/chat.coax, sse.coax) and the JSON reader, not by hand.
// Episode 289's agent (front, members, knowledge) is not behind this yet:
// docs/audits/2026-11-10-episode-289-port-audit.md.
//
// Nothing is kept: the transcript is gone when the page is left.
//
// Limits, all shown when met: a message is CW_DRAFT bytes at most; an answer
// CW_ANSWER (past it the page says the rest was not kept); the transcript
// keeps CW_MESSAGES messages in CW_POOL bytes (when it is full the oldest
// quarter goes) and shows as many of the newest as fit CW_SHOWN bytes, with
// a line saying how many are not shown; the model is sent as much of the
// newest conversation as fits CW_ASK bytes.
//
// The browser draws it: the frames set (components/kit/frames.coax) in the
// mono skin, through the browser backend (components/backend/dom.coax) and
// coax/web/dom-host.js. This is its module for coax/web/wasm.sh, with
// chat-web-face.c.
//   coax/bin/coax test apps/openagents-web/chat-web.coax

#load "../../components/kit/frames.coax";
#load "chat-tools.coax";                     // tool calls: what each is called, how it stands, a run drawn (#13481)
#load "site-side.coax";                      // the side's rules: places, who is logged in, search, sections
#load "settings-web.coax";                   // Settings in the shell: its sections, its search, Account, Limits, About
#load "chat-settings.coax";                  // and the sections that are this module's state: Agents and models, Appearance
#load "../../components/backend/dom.coax";
#load "../../coax/lib/gateway/types.coax";   // the request and the stream's events
#load "../../coax/lib/gateway/chat.coax";    // Chat Completions: the request's body, a chunk
#load "../../coax/lib/gateway/sse.coax";     // server-sent events
#load "../../coax/lib/agent/world/turn.coax"; // the world the editor has open, a hosted turn's plan for it, a world's card

CW_INBOX :: 16384;     // a field's text, or a piece of the answer's stream, from the host
CW_DRAFT :: 16384;     // a message's most, in bytes: what is typed past it is not taken
CW_ANSWER :: 49152;    // an answer's most, in bytes
CW_CSS :: 32768;
CW_MESSAGES :: 128;    // messages kept
CW_POOL :: 524288;     // bytes of their text kept
CW_SHOWN :: 98304;     // bytes of text the page shows at once (the tree holds 131072)
CW_ASK :: 40960;       // bytes of the conversation sent with a message
CW_REQUEST :: 61440;   // the request's JSON (the door takes 64 KB)
CW_EVENT :: 32768;     // one event of the stream
CW_ERROR :: 320;
CW_RESP :: 262144;     // an answer that isn't a stream (a turn, the account, a piece of a session's log)
CW_SESS :: 50;         // Coder sessions listed beside the chat
CW_TOOL_LINE :: 160;   // a step's own words, at most
CW_TOOL_MOST :: 65536; // one run of tool calls, at most (a record each: chat-tools.coax)
CW_KEY :: 400;         // a pasted key's most
CW_TOOLS :: 32768;     // the running turn's tools, as records (chat-tools.coax)
CW_META :: 64;         // the line under an answer
CW_YOU :: 0; CW_AGENT :: 1; CW_TOOL :: 2; CW_CARD :: 3;   // a message is the person's, an answer, a run of tool calls (a record each, chat-tools.coax), or a world's card (world.card.v1)
CW_CHAT :: 0;
// The models, Gemini's first: a Claude one is offered only while a Claude account is connected.
// The models: Google's, Claude's on the connected account (the hosted agent), and the agents on this
// machine through Coder (`coder mcp --http`, coder/tui/mcp_http.coax), offered only where Coder answers.
CW_MODELS :: 11; CW_GEMINIS :: 3; CW_GEMINI_AGENT :: 6; CW_HOSTED :: 7;
// Microcoder on Gemini reads the code through the repo service (oa-repo, #13326); it is offered once that is live.
CW_REPO_LIVE :: false;
CW_MODEL_IDS :: [11] string.["google/gemini-3.8-flash", "google/gemini-4-argon", "google/gemini-4-carbon", "claude-haiku-5-5", "claude-sonnet-5-5", "claude-opus-5-5",
  "google/gemini-3.8-flash",
  "claude", "codex", "antigravity", "micro"];
CW_MODEL_NAMES :: [11] string.["Gemini 3.8 Flash", "Gemini 4 Argon", "Gemini 4 Carbon", "Claude Haiku 5.5", "Claude Sonnet 5.5", "Claude Opus 5.5",
  "Microcoder on Gemini 3.8 Flash",
  "Claude Code", "Codex", "Antigravity", "Microcoder"];
CW_MODEL_NOTES :: [11] string.["Google. Answers from what it knows", "Google. Answers from what it knows", "Google. Answers from what it knows",
  "Anthropic, on your account. Reads our code and the web", "Anthropic, on your account. Reads our code and the web", "Anthropic, on your account. Reads our code and the web",
  "Our own agent on Google's model. Reads our code",
  "On this computer, through Coder. Your login, your files, a shell", "On this computer, through Coder. Your login, your files, a shell",
  "On this computer, through Coder. Google's agent, your files, a shell", "On this computer, through Coder. Our own agent, your files, a shell"];
// The agents: OpenAgents (a model answers, on the web), and the four on this machine through Coder.
// Each has its own short list of models; "" is the agent's own default.
CW_AGENTS :: 5;
CW_AGENT_NAMES :: [5] string.["OpenAgents", "Claude Code", "Codex", "Antigravity", "Microcoder"];
CW_LM :: 5;   // a local agent's models, at most
CW_LM_N :: [4] int.[4, 1, 3, 3];
// The model each local agent starts on until this browser picks another (#13465, #13466): Claude Code on Haiku 5.5,
// the quick, cheap one for a turn in the editor; the pick is kept in this browser (cw_keep, "lmA=K").
CW_LM_DEFAULT :: [4] int.[3, 0, 0, 0];
// Each named for what it is: an agent's own "default" was whatever its config file on this machine said.
CW_LM_NAMES :: [20] string.["Opus 5.5", "Fable 5.2", "Sonnet 5.5", "Haiku 5.5", "",   "GPT 6.1 Sol", "", "", "", "",
  "Gemini 3.8 Flash", "Gemini 4 Argon", "Gemini 4 Carbon", "", "",   "Gemini 3.8 Flash", "Gemini 4 Argon", "Gemini 4 Carbon", "", ""];
CW_LM_IDS :: [20] string.["claude-opus-5-5", "claude-fable-5-2", "claude-sonnet-5-5", "claude-haiku-5-5", "",   "gpt-6.1-sol", "", "", "", "",
  "gemini-3.8-flash", "gemini-4-argon", "gemini-4-carbon", "", "",   "gemini-3.8-flash", "gemini-4-argon", "gemini-4-carbon", "", ""];
CF_NONE :: 0; CF_ACCOUNT :: 1; CF_KEY :: 2; CF_UNKEY :: 3; CF_COMPLETE :: 4; CF_SEND :: 5; CF_TURN :: 6; CF_STOP :: 7;
CF_LIST :: 8; CF_LOG :: 9; CF_RUN :: 10; CF_LSEND :: 11; CF_LSTOP :: 12; CF_CLAUDE :: 13; CF_IMPORT :: 14;
CF_PLAN :: 15;          // a hosted turn in the editor: the model's typed answer, talk or a plan of world tools (turn.coax wp_schema)
CF_CARD :: 16;          // a world's card, read from the world's own route
CF_AGENTS :: 17;        // which agents on this machine are ready (Coder's /agents, #13465)
CF_WHO :: 18;           // who is logged in, for the side's foot (/api/auth/account?as=lines)
CF_OUT :: 19;           // Log out, from the side's foot
CF_WORLDS :: 20;        // the worlds the person may edit, under Worlds in the side (/api/worlds)
CF_LIMITS :: 21;        // Settings, Limits: every login limit (/api/auth/limits?as=lines)
CF_ABOUT :: 22;         // Settings, About: the release this page is from (/build/about.txt)
CW_PLAN_ASK :: 24576;   // bytes of the conversation sent with a turn in the editor (the world goes with it)
// A world step's realm tool (turn.coax WT_TOOL; a size is a set), for its icon and how a run of them is named.
CW_STEP_TOOLS :: [7] string.["realm_world_place", "realm_world_move", "realm_world_turn", "realm_world_set", "realm_world_remove", "realm_world_undo", "realm_world_redo"];
CW_CL :: 8;            // Claude Code conversations listed beside the chat
CW_CL_EVERY :: 5.0;    // seconds between reads of them
CW_LOCAL_WAIT :: 12.0; // seconds a request to Coder on this machine may go unanswered before it is given up, so one that hangs can't stop the page
CW_CL_LIVE :: 3.0;     // seconds between fresh copies of the one shown, so turns made elsewhere (a terminal) appear   // Coder on this machine: its sessions, one's log, a new one, a message, Stop
CW_LIST_EVERY :: 3.0;  // seconds between reads of the sessions
CW_LOG_EVERY :: 1.0;   // and of the shown session's log while it runs
CW_LOG_WAIT :: 20;     // reads that may find no log before the session is called gone (one just started writes its log a moment later)
CA_NONE :: 0; CA_KEY :: 1; CA_TOKEN :: 2;   // the connected Claude credential's kind
CW_POLL :: 1.0;        // seconds between reads of a Claude turn
CW_SYSTEM :: "You are OpenAgents, answering in the chat on openagents.com. Speak as \"we\" for OpenAgents. Be direct and brief, and use Markdown where it helps. You can't use tools, read files or the web, or remember earlier conversations yet; say so plainly if asked to. You have no knowledge base about OpenAgents yet, so if you aren't sure of a fact about OpenAgents, say you aren't sure. If asked which model you are, say exactly this and never guess another version: the model answering is ";
// What the host sends (coax/web/dom-host.js): a press, a field's text, Enter in a field,
// a piece of the answer's stream (the inbox holds it), and the stream's end (the slot is its HTTP status, 0 for none).
CW_CLICK :: 1; CW_INPUT :: 2; CW_SUBMIT :: 3; CW_PIECE :: 4; CW_END :: 5;
// From the page this conversation sits in, when that is the editor (coax/web/host.js): the world it has open, as a
// world.turn.v1 in the inbox. Every turn after carries it.
CW_WORLD :: 8;
// What this browser kept for the page (dom-host.js dom_keep), as it starts: "local=off" when the agents on this
// machine were turned off here (Settings, This machine, #13465).
CW_KEPT :: 12;
// The address the page is at (dom-host.js), as it starts and after Back or Forward: "/" is the home page, the app
// shell with nothing beside its side; any other is the chat (docs/app-shell.md).
CW_PATH :: 13;
CW_PLANNED :: 8;       // an action for the page that opened this conversation: a world.plan.v1 for its editor

ChatWeb :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  draft: [CW_DRAFT] u8; draft_n: int;
  sends: int;                        // messages the person has sent
  total: int;                        // messages put in the transcript so far, theirs and the answers: the next one's number
  at: [CW_MESSAGES] int; len: [CW_MESSAGES] int; count: int;   // the kept messages, oldest first, in the pool
  who: [CW_MESSAGES] int;            // CW_YOU or CW_AGENT
  view: int;                         // CW_CHAT (Settings is a page of the shell's own: chat-settings.coax)
  menu: bool;                        // the model menu is open
  amenu: bool;                       // the agent menu is open
  hosted: int;                       // the model OpenAgents last had, for coming back to it
  lm: [4] int;                       // each local agent's chosen model + 1 (0: none chosen, CW_LM_DEFAULT)
  model: int;                        // the model the next message goes to
  known: bool;                       // the account has been read
  known_asked: bool;                 // and that it has been asked for, whatever came back
  claude: int; last4: [8] u8; last4_n: int; expired: bool;   // the connected Claude credential (CA_*), never the key
  key: [CW_KEY] u8; key_n: int;      // a key being typed in Settings, wiped once sent
  note: [CW_ERROR] u8; note_n: int;  // what Settings last said (a key that didn't work, Connected, Removed)
  flight: int;                       // the request in flight (CF_*)
  flight_at: f32;                    // when it went
  resp: [CW_RESP] u8; resp_n: int;   // its answer so far, when it isn't a stream
  conv: int; turn: int;              // the hosted agent's conversation and the turn running in it
  asked_at: f32;                     // when the turn was last read
  stopping: bool;                    // Stop was pressed on a Claude turn: it ends when the runner says so
  stop_sent: bool;                   // and the runner has been asked
  working: [CW_ERROR] u8; working_n: int;   // what the running turn says it is doing
  tools: [CW_TOOLS] u8; tools_n: int; ntools: int;   // its tools so far, a record each
  opens: [CQ_OPENS] int; opens_n: int;   // the tool calls, groups and runs opened (chat-tools.coax cq_toggle)
  wbuf: [CW_TOOL_MOST] u8;           // a run of tool calls as an answer changes it
  meta: [CW_MESSAGES] [CW_META] u8; meta_n: [CW_MESSAGES] int;   // the line under each answer: who wrote it
  local: int;                        // Coder on this machine: 0 not asked yet, 1 it answers, -1 it doesn't
  local_off: bool;                   // the agents on this machine are turned off in this browser (kept by the host)
  keep: [96] u8; keep_n: int;        // a setting for the host to keep in this browser, until it has
  agents_asked: bool;                // Coder was asked which of its agents are ready
  aready: [4] int;                   // each one: 0 not known (offered), 1 ready, -1 not (aword says why; not offered)
  aword: [4] [CW_META * 2] u8; aword_n: [4] int;
  ns: int; sid: [CW_SESS] [24] u8; sid_n: [CW_SESS] int;   // its sessions, newest first
  seng: [CW_SESS] [12] u8; seng_n: [CW_SESS] int; srun: [CW_SESS] bool;
  stask: [CW_SESS] [96] u8; stask_n: [CW_SESS] int;
  nc: int; cid: [CW_CL] [40] u8; cid_n: [CW_CL] int; ctitle: [CW_CL] [96] u8; ctitle_n: [CW_CL] int;   // this folder's Claude Code conversations, newest first
  copen: [CW_CL] int;               // whether a claude on this machine has it open: 0 no, 1 open and waiting, 2 busy
  cl_at: f32; cl_asked: bool;
  import_due: int;                   // a conversation chosen there (its place + 1): Coder is asked for it as a session
  csel: [40] u8; csel_n: int;        // the one shown
  watch_at: f32; watching: bool;     // it is copied again now and then; the log just asked for is such a fresh copy
  csize: int;                        // the copy's size when it was last read
  goal: [CW_GOAL] u8; goal_n: int;   // the shown session's goal (Claude Code's /goal), while one is set
  sel: [24] u8; sel_n: int;          // the session the transcript shows (none: a new chat)
  log_next: int;                     // where its log is read from next (under 0: its end)
  log_due: bool;                     // read it now
  lrun: bool;                        // it is running
  echo: bool;                        // the next message of the person's in the log is one this page already shows
  stop_due: bool;                    // Stop was pressed on it
  send_due: bool;                    // Send was pressed while a background read was out
  log_miss: int;                     // reads in a row that found no log
  list_at: f32; log_at: f32;
  scratch: [CW_RESP] u8;
  world: [1] WorldTurn;              // the world the editor round this conversation has open, as last told; none on /chat
  wwire: [WT_BYTES] u8; wwire_n: int;   // its bytes, as they go with a turn
  planned: [WP_BYTES] u8; planned_n: int;   // a hosted turn's plan, until the page has taken it to its editor
  opened: [WP_OPEN] [WT_FID] u8; nopened: int;   // the attachments a hosted turn asked to open (#13468): its second ask carries them
  pmodel: int;                       // the model a hosted turn in the editor went to
  card_due: [WT_WORLD] u8; card_due_n: int;   // a world an agent's tool named: its card is read when the page is free
  live: bool;                        // the last message is an answer still coming
  status: int;                       // the stream's HTTP status once a piece has come
  cut: bool;                         // the answer passed CW_ANSWER: the rest was not kept
  ps: [1] GwParse;                   // the stream's finish and usage so far
  event: [CW_EVENT] u8; event_n: int;   // the stream's bytes since the last whole event
  raw: [CW_ERROR] u8; raw_n: int;    // the start of an answer that isn't a stream (an error's body)
  error: [CW_ERROR] u8; error_n: int;   // why the last message got no answer, until the next one
  request: [CW_REQUEST] u8; request_n: int; ask: bool;   // a request for the host to send (the face sends it)
  stop: bool;                        // the host is to end the stream
  door: [96] u8; door_n: int;        // where the request goes, for the face
  clip: [CW_DRAFT] u8; clip_n: int;  // text for the host to copy, until it has
  copied: int; copied_at: f32;       // the answer last copied (its number + 1, 0 for none) and when
  page: int;                         // what the shell shows beside its side: SS_CHATS (the chat), SS_HOME (nothing) or SW_PAGE (Settings)
  set: [1] SettingsWeb;              // Settings: the section shown, its search, and what it has read
  side_closed: bool;                 // the side is put away (kept in this browser)
  me: [SS_WHO] u8; me_n: int; me_asked: bool;   // who is logged in, as the side's foot names them
  worlds: [SS_WORLDS_MAX] SsWorld; worlds_n: int; worlds_asked: bool;   // the worlds they may edit, under Worlds
  out_due: bool;                     // Log out was pressed: it goes when no other request is out
  go: [96] u8; go_n: int; go_push: bool;   // an address for the host: pushed (the shell stays) or gone to
  marking: bool;                     // Copy shows its check: build again when it gives way
  doc: [1] MdDoc;
  pool: [CW_POOL] u8; pool_n: int;
  inbox: [CW_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [CW_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

cw_put :: (out: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n < out.count { out[n] = c; n += 1; } }
  return n;
}
cw_say :: (s: [] ChatWeb, why: string) { s[0].error_n = cw_put(s[0].error[..], 0, why); }
// Claude Code's /goal: "/goal CONDITION" sets the session's goal, and Claude keeps taking turns until its
// own check finds the condition met; "/goal" alone asks for it; "/goal clear" (or stop, off, reset, none,
// cancel) removes it. The message goes to Claude Code as typed. The page only keeps the condition, to show.
CW_GOAL :: 400;
CW_GOAL_NONE :: -1; CW_GOAL_ASK :: 0; CW_GOAL_CLEAR :: 1; CW_GOAL_SET :: 2;
CW_GOAL_OFF :: [6] string.["clear", "stop", "off", "reset", "none", "cancel"];
cw_space :: (c: u8) -> bool { return c == ' ' || c == '\n' || c == '\t' || c == '\r'; }
// What follows "/goal", without the space around it.
cw_goal_rest :: (text: string) -> string {
  lo := 5; hi := text.count;
  if hi < lo { return ""; }
  while lo < hi && cw_space(text[lo]) { lo += 1; }
  while hi > lo && cw_space(text[hi - 1]) { hi -= 1; }
  return cast(string) text[lo..<hi];
}
cw_goal_of :: (text: string) -> int {
  if text.count < 5 || cast(string) text[0..<5] != "/goal" { return CW_GOAL_NONE; }
  if text.count > 5 && !cw_space(text[5]) { return CW_GOAL_NONE; }   // "/goals" is something else
  rest := cw_goal_rest(text);
  if rest.count == 0 { return CW_GOAL_ASK; }
  off := CW_GOAL_OFF;
  for i: 0..<6 { if rest == off[i] { return CW_GOAL_CLEAR; } }
  return CW_GOAL_SET;
}
cw_goal_note :: (s: [] ChatWeb, text: string) {
  k := cw_goal_of(text);
  if k == CW_GOAL_CLEAR { s[0].goal_n = 0; }
  else if k == CW_GOAL_SET { s[0].goal_n = cw_put(s[0].goal[..], 0, cw_goal_rest(text)); }
}
// Whether the message goes to Claude Code: a conversation of its, a Coder session it runs, or a new chat with it chosen.
cw_to_claude :: (s: [] ChatWeb) -> bool {
  if s[0].csel_n > 0 { return true; }
  if s[0].sel_n > 0 {
    for i: 0..<s[0].ns {
      if cast(string) s[0].sid[i][0..<s[0].sid_n[i]] == cw_sel(s) { return cast(string) s[0].seng[i][0..<s[0].seng_n[i]] == "claude"; }
    }
    return true;   // not listed (older than a day): Coder knows its engine
  }
  return cw_agent(s) == 1;
}
// Whether the draft has anything but spaces and line breaks.
cw_has_words :: (s: [] ChatWeb) -> bool {
  for i: 0..<s[0].draft_n { c := s[0].draft[i]; if c != ' ' && c != '\n' && c != '\t' && c != '\r' { return true; } }
  return false;
}
cw_text :: (s: [] ChatWeb, k: int) -> string { return cast(string) s[0].pool[s[0].at[k]..<s[0].at[k] + s[0].len[k]]; }

cw_claude_model :: (model: int) -> bool { return model >= CW_GEMINIS && model < CW_GEMINI_AGENT; }
cw_local_model :: (model: int) -> bool { return model >= CW_HOSTED; }
cw_connected :: (s: [] ChatWeb) -> bool { return s[0].claude != CA_NONE && !s[0].expired; }
// The model the next message goes to: the one chosen, unless it is Claude's and no account is connected.
cw_model :: (s: [] ChatWeb) -> int { return cw_usable(s, s[0].model); }
// A model as the next message could go to it: itself, or Gemini's first when it can't be had here now.
cw_usable :: (s: [] ChatWeb, m: int) -> int {
  if m < 0 || m >= CW_MODELS { return 0; }
  if cw_local_model(m) && (s[0].local != 1 || s[0].local_off || s[0].aready[m - CW_HOSTED] < 0) { return 0; }
  return ifx cw_claude_model(m) && !cw_connected(s) then 0 else m;
}
// The agent the next message goes to: 0 OpenAgents, else the local agent's place + 1.
cw_agent :: (s: [] ChatWeb) -> int { m := cw_model(s); return ifx cw_local_model(m) then m - CW_HOSTED + 1 else 0; }
// A local agent's chosen model, within its list.
cw_lm :: (s: [] ChatWeb, agent: int) -> int {
  counts := CW_LM_N; first := CW_LM_DEFAULT; k := s[0].lm[agent - 1] - 1;
  return ifx k < 0 || k >= counts[agent - 1] then first[agent - 1] else k;
}
cw_sel :: (s: [] ChatWeb) -> string { return cast(string) s[0].sel[0..<s[0].sel_n]; }
// A request for the host: a POST of the body, or a GET when there is none. False while another is in flight.
cw_go :: (s: [] ChatWeb, kind: int, url: string, body: string) -> bool {
  if s[0].flight != CF_NONE { return false; }
  s[0].door_n = cw_put(s[0].door[..], 0, url);
  s[0].request_n = cw_put(s[0].request[..], 0, body);
  s[0].flight = kind; s[0].ask = true; s[0].resp_n = 0; s[0].status = 0; s[0].flight_at = s[0].time;
  return true;
}
// The sessions beside the chat: a new chat, the Coder sessions running on this machine now (whoever
// started them: this page, the terminal, another agent), then the few that ended most recently.
CW_RECENT :: 8;
cw_side_row :: (s: [] ChatWeb, k: int) {
  t := s[0].tree[..]; u := s[0].ui[..];
  buf: [UI_ID] u8;
  title := cast(string) s[0].stask[k][0..<s[0].stask_n[k]];
  r := k_row_busy(t, u, tr_join(buf[..], "s.", k), ifx title.count > 0 then title else "(no message)", cast(string) s[0].seng[k][0..<s[0].seng_n[k]], cast(string) s[0].sid[k][0..<s[0].sid_n[k]] == cw_sel(s), s[0].srun[k]);
}
// A Claude Code conversation: busy ones turn; one open and waiting says so.
cw_claude_row :: (s: [] ChatWeb, k: int) {
  t := s[0].tree[..]; u := s[0].ui[..];
  buf: [UI_ID] u8;
  title := cast(string) s[0].ctitle[k][0..<s[0].ctitle_n[k]];
  shown := s[0].csel_n > 0 && cast(string) s[0].cid[k][0..<s[0].cid_n[k]] == cast(string) s[0].csel[0..<s[0].csel_n];
  r := k_row_busy(t, u, tr_join(buf[..], "c.", k), ifx title.count > 0 then title else "(untitled)", ifx s[0].copen[k] == 1 then "waiting" else "", shown, s[0].copen[k] == 2);
}
cw_side :: (s: [] ChatWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  if s[0].page == SS_FOOT { return; }   // in a page that draws the side itself
  if s[0].side_closed { o := k_side_open(t, "side.show", "Show the side"); return; }
  side := k_side(t, "side", "Places");
  hd := k_side_head(t, "side.h", "OpenAgents", "/");
  fresh := k_icon_button(t, "side.new", IC_CHAT_COMPOSE, "New chat");
  hide := k_icon_button(t, "side.hide", IC_MENU_SIDEBAR, "Hide the side");
  tr_close(t);
  pl := k_side_places(t, "side");
  names := SS_NAMES; hrefs := SS_HREFS; icons := [3] int.[IC_CHATS, IC_FOLDER, IC_GLOBE]; ids := [3] string.["place.chats", "place.projects", "place.worlds"];
  for k: 0..<SS_PLACES {
    p := k_place(t, u, ids[k], icons[k], names[k], hrefs[k], k == SS_CHATS && s[0].page == SS_CHATS);
    if k != SS_WORLDS { continue; }
    for w: 0..<s[0].worlds_n {   // each world they may edit, opening its editor
      wid := cast(string) s[0].worlds[w].id[0..<s[0].worlds[w].id_n];
      href: [80] u8; hn := ss_world_href(wid, href[..]);
      idb: [UI_ID] u8;
      r := k_sub_place(t, u, tr_cat(idb[..], "world.", wid), cast(string) s[0].worlds[w].name[0..<s[0].worlds[w].name_n], cast(string) href[0..<hn]);
    }
  }
  list := k_side_list(t, "side");
  if s[0].local == 1 && !s[0].local_off && s[0].ns + s[0].nc > 0 {
    // the sections, top to bottom, each with what the search keeps of it
    marks := [3] string.["side.run", "side.claude", "side.recent"]; labels := SS_SECTION_NAMES;
    for sec: 0..<SS_SECTIONS {
      n := 0;
      for k: 0..<s[0].ns { if cw_side_keeps(s, k, false, sec) { n += 1; } }
      for k: 0..<s[0].nc { if cw_side_keeps(s, k, true, sec) { n += 1; } }
      if n == 0 { continue; }
      h := k_side_mark(t, marks[sec], labels[sec], n);
      for k: 0..<s[0].ns { if cw_side_keeps(s, k, false, sec) { cw_side_row(s, k); } }
      for k: 0..<s[0].nc { if cw_side_keeps(s, k, true, sec) { cw_claude_row(s, k); } }
    }
  }
  k_side_end(t);
  w := k_who(t, u, "who", cast(string) s[0].me[0..<s[0].me_n], ifx s[0].me_n > 0 then "/settings" else "/login", true);
  tr_close(t);
}
// Whether the side lists a conversation in a section: Coder's session k, or Claude Code's conversation k (`claude`).
// Recent holds only the few that ended last, and not Coder's own test agent unless it is the one shown.
cw_side_keeps :: (s: [] ChatWeb, k: int, claude: bool, sec: int) -> bool {
  if claude {
    return ss_section(s[0].copen[k] > 0, true) == sec;
  }
  if ss_section(s[0].srun[k], false) != sec { return false; }
  if sec != SS_RECENT { return true; }
  shown := cast(string) s[0].sid[k][0..<s[0].sid_n[k]] == cw_sel(s);
  if cast(string) s[0].seng[k][0..<s[0].seng_n[k]] == "echo" && !shown { return false; }   // Coder's own test agent
  before := 0;   // the recent ones above it
  for j: 0..<k {
    if s[0].srun[j] { continue; }
    sj := cast(string) s[0].sid[j][0..<s[0].sid_n[j]] == cw_sel(s);
    if cast(string) s[0].seng[j][0..<s[0].seng_n[j]] == "echo" && !sj { continue; }
    before += 1;
  }
  return before < CW_RECENT;
}
// The address for the host: pushed, the shell stays and draws it; else the browser goes there.
cw_go_to :: (s: [] ChatWeb, url: string, push: bool) { s[0].go_n = cw_put(s[0].go[..], 0, url); s[0].go_push = push; }
// The shell shows the chat, at its own address.
cw_to_chat :: (s: [] ChatWeb) {
  if s[0].page == SS_SIDE { cw_go_to(s, "/chat", false); return; }   // the side alone, in another page: the chat is a page away
  s[0].page = SS_CHATS; cw_go_to(s, "/chat", true);
}
// What this browser keeps for the page: whether the agents on this machine are off, whether the side is put away,
// and each local agent's chosen model ("lm1=3": Claude Code's fourth).
cw_keep :: (s: [] ChatWeb) {
  n := cw_put(s[0].keep[..], 0, ifx s[0].local_off then "local=off" else "local=on");
  if s[0].side_closed { n = cw_put(s[0].keep[..], n, "&side=closed"); }
  for a: 0..<4 {
    if s[0].lm[a] > 0 { d := [1] u8.[cast(u8) ('0' + a + 1)]; e := [1] u8.[cast(u8) ('0' + s[0].lm[a] - 1)]; n = cw_put(s[0].keep[..], n, "&lm"); n = cw_put(s[0].keep[..], n, cast(string) d[..]); n = cw_put(s[0].keep[..], n, "="); n = cw_put(s[0].keep[..], n, cast(string) e[..]); }
  }
  // the model a new chat starts with (Settings, Agents and models): "m=K"
  if s[0].set[0].kept_model > 0 { num: [24] u8; n = cw_put(s[0].keep[..], n, "&m="); n = cw_put(s[0].keep[..], n, tr_join(num[..], "", s[0].set[0].kept_model - 1)); }
  s[0].keep_n = n;
}
// The model a new chat starts with, kept in this browser ("&m=K"): K + 1, or 0 when none was kept.
cw_kept_model :: (kept: string) -> int {
  i := 0;
  while i + 3 <= kept.count {
    if kept[i] == '&' && kept[i + 1] == 'm' && kept[i + 2] == '=' {
      n := 0; j := i + 3;
      while j < kept.count && j < i + 5 && kept[j] >= '0' && kept[j] <= '9' { n = n * 10 + cast(int) (kept[j] - '0'); j += 1; }
      return ifx j > i + 3 && n < CW_MODELS then n + 1 else 0;
    }
    i += 1;
  }
  return 0;
}
// A local agent's model kept in this browser ("lmA=K"): K + 1, or 0 when none was kept.
cw_kept_lm :: (kept: string, agent: int) -> int {
  i := 0;
  while i + 5 <= kept.count {
    if kept[i] == 'l' && kept[i + 1] == 'm' && kept[i + 2] == cast(u8) ('0' + agent) && kept[i + 3] == '=' && kept[i + 4] >= '0' && kept[i + 4] <= '9' { return cast(int) (kept[i + 4] - '0') + 1; }
    i += 1;
  }
  return 0;
}
cw_kept_has :: (kept: string, word: string) -> bool {
  i := 0;
  while i + word.count <= kept.count { if cast(string) kept[i..<i + word.count] == word { return true; } i += 1; }
  return false;
}
cw_transcript :: (s: [] ChatWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  scroller := tr_open(t, "log", TG_DIV, "log");
  th := tr_open(t, "thread", TG_DIV, "thread");
  // the newest that fit, oldest of them first
  first := s[0].count; shown := 0;
  while first > 0 && shown + s[0].len[first - 1] <= CW_SHOWN { first -= 1; shown += s[0].len[first]; }
  hidden := s[0].total - (s[0].count - first);
  buf: [UI_ID] u8; buf2: [UI_ID] u8;
  if hidden > 0 { m := k_meta(t, "earlier", tr_cat(buf2[..], tr_join(buf[..], "", hidden), ifx hidden == 1 then " earlier message is not shown" else " earlier messages are not shown")); }
  for k: first..<s[0].count {
    number := s[0].total - s[0].count + k;
    id := tr_join(buf[..], "m.", number);
    text := cw_text(s, k);
    if s[0].who[k] == CW_YOU { m := k_user(t, u, id, text); continue; }
    if s[0].who[k] == CW_CARD {
      card: [1] WorldCard; scratch: [WC_BYTES] u8; idg: [UI_ID] u8; idh: [UI_ID] u8; href: [WT_WORLD + 32] u8; facts: [64] u8; num: [24] u8;
      if !wc_read(card[..], text, scratch[..]) { continue; }
      c := k_card(t, u, id, cast(string) card[0].name[0..<card[0].name_n]);
      fn := cw_put(facts[..], 0, tr_join(num[..], "", card[0].things)); fn = cw_put(facts[..], fn, ifx card[0].things == 1 then " thing · revision " else " things · revision ");
      fn = cw_put(facts[..], fn, tr_join(num[..], "", card[0].rev));
      fm := k_meta(t, tr_cat(idg[..], id, ".facts"), cast(string) facts[0..<fn]);
      hn := cw_put(href[..], 0, "/worlds/"); hn = cw_put(href[..], hn, cast(string) card[0].world[0..<card[0].world_n]); hn = cw_put(href[..], hn, "?edit=agent");
      go := k_go(t, tr_cat(idh[..], id, ".open"), "Open the editor", cast(string) href[0..<hn]);
      tr_close(t);
      continue;
    }
    if s[0].who[k] == CW_TOOL {
      // a run of tool calls: its groups while the session is at it, one line once it is over
      cq_draw(t, u, id, text, s[0].lrun && k + 1 == s[0].count, s[0].opens[0..<s[0].opens_n], cw_ms(s));
      continue;
    }
    // an answer: what has come of it, as Markdown
    coming := s[0].live && k + 1 == s[0].count;
    if !coming && text.count == 0 { continue; }   // it got no answer: the notice below says why
    a := k_reply_open(t, id, coming, text.count == 0);
    ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
    if coming && text.count == 0 {
      // a Claude turn at work: what it says it is doing, and the tools it has used
      if s[0].working_n > 0 { w := tr_leaf(t, tr_cat(ida[..], id, ".work"), TG_P, "work", cast(string) s[0].working[0..<s[0].working_n]); }
      cq_draw(t, u, tr_cat(idb[..], id, ".calls"), cast(string) s[0].tools[0..<s[0].tools_n], true, s[0].opens[0..<s[0].opens_n], cw_ms(s));
    } else {
      body := k_agent_text(t, u, tr_cat(ida[..], id, ".md"), s[0].doc[..], text);
    }
    if !coming {
      acts := tr_open(t, tr_cat(idb[..], id, ".acts"), TG_DIV, "acts");
      done := s[0].copied == number + 1 && s[0].time - s[0].copied_at < MONO_COPIED;
      if done { s[0].marking = true; }
      c := k_icon_button(t, tr_cat(idc[..], id, ".copy"), ifx done then IC_CHECK else IC_COPY, ifx done then "Copied" else "Copy");
      if done { tr_attr(t, c, AT_STATE, "done"); }
      if s[0].meta_n[k] > 0 { mm := k_meta(t, tr_cat(idd[..], id, ".meta"), cast(string) s[0].meta[k][0..<s[0].meta_n[k]]); }
      tr_close(t);
    }
    tr_close(t);
  }
  if s[0].lrun {
    // what the session is doing: the call it is running, else its goal
    gb: [CW_GOAL + 32] u8; nb: [CQ_LABEL + CQ_ARG] u8;
    k := s[0].count - 1;
    now := ifx k >= 0 && s[0].who[k] == CW_TOOL then cq_now(cw_text(s, k), nb[..]) else "";
    w := k_work_now(t, "l.work", ifx now.count > 0 then now else ifx s[0].goal_n > 0 then tr_cat(gb[..], "Working toward the goal: ", cast(string) s[0].goal[0..<s[0].goal_n]) else "Working");
  }
  if s[0].error_n > 0 {
    n := k_notice(t, u, "failed", "Error", cast(string) s[0].error[0..<s[0].error_n]);
    tr_close(t);
  }
  tr_close(t);
  tr_close(t);
}
cw_build :: (s: [] ChatWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  tr_begin(t);
  s[0].marking = false;
  page := tr_open(t, "chat", TG_MAIN, ifx s[0].page == SS_HOME || s[0].page == SS_SIDE || s[0].page == SW_PAGE then "home" else "chat");
  cw_side(s);
  if s[0].page == SS_HOME || s[0].page == SS_SIDE { tr_close(t); return; }   // the home page, or the editor's left: the side, and nothing beside it
  if s[0].page == SW_PAGE { cw_settings_page(s); tr_close(t); return; }   // Settings, beside the side
  if s[0].count > 0 || s[0].lrun || s[0].error_n > 0 { cw_transcript(s); }   // an error shows in a new chat too
  if s[0].wwire_n > 0 && s[0].view == CW_CHAT {
    // in the editor: what "this" and "here" mean to the agent now
    w := s[0].world[..]; seen: [160] u8; num: [24] u8;
    at := wt_thing_at(w, w[0].sel);
    n := cw_put(seen[..], 0, "The agent sees this world");
    if at >= 0 {
      name := wt_kind_name(w, w[0].t_kind[at]);
      n = cw_put(seen[..], n, ", \"this\" is "); n = cw_put(seen[..], n, ifx name.count > 0 then name else "thing"); n = cw_put(seen[..], n, " "); n = cw_put(seen[..], n, tr_join(num[..], "", w[0].sel));
    }
    if w[0].here { n = cw_put(seen[..], n, ifx at >= 0 then " and \"here\" is the spot you tapped" else ", and \"here\" is the spot you tapped"); }
    n = cw_put(seen[..], n, ".");
    sm := k_meta(t, "world.seen", cast(string) seen[0..<n]);
  }
  f := k_composer_begin(t, u, "composer", "Ask anything");
  tr_attr(t, f, AT_FOCUS, "");
  gear := k_icon_button(t, "settings", IC_SETTINGS, "Settings");
  names := CW_MODEL_NAMES; agents := CW_AGENT_NAMES; lnames := CW_LM_NAMES; counts := CW_LM_N;
  agent := cw_agent(s);
  buf: [UI_ID] u8;
  // the agent, where there is more than one to choose: Coder on this machine adds its four
  if s[0].local == 1 && !s[0].local_off {
    k_select_begin(t, u, "agent", agents[agent], "Agent", s[0].amenu);
    // only the agents that can answer: one Coder says isn't ready here has no row
    if s[0].amenu { for a: 0..<CW_AGENTS { if a > 0 && s[0].aready[a - 1] < 0 { continue; } r := k_row(t, u, tr_join(buf[..], "agent.", a), agents[a], "", a == agent); } }
    k_select_end(t, s[0].amenu);
  }
  // its model
  k_select_begin(t, u, "model", ifx agent == 0 then names[cw_model(s)] else lnames[(agent - 1) * CW_LM + cw_lm(s, agent)], "Model", s[0].menu);
  if s[0].menu && agent == 0 {
    for m: 0..<CW_HOSTED {
      if cw_claude_model(m) && !cw_connected(s) { continue; }
      if m == CW_GEMINI_AGENT && !CW_REPO_LIVE { continue; }
      r := k_row(t, u, tr_join(buf[..], "model.", m), names[m], "", m == cw_model(s));
    }
    if !cw_connected(s) { hint := k_meta(t, "model.hint", "Connect a Claude account in Settings to choose Claude models."); }
  }
  if s[0].menu && agent > 0 {
    for m: 0..<counts[agent - 1] { r := k_row(t, u, tr_join(buf[..], "lm.", m), lnames[(agent - 1) * CW_LM + m], "", m == cw_lm(s, agent)); }
  }
  k_select_end(t, s[0].menu);
  stoppable := s[0].live && !s[0].stopping;
  // a session on this machine that is running: Stop, unless something is typed (it becomes its next turn)
  if s[0].lrun && !s[0].live { k_composer_end(t, u, "composer", ifx cw_has_words(s) then "Send" else "Stop", true); }
  else { k_composer_end(t, u, "composer", ifx s[0].live then "Stop" else "Send", stoppable || (!s[0].live && cw_has_words(s) && (s[0].flight == CF_NONE || s[0].flight == CF_LIST || s[0].flight == CF_LOG || s[0].flight == CF_CLAUDE || s[0].flight == CF_IMPORT || s[0].flight == CF_AGENTS || s[0].flight == CF_WHO || s[0].flight == CF_WORLDS))); }
  tr_close(t);
}

// Makes room for one more message of `need` bytes. When the transcript is full the oldest quarter goes at
// once, in one pass, so the text is not moved for every message after that.
cw_room :: (s: [] ChatWeb, need: int) {
  if s[0].count < CW_MESSAGES && s[0].pool_n + need <= CW_POOL { return; }
  keep := CW_MESSAGES - CW_MESSAGES / 4;
  drop := 0; gone := 0;
  while drop < s[0].count && (s[0].count - drop > keep || s[0].pool_n - gone + need > CW_POOL - CW_POOL / 4) { gone += s[0].len[drop]; drop += 1; }
  if drop == 0 { return; }
  for i: gone..<s[0].pool_n { s[0].pool[i - gone] = s[0].pool[i]; }
  s[0].pool_n -= gone;
  for k: drop..<s[0].count {
    s[0].at[k - drop] = s[0].at[k] - gone; s[0].len[k - drop] = s[0].len[k]; s[0].who[k - drop] = s[0].who[k];
    s[0].meta[k - drop] = s[0].meta[k]; s[0].meta_n[k - drop] = s[0].meta_n[k];
  }
  s[0].count -= drop;
}
// A message into the transcript, the oldest making room for it and for `reserve` more bytes after it.
cw_add :: (s: [] ChatWeb, text: string, who: int, reserve: int) {
  cw_room(s, text.count + reserve);
  k := s[0].count;
  s[0].at[k] = s[0].pool_n; s[0].len[k] = text.count; s[0].who[k] = who; s[0].meta_n[k] = 0;
  for c: text { s[0].pool[s[0].pool_n] = c; s[0].pool_n += 1; }
  s[0].count += 1; s[0].total += 1;
}
// More of the answer that is coming: onto the last message, which ends the pool.
cw_more :: (s: [] ChatWeb, text: string) {
  if !s[0].live || s[0].count == 0 { return; }
  k := s[0].count - 1;
  for c: text {
    if s[0].len[k] >= CW_ANSWER || s[0].pool_n >= CW_POOL { s[0].cut = true; return; }
    s[0].pool[s[0].pool_n] = c; s[0].pool_n += 1; s[0].len[k] += 1;
  }
}
// The number in an answer's Copy id ("m.7.copy" is 7), or -1.
cw_copy_of :: (id: string) -> int {
  if id.count < 8 || cast(string) id[0..<2] != "m." || cast(string) id[id.count - 5..<id.count] != ".copy" { return -1; }
  n := 0;
  for i: 2..<id.count - 5 { c := id[i]; if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return n;
}
// The page's clock in ms, for how long a tool call runs (1 at the start: 0 is "not known").
cw_ms :: (s: [] ChatWeb) -> int { return cast(int) (s[0].time * 1000.0) + 1; }
// A tool call: onto the last message when it is a run of calls that ends the pool and has room, else a new run.
cw_call :: (s: [] ChatWeb, c: CqCall) {
  rec: [CQ_RECORD] u8;
  n := cq_write(rec[..], 0, c);
  if n <= 0 { return; }
  k := s[0].count - 1;
  if k >= 0 && s[0].who[k] == CW_TOOL && s[0].at[k] + s[0].len[k] == s[0].pool_n && s[0].len[k] + n <= CW_TOOL_MOST && s[0].pool_n + n <= CW_POOL {
    calls: [CQ_MOST] CqCall;
    if cq_calls(cw_text(s, k), calls[..]) < CQ_MOST {
      for i: 0..<n { s[0].pool[s[0].pool_n] = rec[i]; s[0].pool_n += 1; }
      s[0].len[k] += n;
      return;
    }
  }
  cw_add(s, cast(string) rec[0..<n], CW_TOOL, 0);
}
// A text's first line.
cw_line :: (text: string) -> string { e := 0; while e < text.count && text[e] != '\n' { e += 1; } return cast(string) text[0..<e]; }
// A step that is its own words (a Gemini turn's world step, an attachment opened, an edit), done.
cw_tool :: (s: [] ChatWeb, label: string) {
  e := 0; while e < label.count && e < CW_TOOL_LINE && label[e] != '\n' { e += 1; }
  if e > 0 { cw_call(s, CqCall.{state = KW_DONE, label = cast(string) label[0..<e]}); }
}
// The last run of tool calls rewritten (cq_answer, cq_close), when it ends the pool.
cw_run_set :: (s: [] ChatWeb, n: int) {
  k := s[0].count - 1;
  if n < 0 || k < 0 || s[0].who[k] != CW_TOOL || s[0].at[k] + s[0].len[k] != s[0].pool_n || s[0].at[k] + n > CW_POOL { return; }
  for i: 0..<n { s[0].pool[s[0].at[k] + i] = s[0].wbuf[i]; }
  s[0].len[k] = n; s[0].pool_n = s[0].at[k] + n;
}
// A tool call's answer, onto its call in the last run.
cw_answer :: (s: [] ChatWeb, id: string, output: string, failed: bool, open: bool) {
  k := s[0].count - 1;
  if k < 0 || s[0].who[k] != CW_TOOL { return; }
  cw_run_set(s, cq_answer(cw_text(s, k), s[0].wbuf[..], id, output, failed, open, cw_ms(s)));
}
// A tool call's Copy ("m.7.c.3.copy", "m.7.calls.c.3.copy" while a hosted turn works): all it got back.
cw_copy_call :: (s: [] ChatWeb, id: string) {
  e := 2; while e < id.count && id[e] >= '0' && id[e] <= '9' { e += 1; }
  k := cw_number(cast(string) id[0..<e], "m.") - (s[0].total - s[0].count);
  if k < 0 || k >= s[0].count { return; }
  run := cast(string) id[0..<e]; text := cw_text(s, k); rb: [UI_ID] u8;
  if s[0].who[k] != CW_TOOL { run = tr_cat(rb[..], run, ".calls"); text = cast(string) s[0].tools[0..<s[0].tools_n]; }
  calls: [CQ_MOST] CqCall; n := cq_calls(text, calls[..]); i := cq_call_of(id, run);
  if i >= 0 && i < n { s[0].clip_n = cw_put(s[0].clip[..], 0, calls[i].output); }
}
// The number after a part: "s.12" after "s." is 12, else -1.
cw_number :: (id: string, part: string) -> int {
  if id.count <= part.count || id.count > part.count + 3 || cast(string) id[0..<part.count] != part { return -1; }
  n := 0;
  for i: part.count..<id.count { c := id[i]; if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return n;
}
// The transcript emptied, for another session or a new chat.
cw_clear :: (s: [] ChatWeb) {
  s[0].count = 0; s[0].pool_n = 0; s[0].total = 0; s[0].error_n = 0;
  s[0].live = false; s[0].lrun = false; s[0].echo = false; s[0].stop_due = false; s[0].turn = 0; s[0].conv = 0;
  s[0].goal_n = 0; s[0].opens_n = 0;
}
// Shows session id from where its log ends (tail) or starts.
cw_show :: (s: [] ChatWeb, id: string, tail: bool) {
  s[0].sel_n = cw_put(s[0].sel[..], 0, id);
  s[0].log_next = ifx tail then -1 else 0; s[0].log_due = true; s[0].log_miss = 0;
}
// The sessions as Coder lists them (`coder ls --json`: an array, newest first).
cw_list_read :: (s: [] ChatWeb, body: string) {
  ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
  path: [48] u8; part: [24] u8;
  n := 0;
  while n < CW_SESS {
    ar[0].at = 0; ar[0].full = false;
    id := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "", n), ".id"));
    if id.count == 0 { break; }
    s[0].sid_n[n] = cw_put(s[0].sid[n][..], 0, id);
    s[0].seng_n[n] = cw_put(s[0].seng[n][..], 0, cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "", n), ".engine")));
    s[0].srun[n] = cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "", n), ".state")) == "running";
    task := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "", n), ".task"));
    e := 0; while e < task.count && e < 96 && task[e] != '\n' { e += 1; }
    s[0].stask_n[n] = cw_put(s[0].stask[n][..], 0, cast(string) task[0..<e]);
    n += 1;
  }
  s[0].ns = n;
}
// This folder's Claude Code conversations as Coder lists them ({"sessions": [{session_id, title, ...}]}, newest first).
// Which of the four agents on this machine are ready (Coder's /agents: {"agents":[{engine, ready, why}...]}, in
// CW_AGENT_NAMES' order after OpenAgents).
cw_agents_read :: (s: [] ChatWeb, body: string) {
  ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
  path: [64] u8; part: [40] u8;
  for i: 0..<4 {
    ar[0].at = 0; ar[0].full = false;
    ready := cl_raw(body, tr_cat(path[..], tr_join(part[..], "agents.", i), ".ready"));
    if ready.count == 0 { continue; }
    s[0].aready[i] = ifx ready == "true" then 1 else -1;
    s[0].aword_n[i] = cw_put(s[0].aword[i][..], 0, cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "agents.", i), ".why")));
  }
}
cw_claude_read :: (s: [] ChatWeb, body: string) {
  ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
  path: [64] u8; part: [40] u8;
  n := 0;
  while n < CW_CL {
    ar[0].at = 0; ar[0].full = false;
    id := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "sessions.", n), ".session_id"));
    if id.count == 0 || id.count > 40 { break; }
    s[0].cid_n[n] = cw_put(s[0].cid[n][..], 0, id);
    title := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "sessions.", n), ".title"));
    e := 0; while e < title.count && e < 96 && title[e] != '\n' { e += 1; }
    s[0].ctitle_n[n] = cw_put(s[0].ctitle[n][..], 0, cast(string) title[0..<e]);
    s[0].copen[n] = 0;
    n += 1;
  }
  s[0].nc = n;
  // the ones a claude on this machine has open now ({"live": [{id, busy}, ...]})
  for j: 0..<32 {
    ar[0].at = 0; ar[0].full = false;
    id := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "live.", j), ".id"));
    if id.count == 0 { break; }
    busy := cl_bool(body, tr_cat(path[..], tr_join(part[..], "live.", j), ".busy"));
    for k: 0..<n { if cast(string) s[0].cid[k][0..<s[0].cid_n[k]] == id { s[0].copen[k] = ifx busy.ok && busy.value then 2 else 1; } }
  }
}
// A piece of the shown session's log: a line saying where the next piece starts, then the log's own
// lines (coax/lib/agent/session/writer.coax). A message of the person's, a tool call, an edit, a reply
// and the ending each go into the transcript.
cw_log_read :: (s: [] ChatWeb, body: string) {
  ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
  at := 0; first := true;
  while at < body.count {
    e := at;
    while e < body.count && body[e] != '\n' { e += 1; }
    line := cast(string) body[at..<e];
    at = e + 1;
    ar[0].at = 0; ar[0].full = false;
    if first {
      first = false;
      next := cl_int(line, "next"); size := cl_int(line, "size");
      if !next.ok { return; }
      if s[0].watching {
        // a fresh copy of a Claude Code conversation: the same size is the same conversation, and nothing changes
        s[0].watching = false;
        if size.ok && size.value == s[0].csize { s[0].log_next = next.value; return; }
        s[0].count = 0; s[0].pool_n = 0; s[0].total = 0; s[0].goal_n = 0;
      }
      if size.ok && s[0].csel_n > 0 { s[0].csize = size.value; }
      if s[0].log_next < 0 { s[0].lrun = true; }   // a session opened at its end is running until its ending is read
      s[0].log_next = next.value;
      s[0].log_due = size.ok && next.value < size.value;   // more is waiting
      continue;
    }
    kind := cl_str(ar[..], line, "kind");
    if kind == "user" {
      cw_goal_note(s, cl_str(ar[..], line, "text"));
      if s[0].echo { s[0].echo = false; } else { cw_add(s, cl_str(ar[..], line, "text"), CW_YOU, 0); }
      s[0].lrun = true;
    } else if kind == "session" { s[0].lrun = true; }
    else if kind == "tool" {
      // a call by its own name, kind, argument and input; a line with only words is a step of those words
      name := cl_str(ar[..], line, "name"); tk := cl_str(ar[..], line, "tool");
      arg := cl_str(ar[..], line, "arg"); if arg.count == 0 { arg = cl_str(ar[..], line, "detail"); }
      input := cl_raw(line, "input"); if input.count > 0 && input[0] == '"' { input = cl_str(ar[..], line, "input"); }
      cw_call(s, CqCall.{state = KW_RUN, t0 = cw_ms(s), kind = tk, name = name, id = cl_str(ar[..], line, "id"), arg = arg,
        label = ifx name.count == 0 && tk.count == 0 then cw_line(cl_str(ar[..], line, "label")) else "", input = input});
      // a realm world tool names its world (the tool's own argument): its card follows the run, on a page with no editor round it
      if s[0].wwire_n == 0 && cw_world_tool(cl_str(ar[..], line, "name")) {
        slug := cl_str(ar[..], line, "input.slug");
        if slug.count == 0 { slug = cl_str(ar[..], cl_str(ar[..], line, "input"), "slug"); }
        if wt_world_ok(slug) { s[0].card_due_n = cw_put(s[0].card_due[..], 0, slug); }
      }
    }
    else if kind == "result" {
      out := cl_str(ar[..], line, "output"); if out.count == 0 { out = cl_str(ar[..], line, "text"); }
      cw_answer(s, cl_str(ar[..], line, "id"), out, cl_raw(line, "error") == "true", cl_raw(line, "open") == "true");
    }
    else if kind == "diff" {
      edit: [CW_TOOL_LINE] u8;
      n := cw_put(edit[..], 0, "Edit "); n = cw_put(edit[..], n, cl_str(ar[..], line, "path"));
      cw_tool(s, cast(string) edit[0..<n]);
    } else if kind == "reply" {
      text := cl_str(ar[..], line, "text");
      if text.count > CW_ANSWER { text = cast(string) text[0..<CW_ANSWER]; }
      if text.count > 0 { cw_add(s, text, CW_AGENT, 0); }
    } else if kind == "end" {
      s[0].lrun = false; s[0].stop_due = false;
      k := s[0].count - 1;
      if k >= 0 && s[0].who[k] == CW_TOOL { cw_run_set(s, cq_close(cw_text(s, k), s[0].wbuf[..])); }
      ending := cl_str(ar[..], line, "ending");
      if ending == "failed" || ending == "expired" {
        why := cl_str(ar[..], line, "text");
        cw_say(s, ifx why.count > 0 then why else "The session ended before it finished.");
      }
    }
  }
}
// A message as an agent that works by itself is told it (one on this machine, or the hosted agent). In the
// editor the world, the selection and the point last tapped follow the person's words; on /chat it is the words.
cw_told :: (s: [] ChatWeb, typed: string, out: [] u8) -> string {
  n := cw_put(out, 0, typed);
  if s[0].wwire_n > 0 {
    words: [WT_WORDS] u8;
    n = cw_put(out, n, "\n\n"); n = cw_put(out, n, wt_words(s[0].world[..], words[..]));
  }
  return cast(string) out[0..<n];
}
// A message for an agent on this machine: a new Coder session, or the shown session's next turn.
cw_local_send :: (s: [] ChatWeb, model: int, typed: string) -> bool {
  ids := CW_MODEL_IDS;
  body: [CW_REQUEST] u8;
  told: [CW_DRAFT + WT_WORDS + 2] u8;
  text := cw_told(s, typed, told[..]);
  if s[0].sel_n > 0 {
    n := json_raw(body[..], 0, "{\"id\":"); n = json_write_string(body[..], n, cw_sel(s));
    n = json_raw(body[..], n, ",\"message\":"); n = json_write_string(body[..], n, text); n = json_raw(body[..], n, "}");
    return cw_go(s, CF_LSEND, "/local/send", cast(string) body[0..<n]);
  }
  n := json_raw(body[..], 0, "{\"task\":"); n = json_write_string(body[..], n, text);
  n = json_raw(body[..], n, ",\"engine\":"); n = json_write_string(body[..], n, ids[model]);
  lids := CW_LM_IDS; agent := model - CW_HOSTED + 1;
  lid := lids[(agent - 1) * CW_LM + cw_lm(s, agent)];
  if lid.count > 0 { n = json_raw(body[..], n, ",\"model\":"); n = json_write_string(body[..], n, lid); }
  n = json_raw(body[..], n, "}");
  return cw_go(s, CF_RUN, "/local/run", cast(string) body[0..<n]);
}
// The digit after a part: "model.2" after "model." is 2, else -1.
cw_index :: (id: string, part: string) -> int {
  if id.count != part.count + 1 || cast(string) id[0..<part.count] != part { return -1; }
  c := id[part.count];
  return ifx c >= '0' && c <= '9' then cast(int) (c - '0') else -1;
}

// A Gemini message: the request for the conversation as it stands, the newest messages that fit CW_ASK,
// oldest of them first, to the inference door.
cw_complete :: (s: [] ChatWeb, model: int) -> bool {
  in_world := s[0].wwire_n > 0;
  first := s[0].count; bytes := 0;
  while first > 0 && bytes + s[0].len[first - 1] <= (ifx in_world then CW_PLAN_ASK else CW_ASK) { first -= 1; bytes += s[0].len[first]; }
  if first == s[0].count && s[0].count > 0 { first = s[0].count - 1; }   // the message itself always goes
  messages: [CW_MESSAGES] GwMessage; n := 0;
  for k: first..<s[0].count {
    if s[0].len[k] == 0 || s[0].who[k] == CW_TOOL || s[0].who[k] == CW_CARD { continue; }   // an answer that never came, tool calls, or a card
    messages[n] = GwMessage.{role = ifx s[0].who[k] == CW_AGENT then "assistant" else "user", text = cw_text(s, k)};
    n += 1;
  }
  ids := CW_MODEL_IDS; names := CW_MODEL_NAMES;
  if in_world {
    s[0].pmodel = model;
    // a turn in the editor: the model answers under the world tools' schema, talk or a plan (turn.coax). Which
    // it is, and which tools, is its typed answer; the answer comes whole.
    prompt: [WP_PROMPT] u8; scratch: [WT_BYTES] u8; schema: [1024] u8; body: [CW_REQUEST] u8;
    // its second ask, after it asked to open attachments: their names in the instructions, their IDs beside the
    // messages; the API reads them from the world's store and puts them in the last message (chat.c)
    names_of: [WT_FNAME * WP_OPEN + 8] u8; on := 0;
    for k: 0..<s[0].nopened {
      at := wt_file_at(s[0].world[..], cast(string) s[0].opened[k][..]);
      if at < 0 { continue; }
      if on > 0 { on = cw_put(names_of[..], on, ", "); }
      on = cw_put(names_of[..], on, cast(string) s[0].world[0].f_name[at][0..<s[0].world[0].f_name_n[at]]);
    }
    system := ifx s[0].nopened > 0 then wp_system_opened(s[0].world[..], cast(string) names_of[0..<on], scratch[..], prompt[..]) else wp_system(s[0].world[..], scratch[..], prompt[..]);
    req := GwRequest.{model = ids[model], system = system, messages = messages[0..<n], schema = wp_schema(schema[..]), schema_name = "world_turn", effort = "low", stream = false};
    bn := gw_chat_body(req, 0, body[..]);
    if bn > 1 && s[0].nopened > 0 && body[bn - 1] == '}' {
      bn = json_raw(body[..], bn - 1, ",\"attachments\":{\"world\":"); bn = json_write_string(body[..], bn, wt_word(s[0].world[..]));
      bn = json_raw(body[..], bn, ",\"ids\":[");
      for k: 0..<s[0].nopened { if k > 0 { bn = json_raw(body[..], bn, ","); } bn = json_write_string(body[..], bn, cast(string) s[0].opened[k][..]); }
      bn = json_raw(body[..], bn, "]}}");
    }
    return bn > 0 && req.system.count > 0 && req.schema.count > 0 && cw_go(s, CF_PLAN, "/api/chat/complete", cast(string) body[0..<bn]);
  }
  system: [1024] u8;
  sn := cw_put(system[..], 0, CW_SYSTEM);
  sn = cw_put(system[..], sn, names[model]); sn = cw_put(system[..], sn, " ("); sn = cw_put(system[..], sn, ids[model]);
  sn = cw_put(system[..], sn, ") on Google's Vertex AI.");
  req := GwRequest.{model = ids[model], system = cast(string) system[0..<sn], messages = messages[0..<n], effort = "low", stream = true};
  body: [CW_REQUEST] u8;
  bn := gw_chat_body(req, 0, body[..]);
  return cw_go(s, CF_COMPLETE, "/api/chat/complete", cast(string) body[0..<bn]);
}
// A Claude message: a turn of the hosted agent, in this visit's conversation there (a new one the first time).
cw_turn_send :: (s: [] ChatWeb, model: int, text: string) -> bool {
  ids := CW_MODEL_IDS;
  body: [CW_REQUEST] u8; num: [24] u8; told: [CW_DRAFT + WT_WORDS + 2] u8;
  n := json_raw(body[..], 0, "{");
  if s[0].conv > 0 { n = json_raw(body[..], n, "\"c\":\""); n = json_raw(body[..], n, tr_join(num[..], "", s[0].conv)); n = json_raw(body[..], n, "\","); }
  n = json_raw(body[..], n, "\"text\":"); n = json_write_string(body[..], n, cw_told(s, text, told[..]));
  n = json_raw(body[..], n, ",\"model\":"); n = json_write_string(body[..], n, ids[model]);
  n = json_raw(body[..], n, "}");
  return cw_go(s, CF_SEND, "/api/chat/send", cast(string) body[0..<n]);
}
// Takes the message: it goes into the transcript, without the space around it, the field is cleared,
// and the chosen model is asked. Nothing is taken while an answer is coming or another request is out.
cw_send :: (s: [] ChatWeb) {
  if s[0].live || !cw_has_words(s) { return; }
  if s[0].flight == CF_LIST || s[0].flight == CF_LOG || s[0].flight == CF_CLAUDE || s[0].flight == CF_IMPORT || s[0].flight == CF_ACCOUNT || s[0].flight == CF_AGENTS || s[0].flight == CF_WHO || s[0].flight == CF_WORLDS { s[0].send_due = true; return; }   // a background read is out (the account's, as the page opens, is one): the message goes when it is back
  if s[0].flight != CF_NONE { return; }
  s[0].send_due = false;
  lo := 0; hi := s[0].draft_n;
  while lo < hi && (s[0].draft[lo] == ' ' || s[0].draft[lo] == '\n' || s[0].draft[lo] == '\t' || s[0].draft[lo] == '\r') { lo += 1; }
  while hi > lo && (s[0].draft[hi - 1] == ' ' || s[0].draft[hi - 1] == '\n' || s[0].draft[hi - 1] == '\t' || s[0].draft[hi - 1] == '\r') { hi -= 1; }
  model := cw_model(s);
  said := cast(string) s[0].draft[lo..<hi];
  if cw_goal_of(said) != CW_GOAL_NONE && !cw_to_claude(s) {
    cw_say(s, "Only Claude Code runs /goal. Choose Claude Code in the Agent menu, or open one of its sessions.");
    return;
  }
  if cw_local_model(model) {
    cw_goal_note(s, said);
    // an agent on this machine: the message shows at once, and the session's log brings the rest
    cw_add(s, cast(string) s[0].draft[lo..<hi], CW_YOU, 0);
    if !cw_local_send(s, model, cw_text(s, s[0].count - 1)) { s[0].count -= 1; s[0].total -= 1; s[0].pool_n = s[0].at[s[0].count]; return; }
    s[0].echo = true; s[0].lrun = true; s[0].error_n = 0; s[0].sends += 1;
    s[0].csel_n = 0; s[0].watching = false;   // from here the session Coder runs is what is shown
    s[0].draft_n = 0; s[0].view = CW_CHAT; s[0].menu = false; s[0].amenu = false;
    dm_value(s[0].dom[..], "composer", "");
    return;
  }
  cw_add(s, cast(string) s[0].draft[lo..<hi], CW_YOU, CW_ANSWER);
  s[0].nopened = 0;   // a new message: a hosted turn may open attachments again
  sent := ifx cw_claude_model(model) || model == CW_GEMINI_AGENT then cw_turn_send(s, model, cw_text(s, s[0].count - 1)) else cw_complete(s, model);
  cw_add(s, "", CW_AGENT, CW_ANSWER);
  names := CW_MODEL_NAMES;
  k := s[0].count - 1;
  s[0].meta_n[k] = cw_put(s[0].meta[k][..], 0, names[model]);
  s[0].sends += 1;
  s[0].live = true; s[0].cut = false; s[0].event_n = 0; s[0].raw_n = 0; s[0].error_n = 0;
  s[0].turn = 0; s[0].stopping = false; s[0].stop_sent = false; s[0].working_n = 0; s[0].tools_n = 0; s[0].ntools = 0;
  fresh: GwParse; s[0].ps[0] = fresh;
  s[0].draft_n = 0; s[0].view = CW_CHAT; s[0].menu = false;
  dm_value(s[0].dom[..], "composer", "");
}
// Stop. A Gemini stream ends at once and what came of the answer stays. A Claude turn is asked to stop,
// and ends when the runner says it has.
cw_stop :: (s: [] ChatWeb) {
  if !s[0].live || s[0].stopping { return; }
  if s[0].flight == CF_COMPLETE || s[0].flight == CF_PLAN {
    s[0].stop = true; s[0].ask = false; s[0].flight = CF_NONE;
    s[0].live = false;
    return;
  }
  s[0].stopping = true;
}

// One whole event of the stream (its lines, without the blank one that ended it).
cw_event :: (s: [] ChatWeb, lines: string) {
  name: [64] u8; data: [CW_EVENT] u8;
  sse: [1] GwSse;
  gw_sse_init(sse[..], name[..], data[..]);
  at := 0;
  while at <= lines.count {
    e := at;
    while e < lines.count && lines[e] != '\n' { e += 1; }
    ev := gw_sse_line(sse[..], cast(string) lines[at..<e]);
    if ev.ready {
      scratch: [CW_EVENT] u8;
      ar: [1] ClArena; ar[0].buf = scratch[..];
      out: [8] GwEvent;
      n := gw_chat_chunk(s[0].ps[..], ar[..], ev.data, out[..]);
      for k: 0..<n {
        if out[k].kind == GW_EV_TEXT { cw_more(s, out[k].text); }
        else if out[k].kind == GW_EV_REFUSED { cw_say(s, ifx out[k].reason.count > 0 then out[k].reason else "The model stopped before it finished."); }
      }
    }
    at = e + 1;
  }
}
// A piece of an answer. A stream's whole events are read as they end (a blank line); anything else is kept for its end.
cw_piece :: (s: [] ChatWeb, status: int, bytes: string) {
  if s[0].flight == CF_NONE { return; }
  s[0].status = status;
  if s[0].flight != CF_COMPLETE || status != 200 {
    for c: bytes { if s[0].resp_n < CW_RESP { s[0].resp[s[0].resp_n] = c; s[0].resp_n += 1; } }
    return;
  }
  for c: bytes {
    if c == '\r' { continue; }
    if s[0].event_n >= CW_EVENT { s[0].event_n = 0; s[0].cut = true; }   // an event too long to read is skipped
    s[0].event[s[0].event_n] = c; s[0].event_n += 1;
    n := s[0].event_n;
    if n >= 2 && s[0].event[n - 1] == '\n' && s[0].event[n - 2] == '\n' {
      cw_event(s, cast(string) s[0].event[0..<n - 1]);
      s[0].event_n = 0;
    }
  }
}
// Why a request failed, in words: the door's own ({"error": "..."}) when it has any.
cw_why :: (s: [] ChatWeb, status: int, out: [] u8) -> int {
  scratch: [CW_ERROR] u8;
  ar: [1] ClArena; ar[0].buf = scratch[..];
  said := cl_str(ar[..], cast(string) s[0].resp[0..<s[0].resp_n], "error");
  if status == 401 { return cw_put(out, 0, "Log in as an admin to chat. The chat is for admins only for now."); }
  if status == 403 { return cw_put(out, 0, "The chat is for admins only for now."); }
  if status == 0 { return cw_put(out, 0, "The page couldn't reach OpenAgents. Check your connection and try again."); }
  if said.count > 0 { return cw_put(out, 0, said); }
  if status == 429 { return cw_put(out, 0, "Too many requests just now. Wait a minute and try again."); }
  return cw_put(out, 0, "That didn't work. Try again.");
}
cw_fail :: (s: [] ChatWeb, status: int) { s[0].error_n = cw_why(s, status, s[0].error[..]); s[0].live = false; }
// The account as the API says it: the credential's kind and last four characters, or none.
cw_account :: (s: [] ChatWeb, body: string, under: string) {
  scratch: [CW_ERROR] u8; path: [48] u8;
  ar: [1] ClArena; ar[0].buf = scratch[..];
  kind := cl_str(ar[..], body, tr_cat(path[..], under, "kind"));
  s[0].claude = ifx kind == "oauth" then CA_TOKEN else ifx kind.count > 0 then CA_KEY else CA_NONE;
  last := cl_str(ar[..], body, tr_cat(path[..], under, "last4"));
  s[0].last4_n = cw_put(s[0].last4[..], 0, last);
  s[0].expired = cl_raw(body, tr_cat(path[..], under, "expired")) == "true";
}
// A Claude turn as the API reads it back: at work (what it is doing, its tools), or ended.
cw_turn_read :: (s: [] ChatWeb, body: string) {
  scratch: [CW_ANSWER] u8; path: [48] u8; part: [48] u8;
  ar: [1] ClArena; ar[0].buf = scratch[..];
  status := cl_str(ar[..], body, "status");
  s[0].working_n = cw_put(s[0].working[..], 0, cl_str(ar[..], body, "working"));
  s[0].tools_n = 0; s[0].ntools = 0;
  while s[0].ntools < 64 {
    name := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "tools.", s[0].ntools), ".name"));
    if name.count == 0 { break; }
    detail := cl_str(ar[..], body, tr_cat(path[..], tr_join(part[..], "tools.", s[0].ntools), ".detail"));
    n := cq_write(s[0].tools[..], s[0].tools_n, CqCall.{state = KW_DONE, name = name, arg = detail});
    if n < 0 { break; }
    s[0].tools_n = n; s[0].ntools += 1;
  }
  // the newest is the one it is at, while it works
  if status == "queued" || status == "running" { if s[0].ntools > 0 { last := cq_at(cast(string) s[0].tools[0..<s[0].tools_n], s[0].ntools - 1); if last >= 0 { s[0].tools[last] = cast(u8) ('0' + KW_RUN); } } return; }
  k := s[0].count - 1;
  if s[0].ntools > 0 && k >= 0 && s[0].who[k] == CW_AGENT {
    // its tools go above the answer, as a run of tool calls
    meta := s[0].meta[k]; meta_n := s[0].meta_n[k];
    s[0].count = k; s[0].total -= 1; s[0].pool_n = s[0].at[k];
    cw_add(s, cast(string) s[0].tools[0..<s[0].tools_n], CW_TOOL, 0);
    cw_add(s, "", CW_AGENT, CW_ANSWER);
    k = s[0].count - 1; s[0].meta[k] = meta; s[0].meta_n[k] = meta_n;
  }
  if s[0].ntools > 0 {
    num: [24] u8;
    n := cw_put(s[0].meta[k][..], s[0].meta_n[k], " · ");
    n = cw_put(s[0].meta[k][..], n, tr_join(num[..], "", s[0].ntools));
    s[0].meta_n[k] = cw_put(s[0].meta[k][..], n, ifx s[0].ntools == 1 then " tool" else " tools");
  }
  if status == "done" { cw_more(s, cl_str(ar[..], body, "answer")); }
  else if status != "stopped" {
    why := cl_str(ar[..], body, "error");
    cw_say(s, ifx why.count > 0 then why else "The turn didn't finish. Send it again.");
  }
  if s[0].cut { cw_say(s, "The answer was longer than this page keeps, so its end is missing."); }
  s[0].live = false; s[0].stopping = false; s[0].turn = 0; s[0].working_n = 0; s[0].tools_n = 0;
}
// A hosted turn's typed answer, in the editor: talk is the answer; an edit's steps show as the tools they are,
// go to the editor as a plan, and what it says is the answer. The editor sends the edits as the person's own, so
// the world's rules answer them there, in words.
cw_plan_read :: (s: [] ChatWeb, body: string) {
  scratch: [CW_ANSWER] u8; ar: [1] ClArena; ar[0].buf = scratch[..];
  ev: [8] GwEvent; plan: [1] WorldPlan;
  n := gw_chat_whole(ar[..], body, ev[..]);
  reply := "";
  for k: 0..<n {
    if ev[k].kind == GW_EV_TEXT { reply = ev[k].text; }
    else if ev[k].kind == GW_EV_REFUSED { cw_say(s, ifx ev[k].reason.count > 0 then ev[k].reason else "The model stopped before it finished."); return; }
  }
  if !wp_reply(plan[..], s[0].world[..], reply) {
    cw_say(s, ifx plan[0].say_n > 0 && plan[0].say_n < CW_ERROR then cast(string) plan[0].say[0..<plan[0].say_n] else "The model's answer could not be read. Send it again.");
    return;
  }
  if plan[0].nopen > 0 {
    // it asks to see attachments first: they show as what it opened, and it is asked again with them
    if s[0].nopened > 0 { cw_say(s, "The model asked to open attachments again instead of answering. Send it again."); return; }
    k := s[0].count - 1; meta := s[0].meta[k]; meta_n := s[0].meta_n[k];
    s[0].count = k; s[0].total -= 1; s[0].pool_n = s[0].at[k];
    line: [WT_FNAME + 8] u8;
    for i: 0..<plan[0].nopen {
      s[0].opened[i] = plan[0].open[i];
      at := wt_file_at(s[0].world[..], cast(string) plan[0].open[i][..]);
      ln := cw_put(line[..], 0, "Open "); ln = cw_put(line[..], ln, ifx at < 0 then "an attachment" else cast(string) s[0].world[0].f_name[at][0..<s[0].world[0].f_name_n[at]]);
      cw_tool(s, cast(string) line[0..<ln]);
    }
    s[0].nopened = plan[0].nopen;
    cw_add(s, "", CW_AGENT, CW_ANSWER);
    k = s[0].count - 1; s[0].meta[k] = meta; s[0].meta_n[k] = meta_n;
    if !cw_complete(s, s[0].pmodel) { cw_say(s, "The attachments could not be asked for. Send it again."); return; }
    s[0].live = true;
    return;
  }
  if plan[0].edit {
    if s[0].planned_n > 0 { cw_say(s, "The editor is still taking the last change. Send it again."); return; }
    s[0].planned_n = wp_write(plan[..], s[0].planned[..]).count;
    if s[0].planned_n == 0 { cw_say(s, "The model's answer could not be read. Send it again."); return; }
    // the steps go above the answer, as a run of tool calls
    k := s[0].count - 1; meta := s[0].meta[k]; meta_n := s[0].meta_n[k];
    s[0].count = k; s[0].total -= 1; s[0].pool_n = s[0].at[k];
    line: [WP_LINE] u8; names := CW_STEP_TOOLS;
    for i: 0..<plan[0].n {
      step := plan[0].steps[i];
      cw_call(s, CqCall.{state = KW_DONE, name = names[ifx step.tool >= 0 && step.tool < WT_TOOLS then step.tool else 0], label = wp_line(step, s[0].world[..], line[..])});
    }
    cw_add(s, "", CW_AGENT, CW_ANSWER);
    k = s[0].count - 1; s[0].meta[k] = meta; s[0].meta_n[k] = meta_n;
  }
  s[0].live = true;
  cw_more(s, cast(string) plan[0].say[0..<plan[0].say_n]);
  s[0].live = false;
}
// A tool of the realm world family, by its own name ("realm_world", "realm_world_place", with or without the
// prefix an agent gives a server's tools): the typed name the session's log carries, not words in a message.
cw_world_tool :: (name: string) -> bool {
  at := 0;
  for i: 0..<name.count { if i + 1 < name.count && name[i] == '_' && name[i + 1] == '_' { at = i + 2; } }
  tail := cast(string) name[at..<name.count];
  return tail == "realm_world" || (tail.count > 12 && cast(string) tail[0..<12] == "realm_world_");
}
// A request's end.
cw_end :: (s: [] ChatWeb, status: int) {
  kind := s[0].flight;
  if kind == CF_NONE { return; }
  s[0].flight = CF_NONE;
  body := cast(string) s[0].resp[0..<s[0].resp_n];
  if kind == CF_WHO {
    s[0].me_n = ifx status == 200 then ss_who_read(body, s[0].me[..]) else 0;
    if status == 200 { sw_account_read(s[0].set[..], body); } else { sw_account_read(s[0].set[..], ""); }
  } else if kind == CF_WORLDS {
    s[0].worlds_n = ifx status == 200 then ss_worlds_read(body, s[0].worlds[..]) else 0;
  } else if kind == CF_LIMITS {
    sw_limits_read(s[0].set[..], status, body);
  } else if kind == CF_ABOUT {
    sw_about_read(s[0].set[..], status, body);
  } else if kind == CF_OUT {
    if status == 200 || status == 204 { s[0].me_n = 0; s[0].worlds_n = 0; cw_go_to(s, "/", false); }   // logged out: the public home page
  } else if kind == CF_ACCOUNT {
    s[0].known = status == 200; s[0].known_asked = true;
    if status == 200 { cw_account(s, body, "claude."); }
  } else if kind == CF_KEY {
    if status == 200 { cw_account(s, body, ""); s[0].expired = false; s[0].note_n = cw_put(s[0].note[..], 0, "Connected. Choose a Claude model in the menu beside the gear."); }
    else { s[0].note_n = cw_why(s, status, s[0].note[..]); }
  } else if kind == CF_UNKEY {
    if status == 200 { s[0].claude = CA_NONE; s[0].last4_n = 0; s[0].expired = false; s[0].note_n = cw_put(s[0].note[..], 0, "Disconnected."); }
    else { s[0].note_n = cw_why(s, status, s[0].note[..]); }
  } else if kind == CF_COMPLETE {
    if !s[0].live { return; }
    s[0].live = false;
    if s[0].event_n > 0 { cw_event(s, cast(string) s[0].event[0..<s[0].event_n]); s[0].event_n = 0; }
    got := s[0].count > 0 && s[0].len[s[0].count - 1] > 0;
    if status != 200 { cw_fail(s, status); }
    else if s[0].cut { cw_say(s, "The answer was longer than this page keeps, so its end is missing."); }
    else if !got && s[0].error_n == 0 { cw_say(s, "The model sent no answer."); }
  } else if kind == CF_PLAN {
    if !s[0].live { return; }
    s[0].live = false;
    if status != 200 { cw_fail(s, status); return; }
    cw_plan_read(s, body);
  } else if kind == CF_CARD {
    // a card that can't be read is not shown: the agent's own words still say what it did
    card: [1] WorldCard; scratch: [WC_BYTES] u8;
    if status == 200 && wc_read(card[..], body, scratch[..]) {
      k := s[0].count - 1;
      if k >= 0 && s[0].who[k] == CW_CARD { s[0].count = k; s[0].total -= 1; s[0].pool_n = s[0].at[k]; }   // the card it follows is the same world, a moment older
      cw_add(s, body, CW_CARD, 0);
    }
  } else if kind == CF_SEND {
    if status != 200 { cw_fail(s, status); return; }
    c := cl_int(body, "c"); turn := cl_int(body, "turn");
    if !c.ok || !turn.ok { cw_fail(s, 0); return; }
    s[0].conv = c.value; s[0].turn = turn.value; s[0].asked_at = s[0].time;
  } else if kind == CF_AGENTS {
    if status == 200 { cw_agents_read(s, body); }
  } else if kind == CF_LIST {
    if status == 200 { s[0].local = 1; cw_list_read(s, body); }
    else if s[0].local == 0 { s[0].local = -1; }
  } else if kind == CF_LOG {
    if status == 200 { s[0].log_miss = 0; cw_log_read(s, body); }
    else if status == 404 && s[0].log_miss < CW_LOG_WAIT { s[0].log_miss += 1; s[0].lrun = true; }   // a session just started has no log yet: read again
    else if status == 404 { s[0].lrun = false; cw_say(s, "That session's log is gone."); }
  } else if kind == CF_RUN {
    // the new session's ID, on a line of its own
    e := 0; while e < body.count && ((body[e] >= '0' && body[e] <= '9') || body[e] == '-') { e += 1; }
    if status != 200 || e == 0 || e > 23 { s[0].lrun = false; s[0].echo = false; cw_say(s, ifx body.count > 0 && body.count < CW_ERROR then body else "Coder couldn't start that. Is it running on this computer?"); return; }
    cw_show(s, cast(string) body[0..<e], false);
    s[0].list_at = s[0].time - CW_LIST_EVERY;
  } else if kind == CF_LSEND {
    ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
    now := cl_str(ar[..], body, "id");
    if status != 200 || now.count == 0 || now.count > 23 {
      s[0].lrun = false; s[0].echo = false;
      cw_say(s, ifx body.count > 0 && body.count < CW_ERROR then body else "Coder couldn't take that message.");
      // it wasn't sent: it leaves the transcript and goes back in the field
      k := s[0].count - 1;
      if k >= 0 && s[0].who[k] == CW_YOU {
        s[0].draft_n = cw_put(s[0].draft[..], 0, cw_text(s, k));
        dm_value(s[0].dom[..], "composer", cast(string) s[0].draft[0..<s[0].draft_n]);
        s[0].count = k; s[0].total -= 1; s[0].pool_n = s[0].at[k];
      }
      return;
    }
    if now != cw_sel(s) { cw_show(s, now, false); }   // an ended session continues in a new one
    s[0].log_due = true; s[0].list_at = s[0].time - CW_LIST_EVERY;
  } else if kind == CF_LSTOP {
    s[0].log_due = true;
  } else if kind == CF_CLAUDE {
    if status == 200 { cw_claude_read(s, body); }
  } else if kind == CF_IMPORT {
    ar: [1] ClArena; ar[0].buf = s[0].scratch[..];
    now := cl_str(ar[..], body, "id");
    if status != 200 || now.count == 0 || now.count > 23 { s[0].csel_n = 0; cw_say(s, "Coder couldn't open that conversation."); return; }
    again := s[0].sel_n > 0 && now == cw_sel(s);
    cw_show(s, now, true);
    s[0].watching = again; s[0].watch_at = s[0].time;
    if !again { s[0].model = CW_HOSTED; s[0].csize = 0; }   // a message here goes on in Claude Code
  }
  if s[0].send_due && (kind == CF_LIST || kind == CF_LOG || kind == CF_CLAUDE || kind == CF_IMPORT || kind == CF_ACCOUNT || kind == CF_AGENTS) { cw_send(s); } else if kind == CF_TURN {
    if status == 200 { cw_turn_read(s, body); }
    else if status != 0 { cw_fail(s, status); s[0].turn = 0; }   // with no answer at all, it is read again
  }
}
// What a frame sends for a Claude turn at work: Stop once, then a read each CW_POLL seconds.
cw_tick :: (s: [] ChatWeb) {
  if s[0].flight >= CF_LIST && s[0].flight <= CF_IMPORT && s[0].time - s[0].flight_at > CW_LOCAL_WAIT {
    // Coder didn't answer: the request is ended, and what it was for is asked again in its turn
    if s[0].flight == CF_LOG || s[0].flight == CF_IMPORT { s[0].log_due = s[0].sel_n > 0; }
    if s[0].flight == CF_RUN || s[0].flight == CF_LSEND { s[0].lrun = false; s[0].echo = false; cw_say(s, "Coder on this computer didn't answer. Send it again."); }
    s[0].stop = true; s[0].ask = false; s[0].flight = CF_NONE; s[0].dirty = true;
    return;
  }
  if s[0].flight != CF_NONE { return; }
  if s[0].out_due { if cw_go(s, CF_OUT, "/api/auth/logout?as=lines", "{}") { s[0].out_due = false; } return; }
  if !s[0].me_asked && s[0].known_asked { if cw_go(s, CF_WHO, "/api/auth/account?as=lines", "") { s[0].me_asked = true; } return; }
  if !s[0].worlds_asked && s[0].me_n > 0 { if cw_go(s, CF_WORLDS, "/api/worlds", "") { s[0].worlds_asked = true; } return; }
  // Settings: the limits and the release, once each, when its page is open
  if s[0].page == SW_PAGE && !s[0].set[0].limits_asked { if cw_go(s, CF_LIMITS, "/api/auth/limits?as=lines", "") { s[0].set[0].limits_asked = true; } return; }
  if s[0].page == SW_PAGE && !s[0].set[0].about_asked { if cw_go(s, CF_ABOUT, "/build/about.txt", "") { s[0].set[0].about_asked = true; } return; }
  if s[0].card_due_n > 0 && !s[0].live {
    url: [96] u8;
    n := cw_put(url[..], 0, "/api/worlds/"); n = cw_put(url[..], n, cast(string) s[0].card_due[0..<s[0].card_due_n]); n = cw_put(url[..], n, "/card");
    if cw_go(s, CF_CARD, cast(string) url[0..<n], "") { s[0].card_due_n = 0; }
    return;
  }
  if s[0].local == 1 && !s[0].local_off && !s[0].live {
    // Coder on this machine: Stop once, the shown session's log while it runs, and the sessions now and then
    url: [96] u8; num: [24] u8;
    if s[0].import_due > 0 && s[0].import_due <= s[0].nc {
      body: [96] u8; k := s[0].import_due - 1;
      n := cw_put(body[..], 0, "{\"ref\":\""); n = cw_put(body[..], n, cast(string) s[0].cid[k][0..<s[0].cid_n[k]]); n = cw_put(body[..], n, "\"}");
      if cw_go(s, CF_IMPORT, "/local/import", cast(string) body[0..<n]) { s[0].import_due = 0; }
      return;
    }
    if s[0].csel_n > 0 && s[0].sel_n > 0 && !s[0].lrun && !s[0].log_due && s[0].time - s[0].watch_at >= CW_CL_LIVE {
      // the conversation shown, copied again
      body: [96] u8;
      n := cw_put(body[..], 0, "{\"ref\":\""); n = cw_put(body[..], n, cast(string) s[0].csel[0..<s[0].csel_n]); n = cw_put(body[..], n, "\"}");
      if cw_go(s, CF_IMPORT, "/local/import", cast(string) body[0..<n]) { s[0].watch_at = s[0].time; }
      return;
    }
    if s[0].stop_due && s[0].sel_n > 0 {
      body: [64] u8;
      n := cw_put(body[..], 0, "{\"id\":\""); n = cw_put(body[..], n, cw_sel(s)); n = cw_put(body[..], n, "\"}");
      if cw_go(s, CF_LSTOP, "/local/stop", cast(string) body[0..<n]) { s[0].stop_due = false; }
      return;
    }
    if s[0].sel_n > 0 && (s[0].log_due || (s[0].lrun && s[0].time - s[0].log_at >= CW_LOG_EVERY)) {
      n := cw_put(url[..], 0, "/local/log?id="); n = cw_put(url[..], n, cw_sel(s)); n = cw_put(url[..], n, "&after=");
      n = cw_put(url[..], n, ifx s[0].log_next < 0 then "-1" else tr_join(num[..], "", s[0].log_next));
      if cw_go(s, CF_LOG, cast(string) url[0..<n], "") { s[0].log_at = s[0].time; s[0].log_due = false; }
      return;
    }
    if !s[0].cl_asked || s[0].time - s[0].cl_at >= CW_CL_EVERY { if cw_go(s, CF_CLAUDE, "/local/claude", "") { s[0].cl_at = s[0].time; s[0].cl_asked = true; } return; }
    if s[0].time - s[0].list_at >= CW_LIST_EVERY { if cw_go(s, CF_LIST, "/local/sessions", "") { s[0].list_at = s[0].time; } return; }
    // which agents are ready, once Settings or the agent menu shows them
    if !s[0].agents_asked && (s[0].page == SW_PAGE || s[0].amenu) { if cw_go(s, CF_AGENTS, "/local/agents", "") { s[0].agents_asked = true; } return; }
  }
  if s[0].local == 0 && !s[0].local_off && s[0].known_asked && !s[0].live && s[0].time > 0.2 { if cw_go(s, CF_LIST, "/local/sessions", "") { s[0].list_at = s[0].time; } return; }
  if !s[0].live || s[0].turn <= 0 { return; }
  url: [96] u8; num: [24] u8;
  if s[0].stopping && !s[0].stop_sent && s[0].conv > 0 {
    body: [64] u8;
    n := cw_put(body[..], 0, "{\"c\":\""); n = cw_put(body[..], n, tr_join(num[..], "", s[0].conv)); n = cw_put(body[..], n, "\"}");
    if cw_go(s, CF_STOP, "/api/chat/stop", cast(string) body[0..<n]) { s[0].stop_sent = true; s[0].asked_at = s[0].time - CW_POLL; }   // then read at once
    return;
  }
  if s[0].time - s[0].asked_at < CW_POLL { return; }
  if cw_go(s, CF_TURN, tr_cat(url[..], "/api/chat/turn?t=", tr_join(num[..], "", s[0].turn)), "") { s[0].asked_at = s[0].time; }
}
// Connect: the key typed in Settings goes to be checked and sealed, and is wiped here.
cw_connect :: (s: [] ChatWeb) {
  if s[0].key_n == 0 || s[0].flight != CF_NONE { return; }
  body: [CW_KEY + 64] u8;
  n := json_raw(body[..], 0, "{\"credential\":");
  n = json_write_string(body[..], n, cast(string) s[0].key[0..<s[0].key_n]);
  n = json_raw(body[..], n, "}");
  sent := cw_go(s, CF_KEY, "/api/chat/key", cast(string) body[0..<n]);
  for i: 0..<body.count { body[i] = 0; }
  for i: 0..<CW_KEY { s[0].key[i] = 0; }
  s[0].key_n = 0; s[0].note_n = 0;
  dm_value(s[0].dom[..], "claude.key", "");
}

// ---------------------------------------------------------------- the face's calls

coaxial_chatweb_frame :: (s: [] ChatWeb, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true;
    asked := cw_go(s, CF_ACCOUNT, "/api/chat/account", "");
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  cw_tick(s);
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := mono_work_css(s[0].css[..], mono_set_css(s[0].css[..], mono_css(s[0].css[..])));
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  cw_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy || s[0].marking;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}
// Whether the host is to call again next frame: something changed or is moving, or a Claude turn is at work.
coaxial_chatweb_busy :: (s: [] ChatWeb) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating || (s[0].live && s[0].turn > 0) || s[0].local >= 0); }
coaxial_chatweb_event :: (s: [] ChatWeb, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  if kind == CW_PIECE {
    n := ifx length < 0 then 0 else ifx length > CW_INBOX then CW_INBOX else length;
    cw_piece(s, slot, cast(string) s[0].inbox[0..<n]);
    s[0].dirty = true; return;
  }
  if kind == CW_END { cw_end(s, slot); s[0].dirty = true; return; }
  if kind == CW_KEPT {
    n := ifx length < 0 || length > CW_INBOX then 0 else length;
    kept := cast(string) s[0].inbox[0..<n];
    s[0].local_off = cw_kept_has(kept, "local=off");
    s[0].side_closed = cw_kept_has(kept, "side=closed");
    for a: 0..<4 { s[0].lm[a] = cw_kept_lm(kept, a + 1); }
    s[0].set[0].kept_model = cw_kept_model(kept);
    if s[0].set[0].kept_model > 0 && s[0].count == 0 && s[0].sends == 0 { s[0].model = s[0].set[0].kept_model - 1; }
    s[0].dirty = true; return;
  }
  if kind == CW_PATH {
    n := ifx length < 0 || length > CW_INBOX then 0 else length;
    path := cast(string) s[0].inbox[0..<n];
    sec := sw_section_of(path);
    if sec >= 0 { s[0].page = SW_PAGE; s[0].set[0].section = sec; s[0].set[0].menu = 0; }
    else { s[0].page = ss_page_of(path); }
    s[0].dirty = true; return;
  }
  if kind == CW_WORLD {
    // bytes that are not a turn mean no world: the next turn goes without one
    n := ifx length < 0 || length > WT_BYTES then 0 else length;
    scratch: [WT_BYTES] u8;
    for i: 0..<n { s[0].wwire[i] = s[0].inbox[i]; }
    s[0].wwire_n = ifx wt_read(s[0].world[..], cast(string) s[0].wwire[0..<n], scratch[..]) then n else 0;
    s[0].dirty = true; return;
  }
  id := dm_slot_id(s[0].dom[..], slot);
  if kind == CW_INPUT && id == "composer" {
    n := ifx length < 0 then 0 else ifx length > CW_DRAFT then CW_DRAFT else length;
    for i: 0..<n { s[0].draft[i] = s[0].inbox[i]; }
    s[0].draft_n = n;
  }
  else if kind == CW_INPUT && id == "claude.key" {
    n := ifx length < 0 then 0 else ifx length > CW_KEY then CW_KEY else length;
    for i: 0..<n { s[0].key[i] = s[0].inbox[i]; s[0].inbox[i] = 0; }   // the key doesn't stay in the inbox
    s[0].key_n = n;
  }
  else if kind == CW_SUBMIT && id == "composer" { cw_send(s); }
  else if kind == CW_SUBMIT && id == "claude.key" { cw_connect(s); }
  else if kind == CW_CLICK && id == "composer.send" {
    if s[0].live { cw_stop(s); }
    else if s[0].lrun && !cw_has_words(s) { s[0].stop_due = true; }
    else { cw_send(s); }
  }
  else if kind == CW_CLICK && cw_number(id, "c.") >= 0 {
    k := cw_number(id, "c.");
    if k < s[0].nc && !s[0].live {
      cw_clear(s); s[0].sel_n = 0;
      s[0].csel_n = cw_put(s[0].csel[..], 0, cast(string) s[0].cid[k][0..<s[0].cid_n[k]]);
      s[0].import_due = k + 1; s[0].view = CW_CHAT;
      cw_to_chat(s);
      dm_focus(s[0].dom[..], "composer");
    }
  }
  else if kind == CW_CLICK && id == "side.new" {
    cw_clear(s); s[0].sel_n = 0; s[0].csel_n = 0; s[0].view = CW_CHAT;
    if s[0].set[0].kept_model > 0 { s[0].model = s[0].set[0].kept_model - 1; }   // a new chat starts on the model Settings keeps
    cw_to_chat(s); dm_focus(s[0].dom[..], "composer");
  }
  // the side: home and the chat are drawn here, so their links stay in the shell; the other places are pages of their own
  else if kind == CW_CLICK && id == "side.h.home" { if s[0].me_n > 0 { s[0].page = SS_HOME; cw_go_to(s, "/", true); } else { return; } }   // logged out, the home page is the public one
  else if kind == CW_CLICK && id == "place.chats" { cw_to_chat(s); dm_focus(s[0].dom[..], "composer"); }
  else if kind == CW_CLICK && (id == "side.hide" || id == "side.show") { s[0].side_closed = id == "side.hide"; cw_keep(s); }
  else if kind == CW_CLICK && id == "who.out" { s[0].out_due = true; }
  else if kind == CW_CLICK && cw_number(id, "s.") >= 0 {
    k := cw_number(id, "s.");
    if k < s[0].ns && !s[0].live {
      cw_clear(s); s[0].csel_n = 0;
      cw_show(s, cast(string) s[0].sid[k][0..<s[0].sid_n[k]], true);
      // its agent is the one a message here goes to
      ids := CW_MODEL_IDS; eng := cast(string) s[0].seng[k][0..<s[0].seng_n[k]];
      for m: CW_HOSTED..<CW_MODELS { if ids[m] == eng || (eng == "microcoder" && ids[m] == "micro") { s[0].model = m; } }
      if !cw_local_model(s[0].model) { s[0].model = CW_HOSTED; }
      s[0].view = CW_CHAT;
      cw_to_chat(s);
      dm_focus(s[0].dom[..], "composer");
    }
  }
  else if cw_settings_event(s, kind, id, length) {}   // Settings, its links and the gear (chat-settings.coax)
  else if kind == CW_CLICK && id == "machine.switch" { cw_machine_switch(s, !s[0].local_off); }
  else if kind == CW_CLICK && id == "model" { s[0].menu = !s[0].menu; s[0].amenu = false; }
  else if kind == CW_CLICK && id == "agent" { s[0].amenu = !s[0].amenu; s[0].menu = false; }
  else if kind == CW_CLICK && cw_index(id, "agent.") >= 0 {
    a := cw_index(id, "agent.");
    if a < CW_AGENTS && s[0].local == 1 && !s[0].local_off && (a == 0 || s[0].aready[a - 1] >= 0) {
      if cw_agent(s) == 0 { s[0].hosted = cw_model(s); }
      s[0].model = ifx a == 0 then s[0].hosted else CW_HOSTED + a - 1;
    }
    s[0].amenu = false;
    dm_focus(s[0].dom[..], "composer");
  }
  else if kind == CW_CLICK && cw_index(id, "lm.") >= 0 {
    counts := CW_LM_N; agent := cw_agent(s); m := cw_index(id, "lm.");
    if agent > 0 && m < counts[agent - 1] { s[0].lm[agent - 1] = m + 1; cw_keep(s); }
    s[0].menu = false;
    dm_focus(s[0].dom[..], "composer");
  }
  else if kind == CW_CLICK && cw_index(id, "model.") >= 0 {
    m := cw_index(id, "model.");
    if m < CW_HOSTED && (!cw_claude_model(m) || cw_connected(s)) && (m != CW_GEMINI_AGENT || CW_REPO_LIVE) { s[0].model = m; }
    s[0].menu = false;
    dm_focus(s[0].dom[..], "composer");   // a model chosen: the caret is back in the field
  }
  else if kind == CW_CLICK && id == "claude.save" { cw_connect(s); }
  else if kind == CW_CLICK && id == "claude.remove" { if cw_go(s, CF_UNKEY, "/api/chat/key_remove", "{}") { s[0].note_n = 0; } }
  else if kind == CW_CLICK && cq_press(id) == 1 { s[0].opens_n = cq_toggle(s[0].opens[..], s[0].opens_n, id); }
  else if kind == CW_CLICK && cq_press(id) == 2 { cw_copy_call(s, id); }
  else if kind == CW_CLICK && cw_copy_of(id) < 0 && id.count > 5 && cast(string) id[id.count - 5..<id.count] == ".copy" {
    // a code block's Copy: the code beside it, as the page shows it
    pre: [UI_ID] u8;
    at := tr_find(s[0].tree[..], tr_cat(pre[..], cast(string) id[0..<id.count - 5], ".pre"));
    if at >= 0 { s[0].clip_n = cw_put(s[0].clip[..], 0, tr_text_of(s[0].tree[..], at)); }
  }
  else if kind == CW_CLICK && cw_copy_of(id) >= 0 {
    k := cw_copy_of(id) - (s[0].total - s[0].count);
    if k >= 0 && k < s[0].count {
      s[0].copied = cw_copy_of(id) + 1; s[0].copied_at = s[0].time;
      s[0].clip_n = cw_put(s[0].clip[..], 0, cw_text(s, k));
    }
  }
  else { return; }
  s[0].dirty = true;
}
coaxial_chatweb_size :: (s: [] ChatWeb, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_chatweb_clip :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
coaxial_chatweb_clip_done :: (s: [] ChatWeb) #export_c #effects(all) { if s.count > 0 { s[0].clip_n = 0; } }
coaxial_chatweb_inbox_cap :: () -> int #export_c #effects(all) { return CW_INBOX; }
// Whether a request waits for the host; its body's bytes (none for a GET); and that it has gone, when the
// body, which may hold a key, is wiped.
coaxial_chatweb_asking :: (s: [] ChatWeb) -> bool #export_c #effects(all) { return s.count > 0 && s[0].ask; }
coaxial_chatweb_ask :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].ask then s[0].request_n else 0; }
coaxial_chatweb_asked :: (s: [] ChatWeb) #export_c #effects(all) {
  if s.count < 1 { return; }
  if s[0].flight != CF_COMPLETE { for i: 0..<s[0].request_n { s[0].request[i] = 0; } s[0].request_n = 0; }
  s[0].ask = false;
}
// An action for the page that opened this conversation (dom-host's dom_act): its kind (0: none), its bytes at
// `planned`, and its taking.
coaxial_chatweb_act_kind :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].planned_n > 0 then CW_PLANNED else 0; }
coaxial_chatweb_act_len :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].planned_n else 0; }
coaxial_chatweb_act_done :: (s: [] ChatWeb) #export_c #effects(all) { if s.count > 0 { s[0].planned_n = 0; } }
// A setting for the host to keep in this browser (dom-host.js dom_keep): its bytes at `keep`, and its taking.
coaxial_chatweb_keep_len :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].keep_n else 0; }
coaxial_chatweb_keep_done :: (s: [] ChatWeb) #export_c #effects(all) { if s.count > 0 { s[0].keep_n = 0; } }
// An address for the host (dom_go): its length (0 for none), whether it is pushed (the shell stays), and that it went.
coaxial_chatweb_go_len :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].go_n else 0; }
coaxial_chatweb_go_push :: (s: [] ChatWeb) -> bool #export_c #effects(all) { return s.count > 0 && s[0].go_push; }
coaxial_chatweb_go_done :: (s: [] ChatWeb) #export_c #effects(all) { if s.count > 0 { s[0].go_n = 0; } }
// Whether the host is to end the stream, read once.
coaxial_chatweb_stop :: (s: [] ChatWeb) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].stop { return false; }
  s[0].stop = false;
  return true;
}

// ---------------------------------------------------------------- checks

CwTest :: struct { s: [1] ChatWeb; }

cw_test_type :: (s: [] ChatWeb, id: string, text: string) {
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(s[0].dom[..], id), text.count);
}
// A piece of an answer, as the host hands it over, and a whole answer with its end.
cw_test_piece :: (s: [] ChatWeb, status: int, text: string) {
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_PIECE, status, text.count);
}
cw_test_answer :: (s: [] ChatWeb, status: int, text: string) {
  coaxial_chatweb_asked(s);
  if text.count > 0 { cw_test_piece(s, status, text); }
  coaxial_chatweb_event(s, CW_END, status, 0);
}
cw_test_has :: (s: string, part: string) -> bool {
  i := 0;
  while i + part.count <= s.count { if cast(string) s[i..<i + part.count] == part { return true; } i += 1; }
  return false;
}
// The page as it opens: its first frame, and the account's answer.
cw_test_open :: (s: [] ChatWeb, account: string) {
  n := coaxial_chatweb_frame(s, 0.016, true);
  cw_test_answer(s, 200, account);
  n = coaxial_chatweb_frame(s, 0.016, true);
  // then who is logged in, for the side's foot
  if coaxial_chatweb_asking(s) && cw_test_door(s) == "/api/auth/account?as=lines" { cw_test_answer(s, 200, CW_TEST_WHO); n = coaxial_chatweb_frame(s, 0.016, true); }
  // then the worlds they may edit, under Worlds
  if coaxial_chatweb_asking(s) && cw_test_door(s) == "/api/worlds" { cw_test_answer(s, 200, CW_TEST_WORLDS); n = coaxial_chatweb_frame(s, 0.016, true); }
}
CW_TEST_WHO :: "logged_in 1\naccount acct_1\nkind email\nemail a•••@example.com\n";
CW_TEST_WORLDS :: "world splice Splice\n";
cw_test_door :: (s: [] ChatWeb) -> string { return cast(string) s[0].door[0..<s[0].door_n]; }
cw_test_body :: (s: [] ChatWeb) -> string { return cast(string) s[0].request[0..<s[0].request_n]; }
cw_test_press :: (s: [] ChatWeb, id: string) { coaxial_chatweb_event(s, CW_CLICK, dm_find(s[0].dom[..], id), 0); }
cw_test_enter :: (s: [] ChatWeb, id: string) { coaxial_chatweb_event(s, CW_SUBMIT, dm_find(s[0].dom[..], id), 0); }

#test "the page opens on the composer, asks for the account, and Send is off until there are words" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert n > 0 && t[0].lost == 0 && tr_class(t, 0) == "chat" && tr_find(t, "log") < 0 && tr_find(t, "settings.title") < 0;
  #assert coaxial_chatweb_asking(s) && coaxial_chatweb_ask(s) == 0 && cw_test_door(s) == "/api/chat/account";
  #assert t[0].nodes[tr_find(t, "composer")].tag == TG_TEXTAREA && tr_has(t, tr_find(t, "composer"), AT_FOCUS);
  #assert tr_attr_of(t, tr_find(t, "settings"), AT_LABEL) == "Settings" && tr_text_of(t, tr_find(t, "model.l")) == "Gemini 3.8 Flash";
  #assert tr_has(t, tr_find(t, "composer.send"), AT_DISABLED);
  cw_test_answer(s, 200, "{\"claude\":null}");
  #assert s[0].known && s[0].claude == CA_NONE && !coaxial_chatweb_asking(s);
  cw_test_type(s, "composer", "  \n ");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  cw_test_enter(s, "composer");
  #assert s[0].sends == 0 && (!coaxial_chatweb_asking(s) || cw_test_door(s) == "/api/auth/account?as=lines");   // only who is logged in, for the side
}

#test "a message goes into the transcript, the field clears, and Gemini is asked with the conversation" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  d := s[0].dom[..];
  cw_test_type(s, "composer", "  first\nline \"two\" \n");
  cw_test_enter(s, "composer");
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert s[0].sends == 1 && s[0].live && s[0].draft_n == 0 && dm_test_count(d, n, DC_VALUE) == 1;
  #assert tr_text_of(t, tr_find(t, "m.0.p")) == "first\nline \"two\"" && tr_attr_of(t, tr_find(t, "m.1"), AT_STATE) == "waiting";
  #assert tr_text_of(t, tr_find(t, "composer.send.l")) == "Stop" && !tr_has(t, tr_find(t, "composer.send"), AT_DISABLED);
  body := cw_test_body(s);
  #assert coaxial_chatweb_ask(s) > 0 && cw_test_door(s) == "/api/chat/complete";
  #assert cw_test_has(body, "\"model\":\"google/gemini-3.8-flash\"") && cw_test_has(body, "{\"role\":\"system\",\"content\":\"You are OpenAgents");
  #assert cw_test_has(body, "the model answering is Gemini 3.8 Flash (google/gemini-3.8-flash) on Google's Vertex AI.");
  #assert cw_test_has(body, "{\"role\":\"user\",\"content\":\"first\\nline \\\"two\\\"\"}") && cw_test_has(body, "\"stream\":true") && cw_test_has(body, "\"reasoning_effort\":\"low\"");
  #assert !cw_test_has(body, "assistant");
  coaxial_chatweb_asked(s);
  #assert !coaxial_chatweb_asking(s);
  // nothing more is taken while the answer is coming
  cw_test_type(s, "composer", "again");
  cw_test_enter(s, "composer");
  #assert s[0].sends == 1;
}

#test "the answer comes in pieces, split anywhere, and is Markdown when whole; the next message carries it" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  d := s[0].dom[..];
  cw_test_type(s, "composer", "hi");
  cw_test_enter(s, "composer");
  coaxial_chatweb_asked(s);
  cw_test_piece(s, 200, "data: {\"choices\":[{\"delta\":{\"content\":\"We are **Open\"}}]}\n\ndata: {\"choi");
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_attr_of(t, tr_find(t, "m.1"), AT_STATE) == "streaming" && tr_find(t, "m.1.copy") < 0;
  #assert tr_text_of(t, tr_find(t, "m.1.md.b0.0")) == "We are ";
  cw_test_piece(s, 200, "ces\":[{\"delta\":{\"content\":\"Agents**.\\n\\n- one\"}}]}\r\n\r\n");
  cw_test_piece(s, 200, "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":9,\"completion_tokens\":7}}\n\ndata: [DONE]\n\n");
  coaxial_chatweb_event(s, CW_END, 200, 0);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert !s[0].live && s[0].error_n == 0 && cw_text(s, 1) == "We are **OpenAgents**.\n\n- one";
  #assert !tr_has(t, tr_find(t, "m.1"), AT_STATE) && tr_find(t, "m.1.copy") > 0 && tr_find(t, "failed") < 0;
  #assert t[0].nodes[tr_find(t, "m.1.md.b0.1")].tag == TG_STRONG && tr_text_of(t, tr_find(t, "m.1.md.b1.i0.0")) == "one";
  #assert tr_text_of(t, tr_find(t, "composer.send.l")) == "Send" && tr_text_of(t, tr_find(t, "m.1.meta")) == "Gemini 3.8 Flash";
  cw_test_type(s, "composer", "and then?");
  cw_test_enter(s, "composer");
  #assert cw_test_has(cw_test_body(s), "{\"role\":\"user\",\"content\":\"hi\"},{\"role\":\"assistant\",\"content\":\"We are **OpenAgents**.\\n\\n- one\"},{\"role\":\"user\",\"content\":\"and then?\"}");
  // Copy copies the answer
  cw_test_press(s, "m.1.copy");
  #assert coaxial_chatweb_clip(s) == cw_text(s, 1).count && cw_copy_of("m.12.copy") == 12 && cw_copy_of("m.x.copy") < 0 && cw_copy_of("composer") < 0;
}

#test "Stop keeps what came; a refusal, a missing answer and the door's errors are said in words" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_type(s, "composer", "one");
  cw_test_enter(s, "composer");
  coaxial_chatweb_asked(s);
  cw_test_piece(s, 200, "data: {\"choices\":[{\"delta\":{\"content\":\"half an\"}}]}\n\n");
  n := coaxial_chatweb_frame(s, 0.016, true);
  cw_test_press(s, "composer.send");
  #assert !s[0].live && coaxial_chatweb_stop(s) && !coaxial_chatweb_stop(s) && cw_text(s, 1) == "half an";
  cw_test_piece(s, 200, "data: {\"choices\":[{\"delta\":{\"content\":\" answer\"}}]}\n\n");   // a late piece is not taken
  coaxial_chatweb_event(s, CW_END, 200, 0);
  #assert cw_text(s, 1) == "half an" && s[0].error_n == 0;
  // the door says no
  n = coaxial_chatweb_frame(s, 0.016, true);
  cw_test_type(s, "composer", "two");
  cw_test_enter(s, "composer");
  cw_test_answer(s, 401, "{\"error\":\"log in as an admin\"}");
  n = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert !s[0].live && tr_text_of(t, tr_find(t, "failed.t")) == "Log in as an admin to chat. The chat is for admins only for now." && tr_find(t, "m.3") < 0;
  // its own words for a limit
  cw_test_type(s, "composer", "three");
  cw_test_enter(s, "composer");
  #assert s[0].error_n == 0;
  cw_test_answer(s, 429, "{\"error\":\"today's requests are used up\"}");
  #assert cast(string) s[0].error[0..<s[0].error_n] == "today's requests are used up";
  // no connection, and a stream that ends with nothing
  cw_test_type(s, "composer", "four");
  cw_test_enter(s, "composer");
  cw_test_answer(s, 0, "");
  #assert cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "couldn't reach OpenAgents");
  cw_test_type(s, "composer", "five");
  cw_test_enter(s, "composer");
  // an answer that never came is not sent back to the model
  #assert !cw_test_has(cw_test_body(s), "\"content\":\"\"");
  cw_test_answer(s, 200, "data: {\"error\":{\"message\":\"the model is overloaded\",\"code\":503}}\n\n");
  #assert cast(string) s[0].error[0..<s[0].error_n] == "the model is overloaded";
}

#test "the menu offers the Gemini models, and Claude's only once an account is connected" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_press(s, "model");
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_text_of(t, tr_find(t, "model.0.t")) == "Gemini 3.8 Flash" && tr_text_of(t, tr_find(t, "model.1.t")) == "Gemini 4 Argon" && tr_text_of(t, tr_find(t, "model.2.t")) == "Gemini 4 Carbon";
  #assert tr_find(t, "model.3") < 0 && tr_find(t, "model.hint") > 0 && tr_attr_of(t, tr_find(t, "model.0"), AT_CURRENT) == "true";
  cw_test_press(s, "model.2");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].model == 2 && !s[0].menu && tr_find(t, "model.0") < 0 && tr_text_of(t, tr_find(t, "model.l")) == "Gemini 4 Carbon";
  #assert dm_test_count(s[0].dom[..], n, DC_FOCUS) == 1;   // the caret goes back to the field
  cw_test_type(s, "composer", "hello");
  cw_test_enter(s, "composer");
  #assert cw_test_has(cw_test_body(s), "\"model\":\"google/gemini-4-carbon\"") && cw_test_has(cw_test_body(s), "Gemini 4 Carbon (google/gemini-4-carbon)");
  // a connected account brings the Claude models
  g: [1] CwTest; c := g[0].s[..];
  cw_test_open(c, "{\"claude\":{\"kind\":\"oauth\",\"last4\":\"wxyz\",\"expired\":false}}");
  #assert c[0].claude == CA_TOKEN && cw_connected(c);
  cw_test_press(c, "model");
  n = coaxial_chatweb_frame(c, 0.016, true);
  #assert tr_text_of(c[0].tree[..], tr_find(c[0].tree[..], "model.5.t")) == "Claude Opus 5.5" && tr_find(c[0].tree[..], "model.hint") < 0;
  // an expired one doesn't
  e: [1] CwTest; x := e[0].s[..];
  cw_test_open(x, "{\"claude\":{\"kind\":\"api_key\",\"last4\":\"wxyz\",\"expired\":true}}");
  x[0].model = 5;
  #assert x[0].claude == CA_KEY && !cw_connected(x) && cw_model(x) == 0;
}

#test "Microcoder on Gemini needs no account: its message is a turn of the hosted agent, offered once the repo service is live" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_press(s, "model");
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert (tr_find(t, "model.6") >= 0) == CW_REPO_LIVE && tr_find(t, "model.3") < 0;
  cw_test_press(s, "model.6");
  #assert (s[0].model == CW_GEMINI_AGENT) == CW_REPO_LIVE;
  s[0].model = CW_GEMINI_AGENT;
  #assert cw_model(s) == CW_GEMINI_AGENT && cw_agent(s) == 0 && !cw_claude_model(CW_GEMINI_AGENT);
  cw_test_type(s, "composer", "where is rg_mint defined?");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/api/chat/send" && cw_test_body(s) == "{\"text\":\"where is rg_mint defined?\",\"model\":\"google/gemini-3.8-flash\"}";
}

// A run's calls by what each is called, a line each (in the page's scratch for a run).
cw_test_labels :: (s: [] ChatWeb, k: int) -> string {
  calls: [CQ_MOST] CqCall; n := cq_calls(cw_text(s, k), calls[..]); m := 0;
  for i: 0..<n { lb: [CQ_LABEL + CQ_ARG] u8; if i > 0 { m = kw_put(s[0].wbuf[..], m, "\n"); } m = kw_put(s[0].wbuf[..], m, cq_label(calls[i], lb[..])); }
  return cast(string) s[0].wbuf[0..<m];
}

#test "a Claude message is a turn of the hosted agent: sent, read each second with its tools, then answered" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":{\"kind\":\"oauth\",\"last4\":\"wxyz\",\"expired\":false}}");
  s[0].model = 5;
  cw_test_type(s, "composer", "what does chat.coax do?");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/api/chat/send" && cw_test_body(s) == "{\"text\":\"what does chat.coax do?\",\"model\":\"claude-opus-5-5\"}";
  cw_test_answer(s, 200, "{\"c\": 7, \"turn\": 31, \"model\": \"claude-opus-5-5\"}");
  #assert s[0].conv == 7 && s[0].turn == 31 && s[0].live && coaxial_chatweb_busy(s);
  n := coaxial_chatweb_frame(s, 0.1, true);
  #assert !coaxial_chatweb_asking(s);   // not yet a second
  for k: 0..<11 { n = coaxial_chatweb_frame(s, 0.1, true); }
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/api/chat/turn?t=31" && coaxial_chatweb_ask(s) == 0;
  cw_test_answer(s, 200, "{\"status\":\"running\",\"answer\":\"\",\"error\":\"\",\"working\":\"reading chat.coax\",\"tools\":[{\"name\":\"Read\",\"detail\":\"apps/openagents-web/chat.coax\"},{\"name\":\"Grep\",\"detail\":\"wc_ask\"}]}");
  n = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert s[0].live && s[0].ntools == 2 && tr_text_of(t, tr_find(t, "m.1.work")) == "reading chat.coax";
  // its tools as calls: what each does and on what, the newest the one it is at
  #assert tr_text_of(t, tr_find(t, "m.1.calls.c.0.l")) == "Read a file" && tr_text_of(t, tr_find(t, "m.1.calls.c.0.a")) == "apps/openagents-web/chat.coax";
  #assert tr_text_of(t, tr_find(t, "m.1.calls.c.1.l")) == "Search the code" && tr_find(t, "m.1.calls.c.1.g") > 0 && tr_find(t, "m.1.calls.c.0.g") < 0;
  // Stop asks the runner once, and the turn ends when it says so
  cw_test_press(s, "composer.send");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].stopping && cw_test_door(s) == "/api/chat/stop" && cw_test_body(s) == "{\"c\":\"7\"}" && tr_has(t, tr_find(t, "composer.send"), AT_DISABLED);
  cw_test_answer(s, 200, "{\"turn\":31}");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/api/chat/turn?t=31";
  cw_test_answer(s, 200, "{\"status\":\"running\",\"answer\":\"\",\"error\":\"\",\"working\":\"\",\"tools\":[]}");
  for k: 0..<12 { n = coaxial_chatweb_frame(s, 0.1, true); }
  #assert cw_test_door(s) == "/api/chat/turn?t=31" && coaxial_chatweb_asking(s);
  cw_test_answer(s, 200, "{\"status\":\"done\",\"answer\":\"It draws **/chat-gpu**.\",\"error\":\"\",\"working\":\"\",\"tools\":[{\"name\":\"Read\",\"detail\":\"a\"}]}");
  n = coaxial_chatweb_frame(s, 0.016, true);
  // its tools go above the answer as a run, closed to one line
  #assert !s[0].live && !s[0].stopping && s[0].turn == 0 && s[0].who[1] == CW_TOOL && cw_test_labels(s, 1) == "Read a file" && cw_text(s, 2) == "It draws **/chat-gpu**.";
  #assert tr_text_of(t, tr_find(t, "m.2.meta")) == "Claude Opus 5.5 · 1 tool" && tr_find(t, "m.2.copy") > 0 && tr_text_of(t, tr_find(t, "m.1.w.l")) == "Read a file";
  // the next one goes to the same conversation; a turn that fails says why
  cw_test_type(s, "composer", "and?");
  cw_test_enter(s, "composer");
  // the page was asking whether Coder is here: the message waits for that answer, then goes
  if cw_test_door(s) == "/local/sessions" { #assert s[0].send_due; cw_test_answer(s, 404, ""); }
  #assert cw_test_body(s) == "{\"c\":\"7\",\"text\":\"and?\",\"model\":\"claude-opus-5-5\"}";
  cw_test_answer(s, 200, "{\"c\": 7, \"turn\": 32}");
  for k: 0..<12 { n = coaxial_chatweb_frame(s, 0.1, true); }
  cw_test_answer(s, 200, "{\"status\":\"failed\",\"answer\":\"\",\"error\":\"Your token expired. Make a new one with claude setup-token and save it under KEY.\",\"working\":\"\",\"tools\":[]}");
  #assert !s[0].live && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "Your token expired");
  cw_test_type(s, "composer", "again");
  cw_test_enter(s, "composer");
  cw_test_answer(s, 409, "{\"error\":\"the agent is still answering; wait or press STOP\"}");
  #assert !s[0].live && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "still answering");
}

#test "the oldest messages go when there are too many, and the page says how many are not shown" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  for k: 0..<CW_MESSAGES {
    cw_add(s, "question", CW_YOU, 0);
    cw_add(s, "answer", CW_AGENT, 0);
  }
  s[0].dirty = true;
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert s[0].count <= CW_MESSAGES && s[0].count >= CW_MESSAGES - CW_MESSAGES / 4 && s[0].total == CW_MESSAGES * 2;
  gone := s[0].total - s[0].count;
  b1: [UI_ID] u8; b2: [UI_ID] u8; b3: [UI_ID] u8; b4: [UI_ID] u8;
  #assert tr_find(t, "m.0") < 0 && tr_find(t, tr_join(b1[..], "m.", gone - 1)) < 0 && tr_find(t, tr_join(b2[..], "m.", gone)) > 0;
  #assert tr_class(t, tr_find(t, tr_join(b3[..], "m.", s[0].total - 1))) == "msg-ai";
  #assert tr_text_of(t, tr_find(t, "earlier")) == tr_cat(b4[..], tr_join(b1[..], "", gone), " earlier messages are not shown") && t[0].lost == 0 && t[0].depth == 0;
}

// Coder answers on this machine: the account is read, then the sessions.
cw_test_local :: (s: [] ChatWeb, sessions: string) {
  cw_test_open(s, "{\"claude\":null}");
  for i: 0..<4 { b := coaxial_chatweb_frame(s, 0.1, true); }
  cw_test_answer(s, 200, sessions);
  b := coaxial_chatweb_frame(s, 0.016, true);
  // then this folder's Claude Code conversations
  if cw_test_door(s) == "/local/claude" { cw_test_answer(s, 200, CW_T_CLAUDE); }
  b = coaxial_chatweb_frame(s, 0.016, true);
}
CW_T_CLAUDE :: "{\"live\":[{\"id\":\"7fe255eb-ec54-4f77-b7b3-64252ee8d7ff\",\"busy\":true},{\"id\":\"ffffffff-0000-4f77-b7b3-64252ee8d7ff\",\"busy\":false}],\"sessions\":[{\"session_id\":\"7fe255eb-ec54-4f77-b7b3-64252ee8d7ff\",\"path\":\"/p\",\"title\":\"Show notes\"},{\"session_id\":\"0bf9aebd-0000-4f77-b7b3-64252ee8d7ff\",\"title\":\"Everglade\"}]}";
CW_T_SESSIONS :: "[{\"id\":\"20261112-042601-123\",\"engine\":\"claude\",\"state\":\"running\",\"turns\":1,\"steps\":4,\"started_us\":1,\"cwd\":\"/w\",\"task\":\"fix the build\\nand more\"},{\"id\":\"20261111-010101-001\",\"engine\":\"microcoder\",\"state\":\"finished\",\"turns\":2,\"steps\":9,\"started_us\":1,\"cwd\":\"/w\",\"task\":\"add a test\"}]";

#test "where Coder answers, its sessions are listed beside the chat and its agents are in the menu; elsewhere neither shows" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  for i: 0..<4 { b := coaxial_chatweb_frame(s, 0.1, true); }
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/sessions" && coaxial_chatweb_ask(s) == 0;
  cw_test_answer(s, 404, "not found");
  for i: 0..<40 { b := coaxial_chatweb_frame(s, 0.1, true); }
  #assert s[0].local == -1 && !coaxial_chatweb_asking(s) && tr_find(s[0].tree[..], "side") >= 0 && tr_find(s[0].tree[..], "side.run") < 0;   // the side, with no sessions in it
  cw_test_press(s, "model"); b := coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_find(s[0].tree[..], "model.0") >= 0 && tr_find(s[0].tree[..], "model.6") < 0 && tr_find(s[0].tree[..], "model.7") < 0 && tr_find(s[0].tree[..], "agent") < 0;

  tl: [1] CwTest; l := tl[0].s[..];
  cw_test_local(l, CW_T_SESSIONS);
  t := l[0].tree[..];
  #assert l[0].local == 1 && l[0].ns == 2 && tr_find(t, "side") >= 0 && tr_find(t, "side.new") >= 0;
  #assert tr_text_of(t, tr_find(t, "s.0.t")) == "fix the build" && tr_text_of(t, tr_find(t, "s.0.m")) == "claude" && tr_text_of(t, tr_find(t, "s.1.m")) == "microcoder";
  #assert tr_text_of(t, tr_find(t, "side.run.t")) == "Running" && tr_text_of(t, tr_find(t, "side.recent.t")) == "Recent" && tr_attr_of(t, tr_find(t, "s.0"), AT_STATE) == "busy" && tr_find(t, "s.0.busy") >= 0 && tr_find(t, "s.1.busy") < 0;
  // a Claude Code conversation open in a terminal here is running too, and turns while it is busy; one not open is under Claude Code
  #assert l[0].nc == 2 && l[0].copen[0] == 2 && l[0].copen[1] == 0 && tr_find(t, "c.0.busy") >= 0 && tr_find(t, "c.1.busy") < 0;
  #assert tr_find(t, "c.0") < tr_find(t, "side.claude") && tr_find(t, "side.claude") < tr_find(t, "c.1");
  // two short menus: the agent, and that agent's models
  cw_test_press(l, "agent"); b = coaxial_chatweb_frame(l, 0.016, true);
  #assert tr_find(t, "agent.0") >= 0 && tr_find(t, "agent.4") >= 0 && tr_text_of(t, tr_find(t, "agent.4.t")) == "Microcoder" && tr_find(t, "model.0") < 0;
  cw_test_press(l, "agent.4"); b = coaxial_chatweb_frame(l, 0.016, true);
  #assert l[0].model == 10 && cw_agent(l) == 4 && !l[0].amenu && tr_text_of(t, tr_find(t, "agent.l")) == "Microcoder" && tr_text_of(t, tr_find(t, "model.l")) == "Gemini 3.8 Flash";
  cw_test_press(l, "model"); b = coaxial_chatweb_frame(l, 0.016, true);
  #assert tr_find(t, "lm.0") >= 0 && tr_find(t, "lm.2") >= 0 && tr_find(t, "lm.3") < 0 && tr_find(t, "model.0") < 0;
  cw_test_press(l, "lm.2"); b = coaxial_chatweb_frame(l, 0.016, true);
  #assert cw_lm(l, 4) == 2 && tr_text_of(t, tr_find(t, "model.l")) == "Gemini 4 Carbon";
  cw_test_type(l, "composer", "go");
  cw_test_enter(l, "composer");
  if cw_test_door(l) != "/local/run" { cw_test_answer(l, 200, ifx cw_test_door(l) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); }
  #assert cw_test_door(l) == "/local/run" && cw_test_body(l) == "{\"task\":\"go\",\"engine\":\"micro\",\"model\":\"gemini-4-carbon\"}";
  // back to OpenAgents: the model it had
  tm: [1] CwTest; m := tm[0].s[..];
  cw_test_local(m, CW_T_SESSIONS);
  cw_test_press(m, "model"); b = coaxial_chatweb_frame(m, 0.016, true);
  cw_test_press(m, "model.2");
  cw_test_press(m, "agent"); b = coaxial_chatweb_frame(m, 0.016, true); cw_test_press(m, "agent.2");
  #assert m[0].model == 8 && cw_agent(m) == 2;
  cw_test_press(m, "agent"); b = coaxial_chatweb_frame(m, 0.016, true); cw_test_press(m, "agent.0");
  #assert m[0].model == 2 && cw_agent(m) == 0;
  #assert cw_number("s.12", "s.") == 12 && cw_number("s.0", "s.") == 0 && cw_number("s.", "s.") == -1 && cw_number("s.1x", "s.") == -1 && cw_number("side.new", "s.") == -1 && cw_number("s.1234", "s.") == -1;
}

CW_T_AGENTS :: "{\"agents\":[{\"engine\":\"claude\",\"ready\":true,\"why\":\"\"},{\"engine\":\"codex\",\"ready\":false,\"why\":\"Codex isn't installed here.\"},{\"engine\":\"antigravity\",\"ready\":false,\"why\":\"\"},{\"engine\":\"micro\",\"ready\":true,\"why\":\"\"}]}";

// A Claude Code turn that sets twelve foe plans through our realm tools (#13481), as Coder's log has it: the
// first piece ends with the last plan still running, the second answers it, replies and ends.

#test "twelve foe plans in a row are one group named from the command table; a refusal says why; the finished turn is one line" {
  plans := "{\"kind\":\"session\",\"id\":\"x\",\"engine\":\"claude\"}\n{\"kind\":\"user\",\"text\":\"give the foes in splice their plans\"}\n{\"kind\":\"tool\",\"label\":\"ToolSearch\",\"tool\":\"tool\",\"name\":\"ToolSearch\",\"id\":\"t0\",\"input\":{\"query\":\"select:mcp__openagents__realm_world_plan\"}}\n{\"kind\":\"result\",\"text\":\"Found 1 tool\",\"error\":false,\"id\":\"t0\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world\",\"id\":\"t1\",\"input\":{\"slug\":\"splice\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"slug\\\":\\\"splice\\\",\\\"things\\\":14}\",\"error\":false,\"id\":\"t1\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_foes\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_foes\",\"id\":\"t2\",\"input\":{\"slug\":\"splice\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"foes\\\":[1,2,3]}\",\"error\":false,\"id\":\"t2\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t3\",\"input\":{\"slug\":\"splice\",\"foe\":1,\"daytime\":\"dawn\",\"act\":\"patrol\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t3\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t4\",\"input\":{\"slug\":\"splice\",\"foe\":1,\"daytime\":\"day\",\"act\":\"guard\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t4\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t5\",\"input\":{\"slug\":\"splice\",\"foe\":1,\"daytime\":\"dusk\",\"act\":\"rest\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t5\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t6\",\"input\":{\"slug\":\"splice\",\"foe\":1,\"daytime\":\"night\",\"act\":\"hunt\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t6\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t7\",\"input\":{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"dawn\",\"act\":\"patrol\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t7\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t8\",\"input\":{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"day\",\"act\":\"guard\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t8\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t9\",\"input\":{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"dusk\",\"act\":\"rest\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":false,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"refused\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\",\\\"code\\\":\\\"realm-authoring.diagnostic.edit-refused.v1\\\",\\\"retry\\\":false,\\\"words\\\":\\\"foe 2 has no route for the dusk patrol\\\",\\\"edit\\\":1}}\",\"error\":true,\"id\":\"t9\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t10\",\"input\":{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"night\",\"act\":\"hunt\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t10\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t11\",\"input\":{\"slug\":\"splice\",\"foe\":3,\"daytime\":\"dawn\",\"act\":\"patrol\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t11\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t12\",\"input\":{\"slug\":\"splice\",\"foe\":3,\"daytime\":\"day\",\"act\":\"guard\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t12\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t13\",\"input\":{\"slug\":\"splice\",\"foe\":3,\"daytime\":\"dusk\",\"act\":\"rest\"}}\n{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t13\"}\n{\"kind\":\"tool\",\"label\":\"mcp__openagents__realm_world_plan\",\"tool\":\"mcp\",\"name\":\"mcp__openagents__realm_world_plan\",\"id\":\"t14\",\"input\":{\"slug\":\"splice\",\"foe\":3,\"daytime\":\"night\",\"act\":\"hunt\"}}\n";
  plans_end := "{\"kind\":\"result\",\"text\":\"{\\\"ok\\\":true,\\\"result\\\":{\\\"schema\\\":\\\"realm.result.v1\\\",\\\"state\\\":\\\"done\\\",\\\"verb\\\":\\\"world-plan\\\",\\\"realm\\\":\\\"splice\\\",\\\"effect\\\":\\\"write\\\",\\\"rev\\\":5,\\\"build\\\":[1,1,2,1],\\\"page\\\":\\\"/worlds/splice\\\",\\\"key\\\":\\\"k-1\\\"}}\",\"error\":false,\"id\":\"t14\"}\n{\"kind\":\"reply\",\"text\":\"Every foe in splice has a plan for each part of the day. Foe 2's dusk patrol was refused: it has no route yet.\"}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":5,\"steps\":15}\n";
  ts: [1] CwTest; s := ts[0].s[..]; piece: [12288] u8; num: [24] u8;
  cw_test_local(s, CW_T_SESSIONS);
  s[0].model = 7;
  cw_test_type(s, "composer", "give the foes in splice their plans");
  cw_test_enter(s, "composer");
  cw_test_answer(s, 200, "20261113-050000-001\n");
  b := coaxial_chatweb_frame(s, 0.016, true);
  for i: 0..<40 {
    if coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/log?id=20261113-050000-001&after=0" { break; }
    if coaxial_chatweb_asking(s) { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/sessions" then CW_T_SESSIONS else ""); }
    b = coaxial_chatweb_frame(s, 0.1, true);
  }
  n := kw_put(piece[..], 0, "{\"next\":9000,\"size\":9000}\n"); n = kw_put(piece[..], n, plans);
  cw_test_answer(s, 200, cast(string) piece[0..<n]);
  calls: [CQ_MOST] CqCall;
  #assert s[0].count == 2 && s[0].who[1] == CW_TOOL && cq_calls(cw_text(s, 1), calls[..]) == 15 && calls[9].state == KW_REFUSED && calls[14].state == KW_RUN && s[0].lrun;
  b = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  // live: the three reads, then the plans as one group with their count and the newest plan's words, and the line
  // under the transcript names the plan it is at
  #assert tr_text_of(t, tr_find(t, "m.1.c.0.l")) == "Look up tools" && tr_text_of(t, tr_find(t, "m.1.c.1.l")) == "Read the world splice" && tr_text_of(t, tr_find(t, "m.1.c.1.a")) == "splice";
  #assert tr_text_of(t, tr_find(t, "m.1.g.3.l")) == "Set foe plans" && tr_text_of(t, tr_find(t, "m.1.g.3.n")) == "12" && tr_text_of(t, tr_find(t, "m.1.g.3.a")) == "Set foe 3's night plan: hunt";
  #assert tr_text_of(t, tr_find(t, "l.work.l")) == "Set foe 3's night plan: hunt" && tr_find(t, "m.1.c.9") < 0;
  cw_test_press(s, "m.1.g.3");
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_text_of(t, tr_find(t, "m.1.c.9.l")) == "Set foe 2's dusk plan: rest" && tr_attr_of(t, tr_find(t, "m.1.c.9.row"), AT_STATE) == "refused";
  #assert tr_text_of(t, tr_find(t, "m.1.c.9.why")) == "foe 2 has no route for the dusk patrol. Trying again won't help." && tr_find(t, "m.1.c.14.g") > 0;
  // a row opens onto what it sent and what came back; Copy takes all of what came back
  cw_test_press(s, "m.1.c.9");
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_text_of(t, tr_find(t, "m.1.c.9.in")) == calls[9].input && tr_find(t, "m.1.c.9.out") > 0;
  cw_test_press(s, "m.1.c.9.copy");
  #assert cast(string) s[0].clip[0..<s[0].clip_n] == calls[9].output;
  // the rest: the last plan's answer, the reply and the end; the run is one line above the answer
  for i: 0..<40 {
    b = coaxial_chatweb_frame(s, 0.1, true);
    if coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/log?id=20261113-050000-001&after=9000" { break; }
    if coaxial_chatweb_asking(s) { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/sessions" then CW_T_SESSIONS else ""); }
  }
  n = kw_put(piece[..], 0, "{\"next\":9900,\"size\":9900}\n"); n = kw_put(piece[..], n, plans_end);
  cw_test_answer(s, 200, cast(string) piece[0..<n]);
  #assert s[0].count == 3 && s[0].who[2] == CW_AGENT && !s[0].lrun && cq_calls(cw_text(s, 1), calls[..]) == 15 && calls[14].state == KW_DONE;
  cw_test_press(s, "m.1.c.9");   // closed again, so the run's line is all that shows once it closes
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_find(t, "l.work") < 0 && tr_text_of(t, tr_find(t, "m.1.w.l")) == "Set foe plans ×12, Look up tools, and 2 more tools" && tr_text_of(t, tr_find(t, "m.1.w.n")) == tr_join(num[..], "", 15);
  #assert tr_attr_of(t, tr_find(t, "m.1.w.grp"), AT_STATE) == "refused" && tr_find(t, "m.1.g.3") < 0 && tr_find(t, "m.2.md") > 0;
}

#test "a message to an agent on this machine starts a Coder session, and its log fills the transcript" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  s[0].model = 7;
  cw_test_type(s, "composer", "fix it");
  cw_test_enter(s, "composer");
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/run" && cw_test_body(s) == "{\"task\":\"fix it\",\"engine\":\"claude\",\"model\":\"claude-haiku-5-5\"}";
  #assert s[0].count == 1 && s[0].lrun && s[0].echo && !s[0].live;
  cw_test_answer(s, 200, "20261112-050000-001\n");
  #assert cw_sel(s) == "20261112-050000-001" && s[0].log_next == 0;
  b := coaxial_chatweb_frame(s, 0.016, true);
  // its log isn't written yet: that is no error, and it is read again
  cw_test_answer(s, 404, "");
  #assert s[0].lrun && s[0].error_n == 0 && s[0].log_miss == 1;
  for i: 0..<14 {
    b = coaxial_chatweb_frame(s, 0.1, true);
    if coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/sessions" { cw_test_answer(s, 200, CW_T_SESSIONS); }
  }
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/log?id=20261112-050000-001&after=0";
  cw_test_answer(s, 200, "{\"next\":300,\"size\":300}\n{\"kind\":\"session\",\"id\":\"x\",\"engine\":\"claude\"}\n{\"kind\":\"user\",\"text\":\"fix it\"}\n{\"kind\":\"tool\",\"label\":\"Bash(ls)\"}\n{\"kind\":\"result\",\"text\":\"a\"}\n{\"kind\":\"tool\",\"label\":\"Read(a.md)\\nmore\"}\n{\"kind\":\"diff\",\"path\":\"a.md\",\"adds\":1,\"dels\":0}\n");
  // the person's message is not shown twice, and the tool calls are one run
  #assert s[0].count == 2 && s[0].who[1] == CW_TOOL && cw_test_labels(s, 1) == "Bash(ls)\nRead(a.md)\nEdit a.md" && s[0].lrun && s[0].log_next == 300 && !s[0].echo;
  b = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  // a call with no answer yet is running, and the line under the transcript names it
  #assert tr_text_of(t, tr_find(t, "l.work.l")) == "Read(a.md)" && tr_text_of(t, tr_find(t, "m.1.c.1.l")) == "Read(a.md)" && tr_find(t, "m.1.c.1.g") > 0 && tr_find(t, "m.1.c.0.g") < 0;
  #assert tr_text_of(t, tr_find(t, "composer.send.l")) == "Stop";
  // read again a second later, from where the last piece ended
  for i: 0..<14 {
    b = coaxial_chatweb_frame(s, 0.1, true);
    if coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/sessions" { cw_test_answer(s, 200, CW_T_SESSIONS); }
  }
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/log?id=20261112-050000-001&after=300";
  cw_test_answer(s, 200, "{\"next\":420,\"size\":420}\n{\"kind\":\"reply\",\"text\":\"Fixed.\"}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":5,\"steps\":2}\n");
  #assert s[0].count == 3 && s[0].who[2] == CW_AGENT && cw_text(s, 2) == "Fixed." && !s[0].lrun;
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_find(t, "l.work") < 0;
  // a second message goes to the same session; an ended one continues in a new session, which is then shown
  for i: 0..<40 { b = coaxial_chatweb_frame(s, 0.1, true); if coaxial_chatweb_asking(s) { cw_test_answer(s, 200, CW_T_SESSIONS); } }
  cw_test_type(s, "composer", "and the docs");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/local/send" && cw_test_body(s) == "{\"id\":\"20261112-050000-001\",\"message\":\"and the docs\"}";
  cw_test_answer(s, 200, "{\"id\":\"20261112-050100-002\"}");
  #assert cw_sel(s) == "20261112-050100-002" && s[0].log_next == 0 && s[0].count == 4 && s[0].echo;
  // a conversation open in a Claude Code window: Coder refuses, and the message goes back in the field
  for i: 0..<40 { b = coaxial_chatweb_frame(s, 0.1, true); if coaxial_chatweb_asking(s) { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); } }
  cw_test_answer(s, 200, "{\"next\":60,\"size\":60}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":5,\"steps\":2}\n");
  cw_test_type(s, "composer", "and tests");
  cw_test_enter(s, "composer");
  if cw_test_door(s) != "/local/send" { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); }
  #assert cw_test_door(s) == "/local/send";
  before := s[0].count;
  cw_test_answer(s, 409, "This conversation is open in a Claude Code window. Type there, or close it there to continue it here.");
  #assert s[0].count == before - 1 && cast(string) s[0].draft[0..<s[0].draft_n] == "and tests" && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "open in a Claude Code window");
}

#test "/goal goes to Claude Code as typed, and the page shows the goal while the session works toward it" {
  #assert cw_goal_of("/goal tests pass") == CW_GOAL_SET && cw_goal_of("/goal") == CW_GOAL_ASK && cw_goal_of("/goal  \n") == CW_GOAL_ASK;
  #assert cw_goal_of("/goal clear") == CW_GOAL_CLEAR && cw_goal_of("/goal cancel ") == CW_GOAL_CLEAR && cw_goal_of("/goal clear the cache") == CW_GOAL_SET;
  #assert cw_goal_of("/goals") == CW_GOAL_NONE && cw_goal_of("goal x") == CW_GOAL_NONE && cw_goal_of("/goa") == CW_GOAL_NONE && cw_goal_of("") == CW_GOAL_NONE;
  #assert cw_goal_rest("/goal \n every open issue is closed \n") == "every open issue is closed" && cw_goal_rest("/go") == "";
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  // Microcoder doesn't run goals: nothing is sent, and the page says where they run
  s[0].model = 10;
  cw_test_type(s, "composer", "/goal all tests pass");
  cw_test_enter(s, "composer");
  #assert !coaxial_chatweb_asking(s) && s[0].count == 0 && s[0].goal_n == 0 && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "Only Claude Code runs /goal");
  b0 := coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_find(s[0].tree[..], "failed") >= 0;
  // Claude Code gets it word for word
  s[0].model = 7;
  cw_test_enter(s, "composer");
  if cw_test_door(s) != "/local/run" { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); }
  #assert cw_test_door(s) == "/local/run" && cw_test_body(s) == "{\"task\":\"/goal all tests pass\",\"engine\":\"claude\",\"model\":\"claude-haiku-5-5\"}";
  #assert cast(string) s[0].goal[0..<s[0].goal_n] == "all tests pass";
  cw_test_answer(s, 200, "20261112-060000-001\n");
  b := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_text_of(t, tr_find(t, "l.work.l")) == "Working toward the goal: all tests pass";
  // a session opened from its log: the goal is what its messages last set
  tv: [1] CwTest; v := tv[0].s[..];
  cw_test_local(v, CW_T_SESSIONS);
  cw_test_press(v, "s.0");
  b = coaxial_chatweb_frame(v, 0.016, true);
  #assert cw_test_door(v) == "/local/log?id=20261112-042601-123&after=-1";
  cw_test_answer(v, 200, "{\"next\":90,\"size\":90}\n{\"kind\":\"user\",\"text\":\"/goal docs build\"}\n{\"kind\":\"user\",\"text\":\"/goal\"}\n");
  #assert cast(string) v[0].goal[0..<v[0].goal_n] == "docs build";
  cw_log_read(v, "{\"next\":120,\"size\":120}\n{\"kind\":\"user\",\"text\":\"/goal clear\"}\n");
  #assert v[0].goal_n == 0;
  // a goal sent to a Microcoder session is refused too
  cw_test_press(v, "s.1");
  cw_test_type(v, "composer", "/goal done");
  cw_test_enter(v, "composer");
  #assert cw_test_has(cast(string) v[0].error[0..<v[0].error_n], "Only Claude Code runs /goal") && v[0].goal_n == 0;
}

#test "a session chosen beside the chat is shown from its log's end; Stop asks Coder to stop it" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  cw_test_press(s, "s.0");
  #assert cw_sel(s) == "20261112-042601-123" && s[0].model == 7 && s[0].count == 0;
  b := coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/local/log?id=20261112-042601-123&after=-1";
  cw_test_answer(s, 200, "{\"next\":90,\"size\":90}\n{\"kind\":\"user\",\"text\":\"fix the build\"}\n{\"kind\":\"reply\",\"text\":\"On it.\"}\n");
  #assert s[0].count == 2 && s[0].who[0] == CW_YOU && s[0].lrun;
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "s.0"), AT_CURRENT) == "true";
  cw_test_press(s, "composer.send");
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/local/stop" && cw_test_body(s) == "{\"id\":\"20261112-042601-123\"}";
  cw_test_answer(s, 200, "stopped");
  b = coaxial_chatweb_frame(s, 0.016, true);
  cw_test_answer(s, 200, "{\"next\":140,\"size\":140}\n{\"kind\":\"end\",\"ending\":\"stopped\",\"ms\":5,\"steps\":2}\n");
  #assert !s[0].lrun && s[0].error_n == 0;
  // the microcoder session picks Microcoder; a new chat empties the transcript
  cw_test_press(s, "s.1");
  #assert s[0].model == 10 && cw_sel(s) == "20261111-010101-001";
  cw_test_answer(s, 200, "x");
  cw_test_press(s, "side.new");
  #assert s[0].sel_n == 0 && s[0].count == 0;
}

#test "beside the chat: what is running, then only the few most recent that ended, and never Coder's test agent" {
  ts: [1] CwTest; s := ts[0].s[..];
  list: [8192] u8; n := cw_put(list[..], 0, "[");
  num: [24] u8;
  for k: 0..<14 {
    if k > 0 { n = cw_put(list[..], n, ","); }
    n = cw_put(list[..], n, "{\"id\":\"20261112-0000"); n = cw_put(list[..], n, tr_join(num[..], "", 10 + k));
    n = cw_put(list[..], n, ifx k == 1 then "\",\"engine\":\"echo\"" else "\",\"engine\":\"codex\"");
    n = cw_put(list[..], n, ifx k == 12 then ",\"state\":\"running\"" else ",\"state\":\"finished\"");
    n = cw_put(list[..], n, ",\"task\":\"t\"}");
  }
  n = cw_put(list[..], n, "]");
  cw_test_local(s, cast(string) list[0..<n]);
  t := s[0].tree[..];
  #assert s[0].ns == 14 && tr_find(t, "s.12") >= 0 && tr_find(t, "s.0") >= 0 && tr_find(t, "s.1") < 0;   // running, newest, not echo
  #assert tr_find(t, "s.8") >= 0 && tr_find(t, "s.9") < 0 && tr_find(t, "s.13") < 0;   // eight that ended: 0, 2..8
}

#test "a Claude Code conversation chosen beside the chat is opened as a Coder session, and a message goes on in it" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  t := s[0].tree[..];
  #assert s[0].nc == 2 && tr_text_of(t, tr_find(t, "side.claude.t")) == "Claude Code" && tr_text_of(t, tr_find(t, "c.0.t")) == "Show notes" && tr_text_of(t, tr_find(t, "c.1.t")) == "Everglade";
  cw_test_press(s, "c.0");
  b := coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/local/import" && cw_test_body(s) == "{\"ref\":\"7fe255eb-ec54-4f77-b7b3-64252ee8d7ff\"}";
  cw_test_answer(s, 200, "{\"id\":\"20261111-155359-510\"}");
  #assert cw_sel(s) == "20261111-155359-510" && s[0].log_next == -1 && s[0].model == CW_HOSTED;
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/local/log?id=20261111-155359-510&after=-1" && tr_attr_of(t, tr_find(t, "c.0"), AT_CURRENT) == "true";
  cw_test_answer(s, 200, "{\"next\":60,\"size\":60}\n{\"kind\":\"reply\",\"text\":\"Done.\"}\n{\"kind\":\"end\",\"ending\":\"finished\"}\n");
  #assert s[0].count == 1 && !s[0].lrun && s[0].csize == 60;
  // it is copied again every few seconds: the same size changes nothing, a longer one is shown afresh
  for i: 0..<45 {
    b = coaxial_chatweb_frame(s, 0.1, true);
    if !coaxial_chatweb_asking(s) { continue; }
    if cw_test_door(s) == "/local/import" { break; }
    cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS);
  }
  #assert cw_test_door(s) == "/local/import";
  cw_test_answer(s, 200, "{\"id\":\"20261111-155359-510\"}");
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert cw_test_door(s) == "/local/log?id=20261111-155359-510&after=-1" && s[0].watching;
  cw_test_answer(s, 200, "{\"next\":60,\"size\":60}\n{\"kind\":\"reply\",\"text\":\"Done.\"}\n{\"kind\":\"end\",\"ending\":\"finished\"}\n");
  #assert s[0].count == 1 && s[0].total == 1;
  s[0].watch_at = s[0].time - CW_CL_LIVE;
  for i: 0..<6 { b = coaxial_chatweb_frame(s, 0.016, true); if coaxial_chatweb_asking(s) && cw_test_door(s) != "/local/import" { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); } }
  cw_test_answer(s, 200, "{\"id\":\"20261111-155359-510\"}");
  b = coaxial_chatweb_frame(s, 0.016, true);
  cw_test_answer(s, 200, "{\"next\":90,\"size\":90}\n{\"kind\":\"reply\",\"text\":\"Done.\"}\n{\"kind\":\"reply\",\"text\":\"More.\"}\n{\"kind\":\"end\",\"ending\":\"finished\"}\n");
  #assert s[0].count == 2 && s[0].total == 2 && cw_text(s, 1) == "More." && s[0].csize == 90;
  cw_test_type(s, "composer", "go on");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/local/send" && cw_test_body(s) == "{\"id\":\"20261111-155359-510\",\"message\":\"go on\"}";
  // one that can't be opened says so
  tb: [1] CwTest; f := tb[0].s[..];
  cw_test_local(f, CW_T_SESSIONS);
  cw_test_press(f, "c.1"); b = coaxial_chatweb_frame(f, 0.016, true);
  cw_test_answer(f, 500, "no");
  #assert f[0].error_n > 0 && f[0].csel_n == 0 && f[0].sel_n == 0;
}

#test "a request to Coder that is never answered is given up, and the page goes on" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  cw_test_press(s, "s.0");
  b := coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].flight == CF_LOG;
  coaxial_chatweb_asked(s);
  for i: 0..<130 { b = coaxial_chatweb_frame(s, 0.1, true); if s[0].flight != CF_LOG { break; } }
  #assert s[0].flight == CF_NONE && coaxial_chatweb_stop(s) && s[0].log_due;
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].flight == CF_LOG && cw_test_door(s) == "/local/log?id=20261112-042601-123&after=-1";
}

#test "Claude Code's models are named, never \"Default\": it starts on Haiku 5.5, the one chosen goes with the message, and this browser keeps it" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  s[0].model = CW_HOSTED;
  b := coaxial_chatweb_frame(s, 0.016, true);
  cw_test_press(s, "model"); b = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_text_of(t, tr_find(t, "model.l")) == "Haiku 5.5" && tr_text_of(t, tr_find(t, "lm.0.t")) == "Opus 5.5" && tr_text_of(t, tr_find(t, "lm.1.t")) == "Fable 5.2" && tr_text_of(t, tr_find(t, "lm.3.t")) == "Haiku 5.5" && tr_find(t, "lm.4") < 0;
  // no agent's list has a "Default"
  names := CW_LM_NAMES; for i: 0..<20 { #assert names[i] != "Default"; }
  cw_test_press(s, "lm.1");
  cw_test_type(s, "composer", "go");
  cw_test_enter(s, "composer");
  if cw_test_door(s) != "/local/run" { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/claude" then CW_T_CLAUDE else CW_T_SESSIONS); }
  #assert cw_test_body(s) == "{\"task\":\"go\",\"engine\":\"claude\",\"model\":\"claude-fable-5-2\"}";
  // the pick is kept in this browser, and a page that starts with it starts on it
  #assert coaxial_chatweb_keep_len(s) == 14 && cast(string) s[0].keep[0..<14] == "local=on&lm1=1";
  #assert cw_kept_lm("local=on&lm1=1", 1) == 2 && cw_kept_lm("local=on&lm1=1", 2) == 0 && cw_kept_lm("lm1=", 1) == 0 && cw_kept_lm("lm3=2&lm1=0", 1) == 1;
  ks: [1] CwTest; k := ks[0].s[..];
  w := "local=on&lm1=1"; for i: 0..<w.count { k[0].inbox[i] = w[i]; }
  coaxial_chatweb_event(k, CW_KEPT, 0, w.count);
  #assert cw_lm(k, 1) == 1 && cw_lm(k, 2) == 0;
}

// ---- in the editor (E9, #13418): the world goes with each turn, and a hosted turn may plan

CW_T_WORLD :: "world.turn.v1 splice dev 7 2\nhere 420 -75\nk 1001 Cargo crate\nk 1002 Parked rover\ne 1 1001 350 -1200 90\ne 2 1002 -40 600 -179\n";
cw_test_world :: (s: [] ChatWeb, wire: string) {
  for i: 0..<wire.count { s[0].inbox[i] = wire[i]; }
  coaxial_chatweb_event(s, CW_WORLD, 0, wire.count);
}
#test "the editor tells the conversation its world, and bytes that are not a world mean none" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  #assert s[0].wwire_n == 0;
  cw_test_world(s, CW_T_WORLD);
  #assert s[0].wwire_n == CW_T_WORLD.count && s[0].world[0].sel == 2 && s[0].world[0].here && s[0].world[0].nt == 2;
  n := coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "world.seen")) == "The agent sees this world, \"this\" is Parked rover 2 and \"here\" is the spot you tapped.";
  cw_test_world(s, "world.turn.v1 splice dev 7 0\n");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "world.seen")) == "The agent sees this world.";
  cw_test_world(s, "no world");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].wwire_n == 0 && tr_find(s[0].tree[..], "world.seen") < 0;
}
#test "in the editor a message to an agent on this machine is followed by the world, the selection and the point tapped; the transcript shows what was typed" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_local(s, CW_T_SESSIONS);
  cw_test_world(s, CW_T_WORLD);
  s[0].model = 7;
  cw_test_type(s, "composer", "move this here");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/local/run" && cw_test_has(cw_test_body(s), "{\"task\":\"move this here\\n\\n[The editor is open on the world splice, dev lane, revision 7. Selected: thing 2, Parked rover, at x -40 z 600 cm. Here, the point last tapped: x 420 z -75 cm.");
  #assert s[0].count == 1 && cw_text(s, 0) == "move this here";
}
#test "in the editor a hosted agent's turn is told the world after the message" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":{\"kind\":\"oauth\",\"last4\":\"wxyz\",\"expired\":false}}");
  cw_test_world(s, "world.turn.v1 splice live 3 0\n");
  s[0].model = 5;
  cw_test_type(s, "composer", "what is here?");
  cw_test_enter(s, "composer");
  #assert cw_test_door(s) == "/api/chat/send" && cw_test_body(s) == "{\"text\":\"what is here?\\n\\n[The editor is open on the world splice, live lane, revision 3. Nothing is selected. Read and change it with the realm world tools.]\",\"model\":\"claude-opus-5-5\"}";
  #assert cw_text(s, 0) == "what is here?";
}
cw_test_planned :: (s: [] ChatWeb, content: string) {
  body: [4096] u8;
  n := json_raw(body[..], 0, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":"); n = json_write_string(body[..], n, content);
  n = json_raw(body[..], n, "},\"finish_reason\":\"stop\"}]}");
  cw_test_answer(s, 200, cast(string) body[0..<n]);
}
#test "in the editor a Gemini turn answers under the world tools' schema: talk is the answer; an edit shows its steps, hands the editor a plan and says what it did" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_world(s, CW_T_WORLD);
  cw_test_type(s, "composer", "what stands here?");
  cw_test_enter(s, "composer");
  body := cw_test_body(s);
  #assert s[0].flight == CF_PLAN && cw_test_door(s) == "/api/chat/complete" && s[0].live;
  #assert cw_test_has(body, "\"json_schema\":{\"name\":\"world_turn\"") && cw_test_has(body, "\"enum\":[\"place\",\"move\",\"turn\",\"size\",\"remove\",\"undo\",\"redo\"]") && cw_test_has(body, "\"stream\":false");
  #assert cw_test_has(body, "- place: a new thing") && cw_test_has(body, "world.turn.v1 splice dev 7 2\\nhere 420 -75\\nk 1001 Cargo crate") && cw_test_has(body, "what stands here?");
  cw_test_planned(s, "{\"route\":\"talk\",\"say\":\"A crate and a rover.\",\"steps\":[]}");
  #assert !s[0].live && s[0].count == 2 && cw_text(s, 1) == "A crate and a rover." && coaxial_chatweb_act_kind(s) == 0 && s[0].error_n == 0;
  cw_test_type(s, "composer", "put a crate here and take the rover away");
  cw_test_enter(s, "composer");
  cw_test_planned(s, "{\"route\":\"edit\",\"say\":\"We put a crate there and took the rover away.\",\"steps\":[{\"tool\":\"place\",\"kind\":1001,\"id\":0,\"x\":420,\"z\":-75,\"yaw\":0,\"percent\":0},{\"tool\":\"remove\",\"kind\":0,\"id\":2,\"x\":0,\"z\":0,\"yaw\":0,\"percent\":0}]}");
  #assert !s[0].live && s[0].count == 5 && s[0].who[3] == CW_TOOL && cw_test_labels(s, 3) == "Place Cargo crate at 420, -75\nRemove Parked rover 2";
  #assert s[0].who[4] == CW_AGENT && cw_text(s, 4) == "We put a crate there and took the rover away." && cast(string) s[0].meta[4][0..<s[0].meta_n[4]] == "Gemini 3.8 Flash";
  #assert coaxial_chatweb_act_kind(s) == CW_PLANNED && cast(string) s[0].planned[0..<coaxial_chatweb_act_len(s)] == "world.plan.v1 splice 7\nplace 1001 420 -75 0\nremove 2\n";
  coaxial_chatweb_act_done(s);
  #assert coaxial_chatweb_act_kind(s) == 0;
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  // the steps are a run of world tools, closed to one line that opens onto them
  #assert tr_text_of(t, tr_find(t, "m.3.w.l")) == "Place Cargo crate at 420, -75, Remove Parked rover 2" && tr_find(t, "m.3.c.1") < 0;
  cw_test_press(s, "m.3.w");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_text_of(t, tr_find(t, "m.3.c.1.l")) == "Remove Parked rover 2" && tr_attr_of(t, tr_find(t, "m.3.c.1.row"), AT_STATE) == "done";
  // a plan that names a thing the world does not have is said, and nothing goes to the editor
  cw_test_type(s, "composer", "remove the tower");
  cw_test_enter(s, "composer");
  cw_test_planned(s, "{\"route\":\"edit\",\"say\":\"Done.\",\"steps\":[{\"tool\":\"remove\",\"kind\":0,\"id\":9,\"x\":0,\"z\":0,\"yaw\":0,\"percent\":0}]}");
  #assert !s[0].live && coaxial_chatweb_act_kind(s) == 0 && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "a thing that is not in this world");
}
#test "in the editor a Gemini turn may open attachments first: it says what it opened and is asked again with them" {
  h: [1] CwTest; s := h[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_world(s, "world.turn.v1 splice dev 7 0\nk 1001 Cargo crate\na 00112233445566aa image 4032348 RaiderGarage.png\nan The raiders' garage\nat garage,raiders\ne 1 1001 350 -1200 90\n");
  cw_test_type(s, "composer", "what does the garage look like?");
  cw_test_enter(s, "composer");
  #assert cw_test_has(cw_test_body(s), "a 00112233445566aa image 4032348 RaiderGarage.png") && !cw_test_has(cw_test_body(s), "\"attachments\"");
  cw_test_planned(s, "{\"route\":\"open\",\"say\":\"\",\"open\":[\"00112233445566aa\"],\"steps\":[]}");
  body := cw_test_body(s);
  #assert s[0].flight == CF_PLAN && s[0].live && s[0].nopened == 1 && s[0].who[1] == CW_TOOL && cw_test_labels(s, 1) == "Open RaiderGarage.png";
  #assert cw_test_has(body, ",\"attachments\":{\"world\":\"splice\",\"ids\":[\"00112233445566aa\"]}}") && cw_test_has(body, "You opened these attachments, and they come with the last message: RaiderGarage.png.");
  cw_test_planned(s, "{\"route\":\"talk\",\"say\":\"A low hangar of rusted panels.\",\"open\":[],\"steps\":[]}");
  #assert !s[0].live && s[0].count == 3 && cw_text(s, 2) == "A low hangar of rusted panels.";
  // asked to open again instead of answering: said, and nothing more is asked
  cw_test_type(s, "composer", "and inside?");
  cw_test_enter(s, "composer");
  cw_test_planned(s, "{\"route\":\"open\",\"say\":\"\",\"open\":[\"00112233445566aa\"],\"steps\":[]}");
  cw_test_planned(s, "{\"route\":\"open\",\"say\":\"\",\"open\":[\"00112233445566aa\"],\"steps\":[]}");
  #assert !s[0].live && cw_test_has(cast(string) s[0].error[0..<s[0].error_n], "open attachments again");
}
#test "on /chat an agent's realm world tool brings the world's card after its run: the name, what it holds and a link to its editor" {
  ts: [1] CwTest; s := ts[0].s[..];
  #assert cw_world_tool("realm_world") && cw_world_tool("mcp__coder__realm_world_place") && !cw_world_tool("realm_worlds") && !cw_world_tool("realm_publish") && !cw_world_tool("");
  cw_test_local(s, CW_T_SESSIONS);
  s[0].model = 7;
  cw_test_type(s, "composer", "add a crate to splice");
  cw_test_enter(s, "composer");
  cw_test_answer(s, 200, "20261112-050000-001\n");
  b := coaxial_chatweb_frame(s, 0.016, true);
  for i: 0..<14 {
    if coaxial_chatweb_asking(s) && cw_test_door(s) == "/local/log?id=20261112-050000-001&after=0" { break; }
    if coaxial_chatweb_asking(s) { cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/sessions" then CW_T_SESSIONS else CW_T_CLAUDE); }
    b = coaxial_chatweb_frame(s, 0.1, true);
  }
  #assert cw_test_door(s) == "/local/log?id=20261112-050000-001&after=0";
  cw_test_answer(s, 200, "{\"next\":300,\"size\":300}\n{\"kind\":\"user\",\"text\":\"add a crate to splice\"}\n{\"kind\":\"tool\",\"label\":\"realm_world_place(splice)\",\"name\":\"mcp__coder__realm_world_place\",\"input\":{\"slug\":\"splice\",\"kind\":1001}}\n{\"kind\":\"reply\",\"text\":\"Placed.\"}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":5,\"steps\":2}\n");
  #assert cast(string) s[0].card_due[0..<s[0].card_due_n] == "splice";
  b = coaxial_chatweb_frame(s, 0.016, true);
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/api/worlds/splice/card" && coaxial_chatweb_ask(s) == 0;
  cw_test_answer(s, 200, "world.card.v1 splice 8 13\nname Splice\n");
  k := s[0].count - 1;
  #assert s[0].who[k] == CW_CARD && s[0].card_due_n == 0;
  b = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..]; ida: [UI_ID] u8; idb: [UI_ID] u8;
  id := tr_join(ida[..], "m.", s[0].total - 1);
  #assert tr_text_of(t, tr_find(t, tr_cat(idb[..], id, ".h"))) == "Splice" && tr_text_of(t, tr_find(t, tr_cat(idb[..], id, ".facts"))) == "13 things · revision 8";
  go := tr_find(t, tr_cat(idb[..], id, ".open"));
  #assert t[0].nodes[go].tag == TG_A && tr_attr_of(t, go, AT_HREF) == "/worlds/splice?edit=agent" && tr_text_of(t, go) == "Open the editor";
  // an answer that is not a card shows nothing
  s[0].card_due_n = cw_put(s[0].card_due[..], 0, "splice");
  for i: 0..<40 { b = coaxial_chatweb_frame(s, 0.1, true); if coaxial_chatweb_asking(s) { if cw_test_door(s) == "/api/worlds/splice/card" { break; } cw_test_answer(s, 200, ifx cw_test_door(s) == "/local/sessions" then CW_T_SESSIONS else CW_T_CLAUDE); } }
  count := s[0].count;
  cw_test_answer(s, 404, "{\"error\":\"not found\"}");
  #assert s[0].count == count;
}

#test "a message sent in the page's first moment, while the account is still being read, goes when that read is back" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].flight == CF_ACCOUNT;
  coaxial_chatweb_asked(s);
  cw_test_type(s, "composer", "hello");
  cw_test_enter(s, "composer");
  #assert s[0].send_due && s[0].count == 0 && s[0].flight == CF_ACCOUNT;
  cw_test_answer(s, 404, "{\"error\":\"not found\"}");
  #assert !s[0].send_due && s[0].count == 2 && cw_text(s, 0) == "hello" && s[0].flight == CF_COMPLETE && cw_test_door(s) == "/api/chat/complete";
}

// ---------------------------------------------------------------- the app shell and its side (docs/app-shell.md)
cw_test_path :: (s: [] ChatWeb, path: string) {
  for i: 0..<path.count { s[0].inbox[i] = path[i]; }
  coaxial_chatweb_event(s, CW_PATH, 0, path.count);
  n := coaxial_chatweb_frame(s, 0.016, true);
}
cw_test_go :: (s: [] ChatWeb) -> string { return cast(string) s[0].go[0..<s[0].go_n]; }

#test "the side is always there: its head, Chats, Projects and Worlds with Chats current, and who is logged in at its foot" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  t := s[0].tree[..];
  #assert tr_find(t, "side") >= 0 && tr_text_of(t, tr_find(t, "side.h.name")) == "OpenAgents" && tr_attr_of(t, tr_find(t, "side.h.home"), AT_HREF) == "/";
  #assert tr_attr_of(t, tr_find(t, "side.new"), AT_LABEL) == "New chat" && tr_attr_of(t, tr_find(t, "side.hide"), AT_LABEL) == "Hide the side";
  #assert tr_text_of(t, tr_find(t, "place.chats.t")) == "Chats" && tr_attr_of(t, tr_find(t, "place.chats"), AT_CURRENT) == "true";
  #assert tr_attr_of(t, tr_find(t, "place.projects"), AT_HREF) == "/projects" && tr_attr_of(t, tr_find(t, "place.worlds"), AT_HREF) == "/worlds" && !tr_has(t, tr_find(t, "place.worlds"), AT_CURRENT);
  #assert tr_text_of(t, tr_find(t, "who.go.t")) == "a•••@example.com" && tr_attr_of(t, tr_find(t, "who.go"), AT_HREF) == "/settings" && tr_find(t, "who.out") >= 0;
  // the worlds they may edit are under Worlds, each opening its editor
  #assert tr_text_of(t, tr_find(t, "world.splice.t")) == "Splice" && tr_attr_of(t, tr_find(t, "world.splice"), AT_HREF) == "/worlds/splice?edit" && t[0].nodes[tr_find(t, "world.splice")].parent == t[0].nodes[tr_find(t, "place.worlds")].parent;
  // nobody logged in: Log in instead, and no worlds are asked for
  ts2: [1] CwTest; o := ts2[0].s[..];
  n := coaxial_chatweb_frame(o, 0.016, true);
  cw_test_answer(o, 401, "");
  n = coaxial_chatweb_frame(o, 0.016, true);
  #assert cw_test_door(o) == "/api/auth/account?as=lines";
  cw_test_answer(o, 200, "logged_in 0\n");
  n = coaxial_chatweb_frame(o, 0.016, true);
  n = coaxial_chatweb_frame(o, 0.016, true);
  #assert !coaxial_chatweb_asking(o) && tr_find(o[0].tree[..], "world.splice") < 0;
  #assert tr_text_of(o[0].tree[..], tr_find(o[0].tree[..], "who.go.t")) == "Log in" && tr_attr_of(o[0].tree[..], tr_find(o[0].tree[..], "who.go"), AT_HREF) == "/login" && tr_find(o[0].tree[..], "who.out") < 0;
}

#test "at / the shell shows the side and nothing else; Chats and the mark move between the two without leaving the page" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  cw_test_path(s, "/");
  t := s[0].tree[..];
  #assert s[0].page == SS_HOME && tr_class(t, 0) == "home" && tr_find(t, "side") >= 0 && tr_find(t, "composer") < 0 && !tr_has(t, tr_find(t, "place.chats"), AT_CURRENT);
  cw_test_press(s, "place.chats");
  #assert s[0].page == SS_CHATS && cw_test_go(s) == "/chat" && coaxial_chatweb_go_push(s);
  coaxial_chatweb_go_done(s); n := coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_class(t, 0) == "chat" && tr_find(t, "composer") >= 0 && coaxial_chatweb_go_len(s) == 0;
  cw_test_press(s, "side.h.home");
  #assert s[0].page == SS_HOME && cw_test_go(s) == "/" && coaxial_chatweb_go_push(s);
  // Back: the host says the address; Projects is a page of its own, so the shell lets the link go
  cw_test_path(s, "/chat");
  #assert s[0].page == SS_CHATS;
  coaxial_chatweb_go_done(s);
  cw_test_press(s, "place.projects");
  #assert coaxial_chatweb_go_len(s) == 0 && s[0].page == SS_CHATS;
  // in the editor's foot the address is the world's: the chat alone, as the editor draws the side itself
  cw_test_path(s, "/worlds/splice"); n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].page == SS_FOOT && tr_class(t, 0) == "chat" && tr_find(t, "composer") >= 0 && tr_find(t, "side") < 0 && tr_find(t, "side.show") < 0;
  // the editor's left: the side alone, and Chats and New chat go to the chat's own page
  cw_test_path(s, "/side"); n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].page == SS_SIDE && tr_class(t, 0) == "home" && tr_find(t, "side") >= 0 && tr_find(t, "composer") < 0;
  cw_test_press(s, "side.new");
  #assert s[0].page == SS_SIDE && cw_test_go(s) == "/chat" && !coaxial_chatweb_go_push(s);
}

#test "the side can be put away and brought back, and this browser keeps that; Log out logs out and goes home" {
  ts: [1] CwTest; s := ts[0].s[..];
  cw_test_open(s, "{\"claude\":null}");
  t := s[0].tree[..];
  cw_test_press(s, "side.hide"); n := coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].side_closed && tr_find(t, "side") < 0 && tr_attr_of(t, tr_find(t, "side.show"), AT_LABEL) == "Show the side";
  #assert cast(string) s[0].keep[0..<coaxial_chatweb_keep_len(s)] == "local=on&side=closed";
  coaxial_chatweb_keep_done(s);
  cw_test_press(s, "side.show"); n = coaxial_chatweb_frame(s, 0.016, true);
  #assert !s[0].side_closed && tr_find(t, "side") >= 0 && cast(string) s[0].keep[0..<coaxial_chatweb_keep_len(s)] == "local=on";
  ts2: [1] CwTest; k := ts2[0].s[..];
  w := "local=off&side=closed"; for i: 0..<w.count { k[0].inbox[i] = w[i]; }
  coaxial_chatweb_event(k, CW_KEPT, 0, w.count);
  #assert k[0].local_off && k[0].side_closed;
  // Log out
  while coaxial_chatweb_asking(s) { cw_test_answer(s, 404, ""); n = coaxial_chatweb_frame(s, 0.016, true); }
  cw_test_press(s, "who.out");
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert coaxial_chatweb_asking(s) && cw_test_door(s) == "/api/auth/logout?as=lines" && cw_test_body(s) == "{}";
  cw_test_answer(s, 200, "");
  #assert cw_test_go(s) == "/" && !coaxial_chatweb_go_push(s) && s[0].me_n == 0;
}

