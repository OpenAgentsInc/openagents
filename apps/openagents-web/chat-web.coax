// openagents.com/chat, rebuilt from nothing (docs/audits/2026-11-11-chat-zero-base-audit.md):
// the first pieces. The page is the composer at the foot of the window, a
// real text field and Send, under a transcript of what you sent. Enter or
// Send puts your message in the transcript and clears the field. Nothing is
// sent anywhere yet and nothing answers: there is no agent behind it, and
// the transcript is gone when the page is left. The page before this one is
// /chat-gpu (chat.coax).
//
// The transcript keeps the newest CW_MESSAGES messages in CW_POOL bytes and
// shows as many of the newest as fit CW_SHOWN bytes; when there are more, a
// line above them says how many are not shown.
//
// The browser draws it: the frames set (components/kit/frames.coax) in the
// mono skin, through the browser backend (components/backend/dom.coax) and
// coax/web/dom-host.js. This is its module for coax/web/wasm.sh, with
// chat-web-face.c.
//   coax/bin/coax test apps/openagents-web/chat-web.coax

#load "../../components/kit/frames.coax";
#load "../../components/backend/dom.coax";

CW_INBOX :: 16384;     // a field's text from the host
CW_DRAFT :: 16384;     // a message's most, in bytes: what is typed past it is not taken
CW_CSS :: 16384;
CW_MESSAGES :: 128;    // messages kept
CW_POOL :: 262144;     // bytes of their text kept
CW_SHOWN :: 98304;     // bytes of text the page shows at once (the tree holds 131072)
CW_CLICK :: 1; CW_INPUT :: 2; CW_SUBMIT :: 3;

ChatWeb :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  draft: [CW_DRAFT] u8; draft_n: int;
  sends: int;                        // messages taken so far: the next one's number
  at: [CW_MESSAGES] int; len: [CW_MESSAGES] int; count: int;   // the kept messages, oldest first, in the pool
  pool: [CW_POOL] u8; pool_n: int;
  inbox: [CW_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [CW_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

// Whether the draft has anything but spaces and line breaks.
cw_has_words :: (s: [] ChatWeb) -> bool {
  for i: 0..<s[0].draft_n { c := s[0].draft[i]; if c != ' ' && c != '\n' && c != '\t' && c != '\r' { return true; } }
  return false;
}
cw_build :: (s: [] ChatWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  tr_begin(t);
  page := tr_open(t, "chat", TG_MAIN, "chat");
  if s[0].count > 0 {
    scroller := tr_open(t, "log", TG_DIV, "log");
    th := tr_open(t, "thread", TG_DIV, "thread");
    // the newest that fit, oldest of them first
    first := s[0].count; shown := 0;
    while first > 0 && shown + s[0].len[first - 1] <= CW_SHOWN { first -= 1; shown += s[0].len[first]; }
    hidden := s[0].sends - (s[0].count - first);
    buf: [UI_ID] u8; buf2: [UI_ID] u8;
    if hidden > 0 { m := k_meta(t, "earlier", tr_cat(buf2[..], tr_join(buf[..], "", hidden), ifx hidden == 1 then " earlier message is not shown" else " earlier messages are not shown")); }
    for k: first..<s[0].count {
      m := k_user(t, u, tr_join(buf[..], "m.", s[0].sends - s[0].count + k), cast(string) s[0].pool[s[0].at[k]..<s[0].at[k] + s[0].len[k]]);
    }
    tr_close(t);
    tr_close(t);
  }
  f := k_composer(t, u, "composer", "Ask anything", "", "Send", cw_has_words(s));
  tr_attr(t, f, AT_FOCUS, "");
  tr_close(t);
}
// The oldest kept message goes: the rest move down the pool.
cw_drop :: (s: [] ChatWeb) {
  if s[0].count == 0 { return; }
  gone := s[0].len[0];
  for i: gone..<s[0].pool_n { s[0].pool[i - gone] = s[0].pool[i]; }
  s[0].pool_n -= gone;
  for k: 1..<s[0].count { s[0].at[k - 1] = s[0].at[k] - gone; s[0].len[k - 1] = s[0].len[k]; }
  s[0].count -= 1;
}
// Takes the message: it goes into the transcript, without the space around it, and the field is cleared.
cw_send :: (s: [] ChatWeb) {
  if !cw_has_words(s) { return; }
  lo := 0; hi := s[0].draft_n;
  while lo < hi && (s[0].draft[lo] == ' ' || s[0].draft[lo] == '\n' || s[0].draft[lo] == '\t' || s[0].draft[lo] == '\r') { lo += 1; }
  while hi > lo && (s[0].draft[hi - 1] == ' ' || s[0].draft[hi - 1] == '\n' || s[0].draft[hi - 1] == '\t' || s[0].draft[hi - 1] == '\r') { hi -= 1; }
  while s[0].count > 0 && (s[0].count >= CW_MESSAGES || s[0].pool_n + hi - lo > CW_POOL) { cw_drop(s); }
  k := s[0].count;
  s[0].at[k] = s[0].pool_n; s[0].len[k] = hi - lo;
  for i: lo..<hi { s[0].pool[s[0].pool_n] = s[0].draft[i]; s[0].pool_n += 1; }
  s[0].count += 1;
  s[0].sends += 1;
  s[0].draft_n = 0;
  dm_value(s[0].dom[..], "composer", "");
}

coaxial_chatweb_frame :: (s: [] ChatWeb, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := mono_css(s[0].css[..]);
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  cw_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}
coaxial_chatweb_busy :: (s: [] ChatWeb) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
coaxial_chatweb_event :: (s: [] ChatWeb, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  id := dm_slot_id(s[0].dom[..], slot);
  if kind == CW_INPUT && id == "composer" {
    n := ifx length < 0 then 0 else ifx length > CW_DRAFT then CW_DRAFT else length;
    for i: 0..<n { s[0].draft[i] = s[0].inbox[i]; }
    s[0].draft_n = n;
  }
  else if kind == CW_SUBMIT && id == "composer" { cw_send(s); }
  else if kind == CW_CLICK && id == "composer.send" { cw_send(s); }
  else { return; }
  s[0].dirty = true;
}
coaxial_chatweb_size :: (s: [] ChatWeb, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_chatweb_inbox_cap :: () -> int #export_c #effects(all) { return CW_INBOX; }

CwTest :: struct { s: [1] ChatWeb; }

#test "the page is the composer alone; Send is off until there are words" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert n > 0 && t[0].n == 6 && t[0].lost == 0 && tr_class(t, 0) == "chat";
  #assert t[0].nodes[tr_find(t, "composer")].tag == TG_TEXTAREA && tr_has(t, tr_find(t, "composer"), AT_FOCUS);
  #assert tr_has(t, tr_find(t, "composer.send"), AT_DISABLED) && coaxial_chatweb_frame(s, 0.016, true) == 0;
  d := s[0].dom[..];
  spaces := "  \n ";
  for i: 0..<spaces.count { s[0].inbox[i] = spaces[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), spaces.count);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  #assert s[0].sends == 0;
}

#test "a sent message is in the transcript, trimmed, in order; the oldest go when there are too many, and the page says so" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  d := s[0].dom[..];
  #assert tr_find(s[0].tree[..], "log") < 0;
  text := "  first\nline two \n";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  n = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_text_of(t, tr_find(t, "m.0.p")) == "first\nline two" && tr_find(t, "earlier") < 0;
  #assert t[0].nodes[tr_find(t, "log")].parent == 0 && tr_find(t, "log") < tr_find(t, "composer");
  for k: 0..<CW_MESSAGES + 2 {
    s[0].inbox[0] = cast(u8) ('a' + k % 26);
    coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), 1);
    coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  }
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].count == CW_MESSAGES && s[0].sends == CW_MESSAGES + 3 && s[0].pool_n == CW_MESSAGES;
  #assert tr_find(t, "m.0") < 0 && tr_find(t, "m.2") < 0 && tr_find(t, "m.3") > 0 && tr_text_of(t, tr_find(t, "m.3.p")) == "c";
  #assert tr_text_of(t, tr_find(t, "earlier")) == "3 earlier messages are not shown" && t[0].lost == 0;
}

#test "Enter or Send takes the message and clears the field" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  d := s[0].dom[..];
  text := "hello";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert !tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED) && tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_STATE) == "primary";
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].sends == 1 && s[0].draft_n == 0 && dm_test_count(d, n, DC_VALUE) == 1;
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  coaxial_chatweb_event(s, CW_CLICK, dm_find(d, "composer.send"), 0);
  #assert s[0].sends == 2;
}
