// openagents.com/chat, rebuilt from nothing (docs/audits/2026-11-11-chat-zero-base-audit.md):
// the first pieces. The page is the composer at the foot of the window, a
// real text field and Send, under a transcript of what you sent. Enter or
// Send puts your message in the transcript and clears the field. Nothing is
// sent anywhere yet and nothing answers: there is no agent behind it, and
// the transcript is gone when the page is left. The page before this one is
// /chat-gpu (chat.coax).
//
// Each message gets an answer, and the answer is a dummy: one of CW_REPLIES,
// written here, from no model. It arrives a moment after the message and its
// text comes in as an answer being written would (the skin's MONO_REPLY_*),
// parsed as Markdown as it grows. Under a finished answer, Copy copies it.
//
// The transcript keeps up to CW_MESSAGES messages in CW_POOL bytes (when it
// is full the oldest quarter goes) and
// shows as many of the newest as fit CW_SHOWN bytes; when there are more, a
// line above them says how many are not shown.
//
// The browser draws it: the frames set (components/kit/frames.coax) in the
// mono skin, through the browser backend (components/backend/dom.coax) and
// coax/web/dom-host.js. This is its module for coax/web/wasm.sh, with
// chat-web-face.c.
//   coax/bin/coax test apps/openagents-web/chat-web.coax

#load "../../components/kit/frames.coax";
#load "../../components/backend/dom.coax";

CW_INBOX :: 16384;     // a field's text from the host
CW_DRAFT :: 16384;     // a message's most, in bytes: what is typed past it is not taken
CW_CSS :: 16384;
CW_MESSAGES :: 128;    // messages kept
CW_POOL :: 262144;     // bytes of their text kept
CW_YOU :: 0; CW_AGENT :: 1;
CW_REPLIES :: [3] string.[
  "This is a placeholder answer. Nothing was sent to a model: the page wrote this itself, so you can see how an answer looks and how it arrives.\n\nA real answer will come from the agent once the page is connected to it.",
  "Here is what an answer with some structure looks like:\n\n- a short point\n- a second one, with `inline code`\n- and a third, with **something that matters**\n\nI am still a placeholder. No model wrote this.",
  "A placeholder again, this time with code:\n\n```sh\ncoax/web/serve.sh apps/openagents-web --listen 127.0.0.1:9471\n```\n\nThe text above is real text. You can select it, search for it and copy it."];
CW_SHOWN :: 98304;     // bytes of text the page shows at once (the tree holds 131072)
CW_CLICK :: 1; CW_INPUT :: 2; CW_SUBMIT :: 3;

ChatWeb :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  draft: [CW_DRAFT] u8; draft_n: int;
  sends: int;                        // messages the person has sent
  total: int;                        // messages put in the transcript so far, theirs and the answers: the next one's number
  at: [CW_MESSAGES] int; len: [CW_MESSAGES] int; count: int;   // the kept messages, oldest first, in the pool
  who: [CW_MESSAGES] int;            // CW_YOU or CW_AGENT
  born: [CW_MESSAGES] f32;           // an answer: the second its text starts to come
  streaming: bool;                   // an answer's text is still coming: build again next frame
  clip: [CW_DRAFT] u8; clip_n: int;  // text for the host to copy, until it has
  copied: int; copied_at: f32;       // the answer last copied (its number + 1, 0 for none) and when
  doc: [1] MdDoc;
  pool: [CW_POOL] u8; pool_n: int;
  inbox: [CW_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [CW_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

// Whether the draft has anything but spaces and line breaks.
cw_has_words :: (s: [] ChatWeb) -> bool {
  for i: 0..<s[0].draft_n { c := s[0].draft[i]; if c != ' ' && c != '\n' && c != '\t' && c != '\r' { return true; } }
  return false;
}
cw_build :: (s: [] ChatWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  tr_begin(t);
  page := tr_open(t, "chat", TG_MAIN, "chat");
  if s[0].count > 0 {
    scroller := tr_open(t, "log", TG_DIV, "log");
    th := tr_open(t, "thread", TG_DIV, "thread");
    // the newest that fit, oldest of them first
    first := s[0].count; shown := 0;
    while first > 0 && shown + s[0].len[first - 1] <= CW_SHOWN { first -= 1; shown += s[0].len[first]; }
    hidden := s[0].total - (s[0].count - first);
    buf: [UI_ID] u8; buf2: [UI_ID] u8;
    if hidden > 0 { m := k_meta(t, "earlier", tr_cat(buf2[..], tr_join(buf[..], "", hidden), ifx hidden == 1 then " earlier message is not shown" else " earlier messages are not shown")); }
    s[0].streaming = false;
    for k: first..<s[0].count {
      id := tr_join(buf[..], "m.", s[0].total - s[0].count + k);
      text := cast(string) s[0].pool[s[0].at[k]..<s[0].at[k] + s[0].len[k]];
      if s[0].who[k] == CW_YOU { m := k_user(t, u, id, text); continue; }
      // an answer: as much of it as has come, as Markdown
      n := text.count;
      if !u[0].reduced {
        since := s[0].time - s[0].born[k];
        if since < 0 { s[0].streaming = true; continue; }   // not yet
        come := cast(int) (since * MONO_REPLY_RATE);
        if come < n { n = come; s[0].streaming = true; }
        while n > 0 && n < text.count && (text[n] & 0xC0) == 0x80 { n -= 1; }   // not inside a character
      }
      whole := n == text.count;
      a := tr_open(t, id, TG_DIV, "msg-ai");
      if !whole { tr_attr(t, a, AT_STATE, "streaming"); }
      doc := s[0].doc[..];
      doc[0].n = 0; doc[0].nb = 0; doc[0].nr = 0; doc[0].ni = 0; doc[0].nlink = 0;
      blocks := md_parse(doc, cast(string) text[0..<n], 0);
      ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
      body := k_agent(t, u, tr_cat(ida[..], id, ".md"), doc);
      if whole {
        acts := tr_open(t, tr_cat(idb[..], id, ".acts"), TG_DIV, "acts");
        number := s[0].total - s[0].count + k;
        done := s[0].copied == number + 1 && s[0].time - s[0].copied_at < MONO_COPIED;
        if done { s[0].streaming = true; }   // build again when the check gives way to Copy
        c := k_icon_button(t, tr_cat(idc[..], id, ".copy"), ifx done then IC_CHECK else IC_COPY, ifx done then "Copied" else "Copy");
        if done { tr_attr(t, c, AT_STATE, "done"); }
        tr_close(t);
      }
      tr_close(t);
    }
    tr_close(t);
    tr_close(t);
  }
  f := k_composer(t, u, "composer", "Ask anything", "", "Send", cw_has_words(s));
  tr_attr(t, f, AT_FOCUS, "");
  tr_close(t);
}
// Makes room for one more message of `need` bytes. When the transcript is full the oldest quarter goes at
// once, in one pass, so the text is not moved for every message after that.
cw_room :: (s: [] ChatWeb, need: int) {
  if s[0].count < CW_MESSAGES && s[0].pool_n + need <= CW_POOL { return; }
  keep := CW_MESSAGES - CW_MESSAGES / 4;
  drop := 0; gone := 0;
  while drop < s[0].count && (s[0].count - drop > keep || s[0].pool_n - gone + need > CW_POOL - CW_POOL / 4) { gone += s[0].len[drop]; drop += 1; }
  if drop == 0 { return; }
  for i: gone..<s[0].pool_n { s[0].pool[i - gone] = s[0].pool[i]; }
  s[0].pool_n -= gone;
  for k: drop..<s[0].count { s[0].at[k - drop] = s[0].at[k] - gone; s[0].len[k - drop] = s[0].len[k]; s[0].who[k - drop] = s[0].who[k]; s[0].born[k - drop] = s[0].born[k]; }
  s[0].count -= drop;
}
// A message into the transcript, the oldest making room for it.
cw_add :: (s: [] ChatWeb, text: string, who: int) {
  cw_room(s, text.count);
  k := s[0].count;
  s[0].at[k] = s[0].pool_n; s[0].len[k] = text.count; s[0].who[k] = who; s[0].born[k] = s[0].time + MONO_REPLY_WAIT;
  for c: text { s[0].pool[s[0].pool_n] = c; s[0].pool_n += 1; }
  s[0].count += 1; s[0].total += 1;
}
// The number in an answer's Copy id ("m.7.copy" is 7), or -1.
cw_copy_of :: (id: string) -> int {
  if id.count < 8 || cast(string) id[0..<2] != "m." || cast(string) id[id.count - 5..<id.count] != ".copy" { return -1; }
  n := 0;
  for i: 2..<id.count - 5 { c := id[i]; if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return n;
}
// Takes the message: it goes into the transcript, without the space around it, and the field is cleared.
cw_send :: (s: [] ChatWeb) {
  if !cw_has_words(s) { return; }
  lo := 0; hi := s[0].draft_n;
  while lo < hi && (s[0].draft[lo] == ' ' || s[0].draft[lo] == '\n' || s[0].draft[lo] == '\t' || s[0].draft[lo] == '\r') { lo += 1; }
  while hi > lo && (s[0].draft[hi - 1] == ' ' || s[0].draft[hi - 1] == '\n' || s[0].draft[hi - 1] == '\t' || s[0].draft[hi - 1] == '\r') { hi -= 1; }
  cw_add(s, cast(string) s[0].draft[lo..<hi], CW_YOU);
  // the dummy answer: the next of CW_REPLIES, a moment later
  replies := CW_REPLIES;
  cw_add(s, replies[s[0].sends % replies.count], CW_AGENT);
  s[0].sends += 1;
  s[0].draft_n = 0;
  dm_value(s[0].dom[..], "composer", "");
}

coaxial_chatweb_frame :: (s: [] ChatWeb, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := mono_css(s[0].css[..]);
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  cw_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy || s[0].streaming;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}
coaxial_chatweb_busy :: (s: [] ChatWeb) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
coaxial_chatweb_event :: (s: [] ChatWeb, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  id := dm_slot_id(s[0].dom[..], slot);
  if kind == CW_INPUT && id == "composer" {
    n := ifx length < 0 then 0 else ifx length > CW_DRAFT then CW_DRAFT else length;
    for i: 0..<n { s[0].draft[i] = s[0].inbox[i]; }
    s[0].draft_n = n;
  }
  else if kind == CW_SUBMIT && id == "composer" { cw_send(s); }
  else if kind == CW_CLICK && id == "composer.send" { cw_send(s); }
  else if kind == CW_CLICK && cw_copy_of(id) < 0 && id.count > 5 && cast(string) id[id.count - 5..<id.count] == ".copy" {
    // a code block's Copy: the code beside it, as the page shows it
    pre: [UI_ID] u8;
    at := tr_find(s[0].tree[..], tr_cat(pre[..], cast(string) id[0..<id.count - 5], ".pre"));
    if at >= 0 {
      code := tr_text_of(s[0].tree[..], at);
      s[0].clip_n = 0;
      for c: code { if s[0].clip_n < CW_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } }
    }
  }
  else if kind == CW_CLICK && cw_copy_of(id) >= 0 {
    k := cw_copy_of(id) - (s[0].total - s[0].count);
    if k >= 0 && k < s[0].count {
      s[0].copied = cw_copy_of(id) + 1; s[0].copied_at = s[0].time;
      s[0].clip_n = 0;
      for i: 0..<s[0].len[k] { if s[0].clip_n < CW_DRAFT { s[0].clip[s[0].clip_n] = s[0].pool[s[0].at[k] + i]; s[0].clip_n += 1; } }
    }
  }
  else { return; }
  s[0].dirty = true;
}
coaxial_chatweb_size :: (s: [] ChatWeb, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_chatweb_clip :: (s: [] ChatWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
coaxial_chatweb_clip_done :: (s: [] ChatWeb) #export_c #effects(all) { if s.count > 0 { s[0].clip_n = 0; } }
coaxial_chatweb_inbox_cap :: () -> int #export_c #effects(all) { return CW_INBOX; }

CwTest :: struct { s: [1] ChatWeb; }

#test "the page is the composer alone; Send is off until there are words" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert n > 0 && t[0].n == 6 && t[0].lost == 0 && tr_class(t, 0) == "chat";
  #assert t[0].nodes[tr_find(t, "composer")].tag == TG_TEXTAREA && tr_has(t, tr_find(t, "composer"), AT_FOCUS);
  #assert tr_has(t, tr_find(t, "composer.send"), AT_DISABLED) && coaxial_chatweb_frame(s, 0.016, true) == 0;
  d := s[0].dom[..];
  spaces := "  \n ";
  for i: 0..<spaces.count { s[0].inbox[i] = spaces[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), spaces.count);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  #assert s[0].sends == 0;
}

#test "a sent message and its answer are in the transcript, in order; the oldest go when there are too many, and the page says so" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  d := s[0].dom[..];
  #assert tr_find(s[0].tree[..], "log") < 0;
  text := "  first\nline two \n";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  n = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_text_of(t, tr_find(t, "m.0.p")) == "first\nline two" && tr_find(t, "earlier") < 0;
  #assert tr_class(t, tr_find(t, "m.1")) == "msg-ai" && tr_find(t, "m.1.md.b0") > tr_find(t, "m.0") && tr_find(t, "m.1.copy") > 0;
  #assert t[0].nodes[tr_find(t, "log")].parent == 0 && tr_find(t, "log") < tr_find(t, "composer");
  for k: 0..<CW_MESSAGES {
    s[0].inbox[0] = cast(u8) ('a' + k % 26);
    coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), 1);
    coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  }
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].count <= CW_MESSAGES && s[0].count >= CW_MESSAGES - CW_MESSAGES / 4 && s[0].sends == CW_MESSAGES + 1 && s[0].total == CW_MESSAGES * 2 + 2;
  gone := s[0].total - s[0].count;
  b1: [UI_ID] u8; b2: [UI_ID] u8; b3: [UI_ID] u8; b4: [UI_ID] u8;
  #assert tr_find(t, "m.0") < 0 && tr_find(t, tr_join(b1[..], "m.", gone - 1)) < 0 && tr_find(t, tr_join(b2[..], "m.", gone)) > 0;
  #assert tr_class(t, tr_find(t, tr_join(b3[..], "m.", s[0].total - 1))) == "msg-ai";
  #assert tr_text_of(t, tr_find(t, "earlier")) == tr_cat(b4[..], tr_join(b1[..], "", gone), " earlier messages are not shown") && t[0].lost == 0 && t[0].depth == 0;
}

#test "an answer comes a moment later, its text grows, and then it is whole and can be copied" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, false);
  d := s[0].dom[..];
  for k: 0..<20 { n = coaxial_chatweb_frame(s, 0.1, false); }   // the composer has entered
  #assert !coaxial_chatweb_busy(s);
  s[0].inbox[0] = 'q';
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), 1);
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  n = coaxial_chatweb_frame(s, 0.016, false);
  t := s[0].tree[..];
  #assert tr_find(t, "m.0") > 0 && tr_find(t, "m.1") < 0 && coaxial_chatweb_busy(s);
  for k: 0..<5 { n = coaxial_chatweb_frame(s, 0.1, false); }
  first := tr_text_of(t, tr_find(t, "m.1.md.b0.0"));
  replies := CW_REPLIES;
  #assert first.count > 0 && first.count < 100 && first == cast(string) replies[0][0..<first.count];
  #assert tr_attr_of(t, tr_find(t, "m.1"), AT_STATE) == "streaming" && tr_find(t, "m.1.copy") < 0 && coaxial_chatweb_busy(s);
  for k: 0..<40 { n = coaxial_chatweb_frame(s, 0.1, false); }
  #assert !tr_has(t, tr_find(t, "m.1"), AT_STATE) && tr_find(t, "m.1.copy") > 0 && !coaxial_chatweb_busy(s);
  #assert coaxial_chatweb_frame(s, 0.016, false) == 0;
  coaxial_chatweb_event(s, CW_CLICK, dm_find(d, "m.1.copy"), 0);
  #assert coaxial_chatweb_clip(s) == replies[0].count && cw_copy_of("m.12.copy") == 12 && cw_copy_of("m.x.copy") < 0 && cw_copy_of("composer") < 0;
  coaxial_chatweb_clip_done(s);
  #assert coaxial_chatweb_clip(s) == 0;
  // the third answer has a code block, and its Copy copies the code
  for q: 0..<2 {
    s[0].inbox[0] = 'q';
    coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), 1);
    coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
    for k: 0..<40 { n = coaxial_chatweb_frame(s, 0.1, false); }
  }
  coaxial_chatweb_event(s, CW_CLICK, dm_find(d, "m.5.md.b1.copy"), 0);
  #assert coaxial_chatweb_clip(s) == "coax/web/serve.sh apps/openagents-web --listen 127.0.0.1:9471".count;
}

#test "Enter or Send takes the message and clears the field" {
  h: [1] CwTest; s := h[0].s[..];
  n := coaxial_chatweb_frame(s, 0.016, true);
  d := s[0].dom[..];
  text := "hello";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert !tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED) && tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_STATE) == "primary";
  coaxial_chatweb_event(s, CW_SUBMIT, dm_find(d, "composer"), 0);
  n = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].sends == 1 && s[0].draft_n == 0 && dm_test_count(d, n, DC_VALUE) == 1;
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chatweb_event(s, CW_INPUT, dm_find(d, "composer"), text.count);
  coaxial_chatweb_event(s, CW_CLICK, dm_find(d, "composer.send"), 0);
  #assert s[0].sends == 2;
}
