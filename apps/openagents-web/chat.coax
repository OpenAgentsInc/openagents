// openagents.com/chat, drawn by Coax: a direct chat with a Claude agent for
// general questions, admins only for now (docs/chat.md). The page holds
// nothing until oa-api answers /api/chat/state with the admin's session
// cookie; anyone else sees only SIGN IN.
//
// What it draws: the asker's conversations and NEW CHAT (a column on a wide
// screen, CHATS over the conversation on a phone); the conversation shown,
// each message and the agent's answer (its Markdown drawn cleanly: headings,
// lists, quotes and code blocks), the model and the credential each answer
// used, and while a turn runs what tool it is using, with STOP; under it the
// models (HAIKU 5.5, SONNET 5.5, OPUS 5.5: the conversation keeps its own,
// and a change takes the next turn), the text box and SEND. KEY opens the
// asker's own credential: an Anthropic API key or a Claude subscription
// token, shown once saved only as its kind and last four, with REPLACE and
// REMOVE. The state comes every 2 s while a turn waits or runs, else every 30 s.
//
// The state is lines (coax/web/api/migrations/0021_chat.sql, chat.lines):
//   Z|spent|cap|kind|last4|expired|busy|shown
//   C|id|title|model|updated|busy
//   S|id|title|model|resumes
//   U|id|status|at|model|credential|text|answer|error|working|cost   (text and answer: \n \\ \p escaped)
//   T|turn|tool|detail

#load "projects.coax";

CH_MAX_VERTICES :: 240000;
CH_INBOX :: 1048576;
CH_DATA :: 1048576;
CH_LINES :: 4096;
CH_URL :: 128;
CH_TEXT :: 8000;           // what a message may hold (chat.api keeps 8000)
CH_KEY :: 400;             // a pasted credential's most
CH_BODY :: 24600;          // a post's JSON: a message escaped, or a credential
CH_MD :: 32768;            // one decoded text
CH_HITS :: 128;
CH_NOTE :: 300;
CH_HTTP :: 512;            // + id: an HTTP answer (coax/web/host.js)
CH_TYPED :: 1; CH_SHOWN :: 602;
CH_NAVIGATE :: 1;
CH_BUSY :: 2.0;            // seconds between reads while a turn waits or runs
CH_REFRESH :: 30.0;        // else
POST_SEND :: 1; POST_MODEL :: 2; POST_STOP :: 3; POST_KEY :: 4; POST_KEY_REMOVE :: 5;
H_HOME :: 1; H_SIGNIN :: 2; H_NEW :: 3; H_CHATS :: 4; H_KEY :: 5; H_FIELD :: 6; H_SEND :: 7; H_STOP :: 8;
H_KFIELD :: 9; H_KSAVE :: 10; H_REPLACE :: 11; H_REMOVE :: 12; H_CLOSE :: 13;
H_MODEL :: 20;             // + the model's index
H_CONV :: 100;             // + a conversation's index in the list
K_BACK :: -3; K_ESC :: -1;
MODELS :: [3] string.["claude-haiku-5-5", "claude-sonnet-5-5", "claude-opus-5-5"];
MODEL_NAMES :: [3] string.["HAIKU 5.5", "SONNET 5.5", "OPUS 5.5"];
MODEL_DEFAULT :: 2;

ChatState :: struct {
  time: f32; ready: bool;
  width: f32; height: f32; d: f32;
  status: int;                   // -1 nothing asked, 0 waiting for the first answer, else its HTTP status
  asked_at: f32;
  ask: [CH_URL] u8; ask_n: int; ask_id: int;
  post: [CH_URL] u8; post_n: int; post_id: int; post_kind: int;
  body: [CH_BODY] u8; body_n: int;
  shown: int;                    // the conversation shown: its id, 0 a new one, -1 the newest
  model: int;                    // the model chosen here, -1 the conversation's own
  note: [CH_NOTE] u8; note_n: int; note_at: f32;    // a word under the field: NOT SENT, the cap
  knote: [CH_NOTE] u8; knote_n: int;                // the same in KEY: why a key didn't work
  back: f32; content: f32;       // device pixels the conversation is scrolled up from its end; its height
  hot: int; press: int; press_x: f32; press_y: f32; drag_y: f32; dragged: bool;
  typing: bool; focus: int;      // the field typed into: 0 the message, 1 the key
  text: [CH_TEXT] u8; text_n: int;
  key: [CH_KEY] u8; key_n: int;
  listing: bool;                 // a phone: CHATS is open
  keying: bool;                  // KEY is open
  replacing: bool;               // KEY: the field is out over a saved credential
  clip0: f32; clip1: f32;        // what's drawn is between these
  field: [4] f32;
  hit_box: [CH_HITS] Box; hit_id: [CH_HITS] int; hit_n: int;
  outbox: [CH_URL] u8; out_n: int; action: int;
  md: [CH_MD] u8; md_n: int;
  data: [CH_DATA] u8; data_n: int;
  line_at: [CH_LINES] int; line_end: [CH_LINES] int; line_n: int;
  inbox: [CH_INBOX] u8;
}

// ---------------------------------------------------------------- the lines

ch_kind :: (s: [] ChatState, i: int) -> u8 { return s[0].data[s[0].line_at[i]]; }
ch_cell :: (s: [] ChatState, i: int, col: int) -> string {
  from := s[0].line_at[i]; to := s[0].line_end[i];
  k := from; c := 0;
  while c < col && k < to { if s[0].data[k] == '|' { c += 1; } k += 1; }
  if c < col { return ""; }
  j := k;
  while j < to && s[0].data[j] != '|' { j += 1; }
  return cast(string) s[0].data[k..<j];
}
ch_index :: (s: [] ChatState) {
  s[0].line_n = 0;
  at := 0; n := s[0].data_n;
  while at < n {
    stop := at;
    while stop < n && s[0].data[stop] != '\n' { stop += 1; }
    if stop > at + 1 && s[0].data[at + 1] == '|' && s[0].line_n < CH_LINES {
      s[0].line_at[s[0].line_n] = at; s[0].line_end[s[0].line_n] = stop; s[0].line_n += 1;
    }
    at = stop + 1;
  }
}
ch_first :: (s: [] ChatState, kind: u8) -> int {
  for i: 0..<s[0].line_n { if ch_kind(s, i) == kind { return i; } }
  return -1;
}
ch_count :: (s: [] ChatState, kind: u8) -> int {
  n := 0;
  for i: 0..<s[0].line_n { if ch_kind(s, i) == kind { n += 1; } }
  return n;
}
ch_nth :: (s: [] ChatState, kind: u8, k: int) -> int {
  n := 0;
  for i: 0..<s[0].line_n { if ch_kind(s, i) == kind { if n == k { return i; } n += 1; } }
  return -1;
}
ch_z :: (s: [] ChatState, col: int) -> string { z := ch_first(s, 'Z'); return ifx z < 0 then "" else ch_cell(s, z, col); }
ch_busy :: (s: [] ChatState) -> bool { return s[0].post_kind == POST_SEND || ch_z(s, 6) == "1"; }
ch_has_key :: (s: [] ChatState) -> bool { return ch_z(s, 3).count > 0; }
// Today's spend on OpenAgents' key has reached the cap, and no key of the asker's is saved.
ch_capped :: (s: [] ChatState) -> bool {
  if ch_has_key(s) || ch_first(s, 'Z') < 0 { return false; }
  return ch_cents(ch_z(s, 1)) >= ch_cents(ch_z(s, 2)) && ch_cents(ch_z(s, 2)) >= 0;
}
// "1.07" as 107; -1 for nothing.
ch_cents :: (t: string) -> int {
  if t.count == 0 { return -1; }
  n := 0; frac := -1;
  for c: t {
    if c == '.' { frac = 0; continue; }
    if c < '0' || c > '9' { break; }
    if frac >= 2 { continue; }
    n = n * 10 + cast(int) (c - '0');
    if frac >= 0 { frac += 1; }
  }
  if frac < 0 { frac = 0; }
  while frac < 2 { n *= 10; frac += 1; }
  return n;
}
ch_model_index :: (id: string) -> int {
  for k: 0..<3 { if MODELS[k] == id { return k; } }
  return -1;
}
// The model the next turn uses: the one chosen here, else the conversation's, else Opus.
ch_model :: (s: [] ChatState) -> int {
  if s[0].model >= 0 && s[0].model < 3 { return s[0].model; }
  si := ch_first(s, 'S');
  if si >= 0 && s[0].shown != 0 { k := ch_model_index(ch_cell(s, si, 3)); if k >= 0 { return k; } }
  return MODEL_DEFAULT;
}
ch_model_name :: (id: string) -> string { k := ch_model_index(id); return ifx k < 0 then "" else MODEL_NAMES[k]; }
// The conversation the lines show: its id, or 0.
ch_shown_id :: (s: [] ChatState) -> string { si := ch_first(s, 'S'); return ifx si < 0 then "" else ch_cell(s, si, 1); }

// A long text's escapes (\n, \\, \p) undone into md.
ch_decode :: (s: [] ChatState, text: string) -> string {
  n := 0; i := 0;
  while i < text.count && n < CH_MD {
    c := text[i];
    if c == '\\' && i + 1 < text.count {
      e := text[i + 1];
      s[0].md[n] = ifx e == 'n' then '\n' else ifx e == 'p' then '|' else e;
      n += 1; i += 2; continue;
    }
    s[0].md[n] = c; n += 1; i += 1;
  }
  s[0].md_n = n;
  return cast(string) s[0].md[0..<n];
}

// ---------------------------------------------------------------- asking oa-api

ch_put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n < buf.count { buf[n] = c; n += 1; } }
  return n;
}
ch_number :: (buf: [] u8, at: int, n: int) -> int {
  digits: [20] u8; k := 0; x := n;
  if x < 0 { x = 0; }
  if x == 0 { digits[0] = '0'; k = 1; }
  while x > 0 && k < 20 { digits[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1; }
  m := at;
  while k > 0 && m < buf.count { k -= 1; buf[m] = digits[k]; m += 1; }
  return m;
}
ch_ask :: (s: [] ChatState) {
  if s[0].ask_id >= 0 || s[0].ask_n > 0 { return; }
  n := ch_put(s[0].ask[..], 0, "/api/chat/state");
  if s[0].shown >= 0 { n = ch_put(s[0].ask[..], n, "?c="); n = ch_number(s[0].ask[..], n, s[0].shown); }
  s[0].ask_n = n;
  s[0].asked_at = s[0].time;
  if s[0].status == -1 { s[0].status = 0; }
}
// A JSON string's contents into buf.
ch_json :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text {
    if n + 8 >= buf.count { return n; }
    if c == '"' || c == '\\' { buf[n] = '\\'; buf[n + 1] = c; n += 2; }
    else if c == '\n' { buf[n] = '\\'; buf[n + 1] = 'n'; n += 2; }
    else if c < 32 { buf[n] = ' '; n += 1; }
    else { buf[n] = c; n += 1; }
  }
  return n;
}
// A post: {"key": "value", ...} from up to three pairs (an empty key is left out).
ch_post :: (s: [] ChatState, op: string, kind: int, k1: string, v1: string, k2: string, v2: string, k3: string, v3: string) {
  n := ch_put(s[0].post[..], 0, "/api/chat/");
  s[0].post_n = ch_put(s[0].post[..], n, op);
  b := ch_put(s[0].body[..], 0, "{");
  keys := [3] string.[k1, k2, k3]; values := [3] string.[v1, v2, v3];
  first := true;
  for j: 0..<3 {
    if keys[j].count == 0 { continue; }
    if !first { b = ch_put(s[0].body[..], b, ","); }
    first = false;
    b = ch_put(s[0].body[..], b, "\""); b = ch_put(s[0].body[..], b, keys[j]); b = ch_put(s[0].body[..], b, "\":\"");
    b = ch_json(s[0].body[..], b, values[j]);
    b = ch_put(s[0].body[..], b, "\"");
  }
  s[0].body_n = ch_put(s[0].body[..], b, "}");
  s[0].post_kind = kind; s[0].post_id = -1;
}
// The face sent them. A post's body is wiped once sent: a credential stays in the page no longer than that.
coaxial_chat_asked :: (s: [] ChatState, id: int) #export_c { if s.count > 0 { s[0].ask_n = 0; s[0].ask_id = id; } }
coaxial_chat_posted :: (s: [] ChatState, id: int) #export_c {
  if s.count < 1 { return; }
  for i: 0..<s[0].body_n { s[0].body[i] = 0; }
  s[0].post_n = 0; s[0].body_n = 0; s[0].post_id = id;
}
ch_say :: (s: [] ChatState, word: string) { s[0].note_n = ch_put(s[0].note[..], 0, word); s[0].note_at = s[0].time; }
ch_say_key :: (s: [] ChatState, word: string) { s[0].knote_n = ch_put(s[0].knote[..], 0, word); }
ch_go :: (s: [] ChatState, url: string) { s[0].out_n = ch_put(s[0].outbox[..], 0, url); s[0].action = CH_NAVIGATE; }
ch_wipe_key :: (s: [] ChatState) { for i: 0..<CH_KEY { s[0].key[i] = 0; } s[0].key_n = 0; }

// A JSON answer's value for key, as text: a string's contents, or a number's digits.
ch_value :: (bytes: string, from: int, key: string) -> string {
  k := from;
  while k + key.count + 2 <= bytes.count {
    if bytes[k] == '"' && bytes[k + 1..<k + 1 + key.count] == key && bytes[k + 1 + key.count] == '"' {
      a := k + key.count + 2;
      while a < bytes.count && (bytes[a] == ' ' || bytes[a] == ':') { a += 1; }
      if a >= bytes.count { return ""; }
      if bytes[a] == '"' {
        a += 1; b := a;
        while b < bytes.count && bytes[b] != '"' { if bytes[b] == '\\' { b += 1; } b += 1; }
        if b > bytes.count { b = bytes.count; }
        return bytes[a..<b];
      }
      b := a;
      while b < bytes.count && bytes[b] >= '0' && bytes[b] <= '9' { b += 1; }
      return bytes[a..<b];
    }
    k += 1;
  }
  return "";
}
ch_int :: (t: string) -> int {
  n := 0;
  for c: t { if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return ifx t.count == 0 then -1 else n;
}

// An answer: "STATUS\n" then the body.
ch_answer :: (s: [] ChatState, id: int, bytes: string) {
  i := 0; code := 0;
  while i < bytes.count && bytes[i] >= '0' && bytes[i] <= '9' { code = code * 10 + cast(int) (bytes[i] - '0'); i += 1; }
  if i < bytes.count && bytes[i] == '\n' { i += 1; }
  if id == s[0].ask_id {
    s[0].ask_id = -1;
    if code == 200 {
      n := 0;
      while i < bytes.count && n < CH_DATA { s[0].data[n] = bytes[i]; n += 1; i += 1; }
      s[0].data_n = n; ch_index(s); s[0].status = 200;
      // the newest conversation, shown when none was chosen
      if s[0].shown < 0 { k := ch_int(ch_shown_id(s)); if k > 0 { s[0].shown = k; } }
    } else if code == 0 || code >= 500 {
      if s[0].status <= 0 { s[0].status = 599; }      // offline: what was shown stays
    } else {
      s[0].status = code; s[0].data_n = 0; s[0].line_n = 0;   // signed out, or not an admin: nothing stays
    }
    return;
  }
  if id != s[0].post_id { return; }
  s[0].post_id = -1;
  kind := s[0].post_kind; s[0].post_kind = 0;
  err := ch_value(bytes, i, "error");
  if code == 401 || code == 403 { s[0].status = code; s[0].data_n = 0; s[0].line_n = 0; return; }
  if kind == POST_SEND {
    if code == 200 {
      for k: 0..<s[0].text_n { s[0].text[k] = 0; }
      s[0].text_n = 0; s[0].note_n = 0; s[0].back = 0;
      c := ch_int(ch_value(bytes, i, "c"));
      if c > 0 { s[0].shown = c; }
      s[0].model = -1;
    } else if code == 429 && err.count > 0 { ch_say(s, err); }
    else if code == 409 { ch_say(s, "A TURN IS STILL RUNNING"); }
    else { ch_say(s, ifx err.count > 0 then err else "NOT SENT"); }
  } else if kind == POST_MODEL {
    if code == 200 { s[0].model = -1; } else { ch_say(s, ifx err.count > 0 then err else "THE MODEL DIDN'T CHANGE"); }
  } else if kind == POST_STOP {
    if code == 200 { ch_say(s, "STOPPING"); } else { ch_say(s, ifx err.count > 0 then err else "NOT STOPPED"); }
  } else if kind == POST_KEY {
    if code == 200 { s[0].replacing = false; s[0].knote_n = 0; s[0].typing = false; }
    else { ch_say_key(s, ifx err.count > 0 then err else "That key didn't work: no answer"); }
  } else if kind == POST_KEY_REMOVE {
    if code == 200 { s[0].replacing = false; s[0].knote_n = 0; ch_say_key(s, "Removed."); }
  }
  s[0].asked_at = -1000;   // read the state again now
}

// ---------------------------------------------------------------- text

ChFlow :: struct { y: f32; v: int; }
ch_chrome :: (p: Pen, kind: int) -> Ink { k := ink(p, kind); k.sans = false; return k; }
BODY :: 7.5;     // small text's cap, CSS pixels (the sans)
STEP :: 15.0;    // its line

ch_shows :: (s: [] ChatState, base: f32, step: f32) -> bool { return base > s[0].clip0 && base - step < s[0].clip1; }
// Wrapped text, at most lines lines, drawn when draw and inside the clip.
ch_text :: (s: [] ChatState, out: [] f32, f: ChFlow, text: string, x: f32, width: f32, cap: f32, k: Ink, lines: int, draw: bool) -> ChFlow {
  d := s[0].d; step := STEP * d * cap / BODY;
  r := f; from := 0; n := 0;
  next: [1] int;
  while from < text.count && n < lines {
    end := wrap_ink(text, from, width, cap * d, GAP, SPACE, k, next[..]);
    base := r.y + step * 0.8;
    show := draw && ch_shows(s, base, step);
    if n == lines - 1 && next[0] < text.count && next[0] > from {
      if show { r.v = put_fit(out, r.v, text[from..<text.count], x, base, cap * d, k, width); }
      r.y += step; n += 1; break;
    }
    if show { r.v = put(out, r.v, text[from..<end], x, base, cap * d, k); }
    r.y += step; n += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  return r;
}
ch_hit :: (s: [] ChatState, b: Box, id: int) {
  if s[0].hit_n >= CH_HITS { return; }
  s[0].hit_box[s[0].hit_n] = b; s[0].hit_id[s[0].hit_n] = id; s[0].hit_n += 1;
}
ch_chip :: (s: [] ChatState, out: [] f32, v: int, label: string, x: f32, y: f32, id: int, on: bool, p: Pen) -> int {
  cap := 7 * p.d;
  b := chip_box(label, x, y, cap, p);
  ch_hit(s, b, id);
  k := ifx on then ch_chrome(p, INK_ORANGE) else ifx s[0].hot == id then ch_chrome(p, INK_WHITE) else ch_chrome(p, INK_DIM);
  return chip(out, v, label, x, y, cap, k, p);
}
ch_upper :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text {
    if n >= buf.count { return n; }
    buf[n] = ifx c >= 'a' && c <= 'z' then c - 32 else c; n += 1;
  }
  return n;
}
ch_starts :: (t: string, with: string) -> bool { return t.count >= with.count && t[0..<with.count] == with; }
ch_lead :: (t: string) -> int { i := 0; while i < t.count && (t[i] == ' ' || t[i] == '\t') { i += 1; } return i; }

// A Markdown line's inline marks taken out: ** __ ` go, a link [text](url) is "text (url)".
ch_inline :: (line: string, buf: [] u8) -> string {
  n := 0; i := 0;
  while i < line.count && n < buf.count {
    c := line[i];
    if (c == '*' || c == '_') && i + 1 < line.count && line[i + 1] == c { i += 2; continue; }
    if c == '`' { i += 1; continue; }
    if c == '[' {
      close := i + 1;
      while close < line.count && line[close] != ']' { close += 1; }
      if close + 1 < line.count && line[close + 1] == '(' {
        end := close + 2;
        while end < line.count && line[end] != ')' { end += 1; }
        if end < line.count {
          n = ch_put(buf, n, ch_inline_plain(line[i + 1..<close]));
          url := line[close + 2..<end];
          if url != line[i + 1..<close] && ch_starts(url, "http") { n = ch_put(buf, n, " ("); n = ch_put(buf, n, url); n = ch_put(buf, n, ")"); }
          i = end + 1; continue;
        }
      }
    }
    buf[n] = c; n += 1; i += 1;
  }
  return cast(string) buf[0..<n];
}
ch_inline_plain :: (t: string) -> string { return t; }
ch_is_rule :: (t: string) -> bool {
  if t.count < 3 { return false; }
  c := t[0];
  if c != '-' && c != '*' && c != '_' { return false; }
  for x: t { if x != c && x != ' ' { return false; } }
  return true;
}
// A table's |---|---| line.
ch_is_sep :: (t: string) -> bool {
  if t.count < 3 || t[0] != '|' { return false; }
  for x: t { if x != '|' && x != '-' && x != ':' && x != ' ' { return false; } }
  return true;
}

// An answer's Markdown, drawn cleanly.
ch_markdown :: (s: [] ChatState, out: [] f32, f: ChFlow, text: string, x0: f32, x1: f32, p: Pen, draw: bool) -> ChFlow {
  d := p.d; r := f;
  pale := ink(p, INK_PALE); white := ink(p, INK_WHITE); dim := ink(p, INK_DIM);
  code := false; code_y := 0.0f32;
  i := 0;
  buf: [4096] u8;
  while i < text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    raw := text[i..<j];
    i = j + 1;
    lead := ch_lead(raw);
    line := raw[lead..<raw.count];
    if ch_starts(line, "```") {
      if !code { code = true; r.y += 3 * d; code_y = r.y; }
      else {
        code = false;
        if draw && r.y > s[0].clip0 && code_y < s[0].clip1 {
          r.v = rule(out, r.v, x0 + 2 * d, hi(code_y, s[0].clip0), x0 + 2 * d, lo(r.y, s[0].clip1), ink(p, INK_ORANGE), 0.45 * p.fade);
        }
        r.y += 5 * d;
      }
      continue;
    }
    if code {
      if raw.count == 0 { r.y += 9 * d; continue; }
      r = ch_text(s, out, r, raw, x0 + 12 * d, x1 - x0 - 12 * d, 6.5, ink(p, INK_DIM), 60, draw);
      continue;
    }
    if line.count == 0 { r.y += 6 * d; continue; }
    if ch_is_sep(line) { continue; }
    if ch_is_rule(line) {
      if draw && ch_shows(s, r.y + 8 * d, 8 * d) { r.v = rule(out, r.v, x0, r.y + 6 * d, x1, r.y + 6 * d, dim, 0.3 * p.fade); }
      r.y += 12 * d; continue;
    }
    hashes := 0;
    while hashes < line.count && hashes < 6 && line[hashes] == '#' { hashes += 1; }
    if hashes > 0 && hashes < line.count && line[hashes] == ' ' {
      r.y += 5 * d;
      cap := ifx hashes == 1 then 10.0f32 else ifx hashes == 2 then 9.0f32 else 8.0f32;
      r = ch_text(s, out, r, ch_inline(line[hashes + 1..<line.count], buf[..]), x0, x1 - x0, cap, white, 4, draw);
      r.y += 2 * d;
      continue;
    }
    if ch_starts(line, "> ") || line == ">" {
      y0 := r.y;
      body := ifx line.count > 2 then line[2..<line.count] else "";
      r = ch_text(s, out, r, ch_inline(body, buf[..]), x0 + 12 * d, x1 - x0 - 12 * d, BODY, dim, 40, draw);
      if draw && r.y > s[0].clip0 && y0 < s[0].clip1 { r.v = rule(out, r.v, x0 + 3 * d, hi(y0 + 3 * d, s[0].clip0), x0 + 3 * d, lo(r.y - 2 * d, s[0].clip1), dim, 0.4 * p.fade); }
      continue;
    }
    indent := cast(f32) (lead / 2) * 12 * d;
    if indent > 48 * d { indent = 48 * d; }
    if (ch_starts(line, "- ") || ch_starts(line, "* ") || ch_starts(line, "+ ")) {
      by := r.y + STEP * d * 0.8 - 3.5 * d;
      if draw && ch_shows(s, by + 3 * d, STEP * d) { r.v = diamond(out, r.v, x0 + indent + 4 * d, by, 2.2 * d, ink(p, INK_ORANGE), 0.8 * p.fade); }
      r = ch_text(s, out, r, ch_inline(line[2..<line.count], buf[..]), x0 + indent + 14 * d, x1 - x0 - indent - 14 * d, BODY, pale, 40, draw);
      continue;
    }
    digits := 0;
    while digits < line.count && digits < 3 && line[digits] >= '0' && line[digits] <= '9' { digits += 1; }
    if digits > 0 && digits + 1 < line.count && (line[digits] == '.' || line[digits] == ')') && line[digits + 1] == ' ' {
      base := r.y + STEP * d * 0.8;
      if draw && ch_shows(s, base, STEP * d) { r.v = put(out, r.v, line[0..<digits + 1], x0 + indent, base, 6.5 * d, ch_chrome(p, INK_ORANGE)); }
      r = ch_text(s, out, r, ch_inline(line[digits + 2..<line.count], buf[..]), x0 + indent + 18 * d, x1 - x0 - indent - 18 * d, BODY, pale, 40, draw);
      continue;
    }
    r = ch_text(s, out, r, ch_inline(line, buf[..]), x0, x1 - x0, BODY, pale, 200, draw);
  }
  if code && draw && r.y > s[0].clip0 && code_y < s[0].clip1 {
    r.v = rule(out, r.v, x0 + 2 * d, hi(code_y, s[0].clip0), x0 + 2 * d, lo(r.y, s[0].clip1), ink(p, INK_ORANGE), 0.45 * p.fade);
  }
  return r;
}

// ---------------------------------------------------------------- the conversation

// What a running turn is doing now: "READING COAX/WEB/RELEASE.SH".
ch_working :: (s: [] ChatState, i: int, buf: [] u8) -> int {
  w := ch_cell(s, i, 9);
  if w.count == 0 { return ch_put(buf, 0, "THINKING"); }
  return ch_upper(buf, 0, w);
}
// Each turn: the message, the answer, what it used, and STOP while it runs.
ch_turns :: (s: [] ChatState, out: [] f32, f: ChFlow, x0: f32, x1: f32, p: Pen, draw: bool) -> ChFlow {
  d := p.d; r := f;
  n := ch_count(s, 'U');
  if n == 0 {
    r = ch_text(s, out, r, "Ask anything about OpenAgents. The agent reads a fresh copy of the public openagents repository (main) and the web, and says which files it read. It can't change anything.",
                x0, x1 - x0, BODY, ink(p, INK_FAINT), 6, draw);
    return r;
  }
  for k: 0..<n {
    i := ch_nth(s, 'U', k);
    status := ch_cell(s, i, 2);
    // the message
    base := r.y + 10 * d;
    if draw && ch_shows(s, base, 12 * d) {
      r.v = put(out, r.v, "YOU", x0, base, 6 * d, ch_chrome(p, INK_DIM));
      r.v = put_right(out, r.v, ch_cell(s, i, 3), x1, base, 6.5 * d, ink(p, INK_FAINT));
    }
    r.y += 13 * d;
    r = ch_text(s, out, r, ch_decode(s, ch_cell(s, i, 6)), x0, x1 - x0, BODY, ink(p, INK_WHITE), 120, draw);
    r.y += 10 * d;
    // who answered, on what
    buf: [160] u8;
    m := ch_put(buf[..], 0, ch_model_name(ch_cell(s, i, 4)));
    cred := ch_cell(s, i, 5);
    if cred == "own" { m = ch_put(buf[..], m, " · YOUR KEY"); }
    else if cred == "openagents" { m = ch_put(buf[..], m, " · OPENAGENTS KEY"); }
    cost := ch_cell(s, i, 10);
    if cred == "openagents" && cost.count > 0 && status != "queued" && status != "running" { m = ch_put(buf[..], m, " · $"); m = ch_put(buf[..], m, cost); }
    base = r.y + 10 * d;
    if draw && ch_shows(s, base, 12 * d) { r.v = put_fit(out, r.v, cast(string) buf[0..<m], x0, base, 6 * d, ch_chrome(p, INK_ORANGE), x1 - x0); }
    r.y += 13 * d;
    // the tools it used
    tools := 0;
    for j: 0..<s[0].line_n {
      if ch_kind(s, j) != 'T' || ch_cell(s, j, 1) != ch_cell(s, i, 1) { continue; }
      tb: [260] u8;
      q := ch_put(tb[..], 0, ch_cell(s, j, 2));
      det := ch_cell(s, j, 3);
      if det.count > 0 { q = ch_put(tb[..], q, " "); q = ch_put(tb[..], q, det); }
      y0 := r.y;
      r = ch_text(s, out, r, cast(string) tb[0..<q], x0 + 10 * d, x1 - x0 - 10 * d, 6.5, ink(p, INK_DIM), 1, draw);
      if draw && ch_shows(s, r.y, 12 * d) { r.v = rule(out, r.v, x0 + 3 * d, y0 + 4 * d, x0 + 3 * d, r.y - 2 * d, ink(p, INK_ORANGE), 0.4 * p.fade); }
      tools += 1;
    }
    if tools > 0 { r.y += 4 * d; }
    answer := ch_cell(s, i, 7);
    if answer.count > 0 { r = ch_markdown(s, out, r, ch_decode(s, answer), x0, x1, p, draw); }
    err := ch_cell(s, i, 8);
    if err.count > 0 && (status == "failed" || status == "refused" || status == "stopped") {
      r.y += 2 * d;
      r = ch_text(s, out, r, err, x0, x1 - x0, 6.5, ch_chrome(p, INK_ORANGE), 4, draw);
    }
    if status == "running" || status == "queued" {
      wb: [200] u8;
      w := ifx status == "queued" then ch_put(wb[..], 0, "WAITING") else ch_working(s, i, wb[..]);
      y := r.y + 14 * d;
      sw := chip_width("STOP", 7 * d, p);
      if draw && ch_shows(s, y, 14 * d) {
        pulse := 0.6 + 0.4 * ease(0.5 + 0.5 * sin(s[0].time * 4));
        wk := ch_chrome(p, INK_ORANGE); wk.light *= pulse;
        r.v = put_fit(out, r.v, cast(string) wb[0..<w], x0, y, 6 * d, wk, x1 - x0 - sw - 12 * d);
        r.v = ch_chip(s, out, r.v, "STOP", x1 - sw, y, H_STOP, false, p);
      }
      r.y = y + 8 * d;
    } else if status == "stopped" || status == "failed" || status == "refused" {
      word := ifx status == "stopped" then "STOPPED" else ifx status == "refused" then "NOT RUN" else "FAILED";
      y := r.y + 12 * d;
      if draw && ch_shows(s, y, 12 * d) { r.v = put(out, r.v, word, x0, y, 6 * d, ch_chrome(p, INK_DIM)); }
      r.y = y + 4 * d;
    }
    r.y += 18 * d;
  }
  return r;
}

// ---------------------------------------------------------------- the field, the models, KEY

ch_typed :: (s: [] ChatState, which: int) -> string {
  if which == 1 { return cast(string) s[0].key[0..<s[0].key_n]; }
  return cast(string) s[0].text[0..<s[0].text_n];
}
// A field; the host's keyboard field sits over the focused one. The key's is drawn masked.
ch_field :: (s: [] ChatState, out: [] f32, v0: int, fb: Box, p: Pen, which: int, hint: string, hfield: int) -> int {
  d := p.d; v := v0;
  on := s[0].typing && s[0].focus == which;
  typed := ch_typed(s, which);
  k := ifx on then ink(p, INK_ORANGE) else ink(p, INK_DIM);
  v = rule(out, v, fb.x0, fb.y1, fb.x1, fb.y1, k, ifx on then 0.9 * p.fade else 0.45 * p.fade);
  v = rule(out, v, fb.x0, fb.y0 + 8 * d, fb.x0, fb.y1, k, 0.3 * p.fade);
  tx := fb.x0 + 8 * d; base := fb.y1 - 10 * d; room := box_w(fb) - 20 * d;
  white := ink(p, INK_WHITE);
  caret_x := tx;
  if typed.count == 0 {
    if !on { v = put_fit(out, v, hint, tx, base, BODY * d, ink(p, INK_FAINT), room); }
  } else if which == 1 {
    stars: [64] u8;
    n := ifx typed.count < 40 then typed.count else 40;
    for q: 0..<n { stars[q] = '*'; }
    v = put_fit(out, v, cast(string) stars[0..<n], tx, base, BODY * d, white, room);
    caret_x = tx + lo(ink_width(cast(string) stars[0..<n], BODY * d, GAP, SPACE, white), room) + 1.5 * d;
  } else {
    from := 0;
    while from < typed.count && ink_width(typed[from..<typed.count], BODY * d, GAP, SPACE, white) > room {
      from += decode(typed, from).len;
    }
    v = put(out, v, typed[from..<typed.count], tx, base, BODY * d, white);
    caret_x = tx + ink_width(typed[from..<typed.count], BODY * d, GAP, SPACE, white) + 1.5 * d;
  }
  if on && (cast(int) (s[0].time * 2)) % 2 == 0 {
    v = rule(out, v, caret_x, base - 11 * d, caret_x, base + 3 * d, ink(p, INK_ORANGE), p.fade);
  }
  ch_hit(s, fb, hfield);
  if on || !s[0].typing { s[0].field[0] = fb.x0; s[0].field[1] = fb.y0; s[0].field[2] = fb.x1; s[0].field[3] = fb.y1; }
  return v;
}
// On a phone the line above the models may take two lines.
ch_composer_h :: (s: [] ChatState) -> f32 { return ifx s[0].width / s[0].d < 700 then 104 * s[0].d else 92 * s[0].d; }
// Under the conversation: what the next turn spends, the cap, the models, the field and SEND.
ch_composer :: (s: [] ChatState, out: [] f32, v0: int, b: Box, p: Pen) -> int {
  d := p.d; v := v0;
  x0 := b.x0 + 14 * d; x1 := b.x1 - 14 * d;
  // the line above: the note, the cap, or what the turn will use
  y := b.y0 + 16 * d;
  buf: [320] u8;
  m := 0;
  orange := false;
  if s[0].note_n > 0 && s[0].time - s[0].note_at < 12 { m = ch_put(buf[..], 0, cast(string) s[0].note[0..<s[0].note_n]); orange = true; }
  else if ch_capped(s) {
    m = ch_put(buf[..], 0, "TODAY'S $"); m = ch_put(buf[..], m, ch_z(s, 2)); m = ch_put(buf[..], m, " FOR /CHAT IS USED UP. SAVE YOUR OWN KEY UNDER KEY, OR COME BACK TOMORROW.");
    orange = true;
  } else if ch_has_key(s) {
    m = ch_put(buf[..], 0, "YOUR KEY · ");
    m = ch_put(buf[..], m, ifx ch_z(s, 3) == "oauth" then "CLAUDE SUBSCRIPTION" else "ANTHROPIC API KEY");
    if ch_z(s, 5) == "1" { m = ch_put(buf[..], m, " · EXPIRED: MAKE A NEW ONE UNDER KEY"); orange = true; }
  } else if ch_first(s, 'Z') >= 0 {
    m = ch_put(buf[..], 0, "OPENAGENTS KEY · $"); m = ch_put(buf[..], m, ch_z(s, 1)); m = ch_put(buf[..], m, " OF $"); m = ch_put(buf[..], m, ch_z(s, 2)); m = ch_put(buf[..], m, " TODAY");
  }
  two := s[0].width / d < 700;
  if m > 0 {
    s[0].clip0 = 0; s[0].clip1 = s[0].height;
    r := ch_text(s, out, ChFlow.{y = y - 9 * d, v = v}, cast(string) buf[0..<m], x0, x1 - x0, 6, ch_chrome(p, ifx orange then INK_ORANGE else INK_DIM), ifx two then 2 else 1, true);
    v = r.v;
  }
  // the models
  cy := b.y0 + (ifx two then 50.0f32 else 38.0f32) * d;
  cx := x0;
  chosen := ch_model(s);
  for k: 0..<3 {
    v = ch_chip(s, out, v, MODEL_NAMES[k], cx, cy, H_MODEL + k, k == chosen, p);
    cx += chip_width(MODEL_NAMES[k], 7 * d, p) + 6 * d;
  }
  // the field, and SEND or STOP
  busy := ch_busy(s);
  word := ifx busy then "STOP" else "SEND";
  sw := chip_width(word, 7 * d, p);
  fb := Box.{x0 = x0, y0 = b.y1 - 40 * d, x1 = x1 - sw - 10 * d, y1 = b.y1 - 10 * d};
  v = ch_field(s, out, v, fb, p, 0, ifx ch_shown_id(s).count > 0 && s[0].shown != 0 then "Ask a follow-up" else "Ask the OpenAgents agent", H_FIELD);
  v = ch_chip(s, out, v, word, x1 - sw, fb.y1 - 6 * d, ifx busy then H_STOP else H_SEND, !busy && s[0].text_n > 0 && s[0].typing && s[0].focus == 0, p);
  return v;
}
// KEY: the saved credential (its kind and last four, REPLACE, REMOVE), or the field to paste one.
ch_key_panel :: (s: [] ChatState, out: [] f32, v0: int, b: Box, p: Pen) -> int {
  d := p.d; v := v0;
  x0 := b.x0 + 14 * d; x1 := b.x1 - 14 * d;
  v = titled(out, v, b, "KEY", "YOURS, NOT OURS", p);
  r := ChFlow.{y = b.y0 + title_room(p) + 6 * d, v = v};
  s[0].clip0 = b.y0; s[0].clip1 = b.y1;
  r = ch_text(s, out, r, "Use your own Anthropic API key or Claude subscription. Turns on it cost you, not us, and have no daily limit here. It is checked, then kept encrypted; only the agent's runner can open it, and it is never shown again.",
              x0, x1 - x0, BODY, ink(p, INK_DIM), 6, true);
  r.y += 10 * d;
  kind := ch_z(s, 3);
  if kind.count > 0 && !s[0].replacing {
    buf: [120] u8;
    m := ch_put(buf[..], 0, ifx kind == "oauth" then "Claude subscription token" else "Anthropic API key");
    m = ch_put(buf[..], m, " ending ");
    m = ch_put(buf[..], m, ch_z(s, 4));
    r = ch_text(s, out, r, cast(string) buf[0..<m], x0, x1 - x0, 8.5, ink(p, INK_WHITE), 2, true);
    if ch_z(s, 5) == "1" { r = ch_text(s, out, r, "EXPIRED: make a new one with claude setup-token and REPLACE it.", x0, x1 - x0, 6.5, ch_chrome(p, INK_ORANGE), 2, true); }
    y := r.y + 18 * d;
    v = r.v;
    v = ch_chip(s, out, v, "REPLACE", x0, y, H_REPLACE, false, p);
    v = ch_chip(s, out, v, "REMOVE", x0 + chip_width("REPLACE", 7 * d, p) + 8 * d, y, H_REMOVE, false, p);
    r.v = v; r.y = y + 16 * d;
  } else {
    r = ch_text(s, out, r, "Anthropic API key (sk-ant-api...), or Claude subscription token (from claude setup-token)", x0, x1 - x0, 6.5, ch_chrome(p, INK_DIM), 3, true);
    word := ifx s[0].post_kind == POST_KEY then "CHECKING" else "SAVE";
    sw := chip_width(word, 7 * d, p);
    fb := Box.{x0 = x0, y0 = r.y + 2 * d, x1 = x1 - sw - 10 * d, y1 = r.y + 32 * d};
    r.v = ch_field(s, out, r.v, fb, p, 1, "Paste it here", H_KFIELD);
    r.v = ch_chip(s, out, r.v, word, x1 - sw, fb.y1 - 6 * d, H_KSAVE, s[0].key_n > 0 && s[0].post_kind != POST_KEY, p);
    r.y = fb.y1 + 12 * d;
    r = ch_text(s, out, r, "For a subscription: run claude setup-token, approve in the browser, and paste the token it prints here.", x0, x1 - x0, 6.5, ink(p, INK_FAINT), 3, true);
  }
  if s[0].knote_n > 0 { r.y += 4 * d; r = ch_text(s, out, r, cast(string) s[0].knote[0..<s[0].knote_n], x0, x1 - x0, 7, ch_chrome(p, INK_ORANGE), 4, true); }
  cw := chip_width("CLOSE", 7 * d, p);
  r.v = ch_chip(s, out, r.v, "CLOSE", x1 - cw, b.y0 + 17 * d, H_CLOSE, false, p);
  return frame(out, r.v, b, 10 * d, p);
}

// The conversations, newest first, and NEW CHAT.
ch_list :: (s: [] ChatState, out: [] f32, v0: int, b: Box, p: Pen) -> int {
  d := p.d; v := v0;
  x0 := b.x0 + 14 * d; x1 := b.x1 - 14 * d;
  n := ch_count(s, 'C');
  note: [32] u8;
  q := ch_number(note[..], 0, n);
  v = titled(out, v, b, "CHATS", cast(string) note[0..<q], p);
  y := b.y0 + title_room(p) + 14 * d;
  v = ch_chip(s, out, v, "NEW CHAT", x0, y, H_NEW, s[0].shown == 0, p);
  y += 22 * d;
  white := ink(p, INK_WHITE);
  for k: 0..<n {
    if y + 30 * d > b.y1 - 8 * d || k >= 28 { break; }
    i := ch_nth(s, 'C', k);
    on := ch_int(ch_cell(s, i, 1)) == s[0].shown;
    hot := s[0].hot == H_CONV + k;
    title := ch_cell(s, i, 2);
    if title.count == 0 { title = "(no words)"; }
    v = put_fit(out, v, title, x0, y + 10 * d, BODY * d, ifx on then ch_chrome(p, INK_ORANGE) else ifx hot then white else ink(p, INK_PALE), x1 - x0);
    meta: [80] u8;
    m := ch_put(meta[..], 0, ch_model_name(ch_cell(s, i, 3)));
    m = ch_put(meta[..], m, " · "); m = ch_upper(meta[..], m, ch_cell(s, i, 4));
    if ch_cell(s, i, 5) == "1" { m = ch_put(meta[..], m, " · WORKING"); }
    v = put_fit(out, v, cast(string) meta[0..<m], x0, y + 24 * d, 5.5 * d, ch_chrome(p, INK_DIM), x1 - x0);
    ch_hit(s, Box.{x0 = b.x0 + 4 * d, y0 = y - 2 * d, x1 = b.x1 - 4 * d, y1 = y + 30 * d}, H_CONV + k);
    y += 38 * d;
  }
  return frame(out, v, b, 10 * d, p);
}

// ---------------------------------------------------------------- the frame

ch_header :: (s: [] ChatState, out: [] f32, v0: int, b: Box, p: Pen, wide: bool) -> int {
  d := p.d; v := v0;
  white := ch_chrome(p, INK_WHITE); dim := ch_chrome(p, INK_DIM);
  x := b.x0 + 18 * d; right := b.x1 - 14 * d;
  cy := b.y0 + 26 * d;
  v = put(out, v, "OPENAGENTS", x, cy, 7 * d, ifx s[0].hot == H_HOME then white else dim);
  w1 := text_width("OPENAGENTS", 7 * d);
  ch_hit(s, Box.{x0 = x - 4 * d, y0 = cy - 14 * d, x1 = x + w1 + 4 * d, y1 = cy + 6 * d}, H_HOME);
  crumb := x + w1 + SPACE * 7 * d;
  v = put(out, v, "/", crumb, cy, 7 * d, dim);
  px := crumb + text_width("/", 7 * d) + SPACE * 7 * d;
  v = put(out, v, "CHAT", px, cy, 7 * d, ch_chrome(p, INK_ORANGE));
  kw := chip_width("KEY", 7 * d, p);
  v = ch_chip(s, out, v, "KEY", right - kw, cy, H_KEY, s[0].keying, p);
  if !wide {
    nw := chip_width("NEW", 7 * d, p); cw := chip_width("CHATS", 7 * d, p);
    v = ch_chip(s, out, v, "NEW", right - kw - nw - 8 * d, cy, H_NEW, false, p);
    v = ch_chip(s, out, v, "CHATS", right - kw - nw - cw - 16 * d, cy, H_CHATS, s[0].listing, p);
  } else {
    si := ch_first(s, 'S');
    if si >= 0 && s[0].shown != 0 {
      t0 := px + text_width("CHAT", 7 * d) + 24 * d;
      v = put_fit(out, v, ch_cell(s, si, 2), t0, cy, BODY * d, ink(p, INK_PALE), right - kw - 24 * d - t0);
    }
  }
  return frame(out, v, b, 10 * d, p);
}

// Signed out, or not an admin: LOG IN and nothing else.
ch_locked :: (s: [] ChatState, out: [] f32, p: Pen) -> int {
  d := p.d; w := s[0].width; h := s[0].height;
  white := ch_chrome(p, INK_WHITE); dim := ch_chrome(p, INK_DIM);
  m := ifx w / d < 700 then 12.0f32 else 24.0f32;
  x := (m + 18) * d; cy := (m + 22) * d;
  v := put(out, 0, "OPENAGENTS", x, cy, 7 * d, ifx s[0].hot == H_HOME then white else dim);
  w1 := text_width("OPENAGENTS", 7 * d);
  ch_hit(s, Box.{x0 = x - 4 * d, y0 = cy - 14 * d, x1 = x + w1 + 4 * d, y1 = cy + 6 * d}, H_HOME);
  cap := 9 * d;
  sw := chip_width("LOG IN", cap, p);
  b := chip_box("LOG IN", (w - sw) * 0.5, h * 0.5, cap, p);
  ch_hit(s, b, H_SIGNIN);
  return chip(out, v, "LOG IN", (w - sw) * 0.5, h * 0.5, cap, ifx s[0].hot == H_SIGNIN then ch_chrome(p, INK_ORANGE) else white, p);
}

ch_signed_out :: (s: [] ChatState) -> bool { return s[0].status == 401 || s[0].status == 403 || s[0].status == 404; }

coaxial_chat_frame :: (s: [] ChatState, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  if !s[0].ready { s[0].ready = true; s[0].hot = -1; s[0].press = -1; s[0].status = -1; s[0].ask_id = -1; s[0].post_id = -1; s[0].shown = -1; s[0].model = -1; }
  s[0].time += clamp(dt, 0, 0.1);
  if !ch_signed_out(s) {
    wait := ifx ch_busy(s) then 2.0f32 else 30.0f32;   // CH_BUSY, CH_REFRESH
    if s[0].status == -1 || s[0].time - s[0].asked_at >= wait { ch_ask(s); }
  }
  time := ifx still then 20.0f32 else s[0].time;
  d := hi(dpr, 1);
  s[0].width = width; s[0].height = height; s[0].d = d;
  s[0].hit_n = 0;
  p := Pen.{d = d, fade = ifx still then 1.0f32 else ease(time / 0.6), time = time};
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = 20 + time; uniforms[3] = p.fade;
  uniforms[4] = ifx still then 1.0f32 else 0.0f32; uniforms[5] = 2; uniforms[6] = 0; uniforms[7] = 0;
  for k: 0..<PANELS { glass(uniforms, k, Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0}, 0, 0); }
  if ch_signed_out(s) { s[0].typing = false; return ch_locked(s, out, p); }
  if s[0].status <= 0 || (s[0].status == 599 && s[0].line_n == 0) {
    s[0].typing = false;
    word := ifx s[0].status == 599 then "OFFLINE" else "LOADING";
    return put(out, 0, word, (width - text_width(word, 10 * d)) * 0.5, height * 0.5, 10 * d, ch_chrome(p, INK_DIM));
  }
  w := width / d;
  m := ifx w < 700 then 12.0f32 else 24.0f32;
  g := 10 * d;
  wide := w >= 900;
  head := Box.{x0 = m * d, y0 = m * d, x1 = width - m * d, y1 = m * d + 44 * d};
  glass(uniforms, 0, head, 10 * d, 0.92);
  v := ch_header(s, out, 0, head, p, wide);
  top := head.y1 + g; bottom := height - m * d;
  left := m * d;
  if wide {
    lb := Box.{x0 = m * d, y0 = top, x1 = m * d + 270 * d, y1 = bottom};
    glass(uniforms, 1, lb, 10 * d, 0.92);
    v = ch_list(s, out, v, lb, p);
    left = lb.x1 + g;
  }
  area := Box.{x0 = left, y0 = top, x1 = width - m * d, y1 = bottom};
  if s[0].keying {
    glass(uniforms, 2, area, 10 * d, 0.92);
    return ch_key_panel(s, out, v, area, p);
  }
  if !wide && s[0].listing {
    if s[0].typing && s[0].focus == 0 { s[0].typing = false; }
    glass(uniforms, 2, area, 10 * d, 0.92);
    return ch_list(s, out, v, area, p);
  }
  comp := Box.{x0 = area.x0, y0 = bottom - ch_composer_h(s), x1 = area.x1, y1 = bottom};
  conv := Box.{x0 = area.x0, y0 = top, x1 = area.x1, y1 = comp.y0 - g};
  glass(uniforms, 2, conv, 10 * d, 0.92);
  glass(uniforms, 3, comp, 10 * d, 0.92);
  inner := ifx w < 700 then 14 * d else 22 * d;
  x0 := conv.x0 + inner; x1 := conv.x1 - inner;
  // measured, then drawn from the end up: the newest at the bottom unless scrolled back
  view0 := conv.y0 + 10 * d; view1 := conv.y1 - 8 * d;
  measured := ch_turns(s, out, ChFlow.{y = 0, v = v}, x0, x1, p, false);
  s[0].content = measured.y;
  room := view1 - view0;
  s[0].back = clamp(s[0].back, 0, hi(0, s[0].content - room));
  start := ifx s[0].content <= room then view0 else view1 - s[0].content + s[0].back;
  s[0].clip0 = view0 - 2 * d; s[0].clip1 = view1;
  drawn := ch_turns(s, out, ChFlow.{y = start, v = v}, x0, x1, p, true);
  v = drawn.v;
  v = frame(out, v, conv, 10 * d, p);
  v = ch_composer(s, out, v, comp, p);
  return frame(out, v, comp, 10 * d, p);
}

// ---------------------------------------------------------------- input

ch_hit_at :: (s: [] ChatState, x: f32, y: f32) -> int {
  for i: 0..<s[0].hit_n { if inside(s[0].hit_box[i], x, y) { return s[0].hit_id[i]; } }
  return -1;
}
ch_trim :: (text: string) -> string {
  a := 0; b := text.count;
  while a < b && (text[a] == ' ' || text[a] == '\n') { a += 1; }
  while b > a && (text[b - 1] == ' ' || text[b - 1] == '\n') { b -= 1; }
  return text[a..<b];
}
ch_send :: (s: [] ChatState) {
  if s[0].post_kind != 0 || ch_busy(s) { return; }
  text := ch_trim(cast(string) s[0].text[0..<s[0].text_n]);
  if text.count == 0 { return; }
  c: [24] u8;
  cn := 0;
  if s[0].shown > 0 { cn = ch_number(c[..], 0, s[0].shown); }
  ch_post(s, "send", POST_SEND, ifx cn > 0 then "c" else "", cast(string) c[0..<cn], "text", text, "model", MODELS[ch_model(s)]);
}
ch_save_key :: (s: [] ChatState) {
  if s[0].post_kind != 0 { return; }
  key := ch_trim(cast(string) s[0].key[0..<s[0].key_n]);
  if key.count == 0 { return; }
  ch_say_key(s, "Checking the key...");
  ch_post(s, "key", POST_KEY, "credential", key, "", "", "", "");
  ch_wipe_key(s);
}
ch_choose_model :: (s: [] ChatState, k: int) {
  if k < 0 || k >= 3 { return; }
  s[0].model = k;
  // a conversation shown keeps it: the next turn uses it
  if s[0].shown > 0 && s[0].post_kind == 0 {
    c: [24] u8;
    cn := ch_number(c[..], 0, s[0].shown);
    ch_post(s, "model", POST_MODEL, "c", cast(string) c[0..<cn], "model", MODELS[k], "", "");
  }
}
ch_act :: (s: [] ChatState, target: int) {
  if target != H_FIELD && target != H_SEND && target != H_KFIELD && target != H_KSAVE && (target < H_MODEL || target >= H_MODEL + 3) { s[0].typing = false; }
  if target == H_HOME { ch_go(s, "/"); }
  else if target == H_SIGNIN { ch_go(s, "/login"); }
  else if target == H_NEW { s[0].shown = 0; s[0].listing = false; s[0].keying = false; s[0].back = 0; s[0].asked_at = -1000; s[0].typing = true; s[0].focus = 0; }
  else if target == H_CHATS { s[0].listing = !s[0].listing; s[0].keying = false; }
  else if target == H_KEY { s[0].keying = !s[0].keying; s[0].listing = false; s[0].knote_n = 0; s[0].replacing = false; ch_wipe_key(s); }
  else if target == H_CLOSE { s[0].keying = false; s[0].replacing = false; ch_wipe_key(s); }
  else if target == H_FIELD { s[0].typing = true; s[0].focus = 0; }
  else if target == H_SEND { s[0].focus = 0; ch_send(s); }
  else if target == H_STOP {
    if s[0].shown > 0 && s[0].post_kind == 0 {
      c: [24] u8;
      cn := ch_number(c[..], 0, s[0].shown);
      ch_post(s, "stop", POST_STOP, "c", cast(string) c[0..<cn], "", "", "", "");
    }
  }
  else if target == H_KFIELD { s[0].typing = true; s[0].focus = 1; }
  else if target == H_KSAVE { s[0].focus = 1; ch_save_key(s); }
  else if target == H_REPLACE { s[0].replacing = true; s[0].knote_n = 0; s[0].typing = true; s[0].focus = 1; }
  else if target == H_REMOVE { if s[0].post_kind == 0 { ch_post(s, "key_remove", POST_KEY_REMOVE, "", "", "", "", "", ""); } }
  else if target >= H_MODEL && target < H_MODEL + 3 { ch_choose_model(s, target - H_MODEL); }
  else if target >= H_CONV && target < H_CONV + 60 {
    i := ch_nth(s, 'C', target - H_CONV);
    if i >= 0 { s[0].shown = ch_int(ch_cell(s, i, 1)); s[0].model = -1; s[0].listing = false; s[0].back = 0; s[0].asked_at = -1000; }
  }
}

coaxial_chat_pointer :: (s: [] ChatState, x: f32, y: f32, phase: int, kind: int) -> bool #export_c {
  if s.count < 1 { return false; }
  d := hi(s[0].d, 1);
  if phase == P_DOWN {
    s[0].press = ch_hit_at(s, x, y); s[0].press_x = x; s[0].press_y = y; s[0].drag_y = y; s[0].dragged = false;
    s[0].hot = ifx kind == 0 then s[0].press else -1;
    return true;
  }
  if phase == P_MOVE {
    if kind == 0 { s[0].hot = ch_hit_at(s, x, y); }
    if kind != 0 || s[0].press != -1 {
      if absf(y - s[0].press_y) > 10 * d || absf(x - s[0].press_x) > 10 * d { s[0].dragged = true; }
      if s[0].dragged && kind != 0 { s[0].back += y - s[0].drag_y; }
      s[0].drag_y = y;
    }
    return true;
  }
  if phase == P_UP {
    target := ch_hit_at(s, x, y);
    if !s[0].dragged {
      if target == s[0].press && target != -1 { ch_act(s, target); }
      else if target == -1 { s[0].typing = false; }
    }
    s[0].press = -1;
    if kind != 0 { s[0].hot = -1; }
    return true;
  }
  s[0].press = -1;
  return true;
}

// Typed or pasted text into the focused field; the key's takes no spaces or line breaks.
ch_type :: (s: [] ChatState, text: string) {
  for c: text {
    if s[0].focus == 1 {
      if c <= ' ' { continue; }
      if s[0].key_n >= CH_KEY { return; }
      s[0].key[s[0].key_n] = c; s[0].key_n += 1;
    } else {
      t := ifx c == '\r' || c == '\t' then ' ' else c;
      if s[0].text_n >= CH_TEXT { return; }
      s[0].text[s[0].text_n] = t; s[0].text_n += 1;
    }
  }
}
coaxial_chat_key :: (s: [] ChatState, key: int) -> bool #export_c {
  if s.count < 1 { return false; }
  d := hi(s[0].d, 1);
  if s[0].typing {
    if key == K_ENTER { if s[0].focus == 1 { ch_save_key(s); } else { ch_send(s); } return true; }
    if key == K_ESC { s[0].typing = false; return true; }
    if key == K_BACK {
      if s[0].focus == 1 {
        if s[0].key_n > 0 { s[0].key_n -= 1; s[0].key[s[0].key_n] = 0; }
      } else if s[0].text_n > 0 {
        n := s[0].text_n - 1;
        while n > 0 && (s[0].text[n] & 0xC0) == 0x80 { n -= 1; }   // a whole UTF-8 character
        s[0].text_n = n;
      }
      return true;
    }
    if key >= 32 {
      buf: [4] u8;
      n := encode(cast(u32) key, buf[..], 0);
      ch_type(s, cast(string) buf[0..<n]);
      return true;
    }
    return false;
  }
  if key == K_ESC && (s[0].keying || s[0].listing) { s[0].keying = false; s[0].listing = false; ch_wipe_key(s); return true; }
  if key == K_UP { s[0].back += 40 * d; return true; }
  if key == K_DOWN { s[0].back -= 40 * d; return true; }
  if key == -10 { s[0].back += s[0].height * 0.8; return true; }
  if key == -11 { s[0].back -= s[0].height * 0.8; return true; }
  if key == K_HOME { s[0].back = 1000000000; return true; }
  if key == K_END { s[0].back = 0; return true; }
  return false;
}
coaxial_chat_wheel :: (s: [] ChatState, dy: f32) #export_c { if s.count > 0 { s[0].back -= dy * hi(s[0].d, 1); } }
coaxial_chat_message :: (s: [] ChatState, kind: int, length: int) #export_c {
  if s.count < 1 || length < 0 || length > CH_INBOX { return; }
  text := cast(string) s[0].inbox[0..<length];
  if kind >= CH_HTTP && kind < CH_HTTP + 8 { ch_answer(s, kind - CH_HTTP, text); return; }
  if kind == CH_TYPED { if s[0].typing { ch_type(s, text); } return; }
  if kind == CH_SHOWN && s[0].status == 200 { s[0].asked_at = -1000; }   // shown again: read the state now
}
coaxial_chat_hash :: (s: [] ChatState, length: int) #export_c { }
coaxial_chat_page :: (s: [] ChatState, page: int) #export_c { }
coaxial_chat_wants_text :: (s: [] ChatState) -> bool #export_c { return s.count > 0 && s[0].typing && s[0].status == 200; }
coaxial_chat_cursor :: (s: [] ChatState) -> int #export_c { if s.count < 1 { return 0; } return ifx s[0].hot != -1 then 1 else 0; }
coaxial_chat_action :: (s: [] ChatState) -> int #export_c { if s.count < 1 { return 0; } return s[0].action; }
coaxial_chat_action_done :: (s: [] ChatState) #export_c { if s.count > 0 { s[0].action = 0; s[0].out_n = 0; } }
coaxial_chat_inbox_cap :: () -> int #export_c { return CH_INBOX; }
coaxial_chat_max_vertices :: () -> int #export_c { return CH_MAX_VERTICES; }

// ---------------------------------------------------------------- checks

CH_FIXTURE :: "200\nZ|0.12|10.00|||0|1|7\nC|7|What does release.sh do?|claude-opus-5-5|Oct 28 15:52|1\nC|3|Older|claude-haiku-5-5|Oct 27 09:00|0\nS|7|What does release.sh do?|claude-opus-5-5|1\nU|20|done|Oct 28 15:50|claude-haiku-5-5|openagents|What does coax/web/release.sh do?|## What it does\\n\\nIt **releases** the site:\\n\\n- builds `apps/openagents-web`\\n- runs the goldens\\n\\n```\\ncoax/web/release.sh\\n```\\n\\n1. one\\n2. two \\p three\\n> quoted||Oct|0.0123\nT|20|Read|coax/web/release.sh\nU|21|running|Oct 28 15:52|claude-opus-5-5|openagents|And then?|||reading coax/web/deploy.sh|0.0000\nT|21|Read|coax/web/deploy.sh\n";

ch_fresh :: (s: [] ChatState, out: [] f32, u: [] f32, w: f32, h: f32) -> int {
  return coaxial_chat_frame(s, out, u, w, h, 2, 0.016, true);
}
ch_has_hit :: (s: [] ChatState, id: int) -> bool {
  for i: 0..<s[0].hit_n { if s[0].hit_id[i] == id { return true; } }
  return false;
}
ch_loaded :: (s: [] ChatState, out: [] f32, u: [] f32) {
  n0 := ch_fresh(s, out, u, 1440, 900);
  coaxial_chat_asked(s, 0);
  ch_answer(s, 0, CH_FIXTURE);
}
ch_typed_in :: (s: [] ChatState, text: string) {
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_chat_message(s, CH_TYPED, text.count);
}

#test "signed out or not an admin: LOG IN and nothing else" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n0 := ch_fresh(s[..], out[..], u[..], 1440, 900);
  #assert cast(string) s[0].ask[0..<s[0].ask_n] == "/api/chat/state";
  coaxial_chat_asked(s[..], 0);
  ch_answer(s[..], 0, "401\n{\"error\": \"log in as an admin\"}");
  n := ch_fresh(s[..], out[..], u[..], 1440, 900);
  #assert n > 0 && s[0].line_n == 0 && ch_has_hit(s[..], H_SIGNIN) && !ch_has_hit(s[..], H_FIELD) && !ch_has_hit(s[..], H_KEY);
  #assert s[0].ask_n == 0;   // and it stops asking
  ch_act(s[..], H_SIGNIN);
  #assert s[0].action == CH_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/login";
}

#test "an admin's page: the list, the conversation shown, its answer drawn, the tool in use and STOP" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  ch_loaded(s[..], out[..], u[..]);
  #assert s[0].status == 200 && s[0].shown == 7 && ch_count(s[..], 'U') == 2 && ch_busy(s[..]);
  n := ch_fresh(s[..], out[..], u[..], 2880, 1800);
  #assert n > 3000;
  #assert ch_has_hit(s[..], H_CONV + 1);
  #assert ch_has_hit(s[..], H_STOP);
  #assert ch_has_hit(s[..], H_FIELD) && ch_has_hit(s[..], H_MODEL + 2);
  #assert ch_model(s[..]) == 2;
  // while a turn runs it reads again after 2 s, for the conversation shown
  s[0].time += 2.1;
  n2 := ch_fresh(s[..], out[..], u[..], 2880, 1800);
  #assert cast(string) s[0].ask[0..<s[0].ask_n] == "/api/chat/state?c=7";
  ch_act(s[..], H_STOP);
  #assert cast(string) s[0].post[0..<s[0].post_n] == "/api/chat/stop" && cast(string) s[0].body[0..<s[0].body_n] == "{\"c\":\"7\"}";
}

#test "a phone draws the conversation alone, CHATS over it" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  ch_loaded(s[..], out[..], u[..]);
  n := ch_fresh(s[..], out[..], u[..], 780, 1688);
  #assert n > 1000 && !ch_has_hit(s[..], H_CONV) && ch_has_hit(s[..], H_CHATS) && ch_has_hit(s[..], H_FIELD) && ch_has_hit(s[..], H_MODEL + 2);
  for i: 0..<s[0].hit_n { b := s[0].hit_box[i]; #assert b.x0 >= 0 && b.x1 <= 780; }
  ch_act(s[..], H_CHATS);
  n2 := ch_fresh(s[..], out[..], u[..], 780, 1688);
  #assert ch_has_hit(s[..], H_CONV + 1) && !ch_has_hit(s[..], H_FIELD);
  ch_act(s[..], H_CONV + 1);
  #assert s[0].shown == 3 && !s[0].listing && s[0].asked_at < 0;
}

#test "a message is sent with its conversation and model, escaped as JSON; a new chat sends none" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  ch_loaded(s[..], out[..], u[..]);
  ch_answer(s[..], -5, "");   // nothing waits for that
  // the running turn ends
  coaxial_chat_asked(s[..], 1);
  done := "200\nZ|0.20|10.00||||0|7\nC|7|T|claude-opus-5-5|Oct 28|0\nS|7|T|claude-opus-5-5|1\nU|21|done|Oct 28|claude-opus-5-5|openagents|And then?|ok||x|0.0100\n";
  ch_answer(s[..], 1, done);
  #assert !ch_busy(s[..]);
  ch_act(s[..], H_FIELD);
  #assert coaxial_chat_wants_text(s[..]);
  ch_typed_in(s[..], "say \"hi\"\nnow");
  k2 := coaxial_chat_key(s[..], K_ENTER);
  #assert cast(string) s[0].post[0..<s[0].post_n] == "/api/chat/send";
  #assert cast(string) s[0].body[0..<s[0].body_n] == "{\"c\":\"7\",\"text\":\"say \\\"hi\\\"\\nnow\",\"model\":\"claude-opus-5-5\"}";
  coaxial_chat_posted(s[..], 5);
  #assert s[0].body_n == 0 && s[0].body[0] == 0;
  ch_answer(s[..], 5, "200\n{\"c\": 7, \"turn\": 22, \"model\": \"claude-opus-5-5\"}");
  #assert s[0].text_n == 0 && s[0].asked_at < 0;
  ch_act(s[..], H_NEW);
  #assert s[0].shown == 0 && ch_model(s[..]) == 2;
  ch_act(s[..], H_MODEL + 0);
  #assert s[0].post_n == 0 && ch_model(s[..]) == 0;     // a new chat: kept here until it's sent
  ch_typed_in(s[..], "fresh");
  ch_act(s[..], H_SEND);
  #assert cast(string) s[0].body[0..<s[0].body_n] == "{\"text\":\"fresh\",\"model\":\"claude-haiku-5-5\"}";
  coaxial_chat_posted(s[..], 6);
  ch_answer(s[..], 6, "200\n{\"c\": 9, \"turn\": 23, \"model\": \"claude-haiku-5-5\"}");
  #assert s[0].shown == 9;
}

#test "a model chosen mid-conversation is posted for it; the cap and its words" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  ch_loaded(s[..], out[..], u[..]);
  ch_act(s[..], H_MODEL + 1);
  #assert cast(string) s[0].post[0..<s[0].post_n] == "/api/chat/model" && cast(string) s[0].body[0..<s[0].body_n] == "{\"c\":\"7\",\"model\":\"claude-sonnet-5-5\"}";
  #assert ch_model(s[..]) == 1;
  coaxial_chat_posted(s[..], 2);
  ch_answer(s[..], 2, "200\n{}");
  coaxial_chat_asked(s[..], 3);
  capped := "200\nZ|10.02|10.00|||0|0|7\nS|7|T|claude-sonnet-5-5|1\n";
  ch_answer(s[..], 3, capped);
  #assert ch_capped(s[..]) && ch_model(s[..]) == 1;
  ch_typed_in(s[..], "x");
  s[0].typing = true; s[0].focus = 0;
  ch_typed_in(s[..], "more");
  ch_send(s[..]);
  coaxial_chat_posted(s[..], 4);
  ch_answer(s[..], 4, "429\n{\"cap\": true, \"error\": \"Today's $10 limit for /chat is used up.\"}");
  #assert cast(string) s[0].note[0..<s[0].note_n] == "Today's $10 limit for /chat is used up.";
  #assert ch_cents("10.00") == 1000 && ch_cents("0.5") == 50 && ch_cents("3") == 300;
}

#test "KEY: a pasted key is masked, posted once and wiped; a refusal says why; REMOVE" {
  s: [1] ChatState;
  out: [CH_MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  ch_loaded(s[..], out[..], u[..]);
  ch_act(s[..], H_KEY);
  n := ch_fresh(s[..], out[..], u[..], 1440, 900);
  #assert s[0].keying && ch_has_hit(s[..], H_KFIELD) && ch_has_hit(s[..], H_KSAVE) && !ch_has_hit(s[..], H_REMOVE);
  ch_act(s[..], H_KFIELD);
  ch_typed_in(s[..], " sk-ant-api03-abc\nWXYZ ");
  #assert cast(string) s[0].key[0..<s[0].key_n] == "sk-ant-api03-abcWXYZ" && s[0].text_n == 0;
  k := coaxial_chat_key(s[..], K_ENTER);
  #assert s[0].key_n == 0 && s[0].key[0] == 0;
  #assert cast(string) s[0].post[0..<s[0].post_n] == "/api/chat/key" && cast(string) s[0].body[0..<s[0].body_n] == "{\"credential\":\"sk-ant-api03-abcWXYZ\"}";
  coaxial_chat_posted(s[..], 3);
  #assert s[0].body_n == 0;
  ch_answer(s[..], 3, "400\n{\"error\":\"That key didn't work: invalid x-api-key\"}");
  #assert cast(string) s[0].knote[0..<s[0].knote_n] == "That key didn't work: invalid x-api-key";
  // saved: its kind and last four, REPLACE and REMOVE
  coaxial_chat_asked(s[..], 4);
  ch_answer(s[..], 4, "200\nZ|0.12|10.00|oauth|OATK|0|0|7\nS|7|T|claude-opus-5-5|1\n");
  n2 := ch_fresh(s[..], out[..], u[..], 1440, 900);
  #assert ch_has_hit(s[..], H_REPLACE) && ch_has_hit(s[..], H_REMOVE) && !ch_has_hit(s[..], H_KFIELD) && !ch_capped(s[..]);
  ch_act(s[..], H_REMOVE);
  #assert cast(string) s[0].post[0..<s[0].post_n] == "/api/chat/key_remove" && cast(string) s[0].body[0..<s[0].body_n] == "{}";
  ch_act(s[..], H_CLOSE);
  #assert !s[0].keying;
}

#test "Markdown: escapes undone, marks taken out, links kept readable" {
  s: [1] ChatState;
  #assert ch_decode(s[..], "a\\nb \\p c \\\\ d") == "a\nb | c \\ d";
  buf: [200] u8;
  #assert ch_inline("It **releases** `x` see [docs](https://a.b/c) and [f.c](f.c)", buf[..]) == "It releases x see docs (https://a.b/c) and f.c";
  #assert ch_is_sep("|---|:--:|") && !ch_is_sep("| a | b |") && ch_is_rule("---") && !ch_is_rule("-- a");
}
