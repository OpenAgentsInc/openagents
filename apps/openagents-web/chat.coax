// openagents.com/chat, drawn with the Zeron components the Mac app draws
// its chat with (apps/shared/zeron/: Zeron's composer, transcript,
// Markdown, tool chips and model menu, GPUI's primitives), on WebGPU by
// chat.wgsl (Zeron.metal's port) with the atlas coax/web/gpui.js
// rasterizes in the browser. A direct chat with the OpenAgents agent,
// admins only for now (docs/chat.md): the page holds nothing until oa-api
// answers /api/chat/state with the admin's session cookie; anyone else sees
// only Log in.
//
// What it draws: the conversations (a sidebar on a wide window, Chats over
// the page on a phone) and New chat; the conversation shown, its messages
// as Zeron's bubbles, the agent's answers as Markdown, the tools it used as
// Zeron's tool group and chips, the model and credential under each answer;
// Zeron's composer (its own selection, undo and IME, no paperclip: the API
// takes no files), whose model chip opens Zeron's menu of the three models
// oa-api runs, and whose Send becomes Stop while a turn runs; KEY, the
// asker's own Anthropic key or Claude subscription token. A `#demo` hash
// shows Zeron's demo conversation as the Mac app's --demo does, for
// comparing the two renders. Based on Zeron by Wing, MIT.

#load "../shared/zeron/picker.coax";

WC_MAX_VERTICES :: 120000;
WC_INBOX :: 1048576;
WC_DATA :: 1048576;        // the last state's lines (WcHost holds them; WcState sees them)
WC_POOL :: 1048576;        // the decoded texts the transcript points into
WC_LINES :: 4096;
WC_URL :: 128;
WC_KEY :: 400;             // a pasted credential's most
WC_BODY :: 24600;          // a post's JSON: a message escaped, or a credential
WC_NOTE :: 300;
WC_HTTP :: 512;            // + id: an HTTP answer (coax/web/host.js)
WC_TYPED :: 1; WC_SHOWN :: 602;
WC_NAVIGATE :: 1; WC_COPY :: 2;
WC_BUSY :: 2.0;            // seconds between reads while a turn waits or runs
WC_REFRESH :: 30.0;        // else
POST_SEND :: 1; POST_MODEL :: 2; POST_STOP :: 3; POST_KEY :: 4; POST_KEY_REMOVE :: 5;
// The host's named keys beyond composer.coax's: Shift and Control held, Tab.
WK_SHIFT :: -13; WK_CONTROL :: -14; WK_TAB :: -15;
// What oa-api runs (chat.api: Opus by default), in Zeron's order, and the menu's words.
WC_MODELS :: [3] string.["claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"];
WC_MODEL_NAMES :: [3] string.["Opus 5.5", "Sonnet 5.5", "Haiku 5.5"];
WC_MODEL_DESCS :: [3] string.["For complex work and everyday tasks", "Most efficient for simpler tasks", "Fastest for quick answers"];
WC_MODEL_DEFAULT :: 0;
WC_CLAUDE_TINT :: Rgba.{r = 0.851, g = 0.467, b = 0.341, a = 1};   // #d97757 (claude.coax CLAUDE_TINT)
// The layout: the sidebar from this wide, its width; Zeron's column padding
// (the phone's 16px gutters); the docked composer's bottom margin.
WC_WIDE :: 860.0;
WC_SIDEBAR :: 260.0;
WC_PAD :: 16.0;
WC_DOCK_BOTTOM :: 40.0;
WC_DOCK_BOTTOM_PHONE :: 16.0;
WC_HERO_LIFT :: 12.0;
WC_ROW :: 52.0;            // a conversation's row in the list
WC_BUTTON_H :: 28.0;
WC_INTRO :: "Ask anything about OpenAgents. The agent reads a fresh copy of the public openagents repository (main) and the web, and says which files it read. It can't change anything.";
// The chrome's presses (WcState.hits): the list's rows are WH_CONV + index.
WH_NONE :: -1; WH_LOGIN :: 1; WH_NEW :: 2; WH_CHATS :: 3; WH_KEY :: 4; WH_KFIELD :: 5; WH_KSAVE :: 6;
WH_REPLACE :: 7; WH_REMOVE :: 8; WH_CLOSE :: 9; WH_HOME :: 10; WH_SHADE :: 11;
WH_CONV :: 100;
WC_HITS :: 96;

WcHit :: struct { x: f32; y: f32; w: f32; h: f32; id: int; }
// A painted button: the vertices so far and its width.
WcB :: struct { v: int; w: f32; }

WcState :: struct {
  ready: bool; time: f32;
  width: f32; height: f32; d: f32;
  golden: bool;
  atlas: [1] Atlas;
  composer: [1] Composer;
  transcript: [1] Transcript;
  picker: [1] Picker;
  cat: [1] PkCatalog;
  // the host's side of the atlas: what coax/web/gpui.js hands over (a font's
  // header, advances and kerning; a cluster's bytes; a cell's six numbers)
  scratch: [9800] f32;
  sbytes: [64] u8;
  // asking oa-api
  status: int;                   // -1 nothing asked, 0 waiting for the first answer, else its HTTP status
  asked_at: f32;
  ask: [WC_URL] u8; ask_n: int; ask_id: int;
  post: [WC_URL] u8; post_n: int; post_id: int; post_kind: int;
  body: [WC_BODY] u8; body_n: int;
  shown: int;                    // the conversation shown: its id, 0 a new one, -1 the newest
  model: int;                    // the model chosen here, -1 the conversation's own
  gen: int; built: int;          // states taken; the one the transcript was built from
  pending: [COMPOSER_TEXT] u8; pending_n: int;   // a message sent and not yet in the state
  first: int;                    // the turns the transcript skips (more than it holds)
  g_set: [T_GROUPS] bool; g_user: [T_GROUPS] int;   // a group's open as built, and as the reader left it (0 auto, 1 open, 2 closed)
  t_set: [T_TOOLS] bool; t_user: [T_TOOLS] int;
  built_groups: int; built_tools: int;
  work: f32;                     // seconds the shown turn has run, counted here
  seen_sent: int;
  note: [WC_NOTE] u8; note_n: int;                  // why the last message or Stop didn't go (Zeron's failure notice)
  knote: [WC_NOTE] u8; knote_n: int;                // the same in KEY
  // the chrome
  lx: f32; ly: f32;
  cursor: int;                   // 0 arrow, 1 a link, 3 text (host.js)
  on_composer: bool; swallow: bool;
  shift: bool;
  down_at: f32; down_x: f32; down_y: f32; clicks: int;
  hits: [WC_HITS] WcHit; nhit: int; hot: int; press: int;
  side_scroll: f32; side_h: f32;
  listing: bool;                 // a phone: Chats is over the page
  keying: bool;                  // KEY is open
  replacing: bool;               // KEY: the field is out over a saved credential
  key_focus: bool;
  key: [WC_KEY] u8; key_n: int;
  demo: bool;
  field: [4] f32;
  outbox: [COMPOSER_TEXT] u8; out_n: int; action: int;
  // WcHost's buffers (a #test's own short ones)
  data: [] u8; data_n: int;
  line_at: [WC_LINES] int; line_end: [WC_LINES] int; line_n: int;
  inbox: [] u8;
  pool: [] u8; pool_n: int;
}

// What the host keeps (chat-face.c): the state and its buffers, outside
// WcState so the state's own size stays the compiler's to check.
WcHost :: struct {
  s: [1] WcState;
  data: [WC_DATA] u8;
  inbox: [WC_INBOX] u8;
  pool: [WC_POOL] u8;
}
coaxial_chat_bind :: (h: [] WcHost) #export_c {
  if h.count < 1 { return; }
  h[0].s[0].data = h[0].data[..];
  h[0].s[0].inbox = h[0].inbox[..];
  h[0].s[0].pool = h[0].pool[..];
}

// ---------------------------------------------------------------- the lines

wc_kind :: (s: [] WcState, i: int) -> u8 { return s[0].data[s[0].line_at[i]]; }
wc_cell :: (s: [] WcState, i: int, col: int) -> string {
  from := s[0].line_at[i]; to := s[0].line_end[i];
  k := from; c := 0;
  while c < col && k < to { if s[0].data[k] == '|' { c += 1; } k += 1; }
  if c < col { return ""; }
  j := k;
  while j < to && s[0].data[j] != '|' { j += 1; }
  return cast(string) s[0].data[k..<j];
}
wc_index :: (s: [] WcState) {
  s[0].line_n = 0;
  at := 0; n := s[0].data_n;
  while at < n {
    stop := at;
    while stop < n && s[0].data[stop] != '\n' { stop += 1; }
    if stop > at + 1 && s[0].data[at + 1] == '|' && s[0].line_n < WC_LINES {
      s[0].line_at[s[0].line_n] = at; s[0].line_end[s[0].line_n] = stop; s[0].line_n += 1;
    }
    at = stop + 1;
  }
}
wc_first :: (s: [] WcState, kind: u8) -> int {
  for i: 0..<s[0].line_n { if wc_kind(s, i) == kind { return i; } }
  return -1;
}
wc_count :: (s: [] WcState, kind: u8) -> int {
  n := 0;
  for i: 0..<s[0].line_n { if wc_kind(s, i) == kind { n += 1; } }
  return n;
}
wc_nth :: (s: [] WcState, kind: u8, k: int) -> int {
  n := 0;
  for i: 0..<s[0].line_n { if wc_kind(s, i) == kind { if n == k { return i; } n += 1; } }
  return -1;
}
wc_z :: (s: [] WcState, col: int) -> string { z := wc_first(s, 'Z'); return ifx z < 0 then "" else wc_cell(s, z, col); }
wc_has_key :: (s: [] WcState) -> bool { return wc_z(s, 3).count > 0; }
// Today's spend on OpenAgents' key has reached the cap, and no key of the asker's is saved.
wc_capped :: (s: [] WcState) -> bool {
  if wc_has_key(s) || wc_first(s, 'Z') < 0 { return false; }
  return wc_cents(wc_z(s, 1)) >= wc_cents(wc_z(s, 2)) && wc_cents(wc_z(s, 2)) >= 0;
}
// "1.07" as 107; -1 for nothing.
wc_cents :: (t: string) -> int {
  if t.count == 0 { return -1; }
  n := 0; frac := -1;
  for c: t {
    if c == '.' { frac = 0; continue; }
    if c < '0' || c > '9' { break; }
    if frac >= 2 { continue; }
    n = n * 10 + cast(int) (c - '0');
    if frac >= 0 { frac += 1; }
  }
  if frac < 0 { frac = 0; }
  while frac < 2 { n *= 10; frac += 1; }
  return n;
}
wc_model_index :: (id: string) -> int {
  ids := WC_MODELS;
  for k: 0..<3 { if ids[k] == id { return k; } }
  return -1;
}
wc_model_name :: (id: string) -> string { k := wc_model_index(id); names := WC_MODEL_NAMES; return ifx k < 0 then id else names[k]; }
wc_shown_id :: (s: [] WcState) -> string { si := wc_first(s, 'S'); return ifx si < 0 then "" else wc_cell(s, si, 1); }
wc_showing :: (s: [] WcState) -> bool { return s[0].shown != 0 && wc_shown_id(s).count > 0; }
// The model the next turn uses: the one chosen here, else the conversation's, else Opus.
wc_model :: (s: [] WcState) -> int {
  if s[0].model >= 0 && s[0].model < 3 { return s[0].model; }
  si := wc_first(s, 'S');
  if si >= 0 && wc_showing(s) { k := wc_model_index(wc_cell(s, si, 3)); if k >= 0 { return k; } }
  return WC_MODEL_DEFAULT;
}
// The shown conversation's last turn waits or runs (or a message is on its way).
wc_busy :: (s: [] WcState) -> bool {
  if s[0].post_kind == POST_SEND || s[0].pending_n > 0 { return true; }
  if !wc_showing(s) { return false; }
  n := wc_count(s, 'U');
  if n == 0 { return false; }
  st := wc_cell(s, wc_nth(s, 'U', n - 1), 2);
  return st == "running" || st == "queued";
}

// A long text's escapes (\n, \\, \p) undone, into the pool; "" once it is full.
wc_decode :: (s: [] WcState, text: string) -> string {
  from := s[0].pool_n; n := from; i := 0;
  while i < text.count {
    if n >= s[0].pool.count { s[0].pool_n = from; return ""; }
    c := text[i];
    if c == '\\' && i + 1 < text.count {
      e := text[i + 1];
      s[0].pool[n] = ifx e == 'n' then '\n' else ifx e == 'p' then '|' else e;
      n += 1; i += 2; continue;
    }
    s[0].pool[n] = c; n += 1; i += 1;
  }
  s[0].pool_n = n;
  return cast(string) s[0].pool[from..<n];
}
wc_keep :: (s: [] WcState, text: string) -> string {
  from := s[0].pool_n;
  if from + text.count > s[0].pool.count { return ""; }
  for k: 0..<text.count { s[0].pool[from + k] = text[k]; }
  s[0].pool_n = from + text.count;
  return cast(string) s[0].pool[from..<s[0].pool_n];
}

// ---------------------------------------------------------------- asking oa-api

wc_put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n < buf.count { buf[n] = c; n += 1; } }
  return n;
}
wc_number :: (buf: [] u8, at: int, n: int) -> int {
  digits: [20] u8; k := 0; x := n;
  if x < 0 { x = 0; }
  if x == 0 { digits[0] = '0'; k = 1; }
  while x > 0 && k < 20 { digits[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1; }
  m := at;
  while k > 0 && m < buf.count { k -= 1; buf[m] = digits[k]; m += 1; }
  return m;
}
wc_ask :: (s: [] WcState) {
  if s[0].ask_id >= 0 || s[0].ask_n > 0 { return; }
  n := wc_put(s[0].ask[..], 0, "/api/chat/state");
  if s[0].shown >= 0 { n = wc_put(s[0].ask[..], n, "?c="); n = wc_number(s[0].ask[..], n, s[0].shown); }
  s[0].ask_n = n;
  s[0].asked_at = s[0].time;
  if s[0].status == -1 { s[0].status = 0; }
}
// A JSON string's contents into buf.
wc_json :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text {
    if n + 8 >= buf.count { return n; }
    if c == '"' || c == '\\' { buf[n] = '\\'; buf[n + 1] = c; n += 2; }
    else if c == '\n' { buf[n] = '\\'; buf[n + 1] = 'n'; n += 2; }
    else if c < 32 { buf[n] = ' '; n += 1; }
    else { buf[n] = c; n += 1; }
  }
  return n;
}
// A post: {"key": "value", ...} from up to three pairs (an empty key is left out).
wc_post :: (s: [] WcState, op: string, kind: int, k1: string, v1: string, k2: string, v2: string, k3: string, v3: string) {
  n := wc_put(s[0].post[..], 0, "/api/chat/");
  s[0].post_n = wc_put(s[0].post[..], n, op);
  b := wc_put(s[0].body[..], 0, "{");
  keys := [3] string.[k1, k2, k3]; values := [3] string.[v1, v2, v3];
  first := true;
  for j: 0..<3 {
    if keys[j].count == 0 { continue; }
    if !first { b = wc_put(s[0].body[..], b, ","); }
    first = false;
    b = wc_put(s[0].body[..], b, "\""); b = wc_put(s[0].body[..], b, keys[j]); b = wc_put(s[0].body[..], b, "\":\"");
    b = wc_json(s[0].body[..], b, values[j]);
    b = wc_put(s[0].body[..], b, "\"");
  }
  s[0].body_n = wc_put(s[0].body[..], b, "}");
  s[0].post_kind = kind; s[0].post_id = -1;
}
// The face sent them. A post's body is wiped once sent: a credential stays in the page no longer than that.
coaxial_chat_asked :: (s: [] WcState, id: int) #export_c { if s.count > 0 { s[0].ask_n = 0; s[0].ask_id = id; } }
coaxial_chat_posted :: (s: [] WcState, id: int) #export_c {
  if s.count < 1 { return; }
  for i: 0..<s[0].body_n { s[0].body[i] = 0; }
  s[0].post_n = 0; s[0].body_n = 0; s[0].post_id = id;
}
wc_say :: (s: [] WcState, word: string) { s[0].note_n = wc_put(s[0].note[..], 0, word); }
wc_say_key :: (s: [] WcState, word: string) { s[0].knote_n = wc_put(s[0].knote[..], 0, word); }
wc_go :: (s: [] WcState, url: string) { s[0].out_n = wc_put(s[0].outbox[..], 0, url); s[0].action = WC_NAVIGATE; }
wc_copy :: (s: [] WcState, text: string) {
  if text.count == 0 || text.count > s[0].outbox.count { return; }
  s[0].out_n = wc_put(s[0].outbox[..], 0, text); s[0].action = WC_COPY;
}
wc_wipe_key :: (s: [] WcState) { for i: 0..<WC_KEY { s[0].key[i] = 0; } s[0].key_n = 0; }

// A JSON answer's value for key, as text: a string's contents, or a number's digits.
wc_value :: (bytes: string, from: int, key: string) -> string {
  k := from;
  while k + key.count + 2 <= bytes.count {
    if bytes[k] == '"' && bytes[k + 1..<k + 1 + key.count] == key && bytes[k + 1 + key.count] == '"' {
      a := k + key.count + 2;
      while a < bytes.count && (bytes[a] == ' ' || bytes[a] == ':') { a += 1; }
      if a >= bytes.count { return ""; }
      if bytes[a] == '"' {
        a += 1; b := a;
        while b < bytes.count && bytes[b] != '"' { if bytes[b] == '\\' { b += 1; } b += 1; }
        if b > bytes.count { b = bytes.count; }
        return bytes[a..<b];
      }
      b := a;
      while b < bytes.count && bytes[b] >= '0' && bytes[b] <= '9' { b += 1; }
      return bytes[a..<b];
    }
    k += 1;
  }
  return "";
}
wc_int :: (t: string) -> int {
  n := 0;
  for c: t { if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return ifx t.count == 0 then -1 else n;
}

// The state's lines from an answer.
wc_take :: (s: [] WcState, bytes: string, from: int) {
  was := wc_shown_id(s);
  n := 0; i := from;
  while i < bytes.count && n < s[0].data.count { s[0].data[n] = bytes[i]; n += 1; i += 1; }
  s[0].data_n = n; wc_index(s); s[0].status = 200;
  // the newest conversation, shown when none was chosen
  if s[0].shown < 0 { k := wc_int(wc_shown_id(s)); s[0].shown = ifx k > 0 then k else 0; }
  if wc_shown_id(s) != was { wc_forget_view(s); }
  // the message on its way is in the state once its turn is
  if s[0].pending_n > 0 && s[0].post_kind != POST_SEND { s[0].pending_n = 0; }
  s[0].gen += 1;
}
// Another conversation: its own scroll, and nothing the reader opened in the last.
wc_forget_view :: (s: [] WcState) {
  s[0].first = 0;
  for g: 0..<T_GROUPS { s[0].g_user[g] = 0; }
  for q: 0..<T_TOOLS { s[0].t_user[q] = 0; }
  s[0].built_groups = 0; s[0].built_tools = 0;
  s[0].transcript[0].pinned = true; s[0].transcript[0].has_sel = false;
}
// An answer: "STATUS\n" then the body.
wc_answer :: (s: [] WcState, id: int, bytes: string) {
  i := 0; code := 0;
  while i < bytes.count && bytes[i] >= '0' && bytes[i] <= '9' { code = code * 10 + cast(int) (bytes[i] - '0'); i += 1; }
  if i < bytes.count && bytes[i] == '\n' { i += 1; }
  if id == s[0].ask_id {
    s[0].ask_id = -1;
    if code == 200 { wc_take(s, bytes, i); }
    else if code == 0 || code >= 500 { if s[0].status <= 0 { s[0].status = 599; } }   // offline: what was shown stays
    else { s[0].status = code; s[0].data_n = 0; s[0].line_n = 0; s[0].gen += 1; }   // signed out, or not an admin: nothing stays
    return;
  }
  if id != s[0].post_id { return; }
  s[0].post_id = -1;
  kind := s[0].post_kind; s[0].post_kind = 0;
  err := wc_value(bytes, i, "error");
  if code == 401 || code == 403 { s[0].status = code; s[0].data_n = 0; s[0].line_n = 0; s[0].pending_n = 0; s[0].gen += 1; return; }
  if kind == POST_SEND {
    if code == 200 {
      s[0].note_n = 0;
      c := wc_int(wc_value(bytes, i, "c"));
      if c > 0 && c != s[0].shown { s[0].shown = c; }
      s[0].model = -1;
      s[0].transcript[0].pinned = true;
    } else {
      // nothing went: the message comes back to the composer, with why
      composer_insert(s[0].composer[..], cast(string) s[0].pending[0..<s[0].pending_n]);
      s[0].pending_n = 0; s[0].gen += 1;
      if code == 429 && err.count > 0 { wc_say(s, err); }
      else if code == 409 { wc_say(s, "A turn is still running."); }
      else { wc_say(s, ifx err.count > 0 then err else "Not sent."); }
    }
  } else if kind == POST_MODEL {
    if code != 200 { s[0].model = -1; wc_say(s, ifx err.count > 0 then err else "The model didn't change."); }
  } else if kind == POST_STOP {
    if code != 200 { wc_say(s, ifx err.count > 0 then err else "Not stopped."); }
  } else if kind == POST_KEY {
    if code == 200 { s[0].replacing = false; s[0].knote_n = 0; s[0].key_focus = false; }
    else { wc_say_key(s, ifx err.count > 0 then err else "That key didn't work: no answer"); }
  } else if kind == POST_KEY_REMOVE {
    if code == 200 { s[0].replacing = false; s[0].knote_n = 0; wc_say_key(s, "Removed."); }
  }
  s[0].asked_at = -1000;   // read the state again now
}

// ---------------------------------------------------------------- the transcript from the state

// The tool oa-api's agent named, as Zeron's chip (Read, Glob, Grep, WebSearch, WebFetch; others by name).
wc_tool_kind :: (name: string) -> int {
  if name == "Read" { return TK_READ; }
  if name == "Grep" { return TK_SEARCH; }
  if name == "Glob" { return TK_GLOB; }
  if name == "WebSearch" { return TK_WEB; }
  if name == "WebFetch" { return TK_FETCH; }
  if name == "Bash" { return TK_EXEC; }
  if name == "Edit" { return TK_EDIT; }
  if name == "Write" { return TK_WRITE; }
  if name == "TodoWrite" { return TK_TODO; }
  if name == "Task" || name == "Agent" { return TK_AGENT; }
  return TK_TOOL;
}
wc_word :: (out: [] u8, k: int, w: string) -> int { j := k; for c: w { if j < out.count { out[j] = c; j += 1; } } return j; }
wc_sep :: (out: [] u8, k: int) -> int { return ifx k == 0 then 0 else wc_word(out, k, " · "); }
wc_plural :: (out: [] u8, k: int, verb: string, n: int, one: string, many: string) -> int {
  j := wc_sep(out, k);
  j = wc_word(out, j, verb); j = wc_number(out, j, n); j = wc_word(out, j, " ");
  return wc_word(out, j, ifx n == 1 then one else many);
}
// A group's summary as Zeron words it (tool_group_summary): "Read 2 files · searched 3 times".
wc_summary :: (kinds: [] int, n: int, out: [] u8) -> int {
  reads := 0; searches := 0; fetches := 0; commands := 0; edits := 0; other := 0;
  for k: 0..<n {
    q := kinds[k];
    if q == TK_READ { reads += 1; }
    else if q == TK_SEARCH || q == TK_GLOB || q == TK_WEB { searches += 1; }
    else if q == TK_FETCH { fetches += 1; }
    else if q == TK_EXEC { commands += 1; }
    else if q == TK_EDIT || q == TK_WRITE { edits += 1; }
    else { other += 1; }
  }
  k := 0;
  if commands > 0 { k = wc_plural(out, k, "ran ", commands, "command", "commands"); }
  if edits > 0 { k = wc_plural(out, k, "edited ", edits, "file", "files"); }
  if reads > 0 { k = wc_plural(out, k, "read ", reads, "file", "files"); }
  if searches > 0 { k = wc_plural(out, k, "searched ", searches, "time", "times"); }
  if fetches > 0 { k = wc_plural(out, k, "fetched ", fetches, "page", "pages"); }
  if other > 0 { k = wc_plural(out, k, "called ", other, "tool", "tools"); }
  if k > 0 && out[0] >= 'a' && out[0] <= 'z' { out[0] = out[0] - 32; }
  return k;
}
// Under an answer: the model, the credential and what it cost ("Opus 5.5 · OpenAgents key · $0.0123").
wc_meta :: (s: [] WcState, i: int, out: [] u8) -> int {
  k := wc_word(out, 0, wc_model_name(wc_cell(s, i, 4)));
  cred := wc_cell(s, i, 5);
  if cred == "own" { k = wc_word(out, k, " · Your key"); }
  else if cred == "openagents" {
    k = wc_word(out, k, " · OpenAgents key");
    cost := wc_cell(s, i, 10);
    if cost.count > 0 { k = wc_word(out, k, " · $"); k = wc_word(out, k, cost); }
  }
  at := wc_cell(s, i, 3);
  if at.count > 0 { k = wc_word(out, k, " · "); k = wc_word(out, k, at); }
  return k;
}
// Rebuilds the transcript from the state's turns (from s.first on), keeping
// what the reader opened or closed (s_build's bookkeeping, claude.coax).
wc_build :: (s: [] WcState) {
  t := s[0].transcript[..];
  for g: 0..<t[0].ng { if g < s[0].built_groups && t[0].groups[g].open != s[0].g_set[g] { s[0].g_user[g] = ifx t[0].groups[g].open then 1 else 2; } }
  for k: 0..<t[0].nt { if k < s[0].built_tools && t[0].tools[k].open != s[0].t_set[k] { s[0].t_user[k] = ifx t[0].tools[k].open then 1 else 2; } }
  t_reset(t);
  s[0].pool_n = 0;
  n := ifx wc_showing(s) then wc_count(s, 'U') else 0;
  live := false;
  for k: s[0].first..<n {
    i := wc_nth(s, 'U', k);
    id := wc_cell(s, i, 1);
    status := wc_cell(s, i, 2);
    running := status == "running" || status == "queued";
    live = running && k + 1 == n;
    t_user(t, wc_decode(s, wc_cell(s, i, 6)));
    t_entry(t);
    // its tools, newest first in the state (the last 12): one group, oldest first
    tl: [16] int; nt := 0;
    j := i + 1;
    while j < s[0].line_n && wc_kind(s, j) == 'T' { if wc_cell(s, j, 1) == id && nt < 16 { tl[nt] = j; nt += 1; } j += 1; }
    if nt > 0 {
      kinds: [16] int;
      for q: 0..<nt { kinds[q] = wc_tool_kind(wc_cell(s, tl[nt - 1 - q], 2)); }
      words: [256] u8;
      wn := wc_summary(kinds[..], nt, words[..]);
      g := t_group(t, t_pool(t, cast(string) words[0..<wn]));
      if g < 0 { break; }
      for q: 0..<nt {
        line := tl[nt - 1 - q];
        name := wc_decode(s, wc_cell(s, line, 2));
        detail := wc_decode(s, wc_cell(s, line, 3));
        tool := Tool.{kind = kinds[q], arg = ifx detail.count > 0 then detail else name, name = name, resolved = !(live && q + 1 == nt)};
        ti := t_tool(t, g, tool);
        if ti < 0 { break; }
        u := ifx ti < T_TOOLS then s[0].t_user[ti] else 0;
        t[0].tools[ti].open = u == 1;
        if ti < T_TOOLS { s[0].t_set[ti] = t[0].tools[ti].open; }
      }
      // the running turn's group stays open, as a streaming entry's trailing group does
      u := s[0].g_user[g];
      t[0].groups[g].open = ifx u == 0 then live else u == 1;
      s[0].g_set[g] = t[0].groups[g].open;
    }
    answer := wc_cell(s, i, 7);
    if answer.count > 0 { t_text(t, wc_decode(s, answer)); }
    err := wc_decode(s, wc_cell(s, i, 8));
    if status == "stopped" { q := t_notice(t, N_STOPPED, err); }
    else if status == "failed" { q := t_notice(t, N_ERROR, ifx err.count > 0 then err else "Failed."); }
    else if status == "refused" { q := t_notice(t, N_ERROR, ifx err.count > 0 then err else "Not run."); }
    if !running {
      mb: [200] u8;
      mn := wc_meta(s, i, mb[..]);
      q := t_notice(t, N_META, wc_keep(s, cast(string) mb[0..<mn]));
    }
  }
  // the message on its way: its bubble, and the trailer while oa-api takes it
  if s[0].pending_n > 0 { t_user(t, wc_keep(s, cast(string) s[0].pending[0..<s[0].pending_n])); live = true; }
  s[0].built_groups = t[0].ng; s[0].built_tools = t[0].nt;
  t[0].working = live;
  t[0].pinned = t[0].pinned || live;
  s[0].built = s[0].gen;
}
// Whether the last build ran out of the transcript's room (claude.coax s_overflowed).
wc_overflowed :: (t: [] Transcript) -> bool {
  return t[0].nr >= T_ROWS || t[0].ng >= T_GROUPS || t[0].nt >= T_TOOLS || t[0].nn >= T_NOTICES
      || t[0].md[0].nb >= MD_BLOCKS || t[0].md[0].n >= MD_TEXT || t[0].md[0].nr >= MD_RUNS || t[0].md[0].ni >= MD_ITEMS
      || t[0].ntext >= T_TEXTS || t[0].nbox >= T_BOXES || t[0].nsel >= T_SELS || t[0].nhit >= T_HITS;
}

// ---------------------------------------------------------------- the composer and the menu

wc_catalog :: () -> PkCatalog {
  c := PkCatalog.{provider = "Claude", icon = ICON_CLAUDE_14, tint = WC_CLAUDE_TINT, levels = 0, default_level = 0, access = 0, full_access = 0, plan = false};
  ids := WC_MODELS; names := WC_MODEL_NAMES; descs := WC_MODEL_DESCS;
  c.n = 3;
  for k: 0..<3 { c.id[k] = ids[k]; c.label[k] = names[k]; c.desc[k] = descs[k]; c.ladder[k] = 0; }
  return c;
}
wc_sel :: (s: [] WcState) -> PkSel { return PkSel.{model = wc_model(s), level = -1, access = 0, plan = false}; }
wc_empty :: (s: [] WcState) -> bool { return !s[0].demo && s[0].pending_n == 0 && (!wc_showing(s) || wc_count(s, 'U') == 0); }
wc_labels :: (s: [] WcState) {
  c := s[0].composer[..];
  if s[0].demo { c[0].model_label = ""; c[0].no_effort = false; c[0].placeholder = ""; c[0].no_attach = false; c[0].no_access = false; return; }
  names := WC_MODEL_NAMES;
  c[0].model_label = names[wc_model(s)];
  c[0].effort_label = ""; c[0].no_effort = true;
  c[0].brand = 0; c[0].access_set = false; c[0].plan = false;
  c[0].no_attach = true; c[0].no_access = true;
  c[0].placeholder = ifx wc_showing(s) && wc_count(s, 'U') > 0 then "Ask a follow-up" else "Ask the OpenAgents agent";
}
wc_open_menu :: (s: [] WcState) {
  p := s[0].picker[..]; c := s[0].composer[..];
  if p[0].kind == PK_MODEL { pk_close(p); c[0].open = -1; return; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  pk_open(p, PK_MODEL, s[0].cat[..], wc_sel(s), c[0].chip_x[CH_MODEL], c[0].chip_y[CH_MODEL], c[0].chip_w[CH_MODEL], c[0].chip_h[CH_MODEL], s[0].height / d, wc_empty(s));
  pk_tabs(p, 1, 0);
  pk_tab(p, 0, ICON_CLAUDE, WC_CLAUDE_TINT);
  // three models and no effort: the panel would be a header alone, so the menu opens on its list
  pk_show_list(p, s[0].cat[..], wc_sel(s), 0);
  c[0].open = CH_MODEL;
}
// What the menu picked: the model, for the conversation shown (oa-api keeps it) or the next new one.
wc_take_picks :: (s: [] WcState) {
  p := s[0].picker[..];
  // a pick closes the menu (its panel would hold only the model's name)
  if p[0].pick_model >= 0 { pk_close(p); }
  if p[0].pick_model >= 0 && p[0].pick_model < 3 && p[0].pick_model != wc_model(s) {
    s[0].model = p[0].pick_model;
    if wc_showing(s) && s[0].post_n == 0 && s[0].post_id < 0 {
      ids := WC_MODELS;
      wc_post(s, "model", POST_MODEL, "c", wc_shown_id(s), "model", ids[s[0].model], "", "");
    }
  }
  p[0].pick_model = -1; p[0].pick_level = -1; p[0].pick_access = -1; p[0].flip_plan = false;
  if !pk_is_open(p) { s[0].composer[0].open = -1; }
  wc_labels(s);
}
wc_stop :: (s: [] WcState) {
  if !wc_showing(s) || s[0].post_n > 0 || s[0].post_id >= 0 { return; }
  wc_post(s, "stop", POST_STOP, "c", wc_shown_id(s), "", "", "", "");
}
wc_chip :: (s: [] WcState, which: int) {
  c := s[0].composer[..];
  if which == CH_SEND {
    if c[0].running && c[0].n == 0 { wc_stop(s); } else { composer_submit(c); }
  } else if which == CH_MODEL && !s[0].demo { wc_open_menu(s); }
  wc_labels(s);
}
// A message, trimmed, to oa-api (the shown conversation, or a new one).
wc_send :: (s: [] WcState, raw: string) {
  lo := 0; hi := raw.count;
  while lo < hi && (raw[lo] == ' ' || raw[lo] == '\n') { lo += 1; }
  while hi > lo && (raw[hi - 1] == ' ' || raw[hi - 1] == '\n') { hi -= 1; }
  text := cast(string) raw[lo..<hi];
  if text.count == 0 { return; }
  if s[0].post_n > 0 || s[0].post_id >= 0 || wc_busy(s) {
    composer_insert(s[0].composer[..], raw);
    wc_say(s, ifx wc_busy(s) then "A turn is still running." else "Not sent.");
    return;
  }
  ids := WC_MODELS;
  wc_post(s, "send", POST_SEND, "c", ifx wc_showing(s) then wc_shown_id(s) else "", "text", text, "model", ids[wc_model(s)]);
  s[0].pending_n = wc_put(s[0].pending[..], 0, text);
  s[0].note_n = 0; s[0].work = 0;
  s[0].gen += 1;
}
wc_new :: (s: [] WcState) {
  s[0].shown = 0; s[0].model = -1; s[0].listing = false;
  s[0].data_n = 0; s[0].line_n = 0;   // until the state says otherwise, nothing shown
  wc_forget_view(s);
  s[0].asked_at = -1000; s[0].gen += 1;
  s[0].composer[0].focused = true;
  wc_labels(s);
}
wc_open_conv :: (s: [] WcState, k: int) {
  i := wc_nth(s, 'C', k);
  if i < 0 { return; }
  id := wc_int(wc_cell(s, i, 1));
  s[0].listing = false;
  if id == s[0].shown { return; }
  s[0].shown = id; s[0].model = -1;
  wc_forget_view(s);
  s[0].asked_at = -1000;
}

// ---------------------------------------------------------------- painting the chrome

wc_hit :: (s: [] WcState, id: int, x: f32, y: f32, w: f32, h: f32) {
  if s[0].nhit >= WC_HITS { return; }
  s[0].hits[s[0].nhit] = WcHit.{x = x, y = y, w = w, h = h, id = id};
  s[0].nhit += 1;
}
wc_hit_at :: (s: [] WcState, x: f32, y: f32) -> int {
  k := s[0].nhit - 1;
  while k >= 0 {
    b := s[0].hits[k];
    if x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h { return b.id; }
    k -= 1;
  }
  return WH_NONE;
}
// A text button as Zeron's trigger chips are: the label in the muted tone, the wash under the pointer.
wc_button :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, label: string, x: f32, y: f32, id: int, on: bool) -> WcB {
  a := s[0].atlas[..];
  w := round_layout(text_width(a, FONT_CHIP, label)) + 2 * CHIP_PAD;
  v := at;
  if on || s[0].hot == id { v = paint_quad(out, v, d, x, y, w, WC_BUTTON_H, CHIP_RADIUS, 0, CHIP_WASH, CHIP_WASH); }
  v = paint_text(out, v, a, d, FONT_CHIP, label, x + CHIP_PAD, y, WC_BUTTON_H, ifx on || s[0].hot == id then th.text else th.muted);
  wc_hit(s, id, x, y, w, WC_BUTTON_H);
  return WcB.{v = v, w = w};
}
// A filled button (Zeron's primary: the text tone's pill, the shell's label).
wc_primary :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, label: string, x: f32, y: f32, id: int) -> WcB {
  a := s[0].atlas[..];
  w := round_layout(text_width(a, FONT_CHIP, label)) + 2 * 14;
  fill := ifx s[0].hot == id then th.text else opacity(th.text, 0.9);
  v := paint_quad(out, at, d, x, y, w, 32, CHIP_RADIUS, 0, fill, fill);
  v = paint_text(out, v, a, d, FONT_CHIP, label, x + 14, y, 32, th.bg);
  wc_hit(s, id, x, y, w, 32);
  return WcB.{v = v, w = w};
}
WcFlow :: struct { v: int; y: f32; }
// Words wrapped to w (12px, or 14 when not small), a line each lh.
wc_words :: (out: [] f32, f: WcFlow, s: [] WcState, d: f32, text: string, x: f32, w: f32, small: bool, lh: f32, color: Rgba, max: int) -> WcFlow {
  a := s[0].atlas[..];
  no_runs: [1] MdRun;
  lines: [24] MdLine;
  nl := md_wrap(a, text, no_runs[0..<0], w, small, lines[..]);
  if nl > max { nl = max; }
  r := f;
  for q: 0..<nl {
    r.v = paint_text(out, r.v, a, d, ifx small then FONT_TOOL else FONT_INPUT, cast(string) text[lines[q].from..<lines[q].to], x, r.y, lh, color);
    r.y += lh;
  }
  return r;
}
// Zeron's failure notice above the composer (screen.coax zr_paint_failure): why a message or Stop didn't go, or the cap.
wc_paint_failure :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, x: f32, composer_y: f32, cw: f32, msg: string) -> int {
  c := s[0].composer[..]; a := s[0].atlas[..];
  if msg.count == 0 { c[0].failure_h = 0; return at; }
  accent := hex(DANGER, 1); muted := hex(DANGER_MUTED, 1);
  w := cw - 8;
  no_runs: [1] MdRun;
  lines: [16] MdLine;
  nl := md_wrap(a, msg, no_runs[0..<0], w - 2 * NOTICE_PAD, true, lines[..]);
  h := NOTICE_PY + NOTICE_TILE + NOTICE_GAP + cast(f32) nl * NOTICE_LINE + NOTICE_PY;
  y := composer_y - 6 - h;
  c[0].failure_y = y; c[0].failure_h = h;
  v := paint_quad(out, at, d, x + 4, y, w, h, 10, 0, flatten(opacity(accent, 0.1), th.shell), flatten(opacity(accent, 0.1), th.shell));
  hy := y + NOTICE_PY;
  v = paint_quad(out, v, d, x + 4 + NOTICE_PAD, hy, NOTICE_TILE, NOTICE_TILE, 6, 0, opacity(accent, 0.12), opacity(accent, 0.12));
  v = paint_icon(out, v, a, d, ICON_DANGER, x + 4 + NOTICE_PAD + 4, hy + 4, 12, 12, opacity(muted, 0.8));
  v = paint_text(out, v, a, d, FONT_CHIP, ifx wc_capped(s) && s[0].note_n == 0 then "Limit reached" else "Error", x + 4 + NOTICE_PAD + NOTICE_TILE + 8, hy + (NOTICE_TILE - NOTICE_LINE) / 2, NOTICE_LINE, opacity(muted, 0.8));
  my := hy + NOTICE_TILE + NOTICE_GAP;
  for q: 0..<nl {
    v = paint_text(out, v, a, d, FONT_TOOL, cast(string) msg[lines[q].from..<lines[q].to], x + 4 + NOTICE_PAD, my + cast(f32) q * NOTICE_LINE, NOTICE_LINE, muted);
  }
  return v;
}
// What stands above the composer: a note, else the cap (Today's $5.00 for /chat is used up…).
wc_failure_text :: (s: [] WcState, buf: [] u8) -> int {
  if s[0].note_n > 0 { return wc_put(buf, 0, cast(string) s[0].note[0..<s[0].note_n]); }
  if wc_capped(s) {
    m := wc_put(buf, 0, "Today's $"); m = wc_put(buf, m, wc_z(s, 2));
    return wc_put(buf, m, " for /chat is used up. Save your own key under Key, or come back tomorrow.");
  }
  return 0;
}
// Whose key the next turn runs on (the sidebar's foot, and KEY's).
wc_credential :: (s: [] WcState, buf: [] u8) -> int {
  if wc_first(s, 'Z') < 0 { return 0; }
  if wc_has_key(s) {
    m := wc_put(buf, 0, "Your key · ");
    m = wc_put(buf, m, ifx wc_z(s, 3) == "oauth" then "Claude subscription" else "Anthropic API key");
    if wc_z(s, 5) == "1" { m = wc_put(buf, m, " · expired: make a new one under Key"); }
    return m;
  }
  m := wc_put(buf, 0, "OpenAgents key · $"); m = wc_put(buf, m, wc_z(s, 1)); m = wc_put(buf, m, " of $"); m = wc_put(buf, m, wc_z(s, 2));
  return wc_put(buf, m, " today");
}

// The conversations: New chat, then each with its model, when and whether it works, the shown one washed.
wc_paint_list :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, x: f32, top: f32, w: f32, bottom: f32) -> int {
  a := s[0].atlas[..];
  v := at;
  // New chat
  ny := top + 8;
  hot := s[0].hot == WH_NEW;
  if hot || !wc_showing(s) { v = paint_quad(out, v, d, x + 8, ny, w - 16, 32, CHIP_RADIUS, 0, rgba(1, 1, 1, ifx hot then 0.07f32 else 0.05f32), rgba(1, 1, 1, 0)); }
  v = paint_icon(out, v, a, d, ICON_PEN, x + 18, ny + 8, 16, 16, th.muted);
  v = paint_text(out, v, a, d, FONT_MENU, "New chat", x + 42, ny, 32, th.text);
  wc_hit(s, WH_NEW, x + 8, ny, w - 16, 32);
  // Chats and their count
  hy := ny + 32 + 14;
  n := wc_count(s, 'C');
  cb: [24] u8; cn := wc_number(cb[..], 0, n);
  v = paint_text(out, v, a, d, FONT_MENU_SMALL, "Chats", x + 18, hy, 20, th.faint);
  v = paint_text(out, v, a, d, FONT_MENU_SMALL, cast(string) cb[0..<cn], x + w - 18 - text_width(a, FONT_MENU_SMALL, cast(string) cb[0..<cn]), hy, 20, th.faint);
  ly := hy + 24;
  room := bottom - ly;
  s[0].side_h = cast(f32) n * WC_ROW;
  most := s[0].side_h - room;
  if s[0].side_scroll > most { s[0].side_scroll = most; }
  if s[0].side_scroll < 0 { s[0].side_scroll = 0; }
  for k: 0..<n {
    y := ly + cast(f32) k * WC_ROW - s[0].side_scroll;
    if y + WC_ROW <= ly || y >= bottom { continue; }
    i := wc_nth(s, 'C', k);
    on := wc_int(wc_cell(s, i, 1)) == s[0].shown;
    h := s[0].hot == WH_CONV + k;
    if (on || h) && y >= ly - 1 && y + WC_ROW - 4 <= bottom + 1 { v = paint_quad(out, v, d, x + 8, y, w - 16, WC_ROW - 4, CHIP_RADIUS, 0, rgba(1, 1, 1, ifx on then 0.07f32 else 0.04f32), rgba(1, 1, 1, 0)); }
    title := wc_cell(s, i, 2);
    tb: [400] u8;
    title = wc_decode_into(title, tb[..]);
    if title.count == 0 { title = "(no words)"; }
    fb: [400] u8;
    if y >= ly - 2 { v = paint_text(out, v, a, d, FONT_MENU, pk_fit(a, FONT_MENU, title, w - 36, fb[..]), x + 18, y + 6, 20, ifx on then th.text else th.muted); }
    mb: [120] u8;
    m := wc_put(mb[..], 0, wc_model_name(wc_cell(s, i, 3)));
    m = wc_put(mb[..], m, " · "); m = wc_put(mb[..], m, wc_cell(s, i, 4));
    if wc_cell(s, i, 5) == "1" { m = wc_put(mb[..], m, " · Working"); }
    gb: [160] u8;
    if y + 26 + 18 <= bottom + 2 { v = paint_text(out, v, a, d, FONT_MENU_SMALL, pk_fit(a, FONT_MENU_SMALL, cast(string) mb[0..<m], w - 36, gb[..]), x + 18, y + 26, 18, th.faint); }
    wc_hit(s, WH_CONV + k, x + 8, ifx y < ly then ly else y, w - 16, WC_ROW - 4);
  }
  return v;
}
wc_decode_into :: (text: string, buf: [] u8) -> string {
  n := 0; i := 0;
  while i < text.count && n < buf.count {
    c := text[i];
    if c == '\\' && i + 1 < text.count { e := text[i + 1]; buf[n] = ifx e == 'n' then ' ' else ifx e == 'p' then '|' else e; n += 1; i += 2; continue; }
    buf[n] = c; n += 1; i += 1;
  }
  return cast(string) buf[0..<n];
}
// The sidebar (a wide window): the list, then whose key the turns run on and Key.
wc_paint_sidebar :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, h: f32) -> int {
  a := s[0].atlas[..];
  w: f32 = WC_SIDEBAR;
  side := hex(0x121212, 1);
  v := paint_quad(out, at, d, 0, 0, w, h, 0, 0, side, side);
  v = paint_quad(out, v, d, w - 1, 0, 1, h, 0, 0, th.border, th.border);
  // the name, home
  v = paint_text(out, v, a, d, FONT_MENU, "OpenAgents", 18, 8, 22, ifx s[0].hot == WH_HOME then th.text else th.muted);
  wc_hit(s, WH_HOME, 10, 8, text_width(a, FONT_MENU, "OpenAgents") + 16, 22);
  foot := h - 96;
  v = wc_paint_list(out, v, s, th, d, 0, TITLEBAR_HEIGHT - 6, w, foot - 8);
  v = paint_quad(out, v, d, 12, foot, w - 24, 1, 0, 0, th.border, th.border);
  cb: [200] u8; cn := wc_credential(s, cb[..]);
  r := wc_words(out, WcFlow.{v = v, y = foot + 10}, s, d, cast(string) cb[0..<cn], 18, w - 36, true, 18, ifx wc_has_key(s) && wc_z(s, 5) == "1" then hex(DANGER_MUTED, 1) else th.faint, 2);
  return wc_button(out, r.v, s, th, d, "Key", 10, h - 40, WH_KEY, s[0].keying).v;
}
// KEY: the asker's own Anthropic API key or Claude subscription token, a card over the conversation.
wc_paint_key :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, x0: f32, w0: f32, h: f32) -> int {
  a := s[0].atlas[..];
  v := paint_quad(out, at, d, x0, 0, w0, h, 0, 0, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  wc_hit(s, WH_SHADE, x0, 0, w0, h);
  cw := ifx w0 - 2 * WC_PAD < 480 then w0 - 2 * WC_PAD else 480.0f32;
  x := round_layout(x0 + (w0 - cw) / 2);
  y := round_layout(ifx h > 640 then h * 0.16 else 56.0f32);
  ix := x + 20; iw := cw - 40;
  // measure first: the card's height
  card := flatten(rgba(1, 1, 1, 0.04), th.shell);
  top := y;
  // the card is drawn under what follows once its height is known: reserve a quad, fill it after
  qi := v;
  v = paint_quad(out, v, d, x, y, cw, 10, 12, 1, card, th.border);
  wc_hit(s, WH_KFIELD - 1000, x, y, cw, 10);
  hi := s[0].nhit - 1;
  r := WcFlow.{v = v, y = y + 18};
  r.v = paint_text(out, r.v, a, d, FONT_BOLD, "Key", ix, r.y, 22, th.text);
  r.v = paint_text(out, r.v, a, d, FONT_TOOL, "Yours, not ours", ix + text_width(a, FONT_BOLD, "Key") + 10, r.y + 2, 20, th.faint);
  r.v = wc_button(out, r.v, s, th, d, "Close", x + cw - 12 - (round_layout(text_width(a, FONT_CHIP, "Close")) + 2 * CHIP_PAD), r.y - 3, WH_CLOSE, false).v;
  r.y += 32;
  r = wc_words(out, r, s, d, "Use your own Anthropic API key or Claude subscription. Turns on it cost you, not us, and have no daily limit here. It is checked, then kept encrypted; only the agent's runner can open it, and it is never shown again.", ix, iw, true, 19.416408, th.muted, 8);
  r.y += 12;
  if wc_has_key(s) && !s[0].replacing {
    kind := wc_z(s, 3);
    kb: [120] u8;
    m := wc_put(kb[..], 0, ifx kind == "oauth" then "Claude subscription token" else "Anthropic API key");
    m = wc_put(kb[..], m, " …"); m = wc_put(kb[..], m, wc_z(s, 4));
    r.v = paint_text(out, r.v, a, d, FONT_INPUT, cast(string) kb[0..<m], ix, r.y, 22, th.text);
    r.y += 26;
    if wc_z(s, 5) == "1" { r = wc_words(out, r, s, d, "Expired: make a new one with claude setup-token and replace it.", ix, iw, true, 19.416408, hex(DANGER_MUTED, 1), 2); }
    r.y += 6;
    b1 := wc_button(out, r.v, s, th, d, "Replace", ix - CHIP_PAD, r.y, WH_REPLACE, false);
    r.v = wc_button(out, b1.v, s, th, d, "Remove", ix - CHIP_PAD + b1.w + 4, r.y, WH_REMOVE, false).v;
    r.y += WC_BUTTON_H + 4;
  } else {
    r = wc_words(out, r, s, d, "Anthropic API key (sk-ant-api...), or Claude subscription token (from claude setup-token)", ix, iw, true, 19.416408, th.faint, 3);
    r.y += 8;
    // the field: the composer's surface, the key as dots (never its characters)
    fh := 40.0f32;
    edge := ifx s[0].key_focus then opacity(th.accent, 0.6) else th.border;
    r.v = paint_quad(out, r.v, d, ix, r.y, iw, fh, 10, 1, th.surface, edge);
    wc_hit(s, WH_KFIELD, ix, r.y, iw, fh);
    dots: [WC_KEY * 3] u8; dn := 0;
    shown := ifx s[0].key_n > 48 then 48 else s[0].key_n;
    for k: 0..<shown { dot := "•"; for b: dot { dots[dn] = b; dn += 1; } }
    tx := ix + 12;
    if dn == 0 { r.v = paint_text(out, r.v, a, d, FONT_INPUT, "Paste it here", tx, r.y + (fh - INPUT_LINE_HEIGHT) / 2, INPUT_LINE_HEIGHT, th.faint); }
    else { r.v = paint_text(out, r.v, a, d, FONT_INPUT, cast(string) dots[0..<dn], tx, r.y + (fh - INPUT_LINE_HEIGHT) / 2, INPUT_LINE_HEIGHT, th.text); }
    cx := tx + ifx dn == 0 then 0.0f32 else text_width(a, FONT_INPUT, cast(string) dots[0..<dn]);
    blink := s[0].golden || cast(int) floor(s[0].time / CARET_BLINK) % 2 == 0;
    if s[0].key_focus && blink { r.v = paint_quad(out, r.v, d, cx, r.y + (fh - 18) / 2, 2, 18, 0, 0, th.accent, th.accent); }
    s[0].field[0] = ix * s[0].d; s[0].field[1] = r.y * s[0].d; s[0].field[2] = (ix + iw) * s[0].d; s[0].field[3] = (r.y + fh) * s[0].d;
    r.y += fh + 10;
    r.v = wc_primary(out, r.v, s, th, d, ifx s[0].post_kind == POST_KEY then "Checking" else "Save", ix, r.y, WH_KSAVE).v;
    r.y += 32 + 12;
    r = wc_words(out, r, s, d, "For a subscription: run claude setup-token, approve in the browser, and paste the token it prints here.", ix, iw, true, 19.416408, th.faint, 3);
  }
  if s[0].knote_n > 0 { r.y += 4; r = wc_words(out, r, s, d, cast(string) s[0].knote[0..<s[0].knote_n], ix, iw, true, 19.416408, hex(DANGER_MUTED, 1), 3); }
  ch := r.y + 16 - top;
  // the card's quad, now its height is known (the same quad, so the same vertices)
  vq := paint_quad(out, qi, d, x, y, cw, ch, 12, 1, card, th.border);
  s[0].hits[hi].h = ch;
  return r.v;
}
// Signed out, or not an admin: the name, and Log in (/login).
wc_paint_login :: (out: [] f32, at: int, s: [] WcState, th: Theme, d: f32, w: f32, h: f32) -> int {
  a := s[0].atlas[..];
  v := paint_text(out, at, a, d, FONT_MENU, "OpenAgents", 18, 8, 22, ifx s[0].hot == WH_HOME then th.text else th.muted);
  wc_hit(s, WH_HOME, 10, 8, text_width(a, FONT_MENU, "OpenAgents") + 16, 22);
  bw := round_layout(text_width(a, FONT_CHIP, "Log in")) + 28;
  bx := round_layout((w - bw) / 2); by := round_layout(h / 2 - 16);
  return wc_primary(out, v, s, th, d, "Log in", bx, by, WH_LOGIN).v;
}

// ---------------------------------------------------------------- the frame

wc_init :: (s: [] WcState) {
  s[0].ready = true;
  c := s[0].composer[..];
  c[0].focused = true; c[0].clicked = -1; c[0].hover = -1; c[0].open = -1;
  s[0].cat[0] = wc_catalog();
  s[0].status = -1; s[0].shown = -1; s[0].model = -1;
  s[0].ask_id = -1; s[0].post_id = -1; s[0].asked_at = -1000;
  s[0].hot = WH_NONE; s[0].press = WH_NONE;
  s[0].transcript[0].seed = 1; s[0].transcript[0].pinned = true;
  s[0].built = -1;
  wc_labels(s);
}
// The demo conversation, as the Mac app's --demo opens it (zr_demo).
wc_demo :: (s: [] WcState) {
  if s[0].demo { return; }
  s[0].demo = true;
  t := s[0].transcript[..];
  t_reset(t);
  t[0].working = false;
  t_demo(t);
  s[0].composer[0].docked = true;
  wc_labels(s);
}
wc_frame :: (s: [] WcState, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int {
  if !s[0].ready { wc_init(s); }
  t := s[0].transcript[..]; c := s[0].composer[..]; a := s[0].atlas[..];
  d := ifx dpr < 1 then 1.0f32 else dpr;
  s[0].width = width; s[0].height = height; s[0].d = d;
  if uniforms.count >= 2 { uniforms[0] = width; uniforms[1] = height; }
  dt1 := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += dt1;
  c[0].since += dt1; c[0].clock += dt1;
  if s[0].golden { c[0].since = 0; }
  s[0].picker[0].since += dt1;
  a[0].frame += 1;
  s[0].field[0] = 0; s[0].field[1] = 0; s[0].field[2] = 0; s[0].field[3] = 0;
  // oa-api: read the state now and then (often while a turn runs)
  if !s[0].demo && s[0].status != 401 && s[0].status != 403 && s[0].status != 404 {
    every: f32 = ifx wc_busy(s) then WC_BUSY else WC_REFRESH;
    if s[0].status == 599 { every = 5.0; }
    if s[0].time - s[0].asked_at >= every { wc_ask(s); }
  }
  // Send, Stop and the model chip
  if c[0].clicked >= 0 { k := c[0].clicked; c[0].clicked = -1; wc_chip(s, k); }
  if c[0].sent != s[0].seen_sent {
    s[0].seen_sent = c[0].sent;
    text := cast(string) c[0].last[0..<c[0].last_n];
    if s[0].demo { t_user(t, t_pool(t, text)); } else { wc_send(s, text); }
    t[0].pinned = true;
  }
  // a notice's Log in, a code block's or notice's copy
  if t[0].action == A_LOGIN { wc_go(s, "/login"); }
  t[0].action = A_NONE;
  if t[0].copy_notice > 0 { wc_copy(s, t[0].notices[t[0].copy_notice - 1].text); t[0].copy_notice = 0; }
  if t[0].copy_code > 0 { wc_copy(s, md_block_text(t[0].md[..], t[0].copy_code - 1)); t[0].copy_code = 0; }
  // the transcript follows the state
  if !s[0].demo && s[0].built != s[0].gen { wc_build(s); wc_labels(s); }
  busy := !s[0].demo && wc_busy(s);
  if busy { s[0].work += dt1; } else { s[0].work = 0; }
  t[0].work_secs = s[0].work; t[0].spin += dt1;
  c[0].running = busy && s[0].pending_n == 0;
  th := zeron_dark();
  w := width / d; h := height / d;
  s[0].nhit = 0;
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, th.shell, th.shell);
  if !a[0].ready { return v; }
  signed_out := s[0].status == 401 || s[0].status == 403 || s[0].status == 404;
  if !s[0].demo && signed_out { s[0].keying = false; s[0].listing = false; return wc_paint_login(out, v, s, th, d, w, h); }
  if !s[0].demo && s[0].status <= 0 {
    lw := text_width(a, FONT_TOOL, "Loading");
    return paint_text(out, v, a, d, FONT_TOOL, "Loading", round_layout((w - lw) / 2), round_layout(h / 2 - 9), 18, th.faint);
  }
  wide := w >= WC_WIDE;
  side := wide && !s[0].demo;
  mx := ifx side then WC_SIDEBAR else 0.0f32;
  mw := w - mx;
  phone := mw < 640;
  if side { v = wc_paint_sidebar(out, v, s, th, d, h); }
  column := ifx mw < COMPOSER_MAX_WIDTH then mw else COMPOSER_MAX_WIDTH;
  cw := column - 2 * WC_PAD;
  x := round_layout(mx + (mw - cw) / 2);
  fb: [600] u8; fn := ifx s[0].demo then 0 else wc_failure_text(s, fb[..]);
  if wc_empty(s) {
    // Zeron's new chat: the expanded composer, centered a little high, the intro above it
    c[0].docked = false;
    composer_wrap(c, a, cw - 34);
    y := round_layout((h - composer_height(c[0].lines)) / 2 - WC_HERO_LIFT);
    t[0].nr = 0; t[0].nbox = 0; t[0].ntext = 0; t[0].nsel = 0; t[0].nhit = 0;
    r := wc_words(out, WcFlow.{v = v, y = y - 24 - 3 * 19.416408}, s, d, WC_INTRO, x + 4, cw - 8, true, 19.416408, th.faint, 3);
    v = paint_composer(out, r.v, c, a, th, d, x, y, cw);
    v = wc_paint_failure(out, v, s, th, d, x, y, cw, cast(string) fb[0..<fn]);
  } else {
    bottom_gap: f32 = ifx phone then WC_DOCK_BOTTOM_PHONE else WC_DOCK_BOTTOM;
    ch := docked_height(c, a, cw);
    stack := STATUS_STRIP_HEIGHT + ch + bottom_gap;
    t[0].view_h = h;
    t_layout(t, a, th, x, cw, stack + TRANSCRIPT_FADE_BAND + SPACE_SM);
    // a chat longer than the transcript holds starts at a later turn
    if !s[0].demo && wc_overflowed(t) && s[0].first + 1 < wc_count(s, 'U') { s[0].first += 1; s[0].gen += 1; }
    t_clamp(t);
    v = t_paint(out, v, t, a, th, d, h, stack - STATUS_STRIP_HEIGHT);
    v = paint_composer_docked(out, v, c, a, th, d, x, h - bottom_gap, cw);
    v = wc_paint_failure(out, v, s, th, d, x, c[0].y, cw, cast(string) fb[0..<fn]);
  }
  // the composer's caret: where the keyboard field (the IME's) goes
  if c[0].focused && !s[0].keying {
    s[0].field[0] = c[0].text_x * d; s[0].field[1] = c[0].text_y * d;
    s[0].field[2] = (c[0].text_x + c[0].text_w) * d; s[0].field[3] = (c[0].text_y + c[0].view_h) * d;
  }
  if !s[0].demo {
    // the titlebar's buttons: Chats and New on a narrow window, Key
    if !wide {
      b1 := wc_button(out, v, s, th, d, "Chats", WC_PAD - CHIP_PAD + 2, 5, WH_CHATS, s[0].listing);
      b2 := wc_button(out, b1.v, s, th, d, "New", WC_PAD - CHIP_PAD + 2 + b1.w + 2, 5, WH_NEW, false);
      kw := round_layout(text_width(a, FONT_CHIP, "Key")) + 2 * CHIP_PAD;
      v = wc_button(out, b2.v, s, th, d, "Key", w - WC_PAD + CHIP_PAD - 2 - kw, 5, WH_KEY, s[0].keying).v;
    }
    if s[0].keying { v = wc_paint_key(out, v, s, th, d, mx, mw, h); }
    if s[0].listing && !wide {
      v = paint_quad(out, v, d, 0, 0, w, h, 0, 0, th.shell, th.shell);
      wc_hit(s, WH_SHADE, 0, 0, w, h);
      v = wc_button(out, v, s, th, d, "Chats", WC_PAD - CHIP_PAD + 2, 5, WH_CHATS, true).v;
      v = wc_paint_list(out, v, s, th, d, WC_PAD - 8, TITLEBAR_HEIGHT, w - 2 * (WC_PAD - 8), h - 70);
      cb: [200] u8; cn := wc_credential(s, cb[..]);
      r := wc_words(out, WcFlow.{v = v, y = h - 56}, s, d, cast(string) cb[0..<cn], WC_PAD + 10, w - 2 * WC_PAD - 20, true, 18, th.faint, 2);
      v = r.v;
    }
  }
  v = pk_paint(out, v, s[0].picker[..], s[0].cat[..], wc_sel(s), a, th, d, w, h);
  wc_update_cursor(s);
  return v;
}

// ---------------------------------------------------------------- input

wc_abs :: (x: f32) -> f32 { return ifx x < 0 then -x else x; }
wc_on_composer :: (s: [] WcState, x: f32, y: f32) -> bool {
  c := s[0].composer[..];
  return !s[0].keying && !s[0].listing && x >= c[0].x && x < c[0].x + c[0].w && y >= c[0].y && y < c[0].y + c[0].h;
}
wc_main_x :: (s: [] WcState) -> f32 { d := ifx s[0].d < 1 then 1.0f32 else s[0].d; return ifx s[0].width / d >= WC_WIDE && !s[0].demo then WC_SIDEBAR else 0.0f32; }
wc_on_transcript :: (s: [] WcState, x: f32, y: f32) -> bool {
  return !s[0].keying && !s[0].listing && !wc_empty(s) && x >= wc_main_x(s) && y >= TITLEBAR_HEIGHT && y < s[0].composer[0].y - STATUS_STRIP_HEIGHT;
}
wc_update_cursor :: (s: [] WcState) {
  c := s[0].composer[..];
  x := s[0].lx; y := s[0].ly;
  s[0].cursor = 0;
  if pk_is_open(s[0].picker[..]) && pk_inside(s[0].picker[..], x, y) { s[0].cursor = 1; return; }
  h := wc_hit_at(s, x, y);
  if h == WH_KFIELD { s[0].cursor = 3; return; }
  if h != WH_NONE && h != WH_SHADE && h != WH_KFIELD - 1000 { s[0].cursor = 1; return; }
  if wc_on_composer(s, x, y) {
    if composer_chip_hit(c, x, y) >= 0 { s[0].cursor = 1; return; }
    if c[0].compact { s[0].cursor = ifx x >= c[0].text_x - COMPACT_TEXT_PAD && x < c[0].text_x + c[0].text_w + COMPACT_TEXT_PAD then 3 else 0; }
    else { s[0].cursor = ifx x >= c[0].text_x - 16 && y < c[0].y + c[0].h - ACTIONS_ROW_HEIGHT then 3 else 0; }
  } else if wc_on_transcript(s, x, y) {
    k := t_cursor(s[0].transcript[..], x, y);
    s[0].cursor = ifx k == 1 then 3 else ifx k == 2 then 1 else 0;
  }
}
// A chrome press, acted on at its release over the same target.
wc_act :: (s: [] WcState, id: int) {
  if id == WH_LOGIN { wc_go(s, "/login"); return; }
  if id == WH_HOME { wc_go(s, "/"); return; }
  if id == WH_NEW { wc_new(s); return; }
  if id == WH_CHATS { s[0].listing = !s[0].listing; s[0].keying = false; return; }
  if id == WH_KEY { s[0].keying = !s[0].keying; s[0].listing = false; s[0].key_focus = s[0].keying && !wc_has_key(s); s[0].composer[0].focused = !s[0].keying; s[0].knote_n = 0; return; }
  if id == WH_CLOSE || id == WH_SHADE { if s[0].keying { wc_close_key(s); } s[0].listing = false; return; }
  if id == WH_KFIELD { s[0].key_focus = true; return; }
  if id == WH_KSAVE { wc_save_key(s); return; }
  if id == WH_REPLACE { s[0].replacing = true; s[0].key_focus = true; wc_wipe_key(s); return; }
  if id == WH_REMOVE { if s[0].post_n == 0 && s[0].post_id < 0 { wc_post(s, "key_remove", POST_KEY_REMOVE, "", "", "", "", "", ""); } return; }
  if id >= WH_CONV { wc_open_conv(s, id - WH_CONV); }
}
wc_close_key :: (s: [] WcState) {
  s[0].keying = false; s[0].key_focus = false; s[0].replacing = false; s[0].knote_n = 0;
  wc_wipe_key(s);
  s[0].composer[0].focused = true;
}
wc_save_key :: (s: [] WcState) {
  if s[0].key_n == 0 || s[0].post_n > 0 || s[0].post_id >= 0 { return; }
  lo := 0; hi := s[0].key_n;
  while lo < hi && (s[0].key[lo] == ' ' || s[0].key[lo] == '\n') { lo += 1; }
  while hi > lo && (s[0].key[hi - 1] == ' ' || s[0].key[hi - 1] == '\n') { hi -= 1; }
  wc_post(s, "key", POST_KEY, "key", cast(string) s[0].key[lo..<hi], "", "", "", "");
  wc_wipe_key(s);
  wc_say_key(s, "");
}
// The keyboard field's text: typed or pasted.
wc_typed :: (s: [] WcState, text: string) {
  if pk_is_open(s[0].picker[..]) { b := pk_text(s[0].picker[..], s[0].cat[..], text); wc_take_picks(s); return; }
  if s[0].keying {
    if !s[0].key_focus { return; }
    for ch: text { if ch >= 32 && ch < 127 && s[0].key_n < WC_KEY { s[0].key[s[0].key_n] = ch; s[0].key_n += 1; } }
    return;
  }
  c := s[0].composer[..];
  if !c[0].focused { return; }
  if text.count > 1 { composer_paste(c, text); } else { composer_insert(c, text); }
}

coaxial_chat_frame :: (s: [] WcState, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  return wc_frame(s, out, uniforms, width, height, dpr, dt);
}
// phase 0 down, 1 move, 2 up, 3 cancel; device pixels. The click count is
// counted here (presses close in time and place), as AppKit counts it.
coaxial_chat_pointer :: (s: [] WcState, x: f32, y: f32, phase: int, kind: int) -> bool #export_c {
  if s.count < 1 { return false; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  c := s[0].composer[..]; t := s[0].transcript[..]; p := s[0].picker[..]; a := s[0].atlas[..];
  lx := x / d; ly := y / d;
  s[0].lx = lx; s[0].ly = ly;
  if phase == 0 {
    near := s[0].time - s[0].down_at < 0.45 && wc_abs(lx - s[0].down_x) < 5 && wc_abs(ly - s[0].down_y) < 5;
    s[0].clicks = ifx near then (ifx s[0].clicks >= 3 then 1 else s[0].clicks + 1) else 1;
    s[0].down_at = s[0].time; s[0].down_x = lx; s[0].down_y = ly;
    s[0].swallow = false;
    if pk_is_open(p) {
      opened := c[0].open;
      took := pk_press(p, s[0].cat[..], wc_sel(s), lx, ly);
      wc_take_picks(s);
      if took { return true; }
      if opened >= 0 && composer_chip_hit(c, lx, ly) == opened { s[0].swallow = true; return true; }
    }
    // the failure notice: a press dismisses its note
    if c[0].failure_h > 0 && ly >= c[0].failure_y && ly < c[0].failure_y + c[0].failure_h && lx >= c[0].x && lx < c[0].x + c[0].w { s[0].note_n = 0; return true; }
    h := wc_hit_at(s, lx, ly);
    s[0].press = h;
    if h != WH_NONE {
      if h == WH_KFIELD { s[0].key_focus = true; }
      else if s[0].keying && h != WH_KSAVE { s[0].key_focus = false; }
      c[0].focused = false;
      return true;
    }
    s[0].on_composer = wc_on_composer(s, lx, ly);
    if s[0].on_composer { t[0].has_sel = false; t_hover(t, -1, -1); }
    took := composer_press(c, a, lx, ly, s[0].clicks, s[0].shift);
    if !s[0].on_composer && wc_on_transcript(s, lx, ly) { t_pointer(t, a, lx, ly, 0, s[0].clicks, s[0].shift); }
    wc_update_cursor(s);
    return took;
  }
  if phase == 1 {
    if pk_is_open(p) { pk_move(p, s[0].cat[..], wc_sel(s), lx, ly); wc_take_picks(s); }
    s[0].hot = wc_hit_at(s, lx, ly);
    hc := composer_chip_hit(c, lx, ly);
    c[0].hover = ifx (hc == CH_MODEL) && !s[0].keying && !s[0].listing then hc else -1;
    if pk_is_open(p) && pk_inside(p, lx, ly) { c[0].hover = -1; s[0].hot = WH_NONE; }
    if c[0].selecting { composer_drag(c, a, lx, ly); wc_update_cursor(s); return true; }
    if t[0].selecting || t[0].press_kind != 0 || wc_on_transcript(s, lx, ly) { t_pointer(t, a, lx, ly, 1, s[0].clicks, s[0].shift); }
    else { t_hover(t, -1, -1); }
    wc_update_cursor(s);
    return false;
  }
  if pk_is_open(p) { pk_release(p); }
  if s[0].swallow { s[0].swallow = false; return false; }
  pressed := s[0].press; s[0].press = WH_NONE;
  if pressed != WH_NONE {
    if phase == 2 && wc_hit_at(s, lx, ly) == pressed { wc_act(s, pressed); }
    // a touch has no hover: its wash goes with it
    if kind != 0 { s[0].hot = WH_NONE; }
    wc_update_cursor(s);
    return true;
  }
  composer_release(c);
  if t[0].selecting || t[0].press_kind != 0 { t_pointer(t, a, lx, ly, 2, s[0].clicks, s[0].shift); }
  if kind != 0 { t_hover(t, -1, -1); c[0].hover = -1; }
  wc_update_cursor(s);
  return false;
}
// The wheel, CSS pixels down: the open menu's list, the sidebar, the composer's text, else the transcript.
coaxial_chat_wheel :: (s: [] WcState, dy: f32) #export_c {
  if s.count < 1 { return; }
  if pk_is_open(s[0].picker[..]) { b := pk_wheel(s[0].picker[..], s[0].cat[..], -dy); return; }
  d := ifx s[0].d < 1 then 1.0f32 else s[0].d;
  if s[0].listing || (s[0].width / d >= WC_WIDE && s[0].lx < WC_SIDEBAR && !s[0].demo) { s[0].side_scroll += dy; return; }
  if s[0].keying { return; }
  if wc_on_composer(s, s[0].lx, s[0].ly) && composer_wheel(s[0].composer[..], -dy) { return; }
  moved := t_wheel(s[0].transcript[..], -dy);
  t_hover(s[0].transcript[..], s[0].lx, s[0].ly);
}
coaxial_chat_key :: (s: [] WcState, key: int, mods: int) -> bool #export_c {
  if s.count < 1 { return false; }
  if key == WK_SHIFT { s[0].shift = true; return false; }
  if key == WK_CONTROL { return false; }
  s[0].shift = (mods & MOD_SHIFT) != 0;
  c := s[0].composer[..]; t := s[0].transcript[..];
  cmd := (mods & (MOD_CMD | MOD_CTRL)) != 0;
  // an open menu holds the keyboard
  p := s[0].picker[..];
  if pk_is_open(p) {
    took := pk_key(p, s[0].cat[..], wc_sel(s), ifx key == WK_TAB then KEY_TAB else key, mods);
    wc_take_picks(s);
    return took;
  }
  if key == WK_TAB { return false; }
  if s[0].keying {
    if key == KEY_ESCAPE { wc_close_key(s); return true; }
    if !s[0].key_focus { return false; }
    if key == KEY_ENTER { wc_save_key(s); return true; }
    if key == KEY_BACKSPACE { if s[0].key_n > 0 { s[0].key_n -= 1; s[0].key[s[0].key_n] = 0; } return true; }
    if cmd && (key == 'a' || key == 'A' || key == 'c' || key == 'x') { return true; }   // a key is never copied
    return false;
  }
  if s[0].listing && key == KEY_ESCAPE { s[0].listing = false; return true; }
  // copy and cut: the composer's selection, else the transcript's (the host puts it on the clipboard)
  if cmd && (key == 'c' || key == 'C' || key == 'x' || key == 'X') {
    if c[0].focused && sel_hi(c) > sel_lo(c) {
      wc_copy(s, selected(c));
      if key == 'x' || key == 'X' { composer_cut_selection(c); }
      return true;
    }
    if t[0].has_sel && (key == 'c' || key == 'C') {
      n := t_selected(t, s[0].outbox[..]);
      if n > 0 && n <= s[0].outbox.count { s[0].out_n = n; s[0].action = WC_COPY; }
      return true;
    }
    return false;
  }
  if cmd && (key == 'a' || key == 'A') && !c[0].focused {
    if t[0].nsel == 0 { return false; }
    t[0].anchor = SelPos.{line = 0, off = 0};
    t[0].focus = SelPos.{line = t[0].nsel - 1, off = t_line_len(t, t[0].nsel - 1)};
    t[0].has_sel = true;
    return true;
  }
  // Escape stops a running turn (Enter never does)
  if key == KEY_ESCAPE && mods == 0 && c[0].running && !s[0].demo { wc_stop(s); return true; }
  // typing anywhere goes to the composer
  if !c[0].focused && key > 0 && !cmd { c[0].focused = true; }
  return composer_key(c, s[0].atlas[..], key, mods);
}
coaxial_chat_key_up :: (s: [] WcState, key: int, mods: int) -> bool #export_c {
  if s.count < 1 { return false; }
  if key == WK_SHIFT { s[0].shift = false; }
  return false;
}
coaxial_chat_message :: (s: [] WcState, kind: int, length: int) #export_c {
  if s.count < 1 || length < 0 || length > s[0].inbox.count { return; }
  text := cast(string) s[0].inbox[0..<length];
  if kind >= WC_HTTP && kind < WC_HTTP + 8 { wc_answer(s, kind - WC_HTTP, text); return; }
  if kind == WC_TYPED { wc_typed(s, text); return; }
  if kind == WC_SHOWN && s[0].status == 200 { s[0].asked_at = -1000; }   // shown again: read the state now
}
// The location's hash: #demo shows Zeron's demo conversation.
coaxial_chat_hash :: (s: [] WcState, length: int) #export_c {
  if s.count < 1 || length < 0 || length > s[0].inbox.count { return; }
  if !s[0].ready { wc_init(s); }
  if cast(string) s[0].inbox[0..<length] == "demo" { wc_demo(s); }
}
coaxial_chat_golden :: (s: [] WcState, on: bool) #export_c { if s.count > 0 { s[0].golden = on; } }
coaxial_chat_wants_text :: (s: [] WcState) -> bool #export_c {
  if s.count < 1 { return false; }
  if s[0].keying { return s[0].key_focus; }
  return s[0].composer[0].focused || pk_is_open(s[0].picker[..]);
}
coaxial_chat_cursor :: (s: [] WcState) -> int #export_c { if s.count < 1 { return 0; } return s[0].cursor; }
coaxial_chat_action :: (s: [] WcState) -> int #export_c { if s.count < 1 { return 0; } return s[0].action; }
coaxial_chat_action_done :: (s: [] WcState) #export_c { if s.count > 0 { s[0].action = 0; s[0].out_n = 0; } }
coaxial_chat_inbox_cap :: () -> int #export_c { return WC_INBOX; }
coaxial_chat_max_vertices :: () -> int #export_c { return WC_MAX_VERTICES; }
coaxial_chat_vertex_floats :: () -> int #export_c { return GP_VERTEX_FLOATS; }

// ---------------------------------------------------------------- the atlas, for coax/web/gpui.js

coaxial_chat_glyph_count :: () -> int #export_c { return GP_GLYPHS; }
coaxial_chat_glyph_code :: (g: int) -> int #export_c {
  if g < 95 { return g + 32; }
  extra := GP_EXTRA;
  return ifx g - 95 < 3 then cast(int) extra[g - 95] else 63;
}
coaxial_chat_font_count :: () -> int #export_c { return GP_FONTS; }
coaxial_chat_font_size :: (k: int) -> f32 #export_c { sizes := FONT_SIZES; return ifx k >= 0 && k < GP_FONTS then sizes[k] else 14.0f32; }
coaxial_chat_font_weight :: (k: int) -> int #export_c { weights := FONT_WEIGHTS; return ifx k >= 0 && k < GP_FONTS then weights[k] else 0; }
coaxial_chat_icon_count :: () -> int #export_c { return ICON_COUNT; }
coaxial_chat_icon_size :: (i: int) -> f32 #export_c { sizes := ICON_SIZES; return ifx i >= 0 && i < ICON_COUNT then sizes[i] else 16.0f32; }
// An icon's file name, into the scratch bytes; its length.
coaxial_chat_icon_name :: (s: [] WcState, i: int) -> int #export_c {
  if s.count < 1 || i < 0 || i >= ICON_COUNT { return 0; }
  names := ICON_NAMES;
  n := ifx names[i].count < 64 then names[i].count else 64;
  for k: 0..<n { s[0].sbytes[k] = names[i][k]; }
  return n;
}
// A font from the scratch: its header (7), then each glyph's advance, then the kerning.
coaxial_chat_set_font :: (s: [] WcState, slot: int) #export_c {
  if s.count < 1 { return; }
  sizes := FONT_SIZES;
  if slot < 0 || slot >= GP_FONTS { return; }
  gp_set_font(s[0].atlas[..], slot, sizes[slot], s[0].scratch[0..<7], s[0].scratch[7..<7 + GP_GLYPHS], s[0].scratch[7 + GP_GLYPHS..<7 + GP_GLYPHS + GP_GLYPHS * GP_GLYPHS]);
}
coaxial_chat_set_icon :: (s: [] WcState, i: int, x: f32, y: f32, w: f32, h: f32) #export_c { if s.count > 0 { gp_set_icon(s[0].atlas[..], i, x, y, w, h); } }
coaxial_chat_set_atlas :: (s: [] WcState, width: f32, height: f32, levels: int) #export_c { if s.count > 0 { gp_set_atlas(s[0].atlas[..], width, height, levels); } }
coaxial_chat_set_dynamic :: (s: [] WcState, size: f32, pen_x: f32, pen_y: f32, y0: f32, cols: int, color_cols: int, color_width: f32, color_height: f32) #export_c {
  if s.count > 0 { gp_set_dynamic(s[0].atlas[..], size, pen_x, pen_y, y0, cols, color_cols, color_width, color_height); }
}
coaxial_chat_next_cluster :: (s: [] WcState) -> int #export_c { if s.count < 1 { return -1; } return gp_next_cluster(s[0].atlas[..]); }
// A cluster's bytes into the scratch bytes; font * 256 + their count.
coaxial_chat_cluster :: (s: [] WcState, slot: int) -> int #export_c { if s.count < 1 { return 0; } return gp_cluster(s[0].atlas[..], slot, s[0].sbytes[..]); }
coaxial_chat_measured :: (s: [] WcState, slot: int, advance: f32, color: bool) #export_c { if s.count > 0 { gp_measured(s[0].atlas[..], slot, advance, color); } }
coaxial_chat_next_cell :: (s: [] WcState) -> int #export_c { if s.count < 1 { return -1; } return gp_next_cell(s[0].atlas[..]); }
// A wanted cell's six numbers into the scratch: slot, level, subpixel, color, texel x, y.
coaxial_chat_cell :: (s: [] WcState, cell: int) -> bool #export_c { if s.count < 1 { return false; } return gp_cell(s[0].atlas[..], cell, s[0].scratch[0..<6]); }
coaxial_chat_cell_ready :: (s: [] WcState, cell: int) #export_c { if s.count > 0 { gp_cell_ready(s[0].atlas[..], cell); } }

// ---------------------------------------------------------------- checks

#test "the agent's tools become Zeron's chips" {
  #assert wc_tool_kind("Read") == TK_READ;
  #assert wc_tool_kind("Grep") == TK_SEARCH;
  #assert wc_tool_kind("Glob") == TK_GLOB;
  #assert wc_tool_kind("WebSearch") == TK_WEB;
  #assert wc_tool_kind("WebFetch") == TK_FETCH;
  #assert wc_tool_kind("Mystery") == TK_TOOL;
}
#test "a group's summary is Zeron's words" {
  kinds := [4] int.[TK_READ, TK_READ, TK_SEARCH, TK_FETCH];
  out: [128] u8;
  n := wc_summary(kinds[..], 4, out[..]);
  #assert cast(string) out[0..<n] == "Read 2 files · searched 1 time · fetched 1 page";
  one := [1] int.[TK_GLOB];
  n = wc_summary(one[..], 1, out[..]);
  #assert cast(string) out[0..<n] == "Searched 1 time";
}
#test "cents, JSON and answers" {
  #assert wc_cents("1.07") == 107;
  #assert wc_cents("5") == 500;
  #assert wc_cents("") == -1;
  buf: [64] u8;
  n := wc_json(buf[..], 0, "a\"b\nc");
  #assert cast(string) buf[0..<n] == "a\\\"b\\nc";
  #assert wc_value("{\"c\": 42, \"error\": \"no\"}", 0, "c") == "42";
  #assert wc_value("{\"c\": 42, \"error\": \"no\"}", 0, "error") == "no";
  #assert wc_int("12") == 12 && wc_int("x") == -1;
}
#test "titles lose their escapes" {
  buf: [32] u8;
  #assert wc_decode_into("a\\pb\\nc", buf[..]) == "a|b c";
}
#test "the menu offers the three models oa-api runs" {
  c: [1] PkCatalog;
  c[0] = wc_catalog();
  #assert c[0].n == 3 && c[0].id[0] == "claude-opus-5-5" && c[0].label[2] == "Haiku 5.5";
  #assert pk_level_for(c[..], 0, 0) == -1;
  #assert wc_model_index("claude-sonnet-5-5") == 1 && wc_model_name("claude-haiku-5-5") == "Haiku 5.5";
}
