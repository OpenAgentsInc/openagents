// OpenAgents' own tools on /chat (the OpenAgents agent on a Gemini model): the rows of the realm command table
// that this page can run as the person logged in. The rows come from the table's copy (realm-tools.coax,
// generated from REALM_COMMANDS in apps/openagents-cli/commands.coax), so each tool's name, help and properties
// are the ones the CLI and the openagents MCP server use. They go to the model as Chat Completions function tools
// (coax/lib/gateway/chat.coax: GwRequest.tools, GW_EV_TOOL), and a call the model makes is run by this page
// through the API's own route for that row, with the page's own login, as the CLI runs it with a key. The routes
// decide who may read what, exactly as they do for the side and the CLI.
//
// Which rows run here is decided by their typed fields, never by words: a read (effect "read") whose route the API
// answers to a page. A row with method GET is a realm route, /api/playtest/realms/SLUG then the row's route (the
// list, "/mine", also reads the worlds the side lists, /api/worlds). A world row (route "world") and an attachment
// row (route "files") read /api/worlds/ID. Not here: writes (in the editor a hosted turn edits the world through
// its own world tools, coax/lib/agent/world/turn.coax; elsewhere the agents on the person's computer run them),
// pictures and seats (they drive a browser on a computer), and world-why (it asks an open page).
//   coax/bin/coax test apps/openagents-web/chat/chat-hosted.coax

#load "../realm/realm-tools.coax";
#load "../../../coax/lib/nostr/json.coax";
#load "../../../coax/lib/agent/claude/fields.coax";   // cl_*: the JSON reader

CH_STEPS :: 4;         // asks of the model for one message; the last one has no tools, so it answers
CH_CALLS :: 8;         // calls one ask may make (more are left out, and the model is told)
CH_NAME :: 64;         // bytes of a call's name
CH_ARGS :: 512;        // bytes of its arguments' JSON
CH_SLUG :: 48;         // a realm's or a world's ID (commands.coax rc_bound "slug")
CH_FID :: 16;          // an attachment's ID (rc_bound "fileid")
CH_PATH :: 96;         // a request's path (the page's door holds 96 bytes)
CH_RESULT :: 4096;     // bytes of one call's answer the model is sent
CH_RESULTS :: 16384;   // and of every answer for one message
CH_TOOLS :: 8192;      // the tools' JSON
CH_SYSTEM :: 8192;     // the instructions

// How the page runs a row.
CH_NONE :: 0; CH_LIST :: 1; CH_REALM :: 2; CH_WORLD :: 3; CH_CONTENT :: 4; CH_OPEN :: 5; CH_SCRIPTS :: 6; CH_FILES :: 7; CH_FILE :: 8;

// A row's runner, from its fields; CH_NONE for a row this page doesn't run.
ch_runner :: (r: RealmTool) -> int {
  if r.effect != "read" { return CH_NONE; }
  if r.method == "GET" { return ifx r.route == "/mine" then CH_LIST else CH_REALM; }
  if r.route == "world" {
    if r.name == "realm_world" { return CH_WORLD; }
    if r.name == "realm_world_foes" { return CH_CONTENT; }   // the actors' plans are the plans table of the content
    if r.name == "realm_world_open" { return CH_OPEN; }
    if r.name == "realm_world_scripts" { return CH_SCRIPTS; }
    return CH_NONE;
  }
  if r.route == "files" { return ifx r.name == "realm_file_read" then CH_FILE else ifx r.name == "realm_files" then CH_FILES else CH_NONE; }
  return CH_NONE;
}
// The row of a tool this page runs, by its exact name, or -1.
ch_row :: (name: string) -> int {
  for r, i: REALM_TOOLS { if r.name == name && ch_runner(r) != CH_NONE { return i; } }
  return -1;
}
// A property's place in a row's required properties ("slug|fileid"), or -1.
ch_prop_at :: (props: string, name: string) -> int {
  at := 0; k := 0;
  for i: 0..<props.count + 1 {
    if i < props.count && props[i] != '|' { continue; }
    if cast(string) props[at..<i] == name { return k; }
    k += 1; at = i + 1;
  }
  return -1;
}
ch_props :: (props: string) -> int { if props.count == 0 { return 0; } n := 1; for c: props { if c == '|' { n += 1; } } return n; }
ch_prop :: (props: string, k: int) -> string {
  at := 0; j := 0;
  for i: 0..<props.count + 1 {
    if i < props.count && props[i] != '|' { continue; }
    if j == k { return props[at..<i]; }
    j += 1; at = i + 1;
  }
  return "";
}
CH_PROP_NAMES :: [2] string.["slug", "fileid"];
CH_PROP_NOTES :: [2] string.["the realm's or world's ID, as realm_list names it (such as splice)", "the attachment's ID, 16 hex digits, as realm_files lists it"];

// The tools, as Chat Completions function tools: each row this page runs, with its help and its properties.
ch_tools :: (out: [] u8) -> string {
  n := json_raw(out, 0, "[");
  first := true;
  names := CH_PROP_NAMES; notes := CH_PROP_NOTES;
  for r: REALM_TOOLS {
    if ch_runner(r) == CH_NONE { continue; }
    if !first { n = json_raw(out, n, ","); }
    first = false;
    n = json_raw(out, n, "{\"type\":\"function\",\"function\":{\"name\":"); n = json_write_string(out, n, r.name);
    n = json_raw(out, n, ",\"description\":"); n = json_write_string(out, n, r.help);
    n = json_raw(out, n, ",\"parameters\":{\"type\":\"object\",\"properties\":{");
    for k: 0..<ch_props(r.props) {
      p := ch_prop(r.props, k);
      if k > 0 { n = json_raw(out, n, ","); }
      n = json_write_string(out, n, p); n = json_raw(out, n, ":{\"type\":\"string\",\"description\":");
      note := "";
      for w, j: names { if w == p { note = notes[j]; } }
      n = json_write_string(out, n, note); n = json_raw(out, n, "}");
    }
    n = json_raw(out, n, "},\"required\":[");
    for k: 0..<ch_props(r.props) { if k > 0 { n = json_raw(out, n, ","); } n = json_write_string(out, n, ch_prop(r.props, k)); }
    n = json_raw(out, n, "]}}}");
  }
  n = json_raw(out, n, "]");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

// What the model is told: who it is, the tools it has (each row's name, properties and help), what it can't do,
// the projects the side lists, and the model it is.
CH_WHO :: "You are OpenAgents, answering in the chat on openagents.com. Speak as \"we\" for OpenAgents. Be direct and brief, and use Markdown where it helps.\n";
CH_HAVE :: "We have these tools, the read-only rows of our realm command table (the same tools the openagents CLI and its MCP server offer). We run them as the person logged in here, through openagents.com's own routes, so they see what that person may see:\n";
CH_RULES :: "Call a tool when the question needs what it reads, such as which worlds or realms the person has or what one holds; never guess what a world, realm or attachment holds. When asked what tools we have, name these and say what each does.\nThese tools only read. Here we can't change a world or a realm, search or read the web, run code, or read files outside these tools, and we don't remember other conversations. To change a world, the person opens it in the editor (realm_world_open gives its address), where we can place, move, turn, size and remove things; the agents on their own computer (Claude Code, Codex, Microcoder, through Coder) have every realm tool.\n";
ch_system :: (projects: string, model_name: string, model_id: string, out: [] u8) -> string {
  n := json_raw(out, 0, CH_WHO);
  n = json_raw(out, n, CH_HAVE);
  for r: REALM_TOOLS {
    if ch_runner(r) == CH_NONE { continue; }
    n = json_raw(out, n, "- "); n = json_raw(out, n, r.name);
    if r.props.count > 0 { n = json_raw(out, n, " ("); for k: 0..<ch_props(r.props) { if k > 0 { n = json_raw(out, n, ", "); } n = json_raw(out, n, ch_prop(r.props, k)); } n = json_raw(out, n, ")"); }
    n = json_raw(out, n, ": "); n = json_raw(out, n, r.help); n = json_raw(out, n, "\n");
  }
  n = json_raw(out, n, CH_RULES);
  if projects.count > 0 { n = json_raw(out, n, "The projects the person is in, as the side lists them: "); n = json_raw(out, n, projects); n = json_raw(out, n, ".\n"); }
  n = json_raw(out, n, "If asked which model you are, say exactly this and never guess another version: the model answering is ");
  n = json_raw(out, n, model_name); n = json_raw(out, n, " ("); n = json_raw(out, n, model_id); n = json_raw(out, n, ") on Google's Vertex AI.");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

// One call the model asked for, gathered from the stream's pieces (GW_EV_TOOL), then read.
ChCall :: struct {
  index: int;
  name: [CH_NAME] u8; name_n: int;
  args: [CH_ARGS] u8; args_n: int;
  row: int;                          // its row in REALM_TOOLS once read, -1 for none
  slug: [CH_SLUG] u8; slug_n: int;
  fid: [CH_FID] u8; fid_n: int;
  why: string;                       // why it can't run, "" when it can
}
// A piece of a call into the calls so far: a new index starts a call (at most CH_CALLS), an index seen adds to it.
// How many calls there are now.
ch_gather :: (calls: [] ChCall, had: int, index: int, name: string, args: string) -> int {
  n := had; k := -1;
  for i: 0..<n { if calls[i].index == index { k = i; } }
  if k < 0 {
    if n >= calls.count { return n; }
    k = n; calls[k] = ChCall.{index = index, row = -1};
    n += 1;
  }
  for c: name { if calls[k].name_n < CH_NAME { calls[k].name[calls[k].name_n] = c; calls[k].name_n += 1; } }
  for c: args { if calls[k].args_n < CH_ARGS { calls[k].args[calls[k].args_n] = c; calls[k].args_n += 1; } }
  return n;
}
ch_name :: (c: [] ChCall) -> string { return cast(string) c[0].name[0..<c[0].name_n]; }
ch_args :: (c: [] ChCall) -> string { return ifx c[0].args_n == 0 then "{}" else cast(string) c[0].args[0..<c[0].args_n]; }
ch_slug :: (c: [] ChCall) -> string { return cast(string) c[0].slug[0..<c[0].slug_n]; }
ch_fid :: (c: [] ChCall) -> string { return cast(string) c[0].fid[0..<c[0].fid_n]; }
// A realm's or world's ID as the command table bounds it: 1 to 48 of a-z, 0-9 and -, a letter or digit first.
ch_slug_ok :: (s: string) -> bool {
  if s.count < 1 || s.count > CH_SLUG || s[0] == '-' { return false; }
  for b: s { if !((b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '-') { return false; } }
  return true;
}
ch_fid_ok :: (s: string) -> bool {
  if s.count != CH_FID { return false; }
  for b: s { if !((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f')) { return false; } }
  return true;
}
// Reads a gathered call: its row, and the properties the row requires from its arguments. False with why, and
// then it has no row (so it makes no request).
ch_read :: (c: [] ChCall) -> bool {
  ok := ch_read_args(c);
  if !ok { c[0].row = -1; }
  return ok;
}
ch_read_args :: (c: [] ChCall) -> bool {
  c[0].row = ch_row(ch_name(c));
  if c[0].row < 0 { c[0].why = "we have no such tool here"; return false; }
  args := ch_args(c);
  if !json_valid(args) || args[0] != '{' { c[0].why = "its arguments are not a JSON object"; return false; }
  ar: [1] ClArena; scratch: [CH_ARGS] u8; ar[0].buf = scratch[..];
  props := REALM_TOOLS[c[0].row].props;
  if ch_prop_at(props, "slug") >= 0 {
    s := cl_str(ar[..], args, "slug");
    if !ch_slug_ok(s) { c[0].why = "slug must be a realm's or world's ID: 1 to 48 of a-z, 0-9 and -"; return false; }
    for b, i: s { c[0].slug[i] = b; }
    c[0].slug_n = s.count;
  }
  if ch_prop_at(props, "fileid") >= 0 {
    f := cl_str(ar[..], args, "fileid");
    if !ch_fid_ok(f) { c[0].why = "fileid must be an attachment's 16 hex digits, as realm_files lists them"; return false; }
    for b, i: f { c[0].fid[i] = b; }
    c[0].fid_n = f.count;
  }
  c[0].why = "";
  return true;
}
// The path of part `part` of a call that was read (most calls are one request; a list and a world are two), or ""
// when the call has no more.
ch_path :: (c: [] ChCall, part: int, out: [] u8) -> string {
  if c[0].row < 0 { return ""; }
  r := REALM_TOOLS[c[0].row]; run := ch_runner(r);
  n := 0;
  if run == CH_LIST {
    if part == 0 { n = json_raw(out, 0, "/api/worlds"); }
    else if part == 1 { n = json_raw(out, 0, "/api/playtest/realms/mine"); }
    else { return ""; }
    return ifx n < 0 then "" else cast(string) out[0..<n];
  }
  if run == CH_WORLD && part > 1 || run != CH_WORLD && part > 0 { return ""; }
  if run == CH_REALM { n = json_raw(out, 0, "/api/playtest/realms/"); n = json_raw(out, n, ch_slug(c)); n = json_raw(out, n, r.route); return ifx n < 0 then "" else cast(string) out[0..<n]; }
  n = json_raw(out, 0, "/api/worlds/"); n = json_raw(out, n, ch_slug(c));
  if run == CH_WORLD { n = json_raw(out, n, ifx part == 0 then "/card" else "/content?lane=dev"); }
  else if run == CH_CONTENT { n = json_raw(out, n, "/content?lane=dev"); }
  else if run == CH_OPEN { n = json_raw(out, n, "/card"); }
  else if run == CH_SCRIPTS { n = json_raw(out, n, "/scripts"); }
  else if run == CH_FILES { n = json_raw(out, n, "/files"); }
  else if run == CH_FILE { n = json_raw(out, n, "/files/"); n = json_raw(out, n, ch_fid(c)); }
  return ifx n < 0 || n > CH_PATH then "" else cast(string) out[0..<n];
}
// What a call adds to its answer of its own: a world's editor address (world-open answers it, as the CLI does).
ch_note :: (c: [] ChCall, out: [] u8) -> string {
  if c[0].row < 0 || ch_runner(REALM_TOOLS[c[0].row]) != CH_OPEN { return ""; }
  n := json_raw(out, 0, "the editor: /worlds/"); n = json_raw(out, n, ch_slug(c)); n = json_raw(out, n, "?edit");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// Whether a call reads a world (its card follows the answer on /chat).
ch_world :: (c: [] ChCall) -> bool {
  if c[0].row < 0 { return false; }
  run := ch_runner(REALM_TOOLS[c[0].row]);
  return run == CH_WORLD || run == CH_OPEN;
}
// One request's answer onto the answers the model is sent: the call, the route and its status, then its body
// (at most CH_RESULT bytes, cut on a character, and said so). Where it ends; at when nothing fits.
ch_result :: (out: [] u8, at: int, c: [] ChCall, path: string, status: int, body: string) -> int {
  head: [CH_NAME + CH_ARGS + CH_PATH + 64] u8;
  h := json_raw(head[..], 0, ch_name(c)); h = json_raw(head[..], h, " "); h = json_raw(head[..], h, ch_args(c));
  h = json_raw(head[..], h, ": GET "); h = json_raw(head[..], h, path); h = json_raw(head[..], h, " answered ");
  if status == 0 { h = json_raw(head[..], h, "nothing (not reached)"); } else { h = json_raw(head[..], h, "HTTP "); h = json_write_int(head[..], h, status); }
  h = json_raw(head[..], h, "\n");
  if h < 0 { return at; }
  cut := ifx body.count > CH_RESULT then CH_RESULT else body.count;
  while cut > 0 && cut < body.count && (body[cut] & 0xC0) == 0x80 { cut -= 1; }
  n := json_raw(out, at, cast(string) head[0..<h]);
  n = json_raw(out, n, cast(string) body[0..<cut]);
  if cut < body.count { n = json_raw(out, n, "\n[the rest is left out: it is longer than we read at once]"); }
  n = json_raw(out, n, "\n\n");
  return ifx n < 0 then at else n;
}
// A call that can't run, onto the answers: its name and why.
ch_refused :: (out: [] u8, at: int, c: [] ChCall) -> int {
  n := json_raw(out, at, ch_name(c)); n = json_raw(out, n, " "); n = json_raw(out, n, ch_args(c));
  n = json_raw(out, n, ": not run: "); n = json_raw(out, n, c[0].why); n = json_raw(out, n, "\n\n");
  return ifx n < 0 then at else n;
}
CH_ANSWERS :: "What our tools answered, a call and then its answer (we called them; the person did not write this):\n\n";
CH_LAST :: "Answer now in words from what the tools answered; no more tools are offered for this message.";

#test "the rows this page runs are the command table's reads with a route it can ask, and each needs only a slug or an attachment's ID" {
  ran := 0;
  for r: REALM_TOOLS {
    run := ch_runner(r);
    if run == CH_NONE { continue; }
    ran += 1;
    #assert r.effect == "read";
    for k: 0..<ch_props(r.props) { p := ch_prop(r.props, k); #assert p == "slug" || p == "fileid"; }
  }
  #assert ran == 12 && ch_row("realm_list") >= 0 && ch_row("realm_world") >= 0 && ch_row("realm_file_read") >= 0 && ch_row("realm_doc") >= 0;
  // writes, pictures, seats and a question for an open page are not run here
  for w: [6] string.["realm_world_place", "realm_move", "realm_shot", "realm_look", "realm_world_why", "realm_publish"] { #assert ch_row(w) < 0; }
  #assert ch_row("mcp__openagents__realm_list") < 0 && ch_row("") < 0;
  #assert ch_prop_at("slug|fileid", "fileid") == 1 && ch_prop_at("slug", "fileid") < 0 && ch_props("") == 0 && ch_prop("slug|fileid", 1) == "fileid";
}
#test "the tools go as function tools from the rows: name, help, properties, required" {
  out: [CH_TOOLS] u8;
  t := ch_tools(out[..]);
  #assert t.count > 0 && json_valid(t) && cl_count(t) == 12;
  #assert cl_raw(t, "0.function.name") == "\"realm_list\"" && cl_raw(t, "0.function.parameters.required") == "[]";
  #assert cl_raw(t, "0.function.description") == "\"your realms, and the worlds you may edit as the side lists them\"";
  #assert has_test(t, "{\"name\":\"realm_file_read\",") && has_test(t, "\"required\":[\"slug\",\"fileid\"]");
  #assert ch_tools(out[0..<100]) == "";
}
#test "the instructions name each tool with its help, say what can't be done here, and the model" {
  out: [CH_SYSTEM] u8;
  s := ch_system("Coax, Splice", "Gemini 4 Hydrogen", "google/gemini-4-hydrogen", out[..]);
  #assert s.count > 0 && has_test(s, "You are OpenAgents") && has_test(s, "- realm_list: your realms, and the worlds you may edit as the side lists them\n");
  #assert has_test(s, "- realm_file_read (slug, fileid): an attachment") && has_test(s, "can't change a world") && has_test(s, "projects the person is in, as the side lists them: Coax, Splice.");
  #assert has_test(s, "the model answering is Gemini 4 Hydrogen (google/gemini-4-hydrogen) on Google's Vertex AI.") && !has_test(s, "realm_world_place");
  #assert !has_test(ch_system("", "a", "b", out[..]), "projects the person is in");
}
#test "a call's pieces gather by index; a call is read against its row; its requests are the row's routes" {
  calls: [CH_CALLS] ChCall; n := 0;
  n = ch_gather(calls[..], n, 0, "realm_world", "{\"slug\":");
  n = ch_gather(calls[..], n, 1, "realm_list", "");
  n = ch_gather(calls[..], n, 0, "", "\"splice\"}");
  #assert n == 2 && ch_name(calls[0..<1]) == "realm_world" && ch_args(calls[0..<1]) == "{\"slug\":\"splice\"}" && ch_args(calls[1..<2]) == "{}";
  #assert ch_read(calls[0..<1]) && ch_slug(calls[0..<1]) == "splice" && ch_read(calls[1..<2]);
  pb: [CH_PATH] u8;
  #assert ch_path(calls[0..<1], 0, pb[..]) == "/api/worlds/splice/card" && ch_path(calls[0..<1], 1, pb[..]) == "/api/worlds/splice/content?lane=dev" && ch_path(calls[0..<1], 2, pb[..]) == "";
  #assert ch_path(calls[1..<2], 0, pb[..]) == "/api/worlds" && ch_path(calls[1..<2], 1, pb[..]) == "/api/playtest/realms/mine" && ch_path(calls[1..<2], 2, pb[..]) == "";
  #assert ch_world(calls[0..<1]) && !ch_world(calls[1..<2]);
  // a realm route is its row's own
  d: [1] ChCall; d[0] = ChCall.{row = -1};
  n = ch_gather(d[..], 0, 3, "realm_doc", "{\"slug\":\"garden\"}");
  #assert ch_read(d[..]) && ch_path(d[0..<1], 0, pb[..]) == "/api/playtest/realms/garden/doc" && ch_path(d[0..<1], 1, pb[..]) == "";
  f: [1] ChCall;
  n = ch_gather(f[..], 0, 0, "realm_file_read", "{\"slug\":\"splice\",\"fileid\":\"0123456789abcdef\"}");
  #assert ch_read(f[..]) && ch_path(f[0..<1], 0, pb[..]) == "/api/worlds/splice/files/0123456789abcdef";
  o: [1] ChCall; nb: [128] u8;
  n = ch_gather(o[..], 0, 0, "realm_world_open", "{\"slug\":\"splice\"}");
  #assert ch_read(o[..]) && ch_path(o[0..<1], 0, pb[..]) == "/api/worlds/splice/card" && ch_note(o[0..<1], nb[..]) == "the editor: /worlds/splice?edit" && ch_note(calls[0..<1], nb[..]) == "";
  // a tool it doesn't have, arguments that aren't an object, a slug or an ID out of bounds: each says why
  b: [1] ChCall;
  n = ch_gather(b[..], 0, 0, "realm_world_place", "{\"slug\":\"splice\"}");
  #assert !ch_read(b[..]) && b[0].why == "we have no such tool here" && ch_path(b[0..<1], 0, pb[..]) == "";
  for bad: [4] string.["{\"slug\":\"../x\"}", "{\"slug\":\"\"}", "[1]", "{\"slug\":"] {
    e: [1] ChCall; n = ch_gather(e[..], 0, 0, "realm_files", bad);
    #assert !ch_read(e[..]) && e[0].why.count > 0 && e[0].row == -1 && ch_path(e[..], 0, pb[..]) == "";
  }
  g: [1] ChCall;
  n = ch_gather(g[..], 0, 0, "realm_file_read", "{\"slug\":\"splice\",\"fileid\":\"XYZ\"}");
  #assert !ch_read(g[..]) && has_test(g[0].why, "16 hex digits");
  // past CH_CALLS calls, the rest are left out
  m: [2] ChCall; k := 0;
  for i: 0..<3 { k = ch_gather(m[..], k, i, "realm_list", "{}"); }
  #assert k == 2;
}
#test "an answer goes to the model with its call, its route and status, cut at its most and said so" {
  c: [1] ChCall; n := ch_gather(c[..], 0, 0, "realm_list", "{}");
  #assert ch_read(c[..]);
  out: [CH_RESULTS] u8;
  m := ch_result(out[..], 0, c[..], "/api/worlds", 200, "world splice Splice Bots\n");
  #assert cast(string) out[0..<m] == "realm_list {}: GET /api/worlds answered HTTP 200\nworld splice Splice Bots\n\n\n";
  big: [CH_RESULT + 10] u8; for i: 0..<big.count { big[i] = 'a'; }
  m2 := ch_result(out[..], m, c[..], "/api/playtest/realms/mine", 0, cast(string) big[..]);
  #assert has_test(cast(string) out[m..<m2], "answered nothing (not reached)") && has_test(cast(string) out[m..<m2], "[the rest is left out");
  #assert ch_result(out[0..<10], 0, c[..], "/api/worlds", 200, "x") == 0;
  b: [1] ChCall; n = ch_gather(b[..], 0, 0, "realm_nope", "{}");
  #assert !ch_read(b[..]);
  r := ch_refused(out[..], 0, b[..]);
  #assert cast(string) out[0..<r] == "realm_nope {}: not run: we have no such tool here\n\n";
}
has_test :: (s: string, part: string) -> bool {
  i := 0;
  while i + part.count <= s.count { if cast(string) s[i..<i + part.count] == part { return true; } i += 1; }
  return false;
}
