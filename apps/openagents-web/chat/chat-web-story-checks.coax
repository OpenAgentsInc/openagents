}

#test "14094 deterministic UiTimeline replay and dom_drive inspection" #steps 80000000 {
  // Run identical auth + SSE stream + reconnect scenario twice (one CwTest live at a time) -> 0 divergence (-1).
  tls: [2] UiTimeline;
  cnt_b: [32] u8; cnt_n := 0;
  has_step0 := false;
  for run: 0..<2 {
    h: [1] CwTest;
    s := h[0].s[..];
    ops: [1] CwcTestLog;
    #assert cwc_t_drive(s, "timeline on") == "ok";
    _ = coaxial_chatweb_frame(s, 0.016, true);
    cw_test_path(s, "/chat/cnv_44444444444444444444444444444444");
    cwc_t_drain(s, ops[..]);
    list_slot := -1;
    for k: 0..<ops[0].open_n {
      if cast(string) ops[0].opens[k].url[0..<ops[0].opens[k].url_n] == "/api/chat/v2/conversations" { list_slot = ops[0].opens[k].slot; }
    }
    lb: [256] u8;
    cwc_t_http_reply(s, list_slot, 200, cwc_t_list_json(lb[..], ""));
    cwc_t_drain(s, ops[..]);
    cslot := pl_stream_find(s[0].cc[0].rt[..], "conv.stream");
    evb: [512] u8;
    e := [1] CcEvent.[CcEvent.{conversation = "cnv_44444444444444444444444444444444", turn = "trn_55555555555555555555555555555555", sequence = 1, kind = CC_EV_TEXT_DELTA, state = CT_RUNNING, text = "Deterministic", compute = "cloud", model = "google/gemini-4-neon", source_device = "mac-desktop", created_at_ms = 3001}];
    en := cc_event_write(e[..], evb[..]);
    #assert en > 0;
    cwc_t_stream_ev(s, cslot, UI_SUB_PHASE_OPEN, 200, "");
    cwc_t_sse_push(s, cslot, "1", cast(string) evb[0..<en]);
    cwc_t_stream_ev(s, cslot, UI_SUB_PHASE_ERROR, 0, "reconnecting 500");
    cwc_t_stream_ev(s, cslot, UI_SUB_PHASE_OPEN, 200, "");
    _ = coaxial_chatweb_frame(s, 0.016, true);
    tls[run] = s[0].cc[0].timeline[0];
    if run == 0 {
      cnt_n = cwc_put(cnt_b[..], 0, cwc_t_drive(s, "timeline count"));
      has_step0 = sc_contains(cwc_t_drive(s, "timeline dump"), "step=0 ");
    }
  }
  #assert tl_replay_compare(tls[0..<1], tls[1..<2]) == -1;
  #assert cnt_n > 0 && cast(string) cnt_b[0..<cnt_n] != "0" && has_step0;
}

#test "14127 Story+Scene+Play: Tier 1 Cloud Tool Loop executes github_tree via /api/tools/cloud/v1 with Project context and renders tool cards" #steps 120000000 {
  h: [1] CwTest; s := h[0].s[..];
  ops: [1] CwcTestLog;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  // Seed account Project with GitHub repo URL + enrolled computer in SettingsWeb.
  sw_acct_projects_read(s[0].set[..], 200, "project prj_11111111111111111111111111111111|3|OpenAgents|https://github.com/OpenAgentsInc/openagents.git|1\n");
  sw_envs_read(s[0].set[..], 200, "env aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa|Mac Studio|darwin|1|1000|1|OpenAgentsInc/openagents\n");
  cw_test_path(s, "/chat?project=prj_11111111111111111111111111111111");
  cwc_t_drain(s, ops[..]);

  li := cwc_t_find_open(ops[..], "/api/chat/v2/conversations");
  lb: [256] u8;
  cwc_t_http_reply(s, ops[0].opens[li].slot, 200, cwc_t_list_json(lb[..], ""));
  cwc_t_drain(s, ops[..]);
  ops[0].open_n = 0; ops[0].close_n = 0;

  // Verify HUD displays Project repo slug and Target selector.
  t := s[0].tree[..];
  #assert sc_by_text(t, "Project · OpenAgents · OpenAgentsInc/openagents") >= 0;
  #assert sc_by_text(t, "Target: Auto") >= 0;

  // Send a prompt: request to /api/v1/inference must include Tier 1 tools + active repo in system prompt.
  cw_test_type(s, "composer", "List the root files in my repo");
  cw_test_enter(s, "composer");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);
  inf := cwc_t_find_open(ops[..], "/api/v1/inference");
  #assert inf >= 0 && ops[0].opens[inf].slot == CWC_TURN_SLOT;
  req_body := cast(string) ops[0].opens[inf].body[0..<ops[0].opens[inf].body_n];
  #assert sc_contains(req_body, "github_tree") && sc_contains(req_body, "OpenAgentsInc/openagents");
  ops[0].open_n = 0;

  // Model emits a streamed github_tree tool_call and closes cleanly.
  tc_sse := "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_gh1\",\"function\":{\"name\":\"github_tree\",\"arguments\":\"{\\\"repo\\\":\\\"OpenAgentsInc/openagents\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n";
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_OPEN, 200, "");
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_CHUNK, 200, tc_sse);
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_END, 200, "");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);

  // Web dispatches POST /api/tools/cloud/v1 and shows running tool card in transcript.
  ti := cwc_t_find_open(ops[..], "/api/tools/cloud/v1");
  #assert ti >= 0 && s[0].cc[0].tool_running;
  tbody := cast(string) ops[0].opens[ti].body[0..<ops[0].opens[ti].body_n];
  #assert sc_contains(tbody, "\"tool\":\"github_tree\"") && sc_contains(tbody, "OpenAgentsInc/openagents");
  #assert sc_by_text(t, "github_tree · running") >= 0;

  // Deliver tool output -> card turns done, continuation /api/v1/inference opens with tool result!
  tool_slot := ops[0].opens[ti].slot;
  ops[0].open_n = 0;
  cwc_t_http_reply(s, tool_slot, 200, "{\"schema\":\"openagents.cloud.tool.res.v1alpha1\",\"tool\":\"github_tree\",\"ok\":true,\"output\":\"d coax\\nf AGENTS.md\\n\"}");
  cwc_t_drain(s, ops[..]);

  inf2 := cwc_t_find_open(ops[..], "/api/v1/inference");
  #assert inf2 >= 0 && ops[0].opens[inf2].slot == CWC_TURN_SLOT && !s[0].cc[0].tool_running && s[0].cc[0].web_streaming;
  req2 := cast(string) ops[0].opens[inf2].body[0..<ops[0].opens[inf2].body_n];
  #assert sc_contains(req2, "\"role\":\"tool\"") && sc_contains(req2, "call_gh1") && sc_contains(req2, "AGENTS.md");
  #assert sc_by_text(t, "github_tree · done") >= 0;

  // Stream final answer -> turn completes cleanly.
  ans_sse := "data: {\"choices\":[{\"delta\":{\"content\":\"Root contains **coax/** and **AGENTS.md**.\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n";
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_OPEN, 200, "");
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_CHUNK, 200, ans_sse);
  cwc_t_stream_ev(s, CWC_TURN_SLOT, UI_SUB_PHASE_END, 200, "");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  #assert !s[0].cc[0].web_streaming && !s[0].cc[0].tool_running && s[0].cc[0].error_n == 0;
  #assert sc_by_text(t, "AGENTS.md") >= 0;
}

#test "14127 Story+Scene+Play: Execution Target switcher pins Tier 2 Computer submit and sends inline Approve/Deny RespondTask" #steps 120000000 {
  h: [1] CwTest; s := h[0].s[..];
  ops: [1] CwcTestLog;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  sw_envs_read(s[0].set[..], 200, "env aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa|Mac Studio|darwin|1|1000|1|OpenAgentsInc/openagents\n");
  cw_test_path(s, "/chat");
  cwc_t_drain(s, ops[..]);

  li := cwc_t_find_open(ops[..], "/api/chat/v2/conversations");
  lb: [256] u8;
  cwc_t_http_reply(s, ops[0].opens[li].slot, 200, cwc_t_list_json(lb[..], ""));
  cwc_t_drain(s, ops[..]);
  ops[0].open_n = 0;

  // Open Target menu and pick enrolled computer "Mac Studio".
  cw_test_press(s, "cc.target");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_find(t, "cc.tgt.env.0") >= 0 && tr_find(t, "cc.tgt.cloud") >= 0 && tr_find(t, "cc.tgt.sandbox") >= 0;
  cw_test_press(s, "cc.tgt.env.0");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  #assert s[0].cc[0].target_kind == CLD_TARGET_COMPUTER && sc_by_text(t, "Target: Mac Studio") >= 0;

  // Sending a message dispatches to POST /api/chat/submit/v2alpha1?host=<64hex>.
  cw_test_type(s, "composer", "Run coax test locally");
  cw_test_enter(s, "composer");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);
  sub := cwc_t_find_open(ops[..], "/api/chat/submit/v2alpha1?host=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  #assert sub >= 0 && s[0].cc[0].remote_running;
  sbody := cast(string) ops[0].opens[sub].body[0..<ops[0].opens[sub].body_n];
  #assert sc_contains(sbody, "Run coax test locally");

  // Deliver 202 response with conversation_id & turn_id -> subscribes to live conversation stream.
  sub_slot := ops[0].opens[sub].slot;
  ops[0].open_n = 0;
  cwc_t_http_reply(s, sub_slot, 202, "{\"conversation_id\":\"cnv_77777777777777777777777777777777\",\"turn_id\":\"trn_88888888888888888888888888888888\",\"revision\":1}");
  cwc_t_drain(s, ops[..]);
  #assert cwc_active_id(s[0].cc[..]) == "cnv_77777777777777777777777777777777";

  // Simulate a pending approval event from the computer -> Approve / Deny buttons render and send RespondTask!
  aev := CcEvent.{
    conversation = "cnv_77777777777777777777777777777777",
    turn = "trn_88888888888888888888888888888888",
    sequence = 2,
    kind = CC_EV_APPROVAL,
    tool_id = "int_shell_1",
    tool_name = "bash",
    tool_args = "{\"cmd\":\"coax test\"}",
    approval_status = "pending",
    compute = "local",
    source_device = "Mac Studio"
  };
  cwc_apply_event(s[0].cc[..], aev, true);
  s[0].cc[0].dirty = true;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  #assert tr_find(t, "cc.appr.ok.2") >= 0 && tr_find(t, "cc.appr.no.2") >= 0;

  ops[0].open_n = 0;
  cw_test_press(s, "cc.appr.ok.2");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);
  ap := cwc_t_find_open(ops[..], "/api/chat/task/v1alpha1?host=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  #assert ap >= 0;
  abody := cast(string) ops[0].opens[ap].body[0..<ops[0].opens[ap].body_n];
  #assert sc_contains(abody, "\"method\":\"RespondTask\"") && sc_contains(abody, "\"allow\":true") && sc_contains(abody, "\"interaction_id\":\"int_shell_1\"");
}

#test "14128 Story+Scene+Play: Cloud Sandbox target submits durable sandbox turn and renders sandbox tool events" #steps 120000000 {
  h: [1] CwTest; s := h[0].s[..];
  ops: [1] CwcTestLog;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cw_test_path(s, "/chat");
  cwc_t_drain(s, ops[..]);

  li := cwc_t_find_open(ops[..], "/api/chat/v2/conversations");
  lb: [256] u8;
  cwc_t_http_reply(s, ops[0].opens[li].slot, 200, cwc_t_list_json(lb[..], ""));
  cwc_t_drain(s, ops[..]);
  ops[0].open_n = 0;

  // Select Cloud Sandbox from Target menu.
  cw_test_press(s, "cc.target");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cw_test_press(s, "cc.tgt.sandbox");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert s[0].cc[0].target_kind == CLD_TARGET_SANDBOX && sc_by_text(t, "Target: Sandbox") >= 0;

  // Sending a prompt dispatches to POST /api/chat/submit/v2alpha1?target=sandbox&size=small.
  cw_test_type(s, "composer", "Run coax test in cloud sandbox");
  cw_test_enter(s, "composer");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);
  sub := cwc_t_find_open(ops[..], "/api/chat/submit/v2alpha1?target=sandbox&size=small");
  #assert sub >= 0 && s[0].cc[0].remote_running;
  #assert cast(string) s[0].cc[0].active_compute[0..<s[0].cc[0].active_compute_n] == "sandbox";

  // 202 reply -> live sandbox tool call, result, text, and completion render cleanly.
  sub_slot := ops[0].opens[sub].slot;
  ops[0].open_n = 0;
  cwc_t_http_reply(s, sub_slot, 202, "{\"conversation_id\":\"cnv_99999999999999999999999999999999\",\"turn_id\":\"trn_99999999999999999999999999999999\",\"revision\":1}");
  cwc_t_drain(s, ops[..]);

  cwc_apply_event(s[0].cc[..], CcEvent.{
    conversation = "cnv_99999999999999999999999999999999", turn = "trn_99999999999999999999999999999999",
    sequence = 2, kind = CC_EV_TOOL_CALL, tool_id = "sb_1", tool_name = "bash", tool_args = "coax test",
    compute = "sandbox", source_device = "bx_fwh3xnws"
  }, true);
  cwc_apply_event(s[0].cc[..], CcEvent.{
    conversation = "cnv_99999999999999999999999999999999", turn = "trn_99999999999999999999999999999999",
    sequence = 3, kind = CC_EV_TEXT_DELTA, text = "All checks passed in cloud sandbox.",
    compute = "sandbox", source_device = "bx_fwh3xnws"
  }, true);
  cwc_apply_event(s[0].cc[..], CcEvent.{
    conversation = "cnv_99999999999999999999999999999999", turn = "trn_99999999999999999999999999999999",
    sequence = 4, kind = CC_EV_COMPLETED, state = CT_COMPLETED,
    compute = "sandbox", model = "google/gemini-4-neon", source_device = "bx_fwh3xnws"
  }, true);
  s[0].cc[0].dirty = true;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  #assert !s[0].cc[0].remote_running && sc_by_text(t, "Sandbox · google/gemini-4-neon") >= 0;
  #assert sc_by_text(t, "All checks passed in cloud sandbox.") >= 0;
}

#test "14129 Story+Scene+Play: HUD and Settings show sandbox+inference spend, Auto routes code turn to $0 online computer, and 402 surfaces credit prompt" #steps 120000000 {
  h: [1] CwTest; s := h[0].s[..];
  ops: [1] CwcTestLog;
  _ = coaxial_chatweb_frame(s, 0.016, true);
  sw_envs_read(s[0].set[..], 200, "env cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc|MacBook Pro M4|darwin|1|1000|1|OpenAgentsInc/openagents\n");
  cw_test_path(s, "/chat");
  cwc_t_drain(s, ops[..]);

  li := cwc_t_find_open(ops[..], "/api/chat/v2/conversations");
  lb: [256] u8;
  cwc_t_http_reply(s, ops[0].opens[li].slot, 200, cwc_t_list_json(lb[..], ""));
  ui := cwc_t_find_open(ops[..], "/api/v1/inference/usage");
  if ui >= 0 {
    cwc_t_http_reply(s, ops[0].opens[ui].slot, 200, "{\"credit_msat\":43750,\"today\":{\"requests\":3,\"usd_micros\":1200},\"total\":{\"calls\":3,\"in_tokens\":500,\"cached_in_tokens\":0,\"out_tokens\":200,\"usd_micros\":1200},\"decisions\":{\"calls\":1},\"sandbox\":{\"turns\":2,\"seconds\":900,\"msat\":6000},\"local\":{\"turns\":4,\"msat\":0}}");
  }
  cwc_t_drain(s, ops[..]);
  _ = coaxial_chatweb_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert sc_by_text(t, "Sandbox 900s (6 sats)") >= 0 && sc_by_text(t, "43 sats") >= 0;

  // In Auto mode, a code-execution prompt automatically routes to the online enrolled computer ($0 local)!
  ops[0].open_n = 0;
  #assert s[0].cc[0].target_kind == CLD_TARGET_AUTO;
  cw_test_type(s, "composer", "Run coax test now");
  cw_test_enter(s, "composer");
  _ = coaxial_chatweb_frame(s, 0.016, true);
  cwc_t_drain(s, ops[..]);
  sub := cwc_t_find_open(ops[..], "/api/chat/submit/v2alpha1?host=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");
  #assert sub >= 0 && s[0].cc[0].remote_running;
  #assert cast(string) s[0].cc[0].active_compute[0..<s[0].cc[0].active_compute_n] == "local";

  // Simulate 402 unpaid error on durable submit -> actionable credit banner appears.
  cwc_t_http_reply(s, ops[0].opens[sub].slot, 402, "{\"error\":\"Insufficient sats credit for Cloud Sandbox.\"}");
  cwc_t_drain(s, ops[..]);
  _ = coaxial_chatweb_frame(s, 0.016, true);
  #assert !s[0].cc[0].remote_running && sc_by_text(t, "Insufficient sats credit for Cloud Sandbox.") >= 0;
}
