// The class kits (#13025, #13058): a Character Create class's hotbar at a level, how each of its
// abilities aims (the way you face, nothing picked for you), and how each sounds. Everglade
// Experimental plays them against its monsters (experimental-combat.coax), Everglade II through its
// room (everglade2-cast.coax), and the room takes Everglade II's casts by them
// (coax/web/room/room-everglade.coax eg_e2_cast). Nothing here rolls or draws: the SRD 5e engine
// (aethyr/rules/srd/, through fivebar.coax) says what each ability is.
//
// On the wire (everglade-wire.coax C and e cast) slot i of class c's bar is XK_SLOT0 + c * XK_PER +
// i, the bar in its own order (xc_bar_level), never the order a page has arranged it in.
//   coax/bin/coax test apps/openagents-web/class-kit.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "../../aethyr/rules/srd/battle.coax";
#load "../../aethyr/action/area-aim.coax" as aa;   // the areas abilities open, placed, outlined and resolved (#13081)
#load "fivebar.coax";
#load "../../aethyr/rules/srd/death-save-line.coax";   // at 0 Hit Points: the Death Saving Throws on a row and the plain line, every realm

XC_SLOTS :: 24;
XC_COOL :: 1.0;                // seconds between presses
XC_DEFAULT :: 11;              // FB_CL_WIZARD
XC_CL_UP :: [12] string.["BARBARIAN", "BARD", "CLERIC", "DRUID", "FIGHTER", "MONK", "PALADIN", "RANGER", "ROGUE", "SORCERER", "WARLOCK", "WIZARD"];
XC_EG_URL :: "/worlds/everglade/hotbar/";
XC_MMO_URL :: "/worlds/5e-mmo/hotbar/";
xc_attack :: () -> FbAb { return fb_feature(FB_ATTACK, "Attack", "attack"); }

// Class c's level 1 bar, in slot order: slot 1 its Character Create ability, then its cantrips,
// 1st-level spells and features. Bardic Inspiration is left off: it is given to an ally, and
// Experimental has none.
xc_bar :: (c: int, out: [] FbAb) -> int {
  out[0] = fb_cl_ability(c);
  n := 1;
  if c == FB_CL_BARBARIAN { out[1] = xc_attack(); n = 2; }
  else if c == FB_CL_BARD { out[1] = fb_spell(SP_HEALING_WORD, 1, FB_ALLY); out[2] = fb_spell(SP_THUNDERWAVE, 1, FB_POINT); n = 3; }
  else if c == FB_CL_CLERIC { out[1] = fb_spell(SP_GUIDING_BOLT, 1, FB_FOE); out[2] = fb_spell(SP_HEALING_WORD, 1, FB_ALLY); out[3] = xc_attack(); n = 4; }
  else if c == FB_CL_DRUID {
    out[1] = fb_art_spell(SP_FLAME_HURL, FB_FOE, "produce-flame"); out[1].conjure = true;
    out[2] = fb_spell(SP_THUNDERWAVE, 1, FB_POINT); out[3] = fb_spell(SP_ENTANGLE, 1, FB_POINT); out[4] = fb_spell(SP_HEALING_WORD, 1, FB_ALLY); n = 5;
  }
  else if c == FB_CL_FIGHTER { out[1] = xc_attack(); n = 2; }
  else if c == FB_CL_PALADIN { out[1] = xc_attack(); out[2] = fb_spell(SP_DIVINE_SMITE, 1, FB_FOE); n = 3; }
  else if c == FB_CL_RANGER { out[1] = xc_attack(); out[2] = fb_spell(SP_ENTANGLE, 1, FB_POINT); n = 3; }
  else if c == FB_CL_SORCERER {
    out[1] = fb_spell(SP_CHILL_TOUCH, 0, FB_FOE); out[2] = fb_spell(SP_RAY_OF_SICKNESS, 1, FB_FOE); out[3] = fb_spell(SP_THUNDERWAVE, 1, FB_POINT);
    out[4] = fb_feature(FB_INNATE, "Innate Sorcery", "innate-sorcery"); out[4].tg = FB_SELF; n = 5;
  }
  else if c == FB_CL_WARLOCK { out[1] = fb_spell(SP_CHILL_TOUCH, 0, FB_FOE); out[2] = fb_spell(SP_HEX, 1, FB_FOE); n = 3; }
  else if c == FB_CL_WIZARD {
    out[1] = fb_spell(SP_CHILL_TOUCH, 0, FB_FOE); out[2] = fb_spell(SP_RAY_OF_SICKNESS, 1, FB_FOE); out[3] = fb_spell(SP_FALSE_LIFE, 1, FB_SELF);
    out[4] = fb_spell(SP_THUNDERWAVE, 1, FB_POINT); n = 5;
  }
  return n;
}
// Add the shared level-six kit as its prerequisites become available. Preserve the
// experimental level-one choices and the Character Create icon in the first slot.
xc_bar_level :: (klass: int, level: int, out: [] FbAb) -> int {
  n := xc_bar(klass, out);
  hero := fb_cl_hero(klass, "You", 0, level);
  extra: [FB_CLASS_SLOTS] FbAb;
  count := fb_class_bar(FB_CL_ENGINE[klass], extra[..]);
  for i: 0..<count {
    a := extra[i];
    if a.kind == FB_INSPIRE { continue; } // requires an ally, which this scene lacks
    if a.kind == FB_SPELL && a.lvl > 0 {
      available := false;
      for slot: a.lvl..<10 { if hero.slots_max[slot] > 0 { available = true; } }
      if !available && hero.free_spell != a.sp { continue; }
      if klass == FB_CL_BARD && a.sp == SP_FIREBALL && level < 6 { continue; }
    }
    if a.kind == FB_RECKLESS && level < 2 { continue; }
    if (a.kind == FB_FLURRY || a.kind == FB_PATIENT || a.kind == FB_WIND) && hero.focus_max == 0 { continue; }
    if a.kind == FB_WHOLE && hero.uses_max[RS_USE_WHOLE] == 0 { continue; }
    if a.kind == FB_SURGE && hero.uses_max[RS_USE_SURGE] == 0 { continue; }
    if a.kind == FB_AIM && !hero.steady_aim { continue; }
    if a.kind == FB_CDASH && level < 2 { continue; }
    if a.kind == FB_SACRED && level < 3 { continue; }
    if a.kind == FB_TURN && !hero.turn_undead { continue; }
    if a.kind == FB_PRESERVE && !hero.preserve_life { continue; }
    if a.kind == FB_LANDS && !hero.lands_aid { continue; }
    // the Paladin's Sacred Flame is Blessed Warrior's, its Fighting Style from level 2 (p. 54)
    if klass == FB_CL_PALADIN && a.kind == FB_SPELL && a.sp == SP_SACRED_FLAME && level < 2 { continue; }
    // Produce Flame is already represented by the combined conjure-and-hurl slot.
    if klass == FB_CL_DRUID && a.kind == FB_SPELL && a.sp == SP_PRODUCE_FLAME { continue; }
    duplicate := false;
    for j: 0..<n { if out[j].kind == a.kind && (a.kind != FB_SPELL || out[j].sp == a.sp) { duplicate = true; } }
    if !duplicate && n < out.count { out[n] = a; n += 1; }
  }
  // Wild Shape from level 2 (p. 42), with an Attack for the Beast's own Action
  if klass == FB_CL_DRUID && hero.uses_max[RS_USE_WILD] > 0 && n + 2 <= out.count {
    out[n] = fb_feature(FB_WILD, "Wild Shape", "wild-shape"); out[n].tg = FB_SELF; out[n + 1] = xc_attack(); n += 2;
  }
  if n<out.count && rs_class_spell_granted(hero,SP_AID) {
    out[n]=fb_art_spell(SP_AID,FB_ALLY,"healing-word"); n+=1;
  }
  if n<out.count && rs_class_spell_granted(hero,SP_GUIDANCE) {
    out[n]=fb_art_spell(SP_GUIDANCE,FB_SELF,"healing-word"); n+=1;
  }
  if n<out.count && rs_class_spell_granted(hero,SP_PROTECTION_GOOD_EVIL) {
    out[n]=fb_art_spell(SP_PROTECTION_GOOD_EVIL,FB_SELF,"shield"); n+=1;
  }
  if n<out.count && rs_class_spell_granted(hero,SP_REVIVIFY) {
    out[n]=fb_art_spell(SP_REVIVIFY,FB_ALLY,"healing-word"); n+=1;
  }
  if n<out.count && rs_class_spell_granted(hero,SP_ZONE_OF_TRUTH) {
    out[n]=fb_art_spell(SP_ZONE_OF_TRUTH,FB_POINT,"hypnotic-pattern"); n+=1;
  }
  // The preset's selected spells, not slot availability alone, determine the
  // playable bar. Stable ability identities preserve saved ordering/sounds.
  selected := 0;
  for i: 0..<n {
    if out[i].kind == FB_SPELL && !rs_spell_ready(hero, out[i].sp) { continue; }
    out[selected] = out[i]; selected += 1;
  }
  return selected;
}
// A stable identity for a class ability, independent of its icon and position.
xc_id :: (a: FbAb) -> int { return a.kind * 10000 + a.sp + 1; }
// Character Create's images have a baked-in 1. When moved, use the corresponding
// unnumbered combat icon so the key label always belongs to the position.
xc_art :: (a: FbAb, slot: int) -> string {
  if slot == 0 || xc_url(a.art) != XC_EG_URL { return a.art; }
  if a.kind == FB_SPELL { return rs_spell(a.sp).id; }
  if a.kind == FB_ATTACK { return "attack"; }
  if a.kind == FB_RAGE { return "rage"; }
  if a.kind == FB_SECOND { return "second-wind"; }
  if a.kind == FB_LAY { return "lay-on-hands"; }
  return a.art;
}
// A slot's picture: the class's own (cl-*) are Everglade's, the rest 5E MMO's.
// Everglade also has a few spells' own pictures that 5E MMO lacks (the druid's grove uses them).
XC_EG_ONLY :: [3] string.["shapechange", "fire-storm", "gust-of-wind"];
xc_url :: (art: string) -> string {
  if art.count > 3 && art[0] == 'c' && art[1] == 'l' && art[2] == '-' { return XC_EG_URL; }
  for e: XC_EG_ONLY { if art == e { return XC_EG_URL; } }
  return XC_MMO_URL;
}
// Character Create class icons already have their slot 1 key baked into the art.
xc_draw_slot_key :: (slot:int,art:string)->bool {return slot!=0 || xc_url(art)!=XC_EG_URL;}
// ---- aim: everything goes the way you face (#13025 owner feedback). Nothing picks a target for you.
// - a bolt or ray (a ranged spell attack, or a ranged weapon's Attack) flies straight ahead to its SRD
//   range and strikes the first monster whose body its line crosses, with about 5 degrees of help; if
//   none, it flies on and fizzles at its range.
// - a blow (a melee Attack, Sneak Attack, a touch spell) strikes the nearest monster within reach in a
//   90 degree arc ahead, or swings at the air.
// - a single-target spell with no projectile (a saving throw: Sacred Flame, Vicious Mockery, Hex) takes
//   the nearest monster in range in a 30 degree cone ahead, or nothing: its icon fizzles, no words.
// - yourself and areas (Second Wind, Rage, Thunderwave's cube, Entangle's square) work from where you
//   stand, the area set the way you face (Entangle's square on the first monster in that cone, or 6 m on).
XC_AIM_SELF :: 0; XC_AIM_BOLT :: 1; XC_AIM_MELEE :: 2; XC_AIM_CONE :: 3; XC_AIM_AREA :: 4;
XC_BODY :: 0.55;        // m: a monster's body, as a bolt's line meets it
XC_ASSIST :: 0.0875;    // tan 5 degrees: a bolt's aim help
XC_REACH :: 2.3;        // m: 5 feet of reach from your middle to a monster's
XcAim :: struct { kind: int; foe: int = -1; reach: f32; fx: f32; fz: f32; }
XC_FT :: 0.3048;
// What kind of aim ability a takes, and its reach in metres, for a hero holding weapon `weapon`
// (rs_weapon: a ranged one makes Attack a bolt).
xc_aim_for :: (a: FbAb, weapon: int) -> XcAim {
  if a.tg == FB_SELF || a.tg == FB_ALLY { return XcAim.{kind = XC_AIM_SELF}; }
  // Search looks round you; Study and Influence take the monster ahead within 30 feet (p.176)
  if a.kind == FB_SKILL { return ifx a.opt <= 0 then XcAim.{kind = XC_AIM_SELF} else XcAim.{kind = XC_AIM_CONE, reach = 30 * f32(XC_FT)}; }
  if a.kind == FB_SPELL {
    sp := rs_spell(a.sp);
    if sp.area != RS_A_NONE { return XcAim.{kind = XC_AIM_AREA, reach = f32(sp.range_ft) * f32(XC_FT)}; }
    if sp.range_ft <= 5 { return XcAim.{kind = XC_AIM_MELEE, reach = f32(XC_REACH)}; }
    ranged := false;
    for q: 0..<sp.step_n { if sp.steps[q].kind == RS_S_ATTACK && sp.steps[q].a == 0 { ranged = true; } }
    return XcAim.{kind = ifx ranged then XC_AIM_BOLT else XC_AIM_CONE, reach = f32(sp.range_ft) * f32(XC_FT)};
  }
  if a.kind == FB_FLURRY || a.kind == FB_RECKLESS { return XcAim.{kind = XC_AIM_MELEE, reach = f32(XC_REACH)}; }
  if a.kind == FB_GRAPPLE || a.kind == FB_SHOVE { return XcAim.{kind = XC_AIM_CONE, reach = f32(XC_REACH)}; }   // no weapon swing
  if a.kind == FB_LANDS { return XcAim.{kind = XC_AIM_AREA, reach = 9}; }
  if a.kind == FB_ATTACK {
    w := rs_weapon(weapon);
    if w.range_ft > 5 { return XcAim.{kind = XC_AIM_BOLT, reach = f32(w.range_ft) * f32(XC_FT)}; }
    return XcAim.{kind = XC_AIM_MELEE, reach = f32(XC_REACH)};
  }
  return XcAim.{kind = XC_AIM_SELF};
}
// Where an ability aimed from (px, pz), facing (fx, fz), with nothing in its way lands: a bolt at its
// range, a blow at its reach, a spell on someone at its range, an area at its middle (a cube from you
// at its far side's middle, a placed one 6 m on at most), yourself where you stand.
xc_aim_point :: (a: FbAb, m: XcAim, px: f32, pz: f32, fx: f32, fz: f32) -> [2] f32 {
  d := m.reach;
  if m.kind == XC_AIM_SELF { d = 0; }
  else if m.kind == XC_AIM_AREA {
    sp := rs_spell(a.sp);
    d = ifx a.kind == FB_SPELL && sp.area == RS_A_CUBE_SELF then f32(sp.area_ft) * f32(XC_FT) else ifx m.reach < 6 then m.reach else 6.0f32;
  }
  return [2] f32.[px + fx * d, pz + fz * d];
}
// The area spell sp opens, in metres on the ground at (0, 0) facing +z, from its SRD area of effect
// (aethyr/action/area-aim.coax; not on when it has none): a Sphere is a circle of its radius, a Square
// or a Cube on a point a square of its side, a Line from you a line of its length and width, and a Cube
// from you the box of the squares rs_area gives it ahead of you, half a square past each edge for the
// world's nearest-square mapping (Thunderwave's 15-foot cube: 3 squares across, from your own square on).
xk_spell_area :: (sp: int) -> aa.AreaAim {
  s := rs_spell(sp); ft := f32(XC_FT); sq := f32(RS_SQUARE) * ft;
  if s.area == RS_A_SPHERE { return aa.area_circle(0, 0, f32(s.area_ft) * ft); }
  if s.area == RS_A_SQUARE || s.area == RS_A_CUBE { return aa.area_square(0, 0, f32(s.area_ft) * ft * 0.5); }
  if s.area == RS_A_LINE { return aa.area_line(0, 0, 0, 1, f32(s.area_ft) * ft, f32(rs_max(s.wide_ft, RS_SQUARE)) * ft * 0.5); }
  if s.area == RS_A_CUBE_SELF {
    // rs_area facing +y: x0 = -k/2, x1 = x0 + k - 1 across; 0 to k ahead
    k := rs_max(s.area_ft / RS_SQUARE, 1); x0 := -(k / 2); x1 := x0 + k - 1;
    return aa.area_box(0, 0, 0, 1, (f32(x0) - 0.5) * sq, (f32(x1) + 0.5) * sq, -0.5 * sq, (f32(k) + 0.5) * sq);
  }
  return aa.AreaAim.{};
}
// The area ability a opens (Land's Aid: a 10-foot circle), as xk_spell_area.
xk_area :: (a: FbAb) -> aa.AreaAim {
  if a.kind == FB_LANDS { return aa.area_circle(0, 0, 10 * f32(XC_FT)); }
  if a.kind != FB_SPELL { return aa.AreaAim.{}; }
  return xk_spell_area(a.sp);
}
// Whether ability a's area is placed on the ground (armed, then cast where it lies) rather than opened
// from you the way you face.
xk_area_placed :: (a: FbAb) -> bool { r := xk_area(a); return r.on && !aa.area_from_caster(r); }
// Ability a's placed area armed for `slot`, held to `range` metres (aethyr/action/area-aim.coax).
xk_area_arm :: (a: FbAb, slot: int, range: f32, t: f32) -> aa.AreaAim {
  r := xk_area(a); r.slot = slot; r.range = range; r.armed_at = t;
  return r;
}
// A battle's lasting area (rs_area's RsZone) on its grid, in squares (x across, y as z), for a board
// that draws it from above: a Line as its line, a round one as a circle round the squares it holds, any
// other the rectangle of its squares.
xk_zone_area :: (z: RsZone) -> aa.AreaAim {
  if z.line { return aa.area_line(f32(z.cx) + 0.5, f32(z.cy) + 0.5, z.dx, z.dy, f32(z.r_ft) / f32(RS_SQUARE), ifx z.half > 0 then z.half else 0.5f32); }
  if z.round { return aa.area_circle(f32(z.cx) + 0.5, f32(z.cy) + 0.5, f32(z.r_ft) / f32(RS_SQUARE) + 0.5); }
  return aa.area_box(f32(z.x0), f32(z.y0), 0, 1, 0, f32(z.x1 + 1 - z.x0), 0, f32(z.y1 + 1 - z.y0));
}
#test "abilities open the SRD's areas: Entangle a 20-foot square, Thunderwave a 15-foot cube from you" {
  en := xk_spell_area(SP_ENTANGLE); #assert en.on && en.shape == aa.AREA_SQUARE && abs(en.half - 10 * f32(XC_FT)) < 0.001;
  tw := xk_spell_area(SP_THUNDERWAVE); #assert tw.on && tw.shape == aa.AREA_BOX && aa.area_from_caster(tw);
  #assert abs(tw.side0 + 1.5 * 1.524) < 0.001 && abs(tw.side1 - 1.5 * 1.524) < 0.001 && abs(tw.fore0 + 0.5 * 1.524) < 0.001 && abs(tw.fore1 - 3.5 * 1.524) < 0.001;
  #assert !xk_spell_area(SP_CURE_WOUNDS).on;
  // a battle's square on its grid: the squares it holds, and only those
  zb: RsZone; zb.on = true; zb.x0 = 2; zb.y0 = 3; zb.x1 = 5; zb.y1 = 6;
  za := xk_zone_area(zb);
  for y: 0..<10 { for x: 0..<10 { #assert aa.area_aim_contains(za, f32(x) + 0.5, f32(y) + 0.5) == rs_inside(zb, x, y); } }
}
// The weapon a class holds (charactercreator.coax CC_KITS), as close to its SRD starting weapon as the
// Ultimate RPG kit has: the Barbarian's greataxe, the Fighter's greatsword, the Paladin's longsword, the Rogue's
// shortsword and the Ranger's longbow (SRD 5.2.1 p.58: a Longbow and a quiver; docs/verse/bow-combat.md). The Monk fights unarmed and the casters hold none: -1.
XC_KIT_BOW :: 4;   // charactercreator.coax CC_KITS: the longbow, in the left hand
xc_kit :: (c: int) -> int {
  if c == FB_CL_BARBARIAN { return 0; }
  if c == FB_CL_FIGHTER { return 1; }
  if c == FB_CL_PALADIN { return 2; }
  if c == FB_CL_ROGUE { return 3; }
  if c == FB_CL_RANGER { return XC_KIT_BOW; }
  return -1;
}
// ---- sound: every ability its own (experimental-sound.coax plays them, varied each time)
// start: as you use it (a blow's whoosh as the swing starts); layer: under the cast; hit: where it
// lands on a monster; miss: where a spell meets no one or a monster dodges it. Names are Everglade's
// bank (aethyr/audio/everglade-sfx.txt) or Experimental's own (aethyr/audio/experimental-sfx.coax).
XcSnd :: struct { start: string; layer: string; hit: string; miss: string; rate: f32 = 1; }
xs :: (start: string, layer: string, hit: string, miss: string, rate: f32) -> XcSnd {
  return XcSnd.{start = start, layer = layer, hit = hit, miss = miss, rate = rate};
}
// The kind of damage a spell's first damage roll deals, RS_DMG_NONE when it rolls none.
xc_damage_type :: (sp: int) -> int {
  r := rs_spell(sp);
  for q: 0..<r.step_n { if r.steps[q].kind == RS_S_DAMAGE { return r.steps[q].c; } }
  return RS_DMG_NONE;
}
// A spell's sound: its own when it has one, else its damage type's, else its school's.
xc_spell_sound :: (sp: int) -> XcSnd {
  if sp == SP_FIRE_BOLT { return xs("fire-cast", "fire-travel", "fire-hit", "fizzle", 1); }
  if sp == SP_FLAME_HURL || sp == SP_PRODUCE_FLAME { return xs("fire-cast", "", "fire-hit", "fizzle", 1.12); }
  if sp == SP_SCORCHING_RAY { return xs("cone", "fire-travel", "fire-hit", "fizzle", 1.1); }
  if sp == SP_FIREBALL { return xs("fire-travel", "fire-cast", "fireball", "fizzle", 0.9); }
  if sp == SP_BURNING_HANDS { return xs("cone", "", "fire-hit", "fizzle", 1); }
  if sp == SP_RAY_OF_FROST { return xs("frost-cast", "frost-travel", "frost-hit", "fizzle", 1); }
  if sp == SP_ICE_KNIFE { return xs("frost-travel", "", "ice", "fizzle", 1.1); }
  if sp == SP_ELDRITCH_BLAST { return xs("eldritch-cast", "eldritch-travel", "eldritch-hit", "fizzle", 0.82); }
  if sp == SP_CHILL_TOUCH { return xs("necro-cast", "", "necro-hit", "fizzle", 1); }
  if sp == SP_RAY_OF_SICKNESS { return xs("blight", "necro-travel", "necro-hit", "fizzle", 1.15); }
  if sp == SP_FALSE_LIFE { return xs("shield", "necro-cast", "", "", 0.8); }
  if sp == SP_BLINDNESS { return xs("hex", "necro-travel", "necro-hit", "fizzle", 0.8); }
  if sp == SP_HEX { return xs("hex", "", "", "fizzle", 1); }
  if sp == SP_HUNTERS_MARK { return xs("hex", "", "", "fizzle", 1.25); }
  if sp == SP_HOLD_PERSON { return xs("hold", "", "", "fizzle", 1); }
  if sp == SP_HYPNOTIC_PATTERN { return xs("levitate", "hold", "", "", 1.15); }
  if sp == SP_VICIOUS_MOCKERY { return xs("psychic-cast", "", "psychic-hit", "fizzle", 1); }
  if sp == SP_SACRED_FLAME { return xs("choir", "", "radiant", "fizzle", 1); }
  if sp == SP_GUIDING_BOLT { return xs("radiant", "missile", "arcane-hit", "fizzle", 1); }
  if sp == SP_SPIRIT_GUARDIANS { return xs("levitate", "choir", "radiant", "", 0.85); }
  if sp == SP_DIVINE_SMITE { return xs("radiant", "", "hit-heavy", "", 0.9); }
  if sp == SP_STARRY_WISP { return xs("arcane-cast", "missile", "arcane-hit", "fizzle", 1); }
  if sp == SP_HEALING_WORD || sp == SP_CURE_WOUNDS { return xs("heal", "", "", "", 1); }
  if sp == SP_LESSER_RESTORATION { return xs("shield", "heal", "", "", 1.05); }
  if sp == SP_AID { return xs("arcane-cast", "heal", "", "", 0.95); }
  if sp == SP_GUIDANCE { return xs("levitate", "choir", "", "", 1.05); }
  if sp == SP_PROTECTION_GOOD_EVIL { return xs("hold", "choir", "", "", 1); }
  if sp == SP_REVIVIFY { return xs("necro-cast", "heal", "", "", 0.9); }
  if sp == SP_ZONE_OF_TRUTH { return xs("entangle", "choir", "", "", 0.92); }
  if sp == SP_THUNDERWAVE { return xs("thunderwave", "thunder", "hit-heavy", "", 1); }
  if sp == SP_ENTANGLE { return xs("entangle", "", "", "", 1); }
  if sp == SP_CALL_LIGHTNING { return xs("bolt-cast", "thunder", "bolt-travel", "fizzle", 1); }
  if sp == SP_LIGHTNING_BOLT { return xs("bolt-travel", "bolt-cast", "thunder", "fizzle", 1); }
  if sp == SP_SHIELD || sp == SP_SHIELD_OF_FAITH { return xs("shield", "", "", "", 1); }
  if sp == SP_BLESS { return xs("choir", "", "", "", 1.2); }
  if sp == SP_MOONBEAM { return xs("radiant", "levitate", "radiant", "", 0.7); }
  t := xc_damage_type(sp);
  if t == RS_FIRE { return xs("fire-cast", "", "fire-hit", "fizzle", 1); }
  if t == RS_COLD { return xs("frost-cast", "", "frost-hit", "fizzle", 1); }
  if t == RS_LIGHTNING { return xs("bolt-cast", "", "bolt-travel", "fizzle", 1); }
  if t == RS_THUNDER { return xs("thunderwave", "", "thunder", "", 1); }
  if t == RS_NECROTIC { return xs("necro-cast", "", "necro-hit", "fizzle", 1); }
  if t == RS_RADIANT { return xs("radiant", "", "radiant", "fizzle", 1); }
  if t == RS_PSYCHIC { return xs("psychic-cast", "", "psychic-hit", "fizzle", 1); }
  if t == RS_FORCE { return xs("eldritch-cast", "", "eldritch-hit", "fizzle", 1.1); }
  if t == RS_ACID || t == RS_POISON { return xs("blight", "", "necro-hit", "fizzle", 1.2); }
  sc := rs_spell(sp).school;
  if sc == "Abjuration" { return xs("shield", "", "", "", 1); }
  if sc == "Conjuration" { return xs("teleport", "", "", "", 1); }
  if sc == "Enchantment" { return xs("hold", "", "", "fizzle", 1); }
  if sc == "Illusion" || sc == "Transmutation" { return xs("levitate", "", "", "", 1); }
  if sc == "Necromancy" { return xs("necro-cast", "", "necro-hit", "fizzle", 1); }
  return xs("arcane-cast", "", "arcane-hit", "fizzle", 1);
}
// Ability a's sound for class klass (whose weapon its blows use).
xc_sound :: (a: FbAb, klass: int) -> XcSnd {
  if a.kind == FB_SPELL { return xc_spell_sound(a.sp); }
  kit := xc_kit(klass); heavy := kit == 0 || kit == 1;
  if a.kind == FB_ATTACK {
    if a.name == "Sneak Attack" { return xs("swing", "necro-travel", "hit-heavy", "", 1.15); }
    if a.name == "Martial Arts" || kit < 0 { return xs("swing", "", "hit", "", 1.3); }   // a fist, or a caster's staff
    if heavy { return xs("swing-heavy", "", "hit-heavy", "", ifx kit == 0 then 0.88 else 1.0); }   // the greataxe is the heavier
    return xs("swing", "", "hit", "", ifx kit == 3 then 1.1 else 1.0);
  }
  if a.kind == FB_SHOOT { return xs("", "", "arrow-flesh", "arrow-whiz", 1); }   // its release is played as it is loosed
  if a.kind == FB_RECKLESS { return xs("grunt", "swing-heavy", "hit-heavy", "", 0.9); }
  if a.kind == FB_RAGE { return xs("rage-roar", "", "", "", 1); }
  if a.kind == FB_FLURRY { return xs("flurry", "", "hit", "", 1); }
  if a.kind == FB_PATIENT { return xs("hold", "", "", "", 0.8); }
  if a.kind == FB_WIND { return xs("levitate", "dash", "", "", 1.1); }
  if a.kind == FB_WHOLE { return xs("heal", "", "", "", 0.85); }
  if a.kind == FB_SECOND { return xs("second-wind", "", "", "", 1); }
  if a.kind == FB_SURGE { return xs("surge", "", "", "", 1); }
  if a.kind == FB_LAY { return xs("heal", "choir", "", "", 0.9); }
  if a.kind == FB_SACRED { return xs("shield", "choir", "", "", 1); }
  if a.kind == FB_INNATE { return xs("arcane-cast", "levitate", "", "", 0.9); }
  if a.kind == FB_INSPIRE { return xs("raid-won", "", "", "", 1.2); }
  if a.kind == FB_TURN { return xs("rebuke", "choir", "radiant", "", 1); }
  if a.kind == FB_PRESERVE { return xs("second-wind", "heal", "", "", 1.15); }
  if a.kind == FB_LANDS { return xs("shield", "entangle", "", "", 1.1); }
  if a.kind == FB_AIM { return xs("hold", "", "", "", 1.3); }
  if a.kind == FB_CDASH { return xs("teleport", "", "", "", 1.2); }
  if a.kind == FB_DASH { return xs("dash", "", "", "", 1); }
  if a.kind == FB_HIDE || a.kind == FB_READY { return xs("hold", "", "", "", ifx a.kind == FB_HIDE then 0.8 else 1.1); }
  if a.kind == FB_GRAPPLE || a.kind == FB_SHOVE { return xs("grunt", "", "hit", "", ifx a.kind == FB_GRAPPLE then 0.9 else 1.1); }
  if a.kind == FB_RESURGE || a.kind == FB_WILD { return xs("rage-roar", "", "", "", 1.25); }   // Wild Shape's beast
  return xs("arcane-cast", "", "", "", 1);
}

// ---- the wire: class c's ability i
// A wire slot names an ability of class c whatever its level (#13046): slot i is the i-th of the class's
// catalog, every ability its bars at levels 1 to XK_LEVELS hold, in the order they first appear. Level
// 1's bar is the catalog's start, so its slots are the bar's own order. A seat's level says which of
// them its bar holds (xk_entry_at); a page plays another's cast from the catalog, its level unknown.
XK_SLOT0 :: 128;   // past Everglade's bars (fivebar.coax: its own 0 on, the Warlock's FB_WL0, Character Create's one ability FB_CL0)
XK_PER :: XC_SLOTS;
XK_LEVEL :: 1;     // a seat that has said no level
XK_LEVELS :: 6;    // Everglade II's levels: 1 to 6, as Character Create offers
xk_level :: (level: int) -> int { return ifx level < 1 then 1 else ifx level > XK_LEVELS then XK_LEVELS else level; }
xk_slot :: (c: int, i: int) -> int { return XK_SLOT0 + c * XK_PER + i; }
xk_slot_class :: (slot: int) -> int { return ifx slot >= XK_SLOT0 && slot < XK_SLOT0 + FB_CL_N * XK_PER then (slot - XK_SLOT0) / XK_PER else -1; }
xk_slot_index :: (slot: int) -> int { return ifx xk_slot_class(slot) >= 0 then (slot - XK_SLOT0) % XK_PER else -1; }
// Class c's bar at `level`, in its own order: how many.
xk_bar_at :: (c: int, level: int, out: [] FbAb) -> int { return ifx c >= 0 && c < FB_CL_N then xc_bar_level(c, xk_level(level), out) else 0; }
xk_bar :: (c: int, out: [] FbAb) -> int { return xk_bar_at(c, XK_LEVEL, out); }
// Class c's catalog: how many.
xk_catalog :: (c: int, out: [] FbAb) -> int {
  n := 0;
  for level: 1..<XK_LEVELS + 1 {
    bar: [XC_SLOTS] FbAb; m := xk_bar_at(c, level, bar[..]);
    for i: 0..<m {
      seen := false;
      for j: 0..<n { if xc_id(out[j]) == xc_id(bar[i]) { seen = true; } }
      if !seen && n < out.count { out[n] = bar[i]; n += 1; }
    }
  }
  return n;
}
// The wire slot of class c's ability a (-1: not in its catalog).
xk_wire :: (c: int, a: FbAb) -> int {
  cat: [XC_SLOTS] FbAb; n := xk_catalog(c, cat[..]);
  for i: 0..<n { if xc_id(cat[i]) == xc_id(a) { return xk_slot(c, i); } }
  return -1;
}

#test "the level 3 Life Cleric bar gains Lesser Restoration at a stable shared wire slot" {
  a:=fb_spell(SP_LESSER_RESTORATION,2,FB_ALLY);
  wire:=xk_wire(FB_CL_CLERIC,a);
  #assert wire>=0 && !xk_entry_at(FB_CL_CLERIC,2,wire).ok;
  entry:=xk_entry_at(FB_CL_CLERIC,3,wire);
  #assert entry.ok && entry.ab.sp==SP_LESSER_RESTORATION && entry.ab.lvl==2;
  sound:=xc_sound(entry.ab,FB_CL_CLERIC);
  #assert entry.ab.tg==FB_ALLY && sound.start=="shield";
}

#test "Aid is on the Life Cleric bar from level 3 and the Devotion Paladin bar from level 5" {
  for klass:[2]int.[FB_CL_CLERIC,FB_CL_PALADIN] {
    min_level:=ifx klass==FB_CL_CLERIC then 3 else 5;
    wire:=xk_wire(klass,fb_spell(SP_AID,2,FB_ALLY));
    #assert wire>=0 && !xk_entry_at(klass,min_level-1,wire).ok;
    entry:=xk_entry_at(klass,min_level,wire);
    #assert entry.ok && entry.ab.sp==SP_AID && entry.ab.lvl==2 && entry.ab.tg==FB_ALLY;
  }
}

#test "the Blessed Warrior kit exposes Guidance from level 2 with all skill choices" {
  a:=fb_spell(SP_GUIDANCE,0,FB_SELF);
  wire:=xk_wire(FB_CL_PALADIN,a);
  #assert wire>=0 && !xk_entry_at(FB_CL_PALADIN,1,wire).ok;
  entry:=xk_entry_at(FB_CL_PALADIN,2,wire);
  #assert entry.ok && entry.ab.sp==SP_GUIDANCE && fb_ab_option_n(entry.ab)==RS_SKILLS;
  first:=fb_option(SP_GUIDANCE,0);
  #assert first.guidance==SK_PERCEPTION && fb_option_label(SP_GUIDANCE,0)=="PER";
}

#test "the Devotion Paladin kit exposes Protection from Evil and Good from level 3" {
  a:=fb_spell(SP_PROTECTION_GOOD_EVIL,1,FB_SELF);
  wire:=xk_wire(FB_CL_PALADIN,a);
  #assert wire>=0 && !xk_entry_at(FB_CL_PALADIN,2,wire).ok;
  entry:=xk_entry_at(FB_CL_PALADIN,3,wire);
  #assert entry.ok && entry.ab.sp==SP_PROTECTION_GOOD_EVIL && entry.ab.lvl==1 && entry.ab.tg==FB_SELF;
}
#test "the Life Cleric kit exposes Revivify from level 5" {
  wire:=xk_wire(FB_CL_CLERIC,fb_spell(SP_REVIVIFY,3,FB_ALLY));
  #assert wire>=0 && !xk_entry_at(FB_CL_CLERIC,4,wire).ok;
  entry:=xk_entry_at(FB_CL_CLERIC,5,wire);
  #assert entry.ok && entry.ab.sp==SP_REVIVIFY && entry.ab.lvl==3 && entry.ab.tg==FB_ALLY;
}
// The weapon class c's hero holds (its Attack's reach): a bow kit's Longbow, not the blade at its
// belt (#13130: a Ranger's Attack reached the shortsword's 5 feet).
xk_weapon :: (c: int) -> int {
  if c < 0 || c >= FB_CL_N { return 0; }
  h := fb_cl_hero(c, "", 0, XK_LEVEL);
  return ifx xc_kit(c) == XC_KIT_BOW && h.ranged > 0 then h.ranged else h.weapon;
}
// Class c's ability as the rules take it: a bow kit's Attack is the Attack action with its ranged
// weapon (FB_SHOOT, rs_shoot: the Longbow's 150/600 feet, Disadvantage past normal range), in every
// realm and the room; every other ability is itself.
xk_rules :: (c: int, a: FbAb) -> FbAb {
  if a.kind != FB_ATTACK || xc_kit(c) != XC_KIT_BOW { return a; }
  shot := fb_feature(FB_SHOOT, "Longbow", "attack"); shot.tg = a.tg;
  return shot;
}
// Wire slot `slot` for class c: its ability, how it aims; ok false when it is not in c's catalog.
XkEntry :: struct { ok: bool; ab: FbAb; aim: XcAim; }
xk_entry :: (c: int, slot: int) -> XkEntry {
  if xk_slot_class(slot) != c { return XkEntry.{}; }
  cat: [XC_SLOTS] FbAb; n := xk_catalog(c, cat[..]); i := xk_slot_index(slot);
  if i < 0 || i >= n { return XkEntry.{}; }
  return XkEntry.{ok = true, ab = cat[i], aim = xc_aim_for(cat[i], xk_weapon(c))};
}
// The same, for a seat of class c at `level`: ok only when that level's bar holds it.
xk_entry_at :: (c: int, level: int, slot: int) -> XkEntry {
  e := xk_entry(c, slot);
  if !e.ok { return e; }
  bar: [XC_SLOTS] FbAb; n := xk_bar_at(c, level, bar[..]);
  for i: 0..<n { if xc_id(bar[i]) == xc_id(e.ab) { return XkEntry.{ok = true, ab = bar[i], aim = xc_aim_for(bar[i], xk_weapon(c))}; } }
  return XkEntry.{};
}

#test "class kits: every class's bar holds its Character Create ability first, each slot with its picture, and its wire slots" #steps 400000000 {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    n := xk_bar(c, bar[..]);
    #assert n >= 2 && n <= XC_SLOTS;
    #assert bar[0].kind == fb_cl_ability(c).kind && bar[0].name == fb_cl_ability(c).name && xc_url(bar[0].art) == XC_EG_URL;
    for i: 0..<n {
      s := xk_slot(c, i);
      #assert xk_slot_class(s) == c && xk_slot_index(s) == i && xk_entry(c, s).ok && xk_entry(c, s).ab.name == bar[i].name;
      #assert !xk_entry((c + 1) % FB_CL_N, s).ok;   // another class's slot
    }
    #assert !xk_entry_at(c, 1, xk_slot(c, n)).ok && !xk_entry(c, FB_CL0 + c).ok && !xk_entry(c, 1).ok;
  }
  #assert xk_slot_class(XK_SLOT0 - 1) == -1 && xk_slot_class(XK_SLOT0 + FB_CL_N * XK_PER) == -1;
  // a Wizard's Fire Bolt is a bolt of 120 feet; a Fighter's sword a blow; Second Wind its own
  w := xk_entry(FB_CL_WIZARD, xk_slot(FB_CL_WIZARD, 0)); #assert w.ab.sp == SP_FIRE_BOLT && w.aim.kind == XC_AIM_BOLT && abs(w.aim.reach - 36.576) < 0.01;
  f := xk_entry(FB_CL_FIGHTER, xk_slot(FB_CL_FIGHTER, 1)); #assert f.ab.kind == FB_ATTACK && f.aim.kind == XC_AIM_MELEE;
  #assert xk_entry(FB_CL_FIGHTER, xk_slot(FB_CL_FIGHTER, 0)).aim.kind == XC_AIM_SELF;
  p := xc_aim_point(w.ab, w.aim, 1, 2, 0, 1); #assert p[0] == 1 && abs(p[1] - 38.576) < 0.01;
  q := xc_aim_point(f.ab, XcAim.{kind = XC_AIM_SELF}, 1, 2, 0, 1); #assert q[0] == 1 && q[1] == 2;
}
#test "class kits: a slot names one ability at every level; a level's bar holds only its own" #steps 4000000000 {
  for c: 0..<FB_CL_N {
    cat: [XC_SLOTS] FbAb; cn := xk_catalog(c, cat[..]);
    #assert cn <= XC_SLOTS;
    for level: 1..<XK_LEVELS + 1 {
      bar: [XC_SLOTS] FbAb; n := xk_bar_at(c, level, bar[..]);
      for i: 0..<n {
        at := -1; for j: 0..<cn { if xc_id(cat[j]) == xc_id(bar[i]) { at = j; } }
        #assert at >= 0 && (level > 1 || at == i);   // level 1's slots as before
      }
    }
  }
  // a Fighter's Action Surge comes at level 2: its slot is refused at level 1 and taken at 6
  f2: [XC_SLOTS] FbAb; f2n := xk_bar_at(FB_CL_FIGHTER, 2, f2[..]); surge := -1;
  for i: 0..<f2n { if f2[i].kind == FB_SURGE { surge = xk_wire(FB_CL_FIGHTER, f2[i]); } }
  #assert surge >= 0 && !xk_entry_at(FB_CL_FIGHTER, 1, surge).ok && xk_entry_at(FB_CL_FIGHTER, 6, surge).ok && xk_entry(FB_CL_FIGHTER, surge).ab.kind == FB_SURGE;
  #assert xk_entry_at(FB_CL_FIGHTER, 1, xk_slot(FB_CL_FIGHTER, 1)).ab.kind == FB_ATTACK;
  #assert xk_level(0) == 1 && xk_level(9) == 6 && xk_level(4) == 4;
}
#test "class kits: every ability has a cast sound" #steps 400000000 {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N { n := xk_catalog(c, bar[..]); for i: 0..<n { #assert xc_sound(bar[i], c).start.count > 0; } }
}
#test "the Druid's kit: Wild Shape and an Attack from level 2; in a form its spells wait and Attack is the Beast's" #steps 400000000 {
  for level: 1..<7 {
    bar: [XC_SLOTS] FbAb; n := xc_bar_level(FB_CL_DRUID, level, bar[..]);
    w := -1; at := -1; spell := -1;
    for k: 0..<n { if bar[k].kind == FB_WILD { w = k; } if bar[k].kind == FB_ATTACK { at = k; } if bar[k].kind == FB_SPELL && bar[k].lvl > 0 { spell = k; } }
    #assert (w >= 0) == (level >= 2) && (at >= 0) == (level >= 2) && spell >= 0;
    if w < 0 { continue; }
    #assert bar[w].art == "wild-shape" && xc_aim_for(bar[w], 0).kind == XC_AIM_SELF && xc_url(bar[w].art) == XC_MMO_URL;
    b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
    _ := rs_add(b[..], fb_cl_hero(FB_CL_DRUID, "You", 0, level), 1, 1); _ = rs_add(b[..], rs_fighter("Foe", 1, 3), 2, 1);
    b[0].c[1].ac = 10; rs_fresh(b[..], 0);
    #assert fb_ready(b[..], 0, bar[w]) && fb_left(b[..], 0, bar[w]) == b[0].c[0].uses_max[RS_USE_WILD] && fb_ready(b[..], 0, bar[spell]);
    #assert fb_use(b[..], 0, bar[w], -1, 0, 0, -1) && b[0].c[0].wild_form == (ifx level >= 4 then MON_BLACK_BEAR else MON_WOLF) && !fb_ready(b[..], 0, bar[spell]);
    hp := b[0].c[1].hp; #assert fb_use(b[..], 0, bar[at], 1, 0, 0, -1) && b[0].c[1].hp < hp;
    rs_fresh(b[..], 0); #assert fb_ready(b[..], 0, bar[w]) && fb_use(b[..], 0, bar[w], -1, 0, 0, -1) && b[0].c[0].wild_form == 0 && fb_ready(b[..], 0, bar[spell]);
    b[0].c[0].uses[RS_USE_WILD] = 0; #assert !fb_ready(b[..], 0, bar[w]);
  }
}

#test "class kits: a Ranger's Attack is its Longbow in aim and in the rules, 150 feet out; a Fighter's stays its blade (#13130)" {
  #assert xk_weapon(FB_CL_RANGER) == W_LONGBOW && xk_weapon(FB_CL_FIGHTER) == fb_cl_hero(FB_CL_FIGHTER, "", 0, XK_LEVEL).weapon;
  slot := -1; bar: [XC_SLOTS] FbAb; n := xk_bar(FB_CL_RANGER, bar[..]); for i: 0..<n { if bar[i].kind == FB_ATTACK { slot = xk_slot(FB_CL_RANGER, i); } }
  e := xk_entry(FB_CL_RANGER, slot); #assert e.ok && e.ab.kind == FB_ATTACK && e.aim.kind == XC_AIM_BOLT && abs(e.aim.reach - 150 * f32(XC_FT)) < 0.01;
  #assert xk_rules(FB_CL_RANGER, e.ab).kind == FB_SHOOT && xk_rules(FB_CL_FIGHTER, e.ab).kind == FB_ATTACK && xk_rules(FB_CL_RANGER, bar[2]).kind == bar[2].kind;
  // the rules: a guard 100 feet off is out of the shortsword's reach and inside the Longbow's
  b: [1] RsBattle; b[0].w = 40; b[0].h = 6; b[0].dice[0].fixed = true;
  _ := rs_add(b[..], fb_cl_hero(FB_CL_RANGER, "You", 0, 3), 1, 1); g := rs_add(b[..], rs_fighter("Foe", 1, 3), 21, 1);
  b[0].c[g].ac = 5; rs_fresh(b[..], 0); hp := b[0].c[g].hp;
  #assert !fb_use(b[..], 0, e.ab, g, 0, 0, -1) && b[0].c[g].hp == hp;
  #assert fb_use(b[..], 0, xk_rules(FB_CL_RANGER, e.ab), g, 0, 0, -1) && b[0].c[g].hp < hp;
}
#test "class kits: the restart check's --levels fixtures name the slots the kits give" {
  // coax/web/room/e2-restart-check.coax's RX_F_* and RX_B_* constants
  f5: [XC_SLOTS] FbAb; f1: [XC_SLOTS] FbAb; b3: [XC_SLOTS] FbAb;
  #assert xk_bar_at(FB_CL_FIGHTER, 5, f5[..]) == 4; #assert xk_bar_at(FB_CL_FIGHTER, 1, f1[..]) == 3; #assert xk_bar_at(FB_CL_BARBARIAN, 3, b3[..]) == 4;
  #assert f5[2].kind == FB_SURGE; #assert xk_wire(FB_CL_FIGHTER, f5[2]) == 227;
  #assert f5[1].kind == FB_ATTACK; #assert xk_wire(FB_CL_FIGHTER, f5[1]) == 225;
  #assert b3[0].kind == FB_RAGE; #assert xk_wire(FB_CL_BARBARIAN, b3[0]) == 128;
  for i: 0..<3 { #assert f1[i].kind != FB_SURGE; }
}

// ---- the room's word on a bar's slots (#13084): every zone reads it here
// What the room counts for slot i of your bar of `count` slots: ok false until it has said a bar of
// that size (open: you are seated; known: it has sent one; n, v: its slots, wire V = (LEFT + 1) * 2 + ON,
// everglade-wire.coax wire_kit_v). left: what the slot has left (slots at its level, uses, Rages,
// Focus; -1 nothing to count); on: its own effect holds (a Rage, Wild Shape's form).
XkSlot :: struct { ok: bool; left: int = -1; on: bool; }
xk_room_slot :: (open: bool, known: bool, n: int, v: [] int, i: int, count: int) -> XkSlot {
  if !open || !known || n != count || i < 0 || i >= count || i >= v.count { return XkSlot.{}; }
  return XkSlot.{ok = true, left = v[i] / 2 - 1, on = v[i] % 2 == 1};
}
#test "xk room slot: the room's count and held effect, only for a bar of the size it said" {
  v := [3] int.[0, 7, 4];
  #assert !xk_room_slot(false, true, 3, v[..], 1, 3).ok && !xk_room_slot(true, false, 3, v[..], 1, 3).ok;
  a := xk_room_slot(true, true, 3, v[..], 1, 3);
  #assert a.ok && a.left == 2 && a.on && xk_room_slot(true, true, 3, v[..], 0, 3).left == -1 && xk_room_slot(true, true, 3, v[..], 2, 3).left == 1;
  #assert !xk_room_slot(true, true, 3, v[..], 1, 4).ok && !xk_room_slot(true, true, 3, v[..], 3, 3).ok && !xk_room_slot(true, true, 3, v[..], -1, 3).ok;
}
