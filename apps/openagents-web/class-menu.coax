// Everglade Experimental's CLASSES column (experimental-combat.coax), shared with Everglade II's
// local admin mode (everglade2-admin.coax): the twelve SRD 5.2.1 classes, LEVEL 1 to 6, and REST
// (SHORT, SLEEP, WATCH, HIT DIE, END REST). This unit lays the column out, draws it
// and says what a point in it is; each world applies the choice its own way (Experimental to its
// offline battle, Everglade II through its room). Its loader loads charactercreator.coax as cc and
// class-kit.coax (XC_CL_UP).
//   coax/bin/coax test --library apps/openagents-web/everglade2.coax --only "class menu"

CM_HEAD :: 32.0; CM_ROW :: 24.0; CM_ROWS_TOP :: 40.0; CM_GAP :: 8.0;   // CSS px: its header, its rows, the gap above it
CM_CLASSES :: 12; CM_LEVELS :: 6;
CM_REST_LABELS :: [5]string.["SHORT","SLEEP","WATCH","HIT DIE","END REST"];
// What a point in the column is (cm_hit): nothing, the header, a class row, a level, or a rest
// request (0 to 4, CM_REST_LABELS's order).
CM_NONE :: 0; CM_TOGGLE :: 1; CM_CLASS :: 2; CM_LEVEL :: 3; CM_REST :: 4;
CmHit :: struct { kind: int; index: int; }

// The class part's height, CSS px: its header, and when open its twelve rows.
cm_class_height :: (open: bool) -> f32 { return ifx open then f32(CM_ROWS_TOP) + f32(CM_CLASSES) * f32(CM_ROW) + 8 else f32(CM_HEAD); }
// The whole column's height, CSS px, with `extra` px of rows of its world's own below REST.
cm_height :: (open: bool, extra: f32) -> f32 { return cm_class_height(open) + 110 + extra; }
// REST's box i (0 to 4 its requests, 5 left empty, then a world's own boxes in the same grid), device px.
cm_box :: (top: f32, open: bool, k: f32, i: int) -> cc.Box {
  left := (32 + f32(i % 3) * 106) * k; y := top + (cm_class_height(open) + 58 + f32(i / 3) * 23) * k;
  return cc.Box.{x0 = left, y0 = y, x1 = left + 96 * k, y1 = y + 21 * k};
}
cm_in :: (r: cc.Box, px: f32, py: f32) -> bool { return px >= r.x0 && px <= r.x1 && py >= r.y0 && py <= r.y1; }
// What (px, py) is in the column whose top is `top` (device px).
cm_hit :: (top: f32, open: bool, k: f32, px: f32, py: f32) -> CmHit {
  if px < 12 * k || px > 370 * k || py < top { return CmHit.{}; }
  if py >= top + (cm_class_height(open) + 34) * k {
    for i: 0..<5 { if cm_in(cm_box(top, open, k, i), px, py) { return CmHit.{kind = CM_REST, index = i}; } }
    return CmHit.{};
  }
  if py >= top + cm_class_height(open) * k {
    level := cast(int) floor((px / k - 94) / 34) + 1;
    return ifx level >= 1 && level <= CM_LEVELS then CmHit.{kind = CM_LEVEL, index = level} else CmHit.{};
  }
  if py < top + f32(CM_HEAD) * k { return CmHit.{kind = CM_TOGGLE}; }
  if open {
    row := cast(int) floor((py - top - f32(CM_ROWS_TOP) * k) / (f32(CM_ROW) * k));
    if py >= top + f32(CM_ROWS_TOP) * k && row >= 0 && row < CM_CLASSES { return CmHit.{kind = CM_CLASS, index = row}; }
  }
  return CmHit.{};
}
// The column's words: CLASSES (yours marked), LEVEL (yours gold), the rest line and its requests.
// With a layout trace attached (aethyr/ui/trace.coax) it also puts what cm_hit presses there, in
// the column's panel `pane` (the caller's, as tall as its own rows: UIT_NONE for none), under the
// part the caller names (cc.uit_part), so a developer's panel can mark it (cc.uit_debug).
cm_draw :: (ui: [] cc.UitTrace, pane: int, out: [] f32, at: int, top: f32, open: bool, k: f32, klass: int, level: int, rest: string) -> int {
  n := at; head := cc.ink(k, 0.95, 0.9, 0.7); body := cc.ink(k, 0.91, 0.93, 0.88); gold := cc.ink(k, 1, 0.75, 0.3);
  toggle := cc.uit_put(ui, pane, cc.UIT_BUTTON, 12 * k, top, 370 * k, top + f32(CM_HEAD) * k, "CLASSES");
  n = cc.ttext(ui, toggle, out, n, ifx open then "- CLASSES" else "+ CLASSES", 32 * k, top + 25 * k, 10 * k, head, "");
  if open {
    for c: 0..<CM_CLASSES {
      y := top + (f32(CM_ROWS_TOP) + f32(c) * f32(CM_ROW) + 17) * k;
      row_b := cc.uit_put(ui, pane, cc.UIT_BUTTON, 12 * k, top + (f32(CM_ROWS_TOP) + f32(c) * f32(CM_ROW)) * k, 370 * k, top + (f32(CM_ROWS_TOP) + f32(c + 1) * f32(CM_ROW)) * k, XC_CL_UP[c]);
      n = cc.ttext(ui, row_b, out, n, ifx c == klass then ">" else " ", 24 * k, y, 10 * k, cc.ink(k, 0.95, 0.8, 0.4), "");
      n = cc.ttext(ui, row_b, out, n, XC_CL_UP[c], 40 * k, y, 10 * k, body, "");
    }
  }
  level_y := top + (cm_class_height(open) + 23) * k;
  n = cc.ttext(ui, pane, out, n, "LEVEL", 32 * k, level_y, 10 * k, head, "");
  for l: 1..<CM_LEVELS + 1 {
    digit: [1] u8; digit[0] = cast(u8) (48 + l);
    lx := (94 + f32(l - 1) * 34) * k;
    lvl_b := cc.uit_put_i(ui, pane, cc.UIT_BUTTON, lx, top + cm_class_height(open) * k, lx + 34 * k, top + (cm_class_height(open) + 34) * k, "LEVEL", l);
    n = cc.ttext(ui, lvl_b, out, n, cast(string) digit[..], (100 + f32(l - 1) * 34) * k, level_y, 10 * k, ifx l == level then gold else body, "");
  }
  n = cc.ttext(ui, pane, out, n, rest, 32 * k, top + (cm_class_height(open) + 49) * k, 8 * k, head, "REST LINE");
  for i: 0..<5 {
    r := cm_box(top, open, k, i); rest_b := cc.uit_put(ui, pane, cc.UIT_BUTTON, r.x0, r.y0, r.x1, r.y1, CM_REST_LABELS[i]);
    n = cc.ttext(ui, rest_b, out, n, CM_REST_LABELS[i], r.x0, r.y0 + 16 * k, 8 * k, body, "");
  }
  return n;
}

// ---- the compact picker (Everglade Experimental, #13092): touch-sized buttons in the realm's HUD
// style, the twelve classes as a grid and LEVEL beside its header when it fits; rest is in the menu
// your portrait opens (everglade/hud/class-bar.coax). A world places it in the room it has (x0, y0, wide:
// device px) and gives the lowest it may reach (foot); the grid takes as many columns as it needs to
// stay over that foot. The wild-shape row (a Druid's form swap) sits under it while one is due.
CM_WILD :: 6;                       // a wild-shape box (0 the known form, 1 the new, 2 REPLACE)
CM_TOGGLE_W :: 112.0; CM_LABEL_W :: 66.0; CM_CLASS_MIN :: 66.0; CM_PAD :: 8.0; CM_SAY :: 18.0;
CmPick :: struct { pad: f32; x0: f32; y0: f32; wide: f32; t: f32; lw: f32; lab: f32; gap: f32; cols: int; cw: f32; beside: bool; open: bool; wild: bool; k: f32; }
// A button's height: a finger's (44 CSS px) on a phone or a tablet, 28 on a desktop's page.
cm_pick_t :: (w: f32, h: f32, k: f32) -> f32 { return ifx w >= 1280 * k && h >= 700 * k then 28 * k else 44 * k; }
cm_pick_head :: (p: CmPick) -> f32 { return ifx p.beside then p.t else 2 * p.t + p.gap; }
cm_pick_rows :: (p: CmPick) -> int { return ifx p.open then (CM_CLASSES + p.cols - 1) / p.cols else 0; }
// Its height, device px, panel padding included.
cm_pick_height :: (p: CmPick) -> f32 {
  r := cm_pick_rows(p); hh := 2 * p.pad + cm_pick_head(p);
  if r > 0 { hh += p.gap + f32(r) * p.t + f32(r - 1) * p.gap; }
  if p.wild { hh += p.gap + CM_SAY * p.k + p.t; }
  return hh;
}
cm_pick :: (x0: f32, y0: f32, wide: f32, foot: f32, open: bool, wild: bool, w: f32, h: f32, k: f32) -> CmPick {
  p := CmPick.{x0 = x0, y0 = y0, wide = wide, t = cm_pick_t(w, h, k), gap = 6 * k, open = open, wild = wild, k = k};
  p.lw = ifx p.t > 34 * k then p.t else 34 * k;
  p.pad = CM_PAD * k; inner := wide - 2 * p.pad; levels := 6 * p.lw + 5 * p.gap;
  // LEVEL beside CLASSES with its word; where only the buttons fit, they read "LV 1" and it goes;
  // else on a line of its own
  p.lab = CM_LABEL_W * k;
  p.beside = CM_TOGGLE_W * k + p.gap + p.lab + levels <= inner;
  if !p.beside && CM_TOGGLE_W * k + p.gap + levels <= inner { p.beside = true; p.lab = 0; }
  if !p.beside && p.lab + levels > inner { p.lab = 0; }
  // the fewest columns that keep the grid over the foot, each at least CM_CLASS_MIN wide
  most := cast(int) floor((inner + p.gap) / (CM_CLASS_MIN * k + p.gap)); if most < 1 { most = 1; } if most > 6 { most = 6; }
  p.cols = ifx most < 3 then most else 3;
  while p.cols < most && y0 + cm_pick_height(p) > foot { p.cols += 1; }
  // still too tall: the wild-shape row waits while the classes are open (CLASSES - shuts them and shows it)
  if p.wild && p.open && y0 + cm_pick_height(p) > foot { p.wild = false; }
  // and on the tightest pages its buttons close up (the gaps, not the buttons, give way)
  if y0 + cm_pick_height(p) > foot { p.pad = 3 * k; p.gap = 4 * k; }
  p.cw = ((wide - 2 * p.pad) - f32(p.cols - 1) * p.gap) / f32(p.cols);
  return p;
}
cm_pick_panel :: (p: CmPick) -> cc.Box { return cc.Box.{x0 = p.x0, y0 = p.y0, x1 = p.x0 + p.wide, y1 = p.y0 + cm_pick_height(p)}; }
cm_pick_box :: (p: CmPick, kind: int, i: int) -> cc.Box {
  k := p.k; x := p.x0 + p.pad; y := p.y0 + p.pad;
  if kind == CM_TOGGLE { return cc.Box.{x0 = x, y0 = y, x1 = x + CM_TOGGLE_W * k, y1 = y + p.t}; }
  if kind == CM_LEVEL {
    lx := ifx p.beside then x + CM_TOGGLE_W * k + p.gap + p.lab else x + p.lab;
    ly := ifx p.beside then y else y + p.t + p.gap;
    bx := lx + f32(i - 1) * (p.lw + p.gap); return cc.Box.{x0 = bx, y0 = ly, x1 = bx + p.lw, y1 = ly + p.t};
  }
  gy := y + cm_pick_head(p) + p.gap;
  if kind == CM_CLASS {
    if !p.open || i < 0 || i >= CM_CLASSES { return cc.Box.{}; }
    c := i % p.cols; r := i / p.cols; bx := x + f32(c) * (p.cw + p.gap); by := gy + f32(r) * (p.t + p.gap);
    return cc.Box.{x0 = bx, y0 = by, x1 = bx + p.cw, y1 = by + p.t};
  }
  if kind == CM_WILD {
    if !p.wild { return cc.Box.{}; }
    r := cm_pick_rows(p); wy := gy + (ifx r > 0 then f32(r) * (p.t + p.gap) else 0) + CM_SAY * k;
    ww := ((p.wide - 2 * p.pad) - 2 * p.gap) / 3; bx := x + f32(i) * (ww + p.gap);
    return cc.Box.{x0 = bx, y0 = wy, x1 = bx + ww, y1 = wy + p.t};
  }
  return cc.Box.{};
}
cm_pick_hit :: (p: CmPick, px: f32, py: f32) -> CmHit {
  if !cm_in(cm_pick_panel(p), px, py) { return CmHit.{}; }
  if cm_in(cm_pick_box(p, CM_TOGGLE, 0), px, py) { return CmHit.{kind = CM_TOGGLE}; }
  for l: 1..<CM_LEVELS + 1 { if cm_in(cm_pick_box(p, CM_LEVEL, l), px, py) { return CmHit.{kind = CM_LEVEL, index = l}; } }
  for c: 0..<CM_CLASSES { if cm_in(cm_pick_box(p, CM_CLASS, c), px, py) { return CmHit.{kind = CM_CLASS, index = c}; } }
  for i: 0..<3 { if cm_in(cm_pick_box(p, CM_WILD, i), px, py) { return CmHit.{kind = CM_WILD, index = i}; } }
  return CmHit.{kind = CM_NONE, index = -1};   // inside its panel: taken, nothing chosen
}
cm_prim :: (b: cc.Box) -> cc.HudPrim { return cc.hud_box(b.x0, b.y0, b.x1, b.y1); }
// A label sized to its box: the cap, smaller while it is wider than the box.
cm_fit :: (t: string, cap: f32, room: f32) -> f32 { w := cc.face_width(t, cap, cc.HUD_FACE_TITLE); return ifx w > room && w > 0 then cap * room / w else cap; }
// Draw it in the realm's HUD style (charactercreator.coax hud_draw): a panel, a button each, yours lit.
// wild_say heads the wild-shape row and wild holds its three buttons' words.
cm_pick_draw :: (ui: [] cc.UitTrace, out: [] f32, at: int, p: CmPick, klass: int, level: int, hover: CmHit, wild_say: string, wild: [3] string) -> int {
  k := p.k; t := cc.eg_tokens(); l: [1] cc.HudList; ws: [1] cc.HudWords; cap := 9 * k;
  cc.hud_panel(l[..], t, cm_prim(cm_pick_panel(p)), k);
  // the layout trace (#13076): the panel, each button in it, each word in its button
  ws[0].ui = ui; pp := cm_pick_panel(p); pane := cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, pp.x0, pp.y0, pp.x1, pp.y1, "CLASSES");
  tb := cm_pick_box(p, CM_TOGGLE, 0);
  ws[0].parent = cc.uit_put(ui, pane, cc.UIT_BUTTON, tb.x0, tb.y0, tb.x1, tb.y1, "CLASSES");
  cc.hud_button(l[..], t, cm_prim(tb), k, hover.kind == CM_TOGGLE);
  cc.hud_word(ws[..], ifx p.open then "CLASSES  -" else "CLASSES  +", (tb.x0 + tb.x1) * 0.5, (tb.y0 + tb.y1) * 0.5 + cap * 0.5, cap, cc.HUD_TEXT_TITLE, true);
  l1 := cm_pick_box(p, CM_LEVEL, 1);
  ws[0].parent = pane;
  if p.lab > 0 { cc.hud_word(ws[..], "LEVEL", l1.x0 - p.lab * 0.5, (l1.y0 + l1.y1) * 0.5 + cap * 0.5, cap, cc.HUD_TEXT_TITLE, true); }
  for lv: 1..<CM_LEVELS + 1 {
    b := cm_pick_box(p, CM_LEVEL, lv); digit: [4] u8; digit[0] = 'L'; digit[1] = 'V'; digit[2] = ' '; digit[3] = cast(u8) (48 + lv);
    word := ifx p.lab > 0 then cast(string) digit[3..<4] else cast(string) digit[..];
    fc := cm_fit(word, cap, b.x1 - b.x0 - 6 * k);
    cc.hud_button(l[..], t, cm_prim(b), k, lv == level || (hover.kind == CM_LEVEL && hover.index == lv));
    ws[0].parent = cc.uit_put_i(ui, pane, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, "LEVEL", lv);
    cc.hud_word(ws[..], word, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + fc * 0.5, fc, cc.HUD_TEXT_TITLE, true);
  }
  if p.open {
    nb: [24] u8;
    for c: 0..<CM_CLASSES {
      b := cm_pick_box(p, CM_CLASS, c); name := cc.eg_title(nb[..], XC_CL_UP[c]);
      cc.hud_button(l[..], t, cm_prim(b), k, c == klass || (hover.kind == CM_CLASS && hover.index == c));
      ws[0].parent = cc.uit_put(ui, pane, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, XC_CL_UP[c]);
      fc := cm_fit(name, cap, b.x1 - b.x0 - 10 * k);
      cc.hud_word(ws[..], name, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + fc * 0.5, fc, cc.HUD_TEXT_TITLE, true);
    }
  }
  if p.wild {
    w0 := cm_pick_box(p, CM_WILD, 0); ws[0].parent = pane;
    cc.hud_word(ws[..], wild_say, w0.x0, w0.y0 - 6 * k, 8 * k, cc.HUD_TEXT_TITLE, false);
    for i: 0..<3 {
      b := cm_pick_box(p, CM_WILD, i);
      cc.hud_button(l[..], t, cm_prim(b), k, hover.kind == CM_WILD && hover.index == i);
      ws[0].parent = cc.uit_put_i(ui, pane, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, "WILD", i);
      fc := cm_fit(wild[i], cap, b.x1 - b.x0 - 10 * k);
      cc.hud_word(ws[..], wild[i], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + fc * 0.5, fc, cc.HUD_TEXT_TITLE, true);
    }
  }
  return cc.hud_draw(out, at, l[..], ws[..], 1, k);
}
#test "class menu: the compact picker's buttons are a finger tall on a phone and stay inside its panel and over its foot" {
  for v: 0..<3 {
    w := ifx v == 0 then 1170.0f32 else ifx v == 1 then 2532.0f32 else 1920.0f32;
    h := ifx v == 0 then 2532.0f32 else ifx v == 1 then 1170.0f32 else 1080.0f32;
    k := ifx v == 2 then 1.0f32 else 3.0f32;
    wide := ifx v == 1 then 470 * k else ifx v == 0 then w - 24 * k else 346 * k;
    foot := ifx v == 1 then 250 * k else h - 200 * k;
    p := cm_pick(12 * k, 20 * k, wide, foot, true, v != 1, w, h, k);
    #assert p.t >= (ifx v == 2 then 28 * k else 44 * k) - 0.01;
    #assert p.y0 + cm_pick_height(p) <= foot;
    pb := cm_pick_panel(p);
    for c: 0..<CM_CLASSES {
      b := cm_pick_box(p, CM_CLASS, c); #assert b.x0 >= pb.x0 && b.x1 <= pb.x1 + 0.01 && b.y1 <= pb.y1 + 0.01;
      #assert cm_pick_hit(p, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5).kind == CM_CLASS && cm_pick_hit(p, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5).index == c;
    }
    for lv: 1..<CM_LEVELS + 1 { b := cm_pick_box(p, CM_LEVEL, lv); #assert b.x1 <= pb.x1 + 0.01 && b.x1 - b.x0 >= 34 * k - 0.01; }
    if p.wild { for i: 0..<3 { b := cm_pick_box(p, CM_WILD, i); #assert b.y1 <= pb.y1 + 0.01 && cm_pick_hit(p, b.x0 + 2, b.y0 + 2).kind == CM_WILD; } }
  }
}
