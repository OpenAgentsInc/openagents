// Dead Gears, openagents.com/realms/dead-gears: the ship survival game, ported
// from aethyr-demo's src/dead_gears.cpp. The rules are verse/deadgears/
// (ecs.coax, arena.coax, rules.coax: every system and check of the demo);
// this file is the page over them: the ship's hull as the demo built it, the
// cover, the reactor, the cargo, the bolts and the cutter's beams, the
// engineers and the creatures as procedural box figures, the camera at your
// shoulder, the controls (keyboard and two thumbs), the HUD, the deck's hour
// (each wave later in the day), its lamps and alarms, and the save kept in
// the realm's slot at each wave and repair.
//
// Every visible thing is a box: an object in store 0 (three rows of its
// transform, its colour and how much it glows), drawn by deadgears.wgsl's
// scene pass with the sun, the lamps and their shadows from the uniforms.
// deadgears-face.c binds it for the browser.
//   coax/bin/coax test apps/openagents-web/deadgears.coax --steps 4000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/deadgears/rules.coax";
#load "../../verse/edit/edit.coax";   // EDIT for its owner and admins (docs/verse/realm-edit.md)
#load "../../verse/player.coax" as pc;   // the controller every walkable realm shares (#6d99)

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 24000;
PLATES :: 16;
LIGHTS :: 40;
SHADOWS :: 24;
OCCLUDERS :: 10;
// The uniforms: width, height, time, fade, still, plates, dpr, horizon; the
// view's four rows; the eye and the fog's density; the sun's direction and
// strength, its colour; the sky's and the deck's ambient; the sky's zenith
// (and the alarm), its horizon (and the night), the fog's colour (and the
// muzzle's flash), the counts (lights, shadows, occluders, hurt); then the
// lights (where and how far, what colour), the blob shadows (x, z, radius,
// strength), the occluders (low and high corners) and the plates.
U_VIEW :: 8; U_EYE :: 24; U_SUN :: 28; U_SUNC :: 32; U_SKY :: 36; U_GND :: 40; U_ZEN :: 44; U_HOR :: 48; U_FOG :: 52; U_INFO :: 56;
U_LIGHT :: 60;
U_SHADOW :: U_LIGHT + LIGHTS * 8;
U_OCC :: U_SHADOW + SHADOWS * 4;
U_PLATE :: U_OCC + OCCLUDERS * 8;
UNIFORM_FLOATS :: U_PLATE + PLATES * 8;

OBJECTS :: 6000;
OBJECT_FLOATS :: 16;
BOX_VERTICES :: 36;

FX :: 64;
FX_SPARK :: 1; FX_PUFF :: 2; FX_BURST :: 3; FX_DOWN :: 4; FX_FIXED :: 5; FX_PULSE :: 6; FX_LIFT :: 7; FX_HURT :: 8;

OUTBOX_CAP :: 256;
MSG_KEPT :: 4;           // host.js: what the realm's slot kept, on each visit
ACT_NAVIGATE :: 1;       // host.js: go to the outbox's URL
ACT_KEEP :: 4;           // host.js: keep the outbox's text in the realm's slot
SAVE_TAG :: "deadgears-save 1";

KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7; KEY_SHIFT :: -13;
DG_RUN_BY_DEFAULT :: true;   // verse/player.coax RUN_BY_DEFAULT: moving runs, Shift (HOLD_RUN) walks
HOLD_FORWARD :: 1; HOLD_BACK :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8; HOLD_RUN :: 16;
HOLD_TURN_LEFT :: 32; HOLD_TURN_RIGHT :: 64; HOLD_TILT_UP :: 128; HOLD_TILT_DOWN :: 256; HOLD_FIRE :: 512; HOLD_REPAIR :: 1024; HOLD_JUMP :: 2048;

BTN_FIRE :: 0; BTN_RELOAD :: 1; BTN_COVER :: 2; BTN_MODE :: 3; BTN_LIFT :: 4; BTN_STUN :: 5;
BTN_PAUSE :: 6; BTN_AGAIN :: 7; BTN_GALAXY :: 8; BTN_RESUME :: 9; BTN_JUMP :: 10; BUTTONS :: 11;

LOOK_DRAG :: 0.0055;
STICK :: 54.0;           // CSS pixels: the move stick's reach
PITCH_REST :: -0.09;
CAMERA_DIST :: 3.8;
CAMERA_FLOOR :: 0.25;    // the camera stays this far over the deck
RAISED :: 1.2;           // seconds the cutter stays up after a shot: you face the crosshair
COVER_PACE :: 0.43;      // crouched at cover you move at this share of a walk
DG_WALLS :: 24; DG_BODIES :: 96;
BODY_NEAR :: 8.0;        // creatures further than this from you can't touch you or the camera this frame
WAVE_HOURS :: [3] f32.[15.5, 17.2, 18.4];

INK_R :: 0.8; INK_G :: 0.84; INK_B :: 0.9;
AMBER_R :: 1.0; AMBER_G :: 0.66; AMBER_B :: 0.32;
RED_R :: 1.0; RED_G :: 0.36; RED_B :: 0.3;
CYAN_R :: 0.45; CYAN_G :: 0.85; CYAN_B :: 1.0;

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
Fx :: struct { kind: int; at: Point; to: Point; t: f32; life: f32; size: f32; }

DeadGears :: struct {
  started: bool;
  store: [1] Store;
  track: [1] Track;
  time: f64;
  clock: f32;               // the render clock: stops while paused
  width: f32; height: f32; dpr: f32;
  touch: bool; golden: bool; still: bool;
  card: bool;   // ?card=1: the hold without the HUD, for a link's card (coax/web/og-render.ts)
  feet: Point; yaw: f32; pitch: f32; walking: f32;
  pl: pc.Player;            // you, walked by verse/player.coax
  face: f32;                // the way you face: the crosshair with the cutter up, else the way you walk
  raised: f32;              // seconds the cutter stays up after a shot
  jump_tap: bool;           // JUMP tapped on a phone: one jump on the next step
  // What the controller walks among this frame: the hull, the cover, the
  // reactor and the crates at rest (pc.WALL numbers each), and the creatures
  // and the support engineer (pc.BODY numbers each).
  walls: [DG_WALLS * 6] f32; wall_n: int;
  bodies: [DG_BODIES * 7] f32; body_n: int;
  eye: Point; at: Point;
  ally_last: Point; ally_speed: f32;
  held: int;
  drag_on: bool; drag_id: int; drag_x: f32; drag_y: f32;
  look_yaw: f32; look_pitch: f32;
  move_on: bool; move_id: int; mox: f32; moy: f32; pad_x: f32; pad_y: f32;
  look_on: bool; look_id: int; lx: f32; ly: f32;
  fire_touch: int; repair_touch: int;   // the finger holding FIRE (or REPAIR), -1 none
  boxes: [BUTTONS] Rect; shown: [BUTTONS] bool; hover: int; press: int; press_id: int;
  paused: bool;             // Escape or PAUSE, or the tab hidden
  fire_flash: f32; shots: int; hits: int; hit_flash: f32; hurt: f32;
  toast: [64] u8; toast_n: int; toast_t: f32;
  alarm: f32;
  deck_hour: f32; pinned_hour: f32; spawn_n: int; spawned: bool;
  fx: [FX] Fx; fx_next: int;
  objects: [OBJECTS * OBJECT_FLOATS] f32; obj_n: int; hull_n: int; dropped: int;
  draws: [4] u32;
  light_n: int; shadow_n: int; plate_n: int;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  restored: bool; saves: int;
  last_phase: int; last_wave: int; tracked_wave: int;
  facts: bool;
  // The shared edit layer: its board switches the wave alarms, the radar and the hit sparks
  ed: [1] RealmEdit;
}

// ---- small things

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.55 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n >= buf.count { break; } buf[n] = c; n += 1; }
  return n;
}
put_int :: (buf: [] u8, at: int, v: int) -> int {
  n := at;
  x := v;
  if x < 0 { if n < buf.count { buf[n] = 45; n += 1; } x = -x; }
  digits: [20] u8; d := 0;
  if x == 0 { digits[0] = 48; d = 1; }
  while x > 0 && d < 20 { digits[d] = cast(u8) (48 + x % 10); x = x / 10; d += 1; }
  while d > 0 { d -= 1; if n < buf.count { buf[n] = digits[d]; n += 1; } }
  return n;
}

// A number after key= in a URL's query (or -1), as ?spawn=200 and ?hour=17.5.
query_number :: (url: string, key: string) -> f32 {
  at := 0;
  while at + key.count + 1 <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1;
      v: f32 = 0; digits := 0; frac: f32 = 0; scale: f32 = 1;
      while i < url.count && url[i] >= 48 && url[i] <= 57 && digits < 6 { v = v * 10 + f32(url[i] - 48); i += 1; digits += 1; }
      if i < url.count && url[i] == 46 {
        i += 1;
        while i < url.count && url[i] >= 48 && url[i] <= 57 && scale > 0.0001 { scale = scale * 0.1; frac += f32(url[i] - 48) * scale; i += 1; }
      }
      if digits == 0 { return -1; }
      return v + frac;
    }
    at += 1;
  }
  return -1;
}

game :: (s: [] DeadGears) -> Game { return dg_bind(s[0].store[..]); }
me_slot :: (g: Game) -> int { return slot_of(dg_player(g)); }

// ---- starting

dg_page_start :: (s: [] DeadGears) {
  s[0].started = true;
  g := game(s);
  dg_setup(g);
  s[0].pitch = f32(PITCH_REST);
  stand_at(s, v3(0, 0, 9), f32(PI));
  s[0].pinned_hour = -1; s[0].deck_hour = -1;
  s[0].drag_id = -1; s[0].move_id = -1; s[0].look_id = -1; s[0].fire_touch = -1; s[0].repair_touch = -1;
  s[0].hover = -1; s[0].press = -1; s[0].press_id = -1;
  s[0].last_phase = FIGHT; s[0].last_wave = 1;
  s[0].ally_last = g.pos[slot_of(dg_support(g))];
  track_init(s[0].track[..], "dead-gears");
  build_hull(s);
  say(s, "WAVE 1 OF 3");
}
started :: (s: [] DeadGears) { if !s[0].started { dg_page_start(s); } }

// Again: wave one, from where you started, the day back at the afternoon.
again :: (s: [] DeadGears) {
  g := game(s);
  dg_reset(g);
  s[0].pitch = f32(PITCH_REST);
  stand_at(s, v3(0, 0, 9), f32(PI));
  s[0].deck_hour = -1; s[0].clock = 0; s[0].paused = false;
  for i: 0..<FX { s[0].fx[i].life = 0; }
  g.ev[0] = 0;
  s[0].last_phase = FIGHT; s[0].last_wave = 1;
  say(s, "WAVE 1 OF 3");
  keep_save(s);
}

say :: (s: [] DeadGears, text: string) {
  s[0].toast_n = put(s[0].toast[..], 0, text);
  s[0].toast_t = 2.6;
}

// ---- the save: one line, kept at each wave and repair
//   deadgears-save 1 WAVE REPAIRS PHASE HEALTH X Z YAW MODE KILLS SUM
// X, Z and YAW in thousandths; SUM checks the rest.

save_sum :: (v: [] int) -> int {
  sum := 17;
  for i: 0..<v.count { sum = (sum * 31 + v[i] + 100000) % 999983; }
  return sum;
}
save_values :: (s: [] DeadGears) -> [9] int {
  g := game(s);
  st := g.st[0];
  v: [9] int;
  v[0] = st.wave; v[1] = st.repairs; v[2] = st.phase; v[3] = cast(int) (dg_health(g) + 0.5);
  v[4] = cast(int) (s[0].feet.x * 1000); v[5] = cast(int) (s[0].feet.z * 1000); v[6] = cast(int) (wrap_angle(s[0].yaw) * 1000);
  v[7] = st.mode; v[8] = st.kills;
  return v;
}
save_line :: (s: [] DeadGears, out: [] u8) -> int {
  v := save_values(s);
  n := put(out, 0, SAVE_TAG);
  for i: 0..<9 { n = put(out, n, " "); n = put_int(out, n, v[i]); }
  n = put(out, n, " ");
  return put_int(out, n, save_sum(v[..]));
}
keep_save :: (s: [] DeadGears) {
  if s[0].golden { return; }
  s[0].out_n = save_line(s, s[0].outbox[..]);
  s[0].action = ACT_KEEP;
  s[0].saves += 1;
}

read_int :: (text: string, at: [] int) -> int {
  i := at[0];
  while i < text.count && text[i] == 32 { i += 1; }
  neg := false;
  if i < text.count && text[i] == 45 { neg = true; i += 1; }
  v := 0; digits := 0;
  while i < text.count && text[i] >= 48 && text[i] <= 57 && digits < 9 { v = v * 10 + cast(int) (text[i] - 48); i += 1; digits += 1; }
  at[0] = ifx digits == 0 then -1 else i;
  return ifx neg then -v else v;
}

// Opens a kept line: the fight continues at the wave (or the repair, or the
// end) it was kept at. False, and nothing changed, when it isn't this
// realm's or doesn't add up.
restore :: (s: [] DeadGears, text: string) -> bool {
  started(s);
  tag := SAVE_TAG;
  if text.count < tag.count + 2 || text[0..<tag.count] != tag { return false; }
  at: [1] int; at[0] = tag.count;
  v: [9] int;
  for i: 0..<9 { v[i] = read_int(text, at[..]); if at[0] < 0 { return false; } }
  sum := read_int(text, at[..]);
  if at[0] < 0 || sum != save_sum(v[..]) { return false; }
  wave := v[0]; repairs := v[1]; phase := v[2];
  if wave < 1 || wave > 3 || repairs < 0 || repairs > 3 || phase < FIGHT || phase > LOST || v[7] < 0 || v[7] > 2 { return false; }
  x := f32(v[4]) / 1000; z := f32(v[5]) / 1000;
  if !(abs(x) < 15.6) || !(z > -23.6 && z < 13.6) { return false; }
  g := game(s);
  dg_setup(g);
  g.st[0].wave = wave - 1; g.st[0].repairs = repairs;
  start_wave(g, true);
  if phase != FIGHT {
    destroy_all(g, true, C_MUTANT);
    destroy_all(g, true, C_BOLT);
    g.st[0].phase = phase;
  }
  ecs_flush(g.e);
  g.st[0].mode = v[7]; g.st[0].kills = v[8];
  me := me_slot(g);
  g.hp[me] = clamp(f32(v[3]), 1, 100);
  stand_at(s, v3(x, 0, z), f32(v[6]) / 1000);
  g.ev[0] = 0;
  s[0].last_phase = phase; s[0].last_wave = wave; s[0].deck_hour = -1;
  s[0].restored = true;
  s[0].paused = phase == WON || phase == LOST;
  buf: [48] u8;
  n := put(buf[..], 0, "CONTINUING · WAVE ");
  n = put_int(buf[..], n, wave);
  n = put(buf[..], n, " OF 3");
  if phase == REPAIR { n = put(buf[..], 0, "CONTINUING · REPAIR THE REACTOR"); }
  say(s, cast(string) buf[0..<n]);
  return true;
}

// ---- in from the host

deadgears_message :: (s: [] DeadGears, kind: int, text: string) #export_c {
  started(s);
  if redit_message(s[0].ed[..], kind, text) { return; }
  if kind == MSG_KEPT { ok := restore(s, text); return; }
  if kind == HOST_PAGE {
    s[0].facts = true;
    url := fact_of(text, "url");
    h := query_number(url, "hour");
    if h >= 0 && h <= 24 { s[0].pinned_hour = h; }
    n := query_number(url, "spawn");
    if n > 0 { s[0].spawn_n = cast(int) lo(n, 400); }
    if fact_of(text, "coarse") == "1" { s[0].touch = true; }
    if query_number(url, "card") == 1 { s[0].card = true; }
  }
  if kind == HOST_HIDDEN { s[0].paused = true; s[0].held = 0; release_fingers(s); }
  t := track_message(s[0].track[..], kind, text);
  if kind == HOST_PAGE {
    track_world(s[0].track[..], "dead-gears");
  }
}

deadgears_golden :: (s: [] DeadGears, on: bool) #export_c { s[0].golden = on; }

leave_to :: (s: [] DeadGears, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}
deadgears_action :: (s: [] DeadGears) -> int #export_c {
  if s[0].action == 0 { e := redit_take_action(s[0].ed[..], s[0].outbox[..]); if e.kind != 0 { s[0].out_n = e.n; return e.kind; } }
  a := s[0].action; s[0].action = 0; return a;
}
deadgears_wants_text :: (s: [] DeadGears) -> bool #export_c { return redit_typing(s[0].ed[..]); }
deadgears_action_done :: (s: [] DeadGears) #export_c { s[0].out_n = 0; }

// ---- the controls

fight_over :: (s: [] DeadGears) -> bool { p := game(s).st[0].phase; return p == WON || p == LOST; }
playing :: (s: [] DeadGears) -> bool { return !s[0].paused && !fight_over(s); }

hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_FORWARD; }
  if key == 's' || key == 'S' { return HOLD_BACK; }
  if key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == KEY_SHIFT { return HOLD_RUN; }
  if key == KEY_LEFT { return HOLD_TURN_LEFT; }
  if key == KEY_RIGHT { return HOLD_TURN_RIGHT; }
  if key == KEY_UP { return HOLD_TILT_UP; }
  if key == KEY_DOWN { return HOLD_TILT_DOWN; }
  if key == 'f' || key == 'F' { return HOLD_FIRE; }
  if key == 'e' || key == 'E' { return HOLD_REPAIR; }
  if key == ' ' { return HOLD_JUMP; }
  return 0;
}

// The one-press actions (R reload, C cover, Q mode, G lift or throw, T
// stun): whether it did anything. Only the mode changes while paused.
act :: (s: [] DeadGears, button: int) -> bool {
  g := game(s);
  if !playing(s) && button != BTN_MODE { return false; }
  aim(s);
  done := false;
  if button == BTN_RELOAD { done = dg_begin_reload(g); }
  else if button == BTN_COVER { done = dg_toggle_cover(g); }
  else if button == BTN_MODE { dg_cycle_mode(g); done = true; }
  else if button == BTN_LIFT { done = dg_lift(g); }
  else if button == BTN_STUN { done = dg_stun(g); }
  heard(s, g.ev[0] - 1);
  if done && button == BTN_RELOAD { track_tally(s[0].track[..], "reload", ""); }
  if done && button == BTN_COVER { track_tally(s[0].track[..], "cover", ""); }
  if done && button == BTN_MODE { track_tally(s[0].track[..], "mode", ""); }
  return done;
}

// What the fight's events say people did, counted (analytics.coax track_tally, sent every 30 s).
DG_TALLY :: [16] string.["", "shot", "hurt", "kill", "", "", "", "", "repair", "lift", "throw", "stun", "", "", "", ""];
dg_tally :: (s: [] DeadGears, kind: int, flag: bool) {
  if kind == EV_SHOT && flag { track_tally(s[0].track[..], "hit", ""); }
  if kind < 0 || kind >= 16 { return; }
  names := DG_TALLY;
  if names[kind].count > 0 { track_tally(s[0].track[..], names[kind], ""); }
}

set_paused :: (s: [] DeadGears, on: bool) {
  if fight_over(s) { return; }
  if s[0].paused != on { track_setting(s[0].track[..], "paused", on); }
  s[0].paused = on;
  s[0].held = 0;
  release_fingers(s);
}
release_fingers :: (s: [] DeadGears) {
  s[0].move_on = false; s[0].pad_x = 0; s[0].pad_y = 0; s[0].look_on = false; s[0].drag_on = false;
  s[0].fire_touch = -1; s[0].repair_touch = -1; s[0].press = -1;
}

deadgears_key :: (s: [] DeadGears, key: int, mods: int) -> bool #export_c {
  started(s);
  track_key(s[0].track[..], key, redit_typing(s[0].ed[..]));
  used := redit_key(s[0].ed[..], key, true);
  if used > 0 { return used == 1; }
  if key == KEY_ESCAPE {
    if fight_over(s) { leave_to(s, "/verse/galaxy"); return true; }
    set_paused(s, !s[0].paused);
    return true;
  }
  if key == KEY_ENTER {
    if fight_over(s) { again(s); return true; }
    if s[0].paused { set_paused(s, false); return true; }
    return false;
  }
  if s[0].paused || fight_over(s) { return hold_bit(key) != 0; }
  if key == 'r' || key == 'R' { done := act(s, BTN_RELOAD); return true; }
  if key == 'c' || key == 'C' { done := act(s, BTN_COVER); return true; }
  if key == 'q' || key == 'Q' { done := act(s, BTN_MODE); return true; }
  if key == 'g' || key == 'G' { done := act(s, BTN_LIFT); return true; }
  if key == 't' || key == 'T' { done := act(s, BTN_STUN); return true; }
  b := hold_bit(key);
  if b == 0 { return false; }
  s[0].held = s[0].held | b;
  return true;
}

deadgears_key_up :: (s: [] DeadGears, key: int, mods: int) -> bool #export_c {
  track_key_up(s[0].track[..], key);
  if redit_key(s[0].ed[..], key, false) == 1 { return true; }
  if redit_typing(s[0].ed[..]) { return false; }
  b := hold_bit(key);
  if b == 0 { return false; }
  if s[0].held & b != 0 { s[0].held = s[0].held - b; }
  return true;
}

deadgears_blur :: (s: [] DeadGears) #export_c { s[0].held = 0; release_fingers(s); track_blur(s[0].track[..]); }

button_at :: (s: [] DeadGears, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if s[0].shown[i] && in_rect(s[0].boxes[i], x, y) { return i; } }
  return -1;
}

press :: (s: [] DeadGears, b: int) {
  if b == BTN_PAUSE { set_paused(s, !s[0].paused); }
  else if b == BTN_RESUME { set_paused(s, false); }
  else if b == BTN_AGAIN { again(s); }
  else if b == BTN_GALAXY { leave_to(s, "/verse/galaxy"); }
  else if b != BTN_FIRE { done := act(s, b); }
}

// A finger or the mouse: the buttons first (FIRE and REPAIR are held, the
// rest press on letting go over them); then a mouse drag turns the camera,
// the left half of the screen is the move stick and the right half looks.
deadgears_pointer :: (s: [] DeadGears, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  started(s);
  if redit_pointer(s[0].ed[..], x, y, phase, id) { return true; }
  k := hi(s[0].dpr, 0.5);
  b := button_at(s, x, y);
  if kind != 0 { s[0].touch = true; }
  s[0].hover = ifx kind == 0 && phase != 3 then b else -1;
  if phase == 0 {
    track_pointer(s[0].track[..], x, y, phase, kind, "");
    if b == BTN_FIRE {
      if fire_is_repair(s) { s[0].repair_touch = id; } else { s[0].fire_touch = id; }
      return true;
    }
    if b == BTN_JUMP { s[0].jump_tap = playing(s); return true; }   // a jump goes on the touch, not the let-go
    if b >= 0 { s[0].press = b; s[0].press_id = id; return true; }
    if !playing(s) { return false; }
    if kind == 0 { s[0].drag_on = true; s[0].drag_id = id; s[0].drag_x = x; s[0].drag_y = y; return true; }
    if x < s[0].width / 2 {
      if !s[0].move_on { s[0].move_on = true; s[0].move_id = id; s[0].mox = x; s[0].moy = y; s[0].pad_x = 0; s[0].pad_y = 0; }
      return true;
    }
    if !s[0].look_on { s[0].look_on = true; s[0].look_id = id; s[0].lx = x; s[0].ly = y; }
    return true;
  }
  ends := phase >= 2;
  if id == s[0].fire_touch { if ends { s[0].fire_touch = -1; } return true; }
  if id == s[0].repair_touch { if ends { s[0].repair_touch = -1; } return true; }
  if s[0].press >= 0 && id == s[0].press_id {
    if phase == 2 && b == s[0].press { press(s, b); }
    if ends { s[0].press = -1; s[0].press_id = -1; }
    return true;
  }
  if s[0].drag_on && id == s[0].drag_id {
    if phase == 1 {
      s[0].look_yaw -= (x - s[0].drag_x) / k * f32(LOOK_DRAG);
      s[0].look_pitch -= (y - s[0].drag_y) / k * f32(LOOK_DRAG);
      s[0].drag_x = x; s[0].drag_y = y;
    }
    if ends { s[0].drag_on = false; }
    return true;
  }
  if s[0].move_on && id == s[0].move_id {
    if phase == 1 {
      r := f32(STICK) * k;
      dx := (x - s[0].mox) / r; dy := (s[0].moy - y) / r;
      d := sqrt(dx * dx + dy * dy);
      if d > 1 { dx = dx / d; dy = dy / d; }
      s[0].pad_x = dx; s[0].pad_y = dy;
    }
    if ends { s[0].move_on = false; s[0].pad_x = 0; s[0].pad_y = 0; }
    return true;
  }
  if s[0].look_on && id == s[0].look_id {
    if phase == 1 {
      s[0].look_yaw -= (x - s[0].lx) / k * f32(LOOK_DRAG) * 1.2;
      s[0].look_pitch -= (y - s[0].ly) / k * f32(LOOK_DRAG) * 1.2;
      s[0].lx = x; s[0].ly = y;
    }
    if ends { s[0].look_on = false; }
    return true;
  }
  return false;
}
deadgears_cursor :: (s: [] DeadGears) -> int #export_c { return ifx s[0].hover >= 0 then 1 else 0; }

fire_is_repair :: (s: [] DeadGears) -> bool { return game(s).st[0].phase == REPAIR; }

hold_axis :: (bits: int, plus: int, minus: int) -> f32 {
  a := 0.0f32;
  if bits & plus != 0 { a += 1; }
  if bits & minus != 0 { a -= 1; }
  return a;
}

forward :: (s: [] DeadGears) -> Point { return v3(sin(s[0].yaw), 0, cos(s[0].yaw)); }
// Where the camera looks (yaw and pitch).
view_dir :: (s: [] DeadGears) -> Point {
  return v3(sin(s[0].yaw) * cos(s[0].pitch), sin(s[0].pitch), cos(s[0].yaw) * cos(s[0].pitch));
}
// The point at your shoulder the camera hangs behind: the crosshair's ray
// passes through it along view_dir(s), so a shot starts abreast of you and
// nothing behind you can take it (#84a2).
shoulder_at :: (s: [] DeadGears) -> Point {
  g := game(s);
  head := add(s[0].feet, v3(0, ifx g.st[0].cover then 1.1f32 else 1.55f32, 0));
  f := view_dir(s);
  right := unit_or(v3(-f.z, 0, f.x), v3(1, 0, 0));
  w := hi(s[0].width, 1); h := hi(s[0].height, 1);
  side := 0.72 * lo(1, w / h / 0.9);
  // Hugging cover or a wall on that side, the shoulder comes in to stay out of it.
  for k: 0..<5 {
    at := add(head, times(right, side * (1 - f32(k) * 0.25)));
    if !inside_wall(s, at, 0.12) { return at; }
  }
  return head;
}
// A point is inside (or within margin of) one of the walls you walk among.
inside_wall :: (s: [] DeadGears, p: Point, margin: f32) -> bool {
  for i: 0..<s[0].wall_n {
    k := i * 6;
    if p.x > s[0].walls[k] - margin && p.y > s[0].walls[k + 1] - margin && p.z > s[0].walls[k + 2] - margin &&
       p.x < s[0].walls[k + 3] + margin && p.y < s[0].walls[k + 4] + margin && p.z < s[0].walls[k + 5] + margin { return true; }
  }
  return false;
}
// The cutter fires along the crosshair's ray; lift and stun aim where the
// camera looks on the deck.
aim :: (s: [] DeadGears) {
  g := game(s);
  f := forward(s);
  g.input[0].aim_x = f.x; g.input[0].aim_z = f.z;
  g.input[0].ray = true;
  g.input[0].from = shoulder_at(s);
  g.input[0].dir = view_dir(s);
}

// Stands you at p facing yaw, the camera behind you (a start, Again, a save).
stand_at :: (s: [] DeadGears, p: Point, yaw: f32) {
  g := game(s);
  s[0].yaw = yaw; s[0].face = yaw;
  s[0].pl = pc.verse_player_place(p.x, p.y, p.z, yaw);
  s[0].feet = p;
  g.pos[me_slot(g)] = p; g.yaw[me_slot(g)] = yaw;
}

// What you walk among this frame (#6d99): the arena's hull, cover and
// reactor, the crates lying still; the creatures near you and the support
// engineer as capsules REACH from your middle.
gather_world :: (s: [] DeadGears) {
  g := game(s);
  n := 0;
  a := g.arena[0];
  for i: 0..<a.n {
    if n >= DG_WALLS { break; }
    b := a.boxes[i];
    put_wall(s, n, b.lo, b.hi); n += 1;
  }
  for i: 0..<ecs_high(g.e) {
    if n >= DG_WALLS { break; }
    if !ecs_match(g.e, i, C_CARGO | C_POS, 0) { continue; }
    c := g.cargo[i]; p := g.pos[i];
    if c.held || c.thrown || p.y > 0.4 { continue; }
    half := ifx c.kind == 1 then v3(0.08, 0.08, 0.55) else ifx c.kind == 2 then v3(0.22, 0.275, 0.22) else v3(0.325, 0.25, 0.3);
    put_wall(s, n, sub(p, half), add(p, half)); n += 1;
  }
  s[0].wall_n = n;
  m := 0;
  reach := f32(REACH) - f32(CHARACTER_RADIUS);
  for i: 0..<ecs_high(g.e) {
    if m >= DG_BODIES { break; }
    if i == me_slot(g) || !is_body(g.e, g.hp, i) { continue; }
    q := g.pos[i];
    if flat(q, s[0].feet) > f32(BODY_NEAR) { continue; }
    tall: f32 = ifx ecs_match(g.e, i, C_MUTANT, 0) then hi(0.7, g.mutant[i].size * 1.8) + g.mutant[i].air else 1.8f32;
    k := m * 7;
    s[0].bodies[k] = q.x; s[0].bodies[k + 1] = q.y + reach; s[0].bodies[k + 2] = q.z;
    s[0].bodies[k + 3] = q.x; s[0].bodies[k + 4] = q.y + hi(reach, tall - reach); s[0].bodies[k + 5] = q.z;
    s[0].bodies[k + 6] = reach;
    m += 1;
  }
  s[0].body_n = m;
}
put_wall :: (s: [] DeadGears, i: int, lo_: Point, hi_: Point) {
  k := i * 6;
  s[0].walls[k] = lo_.x; s[0].walls[k + 1] = lo_.y; s[0].walls[k + 2] = lo_.z;
  s[0].walls[k + 3] = hi_.x; s[0].walls[k + 4] = hi_.y; s[0].walls[k + 5] = hi_.z;
}
the_world :: (s: [] DeadGears) -> pc.World {
  w: pc.World;
  w.walls = s[0].walls[0..<s[0].wall_n * 6];
  w.bodies = s[0].bodies[0..<s[0].body_n * 7];
  return w;
}

// You walk with verse/player.coax (#6d99), as the Grid, Everglade and the
// garden do: you speed up and slow down, run, jump (Space, or JUMP on a
// phone), step onto what is low enough and stand on what you jump onto,
// among the hull, the cover, the reactor, the crates and every other
// character. Crouched at cover you move slowly and never run or jump. With
// the cutter up (fire held, or just fired) you face the crosshair and
// strafe; otherwise you turn to face the way you walk.
walk :: (s: [] DeadGears, dt: f32) {
  g := game(s);
  h := s[0].held;
  cover := g.st[0].cover;
  pad := sqrt(s[0].pad_x * s[0].pad_x + s[0].pad_y * s[0].pad_y);
  run := pc.verse_runs(h & HOLD_RUN != 0, pad > 0.8, s[0].pad_x, s[0].pad_y) && !cover;
  jump := (h & HOLD_JUMP != 0 || s[0].jump_tap) && !cover;
  s[0].jump_tap = false;
  s[0].pl = pc.verse_player_input(s[0].pl, hold_axis(h, HOLD_RIGHT, HOLD_LEFT), hold_axis(h, HOLD_FORWARD, HOLD_BACK),
                                  s[0].pad_x, s[0].pad_y, run, jump, 0, 0);
  s[0].pl.theta = wrap_angle(s[0].yaw + f32(PI));   // it walks by the camera
  s[0].pl.pace = ifx cover then f32(COVER_PACE) else 1.0f32;
  gather_world(s);
  from := s[0].feet;
  s[0].pl = pc.advance_in(the_world(s), s[0].pl, dt);
  f := pc.verse_player_feet(s[0].pl);
  if finite(f.x) && finite(f.y) && finite(f.z) { s[0].feet = v3(f.x, f.y, f.z); }
  if raised(s) { s[0].pl.face = s[0].yaw; s[0].pl.prev_face = s[0].yaw; }
  s[0].face = pc.verse_player_face(s[0].pl);
  moved := flat(from, s[0].feet);
  s[0].walking = ifx dt > 0 then moved / dt else 0.0f32;
  track_walk(s[0].track[..], cast(f64) moved);
  g.pos[me_slot(g)] = s[0].feet;
  g.yaw[me_slot(g)] = s[0].face;
}
// The cutter is up: fire held, or a shot in the last RAISED seconds.
raised :: (s: [] DeadGears) -> bool { return s[0].raised > 0 || s[0].held & HOLD_FIRE != 0 || s[0].fire_touch >= 0; }

turn_view :: (s: [] DeadGears, dt: f32) {
  h := s[0].held;
  s[0].yaw += s[0].look_yaw + hold_axis(h, HOLD_TURN_LEFT, HOLD_TURN_RIGHT) * 2.2 * dt;
  s[0].pitch = clamp(s[0].pitch + s[0].look_pitch + hold_axis(h, HOLD_TILT_UP, HOLD_TILT_DOWN) * 1.2 * dt, -0.62, 0.45);
  s[0].yaw = wrap_angle(s[0].yaw);
  s[0].look_yaw = 0; s[0].look_pitch = 0;
}

// ---- the rules' events: the flash, the toasts, the effects, the saves

effect :: (s: [] DeadGears, kind: int, at: Point, to: Point, life: f32, size: f32) {
  if !redit_row_on(s[0].ed[..], "sparks") { return; }
  i := s[0].fx_next;
  s[0].fx[i] = Fx.{kind = kind, at = at, to = to, t = 0, life = life, size = size};
  s[0].fx_next = (i + 1) % FX;
}

// Reads the event log from index from on (one action's events, or a whole
// frame's from 0).
heard :: (s: [] DeadGears, from: int) {
  g := game(s);
  first := ifx from < 0 then 0 else from;
  for i: first..<g.ev[0] {
    e := g.events[i];
    dg_tally(s, e.kind, e.flag);
    if e.kind == EV_SHOT {
      s[0].shots += 1; s[0].fire_flash = 0.1; s[0].raised = f32(RAISED);
      if e.flag { s[0].hits += 1; s[0].hit_flash = 0.18; effect(s, FX_SPARK, e.to, e.at, 0.28, 1); }
    } else if e.kind == EV_BEAMED && e.flag {
      effect(s, FX_SPARK, e.to, e.at, 0.2, 0.7);
    } else if e.kind == EV_HURT {
      s[0].hurt = hi(s[0].hurt, lo(1, 0.35 + e.amount / 25));
    } else if e.kind == EV_KILLED {
      effect(s, FX_DOWN, v3(e.at.x, 0.02, e.at.z), e.at, 0.7, 1);
    } else if e.kind == EV_WAVE {
      s[0].alarm = 4;
    } else if e.kind == EV_REPAIRED {
      r := dg_reactor_pos(g);
      effect(s, FX_FIXED, v3(r.x, 1.2, r.z), r, 1.2, 1);
    } else if e.kind == EV_LIFTED {
      effect(s, FX_LIFT, e.at, e.at, 0.6, 1);
    } else if e.kind == EV_STUNNED {
      effect(s, FX_PULSE, v3(e.at.x, 0.06, e.at.z), e.at, 0.65, 1);
    } else if e.kind == EV_CARGO_STRUCK {
      effect(s, FX_PUFF, e.at, e.at, 0.5, 1);
    } else if e.kind == EV_BOLT_STRUCK {
      if !e.flag { effect(s, FX_BURST, e.at, e.at, 0.4, 1); }
    }
  }
}

// After a frame: what changed in the fight, said in the HUD and kept.
phases :: (s: [] DeadGears) {
  g := game(s);
  st := g.st[0];
  if st.phase == s[0].last_phase && st.wave == s[0].last_wave { return; }
  buf: [48] u8;
  if st.phase == FIGHT && st.wave > 0 && (st.wave != s[0].last_wave || s[0].last_phase != FIGHT) {
    n := put(buf[..], 0, "WAVE ");
    n = put_int(buf[..], n, st.wave);
    n = put(buf[..], n, " OF 3");
    say(s, cast(string) buf[0..<n]);
    keep_save(s);
  }
  if st.phase == REPAIR && s[0].last_phase == FIGHT { say(s, "WAVE CLEAR. REPAIR THE REACTOR."); keep_save(s); }
  if st.phase == WON || st.phase == LOST {
    keep_save(s);
    if track_begin(s[0].track[..], "end") {
      track_bool(s[0].track[..], "won", st.phase == WON); track_int(s[0].track[..], "wave", st.wave);
      track_int(s[0].track[..], "kills", st.kills); track_end(s[0].track[..]);
    }
  }
  s[0].last_phase = st.phase; s[0].last_wave = st.wave;
}

// ---- the deck's hour: ?hour= holds it; otherwise each wave is fought later
// in the day (afternoon, golden hour, dusk) and the light eases between them.

deck_target :: (s: [] DeadGears) -> f32 {
  if s[0].pinned_hour >= 0 { return s[0].pinned_hour; }
  w := clamp(f32(game(s).st[0].wave), 1, 3);
  return WAVE_HOURS[cast(int) w - 1];
}
ease_hour :: (s: [] DeadGears, dt: f32) {
  target := deck_target(s);
  if s[0].deck_hour < 0 || s[0].pinned_hour >= 0 || s[0].golden { s[0].deck_hour = target; return; }
  s[0].deck_hour += (target - s[0].deck_hour) * lo(1, dt * 0.2);
}
night_level :: (hour: f32) -> f32 { return clamp((hour - 16.2) / 2.6, 0, 1); }
golden_level :: (hour: f32) -> f32 { return clamp((hour - 15.2) / 3.4, 0, 1); }

// ---- drawing: every box an object

// R = yaw (about y) * pitch (about x) * roll (about z), then the size.
push_box :: (s: [] DeadGears, pos: Point, size: Point, red: f32, green: f32, blue: f32, glow: f32, pitch: f32, yaw: f32, roll: f32) {
  n := s[0].obj_n;
  if n >= OBJECTS { s[0].dropped += 1; return; }
  s[0].obj_n = n + 1;
  cy := cos(yaw); sy := sin(yaw); cp := cos(pitch); sp := sin(pitch); cr := cos(roll); sr := sin(roll);
  m00 := cy * cr + sy * sp * sr; m01 := -cy * sr + sy * sp * cr; m02 := sy * cp;
  m10 := cp * sr; m11 := cp * cr; m12 := -sp;
  m20 := -sy * cr + cy * sp * sr; m21 := sy * sr + cy * sp * cr; m22 := cy * cp;
  o := n * OBJECT_FLOATS;
  s[0].objects[o] = m00 * size.x; s[0].objects[o + 1] = m01 * size.y; s[0].objects[o + 2] = m02 * size.z; s[0].objects[o + 3] = pos.x;
  s[0].objects[o + 4] = m10 * size.x; s[0].objects[o + 5] = m11 * size.y; s[0].objects[o + 6] = m12 * size.z; s[0].objects[o + 7] = pos.y;
  s[0].objects[o + 8] = m20 * size.x; s[0].objects[o + 9] = m21 * size.y; s[0].objects[o + 10] = m22 * size.z; s[0].objects[o + 11] = pos.z;
  s[0].objects[o + 12] = red; s[0].objects[o + 13] = green; s[0].objects[o + 14] = blue; s[0].objects[o + 15] = glow;
}
// One box this frame (colours are sRGB, as the demo's palette; the shader
// lights in linear): glow is the demo's, which the engine took as 2.2 times
// as bright.
box :: (s: [] DeadGears, pos: Point, size: Point, c: Point, glow: f32, pitch: f32, yaw: f32, roll: f32) {
  push_box(s, pos, size, c.x, c.y, c.z, glow * 2.2, pitch, yaw, roll);
}
flat_box :: (s: [] DeadGears, pos: Point, size: Point, c: Point) { push_box(s, pos, size, c.x, c.y, c.z, 0, 0, 0, 0); }
// A part of a figure: offset in the figure's own frame (turned by yaw).
limb :: (s: [] DeadGears, origin: Point, yaw: f32, offset: Point, size: Point, c: Point, glow: f32, roll: f32, pitch: f32) {
  sn := sin(yaw); cs := cos(yaw);
  at := v3(origin.x + cs * offset.x + sn * offset.z, origin.y + offset.y, origin.z - sn * offset.x + cs * offset.z);
  push_box(s, at, size, c.x, c.y, c.z, glow * 2.2, pitch, yaw, roll);
}

// A box of the hull: lit, or self-lit when it glows (a lamp).
hull_box :: (s: [] DeadGears, pos: Point, size: Point, c: Point, glow: f32) {
  lamp := glow >= 0.4;
  k := ifx lamp then lo(1, 0.45 + glow * 0.45) else 1.0f32;
  push_box(s, pos, size, c.x * k, c.y * k, c.z * k, ifx lamp then -1.0f32 else 0.0f32, 0, 0, 0);
}

// The ship around the fight, as the demo built it: floor, walls, ribs,
// lamps, the end bulkheads. Built once; the frame's things go after it.
build_hull :: (s: [] DeadGears) {
  s[0].obj_n = 0;
  hull_box(s, v3(0, -0.2, -5), v3(32, 0.4, 38), v3(0.11, 0.13, 0.16), 0);
  z := -22;
  while z < 14 {
    fz := f32(z);
    hull_box(s, v3(0, 0.006, fz), v3(31, 0.015, 0.045), v3(0.4, 0.44, 0.48), 0);
    for k: 0..<2 {
      side := ifx k == 0 then -1.0f32 else 1.0f32;
      hull_box(s, v3(side * 16, 2.8, fz), v3(0.4, 5.6, 3.95), v3(0.18, 0.21, 0.25), 0);
      hull_box(s, v3(side * 15.7, 1.3, fz), v3(0.18, 2.6, 0.24), v3(0.32, 0.35, 0.4), 0);
      hull_box(s, v3(side * 15.45, 3.8, fz), v3(0.08, 0.12, 1.8), v3(0.75, 0.8, 0.9), 1.2);
      hull_box(s, v3(side * 13.5, 0.02, fz), v3(0.08, 0.025, 2.2), v3(0.5, 0.54, 0.6), 0.45);
    }
    hull_box(s, v3(0, 5.8, fz), v3(32, 0.3, 0.25), v3(0.16, 0.19, 0.23), 0);
    z += 4;
  }
  hull_box(s, v3(0, 3, -24), v3(32, 6, 0.4), v3(0.15, 0.18, 0.22), 0);
  hull_box(s, v3(0, 3, 14), v3(32, 6, 0.4), v3(0.14, 0.17, 0.2), 0);
  for k: 0..<2 {
    side := ifx k == 0 then -1.0f32 else 1.0f32;
    hull_box(s, v3(side * 3, 2.1, 13.7), v3(0.22, 4.2, 0.2), v3(0.7, 0.73, 0.76), 0);
    hull_box(s, v3(side * 11, 2, -23.7), v3(3.2, 3.2, 0.1), v3(0.035, 0.045, 0.055), 0);
  }
  // The vents the crawlers come up from (#96d6): a dark mouth low in each side wall, slatted.
  for v: 0..<4 {
    vx := VENTS[v * 2]; vz := VENTS[v * 2 + 1];
    side := ifx vx < 0 then -1.0f32 else 1.0f32;
    hull_box(s, v3(side * 15.72, 0.36, vz), v3(0.1, 0.62, 1.2), v3(0.02, 0.025, 0.03), 0);
    for q: 0..<3 { hull_box(s, v3(side * 15.66, 0.16 + f32(q) * 0.2, vz), v3(0.05, 0.05, 1.24), v3(0.3, 0.33, 0.37), 0); }
  }
  s[0].hull_n = s[0].obj_n;
}

// Your suit and visor; the support engineer's grey suit and white visor.
SUIT :: [3] f32.[0.65, 0.68, 0.7];
ALLY_SUIT :: [3] f32.[0.37, 0.39, 0.43];
engineer :: (s: [] DeadGears, at: Point, yaw: f32, duck: bool, walking: f32, ally: bool, health: f32) {
  suit := ifx ally then v3(ALLY_SUIT[0], ALLY_SUIT[1], ALLY_SUIT[2]) else v3(SUIT[0], SUIT[1], SUIT[2]);
  black := v3(0.045, 0.055, 0.065); white := v3(0.8, 0.84, 0.9);
  visor := ifx ally then white else v3(CYAN_R, CYAN_G, CYAN_B);
  t := s[0].clock;
  h: f32 = ifx duck then 0.73f32 else 1.0f32;
  pos := at;
  pos.y += sin(t * 8) * lo(0.04, walking * 0.012);
  limb(s, pos, yaw, v3(0, 1.1 * h, 0), v3(0.58, 0.62 * h, 0.34), suit, 0, 0, 0);
  limb(s, pos, yaw, v3(0, 1.65 * h, 0), v3(0.41, 0.4, 0.4), suit, 0, 0, 0);
  limb(s, pos, yaw, v3(0, 1.68 * h, 0.21), v3(0.31, 0.12, 0.025), black, 0, 0, 0);
  limb(s, pos, yaw, v3(0, 1.67 * h, 0.23), v3(0.25, 0.035, 0.02), visor, 1, 0, 0);
  limb(s, pos, yaw, v3(0, 1.15 * h, -0.24), v3(0.34, 0.51, 0.18), black, 0, 0, 0);
  for i: 0..<4 {
    on := health > f32(3 - i) * 25;
    limb(s, pos, yaw, v3(0, 1.33 * h - f32(i) * 0.12, -0.34), v3(0.12, 0.06, 0.04), ifx on then white else v3(0.12, 0.12, 0.12), ifx on then 0.8f32 else 0.0f32, 0, 0);
  }
  for k: 0..<2 {
    side := ifx k == 0 then -1.0f32 else 1.0f32;
    stride := sin(t * 8 + side * f32(PI) * 0.5) * lo(0.18, walking * 0.04);
    limb(s, pos, yaw, v3(side * 0.19, 0.43 * h, stride), v3(0.22, 0.78 * h, 0.25), suit, 0, 0, 0);
    limb(s, pos, yaw, v3(side * 0.19, 0.09, 0.09 + stride), v3(0.25, 0.17, 0.39), black, 0, 0, 0);
    limb(s, pos, yaw, v3(side * 0.38, 1.1 * h, 0.1), v3(0.17, 0.5, 0.2), suit, 0, side * -0.15, -0.35);
  }
  flash := s[0].fire_flash > 0 && !ally;
  if flash {
    limb(s, pos, yaw, v3(0.28, 1.12 * h, 0.86), v3(0.36, 0.12, 0.14), white, 4, 0, 0);
    limb(s, pos, yaw, v3(0.28, 1.12 * h, 0.9), v3(0.08, 0.4, 0.1), white, 4, 0, 0);
  }
  limb(s, pos, yaw, v3(0.28, 1.12 * h, 0.4), v3(0.18, 0.18, 0.65), black, 0, 0, 0);
  limb(s, pos, yaw, v3(0.28, 1.12 * h, 0.74), v3(0.26, 0.04, 0.05), white, ifx flash then 3.0f32 else 0.4f32, 0, 0);
}

// A creature: the crawler, reaver, brute, skitter (a severed head or claw
// that keeps crawling) and hound, as the demo built them of boxes.
creature :: (s: [] DeadGears, kind: int, x: f32, z: f32, yaw: f32, hp: f32, m: Mutant) {
  t := s[0].clock;
  scale: f32 = ifx kind == BRUTE then 1.5f32 else ifx kind == CRAWLER then 0.7f32 else ifx kind == SKITTER then 0.36f32 else ifx kind == HOUND then 1.05f32 else 1.0f32;
  gait := ifx m.stun > 0 then sin(t * 20) * 0.06 else sin(t * (ifx m.severed then 3.0f32 else ifx kind == HOUND then 11.0f32 else 7.0f32) + x);
  origin := v3(x, m.air, z);
  flesh := ifx m.flash > 0 then v3(0.95, 0.9, 0.8) else v3(0.33 + f32(kind) * 0.015, 0.19, 0.21);
  bone := v3(0.65, 0.6, 0.54); dark := v3(0.065, 0.04, 0.05);
  if hp <= 0 {
    limb(s, origin, yaw, v3(0, 0.16, 0), v3(scale * 1.1, 0.26, scale * 0.5), dark, 0, 0, 0);
    if !m.headless { limb(s, origin, yaw, v3(0.4, 0.25, 0), v3(0.35, 0.2, 0.28), bone, 0, 0, 0); }
    return;
  }
  if kind == SKITTER {
    head := m.part == 1;
    limb(s, origin, yaw, v3(0, 0.24, 0), ifx head then v3(0.28, 0.28, 0.3) else v3(0.22, 0.16, 0.42), ifx head then bone else flesh, 0, 0, 0);
    for k: 0..<2 {
      side := ifx k == 0 then -1.0f32 else 1.0f32;
      for leg: 0..<3 {
        lz := f32(leg - 1) * 0.16;
        wave := sin(t * 17 + f32(leg) * 2 + side) * 0.07;
        limb(s, origin, yaw, v3(side * 0.23, 0.15, lz), v3(0.07, 0.3, 0.06), bone, 0, side * 0.9, wave * 3);
        limb(s, origin, yaw, v3(side * 0.34, 0.06, lz + wave), v3(0.08, 0.06, 0.18), dark, 0, 0, 0);
      }
    }
    limb(s, origin, yaw, v3(0, 0.26, 0.19), v3(0.16, 0.035, 0.025), v3(0.8, 0.45, 0.3), 1, 0, 0);
    return;
  }
  if kind == CRAWLER {
    limb(s, origin, yaw, v3(0, 0.43, 0), v3(0.65, 0.48, 0.9), flesh, 0, gait * 0.05, 0);
    limb(s, origin, yaw, v3(0, 0.59, -0.12), v3(0.5, 0.2, 0.58), bone, 0, 0, 0);
    limb(s, origin, yaw, v3(0, 0.34, 0.56), v3(0.36, 0.25, 0.35), dark, 0, 0, 0);
    for k: 0..<2 {
      side := ifx k == 0 then -1.0f32 else 1.0f32;
      limb(s, origin, yaw, v3(side * 0.24, 0.28, 0.73), v3(0.08, 0.09, 0.39), bone, 0, 0, side * 0.3);
      for leg: 0..<3 {
        if m.severed && side < 0 && leg == 0 { continue; }
        lz := f32(leg - 1) * 0.34;
        stride := sin(t * 12 + f32(leg) * 2 + side) * 0.1;
        limb(s, origin, yaw, v3(side * 0.48, 0.23, lz + stride), v3(0.09, 0.58, 0.1), bone, 0, side * 1.1, gait * 0.2);
      }
    }
    return;
  }
  if kind == HOUND {
    origin.y = ifx m.lunge > 0 then 0.18f32 else abs(gait) * 0.045;
    limb(s, origin, yaw, v3(0, 0.83, 0), v3(0.66, 0.61, 1.32), flesh, 0, 0, gait * 0.07);
    limb(s, origin, yaw, v3(0, 1.12, -0.1), v3(0.5, 0.2, 0.94), bone, 0, 0, 0);
    limb(s, origin, yaw, v3(0, 0.98, 0.8), v3(0.46, 0.48, 0.52), bone, 0, 0, -0.2);
    limb(s, origin, yaw, v3(0, 0.85, 1.12), v3(0.37, 0.25, 0.55), dark, 0, 0, 0);
    limb(s, origin, yaw, v3(0, 1.02, 1.03), v3(0.32, 0.045, 0.04), v3(0.8, 0.4, 0.25), 1, 0, 0);
    for k: 0..<2 {
      side := ifx k == 0 then -1.0f32 else 1.0f32;
      for q: 0..<2 {
        leg := ifx q == 0 then -1.0f32 else 1.0f32;
        if m.severed && side < 0 && leg < 0 { continue; }
        stride := gait * leg * side * 0.18;
        limb(s, origin, yaw, v3(side * 0.37, 0.43, leg * 0.46 + stride), v3(0.17, 0.75, 0.2), flesh, 0, side * 0.12, gait * side * leg * 0.35);
        limb(s, origin, yaw, v3(side * 0.37, 0.1, leg * 0.46 + stride + 0.13), v3(0.23, 0.12, 0.4), bone, 0, 0, 0);
      }
    }
    limb(s, origin, yaw, v3(0, 0.94, -0.96), v3(0.15, 0.18, 0.85), flesh, 0, gait * 0.25, -0.35);
    for i: 0..<4 { limb(s, origin, yaw, v3(0, 1.36, -0.45 + f32(i) * 0.25), v3(0.09, 0.42, 0.12), bone, 0, 0, -0.3); }
    return;
  }
  body_y := scale * (ifx m.severed then 0.65f32 else 1.1f32);
  limb(s, origin, yaw, v3(0, body_y, 0), v3(scale * 0.7, scale * 0.85, scale * 0.45), flesh, 0, 0, 0.18);
  if !m.headless {
    limb(s, origin, yaw, v3(0, body_y + scale * 0.6, 0.1), v3(scale * 0.38, scale * 0.44, scale * 0.4), bone, 0, gait * 0.1, 0);
    limb(s, origin, yaw, v3(0, body_y + scale * 0.63, 0.32), v3(scale * 0.3, 0.045, 0.025), v3(0.9, 0.4, 0.25), 1, 0, 0);
  }
  for k: 0..<2 {
    side := ifx k == 0 then -1.0f32 else 1.0f32;
    if !m.severed || side > 0 {
      limb(s, origin, yaw, v3(side * scale * 0.25, body_y * 0.4, gait * side * 0.13), v3(scale * 0.2, body_y * 0.8, scale * 0.22), flesh, 0, side * 0.18, gait * 0.3);
    }
    limb(s, origin, yaw, v3(side * scale * 0.58, body_y + 0.12, gait * side * 0.13), v3(scale * 0.2, scale * 0.9, scale * 0.2), flesh, 0, side * 0.65, 0);
    if !m.severed || side < 0 {
      limb(s, origin, yaw, v3(side * scale * 0.83, body_y - 0.18, 0.2), v3(0.07, scale * 0.85, 0.14), bone, 0, -side * 0.45, 0);
    }
  }
  if kind == BRUTE {
    for i: 0..<3 { q := f32(i - 1); limb(s, origin, yaw, v3(q * 0.33, body_y + 0.5, -0.33), v3(0.15, 0.85, 0.16), bone, 0, q * 0.32, -0.4); }
  }
}

// A segment as a thin glowing box (the cutter's beam, a tracer).
beam_box :: (s: [] DeadGears, a: Point, b: Point, width: f32, c: Point, glow: f32) {
  d := sub(b, a);
  l := length(d);
  if !(l > 0.01) { return; }
  yaw := atan2(d.x, d.z);
  pitch := -atan2(d.y, sqrt(d.x * d.x + d.z * d.z));
  push_box(s, times(add(a, b), 0.5), v3(width, width, l), c.x, c.y, c.z, glow, pitch, yaw, 0);
}

// This frame's things: cover, the reactor, the alarms, the engineers, the
// creatures, the cargo, the bolts, the beams and the effects.
draw_world :: (s: [] DeadGears) {
  g := game(s);
  st := g.st[0];
  t := s[0].clock;
  s[0].obj_n = s[0].hull_n;
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_COVER | C_POS, 0) { continue; }
    c := g.cover[i]; x := g.pos[i].x; z := g.pos[i].z;
    flat_box(s, v3(x, c.h * 0.5, z), v3(c.w, c.h, c.d), v3(0.3, 0.34, 0.39));
    flat_box(s, v3(x, c.h, z), v3(c.w + 0.05, 0.08, c.d + 0.05), v3(0.5, 0.53, 0.57));
    for q: 0..<3 { box(s, v3(x + f32(q - 1) * 0.55, c.h * 0.65, z + c.d * 0.51), v3(0.22, 0.16, 0.035), v3(0.75, 0.63, 0.4), 0.1, 0, 0, 0); }
  }
  r := dg_reactor_pos(g);
  flat_box(s, v3(r.x, 0.55, r.z), v3(3.8, 1.1, 2.8), v3(0.2, 0.24, 0.29));
  flat_box(s, v3(r.x, 1.2, r.z), v3(3.4, 0.3, 2.4), v3(0.11, 0.14, 0.18));
  for i: 0..<3 {
    fixed := i < st.repairs;
    flat_box(s, v3(r.x + f32(i - 1), 2, r.z), v3(0.5, 1.5, 0.5), v3(0.4, 0.45, 0.5));
    box(s, v3(r.x + f32(i - 1), 2, r.z + 0.28), v3(0.28, 1.1, 0.03), ifx fixed then v3(0.8, 0.86, 0.95) else v3(0.6, 0.22, 0.12), ifx fixed then 1.0f32 else 0.5f32 + 0.25 * sin(t * 3 + f32(i)), 0, 0, 0);
  }
  if st.phase == REPAIR {
    for i: 0..<32 {
      a := f32(i) * f32(PI) / 16;
      box(s, v3(r.x + cos(a) * 2.2, 0.025, r.z + sin(a) * 2.2), v3(0.23, 0.03, 0.11), v3(0.8, 0.85, 0.9), 0.6, 0, -a, 0);
    }
  }
  // The alarms over the far bulkhead: red strips that flash as a wave comes.
  pulse := alarm_level(s);
  for k: 0..<2 {
    if !redit_row_on(s[0].ed[..], "alarms") { break; }
    side := ifx k == 0 then -1.0f32 else 1.0f32;
    box(s, v3(side * 11, 3.7, -23.5), v3(3.1, 0.12, 0.1), v3(0.8, 0.2, 0.12), 0.35 + 0.65 * pulse, 0, 0, 0);
  }
  ally := dg_support(g);
  if ally != ECS_NONE {
    a := slot_of(ally);
    duck := s[0].ally_speed < 0.3 && ((dg_near_cover(g, g.pos[a]) && dg_alive_mutants(g) > 0) || dg_support_repairing(g));
    engineer(s, g.pos[a], g.yaw[a], duck, s[0].ally_speed, true, 100);
  }
  engineer(s, s[0].feet, s[0].face, st.cover, s[0].walking, false, dg_health(g));
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_MUTANT | C_POS | C_HEALTH, 0) { continue; }
    m := g.mutant[i];
    creature(s, m.kind, g.pos[i].x, g.pos[i].z, g.yaw[i], g.hp[i], m);
  }
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_CARGO | C_POS, 0) { continue; }
    c := g.cargo[i]; p := g.pos[i];
    spin: f32 = ifx c.held then t * 0.8 else ifx c.thrown then t * 9 else 0.0f32;
    tint := ifx c.held then v3(0.75, 0.85, 0.95) else v3(0.42, 0.47, 0.53);
    glow: f32 = ifx c.held then 0.25 + st.psi * 0.005 else 0.0f32;
    size := ifx c.kind == 1 then v3(0.16, 0.16, 1.1) else ifx c.kind == 2 then v3(0.44, 0.55, 0.44) else v3(0.65, 0.5, 0.6);
    box(s, p, size, tint, glow, spin * 0.3, spin, spin * 0.2);
    box(s, add(p, v3(0, 0.28, 0)), v3(0.27, 0.045, 0.28), v3(0.8, 0.85, 0.9), ifx c.held then 2.0f32 else 0.3f32, 0, spin, 0);
  }
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_BOLT | C_POS, 0) { continue; }
    p := g.pos[i]; v := g.vel[i];
    box(s, v3(p.x, 1, p.z), v3(0.16, 0.16, 0.4), v3(0.9, 0.4, 0.24), 2, 0, atan2(v.x, v.z), 0);
  }
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_BEAM, 0) { continue; }
    b := g.beam[i];
    fade := clamp(g.ttl[i] / 0.1, 0, 1);
    if b.ally { beam_box(s, b.from, b.to, 0.035, v3(0.7, 0.85, 1.0), 3 * fade); }
    else { beam_box(s, b.from, b.to, 0.05, v3(0.85, 0.95, 1.0), 5 * fade); }
  }
  effects(s);
}

alarm_level :: (s: [] DeadGears) -> f32 {
  if s[0].alarm <= 0 { return 0.15; }
  return 0.15 + 0.85 * (0.5 + 0.5 * sin(s[0].alarm * 9.5));
}

// The effects: sparks where the cutter hits, a puff where a crate strikes,
// a burst where a bolt does, the dark mark of a kill, the reactor's light
// when it is fixed, the stun's ring and the lift's motes.
effects :: (s: [] DeadGears) {
  g := game(s);
  for i: 0..<FX {
    f := s[0].fx[i];
    if f.life <= 0 || f.t >= f.life { continue; }
    k := f.t / f.life;
    fade := 1 - k;
    if f.kind == FX_SPARK {
      for q: 0..<5 {
        a := f32(q) * 1.256 + f32(i);
        r := k * 0.55 * f.size;
        box(s, v3(f.at.x + cos(a) * r, f.at.y + sin(a * 1.7) * r * 0.6 + k * 0.1, f.at.z + sin(a) * r), v3(0.05, 0.05, 0.05), v3(1.0, 0.85, 0.55), 4 * fade, a, a, 0);
      }
    } else if f.kind == FX_PUFF || f.kind == FX_BURST {
      c := ifx f.kind == FX_PUFF then v3(0.6, 0.62, 0.66) else v3(1.0, 0.55, 0.3);
      for q: 0..<6 {
        a := f32(q) * 1.047;
        r := k * 0.7;
        box(s, v3(f.at.x + cos(a) * r, f.at.y + k * 0.3, f.at.z + sin(a) * r), v3(0.14 * fade + 0.02, 0.14 * fade + 0.02, 0.14 * fade + 0.02), c, ifx f.kind == FX_BURST then 3 * fade else 0.0f32, a, a, 0);
      }
    } else if f.kind == FX_DOWN {
      box(s, f.at, v3(0.9 * (0.5 + k * 0.5), 0.01, 0.9 * (0.5 + k * 0.5)), v3(0.08, 0.03, 0.04), 0, 0, f32(i), 0);
    } else if f.kind == FX_FIXED {
      for q: 0..<12 {
        a := f32(q) * 0.5236;
        r := 0.4 + k * 2.5;
        box(s, v3(f.at.x + cos(a) * r, f.at.y + k * 1.5, f.at.z + sin(a) * r), v3(0.08, 0.08, 0.08), v3(0.6, 0.85, 1.0), 4 * fade, 0, a, 0);
      }
    } else if f.kind == FX_PULSE {
      for q: 0..<24 {
        a := f32(q) * 0.2618;
        r := 0.6 + k * 9;
        box(s, v3(f.at.x + cos(a) * r, 0.05, f.at.z + sin(a) * r), v3(0.3, 0.03, 0.08), v3(0.55, 0.7, 1.0), 2.5 * fade, 0, -a, 0);
      }
    } else if f.kind == FX_LIFT {
      for q: 0..<6 {
        a := f32(q) * 1.047 + k * 3;
        box(s, v3(f.at.x + cos(a) * 0.5, f.at.y + k * 0.6 - 0.2, f.at.z + sin(a) * 0.5), v3(0.04, 0.04, 0.04), v3(0.6, 0.8, 1.0), 3 * fade, 0, a, 0);
      }
    }
  }
  // Stars over a stunned head; motes round a held crate.
  for i: 0..<ecs_high(g.e) {
    if ecs_match(g.e, i, C_MUTANT | C_POS | C_HEALTH, 0) && g.mutant[i].stun > 0 && g.hp[i] > 0 {
      p := g.pos[i]; top := 1.9 * g.scale[i];
      for q: 0..<3 {
        a := s[0].clock * 4 + f32(q) * 2.094;
        box(s, v3(p.x + cos(a) * 0.3, top, p.z + sin(a) * 0.3), v3(0.07, 0.07, 0.07), v3(1.0, 0.92, 0.5), 2.5, a, a, 0);
      }
    }
    if ecs_match(g.e, i, C_CARGO | C_POS, 0) && g.cargo[i].held {
      p := g.pos[i];
      for q: 0..<4 {
        a := s[0].clock * 3 + f32(q) * 1.571;
        box(s, v3(p.x + cos(a) * 0.55, p.y + sin(a * 1.3) * 0.2, p.z + sin(a) * 0.55), v3(0.04, 0.04, 0.04), v3(0.6, 0.8, 1.0), 3, 0, a, 0);
      }
    }
  }
}

// ---- the light

add_light :: (s: [] DeadGears, u: [] f32, p: Point, radius: f32, red: f32, green: f32, blue: f32) {
  n := s[0].light_n;
  if n >= LIGHTS { return; }
  k := U_LIGHT + n * 8;
  u[k] = p.x; u[k + 1] = p.y; u[k + 2] = p.z; u[k + 3] = radius;
  u[k + 4] = red; u[k + 5] = green; u[k + 6] = blue; u[k + 7] = 0;
  s[0].light_n = n + 1;
}
add_shadow :: (s: [] DeadGears, u: [] f32, p: Point, radius: f32, strength: f32) {
  n := s[0].shadow_n;
  if n >= SHADOWS { return; }
  k := U_SHADOW + n * 4;
  u[k] = p.x; u[k + 1] = p.z; u[k + 2] = radius; u[k + 3] = strength;
  s[0].shadow_n = n + 1;
}

put3 :: (u: [] f32, at: int, a: f32, b: f32, c: f32, w: f32) { u[at] = a; u[at + 1] = b; u[at + 2] = c; u[at + 3] = w; }

// The deck's light for the shader: the sun through the roof lattice at the
// deck's hour, the sky over it, the wall strips and overhead lamps (brighter
// as night falls), the red alarms, the reactor (red until it is repaired),
// the cutter's muzzle flash, the bolts and a lifted crate; blob shadows
// where the characters stand; the covers and the reactor as boxes the sun's
// shadows test.
lights :: (s: [] DeadGears, u: [] f32) {
  g := game(s);
  st := g.st[0];
  hour := s[0].deck_hour;
  day := clamp((hour - 6) / 13, 0, 1);
  elev := sin(day * f32(PI)) * 1.08;
  az := -2.25 - (hour - 15.5) * 0.12;
  sun := v3(cos(elev) * sin(az), sin(elev), cos(elev) * cos(az));
  gold := golden_level(hour); night := night_level(hour);
  strength := 4.2 * clamp(sin(elev) * 2.6, 0, 1);
  put3(u, U_SUN, sun.x, sun.y, sun.z, strength);
  put3(u, U_SUNC, lerp(1.0, 1.0, gold), lerp(0.94, 0.6, gold), lerp(0.84, 0.34, gold), 0);
  dim := (1 - 0.75 * night) * 1.5;
  put3(u, U_SKY, lerp(0.30, 0.40, gold) * dim, lerp(0.35, 0.29, gold) * dim, lerp(0.44, 0.22, gold) * dim, 0);
  put3(u, U_GND, lerp(0.08, 0.1, gold) * dim, lerp(0.09, 0.07, gold) * dim, lerp(0.11, 0.07, gold) * dim, 0);
  put3(u, U_ZEN, lerp(0.17, 0.09, gold) * (1 - 0.6 * night), lerp(0.23, 0.1, gold) * (1 - 0.6 * night), lerp(0.32, 0.19, gold) * (1 - 0.5 * night), alarm_level(s));
  put3(u, U_HOR, lerp(0.38, 0.70, gold) * (1 - 0.55 * night), lerp(0.42, 0.40, gold) * (1 - 0.6 * night), lerp(0.47, 0.22, gold) * (1 - 0.6 * night), night);
  put3(u, U_FOG, lerp(0.05, 0.08, gold), lerp(0.06, 0.055, gold), lerp(0.075, 0.04, gold), clamp(s[0].fire_flash / 0.1, 0, 1));
  lamp := 0.45 + 0.75 * night;
  s[0].light_n = 0; s[0].shadow_n = 0;
  z := -22;
  while z < 14 {
    for k: 0..<2 {
      side := ifx k == 0 then -1.0f32 else 1.0f32;
      add_light(s, u, v3(side * 15.1, 3.8, f32(z)), 7.5, 0.5 * lamp, 0.56 * lamp, 0.68 * lamp);
    }
    z += 4;
  }
  over_lamp := 0.5 + 0.7 * night;
  for q: 0..<3 { add_light(s, u, v3(0, 5.3, -18 + f32(q) * 12), 15, 0.42 * over_lamp, 0.4 * over_lamp, 0.36 * over_lamp); }
  a := alarm_level(s);
  for k: 0..<2 { add_light(s, u, v3((ifx k == 0 then -11.0f32 else 11.0f32), 3.4, -23), 5.5 + 3 * a, 1.1 * (0.4 + a), 0.2 * (0.4 + a), 0.1 * (0.4 + a)); }
  r := dg_reactor_pos(g);
  fixed := clamp(f32(st.repairs) / 3, 0, 1);
  add_light(s, u, add(r, v3(0, 2.2, 0)), 8, 1.1 * (1 - fixed) + 0.45 * fixed, 0.32 * (1 - fixed) + 0.7 * fixed, 0.14 * (1 - fixed) + fixed);
  if s[0].fire_flash > 0 {
    f := s[0].fire_flash / 0.1;
    fw := forward(s);
    add_light(s, u, add(s[0].feet, v3(fw.x * 0.9, 1.2, fw.z * 0.9)), 7, 1.5 * f, 1.4 * f, 1.2 * f);
  }
  for i: 0..<ecs_high(g.e) {
    if ecs_match(g.e, i, C_BOLT | C_POS, 0) { add_light(s, u, v3(g.pos[i].x, 1, g.pos[i].z), 3.5, 1.4, 0.55, 0.25); }
    if ecs_match(g.e, i, C_CARGO | C_POS, 0) && g.cargo[i].held { add_light(s, u, g.pos[i], 3.5, 0.45, 0.65, 1.0); }
  }
  add_shadow(s, u, s[0].feet, 0.5, 0.55);
  ally := dg_support(g);
  if ally != ECS_NONE { add_shadow(s, u, g.pos[slot_of(ally)], 0.5, 0.55); }
  // The creatures nearest you get a shadow each.
  taken: [SHADOWS] int; nt := 0;
  while s[0].shadow_n < SHADOWS {
    best := -1; most: f32 = 1000000;
    for i: 0..<ecs_high(g.e) {
      if !alive_mutant(g, i) { continue; }
      d := flat(g.pos[i], s[0].feet);
      if d >= most { continue; }
      seen := false;
      for q: 0..<nt { if taken[q] == i { seen = true; } }
      if !seen { most = d; best = i; }
    }
    if best < 0 { break; }
    taken[nt] = best; nt += 1;
    add_shadow(s, u, g.pos[best], 0.35 + g.mutant[best].size * 0.3, 0.5);
  }
  occ := 0;
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_COVER | C_POS, 0) || occ >= OCCLUDERS - 1 { continue; }
    c := g.cover[i]; p := g.pos[i];
    k := U_OCC + occ * 8;
    put3(u, k, p.x - c.w / 2, 0, p.z - c.d / 2, 0); put3(u, k + 4, p.x + c.w / 2, c.h + 0.04, p.z + c.d / 2, 0);
    occ += 1;
  }
  k := U_OCC + occ * 8;
  put3(u, k, r.x - 1.9, 0, r.z - 1.4, 0); put3(u, k + 4, r.x + 1.9, 1.35, r.z + 1.4, 0);
  occ += 1;
  put3(u, U_INFO, f32(s[0].light_n), f32(s[0].shadow_n), f32(occ), clamp(s[0].hurt, 0, 1));
}

// ---- the camera: at your shoulder, pulled in by the hull and the cover

NEAR :: 0.05; FAR :: 100.0;
camera :: (s: [] DeadGears, w: f32, h: f32) {
  g := game(s);
  f := view_dir(s);
  at := shoulder_at(s);
  // Pulled in by the hull, cover, reactor, crates and bodies as every
  // realm's camera is (verse/player.coax camera_room), and kept over the deck.
  dist := f32(CAMERA_DIST);
  if s[0].wall_n == 0 { gather_world(s); }
  room := pc.camera_room(the_world(s), pc.v3(at.x, at.y, at.z), pc.v3(-f.x, -f.y, -f.z), dist);
  if f.y > 0.001 { room = lo(room, (at.y - f32(CAMERA_FLOOR)) / f.y); }
  back := times(f, -hi(0.05, room));
  eye := add(at, back);
  eye.x = clamp(eye.x, -15.6, 15.6); eye.z = clamp(eye.z, -23.6, 13.6);
  s[0].eye = eye; s[0].at = add(at, times(f, 4));
}

view :: (s: [] DeadGears, width: f32, height: f32, u: [] f32) {
  e := s[0].eye;
  f := unit_or(sub(s[0].at, e), v3(0, 0, -1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  aspect := width / hi(height, 1);
  fy := 1.786 * lo(1, aspect / 0.9);
  fx := fy / aspect;
  depth := f32(FAR / (FAR - NEAR));
  rows := [16] f32.[
    r.x * fx, r.y * fx, r.z * fx, -dot(r, e) * fx,
    up.x * fy, up.y * fy, up.z * fy, -dot(up, e) * fy,
    f.x * depth, f.y * depth, f.z * depth, (-dot(f, e) - f32(NEAR)) * depth,
    f.x, f.y, f.z, -dot(f, e)
  ];
  for i: 0..<16 { u[U_VIEW + i] = rows[i]; }
  // Where the horizon is on the screen (device pixels), for the sky.
  far := add(e, times(unit_or(v3(f.x, 0, f.z), v3(0, 0, -1)), 1000));
  cy := u[U_VIEW + 4] * far.x + u[U_VIEW + 5] * far.y + u[U_VIEW + 6] * far.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * far.x + u[U_VIEW + 13] * far.y + u[U_VIEW + 14] * far.z + u[U_VIEW + 15];
  u[7] = ifx cw > 0.001 then (1 - cy / cw) * 0.5 * height else 0.0f32;
}

Screen :: struct { x: f32; y: f32; ok: bool; }
on_screen :: (u: [] f32, p: Point, width: f32, height: f32) -> Screen {
  s: Screen;
  cx := u[U_VIEW] * p.x + u[U_VIEW + 1] * p.y + u[U_VIEW + 2] * p.z + u[U_VIEW + 3];
  cy := u[U_VIEW + 4] * p.x + u[U_VIEW + 5] * p.y + u[U_VIEW + 6] * p.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * p.x + u[U_VIEW + 13] * p.y + u[U_VIEW + 14] * p.z + u[U_VIEW + 15];
  s.ok = cw > 0.1;
  if !s.ok { return s; }
  s.x = (cx / cw + 1) * 0.5 * width; s.y = (1 - cy / cw) * 0.5 * height;
  return s;
}

// ---- the HUD

plate :: (s: [] DeadGears, u: [] f32, b: Rect, opacity: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  k := U_PLATE + n * 8;
  u[k] = b.x0; u[k + 1] = b.y0; u[k + 2] = b.x1; u[k + 3] = b.y1;
  u[k + 4] = opacity; u[k + 5] = look; u[k + 6] = s[0].dpr; u[k + 7] = 0;
  s[0].plate_n = n + 1;
}
phone :: (s: [] DeadGears) -> bool { return s[0].touch || s[0].width / hi(s[0].dpr, 0.5) < 700; }

words :: (s: [] DeadGears, out: [] f32, n: int, text: string, x: f32, base: f32, cap: f32, light: f32, red: f32, green: f32, blue: f32) -> int {
  return draw_text(out, n, text, x, base, cap, GAP, SPACE, ink(hi(s[0].dpr, 0.5), light, red, green, blue), false, false);
}
centred :: (s: [] DeadGears, out: [] f32, n: int, text: string, x: f32, base: f32, cap: f32, light: f32, red: f32, green: f32, blue: f32) -> int {
  return words(s, out, n, text, x - text_width(text, cap) / 2, base, cap, light, red, green, blue);
}
// A bar: its track and how full it is.
bar :: (s: [] DeadGears, out: [] f32, n: int, x: f32, y: f32, w: f32, full: f32, red: f32, green: f32, blue: f32) -> int {
  k := hi(s[0].dpr, 0.5);
  m := n;
  if lit(out, m, x, y, x + w, y, 1.2 * k, 0.18, 0, INK_R, INK_G, INK_B, 0) { m += 6; }
  f := clamp(full, 0, 1);
  if f > 0.005 && lit(out, m, x, y, x + w * f, y, 1.6 * k, 0.95, 2 * k, red, green, blue, 0) { m += 6; }
  return m;
}
hud_button :: (s: [] DeadGears, u: [] f32, out: [] f32, n: int, b: int, r: Rect, word: string, cap: f32, on: bool, ready: bool) -> int {
  s[0].boxes[b] = r; s[0].shown[b] = true;
  pressed := s[0].press == b || (b == BTN_FIRE && (s[0].fire_touch >= 0 || s[0].repair_touch >= 0));
  look: f32 = ifx on then 1.0f32 else 0.0f32;
  if s[0].hover == b || pressed { look = 2; }
  plate(s, u, r, ifx ready then 0.86f32 else 0.5f32, look);
  light: f32 = ifx ready then 0.95f32 else 0.4f32;
  return centred(s, out, n, word, (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2 + cap / 2, cap, light, INK_R, INK_G, INK_B);
}

hud_ring :: (out: [] f32, n: int, x: f32, y: f32, r: f32, k: f32, light: f32, red: f32, green: f32, blue: f32) -> int {
  m := n;
  for i: 0..<24 {
    a0 := f32(i) * f32(TAU) / 24; a1 := f32(i + 1) * f32(TAU) / 24;
    if lit(out, m, x + cos(a0) * r, y + sin(a0) * r, x + cos(a1) * r, y + sin(a1) * r, 0.8 * k, light, 1.2 * k, red, green, blue, 0) { m += 6; }
  }
  return m;
}
dot_at :: (out: [] f32, n: int, x: f32, y: f32, r: f32, k: f32, light: f32, red: f32, green: f32, blue: f32) -> int {
  if lit(out, n, x - 0.01, y, x + 0.01, y, r, light, 1.5 * k, red, green, blue, 0) { return n + 6; }
  return n;
}

// The arena as a radar: cover, the creatures, the support engineer, the
// reactor and you, your view's direction an arrow.
radar :: (s: [] DeadGears, u: [] f32, out: [] f32, n: int, r: Rect) -> int {
  g := game(s);
  k := hi(s[0].dpr, 0.5);
  plate(s, u, r, 0.7, 0);
  sx := (r.x1 - r.x0 - 12 * k) / 32; sz := (r.y1 - r.y0 - 12 * k) / 38;
  sc := lo(sx, sz);
  cx := (r.x0 + r.x1) / 2; cz := (r.y0 + r.y1) / 2;
  // Up the radar is toward the reactor (-z), right is +x; the deck's middle (z -5) at its centre.
  m := n;
  for i: 0..<ecs_high(g.e) {
    if !ecs_match(g.e, i, C_COVER | C_POS, 0) { continue; }
    c := g.cover[i]; p := g.pos[i];
    x0 := cx + (p.x - c.w / 2) * sc; x1 := cx + (p.x + c.w / 2) * sc;
    y0 := cz + (p.z - c.d / 2 + 5) * sc; y1 := cz + (p.z + c.d / 2 + 5) * sc;
    if lit(out, m, x0, (y0 + y1) / 2, x1, (y0 + y1) / 2, (y1 - y0) / 2, 0.3, 0, INK_R, INK_G, INK_B, 0) { m += 6; }
  }
  for i: 0..<ecs_high(g.e) {
    if !alive_mutant(g, i) { continue; }
    p := g.pos[i];
    m = dot_at(out, m, cx + p.x * sc, cz + (p.z + 5) * sc, 1.6 * k, k, 0.95, RED_R, RED_G, RED_B);
  }
  ally := dg_support(g);
  if ally != ECS_NONE { p := g.pos[slot_of(ally)]; m = dot_at(out, m, cx + p.x * sc, cz + (p.z + 5) * sc, 1.8 * k, k, 0.9, 0.6, 0.85, 0.6); }
  rp := dg_reactor_pos(g);
  m = hud_ring(out, m, cx + rp.x * sc, cz + (rp.z + 5) * sc, 4 * k, k, 0.8, AMBER_R, AMBER_G, AMBER_B);
  fx := cx + s[0].feet.x * sc; fz := cz + (s[0].feet.z + 5) * sc;
  f := forward(s);
  if lit(out, m, fx, fz, fx + f.x * 9 * k, fz + f.z * 9 * k, 0.9 * k, 0.95, 1.2 * k, CYAN_R, CYAN_G, CYAN_B, 0) { m += 6; }
  return dot_at(out, m, fx, fz, 2.2 * k, k, 1, CYAN_R, CYAN_G, CYAN_B);
}

mode_word :: (mode: int) -> string { return ifx mode == SEVER then "SEVER" else ifx mode == HEAD then "HEAD" else "CORE"; }

hud :: (s: [] DeadGears, u: [] f32, out: [] f32) -> int {
  g := game(s);
  st := g.st[0];
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  small := phone(s);
  gut := 16 * k;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  s[0].plate_n = 0;
  n := 0;
  in_repair := st.phase == REPAIR;
  // The fight's state, top left.
  cap := (ifx small then 10.0f32 else 12.0f32) * k;
  line_cap := (ifx small then 7.0f32 else 8.0f32) * k;
  buf: [64] u8;
  q := put(buf[..], 0, "WAVE ");
  q = put_int(buf[..], q, ifx st.wave < 1 then 1 else st.wave);
  q = put(buf[..], q, "/3 · ");
  q = put_int(buf[..], q, dg_alive_mutants(g));
  q = put(buf[..], q, " LEFT");
  wave_line := cast(string) buf[0..<q];
  at_reactor := in_repair && flat(s[0].feet, dg_reactor_pos(g)) < 3;
  objective := ifx in_repair then (ifx at_reactor then (ifx small then "HOLD REPAIR" else "HOLD E TO REPAIR") else "REPAIR THE REACTOR") else ifx st.phase == FIGHT && dg_reactor_health(g) < 100 then "DEFEND THE REACTOR" else ifx st.cover then "COVER" else "CONTAIN";
  pw := hi(hi(text_width("DEAD GEARS", cap), text_width(wave_line, line_cap)), 150 * k) + 28 * k;
  ph := cap + line_cap * 2 + 56 * k;
  top := Rect.{x0 = gut, y0 = gut, x1 = gut + pw, y1 = gut + ph};
  plate(s, u, top, 0.78, 0);
  y := top.y0 + 12 * k + cap;
  n = words(s, out, n, "DEAD GEARS", top.x0 + 14 * k, y, cap, 0.97, INK_R, INK_G, INK_B);
  y += line_cap + 10 * k;
  n = words(s, out, n, wave_line, top.x0 + 14 * k, y, line_cap, 0.85, AMBER_R, AMBER_G, AMBER_B);
  y += 12 * k;
  hp := dg_health(g);
  bw := pw - 28 * k - 34 * k;
  n = words(s, out, n, "HP", top.x0 + 14 * k, y + 3 * k, 6 * k, 0.7, INK_R, INK_G, INK_B);
  n = bar(s, out, n, top.x0 + 44 * k, y, bw, hp / 100, ifx hp < 30 then RED_R else INK_R, ifx hp < 30 then RED_G else INK_G, ifx hp < 30 then RED_B else INK_B);
  y += 13 * k;
  n = words(s, out, n, "PSI", top.x0 + 14 * k, y + 3 * k, 6 * k, 0.7, INK_R, INK_G, INK_B);
  n = bar(s, out, n, top.x0 + 44 * k, y, bw, st.psi / 100, CYAN_R, CYAN_G, CYAN_B);
  // The objective, top centre; the reactor's progress under it while repairing.
  oc := (ifx small then 7.5f32 else 9.0f32) * k;
  oy := ifx small then top.y1 + 24 * k else gut + 30 * k;
  n = centred(s, out, n, objective, w / 2, oy, oc, 0.95, ifx in_repair then AMBER_R else INK_R, ifx in_repair then AMBER_G else INK_G, ifx in_repair then AMBER_B else INK_B);
  if in_repair { n = bar(s, out, n, w / 2 - 80 * k, oy + 12 * k, 160 * k, dg_repair_progress(g), AMBER_R, AMBER_G, AMBER_B); }
  else if st.phase == FIGHT && dg_reactor_health(g) < 100 {
    // Crawlers at the reactor (#96d6): how much of it is left.
    n = bar(s, out, n, w / 2 - 80 * k, oy + 12 * k, 160 * k, dg_reactor_health(g) / 100, RED_R, RED_G, RED_B);
  }
  // PAUSE and the radar, top right.
  pb := Rect.{x0 = w - gut - 76 * k, y0 = gut, x1 = w - gut, y1 = gut + 32 * k};
  n = hud_button(s, u, out, n, BTN_PAUSE, pb, ifx s[0].paused then "RESUME" else "PAUSE", 7 * k, s[0].paused, true);
  rh := (ifx small then 96.0f32 else 150.0f32) * k;
  rw := rh * 32 / 38;
  if redit_row_on(s[0].ed[..], "radar") { n = radar(s, u, out, n, Rect.{x0 = w - gut - rw, y0 = pb.y1 + 8 * k, x1 = w - gut, y1 = pb.y1 + 8 * k + rh}); }
  // EDIT, left of PAUSE, for its owner and admins (verse/edit/edit.coax); open, the fight waits
  ew := text_width("EDIT", 9 * k) + 32 * k;
  n = redit_hud(s[0].ed[..], out, n, RBox.{x0 = pb.x0 - 8 * k - ew, y0 = gut, x1 = pb.x0 - 8 * k, y1 = gut + 32 * k});
  for i: 0..<s[0].ed[0].plate_n {
    eb := s[0].ed[0].plate_box[i];
    plate(s, u, Rect.{x0 = eb.x0, y0 = eb.y0, x1 = eb.x1, y1 = eb.y1}, s[0].ed[0].plate_alpha[i], s[0].ed[0].plate_look[i]);
  }
  // The cutter: its ammo and mode.
  ammo: [32] u8;
  a := 0;
  if st.reload > 0 { a = put(ammo[..], 0, "RELOADING"); }
  else { a = put_int(ammo[..], 0, st.ammo); a = put(ammo[..], a, " / "); a = put_int(ammo[..], a, st.reserve); }
  ammo_line := cast(string) ammo[0..<a];
  low := st.ammo <= 3 && st.reload <= 0;
  // The crosshair, and a flash when the cutter hits.
  cx := w / 2; cy := h / 2;
  ch := 7 * k;
  hit := s[0].hit_flash > 0;
  cr: f32 = ifx hit then RED_R else INK_R; cg: f32 = ifx hit then RED_G else INK_G; cbl: f32 = ifx hit then RED_B else INK_B;
  if !fight_over(s) && !s[0].paused {
    if lit(out, n, cx - ch, cy, cx - 2.5 * k, cy, 0.7 * k, 0.9, 1 * k, cr, cg, cbl, 0) { n += 6; }
    if lit(out, n, cx + 2.5 * k, cy, cx + ch, cy, 0.7 * k, 0.9, 1 * k, cr, cg, cbl, 0) { n += 6; }
    if lit(out, n, cx, cy - ch, cx, cy - 2.5 * k, 0.7 * k, 0.9, 1 * k, cr, cg, cbl, 0) { n += 6; }
    if lit(out, n, cx, cy + 2.5 * k, cx, cy + ch, 0.7 * k, 0.9, 1 * k, cr, cg, cbl, 0) { n += 6; }
  }
  // A toast over the crosshair.
  if s[0].toast_t > 0 && s[0].toast_n > 0 {
    tc := (ifx small then 8.0f32 else 11.0f32) * k;
    text := cast(string) s[0].toast[0..<s[0].toast_n];
    tw := text_width(text, tc);
    if tw > w - 2 * gut { tc = tc * (w - 2 * gut) / tw; tw = w - 2 * gut; }
    fade := clamp(s[0].toast_t / 0.5, 0, 1);
    n = centred(s, out, n, text, cx, cy - 70 * k, tc, 0.95 * fade, AMBER_R, AMBER_G, AMBER_B);
  }
  if small {
    // The thumbs' buttons, bottom right: FIRE (or REPAIR, held) and round it the rest.
    sb := 50 * k; gap := 8 * k; fb := 2 * sb + gap;
    fire := Rect.{x0 = w - gut - fb, y0 = h - gut - fb, x1 = w - gut, y1 = h - gut};
    n = hud_button(s, u, out, n, BTN_FIRE, fire, ifx in_repair then "REPAIR" else "FIRE", 10 * k, false, !fight_over(s) && (in_repair || st.ammo + st.reserve > 0));
    col := fire.x0 - gap - sb;
    n = hud_button(s, u, out, n, BTN_COVER, Rect.{x0 = col, y0 = fire.y1 - sb, x1 = col + sb, y1 = fire.y1}, "COVER", 6 * k, st.cover, true);
    jc := col - gap - sb;
    n = hud_button(s, u, out, n, BTN_JUMP, Rect.{x0 = jc, y0 = fire.y1 - sb, x1 = jc + sb, y1 = fire.y1}, "JUMP", 6 * k, false, !st.cover && s[0].pl.on_ground);
    n = hud_button(s, u, out, n, BTN_RELOAD, Rect.{x0 = col, y0 = fire.y0, x1 = col + sb, y1 = fire.y0 + sb}, "RELOAD", 5.5 * k, false, st.reload <= 0 && st.ammo < 12);
    row := fire.y0 - gap - sb;
    holding := dg_held_alive(g);
    n = hud_button(s, u, out, n, BTN_LIFT, Rect.{x0 = fire.x1 - sb, y0 = row, x1 = fire.x1, y1 = row + sb}, ifx holding then "THROW" else "LIFT", 6 * k, holding, holding || st.psi >= 15);
    n = hud_button(s, u, out, n, BTN_STUN, Rect.{x0 = fire.x1 - 2 * sb - gap, y0 = row, x1 = fire.x1 - sb - gap, y1 = row + sb}, "STUN", 6 * k, false, st.psi >= 35 && st.stun_cooldown <= 0);
    n = hud_button(s, u, out, n, BTN_MODE, Rect.{x0 = col, y0 = row, x1 = col + sb, y1 = row + sb}, mode_word(st.mode), 6 * k, st.mode != CORE, true);
    n = words(s, out, n, ammo_line, fire.x1 - text_width(ammo_line, 8 * k), row - 10 * k, 8 * k, 0.9, ifx low then RED_R else INK_R, ifx low then RED_G else INK_G, ifx low then RED_B else INK_B);
    // The move stick, where the left thumb rests.
    if s[0].move_on && playing(s) {
      r := f32(STICK) * k;
      n = hud_ring(out, n, s[0].mox, s[0].moy, r, k, 0.45, INK_R, INK_G, INK_B);
      n = dot_at(out, n, s[0].mox + s[0].pad_x * r, s[0].moy - s[0].pad_y * r, 12 * k, k, 0.8, CYAN_R, CYAN_G, CYAN_B);
    }
  } else {
    // The cutter, bottom right; the keys, bottom centre.
    ac := 13 * k;
    ab := Rect.{x0 = w - gut - 180 * k, y0 = h - gut - 64 * k, x1 = w - gut, y1 = h - gut};
    plate(s, u, ab, 0.78, 0);
    n = words(s, out, n, ammo_line, ab.x0 + 16 * k, ab.y0 + 14 * k + ac, ac, 0.95, ifx low then RED_R else INK_R, ifx low then RED_G else INK_G, ifx low then RED_B else INK_B);
    mline: [32] u8;
    mn := put(mline[..], 0, "CUTTER · ");
    mn = put(mline[..], mn, mode_word(st.mode));
    n = words(s, out, n, cast(string) mline[0..<mn], ab.x0 + 16 * k, ab.y1 - 12 * k, 7 * k, 0.8, AMBER_R, AMBER_G, AMBER_B);
    keys := ifx in_repair then "WASD MOVE · DRAG TURNS · HOLD E AT THE REACTOR TO REPAIR · ESC PAUSE" else "WASD MOVE · SPACE JUMP · DRAG TURNS · F FIRE · R RELOAD · C COVER · Q MODE · G LIFT · T STUN · ESC PAUSE";
    hs := 7 * k;
    room := ab.x0 - 2 * gut - 24 * k;
    lw := text_width(keys, hs);
    if lw > room { hs = hs * room / lw; lw = room; }
    kb := Rect.{x0 = gut, y0 = h - gut - hs - 20 * k, x1 = gut + lw + 24 * k, y1 = h - gut};
    plate(s, u, kb, 0.6, 0);
    n = words(s, out, n, keys, kb.x0 + 12 * k, kb.y1 - 10 * k, hs, 0.8, INK_R, INK_G, INK_B);
  }
  // The end, and the pause: a card with what next.
  if fight_over(s) || s[0].paused {
    won := st.phase == WON;
    title := ifx fight_over(s) then (ifx won then "SECURED" else "OVERRUN") else "PAUSED";
    sub_line := ifx fight_over(s) then (ifx won then "THE SHIP HOLDS." else "THE CRAWLERS TOOK THE SHIP.") else "THE FIGHT WAITS FOR YOU.";
    cw := lo(w - 2 * gut, 360 * k); chh := 170 * k;
    card := Rect.{x0 = w / 2 - cw / 2, y0 = h / 2 - chh / 2, x1 = w / 2 + cw / 2, y1 = h / 2 + chh / 2};
    plate(s, u, card, 0.92, 1);
    tcap := 18 * k;
    n = centred(s, out, n, title, w / 2, card.y0 + 28 * k + tcap, tcap, 1, ifx fight_over(s) && !won then RED_R else INK_R, ifx fight_over(s) && !won then RED_G else INK_G, ifx fight_over(s) && !won then RED_B else INK_B);
    n = centred(s, out, n, sub_line, w / 2, card.y0 + 70 * k + 7 * k, 7 * k, 0.85, INK_R, INK_G, INK_B);
    bw2 := (cw - 48 * k) / 2; by := card.y1 - 20 * k - 36 * k;
    first := Rect.{x0 = card.x0 + 16 * k, y0 = by, x1 = card.x0 + 16 * k + bw2, y1 = by + 36 * k};
    second := Rect.{x0 = card.x1 - 16 * k - bw2, y0 = by, x1 = card.x1 - 16 * k, y1 = by + 36 * k};
    if fight_over(s) { n = hud_button(s, u, out, n, BTN_AGAIN, first, "AGAIN", 9 * k, true, true); }
    else { n = hud_button(s, u, out, n, BTN_RESUME, first, "RESUME", 9 * k, true, true); }
    n = hud_button(s, u, out, n, BTN_GALAXY, second, "GALAXY", 9 * k, false, true);
  }
  return n;
}

// ---- the frame

coaxial_deadgears_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_deadgears_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_deadgears_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// The fight's part of a frame: the crowd ?spawn= asked for, you walking and
// looking, the rules' step, their events, the clocks and the hour.
step_fight :: (s: [] DeadGears, t: f32) {
  g := game(s);
  if s[0].facts && !s[0].spawned {
    s[0].spawned = true;
    for q: 0..<s[0].spawn_n { e := dg_spawn_mutant(g, q % TYPES, -14 + f32(q % 28), -20 + f32(q / 28) * 0.5, -1); }
  }
  run := playing(s) && !s[0].golden;
  if run {
    turn_view(s, t);
    walk(s, t);
    aim(s);
    g.input[0].firing = (s[0].held & HOLD_FIRE != 0 || s[0].fire_touch >= 0) && g.st[0].phase == FIGHT;
    g.input[0].repairing = (s[0].held & HOLD_REPAIR != 0 || s[0].repair_touch >= 0) && g.st[0].phase == REPAIR;
    ally := dg_support(g);
    before := ifx ally != ECS_NONE then g.pos[slot_of(ally)] else v3(0, 0, 0);
    dg_frame(g, t);
    heard(s, 0);
    if ally != ECS_NONE && t > 0 {
      now := g.pos[slot_of(ally)];
      s[0].ally_speed += (flat(now, before) / t - s[0].ally_speed) * lo(1, t * 10);
    }
    phases(s);
    s[0].clock += t;
    s[0].fire_flash = hi(0, s[0].fire_flash - t);
    s[0].raised = hi(0, s[0].raised - t);
    s[0].hit_flash = hi(0, s[0].hit_flash - t);
    s[0].hurt = hi(0, s[0].hurt - t * 1.6);
    s[0].alarm = hi(0, s[0].alarm - t);
    for i: 0..<FX { if s[0].fx[i].life > 0 { s[0].fx[i].t += t; if s[0].fx[i].t >= s[0].fx[i].life { s[0].fx[i].life = 0; } } }
  } else {
    s[0].held = s[0].held & (HOLD_TURN_LEFT | HOLD_TURN_RIGHT | HOLD_TILT_UP | HOLD_TILT_DOWN) ;
    s[0].look_yaw = 0; s[0].look_pitch = 0;
    s[0].walking = 0;
  }
  if !s[0].golden { s[0].toast_t = hi(0, s[0].toast_t - t); }
  ease_hour(s, t);
  if s[0].tracked_wave != g.st[0].wave && s[0].facts {
    s[0].tracked_wave = g.st[0].wave;
    if track_begin(s[0].track[..], "wave") { track_int(s[0].track[..], "wave", g.st[0].wave); track_bool(s[0].track[..], "restored", s[0].restored); track_end(s[0].track[..]); }
  }
}

// One frame: you walk and look, the rules step (unless the fight is paused,
// over or held for a golden), the events play, then the world, the light
// and the HUD are written. The fight's step is at most 0.05 s a frame: a
// stalled frame slows the fight rather than skipping it.
deadgears_frame :: (s: [] DeadGears, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  started(s);
  if u.count < UNIFORM_FLOATS || out.count < MAX_VERTICES * VERTEX_FLOATS || width < 1 || height < 1 { return 0; }
  t := ifx finite(dt) then clamp(dt, 0, 0.05) else 0.0f32;
  s[0].time += f64(t);
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = still;
  redit_start(s[0].ed[..], "dead-gears");
  redit_step(s[0].ed[..], f32(s[0].time), width, height, dpr);
  if redit_open(s[0].ed[..]) && playing(s) { set_paused(s, true); }
  step_fight(s, t);
  camera(s, width, height);
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  view(s, width, height, u);
  draw_world(s);
  lights(s, u);
  s[0].draws[0] = 0; s[0].draws[1] = cast(u32) BOX_VERTICES; s[0].draws[2] = 0; s[0].draws[3] = cast(u32) s[0].obj_n;
  u[0] = width; u[1] = height; u[2] = s[0].clock; u[3] = 1; u[4] = ifx still || s[0].golden then 1.0f32 else 0.0f32;
  u[6] = s[0].dpr;
  u[U_EYE] = s[0].eye.x; u[U_EYE + 1] = s[0].eye.y; u[U_EYE + 2] = s[0].eye.z; u[U_EYE + 3] = 0.02;
  n := 0;
  if s[0].card { s[0].plate_n = 0; } else { n = hud(s, u, out); }
  u[5] = f32(s[0].plate_n);
  track_frame(s[0].track[..], dt, width, height, dpr);
  if n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  return n;
}

deadgears_objects :: (s: [] DeadGears) -> int #export_c { return s[0].obj_n; }
deadgears_store_cap :: () -> int #export_c { return OBJECTS * OBJECT_FLOATS * 4; }

// ---- checks

frame_at :: (s: [] DeadGears, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  return deadgears_frame(s, out[..], u[..], w, h, dpr, dt, false);
}
// A check that draws many frames declares its buffers once and draws into them:
// each fresh vertex buffer is 384000 zeroed values, and the compiler bounds a
// check's aggregate traversal (E0400).
frame_in :: (out: [] f32, u: [] f32, s: [] DeadGears, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  return deadgears_frame(s, out, u, w, h, dpr, dt, false);
}

#test "the uniforms line up with deadgears.wgsl's" {
  #assert UNIFORM_FLOATS % 4 == 0 && U_LIGHT % 4 == 0 && U_SHADOW % 4 == 0 && U_OCC % 4 == 0 && U_PLATE % 4 == 0;
  #assert U_SHADOW == 380 && U_OCC == 476 && U_PLATE == 556 && UNIFORM_FLOATS == 684;
}

#test "the ship: the demo's hull, built once, then the fight's things over it" {
  s: [1] DeadGears;
  started(s[..]);
  // floor; per rib row a stripe, two walls, two posts, two lamps, two deck lights, a rib; the bulkheads, the door posts, the far doors, the vents
  #assert s[0].hull_n == 1 + 9 * 10 + 2 + 4 + 4 * 4;
  n := frame_at(s[..], 1280, 800, 1, 1.0 / 60.0);
  #assert n > 0 && s[0].obj_n > s[0].hull_n + 7 * 5 + 8 + 2 * 20 && s[0].dropped == 0;
  // You stand at (0, 9) looking down the hold at the reactor, in front of the camera.
  #assert flat(s[0].feet, v3(0, 0, 9)) < 0.01 && s[0].eye.z > 9;
  u: [UNIFORM_FLOATS] f32;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  n = deadgears_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
  r := on_screen(u[..], v3(0, 1, -17), 1280, 800);
  #assert r.ok && r.x > 0 && r.x < 1280 && r.y > 0 && r.y < 800;
  #assert u[U_INFO] >= 24 && u[U_INFO + 2] == 8;
}

#test "every creature type and the severed parts draw, and 200 more fit" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  for kind: 0..<TYPES { e := dg_spawn_mutant(g, kind, f32(kind) * 2 - 4, 0, ifx kind == SKITTER then 1 else -1); }
  i := 0;
  while i < ecs_high(g.e) { if ecs_match(g.e, i, C_MUTANT, 0) && g.mutant[i].kind == REAVER { g.mutant[i].severed = true; g.mutant[i].headless = true; } i += 1; }
  n := frame_at(s[..], 1280, 800, 1, 0.016);
  base := s[0].obj_n;
  #assert base > s[0].hull_n + 5 * 9;
  s[0].spawn_n = 200; s[0].facts = true;
  n = frame_at(s[..], 1280, 800, 1, 0.016);
  #assert dg_alive_mutants(g) >= 200 && s[0].dropped == 0 && s[0].obj_n > base + 200 * 8;
}

#test "keys: fire holds, the actions press, Escape pauses and the fight stops" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  #assert deadgears_key(s[..], 'q', 0) && g.st[0].mode == HEAD;
  #assert deadgears_key(s[..], 'f', 0);
  for i: 0..<20 { n := frame_at(s[..], 1280, 800, 1, 0.05); }
  #assert g.st[0].ammo < 12 && s[0].shots > 0;
  #assert deadgears_key_up(s[..], 'f', 0);
  #assert deadgears_key(s[..], 'r', 0) && g.st[0].reload > 0;
  #assert deadgears_key(s[..], KEY_ESCAPE, 0) && s[0].paused;
  time := g.st[0].time;
  for i: 0..<10 { n := frame_at(s[..], 1280, 800, 1, 0.05); }
  #assert g.st[0].time == time;
  #assert deadgears_key(s[..], KEY_ENTER, 0) && !s[0].paused;
  deadgears_message(s[..], HOST_HIDDEN, "");
  #assert s[0].paused;
}

#test "walking: forward goes where the camera looks, and the cover stops you" {
  s: [1] DeadGears;
  started(s[..]);
  #assert deadgears_key(s[..], 'w', 0);
  for i: 0..<20 { n := frame_at(s[..], 1280, 800, 1, 0.05); }
  #assert s[0].feet.z < 8 && abs(s[0].feet.x) < 0.01;
  // the cover at (5, 3): walk into it from the east and stop at its face
  stand_at(s[..], v3(8, 0, 3), -f32(PI) / 2);
  for i: 0..<60 { n := frame_at(s[..], 1280, 800, 1, 0.05); }
  #assert s[0].feet.x > 5 + 1.6 + 0.29;
}

#test "the shot's ray runs through the crosshair, and tilting the view moves it (#84a2)" {
  for size: 0..<2 {
    w: f32 = ifx size == 0 then 1280.0f32 else 390.0f32; h: f32 = ifx size == 0 then 800.0f32 else 844.0f32;
    s: [1] DeadGears;
    started(s[..]);
    u: [UNIFORM_FLOATS] f32;
    out: [MAX_VERTICES * VERTEX_FLOATS] f32;
    s[0].pitch = -0.3;
    n := deadgears_frame(s[..], out[..], u[..], w, h, 1, 0.016, false);
    g := game(s[..]);
    #assert g.input[0].ray;
    far := add(g.input[0].from, times(g.input[0].dir, 12));
    c := on_screen(u[..], far, w, h);
    #assert c.ok && abs(c.x - w / 2) < 1 && abs(c.y - h / 2) < 1;
    low := dg_aimed(g);
    s[0].pitch = -0.12;
    n = deadgears_frame(s[..], out[..], u[..], w, h, 1, 0.016, false);
    high := dg_aimed(g);
    #assert low.solid && low.at.z > high.at.z + 2;
  }
}

// ---- the controller (#6d99): verse/player.coax walks you

feet_speed :: (s: [] DeadGears) -> f32 { return sqrt(s[0].pl.vel.x * s[0].pl.vel.x + s[0].pl.vel.z * s[0].pl.vel.z); }

#test "walking starts and stops with acceleration, not at once" {
  s: [1] DeadGears;
  started(s[..]);
  clear_mutants(game(s[..]));
  #assert deadgears_key(s[..], 'w', 0);
  n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0);
  first := feet_speed(s[..]);
  #assert first > 0.5 && first < 4;
  for i: 0..<15 { n = frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  #assert abs(feet_speed(s[..]) - f32(pc.RUN)) < 0.05;
  #assert deadgears_key_up(s[..], 'w', 0);
  n = frame_at(s[..], 1280, 800, 1, 1.0 / 32.0);
  #assert feet_speed(s[..]) > 3 && feet_speed(s[..]) < f32(pc.RUN) - 1;
  for i: 0..<10 { n = frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  #assert feet_speed(s[..]) == 0;
}

#test "you jump onto a low crate and step off it" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  clear_mutants(g);
  g.st[0].ally_time = 1000;
  // The small crate at (-8, 6) stands 0.575 m: too high to step onto.
  stand_at(s[..], v3(-8, 0, 7.6), f32(PI));
  #assert deadgears_key(s[..], 'w', 0) && deadgears_key(s[..], KEY_SHIFT, 0);
  for i: 0..<30 { n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  #assert s[0].feet.y < 0.01 && s[0].feet.z > 6.2;   // it stops you
  #assert deadgears_key(s[..], ' ', 0);
  on_top := false;
  for i: 0..<40 {
    n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0);
    if i == 5 { #assert deadgears_key_up(s[..], ' ', 0) && deadgears_key_up(s[..], 'w', 0); }   // a short hop forward
    if abs(s[0].feet.y - 0.575) < 0.02 && abs(s[0].feet.z - 6) < 0.22 { on_top = true; }
  }
  #assert on_top;   // it stood on top of it
  // Walk on and off its far side, back to the deck.
  #assert deadgears_key(s[..], 'w', 0);
  for i: 0..<40 { n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  #assert s[0].feet.y < 0.01 && s[0].feet.z < 5.2;
}

#test "the low cover is a ledge you can jump onto" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  clear_mutants(g);
  stand_at(s[..], v3(-5, 0, 4.4), f32(PI));
  #assert deadgears_key(s[..], 'w', 0) && deadgears_key(s[..], ' ', 0);
  on_top := false;
  for i: 0..<24 {
    n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0);
    if s[0].feet.y > 1.1 && s[0].feet.z < 3.65 && s[0].feet.z > 2.35 { on_top = true; }
  }
  #assert on_top;
}

#forall "the camera never ends up inside a wall, cover or the deck" k: 0..<48 {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  clear_mutants(g);
  // Pressed against the covers, the reactor and the hull, looking every way.
  spots := [32] f32.[-5, 4, -6.9, 3, 5, 2.2, 6.9, 3.2, -8, -10.2, -9.3, -12, 0, -15.3, 15.4, 0, -15.4, -20, 0, 13.4, 3.6, -16.5, -2.9, -15.1, 0, -18.6, 2.2, -12, 7, -12, -4, -6.2];
  at := v3(spots[(k % 16) * 2], 0, spots[(k % 16) * 2 + 1]);
  stand_at(s[..], at, f32(k) * 0.79);
  s[0].pitch = ifx k % 3 == 0 then 0.45f32 else ifx k % 3 == 1 then -0.62f32 else 0.0f32;
  w: f32 = ifx k % 2 == 0 then 1280.0f32 else 390.0f32; h: f32 = ifx k % 2 == 0 then 800.0f32 else 844.0f32;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := 0;
  for f: 0..<4 { n = frame_in(out[..], u[..], s[..], w, h, 1, 1.0 / 60.0); }   // settled where it stands you
  e := s[0].eye;
  #assert !inside_wall(s[..], e, 0.02) && e.y >= f32(CAMERA_FLOOR) - 0.01;
  #assert !inside_wall(s[..], g.input[0].from, 0);
}

#test "with the cutter up you strafe facing the crosshair; with it down you face your way" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  clear_mutants(g);
  g.st[0].ally_time = 1000;
  stand_at(s[..], v3(0, 0, 9), f32(PI));
  #assert deadgears_key(s[..], 'd', 0) && deadgears_key(s[..], 'f', 0);
  for i: 0..<20 { n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  #assert s[0].feet.x > 2 && abs(s[0].feet.z - 9) < 0.05;   // sideways
  #assert abs(wrap_angle(s[0].face - s[0].yaw)) < 0.01;      // facing the crosshair
  #assert abs(wrap_angle(g.yaw[me_slot(g)] - s[0].yaw)) < 0.01;
  #assert deadgears_key_up(s[..], 'f', 0);
  for i: 0..<60 { n := frame_at(s[..], 1280, 800, 1, 1.0 / 32.0); }
  // Strafing right, now facing right (+x): yaw a quarter turn.
  #assert abs(wrap_angle(s[0].face - f32(PI) / 2)) < 0.05;
}

#test "the thumbs: the left half walks, the right half looks, FIRE holds" {
  s: [1] DeadGears;
  started(s[..]);
  n := frame_at(s[..], 1170, 2532, 3, 0.016);
  #assert s[0].shown[BTN_FIRE] && s[0].shown[BTN_STUN] && s[0].boxes[BTN_FIRE].x1 <= 1170;
  #assert deadgears_pointer(s[..], 200, 2000, 0, 1, 1);
  #assert deadgears_pointer(s[..], 200, 1800, 1, 1, 1) && s[0].pad_y > 0.9;
  yaw := s[0].yaw;
  #assert deadgears_pointer(s[..], 900, 1000, 0, 1, 2) && deadgears_pointer(s[..], 800, 1000, 1, 1, 2);
  n = frame_at(s[..], 1170, 2532, 3, 0.05);
  #assert s[0].yaw != yaw && s[0].feet.z < 9;
  f := s[0].boxes[BTN_FIRE];
  #assert deadgears_pointer(s[..], (f.x0 + f.x1) / 2, (f.y0 + f.y1) / 2, 0, 1, 3) && s[0].fire_touch == 3;
  #assert deadgears_pointer(s[..], (f.x0 + f.x1) / 2, (f.y0 + f.y1) / 2, 2, 1, 3) && s[0].fire_touch == -1;
  st := s[0].boxes[BTN_MODE];
  #assert deadgears_pointer(s[..], (st.x0 + st.x1) / 2, (st.y0 + st.y1) / 2, 0, 1, 4);
  #assert deadgears_pointer(s[..], (st.x0 + st.x1) / 2, (st.y0 + st.y1) / 2, 2, 1, 4) && game(s[..]).st[0].mode == HEAD;
}

#test "a save opens where it was kept, and another's doesn't open" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  g.st[0].wave = 1; g.st[0].repairs = 1;
  start_wave(g, true); ecs_flush(g.e);
  g.hp[me_slot(g)] = 64; stand_at(s[..], v3(2.5, 0, -3), 0); g.st[0].mode = CORE;
  out: [OUTBOX_CAP] u8;
  m := save_line(s[..], out[..]);
  line := cast(string) out[0..<m];
  next: [1] DeadGears;
  #assert restore(next[..], line);
  h := game(next[..]);
  #assert h.st[0].wave == 2 && h.st[0].repairs == 1 && h.st[0].phase == FIGHT && h.st[0].mode == CORE;
  #assert dg_health(h) == 64 && flat(next[0].feet, v3(2.5, 0, -3)) < 0.01 && dg_alive_mutants(h) == 3 + 2 * 2;
  other: [1] DeadGears;
  #assert !restore(other[..], "fixture-save 1 0 0 3");
  bad: [OUTBOX_CAP] u8;
  for i: 0..<m { bad[i] = out[i]; }
  bad[tag_end()] = 51;
  #assert !restore(other[..], cast(string) bad[0..<m]);
  #assert game(other[..]).st[0].wave == 1;
}
tag_end :: () -> int { return SAVE_TAG.count + 1; }

#test "a cleared wave says repair and keeps; Again starts over" {
  s: [1] DeadGears;
  started(s[..]);
  g := game(s[..]);
  n := frame_at(s[..], 1280, 800, 1, 0.016);
  for i: 0..<ecs_high(g.e) { if alive_mutant(g, i) { dg_hit(g, ecs_at(g.e, i), 10000); } }
  for i: 0..<5 { n = frame_at(s[..], 1280, 800, 1, 0.05); }
  #assert g.st[0].phase == REPAIR && deadgears_action(s[..]) == ACT_KEEP;
  g.st[0].phase = LOST;
  n = frame_at(s[..], 1280, 800, 1, 0.05);
  #assert fight_over(s[..]) && s[0].shown[BTN_AGAIN];
  #assert deadgears_key(s[..], KEY_ENTER, 0) && g.st[0].phase == FIGHT && g.st[0].wave == 1;
}

#test "?hour= holds the hour; otherwise each wave is later in the day" {
  s: [1] DeadGears;
  started(s[..]);
  n := frame_at(s[..], 1280, 800, 1, 0.016);
  #assert abs(s[0].deck_hour - 15.5) < 0.01;
  g := game(s[..]);
  g.st[0].wave = 3;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for i: 0..<400 { n = frame_in(out[..], u[..], s[..], 1280, 800, 1, 0.05); }
  #assert s[0].deck_hour > 18;
  #assert query_number("https://openagents.com/realms/dead-gears?hour=17.25&spawn=200", "hour") == 17.25;
  #assert query_number("https://openagents.com/realms/dead-gears?hour=17.25&spawn=200", "spawn") == 200;
  #assert query_number("https://openagents.com/realms/dead-gears?xhour=3", "hour") < 0;
  p: [1] DeadGears;
  deadgears_message(p[..], HOST_PAGE, "tab=1\nurl=https://openagents.com/realms/dead-gears?hour=18.4");
  n = frame_at(p[..], 1280, 800, 1, 0.016);
  #assert abs(p[0].deck_hour - 18.4) < 0.01 && night_level(18.4) > night_level(15.5);
}

// A player that aims at the nearest creature and holds fire, and between
// waves walks to the reactor and holds repair: through the keys on a laptop
// (F, E), through the thumbs' buttons on a phone (FIRE, REPAIR).
bot_turn :: (s: [] DeadGears) {
  g := game(s);
  best := -1; most: f32 = 1000000; clear := false;
  for i: 0..<ecs_high(g.e) {
    if !alive_mutant(g, i) { continue; }
    d := flat(g.pos[i], s[0].feet);
    from := shoulder_at(s);
    open := dg_ray(g, from, unit_or(sub(dg_part_at(g, i, 0), from), v3(0, 0, -1)), f32(SHOT_RANGE)).who == ecs_at(g.e, i);
    if (open && !clear) || (open == clear && d < most) { most = d; best = i; clear = open; }
  }
  if best >= 0 { aim_bot(s, best); }
}
// Turns the view so the crosshair is on mutant slot i's core.
aim_bot :: (s: [] DeadGears, i: int) {
  g := game(s);
  to := dg_part_at(g, i, 0);
  for k: 0..<3 {
    d := sub(to, shoulder_at(s));
    s[0].yaw = atan2(d.x, d.z);
    s[0].pitch = clamp(atan2(d.y, flat_length(d)), -0.62, 0.45);
  }
}
play_out :: (s: [] DeadGears, phone_size: bool, fight: bool, frames: int) -> int {
  g := game(s);
  w: f32 = ifx phone_size then 390.0f32 else 1280.0f32; h: f32 = ifx phone_size then 844.0f32 else 800.0f32;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := frame_in(out[..], u[..], s, w, h, 1, 0.05);
  finger := -1;
  for f: 0..<frames {
    if fight_over(s) { n = frame_in(out[..], u[..], s, w, h, 1, 0.05); return f; }
    if fight {
      b := s[0].boxes[BTN_FIRE];
      if g.st[0].phase == REPAIR {
        if flat(s[0].feet, v3(0, 0, -14.2)) > 0.5 { stand_at(s, v3(0, 0, -14.2), s[0].yaw); }
        if phone_size { if finger < 0 { used := deadgears_pointer(s, (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 1, 7); finger = 7; } }
        else { used := deadgears_key(s, 'e', 0); }
      } else {
        if finger >= 0 { used := deadgears_pointer(s, (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 2, 1, 7); finger = -1; }
        bot_turn(s);
        if phone_size { used := deadgears_pointer(s, (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 1, 8); }
        else { used := deadgears_key(s, 'f', 0); }
      }
    }
    if f % 40 == 0 { n = frame_in(out[..], u[..], s, w, h, 1, 0.05); } else { step_fight(s, 0.05); }
  }
  return frames;
}

// Three checks, one game each: a whole game is most of a check's budget.
won_through_the_controls :: (phone_size: bool) -> bool {
  s: [1] DeadGears;
  started(s[..]);
  f := play_out(s[..], phone_size, true, 6000);
  g := game(s[..]);
  return g.st[0].phase == WON && g.st[0].repairs == 3 && s[0].shown[BTN_AGAIN];
}
#test "a full game is won on a laptop" { #assert won_through_the_controls(false); }
#test "a full game is won on a phone" { #assert won_through_the_controls(true); }
#test "a full game is lost by standing still" {
  s: [1] DeadGears;
  started(s[..]);
  f := play_out(s[..], false, false, 6000);
  #assert game(s[..]).st[0].phase == LOST && s[0].shown[BTN_AGAIN];
}

#test "EDIT for its owner and admins only; the board switches the alarms and the radar off, and opening it pauses the fight" {
  s: [1] DeadGears;
  n := frame_at(s[..], 1280, 800, 1, 1.0 / 60.0);
  #assert s[0].ed[0].req_ready && cast(string) s[0].ed[0].req_url[0..<s[0].ed[0].req_url_n] == "/api/playtest/realms/dead-gears";
  objs := s[0].obj_n;
  verts := n;
  redit_requested(s[0].ed[..], 7);
  deadgears_message(s[..], HTTP_KIND + 7, "200\nrealm dead-gears\nrole visitor\nowner 0\nrow alarms 0 Flashing wave alarms\nrow radar 0 The radar\nrow sparks 1 Hit sparks\n");
  n = frame_at(s[..], 1280, 800, 1, 1.0 / 60.0);
  #assert s[0].obj_n == objs - 2 && n < verts && !s[0].ed[0].shown[RB_EDIT];   // no alarm strips, no radar; a visitor has no EDIT
  a: [1] DeadGears;
  n = frame_at(a[..], 1280, 800, 1, 1.0 / 60.0);
  redit_requested(a[0].ed[..], 6);
  deadgears_message(a[..], HTTP_KIND + 6, "200\nrealm dead-gears\nrole admin\nowner 0\nrow radar 1 The radar\nwaiting 0\n");
  n = frame_at(a[..], 1280, 800, 1, 1.0 / 60.0);
  e := a[0].ed[0].boxes[RB_EDIT];
  #assert a[0].ed[0].shown[RB_EDIT] && e.x1 < 1280 - 16 - 76 && e.x0 > 900 && !a[0].paused;
  #assert deadgears_pointer(a[..], (e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 0, 0, 1) && deadgears_pointer(a[..], (e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 2, 0, 1);
  n = frame_at(a[..], 1280, 800, 1, 1.0 / 60.0);
  #assert a[0].ed[0].pane == REDIT_BOARD && a[0].paused;
}
