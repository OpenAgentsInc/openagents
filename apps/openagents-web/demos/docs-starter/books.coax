  w_idxp := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Books — OpenAgents</title><meta name=\"description\" content=\"All nine OpenAgents books rendered directly from repository Markdown with build-time syntax highlighting and zero JavaScript.\"><link rel=\"canonical\" href=\"https://openagents.com/books\"><link rel=\"alternate\" type=\"text/markdown\" href=\"/books/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"Books\"><meta property=\"og:description\" content=\"All nine OpenAgents books rendered directly from repository Markdown with build-time syntax highlighting and zero JavaScript.\"><meta property=\"og:url\" content=\"https://openagents.com/books\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Books\"><meta name=\"twitter:description\" content=\"All nine OpenAgents books rendered directly from repository Markdown with build-time syntax highlighting and zero JavaScript.\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\"><nav class=\"st-nav bk-nav\" aria-label=\"Site navigation\"><div class=\"bk-top\"><a class=\"lk\" href=\"/\">Home</a><a class=\"lk\" href=\"/projects\">Projects</a><a class=\"lk\" href=\"/books\">Books</a></div><div class=\"bk-head\"><p class=\"bk-head-t\">OpenAgents Books</p><span class=\"meta\">57