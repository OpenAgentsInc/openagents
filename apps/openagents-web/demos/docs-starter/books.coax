// Pure-Coax static SSR book engine for docs-starter (/books and /books/<book>/<chapter>):
//   - Parses every book's SUMMARY.md through the single shared Markdown parser
//     (components/core/markdown.coax) in safe block chunks (zero competing Markdown parsing).
//   - Renders arbitrarily large Markdown chapters (80 KB–200+ KB) losslessly by chunking at
//     smd_safe_boundary and emitting block-by-block with build-time syntax highlighting
//     (components/core/syntax.coax), heading anchor IDs, and cross-chapter/cross-book link rewriting.
//   - Emits 0-KB-JS / 0-KB-Wasm HTML5 documents reusing components/skin/mono.coax CSS.
// Test natively:
//   coax/bin/coax test apps/openagents-web/demos/docs-starter/books.coax --library
#load "../../../../components/skin/mono.coax";
#load "../../../../components/ui/kit/stream_markdown.coax";
#load "../../../../components/backend/html.coax";
#load "../../../../coax/lib/encoding/json.coax";
#load "../../books-mermaid.coax";

BK_MAX_ENTRIES :: 512;
BK_TEXT_CAP :: 131072;
BK_SUM_CHUNK :: 2048;
BK_MD_CHUNK :: 16384;
BK_MD_FALLBACK :: 49152;
BK_MAX_H2 :: 64;
BK_H2_POOL :: 8192;
BK_SEARCH_MAX_H2 :: 12;
BK_META_MAX :: 320;
BK_META_ITEMS :: 4096;
BK_META_POOL :: 131072;

BK_ALERT_NONE :: 0;
BK_ALERT_NOTE :: 1;
BK_ALERT_TIP :: 2;
BK_ALERT_IMPORTANT :: 3;
BK_ALERT_WARNING :: 4;
BK_ALERT_CAUTION :: 5;

BK_BOOK_COUNT :: 9;
BK_SLUGS :: [9] string.["coax", "openagents", "bitcoin", "nostr", "coder", "psionic", "metaverse-engine", "everglade", "claude-code"];
BK_DIRS :: [9] string.["coax/book", "openagents/book", "bitcoin/book", "nostr/book", "coder/book", "psionic/book", "metaverse-engine/book", "everglade/book", "claude-code/book"];
BK_TITLES :: [9] string.[
  "The Coax Programming Language",
  "The OpenAgents Book",
  "Bitcoin From Scratch",
  "Nostr From Scratch",
  "Coder: Coding Agents From Scratch",
  "Psionic: ML From Scratch",
  "Building the OpenAgents Metaverse Engine",
  "Building Everglade",
  "Reverse Engineering Claude Code",
];
BK_DESCS :: [9] string.[
  "Programs in Coax, the language every other OpenAgents book uses.",
  "The OpenAgents apps, Bitcoin/Lightning wallet, and composable general agent.",
  "Bitcoin and Lightning in Coax, from SHA-256 and secp256k1 to channels.",
  "A Nostr client, a relay, and the NIPs OpenAgents uses, built from scratch.",
  "OpenAgents' coding agent, sandbox, harness, and lessons from other agents.",
  "A machine-learning library in Coax that runs, serves, and trains models.",
  "A real-time engine: frame loop, world, renderer, physics, realms, and multiplayer.",
  "An MMORPG on the D&D 5E SRD, built on the OpenAgents Metaverse Engine.",
  "Bottom-up reverse-engineering guide to the Claude Code 2.1.88–2.1.331 codebase.",
];

BK_INDEX_DESC :: "All nine OpenAgents books rendered directly from repository Markdown with build-time syntax highlighting and zero JavaScript.";

BK_HYBRID_CSS :: "a.row{text-decoration:none}a.row[aria-current=true]{border:1px solid var(--line-bright);background:var(--surface)}[data-frame]:not(:has(>svg.fr)){border:1px solid var(--line-dim);background:var(--surface)}.md .md-h{margin:10px 0 0;font:600 16px/1.35 var(--sans);color:#fff}.md .md-code-block{border:1px solid var(--line-dim);background:var(--surface);max-width:100%}.md .md-code-hdr{display:flex;justify-content:space-between;align-items:center;padding:5px 12px;border-bottom:1px solid var(--line-dim);font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint)}.md .md-code-copy{display:none}.md .md-pre{padding:12px 14px;overflow-x:auto;white-space:pre}.md .md-code-body{background:none;padding:0}.md .md-code-line{display:block;min-height:1.5em}.syn-com{color:var(--ink-faint);font-style:italic}.syn-kw{color:#fff;font-weight:600}.syn-fn{color:#e6e6e6}.syn-ty{color:#d4d4d4;text-decoration:underline;text-decoration-color:var(--line-dim);text-underline-offset:3px}.syn-str{color:#c8c8c8}.syn-num{color:#b8b8b8}.syn-attr{color:var(--ink-muted)}.syn-punc{color:var(--ink-faint)}.md-island-callout{border:1px solid var(--line);border-left:3px solid #fff;background:var(--surface);padding:12px 16px;display:flex;flex-direction:column;gap:4px}.md-island-title{margin:0;font:600 11px/1.4 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:#fff}.md-island-body{margin:0;color:var(--ink-muted);font-size:13px}";

BK_CSS :: ".bk-nav{width:280px;scrollbar-width:thin;scrollbar-color:var(--line-dim) transparent}.bk-top{display:flex;flex-wrap:wrap;gap:6px 12px;padding:4px 10px 10px;margin-bottom:4px;border-bottom:1px solid var(--line-dim)}.bk-head{padding:8px 10px 10px;border-bottom:1px solid var(--line-dim);display:flex;flex-direction:column;gap:3px}.bk-head-t{margin:0;font:600 14px/1.35 var(--sans);color:#fff}.bk-part{margin:14px 0 4px;padding:0 10px;font:500 10px/1.4 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint)}.bk-body{max-width:860px}.bk-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 16px;padding-bottom:12px;border-bottom:1px solid var(--line-dim)}.bk-crumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font:500 11px/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint)}.bk-crumb a{color:var(--ink-muted);text-decoration:none}.bk-crumb a:hover{color:#fff}.bk-meta-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;padding:10px 14px;border:1px solid var(--line-dim);background:var(--surface);font:12px/1.45 var(--mono);color:var(--ink-muted)}.bk-badge{display:inline-flex;align-items:center;padding:2px 8px;border:1px solid var(--line);font:600 10px/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}.bk-st-implemented{background:#fff;color:#000;border-color:#fff}.bk-st-written{border-color:#fff;color:#fff}.bk-st-partly{border-color:var(--line);color:var(--ink)}.bk-st-draft{border-style:dashed;border-color:var(--line);color:var(--ink-muted)}.bk-meta-item{display:inline-flex;align-items:baseline;gap:6px;min-width:0;max-width:100%}.bk-meta-k{font:500 10px/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint)}.bk-meta-v{color:var(--ink);overflow-wrap:anywhere}.bk-meta-adopted{flex:1 0 100%;display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;padding-top:6px;border-top:1px solid var(--line-dim)}.bk-meta-a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--line-dim);font:12px/1.4 var(--mono)}.bk-meta-a:hover{color:#fff;border-bottom-color:#fff}.bk-ontoc{border:1px solid var(--line-dim);background:var(--surface);padding:10px 14px}.bk-ontoc-s{cursor:pointer;font:500 11px/1.4 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-muted);list-style:none}.bk-ontoc-s::-webkit-details-marker{display:none}.bk-ontoc-s::before{content:'+ ';color:var(--ink-faint)}.bk-ontoc-d[open] .bk-ontoc-s::before{content:'- '}.bk-ontoc-l{margin:10px 0 2px;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:5px 16px}.bk-ontoc-l a{color:var(--ink-muted);text-decoration:none;font:13px/1.4 var(--sans);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bk-ontoc-l a:hover{color:#fff}.bk-alert{border:1px solid var(--line-dim);border-left:3px solid var(--line);background:var(--surface);padding:12px 16px;display:flex;flex-direction:column;gap:8px}.bk-alert-t{margin:0;font:600 11px/1.4 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:#fff}.bk-alert .md-quote-p{color:var(--ink)}.bk-alert-tip{border-left:3px dashed var(--line-bright)}.bk-alert-important{border-color:var(--line);border-left:3px solid #fff}.bk-alert-warning{border-color:var(--line);border-left:4px double #fff;background:var(--raised)}.bk-alert-caution{border-color:#fff;border-left:4px solid #fff;background:var(--raised)}.bk-mermaid-wrap{margin:4px 0;padding:12px;border:1px solid var(--line-dim);background:var(--surface);overflow-x:auto}.bk-mermaid{display:block;max-width:100%;height:auto;margin:0 auto;font-family:var(--mono)}.bk-idx-acts{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.bk-pager{display:flex;justify-content:space-between;gap:16px;padding-top:24px;margin-top:8px;border-top:1px solid var(--line-dim)}.bk-pg{display:flex;flex-direction:column;gap:3px;padding:10px 14px;border:1px solid var(--line-dim);text-decoration:none;color:var(--ink);max-width:48%;transition:border-color .15s,background .15s}.bk-pg:hover{border-color:var(--line-bright);background:var(--surface)}.bk-pg-next{margin-left:auto;text-align:right}.bk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}.bk-card{display:flex;flex-direction:column;gap:8px;padding:16px 18px;border:1px solid var(--line-dim);background:var(--surface);text-decoration:none;color:var(--ink);transition:border-color .15s}.bk-card:hover{border-color:var(--line-bright)}.bk-card-t{margin:0;font:600 15px/1.35 var(--sans);color:#fff}.bk-card-d{margin:0;color:var(--ink-muted);font-size:13px;line-height:1.5}.md h1.md-h{font-size:26px;line-height:1.25;margin:2px 0 8px}.md h2.md-h{font-size:19px;margin:18px 0 4px;padding-top:10px;border-top:1px solid var(--line-dim)}.md h3.md-h{font-size:15px;margin:12px 0 2px}.md hr.md-hr{border:0;border-top:1px solid var(--line-dim);margin:14px 0}.md table{display:block;overflow-x:auto;max-width:100%}@media (max-width:1060px){.bk-nav{width:auto;max-height:42vh;flex-direction:column;flex-wrap:nowrap;overflow-y:auto}}";

// Joins a directory and non-empty child segment with '/', or returns `dir` when `child` is empty.
// Returns "" if the combined path does not fit in `out`.
bk_join_path :: (dir: string, child: string, out: [] u8) -> string {
  if child.count == 0 { return dir; }
  need := dir.count + child.count + 1;
  if need > out.count { return ""; }
  n := bk_copy_str(out, 0, dir);
  out[n] = '/';
  n += 1;
  n = bk_copy_str(out, n, child);
  return cast(string) out[0..<n];
}

// Parses CLI arguments for books-build: empty selects `def_out`, `--out DIR` overrides it, else "".
bk_resolve_out :: (argv: [] string, def_out: string) -> string {
  if argv.count == 0 { return def_out; }
  if argv.count == 2 && argv[0] == "--out" { return argv[1]; }
  return "";
}

// Writes the shared `/books/mono.css` stylesheet (components/skin/mono.coax + syntax + book layout).
// Returns total bytes written, or -1 if `out` is too small for the full stylesheet.
bk_write_mono_css :: (out: [] u8) -> int {
  n := mono_button_css(out, mono_page_css(out, mono_set_css(out, mono_css(out))));
  if n + BK_HYBRID_CSS.count + BK_CSS.count > out.count { return -1; }
  n = mc(out, n, BK_HYBRID_CSS);
  return mc(out, n, BK_CSS);
}

BkEntry :: struct {
  is_part: bool;
  is_external: bool;
  title_at: int; title_n: int;
  file_at: int; file_n: int;
  slug_at: int; slug_n: int;
  href_at: int; href_n: int;
  note_at: int; note_n: int;
}

BkToc :: struct {
  entries: [BK_MAX_ENTRIES] BkEntry;
  n: int;
  chapters: int;
  text: [BK_TEXT_CAP] u8;
  tn: int;
  overflow: bool;
}

bk_starts :: (s: string, pfx: string) -> bool {
  return s.count >= pfx.count && cast(string) s[0..<pfx.count] == pfx;
}

bk_ends :: (s: string, suf: string) -> bool {
  return s.count >= suf.count && cast(string) s[s.count - suf.count..<s.count] == suf;
}

bk_is_known_book :: (slug: string) -> bool {
  slugs := BK_SLUGS;
  for k: 0..<BK_BOOK_COUNT { if slugs[k] == slug { return true; } }
  return false;
}

bk_pool_add :: (toc: [] BkToc, s: string) -> int {
  at := toc[0].tn;
  for c: s {
    if toc[0].tn >= BK_TEXT_CAP { toc[0].overflow = true; break; }
    toc[0].text[toc[0].tn] = c;
    toc[0].tn += 1;
  }
  return at;
}

bk_pool_str :: (toc: [] BkToc, at: int, n: int) -> string {
  if n < 1 || at < 0 || at + n > toc[0].tn { return ""; }
  return cast(string) toc[0].text[at..<at + n];
}

bk_entry_title :: (toc: [] BkToc, i: int) -> string { return bk_pool_str(toc, toc[0].entries[i].title_at, toc[0].entries[i].title_n); }
bk_entry_file :: (toc: [] BkToc, i: int) -> string { return bk_pool_str(toc, toc[0].entries[i].file_at, toc[0].entries[i].file_n); }
bk_entry_slug :: (toc: [] BkToc, i: int) -> string { return bk_pool_str(toc, toc[0].entries[i].slug_at, toc[0].entries[i].slug_n); }
bk_entry_href :: (toc: [] BkToc, i: int) -> string { return bk_pool_str(toc, toc[0].entries[i].href_at, toc[0].entries[i].href_n); }
bk_entry_note :: (toc: [] BkToc, i: int) -> string { return bk_pool_str(toc, toc[0].entries[i].note_at, toc[0].entries[i].note_n); }

bk_copy_str :: (out: [] u8, at: int, s: string) -> int {
  n := at;
  for c: s {
    if n >= out.count { break; }
    out[n] = c;
    n += 1;
  }
  return n;
}

// Rewrites book-internal and cross-book Markdown links to site URLs (or GitHub repo links).
// Blocks unsafe schemes (javascript:, data:) by returning "".
bk_rewrite_href :: (book_slug: string, raw: string, out: [] u8) -> string {
  if raw.count == 0 { return ""; }
  if raw[0] == '#' || bk_starts(raw, "https://") || bk_starts(raw, "http://") {
    n := bk_copy_str(out, 0, raw);
    return cast(string) out[0..<n];
  }
  if raw[0] == '/' {
    if raw.count >= 2 && (raw[1] == '/' || raw[1] == '\\') { return ""; }
    n := bk_copy_str(out, 0, raw);
    return cast(string) out[0..<n];
  }
  hash := raw.count;
  for i: 0..<raw.count { if raw[i] == '#' { hash = i; break; } } // mutant: equivalent (raw[0]=='#' already returned above)
  base := cast(string) raw[0..<hash];
  frag := cast(string) raw[hash..<raw.count];
  for i: 0..<base.count {
    if base[i] == ':' { return ""; }
    if base[i] == '/' { break; }
  }
  if bk_starts(base, "./") { base = cast(string) base[2..<base.count]; }

  // Cross-book link: ../../<other>/book/<rest> -> /books/<other>[/<slug>][#frag] for top-level .md pages,
  // otherwise GitHub blob URL for non-Markdown/nested files (e.g. check-structure.py).
  if bk_starts(base, "../../") {
    rest := cast(string) base[6..<base.count];
    sl := 0;
    while sl < rest.count && rest[sl] != '/' { sl += 1; }
    after := cast(string) rest[sl..<rest.count];
    other := cast(string) rest[0..<sl];
    if bk_is_known_book(other) && bk_starts(after, "/book/") {
      tail := cast(string) after[6..<after.count];
      tail_slash := false;
      for c: tail { if c == '/' { tail_slash = true; break; } }
      if tail.count == 0 || tail == "README.md" || tail == "SUMMARY.md" || (!tail_slash && bk_ends(tail, ".md")) {
        n := bk_copy_str(out, 0, "/books/");
        n = bk_copy_str(out, n, other);
        if tail != "README.md" && tail != "SUMMARY.md" && bk_ends(tail, ".md") {
          n = bk_copy_str(out, n, "/");
          n = bk_copy_str(out, n, cast(string) tail[0..<tail.count - 3]);
        }
        n = bk_copy_str(out, n, frag);
        return cast(string) out[0..<n];
      }
    }
    n := bk_copy_str(out, 0, "https://github.com/OpenAgentsInc/openagents/blob/main/");
    n = bk_copy_str(out, n, rest);
    n = bk_copy_str(out, n, frag);
    return cast(string) out[0..<n];
  }

  // Parent-of-book link: ../<rel> -> GitHub blob under <book_slug>/<rel>
  if bk_starts(base, "../") {
    rel := cast(string) base[3..<base.count];
    n := bk_copy_str(out, 0, "https://github.com/OpenAgentsInc/openagents/blob/main/");
    n = bk_copy_str(out, n, book_slug);
    n = bk_copy_str(out, n, "/");
    n = bk_copy_str(out, n, rel);
    n = bk_copy_str(out, n, frag);
    return cast(string) out[0..<n];
  }

  // Same-book Markdown link: README.md, SUMMARY.md, or ch01-foo.md -> /books/<book_slug>[/<slug>][#frag]
  has_slash := false;
  for c: base { if c == '/' { has_slash = true; break; } }
  if !has_slash && bk_ends(base, ".md") {
    n := bk_copy_str(out, 0, "/books/");
    n = bk_copy_str(out, n, book_slug);
    if base != "README.md" && base != "SUMMARY.md" {
      n = bk_copy_str(out, n, "/");
      n = bk_copy_str(out, n, cast(string) base[0..<base.count - 3]);
    }
    n = bk_copy_str(out, n, frag);
    return cast(string) out[0..<n];
  }
  // Same-book non-Markdown or nested file (e.g. chapters.json, examples/foo.coax) -> GitHub blob URL.
  if base.count > 0 && base[0] != '\\' && !bk_starts(base, "..") {
    n := bk_copy_str(out, 0, "https://github.com/OpenAgentsInc/openagents/blob/main/");
    n = bk_copy_str(out, n, book_slug);
    n = bk_copy_str(out, n, "/book/");
    n = bk_copy_str(out, n, base);
    n = bk_copy_str(out, n, frag);
    return cast(string) out[0..<n];
  }
  return "";
}

// Strips leading dash/em-dash separator from a SUMMARY.md trailing status note (" — planned" -> "planned").
bk_clean_note :: (raw: string) -> string {
  s := smd_trim(raw);
  if s.count >= 3 && s[0] == 0xe2 && s[1] == 0x80 && s[2] == 0x94 {
    s = smd_trim(cast(string) s[3..<s.count]);
  } else if bk_starts(s, "--") {
    s = smd_trim(cast(string) s[2..<s.count]);
  } else if s.count >= 1 && s[0] == '-' {
    s = smd_trim(cast(string) s[1..<s.count]);
  }
  return s;
}

// Next safe byte cut in `src` starting from `pos`, bounded by `limit` (falling back to `fallback` or newline).
bk_next_cut :: (src: string, pos: int, limit: int, fallback: int) -> int {
  win := pos + limit;
  if win >= src.count { return src.count; }
  cut := smd_safe_boundary(cast(string) src[0..<win], pos); // mutant: equivalent (smd_safe_boundary scans from pos)
  if cut > pos { return cut; }
  win2 := pos + fallback;
  if win2 >= src.count { return src.count; }
  cut2 := smd_safe_boundary(cast(string) src[0..<win2], pos); // mutant: equivalent (smd_safe_boundary scans from pos)
  if cut2 > pos { return cut2; }
  e := md_line_end(src, win2);
  return ifx e < src.count then e + 1 else src.count;
}

bk_toc_push_part :: (toc: [] BkToc, text: string) {
  t := smd_trim(text);
  if t.count == 0 { return; }
  if toc[0].n >= BK_MAX_ENTRIES { toc[0].overflow = true; return; }
  at := bk_pool_add(toc, t);
  toc[0].entries[toc[0].n] = BkEntry.{is_part = true, title_at = at, title_n = toc[0].tn - at};
  toc[0].n += 1;
}

// Parses a book's SUMMARY.md into `toc` using components/core/markdown.coax (single parser rule).
bk_parse_summary :: (toc: [] BkToc, book_slug: string, src: string, doc: [] MdDoc) -> int {
  toc[0].n = 0;
  toc[0].chapters = 0;
  toc[0].tn = 0;
  toc[0].overflow = false;
  pos := 0;
  hbuf: [512] u8;
  tbuf: [512] u8;
  while pos < src.count {
    cut := bk_next_cut(src, pos, BK_SUM_CHUNK, BK_SUM_CHUNK * 3); // mutant: equivalent (safe boundary chunking is invariant to 1-byte limit shifts)
    seg := cast(string) src[pos..<cut];
    pos = cut;
    doc[0] = MdDoc.{};
    _ = md_parse(doc, seg, 0); // mutant: equivalent (part tag is unused by bk_parse_summary)
    for b: 0..<doc[0].nb {
      blk := doc[0].blocks[b];
      if blk.heading == 2 || blk.heading == 3 {
        bk_toc_push_part(toc, md_block_text(doc, b));
      } else if blk.kind == MB_PARA && blk.heading == 0 {
        runs := md_block_runs(doc, b);
        if runs.count == 1 && runs[0].style == MD_BOLD && (runs[0].marks & MD_LINK) == 0 {
          bk_toc_push_part(toc, md_block_text(doc, b));
        }
      } else if blk.kind == MB_LIST {
        for k: 0..<blk.items {
          if toc[0].n >= BK_MAX_ENTRIES { toc[0].overflow = true; break; }
          idx := blk.item0 + k;
          itext := md_item_text(doc, idx);
          runs := md_item_runs(doc, idx);
          for r: 0..<runs.count {
            if (runs[r].marks & MD_LINK) == 0 { continue; }
            lr := runs[r];
            title := smd_trim(cast(string) itext[lr.from..<lr.to]);
            target := smd_trim(md_link(doc, lr));
            note := bk_clean_note(cast(string) itext[lr.to..<itext.count]);
            if title.count == 0 || target.count == 0 { break; }

            clean_target := ifx bk_starts(target, "./") then cast(string) target[2..<target.count] else target;
            has_slash := false;
            for c: clean_target { if c == '/' { has_slash = true; break; } }
            is_local := !has_slash && bk_ends(clean_target, ".md");
            href := bk_rewrite_href(book_slug, target, hbuf[..]);
            if href.count == 0 { break; }

            display_title := title;
            if !is_local {
              pfx := smd_trim(cast(string) itext[0..<lr.from]);
              if pfx.count > 0 {
                tn := bk_copy_str(tbuf[..], 0, pfx);
                tn = bk_copy_str(tbuf[..], tn, " ");
                tn = bk_copy_str(tbuf[..], tn, title);
                display_title = cast(string) tbuf[0..<tn];
              }
            }

            ent := BkEntry.{is_external = !is_local};
            ent.title_at = bk_pool_add(toc, display_title);
            ent.title_n = toc[0].tn - ent.title_at;
            ent.href_at = bk_pool_add(toc, href);
            ent.href_n = toc[0].tn - ent.href_at;
            if is_local {
              ent.file_at = bk_pool_add(toc, clean_target);
              ent.file_n = toc[0].tn - ent.file_at;
              slug := ifx clean_target == "README.md" then "" else cast(string) clean_target[0..<clean_target.count - 3];
              ent.slug_at = bk_pool_add(toc, slug);
              ent.slug_n = toc[0].tn - ent.slug_at;
              toc[0].chapters += 1;
            }
            ent.note_at = bk_pool_add(toc, note);
            ent.note_n = toc[0].tn - ent.note_at;
            toc[0].entries[toc[0].n] = ent;
            toc[0].n += 1;
            break;
          }
        }
      }
    }
  }
  return toc[0].chapters;
}

// Lowercase URL-safe heading anchor slug ("Building the compiler" -> "building-the-compiler").
bk_heading_slug :: (text: string, out: [] u8) -> string {
  n := 0;
  prev_dash := true;
  for c: text {
    if n >= out.count { break; }
    if c >= 'A' && c <= 'Z' {
      out[n] = c + 32; n += 1; prev_dash = false;
    } else if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
      out[n] = c; n += 1; prev_dash = false;
    } else if !prev_dash && (c == ' ' || c == '-' || c == '_' || c == '.' || c == '/') {
      out[n] = '-'; n += 1; prev_dash = true;
    }
  }
  while n > 0 && out[n - 1] == '-' { n -= 1; } // mutant: equivalent (prev_dash starts true so out[0] is never '-')
  return cast(string) out[0..<n];
}

// Maps code fence language to syntax.coax language ID, treating "jai" listings in coax/book as Coax.
bk_lang_id :: (lang: string) -> int {
  if lang == "jai" { return SYN_LANG_COAX; }
  return smd_lang_id(lang);
}

// Emits a syntax-highlighted code block directly into HtBuf (handles arbitrarily long listings with 0 Tree nodes).
bk_emit_code_html :: (b: [] HtBuf, lang: string, code: string) {
  ht_put(b, "<div class=\"md-code-block\"");
  if lang.count > 0 {
    ht_put(b, " data-lang=\"");
    ht_escape_attr(b, lang);
    ht_put_u8(b, '"');
  }
  ht_put(b, "><div class=\"md-code-hdr\"><span class=\"md-code-lang\">");
  ht_escape_text(b, ifx lang.count > 0 then lang else "text");
  ht_put(b, "</span></div><pre class=\"md-pre\"><code class=\"md-code-body\">");

  syn_lang := bk_lang_id(lang);
  if syn_lang == SYN_LANG_PLAIN {
    ht_escape_text(b, code);
  } else {
    blk_state: [1] int;
    runs: [64] MdRun;
    i := 0;
    while i <= code.count {
      e := md_line_end(code, i);
      line := cast(string) code[i..<e];
      ht_put(b, "<span class=\"md-code-line\">");
      nr := syn_tokenize_line_state(syn_lang, line, blk_state[..], runs[..]);
      pos := 0;
      for k: 0..<nr {
        ht_escape_text(b, cast(string) line[pos..<runs[k].from]);
        cls := smd_syn_class(runs[k].style);
        if cls == "syn-plain" {
          ht_escape_text(b, cast(string) line[runs[k].from..<runs[k].to]);
        } else {
          ht_put(b, "<span class=\"");
          ht_put(b, cls);
          ht_put(b, "\">");
          ht_escape_text(b, cast(string) line[runs[k].from..<runs[k].to]);
          ht_put(b, "</span>");
        }
        pos = runs[k].to;
      }
      ht_escape_text(b, cast(string) line[pos..<line.count]);
      ht_put(b, "</span>");
      if e >= code.count { break; } // mutant: equivalent (when e == code.count, i = e + 1 exits while i <= code.count)
      i = e + 1;
    }
  }
  ht_put(b, "</code></pre></div>");
}

// GitHub-style alert callout detection (`[!NOTE]`, `[!TIP]`, `[!IMPORTANT]`, `[!WARNING]`, `[!CAUTION]`).
BkAlert :: struct {
  kind: int;
  skip: int;
  cls: string;
  label: string;
}

bk_alert_info :: (text: string) -> BkAlert {
  a := 0;
  while a < text.count && text[a] == ' ' { a += 1; }
  rem := cast(string) text[a..<text.count];
  tags := [5] string.["[!NOTE]", "[!TIP]", "[!IMPORTANT]", "[!WARNING]", "[!CAUTION]"];
  classes := [5] string.[
    "bk-alert bk-alert-note",
    "bk-alert bk-alert-tip",
    "bk-alert bk-alert-important",
    "bk-alert bk-alert-warning",
    "bk-alert bk-alert-caution",
  ];
  labels := [5] string.["NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION"];
  for k: 0..<5 {
    tg := tags[k];
    if bk_starts(rem, tg) && (rem.count == tg.count || rem[tg.count] == ' ') {
      sk := a + tg.count;
      while sk < text.count && text[sk] == ' ' { sk += 1; }
      return BkAlert.{kind = k + 1, skip = sk, cls = classes[k], label = labels[k]};
    }
  }
  return BkAlert.{};
}

// Emits inline Markdown runs into Tree `t` starting at byte offset `skip`, rewriting book links.
bk_emit_runs_from :: (t: [] Tree, doc: [] MdDoc, book_slug: string, base_id: string, text: string, runs: [] MdRun, skip: int) {
  if skip >= text.count { return; }
  if runs.count == 0 {
    id_buf: [128] u8;
    _ = tr_leaf(t, tr_cat(id_buf[..], base_id, ".t"), TG_SPAN, "", cast(string) text[skip..<text.count]);
    return;
  }
  hbuf: [512] u8;
  for k: 0..<runs.count {
    r := runs[k];
    rf := ifx r.from < skip then skip else r.from; // mutant: equivalent (when r.from == skip, both branches equal skip)
    if r.to <= rf || r.to > text.count { continue; }
    seg := cast(string) text[rf..<r.to];
    id_buf: [128] u8; p_buf: [128] u8;
    rid := tr_join(id_buf[..], tr_cat(p_buf[..], base_id, ".r."), k);
    if (r.marks & MD_LINK) != 0 {
      raw_href := md_link(doc, r);
      href := bk_rewrite_href(book_slug, raw_href, hbuf[..]);
      a := tr_leaf(t, rid, TG_A, "md-link", seg);
      if href.count > 0 { tr_attr(t, a, AT_HREF, href); } // bk_rewrite_href guarantees URL safety; ht_render_node re-checks ht_url_safe
    } else if r.style == MD_CODE {
      _ = tr_leaf(t, rid, TG_CODE, "md-code", seg);
    } else if r.style == MD_BOLD {
      _ = tr_leaf(t, rid, TG_STRONG, "", seg);
    } else if (r.marks & MD_STRIKE) != 0 {
      _ = tr_leaf(t, rid, TG_DEL, "", seg);
    } else if (r.marks & MD_ITALIC) != 0 {
      _ = tr_leaf(t, rid, TG_EM, "", seg);
    } else {
      _ = tr_leaf(t, rid, TG_SPAN, "", seg);
    }
  }
}

bk_emit_runs :: (t: [] Tree, doc: [] MdDoc, book_slug: string, base_id: string, text: string, runs: [] MdRun) {
  bk_emit_runs_from(t, doc, book_slug, base_id, text, runs, 0);
}

bk_is_html_comment :: (text: string) -> bool {
  s := smd_trim(text);
  return bk_starts(s, "<!--") && bk_ends(s, "-->");
}

bk_flush_tree :: (hb: [] HtBuf, t: [] Tree) {
  for i: 0..<t[0].n {
    if t[0].nodes[i].parent < 0 { ht_render_node(hb, t, i, 0); } // mutant: equivalent (block trees are 1..4 levels deep, well below TR_DEPTH)
  }
}

// Renders one block `b` from parsed `doc` into `hb`, resetting Tree per block so TR_NODES never overflows.
bk_render_block_html :: (hb: [] HtBuf, doc: [] MdDoc, b: int, t: [] Tree, book_slug: string, seq: int) -> int {
  if hb[0].overflow { return seq; }
  p1: [128] u8; p2: [128] u8; p3: [128] u8; sbuf: [96] u8;
  blk := doc[0].blocks[b];
  bid := tr_join(p1[..], "b.", seq);

  if blk.kind == MB_CODE {
    lang := md_lang(doc, b);
    code := md_block_text(doc, b);
    ik := smd_island_kind(lang);
    if ik != SMD_ISLAND_NONE {
      tr_begin(t);
      smd_render_island(t, bid, ik, code);
      bk_flush_tree(hb, t);
    } else if lang == "mermaid" && mm_render_svg(hb, code, bid) {
      // Pure-Coax build-time Mermaid SVG emitted directly into hb
    } else {
      bk_emit_code_html(hb, lang, code);
    }
    return seq + 1;
  }

  if blk.kind == MB_PARA && blk.heading == 0 && bk_is_html_comment(md_block_text(doc, b)) {
    return seq + 1;
  }

  if blk.kind == MB_QUOTE && blk.items > 0 { // mutant: equivalent (empty quote reads zero-initialized item "" -> BK_ALERT_NONE)
    al := bk_alert_info(md_item_text(doc, blk.item0));
    if al.kind != BK_ALERT_NONE {
      ht_put(hb, "<aside id=\"");
      ht_escape_attr(hb, bid);
      ht_put(hb, "\" class=\"");
      ht_put(hb, al.cls);
      ht_put(hb, "\" role=\"note\"><p class=\"bk-alert-t\">");
      ht_put(hb, al.label);
      ht_put(hb, "</p>");
      for k: 0..<blk.items {
        itxt := md_item_text(doc, blk.item0 + k);
        sk := ifx k == 0 then al.skip else 0;
        if sk >= itxt.count { continue; }
        qid := tr_join(p2[..], tr_cat(p3[..], bid, ".q."), k);
        tr_begin(t);
        _ = tr_open(t, qid, TG_P, "md-quote-p");
        bk_emit_runs_from(t, doc, book_slug, qid, itxt, md_item_runs(doc, blk.item0 + k), sk);
        tr_close(t);
        bk_flush_tree(hb, t);
      }
      ht_put(hb, "</aside>");
      return seq + 1;
    }
  }

  tr_begin(t);
  if blk.kind == MB_RULE {
    _ = tr_open(t, bid, TG_HR, "md-hr");
    tr_close(t);
  } else if blk.kind == MB_LIST {
    _ = tr_open(t, bid, ifx blk.ordered then TG_OL else TG_UL, "md-list");
    for k: 0..<blk.items {
      item := doc[0].items[blk.item0 + k];
      iid := tr_join(p2[..], tr_cat(p3[..], bid, ".i."), k);
      li := tr_open(t, iid, TG_LI, "md-li");
      if item.task != MD_TASK_NONE {
        tr_attr(t, li, AT_CHECKED, ifx item.task == MD_TASK_DONE then "true" else "false");
      }
      bk_emit_runs(t, doc, book_slug, iid, md_item_text(doc, blk.item0 + k), md_item_runs(doc, blk.item0 + k));
      tr_close(t);
    }
    tr_close(t);
  } else if blk.kind == MB_QUOTE {
    _ = tr_open(t, bid, TG_BLOCKQUOTE, "md-quote");
    for k: 0..<blk.items {
      qid := tr_join(p2[..], tr_cat(p3[..], bid, ".q."), k);
      _ = tr_open(t, qid, TG_P, "md-quote-p");
      bk_emit_runs(t, doc, book_slug, qid, md_item_text(doc, blk.item0 + k), md_item_runs(doc, blk.item0 + k));
      tr_close(t);
    }
    tr_close(t);
  } else if blk.kind == MB_TABLE {
    _ = tr_open(t, bid, TG_TABLE, "md-table");
    rows := md_table_rows(doc, b);
    for r: 0..<rows {
      rid := tr_join(p2[..], tr_cat(p3[..], bid, ".tr."), r);
      _ = tr_open(t, rid, TG_TR, "");
      for c: 0..<blk.cols {
        idx := blk.item0 + r * blk.cols + c;
        cbuf: [128] u8; cpbuf: [128] u8;
        cid := tr_join(cbuf[..], tr_cat(cpbuf[..], rid, ".c."), c);
        _ = tr_open(t, cid, ifx r == 0 then TG_TH else TG_TD, "");
        bk_emit_runs(t, doc, book_slug, cid, md_item_text(doc, idx), md_item_runs(doc, idx));
        tr_close(t);
      }
      tr_close(t);
    }
    tr_close(t);
  } else {
    tag := ifx blk.heading > 0 then smd_heading_tag(blk.heading) else TG_P;
    hid := bid;
    if blk.heading > 0 {
      sl := bk_heading_slug(md_block_text(doc, b), sbuf[..]);
      if sl.count > 0 { hid = sl; }
    }
    _ = tr_open(t, hid, tag, ifx blk.heading > 0 then "md-h" else "md-p");
    bk_emit_runs(t, doc, book_slug, bid, md_block_text(doc, b), md_block_runs(doc, b));
    tr_close(t);
  }
  bk_flush_tree(hb, t);
  return seq + 1;
}

// Renders one parsed MdDoc into HtBuf block-by-block.
bk_render_doc_html :: (hb: [] HtBuf, doc: [] MdDoc, t: [] Tree, book_slug: string, seq0: int) -> int {
  seq := seq0;
  for b: 0..<doc[0].nb {
    if hb[0].overflow { break; }
    seq = bk_render_block_html(hb, doc, b, t, book_slug, seq);
  }
  return seq;
}

// Renders arbitrarily large Markdown `src` into HTML inside `out`, chunking safely at block boundaries.
bk_render_md_html :: (src: string, book_slug: string, doc: [] MdDoc, t: [] Tree, out: [] u8) -> int {
  hb := [1] HtBuf.[HtBuf.{bytes = out}];
  pos := 0;
  seq := 0;
  while pos < src.count && !hb[0].overflow {
    cut := bk_next_cut(src, pos, BK_MD_CHUNK, BK_MD_FALLBACK); // mutant: equivalent (safe boundary chunking is invariant to 1-byte limit shifts)
    seg := cast(string) src[pos..<cut];
    pos = cut;
    doc[0] = MdDoc.{};
    doc[0].keep_rules = true;
    _ = md_parse(doc, seg, 0); // mutant: equivalent (part tag is unused by bk_render_doc_html)
    seq = bk_render_doc_html(hb[..], doc, t, book_slug, seq);
  }
  return ifx hb[0].overflow then -1 else hb[0].n;
}

bk_put_int :: (hb: [] HtBuf, val: int) {
  buf: [32] u8;
  ht_put(hb, tr_join(buf[..], "", val));
}

// Finds previous/next local chapter entry index around `cur` in `toc`, or -1.
bk_prev_chapter :: (toc: [] BkToc, cur: int) -> int {
  i := cur - 1;
  while i >= 0 {
    if !toc[0].entries[i].is_part && !toc[0].entries[i].is_external { return i; }
    i -= 1;
  }
  return -1;
}

bk_next_chapter :: (toc: [] BkToc, cur: int) -> int {
  i := cur + 1;
  while i < toc[0].n {
    if !toc[0].entries[i].is_part && !toc[0].entries[i].is_external { return i; }
    i += 1;
  }
  return -1;
}

// Emits canonical, raw-Markdown alternate, and Open Graph / Twitter metadata into `<head>`.
// Trailing newline guarantees coax/web/og.ts finds a safe insertion boundary if ever run.
bk_emit_meta :: (hb: [] HtBuf, title: string, desc: string, path: string) {
  ht_put(hb, "<meta name=\"description\" content=\"");
  ht_escape_attr(hb, desc);
  ht_put(hb, "\"><link rel=\"canonical\" href=\"https://openagents.com");
  ht_escape_attr(hb, path);
  ht_put(hb, "\"><link rel=\"alternate\" type=\"text/markdown\" href=\"");
  ht_escape_attr(hb, path);
  ht_put(hb, "/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">");
  ht_put(hb, "<meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"");
  ht_escape_attr(hb, title);
  ht_put(hb, "\"><meta property=\"og:description\" content=\"");
  ht_escape_attr(hb, desc);
  ht_put(hb, "\"><meta property=\"og:url\" content=\"https://openagents.com");
  ht_escape_attr(hb, path);
  ht_put(hb, "\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\">");
  ht_put(hb, "<meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"");
  ht_escape_attr(hb, title);
  ht_put(hb, "\"><meta name=\"twitter:description\" content=\"");
  ht_escape_attr(hb, desc);
  ht_put(hb, "\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n");
}

// ---- In-page h2 "On this page" TOC, chapters.json metadata banner, and static search index

BkH2 :: struct {
  title_at: int; title_n: int;
  slug_at: int; slug_n: int;
}

BkHeadings :: struct {
  items: [BK_MAX_H2] BkH2;
  n: int;
  pool: [BK_H2_POOL] u8;
  pn: int;
}

bk_h2_pool_add :: (hs: [] BkHeadings, s: string) -> int {
  at := hs[0].pn;
  for c: s {
    if hs[0].pn >= BK_H2_POOL { break; }
    hs[0].pool[hs[0].pn] = c;
    hs[0].pn += 1;
  }
  return at;
}

bk_h2_str :: (hs: [] BkHeadings, at: int, n: int) -> string {
  if n < 1 || at < 0 || at + n > hs[0].pn { return ""; }
  return cast(string) hs[0].pool[at..<at + n];
}

bk_h2_title :: (hs: [] BkHeadings, i: int) -> string { return bk_h2_str(hs, hs[0].items[i].title_at, hs[0].items[i].title_n); }
bk_h2_slug :: (hs: [] BkHeadings, i: int) -> string { return bk_h2_str(hs, hs[0].items[i].slug_at, hs[0].items[i].slug_n); }

// Collects all h2 headings from chapter Markdown using the single shared Markdown parser.
bk_collect_h2 :: (hs: [] BkHeadings, src: string, doc: [] MdDoc) -> int {
  hs[0].n = 0;
  hs[0].pn = 0;
  pos := 0;
  sbuf: [96] u8;
  while pos < src.count {
    cut := bk_next_cut(src, pos, BK_MD_CHUNK, BK_MD_FALLBACK); // mutant: equivalent (safe boundary chunking is invariant to 1-byte limit shifts)
    seg := cast(string) src[pos..<cut];
    pos = cut;
    doc[0] = MdDoc.{};
    _ = md_parse(doc, seg, 0); // mutant: equivalent (part tag unused)
    for b: 0..<doc[0].nb {
      if hs[0].n >= BK_MAX_H2 { return hs[0].n; }
      blk := doc[0].blocks[b];
      if blk.kind == MB_PARA && blk.heading == 2 {
        title := smd_trim(md_block_text(doc, b));
        slug := bk_heading_slug(title, sbuf[..]);
        if slug.count > 0 && hs[0].pn + title.count + slug.count <= BK_H2_POOL {
          t_at := bk_h2_pool_add(hs, title);
          t_n := hs[0].pn - t_at;
          s_at := bk_h2_pool_add(hs, slug);
          s_n := hs[0].pn - s_at;
          hs[0].items[hs[0].n] = BkH2.{title_at = t_at, title_n = t_n, slug_at = s_at, slug_n = s_n};
          hs[0].n += 1;
        }
      }
    }
  }
  return hs[0].n;
}

// Emits collapsible 0-KB-JS "On this page" h2 TOC when a chapter has >= 2 h2 headings.
bk_emit_ontoc :: (hb: [] HtBuf, hs: [] BkHeadings) {
  if hs[0].n < 2 { return; }
  ht_put(hb, "<aside class=\"bk-ontoc\" aria-label=\"On this page\"><details class=\"bk-ontoc-d\" open><summary class=\"bk-ontoc-s\">On this page (");
  bk_put_int(hb, hs[0].n);
  ht_put(hb, ")</summary><ol class=\"bk-ontoc-l\">");
  for i: 0..<hs[0].n {
    ht_put(hb, "<li><a href=\"#");
    ht_escape_attr(hb, bk_h2_slug(hs, i));
    ht_put(hb, "\">");
    ht_escape_text(hb, bk_h2_title(hs, i));
    ht_put(hb, "</a></li>");
  }
  ht_put(hb, "</ol></details></aside>");
}

BkSpan :: struct { at: int; n: int; }

BkChMeta :: struct {
  file: BkSpan;
  status: BkSpan;
  profile: BkSpan;
  qt0: int; qt_n: int;
  ad0: int; ad_n: int;
}

BkBookMeta :: struct {
  entries: [BK_META_MAX] BkChMeta;
  n: int;
  items: [BK_META_ITEMS] BkSpan;
  ni: int;
  pool: [BK_META_POOL] u8;
  pn: int;
}

bk_meta_pool_add :: (m: [] BkBookMeta, s: string) -> BkSpan {
  at := m[0].pn;
  if s.count == 0 || at + s.count > BK_META_POOL { return BkSpan.{at = at, n = 0}; }
  for c: s {
    m[0].pool[m[0].pn] = c;
    m[0].pn += 1;
  }
  return BkSpan.{at = at, n = s.count};
}

bk_meta_str :: (m: [] BkBookMeta, sp: BkSpan) -> string {
  if sp.n < 1 || sp.at < 0 || sp.at + sp.n > m[0].pn { return ""; }
  return cast(string) m[0].pool[sp.at..<sp.at + sp.n];
}

bk_meta_read_str :: (m: [] BkBookMeta, raw: string) -> BkSpan {
  ubuf: [1024] u8;
  un := json_unescape(raw, ubuf[..]);
  if un < 0 { return BkSpan.{}; } // mutant: equivalent (when un == 0, bk_meta_pool_add also returns empty span n == 0)
  return bk_meta_pool_add(m, cast(string) ubuf[0..<un]);
}

// Parses a book's `chapters.json` using the shared streaming JSON parser (coax/lib/encoding/json.coax).
bk_parse_chapters_json :: (m: [] BkBookMeta, src: string) -> int {
  m[0].n = 0;
  m[0].ni = 0;
  m[0].pn = 0;
  j: [1] Json;
  json_start(j[..], src);
  if json_next(j[..]) != JSON_OBJECT { return 0; }
  while true {
    t := json_next(j[..]);
    if t != JSON_STRING { break; }
    is_ch := json_is(json_text(j[..]), "chapters");
    vt := json_next(j[..]);
    if !is_ch || vt != JSON_ARRAY {
      if !json_skip(j[..]) { break; }
      continue;
    }
    while true {
      et := json_next(j[..]);
      if et == JSON_ARRAY_END { break; }
      if et != JSON_OBJECT {
        if !json_skip(j[..]) { break; }
        continue;
      }
      ch := BkChMeta.{};
      qt_tmp: [16] BkSpan; qt_c := 0;
      ad_tmp: [32] BkSpan; ad_c := 0;
      while true {
        kt := json_next(j[..]);
        if kt != JSON_STRING { break; }
        kraw := json_text(j[..]);
        fvt := json_next(j[..]);
        if json_is(kraw, "file") && fvt == JSON_STRING {
          ch.file = bk_meta_read_str(m, json_text(j[..]));
        } else if json_is(kraw, "status") && fvt == JSON_STRING {
          ch.status = bk_meta_read_str(m, json_text(j[..]));
        } else if json_is(kraw, "profile") && fvt == JSON_STRING {
          ch.profile = bk_meta_read_str(m, json_text(j[..]));
        } else if json_is(kraw, "qualified_targets") && fvt == JSON_ARRAY {
          while true {
            at := json_next(j[..]);
            if at == JSON_ARRAY_END { break; }
            if at == JSON_STRING && qt_c < 16 {
              sp := bk_meta_read_str(m, json_text(j[..]));
              if sp.n > 0 { qt_tmp[qt_c] = sp; qt_c += 1; }
            } else if !json_skip(j[..]) { break; }
          }
        } else if json_is(kraw, "adopted_by") && fvt == JSON_ARRAY {
          while true {
            at := json_next(j[..]);
            if at == JSON_ARRAY_END { break; }
            if at == JSON_STRING && ad_c < 32 {
              sp := bk_meta_read_str(m, json_text(j[..]));
              if sp.n > 0 { ad_tmp[ad_c] = sp; ad_c += 1; }
            } else if !json_skip(j[..]) { break; }
          }
        } else {
          if !json_skip(j[..]) { break; }
        }
      }
      if j[0].tok != JSON_ERROR && ch.file.n > 0 && m[0].n < BK_META_MAX {
        ch.qt0 = m[0].ni;
        for q: 0..<qt_c {
          if m[0].ni < BK_META_ITEMS { m[0].items[m[0].ni] = qt_tmp[q]; m[0].ni += 1; ch.qt_n += 1; }
        }
        ch.ad0 = m[0].ni;
        for a: 0..<ad_c {
          if m[0].ni < BK_META_ITEMS { m[0].items[m[0].ni] = ad_tmp[a]; m[0].ni += 1; ch.ad_n += 1; }
        }
        m[0].entries[m[0].n] = ch;
        m[0].n += 1;
      }
    }
  }
  return m[0].n;
}

bk_meta_find :: (m: [] BkBookMeta, file: string) -> int {
  if file.count == 0 { return -1; }
  for i: 0..<m[0].n {
    if bk_meta_str(m, m[0].entries[i].file) == file { return i; }
  }
  return -1;
}

bk_status_class :: (status: string) -> string {
  if status == "implemented" { return "bk-badge bk-st-implemented"; }
  if status == "written" { return "bk-badge bk-st-written"; }
  if status == "partly implemented" { return "bk-badge bk-st-partly"; }
  return "bk-badge bk-st-draft";
}

bk_safe_repo_path :: (p: string) -> bool {
  if p.count == 0 || p[0] == '/' { return false; }
  for i: 0..<p.count {
    c := p[i];
    if c <= 32 || c == '\\' || c == '"' || c == '\'' || c == '<' || c == '>' { return false; }
    if c == '.' && i + 1 < p.count && p[i + 1] == '.' { return false; }
  }
  return true;
}

// Emits `<div class="bk-meta-bar">` showing truthful chapter status, profile, qualified targets, and adopted_by links.
bk_emit_meta_bar :: (hb: [] HtBuf, m: [] BkBookMeta, idx: int) {
  if idx < 0 || idx >= m[0].n { return; }
  ch := m[0].entries[idx];
  st := bk_meta_str(m, ch.status);
  prof := bk_meta_str(m, ch.profile);
  if st.count == 0 && prof.count == 0 && ch.qt_n == 0 && ch.ad_n == 0 { return; }
  ht_put(hb, "<div class=\"bk-meta-bar\">");
  if st.count > 0 {
    ht_put(hb, "<span class=\"");
    ht_put(hb, bk_status_class(st));
    ht_put(hb, "\">");
    ht_escape_text(hb, st);
    ht_put(hb, "</span>");
  }
  if prof.count > 0 {
    ht_put(hb, "<span class=\"bk-meta-item\"><span class=\"bk-meta-k\">Profile</span><span class=\"bk-meta-v\">");
    ht_escape_text(hb, prof);
    ht_put(hb, "</span></span>");
  }
  if ch.qt_n > 0 {
    ht_put(hb, "<span class=\"bk-meta-item\"><span class=\"bk-meta-k\">Qualified</span><span class=\"bk-meta-v\">");
    for q: 0..<ch.qt_n {
      if q > 0 { ht_put(hb, ", "); }
      ht_escape_text(hb, bk_meta_str(m, m[0].items[ch.qt0 + q]));
    }
    ht_put(hb, "</span></span>");
  }
  if ch.ad_n > 0 {
    ht_put(hb, "<div class=\"bk-meta-adopted\"><span class=\"bk-meta-k\">Adopted by</span>");
    for a: 0..<ch.ad_n {
      p := bk_meta_str(m, m[0].items[ch.ad0 + a]);
      if !bk_safe_repo_path(p) { continue; }
      dup := false;
      for prev: 0..<a {
        if bk_meta_str(m, m[0].items[ch.ad0 + prev]) == p { dup = true; break; }
      }
      if dup { continue; }
      ht_put(hb, "<a class=\"bk-meta-a\" href=\"https://github.com/OpenAgentsInc/openagents/blob/main/");
      ht_escape_attr(hb, p);
      ht_put(hb, "\">");
      ht_escape_text(hb, p);
      ht_put(hb, "</a>");
    }
    ht_put(hb, "</div>");
  }
  ht_put(hb, "</div>");
}

// Appends one `{b,t,u,s,h}` JSON entry for `/books/search.json` into `out` at `at`, or -1 on overflow.
bk_write_search_item :: (out: [] u8, at: int, first: bool, book_slug: string, title: string, url: string, status: string, hs: [] BkHeadings) -> int {
  n := at;
  if !first { n = json_raw(out, n, ","); }
  n = json_raw(out, n, "{\"b\":");
  n = json_write_string(out, n, book_slug);
  n = json_raw(out, n, ",\"t\":");
  n = json_write_string(out, n, title);
  n = json_raw(out, n, ",\"u\":");
  n = json_write_string(out, n, url);
  n = json_raw(out, n, ",\"s\":");
  n = json_write_string(out, n, status);
  n = json_raw(out, n, ",\"h\":[");
  limit := ifx hs[0].n > BK_SEARCH_MAX_H2 then BK_SEARCH_MAX_H2 else hs[0].n; // mutant: equivalent (when equal both branches equal BK_SEARCH_MAX_H2)
  for i: 0..<limit {
    if i > 0 { n = json_raw(out, n, ","); }
    n = json_write_string(out, n, bk_h2_title(hs, i));
  }
  return json_raw(out, n, "]}");
}

// Writes the HTML5 document header + sticky book TOC sidebar + breadcrumb bar into `hb`.
bk_emit_chapter_chrome :: (hb: [] HtBuf, book_idx: int, toc: [] BkToc, active: int, mid_href: string, mid_label: string) {
  titles := BK_TITLES;
  slugs := BK_SLUGS;
  descs := BK_DESCS;
  book_title := titles[book_idx];
  book_slug := slugs[book_idx];
  book_desc := descs[book_idx];
  ch_title := ifx active >= 0 && active < toc[0].n then bk_entry_title(toc, active) else book_title;
  pbuf: [256] u8;
  page_path := "";
  if active >= 0 && active < toc[0].n {
    page_path = bk_entry_href(toc, active);
  } else {
    pn := bk_copy_str(pbuf[..], 0, "/books/");
    pn = bk_copy_str(pbuf[..], pn, book_slug);
    page_path = cast(string) pbuf[0..<pn];
  }

  ht_put(hb, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>");
  ht_escape_text(hb, ch_title);
  if ch_title != book_title {
    ht_put(hb, " — ");
    ht_escape_text(hb, book_title);
  }
  ht_put(hb, "</title>");
  bk_emit_meta(hb, ch_title, book_desc, page_path);
  ht_put(hb, "<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\">");

  // Sticky book TOC sidebar
  ht_put(hb, "<nav class=\"st-nav bk-nav\" aria-label=\"Book table of contents\">");
  ht_put(hb, "<div class=\"bk-top\"><a class=\"lk\" href=\"/books\">Books</a><a class=\"lk\" href=\"");
  ht_escape_attr(hb, mid_href);
  ht_put(hb, "\">");
  ht_escape_text(hb, mid_label);
  ht_put(hb, "</a><a class=\"lk\" href=\"/\">Home</a></div>");
  ht_put(hb, "<div class=\"bk-head\"><p class=\"bk-head-t\">");
  ht_escape_text(hb, book_title);
  ht_put(hb, "</p><span class=\"meta\">");
  bk_put_int(hb, toc[0].chapters);
  ht_put(hb, " chapters · 0 KB JS</span></div>");

  for i: 0..<toc[0].n {
    ent := toc[0].entries[i];
    if ent.is_part {
      ht_put(hb, "<p class=\"bk-part\">");
      ht_escape_text(hb, bk_entry_title(toc, i));
      ht_put(hb, "</p>");
    } else {
      href := bk_entry_href(toc, i);
      ht_put(hb, "<a class=\"row\" href=\"");
      ht_escape_attr(hb, href);
      ht_put_u8(hb, '"');
      if i == active { ht_put(hb, " aria-current=\"true\""); }
      ht_put(hb, "><span class=\"row-t\">");
      ht_escape_text(hb, bk_entry_title(toc, i));
      ht_put(hb, "</span>");
      note := bk_entry_note(toc, i);
      if note.count > 0 {
        ht_put(hb, "<span class=\"meta\">");
        ht_escape_text(hb, note);
        ht_put(hb, "</span>");
      }
      ht_put(hb, "</a>");
    }
  }
  ht_put(hb, "</nav>");

  // Main article body header + breadcrumb + raw Markdown link
  ht_put(hb, "<article class=\"st-b bk-body\"><div class=\"bk-bar\"><div class=\"bk-crumb\"><a href=\"/books\">Books</a><span>/</span><a href=\"/books/");
  ht_escape_attr(hb, book_slug);
  ht_put(hb, "\">");
  ht_escape_text(hb, book_title);
  ht_put(hb, "</a></div><a class=\"lk\" href=\"");
  ht_escape_attr(hb, page_path);
  ht_put(hb, "/index.md\">Raw Markdown</a></div>");
}

// Writes the HTML5 document header + sticky book TOC sidebar + optional metadata banner & On-this-page TOC + `<div class="md">`.
bk_write_chapter_head_ex :: (book_idx: int, toc: [] BkToc, active: int, mid_href: string, mid_label: string, meta: [] BkBookMeta, meta_idx: int, hs: [] BkHeadings, out: [] u8) -> int {
  hb := [1] HtBuf.[HtBuf.{bytes = out}];
  bk_emit_chapter_chrome(hb[..], book_idx, toc, active, mid_href, mid_label);
  bk_emit_meta_bar(hb[..], meta, meta_idx);
  bk_emit_ontoc(hb[..], hs);
  ht_put(hb[..], "<div class=\"md\">");
  return ifx hb[0].overflow then -1 else hb[0].n;
}

bk_write_chapter_head_nav :: (book_idx: int, toc: [] BkToc, active: int, mid_href: string, mid_label: string, out: [] u8) -> int {
  hb := [1] HtBuf.[HtBuf.{bytes = out}];
  bk_emit_chapter_chrome(hb[..], book_idx, toc, active, mid_href, mid_label);
  ht_put(hb[..], "<div class=\"md\">");
  return ifx hb[0].overflow then -1 else hb[0].n;
}

bk_write_chapter_head :: (book_idx: int, toc: [] BkToc, active: int, out: [] u8) -> int {
  return bk_write_chapter_head_nav(book_idx, toc, active, "/docs/introduction", "Docs", out);
}

// Writes the article closing tags + Previous/Next chapter pager + `</main></body></html>`.
bk_write_chapter_foot :: (toc: [] BkToc, active: int, out: [] u8) -> int {
  hb := [1] HtBuf.[HtBuf.{bytes = out}];
  ht_put(hb[..], "</div>");
  prev := bk_prev_chapter(toc, active);
  next := bk_next_chapter(toc, active);
  if prev >= 0 || next >= 0 {
    ht_put(hb[..], "<nav class=\"bk-pager\" aria-label=\"Chapter navigation\">");
    if prev >= 0 {
      ht_put(hb[..], "<a class=\"bk-pg\" href=\"");
      ht_escape_attr(hb[..], bk_entry_href(toc, prev));
      ht_put(hb[..], "\"><span class=\"meta\">Previous</span><span class=\"row-t\">");
      ht_escape_text(hb[..], bk_entry_title(toc, prev));
      ht_put(hb[..], "</span></a>");
    }
    if next >= 0 {
      ht_put(hb[..], "<a class=\"bk-pg bk-pg-next\" href=\"");
      ht_escape_attr(hb[..], bk_entry_href(toc, next));
      ht_put(hb[..], "\"><span class=\"meta\">Next</span><span class=\"row-t\">");
      ht_escape_text(hb[..], bk_entry_title(toc, next));
      ht_put(hb[..], "</span></a>");
    }
    ht_put(hb[..], "</nav>");
  }
  ht_put(hb[..], "</article></div></main></body></html>");
  return ifx hb[0].overflow then -1 else hb[0].n;
}

// Renders the `/books` library index page listing all 9 books with live chapter counts (0 KB JS).
bk_render_books_index_nav :: (counts: [] int, mid_href: string, mid_label: string, out: [] u8) -> int {
  slugs := BK_SLUGS;
  dirs := BK_DIRS;
  titles := BK_TITLES;
  descs := BK_DESCS;
  total := 0;
  for k: 0..<BK_BOOK_COUNT {
    if k < counts.count { total += counts[k]; }
  }

  hb := [1] HtBuf.[HtBuf.{bytes = out}];
  ht_put(hb[..], "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Books — OpenAgents</title>");
  bk_emit_meta(hb[..], "Books", BK_INDEX_DESC, "/books");
  ht_put(hb[..], "<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\">");

  ht_put(hb[..], "<nav class=\"st-nav bk-nav\" aria-label=\"Site navigation\">");
  ht_put(hb[..], "<div class=\"bk-top\"><a class=\"lk\" href=\"/\">Home</a><a class=\"lk\" href=\"");
  ht_escape_attr(hb[..], mid_href);
  ht_put(hb[..], "\">");
  ht_escape_text(hb[..], mid_label);
  ht_put(hb[..], "</a><a class=\"lk\" href=\"/books\">Books</a></div>");
  ht_put(hb[..], "<div class=\"bk-head\"><p class=\"bk-head-t\">OpenAgents Books</p><span class=\"meta\">");
  bk_put_int(hb[..], total);
  ht_put(hb[..], " chapters · 0 KB JS</span></div>");
  for k: 0..<BK_BOOK_COUNT {
    cnt := ifx k < counts.count then counts[k] else 0;
    ht_put(hb[..], "<a class=\"row\" href=\"/books/");
    ht_escape_attr(hb[..], slugs[k]);
    ht_put(hb[..], "\"><span class=\"row-t\">");
    ht_escape_text(hb[..], titles[k]);
    ht_put(hb[..], "</span><span class=\"meta\">");
    ht_escape_text(hb[..], dirs[k]);
    ht_put(hb[..], " · ");
    bk_put_int(hb[..], cnt);
    ht_put(hb[..], " chapters</span></a>");
  }
  ht_put(hb[..], "</nav>");

  ht_put(hb[..], "<article class=\"st-b bk-body\"><header class=\"st-h\"><p class=\"meta\">OpenAgents Library · Pure Coax SSR</p><h1 class=\"st-t\">Books</h1></header>");
  ht_put(hb[..], "<p class=\"sec-n\">All nine OpenAgents books rendered directly from repository Markdown with build-time syntax highlighting, shared mono.coax styling, and 0 KB JavaScript / 0 KB WebAssembly.</p>");
  ht_put(hb[..], "<div class=\"bk-idx-acts\"><a class=\"lk\" href=\"/books/search.json\">Search Index (JSON)</a><a class=\"lk\" href=\"/books/index.md\">Raw Markdown</a></div>");
  ht_put(hb[..], "<div class=\"bk-grid\">");
  for k: 0..<BK_BOOK_COUNT {
    cnt := ifx k < counts.count then counts[k] else 0;
    ht_put(hb[..], "<a class=\"bk-card\" href=\"/books/");
    ht_escape_attr(hb[..], slugs[k]);
    ht_put(hb[..], "\"><span class=\"meta\">");
    ht_escape_text(hb[..], dirs[k]);
    ht_put(hb[..], " · ");
    bk_put_int(hb[..], cnt);
    ht_put(hb[..], " chapters</span><h2 class=\"bk-card-t\">");
    ht_escape_text(hb[..], titles[k]);
    ht_put(hb[..], "</h2><p class=\"bk-card-d\">");
    ht_escape_text(hb[..], descs[k]);
    ht_put(hb[..], "</p></a>");
  }
  ht_put(hb[..], "</div></article></div></main></body></html>");
  return ifx hb[0].overflow then -1 else hb[0].n;
}

bk_render_books_index :: (counts: [] int, out: [] u8) -> int {
  return bk_render_books_index_nav(counts, "/docs/introduction", "Docs", out);
}

// ---- checks

#test "bk string helpers, pool bounds, link rewriting, heading slugs, notes, and chunk boundary cuts" {
  // Exact-length and shorter boundary checks for bk_starts / bk_ends / bk_copy_str
  #assert bk_starts("ab", "ab") && !bk_starts("a", "ab") && !bk_starts("ac", "ab");
  #assert bk_ends("ab", "ab") && !bk_ends("a", "ab") && !bk_ends("ac", "ab");
  b2: [2] u8;
  #assert bk_copy_str(b2[..], 0, "abc") == 2 && cast(string) b2[0..<2] == "ab";

  // Pool bounds and overflow clamping
  ptoc: [1] BkToc;
  ptoc[0].tn = BK_TEXT_CAP - 1;
  at := bk_pool_add(ptoc[..], "xy");
  #assert at == BK_TEXT_CAP - 1 && ptoc[0].tn == BK_TEXT_CAP && ptoc[0].overflow && bk_pool_str(ptoc[..], at, 1) == "x";
  #assert bk_pool_str(ptoc[..], at, 0) == "" && bk_pool_str(ptoc[..], -1, 1) == "" && bk_pool_str(ptoc[..], at, 2) == "";
  ptoc[0].tn = 1; ptoc[0].text[0] = 'z'; ptoc[0].overflow = false;
  #assert bk_pool_str(ptoc[..], 0, 1) == "z" && bk_pool_str(ptoc[..], 1, 1) == "";

  // Link rewriting across every scheme, slash, cross-book, repo, and same-book boundary
  buf: [512] u8;
  #assert bk_is_known_book("coax") && bk_is_known_book("claude-code") && !bk_is_known_book("unknown");
  #assert bk_rewrite_href("coax", "", buf[..]) == "";
  #assert bk_rewrite_href("coax", "#intro", buf[..]) == "#intro";
  #assert bk_rewrite_href("coax", "/", buf[..]) == "/";
  #assert bk_rewrite_href("coax", "/docs/introduction", buf[..]) == "/docs/introduction";
  #assert bk_rewrite_href("coax", "//", buf[..]) == "" && bk_rewrite_href("coax", "/\\", buf[..]) == "";
  #assert bk_rewrite_href("coax", "https://openagents.com", buf[..]) == "https://openagents.com";
  #assert bk_rewrite_href("coax", "http://127.0.0.1:8820/", buf[..]) == "http://127.0.0.1:8820/";
  #assert bk_rewrite_href("coax", ":bad.md", buf[..]) == "" && bk_rewrite_href("coax", "javascript:alert(1).md", buf[..]) == "";
  #assert bk_rewrite_href("coax", "a;b.md", buf[..]) == "/books/coax/a;b";
  #assert bk_rewrite_href("coax", "sub/a.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/sub/a.md";
  #assert bk_rewrite_href("coax", "examples/ch01.coax", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/examples/ch01.coax";
  #assert bk_rewrite_href("coax", "chapters.json#L1", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/chapters.json#L1";
  #assert bk_rewrite_href("coax", "x", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/x";
  #assert bk_rewrite_href("coax", "./#frag", buf[..]) == "";
  #assert bk_rewrite_href("coax", "\\bad", buf[..]) == "" && bk_rewrite_href("coax", "..escape", buf[..]) == "";
  #assert bk_rewrite_href("coax", "README.md", buf[..]) == "/books/coax";
  #assert bk_rewrite_href("coax", "SUMMARY.md", buf[..]) == "/books/coax";
  #assert bk_rewrite_href("coax", "./README.md#top", buf[..]) == "/books/coax#top";
  #assert bk_rewrite_href("coax", "ch01-getting-started.md", buf[..]) == "/books/coax/ch01-getting-started";
  #assert bk_rewrite_href("coax", "./ch02-first.md#sec", buf[..]) == "/books/coax/ch02-first#sec";
  #assert bk_rewrite_href("nostr", "../../", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/";
  #assert bk_rewrite_href("nostr", "../../docs/a:b.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/docs/a:b.md";
  #assert bk_rewrite_href("nostr", "../../bitcoin/book/README.md", buf[..]) == "/books/bitcoin";
  #assert bk_rewrite_href("nostr", "../../bitcoin/book/SUMMARY.md", buf[..]) == "/books/bitcoin";
  #assert bk_rewrite_href("nostr", "../../bitcoin/book/", buf[..]) == "/books/bitcoin";
  #assert bk_rewrite_href("nostr", "../../coax/book/sub/a.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/sub/a.md";
  #assert bk_rewrite_href("nostr", "../../coax/book/check-structure.py", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/check-structure.py";
  #assert bk_rewrite_href("nostr", "../../bitcoin/book/ch004-sha-256.md#h", buf[..]) == "/books/bitcoin/ch004-sha-256#h";
  #assert bk_rewrite_href("nostr", "../../coax", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax";
  #assert bk_rewrite_href("nostr", "../../coax/other.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/other.md";
  #assert bk_rewrite_href("nostr", "../../unknown/book/a.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/unknown/book/a.md";
  #assert bk_rewrite_href("openagents", "../../docs/audits/x.md#p", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/docs/audits/x.md#p";
  #assert bk_rewrite_href("psionic", "../README.md#s", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/psionic/README.md#s";
  #assert bk_rewrite_href("coax", "../a:b.md", buf[..]) == "https://github.com/OpenAgentsInc/openagents/blob/main/coax/a:b.md";
  #assert bk_rewrite_href("coax", "a0.md", buf[..]) == "/books/coax/a0";

  // Heading slugs, note cleanup, HTML comment check, and language IDs
  sb: [64] u8; sb3: [3] u8;
  #assert bk_heading_slug("AZ az 09-a_b.c/d!:[{", sb[..]) == "az-az-09-a-b-c-d";
  #assert bk_heading_slug("-a  b", sb[..]) == "a-b" && bk_heading_slug("a-", sb[..]) == "a" && bk_heading_slug("-", sb[..]) == "";
  #assert bk_heading_slug("abcdef", sb3[..]) == "abc";
  #assert bk_clean_note("—") == "" && bk_clean_note("—a") == "a" && bk_clean_note(" — ok") == "ok";
  #assert bk_clean_note("--") == "" && bk_clean_note("--a") == "a" && bk_clean_note("-") == "" && bk_clean_note("-a") == "a" && bk_clean_note("  done  ") == "done";
  #assert bk_is_html_comment("<!-- x -->") && !bk_is_html_comment("<!-- x") && !bk_is_html_comment("x -->");
  #assert bk_lang_id("jai") == SYN_LANG_COAX && bk_lang_id("coax") == SYN_LANG_COAX && bk_lang_id("plain") == SYN_LANG_PLAIN;

  // bk_next_cut: pos>=count, win>=count, cut within limit, fallback window, and hard newline/EOF fallback
  s_cut := "p1\n\np2\n\np3\n";
  #assert bk_next_cut(s_cut, s_cut.count, 4, 8) == s_cut.count;
  #assert bk_next_cut(s_cut, 0, s_cut.count, s_cut.count) == s_cut.count;
  #assert bk_next_cut(s_cut, 0, 5, 10) == 4;
  // Inside a 1-block fence longer than limit (6) but ending inside fallback (22):
  s_fb := "```\nabcdefghij\n```\nnext";
  #assert bk_next_cut(s_fb, 0, 6, 20) == 19;
  #assert bk_next_cut(s_fb, 0, 6, 23) == 23;
  // Unclosed fence longer than fallback: cuts at next newline (e + 1), or EOF when no newline remains
  s_long := "```\n0123456789\n0123456789\nend";
  #assert bk_next_cut(s_long, 0, 5, 8) == 15;
  #assert bk_next_cut("```\n0123456789", 0, 5, 8) == 14;
}

#test "bk_parse_summary handles headings, bold parts, caps, invalid items, multi-chunk, and prev/next" {
  sum := "# Ignored H1\n\n* [Home](README.md)\n* [Fwd](./foreword.md)\n\n## Part I\n### Sub\n#### Deep\n##    \n\n* [1. Start](ch01.md) — a\n* [2. Two](ch02.md)\n* plain bullet\n* *it* [3. Pref](ch03.md)\n* [ ](empty.md)\n* [Bad](javascript:x)\n* [Top](#)\n\n***II. Bold Part***\n\n**Not** part\n\n[**LinkBold**](x.md)\n\n- [Bitcoin](../../bitcoin/book/README.md)\n- [4. End](ch04.md)\n";
  toc: [1] BkToc;
  doc: [1] MdDoc;
  // Pre-dirty toc and doc to prove bk_parse_summary resets them cleanly
  toc[0].n = 5; toc[0].chapters = 5; toc[0].tn = 5; toc[0].overflow = true;
  doc[0].nb = 3;
  cnt := bk_parse_summary(toc[..], "coax", sum, doc[..]);
  #assert cnt == 6 && toc[0].n == 11 && !toc[0].overflow && toc[0].entries[0].title_at == 0;
  #assert !toc[0].entries[0].is_part && bk_entry_file(toc[..], 0) == "README.md" && bk_entry_slug(toc[..], 0) == "" && bk_entry_href(toc[..], 0) == "/books/coax";
  #assert bk_entry_file(toc[..], 1) == "foreword.md" && bk_entry_slug(toc[..], 1) == "foreword" && bk_entry_href(toc[..], 1) == "/books/coax/foreword";
  #assert toc[0].entries[2].is_part && bk_entry_title(toc[..], 2) == "Part I";
  #assert toc[0].entries[3].is_part && bk_entry_title(toc[..], 3) == "Sub";
  #assert bk_entry_title(toc[..], 4) == "1. Start" && bk_entry_note(toc[..], 4) == "a";
  #assert bk_entry_title(toc[..], 5) == "2. Two" && bk_entry_note(toc[..], 5) == "";
  #assert bk_entry_title(toc[..], 6) == "3. Pref" && bk_entry_slug(toc[..], 6) == "ch03";
  #assert toc[0].entries[7].is_external && bk_entry_href(toc[..], 7) == "#";
  #assert toc[0].entries[8].is_part && bk_entry_title(toc[..], 8) == "II. Bold Part";
  #assert toc[0].entries[9].is_external && bk_entry_href(toc[..], 9) == "/books/bitcoin";
  #assert !toc[0].entries[10].is_external && bk_entry_slug(toc[..], 10) == "ch04";

  // Prev/next skip both parts AND external entries in both directions
  #assert bk_prev_chapter(toc[..], 0) == -1 && bk_next_chapter(toc[..], 0) == 1;
  #assert bk_prev_chapter(toc[..], 4) == 1 && bk_next_chapter(toc[..], 1) == 4;
  #assert bk_prev_chapter(toc[..], 10) == 6 && bk_next_chapter(toc[..], 6) == 10;
  #assert bk_next_chapter(toc[..], 10) == -1;

  // External link with prefix text (like Psionic's moved chapters) preserves prefix in title
  mtoc: [1] BkToc;
  _ = bk_parse_summary(mtoc[..], "psionic", "- 200-214: moved to [Coder](../../coder/book/SUMMARY.md), ch 1-8\n- X [Bitcoin](../../bitcoin/book/README.md)\n- [Nostr](../../nostr/book/README.md)\n", doc[..]);
  #assert mtoc[0].n == 3 && !mtoc[0].overflow && mtoc[0].entries[0].is_external;
  #assert bk_entry_title(mtoc[..], 0) == "200-214: moved to Coder" && bk_entry_title(mtoc[..], 1) == "X Bitcoin" && bk_entry_title(mtoc[..], 2) == "Nostr";

  // BK_MAX_ENTRIES saturation cap sets overflow on both parts and list items
  cap_toc: [1] BkToc;
  cap_toc[0].n = BK_MAX_ENTRIES;
  bk_toc_push_part(cap_toc[..], "   ");
  #assert cap_toc[0].n == BK_MAX_ENTRIES && !cap_toc[0].overflow;
  bk_toc_push_part(cap_toc[..], "Ignored");
  #assert cap_toc[0].n == BK_MAX_ENTRIES && cap_toc[0].overflow;
  // Build a SUMMARY with 520 list items across sections to test multi-chunk loop and BK_MAX_ENTRIES overflow
  big: [8192] u8; bn := 0;
  for k: 0..<520 {
    if k > 0 && k % 50 == 0 { bn = bk_copy_str(big[..], bn, "\n"); }
    bn = bk_copy_str(big[..], bn, "- [Ch](c.md)\n");
  }
  c_big := bk_parse_summary(cap_toc[..], "coax", cast(string) big[0..<bn], doc[..]);
  #assert cap_toc[0].n == BK_MAX_ENTRIES && c_big == BK_MAX_ENTRIES && cap_toc[0].overflow;
}

#test "bk_render_md_html, bk_emit_code_html, and bk_emit_runs match exact HTML and overflow cleanly" {
  doc: [1] MdDoc;
  t: [1] Tree;
  out: [32768] u8;

  // Direct bk_emit_runs edge cases: 0 runs (empty & 1-char text), out-of-range runs, 1-char href, and blocked href
  tr_begin(t[..]);
  dummy_runs: [1] MdRun;
  bk_emit_runs(t[..], doc[..], "coax", "e0", "", dummy_runs[0..<0]);
  bk_emit_runs(t[..], doc[..], "coax", "e1", "a", dummy_runs[0..<0]);
  bad_runs := [2] MdRun.[MdRun.{from = 2, to = 2}, MdRun.{from = 0, to = 9}];
  bk_emit_runs(t[..], doc[..], "coax", "e2", "ab", bad_runs[..]);
  #assert t[0].n == 1 && tr_id(t[..], 0) == "e1.t" && t[0].nodes[0].tag == TG_SPAN && tr_text_of(t[..], 0) == "a";
  doc[0] = MdDoc.{}; _ = md_parse(doc[..], "[R](/) [X](javascript:1)", 0);
  tr_begin(t[..]);
  bk_emit_runs(t[..], doc[..], "coax", "lk", md_block_text(doc[..], 0), md_block_runs(doc[..], 0));
  #assert tr_attr_of(t[..], tr_find(t[..], "lk.r.0"), AT_HREF) == "/" && !tr_has(t[..], tr_find(t[..], "lk.r.2"), AT_HREF);

  // Direct bk_emit_code_html: empty lang (defaults to "text"), 1-char lang "c", and highlighted multi-line Coax (jai) with trailing newline
  hb0 := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  bk_emit_code_html(hb0[..], "", "a<b");
  #assert cast(string) out[0..<hb0[0].n] == "<div class=\"md-code-block\"><div class=\"md-code-hdr\"><span class=\"md-code-lang\">text</span></div><pre class=\"md-pre\"><code class=\"md-code-body\">a&lt;b</code></pre></div>";
  hbc := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  bk_emit_code_html(hbc[..], "c", "1\n");
  #assert cast(string) out[0..<hbc[0].n] == "<div class=\"md-code-block\" data-lang=\"c\"><div class=\"md-code-hdr\"><span class=\"md-code-lang\">c</span></div><pre class=\"md-pre\"><code class=\"md-code-body\"><span class=\"md-code-line\"><span class=\"syn-num\">1</span></span><span class=\"md-code-line\"></span></code></pre></div>";

  hb1 := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  bk_emit_code_html(hb1[..], "jai", "  return x\n$ ");
  #assert cast(string) out[0..<hb1[0].n] == "<div class=\"md-code-block\" data-lang=\"jai\"><div class=\"md-code-hdr\"><span class=\"md-code-lang\">jai</span></div><pre class=\"md-pre\"><code class=\"md-code-body\"><span class=\"md-code-line\">  <span class=\"syn-kw\">return</span> <span class=\"syn-var\">x</span></span><span class=\"md-code-line\">$ </span></code></pre></div>";

  // Full Markdown document exact HTML assertion covering every block and inline kind + per-block Tree depth balance
  md := "# <!-- a -->\n\n## ---\n\n<!-- skip -->\n\n**b** *i* ~~s~~ `c` [L](ch02.md) [X](javascript:1) p\n\n```text\nhi\n```\n\n```island:callout\ntone: info\ntitle: T\nbody: B\n```\n\n1. one\n\n- [x] d\n- [ ] u\n- n\n\n> q1\n>\n> q2\n\n| H1 | H2 |\n| --- | --- |\n| C1 | C2 |\n\n---\n";
  doc[0].nb = 7; // verify reset
  n := bk_render_md_html(md, "coax", doc[..], t[..], out[..]);
  #assert n > 0;
  want := "<h1 id=\"a\" class=\"md-h\"><strong id=\"b.0.r.0\">&lt;!-- a --&gt;</strong></h1><h2 id=\"b.1\" class=\"md-h\"><strong id=\"b.1.r.0\">---</strong></h2><p id=\"b.3\" class=\"md-p\"><strong id=\"b.3.r.0\">b</strong><span id=\"b.3.r.1\"> </span><em id=\"b.3.r.2\">i</em><span id=\"b.3.r.3\"> </span><del id=\"b.3.r.4\">s</del><span id=\"b.3.r.5\"> </span><code id=\"b.3.r.6\" class=\"md-code\">c</code><span id=\"b.3.r.7\"> </span><a id=\"b.3.r.8\" class=\"md-link\" href=\"/books/coax/ch02\">L</a><span id=\"b.3.r.9\"> </span><a id=\"b.3.r.10\" class=\"md-link\">X</a><span id=\"b.3.r.11\"> p</span></p><div class=\"md-code-block\" data-lang=\"text\"><div class=\"md-code-hdr\"><span class=\"md-code-lang\">text</span></div><pre class=\"md-pre\"><code class=\"md-code-body\">hi</code></pre></div><section id=\"b.5\" class=\"md-island md-island-callout\" role=\"note\" data-state=\"info\"><h4 id=\"b.5.title\" class=\"md-island-title\">T</h4><p id=\"b.5.body\" class=\"md-island-body\">B</p></section><ol id=\"b.6\" class=\"md-list\"><li id=\"b.6.i.0\" class=\"md-li\"><span id=\"b.6.i.0.r.0\">one</span></li></ol><ul id=\"b.7\" class=\"md-list\"><li id=\"b.7.i.0\" class=\"md-li\" aria-checked=\"true\"><span id=\"b.7.i.0.r.0\">d</span></li><li id=\"b.7.i.1\" class=\"md-li\" aria-checked=\"false\"><span id=\"b.7.i.1.r.0\">u</span></li><li id=\"b.7.i.2\" class=\"md-li\"><span id=\"b.7.i.2.r.0\">n</span></li></ul><blockquote id=\"b.8\" class=\"md-quote\"><p id=\"b.8.q.0\" class=\"md-quote-p\"><span id=\"b.8.q.0.r.0\">q1</span></p><p id=\"b.8.q.1\" class=\"md-quote-p\"><span id=\"b.8.q.1.r.0\">q2</span></p></blockquote><table id=\"b.9\" class=\"md-table\"><tr id=\"b.9.tr.0\"><th id=\"b.9.tr.0.c.0\"><strong id=\"b.9.tr.0.c.0.r.0\">H1</strong></th><th id=\"b.9.tr.0.c.1\"><strong id=\"b.9.tr.0.c.1.r.0\">H2</strong></th></tr><tr id=\"b.9.tr.1\"><td id=\"b.9.tr.1.c.0\"><span id=\"b.9.tr.1.c.0.r.0\">C1</span></td><td id=\"b.9.tr.1.c.1\"><span id=\"b.9.tr.1.c.1.r.0\">C2</span></td></tr></table><hr id=\"b.10\" class=\"md-hr\">";
  #assert cast(string) out[0..<n] == want;
  // Verify every single block closes its Tree cleanly (depth == 0)
  hb_chk := [1] HtBuf.[HtBuf.{bytes = out[..]}];
  seq_chk := 0;
  for b: 0..<doc[0].nb {
    seq_chk = bk_render_block_html(hb_chk[..], doc[..], b, t[..], "coax", seq_chk);
    #assert t[0].depth == 0;
  }
  #assert cast(string) out[0..<hb_chk[0].n] == want;

  // Overflow stops cleanly and returns -1
  tiny: [16] u8;
  #assert bk_render_md_html(md, "coax", doc[..], t[..], tiny[..]) == -1;
  hb_ov := [1] HtBuf.[HtBuf.{bytes = tiny[..], overflow = true}];
  #assert bk_render_block_html(hb_ov[..], doc[..], 0, t[..], "coax", 5) == 5;
}

#test "bk_write_chapter_head, bk_write_chapter_foot, bk_render_books_index, and bk_write_mono_css match exact output" {
  // Path join and CLI --out parser helpers
  jp: [16] u8;
  #assert bk_join_path("a/b", "", jp[..]) == "a/b";
  #assert bk_join_path("a/b", "c", jp[..]) == "a/b/c";
  #assert bk_join_path("a/b", "c", jp[0..<5]) == "a/b/c";
  #assert bk_join_path("a/b", "c", jp[0..<4]) == "";
  empty_av: [1] string;
  #assert bk_resolve_out(empty_av[0..<0], "def") == "def";
  good_av := [2] string.["--out", "/tmp/books"];
  #assert bk_resolve_out(good_av[..], "def") == "/tmp/books";
  short_av := [2] string.["--out", "x"];
  #assert bk_resolve_out(short_av[..], "def") == "x";
  one_av := [1] string.["--out"];
  #assert bk_resolve_out(one_av[..], "def") == "";
  bad_av := [2] string.["--dir", "/tmp/books"];
  #assert bk_resolve_out(bad_av[..], "def") == "";
  empty_dir_av := [2] string.["--out", ""];
  #assert bk_resolve_out(empty_dir_av[..], "def") == "";
  extra_av := [3] string.["--out", "/tmp/books", "--extra"];
  #assert bk_resolve_out(extra_av[..], "def") == "";

  // Shared mono.coax + hybrid + book CSS stylesheet fits cleanly and refuses short buffers
  css: [65536] u8;
  cn := bk_write_mono_css(css[..]);
  #assert cn > BK_HYBRID_CSS.count + BK_CSS.count;
  #assert cast(string) css[cn - BK_CSS.count..<cn] == BK_CSS;
  #assert cast(string) css[cn - BK_CSS.count - BK_HYBRID_CSS.count..<cn - BK_CSS.count] == BK_HYBRID_CSS;
  #assert bk_write_mono_css(css[0..<cn]) == cn;
  #assert bk_write_mono_css(css[0..<cn - 1]) == -1;

  doc: [1] MdDoc;
  toc: [1] BkToc;
  out: [32768] u8;
  tiny: [16] u8;

  // 3-entry TOC with entry 0 having distinct title+href, a part, and chapter with 1-char note
  _ = bk_parse_summary(toc[..], "coax", "* [Intro](intro.md)\n## P1\n* [The Coax Programming Language](README.md) — x\n", doc[..]);

  // active == 0 (distinct title & href at index 0 -> kills active>=0->active>0 and 0->1!)
  h0 := bk_write_chapter_head(0, toc[..], 0, out[..]);
  w0 := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Intro — The Coax Programming Language</title><meta name=\"description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><link rel=\"canonical\" href=\"https://openagents.com/books/coax/intro\"><link rel=\"alternate\" type=\"text/markdown\" href=\"/books/coax/intro/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"Intro\"><meta property=\"og:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta property=\"og:url\" content=\"https://openagents.com/books/coax/intro\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Intro\"><meta name=\"twitter:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\"><nav class=\"st-nav bk-nav\" aria-label=\"Book table of contents\"><div class=\"bk-top\"><a class=\"lk\" href=\"/books\">Books</a><a class=\"lk\" href=\"/docs/introduction\">Docs</a><a class=\"lk\" href=\"/\">Home</a></div><div class=\"bk-head\"><p class=\"bk-head-t\">The Coax Programming Language</p><span class=\"meta\">2 chapters · 0 KB JS</span></div><a class=\"row\" href=\"/books/coax/intro\" aria-current=\"true\"><span class=\"row-t\">Intro</span></a><p class=\"bk-part\">P1</p><a class=\"row\" href=\"/books/coax\"><span class=\"row-t\">The Coax Programming Language</span><span class=\"meta\">x</span></a></nav><article class=\"st-b bk-body\"><div class=\"bk-bar\"><div class=\"bk-crumb\"><a href=\"/books\">Books</a><span>/</span><a href=\"/books/coax\">The Coax Programming Language</a></div><a class=\"lk\" href=\"/books/coax/intro/index.md\">Raw Markdown</a></div><div class=\"md\">";
  #assert h0 > 0 && cast(string) out[0..<h0] == w0;

  // Custom production site nav links (/projects, "Projects")
  h0p := bk_write_chapter_head_nav(0, toc[..], 0, "/projects", "Projects", out[..]);
  w0p := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Intro — The Coax Programming Language</title><meta name=\"description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><link rel=\"canonical\" href=\"https://openagents.com/books/coax/intro\"><link rel=\"alternate\" type=\"text/markdown\" href=\"/books/coax/intro/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"Intro\"><meta property=\"og:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta property=\"og:url\" content=\"https://openagents.com/books/coax/intro\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Intro\"><meta name=\"twitter:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\"><nav class=\"st-nav bk-nav\" aria-label=\"Book table of contents\"><div class=\"bk-top\"><a class=\"lk\" href=\"/books\">Books</a><a class=\"lk\" href=\"/projects\">Projects</a><a class=\"lk\" href=\"/\">Home</a></div><div class=\"bk-head\"><p class=\"bk-head-t\">The Coax Programming Language</p><span class=\"meta\">2 chapters · 0 KB JS</span></div><a class=\"row\" href=\"/books/coax/intro\" aria-current=\"true\"><span class=\"row-t\">Intro</span></a><p class=\"bk-part\">P1</p><a class=\"row\" href=\"/books/coax\"><span class=\"row-t\">The Coax Programming Language</span><span class=\"meta\">x</span></a></nav><article class=\"st-b bk-body\"><div class=\"bk-bar\"><div class=\"bk-crumb\"><a href=\"/books\">Books</a><span>/</span><a href=\"/books/coax\">The Coax Programming Language</a></div><a class=\"lk\" href=\"/books/coax/intro/index.md\">Raw Markdown</a></div><div class=\"md\">";
  #assert h0p > 0 && cast(string) out[0..<h0p] == w0p;

  // active == 2 (title equals book_title: omits " — book_title" suffix)
  h2 := bk_write_chapter_head(0, toc[..], 2, out[..]);
  w2 := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>The Coax Programming Language</title><meta name=\"description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><link rel=\"canonical\" href=\"https://openagents.com/books/coax\"><link rel=\"alternate\" type=\"text/markdown\" href=\"/books/coax/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"The Coax Programming Language\"><meta property=\"og:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta property=\"og:url\" content=\"https://openagents.com/books/coax\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"The Coax Programming Language\"><meta name=\"twitter:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\"><nav class=\"st-nav bk-nav\" aria-label=\"Book table of contents\"><div class=\"bk-top\"><a class=\"lk\" href=\"/books\">Books</a><a class=\"lk\" href=\"/docs/introduction\">Docs</a><a class=\"lk\" href=\"/\">Home</a></div><div class=\"bk-head\"><p class=\"bk-head-t\">The Coax Programming Language</p><span class=\"meta\">2 chapters · 0 KB JS</span></div><a class=\"row\" href=\"/books/coax/intro\"><span class=\"row-t\">Intro</span></a><p class=\"bk-part\">P1</p><a class=\"row\" href=\"/books/coax\" aria-current=\"true\"><span class=\"row-t\">The Coax Programming Language</span><span class=\"meta\">x</span></a></nav><article class=\"st-b bk-body\"><div class=\"bk-bar\"><div class=\"bk-crumb\"><a href=\"/books\">Books</a><span>/</span><a href=\"/books/coax\">The Coax Programming Language</a></div><a class=\"lk\" href=\"/books/coax/index.md\">Raw Markdown</a></div><div class=\"md\">";
  #assert h2 > 0 && cast(string) out[0..<h2] == w2;

  // active out of range (-1 and toc[0].n) falls back to book_title and /books/<slug>/index.md
  h_neg := bk_write_chapter_head(0, toc[..], -1, out[..]);
  h_end := bk_write_chapter_head(0, toc[..], toc[0].n, out[..]);
  w_fb := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>The Coax Programming Language</title><meta name=\"description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><link rel=\"canonical\" href=\"https://openagents.com/books/coax\"><link rel=\"alternate\" type=\"text/markdown\" href=\"/books/coax/index.md\"><meta name=\"theme-color\" content=\"#000000\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"OpenAgents\"><meta property=\"og:title\" content=\"The Coax Programming Language\"><meta property=\"og:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta property=\"og:url\" content=\"https://openagents.com/books/coax\"><meta property=\"og:image\" content=\"https://openagents.com/og/default.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"OpenAgents\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"The Coax Programming Language\"><meta name=\"twitter:description\" content=\"Programs in Coax, the language every other OpenAgents book uses.\"><meta name=\"twitter:image\" content=\"https://openagents.com/og/default.jpg\">\n<link rel=\"stylesheet\" href=\"/books/mono.css\"></head><body><main id=\"coaxial-root\" data-coax-ssr=\"1\"><div class=\"st\"><nav class=\"st-nav bk-nav\" aria-label=\"Book table of contents\"><div class=\"bk-top\"><a class=\"lk\" href=\"/books\">Books</a><a class=\"lk\" href=\"/docs/introduction\">Docs</a><a class=\"lk\" href=\"/\">Home</a></div><div class=\"bk-head\"><p class=\"bk-head-t\">The Coax Programming Language</p><span class=\"meta\">2 chapters · 0 KB JS</span></div><a class=\"row\" href=\"/books/coax/intro\"><span class=\"row-t\">Intro</span></a><p class=\"bk-part\">P1</p><a class=\"row\" href=\"/books/coax\"><span class=\"row-t\">The Coax Programming Language</span><span class=\"meta\">x</span></a></nav><article class=\"st-b bk-body\"><div class=\"bk-bar\"><div class=\"bk-crumb\"><a href=\"/books\">Books</a><span>/</span><a href=\"/books/coax\">The Coax Programming Language</a></div><a class=\"lk\" href=\"/books/coax/index.md\">Raw Markdown</a></div><div class=\"md\">";
  #assert h_neg > 0 && cast(string) out[0..<h_neg] == w_fb && h_end == h_neg;
  #assert bk_write_chapter_head(0, toc[..], 0, tiny[..]) == -1;

  // Chapter foot: active=-1 gives next==0 (kills next>=0->next>0!), active=0 next-only, active=2 prev-only, both, neither
  fn0 := bk_write_chapter_foot(toc[..], -1, out[..]);
  #assert cast(string) out[0..<fn0] == "</div><nav class=\"bk-pager\" aria-label=\"Chapter navigation\"><a class=\"bk-pg bk-pg-next\" href=\"/books/coax/intro\"><span class=\"meta\">Next</span><span class=\"row-t\">Intro</span></a></nav></article></div></main></body></html>";
