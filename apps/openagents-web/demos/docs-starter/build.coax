// Build, hybrid SSR-prerender, and serve tool for the Hello World + Docs + Books Coax Web starter.
// Emits:
//   - `/` (index.html): Native Coax SSR + hydrated Wasm (`docs-starter.wasm`)
//   - `/docs/*`, `404.html`: Pure 0-KB-Wasm / 0-KB-JS static HTML using components/skin/mono.coax CSS + raw `.md` alternates.
//   - `/books` and `/books/<book>/<chapter>`: All 8 repository books (coax/book, openagents/book,
//     bitcoin/book, nostr/book, coder/book, psionic/book, metaverse-engine/book, everglade/book)
//     rendered at build time with syntax highlighting, TOC sidebar, prev/next pager, raw `index.md`, and 0 KB JS/Wasm.
// Run from the repository root:
//   coax/web/tool.sh apps/openagents-web/demos/docs-starter/build.coax [--serve] [--listen HOST:PORT]
#import "Basic";
#load "../../../../coax/lib/sys/tool.coax";
#load "../../../../coax/lib/sys/fs.coax";
#load "../../../../coax/lib/sys/proc.coax";
#load "page.coax";
#load "books.coax";

DS_APP_DIR :: "apps/openagents-web/build/docs-starter";
DS_BOOKS_DIR :: "apps/openagents-web/build/docs-starter/books";
DS_BUILD_SRC :: "apps/openagents-web/demos/docs-starter/build.coax";

DS_INDEX_MD :: "# Coax Web Starter\n\nHybrid starter: hydrated Coax Wasm on `/` and 0-KB-Wasm static SSR docs & books on `/docs/*` and `/books/*` reusing `components/skin/mono.coax`.\n\nRoutes:\n- `/` (hydrated Wasm)\n- `/docs/introduction` (0 KB Wasm)\n- `/docs/getting-started` (0 KB Wasm)\n- `/docs/roadmap` (0 KB Wasm)\n- `/books` (0 KB Wasm — all 8 OpenAgents books)\n- `/books/coax` (0 KB Wasm — The Coax Programming Language)\n";

BK_RAW_CAP :: 524288;
BK_OUT_CAP :: 1048576;

BkWork :: struct {
  raw: [BK_RAW_CAP] u8;
  out: [BK_OUT_CAP] u8;
  toc: [1] BkToc;
  doc: [1] MdDoc;
  tree: [1] Tree;
}

ds_quote :: (text: string, out: [] u8) -> string {
  need := 2;
  for c: text { need += ifx c == '\'' then 4 else 1; }
  if need > out.count { return ""; }
  n := 0; out[n] = '\''; n += 1;
  for c: text {
    if c == '\'' { out[n] = '\''; out[n + 1] = '\\'; out[n + 2] = '\''; out[n + 3] = '\''; n += 4; }
    else { out[n] = c; n += 1; }
  }
  out[n] = '\''; n += 1;
  return cast(string) out[0..<n];
}

ds_run :: (argv: [] string) -> bool {
  out: [65536] u8; err: [65536] u8;
  r := proc_run(argv, 600000, out[..], err[..]);
  if r.out_n > 0 { tool_errln(cast(string) out[0..<r.out_n]); }
  if r.err_n > 0 { tool_errln(cast(string) err[0..<r.err_n]); }
  return r.started == 0 && r.status == 0 && !r.timed_out && !r.cut;
}

ds_write :: (path: string, text: string) -> bool {
  prior: [131072] u8; n := fs_read(path, prior[..]);
  if n >= 0 && cast(string) prior[0..<n] == text { return true; }
  return fs_write(path, text);
}

ds_emit_route :: (dir: string, file: string, page: int, hydrate: bool) -> bool {
  if !fs_mkdir(dir) { return false; }
  h: [1] DsTest;
  html: [131072] u8;
  n := ds_render_ssr(h[0].s[..], page, hydrate, html[..]);
  if n <= 0 { return false; }
  pbuf: [4096] u8;
  full := fs_join(dir, file, pbuf[..]);
  if full == "" { return false; }
  if !ds_write(full, cast(string) html[0..<n]) { return false; }
  md := ds_doc_source(page);
  if md.count > 0 {
    mbuf: [4096] u8;
    mpath := fs_join(dir, "index.md", mbuf[..]);
    if mpath == "" || !ds_write(mpath, md) { return false; }
  }
  return true;
}

// Writes the shared external stylesheet `/books/mono.css` once for all book pages.
ds_emit_books_css :: () -> bool {
  if !fs_mkdir(DS_BOOKS_DIR) { return false; }
  h: [1] DsTest;
  css_buf: [65536] u8;
  n := ds_write_css(h[0].s[..]);
  if n <= 0 || n + BK_CSS.count > css_buf.count { return false; }
  for k: 0..<n { css_buf[k] = h[0].s[0].css[k]; }
  n2 := bk_copy_str(css_buf[..], n, BK_CSS);
  return ds_write("apps/openagents-web/build/docs-starter/books/mono.css", cast(string) css_buf[0..<n2]);
}

// Streams one chapter HTML document to disk (head + block-chunked Markdown HTML + foot) plus raw index.md.
ds_emit_book_chapter :: (w: [] BkWork, book_idx: int, active: int, out_dir: string, md_src: string) -> bool {
  if !fs_mkdir(out_dir) { return false; }
  slugs := BK_SLUGS;
  book_slug := slugs[book_idx];
  p1: [4096] u8; p2: [4096] u8;
  html_path := fs_join(out_dir, "index.html", p1[..]);
  md_path := fs_join(out_dir, "index.md", p2[..]);
  if html_path == "" || md_path == "" { return false; }

  hn := bk_write_chapter_head(book_idx, w[0].toc[..], active, w[0].out[..]);
  if hn <= 0 || !fs_write(html_path, cast(string) w[0].out[0..<hn]) { return false; }

  pos := 0;
  seq := 0;
  while pos < md_src.count {
    cut := bk_next_cut(md_src, pos, BK_MD_CHUNK, BK_MD_FALLBACK);
    seg := cast(string) md_src[pos..<cut];
    pos = cut;
    w[0].doc[0] = MdDoc.{};
    w[0].doc[0].keep_rules = true;
    _ = md_parse(w[0].doc[..], seg, 0);
    hb := [1] HtBuf.[HtBuf.{bytes = w[0].out[..]}];
    for b: 0..<w[0].doc[0].nb {
      seq = bk_render_block_html(hb[..], w[0].doc[..], b, w[0].tree[..], book_slug, seq);
      if hb[0].overflow { tool_err("docs-starter: HTML overflow on "); tool_errln(html_path); return false; }
      if hb[0].n >= BK_OUT_CAP / 2 {
        if !fs_append(html_path, cast(string) w[0].out[0..<hb[0].n]) { return false; }
        hb[0].n = 0;
      }
    }
    if hb[0].n > 0 && !fs_append(html_path, cast(string) w[0].out[0..<hb[0].n]) { return false; }
  }

  fn := bk_write_chapter_foot(w[0].toc[..], active, w[0].out[..]);
  if fn <= 0 || !fs_append(html_path, cast(string) w[0].out[0..<fn]) { return false; }
  if !fs_write(md_path, md_src) { return false; }
  return true;
}

// Discovers and renders all 8 repository books under /books/<slug>/<chapter> with 0 KB JS/Wasm.
ds_emit_all_books :: () -> bool {
  if !ds_emit_books_css() { return false; }
  w: [1] BkWork;
  slugs := BK_SLUGS;
  dirs := BK_DIRS;
  counts: [BK_BOOK_COUNT] int;
  total_rendered := 0;

  for bi: 0..<BK_BOOK_COUNT {
    book_slug := slugs[bi];
    book_dir := dirs[bi];
    sp: [4096] u8;
    sum_path := fs_join(book_dir, "SUMMARY.md", sp[..]);
    if sum_path == "" || fs_kind(sum_path) != FS_FILE { continue; }
    sn := fs_read(sum_path, w[0].raw[..]);
    if sn <= 0 { return false; }
    _ = bk_parse_summary(w[0].toc[..], book_slug, cast(string) w[0].raw[0..<sn], w[0].doc[..]);

    bdir_buf: [4096] u8;
    book_out := fs_join(DS_BOOKS_DIR, book_slug, bdir_buf[..]);
    if book_out == "" || !fs_mkdir(book_out) { return false; }

    has_root := false;
    rendered := 0;
    for ei: 0..<w[0].toc[0].n {
      ent := w[0].toc[0].entries[ei];
      if ent.is_part || ent.is_external { continue; }
      file := bk_entry_file(w[0].toc[..], ei);
      slug := bk_entry_slug(w[0].toc[..], ei);
      if slug.count == 0 { has_root = true; }

      fbuf: [4096] u8; obuf: [4096] u8;
      src_path := fs_join(book_dir, file, fbuf[..]);
      out_dir := ifx slug.count == 0 then book_out else fs_join(book_out, slug, obuf[..]);
      if src_path == "" || out_dir == "" { return false; }

      md_text := "";
      if fs_kind(src_path) == FS_FILE {
        rn := fs_read(src_path, w[0].raw[..]);
        if rn < 0 { return false; }
        md_text = cast(string) w[0].raw[0..<rn];
      } else {
        md_text = "# Planned Chapter\n\nThis chapter is listed in `SUMMARY.md` and has not been drafted yet.\n";
      }
      if !ds_emit_book_chapter(w[..], bi, ei, out_dir, md_text) { return false; }
      rendered += 1;
    }

    if !has_root {
      rbuf: [4096] u8;
      rm_path := fs_join(book_dir, "README.md", rbuf[..]);
      if rm_path != "" && fs_kind(rm_path) == FS_FILE {
        rn := fs_read(rm_path, w[0].raw[..]);
        if rn >= 0 {
          if !ds_emit_book_chapter(w[..], bi, -1, book_out, cast(string) w[0].raw[0..<rn]) { return false; }
        }
      }
    }
    counts[bi] = rendered;
    total_rendered += rendered;
  }

  idx_n := bk_render_books_index(counts[..], w[0].out[..]);
  if idx_n <= 0 || !fs_write("apps/openagents-web/build/docs-starter/books/index.html", cast(string) w[0].out[0..<idx_n]) {
    return false;
  }
  if fs_kind("docs/books/README.md") == FS_FILE {
    rn := fs_read("docs/books/README.md", w[0].raw[..]);
    if rn > 0 { _ = fs_write("apps/openagents-web/build/docs-starter/books/index.md", cast(string) w[0].raw[0..<rn]); }
  }
  cbuf: [32] u8;
  tool_err("docs-starter: prerendered ");
  tool_err(tr_join(cbuf[..], "", total_rendered));
  tool_errln(" book chapters across 8 books (0 KB JS/Wasm)");
  return true;
}

ds_watch :: (root: string, src: string, name: string) -> bool {
  a: [4096] u8; b: [4096] u8; c: [4096] u8;
  from := fs_join(root, src, a[..]);
  app := fs_join(root, DS_APP_DIR, b[..]);
  into := fs_join(app, name, c[..]);
  if from == "" || into == "" { return false; }
  argv := [4] string.["ln", "-sfn", from, into];
  return ds_run(argv[..]);
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) { tool_errln("usage: docs-starter [--serve] [--listen HOST:PORT]"); return 2; }
  serve := false;
  listen := "127.0.0.1:8820";
  i := 0;
  while i < args_count(args[..]) {
    a := args_at(args[..], i);
    if a == "--serve" { serve = true; i += 1; }
    else if a == "--listen" && i + 1 < args_count(args[..]) { listen = args_at(args[..], i + 1); i += 2; }
    else { tool_errln("usage: docs-starter [--serve] [--listen HOST:PORT]"); return 2; }
  }
  if fs_kind("apps/openagents-web/demos/docs-starter/page.coax") != FS_FILE {
    tool_errln("docs-starter: run from the repository root");
    return 2;
  }
  root_buf: [4096] u8; root := fs_cwd(root_buf[..]);
  if root == "" || !fs_mkdir("apps/openagents-web/build/docs-starter/build") {
    tool_errln("docs-starter: cannot create output directory");
    return 1;
  }
  wasm := [4] string.["coax/web/wasm.sh",
                      "apps/openagents-web/demos/docs-starter/page.coax",
                      "apps/openagents-web/demos/docs-starter/face.c",
                      "apps/openagents-web/build/docs-starter/build/docs-starter.wasm"];
  if !ds_run(wasm[..]) { return 1; }

  // Hybrid output:
  //   `/` hydrates with docs-starter.wasm; `/docs/*`, `/books/*`, & `404.html` are 0-KB-Wasm static SSR HTML + raw index.md!
  if !ds_emit_route(DS_APP_DIR, "index.html", 0, true) ||
     !ds_emit_route("apps/openagents-web/build/docs-starter/docs", "index.html", 1, false) ||
     !ds_emit_route("apps/openagents-web/build/docs-starter/docs/introduction", "index.html", 1, false) ||
     !ds_emit_route("apps/openagents-web/build/docs-starter/docs/getting-started", "index.html", 2, false) ||
     !ds_emit_route("apps/openagents-web/build/docs-starter/docs/roadmap", "index.html", 3, false) ||
     !ds_emit_route(DS_APP_DIR, "404.html", -1, false) ||
     !ds_write("apps/openagents-web/build/docs-starter/index.md", DS_INDEX_MD) {
    tool_errln("docs-starter: cannot write prerendered hybrid SSR routes");
    return 1;
  }
  if !ds_emit_all_books() {
    tool_errln("docs-starter: cannot write prerendered books");
    return 1;
  }
  if !ds_watch(root, "apps/openagents-web/demos/docs-starter/page.coax", "page.coax") ||
     !ds_watch(root, "apps/openagents-web/demos/docs-starter/books.coax", "books.coax") ||
     !ds_watch(root, "apps/openagents-web/demos/docs-starter/face.c", "face.c") ||
     !ds_watch(root, DS_BUILD_SRC, "build.coax") ||
     !ds_watch(root, "components/icons/apps-sdk", "build/icons") {
    tool_errln("docs-starter: cannot link watched sources");
    return 1;
  }
  if !serve {
    tool_errln("docs-starter: built hybrid site (/ hydrated Wasm + /docs/* & /books/* 0-KB-Wasm static SSR)");
    return 0;
  }
  sa: [4096] u8; sb: [4096] u8; q1: [8192] u8; q2: [8192] u8; cmd_buf: [16384] u8;
  script := fs_join(root, "coax/web/tool.sh", sa[..]);
  source := fs_join(root, DS_BUILD_SRC, sb[..]);
  qs := ds_quote(script, q1[..]); qt := ds_quote(source, q2[..]);
  if qs == "" || qt == "" || qs.count + qt.count + 1 > cmd_buf.count { return 1; }
  for k: 0..<qs.count { cmd_buf[k] = qs[k]; }
  cmd_buf[qs.count] = ' ';
  for k: 0..<qt.count { cmd_buf[qs.count + 1 + k] = qt[k]; }
  cmd := cast(string) cmd_buf[0..<qs.count + qt.count + 1];

  h := proc_new();
  if h < 0 { return 1; }
  ok := proc_arg(h, "coax/web/serve.sh") && proc_arg(h, DS_APP_DIR) &&
        proc_arg(h, "--listen") && proc_arg(h, listen) &&
        proc_arg(h, "--build") && proc_arg(h, cmd) &&
        proc_cwd(h, root) && proc_detach(h);
  if !ok || proc_start(h) != 0 { _ = proc_release(h); return 1; }
  pid := proc_pid(h); _ = proc_release(h);
  tool_err("docs-starter server PID "); print("%\n", pid);
  tool_err("docs-starter: http://"); tool_err(listen); tool_errln("/");
  return 0;
}
