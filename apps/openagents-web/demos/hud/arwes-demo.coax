// Interactive consumer of the source-derived ARWES Coax ports. State and
// pointer/actions belong to projects.coax; this file draws the same controls.
#load "../../../../aethyr/ui/arwes-draw.coax";

#test "the Arwes gallery covers every specimen once across its four groups" {
  seen:[25]int;
  for group:0..<4 {for i:0..<demo_arwes_count(group) {kind:=demo_arwes_kind(group,i);#assert kind>=0 && kind<25;seen[kind]+=1;}}
  for i:0..<25 {#assert seen[i]==1;}
}
#test "Arwes controls change the ported motion seed manager and silent cue model" {
  s:[1]ProjectsState;demo_arwes_reset(s[..]);demo_apply(s[..],19);#assert s[0].scene==5;
  demo_apply(s[..],201);#assert s[0].aw_group==1;
  before:=s[0].aw_easing;demo_apply(s[..],212);#assert s[0].aw_easing==(before+1)%31;
  demo_apply(s[..],216);#assert s[0].aw_manager==1;
  seed:=s[0].aw_seed;demo_apply(s[..],215);#assert s[0].aw_seed==seed+1;
  demo_apply(s[..],218);#assert s[0].aw_cues==1 && s[0].aw_bleep[0].playing;
  demo_apply(s[..],313);#assert s[0].inspected==1013;
}

demo_arwes_count :: (group:int)->int {return ifx group==0 then 9 else ifx group==1 then 6 else 5;}
demo_arwes_kind :: (group:int,index:int)->int {
  if group==0 {return index;}if group==1 {items:=[6]int.[14,15,16,17,18,24];return items[index];}
  if group==2 {return index+9;}return index+19;
}
demo_arwes_reset :: (s:[]ProjectsState) {
  s[0].aw_active=true;s[0].aw_started=s[0].time;s[0].aw_easing=AM_OUT_SINE;s[0].aw_seed=7;
  s[0].aw_motion[0]=ArMotion.{};ar_motion_to(s[0].aw_motion[..],true,1.2,AM_OUT_SINE);
  s[0].aw_bleep[0]=AxBleep.{loaded=true};s[0].aw_gain=0.6;s[0].aw_cues=0;
  demo_arwes_replay(s);
}
demo_arwes_replay :: (s:[]ProjectsState) {
  s[0].aw_active=true;s[0].aw_started=s[0].time;s[0].aw_motion[0]=ArMotion.{};
  ar_motion_to(s[0].aw_motion[..],true,1.2,s[0].aw_easing);
  ax_stop_all(s[0].aw_timers[..]);s[0].aw_timer_done=0;
  for i:0..<3 {ok:=ax_schedule(s[0].aw_timers[..],i,s[0].time,0.5+cast(f32)i*0.5,i+1);}
}
demo_arwes_apply :: (s:[]ProjectsState,id:int) {
  if id>=200 && id<204 {s[0].aw_group=id-200;s[0].scroll=0;s[0].focus=-1;}
  else if id==212 {s[0].aw_easing=(s[0].aw_easing+1)%31;}
  else if id==213 {s[0].aw_active=!s[0].aw_active;ar_motion_to(s[0].aw_motion[..],s[0].aw_active,1.2,s[0].aw_easing);}
  else if id==214 {demo_arwes_replay(s);}
  else if id==215 {s[0].aw_seed+=1;}
  else if id==216 {s[0].aw_manager=(s[0].aw_manager+1)%5;demo_arwes_replay(s);}
  else if id==217 {s[0].aw_category=(s[0].aw_category+1)%5;}
  else if id==218 {
    common:=AxBleepConfig.{volume=s[0].aw_gain,volume_set=true,loop=s[0].aw_loop,loop_set=true};
    ax_bleep_update(s[0].aw_bleep[..],common,0.8,false);effect:=ax_bleep_play(s[0].aw_bleep[..],s[0].aw_category,s[0].time);
    s[0].aw_cues+=1;s[0].aw_last_cue=s[0].time;
  }
  else if id==219 {s[0].aw_loop=!s[0].aw_loop;}
  else if id==220 {s[0].aw_gain+=0.2;if s[0].aw_gain>1 {s[0].aw_gain=0.2;}}
  else if id==221 {stopped:=ax_bleep_stop(s[0].aw_bleep[..],s[0].aw_category);}
  else if id==222 {s[0].aw_dots=(s[0].aw_dots+1)%3;}
  else if id==224 {s[0].aw_family=!s[0].aw_family;demo_arwes_replay(s);}
  else if id>=300 && id<325 {s[0].inspected=1000+id-300;s[0].focus=-1;}
}
demo_arwes_cell :: (s:[]ProjectsState,index:int,count:int)->HudBox {
  b:=hud_grid_cell(s[0].width,s[0].height,0,index,count);b.y+=108+demo_body_offset(s[0].width);return b;
}
demo_arwes_page :: (s:[]ProjectsState,out:[]f32,u:[]f32,at:int,p:HdPen)->int {
  base:=180.0f32+demo_body_offset(s[0].width);w:=s[0].width;count:=demo_arwes_count(s[0].aw_group);
  last:=demo_arwes_cell(s,count-1,count);s[0].scroll_max=ax_max(0,last.y+last.height+24-(s[0].height-44));
  s[0].scroll=ax_clamp(s[0].scroll,0,s[0].scroll_max);v:=at;body:=p;body.top=base+96;
  for i:0..<count {
    b:=demo_shift(demo_arwes_cell(s,i,count),s[0].scroll);if b.y+b.height<=body.top || b.y>=body.bottom {continue;}
    clipped:=b;clipped.y=ax_max(b.y,body.top);clipped.height=ax_min(b.y+b.height,body.bottom)-clipped.y;
    demo_glass(u,clipped,p.d);kind:=demo_arwes_kind(s[0].aw_group,i);v=hd_panel(out,v,b,body,s[0].hot==300+kind);
    v=hd_text_fit(out,v,AW_NAMES[kind],b.x+18,b.y+27,10,b.width-58,body,0);
    v=hd_line(out,v,b.x+18,b.y+41,b.x+b.width-18,b.y+41,body,1,0.35);
    content:=demo_box(b.x+18,b.y+54,b.width-36,b.height-85);
    v=demo_arwes_spec(s,out,v,kind,content,body);
    v=hd_text_fit(out,v,"ARWES / SOURCE PORT / INSPECT +",b.x+18,b.y+b.height-14,7,b.width-36,body,1);
    if clipped.height>=44 {demo_control(s,clipped,300+kind,AW_NAMES[kind]);}
  }
  labels:=[4]string.["FRAMES / 09","MOTION / 06","FIELDS / 05","TOKENS / 05"];
  narrow:=[4]string.["FRAME","MOTION","FIELDS","TOKEN"];
  cw:=(w-48)/4;
  for i:0..<4 {v=demo_button(s,out,v,demo_box(24+cast(f32)i*cw,base,cw-6,40),200+i,ifx w<700 then narrow[i] else labels[i],p,s[0].aw_group==i);}
  v=demo_button(s,out,v,demo_box(24,base+48,cw-6,40),214,"REPLAY",p,false);
  v=demo_button(s,out,v,demo_box(24+cw,base+48,cw-6,40),ifx s[0].aw_group==3 then 217 else 213,ifx s[0].aw_group==3 then "CATEGORY" else ifx s[0].aw_active then "EXIT" else "ENTER",p,false);
  third:=ifx s[0].aw_group==2 then 215 else ifx s[0].aw_group==3 then 218 else 212;
  fourth:=ifx s[0].aw_group==1 then 216 else ifx s[0].aw_group==2 then 222 else ifx s[0].aw_group==3 then 219 else 224;
  v=demo_button(s,out,v,demo_box(24+cw*2,base+48,cw-6,40),third,ifx third==215 then "RESEED" else ifx third==218 then "CUE" else "EASING",p,false);
  return demo_button(s,out,v,demo_box(24+cw*3,base+48,cw-6,40),fourth,ifx fourth==216 then "MANAGER" else ifx fourth==222 then "DOT TYPE" else ifx fourth==219 then (ifx s[0].aw_loop then "LOOP ON" else "LOOP OFF") else (ifx s[0].aw_family then "FAMILY" else "ASSEMBLY"),p,s[0].aw_family && fourth==224);
}
demo_arwes_spec :: (s:[]ProjectsState,out:[]f32,at:int,kind:int,b:HudBox,p:HdPen)->int {
  share:=ifx s[0].still then (ifx s[0].aw_active then 1.0f32 else 0.0f32) else ax_clamp(ar_motion_value(s[0].aw_motion[..]),0,1);
  elapsed:=ax_max(0,s[0].time-s[0].aw_started);progress:=ax_clamp(elapsed/2.5,0,1);v:=at;
  if kind<14 {
    if kind==9 && s[0].aw_dots!=0 {
      for i:0..<ax_dot_count(b,22) {
        d:=ax_dot(b,22,i,share,4,false,true);color:=aw_color(p,2,d.alpha*0.65);
        if s[0].aw_dots==1 {v=aw_quad(out,v,demo_box(d.x-2,d.y-2,4,4),0,0,0,color,p,6);}
        else {v=aw_quad(out,v,demo_box(d.x-3,d.y-0.7,6,1.4),0,0,0,color,p,6);v=aw_quad(out,v,demo_box(d.x-0.7,d.y-3,1.4,6),0,0,0,color,p,6);}
      }return v;
    }
    if kind<9 && s[0].aw_family {
      motion:=s[0].aw_motion[0];phase:=ifx s[0].still || motion.duration<=0 then 1.0f32 else ax_clamp(motion.elapsed/motion.duration,0,1);
      v=aw_frame_family(out,v,kind,b,p,phase,s[0].aw_active);
    } else {v=aw_visual(out,v,kind,b,p,s[0].time,share,s[0].aw_seed,s[0].pointer_x,s[0].pointer_y);}
    if kind<9 && share>0.85 {
      cap:=ax_min(12,b.width/22);x:=b.x+b.width*0.5;
      title:="AETHYR / ONLINE";ink:=hd_ink(p,2);ink.scale=1;width:=ink_width(title,cap,0.22,0.72,ink);
      v=hd_text_fit(out,v,title,x-width*0.5,b.y+b.height*0.49,cap,b.width-24,p,2);
      v=hd_text_fit(out,v,"FRAME ASSEMBLY / COAX",b.x+ax_max(12,b.width*0.25),b.y+b.height*0.66,7,b.width*0.6,p,1);
    }
    return v;
  }
  if kind==14 || kind==15 {
    text:="AETHYR / SYSTEM ONLINE";buffer:[1024]u8;n:=0;
    revealed:=ifx s[0].still then share else progress*share;
    if kind==14 {n=ar_text_sequence(text,revealed,true,buffer[..]);}
    else {n=ar_text_decipher(text,revealed,true,s[0].aw_seed,cast(int)floor(elapsed*20),buffer[..]);}
    if n>=0 {v=hd_text_fit(out,v,cast(string)buffer[0..<n],b.x+6,b.y+b.height*0.5,16,b.width-12,p,2);}
    return hd_text_fit(out,v,ifx kind==14 then "SEQUENCE / UNICODE SCALARS" else "DECIPHER / SEEDED SHUFFLE",b.x+6,b.y+b.height-5,8,b.width-12,p,1);
  }
  if kind==16 {return demo_arwes_easing(s,out,v,b,p);}
  if kind==17 {
    children:[5]ArChild;for i:0..<5 {children[i]=ArChild.{enter=0.45,exit=0.3,allowed=true};}
    span:=ar_children_duration(children[..],s[0].aw_manager,0.18);clock:=ifx s[0].still then span else elapsed;
    for i:0..<5 {
      timing:=ar_child_timing(children[..],i,s[0].aw_manager,0.18,false);q:=ax_clamp((clock-timing.start)/0.45,0,1)*share;
      box:=demo_box(b.x+cast(f32)i*(b.width/5),b.y+20,b.width/5-8,b.height-52);
      v=aw_frame(out,v,3,box,p,q);
    }
    labels:=[5]string.["PARALLEL","SEQUENCE","STAGGER","SEQUENCE REVERSE","STAGGER REVERSE"];
    return hd_text_fit(out,v,labels[s[0].aw_manager],b.x+4,b.y+b.height-4,9,b.width-8,p,2);
  }
  if kind==18 {
    for i:0..<7 {a:=ar_flicker(ax_clamp(progress+cast(f32)i*0.06,0,1),s[0].aw_active);v=aw_quad(out,v,demo_box(b.x+cast(f32)i*b.width/7,b.y+25,b.width/7-8,55),0,0,0,aw_color(p,2,a*0.7),p,6);}
    return hd_text_fit(out,v,"0 > 1 > 0.5 > 1 / OUT SINE",b.x+4,b.y+b.height-4,8,b.width-8,p,1);
  }
  if kind>=19 && kind<=21 {
    stops:=[3]f32.[8,12,20];inks:=[3]f32.[0.8,0.1,0.4];
    for i:0..<cast(int)b.width {
      x:=cast(f32)i;alpha:=ifx kind==19 then ax_steps_mask(x/b.width,18) else ifx kind==20 then ax_strip(x,stops[..],inks[..]) else ax_separator(x,b.width,12,6,true,true);
      v=aw_quad(out,v,demo_box(b.x+x,b.y+36,1,32),0,0,0,aw_color(p,2,alpha*share),p,6);
    }
    return hd_text_fit(out,v,ifx kind==19 then "ALTERNATING 2N-1 INTERVALS" else ifx kind==20 then "REPEATING HARD COLOR STOPS" else "ACTIVE ENDS / STATIC CENTER",b.x+4,b.y+b.height-5,8,b.width-8,p,1);
  }
  if kind==22 {
    for i:0..<8 {
      level:=cast(f32)i/7;color:=ifx p.cyan then ax_hsl(180,68,18+level*60,1,share) else ax_rgb((18+level*76),(18+level*76),(18+level*76),1,share);
      v=aw_quad(out,v,demo_box(b.x+cast(f32)i*b.width/8,b.y+26,b.width/8-5,48),0,0,0,color,p,6);
    }
    return hd_text_fit(out,v,"HSL / RGB / HWB   SPACE 4 x INDEX",b.x+4,b.y+b.height-5,8,b.width-8,p,1);
  }
  if kind==23 {
    labels:=[5]string.["BACKGROUND","TRANSITION","INTERACTION","NOTIFICATION","VOICE"];
    for i:0..<5 {
      y:=b.y+13+cast(f32)i*(b.height-24)/5;active:=i==s[0].aw_category;
      v=hd_text_fit(out,v,labels[i],b.x+3,y,8,b.width*0.52,p,ifx active then 2 else 1);
      width:=(b.width*0.42)*(ifx active && s[0].aw_cues>0 then s[0].aw_bleep[0].gain else 0.12f32);
      v=aw_quad(out,v,demo_box(b.x+b.width*0.55,y-6,width,5),0,0,0,aw_color(p,ifx active then 2 else 1,0.8),p,6);
    }
    return hd_text_fit(out,v,"SILENT / COMMON > CATEGORY > NAMED",b.x+3,b.y+b.height-3,7,b.width-6,p,1);
  }
  if kind==24 {
    for i:0..<3 {y:=b.y+18+cast(f32)i*32;pending:=ax_pending(s[0].aw_timers[..],i);
      v=hd_diamond(out,v,b.x+9,y-4,4,p,ifx pending then 1 else 2);
      labels:=[3]string.["FRAME / 0.5 S","TEXT / 1.0 S","SIGNAL / 1.5 S"];
      v=hd_text_fit(out,v,labels[i],b.x+25,y,9,b.width-28,p,ifx pending then 1 else 2);
    }
    return hd_text_fit(out,v,"KEYED REPLACE / STOP / FIFO",b.x+4,b.y+b.height-3,8,b.width-8,p,1);
  }
  return v;
}
demo_arwes_easing :: (s:[]ProjectsState,out:[]f32,at:int,b:HudBox,p:HdPen)->int {
  v:=at;plot:=demo_box(b.x+10,b.y+10,b.width-20,b.height-38);
  v=hd_rect(out,v,plot,p,3,0.35);last:=HudCoord.{x=plot.x,y=plot.y+plot.height*0.8};
  for i:0..<81 {t:=cast(f32)i/80;q:=HudCoord.{x=plot.x+t*plot.width,y=plot.y+plot.height*(0.8-0.6*ar_ease(s[0].aw_easing,t))};
    if i>0 {v=aw_stroke(out,v,last,q,plot,p,2,0.95,1.3);}last=q;
  }
  families:=[11]string.["LINEAR","QUADRATIC","CUBIC","QUARTIC","QUINTIC","SINE","EXPONENTIAL","CIRCULAR","BACK","ELASTIC","BOUNCE"];
  family:=ifx s[0].aw_easing==0 then 0 else (s[0].aw_easing-1)/3+1;
  return hd_text_fit(out,v,families[family],b.x+4,b.y+b.height-4,9,b.width-8,p,0);
}
