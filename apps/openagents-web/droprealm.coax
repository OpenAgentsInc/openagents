// A project's first realm, made from its drop (rc-first-realm; docs/projects/new-project.md
// Part 2): the 3D models someone dropped, placed on an empty floor so the
// project has somewhere to walk on day one. When the owner publishes a drop,
// the API (coax/web/api/drops.c) packs the drop's models into one asset pack
// (the realm host's VPK1, docs/verse/realm-host.md) and writes a page at
// /projects/<slug>/realm that opens this module on it. /realms/drop is the
// same realm on the fixture's pack, so every build names this module's files
// and the release walk checks it.
//
// The models stand in a ring round where you start, each facing in, stood on
// the floor and centred where it stands; one bigger than MAX_SIZE is scaled
// down, one smaller than MIN_SIZE (a model made in centimetres read as
// metres, say) up. You carry a lamp and walk among them: W and S (or the up
// and down arrows) walk, A and D (or left and right) turn, a mouse drag
// turns, and on a phone one thumb drags to walk and turn. The camera follows
// behind you. You can't walk into a model or off the floor. PROJECT (or
// Escape) goes back to the project's page.
//
// The page's data-text names the realm: its name, then on the next line the
// project's page. droprealm.wgsl draws the floor, the pack's meshes lit by
// your lamp, and the strokes over them; droprealm-face.c binds it.
//   coax/bin/coax test apps/openagents-web/droprealm.coax

#load "font.coax";
#load "ui.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, 0, 0, 0, 0
MAX_VERTICES :: 24000;
PLATES :: 16;
// width, height, time, fade, still, plates, dpr, 0; the view's four rows; the
// lamp (x, y, z, strength); the eye (x, y, z, the floor's radius) and the
// rays through the screen (forward, then the right and up steps per unit of
// the screen's -1..1); then per plate x0, y0, x1, y1, scale, alpha, look, 0
VIEW_AT :: 8; LAMP_AT :: 24; EYE_AT :: 28; RAY_AT :: 32;
PANEL_AT :: 44;
UNIFORM_FLOATS :: PANEL_AT + PLATES * 8;

MODE_STROKE :: 0.0;
MODE_BAR :: 4.0;   // ui.coax's

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow.
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}
// A round light: a disc of radius radius in a glow.
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// ---- the realm's state, kept by the host

MSG_DATA_TEXT :: 2;     // host.js: the page's data-text, "NAME\n/projects/<slug>"
HOST_FACTS :: 600;      // host.js: the page facts
MSG_PACK :: 605;        // host.js: the pack streams, "LOADED TOTAL"
OUTBOX :: 256;
HOLD_UP :: 1; HOLD_DOWN :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8;
BTN_BACK :: 0; BUTTONS :: 1;
// The pack: its catalog is asset 0, its vertices, indices and layers 1 to 3 (host.js pack:URL).
MESHES :: 24; LICENCES :: 24; NAME :: 32; LICENCE_NAME :: 64; TITLE :: 80; LINK :: 128;
INSTANCE_FLOATS :: 16;  // per mesh drawn: three rows of its transform, then tint and glow
WALK :: 3.2;            // metres a second
TURN :: 1.9;            // radians a second
BODY :: 0.35;           // your radius, metres
MAX_SIZE :: 5.0;        // the most a model may measure (its longest side), metres
MIN_SIZE :: 0.3;        // a model smaller than this is shown at GROWN
GROWN :: 1.0;
GAP_BETWEEN :: 1.6;     // metres between neighbours on the ring
CAM_BACK :: 6.0; CAM_UP :: 3.2; LOOK_AHEAD :: 2.0; LOOK_UP :: 1.0;
FOV :: 0.95;            // radians, top to bottom
STICK :: 60.0;          // CSS pixels of thumb travel for full speed
LAMP_HEIGHT :: 1.35;

DropRealm :: struct {
  started: bool;
  time: f32; width: f32; height: f32; dpr: f32; still: bool;
  x: f32; z: f32; yaw: f32;  // you: where you stand (metres) and the way you face (0 looks along -z)
  held: int;
  stick: bool; stick_id: int; stick_x0: f32; stick_y0: f32; stick_dx: f32; stick_dy: f32;   // a thumb
  turning: bool; turn_id: int; turn_x: f32;                                                 // a mouse drag
  walked: f32;               // metres walked this visit
  name: [TITLE] u8; name_n: int; back: [LINK] u8; back_n: int;
  press: int; hover: int;
  boxes: [BUTTONS] Box; shown: [BUTTONS] bool;
  outbox: [OUTBOX] u8; out_n: int; action: int;
  plates: [PLATES] Box; plate_look: [PLATES] f32; plate_alpha: [PLATES] f32; plate_n: int;
  // the pack: how it streams, then its catalog
  loaded: int; total: int; pack_ready: bool; pack_failed: bool;
  pack_bytes: int; textures: int;
  mesh_n: int; mesh_name: [MESHES * NAME] u8; mesh_name_n: [MESHES] int;
  mesh_first: [MESHES] int; mesh_count: [MESHES] int; mesh_licence: [MESHES] int;
  mesh_box: [MESHES * 6] f32;  // its bounds, metres: x0, y0, z0, x1, y1, z1
  licence_n: int; licence: [LICENCES * LICENCE_NAME] u8; licence_len: [LICENCES] int;
  // where each model stands: a circle on the floor you can't walk into
  model_n: int; spot_x: [MESHES] f32; spot_z: [MESHES] f32; spot_r: [MESHES] f32;
  floor_r: f32;
  // the scene the host draws: [first, count, base instance, instances] a mesh, and their transforms
  draws: [MESHES * 4] u32; draw_n: int;
  objects: [MESHES * INSTANCE_FLOATS] f32;
  view: [16] f32;            // clip = rows · world
  eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32;
}

realm_reset :: (s: [] DropRealm) {
  s[0].started = true; s[0].press = -1; s[0].hover = -1; s[0].stick_id = -1; s[0].turn_id = -1;
  s[0].floor_r = 8;
}

int_at :: (text: string, at: [] int) -> int {
  i := at[0]; neg := false; v := 0; digits := 0;
  while i < text.count && text[i] == ' ' { i += 1; }
  if i < text.count && text[i] == '-' { neg = true; i += 1; }
  while i < text.count && text[i] >= '0' && text[i] <= '9' && digits < 9 { v = v * 10 + cast(int) (text[i] - '0'); i += 1; digits += 1; }
  at[0] = ifx digits > 0 then i else -1;
  return ifx neg then -v else v;
}
// A decimal ("-0.243") from at[0]; at[0] is then past it, or -1 when there is none.
decimal_at :: (text: string, at: [] int) -> f32 {
  i := at[0];
  while i < text.count && text[i] == ' ' { i += 1; }
  neg := i < text.count && text[i] == '-';
  at[0] = i;
  whole := int_at(text, at);
  if at[0] < 0 { return 0; }
  v := cast(f32) (ifx whole < 0 then -whole else whole);
  i = at[0];
  if i < text.count && text[i] == '.' {
    i += 1; step: f32 = 0.1;
    while i < text.count && text[i] >= '0' && text[i] <= '9' { v += step * cast(f32) (text[i] - '0'); step *= 0.1; i += 1; }
    at[0] = i;
  }
  return ifx neg then -v else v;
}

// ---- in from the host

realm_message :: (s: [] DropRealm, kind: int, text: string) #export_c {
  if !s[0].started { realm_reset(s); }
  if kind == MSG_PACK {
    at: [1] int;
    s[0].loaded = int_at(text, at[..]); if at[0] < 0 { return; }
    s[0].total = int_at(text, at[..]); if at[0] < 0 { s[0].total = 0; }
    return;
  }
  if kind == MSG_DATA_TEXT {
    e := 0; while e < text.count && text[e] != '\n' { e += 1; }
    s[0].name_n = put(s[0].name[..], 0, text[0..<e]);
    link := ifx e + 1 < text.count then text[e + 1..<text.count] else "";
    // only a page of this site: a path, never a scheme
    if link.count > 1 && link[0] == '/' && link[1] != '/' { s[0].back_n = put(s[0].back[..], 0, link); }
  }
}

hold_of :: (key: int) -> int {
  if key == KEY_UP || key == 'w' || key == 'W' { return HOLD_UP; }
  if key == KEY_DOWN || key == 's' || key == 'S' { return HOLD_DOWN; }
  if key == KEY_LEFT || key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == KEY_RIGHT || key == 'd' || key == 'D' { return HOLD_RIGHT; }
  return 0;
}
realm_key :: (s: [] DropRealm, key: int, down: bool) -> bool #export_c {
  if !s[0].started { realm_reset(s); }
  h := hold_of(key);
  if h != 0 { s[0].held = ifx down then s[0].held | h else s[0].held & (15 - h); return true; }
  if down && key == KEY_ESCAPE { leave(s); return true; }
  return false;
}
realm_blur :: (s: [] DropRealm) #export_c { s[0].held = 0; s[0].stick = false; s[0].turning = false; s[0].press = -1; }

back_url :: (s: [] DropRealm) -> string { return ifx s[0].back_n > 0 then cast(string) s[0].back[0..<s[0].back_n] else "/verse/galaxy"; }
leave :: (s: [] DropRealm) { if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, back_url(s)); s[0].action = ACT_NAVIGATE; } }

button_at :: (s: [] DropRealm, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if s[0].shown[i] && inside(s[0].boxes[i], x, y) { return i; } }
  return -1;
}
// A press off the buttons: a thumb (touch, pen) walks and turns; a mouse turns.
realm_pointer :: (s: [] DropRealm, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if !s[0].started { realm_reset(s); }
  b := button_at(s, x, y);
  s[0].hover = ifx kind == 0 && phase != POINTER_CANCEL then b else -1;
  if phase == POINTER_DOWN {
    if b >= 0 { s[0].press = b; return true; }
    if kind == 0 { s[0].turning = true; s[0].turn_id = id; s[0].turn_x = x; return true; }
    s[0].stick = true; s[0].stick_id = id; s[0].stick_x0 = x; s[0].stick_y0 = y; s[0].stick_dx = 0; s[0].stick_dy = 0;
    return true;
  }
  if s[0].press >= 0 {
    if phase == POINTER_UP && b == s[0].press && b == BTN_BACK { leave(s); }
    if phase != POINTER_MOVE { s[0].press = -1; }
    return true;
  }
  if s[0].stick && id == s[0].stick_id {
    if phase == POINTER_MOVE {
      reach := STICK * hi(s[0].dpr, 0.5);
      s[0].stick_dx = clamp((x - s[0].stick_x0) / reach, -1, 1); s[0].stick_dy = clamp((y - s[0].stick_y0) / reach, -1, 1);
    } else { s[0].stick = false; s[0].stick_dx = 0; s[0].stick_dy = 0; }
    return true;
  }
  if s[0].turning && id == s[0].turn_id {
    if phase == POINTER_MOVE { s[0].yaw += (x - s[0].turn_x) / hi(s[0].width, 1) * 3.1415927; s[0].turn_x = x; }
    else { s[0].turning = false; }
    return true;
  }
  return false;
}
realm_cursor :: (s: [] DropRealm) -> int #export_c { return ifx s[0].hover >= 0 then 1 else 0; }
realm_action :: (s: [] DropRealm) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
realm_action_done :: (s: [] DropRealm) #export_c { s[0].out_n = 0; }

// ---- the pack's catalog (docs/verse/realm-host.md): a line each

realm_catalog :: (s: [] DropRealm, text: string) #export_c {
  if !s[0].started { realm_reset(s); }
  s[0].mesh_n = 0; s[0].licence_n = 0; s[0].textures = 0;
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    catalog_line(s, text[i..<e]);
    i = e + 1;
  }
  s[0].pack_ready = true;
  place(s);
}
word_end :: (line: string, from: int) -> int { e := from; while e < line.count && line[e] != ' ' { e += 1; } return e; }
catalog_line :: (s: [] DropRealm, line: string) {
  if line.count < 2 { return; }
  at: [1] int;
  if line.count > 6 && line[0..<6] == "bytes " { at[0] = 6; s[0].pack_bytes = int_at(line, at[..]); return; }
  if line[1] != ' ' { return; }
  if line[0] == 'L' {
    at[0] = 2; k := int_at(line, at[..]);
    if at[0] < 0 || k != s[0].licence_n || k >= LICENCES { return; }
    pipe := at[0] + 1; while pipe < line.count && line[pipe] != '|' { pipe += 1; }
    lic := pipe + 1; lic_end := lic; while lic_end < line.count && line[lic_end] != '|' { lic_end += 1; }
    row := s[0].licence[k * LICENCE_NAME..<(k + 1) * LICENCE_NAME];
    n := put(row, 0, line[at[0] + 1..<pipe]);
    if lic < line.count { n = put(row, n, " · "); n = put(row, n, line[lic..<lic_end]); }
    s[0].licence_len[k] = n; s[0].licence_n = k + 1;
    return;
  }
  if line[0] == 'M' {
    e := word_end(line, 2);
    at[0] = e; first := int_at(line, at[..]); if at[0] < 0 { return; }
    count := int_at(line, at[..]); if at[0] < 0 { return; }
    k := int_at(line, at[..]); if at[0] < 0 { return; }
    m := s[0].mesh_n;
    if m >= MESHES || first < 0 || count <= 0 { return; }
    for j: 0..<6 {
      v := decimal_at(line, at[..]);
      if at[0] < 0 { return; }
      s[0].mesh_box[m * 6 + j] = v;
    }
    s[0].mesh_name_n[m] = put(s[0].mesh_name[m * NAME..<(m + 1) * NAME], 0, line[2..<e]);
    s[0].mesh_first[m] = first; s[0].mesh_count[m] = count; s[0].mesh_licence[m] = k; s[0].mesh_n = m + 1;
    return;
  }
  if line[0] == 'T' { s[0].textures += 1; }
}
mesh_name :: (s: [] DropRealm, m: int) -> string { return cast(string) s[0].mesh_name[m * NAME..<m * NAME + s[0].mesh_name_n[m]]; }
licence_name :: (s: [] DropRealm, k: int) -> string { return cast(string) s[0].licence[k * LICENCE_NAME..<k * LICENCE_NAME + s[0].licence_len[k]]; }
ends_with :: (text: string, tail: string) -> bool { return text.count >= tail.count && text[text.count - tail.count..<text.count] == tail; }
// A mesh named X_Leaves is the leaves of the tree before it (the kits'): it stands where the tree does.
rides :: (s: [] DropRealm, m: int) -> bool { return m > 0 && ends_with(mesh_name(s, m), "_Leaves"); }

// The scale a model is shown at, from its longest side.
fit_scale :: (size: f32) -> f32 {
  if size > MAX_SIZE { return MAX_SIZE / size; }
  if size > 0 && size < MIN_SIZE { return GROWN / size; }
  return 1;
}

// The models in a ring round the middle, where you start, each facing in, stood on the floor.
place :: (s: [] DropRealm) {
  // first each model's bounds (a tree with its leaves), scale and footprint
  b: [MESHES * 6] f32; scale: [MESHES] f32; foot: [MESHES] f32; owner: [MESHES] int;
  n := 0;
  for m: 0..<s[0].mesh_n {
    if rides(s, m) && n > 0 {
      o := (n - 1) * 6;
      for j: 0..<3 { b[o + j] = lo(b[o + j], s[0].mesh_box[m * 6 + j]); b[o + 3 + j] = hi(b[o + 3 + j], s[0].mesh_box[m * 6 + 3 + j]); }
      owner[m] = n - 1;
      continue;
    }
    for j: 0..<6 { b[n * 6 + j] = s[0].mesh_box[m * 6 + j]; }
    owner[m] = n;
    n += 1;
  }
  arc: f32 = 0; widest: f32 = 0;
  for i: 0..<n {
    o := i * 6;
    dx := b[o + 3] - b[o]; dy := b[o + 4] - b[o + 1]; dz := b[o + 5] - b[o + 2];
    scale[i] = fit_scale(hi(dx, hi(dy, dz)));
    foot[i] = 0.5 * hi(dx, dz) * scale[i];
    arc += 2 * foot[i] + GAP_BETWEEN;
    widest = hi(widest, foot[i]);
  }
  ring := hi(hi(4.0, arc / 6.2831853), widest + 2.5);
  s[0].model_n = n;
  s[0].floor_r = ring + widest + 3;
  along: f32 = 0;
  for i: 0..<n {
    a := (along + foot[i] + GAP_BETWEEN * 0.5) / hi(arc, 0.001) * 6.2831853;
    along += 2 * foot[i] + GAP_BETWEEN;
    s[0].spot_x[i] = ring * sin(a); s[0].spot_z[i] = -ring * cos(a); s[0].spot_r[i] = foot[i];
  }
  s[0].draw_n = 0;
  for m: 0..<s[0].mesh_n {
    i := owner[m];
    a := atan_spot(s, i);
    k := scale[i]; c := cos(-a); sn := sin(-a);
    o := i * 6;
    cx := 0.5 * (b[o] + b[o + 3]); cz := 0.5 * (b[o + 2] + b[o + 5]); base := b[o + 1];
    x := s[0].spot_x[i]; z := s[0].spot_z[i];
    t := m * INSTANCE_FLOATS;
    s[0].objects[t] = c * k; s[0].objects[t + 1] = 0; s[0].objects[t + 2] = sn * k; s[0].objects[t + 3] = x - k * (c * cx + sn * cz);
    s[0].objects[t + 4] = 0; s[0].objects[t + 5] = k; s[0].objects[t + 6] = 0; s[0].objects[t + 7] = -k * base;
    s[0].objects[t + 8] = -sn * k; s[0].objects[t + 9] = 0; s[0].objects[t + 10] = c * k; s[0].objects[t + 11] = z - k * (-sn * cx + c * cz);
    s[0].objects[t + 12] = 1; s[0].objects[t + 13] = 1; s[0].objects[t + 14] = 1; s[0].objects[t + 15] = 0;
    d := s[0].draw_n * 4;
    s[0].draws[d] = cast(u32) s[0].mesh_first[m]; s[0].draws[d + 1] = cast(u32) s[0].mesh_count[m];
    s[0].draws[d + 2] = cast(u32) m; s[0].draws[d + 3] = 1;
    s[0].draw_n += 1;
  }
}
// The angle a spot stands at round the ring (0 straight ahead of where you start, along -z).
atan_spot :: (s: [] DropRealm, i: int) -> f32 {
  x := s[0].spot_x[i]; z := -s[0].spot_z[i];
  r := sqrt(x * x + z * z);
  if r <= 0 { return 0; }
  a := acos_unit(z / r);
  return ifx x < 0 then -a else a;
}
// acos on -1..1, from atan's series through half angles (no library here).
acos_unit :: (c: f32) -> f32 {
  t := clamp(c, -1, 1);
  // acos(t) = 2 atan(sqrt((1 - t) / (1 + t)))
  if t <= -0.999999 { return 3.1415927; }
  return 2 * atan_pos(sqrt((1 - t) / (1 + t)));
}
// atan for v >= 0.
atan_pos :: (v: f32) -> f32 {
  if v > 1 { return 1.5707963 - atan_pos(1 / v); }
  // two halvings, then the series
  h := v / (1 + sqrt(1 + v * v));
  h = h / (1 + sqrt(1 + h * h));
  h2 := h * h;
  return 4 * h * (1 - h2 / 3 + h2 * h2 / 5 - h2 * h2 * h2 / 7);
}
realm_pack_failed :: (s: [] DropRealm) #export_c { if !s[0].pack_ready { s[0].pack_failed = true; } }
realm_draw_count :: (s: [] DropRealm) -> int #export_c { return ifx s[0].pack_ready then s[0].draw_n else 0; }

// ---- walking

// You, moved from (x, z) by (dx, dz), kept out of every model and on the floor.
Spot :: struct { x: f32; z: f32; }
walk_to :: (s: [] DropRealm, x: f32, z: f32, dx: f32, dz: f32) -> Spot {
  p := Spot.{x = x + dx, z = z + dz};
  for pass: 0..<2 {
    for i: 0..<s[0].model_n {
      ox := p.x - s[0].spot_x[i]; oz := p.z - s[0].spot_z[i];
      d := sqrt(ox * ox + oz * oz); room := s[0].spot_r[i] + BODY;
      if d >= room { continue; }
      if d < 0.0001 { ox = 0; oz = 1; d = 1; }
      p.x = s[0].spot_x[i] + ox / d * room; p.z = s[0].spot_z[i] + oz / d * room;
    }
    r := sqrt(p.x * p.x + p.z * p.z); edge := s[0].floor_r - BODY;
    if r > edge { p.x *= edge / r; p.z *= edge / r; }
  }
  return p;
}

realm_step :: (s: [] DropRealm, dt: f32) {
  step := clamp(dt, 0, 0.1);
  s[0].time += step;
  ahead := 0.0f32; turn := 0.0f32;
  if (s[0].held & HOLD_UP) != 0 { ahead += 1; }
  if (s[0].held & HOLD_DOWN) != 0 { ahead -= 1; }
  if (s[0].held & HOLD_LEFT) != 0 { turn -= 1; }
  if (s[0].held & HOLD_RIGHT) != 0 { turn += 1; }
  if s[0].stick { ahead -= s[0].stick_dy; turn += s[0].stick_dx; }
  ahead = clamp(ahead, -1, 1); turn = clamp(turn, -1, 1);
  s[0].yaw += turn * TURN * step;
  if ahead != 0 {
    fx := sin(s[0].yaw); fz := -cos(s[0].yaw);
    speed := ifx ahead < 0 then ahead * 0.6 else ahead;
    p := walk_to(s, s[0].x, s[0].z, fx * speed * WALK * step, fz * speed * WALK * step);
    mx := p.x - s[0].x; mz := p.z - s[0].z;
    s[0].walked += sqrt(mx * mx + mz * mz);
    s[0].x = p.x; s[0].z = p.z;
  }
}

// ---- the view: behind you and above, looking a little ahead of you

view_rows :: (s: [] DropRealm) {
  aspect := s[0].width / hi(s[0].height, 1);
  fx0 := sin(s[0].yaw); fz0 := -cos(s[0].yaw);
  ex := s[0].x - fx0 * CAM_BACK; ey: f32 = CAM_UP; ez := s[0].z - fz0 * CAM_BACK;
  ax := s[0].x + fx0 * LOOK_AHEAD; ay: f32 = LOOK_UP; az := s[0].z + fz0 * LOOK_AHEAD;
  fx := ax - ex; fy := ay - ey; fz := az - ez;
  fl := sqrt(fx * fx + fy * fy + fz * fz); fx /= fl; fy /= fl; fz /= fl;
  rx := -fz; rz := fx; rl := sqrt(rx * rx + rz * rz); rx /= rl; rz /= rl;   // f × (0, 1, 0)
  ux := -rz * fy; uy := rz * fx - rx * fz; uz := rx * fy;                    // r × f
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 0.9; sy = sx * aspect; }   // a phone: wider than tall would show
  zn: f32 = 0.1; zf: f32 = 200.0;
  a := zf / (zn - zf); b := zn * zf / (zn - zf);
  v := s[0].view[..];
  v[0] = sx * rx; v[1] = 0; v[2] = sx * rz; v[3] = -sx * (rx * ex + rz * ez);
  v[4] = sy * ux; v[5] = sy * uy; v[6] = sy * uz; v[7] = -sy * (ux * ex + uy * ey + uz * ez);
  v[8] = -a * fx; v[9] = -a * fy; v[10] = -a * fz; v[11] = a * (fx * ex + fy * ey + fz * ez) + b;
  v[12] = fx; v[13] = fy; v[14] = fz; v[15] = -(fx * ex + fy * ey + fz * ez);
  // the rays the floor is drawn from: forward + nx · right + ny · up, nx and ny the screen's -1..1
  s[0].eye[0] = ex; s[0].eye[1] = ey; s[0].eye[2] = ez;
  s[0].fwd[0] = fx; s[0].fwd[1] = fy; s[0].fwd[2] = fz;
  s[0].right[0] = rx / sx; s[0].right[1] = 0; s[0].right[2] = rz / sx;
  s[0].up[0] = ux / sy; s[0].up[1] = uy / sy; s[0].up[2] = uz / sy;
}
Seen :: struct { x: f32; y: f32; ok: bool; }
// A world point on the screen, device pixels.
seen :: (s: [] DropRealm, x: f32, y: f32, z: f32) -> Seen {
  v := s[0].view[..];
  cx := v[0] * x + v[1] * y + v[2] * z + v[3];
  cy := v[4] * x + v[5] * y + v[6] * z + v[7];
  cw := v[12] * x + v[13] * y + v[14] * z + v[15];
  if cw < 0.01 { return Seen.{x = 0, y = 0, ok = false}; }
  return Seen.{x = (cx / cw * 0.5 + 0.5) * s[0].width, y = (0.5 - cy / cw * 0.5) * s[0].height, ok = true};
}

// ---- the look (verse.coax's)

GAP :: 0.5; SPACE :: 1.2;
PARCH_R :: 0.91; PARCH_G :: 0.863; PARCH_B :: 0.753;
GOLD_R :: 0.80; GOLD_G :: 0.64; GOLD_B :: 0.36;
EMBER_R :: 1.0; EMBER_G :: 0.9; EMBER_B :: 0.62;   // lit gold: orange is only for Bitcoin
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;
white :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, PARCH_R, PARCH_G, PARCH_B); }
bronze :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, GOLD_R, GOLD_G, GOLD_B); }

plate :: (s: [] DropRealm, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  s[0].plates[n] = b; s[0].plate_alpha[n] = alpha; s[0].plate_look[n] = look; s[0].plate_n = n + 1;
}
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  w := measure(text, GAP, SPACE, false) * cap;
  return write(d, out, at, text, x - w * 0.5, base, cap, GAP, SPACE, k, false, false);
}
fit_cap :: (text: string, cap: f32, width: f32) -> f32 { return lo(cap, width / hi(measure(text, GAP, SPACE, false), 0.001)); }
upper :: (buf: [] u8, n: int) { for i: 0..<n { if buf[i] >= 'a' && buf[i] <= 'z' { buf[i] -= 32; } } }
put_kb :: (buf: [] u8, at: int, bytes: int) -> int {
  kb := (bytes + 512) / 1024;
  n := at;
  if kb >= 1000 { n = put_int(buf, n, kb / 1000); n = put(buf, n, ","); r := kb % 1000; if r < 100 { n = put(buf, n, "0"); } if r < 10 { n = put(buf, n, "0"); } n = put_int(buf, n, r); }
  else { n = put_int(buf, n, kb); }
  return put(buf, n, " KB");
}

PANEL_LINE :: 15.0;
PANEL_ROWS :: 8;
// The pack: while it streams, a line and a bar; once in, what stands here and whose it is.
draw_pack :: (s: [] DropRealm, out: [] f32, at: int, top: f32) -> int {
  k := s[0].dpr; w := s[0].width; d := k; g := 16 * k;
  vertices := at;
  buf: [160] u8;
  if !s[0].pack_ready || s[0].model_n == 0 {
    n := 0;
    if s[0].pack_ready { n = put(buf[..], 0, "NO MODELS TO PLACE YET: DROP A .GLB ON THE PROJECT"); }
    else if s[0].pack_failed { n = put(buf[..], 0, "THE REALM'S MODELS DIDN'T ARRIVE"); }
    else {
      n = put(buf[..], 0, "BRINGING IN THE MODELS ");
      if s[0].total > 0 { n = put_kb(buf[..], n, s[0].loaded); n = put(buf[..], n, " OF "); n = put_kb(buf[..], n, s[0].total); }
    }
    line := cast(string) buf[0..<n];
    bw := lo(w - 2 * g, 420 * k);
    b := Box.{x0 = g, y0 = top, x1 = g + bw, y1 = top + 40 * k};
    plate(s, b, 0.92, LOOK_PLAIN);
    vertices = write(d, out, vertices, line, b.x0 + 14 * k, b.y0 + 18 * k, fit_cap(line, 7.5 * k, bw - 28 * k), GAP, SPACE, white(k, 0.9), false, false);
    if !s[0].pack_ready && !s[0].pack_failed {
      share := ifx s[0].total > 0 then clamp(cast(f32) s[0].loaded / cast(f32) s[0].total, 0, 1) else 0.0f32;
      x0 := b.x0 + 14 * k; x1 := b.x1 - 14 * k; y := b.y0 + 30 * k;
      if lit(out, vertices, x0, y, x1, y, 0.5 * k, 0.25, 1 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
      if share > 0 && lit(out, vertices, x0, y, x0 + (x1 - x0) * share, y, 1.2 * k, 1, 2.5 * k, EMBER_R, EMBER_G, EMBER_B, MODE_STROKE) { vertices += 6; }
    }
    return vertices;
  }
  rows := s[0].licence_n; if rows > PANEL_ROWS { rows = PANEL_ROWS + 1; }
  bw := lo(w - 2 * g, 420 * k);
  b := Box.{x0 = g, y0 = top, x1 = g + bw, y1 = top + 16 * k + cast(f32) (rows + 1) * PANEL_LINE * k + 6 * k};
  plate(s, b, 0.86, LOOK_PLAIN);
  n := put(buf[..], 0, "STANDING HERE · ");
  n = put_int(buf[..], n, s[0].model_n); n = put(buf[..], n, ifx s[0].model_n == 1 then " MODEL" else " MODELS");
  if s[0].textures > 0 { n = put(buf[..], n, ", "); n = put_int(buf[..], n, s[0].textures); n = put(buf[..], n, ifx s[0].textures == 1 then " TEXTURE" else " TEXTURES"); }
  head := cast(string) buf[0..<n];
  room := bw - 28 * k;
  y := b.y0 + 20 * k;
  vertices = write(d, out, vertices, head, b.x0 + 14 * k, y, fit_cap(head, 7 * k, room), GAP, SPACE, bronze(k, 0.95), false, false);
  for i: 0..<s[0].licence_n {
    if i >= PANEL_ROWS {
      y += PANEL_LINE * k;
      m := put(buf[..], 0, "AND "); m = put_int(buf[..], m, s[0].licence_n - PANEL_ROWS); m = put(buf[..], m, " MORE");
      vertices = write(d, out, vertices, cast(string) buf[0..<m], b.x0 + 14 * k, y, 6.5 * k, GAP, SPACE, white(k, 0.7), false, false);
      break;
    }
    y += PANEL_LINE * k;
    m := put(buf[..], 0, licence_name(s, i));
    upper(buf[..], m);
    line := cast(string) buf[0..<m];
    vertices = write(d, out, vertices, line, b.x0 + 14 * k, y, fit_cap(line, 6.5 * k, room), GAP, SPACE, white(k, 0.85), false, false);
  }
  return vertices;
}

draw_realm :: (s: [] DropRealm, out: [] f32) -> int {
  k := s[0].dpr; w := s[0].width; h := s[0].height; d := k;
  phone := w < 640 * k;
  vertices := 0;
  // you: your lamp's glow on the floor, a figure and the flame you carry
  foot := seen(s, s[0].x, 0, s[0].z); head := seen(s, s[0].x, 1.55, s[0].z); hip := seen(s, s[0].x, 0.15, s[0].z);
  flame := seen(s, s[0].x + 0.25 * cos(s[0].yaw), LAMP_HEIGHT, s[0].z + 0.25 * sin(s[0].yaw));
  pulse := ifx s[0].still then 0.5f32 else 0.5 + 0.5 * sin(s[0].time * 2.4);
  if foot.ok && head.ok && hip.ok {
    if tinted_dot(out, vertices, foot.x, foot.y, 0.1, 1.2, 22 * k, EMBER_R, EMBER_G, EMBER_B) { vertices += 6; }
    tall := abs(head.y - hip.y);
    if lit(out, vertices, hip.x, hip.y, head.x, head.y + tall * 0.14, 0.045 * tall, 0.8, 2 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { vertices += 6; }
    if tinted_dot(out, vertices, head.x, head.y, 0.055 * tall, 0.9, 2 * k, PARCH_R, PARCH_G, PARCH_B) { vertices += 6; }
    if flame.ok && tinted_dot(out, vertices, flame.x, flame.y, 0.025 * tall + 2 * k, 1.4, 9 * k + pulse * 8 * k, EMBER_R, EMBER_G, EMBER_B) { vertices += 6; }
  }

  // the name, and what this is
  g := 16 * k;
  buf: [TITLE + 8] u8;
  tn := put(buf[..], 0, ifx s[0].name_n > 0 then cast(string) s[0].name[0..<s[0].name_n] else "A first realm");
  upper(buf[..], tn);
  title := cast(string) buf[0..<tn];
  sub := ifx s[0].name_n > 0 then "ITS FIRST REALM, MADE FROM ITS DROP" else "WHERE A PROJECT'S DROPPED MODELS STAND";
  tw := hi(measure(title, GAP, SPACE, false) * 11 * k, measure(sub, GAP, SPACE, false) * 7.5 * k) + 32 * k;
  bw := 112 * k;
  tb := Box.{x0 = g, y0 = g, x1 = lo(g + tw, ifx phone then w - g else w - 2 * g - bw), y1 = g + 54 * k};
  plate(s, tb, 0.92, LOOK_PLAIN);
  vertices = write(d, out, vertices, title, tb.x0 + 16 * k, tb.y0 + 24 * k, fit_cap(title, 11 * k, tb.x1 - tb.x0 - 32 * k), GAP, SPACE, white(k, 0.97), false, false);
  vertices = write(d, out, vertices, sub, tb.x0 + 16 * k, tb.y0 + 42 * k, fit_cap(sub, 7.5 * k, tb.x1 - tb.x0 - 32 * k), GAP, SPACE, bronze(k, 0.9), false, false);

  // PROJECT (or GALAXY), top right
  b := Box.{x0 = w - g - bw, y0 = g, x1 = w - g, y1 = g + 34 * k};
  if phone { b = Box.{x0 = w - g - bw, y0 = tb.y1 + 10 * k, x1 = w - g, y1 = tb.y1 + 44 * k}; }
  s[0].boxes[BTN_BACK] = b; s[0].shown[BTN_BACK] = true;
  look: f32 = LOOK_LIT; if s[0].hover == BTN_BACK || s[0].press == BTN_BACK { look += LOOK_HOVER; }
  plate(s, b, 0.92, look);
  vertices = centred(d, out, vertices, ifx s[0].back_n > 0 then "PROJECT" else "GALAXY", (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + 4.5 * k, 9 * k, white(k, 0.95));

  // what to do, until you have walked a little
  if s[0].walked < 6 {
    hint := ifx phone then "DRAG A THUMB TO WALK AND TURN" else "W AND S WALK, A AND D TURN, OR DRAG TO TURN";
    vertices = centred(d, out, vertices, hint, w * 0.5, h - 40 * k, fit_cap(hint, 7.5 * k, w - 2 * g), white(k, 0.6));
  }
  vertices = draw_pack(s, out, vertices, ifx phone then tb.y1 + 54 * k else tb.y1 + 12 * k);
  return vertices;
}

// ---- the frame

realm_frame :: (s: [] DropRealm, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  if !s[0].started { realm_reset(s); }
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = still;
  realm_step(s, dt);
  s[0].plate_n = 0;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  for i: 0..<UNIFORM_FLOATS { uniforms[i] = 0; }
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = ifx still then 20.0f32 else s[0].time;
  uniforms[3] = ifx still then 1.0f32 else ease(s[0].time / 0.6);
  uniforms[4] = ifx still then 1.0f32 else 0.0f32;
  uniforms[6] = s[0].dpr;
  view_rows(s);
  for i: 0..<16 { uniforms[VIEW_AT + i] = s[0].view[i]; }
  uniforms[LAMP_AT] = s[0].x + 0.25 * cos(s[0].yaw); uniforms[LAMP_AT + 1] = LAMP_HEIGHT; uniforms[LAMP_AT + 2] = s[0].z + 0.25 * sin(s[0].yaw);
  uniforms[LAMP_AT + 3] = ifx still then 1.0f32 else 0.9 + 0.1 * sin(s[0].time * 2.4);
  for i: 0..<3 {
    uniforms[EYE_AT + i] = s[0].eye[i]; uniforms[RAY_AT + i] = s[0].fwd[i];
    uniforms[RAY_AT + 4 + i] = s[0].right[i]; uniforms[RAY_AT + 8 + i] = s[0].up[i];
  }
  uniforms[EYE_AT + 3] = s[0].floor_r;
  n := draw_realm(s, out);
  uniforms[5] = cast(f32) s[0].plate_n;
  for i: 0..<s[0].plate_n {
    o := PANEL_AT + i * 8; b := s[0].plates[i];
    uniforms[o] = b.x0; uniforms[o + 1] = b.y0; uniforms[o + 2] = b.x1; uniforms[o + 3] = b.y1;
    uniforms[o + 4] = s[0].dpr; uniforms[o + 5] = s[0].plate_alpha[i]; uniforms[o + 6] = s[0].plate_look[i]; uniforms[o + 7] = 0;
  }
  return n;
}

coaxial_droprealm_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_droprealm_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_droprealm_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- checks

tick :: (s: [] DropRealm, dt: f32) {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := realm_frame(s, out[..], u[..], 2880, 1800, 2, dt, false);
  #assert n > 0;
}
step_by :: (s: [] DropRealm, dt: f32) {
  if !s[0].started { realm_reset(s); }
  if s[0].width < 1 { s[0].width = 2880; s[0].height = 1800; s[0].dpr = 2; }
  realm_step(s, dt);
}
press_key :: (s: [] DropRealm, k: int, down: bool) { used := realm_key(s, k, down); }
tap :: (s: [] DropRealm, x: f32, y: f32, kind: int) {
  a := realm_pointer(s, x, y, POINTER_DOWN, kind, 3);
  b := realm_pointer(s, x, y, POINTER_UP, kind, 3);
}
outbox_is :: (s: [] DropRealm, text: string) -> bool { return cast(string) s[0].outbox[0..<s[0].out_n] == text; }
near :: (a: f32, b: f32, tolerance: f32) -> bool { return abs(a - b) <= tolerance; }

// A drop's pack (drops.c): a licence and a mesh per model, and a texture layer (the white one has no line).
DROP :: "pack lantern-garden\nbudget 25000000\nbytes 81234\nL 0 lantern.glb|licence unknown: ask the owner|\nL 1 Bench Old.glb|CC0 1.0|\nL 2 tower.glb|CC-BY 4.0|\nM lantern 0 36 0 -0.2 0 -0.2 0.2 1.1 0.2\nM bench-old 36 360 1 -1 0.5 -0.4 1 1.2 0.4\nM tower 396 900 2 -40 0 -40 40 120 40\nT 0 image0 1\n";

#test "the drop's pack: each model, its bounds and whose it is" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  #assert s[0].pack_ready && s[0].mesh_n == 3 && s[0].model_n == 3 && s[0].licence_n == 3 && s[0].textures == 1;
  #assert mesh_name(s[..], 1) == "bench-old" && s[0].mesh_first[1] == 36 && s[0].mesh_count[1] == 360 && s[0].mesh_licence[1] == 1;
  #assert near(s[0].mesh_box[1 * 6 + 1], 0.5, 0.001) && near(s[0].mesh_box[2 * 6 + 4], 120, 0.001) && near(s[0].mesh_box[0], -0.2, 0.001);
  #assert licence_name(s[..], 1) == "Bench Old.glb · CC0 1.0";
  #assert realm_draw_count(s[..]) == 3 && s[0].draws[4] == 36 && s[0].draws[5] == 360 && s[0].draws[6] == 1;
}

// Where a model's local point lands in the world, from its transform.
landed :: (s: [] DropRealm, m: int, x: f32, y: f32, z: f32) -> [3] f32 {
  o := m * INSTANCE_FLOATS; w: [3] f32;
  for r: 0..<3 { w[r] = s[0].objects[o + r * 4] * x + s[0].objects[o + r * 4 + 1] * y + s[0].objects[o + r * 4 + 2] * z + s[0].objects[o + r * 4 + 3]; }
  return w;
}

#test "every model stands on the floor, centred on its spot, none bigger than MAX_SIZE, none in another's way" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  // the bench's bounds start half a metre up: its base is on the floor; its middle is its spot
  base := landed(s[..], 1, 0, 0.5, 0);
  #assert near(base[1], 0, 0.001) && near(base[0], s[0].spot_x[1], 0.001) && near(base[2], s[0].spot_z[1], 0.001);
  // the 120 m tower is shown 5 m tall
  top := landed(s[..], 2, 0, 120, 0);
  #assert near(top[1], MAX_SIZE, 0.01) && near(s[0].objects[2 * INSTANCE_FLOATS + 5], MAX_SIZE / 120, 0.0001);
  // the lantern (1.1 m) keeps its size
  #assert near(s[0].objects[5], 1, 0.0001);
  for i: 0..<s[0].model_n {
    r := sqrt(s[0].spot_x[i] * s[0].spot_x[i] + s[0].spot_z[i] * s[0].spot_z[i]);
    #assert r - s[0].spot_r[i] > BODY * 3;                     // the middle, where you start, is clear
    #assert r + s[0].spot_r[i] < s[0].floor_r;                 // on the floor
    for j: 0..<s[0].model_n {
      if j == i { continue; }
      dx := s[0].spot_x[i] - s[0].spot_x[j]; dz := s[0].spot_z[i] - s[0].spot_z[j];
      #assert sqrt(dx * dx + dz * dz) > s[0].spot_r[i] + s[0].spot_r[j];
    }
  }
  // each faces in: its own +z points at the middle
  for i: 0..<s[0].model_n {
    f := landed(s[..], i, 0, 0, 1); c := landed(s[..], i, 0, 0, 0);
    tx := -s[0].spot_x[i]; tz := -s[0].spot_z[i]; tl := sqrt(tx * tx + tz * tz);
    fx := f[0] - c[0]; fz := f[2] - c[2]; fl := sqrt(fx * fx + fz * fz);
    #assert (fx * tx + fz * tz) / (fl * tl) > 0.999;
  }
}

#test "a model made in centimetres is grown, and a tree's leaves stand on its trunk" {
  s: [1] DropRealm;
  realm_catalog(s[..], "M cup 0 30 0 -0.04 0 -0.04 0.04 0.1 0.04\nM Tree 30 60 0 -1 0 -1 1 3 1\nM Tree_Leaves 90 90 0 -2 2 -2 2 5 2\n");
  #assert s[0].model_n == 2 && realm_draw_count(s[..]) == 3;
  #assert near(s[0].objects[5], GROWN / 0.1, 0.01);
  #assert s[0].objects[1 * INSTANCE_FLOATS + 3] == s[0].objects[2 * INSTANCE_FLOATS + 3];
  #assert s[0].objects[1 * INSTANCE_FLOATS + 11] == s[0].objects[2 * INSTANCE_FLOATS + 11];
  #assert near(s[0].spot_r[1], 2, 0.001);   // the leaves' footprint, not the trunk's
}

#test "W walks the way you face, A and D turn, and you start in the middle" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  #assert s[0].x == 0 && s[0].z == 0;
  press_key(s[..], 'w', true);
  for i: 0..<10 { step_by(s[..], 0.05); }
  press_key(s[..], 'w', false);
  #assert near(s[0].x, 0, 0.001) && s[0].z < -1.4 && s[0].walked > 1.4;
  press_key(s[..], 'd', true);
  for i: 0..<10 { step_by(s[..], 0.05); }
  press_key(s[..], 'd', false);
  #assert near(s[0].yaw, TURN * 0.5, 0.01);
  z := s[0].z; x := s[0].x;
  press_key(s[..], KEY_UP, true); step_by(s[..], 0.05); press_key(s[..], KEY_UP, false);
  #assert s[0].x > x && s[0].z < z;   // turned right: forward now has some +x
}

#test "you can't walk into a model or off the floor" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  press_key(s[..], 'w', true);
  for i: 0..<400 { step_by(s[..], 0.05); }
  for i: 0..<s[0].model_n {
    dx := s[0].x - s[0].spot_x[i]; dz := s[0].z - s[0].spot_z[i];
    #assert sqrt(dx * dx + dz * dz) >= s[0].spot_r[i] + BODY - 0.001;
  }
  #assert sqrt(s[0].x * s[0].x + s[0].z * s[0].z) <= s[0].floor_r - BODY + 0.001;
  // turning while walking still never goes through
  press_key(s[..], 'a', true);
  for i: 0..<400 { step_by(s[..], 0.05); }
  for i: 0..<s[0].model_n {
    dx := s[0].x - s[0].spot_x[i]; dz := s[0].z - s[0].spot_z[i];
    #assert sqrt(dx * dx + dz * dz) >= s[0].spot_r[i] + BODY - 0.001;
  }
  #assert sqrt(s[0].x * s[0].x + s[0].z * s[0].z) <= s[0].floor_r - BODY + 0.001;
}

#test "a thumb walks and turns; a mouse drag turns" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  tick(s[..], 0.016);
  p1 := realm_pointer(s[..], 1000, 1200, POINTER_DOWN, 1, 7);
  p2 := realm_pointer(s[..], 1000, 1080, POINTER_MOVE, 1, 7);
  #assert s[0].stick && near(s[0].stick_dy, -1, 0.001);
  for i: 0..<10 { step_by(s[..], 0.05); }
  #assert s[0].z < -1.4;
  p3 := realm_pointer(s[..], 1000, 1080, POINTER_UP, 1, 7);
  #assert !s[0].stick && s[0].stick_dy == 0;
  yaw := s[0].yaw;
  p4 := realm_pointer(s[..], 1000, 900, POINTER_DOWN, 0, 1);
  p5 := realm_pointer(s[..], 1288, 900, POINTER_MOVE, 0, 1);
  p6 := realm_pointer(s[..], 1288, 900, POINTER_UP, 0, 1);
  #assert near(s[0].yaw - yaw, 0.1 * 3.1415927, 0.001);
}

#test "the camera is behind you and you are on the screen, low in the middle" {
  s: [1] DropRealm;
  realm_catalog(s[..], DROP);
  tick(s[..], 0.016);
  me := seen(s[..], s[0].x, 1.0, s[0].z);
  #assert me.ok && near(me.x, 1440, 2) && me.y > 900 && me.y < 1800;
  ahead := seen(s[..], s[0].spot_x[0], 0, s[0].spot_z[0]);
  behind := seen(s[..], 0, 0, 9);
  #assert ahead.ok && !behind.ok;
}

#test "the page names the realm and its project; PROJECT and Escape go back to it" {
  s: [1] DropRealm;
  realm_message(s[..], MSG_DATA_TEXT, "Lantern Garden\n/projects/lantern-garden");
  #assert cast(string) s[0].name[0..<s[0].name_n] == "Lantern Garden" && back_url(s[..]) == "/projects/lantern-garden";
  tick(s[..], 0.016);
  b := s[0].boxes[BTN_BACK];
  tap(s[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, 0);
  #assert realm_action(s[..]) == ACT_NAVIGATE && outbox_is(s[..], "/projects/lantern-garden");
  realm_action_done(s[..]);
  #assert realm_key(s[..], KEY_ESCAPE, true) && realm_action(s[..]) == ACT_NAVIGATE && outbox_is(s[..], "/projects/lantern-garden");
  // a link off this site is not taken; with none, back is the galaxy
  t: [1] DropRealm;
  realm_message(t[..], MSG_DATA_TEXT, "X\nhttps://example.com");
  realm_message(t[..], MSG_DATA_TEXT, "X\n//example.com");
  #assert t[0].back_n == 0 && back_url(t[..]) == "/verse/galaxy";
}

#test "while the pack streams nothing is drawn from it; an empty pack says so" {
  s: [1] DropRealm;
  realm_message(s[..], MSG_PACK, "524288 1189356");
  #assert s[0].loaded == 524288 && s[0].total == 1189356 && realm_draw_count(s[..]) == 0;
  tick(s[..], 0.016);
  e: [1] DropRealm;
  realm_catalog(e[..], "pack empty\nbytes 200\n");
  #assert e[0].pack_ready && e[0].model_n == 0 && realm_draw_count(e[..]) == 0;
  tick(e[..], 0.016);
  // walking an empty floor still works
  press_key(e[..], 's', true);
  for i: 0..<100 { step_by(e[..], 0.05); }
  #assert sqrt(e[0].x * e[0].x + e[0].z * e[0].z) <= e[0].floor_r;
}

#test "atan and acos without a library" {
  #assert near(atan_pos(1), 0.7853982, 0.0001) && near(atan_pos(0), 0, 0.0001) && near(atan_pos(1000), 1.5697963, 0.0001);
  #assert near(acos_unit(0), 1.5707963, 0.0001) && near(acos_unit(1), 0, 0.0001) && near(acos_unit(-1), 3.1415927, 0.0001);
  #assert near(acos_unit(0.5), 1.0471976, 0.0001);
}
