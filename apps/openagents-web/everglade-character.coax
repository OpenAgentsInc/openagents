// A detailed character in Everglade through the host's character pass (coax/web/host.js, the
// "character pass" section; docs/metaverse/2026-11-06-native-hero-characters.md, R1 and R3): ?stage=echo
// places Echo a metre to your right on the commons (everglade-raid-preview.coax rp_facts), and
// each frame this fills her SceneLights block (metaverse-engine/render/scene-lights.coax) from the town's own
// camera, key light, sky, haze, lamps, weather and shadow map, as the town's shaders read them
// (apps/openagents-web/gpu/everglade-v1/gpu.coax eg_paint, eg_lamp_light, eg_haze_colour, eg_light_space). The host
// asks for her pack by name only when the block is on, so no other page loads anything. Once the
// host draws her (coaxial_character_ready_v1), she is a body: one capsule (metaverse-engine/physics/query.coax) in the
// bodies you walk among (everglade_bodies_near) and in the follow camera's way (camera_frame).
//   coax/bin/coax test apps/openagents-web/everglade.coax
#load "../../metaverse-engine/render/scene-lights.coax";
#load "../../metaverse-engine/physics/query.coax";

EG_CHARACTER_PACK :: "valley-slay";
// Echo's vertex words (metaverse/valley/slay-gpu-policy.coax slay_gpu_storage): the storage binding the
// host asks the device for when a world may place her.
EG_CHARACTER_STORAGE :: 187564308;
// The normal offset and the depth bias the town's own surfaces read its shadow map with (eg_map_lit).
EG_CHARACTER_NORMAL_OFFSET :: 0.08;
EG_CHARACTER_BIAS :: 0.0006;
EG_CHARACTER_CHROMA_KEEP :: 0.7;   // as the town's people (apps/openagents-web/gpu/everglade-v1/gpu.coax eg_lit)
EG_CHARACTER_ALBEDO_SAT :: 1.3;    // her photographed albedo toward the town's painted ones

// Her body: a capsule from her shins to her crown, about her shoulders' half width.
EG_CHARACTER_BODIES :: 1;
EG_CHARACTER_LOW :: 0.3;
EG_CHARACTER_HIGH :: 1.45;
EG_CHARACTER_RADIUS :: 0.24;
// The follow camera keeps this clear of her (everglade.coax CAM_TRUNK_CLEAR, a trunk's).
EG_CHARACTER_CAMERA_CLEAR :: 0.25;

// Whether a character is placed this frame (the block is filled only then), and her pack's name and
// vertex binding (the host's coaxial_character_v1, coaxial_character_pack_v1, coaxial_character_storage_v1).
everglade_character_on :: (s: [] Everglade) -> bool #export_c #effects(all) { return s[0].rp.stage == -3 && s[0].pack_ready; }
everglade_character_pack :: () -> string #export_c #effects(all) { return EG_CHARACTER_PACK; }
everglade_character_storage :: () -> int #export_c #effects(all) { return EG_CHARACTER_STORAGE; }
// The host says whether it draws her (her pack admitted and her pass built): only then is she a body,
// so a page that never gets her pack has nothing unseen in its way.
everglade_character_ready :: (s: [] Everglade, ready: bool) #export_c #effects(all) { s[0].character_shown = ready; }
everglade_character_solid :: (s: [] Everglade) -> bool { return everglade_character_on(s) && s[0].character_shown; }

// Her capsule as one body (BODY numbers: one end, the other, the radius) at out[n * 7..], if she is
// solid; how many bodies that adds.
everglade_character_bodies :: (s: [] Everglade, out: [] f32, n: int) -> int {
  if !everglade_character_solid(s) || (n + 1) * 7 > out.count { return 0; }
  a := s[0].rp.echo_at; k := n * 7;
  out[k] = a.x; out[k + 1] = a.y + f32(EG_CHARACTER_LOW); out[k + 2] = a.z;
  out[k + 3] = a.x; out[k + 4] = a.y + f32(EG_CHARACTER_HIGH); out[k + 5] = a.z;
  out[k + 6] = f32(EG_CHARACTER_RADIUS);
  return 1;
}
// How far the follow camera may back out along r before her capsule (grown by the clearance), by
// metaverse-engine/physics/query.coax's ray; r.far when she is not solid or not in the way.
everglade_character_room :: (s: [] Everglade, r: OrbitRay) -> f32 {
  if !everglade_character_solid(s) { return r.far; }
  a := s[0].rp.echo_at;
  cap := [7] f32.[a.x, a.y + f32(EG_CHARACTER_LOW), a.z, a.x, a.y + f32(EG_CHARACTER_HIGH), a.z, f32(EG_CHARACTER_RADIUS) + f32(EG_CHARACTER_CAMERA_CLEAR)];
  c := Colliders.{ground = -100000, capsules = cap[..]};
  hit := query_ray(c, world_point(r.from.x, r.from.y, r.from.z), world_point(r.dir.x, r.dir.y, r.dir.z), r.far);
  // a ray that starts inside her clearance (you pressed against her) keeps its room
  if !hit.hit || hit.t <= 0 { return r.far; }
  return hit.t;
}

// Her block for this frame, from u as everglade_frame left it (camera, style, lamps, weather).
everglade_character :: (s: [] Everglade, u: [] f32, width: f32, height: f32) {
  b := s[0].character[..];
  if !everglade_character_on(s) { return; }
  // the camera: the town's own clip rows (view), so her depth and the town's agree
  scl_camera(b, u[U_VIEW..<U_VIEW + 16], SclPoint.{x = u[U_EYE], y = u[U_EYE + 1], z = u[U_EYE + 2]}, width, height);
  her := s[0].rp.echo_at;
  scl_place(b, her.x, her.y, her.z, s[0].rp.echo_heading);   // where the stage put her (rp_facts), or the room (rp_echo_room)
  everglade_character_motion(s, b);
  st := STYLE_AT;
  // the key light (eg_paint: the key's colour times its strength) and where it is
  l := v3(u[st + SU_KEY_DIR], u[st + SU_KEY_DIR + 1], u[st + SU_KEY_DIR + 2]);
  scl_put3(b, SCL_KEY_DIR, l.x, l.y, l.z);
  kw := u[st + SU_KEY + 3];
  scl_put3(b, SCL_KEY, u[st + SU_KEY] * kw, u[st + SU_KEY + 1] * kw, u[st + SU_KEY + 2] * kw);
  // the sky's and the ground's ambient at the preset's scale (verse_style_ambient)
  aw := u[st + SU_SKY_AMB + 3];
  scl_put3(b, SCL_SKY, u[st + SU_SKY_AMB] * aw, u[st + SU_SKY_AMB + 1] * aw, u[st + SU_SKY_AMB + 2] * aw);
  scl_put3(b, SCL_GROUND, u[st + SU_GROUND_AMB] * aw, u[st + SU_GROUND_AMB + 1] * aw, u[st + SU_GROUND_AMB + 2] * aw);
  // the haze (eg_haze_share): the preset's hue and cap, its start and density as the frame thinned them
  scl_put3(b, SCL_HAZE_HUE, u[st + SU_HAZE_COLOUR], u[st + SU_HAZE_COLOUR + 1], u[st + SU_HAZE_COLOUR + 2]);
  b[SCL_HAZE_HUE + 3] = u[st + SU_HAZE + 2];
  b[SCL_HAZE] = u[U_EYE + 1] - 2.5; b[SCL_HAZE + 1] = u[U_SUN + 3]; b[SCL_HAZE + 2] = u[U_EYE + 3]; b[SCL_HAZE + 3] = u[st + SU_HAZE + 3];
  // the key through the haze (eg_haze_colour): under the moon added, half the key; by day mixed
  moon := u[st + SU_KEY_DIR + 3] > 0.5;
  if moon { scl_put3(b, SCL_GLOW, b[SCL_KEY] * 0.5, b[SCL_KEY + 1] * 0.5, b[SCL_KEY + 2] * 0.5); }
  else { scl_put3(b, SCL_GLOW, u[st + SU_HAZE_KEY], u[st + SU_HAZE_KEY + 1], u[st + SU_HAZE_KEY + 2]); }
  b[SCL_GLOW + 3] = ifx moon then 1.0f32 else 0.0f32;
  // the shadow map's rows (eg_light_space, eg_shadow_place): across ax and ay from the snapped middle, z
  // half less the depth along the light over four reaches
  size := u[st + SU_SHADOW];
  on := size >= 1;
  phone := u[st + SU_STYLE + 2] > 0.5;
  reach := verse_style_shadow_reach(ifx phone then 1.0f32 else 0.0f32);
  ax := ifx abs(l.y) < 0.999 then unit_or(cross(v3(0, 1, 0), l), v3(1, 0, 0)) else v3(1, 0, 0);
  ay := cross(l, ax);
  mx := verse_style_shadow_snap(u[U_EYE] * ax.x + u[U_EYE + 2] * ax.z, reach, hi(size, 1));
  my := verse_style_shadow_snap(u[U_EYE] * ay.x + u[U_EYE + 2] * ay.z, reach, hi(size, 1));
  rows := [12] f32.[ax.x / reach, ax.y / reach, ax.z / reach, -mx / reach,
                    ay.x / reach, ay.y / reach, ay.z / reach, -my / reach,
                    -l.x / (4 * reach), -l.y / (4 * reach), -l.z / (4 * reach), 0.5];
  for k: 0..<12 { b[SCL_SHADOW + k] = rows[k]; }
  // the filter's step: the town's taps reach 1.6 times the preset's radius in texels; a 3x3 grid at
  // a little over half that covers the same disc
  b[SCL_SHADOW_INFO] = ifx on then 1.0f32 else 0.0f32;
  b[SCL_SHADOW_INFO + 1] = u[st + SU_SHADOW + 2] * 1.6 * 0.6 / hi(size, 1);
  // with the shadow tiles open (everglade_shadows) she casts into and reads the nearest, its rows
  // into the atlas's own -1 to 1; until it holds a picture, none
  c := s[0].casc[0];
  if on && c.on {
    tile: [12] f32;
    cascade_atlas_rows(c, 0, u[st + SU_SHADOW + 2], 2 * reach / hi(size, 1), reach, tile[..]);
    for k: 0..<12 { b[SCL_SHADOW + k] = tile[k]; }
    o := U_CASCADE + CASCADE_HEADER;
    b[SCL_SHADOW_INFO] = ifx u[o + 21] > 0.5 then 1.0f32 else 0.0f32;
    b[SCL_SHADOW_INFO + 1] = u[o + 16] * 0.6;
  }
  b[SCL_SHADOW_INFO + 2] = f32(EG_CHARACTER_BIAS); b[SCL_SHADOW_INFO + 3] = f32(EG_CHARACTER_NORMAL_OFFSET);
  // the rain on her (eg_weather_wet_share: a character takes 0.8 of the wet)
  b[SCL_LOOK] = u[U_WEATHER + 4] * 0.8; b[SCL_LOOK + 1] = u[U_WEATHER];
  // the town's look on her: its people keep 0.7 of their albedo's saturation through the light
  // (apps/openagents-web/gpu/everglade-v1/gpu.coax), and her photographed albedo is lifted toward their painted one
  b[SCL_CHROMA_KEEP] = EG_CHARACTER_CHROMA_KEEP; b[SCL_ALBEDO_SAT] = EG_CHARACTER_ALBEDO_SAT;
  // the lamps (eg_lamp_light): each at its strength, the spells' blasts by day too, the rest at the dusk's glow
  scl_lights_clear(b);
  n := cast(int) u[U_LIGHT_INFO]; glow := u[U_LIGHT_INFO + 1];
  by_day := n - clamp_i(cast(int) u[U_LIGHT_INFO + 2], 0, n);
  for i: 0..<clamp_i(n, 0, LIGHTS) {
    at := U_LIGHTS + i * 8;
    k := ifx i >= by_day then 1.0f32 else glow;
    scl_light(b, u[at], u[at + 1], u[at + 2], u[at + 3], u[at + 4], u[at + 5], u[at + 6], u[at + 7] * k);
  }
  b[SCL_OUT + 1] = f32(EG_AUX_DISTANCE_CPU);
}
// How the room moves her (?raid=preview&stage=echo, #12996): her pace, her cast and its aim, the
// ground's slope under her; still on the plain stage.
EG_CHARACTER_CAST_HOLD :: 1.5;   // s past its bar that a cast still shows: her follow-through
everglade_character_motion :: (s: [] Everglade, b: [] f32) {
  for k: 0..<10 { b[SCL_MOTION + k] = 0; }
  b[SCL_CAST] = -1;
  if !s[0].rp.echo_room { return; }
  her := s[0].rp.echo_at;
  b[SCL_MOVED] = 1; b[SCL_SPEED] = s[0].rp.echo_speed;
  k := s[0].rp.echo_cast;
  if k >= 0 && k < SP_SLOTS {
    t := f32(s[0].time - s[0].rp.echo_cast_at);
    bar := srd_spell(SP_SPELL[k]).bar;
    if t >= 0 && t < bar + f32(EG_CHARACTER_CAST_HOLD) {
      b[SCL_CAST] = f32(k); b[SCL_CAST_T] = t; b[SCL_CAST_BAR] = bar;
      a := s[0].rp.echo_aim;
      scl_put3(b, SCL_AIM, a.x, a.y, a.z);
    }
  }
  b[SCL_SLOPE] = ground_at(s, her.x + 0.5, her.z) - ground_at(s, her.x - 0.5, her.z);
  b[SCL_SLOPE + 1] = ground_at(s, her.x, her.z + 0.5) - ground_at(s, her.x, her.z - 0.5);
}
// aux.g's scale (apps/openagents-web/gpu/everglade-v1/gpu.coax EG_AUX_DISTANCE)
EG_AUX_DISTANCE_CPU :: 256.0;

#test "Echo's block: off unless ?stage=echo, her depth through the town's own rows, its shadow rows put her in the map" #steps 2000000000 {
  s: [1] Everglade;
  u: [UNIFORM_FLOATS] f32;
  everglade_character(s[..], u[..], 1280, 720);
  #assert !everglade_character_on(s[..]) && s[0].character[SCL_SIZE] == 0;
  s[0].rp.stage = -3; s[0].pack_ready = true;
  s[0].rp.echo_at = v3(RP_YOU[0] + 1, 0, RP_YOU[1]); s[0].rp.echo_heading = f32(RP_ECHO_HEADING);
  shot := Shot.{eye = v3(RP_YOU[0] + 1, 2, RP_YOU[1] - 3), at = v3(RP_YOU[0] + 1, 1, RP_YOU[1])};
  view(shot, 1280, 720, u[..], U_VIEW);
  u[U_EYE] = shot.eye.x; u[U_EYE + 1] = shot.eye.y; u[U_EYE + 2] = shot.eye.z;
  u[STYLE_AT + SU_KEY_DIR + 1] = 1; u[STYLE_AT + SU_SHADOW] = 2048; u[STYLE_AT + SU_SHADOW + 2] = 1.5;
  u[U_LIGHT_INFO] = 1; u[U_LIGHT_INFO + 1] = 0.5;
  u[U_LIGHTS] = RP_YOU[0] + 2; u[U_LIGHTS + 1] = 3; u[U_LIGHTS + 2] = RP_YOU[1]; u[U_LIGHTS + 3] = 10; u[U_LIGHTS + 7] = 2;
  everglade_character(s[..], u[..], 1280, 720);
  b := s[0].character[..];
  #assert b[SCL_SIZE] == 1280 && b[SCL_HEADING] < -0.99 && b[SCL_SHADOW_INFO] == 1;
  // her feet in clip space match the town's rows: in front of the eye, inside the frame
  w := b[SCL_CLIP + 12] * b[SCL_AT] + b[SCL_CLIP + 13] * b[SCL_AT + 1] + b[SCL_CLIP + 14] * b[SCL_AT + 2] + b[SCL_CLIP + 15];
  cx := b[SCL_CLIP] * b[SCL_AT] + b[SCL_CLIP + 1] * b[SCL_AT + 1] + b[SCL_CLIP + 2] * b[SCL_AT + 2] + b[SCL_CLIP + 3];
  #assert w > 2 && abs(cx / w) < 0.01;
  // the sun overhead: her feet are the map's middle (up to its texel snap), half deep less her height over four reaches
  q := b[SCL_SHADOW] * b[SCL_AT] + b[SCL_SHADOW + 1] * b[SCL_AT + 1] + b[SCL_SHADOW + 2] * b[SCL_AT + 2] + b[SCL_SHADOW + 3];
  qz := b[SCL_SHADOW + 8] * b[SCL_AT] + b[SCL_SHADOW + 9] * b[SCL_AT + 1] + b[SCL_SHADOW + 10] * b[SCL_AT + 2] + b[SCL_SHADOW + 11];
  #assert abs(q) < 0.05 && abs(qz - (0.5 - b[SCL_AT + 1] / 240)) < 0.0001;
  // the one lamp, at the dusk's glow
  #assert b[SCL_OUT] == 1 && b[SCL_LIGHTS + 7] == 1;
  // with the shadow tiles open she maps into the nearest, the atlas's top left quarter, once it is drawn
  everglade_shadow_event(s[..], 0, 0);
  everglade_shadows(s[..], u[..]);
  everglade_character(s[..], u[..], 1280, 720);
  q = b[SCL_SHADOW] * b[SCL_AT] + b[SCL_SHADOW + 1] * b[SCL_AT + 1] + b[SCL_SHADOW + 2] * b[SCL_AT + 2] + b[SCL_SHADOW + 3];
  qy := b[SCL_SHADOW + 4] * b[SCL_AT] + b[SCL_SHADOW + 5] * b[SCL_AT + 1] + b[SCL_SHADOW + 6] * b[SCL_AT + 2] + b[SCL_SHADOW + 7];
  qz = b[SCL_SHADOW + 8] * b[SCL_AT] + b[SCL_SHADOW + 9] * b[SCL_AT + 1] + b[SCL_SHADOW + 10] * b[SCL_AT + 2] + b[SCL_SHADOW + 11];
  #assert s[0].casc[0].draw == 0 && b[SCL_SHADOW_INFO] == 1 && q > -0.65 && q < -0.35 && qy > 0.35 && qy < 0.65 && abs(qz - (0.5 - b[SCL_AT + 1] / 240)) < 0.0001;
  #assert abs(b[SCL_SHADOW_INFO + 1] - u[U_CASCADE + CASCADE_HEADER + 16] * 0.6) < 0.000001;
}

#test "Echo is a body once the host draws her: one capsule among yours, and the follow camera stops short of her" {
  s: [1] Everglade;
  s[0].rp.stage = -3; s[0].pack_ready = true;
  s[0].rp.echo_at = v3(10, 2, -90); s[0].rp.echo_heading = f32(RP_ECHO_HEADING);
  out: [21] f32;
  // not yet drawn: nothing in your way
  r := OrbitRay.{from = v3(10, 3, -94), dir = v3(0, 0, 1), far = 8};
  #assert everglade_character_bodies(s[..], out[..], 1) == 0 && everglade_character_room(s[..], r) == 8;
  everglade_character_ready(s[..], true);
  #assert everglade_character_bodies(s[..], out[..], 1) == 1 && out[7] == 10 && out[8] == 2.3f32 && out[11] == 3.45f32 && out[13] == f32(EG_CHARACTER_RADIUS);
  #assert everglade_character_bodies(s[..], out[..], 3) == 0;   // no room left
  // the camera's ray toward her stops its clearance short of her capsule; one beside her or above her doesn't
  room := everglade_character_room(s[..], r);
  #assert abs(room - (4 - f32(EG_CHARACTER_RADIUS) - f32(EG_CHARACTER_CAMERA_CLEAR))) < 0.001;
  #assert everglade_character_room(s[..], OrbitRay.{from = v3(11, 3, -94), dir = v3(0, 0, 1), far = 8}) == 8;
  #assert everglade_character_room(s[..], OrbitRay.{from = v3(10, 5, -94), dir = v3(0, 0, 1), far = 8}) == 8;
  // off the stage she is no body at all
  s[0].rp.stage = 0;
  #assert everglade_character_bodies(s[..], out[..], 0) == 0;
}
