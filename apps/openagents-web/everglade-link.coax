// Original Link pose adapter; Everglade remains the movement/combat authority.
#load "../../metaverse/ocarina/motion.coax";
#load "../../metaverse-engine/anim/scaled-pose.coax";
#load "../../coax/lib/text/base64.coax";
EgLink :: struct {
 data:[]u8;bytes:int;ready:bool;failed:bool;parents:[309]int;bind:[309*12]f32;rest:[309]SkinLocal;pose:[309]SkinLocal;from:[309]SkinLocal;scales:[309]Point;from_scales:[309]Point;basis:[309*12]f32;world:[309*12]f32;palette:[309*12]f32;revision:int;
 clip:int;time:f32;age:f32;forced:bool;grounded:bool=true;source_speeds:[8]f32;inspect:int;physical_air:bool;
}
el_pose_at :: (b:[]u8,p:int)->SkinLocal {return SkinLocal.{t=scan_point(b,p),q=Quat.{x=scan_float(b,p+12),y=scan_float(b,p+16),z=scan_float(b,p+20),w=scan_float(b,p+24)}};}
el_admit :: (s:[]EgLink,b:[]u8)->bool #export_c #effects(all) {
 if b.count<32 || b.count>s[0].data.count || scan_u32(b,0)!=0x324c434f || !ocarina_rig_valid(b) {s[0].failed=true;return false;}for k:0..<b.count {s[0].data[k]=b[k];}s[0].bytes=b.count;s[0].ready=true;
 for k:0..<OCL_JOINTS {p:=OCL_RIG_BASE+k*80;s[0].parents[k]=cast(int)scan_u32(b,p)-1;for j:0..<12 {s[0].bind[k*12+j]=scan_float(b,p+4+j*4);}s[0].rest[k]=el_pose_at(b,p+52);s[0].pose[k]=s[0].rest[k];s[0].from[k]=s[0].rest[k];s[0].scales[k]=v3(1,1,1);s[0].from_scales[k]=v3(1,1,1);}
 for k:0..<8 {s[0].source_speeds[k]=ocl_source_speed(b,k);}s[0].clip=0;s[0].time=0;s[0].age=1;el_present(s);return true;
}
el_select :: (s:[]EgLink,clip:int) {if clip==s[0].clip {return;}for k:0..<OCL_JOINTS {s[0].from[k]=s[0].pose[k];s[0].from_scales[k]=s[0].scales[k];}s[0].clip=clip;s[0].time=0;s[0].age=0;}
el_duration :: (s:[]EgLink)->f32 {return ifx s[0].ready then scan_float(s[0].data[..],32+s[0].clip*32+8) else 1.0f32;}
el_present :: (s:[]EgLink) {
 if !s[0].ready {return;}b:=s[0].data[0..<s[0].bytes];desc:=ocr_clip(b,32+s[0].clip*32);duration:=el_duration(s);looping:=s[0].clip<=3;time:=ifx looping then s[0].time-duration*floor(s[0].time/duration) else lo(s[0].time,duration);f:=lo(time*30,cast(f32)(desc.frames-1));a:=cast(int)floor(f);next:=ifx a+1<desc.frames then a+1 else a;share:=f-cast(f32)a;fade:=pose_fade(s[0].age,0.12);
 for k:0..<OCL_JOINTS {pa:=el_pose_at(b,desc.start+(a*OCL_JOINTS+k)*28);pb:=el_pose_at(b,desc.start+(next*OCL_JOINTS+k)*28);target:=pose_blend(pa,pb,share);s[0].pose[k]=pose_blend(s[0].from[k],target,fade);if k==0 && s[0].inspect==0 {s[0].pose[k].t.x=s[0].rest[0].t.x;s[0].pose[k].t.z=s[0].rest[0].t.z;if s[0].physical_air {s[0].pose[k].t.y=s[0].rest[0].t.y;}}scale:=mix(scan_point(b,desc.scale+(a*OCL_JOINTS+k)*12),scan_point(b,desc.scale+(next*OCL_JOINTS+k)*12),share);s[0].scales[k]=mix(s[0].from_scales[k],scale,fade);}
 for k:0..<OCL_JOINTS {flags:=scan_u32(b,desc.flags+k*4);pose_affine_chain(s[0].world[..],s[0].basis[..],s[0].scales[..],s[0].parents[k],k,s[0].pose[k],(flags&0x800000)!=0);pose_affine_palette(s[0].world[..],s[0].bind[..],k,s[0].palette[..]);}s[0].revision+=1;
}
el_tick :: (s:[]EgLink,speed:f32,grounded:bool) {
 if !s[0].ready {return;}
 if s[0].forced && s[0].time>=el_duration(s) {s[0].forced=false;}
 if !s[0].forced {
  landing:=grounded && !s[0].grounded;hold_land:=s[0].clip==5 && s[0].time<el_duration(s);
  walk_speed:=s[0].source_speeds[1];run_speed:=s[0].source_speeds[2];
  chosen:=ifx !grounded then 4 else ifx landing || hold_land then 5 else ifx speed>run_speed+0.2 && s[0].source_speeds[3]>run_speed then 3 else ifx speed>walk_speed+0.2 then 2 else ifx speed>0.08 then 1 else 0;
  el_select(s,chosen);
 }
 s[0].grounded=grounded;s[0].time+=ocl_motion_rate(s[0].clip,speed,s[0].source_speeds[s[0].clip])/64;s[0].age+=1.0/64.0;el_present(s);
}

#test "Link raid adapter admits OCL2 source poses and ends a roll once" #steps 100000000 {
 b:[OCL_TEST_BYTES]u8;ocr_fixture(b[..]);scan_put(b[..],0,0x324c434f);scan_put(b[..],32+7*32+20,3);
 s:[1]EgLink;s[0].data=b[..];#assert el_admit(s[..],b[..]);el_select(s[..],7);s[0].forced=true;s[0].time=el_duration(s[..]);el_tick(s[..],0,true);#assert !s[0].forced && s[0].clip==0 && s[0].revision>1;
 scan_put(b[..],0,0x314c434f);#assert !el_admit(s[..],b[..]);
}

#test "Link raid roll holds its last source frame rather than wrapping before exit" #steps 100000000 {
 b:[OCL_TEST_BYTES]u8;ocr_fixture(b[..]);scan_put(b[..],0,0x324c434f);scan_put(b[..],32+7*32+20,3);desc:=ocr_clip(b[..],32+7*32);scan_put(b[..],desc.start+((desc.frames-1)*OCL_JOINTS+1)*28,f32_bits(4));
 s:[1]EgLink;s[0].data=b[..];#assert el_admit(s[..],b[..]);el_select(s[..],7);s[0].time=el_duration(s[..]);s[0].age=1;el_present(s[..]);#assert s[0].pose[1].t.x==4;
}
