// The others in a room, as you deal with them (#12714; spec 6.8). Loaded by everglade-net.coax.
//
// A tap on another player's nameplate opens a small pane under the top row: their name, BLOCK,
// REPORT, KICK (a realm admin's only: the API checks it again) and CLOSE.
//   - BLOCK (POST /api/playtest/block {player, on}): their body and nameplate are gone from your
//     view at once, and stay gone in every room (the seat ticket's answer brings your blocks back,
//     "blocked": the ids, newest first, MD_BLOCKED at most); their chat lines go too, those on the
//     panel at once and the rest at the API (verse.social).
//   - REPORT (POST /api/villa/report {kind: "player", ref: their id's 16 hex}): the admins' review
//     queue; HIDE there keeps them out of every room for 24 hours.
//   - KICK (POST /api/playtest/room-kick {player}): out of every room for 24 hours; the room server
//     drops their socket within 2 s (room-control.coax).
// Each ask goes through the net's pipe (NET_PIPE_ASK, "PATH\nBODY"); the face POSTs it with the
// player key and hands the answer to net_moderated, which says what happened.
//   coax/bin/coax test apps/openagents-web/everglade5e.coax --only "moderate:"

NET_PIPE_ASK :: 7;         // the pipe's POST: its bytes the API path, a newline, the body (the face carries it)
MD_BLOCKED :: 32;          // the blocks kept on the page (the ticket's answer sends this many)
MD_PLATES :: 16;           // nameplates a frame you can tap
MB_BLOCK :: 0; MB_REPORT :: 1; MB_KICK :: 2; MB_CLOSE :: 3; MB_N :: 4;
MD_ASK_BLOCK :: 1; MD_ASK_REPORT :: 2; MD_ASK_KICK :: 3;

EgMod :: struct {
  blocked: [MD_BLOCKED * NET_ID] u8; blocked_n: [MD_BLOCKED] int; blocks: int;
  // this frame's nameplates of players (labels in everglade.coax), where a tap opens the pane
  plate_box: [MD_PLATES] Box; plate_id: [MD_PLATES * NET_ID] u8; plate_id_n: [MD_PLATES] int;
  plate_name: [MD_PLATES * NET_NAME] u8; plate_name_n: [MD_PLATES] int; plates: int;
  // the pane
  open: bool; who: [NET_ID] u8; who_n: int; name: [NET_NAME] u8; name_n: int;
  boxes: [MB_N] Box; pane: Box; press: int = -1; finger: int = -1;
  asked: int;                // what the answer in flight is for (MD_ASK_*, 0 none)
}

md_copy :: (out: [] u8, at: int, cap: int, t: string) -> int {
  n := 0;
  for ch: t { if n >= cap { break; } out[at + n] = ch; n += 1; }
  return n;
}
md_blocked_id :: (m: [] EgMod, k: int) -> string { return cast(string) m[0].blocked[k * NET_ID..<k * NET_ID + m[0].blocked_n[k]]; }
// Whether you block this player (their id, "p-...").
md_is_blocked :: (n: [] EgNet, pid: string) -> bool {
  if pid.count == 0 { return false; }
  m := n[0].mod[..];
  for k: 0..<m[0].blocks { if md_blocked_id(m, k) == pid { return true; } }
  return false;
}
net_blocks :: (s: [] Everglade, pid: string) -> bool { return net_on(s) && md_is_blocked(net_of(s), pid); }
md_block_add :: (n: [] EgNet, pid: string) {
  m := n[0].mod[..];
  if pid.count == 0 || pid.count > NET_ID || md_is_blocked(n, pid) { return; }
  if m[0].blocks >= MD_BLOCKED {   // the oldest goes
    for k: 1..<MD_BLOCKED {
      for i: 0..<NET_ID { m[0].blocked[(k - 1) * NET_ID + i] = m[0].blocked[k * NET_ID + i]; }
      m[0].blocked_n[k - 1] = m[0].blocked_n[k];
    }
    m[0].blocks = MD_BLOCKED - 1;
  }
  m[0].blocked_n[m[0].blocks] = md_copy(m[0].blocked[..], m[0].blocks * NET_ID, NET_ID, pid);
  m[0].blocks += 1;
}
// The seat ticket's answer: "blocked":"p-a,p-b" (none: no blocks).
md_ticket :: (n: [] EgNet, answer: string) {
  list := net_json_field(answer, "blocked");
  n[0].mod[0].blocks = 0;
  a := 0;
  for i: 0..<list.count + 1 {
    if i < list.count && list[i] != ',' { continue; }
    md_block_add(n, list[a..<i]);
    a = i + 1;
  }
}

// ---- nameplates and the pane

md_plates_clear :: (s: [] Everglade) { if net_on(s) { net_of(s)[0].mod[0].plates = 0; } }
// A player's nameplate drawn this frame at b (labels).
md_plate :: (s: [] Everglade, b: Box, who: string, name: string) {
  if !net_on(s) || who.count == 0 { return; }
  m := net_of(s)[0].mod[..];
  if m[0].plates >= MD_PLATES { return; }
  p := m[0].plates;
  k := hi(s[0].dpr, 0.5);
  pad := 8 * k;   // a finger's slack
  m[0].plate_box[p] = Box.{x0 = b.x0 - pad, y0 = b.y0 - pad, x1 = b.x1 + pad, y1 = b.y1 + pad};
  m[0].plate_id_n[p] = md_copy(m[0].plate_id[..], p * NET_ID, NET_ID, who);
  m[0].plate_name_n[p] = md_copy(m[0].plate_name[..], p * NET_NAME, NET_NAME, name);
  m[0].plates += 1;
}
md_open :: (s: [] Everglade, p: int) {
  m := net_of(s)[0].mod[..];
  m[0].who_n = md_copy(m[0].who[..], 0, NET_ID, cast(string) m[0].plate_id[p * NET_ID..<p * NET_ID + m[0].plate_id_n[p]]);
  m[0].name_n = md_copy(m[0].name[..], 0, NET_NAME, cast(string) m[0].plate_name[p * NET_NAME..<p * NET_NAME + m[0].plate_name_n[p]]);
  m[0].open = true;
}
md_admin :: (s: [] Everglade) -> bool { return s[0].ev.admin; }

// Where the pane's top goes: under the top row; on a phone, whose top row is full width, under your
// HP, LEVEL and the chat line too (phone QA, November 4: the pane ran under the HP bar and the LEVEL
// plate and the name was lost behind them).
md_top :: (s: [] Everglade, top: f32) -> f32 {
  if !phone(s) { return top; }
  k := hi(s[0].dpr, 0.5);
  t := top;
  c := s[0].chat.box; if c.y1 > c.y0 { t = hi(t, c.y1 + 8 * k); }
  if net_on(s) { l := ege_of(s)[0].level_box; if l.y1 > l.y0 { t = hi(t, l.y1 + 8 * k); } }
  return t;
}
// The pane, under the top row in the middle: the name, then BLOCK, REPORT, KICK (an admin) and CLOSE.
md_draw :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, top: f32) -> int {
  if !net_on(s) { return at; }
  m := net_of(s)[0].mod[..];
  for b: 0..<MB_N { m[0].boxes[b] = Box.{}; }
  m[0].pane = Box.{};
  if !m[0].open { return at; }
  k := hi(s[0].dpr, 0.5);
  words := [MB_N] string.["BLOCK", "REPORT", "KICK", "CLOSE"];
  gap := 8 * k; bh := 38 * k;
  row := 0.0f32;
  for b: 0..<MB_N { if b != MB_KICK || md_admin(s) { row += text_width(words[b], 9 * k) + 32 * k + gap; } }
  row -= gap;
  name := cast(string) m[0].name[0..<m[0].name_n];
  cap := 9 * k;
  pw := hi(row, text_width(name, cap)) + 32 * k;
  pw = lo(pw, s[0].width - 32 * k);
  x0 := (s[0].width - pw) / 2;
  pane := Box.{x0 = x0, y0 = top, x1 = x0 + pw, y1 = top + cap + bh + 46 * k};
  m[0].pane = pane;
  plate(s, u, pane, 0.9, 0);
  v := draw_text(out, at, name, x0 + (pw - text_width(name, cap)) / 2, top + 14 * k + cap, cap, GAP, SPACE, ink(k, 0.95, PARCH_R, PARCH_G, PARCH_B), false, false);
  x := x0 + (pw - row) / 2; y := top + cap + 30 * k;
  for b: 0..<MB_N {
    if b == MB_KICK && !md_admin(s) { continue; }
    bw := text_width(words[b], 9 * k) + 32 * k;
    box := Box.{x0 = x, y0 = y, x1 = x + bw, y1 = y + bh};
    m[0].boxes[b] = box;
    v = jn_button(s, out, u, v, box, words[b], m[0].press == b);
    x += bw + gap;
  }
  return v;
}

// A press on a player's nameplate opens the pane; while it is up it takes every press (outside it, CLOSE).
md_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, id: int) -> bool {
  if !net_on(s) { return false; }
  m := net_of(s)[0].mod[..];
  if phase == 0 {
    if m[0].open {
      for b: 0..<MB_N { if in_box(m[0].boxes[b], x, y) { m[0].press = b; m[0].finger = id; return true; } }
      if !in_box(m[0].pane, x, y) { m[0].open = false; m[0].finger = id; m[0].press = -2; }
      return true;
    }
    for p: 0..<m[0].plates {
      if in_box(m[0].plate_box[p], x, y) { md_open(s, p); m[0].finger = id; m[0].press = -2; return true; }
    }
    return false;
  }
  if m[0].finger != id { return m[0].open; }
  if phase == 1 { return true; }
  b := m[0].press; m[0].press = -1; m[0].finger = -1;
  if b < 0 || phase != 2 || !in_box(m[0].boxes[b], x, y) { return true; }
  md_act(s, b);
  return true;
}

// The ask for a button, through the pipe; the pane closes.
md_act :: (s: [] Everglade, b: int) {
  n := net_of(s); m := n[0].mod[..];
  m[0].open = false;
  if b == MB_CLOSE { return; }
  who := cast(string) m[0].who[0..<m[0].who_n];
  name := cast(string) m[0].name[0..<m[0].name_n];
  if who.count < 3 { return; }
  t: [256] u8; k := 0;
  if b == MB_BLOCK {
    k = wire_put(t[..], 0, "/api/playtest/block\n{\"player\":\""); k = wire_put(t[..], k, who); k = wire_put(t[..], k, "\",\"on\":true}");
    md_block_add(n, who);   // gone from your view now; the API keeps it
    room_drop(s[0].room[..], 0, who);   // and their lines already on the chat panel
    m[0].asked = MD_ASK_BLOCK;
    md_say(s, "BLOCKED · ", name);
  } else if b == MB_REPORT {
    if who.count != 18 || who[0..<2] != "p-" { return; }
    k = wire_put(t[..], 0, "/api/villa/report\n{\"kind\":\"player\",\"ref\":\""); k = wire_put(t[..], k, who[2..<18]);
    k = wire_put(t[..], k, "\",\"why\":\"reported in an Everglade room\"}");
    m[0].asked = MD_ASK_REPORT;
  } else if b == MB_KICK {
    if !md_admin(s) { return; }
    k = wire_put(t[..], 0, "/api/playtest/room-kick\n{\"player\":\""); k = wire_put(t[..], k, who); k = wire_put(t[..], k, "\"}");
    m[0].asked = MD_ASK_KICK;
  } else { return; }
  if !pipe_put(n[0].pipe[..], NET_PIPE_ASK, -1, cast(string) t[0..<k]) { m[0].asked = 0; }
}
md_say :: (s: [] Everglade, a: string, b: string) {
  t: [96] u8; k := wire_put(t[..], 0, a);
  for ch: b { if k >= 96 { break; } t[k] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; k += 1; }
  if s[0].started { sp_say(s, cast(string) t[0..<k], -1, ""); }
}
// The API's answer to the last ask ("200\n{...}", anything else a refusal).
net_moderated :: (s: [] Everglade, answer: string) #export_c {
  if !net_on(s) { return; }
  if ege_answered(s, answer) { return; }   // the EVENTS pane's (everglade-events.coax)
  m := net_of(s)[0].mod[..];
  asked := m[0].asked; m[0].asked = 0;
  ok := answer.count > 4 && answer[0..<4] == "200\n";
  if !ok {
    why := net_json_field(answer, "error");
    md_say(s, "CAN'T · ", ifx why.count > 0 then why else "TRY AGAIN");
    return;
  }
  if asked == MD_ASK_REPORT { md_say(s, "REPORTED · ", cast(string) m[0].name[0..<m[0].name_n]); }
  else if asked == MD_ASK_KICK { md_say(s, "KICKED · ", cast(string) m[0].name[0..<m[0].name_n]); }
}

// For a headless check (net_probe): 31 nameplates you could tap this frame, 32 and 33 the first one's
// middle (CSS px), 34 the pane open (1), 35 and 36 its BLOCK's middle (CSS px, -1 while it isn't
// drawn), 37 the players you block, 38 the other players drawn as bodies (those you don't block).
// 300 + SEAT opens the pane on that seat's player, as a tap on their nameplate does: 1 when it did.
md_probe :: (s: [] Everglade, field: int) -> int {
  if !net_on(s) { return -1; }
  n := net_of(s);
  m := n[0].mod[..];
  k := hi(s[0].dpr, 0.5);
  if field == 31 { return m[0].plates; }
  if field == 32 || field == 33 {
    if m[0].plates == 0 { return -1; }
    b := m[0].plate_box[0];
    return cast(int) (ifx field == 32 then (b.x0 + b.x1) / 2 / k else (b.y0 + b.y1) / 2 / k);
  }
  if field == 34 { return ifx m[0].open then 1 else 0; }
  if field == 35 || field == 36 {
    b := m[0].boxes[MB_BLOCK];
    if b.x1 <= b.x0 { return -1; }
    return cast(int) (ifx field == 35 then (b.x0 + b.x1) / 2 / k else (b.y0 + b.y1) / 2 / k);
  }
  if field == 37 { return m[0].blocks; }
  if field == 38 {
    c := 0;
    for j: 0..<net_count(s, WK_PLAYER) { v := net_view(s, WK_PLAYER, j); if v.ok && !net_blocks(s, net_view_id(s, WK_PLAYER, j)) { c += 1; } }
    return c;
  }
  if field >= 300 && field < 300 + EG_RA_SEATS {
    for j: 0..<net_count(s, WK_PLAYER) {
      v := net_view(s, WK_PLAYER, j);
      if !v.ok || v.eid != field - 300 { continue; }
      id := net_view_id(s, WK_PLAYER, j);
      if id.count == 0 { return 0; }
      m[0].who_n = md_copy(m[0].who[..], 0, NET_ID, id);
      m[0].name_n = md_copy(m[0].name[..], 0, NET_NAME, net_view_name(s, WK_PLAYER, j));
      m[0].open = true;
      return 1;
    }
    return 0;
  }
  return -1;
}
#test "moderate: the ticket's blocks hide those players' bodies, and BLOCK hides one at once" {
  g: [1] Everglade; nn: [1] EgNet;
  everglade_attach_net(g[..], nn[..]);
  n := net_of(g[..]);
  md_ticket(n, "200\n{\"ticket\":\"v2.x\",\"id\":\"p-me\",\"blocked\":\"p-00000000000000aa,p-00000000000000bb\"}");
  #assert n[0].mod[0].blocks == 2 && md_is_blocked(n, "p-00000000000000aa") && md_is_blocked(n, "p-00000000000000bb") && !md_is_blocked(n, "p-00000000000000cc");
  md_ticket(n, "200\n{\"ticket\":\"v2.x\",\"id\":\"p-me\"}");
  #assert n[0].mod[0].blocks == 0;
  // a tap on a nameplate opens the pane; BLOCK hides them and asks the API
  md_plate(g[..], Box.{x0 = 100, y0 = 100, x1 = 160, y1 = 120}, "p-00000000000000cc", "Willow Salmon");
  // the check's probes (net_probe 31 to 38): the plate's middle, and nothing open yet
  #assert net_probe(g[..], 31) == 1 && net_probe(g[..], 34) == 0 && net_probe(g[..], 35) == -1 && net_probe(g[..], 37) == 0;
  g[0].dpr = 2;
  #assert net_probe(g[..], 32) == 65 && net_probe(g[..], 33) == 55;
  g[0].dpr = 1;
  #assert net_probe(g[..], 300) == 0;   // no seat 0 here to open it on
  #assert md_pointer(g[..], 130, 110, 0, 1) && md_pointer(g[..], 130, 110, 2, 1) && n[0].mod[0].open;
  n[0].mod[0].boxes[MB_BLOCK] = Box.{x0 = 10, y0 = 10, x1 = 50, y1 = 40};
  #assert net_probe(g[..], 34) == 1 && net_probe(g[..], 35) == 30 && net_probe(g[..], 36) == 25;
  #assert md_pointer(g[..], 20, 20, 0, 2) && md_pointer(g[..], 20, 20, 2, 2);
  #assert !n[0].mod[0].open && md_is_blocked(n, "p-00000000000000cc") && n[0].mod[0].asked == MD_ASK_BLOCK && net_probe(g[..], 37) == 1;
  #assert n[0].pipe[0].n == 1 && n[0].pipe[0].op[0] == NET_PIPE_ASK && pipe_bytes(n[0].pipe[..], 0) == "/api/playtest/block\n{\"player\":\"p-00000000000000cc\",\"on\":true}";
}

#test "moderate: REPORT sends the player's 16 hex; KICK is an admin's; a tap off the pane closes it" {
  g: [1] Everglade; nn: [1] EgNet;
  everglade_attach_net(g[..], nn[..]);
  n := net_of(g[..]);
  md_plate(g[..], Box.{x0 = 100, y0 = 100, x1 = 160, y1 = 120}, "p-0123456789abcdef", "Ranger Bob");
  md_open(g[..], 0);
  md_act(g[..], MB_REPORT);
  #assert pipe_bytes(n[0].pipe[..], 0) == "/api/villa/report\n{\"kind\":\"player\",\"ref\":\"0123456789abcdef\",\"why\":\"reported in an Everglade room\"}";
  md_open(g[..], 0);
  md_act(g[..], MB_KICK);
  #assert n[0].pipe[0].n == 1;   // not an admin: no ask
  g[0].ev.admin = true;
  md_open(g[..], 0);
  md_act(g[..], MB_KICK);
  #assert n[0].pipe[0].n == 2 && pipe_bytes(n[0].pipe[..], 1) == "/api/playtest/room-kick\n{\"player\":\"p-0123456789abcdef\"}";
  md_open(g[..], 0);
  n[0].mod[0].pane = Box.{x0 = 0, y0 = 0, x1 = 50, y1 = 50};
  #assert md_pointer(g[..], 300, 300, 0, 3) && !n[0].mod[0].open && md_pointer(g[..], 300, 300, 2, 3);
  net_moderated(g[..], "403\n{\"error\":\"admins only\"}");
  #assert n[0].mod[0].asked == 0;
}

#test "moderate: on a phone the pane opens under your LEVEL plate and the chat line, never under them" {
  g: [1] Everglade; nn: [1] EgNet;
  everglade_attach_net(g[..], nn[..]);
  g[0].width = 1170; g[0].height = 2532; g[0].dpr = 3; g[0].touch = true;
  ege_of(g[..])[0].level_box = Box.{x0 = 48, y0 = 220, x1 = 520, y1 = 300};
  g[0].chat.box = Box.{x0 = 48, y0 = 320, x1 = 200, y1 = 380};
  #assert md_top(g[..], 180) == 380 + 24;
  g[0].touch = false; g[0].width = 1600; g[0].dpr = 1;
  #assert md_top(g[..], 180) == 180;   // a desktop's top row leaves the middle free
}

#test "moderate: BLOCK takes their lines off the chat panel at once, and leaves the others'" {
  g: [1] Everglade; nn: [1] EgNet;
  everglade_attach_net(g[..], nn[..]);
  a := "200\n{\"last\": 2, \"others\": [], \"messages\": [{\"n\": 1, \"name\": \"Wren\", \"text\": \"rude\", \"from\": \"p-00000000000000cc\"}, {\"n\": 2, \"name\": \"Finch\", \"text\": \"hi\", \"from\": \"p-00000000000000dd\"}]}";
  #assert room_take(g[0].room[..], a) == 200 && g[0].room[0].lines == 2;
  md_plate(g[..], Box.{x0 = 100, y0 = 100, x1 = 160, y1 = 120}, "p-00000000000000cc", "Wren");
  #assert md_pointer(g[..], 130, 110, 0, 1) && md_pointer(g[..], 130, 110, 2, 1);
  md_act(g[..], MB_BLOCK);
  #assert g[0].room[0].lines == 1 && room_line_text(g[0].room[..], 0) == "hi";
}
