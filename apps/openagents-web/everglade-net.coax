// Everglade's network client (docs/verse/2026-11-03-everglade-multiplayer-spec.md sections 3.6 to
// 3.10 and 6; GitHub #12706 and #12708), loaded by everglade.coax. The room server owns the shared
// world (owner, 2026-11-03): every player, creature, zone, spell's cast, hit and break is the
// server's, and this page draws them. It sends intents: its input every step (I), its casts (C), its
// interactions (E), a rebuild (R). It predicts only its own movement, with the same Coax step the
// server runs on the same input (everglade-move.coax, everglade-step.coax), and when the server's
// state for its seat comes (D's p entry and ACK) it starts again from there and re-runs the inputs
// the server hasn't stepped yet (the face runs the step: net_fix_*, net_replay_*). The frames are
// everglade-wire.coax's (version 2), the contract the server #loads too.
//
// The face (everglade5e-face.c) opens one WebSocket,
//   wss://HOST/api/room/relay/everglade/CODE      (?relay=ws://localhost:PORT a room server on this
//                                                 machine, ?relay=wss://openagents.com production's from a
//                                                 page on this machine; ?room=pair-x a room of a test's own)
// carries this file's frames out through its Pipe (socket.coax) and hands it every event (net_event).
// What it keeps:
//   - the server clock: your monotonic ms plus an offset, first the page's wall clock, then the y
//     frame's T, then the lowest round trip of the last NET_PINGS pings; a tick's time from W;
//   - each player's, townsperson's and creature's last NET_RING states from the server's ticks (D),
//     drawn a jitter buffer's delay behind the server clock: NET_BASE ms plus the states' lateness, twice
//     their arrival jitter and one interval, NET_LOW to NET_HIGH ms; between the two states round that time (yaw the
//     short way), past the newest by its velocity for NET_AHEAD ms at most, then held;
//   - your inputs, NET_HIST of them, until the server has stepped them; where the re-run puts you
//     differs from where you were drawn by a little: that is eased out over NET_SMOOTH s (past
//     NET_SNAP m at once);
//   - casts the server took (e cast): played from its seed, so they fall where they fall for everyone,
//     harming nothing here; hits (e hit) pop their numbers; a break (e break) breaks the piece here,
//     the rebuild (e rebuild) stands the town up; what the server refuses (r) says why under the bar.
// Creatures and zones (Conjure Animals' pack, Wall of Stone, Black Tentacles, Wall of Thorns, the
// lingering zones and walls) are drawn here (net_draw); the other players and the townsfolk are read
// through net_view by what draws them (everglade-rangers.coax).
//   coax/bin/coax test apps/openagents-web/everglade5e.coax --only "net:"

#load "socket.coax";
#load "everglade-wire.coax";
#load "everglade-join.coax";   // which instance, who you are in it, INVITE (#12716)
#load "everglade-moderate.coax";   // BLOCK, REPORT and KICK from a nameplate (#12714)

NET_ENTS :: 256;
NET_RING :: 8;            // a state's last few: 8 at 15 Hz hold 470 ms, past NET_HIGH
NET_HIST :: 64;            // your inputs kept for the server's ACK
NET_FX :: 8;               // casts waiting for their time
NET_ID :: 24; NET_NAME :: 40; NET_LOOK :: 32; NET_CODE :: 24; NET_URL :: 200;
NET_TICKET :: 256;   // a seat ticket's most bytes (coax/web/room/room-ticket.coax)
NET_PIPE_STATE :: 5;    // the pipe's save of what you bring back into a room: its bytes the JSON to POST to /api/playtest/room-state (#12715)
NET_STATE_EVERY :: 2000;   // ms: a changed WANTED or look is saved at most this often
NET_PIPE_TICKET :: 4;   // the pipe's ask for a seat ticket: its bytes the API path to POST, a newline, the body (the face carries it)
NET_BASE :: 20; NET_LOW :: 80; NET_HIGH :: 300;   // ms: the jitter buffer's delay (NET_BASE over the states' lateness, spread and interval)
NET_AHEAD :: 150;          // ms past its newest state an entity goes on by its velocity
NET_SNAP :: 1.5;           // m: a re-run's difference this big is taken at once (a teleport, a throw)
NET_SMOOTH :: 0.12;        // s a smaller one is eased out over (a start or stop the page and server stepped apart)
NET_PINGS :: 8;
NET_SAY :: 4.0;            // s a refusal shows
NET_GAME :: "everglade";
NET_OFF :: 0; NET_OPENING :: 1; NET_OPEN :: 2; NET_DOWN :: 3;
// what an entity is, on this page: a player, a townsperson or guard, else a creature or zone (WK_*)
WK_PLAYER :: 0; WK_FOLK :: 1;
NET_FOLK_ID :: 100000; NET_MADE_ID :: 200000;   // a townsperson's and a creature's ids in the table
// a target or hit's WHO code (the wire's TGT): 0-999 a watch actor, 1000 + SS a seat, 2000 + EID a creature
net_who :: (who: int) -> int { return ifx who >= 2000 then NET_MADE_ID + who - 2000 else ifx who >= 1000 then who - 1000 else NET_FOLK_ID + who; }

NetState :: struct { t: int; x: f32; y: f32; z: f32; yaw: f32; vx: f32; vz: f32; f: int; a: int; }
NetEnt :: struct {
  live: bool; eid: int; kind: int; owner: int = -1;   // eid: a seat, NET_FOLK_ID + its index, NET_MADE_ID + the server's EID
  ring: [NET_RING] NetState; ring_n: int;   // oldest first, server times
  hp: int; max: int; p1: int; p2: int; form: int;
  wanted: int;               // a player's WANTED level (w)
  born: int;                 // server ms it was first seen
  seen: int;                 // the last tick it was in
  // who a player is (n)
  seat: int = -1; id: [NET_ID] u8; id_n: int; look: [NET_LOOK] u8; look_n: int; name: [NET_NAME] u8; name_n: int;
  cls: [16] u8; cls_n: int; hello_flags: int;   // its class and its hello's FLAGS (1 touch, 2 an account)
  // drawn this frame (net_step)
  shown: NetState; run: f32;
  cast_slot: int = -1; cast_at: int;   // its last cast (e cast), server ms
}
NetInput :: struct { seq: int; input: EgMoveIn; }
NetFx :: struct { live: bool; slot: int; caster: int; at: Point; seed: int; t: int; }
// You as the server has you after input `ack` (D's p entry for your seat).
NetFix :: struct { ok: bool; ack: int; x: f32; y: f32; z: f32; yaw: f32; vx: f32; vy: f32; vz: f32; ground: bool; carry: f32; jump: bool; }
EgNet :: struct {
  want: bool;
  state: int; sock: int = -1; tries: int; retry: int;
  url: [NET_URL] u8; url_n: int;
  code: [NET_CODE] u8; code_n: int;
  // the realm the room is an instance of (the ticket asks the API's directory, #12717, for the
  // instance and its oa-room shard), and how much of url is the host (wss://HOST)
  realm: [NET_CODE] u8; realm_n: int; host_n: int;
  // the seat ticket the socket opens with (?t=, #12712): asked of the API before each open, used once;
  // free: a local relay (?relay=ws://localhost:PORT), which joins without one
  ticket: [NET_TICKET] u8; ticket_n: int; ticket_asked: bool; free: bool;
  // what you bring back into a room (#12715): the WANTED level and look last saved, and when
  saved_wanted: int; saved_look: [NET_LOOK] u8; saved_look_n: int; saved_at: int; restored: bool;
  edit_due: bool;            // the server said "e edit": the world and the board are asked for again (#12714)
  pid: [NET_ID] u8; pid_n: int; account: bool;
  look: [NET_LOOK] u8; look_n: int;
  mono: int;                 // this frame's monotonic ms
  offset: int;               // server ms = mono + offset
  synced: int;               // 0 the wall clock, 1 the y frame's T, 2 a ping's
  ping_rtt: [NET_PINGS] int; ping_off: [NET_PINGS] int; pings: int; ping_at: int; ping_n: int;
  seat: int = -1;
  ents: [NET_ENTS] NetEnt;
  // the world's clock (W): tick `w_tick` was server time `w_t`, `hz` ticks a second
  hz: int = WIRE_HZ; w_tick: int; w_t: int; seed: int; day: int; weather: int; worlds: int;
  tick: int; tick_t: int;    // the last state's tick and its server time
  late_mean: f32; jitter: f32; interval: f32 = 66; delay: int = 160; ticks: int;
  snap_tick: int = -1;       // the tick a full snapshot is coming in for
  // your inputs, and the server's word on you
  seq: int; inputs: [NET_HIST] NetInput; acked: int;
  fix: NetFix; fix_due: bool;
  off_x: f32; off_y: f32; off_z: f32;   // where you are drawn less where you are, eased out
  wanted: int = -1;          // your WANTED level (w; -1 none heard: the server runs no town)
  breaks_heard: int; burns_heard: int;   // the town's pieces the server broke and lit (e break, e burn)
  fx: [NET_FX] NetFx;
  air: [WATCH_ACTORS] f32;   // how high over their feet each townsperson is, as the server says (a, m)
  said: [48] u8; said_n: int; said_t: f32;   // the last refusal's reason
  hello_due: bool;
  pipe: [1] Pipe;
  out: [WIRE_FRAME] u8;
  frames_in: int; frames_out: int; played: int; hits: int; replays: int;
  creature_hits: int; creature_deaths: int;   // hits on and deaths of the server's creatures heard
  feet_y: f32;                                // your feet's height as the face last gave it (net_step's fy)
  join: [1] EgJoin;                           // the instance, the CHARACTER picker and INVITE (everglade-join.coax)
  mod: [1] EgMod;                             // your blocks and the nameplate pane (everglade-moderate.coax)
}

everglade_attach_net :: (s: [] Everglade, n: [] EgNet) #export_c { s[0].net = n; }
net_of :: (s: [] Everglade) -> [] EgNet { return s[0].net; }
net_on :: (s: [] Everglade) -> bool { return s[0].net.count > 0; }
// The socket is open and you sit in the room: the server's world is what this page shows.
net_live :: (s: [] Everglade) -> bool #export_c { return net_on(s) && net_of(s)[0].state == NET_OPEN && net_of(s)[0].seat >= 0; }
net_now :: (n: [] EgNet) -> int { return n[0].mono + n[0].offset; }
// The server clock in ms, -1 while none is known.
net_clock :: (s: [] Everglade) -> int #export_c { if !net_on(s) || net_of(s)[0].mono == 0 { return -1; } return net_now(net_of(s)); }

net_copy :: (out: [] u8, t: string) -> int {
  n := 0;
  for ch: t { if n >= out.count { break; } if ch <= 32 || ch == 127 { continue; } out[n] = ch; n += 1; }
  return n;
}
net_send :: (n: [] EgNet, count: int) {
  if n[0].state != NET_OPEN || n[0].sock < 0 || count <= 0 { return; }
  if pipe_send(n[0].pipe[..], n[0].sock, cast(string) n[0].out[0..<count]) { n[0].frames_out += 1; }
}
net_turn :: (a: f32, b: f32) -> f32 {
  d := b - a;
  while d > f32(PI) { d -= f32(TAU); }
  while d < -f32(PI) { d += f32(TAU); }
  return d;
}

// ---- the page: where the socket goes, and the clock

net_query :: (url: string, key: string) -> string {
  at := 0;
  while at + key.count + 1 <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1; e := i;
      while e < url.count && url[e] != 38 && url[e] != 35 { e += 1; }
      return url[i..<e];
    }
    at += 1;
  }
  return "";
}
net_code_ok :: (t: string) -> bool {
  if t.count == 0 || t.count > NET_CODE { return false; }
  for ch: t { if !((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-') { return false; } }
  return true;
}
net_number :: (t: string) -> int { r: [1] WireRd; v := wire_num(t, r[..]); return ifx r[0].ok then v else -1; }
// The page facts (message 600): the socket's address, your player id, the wall clock. `room` is the
// room's name when the URL names none; a golden page opens no socket.
net_facts :: (s: [] Everglade, facts: string, room: string, golden: bool) #export_c {
  if !net_on(s) { return; }
  n := net_of(s);
  url := fact(facts, "url");
  n[0].free = false;
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  secure := url.count > 5 && url[0..<5] == "https";
  start := ifx secure then 8 else 7;
  m := wire_put(n[0].url[..], 0, ifx secure then "wss://" else "ws://");
  if start < k { m = wire_put(n[0].url[..], m, url[start..<k]); }
  relay := net_query(url, "relay");
  if relay.count > 15 && relay.count < 40 && relay[0..<15] == "ws://localhost:" {
    ok := true;
    for c: relay[15..<relay.count] { if c < '0' || c > '9' { ok = false; } }
    if ok { m = wire_put(n[0].url[..], 0, relay); n[0].free = true; }
  }
  // a page on this machine can sit in production's rooms (a two-browser check against the live server)
  local := url.count > 16 && (url[0..<17] == "http://localhost:" || (url.count > 17 && url[0..<17] == "http://127.0.0.1:"));
  if local && relay == "wss://openagents.com" { m = wire_put(n[0].url[..], 0, relay); }
  n[0].host_n = m;
  n[0].realm_n = ifx net_code_ok(room) && room.count <= 20 then net_copy(n[0].realm[..], room) else 0;
  m = wire_put(n[0].url[..], m, "/api/room/relay/");
  m = wire_put(n[0].url[..], m, NET_GAME);
  m = wire_put(n[0].url[..], m, "/");
  n[0].url_n = m;
  jn_facts(s, n, url, room, golden);   // the instance: named, listed or a local server's (everglade-join.coax)
  n[0].want = !golden && start < k && (n[0].code_n > 0 || n[0].join[0].list_due);
  pid := fact(facts, "player");
  if pid.count > 0 { n[0].pid_n = net_copy(n[0].pid[..], pid); }
  n[0].account = fact(facts, "account").count > 0;
  // the wall clock until the server says its own: now (Date.now()) less nav (ms since the navigation)
  wall := net_number(fact(facts, "now")); nav := net_number(fact(facts, "nav"));
  if wall > 0 && nav >= 0 && n[0].synced == 0 { n[0].offset = wall - nav; }
  if n[0].look_n == 0 { n[0].look_n = net_copy(n[0].look[..], "ranger.0.0.0"); }
}
// A minted player (POST /api/playtest/player answered {"key":...,"id":"...",...}): its id for the hello.
net_player :: (s: [] Everglade, record: string) #export_c {
  if !net_on(s) { return; }
  n := net_of(s);
  key := "\"id\":\"";
  for i: 0..<record.count {
    if i + key.count > record.count || record[i..<i + key.count] != key { continue; }
    e := i + key.count;
    while e < record.count && record[e] != '"' { e += 1; }
    n[0].pid_n = net_copy(n[0].pid[..], record[i + key.count..<e]);
    if n[0].state == NET_OPEN { n[0].hello_due = true; }
    return;
  }
}
// The API's answer to the seat-ticket ask ("200\n{"ticket":"...",...}", anything else a refusal): the
// next open uses it; a refusal waits as a closed socket does, then asks again.
net_ticket :: (s: [] Everglade, answer: string) #export_c {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].ticket_asked = false;
  key := "\"ticket\":\"";
  if answer.count > 4 && answer[0..<4] == "200\n" {
    for i: 4..<answer.count {
      if i + key.count > answer.count || answer[i..<i + key.count] != key { continue; }
      e := i + key.count;
      while e < answer.count && answer[e] != '"' { e += 1; }
      if e < answer.count && e - i - key.count > 0 && e - i - key.count <= NET_TICKET {
        n[0].ticket_n = net_copy(n[0].ticket[..], answer[i + key.count..<e]);
        had_look := (n[0].restored && n[0].saved_look_n > 0) || net_json_field(answer, "look").count > 0;
        net_placed(n, net_json_field(answer, "room"), net_number(net_json_field(answer, "shard")));
        net_restore(s, n, answer);
        md_ticket(n, answer);   // who you block (#12714)
        jn_ticketed(s, n, answer, had_look);   // a first visit: CHARACTER before you join
        return;
      }
    }
  }
  n[0].ticket_n = 0;
  net_down(n);
}
// Where the API's directory put you (#12717): the instance and the oa-room shard that holds it. The
// socket opens on that shard's path, wss://HOST/api/room/sK/relay/everglade/INSTANCE, which the load
// balancer sends to shard K (a shard seats only its own tickets); the next open asks for the same
// instance, so a reconnect sits where it was. A local relay keeps its own address.
net_placed :: (n: [] EgNet, room: string, shard: int) {
  if n[0].free || !net_code_ok(room) || shard < 1 || shard > 99 { return; }
  n[0].code_n = net_copy(n[0].code[..], room);
  m := n[0].host_n;
  m = wire_put(n[0].url[..], m, "/api/room/s");
  digits := "0123456789";
  if shard >= 10 { m = wire_put(n[0].url[..], m, digits[shard / 10..<shard / 10 + 1]); }
  m = wire_put(n[0].url[..], m, digits[shard % 10..<shard % 10 + 1]);
  m = wire_put(n[0].url[..], m, "/relay/"); m = wire_put(n[0].url[..], m, NET_GAME); m = wire_put(n[0].url[..], m, "/");
  m = wire_put(n[0].url[..], m, room);
  n[0].url_n = m;
}
// What the ticket's answer brings back (#12715), once a page: your WANTED level (kept 5 minutes; the
// watch takes it as a "+wantedN" start) and your look (the hello sends it). The HP is the server's.
net_restore :: (s: [] Everglade, n: [] EgNet, answer: string) {
  if n[0].restored { return; }
  n[0].restored = true;
  w := net_json_field(answer, "wanted");
  level := net_number(w);
  if level > 0 && level <= 5 { s[0].wv.want = level; }
  n[0].saved_wanted = ifx level > 0 && level <= 5 then level else 0;
  look := net_json_field(answer, "look");
  if look.count > 0 && look.count <= NET_LOOK && look[0] != '"' {
    n[0].look_n = net_copy(n[0].look[..], look);
    n[0].saved_look_n = net_copy(n[0].saved_look[..], look);
  }
}
// A field of a flat JSON answer, its text without quotes ("" none).
net_json_field :: (t: string, name: string) -> string {
  for i: 0..<t.count {
    if t[i] != '"' || i + name.count + 3 > t.count || t[i + 1..<i + 1 + name.count] != name || t[i + 1 + name.count] != '"' || t[i + 2 + name.count] != ':' { continue; }
    a := i + 3 + name.count;
    q := a < t.count && t[a] == '"';
    if q { a += 1; }
    e := a;
    while e < t.count && (ifx q then t[e] != '"' else (t[e] != ',' && t[e] != '}')) { e += 1; }
    return t[a..<e];
  }
  return "";
}
// While you play in a room: a WANTED level or look that changed is saved (at most every NET_STATE_EVERY).
net_save_state :: (s: [] Everglade, n: [] EgNet) {
  if n[0].free || !net_live(s) || n[0].mono - n[0].saved_at < NET_STATE_EVERY { return; }
  you := watch_you(s[0].wt[..]);
  level := ifx you[0].wanted then you[0].level else 0;
  if level < 0 { level = 0; }
  if level > 5 { level = 5; }
  look := cast(string) n[0].look[0..<n[0].look_n];
  if level == n[0].saved_wanted && look == cast(string) n[0].saved_look[0..<n[0].saved_look_n] { return; }
  b: [128] u8;
  k := wire_put(b[..], 0, "{\"wanted\":"); k = wire_put(b[..], k, ifx level == 0 then "0" else ifx level == 1 then "1" else ifx level == 2 then "2" else ifx level == 3 then "3" else ifx level == 4 then "4" else "5");
  k = wire_put(b[..], k, ",\"look\":\""); k = wire_put(b[..], k, look); k = wire_put(b[..], k, "\",\"class\":\"druid\"}");
  if pipe_put(n[0].pipe[..], NET_PIPE_STATE, -1, cast(string) b[0..<k]) {
    n[0].saved_wanted = level; n[0].saved_look_n = net_copy(n[0].saved_look[..], look); n[0].saved_at = n[0].mono;
  }
}
// Whether the server said the world changed since the face last asked (the face asks for it again).
net_edit_take :: (s: [] Everglade) -> bool #export_c {
  if !net_on(s) || !net_of(s)[0].edit_due { return false; }
  net_of(s)[0].edit_due = false;
  return true;
}
// The room's name (the chat's too).
net_room :: (s: [] Everglade, room: string) -> string #export_c {
  if !net_on(s) || net_of(s)[0].code_n == 0 { return room; }
  return cast(string) net_of(s)[0].code[0..<net_of(s)[0].code_n];
}
// The look you show ("ranger.SKIN.DYE.TRIM", spec 5.2).
net_set_look :: (s: [] Everglade, look: string) #export_c {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].look_n = net_copy(n[0].look[..], look);
  if n[0].state == NET_OPEN { n[0].hello_due = true; }
}

// ---- the socket's events

// The face opened the socket: its id, or -1 (refused).
net_opened :: (s: [] Everglade, id: int) #export_c {
  if !net_on(s) { return; }
  if id < 0 { net_down(net_of(s)); return; }
  net_of(s)[0].sock = id;
}
// Closed: the world goes with it (nothing is shown that the server isn't saying), and the socket is
// tried again after a wait that doubles to a minute.
net_down :: (n: [] EgNet) {
  n[0].state = NET_DOWN; n[0].sock = -1; n[0].seat = -1;
  n[0].tries += 1;
  wait := 1000;
  for q: 0..<lo_int(n[0].tries - 1, 6) { wait *= 2; }
  n[0].retry = n[0].mono + lo_int(wait, 60000);
  for e: 0..<NET_ENTS { n[0].ents[e].live = false; }
  for q: 0..<NET_FX { n[0].fx[q].live = false; }
  for i: 0..<WATCH_ACTORS { n[0].air[i] = 0; }
  n[0].fix_due = false; n[0].off_x = 0; n[0].off_y = 0; n[0].off_z = 0;
}
// A socket event (message kind 256 + 4 * id + event, its text in the inbox): true when it was ours.
net_event :: (s: [] Everglade, kind: int, text: string) -> bool #export_c {
  if !net_on(s) { return false; }
  n := net_of(s);
  ev := socket_event(kind);
  if ev.id < 0 || ev.id != n[0].sock { return false; }
  if ev.event == SOCKET_OPENED { n[0].state = NET_OPEN; n[0].tries = 0; n[0].ping_n = 0; n[0].ping_at = 0; return true; }
  if ev.event == SOCKET_ERROR && text.count > 0 && n[0].state == NET_OPEN { return true; }   // a frame over the inbox cap: dropped
  if ev.event == SOCKET_CLOSED || ev.event == SOCKET_ERROR {
    if n[0].seat < 0 { jn_refused(s, n); }   // closed before a seat: full, or gone (everglade-join.coax)
    net_down(n); return true;
  }
  if ev.event == SOCKET_FRAME {
    n[0].frames_in += 1;
    net_record(s, n, text);
  }
  return true;
}
// The entity with id eid, made when new (make); -1 none or no room.
net_ent :: (n: [] EgNet, eid: int, make: bool) -> int {
  free := -1;
  for e: 0..<NET_ENTS {
    if n[0].ents[e].live && n[0].ents[e].eid == eid { return e; }
    if !n[0].ents[e].live && free < 0 { free = e; }
  }
  if !make || free < 0 { return -1; }
  n[0].ents[free] = NetEnt.{live = true, eid = eid, born = n[0].tick_t};
  return free;
}
// A tick's server time (W's clock), or the last state's when no W has come.
net_tick_t :: (n: [] EgNet, tick: int) -> int {
  if n[0].worlds == 0 || n[0].hz <= 0 { return net_now(n); }
  return n[0].w_t + (tick - n[0].w_tick) * 1000 / n[0].hz;
}
// One frame from the server (or the relay).
net_record :: (s: [] Everglade, n: [] EgNet, t: string) {
  if t.count < 1 { return; }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  if !r[0].ok { return; }
  c := t[0];
  if c == 'y' {
    seat := wire_num(t, r[..]); _ := wire_num(t, r[..]); clock := wire_num(t, r[..]);
    if seat < 0 { return; }
    n[0].seat = seat; n[0].wanted = -1; jn_seated(n);
    if r[0].ok && clock > 0 && n[0].synced < 2 { n[0].offset = clock - n[0].mono; n[0].synced = 1; }
    n[0].hello_due = true; n[0].acked = n[0].seq; n[0].fix_due = false;
    return;
  }
  if c == 't' {
    sent := wire_num(t, r[..]); clock := wire_num(t, r[..]);
    if !r[0].ok || sent > n[0].mono || sent <= 0 { return; }
    rtt := n[0].mono - sent;
    q := n[0].pings % NET_PINGS;
    n[0].ping_rtt[q] = rtt; n[0].ping_off[q] = clock + rtt / 2 - n[0].mono;
    n[0].pings += 1;
    best := 0;
    for i: 0..<lo_int(n[0].pings, NET_PINGS) { if n[0].ping_rtt[i] < n[0].ping_rtt[best] { best = i; } }
    n[0].offset = n[0].ping_off[best]; n[0].synced = 2;
    return;
  }
  if c == 'W' {
    w := wire_read_world(t, r[..]);
    if !r[0].ok { return; }
    n[0].w_tick = w.tick; n[0].w_t = net_now(n); n[0].hz = clamp_i(w.hz, 1, 120);
    n[0].seed = w.seed; n[0].day = w.day; n[0].weather = w.weather; n[0].worlds += 1;
    return;
  }
  if c == 'D' {
    d := wire_read_d(t, r[..]);
    if !r[0].ok { return; }
    clock := net_tick_t(n, d.tick);
    if d.tick != n[0].tick || n[0].ticks == 0 {
      // the jitter buffer: how late each state comes, its spread, and the states' interval
      late := f32(net_now(n) - clock);
      if n[0].ticks == 0 { n[0].late_mean = late; }
      n[0].jitter += (abs(late - n[0].late_mean) - n[0].jitter) * 0.1;
      n[0].late_mean += (late - n[0].late_mean) * 0.1;
      if n[0].ticks > 0 && clock > n[0].tick_t { n[0].interval += (f32(clock - n[0].tick_t) - n[0].interval) * 0.1; }
      // behind the newest state by how late states come (late_mean: the way here and the server's
      // send), their spread and one interval, so the time drawn has a state after it even when the
      // server's states come two at once (15 Hz in pairs: 135 ms gaps); without the lateness the
      // buffer ran dry each gap and the others stood, then lurched
      n[0].delay = clamp_i(NET_BASE + cast(int) (hi(n[0].late_mean, 0) + n[0].interval + 2 * n[0].jitter), NET_LOW, NET_HIGH);
      n[0].ticks += 1;
    }
    n[0].tick = d.tick; n[0].tick_t = clock;
    from := r[0].at;
    for k: 0..<wire_entries(t, from) { net_entry(s, n, wire_entry(t, from, k), d); }
    // a full snapshot's last frame: what it didn't hold is gone
    if d.f == 1 {
      for e: 0..<NET_ENTS { if n[0].ents[e].live && n[0].ents[e].seen != d.tick { n[0].ents[e].live = false; } }
    }
    return;
  }
  if c == 'r' {
    _ := wire_num(t, r[..]);
    why := wire_word(t, r[..]);
    n[0].said_n = 0;
    for ch: "CAN'T · " { n[0].said[n[0].said_n] = ch; n[0].said_n += 1; }
    for ch: why { if n[0].said_n >= 48 { break; } n[0].said[n[0].said_n] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; n[0].said_n += 1; }
    n[0].said_t = f32(NET_SAY);
    if s[0].started { sp_say(s, cast(string) n[0].said[0..<n[0].said_n], -1, ""); }
    return;
  }
}
// One entry of a state (D).
net_entry :: (s: [] Everglade, n: [] EgNet, t: string, d: WireD) {
  if t.count < 1 { return; }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := t[0];
  if c == 'p' {
    p := wire_read_p(t, r[..]);
    if !r[0].ok || p.ss < 0 { return; }
    k := net_ent(n, p.ss, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    en[0].kind = WK_PLAYER; en[0].owner = p.ss; en[0].seat = p.ss; en[0].seen = d.tick;
    en[0].hp = p.hp; en[0].max = p.max; en[0].p1 = p.cond; en[0].p2 = p.temp; en[0].form = p.form;
    net_push(en, NetState.{t = n[0].tick_t, x = p.x, y = p.y, z = p.z, yaw = p.yaw, vx = p.vx, vz = p.vz, f = p.g, a = p.clip});
    if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
    // yours: where the server has you after input ACK, for the face to start again from
    if p.ss == n[0].seat && d.ack > n[0].acked {
      n[0].acked = d.ack;
      // and whether that input held the jump (the re-run starts from the server's jump, not the page's)
      held := n[0].inputs[d.ack % NET_HIST];
      n[0].fix = NetFix.{ok = true, ack = d.ack, x = p.x, y = p.y, z = p.z, yaw = p.yaw, vx = p.vx, vy = p.vy, vz = p.vz,
                         ground = (p.g & WG_GROUND) != 0, carry = p.carry, jump = held.seq == d.ack && held.input.jump};
      n[0].fix_due = true;
    }
    return;
  }
  if c == 'n' {
    w := wire_read_n(t, r[..]);
    if !r[0].ok || w.ss < 0 { return; }
    k := net_ent(n, w.ss, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    if en[0].ring_n == 0 { en[0].kind = WK_PLAYER; en[0].owner = w.ss; }
    en[0].seat = w.ss; en[0].seen = d.tick;
    en[0].id_n = net_copy(en[0].id[..], w.id);
    en[0].look_n = net_copy(en[0].look[..], w.look);
    en[0].cls_n = net_copy(en[0].cls[..], w.kind); en[0].hello_flags = w.flags;
    nm := 0;
    for ch: w.name { if nm >= NET_NAME { break; } if ch < 32 { continue; } en[0].name[nm] = ch; nm += 1; }
    en[0].name_n = nm;
    return;
  }
  if c == 'f' {
    f := wire_read_f(t, r[..]);
    if !r[0].ok || f.i < 0 { return; }
    k := net_ent(n, NET_FOLK_ID + f.i, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    en[0].kind = WK_FOLK; en[0].p1 = f.i; en[0].hp = f.hp; en[0].seen = d.tick;
    net_push(en, NetState.{t = n[0].tick_t, x = f.x, z = f.z, yaw = f.yaw, f = f.mode, a = f.clip});
    if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
    return;
  }
  if c == 'c' {
    w := wire_read_c(t, r[..]);
    if !r[0].ok { return; }
    k := net_ent(n, NET_MADE_ID + w.eid, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    en[0].kind = w.kind; en[0].owner = w.owner; en[0].hp = w.hp; en[0].p1 = w.p1; en[0].p2 = w.p2; en[0].seen = d.tick;
    net_push(en, NetState.{t = n[0].tick_t, x = w.x, y = w.y, z = w.z, yaw = w.yaw, f = w.f});
    if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
    return;
  }
  if c == 'x' {
    x := wire_read_x(t, r[..]);
    if !r[0].ok { return; }
    id := ifx x.k == 'p' then x.id else ifx x.k == 'f' then NET_FOLK_ID + x.id else NET_MADE_ID + x.id;
    k := net_ent(n, id, false);
    if k >= 0 { n[0].ents[k].live = false; }
    return;
  }
  if c == 'a' {
    // a townsperson the server's abilities have off their feet (Reverse Gravity): CM over them
    i := wire_num(t, r[..]); cm := wire_num(t, r[..]);
    if !r[0].ok || i < 0 || i >= WATCH_ACTORS { return; }
    n[0].air[i] = f32(cm) / 100;
    return;
  }
  if c == 'w' {
    ss := wire_num(t, r[..]); level := wire_num(t, r[..]);
    if !r[0].ok || ss < 0 { return; }
    if ss == n[0].seat { n[0].wanted = level; return; }
    k := net_ent(n, ss, true);
    if k >= 0 { n[0].ents[k].wanted = level; }   // another's (net_view)
    return;
  }
  if c != 'e' { return; }
  if wire_is(t, "e cast") {
    r[0] = wire_rd(t, 6);
    ce := wire_read_cast_e(t, r[..]);
    if !r[0].ok || ce.slot < 0 || ce.slot >= SP_REBUILD { return; }
    k := net_ent(n, ce.ss, false);
    if k >= 0 { n[0].ents[k].cast_slot = ce.slot; n[0].ents[k].cast_at = n[0].tick_t; }
    for q: 0..<NET_FX {
      if n[0].fx[q].live { continue; }
      // the server says the cast at its press: the strike plays once the cast bar is done (the meteors
      // fall and land after its 2.5 s, as offline), on every page alike
      bar := ifx ce.slot < SP_SLOTS then cast(int) (srd_spell(SP_SPELL[ce.slot]).bar * 1000) else 0;
      n[0].fx[q] = NetFx.{live = true, slot = ce.slot, caster = ce.ss, at = v3(ce.ax, ce.ay, ce.az), seed = ce.seed, t = n[0].tick_t + bar};
      break;
    }
    return;
  }
  if wire_is(t, "e hit") {
    r[0] = wire_rd(t, 5);
    h := wire_read_hit(t, r[..]);
    if !r[0].ok { return; }
    n[0].hits += 1;
    if h.who >= 2000 { n[0].creature_hits += 1; }
    if h.amt <= 0 || !s[0].started { return; }
    at := net_where(s, n, net_who(h.who));
    if at.ok { watch_pop(s, v3(at.x, at.y + 2.1, at.z), h.amt, h.amt >= 25); }
    return;
  }
  if wire_is(t, "e break") {
    r[0] = wire_rd(t, 7);
    pc := wire_num(t, r[..]); ix := wire_f(t, r[..]); iy := wire_f(t, r[..]); iz := wire_f(t, r[..]);
    if !r[0].ok || !sp_on(s) || pc < 0 || pc >= sp_dm(s)[0].n { return; }
    // the piece breaks here as the server says, thrown by its impulse (the debris is this page's)
    c0 := demo_centre(sp_dm(s)[0].pieces[pc]);
    m := sqrt(ix * ix + iy * iy + iz * iz);
    from := ifx m > 0.01 then sub(c0, v3(ix / m, iy / m, iz / m)) else sub(c0, v3(0, 1, 0));
    demo_break(sp_dm(s), pc, from, hi(m, 2));
    n[0].breaks_heard += 1;
    s[0].sp.walls_dirty = true;
    return;
  }
  if wire_is(t, "e die") {
    r[0] = wire_rd(t, 5);
    who := wire_num(t, r[..]);
    if r[0].ok && who >= 2000 { n[0].creature_deaths += 1; }
    return;
  }
  if t.count > 7 && t[0..<7] == "e edit " {
    // an admin published or switched something: everyone's page asks for the world and the board again
    n[0].edit_due = true;
    if s[0].ev.ed.count > 0 { s[0].ev.ed[0].spec_due = true; }
    return;
  }
  if wire_is(t, "e burn") {
    r[0] = wire_rd(t, 6);
    pc := wire_num(t, r[..]); on := wire_num(t, r[..]);
    if !r[0].ok || !sp_on(s) || pc < 0 || pc >= sp_dm(s)[0].n { return; }
    // alight or out as the server says (its burning down and spreading are the server's: fi_frame)
    v := fi_of(s);
    if on == 1 { if !fi_burning(s, pc) { _ := fi_ignite(s, pc); } }
    else { for q: 0..<v[0].n { if v[0].burn[q].piece == pc { fi_drop(s, q); break; } } }
    n[0].burns_heard += 1;
    return;
  }
  if t == "e rebuild" { if sp_on(s) { _ := sp_restore(s, -1); } return; }
}
// Watch actor i (a townsperson or guard) as the server has them now (f), interpolated; ok false while
// none is heard (indoors, out of view, or no room).
NetFolk :: struct { ok: bool; x: f32; z: f32; yaw: f32; mode: int; clip: int; hp: int; }
net_folk :: (s: [] Everglade, i: int) -> NetFolk {
  if !net_live(s) { return NetFolk.{}; }
  n := net_of(s);
  k := net_ent(n, NET_FOLK_ID + i, false);
  if k < 0 { return NetFolk.{}; }
  p := n[0].ents[k].shown;
  return NetFolk.{ok = true, x = p.x, z = p.z, yaw = p.yaw, mode = p.f, clip = p.a, hp = n[0].ents[k].hp};
}
// In a room whose server runs the town (it has said your WANTED level, w): its townsfolk and guards
// are the ones drawn, and the page's own watch is still (everglade-watch.coax watch_net_frame).
net_town :: (s: [] Everglade) -> bool { return net_live(s) && net_of(s)[0].wanted >= 0; }
// Your conditions' bits as the server has them (p's COND, WC_*), 0 with none heard.
net_cond :: (s: [] Everglade) -> int {
  if !net_live(s) { return 0; }
  n := net_of(s);
  k := net_ent(n, n[0].seat, false);
  return ifx k >= 0 then n[0].ents[k].p1 else 0;
}
net_wanted :: (s: [] Everglade) -> int { return ifx net_on(s) then hi_int(net_of(s)[0].wanted, 0) else 0; }
NetWhere :: struct { ok: bool; x: f32; y: f32; z: f32; }
// Where entity id is drawn (you where you are), its feet's world height.
net_where :: (s: [] Everglade, n: [] EgNet, id: int) -> NetWhere {
  if id == n[0].seat && s[0].started { return NetWhere.{ok = true, x = s[0].feet.x, y = s[0].feet.y + walk_at(s, s[0].feet.x, s[0].feet.z), z = s[0].feet.z}; }
  k := net_ent(n, id, false);
  if k < 0 { return NetWhere.{}; }
  p := n[0].ents[k].shown;
  y := ifx n[0].ents[k].kind == WK_FOLK then walk_at(s, p.x, p.z) else p.y;
  return NetWhere.{ok = true, x = p.x, y = y, z = p.z};
}
// A state into an entity's ring, oldest first: one no newer than the newest replaces it.
net_push :: (en: [] NetEnt, p: NetState) {
  c := en[0].ring_n;
  if c > 0 && p.t <= en[0].ring[c - 1].t { en[0].ring[c - 1] = p; return; }
  if c == NET_RING { for q: 0..<NET_RING - 1 { en[0].ring[q] = en[0].ring[q + 1]; } c -= 1; }
  en[0].ring[c] = p; en[0].ring_n = c + 1;
}
// Where entity en is at server time rt.
net_state_at :: (en: [] NetEnt, rt: int) -> NetState {
  c := en[0].ring_n;
  if c == 0 { return NetState.{}; }
  if rt <= en[0].ring[0].t { return en[0].ring[0]; }
  for q: 0..<c - 1 {
    a := en[0].ring[q]; b := en[0].ring[q + 1];
    if rt > b.t { continue; }
    f := f32(rt - a.t) / f32(hi_int(b.t - a.t, 1));
    o := ifx f < 0.5 then a else b;
    return NetState.{t = rt, x = lerp(a.x, b.x, f), y = lerp(a.y, b.y, f), z = lerp(a.z, b.z, f), yaw = a.yaw + net_turn(a.yaw, b.yaw) * f,
                     vx = lerp(a.vx, b.vx, f), vz = lerp(a.vz, b.vz, f), f = o.f, a = o.a};
  }
  p := en[0].ring[c - 1];
  ahead := f32(lo_int(rt - p.t, NET_AHEAD)) / 1000;
  return NetState.{t = rt, x = p.x + p.vx * ahead, y = p.y, z = p.z + p.vz * ahead, yaw = p.yaw, vx = p.vx, vz = p.vz, f = p.f, a = p.a};
}

// ---- your movement: the inputs out, the server's word back (the face runs the step)

// One step's input: kept and sent (I). Its sequence number, 0 when there is no room to send it to.
net_input :: (s: [] Everglade, input: EgMoveIn, dive: bool) -> int #export_c {
  if !net_live(s) { return 0; }
  n := net_of(s);
  n[0].seq += 1;
  n[0].inputs[n[0].seq % NET_HIST] = NetInput.{seq = n[0].seq, input = input};
  b := (ifx input.run then WB_RUN else 0) | (ifx input.jump then WB_JUMP else 0) | (ifx dive then WB_DIVE else 0);
  net_send(n, wire_put_in(n[0].out[..], 0, WireIn.{seq = n[0].seq, kx = wire_axis(input.key_x), ky = wire_axis(input.key_y),
                                                   px = wire_axis(input.pad_x), py = wire_axis(input.pad_y), theta = input.theta, b = b}));
  return n[0].seq;
}
// The server's word on you is new: where it has you after input fix.ack (the face sets you there and
// re-runs the later inputs, net_replay_*, then says how far that moved you, net_fixed).
net_fix_due :: (s: [] Everglade) -> bool #export_c { return net_live(s) && net_of(s)[0].fix_due && net_of(s)[0].fix.ok; }
net_fix :: (s: [] Everglade) -> NetFix #export_c { return net_of(s)[0].fix; }
// The inputs after the server's, oldest first: how many, and the k-th (as the wire carried it, so the
// re-run steps what the server steps).
net_replay_n :: (s: [] Everglade) -> int #export_c {
  n := net_of(s);
  return clamp_i(n[0].seq - n[0].fix.ack, 0, NET_HIST - 1);
}
net_replay_input :: (s: [] Everglade, k: int) -> EgMoveIn #export_c {
  n := net_of(s);
  q := n[0].fix.ack + 1 + k;
  i := n[0].inputs[q % NET_HIST];
  if i.seq != q { return EgMoveIn.{}; }
  return net_as_sent(i.input);
}
// An input as the wire carries it (whole hundredths), so the page steps what the server steps.
net_as_sent :: (m: EgMoveIn) -> EgMoveIn #export_c {
  return EgMoveIn.{key_x = f32(wire_axis(m.key_x)) / 100, key_y = f32(wire_axis(m.key_y)) / 100, pad_x = f32(wire_axis(m.pad_x)) / 100,
                   pad_y = f32(wire_axis(m.pad_y)) / 100, run = m.run, jump = m.jump, theta = f32(wire_cm(m.theta)) / 100};
}
// The re-run is done: (dx, dy, dz) is where it puts you less where you were drawn. Small, it is eased
// out (you are drawn where you were, coming to where you are); past NET_SNAP m, taken at once.
net_fixed :: (s: [] Everglade, dx: f32, dy: f32, dz: f32) #export_c {
  n := net_of(s);
  n[0].fix_due = false; n[0].replays += 1;
  ox := n[0].off_x - dx; oy := n[0].off_y - dy; oz := n[0].off_z - dz;
  if abs(ox) + abs(oy) + abs(oz) > f32(NET_SNAP) { ox = 0; oy = 0; oz = 0; }
  n[0].off_x = ox; n[0].off_y = oy; n[0].off_z = oz;
}
// Where you are drawn less where you are, this frame (dt s): eased to nothing over NET_SMOOTH s.
net_offset :: (s: [] Everglade, dt: f32) -> Point #export_c {
  if !net_on(s) { return v3(0, 0, 0); }
  n := net_of(s);
  k := clamp01(1 - dt / f32(NET_SMOOTH));
  n[0].off_x *= k; n[0].off_y *= k; n[0].off_z *= k;
  if abs(n[0].off_x) + abs(n[0].off_y) + abs(n[0].off_z) < 0.001 { n[0].off_x = 0; n[0].off_y = 0; n[0].off_z = 0; }
  return v3(n[0].off_x, n[0].off_y, n[0].off_z);
}

// ---- each frame

// The frame, from the face: the clock, the socket, a ping, the hello, the world where it is drawn,
// the casts at their time. (x, fy, z) your feet (fy over the floor you walk on, as the page's feet);
// the rest of your pose is the server's to say.
net_step :: (s: [] Everglade, mono: int, x: f32, fy: f32, z: f32, yaw: f32, vx: f32, vz: f32, air: bool, medium: int, boat: bool, act: int) #export_c {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].mono = mono;
  n[0].feet_y = fy;
  y := fy + walk_at(s, x, z);
  jn_step(s, n);   // no instance yet: the list asked for (everglade-join.coax)
  if n[0].want && (n[0].state == NET_OFF || (n[0].state == NET_DOWN && mono >= n[0].retry)) && jn_ready(n) {
    // each open takes a fresh seat ticket (the room refuses a join without one): asked for, then used
    if n[0].free {
      if pipe_open(n[0].pipe[..], cast(string) n[0].url[0..<n[0].url_n]) { n[0].state = NET_OPENING; n[0].sock = -1; }
    } else if n[0].ticket_n > 0 {
      u: [NET_URL + NET_TICKET + 4] u8;
      k := wire_put(u[..], 0, cast(string) n[0].url[0..<n[0].url_n]); k = wire_put(u[..], k, "?t="); k = wire_put(u[..], k, cast(string) n[0].ticket[0..<n[0].ticket_n]);
      if pipe_open(n[0].pipe[..], cast(string) u[0..<k]) { n[0].state = NET_OPENING; n[0].sock = -1; n[0].ticket_n = 0; }
    } else if !n[0].ticket_asked {
      // the path (?realm=: the directory places you, #12717), then a line, then the body: the name a guest asks for (everglade-join.coax)
      t: [192] u8;
      k := wire_put(t[..], 0, "/api/playtest/room-ticket/"); k = wire_put(t[..], k, cast(string) n[0].code[0..<n[0].code_n]);
      if n[0].realm_n > 0 { k = wire_put(t[..], k, "?realm="); k = wire_put(t[..], k, cast(string) n[0].realm[0..<n[0].realm_n]); }
      k = wire_put(t[..], k, "\n"); k += jn_ticket_body(n, t[k..<t.count]);
      if pipe_put(n[0].pipe[..], NET_PIPE_TICKET, -1, cast(string) t[0..<k]) { n[0].ticket_asked = true; }
    }
  }
  net_save_state(s, n);
  if n[0].said_t > 0 { n[0].said_t -= 0.016; }
  now := net_now(n);
  if net_live(s) {
    if n[0].ping_at == 0 || mono - n[0].ping_at >= (ifx n[0].ping_n < 8 then 1000 else 10000) {
      m := wire_put(n[0].out[..], 0, "t"); m = wire_int(n[0].out[..], m, mono);
      net_send(n, m);
      n[0].ping_at = mono; n[0].ping_n += 1;
    }
    if n[0].hello_due { net_hello(s, n); }
  }
  // the world, a jitter buffer's delay behind the server clock
  rt := now - n[0].delay;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e..<e + 1];
    if !en[0].live || en[0].ring_n == 0 { continue; }
    p := net_state_at(en, rt);
    dx := p.x - en[0].shown.x; dz := p.z - en[0].shown.z;
    en[0].run += sqrt(dx * dx + dz * dz);
    en[0].shown = p;
  }
  if net_live(s) && sp_on(s) { net_follow(s, n, now); }
  // the casts, each at its time
  for q: 0..<NET_FX {
    fx := n[0].fx[q];
    // yours at once; another's when its caster is drawn at that time
    if !fx.live || (ifx fx.caster == n[0].seat then now else rt) < fx.t { continue; }
    n[0].fx[q].live = false;
    if !sp_on(s) { continue; }
    if fx.slot >= SP_SLOTS { net_flash(s, fx.slot - SP_SLOTS, fx.at); n[0].played += 1; continue; }
    from := add(fx.at, v3(0, 2, 0));
    if fx.caster == n[0].seat { from = v3(x, y + 1.6, z); }
    else {
      k := net_ent(n, fx.caster, false);
      if k >= 0 { c := n[0].ents[k].shown; from = v3(c.x, c.y + 1.6, c.z); }
    }
    net_play(s, fx.slot, from, fx.at, fx.seed);
    n[0].played += 1;
  }
}
net_hello :: (s: [] Everglade, n: [] EgNet) {
  n[0].hello_due = false;
  look := ifx n[0].look_n > 0 then cast(string) n[0].look[0..<n[0].look_n] else "ranger.0.0.0";
  net_send(n, wire_put_hello(n[0].out[..], 0, WireHello.{look = look, kind = "druid", flags = (ifx s[0].touch then 1 else 0) | (ifx n[0].account then 2 else 0), name = ""}));
}
// Your intents: a cast from bar slot b at the aim (target an entity, -1 none), the end of what slot b
// holds up, the town rebuilt. False when there is no room to send them to.
net_cast :: (s: [] Everglade, b: int, at: Point, target: int) -> bool #export_c {
  if !net_live(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  // aimed at (or by) a server creature, the cast names it: the server aims it where the creature is
  tgt := ifx target >= 0 then target else net_creature_at(n, at, NET_PICK);
  net_send(n, wire_put_cast(n[0].out[..], 0, WireCast.{seq = n[0].seq, slot = b, ax = at.x, ay = at.y, az = at.z, tgt = tgt}));
  return true;
}
// The TGT code (2000 + EID) of the summoned creature nearest the point within `reach` m, -1 none.
NET_PICK :: 1.6;
net_creature_at :: (n: [] EgNet, at: Point, reach: f32) -> int {
  best := -1; bd := reach * reach;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_BEAST || en.ring_n == 0 || en.hp <= 0 { continue; }
    dx := en.shown.x - at.x; dz := en.shown.z - at.z;
    d := dx * dx + dz * dz;
    if d <= bd { bd = d; best = 2000 + en.eid - NET_MADE_ID; }
  }
  return best;
}
net_end :: (s: [] Everglade, b: int) -> bool {
  if !net_live(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = n[0].seq, kind = WE_END, id = b}));
  return true;
}
net_rebuild :: (s: [] Everglade) -> bool {
  if !net_live(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_rebuild(n[0].out[..], 0, n[0].seq));
  return true;
}
// The ability (AB_*) a kind of entity of yours stands for, -1 none: what slot it holds up.
net_ability_of :: (en: NetEnt) -> int {
  if en.kind == WK_PACK { return AB_CONJURE; }
  if en.kind == WK_STONE { return AB_STONE; }
  if en.kind == WK_TENTACLES { return AB_TENTACLES; }
  if en.kind == WK_THORNS { return AB_THORNS; }
  if en.kind == WK_LINE || en.kind == WK_ZONE { return en.p1; }
  if en.kind == WK_FROG { return AB_POLYMORPH; }
  return -1;
}
// Whether the server holds up something of yours from ability k (its slot shows as on).
net_holds :: (s: [] Everglade, k: int) -> bool {
  if !net_live(s) { return false; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if en.live && en.owner == n[0].seat && net_ability_of(en) == k { return true; }
  }
  return false;
}
// Abilities that change only you yourself (how you move, breathe, what shape you have, what you
// hear): your page runs them, so your movement predicts. Every other one is the server's.
net_self_ability :: (k: int) -> bool {
  return k == AB_LEVITATE || k == AB_FEATHER || k == AB_WWALK || k == AB_BREATH || k == AB_SHAPECHANGE || k == AB_SPEAK;
}
net_shared :: (s: [] Everglade, k: int) -> bool { return net_live(s) && !net_self_ability(k); }
// A press on a shared ability's slot (everglade-abilities.coax ab_press) with a room to send it to:
// what it holds up ends (E); one you point with is picked or put away; any other goes out as a cast
// where you stand, facing as you face.
net_press :: (s: [] Everglade, k: int) {
  b := SP_SLOTS + k;
  if net_holds(s, k) && (s[0].sp.armed == b || !ab_aimed(k)) {
    _ := net_end(s, b);
    s[0].sp.armed = -1;
    return;
  }
  if ab_aimed(k) { s[0].sp.armed = ifx s[0].sp.armed == b then -1 else b; return; }
  s[0].sp.armed = -1;
  _ := net_cast(s, b, add(ab_you(s), times(ab_forward(s), 2)), -1);
}

// ---- the server's spell effects on this page

// What the server's abilities hold up that this page feels and draws as its own would be (everglade-
// room-abilities.coax): Reverse Gravity's cylinder, from its entity. Its saves, lifts and crimes stay
// the server's; your movement predicts its lift (everglade_lift), its debris rises here.
net_follow :: (s: [] Everglade, n: [] EgNet, now: int) {
  on := false; at := v3(0, 0, 0); age := 0.0f32;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.ring_n == 0 || en.kind != WK_ZONE || en.p1 != AB_REVERSE { continue; }
    on = true; at = v3(en.shown.x, en.shown.y, en.shown.z); age = f32(now - en.born) / 1000;
  }
  ab_rg_follow(s, on, at, age);
}
// How high over their feet the server has townsperson i (Reverse Gravity's lift), m.
net_air :: (s: [] Everglade, i: int) -> f32 { return ifx net_town(s) && i >= 0 && i < WATCH_ACTORS then net_of(s)[0].air[i] else 0.0f32; }

// An aimed spell's effect (meteors, a bolt, the orb), played from the server's seed: its look alone
// (everglade-spells.coax sp_blast_look). What it harms and breaks the server says.
net_play :: (s: [] Everglade, slot: int, from: Point, at: Point, seed: int) {
  was_at := s[0].sp.cast_at; was_n := s[0].sp.cast_n; was_from := s[0].sp.cast_from; was_seed := s[0].sp.cast_seed;
  was_dmg := s[0].sp.dmg; was_broke := s[0].sp.broke; was_pushed := s[0].sp.pushed;
  s[0].sp.cast_at = at; s[0].sp.cast_n = v3(0, 1, 0); s[0].sp.cast_from = from; s[0].sp.cast_seed = cast(u64) hi_int(seed, 1);
  s[0].sp.remote = true;
  sp_release(s, slot);
  s[0].sp.remote = false;
  s[0].sp.cast_at = was_at; s[0].sp.cast_n = was_n; s[0].sp.cast_from = was_from; s[0].sp.cast_seed = was_seed;
  s[0].sp.dmg = was_dmg; s[0].sp.broke = was_broke; s[0].sp.pushed = was_pushed;
}
net_tint :: (k: int) -> Point {
  if k == AB_REVERSE || k == AB_TK || k == AB_POLYMORPH || k == AB_SHAPECHANGE { return v3(0.76, 0.62, 1.0); }
  if k == AB_WALLFIRE || k == AB_FIRESTORM || k == AB_FLAME || k == AB_SUNBURST || k == AB_SUNBEAM { return v3(1.0, 0.55, 0.2); }
  if k == AB_KNIFE || k == AB_STORM || k == AB_SLEET || k == AB_RAYFROST || k == AB_CONE || k == AB_FOG { return v3(0.65, 0.85, 1.0); }
  if k == AB_CALL || k == AB_VENGEANCE || k == AB_THUNDER { return v3(0.72, 0.8, 1.0); }
  if k == AB_MOON { return v3(0.85, 0.9, 1.0); }
  if k == AB_HEALING || k == AB_MASSCURE || k == AB_RESURGENCE { return v3(0.55, 1.0, 0.5); }
  if k == AB_CONJURE || k == AB_ENTANGLE || k == AB_SPIKE || k == AB_THORNS { return v3(0.45, 0.95, 0.6); }
  if k == AB_FAERIE { return v3(0.9, 0.5, 1.0); }
  if k == AB_CONTROL || k == AB_CREATE || k == AB_WWALK || k == AB_BREATH { return v3(0.4, 0.7, 1.0); }
  return v3(0.85, 0.85, 0.75);
}
// An ability's effect: a flash of its light at the aim (what it leaves comes as entities).
net_flash :: (s: [] Everglade, k: int, at: Point) {
  if !sp_on(s) || !finite(at.x) || !finite(at.z) { return; }
  c := net_tint(k);
  g := v3(at.x, hi(at.y, ground_at(s, at.x, at.z)) + 0.1, at.z);
  sp_burst(s, add(g, v3(0, 0.5, 0)), v3(0, 1, 0), ifx phone(s) then 14 else 26, 5, 0.9, 0.04, c, times(c, 0.5), -0.6);
  sp_add_shock(s, g, 4.0, 0.6, c);
}

// ---- drawing the server's creatures and zones (everglade-spells.coax spells_frame, after ab_draw)

net_draw :: (s: [] Everglade) {
  if !net_on(s) || !sp_on(s) { return; }
  n := net_of(s);
  now := net_now(n);
  few := phone(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.ring_n == 0 { continue; }
    age := f32(now - en.born) / 1000;
    if en.kind == WK_PACK { net_draw_pack(s, en, age); }
    else if en.kind == WK_STONE { net_draw_stone(s, en, age); }
    else if en.kind == WK_TENTACLES { net_draw_tentacles(s, en, age); }
    else if en.kind == WK_THORNS { net_draw_thorns(s, en, age, few); }
    else if en.kind == WK_ZONE && en.p1 != AB_REVERSE { net_draw_zone(s, en, age); }   // (Reverse Gravity's is ab_draw's: net_follow)
    else if en.kind == WK_LINE { net_draw_line(s, en, age); }
    // a summoned creature is a beast of flesh now (the room's battle has its stat block), not a spirit
    else if en.kind == WK_BEAST { ci_beast(s, clamp_i(en.p1, 1, CI_FORMS - 1), v3(en.shown.x, en.shown.y, en.shown.z), en.shown.yaw, en.run, ifx abs(en.shown.vx) + abs(en.shown.vz) > 0.2 then 1.0f32 else 0.0f32, false, clamp(age / 0.6, 0, 1)); }
  }
}
// Each summoned creature's Hit Points as a bar over it (red on a dark track), once it is near
// enough to see: its share of P2, its most.
NET_BEAST_HEAD :: 1.25;    // m over a wolf's feet
NET_BAR_NEAR :: 40.0;      // m
net_bars :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  n := at;
  if !net_live(s) || !sp_on(s) || s[0].above { return n; }
  nt := net_of(s);
  k := hi(s[0].dpr, 0.5);
  you := ab_you(s);
  for e: 0..<NET_ENTS {
    en := nt[0].ents[e];
    if !en.live || en.kind != WK_BEAST || en.ring_n == 0 || en.p2 <= 0 { continue; }
    p := v3(en.shown.x, en.shown.y + NET_BEAST_HEAD * (ifx en.p1 == CI_FORM_BEAR then 1.35f32 else ifx en.p1 == CI_FORM_MAMMOTH then 2.5f32 else 1.0f32), en.shown.z);
    gap := flat_gap(p, you);
    if gap > f32(NET_BAR_NEAR) { continue; }
    sc := on_screen(u, p, s[0].width, s[0].height);
    if !sc.ok { continue; }
    far := clamp01(1 - gap / f32(NET_BAR_NEAR));
    half := (18 + 14 * far) * k;
    share := clamp01(f32(en.hp) / f32(en.p2));
    if lit(out, n, sc.x - half, sc.y, sc.x + half, sc.y, 2.5 * k, 0.3, 0.4 * k, 0.1, 0.08, 0.07, 0) { n += 6; }
    if share > 0 && lit(out, n, sc.x - half, sc.y, sc.x - half + 2 * half * share, sc.y, 2.5 * k, 0.95, 1.4 * k, WATCH_RED_R, WATCH_RED_G, WATCH_RED_B, 0) { n += 6; }
  }
  return n;
}
// Conjure Animals' pack: four spectral wolves pacing their small rounds about its middle (ci_wolf's).
net_draw_pack :: (s: [] Everglade, en: NetEnt, t: f32) {
  on := clamp(t / 0.8, 0, 1);
  p := en.shown;
  middle := v3(p.x, ground_at(s, p.x, p.z), p.z);
  for q: 0..<CI_WOLVES {
    base := f32(TAU) * f32(q) / f32(CI_WOLVES) + 0.4;
    turn := t * (0.35 + 0.08 * f32(q)) * (ifx q % 2 == 0 then 1.0f32 else -1.0f32);
    r := 0.75 + 0.25 * sin(t * 0.7 + f32(q) * 1.7);
    a := base + turn;
    at := add(middle, v3(cos(a) * r, 0, sin(a) * r));
    at.y = ground_at(s, at.x, at.z);
    side := ifx q % 2 == 0 then 1.0f32 else -1.0f32;
    face := ifx p.f != 0 then p.yaw else atan2(-sin(a) * side, cos(a) * side);
    ci_beast(s, CI_FORM_WOLF, at, face, en.run + t * 0.9 * r + f32(q) * 0.37, 1, true, on);
  }
  if sp_rand(s) < 0.4 {
    a := f32(TAU) * sp_rand(s); r := f32(CI_CA_HALF) * sp_rand(s);
    sp_add_spark(s, add(middle, v3(cos(a) * r, 0.3 + 0.6 * sp_rand(s), sin(a) * r)), v3(0, 0.5, 0), 0.8, 0.02, times(CI_SPIRIT_RGB, 1.2), -0.2);
  }
}
// A Wall of Stone's two panels, rising as ab_draw's.
net_draw_stone :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  half := ifx en.p2 > 0 then f32(en.p2) / 200 else f32(AB_ST_PANEL);
  sx := sin(p.yaw) * half; sz := cos(p.yaw) * half;
  ax := p.x - sx; az := p.z - sz; bx := p.x + sx; bz := p.z + sz;
  base := ground_at(s, p.x, p.z);
  rise := clamp(t / 0.35, 0, 1);
  hh := f32(AB_ST_PANEL) * 0.5;
  ex := (bx - ax) * 0.25; ez := (bz - az) * 0.25;
  l := hi(sqrt(ex * ex + ez * ez), 0.01);
  nn := v3(-ez / l * f32(AB_ST_THICK) * 0.5, 0, ex / l * f32(AB_ST_THICK) * 0.5);
  for q: 0..<2 {
    left := ifx q == 0 then en.hp else en.p1;
    if left <= 0 { continue; }
    c := v3(ax + ex * f32(1 + 2 * q), base + hh * (2 * rise - 1) - 0.02, az + ez * f32(1 + 2 * q));
    tone := (0.46 + 0.05 * f32(q)) * (0.7 + 0.3 * f32(left) / f32(AB_ST_HP));
    sp_shape(s, SHAPE_BOX, LOOK_STONE, c, v3(ex * 1.99, 0, ez * 1.99), v3(0, 2 * hh, 0), times(nn, 2), v3(tone, tone * 0.96, tone * 0.9));
  }
}
// Black Tentacles: nine on a 3 by 3 grid over its square, writhing.
net_draw_tentacles :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  side := ifx en.p2 > 0 then f32(en.p2) / 100 else f32(AB_BT_SIDE);
  grow := clamp(t / 0.6, 0, 1);
  seg := f32(AB_BT_LEN) / f32(AB_BT_SEG) * grow;
  for j: 0..<AB_BT_N {
    gx := f32(j % 3 - 1) * side / 3; gz := f32(j / 3 - 1) * side / 3;
    p0 := v3(p.x + gx, ground_at(s, p.x + gx, p.z + gz), p.z + gz);
    ph := f32(j) * 1.37;
    for q: 0..<AB_BT_SEG {
      u := f32(q) / f32(AB_BT_SEG);
      bend := u * u * 0.9;
      dir := unit_or(v3(sin(t * 1.7 + ph + u * 3) * bend, 1, cos(t * 1.3 + ph * 0.7 + u * 2.5) * bend), v3(0, 1, 0));
      rad := lerp(f32(AB_BT_BASE_R), f32(AB_BT_TIP_R), u) * 2.6;
      sd := unit_or(cross(dir, v3(0, 1, 0.001)), v3(1, 0, 0));
      fwd := cross(sd, dir);
      along := times(dir, seg * 1.6);
      tone := 1.0 + 0.25 * f32(q % 2);
      sp_shape(s, SHAPE_CONE, LOOK_SKIN, add(p0, times(along, 0.5)), times(sd, rad), along, times(fwd, rad), times(AB_BT_RGB, tone));
      p0 = add(p0, times(dir, seg));
    }
  }
  ab_square(s, v3(p.x, ground_at(s, p.x, p.z), p.z), side * 0.5, times(v3(0.62, 0.4, 1.0), 0.35));
}
// A Wall of Thorns: drawn by the page's own (ci_wt_draw), its state for the moment the server's.
net_draw_thorns :: (s: [] Everglade, en: NetEnt, t: f32, few: bool) {
  v := ci_of(s);
  on := v[0].wt_on; a := v[0].wt_a; b := v[0].wt_b; nn := v[0].wt_n; wt := v[0].wt_t;
  p := en.shown;
  half := ifx en.p2 > 0 then f32(en.p2) / 200 else f32(CI_WT_LONG) * 0.5;
  d := v3(sin(p.yaw), 0, cos(p.yaw));
  v[0].wt_a = v3(p.x - d.x * half, 0, p.z - d.z * half); v[0].wt_b = v3(p.x + d.x * half, 0, p.z + d.z * half);
  v[0].wt_a.y = ground_at(s, v[0].wt_a.x, v[0].wt_a.z); v[0].wt_b.y = ground_at(s, v[0].wt_b.x, v[0].wt_b.z);
  v[0].wt_n = v3(-d.z, 0, d.x); v[0].wt_on = true; v[0].wt_t = lo(t, f32(CI_WT_LIFE) - 2);
  ci_wt_draw(s, few);
  v[0].wt_on = on; v[0].wt_a = a; v[0].wt_b = b; v[0].wt_n = nn; v[0].wt_t = wt;
}
// A lingering zone: a ring of its ability's light on the ground, slowly turning, and motes over it.
net_draw_zone :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  c := net_tint(en.p1);
  r := clamp(f32(en.p2) / 100, 0.5, 95);
  on := clamp(t / 0.5, 0, 1);
  segs := clamp_i(cast(int) (r * 3), 16, 48);
  for q: 0..<segs {
    a0 := f32(TAU) * f32(q) / f32(segs) + t * 0.1; a1 := a0 + f32(TAU) / f32(segs);
    x0 := p.x + cos(a0) * r; z0 := p.z + sin(a0) * r; x1 := p.x + cos(a1) * r; z1 := p.z + sin(a1) * r;
    ab_line(s, v3(x0, ground_at(s, x0, z0) + 0.08, z0), v3(x1, ground_at(s, x1, z1) + 0.08, z1), times(c, 0.8 * on));
  }
  if sp_rand(s) < 0.3 {
    a := f32(TAU) * sp_rand(s); d := r * sqrt(sp_rand(s));
    x := p.x + cos(a) * d; z := p.z + sin(a) * d;
    sp_add_spark(s, v3(x, ground_at(s, x, z) + 0.3, z), v3(0, 0.6, 0), 1.0, 0.03, c, -0.3);
  }
}
// A wall of wind or fire: its lines of light, standing.
net_draw_line :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  c := net_tint(en.p1);
  half := f32(en.p2) / 200;
  d := v3(sin(p.yaw), 0, cos(p.yaw));
  on := clamp(t / 0.5, 0, 1);
  segs := clamp_i(cast(int) (half * 2), 4, 24);
  for q: 0..<segs {
    u0 := -1 + 2 * f32(q) / f32(segs); u1 := u0 + 2 / f32(segs);
    x0 := p.x + d.x * half * u0; z0 := p.z + d.z * half * u0; x1 := p.x + d.x * half * u1; z1 := p.z + d.z * half * u1;
    for h: 0..<3 {
      y := 0.1 + f32(h) * 1.4;
      ab_line(s, v3(x0, ground_at(s, x0, z0) + y, z0), v3(x1, ground_at(s, x1, z1) + y, z1), times(c, on * (0.9 - 0.2 * f32(h))));
    }
  }
}

// ---- reading the world, for what draws it (everglade-room.coax, the town) and for checks

// How many live entities of kind (-1 any) there are, the others' players without yours.
net_count :: (s: [] Everglade, kind: int) -> int {
  if !net_on(s) { return 0; }
  n := net_of(s);
  c := 0;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || (kind >= 0 && en.kind != kind) || net_mine_player(n, en) { continue; }
    c += 1;
  }
  return c;
}
net_mine_player :: (n: [] EgNet, en: NetEnt) -> bool { return en.kind == WK_PLAYER && en.owner >= 0 && en.owner == n[0].seat; }
// The k-th live entity of kind (-1 any; your own player left out): its place in the table, -1 none.
net_nth :: (s: [] Everglade, kind: int, k: int) -> int {
  if !net_on(s) { return -1; }
  n := net_of(s);
  c := 0;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || (kind >= 0 && en.kind != kind) || net_mine_player(n, en) { continue; }
    if c == k { return e; }
    c += 1;
  }
  return -1;
}
NetView :: struct {
  ok: bool; eid: int; kind: int; owner: int; seat: int;
  x: f32; y: f32; z: f32; yaw: f32; vx: f32; vz: f32;   // drawn now; y the feet's world height
  flags: int; act: int; form: int; air: bool; swim: bool; boat: bool; alive: bool;
  account: bool; away: bool;       // a player's: signed in (its hello's FLAGS 2), nothing heard from it (WG_AWAY)
  hp: int; max: int; p1: int; p2: int; wanted: int;
  cast_slot: int; cast_age: f32;   // its last spell (a bar slot) and how long ago, s
}
// The k-th live entity of kind (-1 any; WK_PLAYER: the other players), as drawn this frame.
net_view :: (s: [] Everglade, kind: int, k: int) -> NetView {
  e := net_nth(s, kind, k);
  if e < 0 { return NetView.{}; }
  n := net_of(s);
  en := n[0].ents[e]; p := en.shown;
  pl := en.kind == WK_PLAYER;
  return NetView.{ok = true, eid = en.eid, kind = en.kind, owner = en.owner, seat = en.seat,
                  x = p.x, y = p.y, z = p.z, yaw = p.yaw, vx = p.vx, vz = p.vz,
                  flags = p.f, act = p.a, form = en.form,
                  air = pl && (p.f & (WG_GROUND | WG_SWIM | WG_BOAT)) == 0, swim = pl && (p.f & WG_SWIM) != 0, boat = pl && (p.f & WG_BOAT) != 0,
                  alive = !pl || (p.f & WG_DEAD) == 0, account = pl && (en.hello_flags & 2) != 0, away = pl && (p.f & WG_AWAY) != 0,
                  hp = en.hp, max = en.max, p1 = en.p1, p2 = en.p2, wanted = en.wanted,
                  cast_slot = en.cast_slot, cast_age = ifx en.cast_slot >= 0 then f32(net_now(n) - en.cast_at) / 1000 else 100000.0f32};
}
// Its name ("" none yet: a nameless figure), player id, class and look (n).
net_view_name :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].name[0..<net_of(s)[0].ents[e].name_n];
}
net_view_id :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].id[0..<net_of(s)[0].ents[e].id_n];
}
net_view_class :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].cls[0..<net_of(s)[0].ents[e].cls_n];
}
net_view_look :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].look[0..<net_of(s)[0].ents[e].look_n];
}
// You as the server has you: your Hit Points and most (-1 none heard yet).
net_self_hp :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && net_mine_player(n, en) { return en.hp; } }
  return -1;
}
net_self_max :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && net_mine_player(n, en) { return en.max; } }
  return -1;
}
// For a headless check (everglade5e-face.c coaxial_net_probe): 0 the socket's state, 1 your seat, 2 the
// other players, 3 creatures and zones, 4 all entities, 5 the clock's source, 6 frames in, 7 frames
// out, 8 and 9 the first other player's x and z in cm, 10 effects played, 11 the jitter buffer's delay
// ms, 12 your last acked input, 13 hits heard, 14 re-runs from the server's word, 15 inputs sent,
// 16 the server's summoned creatures here, 17 their Hit Points together, 18 hits heard on them, 19
// their deaths heard, 20 the server's y for you (cm), 21 your feet's y as the face gives it, 22 the
// floor's height under you, 23 the town's people heard (f), 24 your WANTED level (w, -1 none), 25 the
// people drawn off their day, 26 breaks heard (e break), 27 fires heard (e burn), 28 the pieces down.
// 200 + SLOT casts bar slot SLOT (net_cast, as a click does) at the nearest
// summoned creature, else 3 m ahead of you: 1 when it went out.
net_probe :: (s: [] Everglade, field: int) -> int #export_c {
  if !net_on(s) { return -1; }
  n := net_of(s);
  if field == 0 { return n[0].state; }
  if field == 1 { return n[0].seat; }
  if field == 2 { return net_count(s, WK_PLAYER); }
  if field == 3 { return net_count(s, -1) - net_count(s, WK_PLAYER) - net_count(s, WK_FOLK); }
  if field == 4 { return net_count(s, -1); }
  if field == 5 { return n[0].synced; }
  if field == 6 { return n[0].frames_in; }
  if field == 7 { return n[0].frames_out; }
  if field == 8 || field == 9 {
    v := net_view(s, WK_PLAYER, 0);
    if !v.ok { return -999999; }
    return wire_cm(ifx field == 8 then v.x else v.z);
  }
  if field == 10 { return n[0].played; }
  if field == 11 { return n[0].delay; }
  if field == 12 { return n[0].acked; }
  if field == 13 { return n[0].hits; }
  if field == 14 { return n[0].replays; }
  if field == 15 { return n[0].seq; }
  if field == 16 || field == 17 {
    c := 0; hp := 0;
    for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && en.kind == WK_BEAST { c += 1; hp += en.hp; } }
    return ifx field == 16 then c else hp;
  }
  if field == 18 { return n[0].creature_hits; }
  if field == 20 { return ifx n[0].fix.ok then wire_cm(n[0].fix.y) else -999999; }
  if field == 21 { return wire_cm(n[0].feet_y); }
  if field == 22 { return wire_cm(walk_at(s, s[0].feet.x, s[0].feet.z)); }
  if field == 23 { return net_count(s, WK_FOLK); }                       // the town's people heard (f)
  if field == 24 { return n[0].wanted; }                                 // your WANTED level (w; -1 none)
  if field == 26 { return n[0].breaks_heard; }
  if field == 27 { return n[0].burns_heard; }
  if field == 28 { k := 0; for i: 0..<sp_dm(s)[0].n { if sp_dm(s)[0].pieces[i].state != DP_STANDING { k += 1; } } return ifx sp_on(s) then k else -1; }
  if field == 25 { k := 0; for i: 0..<WATCH_ACTORS { if s[0].wt[0].actors[i].ready && s[0].wt[0].actors[i].mode != WM_CALM { k += 1; } } return k; }   // off their day as drawn
  if field == 19 { return n[0].creature_deaths; }
  // you as this frame drew you: the controller's act (aethyr/walk.coax Act: 3 airborne) and the clip
  // your body plays (aethyr/skin.coax SKIN_*: 3 the jump), for a check that the jump's pose ends
  if field == 23 { return s[0].act; }
  if field == 24 { return s[0].skin[0].clip; }
  if field >= 200 && field < 200 + SP_SLOTS + AB_N {
    you := ab_you(s);
    at := add(you, times(ab_forward(s), 3));
    bd := 1000000.0f32;
    for e: 0..<NET_ENTS {
      en := n[0].ents[e];
      if !en.live || en.kind != WK_BEAST || en.hp <= 0 { continue; }
      d := flat_gap(v3(en.shown.x, 0, en.shown.z), you);
      if d < bd { bd = d; at = v3(en.shown.x, en.shown.y, en.shown.z); }
    }
    return ifx net_cast(s, field - 200, at, -1) then 1 else 0;
  }
  return -1;
}
// The pipe's commands, for the face to carry out.
net_pipe_n :: (s: [] Everglade) -> int #export_c { if !net_on(s) { return 0; } return net_of(s)[0].pipe[0].n; }
net_pipe_op :: (s: [] Everglade, k: int) -> int #export_c { return net_of(s)[0].pipe[0].op[k]; }
net_pipe_id :: (s: [] Everglade, k: int) -> int #export_c { return net_of(s)[0].pipe[0].id[k]; }
net_pipe_bytes :: (s: [] Everglade, k: int) -> string #export_c { return pipe_bytes(net_of(s)[0].pipe[..], k); }
net_pipe_done :: (s: [] Everglade) #export_c { if net_on(s) { pipe_drained(net_of(s)[0].pipe[..]); } }

// ---- the sky (#12709): the room server owns the time of day and the weather (room-sky.coax). W
// says the server's day (ms into it at its tick) and the weather it runs; the page draws both on the
// server clock, so every page in the room has the same sky whatever its own clock says. Offline, or
// a server that runs no sky (W's WEATHER 0), the page keeps its own (everglade.coax weather_frame).

// In a room whose server runs the sky.
net_sky :: (s: [] Everglade) -> bool { return net_live(s) && net_of(s)[0].worlds > 0 && net_of(s)[0].weather > 0; }
// The server's time of day now, 0 midnight to 1, or -1 none.
net_sky_day :: (s: [] Everglade) -> f32 {
  if !net_sky(s) { return -1; }
  n := net_of(s);
  ms := (n[0].day + net_now(n) - n[0].w_t) % WIRE_DAY_MS;
  if ms < 0 { ms += WIRE_DAY_MS; }
  return f32(ms) / f32(WIRE_DAY_MS);
}
// The server clock in ms for the weather's tick, or -1 none.
net_sky_ms :: (s: [] Everglade) -> f64 {
  if !net_sky(s) { return -1.0; }
  return cast(f64) net_now(net_of(s));
}
// The server's weather over the page's schedule at `tick`: where the server runs another state than the
// schedule has then (or 2 s either side: the turn the server just sent, on a clock a little off), the
// server's state from then on.
net_sky_weather :: (s: [] Everglade, w: [] WeatherSchedule, tick: u64) {
  if !net_sky(s) { return; }
  want := net_of(s)[0].weather - 1;
  if want < WEATHER_CLEAR || want > WEATHER_STORM { return; }
  near := cast(u64) (2 * WEATHER_TICK_HZ);
  if weather_states(w, tick).after == want || weather_states(w, tick + near).after == want { return; }
  if tick > near && weather_states(w, tick - near).after == want { return; }
  weather_pin(w, tick, want);
}

// ---- checks: two pages and a room server of the check's own, written with the wire's writers

NetTestRoom :: struct { buf: [WIRE_SERVER_FRAME] u8; n: int; }
// A page with its socket open (id sock) at monotonic ms mono, in room pair-a as player pid.
net_test_page :: (s: [] Everglade, n: [] EgNet, sock: int, pid: string, mono: int) -> bool {
  everglade_attach_net(s, n);
  facts: [200] u8;
  m := wire_put(facts[..], 0, "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=");
  m = wire_put(facts[..], m, pid);
  m = wire_put(facts[..], m, "\nnow=5000000\nnav=0\n");
  net_facts(s, cast(string) facts[0..<m], "everglade", false);
  n[0].ticket_n = net_copy(n[0].ticket[..], "tk");   // its seat ticket, as the API would answer
  net_step(s, mono, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  opened := n[0].pipe[0].n == 1 && n[0].pipe[0].op[0] == PIPE_OPEN && pipe_bytes(n[0].pipe[..], 0) == "wss://openagents.com/api/room/relay/everglade/pair-a?t=tk";
  pipe_drained(n[0].pipe[..]);
  net_opened(s, sock);
  return opened && net_event(s, SOCKET_KIND + 4 * sock + SOCKET_OPENED, "");
}
// The server's frame to a page.
net_test_hear :: (s: [] Everglade, sock: int, t: string) -> bool { return net_event(s, SOCKET_KIND + 4 * sock + SOCKET_FRAME, t); }
// The last frame a page sent that starts with letter c, "" none; the pipe emptied.
net_test_sent :: (n: [] EgNet, c: u8, out: [] u8) -> string {
  got := 0;
  for k: 0..<n[0].pipe[0].n {
    b := pipe_bytes(n[0].pipe[..], k);
    if n[0].pipe[0].op[k] == PIPE_SEND && b.count > 0 && b[0] == c { got = wire_put(out, 0, b); }
  }
  pipe_drained(n[0].pipe[..]);
  return cast(string) out[0..<got];
}
// The server's world header (W), and its state for a tick (D) with entries, written with the wire's
// own writers, as the room server writes them.
net_test_world :: (r: [] NetTestRoom, tick: int) {
  r[0].n = wire_put_world(r[0].buf[..], 0, WireWorld.{tick = tick, seed = 41, day = 3600000, weather = 0});
}
net_test_tick :: (r: [] NetTestRoom, tick: int, ack: int) {
  r[0].n = wire_put_d(r[0].buf[..], 0, WireD.{tick = tick, ack = ack, f = 0});
}
net_test_sep :: (r: [] NetTestRoom) { if r[0].buf[r[0].n - 1] != ' ' { r[0].n = wire_sep(r[0].buf[..], r[0].n); } }
net_test_p :: (r: [] NetTestRoom, p: WireP) { net_test_sep(r); r[0].n = wire_put_p(r[0].buf[..], r[0].n, p); }
net_test_n :: (r: [] NetTestRoom, w: WireN) { net_test_sep(r); r[0].n = wire_put_n(r[0].buf[..], r[0].n, w); }
net_test_c :: (r: [] NetTestRoom, c: WireC) { net_test_sep(r); r[0].n = wire_put_c(r[0].buf[..], r[0].n, c); }
net_test_x :: (r: [] NetTestRoom, x: WireX) { net_test_sep(r); r[0].n = wire_put_x(r[0].buf[..], r[0].n, x); }
net_test_cast :: (r: [] NetTestRoom, c: WireCastE) { net_test_sep(r); r[0].n = wire_put_cast_e(r[0].buf[..], r[0].n, c); }
net_test_frame :: (r: [] NetTestRoom) -> string { return cast(string) r[0].buf[0..<r[0].n]; }
// Two pages seated in room pair-a at mono 100 (server 5000100), the world's tick 0 then.
net_test_pair :: (a: [] Everglade, na: [] EgNet, b: [] Everglade, nb: [] EgNet, room: [] NetTestRoom) -> bool {
  ok := net_test_page(a, na, 0, "pa", 100) && net_test_page(b, nb, 1, "pb", 100);
  ok = ok && net_test_hear(a, 0, "y 0 1 5000100") && net_test_hear(b, 1, "y 1 2 5000100");
  net_test_world(room, 0);
  return ok && net_test_hear(a, 0, net_test_frame(room)) && net_test_hear(b, 1, net_test_frame(room));
}

#test "net: a page asks the API for a seat ticket before each open and opens with it once; a refusal waits and asks again" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET && jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-a?realm=everglade\n{}");
  pipe_drained(na[0].pipe[..]);
  net_step(a[..], 116, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 0;   // asked once
  net_ticket(a[..], "200\n{\"ticket\":\"v1.p-1.0.-.pair-a.9.ab\",\"id\":\"p-1\"}");
  net_step(a[..], 132, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == PIPE_OPEN && pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/relay/everglade/pair-a?t=v1.p-1.0.-.pair-a.9.ab";
  pipe_drained(na[0].pipe[..]);
  // the socket closes: the next open asks again (a ticket is used once)
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  net_step(a[..], 140000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET;
  pipe_drained(na[0].pipe[..]);
  // refused: no open, and it asks again after the wait
  net_ticket(a[..], "403\n{\"error\":\"unknown player key\"}");
  net_step(a[..], 140016, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 0 && net_probe(a[..], 0) == NET_DOWN;
  net_step(a[..], 300000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET;
}
#test "net: the directory's instance and shard: the socket opens on the shard's path, and the next ticket asks for that instance (#12717)" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-b\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-b?realm=everglade\n");
  pipe_drained(na[0].pipe[..]);
  net_ticket(a[..], "200\n{\"ticket\":\"v3.p-1.0.-.pair-b.2.9.-.ab\",\"id\":\"p-1\",\"room\":\"pair-b\",\"shard\":2}");
  #assert net_room(a[..], "everglade") == "pair-b";
  net_step(a[..], 132, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/s2/relay/everglade/pair-b?t=v3.p-1.0.-.pair-b.2.9.-.ab";
  pipe_drained(na[0].pipe[..]);
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  net_step(a[..], 140000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-b?realm=everglade\n");
  pipe_drained(na[0].pipe[..]);
  // an answer without a placement (an API from before the directory) keeps the path as it was
  net_ticket(a[..], "200\n{\"ticket\":\"v2.x\",\"id\":\"p-1\"}");
  net_step(a[..], 300000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/s2/relay/everglade/pair-b?t=v2.x";
  // a local relay keeps its own address
  b: [1] Everglade; nb: [1] EgNet;
  everglade_attach_net(b[..], nb[..]);
  net_facts(b[..], "url=http://localhost:8787/worlds/everglade?relay=ws://localhost:8830\nplayer=p1\n", "everglade", false);
  was: [NET_URL] u8; wn := nb[0].url_n; for i: 0..<wn { was[i] = nb[0].url[i]; }
  net_placed(nb[..], "everglade-3", 2);
  #assert cast(string) nb[0].url[0..<nb[0].url_n] == cast(string) was[0..<wn] && cast(string) was[0..<20] == "ws://localhost:8830/";
}
#test "net: the ticket's answer brings back your WANTED and look; a changed WANTED is saved while you play" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_ticket(a[..], "200\n{\"ticket\":\"v2.x\",\"id\":\"pa\",\"account\":false,\"name\":\"\",\"expires\":9,\"hp\":4,\"wanted\":3,\"look\":\"ranger.2.1.0\",\"class\":\"druid\"}");
  #assert a[0].wv.want == 3 && cast(string) na[0].look[0..<na[0].look_n] == "ranger.2.1.0";
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_OPENED, "") && net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  // the same as saved: nothing goes; a new level does, once
  watch_you(a[0].wt[..])[0].wanted = true; watch_you(a[0].wt[..])[0].level = 3;
  net_step(a[..], 3000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != NET_PIPE_STATE; }
  pipe_drained(na[0].pipe[..]);
  watch_you(a[0].wt[..])[0].level = 4;
  net_step(a[..], 6000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  got := "";
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == NET_PIPE_STATE { got = pipe_bytes(na[0].pipe[..], k); } }
  #assert got == "{\"wanted\":4,\"look\":\"ranger.2.1.0\",\"class\":\"druid\"}";
  pipe_drained(na[0].pipe[..]);
  net_step(a[..], 9000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != NET_PIPE_STATE; }
}
#test "net: the server's e edit asks the face for the world again, and the board too, once" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  #assert !net_edit_take(a[..]);
  a[0].ev.ed[0].spec_due = false;
  w: [1] NetTestRoom;
  net_test_world(w[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  net_test_tick(w[..], 1, 0); net_test_sep(w[..]); w[0].n = wire_put_edit(w[0].buf[..], w[0].n, 107);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  #assert net_edit_take(a[..]) && !net_edit_take(a[..]) && a[0].ev.ed[0].spec_due;
}
#test "net: two pages in one room see each other move, as the server says, a jitter buffer behind it" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_page(b[..], nb[..], 1, "pb", 100);
  #assert net_probe(a[..], 0) == NET_OPEN && !net_live(a[..]);
  // the relay seats them: A seat 0, B seat 1, the server clock 5000100 at mono 100; the server's world
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_test_hear(b[..], 1, "y 1 2 5000100");
  #assert net_live(a[..]) && net_live(b[..]) && net_clock(a[..]) == 5000100 && net_probe(a[..], 5) == 1;
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  // A's hello goes out on its next frame: its look and class
  out: [WIRE_FRAME] u8;
  na[0].look_n = net_copy(na[0].look[..], "ranger.2.1.0");
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  h := net_test_sent(na[..], 'H', out[..]);
  r: [1] WireRd; r[0] = wire_rd(h, 1);
  hw := wire_read_hello(h, r[..]);
  #assert r[0].ok && hw.look == "ranger.2.1.0" && hw.kind == "druid";
  // the server's ticks at 30 Hz: A (seat 0) going +x 0.5 m a tick, B (seat 1) standing
  for q: 1..<4 {
    net_test_tick(room[..], q, 0);
    net_test_p(room[..], WireP.{ss = 0, x = 10 + 0.5 * f32(q), z = 5, yaw = 0.5, vx = 15, g = WG_GROUND, hp = 57, max = 57});
    net_test_p(room[..], WireP.{ss = 1, x = -3, z = 2, g = WG_GROUND | WG_AWAY, hp = 50, max = 57});
    if q == 1 { net_test_n(room[..], WireN.{ss = 0, id = "pa", look = "ranger.2.1.0", kind = "druid", flags = 2, name = "Ash Fen"}); }
    // each page steps to the tick's time and hears it then
    net_step(b[..], 100 + 33 * q, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
    net_step(a[..], 100 + 33 * q, 10, 0, 5, 0, 0, 0, false, 0, false, 0);
    #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  // each sees the other alone among the players (not itself), by its seat, name and class
  #assert net_count(a[..], WK_PLAYER) == 1 && net_count(b[..], WK_PLAYER) == 1;
  ob := net_view(b[..], WK_PLAYER, 0);
  #assert ob.ok && ob.eid == 0 && ob.seat == 0 && ob.owner == 0 && ob.hp == 57 && ob.alive && !ob.air && ob.account && !ob.away;
  #assert net_view_name(b[..], WK_PLAYER, 0) == "Ash Fen" && net_view_look(b[..], WK_PLAYER, 0) == "ranger.2.1.0" && net_view_class(b[..], WK_PLAYER, 0) == "druid";
  oa := net_view(a[..], WK_PLAYER, 0);
  #assert oa.eid == 1 && oa.hp == 50 && oa.away && !oa.account;
  // the ticks came on time: the delay is the floor's, and B draws A that far behind the server clock,
  // between its ticks (half way at a half tick)
  d := net_probe(b[..], 11);
  #assert d >= NET_LOW && d <= 140;
  net_step(b[..], 100 + 33 * 2 + 16 + d, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
  ob = net_view(b[..], WK_PLAYER, 0);
  #assert abs(ob.x - 11.24) < 0.05 && abs(ob.z - 5) < 0.01;
  // past its newest tick it goes on by its velocity NET_AHEAD ms at most, then holds
  net_step(b[..], 100 + 99 + d + 1000, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
  ob = net_view(b[..], WK_PLAYER, 0);
  #assert abs(ob.x - (11.5 + 15 * f32(NET_AHEAD) / 1000)) < 0.05;
  // late ticks widen the buffer
  for q: 4..<24 {
    net_test_tick(room[..], q, 0);
    net_test_p(room[..], WireP.{ss = 0, x = 12, z = 5, g = WG_GROUND});
    net_step(b[..], 100 + 33 * q + (ifx q % 2 == 0 then 0 else 90), -3, 0, 2, 0, 0, 0, false, 0, false, 0);
    #assert net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  #assert net_probe(b[..], 11) > d;
  // gone from B's view when the server says
  net_test_tick(room[..], 25, 0); net_test_x(room[..], WireX.{k = 'p', id = 0});
  #assert net_test_hear(b[..], 1, net_test_frame(room[..])) && net_count(b[..], WK_PLAYER) == 0;
}
#test "net: every step's input goes out; the server's word on you starts the re-run from there, eased in; past NET_SNAP at once" {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 2, "pa", 100) && net_test_hear(a[..], 2, "y 3 1 5000100");
  out: [WIRE_FRAME] u8;
  r: [1] WireRd;
  // three steps' inputs, idle ones too, numbered
  s1 := net_input(a[..], EgMoveIn.{key_y = 1, theta = 0.25, run = true}, false);
  t := net_test_sent(na[..], 'I', out[..]); r[0] = wire_rd(t, 1); i1 := wire_read_in(t, r[..]);
  #assert r[0].ok && i1.seq == s1 && s1 >= 1 && i1.ky == 100 && i1.kx == 0 && abs(i1.theta - 0.25) < 0.01 && i1.b == WB_RUN;
  s2 := net_input(a[..], EgMoveIn.{key_y = 0.5, theta = 0.25}, false);
  s3 := net_input(a[..], EgMoveIn.{}, false);
  t = net_test_sent(na[..], 'I', out[..]); r[0] = wire_rd(t, 1);
  #assert s2 == s1 + 1 && s3 == s2 + 1 && wire_read_in(t, r[..]).seq == s3 && r[0].ok;
  #assert !net_fix_due(a[..]);
  // the server has stepped the first: where it has you, the two later inputs to re-run, as it got them
  net_test_tick(room[..], 5, s1);
  net_test_p(room[..], WireP.{ss = 3, x = 9.8, y = 0, z = 5, vx = 3, g = WG_GROUND, hp = 40, max = 57, carry = 0.0042});
  #assert net_test_hear(a[..], 2, net_test_frame(room[..])) && net_fix_due(a[..]) && net_probe(a[..], 12) == s1;
  f := net_fix(a[..]);
  #assert f.ack == s1 && abs(f.x - 9.8) < 0.001 && f.ground && abs(f.carry - 0.0042) < 0.0001;
  #assert net_replay_n(a[..]) == 2 && abs(net_replay_input(a[..], 0).key_y - 0.5) < 0.001 && net_replay_input(a[..], 1).key_y == 0;
  #assert abs(net_replay_input(a[..], 0).theta - 0.25) < 0.01;
  #assert net_self_hp(a[..]) == 40 && net_self_max(a[..]) == 57 && net_count(a[..], WK_PLAYER) == 0;
  // the re-run put you 0.2 m back of where you were drawn: drawn where you were, eased to where you are
  net_fixed(a[..], -0.2, 0, 0);
  #assert !net_fix_due(a[..]);
  o := net_offset(a[..], 0.016);
  #assert o.x > 0 && o.x < 0.2 && abs(o.z) < 0.001;
  for q: 0..<60 { o = net_offset(a[..], 0.016); }
  #assert abs(o.x) < 0.001;
  // an old word is no news
  net_test_tick(room[..], 6, s1);
  net_test_p(room[..], WireP.{ss = 3, x = 0, z = 0});
  #assert net_test_hear(a[..], 2, net_test_frame(room[..])) && !net_fix_due(a[..]);
  // far off (a wall the server knows of): at once
  net_test_tick(room[..], 7, s3);
  net_test_p(room[..], WireP.{ss = 3, x = 20, z = 5, g = WG_GROUND});
  #assert net_test_hear(a[..], 2, net_test_frame(room[..])) && net_fix_due(a[..]) && net_replay_n(a[..]) == 0;
  net_fixed(a[..], 10, 0, 0);
  #assert abs(net_offset(a[..], 0.016).x) < 0.001;
}
#test "net: the server's states two at once, late: another player walking is drawn moving every frame (no stall)" {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  // seat 1 walks +z 4 m/s; the server sends every second tick (15 Hz), and two of those come together
  // every 133 ms, 40 ms on their way (production's 15 Hz in pairs)
  heard := 0; least := 1000.0f32; most := 0.0f32; was := -1000.0f32;
  for ms: 0..<3000 {
    mono := 100 + ms;
    // the frames due by now: tick q (server time 5000100 + q * 33.3) comes at its time + 40 ms, a pair at the later's
    while true {
      q := 2 * (heard + 1);
      pair := 2 * ((heard + 2) / 2);   // the pair's later frame
      due := 100 + cast(int) (f32(2 * pair) * 33.33) + 40;
      if mono < due { break; }
      net_test_tick(room[..], q, 0);
      net_test_p(room[..], WireP.{ss = 1, x = 0, z = f32(q) * 4.0 / 30.0, vz = 4, g = WG_GROUND, hp = 57, max = 57});
      #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
      heard += 1;
    }
    if ms % 16 != 0 { continue; }
    net_step(a[..], mono, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    v := net_view(a[..], WK_PLAYER, 0);
    if !v.ok || ms < 1000 { if v.ok { was = v.z; } continue; }
    gap := v.z - was; was = v.z;
    least = lo(least, gap); most = hi(most, gap);
  }
  // 16 ms frames at 4 m/s: 6.4 cm each; never standing, never leaping
  #assert least > 0.04 && most < 0.09;
  #assert net_probe(a[..], 11) <= NET_HIGH;
}
#test "net: what a player casts is the server's entity, alike on both pages, gone when it says" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // A casts Conjure Animals at a point: an intent, nothing made on A's page
  out: [WIRE_FRAME] u8;
  #assert net_cast(a[..], SP_SLOTS + AB_CONJURE, v3(4, 0, 7), -1) && net_count(a[..], -1) == 0;
  t := net_test_sent(na[..], 'C', out[..]);
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := wire_read_cast(t, r[..]);
  #assert r[0].ok && c.slot == SP_SLOTS + AB_CONJURE && abs(c.ax - 4) < 0.01 && abs(c.az - 7) < 0.01 && c.tgt == -1;
  // the server makes the pack (eid 40, A's) and both pages have it, A's slot on, B's not
  net_test_tick(room[..], 1, 0);
  net_test_c(room[..], WireC.{eid = 40, kind = WK_PACK, owner = 0, x = 4, z = 7});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  #assert net_probe(a[..], 3) == 1 && net_probe(b[..], 3) == 1;
  #assert net_holds(a[..], AB_CONJURE) && !net_holds(b[..], AB_CONJURE);
  // it moves where the server moves it, on both
  for q: 2..<5 {
    net_test_tick(room[..], q, 0);
    net_test_c(room[..], WireC.{eid = 40, kind = WK_PACK, owner = 0, x = 4 + f32(q), z = 7});
    #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  net_step(a[..], 100 + 132 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 100 + 132 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pa := net_view(a[..], WK_PACK, 0); pb := net_view(b[..], WK_PACK, 0);
  #assert pa.ok && pb.ok && abs(pa.x - pb.x) < 0.001 && abs(pa.x - 8) < 0.01;
  // A presses its slot again: the end goes out (E SEQ 5 SLOT) and the server takes the pack away
  #assert net_end(a[..], SP_SLOTS + AB_CONJURE);
  t = net_test_sent(na[..], 'E', out[..]);
  r[0] = wire_rd(t, 1); u := wire_read_use(t, r[..]);
  #assert r[0].ok && u.kind == WE_END && u.id == SP_SLOTS + AB_CONJURE;
  net_test_tick(room[..], 6, 0); net_test_x(room[..], WireX.{k = 'c', id = 40});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  #assert net_count(a[..], -1) == 0 && net_count(b[..], -1) == 0 && !net_holds(a[..], AB_CONJURE);
  // a refusal says why
  #assert net_test_hear(a[..], 0, "r 9 range") && cast(string) na[0].said[0..<na[0].said_n] == "CAN'T · RANGE";
}
#test "net: a cast aimed at the server's wolf names it (TGT 2000 + EID); one aimed away names none" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // A's wolf (eid 7, 11 Hit Points of 11) at (4, 7), on B's page too
  net_test_tick(room[..], 1, 0);
  net_test_c(room[..], WireC.{eid = 7, kind = WK_BEAST, owner = 0, x = 4, z = 7, hp = 11, p1 = CI_FORM_WOLF, p2 = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  out: [WIRE_FRAME] u8;
  // B aims Starry Wisp a metre off it: the cast names wolf 7
  #assert net_cast(b[..], 22, v3(4.8, 0, 7.5), -1);
  t := net_test_sent(nb[..], 'C', out[..]);
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := wire_read_cast(t, r[..]);
  #assert r[0].ok && c.slot == 22 && c.tgt == 2007;
  // aimed 5 m off, it names none
  #assert net_cast(b[..], 22, v3(9, 0, 7), -1);
  t = net_test_sent(nb[..], 'C', out[..]);
  r[0] = wire_rd(t, 1); c = wire_read_cast(t, r[..]);
  #assert r[0].ok && c.tgt == -1;
  // the server says it took 6: both pages have 5 left
  net_test_tick(room[..], 2, 0);
  net_test_c(room[..], WireC.{eid = 7, kind = WK_BEAST, owner = 0, x = 4, z = 7, hp = 5, p1 = CI_FORM_WOLF, p2 = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  ka := net_ent(na[..], NET_MADE_ID + 7, false); kb := net_ent(nb[..], NET_MADE_ID + 7, false);
  #assert ka >= 0 && kb >= 0 && na[0].ents[ka].hp == 5 && nb[0].ents[kb].hp == 5 && nb[0].ents[kb].p2 == 11;
}
#test "net: the page's facts name the socket: ?room=, ?relay= on this machine, and none for a golden page" {
  s: [1] Everglade; n: [1] EgNet;
  everglade_attach_net(s[..], n[..]);
  net_facts(s[..], "url=http://localhost:8787/worlds/everglade?relay=ws://localhost:8830&room=pair-x\nplayer=p1\n", "everglade", false);
  #assert cast(string) n[0].url[0..<n[0].url_n] == "ws://localhost:8830/api/room/relay/everglade/pair-x" && n[0].want;
  #assert net_room(s[..], "everglade") == "pair-x";
  // a bad name: the realm's instance list is asked which (everglade-join.coax)
  net_facts(s[..], "url=https://openagents.com/worlds/made-moss?room=Bad!\n", "made-moss", false);
  #assert cast(string) n[0].url[0..<n[0].url_n] == "wss://openagents.com/api/room/relay/everglade/" && n[0].want && n[0].join[0].list_due;
  net_facts(s[..], "url=https://openagents.com/worlds/everglade\n", "everglade", true);
  #assert !n[0].want;
  // a page with no socket attached is no room's
  t: [1] Everglade;
  #assert !net_live(t[..]) && net_room(t[..], "everglade") == "everglade" && net_probe(t[..], 0) == -1;
}
#test "net: a meteor swarm the server says falls on the same spots on both pages" #steps 1100000000 {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  dma: [1] DemoWorld; dmb: [1] DemoWorld;
  everglade_start(a[..]); a[0].sp.on = true; a[0].sp.ready = true; a[0].sp.dm = dma[..];
  everglade_start(b[..]); b[0].sp.on = true; b[0].sp.ready = true; b[0].sp.dm = dmb[..];
  room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // B casts; the server takes it at tick 6 (server 5000300) and tells both
  net_test_tick(room[..], 6, 0);
  net_test_cast(room[..], WireCastE.{ss = 1, slot = SP_METEOR, ax = 20, ay = 0, az = -15, seed = 77123});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  // not yet on A: it falls when B is drawn casting it, a jitter buffer behind
  net_step(a[..], 200, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert net_probe(a[..], 10) == 0;
  net_step(a[..], 300 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 300 + NET_HIGH, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  // B's cast bar (2.5 s) still fills: the meteors fall once it is done, on both pages (#12733)
  #assert net_probe(a[..], 10) == 0 && net_probe(b[..], 10) == 0;
  net_step(a[..], 300 + NET_HIGH + 2500, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 300 + NET_HIGH + 2500, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  #assert net_probe(a[..], 10) == 1 && net_probe(b[..], 10) == 1;
  live := 0;
  for q: 0..<SP_METEORS {
    ma := a[0].sp.meteors[SP_METEORS + q]; mb := b[0].sp.meteors[SP_METEORS + q];
    #assert ma.live && mb.live && ma.remote && abs(ma.to.x - mb.to.x) < 0.001 && abs(ma.to.z - mb.to.z) < 0.001;
    if ma.live { live += 1; }
    #assert !a[0].sp.meteors[q].live;   // nothing of this page's own
  }
  #assert live == SP_METEORS;
}
#test "net: the time of day and the weather are the server's: two pages 4 s apart on their own clocks draw the same sky" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  everglade_attach_net(a[..], na[..]); everglade_attach_net(b[..], nb[..]);
  // A's wall clock says 5000 s, B's 5004 s
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_facts(b[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pb\nnow=5004000\nnav=0\n", "everglade", false);
  #assert net_sky_day(a[..]) < 0 && net_sky_ms(a[..]) < 0;   // no room: each page's own
  for p: 0..<2 {
    pg := ifx p == 0 then a[..] else b[..];
    net_step(pg, 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    pipe_drained(net_of(pg)[0].pipe[..]);
    net_opened(pg, p);
    #assert net_event(pg, SOCKET_KIND + 4 * p + SOCKET_OPENED, "");
  }
  // the server's clock is 7000 s: its day 7000 s in, its weather rain
  #assert net_test_hear(a[..], 0, "y 0 1 7000100") && net_test_hear(b[..], 1, "y 1 2 7000100");
  buf: [128] u8;
  m := wire_put_world(buf[..], 0, WireWorld.{tick = 0, seed = 41, day = 7000100 % WIRE_DAY_MS, weather = WEATHER_RAIN + 1});
  #assert net_test_hear(a[..], 0, cast(string) buf[0..<m]) && net_test_hear(b[..], 1, cast(string) buf[0..<m]);
  // a minute on: the same time of day and the same weather tick on both
  net_step(a[..], 60100, 0, 0, 0, 0, 0, 0, false, 0, false, 0); net_step(b[..], 60100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  want := f32((7000100 + 60000) % WIRE_DAY_MS) / f32(WIRE_DAY_MS);
  #assert abs(net_sky_day(a[..]) - want) < 0.00001 && net_sky_day(a[..]) == net_sky_day(b[..]);
  #assert net_sky_ms(a[..]) == 7060100.0 && net_sky_ms(b[..]) == 7060100.0;
  // the server's rain over the page's schedule: pinned where it differs, left where it agrees
  ws: [1] WeatherSchedule;
  weather_schedule(ws[..], weather_temperate(), WIRE_WEATHER_SEED);
  tick := weather_tick_at(7060100);
  net_sky_weather(a[..], ws[..], tick);
  #assert weather_states(ws[..], tick + cast(u64) (90 * WEATHER_TICK_HZ)).after == WEATHER_RAIN;
  pins := ws[0].pin_n;
  net_sky_weather(a[..], ws[..], tick + 100);
  #assert ws[0].pin_n == pins;
  // closed: the page's own sky again
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") && net_sky_day(a[..]) < 0 && net_sky_ms(a[..]) < 0;
  // and the wire's day is the page's 48-minute day, its seed the page's weather's
  #assert WIRE_DAY_MS == cast(int) (STYLE_CYCLE_SECONDS * 1000) && WIRE_WEATHER_SEED == EG_WEATHER_SEED;
}
