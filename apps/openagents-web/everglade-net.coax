#load "everglade-link-wire.coax";
// Everglade's network client (docs/verse/2026-11-03-everglade-multiplayer-spec.md sections 3.6 to
// 3.10 and 6; GitHub #12706 and #12708), loaded by everglade.coax. The room server owns the shared
// world (owner, 2026-11-03): every player, creature, zone, spell's cast, hit and break is the
// server's, and this page draws them. It sends intents: its input every step (I), its casts (C), its
// interactions (E), a rebuild (R). It predicts only its own movement, with the same Coax step the
// server runs on the same input (everglade-move.coax, everglade-step.coax), and when the server's
// state for its seat comes (its row in D, and D's ACK) it starts again from there and re-runs the
// inputs the server hasn't stepped yet (the face runs the step: net_fix_*, net_replay_*). The frames
// are everglade-wire.coax's (version 3), the contract the server #loads too: every entity is a row
// (s), a delta against one this page said it heard (each I's HEARD), read through the wire's mirror.
//
// The face (everglade5e-face.c) opens one WebSocket,
//   wss://HOST/api/room/relay/everglade/CODE      (?relay=ws://localhost:PORT a room server on this
//                                                 machine, ?relay=wss://openagents.com production's from a
//                                                 page on this machine; ?room=pair-x a room of a test's own)
// carries this file's frames out through its Pipe (socket.coax) and hands it every event (net_event).
// What it keeps:
//   - the server clock: your monotonic ms plus an offset, first the page's wall clock, then the y
//     frame's T, then the lowest round trip of the last NET_PINGS pings; a tick's time from W;
//   - every remote entity's (players, townsfolk, creatures, zones) last NET_RING states from the
//     server's ticks (D), drawn from one buffer a delay behind the server clock: the states' lateness,
//     one interval and twice their arrival jitter, NET_LOW (100 ms) to NET_HIGH ms, the drawn
//     delay coming to it at NET_SLEW; between the two states round that time (yaw the short way),
//     past the newest by its velocity for NET_AHEAD ms at most (a townsperson NET_AHEAD_FOLK: on
//     their way through a lost read's resend), then held; where the states after that put it
//     differs from where it went on to by a little, eased out over NET_EASE s. A row the server
//     didn't send was the same as the last (it sends what changed), so the entity stood there until
//     the tick before its next;
//   - your inputs, NET_HIST of them, until the server has stepped them; where the re-run puts you
//     differs from where you were drawn by a little: that is eased out over NET_SMOOTH s (past
//     NET_SNAP m at once);
//   - casts the server took (e cast): played from its seed, so they fall where they fall for everyone,
//     harming nothing here; hits (e hit) pop their numbers; a break (e break) breaks the piece here,
//     the rebuild (e rebuild) stands the town up; what the server refuses (r) says why under the bar.
// Creatures and zones (Conjure Animals' pack, Wall of Stone, Black Tentacles, Wall of Thorns, the
// lingering zones and walls) are drawn here (net_draw); the other players and the townsfolk are read
// through net_view by what draws them (everglade-rangers.coax).
//   coax/bin/coax test apps/openagents-web/everglade5e.coax --only "net:"

#load "socket.coax";
#load "everglade-wire.coax";
#load "everglade-net-core.coax";   // the states' ring, the jitter buffer, the clock: Everglade II's page keeps them too (#13054)
#load "../../aethyr/session/lifecycle.coax";   // focus, hiding and the socket, as every host does them (#12856)
#load "everglade-join.coax";   // which instance, who you are in it, INVITE (#12716)
#load "everglade-moderate.coax";   // BLOCK, REPORT and KICK from a nameplate (#12714)
#load "../../aethyr/session/party.coax";   // a party's rules, as the API and the room keep them (#12845)
#load "everglade-party.coax";      // PARTY: your party's roster, its link, joining by one (#12852)
#load "everglade-events.coax";     // the raid's banner, your level and kit, the admin's EVENTS (#12737)

NET_ENTS :: WIRE_MIRROR;
NET_FX :: 8;               // casts waiting for their time
NET_MINE :: 8;             // your casts sent, kept to read a refusal of them by (r SEQ WHY)
NET_PIPE_STATE :: 5;    // the pipe's save of what you bring back into a room: its bytes the JSON to POST to /api/playtest/room-state (#12715)
NET_STATE_EVERY :: 2000;   // ms: a changed look is saved at most this often (WANTED is the room's to save, #12794)
NET_PIPE_TICKET :: 4;   // the pipe's ask for a seat ticket: its bytes the API path to POST, a newline, the body (the face carries it)
NET_RELOAD_MS :: 1500;      // ms a new version's message shows before the page reloads
NET_ACT_NAVIGATE :: 1;      // host.js: go to the outbox's path
NET_SAY :: 4.0;            // s a refusal shows
NET_GAME :: "everglade";
NET_OFF :: 0; NET_OPENING :: 1; NET_OPEN :: 2; NET_DOWN :: 3;
// what an entity is: a player (WK_PLAYER), a townsperson or guard (WK_FOLK), else a creature or zone
// (everglade-wire.coax WK_*); a townsperson's and a creature's ids in the table
NET_FOLK_ID :: WIRE_ID_FOLK; NET_MADE_ID :: WIRE_ID_MADE;
// a target or hit's WHO code (the wire's TGT): 0-999 a watch actor, 1000 + SS a seat, 2000 + EID a creature
net_who :: (who: int) -> int { return ifx who >= 2000 then NET_MADE_ID + who - 2000 else ifx who >= 1000 then who - 1000 else NET_FOLK_ID + who; }

// Where a socket goes: the address and instance, and how they were chosen (EgNet's own and its away).
NetDest :: struct { url: [NET_URL] u8; url_n: int; host_n: int; code: [NET_CODE] u8; code_n: int; base_n: int; named: bool; test: bool; list_due: bool; local_relay: bool; }
NetFx :: struct { live: bool; slot: int; caster: int; at: Point; seed: int; t: int; mode: int; }
EgNet :: struct {
  party_only:[16]bool;party_hp:[16]int;party_max:[16]int;party_seen:[16]int;
  want: bool;
  state: int; sock: int = -1; tries: int; retry: int;
  url: [NET_URL] u8; url_n: int;
  code: [NET_CODE] u8; code_n: int;
  // the realm the room is an instance of (the ticket asks the API's directory, #12717, for the
  // instance and its oa-room shard), and how much of url is the host (wss://HOST)
  realm: [NET_CODE] u8; realm_n: int; host_n: int;
  // the seat ticket the socket opens with (?t=, #12712): asked of the API before each open, used once;
  // local_relay: a room server on this machine (?relay=ws://localhost:PORT, coax/web/room/local.coax),
  // which keeps its own address; its tickets come from the API's local stand-in, as production's do
  ticket: [NET_TICKET] u8; ticket_n: int; ticket_asked: bool; local_relay: bool;
  // local_host: offline play's room, the room server's own simulation in this browser (?offline=worker:
  // coax/web/room-worker.js runs coax/web/room/room-worker.c, #12784). The socket is local:PATH, a
  // loopback to it that speaks the same frames; it seats without a ticket and has no list or shard
  local_host: bool;
  // local_ok: this page plays on the local host from its first frame while Everglade's rooms are asked
  // for a seat, and goes to the room when one comes (#12882): not a golden page, not
  // a test's room or a local room server's, only Everglade. away: the room's address meanwhile (the local
  // host's while you sit in the room); asking: the room is being asked (ask_at the next try, ask_tries
  // in a row refused); room_sock: the room's socket, opening beside the local host's until its seat
  // (room_wait: its open asked of the host; room_at: when)
  local_ok: bool; away: [1] NetDest; asking: bool; ask_at: int; ask_tries: int;
  room_sock: int = -1; room_wait: bool; room_at: int;
  // what you bring back into a room (#12715): the look last saved, and when
  saved_look: [NET_LOOK] u8; saved_look_n: int; saved_at: int; restored: bool;
  edit_due: bool;            // the server said "e edit": the world and the board are asked for again (#12714)
  pid: [NET_ID] u8; pid_n: int; account: bool;
  look: [NET_LOOK] u8; look_n: int;
  mono: int;                 // this frame's monotonic ms
  offset: int;               // server ms = mono + offset
  synced: int;               // 0 the wall clock, 1 the y frame's T, 2 a ping's
  ping_rtt: [NET_PINGS] int; ping_off: [NET_PINGS] int; pings: int; ping_at: int; ping_n: int;
  seat: int = -1;
  ents: [NET_ENTS] NetEnt;
  // the world's clock (W): tick `w_tick` was server time `w_t`, `hz` ticks a second
  hz: int = WIRE_HZ; w_tick: int; w_t: int; seed: int; day: int; weather: int; worlds: int;
  tick: int; tick_t: int;    // the last state's tick and its server time
  late_mean: f32; jitter: f32; interval: f32 = 33; delay: int = NET_LOW; ticks: int;
  // the delay the world is drawn at, which comes to `delay` at NET_SLEW (the drawn time runs a little
  // slow or fast, never back), and the server time drawn this frame
  lag: f32 = NET_LOW; rt: int;
  mir: [1] WireMirror;       // the server's rows as it sent them, what each delta is read against (everglade-wire.coax)
  budget: int = WIRE_BUDGET; // the bytes of rows a tick the server sends this page at most (W)
  rate_t: int; rate_b: int; rate: int;   // the bytes a second heard, over the last second (vitals)
  // your inputs, and the server's word on you
  seq: int; inputs: [NET_HIST] NetInput; acked: int;
  fix: NetFix; fix_due: bool;
  stepping: int;             // the input the face is stepping now (net_input, net_replay_input)
  // your Reverse Gravity, predicted (net_own_rg): the cast's sequence number and its end's (0 none),
  // and where it stands; the room steps the inputs after the cast in it and those after the end out
  // of it (room-everglade.coax eg_waits), so the page steps each input as the server will
  rg_open: int; rg_close: int; rg_at: Point; rg_heard: bool;
  // your own lasting abilities, shown at the press (net_own_show): each one's cast's sequence number
  // until the room's entity for it comes (0 none), the entity up at the press (a new one is this
  // cast's), and one you ended before its entity came (its entity is not raised again here)
  own_pend: [AB_N] int; own_was: [AB_N] int; own_gone: [AB_N] bool;
  off_x: f32; off_y: f32; off_z: f32;   // where you are drawn less where you are, eased out
  wanted: int = -1;          // your WANTED level (w; -1 none heard: the server runs no town)
  breaks_heard: int; burns_heard: int;   // the town's pieces the server broke and lit (e break, e burn)
  mends_heard: int;                      // and stood up (e mend: everglade-repair.coax)
  // the town's outcomes heard (WIRE_OUTCOMES), against the room's count of them (o N, #12902); and the
  // check of the town the room sends from the first piece: begun at a snapshot or an O, each piece,
  // fire and placed thing it names marked, ended by e town (net_town_end); towns_asked: Os sent
  out_got: int #counter; was_snap: bool; town_check: bool; towns_asked: int; towns_fixed: int;
  town_seen: [DEMO_PIECES] bool; burn_seen: [DEMO_PIECES] bool; placed_seen: [CR_PLACED_MAX] bool;
  fx: [NET_FX] NetFx;
  mine_seq: [NET_MINE] int; mine_slot: [NET_MINE] int; mine_at: int;   // your last casts: each SEQ and slot
  said: [48] u8; said_n: int; said_t: f32;   // the last refusal's reason, or what became of the room
  stale: bool; reload_at: int;   // the room speaks a newer wire (r 0 version): no more opens; reloaded once at reload_at
  elsewhere: bool;               // a newer seat ticket has your character (r 0 elsewhere, #12834): no more opens
  lost: bool;                // the room's socket closed under you: said again when you're back
  sat: bool;                 // you sat in a room this load: the page plays in rooms from then (net_live)
  quiet_frames: int; quiet_since: int; quiet_fresh: bool = true; stepped_at: int;   // the quiet socket's watch (NET_SILENT_MS)
  life: [1] LifeState;       // the page's lifecycle (aethyr/session/lifecycle.coax, #12856)
  drawn_at: int;             // the last frame's monotonic ms (the world's ease)
  hello_due: bool;
  pipe: [1] Pipe;
  out: [WIRE_FRAME] u8;
  frames_in: int; frames_out: int; played: int; hits: int; replays: int; stops: int;
  bytes_in: int;                              // the frames' bytes heard (net_probe 43)
  folk_walk: int; folk_still: int;            // townsfolk frames drawn walking, and of them drawn where they were (net_probe 41, 42)
  creature_hits: int; creature_deaths: int;   // hits on and deaths of the server's creatures heard
  feet_y: f32;                                // your feet's height as the face last gave it (net_step's fy)
  join: [1] EgJoin;                           // the instance, the CHARACTER picker and INVITE (everglade-join.coax)
  mod: [1] EgMod;                             // your blocks and the nameplate pane (everglade-moderate.coax)
  party: [1] EgParty;                         // PARTY and its pane, a friend's party link (everglade-party.coax)
  evp: [1] EgEvents;                          // the room's event, your level and kit (everglade-events.coax)
}

everglade_attach_net :: (s: [] Everglade, n: [] EgNet) #export_c #effects(all) { s[0].net = n; }
net_of :: (s: [] Everglade) -> [] EgNet { return s[0].net; }
net_on :: (s: [] Everglade) -> bool { return s[0].net.count > 0; }
// You play in a room: you sat in one this load and the page still wants it. The room's kit, level,
// rules and status stay while its socket is down and the page rejoins (net_rejoining); only a page
// that never sat in a room plays offline. What goes to the room needs it open (net_open).
net_live :: (s: [] Everglade) -> bool #export_c #effects(all) { return net_open(s) || net_rejoining(s); }
// The socket is open and you sit in the room: what you do goes to it.
net_open :: (s: [] Everglade) -> bool { return net_on(s) && net_of(s)[0].state == NET_OPEN && net_of(s)[0].seat >= 0; }
// The room's socket dropped under you and the page is getting you back in (its backoff, net_down).
net_rejoining :: (s: [] Everglade) -> bool #export_c #effects(all) { return net_on(s) && net_of(s)[0].sat && net_of(s)[0].want && !net_open(s); }
net_now :: (n: [] EgNet) -> int { return n[0].mono + n[0].offset; }
// The server clock in ms, -1 while none is known.
net_clock :: (s: [] Everglade) -> int #export_c #effects(all) { if !net_on(s) || net_of(s)[0].mono == 0 { return -1; } return net_now(net_of(s)); }

net_send :: (n: [] EgNet, count: int) {
  if n[0].state != NET_OPEN || n[0].sock < 0 || count <= 0 { return; }
  if pipe_send(n[0].pipe[..], n[0].sock, cast(string) n[0].out[0..<count]) { n[0].frames_out += 1; }
}

// ---- the page: where the socket goes, and the clock

// The page facts (message 600): the socket's address, your player id, the wall clock. `room` is the
// room's name when the URL names none; a golden page opens no socket.
net_facts :: (s: [] Everglade, facts: string, room: string, golden: bool) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  url := fact(facts, "url");
  // ?stage=echo is a staged shot: you stand where the stage puts you (everglade-raid-preview.coax
  // rp_facts), so it opens no socket and no local host, whose seat would put you at the room's spawn;
  // with ?raid=preview it is the raid's room, where Echo fights for the watch (#12996)
  alone := golden || (net_query(url, "stage") == "echo" && net_query(url, "raid") != "preview");
  n[0].local_relay = false;
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  secure := url.count > 5 && url[0..<5] == "https";
  start := ifx secure then 8 else 7;
  m := wire_put(n[0].url[..], 0, ifx secure then "wss://" else "ws://");
  if start < k { m = wire_put(n[0].url[..], m, url[start..<k]); }
  relay := net_query(url, "relay");
  if relay.count > 15 && relay.count < 40 && relay[0..<15] == "ws://localhost:" {
    ok := true;
    for c: relay[15..<relay.count] { if c < '0' || c > '9' { ok = false; } }
    if ok { m = wire_put(n[0].url[..], 0, relay); n[0].local_relay = true; }
  }
  // a page on this machine can sit in production's rooms (a two-browser check against the live server)
  local := url.count > 16 && (url[0..<17] == "http://localhost:" || (url.count > 17 && url[0..<17] == "http://127.0.0.1:"));
  if local && relay == "wss://openagents.com" { m = wire_put(n[0].url[..], 0, relay); }
  n[0].host_n = m;
  n[0].realm_n = ifx net_code_ok(room) && room.count <= 20 then net_copy(n[0].realm[..], room) else 0;
  m = wire_put(n[0].url[..], m, "/api/room/relay/");
  m = wire_put(n[0].url[..], m, NET_GAME);
  m = wire_put(n[0].url[..], m, "/");
  n[0].url_n = m;
  jn_facts(s, n, url, room, alone);   // the instance: named, listed or a local server's (everglade-join.coax)
  n[0].want = !alone && start < k && (n[0].code_n > 0 || n[0].join[0].list_due);
  // ?offline=worker: the local host only, the rooms never asked (the drift check's side)
  only := !alone && net_query(url, "offline") == "worker" && !n[0].local_relay && n[0].join[0].list_due;
  n[0].local_ok = !alone && !n[0].local_relay && !n[0].join[0].test && room == "everglade";
  n[0].local_host = false; n[0].asking = false; n[0].ask_at = 0; n[0].ask_tries = 0; n[0].room_sock = -1; n[0].room_wait = false;
  if only { net_local_host(n); n[0].local_host = true; }
  else if n[0].local_ok {
    // the local host from the first frame, the room asked meanwhile
    n[0].asking = n[0].want;
    net_dest_swap(n); net_local_host(n); n[0].local_host = true;
  }
  if net_query(url,"arrival")=="1" && !s[0].avatar[0].configured && !n[0].join[0].picked {n[0].join[0].pick_open=true;n[0].join[0].hold=true;}
  pid := fact(facts, "player");
  if pid.count > 0 { n[0].pid_n = net_copy(n[0].pid[..], pid); }
  n[0].account = fact(facts, "account").count > 0;
  // the wall clock until the server says its own: now (Date.now()) less nav (ms since the navigation)
  wall := net_number(fact(facts, "now")); nav := net_number(fact(facts, "nav"));
  if wall > 0 && nav >= 0 && n[0].synced == 0 { n[0].offset = wall - nav; }
  if n[0].look_n == 0 { n[0].look_n = net_copy(n[0].look[..], "ranger.0.0.0"); }
  if net_query(url, "class") == "warlock" { wl_set(s, true); }   // ?class=warlock: the Warlock (everglade-warlock.coax)
  cl_query(s, url);   // ?kit=srd-NAME: a Character Create class (everglade-classes.coax)
}
// Offline play as a one-seat room (#12784): the local host's loopback socket, local:/api/room/relay/
// everglade/local-1, opened at once (no ticket, no list), the same frames as a room's.
NET_LOCAL :: "local:";
// The room asked again after a refusal while you play on the local host: from NET_ASK_MS, doubling to a
// minute, jittered
NET_ASK_MS :: 2000;
// The socket's address and its away one traded (net_facts, the local host and the room).
net_dest_swap :: (n: [] EgNet) {
  a := n[0].away[..]; j := n[0].join[..];
  t: [1] NetDest;
  for i: 0..<NET_URL { t[0].url[i] = n[0].url[i]; } for i: 0..<NET_CODE { t[0].code[i] = n[0].code[i]; }
  t[0].url_n = n[0].url_n; t[0].host_n = n[0].host_n; t[0].code_n = n[0].code_n;
  t[0].base_n = j[0].base_n; t[0].named = j[0].named; t[0].test = j[0].test; t[0].list_due = j[0].list_due; t[0].local_relay = n[0].local_relay;
  for i: 0..<NET_URL { n[0].url[i] = a[0].url[i]; } for i: 0..<NET_CODE { n[0].code[i] = a[0].code[i]; }
  n[0].url_n = a[0].url_n; n[0].host_n = a[0].host_n; n[0].code_n = a[0].code_n;
  j[0].base_n = a[0].base_n; j[0].named = a[0].named; j[0].test = a[0].test; j[0].list_due = a[0].list_due; n[0].local_relay = a[0].local_relay;
  a[0] = t[0];
}
// The room refused the ask, or its socket closed before a seat, while you play on the local host: asked
// again after a wait.
net_ask_later :: (n: [] EgNet) {
  n[0].ask_tries += 1;
  wait := NET_ASK_MS;
  for q: 0..<lo_int(n[0].ask_tries - 1, 5) { wait *= 2; }
  wait = lo_int(wait, 60000);
  j := ((n[0].mono * 7919 + n[0].ask_tries * 104729 + n[0].pid_n * 31) % 1000 + 1000) % 1000;
  at := n[0].mono + wait * 3 / 4 + wait * j / 2000;
  if at > n[0].ask_at { n[0].ask_at = at; }
}
net_local_host :: (n: [] EgNet) {
  m := wire_put(n[0].url[..], 0, NET_LOCAL);
  m = wire_put(n[0].url[..], m, "/api/room/relay/"); m = wire_put(n[0].url[..], m, NET_GAME); m = wire_put(n[0].url[..], m, "/");
  n[0].host_n = 0; n[0].join[0].base_n = m;
  jn_code(n, "local-1");
  j := n[0].join[..];
  j[0].list_due = false; j[0].named = true; j[0].test = true;
  n[0].local_relay = true;
  jn_url(n);
  n[0].want = true;
}
// The room's socket while you play on the local host: opened beside it with the seat ticket
// (net_ask_room), and taken as the page's socket at its seat ('y'): the local host's is closed then and
// what the page held of it forgotten. One that closes, or is still opening after NET_OPEN_MS, before
// its seat leaves you on the local host, and the room is asked again later (#12882).
net_room_open :: (n: [] EgNet) {
  net_dest_swap(n);
  u: [NET_URL + NET_TICKET + 9] u8;
  k := wire_put(u[..], 0, cast(string) n[0].url[0..<n[0].url_n]);
  k = wire_put(u[..], k, "?t="); k = wire_put(u[..], k, cast(string) n[0].ticket[0..<n[0].ticket_n]);
  net_dest_swap(n);
  n[0].ticket_n = 0;
  if pipe_open(n[0].pipe[..], cast(string) u[0..<k]) { n[0].room_wait = true; n[0].room_at = n[0].mono; }
  else { net_ask_later(n); }
}
net_room_failed :: (s: [] Everglade, n: [] EgNet) {
  if n[0].room_sock >= 0 { _ := pipe_close(n[0].pipe[..], n[0].room_sock); }
  n[0].room_sock = -1; n[0].room_wait = false;
  net_dest_swap(n); jn_refused(s, n); net_dest_swap(n);   // full, or gone (everglade-join.coax)
  net_ask_later(n);
}
net_room_seated :: (n: [] EgNet) {
  if n[0].sock >= 0 { _ := pipe_close(n[0].pipe[..], n[0].sock); }
  net_dest_swap(n);
  n[0].local_host = false; n[0].asking = false; n[0].ask_tries = 0;
  n[0].sock = n[0].room_sock; n[0].room_sock = -1; n[0].state = NET_OPEN;
  n[0].seat = -1; n[0].tries = 0; n[0].lost = false; n[0].quiet_fresh = true; n[0].ping_n = 0; n[0].ping_at = 0;
  for e: 0..<NET_ENTS { n[0].ents[e].live = false; }
  for q: 0..<NET_FX { n[0].fx[q].live = false; }
  net_forget(n);
  n[0].fix_due = false; n[0].off_x = 0; n[0].off_y = 0; n[0].off_z = 0; n[0].rg_open = 0; n[0].rg_close = 0;
}
// A minted player (POST /api/playtest/player answered {"key":...,"id":"...",...}): its id for the hello.
net_player :: (s: [] Everglade, record: string) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  key := "\"id\":\"";
  for i: 0..<record.count {
    if i + key.count > record.count || record[i..<i + key.count] != key { continue; }
    e := i + key.count;
    while e < record.count && record[e] != '"' { e += 1; }
    n[0].pid_n = net_copy(n[0].pid[..], record[i + key.count..<e]);
    if n[0].state == NET_OPEN { n[0].hello_due = true; }
    return;
  }
}
// The API's answer to the seat-ticket ask ("200\n{"ticket":"...",...}", anything else a refusal): the
// next open uses it; a refusal waits as a closed socket does, then asks again.
net_ticket :: (s: [] Everglade, answer: string) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].ticket_asked = false;
  // the local host seats without one; while you play on it the answer is the room's (net_ask_room)
  asking := n[0].local_host && n[0].asking;
  if n[0].local_host && !asking { return; }
  if asking { net_dest_swap(n); }
  key := "\"ticket\":\"";
  if answer.count > 4 && answer[0..<4] == "200\n" {
    for i: 4..<answer.count {
      if i + key.count > answer.count || answer[i..<i + key.count] != key { continue; }
      e := i + key.count;
      while e < answer.count && answer[e] != '"' { e += 1; }
      if e < answer.count && e - i - key.count > 0 && e - i - key.count <= NET_TICKET {
        n[0].ticket_n = net_copy(n[0].ticket[..], answer[i + key.count..<e]);
        had_look := (n[0].restored && n[0].saved_look_n > 0) || net_json_field(answer, "look").count > 0;
        net_placed(n, net_json_field(answer, "room"), net_number(net_json_field(answer, "shard")));
        if net_json_field(answer, "full") == "true" && net_json_field(answer, "asked").count > 0 { jn_full(s, n, net_json_field(answer, "by"), net_json_field(answer, "room")); n[0].join[0].with_n = 0; }
        net_restore(s, n, answer);
        md_ticket(n, answer);   // who you block (#12714)
        pt_ticket(s, answer);   // your party's room was full (#12852)
        jn_ticketed(s, n, answer, had_look);   // a first visit: CHARACTER before you join
        if asking { net_dest_swap(n); }   // kept: the socket goes to the room when CHARACTER is done (net_ask_room)
        return;
      }
    }
  }
  n[0].ticket_n = 0;
  // the directory has no seat anywhere (every shard's rooms full): said with how many wait and the last
  // wait (#12796), and asked again after the wait the API names
  if answer.count > 4 && answer[0..<4] == "503\n" {
    t: [64] u8;
    k := wire_put(t[..], 0, "ALL ROOMS FULL");
    w := net_json_field(answer, "waiting");
    if w.count > 0 && w.count < 6 { k = wire_put(t[..], k, " · "); k = wire_put(t[..], k, w); k = wire_put(t[..], k, " WAITING"); }
    l := net_number(net_json_field(answer, "last_wait_ms"));
    if net_json_field(answer, "last_wait_ms").count > 0 && l < 36000000 {
      k = wire_put(t[..], k, " · LAST WAIT ");
      k = ifx l < 60000 then put_digits(t[..], k, ifx l < 1000 then 1 else l / 1000) else put_digits(t[..], k, l / 60000);
      k = wire_put(t[..], k, ifx l < 60000 then "S" else " MIN");
    }
    net_tell(s, n, cast(string) t[0..<k]);
  }
  // an admin's KICK or a report's HIDE (verse.room_kicks): out of the rooms and their chat for 24 hours, said
  if answer.count > 4 && answer[0..<4] == "403\n" && net_json_field(answer, "error") == "kicked" { net_tell(s, n, "KICKED · BACK IN 24 HOURS"); }
  if asking {
    // you play on the local host on: the room is asked again later
    net_dest_swap(n);
    n[0].retry = 0; net_retry_after(n, answer);
    if n[0].retry > n[0].ask_at { n[0].ask_at = n[0].retry; }
    net_ask_later(n);
    return;
  }
  net_down(n);
  net_retry_after(n, answer);
}
// A refusal's retry time (429 asked too often, 503 every room full: "retry_ms", #12796) is honored: the
// next ask waits at least that long, plus up to a quarter more of jitter so the pages refused together
// come back apart. Capped at 5 minutes.
net_retry_after :: (n: [] EgNet, answer: string) {
  f := net_json_field(answer, "retry_ms");
  if f.count == 0 || f.count > 7 { return; }
  ms := lo_int(net_number(f), 300000);
  if ms <= 0 { return; }
  j := ((n[0].mono * 7919 + n[0].tries * 104729 + n[0].pid_n * 31 + int(n[0].pid[0]) * 13 + int(n[0].pid[lo_int(1, n[0].pid_n)]) * 29) % 1000 + 1000) % 1000;
  at := n[0].mono + ms + ms * j / 4000;
  if at > n[0].retry { n[0].retry = at; }
}
// What became of the room, said once over the hotbar (and kept for the probe).
net_tell :: (s: [] Everglade, n: [] EgNet, text: string) {
  n[0].said_n = 0;
  for ch: text { if n[0].said_n >= 48 { break; } n[0].said[n[0].said_n] = ch; n[0].said_n += 1; }
  n[0].said_t = f32(NET_SAY);
  if s[0].started { sp_say(s, text, -1, ""); }
}
// Where the API's directory put you (#12717): the instance and the oa-room shard that holds it. The
// socket opens on that shard's path, wss://HOST/api/room/sK/relay/everglade/INSTANCE, which the load
// balancer sends to shard K (a shard seats only its own tickets); the next open asks for the same
// instance, so a reconnect sits where it was. A local relay keeps its own address.
net_placed :: (n: [] EgNet, room: string, shard: int) {
  if n[0].local_relay || !net_code_ok(room) || shard < 1 || shard > 99 { return; }
  n[0].code_n = net_copy(n[0].code[..], room);
  m := n[0].host_n;
  m = wire_put(n[0].url[..], m, "/api/room/s");
  digits := "0123456789";
  if shard >= 10 { m = wire_put(n[0].url[..], m, digits[shard / 10..<shard / 10 + 1]); }
  m = wire_put(n[0].url[..], m, digits[shard % 10..<shard % 10 + 1]);
  m = wire_put(n[0].url[..], m, "/relay/"); m = wire_put(n[0].url[..], m, NET_GAME); m = wire_put(n[0].url[..], m, "/");
  m = wire_put(n[0].url[..], m, room);
  n[0].url_n = m;
}
// What the ticket's answer brings back (#12715), once a page: your WANTED level (the one the room saved
// in the last 5 minutes, #12794; the watch takes it as a "+wantedN" start) and your look (the hello
// sends it). The HP and WANTED are the server's.
net_restore :: (s: [] Everglade, n: [] EgNet, answer: string) {
  if n[0].restored { return; }
  n[0].restored = true;
  w := net_json_field(answer, "wanted");
  level := net_number(w);
  if level > 0 && level <= 5 { s[0].wv.want = level; }
  look := net_json_field(answer, "look");
  if look.count > 0 && look.count <= NET_LOOK && look[0] != '"' {
    n[0].look_n = net_copy(n[0].look[..], look);
    n[0].saved_look_n = net_copy(n[0].saved_look[..], look);
  }
}
// A field of a flat JSON answer, its text without quotes ("" none).
// While you play in a room: a look that changed is saved (at most every NET_STATE_EVERY). Your WANTED
// level is not the page's to save: the room reports it signed with your HP and XP, and the API refuses
// it from a page (coax/web/room/room-vitals.coax, coax/web/api/player.c room_state, #12794).
net_save_state :: (s: [] Everglade, n: [] EgNet) {
  if !net_open(s) || n[0].mono - n[0].saved_at < NET_STATE_EVERY { return; }
  look := cast(string) n[0].look[0..<n[0].look_n];
  if look == cast(string) n[0].saved_look[0..<n[0].saved_look_n] { return; }
  b: [128] u8;
  k := wire_put(b[..], 0, "{\"look\":\""); k = wire_put(b[..], k, look); k = wire_put(b[..], k, "\",\"class\":\"druid\"}");
  if pipe_put(n[0].pipe[..], NET_PIPE_STATE, -1, cast(string) b[0..<k]) {
    n[0].saved_look_n = net_copy(n[0].saved_look[..], look); n[0].saved_at = n[0].mono;
  }
}
// Whether the server said the world changed since the face last asked (the face asks for it again).
net_edit_take :: (s: [] Everglade) -> bool #export_c #effects(all) {
  if !net_on(s) || !net_of(s)[0].edit_due { return false; }
  net_of(s)[0].edit_due = false;
  return true;
}
// The room's name (the chat's too).
net_room :: (s: [] Everglade, room: string) -> string #export_c #effects(all) {
  if !net_on(s) || net_of(s)[0].code_n == 0 { return room; }
  return cast(string) net_of(s)[0].code[0..<net_of(s)[0].code_n];
}
// The look you show ("ranger.SKIN.DYE.TRIM", spec 5.2).
net_set_look :: (s: [] Everglade, look: string) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].look_n = net_copy(n[0].look[..], look);
  if n[0].state == NET_OPEN { n[0].hello_due = true; }
}

// ---- the socket's events

// The face opened the socket: its id, or -1 (refused).
net_opened :: (s: [] Everglade, id: int) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  if n[0].room_wait {   // the room's, beside the local host's (net_room_open)
    n[0].room_wait = false;
    if id < 0 { net_room_failed(s, n); } else { n[0].room_sock = id; }
    return;
  }
  if id < 0 { net_down(n); return; }
  n[0].sock = id;
}
// Closed: the world goes with it (nothing is shown that the server isn't saying), and the socket is
// tried again after a wait that doubles to a minute, jittered. You stay in the room's game meanwhile (net_live).
net_down :: (n: [] EgNet) {
  n[0].state = NET_DOWN; n[0].sock = -1; n[0].seat = -1; n[0].quiet_fresh = true;
  n[0].tries += 1;
  wait := 1000;
  for q: 0..<lo_int(n[0].tries - 1, 6) { wait *= 2; }
  // jitter, 75% to 125% of the wait, so the pages a restarted room dropped don't all come back at once
  wait = lo_int(wait, 60000);
  j := ((n[0].mono * 7919 + n[0].tries * 104729 + n[0].pid_n * 31) % 1000 + 1000) % 1000;
  n[0].retry = n[0].mono + wait * 3 / 4 + wait * j / 2000;
  for e: 0..<NET_ENTS { n[0].ents[e].live = false; }
  for q: 0..<NET_FX { n[0].fx[q].live = false; }
  net_forget(n);
  n[0].fix_due = false; n[0].off_x = 0; n[0].off_y = 0; n[0].off_z = 0;
  n[0].rg_open = 0; n[0].rg_close = 0;
}
// What the page holds of the server's rows, forgotten: a new seat's are a new snapshot.
net_forget :: (n: [] EgNet) {
  for q:0..<16 {n[0].party_only[q]=false;}
  wire_mirror_forget(n[0].mir[..]);
  n[0].out_got = 0; n[0].was_snap = false; n[0].town_check = false;   // a new seat's count starts again (#12902)
}
// book:begin quiet-socket
// The quiet socket's watch, each frame (NET_SILENT_MS): an open socket that heard nothing for that
// long, or one still opening after NET_OPEN_MS, is closed, said, and tried again as a closed one is.
net_quiet :: (s: [] Everglade, n: [] EgNet, mono: int) {
  gap := mono - n[0].stepped_at; n[0].stepped_at = mono;
  watched := n[0].sock >= 0 && (n[0].state == NET_OPEN || n[0].state == NET_OPENING);
  if !watched || n[0].quiet_fresh || n[0].frames_in != n[0].quiet_frames || gap >= NET_STALL_MS {
    n[0].quiet_frames = n[0].frames_in; n[0].quiet_since = mono; n[0].quiet_fresh = !watched; return;
  }
  if mono - n[0].quiet_since < (ifx n[0].state == NET_OPEN then NET_SILENT_MS else NET_OPEN_MS) { return; }
  _ := pipe_close(n[0].pipe[..], n[0].sock);
  if n[0].seat >= 0 { n[0].lost = true; net_tell(s, n, "LOST THE ROOM · REJOINING"); }
  net_down(n);
}
// book:end quiet-socket
// The page's lifecycle (#12856): the host's hidden and shown go through the shared profile
// (aethyr/session/lifecycle.coax), which says what to do. Hidden stops the clock (the host's blur
// on hiding releases held inputs: everglade_blur). Shown after LIFECYCLE_RESYNC ticks away replaces the
// socket at once, so the room sends the whole state on the rejoin, rather than waiting NET_SILENT_MS to
// find a socket the long suspension broke. Nothing the page sent before is sent again.
net_life :: (s: [] Everglade, kind: int) -> LifeActions {
  if !net_on(s) { return LifeActions.{}; }
  n := net_of(s);
  a := life_event(n[0].life[..], kind, n[0].mono * WIRE_HZ / 1000, 0);
  // a long time away (LC_FULL_STATE) or a network change (LC_NEW_SOCKET, LC_NET): a new socket now, the
  // whole state on the rejoin
  if (a.does & (LC_FULL_STATE | LC_NEW_SOCKET)) != 0 && n[0].sock >= 0 && (n[0].state == NET_OPEN || n[0].state == NET_OPENING) && !n[0].stale {
    _ := pipe_close(n[0].pipe[..], n[0].sock);
    net_down(n);
    n[0].retry = 0;   // at once: the tab is back
  }
  return a;
}
// A socket event (message kind 256 + 4 * id + event, its text in the inbox): true when it was ours.
net_event :: (s: [] Everglade, kind: int, text: string) -> bool #export_c #effects(all) {
  if !net_on(s) { return false; }
  n := net_of(s);
  ev := socket_event(kind);
  if ev.id >= 0 && ev.id == n[0].room_sock {
    // the room's socket beside the local host's: its seat makes it the page's (net_room_seated)
    if ev.event == SOCKET_CLOSED || ev.event == SOCKET_ERROR { net_room_failed(s, n); return true; }
    r: [1] WireRd; r[0] = wire_rd(text, 1);
    if ev.event == SOCKET_FRAME && text.count > 0 && text[0] == 'y' && r[0].ok && wire_num(text, r[..]) >= 0 {
      net_room_seated(n);
      n[0].frames_in += 1; n[0].bytes_in += text.count;
      net_record(s, n, text);
    }
    return true;
  }
  if ev.id < 0 || ev.id != n[0].sock { return false; }
  if ev.event == SOCKET_OPENED { n[0].state = NET_OPEN; n[0].tries = 0; n[0].ping_n = 0; n[0].ping_at = 0; n[0].quiet_fresh = true; return true; }
  if ev.event == SOCKET_ERROR && text.count > 0 && n[0].state == NET_OPEN { return true; }   // a frame over the inbox cap: dropped
  if ev.event == SOCKET_CLOSED || ev.event == SOCKET_ERROR {
    if n[0].stale || n[0].elsewhere { net_down(n); return true; }   // a new version's (it says so, and reloads: net_stale), or your character's elsewhere
    if n[0].seat < 0 { jn_refused(s, n); }   // closed before a seat: full, or gone (everglade-join.coax)
    else { n[0].lost = true; net_tell(s, n, "LOST THE ROOM · REJOINING"); }   // your network dropped, or the room went
    net_down(n); return true;
  }
  if ev.event == SOCKET_FRAME {
    n[0].frames_in += 1; n[0].bytes_in += text.count;
    if n[0].mono - n[0].rate_t >= 1000 { n[0].rate = (n[0].bytes_in - n[0].rate_b) * 1000 / hi_int(n[0].mono - n[0].rate_t, 1); n[0].rate_t = n[0].mono; n[0].rate_b = n[0].bytes_in; }
    net_record(s, n, text);
  }
  return true;
}
// The entity with id eid, made when new (make); -1 none or no room.
net_ent :: (n: [] EgNet, eid: int, make: bool) -> int {
  free := -1;
  for e: 0..<NET_ENTS {
    if n[0].ents[e].live && n[0].ents[e].eid == eid { return e; }
    if !n[0].ents[e].live && n[0].ents[e].generation<4294967295 && free < 0 { free = e; }
  }
  if !make || free < 0 { return -1; }
  generation:=add_sat(n[0].ents[free].generation,1);
  n[0].ents[free] = NetEnt.{live = true, generation=generation, eid = eid, born = n[0].tick_t};
  return free;
}
#test "handle generations: a replicated slot advances on reuse and retires at its last generation" {
  n:[1]EgNet;
  first:=net_ent(n[..],100,true);#assert first==0 && n[0].ents[0].generation==1;
  #assert net_ent(n[..],100,false)==0 && net_ent(n[..],101,false)== -1;
  n[0].ents[0].live=false;second:=net_ent(n[..],101,true);
  #assert second==0 && n[0].ents[0].generation==2;
  n[0].ents[0].live=false;n[0].ents[0].generation=4294967294;
  #assert net_ent(n[..],102,true)==0 && n[0].ents[0].generation==4294967295;
  #assert net_ent(n[..],102,false)==0;
  n[0].ents[0].live=false;#assert net_ent(n[..],103,true)==1 && n[0].ents[0].generation==4294967295;
  for i:0..<NET_ENTS {n[0].ents[i].live=false;n[0].ents[i].generation=4294967295;}
  #assert net_ent(n[..],104,true)== -1;
}
// A tick's server time (W's clock), or the last state's when no W has come.
// W carries the server's wall-clock phase as its day. Recover its nearest day around our synced
// clock: anchoring at receipt instead includes transport delay, and a later ping correction then
// leaves every buffered state dated too far ahead. Headers without a sky keep the legacy fallback.
net_world_t :: (n: [] EgNet, w: WireWorld) -> int {
  now := net_now(n);
  if now <= 0 || w.weather <= 0 || w.day < 0 || w.day >= WIRE_DAY_MS { return now; }
  delta := w.day - now % WIRE_DAY_MS;
  if delta > WIRE_DAY_MS / 2 { delta -= WIRE_DAY_MS; }
  if delta < -WIRE_DAY_MS / 2 { delta += WIRE_DAY_MS; }
  at := add_checked(now, delta);
  switch at { case none { return now; } case some(v) { return v; } }
}
net_tick_t :: (n: [] EgNet, tick: int) -> int {
  if n[0].worlds == 0 || n[0].hz <= 0 { return net_now(n); }
  return n[0].w_t + (tick - n[0].w_tick) * 1000 / n[0].hz;
}
// One frame from the server (or the relay).
net_record :: (s: [] Everglade, n: [] EgNet, t: string) {
  if t.count < 1 { return; }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  if !r[0].ok { return; }
  c := t[0];
  if c == 'y' {
    seat := wire_num(t, r[..]); _ := wire_num(t, r[..]); clock := wire_num(t, r[..]);
    if seat < 0 { return; }
    n[0].seat = seat; n[0].wanted = -1; n[0].sat = true; jn_seated(n);
    net_forget(n);
    if n[0].lost { n[0].lost = false; net_tell(s, n, "BACK IN THE ROOM"); }
    if r[0].ok && clock > 0 && n[0].synced < 2 { n[0].offset = clock - n[0].mono; n[0].synced = 1; }
    n[0].hello_due = true; n[0].acked = n[0].seq; n[0].fix_due = false; n[0].rg_open = 0; n[0].rg_close = 0;
    return;
  }
  if c == 't' {
    sent := wire_num(t, r[..]); clock := wire_num(t, r[..]);
    if !r[0].ok || sent > n[0].mono || sent <= 0 { return; }
    rtt := n[0].mono - sent;
    q := n[0].pings % NET_PINGS;
    n[0].ping_rtt[q] = rtt; n[0].ping_off[q] = clock + rtt / 2 - n[0].mono;
    n[0].pings += 1;
    best := net_ping_best(n[0].ping_rtt[..], n[0].pings);
    n[0].offset = n[0].ping_off[best]; n[0].synced = 2;
    return;
  }
  if c == 'W' {
    w := wire_read_world(t, r[..]);
    if !r[0].ok { return; }
    n[0].w_tick = w.tick; n[0].w_t = net_world_t(n, w); n[0].hz = clamp_i(w.hz, 1, 120); n[0].budget = w.budget;
    n[0].seed = w.seed; n[0].day = w.day; n[0].weather = w.weather; n[0].worlds += 1;
    return;
  }
  if c == 'D' {
    d := wire_read_d(t, r[..]);
    if !r[0].ok { return; }
    clock := net_tick_t(n, d.tick);
    if d.part == 0 && (d.tick != n[0].tick || n[0].ticks == 0) {
      // the jitter buffer: how late each state comes, its spread, and the states' interval
      // (everglade-net-core.coax net_jitter_heard, net_jitter_delay)
      j := net_jitter_heard(NetJitter.{late_mean = n[0].late_mean, jitter = n[0].jitter, interval = n[0].interval}, n[0].ticks, net_now(n), clock, n[0].tick_t);
      n[0].late_mean = j.late_mean; n[0].jitter = j.jitter; n[0].interval = j.interval;
      n[0].delay = net_jitter_delay(j);
      n[0].ticks += 1;
    }
    n[0].tick = d.tick; n[0].tick_t = clock;
    // a snapshot's first part: the mirror forgets everything, and what the snapshot doesn't hold goes;
    // the town's pieces come again from the first, which the page checks its town against (#12902)
    snap := (d.f & 1) != 0;
    if snap && !n[0].was_snap { net_town_begin(n); }
    n[0].was_snap = snap;
    _ := wire_mirror_d(n[0].mir[..], d);
    from := r[0].at;
    for k: 0..<wire_entries(t, from) { net_entry(s, n, wire_entry(t, from, k), d); }
    wire_mirror_end(n[0].mir[..], d);
    if (d.f & 1) != 0 && (d.f & 2) == 0 {
      for e: 0..<NET_ENTS {n[0].ents[e].live=net_snapshot_visible(n[0].ents[e].live,n[0].ents[e].live && n[0].ents[e].seen==d.tick,true);}
      for q:0..<16 {if n[0].party_seen[q]!=d.tick {n[0].party_only[q]=false;}}
    }
    return;
  }
  if c == 'g' { net_go(s, n, wire_word(t, r[..])); return; }
  if c == 'r' {
    seq := wire_num(t, r[..]);
    why := wire_word(t, r[..]);
    if why == WIRE_REFUSE_VERSION { net_stale(s, n); return; }
    if why == WIRE_REFUSE_ELSEWHERE { net_elsewhere(s, n); return; }
    if why == WIRE_REFUSE_RESTARTING { net_restarting(s, n); return; }
    n[0].said_n = 0;
    for ch: "CAN'T · " { n[0].said[n[0].said_n] = ch; n[0].said_n += 1; }
    for ch: why { if n[0].said_n >= 48 { break; } n[0].said[n[0].said_n] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; n[0].said_n += 1; }
    n[0].said_t = f32(NET_SAY);
    // a cast of yours: its bar cancels with its reason's icon, no line of text (everglade-cast-sight.coax, #12790)
    for q: 0..<NET_MINE {
      if n[0].mine_seq[q] != seq || seq <= 0 { continue; }
      n[0].mine_seq[q] = 0;
      if seq == n[0].rg_open { n[0].rg_open = 0; n[0].rg_close = 0; }   // your Reverse Gravity never stood
      if cr_repair(n[0].mine_slot[q]) { mend_cancel(s, cr_why(why)); }   // a Repair the server refused: its bar stops, said why (everglade-repair.coax)
      else if s[0].started { cr_refused(s, n[0].mine_slot[q], cr_why(why)); }
      return;
    }
    if s[0].started { sp_say(s, cast(string) n[0].said[0..<n[0].said_n], -1, ""); }
    return;
  }
}
// The room refused this page's wire version (a release came out since it loaded): it says so, opens no
// socket again, and reloads itself once, NET_RELOAD_MS on, with reload=1 so a reload that still has the
// old page asks you to instead of reloading again.
net_stale :: (s: [] Everglade, n: [] EgNet) {
  if n[0].stale { return; }
  n[0].stale = true; n[0].want = false;
  again := net_query(cast(string) n[0].join[0].href[0..<n[0].join[0].href_n], "reload") == "1";
  n[0].reload_at = ifx again then -1 else n[0].mono + NET_RELOAD_MS;
  net_tell(s, n, ifx again then "A NEW VERSION IS OUT · RELOAD THE PAGE" else "A NEW VERSION IS OUT · RELOADING");
}
// You play this character in another tab, device or room now (a newer seat ticket took it, #12834):
// the page says so and opens no socket again, so two pages that rejoin on their own never take turns.
// A reload asks for a new ticket, and plays here again.
net_elsewhere :: (s: [] Everglade, n: [] EgNet) {
  if n[0].elsewhere { return; }
  n[0].elsewhere = true; n[0].want = false;
  net_tell(s, n, "YOU'RE PLAYING ELSEWHERE · RELOAD TO PLAY HERE");
}
// The room drains before a release (#12797): it says so, and the page joins again a second on, asking
// the directory for a seat, which it now gives on another shard. Not a loss: no LOST line after.
net_restarting :: (s: [] Everglade, n: [] EgNet) {
  if n[0].sock >= 0 { _ := pipe_close(n[0].pipe[..], n[0].sock); }
  net_tell(s, n, "RESTARTING · BACK IN A MOMENT");
  n[0].ticket_n = 0; n[0].tries = 0;
  net_down(n);
}
// The reload, when its time comes: this page's path and query with reload=1, to the host (action 1).
net_reload :: (s: [] Everglade, n: [] EgNet) {
  if !n[0].stale || n[0].reload_at < 0 || n[0].mono < n[0].reload_at || s[0].action != 0 { return; }
  n[0].reload_at = -1;
  href := cast(string) n[0].join[0].href[0..<n[0].join[0].href_n];
  // from the path on: past "://" and the host
  from := 0;
  for i: 0..<href.count - 2 { if href[i] == ':' && href[i + 1] == '/' && href[i + 2] == '/' { from = i + 3; break; } }
  if from > 0 { while from < href.count && href[from] != '/' { from += 1; } }
  path := href[from..<href.count];
  e := 0; while e < path.count && path[e] != '#' { e += 1; }
  path = path[0..<e];
  if path.count == 0 || path[0] != '/' { return; }
  q := false; for ch: path { if ch == '?' { q = true; } }
  m := 0;
  for ch: path { if m < OUTBOX { s[0].outbox[m] = ch; m += 1; } }
  for ch: ifx q then "&reload=1" else "?reload=1" { if m < OUTBOX { s[0].outbox[m] = ch; m += 1; } }
  s[0].out_n = m; s[0].action = NET_ACT_NAVIGATE;
}
// One entry of a state (D).
net_entry :: (s: [] Everglade, n: [] EgNet, t: string, d: WireD) {
  if t.count < 1 { return; }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := t[0];
  if c == 'e' && wire_outcome(t) { n[0].out_got = add_sat(n[0].out_got, 1); }   // stops at the largest int, as the room's count does (#12927)
  if c == 'o' {
    // the room's count of the outcomes it sent this seat: fewer heard, a frame was lost (#12902)
    m := wire_num(t, r[..]);
    if !r[0].ok { return; }
    if m > n[0].out_got { net_missed(s, n); }
    n[0].out_got = m;
    return;
  }
  if c == 's' {
    e := wire_mirror_s(n[0].mir[..], d.tick, t);
    if e >= 0 {
      w:=wire_mirror_get(n[0].mir[..],e);
      h:=wire_read_s_head(t,r[..]);mask:=wire_num(t,r[..]);
      if w.id>=0 && w.id<16 {
        health:=(1<<WS_HP)|(1<<WS_MAX);
        if h.back==0 {n[0].party_only[w.id]=mask!=0 && (mask & health)==mask;}
        if n[0].party_only[w.id] {
          n[0].party_hp[w.id]=w.hp;n[0].party_max[w.id]=w.max;n[0].party_seen[w.id]=d.tick;
          old:=net_ent(n,w.id,false);if old>=0 {n[0].ents[old].live=false;}
          return;
        }
      }
      net_row(s,n,w,d);
    }
    return;
  }
  if c == 'n' {
    w := wire_read_n(t, r[..]);
    if !r[0].ok || w.ss < 0 { return; }
    k := net_ent(n, w.ss, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    if en[0].ring_n == 0 { en[0].kind = WK_PLAYER; en[0].owner = w.ss; }
    en[0].seat = w.ss; en[0].seen = d.tick;
    en[0].id_n = net_copy(en[0].id[..], w.id);
    en[0].look_n = net_copy(en[0].look[..], w.look);
    en[0].cls_n = net_copy(en[0].cls[..], w.kind); en[0].hello_flags = w.flags;
    nm := 0;
    for ch: w.name { if nm >= NET_NAME { break; } if ch < 32 { continue; } en[0].name[nm] = ch; nm += 1; }
    en[0].name_n = nm;
    return;
  }
  if c == 'x' {
    id := wire_num(t, r[..]);
    if !r[0].ok { return; }
    if id>=0 && id<16 {n[0].party_only[id]=false;}
    _ := wire_mirror_x(n[0].mir[..], id);
    k := net_ent(n, id, false);
    if k >= 0 { ege_gone(s, n, k); n[0].ents[k].live = false; }   // a raider's body falls (everglade-events.coax)
    return;
  }
  if c == 'w' {
    ss := wire_num(t, r[..]); level := wire_num(t, r[..]);
    if !r[0].ok || ss < 0 { return; }
    if ss == n[0].seat { n[0].wanted = level; return; }
    k := net_ent(n, ss, true);
    if k >= 0 { n[0].ents[k].wanted = level; }   // another's (net_view)
    return;
  }
  if ege_entry(s, n, t) { return; }   // g, v, e level, e xp (everglade-events.coax)
  if c != 'e' { return; }
  if wire_is(t, "e cast") {
    r[0] = wire_rd(t, 6);
    ce := wire_read_cast_e(t, r[..]);
    if !r[0].ok || ce.slot < 0 || cr_repair(ce.slot) || (ce.slot >= SP_REBUILD && (ce.slot < WL_SLOT0 || ce.slot >= WL_SLOT0 + WL_SLOTS) && (ce.slot < CL_SLOT0 || ce.slot >= CL_SLOT0 + CL_N)) { return; }   // a Repair plays nothing until e mend
    k := net_ent(n, ce.ss, false);
    if k >= 0 { n[0].ents[k].cast_slot = ce.slot; n[0].ents[k].cast_at = n[0].tick_t; }
    for q: 0..<NET_FX {
      if n[0].fx[q].live { continue; }
      // the server says the cast at its press: the strike plays once the cast bar is done (the meteors
      // fall and land after its 2.5 s, as offline), on every page alike
      bar := ifx ce.slot < SP_SLOTS then cast(int) (srd_spell(SP_SPELL[ce.slot]).bar * 1000) else 0;
      n[0].fx[q] = NetFx.{live = true, slot = ce.slot, caster = ce.ss, at = v3(ce.ax, ce.ay, ce.az), seed = ce.seed, t = n[0].tick_t + bar, mode = ce.mode};
      break;
    }
    return;
  }
  if wire_is(t, "e stop") {
    // a cast the server took ended before its strike (room-casts.coax): its strike never comes; yours
    // cancels with its reason's icon
    r[0] = wire_rd(t, 6);
    ss := wire_num(t, r[..]); slot := wire_num(t, r[..]); why := wire_word(t, r[..]);
    if !r[0].ok { return; }
    for q: 0..<NET_FX { if n[0].fx[q].live && n[0].fx[q].caster == ss && n[0].fx[q].slot == slot { n[0].fx[q].live = false; } }
    n[0].stops += 1;
    if ss == n[0].seat && cr_repair(slot) { mend_cancel(s, cr_why(why)); return; }   // your Repair stopped: moved, hurt, too far, said (everglade-repair.coax)
    if ss == n[0].seat && s[0].started { cr_refused(s, slot, cr_why(why)); }
    return;
  }
  if wire_is(t, "e hit") {
    r[0] = wire_rd(t, 5);
    h := wire_read_hit(t, r[..]);
    if !r[0].ok { return; }
    n[0].hits += 1;
    if h.who >= 2000 { n[0].creature_hits += 1; }
    if h.amt <= 0 || !s[0].started { return; }
    by := net_where(s, n, net_who(h.by));
    if by.ok { egs_swung(s, v3(by.x, by.y + 1.2, by.z), h.kind); }   // a weapon's swing (everglade-sound.coax); the blow is watch_pop's
    if ege_hit(s, n, h.who) { return; }   // WARDED (everglade-events.coax)
    target := net_ent(n, net_who(h.who), false);
    if s[0].rp.on && !s[0].guide.raid_helped && target>=0 && n[0].ents[target].kind==WK_BEAST && eg_raid_help(n[0].seat,h.by,n[0].ents[target].p1,h.amt) {s[0].guide.raid_helped=true;s[0].guide.raid_help_at=s[0].time;}
    at := net_where(s, n, net_who(h.who));
    if at.ok { watch_pop(s, v3(at.x, at.y + 2.1, at.z), h.amt, h.amt >= 25); }
    return;
  }
  if wire_is(t, "e break") {
    r[0] = wire_rd(t, 7);
    pc := wire_num(t, r[..]); ix := wire_f(t, r[..]); iy := wire_f(t, r[..]); iz := wire_f(t, r[..]);
    if !r[0].ok || !sp_on(s) || pc < 0 || pc >= sp_dm(s)[0].n { return; }
    if n[0].town_check {
      // the town sent again: a piece this page has broken stays where it lies (#12902)
      n[0].town_seen[pc] = true;
      if sp_dm(s)[0].pieces[pc].state == DP_BROKEN { return; }
    }
    net_break_piece(s, n, pc, ix, iy, iz);
    return;
  }
  if wire_is(t, "e die") {
    r[0] = wire_rd(t, 5);
    who := wire_num(t, r[..]);
    if r[0].ok && who >= 2000 { n[0].creature_deaths += 1; ege_died(s, who); }   // a raider's body falls (everglade-events.coax)
    return;
  }
  if t.count > 7 && t[0..<7] == "e edit " {
    // an admin published or switched something: everyone's page asks for the world and the board again
    n[0].edit_due = true;
    if s[0].ev.ed.count > 0 { s[0].ev.ed[0].spec_due = true; }
    return;
  }
  if wire_is(t, "e burn") {
    r[0] = wire_rd(t, 6);
    pc := wire_num(t, r[..]); on := wire_num(t, r[..]);
    if !r[0].ok || !sp_on(s) || pc < 0 || pc >= sp_dm(s)[0].n { return; }
    // alight or out as the server says (its burning down and spreading are the server's: fi_frame)
    v := fi_of(s);
    if on == 1 && n[0].town_check { n[0].burn_seen[pc] = true; }
    if on == 1 { if !fi_burning(s, pc) { _ := fi_ignite(s, pc); } }
    else { for q: 0..<v[0].n { if v[0].burn[q].piece == pc { fi_drop(s, q); break; } } }
    n[0].burns_heard += 1;
    return;
  }
  if t == "e rebuild" { if sp_on(s) { _ := sp_restore(s, -1); } return; }
  if t == "e town" { net_town_end(s, n); return; }
  if wire_is(t, "e mend") {
    // a Repair: the server stood it up (everglade-repair.coax), its pieces whole on every page
    r[0] = wire_rd(t, 6);
    code := wire_num(t, r[..]);
    if r[0].ok { mend_heard(s, code); n[0].mends_heard += 1; }
    return;
  }
  if wire_is(t, "e pburn") {
    // an admin's placed thing alight or out, as the server's world says (everglade-placed-fire.coax)
    r[0] = wire_rd(t, 7);
    i := wire_num(t, r[..]); on := wire_num(t, r[..]);
    if r[0].ok && on == 1 && n[0].town_check && i >= 0 && i < CR_PLACED_MAX { n[0].placed_seen[i] = true; }
    if r[0].ok { pf_heard(s, i, ifx on == 1 then 1 else 0); }
    return;
  }
  if wire_is(t, "e pgone") {
    r[0] = wire_rd(t, 7);
    i := wire_num(t, r[..]);
    if r[0].ok && n[0].town_check && i >= 0 && i < CR_PLACED_MAX { n[0].placed_seen[i] = true; }
    if r[0].ok { pf_heard(s, i, 2); }
    return;
  }
}
// Piece pc breaks as the server says, thrown by its impulse (the debris is this page's).
net_break_piece :: (s: [] Everglade, n: [] EgNet, pc: int, ix: f32, iy: f32, iz: f32) {
  c0 := demo_centre(sp_dm(s)[0].pieces[pc]);
  if sp_dm(s)[0].pieces[pc].state != DP_BROKEN { egs_break(s, sp_dm(s)[0].pieces[pc]); }   // a wall's or a tower's stone (everglade-sound.coax)
  m := sqrt(ix * ix + iy * iy + iz * iz);
  from := ifx m > 0.01 then sub(c0, v3(ix / m, iy / m, iz / m)) else sub(c0, v3(0, 1, 0));
  demo_break(sp_dm(s), pc, from, hi(m, 2));
  n[0].breaks_heard += 1;
  s[0].sp.walls_dirty = true;
}
// The town the room sends from its first piece (a snapshot's, or one an O asked for), checked: nothing
// named yet (#12902).
net_town_begin :: (n: [] EgNet) {
  n[0].town_check = true;
  for i: 0..<DEMO_PIECES { n[0].town_seen[i] = false; n[0].burn_seen[i] = false; }
  for i: 0..<CR_PLACED_MAX { n[0].placed_seen[i] = false; }
}
// An o said more outcomes than this page heard: a frame was lost on the way. It says O, checks the town
// the room sends again, and asks for the world again too (a lost e edit) (#12902).
net_missed :: (s: [] Everglade, n: [] EgNet) {
  net_send(n, wire_put_missed(n[0].out[..], 0, n[0].out_got));
  n[0].towns_asked += 1;
  net_town_begin(n);
  n[0].edit_due = true;
  if s[0].ev.ed.count > 0 { s[0].ev.ed[0].spec_due = true; }
}
// e town: the town sent again has all come. What this page holds broken, burning or burnt through that
// it didn't name stands again: a building with such a piece stands up whole, and the pieces and fires
// it named break and catch again where they were; a fire or a placed thing it didn't name goes out or
// stands (#12902).
net_town_end :: (s: [] Everglade, n: [] EgNet) {
  if !n[0].town_check { return; }
  n[0].town_check = false;
  if !sp_on(s) { return; }
  w := sp_dm(s);
  fixed := 0;
  v := fi_of(s);
  k := 0;
  while k < v[0].n {
    pc := v[0].burn[k].piece;
    if pc >= 0 && pc < DEMO_PIECES && !n[0].burn_seen[pc] { fi_drop(s, k); fixed += 1; continue; }
    k += 1;
  }
  for i: 0..<w[0].n {
    if w[0].pieces[i].state != DP_BROKEN || n[0].town_seen[i] { continue; }
    g := w[0].pieces[i].group;   // (-1: in no building, the whole town)
    stood := sp_restore(s, g);
    fixed += 1;
    for j: 0..<w[0].n {
      if g >= 0 && w[0].pieces[j].group != g { continue; }
      if n[0].town_seen[j] { net_break_piece(s, n, j, 0, 0, 0); }
      if n[0].burn_seen[j] && !fi_burning(s, j) { lit := fi_ignite(s, j); }
    }
  }
  for i: 0..<CR_PLACED_MAX {
    if n[0].placed_seen[i] || !(pf_gone(s, i) || pf_burning(s, i)) { continue; }
    back := pf_restore(s, i);
    fixed += 1;
  }
  if fixed > 0 { s[0].sp.walls_dirty = true; n[0].towns_fixed += fixed; }
}
// An entity's row (s), now its newest state: into its ring at the tick's time. Your own row is also
// where the server has you after input ACK, for the face to start again from.
net_row :: (s: [] Everglade, n: [] EgNet, w: WireS, d: WireD) {
  if w.id < 0 { return; }
  k := net_ent(n, w.id, true);
  if k < 0 { return; }
  en := n[0].ents[k..<k + 1];
  // a new life of this id (born again) or a jump in this one: drawn from this row, never between
  if en[0].ring_n > 0 && w.life != en[0].life { en[0].ring_n = 0; en[0].born = n[0].tick_t; }
  else if en[0].ring_n > 0 && w.warp != en[0].warp { en[0].ring_n = 0; }
  en[0].life = w.life; en[0].warp = w.warp; en[0].t0 = w.t0; en[0].dur = w.dur;
  en[0].kind = w.kind; en[0].owner = w.owner; en[0].hp = w.hp; en[0].max = w.max; en[0].temp = w.temp; en[0].seen = d.tick; en[0].cond = w.cond;
  st := NetState.{t = n[0].tick_t, x = w.x, y = w.y, z = w.z, yaw = w.yaw, vx = w.vx, vy = w.vy, vz = w.vz, f = w.g, a = w.clip};
  if w.kind == WK_PLAYER {
    // a player's P1 is its conditions, P2 its temporary Hit Points (net_view)
    en[0].seat = w.id; en[0].p1 = w.cond; en[0].p2 = w.temp; en[0].form = w.form;
  } else if w.kind == WK_BEAST { en[0].p1 = w.p1; en[0].p2 = w.max; st.a = 0; }
  else { en[0].p1 = w.p1; en[0].p2 = w.p2; if w.kind != WK_FOLK { st.a = 0; } if w.kind == WK_FOLK || w.kind == WK_DOORS || w.kind == WK_TREE { en[0].form = w.form; } }
  if w.kind == WK_TREE { st.a = w.clip; st.ax = f32(w.p1) / 1000; st.az = f32(w.p2) / 1000; st.age = w.carry; }
  net_push_row(en, st, n[0].hz);
  if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
  if w.kind == WK_PLAYER && w.id == n[0].seat && d.ack > n[0].acked {
    n[0].acked = d.ack;
    // and whether that input held the jump (the re-run starts from the server's jump, not the page's)
    held := n[0].inputs[d.ack % NET_HIST];
    n[0].fix = NetFix.{ok = true, ack = d.ack, x = w.x, y = w.y, z = w.z, yaw = w.yaw, vx = w.vx, vy = w.vy, vz = w.vz,
                       ground = (w.g & WG_GROUND) != 0, carry = w.carry, jump = held.seq == d.ack && held.input.jump};
    n[0].fix_due = true;
  }
}
// The effects the room says are on someone (WK_EFFECT rows) into out, as many as fit: who it is on
// (OWNER: WIRE_TGT_SEAT + SS a player), its WC_* bit, its cause (WE_*), and its seconds left by the
// newest tick heard (-1 held up until it goes). The count.
NetEffect :: struct { who: int; cond: int; cause: int; left: f32; }
net_effects :: (s: [] Everglade, out: [] NetEffect) -> int {
  if !net_live(s) { return 0; }
  n := net_of(s);
  m := 0;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_EFFECT || m >= out.count { continue; }
    left := ifx en.dur <= 0 then -1.0 else f32(hi_int(0, en.t0 + en.dur - n[0].mir[0].tick)) / f32(hi_int(n[0].hz, 1));
    out[m] = NetEffect.{who = en.owner, cond = en.p2, cause = en.p1, left = left}; m += 1;
  }
  return m;
}
// Watch actor i (a townsperson or guard) as the server has them now (f), interpolated; ok false while
// none is heard (indoors, out of view, or no room).
// since: seconds in their mode (from the row's T0: -1 not said); casting: seconds into a spell (-1
// none), kind its MS_*, foe the seat it is for (-1 none)
NetFolk :: struct { reference:Handle(EvergladeSpeaker); ok: bool; x: f32; z: f32; yaw: f32; mode: int; clip: int; hp: int; since: f32 = -1; casting: f32 = -1; kind: int; foe: int = -1; cond: int; rank: int; max: int; }   // rank: a responder's RANK_* + 1, 0 the town's
net_folk :: (s: [] Everglade, i: int) -> NetFolk {
  if !net_live(s) { return NetFolk.{}; }
  n := net_of(s);
  k := net_ent(n, NET_FOLK_ID + i, false);
  if k < 0 { return NetFolk.{}; }
  p := n[0].ents[k].shown;
  en := n[0].ents[k];
  hz := f32(hi_int(n[0].hz, 1)); now := n[0].mir[0].tick;
  return NetFolk.{reference=Handle(EvergladeSpeaker).{value=(cast(u64)en.generation<<32)|cast(u64)k}, ok = true, x = p.x, z = p.z, yaw = p.yaw, mode = p.f, clip = p.a, hp = en.hp, cond = en.cond, rank = en.form, max = en.max,
                  since = ifx en.t0 > 0 then f32(hi_int(now - en.t0, 0)) / hz else -1.0f32,
                  casting = ifx en.p2 > 0 && en.dur > 0 then f32(hi_int(now - en.dur, 0)) / hz else -1.0f32, kind = en.p2 - 1,
                  foe = ifx en.owner >= WIRE_TGT_SEAT && en.owner < WIRE_TGT_SEAT + 1000 then en.owner - WIRE_TGT_SEAT else -1};
}
// In a room whose server runs the town (it has said your WANTED level, w): its townsfolk and guards
// are the ones drawn, and the page's own watch is still (everglade-watch.coax watch_net_frame).
net_town :: (s: [] Everglade) -> bool { return net_live(s) && net_of(s)[0].wanted >= 0; }
// Your conditions' bits as the server has them (p's COND, WC_*), 0 with none heard.
net_cond :: (s: [] Everglade) -> int {
  if !net_live(s) { return 0; }
  n := net_of(s);
  k := net_ent(n, n[0].seat, false);
  return ifx k >= 0 then n[0].ents[k].p1 else 0;
}
net_wanted :: (s: [] Everglade) -> int { return ifx net_on(s) then hi_int(net_of(s)[0].wanted, 0) else 0; }
NetWhere :: struct { ok: bool; x: f32; y: f32; z: f32; }
// Where entity id is drawn (you where you are), its feet's world height.
net_where :: (s: [] Everglade, n: [] EgNet, id: int) -> NetWhere {
  if id == n[0].seat && s[0].started { return NetWhere.{ok = true, x = s[0].feet.x, y = s[0].feet.y + walk_at(s, s[0].feet.x, s[0].feet.z), z = s[0].feet.z}; }
  k := net_ent(n, id, false);
  if k < 0 { return NetWhere.{}; }
  p := n[0].ents[k].shown;
  y := ifx n[0].ents[k].kind == WK_FOLK then walk_at(s, p.x, p.z) else p.y;
  return NetWhere.{ok = true, x = p.x, y = y, z = p.z};
}

#test "net: tree tilt and fire age sample the pose clock at boundaries and between rows" {
  en: [1] NetEnt; en[0].kind = WK_TREE; en[0].ring_n = 2;
  en[0].ring[0] = NetState.{t = 100, x = 10, f = 1, a = 7, ax = -1, az = 0.2, age = 3};
  en[0].ring[1] = NetState.{t = 200, x = 20, f = 2, a = 7, ax = 1, az = -0.2, age = 5};
  times := [7] int.[25, 100, 125, 150, 175, 200, 250];
  tilt := [7] f32.[-1, -1, -0.5, 0, 0.5, 1, 1];
  for i: 0..<7 {
    pose := net_state_at(en[..], times[i]); p := net_forest_sample(en[..], pose);
    #assert abs(p.ax - tilt[i]) < 0.001 && abs(p.az + tilt[i] * 0.2) < 0.001 && abs(p.age - 4 - tilt[i]) < 0.001;
    #assert p.x == pose.x && p.y == pose.y && p.f == pose.f && p.a == pose.a;
  }
  en[0].kind = WK_PLAYER; p := NetState.{x = 10, ax = 9, age = 8};
  #assert net_forest_sample(en[..], p).ax == 9 && net_forest_sample(en[..], p).age == 8;
  en[0].kind = WK_TREE; en[0].ring_n = 0;
  #assert net_forest_sample(en[..], p).ax == 9;
}

// ---- your movement: the inputs out, the server's word back (the face runs the step)

// One step's input: kept and sent (I). Its sequence number, 0 when there is no room to send it to.
net_input :: (s: [] Everglade, input: EgMoveIn, dive: bool) -> int #export_c #effects(all) {
  if !net_open(s) { return 0; }
  n := net_of(s);
  n[0].seq += 1;
  n[0].stepping = n[0].seq;
  n[0].inputs[n[0].seq % NET_HIST] = NetInput.{seq = n[0].seq, input = input};
  a := ab_of(s);   // and your Levitate's rise and sink keys, for the server's (everglade_room_rise)
  b := (ifx input.run then WB_RUN else 0) | (ifx input.jump then WB_JUMP else 0) | (ifx dive then WB_DIVE else 0) |
       (ifx a[0].lev_on && a[0].lev_up then WB_RISE else 0) | (ifx a[0].lev_on && a[0].lev_sink then WB_SINK else 0);
  b|=input.link_flags;
  packet:=WireIn.{seq=n[0].seq,kx=wire_axis(input.key_x),ky=wire_axis(input.key_y),px=wire_axis(input.pad_x),py=wire_axis(input.pad_y),theta=input.theta,b=b,heard=n[0].mir[0].heard};
  net_send(n,ifx input.link_flags!=0 then wire_put_link_in(n[0].out[..],0,packet) else wire_put_in(n[0].out[..],0,packet));
  return n[0].seq;
}
// The server's word on you is new: where it has you after input fix.ack (the face sets you there and
// re-runs the later inputs, net_replay_*, then says how far that moved you, net_fixed).
net_fix_due :: (s: [] Everglade) -> bool #export_c #effects(all) { return net_open(s) && net_of(s)[0].fix_due && net_of(s)[0].fix.ok; }
net_fix :: (s: [] Everglade) -> NetFix #export_c #effects(all) { return net_of(s)[0].fix; }
// The inputs after the server's, oldest first: how many, and the k-th (as the wire carried it, so the
// re-run steps what the server steps). Only steps (I) count: a cast, an end or a rebuild takes a
// sequence number too, and the server steps nothing for it (a re-run of it as a still step moved you
// back of the server, and its next word pulled you on: #12731).
net_replay_n :: (s: [] Everglade) -> int #export_c #effects(all) {
  n := net_of(s);
  c := 0; first := n[0].fix.ack + 1; last := n[0].seq;
  for q: first..<last + 1 { if q > last - NET_HIST && n[0].inputs[q % NET_HIST].seq == q { c += 1; } }
  return c;
}
net_replay_input :: (s: [] Everglade, k: int) -> EgMoveIn #export_c #effects(all) {
  n := net_of(s);
  c := 0; first := n[0].fix.ack + 1; last := n[0].seq;
  for q: first..<last + 1 {
    if q <= last - NET_HIST || n[0].inputs[q % NET_HIST].seq != q { continue; }
    if c == k { n[0].stepping = q; return net_as_sent(s, n[0].inputs[q % NET_HIST].input); }
    c += 1;
  }
  return EgMoveIn.{};
}
// An input as the wire carries it (sticks in whole hundredths, the heading in WIRE_FINE units), so the
// page steps what the server steps; offline too, so a room walks where offline walks.
net_as_sent :: (s: [] Everglade, m: EgMoveIn) -> EgMoveIn #export_c #effects(all) {
  theta := f32(wire_fine(m.theta)) / f32(WIRE_FINE);
  return EgMoveIn.{key_x = f32(wire_axis(m.key_x)) / 100, key_y = f32(wire_axis(m.key_y)) / 100, pad_x = f32(wire_axis(m.pad_x)) / 100,
                   pad_y = f32(wire_axis(m.pad_y)) / 100, run = m.run, jump = m.jump, theta = theta,link_flags=m.link_flags};
}
// book:begin ease-correction
// The re-run is done: (dx, dy, dz) is where it puts you less where you were drawn. Small, it is eased
// out (you are drawn where you were, coming to where you are); past NET_SNAP m, taken at once.
net_fixed :: (s: [] Everglade, dx: f32, dy: f32, dz: f32) #export_c #effects(all) {
  n := net_of(s);
  n[0].fix_due = false; n[0].replays += 1;
  ox := n[0].off_x - dx; oy := n[0].off_y - dy; oz := n[0].off_z - dz;
  if abs(ox) + abs(oy) + abs(oz) > f32(NET_SNAP) { ox = 0; oy = 0; oz = 0; }
  n[0].off_x = ox; n[0].off_y = oy; n[0].off_z = oz;
}
// Where you are drawn less where you are, this frame (dt s): eased to nothing over NET_SMOOTH s.
net_offset :: (s: [] Everglade, dt: f32) -> Point #export_c #effects(all) {
  if !net_on(s) { return v3(0, 0, 0); }
  n := net_of(s);
  k := clamp01(1 - dt / f32(NET_SMOOTH));
  n[0].off_x *= k; n[0].off_y *= k; n[0].off_z *= k;
  if abs(n[0].off_x) + abs(n[0].off_y) + abs(n[0].off_z) < 0.001 { n[0].off_x = 0; n[0].off_y = 0; n[0].off_z = 0; }
  return v3(n[0].off_x, n[0].off_y, n[0].off_z);
}
// book:end ease-correction

// ---- each frame

// The seat ticket's ask: the path (?realm=: the directory places you, #12717), then a line, then the
// body: the name a guest asks for (everglade-join.coax)
net_ask_ticket :: (n: [] EgNet) {
  t: [192] u8;
  // a room from the realm's list, not one you were sent to: the realm, so the directory seats you
  // with your party while its room has a seat (everglade-party.coax, #12852)
  k := wire_put(t[..], 0, "/api/playtest/room-ticket/");
  k = wire_put(t[..], k, ifx jn_listed(n) then cast(string) n[0].realm[0..<n[0].realm_n] else cast(string) n[0].code[0..<n[0].code_n]);
  if n[0].realm_n > 0 { k = wire_put(t[..], k, "?realm="); k = wire_put(t[..], k, cast(string) n[0].realm[0..<n[0].realm_n]); }
  k = jn_ticket_with(n, t[..], k);   // the friend whose invite holds you a seat (everglade-join.coax, #12795)
  k = pt_ticket_with(n, t[..], k);   // the party member whose room you join (everglade-party.coax, #12911)
  // this page's build: the directory places it on a shard that runs it (#12839, migrations/0128_room_builds.sql)
  if n[0].realm_n > 0 { k = net_put_build(t[..], wire_put(t[..], k, "&build=")); }
  k = wire_put(t[..],k,ifx n[0].realm_n>0 then "&checkpoint=2" else "?checkpoint=2");
  k = wire_put(t[..], k, "\n"); k += jn_ticket_body(n, t[k..<t.count]);
  if pipe_put(n[0].pipe[..], NET_PIPE_TICKET, -1, cast(string) t[0..<k]) { n[0].ticket_asked = true; }
}
// While you play on the local host (#12882): the room's instance and a seat ticket asked for, on the
// room's address (n.away), and the socket moved to the room once the ticket is in and CHARACTER is done.
net_ask_room :: (s: [] Everglade, n: [] EgNet) {
  if !n[0].local_host || !n[0].asking { return; }
  if n[0].room_sock >= 0 || n[0].room_wait {
    if n[0].mono - n[0].room_at >= NET_OPEN_MS { net_room_failed(s, n); }
    return;
  }
  if n[0].ticket_n > 0 { if !n[0].join[0].hold && n[0].state == NET_OPEN { net_room_open(n); } return; }
  if n[0].ticket_asked || n[0].join[0].list_asked || n[0].mono <= 0 || n[0].mono < n[0].ask_at { return; }
  net_dest_swap(n);
  jn_step(s, n);
  if jn_ready(n) && !pt_holding(n) { net_ask_ticket(n); }   // a party link joins first (everglade-party.coax)
  net_dest_swap(n);
}

// The frame, from the face: the clock, the socket, a ping, the hello, the world where it is drawn,
// the casts at their time. (x, fy, z) your feet (fy over the floor you walk on, as the page's feet);
// the rest of your pose is the server's to say.
net_step :: (s: [] Everglade, mono: int, x: f32, fy: f32, z: f32, yaw: f32, vx: f32, vz: f32, air: bool, medium: int, boat: bool, act: int) #export_c #effects(all) {
  if !net_on(s) { return; }
  n := net_of(s);
  n[0].mono = mono;
  n[0].feet_y = fy;
  y := fy + walk_at(s, x, z);
  net_quiet(s, n, mono);
  net_reload(s, n);
  jn_step(s, n);   // no instance yet: the list asked for (everglade-join.coax)
  net_ask_room(s, n);   // on the local host: the room asked for a seat, and gone to when one comes
  pt_step(s, n);   // a friend's party link joined; the roster while PARTY is open (everglade-party.coax)
  if n[0].want && (n[0].state == NET_OFF || (n[0].state == NET_DOWN && mono >= n[0].retry)) && jn_ready(n) {
    // each open takes a fresh seat ticket (the room refuses a join without one): asked for, then used
    if n[0].ticket_n > 0 || n[0].local_host {
      u: [NET_URL + NET_TICKET + 9] u8;
      k := wire_put(u[..], 0, cast(string) n[0].url[0..<n[0].url_n]);
      if !n[0].local_host { k = wire_put(u[..], k, "?t="); k = wire_put(u[..], k, cast(string) n[0].ticket[0..<n[0].ticket_n]); }
      if n[0].lost { k = wire_put(u[..], k, ifx n[0].local_host then "?re=1" else "&re=1"); }   // a rejoin after the room was lost: the room counts it (room-stats.coax)
      if pipe_open(n[0].pipe[..], cast(string) u[0..<k]) { n[0].state = NET_OPENING; n[0].sock = -1; if !n[0].local_host { n[0].ticket_n = 0; } }
    } else if !n[0].ticket_asked && !pt_holding(n) {
      net_ask_ticket(n);
    }
  }
  net_save_state(s, n);
  if n[0].said_t > 0 { n[0].said_t -= 0.016; }
  now := net_now(n);
  if net_open(s) {
    if n[0].ping_at == 0 || mono - n[0].ping_at >= (ifx n[0].ping_n < 8 then 1000 else 10000) {
      m := wire_put(n[0].out[..], 0, "t"); m = wire_int(n[0].out[..], m, mono);
      net_send(n, m);
      n[0].ping_at = mono; n[0].ping_n += 1;
    }
    if n[0].hello_due { net_hello(s, n); }
  }
  // the world, a jitter buffer's delay behind the server clock
  dt := f32(clamp_i(mono - n[0].drawn_at, 0, 100)) / 1000; n[0].drawn_at = mono;
  n[0].lag = net_lag_step(n[0].lag, n[0].delay, n[0].ticks, dt);
  rt := now - cast(int) n[0].lag; n[0].rt = rt;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e..<e + 1];
    if !en[0].live || en[0].ring_n == 0 { continue; }
    p := net_forest_sample(en, net_state_at(en, rt));
    net_ease(en, p, rt, dt);
    p.x += en[0].ease_x; p.y += en[0].ease_y; p.z += en[0].ease_z;
    dx := p.x - en[0].shown.x; dz := p.z - en[0].shown.z;
    en[0].run += sqrt(dx * dx + dz * dz);
    // a townsperson on their day with the walk clip (watch_net_frame): drawn moving, or walking in place
    if en[0].kind == WK_FOLK && p.f == WM_CALM && p.a == 1 { n[0].folk_walk += 1; if dx * dx + dz * dz < 1.0e-8 { n[0].folk_still += 1; } }
    en[0].shown = p;
  }
  net_forest_frame(s, n);
  if net_open(s) && sp_on(s) { net_follow(s, n, now); }
  if net_open(s) { net_own_rg_frame(s, n); }
  // the casts, each at its time
  for q: 0..<NET_FX {
    fx := n[0].fx[q];
    // yours at once; another's when its caster is drawn at that time
    if !fx.live || (ifx fx.caster == n[0].seat then now else rt) < fx.t { continue; }
    n[0].fx[q].live = false;
    if !sp_on(s) { continue; }
    from := add(fx.at, v3(0, 2, 0));
    if fx.caster == n[0].seat { from = v3(x, y + 1.6, z); }
    else {
      k := net_ent(n, fx.caster, false);
      if k >= 0 { c := n[0].ents[k].shown; from = v3(c.x, c.y + 1.6, c.z); }
    }
    // the Warlock's (everglade-warlock.coax): its look, from the caster's hand
    // a Character Create class's slot 1 (everglade-classes.coax)
    if fx.slot >= CL_SLOT0 && fx.slot < CL_SLOT0 + CL_N { cl_play(s, fx.slot - CL_SLOT0, ifx fx.caster == n[0].seat then wl_hand(s) else sub(from, v3(0, 0.15, 0)), fx.at, fx.seed, fx.caster == n[0].seat); n[0].played += 1; continue; }
    if fx.slot >= WL_SLOT0 { wl_play(s, fx.slot - WL_SLOT0, ifx fx.caster == n[0].seat then wl_hand(s) else sub(from, v3(0, 0.15, 0)), fx.at, fx.seed, fx.caster == n[0].seat); n[0].played += 1; continue; }
    if fx.slot >= SP_SLOTS {
      // an ability the server runs in its caster's copy. One that lasts is its entity's alone
      // (net_follow, eg_ra_keep): its cast event is a cue and never plays it, or a toggle such as
      // Reverse Gravity would go up and down again in one frame (#12775). One that goes off once
      // is played by its event, by this page's copy of the caster, where the caster is drawn now.
      ak := fx.slot - SP_SLOTS;
      pose: [4] f32;
      if eg_ra_world(ak) && eg_ra_lasts(ak) { n[0].played += 1; continue; }
      if eg_ra_world(ak) && net_seat_pose(s, fx.caster, pose[..]) {
        c := v3(pose[0], pose[1], pose[2]);
        eg_ra_play(s, fx.caster, ak, c, eg_ra_facing(c, fx.at, pose[3]), fx.at, fx.mode);
      } else { net_flash(s, ak, fx.at); }
      n[0].played += 1; continue;
    }
    net_play(s, fx.slot, from, fx.at, fx.seed);
    n[0].played += 1;
  }
}
net_hello :: (s: [] Everglade, n: [] EgNet) {
  n[0].hello_due = false;
  look := ifx n[0].look_n > 0 then cast(string) n[0].look[0..<n[0].look_n] else "ranger.0.0.0";
  net_send(n, wire_put_pins(n[0].out[..], 0, WirePins.{}));   // this page's build, which the room admits the hello against (#12839)
  hello:=wire_hello_value(WireHello.{look = look, kind = cl_kind(s), flags = (ifx s[0].touch then 1 else 0) | (ifx n[0].account then 2 else 0) | (ifx ege_demo(s) then EGE_DEMO_FLAG else 0) | (ifx cz_creating(s) then EZ_GLADE_FLAG else 0), name = ""});   // at Character Create the room seats you at the glade's clearing (everglade-create.coax)
  net_send(n, wire_put_hello_value(n[0].out[..], 0, hello));
  md_send_blocks(n);   // who you block: the room sends you nothing of them (#12789)
}
// Your intents: a cast from bar slot b at the aim (target an entity, -1 none), the end of what slot b
// holds up, the town rebuilt. False when there is no room to send them to.
net_cast :: (s: [] Everglade, b: int, at: Point, target: int) -> bool #export_c #effects(all) {
  if !net_open(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  // aimed at (or by) a server creature, the cast names it: the server aims it where the creature is
  tgt := ifx target >= 0 then target else net_creature_at(n, at, NET_PICK);
  // with the spell's mode as you have it picked (Elementalism's element, Create or Destroy Water)
  mode := ifx b >= SP_SLOTS && b < SP_SLOTS + AB_N then eg_ra_mode(s, b - SP_SLOTS) else 0;
  // the server's line of sight, predicted: a cast your page sees is blocked never goes (#12790)
  if s[0].started && !eg_ra_copying(s) && !cr_sight(s, ab_you(s), at) { cr_refused(s, b, CR_SIGHT); return false; }
  net_send(n, wire_put_cast(n[0].out[..], 0, WireCast.{seq = n[0].seq, slot = b, ax = at.x, ay = at.y, az = at.z, tgt = tgt, mode = mode}));
  n[0].mine_seq[n[0].mine_at] = n[0].seq; n[0].mine_slot[n[0].mine_at] = b; n[0].mine_at = (n[0].mine_at + 1) % NET_MINE;
  return true;
}
// The TGT code (2000 + EID) of the summoned creature nearest the point within `reach` m, -1 none.
NET_PICK :: 1.6;
// Whether a creature's P1 is one of the town's watch in the siege (a Guard to a Scout: room-events.coax
// e5rd_defender), on your side.
net_watch_form :: (p1: int) -> bool { return (p1 > EGE_FORM_RAID && p1 <= EGE_FORM_RAID + 4) || p1 == EGE_FORM_HERO; }
net_creature_at :: (n: [] EgNet, at: Point, reach: f32) -> int {
  best := -1; bd := reach * reach;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_BEAST || en.ring_n == 0 || en.hp <= 0 || net_watch_form(en.p1) { continue; }   // never the town's watch (#12860)
    dx := en.shown.x - at.x; dz := en.shown.z - at.z;
    d := dx * dx + dz * dz;
    if d <= bd { bd = d; best = 2000 + en.eid - NET_MADE_ID; }
  }
  return best;
}
net_end :: (s: [] Everglade, b: int) -> bool {
  if !net_open(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = n[0].seq, kind = WE_END, id = b}));
  return true;
}
// The room's complete held forest state replaces local guesses, including acknowledged removals.
// The clock used by fire drawing is retained; no damage, spread or tree physics runs here.
net_forest_frame :: (s: [] Everglade, n: [] EgNet) {
  if !net_live(s) || s[0].tree_n <= 0 { return; }
  tf_restore(s);
  v := tf_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_TREE || en.ring_n == 0 { continue; }
    slot := en.eid - FOREST_EID;
    p := en.shown; t := p.a;
    if slot < 1 || slot >= FOREST_RECORDS || t < 0 || t >= s[0].tree_n { continue; }
    row := [FOREST_FLOATS] f32.[f32(t), p.x, p.y, p.z, f32(p.f), p.ax, p.az,
      f32(en.t0) / 1000, f32(en.dur) / 1000, f32(en.hp) / 1000, f32(en.max) / 1000,
      f32(en.temp) / 1000, f32(en.cond), f32(en.owner), p.age, f32(en.form) / 1000];
    if !forest_valid(row[..]) || !tf_own(s, t) { continue; }
    k := tf_k(s, t);
    v[0].mode[k] = p.f; v[0].ax[k] = p.ax; v[0].az[k] = p.az;
    v[0].ox[k] = p.x - s[0].trees[t * TREE_FLOATS]; v[0].oy[k] = p.y; v[0].oz[k] = p.z - s[0].trees[t * TREE_FLOATS + 1];
    v[0].pivot[k] = row[7]; v[0].rest[k] = row[8];
    v[0].soot[k] = row[9]; v[0].bare[k] = row[10]; v[0].frost[k] = row[11]; v[0].touched = true;
    if en.cond == 1 && v[0].n < TF_BURN {
      v[0].burn[v[0].n] = TfBurn.{tree = t, by = en.owner, t = p.age, out = row[15]};
      v[0].n += 1;
    }
  }
}
// E on door i: the room opens or shuts it for every seat (WE_DOOR, everglade-doors.coax). False
// when the socket is down.
net_door :: (s: [] Everglade, i: int) -> bool {
  if !net_open(s) || i < 0 || i >= WIRE_DOOR_WORD * WIRE_DOOR_WORDS { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = n[0].seq, kind = WE_DOOR, id = i}));
  return true;
}
// E at rowboat i (its float; -1 out of yours): the room seats you in it or takes you out (WE_BOAT,
// #12861). False when the socket is down.
net_boat :: (s: [] Everglade, i: int) -> bool {
  if !net_open(s) || i < -1 || i >= 999 { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = n[0].seq, kind = WE_BOAT, id = i}));
  return true;
}
// Talking to townsperson i (-1: done): the room stops them and turns them to you on every page.
net_talk :: (s: [] Everglade, i: int) -> bool {
  if !net_open(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = n[0].seq, kind = WE_TALK, id = i}));
  return true;
}
// Word w of the doors the room has open (its WK_DOORS row): -1 while none is heard (offline, or before
// the room's first word).
net_doors :: (s: [] Everglade, w: int) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if en.live && en.kind == WK_DOORS { return ifx w == 0 then en.p1 else en.p2; }
  }
  return -1;
}
// Whether the room has the town's gates shut (its WK_DOORS row's FORM, #12794): 1 shut, 0 open, -1
// while none is heard.
net_gates :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if en.live && en.kind == WK_DOORS { return en.form; }
  }
  return -1;
}
// The n-th rowboat the room has (its WK_BOAT row, #12861), for the face to put on your river: false
// none heard. out: the float, who rows it (a seat + 1, 0 moored; you: -1, your own page rows it),
// x y z yaw, the oars' share (-1 shipped). Where it is drawn now (the jitter buffer's), so another's
// rower, drawn at the same time (net_boat_by), sits in it.
net_boat_row :: (s: [] Everglade, b: int, out: [] f32) -> bool #export_c #effects(all) {
  if !net_live(s) || out.count < 7 { return false; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_BOAT || en.eid != NET_MADE_ID + WIRE_BOAT_EID + b || en.ring_n == 0 { continue; }
    st := en.shown;
    out[0] = f32(en.p1);
    out[1] = ifx en.owner < 0 then 0.0f32 else ifx en.owner == n[0].seat then -1.0f32 else f32(en.owner + 1);
    out[2] = st.x; out[3] = st.y; out[4] = st.z; out[5] = st.yaw;
    out[6] = ifx en.p2 < 0 then -1.0f32 else f32(en.p2) / 1000;
    return true;
  }
  return false;
}
// Whether the room refused your board of rowboat float F (#12861): your page seats you at once, and
// the room's row of that boat must name you its rower within NET_BOARD_WAIT s of it (WAITED s since);
// else another seat took it the same tick, or it was out of the room's reach, and you step ashore.
NET_BOARD_WAIT :: 2.0;
net_boat_refused :: (s: [] Everglade, f: int, waited: f32) -> bool #export_c #effects(all) {
  if !net_live(s) || f < 0 || !(waited > NET_BOARD_WAIT) { return false; }
  br: [7] f32;
  for b: 0..<NET_BOATS { if net_boat_row(s, b, br[..]) && cast(int) br[0] == f { return br[1] >= 0; } }
  return false;   // no row of it heard: nothing to say it isn't yours
}
NET_BOATS :: 3;   // the rows the room sends (room-everglade.coax EG_BOATS)
// The rowboat seat SEAT rows, as drawn now (its WK_BOAT row's OWNER, #12861): ok false when none.
// Another player in a boat (WG_BOAT) is drawn on its thwart (everglade-rangers.coax remote_bodies).
NetBoat :: struct { ok: bool; x: f32; y: f32; z: f32; yaw: f32; }
net_boat_by :: (s: [] Everglade, seat: int) -> NetBoat {
  if !net_live(s) || seat < 0 { return NetBoat.{}; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_BOAT || en.owner != seat || en.ring_n == 0 { continue; }
    return NetBoat.{ok = true, x = en.shown.x, y = en.shown.y, z = en.shown.z, yaw = en.shown.yaw};
  }
  return NetBoat.{};
}
net_rebuild :: (s: [] Everglade) -> bool {
  if !net_open(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_rebuild(n[0].out[..], 0, n[0].seq));
  return true;
}
// Travel to the instance `code` of this realm, asked of the room (#12850, coax/web/room/room-travel.coax):
// the room sets you aside a seat there and answers "g CODE" (net_go), or refuses with r. False offline.
net_travel :: (s: [] Everglade, code: string) -> bool #export_c #effects(all) {
  if !net_open(s) || !net_code_ok(code) { return false; }
  n := net_of(s);
  if code == cast(string) n[0].code[0..<n[0].code_n] { return false; }
  n[0].seq += 1;
  net_send(n, wire_put_travel(n[0].out[..], 0, n[0].seq, code));
  return true;
}
// "g CODE": the room sent you to the instance CODE. The page leaves this socket, asks the API for a
// ticket for CODE, and joins it at once; the room's seat for you ends with the close.
net_go :: (s: [] Everglade, n: [] EgNet, code: string) {
  if !net_code_ok(code) || n[0].local_host { return; }
  jn_code(n, code); n[0].join[0].named = true;
  n[0].ticket_n = 0; n[0].ticket_asked = false;
  jn_url(n);
  _ := pipe_close(n[0].pipe[..], n[0].sock);
  net_down(n);
  n[0].retry = 0; n[0].tries = 0; n[0].lost = false;
  b: [64] u8; k := wire_put(b[..], 0, "TRAVELLING TO ");
  for ch: code { if k >= b.count { break; } b[k] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; k += 1; }
  net_tell(s, n, cast(string) b[0..<k]);
}
// A Long Rest, asked of the room (everglade-events.coax eg_r_mode): false offline.
net_rest :: (s: [] Everglade) -> bool {
  if !net_live(s) { return false; }
  n := net_of(s);
  n[0].seq += 1;
  net_send(n, wire_put_rest(n[0].out[..], 0, n[0].seq));
  return true;
}
// The ability (AB_*) a kind of entity of yours stands for, -1 none: what slot it holds up.
net_ability_of :: (en: NetEnt) -> int {
  if en.kind == WK_PACK { return AB_CONJURE; }
  if en.kind == WK_STONE { return AB_STONE; }
  if en.kind == WK_TENTACLES { return AB_TENTACLES; }
  if en.kind == WK_THORNS { return AB_THORNS; }
  if en.kind == WK_LINE || en.kind == WK_ZONE { return en.p1; }
  if en.kind == WK_FROG { return AB_POLYMORPH; }
  return -1;
}
// Whether the server holds up something of yours from ability k (its slot shows as on).
net_holds :: (s: [] Everglade, k: int) -> bool {
  if !net_live(s) { return false; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if en.live && en.owner == n[0].seat && net_ability_of(en) == k { return true; }
  }
  return false;
}
// Abilities that change only you yourself (how you move, breathe, what shape you have, what you
// hear): your page runs them, so your movement predicts. Every other one is the server's.
net_self_ability :: (k: int) -> bool {
  return k == AB_LEVITATE || k == AB_FEATHER || k == AB_WWALK || k == AB_BREATH || k == AB_SHAPECHANGE || k == AB_SPEAK;
}
net_stacks :: (k: int) -> bool { return k == AB_WIND || k == AB_STONE; }
// Levitate and Feather Fall, yours: this page runs them as you press (so your feet answer at once) and
// the room's server runs them too, for where it has you (everglade-room-abilities.coax eg_ra_runs):
// up goes as a cast where you stand, down as its end.
net_mirror :: (s: [] Everglade, k: int, on: bool) {
  if !net_open(s) || eg_ra_copying(s) { return; }
  b := SP_SLOTS + k;
  if on { _ := net_cast(s, b, ab_you(s), -1); } else { _ := net_end(s, b); }
}
net_shared :: (s: [] Everglade, k: int) -> bool { return net_live(s) && !net_self_ability(k) && !eg_ra_copying(s); }   // (a seat's copy casts its own: everglade-room-abilities.coax)
// A press on a shared ability's slot (everglade-abilities.coax ab_press) with a room to send it to:
// what it holds up ends (E); one you point with is picked or put away; any other goes out as a cast
// where you stand, facing as you face.
net_press :: (s: [] Everglade, k: int) {
  b := SP_SLOTS + k;
  n := net_of(s);
  // your Reverse Gravity held up as the page predicts it, before the room's word of it comes
  rg_up := k == AB_REVERSE && n[0].rg_open > 0 && n[0].rg_close == 0;
  // (a Wind Wall or a Wall of Stone pressed again raises another, as offline: they stack, and fall at their time)
  if (rg_up || net_holds(s, k) || net_own_shows(s, k)) && !net_stacks(k) && (s[0].sp.armed == b || !ab_aimed(k)) {
    if net_end(s, b) {
      if rg_up { n[0].rg_close = n[0].seq; }
      net_own_end(s, k);
    }
    s[0].sp.armed = -1;
    return;
  }
  if ab_aimed(k) { s[0].sp.armed = ifx s[0].sp.armed == b then -1 else b; return; }
  s[0].sp.armed = -1;
  you := ab_you(s);
  if net_cast(s, b, add(you, times(ab_forward(s), 2)), -1) {
    if k == AB_REVERSE {
      // where the room's copy opens it: on the floor under you (everglade-abilities.coax ab_rg_open)
      n[0].rg_open = n[0].seq; n[0].rg_close = 0; n[0].rg_heard = false; n[0].rg_at = v3(you.x, walk_at(s, you.x, you.z), you.z);
    }
    net_own_show(s, k);
  }
}
// Your own Reverse Gravity, Wind Wall and Wall of Stone show at your press, as they do offline: your
// seat's copy (everglade-room-abilities.coax) casts it where you stand, and the room's entity for it
// is taken as that cast when it comes, a round trip and the jitter buffer later (#12887). Until then
// your copy holds it up; a cast the room never raised ends once the room has stepped NET_RG_LOST
// inputs past it. Their saves, lifts and harm stay the room's, as from the entity.
net_own_predicts :: (k: int) -> bool { return k == AB_REVERSE || k == AB_WIND || k == AB_STONE; }
net_own_show :: (s: [] Everglade, k: int) {
  if !net_own_predicts(k) || !net_live(s) || eg_ra_copying(s) { return; }
  n := net_of(s);
  q := n[0].seat;
  if q < 0 || q >= EG_RA_SEATS { return; }
  you := ab_you(s);
  c := s[0].sp.room_ab[0].seat[q..<q + 1];
  n[0].own_was[k] = c[0].heard[k]; n[0].own_pend[k] = n[0].seq; n[0].own_gone[k] = false;
  eg_ra_play(s, q, k, you, s[0].face, add(you, times(v3(sin(s[0].face), 0, cos(s[0].face)), 2)), eg_ra_mode(s, k));
}
// Whether your copy holds ability k up from a press the room hasn't answered yet.
net_own_shows :: (s: [] Everglade, k: int) -> bool {
  if !net_live(s) || k < 0 || k >= AB_N { return false; }
  n := net_of(s);
  q := n[0].seat;
  return n[0].own_pend[k] > 0 && q >= 0 && q < EG_RA_SEATS && s[0].sp.room_ab[0].seat[q].live[k];
}
// Your end of ability k (its E sent): your copy ends it now, not when the room's entity goes.
net_own_end :: (s: [] Everglade, k: int) {
  if !net_own_predicts(k) || !net_live(s) || eg_ra_copying(s) { return; }
  n := net_of(s);
  q := n[0].seat;
  if q < 0 || q >= EG_RA_SEATS { return; }
  c := s[0].sp.room_ab[0].seat[q..<q + 1];
  if n[0].own_pend[k] > 0 { n[0].own_gone[k] = true; }
  n[0].own_pend[k] = 0;
  if c[0].used && c[0].live[k] {
    was := eg_ra_in(s, q, ab_you(s), s[0].face);
    if was.ok { eg_ra_drop(s, k); eg_ra_out(s, q, was); }
  }
}
// net_follow's word on your ability k with the room's entity id (0 none): true when it is settled
// here (a press's cast waiting for its entity, or taking it), so the entity isn't kept to as another's.
net_own_follow :: (s: [] Everglade, n: [] EgNet, k: int, id: int) -> bool {
  if !net_own_predicts(k) { return false; }
  q := n[0].seat;
  c := s[0].sp.room_ab[0].seat[q..<q + 1];
  // ended before its entity came: that entity isn't raised here; once it goes, nothing is left
  if n[0].own_gone[k] {
    if id == 0 || id != n[0].own_was[k] { c[0].heard[k] = id; }
    if id == 0 { n[0].own_gone[k] = false; }
    return true;
  }
  if n[0].own_pend[k] <= 0 { return false; }
  // the press's entity came: it is this cast, already up here
  if id != 0 && id != n[0].own_was[k] { c[0].heard[k] = id; n[0].own_pend[k] = 0; return true; }
  // the room never raised it: it ends here too
  if n[0].acked > n[0].own_pend[k] + NET_RG_LOST {
    n[0].own_pend[k] = 0;
    if c[0].used && c[0].live[k] && id == 0 {
      was := eg_ra_in(s, q, ab_you(s), s[0].face);
      if was.ok { eg_ra_drop(s, k); eg_ra_out(s, q, was); }
    }
    return false;
  }
  return true;
}
// Your Reverse Gravity for the input being stepped (net_stepping): on when it is after the cast and
// before the end. Where the room's word of it is gone (it ended without your end: its time ran
// out, you lost concentration), it ends at the last input the room stepped; a cast the room never
// raised is forgotten once the room has stepped NET_RG_LOST inputs past it.
NET_RG_LOST :: 60;
NetOwnRg :: struct { on: bool; at: Point; }
net_own_rg :: (s: [] Everglade) -> NetOwnRg {
  if !net_live(s) || eg_ra_copying(s) { return NetOwnRg.{}; }
  n := net_of(s);
  if n[0].rg_open <= 0 { return NetOwnRg.{}; }
  q := n[0].stepping;
  return NetOwnRg.{on = q > n[0].rg_open && (n[0].rg_close == 0 || q < n[0].rg_close), at = n[0].rg_at};
}
// Whether the page predicts your Reverse Gravity (then the room's copy of yours lifts no one here).
net_owns_rg :: (s: [] Everglade) -> bool { return net_live(s) && net_of(s)[0].rg_open > 0; }
// Each frame: your Reverse Gravity's prediction kept to the room's word of it.
net_own_rg_frame :: (s: [] Everglade, n: [] EgNet) {
  if n[0].rg_open <= 0 { return; }
  held := net_holds(s, AB_REVERSE);
  if held { n[0].rg_heard = true; return; }
  if n[0].rg_heard && n[0].rg_close == 0 { n[0].rg_close = n[0].acked + 1; }
  if !n[0].rg_heard && n[0].acked > n[0].rg_open + NET_RG_LOST { n[0].rg_open = 0; n[0].rg_close = 0; }
  // ended and gone: nothing left to predict once the room has stepped past the end
  if n[0].rg_heard && n[0].rg_close > 0 && n[0].acked >= n[0].rg_close { n[0].rg_open = 0; n[0].rg_close = 0; }
}

// ---- the server's spell effects on this page

// What the server's abilities hold up that this page feels and draws as its own would be (everglade-
// room-abilities.coax): Reverse Gravity's cylinder, from its entity. Its saves, lifts and crimes stay
// the server's; your movement predicts its lift (everglade_lift), its debris rises here.
net_follow :: (s: [] Everglade, n: [] EgNet, now: int) {
  // each seat's abilities as the server's entities have them (room-abilities.coax ra_table: the
  // caster's place, or the aim, and its facing): this page's copies kept to them
  id: [EG_RA_SEATS * AB_N] int; at: [EG_RA_SEATS * AB_N] Point; face: [EG_RA_SEATS * AB_N] f32; mode: [EG_RA_SEATS * AB_N] int;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.ring_n == 0 || en.kind != WK_ZONE || en.eid - NET_MADE_ID < NET_ABILITY_ID { continue; }
    if en.owner < 0 || en.owner >= EG_RA_SEATS || en.p1 < 0 || en.p1 >= AB_N { continue; }
    q := en.owner * AB_N + en.p1;
    id[q] = en.eid; at[q] = v3(en.shown.x, en.shown.y, en.shown.z); face[q] = en.shown.yaw;
    mode[q] = ifx en.p1 == AB_ELEMENTS || en.p1 == AB_CREATE then en.p2 else 0;   // its mode (room-abilities.coax ra_table)
  }
  pose: [4] f32;
  for o: 0..<EG_RA_SEATS {
    seated := net_seat_pose(s, o, pose[..]);
    for k: 0..<AB_N {
      q := o * AB_N + k;
      if o == n[0].seat && net_own_follow(s, n, k, id[q]) { continue; }   // yours, shown at your press
      if id[q] == 0 && s[0].sp.room_ab[0].seat[o].heard[k] == 0 { continue; }
      // the caster where this page draws them, else where the server has the cast
      c := ifx seated then v3(pose[0], pose[1], pose[2]) else at[q];
      eg_ra_keep(s, o, k, id[q], at[q], face[q], c, ifx seated then pose[3] else face[q], mode[q]);
    }
  }
}
NET_ABILITY_ID :: 900000;   // the seats' abilities' entities' ids, from (room-abilities.coax RA_ID0)
// Where seat q stands (world feet) and faces, as this page draws it: X Y Z YAW. Yours is where you are.
net_seat_pose :: (s: [] Everglade, q: int, out: [] f32) -> bool {
  if !net_live(s) || out.count < 4 || q < 0 { return false; }
  n := net_of(s);
  if q == n[0].seat { y := ab_you(s); out[0] = y.x; out[1] = y.y; out[2] = y.z; out[3] = s[0].face; return true; }
  k := net_ent(n, q, false);
  if k < 0 || n[0].ents[k].ring_n == 0 { return false; }
  p := n[0].ents[k].shown;
  out[0] = p.x; out[1] = p.y; out[2] = p.z; out[3] = p.yaw;
  return true;
}
// How high over their feet the server has townsperson i (Reverse Gravity's lift), m.
net_air :: (s: [] Everglade, i: int) -> f32 {
  if !net_town(s) || i < 0 || i >= WATCH_ACTORS { return 0; }
  n := net_of(s);
  k := net_ent(n, NET_FOLK_ID + i, false);
  return ifx k >= 0 then hi(n[0].ents[k].shown.y, 0) else 0.0f32;
}

// An aimed spell's effect (meteors, a bolt, the orb), played from the server's seed: its look alone
// (everglade-spells.coax sp_blast_look). What it harms and breaks the server says.
net_play :: (s: [] Everglade, slot: int, from: Point, at: Point, seed: int) {
  was_at := s[0].sp.cast_at; was_n := s[0].sp.cast_n; was_from := s[0].sp.cast_from; was_seed := s[0].sp.cast_seed;
  was_dmg := s[0].sp.dmg; was_broke := s[0].sp.broke; was_pushed := s[0].sp.pushed;
  s[0].sp.cast_at = at; s[0].sp.cast_n = v3(0, 1, 0); s[0].sp.cast_from = from; s[0].sp.cast_seed = cast(u64) hi_int(seed, 1);
  s[0].sp.remote = true;
  sp_release(s, slot);
  s[0].sp.remote = false;
  s[0].sp.cast_at = was_at; s[0].sp.cast_n = was_n; s[0].sp.cast_from = was_from; s[0].sp.cast_seed = was_seed;
  s[0].sp.dmg = was_dmg; s[0].sp.broke = was_broke; s[0].sp.pushed = was_pushed;
}
net_tint :: (k: int) -> Point {
  if k == AB_REVERSE || k == AB_TK || k == AB_POLYMORPH || k == AB_SHAPECHANGE { return v3(0.76, 0.62, 1.0); }
  if k == AB_WALLFIRE || k == AB_FIRESTORM || k == AB_FLAME || k == AB_SUNBURST || k == AB_SUNBEAM { return v3(1.0, 0.55, 0.2); }
  if k == AB_KNIFE || k == AB_STORM || k == AB_SLEET || k == AB_RAYFROST || k == AB_CONE || k == AB_FOG { return v3(0.65, 0.85, 1.0); }
  if k == AB_CALL || k == AB_VENGEANCE || k == AB_THUNDER { return v3(0.72, 0.8, 1.0); }
  if k == AB_MOON { return v3(0.85, 0.9, 1.0); }
  if k == AB_HEALING || k == AB_MASSCURE || k == AB_RESURGENCE { return v3(0.55, 1.0, 0.5); }
  if k == AB_CONJURE || k == AB_ENTANGLE || k == AB_SPIKE || k == AB_THORNS { return v3(0.45, 0.95, 0.6); }
  if k == AB_FAERIE { return v3(0.9, 0.5, 1.0); }
  if k == AB_CONTROL || k == AB_CREATE || k == AB_WWALK || k == AB_BREATH { return v3(0.4, 0.7, 1.0); }
  return v3(0.85, 0.85, 0.75);
}
// An ability's effect: a flash of its light at the aim (what it leaves comes as entities).
net_flash :: (s: [] Everglade, k: int, at: Point) {
  if !sp_on(s) || !finite(at.x) || !finite(at.z) { return; }
  c := net_tint(k);
  g := v3(at.x, hi(at.y, ground_at(s, at.x, at.z)) + 0.1, at.z);
  egs_hit(s, egs_ab_look(k), g, 0);   // everglade-sound.coax
  sp_burst(s, add(g, v3(0, 0.5, 0)), v3(0, 1, 0), ifx phone(s) then 14 else 26, 5, 0.9, 0.04, c, times(c, 0.5), -0.6);
  sp_add_shock(s, g, 4.0, 0.6, c);
}

// ---- drawing the server's creatures and zones (everglade-spells.coax spells_frame, after ab_draw)

net_draw :: (s: [] Everglade) {
  if !net_on(s) || !sp_on(s) { return; }
  n := net_of(s);
  now := net_now(n);
  few := phone(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.ring_n == 0 { continue; }
    age := f32(now - en.born) / 1000;
    // what a seat's copy draws its own way (everglade-room-abilities.coax eg_ra_draws)
    if eg_ra_drawn(s, en.owner, net_ability_of(en)) || (en.kind == WK_ZONE && en.eid - NET_MADE_ID >= NET_ABILITY_ID) { continue; }
    if en.kind == WK_PACK { net_draw_pack(s, en, age); }
    else if en.kind == WK_STONE { net_draw_stone(s, en, age); }
    else if en.kind == WK_TENTACLES { net_draw_tentacles(s, en, age); }
    else if en.kind == WK_THORNS { net_draw_thorns(s, en, age, few); }
    else if en.kind == WK_ZONE { net_draw_zone(s, en, age); }
    else if en.kind == WK_LINE { net_draw_line(s, en, age); }
    // a summoned creature is a beast of flesh now (the room's battle has its stat block), not a spirit
    else if en.kind == WK_BEAST && en.p1 >= EGE_FORM_RAID { ege_raider_draw(s, n, en, age); }   // the raid's (everglade-events.coax)
    else if en.kind == WK_BEAST && en.p1 == WL_FORM_ZOMBIE { wl_zombie(s, en.eid, v3(en.shown.x, en.shown.y, en.shown.z), en.shown.yaw, en.run, ifx abs(en.shown.vx) + abs(en.shown.vz) > 0.2 then 1.0f32 else 0.0f32, clamp(age / 1.2, 0, 1)); }
    else if en.kind == WK_BEAST { ci_beast(s, clamp_i(en.p1, 1, CI_FORMS - 1), v3(en.shown.x, en.shown.y, en.shown.z), en.shown.yaw, en.run, ifx abs(en.shown.vx) + abs(en.shown.vz) > 0.2 then 1.0f32 else 0.0f32, false, clamp(age / 0.6, 0, 1)); }
  }
}
// Each summoned creature's Hit Points as a bar over it (red on a dark track), once it is near
// enough to see: its share of P2, its most.
NET_BEAST_HEAD :: 1.25;    // m over a wolf's feet
NET_BAR_NEAR :: 40.0;      // m
net_bars :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  n := at;
  if !net_live(s) || !sp_on(s) || s[0].above { return n; }
  nt := net_of(s);
  k := hi(s[0].dpr, 0.5);
  you := ab_you(s);
  for e: 0..<NET_ENTS {
    en := nt[0].ents[e];
    if !en.live || en.kind != WK_BEAST || en.ring_n == 0 || en.max <= 0 { continue; }
    p := v3(en.shown.x, en.shown.y + NET_BEAST_HEAD * (ifx en.p1 >= EGE_FORM_RAID then (ifx en.p1 == EGE_FORM_WARD then 2.9f32 else 1.75f32) else ifx en.p1 == CI_FORM_BEAR then 1.35f32 else ifx en.p1 == CI_FORM_MAMMOTH then 2.5f32 else 1.0f32), en.shown.z);
    gap := flat_gap(p, you);
    if gap > f32(NET_BAR_NEAR) { continue; }
    sc := on_screen(u, p, s[0].width, s[0].height);
    if !sc.ok { continue; }
    far := clamp01(1 - gap / f32(NET_BAR_NEAR));
    half := (18 + 14 * far) * k;
    share := clamp01(f32(en.hp) / f32(en.max));
    if lit(out, n, sc.x - half, sc.y, sc.x + half, sc.y, 2.5 * k, 0.3, 0.4 * k, 0.1, 0.08, 0.07, 0) { n += 6; }
    // the town's watch on your side in gold, every foe in red (#12860)
    ally := net_watch_form(en.p1);
    if share > 0 && lit(out, n, sc.x - half, sc.y, sc.x - half + 2 * half * share, sc.y, 2.5 * k, 0.95, 1.4 * k, ifx ally then GOLD_R else WATCH_RED_R, ifx ally then GOLD_G else WATCH_RED_G, ifx ally then GOLD_B else WATCH_RED_B, 0) { n += 6; }
  }
  return n;
}
// Conjure Animals' pack: four spectral wolves pacing their small rounds about its middle (ci_wolf's).
net_draw_pack :: (s: [] Everglade, en: NetEnt, t: f32) {
  on := clamp(t / 0.8, 0, 1);
  p := en.shown;
  middle := v3(p.x, ground_at(s, p.x, p.z), p.z);
  for q: 0..<CI_WOLVES {
    base := f32(TAU) * f32(q) / f32(CI_WOLVES) + 0.4;
    turn := t * (0.35 + 0.08 * f32(q)) * (ifx q % 2 == 0 then 1.0f32 else -1.0f32);
    r := 0.75 + 0.25 * sin(t * 0.7 + f32(q) * 1.7);
    a := base + turn;
    at := add(middle, v3(cos(a) * r, 0, sin(a) * r));
    at.y = ground_at(s, at.x, at.z);
    side := ifx q % 2 == 0 then 1.0f32 else -1.0f32;
    face := ifx p.f != 0 then p.yaw else atan2(-sin(a) * side, cos(a) * side);
    ci_beast(s, CI_FORM_WOLF, at, face, en.run + t * 0.9 * r + f32(q) * 0.37, 1, true, on);
  }
  if sp_rand(s) < 0.4 {
    a := f32(TAU) * sp_rand(s); r := f32(CI_CA_HALF) * sp_rand(s);
    sp_add_spark(s, add(middle, v3(cos(a) * r, 0.3 + 0.6 * sp_rand(s), sin(a) * r)), v3(0, 0.5, 0), 0.8, 0.02, times(CI_SPIRIT_RGB, 1.2), -0.2);
  }
}
// A Wall of Stone's two panels, rising as ab_draw's.
net_draw_stone :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  half := ifx en.p2 > 0 then f32(en.p2) / 200 else f32(AB_ST_PANEL);
  sx := sin(p.yaw) * half; sz := cos(p.yaw) * half;
  ax := p.x - sx; az := p.z - sz; bx := p.x + sx; bz := p.z + sz;
  base := ground_at(s, p.x, p.z);
  rise := clamp(t / 0.35, 0, 1);
  hh := f32(AB_ST_PANEL) * 0.5;
  ex := (bx - ax) * 0.25; ez := (bz - az) * 0.25;
  l := hi(sqrt(ex * ex + ez * ez), 0.01);
  nn := v3(-ez / l * f32(AB_ST_THICK) * 0.5, 0, ex / l * f32(AB_ST_THICK) * 0.5);
  for q: 0..<2 {
    left := ifx q == 0 then en.hp else en.p1;
    if left <= 0 { continue; }
    c := v3(ax + ex * f32(1 + 2 * q), base + hh * (2 * rise - 1) - 0.02, az + ez * f32(1 + 2 * q));
    tone := (0.46 + 0.05 * f32(q)) * (0.7 + 0.3 * f32(left) / f32(AB_ST_HP));
    sp_shape(s, SHAPE_BOX, LOOK_STONE, c, v3(ex * 1.99, 0, ez * 1.99), v3(0, 2 * hh, 0), times(nn, 2), v3(tone, tone * 0.96, tone * 0.9));
  }
}
// Black Tentacles: nine on a 3 by 3 grid over its square, writhing.
net_draw_tentacles :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  side := ifx en.p2 > 0 then f32(en.p2) / 100 else f32(AB_BT_SIDE);
  grow := clamp(t / 0.6, 0, 1);
  seg := f32(AB_BT_LEN) / f32(AB_BT_SEG) * grow;
  for j: 0..<AB_BT_N {
    gx := f32(j % 3 - 1) * side / 3; gz := f32(j / 3 - 1) * side / 3;
    p0 := v3(p.x + gx, ground_at(s, p.x + gx, p.z + gz), p.z + gz);
    ph := f32(j) * 1.37;
    for q: 0..<AB_BT_SEG {
      u := f32(q) / f32(AB_BT_SEG);
      bend := u * u * 0.9;
      dir := unit_or(v3(sin(t * 1.7 + ph + u * 3) * bend, 1, cos(t * 1.3 + ph * 0.7 + u * 2.5) * bend), v3(0, 1, 0));
      rad := lerp(f32(AB_BT_BASE_R), f32(AB_BT_TIP_R), u) * 2.6;
      sd := unit_or(cross(dir, v3(0, 1, 0.001)), v3(1, 0, 0));
      fwd := cross(sd, dir);
      along := times(dir, seg * 1.6);
      tone := 1.0 + 0.25 * f32(q % 2);
      sp_shape(s, SHAPE_CONE, LOOK_SKIN, add(p0, times(along, 0.5)), times(sd, rad), along, times(fwd, rad), times(AB_BT_RGB, tone));
      p0 = add(p0, times(dir, seg));
    }
  }
  ab_square(s, v3(p.x, ground_at(s, p.x, p.z), p.z), side * 0.5, times(v3(0.62, 0.4, 1.0), 0.35));
}
// A Wall of Thorns: drawn by the page's own (ci_wt_draw), its state for the moment the server's.
net_draw_thorns :: (s: [] Everglade, en: NetEnt, t: f32, few: bool) {
  v := ci_of(s);
  on := v[0].wt_on; a := v[0].wt_a; b := v[0].wt_b; nn := v[0].wt_n; wt := v[0].wt_t;
  p := en.shown;
  half := ifx en.p2 > 0 then f32(en.p2) / 200 else f32(CI_WT_LONG) * 0.5;
  d := v3(sin(p.yaw), 0, cos(p.yaw));
  v[0].wt_a = v3(p.x - d.x * half, 0, p.z - d.z * half); v[0].wt_b = v3(p.x + d.x * half, 0, p.z + d.z * half);
  v[0].wt_a.y = ground_at(s, v[0].wt_a.x, v[0].wt_a.z); v[0].wt_b.y = ground_at(s, v[0].wt_b.x, v[0].wt_b.z);
  v[0].wt_n = v3(-d.z, 0, d.x); v[0].wt_on = true; v[0].wt_t = lo(t, f32(CI_WT_LIFE) - 2);
  ci_wt_draw(s, few);
  v[0].wt_on = on; v[0].wt_a = a; v[0].wt_b = b; v[0].wt_n = nn; v[0].wt_t = wt;
}
// A lingering zone: a ring of its ability's light on the ground, slowly turning, and motes over it.
net_draw_zone :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  c := net_tint(en.p1);
  r := clamp(f32(en.p2) / 100, 0.5, 95);
  on := clamp(t / 0.5, 0, 1);
  segs := clamp_i(cast(int) (r * 3), 16, 48);
  for q: 0..<segs {
    a0 := f32(TAU) * f32(q) / f32(segs) + t * 0.1; a1 := a0 + f32(TAU) / f32(segs);
    x0 := p.x + cos(a0) * r; z0 := p.z + sin(a0) * r; x1 := p.x + cos(a1) * r; z1 := p.z + sin(a1) * r;
    ab_line(s, v3(x0, ground_at(s, x0, z0) + 0.08, z0), v3(x1, ground_at(s, x1, z1) + 0.08, z1), times(c, 0.8 * on));
  }
  if sp_rand(s) < 0.3 {
    a := f32(TAU) * sp_rand(s); d := r * sqrt(sp_rand(s));
    x := p.x + cos(a) * d; z := p.z + sin(a) * d;
    sp_add_spark(s, v3(x, ground_at(s, x, z) + 0.3, z), v3(0, 0.6, 0), 1.0, 0.03, c, -0.3);
  }
}
// A wall of wind or fire: its lines of light, standing.
net_draw_line :: (s: [] Everglade, en: NetEnt, t: f32) {
  p := en.shown;
  c := net_tint(en.p1);
  half := f32(en.p2) / 200;
  d := v3(sin(p.yaw), 0, cos(p.yaw));
  on := clamp(t / 0.5, 0, 1);
  segs := clamp_i(cast(int) (half * 2), 4, 24);
  for q: 0..<segs {
    u0 := -1 + 2 * f32(q) / f32(segs); u1 := u0 + 2 / f32(segs);
    x0 := p.x + d.x * half * u0; z0 := p.z + d.z * half * u0; x1 := p.x + d.x * half * u1; z1 := p.z + d.z * half * u1;
    for h: 0..<3 {
      y := 0.1 + f32(h) * 1.4;
      ab_line(s, v3(x0, ground_at(s, x0, z0) + y, z0), v3(x1, ground_at(s, x1, z1) + y, z1), times(c, on * (0.9 - 0.2 * f32(h))));
    }
  }
}

// ---- reading the world, for what draws it (everglade-room.coax, the town) and for checks

// How many live entities of kind (-1 any) there are, the others' players without yours.
net_count :: (s: [] Everglade, kind: int) -> int {
  if !net_on(s) { return 0; }
  n := net_of(s);
  c := 0;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || (kind >= 0 && en.kind != kind) || net_mine_player(n, en) { continue; }
    c += 1;
  }
  return c;
}
NetPartyHealth :: struct {ok:bool;hp:int;max:int;}
net_party_health :: (s:[]Everglade,seat:int)->NetPartyHealth {
  if !net_on(s) || seat<0 || seat>=16 {return NetPartyHealth.{};}
  n:=net_of(s);
  return NetPartyHealth.{ok=n[0].party_only[seat],hp=n[0].party_hp[seat],max=n[0].party_max[seat]};
}
net_mine_player :: (n: [] EgNet, en: NetEnt) -> bool { return en.kind == WK_PLAYER && en.owner >= 0 && en.owner == n[0].seat; }
// The k-th live entity of kind (-1 any; your own player left out): its place in the table, -1 none.
net_nth :: (s: [] Everglade, kind: int, k: int) -> int {
  if !net_on(s) { return -1; }
  n := net_of(s);
  c := 0;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || (kind >= 0 && en.kind != kind) || net_mine_player(n, en) { continue; }
    if c == k { return e; }
    c += 1;
  }
  return -1;
}
NetView :: struct {
  ok: bool; eid: int; kind: int; owner: int; seat: int;
  x: f32; y: f32; z: f32; yaw: f32; vx: f32; vz: f32;   // drawn now; y the feet's world height
  flags: int; act: int; form: int; air: bool; swim: bool; boat: bool; alive: bool;
  account: bool; away: bool;       // a player's: signed in (its hello's FLAGS 2), nothing heard from it (WG_AWAY)
  hp: int; max: int; p1: int; p2: int; wanted: int;
  cast_slot: int; cast_age: f32;   // its last spell (a bar slot) and how long ago, s
}
// The k-th live entity of kind (-1 any; WK_PLAYER: the other players), as drawn this frame.
net_view :: (s: [] Everglade, kind: int, k: int) -> NetView {
  e := net_nth(s, kind, k);
  if e < 0 { return NetView.{}; }
  n := net_of(s);
  en := n[0].ents[e]; p := en.shown;
  pl := en.kind == WK_PLAYER;
  return NetView.{ok = true, eid = en.eid, kind = en.kind, owner = en.owner, seat = en.seat,
                  x = p.x, y = p.y, z = p.z, yaw = p.yaw, vx = p.vx, vz = p.vz,
                  flags = p.f, act = p.a, form = en.form,
                  air = pl && (p.f & (WG_GROUND | WG_SWIM | WG_BOAT)) == 0, swim = pl && (p.f & WG_SWIM) != 0, boat = pl && (p.f & WG_BOAT) != 0,
                  alive = !pl || (p.f & WG_DEAD) == 0, account = pl && (en.hello_flags & 2) != 0, away = pl && (p.f & WG_AWAY) != 0,
                  hp = en.hp, max = en.max, p1 = en.p1, p2 = en.p2, wanted = en.wanted,
                  cast_slot = en.cast_slot, cast_age = ifx en.cast_slot >= 0 then f32(net_now(n) - en.cast_at) / 1000 else 100000.0f32};
}
// Its name ("" none yet: a nameless figure), player id, class and look (n).
net_view_name :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].name[0..<net_of(s)[0].ents[e].name_n];
}
net_view_id :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].id[0..<net_of(s)[0].ents[e].id_n];
}
net_view_class :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].cls[0..<net_of(s)[0].ents[e].cls_n];
}
net_view_look :: (s: [] Everglade, kind: int, k: int) -> string {
  e := net_nth(s, kind, k);
  if e < 0 { return ""; }
  return cast(string) net_of(s)[0].ents[e].look[0..<net_of(s)[0].ents[e].look_n];
}
// You as the server has you: your Hit Points and most (-1 none heard yet).
net_self_hp :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && net_mine_player(n, en) { return en.hp; } }
  return -1;
}
// Whether the server has you dead (your p's DEAD bit, its newest state): 1 dead, 0 alive, -1 none heard.
net_self_dead :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if en.live && net_mine_player(n, en) && en.ring_n > 0 { return ifx (en.ring[en.ring_n - 1].f & WG_DEAD) != 0 then 1 else 0; }
  }
  return -1;
}
net_self_max :: (s: [] Everglade) -> int {
  if !net_live(s) { return -1; }
  n := net_of(s);
  for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && net_mine_player(n, en) { return en.max; } }
  return -1;
}
// Optional headless forest rehearsal: a real Produce Flame intent, then counts and a canonical
// digest of the same transforms/material fields that the forest renderer reads. Never called by UI.
net_forest_probe :: (s: [] Everglade, field: int) -> int {
  if !sp_on(s) { return -1; }
  v := tf_of(s);
  if field == 9000 {
    you := ab_you(s); pick := -1; best := 8.0f32;
    for t: 0..<s[0].tree_n {
      at := tf_foot(s, t); d := flat_gap(at, you);
      if d < best && v[0].mode[tf_k(s, t)] == TF_UP && !tf_burning(s, t) && !fr_wet(s, at.x, at.z) {
        pick = t; best = d;
      }
    }
    if pick < 0 { return -1; }
    at := add(tf_foot(s, pick), v3(0, 1.5, 0));
    return ifx net_cast(s, SP_SLOTS + AB_FLAME, at, -1) then pick else -1;
  }
  if field == 9001 { return v[0].n; }
  count := 0; hash := 7;
  for t: 0..<s[0].tree_n {
    k := tf_k(s, t); if k == 0 { continue; }
    if field == 9002 && v[0].soot[k] == 1 && v[0].bare[k] == 1 { count += 1; }
    if field == 9003 && v[0].mode[k] == TF_FALL { count += 1; }
    if field != 9004 { continue; }
    words := [12] int.[t, v[0].mode[k], wire_cm(v[0].ox[k]), wire_cm(v[0].oy[k]), wire_cm(v[0].oz[k]),
      cast(int) floor(v[0].ax[k] * 1000 + 0.5), cast(int) floor(v[0].az[k] * 1000 + 0.5),
      cast(int) floor(v[0].pivot[k] * 1000 + 0.5), cast(int) floor(v[0].rest[k] * 1000 + 0.5),
      cast(int) floor(v[0].soot[k] * 1000 + 0.5), cast(int) floor(v[0].bare[k] * 1000 + 0.5), cast(int) floor(v[0].frost[k] * 1000 + 0.5)];
    for i: 0..<12 { hash = (hash * 31 + words[i] + 2000000000) % 1000000007; }
  }
  return ifx field == 9004 then hash else count;
}
// For a headless check (everglade5e-face.c coaxial_net_probe): 0 the socket's state, 1 your seat, 2 the
// other players, 3 creatures and zones, 4 all entities, 5 the clock's source, 6 frames in, 7 frames
// out, 8 and 9 the first other player's x and z in cm, 10 effects played, 11 the jitter buffer's delay
// ms, 12 your last acked input, 13 hits heard, 14 re-runs from the server's word, 15 inputs sent,
// 16 the server's summoned creatures here, 17 their Hit Points together, 18 hits heard on them, 19
// their deaths heard, 20 the server's y for you (cm), 21 your feet's y as the face gives it, 22 the
// floor's height under you, 23 the town's people heard (f), 24 your WANTED level (w, -1 none), 25 the
// people drawn off their day, 26 breaks heard (e break), 27 fires heard (e burn), 28 the pieces down,
// 29 your act as this frame drew you, 30 the clip your body plays; 31 to 38 and 300 + SEAT the
// nameplates, BLOCK and its pane (everglade-moderate.coax md_probe); 41 the townsfolk's frames drawn with
// their walk clip, 42 of those the ones drawn where the frame before drew them, 43 the frames' bytes heard;
// 44 the byte budget a tick (W), 50 rows the mirror could not read, 51 the newest tick heard whole.
// 930 to 932 the nearest foe (net_nearest_foe): its x and z and its distance, cm.
// 200 + SLOT casts bar slot SLOT (net_cast, as a click does) at the nearest
// foe among the summoned creatures (never the town's watch), else 3 m ahead of you (an ability you don't point with: 2 m ahead, as its press
// does): 1 when it went out.
net_probe :: (s: [] Everglade, field: int) -> int #export_c #effects(all) {
  if field==920 {return int(s[0].guide.raid_target_x);}if field==921 {return int(s[0].guide.raid_target_y);}
  if field==922 {return ifx s[0].guide.raid_helped then 1 else 0;}
  if !net_on(s) { return -1; }
  n := net_of(s);
  if field >= 9000 && field <= 9004 { return net_forest_probe(s, field); }
  if field == 0 { return n[0].state; }
  if field == 1 { return n[0].seat; }
  if field == 2 { return net_count(s, WK_PLAYER); }
  if field == 3 { return net_count(s, -1) - net_count(s, WK_PLAYER) - net_count(s, WK_FOLK); }
  if field == 4 { return net_count(s, -1); }
  if field == 5 { return n[0].synced; }
  if field == 6 { return n[0].frames_in; }
  if field == 7 { return n[0].frames_out; }
  if field == 8 || field == 9 {
    v := net_view(s, WK_PLAYER, 0);
    if !v.ok { return -999999; }
    return wire_cm(ifx field == 8 then v.x else v.z);
  }
  if field == 10 { return n[0].played; }
  if field == 11 { return cast(int) n[0].lag; }
  if field == 12 { return n[0].acked; }
  if field == 13 { return n[0].hits; }
  if field == 14 { return n[0].replays; }
  if field == 15 { return n[0].seq; }
  if field == 16 || field == 17 {
    c := 0; hp := 0;
    for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && en.kind == WK_BEAST { c += 1; hp += en.hp; } }
    return ifx field == 16 then c else hp;
  }
  if field == 18 { return n[0].creature_hits; }
  if field == 20 { return ifx n[0].fix.ok then wire_cm(n[0].fix.y) else -999999; }
  if field == 21 { return wire_cm(n[0].feet_y); }
  if field == 22 { return wire_cm(walk_at(s, s[0].feet.x, s[0].feet.z)); }
  if field == 23 { return net_count(s, WK_FOLK); }                       // the town's people heard (f)
  if field == 24 { return n[0].wanted; }                                 // your WANTED level (w; -1 none)
  if field == 26 { return n[0].breaks_heard; }
  if field == 27 { return n[0].burns_heard; }
  if field == 28 { k := 0; for i: 0..<sp_dm(s)[0].n { if sp_dm(s)[0].pieces[i].state != DP_STANDING { k += 1; } } return ifx sp_on(s) then k else -1; }
  if field == 25 { k := 0; for i: 0..<WATCH_ACTORS { if s[0].wt[0].actors[i].ready && s[0].wt[0].actors[i].mode != WM_CALM { k += 1; } } return k; }   // off their day as drawn
  if field == 19 { return n[0].creature_deaths; }
  // you as this frame drew you: the controller's act (aethyr/walk.coax Act: 3 airborne) and the clip
  // your body plays (aethyr/skin.coax SKIN_*: 3 the jump), for a check that the jump's pose ends
  if field >= 31 && field <= 38 || field >= 300 && field < 300 + EG_RA_SEATS || field >= 320 && field < 320 + EG_RA_SEATS { return md_probe(s, field); }   // the others, as you deal with them (everglade-moderate.coax)
  // 340 + SEAT: that caster's authoritative Reverse Gravity cylinders. Doors
  // and boats use larger entity IDs too, so an ID cutoff is not a spell count.
  if field >= 340 && field < 340 + EG_RA_SEATS {
    count := 0;
    for e: 0..<NET_ENTS {
      en := n[0].ents[e];
      if en.live && en.kind == WK_ZONE && en.owner == field - 340 && en.p1 == AB_REVERSE { count += 1; }
    }
    return count;
  }
  if field == 29 { return s[0].act; }
  if field == 30 { return s[0].skin[0].clip; }
  // your body as drawn: how upright (its up axis's height, x1000: 1000 standing, about 0 lying), and
  // whether the page has you dead (1)
  if field == 39 { return cast(int) (s[0].objects[RANGER_AT * OBJECT_FLOATS + 5] * 1000); }
  if field == 40 { return ifx s[0].wv.started && watch_you(s[0].wt[..])[0].dead then 1 else 0; }
  // the townsfolk drawn with their walk clip, frames summed over them, and of those the frames drawn
  // where the frame before drew them (walking in place); the room frames' bytes heard
  if field == 41 { return n[0].folk_walk; }
  if field == 42 { return n[0].folk_still; }
  if field == 43 { return n[0].bytes_in; }
  // the drift check's (coax/web/everglade-drift.coax, #12778): 60 the camera's heading (mrad), 61 the
  // frame's puffs drawn and 62 staged, 45 to 48 Reverse Gravity's puffs, Wind Wall's, Wall of Stone's
  // panels and every spell's and condition's puffs drawn last frame, 49 the bar's slots (a hash of
  // each place's), 52 what holds you as drawn (bits: 1 you can't move, 2 Hold Person's rings and HELD,
  // 4 Earthbind's, 8 Ray of Frost's, 16 your pace slowed), 53 the server's conditions on you, 55
  // other players with a condition, 57 and 58 the stables' pieces down and in all, 59 (offline) Hold
  // Person on you, 400 + P the bar
  // slot at place P (-1 none), 600 + 3 I + 0, 1, 2 townsperson I's drawn x and z (cm) and clip
  // 700 + I: 1 while this page holds the room's row of person I (net_folk), else 0 (offline, out of view, or gone)
  if field == 60 { return cast(int) (s[0].orbit.yaw * 1000); }
  // 63 your body's facing as drawn and 64 the server's for you in its last word (mrad; -999999 none yet)
  if field == 63 { return cast(int) (wrap_angle(s[0].face) * 1000); }
  // 990 a Character Create class's slot 1 casts sent to the room, 991 its looks played back (everglade-classes.coax)
  if field == 990 { return s[0].cl.sent; }
  if field == 991 { return s[0].cl.played; }
  if field == 64 { return ifx n[0].fix.ok then cast(int) (wrap_angle(n[0].fix.yaw) * 1000) else -999999; }
  if field == 61 { return s[0].sp.sprite_n; }
  if field == 62 { return s[0].sp.fx_seen; }
  // 84 you play in a room (its kit, level and rules), 85 rejoining a room that dropped (63 and 64 are
  // your facing's, above), 65 the level's kit on the bar, 66 your level
  if field == 84 { return ifx net_live(s) then 1 else 0; }
  if field == 85 { return ifx net_rejoining(s) then 1 else 0; }
  if field == 65 { return ifx ege_kit_on(s) then 1 else 0; }
  if field == 66 { return ege_of(s)[0].level; }
  if field == 67 { return s[0].doors.near; }                            // the door you stand at (-1 none)
  if field == 68 { return net_doors(s, 0); }                             // the room's open doors, word 0 (-1 none heard)
  if field == 69 { return ifx door_prompt_on(s) then 1 else 0; }
  // Repair and the placed things' fire (everglade-repair.coax, everglade-placed-fire.coax)
  if field == 70 { return n[0].mends_heard; }
  if field == 71 || field == 72 { k := 0; for i: 0..<s[0].ev.edits.n { if (field == 71 && pf_burning(s, i)) || (field == 72 && pf_gone(s, i)) { k += 1; } } return k; }
  if field == 73 { return ifx mend_on(s) then 1 else 0; }
  // the Long Rest (everglade-rest.coax): 77 whether it is offered, 78 takes it
  if field == 77 { return ifx rest_on(s) then 1 else 0; }
  if field == 78 { rest_take(s); return ifx watch_on(s) then watch_you(watch_w(s)[..])[0].hp else -1; }
  // 80 the server's REST for you, 81 sends L as if by the hearth, 82 the rests taken
  if field == 98 { return ifx !n[0].local_host then 0 else ifx n[0].room_sock >= 0 || n[0].room_wait then 2 else 1; }   // the local host (1), the room's socket opening beside it (2) (#12882)
  if field == 83 { return s[0].ev.edits.n; }   // the placed things this page lays
  if field == 80 { return ifx ege_of(s)[0].rest then 1 else 0; }
  if field == 81 { return ifx net_rest(s) then 1 else 0; }
  if field == 82 { return rest_of(s)[0].taken; }
  // the checks' hands (coax/web/room: the two-page Repair check): 74 casts Thunderbolt at the nearest
  // standing wall or roof within 30 m, 75 Meteor Swarm at the nearest placed thing, 76 turns you to the
  // nearest broken thing within Repair's reach and presses R. The piece, the thing or the CODE; -1 none.
  if field == 74 && sp_on(s) {
    you := ab_you(s); w := sp_dm(s); best := 30.0f32; pick := -1;
    for i: 0..<w[0].n {
      p := w[0].pieces[i];
      d := flat_gap(v3(p.cx, 0, p.cz), you);
      if p.state != DP_STANDING || d >= best || d < 6 || p.group >= EG_BUILDINGS + EG_DHOUSES { continue; }
      best = d; pick = i;
    }
    if pick < 0 { return -1; }
    p := w[0].pieces[pick];
    return ifx net_cast(s, SP_BOLT, v3(p.cx, p.cy, p.cz), -1) then pick else -1;
  }
  if field == 75 {
    you := ab_you(s); best := 40.0f32; pick := -1;
    for i: 0..<s[0].ev.edits.n { d := flat_gap(pf_centre(s, i), you); if d < best { best = d; pick = i; } }
    if pick < 0 { return -1; }
    return ifx net_cast(s, SP_METEOR, pf_centre(s, pick), -1) then pick else -1;
  }
  if field == 76 {
    you := ab_you(s);
    code := mend_find(s, you, you);
    best := 1e9f32;
    for q: 0..<24 {
      a := f32(TAU) * f32(q) / 24;
      for r: 1..<5 {
        c := mend_find(s, you, add(you, v3(sin(a) * f32(r) * 4, 0, cos(a) * f32(r) * 4)));
        if c < 0 { continue; }
        at := mend_centre(s, c);
        d := flat_gap(at, you);
        if d < best { best = d; code = c; }
      }
    }
    if code < 0 { return -1; }
    at := mend_centre(s, code);
    s[0].face = atan2(at.x - you.x, at.z - you.z);
    mend_press(s, ifx wl_on(s) then WL_SLOT0 + WL_REBUILD else SP_REBUILD);   // a class's R is the druid's
    return ifx mend_on(s) then code else -1;
  }
  if field >= 45 && field <= 48 { return s[0].sp.fx_shown[field - 45]; }
  if field == 49 { h := 7; for p: 0..<48 { h = (h * 31 + sp_at_place(s, p) + 2) % 1000000007; } return h; }
  if field >= 400 && field < 448 { return sp_at_place(s, field - 400); }
  if field == 52 {
    b := ifx everglade_held(s) then 1 else 0;
    c := st_cond(s, ST_YOU);   // as drawn: the status state (everglade-status.coax)
    if (c & WC_PARALYZED) != 0 { b |= 2; }
    if (c & WC_BOUND) != 0 { b |= 4; }
    if (c & WC_SLOWED) != 0 { b |= 8; }
    if everglade_slow(s) < 0.999 { b |= 16; }
    return b;
  }
  if field == 53 { return net_cond(s); }
  // the combat check's (coax/web/everglade-combat.coax, #12862): 90 the conditions on every other
  // player as this page has them (bits OR'd; Unconscious for one down at 0 Hit Points), 91 the words drawn over others' heads (1 << POP_*)
  if field == 90 { c := 0; for j: 1..<ST_WHOS { c |= st_cond(s, st_who_of(j)) | (ifx st_down(s, st_who_of(j)) then WC_UNCONSCIOUS else 0); } return c; }
  if field == 91 { return s[0].st_words; }
  if field == 92 { m := 0; if s[0].wv.started { for k: 0..<MISSILES { if s[0].wt[0].missiles[k].live { m += 1; } } } return m; }   // the watch's spells in the air drawn here
  // the vines check's (coax/web/everglade-vines.coax, #12873): 93 casts Entangle at the most heard
  // standing guards that fit in its square (at least three, within its range of you; their count, -1
  // none), 94 the people the vines hold as drawn here, 95 the people the room says are Restrained
  // (their row's COND) who stand in a live Entangle's square here, 96 those in only one of the two,
  // 97 a hash of whom the vines hold (the same set on every page)
  if field == 93 && net_live(s) {
    you := ab_you(s); h := f32(GV_EN_SIDE) * 0.5 - 0.4;
    best := 0; at := you;
    for g: 0..<WATCH_ACTORS {
      fg := net_folk(s, g);
      if !watch_is_guard(g) || !fg.ok || fg.mode == WM_DOWN || fg.mode == WM_DEAD || flat_gap(v3(fg.x, 0, fg.z), you) > f32(GV_EN_RANGE) - 4 { continue; }
      k := 0; sx := 0.0f32; sz := 0.0f32;
      for j: 0..<WATCH_ACTORS {
        fj := net_folk(s, j);
        if !watch_is_guard(j) || !fj.ok || fj.mode == WM_DOWN || fj.mode == WM_DEAD || abs(fj.x - fg.x) > h || abs(fj.z - fg.z) > h { continue; }
        k += 1; sx += fj.x; sz += fj.z;
      }
      if k > best { best = k; at = v3(sx / f32(k), 0, sz / f32(k)); }
    }
    if best < 3 { return -1; }
    at.y = ground_at(s, at.x, at.z);
    return ifx net_cast(s, SP_SLOTS + AB_ENTANGLE, at, -1) then best else -1;
  }
  if field >= 94 && field <= 97 {
    k := 0; hash := 7;
    for i: 0..<WATCH_ACTORS {
      vined := eg_ra_vined(s, i);
      f := net_folk(s, i);
      held := f.ok && (f.cond & WC_RESTRAINED) != 0 && eg_ra_in_entangle(s, f.x, f.z);
      if field == 94 && vined { k += 1; }
      if field == 95 && held { k += 1; }
      if field == 96 && vined != held { k += 1; }
      if vined { hash = (hash * 31 + i + 1) % 1000000007; }
    }
    return ifx field == 97 then hash else k;
  }
  if field == 55 {
    k := 0;
    for e: 0..<NET_ENTS { en := n[0].ents[e]; if en.live && en.kind == WK_PLAYER && !net_mine_player(n, en) && en.p1 != 0 { k += 1; } }
    return k;
  }
  if field == 57 || field == 58 {
    if !sp_on(s) { return -1; }
    hn := 0; hd := 0; w := sp_dm(s);
    for i: 0..<(ifx w[0].n < w[0].pieces.count then w[0].n else w[0].pieces.count) { if rp_in_stables(w[0].pieces[i].cx, w[0].pieces[i].cz) { hn += 1; if w[0].pieces[i].state != DP_STANDING { hd += 1; } } }
    return ifx field == 57 then hd else hn;
  }
  if field >= 600 && field < 600 + 3 * EG_SPOTS {
    i := (field - 600) / 3; f := (field - 600) % 3;
    if f == 2 { return s[0].folk[i].clip; }
    return wire_cm(ifx f == 0 then s[0].folk[i].x else s[0].folk[i].z);
  }
  if field >= 700 && field < 700 + WATCH_ACTORS { return ifx net_folk(s, field - 700).ok then 1 else 0; }
  if field == 44 { return n[0].budget; }
  if field == 50 { return n[0].mir[0].bad; }
  if field == 51 { return n[0].mir[0].heard; }
  // 930 and 931 the nearest foe's x and z (cm), 932 how far it is from you (cm); -999999 none (#13070)
  if field >= 930 && field <= 932 {
    e := net_nearest_foe(n, ab_you(s));
    if e < 0 { return -999999; }
    en := n[0].ents[e];
    if field == 930 { return wire_cm(en.shown.x); }
    if field == 931 { return wire_cm(en.shown.z); }
    return wire_cm(flat_gap(v3(en.shown.x, 0, en.shown.z), ab_you(s)));
  }
  if field >= 200 && field < 200 + SP_SLOTS + AB_N {
    you := ab_you(s);
    at := add(you, times(ab_forward(s), 3));
    // an ability you don't point with goes where you stand, as its press sends it (net_press)
    k := field - 200 - SP_SLOTS;
    if k >= 0 && !ab_aimed(k) { return ifx net_cast(s, field - 200, add(you, times(ab_forward(s), 2)), -1) then 1 else 0; }
    e := net_nearest_foe(n, you);
    if e >= 0 { at = v3(n[0].ents[e].shown.x, n[0].ents[e].shown.y, n[0].ents[e].shown.z); }
    return ifx net_cast(s, field - 200, at, -1) then 1 else 0;
  }
  return -1;
}
// The live summoned creature nearest you that is a foe (never the town's watch or its hero, who walk
// through the commons spawn since e25377c906, #13070), -1 none: the 200 + SLOT probe's target.
net_nearest_foe :: (n: [] EgNet, you: Point) -> int {
  best := -1; bd := 1000000.0f32;
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_BEAST || en.hp <= 0 || net_watch_form(en.p1) { continue; }
    d := flat_gap(v3(en.shown.x, 0, en.shown.z), you);
    if d < bd { bd = d; best = e; }
  }
  return best;
}
#test "net: the cast probe aims at the nearest raider, never a nearer Guard of the watch (#13070)" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  net_test_tick(room[..], 1, 0);
  // a Guard of the watch (form 21) 2 m off, a Cultist (27) 9 m off and Echo 1 m off
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 7, kind = WK_BEAST, owner = -1, x = 2, z = 0, hp = 11, p1 = EGE_FORM_RAID + 1, max = 11});
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 8, kind = WK_BEAST, owner = -1, x = 9, z = 0, hp = 9, p1 = EGE_FORM_RAID + 7, max = 9});
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 9, kind = WK_BEAST, owner = -1, x = 0, z = 1, hp = 40, p1 = EGE_FORM_HERO, max = 40});
  #assert net_test_hear(b[..], 1, net_test_frame(room[..]));
  e := net_nearest_foe(nb[..], v3(0, 0, 0));
  #assert e >= 0 && nb[0].ents[e].eid == NET_MADE_ID + 8;
}
// The pipe's commands, for the face to carry out.
net_pipe_n :: (s: [] Everglade) -> int #export_c #effects(all) { if !net_on(s) { return 0; } return net_of(s)[0].pipe[0].n; }
net_pipe_op :: (s: [] Everglade, k: int) -> int #export_c #effects(all) { return net_of(s)[0].pipe[0].op[k]; }
net_pipe_id :: (s: [] Everglade, k: int) -> int #export_c #effects(all) { return net_of(s)[0].pipe[0].id[k]; }
net_pipe_bytes :: (s: [] Everglade, k: int) -> string #export_c #effects(all) { return pipe_bytes(net_of(s)[0].pipe[..], k); }
net_pipe_done :: (s: [] Everglade) #export_c #effects(all) { if net_on(s) { pipe_drained(net_of(s)[0].pipe[..]); } }

// ---- the sky (#12709): the room server owns the time of day and the weather (room-sky.coax). W
// says the server's day (ms into it at its tick) and the weather it runs; the page draws both on the
// server clock, so every page in the room has the same sky whatever its own clock says. Offline, or
// a server that runs no sky (W's WEATHER 0), the page keeps its own (everglade.coax weather_frame).

// In a room whose server runs the sky.
net_sky :: (s: [] Everglade) -> bool { return net_live(s) && net_of(s)[0].worlds > 0 && net_of(s)[0].weather > 0; }
// The server's time of day now, 0 midnight to 1, or -1 none.
net_sky_day :: (s: [] Everglade) -> f32 {
  if !net_sky(s) { return -1; }
  n := net_of(s);
  ms := (n[0].day + net_now(n) - n[0].w_t) % WIRE_DAY_MS;
  if ms < 0 { ms += WIRE_DAY_MS; }
  return f32(ms) / f32(WIRE_DAY_MS);
}
// The server clock in ms for the weather's tick, or -1 none.
net_sky_ms :: (s: [] Everglade) -> f64 {
  if !net_sky(s) { return -1.0; }
  return cast(f64) net_now(net_of(s));
}
// The server's weather over the page's schedule at `tick`: where the server runs another state than the
// schedule has then (or 2 s either side: the turn the server just sent, on a clock a little off), the
// server's state from then on.
net_sky_weather :: (s: [] Everglade, w: [] WeatherSchedule, tick: u64) {
  if !net_sky(s) { return; }
  want := net_of(s)[0].weather - 1;
  if want < WEATHER_CLEAR || want > WEATHER_STORM { return; }
  near := cast(u64) (2 * WEATHER_TICK_HZ);
  if weather_states(w, tick).after == want || weather_states(w, tick + near).after == want { return; }
  if tick > near && weather_states(w, tick - near).after == want { return; }
  weather_pin(w, tick, want);
}

// ---- checks: two pages and a room server of the check's own, written with the wire's writers

NetTestRoom :: struct { buf: [WIRE_SERVER_FRAME] u8; n: int; }
// A page with its socket open (id sock) at monotonic ms mono, in room pair-a as player pid.
net_test_page :: (s: [] Everglade, n: [] EgNet, sock: int, pid: string, mono: int) -> bool {
  everglade_attach_net(s, n);
  facts: [200] u8;
  m := wire_put(facts[..], 0, "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=");
  m = wire_put(facts[..], m, pid);
  m = wire_put(facts[..], m, "\nnow=5000000\nnav=0\n");
  net_facts(s, cast(string) facts[0..<m], "everglade", false);
  n[0].ticket_n = net_copy(n[0].ticket[..], "tk");   // its seat ticket, as the API would answer
  net_step(s, mono, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  opened := n[0].pipe[0].n == 1 && n[0].pipe[0].op[0] == PIPE_OPEN && pipe_bytes(n[0].pipe[..], 0) == "wss://openagents.com/api/room/relay/everglade/pair-a?t=tk";
  pipe_drained(n[0].pipe[..]);
  net_opened(s, sock);
  return opened && net_event(s, SOCKET_KIND + 4 * sock + SOCKET_OPENED, "");
}
// The server's frame to a page.
net_test_hear :: (s: [] Everglade, sock: int, t: string) -> bool { return net_event(s, SOCKET_KIND + 4 * sock + SOCKET_FRAME, t); }
// The last frame a page sent that starts with letter c, "" none; the pipe emptied.
net_test_sent :: (n: [] EgNet, c: u8, out: [] u8) -> string {
  got := 0;
  for k: 0..<n[0].pipe[0].n {
    b := pipe_bytes(n[0].pipe[..], k);
    if n[0].pipe[0].op[k] == PIPE_SEND && b.count > 0 && b[0] == c { got = wire_put(out, 0, b); }
  }
  pipe_drained(n[0].pipe[..]);
  return cast(string) out[0..<got];
}
// The server's world header (W), and its state for a tick (D) with entries, written with the wire's
// own writers, as the room server writes them.
net_test_world :: (r: [] NetTestRoom, tick: int) {
  r[0].n = wire_put_world(r[0].buf[..], 0, WireWorld.{tick = tick, seed = 41, day = 3600000, weather = 0});
}
net_test_tick :: (r: [] NetTestRoom, tick: int, ack: int) {
  r[0].n = wire_put_d(r[0].buf[..], 0, WireD.{tick = tick, ack = ack, f = 0, part = 0});
}
net_test_sep :: (r: [] NetTestRoom) { if r[0].buf[r[0].n - 1] != ' ' { r[0].n = wire_sep(r[0].buf[..], r[0].n); } }
// An entity's row, absolute (BACK 0): what a snapshot or a first sight sends.
net_test_s :: (r: [] NetTestRoom, e: WireS) {
  net_test_sep(r);
  row: [WIRE_SF] s32; zero: [WIRE_SF] s32;
  wire_s_pack(e, row[..]);
  r[0].n = wire_put_s(r[0].buf[..], r[0].n, e.id, 0, zero[..], row[..]);
}
net_test_n :: (r: [] NetTestRoom, w: WireN) { net_test_sep(r); r[0].n = wire_put_n(r[0].buf[..], r[0].n, w); }
net_test_x :: (r: [] NetTestRoom, id: int) { net_test_sep(r); r[0].n = wire_put_x(r[0].buf[..], r[0].n, id); }
net_test_cast :: (r: [] NetTestRoom, c: WireCastE) { net_test_sep(r); r[0].n = wire_put_cast_e(r[0].buf[..], r[0].n, c); }
net_test_frame :: (r: [] NetTestRoom) -> string { return cast(string) r[0].buf[0..<r[0].n]; }
// Two pages seated in room pair-a at mono 100 (server 5000100), the world's tick 0 then.
net_test_pair :: (a: [] Everglade, na: [] EgNet, b: [] Everglade, nb: [] EgNet, room: [] NetTestRoom) -> bool {
  ok := net_test_page(a, na, 0, "pa", 100) && net_test_page(b, nb, 1, "pb", 100);
  ok = ok && net_test_hear(a, 0, "y 0 1 5000100") && net_test_hear(b, 1, "y 1 2 5000100");
  net_test_world(room, 0);
  return ok && net_test_hear(a, 0, net_test_frame(room)) && net_test_hear(b, 1, net_test_frame(room));
}

#test "net: profile 2 requests durable recovery and preserves the complete bounded ticket" {
  a:[1]Everglade;na:[1]EgNet;everglade_attach_net(a[..],na[..]);
  net_facts(a[..],"url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n","everglade",false);
  net_step(a[..],100,0,0,0,0,0,0,false,0,false,0);
  #assert jn_has(pipe_bytes(na[0].pipe[..],0),"&checkpoint=2");pipe_drained(na[0].pipe[..]);
  answer:[4200]u8;n:=wire_put(answer[..],0,"200\n{\"ticket\":\"");for i:0..<4096{answer[n+i]='a';}n+=4096;n=wire_put(answer[..],n,"\"}");
  net_ticket(a[..],cast(string)answer[0..<n]);#assert na[0].ticket_n==4096;
  net_step(a[..],132,0,0,0,0,0,0,false,0,false,0);#assert na[0].pipe[0].op[0]==PIPE_OPEN;
  opened:=pipe_bytes(na[0].pipe[..],0);#assert opened.count>4096&&opened[opened.count-1]=='a';
  na[0].ticket_n=0;n=wire_put(answer[..],0,"200\n{\"ticket\":\"");for i:0..<4097{answer[n+i]='a';}n+=4097;n=wire_put(answer[..],n,"\"}");
  net_ticket(a[..],cast(string)answer[0..<n]);#assert na[0].ticket_n==0;
}
#test "net: a page asks the API for a seat ticket before each open and opens with it once; a refusal waits and asks again" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET && jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-a?realm=everglade&build=");
  bt: [64] u8; bk := net_put_build(bt[..], wire_put(bt[..], 0, "&build="));
  #assert jn_has(pipe_bytes(na[0].pipe[..], 0), cast(string) bt[0..<bk]) && jn_has(pipe_bytes(na[0].pipe[..], 0), "\n{}");
  pipe_drained(na[0].pipe[..]);
  net_step(a[..], 116, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 0;   // asked once
  net_ticket(a[..], "200\n{\"ticket\":\"v1.p-1.0.-.pair-a.9.ab\",\"id\":\"p-1\"}");
  net_step(a[..], 132, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == PIPE_OPEN && pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/relay/everglade/pair-a?t=v1.p-1.0.-.pair-a.9.ab";
  pipe_drained(na[0].pipe[..]);
  // the socket closes: the next open asks again (a ticket is used once)
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  net_step(a[..], 140000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET;
  pipe_drained(na[0].pipe[..]);
  // refused: no open, and it asks again after the wait
  net_ticket(a[..], "403\n{\"error\":\"unknown player key\"}");
  net_step(a[..], 140016, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 0 && net_probe(a[..], 0) == NET_DOWN;
  net_step(a[..], 300000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET;
  // every room full: said, not silent
  net_ticket(a[..], "503\n{\"error\":\"every room is full: try again in a minute\"}");
  #assert cast(string) na[0].said[0..<na[0].said_n] == "ALL ROOMS FULL" && net_probe(a[..], 0) == NET_DOWN;
}
#test "net: a refusal's retry time is honored, with jitter; a full answer says how many wait and the last wait (#12796)" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(a[..], 100000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  net_ticket(a[..], "503\n{\"error\":\"every room is full: try again in a minute\",\"waiting\":58,\"retry_ms\":16600,\"last_wait_ms\":42000}");
  #assert cast(string) na[0].said[0..<na[0].said_n] == "ALL ROOMS FULL · 58 WAITING · LAST WAIT 42S";
  #assert na[0].retry >= 100000 + 16600 && na[0].retry <= 100000 + 16600 + 16600 / 4;
  net_step(a[..], 100000 + 16000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 0;
  // 429: the page waits the API's time, not its own first second
  net_step(a[..], 200000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  net_ticket(a[..], "429\n{\"error\":\"slow down\",\"retry_ms\":30000}");
  #assert na[0].retry >= 230000 && na[0].retry <= 237500;
  // pages refused at the same moment come back apart
  b: [1] Everglade; nb: [1] EgNet;
  everglade_attach_net(b[..], nb[..]);
  net_facts(b[..], "url=https://openagents.com/worlds/everglade\nplayer=qz\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(b[..], 200000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_ticket(b[..], "429\n{\"error\":\"slow down\",\"retry_ms\":30000}");
  #assert nb[0].retry != na[0].retry;
}
#test "net: the directory's instance and shard: the socket opens on the shard's path, and the next ticket asks for that instance (#12717)" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-b\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-b?realm=everglade&build=");
  pipe_drained(na[0].pipe[..]);
  net_ticket(a[..], "200\n{\"ticket\":\"v3.p-1.0.-.pair-b.2.9.-.ab\",\"id\":\"p-1\",\"room\":\"pair-b\",\"shard\":2}");
  #assert net_room(a[..], "everglade") == "pair-b";
  net_step(a[..], 132, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/s2/relay/everglade/pair-b?t=v3.p-1.0.-.pair-b.2.9.-.ab";
  pipe_drained(na[0].pipe[..]);
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  net_step(a[..], 140000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-b?realm=everglade&build=");
  pipe_drained(na[0].pipe[..]);
  // an answer without a placement (an API from before the directory) keeps the path as it was
  net_ticket(a[..], "200\n{\"ticket\":\"v2.x\",\"id\":\"p-1\"}");
  net_step(a[..], 300000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert pipe_bytes(na[0].pipe[..], 0) == "wss://openagents.com/api/room/s2/relay/everglade/pair-b?t=v2.x";
  // a local relay keeps its own address
  b: [1] Everglade; nb: [1] EgNet;
  everglade_attach_net(b[..], nb[..]);
  net_facts(b[..], "url=http://localhost:8787/worlds/everglade?relay=ws://localhost:8830\nplayer=p1\n", "everglade", false);
  was: [NET_URL] u8; wn := nb[0].url_n; for i: 0..<wn { was[i] = nb[0].url[i]; }
  net_placed(nb[..], "everglade-3", 2);
  #assert cast(string) nb[0].url[0..<nb[0].url_n] == cast(string) was[0..<wn] && cast(string) was[0..<20] == "ws://localhost:8830/";
}
#test "net: the ticket's answer brings back your WANTED and look; a changed look is saved while you play, a WANTED level never (#12794)" {
  a: [1] Everglade; na: [1] EgNet;
  everglade_attach_net(a[..], na[..]);
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_ticket(a[..], "200\n{\"ticket\":\"v2.x\",\"id\":\"pa\",\"account\":false,\"name\":\"\",\"expires\":9,\"hp\":4,\"wanted\":3,\"look\":\"ranger.2.1.0\",\"class\":\"druid\"}");
  #assert a[0].wv.want == 3 && cast(string) na[0].look[0..<na[0].look_n] == "ranger.2.1.0";
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  net_opened(a[..], 0);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_OPENED, "") && net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  // the same look as saved: nothing goes, and a new WANTED level is the room's, so nothing goes either
  watch_you(a[0].wt[..])[0].wanted = true; watch_you(a[0].wt[..])[0].level = 4;
  net_step(a[..], 3000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != NET_PIPE_STATE; }
  pipe_drained(na[0].pipe[..]);
  // a new look goes, once, with no WANTED in it
  na[0].look_n = net_copy(na[0].look[..], "ranger.3.1.0");
  net_step(a[..], 6000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  got := "";
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == NET_PIPE_STATE { got = pipe_bytes(na[0].pipe[..], k); } }
  #assert got == "{\"look\":\"ranger.3.1.0\",\"class\":\"druid\"}";
  pipe_drained(na[0].pipe[..]);
  net_step(a[..], 9000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != NET_PIPE_STATE; }
}
#test "net: a page that missed an outcome says O; the town sent again keeps what it names where it lies and stands the rest: a broken piece, a fire (#12902)" #steps 6000000000 {
  a: [1] Everglade; na: [1] EgNet; dm: [1] DemoWorld;
  sp_ready_city(a[..], dm[..]);
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100") && sp_on(a[..]);
  w: [1] NetTestRoom;
  net_test_world(w[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  // three pieces of three buildings
  d := sp_dm(a[..]);
  p1 := -1; p2 := -1; p3 := -1;
  for i: 0..<d[0].n {
    g := d[0].pieces[i].group;
    if g < 0 { continue; }
    if p1 < 0 { p1 = i; } else if p2 < 0 && g != d[0].pieces[p1].group { p2 = i; }
    else if p2 >= 0 && p3 < 0 && g != d[0].pieces[p1].group && g != d[0].pieces[p2].group { p3 = i; }
  }
  #assert p3 >= 0;
  // tick 1: p1 and p2 break, p3 catches; the room says 3 outcomes, as heard
  net_test_tick(w[..], 1, 0);
  net_test_sep(w[..]); w[0].n = wire_put_break(w[0].buf[..], w[0].n, p1, 0, 0, 0);
  net_test_sep(w[..]); w[0].n = wire_put_break(w[0].buf[..], w[0].n, p2, 0, 0, 0);
  net_test_sep(w[..]); w[0].n = wire_put_burn(w[0].buf[..], w[0].n, p3, true);
  net_test_sep(w[..]); w[0].n = wire_put_outcomes(w[0].buf[..], w[0].n, 3);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  #assert d[0].pieces[p1].state == DP_BROKEN && d[0].pieces[p2].state == DP_BROKEN && fi_burning(a[..], p3) && na[0].towns_asked == 0;
  // tick 3: the room says 5 (tick 2's frame, a Repair of p2 and the fire out, was lost): the page says O
  net_test_tick(w[..], 3, 0);
  net_test_sep(w[..]); w[0].n = wire_put_outcomes(w[0].buf[..], w[0].n, 5);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  o: [64] u8;
  #assert na[0].towns_asked == 1 && na[0].town_check && net_test_sent(na[..], 'O', o[..]) == "O 3";
  // tick 4: the town again, p1 its only broken piece, then e town: p1 lies where it fell, p2 stands, the fire is out
  breaks := na[0].breaks_heard;
  net_test_tick(w[..], 4, 0);
  net_test_sep(w[..]); w[0].n = wire_put_break(w[0].buf[..], w[0].n, p1, 0, 0, 0);
  net_test_sep(w[..]); w[0].n = wire_put_town(w[0].buf[..], w[0].n);
  net_test_sep(w[..]); w[0].n = wire_put_outcomes(w[0].buf[..], w[0].n, 7);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  #assert !na[0].town_check && na[0].towns_asked == 1 && na[0].breaks_heard == breaks;
  #assert d[0].pieces[p1].state == DP_BROKEN && d[0].pieces[p2].state == DP_STANDING && !fi_burning(a[..], p3) && na[0].towns_fixed == 2;
}
#test "net: the server's e edit asks the face for the world again, and the board too, once" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  #assert !net_edit_take(a[..]);
  a[0].ev.ed[0].spec_due = false;
  w: [1] NetTestRoom;
  net_test_world(w[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  net_test_tick(w[..], 1, 0); net_test_sep(w[..]); w[0].n = wire_put_edit(w[0].buf[..], w[0].n, 107);
  #assert net_test_hear(a[..], 0, net_test_frame(w[..]));
  #assert net_edit_take(a[..]) && !net_edit_take(a[..]) && a[0].ev.ed[0].spec_due;
}
#test "net: two pages in one room see each other move, as the server says, a jitter buffer behind it" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_page(b[..], nb[..], 1, "pb", 100);
  #assert net_probe(a[..], 0) == NET_OPEN && !net_live(a[..]);
  // the relay seats them: A seat 0, B seat 1, the server clock 5000100 at mono 100; the server's world
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_test_hear(b[..], 1, "y 1 2 5000100");
  #assert net_live(a[..]) && net_live(b[..]) && net_clock(a[..]) == 5000100 && net_probe(a[..], 5) == 1;
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  // A's hello goes out on its next frame: its look and class
  out: [WIRE_FRAME] u8;
  na[0].look_n = net_copy(na[0].look[..], "ranger.2.1.0");
  net_step(a[..], 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  h := net_test_sent(na[..], 'H', out[..]);
  r: [1] WireRd; r[0] = wire_rd(h, 1);
  hw := wire_read_hello(h, r[..]);
  #assert r[0].ok && hw.look == "ranger.2.1.0" && hw.kind == "druid";
  // the server's ticks at 30 Hz: A (seat 0) going +x 0.5 m a tick, B (seat 1) standing
  for q: 1..<4 {
    net_test_tick(room[..], q, 0);
    net_test_s(room[..], WireS.{id = 0, kind = WK_PLAYER, owner = 0, x = 10 + 0.5 * f32(q), z = 5, yaw = 0.5, vx = 15, g = WG_GROUND, hp = 57, max = 57});
    net_test_s(room[..], WireS.{id = 1, kind = WK_PLAYER, owner = 1, x = -3, z = 2, g = WG_GROUND | WG_AWAY, hp = 50, max = 57});
    if q == 1 { net_test_n(room[..], WireN.{ss = 0, id = "pa", look = "ranger.2.1.0", kind = "druid", flags = 2, name = "Ash Fen"}); }
    // each page steps to the tick's time and hears it then
    net_step(b[..], 100 + 33 * q, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
    net_step(a[..], 100 + 33 * q, 10, 0, 5, 0, 0, 0, false, 0, false, 0);
    #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  // each sees the other alone among the players (not itself), by its seat, name and class
  #assert net_count(a[..], WK_PLAYER) == 1 && net_count(b[..], WK_PLAYER) == 1;
  ob := net_view(b[..], WK_PLAYER, 0);
  #assert ob.ok && ob.eid == 0 && ob.seat == 0 && ob.owner == 0 && ob.hp == 57 && ob.alive && !ob.air && ob.account && !ob.away;
  #assert net_view_name(b[..], WK_PLAYER, 0) == "Ash Fen" && net_view_look(b[..], WK_PLAYER, 0) == "ranger.2.1.0" && net_view_class(b[..], WK_PLAYER, 0) == "druid";
  oa := net_view(a[..], WK_PLAYER, 0);
  #assert oa.eid == 1 && oa.hp == 50 && oa.away && !oa.account;
  // the ticks came on time: the delay is the floor's, and B draws A that far behind the server clock,
  // between its ticks (half way at a half tick)
  d := net_probe(b[..], 11);
  #assert d >= NET_LOW && d <= 140;
  net_step(b[..], 100 + 33 * 2 + 16 + d, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
  ob = net_view(b[..], WK_PLAYER, 0);
  #assert abs(ob.x - 11.24) < 0.05 && abs(ob.z - 5) < 0.01;
  // past its newest tick it goes on by its velocity NET_AHEAD ms at most, then holds
  net_step(b[..], 100 + 99 + d + 1000, -3, 0, 2, 0, 0, 0, false, 0, false, 0);
  ob = net_view(b[..], WK_PLAYER, 0);
  #assert abs(ob.x - (11.5 + 15 * f32(NET_AHEAD) / 1000)) < 0.05;
  // late ticks widen the buffer
  for q: 4..<24 {
    net_test_tick(room[..], q, 0);
    net_test_s(room[..], WireS.{id = 0, kind = WK_PLAYER, owner = 0, x = 12, z = 5, g = WG_GROUND});
    net_step(b[..], 100 + 33 * q + (ifx q % 2 == 0 then 0 else 90), -3, 0, 2, 0, 0, 0, false, 0, false, 0);
    #assert net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  #assert net_probe(b[..], 11) > d;
  // gone from B's view when the server says
  net_test_tick(room[..], 25, 0); net_test_x(room[..], 0);
  #assert net_test_hear(b[..], 1, net_test_frame(room[..])) && net_count(b[..], WK_PLAYER) == 0;
}
#test "net: your Reverse Gravity lifts the inputs after its cast and before its end, the room's order for them (#12877)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 2, "pa", 100) && net_test_hear(a[..], 2, "y 3 1 5000100");
  s1 := net_input(a[..], EgMoveIn.{key_y = 1}, false);
  #assert !net_own_rg(a[..]).on && !net_owns_rg(a[..]);
  // the cast (net_press takes its number and where it stands), an input, the end, an input
  na[0].seq += 1; na[0].rg_open = na[0].seq; na[0].rg_at = v3(1, 0, 2);
  s2 := net_input(a[..], EgMoveIn.{key_y = 1}, false);
  #assert net_own_rg(a[..]).on && net_owns_rg(a[..]) && net_own_rg(a[..]).at.x == 1;
  na[0].seq += 1; na[0].rg_close = na[0].seq;
  s3 := net_input(a[..], EgMoveIn.{key_y = 1}, false);
  #assert s2 == s1 + 2 && s3 == s2 + 2 && !net_own_rg(a[..]).on;
  // a re-run from the room's word on s1 steps s2 in it and s3 out of it
  na[0].fix.ack = s1;
  #assert net_replay_n(a[..]) == 2;
  _ := net_replay_input(a[..], 0);
  #assert net_own_rg(a[..]).on;
  _ = net_replay_input(a[..], 1);
  #assert !net_own_rg(a[..]).on;
  // a cast the room never raised is forgotten once it stepped NET_RG_LOST inputs past it
  na[0].rg_close = 0;
  na[0].acked = na[0].rg_open + NET_RG_LOST; net_own_rg_frame(a[..], na[..]);
  #assert net_owns_rg(a[..]);
  na[0].acked += 1; net_own_rg_frame(a[..], na[..]);
  #assert !net_owns_rg(a[..]);
}
#test "net: Reverse Gravity observations exclude doors boats and another caster's zone (#12946)" {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 2, "pa", 100) && net_test_hear(a[..], 2, "y 3 1 5000100");
