#test "net: a page in a room has each person in the conditions their row's COND says, and the abilities' holds follow them: Entangle's vines (#12873)" #steps 400000000 {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  // two guards heard, one Restrained by the room's rules; a third not heard
  g := EG_SPOTS;
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + g, kind = WK_FOLK, x = 1, z = 4, g = WM_CALM, hp = 11, max = 11, cond = WC_RESTRAINED});
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + g + 1, kind = WK_FOLK, x = 2, z = 4, g = WM_CALM, hp = 11, max = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  net_step(a[..], 200, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert net_folk(a[..], g).ok && net_folk(a[..], g).cond == WC_RESTRAINED;
  a[0].wv.rules_cond[g + 1] = WC_RESTRAINED; a[0].wv.rules_cond[g + 2] = WC_RESTRAINED;   // a page's own, before
  watch_net_frame(a[..]);
  #assert ab_rules_hold(a[..], g, WC_RESTRAINED) == 1 && ab_rules_hold(a[..], g + 1, WC_RESTRAINED) == 0 && ab_rules_hold(a[..], g + 2, WC_RESTRAINED) == 0;
  // the room lets the first go
  net_test_tick(room[..], 2, 0);
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + g, kind = WK_FOLK, x = 1, z = 4, g = WM_CALM, hp = 11, max = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  net_step(a[..], 260, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  watch_net_frame(a[..]);
  #assert ab_rules_hold(a[..], g, WC_RESTRAINED) == 0;
}
#test "net: the server's states two at once, late: another player walking is drawn moving every frame (no stall)" {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  // seat 1 walks +z 4 m/s; the server sends every second tick (15 Hz), and two of those come together
  // every 133 ms, 40 ms on their way (production's 15 Hz in pairs)
  heard := 0; least := 1000.0f32; most := 0.0f32; was := -1000.0f32;
  for ms: 0..<3000 {
    mono := 100 + ms;
    // the frames due by now: tick q (server time 5000100 + q * 33.3) comes at its time + 40 ms, a pair at the later's
    while true {
      q := 2 * (heard + 1);
      pair := 2 * ((heard + 2) / 2);   // the pair's later frame
      due := 100 + cast(int) (f32(2 * pair) * 33.33) + 40;
      if mono < due { break; }
      net_test_tick(room[..], q, 0);
      net_test_s(room[..], WireS.{id = 1, kind = WK_PLAYER, owner = 1, x = 0, z = f32(q) * 4.0 / 30.0, vz = 4, g = WG_GROUND, hp = 57, max = 57});
      #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
      heard += 1;
    }
    if ms % 16 != 0 { continue; }
    net_step(a[..], mono, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    v := net_view(a[..], WK_PLAYER, 0);
    if !v.ok || ms < 1000 { if v.ok { was = v.z; } continue; }
    gap := v.z - was; was = v.z;
    least = lo(least, gap); most = hi(most, gap);
  }
  // 16 ms frames at 4 m/s: 6.4 cm each; never standing, never leaping
  #assert least > 0.04 && most < 0.09;
  #assert net_probe(a[..], 11) <= NET_HIGH;
}
#test "net: what a player casts is the server's entity, alike on both pages, gone when it says" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // A casts Conjure Animals at a point: an intent, nothing made on A's page
  out: [WIRE_FRAME] u8;
  #assert net_cast(a[..], SP_SLOTS + AB_CONJURE, v3(4, 0, 7), -1) && net_count(a[..], -1) == 0;
  t := net_test_sent(na[..], 'C', out[..]);
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := wire_read_cast(t, r[..]);
  #assert r[0].ok && c.slot == SP_SLOTS + AB_CONJURE && abs(c.ax - 4) < 0.01 && abs(c.az - 7) < 0.01 && c.tgt == -1;
  // the server makes the pack (eid 40, A's) and both pages have it, A's slot on, B's not
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 40, kind = WK_PACK, owner = 0, x = 4, z = 7});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  #assert net_probe(a[..], 3) == 1 && net_probe(b[..], 3) == 1;
  #assert net_holds(a[..], AB_CONJURE) && !net_holds(b[..], AB_CONJURE);
  // it moves where the server moves it, on both
  for q: 2..<5 {
    net_test_tick(room[..], q, 0);
    net_test_s(room[..], WireS.{id = NET_MADE_ID + 40, kind = WK_PACK, owner = 0, x = 4 + f32(q), z = 7});
    #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  }
  net_step(a[..], 100 + 132 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 100 + 132 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pa := net_view(a[..], WK_PACK, 0); pb := net_view(b[..], WK_PACK, 0);
  #assert pa.ok && pb.ok && abs(pa.x - pb.x) < 0.001 && abs(pa.x - 8) < 0.01;
  // A presses its slot again: the end goes out (E SEQ 5 SLOT) and the server takes the pack away
  #assert net_end(a[..], SP_SLOTS + AB_CONJURE);
  t = net_test_sent(na[..], 'E', out[..]);
  r[0] = wire_rd(t, 1); u := wire_read_use(t, r[..]);
  #assert r[0].ok && u.kind == WE_END && u.id == SP_SLOTS + AB_CONJURE;
  net_test_tick(room[..], 6, 0); net_test_x(room[..], NET_MADE_ID + 40);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  #assert net_count(a[..], -1) == 0 && net_count(b[..], -1) == 0 && !net_holds(a[..], AB_CONJURE);
  // a refusal says why
  #assert net_test_hear(a[..], 0, "r 9 range") && cast(string) na[0].said[0..<na[0].said_n] == "CAN'T · RANGE";
}
#test "net: a cast aimed at the server's wolf names it (TGT 2000 + EID); one aimed away names none" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet; room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // A's wolf (eid 7, 11 Hit Points of 11) at (4, 7), on B's page too
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 7, kind = WK_BEAST, owner = 0, x = 4, z = 7, hp = 11, p1 = CI_FORM_WOLF, max = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  out: [WIRE_FRAME] u8;
  // B aims Starry Wisp a metre off it: the cast names wolf 7
  #assert net_cast(b[..], 22, v3(4.8, 0, 7.5), -1);
  t := net_test_sent(nb[..], 'C', out[..]);
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := wire_read_cast(t, r[..]);
  #assert r[0].ok && c.slot == 22 && c.tgt == 2007;
  // aimed 5 m off, it names none
  #assert net_cast(b[..], 22, v3(9, 0, 7), -1);
  t = net_test_sent(nb[..], 'C', out[..]);
  r[0] = wire_rd(t, 1); c = wire_read_cast(t, r[..]);
  #assert r[0].ok && c.tgt == -1;
  // the server says it took 6: both pages have 5 left
  net_test_tick(room[..], 2, 0);
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 7, kind = WK_BEAST, owner = 0, x = 4, z = 7, hp = 5, p1 = CI_FORM_WOLF, max = 11});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  ka := net_ent(na[..], NET_MADE_ID + 7, false); kb := net_ent(nb[..], NET_MADE_ID + 7, false);
  #assert ka >= 0 && kb >= 0 && na[0].ents[ka].hp == 5 && nb[0].ents[kb].hp == 5 && nb[0].ents[kb].max == 11;
}
// A test's page as it is once the room answered: the room's address, the local host left (#12882).
net_test_rooms :: (s: [] Everglade) {
  n := net_of(s);
  if n[0].local_host && n[0].asking { net_dest_swap(n); n[0].local_host = false; n[0].asking = false; }
}
#test "net: the page's facts name the socket: ?room=, ?relay= on this machine, and none for a golden page" {
  s: [1] Everglade; n: [1] EgNet;
  everglade_attach_net(s[..], n[..]);
  net_facts(s[..], "url=http://localhost:8787/worlds/everglade?relay=ws://localhost:8830&room=pair-x\nplayer=p1\n", "everglade", false);
  #assert cast(string) n[0].url[0..<n[0].url_n] == "ws://localhost:8830/api/room/relay/everglade/pair-x" && n[0].want;
  #assert net_room(s[..], "everglade") == "pair-x";
  // a bad name: the realm's instance list is asked which (everglade-join.coax)
  net_facts(s[..], "url=https://openagents.com/worlds/made-moss?room=Bad!\n", "made-moss", false);
  #assert cast(string) n[0].url[0..<n[0].url_n] == "wss://openagents.com/api/room/relay/everglade/" && n[0].want && n[0].join[0].list_due;
  net_facts(s[..], "url=https://openagents.com/worlds/everglade\n", "everglade", true);
  #assert !n[0].want;
  // ?offline=worker: the local host's one-seat room (#12784), no ticket and no list; never for a golden page
  l: [1] Everglade; nl: [1] EgNet;
  everglade_attach_net(l[..], nl[..]);
  net_facts(l[..], "url=https://openagents.com/worlds/everglade?offline=worker\n", "everglade", false);
  #assert nl[0].local_host && nl[0].want && !nl[0].join[0].list_due;
  #assert cast(string) nl[0].url[0..<nl[0].url_n] == "local:/api/room/relay/everglade/local-1";
  net_facts(l[..], "url=https://openagents.com/worlds/everglade?offline=worker\n", "everglade", true);
  #assert !nl[0].local_host;
  // Everglade from the first frame on the local host (#12882), the room asked meanwhile and gone to once
  // a ticket comes; a close before its seat brings you back. Not another realm's
  m: [1] Everglade; mn: [1] EgNet;
  everglade_attach_net(m[..], mn[..]);
  net_facts(m[..], "url=https://openagents.com/worlds/made-moss\n", "made-moss", false);
  #assert !mn[0].local_host && !mn[0].asking && mn[0].join[0].list_due;
  o: [1] Everglade; no: [1] EgNet;
  everglade_attach_net(o[..], no[..]);
  net_facts(o[..], "url=https://openagents.com/worlds/everglade\nplayer=p1\n", "everglade", false);
  local := "local:/api/room/relay/everglade/local-1";
  #assert no[0].local_host && no[0].asking && no[0].want && cast(string) no[0].url[0..<no[0].url_n] == local;
  #assert cast(string) no[0].away[0].url[0..<no[0].away[0].url_n] == "wss://openagents.com/api/room/relay/everglade/" && no[0].away[0].list_due;
  no[0].mono = 1000;
  net_ask_room(o[..], no[..]);
  #assert no[0].join[0].list_asked && !no[0].ticket_asked && cast(string) no[0].url[0..<no[0].url_n] == local;
  net_rooms(o[..], "200\n{\"join\":\"everglade-3\"}");
  #assert cast(string) no[0].url[0..<no[0].url_n] == local && cast(string) no[0].away[0].code[0..<no[0].away[0].code_n] == "everglade-3";
  net_ask_room(o[..], no[..]);
  #assert no[0].ticket_asked && no[0].local_host;
  // refused: you play on, and the room is asked again after a wait
  net_ticket(o[..], "502\n{}");
  #assert no[0].local_host && !no[0].ticket_asked && no[0].ask_at > 1000 && cast(string) no[0].url[0..<no[0].url_n] == local;
  net_ask_room(o[..], no[..]);
  #assert !no[0].ticket_asked;
  no[0].mono = no[0].ask_at;
  net_ask_room(o[..], no[..]);
  #assert no[0].ticket_asked;
  // a first visit's ticket: CHARACTER first, the local host on behind it
  net_ticket(o[..], "200\n{\"ticket\":\"abc\"}");
  #assert no[0].ticket_n == 3 && no[0].join[0].hold && no[0].local_host;
  no[0].state = NET_OPEN; no[0].sock = 1; no[0].seat = 0; pipe_drained(no[0].pipe[..]);   // seated on the local host
  net_ask_room(o[..], no[..]);
  #assert !no[0].room_wait && no[0].pipe[0].n == 0;
  no[0].join[0].hold = false;
  // then the room's socket opens beside the local host's, with the ticket, to the room's address
  net_ask_room(o[..], no[..]);
  #assert no[0].room_wait && no[0].ticket_n == 0 && no[0].pipe[0].n == 1 && pipe_bytes(no[0].pipe[..], 0) == "wss://openagents.com/api/room/relay/everglade/everglade-3?t=abc";
  #assert net_probe(o[..], 98) == 2 && cast(string) no[0].url[0..<no[0].url_n] == local;
  pipe_drained(no[0].pipe[..]);
  net_opened(o[..], 2);
  #assert no[0].room_sock == 2 && no[0].sock == 1 && !no[0].room_wait;
  // it closes before its seat: you play on on the local host, and the room is asked again later
  was := no[0].ask_at;
  #assert net_event(o[..], SOCKET_KIND + 4 * 2 + SOCKET_CLOSED, "");
  #assert no[0].room_sock < 0 && no[0].local_host && no[0].sock == 1 && no[0].seat == 0 && no[0].ask_at > was;
  // the next ticket's socket seats: it is the page's, the local host's closed
  no[0].mono = no[0].ask_at; no[0].ticket_n = net_copy(no[0].ticket[..], "def");
  net_ask_room(o[..], no[..]);
  pipe_drained(no[0].pipe[..]);
  net_opened(o[..], 3);
  #assert net_event(o[..], SOCKET_KIND + 4 * 3 + SOCKET_FRAME, "W 1 30 7 0 0 4000") && no[0].local_host;   // nothing before its seat
  #assert net_event(o[..], SOCKET_KIND + 4 * 3 + SOCKET_FRAME, "y 2 1 5000100");
  #assert !no[0].local_host && !no[0].asking && no[0].sock == 3 && no[0].room_sock < 0 && no[0].seat == 2 && net_live(o[..]) && net_probe(o[..], 98) == 0;
  #assert no[0].pipe[0].n == 1 && no[0].pipe[0].op[0] == 3;   // the local host's socket closed
  #assert cast(string) no[0].url[0..<no[0].url_n] == "wss://openagents.com/api/room/relay/everglade/everglade-3";
  // ?offline=worker: the local host only, the room never asked
  net_facts(o[..], "url=https://openagents.com/worlds/everglade?offline=worker\n", "everglade", false);
  #assert no[0].local_host && !no[0].asking;
  // ?stage=echo: a staged shot sits in no room, not even the local host's
  net_facts(o[..], "url=https://openagents.com/worlds/everglade?stage=echo&clock=0.95\n", "everglade", false);
  #assert !no[0].want && !no[0].local_host && !no[0].local_ok && !no[0].asking;
  // with ?raid=preview it is the raid's room, the local host's, where Echo fights for the watch (#12996)
  net_facts(o[..], "url=https://openagents.com/worlds/everglade?raid=preview&stage=echo\n", "everglade", false);
  #assert no[0].want || no[0].local_host;
  // a page with no socket attached is no room's
  t: [1] Everglade;
  #assert !net_live(t[..]) && net_room(t[..], "everglade") == "everglade" && net_probe(t[..], 0) == -1;
}
#test "net: a meteor swarm the server says falls on the same spots on both pages" #steps 1100000000 {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  dma: [1] DemoWorld; dmb: [1] DemoWorld;
  everglade_start(a[..]); a[0].sp.on = true; a[0].sp.ready = true; a[0].sp.dm = dma[..];
  everglade_start(b[..]); b[0].sp.on = true; b[0].sp.ready = true; b[0].sp.dm = dmb[..];
  room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // B casts; the server takes it at tick 6 (server 5000300) and tells both
  net_test_tick(room[..], 6, 0);
  net_test_cast(room[..], WireCastE.{ss = 1, slot = SP_METEOR, ax = 20, ay = 0, az = -15, seed = 77123});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  // not yet on A: it falls when B is drawn casting it, a jitter buffer behind
  net_step(a[..], 200, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert net_probe(a[..], 10) == 0;
  net_step(a[..], 300 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 300 + NET_HIGH, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  // B's cast bar (2.5 s) still fills: the meteors fall once it is done, on both pages (#12733)
  #assert net_probe(a[..], 10) == 0 && net_probe(b[..], 10) == 0;
  net_step(a[..], 300 + NET_HIGH + 2500, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 300 + NET_HIGH + 2500, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  #assert net_probe(a[..], 10) == 1 && net_probe(b[..], 10) == 1;
  live := 0;
  for q: 0..<SP_METEORS {
    ma := a[0].sp.meteors[SP_METEORS + q]; mb := b[0].sp.meteors[SP_METEORS + q];
    #assert ma.live && mb.live && ma.remote && abs(ma.to.x - mb.to.x) < 0.001 && abs(ma.to.z - mb.to.z) < 0.001;
    if ma.live { live += 1; }
    #assert !a[0].sp.meteors[q].live;   // nothing of this page's own
  }
  #assert live == SP_METEORS;
}
#test "net: each seat's abilities are their own on every page: two cylinders from the server's entities, each lifts, one gone ends only its own (#12733)" #steps 3000000000 {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  dma: [1] DemoWorld; dmb: [1] DemoWorld;
  everglade_start(a[..]); a[0].sp.on = true; a[0].sp.ready = true; a[0].sp.dm = dma[..];
  everglade_start(b[..]); b[0].sp.on = true; b[0].sp.ready = true; b[0].sp.dm = dmb[..];
  room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  // the server has seat 0's cylinder at (4, 4) and seat 1's at (60, 4)
  ga := walk_at(a[..], 4, 4); gb := walk_at(a[..], 60, 4);
  net_test_tick(room[..], 6, 0);
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 900001, kind = WK_ZONE, x = 4, y = ga, z = 4, yaw = 0, hp = -1, g = 1, owner = 0, p1 = AB_REVERSE, p2 = 1524});
  net_test_s(room[..], WireS.{id = NET_MADE_ID + 900002, kind = WK_ZONE, x = 60, y = gb, z = 4, yaw = 0, hp = -1, g = 1, owner = 1, p1 = AB_REVERSE, p2 = 1524});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  for t: 0..<4 {
    net_step(a[..], 300 + NET_HIGH + t * 33, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    net_step(b[..], 300 + NET_HIGH + t * 33, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  }
  for p: 0..<2 {
    g := ifx p == 0 then a[..] else b[..];
    #assert eg_ra_drawn(g, 0, AB_REVERSE) && eg_ra_drawn(g, 1, AB_REVERSE) && !ab_of(g)[0].rg_on;
    // your step in either rises on this page as on the server's (everglade_lift), between them it doesn't
    #assert everglade_lift(g, 5, 4, 0, 0, 0, 0, 1.0 / 30).on && everglade_lift(g, 61, 4, 0, 0, 0, 0, 1.0 / 30).on;
    #assert !everglade_lift(g, 32, 4, 0, 0, 0, 0, 1.0 / 30).on;
  }
  // seat 0's goes: only its own ends, on both pages
  net_test_tick(room[..], 8, 0);
  net_test_x(room[..], NET_MADE_ID + 900001);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  for t: 0..<4 {
    net_step(a[..], 500 + NET_HIGH + t * 33, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    net_step(b[..], 500 + NET_HIGH + t * 33, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  }
  for p: 0..<2 {
    g := ifx p == 0 then a[..] else b[..];
    #assert !eg_ra_drawn(g, 0, AB_REVERSE) && eg_ra_drawn(g, 1, AB_REVERSE);
    #assert !everglade_lift(g, 5, 4, 0, 0, 0, 0, 1.0 / 30).on && everglade_lift(g, 61, 4, 0, 0, 0, 0, 1.0 / 30).on;
  }
}
#test "net: two room pages draw the server's burnt trees and never advance their fire (#12940)" #steps 6000000000 {
  a: [1] Everglade; na: [1] EgNet; da: [1] DemoWorld;
  b: [1] Everglade; nb: [1] EgNet; db: [1] DemoWorld; room: [1] NetTestRoom;
  sp_ready_city(a[..], da[..]); sp_ready_city(b[..], db[..]);
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  tree := 0; id := 1162001;
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = id, kind = 26, x = a[0].trees[0], y = 0.2, z = a[0].trees[1],
    g = TF_FALL, hp = 250, max = 500, temp = 100, cond = 1, owner = 2, p1 = 1000, p2 = -200,
    t0 = 600, dur = 1500, carry = 3.4, form = 40000, life = 1});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  nb[0].mono += 250;   // the second page receives the same row later
  #assert net_test_hear(b[..], 1, net_test_frame(room[..]));
  for p: 0..<2 {
    s := ifx p == 0 then a[..] else b[..];
    net_step(s, 900, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    v := tf_of(s); k := tf_k(s, tree);
    #assert k > 0 && v[0].mode[k] == TF_FALL && abs(v[0].ax[k] - 1) < 0.001 && abs(v[0].az[k] + 0.2) < 0.001;
    #assert v[0].soot[k] == 0.25 && v[0].bare[k] == 0.5 && v[0].frost[k] == 0.1;
    #assert v[0].n == 1 && v[0].burn[0].by == 2 && abs(v[0].burn[0].t - 3.4) < 0.001;
    #assert net_forest_probe(s, 9001) == 1 && net_forest_probe(s, 9002) == 0 && net_forest_probe(s, 9003) == 1;
    #assert !tf_ignite(s, 1);   // even a local spell cannot start a room tree's fire
    u: [UNIFORM_FLOATS] f32; s[0].width = 1280; s[0].height = 800;
    for frame: 0..<60 { spells_frame(s, u[..], Shot.{}, 1.0 / 30.0); }
    #assert v[0].soot[k] == 0.25 && v[0].bare[k] == 0.5 && v[0].mode[k] == TF_FALL && v[0].n == 1;
  }
  // A complete later state repairs a missed update and gives both pages the same burnt trunk.
  net_test_tick(room[..], 90, 0);
  net_test_s(room[..], WireS.{id = id, kind = 26, x = a[0].trees[0], z = a[0].trees[1], g = TF_DOWN,
    hp = 1000, max = 1000, p1 = 1500, t0 = 600, dur = 1500, life = 1});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  for p: 0..<2 {
    s := ifx p == 0 then a[..] else b[..];
    net_step(s, 4000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    v := tf_of(s); k := tf_k(s, tree);
    #assert k > 0 && v[0].mode[k] == TF_DOWN && v[0].soot[k] == 1 && v[0].bare[k] == 1 && v[0].n == 0;
  }
  net_test_tick(room[..], 91, 0); net_test_x(room[..], id);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  for p: 0..<2 {
    s := ifx p == 0 then a[..] else b[..];
    net_step(s, 4100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    #assert tf_k(s, tree) == 0 && tf_count(s) == 0;
  }
  // The same planted tree can later occupy another sparse record. A delayed removal of the old
  // record cannot erase it; that old record can then track a different tree under a new LIFE.
  net_test_tick(room[..], 92, 0);
  net_test_s(room[..], WireS.{id = 1162002, kind = 26, clip = 0, x = a[0].trees[0], z = a[0].trees[1],
    g = TF_DOWN, hp = 1000, max = 1000, p1 = 1500, dur = 1500, life = 1});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  net_test_tick(room[..], 93, 0); net_test_x(room[..], 1162001);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  net_test_tick(room[..], 94, 0);
  net_test_s(room[..], WireS.{id = 1162001, kind = 26, clip = 1, x = a[0].trees[TREE_FLOATS], z = a[0].trees[TREE_FLOATS + 1],
    g = TF_DOWN, hp = 1000, max = 1000, p1 = 1500, dur = 1500, life = 2});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  for p: 0..<2 {
    s := ifx p == 0 then a[..] else b[..];
    net_step(s, 4300, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    #assert tf_k(s, 0) > 0 && tf_k(s, 1) > 0;
    #assert tf_of(s)[0].soot[tf_k(s, 0)] == 1 && tf_of(s)[0].soot[tf_k(s, 1)] == 1;
    #assert net_forest_probe(s, 9002) == 2 && net_forest_probe(s, 9003) == 0;
  }
  #assert net_forest_probe(a[..], 9004) == net_forest_probe(b[..], 9004);
}
#test "net: a delayed world header dates its tick at the server, including either side of midnight" {
  for side: 0..<2 {
    for delay: 0..<3 {
      a: [1] Everglade; n: [1] EgNet;
      #assert net_test_page(a[..], n[..], 0, "pa", 100);
      at := 2 * WIRE_DAY_MS + (ifx side == 0 then -40 else 40);
      buf: [128] u8;
      // Establish a server clock before the header spends time in transit.
      hello: [160] u8;
      h := wire_int(hello[..], wire_put(hello[..], 0, "y 0 1"), at);
      #assert net_test_hear(a[..], 0, cast(string) hello[0..<h]);
      late := ifx delay == 0 then 0 else ifx delay == 1 then 125 else 750;
      n[0].mono += late;
      m := wire_put_world(buf[..], 0, WireWorld.{tick = 17, hz = 30, day = at % WIRE_DAY_MS, weather = WEATHER_CLEAR + 1});
      #assert net_test_hear(a[..], 0, cast(string) buf[0..<m]);
      #assert net_tick_t(n[..], 17) == at && net_tick_t(n[..], 18) == at + 33;
      want := f32((at + late) % WIRE_DAY_MS) / f32(WIRE_DAY_MS);
      #assert abs(net_sky_day(a[..]) - want) < 0.00001;
      n[0].offset += 200;   // a ping improves the clock after the header: its authored time stays put
      #assert net_tick_t(n[..], 17) == at;
    }
  }
}
#test "net: headers without a valid server day retain their receipt-time fallback" {
  n: [1] EgNet; n[0].mono = 100; n[0].offset = 5000000;
  #assert net_world_t(n[..], WireWorld.{day = 5}) == 5000100;
  #assert net_world_t(n[..], WireWorld.{day = -1, weather = 1}) == 5000100;
  #assert net_world_t(n[..], WireWorld.{day = WIRE_DAY_MS, weather = 1}) == 5000100;
  n[0].offset = -100;
  #assert net_world_t(n[..], WireWorld.{day = 5, weather = 1}) == 0;
  // A clock estimate just behind the server crosses midnight the other way.
  n[0].mono = 2 * WIRE_DAY_MS - 40; n[0].offset = 0;
  #assert net_world_t(n[..], WireWorld.{day = 40, weather = 1}) == 2 * WIRE_DAY_MS + 40;
}
#test "net: the time of day and the weather are the server's: two pages 4 s apart on their own clocks draw the same sky" {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  everglade_attach_net(a[..], na[..]); everglade_attach_net(b[..], nb[..]);
  // A's wall clock says 5000 s, B's 5004 s
  net_facts(a[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pa\nnow=5000000\nnav=0\n", "everglade", false);
  net_facts(b[..], "url=https://openagents.com/worlds/everglade?room=pair-a\nplayer=pb\nnow=5004000\nnav=0\n", "everglade", false);
  #assert net_sky_day(a[..]) < 0 && net_sky_ms(a[..]) < 0;   // no room: each page's own
  for p: 0..<2 {
    pg := ifx p == 0 then a[..] else b[..];
    net_step(pg, 100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    pipe_drained(net_of(pg)[0].pipe[..]);
    net_opened(pg, p);
    #assert net_event(pg, SOCKET_KIND + 4 * p + SOCKET_OPENED, "");
  }
  // the server's clock is 7000 s: its day 7000 s in, its weather rain
  #assert net_test_hear(a[..], 0, "y 0 1 7000100") && net_test_hear(b[..], 1, "y 1 2 7000100");
  buf: [128] u8;
  m := wire_put_world(buf[..], 0, WireWorld.{tick = 0, seed = 41, day = 7000100 % WIRE_DAY_MS, weather = WEATHER_RAIN + 1});
  #assert net_test_hear(a[..], 0, cast(string) buf[0..<m]) && net_test_hear(b[..], 1, cast(string) buf[0..<m]);
  // a minute on: the same time of day and the same weather tick on both
  net_step(a[..], 60100, 0, 0, 0, 0, 0, 0, false, 0, false, 0); net_step(b[..], 60100, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  want := f32((7000100 + 60000) % WIRE_DAY_MS) / f32(WIRE_DAY_MS);
  #assert abs(net_sky_day(a[..]) - want) < 0.00001 && net_sky_day(a[..]) == net_sky_day(b[..]);
  #assert net_sky_ms(a[..]) == 7060100.0 && net_sky_ms(b[..]) == 7060100.0;
  // the server's rain over the page's schedule: pinned where it differs, left where it agrees
  ws: [1] WeatherSchedule;
  weather_schedule(ws[..], weather_temperate(), WIRE_WEATHER_SEED);
  tick := weather_tick_at(7060100);
  net_sky_weather(a[..], ws[..], tick);
  #assert weather_states(ws[..], tick + cast(u64) (90 * WEATHER_TICK_HZ)).after == WEATHER_RAIN;
  pins := ws[0].pin_n;
  net_sky_weather(a[..], ws[..], tick + 100);
  #assert ws[0].pin_n == pins;
  // closed under you: still the room's sky while the page rejoins (no jump to the page's own)
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") && net_rejoining(a[..]) && net_sky_day(a[..]) >= 0;
  // and the wire's day is the page's 48-minute day, its seed the page's weather's
  #assert WIRE_DAY_MS == cast(int) (STYLE_CYCLE_SECONDS * 1000) && WIRE_WEATHER_SEED == EG_WEATHER_SEED;
}
#test "net: a socket that goes quiet is closed and tried again; a hidden tab's gap is not quiet" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  // frames every 100 ms: it stays
  t := 100;
  for k: 0..<80 { t += 100; _ := net_test_hear(a[..], 0, "t 1"); net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0); }
  #assert net_live(a[..]);
  pipe_drained(na[0].pipe[..]);
  // the tab is hidden 40 s (no frames drawn), then draws again: a fresh wait, not a loss
  t += 40000; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  for k: 0..<50 { t += 100; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0); }
  #assert net_live(a[..]);
  // nothing heard past NET_SILENT_MS while drawing: closed, said, and opened again after the wait
  for k: 0..<20 { t += 100; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0); }
  #assert !net_open(a[..]) && net_rejoining(a[..]) && na[0].state == NET_DOWN && na[0].lost && cast(string) na[0].said[0..<na[0].said_n] == "LOST THE ROOM · REJOINING";
  closed := false;
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == PIPE_CLOSE && na[0].pipe[0].id[k] == 0 { closed = true; } }
  #assert closed;
  pipe_drained(na[0].pipe[..]);
  // the face's close comes back for the old socket: it is no longer ours
  #assert !net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  na[0].ticket_n = net_copy(na[0].ticket[..], "tk2");
  t += 1100; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].state == NET_OPENING && na[0].pipe[0].n >= 1 && na[0].pipe[0].op[0] == PIPE_OPEN;
  pipe_drained(na[0].pipe[..]);
  // it opens as socket 1 and never answers: past NET_OPEN_MS it is tried again
  net_opened(a[..], 1);
  for k: 0..<101 { t += 100; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0); }
  #assert na[0].state == NET_DOWN;
}
#test "net: a room that drains says restarting; the page closes, asks for a new seat and joins again a second on (#12797)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  t := 200;
  net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  #assert net_test_hear(a[..], 0, "r 0 restarting");
  #assert !net_open(a[..]) && na[0].state == NET_DOWN && !na[0].lost && na[0].ticket_n == 0;
  #assert cast(string) na[0].said[0..<na[0].said_n] == "RESTARTING · BACK IN A MOMENT";
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == PIPE_CLOSE && na[0].pipe[0].id[0] == 0;
  pipe_drained(na[0].pipe[..]);
  // the room's close of the old socket is no longer the page's, and says nothing more
  #assert !net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") && !na[0].lost;
  // within about a second it asks again
  #assert na[0].retry - na[0].mono <= 1250;
}
#test "net: a tab shown after a long time hidden replaces its socket at once; a short one keeps it (#12856)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  t := 200;
  net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  // hidden 10 s: the same socket
  _h := net_life(a[..], LC_HIDDEN);
  t += 10000; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  sh := net_life(a[..], LC_SHOWN);
  #assert sh.does == LC_START_CLOCK && net_open(a[..]) && na[0].sock == 0;
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != PIPE_CLOSE; }
  // hidden past LIFECYCLE_RESYNC ticks: shown closes it and opens a new one on the next step, unsaid
  _h2 := net_life(a[..], LC_HIDDEN);
  t += LIFECYCLE_RESYNC * 1000 / WIRE_HZ + 100; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  sh = net_life(a[..], LC_SHOWN);
  #assert (sh.does & LC_FULL_STATE) != 0 && na[0].state == NET_DOWN && !na[0].lost;
  closed := false;
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == PIPE_CLOSE && na[0].pipe[0].id[k] == 0 { closed = true; } }
  #assert closed;
  pipe_drained(na[0].pipe[..]);
  na[0].ticket_n = net_copy(na[0].ticket[..], "tk2");
  t += 20; net_step(a[..], t, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].state == NET_OPENING && na[0].pipe[0].n >= 1 && na[0].pipe[0].op[0] == PIPE_OPEN;
}
#test "net: back online (host.js 612), the page replaces its socket at once and rejoins, unsaid (#12856)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]);
  net_step(a[..], 200, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  pipe_drained(na[0].pipe[..]);
  l := net_life(a[..], LC_NET);
  #assert (l.does & LC_NEW_SOCKET) != 0 && na[0].state == NET_DOWN && !na[0].lost && na[0].want;
  closed := false;
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == PIPE_CLOSE && na[0].pipe[0].id[k] == 0 { closed = true; } }
  #assert closed;
  pipe_drained(na[0].pipe[..]);
  na[0].ticket_n = net_copy(na[0].ticket[..], "tk2");
  net_step(a[..], 220, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].state == NET_OPENING && na[0].pipe[0].op[0] == PIPE_OPEN;
  // while no socket is open, a second change does nothing more
  pipe_drained(na[0].pipe[..]);
  _ := net_life(a[..], LC_NET);
  for k: 0..<na[0].pipe[0].n { #assert na[0].pipe[0].op[k] != PIPE_CLOSE; }
}
#test "net: a room lost under you is said, and so is getting back; you stay in the room's game meanwhile, and nothing goes out" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert !net_live(a[..]);   // never sat: offline
  #assert net_test_hear(a[..], 0, "y 0 1 5000100") && net_live(a[..]) && !net_rejoining(a[..]);
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "");
  #assert na[0].lost && cast(string) na[0].said[0..<na[0].said_n] == "LOST THE ROOM · REJOINING";
  // still the room's game (its kit, level and rules), not the offline one; casts and steps wait for the socket
  #assert net_live(a[..]) && net_rejoining(a[..]) && !net_open(a[..]) && !net_cast(a[..], 0, Point.{}, -1) && net_input(a[..], EgMoveIn.{key_y = 1}, false) == 0;
  // tried again after a second, jittered a quarter either way
  #assert na[0].retry - na[0].mono >= 750 && na[0].retry - na[0].mono <= 1250;
  // the socket opens again and the relay seats you: back
  na[0].state = NET_OPEN; na[0].sock = 0;
  #assert net_test_hear(a[..], 0, "y 3 1 5009000") && net_live(a[..]);
  #assert !na[0].lost && cast(string) na[0].said[0..<na[0].said_n] == "BACK IN THE ROOM";
}

// A walker at 1.2 m/s as the server would send it to seat 0 (everglade-wire.coax's seat frames:
// deltas against what this page said it heard), its ticks late by up to `jitter` ms and one in
// `lose` lost: how many frames the page drew it walking, how many of those where the frame before had
// it, how far it was drawn from where it was at the time drawn, at most (cm), and its largest move
// between two frames and back (cm). With `jump`, it
// jumps 20 m on at tick 270 (a teleport): `between` counts the frames drawn more than 1 m off both sides.
// With `resend` ms, the socket's: 125 ms on the way, and one frame in 30 lost and sent again `resend`
// ms later, every frame after it held behind it (TCP's order, coax/web/room/net-proxy.coax).
NET_TEST_WAY :: 16;
NetTestWalk :: struct { walk: int; still: int; err_cm: int; held: bool; bad: int; between: int; step_cm: int; back_cm: int; }
net_test_walk :: (jitter: int, lose: int, jump: bool, resend: int) -> NetTestWalk {
  a: [1] Everglade; na: [1] EgNet; room: [1] NetTestRoom;
  out := NetTestWalk.{};
  if !net_test_page(a[..], na[..], 0, "pa", 100) || !net_test_hear(a[..], 0, "y 0 1 5000100") { return out; }
  net_test_world(room[..], 0);
  if !net_test_hear(a[..], 0, net_test_frame(room[..])) { return out; }
  h: [1] WireHist; st: [1] WireSeat;
  // the frames on their way, in order (one socket): each one's text and when it comes
  way: [NET_TEST_WAY * 512] u8; way_n: [NET_TEST_WAY] int; way_at: [NET_TEST_WAY] int; way_head := 0; way_len := 0; last_at := 0;
  seed := 12345;
  t := 0; mono := 100; walk0 := 0; still0 := 0; last_x := 0.0f32;
  for frame: 0..<600 {
    mono = 100 + frame * 16;
    // the server's ticks due by now (the last 60 none: a long gap)
    while frame < 540 && 100 + (t + 1) * 1000 / 30 <= mono {
      t += 1;
      wire_seat_ack(st[..], h[..], na[0].mir[0].heard);   // the page's I says what it heard
      wire_hist_begin(h[..], t);
      wire_hist_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, owner = 0, g = WG_GROUND, hp = 10, max = 10}, wire_rel(WK_PLAYER), true, false);
      wire_hist_put(h[..], 16, WireS.{id = NET_FOLK_ID, kind = WK_FOLK, x = 1.2 * f32(t) / 30 + (ifx jump && t >= 270 then 20.0 else 0.0), z = 4, yaw = 1.57, g = WM_CALM, clip = 1, hp = 4}, wire_rel(WK_FOLK), false, true);
      seed = (seed * 1103515245 + 12345) % 2147483648;
      if lose > 0 && (seed / 65536) % lose == 0 { continue; }   // the relay's queue had no room
      if way_len >= NET_TEST_WAY { continue; }
      q := (way_head + way_len) % NET_TEST_WAY;
      b := way[q * 512..<q * 512 + 512];
      n := wire_put_d(b, 0, WireD.{tick = t, ack = 0, f = ifx t == 1 then 1 else 0, part = 0});
      n += wire_seat_frame(st[..], h[..], 0, 0, 0, 120, WIRE_BUDGET, b[n..<512]);
      late := ifx jitter > 0 then (seed / 7) % (jitter + 1) else 0;
      if resend > 0 { late += 125; if (seed / 1024) % 30 == 0 { late += resend; } }
      way_n[q] = n; way_at[q] = hi_int(last_at, 100 + t * 1000 / 30 + late); last_at = way_at[q];
      way_len += 1;
    }
    // what has come by now, heard in order
    while way_len > 0 && way_at[way_head] <= mono {
      _ := net_test_hear(a[..], 0, cast(string) way[way_head * 512..<way_head * 512 + way_n[way_head]]);
      way_head = (way_head + 1) % NET_TEST_WAY; way_len -= 1;
    }
    net_step(a[..], mono, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
    if frame == 60 { walk0 = net_probe(a[..], 41); still0 = net_probe(a[..], 42); }
    if frame == 540 { out.walk = net_probe(a[..], 41) - walk0; out.still = net_probe(a[..], 42) - still0; }
    if frame >= 60 && frame < 540 {
      f := net_folk(a[..], 0);
      if f.ok && frame > 60 { d := f.x - last_x; out.step_cm = hi_int(out.step_cm, cast(int) (abs(d) * 100)); if d < 0 { out.back_cm = hi_int(out.back_cm, cast(int) (-d * 100)); } }
      if f.ok { last_x = f.x; }
      if f.ok {
        // where it was at the time drawn: the server's clock less the drawn delay
        rt := na[0].rt;
        truth := 1.2 * f32(rt - 5000100) / 1000;
        e := abs(f.x - truth);
        if jump { e2 := abs(f.x - truth - 20); if e2 < e { e = e2; } if e > 1 { out.between += 1; } }
        else { out.err_cm = hi_int(out.err_cm, cast(int) (e * 100)); }
      }
    }
  }
  // after the long gap: on by its velocity NET_AHEAD ms, then held where it was
  f1 := net_folk(a[..], 0);
  net_step(a[..], mono + 16, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  out.held = f1.ok && net_folk(a[..], 0).x == f1.x;
  out.bad = na[0].mir[0].bad;
  return out;
}
#test "net: a walker drawn from the buffer moves every frame through late and lost ticks and stays near where it was; after a long gap it holds" #steps 4000000000 {
  // on time, every tick: moving every frame drawn, within a centimetre or two
  w := net_test_walk(0, 0, false, 0);
  #assert w.walk > 400 && w.still == 0 && w.err_cm <= 3 && w.held && w.bad == 0;
  // up to 60 ms late and one tick in 8 lost: the buffer grows past the lateness; still never drawn standing
  w = net_test_walk(60, 8, false, 0);
  #assert w.walk > 400 && w.still * 100 < w.walk * 5 && w.err_cm <= 20 && w.held && w.bad == 0;
  // one in 3 lost: the deltas still read (a base it acknowledged), and it moves on its velocity between
  w = net_test_walk(30, 3, false, 0);
  #assert w.walk > 400 && w.still * 100 < w.walk * 5 && w.err_cm <= 30 && w.bad == 0;
  // a teleport 20 m on (a WARP): drawn where it was, then where it landed, never a frame between
  w = net_test_walk(30, 8, true, 0);
  #assert w.walk > 400 && w.between == 0 && w.bad == 0;
  // a socket that loses a read about once a second and sends it again two round trips later (500
  // ms at 250 ms): the townsperson goes on their way through each hold, never drawn standing, and
  // the buffer's growth after it never draws them back or on in a jump (#12890)
  w = net_test_walk(30, 0, false, 500);
  #assert w.walk > 400 && w.still * 100 < w.walk * 2 && w.err_cm <= 30 && w.bad == 0 && w.back_cm == 0 && w.step_cm <= 4;
}

#test "net: travel (#12850): T asks the room; g sends the page to the instance with a new ticket, not as a lost room" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  #assert net_test_hear(a[..], 0, "y 0 1 5000100");
  pipe_drained(na[0].pipe[..]);
  o: [64] u8;
  #assert !net_travel(a[..], "pair-a") && !net_travel(a[..], "Pair B") && net_travel(a[..], "pair-b");
  #assert jn_has(net_test_sent(na[..], 'T', o[..]), "T ") && jn_has(cast(string) o[..], " pair-b");
  #assert net_test_hear(a[..], 0, "g pair-b");
  #assert cast(string) na[0].code[0..<na[0].code_n] == "pair-b" && !net_open(a[..]) && !na[0].lost && na[0].want;
  #assert cast(string) na[0].said[0..<na[0].said_n] == "TRAVELLING TO PAIR-B";
  closed := false;
  for k: 0..<na[0].pipe[0].n { if na[0].pipe[0].op[k] == PIPE_CLOSE && na[0].pipe[0].id[k] == 0 { closed = true; } }
  #assert closed;
  pipe_drained(na[0].pipe[..]);
  // the old socket's close is no longer the page's; the next step asks a ticket for pair-b
  #assert !net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") || !na[0].lost;
  net_step(a[..], 200, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert na[0].pipe[0].n == 1 && na[0].pipe[0].op[0] == NET_PIPE_TICKET && jn_has(pipe_bytes(na[0].pipe[..], 0), "/api/playtest/room-ticket/pair-b?realm=everglade");
}
#test "net: a newer ticket took your character (r 0 elsewhere): the page says so and opens no socket again (#12834)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  net_step(a[..], 120, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert net_test_hear(a[..], 0, "r 0 elsewhere") && na[0].elsewhere && !na[0].want;
  #assert cast(string) na[0].said[0..<na[0].said_n] == "YOU'RE PLAYING ELSEWHERE · RELOAD TO PLAY HERE";
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") && !na[0].lost && !net_rejoining(a[..]);
  pipe_drained(na[0].pipe[..]);
  for t: 0..<20 { net_step(a[..], 2000 + t * 5000, 0, 0, 0, 0, 0, 0, false, 0, false, 0); #assert na[0].pipe[0].n == 0; }
  #assert a[0].action == 0;
}
#test "net: a room on another wire version refuses the hello; the page says a new version is out, opens no socket again and reloads once" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100);
  // the hello says this page's WIRE_VERSION
  net_step(a[..], 120, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert net_test_hear(a[..], 0, "r 0 version") && na[0].stale;
  #assert cast(string) na[0].said[0..<na[0].said_n] == "A NEW VERSION IS OUT · RELOADING";
  #assert net_event(a[..], SOCKET_KIND + SOCKET_CLOSED, "") && !na[0].lost;
  // no open again, however long; the reload after NET_RELOAD_MS: this page's path with reload=1
  net_step(a[..], 1000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert a[0].action == 0;
  for t: 0..<20 { net_step(a[..], 2000 + t * 5000, 0, 0, 0, 0, 0, 0, false, 0, false, 0); #assert na[0].pipe[0].n == 0 || na[0].pipe[0].op[0] != PIPE_OPEN; if t == 0 { #assert a[0].action == NET_ACT_NAVIGATE && cast(string) a[0].outbox[0..<a[0].out_n] == "/worlds/everglade?room=pair-a&reload=1"; a[0].action = 0; } }
  #assert a[0].action == 0;   // once
  // the reloaded page still old (reload=1 in its address): it asks you to reload, and doesn't
  b: [1] Everglade; nb: [1] EgNet;
  #assert net_test_page(b[..], nb[..], 0, "pa", 100);
  nb[0].join[0].href_n = net_copy(nb[0].join[0].href[..], "https://openagents.com/worlds/everglade?room=pair-a&reload=1");
  #assert net_test_hear(b[..], 0, "r 0 version");
  #assert cast(string) nb[0].said[0..<nb[0].said_n] == "A NEW VERSION IS OUT · RELOAD THE PAGE";
  net_step(b[..], 5000, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  #assert b[0].action == 0;
}
#test "net probes: 63 is your facing and 84 whether you play in a room, each field once" {
  g: [1] Everglade; gn: [1] EgNet;
  everglade_attach_net(g[..], gn[..]);
  g[0].face = 0.5;
  #assert net_probe(g[..], 63) == 500 && net_probe(g[..], 84) == 0 && net_probe(g[..], 85) == 0;
}

#test "raid arrival acknowledges only your confirmed enemy hit" {
  g:[1]Everglade; nn:[1]EgNet; everglade_attach_net(g[..],nn[..]);
  n:=net_of(g[..]); n[0].seat=0; n[0].state=NET_OPEN;
  g[0].started=true;g[0].rp.on=true;g[0].time=10;
  q:=net_ent(n,NET_MADE_ID+9,true);n[0].ents[q].kind=WK_BEAST;n[0].ents[q].p1=27;
  d:WireD;
  net_entry(g[..],n,"e hit 2009 1001 5 1",d); #assert !g[0].guide.raid_helped;
  net_entry(g[..],n,"e hit 2009 1000 0 1",d); #assert !g[0].guide.raid_helped;
  net_entry(g[..],n,"e hit 2009 1000 5 1",d); #assert g[0].guide.raid_helped && g[0].guide.raid_help_at==10;
  g[0].time=12;net_entry(g[..],n,"e hit 2009 1000 5 1",d);#assert g[0].guide.raid_help_at==10;
}
#test "net: a Character Create class's slot 1 the server says plays its look on both pages (#13024)" #steps 1100000000 {
  a: [1] Everglade; na: [1] EgNet; b: [1] Everglade; nb: [1] EgNet;
  dma: [1] DemoWorld; dmb: [1] DemoWorld;
  everglade_start(a[..]); a[0].sp.on = true; a[0].sp.ready = true; a[0].sp.dm = dma[..];
  everglade_start(b[..]); b[0].sp.on = true; b[0].sp.ready = true; b[0].sp.dm = dmb[..];
  room: [1] NetTestRoom;
  #assert net_test_pair(a[..], na[..], b[..], nb[..], room[..]);
  cl_set(a[..], CL_DRUID);
  net_test_tick(room[..], 6, 0);
  net_test_cast(room[..], WireCastE.{ss = 0, slot = CL_SLOT0 + CL_DRUID, ax = 4, ay = 0, az = 8, seed = 4242});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..])) && net_test_hear(b[..], 1, net_test_frame(room[..]));
  net_step(a[..], 300 + NET_HIGH, 0, 0, 0, 0, 0, 0, false, 0, false, 0);
  net_step(b[..], 300 + NET_HIGH, 3, 0, 9, 0, 0, 0, false, 0, false, 0);
  #assert net_probe(a[..], 991) == 1 && net_probe(b[..], 991) == 0;   // yours on your page; another's look on theirs
  #assert fxp_live(a[0].wl.fx[..]) > 0 && fxp_live(b[0].wl.fx[..]) > 0;
}
