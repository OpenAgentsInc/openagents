// The Cultist Raid's standing siege (spec docs/verse/2026-11-03-everglade-world-events.md, section 4;
// #12860): the front between Everglade's watch and Darian Odiodei's cult on the south road, and how
// each side's strength, reinforcements and the players' help move it. The room server's raid
// (coax/web/room/room-events.coax, everglade5e-room-raid.coax) steps it, offline on the local host
// too (#12908). Pure arithmetic on the line's place: no state of its own
// but what RfFront holds.
//
// The line runs along the road from the cult's camp (RF_CAMP_Z) to the palisade's South Gate
// (RF_GATE_Z). Each second:
//   - each side's strength is the fighters it has standing, times how far it has come from home:
//     a side past the band's middle (RF_MID_Z) toward the other's base overextends, and its strength
//     falls by 1 for each RF_OVER_M metres past it, to RF_OVER_LEAST at most (rf_over);
//   - the players' worth (everglade-raid-scale.coax raid_player_worth: their damage, kills, heals,
//     repairs and objectives, in fighters) joins the watch's;
//   - the line moves toward the weaker side's base at RF_SPEED times the strengths' difference over
//     their sum (rf_step), never past RF_HOLD_Z (the watch holds at the gate) nor the camp;
//   - each side's next reinforcement wave comes every RF_EVERY_S, sooner by up to RF_RUBBER when
//     the line has been pushed toward its base (rf_every): the side losing ground reinforces faster.
// With no players, matched caps and these two pulls hold the line in a band about RF_MID_Z, in the
// field before the palisade (RF_BAND either side). Players tip it: about 4 active ones push it to the
// camp (RF_STAND_Z), where the camp's ward stones can break.
//   coax test --library apps/openagents-web/everglade5e-rules.coax --only "raid front"

#load "../../verse/everglade/points.coax";   // the front's places, by name, for the scripted checks (#13078)
RF_CAMP_Z :: -106.0;     // m: the cult's camp on the south road
RF_GATE_Z :: -56.0;      // m: the palisade's South Gate
RF_HOLD_Z :: -61.0;      // m: the nearest the line comes to the gate: the watch holds there
RF_MID_Z :: -72.0;       // m: the band's middle, the field before the palisade
RF_BAND :: 9.0;          // m either side of the middle that the line keeps with no players
RF_STAND_Z :: -100.0;    // m: the line here or past it has reached the camp
RF_SPEED :: 0.5;         // m/s the line moves at most
RF_OVER_M :: 40.0;       // m past the middle that take a whole fighter's strength away
RF_OVER_LEAST :: 0.3;    // the least share of its strength an overextended side keeps
RF_EVERY_S :: 10.0;      // s between a side's reinforcement waves
RF_RUBBER :: 0.6;        // the share of RF_EVERY_S a side pushed RF_OVER_M toward home saves
RF_WAVE_PART :: 1;       // a reinforcement wave is a side's cap over this, at least 2: 1 fills what it lacks
RF_ARMY :: 0.85;         // the share of a side's strength that is its whole army's (rf_step_caps), the rest its standing's
RF_CULT :: 0; RF_TOWN :: 1;
#test "raid front: its places are Everglade's named points, the ones the scripted checks stand at" {
  #assert eg_point("gate-south").z == f32(RF_GATE_Z) && eg_point("raid-front").z == f32(RF_HOLD_Z);
  #assert eg_point("raid-field").z == f32(RF_MID_Z) && eg_point("cult-camp").z == f32(RF_CAMP_Z);
}
// the line's front rank, and the ranged ranks behind it, m from the line
RF_MELEE_M :: 1.2; RF_RANGED_M :: 12.0; RF_LEAD_M :: 22.0;
RF_HALF_W :: 26.0;       // m either side of the road the ranks spread
RF_WALL_Z :: -58.0;      // m: the watch's ranks stand no nearer the town than this (outside the wall)
// The watch's mix, by its Hit Points' turn (aethyr/rules/srd/npcs.coax): Guards and a Knight hold
// the line, Veterans (Heavy Crossbow) and Scouts (Longbow) shoot from behind it.
RF_TOWN_MIX :: [12] int.[RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_KNIGHT, RS_NPC_SCOUT, RS_NPC_GUARD, RS_NPC_VETERAN,
                         RS_NPC_GUARD, RS_NPC_SCOUT, RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_SCOUT, RS_NPC_VETERAN];

RfFront :: struct {
  z: f32 = RF_MID_Z;       // where the line is
  due: [2] f32;            // s to each side's next reinforcement wave (RF_CULT, RF_TOWN)
  v: f32;                  // m/s it moved in the last step: + toward the camp
  cult: f32; town: f32;    // each side's strength in the last step (fighters)
}

rf_lo :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }
rf_hi :: (a: f32, b: f32) -> f32 { return ifx a > b then a else b; }
rf_clamp :: (v: f32, a: f32, b: f32) -> f32 { return rf_hi(rf_lo(v, b), a); }
// A side's share of its strength `past` m beyond the band's middle toward the other's base.
rf_over :: (past: f32) -> f32 {
  if past <= 0 { return 1; }
  return rf_hi(1 - past / f32(RF_OVER_M), f32(RF_OVER_LEAST));
}
// The line's place as a share of the road: 0 at the camp, 1 at the gate (the HUD's bar).
rf_u :: (z: f32) -> f32 { return rf_clamp((z - f32(RF_CAMP_Z)) / (f32(RF_GATE_Z) - f32(RF_CAMP_Z)), 0, 1); }
// The strengths with the line at z: the cult's of n_cult standing, the watch's of n_town and the
// players' worth (in fighters), into o[0] and o[1].
rf_strengths :: (z: f32, n_cult: f32, n_town: f32, worth: f32, o: [] f32) {
  o[0] = n_cult * rf_over(z - f32(RF_MID_Z));
  o[1] = n_town * rf_over(f32(RF_MID_Z) - z) + rf_hi(worth, 0);
}
// Seconds between side's waves with the line at z: RF_EVERY_S, less up to RF_RUBBER of it as the
// line nears that side's base.
rf_every :: (side: int, z: f32) -> f32 {
  lost := ifx side == RF_CULT then f32(RF_MID_Z) - z else z - f32(RF_MID_Z);
  return f32(RF_EVERY_S) * (1 - f32(RF_RUBBER) * rf_clamp(lost / f32(RF_OVER_M), 0, 1));
}
// The fighters a reinforcement wave of a side with `cap` brings, at most what it lacks.
rf_wave :: (cap: int, standing: int) -> int {
  w := cap / RF_WAVE_PART; if w < 2 { w = 2; }
  lack := cap - standing;
  return ifx lack < w then (ifx lack < 0 then 0 else lack) else w;
}
// dt seconds of the siege with n_cult and n_town standing: the line moves by the strengths, and the
// waves' timers run.
rf_step :: (f: [] RfFront, n_cult: int, n_town: int, worth: f32, dt: f32) { rf_move(f, f32(n_cult), f32(n_town), worth, dt); }
// rf_step for sides of unlike caps: the cult's fighters count as the watch's cap over its own, so
// two full sides are matched (the cult's are many and light, the watch's few and armoured).
// A side's strength is mostly its whole army's, which its waves keep refilling (RF_ARMY), and the rest its
// share standing now: the cult's casters drop the watch far faster than the watch drops them, so by
// standing alone the watch would always lose the field.
rf_step_caps :: (f: [] RfFront, n_cult: int, cap_cult: int, n_town: int, cap_town: int, worth: f32, dt: f32) {
  rf_move(f, rf_army(n_cult, cap_cult, cap_town), rf_army(n_town, cap_town, cap_town), worth, dt);
}
// A side of `cap` with n standing, in the watch's fighters (of `unit`).
rf_army :: (n: int, cap: int, unit: int) -> f32 {
  if cap <= 0 { return 0; }
  share := rf_clamp(f32(n) / f32(cap), 0, 1);
  return f32(unit) * (f32(RF_ARMY) + (1 - f32(RF_ARMY)) * share);
}
rf_move :: (f: [] RfFront, cult: f32, town: f32, worth: f32, dt: f32) {
  s: [2] f32;
  rf_strengths(f[0].z, cult, town, worth, s[..]);
  f[0].cult = s[0]; f[0].town = s[1];
  v := f32(RF_SPEED) * (s[1] - s[0]) / rf_hi(s[0] + s[1], 4);
  f[0].v = v;
  f[0].z = rf_clamp(f[0].z - v * dt, f32(RF_CAMP_Z), f32(RF_HOLD_Z));
  f[0].due[0] -= dt; f[0].due[1] -= dt;
}
// Whether side's wave is due now: if so its timer starts again (rf_every at the line now).
rf_due :: (f: [] RfFront, side: int) -> bool {
  if f[0].due[side] > 0 { return false; }
  f[0].due[side] = rf_every(side, f[0].z);
  return true;
}
// A new siege: the line in the middle, the first waves at once.
rf_fresh :: () -> RfFront { return RfFront.{}; }
// Whether the line is in the band about the middle (the standstill's).
rf_in_band :: (z: f32) -> bool { return z >= f32(RF_MID_Z) - f32(RF_BAND) && z <= f32(RF_MID_Z) + f32(RF_BAND); }

// A number from 0 to 1 for fighter id and salt, the same everywhere (everglade-raid-tactics.coax rt_hash).
// Where fighter id of side (ranged or not) holds with the line at z: its own place along the road's
// width, its rank's distance behind the line, a little of its own (into o).
rf_post :: (side: int, ranged: bool, lead: bool, id: int, z: f32, o: [] f32) {
  a := rt_hash(id, 31) * 2 - 1;
  back := ifx lead then f32(RF_LEAD_M) else (ifx ranged then f32(RF_RANGED_M) + 4 * rt_hash(id, 32) else f32(RF_MELEE_M) + 1.5 * rt_hash(id, 32));
  w := ifx lead then 4.0f32 else (ifx ranged then f32(RF_HALF_W) * 0.8 else f32(RF_HALF_W));
  o[0] = a * w;
  if side == RF_CULT { o[1] = rf_hi(z - back, f32(RF_CAMP_Z) - 6); }
  else { o[1] = rf_lo(z + back, f32(RF_WALL_Z)); }
}
// Where a side musters: the cult about its camp, the watch just inside the South Gate (into o).
rf_muster :: (side: int, n: int, o: [] f32) {
  a := f32(n % 9) - 4;
  if side == RF_CULT { o[0] = a * 2.2; o[1] = f32(RF_CAMP_Z) - 2 - f32((n / 9) % 3) * 2; return; }
  o[0] = (f32(n % 5) - 2) * 1.3; o[1] = f32(RF_GATE_Z) + 5 + f32((n / 5) % 3) * 1.5;
}
// The k-th of the watch's stat block (RF_TOWN_MIX).
rf_town_npc :: (k: int) -> int { return RF_TOWN_MIX[(k % 12 + 12) % 12]; }
rf_town_ranged :: (npc: int) -> bool { return npc == RS_NPC_VETERAN || npc == RS_NPC_SCOUT; }
// The ward stones at the camp: stone n's place (into o).
rf_ward_at :: (n: int, o: [] f32) {
  o[0] = [3] f32.[-7, 7, 0][n % 3]; o[1] = f32(RF_CAMP_Z) + [3] f32.[2, 2, -6][n % 3];
}

#test "raid front: matched sides hold the line in the band; the overextended side weakens, the losing side reinforces sooner" {
  // matched and still: the line stays
  f: [1] RfFront; f[0] = rf_fresh();
  for t: 0..<600 { rf_step(f[..], 24, 24, 0, 1); }
  #assert f[0].z == f32(RF_MID_Z);
  // a side with fewer standing loses ground, but only so far: the winner overextends
  f[0] = rf_fresh();
  for t: 0..<600 { rf_step(f[..], 24, 20, 0, 1); }
  #assert f[0].z > f32(RF_MID_Z) && rf_in_band(f[0].z);
  s: [2] f32; rf_strengths(f[0].z, 24.0, 20.0, 0, s[..]);
  #assert abs(s[0] - s[1]) < 0.5;   // it settles where the strengths meet
  f[0] = rf_fresh();
  for t: 0..<600 { rf_step(f[..], 20, 24, 0, 1); }
  #assert f[0].z < f32(RF_MID_Z) && rf_in_band(f[0].z);
  // the watch never gives up the gate, the cult never its camp
  f[0] = rf_fresh();
  for t: 0..<900 { rf_step(f[..], 30, 0, 0, 1); }
  #assert f[0].z == f32(RF_HOLD_Z);
  for t: 0..<900 { rf_step(f[..], 0, 30, 0, 1); }
  #assert f[0].z == f32(RF_CAMP_Z);
  // unlike caps: 30 of the cult against 24 of the watch, both full, hold the middle
  f[0] = rf_fresh();
  for t: 0..<600 { rf_step_caps(f[..], 30, 30, 24, 24, 0, 1); }
  #assert f[0].z == f32(RF_MID_Z);
  // the cult near full, the watch mostly down between its waves: the line gives a little, in the band
  f[0] = rf_fresh();
  for t: 0..<600 { rf_step_caps(f[..], 29, 30, 6, 24, 0, 1); }
  #assert f[0].z > f32(RF_MID_Z) && rf_in_band(f[0].z);
  #assert rf_army(0, 24, 24) == 24 * f32(RF_ARMY) && rf_army(30, 30, 24) == 24;
  // the speed is bounded
  f[0] = rf_fresh(); rf_step(f[..], 0, 30, 0, 1);
  #assert f[0].v <= f32(RF_SPEED) + 0.001 && f[0].v > 0;
  // rubber-banding: the side pushed toward home reinforces sooner; the other no slower than RF_EVERY_S
  #assert rf_every(RF_CULT, f32(RF_MID_Z)) == f32(RF_EVERY_S) && rf_every(RF_TOWN, f32(RF_MID_Z)) == f32(RF_EVERY_S);
  #assert rf_every(RF_CULT, -100) < rf_every(RF_CULT, -80) && rf_every(RF_CULT, -80) < f32(RF_EVERY_S) && rf_every(RF_TOWN, -100) == f32(RF_EVERY_S);
  #assert rf_every(RF_TOWN, -62) < f32(RF_EVERY_S) && rf_every(RF_TOWN, -62) >= f32(RF_EVERY_S) * (1 - f32(RF_RUBBER));
  // waves: what the side lacks of its cap, never past it
  #assert rf_wave(30, 0) == 30 && rf_wave(30, 27) == 3 && rf_wave(30, 31) == 0 && rf_wave(5, 0) == 5;
  f[0] = rf_fresh();
  #assert rf_due(f[..], RF_CULT) && !rf_due(f[..], RF_CULT) && f[0].due[RF_CULT] == f32(RF_EVERY_S);
}

#test "raid front: players tip it: one shifts it a little, four take it to the camp" {
  f: [1] RfFront;
  one := raid_player_worth(f32(RAID_WORTH_FULL));
  f[0] = rf_fresh();
  for t: 0..<900 { rf_step(f[..], 24, 24, one, 1); }
  #assert f[0].z < f32(RF_MID_Z) - 3 && f[0].z > f32(RF_STAND_Z) + 10;   // toward the camp, still contested
  f[0] = rf_fresh();
  for t: 0..<900 { rf_step(f[..], 24, 24, 4 * one, 1); }
  #assert f[0].z <= f32(RF_STAND_Z);
  // a seat's worth has a ceiling: one strong player is not four
  #assert raid_player_worth(f32(RAID_WORTH_FULL) * 50) < 2 * one;
  #assert raid_player_worth(0) == 0;
}

#test "raid front: posts: the cult's ranks behind the line, the watch's before the wall, each its own place" {
  o: [2] f32; p: [2] f32;
  rf_post(RF_CULT, false, false, 7, -72, o[..]);
  #assert o[1] < -72 && o[1] > -76 && abs(o[0]) <= f32(RF_HALF_W);
  rf_post(RF_CULT, true, false, 7, -72, p[..]);
  #assert p[1] < o[1] - 8;
  rf_post(RF_TOWN, true, false, 9, -62, o[..]);
  #assert o[1] <= f32(RF_WALL_Z);
  rf_post(RF_TOWN, false, false, 9, -72, o[..]);
  #assert o[1] > -72 && o[1] < -69;
  rf_post(RF_CULT, false, false, 8, -72, p[..]);
  #assert p[0] != o[0];
  #assert rf_u(f32(RF_CAMP_Z)) == 0 && rf_u(f32(RF_GATE_Z)) == 1 && rf_town_ranged(rf_town_npc(5));
}
