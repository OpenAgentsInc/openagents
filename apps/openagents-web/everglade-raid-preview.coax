// The Cultist Raid drawn: Darian Odiodei's cult and the town watch at the siege on the south road.
// Who fights and every roll are the room's (everglade5e-room-raid.coax, the local host's offline,
// #12882; ?raid=preview starts it as a room event, room-worker.js); this file draws its people
// (everglade-events.coax hands each to everglade_raider, #12740, #12908):
//   - what it is told: each person of the raid where they stand, how fast they go, whether they are
//     casting or striking and whether they have fallen (everglade_raider);
//   - everyone is a body on the town's own rig and clips (verse/everglade/people-rig.coax): idle,
//     walk, run, spell, slash, and the fall (PEOPLE_DIE) when they die, held where they fell, then
//     sinking away. The cult hooded and robed by kind: a Cultist's robe blood red, a Fanatic's black,
//     a Warlock's violet, its casting hand alight; Darian taller, in black, with a staff. The cult's
//     look on the body (rp_parts) is the one place the Blender robes plug in, by look id. The
//     watch in the town guard's leathers, the line with sword and shield (everglade-watch.coax);
//   - each body its own gait (#12769): a looping clip it starts at its own phase, and a stride up to
//     RP_STRIDE longer or shorter, from its id (the room creature's, the same on every page), so a
//     squad never runs in step (rp_gait); its pace is the battle's (everglade-raid-tactics.coax rt_pace);
//   - &cine=1, a flight for a film: behind Darian over his swarm, the waves, the charge into the
//     watch, then on over the gate to the commons, where it settles into your own camera behind you
//     and the HUD comes back. Without it the camera is yours from the start.
//   coax/bin/coax test apps/openagents-web/everglade5e.coax --only "raid preview"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

RP_PEOPLE :: 63;           // the raid's bodies on the page (everglade-events.coax EGE_BODIES)
// npcs.coax RS_NPC_*: the kinds a raid fields
RP_GUARD :: 1; RP_VETERAN :: 2; RP_KNIGHT :: 3; RP_SCOUT :: 4;
RP_VILLAGER :: 12; // the editor's additional commoner appearance
RP_VILLAGER_LOOK :: [6]int.[2,3,5,7,8,9]; // humanoids; cats have no humanoid parts
#test "editor villager appearances always have human character parts" {
  parts:[FOLK_PARTS_MAX]int;
  for look:RP_VILLAGER_LOOK {#assert !EG_SPOT_CAT[look] && folk_parts(look,parts[..])>0;}
}
RP_CULTIST :: 7; RP_FANATIC :: 8; RP_WARLOCK :: 9; RP_ARCH :: 10; RP_PRIEST :: 11;   // RS_NPC_*: a Cult Priest (#12771)
// where you stand for ?raid=preview: by the commons, facing the South Gate
RP_LEAD :: [2] f32.[0, -106];   // the leader's camp on the road in, where the flight starts
RP_YOU :: [2] f32.[0, -16];
// the flight (s from the raid's start): eye and look at each key, then into your camera
RP_KEYS :: 9;
RP_KEY_T :: [9] f32.[0, 3, 7, 11, 15, 19, 22, 25, 28];
RP_KEY_EYE :: [27] f32.[2.7, 2.2, -106.6,   2.5, 4.5, -106,   -4, 6.5, -96,   6, 6, -84,   3, 5, -76,   5, 4.5, -67,   0, 7.5, -58,   0, 10, -36,   -5, 4.5, -9];
RP_KEY_AT :: [27] f32.[-0.6, 1.95, -105.4,   0, 2.5, -70,   0, 3, -56,   0, 2, -56,   0, 2, -56,   0, 0.5, -58,   0, 0.5, -49,   0, 1, -16,   0, 1.4, -19];
RP_SETTLE :: 2.5;          // s from the last key into your own camera
RP_HUD_AT :: 29.6;         // s: the HUD back
RP_LIE :: 7.0;             // s a body lies where it fell before it sinks
RP_SINK :: 2.5;            // s it takes to sink away

RpPerson :: struct { npc: int; x: f32; z: f32; yaw: f32; speed: f32; walk: f32; lit: f32; dead_t: f32 = -1; level: int; }
RaidPreview :: struct {
  on: bool; cine: bool;
  t: f32;                    // s since ?raid=preview's town was ready: &cine=1's flight keeps to it
  who: [RP_PEOPLE] RpPerson;
  skins: [RAID_SHOWN] Skin;  // each one's pose (everglade.coax RAID_SHOWN: its slot in the raid's draws)
  owed: [RAID_SHOWN] f32;    // s of its clip not yet played: one farther off is posed less often
  frame: int;                // frames drawn, to spread those poses over the frames
  posed: int;                // poses this frame (a check's count)
  used: [PEOPLE_PARTS] int;  // the raid's instances of each part this frame
  steps: int;                // the raiders' footfalls played this frame (RP_STEPS at most)
  ids: [RAID_SHOWN] int;     // each body's raider: the room creature's id (0: the preview's, its place)
  // Darian Odiodei as drawn this frame, the preview's or the room's: where his nameplate goes, and
  // his staff's orb and how bright it burns (its light, rp_lamps)
  arch_on: bool; arch_name: Point; arch_orb: Point; arch_glow: f32;
  arch_feet: Point; arch_left: Point;   // where he stands, and his left (his staff's side)
  stage: f32;                // ?stage=darian (4 m) or darian-15: the camera this far off his left side; -1 ?stage=front (RP_FRONT_EYE); -3 ?stage=echo; 0 none
  echo_t: f32; echo_run: bool;   // ?stage=echo: s into Echo's orbit, while N's orbit holds the camera
  echo_at: Point; echo_heading: f32;   // ?stage=echo: where Echo stands and the way she faces (radians about +y)
  // ?raid=preview&stage=echo (#12996): the room's Echo, as its creature is drawn this frame (rp_echo_room):
  // how fast she goes (m/s), her cast (Everglade's bar slot, -1 none), when it began (s, the page's
  // clock) and where it is aimed
  echo_room: bool; echo_speed: f32; echo_cast: int = -1; echo_cast_at: f64; echo_aim: Point;
  echo_cam: bool; echo_eye: Point; echo_look: Point;   // the staged shot's camera on her (rp_echo_follow)
}

// ?raid=preview (and &cine=1): you by the commons facing the South Gate, the raid to come.
rp_facts :: (s: [] Everglade, url: string) {
  if eg_query_is(url,"from","grid") {s[0].orbit=verse_orbit_start(s[0].feet,f32(PI));}
  // a staged shot of Darian and his staff (docs/verse/clips.md), in the preview or a room
  if eg_query_is(url, "stage", "darian") { s[0].rp.stage = 4; }
  if eg_query_is(url, "stage", "darian-15") { s[0].rp.stage = 15; }
  if eg_query_is(url, "stage", "front") { s[0].rp.stage = -1; }   // the siege's front from above the South Gate (#12860)
  if eg_query_is(url,"stage","benchmark-south-gate") {s[0].rp.stage=-2;}
  // ?stage=echo: you where the raid preview puts you, facing the South Gate, and Echo a metre to your
  // right, facing it too, drawn by the host's character pass (everglade-character.coax)
  if eg_query_is(url, "stage", "echo") {
    s[0].rp.stage = -3;
    ex := RP_YOU[0] + f32(RP_ECHO_SIDE); ez := RP_YOU[1];
    s[0].rp.echo_at = v3(ex, ground_at(s, ex, ez), ez); s[0].rp.echo_heading = f32(RP_ECHO_HEADING);
    s[0].spawn = v3(RP_YOU[0], 0, RP_YOU[1]); s[0].spawn_face = yaw_of(0, -1);
    s[0].feet = v3(RP_YOU[0], ground_at(s, RP_YOU[0], RP_YOU[1]), RP_YOU[1]);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
  }
  if !eg_query_is(url, "raid", "preview") { return; }
  s[0].rp.on = true;
  s[0].rp.cine = eg_query_is(url, "cine", "1");
  s[0].spawn = v3(RP_YOU[0], 0, RP_YOU[1]); s[0].spawn_face = yaw_of(0, -1);
  s[0].feet = v3(RP_YOU[0], ground_at(s, RP_YOU[0], RP_YOU[1]), RP_YOU[1]);
  s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
  s[0].warp = true; s[0].above = false; s[0].lift = 0;
}
// Whether the raid's people are drawn this frame (everglade.coax everglade_store_used uploads them).
rp_drawn :: (s: [] Everglade) -> bool { for k: 0..<PEOPLE_PARTS { if s[0].rp.used[k] > 0 { return true; } } return false; }
// Whether (x, z) is in the stables (plan.coax EG_STABLES), which the raid burns down (#12769).
rp_in_stables :: (x: f32, z: f32) -> bool {
  k := EG_STABLES * EG_BOX;
  return x >= EG_BUILDING[k] - 0.5 && x <= EG_BUILDING[k + 2] + 0.5 && z >= EG_BUILDING[k + 1] - 0.5 && z <= EG_BUILDING[k + 3] + 0.5;
}
// Person q of the raid as the room has it: their kind (0 none), where they stand, their facing and
// speed (m/s), level, the share of their cast's or blow's look left, and the seconds since they fell
// (-1 standing).
everglade_raider :: (s: [] Everglade, q: int, npc: int, x: f32, z: f32, yaw: f32, speed: f32, level: int, lit: f32, dead_t: f32) {
  if q < 0 || q >= RP_PEOPLE { return; }
  o := s[0].rp.who[q..<q + 1];
  if npc == 0 { o[0].npc = 0; return; }
  if o[0].npc == 0 { o[0].x = x; o[0].z = z; }
  dx := x - o[0].x; dz := z - o[0].z;
  was := o[0].walk;
  o[0].walk += sqrt(dx * dx + dz * dz);
  // their footfalls, a few a frame (everglade-sound.coax); their fall is e die's (everglade-events.coax)
  stride := ifx speed >= 5 then f32(EGS_STRIDE_RUN) else f32(EGS_STRIDE);
  if dead_t < 0 && floor(o[0].walk / stride) > floor(was / stride) && s[0].rp.steps < RP_STEPS {
    egs_cue(s, SFX_STEP_1 + q % 3, v3(x, ground_at(s, x, z), z), 0, 0.7); s[0].rp.steps += 1;
  }
  o[0] = RpPerson.{npc = npc, x = x, z = z, yaw = yaw, speed = speed, walk = o[0].walk, lit = lit, dead_t = dead_t, level = level};
}
RP_STEPS :: 3;              // raiders' footfalls a frame at most: a charge is a crowd of feet, not fifty voices
// Each frame: ?raid=preview's clock, from when the town is ready (&cine=1's flight keeps to it).
rp_frame :: (s: [] Everglade, dt: f32) {
  s[0].rp.steps = 0;
  if s[0].rp.on && s[0].pack_ready { s[0].rp.t += dt; }
  rp_echo_follow(s, dt);
  if s[0].rp.stage == -3 && s[0].rp.echo_run {
    // past its end the orbit holds its last frame till you move; then your own camera again
    if s[0].rp.echo_t >= f32(ECHO_ORBIT_SECONDS) && (s[0].intent_x != 0 || s[0].intent_z != 0) { s[0].rp.echo_run = false; }
    s[0].rp.echo_t = lo(s[0].rp.echo_t + dt, f32(ECHO_ORBIT_SECONDS));
  }
}
// Whether the HUD is off: through the flight, till it settles behind you.
rp_hud_off :: (s: [] Everglade) -> bool { return s[0].rp.stage == -3 || (s[0].rp.on && s[0].rp.cine && s[0].rp.t < f32(RP_HUD_AT)); }
// ?stage=echo: N (again: from the start) runs Echo's orbit.
rp_echo_key :: (s: [] Everglade, key: int) -> bool {
  if s[0].rp.stage != -3 || (key != 78 && key != 110) { return false; }
  s[0].rp.echo_run = true; s[0].rp.echo_t = 0; return true;
}
// The room's Echo as its creature is drawn this frame (everglade-events.coax ege_raider_draw, #12996): her
// feet on the town's ground, her heading the creature's (its yaw, as rp_facts's: pi faces -z), her pace.
rp_echo_room :: (s: [] Everglade, x: f32, z: f32, yaw: f32, vx: f32, vz: f32) {
  if s[0].rp.stage != -3 { return; }
  s[0].rp.echo_room = true;
  s[0].rp.echo_at = v3(x, ground_at(s, x, z), z); s[0].rp.echo_heading = yaw;
  s[0].rp.echo_speed = sqrt(vx * vx + vz * vz);
}
// ?raid=preview&stage=echo's camera (#12996): close behind her right shoulder as she runs with the
// watch, looking on past her; through a cast, over her shoulder on the line from her to the spell's
// point, below the South Gate's beam, so she stands in the foreground and where it lands beyond her.
// It eases after her (RP_ECHO_EASE), the same every run at a clip's steps.
RP_ECHO_EASE :: 0.3;
rp_echo_follow :: (s: [] Everglade, dt: f32) {
  if s[0].rp.stage != -3 || !s[0].rp.echo_room { return; }
  feet := s[0].rp.echo_at; h := s[0].rp.echo_heading;
  fx := sin(h); fz := cos(h);
  k := s[0].rp.echo_cast;
  t := f32(s[0].time - s[0].rp.echo_cast_at);
  if k >= 0 && k < SP_SLOTS && t >= 0 && t < srd_spell(SP_SPELL[k]).bar + 3.5 {
    a := s[0].rp.echo_aim;
    d := unit_or(v3(a.x - feet.x, 0, a.z - feet.z), v3(fx, 0, fz));
    fx = d.x; fz = d.z;
  }
  rx := -fz; rz := fx;
  eye := v3(feet.x - fx * 4 + rx * 1.5, feet.y + 2.2, feet.z - fz * 4 + rz * 1.5);
  at := v3(feet.x + fx * 4, feet.y + 1.3, feet.z + fz * 4);
  if k >= 0 && k < SP_SLOTS && t >= 0 && t < srd_spell(SP_SPELL[k]).bar + 3.5 {
    a := s[0].rp.echo_aim;
    eye = v3(feet.x - fx * 4.5 + rx * 1.2, feet.y + 2.6, feet.z - fz * 4.5 + rz * 1.2);
    at = mix(v3(feet.x, feet.y + 1.3, feet.z), v3(a.x, a.y + 1, a.z), 0.35);
  }
  if !s[0].rp.echo_cam { s[0].rp.echo_cam = true; s[0].rp.echo_eye = eye; s[0].rp.echo_look = at; return; }
  e := clamp01(dt / f32(RP_ECHO_EASE));
  s[0].rp.echo_eye = mix(s[0].rp.echo_eye, eye, e); s[0].rp.echo_look = mix(s[0].rp.echo_look, at, e);
}
// The room says Echo began a cast of bar slot `slot` at `at` (everglade-events.coax e rc).
rp_echo_cast :: (s: [] Everglade, slot: int, at: Point) {
  s[0].rp.echo_cast = slot; s[0].rp.echo_cast_at = s[0].time; s[0].rp.echo_aim = at;
}
// Echo stands a metre to your right on the commons (RP_YOU), facing the gate as you do: her heading
// pi turns her front from +z to -z.
RP_ECHO_SIDE :: 1.0;
RP_ECHO_HEADING :: 3.14159265;
// The orbit's camera (verse/valley/echo-orbit.coax) in her own frame: side along her right, front
// along the way she faces.
rp_echo_shot :: (s: [] Everglade) -> Shot {
  feet := s[0].rp.echo_at; h := s[0].rp.echo_heading;
  fx := sin(h); fz := cos(h);   // her front
  rx := -fz; rz := fx;          // her right
  o: [6] f32;
  echo_orbit_path(s[0].rp.echo_t, o[..]);
  eye := v3(feet.x + rx * o[0] + fx * o[2], feet.y + o[1], feet.z + rz * o[0] + fz * o[2]);
  at := v3(feet.x + rx * o[3] + fx * o[5], feet.y + o[4], feet.z + rz * o[3] + fz * o[5]);
  return Shot.{eye = eye, at = at};
}

// ---- the flight

rp_key :: (k: [27] f32, i: int) -> Point { j := clamp_i(i, 0, RP_KEYS - 1) * 3; return v3(k[j], k[j + 1], k[j + 2]); }
// Catmull-Rom through p1 to p2 at u.
rp_spline :: (p0: Point, p1: Point, p2: Point, p3: Point, u: f32) -> Point {
  u2 := u * u; u3 := u2 * u;
  a := times(p1, 2);
  b := times(sub(p2, p0), u);
  c := times(add(sub(times(p0, 2), times(p1, 5)), sub(times(p2, 4), p3)), u2);
  d := times(add(sub(p3, p0), times(sub(p1, p2), 3)), u3);
  return times(add(add(a, b), add(c, d)), 0.5);
}
rp_path :: (k: [27] f32, t: f32) -> Point {
  i := 0;
  while i < RP_KEYS - 2 && t >= RP_KEY_T[i + 1] { i += 1; }
  u := clamp((t - RP_KEY_T[i]) / (RP_KEY_T[i + 1] - RP_KEY_T[i]), 0, 1);
  return rp_spline(rp_key(k, i - 1), rp_key(k, i), rp_key(k, i + 1), rp_key(k, i + 2), u);
}
// ?stage=front: the camera over the palisade east of the South Gate, looking down the south road at the
// siege's line and the cult's camp beyond it (#12860).
RP_FRONT_EYE :: Point.{x = 14, y = 13, z = -50};
RP_FRONT_AT :: Point.{x = -2, y = 0.5, z = -84};
// The camera: with &cine=1 the flight, then your own (`follow`) from its last key; else yours.
rp_shot :: (s: [] Everglade, follow: Shot) -> Shot {
  if s[0].rp.stage == -3 {
    if s[0].rp.echo_run { return rp_echo_shot(s); }
    if s[0].rp.echo_cam { return Shot.{eye = s[0].rp.echo_eye, at = s[0].rp.echo_look}; }
    return follow;
  }
  if s[0].rp.stage == -2 {return Shot.{eye=Point.{x=18,y=18,z=-86},at=Point.{x=0,y=1.4,z=-54}};}
  if s[0].rp.stage < 0 { return Shot.{eye = RP_FRONT_EYE, at = RP_FRONT_AT}; }
  if s[0].rp.stage > 0 && s[0].rp.arch_on {
    // ?stage=darian: from his left, a little above, looking at his chest and staff
    d := s[0].rp.stage;
    f := s[0].rp.arch_feet; l := s[0].rp.arch_left;
    return Shot.{eye = add(f, add(times(l, d), v3(0, 1.5 + 0.06 * d, 0))), at = add(f, add(times(l, 0.3), v3(0, 1.55, 0)))};
  }
  if !s[0].rp.on || !s[0].rp.cine { return follow; }
  t := s[0].rp.t;
  last := RP_KEY_T[RP_KEYS - 1];
  path := Shot.{eye = rp_path(RP_KEY_EYE, lo(t, last)), at = rp_path(RP_KEY_AT, lo(t, last))};
  if t <= last { return path; }
  k := ease((t - last) / f32(RP_SETTLE));
  return Shot.{eye = mix(path.eye, follow.eye, k), at = mix(path.at, follow.at, k)};
}

// ---- the raid drawn

// The robes' dyes by kind (colour, how much takes), as folk.coax FOLK_DYE: a Cultist's blood red, a
// Fanatic's black, a Warlock's violet, Darian's black.
RP_DYE :: [20] f32.[0.3, 0.03, 0.035, 1,   0.16, 0.014, 0.022, 1,   0.13, 0.035, 0.24, 1,   0.03, 0.025, 0.035, 1,   0.42, 0.36, 0.3, 1];   // the last a Cult Priest's ash-grey vestment
// The robes' colourway (folk.coax PART_CULT_ROBE): 1 the gold trim and sigil, a Fanatic's and Darian's.
RP_GOLD :: [5] int.[0, 1, 0, 1, 1];   // a Cult Priest's vestment gold-trimmed
RP_FAR :: 22.0;            // metres from you: past this a raider wears the robe's far copy
RP_VIOLET :: Point.{x = 0.75, y = 0.35, z = 1.0};
// Each body's own gait (#12769): from its id, the same on every page and every run.
RP_STRIDE :: 0.08;         // a stride up to 8% longer or shorter than the clip's: its pace's (rt_pace RT_PACE)
// A number from 0 to 1 for raider `id` and `salt`: everglade-raid-tactics.coax rt_hash, which this
// module doesn't load (everglade-raid-town.coax holds them alike).
rp_hash :: (id: int, salt: int) -> f32 {
  h := ((id % 1000003 + 1000003) % 1000003 * 2654435761 + salt * 40503 + 12345) % 2147483647;
  h = h * h % 2147483647;
  h = (h * 48271 + salt) % 2147483647;
  h = h * h % 2147483647;
  return f32(h % 100003) / 100003.0;
}
// Raider id's pace against its kind's, as the battle moves it (rt_pace).
rp_pace :: (id: int) -> f32 { return 1 + 0.08 * (2 * rp_hash(id, 1) - 1); }
// Body q's raider: the room's creature, else the preview's person q.
rp_id :: (s: [] Everglade, q: int) -> int { return ifx s[0].rp.ids[q] != 0 then s[0].rp.ids[q] else q + 1; }
// Where in a looping clip raider id starts it (0 to 1 of the clip): the golden ratio's steps, so a
// squad's consecutive ids spread evenly round the loop. Its stride against the clip's: its pace's
// share of RP_STRIDE (a faster raider strides longer), and up to RP_OWN of its own, so its feet keep
// to the ground and its step drifts slowly against its neighbours'.
RP_OWN :: 0.02;
rp_phase :: (id: int) -> f32 { u := f32(id) * 0.618034; return u - floor(u); }
rp_stride :: (id: int) -> f32 { return rp_pace(id) * (1 + f32(RP_OWN) * (2 * rp_hash(id, 5) - 1)); }
// Body q plays `clip` at `speed` for `owed` s: a looping clip it changes to starts at its own phase,
// and its gait goes at its own stride.
rp_gait :: (s: [] Everglade, rig: SkinRig, sk: [] Skin, q: int, clip: int, speed: f32, owed: f32) {
  id := rp_id(s, q);
  if sk[0].clip != clip && clip != PEOPLE_DIE && clip != PEOPLE_SPELL && clip != PEOPLE_SLASH {
    skin_advance(rig, sk, clip, 0, 0);   // into the clip, its blend begun
    sk[0].time = rp_phase(id) * rig.duration[clip];
  }
  skin_advance(rig, sk, clip, speed / rp_stride(id), owed);
}
// Whether raid person q, `d` m from you, is posed this frame (`new_clip`: its clip changed): the
// seconds of its clip to play then, else -1 (they wait, owed).
rp_pose_due :: (s: [] Everglade, q: int, new_clip: bool, d: f32, dt: f32) -> f32 {
  s[0].rp.owed[q] += dt;
  every := remote_every(d);
  if every != 1 && (s[0].rp.frame + q) % every != 0 && !new_clip { return -1; }
  owed := s[0].rp.owed[q];
  s[0].rp.owed[q] = 0; s[0].rp.posed += 1;
  return owed;
}
rp_draw :: (s: [] Everglade, dt: f32) {
  for k: 0..<PEOPLE_PARTS { s[0].rp.used[k] = 0; }
  s[0].rp.frame += 1; s[0].rp.posed = 0;
  s[0].rp.arch_on = false; s[0].rp.arch_glow = 0;
  if !s[0].pack_ready { return; }   // whoever a raid has set (the preview's or the room's)
  for q: 0..<RP_PEOPLE {
    o := s[0].rp.who[q];
    if o.npc == 0 { continue; }
    rp_person_at(s, q, o.npc, o.x, o.z, o.yaw, o.speed, o.lit, o.dead_t, dt);
  }
}
// What one of the cult wears on the Quaternius male body (verse/everglade/folk.coax PART_*): the Blender
// robe (verse/tools/humans/cult_robe.py; Darian's his own), its far copy past RP_FAR, the hands and
// the head; the robe dyed by kind (RP_DYE), gold-trimmed by RP_GOLD.
rp_parts :: (npc: int, far: bool, out: [] int) -> int {
  if out.count < FOLK_PARTS_MAX { return 0; }
  arch := npc == RP_ARCH;
  out[0] = ifx arch then (ifx far then PART_DARIAN_ROBE_FAR else PART_DARIAN_ROBE) else (ifx far then PART_CULT_ROBE_FAR else PART_CULT_ROBE);
  out[1] = PART_MALE_HANDS;
  out[2] = PART_MALE_HEAD;
  return 3;
}
// Person q of a raid (its slot in the raid's draws: under RAID_SHOWN), of kind `npc` (RS_NPC_*), at
// (x, z) facing `yaw` and going at `speed` m/s; `lit` the share of its cast's or blow's look left;
// `dead_t` the seconds since it fell (-1 standing). The preview's people and the room's.
rp_person_at :: (s: [] Everglade, q: int, npc: int, x: f32, z: f32, yaw: f32, speed: f32, lit: f32, dead_t: f32, dt: f32) {
  if q < 0 || q >= RAID_SHOWN { return; }
  if dead_t >= f32(RP_LIE + RP_SINK) { return; }   // sunk away
  town := npc >= RP_GUARD && npc <= RP_SCOUT;
  villager:=npc==RP_VILLAGER;
  caster := npc == RP_WARLOCK || npc == RP_ARCH;
  shooter := npc == RP_VETERAN || npc == RP_SCOUT;
  look := ifx villager then RP_VILLAGER_LOOK[q%6] else (q - 1) % 6;   // a watch or villager look
  female := ifx villager then FOLK_FEMALE[look] else town && WATCH_FEMALE[clamp_i(look, 0, 5)];
  rig := eg_people_rig(s, female);
  sk := s[0].rp.skins[q..<q + 1];
  sk[0].fade = 0.22;
  // the clip: the fall when dead (held at its end), else running, walking, casting, striking, still
  clip := PEOPLE_DIE;
  if dead_t < 0 {
    clip = PEOPLE_IDLE;
    if speed > 3.0 { clip = PEOPLE_RUN; } else if speed > 0.25 { clip = PEOPLE_WALK; }
    else if lit > 0 { clip = ifx caster || shooter then PEOPLE_SPELL else PEOPLE_SLASH; }
    else if town && !shooter { clip = PEOPLE_FOLD; }
  }
  // posed as often as its distance asks, as the room's other players are (everglade-rangers.coax
  // remote_every): every frame within 15 m, every second to 35 m, one in four past that, the time
  // between played at once; a new clip at once. A 16-player raid's 60 people skinned every frame
  // were a tenth of a phone's frame (November 4).
  at := RAID_PAL_AT + q * PERSON_ROWS * 4;
  pal := s[0].palette[at..<at + PEOPLE_JOINTS * 12];
  owed := rp_pose_due(s, q, sk[0].clip != clip, flat_gap(v3(x, 0, z), s[0].feet), dt);
  if owed >= 0 {
    if dead_t >= 0 {
      if sk[0].clip != PEOPLE_DIE { skin_advance(rig, sk, PEOPLE_DIE, 0, owed); }
      else { left := hi(rig.duration[PEOPLE_DIE] - 0.02 - sk[0].time, 0); skin_advance(rig, sk, PEOPLE_DIE, 0, lo(owed, left)); }
    } else {
      rp_gait(s, rig, sk, q, clip, speed, owed);
    }
    skin_palette(rig, sk, pal);
  }
  h := at + PEOPLE_JOINTS * 12;
  tone := ifx villager then FOLK_SKIN[look] else ifx town then WATCH_SKIN[clamp_i(look, 0, 5)] else (q * 7) % 5;
  if npc == RP_ARCH { tone = 4; }
  for c: 0..<3 {
    s[0].palette[h + c] = SKIN_TONE[tone * 3 + c] * (ifx town || villager then 1.0f32 else 0.8f32);
    s[0].palette[h + 4 + c] = ifx villager then FOLK_HAIR_RGB[look*3+c] else ifx town then WATCH_HAIR_RGB[clamp_i(look, 0, 5) * 3 + c] else 0.04f32;
  }
  kind := ifx npc == RP_FANATIC then 1 else ifx npc == RP_WARLOCK then 2 else ifx npc == RP_ARCH then 3 else ifx npc == RP_PRIEST then 4 else 0;
  s[0].palette[h + 3] = f32(ifx villager then FOLK_VARIANT[look] else ifx town then WATCH_VARIANT[clamp_i(look, 0, 5)] else RP_GOLD[kind]);
  s[0].palette[h + 7] = 0;
  for c: 0..<4 { s[0].palette[h + 8 + c] = ifx villager then FOLK_DYE[look*4+c] else ifx town then (ifx npc == RP_GUARD then WATCH_DYE[c] else RANK_DYE[(ifx npc == RP_KNIGHT then 3 else ifx npc == RP_SCOUT then 6 else 1) * 4 + c]) else RP_DYE[kind * 4 + c]; }
  // where it stands: sinking once it has lain its while
  big := ifx npc == RP_ARCH then 1.14f32 else 1.0f32;
  y := folk_feet(s, x, z) - (ifx dead_t > f32(RP_LIE) then 1.3 * (dead_t - f32(RP_LIE)) / f32(RP_SINK) else 0.0f32);
  c := cos(yaw); sn := sin(yaw);
  rows := [12] f32.[c * big, 0, sn * big, x,   0, big, 0, y,   -sn * big, 0, c * big, z];
  parts: [FOLK_PARTS_MAX] int;
  n := ifx villager then folk_parts(look,parts[..]) else ifx town then watch_parts(clamp_i(look, 0, 5), parts[..]) else rp_parts(npc, flat_gap(v3(x, 0, z), s[0].feet) > f32(RP_FAR), parts[..]);
  for p: 0..<n {
    part := parts[p];
    if s[0].part_count[part] <= 0 || s[0].rp.used[part] >= RAID_SHOWN { continue; }
    o := (RAID_AT + part * RAID_SHOWN + s[0].rp.used[part]) * OBJECT_FLOATS;
    s[0].rp.used[part] += 1;
    for r: 0..<12 { s[0].objects[o + r] = rows[r]; }
    s[0].objects[o + 12] = f32(s[0].part_word[part]);
    s[0].objects[o + 13] = f32(RAID_PAL_AT / 4 + q * PERSON_ROWS);
    s[0].objects[o + 14] = PERSON_MARK;
    s[0].objects[o + 15] = f32(SHAPE_SKINNED + 8 * LOOK_KIT);
  }
  if dead_t >= 0 && dead_t > 1.0 { return; }   // what they held is down with them
  // what each holds, from its pose
  hand := watch_joint(rig, sk, PEOPLE_HAND_R_J);
  hw := add(v3(x, y, z), times(watch_world(hand.t, c, sn), big));
  head := watch_joint(rig, sk, PEOPLE_HEAD);
  hd := add(v3(x, y, z), times(watch_world(head.t, c, sn), big));
  fwd := v3(sn, 0, c); right := v3(c, 0, -sn);
  if npc == RP_ARCH && dead_t < 0 {
    s[0].rp.arch_on = true; s[0].rp.arch_name = add(hd, v3(0, f32(RP_NAME_OVER) * big, 0));
    s[0].rp.arch_feet = v3(x, y, z); s[0].rp.arch_left = times(right, -1);
  }
  if villager {return;}
  if town && !shooter { watch_arm_guard(s, rig, sk, x, y, z, yaw, true); return; }
  if shooter {
    // a bow or a crossbow in the left hand
    lh := watch_joint(rig, sk, PEOPLE_HAND_L_J);
    lw := add(v3(x, y, z), watch_world(lh.t, c, sn));
    ci_limb(s, sub(lw, v3(0, 0.55, 0)), add(lw, v3(0, 0.55, 0)), 0.02, v3(0.32, 0.2, 0.1), false, 1);
    return;
  }
  if caster {
    // the casting hand alight; Darian's staff, its head burning violet, and his horns
    if lit > 0 || npc == RP_ARCH { sp_glow(s, hw, (0.14 + 0.3 * lit) * big, times(RP_VIOLET, 0.5 + 1.2 * lit)); }
    if npc == RP_ARCH {
      lh := watch_joint(rig, sk, PEOPLE_HAND_L_J);
      lw := add(v3(x, y, z), times(watch_world(lh.t, c, sn), big));
      rp_darian_staff(s, lw, fwd, right, hd.y - y, y, lit);
      sp_glow(s, add(v3(x, y, z), v3(0, 1.0, 0)), 1.2, times(RP_VIOLET, 0.16 + 0.06 * sin(s[0].rp.t * 3)));
    }
    return;
  }
  // a Cultist's Ritual Sickle, a Fanatic's Pact Blade, from the right fist
  blade := watch_world(quat_rotate(hand.q, v3(0, 0, 1)), c, sn);
  ln := ifx npc == RP_FANATIC then 0.6f32 else 0.32f32;
  ci_limb(s, hw, add(hw, times(blade, ln)), 0.022, v3(0.62, 0.62, 0.66), false, 1);
  if npc == RP_FANATIC && lit > 0 { sp_glow(s, add(hw, times(blade, ln * 0.6)), 0.12, times(RP_VIOLET, lit)); }
}

// ---- Darian Odiodei's staff and his name

// His staff (the druid's staff's make, everglade-rangers.coax druid_staff, his own): taller than he is,
// its orb at RP_STAFF_TALL of his head's height. A thick black shaft, crooked and knotted, two strands
// twisting up round it, a bronze band, and four heavy claws curling up out of the wood to cage a big
// orange-gold orb: a ball with a hot core and a slow swirl of light round it, a soft halo, embers,
// and a lamp that lights him and the ground round him (rp_lamps). It flares as he casts. Its foot on
// the ground by his left fist, the fist on the shaft, so it goes with him through every clip.
// Within RP_STAFF_NEAR m of the eye all of it (about 45 shapes); farther, the shaft, the claws' four
// first lengths, the orb and its light.
RP_STAFF_NEAR :: 35.0;     // m from the eye
RP_STAFF_TALL :: 1.3;      // the orb's middle at this many times his head's height
RP_ORB_R :: 0.21;          // m: the orb's radius
RP_NAME_OVER :: 0.72;      // m over his head's joint: his name, clear of his Hit Points bar
RP_SHAFT_RGB :: Point.{x = 0.045, y = 0.03, z = 0.028};
RP_STRAND_RGB :: Point.{x = 0.085, y = 0.05, z = 0.038};
RP_CLAW_RGB :: Point.{x = 0.12, y = 0.07, z = 0.05};
RP_BAND_RGB :: Point.{x = 0.5, y = 0.32, z = 0.12};
RP_ORB_RGB :: Point.{x = 1.55, y = 0.72, z = 0.11};      // orange-gold: bright, but short of white so it stays a coloured ball
RP_CORE_RGB :: Point.{x = 2.6, y = 1.7, z = 0.6};       // its hot heart, yellow-white
RP_ORB_GLOW :: Point.{x = 1.0, y = 0.45, z = 0.08};
RP_EMBER_RGB :: Point.{x = 1.8, y = 0.7, z = 0.12};
RP_SWIRL :: 3;             // motes of light circling in the orb
// The claws' points from the band up past the orb's middle (in orb radii, from its middle) and out
// from the staff's line, as STAFF_ROOT_UP and _OUT: out round its belly, then in over its crown.
RP_CLAW_UP :: [5] f32.[-1.35, -0.85, -0.1, 0.6, 1.05];
RP_CLAW_OUT :: [5] f32.[0.3, 0.95, 1.22, 1.05, 0.4];
rp_darian_staff :: (s: [] Everglade, fist: Point, fwd: Point, right: Point, head: f32, ground: f32, lit: f32) {
  ax := unit_or(add(add(v3(0, 1, 0), times(fwd, 0.06)), times(right, -0.05)), v3(0, 1, 0));
  side := unit_or(cross(ax, fwd), right); third := cross(side, ax);
  rr := f32(RP_ORB_R);
  tall := f32(RP_STAFF_TALL) * hi(head, 1.2);          // the orb's middle over the ground
  a := add(fist, times(ax, -(fist.y - ground) / ax.y));   // the foot on the ground below the fist
  orb := add(a, times(ax, tall / ax.y));
  neck := sub(orb, times(ax, rr * 1.35));               // the band, where the claws split
  t := s[0].rp.t + f32(s[0].time);
  f := clamp01(lit);
  pulse := 1 + 0.14 * sin(t * 2.1) + 0.04 * sin(t * 6.7);   // a slow breath, a faint flicker
  glow := pulse * (1 + 1.2 * f);
  s[0].rp.arch_orb = orb; s[0].rp.arch_glow = glow;
  eye := s[0].sp.shot.eye;
  near := length(sub(orb, eye)) < f32(RP_STAFF_NEAR);
  if near {
    // the shaft: three crooked lengths, thickening up, a knot at each bend
    k1 := add(mix(a, neck, 0.34), times(side, 0.02));
    k2 := add(mix(a, neck, 0.68), add(times(side, -0.018), times(third, 0.014)));
    staff_post(s, LOOK_WOOD, a, k1, 0.04, RP_SHAFT_RGB);
    staff_post(s, LOOK_WOOD, k1, k2, 0.046, RP_SHAFT_RGB);
    staff_post(s, LOOK_WOOD, k2, neck, 0.052, RP_SHAFT_RGB);
    staff_knot(s, k1, ax, side, third, 0.085, RP_STRAND_RGB);
    staff_knot(s, k2, ax, side, third, 0.09, RP_STRAND_RGB);
    // two strands twisting up round its upper half into the head
    for j: 0..<2 {
      from := mix(a, neck, 0.42);
      last := from;
      for q: 1..<7 {
        u := f32(q) / 6;
        ang := u * 9.0 + f32(j) * 3.14159;
        p := add(mix(from, neck, u), times(add(times(side, cos(ang)), times(third, sin(ang))), 0.056));
        staff_root(s, last, p, 0.018, 1.4, RP_STRAND_RGB);
        last = p;
      }
    }
  } else {
    staff_post(s, LOOK_WOOD, a, neck, 0.05, RP_SHAFT_RGB);
  }
  // the bronze band, and the head flaring out of it
  staff_post(s, LOOK_MATTE, sub(neck, times(ax, 0.07)), neck, 0.068, RP_BAND_RGB);
  sp_shape(s, SHAPE_CONE, LOOK_WOOD, add(neck, times(ax, 0.05)), times(side, 0.12), times(ax, -0.13), times(third, 0.12), RP_CLAW_RGB);
  // four heavy claws out round the orb's belly and in over its crown (far off, their first lengths)
  steps := ifx near then 5 else 3;
  for r: 0..<4 {
    base := f32(r) * 1.5708 + 0.4;
    last := add(neck, times(add(times(side, cos(base)), times(third, sin(base))), rr * RP_CLAW_OUT[0]));
    for q: 1..<steps {
      u := f32(q) / 4;
      ang := base + u * 0.7;
      out := times(add(times(side, cos(ang)), times(third, sin(ang))), rr * RP_CLAW_OUT[q]);
      p := add(add(orb, times(ax, rr * RP_CLAW_UP[q])), out);
      staff_root(s, last, p, lerp(0.06, 0.022, u), ifx q < 4 then 1.5f32 else 1.15f32, times(RP_CLAW_RGB, 0.8 + 0.2 * f32(r % 2)));
      last = p;
    }
  }
  // the orb, its hot heart toward the eye, the swirl of light round it, and its halo
  sp_shape(s, SHAPE_SPHERE, LOOK_GLOW, orb, times(side, rr), times(ax, rr), times(third, rr), times(RP_ORB_RGB, 0.75 + 0.3 * glow));
  to_eye := unit_or(sub(eye, orb), fwd);
  sp_glow(s, add(orb, times(to_eye, rr * 1.05)), rr * 0.55, times(RP_CORE_RGB, 0.3 + 0.15 * glow));
  if near {
    for m: 0..<RP_SWIRL {
      ang := t * (0.9 + 0.25 * f32(m)) + f32(m) * 2.0944;
      tilt := 0.5 * sin(t * 0.4 + f32(m) * 1.7);
      p := add(orb, times(add(add(times(side, cos(ang)), times(third, sin(ang))), times(ax, tilt)), rr * 1.02));
      mr := rr * 0.11;
      sp_shape(s, SHAPE_BOX, LOOK_GLOW, p, times(side, mr), times(ax, mr), times(third, mr), times(RP_CORE_RGB, 0.9));
      sp_glow(s, p, rr * 0.6, times(RP_ORB_GLOW, 0.9 * glow));
    }
  }
  sp_glow(s, orb, (0.75 + 0.6 * f) * pulse, times(RP_ORB_GLOW, 0.9 * glow));
  sp_glow(s, orb, (2.2 + 1.0 * f) * pulse, times(RP_ORB_GLOW, 0.32 * glow));
  // embers drifting up off it, more as he casts
  if sp_rand(s) < 0.2 * (1 + 2.5 * f) {
    ang := 6.2832 * sp_rand(s);
    at := add(orb, times(add(times(side, cos(ang)), times(third, sin(ang))), rr * 0.9));
    sp_add_spark(s, at, v3(0.2 * cos(ang), 0.5 + 0.4 * sp_rand(s), 0.2 * sin(ang)), 1.0 + 0.7 * sp_rand(s), 0.024, RP_EMBER_RGB, -0.15);
  }
}
// The orb's light on him and the ground round him, as the druid's fire (everglade-grove.coax gv_lamps).
rp_lamps :: (s: [] Everglade, u: [] f32, k: int, most: int) -> int {
  if !s[0].rp.arch_on || s[0].rp.arch_glow <= 0 { return k; }
  return sp_lamp(u, k, most, s[0].rp.arch_orb, 8, v3(1.0, 0.55, 0.18), 2.2 * s[0].rp.arch_glow);
}
// His name over his head, for labels() (everglade.coax), in the townsfolk's and players' plate:
// from the body drawn for him, so the preview's Darian and the room's alike.
rp_labels :: (s: [] Everglade, ls: [] Label, c: int, you: Point, k: f32) -> int {
  if c >= ls.count || !s[0].rp.arch_on { return c; }
  p := s[0].rp.arch_name;
  d := flat_gap(p, you);
  if d > f32(REMOTE_PLATE_NEAR) { return c; }
  light := 0.85 * clamp01((f32(REMOTE_PLATE_NEAR) - d) / f32(REMOTE_PLATE_FADE));
  ls[c] = Label.{text = "DARIAN ODIODEI", p = p, cap = 6.5 * k, light = light, gold = false, d = d, done = false, person = true};
  return c + 1;
}

#test "raid preview: a raider near you is posed every frame, one far off one frame in four, and a new clip at once" #steps 2000000000 {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview");
  dt := 1.0f32 / 60;
  near := 0; far := 0; played := 0.0f32;
  for f: 0..<8 {
    g[0].rp.frame += 1;
    if rp_pose_due(g[..], 0, f == 0, 4, dt) >= 0 { near += 1; }
    o := rp_pose_due(g[..], 1, f == 0, 60, dt);
    if o >= 0 { far += 1; played += o; }
  }
  #assert near == 8 && far == 1 + 2;   // the far one at its first clip, then one frame in four
  #assert abs(played + g[0].rp.owed[1] - 8 * dt) < 0.0001;   // no time lost: what isn't played yet is owed
  // 25 m: every second frame; a new clip (a fall) at once
  mid := 0;
  for f: 0..<8 { g[0].rp.frame += 1; if rp_pose_due(g[..], 2, false, 25, dt) >= 0 { mid += 1; } }
  #assert mid == 4;
  g[0].rp.frame += 1;
  #assert rp_pose_due(g[..], 1, true, 60, dt) > 0 && g[0].rp.owed[1] == 0;
}

#test "raid preview: the flight starts behind Darian, ends in your camera, and the HUD is off till then" {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview&cine=1");
  #assert g[0].rp.on && g[0].rp.cine && g[0].warp && g[0].spawn.z == RP_YOU[1];
  follow := Shot.{eye = v3(0, 2.5, -11), at = v3(0, 1.5, -20)};
  g[0].rp.t = 0;
  a := rp_shot(g[..], follow);
  #assert a.eye.z < RP_LEAD[1] && a.at.z > a.eye.z && rp_hud_off(g[..]);
  g[0].rp.t = 40;
  b := rp_shot(g[..], follow);
  #assert length(sub(b.eye, follow.eye)) < 0.01 && !rp_hud_off(g[..]);
  // without &cine=1 the camera is yours
  h: [1] Everglade;
  rp_facts(h[..], "/worlds/everglade?raid=preview");
  #assert h[0].rp.on && !h[0].rp.cine && !rp_hud_off(h[..]);
  // the flight's clock runs once the town is ready, in a room as offline
  g[0].rp.t = 0; rp_frame(g[..], 1);
  #assert g[0].rp.t == 0;
  g[0].pack_ready = true; rp_frame(g[..], 1);
  #assert g[0].rp.t == 1;
  // a raider walks where the battle says; one fallen stays down where it fell
  everglade_raider(g[..], 3, RP_CULTIST, 1, -90, 0, 6, 0, 0, -1);
  everglade_raider(g[..], 3, RP_CULTIST, 1, -89, 0, 6, 0, 0, -1);
  #assert g[0].rp.who[3].z == -89 && g[0].rp.who[3].walk > 0.9;
  everglade_raider(g[..], 3, RP_CULTIST, 1, -89, 0, 0, 0, 0, 2.0);
  #assert g[0].rp.who[3].npc == RP_CULTIST && g[0].rp.who[3].dead_t == 2.0;
  // the raid's draws are uploaded only while there is a raid to draw
  #assert !rp_drawn(g[..]) && everglade_store_used(g[..], 2) == RAID_PAL_AT * 4 && everglade_store_used(g[..], 1) == RAID_AT * OBJECT_FLOATS * 4;
}

#test "the raid's raiders are heard: footfalls as they run, a few a frame" {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview");
  egs_test_page(g[..]);
  g[0].snd[0].ear = Shot.{eye = v3(0, 1.6, -95), at = v3(0, 1.6, -85)};
  for q: 0..<6 { everglade_raider(g[..], q, RP_CULTIST, f32(q), -90, 0, 6, 0, 0, -1); }
  #assert g[0].snd[0].cue_n == 0;
  // six run a stride and more at once: three are heard
  for q: 0..<6 { everglade_raider(g[..], q, RP_CULTIST, f32(q), -88.6, 0, 6, 0, 0, -1); }
  #assert g[0].snd[0].cue_n == RP_STEPS;
  _ := everglade_sound_lines(g[..]);
  #assert egs_heard(g[..], 0).name == "step-1" && egs_heard(g[..], 0).gain > 0;
  // the next frame one falls: its cry is e die's (everglade-events.coax), not a second one here
  rp_frame(g[..], 0.016);
  everglade_raider(g[..], 0, RP_CULTIST, 0, -88.6, 0, 0, 0, 0, 0.0);
  #assert g[0].snd[0].cue_n == 0;
}

// How bunched raid bodies first to first + n are in clip `clip` now: the length of the mean of their
// phases round the clip's loop (1 all in step, near 0 spread evenly), and into gap the least gap
// between two phases (0 to 0.5 of the loop).
rp_test_bunched :: (g: [] Everglade, first: int, n: int, clip: int, gap: [] f32) -> f32 {
  rig := eg_people_rig(g, false);
  cx: f32 = 0; cz: f32 = 0; least: f32 = 1;
  for a: first..<first + n {
    pa := g[0].rp.skins[a].time / rig.duration[clip];
    cx += cos(pa * 6.2831853); cz += sin(pa * 6.2831853);
    for b: a + 1..<first + n {
      d := abs(pa - g[0].rp.skins[b].time / rig.duration[clip]);
      least = lo(least, lo(d, 1 - d));
    }
  }
  gap[0] = least;
  return sqrt(cx * cx + cz * cz) / f32(n);
}

#test "raid preview: a squad that charges as one runs out of step, near or far off, posed every frame or one in four, the same on every page (#12769)" #steps 8000000000 {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview");
  people_load(g[0].people_rig[..]);
  g[0].pack_ready = true;
  g[0].feet = v3(0, 0, -16);
  dt := 1.0f32 / 60;
  // two squads of eight side by side, one at your side and one 60 m off (posed one frame in four):
  // still, then all at once they run at one speed
  for f: 0..<240 {
    for k: 0..<8 {
      // each at its own pace, as the battle moves them (rt_pace)
      sa := ifx f < 60 then 0.0f32 else 7.0f32 * rp_pace(2 + k);
      sb := ifx f < 60 then 0.0f32 else 7.0f32 * rp_pace(10 + k);
      everglade_raider(g[..], 1 + k, RP_CULTIST, f32(k) * 1.5, -20 + sa * f32(f) * dt, 0, sa, 1, 0, -1);
      everglade_raider(g[..], 9 + k, RP_CULTIST, f32(k) * 1.5, -80 + sb * f32(f) * dt, 0, sb, 1, 0, -1);
    }
    rp_draw(g[..], dt);
  }
  gap: [1] f32;
  #assert g[0].rp.skins[1].clip == PEOPLE_RUN && g[0].rp.skins[9].clip == PEOPLE_RUN;
  // at this instant, each squad's eight are spread round the run's loop, none two in step
  near := rp_test_bunched(g[..], 1, 8, PEOPLE_RUN, gap[..]);
  #assert near < 0.5 && gap[0] > 0.003;
  far := rp_test_bunched(g[..], 9, 8, PEOPLE_RUN, gap[..]);
  #assert far < 0.5 && gap[0] > 0.003;
  // each its own stride: one stride's phase drifts against another's as they run on
  #assert rp_stride(2) != rp_stride(3);
  for id: 1..<200 { #assert abs(rp_stride(id) - 1) <= f32(RP_STRIDE) + f32(RP_OWN) * 1.1 && abs(rp_stride(id) / rp_pace(id) - 1) <= f32(RP_OWN); }
  // a room's raider's gait is its creature's, wherever its body is on the page
  g[0].rp.ids[4] = 1234;
  #assert rp_id(g[..], 4) == 1234 && rp_id(g[..], 5) == 6 && rp_phase(1234) == rp_phase(rp_id(g[..], 4));
}

#test "raid preview: Darian holds his orange-orbed staff through idle, walk and cast, and his name is over his head, in the preview and in a room (#12772)" #steps 4000000000 {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview");
  people_load(g[0].people_rig[..]);
  g[0].pack_ready = true;
  g[0].feet = v3(0, 0, -16);
  dt := 1.0f32 / 60;
  ls: [4] Label;
  // still, walking, then casting: the staff's orb rides above his head, his name above that
  for f: 0..<150 {
    sp := ifx f >= 40 && f < 90 then 1.2f32 else 0.0f32;
    lit := ifx f >= 110 then 0.8f32 else 0.0f32;
    everglade_raider(g[..], 0, RP_ARCH, 0, -40 + sp * f32(f) * dt, 0, sp, 17, lit, -1);
    rp_draw(g[..], dt);
    if f == 30 || f == 70 || f == 130 {
      ground := folk_feet(g[..], 0, g[0].rp.who[0].z);
      #assert g[0].rp.arch_on;
      orb := g[0].rp.arch_orb.y - ground; name := g[0].rp.arch_name.y - ground;
      #assert orb > 1.7 && orb < 3.2 && name > 2.1 && name < 3.1 && g[0].rp.arch_glow > 0.7;
      #assert abs(g[0].rp.arch_orb.x) < 1.2 && abs(g[0].rp.arch_orb.z - g[0].rp.who[0].z) < 1.2;   // in his hand, by him
      c := rp_labels(g[..], ls[..], 0, ab_you(g[..]), 1);
      #assert c == 1 && ls[0].text == "DARIAN ODIODEI" && ls[0].person && !ls[0].gold && ls[0].light > 0.5;
    }
  }
  #assert g[0].rp.skins[0].clip == PEOPLE_SPELL;
  u: [U_LIGHTS + LIGHTS * 8] f32;
  #assert rp_lamps(g[..], u[..], 0, LIGHTS) == 1 && u[U_LIGHTS + 3] > 4 && u[U_LIGHTS + 7] > 0.5;   // its light round it
  // past REMOTE_PLATE_NEAR, no name; fallen, no name and no orb's light
  #assert rp_labels(g[..], ls[..], 0, v3(0, 0, 40), 1) == 0;
  everglade_raider(g[..], 0, RP_ARCH, 0, -40, 0, 0, 17, 0, 0.5);
  rp_draw(g[..], dt);
  #assert !g[0].rp.arch_on && rp_labels(g[..], ls[..], 0, ab_you(g[..]), 1) == 0 && rp_lamps(g[..], u[..], 0, LIGHTS) == 0;
  // a room's Darian, from the server's creature (P1 EGE_FORM_ARCH), draws with his staff and name too
  h: [1] Everglade; nn: [1] EgNet;
  rp_facts(h[..], "/worlds/everglade");
  people_load(h[0].people_rig[..]);
  h[0].pack_ready = true;
  h[0].feet = v3(0, 0, -16);
  everglade_attach_net(h[..], nn[..]);
  n := net_of(h[..]);
  r := net_ent(n, NET_MADE_ID + 9, true);
  n[0].ents[r].kind = WK_BEAST; n[0].ents[r].p1 = EGE_FORM_ARCH; n[0].ents[r].ring_n = 1;
  n[0].ents[r].shown = NetState.{x = 2, z = -45};
  h[0].time = 5;
  ege_raider_draw(h[..], n, n[0].ents[r], 1);
  rp_draw(h[..], dt);
  #assert h[0].rp.arch_on && abs(h[0].rp.arch_name.x - 2) < 0.5 && abs(h[0].rp.arch_name.z + 45) < 0.5;
  #assert h[0].rp.arch_glow > 0.7 && abs(h[0].rp.arch_orb.x - 2) < 1.2 && abs(h[0].rp.arch_orb.z + 45) < 1.2;   // and his staff
  #assert rp_labels(h[..], ls[..], 0, ab_you(h[..]), 1) == 1 && ls[0].text == "DARIAN ODIODEI";
  // the staff stands taller than he does: its orb over his name's height less a little, its foot on the ground
  #assert h[0].rp.arch_orb.y - h[0].rp.arch_feet.y > 2.2;
  // ?stage=darian: the camera 4 m off his staff's side, looking at him
  rp_facts(h[..], "/worlds/everglade?stage=darian");
  follow := Shot.{eye = v3(0, 2, -10), at = v3(0, 1, -20)};
  sh := rp_shot(h[..], follow);
  #assert abs(flat_gap(sh.eye, h[0].rp.arch_feet) - 4) < 0.05 && flat_gap(sh.at, h[0].rp.arch_feet) < 0.5;
  rp_facts(h[..], "/worlds/everglade?stage=darian-15");
  #assert abs(flat_gap(rp_shot(h[..], follow).eye, h[0].rp.arch_feet) - 15) < 0.05;
  // ?stage=front: over the gate, down the road at the siege's line
  rp_facts(h[..], "/worlds/everglade?stage=front");
  fs := rp_shot(h[..], follow);
  #assert fs.eye.z > -56 && fs.at.z < -72 && fs.eye.y > 8;
}

#test "benchmark camera stays outside the South Gate and looks down the army's road" #steps 10000000 {
  g:[1]Everglade;rp_facts(g[..],"/worlds/everglade?stage=benchmark-south-gate");shot:=rp_shot(g[..],Shot.{});
  #assert shot.eye.z==-86 && shot.eye.y==18 && shot.at.z==-54 && shot.at.y<2;
}
#test "raid preview: every kind of raider draws, a Cult Priest in its own vestment (#12771)" #steps 2000000000 {
  g: [1] Everglade;
  rp_facts(g[..], "/worlds/everglade?raid=preview");
  people_load(g[0].people_rig[..]);
  g[0].pack_ready = true;
  g[0].feet = v3(0, 0, -16);
  kinds := [5] int.[RP_CULTIST, RP_FANATIC, RP_WARLOCK, RP_ARCH, RP_PRIEST];
  for k: 0..<5 { everglade_raider(g[..], 1 + k, kinds[k], f32(k) * 2, -24, 0, 0, 1, 0, -1); }
  rp_draw(g[..], 1.0f32 / 60);
  #assert g[0].rp.who[5].npc == RP_PRIEST;
}

#test "first arrival faces the South Gate from the commons" #steps 900000000 {
  g:[1]Everglade; everglade_start(g[..]);
  #assert g[0].spawn.x == 0 && g[0].spawn.z == -16;
  #assert abs(g[0].spawn_face - f32(PI)) < 0.001;
}
