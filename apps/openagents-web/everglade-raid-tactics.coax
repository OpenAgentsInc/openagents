  63.6, -55.6, 64.4, -5,   63.6, 5, 64.4, 59.6,   62.75, -5, 65.25, -2.5,   62.75, 2.5, 65.25, 5,
  -22, -44, -6, -30,   22, 10, 34, 20,   44, 8, 56, 18,   44, -18, 54, -8,
  -44, 6, -30, 18,   -44, -18, -30, -6,   -32, 36, -22, 46,   -9, 34, 9, 52,
  24, 40, 32, 48,   8, -76, 20, -64,   -22, -24, -12, -16,   8, -26, 18, -16,
  8, -46, 18, -36,   -50, 30, -40, 40,   50, -40, 58, -30,   -52, -40, -42, -30,
