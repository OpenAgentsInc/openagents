  36.5, 5, 39.5, 7,   24.5, -7, 27.5, -5,   30.5, -7, 33.5, -5,   36.5, -7, 39.5, -5,
  -148.3, 21.6, -147.5, 22.4,   13.5, 152.5, 14.5, 153.5,   29.5, 153.5, 30.5, 154.5,   19.5, 155.5, 20.5, 156.5,
  62, 149, 70, 155,
  31, 86, 41, 94,   31, 96, 41, 104,   31, 106, 41, 114,   31, 116, 41, 124,
  31, 126, 41, 134,   47, 84, 63, 98,   48, 100, 56, 108,   58, 100, 66, 108,
  68, 100, 76, 108,   48, 112, 56, 120,   58, 112, 66, 120,   68, 112, 76, 120,
  -96, 8, -86, 18,   -108, 8, -100, 18,   -130, 8, -112, 22,   -96, -10, -86, 0,
  -108, -10, -100, 0,   -120, -10, -112, 0,   -132, -10, -124, 0,   -106, 60, -90, 72,
  -122, 60, -110, 70,   -96, 42, -88, 52,   -108, 42, -100, 52,   -120, 42, -112, 52,
  -132, 42, -124, 52,   -110, -72, -96, -60,   -132, -72, -116, -56,   -96, -90, -88, -80,
  -106, -90, -98, -80,   -116, -90, -108, -80,   -126, -90, -118, -80,   108, -10, 124, 6,
  108, -26, 116, -18,   108, -38, 116, -30,   108, 10, 116, 18,   108, 22, 116, 30,
  120, 12, 132, 26,   108, -86, 116, -76,   118, -86, 126, -76,   128, -86, 136, -76,
  108, -104, 116, -94,   118, -104, 126, -94,   128, -104, 136, -94,   38, -92, 48, -84,
  // the great lawn's park trees' trunks (EG_PARK_TREE: TRUNK_RADIUS[kind] times size either side)
  -20.528, -70.528, -19.472, -69.472,   -34.494, -74.494, -33.506, -73.506,   -50.552, -70.552, -49.448, -69.448,   -62.52, -84.52, -61.48, -83.48,
