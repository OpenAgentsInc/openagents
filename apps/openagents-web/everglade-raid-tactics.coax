  -22.552, -122.552, -21.448, -121.448,   -12.52, -108.52, -11.48, -107.48,   25.496, -70.504, 26.504, -69.496,   35.506, -78.494, 36.494, -77.506,
  53.448, -74.552, 54.552, -73.448,   65.48, -86.52, 66.52, -85.48,   59.472, -96.528, 60.528, -95.472,   61.506, -104.494, 62.494, -103.506,
  25.472, -124.528, 26.528, -123.472,   7.48, -116.52, 8.52, -115.48,   -8.504, -80.504, -7.496, -79.496,   -60.468, -94.468, -59.532, -93.532
];
// The footprints in groups that stand together, for a quick look past those far off: first,
// past the last, and the box about them all (the check "raid paths: the footprints in their
// groups" holds it to RT_BOX).
RT_GROUPS :: 15;
RT_GROUP :: [90] f32.[
  0, 4, -64.4, -57.5, 64.4, -54.5,
  4, 8, -64.4, 58.75, 64.4, 61.25,
  8, 12, -65.25, -55.6, -62.75, 59.6,
  12, 16, 62.75, -55.6, 65.25, 59.6,
  16, 24, -44, -44, 56, 52,
  24, 32, -52, -76, 58, 48,
  32, 40, -3, -7, 39.5, 7,
  40, 45, -148.3, 21.6, 70, 156.5,
  45, 57, 31, 84, 76, 134,
  57, 64, -132, -10, -86, 22,
  64, 70, -132, 42, -88, 72,
  70, 76, -132, -90, -88, -56,
  76, 88, 108, -104, 136, 30,
  88, 89, 38, -92, 48, -84,
  89, 109, -62.52, -124.528, 66.52, -69.448
];
// The palisade's gates (plan.coax EG_GATE: x, z, width, 1 when the wall runs along z) and the
// inside of its walls.
RT_TOWN_GATES :: 4;
RT_TOWN_GATE :: [16] f32.[0, -56, 6, 0,   44, 60, 5, 0,   -64, 0, 5, 1,   64, 0, 5, 1];
RT_IN_X0 :: -64.0; RT_IN_X1 :: 64.0; RT_IN_Z0 :: -56.0; RT_IN_Z1 :: 60.0;
RT_BODY :: 0.45;            // m a raider's middle keeps from a footprint (its capsule's 0.3, and a little)
RT_PAD :: 1.2;              // m out from a footprint's corner that a way round it goes
RT_AREA :: 125.0;           // m east, west, north and south of the fountain: the open town, no woods (everglade-raid-town.coax)
RT_PORTAL :: 2.5;           // m either side of a wall that a way through a gate or a breach starts and ends

// Town gate n as a way in (rt_gate), its outside away from the fountain.
rt_town_gate :: (n: int) -> RtGate {
  along_z := RT_TOWN_GATE[n * 4 + 3] > 0.5;
  return rt_gate(RT_TOWN_GATE[n * 4], RT_TOWN_GATE[n * 4 + 1], RT_TOWN_GATE[n * 4 + 2], along_z,
                 ifx along_z then -56.0f32 else -64.0f32, ifx along_z then 60.0f32 else 64.0f32, 0, 0);
}
// What of the breach sections is broken, post by post: a palisade wall is posts in a row
// (everglade.coax palisade: as many as fit RT_POST apart, spread along it), and bit i of a section's
// mask is the i-th post from RT_SPAN before its middle. A raider's middle passes the wall where
// every post within RT_BODY and half a post of it is down: two posts side by side, not one.
RT_SPAN :: 3.1;
RT_POST :: 0.62;
// Wall b's posts (RT_BOX, one of RT_WALLS): into o where they start along it (x for a wall along x,
// else z), how far apart they are, and how many; whether it runs along x.
rt_posts :: (b: int, o: [] f32) -> bool {
  k := b * 4;
  along_x := RT_BOX[k + 2] - RT_BOX[k] > RT_BOX[k + 3] - RT_BOX[k + 1];
  from := ifx along_x then RT_BOX[k] else RT_BOX[k + 1];
  reach := ifx along_x then RT_BOX[k + 2] - RT_BOX[k] else RT_BOX[k + 3] - RT_BOX[k + 1];
  n := int(reach / f32(RT_POST));
  o[0] = from; o[1] = reach / f32(n); o[2] = f32(n);
  return along_x;
}
// The wall (one of RT_WALLS) breach section n of town gate t is in (-1 none), and into o its posts
// (rt_posts), then the number of the first of the section's posts.
rt_section_wall :: (t: int, n: int, o: [] f32) -> int {
  g := rt_town_gate(t);
  if !rt_section_in(g, n) { return -1; }
  cx := g.x + g.ax * RT_BREACH[n]; cz := g.z + g.az * RT_BREACH[n];
  for b: 0..<RT_WALLS {
    k := b * 4;
    if cx < RT_BOX[k] || cx > RT_BOX[k + 2] || cz < RT_BOX[k + 1] || cz > RT_BOX[k + 3] { continue; }
    along_x := rt_posts(b, o);
    c := ifx along_x then cx else cz;
    o[3] = -floor(-(c - f32(RT_SPAN) - o[0]) / o[1] + 0.5);   // the first post whose middle is in it
    return b;
  }
  return -1;
}
// A piece of the town broke at (x, z): when it is a palisade post in a breach section, into holes
// (RT_TOWN_GATES * RT_BREACHES masks, a raid's record of the town's walls) its bit.
rt_wall_broke :: (holes: [] int, x: f32, z: f32) {
  o: [4] f32;
  for t: 0..<RT_TOWN_GATES {
    for n: 0..<RT_BREACHES {
      b := rt_section_wall(t, n, o[..]);
      if b < 0 { continue; }
      k := b * 4;
      if x < RT_BOX[k] - 0.1 || x > RT_BOX[k + 2] + 0.1 || z < RT_BOX[k + 1] - 0.1 || z > RT_BOX[k + 3] + 0.1 { continue; }
      along_x := RT_BOX[k + 2] - RT_BOX[k] > RT_BOX[k + 3] - RT_BOX[k + 1];
      j := int(floor(((ifx along_x then x else z) - o[0]) / o[1])) - int(o[3]);
      if j >= 0 && j < 2 * int(f32(RT_SPAN) / o[1]) + 1 { holes[t * RT_BREACHES + n] |= 1 << j; }
    }
  }
}
// The town gate gate g is (-1 none: the bridge, an open way).
rt_town_of :: (g: RtGate) -> int {
  if !g.wall { return -1; }
  for t: 0..<RT_TOWN_GATES { if abs(RT_TOWN_GATE[t * 4] - g.x) < 0.01 && abs(RT_TOWN_GATE[t * 4 + 1] - g.z) < 0.01 { return t; } }
  return -1;
}
// Gate g with its holes as the raid's record (holes) has its wall now.
rt_with_holes :: (holes: [] int, g: RtGate) -> RtGate {
  o := g;
  t := rt_town_of(g);
  for n: 0..<RT_BREACHES { o.hole[n] = ifx t < 0 then 0 else holes[t * RT_BREACHES + n]; }
  return o;
}
// The widest way through breach section n of gate g's wall: into o its middle (m along the wall from
// the gate) and the half of it a raider's middle may use; false when none is wide enough.
rt_gap :: (g: RtGate, n: int, o: [] f32) -> bool {
  m := g.hole[n];
  t := rt_town_of(g);
  if m == 0 || t < 0 { return false; }
  q: [4] f32;
  b := rt_section_wall(t, n, q[..]);
  if b < 0 { return false; }
  best := 0; at := 0; run := 0;
  for i: 0..<32 {
    if ((m >> i) & 1) != 0 { run += 1; if run > best { best = run; at = i - run + 1; } } else { run = 0; }
  }
  // the posts either side of the run stand: a middle passes RT_BODY and half a post short of them
  sp := q[1]; reach := f32(RT_BODY) + sp / 2;
  first := q[0] + (q[3] + f32(at) + 0.5) * sp;   // the run's first post's middle
  lo := first - sp + reach; hi := first + f32(best) * sp - reach;
  if hi - lo < 0.1 { return false; }
  // along the wall from the gate
  c := (lo + hi) / 2;
  o[0] = ifx abs(g.ax) > 0.5 then (c - g.x) * g.ax else (c - g.z) * g.az;
  o[1] = (hi - lo) / 2 - 0.02;
  return true;
}
// Whether (x, z) is in a breach of gate g's wall: in the wall's line, every post within RT_BODY and
// half a post of it down.
rt_hole :: (g: RtGate, x: f32, z: f32) -> bool {
  if !g.wall { return false; }
  out := (x - g.x) * g.ox + (z - g.z) * g.oz;
  if abs(out) > 3 { return false; }
  t := rt_town_of(g);
  if t < 0 { return false; }
  q: [4] f32;
  for n: 0..<RT_BREACHES {
    m := g.hole[n];
    if m == 0 { continue; }
    b := rt_section_wall(t, n, q[..]);
    if b < 0 { continue; }
    sp := q[1];
    u := ifx abs(g.ax) > 0.5 then x else z;
    reach := f32(RT_BODY) + sp / 2;
    // the posts within reach: their numbers in the section
    j0 := int(-floor(-(u - reach - q[0]) / sp + 0.5)) - int(q[3]);
    j1 := int(floor((u + reach - q[0]) / sp - 0.5)) - int(q[3]);
    if j0 < 0 || j1 > 31 || j1 < j0 { continue; }
    all := true;
    for i: j0..<j1 + 1 { if ((m >> i) & 1) == 0 { all = false; } }
    if all { return true; }
  }
  return false;
}
// The footprint that (x, z) stands in, grown by r m, for a raider in by gate g (its breaches open
// the wall): its number, -1 none.
rt_blocked :: (g: RtGate, x: f32, z: f32, r: f32) -> int {
  for n: 0..<RT_GROUPS {
    m := n * 6;
    if x <= RT_GROUP[m + 2] - r || x >= RT_GROUP[m + 4] + r || z <= RT_GROUP[m + 3] - r || z >= RT_GROUP[m + 5] + r { continue; }
    b := rt_blocked_in(g, int(RT_GROUP[m]), int(RT_GROUP[m + 1]), x, z, r);
    if b >= 0 { return b; }
  }
  return -1;
}
rt_blocked_in :: (g: RtGate, from: int, to: int, x: f32, z: f32, r: f32) -> int {
  for b: from..<to {
    k := b * 4;
    if x <= RT_BOX[k] - r || x >= RT_BOX[k + 2] + r || z <= RT_BOX[k + 1] - r || z >= RT_BOX[k + 3] + r { continue; }
    if b < RT_WALLS && rt_hole(g, x, z) { continue; }
    return b;
  }
  return -1;
}
// (x, z), or the nearest open ground to it when a footprint holds it: into o.
rt_free :: (g: RtGate, x: f32, z: f32, o: [] f32) {
  px := x; pz := z;
  r := f32(RT_BODY) + 0.05;
  for n: 0..<6 {
    b := rt_blocked(g, px, pz, f32(RT_BODY));
    if b < 0 { o[0] = px; o[1] = pz; return; }
    k := b * 4;
    // out by its nearest side
    w := px - (RT_BOX[k] - r); e := (RT_BOX[k + 2] + r) - px; sd := pz - (RT_BOX[k + 1] - r); nd := (RT_BOX[k + 3] + r) - pz;
    m := rt_lo(rt_lo(w, e), rt_lo(sd, nd));
    if m == w { px = RT_BOX[k] - r; } else if m == e { px = RT_BOX[k + 2] + r; } else if m == sd { pz = RT_BOX[k + 1] - r; } else { pz = RT_BOX[k + 3] + r; }
  }
  // boxed in: the nearest open spot on rings about it
  for ring: 1..<24 {
    rr := f32(ring) * 0.5;
    for a: 0..<16 {
      cx := x + cos(f32(a) * 0.3926991) * rr; cz := z + sin(f32(a) * 0.3926991) * rr;
      if rt_blocked(g, cx, cz, f32(RT_BODY)) < 0 { o[0] = cx; o[1] = cz; return; }
    }
  }
  o[0] = px; o[1] = pz;
}
// How far along the way from (x0, z0) to (x1, z1) it enters footprint b grown by r: 0 to 1, or 2
// when it doesn't.
rt_enters :: (b: int, x0: f32, z0: f32, x1: f32, z1: f32, r: f32) -> f32 {
  k := b * 4;
  bx0 := RT_BOX[k] - r; bz0 := RT_BOX[k + 1] - r; bx1 := RT_BOX[k + 2] + r; bz1 := RT_BOX[k + 3] + r;
  if rt_hi(x0, x1) <= bx0 || rt_lo(x0, x1) >= bx1 || rt_hi(z0, z1) <= bz0 || rt_lo(z0, z1) >= bz1 { return 2; }
  t0: f32 = 0; t1: f32 = 1;
  dx := x1 - x0; dz := z1 - z0;
  if abs(dx) < 0.00001 { if x0 <= bx0 || x0 >= bx1 { return 2; } }
  else {
    a := (bx0 - x0) / dx; c := (bx1 - x0) / dx;
    t0 = rt_hi(t0, rt_lo(a, c)); t1 = rt_lo(t1, rt_hi(a, c));
  }
  if abs(dz) < 0.00001 { if z0 <= bz0 || z0 >= bz1 { return 2; } }
  else {
    a := (bz0 - z0) / dz; c := (bz1 - z0) / dz;
    t0 = rt_hi(t0, rt_lo(a, c)); t1 = rt_lo(t1, rt_hi(a, c));
  }
  if t0 >= t1 { return 2; }
  return t0;
}
// The first footprint the way from (x0, z0) to (x1, z1) runs into, -1 none: for a raider in by gate
// g, the palisade's walls not from one of its breaches.
rt_first :: (g: RtGate, x0: f32, z0: f32, x1: f32, z1: f32) -> int {
  best := -1; bt: f32 = 2;
  r := f32(RT_BODY) * 0.9;
  hole := rt_hole(g, x0, z0);
  lx := rt_lo(x0, x1) - r; hx := rt_hi(x0, x1) + r; lz := rt_lo(z0, z1) - r; hz := rt_hi(z0, z1) + r;
  for n: 0..<RT_GROUPS {
    m := n * 6;
    if hx <= RT_GROUP[m + 2] || lx >= RT_GROUP[m + 4] || hz <= RT_GROUP[m + 3] || lz >= RT_GROUP[m + 5] { continue; }
    for b: int(RT_GROUP[m])..<int(RT_GROUP[m + 1]) {
      if b < RT_WALLS && hole { continue; }
      t := rt_enters(b, x0, z0, x1, z1, r);
      if t < bt { bt = t; best = b; }
    }
  }
  return best;
}
// Corner c (0 to 3, round the footprint) of footprint b, RT_PAD out: into o.
rt_corner :: (b: int, c: int, o: [] f32) {
  k := b * 4; p := f32(RT_PAD);
  cc := (c % 4 + 4) % 4;
  o[0] = ifx cc == 0 || cc == 3 then RT_BOX[k] - p else RT_BOX[k + 2] + p;
  o[1] = ifx cc < 2 then RT_BOX[k + 1] - p else RT_BOX[k + 3] + p;
}
// The way round footprint b from (x, z) to (tx, tz): into o the corner to go for first, on the
// side that is the shorter way round. A corner in another footprint, or in the disc of cr m about
// (cx, cz) (the players' spawn: rt_route), is no way.
rt_round :: (g: RtGate, b: int, x: f32, z: f32, tx: f32, tz: f32, cx: f32, cz: f32, cr: f32, o: [] f32) {
  r := f32(RT_BODY) * 0.9;
  best: f32 = 1000000; o[0] = tx; o[1] = tz;
  p: [2] f32;
  for c: 0..<4 {
    rt_corner(b, c, p[..]);
    if !rt_corner_ok(b, c, p[0], p[1], cx, cz, cr) || rt_enters(b, x, z, p[0], p[1], r) <= 1 { continue; }
    d0 := sqrt((p[0] - x) * (p[0] - x) + (p[1] - z) * (p[1] - z));
    for dir: 0..<2 {
      step := ifx dir == 0 then 1 else -1;
      cost := d0; j := c;
      qx := p[0]; qz := p[1];
      // the first corner on the way that isn't where it stands
      has := d0 > 0.5; fx := qx; fz := qz;
      for n: 0..<4 {
        if rt_enters(b, qx, qz, tx, tz, r) > 1 {
          total := cost + sqrt((tx - qx) * (tx - qx) + (tz - qz) * (tz - qz));
          if !has { fx = tx; fz = tz; }
          if total < best { best = total; o[0] = fx; o[1] = fz; }
          break;
        }
        j += step;
        q: [2] f32;
        rt_corner(b, j, q[..]);
        if !rt_corner_ok(b, j, q[0], q[1], cx, cz, cr) { break; }
        cost += abs(q[0] - qx) + abs(q[1] - qz);
        qx = q[0]; qz = q[1];
        if !has { has = true; fx = qx; fz = qz; }
      }
    }
  }
}
// Whether a way round footprint b may go by its corner c at (x, z): not in another footprint
// (RT_CORNER_OPEN), nor in the disc of cr m about (cx, cz).
rt_corner_ok :: (b: int, c: int, x: f32, z: f32, cx: f32, cz: f32, cr: f32) -> bool {
  if (x - cx) * (x - cx) + (z - cz) * (z - cz) < cr * cr { return false; }
  return (RT_CORNER_OPEN[b] & (1 << ((c % 4 + 4) % 4))) != 0;
}
// Each footprint's corners (rt_corner) that no other footprint holds (bit c of footprint b's);
// the check "raid paths: a footprint's corner is open unless another holds it" works them out.
RT_CORNER_OPEN :: [109] int.[
  9, 6, 15, 15, 9, 6, 15, 15, 1, 8, 15, 15, 2, 4, 15, 15,
  15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15,
  15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15,
  15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15
];
rt_corners_open :: (b: int) -> int {
  none := rt_open(0, 0, 0, 1);
  p: [2] f32; bits := 0;
  for c: 0..<4 { rt_corner(b, c, p[..]); if rt_blocked(none, p[0], p[1], f32(RT_BODY)) < 0 { bits = bits | (1 << c); } }
  return bits;
}
// Whether (x, z) is inside the palisade.
rt_inside :: (x: f32, z: f32) -> bool { return x > f32(RT_IN_X0) && x < f32(RT_IN_X1) && z > f32(RT_IN_Z0) && z < f32(RT_IN_Z1); }
// The way from (x, z) to (tx, tz) for a raider in by gate g, round the town's footprints (and not by
// a corner in the disc of cr m about (cx, cz): the players' spawn): into o
// the point to go for now, then o[2] 1 when that is the goal itself (0 a corner or a gate on the
// way; o holds 3). A goal in a footprint moves out of it. A way across the palisade goes
// by a gate or one of g's breaches, the one that makes it shortest: to its near side, then
// straight through. Round a footprint in the way it goes by the corner on the shorter side.
rt_way :: (g: RtGate, x: f32, z: f32, tx: f32, tz: f32, cx: f32, cz: f32, cr: f32, o: [] f32) {
  rt_free(g, tx, tz, o);
  gx := o[0]; gz := o[1];
  sx := gx; sz := gz;
  if rt_inside(x, z) != rt_inside(gx, gz) {
    sg := ifx rt_inside(x, z) then -1.0f32 else 1.0f32;   // which way out is this side
    best: f32 = 1000000; mx: f32 = 0; mz: f32 = 0; fx: f32 = 0; fz: f32 = 0; thru := false;
    nb := ifx g.wall then RT_BREACHES else 0;
    q: [2] f32;
    for n: 0..<RT_TOWN_GATES + nb {
      w := ifx n < RT_TOWN_GATES then rt_town_gate(n) else g;
      along: f32 = 0; half := w.w / 2 - 0.6;
      // a breach only where the wall is broken through
      if n >= RT_TOWN_GATES {
        if !rt_section_in(g, n - RT_TOWN_GATES) || !rt_gap(g, n - RT_TOWN_GATES, q[..]) { continue; }
        along = q[0]; half = q[1];
      }
      px := w.x + w.ax * along; pz := w.z + w.az * along;
      ax := px + w.ox * sg * f32(RT_PORTAL); az := pz + w.oz * sg * f32(RT_PORTAL);
      bx := px - w.ox * sg * f32(RT_PORTAL); bz := pz - w.oz * sg * f32(RT_PORTAL);
      cost := sqrt((ax - x) * (ax - x) + (az - z) * (az - z)) + sqrt((gx - bx) * (gx - bx) + (gz - bz) * (gz - bz));
      if cost >= best { continue; }
      best = cost; mx = ax; mz = az; fx = bx; fz = bz;
      // in the way through already: straight on
      ra := (x - px) * w.ax + (z - pz) * w.az; ro := (x - px) * w.ox + (z - pz) * w.oz;
      thru = abs(ra) < half && abs(ro) < f32(RT_PORTAL) + 0.3;
    }
    if best < 1000000 {
      if thru { o[0] = fx; o[1] = fz; o[2] = 0; return; }
      sx = mx; sz = mz;
    }
  }
  // round what stands in the way, a few footprints deep
  for n: 0..<4 {
    b := rt_first(g, x, z, sx, sz);
    if b < 0 { break; }
    p: [2] f32;
    rt_round(g, b, x, z, sx, sz, cx, cz, cr, p[..]);
    if abs(p[0] - sx) < 0.001 && abs(p[1] - sz) < 0.001 { break; }
    sx = p[0]; sz = p[1];
  }
  o[0] = sx; o[1] = sz;
  o[2] = ifx sx == gx && sz == gz then 1.0f32 else 0.0f32;
}
// The step (mx, mz) from (x, z) for a raider in by gate g, slid along whatever it would run into:
// into o where it ends. Nothing but a breach takes it into a footprint.
rt_slide :: (g: RtGate, x: f32, z: f32, mx: f32, mz: f32, o: [] f32) {
  r := f32(RT_BODY);
  if rt_blocked(g, x, z, r) >= 0 { rt_free(g, x, z, o); return; }
  o[0] = x; o[1] = z;
  if rt_blocked(g, x + mx, z + mz, r) < 0 { o[0] = x + mx; o[1] = z + mz; return; }
  if abs(mx) > 0.0001 && rt_blocked(g, x + mx, z, r) < 0 { o[0] = x + mx; return; }
  if abs(mz) > 0.0001 && rt_blocked(g, x, z + mz, r) < 0 { o[1] = z + mz; }
}

// rt_route for a raider in by gate g: a way round the spawn's near side that a footprint holds goes
// round its far side; one in the spawn's ground that a footprint keeps from leaving by the nearest
// way leaves toward its goal.
rt_around :: (g: RtGate, x: f32, z: f32, tx: f32, tz: f32, cx: f32, cz: f32, r: f32, o: [] f32) {
  rt_clear(tx, tz, cx, cz, r, o);
  gx := o[0]; gz := o[1];
  rt_route(x, z, tx, tz, cx, cz, r, o);
  dx := x - cx; dz := z - cz;
  if o[0] == gx && o[1] == gz { return; }
  if dx * dx + dz * dz < r * r {
    if rt_blocked(g, o[0], o[1], f32(RT_BODY)) >= 0 { o[0] = gx; o[1] = gz; }
    return;
  }
  if rt_blocked(g, o[0], o[1], f32(RT_PAD)) < 0 { return; }
  fx := 2 * cx - o[0]; fz := 2 * cz - o[1];
  if rt_blocked(g, fx, fz, f32(RT_PAD)) < 0 { o[0] = fx; o[1] = fz; }
}

// ---- the leader

// Where the leader holds: RT_BACK behind (lx, lz), the middle of his lines, toward (hx, hz) where he
// came from (there itself when nearer); with none of his lines left (n 0), there.
rt_command :: (lx: f32, lz: f32, n: int, hx: f32, hz: f32, o: [] f32) {
  o[0] = hx; o[1] = hz;
  if n <= 0 { return; }
  dx := hx - lx; dz := hz - lz; d := sqrt(dx * dx + dz * dz);
  if d <= f32(RT_BACK) { return; }
  o[0] = lx + dx / d * f32(RT_BACK); o[1] = lz + dz / d * f32(RT_BACK);
}
// Where Dimension Door takes the leader at (x, z) from a foe at (fx, fz): RT_DOOR away, back from it
// and toward (hx, hz).
rt_door :: (x: f32, z: f32, fx: f32, fz: f32, hx: f32, hz: f32, o: [] f32) {
  ax := x - fx; az := z - fz; ad := rt_hi(sqrt(ax * ax + az * az), 0.01);
  bx := hx - x; bz := hz - z; bd := rt_hi(sqrt(bx * bx + bz * bz), 0.01);
  dx := ax / ad + bx / bd; dz := az / ad + bz / bd; d := sqrt(dx * dx + dz * dz);
  if d < 0.01 { dx = ax / ad; dz = az / ad; d = 1; }
  o[0] = x + dx / d * f32(RT_DOOR); o[1] = z + dz / d * f32(RT_DOOR);
}

// Whether (x, z) stands where a raider can't: in one of the town's footprints (RT_BOX, the plan's:
// everglade-raid-town.coax holds them alike) but where a palisade post of the n broken ones (x, z
// pairs in posts) stood, or out past RT_AREA, where the woods' trees stand.
rt_test_clips :: (x: f32, z: f32, posts: [] f32, n: int) -> bool {
  if abs(x) > f32(RT_AREA) || abs(z) > f32(RT_AREA) { return true; }
  for b: 0..<RT_BOXES {
    k := b * 4;
    if x <= RT_BOX[k] || x >= RT_BOX[k + 2] || z <= RT_BOX[k + 1] || z >= RT_BOX[k + 3] { continue; }
    if b >= RT_WALLS || RT_BOX[k + 2] - RT_BOX[k] < 3.5 && RT_BOX[k + 3] - RT_BOX[k + 1] < 3.5 { return true; }   // a building, a trunk, a gate tower
    // a wall: every post standing within 0.6 m (a post's half and a raider's capsule) holds it
    along_x := RT_BOX[k + 2] - RT_BOX[k] > RT_BOX[k + 3] - RT_BOX[k + 1];
    reach := ifx along_x then RT_BOX[k + 2] - RT_BOX[k] else RT_BOX[k + 3] - RT_BOX[k + 1];
    count := int(reach / f32(RT_POST));
    for j: 0..<count {
      pa := (ifx along_x then RT_BOX[k] else RT_BOX[k + 1]) + (f32(j) + 0.5) * reach / f32(count);
      if abs(pa - (ifx along_x then x else z)) >= 0.6 { continue; }
      down := false;
      for q: 0..<n { if abs((ifx along_x then posts[q * 2] else posts[q * 2 + 1]) - pa) < 0.01 && posts[q * 2] >= RT_BOX[k] - 0.1 && posts[q * 2] <= RT_BOX[k + 2] + 0.1 && posts[q * 2 + 1] >= RT_BOX[k + 1] - 0.1 && posts[q * 2 + 1] <= RT_BOX[k + 3] + 0.1 { down = true; } }
      if !down { return true; }
    }
  }
  return false;
}

#test "raid tactics: squads stand spread, casters fire at the towers and a breach, then go in round the spawn" {
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  #assert south.oz == -1 && south.ax == 1 && south.lo == -64 && south.hi == 64;
  east := rt_gate(64, 0, 5, true, -56, 60, 0, 0);
  #assert east.ox == 1 && east.az == 1;
  // roles: one Cultist in three screens; Fanatics fight in melee; Warlocks cast
  #assert rt_role(RS_NPC_CULTIST, 0) == RT_MELEE && rt_role(RS_NPC_CULTIST, 1) == RT_CASTER && rt_role(RS_NPC_CULTIST, 2) == RT_CASTER;
  #assert rt_role(RS_NPC_FANATIC, 1) == RT_MELEE && rt_role(RS_NPC_WARLOCK, 0) == RT_CASTER && rt_role(RS_NPC_ARCH, 0) == RT_LEAD;
  // a squad's places: no two within RT_GAP - 0.1, the casters behind the screen, all out of the town
  xs: [16] f32; zs: [16] f32;
  p: [2] f32;
  for k: 0..<8 { rt_siege_pos(south, 0, k, RT_CASTER, p[..]); xs[k] = p[0]; zs[k] = p[1]; #assert p[1] == -56 - f32(RT_CAST_LINE); }
  for k: 0..<8 { rt_siege_pos(south, 1, k, RT_MELEE, p[..]); xs[8 + k] = p[0]; zs[8 + k] = p[1]; #assert p[1] == -56 - f32(RT_SCREEN_LINE); }
  for a: 0..<16 { for b: a + 1..<16 { dx := xs[a] - xs[b]; dz := zs[a] - zs[b]; #assert dx * dx + dz * dz > (f32(RT_GAP) - 0.1) * (f32(RT_GAP) - 0.1); } }
  // the aims: half the casters on one tower for two volleys, then the other; half on a breach
  t0 := rt_siege_aim(south, 0, 0, 0, p[..]);
  #assert t0 == RT_AIM_TOWER && p[0] == -4.5 && p[1] == -56;
  t1 := rt_siege_aim(south, 0, 0, RT_SIEGE_VOLLEYS / 2 - 1, p[..]); #assert t1 == RT_AIM_TOWER && p[0] == -4.5;
  t2 := rt_siege_aim(south, 0, 0, RT_SIEGE_VOLLEYS / 2, p[..]); #assert t2 == RT_AIM_TOWER && p[0] == 4.5;
  #assert rt_siege_aim(south, 0, 1, 0, p[..]) == RT_AIM_WALL && abs(p[0] + 15.5) < 0.01 && p[1] == -56;
  t3 := rt_siege_aim(south, 1, 1, 0, p[..]); #assert t3 == RT_AIM_WALL && abs(p[0] - 12.5) < 0.01;
  #assert rt_siege_aim(south, 0, 1, RT_SIEGE_VOLLEYS, p[..]) == RT_AIM_FOES;
  // the north gate is near a corner: a breach stays in the wall
  north := rt_gate(44, 60, 5, false, -64, 64, 0, 0);
  for s: 0..<6 { a := rt_breach_along(north, s); #assert 44 + a < 61 && 44 + a > -61; }
  // the squad goes in: an odd squad by its breach, then to its own place inside
  o: [5] f32;
  // its breach whole: by the gate; broken through (posts at 12.6 to 15.4 m down): by the breach
  rt_order(south, 1, 3, RT_MELEE, 5, true, 12, -66, 3, 4, o[..]);
  #assert abs(o[0] - 1.35) < 0.01 && o[1] == -56 + 2.5;
  bp: [32] f32; bh: [RT_TOWN_GATES * RT_BREACHES] int;
  _ := rt_test_break(bh[..], bp[..], 0, 1, 12.6, 15.4);
  south = rt_with_holes(bh[..], south);
  rt_order(south, 1, 3, RT_MELEE, 5, true, 12, -66, 3, 4, o[..]);
  gp: [2] f32;
  #assert rt_gap(south, 1, gp[..]) && abs(gp[0] - 14) < 0.5 && abs(o[0] - (gp[0] + 1.35)) < 0.01 && o[1] == -56 + 2.5;
  rt_order(south, 1, 3, RT_MELEE, 5, true, 12, -50, 3, 4, o[..]);
  #assert o[0] == 3 && o[1] == 4;
  rt_order(south, 0, 2, RT_CASTER, 1, false, 0, -90, 3, 4, o[..]);
  #assert int(o[2]) == RT_AIM_TOWER && o[1] == -56 - f32(RT_CAST_LINE);
  // the places inside: spread, none on another
  for a: 0..<40 { rt_ring(a, 0, 0, 3, 12, p[..]); ax := p[0]; az := p[1]; for b: a + 1..<40 { rt_ring(b, 0, 0, 3, 12, p[..]); #assert (ax - p[0]) * (ax - p[0]) + (az - p[1]) * (az - p[1]) > 0.25; } }
  // the call: casters joining at different times share their squad's calls
  p2 := 1.5 * f32(RT_VOLLEY_BEATS);
  #assert rt_align(10.2, 10, 1.5) == 10 + p2 && rt_align(9, 10, 1.5) == 10;
  #assert rt_volley(10 + 2 * p2, 10, 1.5) == 2 && rt_volley(10, 10, 1.5) == 0 && rt_volley(9, 10, 1.5) == -1;
  // keeping apart: two on one spot push opposite ways
  up := [3] bool.[true, true, true];
  ax := [3] f32.[0, 0.5, 9]; az := [3] f32.[0, 0, 0];
  rt_separate(0, 0, 0, ax[..], az[..], up[..], 3, p[..]); #assert p[0] < 0;
  rt_separate(0.5, 0, 1, ax[..], az[..], up[..], 3, p[..]); #assert p[0] > 0;
  // the spawn: a goal in it moves out; a way through it goes round; one in it leaves
  rt_route(0, -100, 0, -84, 0, -84, 12, p[..]); dy := p[1] + 84; #assert p[0] * p[0] + dy * dy >= 11.9 * 11.9;
  rt_route(-20, -84, 20, -84, 0, -84, 12, p[..]); #assert abs(p[1] + 84) > 12;
  rt_route(0, -82, 0, -50, 0, -84, 12, p[..]); dz := p[1] + 84; #assert p[0] * p[0] + dz * dz >= 12 * 12;
  rt_route(30, -60, 0, -50, 0, -84, 12, p[..]); #assert p[0] == 0 && p[1] == -50;
  // the leader: behind his lines, toward where he came from; Dimension Door away from a foe
  rt_command(0, -40, 10, 0, -100, p[..]); #assert p[0] == 0 && p[1] == -40 - f32(RT_BACK);
  rt_command(0, -90, 10, 0, -100, p[..]); #assert p[1] == -100;
  rt_door(0, -60, 0, -55, 0, -100, p[..]); #assert p[1] == -60 - f32(RT_DOOR);
}

// The palisade's posts of wall b (RT_BOX, one of RT_WALLS: everglade.coax palisade, POST apart) whose
// middles lie from a0 to a1 m along it (x for a wall along x, else z), broken: each into posts (x, z
// pairs, after the n there) and the raid's record holes (rt_wall_broke). The posts now.
rt_test_break :: (holes: [] int, posts: [] f32, n: int, b: int, a0: f32, a1: f32) -> int {
  k := b * 4;
  x0 := RT_BOX[k]; z0 := RT_BOX[k + 1]; x1 := RT_BOX[k + 2]; z1 := RT_BOX[k + 3];
  along_x := x1 - x0 > z1 - z0;
  reach := ifx along_x then x1 - x0 else z1 - z0;
  count := int(reach / f32(RT_POST));
  m := n;
  for j: 0..<count {
    t := (f32(j) + 0.5) * reach / f32(count);
    x := ifx along_x then x0 + t else (x0 + x1) / 2;
    z := ifx along_x then (z0 + z1) / 2 else z0 + t;
    a := ifx along_x then x else z;
    if a < a0 || a > a1 || m * 2 + 1 >= posts.count { continue; }
    posts[m * 2] = x; posts[m * 2 + 1] = z; m += 1;
    rt_wall_broke(holes, x, z);
  }
  return m;
}
// A raider's walk from (x, z) to (tx, tz) by rt_way and rt_slide, 0.25 m a step, at most n steps,
// the town's wall broken where the np posts are: into o where it ends, then the |x| where it
// crossed the line z = cz (1000 none), then 1 if it ever stood where it can't (rt_test_clips).
rt_test_walk :: (g: RtGate, x: f32, z: f32, tx: f32, tz: f32, n: int, cz: f32, posts: [] f32, np: int, o: [] f32) {
  px := x; pz := z; cross: f32 = 1000; clip: f32 = 0;
  p: [3] f32;
  for k: 0..<n {
    rt_way(g, px, pz, tx, tz, 0, -84, f32(RT_SPAWN_R), p[..]);
    dx := p[0] - px; dz := p[1] - pz; d := sqrt(dx * dx + dz * dz);
    if d < 0.05 { break; }
    m := rt_lo(0.25, d);
    rt_slide(g, px, pz, dx / d * m, dz / d * m, p[..]);
    if (pz - cz) * (p[1] - cz) <= 0 && pz != p[1] { cross = abs(p[0]); }
    px = p[0]; pz = p[1];
    if rt_test_clips(px, pz, posts, np) { clip = 1; }
  }
  o[0] = px; o[1] = pz; o[2] = cross; o[3] = clip;
}

#test "raid paths: the footprints in their groups, the corners open unless another footprint holds them" {
  for n: 0..<RT_GROUPS {
    m := n * 6;
    for b: int(RT_GROUP[m])..<int(RT_GROUP[m + 1]) {
      k := b * 4;
      #assert RT_BOX[k] >= RT_GROUP[m + 2] && RT_BOX[k + 1] >= RT_GROUP[m + 3] && RT_BOX[k + 2] <= RT_GROUP[m + 4] && RT_BOX[k + 3] <= RT_GROUP[m + 5];
    }
    #assert n == 0 || RT_GROUP[m] == RT_GROUP[m - 5];
  }
  #assert RT_GROUP[0] == 0 && RT_GROUP[(RT_GROUPS - 1) * 6 + 1] == f32(RT_BOXES);
  for b: 0..<RT_BOXES { #assert RT_CORNER_OPEN[b] == rt_corners_open(b); }
}

#test "raid paths: round the stables and the park's trees, through the palisade by the gate, or a breach only where it is broken, never in a wall, a building or a trunk (#12747)" #steps 600000000 {
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  o: [4] f32;
  posts: [64] f32; holes: [RT_TOWN_GATES * RT_BREACHES] int;
  // a goal in the stables moves out of them; a point in them, a park tree's trunk or the whole
  // wall is blocked
  rt_free(south, 14, -70, o[..]);
  #assert rt_blocked(south, o[0], o[1], f32(RT_BODY)) < 0 && rt_blocked(south, 14, -70, 0) == RT_WALLS + 9;
  #assert rt_blocked(south, -20, -70, 0) == RT_BOXES - RT_TREES && rt_blocked(south, 14, -56, 0) == 1;
  // the stables stand between: the way goes by a corner, and the walk gets there clear of them
  rt_way(south, 14, -90, 14, -60, 0, -84, f32(RT_SPAWN_R), o[..]);
  #assert o[2] < 0.5 && (o[0] < 8 || o[0] > 20);
  rt_test_walk(south, 14, -90, 14, -60, 400, -1000, posts[..], 0, o[..]);
  #assert abs(o[0] - 14) < 0.1 && abs(o[1] + 60) < 0.1 && o[3] == 0;
  // round a park tree in the way
  rt_test_walk(south, -20, -76, -20, -64, 200, -70, posts[..], 0, o[..]);
  #assert abs(o[0] + 20) < 0.1 && abs(o[1] + 64) < 0.1 && o[3] == 0 && o[2] > 0.5;
  // the wall at 34 m whole: in by the gate, not through it
  rt_test_walk(south, 34, -70, 34, -45, 800, -56, posts[..], 0, o[..]);
  #assert abs(o[0] - 34) < 0.1 && abs(o[1] + 45) < 0.1 && o[3] == 0 && o[2] < 3;
  // one post down is no way through; four posts down, 2.5 m, is: in there, between them
  np := rt_test_break(holes[..], posts[..], 0, 1, 34.0, 34.6);
  g := rt_with_holes(holes[..], south);
  #assert np == 1 && !rt_hole(g, posts[0], -56) && rt_blocked(g, 34, -56, 0) == 1;
  np = rt_test_break(holes[..], posts[..], np, 1, 32.6, 35.4);
  g = rt_with_holes(holes[..], south);
  #assert np >= 4 && rt_hole(g, 34, -56) && !rt_hole(g, 31, -56) && rt_hole(g, 34, -56.2);
  rt_test_walk(g, 34, -70, 34, -45, 400, -56, posts[..], np, o[..]);
  #assert abs(o[0] - 34) < 0.1 && abs(o[1] + 45) < 0.1 && o[3] == 0 && o[2] > 32.6 && o[2] < 35.4;
  // a way in with no breaches (the bridge's): by the gate, round the houses inside
  open := rt_open(84, -18, 0.524, 0.852);
  rt_test_walk(open, 30, -70, 13, -31, 800, -56, posts[..], np, o[..]);
  #assert abs(o[0] - 13) < 0.1 && abs(o[1] + 31) < 0.1 && o[3] == 0 && o[2] < 3;
  // and out again from the square by the gate
  rt_test_walk(open, 20, 0, 30, -80, 800, -56, posts[..], np, o[..]);
  #assert abs(o[0] - 30) < 0.1 && abs(o[1] + 80) < 0.1 && o[3] == 0 && o[2] < 3;
}
