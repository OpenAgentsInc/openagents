// Repair (R on either bar; loaded by everglade-spells.coax after everglade-placed-fire.coax): face
// something broken or burning near you, a building, a district house, a stretch of the palisade or the
// streets (a 16 m cell: sp_group), a tree, or an admin's placed thing; after its bar (CR_REPAIR_BAR)
// it stands whole again, its fire out, its soot gone, in a short golden mending as its pieces fly back.
// Moving or getting hurt on the bar stops it; then it waits CR_REPAIR_EVERY. Nothing there to repair,
// or a stop or a refusal, says why over the bar in plain words.
//
// In a room the server owns it (coax/web/room/room-casts.coax: its reach, sight, bar, interrupt and
// wait): the page sends a cast of its R slot at what it faces, runs the bar, and every page stands the
// same structure up when the server says (e mend CODE). A CODE (everglade-cast-rules.coax) is a group,
// CR_REPAIR_PLACED0 + a placed thing, or MEND_TREE0 + a tree.

MEND_TREE0 :: 200000;
MEND_NEAR :: 5.0;         // m from what you face (or the room's aim) to the broken thing's box
MEND_SPARKS :: 46;        // gold flecks of the mending

Repair :: struct {
  slot: int = -1;       // the slot on its bar (-1 none)
  code: int; at: Point; // what, and where it is
  t: f32;               // s on its bar
  x: f32; z: f32; hp: int;   // where you stood and your HP at its start
  next: f32;            // when it may go again (s of the bar's own clock)
  time: f32;
  sent: bool;           // a room's: the server has it
}
mend_of :: (s: [] Everglade) -> [] Repair { return s[0].sp.mend[..]; }
mend_on :: (s: [] Everglade) -> bool { return mend_of(s)[0].slot >= 0; }

// Whether piece i needs a Repair: broken, loose, hurt, burning or sooty.
mend_piece_hurt :: (s: [] Everglade, i: int) -> bool {
  p := sp_dm(s)[0].pieces[i];
  return p.state != DP_STANDING || p.hp < p.max_hp || fi_burning(s, i) || fi_of(s)[0].soot[i] > 0;
}
// Whether tree t needs one: off how it was planted (fallen, burnt, leaning) or burning.
mend_tree_hurt :: (s: [] Everglade, t: int) -> bool {
  if t < 0 || t >= s[0].tree_n { return false; }
  v := tf_of(s);
  k := v[0].slot[t];
  return tf_burning(s, t) || (k > 0 && (v[0].mode[k] != TF_UP || v[0].soot[k] > 0 || v[0].bare[k] > 0 || v[0].hurt[k] > 0 || v[0].lx[k] != 0 || v[0].lz[k] != 0));
}
mend_box_gap :: (x: f32, z: f32, x0: f32, z0: f32, x1: f32, z1: f32) -> f32 {
  dx := clamp(x, x0, x1) - x; dz := clamp(z, z0, z1) - z;
  return sqrt(dx * dx + dz * dz);
}
// The broken thing nearest `at` (within MEND_NEAR of it), whose box is within reach of `from`: its CODE, -1 none.
mend_find :: (s: [] Everglade, from: Point, at: Point) -> int {
  if !sp_on(s) { return -1; }
  best := f32(MEND_NEAR); code := -1;
  reach := f32(CR_REPAIR_REACH);
  w := sp_dm(s);
  for i: 0..<w[0].n {
    p := w[0].pieces[i];
    d := mend_box_gap(at.x, at.z, p.x0, p.z0, p.x1, p.z1);
    if d >= best || mend_box_gap(from.x, from.z, p.x0, p.z0, p.x1, p.z1) > reach || !mend_piece_hurt(s, i) { continue; }
    best = d; code = p.group;
  }
  for i: 0..<s[0].ev.edits.n {
    if !pf_hurt(s, i) { continue; }
    b := pf_box(s, s[0].ev.edits.things[i]);
    d := mend_box_gap(at.x, at.z, b.x0, b.z0, b.x1, b.z1);
    if d >= best || mend_box_gap(from.x, from.z, b.x0, b.z0, b.x1, b.z1) > reach { continue; }
    best = d; code = CR_REPAIR_PLACED0 + i;
  }
  for t: 0..<s[0].tree_n {
    o := t * TREE_FLOATS;
    tx := s[0].trees[o]; tz := s[0].trees[o + 1];
    dx := tx - at.x; dz := tz - at.z;
    if dx * dx + dz * dz >= best * best { continue; }
    fx := tx - from.x; fz := tz - from.z;
    if fx * fx + fz * fz > reach * reach || !mend_tree_hurt(s, t) { continue; }
    best = sqrt(dx * dx + dz * dz); code = MEND_TREE0 + t;
  }
  return code;
}
// Where structure `code` stands: its middle, a little up.
mend_centre :: (s: [] Everglade, code: int) -> Point {
  if code >= MEND_TREE0 {
    o := (code - MEND_TREE0) * TREE_FLOATS;
    x := s[0].trees[o]; z := s[0].trees[o + 1];
    return v3(x, ground_at(s, x, z) + 2, z);
  }
  if code >= CR_REPAIR_PLACED0 { return pf_centre(s, code - CR_REPAIR_PLACED0); }
  if code < 0 || code >= SP_GROUPS { return v3(0, 0, 0); }
  // its broken pieces' middle (a 16 m cell's palisade stretch, not the cell's)
  w := sp_dm(s);
  x := 0.0f32; y := 0.0f32; z := 0.0f32; n := 0;
  for i: 0..<w[0].n {
    p := w[0].pieces[i];
    if p.group != code || !mend_piece_hurt(s, i) { continue; }
    x += p.cx; y += p.cy; z += p.cz; n += 1;
  }
  if n == 0 { gx := s[0].sp.group_x[code]; gz := s[0].sp.group_z[code]; return v3(gx, ground_at(s, gx, gz) + 2, gz); }
  return v3(x / f32(n), y / f32(n), z / f32(n));
}
// Where to point at structure `code` from `from`: its broken piece nearest you (a long palisade
// stretch or a big house is within reach where you stand by it), or its middle.
mend_aim :: (s: [] Everglade, code: int, from: Point) -> Point {
  if code < 0 || code >= SP_GROUPS { return mend_centre(s, code); }
  w := sp_dm(s);
  best := 1e9f32; at := mend_centre(s, code);
  for i: 0..<w[0].n {
    p := w[0].pieces[i];
    if p.group != code || !mend_piece_hurt(s, i) { continue; }
    d := mend_box_gap(from.x, from.z, p.x0, p.z0, p.x1, p.z1);
    if d < best { best = d; at = v3(clamp(from.x, p.x0, p.x1), p.cy, clamp(from.z, p.z0, p.z1)); }
  }
  return at;
}
// What you face: the broken thing nearest the spot a few metres ahead of you, or under your feet.
mend_faced :: (s: [] Everglade) -> int {
  you := ab_you(s);
  f := ab_forward(s);
  best := -1;
  for q: 0..<4 {
    ahead := f32(q) * 4.5;
    best = mend_find(s, you, add(you, times(f, ahead)));
    if best >= 0 { return best; }
  }
  return best;
}

// Tree t stands again as it was planted (tf_restore's, for one).
mend_tree_restore :: (s: [] Everglade, t: int) -> bool {
  if t < 0 || t >= TREES { return false; }
  v := tf_of(s);
  was := mend_tree_hurt(s, t);
  k := 0;
  while k < v[0].n { if v[0].burn[k].tree == t { tf_drop(s, k); continue; } k += 1; }
  m := 0;
  while m < v[0].live_n { if v[0].live[m] == t { v[0].live_n -= 1; v[0].live[m] = v[0].live[v[0].live_n]; continue; } m += 1; }
  r := v[0].slot[t];
  if r > 0 { tf_clear(v, r); v[0].owner[r] = 0; v[0].slot[t] = 0; }
  return was;
}
// Structure `code` whole again, with its golden mending. Whether there was anything to mend.
mend_up :: (s: [] Everglade, code: int) -> bool {
  if !sp_on(s) || code < 0 { return false; }
  at := mend_centre(s, code);
  did := false;
  size := 2.0f32;
  if code >= MEND_TREE0 { did = mend_tree_restore(s, code - MEND_TREE0); size = 3; }
  else if code >= CR_REPAIR_PLACED0 { did = pf_restore(s, code - CR_REPAIR_PLACED0); size = 1; }
  else if code < SP_GROUPS {
    w := sp_dm(s);
    x0 := 1e9f32; z0 := 1e9f32; x1 := -1e9f32; z1 := -1e9f32;
    for i: 0..<w[0].n {
      p := w[0].pieces[i];
      if p.group != code || !mend_piece_hurt(s, i) { continue; }
      x0 = lo(x0, p.x0); z0 = lo(z0, p.z0); x1 = hi(x1, p.x1); z1 = hi(z1, p.z1);
    }
    if x1 > x0 { size = clamp(0.5 * sqrt((x1 - x0) * (x1 - x0) + (z1 - z0) * (z1 - z0)), 1.5, 8); }
    did = sp_restore(s, code) > 0 || x1 > x0;
  }
  if did && s[0].started { mend_glow(s, at, size); }
  return did;
}
// The mending: gold flecks drawn in toward it from round about, rising, and a ring of light at its foot.
mend_glow :: (s: [] Everglade, at: Point, size: f32) {
  gold := v3(1.35, 1.0, 0.38);
  for q: 0..<MEND_SPARKS {
    a := f32(TAU) * sp_rand(s);
    r := size * (0.6 + 0.6 * sp_rand(s));
    from := v3(at.x + cos(a) * r, at.y - 1 + 2.5 * sp_rand(s), at.z + sin(a) * r);
    vel := v3(-cos(a) * r * 1.1, 1.4 + 1.2 * sp_rand(s), -sin(a) * r * 1.1);
    sp_add_spark(s, from, vel, 0.7 + 0.5 * sp_rand(s), 0.07 + 0.06 * sp_rand(s), ifx q % 4 == 0 then v3(1.6, 1.4, 0.9) else gold, -0.4);
  }
  sp_add_shock(s, v3(at.x, ground_at(s, at.x, at.z) + 0.15, at.z), size * 1.4, 0.7, gold);
}

// R pressed: what you face, mended after its bar; nothing there, nothing happens.
// A press that does nothing says why, in plain words over the bar (owner playtest, #12929: R did
// nothing and said nothing).
mend_press :: (s: [] Everglade, slot: int) {
  v := mend_of(s);
  if v[0].slot >= 0 || watch_you(watch_w(s)[..])[0].dead { return; }   // on its bar already; or dead
  if v[0].time < v[0].next { sp_say(s, "REPAIR · READY IN", hi_int(1, cast(int) (v[0].next - v[0].time + 0.999)), "S"); return; }
  if s[0].sp.casting >= 0 { sp_say(s, "REPAIR · FINISH YOUR SPELL FIRST", -1, ""); return; }
  code := mend_faced(s);
  if code < 0 { sp_say(s, "NOTHING BROKEN HERE TO REPAIR", -1, ""); return; }
  at := mend_aim(s, code, ab_you(s));
  sent := false;
  if net_live(s) {
    // the server checks its reach and sight, runs the bar, and says what stood up (e mend)
    if !net_cast(s, slot, at, -1) { sp_say(s, "REPAIR · NOT NOW, TRY AGAIN", -1, ""); return; }
    sent = true;
  }
  v[0].slot = slot; v[0].code = code; v[0].at = at; v[0].t = 0; v[0].sent = sent;
  v[0].x = s[0].feet.x; v[0].z = s[0].feet.z; v[0].hp = watch_you(watch_w(s)[..])[0].hp;
  egt_note(s, slot, false);
}
// How much of Repair's wait is left, 1 to 0 (its icon's sweep).
mend_wait :: (s: [] Everglade) -> f32 { v := mend_of(s); return clamp((v[0].next - v[0].time) / f32(CR_REPAIR_EVERY), 0, 1); }
// Its bar stopped: moved, hurt, or the server's word (why, a CR_* reason): said in plain words.
mend_cancel :: (s: [] Everglade, why: int) {
  v := mend_of(s);
  if v[0].slot < 0 { return; }
  dx := s[0].feet.x - v[0].x; dz := s[0].feet.z - v[0].z;
  moved := dx * dx + dz * dz > f32(CR_REPAIR_MOVE) * f32(CR_REPAIR_MOVE);
  hurt := watch_on(s) && watch_you(watch_w(s)[..])[0].hp < v[0].hp;
  v[0].slot = -1; v[0].next = v[0].time + 1;
  sp_say(s, mend_why(why, moved, hurt), -1, "");
}
// What stopped a Repair, as the player reads it.
mend_why :: (why: int, moved: bool, hurt: bool) -> string {
  if why == CR_RANGE { return "REPAIR · TOO FAR AWAY, GET CLOSER"; }
  if why == CR_SIGHT { return "REPAIR · YOU CAN'T SEE IT FROM HERE"; }
  if why == CR_COOLDOWN { return "REPAIR · NOT READY YET"; }
  if why == CR_BUSY { return "REPAIR · BUSY, TRY AGAIN"; }
  if why == CR_DEAD { return "REPAIR · YOU ARE DOWN"; }
  if hurt { return "REPAIR STOPPED · YOU WERE HIT"; }
  if moved { return "REPAIR STOPPED · YOU MOVED"; }
  return "REPAIR STOPPED";
}
mend_frame :: (s: [] Everglade, dt: f32) {
  v := mend_of(s);
  v[0].time += dt;
  if v[0].slot < 0 { return; }
  v[0].t += dt;
  dx := s[0].feet.x - v[0].x; dz := s[0].feet.z - v[0].z;
  if watch_you(watch_w(s)[..])[0].dead { v[0].slot = -1; v[0].next = v[0].time + 1; return; }
  if dx * dx + dz * dz > f32(CR_REPAIR_MOVE) * f32(CR_REPAIR_MOVE) || watch_you(watch_w(s)[..])[0].hp < v[0].hp {
    mend_cancel(s, CR_NO); return;
  }
  // the hammer's work: a fleck or two at it as the bar fills
  if s[0].started && sp_rand(s) < 0.5 { sp_add_spark(s, add(v[0].at, v3((sp_rand(s) - 0.5) * 1.5, (sp_rand(s) - 0.5) * 1.5, (sp_rand(s) - 0.5) * 1.5)), v3(0, 0.8, 0), 0.5, 0.06, v3(1.3, 0.95, 0.4), -0.2); }
  if v[0].t < f32(CR_REPAIR_BAR) { return; }
  v[0].slot = -1; v[0].next = v[0].time + f32(CR_REPAIR_EVERY);   // from its end, as the server counts it
  if v[0].sent { return; }   // in a room: e mend, from the server, for every page
  _ := mend_up(s, v[0].code);
}
// e mend CODE: the server stood it up (every page alike; yours too).
mend_heard :: (s: [] Everglade, code: int) { _ := mend_up(s, code); }

// The bar, where the cast bar is drawn.
mend_bar :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, tray: f32) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  un := sp_unit(s);
  cw := sp_round(240 * un); ch := sp_round(14 * un);
  x := sp_round((w - cw) / 2);
  y := sp_round(lo(h * 0.80, tray - 40 * k - ch));
  sp_plate(s, u, Box.{x0 = x, y0 = y, x1 = x + cw, y1 = y + ch}, PLATE_METER, sp_round(un));
  f := clamp(mend_of(s)[0].t / f32(CR_REPAIR_BAR), 0, 1);
  if f > 0 { sp_plate(s, u, Box.{x0 = x + sp_round(un), y0 = y + sp_round(un), x1 = x + sp_round(un) + sp_round((cw - 2 * sp_round(un)) * f), y1 = y + ch - sp_round(un)}, PLATE_FILL, 0); }
  ts := 8 * k;
  return draw_text(out, at, "REPAIR", floor((w - text_width("REPAIR", ts)) / 2), y - 7 * k, ts, GAP, SPACE, ink(k, 1.0, HB_CAST_TEXT.x, HB_CAST_TEXT.y, HB_CAST_TEXT.z), false, false);
}

#test "repair: a press or a stop that does nothing says why in plain words (#12929)" {
  s: [1] Everglade;
  v := mend_of(s[..]);
  // waiting
  v[0].time = 2; v[0].next = 5.5;
  mend_press(s[..], SP_REBUILD);
  #assert cast(string) s[0].sp.news[0..<s[0].sp.news_n] == "REPAIR · READY IN · 4 S" && v[0].slot < 0;
  // nothing broken in a town that isn't there
  v[0].next = 0; s[0].sp.news_n = 0; s[0].sp.casting = -1;
  mend_press(s[..], SP_REBUILD);
  #assert cast(string) s[0].sp.news[0..<s[0].sp.news_n] == "NOTHING BROKEN HERE TO REPAIR" && v[0].slot < 0;
  // a spell on its bar
  s[0].sp.casting = 0; s[0].sp.news_n = 0;
  mend_press(s[..], SP_REBUILD);
  #assert cast(string) s[0].sp.news[0..<s[0].sp.news_n] == "REPAIR · FINISH YOUR SPELL FIRST";
  // the room's stops, said
  v[0].slot = SP_REBUILD; s[0].sp.news_n = 0;
  mend_cancel(s[..], CR_RANGE);
  #assert v[0].slot < 0 && cast(string) s[0].sp.news[0..<s[0].sp.news_n] == "REPAIR · TOO FAR AWAY, GET CLOSER";
  v[0].slot = SP_REBUILD; v[0].x = 0; v[0].z = 0; s[0].feet.x = 3;
  mend_cancel(s[..], CR_NO);
  #assert cast(string) s[0].sp.news[0..<s[0].sp.news_n] == "REPAIR STOPPED · YOU MOVED";
  #assert mend_why(CR_NO, false, true) == "REPAIR STOPPED · YOU WERE HIT" && mend_why(CR_SIGHT, false, false) == "REPAIR · YOU CAN'T SEE IT FROM HERE";
}
