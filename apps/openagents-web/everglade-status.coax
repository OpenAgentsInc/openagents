// What holds, slows or marks each body (#12776, #12775): one state the page draws every status from.
// Each frame st_fill fills it, once: in a room from the server's state (each player's COND bits, and
// the effect entities with their cause and time left as the wire brings them, #12783); offline from
// the page's own watch, until the offline game is the room's simulation run on the page (#12784),
// when that filler goes. Everything drawn and said about a condition reads this state only:
//   - the lines under your Hit Points (everglade5e.coax e5_holds): HELD · HOLD PERSON · 2 S;
//   - what is drawn on a body: Hold Person's golden rings, Earthbind's tendrils, Ray of Frost's motes,
//     a curse's motes, a blessing's glow, on you and on every other player alike (st_draw);
//   - and whether you may move (everglade-watch.coax everglade_held, everglade_slow).
//   coax test --library apps/openagents-web/everglade.coax --only "status:"

ST_MAX :: 48;            // effects held at once, every body's
ST_YOU :: -2;            // the WHO of you (whatever seat you have)
// What made an effect (its cause), named on its line. The wire's causes (#12783: an SRD spell or an
// Everglade ability) map onto these where the record is read.
ST_HOLD_PERSON :: 0; ST_EARTHBIND :: 1; ST_RAY_OF_FROST :: 2;
ST_CAUSES :: 3;
ST_CAUSE_NAME :: [ST_CAUSES] string.["HOLD PERSON", "EARTHBIND", "RAY OF FROST"];
// book:begin status-effect
// An effect on a body: WHO (ST_YOU, or a TGT code: 1000 + SS a seat, 0-999 a watch actor, 2000 + EID a
// creature), its condition bits (WC_*), the spell that made it (ST_*; -1 not said) and its seconds left (-1 held up, or not said).
StEffect :: struct { who: int = -1; cond: int; cause: int = -1; left: f32 = -1; }
EgStatus :: struct { n: int; e: [ST_MAX] StEffect; }
// book:end status-effect

st_add :: (s: [] Everglade, who: int, cond: int, cause: int, left: f32) {
  if cond == 0 && cause < 0 { return; }
  t := s[0].status[..];
  if t[0].n >= ST_MAX { return; }
  t[0].e[t[0].n] = StEffect.{who = who, cond = cond, cause = cause, left = left};
  t[0].n += 1;
}

// Once a frame, before anything is drawn: the state from its one source.
st_fill :: (s: [] Everglade) {
  s[0].status[0].n = 0;
  if net_live(s) { st_fill_room(s); return; }
  st_fill_watch(s);
}
// In a room: what the server says. Each player's COND bits stand for themselves; an effect the server
// names (an effect entity, its cause and its time left) says which spell and for how long.
st_fill_room :: (s: [] Everglade) {
  n := net_of(s);
  fx: [ST_MAX] NetEffect;
  c := net_effects(s, fx[..]);
  for i: 0..<c {
    who := ifx fx[i].who == WIRE_TGT_SEAT + n[0].seat then ST_YOU else fx[i].who;
    st_add(s, who, fx[i].cond, st_cause(fx[i].cause), fx[i].left);
  }
  for e: 0..<NET_ENTS {
    en := n[0].ents[e];
    if !en.live || en.kind != WK_PLAYER || en.seat < 0 { continue; }
    who := ifx en.seat == n[0].seat then ST_YOU else 1000 + en.seat;
    st_add_bits(s, who, en.p1);
  }
}
// The wire's cause (WE_*) as the line names it; -1 one it doesn't name.
st_cause :: (we: int) -> int {
  if we == WE_HOLD_PERSON { return ST_HOLD_PERSON; }
  if we == WE_EARTHBIND { return ST_EARTHBIND; }
  if we == WE_RAY_OF_FROST { return ST_RAY_OF_FROST; }
  return -1;
}
// Offline: the page's own watch has you held, bound and slowed, and the rules their conditions.
// (#12784 runs the room's simulation on the page; then this goes and st_fill_room is the only filler.)
st_fill_watch :: (s: [] Everglade) {
  if !s[0].wv.started { return; }
  w := watch_w(s);
  y := watch_you(w[..])[0];
  if y.dead { return; }
  if watch_held(w) { st_add(s, ST_YOU, WC_PARALYZED, ST_HOLD_PERSON, y.held_t); }
  if watch_bound(w) { st_add(s, ST_YOU, WC_BOUND, ST_EARTHBIND, y.bound_t); }
  if y.slow_t > 0 { st_add(s, ST_YOU, WC_SLOWED, ST_RAY_OF_FROST, y.slow_t); }
}
// A body's COND bits as effects, the bits a named effect already covers left out: Everglade's known
// causes for its own (Hold Person paralyzes, Earthbind binds, Ray of Frost slows), the rest as they are.
st_add_bits :: (s: [] Everglade, who: int, cond: int) {
  c := cond & (-1 ^ st_named(s, who));
  if (c & WC_PARALYZED) != 0 { st_add(s, who, WC_PARALYZED, ST_HOLD_PERSON, -1); c &= (-1 ^ WC_PARALYZED); }
  if (c & WC_BOUND) != 0 { st_add(s, who, WC_BOUND, ST_EARTHBIND, -1); c &= (-1 ^ WC_BOUND); }
  if (c & WC_SLOWED) != 0 { st_add(s, who, WC_SLOWED, ST_RAY_OF_FROST, -1); c &= (-1 ^ WC_SLOWED); }
  if c != 0 { st_add(s, who, c, -1, -1); }
}
// The bits named effects on `who` already carry.
st_named :: (s: [] Everglade, who: int) -> int {
  t := s[0].status[..]; c := 0;
  for i: 0..<t[0].n { if t[0].e[i].who == who && t[0].e[i].cause >= 0 { c |= t[0].e[i].cond; } }
  return c;
}
// Every bit on `who` (ST_YOU: you).
st_cond :: (s: [] Everglade, who: int) -> int {
  t := s[0].status[..]; c := 0;
  for i: 0..<t[0].n { if t[0].e[i].who == who { c |= t[0].e[i].cond; } }
  return c;
}
// The longest time left of the effects on `who` with bits in `bits` (-1 none said).
st_left :: (s: [] Everglade, who: int, bits: int) -> f32 {
  t := s[0].status[..]; l := -1.0f32;
  for i: 0..<t[0].n { if t[0].e[i].who == who && (t[0].e[i].cond & bits) != 0 { l = hi(l, t[0].e[i].left); } }
  return l;
}

// The cause's name, in capitals, into out: an SRD spell's, or an Everglade ability's.
st_cause_name :: (cause: int, out: [] u8) -> int {
  if cause < 0 || cause >= ST_CAUSES { return 0; }
  return st_upper(out, 0, ST_CAUSE_NAME[cause]);
}
st_upper :: (out: [] u8, at: int, t: string) -> int {
  n := at;
  for ch: t { if n >= out.count { break; } c := ch; if c >= 'a' && c <= 'z' { c -= 32; } out[n] = c; n += 1; }
  return n;
}
// What one effect's bit is called on its line.
st_word :: (cond: int) -> string {
  if (cond & WC_PARALYZED) != 0 { return "HELD"; }
  if (cond & WC_BOUND) != 0 { return "BOUND"; }
  if (cond & WC_SLOWED) != 0 { return "SLOWED"; }
  return "";
}
// Effect i's line: WORD · CAUSE · N S (each part only when it is known), its count in out.
st_line :: (s: [] Everglade, i: int, out: [] u8) -> int {
  e := s[0].status[0].e[i];
  m := 0;
  word := st_word(e.cond);
  if word.count > 0 { m = st_upper(out, m, word); }
  cb: [40] u8; cn := st_cause_name(e.cause, cb[..]);
  if cn > 0 { if m > 0 { m = st_upper(out, m, " · "); } m = st_upper(out, m, cast(string) cb[0..<cn]); }
  if m > 0 && e.left >= 0 { m = st_upper(out, m, " · "); m = put_digits(out, m, hi_int(cast(int) -floor(-e.left), 1)); m = st_upper(out, m, " S"); }
  return m;
}
// Its tone on the plate: 0 held (gold), 1 bound (earth), 2 slowed (frost), 3 any other.
st_tone :: (cond: int) -> int {
  if (cond & WC_PARALYZED) != 0 { return 0; }
  if (cond & WC_BOUND) != 0 { return 1; }
  if (cond & WC_SLOWED) != 0 { return 2; }
  return 3;
}

// ---- on the bodies

// Where `who` is drawn (world feet), ok false when it isn't.
StAt :: struct { ok: bool; at: Point; }
st_where :: (s: [] Everglade, who: int) -> StAt {
  if who == ST_YOU { return StAt.{ok = true, at = ab_you(s)}; }
  if who >= 1000 && who < 2000 {
    pose: [4] f32;
    if net_seat_pose(s, who - 1000, pose[..]) { return StAt.{ok = true, at = v3(pose[0], pose[1], pose[2])}; }
  }
  return StAt.{};
}
// What holds or marks every body, drawn on it (from spells_frame, between its sp_fx start and close).
st_bodies_draw :: (s: [] Everglade) {
  t := s[0].status[..];
  done: [ST_MAX] int; dn := 0;
  for i: 0..<t[0].n {
    who := t[0].e[i].who;
    seen := false;
    for j: 0..<dn { if done[j] == who { seen = true; } }
    if seen || dn >= ST_MAX { continue; }
    done[dn] = who; dn += 1;
    w := st_where(s, who);
    if w.ok { st_draw_on(s, w.at, st_cond(s, who)); }
  }
}
st_draw_on :: (s: [] Everglade, you: Point, c: int) {
  tm := f32(s[0].time);
  if (c & WC_PARALYZED) != 0 {
    for q: 0..<3 {
      h := 0.35 + 0.6 * f32(q) + 0.06 * sin(tm * 3 + f32(q) * 2.1);
      r := 0.62 - 0.08 * f32(q) + 0.04 * sin(tm * 5 + f32(q));
      sp_fx(s, FX_RING, v3(you.x, you.y + h, you.z), r, v3(2.2, 1.6, 0.5), 0, v3(0, 0, 0), f32(q) * 0.31 + tm * 0.2);
      for j: 0..<4 {
        ang := tm * (1.6 - 0.5 * f32(q)) + f32(j) * f32(PI) * 0.5 + f32(q);
        sp_glow(s, v3(you.x + r * 0.86 * cos(ang), you.y + h, you.z + r * 0.86 * sin(ang)), 0.11, v3(1.8, 1.4, 0.5));
      }
    }
  }
  if (c & WC_BOUND) != 0 {
    // six tendrils of dark earth out of the ground, curling in round the shins and pulling, each a
    // few clods of rock stacked up it, and a faint amber glint of the spell along them
    for j: 0..<6 {
      ang := f32(j) * f32(PI) / 3 + 0.3 * sin(tm * 0.8 + f32(j));
      pull := 0.5 + 0.5 * sin(tm * 2.6 + f32(j) * 1.7);
      for q: 0..<4 {
        f := f32(q) / 3;
        rr := 0.62 - 0.36 * f;
        h := 0.04 + (0.5 + 0.12 * pull) * f;
        twist := ang + f * 0.9;
        at := v3(you.x + rr * cos(twist), you.y + h, you.z + rr * sin(twist));
        sz := 0.11 - 0.05 * f;
        shape(s, SHAPE_BOX, LOOK_ROCK, at, twist + 0.6 * f, 0.5 + 0.4 * f, sz, sz * 1.6, sz, 0.22, 0.15, 0.09);
        if q == 3 { sp_glow(s, at, 0.07, v3(0.9, 0.55, 0.18)); }
      }
    }
    sp_fx(s, FX_RING, v3(you.x, you.y + 0.05, you.z), 0.66, v3(0.7, 0.42, 0.14), 0, v3(0, 0, 0), tm * 0.1);
  }
  if (c & WC_SLOWED) != 0 {
    for j: 0..<8 {
      ph := (tm * 0.5 + f32(j) * 0.125) - floor(tm * 0.5 + f32(j) * 0.125);
      ang := f32(j) * 2.4 + tm * 1.3;
      sp_glow(s, v3(you.x + 0.45 * cos(ang), you.y + 0.2 + 1.6 * ph, you.z + 0.45 * sin(ang)), 0.08 + 0.04 * (1 - ph), v3(0.8, 1.0, 1.5));
    }
  }
  // any other condition the server names on the body (a curse, a stun, a fear): dim violet motes about the head
  if (c & (-1 ^ (WC_PARALYZED | WC_BOUND | WC_SLOWED))) != 0 {
    for j: 0..<5 {
      ang := tm * 1.1 + f32(j) * 1.2566;
      sp_glow(s, v3(you.x + 0.38 * cos(ang), you.y + 2.0 + 0.08 * sin(tm * 3 + f32(j)), you.z + 0.38 * sin(ang)), 0.07, v3(0.7, 0.35, 1.0));
    }
  }
}

#test "status: offline the watch fills it, in a room the server's COND; the lines name the spell and its seconds" #steps 2000000000 {
  s: [1] Everglade;
  st_add(s[..], ST_YOU, WC_PARALYZED, ST_HOLD_PERSON, 1.4);
  st_add_bits(s[..], ST_YOU, WC_PARALYZED | WC_SLOWED);   // the summary: Hold Person's bit is named already
  #assert s[0].status[0].n == 2 && st_cond(s[..], ST_YOU) == WC_PARALYZED | WC_SLOWED;
  b: [64] u8;
  #assert cast(string) b[0..<st_line(s[..], 0, b[..])] == "HELD · HOLD PERSON · 2 S";
  #assert cast(string) b[0..<st_line(s[..], 1, b[..])] == "SLOWED · RAY OF FROST";
  st_add_bits(s[..], 1003, WC_BOUND);
  #assert st_cond(s[..], 1003) == WC_BOUND && st_cond(s[..], ST_YOU) == WC_PARALYZED | WC_SLOWED;
  #assert cast(string) b[0..<st_line(s[..], 2, b[..])] == "BOUND · EARTHBIND";
  // the wire's causes (#12783) name the same spells; the watch's arrest names none
  #assert st_cause(WE_HOLD_PERSON) == ST_HOLD_PERSON && st_cause(WE_EARTHBIND) == ST_EARTHBIND && st_cause(WE_RAY_OF_FROST) == ST_RAY_OF_FROST && st_cause(WE_WATCH) == -1;
}
