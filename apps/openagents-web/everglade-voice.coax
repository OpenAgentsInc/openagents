// Everglade's voice edits (eg-voice-edit), loaded by everglade.coax: an
// admin holds TALK TO EDIT at the bottom middle (or V on a keyboard) and
// says what to change. Holding opens the microphone through the page's voice
// (coax/web/voice.js, action 7 "on"); letting go closes it at once and ends
// the turn ("end"). The voice host sends the final words back unanswered
// (we face the realm's builder, action 8) as message 50 "heard|WORDS"; the
// face sends them to the server's typed selector (POST
// /api/playtest/realm/everglade/edit, an admin only), which answers one edit
// of the realm's catalogue: place an item (with a count), remove the
// nearest placed thing, or undo; or, when what was said is no edit (a
// question, small talk), a short answer to it, shown and spoken back
// ("chat", migrations/0056_voice_edit_chat.sql). Nothing here reads the words: only that
// typed answer, held again to verse/everglade/edits.coax. The edit is done in
// front of you (or takes away the things or people it names: a whole row
// for "these crates"), the list published as Everglade's world (an admin's
// write, checked on the server), and what was done is shown and spoken back
// (action 9). What was heard shows while the server answers.
//
// Everyone's page lays the published list over the plan (everglade_world):
// a non-admin sees the things and has no button. The switch is the page's:
// realms.json "voice" (data-voice) names the voice route, and the page facts'
// voice= line says so; the server's /api/auth/me says A|1 for an admin.

#load "../../verse/everglade/edits.coax";
#load "../../verse/edit/edit.coax";   // the board, SETTINGS and the cards every realm has (docs/verse/realm-edit.md)
#load "everglade-edit.coax";

MSG_VOICE :: 50;          // voice.js: "phase|caption"
MSG_VIEWER :: 606;        // host.js: /api/auth/me's lines
ACT_VOICE :: 7; ACT_VOICE_TO :: 8; ACT_VOICE_SAY :: 9;
VOICE_FACING :: "Everglade builder";   // whom the voice host leaves our turns to: the page answers
EDIT_UNDOS :: 16;
EDIT_POST :: 6144;
EDIT_ASK :: 512;
EDIT_SAID :: 300;         // one heard sentence (the server keeps 300 characters)
EDIT_QUEUE :: 6;          // heard sentences waiting their turn, in the order said
EDIT_LINE :: 480;

EditVoice :: struct {
  admin: bool;              // /api/auth/me said A|1 (checked again by every write on the server)
  voice: bool;              // this page has voice edits on (realms.json)
  edits: EgEdits;           // what's published over the plan
  undos: [EDIT_UNDOS] EgEdits; undo_n: int;
  redos: [EDIT_UNDOS] EgEdits; redo_n: int;   // what UNDO took back, for REDO (everglade-edit.coax)
  editing: bool;                      // edit mode (everglade-edit.coax), an admin's only
  picked: int;                        // the placed thing picked in it, -1 none
  sure: f64;                          // ORIGINAL pressed once: until this time a second press puts the plan back
  due: f64;                           // a change by hand is published at this time (0 none)
  reset: bool;                        // the face should ask the server for the designed city
  boxes: [EB_N] Box; lit: int; finger2: int;   // edit mode's buttons, the one held, and its finger
  eye_x: f32; eye_z: f32;             // the camera, for which way AWAY is
  sx: [EG_EDIT_MAX] f32; sy: [EG_EDIT_MAX] f32; seen: [EG_EDIT_MAX] bool;   // the things on the screen, for a pick
  button: Box; finger: int; held: bool; key: bool;
  want_face: bool; want_voice: int;   // 1 on, 2 end
  phase: [16] u8; phase_n: int;
  caption: [EDIT_LINE] u8; caption_n: int;
  line: [EDIT_LINE] u8; line_n: int;  // what was done, or why not
  ask: [EDIT_ASK] u8; ask_n: int;     // the request the face is sending
  // Sentences said while one is with the server wait here, in order: none replaces another
  waiting: [EDIT_QUEUE * EDIT_SAID] u8; waiting_n: [EDIT_QUEUE] int; wait_at: int; wait_count: int;
  asking: [EDIT_SAID] u8; asking_n: int;   // the sentence with the server now (0 none)
  shown: [EDIT_LINE] u8;              // the line on the screen, put together
  post: [EDIT_POST] u8; post_n: int;  // the list to publish, for the face
  say: [EDIT_LINE] u8; say_n: int;    // what to speak back
  person: int;                        // the city's person picked in edit mode, -1 none
  px: [EG_SPOTS] f32; py: [EG_SPOTS] f32; pseen: [EG_SPOTS] bool;   // the people on the screen, for a pick
  wall_base: int;
  town_used: [KIT_GROUPS] int;        // what the town uses of each group (everglade-items.coax)
  built_hidden: u32;                  // the plan's buildings the town was last laid without
  word1: [64] u8; word2: [64] u8; onto_words: [64] u8;   // scratch for what a line says
  spot: [EDIT_SPOTS * 4] f32; spot_k: [EDIT_SPOTS] int; spot_n: int;   // the patches' plants
  // The shared edit layer: its EDIT is Everglade's (the board and SETTINGS open with edit mode); a
  // visitor with BUILD places as cards; its owner and admins edit as a site admin does
  ed: [1] RealmEdit; ed_open: bool;
}

voice_on :: (s: [] Everglade) -> bool { return s[0].ev.admin && s[0].ev.voice; }

ev_put :: (out: [] u8, text: string) -> int {
  n := 0;
  for i: 0..<text.count { if n < out.count { out[n] = text[i]; n += 1; } }
  return n;
}
ev_line :: (s: [] Everglade, text: string) { s[0].ev.line_n = ev_put(s[0].ev.line[..], text); }
ev_say :: (s: [] Everglade, text: string) { s[0].ev.say_n = ev_put(s[0].ev.say[..], text); }

// ---- messages

// The viewer's lines (A|1 an admin), the page facts' voice= line, and the voice's phase.
everglade_voice_message :: (s: [] Everglade, kind: int, text: string) -> bool {
  if redit_message(s[0].ev.ed[..], kind, text) { return true; }
  if kind == MSG_VIEWER {
    s[0].ev.admin = false;
    i := 0;
    while i < text.count {
      e := i; while e < text.count && text[e] != '\n' { e += 1; }
      if text[i..<e] == "A|1" { s[0].ev.admin = true; }
      i = e + 1;
    }
    return true;
  }
  if kind == MSG_FACTS {
    i := 0;
    while i < text.count {
      e := i; while e < text.count && text[e] != '\n' { e += 1; }
      line := text[i..<e];
      if line.count > 6 && line[0..<6] == "voice=" { s[0].ev.voice = true; }
      i = e + 1;
    }
    return false;   // the page reads the facts too
  }
  if kind != MSG_VOICE { return false; }
  bar := 0; while bar < text.count && text[bar] != '|' { bar += 1; }
  phase := text[0..<bar];
  caption := ifx bar < text.count then text[bar + 1..<text.count] else "";
  s[0].ev.phase_n = ev_put(s[0].ev.phase[..], phase);
  s[0].ev.caption_n = ev_put(s[0].ev.caption[..], caption);
  // The turn's final words: an edit to ask for (the server picks it; nothing here reads them),
  // after any said before it.
  if phase == "heard" && caption.count > 0 && voice_on(s) {
    if s[0].ev.wait_count >= EDIT_QUEUE { ev_line(s, "SIX ARE WAITING ALREADY · SAY IT AGAIN AFTER THEM"); return true; }
    slot := (s[0].ev.wait_at + s[0].ev.wait_count) % EDIT_QUEUE;
    n := 0;
    for c: 0..<caption.count {
      ch := caption[c];
      if ch == '"' || ch == '\\' || ch < 32 { continue; }
      if n < EDIT_SAID { s[0].ev.waiting[slot * EDIT_SAID + n] = ch; n += 1; }
    }
    s[0].ev.waiting_n[slot] = n;
    if n > 0 { s[0].ev.wait_count += 1; }
  }
  return true;
}

// The next waiting sentence, as the face's request, when none is with the server.
ev_next_ask :: (s: [] Everglade) {
  if s[0].ev.asking_n > 0 || s[0].ev.ask_n > 0 || s[0].ev.wait_count == 0 { return; }
  slot := s[0].ev.wait_at;
  said := s[0].ev.waiting[slot * EDIT_SAID..<slot * EDIT_SAID + s[0].ev.waiting_n[slot]];
  s[0].ev.asking_n = ev_put(s[0].ev.asking[..], cast(string) said);
  s[0].ev.wait_at = (slot + 1) % EDIT_QUEUE; s[0].ev.wait_count -= 1;
  n := ev_put(s[0].ev.ask[..], "{\"sentence\":\"");
  n += ev_put(s[0].ev.ask[n..<EDIT_ASK], cast(string) said);
  n += ev_put(s[0].ev.ask[n..<EDIT_ASK], "\"}");
  s[0].ev.ask_n = n;
}

// ---- the button: hold to talk

ev_press :: (s: [] Everglade) {
  if s[0].ev.held { return; }
  s[0].ev.held = true; s[0].ev.want_face = true; s[0].ev.want_voice = 1;
  s[0].ev.line_n = 0;
}
ev_release :: (s: [] Everglade) {
  if !s[0].ev.held { return; }
  s[0].ev.held = false; s[0].ev.want_voice = 2;
}

everglade_voice_key :: (s: [] Everglade, key: int, down: bool) -> bool {
  used := redit_key(s[0].ev.ed[..], key, down);
  if used > 0 { return used == 1; }
  if everglade_edit_key(s, key, down) { return true; }
  if !voice_on(s) || s[0].ev.editing || (key != 'v' && key != 'V') || s[0].talk >= 0 || s[0].board { return false; }
  if down && !s[0].ev.key { s[0].ev.key = true; ev_press(s); }
  if !down && s[0].ev.key { s[0].ev.key = false; ev_release(s); }
  return true;
}

everglade_voice_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, id: int) -> bool {
  if redit_pointer(s[0].ev.ed[..], x, y, phase, id) { return true; }
  if everglade_edit_pointer(s, x, y, phase, id) { return true; }
  if !voice_on(s) { return false; }
  if phase == 0 && in_box(s[0].ev.button, x, y) { s[0].ev.finger = id; ev_press(s); return true; }
  if s[0].ev.finger != id || !s[0].ev.held { return false; }
  if phase >= 2 { s[0].ev.finger = -1; ev_release(s); }
  return true;
}

// The voice's actions, one a frame, when the outbox is free.
everglade_voice_actions :: (s: [] Everglade) {
  edit_layer(s);
  edit_tick(s);
  if s[0].action != 0 { return; }
  if s[0].ev.want_face {
    s[0].ev.want_face = false;
    s[0].out_n = ev_put(s[0].outbox[..], VOICE_FACING); s[0].action = ACT_VOICE_TO;
    return;
  }
  if s[0].ev.want_voice != 0 {
    s[0].out_n = ev_put(s[0].outbox[..], ifx s[0].ev.want_voice == 1 then "on" else "end"); s[0].action = ACT_VOICE;
    s[0].ev.want_voice = 0;
    return;
  }
  if s[0].ev.say_n > 0 {
    for i: 0..<s[0].ev.say_n { s[0].outbox[i] = s[0].ev.say[i]; }
    s[0].out_n = s[0].ev.say_n; s[0].action = ACT_VOICE_SAY; s[0].ev.say_n = 0;
  }
}

// ---- the face's calls

// The request to send (0 none): the face asks only when it has none out, and answers with everglade_edit_answer.
everglade_edit_ask :: (s: [] Everglade) -> int #export_c { ev_next_ask(s); return s[0].ev.ask_n; }
everglade_edit_ask_sent :: (s: [] Everglade) #export_c { s[0].ev.ask_n = 0; }
everglade_edit_post :: (s: [] Everglade) -> int #export_c { return s[0].ev.post_n; }
everglade_edit_post_sent :: (s: [] Everglade) #export_c { s[0].ev.post_n = 0; }
// ORIGINAL: the face asks the server for the designed city (POST .../reset) once.
everglade_edit_reset :: (s: [] Everglade) -> bool #export_c { r := s[0].ev.reset; s[0].ev.reset = false; return r; }

// The published list (GET /api/playtest/world/everglade's answer), laid over the plan for everyone.
everglade_world :: (s: [] Everglade, answer: string) #export_c {
  got: [1] EgEdits;
  if eg_edits_answer(answer, got[..]) < 0 { return; }
  s[0].ev.edits = got[0];
  edit_walls(s);
}

// The publish's answer: saved for everyone, or not.
everglade_edit_saved :: (s: [] Everglade, status: int) #export_c {
  if status == 200 { return; }
  ev_line(s, ifx status == 403 || status == 401 then "NOT SAVED · LOG IN AS AN ADMIN" else "NOT SAVED · TRY AGAIN");
}

// The selector's answer ("STATUS\n" and its JSON): the edit, done in front of you.
everglade_edit_answer :: (s: [] Everglade, answer: string) #export_c {
  ev_answered(s, answer);
  s[0].ev.asking_n = 0; s[0].ev.ask_n = 0;   // the next waiting sentence goes now
}
ev_answered :: (s: [] Everglade, answer: string) {
  if answer.count < 4 || answer[0..<4] != "200\n" {
    if answer.count >= 4 && answer[0..<4] == "422\n" {
      // no edit and no answer to it: what was heard, and nothing more
      n := ev_put(s[0].ev.line[..], "DIDN'T CATCH THAT: '");
      for c: 0..<s[0].ev.asking_n { if n < EDIT_LINE - 1 { s[0].ev.line[n] = s[0].ev.asking[c]; n += 1; } }
      n += ev_put(s[0].ev.line[n..<EDIT_LINE], "'");
      s[0].ev.line_n = n;
      ev_say(s, "Sorry, I didn't catch that.");
      return;
    }
    ev_line(s, "THAT DIDN'T WORK · TRY AGAIN");
    ev_say(s, "That didn't work. Try again.");
    return;
  }
  body := answer[4..<answer.count];
  e := eg_json_at(body, "edit");
  if e < 0 || body[e] != '"' { ev_line(s, "THAT DIDN'T WORK · TRY AGAIN"); return; }
  word := ev_word(body, e);
  // not an edit: the server's answer to what was said, shown and spoken as it is
  if word == "chat" {
    reply := ev_field(body, "reply");
    if reply.count == 0 { ev_line(s, "THAT DIDN'T WORK · TRY AGAIN"); return; }
    ev_line(s, reply); ev_say(s, reply);
    return;
  }
  if word == "undo" { edit_undo(s, true); return; }
  if word == "list" { edit_list(s); return; }
  if word == "missing" { edit_missing(s, ev_field(body, "name"), false); return; }
  item := ev_item(ev_field(body, "item"));
  all := ev_true(body, "all");
  if word == "remove" {
    who := ev_who(ev_field(body, "who"));
    bname := ev_field(body, "building");
    big := item >= 0 && item < EG_EDIT_ITEMS && EG_EDIT_SORT[item] == EG_SORT_BUILDING;
    if ev_field(body, "item") == "building" || big || bname.count > 0 && item < 0 {
      if big && edit_remove_placed(s, item, all) { return; }   // a placed house near you goes first
      // else the city's: the one named, a house for "that house", the nearest for "this building"
      edit_hide(s, ifx bname.count > 0 then bname else ifx item == EG_KIND_HOUSE then "house" else "");
      return;
    }
    edit_remove(s, item, who, all);
    return;
  }
  if word == "restore" { edit_restore(s, ev_field(body, "building"), ev_who(ev_field(body, "who"))); return; }
  if word == "move" { edit_move(s, item, all, ev_field(body, "direction"), ev_float(body, "metres", 2)); return; }
  if word == "resize" { edit_resize(s, item, all, ev_float(body, "size", 1.5)); return; }
  if word == "rotate" { edit_rotate(s, item, all, ev_float(body, "turn", 90)); return; }
  if word != "place" { ev_line(s, "THAT DIDN'T WORK · TRY AGAIN"); return; }
  if item < 0 || item >= EG_EDIT_ITEMS { edit_missing(s, ev_field(body, "item"), true); return; }
  c := eg_json_at(body, "count");
  count := 1;
  if c >= 0 { got := eg_number(body[c..<body.count], 0); if got.v > 0 { count = eg_clamp_n(got.v, 1, 40); } }
  onto := ev_item(ev_field(body, "onto"));
  tint := 0;
  colour := ev_field(body, "colour");
  for k: 1..<EG_COLOURS { if colour == EG_COLOUR_NAME[k] { tint = k; } }
  size := clamp(ev_float(body, "size", 1), f32(EG_EDIT_SIZE_MIN), f32(EG_EDIT_SIZE_MAX));
  arrange := ev_field(body, "arrange");
  if onto >= 0 && EG_EDIT_TOP[onto] > 0 { edit_place_onto(s, item, count, onto, size, tint); return; }
  if EG_EDIT_SORT[item] == EG_SORT_PATCH { edit_patch(s, item, count, arrange == "fill" || arrange == "scatter", size, tint); return; }
  if arrange == "ring" { edit_ring(s, item, count, size, tint); return; }
  if arrange == "scatter" || arrange == "fill" { edit_scatter(s, item, ifx arrange == "fill" then hi_i(count, 12) else count, size, tint, arrange == "fill"); return; }
  edit_place_as(s, item, count, size, tint, true);
}
// A string field's words ("" when there is none or it isn't a string).
ev_field :: (body: string, key: string) -> string {
  at := eg_json_at(body, key);
  if at < 0 || body[at] != '"' { return ""; }
  return ev_word(body, at);
}
ev_true :: (body: string, key: string) -> bool {
  a := eg_json_at(body, key);
  return a >= 0 && a + 4 <= body.count && body[a..<a + 4] == "true";
}
// A number field (whole or with a fraction, maybe negative), or otherwise.
ev_float :: (body: string, key: string, otherwise: f32) -> f32 {
  at := eg_json_at(body, key);
  if at < 0 { return otherwise; }
  i := at; minus := false;
  if i < body.count && body[i] == '-' { minus = true; i += 1; }
  v := 0.0f32; digits := 0;
  while i < body.count && body[i] >= '0' && body[i] <= '9' { v = v * 10 + f32(body[i] - '0'); i += 1; digits += 1; }
  if i < body.count && body[i] == '.' {
    i += 1; place := 0.1f32;
    while i < body.count && body[i] >= '0' && body[i] <= '9' { v += place * f32(body[i] - '0'); place = place / 10; i += 1; digits += 1; }
  }
  if digits == 0 { return otherwise; }
  return ifx minus then -v else v;
}
// The catalogue's index for an item's name (EG_EDIT_NAME), a person or a cat, or -1.
ev_item :: (w: string) -> int {
  for k: 0..<EG_EDIT_ITEMS { if w == EG_EDIT_NAME[k] { return k; } }
  if w == "person" { return EG_PICK_PERSON; }
  if w == "cat" { return EG_PICK_CAT; }
  return -1;
}
ev_who :: (w: string) -> int {
  for k: 0..<EG_SPOTS { if w == EG_PERSON[k] { return k; } }
  return -1;
}
eg_clamp_n :: (v: int, a: int, b: int) -> int { if v < a { return a; } if v > b { return b; } return v; }
// A JSON string value's words at text[at] (its opening quote).
ev_word :: (text: string, at: int) -> string {
  e := at + 1; while e < text.count && text[e] != '"' { e += 1; }
  return text[at + 1..<e];
}

// ---- the edits

edit_remember :: (s: [] Everglade) {
  s[0].ev.redo_n = 0;   // a new change: what was undone can't come back
  if s[0].ev.undo_n == EDIT_UNDOS {
    for k: 1..<EDIT_UNDOS { s[0].ev.undos[k - 1] = s[0].ev.undos[k]; }
    s[0].ev.undo_n -= 1;
  }
  s[0].ev.undos[s[0].ev.undo_n] = s[0].ev.edits;
  s[0].ev.undo_n += 1;
}

// "PLACED A CRATE", "PLACED 4 CRATES"; "REMOVED ..." the same way.
ev_count :: (out: [] u8, verb: string, n: int, one: string, many: string) -> int {
  m := ev_put(out, verb);
  if n == 1 {
    vowel := one.count > 0 && (one[0] == 'A' || one[0] == 'E' || one[0] == 'I' || one[0] == 'O' || one[0] == 'U');
    m += ev_put(out[m..<out.count], ifx vowel then "AN " else "A "); m += ev_put(out[m..<out.count], one); return m;
  }
  m = eg_put_int(out, m, n);
  m += ev_put(out[m..<out.count], " ");
  return m + ev_put(out[m..<out.count], many);
}
ev_lower :: (out: [] u8, n: int) -> int {
  for i: 0..<n { if out[i] >= 'A' && out[i] <= 'Z' { out[i] = out[i] + 32; } }
  return n;
}
// The line (capitals) as the sentence spoken back: "Placed 4 crates."
// The line's " · " is a comma said.
ev_say_line :: (s: [] Everglade) {
  n := 0;
  i := 0;
  line := s[0].ev.line[0..<s[0].ev.line_n];
  while i < line.count {
    if i + 3 < line.count && line[i] == ' ' && line[i + 1] == 0xC2 && line[i + 2] == 0xB7 { s[0].ev.say[n] = ','; n += 1; i += 3; continue; }
    s[0].ev.say[n] = line[i]; n += 1; i += 1;
  }
  if n > 1 { _ := ev_lower(s[0].ev.say[1..<n], n - 1); }
  if n < EDIT_LINE { s[0].ev.say[n] = '.'; n += 1; }
  s[0].ev.say_n = n;
}
// "Removed Old Tam." with the name as it's written.
ev_say_person :: (s: [] Everglade, before: string, i: int, after: string) {
  m := ev_put(s[0].ev.say[..], before);
  m += ev_put(s[0].ev.say[m..<EDIT_LINE], EG_PERSON[i]);
  s[0].ev.say_n = m + ev_put(s[0].ev.say[m..<EDIT_LINE], after);
}

EDIT_CLEAR :: 0.25;   // metres a placed thing stays off you, past your walker's radius

// Places count of item in a row in front of you, clear of you, each where it
// may stand, as one group (a later "remove these" takes the row). A row that
// doesn't fit is shifted further out, and what still doesn't is left out and said.
edit_place :: (s: [] Everglade, item: int, count: int, spoken: bool) { edit_place_as(s, item, count, 1, 0, spoken); }
edit_place_as :: (s: [] Everglade, item: int, count: int, size: f32, tint: int, spoken: bool) {
  if s[0].ev.edits.n >= EG_EDIT_MAX { ev_line(s, "THE CITY HAS AS MANY THINGS AS IT TAKES"); ev_say(s, "There's no room for more things."); return; }
  big := EG_EDIT_SORT[item] == EG_SORT_BUILDING;
  want := count;
  if big {
    want = 1;
    if edit_buildings(s) >= EG_EDIT_BUILDINGS { ev_line(s, "THE CITY HAS AS MANY NEW BUILDINGS AS IT TAKES"); ev_say(s, "There's no room for another building."); return; }
  }
  before := s[0].ev.edits;
  fx := sin(s[0].face); fz := cos(s[0].face);
  rx := fz; rz := -fx;   // across your view
  yaw := ifx big then ed_square(s[0].face + f32(PI)) else s[0].face;
  probe := eg_thing(item, 0, 0, yaw, size);
  box: [EG_BOX] f32;
  eg_edit_box(probe, box[..]);
  across_w := abs((box[2] - box[0]) * rx) + abs((box[3] - box[1]) * rz);   // its width across your view
  deep := abs((box[2] - box[0]) * fx) + abs((box[3] - box[1]) * fz);
  w := across_w + 0.5;
  // the row's near edge clear of you: your radius, a margin, then half the thing's depth
  first := f32(EG_RADIUS) + f32(EDIT_CLEAR) + deep / 2 + 0.5;
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  tries := ifx big then 10 else 4;
  for k: 0..<want {
    if s[0].ev.edits.n >= EG_EDIT_MAX { break; }
    done := false;
    for d: 0..<tries {
      for side: 0..<(ifx big then 3 else 1) {
        if done { break; }
        across := (f32(k) - f32(want - 1) / 2) * w + f32(side % 2 * 2 - 1) * f32((side + 1) / 2) * 3;
        t := eg_thing(item, 0, 0, yaw, size);
        t.group = group; t.tint = tint;
        ahead := first + f32(d) * (ifx big then 1.5f32 else 1.1f32);
        t.x = s[0].feet.x + fx * ahead + rx * across; t.z = s[0].feet.z + fz * ahead + rz * across;
        if edit_try(s, t) { done = true; }
      }
      if done { break; }
    }
    if done { placed += 1; }
  }
  edit_placed(s, before, item, placed, want, "", spoken);
}
// Adds t to the list if it may stand there, clear of you: whether it did.
edit_try :: (s: [] Everglade, t: EgThing) -> bool {
  box: [EG_BOX] f32;
  eg_edit_box(t, box[..]);
  // never on you (a patch of flowers may be round you: you walk through it)
  if t.lift < 0.05 && EG_EDIT_SORT[eg_edit_kind(t.kind)] != EG_SORT_PATCH && box_gap(box[..], 0, s[0].feet.x, s[0].feet.z) < f32(EG_RADIUS) + f32(EDIT_CLEAR) { return false; }
  if s[0].ev.edits.n >= EG_EDIT_MAX { return false; }
  s[0].ev.edits.things[s[0].ev.edits.n] = t; s[0].ev.edits.n += 1;
  if eg_edit_fault(s[0].ev.edits, s[0].ev.edits.n - 1) == EG_FAULT_NONE { return true; }
  s[0].ev.edits.n -= 1;
  return false;
}
edit_buildings :: (s: [] Everglade) -> int {
  n := 0;
  for i: 0..<s[0].ev.edits.n { if EG_EDIT_SORT[eg_edit_kind(s[0].ev.edits.things[i].kind)] == EG_SORT_BUILDING { n += 1; } }
  return n;
}
// After a place: kept (UNDO takes it back), said ("PLACED 6 PUMPKINS ON THE STALL"), published.
edit_placed :: (s: [] Everglade, before: EgEdits, item: int, placed: int, want: int, place_on: string, spoken: bool) {
  if placed == 0 { s[0].ev.edits = before; ev_line(s, "THERE'S NO ROOM THERE"); ev_say(s, "There's no room there."); return; }
  after := s[0].ev.edits;
  s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
  n := ev_count(s[0].ev.line[..], "PLACED ", placed, ev_coloured(s, item, after.things[after.n - 1].tint, false), ev_coloured(s, item, after.things[after.n - 1].tint, true));
  n += ev_put(s[0].ev.line[n..<EDIT_LINE], place_on);
  if placed < want {
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], " · ");
    n = eg_put_int(s[0].ev.line[..], n, want - placed);
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], " DIDN'T FIT");
  }
  s[0].ev.line_n = lo_i(n, EDIT_LINE);
  ev_say_line(s);
  if spoken { edit_changed(s, "Placed by voice"); } else { edit_settle(s); }
}
// An item's label with its colour said ("PURPLE PATCH OF FLOWERS"), in a scratch buffer.
ev_coloured :: (s: [] Everglade, item: int, tint: int, many: bool) -> string {
  label := ifx many then EG_EDIT_LABELS[item] else EG_EDIT_LABEL[item];
  if tint <= 0 || tint >= EG_COLOURS { return label; }
  buf := ifx many then s[0].ev.word2[..] else s[0].ev.word1[..];
  n := ev_put(buf, EG_COLOUR_WORD[tint]);
  n += ev_put(buf[n..<buf.count], " ");
  n += ev_put(buf[n..<buf.count], label);
  return cast(string) buf[0..<n];
}

// "Put six pumpkins on the stall": on the top of the nearest such thing near
// you (a placed one, or one of the market's stalls), in rows across it, each
// made smaller if that's what it takes for them all to fit.
edit_place_onto :: (s: [] Everglade, item: int, count: int, onto: int, size: f32, tint: int) {
  // the nearest top of that kind: x, z, yaw, its top's height, half across and half along it
  best := 1e9f32; tx := 0.0f32; tz := 0.0f32; tyaw := 0.0f32; ttop := 0.0f32; hx := 0.0f32; hz := 0.0f32;
  reach := f32(EG_REMOVE_NEAR * EG_REMOVE_NEAR);
  for i: 0..<s[0].ev.edits.n {
    o := s[0].ev.edits.things[i];
    if eg_edit_kind(o.kind) != onto || o.lift > 0.05 { continue; }
    d := eg_gap2(o.x, o.z, s[0].feet.x, s[0].feet.z);
    if d < best && d < reach {
      wide := ifx onto == 4 then 1.55f32 else 1.0f32;
      best = d; tx = o.x; tz = o.z; tyaw = o.yaw; ttop = ground_at(s, o.x, o.z) + EG_EDIT_TOP[onto] * o.size;
      hx = EG_EDIT_HALF[onto * 3] * o.size * wide * 0.8; hz = EG_EDIT_HALF[onto * 3 + 1] * o.size * wide * 0.7;
    }
  }
  if onto == 4 {   // the market's own stalls (everglade.coax stalls)
    for i: EG_STALL..<EG_WAYSTONE {
      k := i * EG_BOX;
      x := (EG_PROP[k] + EG_PROP[k + 2]) / 2; z := (EG_PROP[k + 1] + EG_PROP[k + 3]) / 2;
      d := eg_gap2(x, z, s[0].feet.x, s[0].feet.z);
      if d < best && d < reach {
        best = d; tx = x; tz = z; tyaw = ifx z > 0 then f32(PI) else 0.0f32; ttop = ground_at(s, x, z) + EG_EDIT_TOP[4];
        hx = EG_EDIT_HALF[12] * 1.55 * 0.8; hz = EG_EDIT_HALF[13] * 1.55 * 0.7;
      }
    }
  }
  if best > 1e8 {
    n := ev_put(s[0].ev.line[..], "NO ");
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], EG_EDIT_LABEL[onto]);
    s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " NEAR YOU TO PUT THEM ON");
    ev_say_line(s);
    return;
  }
  before := s[0].ev.edits;
  // the largest size up to the one said at which count of them fit in rows on the top
  ix := EG_EDIT_HALF[item * 3] * 2; iz := EG_EDIT_HALF[item * 3 + 1] * 2;
  sc := size;
  cols := 1; rows := 1;
  while true {
    cols = hi_i(cast(int) floor(hx * 2 / (ix * sc + 0.04)), 1);
    rows = hi_i(cast(int) floor(hz * 2 / (iz * sc + 0.04)), 1);
    if cols * rows >= count || sc <= 0.35 { break; }
    sc = sc * 0.9;
  }
  if count < cols * rows { if count <= cols { cols = count; rows = 1; } else { rows = (count + cols - 1) / cols; } }
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  for k: 0..<count {
    if k >= cols * rows { break; }
    c := k % cols; r := k / cols;
    u := (f32(c) - f32(cols - 1) / 2) * hx * 2 / f32(cols);
    v := (f32(r) - f32(rows - 1) / 2) * hz * 2 / f32(rows);
    ct := cos(tyaw); st := sin(tyaw);
    t := eg_thing(item, tx + ct * u + st * v, tz - st * u + ct * v, tyaw + f32(k) * 0.7, sc);
    t.group = group; t.tint = tint;
    t.lift = hi(ttop - ground_at(s, t.x, t.z), 0.06);
    if edit_try(s, t) { placed += 1; }
  }
  n := ev_put(s[0].ev.onto_words[..], " ON THE ");
  n += ev_put(s[0].ev.onto_words[n..<s[0].ev.onto_words.count], EG_EDIT_LABEL[onto]);
  edit_placed(s, before, item, placed, count, cast(string) s[0].ev.onto_words[0..<n], true);
}

// "Place 12 benches all around": a ring round you, each facing in, as wide as they need.
edit_ring :: (s: [] Everglade, item: int, count: int, size: f32, tint: int) {
  before := s[0].ev.edits;
  wide := EG_EDIT_HALF[item * 3] * 2 * size * (ifx item == 4 then 1.55f32 else 1.0f32);
  r := hi(f32(EG_RADIUS) + f32(EDIT_CLEAR) + EG_EDIT_HALF[item * 3 + 1] * size + 1.5, f32(count) * (wide + 0.6) / (2 * f32(PI)));
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  for k: 0..<count {
    a := s[0].face + f32(k) * 2 * f32(PI) / f32(count);
    done := false;
    for d: 0..<4 {
      if done { break; }
      rr := r + f32(d) * 1.2;
      t := eg_thing(item, s[0].feet.x + rr * sin(a), s[0].feet.z + rr * cos(a), a + f32(PI), size);
      t.group = group; t.tint = tint;
      done = edit_try(s, t);
    }
    if done { placed += 1; }
  }
  edit_placed(s, before, item, placed, count, " AROUND YOU", true);
}

// "Scatter barrels about" or "fill the yard with crates": spread over the open ground in front.
edit_scatter :: (s: [] Everglade, item: int, count: int, size: f32, tint: int, wide: bool) {
  before := s[0].ev.edits;
  reach := ifx wide then 12.0f32 else 6.0f32;
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  seed := s[0].ev.edits.n * 31 + count;
  for k: 0..<count {
    done := false;
    for d: 0..<10 {
      if done { break; }
      a := s[0].face + (ed_hash(seed + k, d) - 0.5) * 2.2;
      rr := f32(EG_RADIUS) + 1.5 + ed_hash(d, seed + k) * reach;
      t := eg_thing(item, s[0].feet.x + rr * sin(a), s[0].feet.z + rr * cos(a), ed_hash(k, d + 9) * 6.28, size);
      t.group = group; t.tint = tint;
      done = edit_try(s, t);
    }
    if done { placed += 1; }
  }
  edit_placed(s, before, item, placed, count, "", true);
}

// A patch of flowers or crops in front of you; "fill the field" makes it as big as the open ground takes.
edit_patch :: (s: [] Everglade, item: int, count: int, fill: bool, size: f32, tint: int) {
  before := s[0].ev.edits;
  had := s[0].ev.spot_n;
  fx := sin(s[0].face); fz := cos(s[0].face);
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  n := ifx fill then 1 else eg_clamp_n(count, 1, 4);
  for k: 0..<n {
    sc := ifx fill then 4.0f32 else size;
    done := false;
    while !done && sc >= 0.5 {
      r := EG_EDIT_HALF[item * 3] * sc;
      ahead := f32(EG_RADIUS) + r * 0.85 + f32(k) * r * 2.1;
      t := eg_thing(item, s[0].feet.x + fx * ahead, s[0].feet.z + fz * ahead, s[0].face, sc);
      t.group = group; t.tint = tint;
      done = edit_try(s, t);
      sc = sc * 0.75;
    }
    if done { placed += 1; }
  }
  if placed == 0 { s[0].ev.edits = before; ev_line(s, "THERE'S NO ROOM THERE"); ev_say(s, "There's no room there."); return; }
  after := s[0].ev.edits;
  s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
  edit_spots(s);
  // "PLANTED A FIELD OF 512 PURPLE FLOWERS"
  m := ev_put(s[0].ev.line[..], ifx fill then "PLANTED A FIELD OF " else "PLANTED ");
  m = eg_put_int(s[0].ev.line[..], m, s[0].ev.spot_n - had);
  m += ev_put(s[0].ev.line[m..<EDIT_LINE], " ");
  if tint > 0 { m += ev_put(s[0].ev.line[m..<EDIT_LINE], EG_COLOUR_WORD[tint]); m += ev_put(s[0].ev.line[m..<EDIT_LINE], " "); }
  m += ev_put(s[0].ev.line[m..<EDIT_LINE], ifx item == EG_KIND_FLOWERS then "FLOWERS" else "PLANTS IN ROWS");
  s[0].ev.line_n = m;
  ev_say_line(s);
  edit_changed(s, "Planted by voice");
}
// "What can I put down?": everything the catalogue places, written and said.
edit_list :: (s: [] Everglade) {
  n := ev_put(s[0].ev.line[..], "I CAN PLACE ");
  for k: 0..<EG_EDIT_ITEMS {
    if k > 0 { n += ev_put(s[0].ev.line[n..<EDIT_LINE], ifx k == EG_EDIT_ITEMS - 1 then " AND " else ", "); }
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], EG_EDIT_LABELS[k]);
  }
  s[0].ev.line_n = n;
  ev_say_line(s);
}

// Something asked for that isn't in the catalogue or the city: said plainly, nothing else done.
edit_missing :: (s: [] Everglade, name: string, place: bool) {
  n := ev_put(s[0].ev.line[..], ifx place then "I CAN'T MAKE " else "NO PIECE CALLED ");
  if place && name.count > 0 { n += ev_put(s[0].ev.line[n..<EDIT_LINE], ifx name[0] == 'a' || name[0] == 'e' || name[0] == 'i' || name[0] == 'o' || name[0] == 'u' then "AN " else "A "); }
  for i: 0..<name.count {
    c := name[i];
    if c >= 'a' && c <= 'z' { c = c - 32; }
    if n < EDIT_LINE { s[0].ev.line[n] = c; n += 1; }
  }
  if name.count == 0 { n += ev_put(s[0].ev.line[n..<EDIT_LINE], "THAT"); }
  s[0].ev.line_n = n;
  ev_say_line(s);
}

// ---- the city's buildings: an admin may hide one ("delete this temple building") and bring it back

// The plan's building named (EG_BUILDING_NAME, any case; "" any) nearest you, hidden or not as asked, or -1.
edit_building_named :: (s: [] Everglade, name: string, hidden: bool) -> int {
  best := -1; most := 1e9f32;
  for b: 0..<EG_BUILDINGS {
    if eg_hidden(s[0].ev.edits, b) != hidden { continue; }
    if name.count > 0 && name != "nearest" && !ev_same_name(EG_BUILDING_NAME[b], name) { continue; }
    bld := EG_BUILDING;
    gap := box_gap(bld[..], b, s[0].feet.x, s[0].feet.z);
    if gap < most { most = gap; best = b; }
  }
  if name.count == 0 || name == "nearest" { if most > 30 && !hidden { return -1; } }
  return best;
}
// "THE INN" and "inn", "MAGES' TOWER" and "mages' tower": the same name.
ev_same_name :: (upper: string, said: string) -> bool {
  u := upper;
  if u.count > 4 && u[0..<4] == "THE " { u = u[4..<u.count]; }
  if u.count != said.count { return false; }
  for i: 0..<u.count {
    c := said[i];
    if c >= 'a' && c <= 'z' { c = c - 32; }
    if c != u[i] { return false; }
  }
  return true;
}
edit_hide :: (s: [] Everglade, name: string) {
  b := edit_building_named(s, name, false);
  if b < 0 {
    if name.count > 0 && name != "nearest" && edit_building_named(s, name, true) >= 0 {
      n := ev_put(s[0].ev.line[..], "THE "); n += ev_name_building(s, n, name);
      s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " IS ALREADY HIDDEN");
    } else if name.count > 0 && name != "nearest" { edit_missing(s, name, false); return; }
    else { ev_line(s, "NO BUILDING NEAR YOU TO HIDE"); }
    ev_say_line(s);
    return;
  }
  edit_remember(s);
  s[0].ev.edits.hidden = s[0].ev.edits.hidden | (cast(u32) 1 << cast(u32) b);
  n := ev_put(s[0].ev.line[..], "HID ");
  s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], ev_the_building(b));
  ev_say_line(s);
  edit_changed(s, "Hidden by voice");
}
ev_the_building :: (b: int) -> string {
  return EG_BUILDING_THE[b];
}
EG_BUILDING_THE :: [16] string.["THE INN", "THE GENERAL STORE", "THE SMITHY", "THE ALCHEMIST", "THE FIGHTERS' HALL", "THE RANGERS' LODGE",
  "THE MAGES' TOWER", "THE TEMPLE", "THE OBSERVATORY", "THE STABLES", "THE HOUSE", "THE HOUSE", "THE HOUSE", "THE HOUSE", "THE HOUSE", "THE HOUSE"];
ev_name_building :: (s: [] Everglade, n: int, name: string) -> int {
  m := n;
  for i: 0..<name.count { c := name[i]; if c >= 'a' && c <= 'z' { c = c - 32; } if m < EDIT_LINE { s[0].ev.line[m] = c; m += 1; } }
  return m - n;
}
// "Bring back the temple", "bring Marta back": a hidden building or a person taken away.
edit_restore :: (s: [] Everglade, name: string, who: int) {
  if who >= 0 {
    if !eg_gone(s[0].ev.edits, who) {
      n := ev_put(s[0].ev.line[..], ev_name_up(who));
      s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " IS HERE");
      ev_say_line(s);
      return;
    }
    edit_remember(s);
    s[0].ev.edits.gone = s[0].ev.edits.gone ^ (cast(u32) 1 << cast(u32) who);
    n := ev_put(s[0].ev.line[..], "BROUGHT BACK ");
    s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], ev_name_up(who));
    ev_say_person(s, "Brought back ", who, ".");
    edit_changed(s, "Brought back by voice");
    return;
  }
  b := edit_building_named(s, name, true);
  if b < 0 { ev_line(s, "NOTHING HIDDEN TO BRING BACK"); ev_say_line(s); return; }
  edit_remember(s);
  s[0].ev.edits.hidden = s[0].ev.edits.hidden ^ (cast(u32) 1 << cast(u32) b);
  n := ev_put(s[0].ev.line[..], "BROUGHT BACK ");
  s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], ev_the_building(b));
  ev_say_line(s);
  edit_changed(s, "Brought back by voice");
}
// A placed thing of kind near you, taken away (a placed house before the city's): whether there was one.
edit_remove_placed :: (s: [] Everglade, kind: int, all: bool) -> bool {
  take := eg_pick_things(s[0].ev.edits, s[0].feet.x, s[0].feet.z, kind, all);
  if take.n_things == 0 { return false; }
  edit_remember(s);
  edit_take(s, take, true);
  return true;
}

// ---- move, resize, turn: the placed things a sentence names, as a removal picks them

// What a move, resize or turn takes, or nothing (and says why).
edit_targets :: (s: [] Everglade, kind: int, all: bool) -> EgTake {
  take := eg_pick_things(s[0].ev.edits, s[0].feet.x, s[0].feet.z, kind, all);
  if take.n_things == 0 {
    n := ev_put(s[0].ev.line[..], "NO PLACED ");
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], ifx kind >= 0 && kind < EG_EDIT_ITEMS then EG_EDIT_LABEL[kind] else "THING");
    s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " NEAR YOU");
    ev_say_line(s);
  }
  return take;
}
// "MOVED 4 CRATES", "MADE THE BARREL BIGGER": the verb, how many and what.
ev_did :: (s: [] Everglade, verb: string, take: EgTake, after: string) {
  e := s[0].ev.edits;
  kind := -1; mixed := false;
  for i: 0..<e.n {
    if (take.things >> cast(u64) i) & 1 == 0 { continue; }
    k := eg_edit_kind(e.things[i].kind);
    if kind < 0 { kind = k; } else if kind != k { mixed = true; }
  }
  n := ev_put(s[0].ev.line[..], verb);
  if take.n_things == 1 && !mixed { n += ev_put(s[0].ev.line[n..<EDIT_LINE], "THE "); n += ev_put(s[0].ev.line[n..<EDIT_LINE], EG_EDIT_LABEL[kind]); }
  else {
    n = eg_put_int(s[0].ev.line[..], n, take.n_things);
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], " ");
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], ifx mixed then "THINGS" else EG_EDIT_LABELS[kind]);
  }
  s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], after);
  ev_say_line(s);
}
// Whether every thing taken may stand where it now is.
edit_all_stand :: (s: [] Everglade, take: EgTake) -> bool {
  for i: 0..<s[0].ev.edits.n {
    if (take.things >> cast(u64) i) & 1 == 0 { continue; }
    if eg_edit_fault(s[0].ev.edits, i) != EG_FAULT_NONE { return false; }
    box: [EG_BOX] f32;
    eg_edit_box(s[0].ev.edits.things[i], box[..]);
    if s[0].ev.edits.things[i].lift < 0.05 && box_gap(box[..], 0, s[0].feet.x, s[0].feet.z) < f32(EG_RADIUS) { return false; }
  }
  return true;
}
// "Move these crates" (here: to in front of you), "move it two metres left", "away", "closer".
edit_move :: (s: [] Everglade, kind: int, all: bool, direction: string, metres: f32) {
  take := edit_targets(s, kind, all);
  if take.n_things == 0 { return; }
  before := s[0].ev.edits;
  fx := sin(s[0].face); fz := cos(s[0].face);
  cx := 0.0f32; cz := 0.0f32;
  for i: 0..<before.n { if (take.things >> cast(u64) i) & 1 != 0 { cx += before.things[i].x; cz += before.things[i].z; } }
  cx = cx / f32(take.n_things); cz = cz / f32(take.n_things);
  dx := 0.0f32; dz := 0.0f32;
  m := clamp(metres, 0.5, 30);
  if direction == "forward" { dx = fx * m; dz = fz * m; }
  else if direction == "back" { dx = -fx * m; dz = -fz * m; }
  else if direction == "right" { dx = fz * m; dz = -fx * m; }
  else if direction == "left" { dx = -fz * m; dz = fx * m; }
  else if direction == "away" || direction == "closer" {
    ax := cx - s[0].feet.x; az := cz - s[0].feet.z; d := hi(sqrt(ax * ax + az * az), 0.01);
    sg := ifx direction == "away" then 1.0f32 else -1.0f32;
    if direction == "closer" { m = lo(m, hi(d - 2.5, 0)); }
    dx = sg * ax / d * m; dz = sg * az / d * m;
  } else {
    // here: the group's middle to in front of you, past its own reach
    reach := 0.0f32;
    for i: 0..<before.n { if (take.things >> cast(u64) i) & 1 != 0 { reach = hi(reach, sqrt(eg_gap2(before.things[i].x, before.things[i].z, cx, cz)) + EG_EDIT_HALF[eg_edit_kind(before.things[i].kind) * 3]); } }
    ahead := f32(EG_RADIUS) + f32(EDIT_CLEAR) + reach + 0.8;
    dx = s[0].feet.x + fx * ahead - cx; dz = s[0].feet.z + fz * ahead - cz;
  }
  // as far as they go, down to a quarter of the way
  for step: 0..<4 {
    k := 1.0f32 - f32(step) * 0.25;
    s[0].ev.edits = before;
    for i: 0..<before.n {
      if (take.things >> cast(u64) i) & 1 == 0 { continue; }
      s[0].ev.edits.things[i].x += dx * k; s[0].ev.edits.things[i].z += dz * k;
      if s[0].ev.edits.things[i].lift > 0.05 { s[0].ev.edits.things[i].lift = 0; }   // moved off its top
    }
    if edit_all_stand(s, take) {
      after := s[0].ev.edits;
      s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
      ev_did(s, "MOVED ", take, "");
      edit_changed(s, "Moved by voice");
      return;
    }
  }
  s[0].ev.edits = before;
  ev_line(s, "THERE'S NO ROOM THERE"); ev_say(s, "There's no room there.");
}
// "This barrel is bigger", "make it twice as big", "smaller".
edit_resize :: (s: [] Everglade, kind: int, all: bool, factor: f32) {
  take := edit_targets(s, kind, all);
  if take.n_things == 0 { return; }
  f := clamp(factor, 0.25, 4);
  if abs(f - 1) < 0.01 { f = 1.5; }
  before := s[0].ev.edits;
  for step: 0..<6 {
    k := 1 + (f - 1) * (1 - f32(step) / 6);
    s[0].ev.edits = before;
    for i: 0..<before.n {
      if (take.things >> cast(u64) i) & 1 == 0 { continue; }
      s[0].ev.edits.things[i].size = clamp(before.things[i].size * k, f32(EG_EDIT_SIZE_MIN), f32(EG_EDIT_SIZE_MAX));
    }
    if edit_all_stand(s, take) {
      after := s[0].ev.edits;
      s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
      ev_did(s, "MADE ", take, ifx f > 1 then " BIGGER" else " SMALLER");
      edit_changed(s, "Resized by voice");
      return;
    }
  }
  s[0].ev.edits = before;
  ev_line(s, "THERE'S NO ROOM FOR IT BIGGER"); ev_say_line(s);
}
// "Turn the bench around" (180), "turn it left" (-90): degrees to your right.
edit_rotate :: (s: [] Everglade, kind: int, all: bool, degrees: f32) {
  take := edit_targets(s, kind, all);
  if take.n_things == 0 { return; }
  before := s[0].ev.edits;
  for i: 0..<before.n {
    if (take.things >> cast(u64) i) & 1 == 0 { continue; }
    t := before.things[i];
    turned := t.yaw + clamp(degrees, -360, 360) * f32(PI) / 180;
    s[0].ev.edits.things[i].yaw = ifx EG_EDIT_SORT[eg_edit_kind(t.kind)] == EG_SORT_BUILDING then ed_square(turned) else turned;
  }
  if !edit_all_stand(s, take) { s[0].ev.edits = before; ev_line(s, "THERE'S NO ROOM TO TURN IT"); ev_say_line(s); return; }
  after := s[0].ev.edits;
  s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
  ev_did(s, "TURNED ", take, "");
  edit_changed(s, "Turned by voice");
}

// Takes away what a removal names (verse/everglade/edits.coax eg_remove_pick):
// kind EG_PICK_* or -1, who a spot or -1, all for "these", "those", "clear this".
edit_remove :: (s: [] Everglade, kind: int, who: int, all: bool) {
  take := eg_remove_pick(s[0].ev.edits, s[0].feet.x, s[0].feet.z, kind, who, all);
  if take.n_things + take.n_people == 0 {
    if who >= 0 {
      n := ev_put(s[0].ev.line[..], ev_name_up(who));
      s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " IS ALREADY GONE");
      ev_say_person(s, "", who, " is already gone.");
    } else { ev_line(s, "NOTHING NEAR YOU TO REMOVE"); ev_say_line(s); }
    return;
  }
  edit_remember(s);
  edit_take(s, take, true);
}

// Takes t away and says what went: "REMOVED MARTA", "REMOVED 4 CRATES".
edit_take :: (s: [] Everglade, t: EgTake, spoken: bool) {
  e := s[0].ev.edits;
  kind := -1; mixed := false;
  for i: 0..<e.n {
    if (t.things >> cast(u64) i) & 1 == 0 { continue; }
    k := eg_edit_kind(e.things[i].kind);
    if kind < 0 { kind = k; } else if kind != k { mixed = true; }
  }
  one := -1; cats := 0;
  for i: 0..<EG_SPOTS { if (t.people >> cast(u32) i) & 1 != 0 { one = i; if EG_SPOT_CAT[i] { cats += 1; } } }
  s[0].ev.edits = eg_remove(e, t);
  if s[0].ev.picked >= s[0].ev.edits.n { s[0].ev.picked = -1; }
  if s[0].ev.person >= 0 && eg_gone(s[0].ev.edits, s[0].ev.person) { s[0].ev.person = -1; }
  n := 0;
  if t.n_things == 0 && t.n_people == 1 {
    n = ev_put(s[0].ev.line[..], "REMOVED ");
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], ev_name_up(one));
  } else if t.n_things == 0 {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_people, "CAT", ifx cats == t.n_people then "CATS" else "PEOPLE");
  } else if t.n_people == 0 && !mixed {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_things, EG_EDIT_LABEL[kind], EG_EDIT_LABELS[kind]);
  } else {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_things + t.n_people, "THING", "THINGS");
  }
  s[0].ev.line_n = n;
  if !spoken { edit_settle(s); return; }
  ev_say_line(s);
  if t.n_things == 0 && t.n_people == 1 { ev_say_person(s, "Removed ", one, "."); }
  edit_changed(s, "Removed by voice");
}

// A person's name in capitals (EG_PERSON "Old Tam" is "OLD TAM").
ev_name_up :: (i: int) -> string {
  if i < 0 || i >= EG_SPOTS { return ""; }
  return EG_PERSON_UP[i];
}
EG_PERSON_UP :: [22] string.[
  "BRAM", "TILDA", "PIP", "OSWIN", "PEBBLE", "MARTA", "SOOT", "HOLLIS", "FERN", "ADA", "QUILL",
  "GARRICK", "ISOLDE", "ROOK", "SABLE", "ELOWEN", "WISP", "BROTHER ANSELM", "VEGA", "MOSS", "OLD TAM", "CORIN"
];

edit_undo :: (s: [] Everglade, spoken: bool) {
  if s[0].ev.undo_n == 0 { ev_line(s, "NOTHING TO UNDO"); if spoken { ev_say(s, "There's nothing to undo."); } return; }
  if s[0].ev.redo_n == EDIT_UNDOS {
    for k: 1..<EDIT_UNDOS { s[0].ev.redos[k - 1] = s[0].ev.redos[k]; }
    s[0].ev.redo_n -= 1;
  }
  s[0].ev.redos[s[0].ev.redo_n] = s[0].ev.edits; s[0].ev.redo_n += 1;
  s[0].ev.undo_n -= 1;
  s[0].ev.edits = s[0].ev.undos[s[0].ev.undo_n];
  ev_line(s, "UNDONE");
  if spoken { ev_say(s, "Undone."); edit_changed(s, "Undone by voice"); } else { edit_settle(s); }
}

// After an edit: the walls again, the list to publish, and a walk of the city.
edit_changed :: (s: [] Everglade, summary: string) {
  edit_walls(s);
  s[0].ev.post_n = eg_edits_body(s[0].ev.edits, summary, s[0].ev.post[..]);
}

// The player's walls: the plan's (without the buildings an admin hid), then a box for each
// placed thing you can't walk through; and the patches' plants again.
edit_walls :: (s: [] Everglade) {
  edit_relay_town(s);
  edit_spots(s);
  w := s[0].ev.wall_base;
  box: [EG_BOX] f32;
  for i: 0..<s[0].ev.edits.n {
    if w >= WALLS { break; }
    t := s[0].ev.edits.things[i];
    k := eg_edit_kind(t.kind);
    if t.lift > 0.05 || EG_EDIT_SORT[k] == EG_SORT_PATCH || EG_EDIT_HALF[k * 3 + 2] * t.size < 0.3 { continue; }
    eg_edit_box(t, box[..]);
    // from under the ground to its top where it's drawn (edit_draw stands it at the ground under its middle)
    g := ground_at(s, t.x, t.z);
    put6(s[0].walls[..], w, box[0], g - 1, box[1], box[2], g + box[4], box[3]);
    w += 1;
  }
  s[0].wall_n = w;
}

// ---- on the screen: the button, and what was heard and done

ev_text :: (s: [] Everglade) -> string {
  p := cast(string) s[0].ev.phase[0..<s[0].ev.phase_n];
  if s[0].ev.held && (p == "" || p == "off" || p == "connecting") { return "CONNECTING"; }
  if s[0].ev.held && p == "listening" { return "LISTENING"; }
  if p == "hearing" && s[0].ev.caption_n > 0 { return cast(string) s[0].ev.caption[0..<s[0].ev.caption_n]; }
  if p == "notice" && s[0].ev.caption_n > 0 { return cast(string) s[0].ev.caption[0..<s[0].ev.caption_n]; }
  // the last result, then the sentence with the server (or next), as heard, and how many wait after it
  ev_next_ask(s);
  if s[0].ev.asking_n == 0 { return ifx s[0].ev.line_n > 0 then cast(string) s[0].ev.line[0..<s[0].ev.line_n] else ev_hint(); }
  n := ev_put(s[0].ev.shown[..], cast(string) s[0].ev.line[0..<s[0].ev.line_n]);
  if n > 0 { n += ev_put(s[0].ev.shown[n..<EDIT_LINE], " · "); }
  n += ev_put(s[0].ev.shown[n..<EDIT_LINE], "'");
  n += ev_put(s[0].ev.shown[n..<EDIT_LINE], cast(string) s[0].ev.asking[0..<s[0].ev.asking_n]);
  n += ev_put(s[0].ev.shown[n..<EDIT_LINE], "'");
  if s[0].ev.wait_count > 0 {
    n += ev_put(s[0].ev.shown[n..<EDIT_LINE], " · ");
    n = eg_put_int(s[0].ev.shown[..], n, s[0].ev.wait_count);
    n += ev_put(s[0].ev.shown[n..<EDIT_LINE], " MORE WAITING");
  }
  return cast(string) s[0].ev.shown[0..<n];
}
ev_hint :: () -> string {
  return "";   // nothing to say until you talk
}

// TALK, a small button left of EDIT at the top; what was heard and done goes over the hint, only when there is some.
everglade_voice_hud :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, bottom: f32) -> int {
  s[0].ev.button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  n := everglade_edit_hud(s, out, u, at, bottom);
  if !voice_on(s) || s[0].ev.editing || s[0].talk >= 0 || s[0].board || s[0].above { return n; }
  k := hi(s[0].dpr, 0.5); w := s[0].width;
  word := ifx s[0].ev.held then "LISTENING" else ifx phone(s) then "TALK" else "TALK · V";
  mb := s[0].map_button;
  ew := ifx eg_builder(s) then text_width("EDIT", 9 * k) + 40 * k else 0.0f32;   // EDIT's width and its gap (everglade-edit.coax)
  bw := text_width(word, 9 * k) + 32 * k;
  b := Box.{x0 = mb.x0 - ew - 8 * k - bw, y0 = mb.y0, x1 = mb.x0 - ew - 8 * k, y1 = mb.y1};
  s[0].ev.button = b;
  plate(s, u, b, 0.85, ifx s[0].ev.held then 2.0f32 else 1.0f32);
  n = draw_text(out, n, word, b.x0 + 16 * k, b.y1 - 14 * k, 9 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  line := ev_text(s);
  if line.count == 0 { return n; }
  ls := 7.5 * k;
  room := hi(lo(w - 48 * k, 760 * k), 120 * k);
  // a long line ("I CAN PLACE ...") wraps at its words, up to four rows, then gets smaller
  cuts: [5] int; rows := ev_wrap(line, ls, room, cuts[..]);
  while rows > 4 && ls > 4 * k { ls = ls * 0.9; rows = ev_wrap(line, ls, room, cuts[..]); }
  rows = lo_i(rows, 5);
  lw := 0.0f32;
  for r: 0..<rows { lw = hi(lw, text_width(line[cuts[r]..<ev_row_end(line, cuts[..], r, rows)], ls)); }
  lw = lo(lw, room);
  lead := ls + 8 * k;
  y1 := bottom;
  plate(s, u, Box.{x0 = (w - lw) / 2 - 12 * k, y0 = y1 - ls - 20 * k - f32(rows - 1) * lead, x1 = (w + lw) / 2 + 12 * k, y1 = y1}, 0.72, 0);
  for r: 0..<rows {
    part := line[cuts[r]..<ev_row_end(line, cuts[..], r, rows)];
    pw := lo(text_width(part, ls), room);
    n = draw_text(out, n, part, floor((w - pw) / 2), floor(y1 - 10 * k - f32(rows - 1 - r) * lead), ls, GAP, SPACE, ink(k, 0.9, PARCH_R, PARCH_G, PARCH_B), false, false);
  }
  return n;
}
// Where each row of text starts when it wraps at its spaces to room wide (cuts), and how many rows (at most 5).
ev_wrap :: (text: string, size: f32, room: f32, cuts: [] int) -> int {
  rows := 1; cuts[0] = 0;
  start := 0; last := -1;
  i := 0;
  while i <= text.count {
    if i == text.count || text[i] == ' ' {
      if text_width(text[start..<i], size) > room && last > start {
        if rows >= 5 { return 6; }
        cuts[rows] = last + 1; rows += 1; start = last + 1;
      }
      last = i;
    }
    i += 1;
  }
  return rows;
}
ev_row_end :: (text: string, cuts: [] int, r: int, rows: int) -> int {
  if r + 1 < rows { return cuts[r + 1] - 1; }
  return text.count;
}

// ---- checks

#test "voice edits: only an admin on a voice page gets the button; the button holds and lets go" {
  s: [1] Everglade;
  everglade_message(s[..], MSG_FACTS, "now=1\nvoice=haunted-house\nplayer=p-1");
  #assert s[0].ev.voice && !voice_on(s[..]);
  everglade_message(s[..], MSG_VIEWER, "K|npub1x\nH|aa\n");
  #assert !voice_on(s[..]) && !everglade_voice_key(s[..], 'v', true);
  everglade_message(s[..], MSG_VIEWER, "K|npub1x\nH|aa\nA|1\n");
  #assert voice_on(s[..]);
  #assert everglade_key(s[..], 'v', 0) && s[0].ev.held && s[0].ev.want_face && s[0].ev.want_voice == 1;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE_TO && cast(string) s[0].outbox[0..<s[0].out_n] == VOICE_FACING;
  s[0].action = 0;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE && cast(string) s[0].outbox[0..<s[0].out_n] == "on";
  s[0].action = 0;
  #assert everglade_key_up(s[..], 'v', 0) && !s[0].ev.held;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE && cast(string) s[0].outbox[0..<s[0].out_n] == "end";
}

#test "voice edits: sentences said while one is with the server wait their turn, in order, each shown and then its result" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_FACTS, "voice=haunted-house");
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  everglade_message(s[..], MSG_VOICE, "heard|put two barrels here");
  #assert everglade_edit_ask(s[..]) > 0;
  everglade_edit_ask_sent(s[..]);   // the face sent it
  everglade_message(s[..], MSG_VOICE, "heard|what time is it");
  everglade_message(s[..], MSG_VOICE, "heard|put a crate here");
  #assert everglade_edit_ask(s[..]) == 0;   // one with the server at a time
  #assert ev_text(s[..]) == "'put two barrels here' · 2 MORE WAITING";
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 2, \"model\": \"m\"}");
  #assert ev_text(s[..]) == "PLACED 2 BARRELS · 'what time is it' · 1 MORE WAITING";
  #assert everglade_edit_ask(s[..]) > 0 && cast(string) s[0].ev.ask[0..<s[0].ev.ask_n] == "{\"sentence\":\"what time is it\"}";
  everglade_edit_ask_sent(s[..]);
  everglade_edit_answer(s[..], "422\n{\"error\": \"none fit\"}");
  #assert ev_text(s[..]) == "DIDN'T CATCH THAT: 'what time is it' · 'put a crate here'";
  #assert everglade_edit_ask(s[..]) > 0 && cast(string) s[0].ev.ask[0..<s[0].ev.ask_n] == "{\"sentence\":\"put a crate here\"}";
  everglade_edit_ask_sent(s[..]);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"crate\", \"model\": \"m\"}");
  #assert ev_text(s[..]) == "PLACED A CRATE" && everglade_edit_ask(s[..]) == 0 && s[0].ev.edits.n == 3;
}

#test "voice edits: the heard words go to the server as they are; its typed answer places, removes and undoes" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_FACTS, "voice=haunted-house");
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  everglade_message(s[..], MSG_VOICE, "heard|Put two \"barrels\" here");
  #assert everglade_edit_ask(s[..]) > 0 && cast(string) s[0].ev.ask[0..<s[0].ev.ask_n] == "{\"sentence\":\"Put two barrels here\"}";
  // standing on the commons, facing south
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  walls := s[0].wall_n;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 2, \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2 && s[0].ev.edits.things[0].kind == 1 && s[0].ev.edits.things[0].z < -9;
  #assert s[0].wall_n == walls + 2 && s[0].ev.post_n > 0;
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED 2 BARRELS";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 2 barrels.";
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 1 && s[0].wall_n == walls + 1;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"undo\", \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2;
  everglade_message(s[..], MSG_VOICE, "heard|what time is it");
  shown := ev_text(s[..]);   // the heard words while the server answers, after the last result
  #assert shown.count > 17 && shown[shown.count - 17..<shown.count] == "'what time is it'";
  // a question is answered, shown and spoken; nothing is edited
  everglade_edit_answer(s[..], "200\n{\"edit\": \"chat\", \"reply\": \"It is 8:58 PM, Central time.\", \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "It is 8:58 PM, Central time.";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "It is 8:58 PM, Central time." && ev_text(s[..]) == "It is 8:58 PM, Central time.";
  s[0].ev.say_n = 0;
  everglade_message(s[..], MSG_VOICE, "heard|what time is it");
  #assert everglade_edit_ask(s[..]) > 0;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"chat\", \"reply\": \"\"}");
  #assert s[0].ev.edits.n == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "THAT DIDN'T WORK · TRY AGAIN" && s[0].ev.say_n == 0;
  // no edit and no answer: what was heard
  everglade_message(s[..], MSG_VOICE, "heard|what time is it");
  #assert everglade_edit_ask(s[..]) > 0;
  everglade_edit_answer(s[..], "422\n{\"error\": \"none fit\"}");
  #assert s[0].ev.edits.n == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "DIDN'T CATCH THAT: 'what time is it'";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Sorry, I didn't catch that.";
  // what was published is what everyone's page lays over the plan
  t: [1] Everglade;
  everglade_start(t[..]);
  body := cast(string) s[0].ev.post[0..<s[0].ev.post_n];
  #assert body.count > 40;
  everglade_world(t[..], "200\n{\"doc\": {\"edits\": \"eg-edit 1\\nt 1 600 -1200 0 100\\n\", \"everglade\": 1}, \"version\": 4}");
  #assert t[0].ev.edits.n == 1 && t[0].wall_n == walls + 1 && !voice_on(t[..]);
}

#test "voice edits: one of a thing is A THING, more are THINGS" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"bench\", \"count\": 2}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED 2 BENCHES" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 2 benches.";
  s[0].feet = v3(-6, 0, -9);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 1}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED A BARREL" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed a barrel.";
  out: [64] u8;
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 3, EG_EDIT_LABEL[3], EG_EDIT_LABELS[3])] == "PLACED 3 FENCES";
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 4, EG_EDIT_LABEL[4], EG_EDIT_LABELS[4])] == "PLACED 4 STALLS";
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 4, EG_EDIT_LABEL[0], EG_EDIT_LABELS[0])] == "PLACED 4 CRATES";
}

#test "voice edits: a row starts in front of you and never stands on you, whichever way you face" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  for f: 0..<8 {
    s[0].ev.edits.n = 0;
    s[0].feet = v3(4, 0, -12); s[0].face = f32(f) * f32(PI) / 4;
    for item: 0..<EG_EDIT_BUTTONS {
      edit_place(s[..], item, 6, false);
    }
    #assert s[0].ev.edits.n > 0;
    box: [EG_BOX] f32;
    for i: 0..<s[0].ev.edits.n {
      eg_edit_box(s[0].ev.edits.things[i], box[..]);
      #assert box_gap(box[..], 0, 4, -12) >= f32(EG_RADIUS) + f32(EDIT_CLEAR) - 0.001;
      #assert eg_edit_fault(s[0].ev.edits, i) == EG_FAULT_NONE;
      // ahead of you, not behind
      t := s[0].ev.edits.things[i];
      #assert (t.x - 4) * sin(s[0].face) + (t.z + 12) * cos(s[0].face) > 0;
    }
  }
  // a row that doesn't all fit says how many didn't
  s[0].ev.edits.n = 0;
  s[0].feet = v3(0, 0, -52); s[0].face = 0;   // just inside the South Gate, facing in
  edit_place(s[..], 4, 6, false);
  line := cast(string) s[0].ev.line[0..<s[0].ev.line_n];
  #assert s[0].ev.edits.n == 6 || (line.count > 11 && line[line.count - 11..<line.count] == "DIDN'T FIT");
  s[0].ev.line_n = ev_put(s[0].ev.line[..], "PLACED 4 STALLS · 2 DIDN'T FIT");
  ev_say_line(s[..]);
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 4 stalls, 2 didn't fit.";
}

#test "voice edits: placed things are walls from the ground they stand on; a bench you stand on casts your shadow on its top" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  edit_place(s[..], 2, 1, false);
  t := s[0].ev.edits.things[0];
  w := (s[0].wall_n - 1) * 6;
  g := ground_at(s[..], t.x, t.z);
  #assert abs(s[0].walls[w + 4] - (g + EG_EDIT_HALF[2 * 3 + 2])) < 0.001 && s[0].walls[w + 1] < g;
  // standing on the bench's top: the floor under you is its top, not the ground
  top := s[0].walls[w + 4];
  #assert abs(floor_under(s[..], t.x, t.z, top) - top) < 0.001 && abs(floor_under(s[..], t.x, t.z, g) - g) < 0.001;
  u: [UNIFORM_FLOATS] f32;
  s[0].shadow_n = 0;
  shadow(s[..], u[..], t.x, t.z, top, 0.45, 0.6);
  packed := u[U_SHADOW + 3];
  cm := floor(packed / 2);
  #assert abs(packed - cm * 2 - 0.6) < 0.01 && abs(cm / 100 - 100 - top) < 0.006;
}

#test "voice edits: remove these crates takes the row; remove Marta takes her, UNDO and ORIGINAL bring her back" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  // the owner's four crates (published before rows were kept: each on its own) and two benches
  everglade_world(s[..], "200\n{\"doc\": {\"edits\": \"eg-edit 1\\nt 0 400 -1200 0 100\\nt 0 534 -1200 0 100\\nt 0 668 -1200 0 100\\nt 0 802 -1200 0 100\\nt 2 600 -1700 0 100\\nt 2 600 -2000 0 100\\n\", \"everglade\": 1}, \"version\": 7}");
  #assert s[0].ev.edits.n == 6;
  s[0].feet = v3(6, 0, -10); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"crate\", \"all\": true, \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2 && s[0].ev.edits.things[0].kind == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED 4 CRATES";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Removed 4 crates." && s[0].ev.post_n > 0;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"undo\"}");
  #assert s[0].ev.edits.n == 6;
  // a row placed together goes as one, from wherever you stand by it
  s[0].ev.edits.n = 0;
  s[0].feet = v3(6, 0, -9);
  edit_place(s[..], 1, 6, false);
  placed := s[0].ev.edits.n;
  #assert placed > 1;
  s[0].feet = v3(6, 0, -3);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"barrel\", \"all\": true}");
  #assert s[0].ev.edits.n == 0;
  // a person by name, from anywhere: off the city, and back with UNDO and with ORIGINAL
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Marta\"}");
  #assert eg_gone(s[0].ev.edits, 5) && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MARTA" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Removed Marta.";
  #assert nearest(s[..], v3(-3.4, 0, -36)) != 5;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Marta\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "MARTA IS ALREADY GONE";
  edit_undo(s[..], false);
  #assert !eg_gone(s[0].ev.edits, 5) && nearest(s[..], v3(-3.4, 0, -36)) == 5;
  // "remove these cats" by the inn takes its cat, not Marta
  s[0].feet = v3(-3, 0, -34);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"cat\", \"all\": true}");
  #assert eg_gone(s[0].ev.edits, 6) && !eg_gone(s[0].ev.edits, 5) && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED SOOT";
  edit_toggle(s[..]);
  edit_press(s[..], EB_ORIGINAL); edit_press(s[..], EB_ORIGINAL);
  #assert s[0].ev.edits.gone == 0 && s[0].ev.reset;
}

#test "voice edits: with Moss taken away his quest is off the board, and one under way can't be handed in till he's back" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  #assert board_count(s[..]) == 3;
  s[0].stages[0] = 3;   // the waystone's quest, ready to hand in
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Moss\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MOSS";
  #assert board_count(s[..]) == 2 && board_nth(s[..], 0) == 1 && !on_board(s[..], 0);
  open_board(s[..]);
  #assert s[0].pick == 1;
  s[0].pick = 0; board_act(s[..]);
  #assert s[0].stages[0] == 3;
  close_board(s[..]);
  talk_to(s[..], EG_CRIER);
  #assert s[0].stages[0] == 3;
  end_talk(s[..]);
  edit_undo(s[..], true);
  #assert board_count(s[..]) == 3;
  open_board(s[..]);
  #assert s[0].pick == 0;
  board_act(s[..]);
  #assert s[0].stages[0] == EG_QUEST_DONE;
}

#test "edit mode: a click on one of the city's people picks them, and DELETE takes them away" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  edit_toggle(s[..]);
  s[0].ev.pseen[5] = true; s[0].ev.px[5] = 400; s[0].ev.py[5] = 300;
  s[0].dpr = 1;
  #assert everglade_edit_pointer(s[..], 404, 302, 0, 3) && s[0].ev.person == 5 && s[0].ev.picked == -1;
  _ := everglade_key(s[..], 'r', 0);
  #assert !eg_gone(s[0].ev.edits, 5) && s[0].ev.person == 5;   // R turns things, not people
  #assert everglade_key(s[..], EV_KEY_DELETE, 0) && eg_gone(s[0].ev.edits, 5) && s[0].ev.person == -1;
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MARTA" && s[0].ev.due > 0;
  #assert everglade_key(s[..], 'z', 0) && !eg_gone(s[0].ev.edits, 5);
}

#test "voice verbs: pumpkins on the stall's top, a house, a ring of benches, a field of purple flowers" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  // by the market's south stalls, facing them
  s[0].feet = v3(26, 0, -2.5); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"pumpkin\", \"count\": 6, \"onto\": \"stall\", \"model\": \"m\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED 6 PUMPKINS ON THE STALL";
  #assert s[0].ev.edits.n == 6 && s[0].ev.edits.things[0].kind == 5 && s[0].ev.edits.things[0].lift > 0.8;
  for i: 0..<6 { t := s[0].ev.edits.things[i]; #assert abs(t.x - 26) < 1.5 && abs(t.z + 6) < 0.8; }
  // what can I put down
  everglade_edit_answer(s[..], "200\n{\"edit\": \"list\"}");
  line := cast(string) s[0].ev.line[0..<s[0].ev.line_n];
  #assert line.count > 200 && line[0..<20] == "I CAN PLACE CRATES, " && line[line.count - 10..<line.count] == "AND TOWERS";
  // a building in front: a house, never a stall
  s[0].ev.edits.n = 0;
  s[0].feet = v3(6, 0, -14); s[0].face = f32(PI) / 2;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"house\", \"count\": 1}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED A HOUSE" && s[0].ev.edits.n == 1 && s[0].ev.edits.things[0].kind == EG_KIND_HOUSE;
  // twelve benches all around
  s[0].ev.edits.n = 0;
  s[0].feet = v3(-20, 0, 12); s[0].face = 0;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"bench\", \"count\": 12, \"arrange\": \"ring\"}");
  line = cast(string) s[0].ev.line[0..<s[0].ev.line_n];
  #assert s[0].ev.edits.n >= 8 && line[0..<7] == "PLACED " && contains(line, "BENCHES AROUND YOU");
  // fill the field with purple flowers
  s[0].ev.edits.n = 0; edit_walls(s[..]);
  s[0].feet = v3(6, 0, -14); s[0].face = f32(PI) / 2;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"flowers\", \"colour\": \"purple\", \"arrange\": \"fill\"}");
  line = cast(string) s[0].ev.line[0..<s[0].ev.line_n];
  #assert s[0].ev.spot_n > 150 && line[0..<19] == "PLANTED A FIELD OF " && contains(line, "PURPLE FLOWERS");
}

#test "voice verbs: the barrel bigger, the crates moved, the temple hidden and back, and a name that isn't here" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 1}");
  everglade_edit_answer(s[..], "200\n{\"edit\": \"resize\", \"item\": \"barrel\", \"size\": 1.5}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "MADE THE BARREL BIGGER" && abs(s[0].ev.edits.things[0].size - 1.5) < 0.01;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"undo\"}");
  #assert abs(s[0].ev.edits.things[0].size - 1) < 0.01;
  s[0].ev.edits.n = 0;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"crate\", \"count\": 4}");
  x0 := s[0].ev.edits.things[0].x; z0 := s[0].ev.edits.things[0].z;
  s[0].face = 0;   // turned round: "move these crates" brings them in front
  everglade_edit_answer(s[..], "200\n{\"edit\": \"move\", \"item\": \"crate\", \"all\": true, \"direction\": \"here\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "MOVED 4 CRATES" && s[0].ev.edits.things[0].z > -9 && abs(s[0].ev.edits.things[0].z - z0) > 1;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"rotate\", \"item\": \"crate\", \"turn\": 90}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "TURNED THE CRATE";
  // the temple: hidden, its walls and roof gone, and back
  s[0].feet = v3(0, 0, 30); s[0].face = 0;
  walls := s[0].wall_n;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"building\", \"building\": \"temple\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "HID THE TEMPLE" && eg_hidden(s[0].ev.edits, EG_TEMPLE) && s[0].wall_n < walls;
  #assert s[0].ev.post_n > 0 && contains(cast(string) s[0].ev.post[0..<s[0].ev.post_n], "b 7");
  everglade_edit_answer(s[..], "200\n{\"edit\": \"restore\", \"building\": \"temple\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "BROUGHT BACK THE TEMPLE" && !eg_hidden(s[0].ev.edits, EG_TEMPLE) && s[0].wall_n == walls;
  // what isn't in the catalogue or the city is said, and nothing else is done
  n := s[0].ev.edits.n;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"missing\", \"name\": \"Marta\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "NO PIECE CALLED MARTA" && s[0].ev.edits.n == n;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"dragon\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "I CAN'T MAKE A DRAGON" && s[0].ev.edits.n == n;
}
