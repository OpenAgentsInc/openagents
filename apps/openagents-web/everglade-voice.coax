// Everglade's voice edits (eg-voice-edit), loaded by everglade.coax: an
// admin holds TALK TO EDIT at the bottom middle (or V on a keyboard) and
// says what to change. Holding opens the microphone through the page's voice
// (coax/web/voice.js, action 7 "on"); letting go closes it at once and ends
// the turn ("end"). The voice host sends the final words back unanswered
// (we face the realm's builder, action 8) as message 50 "heard|WORDS"; the
// face sends them to the server's typed selector (POST
// /api/playtest/realm/everglade/edit, an admin only), which answers one edit
// of the realm's catalogue: place an item (with a count), remove the
// nearest placed thing, or undo. Nothing here reads the words: only that
// typed answer, held again to verse/everglade/edits.coax. The edit is done in
// front of you (or takes away the things or people it names: a whole row
// for "these crates"), the list published as Everglade's world (an admin's
// write, checked on the server), and what was done is shown and spoken back
// (action 9). What was heard shows while the server answers.
//
// Everyone's page lays the published list over the plan (everglade_world):
// a non-admin sees the things and has no button. The switch is the page's:
// realms.json "voice" (data-voice) names the voice route, and the page facts'
// voice= line says so; the server's /api/auth/me says A|1 for an admin.

#load "../../verse/everglade/edits.coax";
#load "everglade-edit.coax";

MSG_VOICE :: 50;          // voice.js: "phase|caption"
MSG_VIEWER :: 606;        // host.js: /api/auth/me's lines
ACT_VOICE :: 7; ACT_VOICE_TO :: 8; ACT_VOICE_SAY :: 9;
VOICE_FACING :: "Everglade builder";   // whom the voice host leaves our turns to: the page answers
EDIT_UNDOS :: 16;
EDIT_POST :: 6144;
EDIT_ASK :: 512;
EDIT_LINE :: 160;
EDIT_MESH :: [5] int.[M_CRATE, M_BARREL, M_BENCH, M_FENCE, M_STALL];
EDIT_NAMES :: [5] string.["crate", "barrel", "bench", "fence", "stall"];

EditVoice :: struct {
  admin: bool;              // /api/auth/me said A|1 (checked again by every write on the server)
  voice: bool;              // this page has voice edits on (realms.json)
  edits: EgEdits;           // what's published over the plan
  undos: [EDIT_UNDOS] EgEdits; undo_n: int;
  redos: [EDIT_UNDOS] EgEdits; redo_n: int;   // what UNDO took back, for REDO (everglade-edit.coax)
  editing: bool;                      // edit mode (everglade-edit.coax), an admin's only
  picked: int;                        // the placed thing picked in it, -1 none
  sure: f64;                          // ORIGINAL pressed once: until this time a second press puts the plan back
  due: f64;                           // a change by hand is published at this time (0 none)
  reset: bool;                        // the face should ask the server for the designed city
  boxes: [EB_N] Box; lit: int; finger2: int;   // edit mode's buttons, the one held, and its finger
  eye_x: f32; eye_z: f32;             // the camera, for which way AWAY is
  sx: [EG_EDIT_MAX] f32; sy: [EG_EDIT_MAX] f32; seen: [EG_EDIT_MAX] bool;   // the things on the screen, for a pick
  button: Box; finger: int; held: bool; key: bool;
  want_face: bool; want_voice: int;   // 1 on, 2 end
  phase: [16] u8; phase_n: int;
  caption: [EDIT_LINE] u8; caption_n: int;
  line: [EDIT_LINE] u8; line_n: int;  // what was done, or why not
  ask: [EDIT_ASK] u8; ask_n: int;     // the heard words for the face to send
  post: [EDIT_POST] u8; post_n: int;  // the list to publish, for the face
  say: [EDIT_LINE] u8; say_n: int;    // what to speak back
  person: int;                        // the city's person picked in edit mode, -1 none
  px: [EG_SPOTS] f32; py: [EG_SPOTS] f32; pseen: [EG_SPOTS] bool;   // the people on the screen, for a pick
  wall_base: int;
  town_used: [5] int;
}

voice_on :: (s: [] Everglade) -> bool { return s[0].ev.admin && s[0].ev.voice; }

ev_put :: (out: [] u8, text: string) -> int {
  n := 0;
  for i: 0..<text.count { if n < out.count { out[n] = text[i]; n += 1; } }
  return n;
}
ev_line :: (s: [] Everglade, text: string) { s[0].ev.line_n = ev_put(s[0].ev.line[..], text); }
ev_say :: (s: [] Everglade, text: string) { s[0].ev.say_n = ev_put(s[0].ev.say[..], text); }

// ---- messages

// The viewer's lines (A|1 an admin), the page facts' voice= line, and the voice's phase.
everglade_voice_message :: (s: [] Everglade, kind: int, text: string) -> bool {
  if kind == MSG_VIEWER {
    s[0].ev.admin = false;
    i := 0;
    while i < text.count {
      e := i; while e < text.count && text[e] != '\n' { e += 1; }
      if text[i..<e] == "A|1" { s[0].ev.admin = true; }
      i = e + 1;
    }
    return true;
  }
  if kind == MSG_FACTS {
    i := 0;
    while i < text.count {
      e := i; while e < text.count && text[e] != '\n' { e += 1; }
      line := text[i..<e];
      if line.count > 6 && line[0..<6] == "voice=" { s[0].ev.voice = true; }
      i = e + 1;
    }
    return false;   // the page reads the facts too
  }
  if kind != MSG_VOICE { return false; }
  bar := 0; while bar < text.count && text[bar] != '|' { bar += 1; }
  phase := text[0..<bar];
  caption := ifx bar < text.count then text[bar + 1..<text.count] else "";
  s[0].ev.phase_n = ev_put(s[0].ev.phase[..], phase);
  s[0].ev.caption_n = ev_put(s[0].ev.caption[..], caption);
  // The turn's final words: an edit to ask for (the server picks it; nothing here reads them).
  if phase == "heard" && caption.count > 0 && voice_on(s) {
    n := ev_put(s[0].ev.ask[..], "{\"sentence\":\"");
    for c: 0..<caption.count {
      ch := caption[c];
      if ch == '"' || ch == '\\' || ch < 32 { continue; }
      if n < EDIT_ASK - 4 { s[0].ev.ask[n] = ch; n += 1; }
    }
    n += ev_put(s[0].ev.ask[n..<EDIT_ASK], "\"}");
    s[0].ev.ask_n = n;
    s[0].ev.line_n = 0;   // the heard words show until the edit is done
  }
  return true;
}

// ---- the button: hold to talk

ev_press :: (s: [] Everglade) {
  if s[0].ev.held { return; }
  s[0].ev.held = true; s[0].ev.want_face = true; s[0].ev.want_voice = 1;
  s[0].ev.line_n = 0;
}
ev_release :: (s: [] Everglade) {
  if !s[0].ev.held { return; }
  s[0].ev.held = false; s[0].ev.want_voice = 2;
}

everglade_voice_key :: (s: [] Everglade, key: int, down: bool) -> bool {
  if everglade_edit_key(s, key, down) { return true; }
  if !voice_on(s) || s[0].ev.editing || (key != 'v' && key != 'V') || s[0].talk >= 0 || s[0].board { return false; }
  if down && !s[0].ev.key { s[0].ev.key = true; ev_press(s); }
  if !down && s[0].ev.key { s[0].ev.key = false; ev_release(s); }
  return true;
}

everglade_voice_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, id: int) -> bool {
  if everglade_edit_pointer(s, x, y, phase, id) { return true; }
  if !voice_on(s) { return false; }
  if phase == 0 && in_box(s[0].ev.button, x, y) { s[0].ev.finger = id; ev_press(s); return true; }
  if s[0].ev.finger != id || !s[0].ev.held { return false; }
  if phase >= 2 { s[0].ev.finger = -1; ev_release(s); }
  return true;
}

// The voice's actions, one a frame, when the outbox is free.
everglade_voice_actions :: (s: [] Everglade) {
  edit_tick(s);
  if s[0].action != 0 { return; }
  if s[0].ev.want_face {
    s[0].ev.want_face = false;
    s[0].out_n = ev_put(s[0].outbox[..], VOICE_FACING); s[0].action = ACT_VOICE_TO;
    return;
  }
  if s[0].ev.want_voice != 0 {
    s[0].out_n = ev_put(s[0].outbox[..], ifx s[0].ev.want_voice == 1 then "on" else "end"); s[0].action = ACT_VOICE;
    s[0].ev.want_voice = 0;
    return;
  }
  if s[0].ev.say_n > 0 {
    for i: 0..<s[0].ev.say_n { s[0].outbox[i] = s[0].ev.say[i]; }
    s[0].out_n = s[0].ev.say_n; s[0].action = ACT_VOICE_SAY; s[0].ev.say_n = 0;
  }
}

// ---- the face's calls

everglade_edit_ask :: (s: [] Everglade) -> int #export_c { return s[0].ev.ask_n; }
everglade_edit_ask_sent :: (s: [] Everglade) #export_c { s[0].ev.ask_n = 0; }
everglade_edit_post :: (s: [] Everglade) -> int #export_c { return s[0].ev.post_n; }
everglade_edit_post_sent :: (s: [] Everglade) #export_c { s[0].ev.post_n = 0; }
// ORIGINAL: the face asks the server for the designed city (POST .../reset) once.
everglade_edit_reset :: (s: [] Everglade) -> bool #export_c { r := s[0].ev.reset; s[0].ev.reset = false; return r; }

// The published list (GET /api/playtest/world/everglade's answer), laid over the plan for everyone.
everglade_world :: (s: [] Everglade, answer: string) #export_c {
  got: [1] EgEdits;
  if eg_edits_answer(answer, got[..]) < 0 { return; }
  s[0].ev.edits = got[0];
  edit_walls(s);
}

// The publish's answer: saved for everyone, or not.
everglade_edit_saved :: (s: [] Everglade, status: int) #export_c {
  if status == 200 { return; }
  ev_line(s, ifx status == 403 || status == 401 then "NOT SAVED · LOG IN AS AN ADMIN" else "NOT SAVED · TRY AGAIN");
}

// The selector's answer ("STATUS\n" and its JSON): the edit, done in front of you.
everglade_edit_answer :: (s: [] Everglade, answer: string) #export_c {
  if answer.count < 4 || answer[0..<4] != "200\n" {
    if answer.count >= 4 && answer[0..<4] == "422\n" {
      // nothing in the catalogue fits: what was heard, and nothing more
      n := ev_put(s[0].ev.line[..], "DIDN'T CATCH AN EDIT IN: '");
      for c: 0..<s[0].ev.caption_n { if n < EDIT_LINE - 1 { s[0].ev.line[n] = s[0].ev.caption[c]; n += 1; } }
      n += ev_put(s[0].ev.line[n..<EDIT_LINE], "'");
      s[0].ev.line_n = n;
      ev_say(s, "I didn't catch an edit.");
      return;
    }
    ev_line(s, "THAT DIDN'T WORK · TRY AGAIN");
    ev_say(s, "That didn't work. Try again.");
    return;
  }
  body := answer[4..<answer.count];
  e := eg_json_at(body, "edit");
  if e < 0 || body[e] != '"' { ev_line(s, "THAT DIDN'T WORK · TRY AGAIN"); return; }
  word := ev_word(body, e);
  if word == "undo" { edit_undo(s, true); return; }
  i := eg_json_at(body, "item");
  item := -1;
  if i >= 0 && body[i] == '"' {
    w := ev_word(body, i);
    for k: 0..<EG_EDIT_ITEMS { if w == EDIT_NAMES[k] { item = k; } }
    if w == "person" { item = EG_PICK_PERSON; }
    if w == "cat" { item = EG_PICK_CAT; }
  }
  if word == "remove" {
    h := eg_json_at(body, "who");
    who := -1;
    if h >= 0 && body[h] == '"' { w := ev_word(body, h); for k: 0..<EG_SPOTS { if w == EG_PERSON[k] { who = k; } } }
    a := eg_json_at(body, "all");
    all := a >= 0 && a + 4 <= body.count && body[a..<a + 4] == "true";
    edit_remove(s, item, who, all);
    return;
  }
  if word != "place" || item < 0 || item >= EG_EDIT_ITEMS { ev_line(s, "THAT DIDN'T WORK · TRY AGAIN"); return; }
  c := eg_json_at(body, "count");
  count := 1;
  if c >= 0 { got := eg_number(body[c..<body.count], 0); if got.v > 0 { count = eg_clamp_n(got.v, 1, 6); } }
  edit_place(s, item, count, true);
}
eg_clamp_n :: (v: int, a: int, b: int) -> int { if v < a { return a; } if v > b { return b; } return v; }
// A JSON string value's words at text[at] (its opening quote).
ev_word :: (text: string, at: int) -> string {
  e := at + 1; while e < text.count && text[e] != '"' { e += 1; }
  return text[at + 1..<e];
}

// ---- the edits

edit_remember :: (s: [] Everglade) {
  s[0].ev.redo_n = 0;   // a new change: what was undone can't come back
  if s[0].ev.undo_n == EDIT_UNDOS {
    for k: 1..<EDIT_UNDOS { s[0].ev.undos[k - 1] = s[0].ev.undos[k]; }
    s[0].ev.undo_n -= 1;
  }
  s[0].ev.undos[s[0].ev.undo_n] = s[0].ev.edits;
  s[0].ev.undo_n += 1;
}

// "PLACED A CRATE", "PLACED 4 CRATES"; "REMOVED ..." the same way.
ev_count :: (out: [] u8, verb: string, n: int, one: string, many: string) -> int {
  m := ev_put(out, verb);
  if n == 1 { m += ev_put(out[m..<out.count], "A "); m += ev_put(out[m..<out.count], one); return m; }
  m = eg_put_int(out, m, n);
  m += ev_put(out[m..<out.count], " ");
  return m + ev_put(out[m..<out.count], many);
}
ev_lower :: (out: [] u8, n: int) -> int {
  for i: 0..<n { if out[i] >= 'A' && out[i] <= 'Z' { out[i] = out[i] + 32; } }
  return n;
}
// The line (capitals) as the sentence spoken back: "Placed 4 crates."
// The line's " · " is a comma said.
ev_say_line :: (s: [] Everglade) {
  n := 0;
  i := 0;
  line := s[0].ev.line[0..<s[0].ev.line_n];
  while i < line.count {
    if i + 3 < line.count && line[i] == ' ' && line[i + 1] == 0xC2 && line[i + 2] == 0xB7 { s[0].ev.say[n] = ','; n += 1; i += 3; continue; }
    s[0].ev.say[n] = line[i]; n += 1; i += 1;
  }
  if n > 1 { _ := ev_lower(s[0].ev.say[1..<n], n - 1); }
  if n < EDIT_LINE { s[0].ev.say[n] = '.'; n += 1; }
  s[0].ev.say_n = n;
}
// "Removed Old Tam." with the name as it's written.
ev_say_person :: (s: [] Everglade, before: string, i: int, after: string) {
  m := ev_put(s[0].ev.say[..], before);
  m += ev_put(s[0].ev.say[m..<EDIT_LINE], EG_PERSON[i]);
  s[0].ev.say_n = m + ev_put(s[0].ev.say[m..<EDIT_LINE], after);
}

EDIT_CLEAR :: 0.25;   // metres a placed thing stays off you, past your walker's radius

// Places count of item in a row in front of you, clear of you, each where it
// may stand, as one group (a later "remove these" takes the row). A row that
// doesn't fit is shifted further out, and what still doesn't is left out and said.
edit_place :: (s: [] Everglade, item: int, count: int, spoken: bool) {
  if s[0].ev.edits.n >= EG_EDIT_MAX { ev_line(s, "THE CITY HAS AS MANY THINGS AS IT TAKES"); ev_say(s, "There's no room for more things."); return; }
  before := s[0].ev.edits;
  fx := sin(s[0].face); fz := cos(s[0].face);
  rx := fz; rz := -fx;   // across your view
  w := EG_EDIT_HALF[item * 3] * 2 + 0.5;
  // the row's near edge clear of you: your radius, a margin, then half the thing's depth
  first := f32(EG_RADIUS) + f32(EDIT_CLEAR) + EG_EDIT_HALF[item * 3 + 1] + 0.5;
  group := eg_new_group(s[0].ev.edits);
  placed := 0;
  for k: 0..<count {
    if s[0].ev.edits.n >= EG_EDIT_MAX { break; }
    across := (f32(k) - f32(count - 1) / 2) * w;
    done := false;
    for d: 0..<4 {
      t: EgThing;
      t.kind = item; t.size = 1; t.yaw = s[0].face; t.group = group;
      ahead := first + f32(d) * 1.1;
      t.x = s[0].feet.x + fx * ahead + rx * across; t.z = s[0].feet.z + fz * ahead + rz * across;
      box: [EG_BOX] f32;
      eg_edit_box(t, box[..]);
      if box_gap(box[..], 0, s[0].feet.x, s[0].feet.z) < f32(EG_RADIUS) + f32(EDIT_CLEAR) { continue; }   // never on you
      s[0].ev.edits.things[s[0].ev.edits.n] = t; s[0].ev.edits.n += 1;
      if eg_edit_fault(s[0].ev.edits, s[0].ev.edits.n - 1) == EG_FAULT_NONE { done = true; break; }
      s[0].ev.edits.n -= 1;
    }
    if done { placed += 1; }
  }
  if placed == 0 { s[0].ev.edits = before; ev_line(s, "THERE'S NO ROOM THERE"); ev_say(s, "There's no room there."); return; }
  after := s[0].ev.edits;
  s[0].ev.edits = before; edit_remember(s); s[0].ev.edits = after;
  n := ev_count(s[0].ev.line[..], "PLACED ", placed, EG_EDIT_LABEL[item], EG_EDIT_LABELS[item]);
  if placed < count {
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], " · ");
    n = eg_put_int(s[0].ev.line[..], n, count - placed);
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], " DIDN'T FIT");
  }
  s[0].ev.line_n = lo_i(n, EDIT_LINE);
  ev_say_line(s);
  if spoken { edit_changed(s, "Placed by voice"); } else { edit_settle(s); }
}

// Takes away what a removal names (verse/everglade/edits.coax eg_remove_pick):
// kind EG_PICK_* or -1, who a spot or -1, all for "these", "those", "clear this".
edit_remove :: (s: [] Everglade, kind: int, who: int, all: bool) {
  take := eg_remove_pick(s[0].ev.edits, s[0].feet.x, s[0].feet.z, kind, who, all);
  if take.n_things + take.n_people == 0 {
    if who >= 0 {
      n := ev_put(s[0].ev.line[..], ev_name_up(who));
      s[0].ev.line_n = n + ev_put(s[0].ev.line[n..<EDIT_LINE], " IS ALREADY GONE");
      ev_say_person(s, "", who, " is already gone.");
    } else { ev_line(s, "NOTHING NEAR YOU TO REMOVE"); ev_say_line(s); }
    return;
  }
  edit_remember(s);
  edit_take(s, take, true);
}

// Takes t away and says what went: "REMOVED MARTA", "REMOVED 4 CRATES".
edit_take :: (s: [] Everglade, t: EgTake, spoken: bool) {
  e := s[0].ev.edits;
  kind := -1; mixed := false;
  for i: 0..<e.n {
    if (t.things >> cast(u64) i) & 1 == 0 { continue; }
    k := eg_edit_kind(e.things[i].kind);
    if kind < 0 { kind = k; } else if kind != k { mixed = true; }
  }
  one := -1; cats := 0;
  for i: 0..<EG_SPOTS { if (t.people >> cast(u32) i) & 1 != 0 { one = i; if EG_SPOT_CAT[i] { cats += 1; } } }
  s[0].ev.edits = eg_remove(e, t);
  if s[0].ev.picked >= s[0].ev.edits.n { s[0].ev.picked = -1; }
  if s[0].ev.person >= 0 && eg_gone(s[0].ev.edits, s[0].ev.person) { s[0].ev.person = -1; }
  n := 0;
  if t.n_things == 0 && t.n_people == 1 {
    n = ev_put(s[0].ev.line[..], "REMOVED ");
    n += ev_put(s[0].ev.line[n..<EDIT_LINE], ev_name_up(one));
  } else if t.n_things == 0 {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_people, "CAT", ifx cats == t.n_people then "CATS" else "PEOPLE");
  } else if t.n_people == 0 && !mixed {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_things, EG_EDIT_LABEL[kind], EG_EDIT_LABELS[kind]);
  } else {
    n = ev_count(s[0].ev.line[..], "REMOVED ", t.n_things + t.n_people, "THING", "THINGS");
  }
  s[0].ev.line_n = n;
  if !spoken { edit_settle(s); return; }
  ev_say_line(s);
  if t.n_things == 0 && t.n_people == 1 { ev_say_person(s, "Removed ", one, "."); }
  edit_changed(s, "Removed by voice");
}

// A person's name in capitals (EG_PERSON "Old Tam" is "OLD TAM").
ev_name_up :: (i: int) -> string {
  if i < 0 || i >= EG_SPOTS { return ""; }
  return EG_PERSON_UP[i];
}
EG_PERSON_UP :: [22] string.[
  "BRAM", "TILDA", "PIP", "OSWIN", "PEBBLE", "MARTA", "SOOT", "HOLLIS", "FERN", "ADA", "QUILL",
  "GARRICK", "ISOLDE", "ROOK", "SABLE", "ELOWEN", "WISP", "BROTHER ANSELM", "VEGA", "MOSS", "OLD TAM", "CORIN"
];

edit_undo :: (s: [] Everglade, spoken: bool) {
  if s[0].ev.undo_n == 0 { ev_line(s, "NOTHING TO UNDO"); if spoken { ev_say(s, "There's nothing to undo."); } return; }
  if s[0].ev.redo_n == EDIT_UNDOS {
    for k: 1..<EDIT_UNDOS { s[0].ev.redos[k - 1] = s[0].ev.redos[k]; }
    s[0].ev.redo_n -= 1;
  }
  s[0].ev.redos[s[0].ev.redo_n] = s[0].ev.edits; s[0].ev.redo_n += 1;
  s[0].ev.undo_n -= 1;
  s[0].ev.edits = s[0].ev.undos[s[0].ev.undo_n];
  ev_line(s, "UNDONE");
  if spoken { ev_say(s, "Undone."); edit_changed(s, "Undone by voice"); } else { edit_settle(s); }
}

// After an edit: the walls again, the list to publish, and a walk of the city.
edit_changed :: (s: [] Everglade, summary: string) {
  edit_walls(s);
  s[0].ev.post_n = eg_edits_body(s[0].ev.edits, summary, s[0].ev.post[..]);
}

// The player's walls: the plan's, then a box for each placed thing.
edit_walls :: (s: [] Everglade) {
  w := s[0].ev.wall_base;
  box: [EG_BOX] f32;
  for i: 0..<s[0].ev.edits.n {
    if w >= WALLS { break; }
    t := s[0].ev.edits.things[i];
    eg_edit_box(t, box[..]);
    // from under the ground to its top where it's drawn (edit_draw stands it at the ground under its middle)
    g := ground_at(s, t.x, t.z);
    put6(s[0].walls[..], w, box[0], g - 1, box[1], box[2], g + box[4], box[3]);
    w += 1;
  }
  s[0].wall_n = w;
}

// Each frame: the placed things as the kit's pieces, after the town's own.
edit_draw :: (s: [] Everglade) {
  for k: 0..<EG_EDIT_ITEMS { s[0].kit_used[group_of(EDIT_MESH[k])] = s[0].ev.town_used[k]; }
  for i: 0..<s[0].ev.edits.n {
    t := s[0].ev.edits.things[i];
    g := ground_at(s, t.x, t.z);
    m := EDIT_MESH[eg_edit_kind(t.kind)];
    sc := ifx t.kind == 4 then 1.55f32 * t.size else t.size;
    piece(s, m, t.x, g, t.z, t.yaw, sc, t.size, sc);
  }
}
// At the start, once the town is laid: what the town uses of each item's group.
edit_start :: (s: [] Everglade) {
  for k: 0..<EG_EDIT_ITEMS { s[0].ev.town_used[k] = s[0].kit_used[group_of(EDIT_MESH[k])]; }
  s[0].ev.wall_base = s[0].wall_n;
  s[0].ev.finger = -1; s[0].ev.finger2 = -1; s[0].ev.lit = -1; s[0].ev.picked = -1; s[0].ev.person = -1;
}
// The extra instances an item's group keeps for placed things.
edit_cap :: (group: int) -> int {
  for k: 0..<EG_EDIT_ITEMS { if group_of(EDIT_MESH[k]) == group { return EG_EDIT_MAX; } }
  return 0;
}

// ---- on the screen: the button, and what was heard and done

ev_text :: (s: [] Everglade) -> string {
  p := cast(string) s[0].ev.phase[0..<s[0].ev.phase_n];
  if s[0].ev.held && (p == "" || p == "off" || p == "connecting") { return "CONNECTING · KEEP HOLDING"; }
  if s[0].ev.held && p == "listening" { return "LISTENING · SAY WHAT TO CHANGE"; }
  if (p == "hearing" || p == "heard") && s[0].ev.caption_n > 0 && s[0].ev.line_n == 0 { return cast(string) s[0].ev.caption[0..<s[0].ev.caption_n]; }
  if p == "notice" && s[0].ev.caption_n > 0 { return cast(string) s[0].ev.caption[0..<s[0].ev.caption_n]; }
  if s[0].ev.line_n > 0 { return cast(string) s[0].ev.line[0..<s[0].ev.line_n]; }
  return "SAY: PUT TWO BARRELS HERE · REMOVE THAT · UNDO";
}

// The button at the bottom middle, over the hint; returns its top.
everglade_voice_hud :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, bottom: f32) -> int {
  s[0].ev.button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  n := everglade_edit_hud(s, out, u, at, bottom);
  if !voice_on(s) || s[0].ev.editing || s[0].talk >= 0 || s[0].board || s[0].above { return n; }
  k := hi(s[0].dpr, 0.5); w := s[0].width;
  word := ifx s[0].ev.held then "LISTENING" else ifx phone(s) then "HOLD TO TALK" else "HOLD TO TALK · V";
  ts := 10 * k;
  bw := hi(text_width(word, ts) + 48 * k, 200 * k); bh := 52 * k;
  b := Box.{x0 = floor((w - bw) / 2), y0 = floor(bottom - bh), x1 = floor((w + bw) / 2), y1 = floor(bottom)};
  s[0].ev.button = b;
  plate(s, u, b, 0.92, ifx s[0].ev.held then 2.0f32 else 1.0f32);
  n = draw_text(out, n, word, floor((w - text_width(word, ts)) / 2), floor(b.y1 - 20 * k), ts, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  line := ev_text(s);
  ls := 7.5 * k;
  room := w - 48 * k;
  lw := text_width(line, ls);
  if lw > room { ls = ls * room / lw; lw = room; }
  y1 := b.y0 - 8 * k;
  plate(s, u, Box.{x0 = (w - lw) / 2 - 12 * k, y0 = y1 - ls - 20 * k, x1 = (w + lw) / 2 + 12 * k, y1 = y1}, 0.72, 0);
  n = draw_text(out, n, line, floor((w - lw) / 2), floor(y1 - 10 * k), ls, GAP, SPACE, ink(k, 0.9, PARCH_R, PARCH_G, PARCH_B), false, false);
  return n;
}

// ---- checks

#test "voice edits: only an admin on a voice page gets the button; the button holds and lets go" {
  s: [1] Everglade;
  everglade_message(s[..], MSG_FACTS, "now=1\nvoice=haunted-house\nplayer=p-1");
  #assert s[0].ev.voice && !voice_on(s[..]);
  everglade_message(s[..], MSG_VIEWER, "K|npub1x\nH|aa\n");
  #assert !voice_on(s[..]) && !everglade_voice_key(s[..], 'v', true);
  everglade_message(s[..], MSG_VIEWER, "K|npub1x\nH|aa\nA|1\n");
  #assert voice_on(s[..]);
  #assert everglade_key(s[..], 'v', 0) && s[0].ev.held && s[0].ev.want_face && s[0].ev.want_voice == 1;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE_TO && cast(string) s[0].outbox[0..<s[0].out_n] == VOICE_FACING;
  s[0].action = 0;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE && cast(string) s[0].outbox[0..<s[0].out_n] == "on";
  s[0].action = 0;
  #assert everglade_key_up(s[..], 'v', 0) && !s[0].ev.held;
  everglade_voice_actions(s[..]);
  #assert s[0].action == ACT_VOICE && cast(string) s[0].outbox[0..<s[0].out_n] == "end";
}

#test "voice edits: the heard words go to the server as they are; its typed answer places, removes and undoes" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_FACTS, "voice=haunted-house");
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  everglade_message(s[..], MSG_VOICE, "heard|Put two \"barrels\" here");
  #assert cast(string) s[0].ev.ask[0..<s[0].ev.ask_n] == "{\"sentence\":\"Put two barrels here\"}";
  // standing on the commons, facing south
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  walls := s[0].wall_n;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 2, \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2 && s[0].ev.edits.things[0].kind == 1 && s[0].ev.edits.things[0].z < -9;
  #assert s[0].wall_n == walls + 2 && s[0].ev.post_n > 0;
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED 2 BARRELS";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 2 barrels.";
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 1 && s[0].wall_n == walls + 1;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"undo\", \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2;
  everglade_message(s[..], MSG_VOICE, "heard|what time is it");
  #assert s[0].ev.line_n == 0 && ev_text(s[..]) == "what time is it";   // the heard words while the server answers
  everglade_edit_answer(s[..], "422\n{\"error\": \"none fit\"}");
  #assert s[0].ev.edits.n == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "DIDN'T CATCH AN EDIT IN: 'what time is it'";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "I didn't catch an edit.";
  // what was published is what everyone's page lays over the plan
  t: [1] Everglade;
  everglade_start(t[..]);
  body := cast(string) s[0].ev.post[0..<s[0].ev.post_n];
  #assert body.count > 40;
  everglade_world(t[..], "200\n{\"doc\": {\"edits\": \"eg-edit 1\\nt 1 600 -1200 0 100\\n\", \"everglade\": 1}, \"version\": 4}");
  #assert t[0].ev.edits.n == 1 && t[0].wall_n == walls + 1 && !voice_on(t[..]);
}

#test "voice edits: one of a thing is A THING, more are THINGS" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"bench\", \"count\": 2}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED 2 BENCHES" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 2 benches.";
  s[0].feet = v3(-6, 0, -9);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"place\", \"item\": \"barrel\", \"count\": 1}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "PLACED A BARREL" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed a barrel.";
  out: [64] u8;
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 3, EG_EDIT_LABEL[3], EG_EDIT_LABELS[3])] == "PLACED 3 FENCES";
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 4, EG_EDIT_LABEL[4], EG_EDIT_LABELS[4])] == "PLACED 4 STALLS";
  #assert cast(string) out[0..<ev_count(out[..], "PLACED ", 4, EG_EDIT_LABEL[0], EG_EDIT_LABELS[0])] == "PLACED 4 CRATES";
}

#test "voice edits: a row starts in front of you and never stands on you, whichever way you face" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  for f: 0..<8 {
    s[0].ev.edits.n = 0;
    s[0].feet = v3(4, 0, -12); s[0].face = f32(f) * f32(PI) / 4;
    for item: 0..<EG_EDIT_ITEMS {
      edit_place(s[..], item, 6, false);
    }
    #assert s[0].ev.edits.n > 0;
    box: [EG_BOX] f32;
    for i: 0..<s[0].ev.edits.n {
      eg_edit_box(s[0].ev.edits.things[i], box[..]);
      #assert box_gap(box[..], 0, 4, -12) >= f32(EG_RADIUS) + f32(EDIT_CLEAR) - 0.001;
      #assert eg_edit_fault(s[0].ev.edits, i) == EG_FAULT_NONE;
      // ahead of you, not behind
      t := s[0].ev.edits.things[i];
      #assert (t.x - 4) * sin(s[0].face) + (t.z + 12) * cos(s[0].face) > 0;
    }
  }
  // a row that doesn't all fit says how many didn't
  s[0].ev.edits.n = 0;
  s[0].feet = v3(0, 0, -52); s[0].face = 0;   // just inside the South Gate, facing in
  edit_place(s[..], 4, 6, false);
  line := cast(string) s[0].ev.line[0..<s[0].ev.line_n];
  #assert s[0].ev.edits.n == 6 || (line.count > 11 && line[line.count - 11..<line.count] == "DIDN'T FIT");
  s[0].ev.line_n = ev_put(s[0].ev.line[..], "PLACED 4 STALLS · 2 DIDN'T FIT");
  ev_say_line(s[..]);
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Placed 4 stalls, 2 didn't fit.";
}

#test "voice edits: placed things are walls from the ground they stand on; a bench you stand on casts your shadow on its top" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  s[0].feet = v3(6, 0, -9); s[0].face = f32(PI);
  edit_place(s[..], 2, 1, false);
  t := s[0].ev.edits.things[0];
  w := (s[0].wall_n - 1) * 6;
  g := ground_at(s[..], t.x, t.z);
  #assert abs(s[0].walls[w + 4] - (g + EG_EDIT_HALF[2 * 3 + 2])) < 0.001 && s[0].walls[w + 1] < g;
  // standing on the bench's top: the floor under you is its top, not the ground
  top := s[0].walls[w + 4];
  #assert abs(floor_under(s[..], t.x, t.z, top) - top) < 0.001 && abs(floor_under(s[..], t.x, t.z, g) - g) < 0.001;
  u: [UNIFORM_FLOATS] f32;
  s[0].shadow_n = 0;
  shadow(s[..], u[..], t.x, t.z, top, 0.45, 0.6);
  packed := u[U_SHADOW + 3];
  cm := floor(packed / 2);
  #assert abs(packed - cm * 2 - 0.6) < 0.01 && abs(cm / 100 - 100 - top) < 0.006;
}

#test "voice edits: remove these crates takes the row; remove Marta takes her, UNDO and ORIGINAL bring her back" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  // the owner's four crates (published before rows were kept: each on its own) and two benches
  everglade_world(s[..], "200\n{\"doc\": {\"edits\": \"eg-edit 1\\nt 0 400 -1200 0 100\\nt 0 534 -1200 0 100\\nt 0 668 -1200 0 100\\nt 0 802 -1200 0 100\\nt 2 600 -1700 0 100\\nt 2 600 -2000 0 100\\n\", \"everglade\": 1}, \"version\": 7}");
  #assert s[0].ev.edits.n == 6;
  s[0].feet = v3(6, 0, -10); s[0].face = f32(PI);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"crate\", \"all\": true, \"model\": \"m\"}");
  #assert s[0].ev.edits.n == 2 && s[0].ev.edits.things[0].kind == 2 && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED 4 CRATES";
  #assert cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Removed 4 crates." && s[0].ev.post_n > 0;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"undo\"}");
  #assert s[0].ev.edits.n == 6;
  // a row placed together goes as one, from wherever you stand by it
  s[0].ev.edits.n = 0;
  s[0].feet = v3(6, 0, -9);
  edit_place(s[..], 1, 6, false);
  placed := s[0].ev.edits.n;
  #assert placed > 1;
  s[0].feet = v3(6, 0, -3);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"barrel\", \"all\": true}");
  #assert s[0].ev.edits.n == 0;
  // a person by name, from anywhere: off the city, and back with UNDO and with ORIGINAL
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Marta\"}");
  #assert eg_gone(s[0].ev.edits, 5) && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MARTA" && cast(string) s[0].ev.say[0..<s[0].ev.say_n] == "Removed Marta.";
  #assert nearest(s[..], v3(-3.4, 0, -36)) != 5;
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Marta\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "MARTA IS ALREADY GONE";
  edit_undo(s[..], false);
  #assert !eg_gone(s[0].ev.edits, 5) && nearest(s[..], v3(-3.4, 0, -36)) == 5;
  // "remove these cats" by the inn takes its cat, not Marta
  s[0].feet = v3(-3, 0, -34);
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"item\": \"cat\", \"all\": true}");
  #assert eg_gone(s[0].ev.edits, 6) && !eg_gone(s[0].ev.edits, 5) && cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED SOOT";
  edit_toggle(s[..]);
  edit_press(s[..], EB_ORIGINAL); edit_press(s[..], EB_ORIGINAL);
  #assert s[0].ev.edits.gone == 0 && s[0].ev.reset;
}

#test "voice edits: with Moss taken away his quest is off the board, and one under way can't be handed in till he's back" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  #assert board_count(s[..]) == 3;
  s[0].stages[0] = 3;   // the waystone's quest, ready to hand in
  everglade_edit_answer(s[..], "200\n{\"edit\": \"remove\", \"who\": \"Moss\"}");
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MOSS";
  #assert board_count(s[..]) == 2 && board_nth(s[..], 0) == 1 && !on_board(s[..], 0);
  open_board(s[..]);
  #assert s[0].pick == 1;
  s[0].pick = 0; board_act(s[..]);
  #assert s[0].stages[0] == 3;
  close_board(s[..]);
  talk_to(s[..], EG_CRIER);
  #assert s[0].stages[0] == 3;
  end_talk(s[..]);
  edit_undo(s[..], true);
  #assert board_count(s[..]) == 3;
  open_board(s[..]);
  #assert s[0].pick == 0;
  board_act(s[..]);
  #assert s[0].stages[0] == EG_QUEST_DONE;
}

#test "edit mode: a click on one of the city's people picks them, and DELETE takes them away" {
  s: [1] Everglade;
  everglade_start(s[..]);
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  edit_toggle(s[..]);
  s[0].ev.pseen[5] = true; s[0].ev.px[5] = 400; s[0].ev.py[5] = 300;
  s[0].dpr = 1;
  #assert everglade_edit_pointer(s[..], 404, 302, 0, 3) && s[0].ev.person == 5 && s[0].ev.picked == -1;
  _ := everglade_key(s[..], 'r', 0);
  #assert !eg_gone(s[0].ev.edits, 5) && s[0].ev.person == 5;   // R turns things, not people
  #assert everglade_key(s[..], EV_KEY_DELETE, 0) && eg_gone(s[0].ev.edits, 5) && s[0].ev.person == -1;
  #assert cast(string) s[0].ev.line[0..<s[0].ev.line_n] == "REMOVED MARTA" && s[0].ev.due > 0;
  #assert everglade_key(s[..], 'z', 0) && !eg_gone(s[0].ev.edits, 5);
}
