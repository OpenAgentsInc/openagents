#test "watch: the Priest's Spiritual Weapon is one lit mace by you, its head on its haft's end, nothing drawn as flat glow" #steps 530000000 {
  g: [1] Everglade;
  everglade_start(g[..]);
  boxes := g[0].counts[SHAPE_BOX]; balls := g[0].counts[SHAPE_SPHERE];
  at := v3(3, 2, 4);
  for k: 0..<3 {
    watch_mace(g[..], at, 1.5 - f32(k) * 0.6);   // hanging, then winding up to its blow
    #assert g[0].counts[SHAPE_BOX] == boxes + 3 && g[0].counts[SHAPE_SPHERE] == balls + 2;
    haft := (SLOT_AT[SHAPE_BOX] + boxes) * OBJECT_FLOATS;
    head := (SLOT_AT[SHAPE_SPHERE] + balls) * OBJECT_FLOATS;
    // the head sits on the haft's end: 0.36 m along it from the haft's middle, the way the haft points
    hc := v3(g[0].objects[haft + 3], g[0].objects[haft + 7], g[0].objects[haft + 11]);
    up := v3(g[0].objects[haft + 1], g[0].objects[haft + 5], g[0].objects[haft + 9]);   // its long axis, 0.62 m
    hd := v3(g[0].objects[head + 3], g[0].objects[head + 7], g[0].objects[head + 11]);
    #assert abs(length(sub(hd, hc)) - 0.36) < 0.01 && dot(sub(hd, hc), up) > 0.35 * 0.62 * 0.95;
    #assert length(sub(hc, at)) < 0.1;
    for n: 0..<3 { #assert cast(int) g[0].objects[(SLOT_AT[SHAPE_BOX] + boxes + n) * OBJECT_FLOATS + 15] / 8 != LOOK_FLAME; }
    for n: 0..<2 { #assert cast(int) g[0].objects[(SLOT_AT[SHAPE_SPHERE] + balls + n) * OBJECT_FLOATS + 15] / 8 != LOOK_FLAME; }
    g[0].counts[SHAPE_BOX] = boxes; g[0].counts[SHAPE_SPHERE] = balls;
  }
}

#test "watch: R (the town stands again) also clears your WANTED stars" #steps 530000000 {
  g: [1] Everglade;
  everglade_start(g[..]);
  watch_page_start(g[..]);
  w := watch_w(g[..]);
  watch_you(w[..])[0].wanted = true; watch_you(w[..])[0].level = 5; watch_you(w[..])[0].heat = 40;
  _ := watch_rebuilt(g[..]);
  #assert !watch_you(w[..])[0].wanted && watch_you(w[..])[0].level == 0 && watch_you(w[..])[0].heat == 0;
}

// ---- the room server's town (coax/web/room/room-world.c; GitHub #12713)
// The server's headless Everglade runs the town for a room's players: everyone's day, the watch
// stepped against every seat (watch_tick_room: each hunter after their own foe), their crimes and
// WANTED. The room's SRD 5e rules (everglade5e-room-rules.coax) keep Hit Points, the seats' and the
// people's; this town takes them back each tick, and hands the rules where the people are and the
// damage its guards deal the seats.
EG_ROOM_SEAT_FLOATS :: 7;      // a seat as the host hands it: X Y Z LIVE HP MAX COND (LIVE 2 just sat; HP 0: dead; COND WC_*)
EG_ROOM_VIEW_FLOATS :: 12;     // a person as a page hears them (wire f): X Z YAW CLIP MODE HP SHOWN CASTING KIND FOE RANK MAX
EG_ROOM_MISSILE_FLOATS :: 11;  // a spell in the air (everglade_room_missile): KIND CASTER FOE AX AY AZ BX BY BZ FLIGHT LIFE
EG_ROOM_HEAR :: 60.0;          // m a crime carries (the bolt's: everglade-spells.coax WATCH_HEAR)

// One tick of the town, dt s, the shared clock at `world` s. seats: EG_ROOM_SEAT_FLOATS for each of n.
// took[p]: the Hit Points the watch's blows took from seat p this tick (for the room's rules), and
// took[WATCH_YOUS + p] who dealt them: the nearest of the town hunting p (a watch actor, -1 none).
everglade_room_town :: (s: [] Everglade, dt: f32, world: f64, seats: [] f32, n: int, took: [] f32) #export_c #effects(all) {
  if !s[0].started { everglade_start(s); }
  if !s[0].wv.started { watch_page_start(s); for p: 0..<WATCH_YOUS { s[0].wv.room_talk[p] = -1; } }   // nobody talks yet
  w := watch_w(s);
  w[0].on = true; w[0].peace = false; w[0].unhurt = false;
  s[0].wv.server = true;
  c := FolkClock.{day = 0.5, length = f32(STYLE_CYCLE_SECONDS), world = world, turning = false, still = false};
  m := lo_w(lo_w(n, WATCH_YOUS), seats.count / EG_ROOM_SEAT_FLOATS);
  at: [WATCH_YOUS] Point; live: [WATCH_YOUS] bool; hp: [WATCH_YOUS] int;
  me := w[0].me;
  for p: 0..<m {
    o := p * EG_ROOM_SEAT_FLOATS;
    at[p] = v3(seats[o], seats[o + 1], seats[o + 2]);
    live[p] = seats[o + 3] > 0.5;
    hp[p] = cast(int) seats[o + 4];
    s[0].wv.room_cond[p] = cast(int) seats[o + 6];
    w[0].me = p;
    if live[p] && (!s[0].wv.room_live[p] || seats[o + 3] > 1.5) { watch_start_you(w); s[0].wv.room_dead[p] = false; }   // a new player: whole, unwanted
    s[0].wv.room_live[p] = live[p]; s[0].wv.room_at[p] = at[p];
    if !live[p] { s[0].wv.room_talk[p] = -1; continue; }
    // a talk the seat walked away from is over
    tk := s[0].wv.room_talk[p];
    if tk >= 0 && tk < EG_SPOTS {
      dx := s[0].folk[tk].x - at[p].x; dz := s[0].folk[tk].z - at[p].z;
      if dx * dx + dz * dz > f32(EG_TALK_LET_GO) * f32(EG_TALK_LET_GO) { s[0].wv.room_talk[p] = -1; }
    }
    y := watch_you(w[..]);
    dead := hp[p] <= 0;
    if s[0].wv.room_dead[p] && !dead { watch_stand_down(w); }   // risen: the watch forgets them
    s[0].wv.room_dead[p] = dead;
    // the rules' Hit Points are theirs; the watch's death is the rules' (the room raises them)
    y[0].max = hi_w(cast(int) seats[o + 5], 1); y[0].hp = hi_w(hp[p], 0); y[0].temp = 0;
    y[0].dead = dead; y[0].dead_t = 0; y[0].respawn = false;
  }
  // everyone's day: a spot's routine, a new guard's beat (turned to the nearest player)
  for i: 0..<EG_SPOTS {
    if eg_gone(s[0].ev.edits, i) || EG_SPOT_CAT[i] { continue; }
    near := eg_room_nearest(s, s[0].folk[i].x, s[0].folk[i].z, m);
    you := ifx near >= 0 then at[near] else FOLK_AWAY;
    // talked to: they stop and face whoever talks to them, on every page
    talking := false;
    for p: 0..<m { if s[0].wv.room_live[p] && s[0].wv.room_talk[p] == i { talking = true; you = at[p]; break; } }
    folk_step(s[0].folk[i..<i + 1], i, dt, you, talking, 1000.0f32, c, s[0].heights[..]);
    watch_home(w, i, s[0].folk[i].x, s[0].folk[i].z, s[0].folk[i].yaw, s[0].folk[i].indoors);
  }
  for k: 0..<WATCH_NEW {
    watch_new_place(s, k, c, dt);
    watch_home(w, EG_SPOTS + k, s[0].wv.at[k].x, s[0].wv.at[k].z, s[0].wv.at[k].yaw, false);
  }
  w[0].floor_n = eg_watch_floors(s, w);
  w[0].deck_out = sp_deck_out(s);   // the bridge's planks down: no deck there
  watch_tick_room(w, dt, c.day, at[0..<m], live[0..<m], s[0].boxes[..], s[0].box_n, s[0].heights[..]);
  for p: 0..<lo_w(m, took.count) {
    took[p] = 0;
    if !live[p] { continue; }
    w[0].me = p;
    y := watch_you(w[..]);
    if !s[0].wv.room_dead[p] { took[p] = f32(hi_w(hp[p] - y[0].hp, 0)); }
    if WATCH_YOUS + p < took.count {
      by := -1; bd := 1000000000.0f32;
      for i: 0..<WATCH_ACTORS {
        a := w[0].actors[i];
        if !watch_here(w, i) || a.foe != p || (a.mode != WM_CHASE && a.mode != WM_FIGHT) { continue; }
        d := (a.x - at[p].x) * (a.x - at[p].x) + (a.z - at[p].z) * (a.z - at[p].z);
        if d < bd { bd = d; by = i; }
      }
      took[WATCH_YOUS + p] = f32(by);
    }
    y[0].bound_said = 0;   // a throw stays for the seat's next step (everglade_knock)
  }
  // the gates shut while any seat is WANTED GATES_AT or more (everglade-doors.coax gate_bodies)
  shut := false;
  for p: 0..<m { if live[p] && !s[0].wv.room_dead[p] && s[0].wt[0].yous[p].wanted && s[0].wt[0].yous[p].level >= GATES_AT { shut = true; } }
  s[0].gates_shut = shut;
  w[0].me = me;
}
// The town's gates for the room's doors row (its FORM): bit 0 shut, then each leaf burnt through and
// alight (everglade-fire.coax fi_gates_bits).
everglade_room_gates :: (s: [] Everglade) -> int #export_c #effects(all) { return fi_gates_bits(s); }
// The live seat nearest (x, z), or -1.
eg_room_nearest :: (s: [] Everglade, x: f32, z: f32, n: int) -> int {
  best := -1; bd := 1000000000.0f32;
  for p: 0..<n {
    if !s[0].wv.room_live[p] { continue; }
    dx := s[0].wv.room_at[p].x - x; dz := s[0].wv.room_at[p].z - z;
    if dx * dx + dz * dz < bd { bd = dx * dx + dz * dz; best = p; }
  }
  return best;
}
// The people for the room's rules: E5R_FOLK_FLOATS each (here, x, z, Hit Points, Temporary, most, AC,
// stat block). How many.
everglade_room_people :: (s: [] Everglade, out: [] f32) -> int #export_c #effects(all) {
  if !s[0].started || !s[0].wv.started { return 0; }
  w := watch_w(s);
  n := 0;
  for i: 0..<WATCH_ACTORS {
    if (n + 1) * 8 > out.count { break; }
    o := n * 8;
    a := w[0].actors[i];
    out[o] = ifx watch_here(w, i) && !(a.mode == WM_CALM && a.home_in) then 1.0f32 else 0.0f32;
    // stood up whole since the rules last heard (a responder called in, the fallen at dawn): HERE 2, a
    // fresh face, so the rules' Hit Points for them start again from these, not their last fall
    if out[o] > 0.5 && a.born != s[0].wv.room_born[i] { out[o] = 2; s[0].wv.room_born[i] = a.born; }
    pl := person_place(s, i);
    out[o + 1] = ifx a.body.on then a.body.x else pl.x; out[o + 2] = ifx a.body.on then a.body.z else pl.z;
    out[o + 3] = f32(a.hp); out[o + 4] = f32(a.temp); out[o + 5] = f32(a.max);
    st := watch_stats(w, i);
    out[o + 6] = f32(st.ac); out[o + 7] = f32(watch_block_of(st.name));
    n += 1;
  }
  return n;
}
// The stat block's number in the rules (everglade5e-rules.coax E5R_BLOCK_NAME).
watch_block_of :: (name: string) -> int {
  if name == "Commoner" { return 0; } if name == "Guard" { return 1; } if name == "Warrior Veteran" { return 2; }
  if name == "Mage" { return 3; } if name == "Knight" { return 4; } if name == "Priest" { return 5; }
  if name == "Archmage" { return 6; } if name == "Gladiator" { return 7; } if name == "Scout" { return 8; }
  return 1;
}
// Person i's Hit Points as the room's rules have them now: harm lands as the town's own does (knocked
// down, or dead), healing raises them. `by`: the seat that harmed them (-1 none), whom they turn on.
everglade_room_folk_hp :: (s: [] Everglade, i: int, hp: int, temp: int, by: int) #export_c #effects(all) {
  if !s[0].wv.started || i < 0 || i >= WATCH_ACTORS { return; }
  w := watch_w(s);
  if !watch_here(w, i) { return; }
  a := w[0].actors[i..<i + 1];
  lost := (a[0].hp + a[0].temp) - (hp + temp);
  if a[0].mode == WM_DEAD { return; }
  me := w[0].me;
  b := ifx by >= 0 && by < WATCH_YOUS then by else eg_room_nearest(s, a[0].x, a[0].z, WATCH_YOUS);
  if b < 0 { b = 0; }
  w[0].me = b;
  if lost > 0 { watch_harm(w, i, lost, s[0].wv.room_at[b]); }
  else if lost < 0 { a[0].hp = lo_w(hp, a[0].max); a[0].temp = temp; }
  w[0].me = me;
}
// Person i's conditions as the room's rules have them now (WC_*, the rules' RS_* numbers).
everglade_room_folk_cond :: (s: [] Everglade, i: int, cond: int) #export_c #effects(all) {
  if i < 0 || i >= WATCH_ACTORS { return; }
  s[0].wv.rules_on = true; s[0].wv.rules_cond[i] = cond;
}
// Person i's save as the room's rules rolled it against seat `seat`'s ability `ab` (AB_*), this step:
// the push of that seat's copy of it follows the save rather than rolling one of its own (#12874).
everglade_room_folk_save :: (s: [] Everglade, i: int, ab: int, seat: int, saved: bool) #export_c #effects(all) {
  if i < 0 || i >= WATCH_ACTORS || ab < 0 || seat < 0 || seat >= WATCH_YOUS { return; }
  s[0].wv.rules_save[i] = 1 + (ab * WATCH_YOUS + seat) * 2 + (ifx saved then 1 else 0);
}
// Seat `by` harmed someone of the town at (x, z): a crime, heard EG_ROOM_HEAR m. How many guards turned.
everglade_room_crime :: (s: [] Everglade, by: int, x: f32, z: f32) -> int #export_c #effects(all) {
  if !s[0].wv.started || by < 0 || by >= WATCH_YOUS || !s[0].wv.room_live[by] { return 0; }
  w := watch_w(s);
  me := w[0].me;
  w[0].me = by;
  turned := watch_crime(w, v3(x, ground_at(s, x, z), z), f32(EG_ROOM_HEAR), s[0].wv.room_at[by], s[0].boxes[..], s[0].box_n, s[0].heights[..]);
  w[0].me = me;
  return turned;
}
// Person i as a page hears them (wire f, EG_ROOM_VIEW_FLOATS): X Z YAW CLIP MODE HP SHOWN, then a caster's
// spell as it winds up: CASTING its seconds into it (-1 none), KIND (MS_*), FOE the seat it is for; then RANK (a responder's RANK_* + 1,
// the stars' roster: everglade/legacy/v1/watch.coax LADDER; 0 the town's own) and MAX, their most Hit Points. On
// their day CLIP is 1 walking, 0 standing; off it, the watch's clip. SHOWN 0: indoors, taken away or not called in.
everglade_room_view :: (s: [] Everglade, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if !s[0].wv.started || i < 0 || i >= WATCH_ACTORS || out.count < EG_ROOM_VIEW_FLOATS { return false; }
  w := watch_w(s);
  a := w[0].actors[i];
  pl := person_place(s, i);
  off := watch_off(w, i);
  out[0] = ifx off then a.x else pl.x; out[1] = ifx off then a.z else pl.z; out[2] = ifx off then a.yaw else pl.face;
  out[3] = ifx off then f32(a.clip) else (ifx pl.walking then 1.0f32 else 0.0f32);
  out[4] = f32(ifx a.ready then a.mode else WM_CALM); out[5] = f32(a.hp);
  shown := watch_here(w, i) && !(a.mode == WM_CALM && a.home_in) && !(i < EG_SPOTS && s[0].folk[i].indoors && !off);
  out[6] = ifx shown then 1.0f32 else 0.0f32;
  casting := a.ready && a.casting >= 0 && a.mode != WM_DEAD && a.mode != WM_DOWN;
  out[7] = ifx casting then a.casting else -1.0f32; out[8] = f32(a.cast_kind); out[9] = f32(a.foe);
  out[10] = ifx watch_is_rein(i) then f32(watch_rank(w, i) + 1) else 0.0f32;
  out[11] = f32(a.max);
  return true;
}
// Seat p comes back WANTED at `level` (1 to 5): the level the room saved for its player (coax/web/room/
// room-vitals.coax rv_join, #12794), laid on once the town has met the seat.
everglade_room_seed_wanted :: (s: [] Everglade, p: int, level: int) #export_c #effects(all) {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS || !s[0].wv.room_live[p] || level <= 0 { return; }
  w := watch_w(s);
  me := w[0].me;
  w[0].me = p;
  l := clamp_w(level, 1, WANTED_LEVELS);
  y := watch_you(w[..]);
  // the heat its level needs: the town's next step raises the level to it, each star's roster coming in
  y[0].wanted = true; y[0].unseen = 0; y[0].heat = hi_w(y[0].heat, HEAT_AT[l]);
  w[0].me = me;
}
// The next spell of the watch's that left its caster's hands since the last asked (EG_ROOM_MISSILE_FLOATS
// into out), marked told; false when there is none. The room tells the pages (e wm), which draw its flight.
everglade_room_missile :: (s: [] Everglade, out: [] f32) -> bool #export_c #effects(all) {
  if !s[0].wv.started || out.count < EG_ROOM_MISSILE_FLOATS { return false; }
  w := watch_w(s);
  for k: 0..<MISSILES {
    m := w[0].missiles[k];
    if !m.live || m.sent || m.t > m.flight { continue; }
    w[0].missiles[k].sent = true;
    out[0] = f32(m.kind); out[1] = f32(m.caster); out[2] = f32(m.foe);
    out[3] = m.ax; out[4] = m.ay; out[5] = m.az; out[6] = m.bx; out[7] = m.by; out[8] = m.bz;
    out[9] = m.flight; out[10] = m.life;
    return true;
  }
  return false;
}
// Seat p's WANTED level (0 not wanted).
everglade_room_wanted :: (s: [] Everglade, p: int) -> int #export_c #effects(all) {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS { return 0; }
  y := s[0].wt[0].yous[p];
  // a level its heat has reached before the town's next step raises it (a seat just seeded) is its level
  return ifx y.wanted then hi_w(y.level, watch_level_for(y.heat)) else 0;
}

// A page in a room whose server runs the town (everglade-net.coax net_town): everyone of the town is
// where the server has them (f), in its mode, clip and Hit Points; on their day a spot's person walks
// where it says and one not heard is indoors (or too far to draw); your WANTED level is the server's.
// The page's own watch does not step: no blows, crimes or waves of its own.
// In a room your death is the server's (everglade5e.coax e5_room_death sets it and ends it); the watch's
// own tick doesn't run there, so your fall, the view's dark and its coming back run here.
watch_net_you :: (w: [] Watch, dt: f32) {
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  y := watch_you(w[..]);
  if y[0].dead { y[0].you_fall += t; y[0].dead_t += t; }
  else if y[0].dead_t < 0 { y[0].dead_t = lo(y[0].dead_t + t, 0); }
  // the watch's spells the server said left their casters' hands (e wm) fly here, drawn only: what
  // they do is the server's
  for k: 0..<MISSILES {
    m := w[0].missiles[k];
    if !m.live { continue; }
    w[0].missiles[k].t += t;
    if m.kind == MS_MAGIC_MISSILE { watch_dart_step(w, k, t, v3(m.bx, m.by - 1.0, m.bz)); }
    if w[0].missiles[k].t >= m.flight + m.life { w[0].missiles[k].live = false; }
  }
}
// A watch spell the room's server says left its caster's hands (e wm KIND CASTER FOE AX AY AZ BX BY BZ
// FLIGHT LIFE): it flies on this page as on the server's, drawn by watch_missiles_draw.
watch_net_missile :: (w: [] Watch, kind: int, caster: int, a: Point, b: Point, flight: f32, life: f32) {
  if kind < 0 || kind > MS_EARTHBIND { return; }
  k := watch_missile_slot(w);
  m := Missile.{live = true, kind = kind, caster = caster, ax = a.x, ay = a.y, az = a.z, bx = b.x, by = b.y, bz = b.z,
                t = 0, flight = clamp(flight, 0.02, 5), life = clamp(life, 0.05, 30), sent = true, foe = -1};
  if kind == MS_MAGIC_MISSILE {
    fwd := unit_or(sub(b, a), v3(0, 0, 1));
    v := times(unit_or(add(times(fwd, 0.45), v3(0, 0.75, 0)), fwd), f32(MM_SPEED) * 0.6);
    m.vx = v.x; m.vy = v.y; m.vz = v.z;
  }
  w[0].missiles[k] = m;
}
watch_net_frame :: (s: [] Everglade) {
  w := watch_w(s);
  for i: 0..<WATCH_ACTORS {
    if !watch_hurtable(i) { continue; }
    f := net_folk(s, i);
    a := w[0].actors[i..<i + 1];
    // the room's rules have the town: the abilities' holds (Entangle's vines, the tentacles) follow the
    // conditions its server reports on each one, none on one not heard (ab_rules_cond, #12873)
    s[0].wv.rules_on = true; s[0].wv.rules_cond[i] = ifx f.ok then f.cond else 0;
    if !f.ok {
      if watch_is_rein(i) { a[0].homed = false; }
      else if i < EG_SPOTS { s[0].folk[i].indoors = true; s[0].folk[i].walking = false; a[0].mode = WM_CALM; }
      else { a[0].mode = WM_CALM; }
      continue;
    }
    // a responder of the stars' roster as the server says: its rank (its look and stat block) and its most HP
    if watch_is_rein(i) && f.rank > 0 && a[0].rank != f.rank - 1 { a[0].rank = clamp_w(f.rank - 1, 0, RANKS - 1); a[0].ready = false; }
    if !a[0].ready { watch_revive(w, i); }
    if a[0].reference!=f.reference {a[0].shout= -1;a[0].shout_t=0;}
    a[0].reference=f.reference;
    if f.max > 0 { a[0].max = f.max; }
    a[0].homed = true;
    a[0].x = f.x; a[0].z = f.z; a[0].yaw = f.yaw; a[0].hp = f.hp;
    a[0].mode = f.mode; a[0].body.on = false;
    // how long they have been in it, the server's: a fall seen again, or late, is where it is (watch_pose)
    if f.since >= 0 { a[0].t = f.since; }
    // a caster winding up: their hands glow and the bar over them fills (watch_missiles_draw)
    a[0].casting = f.casting; a[0].cast_kind = ifx f.casting >= 0 then f.kind else a[0].cast_kind; a[0].foe = f.foe;
    if f.mode == WM_CALM {
      if i < EG_SPOTS { s[0].folk[i].x = f.x; s[0].folk[i].z = f.z; s[0].folk[i].yaw = f.yaw; s[0].folk[i].walking = f.clip == 1; s[0].folk[i].indoors = false; }
      else if !watch_is_rein(i) { k := i - EG_SPOTS; s[0].wv.at[k].x = f.x; s[0].wv.at[k].z = f.z; s[0].wv.at[k].yaw = f.yaw; s[0].wv.at[k].walking = f.clip == 1; }
    } else {
      a[0].clip = f.clip; a[0].hold = f.mode == WM_DOWN || f.mode == WM_DEAD;
    }
  }
  y := watch_you(w[..]);
  level := net_wanted(s);
  y[0].wanted = level > 0; y[0].level = level; y[0].unseen = 0;
}

// In a room the page steps no one of the town (the server does), so a shout over a head ends here:
// after SHOUT_FOR as the town's own step ends it, and at once when its speaker is gone from the room's
// rows, down, dead or calm again (owner playtest, #12931: HELP! and HALT! hung in the air after the chase).
watch_net_shouts :: (s: [] Everglade, dt: f32) {
  w := watch_w(s);
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  for i: 0..<WATCH_ACTORS {
    a := w[0].actors[i..<i + 1];
    if a[0].shout < 0 { continue; }
    a[0].shout_t += t;
    speaker:=net_folk(s,i);
    gone := !watch_hurtable(i) || !speaker.ok || !handle_present(a[0].shout_owner) || a[0].shout_owner!=speaker.reference;
    quiet := a[0].mode == WM_CALM || a[0].mode == WM_DEAD || a[0].mode == WM_DOWN;
    if gone || quiet || a[0].shout_t > f32(SHOUT_FOR) { a[0].shout = -1; a[0].shout_t = 0; }
  }
}
#test "watch: in a room a shout ends after its time, and at once when its speaker calms, falls or is gone (#12931)" {
  s: [1] Everglade;
  w := watch_w(s[..]);
  g := EG_SPOTS;   // a new guard
  w[0].actors[g].mode = WM_CHASE; w[0].actors[g].shout = 0; w[0].actors[g].shout_t = 0;
  // not in the room's rows: gone at once
  watch_net_shouts(s[..], 0.1);
  #assert w[0].actors[g].shout == -1;
  // calm: gone at once
  w[0].actors[g].shout = 3; w[0].actors[g].mode = WM_CALM;
  watch_net_shouts(s[..], 0.1);
  #assert w[0].actors[g].shout == -1;
  // a name drawn where the shout would go: the shout goes over it, clear of it
  name := [1] Box.[Box.{x0 = 90, y0 = 190, x1 = 170, y1 = 212}];
  b := shout_box(name[..], 100, 200, 80, 8);
  #assert b.y1 <= name[0].y0;
}
#test "shout handles: a replacement in the same replicated slot cannot inherit the old speaker's line" {
  s:[1]Everglade;n:[1]EgNet;s[0].net=n[..];n[0].state=NET_OPEN;n[0].seat=0;
  g:=EG_SPOTS;k:=net_ent(n[..],NET_FOLK_ID+g,true);
  n[0].ents[k].hp=10;n[0].ents[k].shown.f=WM_CHASE;
  original:=net_folk(s[..],g).reference;
  w:=watch_w(s[..]);w[0].actors[g].mode=WM_CHASE;w[0].actors[g].shout=0;
  w[0].actors[g].reference=original;w[0].actors[g].shout_owner=original;
  watch_net_shouts(s[..],0.1);#assert w[0].actors[g].shout==0;
  n[0].ents[k].live=false;next:=net_ent(n[..],NET_FOLK_ID+g,true);
  n[0].ents[next].hp=10;n[0].ents[next].shown.f=WM_CHASE;
  #assert next==k && net_folk(s[..],g).reference!=original;
  watch_net_shouts(s[..],0.1);#assert w[0].actors[g].shout== -1;
}

// ---- the room server's town breaking (GitHub #12713): the strikes of Everglade's own four spells
// (the meteors, the bolt, the mega bolt, the orb) fall on the server's town as on a page's, from the
// cast's seed; what breaks and what catches fire, and fire's own spreading and burning down, are the
// server's, and each page hears it (e break, e burn) and breaks and lights the same pieces.
EG_ROOM_EVENTS :: 96;
EG_ROOM_EV_FLOATS :: 5;   // KIND PIECE A B C: KIND 1 a break (A B C its throw, m/s), 2 alight (A 1 on, 0 out)

#test "room town: thirty two simultaneous authoritative beams match their serial destruction (#12841)" #steps 30000000000 {
  states:[2][DEMO_PIECES]int;hit:[2]Point;
  for run:0..<2{
    g:[1]Everglade;dm:[1]DemoWorld;ignored_walls:=everglade_walls(g[..]);everglade_room_spells_start(g[..],dm[..],"");
    w:=sp_dm(g[..]);found:=0;
    for i:0..<w[0].n{p:=w[0].pieces[i];if p.state!=DP_STANDING||fi_fuel(p)<=0.5{continue;}
      at:=v3(p.cx,p.y0+0.4,p.cz);
      if found==0{hit[0]=at;found=1;}else if found==1&&flat_gap(hit[0],at)>25{hit[1]=at;found=2;}
    }#assert found==2;
    for n:0..<32{
      at:=hit[ifx n<8 then 0 else 1];
      everglade_room_strike(g[..],n/2,WL_SLOT0+WL_BLAST,at.x,at.y+1,at.z-2,at.x,at.y,at.z,7+n);
      if run==0{_:=everglade_room_spells(g[..],0.36);}
    }
    if run==1{_:=everglade_room_spells(g[..],0.36);}
    for i:0..<w[0].n{states[run][i]=w[0].pieces[i].state;}
    if run==1{for i:0..<w[0].n{#assert states[0][i]==states[1][i];}}
  }
}

// The server's town gets its pieces: the storage for them, and the pack's catalog (their bounds).
everglade_room_spells_start :: (s: [] Everglade, dm: [] DemoWorld, catalog: string) #export_c #effects(all) {
  if !s[0].started { everglade_start(s); }
  s[0].sp.on = true; s[0].wv.net = true;
  eg_ra_server_start(s);
  everglade_attach_demolish(s, dm);
  spells_catalog(s, catalog);
  eg_room_known(s);
}
eg_room_known :: (s: [] Everglade) {
  if s[0].sp.dm.count < 1 { return; }
  w := sp_dm(s);
  for i: 0..<DEMO_PIECES { s[0].wv.room_stood[i] = i < w[0].n && w[0].pieces[i].state == DP_STANDING; s[0].wv.room_burnt[i] = false;s[0].wv.room_break_at[i]= -1; }
  s[0].wv.room_fell = -1;   // the next tick reads every piece
  v := fi_of(s);
  for k: 0..<v[0].n { s[0].wv.room_burnt[v[0].burn[k].piece] = true; }
  s[0].wv.room_known = true;
}
// A cast of bar slot `slot` (one of the four) from `from` at `at`, from the seed every page plays it from.
// The room hands it over when the caster's cast bar is done (coax/web/room/room-casts.coax rc_release:
// a bar stopped before then never strikes, #12790), so it falls at the next step (eg_ra_later).
everglade_room_strike :: (s: [] Everglade, by: int, slot: int, fx: f32, fy: f32, fz: f32, ax: f32, ay: f32, az: f32, seed: int) #export_c #effects(all) {
  source:=ifx by>=0&&by<EFFECT_SEATS then by else EFFECT_HOUSE;
  ignored_effect:=everglade_room_strike_try(s,source,by,slot,fx,fy,fz,ax,ay,az,seed);
}
// A Repair whose bar is done (coax/web/room/room-casts.coax): the broken thing nearest where it was cast,
// within reach of its caster, whole again; every page hears what (e mend) and does the same.
eg_room_repair :: (s: [] Everglade, from: Point, at: Point) {
  code := mend_find(s, from, at);
  if code < 0 { return; }
  c := mend_centre(s, code);
  if !mend_up(s, code) { return; }
  q := code - CR_REPAIR_PLACED0;
  if q >= 0 && q < CR_PLACED_MAX { s[0].wv.room_pburn[q] = false; s[0].wv.room_pgone[q] = false; }
  eg_room_known(s);   // its pieces stand: what breaks of them next is news again
  eg_room_put(s, 3, code, c.x, c.y, c.z);
}
// Sparse forest record q for the host's ordinary entity table. Zero is the planted default.
// Identity, base x, extra lift, base z, mode, tilt x/z, break, rest, soot, bare, frost, burning,
// starter, age and lifetime. The host only copies this record to rm_eg_tree.
everglade_room_tree :: (s: [] Everglade, q: int, out: [] f32) -> bool #export_c #effects(all) {
  if !sp_on(s) || q < 1 || q >= TF_POOL || out.count < FOREST_FLOATS { return false; }
  v := tf_of(s); t := v[0].owner[q] - 1;
  if t < 0 || t >= s[0].tree_n { return false; }
  for i: 0..<FOREST_FLOATS { out[i] = 0; }
  out[0] = f32(t); out[1] = s[0].trees[t * TREE_FLOATS] + v[0].ox[q]; out[2] = v[0].oy[q]; out[3] = s[0].trees[t * TREE_FLOATS + 1] + v[0].oz[q];
  out[4] = f32(v[0].mode[q]); out[5] = v[0].ax[q]; out[6] = v[0].az[q]; out[7] = v[0].pivot[q]; out[8] = v[0].rest[q];
  out[9] = v[0].soot[q]; out[10] = v[0].bare[q]; out[11] = v[0].frost[q]; out[13] = -1;
  for b: 0..<v[0].n {
    e := v[0].burn[b];
    if e.tree == t { out[12] = 1; out[13] = f32(fi_reference_owner(s,e.by,e.owner)); out[14] = e.t; out[15] = e.out; break; }
  }
  return forest_valid(out[0..<FOREST_FLOATS]);
}
#test "room forest: the host exports the independently specified tree record and clears it on rebuild (#12940)" #steps 2000000000 {
  g: [1] Everglade; dm: [1] DemoWorld; sp_ready_city(g[..], dm[..]);
  #assert TF_POOL == FOREST_RECORDS && TREES == FOREST_PLANTED;
  g[0].tree_n = 2; put_tree(g[0].trees[..], 0, -80, -15, 0.6, 0, 0);
  #assert tf_own(g[..], 0);
  v := tf_of(g[..]); k := tf_k(g[..], 0);
  v[0].mode[k] = TF_FALL; v[0].ax[k] = 1; v[0].az[k] = -0.2; v[0].oy[k] = 2;
  v[0].pivot[k] = 0.6; v[0].rest[k] = 1.5; v[0].soot[k] = 0.25; v[0].bare[k] = 0.5; v[0].frost[k] = 0.1;
  v[0].n = 1; v[0].burn[0] = TfBurn.{tree = 0, by = 2, t = 3.4, out = 40};
  want := [16] f32.[0, -80, 2, -15, 1, 1, -0.2, 0.6, 1.5, 0.25, 0.5, 0.1, 1, 2, 3.4, 40];
  out: [16] f32;
  #assert !everglade_room_tree(g[..], 0, out[..]) && !everglade_room_tree(g[..], TF_POOL, out[..]);
  #assert !everglade_room_tree(g[..], k, out[0..<15]) && everglade_room_tree(g[..], k, out[..]);
  for i: 0..<16 { #assert out[i] == want[i]; }
  // Replication resolves the captured starter's lifetime, just as damage does.
  g[0].wv.net = true;
  old := ev_seat_reference(2, 1); replacement := ev_seat_reference(2, 2);
  everglade_room_seat_owner(g[..], 2, old.value);
  v[0].n = 0; fi_as(g[..], 2); #assert tf_ignite(g[..], 0);
  #assert everglade_room_tree(g[..], k, out[..]) && out[13] == 2;
  everglade_room_seat_owner(g[..], 2, replacement.value);
  #assert everglade_room_tree(g[..], k, out[..]) && out[12] == 1 && out[13] == -1;
  tf_restore(g[..]); #assert !everglade_room_tree(g[..], k, out[..]);
}
// The town's pieces, and whether piece i stands whole and not alight (a Repair's, for the host).
everglade_room_pieces :: (s: [] Everglade) -> int #export_c #effects(all) { return ifx sp_on(s) then sp_dm(s)[0].n else 0; }
everglade_room_piece_up :: (s: [] Everglade, i: int) -> bool #export_c #effects(all) {
  if !sp_on(s) || i < 0 || i >= sp_dm(s)[0].n { return false; }
  return sp_dm(s)[0].pieces[i].state == DP_STANDING && !fi_burning(s, i);
}
eg_room_release :: (s: [] Everglade, by: int, slot: int, fx: f32, fy: f32, fz: f32, ax: f32, ay: f32, az: f32, seed: int) {
  s[0].wv.net = true;
  s[0].sp.cast_at = v3(ax, ay, az); s[0].sp.cast_n = v3(0, 1, 0); s[0].sp.cast_from = v3(fx, fy, fz);
  s[0].sp.cast_seed = cast(u64) hi_w(seed, 1);
  s[0].sp.remote = false;
  s[0].wv.room_hit = v3(ax, ay, az); s[0].wv.room_by = by;
  sp_release(s, slot);
  if slot == SP_ORB { s[0].sp.orb_live = true; s[0].sp.orb_t = 0; s[0].sp.orb_remote = false; s[0].sp.orb_to = v3(ax, ay, az); }
}
// The server's town for dt: the strikes land, fire burns and spreads, the walls open where pieces broke;
// then what changed for the pages (everglade_room_event). How many events.
everglade_room_spells :: (s: [] Everglade, dt: f32) -> int #export_c #effects(all) {
  s[0].wv.room_ev_n = 0;
  if !sp_on(s) { return 0; }
  if !s[0].wv.room_known { eg_room_known(s); }
  s[0].wv.room_break_step+=1;
  if sp_dm(s)[0].fell!=s[0].wv.room_fell{eg_effect_breaks(s,s[0].wv.room_by,s[0].wv.room_hit);}
  for q: 0..<s[0].wv.mend_n { eg_room_repair(s, s[0].wv.mend_from[q], s[0].wv.mend_at[q]); }
  s[0].wv.mend_n = 0;
  // what the strikes and fire do to the town is the last caster's doing (its crimes are theirs)
  wt := watch_w(s); me := wt[0].me;
  eg_ra_strikes_due(s, dt);   // the strikes whose cast bars are done fall now
  eg_effects_step(s,dt);
  wt[0].me = clamp_w(s[0].wv.room_by, 0, WATCH_YOUS - 1);
  s[0].wv.room_nobody = s[0].wv.room_by < 0;   // not seat 0's: the raid's Fireball set no player WANTED (#12916)
  sp_strikes(s, dt);
  wl_step(s, dt);   // the Warlock's strikes land (everglade-warlock.coax)
  fi_frame(s, dt);
  tf_frame(s, dt);   // the same authoritative step burns, spreads and moves the forest (#12940)
  s[0].wv.room_nobody = false;
  wt[0].me = me;
  if s[0].sp.walls_dirty { sp_open_walls(s); }
  w := sp_dm(s);
  now: [DEMO_PIECES] bool;
  v := fi_of(s);
  for k: 0..<v[0].n { now[v[0].burn[k].piece] = true; }
  // the pieces read only when one has fallen or burns (or stopped burning) since: most ticks none has (#12717)
  scan := w[0].fell != s[0].wv.room_fell || v[0].n > 0 || s[0].wv.room_any_burnt;
  s[0].wv.room_fell = w[0].fell; s[0].wv.room_any_burnt = v[0].n > 0;
  // each piece read in place (a copy of each of the 4000 pieces every tick was most of this step: #12717)
  for i: 0..<(ifx scan then w[0].n else 0) {
    standing := w[0].pieces[i].state == DP_STANDING;
    if s[0].wv.room_stood[i] && !standing {
      c := v3(w[0].pieces[i].cx, w[0].pieces[i].cy, w[0].pieces[i].cz);
      hit:=ifx s[0].wv.room_break_at[i]==s[0].wv.room_break_step then s[0].wv.room_break_hit[i] else s[0].wv.room_hit;
      d := sub(c, hit);
      throw := ifx s[0].wv.room_burnt[i] then v3(0, 1.2, 0) else add(times(unit_or(v3(d.x, 0, d.z), v3(0, 0, 1)), 6), v3(0, 3, 0));
      eg_room_put(s, 1, i, throw.x, throw.y, throw.z);
      s[0].wv.room_stood[i] = false;
    }
    if now[i] != s[0].wv.room_burnt[i] {
      if standing { eg_room_put(s, 2, i, ifx now[i] then 1.0f32 else 0.0f32, 0, 0); }
      s[0].wv.room_burnt[i] = now[i];
    }
  }
  // the placed things: alight, out, burnt through (everglade-placed-fire.coax)
  if pf_of(s)[0].any || s[0].wv.room_any_placed {
    s[0].wv.room_any_placed = pf_of(s)[0].any;
    for i: 0..<lo_i(s[0].ev.edits.n, CR_PLACED_MAX) {
      c := s[0].ev.edits.things[i];
      if pf_gone(s, i) != s[0].wv.room_pgone[i] {
        s[0].wv.room_pgone[i] = pf_gone(s, i);
        if s[0].wv.room_pgone[i] { eg_room_put(s, 5, i, 0, c.x, c.z); s[0].wv.room_pburn[i] = false; }
      }
      if pf_burning(s, i) != s[0].wv.room_pburn[i] {
        s[0].wv.room_pburn[i] = pf_burning(s, i);
        eg_room_put(s, 4, i, ifx s[0].wv.room_pburn[i] then 1.0f32 else 0.0f32, c.x, c.z);
      }
    }
  }
  // breaking the town's pieces is a crime, as on a page (watch_spell): the last caster's, or, when a
  // fire ate through one this step, whoever started that fire (the raid's: no one's, #12920)
  if s[0].wv.room_ev_n > 0 && s[0].wv.room_ev[0] == 1 {
    piece:=cast(int)s[0].wv.room_ev[1];p := w[0].pieces[piece];
    by:=ifx s[0].wv.room_break_at[piece]==s[0].wv.room_break_step then s[0].wv.room_break_by[piece] else ifx v[0].broke_by!=FI_CASTER then v[0].broke_by else s[0].wv.room_by;
    _ := everglade_room_crime(s,by,p.cx,p.cz);
  }
  return s[0].wv.room_ev_n;
}
eg_room_put :: (s: [] Everglade, kind: int, i: int, a: f32, b: f32, c: f32) {
  q := s[0].wv.room_ev_n;
  if q >= EG_ROOM_EVENTS { return; }
  o := q * EG_ROOM_EV_FLOATS;
  s[0].wv.room_ev[o] = f32(kind); s[0].wv.room_ev[o + 1] = f32(i); s[0].wv.room_ev[o + 2] = a; s[0].wv.room_ev[o + 3] = b; s[0].wv.room_ev[o + 4] = c;
  s[0].wv.room_ev_n = q + 1;
}
// Event q (EG_ROOM_EV_FLOATS), and where its piece stands (x, z) after them.
everglade_room_event :: (s: [] Everglade, q: int, out: [] f32) -> bool #export_c #effects(all) {
  if q < 0 || q >= s[0].wv.room_ev_n || out.count < EG_ROOM_EV_FLOATS + 2 { return false; }
  for k: 0..<EG_ROOM_EV_FLOATS { out[k] = s[0].wv.room_ev[q * EG_ROOM_EV_FLOATS + k]; }
  // a Repair's (3: at A B C), a placed thing's (4, 5: at B C), else a piece's
  if out[0] == 3 { out[5] = out[2]; out[6] = out[4]; return true; }
  if out[0] == 4 || out[0] == 5 { out[5] = out[3]; out[6] = out[4]; return true; }
  p := sp_dm(s)[0].pieces[cast(int) out[1]];
  out[5] = p.cx; out[6] = p.cz;
  return true;
}
// R: every piece stands again and the fires go out, and the fallen of the town stand up (watch_restore).
everglade_room_rebuild :: (s: [] Everglade) #export_c #effects(all) {
  if sp_on(s) { _ := sp_restore(s, -1); eg_room_known(s); }
  if s[0].wv.started { _ := watch_restore(watch_w(s)); }
}
// A new room in this world's slot: the town whole again, everyone on their day, no player known.
EG_TALK_LET_GO :: 8.0;    // m: a seat this far from who it talks to has let them go
// Seat p talks to townsperson i (-1: stops talking), standing at (x, z): false when they are not there
// or too far (TALK_NEAR and a metre and a half the page's view of you may be off).
everglade_room_talk :: (s: [] Everglade, p: int, i: int, x: f32, z: f32) -> bool #export_c #effects(all) {
  if p < 0 || p >= WATCH_YOUS { return false; }
  if i < 0 { s[0].wv.room_talk[p] = -1; return true; }
  if i >= EG_SPOTS || eg_gone(s[0].ev.edits, i) || EG_SPOT_CAT[i] { return false; }
  dx := s[0].folk[i].x - x; dz := s[0].folk[i].z - z;
  r := f32(TALK_NEAR) + 1.5f32;
  if dx * dx + dz * dz > r * r { return false; }
  s[0].wv.room_talk[p] = i;
  return true;
}
everglade_room_fresh :: (s: [] Everglade) #export_c #effects(all) {
  if !s[0].started { everglade_start(s); }
  if s[0].wv.started { watch_start(watch_w(s), s[0].heights[..]); }
  for p: 0..<WATCH_YOUS { s[0].wv.room_live[p] = false; s[0].wv.room_dead[p] = false; s[0].wv.room_talk[p] = -1; }
  if sp_on(s) {
    for q: 0..<SP_METEORS * 2 { s[0].sp.meteors[q].live = false; }
    s[0].sp.bolt.live = false; s[0].sp.orb_live = false;
    eg_ra_fresh(s);   // the room before's abilities stop here (everglade-room-abilities.coax)
    _ := sp_restore(s, -1); eg_room_known(s);
  }
  for i: 0..<EG_DOORS { s[0].doors.d[i].open = false; s[0].doors.d[i].t = 0; }   // every door shut (everglade-doors.coax)
}
// The room server steps seat p's movement next (room-world.c world_step): the conditions, the slow and
// the throw everglade_move_world reads are theirs.
everglade_room_seat :: (s: [] Everglade, p: int) #export_c #effects(all) { s[0].wt[0].me = clamp_w(p, 0, WATCH_YOUS - 1); }
// Seat p held by the watch's Hold Person (a scripted hold: oa-room room-control.coax "hold", #12886):
// HOLD_FOR seconds and its saves already made, so it ends then in every room it is laid in.
everglade_room_hold :: (s: [] Everglade, p: int) #export_c #effects(all) {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS || s[0].wt[0].yous[p].dead { return; }
  s[0].wt[0].yous[p].held_t = f32(HOLD_FOR); s[0].wt[0].yous[p].held_saves = HOLD_SAVES;
}
// The world's dice, its spells' (the saves its copies of the seats' abilities roll) and its watch's:
// fixed (each die on half its faces, verse/rules/srd5.coax SrdDice.fixed) while the room's are, a
// local room told "dice fixed" (oa-room room-control.coax), or not.
everglade_room_dice :: (s: [] Everglade, fixed: bool) #export_c #effects(all) {
  s[0].sp.dice[0].fixed = fixed; s[0].wt[0].dice[0].fixed = fixed;
}
// Seat p's conditions from the watch (WC_*): Hold Person's hold, Ray of Frost's slow.
// Seat p's watch effect's seconds left, by its cause (everglade-wire.coax WE_*: Hold Person, Earthbind,
// Ray of Frost); 0 when it holds none (the room's WK_EFFECT rows, room-everglade.coax).
everglade_room_cond_left :: (s: [] Everglade, p: int, cause: int) -> f32 #export_c #effects(all) {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS { return 0; }
  y := s[0].wt[0].yous[p];
  if y.dead { return 0; }
  return ifx cause == WE_HOLD_PERSON then y.held_t else ifx cause == WE_EARTHBIND then y.bound_t else ifx cause == WE_RAY_OF_FROST then y.slow_t else 0;
}
everglade_room_cond :: (s: [] Everglade, p: int) -> int #export_c #effects(all) {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS { return 0; }
  y := s[0].wt[0].yous[p];
  if y.dead { return 0; }
  return (ifx y.held_t > 0 then WC_PARALYZED else 0) | (ifx y.slow_t > 0 then WC_SLOWED else 0) | (ifx y.bound_t > 0 then WC_BOUND else 0);
}
#test "room town: the raid's Fireball (by no seat) setting the town alight is no player's crime; a seat's is that seat's (#12916)" #steps 20000000000 {
  for who: 0..<2 {
    g: [1] Everglade; dm: [1] DemoWorld;
    walled := everglade_walls(g[..]);   // as the room's world starts (coax/web/room/room-world.c)
    everglade_room_spells_start(g[..], dm[..], "");
    for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes
    seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
    everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
    #assert walled >= 0 && g[0].wv.started && watch_on(g[..]);
    // a wooden piece of the town to aim at
    w := sp_dm(g[..]);
    at := v3(0, 0, 0); found := false;
    for i: 0..<w[0].n { p := w[0].pieces[i]; if p.state == DP_STANDING && fi_fuel(p) > 0.5 { at = v3(p.cx, p.y0 + 1, p.cz); found = true; break; } }
    #assert found;
    by := ifx who == 0 then -1 else 0;
    for k: 0..<3 {
      everglade_room_strike(g[..], by, WL_SLOT0 + WL_FIREBALL, at.x, at.y + 9, at.z - 2, at.x, at.y, at.z, 7 + k);
      for t: 0..<60 { _ := everglade_room_spells(g[..], 1.0 / 30); }
    }
    crimes := g[0].wt[0].yous[0].crimes;
    #assert ifx who == 0 then crimes == 0 && everglade_room_wanted(g[..], 0) == 0 else crimes > 0;
  }
}
// A fire set by `by` (-1 the raid), then a cast by `next_by` (any cast makes its caster the step's last), and
// the fire burning on, spreading, breaking what it eats through, its embers catching more: seat 0's crimes
// before the second cast and after the burning (#12920).
eg_fire_blame :: (by: int, next_by: int, out: [] int) {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes
  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  w := sp_dm(g[..]);
  at := v3(0, 0, 0); found := false;
  for i: 0..<w[0].n { p := w[0].pieces[i]; if p.state == DP_STANDING && fi_fuel(p) > 0.5 { at = v3(p.cx, p.y0 + 1, p.cz); found = true; break; } }
  #assert walled >= 0 && found;
  // seat 0 sits 15 m off, where the watch can see them
  seats[0] = at.x + 15; seats[1] = ground_at(g[..], at.x + 15, at.z); seats[2] = at.z; seats[3] = 2; seats[4] = 10; seats[5] = 10;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 1, took[..]);
  #assert g[0].wv.room_live[0];
  everglade_room_strike(g[..], by, WL_SLOT0 + WL_FIREBALL, at.x, at.y + 9, at.z - 2, at.x, at.y, at.z, 7);
  for t: 0..<20 { _ := everglade_room_spells(g[..], 0.1); }
  #assert fi_count(g[..]) > 0;
  g[0].wv.room_by = next_by;
  out[0] = g[0].wt[0].yous[0].crimes;
  for t: 0..<90 { _ := everglade_room_spells(g[..], 1.0); }
  out[1] = g[0].wt[0].yous[0].crimes;
}
#test "room town: the raid's fire, still spreading after seat 0 casts, is not seat 0's crime (#12920)" #steps 20000000000 {
  c: [2] int;
  eg_fire_blame(-1, 0, c[..]);
  #assert c[0] == 0 && c[1] == 0;
}
#test "room town: seat 0's fire, still spreading after the raid casts, is still seat 0's crime (#12920)" #steps 20000000000 {
  c: [2] int;
  eg_fire_blame(0, -1, c[..]);
  #assert c[1] > c[0];
}
#test "room town: a seat talks to a townsperson only within reach, they face that seat, and walking off lets them go" #steps 2000000000 {
  g: [1] Everglade;
  everglade_room_fresh(g[..]);
  i := -1;
  for q: 0..<EG_SPOTS { if !EG_SPOT_CAT[q] && !eg_gone(g[0].ev.edits, q) { i = q; break; } }
  #assert i >= 0;
  // the town runs a tick with nobody there first (where they are at this hour), as a room does
  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  fx := g[0].folk[i].x; fz := g[0].folk[i].z;
  #assert !everglade_room_talk(g[..], 0, i, fx + 20, fz);   // too far
  #assert everglade_room_talk(g[..], 0, i, fx + 1.5, fz) && g[0].wv.room_talk[0] == i;
  seats[0] = fx + 1.5; seats[1] = 0; seats[2] = fz; seats[3] = 1; seats[4] = 10; seats[5] = 10;
  for t: 0..<30 { everglade_room_town(g[..], 1.0 / 30.0, 1000.0 + f64(t) / 30.0, seats[..], 1, took[..]); }
  #assert g[0].wv.room_talk[0] == i && g[0].folk[i].facing;
  // the seat walks 20 m off: the talk is over
  seats[0] = g[0].folk[i].x + 20;
  everglade_room_town(g[..], 1.0 / 30.0, 1002.0, seats[..], 1, took[..]);
  #assert g[0].wv.room_talk[0] == -1;
  #assert everglade_room_talk(g[..], 0, i, fx, fz) && everglade_room_talk(g[..], 0, -1, 0, 0) && g[0].wv.room_talk[0] == -1;
}

#test "watch: a fall seen again, or late, is where its time says; a fall just begun plays from its start (#12862)" #steps 4000000000 {
  g: [1] Everglade;
  people_load(g[0].people_rig[..]);
  rig := people_rig(g[0].people_rig[..], false);
  out: [PEOPLE_JOINTS * 12] f32;
  d := rig.duration[PEOPLE_DIE];
  #assert d > 0.5;
  // dead 5 s, posed fresh (the edge of the view, or a page come late): lying, the clip at its end
  sk: [1] Skin;
  watch_pose(rig, Actor.{mode = WM_DEAD, t = 5, clip = PEOPLE_DIE, hold = true, body = Tumble.{settle = -1}}, sk[..], 1.0 / 60, out[..]);
  #assert sk[0].clip == PEOPLE_DIE && sk[0].time > d - 0.1;
  watch_pose(rig, Actor.{mode = WM_DEAD, t = 5.02, clip = PEOPLE_DIE, hold = true, body = Tumble.{settle = -1}}, sk[..], 1.0 / 60, out[..]);
  #assert sk[0].time > d - 0.1;   // and stays there
  // 0.3 s into the fall: mid-fall
  sk2: [1] Skin;
  watch_pose(rig, Actor.{mode = WM_DEAD, t = 0.3, clip = PEOPLE_DIE, hold = true, body = Tumble.{settle = -1}}, sk2[..], 1.0 / 60, out[..]);
  #assert abs(sk2[0].time - 0.3) < 0.02;
  // just fallen: from its start
  sk3: [1] Skin;
  watch_pose(rig, Actor.{mode = WM_DEAD, t = 0.05, clip = PEOPLE_DIE, hold = true, body = Tumble.{settle = -1}}, sk3[..], 1.0 / 60, out[..]);
  #assert sk3[0].time < 0.05;
}

#test "watch: words and numbers rise over heads: a condition's word as it lands, -N lost, +N healed, UP from down (#12862)" #steps 2000000000 {
  g: [1] Everglade;
  g[0].wv.started = true;
  watch_pop(g[..], v3(0, 2, 0), 6, false);
  watch_pop_heal(g[..], v3(0, 2, 0), 4);
  st_pop_words(g[..], v3(0, 2, 0), WC_UNCONSCIOUS | WC_PRONE | WC_BOUND);
  n := 0; down := false; root := false; prone := false; lost := false; healed := false;
  for q: 0..<WATCH_POPS {
    p := g[0].wv.pops[q];
    if !p.live { continue; }
    n += 1;
    if p.word == POP_DOWN { down = true; }
    if p.word == POP_ROOTED { root = true; }
    if p.word == POP_PRONE { prone = true; }
    if p.word < 0 && !p.heal && p.amount == 6 { lost = true; }
    if p.word < 0 && p.heal && p.amount == 4 { healed = true; }
  }
  #assert n == 4 && down && root && !prone && lost && healed;   // down says prone
  #assert POP_WORDS[POP_ROOTED] == "ROOTED" && f32(POP_LIFE) == 1.2;
  // one word over a head while it lasts: the strongest
  #assert st_head_word(WC_PRONE | WC_UNCONSCIOUS) == POP_DOWN && st_head_word(WC_BOUND | WC_PRONE) == POP_ROOTED && st_head_word(WC_STUNNED | WC_BOUND) == POP_STUNNED;
  #assert st_head_word(WC_PARALYZED | WC_STUNNED) == POP_HELD && st_head_word(16) == POP_FRIGHTENED && st_head_word(0) == -1;
}
// Seat 0 raises a Wall of Fire across a guard, then seat 1 casts (the step's last caster): each round
// the wall burns the guard is seat 0's doing, its crimes and heat, never seat 1's (#12923).
#test "room town: a Wall of Fire burning on after another seat casts is its caster's crime, not the last caster's (#12923)" #steps 20000000000 {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes
  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  w := watch_w(g[..]);
  i := -1;
  for q: 0..<WATCH_ACTORS { if i < 0 && watch_is_guard(q) && watch_here(w, q) && w[0].actors[q].mode != WM_DEAD { i = q; } }
  #assert walled >= 0 && i >= 0;
  at := wd_feet(g[..], i);
  // seat 0 stands 12 m off the guard; seat 1 far off across the town
  seats[0] = at.x + 12; seats[1] = ground_at(g[..], at.x + 12, at.z); seats[2] = at.z; seats[3] = 2; seats[4] = 100000; seats[5] = 100000;
  seats[7] = at.x - 80; seats[8] = ground_at(g[..], at.x - 80, at.z); seats[9] = at.z; seats[10] = 2; seats[11] = 100000; seats[12] = 100000;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 2, took[..]);
  #assert g[0].wv.room_live[0] && g[0].wv.room_live[1];
  everglade_room_ability_mode(g[..], 0, AB_WALLFIRE, seats[0], seats[1], seats[2], 0, true, at.x, at.y, at.z, 0);
  #assert g[0].sp.room_ab[0].seat[0].wd[0].wf_on && w[0].yous[0].heat > 0;
  w[0].yous[0].crimes = 0; w[0].yous[0].heat = 0; w[0].yous[1].crimes = 0; w[0].yous[1].heat = 0;
  g[0].wv.room_by = 1;   // seat 1 casts after it
  h0 := 0; h1 := 0; c0 := 0; c1 := 0;
  for t: 0..<120 {
    everglade_room_town(g[..], 0.1, 1000.2 + f64(t) * 0.1, seats[..], 2, took[..]);
    // the guard stays in the flames
    w[0].actors[i].x = at.x; w[0].actors[i].z = at.z;
    if i < EG_SPOTS { g[0].folk[i].x = at.x; g[0].folk[i].z = at.z; g[0].folk[i].indoors = false; }
    everglade_room_abilities(g[..], 0.1);
    _ := everglade_room_spells(g[..], 0.1);
    h0 = hi_w(h0, w[0].yous[0].heat); h1 = hi_w(h1, w[0].yous[1].heat); c0 = hi_w(c0, w[0].yous[0].crimes); c1 = hi_w(c1, w[0].yous[1].crimes);
  }
  #assert g[0].sp.room_ab[0].seat[0].wd[0].wf_next[i] > 7;   // it burned them again
  #assert h0 > 0 && c0 > 0 && h1 == 0 && c1 == 0;
}
// A fire seat 0 set (what its Wall of Fire, Fireball or any fire spell lights), burning a guard who
// stands against it after seat 1 casts: the burn's heat is seat 0's, not the step's last caster's (#12923).
#test "room town: seat 0's fire burning a guard after seat 1 casts raises seat 0's heat, not seat 1's (#12923)" #steps 20000000000 {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes
  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  w := watch_w(g[..]);
  d := sp_dm(g[..]);
  at := v3(0, 0, 0); pc := -1;
  for q: 0..<d[0].n { p := d[0].pieces[q]; if pc < 0 && p.state == DP_STANDING && fi_fuel(p) > 0.5 { at = v3(p.cx, p.y0 + 1, p.cz); pc = q; } }
  i := -1;
  for q: 0..<WATCH_ACTORS { if i < 0 && watch_is_guard(q) && watch_here(w, q) && w[0].actors[q].mode != WM_DEAD { i = q; } }
  #assert walled >= 0 && pc >= 0 && i >= 0;
  seats[0] = at.x + 15; seats[1] = ground_at(g[..], at.x + 15, at.z); seats[2] = at.z; seats[3] = 2; seats[4] = 100000; seats[5] = 100000;
  seats[7] = at.x - 80; seats[8] = ground_at(g[..], at.x - 80, at.z); seats[9] = at.z; seats[10] = 2; seats[11] = 100000; seats[12] = 100000;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 2, took[..]);
  everglade_room_strike(g[..], 0, WL_SLOT0 + WL_FIREBALL, at.x, at.y + 9, at.z - 2, at.x, at.y, at.z, 7);
  for t: 0..<20 { _ := everglade_room_spells(g[..], 0.1); }
  #assert fi_count(g[..]) > 0;
  g[0].wv.room_by = 1;   // seat 1 casts: the step's last caster
  w[0].yous[0].heat = 0; w[0].yous[1].heat = 0;
  h0 := 0; h1 := 0;
  p := d[0].pieces[fi_of(g[..])[0].burn[0].piece];
  for t: 0..<60 {
    // the guard stands against the burning piece
    if i < EG_SPOTS { g[0].folk[i].x = p.cx; g[0].folk[i].z = p.cz; g[0].folk[i].indoors = false; }
    w[0].actors[i].x = p.cx; w[0].actors[i].z = p.cz;
    _ := everglade_room_spells(g[..], 0.1);
    h0 = hi_w(h0, w[0].yous[0].heat); h1 = hi_w(h1, w[0].yous[1].heat);
  }
  #assert h0 > 0 && h1 == 0;
}
// Seat 0's Fireball sets a piece alight, then `casters` other seats each hold a Levitate up far off
// across the town (their copies run every step); the fire burning on for 12 s: its clock, the pieces
// alight, their burn times and soot (#12933).
eg_fire_casters :: (casters: int, out: [] f32) {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes
  seats: [EG_ROOM_SEAT_FLOATS * 4] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  w := sp_dm(g[..]);
  at := v3(0, 0, 0); pc := -1;
  for q: 0..<w[0].n { p := w[0].pieces[q]; if pc < 0 && p.state == DP_STANDING && fi_fuel(p) > 0.5 { at = v3(p.cx, p.y0 + 1, p.cz); pc = q; } }
  #assert walled >= 0 && pc >= 0;
  for q: 0..<4 {
    o := q * EG_ROOM_SEAT_FLOATS; x := at.x + 15 + f32(q) * 60;
    seats[o] = x; seats[o + 1] = ground_at(g[..], x, at.z); seats[o + 2] = at.z; seats[o + 3] = 2; seats[o + 4] = 100000; seats[o + 5] = 100000;
  }
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 4, took[..]);
  everglade_room_strike(g[..], 0, WL_SLOT0 + WL_FIREBALL, at.x, at.y + 9, at.z - 2, at.x, at.y, at.z, 7);
  for t: 0..<20 { _ := everglade_room_spells(g[..], 0.1); }
  #assert fi_count(g[..]) > 0;
  for q: 1..<casters + 1 {
    o := q * EG_ROOM_SEAT_FLOATS;
    everglade_room_ability_mode(g[..], q, AB_LEVITATE, seats[o], seats[o + 1], seats[o + 2], 0, true, seats[o], seats[o + 1], seats[o + 2], 0);
    #assert g[0].sp.room_ab[0].seat[q].used;
  }
  for t: 0..<20 {
    everglade_room_abilities(g[..], 0.6);
    _ := everglade_room_spells(g[..], 0.6);
  }
  for q: 1..<casters + 1 { #assert g[0].sp.room_ab[0].seat[q].live[AB_LEVITATE]; }   // they held it up throughout
  v := fi_of(g[..]);
  out[0] = v[0].time; out[1] = f32(v[0].n); out[2] = v[0].soot[pc];
  out[3] = 0; out[4] = 0;
  for k: 0..<v[0].n { out[3] += v[0].burn[k].t; out[4] += f32(v[0].burn[k].piece); }
}
#test "room town: the town's fires burn and spread the same with 0 or 1 casters holding a lasting spell up (#12933)" #steps 60000000000 {
  a: [5] f32; b: [5] f32;
  eg_fire_casters(0, a[..]); eg_fire_casters(1, b[..]);
  #assert a[0] > 13.9 && a[0] < 14.1;   // 20 steps of 0.1 s and 20 of 0.6 s: once a tick
  for q: 0..<5 { #assert a[q] == b[q]; }
}
#test "room town: the town's fires burn and spread the same with 0 or 3 casters holding a lasting spell up (#12933)" #steps 60000000000 {
  a: [5] f32; c: [5] f32;
  eg_fire_casters(0, a[..]); eg_fire_casters(3, c[..]);
  for q: 0..<5 { #assert a[q] == c[q]; }
}
// Seat 0's fire burns a guard who stands against it, the room's rules beside the world as the room server
// runs them (coax/web/room/room-tick.c): each tick the abilities' step hands its harm to the rules
// (everglade_room_hurt: rm_ra_hurt, e5rr_hurt), then the rules' Hit Points go to the world
// (everglade_room_folk_hp) before the town and its fire step. Every burn reaches the rules as seat 0's,
// and the rules and the world hold the same Hit Points, down to the guard's death (#12934).
#test "room town: the town's fire burning a townsperson goes through the rules: they and the world agree on their Hit Points and death (#12934)" #steps 60000000000 {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes

  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  w := watch_w(g[..]);
  d := sp_dm(g[..]);
  at := v3(0, 0, 0); pc := -1;
  for q: 0..<d[0].n { p := d[0].pieces[q]; if pc < 0 && p.state == DP_STANDING && fi_fuel(p) > 0.5 { at = v3(p.cx, p.y0 + 1, p.cz); pc = q; } }
  i := -1;
  for q: 0..<WATCH_ACTORS { if i < 0 && watch_is_guard(q) && watch_here(w, q) && w[0].actors[q].mode != WM_DEAD { i = q; } }
  #assert walled >= 0 && pc >= 0 && i >= 0;
  seats[0] = at.x + 15; seats[1] = ground_at(g[..], at.x + 15, at.z); seats[2] = at.z; seats[3] = 2; seats[4] = 100000; seats[5] = 100000;
  seats[7] = at.x - 80; seats[8] = ground_at(g[..], at.x - 80, at.z); seats[9] = at.z; seats[10] = 2; seats[11] = 100000; seats[12] = 100000;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 2, took[..]);
  everglade_room_strike(g[..], 0, WL_SLOT0 + WL_FIREBALL, at.x, at.y + 9, at.z - 2, at.x, at.y, at.z, 7);
  for t: 0..<20 { _ := everglade_room_spells(g[..], 0.1); }
  #assert fi_count(g[..]) > 0;
  g[0].wv.room_by = 1;   // seat 1 casts after it: the step's last caster
  // the rules' Hit Points for the guard (a stand-in for the room's: e5rr_hurt takes what is dealt)
  w[0].actors[i].hp = 12; w[0].actors[i].temp = 0;
  rules := 12; burns := 0; hurts := 0;
  for t: 0..<90 {
    // the abilities' step: its harm to the rules
    everglade_room_abilities(g[..], 1.0);
    h: [3] f32;
    for q: 0..<everglade_room_hurts(g[..]) {
      #assert everglade_room_hurt(g[..], q, h[..]);
      if cast(int) h[0] != i { continue; }
      #assert cast(int) h[2] == 0;   // seat 0's fire, though seat 1 cast last
      if rules > 0 { rules = hi_w(rules - cast(int) h[1], 0); }
      hurts += 1;
    }
    // the rules and the world agree before the rules' Hit Points go back to it
    #assert w[0].actors[i].hp == rules;
    #assert (w[0].actors[i].mode == WM_DEAD) == (rules == 0);
    if rules > 0 { everglade_room_folk_hp(g[..], i, rules, 0, -1); }
    // the guard stands against what still burns
    v := fi_of(g[..]);
    if v[0].n > 0 {
      p := d[0].pieces[v[0].burn[0].piece];
      if i < EG_SPOTS { g[0].folk[i].x = p.cx; g[0].folk[i].z = p.cz; g[0].folk[i].indoors = false; }
      w[0].actors[i].x = p.cx; w[0].actors[i].z = p.cz;
    }
    before := w[0].actors[i].hp;
    _ := everglade_room_spells(g[..], 1.0);
    if w[0].actors[i].hp < before { burns += 1; }
    // after the first burn (and the rules have it), they are left at 1 Hit Point in both, so the next kills
    if burns == 1 && hurts == 1 && w[0].actors[i].hp == rules && rules > 1 { w[0].actors[i].hp = 1; rules = 1; }
  }
  #assert burns >= 2 && hurts == burns;
  #assert rules == 0 && w[0].actors[i].mode == WM_DEAD;   // burnt to death, in the rules as in the world
}
// Seat 0 lights a tree, seat 1 casts after it (the step's last caster), and the fire spreads from tree to
// tree: every tree it reaches burns as seat 0's, and what it does is seat 0's crime, never seat 1's (#12935).
#test "room town: the actual room tick burns and spreads trees as their starter's crime (#12940)" #steps 6000000000 {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes

  // Two small, dry trees outside the west palisade, with touching crowns. The real room tick is
  // the only simulation entry below: calling tf_frame here would hide the missing server step.
  g[0].tree_n = 2;
  put_tree(g[0].trees[..], 0, -80, -15, 0.6, 0, 0);
  put_tree(g[0].trees[..], 1, -78.5, -15, 0.6, 0, 0);
  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  seats[0] = -80; seats[1] = ground_at(g[..], -80, -10); seats[2] = -10; seats[3] = 2; seats[4] = 100000; seats[5] = 100000;
  seats[7] = 100; seats[8] = ground_at(g[..], 100, 100); seats[9] = 100; seats[10] = 2; seats[11] = 100000; seats[12] = 100000;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 2, took[..]);
  #assert walled >= 0 && !fr_wet(g[..], -80, -15) && !fr_wet(g[..], -78.5, -15);
  g[0].sky.rain = 0;
  wt := watch_w(g[..]); wt[0].me = 0;
  #assert tf_ignite(g[..], 0);
  wt[0].yous[0].crimes = 0; wt[0].yous[1].crimes = 0;
  g[0].wv.room_by = 1; wt[0].me = 1;
  spread := false;
  for tick: 0..<1800 {
    events := everglade_room_spells(g[..], 1.0 / 30.0);
    #assert events >= 0;
    v := tf_of(g[..]);
    if v[0].lit > 1 { spread = true; }
    for k: 0..<v[0].n { #assert v[0].burn[k].by == 0; }
  }
  v := tf_of(g[..]); k := tf_k(g[..], 0);
  #assert spread && v[0].soot[k] == 1 && v[0].bare[k] == 1;
  #assert v[0].mode[k] == TF_DOWN && !tf_burning(g[..], 0);
  #assert wt[0].yous[0].crimes > 0 && wt[0].yous[1].crimes == 0;
}
#test "room town: a tree fire spreading to the next tree stays its starter's, not the last caster's (#12935)" #steps 60000000000 {
  g: [1] Everglade; dm: [1] DemoWorld;
  walled := everglade_walls(g[..]);
  everglade_room_spells_start(g[..], dm[..], "");
  for seat:0..<WATCH_YOUS {everglade_room_seat_owner(g[..],seat,ev_seat_reference(seat,1).value);} // the standalone world has the host's first character lifetimes

  seats: [EG_ROOM_SEAT_FLOATS * 2] f32; took: [WATCH_YOUS * 2] f32;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.0, seats[..], 0, took[..]);
  #assert walled >= 0 && g[0].tree_n > 1;
  // a tree whose crown touches another's, so its fire has somewhere to go
  v := tf_of(g[..]);
  lit := -1;
  for t: 0..<g[0].tree_n {
    if lit >= 0 { break; }
    o := t * TREE_FLOATS;
    for j: 0..<g[0].tree_n {
      p := j * TREE_FLOATS;
      if j != t && abs(g[0].trees[p] - g[0].trees[o]) < 3 && abs(g[0].trees[p + 1] - g[0].trees[o + 1]) < 3 { lit = t; break; }
    }
  }
  #assert lit >= 0;
  o := lit * TREE_FLOATS;
  // seat 0 by the tree, seat 1 far off
  seats[0] = g[0].trees[o] + 20; seats[1] = ground_at(g[..], seats[0], g[0].trees[o + 1]); seats[2] = g[0].trees[o + 1]; seats[3] = 2; seats[4] = 100000; seats[5] = 100000;
  seats[7] = g[0].trees[o] - 120; seats[8] = ground_at(g[..], seats[7], g[0].trees[o + 1]); seats[9] = g[0].trees[o + 1]; seats[10] = 2; seats[11] = 100000; seats[12] = 100000;
  everglade_room_town(g[..], 1.0 / 30.0, 1000.1, seats[..], 2, took[..]);
  g[0].sky.rain = 0;
  // seat 0's fire takes the tree (the step's caster is the watch's player: everglade_room_spells)
  wt := watch_w(g[..]);
  wt[0].me = 0;
  #assert tf_ignite(g[..], lit) && v[0].burn[0].by == 0;
  g[0].wv.room_by = 1; wt[0].me = 1;   // seat 1 casts after it: the step's last caster
  wt[0].yous[1].crimes = 0;
  spread := 0;
  for t: 0..<2400 {
    tf_frame(g[..], 0.25);
    for k: 0..<v[0].n { #assert v[0].burn[k].by == 0; }
    spread = hi_w(spread, v[0].lit - 1);
  }
  #assert spread > 0;   // it reached another tree
  #assert wt[0].yous[1].crimes == 0;
}
