#test "watch: the Priest's Spiritual Weapon is one lit mace by you, its head on its haft's end, nothing drawn as flat glow" #steps 530000000 {
  g: [1] Everglade;
  everglade_start(g[..]);
  boxes := g[0].counts[SHAPE_BOX]; balls := g[0].counts[SHAPE_SPHERE];
  at := v3(3, 2, 4);
  for k: 0..<3 {
    watch_mace(g[..], at, 1.5 - f32(k) * 0.6);   // hanging, then winding up to its blow
    #assert g[0].counts[SHAPE_BOX] == boxes + 3 && g[0].counts[SHAPE_SPHERE] == balls + 2;
    haft := (SLOT_AT[SHAPE_BOX] + boxes) * OBJECT_FLOATS;
    head := (SLOT_AT[SHAPE_SPHERE] + balls) * OBJECT_FLOATS;
    // the head sits on the haft's end: 0.36 m along it from the haft's middle, the way the haft points
    hc := v3(g[0].objects[haft + 3], g[0].objects[haft + 7], g[0].objects[haft + 11]);
    up := v3(g[0].objects[haft + 1], g[0].objects[haft + 5], g[0].objects[haft + 9]);   // its long axis, 0.62 m
    hd := v3(g[0].objects[head + 3], g[0].objects[head + 7], g[0].objects[head + 11]);
    #assert abs(length(sub(hd, hc)) - 0.36) < 0.01 && dot(sub(hd, hc), up) > 0.35 * 0.62 * 0.95;
    #assert length(sub(hc, at)) < 0.1;
    for n: 0..<3 { #assert cast(int) g[0].objects[(SLOT_AT[SHAPE_BOX] + boxes + n) * OBJECT_FLOATS + 15] / 8 != LOOK_FLAME; }
    for n: 0..<2 { #assert cast(int) g[0].objects[(SLOT_AT[SHAPE_SPHERE] + balls + n) * OBJECT_FLOATS + 15] / 8 != LOOK_FLAME; }
    g[0].counts[SHAPE_BOX] = boxes; g[0].counts[SHAPE_SPHERE] = balls;
  }
}

#test "watch: R (the town stands again) also clears your WANTED stars" #steps 530000000 {
  g: [1] Everglade;
  everglade_start(g[..]);
  watch_page_start(g[..]);
  w := watch_w(g[..]);
  watch_you(w[..])[0].wanted = true; watch_you(w[..])[0].level = 5; watch_you(w[..])[0].heat = 40;
  _ := watch_rebuilt(g[..]);
  #assert !watch_you(w[..])[0].wanted && watch_you(w[..])[0].level == 0 && watch_you(w[..])[0].heat == 0;
}

// ---- the room server's town (coax/web/room/room-world.c; GitHub #12713)
// The server's headless Everglade runs the town for a room's players: everyone's day, the watch
// stepped against every seat (watch_tick_room: each hunter after their own foe), their crimes and
// WANTED. The room's SRD 5e rules (everglade5e-room-rules.coax) keep Hit Points, the seats' and the
// people's; this town takes them back each tick, and hands the rules where the people are and the
// damage its guards deal the seats.
EG_ROOM_SEAT_FLOATS :: 7;      // a seat as the host hands it: X Y Z LIVE HP MAX COND (LIVE 2 just sat; HP 0: dead; COND WC_*)
EG_ROOM_VIEW_FLOATS :: 7;      // a person as a page hears them (wire f): X Z YAW CLIP MODE HP SHOWN
EG_ROOM_HEAR :: 60.0;          // m a crime carries (the bolt's: everglade-spells.coax WATCH_HEAR)

// One tick of the town, dt s, the shared clock at `world` s. seats: EG_ROOM_SEAT_FLOATS for each of n.
// took[p]: the Hit Points the watch's blows took from seat p this tick (for the room's rules), and
// took[WATCH_YOUS + p] who dealt them: the nearest of the town hunting p (a watch actor, -1 none).
everglade_room_town :: (s: [] Everglade, dt: f32, world: f64, seats: [] f32, n: int, took: [] f32) #export_c {
  if !s[0].started { everglade_start(s); }
  if !s[0].wv.started { watch_page_start(s); }
  w := watch_w(s);
  w[0].on = true; w[0].peace = false; w[0].unhurt = false;
  s[0].wv.server = true;
  c := FolkClock.{day = 0.5, length = f32(STYLE_CYCLE_SECONDS), world = world, turning = false, still = false};
  m := lo_w(lo_w(n, WATCH_YOUS), seats.count / EG_ROOM_SEAT_FLOATS);
  at: [WATCH_YOUS] Point; live: [WATCH_YOUS] bool; hp: [WATCH_YOUS] int;
  me := w[0].me;
  for p: 0..<m {
    o := p * EG_ROOM_SEAT_FLOATS;
    at[p] = v3(seats[o], seats[o + 1], seats[o + 2]);
    live[p] = seats[o + 3] > 0.5;
    hp[p] = cast(int) seats[o + 4];
    s[0].wv.room_cond[p] = cast(int) seats[o + 6];
    w[0].me = p;
    if live[p] && (!s[0].wv.room_live[p] || seats[o + 3] > 1.5) { watch_start_you(w); s[0].wv.room_dead[p] = false; }   // a new player: whole, unwanted
    s[0].wv.room_live[p] = live[p]; s[0].wv.room_at[p] = at[p];
    if !live[p] { continue; }
    y := watch_you(w[..]);
    dead := hp[p] <= 0;
    if s[0].wv.room_dead[p] && !dead { watch_stand_down(w); }   // risen: the watch forgets them
    s[0].wv.room_dead[p] = dead;
    // the rules' Hit Points are theirs; the watch's death is the rules' (the room raises them)
    y[0].max = hi_w(cast(int) seats[o + 5], 1); y[0].hp = hi_w(hp[p], 0); y[0].temp = 0;
    y[0].dead = dead; y[0].dead_t = 0; y[0].respawn = false;
  }
  // everyone's day: a spot's routine, a new guard's beat (turned to the nearest player)
  for i: 0..<EG_SPOTS {
    if eg_gone(s[0].ev.edits, i) || EG_SPOT_CAT[i] { continue; }
    near := eg_room_nearest(s, s[0].folk[i].x, s[0].folk[i].z, m);
    you := ifx near >= 0 then at[near] else FOLK_AWAY;
    folk_step(s[0].folk[i..<i + 1], i, dt, you, false, 1000.0f32, c, s[0].heights[..]);
    watch_home(w, i, s[0].folk[i].x, s[0].folk[i].z, s[0].folk[i].yaw, s[0].folk[i].indoors);
  }
  for k: 0..<WATCH_NEW {
    watch_new_place(s, k, c, dt);
    watch_home(w, EG_SPOTS + k, s[0].wv.at[k].x, s[0].wv.at[k].z, s[0].wv.at[k].yaw, false);
  }
  w[0].floor_n = eg_watch_floors(s, w);
  w[0].deck_out = sp_deck_out(s);   // the bridge's planks down: no deck there
  watch_tick_room(w, dt, c.day, at[0..<m], live[0..<m], s[0].boxes[..], s[0].box_n, s[0].heights[..]);
  for p: 0..<lo_w(m, took.count) {
    took[p] = 0;
    if !live[p] { continue; }
    w[0].me = p;
    y := watch_you(w[..]);
    if !s[0].wv.room_dead[p] { took[p] = f32(hi_w(hp[p] - y[0].hp, 0)); }
    if WATCH_YOUS + p < took.count {
      by := -1; bd := 1000000000.0f32;
      for i: 0..<WATCH_ACTORS {
        a := w[0].actors[i];
        if !watch_here(w, i) || a.foe != p || (a.mode != WM_CHASE && a.mode != WM_FIGHT) { continue; }
        d := (a.x - at[p].x) * (a.x - at[p].x) + (a.z - at[p].z) * (a.z - at[p].z);
        if d < bd { bd = d; by = i; }
      }
      took[WATCH_YOUS + p] = f32(by);
    }
    y[0].bound_said = 0;   // a throw stays for the seat's next step (everglade_knock)
  }
  w[0].me = me;
}
// The live seat nearest (x, z), or -1.
eg_room_nearest :: (s: [] Everglade, x: f32, z: f32, n: int) -> int {
  best := -1; bd := 1000000000.0f32;
  for p: 0..<n {
    if !s[0].wv.room_live[p] { continue; }
    dx := s[0].wv.room_at[p].x - x; dz := s[0].wv.room_at[p].z - z;
    if dx * dx + dz * dz < bd { bd = dx * dx + dz * dz; best = p; }
  }
  return best;
}
// The people for the room's rules: E5R_FOLK_FLOATS each (here, x, z, Hit Points, Temporary, most, AC,
// stat block), as the page's everglade5e.coax e5_folk hands them. How many.
everglade_room_people :: (s: [] Everglade, out: [] f32) -> int #export_c {
  if !s[0].started || !s[0].wv.started { return 0; }
  w := watch_w(s);
  n := 0;
  for i: 0..<WATCH_ACTORS {
    if (n + 1) * 8 > out.count { break; }
    o := n * 8;
    a := w[0].actors[i];
    out[o] = ifx watch_here(w, i) && !(a.mode == WM_CALM && a.home_in) then 1.0f32 else 0.0f32;
    pl := person_place(s, i);
    out[o + 1] = ifx a.body.on then a.body.x else pl.x; out[o + 2] = ifx a.body.on then a.body.z else pl.z;
    out[o + 3] = f32(a.hp); out[o + 4] = f32(a.temp); out[o + 5] = f32(a.max);
    st := watch_stats(w, i);
    out[o + 6] = f32(st.ac); out[o + 7] = f32(watch_block_of(st.name));
    n += 1;
  }
  return n;
}
// The stat block's number in the rules (everglade5e-rules.coax E5R_BLOCK_NAME).
watch_block_of :: (name: string) -> int {
  if name == "Commoner" { return 0; } if name == "Guard" { return 1; } if name == "Warrior Veteran" { return 2; }
  if name == "Mage" { return 3; } if name == "Knight" { return 4; } if name == "Priest" { return 5; }
  if name == "Archmage" { return 6; } if name == "Gladiator" { return 7; }
  return 1;
}
// Person i's Hit Points as the room's rules have them now: harm lands as the town's own does (knocked
// down, or dead), healing raises them. `by`: the seat that harmed them (-1 none), whom they turn on.
everglade_room_folk_hp :: (s: [] Everglade, i: int, hp: int, temp: int, by: int) #export_c {
  if !s[0].wv.started || i < 0 || i >= WATCH_ACTORS { return; }
  w := watch_w(s);
  if !watch_here(w, i) { return; }
  a := w[0].actors[i..<i + 1];
  lost := (a[0].hp + a[0].temp) - (hp + temp);
  if a[0].mode == WM_DEAD { return; }
  me := w[0].me;
  b := ifx by >= 0 && by < WATCH_YOUS then by else eg_room_nearest(s, a[0].x, a[0].z, WATCH_YOUS);
  if b < 0 { b = 0; }
  w[0].me = b;
  if lost > 0 { watch_harm(w, i, lost, s[0].wv.room_at[b]); }
  else if lost < 0 { a[0].hp = lo_w(hp, a[0].max); a[0].temp = temp; }
  w[0].me = me;
}
// Seat `by` harmed someone of the town at (x, z): a crime, heard EG_ROOM_HEAR m. How many guards turned.
everglade_room_crime :: (s: [] Everglade, by: int, x: f32, z: f32) -> int #export_c {
  if !s[0].wv.started || by < 0 || by >= WATCH_YOUS || !s[0].wv.room_live[by] { return 0; }
  w := watch_w(s);
  me := w[0].me;
  w[0].me = by;
  turned := watch_crime(w, v3(x, ground_at(s, x, z), z), f32(EG_ROOM_HEAR), s[0].wv.room_at[by], s[0].boxes[..], s[0].box_n, s[0].heights[..]);
  w[0].me = me;
  return turned;
}
// Person i as a page hears them (wire f, EG_ROOM_VIEW_FLOATS): X Z YAW CLIP MODE HP SHOWN. On their day
// CLIP is 1 walking, 0 standing; off it, the watch's clip. SHOWN 0: indoors, taken away or not called in.
everglade_room_view :: (s: [] Everglade, i: int, out: [] f32) -> bool #export_c {
  if !s[0].wv.started || i < 0 || i >= WATCH_ACTORS || out.count < EG_ROOM_VIEW_FLOATS { return false; }
  w := watch_w(s);
  a := w[0].actors[i];
  pl := person_place(s, i);
  off := watch_off(w, i);
  out[0] = ifx off then a.x else pl.x; out[1] = ifx off then a.z else pl.z; out[2] = ifx off then a.yaw else pl.face;
  out[3] = ifx off then f32(a.clip) else (ifx pl.walking then 1.0f32 else 0.0f32);
  out[4] = f32(ifx a.ready then a.mode else WM_CALM); out[5] = f32(a.hp);
  shown := watch_here(w, i) && !(a.mode == WM_CALM && a.home_in) && !(i < EG_SPOTS && s[0].folk[i].indoors && !off);
  out[6] = ifx shown then 1.0f32 else 0.0f32;
  return true;
}
// Seat p's WANTED level (0 not wanted).
everglade_room_wanted :: (s: [] Everglade, p: int) -> int #export_c {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS { return 0; }
  y := s[0].wt[0].yous[p];
  return ifx y.wanted then hi_w(y.level, 1) else 0;
}

// A page in a room whose server runs the town (everglade-net.coax net_town): everyone of the town is
// where the server has them (f), in its mode, clip and Hit Points; on their day a spot's person walks
// where it says and one not heard is indoors (or too far to draw); your WANTED level is the server's.
// The page's own watch does not step: no blows, crimes or waves of its own.
watch_net_frame :: (s: [] Everglade) {
  w := watch_w(s);
  for i: 0..<WATCH_ACTORS {
    if !watch_hurtable(i) { continue; }
    f := net_folk(s, i);
    a := w[0].actors[i..<i + 1];
    if !f.ok {
      if watch_is_rein(i) { a[0].homed = false; }
      else if i < EG_SPOTS { s[0].folk[i].indoors = true; a[0].mode = WM_CALM; }
      else { a[0].mode = WM_CALM; }
      continue;
    }
    if !a[0].ready { watch_revive(w, i); }
    a[0].homed = true;
    a[0].x = f.x; a[0].z = f.z; a[0].yaw = f.yaw; a[0].hp = f.hp;
    a[0].mode = f.mode; a[0].body.on = false;
    if f.mode == WM_CALM {
      if i < EG_SPOTS { s[0].folk[i].x = f.x; s[0].folk[i].z = f.z; s[0].folk[i].yaw = f.yaw; s[0].folk[i].walking = f.clip == 1; s[0].folk[i].indoors = false; }
      else if !watch_is_rein(i) { k := i - EG_SPOTS; s[0].wv.at[k].x = f.x; s[0].wv.at[k].z = f.z; s[0].wv.at[k].yaw = f.yaw; s[0].wv.at[k].walking = f.clip == 1; }
    } else {
      a[0].clip = f.clip; a[0].hold = f.mode == WM_DOWN || f.mode == WM_DEAD;
    }
  }
  y := watch_you(w[..]);
  level := net_wanted(s);
  y[0].wanted = level > 0; y[0].level = level; y[0].unseen = 0;
}

// ---- the room server's town breaking (GitHub #12713): the strikes of Everglade's own four spells
// (the meteors, the bolt, the mega bolt, the orb) fall on the server's town as on a page's, from the
// cast's seed; what breaks and what catches fire, and fire's own spreading and burning down, are the
// server's, and each page hears it (e break, e burn) and breaks and lights the same pieces.
EG_ROOM_EVENTS :: 96;
EG_ROOM_EV_FLOATS :: 5;   // KIND PIECE A B C: KIND 1 a break (A B C its throw, m/s), 2 alight (A 1 on, 0 out)

// The server's town gets its pieces: the storage for them, and the pack's catalog (their bounds).
everglade_room_spells_start :: (s: [] Everglade, dm: [] DemoWorld, catalog: string) #export_c {
  if !s[0].started { everglade_start(s); }
  s[0].sp.on = true; s[0].wv.net = true;
  eg_ra_server_start(s);
  everglade_attach_demolish(s, dm);
  spells_catalog(s, catalog);
  eg_room_known(s);
}
eg_room_known :: (s: [] Everglade) {
  if s[0].sp.dm.count < 1 { return; }
  w := sp_dm(s);
  for i: 0..<DEMO_PIECES { s[0].wv.room_stood[i] = i < w[0].n && w[0].pieces[i].state == DP_STANDING; s[0].wv.room_burnt[i] = false; }
  s[0].wv.room_fell = -1;   // the next tick reads every piece
  v := fi_of(s);
  for k: 0..<v[0].n { s[0].wv.room_burnt[v[0].burn[k].piece] = true; }
  s[0].wv.room_known = true;
}
// A cast of bar slot `slot` (one of the four) from `from` at `at`, from the seed every page plays it from.
// It falls when the caster's cast bar is done (the press is when the server hears it), as on every page:
// held until then (everglade-room-abilities.coax eg_ra_later).
everglade_room_strike :: (s: [] Everglade, by: int, slot: int, fx: f32, fy: f32, fz: f32, ax: f32, ay: f32, az: f32, seed: int) #export_c {
  // the Warlock's (everglade-warlock.coax): Eldritch Blast's beams, Fireball
  if sp_on(s) && slot >= WL_SLOT0 && slot < WL_SLOT0 + WL_SLOTS { s[0].wv.net = true; wl_strike(s, by, slot - WL_SLOT0, v3(fx, fy, fz), v3(ax, ay, az), seed); return; }
  if !sp_on(s) || slot < 0 || slot >= SP_SLOTS { return; }
  eg_ra_later(s, EgRaStrike.{by = by, slot = slot, from = v3(fx, fy, fz), at = v3(ax, ay, az), seed = seed, t = srd_spell(SP_SPELL[slot]).bar});
}
eg_room_release :: (s: [] Everglade, by: int, slot: int, fx: f32, fy: f32, fz: f32, ax: f32, ay: f32, az: f32, seed: int) {
  s[0].wv.net = true;
  s[0].sp.cast_at = v3(ax, ay, az); s[0].sp.cast_n = v3(0, 1, 0); s[0].sp.cast_from = v3(fx, fy, fz);
  s[0].sp.cast_seed = cast(u64) hi_w(seed, 1);
  s[0].sp.remote = false;
  s[0].wv.room_hit = v3(ax, ay, az); s[0].wv.room_by = by;
  sp_release(s, slot);
  if slot == SP_ORB { s[0].sp.orb_live = true; s[0].sp.orb_t = 0; s[0].sp.orb_remote = false; s[0].sp.orb_to = v3(ax, ay, az); }
}
// The server's town for dt: the strikes land, fire burns and spreads, the walls open where pieces broke;
// then what changed for the pages (everglade_room_event). How many events.
everglade_room_spells :: (s: [] Everglade, dt: f32) -> int #export_c {
  s[0].wv.room_ev_n = 0;
  if !sp_on(s) { return 0; }
  if !s[0].wv.room_known { eg_room_known(s); }
  // what the strikes and fire do to the town is the last caster's doing (its crimes are theirs)
  wt := watch_w(s); me := wt[0].me;
  eg_ra_strikes_due(s, dt);   // the strikes whose cast bars are done fall now
  wt[0].me = clamp_w(s[0].wv.room_by, 0, WATCH_YOUS - 1);
  sp_strikes(s, dt);
  wl_step(s, dt);   // the Warlock's strikes land (everglade-warlock.coax)
  fi_frame(s, dt);
  wt[0].me = me;
  if s[0].sp.walls_dirty { sp_open_walls(s); }
  w := sp_dm(s);
  now: [DEMO_PIECES] bool;
  v := fi_of(s);
  for k: 0..<v[0].n { now[v[0].burn[k].piece] = true; }
  // the pieces read only when one has fallen or burns (or stopped burning) since: most ticks none has (#12717)
  scan := w[0].fell != s[0].wv.room_fell || v[0].n > 0 || s[0].wv.room_any_burnt;
  s[0].wv.room_fell = w[0].fell; s[0].wv.room_any_burnt = v[0].n > 0;
  // each piece read in place (a copy of each of the 4000 pieces every tick was most of this step: #12717)
  for i: 0..<(ifx scan then w[0].n else 0) {
    standing := w[0].pieces[i].state == DP_STANDING;
    if s[0].wv.room_stood[i] && !standing {
      c := v3(w[0].pieces[i].cx, w[0].pieces[i].cy, w[0].pieces[i].cz);
      d := sub(c, s[0].wv.room_hit);
      throw := ifx s[0].wv.room_burnt[i] then v3(0, 1.2, 0) else add(times(unit_or(v3(d.x, 0, d.z), v3(0, 0, 1)), 6), v3(0, 3, 0));
      eg_room_put(s, 1, i, throw.x, throw.y, throw.z);
      s[0].wv.room_stood[i] = false;
    }
    if now[i] != s[0].wv.room_burnt[i] {
      if standing { eg_room_put(s, 2, i, ifx now[i] then 1.0f32 else 0.0f32, 0, 0); }
      s[0].wv.room_burnt[i] = now[i];
    }
  }
  // breaking the town's pieces is a crime, as on a page (watch_spell): the last caster's
  if s[0].wv.room_ev_n > 0 && s[0].wv.room_ev[0] == 1 {
    p := w[0].pieces[cast(int) s[0].wv.room_ev[1]];
    _ := everglade_room_crime(s, s[0].wv.room_by, p.cx, p.cz);
  }
  return s[0].wv.room_ev_n;
}
eg_room_put :: (s: [] Everglade, kind: int, i: int, a: f32, b: f32, c: f32) {
  q := s[0].wv.room_ev_n;
  if q >= EG_ROOM_EVENTS { return; }
  o := q * EG_ROOM_EV_FLOATS;
  s[0].wv.room_ev[o] = f32(kind); s[0].wv.room_ev[o + 1] = f32(i); s[0].wv.room_ev[o + 2] = a; s[0].wv.room_ev[o + 3] = b; s[0].wv.room_ev[o + 4] = c;
  s[0].wv.room_ev_n = q + 1;
}
// Event q (EG_ROOM_EV_FLOATS), and where its piece stands (x, z) after them.
everglade_room_event :: (s: [] Everglade, q: int, out: [] f32) -> bool #export_c {
  if q < 0 || q >= s[0].wv.room_ev_n || out.count < EG_ROOM_EV_FLOATS + 2 { return false; }
  for k: 0..<EG_ROOM_EV_FLOATS { out[k] = s[0].wv.room_ev[q * EG_ROOM_EV_FLOATS + k]; }
  p := sp_dm(s)[0].pieces[cast(int) out[1]];
  out[5] = p.cx; out[6] = p.cz;
  return true;
}
// R: every piece stands again and the fires go out, and the fallen of the town stand up (watch_restore).
everglade_room_rebuild :: (s: [] Everglade) #export_c {
  if sp_on(s) { _ := sp_restore(s, -1); eg_room_known(s); }
  if s[0].wv.started { _ := watch_restore(watch_w(s)); }
}
// A new room in this world's slot: the town whole again, everyone on their day, no player known.
everglade_room_fresh :: (s: [] Everglade) #export_c {
  if !s[0].started { everglade_start(s); }
  if s[0].wv.started { watch_start(watch_w(s), s[0].heights[..]); }
  for p: 0..<WATCH_YOUS { s[0].wv.room_live[p] = false; s[0].wv.room_dead[p] = false; }
  if sp_on(s) {
    for q: 0..<SP_METEORS * 2 { s[0].sp.meteors[q].live = false; }
    s[0].sp.bolt.live = false; s[0].sp.orb_live = false;
    eg_ra_fresh(s);   // the room before's abilities stop here (everglade-room-abilities.coax)
    _ := sp_restore(s, -1); eg_room_known(s);
  }
}
// The room server steps seat p's movement next (room-world.c world_step): the conditions, the slow and
// the throw everglade_move_world reads are theirs.
everglade_room_seat :: (s: [] Everglade, p: int) #export_c { s[0].wt[0].me = clamp_w(p, 0, WATCH_YOUS - 1); }
// Seat p's conditions from the watch (WC_*): Hold Person's hold, Ray of Frost's slow.
everglade_room_cond :: (s: [] Everglade, p: int) -> int #export_c {
  if !s[0].wv.started || p < 0 || p >= WATCH_YOUS { return 0; }
  y := s[0].wt[0].yous[p];
  if y.dead { return 0; }
  return (ifx y.held_t > 0 then WC_PARALYZED else 0) | (ifx y.slow_t > 0 then WC_SLOWED else 0);
}
