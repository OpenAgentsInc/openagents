// Everglade's town watch on the page (eg-watch), loaded by everglade.coax:
// everglade/legacy/v1/watch.coax's rules (who sees a crime, the chase, the
// SRD blows, your death) put to the realm's people, spells and HUD.
//
//   - people() reads each one's day, hands it to the watch, steps the watch
//     once a frame (watch_frame) and draws whoever is off their day where
//     the watch has them, in its clip (watch_pose): running, swinging,
//     cowering, knocked down, dead;
//   - the six new guards walk their beats (watch_new_place) and are drawn
//     with the spots' people, a part an instance, in the watch's crimson;
//   - every guard carries the Fantasy Props bronze sword and wooden shield:
//     sword at the hip and shield on the back on their beat, in hand when
//     they hunt you (watch_arms, after the edits' draw, as kit instances);
//   - a spell's blast (everglade-spells.coax sp_blast) calls watch_spell:
//     it hurts whoever is in it and, if it reached the town or a person, is
//     a crime;
//   - the spell bar's Rebuild (R) stands the fallen up (watch_rebuilt), and
//     R does so too when nothing is broken;
//   - the HUD: your HP under MAP, WANTED while the watch hunt you, their
//     shouts over their heads, and your death: the view darkens, YOU DIED,
//     and the face puts you at the Road In (the warp).
// All of it only with the SRD ruleset and never on a still page.

WATCH_OBJECTS :: 2 * PEOPLE_SHOWN;   // a sword and a shield for each one drawn
WATCH_SWORD_SIZE :: 0.82;            // the kit's sword is 1.13 m: a guard's arming sword
WATCH_SHIELD_SIZE :: 0.9;
WATCH_RED_R :: 0.95; WATCH_RED_G :: 0.3; WATCH_RED_B :: 0.24;

NewGuard :: struct { x: f32; z: f32; yaw: f32; walking: bool; placed: bool; }
// A damage number (watch_pop): the hit points lost, red over the head that lost them, rising as it fades.
WATCH_POPS :: 40; POP_LIFE :: 1.2; POP_RISE :: 0.8;
// A number or word over a head: harm (-6, red), healing (+4, green), or a word (POP_WORDS) as a
// condition lands (word >= 0), each rising and fading over POP_LIFE.
WatchPop :: struct { live: bool; at: Point; t: f32; amount: int; dx: f32; big: bool; heal: bool; word: int = -1; }
POP_DOWN :: 0; POP_HELD :: 1; POP_ROOTED :: 2; POP_RESTRAINED :: 3; POP_STUNNED :: 4; POP_PRONE :: 5;
POP_FRIGHTENED :: 6; POP_SLOWED :: 7; POP_BLINDED :: 8; POP_UP :: 9; POP_HALTED :: 10;
POP_WORDS :: [11] string.["DOWN", "HELD", "ROOTED", "RESTRAINED", "STUNNED", "PRONE", "FRIGHTENED", "SLOWED", "BLINDED", "UP", "HALTED"];
// What each one had last frame (hit points and temporary ones), so any blow shows its number.
WatchSeen :: struct { life: int; on: bool; }
// What the page keeps of the watch for drawing it.
#load "../../everglade/shared/everglade-handles.coax";
WatchView :: struct {
  seat_owner: [16] Handle(EvergladeSeat);
  // the new guards: where they stand, the way they face, walking, their head (for a shout)
  // (one struct each: a [6] f32 here would be the same C array type as the river library's, in one translation unit)
  at: [WATCH_NEW] NewGuard;
  heads: [WATCH_ACTORS] Point; head_on: [WATCH_ACTORS] bool;
  names: [LABELS_MAX] Box; name_n: int;   // the names drawn over heads this frame (labels), which the shouts keep clear of
  // each one drawn's sword and shield (12 numbers each), how many
  arms: [WATCH_OBJECTS * 12] f32; arm_group: [WATCH_OBJECTS] int; arm_n: int;
  started: bool;
  knock: Point; knocked: bool;    // a blast's throw for your living body, for the face to add to your velocity once
  you_slot: int; you_t: f64;      // the spell that last caught you and when (a Meteor Swarm's spheres hurt you once)
  want: int;                      // a hash's "+wantedN": the level you start wanted at (0 none)
  pops: [WATCH_POPS] WatchPop;
  seen: [WATCH_ACTORS] WatchSeen; seen_you: WatchSeen;
  // the room server's town (everglade_room_town): where each seat stands, whether it sat and lay dead last tick
  room_at: [WATCH_YOUS] Point; room_live: [WATCH_YOUS] bool; room_dead: [WATCH_YOUS] bool;
  room_born: [WATCH_ACTORS] int;   // each person's watch_revive count the room's rules last heard (everglade_room_people)
  room_talk: [WATCH_YOUS] int;     // the townsperson each seat talks to (spot), -1 none: they stop and face that seat (everglade_room_talk)
  // a page in a room: the server's townsfolk (net_folk), drawn instead of the page's own watch; and
  // the server, whose town takes no blast of its own (the rules do: everglade5e-room-rules.coax)
  net: bool;
  // the room server's pieces: what stood and what burnt when the pages last heard, and what they hear
  room_stood: [DEMO_PIECES] bool; room_burnt: [DEMO_PIECES] bool; room_known: bool;
  room_fell: int; room_any_burnt: bool;   // the town's DemoWorld.fell when last read, and whether a piece was burning
  room_pburn: [CR_PLACED_MAX] bool; room_pgone: [CR_PLACED_MAX] bool;   // the placed things alight and burnt through, as the pages heard
  room_ev: [EG_ROOM_EVENTS * EG_ROOM_EV_FLOATS] f32; room_ev_n: int;
  room_hit: Point; room_by: int;
  room_break_step:int;room_break_at:[DEMO_PIECES]int;room_break_by:[DEMO_PIECES]int;room_break_hit:[DEMO_PIECES]Point;
  room_nobody: bool;   // this step's strikes are no seat's (the raid's, by -1): what they and their fire do is no one's crime
  fire_own: bool; fire_by: int;   // a fire is acting now, started by seat fire_by (-1 the raid); else the step's caster's (#12920)
  room_any_placed: bool;   // a placed thing was alight, sooty or gone when last read
  mend_from: [8] Point; mend_at: [8] Point; mend_n: int;   // Repairs handed over since the last step (their events go with its)
  server: bool;                    // this is the room server's world (everglade_room_town)
  room_cond: [WATCH_YOUS] int;     // each seat's conditions in the rules (WC_*)
  // the conditions the rules hold each person in (WC_*), where rules have the town (rules_on: the
  // room server's, a page's from the server's rows, the page's own offline): the abilities' holds
  // follow them rather than rolling saves of their own (everglade-abilities.coax ab_rules_cond, #12718)
  rules_cond: [WATCH_ACTORS] int; rules_on: bool;   // where the last strike fell (a break is thrown out from it), and whose
  // each person's save the room's rules rolled against a seat's ability this step (the room server's:
  // everglade_room_folk_save), 0 none: that ability's copy takes it (ab_rules_save, #12874)
  rules_save: [WATCH_ACTORS] int;
}
// The room transports process-local lifetime words; world policy resolves them.
everglade_room_seat_owner :: (s:[]Everglade,seat:int,word:u64) #export_c #effects(all) {
  if seat<0 || seat>=16 {return;}
  h:=Handle(EvergladeSeat).{value=word};
  next:=ifx handle_present(h) && handle_generation(h)>0 && handle_slot(h)==seat then h else Handle(EvergladeSeat).{};
  if handle_present(s[0].wv.seat_owner[seat]) && s[0].wv.seat_owner[seat]!=next {
    for ability:0..<AB_N {everglade_room_ability_mode(s,seat,ability,0,0,0,0,false,0,0,0,0);}
  }
  s[0].wv.seat_owner[seat]=next;
}

watch_cap :: (group: int) -> int {
  if group == group_of(M_SWORD) || group == group_of(M_SHIELD) { return PEOPLE_SHOWN; }
  return 0;
}

// The parts new guard k wears: the Ranger's leathers, a head, their hair, maybe a beard.
watch_parts :: (k: int, out: [] int) -> int {
  if k < 0 || k >= WATCH_NEW || out.count < FOLK_PARTS_MAX { return 0; }
  f := WATCH_FEMALE[k];
  out[0] = ifx f then PART_FEMALE_RANGER else PART_MALE_RANGER;
  out[1] = ifx f then PART_FEMALE_HEAD else PART_MALE_HEAD;
  out[2] = WATCH_HAIR[k];
  n := 3;
  if WATCH_BEARD[k] && !f { out[n] = PART_BEARD; n += 1; }
  return n;
}

// Which new guard's face, skin and hair person i (a new guard, or a reinforcement) wears.
watch_look :: (i: int) -> int { return ifx watch_is_rein(i) then (i - WATCH_FIRST_REIN) % WATCH_NEW else i - EG_SPOTS; }
// The parts reinforcement i wears by their rank: the kit's leathers (a Gladiator's bare peasant's
// cloth), a head, hair, a beard, a caster's hood, and the Priest's and the Archmage's robe.
watch_rein_parts :: (s: [] Everglade, i: int, out: [] int) -> int {
  if !watch_is_rein(i) || out.count < FOLK_PARTS_MAX { return 0; }
  k := watch_look(i);
  r := watch_rank(s[0].wt[..], i);
  f := WATCH_FEMALE[k];
  out[0] = ifx RANK_BARE[r] then (ifx f then PART_FEMALE_PEASANT else PART_MALE_PEASANT) else (ifx f then PART_FEMALE_RANGER else PART_MALE_RANGER);
  out[1] = ifx f then PART_FEMALE_HEAD else PART_MALE_HEAD;
  out[2] = WATCH_HAIR[k];
  n := 3;
  if WATCH_BEARD[k] && !f { out[n] = PART_BEARD; n += 1; }
  if RANK_HOOD[r] { out[n] = ifx f then PART_FEMALE_HOOD else PART_MALE_HOOD; n += 1; }
  if RANK_ROBE[r] { out[n] = ifx f then PART_FEMALE_ROBE else PART_MALE_ROBE; n += 1; }
  return n;
}

watch_w :: (s: [] Everglade) -> [] Watch { return s[0].wt[..]; }
watch_on :: (s: [] Everglade) -> bool { return s[0].wt[0].on; }
// Whether person i (a spot, or EG_SPOTS + a new guard) is off their day.
watch_busy :: (s: [] Everglade, i: int) -> bool { return s[0].wv.started && watch_off(watch_w(s), i); }
// You lie dead: you stand still.
watch_down :: (s: [] Everglade) -> bool { return s[0].wv.started && watch_you(s[0].wt[..])[0].dead; }

watch_page_start :: (s: [] Everglade) {
  everglade_guard_invalidate(s); s[0].guard_ai.generation += 1;
  watch_start(watch_w(s), s[0].heights[..]);
  for k: 0..<WATCH_NEW { s[0].wv.at[k].placed = false; }
  s[0].wv.started = true;
}

// Where new guard k is on their beat now (and the way they face, turning smoothly at the ends).
watch_new_place :: (s: [] Everglade, k: int, c: FolkClock, dt: f32) {
  p := watch_beat_at(watch_w(s), k, c.world, c.still);
  if !s[0].wv.at[k].placed { s[0].wv.at[k].yaw = p.face; s[0].wv.at[k].placed = true; }
  s[0].wv.at[k].x = p.x; s[0].wv.at[k].z = p.z; s[0].wv.at[k].walking = p.walking && !c.still;
  s[0].wv.at[k].yaw = ifx c.still then p.face else watch_turn(s[0].wv.at[k].yaw, p.face, f32(FOLK_TURN) * dt);
}

// Once a frame, after everyone's day is read (watch_home): the watch steps; a fall of yours ends in
// the warp to the Road In; whoever you talk to who turns on you ends the talk.
watch_frame :: (s: [] Everglade, you: Point, dt: f32, c: FolkClock) {
  w := watch_w(s);
  w[0].on = sp_on(s) && !c.still;
  if !w[0].on { return; }
  watch_pops_frame(s, dt);
  s[0].wv.net = net_town(s);
  // the gates: shut at WANTED GATES_AT, the room's word in a room (its doors row), else your own level
  was := s[0].gates_shut;
  if s[0].wv.net { gb := net_gates(s); s[0].gates_shut = gb > 0 && (gb & 1) != 0; fi_gates_heard(s, gb); }   // (its burnt and burning leaves too)
  else { s[0].gates_shut = watch_you(w[..])[0].wanted && watch_you(w[..])[0].level >= GATES_AT && !watch_you(w[..])[0].dead; }
  if s[0].gates_shut != was { sp_say(s, ifx s[0].gates_shut then "THE GATES ARE SHUT" else "THE GATES OPEN", -1, ""); }
  if s[0].wv.net { watch_net_you(w, dt); watch_net_frame(s); watch_net_shouts(s, dt); return; }
  watch_you(w[..])[0].face = s[0].face;
  // the realm's switches (realm_rights rows): guards who give chase, and its owner's own invincibility
  e := s[0].ev.ed[..];
  w[0].peace = !redit_row_on(e, "guards");
  w[0].unhurt = redit_may(e) && redit_row(e, "invincible") >= 0 && redit_row_on(e, "invincible");   // the owner's and admins' own, off unless switched on
  if w[0].peace { s[0].wv.want = 0; }
  if s[0].wv.want > 0 {
    watch_you(w[..])[0].wanted = true; watch_you(w[..])[0].unseen = 0; watch_you(w[..])[0].heat = hi_w(watch_you(w[..])[0].heat, HEAT_AT[clamp_w(s[0].wv.want, 1, WANTED_LEVELS)]);
    s[0].wv.want = 0;
  }
  everglade_captain_frame(s, you);   // the guard captain's plan (everglade-guard-ai.coax)
  w[0].floor_n = eg_watch_floors(s, w);
  w[0].deck_out = sp_deck_out(s);   // the bridge's planks down: no deck there   // what the bodies in flight come down onto (everglade-stand.coax)
  watch_tick(w, dt, you, c.day, s[0].boxes[..], s[0].box_n, s[0].heights[..]);
  // a hunter's spell threw you: the face adds it to your velocity
  if watch_you(w[..])[0].bound_said == 1 { sp_say(s, "EARTHBIND", -1, ""); }
  if watch_you(w[..])[0].bound_said == 2 { sp_say(s, "YOU RESIST EARTHBIND", -1, ""); }
  watch_you(w[..])[0].bound_said = 0;
  if watch_you(w[..])[0].knocked { s[0].wv.knock = add(s[0].wv.knock, watch_you(w[..])[0].knock); s[0].wv.knocked = true; watch_you(w[..])[0].knocked = false; watch_you(w[..])[0].knock = v3(0, 0, 0); }
  if watch_you(w[..])[0].respawn {
    everglade_guard_invalidate(s);
    watch_you(w[..])[0].respawn = false;
    s[0].spawn = v3(f32(EG_SPAWN_X), 0, f32(EG_SPAWN_Z)); s[0].spawn_face = f32(PI);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    s[0].sp.armed = -1; s[0].sp.casting = -1;
    watch_end_effects(s);
  }
  if s[0].talk >= 0 && watch_off(w, s[0].talk) { end_talk(s); }
  if watch_you(w[..])[0].dead && s[0].talk >= 0 { end_talk(s); }
}

// You stand again: every effect on you ends (Levitate, Feather Fall, Reverse Gravity's hold, the gust that
// follows you, a throw), so you stand at the Road In on the ground, still; the face takes you out of the
// water and any rowboat (everglade-face.c, on the warp).
watch_end_effects :: (s: [] Everglade) {
  a := ab_of(s);
  a[0].lev_on = false; a[0].lev_up = false; a[0].lev_sink = false; a[0].lev_t = 0;
  a[0].ff_on = false; a[0].ff_air = false;
  a[0].gust_on = false;
  if a[0].rg_on { a[0].rg_on = false; ab_fall_all(s); }
  for k: 0..<AB_N { a[0].keys[k] = false; }
  s[0].wv.knocked = false; s[0].wv.knock = v3(0, 0, 0);
  w := watch_w(s);
  watch_you(w[..])[0].you_body.on = false; watch_you(w[..])[0].you_body.settle = -1; watch_you(w[..])[0].you_fall = 0;
  fr_you_reset(s);
  td_you_reset(s);
}
// Ray of Frost's slow on your pace, and Hold Person's hold (you can't move), for the face.
// In a room the server's (your COND bits: net_cond); on the room server, the seat being stepped's
// (everglade_room_seat: the watch's own and the rules' conditions on them).
everglade_slow :: (s: [] Everglade) -> f32 #export_c #effects(all) {
  pace := ifx s[0].wv.server then (ifx s[0].wv.started then watch_pace(watch_w(s)) else 1.0f32)
          else (ifx (st_cond(s, ST_YOU) & WC_SLOWED) != 0 then f32(FROST_PACE) else 1.0f32);   // the status state (everglade-status.coax)
  return pace * ci_pace(s);   // and a beast's Speed (everglade-circle.coax)
}
everglade_held :: (s: [] Everglade) -> bool #export_c #effects(all) {
  if s[0].wv.server { return (watch_held(watch_w(s)) || (s[0].wv.room_cond[clamp_w(s[0].wt[0].me, 0, WATCH_YOUS - 1)] & WC_STOPPED) != 0); }
  return (st_cond(s, ST_YOU) & WC_STOPPED) != 0;   // the status state (everglade-status.coax): the room's, or the watch's offline
}
// A blast's throw for your living body, taken once by the face (everglade-face.c adds it to your velocity).
everglade_knock :: (s: [] Everglade) -> Point #export_c #effects(all) {
  if s[0].wv.server && s[0].wv.started {
    // the room server's seat being stepped: the watch's throw of them, once
    y := watch_you(s[0].wt[..]);
    if !y[0].knocked || y[0].dead { y[0].knocked = false; y[0].knock = v3(0, 0, 0); return v3(0, 0, 0); }
    k := y[0].knock;
    y[0].knocked = false; y[0].knock = v3(0, 0, 0);
    return k;
  }
  if !s[0].wv.knocked { return v3(0, 0, 0); }
  s[0].wv.knocked = false;
  return s[0].wv.knock;
}

// Person i (a spot's) off their day: drawn where the watch has them.
watch_apply :: (s: [] Everglade, i: int) {
  w := watch_w(s);
  if !watch_off(w, i) { return; }
  a := w[0].actors[i];
  s[0].folk[i].x = a.x; s[0].folk[i].z = a.z; s[0].folk[i].yaw = a.yaw;
  s[0].folk[i].indoors = false; s[0].folk[i].walking = false; s[0].folk[i].facing = false;
}

// A pose for one off their day: the watch's clip, its gait at their speed, a fall held at its end.
watch_pose :: (r: SkinRig, a: Actor, sk: [] Skin, dt: f32, out: [] f32) {
  clip := clamp_i(a.clip, 0, PEOPLE_CLIPS - 1);
  step := ifx finite(dt) then hi(dt, 0) else 0.0f32;
  sk[0].fade = 0.16;
  if a.body.on {
    // limp in the air: the knock's first moment, arms flung, held
    if sk[0].clip != PEOPLE_KNOCK { skin_advance(r, sk, PEOPLE_KNOCK, 0, 0.18); }
    else { skin_advance(r, sk, PEOPLE_KNOCK, 0, clamp(0.18 - sk[0].time, 0, step)); }
    skin_palette(r, sk, out);
    return;
  }
  if a.body.settle >= 0 && a.body.settle < f32(TUMBLE_SETTLE) && a.hold && (sk[0].clip != clip || sk[0].time < r.duration[clip] - 0.1) {
    // come to rest: the fall's lying end blends in as the rigid turn blends out
    sk[0].clip = ifx clip == PEOPLE_IDLE then PEOPLE_KNOCK else PEOPLE_IDLE;
    skin_advance(r, sk, clip, 0, r.duration[clip] - 0.04);
    skin_palette(r, sk, out);
    return;
  }
  if a.hold && sk[0].clip != clip && a.t > 0.25 {
    // a fall that began a while ago (a.t: the seconds in its mode, the server's in a room), on a pose
    // just taken up (seen again past the edge of the view, or by a page that came late): where it is
    // now, not from its start
    fresh := sk[0].clip < 0;
    skin_advance(r, sk, clip, 0, 0);
    sk[0].time = clamp(a.t, 0, r.duration[clip] - 0.03);
    if fresh || a.t > 0.6 { sk[0].changed = sk[0].clock - 10; }
    skin_advance(r, sk, clip, 0, 0);
    skin_palette(r, sk, out);
    return;
  }
  if a.hold && sk[0].clip == clip {
    left := r.duration[clip] - 0.03 - sk[0].time;
    step = clamp(step, 0, hi(left, 0));
  }
  speed := ifx clip == PEOPLE_RUN || clip == PEOPLE_WALK then hi(a.speed, 0.6) else 0.0f32;
  skin_advance(r, sk, clip, speed, step);
  if a.hold && step == 0 { sk[0].clock += ifx finite(dt) then hi(dt, 0) else 0.0f32; }   // the blend still finishes
  skin_palette(r, sk, out);
}

// Joint j's frame in the pose now, in the character's own space: its rotation and where it is.
WatchFrame :: struct { q: Quat; t: Point; }
watch_joint :: (r: SkinRig, sk: [] Skin, j: int) -> WatchFrame {
  f: WatchFrame;
  if j < 0 || j >= r.joints || r.joints > SKIN_JOINTS_MAX { return f; }
  chain: [SKIN_JOINTS_MAX] int;
  n := 0; k := j;
  while k >= 0 && n < SKIN_JOINTS_MAX { chain[n] = k; n += 1; p := r.parent[k]; k = ifx p < k then p else -1; }
  q := Quat.{}; t := v3(0, 0, 0);
  while n > 0 {
    n -= 1;
    l := sk[0].now[chain[n]];
    t = add(t, quat_rotate(q, l.t));
    q = quat_unit(quat_mul(q, l.q));
  }
  f.q = q; f.t = t;
  return f;
}

PEOPLE_PELVIS_J :: 1; PEOPLE_CHEST_J :: 4; PEOPLE_HAND_L_J :: 10; PEOPLE_FOREARM_L_J :: 9; PEOPLE_HAND_R_J :: 34; PEOPLE_THIGH_L_J :: 55;

// One kit piece's rows (a sword's or a shield's): its axes x, y, z (unit, in the world) scaled, its
// origin at o.
watch_arm_put :: (s: [] Everglade, group: int, x: Point, y: Point, z: Point, o: Point, size: f32) {
  n := s[0].wv.arm_n;
  if n >= WATCH_OBJECTS { return; }
  k := n * 12;
  s[0].wv.arms[k] = x.x * size; s[0].wv.arms[k + 1] = y.x * size; s[0].wv.arms[k + 2] = z.x * size; s[0].wv.arms[k + 3] = o.x;
  s[0].wv.arms[k + 4] = x.y * size; s[0].wv.arms[k + 5] = y.y * size; s[0].wv.arms[k + 6] = z.y * size; s[0].wv.arms[k + 7] = o.y;
  s[0].wv.arms[k + 8] = x.z * size; s[0].wv.arms[k + 9] = y.z * size; s[0].wv.arms[k + 10] = z.z * size; s[0].wv.arms[k + 11] = o.z;
  s[0].wv.arm_group[n] = group;
  s[0].wv.arm_n = n + 1;
}

// A guard's sword and shield, from their pose: in hand hunting you (drawn: the sword's grip in the right
// fist, its blade out past the thumb; the shield on the left forearm, facing out), else the sword at
// the left hip, point down, and the shield across the back.
watch_arm_guard :: (s: [] Everglade, r: SkinRig, sk: [] Skin, x: f32, y: f32, z: f32, yaw: f32, drawn: bool) {
  c := cos(yaw); sn := sin(yaw);
  // the character's space to the world's
  at := v3(x, y, z);
  // (the person's rows: x' = c x + sn z, z' = -sn x + c z)
  chest := watch_joint(r, sk, PEOPLE_CHEST_J);
  pelvis := watch_joint(r, sk, PEOPLE_PELVIS_J);
  thigh := watch_joint(r, sk, PEOPLE_THIGH_L_J);
  forward := watch_world(v3(0, 0, 1), c, sn);
  up := v3(0, 1, 0);
  if drawn {
    hand := watch_joint(r, sk, PEOPLE_HAND_R_J);
    blade := watch_world(quat_rotate(hand.q, v3(0, 0, 1)), c, sn);
    fingers := watch_world(quat_rotate(hand.q, v3(0, 1, 0)), c, sn);
    grip := add(at, watch_world(add(hand.t, quat_rotate(hand.q, v3(0, 0.085, 0))), c, sn));
    across := unit_or(cross(blade, fingers), v3(1, 0, 0));
    edge := cross(across, blade);
    o := sub(grip, times(blade, 0.15 * f32(WATCH_SWORD_SIZE)));
    watch_arm_put(s, group_of(M_SWORD), edge, blade, across, o, f32(WATCH_SWORD_SIZE));
    lh := watch_joint(r, sk, PEOPLE_HAND_L_J);
    la := watch_joint(r, sk, PEOPLE_FOREARM_L_J);
    mid := mix(la.t, lh.t, 0.55);
    out := unit_or(v3(mid.x - chest.t.x, 0, mid.z - chest.t.z), v3(1, 0, 0));
    face := watch_world(out, c, sn);
    side := unit_or(cross(up, face), v3(1, 0, 0));
    centre := add(add(at, watch_world(mid, c, sn)), times(face, 0.07));
    so := sub(centre, times(up, 0.31 * f32(WATCH_SHIELD_SIZE)));
    watch_arm_put(s, group_of(M_SHIELD), side, up, face, so, f32(WATCH_SHIELD_SIZE));
    return;
  }
  // sheathed: from the left hip, point down and a little back
  left := unit_or(v3(thigh.t.x - pelvis.t.x, 0, thigh.t.z - pelvis.t.z), v3(1, 0, 0));
  hip := add(pelvis.t, add(times(left, 0.2), v3(0, 0.08, 0.02)));
  down := watch_world(unit_or(v3(0, -1, -0.32), v3(0, -1, 0)), c, sn);
  hipw := add(at, watch_world(hip, c, sn));
  blade_side := watch_world(left, c, sn);
  edge := unit_or(cross(blade_side, down), forward);
  // the sword's own +y is from its pommel to its point: pointing down, its guard at the hip
  watch_arm_put(s, group_of(M_SWORD), edge, down, blade_side, sub(hipw, times(down, 0.3 * f32(WATCH_SWORD_SIZE))), f32(WATCH_SWORD_SIZE));
  back := times(forward, -1);
  side := unit_or(cross(up, back), v3(1, 0, 0));
  centre := add(at, add(watch_world(chest.t, c, sn), add(times(back, 0.2), v3(0, -0.12, 0))));
  watch_arm_put(s, group_of(M_SHIELD), side, up, back, sub(centre, times(up, 0.31 * f32(WATCH_SHIELD_SIZE))), f32(WATCH_SHIELD_SIZE));
}
watch_world :: (v: Point, c: f32, sn: f32) -> Point { return v3(c * v.x + sn * v.z, v.y, -sn * v.x + c * v.z); }

// After the edits' draw: the swords and shields of everyone drawn, as kit instances.
watch_arms :: (s: [] Everglade) {
  if !s[0].pack_ready { return; }
  for n: 0..<s[0].wv.arm_n { kit_rows(s, s[0].wv.arm_group[n], s[0].wv.arms[n * 12..<n * 12 + 12]); }
}

// A blast of the spell in `slot` at `at` (everglade-spells.coax sp_blast, before its damage): whoever
// is in it takes it, and if it reached the town's pieces or a person, it is a crime.
watch_spell :: (s: [] Everglade, at: Point, slot: int) {
  w := watch_w(s);
  if !w[0].on || slot < 0 || slot >= SP_SLOTS || s[0].wv.net { return; }   // in a room the server's town takes the blast
  radius := SP_BLAST[slot];
  you := ab_you(s);
  power := ifx slot < 4 then WATCH_THROW[slot] else 8.0f32;
  hit := watch_blast(w, at, radius, s[0].sp.dmg, you, power, s[0].heights[..]);
  watch_spell_you(s, at, radius, power);
  touched := 0;
  dm := sp_dm(s);
  for i: 0..<dm[0].n {
    p := dm[0].pieces[i];
    if p.state == DP_BROKEN { continue; }
    c := v3(clamp(at.x, p.x0, p.x1), clamp(at.y, p.y0, p.y1), clamp(at.z, p.z0, p.z1));
    if length(sub(c, at)) < radius { touched += 1; break; }
  }
  if hit > 0 || touched > 0 { _ := watch_crime(w, at, WATCH_HEAR[slot], you, s[0].boxes[..], s[0].box_n, s[0].heights[..]); }
}

// Your own blast on you: if your body is in it (in three dimensions: its span, feet to head) you take its
// damage, a Dexterity save for half (SRD 5.2.1 Meteor Swarm, the bolts, the orb's splash), and it throws
// you as it throws the town: alive, the face adds the throw to your velocity; dead, your body flies.
watch_spell_you :: (s: [] Everglade, at: Point, radius: f32, power: f32) {
  w := watch_w(s);
  if !w[0].on || watch_you(w[..])[0].dead { return; }
  if s[0].wv.you_slot == s[0].sp.casting + 1000 && s[0].time - s[0].wv.you_t < 2.5 { return; }
  you := ab_you(s);
  flat := flat_gap(you, at);
  up := hi(hi(at.y - (you.y + f32(BODY_TALL)), you.y - at.y), 0);
  d := sqrt(flat * flat + up * up);
  if d >= radius + f32(BLAST_PAD) { return; }
  s[0].wv.you_slot = s[0].sp.casting + 1000; s[0].wv.you_t = s[0].time;
  took := srd_creature_takes(w[0].dice[..], SRD_RANGER_5, s[0].sp.dmg, SAVE_DEX, ON_SAVE_HALF, SAVE_DC_W);
  k := clamp01(1 - d / (radius + f32(BLAST_PAD)));
  kick := watch_kick(at, add(you, v3(0, f32(TUMBLE_PELVIS), 0)), power * (0.45 + 0.55 * k));
  watch_hurt_you_thrown(w, took, you, s[0].face, kick);
  if !watch_you(w[..])[0].dead { s[0].wv.knock = add(s[0].wv.knock, times(kick, 0.6)); s[0].wv.knocked = true; }
  if took > 0 { sp_say(s, "YOU ARE CAUGHT IN IT", took, "DAMAGE"); }
}

// The Priest's Spiritual Weapon (watch.coax watch_weapon_step: it hangs by your shoulder at `at` and
// strikes when `next` runs out): a spectral mace, one thing: a haft with a flanged head on its end and
// a pommel, lit like pale gold metal (not flat glow: the owner, October 30, saw a yellow disc and a
// yellow plank floating apart), rocking as it hangs, raised and swung down as each blow lands, a faint
// glow round its head.
WATCH_MACE_RGB :: Point.{x = 0.93, y = 0.85, z = 0.6};
watch_mace :: (s: [] Everglade, at: Point, next: f32) {
  t := f32(s[0].time);
  // the blow: the last third of a second before it strikes, raised back then down
  wind := clamp01(1 - next / 0.35);
  yaw := 0.6 * sin(t * 0.7);
  tilt := 0.35 + 0.12 * sin(t * 2.3) - 0.5 * wind + 2.0 * wind * wind * wind;
  u := v3(sin(yaw) * sin(tilt), cos(tilt), cos(yaw) * sin(tilt));   // along the haft, to the head
  c := add(at, v3(0, 0.05 * sin(t * 1.9), 0));
  m := WATCH_MACE_RGB;
  shape(s, SHAPE_BOX, LOOK_MATTE, c, yaw, tilt, 0.045, 0.62, 0.045, m.x * 0.8, m.y * 0.78, m.z * 0.74);
  head := add(c, times(u, 0.36));
  shape(s, SHAPE_SPHERE, LOOK_STONE, head, yaw, tilt, 0.17, 0.2, 0.17, m.x, m.y, m.z);
  // its flanges, two plates crossed through the head along the haft
  shape(s, SHAPE_BOX, LOOK_MATTE, head, yaw, tilt, 0.3, 0.2, 0.04, m.x, m.y, m.z);
  shape(s, SHAPE_BOX, LOOK_MATTE, head, yaw, tilt, 0.04, 0.2, 0.3, m.x, m.y, m.z);
  shape(s, SHAPE_SPHERE, LOOK_STONE, add(c, times(u, -0.32)), yaw, tilt, 0.07, 0.07, 0.07, m.x, m.y, m.z);
  sp_glow(s, head, 0.35 + 0.08 * sin(t * 3.1), v3(0.32, 0.27, 0.12));
}

// The hunters' spells in the air (watch.coax Missile): bolts that fly and burst, the frost ray, the
// Fireball's blast, the Lightning Bolt's line and the Cone of Cold's spray (sparks: everglade-spells.coax),
// Hold Person's ring on you, the Priest's healing and Spiritual Weapon; and a caster's hands as they cast.
watch_missiles_draw :: (s: [] Everglade) {
  if !s[0].wv.started { return; }
  w := watch_w(s);
  for k: 0..<MISSILES {
    m := w[0].missiles[k];
    if !m.live { continue; }
    a := v3(m.ax, m.ay, m.az); b := v3(m.bx, m.by, m.bz);
    u := clamp01(m.t / hi(m.flight, 0.001));
    p := add(a, times(sub(b, a), u));
    flying := m.t < m.flight;
    burst := !flying && !m.shown;
    if burst { w[0].missiles[k].shown = true; }
    if m.kind == MS_ARROW {
      // a Scout's arrow: a thin dark shaft along its flight
      if flying { d := sub(b, a); shape(s, SHAPE_BOX, LOOK_MATTE, p, atan2(d.x, d.z), 0, 0.02, 0.02, 0.7, 0.3, 0.22, 0.12); }
      continue;
    }
    if m.kind == MS_FIRE_BOLT || m.kind == MS_FIREBALL || m.kind == MS_GUIDING {
      hot := ifx m.kind == MS_GUIDING then v3(1, 0.95, 0.65) else v3(1, 0.7, 0.25);
      cool := ifx m.kind == MS_GUIDING then v3(0.95, 0.75, 0.3) else v3(0.9, 0.25, 0.06);
      if flying {
        size := ifx m.kind == MS_FIREBALL then 0.22f32 else 0.14f32;
        shape(s, SHAPE_SPHERE, LOOK_FLAME, p, 0, 0, size, size, size, hot.x, hot.y, hot.z);
        sp_add_spark(s, p, v3(0, 0.4, 0), 0.3, size * 0.8, cool, -1);
      } else if burst {
        if m.kind == MS_FIREBALL {
          sp_add_blast(s, b, f32(FIREBALL_R), 0);
          sp_add_scorch(s, b, 1.4, false);
          sp_add_shock(s, b, f32(FIREBALL_R), 0.6, v3(1, 0.55, 0.2));
        } else { sp_burst(s, b, v3(0, 1, 0), 10, 4, 0.5, 0.1, hot, cool, 6); }
      }
    } else if m.kind == MS_FROST {
      // a pale blue-white beam from the hand to you
      if m.t < m.flight + 0.3 {
        d := sub(b, a); l := length(d);
        if l > 0.1 {
          for q: 0..<6 { sp_add_spark(s, add(a, times(d, (f32(q) + 0.5) / 6)), v3(0, 0, 0), 0.12, 0.09, v3(0.75, 0.92, 1), 0); }
        }
      }
      if burst { sp_burst(s, b, v3(0, 1, 0), 8, 2.5, 0.6, 0.08, v3(0.85, 0.95, 1), v3(0.5, 0.75, 1), 2); }
    } else if m.kind == MS_HOLD {
      // a golden thread from the hand to you, then a ring closing round you
      if flying {
        d := sub(b, a);
        for q: 0..<3 { sp_add_spark(s, add(a, times(d, clamp01(u - f32(q) * 0.08))), times(d, 0.2), 0.12, 0.12 - f32(q) * 0.02, v3(1.4, 1.05, 0.35), 0); }
      }
      if burst { sp_add_shock(s, v3(b.x, b.y - 0.9, b.z), 1.1, 0.7, v3(1, 0.8, 0.3)); }
    } else if m.kind == MS_LIGHTNING {
      // the bolt's line, 100 ft from the hand, crackling
      if burst {
        d := unit_or(sub(b, a), v3(0, 0, 1));
        for q: 0..<40 {
          at := add(a, times(d, f32(LIGHTNING_LONG) * f32(q) / 40));
          sp_add_spark(s, add(at, times(sp_spray(s, 0), 0.25)), times(sp_spray(s, 0), 0.6), 0.35, 0.14, v3(0.8, 0.88, 1), 0);
        }
        sp_add_shock(s, b, 2.0, 0.4, v3(0.7, 0.8, 1));
      }
    } else if m.kind == MS_COLD {
      // a spray of frost, 60 ft wide as it is long
      if burst {
        d := unit_or(sub(b, a), v3(0, 0, 1));
        for q: 0..<36 {
          spray := unit_or(add(d, times(sp_spray(s, 0), 0.5)), d);
          sp_add_spark(s, a, times(spray, 14 + 12 * sp_rand(s)), 0.8, 0.16, v3(0.82, 0.93, 1), 1);
        }
        for q: 0..<4 { sp_add_puff(s, add(a, times(d, 4 + f32(q) * 3.5)), times(d, 2), 1.8, 1.6, 0.96); }
      }
    } else if m.kind == MS_MAGIC_MISSILE {
      // a dart: a bright blue-white head and a streak behind it along the way it turned
      if m.t >= 0 && flying {
        at := v3(m.ax, m.ay, m.az); v := v3(m.vx, m.vy, m.vz);
        shape(s, SHAPE_SPHERE, LOOK_FLAME, at, 0, 0, 0.17, 0.17, 0.17, 0.8, 0.95, 1);
        sp_add_spark(s, at, times(v, -0.3), 0.4, 0.13, v3(0.4, 0.7, 1), 0);
      } else if burst { sp_burst(s, b, v3(0, 1, 0), 8, 3, 0.4, 0.09, v3(0.85, 0.95, 1), v3(0.35, 0.6, 1), 0); }
    } else if m.kind == MS_EARTHBIND {
      // yellow strips of magic from the hand to you
      if flying {
        for q: 0..<3 { sp_add_spark(s, add(p, times(sp_spray(s, 0), 0.2)), times(sub(b, a), -0.15), 0.2, 0.07, v3(1, 0.85, 0.2), 0); }
      }
    } else if m.kind == MS_HEAL {
      if burst { sp_burst(s, b, v3(0, 1, 0), 12, 1.6, 0.9, 0.09, v3(0.75, 1, 0.65), v3(0.95, 1, 0.8), -2); }
    } else if m.kind == MS_WEAPON && !flying {
      watch_mace(s, b, m.next);
    }
  }
  // a caster's hands glow as they cast, and a bar over their head fills to the spell
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS {
    a := w[0].actors[i];
    if !a.homed || a.casting < 0 || a.mode == WM_DEAD { continue; }
    feet := folk_feet(s, a.x, a.z);
    hand := v3(a.x + sin(a.yaw) * 0.35, feet + 1.45, a.z + cos(a.yaw) * 0.35);
    colour := ifx a.cast_kind == MS_FROST || a.cast_kind == MS_COLD || a.cast_kind == MS_LIGHTNING then v3(0.7, 0.88, 1)
              else ifx a.cast_kind == MS_HOLD then v3(0.72, 0.45, 1) else ifx a.cast_kind == MS_MAGIC_MISSILE then v3(0.5, 0.78, 1) else ifx a.cast_kind == MS_EARTHBIND then v3(1, 0.85, 0.2)
              else ifx a.cast_kind == MS_HEAL || a.cast_kind == MS_GUIDING || a.cast_kind == MS_WEAPON then v3(1, 0.93, 0.6) else v3(1, 0.6, 0.2);
    sp_add_spark(s, add(hand, times(sp_spray(s, 0), 0.12)), v3(0, 0.6, 0), 0.25, 0.07, colour, -1);
    fill := clamp01(a.casting / hi(watch_wind(a.cast_kind), 0.01));
    top := v3(a.x, feet + 2.35, a.z);
    yaw := yaw_of(s[0].sp.shot.eye.x - top.x, s[0].sp.shot.eye.z - top.z);
    shape(s, SHAPE_BOX, LOOK_MATTE, top, yaw, 0, 0.42, 0.045, 0.02, 0.06, 0.06, 0.07);
    ax := v3(cos(yaw), 0, -sin(yaw));
    shape(s, SHAPE_BOX, LOOK_FLAME, add(top, times(ax, -0.4 * (1 - fill))), yaw, 0, 0.4 * fill + 0.001, 0.035, 0.025, colour.x, colour.y, colour.z);
  }
}
// The spears in the air (watch_spear_at): a shaft with a dark head, the way it flies.
watch_spears_draw :: (s: [] Everglade) {
  if !s[0].wv.started { return; }
  w := watch_w(s);
  for k: 0..<SPEARS {
    sp := w[0].spears[k];
    if !sp.live { continue; }
    p := watch_spear_at(sp);
    d := p.dir;
    fl := hi(sqrt(d.x * d.x + d.z * d.z), 0.0001);
    tilt := -atan2(d.y, fl);
    yaw := yaw_of(d.x, d.z);
    shape(s, SHAPE_BOX, LOOK_WOOD, sub(p.at, times(d, 0.55)), yaw, tilt, 0.04, 0.04, 1.6, 0.5, 0.36, 0.22);
    shape(s, SHAPE_CONE, LOOK_MATTE, add(p.at, times(d, 0.3)), yaw, tilt + f32(PI) * 0.5, 0.07, 0.22, 0.07, 0.2, 0.2, 0.22);
  }
}

// The town stands again (the spell bar's Rebuild): the fallen too.
watch_rebuilt :: (s: [] Everglade) -> int {
  everglade_guard_invalidate(s); s[0].guard_ai.generation += 1;
  if !s[0].wv.started { return 0; }
  // R also clears your WANTED stars: the watch stands down and goes back to its posts
  watch_stand_down(watch_w(s));
  return watch_restore(watch_w(s));
}
// ---- damage numbers

// `amount` lost at `at` (over a head, a wall): a red number there, rising and fading over a second,
// a little to one side so hits stacked together don't cover each other; a big blow's bigger.
watch_pop_slot :: (s: [] Everglade) -> int {
  k := 0; oldest := -1.0f32;
  for q: 0..<WATCH_POPS {
    if !s[0].wv.pops[q].live { return q; }
    if s[0].wv.pops[q].t > oldest { oldest = s[0].wv.pops[q].t; k = q; }
  }
  return k;
}
// `amount` healed at `at`: a green +N rising there, and a few green motes.
watch_pop_heal :: (s: [] Everglade, at: Point, amount: int) {
  if amount <= 0 { return; }
  s[0].wv.pops[watch_pop_slot(s)] = WatchPop.{live = true, at = at, t = 0, amount = amount, dx = sp_rand(s) * 2 - 1, heal = true};
  for q: 0..<5 { sp_add_spark(s, add(at, v3(0, -0.7, 0)), times(sp_spray(s, 0), 1.2), 0.5, 0.06, v3(0.45, 1.0, 0.45), -2); }
}
// Word `word` (POP_*) over a head at `at` as a condition lands, a little above the numbers; and a burst
// on the body in the condition's colour.
watch_pop_word :: (s: [] Everglade, at: Point, word: int, nth: int) {
  if word < 0 || word >= POP_WORDS.count { return; }
  s[0].wv.pops[watch_pop_slot(s)] = WatchPop.{live = true, at = add(at, v3(0, 0.35 + 0.3 * f32(nth), 0)), t = 0, dx = 0, word = word};
  c := watch_pop_rgb(word);
  for q: 0..<8 { sp_add_spark(s, add(at, v3(0, -1.0, 0)), times(sp_spray(s, 0), 2.0), 0.45, 0.07, c, 2); }
}
// A word's colour: red down, gold held, yellow stunned, green rooted, earth restrained, frost slowed,
// white up, violet the rest.
watch_pop_rgb :: (word: int) -> Point {
  if word == POP_HELD { return v3(1.0, 0.82, 0.35); }
  if word == POP_ROOTED { return v3(0.4, 0.95, 0.35); }
  if word == POP_RESTRAINED { return v3(0.95, 0.68, 0.3); }
  if word == POP_STUNNED { return v3(1.0, 0.95, 0.4); }
  if word == POP_SLOWED { return v3(0.65, 0.85, 1.0); }
  if word == POP_DOWN { return v3(1.0, 0.3, 0.25); }
  if word == POP_UP { return v3(0.92, 0.95, 0.9); }
  return v3(0.8, 0.55, 1.0);
}
watch_pop :: (s: [] Everglade, at: Point, amount: int, big: bool) {
  if amount <= 0 { return; }
  k := watch_pop_slot(s);
  s[0].wv.pops[k] = WatchPop.{live = true, at = at, t = 0, amount = amount, dx = sp_rand(s) * 2 - 1, big = big};
  egs_blow(s, add(at, v3(0, -0.9, 0)), big);   // the blow's sound (everglade-sound.coax)
  // the blow lands: a spray of red sparks off them
  for q: 0..<(ifx big then 10 else 6) {
    sp_add_spark(s, add(at, v3(0, -0.6, 0)), times(sp_spray(s, 0), 2.5 + 2 * sp_rand(s)), 0.35, 0.06, v3(1.0, 0.22, 0.12), 4);
  }
}
// Over person i's head, where the body is (thrown, it is where it flies).
watch_pop_head :: (s: [] Everglade, i: int) -> Point {
  if s[0].wt[0].actors[i].body.on { b := s[0].wt[0].actors[i].body; return v3(b.x, b.y + 1.1, b.z); }
  pl := person_place(s, i);
  return v3(pl.x, folk_feet(s, pl.x, pl.z) + ab_air(s, i) + 2.05, pl.z);
}
// Once a frame: each one (you too) who has fewer hit points than last frame shows what they lost.
watch_pops_frame :: (s: [] Everglade, dt: f32) {
  for q: 0..<WATCH_POPS {
    if !s[0].wv.pops[q].live { continue; }
    s[0].wv.pops[q].t += dt;
    if s[0].wv.pops[q].t >= f32(POP_LIFE) { s[0].wv.pops[q].live = false; }
  }
  w := watch_w(s);
  for i: 0..<WATCH_ACTORS {
    here := watch_here(w, i);
    life := w[0].actors[i].hp + w[0].actors[i].temp;
    if here && s[0].wv.seen[i].on && life < s[0].wv.seen[i].life {
      lost := s[0].wv.seen[i].life - life;
      watch_pop(s, watch_pop_head(s, i), lost, lost * 4 >= hi_int(w[0].actors[i].max, 1) || lost >= 25);
    }
    s[0].wv.seen[i].life = life; s[0].wv.seen[i].on = here;
  }
  life := watch_you(w[..])[0].hp + watch_you(w[..])[0].temp;
  was := s[0].wv.seen_you;
  if was.on && life < was.life { watch_pop(s, add(ab_you(s), v3(0, 2.1, 0)), was.life - life, (was.life - life) * 4 >= hi_i(watch_you(w[..])[0].max, 1) || was.life - life >= 25); }
  s[0].wv.seen_you = WatchSeen.{life = life, on = !watch_you(w[..])[0].dead};
}
// The numbers, in screen space over where they rose to: red, outlined in their own darker glow.
watch_pops_draw :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  n := at;
  k := hi(s[0].dpr, 0.5);
  buf: [16] u8;
  for q: 0..<WATCH_POPS {
    if !s[0].wv.pops[q].live { continue; }
    p := s[0].wv.pops[q];
    f := clamp01(p.t / f32(POP_LIFE));
    rise := f32(POP_RISE) * (1 - (1 - f) * (1 - f));
    sc := on_screen(u, add(p.at, v3(0, rise, 0)), s[0].width, s[0].height);
    if !sc.ok { continue; }
    grow := 1 + 0.4 * clamp01(1 - p.t / 0.12);   // it lands a touch big, then settles
    cap := (ifx p.big then 19.0f32 else 13.0f32) * k * grow;
    m := 0;
    if p.word >= 0 { for ch: POP_WORDS[p.word] { if m < buf.count { buf[m] = ch; m += 1; } } }
    else { buf[0] = ifx p.heal then '+' else '-'; m = put_digits(buf[..], 1, p.amount); }
    line := cast(string) buf[0..<m];
    if p.word >= 0 { cap = 11.0f32 * k * grow; }
    tw := text_width(line, cap);
    fade := clamp01((f32(POP_LIFE) - p.t) / 0.35);
    x := sc.x - tw / 2 + p.dx * 18 * k;
    // a soft dark shade under the digits (everglade.wgsl hud_rect, PLATE_SHADE), so red reads over fire
    // and snow alike, while plates are left over after the bar's (a few kept for what follows)
    if s[0].plate_n < PLATES - 6 {
      plate(s, u, Box.{x0 = x - cap * 0.55, y0 = sc.y - cap * 1.45, x1 = x + tw + cap * 0.55, y1 = sc.y + cap * 0.45}, 0.72 * fade, PLATE_SHADE);
    }
    rgb := ifx p.word >= 0 then watch_pop_rgb(p.word) else ifx p.heal then v3(0.4, 1.0, 0.4) else v3(1.0, 0.16, 0.1);
    body := Ink.{core = (ifx p.big then 1.5f32 else 1.05f32) * k, light = fade, glow = 0.9 * k, red = rgb.x, green = rgb.y, blue = rgb.z, mode = 0, scale = k};
    n = draw_text(out, n, line, x, sc.y, cap, GAP, SPACE, body, false, false);
  }
  return n;
}

// ---- the HUD

// Your HP under MAP, WANTED under it, and the watch's shouts over their heads.
watch_hud :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, top: f32) -> int {
  n := at;
  if !sp_on(s) || s[0].above || !s[0].wv.started { return n; }
  w := watch_w(s);
  k := hi(s[0].dpr, 0.5);
  wd := s[0].width;
  gutter := 16 * k;
  bw := 168 * k; bh := 28 * k;
  b := Box.{x0 = wd - gutter - bw, y0 = top, x1 = wd - gutter, y1 = top + bh};
  plate(s, u, b, 0.82, ifx watch_you(w[..])[0].hurt_t < 0.35 then 2.0f32 else 0.0f32);
  ls := 7 * k;
  n = draw_text(out, n, "HP", b.x0 + 12 * k, b.y1 - 10 * k, ls, GAP, SPACE, ink(k, 0.85, PARCH_R, PARCH_G, PARCH_B), false, false);
  bx0 := b.x0 + 40 * k; bx1 := b.x1 - 14 * k; by := (b.y0 + b.y1) / 2;
  if lit(out, n, bx0, by, bx1, by, 3 * k, 0.22, 0.5 * k, 0.5, 0.42, 0.36, 0) { n += 6; }
  share := clamp01(f32(watch_you(w[..])[0].hp) / f32(hi_i(watch_you(w[..])[0].max, 1)));
  if share > 0 && lit(out, n, bx0, by, bx0 + (bx1 - bx0) * share, by, 3 * k, 0.95, 2.2 * k, WATCH_RED_R, WATCH_RED_G, WATCH_RED_B, 0) { n += 6; }
  if watch_you(w[..])[0].wanted {
    // WANTED, and its level as five stars, lit up to it (watch.coax HEAT_AT)
    cap := 9 * k;
    word := "WANTED";
    pulse := 0.75 + 0.25 * sin(f32(s[0].time) * 6);
    wb := Box.{x0 = b.x0, y0 = b.y1 + 8 * k, x1 = b.x1, y1 = b.y1 + 8 * k + cap + 20 * k};
    plate(s, u, wb, 0.82, 1);
    n = draw_text(out, n, word, wb.x0 + 12 * k, wb.y1 - 10 * k, cap, GAP, SPACE, ink(k, pulse, WATCH_RED_R, WATCH_RED_G, WATCH_RED_B), false, false);
    sr := 6.5 * k;
    cy := (wb.y0 + wb.y1) / 2;
    for q: 0..<5 {
      cx := wb.x1 - 14 * k - sr - f32(4 - q) * (sr * 2 + 3 * k);
      on := q < watch_you(w[..])[0].level;
      for e: 0..<5 {
        a0 := f32(PI) * (-0.5 + 0.8 * f32(e)); a1 := f32(PI) * (-0.5 + 0.8 * f32(e + 1));
        if lit(out, n, cx + cos(a0) * sr, cy + sin(a0) * sr, cx + cos(a1) * sr, cy + sin(a1) * sr, ifx on then 1.6 * k else 0.9 * k,
               ifx on then 0.95f32 else 0.3f32, ifx on then 1.6 * k else 0.0f32,
               ifx on then 0.98f32 else 0.6f32, ifx on then 0.78f32 else 0.55f32, ifx on then 0.3f32 else 0.5f32, 0) { n += 6; }
      }
    }
    // five stars: the bounty on your head, in gold under the stars
    if watch_you(w[..])[0].level >= WANTED_LEVELS {
      bcap := 8 * k;
      tw := text_width(BOUNTY_LINE, bcap);
      pb := Box.{x0 = wb.x1 - tw - 24 * k, y0 = wb.y1 + 6 * k, x1 = wb.x1, y1 = wb.y1 + 6 * k + bcap + 14 * k};
      plate(s, u, pb, 0.82, 1);
      n = draw_text(out, n, BOUNTY_LINE, pb.x0 + 12 * k, pb.y1 - 7 * k, bcap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
    }
  }
  // the shouts: one that would cross a shout already drawn goes above it, so none overlap
  // (the people's names drawn this frame are placed first: a shout goes over a name, never across it)
  placed: [WATCH_ACTORS + LABELS_MAX] Box; placed_n := 0;
  for q: 0..<clamp_w(s[0].wv.name_n, 0, LABELS_MAX) { placed[placed_n] = s[0].wv.names[q]; placed_n += 1; }
  for i: 0..<WATCH_ACTORS {
    a := w[0].actors[i];
    if a.shout < 0 || !handle_present(a.shout_owner) || a.shout_owner!=a.reference || !s[0].wv.head_on[i] { continue; }
    line := ifx a.shout == 100 then BRAVE_SHOUT else ifx a.shout == UP_SHOUT then WATCH_UP_SHOUT else ifx watch_is_guard(i) then WATCH_SHOUT[a.shout % WATCH_SHOUTS] else FOLK_SHOUT[a.shout % FOLK_SHOUTS];
    sc := on_screen(u, add(s[0].wv.heads[i], v3(0, 0.55, 0)), s[0].width, s[0].height);
    if !sc.ok { continue; }
    cap := 8 * k;
    tw := text_width(line, cap);
    sb := shout_box(placed[0..<placed_n], sc.x - tw / 2, sc.y, tw, cap);
    placed[placed_n] = sb; placed_n += 1;
    fade := clamp01((f32(SHOUT_FOR) - a.shout_t) / 0.4);
    n = draw_text(out, n, line, sb.x0, shout_baseline(sb, cap), cap, GAP, SPACE, ink(k, 0.95 * fade, 1, 0.92, 0.82), false, false);
  }
  return n;
}

// A shout's box for a line tw wide whose baseline is at y, raised over every box
// already placed that it would cross (a little air between them).
shout_box :: (placed: [] Box, x: f32, y: f32, tw: f32, cap: f32) -> Box {
  b := Box.{x0 = x - cap * 0.3, y0 = y - cap * 1.5, x1 = x + tw + cap * 0.3, y1 = y + cap * 0.5};
  for tries: 0..<placed.count + 1 {
    crossed := false;
    for j: 0..<placed.count {
      o := placed[j];
      if b.x0 < o.x1 && o.x0 < b.x1 && b.y0 < o.y1 && o.y0 < b.y1 { h := b.y1 - b.y0; b.y1 = o.y0; b.y0 = b.y1 - h; crossed = true; }
    }
    if !crossed { return b; }
  }
  return b;
}
shout_baseline :: (b: Box, cap: f32) -> f32 { return b.y1 - cap * 0.5; }

// Over everything: your fall's dark and YOU DIED.
watch_overlay :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  n := at;
  if !s[0].wv.started { return n; }
  w := watch_w(s);
  dark := watch_dark(w);
  if dark <= 0.001 { return n; }
  wd := s[0].width; ht := s[0].height;
  plate(s, u, Box.{x0 = -60, y0 = -60, x1 = wd + 60, y1 = ht + 60}, dark, 0);
  if watch_died_shown(w) {
    k := hi(s[0].dpr, 0.5);
    cap := 26 * k;
    word := "YOU DIED";
    tw := text_width(word, cap);
    light := clamp01((watch_you(w[..])[0].dead_t - f32(DEATH_FADE) * 0.6) / 0.6);
    n = draw_text(out, n, word, (wd - tw) / 2, ht / 2 + cap / 2, cap, GAP, SPACE, ink(k, 0.95 * light, WATCH_RED_R, WATCH_RED_G * 0.8, WATCH_RED_B * 0.8), false, false);
  }
  return n;
}

// ---- checks

#test "two shouts at one spot never overlap: the second goes above the first" {
  placed: [3] Box;
  a := shout_box(placed[0..<0], 100, 200, 80, 8);
  #assert shout_baseline(a, 8) == 200;
  placed[0] = a;
  b := shout_box(placed[0..<1], 110, 202, 80, 8);
  #assert b.y1 <= a.y0 && !(b.x0 < a.x1 && a.x0 < b.x1 && b.y0 < a.y1 && a.y0 < b.y1);
  placed[1] = b;
  c := shout_box(placed[0..<2], 95, 199, 80, 8);
  for j: 0..<2 { o := placed[j]; #assert !(c.x0 < o.x1 && o.x0 < c.x1 && c.y0 < o.y1 && o.y0 < c.y1); }
  far := shout_box(placed[0..<2], 600, 200, 80, 8);
  #assert shout_baseline(far, 8) == 200;   // apart from the rest: where it was
}

