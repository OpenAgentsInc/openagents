// The Everglade session profile's field-level check (#12844): proto/verse/everglade-session-v6.json
// names each text-wire message, its fields in order, a canonical value for each and the exact frame
// those values make. This program holds the codec (everglade-wire.coax) to that file:
//   - the profile's version, oldest version and pins are the codec's WIRE_VERSION, WIRE_MIN and WIRE_PINS;
//   - every message's values, written with the codec's writer, are its frame byte for byte;
//   - every message with a reader ("read": true) reads its frame back to the same values, field by
//     field, with the reader's ok set;
//   - every "malformed" frame (a field missing, or not a whole number) leaves its reader's ok unset;
//   - the row's fields ("row") are the codec's WS_* in order, and each row fixture (s) names its MASK's
//     fields: written from its base (zeros, or "base") it is the frame, and read onto that base it is
//     the row again ("expect": fields after the delta);
//   - the relay's own frames (y, j, l, t) are written and read by their codec, aethyr/net/relay-wire.coax
//     (their own profile is proto/verse/room-relay-v1.json);
//   - the seat ticket (owner generation and the rest, room-ticket.coax tk_check) reads to "expect" under
//     its key, and each of "refused" is refused;
//   - each named ACK, baseline and lifecycle field ("ack", "lifecycle") is a field of a message above,
//     of the row, or of the ticket.
// The file is the independent expected result: its frames are written by hand, not by this codec.
// Prints a line per message and "profile holds" (exit 0), or what differs and "profile fails" (exit 1).
//   coax/web/tool.sh apps/openagents-web/everglade-wire-profile.coax proto/verse/everglade-session-v6.json
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#import "Basic";
#load "../../everglade/shared/everglade-wire.coax";
#load "../../aethyr/net/relay-wire.coax";   // the relay's own frames (#13245)
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/web/room/room-ticket.coax";   // the seat ticket's reader (owner generation, #12834)

WP_FIELDS :: 24;
// The row's fields by name, each the codec's WS_* (everglade-wire.coax): the profile's "row" must list
// them in the codec's order.
WP_ROW :: [WIRE_SF] string.["kind", "x", "y", "z", "yaw", "vx", "vy", "vz", "g", "clip", "hp", "max", "cond", "owner", "p1", "p2", "temp", "form", "carry", "t0", "dur", "life", "warp"];
WP_ROW_IX :: [WIRE_SF] int.[WS_KIND, WS_X, WS_Y, WS_Z, WS_YAW, WS_VX, WS_VY, WS_VZ, WS_G, WS_CLIP, WS_HP, WS_MAX, WS_COND, WS_OWNER, WS_P1, WS_P2, WS_TEMP, WS_FORM, WS_CARRY, WS_T0, WS_DUR, WS_LIFE, WS_WARP];
wp_row_ix :: (name: string) -> int { for i: 0..<WIRE_SF { if WP_ROW[i] == name { return WP_ROW_IX[i]; } } return -1; }
// A row object's members (row field name: whole number) onto row.
wp_row_obj :: (d: Jv, at: int, row: [] s32) -> bool {
  if at < 0 { return true; }
  for k: 0..<jv_len(d, at) {
    m := jv_at(d, at, k);
    ix := wp_row_ix(jv_key(d, m));
    if ix < 0 { return false; }
    row[ix] = wire_s32(wp_int(jv_raw(d, m)));
  }
  return true;
}
// A row fixture (s ID BACK MASK V ...): its fields after MASK are row fields by name, each a delta
// on its base. Written from the base it is the frame; read onto the base it is the row again.
wp_row_msg :: (d: Jv, e: int, frame: string, f: WpVals) -> bool {
  fl := jv_get(d, e, "fields");
  base: [WIRE_SF] s32; now: [WIRE_SF] s32;
  if f.n < 3 || !wp_row_obj(d, jv_get(d, e, "base"), base[..]) { print("      %: a base field isn't the row's\n", frame); return false; }
  for q: 0..<WIRE_SF { now[q] = base[q]; }
  mask := 0;
  for k: 3..<f.n {
    nb: [16] u8; nn := jv_str(d, jv_at(d, fl, k), nb[..]);
    ix := ifx nn < 0 then -1 else wp_row_ix(cast(string) nb[0..<nn]);
    if ix < 0 { print("      %: field % isn't the row's\n", frame, k); return false; }
    now[ix] = wire_s32(cast(int) base[ix] + wp_int(f.v[k])); mask = mask | (1 << ix);
  }
  if mask != wp_int(f.v[2]) { print("      %: MASK % names other fields than the profile's (%)\n", frame, wp_int(f.v[2]), mask); return false; }
  out: [WIRE_ROW] u8;
  wn := wire_put_s(out[..], 0, wp_int(f.v[0]), wp_int(f.v[1]), base[..], now[..]);
  if cast(string) out[0..<wn] != frame { print("      %: the writer makes %\n", frame, cast(string) out[0..<wn]); return false; }
  r: [1] WireRd; r[0] = wire_rd(frame, 1);
  h := wire_read_s_head(frame, r[..]);
  got: [WIRE_SF] s32;
  wire_read_s_body(frame, r[..], base[..], got[..]);
  same := r[0].ok && h.id == wp_int(f.v[0]) && h.back == wp_int(f.v[1]);
  for q: 0..<WIRE_SF { if got[q] != now[q] { same = false; } }
  want: [WIRE_SF] s32; for q: 0..<WIRE_SF { want[q] = got[q]; }
  if !wp_row_obj(d, jv_get(d, e, "expect"), want[..]) { return false; }
  for q: 0..<WIRE_SF { if want[q] != got[q] { same = false; print("      %: row field % reads %, the profile expects %\n", frame, WP_ROW[q], cast(int) got[q], cast(int) want[q]); } }
  return same;
}
// A relay frame (y, j, l, t): written from its values and read back by the relay's codec (relay-wire.coax).
wp_relay_msg :: (head: string, f: WpVals, frame: string) -> bool {
  out: [RLW_FRAME] u8; n := -1;
  v: [4] int;
  if f.n > 4 { return false; }
  for k: 0..<f.n { v[k] = wp_int(f.v[k]); }
  if head == "y" && f.n == 4 { n = rlw_put_you_gen(out[..], v[0], v[1], v[2], v[3]); }
  else if head == "y" && f.n == 3 { n = rlw_put_you(out[..], v[0], v[1], v[2]); }
  else if head == "j" && f.n == 1 { n = rlw_put_join(out[..], v[0]); }
  else if head == "l" && f.n == 1 { n = rlw_put_left(out[..], v[0]); }
  else if head == "t" && f.n == 2 {
    ping: [32] u8; pn := rlw_put_ping(ping[..], v[0]);
    if !rlw_ping(cast(string) ping[0..<pn]) { return false; }
    n = rlw_put_pong(out[..], cast(string) ping[0..<pn], v[1]);
  }
  if n < 0 || cast(string) out[0..<n] != frame { print("      %: written as %\n", frame, ifx n < 0 then "" else cast(string) out[0..<n]); return false; }
  g := rlw_read(frame);
  if !g.ok || g.kind != head[0] { return false; }
  if head == "t" { return g.sent == v[0] && g.clock == v[1]; }
  if g.seat != v[0] { return false; }
  if head == "y" { return g.others == v[1] && g.clock == v[2] && g.gen_said == (f.n == 4) && (f.n == 3 || g.gen == v[3]); }
  return true;
}
// Whether HEAD.FIELD names a field of a message of the profile, of the row (s.NAME) or of the ticket.
wp_names :: (d: Jv, ref: string) -> bool {
  dot := 0; while dot < ref.count && ref[dot] != '.' { dot += 1; }
  if dot == 0 || dot >= ref.count - 1 { return false; }
  head := ref[0..<dot]; field := ref[dot + 1..<ref.count];
  if head == "s" && wp_row_ix(field) >= 0 { return true; }
  if head == "ticket" { return jv_get(d, jv_get(d, jv_get(d, 0, "ticket"), "expect"), field) >= 0; }
  ms := jv_get(d, 0, "messages");
  for m: 0..<jv_len(d, ms) {
    e := jv_at(d, ms, m);
    hb: [16] u8; hn := jv_str(d, jv_get(d, e, "head"), hb[..]);
    if hn < 0 || cast(string) hb[0..<hn] != head { continue; }
    fl := jv_get(d, e, "fields");
    for k: 0..<jv_len(d, fl) { fb: [32] u8; fnn := jv_str(d, jv_at(d, fl, k), fb[..]); if fnn >= 0 && cast(string) fb[0..<fnn] == field { return true; } }
  }
  return false;
}
// One message's values as the file has them: each a string's text or a number's digits.
WpVals :: struct { v: [WP_FIELDS] string; n: int; }
wp_int :: (s: string) -> int {
  r: [1] WireRd; r[0] = WireRd.{at = 0, ok = true};
  return wire_num(s, r[..]);
}
// The whole number at key of the object at `at`.
wp_key :: (d: Jv, at: int, key: string) -> int { return wp_int(jv_raw(d, jv_get(d, at, key))); }
// Which of the character-state events a head is (everglade-wire.coax WIRE_OWN), or -1.
wp_own :: (head: string) -> int {
  for i: 0..<5 { if head == WIRE_OWN[i] { return i; } }
  return -1;
}
// v's fields as written by the codec's writer for head: the frame's length in out, -1 for an unknown head.
wp_write :: (head: string, f: WpVals, out: [] u8) -> int {
  if head == "P" { return wire_put_pins(out, 0, WirePins.{engine = wp_int(f.v[0]), rules = wp_int(f.v[1]), content = wp_int(f.v[2])}); }
  if head == "H" { return wire_put_hello(out, 0, WireHello.{version = wp_int(f.v[0]), look = f.v[1], kind = f.v[2], flags = wp_int(f.v[3]), name = f.v[4]}); }
  if head == "I" { return wire_put_in(out, 0, WireIn.{seq = wp_int(f.v[0]), kx = wp_int(f.v[1]), ky = wp_int(f.v[2]), px = wp_int(f.v[3]), py = wp_int(f.v[4]), theta = f32(wp_int(f.v[5])) / f32(WIRE_FINE), b = wp_int(f.v[6]), heard = wp_int(f.v[7])}); }
  if head == "C" { return wire_put_cast(out, 0, WireCast.{seq = wp_int(f.v[0]), slot = wp_int(f.v[1]), ax = f32(wp_int(f.v[2])) / 100, ay = f32(wp_int(f.v[3])) / 100, az = f32(wp_int(f.v[4])) / 100, tgt = wp_int(f.v[5]), mode = ifx f.n > 6 then wp_int(f.v[6]) else 0}); }
  if head == "E" { return wire_put_use(out, 0, WireUse.{seq = wp_int(f.v[0]), kind = wp_int(f.v[1]), id = wp_int(f.v[2])}); }
  if head == "R" { return wire_put_rebuild(out, 0, wp_int(f.v[0])); }
  if head == "L" { return wire_put_rest(out, 0, wp_int(f.v[0])); }
  if head == "Z" { return wire_put_rest_ask(out, 0, WireRestAsk.{seq = wp_int(f.v[0]), req = wp_int(f.v[1])}); }   // (#13046)
  if head == "z" { return wire_put_rest_state(out, 0, WireRestState.{seq = wp_int(f.v[0]), code = wp_int(f.v[1]), dice = wp_int(f.v[2])}); }
  if head == "T" { return wire_put_travel(out, 0, wp_int(f.v[0]), f.v[1]); }
  if head == "W" { return wire_put_world(out, 0, WireWorld.{tick = wp_int(f.v[0]), hz = wp_int(f.v[1]), seed = wp_int(f.v[2]), day = wp_int(f.v[3]), weather = wp_int(f.v[4]), budget = wp_int(f.v[5])}); }
  if head == "D" { return wire_put_d(out, 0, WireD.{tick = wp_int(f.v[0]), ack = wp_int(f.v[1]), f = wp_int(f.v[2]), part = wp_int(f.v[3])}); }
  if head == "e cast" { return wire_put_cast_e(out, 0, WireCastE.{ss = wp_int(f.v[0]), slot = wp_int(f.v[1]), ax = f32(wp_int(f.v[2])) / 100, ay = f32(wp_int(f.v[3])) / 100, az = f32(wp_int(f.v[4])) / 100, seed = wp_int(f.v[5]), mode = ifx f.n > 6 then wp_int(f.v[6]) else 0}); }
  if head == "e hit" { return wire_put_hit(out, 0, WireHit.{who = wp_int(f.v[0]), by = wp_int(f.v[1]), amt = wp_int(f.v[2]), kind = wp_int(f.v[3])}); }
  if head == "e stop" { return wire_put_stop(out, 0, wp_int(f.v[0]), wp_int(f.v[1]), f.v[2]); }
  if head == "w" { return wire_put_wanted(out, 0, wp_int(f.v[0]), wp_int(f.v[1])); }
  if head == "r" { return wire_put_refused(out, 0, wp_int(f.v[0]), f.v[1]); }
  if head == "g" && f.n == 1 { return wire_put_go(out, 0, f.v[0]); }
  if head == "g" {   // the raid's state, a D entry (#13364): 15 fields, PLAYERS, then the siege's 4
    if f.n != 15 && f.n != 16 && f.n != 20 { return -1; }
    g := WireRaid.{kind = wp_int(f.v[0]), phase = wp_int(f.v[1]), wave = wp_int(f.v[2]), waves = wp_int(f.v[3]), secs = wp_int(f.v[4]), left = wp_int(f.v[5]), standing = wp_int(f.v[6]),
      slain = wp_int(f.v[7]), square = wp_int(f.v[8]), wards = wp_int(f.v[9]), arch = wp_int(f.v[10]), outcome = wp_int(f.v[11]), folk = wp_int(f.v[12]), levels = wp_int(f.v[13]), cap = wp_int(f.v[14])};
    if f.n > 15 { g.players_said = true; g.players = wp_int(f.v[15]); }
    if f.n > 16 { g.siege = true; g.front = wp_int(f.v[16]); g.town = wp_int(f.v[17]); g.cap_c = wp_int(f.v[18]); g.cap_t = wp_int(f.v[19]); }
    return wire_put_raid(out, 0, g);
  }
  if head == "v" { return wire_put_you(out, 0, WireYou.{ss = wp_int(f.v[0]), level = wp_int(f.v[1]), xp = wp_int(f.v[2]), cap = wp_int(f.v[3]), lo = wp_int(f.v[4]), hi = wp_int(f.v[5]), rest_said = f.n > 6, rest = ifx f.n > 6 then wp_int(f.v[6]) else 0}); }
  if head == "e xp" { return wire_put_xp(out, 0, WireGain.{ss = wp_int(f.v[0]), v = wp_int(f.v[1])}); }
  if head == "e level" { return wire_put_level(out, 0, WireGain.{ss = wp_int(f.v[0]), v = wp_int(f.v[1])}); }
  if wp_own(head) >= 0 { return wire_put_own(out, 0, wp_own(head), WireOwn.{ss = wp_int(f.v[0]), a = wp_int(f.v[1]), b = ifx f.n > 2 then wp_int(f.v[2]) else 0, c = ifx f.n > 3 then wp_int(f.v[3]) else 0}); }
  if head == "e rc" {
    c := WireRc.{id = wp_int(f.v[0]), k = wp_int(f.v[1]), ax = f32(wp_int(f.v[2])) / 100, ay = f32(wp_int(f.v[3])) / 100, az = f32(wp_int(f.v[4])) / 100, seed = wp_int(f.v[5])};
    if f.n > 6 { c.from = true; c.fx = f32(wp_int(f.v[6])) / 100; c.fy = f32(wp_int(f.v[7])) / 100; c.fz = f32(wp_int(f.v[8])) / 100; }
    return wire_put_rc(out, 0, c);
  }
  if head == "e wm" {
    return wire_put_wm(out, 0, WireWm.{kind = wp_int(f.v[0]), caster = wp_int(f.v[1]), foe = wp_int(f.v[2]), ax = f32(wp_int(f.v[3])) / 100, ay = f32(wp_int(f.v[4])) / 100, az = f32(wp_int(f.v[5])) / 100,
      bx = f32(wp_int(f.v[6])) / 100, by = f32(wp_int(f.v[7])) / 100, bz = f32(wp_int(f.v[8])) / 100, flight = wp_int(f.v[9]), life = wp_int(f.v[10])});
  }
  if head == "e mend" { return wire_put_mend(out, 0, wp_int(f.v[0])); }
  if head == "e pburn" { return wire_put_pburn(out, 0, WirePlaced.{i = wp_int(f.v[0]), on = wp_int(f.v[1])}); }
  if head == "e pgone" { return wire_put_pgone(out, 0, wp_int(f.v[0])); }
  if head == "V" { return wire_put_change(out, 0, WireChange.{look = f.v[0], kind = f.v[1]}); }
  if head == "X" {
    if f.n > 0 && f.v[0] == WIRE_X_AT { return wire_put_admin(out, 0, WireAdmin.{verb = f.v[0], x = wp_int(f.v[1]), z = wp_int(f.v[2]), yaw = wp_int(f.v[3])}); }
    return wire_put_admin(out, 0, WireAdmin.{verb = f.v[0], arg = ifx f.n > 1 then f.v[1] else ""});
  }
  if head == "O" { return wire_put_missed(out, 0, wp_int(f.v[0])); }      // (#12902)
  if head == "o" { return wire_put_outcomes(out, 0, wp_int(f.v[0])); }
  if head == "e town" { return wire_put_town(out, 0); }
  if head == "x" { return wire_put_x(out, 0, wp_int(f.v[0])); }
  if head == "n" { return wire_put_n(out, 0, WireN.{ss = wp_int(f.v[0]), id = f.v[1], look = f.v[2], kind = f.v[3], flags = wp_int(f.v[4]), name = f.v[5]}); }
  if head == "K" {
    n := wire_put_blocks(out, 0);
    if f.n == 0 { return wire_text(out, n, ""); }
    for k: 0..<f.n { n = wire_text(out, n, f.v[k]); }
    return n;
  }
  return -1;
}
// A field read: text, or a number written out in num (from at[0] on).
wp_s :: (got: [] WpVals, t: string) { if got[0].n < WP_FIELDS { got[0].v[got[0].n] = t; got[0].n += 1; } }
wp_n :: (got: [] WpVals, num: [] u8, at: [] int, x: int) {
  k := wire_int(num, at[0], x);   // " N"
  if k > at[0] + 1 { wp_s(got, cast(string) num[at[0] + 1..<k]); at[0] = k; } else { wp_s(got, ""); }
}
// The frame t read by head's reader: its fields as text into got (numbers written out in `num`), and
// whether the reader's ok stayed set. False too for a head with no reader.
wp_read :: (head: string, t: string, got: [] WpVals, num: [] u8) -> bool {
  got[0].n = 0; at: [1] int;
  r: [1] WireRd; r[0] = wire_rd(t, head.count);
  if head == "P" { p := wire_read_pins(t, r[..]); wp_n(got, num, at[..], p.engine); wp_n(got, num, at[..], p.rules); wp_n(got, num, at[..], p.content); }
  else if head == "H" { h := wire_read_hello(t, r[..]); wp_n(got, num, at[..], h.version); wp_s(got, h.look); wp_s(got, h.kind); wp_n(got, num, at[..], h.flags); wp_s(got, h.name); }
  else if head == "I" { x := wire_read_in(t, r[..]); wp_n(got, num, at[..], x.seq); wp_n(got, num, at[..], x.kx); wp_n(got, num, at[..], x.ky); wp_n(got, num, at[..], x.px); wp_n(got, num, at[..], x.py); wp_n(got, num, at[..], wire_fine(x.theta)); wp_n(got, num, at[..], x.b); wp_n(got, num, at[..], x.heard); }
  else if head == "C" { c := wire_read_cast(t, r[..]); wp_n(got, num, at[..], c.seq); wp_n(got, num, at[..], c.slot); wp_n(got, num, at[..], wire_cm(c.ax)); wp_n(got, num, at[..], wire_cm(c.ay)); wp_n(got, num, at[..], wire_cm(c.az)); wp_n(got, num, at[..], c.tgt); if c.mode != 0 { wp_n(got, num, at[..], c.mode); } }
  else if head == "E" { u := wire_read_use(t, r[..]); wp_n(got, num, at[..], u.seq); wp_n(got, num, at[..], u.kind); wp_n(got, num, at[..], u.id); }
  else if head == "W" { w := wire_read_world(t, r[..]); wp_n(got, num, at[..], w.tick); wp_n(got, num, at[..], w.hz); wp_n(got, num, at[..], w.seed); wp_n(got, num, at[..], w.day); wp_n(got, num, at[..], w.weather); wp_n(got, num, at[..], w.budget); }
  else if head == "D" { d := wire_read_d(t, r[..]); wp_n(got, num, at[..], d.tick); wp_n(got, num, at[..], d.ack); wp_n(got, num, at[..], d.f); wp_n(got, num, at[..], d.part); }
  else if head == "e cast" { c := wire_read_cast_e(t, r[..]); wp_n(got, num, at[..], c.ss); wp_n(got, num, at[..], c.slot); wp_n(got, num, at[..], wire_cm(c.ax)); wp_n(got, num, at[..], wire_cm(c.ay)); wp_n(got, num, at[..], wire_cm(c.az)); wp_n(got, num, at[..], c.seed); if c.mode != 0 { wp_n(got, num, at[..], c.mode); } }
  else if head == "e hit" { h := wire_read_hit(t, r[..]); wp_n(got, num, at[..], h.who); wp_n(got, num, at[..], h.by); wp_n(got, num, at[..], h.amt); wp_n(got, num, at[..], h.kind); }
  else if head == "Z" { a := wire_read_rest_ask(t, r[..]); wp_n(got, num, at[..], a.seq); wp_n(got, num, at[..], a.req); }
  else if head == "z" { z := wire_read_rest_state(t, r[..]); wp_n(got, num, at[..], z.seq); wp_n(got, num, at[..], z.code); wp_n(got, num, at[..], z.dice); }
  else if head == "L" { wp_n(got, num, at[..], wire_read_rest(t, r[..])); }
  else if head == "w" { w := wire_read_wanted(t, r[..]); wp_n(got, num, at[..], w.ss); wp_n(got, num, at[..], w.level); }
  else if head == "e xp" || head == "e level" { g := wire_read_gain(t, r[..]); wp_n(got, num, at[..], g.ss); wp_n(got, num, at[..], g.v); }
  else if wp_own(head) >= 0 {
    o := wire_read_own(t, r[..], wp_own(head)); own := [3] int.[o.a, o.b, o.c];
    wp_n(got, num, at[..], o.ss); for i: 0..<WIRE_OWN_FIELDS[wp_own(head)] { wp_n(got, num, at[..], own[i]); }
  }
  else if head == "e rc" {
    c := wire_read_rc(t, r[..]);
    for x: [5] int.[c.id, c.k, wire_cm(c.ax), wire_cm(c.ay), wire_cm(c.az)] { wp_n(got, num, at[..], x); }
    wp_n(got, num, at[..], c.seed);
    if c.from { wp_n(got, num, at[..], wire_cm(c.fx)); wp_n(got, num, at[..], wire_cm(c.fy)); wp_n(got, num, at[..], wire_cm(c.fz)); }
  }
  else if head == "e wm" {
    w := wire_read_wm(t, r[..]);
    for x: [11] int.[w.kind, w.caster, w.foe, wire_cm(w.ax), wire_cm(w.ay), wire_cm(w.az), wire_cm(w.bx), wire_cm(w.by), wire_cm(w.bz), w.flight, w.life] { wp_n(got, num, at[..], x); }
  }
  else if head == "e mend" { wp_n(got, num, at[..], wire_read_mend(t, r[..])); }
  else if head == "e pburn" { p := wire_read_pburn(t, r[..]); wp_n(got, num, at[..], p.i); wp_n(got, num, at[..], p.on); }
  else if head == "e pgone" { wp_n(got, num, at[..], wire_read_pgone(t, r[..])); }
  else if head == "g" {
    g := wire_read_raid(t, r[..]);
    for x: [15] int.[g.kind, g.phase, g.wave, g.waves, g.secs, g.left, g.standing, g.slain, g.square, g.wards, g.arch, g.outcome, g.folk, g.levels, g.cap] { wp_n(got, num, at[..], x); }
    if g.players_said || g.siege { wp_n(got, num, at[..], g.players); }
    if g.siege { for x: [4] int.[g.front, g.town, g.cap_c, g.cap_t] { wp_n(got, num, at[..], x); } }
  }
  else if head == "v" {
    y := wire_read_you(t, r[..]);
    for x: [6] int.[y.ss, y.level, y.xp, y.cap, y.lo, y.hi] { wp_n(got, num, at[..], x); }
    if y.rest_said { wp_n(got, num, at[..], y.rest); }
  }
  else if head == "V" { c := wire_read_change(t, r[..]); wp_s(got, c.look); wp_s(got, c.kind); }
  else if head == "X" {
    a := wire_read_admin(t, r[..]);
    wp_s(got, a.verb);
    if a.verb == WIRE_X_AT { wp_n(got, num, at[..], a.x); wp_n(got, num, at[..], a.z); wp_n(got, num, at[..], a.yaw); }
    else if a.arg.count > 0 { wp_s(got, a.arg); }
  }
  else if head == "K" { b := wire_read_blocks(t, r[..]); for i: 0..<b.n { wp_s(got, b.id[i]); } }
  else if head == "n" { w := wire_read_n(t, r[..]); wp_n(got, num, at[..], w.ss); wp_s(got, w.id); wp_s(got, w.look); wp_s(got, w.kind); wp_n(got, num, at[..], w.flags); wp_s(got, w.name); }
  else { return false; }
  return r[0].ok;
}
// The head a malformed frame names: its first word, or its first two for "e ...".
wp_head :: (t: string) -> string {
  e := 0;
  while e < t.count && t[e] != ' ' { e += 1; }
  if e == 1 && t[0] == 'e' && e < t.count { e += 1; while e < t.count && t[e] != ' ' { e += 1; } }
  return t[0..<e];
}

// The row-field mask a list of field names is: bit q for the q-th of the row's fields; -1 for a name
// the row does not have, or one named twice.
wp_fields_mask :: (d: Jv, list: int, row: int) -> int {
  if jv_kind(d, list) != JV_ARRAY || jv_kind(d, row) != JV_ARRAY || jv_len(d, row) != WIRE_SF { return -1; }
  mask := 0; a: [32] u8; b: [32] u8;
  for i: 0..<jv_len(d, list) {
    an := jv_str(d, jv_at(d, list, i), a[..]); at := -1;
    for q: 0..<WIRE_SF { bn := jv_str(d, jv_at(d, row, q), b[..]); if an > 0 && an == bn && cast(string) a[0..<an] == cast(string) b[0..<bn] { at = q; } }
    if at < 0 || (mask & (1 << at)) != 0 { return -1; }
    mask = mask | (1 << at);
  }
  return mask;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("everglade-wire-profile PROFILE.json"); return 2; }
  text: [65536] u8;
  n := fs_read(args_at(a[..], 0), text[..]);
  if n <= 0 { tool_errln("everglade-wire-profile: can't read the profile"); return 2; }
  nodes: [4096] JvNode; j: [1] Jv;
  if !jv_parse(j[..], cast(string) text[0..<n], nodes[..]) { tool_errln("everglade-wire-profile: the profile isn't JSON"); return 2; }
  d := j[0];
  bad := 0;
  // the identity: the version, the oldest version and the pins the codec speaks
  pins := jv_get(d, 0, "pins");
  fm := jv_get(d, 0, "frame_most");
  same := wp_key(d, 0, "version") == WIRE_VERSION && wp_key(d, 0, "min") == WIRE_MIN
          && wp_key(d, pins, "engine") == WIRE_ENGINE && wp_key(d, pins, "rules") == WIRE_RULES && wp_key(d, pins, "content") == WIRE_CONTENT
          && wp_key(d, fm, "page") == WIRE_FRAME && wp_key(d, fm, "server") == WIRE_SERVER_FRAME;
  print("%  identity: version %, min %, pins %.%.%\n", ifx same then "ok  " else "FAIL", WIRE_VERSION, WIRE_MIN, WIRE_ENGINE, WIRE_RULES, WIRE_CONTENT);
  if !same { bad += 1; }
  forest := jv_get(d, 0, "forest");
  forest_ok := wp_key(d, forest, "kind") == WK_TREE && wp_key(d, forest, "entity_base") == WIRE_ID_MADE + WIRE_TREE_EID
    && wp_key(d, forest, "records") == WIRE_TREES - 1 && wp_key(d, forest, "total_slots") == WIRE_SLOTS
    && wp_key(d, forest, "planted") == FOREST_PLANTED && wp_key(d, forest, "bridge_floats") == FOREST_FLOATS;
  print("%  forest identity and capacity\n", ifx forest_ok then "ok  " else "FAIL");
  if !forest_ok { bad += 1; }
  // the creature kinds (#13276): each kind's number, ids, count and row fields are the codec's table
  cr := jv_get(d, 0, "creatures");
  cr_ok := wp_fields_mask(d, jv_get(d, cr, "pose"), jv_get(d, jv_get(d, 0, "row"), "fields")) == WIRE_POSE;
  for q: 0..<2 {
    k := jv_get(d, cr, ifx q == 0 then "monster" else "guard");
    kind := ifx q == 0 then WK_MONSTER else WK_GUARD;
    cr_ok = cr_ok && wp_key(d, k, "kind") == kind && wp_key(d, k, "entity_base") == WIRE_ID_MADE + (ifx q == 0 then WIRE_MON_EID else WIRE_GUARD_EID)
      && wp_key(d, k, "count") == (ifx q == 0 then WIRE_MONS else 1)
      && (wp_fields_mask(d, jv_get(d, k, "fields"), jv_get(d, jv_get(d, 0, "row"), "fields")) | WIRE_POSE) == wire_kind_fields(kind)
      && (wp_fields_mask(d, jv_get(d, k, "fields"), jv_get(d, jv_get(d, 0, "row"), "fields")) & WIRE_POSE) == 0;
  }
  print("%  creature kinds: a monster's and the guard's number, ids and row fields\n", ifx cr_ok then "ok  " else "FAIL");
  if !cr_ok { bad += 1; }
  fixture := jv_get(d, forest, "bridge_fixture_milli"); ranges := jv_get(d, forest, "bridge_ranges"); whole := jv_get(d, forest, "bridge_whole");
  fb: [FOREST_FLOATS] f32;
  bridge_ok := jv_len(d, fixture) == FOREST_FLOATS && jv_len(d, ranges) == FOREST_FLOATS;
  for i: 0..<FOREST_FLOATS { fb[i] = f32(wp_int(jv_raw(d, jv_at(d, fixture, i)))) / 1000; }
  bridge_ok = bridge_ok && forest_valid(fb[..]);
  for i: 0..<FOREST_FLOATS {
    saved := fb[i]; range := jv_at(d, ranges, i);
    if jv_len(d, range) != 2 { bridge_ok = false; continue; }
    for side: 0..<2 {
      fb[i] = f32(wp_int(jv_raw(d, jv_at(d, range, side))));
      bridge_ok = bridge_ok && forest_valid(fb[..]);
      fb[i] += ifx side == 0 then -1.0f32 else 1.0f32;
      bridge_ok = bridge_ok && !forest_valid(fb[..]);
    }
    fb[i] = saved;
  }
  for i: 0..<jv_len(d, whole) {
    field := wp_int(jv_raw(d, jv_at(d, whole, i)));
    if field < 0 || field >= FOREST_FLOATS { bridge_ok = false; continue; }
    saved := fb[field]; fb[field] = 0.5;
    bridge_ok = bridge_ok && !forest_valid(fb[..]); fb[field] = saved;
  }
  print("%  forest whole-record domains\n", ifx bridge_ok then "ok  " else "FAIL");
  if !bridge_ok { bad += 1; }
  strs: [8192] u8; sk := 0;
  ms := jv_get(d, 0, "messages");
  for m: 0..<jv_len(d, ms) {
    e := jv_at(d, ms, m);
    hb: [16] u8; hn := jv_str(d, jv_get(d, e, "head"), hb[..]);
    tb: [WIRE_SERVER_FRAME] u8; tn := jv_str(d, jv_get(d, e, "text"), tb[..]);
    if hn < 0 || tn < 0 { print("FAIL  message %: no head or text\n", m); bad += 1; continue; }
    head := cast(string) hb[0..<hn]; frame := cast(string) tb[0..<tn];
    vs := jv_get(d, e, "values");
    f: WpVals; f.n = jv_len(d, vs);
    if f.n > WP_FIELDS || f.n != jv_len(d, jv_get(d, e, "fields")) { print("FAIL  %: values and fields differ in number\n", frame); bad += 1; continue; }
    for k: 0..<f.n {
      x := jv_at(d, vs, k);
      if jv_kind(d, x) == JV_STRING {
        w := jv_str(d, x, strs[sk..<strs.count]);
        f.v[k] = ifx w < 0 then "" else cast(string) strs[sk..<sk + w]; sk += ifx w < 0 then 0 else w;
      } else { f.v[k] = jv_raw(d, x); }
    }
    db: [8] u8; dn := jv_str(d, jv_get(d, e, "dir"), db[..]);
    if head == "s" || (dn > 0 && cast(string) db[0..<dn] == "relay") {
      held := ifx head == "s" then wp_row_msg(d, e, frame, f) else wp_relay_msg(head, f, frame);
      print("%  % %\n", ifx held then "ok  " else "FAIL", head, frame);
      if !held { bad += 1; }
      continue;
    }
    out: [WIRE_SERVER_FRAME] u8;
    wn := wp_write(head, f, out[..]);
    wrote := wn >= 0 && cast(string) out[0..<wn] == frame;
    read_ok := true;
    if jv_bool(d, jv_get(d, e, "read")) {
      got: [1] WpVals; nb: [256] u8;
      read_ok = wp_read(head, frame, got[..], nb[..]) && got[0].n == f.n;
      for k: 0..<f.n { if read_ok && got[0].v[k] != f.v[k] { read_ok = false; print("      %: field % reads %, the profile says %\n", frame, k, got[0].v[k], f.v[k]); } }
    }
    if !wrote { print("      %: the writer makes %\n", frame, ifx wn < 0 then "nothing" else cast(string) out[0..<wn]); }
    print("%  % %\n", ifx wrote && read_ok then "ok  " else "FAIL", head, frame);
    if !wrote || !read_ok { bad += 1; }
  }
  mal := jv_get(d, 0, "malformed");
  for m: 0..<jv_len(d, mal) {
    tb: [WIRE_SERVER_FRAME] u8; tn := jv_str(d, jv_at(d, mal, m), tb[..]);
    t := ifx tn < 0 then "" else cast(string) tb[0..<tn];
    got: [1] WpVals; nb: [256] u8;
    head := wp_head(t);
    refused := !wp_read(head, t, got[..], nb[..]);
    print("%  malformed: %\n", ifx refused then "ok  " else "FAIL", t);
    if !refused { bad += 1; }
  }
  // the row: the codec's fields, in its order
  rw := jv_get(d, jv_get(d, 0, "row"), "fields");
  rows_ok := jv_len(d, rw) == WIRE_SF;
  for q: 0..<jv_len(d, rw) { rb: [16] u8; rn := jv_str(d, jv_at(d, rw, q), rb[..]); if rn < 0 || wp_row_ix(cast(string) rb[0..<rn]) != q { rows_ok = false; } }
  print("%  row: % fields in the codec's order\n", ifx rows_ok then "ok  " else "FAIL", WIRE_SF);
  if !rows_ok { bad += 1; }
  // the seat ticket
  tk := jv_get(d, 0, "ticket");
  kb: [128] u8; kn := jv_str(d, jv_get(d, tk, "key"), kb[..]);
  key := ifx kn < 0 then "" else cast(string) kb[0..<kn];
  rmb: [32] u8; rmn := jv_str(d, jv_get(d, tk, "room"), rmb[..]);
  ttb: [TICKET_TEXT] u8; ttn := jv_str(d, jv_get(d, tk, "text"), ttb[..]);
  now := jv_int(d, jv_get(d, tk, "now"), 0);
  tc := tk_check(key, ifx ttn < 0 then "" else cast(string) ttb[0..<ttn], ifx rmn < 0 then "" else cast(string) rmb[0..<rmn], now);
  ex := jv_get(d, tk, "expect");
  nb2: [64] u8; nn2 := jv_str(d, jv_get(d, ex, "pid"), nb2[..]);
  mb: [64] u8; mn := jv_str(d, jv_get(d, ex, "name"), mb[..]);
  tk_ok := tc.ok && nn2 >= 0 && cast(string) tc.pid[0..<tc.pid_n] == cast(string) nb2[0..<nn2] && mn >= 0 && cast(string) tc.name[0..<tc.name_n] == cast(string) mb[0..<mn]
           && (ifx tc.admin then 2 else ifx tc.account then 1 else 0) == jv_int(d, jv_get(d, ex, "account"), -1) && tc.shard == jv_int(d, jv_get(d, ex, "shard"), -1)
           && tc.expires == jv_int(d, jv_get(d, ex, "expires"), -1) && tc.hp == jv_int(d, jv_get(d, ex, "hp"), -2) && tc.xp == jv_int(d, jv_get(d, ex, "xp"), -1)
           && tc.wanted == jv_int(d, jv_get(d, ex, "wanted"), -1) && tc.owner == jv_int(d, jv_get(d, ex, "owner"), -1);
  print("%  ticket: owner generation %, shard %, HP %, XP %, WANTED %\n", ifx tk_ok then "ok  " else "FAIL", tc.owner, tc.shard, tc.hp, tc.xp, tc.wanted);
  if !tk_ok { bad += 1; }
  rf := jv_get(d, tk, "refused");
  for m: 0..<jv_len(d, rf) {
    e := jv_at(d, rf, m);
    tb2: [TICKET_TEXT] u8; tn2 := jv_str(d, jv_get(d, e, "text"), tb2[..]);
    rb2: [32] u8; rn2 := jv_str(d, jv_get(d, e, "room"), rb2[..]);
    wb: [64] u8; wn2 := jv_str(d, jv_get(d, e, "why"), wb[..]);
    x := tk_check(key, ifx tn2 < 0 then "" else cast(string) tb2[0..<tn2], ifx rn2 < 0 then "" else cast(string) rb2[0..<rn2], jv_int(d, jv_get(d, e, "now"), 0));
    print("%  ticket refused: %\n", ifx !x.ok then "ok  " else "FAIL", ifx wn2 < 0 then "" else cast(string) wb[0..<wn2]);
    if x.ok { bad += 1; }
  }
  // the named ACK, baseline and lifecycle fields
  for sec: [2] string.["ack", "lifecycle"] {
    o := jv_get(d, 0, sec);
    for m: 0..<jv_len(d, o) {
      ref := jv_key(d, jv_at(d, o, m));
      named := wp_names(d, ref);
      print("%  %: %\n", ifx named then "ok  " else "FAIL", sec, ref);
      if !named { bad += 1; }
    }
  }
  print("%\n", ifx bad == 0 then "profile holds" else "profile fails");
  return ifx bad == 0 then 0 else 1;
}
