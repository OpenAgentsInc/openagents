// Everglade, openagents.com/realms/everglade: the forest city as a grey-box
// blockout you walk, in a forest of kit trees. The layout is verse/everglade/plan.coax's (the plan in
// words is docs/verse/everglade.md): the palisade and its four gates, the
// commons with its fountain and quest board, the market, the inn, the guild
// halls, the temple and the observatory, the stables on the road in, the
// trails out to the deep wood, the ruins, the crypt and the river crossing,
// and where each of the city's characters will stand. The city is boxes,
// cylinders and cones in plain colours, with each place's name over it.
//
// The forest (eg-forest) fills everything past a clear apron round the
// palisade, but for the trails and the clearings at their ends
// (plan.coax everglade_in_woods): trees from the Stylized Nature kit, with
// bushes, ferns and rocks along the tree line, out of the realm's pack
// (verse/packs/everglade.json). The trees near you and in view are the
// kit's meshes; the rest are cones, so a phone draws a few hundred kit
// trees at most. You walk into the woods as anywhere: each trunk and rock
// near you is a round body as wide as its mesh (forest_bodies), and at the
// world's edge (plan.coax EG_BOUND) a thicket of brush and close-set trees
// stands (plant_thicket), where everglade_hold stops you. Nothing you can
// see as open ground is behind an invisible wall.
//
// You walk it with the engine's controller (verse/player.coax, its own
// library) among the plan's solids and see it through the free orbit
// (verse/camera.coax). M (or MAP on a phone) lifts the camera over the city;
// the location's hash starts you at a place (#market, #temple ...) and
// #above opens on the map view. Players can't change the city; an admin
// can, by voice (everglade-voice.coax): what they place is published over
// the plan for everyone.
//
// Its people (eg-people, verse/everglade/people.coax) stand at the plan's
// spots. Walk up to one and press E (or tap TALK) to talk: you type, they
// answer as themselves through the character chat, and they remember you
// (the server keeps what you told each of them, per player). The face sends
// the question this file writes (everglade_ask) and hands back the answer.
//
// The quest board on the commons (eg-quests, verse/everglade/quests.coax):
// E (or the button) at it shows the three quests, takes one and hands it
// in; the step you are on shows under the title, with a mark over where it
// sends you. The stages are kept in this browser for its player (action 4,
// the save slot everglade; message 4 gives them back). Handing in the river
// quest brings the bird flock (eg-companion, verse/flock.coax), drawn here.
//
// The player walks on a flat floor and is drawn at the ground's height
// where it stands, as in the Garden; the ground is verse/terrain.coax's.
// You are the old Everglade's player, the Universal male Ranger of the old
// Rust Verse engine's last pinned pack: its mesh and textures come in the
// realm's pack, its skeleton and clips are verse/everglade/ranger.coax
// (both written by verse/tools/pack_realm.py), and verse/skin.coax plays
// the clip the controller's state picks (idle, walk, run, jump), as the old
// engine did. Its joints' skinning matrices go to the GPU each frame (store
// 2) and everglade.wgsl skins its vertices with them.
// everglade.wgsl draws a ground of cells (store 0, its heights), every
// shape from the vertex index alone (the pack's identity indices) and the
// kit's meshes from the pack's vertices and texture layers (store 1 holds
// every object). everglade-face.c binds it for the browser.
//   coax/bin/coax test apps/openagents-web/everglade.coax --steps 2000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/camera.coax";
#load "../../verse/everglade/plan.coax";
#load "../../verse/everglade/people.coax";
#load "../../verse/everglade/quests.coax";
#load "../../verse/flock.coax";
#load "../../verse/everglade/ranger.coax";
#load "../../verse/everglade/folk.coax";
#load "../../verse/everglade/rumours.coax";
#load "../../verse/everglade/watch.coax";
#load "../../verse/water-weather.coax";
#load "everglade-voice.coax";
#load "everglade-place.coax";
#load "everglade-spells.coax";
#load "everglade-watch.coax";
#load "everglade-guard-ai.coax";
#load "everglade-items.coax";
#load "everglade-dress.coax";
#load "everglade-hammer.coax";
#load "everglade-lod.coax";
#load "everglade-sky.coax";
#load "everglade-room.coax";
#load "everglade-fork.coax";   // FORK, and a fork's rules (docs/verse/realm-fork.md)
#load "everglade-track.coax";   // what players do, for analytics.coax
#load "../../verse/style-preset.coax";

VERTEX_FLOATS :: 16;   // a HUD stroke's vertex, as the Garden's
MAX_VERTICES :: 30000;
PLATES :: 64;   // the spell bar's four rows of slots take most (everglade-spells.coax sp_bar)
// The uniforms: width, height, time, fade, still, plates, dpr, horizon; the
// view's four rows; the eye and the fog's density; the sun and where the
// fog starts; the ground; SHADOWS blobs; PATHS path pieces and their count
// and half width; SQUARES paved discs (x, z, radius, 0); then the plates.
SHADOWS :: 16;
PATHS :: 32;
SQUARES :: 4;
U_VIEW :: 8; U_EYE :: 24; U_SUN :: 28; U_GROUND :: 32; U_SHADOW :: 36;
U_PATH :: U_SHADOW + SHADOWS * 4;
U_PATH_INFO :: U_PATH + PATHS * 4;
U_SQUARE :: U_PATH_INFO + 4;
U_PLATE :: U_SQUARE + SQUARES * 4;
// Then the river's block (everglade.wgsl WaterU), which the face has
// verse/everglade/river.coax write after the frame: verse/water-look.coax
// WATER_FLOATS of them.
U_WATER :: U_PLATE + PLATES * 8;
WATER_FLOATS :: 324;
// The fountain's two numbers in the block's spare W_GRID2 z and w (the river leaves them): the
// ground under it, and 1 when it is drawn (everglade.wgsl fountain_vertex).
U_FOUNTAIN :: U_WATER + 318;
// Then the painterly preset at the clock (verse/style-preset.coax verse_style_at, SU_* rows; everglade.wgsl u.style).
STYLE_AT :: U_WATER + WATER_FLOATS;
// Then where no grass grows (art-styles.md 8): the buildings' and the props' footprints, x0, z0, x1, z1.
SOLIDS :: 32;
U_SOLID :: STYLE_AT + STYLE_FLOATS;
// Then the lamps (lamps()): count, how lit they are (0 by day to 1 at night), 0, 0; then each lamp
// x, y, z, reach (m) and r, g, b, strength, the nearest LIGHTS to the eye (LIGHTS_PHONE on a phone).
U_LIGHT_INFO :: U_SOLID + SOLIDS * 4;
LIGHTS :: 16; LIGHTS_PHONE :: 8;
U_LIGHTS :: U_LIGHT_INFO + 4;
U_WEATHER :: U_LIGHTS + LIGHTS * 8;   // 3 rows: rain, wind x, wind z, lightning; wet, puddles, cloud, fog; rise (m), flow gain, the bridge deck's top (m), the buildings among the solids (weather_frame; the rain's cover)
// The ponds (plan.coax EG_POND): x, z, rim radius and level each (everglade.wgsl pond_vertex).
U_PONDS :: U_WEATHER + 12;
// The water's wakes, particles and the weir's sheet (W6, verse/everglade/river.coax everglade_river_fx
// writes them after the frame): the weir (2 rows), the rowboats' hulls (3), the wakes' trails (16) and
// the particles (64, 2 rows each); river.coax FX_ROWS. everglade.wgsl U.fx.
FX_ROWS :: 149;
U_FX :: U_PONDS + EG_PONDS * 4;
// Then the water the spells hold back (everglade-tide.coax td_uniforms; everglade.wgsl u.tide): Part
// Water's trench (ax, az, bx, bz; its half width), the whirlpool's eye (x, z, radius).
U_TIDE :: U_FX + FX_ROWS * 4;
// Then the spells' marks on the ground (everglade-marks.coax sp_marks; everglade.wgsl u.marks).
U_MARKS :: U_TIDE + TD_U_FLOATS;
UNIFORM_FLOATS :: U_MARKS + MK_FLOATS;

SHAPE_BOX :: 1; SHAPE_SPHERE :: 2; SHAPE_CYLINDER :: 3; SHAPE_CONE :: 4; SHAPE_MESH :: 5; SHAPE_SKINNED :: 6;
SHAPE_VERTICES :: [5] int.[6, 36, 960, 192, 96];
// (the boxes and spheres hold the spells' debris, fire and smoke too: everglade-spells.coax)
SLOTS :: [5] int.[0, 700, 168, 72, 1640];
SLOT_AT :: [5] int.[0, 0, 700, 868, 940];
SHAPE_OBJECTS :: 2580;
// The kit's instances after the shapes, a group each: a tree kind (its
// trunk and its leaves, two meshes drawn over the same instances), a small
// thing of the undergrowth (a bush, a fern, two rocks), then one per piece
// of the town. The forest's eight groups are chosen again every frame; the
// town's are laid once, at the start (build_town).
KIT_TREES :: 4;
KIT_FOREST :: 8;          // the groups the forest fills each frame
KIT_CAP :: 80;            // a forest group's instances
KIT_AT :: SHAPE_OBJECTS;
KIT_GROUPS :: KIT_MESHES - KIT_TREES;
// The town's pieces' instances, a group each, from mesh 12 on.
TOWN_CAP :: [53] int.[
  260, 200, 20, 140, 220, 200, 8, 330, 20, 140,
  16, 12, 760, 328, 100, 12, 4, 8, 16, 30,
  64, 12, 40, 24, 24, 12, 10, 4, 6, 6,
  8, 3, 6, 12, 4, 2, 40, 6, 8, 20,
  0, 0, 0, 0, 0, 0, 0, 100, 0, 0, 0, 40,
  4
];
TOWN_OBJECTS :: 3279;     // the sum of TOWN_CAP
OBJECTS :: SHAPE_OBJECTS + KIT_FOREST * KIT_CAP + TOWN_OBJECTS + EDIT_OBJECTS + SP_DEBRIS_OBJECTS + WATCH_OBJECTS;   // and an admin's placed things (everglade-items.coax), the spells' debris, and the watch's swords and shields (everglade-watch.coax)
RANGER_AT :: OBJECTS;     // you, the Ranger: one object after everything else
// Lathed stone (the fountain's basin and column): a profile turned about its axis (everglade.wgsl
// lathe_vertex), drawn in LATHE_WEDGES instances of LATHE_SECTORS sectors and LATHE_SEGMENTS
// segments each, so an instance stays inside the pack's 1,024 identity indices.
SHAPE_LATHE :: 7;
LATHE_WEDGES :: 8; LATHE_SECTORS :: 6; LATHE_SEGMENTS :: 28;
LATHE_VERTICES :: LATHE_SECTORS * LATHE_SEGMENTS * 6;
LATHE_SLOTS :: 2 * LATHE_WEDGES;
LATHE_AT :: OBJECTS + 1;
PROFILE_BASIN :: 0; PROFILE_COLUMN :: 1;
LOOK_CARVED :: 9;
LOOK_PLANKS :: 11;        // a deck of planks (everglade.wgsl planks): boards, gaps, staggered ends, grain
LOOK_WOOD :: 12;          // sawn timber: grain and a tone per piece         // carved stone: coursed blocks, weathered, wet and mossy at the waterline
// The fountain on the commons (docs/verse/water.md, "The fountain"): its pool's level over the
// ground, and the water's instances after the river's patches (everglade.wgsl fountain_vertex).
FOUNTAIN_POOL :: 0.62;
FOUNTAIN_INSTANCES :: 32;
// and the ponds', after the fountain's: 8 wedges each (everglade.wgsl pond_vertex)
POND_INSTANCES :: EG_PONDS * 8;
// Then the city's people (verse/everglade/folk.coax): each part of the pack's
// a run of PEOPLE_SHOWN instances, one for each person shown wearing it.
PEOPLE_SHOWN :: 10;       // people drawn at once at most, the nearest in view
PEOPLE_SHOWN_PHONE :: 6;
PEOPLE_NEAR :: 60.0;      // metres: nearer than this (and in view) they are drawn
PEOPLE_NEAR_PHONE :: 40.0;
PEOPLE_AT :: LATHE_AT + LATHE_SLOTS;
// Then the spells' debris (everglade-spells.coax sp_shards): a chunk an instance of the mesh it broke
// from, a run per mesh (SHARD_DRAW), then each chunk's cell, the planes that cut it, in two objects
// that are never drawn.
SHARD_AT :: PEOPLE_AT + PEOPLE_PARTS * PEOPLE_SHOWN;
SHARD_OBJECTS :: DEMO_BODIES;
CELL_AT :: SHARD_AT + SHARD_OBJECTS;
// Then the town's small pieces near you, copied there each frame (everglade-lod.coax).
LOD_AT :: CELL_AT + SHARD_OBJECTS * 2;
ALL_OBJECTS :: LOD_AT + LOD_OBJECTS;
// Store 2, the joints' skinning matrices (three rows of four a joint): yours,
// then each person shown's, after theirs three rows of their colours: skin
// (and their outfit's colourway), hair, and the dye on their cloth with how
// much takes (everglade.wgsl case 6u, colour.z PERSON_MARK).
PERSON_ROWS :: PEOPLE_JOINTS * 3 + 3;
// A person is a skinned shape like you, told apart by colour.z (yours is 1).
PERSON_MARK :: 2.0;
PALETTE_FLOATS :: RANGER_JOINTS * 12 + PEOPLE_SHOWN * PERSON_ROWS * 4;
OBJECT_FLOATS :: 16;
LOOK_MATTE :: 0; LOOK_LEAVES :: 1; LOOK_STONE :: 2; LOOK_SKIN :: 3; LOOK_WATER :: 4; LOOK_KIT :: 5;
// The kit's rocks (Rock_Medium_1 and _2: the undergrowth's and the waystone's): the kit's texture, darkened
// and mottled, moss on their tops (everglade.wgsl LOOK_ROCK), so a sunlit face isn't the brightest thing about.
LOOK_ROCK :: 10;
// What glows at night (everglade.wgsl): a lamp's or the brazier's flame (its colour times how lit the
// lamps are, blooming), and the windows, whose glass (the pack's glass_pane) glows warm.
LOOK_FLAME :: 13; LOOK_WINDOW :: 14;   // (11 and 12 are the planks and the sawn wood)
KIT_MESHES :: 65;
KIT_MESH :: [65] string.["Pine_5", "Pine_5_Leaves", "Pine_4", "Pine_4_Leaves", "CommonTree_3", "CommonTree_3_Leaves",
  "CommonTree_4", "CommonTree_4_Leaves", "Bush_Common_Flowers", "Fern_1", "Rock_Medium_1", "Rock_Medium_2",
  "Wall_Plaster_Straight", "Wall_Plaster_Window_Wide_Round", "Wall_Plaster_Door_Round", "Wall_Plaster_WoodGrid",
  "Wall_UnevenBrick_Straight", "Wall_UnevenBrick_Window_Wide_Round", "Wall_UnevenBrick_Door_Round", "Window_Wide_Round1",
  "Door_1_Round", "Corner_Exterior_Wood", "Roof_RoundTiles_6x8", "Roof_Tower_RoundTiles", "Roof_Log", "Floor_WoodDark",
  "Floor_Brick", "Prop_Chimney", "Stair_Interior_Solid", "Stall_Empty", "FarmCrate_Apple", "Barrel", "Crate_Wooden",
  "Table_Large", "Chair_1", "Bench", "Mug", "Shelf_Arch", "Bag", "Anvil", "WeaponStand", "Sword_Bronze", "Shield_Wooden",
  "Cauldron", "Dummy", "Banner_1", "Peg_Rack", "Chalice", "Roof_Front_Brick6", "Scroll_1", "Stairs_Exterior_Platform",
  "Prop_WoodenFence_Single",
  // what an admin may place besides (everglade-items.coax, eg-voice-verbs)
  "Carrot", "Pot_1", "Bucket_Wooden_1", "Stall_Cart_Empty", "Vase_2", "Stool", "Coin_Pile", "Flower_3_Single",
  "Plant_7", "Custom_Pumpkin", "Custom_Rock", "Custom_Bush",
  // the city's cats (eg-paint-people)
  "Custom_Cat"];
// The town's meshes by name.
M_PLASTER :: 12; M_PLASTER_WINDOW :: 13; M_PLASTER_DOOR :: 14; M_PLASTER_GRID :: 15;
M_BRICK :: 16; M_BRICK_WINDOW :: 17; M_BRICK_DOOR :: 18; M_WINDOW :: 19; M_DOOR :: 20; M_CORNER :: 21;
M_ROOF :: 22; M_TOWER_ROOF :: 23; M_LOG :: 24; M_FLOOR_WOOD :: 25; M_FLOOR_BRICK :: 26; M_CHIMNEY :: 27; M_STAIR :: 28;
M_STALL :: 29; M_APPLES :: 30; M_BARREL :: 31; M_CRATE :: 32; M_TABLE :: 33; M_CHAIR :: 34; M_BENCH :: 35; M_MUG :: 36;
M_SHELF :: 37; M_BAG :: 38; M_ANVIL :: 39; M_WEAPONS :: 40; M_SWORD :: 41; M_SHIELD :: 42; M_CAULDRON :: 43; M_DUMMY :: 44;
M_BANNER :: 45; M_PEGS :: 46; M_CHALICE :: 47; M_GABLE :: 48; M_SCROLL :: 49; M_STEP :: 50; M_FENCE :: 51;
M_CARROT :: 52; M_POT :: 53; M_BUCKET :: 54; M_CART :: 55; M_VASE :: 56; M_STOOL :: 57; M_COINS :: 58; M_FLOWER3 :: 59;
M_SPROUT :: 60; M_PUMPKIN :: 61; M_STONE :: 62; M_SHRUB :: 63; M_CAT :: 64;
STOREY :: 3.12;           // a kit wall's height
WALL_FACE :: 0.09;        // how far a wall's outer face stands from its origin (its local +z)
// The shapes' five draws, then a draw per kit mesh, then yours, the
// fountain's stone, then one per part the people wear, then the debris's
// (a draw per kit mesh again), then the river's (last: the host draws it
// after everything else, in two halves).
RANGER_DRAW :: 5 + KIT_MESHES;
LATHE_DRAW :: 5 + KIT_MESHES + 1;
PEOPLE_DRAW :: LATHE_DRAW + 1;
SHARD_DRAW :: PEOPLE_DRAW + PEOPLE_PARTS;
WATER_DRAW :: SHARD_DRAW + KIT_MESHES;
DRAWS :: WATER_DRAW + 1;
// The river's floats, as river.coax everglade_river_floats writes them: x,
// y, z, yaw, how far it tips and which way, 0, and the kind (0 a duck, 1 a lily pad, 2 a rowboat).
FLOATS :: 28;
FLOAT_FLOATS :: 8;
// Your medium in the water (river.coax): ground, wading, swimming, diving.
WATER_GROUND :: 0; WATER_WADING :: 1; WATER_SWIMMING :: 2; WATER_DIVING :: 3;
WATER_BOAT :: 4;          // seated in a rowboat (river.coax MEDIUM_BOAT)
// The water draw's instances after the river's patches: the fountain's, the ponds', the weir's sheet,
// then the particles (everglade.wgsl water_vs), FX_INSTANCES of them, so a phone's 144 vertices an
// instance still hold the 64 (6 vertices each).
FX_INSTANCES :: 3;
WATER_HITS :: 8;
RANGER_NAME :: "player/male-ranger";   // its catalog line (C) in the pack
MSG_PACK :: 605;          // the host's pack progress: "LOADED TOTAL"
MSG_FACTS :: 600;         // the host's page facts, a line each (now=, player=)
ACT_PLAYER :: 5;          // host.js: keep the outbox as the browser's playtest player
OUTBOX :: 1024;
TALK_NEAR :: 2.8;         // metres: near enough to talk
TALK_LINES :: 8;          // the conversation kept for the next question
LINE_BYTES :: 300;
TYPED :: 200;
ASK_BYTES :: 8192;
ANSWER_WAIT :: 30.0;      // seconds before an unanswered question is given up
MSG_KEPT :: 4;            // the host's kept text for this save slot, once at load
MSG_TEXT :: 1;            // host.js: typed or pasted text from the keyboard field (every key a phone types, and a desktop's once the field has focus)
ACT_KEEP :: 4;            // host.js: keep the outbox in this browser (the save slot, everglade)
BOARD_NEAR :: 3.0;        // metres from the quest board's middle that read it
SAVE_BYTES :: 160;
NEWS_TIME :: 4.0;         // seconds a quest's news shows over the hint

WALLS :: 128;          // the player's walls (player.coax WALL numbers each)
// The player's round bodies (player.coax BODY numbers each): the fountain's basin, then the
// bridge's six piles, which stand in a swimmer's way and not a walker's on the deck above them.
BODIES :: 7;
// Then the trunks and rocks round you (forest_bodies), the nearest first: a trunk at waist height
// and a rock's middle and girth from the pack's meshes (verse/packs/everglade.json), at size 1.
FOREST_BODIES :: 24;
FOREST_NEAR :: 3.0;    // metres past its girth that a trunk or rock is in your way
TRUNK_RADIUS :: [4] f32.[0.36, 0.36, 0.48, 0.52];   // Pine_5, Pine_4, CommonTree_3, CommonTree_4
ROCK_SHAPE :: [8] f32.[-0.11, 0.34, 1.40, 1.99,   -0.15, 0.08, 1.30, 1.85];   // Rock_Medium_1, _2: middle x, z, girth, top
// The thicket at the world's edge: two rows of brush (thicket_brush, worked out where it's
// needed, not kept) and a row of close-set trees behind (plant_thicket, among the trees).
THICKET_ROW :: 160;    // brush a row a side, 1.3 m apart
THICKET_BRUSH :: 4 * 2 * THICKET_ROW;
THICKET_NEAR :: 22.0;  // metres: its brush nearer than this is drawn, the nearest first
FOUNTAIN_RADIUS :: 3.32;   // the plinth's (everglade.wgsl lathe_point's basin)
BOXES :: 128;          // the camera's boxes (camera.coax BOX numbers each)
TREES :: 1500;         // the forest: x, z, size, yaw, kind each
TREE_FLOATS :: 5;
SMALLS :: 900;         // the undergrowth along the tree line: the same five numbers
TREE_SPACING :: 4.2;   // metres between trees, before a jitter
KIT_NEAR :: 55.0;      // a tree nearer than this (and in view) may be the kit's
KIT_NEAR_PHONE :: 42.0;
KIT_CAP_PHONE :: 40;   // and a phone draws at most this many of each kind
SMALL_NEAR :: 34.0;

HOLD_FORWARD :: 1; HOLD_BACK :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8; HOLD_RUN :: 16; HOLD_JUMP :: 32;
HOLD_TURN_LEFT :: 64; HOLD_TURN_RIGHT :: 128; HOLD_TILT_UP :: 256; HOLD_TILT_DOWN :: 512; HOLD_DIVE :: 1024;
KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_BACKSPACE :: -3; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7; KEY_SHIFT :: -13;

LOOK_DRAG :: 0.0055;
WHEEL_ZOOM :: 0.006;
NAME_NEAR :: 11.0;     // metres: a character's name shows this near
PLACE_NEAR :: 70.0;    // and a building's or a place's

PARCH_R :: 0.93; PARCH_G :: 0.9; PARCH_B :: 0.82;
GOLD_R :: 0.86; GOLD_G :: 0.72; GOLD_B :: 0.42;

Box :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

Everglade :: struct {
  started: bool;
  guard_ai: EgGuardAi;
  ground_gen: int;   // bumped each time the ground (store 0) is built: the host uploads it then
  // the time of day (realms.json clock: cycle, or ?clock=T pinned): the clock now, how it runs, when it was read
  clock: f32; day: StyleClock; day_from: f64;
  now_s: f64;     // and the page's `now` (s since 1970, -1 none): the shared clock the guards' beats keep
  grass_n: int;   // the blades this frame (everglade_grass_instances)
  time: f64;
  width: f32; height: f32; dpr: f32;
  touch: bool;
  orbit: Orbit;
  held: int;
  drag_on: bool; drag_id: int; drag_x: f32; drag_y: f32;
  look_yaw: f32; look_pitch: f32;
  wheel: f32;
  key_x: f32; key_y: f32; run: bool; jump: bool; dive: bool;
  // you in the river (the face passes verse/everglade/river.coax's Swim on):
  // your medium, how high your feet are in the water, your breath's share
  // and Exhaustion from going without it; the river's draw and its floats
  water: int; swim_feet: f32; breath: f32; gasps: int;
  deck: f32;
  water_vertices: int; water_patches: int; water_triangles: int;
  floats: [FLOATS * FLOAT_FLOATS] f32; float_n: int;
  feet: Point; face: f32; act: int;
  above: bool;              // the map view: the camera over the city
  paint_only: bool;         // a hash ending "+paint" (the style check): the painting without the names over the world
  lift: f32;                // eased toward 1 in the map view, 0 at your shoulder
  sink: f32;                // eased toward 1 while you dive: the camera follows you under
  // the weather (verse/water-weather.coax, W9): the zone's schedule at the world tick, from the
  // page's clock; a ?weather=NAME pin; the sample now, the ground and the river's rise (each second)
  weather: [1] WeatherSchedule; weather_ready: bool; weather_pin: int;
  weather_ms: f64; weather_t0: f64; weather_at: f64;
  sky: Weather; ground: WeatherGround; rise: f32; flow_gain: f32;
  warp: bool;               // the face should put you at spawn (a hash named a place)
  spawn: Point; spawn_face: f32;
  map_button: Box; map_finger: int;
  heights: [EG_GROUND_POINTS] f32;
  ground_store: [EG_GROUND_POINTS * 2] f32;   // store 0: the heights, then the sky each point sees (everglade-sky.coax)
  objects: [ALL_OBJECTS * OBJECT_FLOATS] f32;
  counts: [5] int;
  lathe_n: int;
  draws: [DRAWS * 4] u32;
  walls: [WALLS * 6] f32; wall_n: int;   // and after wall_n the bridge's two rails
  bodies: [(BODIES + AB_STONES * 2 * AB_ST_BODIES + FOREST_BODIES + TF_BODIES) * 7] f32;   // and the Walls of Stone standing (everglade-abilities.coax), then the trunks and rocks round you, and the trunks lying (everglade-forest.coax)
  boxes: [BOXES * 6] f32; box_n: int;
  trees: [TREES * TREE_FLOATS] f32; tree_n: int;
  smalls: [SMALLS * TREE_FLOATS] f32; small_n: int;
  // the pack: its meshes' indices, its identity indices for the shapes, how it streams
  kit_first: [KIT_MESHES] int; kit_count: [KIT_MESHES] int;
  canopy_rgb: [KIT_TREES * 3] f32;   // each kind's leaves' mean colour from the catalog (0 until it says)
  identity_first: int; pack_ready: bool; pack_failed: bool;
  ranger_first: int; ranger_count: int; ranger_word: int;   // its indices and its first vertex's word
  pack_loaded: int; pack_total: int;
  kit_used: [KIT_GROUPS] int;
  kit_tint: [3] f32;        // the tint the next kit pieces take (0: none): a house's own plaster or roof
  // the chimneys (everglade-dress.coax): how many, each one's object, building and demolition piece, and a still frame
  chimney_n: int; chimney_obj: [SMOKE_CHIMNEYS] int; chimney_b: [SMOKE_CHIMNEYS] int; chimney_piece: [SMOKE_CHIMNEYS] int; smoke_still: bool;
  group_at: [KIT_GROUPS] int; group_cap: [KIT_GROUPS] int;
  kit_triangles: int;       // the kit triangles the last frame drew
  forest_triangles: int;    // of which the forest's
  shadow_n: int;
  plate_n: int;
  // talking: who is near, who you talk to, what was said and what you type
  near: int; talk: int;
  near_boat: int;           // the rowboat you may board (river.coax everglade_river_boat_near), -1 none
  boat_ask: bool;           // E (or the prompt) pressed to board it or step ashore (the face takes it)
  boat_start: bool;         // #rowboat: start in the Lantern Pond's rowboat
  frog_spots: [EG_PONDS * 4 * 3] f32;   // each pond's frog's four spots at its water's edge (x, y, z), once worked out
  frog_known: bool;
  // The water on the ground's grid for the debris (verse/demolish.coax demo_step_wet) and the spells
  // (W6, W8): the surface's height (DEMO_DRY none), the current's x and z, 3 numbers a ground point.
  water_grid: [EG_GROUND_POINTS * 3] f32;
  // where the spells and the debris struck the water this frame (x, z, kind, size), for the face to
  // splash on the river (river.coax everglade_river_splash)
  water_hits: [WATER_HITS * 4] f32; hit_n: int;
  line_npc: [TALK_LINES] bool; line_len: [TALK_LINES] int; line_text: [TALK_LINES * LINE_BYTES] u8; line_n: int;
  typed: [TYPED] u8; typed_n: int;
  waiting: bool; waited: f32;
  ask: [ASK_BYTES] u8; ask_n: int;          // a question for the face to send
  heard: [900] u8;                          // what the one you talk to knows: their quest's note and the rumours they have heard
  visit: [24] u8; visit_n: int;             // this visit's stamp: the page facts' now
  talk_button: Box; bye_button: Box; talk_finger: int;
  field: [4] f32;
  prompt: [64] u8; prompt_n: int; head: [64] u8; head_n: int;
  outbox: [OUTBOX] u8; out_n: int; action: int;
  // the quests (eg-quests, verse/everglade/quests.coax): a stage each, which one the HUD
  // follows, the board and what's saved
  stages: [EG_QUESTS] int; focus: int;
  near_board: bool; board: bool; pick: int; thanks: int;
  news_text: [96] u8; news_n: int; mark_text: [32] u8; mark_n: int;
  rows: [EG_QUESTS] Box; act_button: Box; close_button: Box; board_finger: int;
  news: int; news_time: f32;               // the quest whose step just moved, and how long it shows
  talk_quest: int;                         // the quest the one you talk to came into, or -1
  player: [64] u8; player_n: int;          // the page facts' player= (its public id)
  kept: [SAVE_BYTES] u8; kept_n: int;      // the save this browser gave back, read again once the player is known
  dirty: bool;                             // the stages changed: keep them
  flock: bool;                             // the bird flock is yours (the river quest handed in)
  birds: [1] Flock;                        // and where its birds are (verse/flock.coax)
  // you, the Ranger: its rig, its playback and its joints' skinning matrices (store 2)
  rig: [1] Ranger; skin: [1] Skin; palette: [PALETTE_FLOATS] f32;
  // the city's people: how each lives, their poses, their rig, the pack's parts and who is shown
  folk: [EG_SPOTS] Folk; people_rig: [1] People;
  // each one shown's head this frame (for their name over it), and whether they were shown
  heads: [EG_SPOTS] Point; head_on: [EG_SPOTS] bool;
  // a pose for each one shown (a person keeps theirs while shown; one who comes into
  // view takes a pose no one shown holds, and starts it afresh)
  poses: [PEOPLE_SHOWN] Skin; pose_of: [PEOPLE_SHOWN] int;
  part_first: [PEOPLE_PARTS] int; part_count: [PEOPLE_PARTS] int; part_word: [PEOPLE_PARTS] int;
  part_used: [PEOPLE_PARTS] int; shown_n: int; shown: [PEOPLE_SHOWN] int;
  answered: f32;                           // seconds since the one you talk to last said something
  ev: EditVoice;                           // an admin's voice edits and what's published over the plan (everglade-voice.coax)
  room: [1] RoomState;                     // the others in the realm's room and its chat (everglade-room.coax)
  chat: EgChat;
  lod: Lod;                                // the small pieces drawn near you (everglade-lod.coax)
  hm: Hammer;                              // the sledgehammer (everglade-hammer.coax)
  sp: Spells;                              // the spell bar and what breaks (everglade-spells.coax), with the ruleset srd5
  wt: [1] Watch; wv: WatchView;            // the town watch and what the town does about a crime (everglade-watch.coax)
  fk: [] EgFork;                           // FORK, and a fork's rules: the face holds it (everglade-fork.coax everglade_attach_fork)
}

// ---- small things

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.55 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }

put6 :: (out: [] f32, i: int, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) {
  k := i * 6;
  if k + 6 > out.count { return; }
  out[k] = a; out[k + 1] = b; out[k + 2] = c; out[k + 3] = d; out[k + 4] = e; out[k + 5] = f;
}

// ---- the page's state

coaxial_everglade_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_everglade_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_everglade_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

ground_at :: (s: [] Everglade, x: f32, z: f32) -> f32 { return verse_terrain_height(everglade_ground(), s[0].heights[..], x, z); }
// Where you stand: the ground, the bridge's deck over the river, or ice on the water (everglade-frost.coax).
walk_at :: (s: [] Everglade, x: f32, z: f32) -> f32 { return hi(everglade_walk_height(s[0].heights[..], s[0].deck, x, z), fr_floor(s, x, z)); }

// The face's river (verse/everglade/river.coax), each frame before
// everglade_frame: your medium, your feet's height in the water, your
// breath's share and Exhaustion from going without it; its draw (vertices
// a patch and patches, none until it is built) and its floats.
everglade_water :: (s: [] Everglade, medium: int, feet: f32, breath: f32, gasps: int, vertices: int, patches: int, floats: [] f32, float_n: int) #export_c {
  if !s[0].started { everglade_start(s); }
  s[0].water = ifx medium >= WATER_GROUND && medium <= WATER_BOAT then medium else WATER_GROUND;
  s[0].swim_feet = ifx finite(feet) then feet else 0.0f32;
  s[0].breath = ifx finite(breath) then clamp(breath, 0, 1) else 1.0f32;
  s[0].gasps = hi_i(gasps, 0);
  s[0].water_vertices = clamp_i(vertices, 0, 1024); s[0].water_patches = clamp_i(patches, 0, 64);
  n := clamp_i(float_n, 0, FLOATS);
  if floats.count < n * FLOAT_FLOATS { n = floats.count / FLOAT_FLOATS; }
  for i: 0..<n * FLOAT_FLOATS { s[0].floats[i] = floats[i]; }
  s[0].float_n = n;
}
clamp_i :: (a: int, low: int, high: int) -> int { if a < low { return low; } if a > high { return high; } return a; }
// The ground's height under each row's river (the face builds the river from them).
// Then the ponds' rows, x, z, rim radius and level each, after the river's EG_CELLS + 1 levels.
everglade_levels :: (s: [] Everglade, out: [] f32) #export_c {
  if !s[0].started { everglade_start(s); }
  everglade_river_levels(s[0].heights[..], out);
  if out.count >= EG_CELLS + 1 + EG_PONDS * 4 { everglade_pond_rows(s[0].heights[..], out[EG_CELLS + 1..<out.count]); }
}
// On the bridge's deck you walk over the river, not in it.
everglade_on_bridge :: (s: [] Everglade, x: f32, z: f32) -> bool #export_c {
  return x >= EG_BRIDGE[0] && x <= EG_BRIDGE[2] && z >= EG_BRIDGE[1] && z <= EG_BRIDGE[3];
}
// Where the river's uniform block and the eye are in the uniforms.
everglade_water_at :: () -> int #export_c { return U_WATER; }
everglade_fx_at :: () -> int #export_c { return U_FX; }
// The water on the ground's grid (W6, W8): the river's level along its channel (and its current
// south at its mean speed), each pond's still level out to 2 m past its rim; the rest dry.
water_grid_build :: (s: [] Everglade) {
  w := EG_CELLS + 1;
  levels: [EG_CELLS + 1] f32;
  everglade_river_levels(s[0].heights[..], levels[..]);
  ponds: [EG_PONDS * 4] f32;
  everglade_pond_rows(s[0].heights[..], ponds[..]);
  for j: 0..<w {
    for i: 0..<w {
      x := f32(EG_EDGE) + f32(i) * f32(EG_CELL); z := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
      o := (j * w + i) * 3;
      s[0].water_grid[o] = f32(DEMO_DRY); s[0].water_grid[o + 1] = 0; s[0].water_grid[o + 2] = 0;
      if abs(x - f32(EG_RIVER_X)) <= 6 { s[0].water_grid[o] = levels[j]; s[0].water_grid[o + 2] = -0.45; continue; }
      for p: 0..<EG_PONDS {
        dx := x - ponds[p * 4]; dz := z - ponds[p * 4 + 1];
        if ponds[p * 4 + 2] > 0 && dx * dx + dz * dz < (ponds[p * 4 + 2] + 2) * (ponds[p * 4 + 2] + 2) { s[0].water_grid[o] = ponds[p * 4 + 3]; }
      }
    }
  }
}
// The water's surface over (x, z) (the rain's rise on it), or DEMO_DRY where the ground is above it.
water_at :: (s: [] Everglade, x: f32, z: f32) -> f32 {
  sea := demo_water_at(everglade_ground(), s[0].water_grid[..], x, z);
  if sea.x <= f32(DEMO_DRY) + 1 || sea.x <= ground_at(s, x, z) + 0.02 { return f32(DEMO_DRY); }
  return sea.x + s[0].rise;
}
// Which body of water (x, z) is in: 0 the river, 1 to 4 a pond, -1 none (for lightning's reach).
water_body_of :: (x: f32, z: f32) -> int {
  if abs(x - f32(EG_RIVER_X)) <= 6 { return 0; }
  for p: 0..<EG_PONDS {
    dx := x - EG_POND[p * 4]; dz := z - EG_POND[p * 4 + 1];
    if dx * dx + dz * dz < (EG_POND[p * 4 + 2] + 2) * (EG_POND[p * 4 + 2] + 2) { return 1 + p; }
  }
  return -1;
}
// A splash for the face to raise on the river (river.coax SPLASH_* kinds), the oldest dropped when full.
water_hit :: (s: [] Everglade, x: f32, z: f32, kind: int, size: f32) {
  if s[0].hit_n >= WATER_HITS {
    for k: 0..<(WATER_HITS - 1) * 4 { s[0].water_hits[k] = s[0].water_hits[k + 4]; }
    s[0].hit_n = WATER_HITS - 1;
  }
  k := s[0].hit_n * 4;
  s[0].water_hits[k] = x; s[0].water_hits[k + 1] = z; s[0].water_hits[k + 2] = f32(kind); s[0].water_hits[k + 3] = size;
  s[0].hit_n += 1;
}
// The splashes since the face last asked (x, z, kind, size each), and none after.
everglade_water_hits :: (s: [] Everglade, out: [] f32) -> int #export_c {
  n := lo_int(s[0].hit_n, out.count / 4);
  for k: 0..<n * 4 { out[k] = s[0].water_hits[k]; }
  s[0].hit_n = 0;
  return n;
}
// The rowboat you may board this frame (-1 none), from the face.
everglade_boat_near :: (s: [] Everglade, i: int) #export_c { s[0].near_boat = i; }
// True once when a #rowboat hash asked to start you in a boat.
everglade_boat_start :: (s: [] Everglade) -> bool #export_c { a := s[0].boat_start; s[0].boat_start = false; return a; }
// True once when E (or the prompt) asked to board the boat near you or step ashore from yours.
everglade_boat_take :: (s: [] Everglade) -> bool #export_c { a := s[0].boat_ask; s[0].boat_ask = false; return a; }
// Whether a boat prompt shows: one near, or you sit in one, and no one else to talk to.
boat_prompt_on :: (s: [] Everglade) -> bool {
  return !s[0].above && s[0].talk < 0 && !s[0].board && s[0].near < 0 && !s[0].near_board && (s[0].near_boat >= 0 || s[0].water == WATER_BOAT);
}
everglade_eye_at :: () -> int #export_c { return U_EYE; }
// Whether this frame draws for a phone: the river's mesh is coarser there.
everglade_phone :: (s: [] Everglade) -> bool #export_c { return phone(s); }
// Afloat, you may not jump (river.coax: a swimmer has nothing to push from).
everglade_afloat :: (s: [] Everglade) -> bool #export_c { return s[0].water >= WATER_SWIMMING; }

everglade_start :: (s: [] Everglade) {
  s[0].started = true;
  s[0].hm.t = -1; s[0].hm.target = -1; s[0].chat.finger = -1;
  s[0].clock = 0.5; s[0].day.mode = STYLE_CLOCK_FIXED; s[0].day.at = 0.5; s[0].day_from = 0;   // noon until the page says
  ok := everglade_build_ground(s[0].heights[..]);
  s[0].ground_gen += 1;
  s[0].deck = everglade_deck(s[0].heights[..]);
  water_grid_build(s);
  s[0].breath = 1;
  s[0].spawn = v3(f32(EG_SPAWN_X), 0, f32(EG_SPAWN_Z));
  s[0].spawn_face = 0;
  s[0].feet = v3(s[0].spawn.x, ground_at(s, s[0].spawn.x, s[0].spawn.z), s[0].spawn.z);
  s[0].orbit = verse_orbit_start(s[0].feet, 0);
  s[0].map_finger = -1;
  s[0].near = -1; s[0].talk = -1; s[0].talk_finger = -1; s[0].near_boat = -1;
  s[0].focus = -1; s[0].pick = 0; s[0].thanks = -1; s[0].board_finger = -1; s[0].news = -1; s[0].talk_quest = -1;
  ranger_load(s[0].rig[..]);
  s[0].skin[0] = Skin.{};
  people_load(s[0].people_rig[..]);
  for i: 0..<EG_SPOTS { folk_start(s[0].folk[i..<i + 1], i); }
  for k: 0..<PEOPLE_SHOWN { s[0].poses[k] = Skin.{}; s[0].pose_of[k] = -1; }
  s[0].answered = 1000;
  build_scenery(s);
  plant_forest(s);
  plant_thicket(s);
  at := KIT_AT;
  for g: 0..<KIT_GROUPS {
    cap := ifx g < KIT_FOREST then KIT_CAP else TOWN_CAP[g - KIT_FOREST] + edit_cap(g) + spells_cap(g) + watch_cap(g);
    s[0].group_at[g] = at; s[0].group_cap[g] = cap; s[0].kit_used[g] = 0;
    at += cap;
  }
  build_town(s);
  edit_start(s);
  spells_start(s);
  watch_page_start(s);
  sky_store(s);   // the sky each place sees, once the town and the woods stand (everglade-sky.coax)
}

// The player's walls (every solid, from the floor up) and the camera's
// boxes (the palisade, the buildings and the props tall enough to hide
// you), from the plan.
build_scenery :: (s: [] Everglade) {
  solids: [EG_SOLIDS * EG_BOX] f32;
  n := everglade_solids(solids[..]);
  w := 0; bx := 0;
  fp := EG_PROP;
  for i: 0..<n {
    k := i * EG_BOX;
    x0 := solids[k]; z0 := solids[k + 1]; x1 := solids[k + 2]; z1 := solids[k + 3]; h := solids[k + 4];
    // the fountain stands in the way as a round body, its plinth's
    if edit_in_hidden(s, solids[..], k) { continue; }
    fountain := x0 == fp[0] && z0 == fp[1] && x1 == fp[2] && z1 == fp[3];
    if w < WALLS && !fountain { put6(s[0].walls[..], w, x0, 0, z0, x1, h, z1); w += 1; }
    if h > 1.5 && bx < BOXES && x1 - x0 < 150 && z1 - z0 < 150 {
      g := ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2);
      put6(s[0].boxes[..], bx, x0, g - 1, z0, x1, g + h, z1); bx += 1;
    }
  }
  s[0].wall_n = w; s[0].box_n = bx;
  // the bridge's rails, after the walls: in your way only while you are on its deck
  br := EG_BRIDGE;
  for side: 0..<2 {
    z := ifx side == 0 then br[1] + 0.18 else br[3] - 0.18;
    if w + side < WALLS { put6(s[0].walls[..], w + side, br[0], 0, z - 0.12, br[2], 1.05, z + 0.12); }
  }
  // the fountain's basin, round, then the piles (as city draws them)
  put7(s[0].bodies[..], 0, 0, -5, 0, 0, 1, 0, f32(FOUNTAIN_RADIUS));
  for q: 0..<2 {
    px := ifx q == 0 then 87.0f32 else 89.0f32;
    for k: 0..<3 {
      pz := ifx k == 0 then br[1] + 1.4 else ifx k == 1 then -11.0f32 else br[3] - 1.4;
      wide := ifx k == 1 then 0.9f32 else 0.5f32;
      put7(s[0].bodies[..], 1 + q * 3 + k, px, -5, pz, px, 5, pz, wide / 2);
    }
  }
}
put7 :: (out: [] f32, i: int, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, r: f32) {
  k := i * 7;
  out[k] = a; out[k + 1] = b; out[k + 2] = c; out[k + 3] = d; out[k + 4] = e; out[k + 5] = f; out[k + 6] = r;
}

// The forest: a tree every TREE_SPACING metres, jittered by a fixed seed,
// wherever the woods are (plan.coax everglade_in_woods) with a metre clear
// of the open ground round its trunk, and off the river, the crypt and the
// ruins. Along the tree line, bushes, ferns and rocks fill the gaps.
next_seed :: (seed: int) -> int { return (seed * 1103515245 + 12345) % 2147483648; }
rand01 :: (seed: int) -> f32 { return f32(seed) / 2147483648.0; }
woods_all_round :: (x: f32, z: f32, r: f32) -> bool {
  d := r * 0.71;
  return everglade_in_woods(x, z) && everglade_in_woods(x + r, z) && everglade_in_woods(x - r, z) &&
         everglade_in_woods(x, z + r) && everglade_in_woods(x, z - r) &&
         everglade_in_woods(x + d, z + d) && everglade_in_woods(x - d, z - d) &&
         everglade_in_woods(x + d, z - d) && everglade_in_woods(x - d, z + d);
}
off_solids :: (solids: [] f32, count: int, x: f32, z: f32, gap: f32) -> bool {
  for k: 0..<count - 4 { if box_gap(solids, k, x, z) < gap { return false; } }
  return true;
}
put_tree :: (out: [] f32, n: int, x: f32, z: f32, size: f32, yaw: f32, kind: int) {
  o := n * TREE_FLOATS;
  out[o] = x; out[o + 1] = z; out[o + 2] = size; out[o + 3] = yaw; out[o + 4] = f32(kind);
}
plant_forest :: (s: [] Everglade) {
  seed := 12345;
  solids: [EG_SOLIDS * EG_BOX] f32;
  count := everglade_solids(solids[..]);
  n := 0;
  cells := cast(int) (200.0 / f32(TREE_SPACING));
  for j: 0..<cells + 1 {
    for i: 0..<cells + 1 {
      seed = next_seed(seed); jx := rand01(seed);
      seed = next_seed(seed); jz := rand01(seed);
      seed = next_seed(seed); size := 0.75 + rand01(seed) * 0.5;
      seed = next_seed(seed); yaw := rand01(seed) * f32(TAU);
      seed = next_seed(seed); kind := cast(int) (rand01(seed) * f32(KIT_TREES)) % KIT_TREES;
      x := -100 + (f32(i) + 0.2 + jx * 0.6) * f32(TREE_SPACING);
      z := -100 + (f32(j) + 0.2 + jz * 0.6) * f32(TREE_SPACING);
      if n >= TREES || abs(x) > 99.5 || abs(z) > 99.5 { continue; }
      if !woods_all_round(x, z, 1.0) || !off_solids(solids[..], count, x, z, 1.5) || everglade_in_river(x, 1.5) { continue; }
      put_tree(s[0].trees[..], n, x, z, size, yaw, kind);
      n += 1;
    }
  }
  s[0].tree_n = n;
  m := 0;
  step := 2.6f32;
  sides := cast(int) (200.0 / step);
  for j: 0..<sides + 1 {
    for i: 0..<sides + 1 {
      seed = next_seed(seed); jx := rand01(seed);
      seed = next_seed(seed); jz := rand01(seed);
      seed = next_seed(seed); pick := rand01(seed);
      seed = next_seed(seed); yaw := rand01(seed) * f32(TAU);
      x := -100 + (f32(i) + 0.5 + (jx - 0.5) * 0.7) * step;
      z := -100 + (f32(j) + 0.5 + (jz - 0.5) * 0.7) * step;
      if m >= SMALLS || abs(x) > 99.5 || abs(z) > 99.5 { continue; }
      if !woods_all_round(x, z, 0.8) || !off_solids(solids[..], count, x, z, 1.0) || everglade_in_river(x, 0.6) { continue; }
      // only along the tree line: open ground within a few metres
      edge := !everglade_in_woods(x + 3.5, z) || !everglade_in_woods(x - 3.5, z) || !everglade_in_woods(x, z + 3.5) || !everglade_in_woods(x, z - 3.5);
      if !edge { continue; }
      kind := ifx pick < 0.5 then 4 else ifx pick < 0.8 then 5 else ifx pick < 0.9 then 6 else 7;
      put_tree(s[0].smalls[..], m, x, z, 0.7 + jx * 0.6, yaw, kind);
      m += 1;
    }
  }
  s[0].small_n = m;
}

// The world's edge (plan.coax EG_BOUND), shown before you reach it: a front row of brush whose
// leaves come to the bound, a second row behind it, and a row of close-set trees behind both,
// all the way round; where the river runs out, rocks across the water instead of brush.
Brush :: struct { x: f32; z: f32; size: f32; yaw: f32; kind: int; }
// Brush k of THICKET_BRUSH: side k / (2 THICKET_ROW) (south, north, west, east), row, place along.
thicket_brush :: (k: int) -> Brush {
  out: Brush;
  side := k / (2 * THICKET_ROW); row := (k / THICKET_ROW) % 2; i := k % THICKET_ROW;
  seed := next_seed(next_seed(k * 7919 + 7177)); ja := rand01(seed);
  seed = next_seed(seed); jb := rand01(seed);
  seed = next_seed(seed); out.yaw = rand01(seed) * f32(TAU);
  along := -103.5 + (f32(i) + ifx row == 1 then 0.5f32 else 0.0f32) * 1.3;
  d := f32(EG_THICKET) + f32(row) * 1.2 + (ja - 0.5) * 0.3;
  out.x = ifx side < 2 then along else ifx side == 2 then -d else d;
  out.z = ifx side >= 2 then along else ifx side == 0 then -d else d;
  water := everglade_in_river(out.x, 1.0) && side < 2;
  if water && row == 1 { out.kind = -1; return out; }
  if water { out.size = 0.9 + jb * 0.1; out.kind = ifx jb < 0.5 then 6 else 7; return out; }
  out.size = 1.25 + jb * 0.3 + f32(row) * 0.15; out.kind = 4;
  return out;
}
plant_thicket :: (s: [] Everglade) {
  seed := 7177;
  n := s[0].tree_n;
  for side: 0..<4 {
    for i: 0..<83 {
      seed = next_seed(seed); ja := rand01(seed);
      seed = next_seed(seed); jb := rand01(seed);
      seed = next_seed(seed); yaw := rand01(seed) * f32(TAU);
      along := -103.5 + f32(i) * 2.5;
      d := f32(EG_THICKET) + 2.4 + (ja - 0.5) * 0.3;
      x := ifx side < 2 then along else ifx side == 2 then -d else d;
      z := ifx side >= 2 then along else ifx side == 0 then -d else d;
      if (everglade_in_river(x, 1.0) && side < 2) || n >= TREES { continue; }
      kind := ifx jb < 0.75 then cast(int) (jb / 0.375) else 2 + cast(int) ((jb - 0.75) * 8) % 2;
      put_tree(s[0].trees[..], n, x, z, 0.9 + ja * 0.3, yaw, kind);
      n += 1;
    }
  }
  s[0].tree_n = n;
}

// Keeps you inside the world's edge (plan.coax EG_BOUND), where the thicket stands: a step past
// it slides along it. The woods are open; their trunks and rocks stand in your way as bodies.
everglade_hold :: (s: [] Everglade, ox: f32, oz: f32, nx: f32, nz: f32) -> Point #export_c {
  b := f32(EG_BOUND);
  return v3(clamp(nx, -b, b), 0, clamp(nz, -b, b));
}

// A trunk's or a rock's body: middle x, z, girth and top over the ground, for tree t (smalls false)
// or undergrowth t (true); girth 0 for a bush or a fern, which you walk through.
Girth :: struct { x: f32; z: f32; r: f32; top: f32; }
tree_girth :: (s: [] Everglade, list: [] f32, t: int) -> Girth {
  o := t * TREE_FLOATS;
  return girth_of(list[o], list[o + 1], list[o + 2], list[o + 3], cast(int) list[o + 4]);
}
brush_girth :: (k: int) -> Girth { b := thicket_brush(k); return girth_of(b.x, b.z, b.size, b.yaw, b.kind); }
girth_of :: (x: f32, z: f32, size: f32, yaw: f32, kind: int) -> Girth {
  g: Girth;
  g.x = x; g.z = z;
  if kind >= 0 && kind < KIT_TREES { g.r = TRUNK_RADIUS[kind] * size; g.top = 5; return g; }
  if kind != 6 && kind != 7 { return g; }
  k := (kind - 6) * 4;
  lx := ROCK_SHAPE[k] * size; lz := ROCK_SHAPE[k + 1] * size;
  c := cos(yaw); sn := sin(yaw);
  g.x = x + c * lx + sn * lz; g.z = z - sn * lx + c * lz;
  g.r = ROCK_SHAPE[k + 2] * size; g.top = ROCK_SHAPE[k + 3] * size;
  return g;
}

// The trunks and rocks within FOREST_NEAR of (x, z) as round bodies after the others, the
// nearest first: a rock only while it is drawn (the pack in, the undergrowth on).
forest_bodies :: (s: [] Everglade, out: [] f32, at: int, x: f32, z: f32) -> int {
  pick: [64] Girth; far: [64] f32; n := 0;
  rocks := s[0].pack_ready && redit_row_on(s[0].ev.ed[..], "undergrowth");
  for list: 0..<3 {
    count := ifx list == 0 then s[0].tree_n else ifx list == 1 then s[0].small_n else THICKET_BRUSH;
    if list > 0 && !rocks { continue; }
    for t: 0..<count {
      g := ifx list == 0 then tf_girth(s, t, tree_girth(s, s[0].trees[..], t)) else ifx list == 1 then tree_girth(s, s[0].smalls[..], t) else brush_girth(t);
      if g.r <= 0 { continue; }
      dx := g.x - x; dz := g.z - z; reach := g.r + f32(FOREST_NEAR);
      if abs(dx) > reach || abs(dz) > reach { continue; }
      d := sqrt(dx * dx + dz * dz) - g.r;
      if d > f32(FOREST_NEAR) { continue; }
      // keep the nearest 64, then the nearest FOREST_BODIES of them
      if n < 64 { pick[n] = g; far[n] = d; n += 1; continue; }
      worst := 0; for k: 1..<64 { if far[k] > far[worst] { worst = k; } }
      if d < far[worst] { pick[worst] = g; far[worst] = d; }
    }
  }
  kept := 0;
  while kept < FOREST_BODIES && kept < n && (at + kept + 1) * 7 <= out.count {
    best := kept;
    for k: kept + 1..<n { if far[k] < far[best] { best = k; } }
    gb := pick[best]; db := far[best];
    pick[best] = pick[kept]; far[best] = far[kept]; pick[kept] = gb; far[kept] = db;
    y := ground_at(s, gb.x, gb.z);
    put7(out, at + kept, gb.x, y - 1, gb.z, gb.x, y + hi(gb.top - gb.r, 0), gb.z, gb.r);
    kept += 1;
  }
  return kept + tf_bodies(s, out, at + kept, x, z);   // and the trees lying felled (everglade-forest.coax)
}

// ---- the pack (verse/tools/pack_realm.py): its catalog, a line each; the
// realm needs its meshes by name and its identity indices.

word_end :: (line: string, from: int) -> int { e := from; while e < line.count && line[e] != ' ' { e += 1; } return e; }
whole_at :: (line: string, from: int) -> int {
  i := from; while i < line.count && line[i] == ' ' { i += 1; }
  v := 0; any := false;
  while i < line.count && line[i] >= '0' && line[i] <= '9' { v = v * 10 + cast(int) (line[i] - '0'); i += 1; any = true; }
  return ifx any then v else -1;
}
everglade_catalog :: (s: [] Everglade, text: string) #export_c {
  if !s[0].started { everglade_start(s); }
  for m: 0..<KIT_MESHES { s[0].kit_first[m] = 0; s[0].kit_count[m] = 0; }
  for k: 0..<KIT_TREES * 3 { s[0].canopy_rgb[k] = 0; }
  s[0].identity_first = -1;
  s[0].ranger_first = 0; s[0].ranger_count = 0; s[0].ranger_word = 0;
  for k: 0..<PEOPLE_PARTS { s[0].part_first[k] = 0; s[0].part_count[k] = 0; s[0].part_word[k] = 0; }
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    i = e + 1;
    if line.count < 4 || line[1] != ' ' { continue; }
    if line[0] == 'I' {
      first := whole_at(line, 2); after := word_end(line, 2);
      if first >= 0 && whole_at(line, after) >= 1024 { s[0].identity_first = first; }
      continue;
    }
    if line[0] == 'C' {
      // C NAME FIRST COUNT K WORD VERTICES JOINTS: you, if its skeleton is the rig's
      name_end := word_end(line, 2);
      at := name_end; nums: [6] int;
      for k: 0..<6 { nums[k] = whole_at(line, at); at = word_end(line, at + 1); }
      if line[2..<name_end] == RANGER_NAME && nums[0] >= 0 && nums[1] > 0 && nums[3] >= 0 && nums[5] == RANGER_JOINTS {
        s[0].ranger_first = nums[0]; s[0].ranger_count = nums[1]; s[0].ranger_word = nums[3];
      }
      // or a part the people wear, on their skeleton
      for k: 0..<PEOPLE_PARTS {
        if line[2..<name_end] == PEOPLE_PART_NAME[k] && nums[0] >= 0 && nums[1] > 0 && nums[3] >= 0 && nums[5] == PEOPLE_JOINTS {
          s[0].part_first[k] = nums[0]; s[0].part_count[k] = nums[1]; s[0].part_word[k] = nums[3];
        }
      }
      continue;
    }
    if line[0] != 'M' { continue; }
    name_end := word_end(line, 2);
    name := line[2..<name_end];
    first := whole_at(line, name_end);
    count := whole_at(line, word_end(line, name_end + 1));
    for m: 0..<KIT_MESHES { if name == KIT_MESH[m] && first >= 0 && count > 0 { s[0].kit_first[m] = first; s[0].kit_count[m] = count; } }
    // a tree's leaves end their line "canopy SHAPE R G B" (linear thousandths): the far cones take that colour
    c := name_end;
    while c + 7 <= line.count && line[c..<c + 7] != "canopy " { c += 1; }
    if c + 7 <= line.count {
      at := word_end(line, c + 7);
      rgb: [3] int;
      for k: 0..<3 { rgb[k] = whole_at(line, at); at = word_end(line, at + 1); }
      for m: 0..<2 * KIT_TREES {
        if m % 2 == 1 && name == KIT_MESH[m] && rgb[0] >= 0 && rgb[1] >= 0 && rgb[2] >= 0 {
          for k: 0..<3 { s[0].canopy_rgb[(m / 2) * 3 + k] = f32(rgb[k]) / 1000; }
        }
      }
    }
  }
  s[0].pack_ready = s[0].identity_first >= 0;
  spells_catalog(s, text);
}
everglade_pack_failed :: (s: [] Everglade) #export_c { if !s[0].pack_ready { s[0].pack_failed = true; } }
everglade_message :: (s: [] Everglade, kind: int, text: string) #export_c {
  everglade_guard_message(s, kind, text);
  if fork_message(s, kind, text) { return; }
  if everglade_voice_message(s, kind, text) { return; }
  if kind == MSG_TEXT { talk_typed(s, text); return; }
  if kind == MSG_FACTS {
    if !s[0].started { everglade_start(s); }
    take_visit(s, text); take_player(s, text);
    spells_facts(s, text);
    fork_facts(s, text);
    weather_facts(s, text);
    s[0].day = verse_style_clock(fact(text, "clock"), fact(text, "now"), fact(text, "day"));
    s[0].day_from = s[0].time; s[0].clock = s[0].day.at;
    ms := sp_number(fact(text, "now"));
    s[0].now_s = ifx ms >= 0 then ms / 1000.0 else -1.0;
    return;
  }
  if kind == MSG_KEPT {
    n := 0;
    for i: 0..<text.count { if n < SAVE_BYTES { s[0].kept[n] = text[i]; n += 1; } }
    s[0].kept_n = ifx text.count <= SAVE_BYTES then n else 0;
    read_kept(s);
    return;
  }
  if kind != MSG_PACK { return; }
  loaded := whole_at(text, 0);
  total := whole_at(text, word_end(text, 0));
  if loaded >= 0 && total > 0 { s[0].pack_loaded = loaded; s[0].pack_total = total; }
}

everglade_grass_instances :: (s: [] Everglade) -> int #export_c { return s[0].grass_n; }
everglade_walls :: (s: [] Everglade) -> int #export_c { if !s[0].started { everglade_start(s); } return s[0].wall_n; }
// The walls and bodies in your way: on the bridge's deck its rails too, off it the piles too.
everglade_walls_on :: (s: [] Everglade, deck: bool) -> int #export_c { return everglade_walls(s) + (ifx deck then 2 else 0); }
everglade_bodies_on :: (s: [] Everglade, deck: bool) -> int #export_c {
  if !s[0].started { everglade_start(s); }
  return ifx deck then 1 else BODIES + ab_stone_bodies(s, s[0].bodies[..], BODIES);
}
// ---- the reach check: anything drawn that looks reachable is. Over the plan's reach grid
// (EG_REACH_CELL a side inside EG_BOUND, plan.coax), a cell is in the way only where a walker's
// middle can't stand: within RADIUS of a wall too high to step onto, the fountain's basin, or a
// trunk's or a rock's girth (the same bodies forest_bodies puts in your way). Filled from the
// spawn, every other cell must be reached: an open cell left over is ground you can see and
// not get to. The river and the ponds count as open: you swim them.
stamp_round :: (grid: [] u8, x: f32, z: f32, r: f32) {
  c := f32(EG_REACH_CELL); w := f32(EG_REACH_WEST);
  i0 := hi_i(cast(int) floor((x - r - w) / c), 0); i1 := lo_i(cast(int) floor((x + r - w) / c), EG_REACH_N - 1);
  j0 := hi_i(cast(int) floor((z - r - w) / c), 0); j1 := lo_i(cast(int) floor((z + r - w) / c), EG_REACH_N - 1);
  for j: j0..<j1 + 1 {
    for i: i0..<i1 + 1 {
      cx := w + (f32(i) + 0.5) * c - x; cz := w + (f32(j) + 0.5) * c - z;
      if cx * cx + cz * cz < r * r { grid[j * EG_REACH_N + i] = 0; }
    }
  }
}
everglade_walk_open :: (s: [] Everglade, grid: [] u8) {
  for k: 0..<EG_REACH_N * EG_REACH_N { grid[k] = 1; }
  c := f32(EG_REACH_CELL); w := f32(EG_REACH_WEST); pad := f32(EG_RADIUS);
  for b: 0..<s[0].wall_n {
    k := b * 6;
    x0 := s[0].walls[k]; z0 := s[0].walls[k + 2]; x1 := s[0].walls[k + 3]; top := s[0].walls[k + 4]; z1 := s[0].walls[k + 5];
    if top - ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2) <= 0.55 { continue; }   // a top you step onto (player.coax STEP_UP)
    i0 := hi_i(cast(int) floor((x0 - pad - w) / c), 0); i1 := lo_i(cast(int) floor((x1 + pad - w) / c), EG_REACH_N - 1);
    j0 := hi_i(cast(int) floor((z0 - pad - w) / c), 0); j1 := lo_i(cast(int) floor((z1 + pad - w) / c), EG_REACH_N - 1);
    for j: j0..<j1 + 1 {
      for i: i0..<i1 + 1 {
        x := w + (f32(i) + 0.5) * c; z := w + (f32(j) + 0.5) * c;
        dx := hi(hi(x0 - x, x - x1), 0); dz := hi(hi(z0 - z, z - z1), 0);
        if dx * dx + dz * dz < pad * pad { grid[j * EG_REACH_N + i] = 0; }
      }
    }
  }
  stamp_round(grid, 0, 0, f32(FOUNTAIN_RADIUS) + pad);
  rocks := s[0].pack_ready && redit_row_on(s[0].ev.ed[..], "undergrowth");
  for list: 0..<3 {
    count := ifx list == 0 then s[0].tree_n else ifx list == 1 then s[0].small_n else THICKET_BRUSH;
    if list > 0 && !rocks { continue; }
    for t: 0..<count {
      g := ifx list == 0 then tf_girth(s, t, tree_girth(s, s[0].trees[..], t)) else ifx list == 1 then tree_girth(s, s[0].smalls[..], t) else brush_girth(t);
      if g.r > 0 { stamp_round(grid, g.x, g.z, g.r + pad); }
    }
  }
}
// The open ground the fill from the spawn doesn't reach: each patch of unreached open cells a
// metre square or more (a sliver between two trunks is no ground you see), its cells counted and
// the first few patches' middles at `at` (x, z each).
REACH_PATCH :: 4;
everglade_unreached :: (s: [] Everglade, grid: [] u8, queue: [] u32, at: [] f32) -> int {
  everglade_walk_open(s, grid);
  filled := everglade_fill(grid, queue);
  N := EG_REACH_N;
  n := 0; patches := 0;
  for k: 0..<N * N {
    if grid[k] != 1 { continue; }
    // this patch, breadth first, marked 3
    grid[k] = 3; queue[0] = cast(u32) k; head := 0; tail := 1;
    while head < tail {
      c := cast(int) queue[head]; head += 1;
      i := c % N;
      if i > 0 && grid[c - 1] == 1 { grid[c - 1] = 3; queue[tail] = cast(u32) (c - 1); tail += 1; }
      if i < N - 1 && grid[c + 1] == 1 { grid[c + 1] = 3; queue[tail] = cast(u32) (c + 1); tail += 1; }
      if c >= N && grid[c - N] == 1 { grid[c - N] = 3; queue[tail] = cast(u32) (c - N); tail += 1; }
      if c < N * N - N && grid[c + N] == 1 { grid[c + N] = 3; queue[tail] = cast(u32) (c + N); tail += 1; }
    }
    if tail < REACH_PATCH { continue; }
    if patches * 2 + 1 < at.count {
      at[patches * 2] = f32(EG_REACH_WEST) + (f32(k % N) + 0.5) * f32(EG_REACH_CELL);
      at[patches * 2 + 1] = f32(EG_REACH_WEST) + (f32(k / N) + 0.5) * f32(EG_REACH_CELL);
    }
    patches += 1; n += tail;
  }
  return n;
}

// A walker's way from `from` toward `to` among the city's walls and bodies, the trunks and rocks
// round it and the world's edge, as verse/player.coax moves you (a stride a step, then out of each
// body and wall too high to step onto, sideways): where it stands after `steps` steps, or once there.
walk_toward :: (s: [] Everglade, from: Point, to: Point, steps: int) -> Point {
  p := from;
  r := f32(EG_RADIUS);
  for f: 0..<steps {
    dx := to.x - p.x; dz := to.z - p.z; d := sqrt(dx * dx + dz * dz);
    if d < 0.0001 { break; }
    stride := lo(d, 7.5 / 64.0);
    x := p.x + dx / d * stride; z := p.z + dz / d * stride;
    n := everglade_bodies_near(s, false, p.x, p.z);
    for pass: 0..<3 {
      for i: 0..<n {
        k := i * 7;
        bx := s[0].bodies[k] - x; bz := s[0].bodies[k + 2] - z; need := s[0].bodies[k + 6] + r;
        h := sqrt(bx * bx + bz * bz);
        if h >= need || h < 0.0001 { continue; }
        x -= bx / h * (need - h); z -= bz / h * (need - h);
      }
      for b: 0..<s[0].wall_n {
        k := b * 6;
        if s[0].walls[k + 4] <= ground_at(s, x, z) + 0.55 { continue; }
        ex := clamp(x, s[0].walls[k], s[0].walls[k + 3]); ez := clamp(z, s[0].walls[k + 2], s[0].walls[k + 5]);
        e := sqrt((x - ex) * (x - ex) + (z - ez) * (z - ez));
        if e >= r || e < 0.0001 { continue; }
        x += (x - ex) / e * (r - e); z += (z - ez) / e * (r - e);
      }
    }
    p = everglade_hold(s, p.x, p.z, x, z);
  }
  return p;
}

// The same with the trunks and rocks round (x, z), where you stand (forest_bodies).
everglade_bodies_near :: (s: [] Everglade, deck: bool, x: f32, z: f32) -> int #export_c {
  n := everglade_bodies_on(s, deck);
  if deck { return n; }
  return n + forest_bodies(s, s[0].bodies[..], n, x, z);
}
everglade_spawn :: (s: [] Everglade) -> Point #export_c { if !s[0].started { everglade_start(s); } return s[0].spawn; }
everglade_spawn_face :: (s: [] Everglade) -> f32 #export_c { return s[0].spawn_face; }
// True once when the face should put you at the spawn again.
everglade_warp :: (s: [] Everglade) -> bool #export_c { w := s[0].warp; s[0].warp = false; return w; }

// The location's hash: "above" opens on the map; a place's id starts you on
// the street nearest it, facing it.
everglade_hash :: (s: [] Everglade, hash: string) #export_c {
  if !s[0].started { everglade_start(s); }
  everglade_guard_invalidate(s);
  // "road+paint": the view, drawn without the world's names (art-styles.md 15: the style check measures
  // the painting; the names are text like the HUD's plates, and a phone's narrow canvas makes them a big share)
  if hash.count > 6 && hash[hash.count - 6..<hash.count] == "+paint" { s[0].paint_only = true; everglade_hash(s, hash[0..<hash.count - 6]); return; }
  // "gate+float+captain": a staged hunt (docs/verse/everglade.md, the guard captain): you levitating,
  // the nearest guards after you, and the captain's plan rehearsed in the page (no request leaves it)
  if hash.count > 8 && hash[hash.count - 8..<hash.count] == "+captain" { s[0].guard_ai.cap_rehearse = true; s[0].guard_ai.stage_hunt = true; everglade_hash(s, hash[0..<hash.count - 8]); return; }
  if hash.count > 6 && hash[hash.count - 6..<hash.count] == "+float" { s[0].guard_ai.float_up = true; everglade_hash(s, hash[0..<hash.count - 6]); return; }
  // "commons+wanted5": you start wanted at that level (1 to 5), its waves called in (the anti-air check)
  if hash.count > 8 && hash[hash.count - 8..<hash.count - 1] == "+wanted" {
    l := cast(int) hash[hash.count - 1] - cast(int) '0';
    if l >= 1 && l <= WANTED_LEVELS { s[0].wv.want = l; }
    everglade_hash(s, hash[0..<hash.count - 8]); return;
  }
  if hash == "above" || hash == "map" { s[0].above = true; s[0].lift = 1; return; }
  // a pond's bank on its trail's side, facing the water; #rowboat: in the Lantern Pond's boat
  boat := hash == "rowboat";
  for p: 0..<EG_PONDS {
    if hash != EG_POND_ID[p] && !(boat && p == 0) { continue; }
    s[0].boat_start = boat;
    px := EG_POND[p * 4]; pz := EG_POND[p * 4 + 1];
    nodes := EG_NODE_XZ; links := EG_LINK_AB;
    by := verse_path_nearest(nodes[..], links[..], px, pz);
    dx := by.x - px; dz := by.z - pz; d := hi(sqrt(dx * dx + dz * dz), 0.01);
    x := px + dx / d * (EG_POND[p * 4 + 2] + 2); z := pz + dz / d * (EG_POND[p * 4 + 2] + 2);
    s[0].spawn = v3(x, 0, z); s[0].spawn_face = yaw_of(px - x, pz - z);
    s[0].feet = v3(x, ground_at(s, x, z), z);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  // in the river just north of the bridge, facing its piles (the water's views: docs/verse/water.md)
  if hash == "river-wade" {
    s[0].spawn = v3(88, 0, -1.5); s[0].spawn_face = yaw_of(0, -1);
    s[0].feet = v3(88, ground_at(s, 88, -1.5), -1.5);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  // on the west bank above the weir, facing down it into the plunge pool
  if hash == "weir" {
    x := f32(EG_RIVER_X) - 4.5; z := f32(EG_WEIR_Z) + 3;
    s[0].spawn = v3(x, 0, z); s[0].spawn_face = yaw_of(f32(EG_RIVER_X) - x, f32(EG_POOL_Z) - z);
    s[0].feet = v3(x, ground_at(s, x, z), z);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  // the quest board: just north of it, facing it, near enough to read it
  if hash == "quest-board" {
    bm := board_middle();
    s[0].spawn = v3(bm.x, 0, bm.z + 1.5); s[0].spawn_face = f32(PI);
    s[0].feet = v3(bm.x, ground_at(s, bm.x, bm.z + 1.5), bm.z + 1.5);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  for b: 0..<EG_BUILDINGS {
    if !EG_INTERIOR[b] || hash != EG_ROOM_ID[b] { continue; }
    r := room_of(s, b);
    // far enough in that the camera behind you stays in the room
    v := lo(hi(r.depth * 0.5, 5.2), r.depth - 1.5);
    // and off to one side when the door is on the middle line, clear of its open leaf
    k := b * EG_BOX;
    d := everglade_door(b);
    mid := ifx d.side < 2 then (EG_BUILDING[k] + EG_BUILDING[k + 2]) / 2 else (EG_BUILDING[k + 1] + EG_BUILDING[k + 3]) / 2;
    u := ifx abs(d.along - mid) < 1.5 then 1.8f32 else 0.0f32;
    x := r.fx + r.vx * v + r.ux * u; z := r.fz + r.vz * v + r.uz * u;
    s[0].spawn = v3(x, 0, z); s[0].spawn_face = r.face;
    s[0].feet = v3(x, ground_at(s, x, z), z);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  // A person's name ("marta", "old-tam"): beside them, facing them, near enough to talk.
  for i: 0..<EG_SPOTS {
    if !is_person_slug(hash, EG_PERSON[i]) { continue; }
    f := EG_SPOT[i * 3 + 2];
    x := EG_SPOT[i * 3] + sin(f) * 1.6; z := EG_SPOT[i * 3 + 1] + cos(f) * 1.6;
    s[0].spawn = v3(x, 0, z); s[0].spawn_face = wrap_angle(f + f32(PI));
    s[0].feet = v3(x, ground_at(s, x, z), z);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true; s[0].above = false; s[0].lift = 0;
    return;
  }
  for p: 0..<EG_PLACES {
    if hash != EG_PLACE_ID[p] { continue; }
    px := EG_PLACE[p * 2]; pz := EG_PLACE[p * 2 + 1];
    best := 0; most := 1000000.0f32;
    for k: 0..<EG_NODES {
      dx := EG_NODE_XZ[k * 2] - px; dz := EG_NODE_XZ[k * 2 + 1] - pz;
      d := dx * dx + dz * dz;
      if d < most { most = d; best = k; }
    }
    nx := EG_NODE_XZ[best * 2]; nz := EG_NODE_XZ[best * 2 + 1];
    s[0].spawn = v3(nx, 0, nz);
    s[0].spawn_face = ifx most > 1 then yaw_of(px - nx, pz - nz) else 0.0f32;
    s[0].feet = v3(nx, ground_at(s, nx, nz), nz);
    s[0].orbit = verse_orbit_start(s[0].feet, s[0].spawn_face);
    s[0].warp = true;
    s[0].above = false; s[0].lift = 0;
    return;
  }
}

// A person's name as a hash: lowercase, a space a dash ("Old Tam": "old-tam").
is_person_slug :: (hash: string, name: string) -> bool {
  if hash.count != name.count { return false; }
  for i: 0..<name.count {
    c := name[i];
    want := ifx c == ' ' then cast(u8) '-' else ifx c >= 'A' && c <= 'Z' then cast(u8) (c + 32) else c;
    if hash[i] != want { return false; }
  }
  return true;
}

// ---- the controls

hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_FORWARD; }
  if key == 's' || key == 'S' { return HOLD_BACK; }
  if key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == KEY_SHIFT { return HOLD_RUN; }
  if key == ' ' { return HOLD_JUMP; }
  if key == 'c' || key == 'C' { return HOLD_DIVE; }
  if key == KEY_LEFT { return HOLD_TURN_LEFT; }
  if key == KEY_RIGHT { return HOLD_TURN_RIGHT; }
  if key == KEY_UP { return HOLD_TILT_UP; }
  if key == KEY_DOWN { return HOLD_TILT_DOWN; }
  return 0;
}

everglade_key :: (s: [] Everglade, key: int, mods: int) -> bool #export_c {
  if !s[0].started { everglade_start(s); }
  if s[0].talk >= 0 { return talk_key(s, key, mods); }
  if s[0].chat.typing { return chat_key(s, key, mods); }
  if s[0].board { return board_key(s, key, mods); }
  if everglade_voice_key(s, key, true) { return true; }
  if spells_key(s, key, mods) { return true; }
  if (key == 'e' || key == 'E') && s[0].near_board && !s[0].above { open_board(s); return true; }
  if (key == 'e' || key == 'E') && s[0].near >= 0 && !s[0].above { talk_to(s, s[0].near); return true; }
  if (key == 'e' || key == 'E') && boat_prompt_on(s) { s[0].boat_ask = true; return true; }
  if (key == 'e' || key == 'E') && hm_prompt_on(s) && !s[0].above { _ := hm_swing(s); return true; }
  if key == '+' || key == '=' { s[0].orbit = verse_orbit_zoom(s[0].orbit, -0.8); return true; }
  if key == '-' || key == '_' { s[0].orbit = verse_orbit_zoom(s[0].orbit, 0.8); return true; }
  if key == 'm' || key == 'M' { everglade_guard_invalidate(s); s[0].above = !s[0].above; return true; }
  if key == KEY_ESCAPE && s[0].above { s[0].above = false; return true; }
  if key == KEY_ENTER && !s[0].above && !s[0].ev.editing { chat_open(s); return true; }   // the room's chat (everglade-room.coax)
  b := hold_bit(key);
  if b == 0 { return false; }
  s[0].held = s[0].held | b;
  return true;
}

everglade_key_up :: (s: [] Everglade, key: int, mods: int) -> bool #export_c {
  if everglade_voice_key(s, key, false) { return true; }
  if spells_key_up(s, key, mods) { return true; }
  b := hold_bit(key);
  if b == 0 { return false; }
  if s[0].held & b != 0 { s[0].held = s[0].held - b; }
  return true;
}

everglade_blur :: (s: [] Everglade) #export_c { everglade_guard_focus(s, false); s[0].held = 0; s[0].drag_on = false; s[0].map_finger = -1; s[0].talk_finger = -1; s[0].board_finger = -1; }

in_box :: (b: Box, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

// A mouse drag turns the camera; a finger on MAP presses it; any other
// finger is the face's (the sticks), so this says it isn't used.
everglade_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if !s[0].started { everglade_start(s); }
  if s[0].board { return board_pointer(s, x, y, phase, id); }
  if fork_pointer(s, x, y, phase, id) { return true; }
  if talk_pointer(s, x, y, phase, id) { return true; }
  if chat_pointer(s, x, y, phase, id) { return true; }
  if everglade_voice_pointer(s, x, y, phase, id) { return true; }
  if spells_pointer(s, x, y, phase, kind, id) { return true; }
  if kind != 0 {
    s[0].touch = true;
    if phase == 0 && in_box(s[0].map_button, x, y) { s[0].map_finger = id; return true; }
    if id != s[0].map_finger { return false; }
    if phase == 2 && in_box(s[0].map_button, x, y) { everglade_guard_invalidate(s); s[0].above = !s[0].above; }
    if phase >= 2 { s[0].map_finger = -1; }
    return true;
  }
  k := hi(s[0].dpr, 0.5);
  if phase == 0 && in_box(s[0].map_button, x, y) { everglade_guard_invalidate(s); s[0].above = !s[0].above; return true; }
  if phase == 0 { s[0].drag_on = true; s[0].drag_id = id; s[0].drag_x = x; s[0].drag_y = y; return true; }
  if !s[0].drag_on || id != s[0].drag_id { return false; }
  if phase == 1 {
    s[0].look_yaw -= (x - s[0].drag_x) / k * f32(LOOK_DRAG);
    s[0].look_pitch -= (y - s[0].drag_y) / k * f32(LOOK_DRAG);
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  s[0].drag_on = false;
  return true;
}

everglade_wheel :: (s: [] Everglade, dy: f32) #export_c {
  if finite(dy) { s[0].orbit = verse_orbit_zoom(s[0].orbit, clamp(dy, -400, 400) * f32(WHEEL_ZOOM)); }
}

axis :: (held: int, plus: int, minus: int) -> f32 {
  a := 0.0f32;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}

everglade_controls :: (s: [] Everglade, dt: f32, dyaw: f32, dpitch: f32) #export_c {
  if !s[0].started { everglade_start(s); }
  h := s[0].held;
  s[0].key_x = axis(h, HOLD_RIGHT, HOLD_LEFT);
  s[0].key_y = axis(h, HOLD_FORWARD, HOLD_BACK);
  s[0].run = h & HOLD_RUN != 0;
  s[0].jump = h & HOLD_JUMP != 0;
  s[0].dive = h & HOLD_DIVE != 0;
  o := verse_orbit_look(s[0].orbit, s[0].look_yaw + dyaw, s[0].look_pitch + dpitch);
  o = verse_orbit_keys(o, axis(h, HOLD_TURN_LEFT, HOLD_TURN_RIGHT), axis(h, HOLD_TILT_UP, HOLD_TILT_DOWN), dt);
  s[0].orbit = o;
  s[0].look_yaw = 0; s[0].look_pitch = 0;
}

// First person (zoomed in past the closest): the eye is in your head, so your body isn't drawn;
// the map's lift takes the eye out again.
you_inside :: (s: [] Everglade) -> bool { return verse_orbit_inside(s[0].orbit) && s[0].lift < 0.5; }

everglade_player_theta :: (s: [] Everglade) -> f32 #export_c { return wrap_angle(s[0].orbit.yaw + f32(PI)); }

// ---- talking (eg-people)

// The page facts' now=: this visit's stamp, so the server tells this visit's
// words from an earlier visit's.
// One page fact's value (key=value lines), or "" without it.
fact :: (facts: string, key: string) -> string {
  i := 0;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    if e - i > key.count && facts[i + key.count] == '=' && facts[i..<i + key.count] == key { return facts[i + key.count + 1..<e]; }
    i = e + 1;
  }
  return "";
}
take_visit :: (s: [] Everglade, text: string) {
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    i = e + 1;
    if line.count < 5 || line[0..<4] != "now=" { continue; }
    n := 0;
    for k: 4..<line.count { if n < 24 && line[k] >= '0' && line[k] <= '9' { s[0].visit[n] = line[k]; n += 1; } }
    s[0].visit_n = n;
  }
}

// The page facts' player=: the browser's playtest player, whose quests these are.
take_player :: (s: [] Everglade, text: string) {
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    i = e + 1;
    if line.count < 7 || line[0..<7] != "player=" { continue; }
    n := 0;
    for k: 7..<line.count { if n < 64 { s[0].player[n] = line[k]; n += 1; } }
    s[0].player_n = n;
    read_kept(s);
  }
}
player_id :: (s: [] Everglade) -> string { return cast(string) s[0].player[0..<s[0].player_n]; }

// The kept save, read for this player: someone else's leaves every quest new.
read_kept :: (s: [] Everglade) {
  if s[0].kept_n == 0 { return; }
  if !eg_quest_load(cast(string) s[0].kept[0..<s[0].kept_n], s[0].stages[..], player_id(s)) {
    for q: 0..<EG_QUESTS { s[0].stages[q] = 0; }
  }
  s[0].flock = eg_quest_has_flock(s[0].stages[..]);
}

// The stages changed: the next frame keeps them (action 4), unless the outbox is taken.
keep_quests :: (s: [] Everglade) {
  if !s[0].dirty || s[0].action != 0 { return; }
  n := eg_quest_save(s[0].outbox[..], s[0].stages[..], player_id(s));
  if n == 0 { return; }
  s[0].out_n = n; s[0].action = ACT_KEEP; s[0].dirty = false;
  // what's kept is what a facts message reads again
  for i: 0..<n { if i < SAVE_BYTES { s[0].kept[i] = s[0].outbox[i]; } }
  s[0].kept_n = ifx n <= SAVE_BYTES then n else 0;
}

// The quest the HUD follows: the one you last moved on, else the first under way.
follow :: (s: [] Everglade) -> int {
  f := s[0].focus;
  if f >= 0 && f < EG_QUESTS && eg_quest_at(f, s[0].stages[f]) >= 0 { return f; }
  for q: 0..<EG_QUESTS { if eg_quest_at(q, s[0].stages[q]) >= 0 { return q; } }
  return -1;
}
quest_moved :: (s: [] Everglade, q: int) {
  s[0].dirty = true; s[0].focus = q; s[0].news = q; s[0].news_time = f32(NEWS_TIME);
  s[0].flock = eg_quest_has_flock(s[0].stages[..]);
}

// A quest is on the board while the one who gave it out is in the city
// (an admin may take people away: everglade-voice.coax, quests.coax eg_quest_open).
on_board :: (s: [] Everglade, q: int) -> bool { return eg_quest_open(q, s[0].ev.edits.gone); }
// The k'th quest on the board, or -1; and how many are on it.
board_nth :: (s: [] Everglade, k: int) -> int {
  m := 0;
  for q: 0..<EG_QUESTS { if !on_board(s, q) { continue; } if m == k { return q; } m += 1; }
  return -1;
}
board_count :: (s: [] Everglade) -> int { m := 0; for q: 0..<EG_QUESTS { if on_board(s, q) { m += 1; } } return m; }
board_place :: (s: [] Everglade, q: int) -> int { m := 0; for r: 0..<q { if on_board(s, r) { m += 1; } } return m; }

// The board: open it on the first quest that wants something of you.
open_board :: (s: [] Everglade) {
  s[0].board = true; s[0].held = 0; s[0].thanks = -1; s[0].pick = board_nth(s, 0);
  for q: 0..<EG_QUESTS { if on_board(s, q) && eg_quest_ready(q, s[0].stages[q]) { s[0].pick = q; return; } }
  for q: 0..<EG_QUESTS { if on_board(s, q) && s[0].stages[q] == 0 { s[0].pick = q; return; } }
}
close_board :: (s: [] Everglade) { s[0].board = false; s[0].board_finger = -1; }
// The picked quest's one thing to do on the board: take it, or hand it in.
board_word :: (s: [] Everglade) -> string {
  q := s[0].pick;
  if q < 0 || q >= EG_QUESTS { return ""; }
  if s[0].stages[q] == 0 { return "TAKE IT"; }
  if eg_quest_ready(q, s[0].stages[q]) { return "HAND IT IN"; }
  return "";
}
board_act :: (s: [] Everglade) {
  q := s[0].pick;
  gone := s[0].ev.edits.gone;
  if eg_quest_take(s[0].stages[..], q, gone) { quest_moved(s, q); s[0].thanks = -1; return; }
  if eg_quest_hand_in(s[0].stages[..], q, gone) { quest_moved(s, q); s[0].thanks = q; }
}
board_key :: (s: [] Everglade, key: int, mods: int) -> bool {
  if key == KEY_ESCAPE || key == 'q' || key == 'Q' { close_board(s); return true; }
  shown := board_count(s);
  if key >= '1' && key < '1' + EG_QUESTS { if key - '1' < shown { s[0].pick = board_nth(s, key - '1'); s[0].thanks = -1; } return true; }
  if shown > 0 && (key == KEY_UP || key == 'w' || key == 'W') { s[0].pick = board_nth(s, (board_place(s, s[0].pick) + shown - 1) % shown); s[0].thanks = -1; return true; }
  if shown > 0 && (key == KEY_DOWN || key == 's' || key == 'S') { s[0].pick = board_nth(s, (board_place(s, s[0].pick) + 1) % shown); s[0].thanks = -1; return true; }
  if key == KEY_ENTER || key == ' ' || key == 'e' || key == 'E' { board_act(s); return true; }
  return (mods & 10) == 0 && key != KEY_SHIFT;
}
// A row picks its quest; the button does its thing; CLOSE closes. Pressed and lifted on them.
board_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 { s[0].board_finger = id; return true; }
  if id != s[0].board_finger { return true; }
  if phase == 2 {
    if in_box(s[0].close_button, x, y) { close_board(s); }
    else if in_box(s[0].act_button, x, y) { board_act(s); }
    else { for q: 0..<EG_QUESTS { if on_board(s, q) && in_box(s[0].rows[q], x, y) { s[0].pick = q; s[0].thanks = -1; } } }
  }
  if phase >= 2 { s[0].board_finger = -1; }
  return true;
}

// Where person i stands now (their day moves them: verse/everglade/routines.coax), on the flat.
folk_at :: (s: [] Everglade, i: int) -> Point { return v3(s[0].folk[i].x, 0, s[0].folk[i].z); }

// The nearest person within TALK_NEAR of you, or -1.
nearest :: (s: [] Everglade, you: Point) -> int {
  best := -1; most := f32(TALK_NEAR);
  for i: 0..<EG_SPOTS {
    if eg_gone(s[0].ev.edits, i) || s[0].folk[i].indoors || watch_busy(s, i) { continue; }
    d := flat_gap(folk_at(s, i), you);
    if d < most { most = d; best = i; }
  }
  return best;
}

add_line :: (s: [] Everglade, npc: bool, text: string) {
  if s[0].line_n == TALK_LINES {
    for k: 1..<TALK_LINES {
      s[0].line_npc[k - 1] = s[0].line_npc[k]; s[0].line_len[k - 1] = s[0].line_len[k];
      for b: 0..<LINE_BYTES { s[0].line_text[(k - 1) * LINE_BYTES + b] = s[0].line_text[k * LINE_BYTES + b]; }
    }
    s[0].line_n -= 1;
  }
  k := s[0].line_n;
  n := 0;
  for i: 0..<text.count { if n < LINE_BYTES { s[0].line_text[k * LINE_BYTES + n] = text[i]; n += 1; } }
  s[0].line_npc[k] = npc; s[0].line_len[k] = n;
  s[0].line_n = k + 1;
  if npc { s[0].answered = 0; }
}
line_of :: (s: [] Everglade, k: int) -> string { return cast(string) s[0].line_text[k * LINE_BYTES..<k * LINE_BYTES + s[0].line_len[k]]; }
typed_text :: (s: [] Everglade) -> string { return cast(string) s[0].typed[0..<s[0].typed_n]; }

talk_to :: (s: [] Everglade, i: int) {
  if i < 0 || i >= EG_SPOTS { return; }
  everglade_guard_invalidate(s);
  s[0].talk = i; s[0].line_n = 0; s[0].typed_n = 0; s[0].waiting = false; s[0].ask_n = 0;
  s[0].held = 0; s[0].talk_quest = -1;
  folk_nod(s[0].folk[i..<i + 1]);
  q := eg_quest_talk(s[0].stages[..], i);
  if q >= 0 { quest_moved(s, q); s[0].talk_quest = q; add_line(s, true, EG_QUEST_ARRIVE[q]); return; }
  // the crier takes in what's ready to hand in, as the board does
  if i == EG_CRIER {
    for r: 0..<EG_QUESTS {
      if !eg_quest_hand_in(s[0].stages[..], r, s[0].ev.edits.gone) { continue; }
      quest_moved(s, r); s[0].talk_quest = r;
      add_line(s, true, EG_QUEST_THANKS[r]);
      return;
    }
  }
  add_line(s, true, EG_GREET[i]);
}
end_talk :: (s: [] Everglade) { s[0].talk = -1; s[0].typed_n = 0; s[0].waiting = false; s[0].ask_n = 0; }

// What the one you talk to knows of your quest with them, for the character chat.
quest_note :: (s: [] Everglade) -> string {
  q := s[0].talk_quest;
  note := ifx q < 0 || q >= EG_QUESTS then "" else EG_QUEST_NOTE[q];
  // and the talk going round town they have heard by now (verse/everglade/rumours.coax), on the shared clock
  c := folk_clock(s, false);
  day := cast(int) (c.world / f64(c.length));
  n := rumour_note(s[0].talk, day, c.day, note, s[0].heard[..]);
  return cast(string) s[0].heard[0..<n];
}

// What you typed goes to the face as a question, with the conversation so far.
send_typed :: (s: [] Everglade) {
  if s[0].talk < 0 || s[0].waiting || s[0].typed_n == 0 { return; }
  lines: [TALK_LINES] EgLine;
  for k: 0..<s[0].line_n { lines[k] = EgLine.{npc = s[0].line_npc[k], text = line_of(s, k)}; }
  n := eg_ask_body_note(s[0].ask[..], s[0].talk, lines[0..<s[0].line_n], typed_text(s), cast(string) s[0].visit[0..<s[0].visit_n],
                        quest_note(s));
  if n == 0 { return; }
  s[0].ask_n = n;
  add_line(s, false, typed_text(s));
  s[0].typed_n = 0;
  s[0].waiting = true; s[0].waited = 0;
}

// A key while you talk: it types, Enter says it, Backspace takes a letter
// back, Esc ends the conversation. Keys with Ctrl or Cmd are the browser's.
talk_key :: (s: [] Everglade, key: int, mods: int) -> bool {
  if key == KEY_ESCAPE { end_talk(s); return true; }
  if key == KEY_ENTER { send_typed(s); return true; }
  return type_key(s, key, mods);
}
// A key typed into the line (a talk's or the chat's): Backspace takes a letter back, a printable key
// types. Keys with Ctrl or Cmd are the browser's.
type_key :: (s: [] Everglade, key: int, mods: int) -> bool {
  if key == KEY_BACKSPACE {
    n := s[0].typed_n;
    while n > 0 { n -= 1; if (s[0].typed[n] & 0xC0) != 0x80 { break; } }
    s[0].typed_n = n;
    return true;
  }
  if (mods & 10) != 0 { return false; }
  if key < 32 || key == 127 { return key >= 0; }
  // the code point as UTF-8, if it fits
  c := key; n := s[0].typed_n;
  size := ifx c < 0x80 then 1 else ifx c < 0x800 then 2 else ifx c < 0x10000 then 3 else 4;
  if n + size > TYPED { return true; }
  if size == 1 { s[0].typed[n] = cast(u8) c; }
  if size == 2 { s[0].typed[n] = cast(u8) (0xC0 | (c >> 6)); s[0].typed[n + 1] = cast(u8) (0x80 | (c & 63)); }
  if size == 3 { s[0].typed[n] = cast(u8) (0xE0 | (c >> 12)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 2] = cast(u8) (0x80 | (c & 63)); }
  if size == 4 {
    s[0].typed[n] = cast(u8) (0xF0 | (c >> 18)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 12) & 63));
    s[0].typed[n + 2] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 3] = cast(u8) (0x80 | (c & 63));
  }
  s[0].typed_n = n + size;
  return true;
}

// Text from the keyboard field while you talk: it types, a line break says it.
// A character is taken whole or not at all, so the line stays UTF-8.
talk_typed :: (s: [] Everglade, text: string) {
  if s[0].talk < 0 && !s[0].chat.typing { return; }
  i := 0;
  while i < text.count {
    c := text[i];
    size := ifx c < 0x80 then 1 else ifx (c & 0xE0) == 0xC0 then 2 else ifx (c & 0xF0) == 0xE0 then 3 else ifx (c & 0xF8) == 0xF0 then 4 else 1;
    if c == '\n' || c == '\r' { if s[0].chat.typing { chat_say(s); return; } send_typed(s); i += 1; continue; }
    if c < 32 || c == 127 || (c >= 0x80 && size == 1) || i + size > text.count { i += 1; continue; }
    n := s[0].typed_n;
    if n + size > TYPED { return; }
    for b: 0..<size { s[0].typed[n + b] = text[i + b]; }
    s[0].typed_n = n + size;
    i += size;
  }
}

// TALK (a phone's way to start) and BYE: pressed and lifted on them.
talk_pointer :: (s: [] Everglade, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 && (in_box(s[0].talk_button, x, y) || in_box(s[0].bye_button, x, y)) { s[0].talk_finger = id; return true; }
  // a press on the line you type in is the keyboard field's: the host focuses it (a phone's keyboard comes up)
  if s[0].talk >= 0 && s[0].talk_finger != id && in_box(Box.{x0 = s[0].field[0], y0 = s[0].field[1], x1 = s[0].field[2], y1 = s[0].field[3]}, x, y) { return true; }
  if id != s[0].talk_finger { return false; }
  if phase == 2 {
    if s[0].talk >= 0 && in_box(s[0].bye_button, x, y) { end_talk(s); }
    else if s[0].talk < 0 && s[0].near_board && in_box(s[0].talk_button, x, y) { open_board(s); }
    else if s[0].talk < 0 && s[0].near >= 0 && in_box(s[0].talk_button, x, y) { talk_to(s, s[0].near); }
    else if boat_prompt_on(s) && in_box(s[0].talk_button, x, y) { s[0].boat_ask = true; }
    else if hm_prompt_on(s) && in_box(s[0].talk_button, x, y) { _ := hm_swing(s); }
  }
  if phase >= 2 { s[0].talk_finger = -1; }
  return true;
}

// The face's side: the question to send (its bytes in ask), that it went,
// and the answer ("STATUS\n" then the server's JSON).
everglade_ask :: (s: [] Everglade) -> int #export_c { return s[0].ask_n; }
everglade_ask_sent :: (s: [] Everglade) #export_c { s[0].ask_n = 0; }

// The "text" of the server's answer, unescaped, into out; its length.
answer_text :: (body: string, out: [] u8) -> int {
  // "text", a colon and the opening quote, with or without spaces between (the server writes "text": ")
  key := "\"text\"";
  i := 0; found := -1;
  while i + key.count <= body.count {
    if body[i..<i + key.count] == key {
      j := i + key.count;
      while j < body.count && body[j] == ' ' { j += 1; }
      if j < body.count && body[j] == ':' {
        j += 1;
        while j < body.count && body[j] == ' ' { j += 1; }
        if j < body.count && body[j] == '"' { found = j + 1; break; }
      }
    }
    i += 1;
  }
  if found < 0 { return 0; }
  n := 0; i = found;
  while i < body.count && body[i] != '"' && n < out.count {
    c := body[i];
    if c == '\\' && i + 1 < body.count {
      e := body[i + 1];
      if e == 'u' { out[n] = '\''; n += 1; i += 6; continue; }   // a rare escape: a stand-in
      out[n] = ifx e == 'n' || e == 't' || e == 'r' then cast(u8) ' ' else e; n += 1; i += 2; continue;
    }
    out[n] = c; n += 1; i += 1;
  }
  return n;
}
everglade_answer :: (s: [] Everglade, reply: string) #export_c {
  if s[0].talk < 0 || !s[0].waiting { return; }
  s[0].waiting = false;
  ok := reply.count > 4 && reply[0..<4] == "200\n";
  text: [LINE_BYTES] u8;
  n := ifx ok then answer_text(reply[4..<reply.count], text[..]) else 0;
  if n > 0 { add_line(s, true, cast(string) text[0..<n]); return; }
  add_line(s, true, ifx eg_is_cat(s[0].talk) then "Mrrp." else "Hm? Say that again, I didn't catch it.");
}

// The face mints a player key when the browser has none; the page keeps it.
everglade_keep_player :: (s: [] Everglade, record: string) #export_c {
  if s[0].action == ACT_KEEP { s[0].action = 0; s[0].dirty = true; }   // the save goes next frame
  if s[0].action != 0 || record.count > OUTBOX { return; }
  for i: 0..<record.count { s[0].outbox[i] = record[i]; }
  s[0].out_n = record.count; s[0].action = ACT_PLAYER;
}
everglade_action :: (s: [] Everglade) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
everglade_action_done :: (s: [] Everglade) #export_c { s[0].out_n = 0; }

// While you talk, the phone's keyboard comes up over the typed line.
everglade_wants_text :: (s: [] Everglade) -> bool #export_c { return s[0].talk >= 0 || s[0].chat.typing || redit_typing(s[0].ev.ed[..]); }

// ---- the scene

shape :: (s: [] Everglade, kind: int, look: int, centre: Point, yaw: f32, tilt: f32, sx: f32, sy: f32, sz: f32,
          red: f32, green: f32, blue: f32) {
  if kind < 1 || kind > 4 { return; }
  n := s[0].counts[kind];
  if n >= SLOTS[kind] { return; }
  s[0].counts[kind] = n + 1;
  o := (SLOT_AT[kind] + n) * OBJECT_FLOATS;
  cy := cos(yaw); sy_ := sin(yaw); ct := cos(tilt); st := sin(tilt);
  c0 := v3(cy * sx, 0, -sy_ * sx);
  c1 := v3(sy_ * st * sy, ct * sy, cy * st * sy);
  c2 := v3(sy_ * ct * sz, -st * sz, cy * ct * sz);
  s[0].objects[o] = c0.x; s[0].objects[o + 1] = c1.x; s[0].objects[o + 2] = c2.x; s[0].objects[o + 3] = centre.x;
  s[0].objects[o + 4] = c0.y; s[0].objects[o + 5] = c1.y; s[0].objects[o + 6] = c2.y; s[0].objects[o + 7] = centre.y;
  s[0].objects[o + 8] = c0.z; s[0].objects[o + 9] = c1.z; s[0].objects[o + 10] = c2.z; s[0].objects[o + 11] = centre.z;
  s[0].objects[o + 12] = red; s[0].objects[o + 13] = green; s[0].objects[o + 14] = blue;
  s[0].objects[o + 15] = f32(kind + 8 * look);
}

// Lathed stone: profile `profile` (everglade.wgsl lathe_profile) turned about +Y at `centre`, its
// metres times `scale`, one object a wedge. The wedge and profile ride in the shape word above the look.
lathe :: (s: [] Everglade, profile: int, look: int, centre: Point, scale: f32, red: f32, green: f32, blue: f32) {
  for w: 0..<LATHE_WEDGES {
    n := s[0].lathe_n;
    if n >= LATHE_SLOTS { return; }
    s[0].lathe_n = n + 1;
    o := (LATHE_AT + n) * OBJECT_FLOATS;
    for k: 0..<12 { s[0].objects[o + k] = 0; }
    s[0].objects[o] = scale; s[0].objects[o + 5] = scale; s[0].objects[o + 10] = scale;
    s[0].objects[o + 3] = centre.x; s[0].objects[o + 7] = centre.y; s[0].objects[o + 11] = centre.z;
    s[0].objects[o + 12] = red; s[0].objects[o + 13] = green; s[0].objects[o + 14] = blue;
    s[0].objects[o + 15] = f32(SHAPE_LATHE + 8 * look + 256 * (profile * LATHE_WEDGES + w));
  }
}

// A soft round shadow at x, z on the floor at height y: the scene darkens
// only what is near that floor (everglade.wgsl shade_shadows_at), so one
// cast on a bench's top falls on the bench and not on the ground under it.
// y rides in the strength's slot: strength + 2 * centimetres above -100 m.
shadow :: (s: [] Everglade, u: [] f32, x: f32, z: f32, y: f32, radius: f32, strength: f32) {
  n := s[0].shadow_n;
  if n >= SHADOWS { return; }
  k := U_SHADOW + n * 4;
  cm := floor(clamp(y + 100, 0, 1000) * 100 + 0.5);
  u[k] = x; u[k + 1] = z; u[k + 2] = radius; u[k + 3] = clamp(strength, 0, 1) + 2 * cm;
  s[0].shadow_n = n + 1;
}
// The floor under (x, z) at or below height y: the ground, or the top of a
// wall you can stand on (a bench, a crate) that the walking controller stands you on.
floor_under :: (s: [] Everglade, x: f32, z: f32, y: f32) -> f32 {
  f := ground_at(s, x, z);
  for w: 0..<s[0].wall_n {
    k := w * 6;
    if x < s[0].walls[k] || x > s[0].walls[k + 3] || z < s[0].walls[k + 2] || z > s[0].walls[k + 5] { continue; }
    top := s[0].walls[k + 4];
    if top <= y + 0.1 && top > f { f = top; }
  }
  return f;
}

// A box standing on the ground from footprint x0, z0 to x1, z1, h tall.
block :: (s: [] Everglade, look: int, x0: f32, z0: f32, x1: f32, z1: f32, h: f32, red: f32, green: f32, blue: f32) {
  g := ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2);
  shape(s, SHAPE_BOX, look, v3((x0 + x1) / 2, g + (h - 1) / 2, (z0 + z1) / 2), 0, 0, x1 - x0, h + 1, z1 - z0, red, green, blue);
}

city :: (s: [] Everglade, u: [] f32) {
  // The palisade and the buildings are the kit's (build_town); the
  // observatory's dome is the engine's sphere, as the kits have none; it falls when its tower breaks
  // (everglade-spells.coax sp_dome).
  ob := EG_OBSERVATORY * EG_BOX;
  ox := (EG_BUILDING[ob] + EG_BUILDING[ob + 2]) / 2; oz := (EG_BUILDING[ob + 1] + EG_BUILDING[ob + 3]) / 2;
  if !eg_hidden(s[0].ev.edits, EG_OBSERVATORY) && !fi_dome_gone(s) { shape(s, SHAPE_SPHERE, LOOK_STONE, v3(ox, spells_dome_y(s, ground_at(s, ox, oz) + f32(STOREY) * f32(OBSERVATORY_STOREYS)), oz), 0, 0, 7.4, 7.4, 7.4, 0.78, 0.78, 0.82); }
  // The commons: the fountain, the quest board.
  g := ground_at(s, 0, 0);
  // the fountain: a carved basin and a column with an upper bowl, its water the water shader's
  // (the pool, the bowl, the streams falling from the bowl's lip: everglade.wgsl fountain_vertex)
  lathe(s, PROFILE_BASIN, LOOK_CARVED, v3(0, g, 0), 1, 0.78, 0.74, 0.66);
  lathe(s, PROFILE_COLUMN, LOOK_CARVED, v3(0, g, 0), 1, 0.8, 0.76, 0.68);
  for i: 1..<EG_PROPS {
    k := i * EG_BOX;
    x0 := EG_PROP[k]; z0 := EG_PROP[k + 1]; x1 := EG_PROP[k + 2]; z1 := EG_PROP[k + 3]; h := EG_PROP[k + 4];
    if i >= EG_RIVER { continue; }   // the river is the water's (verse/everglade/river.coax), drawn last
    if i == EG_BOARD { notice_board(s, x0, z0, x1, z1, h); continue; }
    if i >= EG_STALL && i < EG_WAYSTONE { continue; }   // the kit's stalls (build_town)
    if i <= EG_CRYPT && s[0].pack_ready { continue; }   // the waystone and the pillars are the kit's stone (landmarks), the crypt its brick (crypt)
    block(s, LOOK_STONE, x0, z0, x1, z1, h, 0.6, 0.6, 0.58);
  }
  if s[0].pack_ready { crypt_stone(s); }
  // The bridge: a timber deck of planks where you walk over the river (its walkable rectangle is
  // plan.coax's EG_BRIDGE), with a rail of posts and two bars along each side, four beams under the
  // deck, and two rows of piles in the stream under a cap beam; the middle pile of each row is the
  // river's (river.coax RIVER_PILE: the current wraps it and churns white).
  br := EG_BRIDGE;
  deck := s[0].deck;
  mx := (br[0] + br[2]) / 2; mz := (br[1] + br[3]) / 2; long := br[2] - br[0];
  shape(s, SHAPE_BOX, LOOK_PLANKS, v3(mx, deck - 0.12, mz), 0, 0, long, 0.24, br[3] - br[1], 0.62, 0.45, 0.29);
  for side: 0..<2 {
    if s[0].pack_ready { break; }   // the kit's fence (bridge)
    z := ifx side == 0 then br[1] + 0.18 else br[3] - 0.18;
    for k: 0..<5 {
      x := br[0] + 0.2 + f32(k) * (long - 0.4) / 4;
      shape(s, SHAPE_BOX, LOOK_WOOD, v3(x, deck + 0.5, z), 0, 0, 0.18, 1.0, 0.18, 0.46, 0.33, 0.2);
    }
    shape(s, SHAPE_BOX, LOOK_WOOD, v3(mx, deck + 0.98, z), 0, 0, long, 0.1, 0.16, 0.52, 0.38, 0.23);
    shape(s, SHAPE_BOX, LOOK_WOOD, v3(mx, deck + 0.52, z), 0, 0, long, 0.08, 0.1, 0.48, 0.35, 0.21);
  }
  for k: 0..<4 {
    z := br[1] + 0.9 + f32(k) * (br[3] - br[1] - 1.8) / 3;
    shape(s, SHAPE_BOX, LOOK_WOOD, v3(mx, deck - 0.39, z), 0, 0, long, 0.3, 0.28, 0.4, 0.29, 0.18);
  }
  for q: 0..<2 {
    px := ifx q == 0 then 87.0f32 else 89.0f32;
    shape(s, SHAPE_BOX, LOOK_WOOD, v3(px, deck - 0.72, mz), 0, 0, 0.4, 0.36, br[3] - br[1] - 1.0, 0.38, 0.28, 0.17);
    for k: 0..<3 {
      pz := ifx k == 0 then br[1] + 1.4 else ifx k == 1 then -11.0f32 else br[3] - 1.4;
      wide := ifx k == 1 then 0.9f32 else 0.5f32;
      bed := ground_at(s, px, pz);
      shape(s, SHAPE_CYLINDER, LOOK_WOOD, v3(px, (bed + deck - 0.9) / 2, pz), 0, 0, wide, deck - 0.9 - bed + 0.3, wide, 0.36, 0.27, 0.17);
    }
  }
  // Glade Run's weir: a sill of six stones across the stream 0.12 m under the water above it,
  // which spills over them 0.25 m down into the plunge pool (plan.coax EG_WEIR_Z).
  wz := f32(EG_WEIR_Z);
  top := ground_at(s, f32(EG_RIVER_X), wz) + f32(EG_RIVER_DEPTH) - 0.12;
  for k: 0..<6 {
    x := f32(EG_RIVER_X) - 2.1 + f32(k) * 0.84;
    bed := ground_at(s, x, wz);
    if top - bed > 0.05 {
      shape(s, SHAPE_BOX, LOOK_STONE, v3(x, (top + bed) / 2, wz), (f32(k % 3) - 1) * 0.12, 0, 0.82, top - bed, 0.7, 0.5, 0.52, 0.48);
    }
  }
  if redit_row_on(s[0].ev.ed[..], "floats") { river_floats(s); }   // the realm's board (docs/verse/realm-edit.md)
}

// The river's floats: a duck a body and a head, a lily pad a green disc
// (and a flower on every other), each turned the way it floats.
river_floats :: (s: [] Everglade) {
  for i: 0..<s[0].float_n {
    k := i * FLOAT_FLOATS;
    p := v3(s[0].floats[k], s[0].floats[k + 1], s[0].floats[k + 2]);
    yaw := s[0].floats[k + 3];
    if s[0].floats[k + 7] > 1.5 { rowboat(s, p, yaw, s[0].floats[k + 6]); continue; }
    if s[0].floats[k + 7] < 0.5 {
      shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(p.x, p.y + 0.02, p.z), yaw, 0, 0.3, 0.2, 0.42, 0.42, 0.3, 0.18);
      hx := p.x + sin(yaw) * 0.16; hz := p.z + cos(yaw) * 0.16;
      shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(hx, p.y + 0.17, hz), yaw, 0, 0.14, 0.14, 0.15, 0.12, 0.4, 0.2);
      shape(s, SHAPE_CONE, LOOK_MATTE, v3(hx + sin(yaw) * 0.09, p.y + 0.16, hz + cos(yaw) * 0.09), yaw, 1.57, 0.05, 0.08, 0.05, 0.92, 0.62, 0.16);
      continue;
    }
    shape(s, SHAPE_CYLINDER, LOOK_LEAVES, v3(p.x, p.y + 0.01, p.z), yaw, 0, 0.55, 0.02, 0.55, 0.22, 0.46, 0.2);
    if i % 2 == 0 { shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(p.x + 0.08, p.y + 0.06, p.z), yaw, 0, 0.12, 0.08, 0.12, 0.95, 0.78, 0.86); }
  }
}

// A piece of a rowboat: x across, y up, z along its hull from p, its size, look and colour.
boat_part :: (s: [] Everglade, p: Point, ax: f32, az: f32, rx: f32, rz: f32, yaw: f32, x: f32, y: f32, z: f32, sx: f32, sy: f32, sz: f32, look: int, r: f32, g: f32, b: f32) {
  shape(s, SHAPE_BOX, look, v3(p.x + rx * x + ax * z, p.y + y, p.z + rz * x + az * z), yaw, 0, sx, sy, sz, r, g, b);
}

// A rowboat (river.coax FLOAT_BOAT) about its hull's middle p, its bow
// along yaw: a plank bottom, two sides, the ends, two thwarts and its oars:
// shipped inside (oar < 0), or out through their oarlocks at the stroke's
// share `oar` while you row it (river.coax oar_sweep: the same numbers),
// dipped through the power stroke and lifted over the recovery.
// 3.2 m long and 1.1 m across.
ROW_OARLOCK :: 0.6; ROW_OAR :: 1.5; ROW_SWEEP :: 0.6; ROW_POWER :: 0.45;
rowboat :: (s: [] Everglade, p: Point, yaw: f32, oar: f32) {
  ax := sin(yaw); az := cos(yaw);       // along, to the bow
  rx := az; rz := -ax;                  // across, to starboard
  boat_part(s, p, ax, az, rx, rz, yaw, 0, -0.17, 0, 0.94, 0.06, 2.96, LOOK_PLANKS, 0.5, 0.34, 0.2);
  for side: 0..<2 {
    x := ifx side == 0 then -0.51f32 else 0.51f32;
    boat_part(s, p, ax, az, rx, rz, yaw, x, 0, 0, 0.08, 0.4, 3.2, LOOK_WOOD, 0.44, 0.3, 0.18);
    if oar < 0 { boat_part(s, p, ax, az, rx, rz, yaw, x * 0.7, 0.04, -0.2, 0.06, 0.04, 2.4, LOOK_WOOD, 0.66, 0.52, 0.34); continue; }
    // out through its oarlock, swept by the stroke
    sd := ifx side == 0 then -1.0f32 else 1.0f32;
    a := ifx oar < f32(ROW_POWER) then f32(ROW_SWEEP) - 2 * f32(ROW_SWEEP) * oar / f32(ROW_POWER)
         else -f32(ROW_SWEEP) + 2 * f32(ROW_SWEEP) * (oar - f32(ROW_POWER)) / (1 - f32(ROW_POWER));
    dip := ifx oar < f32(ROW_POWER) then -0.36f32 * sin(f32(PI) * oar / f32(ROW_POWER)) - 0.06 else 0.08f32;
    lock := v3(p.x + rx * sd * f32(ROW_OARLOCK), p.y + 0.22, p.z + rz * sd * f32(ROW_OARLOCK));
    dir := v3(rx * sd * cos(a) + ax * sin(a), 0, rz * sd * cos(a) + az * sin(a));
    blade := v3(lock.x + dir.x * f32(ROW_OAR), p.y + 0.2 + dip, lock.z + dir.z * f32(ROW_OAR));
    grip := v3(lock.x - dir.x * 0.5, lock.y + 0.08 - dip * 0.3, lock.z - dir.z * 0.5);
    boat_oar_rod(s, grip, blade, 0.045, v3(0.66, 0.52, 0.34));
    tip := sub(blade, lock); tip.y = 0;
    boat_oar_blade(s, blade, unit_or(tip, dir));
  }
  for end: 0..<2 {
    z := ifx end == 0 then -1.56f32 else 1.56f32;
    boat_part(s, p, ax, az, rx, rz, yaw, 0, 0, z, 1.1, 0.4, 0.08, LOOK_WOOD, 0.44, 0.3, 0.18);
    boat_part(s, p, ax, az, rx, rz, yaw, 0, 0.02, z * 0.45, 0.94, 0.05, 0.3, LOOK_PLANKS, 0.56, 0.4, 0.25);
  }
}

// An oar's loom from a to b, `thick` across: a box along it.
boat_oar_rod :: (s: [] Everglade, a: Point, b: Point, thick: f32, colour: Point) {
  d := sub(b, a);
  l := length(d);
  if l < 0.01 { return; }
  y := times(d, 1 / l);
  x := unit_or(cross(y, v3(0, 1, 0)), v3(1, 0, 0));
  z := cross(x, y);
  sp_shape(s, SHAPE_BOX, LOOK_WOOD, mix(a, b, 0.5), times(x, thick), times(y, l), times(z, thick), colour);
}
// A blade at the oar's end, flat, along `out`.
boat_oar_blade :: (s: [] Everglade, at: Point, out: Point) {
  side := unit_or(cross(out, v3(0, 1, 0)), v3(1, 0, 0));
  sp_shape(s, SHAPE_BOX, LOOK_WOOD, sub(at, times(out, 0.18)), times(side, 0.16), v3(0, 0.025, 0), times(out, 0.42), v3(0.6, 0.46, 0.3));
}

// ---- the town, laid once from the plan out of the Medieval Village and
// Fantasy Props kits (docs/verse/everglade.md, "Kit pieces").

OBSERVATORY_STOREYS :: 4;
// How many storeys of wall a building has: the towers by their height,
// the temple three, a building 8 m or taller two, the rest one.
storeys :: (b: int) -> int {
  h := EG_BUILDING[b * EG_BOX + 4];
  if b == EG_OBSERVATORY { return OBSERVATORY_STOREYS; }
  if b == EG_MAGES { return 3; }
  if b == EG_TEMPLE { return 3; }
  return ifx h >= 8 then 2 else 1;
}
brick :: (b: int) -> bool { return b == EG_SMITHY || b == EG_MAGES || b == EG_TEMPLE || b == EG_OBSERVATORY; }

// A side of a footprint: where it runs and which way is out. Sides as
// plan.coax everglade_door numbers them: 0 low z, 1 high z, 2 low x, 3 high x.
Side :: struct { ax: f32; az: f32; bx: f32; bz: f32; nx: f32; nz: f32; yaw: f32; }
side_of :: (x0: f32, z0: f32, x1: f32, z1: f32, w: int) -> Side {
  q: Side;
  if w == 0 { q = Side.{ax = x0, az = z0, bx = x1, bz = z0, nx = 0, nz = -1, yaw = f32(PI)}; }
  else if w == 1 { q = Side.{ax = x0, az = z1, bx = x1, bz = z1, nx = 0, nz = 1, yaw = 0}; }
  else if w == 2 { q = Side.{ax = x0, az = z0, bx = x0, bz = z1, nx = -1, nz = 0, yaw = -f32(PI) / 2}; }
  else { q = Side.{ax = x1, az = z0, bx = x1, bz = z1, nx = 1, nz = 0, yaw = f32(PI) / 2}; }
  return q;
}

// A building's walls from the kit's 2 m modules, storey on storey: on the
// ground a door where the plan's is (open on a walk-in building) and
// windows between plain walls, above them windows and timber; a post at
// each corner; then its roof.
// Each house's own paint (the previous Everglade's layout::paint, verse/everglade/previous/everglade.md):
// a plaster and a roof colour from short palettes, picked by the house's number, so a street varies.
// Multipliers on the kit's own colours, kept gentle so the painting holds together.
PLASTER_TINTS :: [15] f32.[1.0, 1.0, 1.0,  1.0, 0.94, 0.84,  1.0, 0.9, 0.86,  0.93, 0.96, 1.0,  0.98, 0.97, 0.88];
ROOF_TINTS :: [15] f32.[1.0, 1.0, 1.0,  0.82, 0.74, 0.7,  1.0, 0.84, 0.7,  0.76, 0.8, 0.88,  0.9, 0.9, 0.78];
house_tint :: (s: [] Everglade, table: [15] f32, b: int, salt: int) {
  k := ((b * 7 + salt * 3) % 5) * 3;
  for c: 0..<3 { s[0].kit_tint[c] = table[k + c]; }
}
building :: (s: [] Everglade, b: int) {
  k := b * EG_BOX;
  x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3];
  g := ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2);
  n := storeys(b);
  stone := brick(b);
  door := everglade_door(b);
  open := EG_INTERIOR[b];
  for w: 0..<4 {
    q := side_of(x0, z0, x1, z1, w);
    reach_m := abs(q.bx - q.ax) + abs(q.bz - q.az);
    modules := cast(int) (reach_m / f32(EG_MODULE) + 0.5);
    ux := (q.bx - q.ax) / reach_m; uz := (q.bz - q.az) / reach_m;
    for i: 0..<modules {
      t := (f32(i) + 0.5) * f32(EG_MODULE);
      cx := q.ax + ux * t - q.nx * f32(WALL_FACE); cz := q.az + uz * t - q.nz * f32(WALL_FACE);
      along := ifx w < 2 then q.ax + ux * t else q.az + uz * t;
      for f: 0..<n {
        y := g + f32(f) * f32(STOREY);
        is_door := f == 0 && w == door.side && abs(along - door.along) < 0.01;
        m := 0;
        window := (i % 2 == 1) && i != modules - 1;
        if is_door { m = ifx stone then M_BRICK_DOOR else M_PLASTER_DOOR; }
        else if window { m = ifx stone then M_BRICK_WINDOW else M_PLASTER_WINDOW; }
        else if f > 0 && !stone { m = M_PLASTER_GRID; }
        else { m = ifx stone then M_BRICK else M_PLASTER; }
        plaster := m == M_PLASTER || m == M_PLASTER_GRID || m == M_PLASTER_WINDOW || m == M_PLASTER_DOOR;
        if plaster { house_tint(s, PLASTER_TINTS, b, 0); }
        piece(s, m, cx, y, cz, q.yaw, 1, 1, 1);
        s[0].kit_tint[0] = 0;
        if window { piece(s, M_WINDOW, cx, y, cz, q.yaw, 1, 1, 1); }
        // the street dressing (everglade-dress.coax): window boxes under the ground floor's windows, ivy on its plain walls
        if f == 0 && window { window_box(s, b, w, i, cx, y, cz, q.nx, q.nz, q.yaw); }
        if f == 0 && !window && !is_door { ivy(s, b, w, i, cx, y, cz, q.nx, q.nz, q.yaw); }
        if is_door {
          // The leaf hangs on the doorway's left post: shut, or swung in on a walk-in building.
          hx := cx - ux * 0.53; hz := cz - uz * 0.53;
          leaf := ifx open then q.yaw + f32(PI) / 2 else q.yaw;
          piece(s, M_DOOR, hx, y, hz, leaf, 1, 1, 1);
        }
      }
    }
    // a post up each corner: each side its own (sides 0 and 2 both start at x0, z0, so 1 and 2 post
    // their far ends): one at every corner, never two in one (they held each other up, a post alone
    // standing in the air once its walls fell)
    far := w == 1 || w == 2;
    px := ifx far then q.bx else q.ax; pz := ifx far then q.bz else q.az;
    for f: 0..<n { piece(s, M_CORNER, px, g + f32(f) * f32(STOREY), pz, 0, 1.6, 1, 1.6); }
  }
  top := g + f32(n) * f32(STOREY);
  w := x1 - x0; d := z1 - z0;
  if b == EG_MAGES {
    r := (hi(w, d) + 0.9) / 5.66;
    piece(s, M_TOWER_ROOF, (x0 + x1) / 2, top + 0.57 * r, (z0 + z1) / 2, 0, r, r, r);
    return;
  }
  if b == EG_OBSERVATORY { return; }   // its dome is drawn by city()
  // The roof: the kit's 6x8 tiles stretched over the footprint, its ridge along the long side.
  long_z := d >= w;
  span := ifx long_z then w else d;
  run := ifx long_z then d else w;
  sx := (span + 0.8) / 8.24; sz := (run + 0.8) / 9.68; sy := sx * 0.85;
  house_tint(s, ROOF_TINTS, b, 1);
  piece(s, M_ROOF, (x0 + x1) / 2, top + 0.78 * sy, (z0 + z1) / 2, ifx long_z then 0.0f32 else f32(PI) / 2, sx, sy, sz);
  s[0].kit_tint[0] = 0;
  // The gables: the kit's brick-and-plaster fronts closing each end under the ridge.
  gx := span / 6.7; gy := 5.4 * sy / 4.38;
  for e: 0..<2 {
    w2 := ifx long_z then e else 2 + e;
    q := side_of(x0, z0, x1, z1, w2);
    piece(s, M_GABLE, (q.ax + q.bx) / 2 - q.nx * f32(WALL_FACE), top, (q.az + q.bz) / 2 - q.nz * f32(WALL_FACE), q.yaw, gx, gy, 1);
  }
}

// A walk-in building's floor, and what's in it: a frame whose u runs
// along the door's wall and v from it into the room.
Room :: struct { fx: f32; fz: f32; ux: f32; uz: f32; vx: f32; vz: f32; width: f32; depth: f32; y: f32; face: f32; }
room_of :: (s: [] Everglade, b: int) -> Room {
  k := b * EG_BOX;
  x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3];
  d := everglade_door(b);
  q := side_of(x0, z0, x1, z1, d.side);
  r: Room;
  r.vx = -q.nx; r.vz = -q.nz;
  r.ux = r.vz; r.uz = -r.vx;
  r.fx = (q.ax + q.bx) / 2; r.fz = (q.az + q.bz) / 2;
  r.width = abs(q.bx - q.ax) + abs(q.bz - q.az);
  r.depth = ifx d.side < 2 then z1 - z0 else x1 - x0;
  r.y = ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2);
  r.face = yaw_of(r.vx, r.vz);
  return r;
}
// A piece in a room at (u, v), up off the floor by y, turned by yaw from facing in.
put :: (s: [] Everglade, r: Room, m: int, u: f32, v: f32, y: f32, yaw: f32) {
  piece(s, m, r.fx + r.ux * u + r.vx * v, r.y + y, r.fz + r.uz * u + r.vz * v, r.face + yaw, 1, 1, 1);
}
BACK :: 3.1415927;   // a piece facing the door
furnish :: (s: [] Everglade, b: int) {
  r := room_of(s, b);
  k := b * EG_BOX;
  x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3];
  floor_mesh := ifx b == EG_TEMPLE then M_FLOOR_BRICK else M_FLOOR_WOOD;
  for i: 0..<cast(int) ((x1 - x0) / 2 + 0.5) {
    for j: 0..<cast(int) ((z1 - z0) / 2 + 0.5) { piece(s, floor_mesh, x0 + 1 + f32(i) * 2, r.y + 0.03, z0 + 1 + f32(j) * 2, 0, 1, 1, 1); }
  }
  W := r.width / 2 - 1.2; D := r.depth - 1.0;
  if b == EG_INN {
    for t: 0..<4 {
      u := ifx t % 2 == 0 then -W * 0.5 else W * 0.5;
      v := ifx t < 2 then r.depth * 0.38 else r.depth * 0.66;
      put(s, r, M_TABLE, u, v, 0, f32(PI) / 2);
      for c: 0..<4 {
        cu := ifx c % 2 == 0 then -0.85f32 else 0.85f32;
        cv := ifx c < 2 then -1.65f32 else 1.65f32;
        put(s, r, M_CHAIR, u + cu, v + cv, 0, ifx c < 2 then 0.0f32 else f32(PI));
      }
      put(s, r, M_MUG, u + 0.2, v - 0.3, 0.81, 0); put(s, r, M_MUG, u - 0.25, v + 0.5, 0.81, 1.0);
    }
    put(s, r, M_CHIMNEY, 0, D + 0.5, 0, BACK);                      // the hearth
    put(s, r, M_BENCH, -W * 0.5, D - 0.8, 0, BACK); put(s, r, M_BENCH, W * 0.5, D - 0.8, 0, BACK);
    for c: 0..<3 { put(s, r, M_BARREL, W, 1.4 + f32(c) * 0.8, 0, 0); }
    put(s, r, M_STAIR, -W - 0.3, D - 0.2, 0, BACK);
    return;
  }
  if b == EG_STORE {
    for c: 0..<3 { put(s, r, M_SHELF, (f32(c) - 1) * 2.6, D + 0.6, 0, BACK); }
    put(s, r, M_TABLE, 0, r.depth * 0.45, 0, BACK);                  // the counter
    put(s, r, M_BAG, -0.6, r.depth * 0.45, 0.81, 0);
    put(s, r, M_BARREL, -W, 1.4, 0, 0); put(s, r, M_BARREL, -W, 2.3, 0, 0); put(s, r, M_CRATE, W, 1.5, 0, 0.3); put(s, r, M_CRATE, W, 2.6, 0, -0.2);
    return;
  }
  if b == EG_SMITHY {
    put(s, r, M_ANVIL, 0, r.depth * 0.7, 0, f32(PI) / 2);
    put(s, r, M_CHIMNEY, -W + 0.2, D + 0.4, 0, BACK);               // the forge
    put(s, r, M_WEAPONS, W - 0.5, D, 0, BACK);
    put(s, r, M_SWORD, W - 0.9, D - 0.3, 0.2, BACK); put(s, r, M_SHIELD, W - 0.1, D - 0.3, 0.3, BACK);
    put(s, r, M_BARREL, W, 1.4, 0, 0);
    return;
  }
  if b == EG_ALCHEMIST {
    put(s, r, M_CAULDRON, 0, r.depth * 0.72, 0, 0);
    put(s, r, M_SHELF, -1.5, D + 0.6, 0, BACK); put(s, r, M_SHELF, 1.5, D + 0.6, 0, BACK);
    put(s, r, M_TABLE, W - 0.2, r.depth * 0.5, 0, f32(PI) / 2);
    put(s, r, M_SCROLL, W - 0.2, r.depth * 0.5, 0.81, 0.4);
    return;
  }
  if b == EG_FIGHTERS {
    for c: 0..<3 { put(s, r, M_DUMMY, (f32(c) - 1) * 3, r.depth * 0.55, 0, BACK); }
    put(s, r, M_WEAPONS, -W + 0.4, D, 0, BACK); put(s, r, M_WEAPONS, W - 0.4, D, 0, BACK);
    put(s, r, M_BANNER, -2, D + 0.7, 0.4, BACK); put(s, r, M_BANNER, 2, D + 0.7, 0.4, BACK);
    put(s, r, M_BENCH, 0, 1.6, 0, 0);
    return;
  }
  if b == EG_RANGERS {
    put(s, r, M_PEGS, 0, D + 0.8, 1.5, BACK); put(s, r, M_PEGS, 2, D + 0.8, 1.5, BACK);
    put(s, r, M_TABLE, 0, r.depth * 0.72, 0, 0);
    put(s, r, M_BAG, -W + 0.3, D - 0.2, 0, 0.5); put(s, r, M_BAG, -W + 1.1, D - 0.2, 0, -0.4);
    put(s, r, M_CRATE, W - 0.2, D - 0.2, 0, 0.2); put(s, r, M_BENCH, 0, r.depth * 0.72 - 1.3, 0, 0);
    return;
  }
  if b == EG_TEMPLE {
    for row: 0..<4 {
      v := 3.0 + f32(row) * 2.4;
      put(s, r, M_BENCH, -3, v, 0, BACK); put(s, r, M_BENCH, 3, v, 0, BACK);
    }
    put(s, r, M_TABLE, 0, D - 1.2, 0, BACK);                        // the altar
    put(s, r, M_CHALICE, 0, D - 1.2, 0.81, 0);
    put(s, r, M_BANNER, -3.5, D + 0.7, 0.4, BACK); put(s, r, M_BANNER, 3.5, D + 0.7, 0.4, BACK);
  }
}

// The palisade: upright logs along each wall, a log across each gate's
// top, and the gate towers in brick under round roofs.
POST :: 0.62;   // metres between posts
palisade :: (s: [] Everglade) {
  for i: 0..<EG_PALISADE_N {
    k := i * EG_BOX;
    x0 := EG_PALISADE[k]; z0 := EG_PALISADE[k + 1]; x1 := EG_PALISADE[k + 2]; z1 := EG_PALISADE[k + 3]; h := EG_PALISADE[k + 4];
    if h > 5 {
      // A tower: four brick walls two storeys high (a 2 m module stretched to its side) and a round roof.
      g := ground_at(s, (x0 + x1) / 2, (z0 + z1) / 2);
      for w: 0..<4 {
        q := side_of(x0, z0, x1, z1, w);
        reach_m := abs(q.bx - q.ax) + abs(q.bz - q.az);
        cx := (q.ax + q.bx) / 2 - q.nx * f32(WALL_FACE); cz := (q.az + q.bz) / 2 - q.nz * f32(WALL_FACE);
        for f: 0..<2 { piece(s, ifx f == 1 then M_BRICK_WINDOW else M_BRICK, cx, g - 0.2 + f32(f) * f32(STOREY), cz, q.yaw, reach_m / 2, 1, 1); }
      }
      r := (hi(x1 - x0, z1 - z0) + 0.8) / 5.66;
      piece(s, M_TOWER_ROOF, (x0 + x1) / 2, g - 0.2 + 2 * f32(STOREY) + 0.57 * r, (z0 + z1) / 2, 0, r, r, r);
      continue;
    }
    along_x := x1 - x0 > z1 - z0;
    reach_m := ifx along_x then x1 - x0 else z1 - z0;
    posts := cast(int) (reach_m / f32(POST));
    for j: 0..<posts {
      t := (f32(j) + 0.5) * reach_m / f32(posts);
      x := ifx along_x then x0 + t else (x0 + x1) / 2;
      z := ifx along_x then (z0 + z1) / 2 else z0 + t;
      tall := h + 0.25 * f32((j * 7) % 3) / 2;
      log_post(s, x, ground_at(s, x, z) - 0.3, z, tall + 0.3);
    }
  }
  // A log across the top of each gate, from tower to tower.
  for gte: 0..<EG_GATES {
    gx := EG_GATE[gte * 4]; gz := EG_GATE[gte * 4 + 1]; gw := EG_GATE[gte * 4 + 2];
    along_z := EG_GATE[gte * 4 + 3] > 0.5;
    sz := (gw + 1.6) / 10.7;
    y := ground_at(s, gx, gz) + 5.6;
    piece(s, M_LOG, gx, y - 4.545 * 0.6, gz, ifx along_z then 0.0f32 else f32(PI) / 2, 0.6, 0.6, sz);
  }
}
// The kit's log stood on end: its reach_m (local z, 10.7 m) made the post's height.
log_post :: (s: [] Everglade, x: f32, base: f32, z: f32, tall: f32) {
  t := 0.52f32;                 // its thickness is 1.15 m times this
  h := tall / 10.7;
  // local x across, local z up, local y (the log's middle at 4.545 m) toward -z
  rows := [12] f32.[t, 0, 0, x,   0, 0, h, base + 5.35 * h,   0, -t, 0, z + 4.545 * t];
  kit_rows(s, group_of(M_LOG), rows[..]);
}

// The market's stalls along Market Street, each facing it, with fruit in front.
stalls :: (s: [] Everglade) {
  for i: EG_STALL..<EG_WAYSTONE {
    k := i * EG_BOX;
    x := (EG_PROP[k] + EG_PROP[k + 2]) / 2; z := (EG_PROP[k + 1] + EG_PROP[k + 3]) / 2;
    north := z > 0;
    g := ground_at(s, x, z);
    piece(s, M_STALL, x, g, z, ifx north then f32(PI) else 0.0f32, 1.55, 1, 1.55);
    front := ifx north then -1.0f32 else 1.0f32;
    piece(s, M_APPLES, x - 0.5, g + 1.0, z + front * 0.2, 0, 1, 1, 1);
    piece(s, M_BARREL, x + 1.9, g, z, 0, 1, 1, 1);
  }
}

build_town :: (s: [] Everglade) {
  palisade(s);
  for b: 0..<EG_BUILDINGS {
    if eg_hidden(s[0].ev.edits, b) { continue; }   // an admin took it away (everglade-items.coax)
    building(s, b);
    if EG_INTERIOR[b] { furnish(s, b); }
  }
  chimneys(s);
  stalls(s);
  bridge(s);
  crypt(s);
  // The town crier's banner by the quest board.
  piece(s, M_BANNER, 8.6, ground_at(s, 8.6, -5), -5, f32(PI) * 1.5, 1, 1, 1);
}

// The crypt (eg-paint-props: it was a plain grey box): a mausoleum of the kit's brick, no windows, its
// door on the side facing its trail, under a flat roof of brick paving; city() lays a carved cornice
// round the roof's edge, a stepped coping on it and a column either side of the door, in dressed stone
// (crypt_stone).
crypt :: (s: [] Everglade) {
  k := EG_CRYPT * EG_BOX;
  x0 := EG_PROP[k]; z0 := EG_PROP[k + 1]; x1 := EG_PROP[k + 2]; z1 := EG_PROP[k + 3];
  g := crypt_floor(s);
  for w: 0..<4 {
    q := side_of(x0, z0, x1, z1, w);
    reach_m := abs(q.bx - q.ax) + abs(q.bz - q.az);
    modules := cast(int) (reach_m / f32(EG_MODULE) + 0.5);
    ux := (q.bx - q.ax) / reach_m; uz := (q.bz - q.az) / reach_m;
    for i: 0..<modules {
      t := (f32(i) + 0.5) * f32(EG_MODULE);
      cx := q.ax + ux * t - q.nx * f32(WALL_FACE); cz := q.az + uz * t - q.nz * f32(WALL_FACE);
      door := w == 0 && i == CRYPT_DOOR;
      piece(s, ifx door then M_BRICK_DOOR else M_BRICK, cx, g, cz, q.yaw, 1, 1, 1);
      if door { piece(s, M_DOOR, cx + ux * 0.53, g, cz + uz * 0.53, q.yaw, 1, 1, 1); }   // shut (its hinge on the left seen from outside)
    }
  }
  top := g + f32(STOREY);
  nx := cast(int) ((x1 - x0) / 2 + 0.5); nz := cast(int) ((z1 - z0) / 2 + 0.5);
  for i: 0..<nx { for j: 0..<nz { piece(s, M_FLOOR_BRICK, x0 + 1 + f32(i) * 2, top, z0 + 1 + f32(j) * 2, 0, 1, 1, 1); } }
}
CRYPT_DOOR :: 1;   // the module of its south wall the door is in, toward the trail's end
crypt_floor :: (s: [] Everglade) -> f32 {
  k := EG_CRYPT * EG_BOX;
  // the lowest of its corners, so no wall hangs above the slope
  g := ground_at(s, EG_PROP[k], EG_PROP[k + 1]);
  g = lo(g, ground_at(s, EG_PROP[k + 2], EG_PROP[k + 1]));
  g = lo(g, ground_at(s, EG_PROP[k], EG_PROP[k + 3]));
  return lo(g, ground_at(s, EG_PROP[k + 2], EG_PROP[k + 3])) - 0.1;
}
crypt_stone :: (s: [] Everglade) {
  k := EG_CRYPT * EG_BOX;
  x0 := EG_PROP[k]; z0 := EG_PROP[k + 1]; x1 := EG_PROP[k + 2]; z1 := EG_PROP[k + 3];
  g := crypt_floor(s);
  top := g + f32(STOREY);
  mx := (x0 + x1) / 2; mz := (z0 + z1) / 2; w := x1 - x0; d := z1 - z0;
  // a plinth it stands on, the cornice and a stepped coping
  shape(s, SHAPE_BOX, LOOK_STONE, v3(mx, g - 0.2, mz), 0, 0, w + 0.9, 0.9, d + 0.9, 0.56, 0.54, 0.5);
  shape(s, SHAPE_BOX, LOOK_STONE, v3(mx, top + 0.18, mz), 0, 0, w + 0.6, 0.36, d + 0.6, 0.62, 0.6, 0.55);
  shape(s, SHAPE_BOX, LOOK_STONE, v3(mx, top + 0.5, mz), 0, 0, w - 0.6, 0.3, d - 0.6, 0.58, 0.56, 0.52);
  shape(s, SHAPE_BOX, LOOK_STONE, v3(mx, top + 0.8, mz), 0, 0, w - 2.2, 0.3, d - 2.2, 0.55, 0.53, 0.49);
  // the door's columns and the lintel over them
  dx := x0 + (f32(CRYPT_DOOR) + 0.5) * f32(EG_MODULE);
  for side: 0..<2 {
    cx := dx + (ifx side == 0 then -1.0f32 else 1.0f32);
    shape(s, SHAPE_CYLINDER, LOOK_STONE, v3(cx, g + f32(STOREY) / 2, z0 - 0.35), 0, 0, 0.42, f32(STOREY), 0.42, 0.66, 0.63, 0.57);
  }
  shape(s, SHAPE_BOX, LOOK_STONE, v3(dx, top - 0.1, z0 - 0.35), 0, 0, 2.7, 0.34, 0.6, 0.64, 0.61, 0.56);
}

// The bridge's deck and rails from the kit: dark wood floor boards, 4 across the river by 7 along
// the trail, and a wooden fence of 4 lengths along each side (city draws them as shapes until the pack
// is in, and the beams and piles under the deck always).
BRIDGE_ALONG :: 7;
bridge :: (s: [] Everglade) {
  br := EG_BRIDGE;
  deck := s[0].deck;
  along := (br[3] - br[1]) / f32(BRIDGE_ALONG);
  for i: 0..<4 {
    for j: 0..<BRIDGE_ALONG { piece(s, M_FLOOR_WOOD, br[0] + 1 + f32(i) * 2, deck + 0.02, br[1] + (f32(j) + 0.5) * along, 0, 1, 1, along / 2); }
  }
  for side: 0..<2 {
    z := ifx side == 0 then br[1] + 0.18 else br[3] - 0.18;
    for k: 0..<4 { piece(s, M_FENCE, br[0] + 1 + f32(k) * 2, deck, z, ifx side == 0 then 0.0f32 else f32(PI), 0.97, 1.25, 1.4); }
  }
}

// ---- the forest, each frame: the trees in view, the nearest of each kind
// as the kit's (up to its cap), the others as a cone of their colour.

// Whether a ball of radius r round (x, y, z) may be on screen (the view's rows in u).
in_view :: (u: [] f32, x: f32, y: f32, z: f32, r: f32) -> bool {
  cx := u[U_VIEW] * x + u[U_VIEW + 1] * y + u[U_VIEW + 2] * z + u[U_VIEW + 3];
  cy := u[U_VIEW + 4] * x + u[U_VIEW + 5] * y + u[U_VIEW + 6] * z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * x + u[U_VIEW + 13] * y + u[U_VIEW + 14] * z + u[U_VIEW + 15];
  if cw < -r { return false; }
  m := cw + r * 2;
  return abs(cx) < m && abs(cy) < m;
}

// A kit instance: turned by yaw, scaled by size, standing at x, z on the ground.
kit :: (s: [] Everglade, group: int, x: f32, y: f32, z: f32, yaw: f32, size: f32) { kit3(s, group, x, y, z, yaw, size, size, size); }
// One with its own scale on each of its axes (sx across, sy up, sz along its local z).
kit3 :: (s: [] Everglade, group: int, x: f32, y: f32, z: f32, yaw: f32, sx: f32, sy: f32, sz: f32) {
  c := cos(yaw); sn := sin(yaw);
  rows := [12] f32.[c * sx, 0, sn * sz, x,   0, sy, 0, y,   -sn * sx, 0, c * sz, z];
  kit_rows(s, group, rows[..]);
}
kit_rows :: (s: [] Everglade, group: int, rows: [] f32) {
  if group < 0 || group >= KIT_GROUPS { return; }
  n := s[0].kit_used[group];
  if n >= s[0].group_cap[group] { return; }
  s[0].kit_used[group] = n + 1;
  o := (s[0].group_at[group] + n) * OBJECT_FLOATS;
  for i: 0..<12 { s[0].objects[o + i] = rows[i]; }
  tinted := s[0].kit_tint[0] > 0;
  for c: 0..<3 { s[0].objects[o + 12 + c] = ifx tinted then s[0].kit_tint[c] else 1.0f32; }
  rock := group == group_of(10) || group == group_of(11);
  look := ifx rock then LOOK_ROCK else ifx group == group_of(M_WINDOW) then LOOK_WINDOW else LOOK_KIT;
  s[0].objects[o + 15] = f32(SHAPE_MESH + 8 * look);
}
// The group a mesh is drawn over: a tree's trunk and leaves share theirs.
group_of :: (m: int) -> int { return ifx m < 2 * KIT_TREES then m / 2 else m - KIT_TREES; }
// A town piece by its mesh.
piece :: (s: [] Everglade, m: int, x: f32, y: f32, z: f32, yaw: f32, sx: f32, sy: f32, sz: f32) { kit3(s, group_of(m), x, y, z, yaw, sx, sy, sz); }

// ---- the lamps (the owner, October 29: night as dark as the Haunted House's, lit by its lights): a
// lantern on a post at each building's door, a torch beside the streets at each crossing in the town,
// and a brazier on the commons. Each pools its light on the ground and the walls round it (everglade.wgsl
// lamp_light) from dusk, full at night; the nearest LIGHTS to the eye are lit, and every one is drawn.
LAMP_BRAZIER :: [3] f32.[-5, 5.5, 10];       // x, z, reach (m)
LAMP_DOOR_REACH :: 8.0; LAMP_TORCH_REACH :: 9.0;
LAMP_TOWN :: 70.0;                              // torches only at the crossings within the town
// Lamp i: x, y (its flame's height above the ground), z, reach; kind 0 brazier, 1 lantern, 2 torch;
// false past the last.
Lamp :: struct { x: f32; z: f32; up: f32; reach: f32; kind: int; }
lamp_at :: (i: int, out: [] Lamp) -> bool {
  if i == 0 { out[0] = Lamp.{x = LAMP_BRAZIER[0], z = LAMP_BRAZIER[1], up = 1.2, reach = LAMP_BRAZIER[2], kind = 0}; return true; }
  if i <= EG_BUILDINGS {
    b := i - 1;
    out[0] = Lamp.{x = EG_DOOR[b * 2], z = EG_DOOR[b * 2 + 1], up = 2.3, reach = LAMP_DOOR_REACH, kind = 1}; return true;
  }
  k := i - 1 - EG_BUILDINGS;
  if k >= EG_NODES { return false; }
  x := EG_NODE_XZ[k * 2] + f32(EG_PATH_HALF) + 0.6; z := EG_NODE_XZ[k * 2 + 1];
  out[0] = Lamp.{x = x, z = z, up = 2.1, reach = LAMP_TORCH_REACH, kind = 2};
  if abs(x) > LAMP_TOWN || abs(z) > LAMP_TOWN { out[0].kind = -1; }
  for q: 0..<EG_SQUARES {
    dx := EG_NODE_XZ[k * 2] - EG_SQUARE[q * 4]; dz := EG_NODE_XZ[k * 2 + 1] - EG_SQUARE[q * 4 + 1];
    if dx * dx + dz * dz < EG_SQUARE[q * 4 + 2] * EG_SQUARE[q * 4 + 2] { out[0].kind = -1; }
  }
  return true;
}
LAMP_COLOUR :: [9] f32.[1.0, 0.46, 0.16,   1.0, 0.66, 0.32,   1.0, 0.52, 0.2];
LAMP_STRENGTH :: [3] f32.[2.6, 1.8, 2.2];
// Their posts and flames, once the pack is in (the brazier is the kit's cauldron).
lamp_posts :: (s: [] Everglade) {
  if !s[0].pack_ready { return; }
  l: [1] Lamp;
  i := 0;
  while lamp_at(i, l[..]) {
    m := l[0];
    i += 1;
    if m.kind < 0 { continue; }
    g := ground_at(s, m.x, m.z);
    c := m.kind * 3;
    if m.kind == 0 {
      kit(s, group_of(M_CAULDRON), m.x, g, m.z, 0, 1.6);
      brazier_fire(s, m.x, g + 1.15, m.z);
    } else {
      lantern(s, m.x, g, m.z, m.up, f32(i) * 0.7, LAMP_COLOUR[c], LAMP_COLOUR[c + 1], LAMP_COLOUR[c + 2]);
    }
  }
}
// A lantern on its post (eg-paint-props: the owner, October 29, "the street lamps are plain orange
// boxes"): a dark timber post, then the lantern, its flame at `up`: an iron base flaring up under it, the
// glass glowing (LOOK_FLAME, so it blooms and lights by the lamps' clock), and a pointed iron cap over
// it. Two boxes and two cones a lamp, written into the frame's slots like every shape.
LANTERN_IRON :: [3] f32.[0.07, 0.065, 0.07];
lantern :: (s: [] Everglade, x: f32, g: f32, z: f32, up: f32, yaw: f32, r: f32, gr: f32, b: f32) {
  shape(s, SHAPE_BOX, LOOK_WOOD, v3(x, g + (up - 0.2) / 2, z), yaw, 0, 0.12, up - 0.2, 0.12, 0.3, 0.19, 0.11);
  shape(s, SHAPE_CONE, LOOK_MATTE, v3(x, up + g - 0.2, z), yaw, 3.14159, 0.2, 0.1, 0.2, LANTERN_IRON[0], LANTERN_IRON[1], LANTERN_IRON[2]);
  shape(s, SHAPE_BOX, LOOK_FLAME, v3(x, g + up, z), yaw, 0, 0.19, 0.3, 0.19, r, gr, b);
  shape(s, SHAPE_CONE, LOOK_MATTE, v3(x, g + up + 0.24, z), yaw, 0, 0.3, 0.2, 0.3, LANTERN_IRON[0], LANTERN_IRON[1], LANTERN_IRON[2]);
}
// The quest board: a timber notice board between the commons (+z) and the street (-z): two posts, a planked panel in a
// frame, a little gabled roof of planks over it, and papers pinned on it, each its own size, tilt and
// shade of parchment, one a red notice.
NOTICES :: 7;
NOTICE :: [28] f32.[-0.7, 0.25, 0.42, 0.55,   -0.15, 0.32, 0.36, 0.46,   0.4, 0.22, 0.44, 0.5,
                    -0.55, -0.32, 0.38, 0.4,   0.0, -0.25, 0.3, 0.36,   0.52, -0.3, 0.4, 0.44,   0.82, 0.38, 0.22, 0.28];
notice_board :: (s: [] Everglade, x0: f32, z0: f32, x1: f32, z1: f32, h: f32) {
  g := ground_at(s, x0, z0);
  mx := (x0 + x1) / 2; mz := (z0 + z1) / 2; w := x1 - x0;
  for side: 0..<2 {
    px := ifx side == 0 then x0 + 0.1 else x1 - 0.1;
    shape(s, SHAPE_BOX, LOOK_WOOD, v3(px, g + h / 2, mz), 0, 0, 0.16, h, 0.16, 0.36, 0.25, 0.15);
  }
  ph := 1.25f32; py := g + 1.55;
  shape(s, SHAPE_BOX, LOOK_PLANKS, v3(mx, py, mz), 0, 0, w - 0.3, ph, 0.08, 0.55, 0.4, 0.25);
  shape(s, SHAPE_BOX, LOOK_WOOD, v3(mx, py + ph / 2 + 0.04, mz - 0.03), 0, 0, w - 0.1, 0.1, 0.14, 0.38, 0.26, 0.16);
  shape(s, SHAPE_BOX, LOOK_WOOD, v3(mx, py - ph / 2 - 0.04, mz - 0.03), 0, 0, w - 0.1, 0.1, 0.14, 0.38, 0.26, 0.16);
  for side: 0..<2 {
    tilt := ifx side == 0 then 0.6f32 else -0.6f32;
    shape(s, SHAPE_BOX, LOOK_PLANKS, v3(mx, g + h + 0.12, mz + (ifx side == 0 then -0.22f32 else 0.22f32)), 0, tilt, w + 0.2, 0.06, 0.55, 0.42, 0.24, 0.16);
  }
  // papers on both faces: the commons' (+z) and the street's (-z), mirrored
  for face: 0..<2 {
    dz := ifx face == 0 then 1.0f32 else -1.0f32;
    for k: 0..<NOTICES {
      o := k * 4;
      red := k == 4;
      shade := 0.86 + 0.08 * sin(f32(k) * 3.7);
      nx := mx + NOTICE[o] * dz;
      shape(s, SHAPE_BOX, LOOK_MATTE, v3(nx, py + NOTICE[o + 1], mz + 0.05 * dz), 0, 0.06 * sin(f32(k) * 2.1), NOTICE[o + 2], NOTICE[o + 3], 0.012,
            ifx red then 0.72f32 else shade, ifx red then 0.24f32 else shade * 0.93, ifx red then 0.18f32 else shade * 0.76);
      // its pin
      shape(s, SHAPE_BOX, LOOK_MATTE, v3(nx, py + NOTICE[o + 1] + NOTICE[o + 3] * 0.4, mz + 0.065 * dz), 0, 0, 0.035, 0.035, 0.02, 0.62, 0.12, 0.1);
    }
  }
}
// The brazier's fire: a bed of coals, tongues of flame that lick up and sway, each its own height
// and beat, the tall ones yellow and the short ones deep orange, and embers rising out of it, shrinking
// as they cool.
BRAZIER_TONGUES :: 7; BRAZIER_EMBERS :: 8;
brazier_fire :: (s: [] Everglade, x: f32, y: f32, z: f32) {
  t := cast(f32) s[0].time;
  shape(s, SHAPE_BOX, LOOK_FLAME, v3(x, y, z), 0.4, 0, 0.62, 0.12, 0.62, 0.9, 0.28, 0.06);
  for i: 0..<BRAZIER_TONGUES {
    a := f32(i) * 2.39996;
    r := ifx i == 0 then 0.0f32 else 0.11 + 0.09 * f32(i % 3);
    beat := sin(t * (6.3 + f32(i) * 0.9) + f32(i) * 1.7) * 0.5 + sin(t * (11.1 + f32(i) * 1.3) + f32(i)) * 0.25;
    h := (0.55 - r) * 2.0 * (1 + 0.32 * beat);
    w := 0.2 + 0.08 * (1 - r * 3);
    sway := 0.06 * sin(t * 3.1 + f32(i) * 2.2);
    hot := clamp((h - 0.35) * 1.6, 0, 1);
    shape(s, SHAPE_CONE, LOOK_FLAME, v3(x + cos(a) * r + sway, y + h / 2, z + sin(a) * r), a, sway * 1.5, w, h, w,
          1.0, 0.3 + 0.4 * hot, 0.05 + 0.12 * hot);
  }
  for i: 0..<BRAZIER_EMBERS {
    phase := t * (0.35 + 0.05 * f32(i % 4)) + f32(i) / f32(BRAZIER_EMBERS);
    p := phase - floor(phase);
    seed := f32(i) * 12.9898 + floor(phase) * 78.233;
    jx := sin(seed) * 0.25; jz := cos(seed * 1.3) * 0.25;
    rise := p * 2.6;
    size := 0.05 * (1 - p);
    if size < 0.008 { continue; }
    shape(s, SHAPE_BOX, LOOK_FLAME, v3(x + jx + 0.15 * sin(t * 2 + f32(i)) * p, y + 0.3 + rise, z + jz), t + f32(i), 0.5, size, size, size, 1.0, 0.42, 0.1);
  }
}
// How a flame's light breathes: the brazier's in two beats, a lantern's or a torch's faintly.
lamp_flicker :: (t: f32, i: int, kind: int) -> f32 {
  beat := sin(t * 9.1 + f32(i) * 2.3) * 0.6 + sin(t * 23.7 + f32(i)) * 0.4;
  return 1 + beat * (ifx kind == 0 then 0.14f32 else 0.05f32);
}
// The lights: how lit the lamps are (none while the sun is up past 0.45, all once it is down or the
// moon keys), and the nearest `cap` to the eye, the brazier first.
lamp_glow :: (sun_y: f32, moon: bool) -> f32 { return ifx moon then 1.0f32 else clamp((0.45 - sun_y) / 0.4, 0, 1); }
lamps :: (s: [] Everglade, u: [] f32, eye: Point, cap: int) {
  glow := lamp_glow(u[STYLE_AT + SU_KEY_DIR + 1], u[STYLE_AT + SU_KEY_DIR + 3] > 0.5);
  for k: 0..<4 + LIGHTS * 8 { u[U_LIGHT_INFO + k] = 0; }
  if !s[0].pack_ready || glow <= 0 { return; }
  taken: [64] bool;
  for k: 0..<64 { taken[k] = false; }
  l: [1] Lamp;
  n := 0;
  while n < cap && n < LIGHTS {
    best := -1; best_d := 1000000.0f32; i := 0;
    while lamp_at(i, l[..]) {
      m := l[0];
      if m.kind >= 0 && i < 64 && !taken[i] {
        dx := m.x - eye.x; dz := m.z - eye.z;
        d := ifx m.kind == 0 then -1.0f32 else dx * dx + dz * dz;
        if d < best_d { best_d = d; best = i; }
      }
      i += 1;
    }
    if best < 0 { break; }
    taken[best] = true;
    _ := lamp_at(best, l[..]);
    m := l[0];
    k := U_LIGHTS + n * 8; c := m.kind * 3;
    u[k] = m.x; u[k + 1] = ground_at(s, m.x, m.z) + m.up; u[k + 2] = m.z; u[k + 3] = m.reach;
    u[k + 4] = LAMP_COLOUR[c]; u[k + 5] = LAMP_COLOUR[c + 1]; u[k + 6] = LAMP_COLOUR[c + 2];
    u[k + 7] = LAMP_STRENGTH[m.kind] * lamp_flicker(cast(f32) s[0].time, best, m.kind);
    n += 1;
  }
  u[U_LIGHT_INFO] = f32(n); u[U_LIGHT_INFO + 1] = glow;
}

// The deep wood's waystone and the ruins' pillars, once the pack is in: the kit's painted rock stood
// up to each one's footprint and height, so they read as standing stones, not grey boxes. After the
// forest, which empties the rocks' groups each frame.
landmarks :: (s: [] Everglade) {
  if !s[0].pack_ready { return; }
  for i: EG_WAYSTONE..<EG_CRYPT {
    k := i * EG_BOX;
    x0 := EG_PROP[k]; z0 := EG_PROP[k + 1]; x1 := EG_PROP[k + 2]; z1 := EG_PROP[k + 3]; h := EG_PROP[k + 4];
    x := (x0 + x1) / 2; z := (z0 + z1) / 2;
    m := ifx i % 2 == 0 then 10 else 11;    // Rock_Medium_1 or _2: about 3.2 by 2.2 by 3 m
    g := ground_at(s, x, z);
    if i == EG_WAYSTONE {
      // the waystone: a tall stone, broader than its footprint so it reads from the trail, two fallen
      // stones at its foot, and a line of runes cut down its face that glow faintly, dusk or noon
      kit3(s, group_of(m), x, g - 0.15, z, 0.4, 0.42, 1.25, 0.3);
      kit3(s, group_of(11), x + 0.9, g - 0.25, z + 0.5, 2.1, 0.22, 0.2, 0.2);
      kit3(s, group_of(10), x - 0.8, g - 0.25, z - 0.6, 4.0, 0.18, 0.16, 0.18);
      fx := sin(0.4f32) * 0.52; fz := cos(0.4f32) * 0.52;
      for r: 0..<8 {
        f := ifx r < 4 then 1.0f32 else -1.0f32;
        across := r % 2 == 0;   // strokes, across and down in turn
        shape(s, SHAPE_BOX, LOOK_FLAME, v3(x + fx * f, g + 0.8 + f32(r % 4) * 0.34, z + fz * f), 0.4, 0, ifx across then 0.2f32 else 0.05f32, ifx across then 0.05f32 else 0.22f32, 0.03, 0.3, 0.72, 0.66);
      }
      continue;
    }
    kit3(s, group_of(m), x, g - 0.1, z, f32(i) * 1.3, (x1 - x0) * 1.25 / 3.2, h / 2.0, (z1 - z0) * 1.25 / 3.0);
  }
}

// A far tree's cone: a pine dark and narrow, a broadleaf rounder and lighter.
far_tree :: (s: [] Everglade, x: f32, base: f32, z: f32, size: f32, yaw: f32, kind: int) {
  pine := kind < 2;
  w := ifx pine then 4.6f32 else 5.4f32;
  h := ifx pine then 8.0f32 else 6.6f32;
  lift := ifx pine then 1.4f32 else 2.6f32;
  // the colour of the kit's leaves it stands for (the pack's catalog), so the swap doesn't show through the haze
  k := kind * 3;
  kit_rgb := s[0].canopy_rgb[k] + s[0].canopy_rgb[k + 1] + s[0].canopy_rgb[k + 2] > 0;
  r := ifx kit_rgb then s[0].canopy_rgb[k] else ifx pine then 0.16f32 else 0.26f32;
  g := ifx kit_rgb then s[0].canopy_rgb[k + 1] else ifx pine then 0.32f32 else 0.42f32;
  b := ifx kit_rgb then s[0].canopy_rgb[k + 2] else ifx pine then 0.2f32 else 0.17f32;
  shape(s, SHAPE_CONE, LOOK_LEAVES, v3(x, base + (lift + h / 2) * size, z), yaw, 0, w * size, h * size, w * size, r, g, b);
}

KIT_BUCKETS :: 12;
forest :: (s: [] Everglade, u: [] f32, eye: Point) {
  for g: 0..<KIT_FOREST { s[0].kit_used[g] = 0; }
  kit_on := s[0].pack_ready;
  reach := ifx phone(s) then f32(KIT_NEAR_PHONE) else f32(KIT_NEAR);
  cap := ifx phone(s) then KIT_CAP_PHONE else KIT_CAP;
  // How many of each kind stand in view at each distance, so the nearest win.
  seen: [KIT_TREES * KIT_BUCKETS] int;
  for k: 0..<KIT_TREES * KIT_BUCKETS { seen[k] = 0; }
  for t: 0..<s[0].tree_n {
    o := t * TREE_FLOATS;
    x := s[0].trees[o]; z := s[0].trees[o + 1];
    d := sqrt((x - eye.x) * (x - eye.x) + (z - eye.z) * (z - eye.z));
    if d >= reach { continue; }
    if !in_view(u, x, ground_at(s, x, z) + 4, z, 6) { continue; }
    b := cast(int) (d / reach * f32(KIT_BUCKETS));
    seen[cast(int) s[0].trees[o + 4] * KIT_BUCKETS + lo_i(b, KIT_BUCKETS - 1)] += 1;
  }
  cut: [KIT_TREES] int;
  for g: 0..<KIT_TREES {
    total := 0; cut[g] = KIT_BUCKETS;
    for b: 0..<KIT_BUCKETS {
      total += seen[g * KIT_BUCKETS + b];
      if total > cap { cut[g] = b; break; }
    }
  }
  // Which trees the kit draws (the nearest of each kind, up to its cap), then those nearest first:
  // a near crown's depth is down before the crowns behind it shade, so their hidden leaf cards are
  // turned away unshaded (a crown is hundreds of overlapping cards; art-styles.md 14).
  pick: [TREES] int;      // the bucket of a tree the kit draws, else -1
  pick_y: [TREES] f32;    // and the ground under it
  taken: [KIT_TREES] int;
  for g: 0..<KIT_TREES { taken[g] = 0; }
  for t: 0..<s[0].tree_n {
    pick[t] = -1;
    o := t * TREE_FLOATS;
    x := s[0].trees[o]; z := s[0].trees[o + 1]; size := s[0].trees[o + 2]; yaw := s[0].trees[o + 3];
    kind := cast(int) s[0].trees[o + 4];
    base := ground_at(s, x, z);
    if !in_view(u, x, base + 4, z, 6) { continue; }
    d := sqrt((x - eye.x) * (x - eye.x) + (z - eye.z) * (z - eye.z));
    b := lo_i(cast(int) (d / reach * f32(KIT_BUCKETS)), KIT_BUCKETS - 1);
    if kit_on && d < reach && (b < cut[kind] || (b == cut[kind] && taken[kind] < cap)) {
      pick[t] = b; pick_y[t] = base; taken[kind] += 1;
    } else {
      tf_far(s, t, base);   // as it stands now: felled, burnt (everglade-forest.coax)
    }
  }
  for b: 0..<KIT_BUCKETS {
    for t: 0..<s[0].tree_n {
      if pick[t] != b { continue; }
      o := t * TREE_FLOATS;
      tf_kit(s, t, pick_y[t]);
    }
  }
  tf_stumps(s, eye);
  if !kit_on { return; }
  // the thicket at the world's edge, the nearest first, whatever the undergrowth row says
  brush := ifx phone(s) then f32(THICKET_NEAR) * 0.6 else f32(THICKET_NEAR);
  edge_near := hi(abs(eye.x), abs(eye.z)) > f32(EG_THICKET) - brush - 1;
  for pass: 0..<2 {
    if !edge_near { break; }
    for t: 0..<THICKET_BRUSH {
      b := thicket_brush(t);
      if b.kind < 0 { continue; }
      d := sqrt((b.x - eye.x) * (b.x - eye.x) + (b.z - eye.z) * (b.z - eye.z));
      if d >= brush || (pass == 0) != (d < brush * 0.5) { continue; }
      if s[0].kit_used[b.kind] >= cap { continue; }
      base := ground_at(s, b.x, b.z);
      if !in_view(u, b.x, base + 0.8, b.z, 2) { continue; }
      kit(s, b.kind, b.x, base - 0.05, b.z, b.yaw, b.size);
    }
  }
  if !redit_row_on(s[0].ev.ed[..], "undergrowth") { return; }
  for t: 0..<s[0].small_n {
    o := t * TREE_FLOATS;
    x := s[0].smalls[o]; z := s[0].smalls[o + 1];
    d := sqrt((x - eye.x) * (x - eye.x) + (z - eye.z) * (z - eye.z));
    if d >= f32(SMALL_NEAR) { continue; }
    group := cast(int) s[0].smalls[o + 4];
    if s[0].kit_used[group] >= cap { continue; }
    base := ground_at(s, x, z);
    if !in_view(u, x, base + 0.5, z, 1.5) { continue; }
    kit(s, group, x, base - 0.05, z, s[0].smalls[o + 3], s[0].smalls[o + 2]);
  }
}

// The city's characters, where their day has them (verse/everglade/routines.coax):
// walking between work and home on the town's clock, indoors at night. The people are
// skinned characters (verse/everglade/folk.coax): every one lives each frame
// (walks, turns to you, glances, shifts, nods, talks), and the nearest in view,
// PEOPLE_SHOWN at most, are posed and drawn, a part an instance. The cats
// are small and round.
people :: (s: [] Everglade, u: [] f32, you: Point, dt: f32, still: bool) {
  for k: 0..<PEOPLE_PARTS { s[0].part_used[k] = 0; }
  for i: 0..<EG_SPOTS { s[0].head_on[i] = false; }
  for i: 0..<WATCH_ACTORS { s[0].wv.head_on[i] = false; }
  s[0].wv.arm_n = 0;
  c := folk_clock(s, still);
  s[0].shown_n = 0;
  cap := ifx phone(s) then PEOPLE_SHOWN_PHONE else PEOPLE_SHOWN;
  reach := ifx phone(s) then f32(PEOPLE_NEAR_PHONE) else f32(PEOPLE_NEAR);
  gaps: [PEOPLE_SHOWN] f32;
  // where each one's day has them, for the watch (everglade-watch.coax), which then steps once
  for i: 0..<EG_SPOTS {
    if eg_gone(s[0].ev.edits, i) || EG_SPOT_CAT[i] { continue; }
    talking := s[0].talk == i;
    folk_step(s[0].folk[i..<i + 1], i, dt, you, talking, ifx talking then s[0].answered else 1000.0f32, c, s[0].heights[..]);
    watch_home(watch_w(s), i, s[0].folk[i].x, s[0].folk[i].z, s[0].folk[i].yaw, s[0].folk[i].indoors);
  }
  for k: 0..<WATCH_NEW {
    watch_new_place(s, k, c, dt);
    watch_home(watch_w(s), EG_SPOTS + k, s[0].wv.at[k].x, s[0].wv.at[k].z, s[0].wv.at[k].yaw, false);
  }
  watch_frame(s, you, dt, c);
  watch_spears_draw(s);
  watch_missiles_draw(s);
  for i: 0..<WATCH_ACTORS {
    if i < EG_SPOTS && eg_gone(s[0].ev.edits, i) { continue; }   // an admin took them away
    if watch_is_rein(i) && !s[0].wt[0].actors[i].homed { continue; }   // a reinforcement not called in
    if i < EG_SPOTS && EG_SPOT_CAT[i] {
      if s[0].pack_ready { continue; }   // the kit's cat (cats), once the pack is in
      x := EG_SPOT[i * 3]; z := EG_SPOT[i * 3 + 1]; face := EG_SPOT[i * 3 + 2];
      g := ground_at(s, x, z);
      shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(x, g + 0.2, z), face, 0, 0.26, 0.24, 0.46, 0.85, 0.55, 0.22);
      head := v3(x + sin(face) * 0.24, g + 0.36, z + cos(face) * 0.24);
      shape(s, SHAPE_SPHERE, LOOK_MATTE, head, face, 0, 0.2, 0.18, 0.2, 0.85, 0.55, 0.22);
      shape(s, SHAPE_CONE, LOOK_MATTE, add(head, v3(cos(face) * 0.06, 0.1, -sin(face) * 0.06)), face, 0, 0.07, 0.1, 0.05, 0.8, 0.5, 0.2);
      shape(s, SHAPE_CONE, LOOK_MATTE, add(head, v3(-cos(face) * 0.06, 0.1, sin(face) * 0.06)), face, 0, 0.07, 0.1, 0.05, 0.8, 0.5, 0.2);
      continue;
    }
    x := 0.0f32; z := 0.0f32;
    if i < EG_SPOTS {
      watch_apply(s, i);
      if s[0].folk[i].indoors { continue; }
      x = s[0].folk[i].x; z = s[0].folk[i].z;
    } else {
      p := person_place(s, i);
      x = p.x; z = p.z;
    }
    g := folk_feet(s, x, z);
    gap := flat_gap(v3(x, 0, z), you);
    if !ci_person_shown(s, i) { continue; }   // a frog now (everglade-circle.coax)
    if gap < 30 { shadow(s, u, x, z, g, 0.5, 0.5); }
    if gap > reach || !in_view(u, x, g + 1, z, 1.3) { continue; }
    // the nearest `cap`, nearest first; but whoever hunts you first of all (never an unseen attacker)
    if watch_busy(s, i) && s[0].wt[0].actors[i].mode == WM_CHASE { gap -= 1000; }
    k := s[0].shown_n;
    if k == cap { if gap >= gaps[k - 1] { continue; } k -= 1; } else { s[0].shown_n += 1; }
    while k > 0 && gaps[k - 1] > gap { gaps[k] = gaps[k - 1]; s[0].shown[k] = s[0].shown[k - 1]; k -= 1; }
    gaps[k] = gap; s[0].shown[k] = i;
  }
  // each keeps the pose they had; the rest take the poses no one shown holds
  slot: [PEOPLE_SHOWN] int;
  held: [PEOPLE_SHOWN] bool;
  for k: 0..<s[0].shown_n {
    slot[k] = -1;
    for p: 0..<PEOPLE_SHOWN { if s[0].pose_of[p] == s[0].shown[k] { slot[k] = p; held[p] = true; } }
  }
  for k: 0..<s[0].shown_n {
    if slot[k] >= 0 { continue; }
    p := 0;
    while p < PEOPLE_SHOWN && held[p] { p += 1; }
    held[p] = true; slot[k] = p;
    s[0].pose_of[p] = s[0].shown[k]; s[0].poses[p] = Skin.{};
  }
  for k: 0..<s[0].shown_n { pose_person(s, s[0].shown[k], k, slot[k], dt); }
}

// Where person i stands and faces now: a spot's from their day (or the watch), a new guard's from
// their beat or the watch (everglade-watch.coax).
person_place :: (s: [] Everglade, i: int) -> Placed {
  p: Placed;
  if i < EG_SPOTS { p.x = s[0].folk[i].x; p.z = s[0].folk[i].z; p.face = s[0].folk[i].yaw; p.walking = s[0].folk[i].walking; return p; }
  k := i - EG_SPOTS;
  if watch_busy(s, i) || watch_is_rein(i) { a := s[0].wt[0].actors[i]; p.x = a.x; p.z = a.z; p.face = a.yaw; return p; }
  p.x = s[0].wv.at[k].x; p.z = s[0].wv.at[k].z; p.face = s[0].wv.at[k].yaw; p.walking = s[0].wv.at[k].walking;
  return p;
}

// The city's cats as the kit's cat (eg-paint-people), sitting where their day starts, a size each
// (the kit's sits 0.43 m to its ear tips) so the errand cat is a kitten and the inn's is fat.
CAT_SIZE :: [3] f32.[1.15, 1.35, 1.25];
kit_cats :: (s: [] Everglade) {
  if !s[0].pack_ready { return; }
  c := 0;
  for i: 0..<EG_SPOTS {
    if !EG_SPOT_CAT[i] { continue; }
    k := c; c += 1;
    if eg_gone(s[0].ev.edits, i) { continue; }
    x := EG_SPOT[i * 3]; z := EG_SPOT[i * 3 + 1]; face := EG_SPOT[i * 3 + 2];
    kit(s, group_of(M_CAT), x, ground_at(s, x, z), z, face, CAT_SIZE[k % 3]);
  }
}

// The town's clock as the people read it: the painterly day's time and length, and a shared clock for
// the guards' beats (the page's `now`, else the page's own). A still page holds everyone at their spot.
folk_clock :: (s: [] Everglade, still: bool) -> FolkClock {
  c: FolkClock;
  c.still = still;
  c.turning = !still && redit_row_on(s[0].ev.ed[..], "daycycle") && s[0].day.mode != STYLE_CLOCK_FIXED;
  c.day = ifx c.turning then s[0].clock else 0.5f32;
  c.length = ifx s[0].day.mode == STYLE_CLOCK_REAL then 86400.0f32 else f32(STYLE_CYCLE_SECONDS);
  c.world = ifx s[0].now_s > 0 then s[0].now_s + (s[0].time - s[0].day_from) else s[0].time;
  return c;
}

// A person's feet at (x, z): on the ground, or in a pond wading on its bed or swimming at the float line
// (verse/water-wade.coax, the player's rules).
folk_feet :: (s: [] Everglade, x: f32, z: f32) -> f32 {
  // on the bridge they walk on its deck, as you do (walk_at), never in the river under it
  if everglade_on_bridge(s, x, z) { return walk_at(s, x, z); }
  bed := ground_at(s, x, z);
  w := water_at(s, x, z);
  return feet_walking(ifx w <= f32(DEMO_DRY) + 1 then -1000.0f32 else w, bed);
}

// Person i, shown k-th: their pose and colours into store 2, an instance of each part they wear;
// a guard's sword and shield (everglade-watch.coax). Past the spots' people, the new watch (WATCH_*).
pose_person :: (s: [] Everglade, i: int, k: int, slot: int, dt: f32) {
  spot := i < EG_SPOTS;
  w := watch_look(i);
  rein := watch_is_rein(i);
  female := ifx spot then FOLK_FEMALE[i] else WATCH_FEMALE[w];
  rig := people_rig(s[0].people_rig[..], female);
  at := RANGER_JOINTS * 12 + k * PERSON_ROWS * 4;
  sk := s[0].poses[slot..<slot + 1];
  pal := s[0].palette[at..<at + PEOPLE_JOINTS * 12];
  if watch_busy(s, i) { watch_pose(rig, s[0].wt[0].actors[i], sk, dt, pal); }
  else if spot { folk_pose(rig, s[0].folk[i..<i + 1], sk, dt, pal); }
  else {
    // a new guard on their beat: walking, or standing with folded arms
    walking := !rein && s[0].wv.at[w].walking;
    sk[0].fade = f32(FOLK_FADE);
    skin_advance(rig, sk, ifx walking then PEOPLE_WALK else PEOPLE_FOLD, ifx walking then f32(FOLK_WALK) else 0.0f32, dt);
    skin_palette(rig, sk, pal);
  }
  h := at + PEOPLE_JOINTS * 12;
  for c: 0..<3 {
    s[0].palette[h + c] = SKIN_TONE[(ifx spot then FOLK_SKIN[i] else WATCH_SKIN[w]) * 3 + c];
    s[0].palette[h + 4 + c] = ifx spot then FOLK_HAIR_RGB[i * 3 + c] else WATCH_HAIR_RGB[w * 3 + c];
  }
  s[0].palette[h + 3] = f32(ifx spot then FOLK_VARIANT[i] else WATCH_VARIANT[w]);
  s[0].palette[h + 7] = 0;
  for c: 0..<4 { s[0].palette[h + 8 + c] = ifx spot then FOLK_DYE[i * 4 + c] else ifx rein then RANK_DYE[watch_rank(s[0].wt[..], i) * 4 + c] else WATCH_DYE[c]; }
  pl := person_place(s, i);
  x := pl.x; z := pl.z;
  y := folk_feet(s, x, z) + ab_air(s, i);   // off their feet in a spell (everglade-abilities.coax)
  yaw := pl.face;
  c := cos(yaw); sn := sin(yaw);
  // their head, for their name over it
  hp := skin_joint(rig, sk, PEOPLE_HEAD);
  head := v3(c * hp.x + sn * hp.z + x, hp.y + y, -sn * hp.x + c * hp.z + z);
  if spot { s[0].heads[i] = head; s[0].head_on[i] = true; }
  s[0].wv.heads[i] = head; s[0].wv.head_on[i] = true;
  // thrown by a blast: the body as the watch tumbles it (watch.coax Tumble), its sword and shield dropped
  body := s[0].wt[0].actors[i].body;
  thrown := watch_busy(s, i) && (body.on || tumble_turn(body) > 0);
  if watch_is_guard(i) && !thrown && !watch_caster(s[0].wt[..], i) {
    m := s[0].wt[0].actors[i].mode;
    watch_arm_guard(s, rig, sk, x, y, z, yaw, watch_busy(s, i) && (m == WM_CHASE || m == WM_DOWN));
  }
  rows := [12] f32.[c, 0, sn, x,   0, 1, 0, y,   -sn, 0, c, z];
  if thrown { tr := tumble_rows(body, v3(x, y, z)); rows = tr.r; }
  parts: [FOLK_PARTS_MAX] int;
  n := ifx spot then folk_parts(i, parts[..]) else ifx rein then watch_rein_parts(s, i, parts[..]) else watch_parts(w, parts[..]);
  for p: 0..<n {
    part := parts[p];
    if s[0].part_count[part] <= 0 { continue; }
    o := (PEOPLE_AT + part * PEOPLE_SHOWN + s[0].part_used[part]) * OBJECT_FLOATS;
    s[0].part_used[part] += 1;
    for r: 0..<12 { s[0].objects[o + r] = rows[r]; }
    s[0].objects[o + 12] = f32(s[0].part_word[part]);
    s[0].objects[o + 13] = f32(RANGER_JOINTS * 3 + k * PERSON_ROWS);
    s[0].objects[o + 14] = PERSON_MARK;
    s[0].objects[o + 15] = f32(SHAPE_SKINNED + 8 * LOOK_KIT);
  }
}

// The bird flock (eg-companion): small dark birds beating their wings, each
// trailing a ribbon of its own colour that narrows to nothing behind it.
RIBBON :: [21] f32.[
  0.93, 0.32, 0.3,   0.96, 0.72, 0.26,   0.36, 0.7, 0.95,   0.42, 0.85, 0.48,
  0.78, 0.46, 0.92,  0.98, 0.56, 0.7,    0.4, 0.88, 0.86
];
birds :: (s: [] Everglade) {
  f := s[0].birds[..];
  if !f[0].started { return; }
  for i: 0..<FLOCK_BIRDS {
    p := f[0].pos[i]; v := f[0].vel[i];
    heading := ifx flat_length(v) > 0.05 then yaw_of(v.x, v.z) else 0.0f32;
    shape(s, SHAPE_SPHERE, LOOK_MATTE, p, heading, 0, 0.14, 0.11, 0.27, 0.18, 0.19, 0.24);
    right := v3(cos(heading), 0, -sin(heading));
    flap := flock_wing(f, i);
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      wing := add(add(p, times(right, 0.16 * sign)), v3(0, flap * 0.1, 0));
      shape(s, SHAPE_BOX, LOOK_MATTE, wing, heading, 0, 0.25 * (1 - abs(flap) * 0.35), 0.02, 0.11, 0.26, 0.27, 0.33);
    }
    // the ribbon: from the bird back along its trail, each piece narrower
    a := p;
    for k: 0..<f[0].trail_n {
      b := flock_trail(f, i, k);
      d := sub(a, b);
      l := length(d);
      if l > 0.02 {
        fl := flat_length(d);
        tilt := -atan2(d.y, hi(fl, 0.0001));
        wide := 0.14 * (1 - f32(k) / f32(FLOCK_TRAIL));
        shape(s, SHAPE_BOX, LOOK_MATTE, mix(a, b, 0.5), yaw_of(d.x, d.z), tilt, wide, 0.015, l,
              RIBBON[i * 3], RIBBON[i * 3 + 1], RIBBON[i * 3 + 2]);
      }
      a = b;
    }
  }
}

// The town's small life (verse-eg-wildlife; the previous Everglade's butterflies over the flower
// drifts, its songbirds in pairs and a frog hopping round each pond's bank, verse/everglade/previous/
// everglade.md, Layout): by day a butterfly over some of the 5 m cells of open ground within 20 m of
// you, never on a street, and four pairs of songbirds circling low over the commons and the market,
// under the eaves' height so the walking camera sees them; at every hour a frog on each pond's bank,
// sitting 5 s, then leaping 0.5 s to the next of four spots along it. A still page holds them at one moment.
BUTTERFLY_RGB :: [12] f32.[0.98, 0.78, 0.25,  0.96, 0.95, 0.9,  0.55, 0.72, 0.98,  0.96, 0.52, 0.32];
SONG_RINGS :: [8] f32.[0, 0, 11, 5.5,  34, 0, 9, 5];   // x, z, radius, height over the ground
FLY_CELL :: 5.0; FLY_REACH :: 4; FLY_SHARE :: 0.4; WING_SPAN :: 0.09; WING_CHORD :: 0.07;   // half sizes (m)
FROG_SPOTS :: 4; FROG_REST :: 5.0; FROG_LEAP :: 0.5; FROG_RISE :: 0.3; FROG_OUT :: -0.3;   // a spot sits just inside the water, out of the bank's grass
wl_hash :: (x: f32, z: f32) -> f32 { h := sin(x * 127.1 + z * 311.7) * 43758.547; return h - floor(h); }
// A frog's spot i on pond p's bank, where the water meets it: a little round from its trail's side (in
// front of the path's walkers as they come to the water), a fifth of a radian on from its neighbour. The water
// stands under the rim (everglade_pond_level), so the edge is found by stepping in from the rim.
frog_spot :: (s: [] Everglade, p: int, i: int) -> Point {
  if !s[0].frog_known {
    nodes := EG_NODE_XZ; links := EG_LINK_AB;
    for q: 0..<EG_PONDS {
      px := EG_POND[q * 4]; pz := EG_POND[q * 4 + 1];
      by := verse_path_nearest(nodes[..], links[..], px, pz);
      from := atan2(by.z - pz, by.x - px) + 0.8;
      level := everglade_pond_level(s[0].heights[..], q);
      for k: 0..<FROG_SPOTS {
        a := from + f32(k) * 0.2;
        r := EG_POND[q * 4 + 2] + 1;
        for step: 0..<24 {
          if ground_at(s, px + cos(a) * (r - 0.25), pz + sin(a) * (r - 0.25)) < level + 0.04 { break; }
          r -= 0.25;
        }
        x := px + cos(a) * (r + FROG_OUT); z := pz + sin(a) * (r + FROG_OUT);
        o := (q * FROG_SPOTS + k) * 3;
        s[0].frog_spots[o] = x; s[0].frog_spots[o + 1] = hi(ground_at(s, x, z), level); s[0].frog_spots[o + 2] = z;
      }
    }
    s[0].frog_known = true;
  }
  o := (p * FROG_SPOTS + i % FROG_SPOTS) * 3;
  return v3(s[0].frog_spots[o], s[0].frog_spots[o + 1], s[0].frog_spots[o + 2]);
}
// Where pond p's frog is t s in, and which way it faces: sitting at a spot, or in the air between two.
frog_at :: (s: [] Everglade, p: int, t: f32) -> Point {
  leg := f32(FROG_REST + FROG_LEAP);
  u := t + 2.3 * f32(p);
  u = u - floor(u / (leg * f32(FROG_SPOTS))) * leg * f32(FROG_SPOTS);
  i := cast(int) (u / leg);
  from := frog_spot(s, p, i); to := frog_spot(s, p, i + 1);
  into := u - f32(i) * leg;
  if into < FROG_REST { return from; }
  k := lo(hi((into - FROG_REST) / FROG_LEAP, 0), 1);
  return add(mix(from, to, k), v3(0, 4 * k * (1 - k) * FROG_RISE, 0));
}
frogs :: (s: [] Everglade, you: Point, t: f32) {
  for p: 0..<EG_PONDS {
    if EG_POND[p * 4 + 2] <= 0 { continue; }
    f := frog_at(s, p, t);
    if flat_length(sub(f, you)) > 60 { continue; }   // as the old ones: none posed past 60 m
    leg := f32(FROG_REST + FROG_LEAP);
    u := t + 2.3 * f32(p);
    i := cast(int) ((u - floor(u / (leg * f32(FROG_SPOTS))) * leg * f32(FROG_SPOTS)) / leg);
    d := sub(frog_spot(s, p, i + 1), frog_spot(s, p, i));
    face := yaw_of(d.x, d.z);
    fwd := v3(sin(face), 0, cos(face)); right := v3(cos(face), 0, -sin(face));
    shape(s, SHAPE_SPHERE, LOOK_MATTE, add(f, v3(0, 0.09, 0)), face, -0.25, 0.14, 0.09, 0.16, 0.34, 0.58, 0.18);
    shape(s, SHAPE_SPHERE, LOOK_MATTE, add(add(f, times(fwd, 0.14)), v3(0, 0.14, 0)), face, 0, 0.1, 0.07, 0.09, 0.38, 0.64, 0.2);
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      // the haunches at its back, and an eye either side of its head
      shape(s, SHAPE_SPHERE, LOOK_MATTE, add(add(f, times(right, 0.12 * sign)), add(times(fwd, -0.07), v3(0, 0.05, 0))), face, 0, 0.06, 0.05, 0.1, 0.28, 0.5, 0.15);
      shape(s, SHAPE_SPHERE, LOOK_MATTE, add(add(f, times(right, 0.05 * sign)), add(times(fwd, 0.17), v3(0, 0.2, 0))), face, 0, 0.03, 0.03, 0.03, 0.08, 0.07, 0.04);
    }
  }
}
wildlife :: (s: [] Everglade, you: Point, still: bool) {
  t := ifx still then 20.0f32 else f32(s[0].time - floor(s[0].time / 600.0) * 600.0);
  frogs(s, you, t);
  if s[0].clock < 0.3 || s[0].clock > 0.72 { return; }
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  cx := floor(you.x / FLY_CELL); cz := floor(you.z / FLY_CELL);
  for i: 0..<FLY_REACH * 2 + 1 { for j: 0..<FLY_REACH * 2 + 1 {
    gx := cx + f32(i - FLY_REACH); gz := cz + f32(j - FLY_REACH);
    h := wl_hash(gx, gz);
    if h > FLY_SHARE { continue; }
    ax := (gx + 0.5) * FLY_CELL; az := (gz + 0.5) * FLY_CELL;
    if verse_path_nearest(nodes[..], links[..], ax, az).d < f32(EG_PATH_HALF) + 2 { continue; }
    w := t * (0.6 + h) + h * 40;
    p := v3(ax + 1.2 * sin(w) + 0.4 * sin(w * 2.3), 0, az + 1.2 * cos(w * 0.8));
    p.y = ground_at(s, p.x, p.z) + 1.3 + 0.4 * sin(w * 1.7);   // over the grass's tips
    heading := yaw_of(cos(w), -0.8 * sin(w * 0.8));
    flap := sin(t * 19 + h * 30);
    k := cast(int) (h * 14.0) % 4;
    // two thin wings hinged at the body, rolled up and down together as they beat (a shape turned a
    // quarter so its tilt rolls it about the way it flies)
    ang := 0.35 + 0.75 * flap;
    turn := heading + f32(PI) * 0.5;
    shape(s, SHAPE_BOX, LOOK_MATTE, p, heading, 0, 0.012, 0.012, 0.05, 0.16, 0.12, 0.1);   // the body
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      tilt := -sign * ang;
      out := v3(sin(turn) * cos(tilt), -sin(tilt), cos(turn) * cos(tilt));
      shape(s, SHAPE_BOX, LOOK_MATTE, add(p, times(out, sign * WING_SPAN)), turn, tilt, WING_CHORD, 0.006, WING_SPAN,
            BUTTERFLY_RGB[k * 3], BUTTERFLY_RGB[k * 3 + 1], BUTTERFLY_RGB[k * 3 + 2]);
    }
  } }
  // two pairs to a ring, on opposite sides of it, so one is always on the side you face
  for r: 0..<2 { for b: 0..<4 {
    o := r * 4;
    a := t * (0.35 + 0.05 * f32(r)) + f32(b / 2) * f32(PI) + f32(b % 2) * 0.3;
    x := SONG_RINGS[o] + SONG_RINGS[o + 2] * cos(a); z := SONG_RINGS[o + 1] + SONG_RINGS[o + 2] * sin(a);
    p := v3(x, ground_at(s, x, z) + SONG_RINGS[o + 3] + 0.8 * sin(a * 3), z);
    heading := yaw_of(-sin(a), cos(a));
    shape(s, SHAPE_SPHERE, LOOK_MATTE, p, heading, 0, 0.14, 0.12, 0.26, 0.42, 0.3, 0.2);
    right := v3(cos(heading), 0, -sin(heading));
    flap := sin(t * 14 + f32(r * 4 + b));
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      wing := add(add(p, times(right, 0.17 * sign)), v3(0, flap * 0.1, 0));
      shape(s, SHAPE_BOX, LOOK_MATTE, wing, heading, 0, 0.26 * (1 - abs(flap) * 0.35), 0.03 + 0.1 * abs(flap), 0.12, 0.36, 0.26, 0.18);
    }
  } }
}

// You: the old Everglade's Ranger, playing the clip what you are doing picks
// (verse/skin.coax: idle, walk, run, jump; a gait by the distance you move),
// turned to face your way and standing on the ground. Its joints' skinning
// matrices are store 2; everglade.wgsl skins its vertices with them.
// On a still page (a golden, reduced motion), once it has settled into standing idle, it holds the
// idle's first pose, so every shot of it is the same to the pixel however long the page ran first.
figure :: (s: [] Everglade, u: [] f32, feet: Point, face: f32, speed: f32, airborne: bool, dt: f32, still: bool) {
  rig := ranger_rig(s[0].rig[..]);
  dead := s[0].wv.started && s[0].wt[0].dead;
  motion := ifx dead then SKIN_IDLE else skin_motion(speed, airborne);
  if !dead && hm_swinging(s) { motion = SKIN_SWING; }   // the sledgehammer (everglade-hammer.coax)
  skin_advance(rig, s[0].skin[..], motion, speed, dt);
  fade := ifx s[0].skin[0].fade > 0 then s[0].skin[0].fade else f32(SKIN_FADE);
  if still && motion == SKIN_IDLE && s[0].skin[0].clock - s[0].skin[0].changed >= fade {
    s[0].skin[0].time = 0;
    for j: 0..<rig.joints { s[0].skin[0].now[j] = skin_sample(rig, SKIN_IDLE, j, 0); }
  }
  skin_palette(rig, s[0].skin[..], s[0].palette[..]);
  o := RANGER_AT * OBJECT_FLOATS;
  c := cos(face); sn := sin(face);
  rows := [12] f32.[c, 0, sn, feet.x,   0, 1, 0, feet.y,   -sn, 0, c, feet.z];
  if dead {
    // dead: thrown by what killed you, your body where it flew; else you topple over backwards from your
    // feet (watch.coax watch_you_fall) and lie there through YOU DIED
    w := s[0].wt[..];
    b := w[0].you_body;
    if b.on || b.settle >= 0 {
      b.settle = -1;   // the Ranger has no lying clip: the rigid turn holds
      if !b.on { b.pitch = -f32(PI) * 0.5; }
      b.on = true;
      tr := tumble_rows(b, feet); rows = tr.r;
    } else {
      p := watch_you_fall(w);
      cp := cos(p); sp := sin(p);
      rows = [12] f32.[c, sn * sp, sn * cp, feet.x,   0, cp, -sp, feet.y + 0.12 * abs(sp),   -sn, c * sp, c * cp, feet.z];
    }
  } else {
    // Prone on the ice (everglade-frost.coax): you go down on your back and get up again
    p := fr_prone_pitch(s);
    if p != 0 {
      cp := cos(p); sp := sin(p);
      rows = [12] f32.[c, sn * sp, sn * cp, feet.x,   0, cp, -sp, feet.y + 0.12 * abs(sp),   -sn, c * sp, c * cp, feet.z];
    }
  }
  for i: 0..<12 { s[0].objects[o + i] = rows[i]; }
  s[0].objects[o + 12] = f32(s[0].ranger_word); s[0].objects[o + 13] = 1; s[0].objects[o + 14] = 1;
  s[0].objects[o + 15] = f32(SHAPE_SKINNED + 8 * LOOK_KIT);
  shadow(s, u, feet.x, feet.z, floor_under(s, feet.x, feet.z, feet.y), 0.45, 0.6);
}

NEAR :: 0.1; FAR :: 420.0;
view :: (shot: Shot, width: f32, height: f32, u: [] f32, at: int) {
  f := unit_or(sub(shot.at, shot.eye), v3(0, 0, 1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  aspect := width / hi(height, 1);
  fy := clamp(aspect * 1.25, 0.95, 1.9);
  fx := fy / aspect;
  depth := f32(FAR / (FAR - NEAR));
  e := shot.eye;
  rows := [16] f32.[
    r.x * fx, r.y * fx, r.z * fx, -dot(r, e) * fx,
    up.x * fy, up.y * fy, up.z * fy, -dot(up, e) * fy,
    f.x * depth, f.y * depth, f.z * depth, (-dot(f, e) - f32(NEAR)) * depth,
    f.x, f.y, f.z, -dot(f, e)
  ];
  for i: 0..<16 { u[at + i] = rows[i]; }
}

horizon_y :: (shot: Shot, u: [] f32, height: f32) -> f32 {
  f := sub(shot.at, shot.eye); f.y = 0;
  far := add(shot.eye, times(unit_or(f, v3(0, 0, 1)), 1000));
  cy := u[U_VIEW + 4] * far.x + u[U_VIEW + 5] * far.y + u[U_VIEW + 6] * far.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * far.x + u[U_VIEW + 13] * far.y + u[U_VIEW + 14] * far.z + u[U_VIEW + 15];
  if !(cw > 0.001) { return 0; }
  return (1 - cy / cw) * 0.5 * height;
}

ground_room :: (s: [] Everglade, r: OrbitRay) -> f32 {
  lifted := add(r.from, v3(0, -0.5, 0));
  return verse_terrain_ray(everglade_ground(), s[0].heights[..], lifted, r.dir, r.far);
}

// How far the camera may back out along r before a trunk or a rock (forest_bodies' girths and
// tops): it stays CAM_TRUNK_CLEAR clear of each, so it never sits in a tree, among the trees too.
CAM_TRUNK_CLEAR :: 0.25;   // under your own girth, so the line never starts inside one
trunks_room :: (s: [] Everglade, r: OrbitRay) -> f32 {
  room := r.far;
  hd2 := r.dir.x * r.dir.x + r.dir.z * r.dir.z;
  if hd2 < 0.0001 { return room; }
  rocks := s[0].pack_ready && redit_row_on(s[0].ev.ed[..], "undergrowth");
  for list: 0..<3 {
    count := ifx list == 0 then s[0].tree_n else ifx list == 1 then s[0].small_n else THICKET_BRUSH;
    if list > 0 && !rocks { continue; }
    for t: 0..<count {
      g := ifx list == 0 then tf_girth(s, t, tree_girth(s, s[0].trees[..], t)) else ifx list == 1 then tree_girth(s, s[0].smalls[..], t) else brush_girth(t);
      if g.r <= 0 { continue; }
      dx := g.x - r.from.x; dz := g.z - r.from.z; reach := r.far + g.r + 1;
      if abs(dx) > reach || abs(dz) > reach { continue; }
      along := (dx * r.dir.x + dz * r.dir.z) / hd2;
      if along <= 0 { continue; }
      px := r.dir.x * along - dx; pz := r.dir.z * along - dz;
      clear := g.r + f32(CAM_TRUNK_CLEAR);
      side2 := px * px + pz * pz;
      if side2 >= clear * clear { continue; }
      t_in := along - sqrt((clear * clear - side2) / hd2);
      if dx * dx + dz * dz < clear * clear { continue; }
      // over its top the line is clear
      if r.from.y + r.dir.y * hi(t_in, 0) > ground_at(s, g.x, g.z) + g.top + 0.3 { continue; }
      room = lo(room, hi(t_in, 0));
    }
  }
  return room;
}

// The map view: high over the city's south edge, looking north and down
// over all of it, with you still in it.
ABOVE_EYE :: [3] f32.[0, 150, -128];
ABOVE_AT :: [3] f32.[0, 0, 6];

// ---- the weather (W9, verse/water-weather.coax): Everglade's temperate schedule at the world
// tick, so every visitor sees the same sky; ?weather=clear|overcast|fog|rain|storm pins it. A
// still page (a golden) has a calm sky unless it is pinned, and a pinned still page holds one tick.

EG_WEATHER_SEED :: 0xe7e5;

weather_facts :: (s: [] Everglade, text: string) {
  weather_schedule(s[0].weather[..], weather_temperate(), EG_WEATHER_SEED);
  s[0].weather_pin = weather_url_pin(fact(text, "url"));
  if s[0].weather_pin >= 0 { weather_pin_all(s[0].weather[..], s[0].weather_pin); }
  ms := sp_number(fact(text, "now"));
  s[0].weather_ms = ifx is_finite(ms) && ms > 0.0 then ms else 0.0;
  s[0].weather_t0 = s[0].time;
  s[0].weather_at = -1000.0;
  s[0].weather_ready = true;
}

weather_frame :: (s: [] Everglade, u: [] f32, still: bool) {
  w := Weather.{state = WEATHER_CLEAR, rain = 0.0, wind_x = 0.0, wind_z = 0.0, fog = 0.0, cloud = 0.0, lightning = 0.0};
  if s[0].weather_ready && (!still || s[0].weather_pin >= 0) {
    tick := ifx still then 1000 * WEATHER_BLOCK else weather_tick_at(cast(u64) fmax(s[0].weather_ms + (s[0].time - s[0].weather_t0) * 1000.0, 0.0));
    w = weather_sample(s[0].weather[..], tick);
    if s[0].time - s[0].weather_at >= 1.0 || s[0].time < s[0].weather_at {
      s[0].ground = weather_ground(s[0].weather[..], tick);
      s[0].rise = cast(f32) weather_rise(s[0].weather[..], tick);
      s[0].flow_gain = cast(f32) weather_flow_gain(s[0].weather[..], tick);
      s[0].weather_at = s[0].time;
    }
  } else {
    s[0].ground = WeatherGround.{wet = 0.0, puddles = 0.0}; s[0].rise = 0; s[0].flow_gain = 1;
  }
  s[0].sky = w;
  u[U_WEATHER] = cast(f32) w.rain; u[U_WEATHER + 1] = cast(f32) w.wind_x; u[U_WEATHER + 2] = cast(f32) w.wind_z; u[U_WEATHER + 3] = cast(f32) w.lightning;
  u[U_WEATHER + 4] = cast(f32) s[0].ground.wet; u[U_WEATHER + 5] = cast(f32) s[0].ground.puddles;
  u[U_WEATHER + 6] = cast(f32) w.cloud; u[U_WEATHER + 7] = cast(f32) w.fog;
  u[U_WEATHER + 8] = s[0].rise; u[U_WEATHER + 9] = s[0].flow_gain; u[U_WEATHER + 10] = s[0].deck; u[U_WEATHER + 11] = f32(EG_BUILDINGS);
  // under cloud the key light dims (a clear sky's thin cloud leaves it), and fog and rain thicken the haze
  over := cast(f32) fmax(w.cloud - 0.15, 0.0) / 0.85;
  u[STYLE_AT + SU_KEY + 3] *= 1 - 0.55 * over;
  // and the painted sky and haze (style rows 10 to 13: haze, its glow, zenith, horizon) and the
  // ambient (rows 5 and 6) go grey and dim toward a rain sky's blue-grey
  for row: 5..<7 { for k: 0..<3 { u[STYLE_AT + row * 4 + k] *= 1 - 0.3 * over; } }
  for row: 10..<14 {
    at := STYLE_AT + row * 4;
    y := 0.2126 * u[at] + 0.7152 * u[at + 1] + 0.0722 * u[at + 2];
    grey := [3] f32.[0.82, 0.9, 1.0];
    for k: 0..<3 { u[at + k] = lerp(u[at + k], y * grey[k] * 0.78, 0.8 * over); }
  }
  u[U_EYE + 3] *= 1 + 4.0 * cast(f32) w.fog + 1.5 * cast(f32) w.rain;
}
everglade_rise :: (s: [] Everglade) -> f32 #export_c { return s[0].rise; }
everglade_flow_gain :: (s: [] Everglade) -> f32 #export_c { return ifx s[0].flow_gain > 0 then s[0].flow_gain else 1.0f32; }

camera_frame :: (s: [] Everglade, feet: Point, vx: f32, vz: f32, dt: f32) -> Shot {
  speed := sqrt(vx * vx + vz * vz);
  o := verse_orbit_follow(s[0].orbit, feet, yaw_of(vx, vz), finite(speed) && speed > 0.6, dt);
  room := verse_orbit_room(o, s[0].boxes[0..<0], s[0].boxes[0..<s[0].box_n * 6]);
  room = lo(room, ground_room(s, verse_orbit_ray(o)));
  room = lo(room, trunks_room(s, verse_orbit_ray(o)));
  o = verse_orbit_limit(o, room, dt);
  s[0].orbit = o;
  shot := verse_orbit_shot(o);
  // Diving, the camera comes down with you to about your head, so the view
  // goes under the water (verse/water-under.coax) instead of staying on top.
  s[0].sink += ((ifx s[0].water == WATER_DIVING then 1.0f32 else 0.0f32) - s[0].sink) * settle(2.5, dt);
  if s[0].sink > 0.001 {
    low := hi(feet.y + 1.1, ground_at(s, shot.eye.x, shot.eye.z) + 0.35);
    k := s[0].sink * s[0].sink * (3 - 2 * s[0].sink);
    shot.eye.y += lo(low - shot.eye.y, 0) * k;
    shot.at.y += (feet.y + 0.9 - shot.at.y) * k;   // and looks level along the river, not down at the bed
  }
  s[0].lift += ((ifx s[0].above then 1.0f32 else 0.0f32) - s[0].lift) * settle(3.0, dt);
  if s[0].lift < 0.001 { return shot; }
  e := ABOVE_EYE; a := ABOVE_AT;
  t := s[0].lift * s[0].lift * (3 - 2 * s[0].lift);
  high := Shot.{eye = v3(e[0], e[1], e[2]), at = v3(a[0], a[1], a[2])};
  return Shot.{eye = mix(shot.eye, high.eye, t), at = mix(shot.at, high.at, t)};
}

paths :: (u: [] f32) {
  n := 0;
  for i: 0..<EG_LINKS {
    if n >= PATHS { break; }
    a := EG_LINK_AB[i * 2]; b := EG_LINK_AB[i * 2 + 1];
    k := U_PATH + n * 4;
    u[k] = EG_NODE_XZ[a * 2]; u[k + 1] = EG_NODE_XZ[a * 2 + 1]; u[k + 2] = EG_NODE_XZ[b * 2]; u[k + 3] = EG_NODE_XZ[b * 2 + 1];
    n += 1;
  }
  u[U_PATH_INFO] = f32(n); u[U_PATH_INFO + 1] = f32(EG_PATH_HALF);
  for i: 0..<EG_SQUARES {
    if i >= SQUARES { break; }
    k := U_SQUARE + i * 4;
    u[k] = EG_SQUARE[i * 4]; u[k + 1] = EG_SQUARE[i * 4 + 1]; u[k + 2] = EG_SQUARE[i * 4 + 2];
  }
}

// ---- the HUD

plate :: (s: [] Everglade, u: [] f32, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  k := U_PLATE + n * 8;
  u[k] = b.x0; u[k + 1] = b.y0; u[k + 2] = b.x1; u[k + 3] = b.y1;
  u[k + 4] = alpha; u[k + 5] = look; u[k + 6] = s[0].dpr; u[k + 7] = 0;
  s[0].plate_n = n + 1;
}

phone :: (s: [] Everglade) -> bool { return s[0].touch || s[0].width / hi(s[0].dpr, 0.5) < 700; }

hint :: (s: [] Everglade) -> string {
  if s[0].pack_failed { return "THE FOREST DIDN'T LOAD · RELOAD THE PAGE TO TRY AGAIN"; }
  if !s[0].pack_ready { return "THE FOREST IS ON ITS WAY"; }
  if s[0].above {
    if phone(s) { return "THE MAP · TAP MAP TO WALK AGAIN"; }
    return "THE MAP · M OR ESC TO WALK AGAIN";
  }
  if s[0].ev.editing { return edit_hint(s); }
  if s[0].news_time > 0 && s[0].news >= 0 { return news_line(s); }
  if s[0].water == WATER_BOAT { return ifx phone(s) then "ROWING · LEFT THUMB ROWS AND TURNS" else "ROWING · W AND S ROW · A AND D TURN"; }
  if s[0].water == WATER_WADING { return "WADING · HALF SPEED IN THE WATER"; }
  if s[0].water == WATER_SWIMMING { return ifx phone(s) then "SWIMMING · HALF SPEED" else "SWIMMING · HOLD C TO DIVE"; }
  if s[0].water == WATER_DIVING { return ifx phone(s) then "UNDER WATER" else "UNDER WATER · LET GO OF C TO COME UP"; }
  return "";   // no standing controls line: the bottom is the spell bar's
}

// Out of breath (river.coax, SRD 5.2.1): an Exhaustion level each 6 s; the sixth, you come to on the bank.
GASP_LINE :: [5] string.["OUT OF BREATH · EXHAUSTION 1", "OUT OF BREATH · EXHAUSTION 2", "OUT OF BREATH · EXHAUSTION 3",
  "OUT OF BREATH · EXHAUSTION 4", "OUT OF BREATH · EXHAUSTION 5"];

// A quest's news, over the hint for a few seconds: taken, its next step, handed in.
news_line :: (s: [] Everglade) -> string {
  q := s[0].news;
  st := s[0].stages[q];
  n := 0;
  if st == EG_QUEST_DONE {
    n = join_into(s[0].news_text[..], "HANDED IN · ", EG_QUEST_TITLE[q]);
    if EG_QUEST_REWARD[q] == EG_REWARD_FLOCK { n += join_into(s[0].news_text[n..<96], " · THE BIRDS FOLLOW YOU", ""); }
  } else if st == 1 {
    n = join_into(s[0].news_text[..], "QUEST TAKEN · ", eg_quest_todo(q, st));
  } else {
    n = join_into(s[0].news_text[..], "NEXT · ", eg_quest_todo(q, st));
  }
  s[0].news_n = n;
  return cast(string) s[0].news_text[0..<n];
}

// The district you are in: the nearest place.
where :: (you: Point) -> string {
  best := 0; most := 1000000.0f32;
  for p: 0..<EG_PLACES {
    dx := EG_PLACE[p * 2] - you.x; dz := EG_PLACE[p * 2 + 1] - you.z;
    d := dx * dx + dz * dz;
    if d < most { most = d; best = p; }
  }
  return EG_PLACE_NAME[best];
}

// Where a point lands on the screen (device pixels), and whether it is in front.
Screen :: struct { x: f32; y: f32; w: f32; ok: bool; }
on_screen :: (u: [] f32, p: Point, width: f32, height: f32) -> Screen {
  s: Screen;
  cx := u[U_VIEW] * p.x + u[U_VIEW + 1] * p.y + u[U_VIEW + 2] * p.z + u[U_VIEW + 3];
  cy := u[U_VIEW + 4] * p.x + u[U_VIEW + 5] * p.y + u[U_VIEW + 6] * p.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * p.x + u[U_VIEW + 13] * p.y + u[U_VIEW + 14] * p.z + u[U_VIEW + 15];
  s.w = cw;
  s.ok = cw > 0.5;
  if !s.ok { return s; }
  s.x = (cx / cw + 1) * 0.5 * width; s.y = (1 - cy / cw) * 0.5 * height;
  s.ok = s.x > -200 && s.x < width + 200 && s.y > 0 && s.y < height;
  return s;
}

// A name over a point in the world, centred, smaller the further it is.
tag :: (s: [] Everglade, out: [] f32, u: [] f32, n: int, text: string, p: Point, cap: f32, light: f32, gold: bool) -> int {
  sc := on_screen(u, p, s[0].width, s[0].height);
  if !sc.ok { return n; }
  k := hi(s[0].dpr, 0.5);
  w := text_width(text, cap);
  r := ifx gold then f32(GOLD_R) else f32(PARCH_R);
  g := ifx gold then f32(GOLD_G) else f32(PARCH_G);
  b := ifx gold then f32(GOLD_B) else f32(PARCH_B);
  return draw_text(out, n, text, sc.x - w / 2, sc.y, cap, GAP, SPACE, ink(k, light, r, g, b), false, false);
}

// The names over the world: the places, the houses and (on foot) the people. Nearest first, and one that
// would overlap a name already drawn (the owner, October 29: GUILD ROW over THE COMMONS at the market)
// moves up a line, or is left out when that overlaps too, so the farther one gives way.
LABELS_MAX :: EG_PLACES + EG_BUILDINGS + EG_SPOTS + ROOM_OTHERS;
Label :: struct { text: string; p: Point; cap: f32; light: f32; gold: bool; d: f32; done: bool; person: bool; }
labels :: (s: [] Everglade, out: [] f32, u: [] f32, n: int, you: Point) -> int {
  k := hi(s[0].dpr, 0.5);
  overview := s[0].lift > 0.5;
  here := where(you);
  ls: [LABELS_MAX] Label;
  c := 0;
  for p: 0..<EG_PLACES {
    if !overview && EG_PLACE_NAME[p] == here { continue; }
    pp := v3(EG_PLACE[p * 2], ground_at(s, EG_PLACE[p * 2], EG_PLACE[p * 2 + 1]) + 3, EG_PLACE[p * 2 + 1]);
    if !overview && flat_gap(pp, you) > f32(PLACE_NEAR) { continue; }
    ls[c] = Label.{text = EG_PLACE_NAME[p], p = pp, cap = (ifx overview then 8.0f32 else 9.0f32) * k, light = 0.95, gold = true, d = flat_gap(pp, you), done = false, person = false}; c += 1;
  }
  for b: 0..<EG_BUILDINGS {
    if b >= EG_HOUSES || eg_hidden(s[0].ev.edits, b) { continue; }
    q := b * EG_BOX;
    cx := (EG_BUILDING[q] + EG_BUILDING[q + 2]) / 2; cz := (EG_BUILDING[q + 1] + EG_BUILDING[q + 3]) / 2;
    pp := v3(cx, ground_at(s, cx, cz) + EG_BUILDING[q + 4] + 1.5, cz);
    if !overview && flat_gap(pp, you) > f32(PLACE_NEAR) * 0.6 { continue; }
    ls[c] = Label.{text = EG_BUILDING_NAME[b], p = pp, cap = (ifx overview then 6.0f32 else 7.5f32) * k, light = 0.85, gold = false, d = flat_gap(pp, you), done = false, person = false}; c += 1;
  }
  // The people's names (eg-npc-labels): over each one's head as they walk and turn, fading out toward
  // NAME_NEAR; none over someone not drawn, indoors, or behind a wall from the eye.
  if !overview {
    eye := v3(u[U_EYE], u[U_EYE + 1], u[U_EYE + 2]);
    for i: 0..<EG_SPOTS {
      if eg_gone(s[0].ev.edits, i) || s[0].folk[i].indoors { continue; }
      pp := name_point(s, i);
      d := flat_gap(pp, you);
      if d > f32(NAME_NEAR) { continue; }
      if !EG_SPOT_CAT[i] && !s[0].head_on[i] { continue; }   // not drawn this frame: no name in the air
      if name_hidden(s, eye, pp) { continue; }
      light := 0.8 * clamp01((f32(NAME_NEAR) - d) / f32(NAME_FADE));
      ls[c] = Label.{text = EG_SPOT_NAME[i], p = pp, cap = 6.5 * k, light = light, gold = false, d = d, done = false, person = true}; c += 1;
    }
  }
  if !overview { c = room_labels(s, ls[..], c, you, k); }   // the others' names (everglade-room.coax)
  boxes: [LABELS_MAX * 4] f32;
  placed := 0;
  m := n;
  for r: 0..<c {
    best := -1;
    for j: 0..<c { if !ls[j].done && (best < 0 || ls[j].d < ls[best].d) { best = j; } }
    ls[best].done = true;
    l := ls[best];
    sc := on_screen(u, l.p, s[0].width, s[0].height);
    if !sc.ok { continue; }
    w := text_width(l.text, l.cap);
    x0 := sc.x - w / 2 - l.cap * 0.4; x1 := sc.x + w / 2 + l.cap * 0.4;
    y := sc.y;
    shown := false;
    for t: 0..<(ifx l.person then 1 else 2) {   // a person's name stays at their head, or hides
      clear := true;
      for q: 0..<placed {
        o := q * 4;
        if x0 < boxes[o + 2] && x1 > boxes[o] && y - l.cap * 0.3 < boxes[o + 3] && y + l.cap * 1.3 > boxes[o + 1] { clear = false; }
      }
      if clear { shown = true; break; }
      y -= l.cap * 1.8;
    }
    if !shown { continue; }
    o := placed * 4;
    boxes[o] = x0; boxes[o + 1] = y - l.cap * 0.3; boxes[o + 2] = x1; boxes[o + 3] = y + l.cap * 1.3;
    placed += 1;
    r_ := ifx l.gold then f32(GOLD_R) else f32(PARCH_R);
    g_ := ifx l.gold then f32(GOLD_G) else f32(PARCH_G);
    b_ := ifx l.gold then f32(GOLD_B) else f32(PARCH_B);
    m = draw_text(out, m, l.text, sc.x - w / 2, y, l.cap, GAP, SPACE, ink(k, l.light, r_, g_, b_), false, false);
  }
  return m;
}

NAME_FADE :: 3.0;      // metres before NAME_NEAR a name starts to fade
NAME_OVER :: 0.38;     // metres over the head's joint
// Where person i's name goes: over their head (a cat's, over its back).
name_point :: (s: [] Everglade, i: int) -> Point {
  if EG_SPOT_CAT[i] {
    x := EG_SPOT[i * 3]; z := EG_SPOT[i * 3 + 1];
    return v3(x, ground_at(s, x, z) + 0.8, z);
  }
  if s[0].head_on[i] { return add(s[0].heads[i], v3(0, f32(NAME_OVER), 0)); }
  x := s[0].folk[i].x; z := s[0].folk[i].z;
  return v3(x, folk_feet(s, x, z) + 2.1, z);
}
// Whether a wall, a building or the palisade stands between the eye and p (the camera's boxes).
name_hidden :: (s: [] Everglade, eye: Point, p: Point) -> bool {
  for b: 0..<s[0].box_n {
    k := b * 6;
    if segment_box(eye, p, s[0].boxes[k], s[0].boxes[k + 1], s[0].boxes[k + 2], s[0].boxes[k + 3], s[0].boxes[k + 4], s[0].boxes[k + 5]) { return true; }
  }
  return ab_stone_hides(s, eye, p);   // a Wall of Stone (everglade-abilities.coax)
}
// Whether the segment a to b passes through the box (slabs), short of b.
segment_box :: (a: Point, b: Point, x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32) -> bool {
  lo_t := 0.0f32; hi_t := 0.98f32;
  for ax: 0..<3 {
    o := ifx ax == 0 then a.x else ifx ax == 1 then a.y else a.z;
    d := (ifx ax == 0 then b.x else ifx ax == 1 then b.y else b.z) - o;
    mn := ifx ax == 0 then x0 else ifx ax == 1 then y0 else z0;
    mx := ifx ax == 0 then x1 else ifx ax == 1 then y1 else z1;
    if abs(d) < 0.000001 {
      if o < mn || o > mx { return false; }
      continue;
    }
    t0 := (mn - o) / d; t1 := (mx - o) / d;
    if t0 > t1 { tt := t0; t0 = t1; t1 = tt; }
    lo_t = hi(lo_t, t0); hi_t = lo(hi_t, t1);
    if lo_t > hi_t { return false; }
  }
  return true;
}

// The prompt over the hint when someone is near.
join_into :: (out: [] u8, a: string, b: string) -> int {
  n := 0;
  for i: 0..<a.count { if n < out.count { out[n] = a[i]; n += 1; } }
  for i: 0..<b.count { if n < out.count { out[n] = b[i]; n += 1; } }
  return n;
}
talk_prompt :: (s: [] Everglade) -> string {
  if s[0].near_board { return ifx phone(s) then "READ THE QUEST BOARD" else "E · READ THE QUEST BOARD"; }
  if s[0].near < 0 && boat_prompt_on(s) {
    if s[0].water == WATER_BOAT { return ifx phone(s) then "STEP ASHORE" else "E · STEP ASHORE"; }
    return ifx phone(s) then "BOARD THE ROWBOAT" else "E · BOARD THE ROWBOAT";
  }
  if s[0].near < 0 && hm_prompt_on(s) { return hm_prompt(s); }
  if s[0].near < 0 { return ""; }
  s[0].prompt_n = join_into(s[0].prompt[..], ifx phone(s) then "TALK TO " else "E · TALK TO ", EG_PERSON[s[0].near]);
  return cast(string) s[0].prompt[0..<s[0].prompt_n];
}

// The conversation, along the bottom: who you talk to, the last thing they
// said, what you are typing, and BYE.
conversation :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  gutter := 16 * k;
  pw := lo(w - 2 * gutter, 760 * k);
  x0 := (w - pw) / 2; x1 := x0 + pw;
  cap := 8.5 * k; lead := cap * 2.1;
  i := s[0].talk;
  // the last thing they said, wrapped to at most four lines
  said := "";
  for q: 0..<s[0].line_n { if s[0].line_npc[q] { said = line_of(s, q); } }
  inner := pw - 32 * k;
  starts: [5] int; ends: [5] int; lines := 0; from := 0;
  next: [1] int;
  while from < said.count && lines < 4 {
    e := wrap(said, from, inner / cap, GAP, SPACE, false, next[..]);
    starts[lines] = from; ends[lines] = e; lines += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  if s[0].waiting { lines = hi_i(lines, 1); }
  ph := 30 * k + cap + 14 * k + f32(hi_i(lines, 1)) * lead + 12 * k + cap + 26 * k;
  y0 := h - gutter - ph;
  plate(s, u, Box.{x0 = x0, y0 = y0, x1 = x1, y1 = h - gutter}, 0.9, 0);
  n := at;
  s[0].head_n = join_into(s[0].head[..], EG_PERSON[i], " · ");
  s[0].head_n += join_into(s[0].head[s[0].head_n..<64], EG_SPOT_NAME[i], "");
  head := cast(string) s[0].head[0..<s[0].head_n];
  y := y0 + 18 * k + cap;
  n = draw_text(out, n, head, x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  // BYE, top right of the panel
  bw := text_width("BYE", 8 * k) + 28 * k;
  bb := Box.{x0 = x1 - 10 * k - bw, y0 = y0 + 8 * k, x1 = x1 - 10 * k, y1 = y0 + 8 * k + 34 * k};
  s[0].bye_button = bb;
  plate(s, u, bb, 0.85, ifx s[0].talk_finger >= 0 then 2.0f32 else 1.0f32);
  n = draw_text(out, n, "BYE", bb.x0 + 14 * k, bb.y1 - 13 * k, 8 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  y += 14 * k;
  for q: 0..<lines {
    y += lead;
    if q < said.count && ends[q] > starts[q] && !(s[0].waiting && q == 0 && said.count == 0) {
      n = draw_text(out, n, said[starts[q]..<ends[q]], x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.85, PARCH_R, PARCH_G, PARCH_B), false, false);
    }
  }
  // the line you type in: a box with what you typed and the caret, or how to
  y += 12 * k + cap + 4 * k;
  fx0 := x0 + 12 * k; fy0 := y - cap - 9 * k; fx1 := x1 - 12 * k; fy1 := y + 9 * k;
  // x0, y0, x1, y1 in device pixels: host.js puts the keyboard field there
  s[0].field[0] = fx0; s[0].field[1] = fy0; s[0].field[2] = fx1; s[0].field[3] = fy1;
  plate(s, u, Box.{x0 = fx0, y0 = fy0, x1 = fx1, y1 = fy1}, 0.95, 1);
  tx := fx0 + 10 * k;
  if s[0].waiting {
    dots := ifx (cast(int) (s[0].time * 3)) % 3 == 0 then "." else ifx (cast(int) (s[0].time * 3)) % 3 == 1 then ". ." else ". . .";
    n = draw_text(out, n, dots, tx, y, cap, GAP, SPACE, ink(k, 0.7, PARCH_R, PARCH_G, PARCH_B), false, false);
  } else {
    typed := typed_text(s);
    tc := cap;
    tw := text_width(typed, tc);
    // the end of a long line stays in view
    shown := typed; skip := 0;
    while tw > fx1 - tx - 2 * tc && skip < typed.count { skip += 1; while skip < typed.count && (typed[skip] & 0xC0) == 0x80 { skip += 1; } shown = typed[skip..<typed.count]; tw = text_width(shown, tc); }
    if s[0].typed_n > 0 {
      n = draw_text(out, n, shown, tx, y, tc, GAP, SPACE, ink(k, 0.95, 1, 1, 1), false, false);
    } else {
      help := ifx phone(s) then "TYPE TO SAY SOMETHING" else "TYPE TO SAY SOMETHING · ENTER SAYS IT · ESC ENDS";
      n = draw_text(out, n, help, tx + 6 * k, y, cap * 0.85, GAP, SPACE, ink(k, 0.6, PARCH_R, PARCH_G, PARCH_B), false, false);
      tw = 0;
    }
    cx := tx + tw + (ifx s[0].typed_n > 0 then 3 * k else 0.0f32);
    if (cast(int) (s[0].time * 2)) % 2 == 0 && lit(out, n, cx, y + 2 * k, cx, y - tc - 1 * k, 0.6 * k, 0.9, 1.2 * k, 1, 1, 1, 0) { n += 6; }
  }
  return n;
}

// The quest you follow, under the title: its name, what to do now and how
// far; and over where it sends you, a mark you can see from afar.
tracker :: (s: [] Everglade, out: [] f32, u: [] f32, at: int, top: f32, you: Point) -> int {
  q := follow(s);
  if q < 0 { return at; }
  k := hi(s[0].dpr, 0.5);
  w := s[0].width;
  gutter := 16 * k;
  st := s[0].stages[q];
  m := eg_quest_mark(q, st);
  n := at;
  far := flat_gap(v3(m.x, 0, m.z), you);
  metres := cast(int) (far + 0.5);
  s[0].mark_n = join_into(s[0].mark_text[..], "QUEST · ", "");
  s[0].mark_n = put_digits(s[0].mark_text[..], s[0].mark_n, metres);
  s[0].mark_n += join_into(s[0].mark_text[s[0].mark_n..<32], " M", "");
  mark := cast(string) s[0].mark_text[0..<s[0].mark_n];
  if m.ok && far > 5 {
    n = tag(s, out, u, n, mark, v3(m.x, ground_at(s, m.x, m.z) + 4.5, m.z), 9 * k, 1.0, true);
  }
  title := EG_QUEST_TITLE[q];
  todo := eg_quest_todo(q, st);
  tc := 8 * k; dc := 6.5 * k;
  room := w - 2 * gutter - 28 * k;
  tw := text_width(title, tc); dw := text_width(todo, dc) + text_width(" · 000 M", dc);
  if tw > room { tc = tc * room / tw; tw = room; }
  if dw > room { dc = dc * room / dw; dw = room; }
  pw := hi(tw, dw) + 28 * k;
  plate(s, u, Box.{x0 = gutter, y0 = top, x1 = gutter + pw, y1 = top + tc + dc + 34 * k}, 0.82, 0);
  n = draw_text(out, n, title, gutter + 14 * k, top + 12 * k + tc, tc, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  y := top + 22 * k + tc + dc;
  n = draw_text(out, n, todo, gutter + 14 * k, y, dc, GAP, SPACE, ink(k, 0.85, PARCH_R, PARCH_G, PARCH_B), false, false);
  if far > 5 {
    n = draw_text(out, n, mark[5..<mark.count], gutter + 14 * k + text_width(todo, dc), y, dc, GAP, SPACE, ink(k, 0.75, GOLD_R, GOLD_G, GOLD_B), false, false);
  }
  return n;
}
// v's decimal digits into out from at; the new length.
put_digits :: (out: [] u8, at: int, v: int) -> int {
  digits: [20] u8; c := 0; x := hi_i(v, 0);
  while true { digits[c] = cast(u8) (48 + x % 10); c += 1; x /= 10; if x == 0 { break; } }
  n := at;
  while c > 0 && n < out.count { c -= 1; out[n] = digits[c]; n += 1; }
  return n;
}

// The quest board, along the bottom: a row a quest with how it stands, what
// the picked one asks (or the board's thanks when you hand it in), and its
// one button: TAKE IT or HAND IT IN. CLOSE, top right.
board_panel :: (s: [] Everglade, out: [] f32, u: [] f32, at: int) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  gutter := 16 * k;
  pw := lo(w - 2 * gutter, 760 * k);
  x0 := (w - pw) / 2; x1 := x0 + pw;
  cap := 8.5 * k; lead := cap * 2.1;
  rh := 40 * k;
  if s[0].pick < 0 || s[0].pick >= EG_QUESTS || !on_board(s, s[0].pick) { s[0].pick = board_nth(s, 0); }
  q := s[0].pick;
  said := ifx s[0].thanks >= 0 then EG_QUEST_THANKS[s[0].thanks] else ifx q >= 0 then EG_QUEST_BRIEF[q] else "";
  inner := pw - 32 * k;
  starts: [6] int; ends: [6] int; lines := 0; from := 0;
  next: [1] int;
  while from < said.count && lines < 5 {
    e := wrap(said, from, inner / cap, GAP, SPACE, false, next[..]);
    starts[lines] = from; ends[lines] = e; lines += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  todo := ifx s[0].thanks < 0 && q >= 0 then eg_quest_todo(q, s[0].stages[q]) else "";
  word := ifx s[0].thanks < 0 then board_word(s) else "";
  ph := 30 * k + cap + 16 * k + f32(board_count(s)) * (rh + 8 * k) + 8 * k + f32(hi_i(lines, 1)) * lead
        + (ifx todo.count > 0 then lead else 0.0f32) + 20 * k + 44 * k + 16 * k;
  y0 := h - gutter - ph;
  plate(s, u, Box.{x0 = x0, y0 = y0, x1 = x1, y1 = h - gutter}, 0.9, 0);
  n := at;
  y := y0 + 18 * k + cap;
  n = draw_text(out, n, "QUEST BOARD", x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  cw := text_width("CLOSE", 8 * k) + 28 * k;
  cb := Box.{x0 = x1 - 10 * k - cw, y0 = y0 + 8 * k, x1 = x1 - 10 * k, y1 = y0 + 8 * k + 34 * k};
  s[0].close_button = cb;
  plate(s, u, cb, 0.85, 1);
  n = draw_text(out, n, "CLOSE", cb.x0 + 14 * k, cb.y1 - 13 * k, 8 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  y += 16 * k;
  rc := 7.5 * k;
  for r: 0..<EG_QUESTS {
    s[0].rows[r] = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
    if !on_board(s, r) { continue; }
    rb := Box.{x0 = x0 + 12 * k, y0 = y, x1 = x1 - 12 * k, y1 = y + rh};
    s[0].rows[r] = rb;
    plate(s, u, rb, ifx r == q then 0.95f32 else 0.6f32, ifx r == q then 1.0f32 else 0.0f32);
    state := eg_quest_state(r, s[0].stages[r]);
    sw := text_width(state, rc);
    title := EG_QUEST_TITLE[r];
    tc := rc;
    room := rb.x1 - rb.x0 - sw - 52 * k;
    if text_width(title, tc) > room { tc = tc * room / text_width(title, tc); }
    digit := [1] u8.[cast(u8) (49 + board_place(s, r))];
    n = draw_text(out, n, cast(string) digit[..], rb.x0 + 12 * k, rb.y1 - 15 * k, rc, GAP, SPACE, ink(k, 0.6, PARCH_R, PARCH_G, PARCH_B), false, false);
    n = draw_text(out, n, title, rb.x0 + 30 * k, rb.y1 - 15 * k, tc, GAP, SPACE,
                  ifx r == q then ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B) else ink(k, 0.75, PARCH_R, PARCH_G, PARCH_B), false, false);
    gold := s[0].stages[r] == 0 || eg_quest_ready(r, s[0].stages[r]);
    n = draw_text(out, n, state, rb.x1 - 12 * k - sw, rb.y1 - 15 * k, rc, GAP, SPACE,
                  ifx gold then ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B) else ink(k, 0.6, PARCH_R, PARCH_G, PARCH_B), false, false);
    y += rh + 8 * k;
  }
  y += 8 * k;
  for l: 0..<lines {
    y += lead;
    if ends[l] > starts[l] {
      n = draw_text(out, n, said[starts[l]..<ends[l]], x0 + 16 * k, y - lead * 0.4, cap, GAP, SPACE, ink(k, 0.85, PARCH_R, PARCH_G, PARCH_B), false, false);
    }
  }
  if todo.count > 0 {
    y += lead;
    n = draw_text(out, n, todo, x0 + 16 * k, y - lead * 0.4, cap * 0.85, GAP, SPACE, ink(k, 0.9, GOLD_R, GOLD_G, GOLD_B), false, false);
  }
  y += 20 * k;
  s[0].act_button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  bx := x0 + 12 * k;
  if word.count > 0 {
    aw := text_width(word, 9 * k) + 32 * k;
    ab := Box.{x0 = bx, y0 = y, x1 = bx + aw, y1 = y + 40 * k};
    s[0].act_button = ab;
    plate(s, u, ab, 0.9, ifx s[0].board_finger >= 0 then 2.0f32 else 1.0f32);
    n = draw_text(out, n, word, ab.x0 + 16 * k, ab.y1 - 15 * k, 9 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
    bx = ab.x1 + 16 * k;
  }
  if !phone(s) {
    help := ifx word.count > 0 then "1 2 3 PICK · ENTER · ESC CLOSES" else "1 2 3 PICK · ESC CLOSES";
    n = draw_text(out, n, help, bx, y + 25 * k, 7 * k, GAP, SPACE, ink(k, 0.6, PARCH_R, PARCH_G, PARCH_B), false, false);
  }
  return n;
}

hud :: (s: [] Everglade, out: [] f32, u: [] f32, move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32, you: Point) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  st_blind_plate(s, u);   // Blinded: the world dark under the HUD (everglade-storm.coax)
  n := ifx s[0].paint_only then 0 else labels(s, out, u, 0, you);
  if !s[0].paint_only && s[0].talk < 0 { n = room_chat_draw(s, out, u, n); }   // the room's chat (everglade-room.coax)
  gutter := 16 * k;
  cap := 11 * k;
  title := fork_title(s);
  small := 7 * k;
  sub_line := where(you);
  tw := hi(text_width(title, cap), text_width(sub_line, small));
  title_box := Box.{x0 = gutter, y0 = gutter, x1 = gutter + tw + 28 * k, y1 = gutter + cap + small + 34 * k};
  plate(s, u, title_box, 0.82, 0);
  n = draw_text(out, n, title, gutter + 14 * k, gutter + 12 * k + cap, cap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  n = draw_text(out, n, sub_line, gutter + 14 * k, gutter + 22 * k + cap + small, small, GAP, SPACE, ink(k, 0.8, PARCH_R, PARCH_G, PARCH_B), false, false);
  // MAP, top right: a click or a tap lifts the camera over the city.
  word := ifx s[0].above then "WALK" else "MAP";
  bw := text_width(word, 9 * k) + 32 * k; bh := 38 * k;
  mb := Box.{x0 = w - gutter - bw, y0 = gutter, x1 = w - gutter, y1 = gutter + bh};
  s[0].map_button = mb;
  plate(s, u, mb, 0.85, ifx s[0].above then 2.0f32 else 1.0f32);
  n = draw_text(out, n, word, mb.x0 + 16 * k, mb.y1 - 14 * k, 9 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  n = fork_hud(s, out, u, n, title_box);   // FORK and its pane (everglade-fork.coax)
  n = watch_hud(s, out, u, n, mb.y1 + 10 * k);   // your HP, WANTED and the watch's shouts (everglade-watch.coax)
  n = st_hud(s, out, u, n);   // Blinded, Deafened; what the beasts say (everglade-storm.coax Speak with Animals)
  s[0].talk_button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  s[0].bye_button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  if s[0].talk >= 0 { return conversation(s, out, u, n); }
  if s[0].board { return board_panel(s, out, u, n); }
  if s[0].lift < 0.5 && !s[0].ev.editing { n = tracker(s, out, u, n, gutter + cap + small + 44 * k, you); }
  line := hint(s);
  hs := 7.5 * k;
  room := w - 2 * gutter - 24 * k;
  lw := text_width(line, hs);
  if lw > room { hs = hs * room / lw; lw = room; }
  y1 := h - hi(gutter, spells_reserve(s));   // over the spell bar, which keeps the bottom as the old engine's did
  // (not under a spell slot's card, which the hint's strokes would draw over: everglade-spells.coax sp_bar)
  if !s[0].sp.tip_on && line.count > 0 {
    plate(s, u, Box.{x0 = (w - lw) / 2 - 12 * k, y0 = y1 - hs - 20 * k, x1 = (w + lw) / 2 + 12 * k, y1 = y1}, 0.72, 0);
    n = draw_text(out, n, line, (w - lw) / 2, y1 - 10 * k, hs, GAP, SPACE, ink(k, 0.85, PARCH_R, PARCH_G, PARCH_B), false, false);
  }
  // Under water, or out of breath: your breath over the hint, and the Exhaustion it costs.
  breathing := 0.0f32;
  if (s[0].breath < 0.999 || s[0].gasps > 0) && !s[0].above && !s[0].ev.editing {
    label := ifx s[0].gasps > 0 then GASP_LINE[clamp_i(s[0].gasps, 1, 5) - 1] else "BREATH";
    ls := 7 * k;
    gw := hi(text_width(label, ls) + 28 * k, 170 * k);
    by1 := y1 - hs - 30 * k;
    back := Box.{x0 = (w - gw) / 2, y0 = by1 - ls - 30 * k, x1 = (w + gw) / 2, y1 = by1};
    plate(s, u, back, 0.72, 0);
    fill := (gw - 20 * k) * s[0].breath;
    if fill > 2 * k { plate(s, u, Box.{x0 = back.x0 + 10 * k, y0 = by1 - 14 * k, x1 = back.x0 + 10 * k + fill, y1 = by1 - 8 * k}, 0.9, 2); }
    n = draw_text(out, n, label, back.x0 + 14 * k, by1 - 20 * k, ls, GAP, SPACE, ink(k, 0.9, PARCH_R, PARCH_G, PARCH_B), false, false);
    breathing = 50 * k;
  }
  y1 -= breathing;
  // the spell bar (everglade-spells.coax), with the ruleset: over the hint
  n = spells_hud(s, out, u, n, y1 - hs - 28 * k);
  // the damage numbers over who was hit (everglade-watch.coax), their shades from the plates the bar left
  if sp_on(s) && !s[0].above && s[0].wv.started { n = watch_pops_draw(s, out, u, n); }
  y1 -= s[0].sp.lift;
  // An admin's EDIT and edit mode (everglade-edit.coax) and TALK TO EDIT (everglade-voice.coax), over the hint; whoever is near is asked above it.
  lift := 0.0f32;
  if s[0].ev.admin { n = everglade_voice_hud(s, out, u, n, y1 - hs - 28 * k); lift = ifx voice_on(s) && ev_text(s).count > 0 then 50 * k else 0.0f32; }
  // Someone near: E (or TALK, on a phone) talks to them.
  if (s[0].near >= 0 || s[0].near_board || boat_prompt_on(s) || hm_prompt_on(s)) && !s[0].above && !s[0].ev.editing {
    ask := talk_prompt(s);
    ts := 9 * k;
    aw := text_width(ask, ts) + 32 * k;
    tb := Box.{x0 = (w - aw) / 2, y0 = y1 - hs - 76 * k - lift, x1 = (w + aw) / 2, y1 = y1 - hs - 34 * k - lift};
    s[0].talk_button = tb;
    plate(s, u, tb, 0.85, ifx s[0].talk_finger >= 0 then 2.0f32 else 1.0f32);
    n = draw_text(out, n, ask, tb.x0 + 16 * k, tb.y1 - 15 * k, ts, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  }
  if move_on {
    r := 46 * k;
    for i: 0..<32 {
      a0 := f32(i) * f32(TAU) / 32; a1 := f32(i + 1) * f32(TAU) / 32;
      if lit(out, n, ox + cos(a0) * r, oy + sin(a0) * r, ox + cos(a1) * r, oy + sin(a1) * r, 0.8 * k, 0.5, 1.5 * k, PARCH_R, PARCH_G, PARCH_B, 0) { n += 6; }
    }
    kx := ox + pad_x * r; ky := oy - pad_y * r;
    if lit(out, n, kx - 0.01, ky, kx + 0.01, ky, 14 * k, 0.8, 6 * k, GOLD_R, GOLD_G, GOLD_B, 0) { n += 6; }
  }
  return n;
}

// ---- the frame

everglade_frame :: (s: [] Everglade, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool,
                    fx: f32, fy: f32, fz: f32, face: f32, act: int, vx: f32, vz: f32,
                    move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32) -> int #export_c {
  if !s[0].started { everglade_start(s); }
  if u.count < UNIFORM_FLOATS { return 0; }
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  s[0].time += f64(t);
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5);
  feet := v3(fx, fy, fz);
  if !finite3(feet) { feet = s[0].feet; }
  s[0].feet = feet; s[0].face = face; s[0].act = act;
  speed := sqrt(vx * vx + vz * vz);
  // afloat, you are where the river holds you; else on the ground or the deck
  shown := add(feet, v3(0, walk_at(s, feet.x, feet.z), 0));
  if s[0].water >= WATER_SWIMMING { shown.y = s[0].swim_feet; }
  else if s[0].water == WATER_WADING { shown.y = s[0].swim_feet + feet.y; }

  shot := camera_frame(s, shown, vx, vz, t);
  shot = spells_camera(s, shot, t);   // a blast shakes it; nothing turns it

  for k: 0..<5 { s[0].counts[k] = 0; }
  s[0].lathe_n = 0;
  s[0].shadow_n = 0; s[0].plate_n = 0; s[0].sp.media_n = 0;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  td_uniforms(s, u, U_TIDE);
  sp_marks(s, u, U_MARKS);
  view(shot, width, height, u, U_VIEW);
  // in a rowboat you sit on its thwart: your legs go down under it, out of sight
  figure(s, u, ifx s[0].water == WATER_BOAT then sub(shown, v3(0, 0.42, 0)) else shown, face, speed, act == 3, t, still);
  if s[0].flock && redit_row_on(s[0].ev.ed[..], "flock") { flock_frame(s[0].birds[..], shown, face, t); birds(s); }
  people(s, u, shown, t, still);
  room_frame(s, t); room_draw(s, shown);   // the others in the realm's room (everglade-room.coax)
  s[0].answered += t;
  s[0].smoke_still = still;
  city(s, u);
  if s[0].pack_ready { street_dress(s, u, shot.eye); }   // the bunting and the signposts (everglade-dress.coax)
  forest(s, u, shot.eye);
  landmarks(s);
  edit_draw(s);
  lamp_posts(s);   // after the edits' draw, which sets the town's groups back to the town's own
  kit_cats(s);
  watch_arms(s);
  hm_frame(s, t); hm_draw(s, shown);   // the sledgehammer (everglade-hammer.coax)
  spells_frame(s, u, shot, t);
  wildlife(s, shown, still);   // last: it takes only the shapes' slots left over
  first := cast(u32) hi_i(s[0].identity_first, 0);
  for kind: 0..<5 {
    d := kind * 4;
    s[0].draws[d] = first;
    s[0].draws[d + 1] = cast(u32) SHAPE_VERTICES[kind];
    s[0].draws[d + 2] = cast(u32) (ifx kind == 0 then 0 else EG_CELLS * EG_CELLS + SLOT_AT[kind]);
    s[0].draws[d + 3] = cast(u32) (ifx kind == 0 then EG_CELLS * EG_CELLS else s[0].counts[kind]);
  }
  s[0].kit_triangles = 0; s[0].forest_triangles = 0;
  lod_frame(s, shot.eye);   // the small pieces near you (everglade-lod.coax)
  for m: 0..<KIT_MESHES {
    group := group_of(m);
    d := (5 + m) * 4;
    lod_on := m >= KIT_TREES * 2 && s[0].lod.first[m] >= 0;
    drawn := ifx lod_on then s[0].lod.count[m] else s[0].kit_used[group];
    s[0].draws[d] = cast(u32) s[0].kit_first[m];
    s[0].draws[d + 1] = cast(u32) s[0].kit_count[m];
    s[0].draws[d + 2] = cast(u32) (EG_CELLS * EG_CELLS + (ifx lod_on then LOD_AT + s[0].lod.first[m] else s[0].group_at[group]));
    s[0].draws[d + 3] = cast(u32) drawn;
    s[0].kit_triangles += s[0].kit_count[m] / 3 * drawn;
    if group < KIT_FOREST { s[0].forest_triangles += s[0].kit_count[m] / 3 * s[0].kit_used[group]; }
  }
  d := RANGER_DRAW * 4;
  s[0].draws[d] = cast(u32) s[0].ranger_first;
  s[0].draws[d + 1] = cast(u32) s[0].ranger_count;
  s[0].draws[d + 2] = cast(u32) (EG_CELLS * EG_CELLS + RANGER_AT);
  // not in a beast's shape (everglade-circle.coax), nor zoomed into your head (first person, verse/camera.coax)
  s[0].draws[d + 3] = cast(u32) (ifx s[0].ranger_count > 0 && ci_you_shown(s) && !you_inside(s) then 1 else 0);
  s[0].kit_triangles += s[0].ranger_count / 3;
  d = LATHE_DRAW * 4;
  s[0].draws[d] = first;
  s[0].draws[d + 1] = cast(u32) LATHE_VERTICES;
  s[0].draws[d + 2] = cast(u32) (EG_CELLS * EG_CELLS + LATHE_AT);
  s[0].draws[d + 3] = cast(u32) s[0].lathe_n;
  // the people: a part a draw, its instances the people shown wearing it
  for k: 0..<PEOPLE_PARTS {
    d = (PEOPLE_DRAW + k) * 4;
    s[0].draws[d] = cast(u32) s[0].part_first[k];
    s[0].draws[d + 1] = cast(u32) s[0].part_count[k];
    s[0].draws[d + 2] = cast(u32) (EG_CELLS * EG_CELLS + PEOPLE_AT + k * PEOPLE_SHOWN);
    s[0].draws[d + 3] = cast(u32) (ifx s[0].part_count[k] > 0 then s[0].part_used[k] else 0);
    s[0].kit_triangles += s[0].part_count[k] / 3 * s[0].part_used[k];
  }
  // the debris: a draw per mesh, its instances the chunks cut from it (everglade-spells.coax sp_shards)
  for m: 0..<KIT_MESHES {
    d = (SHARD_DRAW + m) * 4;
    shards := ifx sp_on(s) then s[0].sp.shard_n[m] else 0;
    s[0].draws[d] = cast(u32) s[0].kit_first[m];
    s[0].draws[d + 1] = cast(u32) s[0].kit_count[m];
    s[0].draws[d + 2] = cast(u32) (EG_CELLS * EG_CELLS + SHARD_AT + (ifx sp_on(s) then s[0].sp.shard_first[m] else 0));
    s[0].draws[d + 3] = cast(u32) (ifx s[0].kit_count[m] > 0 then shards else 0);
    s[0].kit_triangles += s[0].kit_count[m] / 3 * shards;
  }
  // the water: the river a patch an instance, then the fountain's, drawn after everything (host.js
  // coaxial_water_draws)
  d = WATER_DRAW * 4;
  waters := ifx s[0].water_vertices > 0 then s[0].water_patches + FOUNTAIN_INSTANCES + POND_INSTANCES + 1 + FX_INSTANCES else 0;
  s[0].draws[d] = first;
  s[0].draws[d + 1] = cast(u32) s[0].water_vertices;
  s[0].draws[d + 2] = 0;
  s[0].draws[d + 3] = cast(u32) waters;
  s[0].water_triangles = s[0].water_vertices / 3 * waters;

  u[0] = width; u[1] = height; u[2] = f32(s[0].time); u[3] = 1; u[4] = ifx still then 1.0f32 else 0.0f32;
  u[6] = s[0].dpr;
  u[7] = horizon_y(shot, u, height);
  u[U_EYE] = shot.eye.x; u[U_EYE + 1] = shot.eye.y; u[U_EYE + 2] = shot.eye.z;
  u[U_FOUNTAIN] = ground_at(s, 0, 0); u[U_FOUNTAIN + 1] = 1;
  everglade_pond_rows(s[0].heights[..], u[U_PONDS..<U_PONDS + EG_PONDS * 4]);

  // the painterly preset at the clock (art-styles.md 13): the day turns unless the page is still;
  // the key light (the sun, or the moon at night) is the one everything here is lit by
  // (a still page, a golden or reduced motion, shows a turning day at noon, so its shot is the same every time)
  if !still && redit_row_on(s[0].ev.ed[..], "daycycle") { s[0].clock = verse_style_clock_at(s[0].day, cast(f32) (s[0].time - s[0].day_from)); }
  else if s[0].day.mode != STYLE_CLOCK_FIXED { s[0].clock = 0.5; }
  fork_frame(s, ifx still then 0.0f32 else dt);   // a fork's rules: night holds the clock (everglade-fork.coax)
  // no toon outlines here (the owner, October 29): no rim line along any silhouette, people, props, buildings or trees
  _ := verse_style_at(verse_style_no_outlines(verse_style_preset(STYLE_PAINTERLY, ifx phone(s) then STYLE_PHONE else STYLE_DESKTOP)), s[0].clock, u[STYLE_AT..<STYLE_AT + STYLE_FLOATS]);
  sun := unit_or(v3(u[STYLE_AT + SU_KEY_DIR], u[STYLE_AT + SU_KEY_DIR + 1], u[STYLE_AT + SU_KEY_DIR + 2]), v3(0, 1, 0));
  u[U_SUN] = sun.x; u[U_SUN + 1] = sun.y; u[U_SUN + 2] = sun.z;
  spells_light(s, u);
  // the haze (art-styles.md 4): the preset's density and start, thinned and pushed off over the map's lift
  u[U_EYE + 3] = lerp(u[STYLE_AT + SU_HAZE + 1], 0.004, s[0].lift);
  u[U_SUN + 3] = lerp(u[STYLE_AT + SU_HAZE], 170, s[0].lift);
  weather_frame(s, u, still);
  // the grass (art-styles.md 8): a square two radii across round the eye, at the preset's density;
  // none from above (the map) or before the pack (the scene's groups) is in
  for k: 0..<SOLIDS * 4 { u[U_SOLID + k] = 0; }
  for b: 0..<EG_BUILDINGS { for k: 0..<4 { u[U_SOLID + b * 4 + k] = ifx eg_hidden(s[0].ev.edits, b) then 9000.0f32 else EG_BUILDING[b * EG_BOX + k]; } }
  for i: 0..<EG_PROPS { for k: 0..<4 { u[U_SOLID + (EG_BUILDINGS + i) * 4 + k] = EG_PROP[i * EG_BOX + k]; } }
  gr := u[STYLE_AT + SU_GRASS + 1];
  // the far field (4 r2 a density) and the near ring past it (style.coax verse_style_near_blades)
  reach := verse_style_near_reach(u[STYLE_AT + SU_STYLE + 2]);
  far := cast(int) (2 * gr) * cast(int) (2 * gr) * cast(int) u[STYLE_AT + SU_GRASS];
  ring := ifx u[STYLE_AT + SU_FOLIAGE + 3] > 0 then cast(int) (2 * reach) * cast(int) (2 * reach) * cast(int) u[STYLE_AT + SU_FOLIAGE + 3] else 0;
  s[0].grass_n = ifx s[0].pack_ready && s[0].lift < 0.01 then far + ring else 0;
  lamps(s, u, shot.eye, ifx phone(s) then LIGHTS_PHONE else LIGHTS);
  spells_lamps(s, u, ifx phone(s) then LIGHTS_PHONE else LIGHTS);   // the blasts' light, after the lamps
  u[U_GROUND] = f32(EG_CELLS); u[U_GROUND + 1] = f32(EG_CELL); u[U_GROUND + 2] = f32(EG_EDGE); u[U_GROUND + 3] = f32(EG_EDGE);
  paths(u);

  s[0].near = ifx s[0].above || s[0].talk >= 0 || s[0].board then -1 else nearest(s, feet);
  // the quest board, when it is nearer than anyone
  s[0].near_board = false;
  if !s[0].above && s[0].talk < 0 && !s[0].board {
    bm := board_middle();
    bd := flat_gap(bm, feet);
    if bd < f32(BOARD_NEAR) && (s[0].near < 0 || bd < flat_gap(folk_at(s, s[0].near), feet)) {
      s[0].near_board = true; s[0].near = -1;
    }
  }
  // a quest's place reached
  if !s[0].above {
    was: [EG_QUESTS] int;
    for q: 0..<EG_QUESTS { was[q] = s[0].stages[q]; }
    if eg_quest_reach(s[0].stages[..], feet.x, feet.z) > 0 {
      for q: 0..<EG_QUESTS { if was[q] != s[0].stages[q] { quest_moved(s, q); } }
    }
  }
  if s[0].news_time > 0 { s[0].news_time = hi(s[0].news_time - t, 0); }
  keep_quests(s);
  everglade_voice_actions(s);
  if s[0].waiting {
    s[0].waited += t;
    if s[0].waited > f32(ANSWER_WAIT) { s[0].ask_n = 0; everglade_answer(s, "0\n"); }
  }
  n := hud(s, out, u, move_on && !s[0].above && s[0].talk < 0 && !s[0].board, ox, oy, pad_x, pad_y, shown);
  n = watch_overlay(s, out, u, n);
  u[5] = f32(s[0].plate_n);
  // Observe after every gameplay mutation: hammer, spells, edits and weather.
  everglade_guard_tick(s, shown, folk_clock(s, still));
  return n;
}

board_middle :: () -> Point {
  b := EG_BOARD * EG_BOX;
  return v3((EG_PROP[b] + EG_PROP[b + 2]) / 2, 0, (EG_PROP[b + 1] + EG_PROP[b + 3]) / 2);
}

// While the map shows, while you talk or read the board, you stand still.
everglade_busy :: (s: [] Everglade) -> bool #export_c { return s[0].above || s[0].talk >= 0 || s[0].board || watch_down(s); }

// Nothing draws until the pack is in: its index buffer holds the shapes' indices too.
everglade_draws :: (s: [] Everglade) -> int #export_c { return ifx s[0].pack_ready then DRAWS else 0; }
everglade_store_cap :: (k: int) -> int #export_c {
  if k == 0 { return EG_GROUND_POINTS * 2 * 4; }
  if k == 2 { return PALETTE_FLOATS * 4; }
  return ALL_OBJECTS * OBJECT_FLOATS * 4;
}

// ---- checks

#test "the uniforms and shape slots line up with everglade.wgsl's" {
  #assert UNIFORM_FLOATS % 4 == 0;
  #assert U_PATH == 100 && U_PATH_INFO == 228 && U_SQUARE == 232 && U_PLATE == 248 && U_WATER == 760 && STYLE_AT == 1084 && U_SOLID == 1212 && U_LIGHT_INFO == 1340 && U_LIGHTS == 1344 && U_WEATHER == 1472 && U_PONDS == 1484 && U_FX == 1500 && U_TIDE == 1500 + 149 * 4 && U_MARKS == U_TIDE + 8 && UNIFORM_FLOATS == U_MARKS + MK_FLOATS;
  #assert SLOT_AT[4] + SLOTS[4] == SHAPE_OBJECTS;
  total := 0;
  for g: 0..<KIT_GROUPS - KIT_FOREST { total += TOWN_CAP[g]; }
  #assert total == TOWN_OBJECTS && KIT_GROUPS - KIT_FOREST == 53;
  #assert KIT_MESH[M_FENCE] == "Prop_WoodenFence_Single" && KIT_MESH[M_ROOF] == "Roof_RoundTiles_6x8" && KIT_MESH[M_CHALICE] == "Chalice";
  g: [1] Everglade;
  everglade_start(g[..]);
  #assert g[0].group_at[KIT_GROUPS - 1] + g[0].group_cap[KIT_GROUPS - 1] == OBJECTS;
  for k: 2..<5 { #assert SLOT_AT[k] == SLOT_AT[k - 1] + SLOTS[k - 1]; }
  #assert EG_LINKS <= PATHS && EG_SQUARES <= SQUARES;
}

#test "a frame draws the whole city within its slots, and you in front of the camera" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert n > 0 && n <= MAX_VERTICES;
  for k: 1..<5 { #assert g[0].counts[k] < SLOTS[k]; }
  // and the lamps' lanterns (drawn once the pack is in) still fit
  g[0].pack_ready = true; lamp_posts(g[..]);
  for k: 1..<5 { #assert g[0].counts[k] < SLOTS[k]; }
  g[0].pack_ready = false;
  #assert g[0].tree_n > 600 && g[0].small_n > 150;
  // The town is the kit's: every piece within its group, none crowded out.
  for t: KIT_FOREST..<KIT_GROUPS { #assert g[0].kit_used[t] < g[0].group_cap[t]; }
  #assert g[0].kit_used[group_of(M_PLASTER)] + g[0].kit_used[group_of(M_BRICK)] > 150;
  #assert g[0].kit_used[group_of(M_LOG)] > 600 && g[0].kit_used[group_of(M_FLOOR_WOOD)] > 150;
  #assert g[0].kit_used[group_of(M_ROOF)] == EG_BUILDINGS - 2 && g[0].kit_used[group_of(M_TOWER_ROOF)] == 9;
  #assert g[0].kit_used[group_of(M_DOOR)] == EG_BUILDINGS + 1 && g[0].kit_used[group_of(M_STALL)] == 6;
  #assert g[0].wall_n == EG_SOLIDS - 1 && g[0].box_n > EG_PALISADE_N + EG_BUILDINGS;
  p := [4] f32.[0, 1.6, -84, 1];
  cw := 0.0f32; cx := 0.0f32; cy := 0.0f32;
  for i: 0..<4 { cx += u[U_VIEW + i] * p[i]; cy += u[U_VIEW + 4 + i] * p[i]; cw += u[U_VIEW + 12 + i] * p[i]; }
  #assert cw > 0 && abs(cx / cw) < 1 && abs(cy / cw) < 1;
}

#test "the trees fill the woods: off the trails and out of the city, a metre clear of the open ground" {
  g: [1] Everglade;
  everglade_start(g[..]);
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  for t: 0..<g[0].tree_n {
    x := g[0].trees[t * TREE_FLOATS]; z := g[0].trees[t * TREE_FLOATS + 1];
    if abs(x) > f32(EG_THICKET) || abs(z) > f32(EG_THICKET) { continue; }   // the thicket's row, past the edge
    #assert woods_all_round(x, z, 0.99) && everglade_in_woods(x + 0.7, z + 0.7) && everglade_in_woods(x - 0.7, z - 0.7);
    #assert verse_path_nearest(nodes[..], links[..], x, z).d >= f32(EG_TRAIL_FREE) + 0.7;
    #assert !(x > -70 && x < 70 && z > -62 && z < 66);
    k := cast(int) g[0].trees[t * TREE_FLOATS + 4];
    #assert k >= 0 && k < KIT_TREES;
  }
  for t: 0..<g[0].small_n {
    #assert woods_all_round(g[0].smalls[t * TREE_FLOATS], g[0].smalls[t * TREE_FLOATS + 1], 0.79);
    k := cast(int) g[0].smalls[t * TREE_FLOATS + 4];
    #assert k >= KIT_TREES && k < KIT_FOREST;
  }
  // Every 6 m square of deep woods (not near the open ground, nor the river) holds a tree.
  holes := 0; squares := 0;
  for j: 0..<33 {
    for i: 0..<33 {
      x := -99 + f32(i) * 6; z := -99 + f32(j) * 6;
      if !woods_all_round(x + 3, z + 3, 6) || (x + 7 > 84 && x - 1 < 92) { continue; }   // the river has no trees
      squares += 1;
      found := false;
      for t: 0..<g[0].tree_n {
        tx := g[0].trees[t * TREE_FLOATS]; tz := g[0].trees[t * TREE_FLOATS + 1];
        if tx >= x - 1 && tx < x + 7 && tz >= z - 1 && tz < z + 7 { found = true; break; }
      }
      if !found { holes += 1; }
    }
  }
  #assert squares > 100 && holes * 50 < squares;
}

CATALOG :: "pack everglade\nM Pine_5 0 1464 0 0 0 0 1 8 1\nM Pine_5_Leaves 1464 3474 0 0 0 0 1 8 1\nM Pine_4 4938 6480 0 0 0 0 1 9 1\nM Pine_4_Leaves 11418 3630 0 0 0 0 1 9 1 canopy ellipsoid 33 98 0\nM CommonTree_3 15048 5115 0 0 0 0 1 8 1\nM CommonTree_3_Leaves 20163 5400 0 0 0 0 1 9 1 canopy sphere 97 198 0\nM CommonTree_4 25563 9840 0 0 0 0 1 8 1\nM CommonTree_4_Leaves 35403 2358 0 0 0 0 1 9 1\nM Bush_Common_Flowers 37761 4104 0 0 0 0 1 1 1\nM Fern_1 40461 864 0 0 0 0 1 1 1\nM Rock_Medium_1 41325 1026 0 0 0 0 1 2 1\nM Rock_Medium_2 42351 732 0 0 0 0 1 2 1\nI 43083 1024\nC player/male-ranger 44107 94188 3 692676 27402 75\nC people/male-peasant 246666 20058 4 911892 5751 65\nC people/male-ranger 266724 32610 4 946398 10887 65\nC people/male-hood 299334 3204 4 1011720 706 65\nC people/female-peasant 302538 19422 4 1015956 6185 65\nC people/female-ranger 321960 34032 4 1053066 11408 65\nC people/female-hood 355992 3204 4 1121514 706 65\nC people/male-head 359196 8268 4 1125750 1837 65\nC people/female-head 367464 9480 4 1136772 2058 65\nC people/hair-parted 376944 2337 4 1149120 496 65\nC people/hair-buzzed 379281 1494 4 1152096 300 65\nC people/hair-beard 380775 1860 4 1153896 389 65\nC people/hair-long 382635 8598 4 1156230 3060 65\nC people/hair-buns 391233 9732 4 1174590 3481 65\nC people/hair-buzzed-female 400965 1494 4 1195476 300 65\nC people/male-robe 402459 1920 5 1197276 360 65\nC people/female-robe 404379 1920 5 1199436 360 65\nT 0 layer29.jpg 0\n";

#test "the pack's catalog: the kit's meshes by name and the shapes' identity indices; nothing draws before it" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  #assert everglade_draws(g[..]) == 0 && hint(g[..]) == "THE FOREST IS ON ITS WAY";
  everglade_message(g[..], MSG_PACK, "400000 1641536");
  #assert g[0].pack_loaded == 400000 && g[0].pack_total == 1641536;
  everglade_catalog(g[..], CATALOG);
  #assert g[0].pack_ready && g[0].identity_first == 43083 && everglade_draws(g[..]) == DRAWS;
  #assert g[0].kit_first[3] == 11418 && g[0].kit_count[3] == 3630 && g[0].kit_first[11] == 42351;
  // a tree's leaves carry their canopy's colour for the far cones; a kind without one keeps its own
  #assert abs(g[0].canopy_rgb[3] - 0.033) < 0.0001 && abs(g[0].canopy_rgb[4] - 0.098) < 0.0001 && g[0].canopy_rgb[5] == 0;
  #assert abs(g[0].canopy_rgb[7] - 0.198) < 0.0001 && g[0].canopy_rgb[0] == 0 && g[0].canopy_rgb[9] == 0;
  #assert g[0].ranger_first == 44107 && g[0].ranger_count == 94188 && g[0].ranger_word == 692676;
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].draws[0] == 43083 && g[0].draws[5 * 4] == 0 && g[0].draws[5 * 4 + 1] == 1464;
  // On the road in, the trees beside you are the kit's (the Reed Pond's clearing opens
  // beside it), the shared trunk and leaves draws alike.
  used := 0;
  for k: 0..<KIT_TREES { used += g[0].kit_used[k]; }
  #assert used > 20;
  #assert g[0].draws[5 * 4 + 3] == g[0].draws[6 * 4 + 3] && g[0].draws[5 * 4 + 2] == g[0].draws[6 * 4 + 2];
  // the rocks draw as rock (darker, mottled, mossy: everglade.wgsl LOOK_ROCK), a fern as the kit
  kit(g[..], group_of(10), 0, 0, -80, 0, 1); kit(g[..], group_of(9), 1, 0, -80, 0, 1);
  rk := (g[0].group_at[group_of(10)] + g[0].kit_used[group_of(10)] - 1) * OBJECT_FLOATS;
  fk := (g[0].group_at[group_of(9)] + g[0].kit_used[group_of(9)] - 1) * OBJECT_FLOATS;
  #assert g[0].objects[rk + 15] == f32(SHAPE_MESH + 8 * LOOK_ROCK) && g[0].objects[fk + 15] == f32(SHAPE_MESH + 8 * LOOK_KIT);
  // the grass: the far field's 4 r2 a density and the near ring's past it
  #assert g[0].grass_n == 64 * 64 * 24 + 14 * 14 * 32;
  everglade_pack_failed(g[..]);
  #assert !g[0].pack_failed;
}
// (its own check: two Everglades and a frame's vertices are over the compile-time storage cap)
#test "the pack's catalog: a pack that fails before its catalog draws nothing" {
  h: [1] Everglade;
  everglade_start(h[..]);
  everglade_pack_failed(h[..]);
  #assert h[0].pack_failed && everglade_draws(h[..]) == 0;
}

#test "you are the old Everglade's Ranger: one skinned draw, standing on the ground, facing your way" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  face := 0.6f32;
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, face, 0, 0, 0, false, 0, 0, 0, 0);
  d := RANGER_DRAW * 4;
  #assert WATER_DRAW == DRAWS - 1 && g[0].draws[WATER_DRAW * 4 + 3] == 0;   // no river yet: the face hasn't built it
  // the fountain's lathed stone: the basin's and the column's wedges
  #assert g[0].draws[LATHE_DRAW * 4 + 3] == cast(u32) LATHE_SLOTS && g[0].draws[LATHE_DRAW * 4 + 1] == cast(u32) LATHE_VERTICES;
  #assert LATHE_VERTICES <= 1024;
  #assert g[0].draws[d] == 44107 && g[0].draws[d + 1] == 94188 && g[0].draws[d + 3] == 1;
  #assert g[0].draws[d + 2] == cast(u32) (EG_CELLS * EG_CELLS + RANGER_AT);
  o := RANGER_AT * OBJECT_FLOATS;
  #assert g[0].objects[o + 15] == f32(SHAPE_SKINNED + 8 * LOOK_KIT) && g[0].objects[o + 12] == 692676;
  // facing its yaw: the character's +z turned by it, at your feet on the ground
  #assert near(g[0].objects[o + 2], sin(face), 0.0001) && near(g[0].objects[o + 10], cos(face), 0.0001);
  #assert near(g[0].objects[o + 7], ground_at(g[..], 0, -84), 0.0001) && g[0].objects[o + 11] == -84;
  for i: 0..<RANGER_JOINTS * 12 { #assert finite(g[0].palette[i]); }
  // Standing idle, the Ranger's head is 1.5 to 1.9 m up and its lowest joint at the ground.
  rig := ranger_rig(g[0].rig[..]);
  top := -10.0f32; low := 10.0f32;
  for j: 0..<RANGER_JOINTS { p := skin_joint(rig, g[0].skin[..], j); top = hi(top, p.y); low = lo(low, p.y); }
  #assert g[0].skin[0].clip == SKIN_IDLE && top > 1.5 && top < 1.9 && low > -0.05 && low < 0.1;
  #assert RANGER_TRIANGLES == 31396 && g[0].kit_triangles >= RANGER_TRIANGLES;
}
// (its own check: two Everglades and a frame's vertices are over the compile-time storage cap)
#test "no C line, no Ranger: nothing drawn for it, the rest draws" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  d := RANGER_DRAW * 4;
  h: [1] Everglade;
  everglade_start(h[..]);
  everglade_catalog(h[..], "pack everglade\nI 43083 1024\n");
  n := everglade_frame(h[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert h[0].pack_ready && h[0].draws[d + 3] == 0;
}

moving_frame :: (g: [] Everglade, out: [] f32, u: [] f32, act: int, vz: f32) {
  n := everglade_frame(g, out, u, 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, act, 0, vz, false, 0, 0, 0, 0);
}

#test "on a still page the Ranger standing idle holds one pose, however long the page has run" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  for i: 0..<40 { _ := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, true, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  a: [12 * 8] f32;
  for i: 0..<12 * 8 { a[i] = g[0].palette[i]; }
  for i: 0..<23 { _ := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 37.0, true, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert g[0].skin[0].clip == SKIN_IDLE;
  for i: 0..<12 * 8 { #assert g[0].palette[i] == a[i]; }
}

#test "the controller's state picks the clip: idle, walk, run, and jump in the air" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  moving_frame(g[..], out[..], u[..], 0, 0);
  #assert g[0].skin[0].clip == SKIN_IDLE;
  moving_frame(g[..], out[..], u[..], 1, 3.5);
  #assert g[0].skin[0].clip == SKIN_WALK;
  // walking 3.5 m/s for a sixtieth of a second: the walk's 1.3 m loop of 1.333 s moves on 0.0598 s
  #assert near(g[0].skin[0].time, 3.5 / 60.0 / 1.3 * 1.33333337, 0.0001);
  moving_frame(g[..], out[..], u[..], 2, 7.5);
  #assert g[0].skin[0].clip == SKIN_RUN;
  moving_frame(g[..], out[..], u[..], 3, 7.5);
  #assert g[0].skin[0].clip == SKIN_JUMP;
  moving_frame(g[..], out[..], u[..], 0, 0.05);
  #assert g[0].skin[0].clip == SKIN_IDLE;
}

#test "the Ranger's pose is the old engine's: its joints and what they skin, part way into every clip" {
  d: [1] Ranger;
  ranger_load(d[..]);
  rig := ranger_rig(d[..]);
  worst := 0.0f32;
  for row: 0..<RANGER_CHECK.count / 9 {
    c := RANGER_CHECK[row * 9];
    clip := cast(int) c; at := RANGER_CHECK[row * 9 + 1]; j := cast(int) RANGER_CHECK[row * 9 + 2];
    s: [1] Skin;
    s[0] = Skin.{};
    // a fresh character shows its first clip at once; a gait at its own pace moves a second a second
    pace := ifx rig.distance[clip] > 0 then rig.distance[clip] / rig.duration[clip] else 0.0f32;
    skin_advance(rig, s[..], clip, pace, at);
    p := skin_joint(rig, s[..], j);
    want := v3(RANGER_CHECK[row * 9 + 3], RANGER_CHECK[row * 9 + 4], RANGER_CHECK[row * 9 + 5]);
    worst = hi(worst, length(sub(p, want)));
    pal: [RANGER_JOINTS * 12] f32;
    skin_palette(rig, s[..], pal[..]);
    b := j * 12;
    x := v3(0.1, 1, 0.05);
    got := v3(pal[b] * x.x + pal[b + 1] * x.y + pal[b + 2] * x.z + pal[b + 3],
              pal[b + 4] * x.x + pal[b + 5] * x.y + pal[b + 6] * x.z + pal[b + 7],
              pal[b + 8] * x.x + pal[b + 9] * x.y + pal[b + 10] * x.z + pal[b + 11]);
    worst = hi(worst, length(sub(got, v3(RANGER_CHECK[row * 9 + 6], RANGER_CHECK[row * 9 + 7], RANGER_CHECK[row * 9 + 8]))));
  }
  #assert worst < 0.001;
}

#test "the people: the catalog names their parts, and the nearest in view are drawn a part an instance, posed" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  for k: 0..<PEOPLE_PARTS { #assert g[0].part_count[k] > 0 && g[0].part_word[k] > 0; }
  #assert g[0].part_count[PART_MALE_RANGER] == 32610 && g[0].part_word[PART_BEARD] == 1153896;
  // at the South Gate, facing the gate: the guards are in view
  sp := everglade_spawn(g[..]);
  for f: 0..<3 { n := everglade_frame(g[..], out[..], u[..], 1440, 900, 1, 1.0 / 60.0, false, sp.x, 0, sp.z, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert g[0].shown_n > 0 && g[0].shown_n <= PEOPLE_SHOWN;
  drawn := 0;
  for k: 0..<PEOPLE_PARTS {
    d := (PEOPLE_DRAW + k) * 4;
    #assert g[0].draws[d] == cast(u32) g[0].part_first[k] && g[0].draws[d + 1] == cast(u32) g[0].part_count[k];
    #assert g[0].draws[d + 3] == cast(u32) g[0].part_used[k] && g[0].part_used[k] <= g[0].shown_n;
    drawn += g[0].part_used[k];
    for j: 0..<g[0].part_used[k] {
      o := (PEOPLE_AT + k * PEOPLE_SHOWN + j) * OBJECT_FLOATS;
      #assert g[0].objects[o + 12] == f32(g[0].part_word[k]) && g[0].objects[o + 14] == PERSON_MARK && g[0].objects[o + 15] == f32(SHAPE_SKINNED + 8 * LOOK_KIT);
    }
  }
  // each one shown wears a body and a head at least
  #assert drawn >= 2 * g[0].shown_n;
  // and their poses are finite, the river's draw still last
  for k: 0..<g[0].shown_n * PERSON_ROWS * 4 { #assert finite(g[0].palette[RANGER_JOINTS * 12 + k]); }
  #assert WATER_DRAW == DRAWS - 1;
}

#test "a phone draws at most its cap of kit trees, however you look" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  g[0].touch = true;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  // the river at a phone's tier (river.coax everglade_river_vertices, everglade_river_patches), its floats
  ducks := [72] f32.[88.4, -0.9, -26, 0, 0, 0, 0, 0,   87.2, -0.8, 2, 1, 0, 0, 0, 0,   88.8, -0.9, -34, 2, 0, 0, 0, 0,
    86.6, -0.9, -22.5, 0, 0, 0, 0, 1,   86.8, -0.9, -29.5, 0, 0, 0, 0, 1,   89.4, -0.9, -24, 0, 0, 0, 0, 1,
    86.7, -0.8, 4.5, 0, 0, 0, 0, 1,   89.3, -0.8, 7, 0, 0, 0, 0, 1,   86.9, -0.9, -36.5, 0, 0, 0, 0, 1];
  everglade_water(g[..], WATER_GROUND, 0, 1, 0, 6 * 4 * 6, 52, ducks[..], FLOATS);
  most := 0; whole := 0;
  spots := [8] f32.[0, -84,  -75, 0,  44, 74,  80, -4];
  for p: 0..<4 {
    for turn: 0..<4 {
      g[0].orbit.yaw = f32(turn) * f32(PI) / 2;
      n := everglade_frame(g[..], out[..], u[..], 390, 844, 3, 1.0 / 60.0, false, spots[p * 2], 0, spots[p * 2 + 1], 0, 0, 0, 0, false, 0, 0, 0, 0);
      for k: 0..<KIT_TREES { #assert g[0].kit_used[k] <= KIT_CAP_PHONE; }
      most = hi_i(most, g[0].forest_triangles);
      whole = hi_i(whole, g[0].kit_triangles);
      for k: 1..<5 { #assert g[0].counts[k] < SLOTS[k]; }
    }
  }
  // The forest's kit share of a phone's frame stays under 700,000 triangles, and so
  // does the whole frame's kit: the forest, the town and you (the Ranger's 31,396).
  #assert most > 0 && most < 700000 && whole >= most + RANGER_TRIANGLES && whole < 700000;
  // and with the water's 5,760 triangles drawn too (the river's 2,496, the fountain's and the four ponds' 1,536,
  // the weir's sheet and the spray's three instances 192)
  #assert g[0].water_triangles == 5760 && whole + g[0].water_triangles < 700000;
}

#test "the camera stays out of the trees: among them it pulls in before a trunk" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  // in the woods west of the road in, facing each way in turn
  for turn: 0..<4 {
    g[0].orbit.yaw = f32(turn) * f32(PI) / 2;
    for i: 0..<6 {
      n := everglade_frame(g[..], out[..], u[..], 390, 844, 3, 1.0 / 30.0, false, -20, 0, -75, 0, 0, 0, 0, false, 0, 0, 0, 0);
    }
    eye := v3(u[U_EYE], u[U_EYE + 1], u[U_EYE + 2]);
    for t: 0..<g[0].tree_n {
      trunk := tree_girth(g[..], g[0].trees[..], t);
      #assert (eye.x - trunk.x) * (eye.x - trunk.x) + (eye.z - trunk.z) * (eye.z - trunk.z) > trunk.r * trunk.r;
    }
  }
}

#test "the woods are open and the world's edge is the thicket: a step stops only at EG_BOUND" {
  g: [1] Everglade;
  everglade_start(g[..]);
  // Straight out from the south wall, west of the gate, into the trees: nothing stops you.
  a := everglade_hold(g[..], -40, -62, -40, -64);
  #assert a.x == -40 && a.z == -64;
  b := everglade_hold(g[..], -30, -80, -31, -81);
  #assert b.x == -31 && b.z == -81;
  // At the edge you slide along it.
  c := everglade_hold(g[..], 99.9, 10, 100.4, 10.3);
  #assert c.x == 100 && c.z == 10.3;
  d := everglade_hold(g[..], -50, -99.9, -50.2, -100.5);
  #assert d.x == -50.2 && d.z == -100;
  // The thicket stands all round, just past the edge: from every half metre along it, brush (or,
  // across the river, rock) reaches within a stride of the bound, and nothing of it stands inside.
  for side: 0..<4 {
    for i: 0..<401 {
      along := -100 + f32(i) * 0.5;
      bx := ifx side < 2 then along else ifx side == 2 then -f32(EG_BOUND) else f32(EG_BOUND);
      bz := ifx side >= 2 then along else ifx side == 0 then -f32(EG_BOUND) else f32(EG_BOUND);
      least := 1000.0f32;
      for t: side * 2 * THICKET_ROW..<(side + 1) * 2 * THICKET_ROW {
        br := thicket_brush(t);
        if br.kind < 0 { continue; }
        reach := ifx br.kind == 4 then 0.95 * br.size else 1.3 * br.size;
        least = lo(least, sqrt((br.x - bx) * (br.x - bx) + (br.z - bz) * (br.z - bz)) - reach);
      }
      #assert least < 0.6;
    }
  }
  for t: 0..<THICKET_BRUSH {
    br := thicket_brush(t);
    #assert abs(br.x) > f32(EG_BOUND) || abs(br.z) > f32(EG_BOUND);
  }
}

#test "from the road in past the boulder by it: round the rock and on into the trees" {
  g: [1] Everglade;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  // The mossy boulder west of the road below the stables (the owner's screenshot, 2026-10-30): the
  // undergrowth's Rock_Medium_1 at (-4.76, -75.37). Find it, and its girth.
  rock := -1;
  for t: 0..<g[0].small_n {
    o := t * TREE_FLOATS;
    if abs(g[0].smalls[o] + 4.76) < 0.05 && abs(g[0].smalls[o + 1] + 75.37) < 0.05 { rock = t; }
  }
  #assert rock >= 0;
  stone := tree_girth(g[..], g[0].smalls[..], rock);
  #assert stone.r > 1.4 && stone.r < 1.7;
  // It stands in your way where it is drawn: walking at its middle you stop at its face.
  face := walk_toward(g[..], v3(0, 0, stone.z), v3(stone.x, 0, stone.z), 400);
  gap := sqrt((face.x - stone.x) * (face.x - stone.x) + (face.z - stone.z) * (face.z - stone.z));
  #assert gap > stone.r && gap < stone.r + f32(EG_RADIUS) + 0.05;
  // From the spawn up the road, then round the pine on its north side (its trunk touches the
  // rock) and on west and south into the woods behind it.
  a := walk_toward(g[..], everglade_spawn(g[..]), v3(0, 0, -72), 2000);
  #assert abs(a.x) < 0.01 && abs(a.z + 72) < 0.01;
  b := walk_toward(g[..], a, v3(-5.2, 0, -72.2), 2000);
  b = walk_toward(g[..], b, v3(-8, 0, -72.6), 2000);
  #assert abs(b.x + 8) < 0.01 && abs(b.z + 72.6) < 0.01;
  c := walk_toward(g[..], b, v3(-12, 0, -78), 2000);
  #assert abs(c.x + 12) < 0.01 && abs(c.z + 78) < 0.01;
  // and on to the woods' far corner, the thicket at the edge
  e := walk_toward(g[..], c, v3(-99.5, 0, -99.5), 30000);
  #assert abs(e.x + 99.5) < 0.01 && abs(e.z + 99.5) < 0.01;
}

#test "the reach check: every open spot inside the edge is one you walk to" {
  g: [1] Everglade;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  grid: [EG_REACH_N * EG_REACH_N] u8;
  queue: [EG_REACH_N * EG_REACH_N] u32;
  at: [16] f32;
  left := everglade_unreached(g[..], grid[..], queue[..], at[..]);
  #assert left == 0;
  // the woods are reached, and the trails' ends, the ruins and the crypt beside them
  #assert reached(grid[..], -40, -64) && reached(grid[..], -70, 70) && reached(grid[..], 60, -80) && reached(grid[..], -95, -95);
  #assert reached(grid[..], 22, 95) && reached(grid[..], 66, 89.5) && reached(grid[..], 96, -16) && reached(grid[..], 95, 40);
}

#test "M lifts the camera over the city and back; you stand still meanwhile" {
