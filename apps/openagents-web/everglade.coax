}
#test "a hash names a place: you start on the street nearest it, facing it" {
  g: [1] Everglade;
  everglade_hash(g[..], "market");
  #assert everglade_warp(g[..]) && !everglade_warp(g[..]);
  sp := everglade_spawn(g[..]);
  #assert flat_gap(sp, v3(34, 0, 0)) < 12;
  everglade_hash(g[..], "nowhere");
  #assert !everglade_warp(g[..]);
  everglade_hash(g[..], "above");
  #assert g[0].above && g[0].lift == 1;
  // Inside a building you can walk into: past its doorway, facing in.
  everglade_hash(g[..], "in-inn");
  #assert everglade_warp(g[..]) && !g[0].above;
  inn := everglade_spawn(g[..]);
  #assert inn.x > -22 && inn.x < -6 && inn.z > -44 && inn.z < -30;
  // Every room's spawn is well inside its walls, with five metres back to the door for the camera.
  for b: 0..<EG_BUILDINGS {
    if !EG_INTERIOR[b] { continue; }
    everglade_hash(g[..], EG_ROOM_ID[b]);
    #assert everglade_warp(g[..]);
    at := everglade_spawn(g[..]);
    k := b * EG_BOX;
    #assert at.x > EG_BUILDING[k] + 1 && at.x < EG_BUILDING[k + 2] - 1;
    #assert at.z > EG_BUILDING[k + 1] + 1 && at.z < EG_BUILDING[k + 3] - 1;
    r := room_of(g[..], b);
    #assert (at.x - r.fx) * r.vx + (at.z - r.fz) * r.vz >= 5;
  }
  for p: 0..<EG_PLACES {
    everglade_hash(g[..], EG_PLACE_ID[p]);
    #assert everglade_warp(g[..]);
  }
  // A person's name: beside them, near enough to talk.
  everglade_hash(g[..], "old-tam");
  #assert everglade_warp(g[..]);
  tam := everglade_spawn(g[..]);
  #assert flat_gap(tam, v3(EG_SPOT[20 * 3], 0, EG_SPOT[20 * 3 + 1])) < f32(TALK_NEAR) && nearest(g[..], tam) == 20;
  for i: 0..<EG_SPOTS {
    everglade_hash(g[..], ifx i == 5 then "marta" else "nobody");
    if i == 5 { #assert everglade_warp(g[..]) && nearest(g[..], everglade_spawn(g[..])) == 5; }
  }
}

#test "a click on MAP lifts the camera; a drag elsewhere turns it" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  b := g[0].map_button;
  #assert b.x1 > b.x0 && b.x1 <= 1280;
  #assert everglade_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 0, 1) && g[0].above;
  used := everglade_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 2, 0, 1);
  #assert g[0].above && !g[0].drag_on;
  #assert everglade_pointer(g[..], 600, 400, 0, 0, 2) && g[0].drag_on;
  #assert !everglade_pointer(g[..], 300, 500, 0, 1, 3);
}

