  #assert g[0].near_board;
  // and nothing edits Everglade: the Haunted House's B is nobody's here
  #assert !everglade_key(g[..], 'b', 0) && !everglade_key(g[..], 'B', 0);
}

#test "a phone taps TALK and BYE; a cat answers as a cat when the server can't; an unanswered question is given up" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  g[0].touch = true;
  // the errand cat by the fountain
  n := everglade_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, -3.6, 0, 3.2, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == 4 && talk_prompt(g[..]) == "TALK TO Pebble";
  tb := g[0].talk_button;
  #assert tb.x1 > tb.x0 && tb.x1 <= 1170 && tb.y1 <= 2532;
  #assert everglade_pointer(g[..], (tb.x0 + tb.x1) / 2, (tb.y0 + tb.y1) / 2, 0, 1, 7);
  #assert everglade_pointer(g[..], (tb.x0 + tb.x1) / 2, (tb.y0 + tb.y1) / 2, 2, 1, 7) && g[0].talk == 4;
  n = everglade_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, -3.6, 0, 3.2, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].field[2] > g[0].field[0] && g[0].field[3] > g[0].field[1] && g[0].field[3] <= 2532 && g[0].field[0] >= 0;
  k := everglade_key(g[..], 'h', 0); k = everglade_key(g[..], 'i', 0); k = everglade_key(g[..], KEY_ENTER, 0);
  everglade_answer(g[..], "0\n");
  #assert line_of(g[..], g[0].line_n - 1) == "Mrrp.";
  k = everglade_key(g[..], 'h', 0); k = everglade_key(g[..], KEY_ENTER, 0);
  n = everglade_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.25, false, -3.6, 0, 3.2, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].waiting;
  g[0].waited = f32(ANSWER_WAIT) - 0.1;
  n = everglade_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.25, false, -3.6, 0, 3.2, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert !g[0].waiting && everglade_ask(g[..]) == 0;
  bb := g[0].bye_button;
  #assert bb.x1 > bb.x0 && bb.x1 <= 1170;
  #assert everglade_pointer(g[..], (bb.x0 + bb.x1) / 2, (bb.y0 + bb.y1) / 2, 0, 1, 8);
  #assert everglade_pointer(g[..], (bb.x0 + bb.x1) / 2, (bb.y0 + bb.y1) / 2, 2, 1, 8) && g[0].talk == -1;
  // a minted player key is kept by the page (action 5)
  everglade_keep_player(g[..], "{\"key\":\"k\",\"id\":\"p-2\"}");
  #assert everglade_action(g[..]) == ACT_PLAYER && cast(string) g[0].outbox[0..<g[0].out_n] == "{\"key\":\"k\",\"id\":\"p-2\"}";
}

#test "the quest board: take a quest, go out to the deep wood, talk to Moss, hand it in; it's kept for this player" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_message(g[..], MSG_FACTS, "tab=x\nnow=1730000000123\nplayer=p-1\n");
  #assert player_id(g[..]) == "p-1";
  // by the board, nearer it than the crier: E reads it
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near_board && g[0].near == -1 && talk_prompt(g[..]) == "E · READ THE QUEST BOARD";
  #assert follow(g[..]) == -1;
  #assert everglade_key(g[..], 'e', 0) && g[0].board && everglade_busy(g[..]) && g[0].pick == 0;
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert n > 0 && board_word(g[..]) == "TAKE IT" && g[0].plate_n <= PLATES;
  for r: 0..<EG_QUESTS { #assert g[0].rows[r].x1 > g[0].rows[r].x0 && g[0].rows[r].y1 <= 800; }
  // W and S pick while the board is up; nothing walks
  #assert everglade_key(g[..], 's', 0) && g[0].pick == 1 && g[0].held == 0;
  #assert everglade_key(g[..], '1', 0) && g[0].pick == 0;
  #assert everglade_key(g[..], KEY_ENTER, 0) && g[0].stages[0] == 1 && g[0].dirty;
  #assert board_word(g[..]) == "" && !everglade_key(g[..], 'r', 8);
  // the next frame keeps it in this browser (action 4)
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert everglade_action(g[..]) == ACT_KEEP && cast(string) g[0].outbox[0..<g[0].out_n] == "eg-quests 1\nplayer=p-1\nq=1,0,0\n";
  everglade_action_done(g[..]);
  #assert everglade_key(g[..], KEY_ESCAPE, 0) && !g[0].board && !everglade_busy(g[..]);
  #assert follow(g[..]) == 0 && news_line(g[..]) == "QUEST TAKEN · GO OUT BY THE EAST GATE TO THE DEEP WOOD";
  // the deep wood: the next step
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -92, 0, 25, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].stages[0] == 2 && news_line(g[..]) == "NEXT · TALK TO MOSS BY THE WAYSTONE";
  // Moss says what the quest brought you for, and is told of it
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -88, 0, 19.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == 19 && everglade_key(g[..], 'e', 0) && g[0].talk == 19 && g[0].stages[0] == 3;
  #assert line_of(g[..], 0) == EG_QUEST_ARRIVE[0];
  for c: "Are you well?" { #assert everglade_key(g[..], cast(int) c, 0); }
  #assert everglade_key(g[..], KEY_ENTER, 0);
  body := cast(string) g[0].ask[0..<everglade_ask(g[..])];
  #assert contains(body, "came out from the city's quest board") && contains(body, "\"name\":\"Moss\"");
  everglade_answer(g[..], "200\n{\"text\":\"I am.\"}");
  #assert everglade_key(g[..], KEY_ESCAPE, 0);
  // the board takes it in, and says so
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert everglade_action(g[..]) == ACT_KEEP;
  everglade_action_done(g[..]);
  #assert everglade_key(g[..], 'E', 0) && g[0].board && g[0].pick == 0 && board_word(g[..]) == "HAND IT IN";
  #assert everglade_key(g[..], 'e', 0) && g[0].stages[0] == EG_QUEST_DONE && g[0].thanks == 0 && !g[0].flock;
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert everglade_action(g[..]) == ACT_KEEP && cast(string) g[0].outbox[0..<g[0].out_n] == "eg-quests 1\nplayer=p-1\nq=9,0,0\n";
  // a phone: tap a row, then the button; CLOSE closes
  g[0].touch = true;
  r1 := g[0].rows[1];
  #assert everglade_pointer(g[..], (r1.x0 + r1.x1) / 2, (r1.y0 + r1.y1) / 2, 0, 1, 3);
  #assert everglade_pointer(g[..], (r1.x0 + r1.x1) / 2, (r1.y0 + r1.y1) / 2, 2, 1, 3) && g[0].pick == 1;
  n = everglade_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, 6.2, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  ab := g[0].act_button;
  #assert ab.x1 > ab.x0 && ab.y1 <= 2532;
  #assert everglade_pointer(g[..], ab.x0 + 2, ab.y0 + 2, 0, 1, 4) && everglade_pointer(g[..], ab.x0 + 2, ab.y0 + 2, 2, 1, 4);
  #assert g[0].stages[1] == 1;
  cb := g[0].close_button;
  #assert everglade_pointer(g[..], cb.x0 + 2, cb.y0 + 2, 0, 1, 5) && everglade_pointer(g[..], cb.x0 + 2, cb.y0 + 2, 2, 1, 5) && !g[0].board;
}

#test "the river quest earns the flock, handed in to the crier; a save comes back for its player only" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  #assert eg_quest_take(g[0].stages[..], 2, 0);
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 93, 0, -12, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].stages[2] == 2;
  talk_to(g[..], 20);
  #assert g[0].stages[2] == 3 && line_of(g[..], 0) == EG_QUEST_ARRIVE[2];
  end_talk(g[..]);
  talk_to(g[..], EG_CRIER);
  #assert g[0].stages[2] == EG_QUEST_DONE && line_of(g[..], 0) == EG_QUEST_THANKS[2] && g[0].flock;
  #assert news_line(g[..]) == "HANDED IN · ACROSS THE RIVER · THE BIRDS FOLLOW YOU";
  end_talk(g[..]);
  // the flock comes with you, every bird and its ribbon within the shapes' slots
  for f: 0..<30 {
    n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.05, false, 0, 0, -84 + f32(f) * 0.15, 0, 1, 0, 3.5, false, 0, 0, 0, 0);
  }
  #assert g[0].birds[0].started && g[0].birds[0].trail_n == FLOCK_TRAIL;
  #assert g[0].counts[SHAPE_BOX] < SLOTS[SHAPE_BOX] && g[0].counts[SHAPE_SPHERE] < SLOTS[SHAPE_SPHERE];
  for i: 0..<FLOCK_BIRDS { #assert flat_gap(g[0].birds[0].pos[i], v3(0, 0, -79.65)) < 5; }
  // a minted player key goes out before a waiting save, which follows it
  g[0].dirty = true;
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].action == ACT_KEEP;
  everglade_keep_player(g[..], "{\"key\":\"k\",\"id\":\"p-3\"}");
  #assert everglade_action(g[..]) == ACT_PLAYER && g[0].dirty;
  everglade_action_done(g[..]);
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert everglade_action(g[..]) == ACT_KEEP;
}

// (its own test: three Everglades in one test outgrow the compile-time store)
#test "a quest save comes back for its player only" {
  // a save given back before the facts; then the facts say whose browser it is
  h: [1] Everglade;
  everglade_message(h[..], MSG_KEPT, "eg-quests 1\nplayer=p-1\nq=9,2,9\n");
  #assert h[0].stages[0] == EG_QUEST_DONE && h[0].stages[1] == 2 && h[0].flock;
  everglade_message(h[..], MSG_FACTS, "now=1\nplayer=p-1\n");
  #assert h[0].stages[1] == 2 && h[0].flock;
  o: [1] Everglade;
  everglade_message(o[..], MSG_KEPT, "eg-quests 1\nplayer=p-1\nq=9,2,9\n");
  everglade_message(o[..], MSG_FACTS, "now=1\nplayer=p-2\n");
  #assert o[0].stages[0] == 0 && o[0].stages[1] == 0 && !o[0].flock;
}

#test "a conversation keeps its last lines, oldest dropped" {
  g: [1] Everglade;
  everglade_start(g[..]);
  talk_to(g[..], 11);
  for i: 0..<12 { add_line(g[..], i % 2 == 0, ifx i == 11 then "the last" else "a line"); }
  #assert g[0].line_n == TALK_LINES && line_of(g[..], TALK_LINES - 1) == "the last";
}

contains :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if text[i..<i + part.count] == part { return true; } }
  return false;
}
#test "the painterly day: the page's clock picks the preset, its key lights the realm, a still page shows noon" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_message(g[..], MSG_FACTS, "realm=everglade\nclock=fixed:0.25\nnow=1000");
  #assert g[0].clock == 0.25;
  m := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  // the preset's clock and its key light, which the sun's uniform follows
  #assert abs(u[STYLE_AT + SU_STYLE + 3] - 0.25) < 0.001 && u[STYLE_AT + SU_KEY + 3] > 0;
  #assert u[U_SUN] == u[STYLE_AT + SU_KEY_DIR] && u[U_SUN + 1] == u[STYLE_AT + SU_KEY_DIR + 1];
  // the haze starts and thickens where the preset says on the ground
  #assert u[U_SUN + 3] == u[STYLE_AT + SU_HAZE] && u[U_EYE + 3] == u[STYLE_AT + SU_HAZE + 1];
  #assert m > 0;
}
// (its own check: two Everglades and a frame's vertices are over the compile-time storage cap)
#test "the painterly day: a cycling clock on a still page shows noon" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  c: [1] Everglade;
  everglade_message(c[..], MSG_FACTS, "realm=everglade\nclock=cycle\nnow=1000000");
  #assert c[0].day.mode == STYLE_CLOCK_CYCLE;
  n := everglade_frame(c[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, true, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert n > 0 && c[0].clock == 0.5 && abs(u[STYLE_AT + SU_STYLE + 3] - 0.5) < 0.001;
}

#test "every look has its own number (everglade.wgsl's LOOK_*)" {
  looks := [11] int.[LOOK_MATTE, LOOK_LEAVES, LOOK_STONE, LOOK_SKIN, LOOK_WATER, LOOK_KIT, LOOK_CARVED, LOOK_ROCK, LOOK_PLANKS, LOOK_WOOD, LOOK_FLAME];
  for i: 0..<11 { for j: i + 1..<11 { #assert looks[i] != looks[j]; } }
  #assert LOOK_WINDOW != LOOK_FLAME && LOOK_WINDOW != LOOK_WOOD && LOOK_WINDOW != LOOK_PLANKS && LOOK_WINDOW > 8;
}
#test "the lamps: a brazier, a lantern at each door, torches at the town's crossings off the squares; lit from dusk, full at night" {
  l: [1] Lamp;
  n := 0; torches := 0;
  while lamp_at(n, l[..]) { if l[0].kind == 2 { torches += 1; } n += 1; }
  #assert n == 1 + EG_BUILDINGS + EG_NODES && torches > 8 && torches < EG_NODES;
  #assert lamp_at(0, l[..]) && l[0].kind == 0 && lamp_at(1, l[..]) && l[0].kind == 1 && l[0].x == EG_DOOR[0];
  // the commons' ring of crossings sits on the commons: no torch there
  #assert lamp_at(1 + EG_BUILDINGS, l[..]) && l[0].kind == -1;
  #assert lamp_glow(0.8, false) == 0 && lamp_glow(0.0, false) == 1 && lamp_glow(0.8, true) == 1 && abs(lamp_glow(0.25, false) - 0.5) < 0.0001;
}
