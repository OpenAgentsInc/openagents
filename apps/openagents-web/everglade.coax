  #assert where(v3(33, 0, 1)) == "THE MARKET" && where(v3(0, 0, -86)) == "THE ROAD IN";
}

#test "walk up to someone and press E: you type, they answer through the character chat, and E ends nothing else" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_message(g[..], MSG_FACTS, "tab=x\nnow=1730000000123\nplayer=p-1\n");
  #assert cast(string) g[0].visit[0..<g[0].visit_n] == "1730000000123";
  // far from everyone: E is nobody's
  n := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == -1 && !everglade_key(g[..], 'e', 0) && g[0].talk == -1;
  // by the inn's door, Marta is near
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -2.2, 0, -37, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == 5 && talk_prompt(g[..]) == "E · TALK TO Marta";
  #assert everglade_key(g[..], 'E', 0) && g[0].talk == 5 && everglade_busy(g[..]) && everglade_wants_text(g[..]);
  #assert g[0].line_n == 1 && g[0].line_npc[0] && line_of(g[..], 0) == EG_GREET[5];
  // while you talk, W and D type
  for c: "I'm Wren, I love pie" { #assert everglade_key(g[..], cast(int) c, 0); }
  #assert everglade_key(g[..], KEY_BACKSPACE, 0) && typed_text(g[..]) == "I'm Wren, I love pi";
  #assert !everglade_key(g[..], 'r', 8);   // Cmd+R is the browser's
  #assert everglade_key(g[..], 'e', 0) && everglade_key(g[..], KEY_ENTER, 0);
  #assert g[0].waiting && g[0].typed_n == 0 && g[0].line_n == 2 && line_of(g[..], 1) == "I'm Wren, I love pie";
  body := cast(string) g[0].ask[0..<everglade_ask(g[..])];
  #assert body.count > 0 && contains(body, "\"name\":\"Marta\"") && contains(body, "\"visit\":\"1730000000123\"");
  #assert contains(body, "\"question\":\"I'm Wren, I love pie\"") && contains(body, "\"history\":[{\"from\":\"npc\"");
  everglade_ask_sent(g[..]);
  #assert everglade_ask(g[..]) == 0;
  // nothing more is sent while one is out
  for c: "more" { k := everglade_key(g[..], cast(int) c, 0); }
  k := everglade_key(g[..], KEY_ENTER, 0);
  #assert everglade_ask(g[..]) == 0 && typed_text(g[..]) == "more";
  n = everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -2.2, 0, -37, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert n > 0 && g[0].near == -1;
  everglade_answer(g[..], "200\n{\"text\":\"Wren! Pie's \\\"fresh\\\"\\ntonight.\",\"model\":\"m\"}");
  #assert !g[0].waiting && g[0].line_n == 3 && line_of(g[..], 2) == "Wren! Pie's \"fresh\" tonight.";
  // no answer: they say their own line
  typed := everglade_key(g[..], KEY_ENTER, 0);
  everglade_answer(g[..], "503\n{\"error\":\"busy\"}");
  #assert line_of(g[..], g[0].line_n - 1) == "Hm? Say that again, I didn't catch it.";
  // Esc ends it, and you can walk again
  #assert everglade_key(g[..], KEY_ESCAPE, 0) && g[0].talk == -1 && !everglade_busy(g[..]);
}

#test "what the keyboard field types reaches the conversation and is drawn in a box with a caret (host.js MSG_TEXT)" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  for size: 0..<2 {
    w := ifx size == 0 then 1280 else 390; h := ifx size == 0 then 800 else 844;
    g[0].talk = -1; g[0].line_n = 0;
    n := everglade_frame(g[..], out[..], u[..], cast(f32) w, cast(f32) h, 1, 0.016, false, -2.2, 0, -37, 0, 0, 0, 0, false, 0, 0, 0, 0);
    #assert g[0].near == 5 && everglade_key(g[..], 'e', 0) && g[0].talk == 5;
    // what the page sends with the field focused: no key events, the text itself
    everglade_message(g[..], MSG_TEXT, "Hello");
    everglade_message(g[..], MSG_TEXT, " Marta, café");
    #assert typed_text(g[..]) == "Hello Marta, café";
    // a key still types (the field not focused), and Backspace takes a letter back
    #assert everglade_key(g[..], KEY_BACKSPACE, 0) && everglade_key(g[..], 'e', 0) && typed_text(g[..]) == "Hello Marta, cafe";
    n = everglade_frame(g[..], out[..], u[..], cast(f32) w, cast(f32) h, 1, 0.016, false, -2.2, 0, -37, 0, 0, 0, 0, false, 0, 0, 0, 0);
    // the field is x0, y0, x1, y1 on the screen, inside the panel, and a box is drawn there
    f := g[0].field;
    #assert f[0] >= 0 && f[2] > f[0] + 100 && f[3] > f[1] + 10 && f[3] <= cast(f32) h && f[2] <= cast(f32) w;
    drawn := false;
    for p: 0..<g[0].plate_n { if u[U_PLATE + p * 8] == f[0] && u[U_PLATE + p * 8 + 3] == f[3] { drawn = true; } }
    #assert drawn;
    // a press on the box is the field's, not the camera's or the sticks'
    #assert everglade_pointer(g[..], (f[0] + f[2]) / 2, (f[1] + f[3]) / 2, 0, size, 3) && !g[0].drag_on;
    // a line break says it
    everglade_message(g[..], MSG_TEXT, "\n");
    #assert g[0].waiting && g[0].typed_n == 0 && line_of(g[..], g[0].line_n - 1) == "Hello Marta, cafe" && everglade_ask(g[..]) > 0;
    everglade_answer(g[..], "200\n{\"text\":\"Well met.\",\"model\":\"m\"}");
    #assert !g[0].waiting && line_of(g[..], g[0].line_n - 1) == "Well met.";
    everglade_ask_sent(g[..]);
    // nothing typed outside a conversation
    #assert everglade_key(g[..], KEY_ESCAPE, 0) && g[0].talk == -1;
    everglade_message(g[..], MSG_TEXT, "wasd");
    #assert g[0].typed_n == 0;
  }
}

#test "#quest-board starts you at the board, near enough to read it" {
  g: [1] Everglade;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
