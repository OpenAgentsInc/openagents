// Everglade II's class bar (#13058): your Character Create class's kit at its level, 1 to 6 (#13046;
// class-kit.coax xk_bar_at, Everglade Experimental's bar at that level), pressed with 1 to 9 or a click.
// It aims as Experimental's does, ahead of you and never at anyone for you (xc_aim_for, xc_aim_point),
// and looks and sounds as it does (class-look.coax xc_look_of, class-kit.coax xc_sound,
// experimental-sound.coax). Everglade II has no monsters and its players can't harm each other: a cast
// has no harmful target. The server now resolves self effects and cast costs through
// shared rules; this page predicts presentation. A bolt flies to its range and fizzles, a blow swings at the air,
// an area opens ahead.
//
// A press asks first and plays only once the room says yes (aethyr/action/deed.coax, docs/verse/
// action-pipeline.md, #13072): your bearing (the SRD conditions on the room's row of you) must let you
// act, and every ability declares its feel (class-feel.coax). It goes to the room (everglade2-net.coax
// e2n_cast: C SEQ SLOT AX AY AZ -1), which takes it when the slot is your class's and tells every page
// near (e cast SS SLOT AX AY AZ SEED, coax/web/room/room-everglade.coax eg_e2_cast). Yours plays when
// that word comes back; a refusal (r SEQ WHY), or no word in 1.5 s, greys the slot and plays nothing.
// Another's plays here when the picture of it reaches the tick it came with, from where it is drawn,
// at its seed.
// everglade2.coax loads this beside class-look.coax and experimental-sound.coax (as exsound).

E2K_LATER :: 8;      // sounds waiting a moment: a bolt's fizzle where it ends
E2K_GAIN_START :: 0.55; E2K_GAIN_LAYER :: 0.32; E2K_GAIN_MISS :: 0.4;   // as Experimental's (xc_cast_sound)
E2kLater :: struct { on: bool; t: f32; name: string; x: f32; z: f32; rate: f32 = 1; mine: bool; }
// A refused cast's look and sound (#13046): what your press started, faded out over E2K_FADE s, never cut.
E2K_FADE :: 0.25; E2K_MINE :: 4; E2K_FADES :: 8;
E2kFade :: struct { slot: int = -1; t0: f32; at: f32; }
// A body's cast: when it began and its clip (a blow's slash, a spell's cast), drawn over its gait.
E2kAct :: struct { at: f32 = -100; clip: int = -1; }
// Your press waiting for the room's answer: its request, its slot and where you faced.
E2kAsk :: struct { seq: int; slot: int = -1; wire: int; face: f32; }
E2Cast :: struct {
  klass: int = -1; level: int = 1; bar: [XC_SLOTS] FbAb; bar_n: int;
  wire: [XC_SLOTS] int;                    // each slot's ability on the wire (class-kit.coax xk_wire)
  cool_at: f32 = -100; used: int = -1; hover: int = -1;
  menu: int = -1; side_hover: int = -1; menu_hover: int = -1;   // the side bar's open menu (E2K_SIDE_*) and what the pointer is over
  puffs: [1] FxPuffs;                      // the casts' effects (aethyr/fx/puff.coax), drawn by gpu/everglade2-fx.coax
  audio: [1] exsound.ExperimentalSound;    // their sounds, for the host (everglade2-face.c coaxial_sounds)
  later: [E2K_LATER] E2kLater;
  me: [1] E2kAct; them: [E2N_ENTS] E2kAct;     // yours, and each other's by its slot in the room's list
  pressed: int; others: int; unseen: int; seed: u64 = 0x2545f4914f6cdd1d;
  refused_seen: int;                       // the room's refusals of your casts this page has reconciled
  // your last press's look and sound: its effects' slots (and their starts) and its voices
  mine: [E2K_MINE] int; mine_t0: [E2K_MINE] f32; mine_n: int; voice0: int; voice1: int;
  fades: [E2K_FADES] E2kFade; undone: int;
  deeds: [1] DeedBar;                      // the bar's asks and the room's answers (aethyr/action/deed.coax, #13072)
  ask: E2kAsk;                             // your press the room hasn't answered
  mine_heard: int;                         // your casts the room took that this page has played
  locked: bool; stopped: int;              // your bearing stops your actions: what you had going was stopped (e2k_lock_step)
  area: [1] aa.AreaAim;                    // a placed area armed: its square or circle on the ground at the crosshair (aethyr/action/area-aim.coax)
  aimed_x: f32; aimed_z: f32;              // where your last cast was aimed
}

// Your class's bar at its level: once either changes (the druid at 1 until Character Create says).
e2k_set_class :: (k: [] E2Cast, c: int, level: int) {
  l := xk_level(level);
  if c < 0 || c >= FB_CL_N || (c == k[0].klass && l == k[0].level) { return; }
  k[0].klass = c; k[0].level = l; k[0].bar_n = xk_bar_at(c, l, k[0].bar[..]); k[0].used = -1; k[0].hover = -1;
  for i: 0..<k[0].bar_n { k[0].wire[i] = xk_wire(c, k[0].bar[i]); }
}
e2k_on :: (s: [] E2) -> bool { return s[0].placed && !e2c_creating(s) && s[0].casts[0].bar_n > 0; }

// One sound where it happens: softer the farther from you, panned the way the camera faces.
e2k_cue :: (s: [] E2, name: string, gain: f32, x: f32, z: f32, rate: f32) {
  if name.count == 0 { return; }
  f:=e2n_familiar_view(s[0].net[..]);
  borrowed:=f.live && s[0].net[0].familiar_sense==2;
  dx:=x-(ifx borrowed then f.x else s[0].you_x);
  dz:=z-(ifx borrowed then f.z else s[0].you_z);
  d:=sqrt(dx*dx+dz*dz);
  pan := ifx d > 0.5 then (dx * s[0].right[0] + dz * s[0].right[2]) / d * 0.7 else 0.0f32;
  exsound.experimental_sound_play(s[0].casts[0].audio[..], name, gain / (1 + d / 10), pan, rate);
}
e2k_later :: (k: [] E2Cast, t: f32, name: string, x: f32, z: f32, rate: f32, mine: bool) {
  if name.count == 0 { return; }
  for i: 0..<E2K_LATER { if !k[0].later[i].on { k[0].later[i] = E2kLater.{on = true, t = t, name = name, x = x, z = z, rate = rate, mine = mine}; return; } }
}
// How much of effect slot q (started at t0) is still shown: 1, or less while it fades.
e2k_shown :: (k: [] E2Cast, q: int, t0: f32, now: f32) -> f32 {
  for f: 0..<E2K_FADES {
    d := k[0].fades[f];
    if d.slot == q && d.t0 == t0 { u := e2_sat((now - d.at) / f32(E2K_FADE)); return 1 - u * u * (3 - 2 * u); }
  }
  return 1;
}

// Class c's ability on wire slot `slot` cast by someone whose feet are at (px, py, pz), facing `face`, at the point
// (ax, ay, az), now: its look and its sound; a blow's or spell's clip on its body (act). The causes
// started.
e2k_play :: (s: [] E2, c: int, slot: int, px: f32, py: f32, pz: f32, face: f32, ax: f32, ay: f32, az: f32, seed: int, act: [] E2kAct, mine: bool) -> int {
  k := s[0].casts[..];
  e := xk_entry(c, slot);
  if !e.ok { return 0; }
  now := s[0].clock;
  started := xc_look_start(k[0].puffs[..], xc_look_of(e.ab, px, py, pz, face, fxp_v(ax, ay, az)), now, f32(seed % 9973));
  d := xc_sound(e.ab, c);
  e2k_cue(s, d.start, f32(E2K_GAIN_START), px, pz, d.rate);
  e2k_cue(s, d.layer, f32(E2K_GAIN_LAYER), px, pz, d.rate);
  // a bolt meets no one: it fizzles where its range ends
  if e.aim.kind == XC_AIM_BOLT {
    dx := ax - px; dz := az - pz; fly := sqrt(dx * dx + dz * dz) / 22;
    fly = ifx fly < 0.15 then 0.15f32 else ifx fly > 0.8 then 0.8f32 else fly;
    e2k_later(k, now + fly, ifx d.miss.count > 0 then d.miss else "fizzle", ax, az, d.rate, mine);
  }
  // a blow's slash or a spell's cast, as Experimental's (cast-pose.coax; no weapon drawn here, so no cleave)
  // a bow's arrow is the bow's own pose (its draw and follow-through, everglade2-mouse.coax and e2_remote_aim)
  act[0].at = now; act[0].clip = ifx xc_kit(c) == XC_KIT_BOW && e.ab.kind == FB_ATTACK then -1 else cp_cast_clip(xc_kit(c), e.aim.kind == XC_AIM_MELEE, false);
  return started;
}

// Your bearing: the SRD conditions on the room's row of you (aethyr/rules/srd/condition-bearing.coax).
// Before the room has said, nothing holds you back: the room is still the one that decides.
e2k_bearing :: (s: [] E2) -> DeedBearing {
  row := e2n_vitals(s[0].net[..]);
  if row.id < 0 { return DeedBearing.{}; }
  return e2k_bearing_row(row);
}
// Any player's bearing from the room's row of them (yours, or another's body as the room has it).
e2k_bearing_row :: (row: WireS) -> DeedBearing {
  return rs_bearing_of(row.hp, (row.g & WG_DEAD) != 0, row.cond & 32767, (row.cond & WC_HALTED) != 0, false);
}
// Each frame: once your bearing stops your actions (Unconscious at 0 Hit Points, Stunned...), what you
// had going stops with it: your cast's clip on your body ends, a drawn bow is let down, an armed area
// is dropped. Nothing new starts (deed_ask refuses while locked).
e2k_lock_step :: (s: [] E2) {
  k := s[0].casts[..];
  locked := !deed_can_act(e2k_bearing(s));
  if locked && !k[0].locked {
    k[0].me[0] = E2kAct.{}; k[0].stopped += 1; _ := aa.area_aim_cancel(k[0].area[..]);
    m := s[0].mouse[..]; if m[0].draw[0].on { bow.bow_cancel(m[0].draw[..]); m[0].cancels += 1; }
  }
  k[0].locked = locked;
}
// The plain line while you are down: centred over the bar, the Death Saving Throws as the room rolls
// them (aethyr/rules/srd/death-save-line.coax).
e2k_down_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  if !e2k_on(s) { return at; }
  row := e2n_vitals(s[0].net[..]);
  if row.id < 0 { return at; }
  line: [64] u8; ln := rs_death_line(rs_death_saves(row.hp, (row.g & WG_DEAD) != 0, row.p2), line[..]);
  if ln == 0 { return at; }
  kk := s[0].k; cap := 14 * kk; w := s[0].width;
  return cc.text(out, at, cast(string) line[0..<ln], (w - f32(ln) * cap * 0.55) / 2, s[0].height * 0.38, cap, cc.ink(kk, 1, 0.5, 0.42));
}
// Whether slot i can go now (a held action, such as the bow's draw, asks before it starts): a no from
// your bearing greys the slot.
e2k_ready :: (s: [] E2, i: int) -> bool {
  k := s[0].casts[..];
  if !e2k_on(s) || i < 0 || i >= k[0].bar_n { return false; }
  tick := deed_tick(s[0].clock);
  v := deed_can(k[0].deeds[0], i, tick, e2k_bearing(s), xf_feel(k[0].klass, k[0].bar[i]));
  if v == DeedVerdict.locked || v == DeedVerdict.no_feel { deed_grey(k[0].deeds[..], i, tick); }
  return v == DeedVerdict.ok;
}
// Slot i pressed: asked, then sent; it plays once the room takes it (e2k_step). False when it can't go
// (cooling down, held by your conditions, no room).
e2k_press :: (s: [] E2, i: int) -> bool {
  k := s[0].casts[..];
  if !e2k_on(s) || i < 0 || i >= k[0].bar_n { return false; }
  if s[0].clock - k[0].cool_at < f32(XC_COOL) { return false; }
  c := k[0].klass; a := k[0].bar[i];
  m := xc_aim_for(a, xk_weapon(c));
  face := e2_show_face(s); fx := sin(face); fz := cos(face);   // mouselook: the camera's way
  // a placed area: the first press arms its preview on the ground, the second (or a click) casts it there
  shape := e2k_area_shape(a);
  if shape < 0 { _ := aa.area_aim_cancel(k[0].area[..]); }   // another slot lets an armed area go
  if shape >= 0 {
    ar := k[0].area[..];
    if ar[0].on && ar[0].slot == i { shot := aa.area_aim_confirm(ar); return e2k_cast(s, i, face, shot.x, shot.z); }
    if !e2k_ready(s, i) { return false; }   // arming asks nothing of the room, but your bearing must let you act
    sp := rs_spell(a.sp);
    half := ifx a.kind == FB_SPELL then f32(sp.area_ft) * f32(XC_FT) * (ifx sp.area == RS_A_SPHERE then 1.0f32 else 0.5f32) else 3.0f32;
    ar[0] = aa.area_aim_arm(i, shape, half, m.reach, s[0].clock);
    e2k_area_step(s);
    return true;
  }
  p0 := xc_aim_point(a, m, s[0].you_x, s[0].you_z, fx, fz);
  p := e2gd_aim(s, m, p0, fx, fz);   // at the path's guard when he is before you (everglade2-guard.coax)
  if p[0] == p0[0] && p[1] == p0[1] { p = e2mn_aim(s, m, p0, fx, fz); }   // else at a monster before you (everglade2-monsters.coax)
  return e2k_cast(s, i, face, p[0], p[1]);
}
// The shape a placed area shows while you aim it (aethyr/action/area-aim.coax), -1 when the ability is
// not one: a square for a square or a cube, a circle for a sphere (and Land's Aid's 10-foot circle).
e2k_area_shape :: (a: FbAb) -> int {
  if a.kind == FB_LANDS { return aa.AREA_CIRCLE; }
  if a.kind != FB_SPELL { return -1; }
  sp := rs_spell(a.sp);
  if sp.area == RS_A_SQUARE || sp.area == RS_A_CUBE { return aa.AREA_SQUARE; }
  if sp.area == RS_A_SPHERE { return aa.AREA_CIRCLE; }
  return -1;
}
// Where the crosshair meets the ground: along the camera's line from the eye, the first step under the
// land, 80 m at most (looking up: the furthest point straight on along it).
e2k_crosshair_ground :: (s: [] E2) -> [2] f32 {
  e := s[0].eye; f := s[0].fwd; t: f32 = 0.5;
  while t < 80 {
    x := e[0] + f[0] * t; y := e[1] + f[1] * t; z := e[2] + f[2] * t;
    if y <= e2_height(x, z) { return [2] f32.[x, z]; }
    t += 0.25;
  }
  return [2] f32.[e[0] + f[0] * 80, e[2] + f[2] * 80];
}
// Each frame: the armed area follows the crosshair, held to its range; dropped once the slot can't be used.
e2k_area_step :: (s: [] E2) {
  k := s[0].casts[..]; ar := k[0].area[..];
  if !ar[0].on { return; }
  if !e2k_on(s) || !deed_can_act(e2k_bearing(s)) || ar[0].slot >= k[0].bar_n { _ := aa.area_aim_cancel(ar); return; }
  h := e2k_crosshair_ground(s);
  ar[0] = aa.area_aim_follow(ar[0], s[0].you_x, s[0].you_z, h[0], h[1]);
}
e2k_area_confirm :: (s: [] E2) -> bool { k := s[0].casts[..]; if !k[0].area[0].on { return false; } return e2k_press(s, k[0].area[0].slot); }
e2k_area_cancel :: (s: [] E2) -> bool { return aa.area_aim_cancel(s[0].casts[0].area[..]); }
// The armed area's outline on the ground: gold, red where the crosshair is past its range.
e2k_area_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  a := s[0].casts[0].area[0];
  if !a.on { return at; }
  v := at; e := s[0].eye; f := s[0].fwd; r := s[0].right; up := s[0].up; k := s[0].k;
  cy := ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5;
  pulse := 0.75 + 0.25 * sin(s[0].clock * 6);
  cr := ifx a.far then 1.0f32 else 0.86f32; cg := ifx a.far then 0.32f32 else 0.78f32; cb := ifx a.far then 0.28f32 else 0.42f32;
  px: f32 = 0; py: f32 = 0; was := false;
  for i: 0..<aa.AREA_EDGE + 1 {
    p := aa.area_aim_edge(a, i);
    dx := p[0] - e[0]; dy := e2_height(p[0], p[1]) + 0.06 - e[1]; dz := p[1] - e[2];
    ahead := dx * f[0] + dy * f[1] + dz * f[2];
    if ahead < 0.3 { was = false; continue; }
    sx := s[0].width * 0.5 + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / ahead;
    sy := cy - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / ahead;
    if was { v = cc.line(out, v, px, py, sx, sy, k * 1.4, cr * pulse, cg * pulse, cb * pulse); }
    px = sx; py = sy; was = true;
  }
  return v;
}
// Slot i cast at (px, pz) on the ground: asked (aethyr/action/deed.coax), then sent; it plays once the
// room takes it (e2k_taken). False when the ask is refused or nothing could be sent.
e2k_cast :: (s: [] E2, i: int, face: f32, px: f32, pz: f32) -> bool {
  k := s[0].casts[..];
  now := s[0].clock; tick := deed_tick(now);
  seq := deed_ask(k[0].deeds[..], i, tick, e2k_bearing(s), xf_feel(k[0].klass, k[0].bar[i]));
  if seq == 0 { return false; }
  // another slot while the bow is drawn lets the draw down first: the press is this one, and the
  // loose it would have been never comes (the draw's loose is this same Attack: e2m_loose)
  mo := s[0].mouse[..];
  if mo[0].draw[0].on && i != e2m_attack(k) { bow.bow_cancel(mo[0].draw[..]); mo[0].cancels += 1; }
  k[0].aimed_x = px; k[0].aimed_z = pz;
  ay := s[0].you_y + 1.0;
  k[0].ask = E2kAsk.{seq = seq, slot = i, wire = k[0].wire[i], face = face};
  k[0].cool_at = now; k[0].used = i; k[0].pressed += 1;
  if !e2n_cast(s[0].net[..], k[0].wire[i], px, ay, pz) { _ := deed_answer(k[0].deeds[..], seq, false, tick, 0); k[0].cool_at = -100; return false; }
  return true;
}
// The room took your cast (its e cast for your seat): it plays now, from where you stand, at the
// room's aim and seed. A word for an ask that has timed out plays nothing.
e2k_taken :: (s: [] E2, e: E2nCast) {
  k := s[0].casts[..];
  if deed_answer(k[0].deeds[..], k[0].ask.seq, true, deed_tick(s[0].clock), 0) < 0 { return; }
  c := xk_slot_class(e.slot);
  if c < 0 { c = k[0].klass; }
  _ := e2k_play(s, c, e.slot, s[0].you_x, s[0].you_y, s[0].you_z, k[0].ask.face, e.ax, e.ay, e.az, e.seed, k[0].me[..], true);
}

// The frame's casts: the others' the picture has reached, played where they are drawn; the sounds
// waiting; then the effects for the host, round the eye.
e2k_step :: (s: [] E2) {
  k := s[0].casts[..]; n := s[0].net[..];
  now := s[0].clock;
  if n[0].familiar_heal_cue {
    n[0].familiar_heal_cue=false;
    own:=n[0].seat;
    if own>=0 && own<E2N_FAMILIARS && n[0].familiar_rows[own].live {
      f:=n[0].familiar_rows[own];
      cue:=xc_sound(fb_spell(SP_CURE_WOUNDS,1,FB_ALLY),FB_CL_DRUID);
      e2k_cue(s,cue.start,f32(E2K_GAIN_START),f.x,f.z,cue.rate);
    }
  }
  // the room turned your last cast down before it spent anything (eg_e2_cast is all or nothing): its
  // slot greys, nothing played, and the cooldown is lifted, so the bar is yours again at once
  tick := deed_tick(now);
  if n[0].cast_refused != k[0].refused_seen {
    k[0].refused_seen = n[0].cast_refused; k[0].cool_at = -100;
    if deed_waiting(k[0].deeds[0], k[0].ask.seq) { _ := deed_answer(k[0].deeds[..], k[0].ask.seq, false, tick, 0); }
  }
  // the room took it: it plays now
  if n[0].cast_mine != k[0].mine_heard { k[0].mine_heard = n[0].cast_mine; e2k_taken(s, n[0].mine_cast); }
  deed_expire(k[0].deeds[..], tick);
  e2k_lock_step(s);
  while true {
    e := e2n_cast_due(n, n[0].rt);
    if !e.live { break; }
    r := e2n_remote_seat(n, e.ss);
    if !r.ok { k[0].unseen += 1; continue; }   // not drawn here (gone, or beyond what this page holds)
    c := xk_slot_class(e.slot);
    y := e2_height(r.x, r.z) + r.y;
    dx := e.ax - r.x; dz := e.az - r.z;
    face := ifx dx * dx + dz * dz > 0.09 then figs.atan2(dx, dz) else r.yaw;
    if e2k_play(s, c, e.slot, r.x, y, r.z, face, e.ax, e.ay, e.az, e.seed, k[0].them[r.slot..<r.slot + 1], false) > 0 { k[0].others += 1; }
  }
  for i: 0..<E2K_LATER {
    l := k[0].later[i];
    if l.on && now >= l.t { k[0].later[i].on = false; e2k_cue(s, l.name, f32(E2K_GAIN_MISS), l.x, l.z, l.rate); }
  }
  pf := k[0].puffs[..];
  fxp_begin(pf, now, fxp_v(s[0].eye[0], s[0].eye[1], s[0].eye[2]));
  // every live effect's puffs (fxp_emit_all), a refused one's dimmed and drawn in as it fades
  for q: 0..<FX_LIVE {
    if !pf[0].on[q] { continue; }
    o := pf[0].live[q];
    if now < o.t0 { continue; }
    from := pf[0].n;
    fxp_emit(pf, o, now - o.t0);
    f := e2k_shown(k, q, o.t0, now);
    if f >= 1 { continue; }
    for j: from..<pf[0].n {
      a := j * FX_PUFF_FLOATS;
      pf[0].stage[a + 3] *= 0.6 + 0.4 * f;
      for c: 4..<8 { pf[0].stage[a + c] *= f; }
    }
    if f <= 0 { pf[0].on[q] = false; }
  }
  _ := fxp_close(pf);
}

// A body's cast or blow over its gait (fivelab-bodies.coax bd_layer): standing it takes the whole
// body; on the move only the upper body, the walk or run keeping the hips and legs. It eases in and
// out over BD_LAYER_FADE, so nothing pops. A remote's gait comes from its own motion and its act from
// the wire, so others see the same layered pose.
e2k_figure :: (a0: figs.BdAnim, act: E2kAct, clock: f32) -> figs.BdAnim {
  if act.clip < 0 || a0.clip < 0 { return a0; }
  d := figs.bd_seconds(act.clip); t := clock - act.at;
  if t < 0 || t >= d { return a0; }
  return figs.bd_layer(a0, act.clip, act.at, t / d, figs.bd_layer_weight(t, d), clock);
}
#test "a cast on the run keeps the run's legs; standing it takes the whole body" {
  run: figs.BdAnim; run.clip = figs.BD_RUN; run.x = 3; run.yaw = 1.2;
  act := E2kAct.{at = 10, clip = figs.BD_SPELL};
  a := e2k_figure(run, act, 10.5);
  #assert a.clip == figs.BD_SPELL && a.prev == figs.BD_RUN && a.lay && a.lay_up == 0 && a.lay_low == 1 && a.x == 3 && a.yaw == 1.2;
  idle: figs.BdAnim; idle.clip = figs.BD_IDLE;
  b := e2k_figure(idle, act, 10.5); #assert b.lay_up == 0 && b.lay_low == 0;
  // it eases in and out over BD_LAYER_FADE
  c := e2k_figure(run, act, 10.05); #assert c.lay_up > 0 && c.lay_up < 1;
  #assert !e2k_figure(run, act, 9.9).lay && !e2k_figure(run, act, 10 + figs.bd_seconds(figs.BD_SPELL)).lay;
  m := E2kAct.{at = 10, clip = figs.BD_SLASH};
  #assert e2k_figure(run, m, 10.4).lay_low == 1 && e2k_figure(run, m, 10.4).prev == figs.BD_RUN;
}

// ---- the bar: each slot's picture, its key, its cooldown; a card over the slot the pointer is on
e2k_box :: (k: [] E2Cast, i: int, w: f32, h: f32, kk: f32) -> [4] f32 { return xc_slot_at(k[0].bar_n, i, w, h, kk); }
e2k_put :: (m: [] u8, at: int, t: string) -> int { n := at; for ch: t { if n < m.count { m[n] = ch; n += 1; } } return n; }
e2k_int :: (m: [] u8, at: int, v: int) -> int {
  n := at; x := v; if x < 0 { n = e2k_put(m, n, "-"); x = -x; }
  d: [12] u8; c := 0; while true { d[c] = cast(u8)('0' + x % 10); c += 1; x /= 10; if x == 0 { break; } }
  while c > 0 { c -= 1; if n < m.count { m[n] = d[c]; n += 1; } }
  return n;
}
// One media line, when it fits whole: WHAT URL X0 Y0 X1 Y1, then TAIL (an "over"'s fade and share).
e2k_media :: (s: [] E2, what: string, url: string, art: string, size: string, b: [4] f32, tail: string) {
  m := s[0].media[..]; n := s[0].media_n;
  if n + what.count + url.count + art.count + size.count + tail.count + 64 > m.count { return; }
  if n > 0 { m[n] = 10; n += 1; }
  n = e2k_put(m, n, what); n = e2k_put(m, n, " "); n = e2k_put(m, n, url); n = e2k_put(m, n, art); n = e2k_put(m, n, size);
  for q: 0..<4 { n = e2k_put(m, n, " "); n = e2k_int(m, n, cast(int) floor(b[q] + 0.5)); }
  n = e2k_put(m, n, tail);
  s[0].media_n = n;
}
e2k_line :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, wide: f32, r: f32, g: f32, b: f32) -> int {
  if cc.lit(out, n, ax, ay, bx, by, wide, 1, 0, r, g, b, 0) { return n + 6; }
  return n;
}
e2k_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  n := at;
  if !e2k_on(s) { return n; }
  k := s[0].casts[..]; w := s[0].width; h := s[0].height; kk := s[0].k;
  now := s[0].clock;
  size := ifx kk > 1.4 then "-128.jpg" else "-72.jpg";
  left := f32(XC_COOL) - (now - k[0].cool_at);
  tick := deed_tick(now); bar_dim := deed_bar_dim(e2k_bearing(s));
  // the bar's iron (everglade/hud/parts.coax eg_bar_frame), round the slots' pictures, the class's emblem over it
  boxes: [XC_SLOTS * 4] f32;
  for i: 0..<k[0].bar_n { b := e2k_box(k, i, w, h, kk); for q: 0..<4 { boxes[i * 4 + q] = b[q]; } }
  n = cc.eg_bar_frame(out, n, boxes[..], k[0].bar_n, kk, E2C_CLASS_TITLES[e2c_class_of(s)][0], 1);
  for i: 0..<k[0].bar_n {
    b := e2k_box(k, i, w, h, kk);
    a := k[0].bar[i]; art := xc_art(a, i);
    e2k_media(s, "image", xc_url(art), art, size, b, "");
    // refused, or held by your conditions: the slot greys (#13072), no words
    grey := deed_look(k[0].deeds[0], i, tick, 0).grey; if bar_dim > grey { grey = bar_dim; }
    if grey > 0 {
      tail: [24] u8; tn := e2k_put(tail[..], 0, " "); tn = e2k_int(tail[..], tn, cast(int)(100 - 65 * grey)); tn = e2k_put(tail[..], tn, " 0 1000");
      e2k_media(s, "over", xc_url(art), art, size, b, cast(string) tail[0..<tn]);
    }
    if left > 0 {
      share := left / f32(XC_COOL);
      dim := [4] f32.[b[0], b[1], b[2], b[1] + (b[3] - b[1]) * share];
      tail: [24] u8; tn := e2k_put(tail[..], 0, " 35 0 "); tn = e2k_int(tail[..], tn, cast(int)(share * 1000));
      e2k_media(s, "over", xc_url(art), art, size, dim, cast(string) tail[0..<tn]);
    }
    if i < 9 && xc_draw_slot_key(i, art) {
      key: [1] u8; key[0] = cast(u8)(49 + i);
      n = cc.text(out, n, cast(string) key[..], b[0] + 4 * kk, b[1] + 13 * kk, 9 * kk, cc.ink(kk, 0.98, 0.95, 0.85));
    }
    if i == k[0].used && left > 0 { n = e2k_line(out, n, b[0], b[3] + 4 * kk, b[2], b[3] + 4 * kk, 1.5 * kk, 1, 0.8, 0.4); }
    // the room's count for it (slots at its level, uses, Rages, Focus) in its corner, and a gold
    // frame while its effect holds (a Rage, Wild Shape's form): the room's word only (#13046)
    kit := e2n_kit(s[0].net[..], i, k[0].bar_n);
    if kit.ok && kit.left >= 0 {
      d: [4] u8; dn := e2k_int(d[..], 0, kit.left); cap := 9 * kk;
      n = cc.text(out, n, cast(string) d[0..<dn], b[2] - f32(dn) * cap * 0.78 - 5 * kk, b[3] - 5 * kk, cap,
                  ifx kit.left == 0 then cc.ink(kk, 1, 0.55, 0.4) else cc.ink(kk, 1, 0.82, 0.35));
    }
    if kit.ok && kit.on {
      n = e2k_line(out, n, b[0], b[1], b[2], b[1], 1.5 * kk, 1, 0.75, 0.3); n = e2k_line(out, n, b[0], b[3], b[2], b[3], 1.5 * kk, 1, 0.75, 0.3);
      n = e2k_line(out, n, b[0], b[1], b[0], b[3], 1.5 * kk, 1, 0.75, 0.3); n = e2k_line(out, n, b[2], b[1], b[2], b[3], 1.5 * kk, 1, 0.75, 0.3);
    }
  }
  if k[0].hover >= 0 && k[0].hover < k[0].bar_n {
    a := k[0].bar[k[0].hover]; b := e2k_box(k, k[0].hover, w, h, kk);
    cw := 358 * kk; ch := 171 * kk; cx := (b[0] + b[2]) / 2;
    if cx - cw / 2 < 12 * kk { cx = 12 * kk + cw / 2; }
    if cx + cw / 2 > w - 12 * kk { cx = w - 12 * kk - cw / 2; }
    e2k_media(s, "over", xc_url(a.art), a.art, "-card-2x.jpg", [4] f32.[cx - cw / 2, b[1] - 30 * kk - ch, cx + cw / 2, b[1] - 30 * kk], "");
  }
  // your health and what holds you are on the portrait plate (everglade2.coax e2_world_hud)
  b0 := e2k_box(k, 0, w, h, kk);
  // Healer's Kit, the companion and rest: a framed side bar over the bar, each with its menu
  n = e2k_side_hud(s, out, n);
  refused:=e2n_rest_message(s[0].net[..]);   // a refused cast greys its slot instead (#13072)
  if refused.count == 0 { refused = e2n_aid_message(s[0].net[..]); }
  if refused.count == 0 { refused = e2n_familiar_message(s[0].net[..]); }
  // over the bar's emblem (the class's initial: its name is on the portrait plate)
  if refused.count>0 { n=cc.eg_say(out,n,refused,w*0.5,e2k_side_top(s)-12*kk,8*kk,cc.HUD_TEXT_WARN,1,kk,true); }
  return n;
}

// ---- input: 1 to 9 press the bar's slots; the pointer presses a slot or shows its card
e2k_key :: (s: [] E2, key: int) -> bool {
  if !e2k_on(s) || key < '1' || key > '9' { return false; }
  i := key - '1';
  if i >= s[0].casts[0].bar_n { return false; }
  _ := e2k_press(s, i);
  return true;
}
e2k_slot_at :: (s: [] E2, x: f32, y: f32) -> int {
  k := s[0].casts[..];
  for i: 0..<k[0].bar_n { b := e2k_box(k, i, s[0].width, s[0].height, s[0].k); if x >= b[0] && x <= b[2] && y >= b[1] && y <= b[3] { return i; } }
  return -1;
}
e2k_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  if !e2k_on(s) { return false; }
  if e2k_side_pointer(s, x, y, phase) { return true; }
  i := e2k_slot_at(s, x, y);
  s[0].casts[0].hover = i;
  if i < 0 || phase != 0 { return false; }   // a move over it shows its card and leaves the look's drag be
  _ := e2k_press(s, i);
  return true;
}

// The latest server health, independent of movement-input acknowledgements.
e2k_health_text :: (s:[] E2,out:[] u8)->int {
  row:=e2n_vitals(s[0].net[..]); if row.id<0 { return 0; }
  n:=e2k_put(out,0,"HP "); n=e2k_int(out,n,row.hp); n=e2k_put(out,n,"/"); n=e2k_int(out,n,row.max);
  if row.temp>0 { n=e2k_put(out,n," · TEMP "); n=e2k_int(out,n,row.temp); }
  if row.hp==0 { n=e2k_put(out,n,ifx (row.g&WG_DEAD)!=0 then " · DEAD" else " · UNCONSCIOUS"); }
  net:=s[0].net[..];
  if row.hp>0 && net[0].rest_known {
    code:=net[0].rest_code;
    if code==WIRE_REST_SHORT { n=e2k_put(out,n," · SHORT REST"); }
    if code==WIRE_REST_CHOOSE { n=e2k_put(out,n," · HIT DICE "); n=e2k_int(out,n,net[0].rest_dice); }
    if code==WIRE_REST_SLEEP { n=e2k_put(out,n," · ASLEEP"); }
    if code==WIRE_REST_WATCH { n=e2k_put(out,n," · ON WATCH"); }
    if code==WIRE_REST_EXERT { n=e2k_put(out,n," · ON THE MOVE"); }
    if code==WIRE_REST_BROKEN { n=e2k_put(out,n," · REST BROKEN"); }
  }
  // the conditions and spell effects the room's rules hold on you (its row's cond bits): Unconscious
  // is said above, at 0 HP or asleep
  asleep:=row.hp>0 && net[0].rest_known && net[0].rest_code==WIRE_REST_SLEEP;
  for i:0..<RS_CONDITIONS {
    if (row.cond&(1<<i))==0 || ((1<<i)==RS_UNCONSCIOUS && (row.hp==0 || asleep)) { continue; }
    n=e2k_put(out,n," · "); n=e2k_put(out,n,E2K_CONDITION[i]);
  }
  for i:0..<E2K_EFFECTS { if (row.cond&E2K_EFFECT_BIT[i])!=0 { n=e2k_put(out,n," · "); n=e2k_put(out,n,E2K_EFFECT[i]); } }
  return n;
}
E2K_HEALTH :: 320;   // bytes: every condition and effect at once fits
// RS_CONDITION's names in its bit order (aethyr/rules/srd/engine.coax), as the bar says them
E2K_CONDITION :: [15] string.["BLINDED", "CHARMED", "DEAFENED", "EXHAUSTED", "FRIGHTENED", "GRAPPLED", "INCAPACITATED", "INVISIBLE",
                              "PARALYZED", "PETRIFIED", "POISONED", "PRONE", "RESTRAINED", "STUNNED", "UNCONSCIOUS"];
// the spell effects a row carries past the conditions (everglade-wire.coax WC_*)
E2K_EFFECTS :: 8;
E2K_EFFECT_BIT :: [8] int.[WC_HALTED, WC_SLOWED, WC_BOUND, WC_BANED, WC_ENFEEBLED, WC_HEXED, WC_BLESSED, WC_FAITH];
E2K_EFFECT :: [8] string.["HALTED", "SLOWED", "EARTHBOUND", "BANED", "ENFEEBLED", "HEXED", "BLESSED", "SHIELD OF FAITH"];
#test "Everglade II's health line names a condition bit in the rules' order, once each" { #assert E2K_CONDITION.count == RS_CONDITIONS && (1 << 11) == RS_PRONE && (1 << 14) == RS_UNCONSCIOUS && (1 << 3) == RS_EXHAUSTION; }

// ---- rest (#13046): the choices the room's rest allows now, in the side bar's REST menu; the room decides each
// The rest requests (RS_REST_*) shown now, into out: none until the room has said your rest.
e2k_rest_choices :: (s: [] E2, out: [] int) -> int {
  n := s[0].net[..];
  if !e2k_on(s) || !e2n_open(n) || !n[0].rest_known || out.count < 4 { return 0; }
  row := e2n_vitals(n); if row.id < 0 || row.hp <= 0 { return 0; }
  c := n[0].rest_code;
  if c == WIRE_REST_NONE { out[0] = RS_REST_SHORT; out[1] = RS_REST_SLEEP; return 2; }
  if c == WIRE_REST_SHORT { out[0] = RS_REST_END; return 1; }
  if c == WIRE_REST_CHOOSE { if n[0].rest_dice > 0 { out[0] = RS_REST_DIE; out[1] = RS_REST_END; return 2; } out[0] = RS_REST_END; return 1; }
  if c == WIRE_REST_SLEEP { out[0] = RS_REST_WATCH; out[1] = RS_REST_END; return 2; }
  if c == WIRE_REST_WATCH || c == WIRE_REST_EXERT { out[0] = RS_REST_SLEEP; out[1] = RS_REST_END; return 2; }
  if c == WIRE_REST_BROKEN { out[0] = RS_REST_SLEEP; out[1] = RS_REST_WATCH; out[2] = RS_REST_END; return 3; }
  return 0;
}
e2k_rest_label :: (s: [] E2, req: int) -> string { return eg_rest_label(req, s[0].net[0].rest_known && s[0].net[0].rest_code != WIRE_REST_NONE); }


// Keep the kit separate from the changing rest buttons.
e2k_aid_on :: (s:[] E2)->bool {
  return e2n_open(s[0].net[..]) && e2n_vitals(s[0].net[..]).hp>0;
}

e2k_familiar_on :: (s:[]E2)->bool {
  return e2k_aid_on(s) && (s[0].net[0].klass==FB_CL_WIZARD || (s[0].net[0].klass==FB_CL_DRUID && s[0].net[0].level>=2));
}

e2k_familiar_heal_target :: (s:[]E2)->int {
  n:=s[0].net[..]; own:=n[0].seat;
  if own<0 || own>=E2N_FAMILIARS || !n[0].familiar_rows[own].live { return -1; }
  f:=n[0].familiar_rows[own];
  best:=-1; nearest:=12.0f32;
  for target:0..<E2N_FAMILIARS {
    row:=wire_mirror_of(n[0].mir[..],target);
    if row.id!=target || row.kind!=WK_PLAYER || (row.g&WG_DEAD)!=0 || row.hp<0 || row.hp>=row.max { continue; }
    x:=s[0].you_x; z:=s[0].you_z;
    if target!=own {
      remote:=e2n_remote_seat(n,target);
      if !remote.ok { continue; }
      x=remote.x; z=remote.z;
    }
    dx:=x-f.x; dz:=z-f.z; d:=dx*dx+dz*dz;
    if d<nearest { nearest=d; best=target; }
  }
  return best;
}

// ---- the side bar over the bar (zone wiring): Everglade's class features and rest (the game's
// everglade/hud/class-bar.coax) drawn with the engine's widgets (aethyr/ui/hud-menu.coax), from what
// this zone's room said; a press sends the room its request.
E2K_SIDE_CAP :: 9.0; E2K_TIP_CAP :: 8.5;     // the buttons' words (TITLE), a tip's line (LABEL), CSS px cap height
E2K_SIDE_PAD :: 14; E2K_SIDE_GAP :: 8; E2K_SIDE_UP :: 34; E2K_MENU_W :: 210; E2K_MENU_HEAD :: 26; E2K_MENU_TOP :: 120;
e2k_facts :: (s: [] E2) -> EgBarFacts {
  f: EgBarFacts; net := s[0].net[..];
  f.kit = e2k_aid_on(s); f.aid_left = net[0].aid_left;
  f.pet = e2k_familiar_on(s); f.wizard = net[0].klass == FB_CL_WIZARD; f.druid = net[0].klass == FB_CL_DRUID;
  f.form = rs_monster_block(RS_FAMILIAR_FORMS[net[0].familiar_form]).name; f.spirit = net[0].familiar_spirit - RS_FAMILIAR_FEY; f.paid_slot = net[0].familiar_slot != 0;
  f.rest_n = e2k_rest_choices(s, f.rest[..]); f.resting = net[0].rest_known && net[0].rest_code != WIRE_REST_NONE;
  return f;
}
e2k_rect :: (b: cc.HudPrim) -> [4] f32 { return [4] f32.[b.x0, b.y0, b.x1, b.y1]; }
// A finger's size on a phone, smaller with a mouse.
e2k_side_h :: (s: [] E2) -> f32 { kk := s[0].k; tall := s[0].width < 840 * kk || s[0].height < 560 * kk; return ifx tall then 44 * kk else 30 * kk; }
e2k_side :: (s: [] E2, ids: [] int) -> int { return eg_side_items(e2k_facts(s), ids); }
e2k_side_find :: (s: [] E2, id: int) -> int { ids: [3] int; n := e2k_side(s, ids[..]); for j: 0..<n { if ids[j] == id { return j; } } return -1; }
e2k_side_label :: (s: [] E2, id: int, b: [] u8) -> int { return eg_side_label(e2k_facts(s), id, b); }
e2k_menu_label :: (s: [] E2, a: int, b: [] u8) -> int { return eg_menu_label(e2k_facts(s), a, b); }
e2k_menu_rows :: (s: [] E2, id: int, rows: [] int) -> int { return eg_menu_rows(e2k_facts(s), id, rows); }
// The buttons' widths, and the row geometry they lay out in.
E2kSide :: struct { ids: [3] int; n: int; wd: [3] f32; x0: f32; x1: f32; y1: f32; h: f32; gap: f32; }
e2k_side_geo :: (s: [] E2) -> E2kSide {
  g: E2kSide; f := e2k_facts(s); kk := s[0].k; g.n = eg_side_items(f, g.ids[..]); b: [48] u8;
  for i: 0..<g.n { c := eg_side_label(f, g.ids[i], b[..]); g.wd[i] = cc.face_width(cast(string) b[0..<c], E2K_SIDE_CAP * kk, cc.HUD_FACE_TITLE) + 2 * E2K_SIDE_PAD * kk; }
  b0 := e2k_box(s[0].casts[..], 0, s[0].width, s[0].height, kk);
  g.x0 = 12 * kk; g.x1 = s[0].width - 12 * kk; g.y1 = b0[1] - E2K_SIDE_UP * kk; g.h = e2k_side_h(s); g.gap = E2K_SIDE_GAP * kk;
  return g;
}
e2k_side_box :: (s: [] E2, j: int) -> [4] f32 { g := e2k_side_geo(s); return e2k_rect(cc.hud_side_box(g.wd[..], g.n, j, g.x0, g.x1, g.y1, g.h, g.gap)); }
// The side bar's top (over the bar when it shows nothing): what sits over it starts here.
e2k_side_top :: (s: [] E2) -> f32 { g := e2k_side_geo(s); return cc.hud_side_top(g.wd[..], g.n, g.x0, g.x1, g.y1, g.h, g.gap); }
e2k_menu_of :: (s: [] E2, id: int) -> cc.HudMenu {
  f := e2k_facts(s); kk := s[0].k; rows: [EG_MENU_ROWS] int; m := eg_menu_rows(f, id, rows[..]); j := e2k_side_find(s, id);
  if j < 0 || m == 0 { return cc.HudMenu.{}; }
  cw := E2K_MENU_W * kk; b: [48] u8;
  for r: 0..<m { c := eg_menu_label(f, rows[r], b[..]); x := cc.face_width(cast(string) b[0..<c], E2K_SIDE_CAP * kk, cc.HUD_FACE_TITLE) + 2 * E2K_SIDE_PAD * kk; if x > cw { cw = x; } }
  g := e2k_side_geo(s); anchor := cc.hud_side_box(g.wd[..], g.n, j, g.x0, g.x1, g.y1, g.h, g.gap);
  return cc.hud_menu(anchor, m, cw, g.h, E2K_MENU_HEAD * kk, g.gap, E2K_MENU_TOP * kk, e2k_side_top(s) - 12 * kk, 8 * kk, s[0].width - 8 * kk);
}
e2k_menu_panel :: (s: [] E2, id: int) -> [4] f32 { return e2k_rect(e2k_menu_of(s, id).panel); }
e2k_menu_box :: (s: [] E2, id: int, r: int) -> [4] f32 { rows: [EG_MENU_ROWS] int; if r < 0 || r >= e2k_menu_rows(s, id, rows[..]) { return [4] f32.[0, 0, 0, 0]; } return e2k_rect(cc.hud_menu_row(e2k_menu_of(s, id), r)); }
// The centres a check presses: button id's, and action a's row in id's menu ([-1, -1] when not shown).
e2k_side_centre :: (s: [] E2, id: int) -> [2] f32 { j := e2k_side_find(s, id); if j < 0 { return [2] f32.[-1, -1]; } b := e2k_side_box(s, j); return [2] f32.[(b[0] + b[2]) * 0.5, (b[1] + b[3]) * 0.5]; }
e2k_menu_centre :: (s: [] E2, id: int, a: int) -> [2] f32 {
  rows: [EG_MENU_ROWS] int; m := e2k_menu_rows(s, id, rows[..]);
  for r: 0..<m { if rows[r] == a { b := e2k_menu_box(s, id, r); return [2] f32.[(b[0] + b[2]) * 0.5, (b[1] + b[3]) * 0.5]; } }
  return [2] f32.[-1, -1];
}
e2k_in :: (b: [4] f32, x: f32, y: f32) -> bool { return b[2] > b[0] && x >= b[0] && x <= b[2] && y >= b[1] && y <= b[3]; }
// A row pressed: asks the room, or changes what the next summons asks for.
e2k_menu_do :: (s: [] E2, a: int) {
  net := s[0].net[..]; k := s[0].casts[..];
  if a == EG_DO_FORM { net[0].familiar_form = (net[0].familiar_form + 1) % RS_FAMILIAR_FORMS.count; return; }
  if a == EG_DO_SPIRIT { net[0].familiar_spirit = RS_FAMILIAR_FEY + (net[0].familiar_spirit - RS_FAMILIAR_FEY + 1) % 3; return; }
  if a == EG_DO_PAY { net[0].familiar_slot = 1 - net[0].familiar_slot; return; }
  k[0].menu = -1;
  if a == EG_DO_SUMMON { _ := e2n_familiar(net); return; }
  if a == EG_DO_CURE { _ := e2n_familiar_heal(net, e2k_familiar_heal_target(s)); return; }
  if a > EG_DO_ORDER && a <= EG_DO_ORDER + 6 { _ := e2n_familiar_order(net, a - EG_DO_ORDER); return; }
  reqs: [4] int; c := e2k_rest_choices(s, reqs[..]); j := a - EG_DO_REST;
  if j >= 0 && j < c { _ := e2n_rest(net, reqs[j]); }
}
e2k_side_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  k := s[0].casts[..]; k[0].side_hover = -1; k[0].menu_hover = -1;
  if k[0].menu >= 0 && e2k_side_find(s, k[0].menu) < 0 { k[0].menu = -1; }   // its button went away
  if k[0].menu >= 0 {
    id := k[0].menu; rows: [EG_MENU_ROWS] int; m := e2k_menu_rows(s, id, rows[..]);
    for r: 0..<m { if e2k_in(e2k_menu_box(s, id, r), x, y) { k[0].menu_hover = r; if phase == 0 { e2k_menu_do(s, rows[r]); return true; } return false; } }
    if e2k_in(e2k_menu_panel(s, id), x, y) { return phase == 0; }
  }
  ids: [3] int; n := e2k_side(s, ids[..]);
  for j: 0..<n {
    if !e2k_in(e2k_side_box(s, j), x, y) { continue; }
    k[0].side_hover = j;
    if phase != 0 { return false; }
    if ids[j] == EG_SIDE_KIT { k[0].menu = -1; _ := e2n_aid(s[0].net[..]); }
    else { k[0].menu = ifx k[0].menu == ids[j] then -1 else ids[j]; }
    return true;
  }
  if phase == 0 && k[0].menu >= 0 { k[0].menu = -1; return true; }   // a press elsewhere closes the menu
  return false;
}
e2k_side_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  k := s[0].casts[..]; if k[0].menu >= 0 && e2k_side_find(s, k[0].menu) < 0 { k[0].menu = -1; }
  g := e2k_side_geo(s); if g.n == 0 { return at; }
  f := e2k_facts(s); kk := s[0].k; t := cc.eg_tokens(); cap := E2K_SIDE_CAP * kk;
  l: [1] cc.HudList; ws: [1] cc.HudWords;
  bufs: [3 * 48] u8; labels: [3] string; lit: [3] bool;
  for i: 0..<g.n { c := eg_side_label(f, g.ids[i], bufs[i * 48..<i * 48 + 48]); labels[i] = cast(string) bufs[i * 48..<i * 48 + c]; lit[i] = k[0].menu == g.ids[i] || k[0].side_hover == i; }
  cc.hud_side_draw(l[..], ws[..], t, g.wd[..], labels[..], lit[..], g.n, g.x0, g.x1, g.y1, g.h, g.gap, cap, kk);
  tip := ""; anchor := cc.HudPrim.{};
  if k[0].menu >= 0 {
    rows: [EG_MENU_ROWS] int; m := eg_menu_rows(f, k[0].menu, rows[..]); mb: [EG_MENU_ROWS * 32] u8; ml: [EG_MENU_ROWS] string;
    for r: 0..<m { c := eg_menu_label(f, rows[r], mb[r * 32..<r * 32 + 32]); ml[r] = cast(string) mb[r * 32..<r * 32 + c]; }
    menu := e2k_menu_of(s, k[0].menu);
    cc.hud_menu_draw(l[..], ws[..], t, menu, eg_menu_title(f, k[0].menu), ml[..], m, k[0].menu_hover, cap, kk);
    if k[0].menu_hover >= 0 && k[0].menu_hover < m { tip = eg_menu_tip(f, rows[k[0].menu_hover]); anchor = menu.panel; }
  } else if k[0].side_hover >= 0 && k[0].side_hover < g.n {
    tip = eg_side_tip(f, g.ids[k[0].side_hover]); anchor = cc.hud_side_box(g.wd[..], g.n, k[0].side_hover, g.x0, g.x1, g.y1, g.h, g.gap);
  }
  tc := E2K_TIP_CAP * kk;
  cc.hud_tip(l[..], ws[..], t, tip, cc.face_width(tip, tc * 0.9, cc.HUD_FACE_BODY), anchor, tc, 8 * kk, s[0].width - 8 * kk, kk);
  return cc.hud_draw(out, at, l[..], ws[..], 1, kk);
}
