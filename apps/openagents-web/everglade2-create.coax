// Character Create, in Everglade II's own world (#13023). /worlds/character-creator opens Everglade II
// at its glade, where the path begins, in this mode: a studio camera on your character, the wardrobe
// and the CLASS row down the left (on a phone, at the bottom), and your keys and pointer on the
// wardrobe. What you pick is your character in the world as you pick it (s[0].creator, the record
// aethyr/character-appearance.coax reads), drawn by Everglade II's renderer in its own light.
// USE IN EVERGLADE keeps the record (action 16, the browser's shared copy, message 17 says it was
// kept), puts /worlds/everglade2 in the address bar (action 19) and plays the run: the controls fade,
// the camera swings round behind you, you run out of the glade and down the path on your own while
// the camera keeps its own track, and it eases into the follow camera, where the keys are yours. Any
// key or a click skips to that hand-off. One page, one world, one renderer: nothing loads.
// Loaded into everglade2.coax, so it shares its E2, its glade, its path and figs.

E2C_FIELDS :: 13;        // the wardrobe's fields (charactercreator.coax change and value, 0 to 12)
E2C_BOXES :: 19;
E2C_CLASS :: 13;         // the CLASS row's field number
E2C_CLASS_BOX :: 18;     // and its box (0 to 12 the fields, 13 RESET, 14 SURPRISE ME, 15 a phone's drag mode, 16 SAVE, 17 USE)
E2C_SWING :: 3.0;        // s: the controls fade and the camera swings round behind you
E2C_RUN :: 20.0;         // s: the run out of the glade and down the path, on its own
E2C_EASE :: 1.5;         // s: the camera eases into the follow camera, then the keys are yours
E2C_FADE :: 0.8;         // s: the controls fade out
E2C_RECORD :: 57;        // the longest record (CC3)
E2C_SAVE :: 16;          // host.js: keep the outbox as the shared character record; message 17 says it was kept
E2C_KEPT :: 17;
E2C_ADDRESS :: 19;       // host.js: this same-origin path in the address bar (history.replaceState), nothing loaded
E2C_DRUID :: 3;          // the CLASS row starts at the druid, as Everglade's did
E2C_CLASSES :: 12;       // the SRD 5.2.1's, in fivebar.coax's order (aethyr/character-appearance.coax CA_CLASSES)
E2C_CLASS_NAMES :: [12] string.["BARBARIAN", "BARD", "CLERIC", "DRUID", "FIGHTER", "MONK", "PALADIN", "RANGER", "ROGUE", "SORCERER", "WARLOCK", "WIZARD"];
E2C_PANEL_BOTTOM :: 730.0;   // the glass panel's foot on a desktop (gpu/character-glade.coax cg_ui_cover)
// The arrival through Everglade's portal from the homepage (newland-portal.coax: its button,
// "Create your character", flies the homepage's camera into the portal and opens this page at
// ?via=portal). The page opens on the portal's light (gpu/everglade2.coax e2_arrival, the same light at
// the same scale and wall clock), holds it until the glade has drawn E2C_ARRIVE_FRAMES frames, then:
// the glade opens through it from the middle, the camera comes round and in to the studio's
// framing, your character pops up, and the wardrobe fades in. A key, click or scroll skips to the end.
E2C_ARRIVE_FRAMES :: 2;
E2C_ARRIVE_OPEN :: 0.05;     // s: the glade starts to open through the light
E2C_ARRIVE_OPENED :: 1.5;    // s: and has opened to the corners
E2C_ARRIVE_CAMERA :: 2.8;    // s: the camera has come round to the studio's framing
E2C_ARRIVE_POP :: 1.25;      // s: your character pops up
E2C_ARRIVE_POPPED :: 1.75;
E2C_ARRIVE_UI :: 2.2;        // s: the wardrobe fades in
E2C_ARRIVE_END :: 2.9;
E2C_ARRIVE_TURN :: 1.15;     // rad: the camera comes round this far
E2C_ARRIVE_WIDE :: 2.3;      // and in from this many times the studio's distance
E2C_ARRIVE_RISE :: 2.6;      // m, and down from this much higher
E2C_PORTAL_WALL :: 600000;   // ms: the shimmer's clock is the wall clock's, mod this (newland-portal.coax PORTAL_WALL)

E2Create :: struct {
  on: bool;        // this page opened at Character Create
  walking: bool;   // USE IN EVERGLADE taken: the run plays, the wardrobe gone
  run_t: f32;      // seconds since the record was kept
  handed: bool;    // the run is over: the follow camera and the keys are yours
  cut: [1] figs.CamCut;   // the run as an Aethyr cinematic (aethyr/cam/handback.coax): its hand-back retains the run's look
  address: bool;   // the address bar still to say /worlds/everglade2
  boxes: [E2C_BOXES] cc.Box; mobile: bool;
  down: int = -1; dragging: bool; drag_pan: bool; drag_id: int; dx: f32; dy: f32;
  pending: bool; request: bool; ok: bool; failed: bool; want_go: bool; saved_rev: int = -1; at_rev: int;
  bytes: [E2C_RECORD] u8; n: int;
  studio: figs.Shot;   // the studio camera's last shot, where the swing starts
  arriving: bool;      // opened through the portal (?via=portal), its arrival not yet over
  arrive_t: f32 = -1;  // s since the arrival started (below 0: the glade not yet drawn)
  drawn: int;          // the glade's frames drawn
  wall: f32; wall_clock: f32; clocked: bool;   // the wall clock's s (mod E2C_PORTAL_WALL) at the facts, and the page's clock then
  fig0: int; fig1: int;  // your character's records, for the pop
  hidden: bool;        // out of sight: the arrival waits (opened in place under the lander, or a hidden tab)
}

e2c_creating :: (s: [] E2) -> bool { return s[0].cz[0].on && !s[0].cz[0].walking; }
e2c_running :: (s: [] E2) -> bool { c := s[0].cz[0]; return c.on && c.walking && !c.handed; }
e2c_wrap :: (v: int, n: int) -> int { return (v % n + n) % n; }
e2c_clamp :: (v: f32, a: f32, b: f32) -> f32 { if v < a { return a; } if v > b { return b; } return v; }
e2c_ease :: (v: f32) -> f32 { t := e2c_clamp(v, 0, 1); return t * t * (3 - 2 * t); }
e2c_mix :: (a: f32, b: f32, t: f32) -> f32 { return a + (b - a) * t; }

// The page's facts: at Character Create you start in the glade, the wardrobe yours.
e2c_facts :: (s: [] E2, t: string) {
  if !cc.page(t) || s[0].cz[0].walking { return; }
  c := s[0].cz[..]; cr := s[0].creator[..];
  c[0].on = true; s[0].start_z = 0; s[0].autowalk = false;
  cc.ensure(cr);
  if cr[0].klass < 0 || cr[0].klass >= E2C_CLASSES { cr[0].klass = E2C_DRUID; }
  if cr[0].profile_ok { c[0].ok = true; c[0].saved_rev = cr[0].profile_revision; }
  if e2c_fact_has(t, "via=portal") && c[0].arrive_t < 0 { c[0].arriving = true; }
  ms := e2c_fact_int(t, "now=");
  if ms >= 0 { c[0].wall = f32(ms % E2C_PORTAL_WALL) / 1000; c[0].wall_clock = s[0].clock; c[0].clocked = true; }
}
// Out of sight and shown again (messages 601 and 602): the arrival waits while hidden, and the
// shimmer's clock takes the wall clock again when shown (handed over in place, the lander's light
// is at that same clock).
e2c_seen :: (s: [] E2, shown: bool, t: string) {
  c := s[0].cz[..];
  c[0].hidden = !shown;
  ms := e2c_fact_int(t, "now=");
  if shown && ms >= 0 { c[0].wall = f32(ms % E2C_PORTAL_WALL) / 1000; c[0].wall_clock = s[0].clock; c[0].clocked = true; }
}
// The url fact's query holds `key` (as ?key or &key), and the integer fact `key` (-1 if none).
e2c_fact_has :: (t: string, key: string) -> bool {
  for i: 1..<t.count - key.count + 1 { if (t[i - 1] == '?' || t[i - 1] == '&') && t[i..<i + key.count] == key { e := i + key.count; if e >= t.count || t[e] == '&' || t[e] == '#' || t[e] == '\n' { return true; } } }
  return false;
}
e2c_fact_int :: (t: string, key: string) -> int {
  at := 0;
  while at < t.count {
    if (at == 0 || t[at - 1] == '\n') && at + key.count <= t.count && t[at..<at + key.count] == key {
      v := 0; j := at + key.count; any := false;
      while j < t.count && t[j] >= '0' && t[j] <= '9' { v = v * 10 + cast(int)(t[j] - '0'); j += 1; any = true; }
      return ifx any then v else -1;
    }
    at += 1;
  }
  return -1;
}

// ---- the arrival through the portal (see E2C_ARRIVE_FRAMES)
e2c_smoother :: (v: f32) -> f32 { t := e2c_clamp(v, 0, 1); return t * t * t * (t * (t * 6 - 15) + 10); }
e2c_span :: (t: f32, a: f32, b: f32) -> f32 { return e2c_clamp((t - a) / (b - a), 0, 1); }
// The arrival's own clock, once the glade has drawn: -1 before, then its seconds.
e2c_arrive_at :: (s: [] E2) -> f32 { c := s[0].cz[0]; if !c.arriving { return E2C_ARRIVE_END; } return c.arrive_t; }
// Each frame: the glade's frames counted, the arrival's clock run; over at E2C_ARRIVE_END.
e2c_arrive_step :: (s: [] E2, dt: f32) {
  c := s[0].cz[..];
  if !c[0].arriving { return; }
  if c[0].hidden { return; }   // it plays where it is seen
  if c[0].arrive_t < 0 { if c[0].drawn >= E2C_ARRIVE_FRAMES { c[0].arrive_t = 0; } return; }
  c[0].arrive_t += dt;
  if c[0].arrive_t >= f32(E2C_ARRIVE_END) { c[0].arriving = false; c[0].arrive_t = f32(E2C_ARRIVE_END); }
}
e2c_arrive_skip :: (s: [] E2) { c := s[0].cz[..]; if c[0].arriving && c[0].arrive_t >= 0 { c[0].arriving = false; c[0].arrive_t = f32(E2C_ARRIVE_END); } }
// The wardrobe's share during the arrival.
e2c_arrive_ui :: (s: [] E2) -> f32 { t := e2c_arrive_at(s); if t < 0 { return 0; } return e2c_ease(e2c_span(t, f32(E2C_ARRIVE_UI), f32(E2C_ARRIVE_END))); }
// Your character's size during the arrival: nothing, then up with a little overshoot.
e2c_arrive_size :: (s: [] E2) -> f32 {
  t := e2c_arrive_at(s); if t < 0 { return 0; }
  u := e2c_span(t, f32(E2C_ARRIVE_POP), f32(E2C_ARRIVE_POPPED));
  if u <= 0 { return 0; } if u >= 1 { return 1; }
  a := 1.4f32; v := u - 1; return 1 + (a + 1) * v * v * v + a * v * v;   // ease out back
}
// The studio's shot during the arrival: turned round your feet, farther and higher, coming in.
e2c_arrive_shot :: (s: [] E2, feet: figs.Point, st: figs.Shot) -> figs.Shot {
  t := e2c_arrive_at(s); if t >= f32(E2C_ARRIVE_END) { return st; }
  e := 1 - e2c_smoother(e2c_span(ifx t < 0 then 0.0f32 else t, 0, f32(E2C_ARRIVE_CAMERA)));
  if e <= 0 { return st; }
  a := E2C_ARRIVE_TURN * e; ca := cos(a); sa := sin(a);
  far := 1 + (E2C_ARRIVE_WIDE - 1) * e; up := E2C_ARRIVE_RISE * e;
  vx := st.eye.x - feet.x; vz := st.eye.z - feet.z; ax := st.at.x - feet.x; az := st.at.z - feet.z;
  eye := figs.v3(feet.x + (vx * ca - vz * sa) * far, st.eye.y + up, feet.z + (vx * sa + vz * ca) * far);
  at := figs.v3(feet.x + ax * ca - az * sa, st.at.y + up * 0.15, feet.z + ax * sa + az * ca);
  floor_y := e2_height(eye.x, eye.z) + 0.3; if eye.y < floor_y { eye.y = floor_y; }
  return figs.Shot.{eye = eye, at = at};
}
// The veil's uniforms (gpu/everglade2.coax e2_arrival): u[96] the light's hold, u[97] its clock,
// u[98] its swell, u[99] your character's size short of whole, u[100] the opening, u[101] and u[102]
// your records.
e2c_arrive_uniforms :: (s: [] E2, u: [] f32) {
  c := s[0].cz[0];
  if !c.on || u.count < 104 { return; }
  t := e2c_arrive_at(s);
  if t >= f32(E2C_ARRIVE_END) { return; }
  // ease out: the glade shows through the light within a frame or two of the start, then opens wide
  ou := e2c_span(ifx t < 0 then 0.0f32 else t, f32(E2C_ARRIVE_OPEN), f32(E2C_ARRIVE_OPENED)); ov := 1 - ou;
  open := ifx t < 0 then 0.0f32 else 1 - ov * ov * ov;
  u[96] = 1 - e2c_ease(e2c_span(t, f32(E2C_ARRIVE_OPENED) - 0.5, f32(E2C_ARRIVE_OPENED) + 0.3));
  if t < 0 { u[96] = 1; }
  u[97] = ifx c.clocked then c.wall + (s[0].clock - c.wall_clock) else s[0].clock;
  u[98] = ifx t < 0 then 1.0f32 else 1 - e2c_ease(t / 2.4);
  u[99] = 1 - e2c_arrive_size(s);
  u[100] = open;
  u[101] = f32(c.fig0); u[102] = f32(c.fig1);
}
#test "create: through the portal the page holds the portal's light until the glade draws, then opens, comes in, pops and shows the wardrobe" #steps 400000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=http://x/worlds/character-creator?via=portal\nnow=1700000123456\n");
  c := s[0].cz[..];
  #assert c[0].on; #assert c[0].arriving; #assert c[0].clocked; #assert abs(c[0].wall - 323.456) < 0.01;
  u: [104] f32;
  e2c_arrive_step(s[..], 1.0f32 / 60); e2c_arrive_uniforms(s[..], u[..]);
  #assert c[0].arrive_t < 0 && u[96] == 1 && u[100] == 0 && u[99] == 1 && e2c_shown(s[..]) == 0;
  c[0].drawn = E2C_ARRIVE_FRAMES; e2c_arrive_step(s[..], 1.0f32 / 60); #assert c[0].arrive_t == 0;
  last_open := 0.0f32; last_ui := 0.0f32; t := 0.0f32; shown_at := -1.0f32; popped_at := -1.0f32;
  feet := figs.v3(0, 0, 0); st := figs.Shot.{eye = figs.v3(0, 1.5, 3), at = figs.v3(0, 1.4, -7)};
  prev := e2c_arrive_shot(s[..], feet, st);
  while c[0].arriving {
    e2c_arrive_step(s[..], 1.0f32 / 60); t += 1.0f32 / 60;
    for i: 0..<104 { u[i] = 0; } e2c_arrive_uniforms(s[..], u[..]);
    if c[0].arriving { #assert u[100] >= last_open - 0.00001; last_open = u[100]; }   // (f32 rounding near 1)
    #assert e2c_shown(s[..]) >= last_ui; last_ui = e2c_shown(s[..]);
    if popped_at < 0 && u[99] < 0.5 { popped_at = t; }
    if shown_at < 0 && last_ui > 0.5 { shown_at = t; }
    sh := e2c_arrive_shot(s[..], feet, st);
    dx := sh.eye.x - prev.eye.x; dy := sh.eye.y - prev.eye.y; dz := sh.eye.z - prev.eye.z;
    #assert dx * dx + dy * dy + dz * dz < 0.04;   // under 0.2 m a frame: no cut
    prev = sh;
  }
  #assert popped_at > 1 && shown_at > popped_at && t < 3.2;
  #assert e2c_shown(s[..]) == 1;
  e := e2c_arrive_shot(s[..], feet, st); #assert e.eye.x == st.eye.x && e.eye.z == st.eye.z;
  for i: 0..<104 { u[i] = 0; } e2c_arrive_uniforms(s[..], u[..]); #assert u[96] == 0 && u[99] == 0;
  // a plain visit has no arrival
  p: [1] E2; e2_message(p[..], E2_HOST_PAGE, "url=/worlds/character-creator\n"); #assert !p[0].cz[0].arriving && e2c_shown(p[..]) == 1;
}
#test "create: opened in place under the lander, the arrival waits until the page is shown" #steps 400000000 {
  // opened in place under the lander: drawn, but the arrival waits until the page is shown
  z: [1] E2; e2_message(z[..], E2_HOST_PAGE, "url=http://x/worlds/character-creator?via=portal\nnow=1700000123456\n");
  e2_message(z[..], E2_HOST_HIDDEN, ""); z[0].cz[0].drawn = 40;
  for i: 0..<120 { e2c_arrive_step(z[..], 1.0f32 / 60); }
  #assert z[0].cz[0].arrive_t < 0 && z[0].cz[0].arriving;
  e2_message(z[..], E2_HOST_SHOWN, "now=1700000200000\n");
  #assert abs(z[0].cz[0].wall - 400.0) < 0.01;
  e2c_arrive_step(z[..], 1.0f32 / 60); #assert z[0].cz[0].arrive_t == 0;
}

// ---- the wardrobe: Character Create's fields and values, and the CLASS row
e2c_change :: (s: [] E2, f: int, delta: int) {
  cr := s[0].creator[..];
  if f == E2C_CLASS { cr[0].klass = e2c_wrap((ifx cr[0].klass < 0 then 0 else cr[0].klass) + delta, E2C_CLASSES); cr[0].focused = E2C_CLASS; cr[0].revision += 1; return; }
  cc.change(cr, f, delta);
}
e2c_value :: (s: [] E2, f: int) -> string {
  if f == E2C_CLASS { k := s[0].creator[0].klass; return E2C_CLASS_NAMES[ifx k < 0 then 0 else ifx k >= E2C_CLASSES then E2C_CLASSES - 1 else k]; }
  return cc.value(s[0].creator[0], f);
}

// The shared character record: SAVE PLAYER keeps it; USE IN EVERGLADE keeps it, then runs.
e2c_request :: (s: [] E2, go: bool) {
  c := s[0].cz[..]; cr := s[0].creator[..];
  if c[0].pending { return; }
  cc.ensure(cr);
  n := cc.save(cr[0], c[0].bytes[..]);
  if n < 56 || n > E2C_RECORD { return; }
  c[0].n = n; c[0].at_rev = cr[0].revision; c[0].pending = true; c[0].request = true; c[0].want_go = go; c[0].failed = false;
}
e2c_reply :: (s: [] E2, t: string) {
  c := s[0].cz[..];
  if !c[0].pending { return; }
  c[0].pending = false; c[0].request = false;
  same := t.count == c[0].n;
  if same { for i: 0..<c[0].n { if t[i] != c[0].bytes[i] { same = false; } } }
  c[0].failed = !same; c[0].ok = same;
  if same { c[0].saved_rev = c[0].at_rev; }
  if same && c[0].want_go { e2c_walk(s); }
}
// Out of the studio: you turn from facing the camera to the path as the run starts.
e2c_walk :: (s: [] E2) {
  c := s[0].cz[..];
  if c[0].walking { return; }
  c[0].walking = true; c[0].run_t = 0; c[0].handed = false; c[0].cut[0] = figs.cam_cut_enter(c[0].studio, s[0].orbit, 0, 0, figs.CamOutcome.retain); c[0].cut[0].hand = E2C_EASE; c[0].address = true;
  c[0].dragging = false; c[0].down = -1;
  s[0].you_face = s[0].creator[0].yaw; s[0].reseat = true;   // the controller takes you as the studio drew you
  heading := e2_auto_heading(s[0].you_x, s[0].you_z);
  s[0].orbit = figs.verse_orbit_start(figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), heading);
}
// Any key or click while it plays: on to the ease into the follow camera.
e2c_skip :: (s: [] E2) { c := s[0].cz[..]; if e2c_running(s) && c[0].run_t < f32(E2C_SWING + E2C_RUN) { c[0].run_t = f32(E2C_SWING + E2C_RUN); } }
// This frame's action, when the slot is free: the record to keep, then the address.
e2c_action :: (s: [] E2) {
  c := s[0].cz[..];
  if !c[0].on || s[0].action != 0 { return; }
  if c[0].request {
    for i: 0..<c[0].n { s[0].outbox[i] = c[0].bytes[i]; }
    s[0].out_n = c[0].n; s[0].action = E2C_SAVE; c[0].request = false; return;
  }
  if c[0].address {
    path := "/worlds/everglade2";
    for i: 0..<path.count { s[0].outbox[i] = path[i]; }
    s[0].out_n = path.count; s[0].action = E2C_ADDRESS; c[0].address = false;
  }
}
#test "create: USE IN EVERGLADE keeps the record with its class, then runs and says Everglade II's address" #steps 2000000000 {
  s: [1] E2;
  e2_message(s[..], E2_HOST_PAGE, "url=http://127.0.0.1/worlds/character-creator\nnow=1000");
  #assert e2c_creating(s[..]) && s[0].creator[0].configured && s[0].creator[0].klass == E2C_DRUID && e2c_value(s[..], E2C_CLASS) == "DRUID";
  e2c_change(s[..], 0, 1); e2c_change(s[..], 12, 3); e2c_change(s[..], E2C_CLASS, -1);
  #assert s[0].creator[0].female && s[0].creator[0].eye_color == 3 && e2c_value(s[..], E2C_CLASS) == "CLERIC";
  // the studio holds you still: no keys reach the walk
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0;
  e2c_request(s[..], true); e2c_action(s[..]);
  #assert s[0].action == E2C_SAVE && s[0].out_n == E2C_RECORD && s[0].outbox[2] == '3';
  b: [E2C_RECORD] u8; for i: 0..<E2C_RECORD { b[i] = s[0].outbox[i]; }
  s[0].action = 0;
  e2_message(s[..], E2C_KEPT, cast(string) b[0..<E2C_RECORD]);
  #assert !e2c_creating(s[..]) && e2c_running(s[..]) && s[0].reseat;
  e2c_action(s[..]);
  #assert s[0].action == E2C_ADDRESS && cast(string) s[0].outbox[0..<s[0].out_n] == "/worlds/everglade2";
}
#test "create: the record kept is the one Everglade II restores on its own page, class and all" #steps 1000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  e2c_change(s[..], 0, 1); e2c_change(s[..], 12, 3); e2c_change(s[..], E2C_CLASS, -1);
  b: [E2C_RECORD] u8; n := cc.save(s[0].creator[0], b[..]); #assert n == E2C_RECORD;
  t: [1] E2; e2_message(t[..], 16, cast(string) b[0..<n]);
  #assert t[0].creator[0].female && t[0].creator[0].eye_color == 3 && t[0].creator[0].klass == 2;
}
#test "create: a refused keep stays in the studio, and Everglade II's own page is not the studio" #steps 1000000000 {
  u: [1] E2; e2_message(u[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  e2c_request(u[..], true); e2_message(u[..], E2C_KEPT, "");
  #assert e2c_creating(u[..]) && u[0].cz[0].failed;
  // Everglade II's own page is not the studio
  v: [1] E2; e2_message(v[..], E2_HOST_PAGE, "url=/worlds/everglade2\n");
  #assert !v[0].cz[0].on && !e2c_creating(v[..]);
}

// ---- the layout and the panel
// The title's cap: 22 on a desktop; on a phone 18, or less so it ends 8 px before DRAG: ROTATE.
e2c_title_cap :: (s: [] E2, k: f32) -> f32 {
  c := s[0].cz[0];
  if !c.mobile { return 22 * k; }
  fit := (c.boxes[15].x0 - 32 * k) / e2c_text_w("Character Create", 1);
  return ifx fit < 18 * k then fit else 18 * k;
}
// How wide cc.text sets t at cap (its advances: charactercreator.coax text).
e2c_text_w :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for ch: t { code := int(ch); a := ifx code >= 32 && code <= 126 then int(cc.CC_FONT_WIDTH[code - 32]) else int(cc.CC_FONT_WIDTH[31]); w += f32(a) / f32(cc.CC_FONT_UPM) * em; }
  return w;
}
e2c_layout :: (s: [] E2, w: f32, h: f32, k: f32) {
  c := s[0].cz[..];
  c[0].mobile = w < 840 * k || h < 760 * k;   // as the glass panel's (gpu/character-glade.coax cg_ui_cover)
  if c[0].mobile {
    bw := (w - 36 * k) / 2;
    for i: 0..<E2C_FIELDS + 1 {
      col := i % 2; row := i / 2; x := 12 * k + f32(col) * (bw + 12 * k); y := h - 484 * k + f32(row) * 60 * k;
      c[0].boxes[ifx i == E2C_FIELDS then E2C_CLASS_BOX else i] = cc.Box.{x0 = x, y0 = y, x1 = x + bw, y1 = y + 42 * k};
    }
    by := h - 56 * k;
    c[0].boxes[13] = cc.Box.{x0 = 28 * k, y0 = by, x1 = 172 * k, y1 = by + 36 * k};
    c[0].boxes[14] = cc.Box.{x0 = w - 174 * k, y0 = by, x1 = w - 24 * k, y1 = by + 36 * k};
    // DRAG: ROTATE at the right of the title's row, only as wide as its words (e2c_title_cap sets
    // the title to end before it: from the middle it covered "Character Create" at phone width)
    c[0].boxes[15] = cc.Box.{x0 = w - 32 * k - e2c_text_w("DRAG: ROTATE", 10 * k), y0 = 34 * k, x1 = w - 12 * k, y1 = 72 * k};
    c[0].boxes[16] = cc.Box.{x0 = 12 * k, y0 = 82 * k, x1 = w / 2 - 6 * k, y1 = 124 * k};
    c[0].boxes[17] = cc.Box.{x0 = w / 2 + 6 * k, y0 = 82 * k, x1 = w - 12 * k, y1 = 124 * k};
    return;
  }
  // a desktop: CLASS first in the sidebar, then the wardrobe's fields, then the buttons, all on the glass
  c[0].boxes[E2C_CLASS_BOX] = cc.Box.{x0 = 28 * k, y0 = 90 * k, x1 = 332 * k, y1 = 124 * k};
  for i: 0..<E2C_FIELDS { y := (128 + f32(i) * 38) * k; c[0].boxes[i] = cc.Box.{x0 = 28 * k, y0 = y, x1 = 332 * k, y1 = y + 34 * k}; }
  c[0].boxes[13] = cc.Box.{x0 = 28 * k, y0 = 628 * k, x1 = 172 * k, y1 = 662 * k};
  c[0].boxes[14] = cc.Box.{x0 = 188 * k, y0 = 628 * k, x1 = 332 * k, y1 = 662 * k};
  c[0].boxes[15] = cc.Box.{};
  c[0].boxes[16] = cc.Box.{x0 = 28 * k, y0 = 672 * k, x1 = 172 * k, y1 = 706 * k};
  c[0].boxes[17] = cc.Box.{x0 = 188 * k, y0 = 672 * k, x1 = 332 * k, y1 = 706 * k};
}
#test "create: the wardrobe fits a phone and a desktop, on the glass" {
  s: [1] E2;
  e2c_layout(s[..], 390, 844, 1);
  for i: 0..<E2C_BOXES { b := s[0].cz[0].boxes[i]; #assert b.x0 >= 0 && b.x1 <= 390 && b.y1 <= 844 && b.y1 - b.y0 >= 34;
    // each control sits on one of the phone's two glass bands (top 26 to 124, bottom from h - 504)
    #assert (b.y0 >= 26 && b.y1 <= 124) || b.y0 >= 844 - 504; }
  // DRAG: ROTATE holds its words and the title ("Character Create" from x 24) stays clear of it
  {d := s[0].cz[0].boxes[15]; #assert 24 + e2c_text_w("Character Create", e2c_title_cap(s[..], 1)) + 8 <= d.x0 && d.x0 + 10 + e2c_text_w("DRAG: ROTATE", 10) <= d.x1 && e2c_title_cap(s[..], 1) >= 14; }
  e2c_layout(s[..], 1440, 900, 1);
  for i: 0..<E2C_BOXES { if i == 15 { continue; } b := s[0].cz[0].boxes[i]; #assert b.x0 >= 16 && b.x1 <= 350 && b.y0 >= 82 && b.y1 <= f32(E2C_PANEL_BOTTOM); }
  #assert s[0].cz[0].boxes[E2C_CLASS_BOX].y1 + 4 <= s[0].cz[0].boxes[0].y0;
  for i: 1..<E2C_FIELDS { #assert s[0].cz[0].boxes[i].y0 >= s[0].cz[0].boxes[i - 1].y1 + 4; }
  #assert s[0].cz[0].boxes[12].y1 + 4 <= s[0].cz[0].boxes[13].y0 && s[0].cz[0].boxes[13].y1 + 4 <= s[0].cz[0].boxes[16].y0;
}
e2c_ink :: (k: f32, r: f32, g: f32, b: f32, f: f32) -> cc.Ink { i := cc.ink(k, r, g, b); i.sans = true; i.light = i.light * f; i.glow = i.glow * f; return i; }
// The controls' share shown: whole in the studio, fading over the run's first E2C_FADE s.
e2c_shown :: (s: [] E2) -> f32 {
  c := s[0].cz[0];
  if !c.on || c.handed { return 0; }
  if !c.walking { return e2c_arrive_ui(s); }
  return 1 - e2c_ease(c.run_t / f32(E2C_FADE));
}
e2c_hud :: (s: [] E2, out: [] f32) -> int {
  w := s[0].width; h := s[0].height; k := s[0].k;
  e2c_layout(s, w, h, k);
  f := e2c_shown(s);
  if f <= 0.003 { return 0; }
  c := s[0].cz[0]; cr := s[0].creator[0];
  white := e2c_ink(k, 0.91, 0.92, 0.9, f); dim := e2c_ink(k, 0.70, 0.76, 0.74, f); gold := e2c_ink(k, 0.83, 0.69, 0.43, f); label := e2c_ink(k, 0.93, 0.88, 0.72, f);
  n := cc.text(out, 0, "Character Create", (ifx c.mobile then 24.0f32 else 30.0f32) * k, (ifx c.mobile then 58.0f32 else 60.0f32) * k, e2c_title_cap(s, k), white);
  if !c.mobile { n = cc.line(out, n, 30 * k, 78 * k, 334 * k, 78 * k, k, gold.red * f, gold.green * f, gold.blue * f); }
  for row: 0..<E2C_FIELDS + 1 {
    i := ifx row == 0 then E2C_CLASS else row - 1;
    b := c.boxes[ifx row == 0 then E2C_CLASS_BOX else i]; cap := 10.0f32;
    name := ifx row == 0 then "CLASS" else cc.FIELD_NAMES[i];
    if c.mobile { n = cc.text(out, n, name, b.x0, b.y0 - 7 * k, 8 * k, dim); }
    else { n = cc.text(out, n, ifx i == 11 then "WEAR PART" else name, b.x0, b.y0 + 21 * k, 7.4 * k, label); }
    col := ifx cr.focused == i then gold else dim;
    n = cc.line(out, n, b.x0, b.y1, b.x1, b.y1, k, col.red * f, col.green * f, col.blue * f);
    n = cc.text(out, n, "<", b.x0 + (ifx c.mobile then 4.0f32 else 116.0f32) * k, b.y0 + cap * k + 9 * k, cap * k, col);
    value_cap := ifx i == 10 then (ifx c.mobile then 6.5f32 else 8.5f32) else cap;
    n = cc.text(out, n, e2c_value(s, i), b.x0 + (ifx c.mobile then 25.0f32 else 138.0f32) * k, b.y0 + cap * k + 9 * k, value_cap * k, white);
    n = cc.text(out, n, ">", b.x1 - 14 * k, b.y0 + cap * k + 9 * k, cap * k, col);
    if i == 4 || i == 5 || i == 7 || i == 12 {
      rgb := ifx i == 4 then cc.DYES[cr.dye] else ifx i == 5 then cc.SKINS[cr.skin] else ifx i == 12 then cc.EYES[cr.eye_color] else cc.HAIRS[cr.hair_color];
      if cc.lit(out, n, b.x0 + (ifx c.mobile then 26.0f32 else 138.0f32) * k, b.y1 - 5 * k, b.x1 - 26 * k, b.y1 - 5 * k, 2 * k, f, 0, rgb[0], rgb[1], rgb[2], 0) { n += 6; }
    }
  }
  for i: 13..<15 { b := c.boxes[i]; n = cc.text(out, n, ifx i == 13 then "RESET" else "SURPRISE ME", b.x0 + 10 * k, b.y0 + 22 * k, 10 * k, gold); }
  if c.mobile { b := c.boxes[15]; n = cc.text(out, n, ifx cr.pan_mode then "DRAG: PAN" else "DRAG: ROTATE", b.x0 + 10 * k, b.y0 + 24 * k, 10 * k, gold); }
  for i: 16..<18 {
    b := c.boxes[i];
    t := ifx i == 17 then "USE IN EVERGLADE" else ifx c.pending then "SAVING..." else ifx c.failed then "RETRY SAVE" else ifx c.ok && c.saved_rev == cr.revision then "PLAYER SAVED" else "SAVE PLAYER";
    n = cc.text(out, n, t, b.x0 + 8 * k, b.y0 + 22 * k, 9 * k, gold);
  }
  if !c.mobile { n = cc.text(out, n, "DRAG: ROTATE / P: PAN / SCROLL: ZOOM", w * 0.5 - 170 * k, h - 77 * k, 9 * k, label); }
  n = e2c_pane_draw(s, out, n, f);
  return n;
}
// The glass panel under the controls (gpu/everglade2.coax's post pass, Character Create's
// cg_panel_opacity): on while they show, fading with them.
e2c_uniforms :: (s: [] E2, u: [] f32) {
  f := e2c_shown(s);
  if f <= 0 { return; }
  u[11] = 0; u[40] = 1 - f;
  e2c_pane_uniforms(s, u);
}

// ---- input: in the studio the keys and the pointer are the wardrobe's
e2c_inside :: (b: cc.Box, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
e2c_pointer :: (s: [] E2, x: f32, y: f32, phase: int, id: int) -> bool {
  if s[0].cz[0].arriving { if phase == 0 { e2c_arrive_skip(s); } return true; }   // a click skips the arrival
  if e2c_running(s) { if phase == 0 { e2c_skip(s); } return true; }   // a click skips the run
  if !e2c_creating(s) { return false; }
  c := s[0].cz[..]; cr := s[0].creator[..]; k := s[0].k;
  if phase == 0 {
    for i: 0..<E2C_BOXES { if e2c_inside(c[0].boxes[i], x, y) { c[0].down = i; c[0].drag_id = id; return true; } }
    c[0].drag_pan = cr[0].pan_mode; c[0].dragging = true; c[0].drag_id = id; c[0].dx = x; c[0].dy = y;
    return true;
  }
  if id != c[0].drag_id { return true; }
  if phase == 1 && c[0].dragging {
    if c[0].drag_pan {
      units := cr[0].dist / (ifx s[0].focal > 1 then s[0].focal else 1.0f32);
      cr[0].pan_x = e2c_clamp(cr[0].pan_x - (x - c[0].dx) * units, -2, 2);
      cr[0].pan_y = e2c_clamp(cr[0].pan_y + (y - c[0].dy) * units, -2, 2);
    } else {
      cr[0].yaw += (x - c[0].dx) * 0.008 / k;
      cr[0].pitch = e2c_clamp(cr[0].pitch + (y - c[0].dy) * 0.003 / k, -0.2, 0.6);
    }
    c[0].dx = x; c[0].dy = y;
    return true;
  }
  if phase == 2 || phase == 3 {
    i := c[0].down; c[0].down = -1; c[0].dragging = false;
    if phase == 2 && i >= 0 && e2c_inside(c[0].boxes[i], x, y) {
      left := x < c[0].boxes[i].x0 + (ifx c[0].mobile then 22.0f32 else 136.0f32) * k;
      if i < E2C_FIELDS { e2c_change(s, i, ifx left then -1 else 1); }
      else if i == E2C_CLASS_BOX { e2c_change(s, E2C_CLASS, ifx left then -1 else 1); }
      else if i == 13 { cc.reset(cr); }
      else if i == 14 { cc.surprise(cr); }
      else if i == 15 { cr[0].pan_mode = !cr[0].pan_mode; }
      else { e2c_request(s, i == 17); }
    }
  }
  return true;
}
// While the studio or the run is on, every key is its own: the walk's keys wait for the hand-off.
e2c_key :: (s: [] E2, key: int) -> bool {
  if s[0].cz[0].arriving { e2c_arrive_skip(s); return true; }
  if e2c_running(s) { e2c_skip(s); return true; }   // any key skips the run, and is spent on it
  if !e2c_creating(s) { return false; }
  cr := s[0].creator[..];
  if key == 'p' || key == 'P' { cr[0].pan_mode = !cr[0].pan_mode; return true; }
  // Tab: the CLASS row, then the wardrobe's fields in turn
  if key == -15 { f := cr[0].focused; cr[0].focused = ifx f == E2C_CLASS then 0 else ifx f + 1 >= E2C_FIELDS then E2C_CLASS else f + 1; return true; }
  if key == KEY_LEFT || key == KEY_RIGHT { e2c_change(s, cr[0].focused, ifx key == KEY_LEFT then -1 else 1); return true; }
  if key == ' ' { e2c_change(s, 9, 1); return true; }
  return true;
}
e2c_wheel :: (s: [] E2, dy: f32) -> bool {
  if s[0].cz[0].arriving { e2c_arrive_skip(s); return true; }
  if e2c_running(s) { return true; }
  if !e2c_creating(s) { return false; }
  d := e2c_clamp(dy, -400, 400);
  s[0].creator[0].dist = e2c_clamp(s[0].creator[0].dist + d * 0.003, 0.65, 6);
  return true;
}
#test "create: the studio's pointer turns, zooms and changes the character, and the class row steps" #steps 1000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  s[0].width = 1440; s[0].height = 900; s[0].k = 1; e2c_layout(s[..], 1440, 900, 1);
  yaw := s[0].creator[0].yaw;
  #assert e2_pointer(s[..], 900, 400, 0, 0, 3) && e2_pointer(s[..], 980, 400, 1, 0, 3) && e2_pointer(s[..], 980, 400, 2, 0, 3);
  #assert s[0].creator[0].yaw > yaw && !s[0].dragging;
  b := s[0].cz[0].boxes[1]; outfit := s[0].creator[0].outfit;
  #assert e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 0, 0, 4) && e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 2, 0, 4);
  #assert s[0].creator[0].outfit == (outfit + 1) % 4;
  c := s[0].cz[0].boxes[E2C_CLASS_BOX];
  #assert e2_pointer(s[..], c.x1 - 10, c.y0 + 10, 0, 0, 5) && e2_pointer(s[..], c.x1 - 10, c.y0 + 10, 2, 0, 5) && s[0].creator[0].klass == E2C_DRUID + 1;
  for i: 0..<8 { _ := e2_wheel(s[..], -400); }
  #assert s[0].creator[0].dist == 0.65;
}

// ---- the camera, your pose
// The studio camera: Character Create's own (charactercreator.coax camera), from your feet: south of
// you, looking north, where you stand facing it.
e2c_studio :: (s: [] E2, feet: figs.Point) -> figs.Shot {
  c := s[0].creator[0];
  dist := c.dist; close := e2c_clamp((2.2 - dist) / 1.55, 0, 1); target := 1.2 + 0.58 * close;
  ey := target - 0.4 + 0.50 * close + sin(c.pitch - 0.1) * dist; ez := cos(c.pitch - 0.1) * dist;
  fy := target - ey; fz := -ez; fl := sqrt(fy * fy + fz * fz); fy /= fl; fz /= fl;
  eye := figs.v3(feet.x + c.pan_x, feet.y + ey + c.pan_y * (-fz), feet.z + ez + c.pan_y * fy);
  floor_y := e2_height(eye.x, eye.z) + 0.28; if eye.y < floor_y { eye.y = floor_y; }
  return figs.Shot.{eye = eye, at = figs.v3(eye.x, eye.y + fy * 10, eye.z + fz * 10)};
}
// The run's camera at share u of the run, relative to you and your heading: turned `turn` rad off
// straight behind you, `dist` m back, `rise` m up (Everglade's cz_frame): a three-quarter view that
// sweeps across behind you and back, pulling out and craning up midway, and comes in to straight behind.
E2cFrame :: struct { turn: f32; dist: f32; rise: f32; }
e2c_frame :: (u: f32) -> E2cFrame {
  a := (1 - u) * 0.6 * cos(3 * 3.14159265 * u); arc := sin(3.14159265 * u);
  return E2cFrame.{turn = a, dist = e2c_mix(4.2, f32(figs.FREE_DIST), u) + 2.5 * arc, rise = e2c_mix(1.7, f32(figs.FREE_HEIGHT) + 0.9, u) + 2.2 * arc};
}
e2c_frame_shot :: (feet: figs.Point, yaw: f32, f: E2cFrame, look: figs.Point) -> figs.Shot {
  h := yaw + f.turn;
  eye := figs.v3(feet.x - sin(h) * f.dist, feet.y + f.rise, feet.z - cos(h) * f.dist);
  floor_y := e2_height(eye.x, eye.z) + 0.5; if eye.y < floor_y { eye.y = floor_y; }
  return figs.Shot.{eye = eye, at = look};
}
// The track's look: 1.3 m up, 3.5 m on the way you run.
e2c_look :: (feet: figs.Point, yaw: f32) -> figs.Point { return figs.v3(feet.x + sin(yaw) * 3.5, feet.y + 1.3, feet.z + cos(yaw) * 3.5); }
// The camera shown: the studio's, then after USE IN EVERGLADE the run's (from the studio's it swings
// round behind you over E2C_SWING s, keeps its own track through the run, then eases into the follow
// camera `chase` over E2C_EASE s, the orbit turned first to look the way it looks, so the hand-off
// has no jump), then the follow camera alone.
e2c_shot :: (s: [] E2, feet: figs.Point, chase: figs.Shot, dt: f32) -> figs.Shot {
  c := s[0].cz[..];
  if !c[0].on || c[0].handed { return chase; }
  if !c[0].walking { c[0].studio = e2c_studio(s, feet); return e2c_arrive_shot(s, feet, c[0].studio); }
  if dt > 0 && dt < 1 { c[0].run_t += dt; }
  t := c[0].run_t; yaw := s[0].orbit.yaw;
  if t < f32(E2C_SWING) {
    // the studio's framing in the track's terms, eased into the track's start
    st := c[0].studio; vx := st.eye.x - feet.x; vz := st.eye.z - feet.z;
    from := E2cFrame.{turn = figs.wrap_angle(figs.atan2(-vx, -vz) - yaw), dist = sqrt(vx * vx + vz * vz), rise = st.eye.y - feet.y};
    if from.dist < 1 { from.dist = 1; }
    to := e2c_frame(0); e := e2c_ease(t / f32(E2C_SWING));
    look_to := e2c_look(feet, yaw);
    look := figs.v3(e2c_mix(st.at.x, look_to.x, e), e2c_mix(st.at.y, look_to.y, e), e2c_mix(st.at.z, look_to.z, e));
    return e2c_frame_shot(feet, yaw, E2cFrame.{turn = from.turn + figs.wrap_angle(to.turn - from.turn) * e, dist = e2c_mix(from.dist, to.dist, e), rise = e2c_mix(from.rise, to.rise, e)}, look);
  }
  track := e2c_frame_shot(feet, yaw, e2c_frame(e2c_clamp((t - f32(E2C_SWING)) / f32(E2C_RUN), 0, 1)), e2c_look(feet, yaw));
  cut := c[0].cut[..];
  if t < f32(E2C_SWING + E2C_RUN) { return figs.cam_cut_play(cut, track, t); }
  // the run ends: the orbit turned to look the way the run looked (the retain outcome), then the
  // hand-back eases from the run's framing, still on you, to the follow camera
  if figs.cam_cut_live(cut[0]) && cut[0].phase != figs.CamCutPhase.handing { _p := figs.cam_cut_play(cut, track, t); s[0].orbit = figs.cam_cut_end(cut, s[0].orbit, s[0].you_face, f32(E2C_SWING + E2C_RUN)); return track; }
  shown := figs.cam_cut_hand_on(cut, track, chase, t);
  if !figs.cam_cut_live(cut[0]) { c[0].handed = true; }   // the follow camera and the keys are yours
  return shown;
}
// The studio's lens: on a phone you stand in the gap over the wardrobe (Character Create's own
// focal and centre), easing to the follow camera's as the camera swings behind you.
e2c_lens :: (s: [] E2, focal: f32, cy: f32) -> [2] f32 {
  c := s[0].cz[0];
  if !c.on || c.handed || !c.mobile { return [2] f32.[focal, cy]; }
  h := s[0].height; k := s[0].k;
  f0 := (h - 624 * k) * 1.3; y0 := (h - 384 * k) * 0.5;
  if f0 < focal * 0.5 { f0 = focal * 0.5; }
  e := ifx c.walking then e2c_ease(c.run_t / f32(E2C_SWING)) else 0.0f32;
  return [2] f32.[e2c_mix(f0, focal, e), e2c_mix(y0, cy, e)];
}
// Your figure in the studio: the ANIMATION field's clip, turned by the drag (0 faces the camera).
e2c_figure :: (s: [] E2) -> figs.BdAnim {
  c := s[0].creator[0];
  a: figs.BdAnim; a.on = true; a.own = true; a.x = s[0].you_x; a.y = s[0].you_y; a.z = s[0].you_z; a.yaw = c.yaw;
  a.clip = [4] int.[figs.BD_IDLE, figs.BD_WALK, figs.BD_RUN, figs.BD_SPELL][c.pose];
  a.t0 = c.pose_at; a.fade_at = -100; a.phase = (s[0].clock - c.pose_at) / figs.bd_seconds(a.clip);
  if c.pose == 3 { dur := figs.bd_seconds(figs.BD_SPELL); a.t0 = c.pose_at + floor((s[0].clock - c.pose_at) / dur) * dur; }
  return a;
}
#test "create: the studio camera looks at you from the south; after USE the run plays down the path, then hands over" #steps 2000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  _ := e2_start(s[..]);
  feet := figs.v3(s[0].you_x, s[0].you_y, s[0].you_z);
  sh := e2c_shot(s[..], feet, figs.Shot.{}, 0.016);
  #assert sh.eye.z > feet.z + 2 && sh.at.z < sh.eye.z && sh.eye.y > feet.y;
  // the run drives no keys in the studio
  inp := e2_move_in(s[..]); #assert inp.key_y == 0 && inp.key_x == 0;
  studio := s[0].cz[0].studio;
  chase := figs.Shot.{eye = figs.v3(feet.x, feet.y + 2, feet.z + 4), at = figs.v3(feet.x, feet.y + 1, feet.z - 4)};
  e2c_walk(s[..]);
  // the first frame is the studio's shot: no cut
  first := e2c_shot(s[..], feet, chase, 0.0001);
  #assert abs(first.eye.x - studio.eye.x) + abs(first.eye.y - studio.eye.y) + abs(first.eye.z - studio.eye.z) < 0.1;
  // the run goes on its own, forward, toward the path (north, -z)
  inp = e2_move_in(s[..]); #assert inp.key_y == 1 && !inp.run && -cos(inp.theta) < -0.5;
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0 && s[0].cz[0].run_t >= f32(E2C_SWING + E2C_RUN) - 0.001;
  // the ease ends on the follow camera, each step a small one
  last := e2c_shot(s[..], feet, chase, 0.016);
  for i: 0..<int(f32(E2C_EASE) / 0.016) + 2 {
    st := e2c_shot(s[..], feet, chase, 0.016);
    #assert abs(st.eye.x - last.eye.x) + abs(st.eye.y - last.eye.y) + abs(st.eye.z - last.eye.z) < 0.9;
    last = st;
  }
  #assert s[0].cz[0].handed && !e2c_running(s[..]) && last.eye.z == chase.eye.z && e2c_shown(s[..]) == 0;
  inp = e2_move_in(s[..]); #assert inp.key_y == 0;   // the keys are yours
}

// For headless checks (e2_probe 20 to 29): 20 in the studio, 21 walking, 22 the run playing, 23 handed
// over, 24 the wardrobe's revision, 25 the record kept, 26 the outfit, 27 the body (1 female), 28 the
// class, 29 the run's ms.
e2c_probe :: (s: [] E2, f: int) -> int {
  c := s[0].cz[0]; cr := s[0].creator[0];
  if f == 20 { return ifx e2c_creating(s) then 1 else 0; }
  if f == 21 { return ifx c.walking then 1 else 0; }
  if f == 22 { return ifx e2c_running(s) then 1 else 0; }
  if f == 23 { return ifx c.handed then 1 else 0; }
  if f == 24 { return cr.revision; }
  if f == 25 { return ifx c.ok then 1 else 0; }
  if f == 26 { return cr.outfit; }
  if f == 27 { return ifx cr.female then 1 else 0; }
  if f == 28 { return cr.klass; }
  if f == 29 { return cast(int)(c.run_t * 1000); }
  return -1;
}

// ---- the class pane: the CLASS row's class, in words, on its own glass
// On a desktop a panel at the screen's right, clear of you in the middle; on a phone two narrow
// columns in the sky either side of you, between the top band and the wardrobe's. It says what the
// class is and how it plays, its Hit Die and primary ability, its saving throws, its armor and
// weapon training, its level 1 features, and the ability its bar starts with (slot 1, the same as
// Everglade's: everglade-classes.coax CL_ABILITY) with that ability's picture. It changes with the
// row. The facts follow the SRD 5.2.1's classes (core traits and level 1 features); the
// descriptions are ours.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
E2C_CLASS_TITLES :: [12] string.["Barbarian", "Bard", "Cleric", "Druid", "Fighter", "Monk", "Paladin", "Ranger", "Rogue", "Sorcerer", "Warlock", "Wizard"];
E2C_ABOUT :: [12] string.[
  "A fierce warrior fueled by primal power. In battle you enter a Rage that makes you hard to hurt and makes your blows land harder. You fight best up close with heavy weapons.",
  "An inspiring performer whose words and music carry magic. You support your allies with Bardic Inspiration and a broad set of spells, and you cut foes down with mockery.",
  "A priest who channels divine power. You heal and protect your allies and call down radiant light on your foes, armored for the front line.",
  "A keeper of the old ways who draws magic from nature. You strike with starlight and flame, tangle foes in plants, and heal your friends.",
  "A master of weapons and armor. You fight in heavy armor with any weapon, and Second Wind keeps you on your feet when the battle turns.",
  "A martial artist who channels inner focus. You fight unarmored with fast fists and feet, and you strike more than once a turn.",
  "A holy warrior bound by a sacred oath. You fight in heavy armor, heal with Lay On Hands, and smite foes with divine power.",
  "A wanderer of the wild who hunts with skill and magic. You mark your quarry with Hunter's Mark and strike it from afar with a bow.",
  "A skilled trickster who relies on stealth and precision. You strike where a foe is weakest with Sneak Attack and slip out of danger.",
  "A spellcaster whose magic is an inborn gift. Innate Sorcery makes your spells hit harder, and Fire Bolt burns foes from afar.",
  "A wielder of magic granted by a pact with an otherworldly patron. Eldritch Blast is your signature attack, and your Eldritch Invocations shape how you fight.",
  "A scholar of arcane magic with the widest choice of spells. You stay out of reach and blast foes with Fire Bolt while your spellbook grows."];
E2C_DIE :: [12] string.["d12", "d8", "d8", "d8", "d10", "d8", "d10", "d10", "d8", "d6", "d8", "d6"];
E2C_PRIMARY :: [12] string.["Strength", "Charisma", "Wisdom", "Wisdom", "Strength or Dexterity", "Dexterity and Wisdom", "Strength and Charisma",
                            "Dexterity and Wisdom", "Dexterity", "Charisma", "Charisma", "Intelligence"];
E2C_SAVES :: [12] string.["Strength, Constitution", "Dexterity, Charisma", "Wisdom, Charisma", "Intelligence, Wisdom", "Strength, Constitution",
                          "Strength, Dexterity", "Wisdom, Charisma", "Strength, Dexterity", "Dexterity, Intelligence", "Constitution, Charisma",
                          "Wisdom, Charisma", "Intelligence, Wisdom"];
E2C_ARMOR :: [12] string.["Light, Medium, Shields", "Light", "Light, Medium, Shields", "Light, Shields", "Light, Medium, Heavy, Shields", "None",
                          "Light, Medium, Heavy, Shields", "Light, Medium, Shields", "Light", "None", "Light", "None"];
E2C_WEAPONS :: [12] string.["Simple and Martial", "Simple", "Simple", "Simple", "Simple and Martial", "Simple, and Martial with the Light property",
                            "Simple and Martial", "Simple and Martial", "Simple, and Martial with the Finesse or Light property", "Simple", "Simple", "Simple"];
E2C_FEATURES :: [12] string.["Rage, Unarmored Defense, Weapon Mastery", "Bardic Inspiration, Spellcasting", "Spellcasting, Divine Order",
                             "Spellcasting, Druidic, Primal Order", "Fighting Style, Second Wind, Weapon Mastery", "Martial Arts, Unarmored Defense",
                             "Lay On Hands, Spellcasting, Weapon Mastery", "Spellcasting, Favored Enemy, Weapon Mastery",
                             "Expertise, Sneak Attack, Thieves' Cant, Weapon Mastery", "Spellcasting, Innate Sorcery", "Eldritch Invocations, Pact Magic",
                             "Spellcasting, Ritual Adept, Arcane Recovery"];
// Slot 1: its name, its picture (realms/everglade/hotbar, everglade-hotbar.coax CL_HB_NAME) and what it does.
E2C_ABILITY :: [12] string.["Rage", "Vicious Mockery", "Sacred Flame", "Starry Wisp", "Second Wind", "Martial Arts", "Lay On Hands", "Hunter's Mark",
                            "Sneak Attack", "Fire Bolt", "Eldritch Blast", "Fire Bolt"];
E2C_ICON :: [12] string.["cl-rage", "cl-vicious-mockery", "cl-sacred-flame", "cl-starry-wisp", "cl-second-wind", "cl-martial-arts", "cl-lay-on-hands",
                         "cl-hunters-mark", "cl-sneak-attack", "cl-sorcerer-fire-bolt", "cl-eldritch-blast", "cl-wizard-fire-bolt"];
E2C_ICON_URL :: "/worlds/everglade/hotbar/";
E2C_SLOT :: [12] string.[
  "Bonus Action. You resist Bludgeoning, Piercing and Slashing damage and deal extra damage with Strength attacks.",
  "Cantrip. A creature makes a Wisdom save or takes 1d6 Psychic damage and has Disadvantage on its next attack roll.",
  "Cantrip. A creature makes a Dexterity save or takes 1d8 Radiant damage.",
  "Cantrip. A ranged spell attack for 1d8 Radiant damage. The target sheds light and can't be invisible.",
  "Bonus Action. You regain 1d10 plus your Fighter level in Hit Points.",
  "Your Unarmed Strikes use Dexterity and your Martial Arts die, and you can make one as a Bonus Action.",
  "Bonus Action. Touch a creature to restore Hit Points from a pool of five times your Paladin level.",
  "Bonus Action spell. Mark a creature, and your weapon attacks deal it an extra 1d6 Force damage.",
  "Once a turn, 1d6 extra damage when you hit with a Finesse or Ranged weapon and have Advantage.",
  "Cantrip. A ranged spell attack for 1d10 Fire damage.",
  "Cantrip. A beam of crackling energy: a ranged spell attack for 1d10 Force damage.",
  "Cantrip. A ranged spell attack for 1d10 Fire damage."];
E2C_PANE_W :: 330.0;   // the desktop pane's width, CSS px
E2C_PAD :: 14.0;
E2cLines :: struct { n: int; lines: int; }
E2cPane :: struct { a: cc.Box; b: cc.Box; }   // a desktop's one panel (a), or a phone's two columns (a left, b right)

e2c_class_of :: (s: [] E2) -> int { k := s[0].creator[0].klass; return ifx k < 0 then E2C_DRUID else ifx k >= E2C_CLASSES then E2C_CLASSES - 1 else k; }
// The width of t at cap, as cc.text sets it.
e2c_width :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for i: 0..<t.count { c := cast(int) t[i]; w += f32(cc.CC_FONT_WIDTH[ifx c >= 32 && c <= 126 then c - 32 else 31]) / f32(cc.CC_FONT_UPM) * em; }
  return w;
}
// t in lines no wider than `wide`, `lh` apart, the first's baseline at y (draw false: only counted).
e2c_set_lines :: (out: [] f32, at: int, t: string, x: f32, y: f32, cap: f32, wide: f32, lh: f32, k: cc.Ink, draw: bool) -> E2cLines {
  n := at; lines := 0; start := 0; last := -1; i := 0;
  while i <= t.count {
    if i == t.count || t[i] == ' ' {
      if e2c_width(t[start..<i], cap) > wide && last > start {
        if draw { n = cc.text(out, n, t[start..<last], x, y + f32(lines) * lh, cap, k); }
        lines += 1; start = last + 1; last = -1;
        continue;
      }
      last = i;
    }
    i += 1;
  }
  if start < t.count { if draw { n = cc.text(out, n, t[start..<t.count], x, y + f32(lines) * lh, cap, k); } lines += 1; }
  return E2cLines.{n = n, lines = lines};
}
// The pane's words for class cl, set from (x, y) in a column `wide` across; part 0 all of it (a
// desktop), on a phone 1 the left column (the class and its traits) and 2 the right (what it is,
// its level 1 features and slot 1). Returns the strokes' end and the height used (device px).
E2cSet :: struct { n: int; h: f32; }
e2c_words :: (s: [] E2, out: [] f32, at: int, cl: int, x: f32, y0: f32, wide: f32, k: f32, part: int, f: f32, draw: bool) -> E2cSet {
  white := e2c_ink(k, 0.91, 0.92, 0.9, f); dim := e2c_ink(k, 0.78, 0.82, 0.8, f);
  gold := e2c_ink(k, 0.83, 0.69, 0.43, f); label := e2c_ink(k, 0.93, 0.88, 0.72, f);
  phone := part != 0;
  body := (ifx phone then 7.0f32 else 9.4f32) * k; lh := (ifx phone then 10.8f32 else 17.0f32) * k; tag := (ifx phone then 5.8f32 else 7.4f32) * k;
  n := at; y := y0; w: E2cLines;
  if part != 2 {
    // the class and its traits
    y += (ifx phone then 16.0f32 else 26.0f32) * k;
    if draw { n = cc.text(out, n, E2C_CLASS_TITLES[cl], x, y, (ifx phone then 13.0f32 else 20.0f32) * k, white); }
    if !phone {
      y += 14 * k; if draw { n = cc.line(out, n, x, y, x + wide, y, k, gold.red * f, gold.green * f, gold.blue * f); }
      y += 20 * k; if draw { n = cc.text(out, n, "LEVEL 1  ·  SRD 5.2.1", x, y, tag, label); }
      y += 22 * k;
      w = e2c_set_lines(out, n, E2C_ABOUT[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh + 8 * k;
    } else { y += 14 * k; }
    names := [5] string.["HIT DIE", "PRIMARY ABILITY", "SAVING THROWS", "ARMOR TRAINING", "WEAPONS"];
    rows := [5] string.[E2C_DIE[cl], E2C_PRIMARY[cl], E2C_SAVES[cl], E2C_ARMOR[cl], E2C_WEAPONS[cl]];
    vx := ifx phone then x else x + 124 * k; vw := ifx phone then wide else wide - 124 * k;
    for r: 0..<5 {
      if draw { n = cc.text(out, n, names[r], x, y, tag, label); }
      if phone { y += 11 * k; }
      w = e2c_set_lines(out, n, rows[r], vx, y, body, vw, lh, white, draw); n = w.n; y += f32(w.lines) * lh + (ifx phone then 3.0f32 else 5.0f32) * k;
    }
  }
  if part != 1 {
    if phone { y += 10 * k; w = e2c_set_lines(out, n, E2C_ABOUT[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh; }
    // the level 1 features, and slot 1 with its picture (a phone has no room for what it does)
    y += 6 * k;
    if draw { n = cc.text(out, n, "LEVEL 1 FEATURES", x, y, tag, label); }
    y += (ifx phone then 10.0f32 else 16.0f32) * k;
    w = e2c_set_lines(out, n, E2C_FEATURES[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh + (ifx phone then 4.0f32 else 8.0f32) * k;
    if draw { n = cc.text(out, n, "ON YOUR BAR", x, y, tag, label); }
    y += (ifx phone then 5.0f32 else 8.0f32) * k;
    icon := (ifx phone then 28.0f32 else 52.0f32) * k;
    if draw && f > 0.5 { e2c_media(s, E2C_ICON[cl], ifx icon > 72 then "-128.jpg" else ifx icon > 48 then "-72.jpg" else "-48.jpg", x, y, x + icon, y + icon); }
    if draw { n = cc.text(out, n, E2C_ABILITY[cl], x + icon + 8 * k, y + icon * 0.5 + 4 * k, (ifx phone then 8.4f32 else 10.5f32) * k, gold); }
    y += icon + 12 * k;
    if !phone { w = e2c_set_lines(out, n, E2C_SLOT[cl], x, y, body, wide, lh, dim, draw); n = w.n; y += f32(w.lines) * lh; }
  }
  return E2cSet.{n = n, h = y - y0 - lh * 0.5};
}
// Where the pane goes: a desktop's at the right, as tall as its words; a phone's two columns
// either side of you in the sky, from under the top band to over the wardrobe's.
e2c_pane :: (s: [] E2, w: f32, h: f32, k: f32) -> E2cPane {
  cl := e2c_class_of(s); out: [1] f32;
  if w < 840 * k || h < 760 * k {
    top := 130 * k; bottom := h - 510 * k;
    side := w * 0.5 - 46 * k - 8 * k;
    if bottom - top < 150 * k || side < 120 * k { return E2cPane.{}; }
    return E2cPane.{a = cc.Box.{x0 = 8 * k, y0 = top, x1 = 8 * k + side, y1 = bottom}, b = cc.Box.{x0 = w - 8 * k - side, y0 = top, x1 = w - 8 * k, y1 = bottom}};
  }
  pw := f32(E2C_PANE_W) * k; pad := f32(E2C_PAD) * k;
  tall := e2c_words(s, out[..], 0, cl, 0, 0, pw - 2 * pad, k, 0, 1, false).h + 2 * pad;
  return E2cPane.{a = cc.Box.{x0 = w - 16 * k - pw, y0 = 20 * k, x1 = w - 16 * k, y1 = 20 * k + e2c_clamp(tall, 200 * k, h - 40 * k)}};
}
e2c_pane_draw :: (s: [] E2, out: [] f32, at: int, f: f32) -> int {
  w := s[0].width; h := s[0].height; k := s[0].k; cl := e2c_class_of(s);
  p := e2c_pane(s, w, h, k); n := at; pad := f32(E2C_PAD) * k;
  if p.a.x1 <= p.a.x0 { return n; }
  if p.b.x1 <= p.b.x0 { return e2c_words(s, out, n, cl, p.a.x0 + pad, p.a.y0 + pad * 0.5, p.a.x1 - p.a.x0 - 2 * pad, k, 0, f, true).n; }
  inset := 8 * k;
  n = e2c_words(s, out, n, cl, p.a.x0 + inset, p.a.y0 + 2 * k, p.a.x1 - p.a.x0 - 2 * inset, k, 1, f, true).n;
  return e2c_words(s, out, n, cl, p.b.x0 + inset, p.b.y0 + 2 * k, p.b.x1 - p.b.x0 - 2 * inset, k, 2, f, true).n;
}
// A picture for the host to draw (coax/web/host.js coaxial_media): "image URL X0 Y0 X1 Y1".
e2c_put :: (m: [] u8, at: int, t: string) -> int { n := at; for i: 0..<t.count { if n < m.count { m[n] = t[i]; n += 1; } } return n; }
e2c_media :: (s: [] E2, name: string, tail: string, x0: f32, y0: f32, x1: f32, y1: f32) {
  m := s[0].media[..]; n := s[0].media_n;
  if n + 120 > m.count { return; }
  if n > 0 { m[n] = 10; n += 1; }
  n = e2c_put(m, n, "image "); n = e2c_put(m, n, E2C_ICON_URL); n = e2c_put(m, n, name); n = e2c_put(m, n, tail);
  e := [4] f32.[x0, y0, x1, y1];
  for i: 0..<4 {
    n = e2c_put(m, n, " "); v := cast(int) floor(e[i] + 0.5); if v < 0 { n = e2c_put(m, n, "-"); v = -v; }
    d: [12] u8; c := 0; while true { d[c] = cast(u8)('0' + v % 10); c += 1; v /= 10; if v == 0 { break; } }
    while c > 0 { c -= 1; if n < m.count { m[n] = d[c]; n += 1; } }
  }
  s[0].media_n = n;
}
// The pane's glass (gpu/everglade2.coax post pass): u[52..55] the desktop panel or a phone's left
// column, u[56..59] a phone's right one, device px; all 0 when there is none.
e2c_pane_uniforms :: (s: [] E2, u: [] f32) {
  p := e2c_pane(s, s[0].width, s[0].height, s[0].k);
  e := [8] f32.[p.a.x0, p.a.y0, p.a.x1, p.a.y1, p.b.x0, p.b.y0, p.b.x1, p.b.y1];
  for i: 0..<8 { u[52 + i] = e[i]; }
}
#test "create: the class pane says every class in full, and stays clear of you and the wardrobe" #steps 400000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  out: [24000] f32;
  for cl: 0..<E2C_CLASSES {
    #assert E2C_ABOUT[cl].count > 80 && E2C_SLOT[cl].count > 30 && E2C_FEATURES[cl].count > 5 && E2C_ICON[cl].count > 3;
    s[0].creator[0].klass = cl;
    // a desktop: at the right, clear of the middle and of the left glass, inside the screen
    for size: 0..<2 {
      w := ifx size == 0 then 1440.0f32 else 900.0f32; h := ifx size == 0 then 900.0f32 else 780.0f32;
      p := e2c_pane(s[..], w, h, 1);
      #assert p.a.x0 > w * 0.5 + 60 && p.a.x0 > 350 && p.a.x1 <= w - 16 && p.a.y0 >= 20 && p.a.y1 <= h - 20 && p.b.x1 == 0;
    }
    // a phone: two columns between the top band (to 124) and the wardrobe's (from h - 504), clear of
    // your figure in the middle (about 30 px either side of centre)
    p := e2c_pane(s[..], 390, 844, 1);
    #assert p.a.x0 >= 0 && p.a.x1 <= 195 - 40 && p.b.x0 >= 195 + 40 && p.b.x1 <= 390 && p.a.y0 >= 124 && p.a.y1 <= 844 - 504 && p.b.y1 == p.a.y1;
    // and each column's words fit in it
    cw := p.a.x1 - p.a.x0 - 16;
    #assert e2c_words(s[..], out[..], 0, cl, 0, 0, cw, 1, 1, 1, false).h <= p.a.y1 - p.a.y0;
    #assert e2c_words(s[..], out[..], 0, cl, 0, 0, cw, 1, 2, 1, false).h <= p.b.y1 - p.b.y0;
    // drawn, slot 1's picture is named
    s[0].width = 1440; s[0].height = 900; s[0].k = 1; s[0].media_n = 0;
    _ := e2c_pane_draw(s[..], out[..], 0, 1);
    #assert s[0].media_n > 20 && s[0].media[6] == '/';
  }
}
