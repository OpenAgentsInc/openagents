// Character Create, in Everglade II's own world (#13023). /worlds/character-creator opens Everglade II
// at its glade, where the path begins, in this mode: a studio camera on your character, the wardrobe
// and the CLASS row down the left (on a phone, at the bottom), and your keys and pointer on the
// wardrobe. What you pick is your character in the world as you pick it (s[0].creator, the record
// aethyr/character-appearance.coax reads), drawn by Everglade II's renderer in its own light.
// USE IN EVERGLADE keeps the record (action 16, the browser's shared copy, message 17 says it was
// kept), puts /worlds/everglade2 in the address bar (action 19) and plays the run: the controls fade,
// the camera swings round behind you, you run out of the glade and down the path on your own while
// the camera keeps its own track, and it eases into the follow camera, where the keys are yours. Any
// key or a click skips to that hand-off. One page, one world, one renderer: nothing loads.
// Loaded into everglade2.coax, so it shares its E2, its glade, its path and figs.

E2C_FIELDS :: 13;        // the wardrobe's fields (charactercreator.coax change and value, 0 to 12)
E2C_BOXES :: 26;
E2C_CLASS :: 13;         // the CLASS row's field number
E2C_CLASS_BOX :: 18;     // and its box (0 to 12 the fields, 13 RESET, 14 SURPRISE ME, 15 a phone's drag mode, 16 SAVE, 17 USE, 21 to 25 a phone's tabs)
E2C_NAME_BOX :: 19;      // NAME: your name over your head, for everyone (player-name.coax, the API's player/name)
E2C_LEVEL :: 14;         // the LEVEL row's field number: your class's level, 1 to E2C_LEVELS (#13046)
E2C_LEVEL_BOX :: 20;     // and its box
E2C_LEVELS :: 6;
E2C_LEVEL_NAMES :: [6] string.["1", "2", "3", "4", "5", "6"];
E2C_SWING :: 3.0;        // s: the controls fade and the camera swings round behind you
E2C_RUN :: 20.0;         // s: the run out of the glade and down the path, on its own
E2C_EASE :: 1.5;         // s: the camera eases into the follow camera, then the keys are yours
E2C_FADE :: 0.8;         // s: the controls fade out
E2C_RECORD :: 58;        // the longest record (CC4: a class past level 1)
E2C_SAVE :: 16;          // host.js: keep the outbox as the shared character record; message 17 says it was kept
E2C_KEPT :: 17;
E2C_ADDRESS :: 19;       // host.js: this same-origin path in the address bar (history.replaceState), nothing loaded
E2C_DRUID :: 3;          // the CLASS row starts at the druid, as Everglade's did
E2C_CLASSES :: 12;       // the SRD 5.2.1's, in fivebar.coax's order (aethyr/character-appearance.coax CA_CLASSES)
E2C_CLASS_NAMES :: [12] string.["BARBARIAN", "BARD", "CLERIC", "DRUID", "FIGHTER", "MONK", "PALADIN", "RANGER", "ROGUE", "SORCERER", "WARLOCK", "WIZARD"];
E2C_PANEL_BOTTOM :: 730.0;   // the glass panel's foot on a desktop (gpu/character-glade.coax cg_ui_cover)
// The arrival through Everglade's portal from the homepage (newland-portal.coax: its button,
// "Create your character", flies the homepage's camera into the portal and opens this page at
// ?via=portal). The page opens on the portal's light (gpu/everglade2.coax e2_arrival, the same light at
// the same scale and wall clock), holds it until the glade has drawn E2C_ARRIVE_FRAMES frames, then:
// the glade opens through it from the middle, the camera comes round and in to the studio's
// framing, your character pops up, and the wardrobe fades in. A key, click or scroll skips to the end.
E2C_ARRIVE_FRAMES :: 2;
E2C_ARRIVE_OPEN :: 0.05;     // s: the glade starts to open through the light
E2C_ARRIVE_OPENED :: 1.5;    // s: and has opened to the corners
E2C_ARRIVE_CAMERA :: 2.8;    // s: the camera has come round to the studio's framing
E2C_ARRIVE_POP :: 1.25;      // s: your character pops up
E2C_ARRIVE_POPPED :: 1.75;
E2C_ARRIVE_UI :: 2.2;        // s: the wardrobe fades in
E2C_ARRIVE_END :: 2.9;
E2C_ARRIVE_TURN :: 1.15;     // rad: the camera comes round this far
E2C_ARRIVE_WIDE :: 2.3;      // and in from this many times the studio's distance
E2C_ARRIVE_RISE :: 2.6;      // m, and down from this much higher
E2C_PORTAL_WALL :: 600000;   // ms: the shimmer's clock is the wall clock's, mod this (newland-portal.coax PORTAL_WALL)

E2Create :: struct {
  on: bool;        // this page opened at Character Create
  walking: bool;   // USE IN EVERGLADE taken: the run plays, the wardrobe gone
  run_t: f32;      // seconds since the record was kept
  handed: bool;    // the run is over: the follow camera and the keys are yours
  cut: [1] figs.CamCut;   // the run as an Aethyr cinematic (aethyr/cam/handback.coax): its hand-back retains the run's look
  address: bool;   // the address bar still to say /worlds/everglade2
  boxes: [E2C_BOXES] cc.Box; mobile: bool;
  wide: bool; tab: int; card: cc.Box; sheet: cc.Box;   // a phone held sideways; its chosen tab; the panels (e2c_layout)
  down: int = -1; dragging: bool; drag_pan: bool; drag_id: int; dx: f32; dy: f32;
  pending: bool; request: bool; ok: bool; failed: bool; want_go: bool; saved_rev: int = -1; at_rev: int;
  bytes: [E2C_RECORD] u8; n: int;
  studio: figs.Shot;   // the studio camera's last shot, where the swing starts
  arriving: bool;      // opened through the portal (?via=portal), its arrival not yet over
  arrive_t: f32 = -1;  // s since the arrival started (below 0: the glade not yet drawn)
  drawn: int;          // the glade's frames drawn
  wall: f32; wall_clock: f32; clocked: bool;   // the wall clock's s (mod E2C_PORTAL_WALL) at the facts, and the page's clock then
  fig0: int; fig1: int;  // your character's records, for the pop
  hidden: bool;        // out of sight: the arrival waits (opened in place under the lander, or a hidden tab)
  editing: bool;                         // NAME takes your keys (the host's keyboard field over its box)
  draft: [NET_NAME] u8; draft_n: int;    // what you have typed
  naming: bool;                          // the name is with the API; its answer says it or refuses it
  said: [64] u8; said_n: int;            // a refused name's reason, said where the name is until you next press
  menu: bool;                            // Esc in the world: Change character and Back to the game
  menu_box: [2] cc.Box;
  changing: bool;                        // back in the studio from the world: USE IN EVERGLADE returns you where you stood
  back_face: f32;
}

e2c_creating :: (s: [] E2) -> bool { return s[0].cz[0].on && !s[0].cz[0].walking; }
e2c_running :: (s: [] E2) -> bool { c := s[0].cz[0]; return c.on && c.walking && !c.handed; }
e2c_wrap :: (v: int, n: int) -> int { return (v % n + n) % n; }
e2c_clamp :: (v: f32, a: f32, b: f32) -> f32 { if v < a { return a; } if v > b { return b; } return v; }
e2c_ease :: (v: f32) -> f32 { t := e2c_clamp(v, 0, 1); return t * t * (3 - 2 * t); }
e2c_mix :: (a: f32, b: f32, t: f32) -> f32 { return a + (b - a) * t; }

// The page's facts: at Character Create you start in the glade, the wardrobe yours.
e2c_facts :: (s: [] E2, t: string) {
  play := e2c_play_page(t);
  if (!cc.page(t) && !play) || s[0].cz[0].walking { return; }
  c := s[0].cz[..]; cr := s[0].creator[..];
  // everglade.world/play: a character already kept in this browser (message 16, before the facts)
  // goes straight into the world; none yet, Character Create here first
  if play && cr[0].profile_ok { return; }
  c[0].on = true; s[0].start_z = 0; s[0].autowalk = false;
  cc.ensure(cr);
  if cr[0].klass < 0 || cr[0].klass >= E2C_CLASSES { cr[0].klass = E2C_DRUID; }
  if cr[0].profile_ok { c[0].ok = true; c[0].saved_rev = cr[0].profile_revision; }
  if e2c_fact_has(t, "via=portal") && c[0].arrive_t < 0 { c[0].arriving = true; }
  ms := e2c_fact_int(t, "now=");
  if ms >= 0 { c[0].wall = f32(ms % E2C_PORTAL_WALL) / 1000; c[0].wall_clock = s[0].clock; c[0].clocked = true; }
}
// everglade.world's one address, /play, for Character Create and the world (served from the bucket's
// realms/everglade2/domain/play/): the address bar stays as it is when you walk out of the glade.
e2c_play_page :: (t: string) -> bool {
  for p: [5] string.["/play", "/play/", "/worlds/everglade2/domain/play/", "/realms/everglade2/domain/play/", "/realms/everglade2/domain/play/index.html"] { if cc.page_path(t, p) { return true; } }
  return false;
}
#test "/play is Character Create without a kept character, the world with one" #steps 200000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=https://everglade.world/play?via=portal\nnow=1000");
  #assert s[0].play && e2c_creating(s[..]) && s[0].cz[0].arriving;
  #assert !e2c_play_page("url=https://everglade.world/player\n") && !e2c_play_page("url=https://openagents.com/worlds/everglade2\n");
  b: [E2C_RECORD] u8; n := cc.save(s[0].creator[0], b[..]);
  t: [1] E2; e2_message(t[..], 16, cast(string) b[0..<n]); e2_message(t[..], E2_HOST_PAGE, "url=https://everglade.world/play\n");
  #assert t[0].play && !t[0].cz[0].on && !e2c_creating(t[..]);
  // finishing Character Create on /play keeps the record and runs, and says no other address
  e2c_request(s[..], true); e2c_action(s[..]); #assert s[0].action == E2C_SAVE;
  k: [E2C_RECORD] u8; m := s[0].out_n; for i: 0..<m { k[i] = s[0].outbox[i]; }
  s[0].action = 0; e2_message(s[..], E2C_KEPT, cast(string) k[0..<m]);
  #assert e2c_running(s[..]); e2c_action(s[..]); #assert s[0].action == 0;
}
// Out of sight and shown again (messages 601 and 602): the arrival waits while hidden, and the
// shimmer's clock takes the wall clock again when shown (handed over in place, the lander's light
// is at that same clock).
e2c_seen :: (s: [] E2, shown: bool, t: string) {
  c := s[0].cz[..];
  c[0].hidden = !shown;
  ms := e2c_fact_int(t, "now=");
  if shown && ms >= 0 { c[0].wall = f32(ms % E2C_PORTAL_WALL) / 1000; c[0].wall_clock = s[0].clock; c[0].clocked = true; }
}
// The url fact's query holds `key` (as ?key or &key), and the integer fact `key` (-1 if none).
e2c_fact_has :: (t: string, key: string) -> bool {
  for i: 1..<t.count - key.count + 1 { if (t[i - 1] == '?' || t[i - 1] == '&') && t[i..<i + key.count] == key { e := i + key.count; if e >= t.count || t[e] == '&' || t[e] == '#' || t[e] == '\n' { return true; } } }
  return false;
}
e2c_fact_int :: (t: string, key: string) -> int {
  at := 0;
  while at < t.count {
    if (at == 0 || t[at - 1] == '\n') && at + key.count <= t.count && t[at..<at + key.count] == key {
      v := 0; j := at + key.count; any := false;
      while j < t.count && t[j] >= '0' && t[j] <= '9' { v = v * 10 + cast(int)(t[j] - '0'); j += 1; any = true; }
      return ifx any then v else -1;
    }
    at += 1;
  }
  return -1;
}

// ---- the arrival through the portal (see E2C_ARRIVE_FRAMES)
e2c_smoother :: (v: f32) -> f32 { t := e2c_clamp(v, 0, 1); return t * t * t * (t * (t * 6 - 15) + 10); }
e2c_span :: (t: f32, a: f32, b: f32) -> f32 { return e2c_clamp((t - a) / (b - a), 0, 1); }
// The arrival's own clock, once the glade has drawn: -1 before, then its seconds.
e2c_arrive_at :: (s: [] E2) -> f32 { c := s[0].cz[0]; if !c.arriving { return E2C_ARRIVE_END; } return c.arrive_t; }
// Each frame: the glade's frames counted, the arrival's clock run; over at E2C_ARRIVE_END.
e2c_arrive_step :: (s: [] E2, dt: f32) {
  c := s[0].cz[..];
  if !c[0].arriving { return; }
  if c[0].hidden { return; }   // it plays where it is seen
  if c[0].arrive_t < 0 { if c[0].drawn >= E2C_ARRIVE_FRAMES { c[0].arrive_t = 0; } return; }
  c[0].arrive_t += dt;
  if c[0].arrive_t >= f32(E2C_ARRIVE_END) { c[0].arriving = false; c[0].arrive_t = f32(E2C_ARRIVE_END); }
}
e2c_arrive_skip :: (s: [] E2) { c := s[0].cz[..]; if c[0].arriving && c[0].arrive_t >= 0 { c[0].arriving = false; c[0].arrive_t = f32(E2C_ARRIVE_END); } }
// The wardrobe's share during the arrival.
e2c_arrive_ui :: (s: [] E2) -> f32 { t := e2c_arrive_at(s); if t < 0 { return 0; } return e2c_ease(e2c_span(t, f32(E2C_ARRIVE_UI), f32(E2C_ARRIVE_END))); }
// Your character's size during the arrival: nothing, then up with a little overshoot.
e2c_arrive_size :: (s: [] E2) -> f32 {
  t := e2c_arrive_at(s); if t < 0 { return 0; }
  u := e2c_span(t, f32(E2C_ARRIVE_POP), f32(E2C_ARRIVE_POPPED));
  if u <= 0 { return 0; } if u >= 1 { return 1; }
  a := 1.4f32; v := u - 1; return 1 + (a + 1) * v * v * v + a * v * v;   // ease out back
}
// The studio's shot during the arrival: turned round your feet, farther and higher, coming in.
e2c_arrive_shot :: (s: [] E2, feet: figs.Point, st: figs.Shot) -> figs.Shot {
  t := e2c_arrive_at(s); if t >= f32(E2C_ARRIVE_END) { return st; }
  e := 1 - e2c_smoother(e2c_span(ifx t < 0 then 0.0f32 else t, 0, f32(E2C_ARRIVE_CAMERA)));
  if e <= 0 { return st; }
  a := E2C_ARRIVE_TURN * e; ca := cos(a); sa := sin(a);
  far := 1 + (E2C_ARRIVE_WIDE - 1) * e; up := E2C_ARRIVE_RISE * e;
  vx := st.eye.x - feet.x; vz := st.eye.z - feet.z; ax := st.at.x - feet.x; az := st.at.z - feet.z;
  eye := figs.v3(feet.x + (vx * ca - vz * sa) * far, st.eye.y + up, feet.z + (vx * sa + vz * ca) * far);
  at := figs.v3(feet.x + ax * ca - az * sa, st.at.y + up * 0.15, feet.z + ax * sa + az * ca);
  floor_y := e2_height(eye.x, eye.z) + 0.3; if eye.y < floor_y { eye.y = floor_y; }
  return figs.Shot.{eye = eye, at = at};
}
// The veil's uniforms (gpu/everglade2.coax e2_arrival): u[96] the light's hold, u[97] its clock,
// u[98] its swell, u[99] your character's size short of whole, u[100] the opening, u[101] and u[102]
// your records.
e2c_arrive_uniforms :: (s: [] E2, u: [] f32) {
  c := s[0].cz[0];
  if !c.on || u.count < 104 { return; }
  t := e2c_arrive_at(s);
  if t >= f32(E2C_ARRIVE_END) { return; }
  // ease out: the glade shows through the light within a frame or two of the start, then opens wide
  ou := e2c_span(ifx t < 0 then 0.0f32 else t, f32(E2C_ARRIVE_OPEN), f32(E2C_ARRIVE_OPENED)); ov := 1 - ou;
  open := ifx t < 0 then 0.0f32 else 1 - ov * ov * ov;
  u[96] = 1 - e2c_ease(e2c_span(t, f32(E2C_ARRIVE_OPENED) - 0.5, f32(E2C_ARRIVE_OPENED) + 0.3));
  if t < 0 { u[96] = 1; }
  u[97] = ifx c.clocked then c.wall + (s[0].clock - c.wall_clock) else s[0].clock;
  u[98] = ifx t < 0 then 1.0f32 else 1 - e2c_ease(t / 2.4);
  u[99] = 1 - e2c_arrive_size(s);
  u[100] = open;
  u[101] = f32(c.fig0); u[102] = f32(c.fig1);
}
#test "create: through the portal the page holds the portal's light until the glade draws, then opens, comes in, pops and shows the wardrobe" #steps 400000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=http://x/worlds/character-creator?via=portal\nnow=1700000123456\n");
  c := s[0].cz[..];
  #assert c[0].on; #assert c[0].arriving; #assert c[0].clocked; #assert abs(c[0].wall - 323.456) < 0.01;
  u: [104] f32;
  e2c_arrive_step(s[..], 1.0f32 / 60); e2c_arrive_uniforms(s[..], u[..]);
  #assert c[0].arrive_t < 0 && u[96] == 1 && u[100] == 0 && u[99] == 1 && e2c_shown(s[..]) == 0;
  c[0].drawn = E2C_ARRIVE_FRAMES; e2c_arrive_step(s[..], 1.0f32 / 60); #assert c[0].arrive_t == 0;
  last_open := 0.0f32; last_ui := 0.0f32; t := 0.0f32; shown_at := -1.0f32; popped_at := -1.0f32;
  feet := figs.v3(0, 0, 0); st := figs.Shot.{eye = figs.v3(0, 1.5, 3), at = figs.v3(0, 1.4, -7)};
  prev := e2c_arrive_shot(s[..], feet, st);
  while c[0].arriving {
    e2c_arrive_step(s[..], 1.0f32 / 60); t += 1.0f32 / 60;
    for i: 0..<104 { u[i] = 0; } e2c_arrive_uniforms(s[..], u[..]);
    if c[0].arriving { #assert u[100] >= last_open - 0.00001; last_open = u[100]; }   // (f32 rounding near 1)
    #assert e2c_shown(s[..]) >= last_ui; last_ui = e2c_shown(s[..]);
    if popped_at < 0 && u[99] < 0.5 { popped_at = t; }
    if shown_at < 0 && last_ui > 0.5 { shown_at = t; }
    sh := e2c_arrive_shot(s[..], feet, st);
    dx := sh.eye.x - prev.eye.x; dy := sh.eye.y - prev.eye.y; dz := sh.eye.z - prev.eye.z;
    #assert dx * dx + dy * dy + dz * dz < 0.04;   // under 0.2 m a frame: no cut
    prev = sh;
  }
  #assert popped_at > 1 && shown_at > popped_at && t < 3.2;
  #assert e2c_shown(s[..]) == 1;
  e := e2c_arrive_shot(s[..], feet, st); #assert e.eye.x == st.eye.x && e.eye.z == st.eye.z;
  for i: 0..<104 { u[i] = 0; } e2c_arrive_uniforms(s[..], u[..]); #assert u[96] == 0 && u[99] == 0;
  // a plain visit has no arrival
  p: [1] E2; e2_message(p[..], E2_HOST_PAGE, "url=/worlds/character-creator\n"); #assert !p[0].cz[0].arriving && e2c_shown(p[..]) == 1;
}
#test "create: opened in place under the lander, the arrival waits until the page is shown" #steps 400000000 {
  // opened in place under the lander: drawn, but the arrival waits until the page is shown
  z: [1] E2; e2_message(z[..], E2_HOST_PAGE, "url=http://x/worlds/character-creator?via=portal\nnow=1700000123456\n");
  e2_message(z[..], E2_HOST_HIDDEN, ""); z[0].cz[0].drawn = 40;
  for i: 0..<120 { e2c_arrive_step(z[..], 1.0f32 / 60); }
  #assert z[0].cz[0].arrive_t < 0 && z[0].cz[0].arriving;
  e2_message(z[..], E2_HOST_SHOWN, "now=1700000200000\n");
  #assert abs(z[0].cz[0].wall - 400.0) < 0.01;
  e2c_arrive_step(z[..], 1.0f32 / 60); #assert z[0].cz[0].arrive_t == 0;
}

// ---- the wardrobe: Character Create's fields and values, and the CLASS row
e2c_change :: (s: [] E2, f: int, delta: int) {
  cr := s[0].creator[..];
  if f == E2C_CLASS { cr[0].klass = e2c_wrap((ifx cr[0].klass < 0 then 0 else cr[0].klass) + delta, E2C_CLASSES); cr[0].focused = E2C_CLASS; cr[0].revision += 1; return; }
  if f == E2C_LEVEL { cr[0].level = 1 + e2c_wrap(e2c_level_of(s) - 1 + delta, E2C_LEVELS); cr[0].focused = E2C_LEVEL; cr[0].revision += 1; return; }
  cc.change(cr, f, delta);
}
e2c_value :: (s: [] E2, f: int) -> string {
  if f == E2C_CLASS { k := s[0].creator[0].klass; return E2C_CLASS_NAMES[ifx k < 0 then 0 else ifx k >= E2C_CLASSES then E2C_CLASSES - 1 else k]; }
  if f == E2C_LEVEL { return E2C_LEVEL_NAMES[e2c_level_of(s) - 1]; }
  return cc.value(s[0].creator[0], f);
}

// The shared character record: SAVE PLAYER keeps it; USE IN EVERGLADE keeps it, then runs.
e2c_request :: (s: [] E2, go: bool) {
  c := s[0].cz[..]; cr := s[0].creator[..];
  if c[0].pending { return; }
  if c[0].editing { e2c_name_done(s); }
  cc.ensure(cr);
  n := cc.save(cr[0], c[0].bytes[..]);
  if n < 56 || n > E2C_RECORD { return; }
  c[0].n = n; c[0].at_rev = cr[0].revision; c[0].pending = true; c[0].request = true; c[0].want_go = go; c[0].failed = false;
}
e2c_reply :: (s: [] E2, t: string) {
  c := s[0].cz[..];
  if !c[0].pending { return; }
  c[0].pending = false; c[0].request = false;
  same := t.count == c[0].n;
  if same { for i: 0..<c[0].n { if t[i] != c[0].bytes[i] { same = false; } } }
  c[0].failed = !same; c[0].ok = same;
  if same { c[0].saved_rev = c[0].at_rev; }
  if same && c[0].want_go { if c[0].changing { e2c_back(s); } else { e2c_walk(s); } }
}
// Change character (the Esc menu): the studio again, here where you stand, with your character as it
// is (its class and level the bar's). USE IN EVERGLADE takes you back to the world where you were, and
// the room sits you as the new character (everglade2-net.coax e2n_change). Not while you are down.
e2c_change_character :: (s: [] E2) -> bool {
  c := s[0].cz[..]; cr := s[0].creator[..];
  c[0].menu = false;
  if !s[0].placed || e2c_creating(s) || e2c_running(s) || e2k_bearing(s).pose == DeedPose.down { return false; }
  cr[0].klass = s[0].casts[0].klass; cr[0].level = s[0].casts[0].level; cr[0].revision += 1;
  c[0].on = true; c[0].walking = false; c[0].handed = false; c[0].run_t = 0; c[0].arriving = false; c[0].changing = true;
  c[0].down = -1; c[0].dragging = false; c[0].ok = false; c[0].failed = false;
  c[0].back_face = s[0].you_face;
  s[0].held = 0;
  return true;
}
// From the studio back to the world where you stood: no run, the follow camera at once.
e2c_back :: (s: [] E2) {
  c := s[0].cz[..];
  c[0].walking = true; c[0].handed = true; c[0].changing = false; c[0].run_t = f32(E2C_SWING + E2C_RUN + E2C_EASE);
  s[0].you_face = c[0].back_face; s[0].reseat = true;
  s[0].orbit = figs.verse_orbit_start(figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), c[0].back_face);
}
// Esc in the world opens the menu, Esc again (or Back to the game) shuts it; Enter takes Change character.
e2c_menu_key :: (s: [] E2, key: int) -> bool {
  c := s[0].cz[..];
  if !s[0].placed || e2c_creating(s) || e2c_running(s) { c[0].menu = false; return false; }
  if key == E2C_ESCAPE { c[0].menu = !c[0].menu; s[0].held = 0; return true; }
  if !c[0].menu { return false; }
  if key == E2C_ENTER { _ := e2c_change_character(s); }
  return true;   // the menu takes every key while it shows
}
E2C_MENU_W :: 260.0; E2C_MENU_H :: 38.0;
e2c_menu_layout :: (s: [] E2) {
  c := s[0].cz[..]; k := s[0].k; w := s[0].width; h := s[0].height;
  x0 := w * 0.5 - f32(E2C_MENU_W) * 0.5 * k; y0 := h * 0.42;
  for i: 0..<2 { y := y0 + f32(i) * (f32(E2C_MENU_H) + 10) * k; c[0].menu_box[i] = cc.Box.{x0 = x0, y0 = y, x1 = x0 + f32(E2C_MENU_W) * k, y1 = y + f32(E2C_MENU_H) * k}; }
}
e2c_menu_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  c := s[0].cz[0];
  if !c.menu { return at; }
  e2c_menu_layout(s);
  k := s[0].k; gold := e2c_ink(k, 0.83, 0.69, 0.43, 1); dim := e2c_ink(k, 0.6, 0.6, 0.58, 1);
  able := e2k_bearing(s).pose != DeedPose.down;
  n := at;
  for i: 0..<2 {
    b := s[0].cz[0].menu_box[i]; ink := ifx i == 0 && !able then dim else gold;
    n = cc.line(out, n, b.x0, b.y1, b.x1, b.y1, k, ink.red, ink.green, ink.blue);
    n = cc.text(out, n, ifx i == 0 then "Change character" else "Back to the game", b.x0 + 12 * k, b.y0 + 24 * k, 12 * k, ink);
  }
  return n;
}
e2c_menu_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  c := s[0].cz[..];
  if !c[0].menu { return false; }
  e2c_menu_layout(s);
  if phase == 2 {
    if e2c_inside(c[0].menu_box[0], x, y) { _ := e2c_change_character(s); }
    else if e2c_inside(c[0].menu_box[1], x, y) { c[0].menu = false; }
  }
  return true;
}
// Out of the studio: you turn from facing the camera to the path as the run starts.
e2c_walk :: (s: [] E2) {
  c := s[0].cz[..];
  if c[0].walking { return; }
  c[0].walking = true; c[0].run_t = 0; c[0].handed = false; c[0].cut[0] = figs.cam_cut_enter(c[0].studio, s[0].orbit, 0, 0, figs.CamOutcome.retain); c[0].cut[0].hand = E2C_EASE; c[0].address = !s[0].play;
  c[0].dragging = false; c[0].down = -1;
  s[0].you_face = s[0].creator[0].yaw; s[0].reseat = true;   // the controller takes you as the studio drew you
  heading := e2_auto_heading(s[0].you_x, s[0].you_z);
  s[0].orbit = figs.verse_orbit_start(figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), heading);
}
// Any key or click while it plays: on to the ease into the follow camera.
e2c_skip :: (s: [] E2) { c := s[0].cz[..]; if e2c_running(s) && c[0].run_t < f32(E2C_SWING + E2C_RUN) { c[0].run_t = f32(E2C_SWING + E2C_RUN); } }
// This frame's action, when the slot is free: the record to keep, then the address.
e2c_action :: (s: [] E2) {
  c := s[0].cz[..];
  if !c[0].on || s[0].action != 0 { return; }
  if c[0].request {
    for i: 0..<c[0].n { s[0].outbox[i] = c[0].bytes[i]; }
    s[0].out_n = c[0].n; s[0].action = E2C_SAVE; c[0].request = false; return;
  }
  if c[0].address {
    path := "/worlds/everglade2";
    for i: 0..<path.count { s[0].outbox[i] = path[i]; }
    s[0].out_n = path.count; s[0].action = E2C_ADDRESS; c[0].address = false;
  }
}
#test "create: USE IN EVERGLADE keeps the record with its class, then runs and says Everglade II's address" #steps 2000000000 {
  s: [1] E2;
  e2_message(s[..], E2_HOST_PAGE, "url=http://127.0.0.1/worlds/character-creator\nnow=1000");
  #assert e2c_creating(s[..]) && s[0].creator[0].configured && s[0].creator[0].klass == E2C_DRUID && e2c_value(s[..], E2C_CLASS) == "DRUID";
  e2c_change(s[..], 0, 1); e2c_change(s[..], 12, 3); e2c_change(s[..], E2C_CLASS, -1);
  #assert s[0].creator[0].female && s[0].creator[0].eye_color == 3 && e2c_value(s[..], E2C_CLASS) == "CLERIC";
  // the studio holds you still: no keys reach the walk
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0;
  e2c_request(s[..], true); e2c_action(s[..]);
  #assert s[0].action == E2C_SAVE && s[0].out_n == 57 && s[0].outbox[2] == '3';
  b: [E2C_RECORD] u8; for i: 0..<57 { b[i] = s[0].outbox[i]; }
  s[0].action = 0;
  e2_message(s[..], E2C_KEPT, cast(string) b[0..<57]);
  #assert !e2c_creating(s[..]) && e2c_running(s[..]) && s[0].reseat;
  e2c_action(s[..]);
  #assert s[0].action == E2C_ADDRESS && cast(string) s[0].outbox[0..<s[0].out_n] == "/worlds/everglade2";
}
#test "create: the record kept is the one Everglade II restores on its own page, class and all" #steps 1000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  e2c_change(s[..], 0, 1); e2c_change(s[..], 12, 3); e2c_change(s[..], E2C_CLASS, -1);
  b: [E2C_RECORD] u8; n := cc.save(s[0].creator[0], b[..]); #assert n == 57;
  t: [1] E2; e2_message(t[..], 16, cast(string) b[0..<n]);
  #assert t[0].creator[0].female && t[0].creator[0].eye_color == 3 && t[0].creator[0].klass == 2 && e2c_level_of(t[..]) == 1;
}
#test "create: the LEVEL row steps 1 to 6 round, and the record keeps it for Everglade II (#13046)" #steps 1000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  #assert e2c_value(s[..], E2C_LEVEL) == "1";
  e2c_change(s[..], E2C_LEVEL, -1); #assert e2c_value(s[..], E2C_LEVEL) == "6" && s[0].creator[0].focused == E2C_LEVEL;
  e2c_change(s[..], E2C_LEVEL, 1); e2c_change(s[..], E2C_LEVEL, 1); e2c_change(s[..], E2C_LEVEL, 1); #assert e2c_level_of(s[..]) == 3;
  // a click on its right half steps it up
  e2c_layout(s[..], 1440, 900, 1); b := s[0].cz[0].boxes[E2C_LEVEL_BOX];
  #assert e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 0, 0, 7) && e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 2, 0, 7) && e2c_level_of(s[..]) == 4;
  // Tab: CLASS, then LEVEL, then the wardrobe
  s[0].creator[0].focused = E2C_CLASS; #assert e2c_key(s[..], -15) && s[0].creator[0].focused == E2C_LEVEL && e2c_key(s[..], -15) && s[0].creator[0].focused == 0;
  r: [E2C_RECORD] u8; n := cc.save(s[0].creator[0], r[..]); #assert n == 58 && r[2] == '4' && r[57] == '4';
  t: [1] E2; e2_message(t[..], 16, cast(string) r[0..<n]); #assert e2c_level_of(t[..]) == 4 && t[0].creator[0].klass == E2C_DRUID;
}
#test "create: a refused keep stays in the studio, and Everglade II's own page is not the studio" #steps 1000000000 {
  u: [1] E2; e2_message(u[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  e2c_request(u[..], true); e2_message(u[..], E2C_KEPT, "");
  #assert e2c_creating(u[..]) && u[0].cz[0].failed;
  // Everglade II's own page is not the studio
  v: [1] E2; e2_message(v[..], E2_HOST_PAGE, "url=/worlds/everglade2\n");
  #assert !v[0].cz[0].on && !e2c_creating(v[..]);
}

#test "create: Change character: Esc's menu opens the studio here with your character, and USE IN EVERGLADE brings you back where you stood" #steps 2000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/everglade2\n");
  #assert e2_start(s[..]) && !e2c_creating(s[..]);
  s[0].creator[0].klass = FB_CL_FIGHTER; s[0].creator[0].level = 3; e2k_set_class(s[0].casts[..], FB_CL_FIGHTER, 3);
  x0 := s[0].you_x; z0 := s[0].you_z;
  #assert e2_key(s[..], E2C_ESCAPE, 0) && s[0].cz[0].menu;
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0;          // the menu takes the keys while it shows
  #assert e2_key(s[..], E2C_ESCAPE, 0) && !s[0].cz[0].menu;  // Esc again shuts it
  #assert e2_key(s[..], E2C_ESCAPE, 0) && e2_key(s[..], E2C_ENTER, 0);
  #assert e2c_creating(s[..]) && s[0].cz[0].changing && e2c_class_of(s[..]) == FB_CL_FIGHTER && e2c_level_of(s[..]) == 3;
  e2c_change(s[..], E2C_CLASS, 3);
  #assert e2c_class_of(s[..]) == FB_CL_RANGER;
  e2c_request(s[..], true); e2c_action(s[..]);
  #assert s[0].action == E2C_SAVE;
  b: [E2C_RECORD] u8; m := s[0].out_n; for i: 0..<m { b[i] = s[0].outbox[i]; }
  s[0].action = 0;
  e2_message(s[..], E2C_KEPT, cast(string) b[0..<m]);
  #assert !e2c_creating(s[..]) && !e2c_running(s[..]) && s[0].you_x == x0 && s[0].you_z == z0 && e2c_class_of(s[..]) == FB_CL_RANGER;
  // with no room the change waits; the room is told once seated (everglade2-net.coax e2n_change)
  #assert !e2n_change(s[0].net[..]);
}
// ---- the layout and the panel
// The title's cap: 22 on a desktop; on a phone 18, or less so it ends 8 px before DRAG: ROTATE.
// ---- the wardrobe's layout. A desktop keeps one framed column at the left and the class pane at
// the right. A phone keeps you in view: held upright, a card at the top (the title, DRAG, SAVE and
// USE IN EVERGLADE) and a sheet at the foot with tabs, the chosen tab's rows and RESET and SURPRISE
// ME; held sideways, the card at the left and the sheet at the right. Every control a finger takes
// is E2C_BUTTON CSS px tall at least, and the edges an iPhone keeps (the status bar, the home
// indicator, the notch held sideways) stay clear. The panels are the realm's HUD style
// (charactercreator.coax eg_tokens, aethyr/ui/hud-style.coax).
E2C_TABS :: 5;
E2C_TAB_BOX :: 21;            // a phone's tabs' boxes, 21 to 25
E2C_TAB_NAMES :: [5] string.["BODY", "FACE", "GEAR", "PARTS", "CLASS"];
E2C_TAB_CLASS :: 4;
// each tab's rows, by box (-1 none): BODY, FACE, GEAR, PARTS, CLASS (the CLASS row, LEVEL, NAME)
E2C_TAB_ROWS :: [20] int.[0, 5, 12, 9, 6, 7, 8, -1, 1, 2, 3, 4, 10, 11, -1, -1, 18, 20, 19, -1];
E2C_SAFE_TOP :: 14.0;         // CSS px: under the status bar
E2C_SAFE_BOTTOM :: 26.0;      // over the home indicator
E2C_SAFE_SIDE :: 44.0;        // held sideways, clear of the notch
E2C_BUTTON :: 44.0;           // a finger's size
E2C_ROW :: 50.0; E2C_ROW_GAP :: 6.0; E2C_PADDING :: 12.0;
// The type, one size a role (CSS px of cap height): the title, a tab's or a button's word, a row's
// caption, a row's value, the arrows.
E2C_TITLE_CAP :: 17.0; E2C_WORD_CAP :: 9.5; E2C_CAPTION_CAP :: 7.5; E2C_VALUE_CAP :: 11.0; E2C_ARROW_CAP :: 15.0;

e2c_title_cap :: (s: [] E2, k: f32) -> f32 {
  c := s[0].cz[0];
  if !c.mobile { return 22 * k; }
  room := c.boxes[15].x0 - 10 * k - (c.card.x0 + f32(E2C_PADDING) * k);
  fit := room / cc.face_width("Character Create", 1, cc.HUD_FACE_TITLE);
  return ifx fit < f32(E2C_TITLE_CAP) * k then fit else f32(E2C_TITLE_CAP) * k;
}
// How wide cc.text sets t at cap (its advances: charactercreator.coax text).
e2c_text_w :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for ch: t { code := int(ch); a := ifx code >= 32 && code <= 126 then int(cc.EG_BODY_WIDTH[code - 32]) else int(cc.EG_BODY_WIDTH[31]); w += f32(a) / f32(cc.EG_FONT_UPM) * em; }
  return w;
}
e2c_box :: (x0: f32, y0: f32, x1: f32, y1: f32) -> cc.Box { return cc.Box.{x0 = x0, y0 = y0, x1 = x1, y1 = y1}; }
e2c_tab_of :: (s: [] E2) -> int { t := s[0].cz[0].tab; return ifx t < 0 then 0 else ifx t >= E2C_TABS then E2C_TABS - 1 else t; }
e2c_layout :: (s: [] E2, w: f32, h: f32, k: f32) {
  c := s[0].cz[..];
  c[0].mobile = w < 840 * k || h < 760 * k;
  for i: 0..<E2C_BOXES { c[0].boxes[i] = cc.Box.{}; }
  c[0].card = cc.Box.{}; c[0].sheet = cc.Box.{};
  if c[0].mobile {
    c[0].wide = w > h;
    bt := f32(E2C_BUTTON) * k; pad := f32(E2C_PADDING) * k; g := 6 * k; step := f32(E2C_ROW + E2C_ROW_GAP) * k;
    drag_w := cc.face_width("ROTATE", f32(E2C_WORD_CAP) * k, cc.HUD_FACE_TITLE) + 32 * k;
    sheet_h := pad + bt + 10 * k + 4 * step - f32(E2C_ROW_GAP) * k + (ifx c[0].wide then 0.0f32 else g + bt) + pad;
    if !c[0].wide {
      top := f32(E2C_SAFE_TOP) * k; x0 := 10 * k; x1 := w - 10 * k;
      c[0].card = e2c_box(x0, top, x1, top + pad + bt + g + bt + pad);
      c[0].boxes[15] = e2c_box(x1 - pad - drag_w, top + pad, x1 - pad, top + pad + bt);
      by := top + pad + bt + g;
      c[0].boxes[16] = e2c_box(x0 + pad, by, w * 0.5 - 3 * k, by + bt);
      c[0].boxes[17] = e2c_box(w * 0.5 + 3 * k, by, x1 - pad, by + bt);
      y1 := h - f32(E2C_SAFE_BOTTOM) * k;
      c[0].sheet = e2c_box(x0, y1 - sheet_h, x1, y1);
    } else {
      side := f32(E2C_SAFE_SIDE) * k; top := 10 * k; cw := 270 * k; sw := 330 * k;
      c[0].card = e2c_box(side, top, side + cw, top + pad + 4 * bt + 3 * g + pad);
      cx0 := side + pad; cx1 := side + cw - pad; y := top + pad;
      c[0].boxes[15] = e2c_box(cx1 - drag_w, y, cx1, y + bt); y += bt + g;
      c[0].boxes[16] = e2c_box(cx0, y, cx1, y + bt); y += bt + g;
      c[0].boxes[17] = e2c_box(cx0, y, cx1, y + bt); y += bt + g;
      c[0].boxes[13] = e2c_box(cx0, y, (cx0 + cx1) * 0.5 - 3 * k, y + bt);
      c[0].boxes[14] = e2c_box((cx0 + cx1) * 0.5 + 3 * k, y, cx1, y + bt);
      c[0].sheet = e2c_box(w - side - sw, top, w - side, top + sheet_h);
    }
    sh := c[0].sheet; ix0 := sh.x0 + pad; ix1 := sh.x1 - pad;
    tw := (ix1 - ix0 + 4 * k) / f32(E2C_TABS);
    for t: 0..<E2C_TABS { c[0].boxes[E2C_TAB_BOX + t] = e2c_box(ix0 + f32(t) * tw, sh.y0 + pad, ix0 + f32(t + 1) * tw - 4 * k, sh.y0 + pad + bt); }
    ry := sh.y0 + pad + bt + 10 * k; tab := e2c_tab_of(s);
    for r: 0..<4 { b := E2C_TAB_ROWS[tab * 4 + r]; if b >= 0 { y := ry + f32(r) * step; c[0].boxes[b] = e2c_box(ix0, y, ix1, y + f32(E2C_ROW) * k); } }
    if !c[0].wide {
      fy := sh.y1 - pad - bt;
      c[0].boxes[13] = e2c_box(ix0, fy, (ix0 + ix1) * 0.5 - 3 * k, fy + bt);
      c[0].boxes[14] = e2c_box((ix0 + ix1) * 0.5 + 3 * k, fy, ix1, fy + bt);
    }
    return;
  }
  // a desktop: NAME and CLASS first in the column, then the wardrobe's fields, then the buttons
  c[0].wide = false;
  c[0].card = e2c_box(16 * k, 20 * k, 348 * k, f32(E2C_PANEL_BOTTOM) * k);
  c[0].boxes[E2C_NAME_BOX] = e2c_box(28 * k, 90 * k, 332 * k, 124 * k);
  c[0].boxes[E2C_CLASS_BOX] = e2c_box(28 * k, 128 * k, 332 * k, 158 * k);
  c[0].boxes[E2C_LEVEL_BOX] = e2c_box(28 * k, 162 * k, 332 * k, 192 * k);
  for i: 0..<E2C_FIELDS { y := (196 + f32(i) * 34) * k; c[0].boxes[i] = e2c_box(28 * k, y, 332 * k, y + 30 * k); }
  c[0].boxes[13] = e2c_box(28 * k, 640 * k, 176 * k, 674 * k);
  c[0].boxes[14] = e2c_box(184 * k, 640 * k, 332 * k, 674 * k);
  c[0].boxes[16] = e2c_box(28 * k, 680 * k, 176 * k, 714 * k);
  c[0].boxes[17] = e2c_box(184 * k, 680 * k, 332 * k, 714 * k);
}
e2c_empty :: (b: cc.Box) -> bool { return !(b.x1 > b.x0); }
#test "create: the wardrobe fits a phone held either way and a desktop, a finger's size, clear of you" {
  s: [1] E2;
  for tab: 0..<E2C_TABS {
    s[0].cz[0].tab = tab;
    e2c_layout(s[..], 390, 844, 1);
    c := s[0].cz[0];
    for i: 0..<E2C_BOXES { b := c.boxes[i]; if e2c_empty(b) { continue; }
      #assert b.x0 >= 10 && b.x1 <= 380 && b.y0 >= f32(E2C_SAFE_TOP) && b.y1 <= 844 - f32(E2C_SAFE_BOTTOM) && b.y1 - b.y0 >= 44;
      // every control is on the card or the sheet
      #assert (b.y0 >= c.card.y0 && b.y1 <= c.card.y1) || (b.y0 >= c.sheet.y0 && b.y1 <= c.sheet.y1); }
    // you stay in view: more than a third of the screen between the card and the sheet
    #assert c.sheet.y0 - c.card.y1 > 844.0 / 3;
    // the tab's rows, and only them
    for r: 0..<4 { b := E2C_TAB_ROWS[tab * 4 + r]; if b >= 0 { #assert !e2c_empty(c.boxes[b]) && c.boxes[b].y1 - c.boxes[b].y0 >= 50; } }
    for i: 0..<E2C_FIELDS { mine := false; for r: 0..<4 { if E2C_TAB_ROWS[tab * 4 + r] == i { mine = true; } } #assert mine == !e2c_empty(c.boxes[i]); }
    for i: 13..<18 { #assert !e2c_empty(c.boxes[i]); }
    // the title stays clear of DRAG and is the title's size
    #assert c.card.x0 + 12 + cc.face_width("Character Create", e2c_title_cap(s[..], 1), cc.HUD_FACE_TITLE) + 8 <= c.boxes[15].x0 && e2c_title_cap(s[..], 1) >= 12;
    // every field is on one tab
    seen: [E2C_FIELDS] int; for q: 0..<20 { b := E2C_TAB_ROWS[q]; if b >= 0 && b < E2C_FIELDS { seen[b] += 1; } } for i: 0..<E2C_FIELDS { #assert seen[i] == 1; }
  }
  // held sideways: the card left, the sheet right, you between, clear of the notch
  s[0].cz[0].tab = 2; e2c_layout(s[..], 844, 390, 1);
  {c := s[0].cz[0];
   for i: 0..<E2C_BOXES { b := c.boxes[i]; if e2c_empty(b) { continue; } #assert b.x0 >= 44 && b.x1 <= 800 && b.y0 >= 8 && b.y1 <= 370 && b.y1 - b.y0 >= 44; }
   #assert c.sheet.x0 - c.card.x1 >= 120 && c.sheet.y1 <= 370 && c.card.y1 <= 370; }
  e2c_layout(s[..], 1440, 900, 1);
  for i: 0..<E2C_BOXES { b := s[0].cz[0].boxes[i]; if e2c_empty(b) { continue; } #assert b.x0 >= 16 && b.x1 <= 350 && b.y0 >= 82 && b.y1 <= f32(E2C_PANEL_BOTTOM); }
  #assert s[0].cz[0].boxes[E2C_CLASS_BOX].y1 + 4 <= s[0].cz[0].boxes[E2C_LEVEL_BOX].y0 && s[0].cz[0].boxes[E2C_LEVEL_BOX].y1 + 4 <= s[0].cz[0].boxes[0].y0;
  for i: 1..<E2C_FIELDS { #assert s[0].cz[0].boxes[i].y0 >= s[0].cz[0].boxes[i - 1].y1 + 4; }
  #assert s[0].cz[0].boxes[12].y1 + 4 <= s[0].cz[0].boxes[13].y0 && s[0].cz[0].boxes[13].y1 + 4 <= s[0].cz[0].boxes[16].y0;
  #assert e2c_empty(s[0].cz[0].boxes[15]) && e2c_empty(s[0].cz[0].boxes[E2C_TAB_BOX]);
}
e2c_ink :: (k: f32, r: f32, g: f32, b: f32, f: f32) -> cc.Ink { i := cc.ink(k, r, g, b); i.sans = true; i.light = i.light * f; i.glow = i.glow * f; return i; }
// The controls' share shown: whole in the studio, fading over the run's first E2C_FADE s.
e2c_shown :: (s: [] E2) -> f32 {
  c := s[0].cz[0];
  if !c.on || c.handed { return 0; }
  if !c.walking { return e2c_arrive_ui(s); }
  return 1 - e2c_ease(c.run_t / f32(E2C_FADE));
}
e2c_hb :: (b: cc.Box) -> cc.HudPrim { return cc.hud_box(b.x0, b.y0, b.x1, b.y1); }
// The arrows' boxes in a row: a finger's size at each end on a phone, small plates either side
// of the value on a desktop.
e2c_arrow :: (s: [] E2, b: cc.Box, right: bool) -> cc.Box {
  k := s[0].k;
  if s[0].cz[0].mobile { m := 3 * k; a := b.y1 - b.y0 - 2 * m; return ifx right then e2c_box(b.x1 - m - a, b.y0 + m, b.x1 - m, b.y1 - m) else e2c_box(b.x0 + m, b.y0 + m, b.x0 + m + a, b.y1 - m); }
  return ifx right then e2c_box(b.x1 - 26 * k, b.y0 + 3 * k, b.x1 - 3 * k, b.y1 - 3 * k) else e2c_box(b.x0 + 109 * k, b.y0 + 3 * k, b.x0 + 132 * k, b.y1 - 3 * k);
}
// Each also puts its box in the layout trace when one is attached (ui, #13076): held by `parent`
// (a trace index, or cc.UIT_NONE), named `name`, or its own words when name is "".
e2c_say :: (ui: [] cc.UitTrace, parent: int, name: string, out: [] f32, n: int, t: string, x: f32, y: f32, cap: f32, role: int, f: f32, k: f32, centre: bool) -> int {
  return cc.hud_say_ui(ui, parent, name, out, n, t, x, y, cap, cc.hud_text(cc.eg_tokens(), role), f, k, centre);
}
e2c_say_ink :: (ui: [] cc.UitTrace, parent: int, name: string, out: [] f32, n: int, t: string, x: f32, y: f32, cap: f32, role: int, ink: cc.HudRgba, f: f32, k: f32, centre: bool) -> int {
  r := cc.hud_text(cc.eg_tokens(), role); r.ink = ink;
  return cc.hud_say_ui(ui, parent, name, out, n, t, x, y, cap, r, f, k, centre);
}
// A word centred in a box, on its middle.
e2c_word :: (ui: [] cc.UitTrace, parent: int, name: string, out: [] f32, n: int, t: string, b: cc.Box, cap: f32, role: int, f: f32, k: f32) -> int {
  return e2c_say(ui, parent, name, out, n, t, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, role, f, k, true);
}
e2c_word_ink :: (ui: [] cc.UitTrace, parent: int, name: string, out: [] f32, n: int, t: string, b: cc.Box, cap: f32, ink: cc.HudRgba, f: f32, k: f32) -> int {
  return e2c_say_ink(ui, parent, name, out, n, t, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, cc.HUD_TEXT_TITLE, ink, f, k, true);
}
e2c_swatch :: (s: [] E2, i: int) -> [3] f32 {
  cr := s[0].creator[0];
  return ifx i == 4 then cc.DYES[cr.dye] else ifx i == 5 then cc.SKINS[cr.skin] else ifx i == 12 then cc.EYES[cr.eye_color] else cc.HAIRS[cr.hair_color];
}
e2c_has_swatch :: (i: int) -> bool { return i == 4 || i == 5 || i == 7 || i == 12; }
e2c_save_word :: (s: [] E2) -> string {
  c := s[0].cz[0]; cr := s[0].creator[0];
  return ifx c.pending then "SAVING..." else ifx c.failed then "RETRY SAVE" else ifx c.ok && c.saved_rev == cr.revision then "PLAYER SAVED" else "SAVE PLAYER";
}
// A row's field (0 to 14: the wardrobe's, CLASS, LEVEL) for its box, or -1 (NAME and the rest).
e2c_row_field :: (i: int) -> int { return ifx i < E2C_FIELDS then i else ifx i == E2C_CLASS_BOX then E2C_CLASS else ifx i == E2C_LEVEL_BOX then E2C_LEVEL else -1; }
e2c_row_name :: (f: int, wide: bool) -> string {
  return ifx f == E2C_CLASS then "CLASS" else ifx f == E2C_LEVEL then "LEVEL" else ifx f == 11 && wide then "WEAR PART" else cc.FIELD_NAMES[f];
}
e2c_name_word :: (s: [] E2, buf: [] u8) -> int {
  c := s[0].cz[0]; t := e2c_name_shown(s); m := 0;
  for ch: t { if m < buf.count - 1 { buf[m] = ch; m += 1; } }
  if c.editing && (cast(int)(s[0].clock * 2) % 2 == 0) { buf[m] = '_'; m += 1; }
  return m;
}
// For the layout trace (#13076): whether box b lies in panel p, and box i's name.
e2c_holds :: (p: cc.Box, b: cc.Box) -> bool { return !e2c_empty(p) && b.x0 >= p.x0 - 1 && b.y0 >= p.y0 - 1 && b.x1 <= p.x1 + 1 && b.y1 <= p.y1 + 1; }
e2c_box_name :: (s: [] E2, i: int) -> string {
  if i == E2C_NAME_BOX { return "NAME"; }
  fi := e2c_row_field(i); if fi >= 0 { return e2c_row_name(fi, true); }
  if i >= E2C_TAB_BOX { return E2C_TAB_NAMES[i - E2C_TAB_BOX]; }
  return ifx i == 13 then "RESET" else ifx i == 14 then "SURPRISE ME" else ifx i == 15 then "DRAG" else ifx i == 16 then "SAVE" else "USE";
}
e2c_hud :: (s: [] E2, out: [] f32) -> int {
  w := s[0].width; h := s[0].height; k := s[0].k;
  e2c_layout(s, w, h, k);
  f := e2c_shown(s);
  if f <= 0.003 { return e2c_menu_hud(s, out, 0); }
  c := s[0].cz[0]; cr := s[0].creator[0]; t := cc.eg_tokens(); phone := c.mobile;
  l: [1] cc.HudList;
  // the layout trace, when the overlap check attaches one (#13076): the panels, each box in the panel
  // that holds it, its arrows in it, and (below) each word in its box
  ui := cr.ui; cc.uit_part(ui, "create");
  card_p := cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, c.card.x0, c.card.y0, c.card.x1, c.card.y1, "card");
  sheet_p := ifx phone then cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, c.sheet.x0, c.sheet.y0, c.sheet.x1, c.sheet.y1, "sheet") else cc.UIT_NONE;
  box_at: [E2C_BOXES] int; arrows: [E2C_BOXES * 2] int;
  for i: 0..<E2C_BOXES {
    box_at[i] = cc.UIT_NONE; arrows[i * 2] = cc.UIT_NONE; arrows[i * 2 + 1] = cc.UIT_NONE;
    b := c.boxes[i]; if e2c_empty(b) || !cc.uit_on(ui) { continue; }
    fi := e2c_row_field(i);
    up := ifx e2c_holds(c.card, b) then card_p else ifx phone && e2c_holds(c.sheet, b) then sheet_p else cc.UIT_NONE;
    box_at[i] = cc.uit_put(ui, up, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, e2c_box_name(s, i));
    if fi >= 0 {
      nm: [48] u8; a := e2c_arrow(s, b, false); z := e2c_arrow(s, b, true);
      arrows[i * 2] = cc.uit_put(ui, box_at[i], cc.UIT_BUTTON, a.x0, a.y0, a.x1, a.y1, cc.uit_join(nm[..], e2c_box_name(s, i), "<"));
      arrows[i * 2 + 1] = cc.uit_put(ui, box_at[i], cc.UIT_BUTTON, z.x0, z.y0, z.x1, z.y1, cc.uit_join(nm[..], e2c_box_name(s, i), ">"));
    }
  }
  // ---- the frames: panels, wells for the rows, the buttons
  cc.hud_panel(l[..], t, e2c_hb(c.card), k);
  if phone { cc.hud_panel(l[..], t, e2c_hb(c.sheet), k); }
  else { p := e2c_pane(s, w, h, k); if !e2c_empty(p.a) { cc.hud_panel(l[..], t, e2c_hb(p.a), k); } }
  for i: 0..<E2C_BOXES {
    b := c.boxes[i]; if e2c_empty(b) { continue; }
    fi := e2c_row_field(i);
    if fi >= 0 {
      lit := cr.focused == fi && !phone;
      if phone { cc.hud_well(l[..], t, e2c_hb(b), k, false); }
      else { cc.hud_well(l[..], t, cc.hud_box(b.x0 + 106 * k, b.y0, b.x1, b.y1), k, lit); }
      cc.hud_button(l[..], t, e2c_hb(e2c_arrow(s, b, false)), k, false); cc.hud_button(l[..], t, e2c_hb(e2c_arrow(s, b, true)), k, false);
      if e2c_has_swatch(fi) {
        rgb := e2c_swatch(s, fi); r := e2c_arrow(s, b, true); z := (ifx phone then 9.0f32 else 6.0f32) * k; cx := r.x0 - z - 8 * k; cy := (b.y0 + b.y1) * 0.5;
        cc.hud_fill(l[..], cc.hud_box(cx - z, cy - z, cx + z, cy + z), 3 * k, cc.hud_rgba(rgb[0], rgb[1], rgb[2], 1), cc.hud_rgba(rgb[0] * 0.8, rgb[1] * 0.8, rgb[2] * 0.8, 1));
        cc.hud_ring(l[..], cc.hud_box(cx - z, cy - z, cx + z, cy + z), 3 * k, 1.2 * k, t.trim, cc.hud_mix(t.trim, t.frame_mid, 0.5));
      }
    } else if i == E2C_NAME_BOX {
      cc.hud_well(l[..], t, ifx phone then e2c_hb(b) else cc.hud_box(b.x0 + 106 * k, b.y0, b.x1, b.y1), k, c.editing);
    } else if i >= E2C_TAB_BOX {
      cc.hud_button(l[..], t, e2c_hb(b), k, i - E2C_TAB_BOX == e2c_tab_of(s));
    } else {
      cc.hud_button(l[..], t, e2c_hb(b), k, (i == 15 && cr.pan_mode) || i == 17);
    }
  }
  if !phone { cc.hud_line(l[..], 30 * k, 76 * k, 334 * k, 76 * k, 1 * k, cc.hud_fade(t.trim, 0.8)); }
  if phone && e2c_tab_of(s) == E2C_TAB_CLASS { _ := e2c_class_card(s, l[..], out, 0, f, false, cc.UIT_NONE); }
  for i: 0..<l[0].n { l[0].p[i].top.a *= f; l[0].p[i].bottom.a *= f; }
  n := cc.hud_emit(out, 0, l[..]);
  // ---- the words
  title_cap := e2c_title_cap(s, k);
  tx := ifx phone then c.card.x0 + f32(E2C_PADDING) * k + 2 * k else 30 * k;
  ty := ifx phone then (c.boxes[15].y0 + c.boxes[15].y1) * 0.5 + title_cap * 0.5 else 60 * k;
  n = e2c_say(ui, card_p, "title", out, n, "Character Create", tx, ty, title_cap, cc.HUD_TEXT_TITLE, f, k, false);
  word := f32(E2C_WORD_CAP) * k; caption := f32(E2C_CAPTION_CAP) * k; vcap := f32(E2C_VALUE_CAP) * k;
  for i: 0..<E2C_BOXES {
    b := c.boxes[i]; if e2c_empty(b) { continue; }
    fi := e2c_row_field(i);
    if fi >= 0 || i == E2C_NAME_BOX {
      label := ifx i == E2C_NAME_BOX then "NAME" else e2c_row_name(fi, !phone);
      v: [NET_NAME + 2] u8; vt := ifx fi >= 0 then e2c_value(s, fi) else "";
      said := i == E2C_NAME_BOX && c.said_n > 0 && !c.editing;
      if i == E2C_NAME_BOX { m := e2c_name_word(s, v[..]); vt = ifx said then cast(string) c.said[0..<c.said_n] else ifx m == 0 then "TAP TO TYPE A NAME" else cast(string) v[0..<m]; }
      ink := ifx said then t.bad else ifx i == E2C_NAME_BOX && (e2c_name_shown(s).count == 0 || c.naming) && !c.editing then t.text_dim else t.text;
      if phone {
        mx := (b.x0 + b.x1) * 0.5;
        nm: [48] u8; vn: [48] u8;
        n = e2c_say(ui, box_at[i], cc.uit_join(nm[..], label, "label"), out, n, label, mx, b.y0 + 6 * k + caption, caption, cc.HUD_TEXT_LABEL, f, k, true);
        // the value, as wide as the row leaves it between the arrows (and the swatch)
        room := b.x1 - b.x0 - 2 * (b.y1 - b.y0) - (ifx fi >= 0 && e2c_has_swatch(fi) then 44.0f32 * k else 0.0f32);
        cap := vcap; vw := cc.face_width(vt, cap, cc.HUD_FACE_BODY); if vw > room && vw > 0 { cap = cap * room / vw; }
        n = e2c_say_ink(ui, box_at[i], cc.uit_join(vn[..], label, "value"), out, n, vt, mx, b.y1 - 9 * k, cap, cc.HUD_TEXT_NUMBER, ink, f, k, true);
      } else {
        nm: [48] u8; vn: [48] u8;
        n = e2c_say(ui, box_at[i], cc.uit_join(nm[..], label, "label"), out, n, label, b.x0, (b.y0 + b.y1) * 0.5 + caption * 0.5, caption, cc.HUD_TEXT_LABEL, f, k, false);
        x0 := ifx fi >= 0 then b.x0 + 140 * k else b.x0 + 116 * k; room := b.x1 - 30 * k - x0 - (ifx fi >= 0 && e2c_has_swatch(fi) then 24.0f32 * k else 0.0f32);
        cap := 9.5 * k; vw := cc.face_width(vt, cap, cc.HUD_FACE_BODY); if vw > room && vw > 0 { cap = cap * room / vw; }
        n = e2c_say_ink(ui, box_at[i], cc.uit_join(vn[..], label, "value"), out, n, vt, x0, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, cc.HUD_TEXT_NUMBER, ink, f, k, false);
      }
      if fi >= 0 {
        acap := ifx phone then f32(E2C_ARROW_CAP) * k else 10.0f32 * k;
        n = e2c_word(ui, arrows[i * 2], "<", out, n, "<", e2c_arrow(s, b, false), acap, cc.HUD_TEXT_TITLE, f, k);
        n = e2c_word(ui, arrows[i * 2 + 1], ">", out, n, ">", e2c_arrow(s, b, true), acap, cc.HUD_TEXT_TITLE, f, k);
      }
      continue;
    }
    if i >= E2C_TAB_BOX { on := i - E2C_TAB_BOX == e2c_tab_of(s); n = e2c_word_ink(ui, box_at[i], "", out, n, E2C_TAB_NAMES[i - E2C_TAB_BOX], b, word, ifx on then t.title else t.text_dim, f, k); continue; }
    lab := ifx i == 13 then "RESET" else ifx i == 14 then "SURPRISE ME" else ifx i == 15 then (ifx cr.pan_mode then (ifx phone then "PAN" else "DRAG: PAN") else (ifx phone then "ROTATE" else "DRAG: ROTATE")) else ifx i == 16 then e2c_save_word(s) else "USE IN EVERGLADE";
    n = e2c_word_ink(ui, box_at[i], "", out, n, lab, b, word, ifx i == 17 || (i == 15 && cr.pan_mode) then t.title else t.text, f, k);
  }
  if phone && e2c_tab_of(s) == E2C_TAB_CLASS { n = e2c_class_card(s, l[..], out, n, f, true, sheet_p); }
  if !phone { n = e2c_say(ui, cc.UIT_NONE, "HINT", out, n, "DRAG: ROTATE / P: PAN / SCROLL: ZOOM", w * 0.5, h - 77 * k, 8 * k, cc.HUD_TEXT_LABEL, f, k, true); }
  if !phone { n = e2c_pane_draw(s, out, n, f); }
  return n;
}
// A phone's CLASS tab, under its rows: slot 1's picture, its name, the class's hit die and primary
// ability (the desktop's pane says it all). frames false adds its well to l; true draws its words.
// up: the panel that holds it in the layout trace (#13076), or cc.UIT_NONE.
e2c_class_card :: (s: [] E2, l: [] cc.HudList, out: [] f32, at: int, f: f32, words: bool, up: int) -> int {
  c := s[0].cz[0]; k := s[0].k; cl := e2c_class_of(s); t := cc.eg_tokens();
  last := c.boxes[E2C_NAME_BOX]; if e2c_empty(last) { return at; }
  b := e2c_box(last.x0, last.y1 + f32(E2C_ROW_GAP) * k, last.x1, last.y1 + f32(E2C_ROW_GAP + E2C_ROW) * k);
  icon := b.y1 - b.y0 - 8 * k;
  if !words { cc.hud_well(l[..], t, e2c_hb(b), k, false); cc.hud_slot(l[..], t, cc.hud_box(b.x0 + 4 * k, b.y0 + 4 * k, b.x0 + 4 * k + icon, b.y1 - 4 * k), k, true); return at; }
  if f > 0.5 { e2c_media(s, "over", E2C_ICON[cl], ifx icon > 48 then "-72.jpg" else "-48.jpg", b.x0 + 4 * k, b.y0 + 4 * k, b.x0 + 4 * k + icon, b.y1 - 4 * k); }
  x := b.x0 + icon + 16 * k; n := at;
  n = e2c_say(s[0].creator[0].ui, up, "class card name", out, n, E2C_ABILITY[cl], x, b.y0 + 21 * k, f32(E2C_VALUE_CAP) * k, cc.HUD_TEXT_NAME, f, k, false);
  line: [96] u8; m := e2c_put(line[..], 0, "HIT DIE "); m = e2c_put(line[..], m, E2C_DIE[cl]); m = e2c_put(line[..], m, "  ·  "); m = e2c_put(line[..], m, E2C_PRIMARY[cl]);
  cap := f32(E2C_CAPTION_CAP) * k; room := b.x1 - 8 * k - x; lw := cc.face_width(cast(string) line[0..<m], cap, cc.HUD_FACE_BODY); if lw > room && lw > 0 { cap = cap * room / lw; }
  return e2c_say(s[0].creator[0].ui, up, "class card line", out, n, cast(string) line[0..<m], x, b.y1 - 12 * k, cap, cc.HUD_TEXT_LABEL, f, k, false);
}

// ---- NAME: typed into the host's keyboard field over its box (a phone's keyboard comes up), checked
// for the API's shape at once (player-name.coax), then POSTed (everglade2-net.coax e2n_rename) before the
// seat ticket is asked, so the room's row for you, and the name over your head, carry it.
E2C_BACKSPACE :: -3; E2C_ENTER :: -2; E2C_ESCAPE :: -1;
e2c_name_shown :: (s: [] E2) -> string {
  c := s[0].cz[0..<1];
  if c[0].editing || c[0].naming { return cast(string) c[0].draft[0..<c[0].draft_n]; }
  return cast(string) s[0].net[0].name[0..<s[0].net[0].name_n];
}
e2c_name_edit :: (s: [] E2) {
  c := s[0].cz[..];
  if c[0].naming { return; }
  t := cast(string) s[0].net[0].name[0..<s[0].net[0].name_n];
  c[0].draft_n = 0; for ch: t { if c[0].draft_n < PN_MAX { c[0].draft[c[0].draft_n] = ch; c[0].draft_n += 1; } }
  c[0].editing = true; c[0].said_n = 0;
}
e2c_name_type :: (s: [] E2, t: string) {
  c := s[0].cz[..];
  if !c[0].editing { return; }
  for ch: t { if ch >= 32 && ch <= 126 && c[0].draft_n < PN_MAX { c[0].draft[c[0].draft_n] = ch; c[0].draft_n += 1; } }
}
e2c_name_key :: (s: [] E2, key: int) {
  c := s[0].cz[..];
  if key == E2C_BACKSPACE { if c[0].draft_n > 0 { c[0].draft_n -= 1; } return; }
  if key == E2C_ENTER { e2c_name_done(s); return; }
  if key == E2C_ESCAPE { c[0].editing = false; return; }
  if key >= 32 && key <= 126 { b: [1] u8; b[0] = cast(u8) key; e2c_name_type(s, cast(string) b[..]); }
}
e2c_name_say :: (s: [] E2, t: string) {
  c := s[0].cz[..]; c[0].said_n = 0;
  for ch: t { if c[0].said_n < 64 { c[0].said[c[0].said_n] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; c[0].said_n += 1; } }
}
// Done typing: the same name, or none, changes nothing; a shape the API refuses is said at once;
// else it goes to the API.
e2c_name_done :: (s: [] E2) {
  c := s[0].cz[..];
  if !c[0].editing { return; }
  c[0].editing = false;
  a := 0; z := c[0].draft_n;
  while a < z && c[0].draft[a] == ' ' { a += 1; } while z > a && c[0].draft[z - 1] == ' ' { z -= 1; }
  want := cast(string) c[0].draft[a..<z];
  if want.count == 0 || want == cast(string) s[0].net[0].name[0..<s[0].net[0].name_n] { return; }
  why := pn_why(want);
  if why != PN_OK { e2c_name_say(s, PN_SAY[why]); return; }
  m := 0; for ch: want { c[0].draft[m] = ch; m += 1; } c[0].draft_n = m;
  if e2n_rename(s[0].net[..], cast(string) c[0].draft[0..<m]) { c[0].naming = true; }
}
// The API's answer: the name everyone now sees, or its reason.
e2c_named :: (s: [] E2, answer: string) {
  r := e2n_named(s[0].net[..], answer);
  s[0].cz[0].naming = false;
  if !r.ok { e2c_name_say(s, ifx r.said.count > 0 then r.said else "PICK ANOTHER NAME"); }
}
#test "create: NAME takes typed keys, says a refused shape at once, and sends a good one before the ticket" #steps 2000000000 {
  s: [1] E2;
  e2_message(s[..], E2_HOST_PAGE, "url=http://127.0.0.1:8946/worlds/character-creator?relay=ws://localhost:8945\nplayer=p-1\nnow=1000");
  e2c_layout(s[..], 1440, 900, 1);
  b := s[0].cz[0].boxes[E2C_NAME_BOX]; x := (b.x0 + b.x1) / 2; y := (b.y0 + b.y1) / 2;
  #assert e2c_pointer(s[..], x, y, 0, 1) && e2c_pointer(s[..], x, y, 2, 1) && s[0].cz[0].editing;
  // the walk's keys are the name's while it takes them
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0 && s[0].cz[0].draft_n == 1;
  #assert e2_key(s[..], E2C_BACKSPACE, 0) && s[0].cz[0].draft_n == 0;
  e2_message(s[..], 1, "Al"); _ := e2_key(s[..], E2C_ENTER, 0);
  #assert !s[0].cz[0].editing && cast(string) s[0].cz[0].said[0..<s[0].cz[0].said_n] == PN_SAY[PN_SHORT] && s[0].net[0].pipe[0].n == 0;
  _ = e2c_pointer(s[..], x, y, 0, 1); _ = e2c_pointer(s[..], x, y, 2, 1);
  e2_message(s[..], 1, "http x"); _ = e2_key(s[..], E2C_ENTER, 0);
  #assert cast(string) s[0].cz[0].said[0..<s[0].cz[0].said_n] == PN_SAY[PN_ADDRESS] && !s[0].cz[0].naming && s[0].net[0].pipe[0].n == 0;
  // a good name: to the API, and the ticket waits for its answer
  _ = e2c_pointer(s[..], x, y, 0, 1); _ = e2c_pointer(s[..], x, y, 2, 1);
  #assert s[0].cz[0].said_n == 0 && s[0].cz[0].editing;
  for q: 0..<10 { _ = e2_key(s[..], E2C_BACKSPACE, 0); }
  _ = e2_key(s[..], 'A', 0); e2_message(s[..], 1, "sh Wood "); _ = e2_key(s[..], E2C_ENTER, 0);
  #assert s[0].cz[0].naming && s[0].net[0].naming && pipe_bytes(s[0].net[0].pipe[..], 0) == "/api/playtest/player/name\n{\"name\":\"Ash Wood\"}";
  e2c_named(s[..], "200\n{\"name\":\"Ash Wood\"}");
  #assert !s[0].cz[0].naming && e2c_name_shown(s[..]) == "Ash Wood" && s[0].cz[0].said_n == 0;
  // the API's refusal is said, and the name stays
  _ = e2c_pointer(s[..], x, y, 0, 1); _ = e2c_pointer(s[..], x, y, 2, 1); e2_message(s[..], 1, "x"); _ = e2_key(s[..], E2C_ENTER, 0);
  e2c_named(s[..], "400\n{\"error\":\"pick another name: 3 to 20 letters\"}");
  #assert e2c_name_shown(s[..]) == "Ash Wood" && cast(string) s[0].cz[0].said[0..<4] == "PICK";
}

// ---- input: in the studio the keys and the pointer are the wardrobe's
e2c_inside :: (b: cc.Box, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
e2c_pointer :: (s: [] E2, x: f32, y: f32, phase: int, id: int) -> bool {
  if s[0].cz[0].arriving { if phase == 0 { e2c_arrive_skip(s); } return true; }   // a click skips the arrival
  if e2c_running(s) { if phase == 0 { e2c_skip(s); } return true; }   // a click skips the run
  if e2c_menu_pointer(s, x, y, phase) { return true; }
  if !e2c_creating(s) { return false; }
  c := s[0].cz[..]; cr := s[0].creator[..]; k := s[0].k;
  if phase == 0 {
    c[0].said_n = 0;
    if c[0].editing && !e2c_inside(c[0].boxes[E2C_NAME_BOX], x, y) { e2c_name_done(s); }
    for i: 0..<E2C_BOXES { if e2c_inside(c[0].boxes[i], x, y) { c[0].down = i; c[0].drag_id = id; return true; } }
    c[0].drag_pan = cr[0].pan_mode; c[0].dragging = true; c[0].drag_id = id; c[0].dx = x; c[0].dy = y;
    return true;
  }
  if id != c[0].drag_id { return true; }
  if phase == 1 && c[0].dragging {
    if c[0].drag_pan {
      units := cr[0].dist / (ifx s[0].focal > 1 then s[0].focal else 1.0f32);
      cr[0].pan_x = e2c_clamp(cr[0].pan_x - (x - c[0].dx) * units, -2, 2);
      cr[0].pan_y = e2c_clamp(cr[0].pan_y + (y - c[0].dy) * units, -2, 2);
    } else {
      cr[0].yaw += (x - c[0].dx) * 0.008 / k;
      cr[0].pitch = e2c_clamp(cr[0].pitch + (y - c[0].dy) * 0.003 / k, -0.2, 0.6);
    }
    c[0].dx = x; c[0].dy = y;
    return true;
  }
  if phase == 2 || phase == 3 {
    i := c[0].down; c[0].down = -1; c[0].dragging = false;
    if phase == 2 && i >= 0 && e2c_inside(c[0].boxes[i], x, y) {
      bx := c[0].boxes[i];
      left := ifx c[0].mobile then x < (bx.x0 + bx.x1) * 0.5 else x < bx.x0 + 136 * k;
      if i >= E2C_TAB_BOX { c[0].tab = i - E2C_TAB_BOX; }
      else if i == E2C_NAME_BOX { e2c_name_edit(s); }
      else if i < E2C_FIELDS { e2c_change(s, i, ifx left then -1 else 1); }
      else if i == E2C_CLASS_BOX { e2c_change(s, E2C_CLASS, ifx left then -1 else 1); }
      else if i == E2C_LEVEL_BOX { e2c_change(s, E2C_LEVEL, ifx left then -1 else 1); }
      else if i == 13 { cc.reset(cr); }
      else if i == 14 { cc.surprise(cr); }
      else if i == 15 { cr[0].pan_mode = !cr[0].pan_mode; }
      else { e2c_request(s, i == 17); }
    }
  }
  return true;
}
// While the studio or the run is on, every key is its own: the walk's keys wait for the hand-off.
e2c_key :: (s: [] E2, key: int) -> bool {
  if s[0].cz[0].arriving { e2c_arrive_skip(s); return true; }
  if e2c_running(s) { e2c_skip(s); return true; }   // any key skips the run, and is spent on it
  if !e2c_creating(s) { return e2c_menu_key(s, key); }
  if s[0].cz[0].editing { e2c_name_key(s, key); return true; }
  cr := s[0].creator[..];
  if key == 'p' || key == 'P' { cr[0].pan_mode = !cr[0].pan_mode; return true; }
  // Tab: the CLASS row, then the wardrobe's fields in turn
  if key == -15 { f := cr[0].focused; cr[0].focused = ifx f == E2C_CLASS then E2C_LEVEL else ifx f == E2C_LEVEL then 0 else ifx f + 1 >= E2C_FIELDS then E2C_CLASS else f + 1; return true; }
  if key == KEY_LEFT || key == KEY_RIGHT { e2c_change(s, cr[0].focused, ifx key == KEY_LEFT then -1 else 1); return true; }
  if key == ' ' { e2c_change(s, 9, 1); return true; }
  return true;
}
e2c_wheel :: (s: [] E2, dy: f32) -> bool {
  if s[0].cz[0].arriving { e2c_arrive_skip(s); return true; }
  if e2c_running(s) { return true; }
  if !e2c_creating(s) { return false; }
  d := e2c_clamp(dy, -400, 400);
  s[0].creator[0].dist = e2c_clamp(s[0].creator[0].dist + d * 0.003, 0.65, 6);
  return true;
}
#test "create: the studio's pointer turns, zooms and changes the character, and the class row steps" #steps 1000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  s[0].width = 1440; s[0].height = 900; s[0].k = 1; e2c_layout(s[..], 1440, 900, 1);
  yaw := s[0].creator[0].yaw;
  #assert e2_pointer(s[..], 900, 400, 0, 0, 3) && e2_pointer(s[..], 980, 400, 1, 0, 3) && e2_pointer(s[..], 980, 400, 2, 0, 3);
  #assert s[0].creator[0].yaw > yaw && !s[0].dragging;
  b := s[0].cz[0].boxes[1]; outfit := s[0].creator[0].outfit;
  #assert e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 0, 0, 4) && e2_pointer(s[..], b.x1 - 10, b.y0 + 10, 2, 0, 4);
  #assert s[0].creator[0].outfit == (outfit + 1) % 4;
  c := s[0].cz[0].boxes[E2C_CLASS_BOX];
  #assert e2_pointer(s[..], c.x1 - 10, c.y0 + 10, 0, 0, 5) && e2_pointer(s[..], c.x1 - 10, c.y0 + 10, 2, 0, 5) && s[0].creator[0].klass == E2C_DRUID + 1;
  for i: 0..<8 { _ := e2_wheel(s[..], -400); }
  #assert s[0].creator[0].dist == 0.65;
}

// ---- the camera, your pose
// Character Create's cameras are Aethyr's (aethyr/cam/studio.coax): the studio, Experimental's too,
// from your feet, held 0.28 m over this land; then after USE IN EVERGLADE the run (from the studio's
// shot it swings round behind you over E2C_SWING s, keeps its own track through the run, held 0.5 m
// over the land, then eases into the follow camera `chase` over E2C_EASE s, the orbit turned first
// to look the way it looks, so the hand-off has no jump), then the follow camera alone.
e2c_view :: (s: [] E2, feet: figs.Point, chase: figs.Shot, dt: f32) -> figs.Shot {
  c := s[0].cz[..];
  if !c[0].on || c[0].handed { return chase; }
  if !c[0].walking {
    cr := s[0].creator[0];
    st := figs.cam_studio(feet, cr.dist, cr.pitch, cr.pan_x, cr.pan_y);
    c[0].studio = figs.cam_studio_shot(st, e2_height(st.eye.x, st.eye.z) + 0.28);
    return e2c_arrive_shot(s, feet, c[0].studio);
  }
  if dt > 0 && dt < 1 { c[0].run_t += dt; }
  track := figs.cam_run_track(c[0].run_t, c[0].studio, feet, s[0].orbit.yaw, f32(E2C_SWING), f32(E2C_RUN));
  track = figs.cam_hold_eye(track, e2_height(track.eye.x, track.eye.z) + 0.5);
  r := figs.cam_run_show(c[0].cut[..], track, chase, c[0].run_t, f32(E2C_SWING), f32(E2C_RUN), s[0].orbit, s[0].you_face);
  s[0].orbit = r.orbit;
  if r.handed { c[0].handed = true; }   // the follow camera and the keys are yours
  return r.shot;
}
// The studio's lens (figs.cam_gap_lens): on a phone you stand in the gap the wardrobe leaves, easing
// to the follow camera's focal length and centre (cx, cy) as the camera swings behind you.
e2c_view_lens :: (s: [] E2, focal: f32, cx: f32, cy: f32) -> [3] f32 {
  if !s[0].cz[0].on || s[0].cz[0].handed { return [3] f32.[focal, cx, cy]; }
  e2c_layout(s, s[0].width, s[0].height, s[0].k);
  c := s[0].cz[0];
  if !c.mobile { return [3] f32.[focal, cx, cy]; }
  return figs.cam_gap_lens(focal, cx, cy, c.wide, c.card.x1, c.card.y1, c.sheet.x0, c.sheet.y0, ifx c.walking then figs.cam_smooth(c.run_t / f32(E2C_SWING)) else 0.0f32);
}
// Your figure in the studio: the ANIMATION field's clip, turned by the drag (0 faces the camera).
e2c_figure :: (s: [] E2) -> figs.BdAnim {
  c := s[0].creator[0];
  a: figs.BdAnim; a.on = true; a.own = true; a.x = s[0].you_x; a.y = s[0].you_y; a.z = s[0].you_z; a.yaw = c.yaw;
  a.clip = [4] int.[figs.BD_IDLE, figs.BD_WALK, figs.BD_RUN, figs.BD_SPELL][c.pose];
  a.t0 = c.pose_at; a.fade_at = -100; a.phase = (s[0].clock - c.pose_at) / figs.bd_seconds(a.clip);
  if c.pose == 3 { dur := figs.bd_seconds(figs.BD_SPELL); a.t0 = c.pose_at + floor((s[0].clock - c.pose_at) / dur) * dur; }
  return a;
}
#test "create: the studio camera looks at you from the south; after USE the run plays down the path, then hands over" #steps 2000000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  _ := e2_start(s[..]);
  feet := figs.v3(s[0].you_x, s[0].you_y, s[0].you_z);
  sh := e2c_view(s[..], feet, figs.Shot.{}, 0.016);
  #assert sh.eye.z > feet.z + 2 && sh.at.z < sh.eye.z && sh.eye.y > feet.y;
  // the run drives no keys in the studio
  inp := e2_move_in(s[..]); #assert inp.key_y == 0 && inp.key_x == 0;
  studio := s[0].cz[0].studio;
  chase := figs.Shot.{eye = figs.v3(feet.x, feet.y + 2, feet.z + 4), at = figs.v3(feet.x, feet.y + 1, feet.z - 4)};
  e2c_walk(s[..]);
  // the first frame is the studio's shot: no cut
  first := e2c_view(s[..], feet, chase, 0.0001);
  #assert abs(first.eye.x - studio.eye.x) + abs(first.eye.y - studio.eye.y) + abs(first.eye.z - studio.eye.z) < 0.1;
  // the run goes on its own, forward, toward the path (north, -z)
  inp = e2_move_in(s[..]); #assert inp.key_y == 1 && !inp.run && -cos(inp.theta) < -0.5;
  #assert e2_key(s[..], 'w', 0) && s[0].held == 0 && s[0].cz[0].run_t >= f32(E2C_SWING + E2C_RUN) - 0.001;
  // the ease ends on the follow camera, each step a small one
  last := e2c_view(s[..], feet, chase, 0.016);
  for i: 0..<int(f32(E2C_EASE) / 0.016) + 2 {
    st := e2c_view(s[..], feet, chase, 0.016);
    #assert abs(st.eye.x - last.eye.x) + abs(st.eye.y - last.eye.y) + abs(st.eye.z - last.eye.z) < 0.9;
    last = st;
  }
  #assert s[0].cz[0].handed && !e2c_running(s[..]) && last.eye.z == chase.eye.z && e2c_shown(s[..]) == 0;
  inp = e2_move_in(s[..]); #assert inp.key_y == 0;   // the keys are yours
}

// For headless checks (e2_probe 20 to 29): 20 in the studio, 21 walking, 22 the run playing, 23 handed
// over, 24 the wardrobe's revision, 25 the record kept, 26 the outfit, 27 the body (1 female), 28 the
// class, 29 the run's ms.
e2c_probe :: (s: [] E2, f: int) -> int {
  c := s[0].cz[0]; cr := s[0].creator[0];
  if f == 20 { return ifx e2c_creating(s) then 1 else 0; }
  if f == 21 { return ifx c.walking then 1 else 0; }
  if f == 22 { return ifx e2c_running(s) then 1 else 0; }
  if f == 23 { return ifx c.handed then 1 else 0; }
  if f == 24 { return cr.revision; }
  if f == 25 { return ifx c.ok then 1 else 0; }
  if f == 26 { return cr.outfit; }
  if f == 27 { return ifx cr.female then 1 else 0; }
  if f == 28 { return cr.klass; }
  if f == 29 { return cast(int)(c.run_t * 1000); }
  return -1;
}

// ---- the class pane: the CLASS row's class, in words, on its own glass
// On a desktop a panel at the screen's right, clear of you in the middle; on a phone two narrow
// columns in the sky either side of you, between the top band and the wardrobe's. It says what the
// class is and how it plays, its Hit Die and primary ability, its saving throws, its armor and
// weapon training, its level 1 features, and the ability its bar starts with (slot 1, the same as
// Everglade's: everglade-classes.coax CL_ABILITY) with that ability's picture. It changes with the
// row. The facts follow the SRD 5.2.1's classes (core traits and level 1 features); the
// descriptions are ours.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
E2C_CLASS_TITLES :: [12] string.["Barbarian", "Bard", "Cleric", "Druid", "Fighter", "Monk", "Paladin", "Ranger", "Rogue", "Sorcerer", "Warlock", "Wizard"];
E2C_ABOUT :: [12] string.[
  "A fierce warrior fueled by primal power. In battle you enter a Rage that makes you hard to hurt and makes your blows land harder. You fight best up close with heavy weapons.",
  "An inspiring performer whose words and music carry magic. You support your allies with Bardic Inspiration and a broad set of spells, and you cut foes down with mockery.",
  "A priest who channels divine power. You heal and protect your allies and call down radiant light on your foes, armored for the front line.",
  "A keeper of the old ways who draws magic from nature. You strike with starlight and flame, tangle foes in plants, and heal your friends.",
  "A master of weapons and armor. You fight in heavy armor with any weapon, and Second Wind keeps you on your feet when the battle turns.",
  "A martial artist who channels inner focus. You fight unarmored with fast fists and feet, and you strike more than once a turn.",
  "A holy warrior bound by a sacred oath. You fight in heavy armor, heal with Lay On Hands, and smite foes with divine power.",
  "A wanderer of the wild who hunts with skill and magic. You mark your quarry with Hunter's Mark and strike it from afar with a bow.",
  "A skilled trickster who relies on stealth and precision. You strike where a foe is weakest with Sneak Attack and slip out of danger.",
  "A spellcaster whose magic is an inborn gift. Innate Sorcery makes your spells hit harder, and Fire Bolt burns foes from afar.",
  "A wielder of magic granted by a pact with an otherworldly patron. Eldritch Blast is your signature attack, and your Eldritch Invocations shape how you fight.",
  "A scholar of arcane magic with the widest choice of spells. You stay out of reach and blast foes with Fire Bolt while your spellbook grows."];
E2C_DIE :: [12] string.["d12", "d8", "d8", "d8", "d10", "d8", "d10", "d10", "d8", "d6", "d8", "d6"];
E2C_PRIMARY :: [12] string.["Strength", "Charisma", "Wisdom", "Wisdom", "Strength or Dexterity", "Dexterity and Wisdom", "Strength and Charisma",
                            "Dexterity and Wisdom", "Dexterity", "Charisma", "Charisma", "Intelligence"];
E2C_SAVES :: [12] string.["Strength, Constitution", "Dexterity, Charisma", "Wisdom, Charisma", "Intelligence, Wisdom", "Strength, Constitution",
                          "Strength, Dexterity", "Wisdom, Charisma", "Strength, Dexterity", "Dexterity, Intelligence", "Constitution, Charisma",
                          "Wisdom, Charisma", "Intelligence, Wisdom"];
E2C_ARMOR :: [12] string.["Light, Medium, Shields", "Light", "Light, Medium, Shields", "Light, Shields", "Light, Medium, Heavy, Shields", "None",
                          "Light, Medium, Heavy, Shields", "Light, Medium, Shields", "Light", "None", "Light", "None"];
E2C_WEAPONS :: [12] string.["Simple and Martial", "Simple", "Simple", "Simple", "Simple and Martial", "Simple, and Martial with the Light property",
                            "Simple and Martial", "Simple and Martial", "Simple, and Martial with the Finesse or Light property", "Simple", "Simple", "Simple"];
E2C_FEATURES :: [12] string.["Rage, Unarmored Defense, Weapon Mastery", "Bardic Inspiration, Spellcasting", "Spellcasting, Divine Order",
                             "Spellcasting, Druidic, Primal Order", "Fighting Style, Second Wind, Weapon Mastery", "Martial Arts, Unarmored Defense",
                             "Lay On Hands, Spellcasting, Weapon Mastery", "Spellcasting, Favored Enemy, Weapon Mastery",
                             "Expertise, Sneak Attack, Thieves' Cant, Weapon Mastery", "Spellcasting, Innate Sorcery", "Eldritch Invocations, Pact Magic",
                             "Spellcasting, Ritual Adept, Arcane Recovery"];
// Slot 1: its name, its picture (realms/everglade/hotbar, everglade-hotbar.coax CL_HB_NAME) and what it does.
E2C_ABILITY :: [12] string.["Rage", "Vicious Mockery", "Sacred Flame", "Starry Wisp", "Second Wind", "Martial Arts", "Lay On Hands", "Hunter's Mark",
                            "Sneak Attack", "Fire Bolt", "Eldritch Blast", "Fire Bolt"];
E2C_ICON :: [12] string.["cl-rage", "cl-vicious-mockery", "cl-sacred-flame", "cl-starry-wisp", "cl-second-wind", "cl-martial-arts", "cl-lay-on-hands",
                         "cl-hunters-mark", "cl-sneak-attack", "cl-sorcerer-fire-bolt", "cl-eldritch-blast", "cl-wizard-fire-bolt"];
E2C_ICON_URL :: "/worlds/everglade/hotbar/";
E2C_SLOT :: [12] string.[
  "Bonus Action. You resist Bludgeoning, Piercing and Slashing damage and deal extra damage with Strength attacks.",
  "Cantrip. A creature makes a Wisdom save or takes 1d6 Psychic damage and has Disadvantage on its next attack roll.",
  "Cantrip. A creature makes a Dexterity save or takes 1d8 Radiant damage.",
  "Cantrip. A ranged spell attack for 1d8 Radiant damage. The target sheds light and can't be invisible.",
  "Bonus Action. You regain 1d10 plus your Fighter level in Hit Points.",
  "Your Unarmed Strikes use Dexterity and your Martial Arts die, and you can make one as a Bonus Action.",
  "Bonus Action. Touch a creature to restore Hit Points from a pool of five times your Paladin level.",
  "Bonus Action spell. Mark a creature, and your weapon attacks deal it an extra 1d6 Force damage.",
  "Once a turn, 1d6 extra damage when you hit with a Finesse or Ranged weapon and have Advantage.",
  "Cantrip. A ranged spell attack for 1d10 Fire damage.",
  "Cantrip. A beam of crackling energy: a ranged spell attack for 1d10 Force damage.",
  "Cantrip. A ranged spell attack for 1d10 Fire damage."];
E2C_PANE_W :: 330.0;   // the desktop pane's width, CSS px
E2C_PAD :: 14.0;
E2cLines :: struct { n: int; lines: int; }
E2cPane :: struct { a: cc.Box; b: cc.Box; }   // a desktop's one panel (a), or a phone's two columns (a left, b right)

e2c_level_of :: (s: [] E2) -> int { l := s[0].creator[0].level; return ifx l < 1 then 1 else ifx l > E2C_LEVELS then E2C_LEVELS else l; }
e2c_class_of :: (s: [] E2) -> int { k := s[0].creator[0].klass; return ifx k < 0 then E2C_DRUID else ifx k >= E2C_CLASSES then E2C_CLASSES - 1 else k; }
// The width of t at cap, as cc.text sets it.
e2c_width :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for i: 0..<t.count { c := cast(int) t[i]; w += f32(cc.EG_BODY_WIDTH[ifx c >= 32 && c <= 126 then c - 32 else 31]) / f32(cc.EG_FONT_UPM) * em; }
  return w;
}
// t in lines no wider than `wide`, `lh` apart, the first's baseline at y (draw false: only counted).
e2c_set_lines :: (out: [] f32, at: int, t: string, x: f32, y: f32, cap: f32, wide: f32, lh: f32, k: cc.Ink, draw: bool) -> E2cLines {
  n := at; lines := 0; start := 0; last := -1; i := 0;
  while i <= t.count {
    if i == t.count || t[i] == ' ' {
      if e2c_width(t[start..<i], cap) > wide && last > start {
        if draw { n = cc.text(out, n, t[start..<last], x, y + f32(lines) * lh, cap, k); }
        lines += 1; start = last + 1; last = -1;
        continue;
      }
      last = i;
    }
    i += 1;
  }
  if start < t.count { if draw { n = cc.text(out, n, t[start..<t.count], x, y + f32(lines) * lh, cap, k); } lines += 1; }
  return E2cLines.{n = n, lines = lines};
}
// The pane's words for class cl, set from (x, y) in a column `wide` across; part 0 all of it (a
// desktop), on a phone 1 the left column (the class and its traits) and 2 the right (what it is,
// its level 1 features and slot 1). Returns the strokes' end and the height used (device px).
E2cSet :: struct { n: int; h: f32; }
e2c_words :: (s: [] E2, out: [] f32, at: int, cl: int, x: f32, y0: f32, wide: f32, k: f32, part: int, f: f32, draw: bool) -> E2cSet {
  white := e2c_ink(k, 0.91, 0.92, 0.9, f); dim := e2c_ink(k, 0.78, 0.82, 0.8, f);
  gold := e2c_ink(k, 0.83, 0.69, 0.43, f); label := e2c_ink(k, 0.93, 0.88, 0.72, f);
  phone := part != 0;
  body := (ifx phone then 7.0f32 else 9.4f32) * k; lh := (ifx phone then 10.8f32 else 17.0f32) * k; tag := (ifx phone then 5.8f32 else 7.4f32) * k;
  n := at; y := y0; w: E2cLines;
  if part != 2 {
    // the class and its traits
    y += (ifx phone then 16.0f32 else 26.0f32) * k;
    if draw { n = cc.text(out, n, E2C_CLASS_TITLES[cl], x, y, (ifx phone then 13.0f32 else 20.0f32) * k, white); }
    if !phone {
      y += 14 * k; if draw { n = cc.line(out, n, x, y, x + wide, y, k, gold.red * f, gold.green * f, gold.blue * f); }
      y += 20 * k; if draw { n = cc.text(out, n, "LEVEL 1  ·  SRD 5.2.1", x, y, tag, label); }
      y += 22 * k;
      w = e2c_set_lines(out, n, E2C_ABOUT[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh + 8 * k;
    } else { y += 14 * k; }
    names := [5] string.["HIT DIE", "PRIMARY ABILITY", "SAVING THROWS", "ARMOR TRAINING", "WEAPONS"];
    rows := [5] string.[E2C_DIE[cl], E2C_PRIMARY[cl], E2C_SAVES[cl], E2C_ARMOR[cl], E2C_WEAPONS[cl]];
    vx := ifx phone then x else x + 124 * k; vw := ifx phone then wide else wide - 124 * k;
    for r: 0..<5 {
      if draw { n = cc.text(out, n, names[r], x, y, tag, label); }
      if phone { y += 11 * k; }
      w = e2c_set_lines(out, n, rows[r], vx, y, body, vw, lh, white, draw); n = w.n; y += f32(w.lines) * lh + (ifx phone then 3.0f32 else 5.0f32) * k;
    }
  }
  if part != 1 {
    if phone { y += 10 * k; w = e2c_set_lines(out, n, E2C_ABOUT[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh; }
    // the level 1 features, and slot 1 with its picture (a phone has no room for what it does)
    y += 6 * k;
    if draw { n = cc.text(out, n, "LEVEL 1 FEATURES", x, y, tag, label); }
    y += (ifx phone then 10.0f32 else 16.0f32) * k;
    w = e2c_set_lines(out, n, E2C_FEATURES[cl], x, y, body, wide, lh, white, draw); n = w.n; y += f32(w.lines) * lh + (ifx phone then 4.0f32 else 8.0f32) * k;
    if draw { n = cc.text(out, n, "ON YOUR BAR", x, y, tag, label); }
    y += (ifx phone then 5.0f32 else 8.0f32) * k;
    icon := (ifx phone then 28.0f32 else 52.0f32) * k;
    if draw && f > 0.5 { e2c_media(s, "over", E2C_ICON[cl], ifx icon > 72 then "-128.jpg" else ifx icon > 48 then "-72.jpg" else "-48.jpg", x, y, x + icon, y + icon); }
    if draw { n = cc.text(out, n, E2C_ABILITY[cl], x + icon + 8 * k, y + icon * 0.5 + 4 * k, (ifx phone then 8.4f32 else 10.5f32) * k, gold); }
    y += icon + 12 * k;
    if !phone { w = e2c_set_lines(out, n, E2C_SLOT[cl], x, y, body, wide, lh, dim, draw); n = w.n; y += f32(w.lines) * lh; }
  }
  return E2cSet.{n = n, h = y - y0 - lh * 0.5};
}
// Where the pane goes: a desktop's at the right, as tall as its words; a phone's two columns
// either side of you in the sky, from under the top band to over the wardrobe's.
e2c_pane :: (s: [] E2, w: f32, h: f32, k: f32) -> E2cPane {
  cl := e2c_class_of(s); out: [1] f32;
  if w < 840 * k || h < 760 * k { return E2cPane.{}; }   // a phone: its CLASS tab says the class (e2c_class_card)
  pw := f32(E2C_PANE_W) * k; pad := f32(E2C_PAD) * k;
  tall := e2c_words(s, out[..], 0, cl, 0, 0, pw - 2 * pad, k, 0, 1, false).h + 2 * pad;
  return E2cPane.{a = cc.Box.{x0 = w - 16 * k - pw, y0 = 20 * k, x1 = w - 16 * k, y1 = 20 * k + e2c_clamp(tall, 200 * k, h - 40 * k)}};
}
e2c_pane_draw :: (s: [] E2, out: [] f32, at: int, f: f32) -> int {
  w := s[0].width; h := s[0].height; k := s[0].k; cl := e2c_class_of(s);
  p := e2c_pane(s, w, h, k); n := at; pad := f32(E2C_PAD) * k;
  if p.a.x1 <= p.a.x0 { return n; }
  ui := s[0].creator[0].ui; cc.uit_part(ui, "class pane");   // the layout trace (#13076): the pane's glass, and its words in it
  pa := cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, p.a.x0, p.a.y0, p.a.x1, p.a.y1, "pane");
  pb := cc.uit_put(ui, cc.UIT_NONE, cc.UIT_PANEL, p.b.x0, p.b.y0, p.b.x1, p.b.y1, "pane right");
  if p.b.x1 <= p.b.x0 {
    x := p.a.x0 + pad; y := p.a.y0 + pad * 0.5; wide := p.a.x1 - p.a.x0 - 2 * pad;
    d := e2c_words(s, out, n, cl, x, y, wide, k, 0, f, true); cc.uit_add(ui, pa, cc.UIT_TEXT, x, y, x + wide, y + d.h, "words");
    return d.n;
  }
  inset := 8 * k;
  wa := p.a.x1 - p.a.x0 - 2 * inset; da := e2c_words(s, out, n, cl, p.a.x0 + inset, p.a.y0 + 2 * k, wa, k, 1, f, true);
  cc.uit_add(ui, pa, cc.UIT_TEXT, p.a.x0 + inset, p.a.y0 + 2 * k, p.a.x0 + inset + wa, p.a.y0 + 2 * k + da.h, "words");
  wb := p.b.x1 - p.b.x0 - 2 * inset; db := e2c_words(s, out, da.n, cl, p.b.x0 + inset, p.b.y0 + 2 * k, wb, k, 2, f, true);
  cc.uit_add(ui, pb, cc.UIT_TEXT, p.b.x0 + inset, p.b.y0 + 2 * k, p.b.x0 + inset + wb, p.b.y0 + 2 * k + db.h, "words right");
  return db.n;
}
// A picture for the host to draw (coax/web/host.js coaxial_media): "image URL X0 Y0 X1 Y1".
e2c_put :: (m: [] u8, at: int, t: string) -> int { n := at; for i: 0..<t.count { if n < m.count { m[n] = t[i]; n += 1; } } return n; }
e2c_media :: (s: [] E2, kind: string, name: string, tail: string, x0: f32, y0: f32, x1: f32, y1: f32) {
  m := s[0].media[..]; n := s[0].media_n;
  if n + 120 > m.count { return; }
  if n > 0 { m[n] = 10; n += 1; }
  n = e2c_put(m, n, kind); n = e2c_put(m, n, " "); n = e2c_put(m, n, E2C_ICON_URL); n = e2c_put(m, n, name); n = e2c_put(m, n, tail);
  e := [4] f32.[x0, y0, x1, y1];
  for i: 0..<4 {
    n = e2c_put(m, n, " "); v := cast(int) floor(e[i] + 0.5); if v < 0 { n = e2c_put(m, n, "-"); v = -v; }
    d: [12] u8; c := 0; while true { d[c] = cast(u8)('0' + v % 10); c += 1; v /= 10; if v == 0 { break; } }
    while c > 0 { c -= 1; if n < m.count { m[n] = d[c]; n += 1; } }
  }
  s[0].media_n = n;
}
#test "create: the class pane says every class in full, and stays clear of you and the wardrobe" #steps 400000000 {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\n");
  out: [24000] f32;
  for cl: 0..<E2C_CLASSES {
    #assert E2C_ABOUT[cl].count > 80 && E2C_SLOT[cl].count > 30 && E2C_FEATURES[cl].count > 5 && E2C_ICON[cl].count > 3;
    s[0].creator[0].klass = cl;
    // a desktop: at the right, clear of the middle and of the left glass, inside the screen
    for size: 0..<2 {
      w := ifx size == 0 then 1440.0f32 else 900.0f32; h := ifx size == 0 then 900.0f32 else 780.0f32;
      p := e2c_pane(s[..], w, h, 1);
      #assert p.a.x0 > w * 0.5 + 60 && p.a.x0 > 350 && p.a.x1 <= w - 16 && p.a.y0 >= 20 && p.a.y1 <= h - 20 && p.b.x1 == 0;
    }
    // a phone has no pane over you: its CLASS tab shows slot 1, its name, the hit die and primary
    // ability, under the CLASS, LEVEL and NAME rows and inside the sheet
    #assert e2c_empty(e2c_pane(s[..], 390, 844, 1).a) && e2c_empty(e2c_pane(s[..], 844, 390, 1).a);
    s[0].width = 390; s[0].height = 844; s[0].k = 1; s[0].media_n = 0; s[0].cz[0].tab = E2C_TAB_CLASS;
    e2c_layout(s[..], 390, 844, 1); l: [1] cc.HudList;
    #assert e2c_class_card(s[..], l[..], out[..], 0, 1, true, cc.UIT_NONE) > 0 && s[0].media_n > 20 && s[0].media[5] == '/';
    #assert s[0].cz[0].boxes[E2C_NAME_BOX].y1 + f32(E2C_ROW_GAP + E2C_ROW) <= s[0].cz[0].sheet.y1 - f32(E2C_PADDING) - f32(E2C_BUTTON);
    // drawn on a desktop, slot 1's picture is named, over the pane's frame
    s[0].width = 1440; s[0].height = 900; s[0].k = 1; s[0].media_n = 0;
    _ := e2c_pane_draw(s[..], out[..], 0, 1);
    #assert s[0].media_n > 20 && cast(string) s[0].media[0..<5] == "over ";
  }
}
