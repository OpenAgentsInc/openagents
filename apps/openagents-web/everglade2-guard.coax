// Everglade II's path guard on the page (coax/web/room/room-e2-guard.coax walks him; everglade2-net.coax
// keeps the room's words on him). He is drawn as everyone is, a Character Create body (e2_body) dressed
// in the Quaternius knight's armour this pack carries: the armet, the round pauldrons, the plate
// cuirass, the armoured arms, the greaves and the sabatons. He is drawn a jitter buffer behind, where
// the room had him; his gait comes from how far he goes (fivelab-bodies.coax bd_step), so his feet
// keep to the ground; his feet stand on the land's admitted triangles (e2g_y) as yours do; he takes
// the shared glade light every body takes. A new guard, and one coming into view, thins in; a fallen
// one plays his fall, lies, then thins out. Blows at him and his at you show their Hit Points over
// the body struck and sound where they land.
//   coax/bin/coax test --library apps/openagents-web/everglade2.coax --only guard

E2GD_DOWN :: 3; E2GD_NONE :: 4;   // his states as the room says them (room-e2-guard.coax E2GD_*)
E2GD_FAR :: 110.0;           // m: past this he is not drawn; from E2GD_FAR - E2GD_EDGE he thins
E2GD_EDGE :: 12.0;
E2GD_FADE_IN :: 1.0;         // s a new guard thins in over
E2GD_LIE :: 3.5; E2GD_GONE :: 1.2;   // s the fallen lie, and thin out over
E2GD_MARKS :: 8; E2GD_MARK_S :: 1.2;
E2GD_ARMOUR :: [6] int.[0, 3, 4, 6, 7, 9];   // the knight's round pauldrons, arms, cuirass, sabatons, armet, greaves (charactercreator-parts.coax)
E2gdMark :: struct { on: bool; x: f32; y: f32; z: f32; t0: f32; amount: int; harm: bool; }
E2GuardLook :: struct {
  anim: [1] figs.BdAnim;
  life: int = -1; born: f32 = -100;   // the life drawn and when it began here
  fade: f32; fell: bool; fell_at: f32;
  swing_seen: int = -1; act: E2kAct;
  x: f32; y: f32; z: f32; yaw: f32; up: bool;   // where he is drawn this frame; up: standing (a body to walk round)
  marks: [E2GD_MARKS] E2gdMark; drawn: int; fades: int;
}

// The guard's body: the creator's catalog with his armour on, nothing else worn.
e2gd_dress :: (c: [] cc.Creator) {
  c[0].female = false;
  for i: 0..<40 { c[0].worn[i] = false; }
  for p: E2GD_ARMOUR { c[0].worn[p] = true; }
  c[0].dye = 8; c[0].variant = 0;
}
#test "the guard wears the knight's whole armour: helmet, pauldrons, cuirass, arms, greaves and sabatons" {
  c: [1] cc.Creator; e2gd_dress(c[..]);
  for p: E2GD_ARMOUR { #assert c[0].worn[p]; }
  n := 0; for i: 0..<40 { if c[0].worn[i] { n += 1; } } #assert n == 6 && !c[0].female;
}

// How much of him is shown: thinning in as a new life, thinning with distance, thinning out as he lies.
e2gd_shown :: (now: f32, born: f32, d: f32, fell: bool, fell_at: f32) -> f32 {
  a := e2_sat((now - born) / f32(E2GD_FADE_IN));
  b := e2_sat((f32(E2GD_FAR) - d) / f32(E2GD_EDGE));
  c: f32 = 1;
  if fell { c = 1 - e2_sat((now - fell_at - figs.bd_seconds(figs.BD_DIE) - f32(E2GD_LIE)) / f32(E2GD_GONE)); }
  return a * b * c;
}
#test "a guard thins in as he comes, with distance, and out once he has lain a while" {
  #assert e2gd_shown(0, 0, 10, false, 0) == 0 && abs(e2gd_shown(0.5, 0, 10, false, 0) - 0.5) < 0.001 && e2gd_shown(2, 0, 10, false, 0) == 1;
  #assert e2gd_shown(2, 0, f32(E2GD_FAR) + 1, false, 0) == 0 && abs(e2gd_shown(2, 0, f32(E2GD_FAR) - f32(E2GD_EDGE) * 0.5, false, 0) - 0.5) < 0.001;
  die := figs.bd_seconds(figs.BD_DIE);
  #assert e2gd_shown(10, 0, 10, true, 5) == 1 && e2gd_shown(5 + die + f32(E2GD_LIE) + f32(E2GD_GONE) + 0.1, 0, 10, true, 5) == 0;
}

// Where you aim at him: a harmful ability whose reach takes him, with him before you (within 50
// degrees of your facing), aims at his middle; else where it would land. The room takes a cast aimed
// within E2GD_AIM m of him as at him (room-e2-guard.coax e2_guard_target).
e2gd_aim :: (s: [] E2, m: XcAim, p: [2] f32, fx: f32, fz: f32) -> [2] f32 {
  g := s[0].guard[0];
  if !g.up || m.kind == XC_AIM_SELF { return p; }
  dx := g.x - s[0].you_x; dz := g.z - s[0].you_z; d := sqrt(dx * dx + dz * dz);
  reach := ifx m.kind == XC_AIM_MELEE then m.reach else m.reach + 1;
  if d > reach || d < 0.01 || (dx * fx + dz * fz) / d < 0.64 { return p; }
  return [2] f32.[g.x, g.z];
}
#test "a blow or a bolt aims at the guard when he is before you and in its reach" {
  s: [1] E2; s[0].you_x = 0; s[0].you_z = 0; s[0].guard[0].up = true; s[0].guard[0].x = 0; s[0].guard[0].z = -1.5;
  melee := XcAim.{kind = XC_AIM_MELEE, reach = f32(XC_REACH)};
  p := e2gd_aim(s[..], melee, [2] f32.[0, -2.3], 0, -1); #assert p[0] == 0 && p[1] == -1.5;
  p = e2gd_aim(s[..], melee, [2] f32.[0, 2.3], 0, 1); #assert p[1] == 2.3;   // behind you
  s[0].guard[0].z = -9; p = e2gd_aim(s[..], melee, [2] f32.[0, -2.3], 0, -1); #assert p[1] == -2.3;   // out of reach
  bolt := XcAim.{kind = XC_AIM_BOLT, reach = 18}; p = e2gd_aim(s[..], bolt, [2] f32.[0, -18], 0, -1); #assert p[1] == -9;
  s[0].guard[0].up = false; p = e2gd_aim(s[..], bolt, [2] f32.[0, -18], 0, -1); #assert p[1] == -18;
  #assert e2gd_aim(s[..], XcAim.{kind = XC_AIM_SELF}, [2] f32.[0, 0], 0, -1)[1] == 0;
}

// His capsule among the bodies your step walks round (everglade2-move.coax e2m_guard_body).
e2gd_body :: (s: [] E2, n: int, x: f32, z: f32) -> int {
  g := s[0].guard[0];
  if !g.up { return n; }
  return e2m_guard_body(s[0].move_bodies[..], n, x, z, g.x, g.z);
}

// The frame's guard: the room's word at the drawn time, his gait, his blow, his fall, his fade; his
// body's draws after `at`.
e2gd_draw :: (s: [] E2, at: E2Drawn, bdt: f32) -> E2Drawn {
  gl := s[0].guard[..]; n := s[0].net[..]; now := s[0].clock;
  r := e2n_guard_at(n, n[0].rt);
  gl[0].up = false;
  if r.state == E2GD_NONE || r.life <= 0 { return at; }
  a := gl[0].anim[..];
  if r.life != gl[0].life {
    // a new guard: from nothing where the room puts him (the last one, if still lying, goes at once)
    gl[0].life = r.life; gl[0].born = now; gl[0].fell = false; gl[0].swing_seen = r.swing; gl[0].act = E2kAct.{}; gl[0].fades += 1;
    a[0] = figs.BdAnim.{}; a[0].on = true; a[0].x = r.x; a[0].z = r.z; a[0].lx = r.x; a[0].lz = r.z; a[0].yaw = r.yaw; a[0].own = true;
  }
  if r.state == E2GD_DOWN && !gl[0].fell { gl[0].fell = true; gl[0].fell_at = now; a[0].state = 1; a[0].fell_at = now; }
  if r.swing != gl[0].swing_seen && r.swing >= 0 { gl[0].swing_seen = r.swing; gl[0].act = E2kAct.{at = now, clip = figs.BD_SLASH}; }
  y := e2g_y(s[0].eg[..], r.x, r.z);
  a[0].x = r.x; a[0].z = r.z; a[0].y = y; a[0].yaw = r.yaw; a[0].own = true;
  figs.bd_step(a, now, bdt);
  gl[0].x = r.x; gl[0].y = y; gl[0].z = r.z; gl[0].yaw = r.yaw; gl[0].up = !gl[0].fell;
  dx := r.x - s[0].eye[0]; dz := r.z - s[0].eye[2];
  gl[0].fade = e2gd_shown(now, gl[0].born, sqrt(dx * dx + dz * dz), gl[0].fell, gl[0].fell_at);
  if gl[0].fade <= 0.001 { return at; }
  s[0].rtmp[0] = s[0].creator[0]; e2gd_dress(s[0].rtmp[..]);
  fig := e2k_figure(a[0], gl[0].act, now);
  from := at.rec;
  d := e2_body_of(s, s[0].rtmp[0], fig, at, true);   // the knight's pieces are no player's pick
  drop := e2_fade_drop(gl[0].fade);
  for i: from..<d.rec { s[0].records[i * 24 + 23] = 2 + drop; }
  if d.rec > from { gl[0].drawn += 1; }
  return d;
}

// The blows the drawn picture has reached: a mark over the one struck, and the sound of it there.
e2gd_hits :: (s: [] E2) {
  n := s[0].net[..]; gl := s[0].guard[..]; now := s[0].clock;
  for h: 0..<E2N_GUARD_HITS {
    e := n[0].guard_hits[h];
    if !e.live || e.t > n[0].rt { continue; }
    n[0].guard_hits[h].live = false;
    x := gl[0].x; z := gl[0].z; y := gl[0].y + 2.1;
    if e.kind == 2 {
      if e.seat == n[0].seat { x = s[0].you_x; z = s[0].you_z; y = s[0].you_y + 2.1; }
      else { rr := e2n_remote_seat(n, e.seat); if !rr.ok { continue; } x = rr.x; z = rr.z; y = e2_height(rr.x, rr.z) + rr.y + 2.1; }
    }
    for m: 0..<E2GD_MARKS { if !gl[0].marks[m].on || now - gl[0].marks[m].t0 > f32(E2GD_MARK_S) { gl[0].marks[m] = E2gdMark.{on = true, x = x, y = y, z = z, t0 = now, amount = e.amount, harm = e.kind == 2}; break; } }
    if e.amount > 0 { e2k_cue(s, ifx e.kind == 2 then "hit-heavy" else "hit", 0.8, x, z, 1); if e.kind == 1 { e2k_cue(s, "grunt", 0.45, x, z, 1); } }
  }
}

// His name and Hit Points over his head, and the marks of the blows, rising and thinning.
e2gd_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  v := at; gl := s[0].guard[0]; e := s[0].eye; f := s[0].fwd; r := s[0].right; up := s[0].up; k := s[0].k; now := s[0].clock;
  cy := ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5;
  if gl.up && gl.fade > 0.05 {
    y := gl.y + 2.05; dx := gl.x - e[0]; dy := y - e[1]; dz := gl.z - e[2];
    ahead := dx * f[0] + dy * f[1] + dz * f[2]; dist := sqrt(dx * dx + dy * dy + dz * dz);
    rw := e2n_guard_at(s[0].net[..], s[0].net[0].rt);
    if ahead > 0.5 && dist < f32(E2_PLATE_FAR) && e2_plate_seen(e, gl.x, y, gl.z) && rw.max > 0 {
      alpha := gl.fade * (ifx dist <= f32(E2_PLATE_NEAR) then 1.0f32 else 1 - (dist - f32(E2_PLATE_NEAR)) / f32(E2_PLATE_FAR - E2_PLATE_NEAR));
      sx := s[0].width * 0.5 + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / ahead;
      sy := cy - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / ahead;
      ink := cc.ink(k, 0.95 * alpha, 0.86 * alpha, 0.62 * alpha); ink.light = alpha; ink.glow *= alpha; ink.core *= alpha;
      v = cc.text(out, v, "Guard", sx - 17 * k, sy - 13 * k, 12 * k, ink);
      v = e2k_line(out, v, sx - 18 * k, sy, sx + 18 * k, sy, 2.5 * k, 0.22 * alpha, 0.12 * alpha, 0.08 * alpha);
      v = e2k_line(out, v, sx - 18 * k, sy, sx - 18 * k + 36 * k * f32(rw.hp) / f32(rw.max), sy, 2.5 * k, 0.86 * alpha, 0.24 * alpha, 0.16 * alpha);
    }
  }
  for m: gl.marks {
    if !m.on { continue; }
    t := (now - m.t0) / f32(E2GD_MARK_S);
    if t < 0 || t >= 1 { continue; }
    y := m.y + 0.6 * t; dx := m.x - e[0]; dy := y - e[1]; dz := m.z - e[2];
    ahead := dx * f[0] + dy * f[1] + dz * f[2];
    if ahead < 0.5 { continue; }
    sx := s[0].width * 0.5 + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / ahead;
    sy := cy - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / ahead;
    alpha := 1 - t * t;
    b: [8] u8; bn := ifx m.amount > 0 then e2k_int(b[..], e2k_put(b[..], 0, "-"), m.amount) else e2k_put(b[..], 0, "MISS");
    cap := (ifx m.amount > 0 then 17.0f32 else 12.0f32) * k;
    ink := ifx m.harm then cc.ink(k, 1 * alpha, 0.35 * alpha, 0.3 * alpha) else cc.ink(k, 1 * alpha, 0.9 * alpha, 0.45 * alpha);
    ink.light = alpha; ink.glow *= alpha; ink.core *= alpha;
    v = cc.text(out, v, cast(string) b[0..<bn], sx - f32(bn) * cap * 0.3, sy, cap, ink);
  }
  return v;
}
