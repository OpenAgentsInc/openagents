// Everglade II's movement world (docs/verse/everglade2.md, docs/verse/2026-11-07-everglade-multiplayer-audit.md):
// where you may stand, the trunks and rocks that stop you, and Everglade II's pace. The page
// (everglade2.coax, everglade2-face.c) and the room server (coax/web/room/room-world.c, its
// Everglade II rooms) both #load this file and step the same controller (everglade-step.coax) on it,
// so the page's prediction and the room's word on you agree. Plain numbers only: no drawing.
//   coax/bin/coax test --library apps/openagents-web/everglade2-move.coax
#load "everglade-move-types.coax";
#load "../../verse/everglade2/plant.coax";
#load "../../verse/everglade2/rock-hulls.coax";
#load "../../verse/everglade2/camp.coax";   // the goblin camp's props (coax/web/room/room-e2-monsters.coax)
#load "../../verse/everglade2/points.coax";   // the spawn (#13078)

E2_NEAR_BODIES :: 48;         // trunks the controller walks round
// Everglade II's own pace: a jog and a stroll. The shared controller's speeds (aethyr/locomotion.coax:
// run 7.5, walk 3.5 m/s, Everglade's) are scaled by the step's pace, so v1 keeps its own.
E2_RUN_SPEED :: 4.25; E2_WALK_SPEED :: 1.5;   // m/s
E2_BASE_RUN :: 7.5; E2_BASE_WALK :: 3.5;      // aethyr/locomotion.coax LocomotionProfile's defaults
e2_pace :: (running: bool) -> f32 #export_c #effects(all) { return ifx running then f32(E2_RUN_SPEED) / f32(E2_BASE_RUN) else f32(E2_WALK_SPEED) / f32(E2_BASE_WALK); }

// Where a new seat stands: the glade's middle, facing the studio's camera (everglade2.coax e2_start):
// E2_SPAWN_X, E2_SPAWN_Z and E2_SPAWN_FACE are the map's named spawn (verse/everglade2/points.coax, #13078).

// ---- where you may stand: the glade, the path's corridor, the clearings and the brook's banks
e2_may_stand :: (x: f32, z: f32) -> bool #export_c #effects(all) {
  // the glade, out to the thick woods round it (forest.coax e2_wooded: thick from 24 m)
  if x * x + z * z < f32(E2_GLADE_WALK) * f32(E2_GLADE_WALK) { return true; }
  if z <= -20 && z > E2_CLEAR_Z - E2_CLEAR_R && e2_road_dist(x, z) < f32(E2_WALK) { return true; }
  // the clearings, and the brook's banks by the city's (forest.coax e2_by_brook)
  return e2_clearing(x, z) > 0.15 || e2_by_brook(x, z);
}
// Where a step that ended at (x, z) from (fx, fz) may leave you: there, or slid along the edge it
// crossed, or back where it started.
E2Spot :: struct { x: f32; z: f32; }
e2m_keep :: (x: f32, z: f32, fx: f32, fz: f32) -> E2Spot #export_c #effects(all) {
  if e2_may_stand(x, z) { return E2Spot.{x = x, z = z}; }
  if e2_may_stand(x, fz) { return E2Spot.{x = x, z = fz}; }
  if e2_may_stand(fx, z) { return E2Spot.{x = fx, z = z}; }
  return E2Spot.{x = fx, z = fz};
}

// ---- the rocks round you, each its own mesh's convex hull (verse/everglade2/rock-hulls.coax, baked by
// verse/tools/assets/everglade2_rock_hulls.coax): aethyr/query.coax's hulls, so you stand on a rock's
// real top, step onto a low one, slide off a steep face and stop at its side where you see it. The
// controller walks a level plane over the land (the land lifts you onto the ground), so a placed rock's
// hull is put on that plane: scaled and turned with the rock, and lowered by the land's own slope under
// it (the land's height at its middle and the slope there). Pebbles stay walk-through: they are a few
// centimetres high.
E2_NEAR_HULLS :: 16;          // rocks the controller walks among
E2_HULL_HEAD :: 3; E2_HULL_FACE :: 4; E2_HULL_FACES :: 128;   // aethyr/query.coax QUERY_HULL_HEAD, _FACE, _FACES_MAX
E2_HULL_ROOM :: E2_NEAR_HULLS * (E2_HULL_HEAD + E2_HULL_FACES * E2_HULL_FACE);
E2_HULL_CAPPED :: 6;          // the glade's Rock_Medium_4s west of x -10, drawn with their tops capped
E2_HULL_REACH :: 1.5;         // m: a rock this far past where you stand is out of a step's reach
// A placed rock: its hull's model (rock-hulls.coax's order), where it stands, its turn and its scales.
E2Rock :: struct { model: int; x: f32; y: f32; z: f32; yaw: f32; sh: f32; sv: f32; }
// Rock r's hull into `out` at number `at`, on the controller's plane; where the next one starts, or
// `at` when it is out of reach of (x, z) or doesn't fit.
e2_rock_hull :: (out: [] f32, at: int, r: E2Rock, x: f32, z: f32) -> int {
  m := r.model; if m < 0 || m >= E2_HULL_MODELS || r.sh <= 0 || r.sv <= 0 { return at; }
  v0 := E2_HULL_FIRST_V[m]; v1 := E2_HULL_FIRST_V[m + 1]; f0 := E2_HULL_FIRST_F[m]; f1 := E2_HULL_FIRST_F[m + 1];
  end := at + E2_HULL_HEAD + (f1 - f0) * E2_HULL_FACE;
  if at < 0 || end > out.count || f1 - f0 > E2_HULL_FACES { return at; }
  c := cos(r.yaw); sn := sin(r.yaw);
  h0 := e2_height(r.x, r.z); lift := r.y - h0;
  gx := e2_height(r.x + 0.5, r.z) - e2_height(r.x - 0.5, r.z); gz := e2_height(r.x, r.z + 0.5) - e2_height(r.x, r.z - 0.5);
  lo := [3] f32.[1000000, 1000000, 1000000]; hi := [3] f32.[-1000000, -1000000, -1000000];
  for v: v0..<v1 {
    a := f32(E2_HULL_V[v * 3]) / 10000; b := f32(E2_HULL_V[v * 3 + 1]) / 10000; cz := f32(E2_HULL_V[v * 3 + 2]) / 10000;
    dx := r.sh * (a * c + cz * sn); dz := r.sh * (-a * sn + cz * c);
    p := [3] f32.[r.x + dx, lift + r.sv * b - gx * dx - gz * dz, r.z + dz];
    for k: 0..<3 { if p[k] < lo[k] { lo[k] = p[k]; } if p[k] > hi[k] { hi[k] = p[k]; } }
  }
  if x < lo[0] - f32(E2_HULL_REACH) || x > hi[0] + f32(E2_HULL_REACH) || z < lo[2] - f32(E2_HULL_REACH) || z > hi[2] + f32(E2_HULL_REACH) { return at; }
  out[at] = f32(f1 - f0); out[at + 1] = lo[1]; out[at + 2] = hi[1];
  // the face n . (a, b, c) = d through the same map: (x - X) = sh R (a, c), y = lift + sv b - g . (x - X)
  for f: f0..<f1 {
    na := f32(E2_HULL_F[f * 4]) / 1000000; nb := f32(E2_HULL_F[f * 4 + 1]) / 1000000; nc := f32(E2_HULL_F[f * 4 + 2]) / 1000000; d := f32(E2_HULL_F[f * 4 + 3]) / 1000000;
    kx := (na * c + nc * sn) / r.sh + nb * gx / r.sv; ky := nb / r.sv; kz := (-na * sn + nc * c) / r.sh + nb * gz / r.sv;
    l := sqrt(kx * kx + ky * ky + kz * kz);
    o := at + E2_HULL_HEAD + (f - f0) * E2_HULL_FACE;
    out[o] = kx / l; out[o + 1] = ky / l; out[o + 2] = kz / l; out[o + 3] = (d + kx * r.x + ky * lift + kz * r.z) / l;
  }
  return end;
}
// The kit piece's hull model, or -1 when it isn't a rock that stops you.
e2_kit_rock :: (kit: int) -> int { return ifx kit >= 20 && kit <= 22 then kit - 20 else ifx kit == 23 || kit == 24 then kit - 19 else -1; }
// The glade's own rocks (its pack's composition, verse/character-glade.coax cg_item), as the pack draws
// them (verse/tools/assets/everglade2_pack.coax gp_mesh_scaled): on the land's height plus the item's
// lift, scale across and scale times its vertical share up.
e2_glade_rock :: (gt: CgItem) -> E2Rock {
  if gt.kind != 2 && gt.kind != 3 { return E2Rock.{model = -1}; }
  m := ifx gt.kind == 3 then (ifx gt.variant == 3 && gt.x < -10 then E2_HULL_CAPPED else gt.variant) else 4 + gt.variant;
  if gt.kind == 3 && (gt.variant < 0 || gt.variant > 3) || gt.kind == 2 && (gt.variant < 0 || gt.variant > 1) { m = -1; }
  return E2Rock.{model = m, x = gt.x, y = e2_height(gt.x, gt.z) + gt.lift, z = gt.z, yaw = gt.yaw, sh = gt.scale, sv = gt.scale * gt.vertical};
}
// And the two the pack adds after them: a Rock_Medium_3 at the cliff's foot and a flat stone by the path.
E2_GLADE_STONES :: 2;
e2_glade_stone :: (i: int) -> E2Rock {
  if i == 0 { return E2Rock.{model = 2, x = -14, y = e2_height(-14, -24), z = -24, yaw = 0.3, sh = 2.0, sv = 2.0}; }
  return E2Rock.{model = 3, x = -0.18, y = e2_height(-0.18, -2.4), z = -2.4, yaw = 1.1, sh = 0.16, sv = 0.05};
}
// Each tree kind's trunk at waist height (kits 0 to 14: CommonTree, Birch and Pine 1 to 5): its middle's
// x and z and its radius, from the Stylized Nature models. You brush past a trunk but not through it.
E2_TRUNK_FIT :: [15][3] f32.[
  [3] f32.[0.001, 0.084, 0.46], [3] f32.[0.009, 0.070, 0.48], [3] f32.[0.025, 0.077, 0.48], [3] f32.[-0.077, 0.054, 0.49], [3] f32.[0.052, 0.105, 0.45],
  [3] f32.[0.057, -0.080, 0.18], [3] f32.[0.036, -0.069, 0.27], [3] f32.[0.041, -0.072, 0.18], [3] f32.[0.054, -0.081, 0.18], [3] f32.[0.041, -0.064, 0.20],
  [3] f32.[-0.005, -0.448, 0.50], [3] f32.[-0.005, -0.448, 0.50], [3] f32.[0.121, -0.596, 0.50], [3] f32.[0.0, -0.30, 0.45], [3] f32.[0.010, -0.137, 0.35]];
// A tree's trunk (kind 0 to 14, placed at x z, turned by yaw, sh across): its middle and radius.
e2_trunk :: (kind: int, x: f32, z: f32, yaw: f32, sh: f32) -> [3] f32 {
  f := E2_TRUNK_FIT[kind]; c := cos(yaw); sn := sin(yaw);
  return [3] f32.[x + sh * (f[0] * c + f[1] * sn), z + sh * (-f[0] * sn + f[1] * c), f[2] * sh];
}
// A box standing on the land at (x, z), turned by yaw, half extents hx across and hz deep, h tall: its
// hull (as e2_rock_hull's: six faces, n . p <= d inside) into `out` at `at`; where the next one starts.
e2_box_hull :: (out: [] f32, at: int, x: f32, z: f32, yaw: f32, hx: f32, hz: f32, h: f32) -> int {
  end := at + E2_HULL_HEAD + 6 * E2_HULL_FACE;
  if at < 0 || end > out.count { return at; }
  c := cos(yaw); sn := sin(yaw);
  out[at] = 6; out[at + 1] = -0.2; out[at + 2] = h;
  // the box's own across (c, -sn) and deep (sn, c) in the world, as a placed piece turns (cg_instance_point)
  f := [6][4] f32.[[4] f32.[c, 0, -sn, hx], [4] f32.[-c, 0, sn, hx], [4] f32.[sn, 0, c, hz], [4] f32.[-sn, 0, -c, hz], [4] f32.[0, 1, 0, h], [4] f32.[0, -1, 0, 0.2]];
  for q: 0..<6 {
    o := at + E2_HULL_HEAD + q * E2_HULL_FACE;
    out[o] = f[q][0]; out[o + 1] = f[q][1]; out[o + 2] = f[q][2]; out[o + 3] = f[q][3] + f[q][0] * x + f[q][2] * z;
  }
  return end;
}
// Whether one of the n numbers' hulls holds (x, 1 m up, z).
e2_hulls_hold :: (hulls: [] f32, n: int, x: f32, z: f32) -> bool {
  at := 0;
  while at < n {
    faces := cast(int) hulls[at]; ok := true;
    for q: 0..<faces { o := at + E2_HULL_HEAD + q * E2_HULL_FACE; if hulls[o] * x + hulls[o + 1] + hulls[o + 2] * z > hulls[o + 3] + 0.0001 { ok = false; } }
    if ok { return true; }
    at += E2_HULL_HEAD + faces * E2_HULL_FACE;
  }
  return false;
}
#test "the camp's props stop you where they are drawn, and nowhere off them" {
  body: [E2_NEAR_BODIES * 7] f32; hulls: [E2_HULL_ROOM] f32; items: [8] f32; kinds: [1] u8; first: [2] int;
  stall := E2_CAMP[1]; sx := e2_camp_px(stall); sz := e2_camp_pz(stall);
  w := e2m_world(items[..], kinds[..], first[..], false, body[..], hulls[..], sx, sz);
  #assert w.hulls > 0 && w.bodies >= 1;
  // the stall's hull holds its middle and its corners, and not a point a metre past its side
  h := E2_CAMP_HALF[stall.kit]; c := cos(stall.yaw); sn := sin(stall.yaw); a := h[0] * stall.scale * 0.95; b := h[1] * stall.scale * 0.95;
  #assert e2_hulls_hold(hulls[..], w.hulls, sx, sz) && e2_hulls_hold(hulls[..], w.hulls, sx + a * c + b * sn, sz - a * sn + b * c) && e2_hulls_hold(hulls[..], w.hulls, sx - a * c - b * sn, sz + a * sn - b * c);
  #assert !e2_hulls_hold(hulls[..], w.hulls, sx + (a + 1) * c, sz - (a + 1) * sn) && !e2_hulls_hold(hulls[..], w.hulls, sx + (b + 1) * sn, sz + (b + 1) * c);
  // the fire is an upright body its own size
  fire := E2_CAMP[0]; fx := e2_camp_px(fire); fz := e2_camp_pz(fire);
  w = e2m_world(items[..], kinds[..], first[..], false, body[..], hulls[..], fx, fz);
  found := false; for q: 0..<w.bodies { if body[q * 7] == fx && body[q * 7 + 2] == fz && abs(body[q * 7 + 6] - E2_CAMP_HALF[0][0] * fire.scale) < 0.001 { found = true; } }
  #assert found;
  // far from the camp, no prop
  w = e2m_world(items[..], kinds[..], first[..], false, body[..], hulls[..], e2_road_x(-300), -300);
  #assert w.hulls == 0 && w.bodies == 0;
}
// A trunk's body, from its foot to its waist, as you brush past it (an arrow's flight takes it on up to
// the crown: everglade2-archery.coax E2AR_CROWN).
E2_TRUNK_LOW :: 0.3; E2_TRUNK_HIGH :: 1.6;
e2m_body :: (out: [] f32, n: int, x0: f32, z0: f32, x1: f32, z1: f32, y0: f32, y1: f32, r: f32) -> int {
  if n >= E2_NEAR_BODIES || (n + 1) * 7 > out.count { return n; }
  m := n * 7;
  out[m] = x0; out[m + 1] = y0; out[m + 2] = z0; out[m + 3] = x1; out[m + 4] = y1; out[m + 5] = z1; out[m + 6] = r;
  return n + 1;
}
// The world for a step at (x, z): every trunk round you into `out` (7 floats each) and every rock's hull
// into `hulls` (w.hulls numbers), from the planting (items, kinds and first, plant.coax e2_plant) and the
// glade's own composition.
e2m_world :: (items: [] f32, kinds: [] u8, first: [] int, planted: bool, out: [] f32, hulls: [] f32, x: f32, z: f32) -> EgMoveWorld {
  w: EgMoveWorld; w.deck = true; n := 0; at := 0; rocks := 0;
  ci := cast(int) floor((x - f32(E2_CELL_X0)) / f32(E2_CELL)); cj := cast(int) floor((f32(E2_CELL_Z0) - z) / f32(E2_CELL));
  for dj: -1..<2 { for di: -1..<2 {
    i := ci + di; j := cj + dj;
    if i < 0 || j < 0 || i >= E2_CELLS_X || j >= E2_CELLS_Z || !planted { continue; }
    c := j * E2_CELLS_X + i;
    for q: first[c]..<first[c + 1] {
      kit := cast(int) kinds[q]; rock := e2_kit_rock(kit);
      if kit >= E2_TREES && rock < 0 { continue; }
      o := q * E2_ITEM_FLOATS; px := items[o]; pz := items[o + 2]; sh := items[o + 5];
      reach := ifx rock >= 0 then 2 + 4.2 * sh else 5.0f32;
      if abs(px - x) > reach || abs(pz - z) > reach { continue; }
      if rock >= 0 {
        if rocks < E2_NEAR_HULLS { next := e2_rock_hull(hulls, at, E2Rock.{model = rock, x = px, y = items[o + 1], z = pz, yaw = items[o + 3], sh = sh, sv = items[o + 4]}, x, z); if next > at { rocks += 1; } at = next; }
      }
      else { t := e2_trunk(kit, px, pz, items[o + 3], sh); n = e2m_body(out, n, t[0], t[1], t[0], t[1], f32(E2_TRUNK_LOW), f32(E2_TRUNK_HIGH), t[2]); }
    }
  }}
  // the glade's own trees and rocks (its pack's composition, verse/character-glade.coax cg_item)
  for i: 0..<CG_ITEMS {
    gt := cg_item(i); if !e2_glade_kept(gt) { continue; }
    if abs(gt.x - x) > 5 + 4.2 * gt.scale || abs(gt.z - z) > 5 + 4.2 * gt.scale { continue; }
    if gt.kind <= 1 { tv := ifx gt.variant < 0 then 0 else ifx gt.variant > 4 then 4 else gt.variant; t := e2_trunk(tv + 5 * gt.kind, gt.x, gt.z, gt.yaw, gt.scale); n = e2m_body(out, n, t[0], t[1], t[0], t[1], f32(E2_TRUNK_LOW), f32(E2_TRUNK_HIGH), t[2]); continue; }
    if rocks < E2_NEAR_HULLS { next := e2_rock_hull(hulls, at, e2_glade_rock(gt), x, z); if next > at { rocks += 1; } at = next; }
  }
  for i: 0..<E2_GLADE_STONES { if rocks < E2_NEAR_HULLS { next := e2_rock_hull(hulls, at, e2_glade_stone(i), x, z); if next > at { rocks += 1; } at = next; } }
  // the goblin camp's props (verse/everglade2/camp.coax): a round one an upright body, the rest a box
  for i: 0..<E2_CAMP_PROPS {
    p := E2_CAMP[i]; h := E2_CAMP_HALF[p.kit]; px := e2_camp_px(p); pz := e2_camp_pz(p);
    if abs(px - x) > 6 || abs(pz - z) > 6 { continue; }
    if E2_CAMP_ROUND[p.kit] { n = e2m_body(out, n, px, pz, px, pz, 0.2, h[2] * p.scale, h[0] * p.scale); continue; }
    if rocks < E2_NEAR_HULLS { next := e2_box_hull(hulls, at, px, pz, p.yaw, h[0] * p.scale, h[1] * p.scale, h[2] * p.scale); if next > at { rocks += 1; } at = next; }
  }
  w.bodies = n; w.hulls = at; return w;
}

// The path's guard (coax/web/room/room-e2-guard.coax), a body like yours: upright from his shins to his
// shoulders, E2_GUARD_R round. Within E2_GUARD_NEAR m of the step he joins its bodies, so no one walks
// through him; the page puts him where it draws him, the room where it has him.
E2_GUARD_R :: 0.35; E2_GUARD_NEAR :: 6.0;
e2m_guard_body :: (out: [] f32, n: int, x: f32, z: f32, gx: f32, gz: f32) -> int #export_c #effects(all) {
  if abs(gx - x) > f32(E2_GUARD_NEAR) || abs(gz - z) > f32(E2_GUARD_NEAR) { return n; }
  return e2m_body(out, n, gx, gz, gx, gz, 0.3, 1.6, f32(E2_GUARD_R));
}
#test "the guard stands among the bodies a step near him walks round, and not one far off" {
  out: [E2_NEAR_BODIES * 7] f32;
  #assert e2m_guard_body(out[..], 3, 0, -20, 1, -21) == 4 && out[21] == 1 && out[23] == -21 && out[22] == 0.3 && out[25] == 1.6 && out[27] == f32(E2_GUARD_R);
  #assert e2m_guard_body(out[..], 3, 0, -20, 7, -20) == 3 && e2m_guard_body(out[..], 3, 0, -20, 0, -27) == 3;
  #assert e2m_guard_body(out[..], E2_NEAR_BODIES, 0, -20, 0, -20) == E2_NEAR_BODIES;
}

// ---- the room server's copy (coax/web/room/room-world.c): one planting for every Everglade II room,
// for it is a pure function of the land, and the bodies round the seat being stepped.
E2MoveGround :: struct {
  items: [E2_ITEMS * E2_ITEM_FLOATS] f32; kinds: [E2_ITEMS] u8; first: [E2_CELLS_X * E2_CELLS_Z + 1] int; planted: int; done: bool;
  bodies: [E2_NEAR_BODIES * 7] f32; hulls: [E2_HULL_ROOM] f32;
}
e2mg_plant :: (g: [] E2MoveGround) #export_c #effects(all) {
  if g[0].done { return; }
  g[0].planted = e2_plant(g[0].items[..], g[0].kinds[..], g[0].first[..]); g[0].done = true;
}
// The step's world at (x, z) when running (or not): its bodies are e2mg_bodies' until the next call.
e2mg_move_world :: (g: [] E2MoveGround, x: f32, z: f32, running: bool) -> EgMoveWorld #export_c #effects(all) {
  w := e2m_world(g[0].items[..], g[0].kinds[..], g[0].first[..], g[0].done, g[0].bodies[..], g[0].hulls[..], x, z);
  w.pace = e2_pace(running);
  return w;
}
e2mg_bodies :: (g: [] E2MoveGround) -> [] f32 #export_c #effects(all) { return g[0].bodies[..]; }
e2mg_hulls :: (g: [] E2MoveGround) -> [] f32 #export_c #effects(all) { return g[0].hulls[..]; }
// The guard among the step's n bodies at (x, z): the count after (room-world.c world2_step).
e2mg_guard :: (g: [] E2MoveGround, n: int, x: f32, z: f32, gx: f32, gz: f32) -> int #export_c #effects(all) { return e2m_guard_body(g[0].bodies[..], n, x, z, gx, gz); }
e2mg_spawn_x :: () -> f32 #export_c #effects(all) { return f32(E2_SPAWN_X); }
e2mg_spawn_z :: () -> f32 #export_c #effects(all) { return f32(E2_SPAWN_Z); }
e2mg_spawn_face :: () -> f32 #export_c #effects(all) { return f32(E2_SPAWN_FACE); }

#test "you may stand in the glade, along the path and in the clearing, not deep in the woods" {
  #assert e2_may_stand(0, 0) && e2_may_stand(-10, -20) && e2_may_stand(e2_road_x(-200), -200) && e2_may_stand(e2_clear_x(), E2_CLEAR_Z);
  #assert !e2_may_stand(e2_road_x(-200) + 40, -200) && !e2_may_stand(0, 40) && !e2_may_stand(150, -300);
  // the city's clearing and the brook beside it (#13093), not the woods past it
  #assert e2_may_stand(f32(E2_CITY_X), f32(E2_CITY_Z)) && e2_may_stand(stream_x(e2_brook(), -110), -110) && !e2_may_stand(f32(E2_CITY_X) + 110, f32(E2_CITY_Z));
}
#test "a step past the edge slides along it, or stays where it started" {
  z := -200.0f32; x := e2_road_x(z);
  a := e2m_keep(x + 0.5, z - 0.5, x, z); #assert a.x == x + 0.5 && a.z == z - 0.5;
  out := x + f32(E2_WALK) + 1;
  b := e2m_keep(out, z - 0.5, x, z); #assert b.x == x && b.z == z - 0.5;
  c := e2m_keep(0, 40, 0, 20); #assert c.x == 0 && c.z == 20;
}
#test "each rock's hull is its mesh's: its bounds are the mesh's, every vertex inside every face" {
  for m: 0..<E2_HULL_MODELS {
    v0 := E2_HULL_FIRST_V[m]; v1 := E2_HULL_FIRST_V[m + 1]; f0 := E2_HULL_FIRST_F[m]; f1 := E2_HULL_FIRST_F[m + 1];
    #assert v1 - v0 >= 8 && f1 - f0 >= 8 && f1 - f0 <= E2_HULL_FACES;
    lo := [3] int.[1000000, 1000000, 1000000]; hi := [3] int.[-1000000, -1000000, -1000000];
    for v: v0..<v1 { for k: 0..<3 { q := E2_HULL_V[v * 3 + k]; if q < lo[k] { lo[k] = q; } if q > hi[k] { hi[k] = q; } } }
    // within 2% of the mesh's extent on each side, never past it
    for k: 0..<3 {
      size := E2_HULL_MESH_BOUNDS[m * 6 + k + 3] - E2_HULL_MESH_BOUNDS[m * 6 + k];
      #assert lo[k] >= E2_HULL_MESH_BOUNDS[m * 6 + k] && lo[k] - E2_HULL_MESH_BOUNDS[m * 6 + k] <= size / 50;
      #assert hi[k] <= E2_HULL_MESH_BOUNDS[m * 6 + k + 3] && E2_HULL_MESH_BOUNDS[m * 6 + k + 3] - hi[k] <= size / 50;
    }
    for f: f0..<f1 {
      n := [4] f64.[f64(E2_HULL_F[f * 4]) / 1000000, f64(E2_HULL_F[f * 4 + 1]) / 1000000, f64(E2_HULL_F[f * 4 + 2]) / 1000000, f64(E2_HULL_F[f * 4 + 3]) / 1000000];
      #assert abs(n[0] * n[0] + n[1] * n[1] + n[2] * n[2] - 1) < 0.00001;
      touching := 0;
      for v: v0..<v1 {
        s := n[0] * f64(E2_HULL_V[v * 3]) / 10000 + n[1] * f64(E2_HULL_V[v * 3 + 1]) / 10000 + n[2] * f64(E2_HULL_V[v * 3 + 2]) / 10000 - n[3];
        #assert s < 0.0005; if s > -0.0005 { touching += 1; }
      }
      #assert touching >= 3;
    }
  }
}
#test "a placed rock's hull is scaled and turned with it and set on the land's plane" {
  out: [E2_HULL_HEAD + E2_HULL_FACES * E2_HULL_FACE] f32;
  x := 30.0f32; z := -120.0f32; h := e2_height(x, z);
  r := E2Rock.{model = 4, x = x, y = h - 0.1, z = z, yaw = 0.7, sh = 0.8, sv = 0.8};
  e := e2_rock_hull(out[..], 0, r, x, z); f := E2_HULL_FIRST_F[5] - E2_HULL_FIRST_F[4];
  #assert e == E2_HULL_HEAD + f * E2_HULL_FACE && out[0] == f32(f);
  // its height is the mesh's, scaled, from 0.1 under the land; it reaches as far as the mesh does
  #assert abs(out[2] - out[1] - 0.8 * f32(E2_HULL_MESH_BOUNDS[4 * 6 + 4] - E2_HULL_MESH_BOUNDS[4 * 6 + 1]) / 10000) < 0.6;
  // every face is a unit normal, and the rock's middle is inside every one
  for i: 0..<f { o := E2_HULL_HEAD + i * E2_HULL_FACE; #assert abs(out[o] * out[o] + out[o + 1] * out[o + 1] + out[o + 2] * out[o + 2] - 1) < 0.0001;
    #assert out[o] * x + out[o + 1] * 0.5 + out[o + 2] * z - out[o + 3] < 0; }
  // out of reach, or no room: nothing
  #assert e2_rock_hull(out[..], 0, r, x + 20, z) == 0 && e2_rock_hull(out[0..<e - 1], 0, r, x, z) == 0 && e2_rock_hull(out[..], 0, E2Rock.{model = 9}, x, z) == 0;
}
#test "every tree kind has a trunk sized to it" {
  for k: 0..<15 { t := e2_trunk(k, 5, -9, 0.7, 0.8); #assert t[2] > 0.1 && t[2] < 0.5 && abs(t[0] - 5) < 0.6 && abs(t[1] + 9) < 0.6; }
}
#test "the run is a jog and the walk a stroll" {
  #assert abs(e2_pace(true) * f32(E2_BASE_RUN) - 4.25) < 0.001 && abs(e2_pace(false) * f32(E2_BASE_WALK) - 1.5) < 0.001;
}
#test "the room's ground holds the trunks the page walks round, never more than fit" #steps 4000000000 {
  g: [1] E2MoveGround; e2mg_plant(g[..]); #assert g[0].done && g[0].planted > 20000;
  z := -150.0f32; x := e2_road_x(z) + 3;
  w := e2mg_move_world(g[..], x, z, true);
  #assert w.bodies > 0 && w.bodies <= E2_NEAR_BODIES && w.deck && abs(w.pace * f32(E2_BASE_RUN) - 4.25) < 0.001;
  // the same as the page's own call on its own planting
  out: [E2_NEAR_BODIES * 7] f32; hulls: [E2_HULL_ROOM] f32;
  v := e2m_world(g[0].items[..], g[0].kinds[..], g[0].first[..], true, out[..], hulls[..], x, z);
  #assert v.bodies == w.bodies && v.hulls == w.hulls;
  for i: 0..<w.bodies * 7 { #assert out[i] == g[0].bodies[i]; }
  for i: 0..<w.hulls { #assert hulls[i] == g[0].hulls[i]; }
  // the glade's rocks are hulls round them
  gw := e2mg_move_world(g[..], 1.1, -1.4, false); #assert gw.hulls > 0;
  e2mg_plant(g[..]); #assert g[0].done;   // once
}
