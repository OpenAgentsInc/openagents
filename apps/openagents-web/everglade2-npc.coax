// Everglade II's Pansopher on the page (everglade/world/pansopher.coax says who he is and what he
// says): he stands in the glade beside the path's start, a Character Create body in the wizard's
// robes, and turns to face you as you come near. Within E2P_TALK m a prompt says to press E (or tap
// it); his talk opens over the world, his line wrapped in a panel and your answers as buttons under
// it, picked with 1 to 9, a click or a tap. Esc, Farewell or walking E2P_LEAVE m off ends it. He is
// the page's own (every page draws him at the same spot); the room doesn't know him, so he walks
// nowhere and nothing strikes him.
//   coax/bin/coax test --library apps/openagents-web/everglade2.coax --only pansopher
#load "../../everglade/world/pansopher.coax";

E2P_Z :: -9.0;            // m: where he stands, down from the glade's middle
E2P_ACROSS :: -3.0;       // m: across from the path's middle at E2P_Z (west of it)
E2P_TALK :: 3.5;          // m: near enough to talk
E2P_LEAVE :: 6.0;         // m: walking this far off ends the talk
E2P_TURN_AT :: 9.0;       // m: inside this he turns to you
E2P_TURN :: 2.5;          // how fast he turns, a second
E2P_FAR :: 110.0;         // m: past this he isn't drawn
E2P_ANSWERS :: TALK_TREE_CHOICES;
E2P_KEY_ESC :: -1;

E2Npc :: struct {
  anim: [1] figs.BdAnim; placed: bool;
  x: f32; y: f32; z: f32; yaw: f32; home_yaw: f32;
  near: bool;                       // near enough to talk, in the world
  talking: bool; line: int; freed: bool;   // freed: opening the talk freed the mouse, so ending it takes it back
  hover: int = -1; sight: cc.HudSight;
  drawn: int; opened: int; picked: int;
}
// The panel's boxes: its frame, the line's wrapped rows, the answers' buttons, and the prompt.
E2pLayout :: struct {
  panel: cc.HudPrim; pad: f32; title_cap: f32; cap: f32; row_h: f32; text_y: f32;
  rows: int; row_at: [12] int; row_n: [12] int;
  answers: int; answer: [E2P_ANSWERS] cc.HudPrim; choice: [E2P_ANSWERS] int;
  prompt: cc.HudPrim;
}

// Where he stands and the way he faces at rest: toward the glade's middle, where you start.
e2p_place :: (s: [] E2) {
  p := s[0].npc[..]; z := f32(E2P_Z); x := e2_road_x(z) + f32(E2P_ACROSS);
  k := e2m_keep(x, z, x, z);
  p[0].x = k.x; p[0].z = k.z; p[0].y = e2_height(k.x, k.z);
  p[0].home_yaw = figs.atan2(f32(E2_SPAWN_X) - k.x, f32(E2_SPAWN_Z) - k.z); p[0].yaw = p[0].home_yaw;
  a := p[0].anim[..]; a[0] = figs.BdAnim.{}; a[0].on = true; a[0].x = k.x; a[0].z = k.z; a[0].lx = k.x; a[0].lz = k.z; a[0].yaw = p[0].yaw; a[0].own = true;
  p[0].placed = true;
}
e2p_dist :: (s: [] E2) -> f32 { p := s[0].npc[0]; dx := s[0].you_x - p.x; dz := s[0].you_z - p.z; return sqrt(dx * dx + dz * dz); }
e2p_in_world :: (s: [] E2) -> bool { return s[0].placed && !e2c_creating(s) && !s[0].cz[0].menu; }

// Each frame: placed once; near or not; the talk ended if you walked off; turned toward you.
e2p_step :: (s: [] E2, dt: f32) {
  p := s[0].npc[..];
  if !p[0].placed { e2p_place(s); }
  d := e2p_dist(s);
  p[0].near = e2p_in_world(s) && d < f32(E2P_TALK);
  if p[0].talking && (!e2p_in_world(s) || d > f32(E2P_LEAVE)) { e2p_close(s); }
  want := ifx d < f32(E2P_TURN_AT) && e2p_in_world(s) then figs.atan2(s[0].you_x - p[0].x, s[0].you_z - p[0].z) else p[0].home_yaw;
  turn := figs.wrap_angle(want - p[0].yaw); t := dt * f32(E2P_TURN); if t > 1 { t = 1; }
  p[0].yaw = figs.wrap_angle(p[0].yaw + turn * t);
}

e2p_open :: (s: [] E2) {
  p := s[0].npc[..]; if p[0].talking { return; }
  p[0].talking = true; p[0].line = 0; p[0].hover = -1; p[0].opened += 1; s[0].held = 0;
  // the mouse is wanted for the answers: free it while the talk is open
  if mlook.ml_wants(s[0].ml[0]) { s[0].ml[0].free = true; p[0].freed = true; }
}
e2p_close :: (s: [] E2) {
  p := s[0].npc[..]; if !p[0].talking { return; }
  p[0].talking = false; p[0].hover = -1;
  if p[0].freed { s[0].ml[0].free = false; p[0].freed = false; }
}
// Answer k of the line he is on: on to the line it leads to, or the talk ends.
e2p_answer :: (s: [] E2, k: int) {
  p := s[0].npc[..]; t := PANSOPHER_CHOICES;
  o: [E2P_ANSWERS] int; n := talk_tree_offered(t[..], p[0].line, o[..]);
  if k < 0 || k >= n { return; }
  to := talk_tree_pick(t[..], p[0].line, k); p[0].picked += 1;
  if to == TALK_TREE_END { e2p_close(s); return; }
  p[0].line = to; p[0].hover = -1;
}

// ---- input: before the bar's keys, so 1 to 9 answer him while he talks
e2p_key :: (s: [] E2, key: int) -> bool {
  p := s[0].npc[..];
  if p[0].talking {
    if key == E2P_KEY_ESC || key == 'e' || key == 'E' { e2p_close(s); return true; }
    if key >= '1' && key <= '9' { e2p_answer(s, key - '1'); return true; }
    return false;
  }
  if p[0].near && (key == 'e' || key == 'E') { e2p_open(s); return true; }
  return false;
}
e2p_inside :: (b: cc.HudPrim, x: f32, y: f32) -> bool { return x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
e2p_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  p := s[0].npc[..];
  if !p[0].talking && !p[0].near { return false; }
  g := e2p_layout(s);
  if !p[0].talking {
    if phase == 0 && e2p_inside(g.prompt, x, y) { e2p_open(s); return true; }
    return false;
  }
  p[0].hover = -1;
  for i: 0..<g.answers { if e2p_inside(g.answer[i], x, y) { p[0].hover = i; } }
  if phase == 0 && p[0].hover >= 0 { e2p_answer(s, p[0].hover); return true; }
  return phase == 0 && e2p_inside(g.panel, x, y);   // a press on the panel is its own; off it, the world's
}

// ---- the HUD
e2p_put :: (b: [] u8, at: int, t: string) -> int { n := at; for ch: t { if n < b.count { b[n] = ch; n += 1; } } return n; }
e2p_prompt_text :: (s: [] E2, b: [] u8) -> string {
  n := e2p_put(b, 0, ifx s[0].ml[0].touch then "TAP  " else "E  "); n = e2p_put(b, n, "Talk to "); n = e2p_put(b, n, PANSOPHER_NAME);
  n = e2p_put(b, n, ", "); n = e2p_put(b, n, PANSOPHER_TITLE); return cast(string) b[0..<n];
}
e2p_layout :: (s: [] E2) -> E2pLayout {
  w := s[0].width; h := s[0].height; k := s[0].k; p := s[0].npc[0]; g: E2pLayout;
  g.pad = 20 * k; g.title_cap = 17 * k; g.cap = 15 * k; g.row_h = g.cap * 1.55;
  wide := 620 * k; if wide > w - 32 * k { wide = w - 32 * k; }
  x0 := (w - wide) * 0.5; x1 := x0 + wide;
  // the line, wrapped to the panel
  line := pansopher_says(p.line);
  adv: [700] f32; a := cc.face_advances(line, g.cap, cc.HUD_FACE_BODY, adv[..]);
  wd: [12] f32; g.rows = cc.hud_tip_wrap(line, a, wide - 2 * g.pad, g.row_at[..], g.row_n[..], wd[..]);
  t := PANSOPHER_CHOICES; g.answers = talk_tree_offered(t[..], p.line, g.choice[..]);
  ah := 36 * k; gap := 8 * k;
  tall := g.pad + g.title_cap * 1.4 + 10 * k + f32(g.rows) * g.row_h + 14 * k + f32(g.answers) * (ah + gap) - gap + g.pad;
  y0 := h * 0.42 - tall * 0.5; if y0 > h - tall - 150 * k { y0 = h - tall - 150 * k; } if y0 < 16 * k { y0 = 16 * k; }
  g.panel = cc.hud_box(x0, y0, x1, y0 + tall);
  g.text_y = y0 + g.pad + g.title_cap * 1.4 + 10 * k;
  ay := g.text_y + f32(g.rows) * g.row_h + 14 * k;
  for i: 0..<g.answers { g.answer[i] = cc.hud_box(x0 + g.pad, ay, x1 - g.pad, ay + ah); ay += ah + gap; }
  // the prompt: a plaque in the lower middle of the picture
  pb: [96] u8; pt := e2p_prompt_text(s, pb[..]); pw := cc.face_width(pt, 14 * k, cc.HUD_FACE_BODY) + 28 * k; py := h * 0.64;
  g.prompt = cc.hud_box(w * 0.5 - pw * 0.5, py - 17 * k, w * 0.5 + pw * 0.5, py + 17 * k);
  return g;
}
e2p_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  p := s[0].npc[0];
  if !p.talking && !p.near { return at; }
  k := s[0].k; g := e2p_layout(s); t := cc.eg_tokens(); ui := drv_trace(s[0].drive[..]);
  l: [1] cc.HudList;
  if !p.talking {
    cc.hud_button(l[..], t, g.prompt, k, true);
    v := cc.hud_emit(out, at, l[..]);
    pb: [96] u8; pt := e2p_prompt_text(s, pb[..]);
    cc.uit_part(ui, "talk"); cc.uit_add(ui, cc.UIT_NONE, cc.UIT_BUTTON, g.prompt.x0, g.prompt.y0, g.prompt.x1, g.prompt.y1, "talk-to-pansopher");
    return cc.hud_say(out, v, pt, (g.prompt.x0 + g.prompt.x1) * 0.5, (g.prompt.y0 + g.prompt.y1) * 0.5 + 14 * k * 0.5, 14 * k, cc.hud_text(t, cc.HUD_TEXT_NUMBER), 1, k, true);
  }
  cc.hud_panel(l[..], t, g.panel, k);
  for i: 0..<g.answers { cc.hud_button(l[..], t, g.answer[i], k, i == p.hover); }
  v := cc.hud_emit(out, at, l[..]);
  x := g.panel.x0 + g.pad;
  v = cc.hud_say(out, v, PANSOPHER_NAME, x, g.panel.y0 + g.pad + g.title_cap, g.title_cap, cc.hud_text(t, cc.HUD_TEXT_TITLE), 1, k, false);
  nw := cc.face_width(PANSOPHER_NAME, g.title_cap, t.title_face);
  v = cc.hud_say(out, v, PANSOPHER_TITLE, x + nw + 12 * k, g.panel.y0 + g.pad + g.title_cap, 12 * k, cc.hud_text(t, cc.HUD_TEXT_LABEL), 1, k, false);
  line := pansopher_says(p.line);
  for r: 0..<g.rows { v = cc.hud_say(out, v, line[g.row_at[r]..<g.row_at[r] + g.row_n[r]], x, g.text_y + f32(r) * g.row_h + g.cap, g.cap, cc.hud_text(t, cc.HUD_TEXT_NUMBER), 1, k, false); }
  ch := PANSOPHER_CHOICES;
  cc.uit_part(ui, "talk");
  for i: 0..<g.answers {
    b := g.answer[i]; lb: [96] u8; n := 0; lb[0] = cast(u8)('1' + i); n = 1; n = e2p_put(lb[..], n, ".  "); n = e2p_put(lb[..], n, ch[g.choice[i]].text);
    cc.uit_add(ui, cc.UIT_NONE, cc.UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, ch[g.choice[i]].text);
    v = cc.hud_say(out, v, cast(string) lb[0..<n], b.x0 + 14 * k, (b.y0 + b.y1) * 0.5 + 14 * k * 0.5, 14 * k, cc.hud_text(t, cc.HUD_TEXT_NUMBER), 1, k, false);
  }
  return v;
}

// ---- the world: his body, his plate, his place for the driver
e2p_dress :: (c: [] cc.Creator) {
  c[0].female = false; for i: 0..<40 { c[0].worn[i] = false; }
  for w: PANSOPHER_WORN { c[0].worn[w] = true; }
  c[0].hood = false; c[0].beard = true; c[0].hair = 0; c[0].hair_color = PANSOPHER_HAIR_COLOR;
  c[0].dye = PANSOPHER_DYE; c[0].skin = PANSOPHER_SKIN; c[0].variant = 0; c[0].eye_color = 0;
}
e2p_draw :: (s: [] E2, at: E2Drawn, bdt: f32) -> E2Drawn {
  p := s[0].npc[..]; if !p[0].placed { return at; }
  dx := p[0].x - s[0].eye[0]; dz := p[0].z - s[0].eye[2];
  if dx * dx + dz * dz > f32(E2P_FAR) * f32(E2P_FAR) { return at; }
  a := p[0].anim[..]; a[0].x = p[0].x; a[0].z = p[0].z; a[0].y = e2g_y(s[0].eg[..], p[0].x, p[0].z); a[0].yaw = p[0].yaw; a[0].own = true;
  p[0].y = a[0].y;
  figs.bd_step(a, s[0].clock, bdt);
  s[0].rtmp[0] = s[0].creator[0]; e2p_dress(s[0].rtmp[..]);
  d := e2_body_of(s, s[0].rtmp[0], a[0], at, true);   // the wizard's robes are no player's pick
  if d.rec > at.rec { p[0].drawn += 1; }
  return d;
}
e2p_plate_add :: (s: [] E2, pl: [] cc.HudPlates, view: cc.HudPlateView) {
  p := s[0].npc[..]; if !p[0].placed { return; }
  y := p[0].y + 2.05;
  p[0].sight = ifx cc.hud_plate_in_reach(view, p[0].x, y, p[0].z, cc.HUD_PLATE_FAR) then e2_sight_step(s, p[0].sight, p[0].x, p[0].y, p[0].z, 1.9) else cc.hud_sight_gone();
  cc.hud_plates_push(pl, p[0].x, y, p[0].z, PANSOPHER_NAME, -1, false, false, p[0].sight.share);
}
e2p_drive :: (s: [] E2, d: [] Drive) {
  p := s[0].npc[0]; if !p.placed { return; }
  drv_add(d, DRV_NPC, "pansopher", -1, PANSOPHER_NAME, p.x, p.y, p.z, -1, -1, false);
}

#test "pansopher stands by the path in the glade, on ground you may stand on, facing where you start" #steps 200000000 {
  s: [1] E2; e2p_step(s[..], 0.016);
  p := s[0].npc[0];
  #assert p.placed && e2_may_stand(p.x, p.z) && e2_zone(p.x, p.z) == 0;
  #assert abs(p.z - f32(E2P_Z)) < 0.01 && abs(p.x - (e2_road_x(f32(E2P_Z)) + f32(E2P_ACROSS))) < 0.01;
  #assert abs(figs.wrap_angle(p.home_yaw - figs.atan2(-p.x, -p.z))) < 0.001;
}
#test "pansopher: near him E opens his talk, 1 asks how to make a golem, and Farewell or walking off ends it" #steps 200000000 {
  s: [1] E2; s[0].placed = true; s[0].width = 1280; s[0].height = 720; s[0].k = 1;
  e2p_step(s[..], 0.016); p := s[0].npc[0];
  s[0].you_x = p.x + 10; s[0].you_z = p.z; e2p_step(s[..], 0.016);
  #assert !s[0].npc[0].near && !e2p_key(s[..], 'e') && !s[0].npc[0].talking;   // too far
  s[0].you_x = p.x + 2; e2p_step(s[..], 0.016);
  #assert s[0].npc[0].near && e2p_key(s[..], 'e') && s[0].npc[0].talking && s[0].npc[0].line == 0;
  #assert e2p_key(s[..], '1') && s[0].npc[0].line == 1 && pansopher_says(1) == PANSOPHER_SAYS[1];   // "How do I make a golem?"
  #assert e2p_key(s[..], '9') && s[0].npc[0].line == 1;   // no ninth answer: he waits, and the bar casts nothing
  #assert e2p_key(s[..], '3') && s[0].npc[0].line == 0;   // another question
  #assert e2p_key(s[..], '4') && !s[0].npc[0].talking;    // Farewell
  _ := e2p_key(s[..], 'E'); #assert s[0].npc[0].talking;
  s[0].you_x = p.x + f32(E2P_LEAVE) + 0.5; e2p_step(s[..], 0.016); #assert !s[0].npc[0].talking;
  _ = e2p_key(s[..], 'e'); #assert !s[0].npc[0].talking;   // and from there E does nothing
}
#test "pansopher's talk frees the mouse for its answers and takes it back; a click on an answer picks it" #steps 400000000 {
  s: [1] E2; s[0].placed = true; s[0].width = 1280; s[0].height = 720; s[0].k = 1; s[0].ml[0].able = true;
  e2p_step(s[..], 0.016); p := s[0].npc[0]; s[0].you_x = p.x + 2; s[0].you_z = p.z; e2p_step(s[..], 0.016);
  #assert mlook.ml_wants(s[0].ml[0]);
  _ := e2p_key(s[..], 'e'); #assert !mlook.ml_wants(s[0].ml[0]);
  g := e2p_layout(s[..]);
  #assert g.answers == 4 && g.rows >= 1 && g.answer[0].y0 > g.text_y && g.answer[3].y1 <= g.panel.y1 && g.panel.y0 >= 16;
  b := g.answer[0]; #assert e2p_pointer(s[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, 0) && s[0].npc[0].line == 1;
  g = e2p_layout(s[..]); #assert g.rows >= 4;   // the golem answer is long: it wraps
  #assert !e2p_pointer(s[..], 2, 2, 0);   // off the panel: the world's
  _ = e2p_key(s[..], E2P_KEY_ESC); #assert !s[0].npc[0].talking && mlook.ml_wants(s[0].ml[0]);
  out: [40000 * E2_VERTEX_FLOATS] f32;
  #assert e2p_hud(s[..], out[..], 0) > 0;    // the prompt, near him
  _ = e2p_key(s[..], 'e'); #assert e2p_hud(s[..], out[..], 0) > 0;
}
