// Everglade v2, openagents.com/worlds/everglade2 (docs/verse/everglade2.md): Character Create's glade,
// one winding path out of it through dense woods, and a clearing at the path's end. You walk your own
// character (the one Character Create saved) on Everglade's controller and follow camera. Nothing
// else: no town, gate, people or HUD.
//
// The land is verse/everglade2/forest.coax, the planting verse/everglade2/plant.coax, the pack
// verse/tools/assets/everglade2_pack.coax, and the passes gpu/everglade2.coax. everglade2-face.c steps
// the controller (everglade-step.coax) as fivelab-face.c does; this unit says what is round you,
// where you may stand, and what is drawn.
#load "charactercreator.coax" as cc;
#load "fivelab-bodies.coax" as figs;
#load "everglade-move-types.coax";
#load "everglade2-move.coax";   // where you may stand, the trunks and rocks, the pace: the room steps the same (#13053)
#load "everglade2-net.coax";    // the room: the others, your inputs and the server's word on you (#13054)
#load "class-look.coax";        // your class's bar, how it aims, looks and sounds: Everglade Experimental's (#13058)
#load "experimental-sound.coax" as exsound;
#load "everglade2-cast.coax";   // the bar here, and everyone's casts through the room (#13058)
#load "../../verse/everglade2/plant.coax";
#load "../../verse/everglade2/field.coax";
#load "../../verse/everglade2/ground.coax";   // the ground's admitted tiles, from the pack's record, and the canopy bake (#12995, #13059)
#load "../../aethyr/quality.coax";
#load "../../aethyr/render/cascades.coax";   // the key light's shadow tiles (#13016), as Everglade's
#load "everglade2-create.coax";   // Character Create, in this world: /worlds/character-creator
#load "../../aethyr/character/material.coax" as cmat;   // the characters' material table (#13012)
#load "everglade2-cull.coax";   // what the host's instance cull reads each frame (#13050)
#load "../../aethyr/render/environment-frame.coax" as envf;   // the camera's resolved environment, a frame (#13066)
#load "../../verse/everglade2/environment.coax";   // the world's places and their light (#13065)
#load "../../aethyr/render/environment-debug.coax" as envd;   // ?light=VIEW: the developer's light views (#13067)

E2_VERTEX_FLOATS :: 16;
E2_MAX_VERTICES :: 16384;     // strokes: the frame rate in the bottom right corner
E2_UNIFORM_FLOATS :: 316;     // 79 vec4s (gpu/everglade2.bindings)
E2_U_ENV :: 208;              // the camera's resolved environment, 27 vec4s (aethyr/render/painterly.coax PAINT_ENV_U, env_gpu_pack)
E2_U_LIGHT_VIEW :: 51;        // the developer's light view (?light=, aethyr/render/environment-debug.coax env_view_word): 0 the ordinary frame
E2_U_CASCADE :: 104;          // the key light's shadow tiles' rows (aethyr/render/cascades.coax cascade_rows)
E2_RECORDS :: 256;            // the objects store: the glade, its grass, your character's parts and the others' (11 a body)
E2_DRAWS :: 640;              // draws a pass at most (the woods' runs, the grass field's blocks, 11 a body)
E2_REMOTES :: 16;             // other players drawn at most (a room seats 16)
E2_FADE_S :: 0.6;             // s: another player thins in as it comes into your view, and out as it leaves
E2_POP :: 0.25;               // a body cut off while more than this of it showed is a pop (e2_probe 19)
E2_PLATE_NEAR :: 20.0; E2_PLATE_FAR :: 32.0;   // m: a name over a head is whole within NEAR, gone past FAR
E2_VISIBLE :: 60000;          // kit pieces drawn a frame at most, both passes
E2_KIT_BASE :: 1048576;       // gpu/everglade2.coax E2_KIT_BASE
E2_BUCKETS :: E2_KITS * E2_LODS;
E2_CAM_TRUNKS :: 64;          // trunks the follow camera keeps in front of
E2_LOOK_DRAG :: 0.0055; E2_WHEEL_ZOOM :: 0.006;
HOLD_W :: 1; HOLD_A :: 2; HOLD_S :: 4; HOLD_D :: 8; HOLD_LEFT :: 16; HOLD_RIGHT :: 32; HOLD_UP :: 64; HOLD_DOWN :: 128; HOLD_IN :: 256; HOLD_OUT :: 512;
HOLD_JUMP :: 1024; HOLD_ALL :: 2047;
KEY_SHIFT :: -13; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;

E2 :: struct {
  creator: [1] cc.Creator;
  bodies: [1] figs.Bodies;
  items: [E2_ITEMS * E2_ITEM_FLOATS] f32; kinds: [E2_ITEMS] u8; first: [E2_CELLS_X * E2_CELLS_Z + 1] int; planted: int; plant_done: bool;
  eg: [1] E2Ground;                                   // the ground's tiles and the glade's baked AO (verse/everglade2/ground.coax)
  catalog_in: bool; ground_code: int = -1; ground_done: bool;   // the catalog came; its ground record's status (-1 none); the ground settled and baked
  kit_first: [E2_BUCKETS] int; kit_count: [E2_BUCKETS] int; kits: bool;
  records: [E2_RECORDS * 24] f32;
  // the characters' materials, one record a colour layer (aethyr/character/material.coax), the
  // fourth store; mats_n the records admitted, 0 when the pack's table was refused (no maps)
  mats: [cmat.CM_MAX * cmat.CM_FLOATS] f32; mat_table: [cmat.CM_MAX] cmat.CharMaterial; mats_n: int; mats_v: int;
  film: bool; maps_off: bool;   // ?film, ?maps=0 (e2_material_facts)
  inst: [E2_VISIBLE * E2_ITEM_FLOATS] f32; inst_n: int;
  draws: [E2_DRAWS * 4] u32; draw_n: int;
  shadow: [E2_DRAWS * 4] u32; shadow_n: int;
  frame: [16] f32;
  move_bodies: [E2_NEAR_BODIES * 7] f32;
  bake: [figs.BD_BAKE_FLOATS] f32;
  orbit: figs.Orbit; look_yaw: f32; look_pitch: f32;
  held: int; shift: bool; dragging: bool; drag_x: f32; drag_y: f32;
  you_x: f32; you_y: f32; you_z: f32; you_face: f32 = 3.14159265; jump: f32; placed: bool; start_z: f32; autowalk: bool;
  anim: [1] figs.BdAnim;
  airborne: bool; air_at: f32; land_at: f32 = -100;   // the jump's takeoff and landing (e2_jump_figure)
  press: f32; eye_pitch: f32;                        // the eye's pitch, held on the land, and how far the look has gone past it (e2_follow)
  ground: [1] figs.CamGround;                         // the land round you for the camera (figs.cam_ground_next, filled from e2_height)
  view: figs.CamMode;                                 // Everglade II's follow mode (e2_mode)
  q: [1] Quality; q_ready: bool;                     // the graphics governor (aethyr/quality.coax): the pixels drawn
  fps_counter:[1]cc.FpsCounter;          // the frame rate shown, and the frames since it was last worked out
  clock: f32; width: f32; height: f32; k: f32 = 1;
  eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32; focal: f32;
  shade: [3] f32; casc: [1] CascadeState;
  cz: [1] E2Create;                      // Character Create's studio and its run (everglade2-create.coax)
  outbox: [1024] u8; out_n: int; action: int;   // the host action this frame (5 keep the player key, 16 keep the record, 19 the address)
  player_key: [1024] u8; player_key_n: int;      // a minted player key waiting for the host action (e2_keep_player)
  reseat: bool;                          // the controller to take you as the studio drew you (everglade2-face.c)
  media: [6144] u8; media_n: int;        // the pictures this frame names for the host (the class pane's, everglade2-create.coax; the bar's, everglade2-cast.coax)
  casts: [1] E2Cast;                      // your class's bar and everyone's casts (everglade2-cast.coax)
  // the room (everglade2-net.coax): the others, each with its own animation, its jump and its look
  net: [1] E2Net; staged: bool;          // staged: ?at= or ?walk, a shot that opens no room
  ranim: [E2N_ENTS] figs.BdAnim; rair: [E2N_ENTS] bool; rair_at: [E2N_ENTS] f32; rland_at: [E2N_ENTS] f32; rlife: [E2N_ENTS] int;
  // each slot's fade (0 gone, 1 whole) and what it last drew, so one coming into your view (the room's
  // interest, 110 m) thins in and one leaving it (130 m, or the room) thins out where it was: no pops
  rfade: [E2N_ENTS] f32; rlast: [E2N_ENTS] E2Remote; rseat: [E2N_ENTS] int; rlook: [E2N_ENTS * NET_LOOK] u8; rlook_n: [E2N_ENTS] int;
  fade_ins: int; pops: int; ghosts: int;   // e2_probe 18, 19, 87
  rtmp: [1] cc.Creator;                  // a remote's look: your creator's catalog with its record (e2_remote_look)
  plates: [E2_REMOTES] E2Plate; plate_n: int;   // the names over the others' heads this frame (e2_plates)
  plates_drawn: int;                             // the names e2_plates drew in the last frame
  cy: f32;                                       // the picture's centre row (e2c_lens: the studio frames you off centre)
  env: [1] envf.EnvFrame;                        // the light: the world's environment set, its clock and the record each frame writes (e2_light)
  light_view: int; light_text: [1] envd.EnvDebugText;   // ?light=VIEW (developer-only, off by default) and its readout (e2_light_hud)
}
E2Plate :: struct { x: f32; y: f32; z: f32; alpha: f32; fade: f32 = 1; sy: f32; name: [NET_NAME] u8; name_n: int; }

// ---- the pack: the catalog's kit rows (e2/k<kit>/<level>), and Character Create's own rows
// The face keeps the ground's two tile sets outside the state (everglade2-face.c), as it does the catalog.
e2_ground_store :: (s: [] E2, sets: [] E2Tiles) #export_c #effects(all) { e2g_store(s[0].eg[..], sets); }
e2_catalog :: (s: [] E2, whole: string, rec: [] u8, rest: [] u8) #export_c #effects(all) {
  // the ground's record rides in the catalog as G lines (verse/everglade2/ground.coax): read and
  // published now, whole or not at all; the rest is the catalog the others read
  n := e2g_record_from_catalog(whole, rec);
  s[0].ground_code = ifx n > 0 then e2g_record_read(s[0].eg[..], rec[0..<n]) else -1; s[0].catalog_in = true;
  text := e2_catalog_rest(whole, rest);
  figs.bd_catalog(s[0].bodies[..], text); cc.catalog(s[0].creator[..], text);
  s[0].mats_n = cmat.cm_table(text, s[0].mat_table[..], s[0].mats[..]); s[0].mats_v += 1;
  for b: 0..<E2_BUCKETS { s[0].kit_first[b] = 0; s[0].kit_count[b] = 0; }
  at := 0; any := false;
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    row := text[at..<e]; at = e + 1;
    if row.count < 10 || row[0..<6] != "C e2/k" { continue; }
    p := 6; kit := 0; while p < row.count && row[p] >= '0' && row[p] <= '9' { kit = kit * 10 + cast(int)(row[p] - '0'); p += 1; }
    if p >= row.count || row[p] != '/' { continue; }
    lod := cast(int)(row[p + 1] - '0'); ne := figs.bd_word_end(row, p);
    if kit < 0 || kit >= E2_KITS || lod < 0 || lod >= E2_LODS { continue; }
    first := figs.bd_whole_at(row, ne); q := figs.bd_word_end(row, ne + 1); count := figs.bd_whole_at(row, q);
    if first >= 0 && count > 0 { s[0].kit_first[kit * E2_LODS + lod] = first; s[0].kit_count[kit * E2_LODS + lod] = count; any = true; }
  }
  s[0].kits = any;
}
// The catalog without its G lines (or as it came, when that is too long to copy).
e2_catalog_rest :: (t: string, out: [] u8) -> string {
  n := 0; at := 0;
  while at < t.count {
    e := at; while e < t.count && t[e] != '\n' { e += 1; }
    if !(e - at > 1 && t[at] == 'G' && t[at + 1] == ' ') {
      if n + e - at + 1 > out.count { return t; }
      for q: at..<e { out[n] = t[q]; n += 1; } out[n] = '\n'; n += 1;
    }
    at = e + 1;
  }
  return cast(string) out[0..<n];
}
// The ground, once the planting and the catalog are in: the pack's record published it, or (no
// record, or it refused) the land is converted here; then the woods' crowns are baked onto the glade's tile.
e2_ground :: (s: [] E2) {
  s[0].ground_done = true;
  if !s[0].eg[0].ok && !e2g_build(s[0].eg[..]) { return; }
  _b := e2g_bake(s[0].eg[..], s[0].items[..], s[0].kinds[..], s[0].planted);
}
// The clips, baked once into the state's own store, sized by the bodies module so it never falls behind.
e2_bake :: (s: [] E2, d: [] figs.People) #export_c #effects(all) { figs.people_load(d); figs.bd_bake(d, s[0].bake[..], false); }
e2_layers_side :: (s: [] E2) -> int #export_c #effects(all) { return ifx s[0].width >= 840 * s[0].k then 1024 else 512; }
// Your saved character (message 16, the browser's own copy) or a kept appearance (4); the page's
// facts (600): ?at=METRES starts you that far down the path (a shot's or a test's way in).
E2_HOST_PAGE :: 600;
E2_HOST_HIDDEN :: 601;   // the page out of sight (a hidden tab, or opened in place under another page: zone-host.js)
E2_HOST_SHOWN :: 602;    // and shown again (with now= when handed over in place)
// The characters' shading quality from the page's facts: ?film draws them at the film quality
// (gpu/everglade2.coax cc_player_fs: cloth sheen, skin's wrapped light, hair's highlight), and
// ?maps=0 without their normal and ORM maps, for before/after captures.
e2_material_facts :: (s: [] E2, t: string) { s[0].film = e2c_fact_has(t, "film"); s[0].maps_off = e2c_fact_has(t, "maps=0"); }
#test "?film and ?maps=0 set the characters' shading quality" {
  s: [1] E2; e2_material_facts(s[..], "url=/worlds/character-creator?film&maps=0\n"); #assert s[0].film && s[0].maps_off;
  e2_material_facts(s[..], "url=/worlds/character-creator?filmic=1\n"); #assert !s[0].film && !s[0].maps_off;
  u: [E2_UNIFORM_FLOATS] f32; s[0].film = true; e2_material_uniforms(s[..], u[..]); #assert u[60] == 1 && u[61] == 0;
}
// u[60] the film quality, u[61] the maps off (gpu/everglade2.coax cc_player_fs).
// u[62] the canopy's baked AO at your middle (verse/everglade2/ground.coax): it shades only your indirect light.
e2_material_uniforms :: (s: [] E2, u: [] f32) { u[60] = ifx s[0].film then 1.0f32 else 0.0f32; u[61] = ifx s[0].maps_off then 1.0f32 else 0.0f32; u[62] = e2g_ao(s[0].eg[..], s[0].you_x, s[0].you_z, 1.0); }
e2_message :: (s: [] E2, kind: int, t: string) #export_c #effects(all) {
  if kind == 1 { e2c_name_type(s, t); return; }   // typed or pasted text: Character Create's NAME
  if kind == 16 { cc.load_player(s[0].creator[..], t); e2_net_look(s); return; }
  if kind == 4 { ok := cc.restore(s[0].creator[..], t); return; }
  if kind == E2C_KEPT { e2c_reply(s, t); return; }
  if kind == E2_HOST_HIDDEN || kind == E2_HOST_SHOWN { e2c_seen(s, kind == E2_HOST_SHOWN, t); return; }
  if kind == E2_HOST_PAGE {
    e2_material_facts(s, t); e2c_facts(s, t); s[0].light_view = envd.env_view_query(t);
    if !s[0].cz[0].on { at := e2_query_at(t); if at > 0 { s[0].start_z = -f32(at); } s[0].autowalk = e2_query_walk(t); }
    // a staged shot (?at=, ?walk) and a film stand where they are put: no room
    s[0].staged = s[0].start_z < 0 || s[0].autowalk || s[0].film;
    e2n_facts(s[0].net[..], t, s[0].staged);
    e2_net_look(s);
    return;
  }
  if kind >= 256 && kind < 512 { seen := e2n_event(s[0].net[..], kind, t); return; }
}
#test "a page's ?at= says how far down the path you start" {
  #assert e2_query_at("url=http://127.0.0.1:8863/worlds/everglade2?at=120\n") == 120;
  #assert e2_query_at("url=/worlds/everglade2?x=1&at=45.5&y=2\n") == 45;
  #assert e2_query_at("url=/worlds/everglade2\n") == 0 && e2_query_at("url=/worlds/everglade2?cat=9\n") == 0;
  #assert e2_query_walk("url=/worlds/everglade2?at=10&walk\n") && e2_query_walk("url=/worlds/everglade2?walk=1\n") && !e2_query_walk("url=/worlds/everglade2?sidewalk\n");
}
#test "the walk steers along the path and into the clearing" {
  for i: 0..<40 { z := -40 - f32(i) * 10; x := e2_road_x(z); hd := e2_auto_heading(x, z);
    nz := z + cos(hd) * 2; nx := x + sin(hd) * 2; #assert nz < z && e2_may_stand(nx, nz); }
  hd := e2_auto_heading(e2_clear_x(), E2_CLEAR_Z + 5); #assert cos(hd) < 0;
  // the controller then goes that way, not back up the path
  for i: 0..<8 { h := f32(i) * 0.785 - 3.1; t := e2_walk_theta(h); #assert abs(-sin(t) - sin(h)) < 0.001 && abs(-cos(t) - cos(h)) < 0.001; }
}
// ?walk: your character walks the path by itself, at a walk, and the camera eases in behind (the
// film's way to walk it; any key takes over).
e2_query_walk :: (t: string) -> bool {
  for i: 0..<t.count - 4 { if (t[i] == '?' || t[i] == '&') && t[i + 1] == 'w' && t[i + 2] == 'a' && t[i + 3] == 'l' && t[i + 4] == 'k' { return true; } }
  return false;
}
e2_query_at :: (t: string) -> int {
  for i: 0..<t.count - 3 {
    if t[i + 1] == 'a' && t[i + 2] == 't' && t[i + 3] == '=' && (t[i] == '?' || t[i] == '&') {
      v := 0; j := i + 4; while j < t.count && t[j] >= '0' && t[j] <= '9' { v = v * 10 + cast(int)(t[j] - '0'); j += 1; }
      return ifx v > 520 then 520 else v;
    }
  }
  return 0;
}

// ---- where you may stand: the glade, the path's corridor, the clearing
#test "the catalog's kit rows fill their (kit, level) buckets" {
  s: [1] E2;
  rec: [16] u8; rest: [512] u8;
  e2_catalog(s[..], "C glade/environment 9 12 250 100 8 0\nC e2/k0/0 100 30 250 100 8 0\nC e2/k0/2 130 12 250 100 8 0\nC e2/k32/0 200 6 250 100 8 0\nC e2/k33/0 1 3 250 100 8 0\n", rec[..], rest[..]);
  #assert s[0].kits && s[0].kit_first[0] == 100 && s[0].kit_count[0] == 30 && s[0].kit_count[2] == 12 && s[0].kit_count[1] == 0;
  #assert s[0].kit_first[32 * E2_LODS] == 200 && s[0].kit_count[32 * E2_LODS] == 6;
}
#test "wherever you may not go on, thick woods stand: no edge on open ground" {
  // round the glade, off the path, and along both sides of the path to the clearing
  for i: 0..<64 { a := f32(i) * 0.0982; x := cos(a) * (f32(E2_GLADE_WALK) + 0.5); z := sin(a) * (f32(E2_GLADE_WALK) + 0.5);
    if e2_may_stand(x, z) { continue; }
    #assert e2_forest(x, z) > 0.7; }
  for i: 0..<88 { z := -40 - f32(i) * 5; if e2_clearing(e2_road_x(z), z) > 0.1 { continue; }
    for side: 0..<2 { x := e2_road_x(z) + (ifx side == 0 then -1.0f32 else 1.0f32) * (f32(E2_WALK) + 0.5);
      if e2_may_stand(x, z) { continue; }
      #assert e2_forest(x, z) > 0.7; } }
  // and round the clearing
  for i: 0..<64 { a := f32(i) * 0.0982; r := f32(E2_CLEAR_R) * 1.2; x := e2_clear_x() + cos(a) * r; z := E2_CLEAR_Z + sin(a) * r;
    if e2_may_stand(x, z) || e2_road_dist(x, z) < f32(E2_WALK) + 1 { continue; }
    #assert e2_forest(x, z) > 0.7; }
}
// Where the step leaves you, from where you stood (everglade2-move.coax e2m_keep).
e2_keep :: (s: [] E2, x: f32, z: f32) -> figs.Point #export_c #effects(all) { k := e2m_keep(x, z, s[0].you_x, s[0].you_z); return figs.v3(k.x, 0, k.z); }
// Kept where you may stand from where the step began (fx, fz): the room keeps you so (room-world.c world2_step).
e2_keep_from :: (s: [] E2, x: f32, z: f32, fx: f32, fz: f32) -> figs.Point #export_c #effects(all) { k := e2m_keep(x, z, fx, fz); return figs.v3(k.x, 0, k.z); }

// ---- the controller's half of a step (everglade2-face.c)
hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_W; } if key == 'a' || key == 'A' { return HOLD_A; }
  if key == 's' || key == 'S' { return HOLD_S; } if key == 'd' || key == 'D' { return HOLD_D; }
  if key == KEY_LEFT { return HOLD_LEFT; } if key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_UP { return HOLD_UP; } if key == KEY_DOWN { return HOLD_DOWN; }
  if key == '=' || key == '+' { return HOLD_IN; } if key == '-' || key == '_' { return HOLD_OUT; }
  return 0;
}
axis :: (held: int, plus: int, minus: int) -> f32 { a: f32 = 0; if held & plus != 0 { a += 1; } if held & minus != 0 { a -= 1; } return a; }
// The point the walk steers for: 5 m on along the path, or the clearing's middle once there.
e2_auto_heading :: (x: f32, z: f32) -> f32 {
  if z < E2_CLEAR_Z + 10 { cx := e2_clear_x(); return figs.atan2(cx - x, E2_CLEAR_Z - 12 - z); }
  tz := z - 5; return figs.atan2(e2_road_x(tz) - x, tz - z);
}
// The controller's theta is the camera's (walk.coax: forward goes along -(sin theta, cos theta));
// a heading is the way you face, along (sin, cos).
e2_walk_theta :: (heading: f32) -> f32 { return figs.wrap_angle(heading + 3.14159265); }
e2_move_in :: (s: [] E2) -> EgMoveIn #export_c #effects(all) {
  h := s[0].held;
  // Character Create: still in the studio; on the run, on down the path on its own, at a jog
  if e2c_creating(s) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
  if e2c_running(s) { return EgMoveIn.{key_y = 1, theta = e2_walk_theta(e2_auto_heading(s[0].you_x, s[0].you_z))}; }
  if s[0].autowalk && h == 0 {
    if s[0].you_z < E2_CLEAR_Z - 6 { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
    // run is the keys' Shift: the keys run by default (aethyr/input.coax), so this walks
    return EgMoveIn.{key_y = 1, run = true, theta = e2_walk_theta(e2_auto_heading(s[0].you_x, s[0].you_z))};
  }
  if h != 0 { s[0].autowalk = false; }
  // asleep, as the room's rules hold you: your keys move nothing until you wake (WATCH, END)
  if e2n_asleep(s[0].net[..]) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
  return EgMoveIn.{key_x = axis(h, HOLD_D, HOLD_A), key_y = axis(h, HOLD_W, HOLD_S), run = s[0].shift, jump = h & HOLD_JUMP != 0,
                   theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)};
}
// The trunks and rocks round you (everglade2-move.coax e2m_world, which the room steps by too).
e2_move_world :: (s: [] E2, x: f32, z: f32) -> EgMoveWorld #export_c #effects(all) {
  return e2m_world(s[0].items[..], s[0].kinds[..], s[0].first[..], s[0].plant_done, s[0].move_bodies[..], x, z);
}
#test "the body's gait reads Everglade II's jog and stroll as a run and a walk" {
  #assert f32(E2_RUN_SPEED) > f32(figs.BD_RUN_FROM) + 0.5 && f32(E2_WALK_SPEED) < f32(figs.BD_RUN_FROM) && f32(E2_WALK_SPEED) > f32(figs.BD_WALK_FROM);
}
e2_move_bodies :: (s: [] E2) -> [] f32 #export_c #effects(all) { return s[0].move_bodies[..]; }
// Where the step left you: the controller walks a level plane, the land lifts you onto the ground.
e2_you :: (s: [] E2, x: f32, y: f32, z: f32, face: f32) #export_c #effects(all) {
  s[0].you_x = x; s[0].jump = y; s[0].you_z = z; s[0].you_face = face; s[0].you_y = e2g_y(s[0].eg[..], x, z) + y;   // the admitted triangles in the glade
  e2_air(s, y > f32(E2_AIRBORNE));
}
// ---- the jump (ported from Everglade Experimental, charactercreator.coax experimental_*): the
// takeoff plays over E2_TAKEOFF seconds, the loop while you are up, the landing over E2_LANDING, all
// blended at E2_JUMP_BLEND over the gait, so the legs keep their stride and the arms never fully change.
E2_AIRBORNE :: 0.03;   // metres over the ground that count as off it
E2_TAKEOFF :: 0.2; E2_LANDING :: 0.35;
E2_JUMP_BLEND :: 0.45; E2_JUMP_IN :: 0.12; E2_JUMP_OUT :: 0.18;
e2_air :: (s: [] E2, air: bool) {
  if air && !s[0].airborne { s[0].air_at = s[0].clock; }
  if !air && s[0].airborne { s[0].land_at = s[0].clock; }
  s[0].airborne = air;
}
// The jump clip at `clock`, or -1 once you have landed.
e2_jump_clip :: (air: bool, clock: f32, air_at: f32, land_at: f32) -> int {
  if air { return ifx clock - air_at < f32(E2_TAKEOFF) then figs.BD_JUMP_START else figs.BD_JUMP_LOOP; }
  if clock - land_at < f32(E2_LANDING) { return figs.BD_JUMP_LAND; }
  return -1;
}
e2_sat :: (v: f32) -> f32 { return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v; }
e2_jump_weight :: (air: bool, clock: f32, air_at: f32, land_at: f32) -> f32 {
  if air { return f32(E2_JUMP_BLEND) * e2_sat((clock - air_at) / f32(E2_JUMP_IN)); }
  return f32(E2_JUMP_BLEND) * (1 - e2_sat((clock - land_at) / f32(E2_JUMP_OUT)));
}
// The figure to draw: the gait bd_step chose, under the jump while you are up or just down. It is a
// copy, so bd_step's own clip and stride carry on beneath it.
e2_jump_figure :: (a0: figs.BdAnim, air: bool, clock: f32, air_at: f32, land_at: f32) -> figs.BdAnim {
  j := e2_jump_clip(air, clock, air_at, land_at);
  if j < 0 || a0.clip < 0 { return a0; }
  a := a0;
  a.prev = a0.clip; a.pt0 = a0.t0; a.pphase = a0.phase;
  a.clip = j;
  a.t0 = ifx j == figs.BD_JUMP_START then clock - (clock - air_at) * figs.bd_seconds(j) / f32(E2_TAKEOFF)
    else ifx j == figs.BD_JUMP_LAND then clock - (clock - land_at) * figs.bd_seconds(j) / f32(E2_LANDING) else 0.0f32;
  a.phase = clock / figs.bd_seconds(j);
  a.fade_at = clock - f32(figs.BD_FADE) * e2_jump_weight(air, clock, air_at, land_at);
  return a;
}
#test "a jump picks takeoff, the air and landing, then gives the gait back" {
  #assert e2_jump_clip(true, 1, 1, -100) == figs.BD_JUMP_START;
  #assert e2_jump_clip(true, 1.3, 1, -100) == figs.BD_JUMP_LOOP;
  #assert e2_jump_clip(false, 1.4, 1, 1.4) == figs.BD_JUMP_LAND;
  #assert e2_jump_clip(false, 2, 1, 1.4) == -1;
}
#test "a jump eases in over the gait and back out after landing" {
  #assert e2_jump_weight(true, 1, 1, -100) == 0;
  w := e2_jump_weight(true, 1.06, 1, -100); #assert w > 0 && w < 0.45;
  #assert abs(e2_jump_weight(true, 1.3, 1, -100) - 0.45) < 0.001;
  w = e2_jump_weight(false, 1.39, 1, 1.3); #assert w > 0 && w < 0.45;
  #assert e2_jump_weight(false, 1.49, 1, 1.3) == 0;
  g: figs.BdAnim; g.clip = figs.BD_RUN; g.t0 = 0.5; g.phase = 2.25;
  a := e2_jump_figure(g, true, 1.3, 1, -100);
  #assert a.clip == figs.BD_JUMP_LOOP && a.prev == figs.BD_RUN && a.pphase == 2.25;
  out: [24] f32; figs.bd_record(a, figs.BdLook.{}, 0, false, 1.3, out[..], 0); #assert out[6] > 0.55 && out[6] < 0.60;
  // landed and settled: the gait as it was
  b := e2_jump_figure(g, false, 2, 1, 1.3); #assert b.clip == figs.BD_RUN && b.fade_at == g.fade_at;
  s: [1] E2; s[0].clock = 1; e2_you(s[..], 0, 0.5, 0, 0); #assert s[0].airborne && s[0].air_at == 1;
  s[0].clock = 1.8; e2_you(s[..], 0, 0, 0, 0); #assert !s[0].airborne && s[0].land_at == 1.8;
}
e2_start :: (s: [] E2) -> bool #export_c #effects(all) {
  s[0].view = e2_mode();
  if s[0].placed { return false; }
  // the glade's spot, or ?at='s point on the path, facing on along it
  z := s[0].start_z; x := ifx z < 0 then e2_road_x(z) else 0.0f32;
  face := ifx z < 0 then figs.atan2(e2_road_x(z - 2) - x, -2.0f32) else 3.14159265f32;
  s[0].placed = true; s[0].you_x = x; s[0].you_z = z; s[0].you_face = face; s[0].you_y = e2_height(x, z);
  s[0].orbit = figs.verse_orbit_start(figs.v3(x, s[0].you_y, z), face);
  return true;
}

// ---- input
e2_key :: (s: [] E2, key: int, mods: int) -> bool #export_c #effects(all) {
  if e2c_key(s, key) { return true; }
  if e2k_key(s, key) { return true; }
  if key == ' ' { s[0].held |= HOLD_JUMP; return true; }
  if key == KEY_SHIFT { s[0].shift = true; return true; }
  h := hold_bit(key); if h != 0 { s[0].held |= h; return true; }
  return false;
}
e2_key_up :: (s: [] E2, key: int, mods: int) -> bool #export_c #effects(all) {
  if key == KEY_SHIFT { s[0].shift = false; }
  h := ifx key == ' ' then HOLD_JUMP else hold_bit(key);
  s[0].held = s[0].held & (HOLD_ALL - h); return h != 0;
}
e2_blur :: (s: [] E2) #export_c #effects(all) { s[0].held = 0; s[0].shift = false; s[0].dragging = false; }
// A mouse drag looks round (a finger is the face's: aethyr/sticks.coax).
e2_pointer :: (s: [] E2, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  if e2c_pointer(s, x, y, phase, id) { return true; }
  if e2k_pointer(s, x, y, phase) { return true; }
  if kind != 0 { return false; }
  if phase == 0 { s[0].dragging = true; s[0].drag_x = x; s[0].drag_y = y; return true; }
  if phase == 1 && s[0].dragging {
    s[0].look_yaw -= (x - s[0].drag_x) / s[0].k * f32(E2_LOOK_DRAG); s[0].look_pitch -= (y - s[0].drag_y) / s[0].k * f32(E2_LOOK_DRAG);
    s[0].drag_x = x; s[0].drag_y = y; return true;
  }
  if phase == 2 { s[0].dragging = false; return true; }
  return false;
}
e2_wheel :: (s: [] E2, dy: f32) -> bool #export_c #effects(all) {
  if e2c_wheel(s, dy) { return true; }
  d := ifx dy > 400 then 400.0f32 else ifx dy < -400 then -400.0f32 else dy;
  s[0].orbit = figs.verse_orbit_zoom(s[0].orbit, d * f32(E2_WHEEL_ZOOM)); return true;
}
e2_look :: (s: [] E2, dyaw: f32, dpitch: f32, zoom: f32) #export_c #effects(all) {
  s[0].look_yaw += dyaw; s[0].look_pitch += dpitch;
  if zoom != 0 { s[0].orbit = figs.verse_orbit_zoom(s[0].orbit, zoom * f32(E2_WHEEL_ZOOM)); }
}

// ---- the frame: the follow camera, the uniforms
// ---- the look up: Aethyr's centred follow mode (aethyr/cam/modes.coax, #12994), first written here
// from Everglade Experimental's camera. The pitch goes 1.2 rad above the horizon (the shared orbit
// stops at 0.55). The eye sits on a line straight back from your head, centred on you at every pitch.
// Looking up swings the eye down behind you until it meets the land, 0.2 m over it; past that the eye
// holds where it met the ground and the look tilts on up, the aim rising up to 2 m over your head, as
// a camera pressed to the ground does in WoW. Nothing jumps as the eye reaches the ground.
// The mode's record: the shared defaults are Everglade II's.
e2_mode :: () -> figs.CamMode { return figs.CamMode.{id = figs.CamModeId.follow}; }
E2_CAM_REACH :: 13.0;   // metres of land round the pivot the camera's ground ring holds (the farthest zoom and a cell)
// The camera's ring of land round p, from the land itself (e2_height): only the cells it lacks.
e2_cam_ground :: (s: [] E2, p: figs.Point) {
  cells: [7000] int;
  n := figs.cam_ground_next(s[0].ground[..], p.x, p.z, f32(E2_CAM_REACH), cells[..]);
  for k: 0..<n { i := cells[k * 2]; j := cells[k * 2 + 1]; figs.cam_ground_put(s[0].ground[..], i, j, e2_height(figs.cam_ground_x(s[0].ground[..], i), figs.cam_ground_x(s[0].ground[..], j))); }
}
// What to draw: the mode's shot of the orbit.
e2_shot :: (s: [] E2) -> figs.Shot { return figs.cam_shot(s[0].view, s[0].orbit, s[0].eye_pitch, s[0].press); }
#test "a drag looks up past the horizon, centred on you; on the land the eye holds and the view tilts on up" #steps 400000000 {
  s: [1] E2; s[0].k = 1; s[0].plant_done = true;
  e2_you(s[..], 0, 0, 0, 3.14159265); s[0].orbit = figs.verse_orbit_start(figs.v3(0, s[0].you_y, 0), 3.14159265);
  s[0].orbit.want = 4; s[0].orbit.zoom = 4; s[0].view = e2_mode();
  // from looking down to looking up, a step at a time: centred, over the land, and no jump
  last := figs.Shot.{}; lastp := -1.0f32; pressed := false;
  _ := e2_pointer(s[..], 700, 0, 0, 0, 1);
  for i: 0..<120 {
    _ = e2_pointer(s[..], 700, f32(900 - i * 15), 1, 0, 1);
    e2_follow(s[..], 1.0f32 / 30);
    shot := e2_shot(s[..]);
    #assert figs.cam_off_axis(shot, s[0].you_x, s[0].you_z) < 0.01;
    #assert shot.eye.y >= e2_height(shot.eye.x, shot.eye.z) + 0.19;
    if s[0].press > 0 { pressed = true; }
    if i > 1 {
      // each step turns the pitch 0.08 rad: the eye moves a little round the orbit, and the aim lifts a little
      dx := shot.eye.x - last.eye.x; dy := shot.eye.y - last.eye.y; dz := shot.eye.z - last.eye.z;
      #assert sqrt(dx * dx + dy * dy + dz * dz) < 0.4;
      #assert abs(s[0].press - lastp) < 0.1;
    }
    last = shot; lastp = s[0].press;
  }
  _ = e2_pointer(s[..], 700, 0, 2, 0, 1);
  #assert pressed && s[0].orbit.pitch < -1.0 && s[0].orbit.pitch >= -1.2;
  // all the way up on the land: the eye stays back from you (you don't fill the view), and it
  // looks up over your head, so you stand low in the middle of the screen
  shot := e2_shot(s[..]);
  ex := s[0].you_x - shot.eye.x; ez := s[0].you_z - shot.eye.z;
  #assert sqrt(ex * ex + ez * ez) > 2.5;
  vx := shot.at.x - shot.eye.x; vy := shot.at.y - shot.eye.y; vz := shot.at.z - shot.eye.z; vl := sqrt(vx * vx + vy * vy + vz * vz);
  #assert vy / vl > 0.3;
  // your head is below the view's middle
  hx := s[0].you_x - shot.eye.x; hy := s[0].you_y + 1.7 - shot.eye.y; hz := s[0].you_z - shot.eye.z; hl := sqrt(hx * hx + hy * hy + hz * hz);
  #assert hy / hl < vy / vl;
}
e2_follow :: (s: [] E2, dt: f32) {
  if s[0].autowalk || e2c_running(s) {
    // the camera eases round behind the walk (and Character Create's run)
    want := e2_auto_heading(s[0].you_x, s[0].you_z);
    turn := figs.wrap_angle(want - s[0].orbit.yaw);
    s[0].orbit.yaw = figs.wrap_angle(s[0].orbit.yaw + turn * (ifx dt * 1.5 < 1 then dt * 1.5 else 1.0f32));
  }
  // the turn is the shared orbit's; the tilt is Everglade II's own, up to E2_PITCH_UP above the horizon
  o := figs.verse_orbit_look(s[0].orbit, s[0].look_yaw, 0);
  h := s[0].held;
  o = figs.verse_orbit_keys(o, axis(h, HOLD_LEFT, HOLD_RIGHT), 0, dt);
  tilt := s[0].look_pitch + axis(h, HOLD_UP, HOLD_DOWN) * f32(figs.FREE_KEY_TURN) * 0.6 * (ifx dt < 0.25 then dt else 0.25f32);
  s[0].look_yaw = 0; s[0].look_pitch = 0;
  mode := s[0].view;
  if tilt != 0 { o.pitch = figs.cam_pitch(mode, o, o.pitch - tilt); o.idle = 0; }
  if axis(h, HOLD_OUT, HOLD_IN) != 0 { o = figs.verse_orbit_zoom(o, axis(h, HOLD_OUT, HOLD_IN) * 6 * (ifx dt < 0.1 then dt else 0.1f32)); }
  feet := figs.v3(s[0].you_x, s[0].you_y, s[0].you_z);
  sp := s[0].anim[0].speed;
  p0 := o.pitch;
  o = figs.verse_orbit_follow(o, feet, s[0].you_face, sp > 0.6, dt);
  // the shared follow eases a look past its own range back into it; here a look up holds until the
  // walk's own recentring, a while after the last look
  if p0 < f32(figs.FREE_PITCH_MIN) && !(sp > 0.6 && o.idle >= f32(figs.FREE_RECENTRE_AFTER)) { o.pitch = figs.cam_pitch(mode, o, p0); }
  // the eye's line, straight back from your head; on the land the eye holds where it met it
  e2_cam_ground(s, o.pivot);
  // and in front of the trunks between the eye and you: three spheres up each trunk near the ray
  spheres: [E2_CAM_TRUNKS * 3 * 4] f32; sn := 0; pv := o.pivot;
  ci := cast(int) floor((pv.x - f32(E2_CELL_X0)) / f32(E2_CELL)); cj := cast(int) floor((f32(E2_CELL_Z0) - pv.z) / f32(E2_CELL));
  for dj: -1..<2 { for di: -1..<2 {
    i := ci + di; j := cj + dj;
    if i < 0 || j < 0 || i >= E2_CELLS_X || j >= E2_CELLS_Z || !s[0].plant_done { continue; }
    c := j * E2_CELLS_X + i;
    for q: s[0].first[c]..<s[0].first[c + 1] {
      kit := cast(int) s[0].kinds[q];
      if kit >= E2_TREES || sn >= E2_CAM_TRUNKS { continue; }
      qo := q * E2_ITEM_FLOATS; px := s[0].items[qo]; pz := s[0].items[qo + 2];
      if (px - pv.x) * (px - pv.x) + (pz - pv.z) * (pz - pv.z) > 100 { continue; }
      // a pine's boughs reach out at the eye's height; the others' crowns start above it
      r := ifx kit >= 10 then 2.2 * s[0].items[qo + 5] else 0.30 * s[0].items[qo + 5] + 0.35;
      for k: 0..<3 { m := (sn * 3 + k) * 4; spheres[m] = px; spheres[m + 1] = pv.y - 0.5 + f32(k) * 1.6; spheres[m + 2] = pz; spheres[m + 3] = r; }
      sn += 1;
    }
  }}
  c := figs.cam_centred(mode, s[0].ground[..], o, spheres[0..<sn * 12]);
  s[0].eye_pitch = c.eye_pitch; s[0].press = c.press;
  s[0].orbit = figs.verse_orbit_limit(o, c.room, dt);
}
// ---- the graphics governor (aethyr/quality.coax, as Everglade's everglade-quality.coax): in AUTO
// it draws fewer pixels when frames run long and more again when they keep on time, so the page
// holds 60 frames a second. The face asks it for the host's pixel budget.
e2_quality_frame :: (s: [] E2, dt: f32, w: f32, h: f32, dpr: f32) #export_c #effects(all) {
  if !s[0].q_ready {
    if w < 1 || h < 1 { return; }
    d: QualityDevice; k := ifx dpr > 0.01 then dpr else 1.0f32;
    d.css_w = w / k; d.css_h = h / k; d.dpr = k;
    quality_start(s[0].q[..], d, QUALITY_AUTO); s[0].q_ready = true; return;
  }
  _ := quality_frame(s[0].q[..], dt);
}
e2_pixel_budget :: (s: [] E2, w: f32, h: f32, dpr: f32) -> int #export_c #effects(all) {
  if !s[0].q_ready { return 6400000; }
  k := ifx dpr > 0.01 then dpr else 1.0f32;
  return quality_pixels(s[0].q[..], w / k, h / k);
}
// ---- the frame rate, bottom right, always shown: frames over the last half second or so
e2_fps_count :: (s: [] E2, dt: f32) {cc.fps_count(s[0].fps_counter[..],dt);}
e2_fps :: (s: [] E2, out: [] f32, at: int, dt: f32) -> int {
 e2_fps_count(s,dt);h:=s[0].height;k:=s[0].k;
 // on a phone's studio it sits over the bottom buttons (RESET, SURPRISE ME), not on them
 if s[0].cz[0].mobile && e2c_shown(s)>0.003 {h=s[0].cz[0].boxes[13].y0+10*k;}
 if s[0].cz[0].arriving && e2c_shown(s)<0.5 {return at;}   // through the portal: with the wardrobe
 return cc.fps_draw(s[0].fps_counter[0],out,at,s[0].width,h,k);
}
#test "the frame rate is the frames over the last half second" {
  s: [1] E2;
  for i: 0..<40 { e2_fps_count(s[..], 1.0f32 / 60); }
  #assert abs(s[0].fps_counter[0].fps - 60) < 0.5;
  // slowed to 30: within a second it says so
  for i: 0..<30 { e2_fps_count(s[..], 1.0f32 / 30); }
  #assert abs(s[0].fps_counter[0].fps - 30) < 0.5;
}
e2_frame :: (s: [] E2, out: [] f32, u: [] f32, w: f32, h: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  if u.count < E2_UNIFORM_FLOATS || w < 1 || h < 1 { return 0; }
  s[0].width = w; s[0].height = h; s[0].k = ifx dpr < 0.5 then 0.5f32 else dpr; s[0].media_n = 0;
  cc.ensure(s[0].creator[..]); s[0].creator[0].clock = s[0].clock;
  e2c_action(s);
  if !s[0].plant_done {
    s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  }
  if !s[0].ground_done && s[0].catalog_in { e2_ground(s); }
  step := ifx still || dt <= 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].clock += step;
  e2_follow(s, step);
  e2c_arrive_step(s, step);
  shot := e2c_shot(s, figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), e2_shot(s), step);
  f := [3]f32.[shot.at.x - shot.eye.x, shot.at.y - shot.eye.y, shot.at.z - shot.eye.z];
  l := sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]); if l < 0.0001 { l = 1; } for q: 0..<3 { f[q] /= l; }
  r := [3]f32.[-f[2], 0, f[0]]; rl := sqrt(r[0] * r[0] + r[2] * r[2]); if rl < 0.0001 { rl = 1; } r[0] /= rl; r[2] /= rl;
  up := [3]f32.[r[1] * f[2] - r[2] * f[1], r[2] * f[0] - r[0] * f[2], r[0] * f[1] - r[1] * f[0]];
  fy := (w / h) * 1.25; fy = ifx fy < 0.95 then 0.95f32 else ifx fy > 1.9 then 1.9f32 else fy;
  lens := e2c_lens(s, fy * h / 2, h * 0.5);
  s[0].focal = lens[0]; s[0].cy = lens[1];
  s[0].eye = [3]f32.[shot.eye.x, shot.eye.y, shot.eye.z]; s[0].fwd = f; s[0].right = r; s[0].up = up;
  // the shadow casters' centre: the eye (e2_shadows draws the tiles round it)
  s[0].shade = [3]f32.[shot.eye.x, shot.eye.y, shot.eye.z];
  for i: 0..<u.count { u[i] = 0; }
  u[0] = w; u[1] = h; u[2] = s[0].clock; u[3] = 1; u[4] = s[0].k; u[10] = 2; u[11] = 1;
  for q: 0..<3 { u[16 + q] = s[0].eye[q]; u[20 + q] = f[q]; u[24 + q] = r[q]; u[28 + q] = up[q]; u[44 + q] = s[0].shade[q]; }
  u[19] = s[0].focal; u[23] = w * 0.5; u[27] = lens[1];
  e2_light(s, u);
  u[48] = f32(s[0].creator[0].glade_word);
  e2c_uniforms(s, u);
  e2c_arrive_uniforms(s, u);
  e2_material_uniforms(s, u);
  u[E2_U_LIGHT_VIEW] = envd.env_view_word(s[0].light_view);
  e2_shadows(s, u);
  e2k_set_class(s[0].casts[..], e2c_class_of(s), e2c_level_of(s)); e2n_set_class(s[0].net[..], e2c_class_of(s), e2c_level_of(s));
  e2k_step(s);
  return e2_light_hud(s, out, e2_fps(s, out, e2_plates(s, out, e2k_hud(s, out, e2c_hud(s, out))), dt));
}

// ---- the light (lighting plan Phase 1, #13066): every lit input the passes read is the camera's
// resolved environment, written each frame at E2_U_ENV (gpu/everglade2.coax through the cg_* names,
// aethyr/render/painterly.coax paint_env_*). The world's set is e2_environment_set: the glade (the
// painterly default) with the sunlit path's and the deep canopy's deltas; its day is the room's (W: the room's ms into its day at a tick,
// aethyr/world/day.coax day_from_room), or the glade's fixed noon before a room is heard and in a
// shot or Character Create, which open none. The key's shadow tiles look along the same direction.
// The world's set (verse/everglade2/environment.coax), admitted whole once.
e2_env_route :: (e: [] envf.EnvFrame) { next: [1] EnvironmentSet; next[0] = e2_environment_set(); _ := envf.env_frame_admit(e, next[..]); }
e2_light :: (s: [] E2, u: [] f32) {
  e := s[0].env[..];
  if !e[0].admitted { e2_env_route(e); }
  n := s[0].net[..]; tick: s64 = 0;
  if n[0].w_day >= 0 && n[0].worlds > 0 {
    _ := envf.env_frame_room(e, cast(s64) n[0].w_tick, cast(u32) n[0].hz, cast(s64) n[0].w_day, WIRE_DAY_MS);
    tick = cast(s64) (ifx n[0].tick > n[0].w_tick then n[0].tick else n[0].w_tick);
  }
  _ := envf.env_frame_write_eye(e, tick, s[0].eye[0], s[0].eye[1], s[0].eye[2], u, E2_U_ENV);
  envf.env_frame_sky_halo(u, 32);
  if s[0].light_view != envd.ENV_VIEW_OFF { read := envd.env_debug_read(e, tick, EnvDir.{x = s[0].eye[0], y = s[0].eye[1], z = s[0].eye[2]}, s[0].light_text[..]); }
}
// ?light=VIEW's readout, top left: the camera's region weights by profile id, its ambient, key and
// grade (aethyr/render/environment-debug.coax). Nothing without the query.
e2_light_hud :: (s: [] E2, out: [] f32, at: int) -> int {
  if s[0].light_view == envd.ENV_VIEW_OFF { return at; }
  t := s[0].light_text[..]; k := s[0].k; cap := 11 * k; v := at; ink := cc.ink(k, 0.95, 0.93, 0.82);
  v = cc.text(out, v, "LIGHT", 16 * k, 16 * k, cap, ink);
  v = cc.text(out, v, envd.ENV_VIEW_NAMES[s[0].light_view], 70 * k, 16 * k, cap, ink);
  for l: 0..<t[0].count { v = cc.text(out, v, envd.envd_line(t, l), 16 * k, (36 + 18 * f32(l)) * k, cap, ink); }
  return v;
}
#test "?light=VIEW turns on one light view and its readout; without it nothing changes" {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32; s[0].eye = [3]f32.[2, 3, 5];
  e2_message(s[..], E2_HOST_PAGE, "url=/worlds/everglade2?at=60\n"); #assert s[0].light_view == envd.ENV_VIEW_OFF;
  e2_light(s[..], u[..]); #assert s[0].light_text[0].count == 0 && envd.env_view_word(s[0].light_view) == 0;
  e2_message(s[..], E2_HOST_PAGE, "url=/worlds/everglade2?at=60&light=ambient\n"); #assert s[0].light_view == envd.ENV_VIEW_AMBIENT;
  e2_light(s[..], u[..]); #assert s[0].light_text[0].count == 6 && envd.envd_line(s[0].light_text[..], 0) == "REGIONS 1:1.000*";
  #assert envd.env_view_word(s[0].light_view) == 1;
  // the record the shaders read is the same with a view on
  g := envf.env_frame_glade_words(); for i: 0..<envf.ENV_FRAME_FLOATS { #assert u[E2_U_ENV + i] == g[i]; }
}
#test "every frame writes the camera's environment: the glade's noon in the glade, the canopy's in the woods" {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32;
  s[0].eye = [3]f32.[2, 3, 5];
  e2_light(s[..], u[..]);
  g := envf.env_frame_glade_words();
  for i: 0..<envf.ENV_FRAME_FLOATS { #assert u[E2_U_ENV + i] == g[i]; }
  #assert u[32] == -0.45f32 && u[33] == 0.78f32 && u[34] == -0.42f32 && s[0].env[0].writes == 1 && s[0].env[0].refusals == 0;
  // the shadow tiles look along the record's key: the glade's sun, made unit
  l := s[0].env[0].held.dir; m := sqrt(0.40f32 * 0.40f32 + 0.58f32 * 0.58f32 + 0.62f32 * 0.62f32);
  #assert l.x == -0.40f32 / m && l.y == 0.58f32 / m && l.z == -0.62f32 / m;
  // a room heard: its day (the glade is one knot, so the same light) from the room's clock
  s[0].net[0].w_day = 1440000; s[0].net[0].worlds = 1; s[0].net[0].w_tick = 9000; s[0].net[0].hz = 30; s[0].net[0].tick = 9030;
  e2_light(s[..], u[..]);
  #assert s[0].env[0].clock.seconds == 2880 && s[0].env[0].clock.hz == 30 && s[0].env[0].refusals == 0 && s[0].env[0].writes == 2;
  // the time of day is the room's (word 3), 30 ticks past its noon; every light word is the glade's
  #assert abs(u[E2_U_ENV + 3] - (0.5f32 + 1.0f32 / 2880)) < 0.00001;
  for i: 0..<envf.ENV_FRAME_FLOATS { if i != 3 { #assert u[E2_U_ENV + i] == g[i]; } }
  // deep in the woods, the canopy's delta: some light words move, the record is written, none refused
  p := e2_env_on_path(-300, 1.7); s[0].eye = [3]f32.[p.x, p.y, p.z];
  e2_light(s[..], u[..]); off := 0;
  for i: 4..<envf.ENV_FRAME_FLOATS { if u[E2_U_ENV + i] != g[i] { off += 1; } }
  #assert off > 0 && s[0].env[0].writes == 3 && s[0].env[0].refusals == 0 && u[32] == -0.45f32;
}
// ---- the key light's shadow tiles (aethyr/render/cascades.coax, #13016, as Everglade's)
// The host makes one depth atlas of up to four tiles (two on a phone), each a ring further out round
// the eye. A tile's middle snaps to a whole number of its texels in the light's own space and it is
// drawn again only once the eye has walked past that step, so every shadow stays fixed to the land:
// a tile never slides under it. The nearest tile is drawn every frame (your character moves in it);
// at most one other tile a frame. Its casters are the pieces as the view draws them, at the same
// levels (e2_pieces casting).
// The tiles look along the key the frame's environment resolved (e2_light: the record's unit direction).
e2_shadows :: (s: [] E2, u: [] f32) {
  c := s[0].casc[..];
  for i: 0..<CASCADE_BLOCK { u[E2_U_CASCADE + i] = 0; }
  if !c[0].on { return; }
  l := s[0].env[0].held.dir;
  _ := cascade_frame(c, s[0].eye[0], s[0].eye[2], l.x, l.y, l.z, true);
  // the filter: 2.5 texels of a 2048 map over 68 m, the same metres of penumbra in every tile
  cascade_rows(c[0], u[E2_U_CASCADE..<E2_U_CASCADE + CASCADE_BLOCK], 2.5, 68.0f32 / 2048, 34);
}
// How far round the eye a tile's casters reach: its own reach across its diagonal and its leash,
// and the tallest tree's shadow beside it.
e2_cast_reach :: (s: [] E2) -> f32 {
  c := s[0].casc[0];
  if !c.on || c.draw < 0 { return 0; }
  return c.tier.reach[c.draw] * 1.42 + cascade_leash(c.tier, c.draw) + 20;
}
// Whether a piece standing at p, up to h tall, can throw its shadow into the tile drawn this frame:
// its span up the light's view (base to top) crosses the tile's square, with room for its crown.
e2_casts_into :: (s: [] E2, x: f32, y: f32, z: f32, h: f32) -> bool {
  c := s[0].casc[0];
  if !c.on || c.draw < 0 { return false; }
  q := c.slot[c.draw]; a := cascade_axes(q.lx, q.ly, q.lz); r := c.tier.reach[c.draw] + h * 0.35 + 1;
  across := x * a.axx + z * a.axz - q.cx;
  if across < -r || across > r { return false; }
  up0 := x * a.ayx + y * a.ayy + z * a.ayz - q.cy; up1 := up0 + a.ayy * h;
  lo := ifx up0 < up1 then up0 else up1; hi := ifx up0 < up1 then up1 else up0;
  return hi >= -r && lo <= r;
}
// The host's side (the face's coaxial_shadow_*_v1, coax/web/host.js), as Everglade's
// (everglade.coax everglade_shadow_field): the atlas in texels (`which` 0 across, 1 down; a phone's
// when `coarse`); field 0 the tile drawn this frame (-1 none), 1 to 4 its rect in texels, 5 the
// host's character pass (none here: your character is in the shadow list), 6 the tiles, 7 those
// cleared first, 16 + 4 k to 19 + 4 k tile k's rect; events 0 the atlas made (arg 1 a phone's),
// 1 geometry installed, 2 this frame's tile not drawn.
e2_shadow_atlas :: (s: [] E2, coarse: int, which: int) -> int #export_c #effects(all) { return cascade_atlas(coarse != 0, which); }
e2_shadow_field :: (s: [] E2, field: int) -> int #export_c #effects(all) {
  c := s[0].casc[0];
  if !c.on { return -1; }
  if field == 6 { return c.tier.count; }
  if field >= 16 && field < 16 + 4 * c.tier.count { j := (field - 16) % 4; return cascade_rect_px(c.tier, (field - 16) / 4, ifx j <= 1 then j else 2); }
  d := c.draw;
  if field == 0 { return d; }
  if d < 0 { return -1; }
  if field >= 1 && field <= 4 { return cascade_rect_px(c.tier, d, ifx field <= 2 then field - 1 else 2); }
  if field == 5 { return 0; }
  if field == 7 { return 1 << cast(u64) d; }
  return -1;
}
e2_shadow_event :: (s: [] E2, kind: int, arg: int) #export_c #effects(all) {
  c := s[0].casc[..];
  if kind == 0 { cascade_open(c, arg != 0); } else if kind == 1 { cascade_stale(c); } else if kind == 2 { cascade_dropped(c); }
}
#test "Everglade II's shadow tiles: snapped to the light's texels, redrawn only past a step, the near one every frame" #steps 400000000 {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32;
  #assert e2_shadow_field(s[..], 0) == -1;
  e2_shadow_event(s[..], 0, 0);
  #assert e2_shadow_field(s[..], 6) == 4 && e2_shadow_atlas(s[..], 0, 0) == 2048;
  // standing still: every tile is drawn once, then only the near one
  s[0].eye = [3]f32.[3, 2, -150];
  e2_light(s[..], u[..]);   // the frame writes the light first: the tiles look along its key
  drawn: [4] int;
  for f: 0..<40 { e2_shadows(s[..], u[..]); d := e2_shadow_field(s[..], 0); if d >= 0 { drawn[d] += 1; } }
  #assert drawn[0] >= 30 && drawn[1] == 1 && drawn[2] == 1 && drawn[3] == 1;
  // a tile's middle is a whole number of its texels along the light's axes
  for k: 0..<4 { q := s[0].casc[0].slot[k]; e := cascade_texel(s[0].casc[0].tier, k);
    #assert abs(q.cx / e - floor(q.cx / e + 0.5)) < 0.01 && abs(q.cy / e - floor(q.cy / e + 0.5)) < 0.01; }
  // the far tile holds still while the eye walks less than its step
  far := s[0].casc[0].slot[3];
  for f: 0..<60 { s[0].eye[2] -= 0.05; e2_shadows(s[..], u[..]); }
  #assert s[0].casc[0].slot[3].cx == far.cx && s[0].casc[0].slot[3].cy == far.cy;
  #assert u[E2_U_CASCADE] == 4;
}
// ---- the scene: the glade's records and draws, your character, the kit pieces in view
e2_rec_clear :: (s: [] E2, n: int) { for k: 0..<24 { s[0].records[n * 24 + k] = 0; } }
e2_draw :: (d: [] u32, n: int, first: int, count: int, base: int, instances: int) -> int {
  if n >= E2_DRAWS || count <= 0 || instances <= 0 { return n; }
  d[n * 4] = cast(u32) first; d[n * 4 + 1] = cast(u32) count; d[n * 4 + 2] = cast(u32) base; d[n * 4 + 3] = cast(u32) instances; return n + 1;
}
// Whether a piece at p (its reach r) is in front of the eye and inside the frame.
e2_in_view :: (s: [] E2, x: f32, y: f32, z: f32, r: f32) -> bool {
  vx := x - s[0].eye[0]; vy := y - s[0].eye[1]; vz := z - s[0].eye[2];
  d := vx * s[0].fwd[0] + vy * s[0].fwd[1] + vz * s[0].fwd[2];
  if d < -r { return false; }
  sx := abs(vx * s[0].right[0] + vy * s[0].right[1] + vz * s[0].right[2]);
  sy := abs(vx * s[0].up[0] + vy * s[0].up[1] + vz * s[0].up[2]);
  reach := (d + r) / s[0].focal;
  return sx <= reach * s[0].width * 0.5 + r * 1.2 && sy <= reach * s[0].height * 0.5 + r * 1.2;
}
// The grass field's blocks in view (verse/everglade2/field.coax): for each tier, the blocks whose
// ground lies in its ring round the eye and in view, one draw of 256 tufts each (two near, one
// mesh each keeping half; one further). The GPU places every tuft.
e2_field :: (s: [] E2, d: [] u32, n0: int) -> int {
  n := n0; if !s[0].kits { return n; }
  ex := s[0].eye[0]; ez := s[0].eye[2];
  for t: 0..<E2_FIELD_TIERS {
    bs := e2_field_block(t); out := e2_field_out(t);
    inner := e2_field_start(t);
    x0 := cast(int) floor((ex - out - E2_WEST) / bs); x1 := cast(int) floor((ex + out - E2_WEST) / bs);
    z0 := cast(int) floor((E2_BACK - ez - out) / bs); z1 := cast(int) floor((E2_BACK - ez + out) / bs);
    for bz: z0..<z1 + 1 { for bx: x0..<x1 + 1 {
      if bx < 0 || bz < 0 || bx >= E2_FIELD_ROW || bz >= E2_FIELD_ROW { continue; }
      wx := e2_field_block_x(t, bx); nz := e2_field_block_z(t, bz);
      if wx > E2_EAST || nz - bs < E2_FAR { continue; }
      // the block's nearest and farthest ground from the eye
      qx := ifx ex < wx then wx else ifx ex > wx + bs then wx + bs else ex; qz := ifx ez > nz then nz else ifx ez < nz - bs then nz - bs else ez;
      near := sqrt((qx - ex) * (qx - ex) + (qz - ez) * (qz - ez));
      fx := ifx ex - wx > wx + bs - ex then ex - wx else wx + bs - ex; fz := ifx nz - ez > ez - (nz - bs) then nz - ez else ez - (nz - bs);
      far := sqrt(fx * fx + fz * fz);
      if near > out || far < inner { continue; }
      cx := wx + bs * 0.5; cz := nz - bs * 0.5;
      if !e2_in_view(s, cx, e2_height(cx, cz) + 1, cz, bs * 0.75) { continue; }
      // one draw a block: every tier draws Grass_Common_Short (465 vertices a tuft)
      b := E2_GRASS * E2_LODS;
      if s[0].kit_count[b] <= 0 || n >= E2_DRAWS { continue; }
      n = e2_draw(d, n, s[0].kit_first[b], s[0].kit_count[b], e2_field_code(t, bx, bz, 2), E2_FIELD_CELLS * E2_FIELD_CELLS);
    }}
  }
  return n;
}
// Each visible piece into its (kit, level) bucket's run of the instance store; one draw a bucket.
// `casting` lists the pieces for the shadow tile drawn this frame instead (e2_cast_reach).
// Every piece keeps its one place, turn and size at every distance: distance only picks its level
// and fades it. A tree is whole near you, two of its crown's cards in three past E2_LOD1 and one in
// three past E2_LOD2 (the same cards in the same places, verse/tools/assets/everglade2_pack.coax),
// each pair of levels cross-fading in a screen dither over E2_LOD_BAND, and every piece dithers out
// past E2_FAR_START of its kit's reach, each at its own rank (e2_piece_shown).
e2_pieces :: (s: [] E2, d: [] u32, n0: int, casting: bool) -> int {
  n := n0;
  if !s[0].plant_done || !s[0].kits { return n; }
  counts: [E2_BUCKETS] int; start: [E2_BUCKETS] int;
  ex := s[0].eye[0]; ez := s[0].eye[2];
  cast_far := ifx casting then e2_cast_reach(s) else 0.0f32;
  if casting && cast_far <= 0 { return n; }
  for pass: 0..<2 {
    if pass == 1 {
      at := s[0].inst_n;
      for b: 0..<E2_BUCKETS { start[b] = at; at += counts[b]; counts[b] = 0; }
      if at > E2_VISIBLE { return n; }
    }
    for c: 0..<E2_CELLS_X * E2_CELLS_Z {
      i := c % E2_CELLS_X; j := c / E2_CELLS_X;
      mx := e2_cell_x(i) + f32(E2_CELL) * 0.5; mz := e2_cell_z(j) - f32(E2_CELL) * 0.5;
      far := ifx casting then (ifx cast_far < E2_KIT_FAR[0] then cast_far else E2_KIT_FAR[0]) else E2_KIT_FAR[0];
      dx := mx - ex; dz := mz - ez;
      if dx * dx + dz * dz > (far + 12) * (far + 12) { continue; }
      if !casting && !e2_in_view(s, mx, e2_height(mx, mz) + 6, mz, 20) { continue; }
      for q: s[0].first[c]..<s[0].first[c + 1] {
        kit := cast(int) s[0].kinds[q]; o := q * E2_ITEM_FLOATS;
        px := s[0].items[o]; py := s[0].items[o + 1]; pz := s[0].items[o + 2];
        qx := px - ex; qz := pz - ez; dd := sqrt(qx * qx + qz * qz);
        looks: E2Looks;
        if casting {
          // what the view draws, at its levels, but all round the eye (a shadow falls from behind
          // you too); a piece more than half faded out casts nothing. The near tile, drawn every
          // frame, takes every tree at level 1 (the same cards, two in three) so it never changes
          // level as you walk and stays cheap.
          if kit >= 25 || dd > cast_far || dd >= E2_KIT_FAR[kit] { continue; }
          if !e2_casts_into(s, px, py, pz, ifx kit < E2_TREES then 9.0f32 * s[0].items[o + 4] else 3.0f32) { continue; }
          looks = e2_piece_looks(kit, dd, e2_piece_rank(px, pz));
          if looks.n == 1 && looks.code[0] >= 32 { continue; }
          if s[0].casc[0].draw == 0 && kit < E2_TREES { looks.n = 1; looks.lod[0] = 1; looks.code[0] = 0; }
          // the far tiles (past 60 m) take the trees at their sparsest level, as the view draws
          // them out there, and the big rocks; a bush's shadow that far is under a texel
          if s[0].casc[0].draw >= 2 { if kit >= 15 && kit < 23 { continue; } if kit < E2_TREES { looks.n = 1; looks.lod[0] = 2; looks.code[0] = 0; } }
        } else {
          if dd >= E2_KIT_FAR[kit] { continue; }
          reach := ifx kit < E2_TREES then 9.0f32 * s[0].items[o + 4] else 2.5f32;
          if !e2_in_view(s, px, py + reach * 0.5, pz, reach) { continue; }
          looks = e2_piece_looks(kit, dd, e2_piece_rank(px, pz));
        }
        for e: 0..<looks.n {
          b := kit * E2_LODS + looks.lod[e];
          if s[0].kit_count[b] <= 0 { continue; }
          if pass == 1 { at := (start[b] + counts[b]) * E2_ITEM_FLOATS; for k: 0..<E2_ITEM_FLOATS { s[0].inst[at + k] = s[0].items[o + k]; }
            s[0].inst[at + 7] += 4 * f32(looks.code[e]); }
          counts[b] += 1;
        }
      }
    }
  }
  for b: 0..<E2_BUCKETS { if counts[b] > 0 { n = e2_draw(d, n, s[0].kit_first[b], s[0].kit_count[b], E2_KIT_BASE + start[b], counts[b]); } }
  s[0].inst_n = start[E2_BUCKETS - 1] + counts[E2_BUCKETS - 1];
  return n;
}
// The one or two ways a piece is drawn at dd metres: its levels and their fade codes (the shader's
// e2_inst_fade: 0 whole, 1 to 63 that many 64ths of its pixels dropped, 65 to 127 only (code - 64)
// 64ths kept, the other half of a cross-fade).
E2Looks :: struct { n: int; lod: [2] int; code: [2] int; }
E2_LOD_BAND :: 8.0;      // metres a tree's two levels cross-fade over, centred on E2_LOD1 and E2_LOD2
E2_FAR_START :: 0.55;    // of a kit's reach: past this its pieces thin out, each at its own rank
E2_FAR_BAND :: 0.10;     // of the share: how long one piece takes to dither out
e2_fade_code :: (drop: f32) -> int { k := cast(int) floor(drop * 64 + 0.5); return ifx k < 0 then 0 else ifx k > 63 then 63 else k; }
// A piece's rank (0 to 1) from where it stands alone: the order the pieces of a kit thin out in.
e2_piece_rank :: (x: f32, z: f32) -> f32 { return e2_unit(e2_field_hash(cast(u32)(cast(int) floor(x * 16) + 65536), cast(u32)(cast(int) floor(z * 16) + 65536), 9)); }
// How much of a piece shows at dd (its rank `rank`): all near; past E2_FAR_START of its kit's
// reach the share left falls smoothly to none at the reach, and each piece dithers out over
// E2_FAR_BAND as the share passes its rank, so the edge is ragged and nothing pops or shrinks.
e2_piece_shown :: (kit: int, dd: f32, rank: f32) -> f32 {
  far := E2_KIT_FAR[kit]; t := (dd - far * f32(E2_FAR_START)) / (far * (1 - f32(E2_FAR_START)));
  t = ifx t < 0 then 0.0f32 else ifx t > 1 then 1.0f32 else t;
  share := 1 - t * t * (3 - 2 * t);
  v := (share - rank * (1 - f32(E2_FAR_BAND))) / f32(E2_FAR_BAND);
  return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v;
}
e2_piece_looks :: (kit: int, dd: f32, rank: f32) -> E2Looks {
  l: E2Looks;
  l.n = 1; l.lod[0] = 0; l.code[0] = e2_fade_code(1 - e2_piece_shown(kit, dd, rank));
  if kit >= E2_TREES { return l; }
  // the level this far, and how far into the cross-fade to the next one
  lod := 0; at := f32(E2_LOD1);
  if dd >= f32(E2_LOD1) + f32(E2_LOD_BAND) * 0.5 { lod = 1; at = f32(E2_LOD2); }
  if dd >= f32(E2_LOD2) + f32(E2_LOD_BAND) * 0.5 { lod = 2; }
  l.lod[0] = lod;
  if lod == 2 { return l; }
  k := e2_fade_code((dd - (at - f32(E2_LOD_BAND) * 0.5)) / f32(E2_LOD_BAND));
  if k == 0 { return l; }
  if k >= 63 { l.lod[0] = lod + 1; return l; }
  // the nearer level drops k 64ths of its pixels and the farther one keeps exactly those
  l.n = 2; l.code[0] = k; l.lod[1] = lod + 1; l.code[1] = 64 + k;
  return l;
}
#test "a piece keeps its place and size at every distance and only fades" {
  // a tree: whole near, cross-faded round E2_LOD1 and E2_LOD2 (the two halves cover each pixel
  // once), then its sparsest level out to its reach
  last := 0;
  for i: 0..<3000 { dd := f32(i) * 0.1; l := e2_piece_looks(3, dd, 0.5);
    #assert l.n >= 1 && l.n <= 2;
    if l.n == 2 { #assert l.lod[1] == l.lod[0] + 1 && l.code[1] == 64 + l.code[0] && l.code[0] > 0 && l.code[0] < 63; }
    if dd < f32(E2_LOD1) - f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 0 && l.code[0] == 0; }
    if dd > f32(E2_LOD1) + f32(E2_LOD_BAND) && dd < f32(E2_LOD2) - f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 1 && l.code[0] == 0; }
    if dd > f32(E2_LOD2) + f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 2; }
    // the far fade only grows with distance, by at most a couple of 64ths a step
    if dd > f32(E2_LOD2) + f32(E2_LOD_BAND) { #assert l.code[0] >= last && l.code[0] - last <= 2; last = l.code[0]; }
  }
  // through each band the farther level's share rises smoothly from none to all
  for band: 0..<2 { c := ifx band == 0 then f32(E2_LOD1) else f32(E2_LOD2); prev := 0;
    for i: 0..<201 { dd := c - f32(E2_LOD_BAND) * 0.5 - 0.5 + f32(i) * 0.045; l := e2_piece_looks(0, dd, 0.5);
      k := ifx l.n == 2 then l.code[0] else ifx l.lod[0] == band + 1 then 64 else 0;
      #assert k >= prev && k - prev <= 3; prev = k; } #assert prev == 64; }
  // small pieces thin out over the far part of their reach, each at its own rank: near all show,
  // at the reach none; a piece's share only falls with distance and never jumps
  for kit: 15..<E2_KITS { far := E2_KIT_FAR[kit];
    for r: 0..<20 { rank := f32(r) / 20 + 0.02; was := 1.0f32;
      #assert e2_piece_shown(kit, far * 0.5, rank) == 1 && e2_piece_shown(kit, far, rank) == 0;
      for i: 0..<400 { v := e2_piece_shown(kit, far * f32(i) / 400, rank); #assert v <= was && was - v < 0.2; was = v; } } }
  // ranks spread, so the edge is ragged: halfway through the thinning about half the pieces show
  shown := 0; for i: 0..<1000 { if e2_piece_shown(18, E2_KIT_FAR[18] * 0.78, e2_piece_rank(f32(i) * 1.37, f32(i) * 0.71)) > 0.5 { shown += 1; } }
  #assert shown > 300 && shown < 700;
}
// The draws of the woods with the eye at path metre m (3 m behind and 2 up, looking down the path).
e2_test_view :: (s: [] E2, d: [] u32, m: f32) -> int {
  z := -m; x := e2_road_x(z); s[0].eye = [3]f32.[x, e2_height(x, z + 3) + 2, z + 3];
  s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].width = 1280; s[0].height = 720; s[0].focal = 900; s[0].inst_n = 0;
  return e2_pieces(s, d, 0, false);
}
#test "the woods' pieces never move, grow or swap as you walk, and come back the same" #steps 60000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true; s[0].kits = true;
  for b: 0..<E2_BUCKETS { s[0].kit_first[b] = b; s[0].kit_count[b] = 1; }
  d: [E2_DRAWS * 4] u32;
  // A, then a metre on, then 30 m on and back to A
  na := e2_test_view(s[..], d[..], 150); an := s[0].inst_n; a: [E2_VISIBLE * E2_ITEM_FLOATS] f32;
  for k: 0..<an * E2_ITEM_FLOATS { a[k] = s[0].inst[k]; }
  walk := [7]f32.[151, 160, 170, 180, 170, 160, 152];
  for step: 0..<7 {
    m := walk[step];
    n := e2_test_view(s[..], d[..], m);
    // every drawn piece is a planted one exactly (place, turn, size, tint), only its fade added
    for i: 0..<s[0].inst_n { if i % 5 != step % 5 { continue; } o := i * E2_ITEM_FLOATS; x := s[0].inst[o]; z := s[0].inst[o + 2];
      ci := cast(int) floor((x - f32(E2_CELL_X0)) / f32(E2_CELL)); cj := cast(int) floor((f32(E2_CELL_Z0) - z) / f32(E2_CELL));
      found := false;
      for dc: 0..<9 { ii := ci + dc % 3 - 1; jj := cj + dc / 3 - 1; if ii < 0 || jj < 0 || ii >= E2_CELLS_X || jj >= E2_CELLS_Z { continue; } c := jj * E2_CELLS_X + ii;
      for q: s[0].first[c]..<s[0].first[c + 1] { p := q * E2_ITEM_FLOATS; same := true;
        for k: 0..<7 { if s[0].items[p + k] != s[0].inst[o + k] { same = false; } }
        w := s[0].inst[o + 7] - s[0].items[p + 7]; kk := floor(w / 4 + 0.5); if same && kk >= 0 && kk < 128 && abs(w - 4 * kk) < 0.001 { found = true; } } }
      #assert found;
    }
  }
  nb := e2_test_view(s[..], d[..], 150);
  #assert nb == na && s[0].inst_n == an && an > 1000;
  for k: 0..<an * E2_ITEM_FLOATS { #assert s[0].inst[k] == a[k]; }
}
e2_scene :: (s: [] E2) -> int #export_c #effects(all) {
  c := s[0].creator[0]; b := s[0].bodies[..];
  s[0].draw_n = 0; s[0].shadow_n = 0; s[0].inst_n = 0;
  if !b[0].ready || !cc.catalog_ready(c) || c.glade_count <= 0 { return 0; }
  n := 0; sn := 0;
  // record 0 the glade, 1 to 3 its grass (their base instance (record + 1) << 16: cg_instanced_vs)
  e2_rec_clear(s, 0); s[0].records[7] = f32(c.glade_word); s[0].records[15] = 16;
  n = e2_draw(s[0].draws[..], n, c.glade_first, c.glade_count, 0, 1);
  tile := s[0].casc[0].on && s[0].casc[0].draw >= 0;
  near_glade := s[0].eye[2] - e2_cast_reach(s) < 75;
  if tile && near_glade { sn = e2_draw(s[0].shadow[..], sn, c.glade_first, c.glade_count, 0, 1); }
  rec := 1;
  // the glade's own grass (Character Create's, about 27 000 tufts of up to 1 482 vertices: 35 million
  // vertices a frame) is not drawn: the grass field (verse/everglade2/field.coax) covers the glade too.
  // Its records stay, so the character's parts keep their places.
  glade_near := false;
  for gi: 0..<c.grass_groups {
    g := c.grass[gi]; e2_rec_clear(s, rec);
    s[0].records[rec * 24] = f32(g.word); s[0].records[rec * 24 + 7] = f32(c.glade_word); s[0].records[rec * 24 + 15] = 17;
    if glade_near { n = e2_draw(s[0].draws[..], n, g.first, g.count, (rec + 1) << 16, g.n); }
    rec += 1;
  }
  // your character: the look Character Create saved, walking as the controller moves you
  a := s[0].anim[..];
  a[0].on = true; a[0].x = s[0].you_x; a[0].z = s[0].you_z; a[0].y = s[0].you_y; a[0].yaw = s[0].you_face; a[0].own = true;
  bdt := ifx s[0].clock > b[0].now then s[0].clock - b[0].now else 0.0f32;
  figs.bd_step(a, s[0].clock, bdt);
  b[0].now = s[0].clock;
  fig := ifx e2c_creating(s) then e2c_figure(s) else e2k_figure(e2_jump_figure(a[0], s[0].airborne, s[0].clock, s[0].air_at, s[0].land_at), s[0].casts[0].me[0], s[0].clock);
  s[0].cz[0].fig0 = rec;
  d := e2_body(s, c, fig, E2Drawn.{rec = rec, n = n, sn = sn});
  s[0].cz[0].fig1 = d.rec;
  if d.n > 0 { s[0].cz[0].drawn += 1; }
  d = e2_remotes_draw(s, d, bdt);   // the others in the room (everglade2-net.coax)
  rec = d.rec; n = d.n; sn = d.sn;
  n = e2_pieces(s, s[0].draws[..], n, false);
  n = e2_field(s, s[0].draws[..], n);
  sn = e2_pieces(s, s[0].shadow[..], sn, true);
  s[0].draw_n = n; s[0].shadow_n = sn;
  return n;
}
e2_record_bytes :: (s: [] E2) -> int #export_c #effects(all) { return E2_RECORDS * 24 * 4; }
e2_inst_bytes :: (s: [] E2) -> int #export_c #effects(all) { return s[0].inst_n * E2_ITEM_FLOATS * 4; }
// The host action this frame (everglade2-face.c coaxial_action): its code, its bytes; done clears it.
e2_action :: (s: [] E2) -> int #export_c #effects(all) { return s[0].action; }
e2_action_done :: (s: [] E2) #export_c #effects(all) { s[0].action = 0; s[0].out_n = 0; }
// Whether the controller should take you where and as you stand now (once, after the studio).
e2_reseat :: (s: [] E2) -> bool #export_c #effects(all) { r := s[0].reseat; s[0].reseat = false; return r; }
coaxial_e2_max_vertices :: () -> int #export_c #effects(all) { return E2_MAX_VERTICES; }
coaxial_e2_vertex_floats :: () -> int #export_c #effects(all) { return E2_VERTEX_FLOATS; }
coaxial_e2_uniform_floats :: () -> int #export_c #effects(all) { return E2_UNIFORM_FLOATS; }
// Read-only observations for headless checks (coaxial_field_probe): 0 draws, 1 shadow draws, 2 kit
// pieces stored, 3 pieces planted, 4 kit rows read, 5 your z in centimetres.
e2_probe :: (s: [] E2, field: int) -> int #export_c #effects(all) {
  if field == 0 { return s[0].draw_n; } if field == 1 { return s[0].shadow_n; } if field == 2 { return s[0].inst_n; }
  if field == 3 { return s[0].planted; }
  if field == 4 { n := 0; for b: 0..<E2_BUCKETS { if s[0].kit_count[b] > 0 { n += 1; } } return n; }
  if field == 5 { return cast(int)(s[0].you_z * 100); }
  // 6 the camera's room along its ray, 7 the eye's height over your feet, 8 your feet over the land (cm)
  if field == 6 { return cast(int)(s[0].orbit.shown * 100); }
  if field == 7 { return cast(int)((s[0].eye[1] - s[0].you_y) * 100); }
  if field == 8 { return cast(int)((s[0].you_y - e2_height(s[0].you_x, s[0].you_z)) * 100); }
  // 9 the bake's publish status (0 live, -1 not yet), 10 the baked AO at you (thousandths), 11 its crowns
  if field == 9 { return s[0].eg[0].baked; }
  if field == 10 { return cast(int)(e2g_ao(s[0].eg[..], s[0].you_x, s[0].you_z, 1.0) * 1000); }
  if field == 11 { return s[0].eg[0].crown_n; }
  // 12 the vertices the scene's draws run this frame (thousands), 13 the shadow tiles'
  if field == 12 || field == 13 { n := ifx field == 12 then s[0].draw_n else s[0].shadow_n; v := 0;
    for i: 0..<n { k := i * 4; v += cast(int)(ifx field == 12 then s[0].draws[k + 1] * s[0].draws[k + 3] else s[0].shadow[k + 1] * s[0].shadow[k + 3]) / 1000; } return v; }
  // 14 the grass field's share of 12 (thousands), 15 the trees' (kits 0 to 14)
  if field == 14 || field == 15 { v := 0; for i: 0..<s[0].draw_n { k := i * 4; grass := s[0].draws[k + 2] >= cast(u32) E2_FIELD_BASE;
      tree := !grass && s[0].draws[k + 2] >= cast(u32) E2_KIT_BASE && s[0].draws[k] < cast(u32) s[0].kit_first[E2_TREES * E2_LODS];
      if (field == 14 && grass) || (field == 15 && tree) { v += cast(int)(s[0].draws[k + 1] * s[0].draws[k + 3]) / 1000; } } return v; }
  // 16 the names drawn over the others this frame (e2_plates), 17 the others' bodies collected for it
  if field == 16 { return s[0].plates_drawn; }
  if field == 17 { return s[0].plate_n; }
  // 18 the others that came into your view and thinned in, 19 pops (a body cut off more than E2_POP
  // shown), 87 the bodies thinning out this frame (e2_remotes_draw)
  if field == 18 { return s[0].fade_ins; } if field == 19 { return s[0].pops; } if field == 87 { return s[0].ghosts; }
  if field >= 20 && field < 30 { return e2c_probe(s, field); }   // Character Create's (everglade2-create.coax)
  // rest (#13046), for a check that presses its controls: 30 the room's rest code (WIRE_REST_*, -1 not
  // said yet), 31 the controls shown, 32 and 33 the first's and the last's requests (RS_REST_*), 34 to
  // 37 their centres (canvas px: x, y, x, y), 38 your x (cm), 39 a rest refusal shown (1)
  if field >= 30 && field < 40 { n := s[0].net[..]; reqs: [4] int; rn := e2k_rest_choices(s, reqs[..]);
    if field == 30 { return ifx n[0].rest_known then n[0].rest_code else -1; } if field == 31 { return rn; }
    if field == 38 { return cast(int)(s[0].you_x * 100); } if field == 39 { return ifx e2n_rest_message(n).count > 0 then 1 else 0; }
    if rn == 0 { return -1; }
    j := ifx field == 32 || field == 34 || field == 35 then 0 else rn - 1; if field < 34 { return reqs[j]; }
    r := e2k_rest_box(s, j, rn); return cast(int)(ifx (field - 34) % 2 == 0 then (r[0] + r[2]) / 2 else (r[1] + r[3]) / 2); }
  // the casts (#13058): 82 yours sent to the room, 83 others' played here, 88 yours the room said
  // back, 89 cast sounds played (everglade2-cast.coax)
  if field == 82 { return s[0].net[0].cast_sent; } if field == 83 { return s[0].casts[0].others; }
  if field == 88 { return s[0].net[0].cast_mine; } if field == 89 { return s[0].casts[0].audio[0].played; }
  if (field >= 40 && field < 66 + E2_REMOTES) || (field >= 84 && field <= 86) { return e2_net_probe(s, field); }   // the room's, and the crowd check's boxes and names (e2_net_probe)
  // levels (#13046): 100 to 103 the right halves of Character Create's LEVEL and CLASS boxes (canvas
  // px: x, y, x, y), 104 its level, 105 your bar's slots, 106 the room's word on it known (1), 107
  // refused casts undone, 108 their fades still going, 110 + i what slot i has left (-1 unknown) and
  // 120 + i whether it holds (1)
  if field >= 100 && field < 130 { k := s[0].casts[..];
    if field < 104 { b := s[0].cz[0].boxes[ifx field < 102 then E2C_LEVEL_BOX else E2C_CLASS_BOX];
      return cast(int)(ifx field % 2 == 0 then b.x0 + (b.x1 - b.x0) * 0.8 else (b.y0 + b.y1) / 2); }
    if field == 104 { return e2c_level_of(s); } if field == 105 { return k[0].bar_n; }
    if field == 106 { return ifx e2n_kit(s[0].net[..], 0, k[0].bar_n).ok then 1 else 0; } if field == 107 { return k[0].undone; }
    if field == 108 { m := 0; for f: 0..<E2K_FADES { if k[0].fades[f].slot >= 0 && s[0].clock - k[0].fades[f].at <= f32(E2K_FADE) { m += 1; } } return m; }
    w := e2n_kit(s[0].net[..], field % 10, k[0].bar_n); if field >= 110 && field < 120 { return w.left; } if field >= 120 { return ifx w.on then 1 else 0; }
    return -1; }
  // the ground (#13059): 90 its route (1 the pack's record, 2 converted here), 91 its tiles, 92 sets
  // published, 93 refusals, 94 the first refusal's code, 95 KiB resident, 96 and 97 the set's and the
  // glade tile's revision (first word, as a signed int), 98 queries off the tiles
  if field >= 90 && field < 99 { g := s[0].eg[..];
    if field == 90 { return g[0].route; } if field == 92 { return g[0].published; }
    if field == 93 { return g[0].refused; } if field == 94 { return g[0].first_refusal; } if field == 95 { return e2g_resident(g) / 1024; }
    if field == 91 || field == 96 { if !g[0].ok { return 0; } ls := e2g_live_set(g); return ifx field == 91 then ls[0].n else cast(int)cast,trunc(s32) ls[0].revision[0]; }
    if field == 97 { return cast(int)cast,trunc(s32) g[0].receipt.output[0]; }
    return g[0].outside; }
  return -1;
}

// ---- the room (#13054): what the face asks of everglade2-net.coax, and the others drawn

// Your look for the room's hello: the record Character Create keeps for you.
e2_net_look :: (s: [] E2) {
  b: [64] u8;
  if !s[0].creator[0].configured { return; }
  m := cc.save(s[0].creator[0], b[..]);
  if m > 0 { e2n_set_look(s[0].net[..], cast(string) b[0..<m]); }
}
// The frame's room work, from the face: you join once the run starts (USE IN EVERGLADE), or at once
// when you come in with a character; then the clock, the socket, the others where they are drawn.
e2_net_step :: (s: [] E2, mono: int) #export_c #effects(all) {
  n := s[0].net[..];
  if s[0].player_key_n > 0 && s[0].action == 0 {
    for i: 0..<s[0].player_key_n { s[0].outbox[i] = s[0].player_key[i]; }
    s[0].out_n = s[0].player_key_n; s[0].action = E2_ACT_PLAYER; s[0].player_key_n = 0;
  }
  n[0].joined = !s[0].cz[0].on || s[0].cz[0].walking;
  e2n_where(n, s[0].you_x, s[0].you_z, s[0].you_face);   // for a hello after a lost room (#13057)
  if n[0].joined { e2_net_look(s); }   // the record as it stands: a change in the studio is said again
  e2n_step(n, mono);
}
// Seated in a room: the face steps you at its rate and sends each step.
e2_net_live :: (s: [] E2) -> bool #export_c #effects(all) { return e2n_open(s[0].net[..]); }
// The run holds its feet until the room seats you, E2N_HOLD_MS at most (then it walks on alone).
e2_net_holding :: (s: [] E2, waited_ms: int) -> bool #export_c #effects(all) {
  n := s[0].net[0];
  return n.want && n.joined && !n.stale && !n.elsewhere && !e2n_open(s[0].net[..]) && !n.sat && waited_ms < E2N_HOLD_MS;
}
e2_net_as_sent :: (s: [] E2, m: EgMoveIn) -> EgMoveIn #export_c #effects(all) { return e2n_as_sent(m); }
e2_net_input :: (s: [] E2, m: EgMoveIn) -> int #export_c #effects(all) { return e2n_input(s[0].net[..], m); }
e2_net_fix_due :: (s: [] E2) -> bool #export_c #effects(all) { return e2n_fix_due(s[0].net[..]); }
e2_net_fix :: (s: [] E2) -> NetFix #export_c #effects(all) { return s[0].net[0].fix; }
e2_net_replay_n :: (s: [] E2) -> int #export_c #effects(all) { return e2n_replay_n(s[0].net[..]); }
e2_net_replay_input :: (s: [] E2, k: int) -> EgMoveIn #export_c #effects(all) { return e2n_replay_input(s[0].net[..], k); }
e2_net_fixed :: (s: [] E2, dx: f32, dy: f32, dz: f32) #export_c #effects(all) { e2n_fixed(s[0].net[..], dx, dy, dz); }
e2_net_offset :: (s: [] E2, dt: f32) -> figs.Point #export_c #effects(all) { o := e2n_offset(s[0].net[..], dt); return figs.v3(o[0], o[1], o[2]); }
// The socket's commands for the host (the face drains them): the pipe, as Everglade's.
e2_net_pipe :: (s: [] E2) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].n; }
e2_net_pipe_op :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].op[k]; }
e2_net_pipe_id :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].id[k]; }
e2_net_pipe_from :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].from[k]; }
e2_net_pipe_len :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].len[k]; }
e2_net_pipe_done :: (s: [] E2) #export_c #effects(all) { pipe_drained(s[0].net[0].pipe[..]); }
e2_net_named :: (s: [] E2, answer: string) #export_c #effects(all) { e2c_named(s, answer); }
// The host's keyboard field (host.js coaxial_wants_text, coaxial_field): over NAME while it takes keys.
e2_wants_text :: (s: [] E2) -> bool #export_c #effects(all) { return e2c_creating(s) && s[0].cz[0].editing; }
e2_text_field :: (s: [] E2, out: [] f32) #export_c #effects(all) { b := s[0].cz[0].boxes[E2C_NAME_BOX]; if out.count >= 4 { out[0] = b.x0; out[1] = b.y0; out[2] = b.x1; out[3] = b.y1; } }
e2_net_opened :: (s: [] E2, id: int) #export_c #effects(all) { e2n_opened(s[0].net[..], id); }
e2_net_ticket :: (s: [] E2, answer: string) #export_c #effects(all) { e2n_ticket(s[0].net[..], answer); }
// For headless checks (e2_probe 40 to 59): the room as this page has it.
e2_net_probe :: (s: [] E2, f: int) -> int {
  n := s[0].net[..];   // a view: E2Net is too big to copy onto the stack for each probe
  if f == 40 { return n[0].state; } if f == 41 { return n[0].seat; } if f == 42 { return e2n_remotes(s[0].net[..]); }
  if f == 43 { return n[0].delay; } if f == 44 { return cast(int) n[0].lag; } if f == 45 { return cast(int)(n[0].jitter * 100); }
  if f == 46 { return n[0].replays; } if f == 47 { return cast(int)(sqrt(n[0].fix_sq) * 1000); } if f == 48 { return n[0].frames_in; }
  if f == 49 { return n[0].tries; } if f == 50 { return ifx n[0].want then 1 else 0; } if f == 51 { return ifx n[0].joined then 1 else 0; }
  if f == 52 { return n[0].look_n; } if f == 54 { return n[0].pings; }
  // 84 the times this page sat again and said where it stood (A), 85 the room's first word on you after
  // the last of them less where you were drawn (mm, -1 none), 86 the ms from losing the room to it (#13057)
  if f == 84 { return n[0].agains; } if f == 85 { return n[0].back_fix_mm; } if f == 86 { return n[0].back_ms; }
  if f == 53 { c := 0; for e: 0..<E2N_ENTS { en := n[0].ents[e]; if en.live && en.kind == WK_PLAYER && en.seat != n[0].seat && en.name_n > 0 { c += 1; } } return c; }
  if f == 55 { return ifx n[0].pings > 0 then n[0].ping_rtt[net_ping_best(n[0].ping_rtt[..], n[0].pings)] else -1; }
  // 56, 57: USE IN EVERGLADE's centre (canvas px), for a check that presses it; 58 the first other's
  // drawn x and 59 its z (cm), -999999 none
  if f == 56 || f == 57 { b := s[0].cz[0].boxes[17]; return cast(int)(ifx f == 56 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  // 60, 61: SURPRISE ME's centre, for a check that makes each page someone different
  if f == 60 || f == 61 { b := s[0].cz[0].boxes[14]; return cast(int)(ifx f == 60 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  // 62, 63: NAME's centre; 64 a refused name's reason shown (its length), 65 the name with the API;
  // 66 + K the K-th other's name as 31 bits of FNV-1a (0 none), for a check that names each page
  if f == 62 || f == 63 { b := s[0].cz[0].boxes[E2C_NAME_BOX]; return cast(int)(ifx f == 62 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  if f == 64 { return s[0].cz[0].said_n; } if f == 65 { return ifx s[0].cz[0].naming then 1 else 0; }
  if f >= 66 && f < 66 + E2_REMOTES {
    r := e2n_remote(s[0].net[..], f - 66); if !r.ok { return 0; }
    en := s[0].net[0].ents[r.slot]; return e2_name_hash(cast(string) en.name[0..<en.name_n]);
  }
  if f == 58 || f == 59 { r := e2n_remote(s[0].net[..], 0); if !r.ok { return -999999; } return cast(int)((ifx f == 58 then r.x else r.z) * 100); }
  return -1;
}

// 31 bits of FNV-1a: the probes' way to say a name (e2_net_probe 66 + K).
e2_name_hash :: (t: string) -> int { h := 2166136261; for ch: t { h = ((h ^ cast(int) ch) * 16777619) & 0xffffffff; } return h & 0x7fffffff; }
#test "the crowd check's probes: SURPRISE ME's and NAME's boxes, the name with the API, and the others' names" {
  s: [1] E2; e2c_layout(s[..], 1280, 720, 1);
  #assert e2_probe(s[..], 60) > 0 && e2_probe(s[..], 61) > 0 && e2_probe(s[..], 62) > 0 && e2_probe(s[..], 63) > 0;
  #assert e2_probe(s[..], 64) == 0 && e2_probe(s[..], 65) == 0 && e2_probe(s[..], 66) == 0 && e2_probe(s[..], 66 + E2_REMOTES) == 0;   // 82 on: the casts' (none sent)
}
#test "a name's probe hash is FNV-1a's, 31 bits" { #assert e2_name_hash("") == 2166136261 & 0x7fffffff && e2_name_hash("a") == 0x640c292c && e2_name_hash("Crowd Alpha") != e2_name_hash("Crowd Bravo"); }
// A remote's look: your creator (its catalog, its parts) with that player's record restored. When the
// record is no Character Create record (a v1 page's ranger.S.D.T, or none) it is Character Create's
// default body, never you as you are dressed. False then.
e2_remote_look :: (s: [] E2, look: string) -> bool {
  s[0].rtmp[0] = s[0].creator[0];
  if cc.restore(s[0].rtmp[..], look) { return true; }
  s[0].rtmp[0] = s[0].creator[0]; cc.reset(s[0].rtmp[..]);
  return false;
}
#test "another's v1 look or none draws Character Create's default body, not you" {
  s: [1] E2;
  cc.reset(s[0].creator[..]); s[0].creator[0].outfit = 3; s[0].creator[0].dye = 2; s[0].creator[0].female = true;
  #assert !e2_remote_look(s[..], "ranger.1.2.3");
  #assert s[0].rtmp[0].outfit == 2 && s[0].rtmp[0].dye == 8 && !s[0].rtmp[0].female;
  #assert !e2_remote_look(s[..], "");
  #assert s[0].rtmp[0].outfit == 2 && s[0].creator[0].outfit == 3;
  out: [64] u8; n := cc.save(s[0].creator[0], out[..]);
  #assert e2_remote_look(s[..], cast(string) out[0..<n]) && s[0].rtmp[0].outfit == 3 && s[0].rtmp[0].female;
}
E2Drawn :: struct { rec: int; n: int; sn: int; }
// One body's draws: its worn parts, then its head, hair and beard, each a record with the figure's
// pose and the body's eyes.
e2_body :: (s: [] E2, c: cc.Creator, fig: figs.BdAnim, at: E2Drawn) -> E2Drawn {
  b := s[0].bodies[..]; out := s[0].records[..];
  rec := at.rec; n := at.n; sn := at.sn; from := rec;
  l := cc.look(c); l.variant = 0;
  for i: 0..<40 { if c.worn[i] && cc.available(c, i) && c.source_count[i + (ifx c.female then 0 else 40)] > 0 && rec < E2_RECORDS {
    p := i + ifx c.female then 0 else 40;
    figs.bd_record(fig, l, c.source_word[p], false, s[0].clock, out, rec); out[rec * 24 + 11] = f32(c.variant);
    n = e2_draw(s[0].draws[..], n, c.source_first[p], c.source_count[p], rec, 1); sn = e2_draw(s[0].shadow[..], sn, c.source_first[p], c.source_count[p], rec, 1); rec += 1;
  } }
  parts: [3] int; pn := 0;
  if !c.worn[7] { parts[pn] = l.head; pn += 1; }
  if l.hair >= 0 && !c.worn[7] && !c.worn[26] { parts[pn] = l.hair; pn += 1; }
  if l.extra == figs.BP_BEARD && !c.worn[7] { parts[pn] = l.extra; pn += 1; }
  for i: 0..<pn { if rec < E2_RECORDS {
    p := parts[i]; figs.bd_record(fig, l, b[0].part_word[p], false, s[0].clock, out, rec);
    n = e2_draw(s[0].draws[..], n, b[0].part_first[p], b[0].part_count[p], rec, 1); sn = e2_draw(s[0].shadow[..], sn, b[0].part_first[p], b[0].part_count[p], rec, 1); rec += 1;
  } }
  for i: from..<rec { for k: 0..<3 { out[i * 24 + 20 + k] = cc.EYES[c.eye_color][k]; } out[i * 24 + 23] = 2; }
  return E2Drawn.{rec = rec, n = n, sn = sn};
}
// The others, as the room has them drawn this frame: each on the land, its own walk and run from how
// fast it goes, its jump from its feet off the ground, its own look; and its name for e2_plates.
e2_remotes_draw :: (s: [] E2, at: E2Drawn, bdt: f32) -> E2Drawn {
  d := at; s[0].plate_n = 0; s[0].ghosts = 0;
  step := ifx bdt > 0 then bdt / f32(E2_FADE_S) else 0.0f32;
  seen: [E2N_ENTS] bool;
  for k: 0..<E2_REMOTES {
    r := e2n_remote(s[0].net[..], k);
    if !r.ok { break; }
    en := s[0].net[0].ents[r.slot]; slot := r.slot; seen[slot] = true;
    // a new player in this slot: from nothing (one still thinning out here is cut: a pop if it showed)
    if s[0].rseat[slot] != r.seat + 1 {
      if s[0].rfade[slot] > f32(E2_POP) { s[0].pops += 1; }
      s[0].rfade[slot] = 0; s[0].rseat[slot] = r.seat + 1; s[0].fade_ins += 1;
    }
    up := s[0].rfade[slot] + step; s[0].rfade[slot] = ifx up > 1 then 1.0f32 else up;
    s[0].rlast[slot] = r;
    ln := ifx en.look_n < NET_LOOK then en.look_n else NET_LOOK; s[0].rlook_n[slot] = ln; for i: 0..<ln { s[0].rlook[slot * NET_LOOK + i] = en.look[i]; }
    a := s[0].ranim[slot..<slot + 1];
    if !a[0].on || s[0].rlife[slot] != en.born { a[0] = figs.BdAnim.{}; a[0].on = true; s[0].rair[slot] = false; s[0].rland_at[slot] = -100; s[0].rlife[slot] = en.born; s[0].casts[0].them[slot] = E2kAct.{}; }
    ground := e2_height(r.x, r.z);
    d = e2_remote_body(s, r, slot, d, bdt);
    if s[0].plate_n < E2_REMOTES && en.name_n > 0 {
      p := s[0].plates[s[0].plate_n..<s[0].plate_n + 1];
      p[0].x = r.x; p[0].y = ground + r.y + 2.05; p[0].z = r.z; p[0].alpha = 0; p[0].fade = s[0].rfade[slot];   // the head's top
      p[0].name_n = en.name_n; for i: 0..<en.name_n { p[0].name[i] = en.name[i]; }
      s[0].plate_n += 1;
    }
  }
  // the ones gone from your view: thinning out where they were last drawn
  for slot: 0..<E2N_ENTS {
    if seen[slot] || s[0].rseat[slot] == 0 { continue; }
    down := s[0].rfade[slot] - step; s[0].rfade[slot] = ifx down < 0 then 0.0f32 else down;
    if s[0].rfade[slot] <= 0 { s[0].rseat[slot] = 0; continue; }
    s[0].ghosts += 1;
    d = e2_remote_body(s, s[0].rlast[slot], slot, d, bdt);
  }
  return d;
}
// One other's body at r with slot's look and fade: on the land, its walk and run from its speed, its
// jump from its feet off the ground, its records' fade word (gpu/everglade2.coax e2_body_fade).
e2_remote_body :: (s: [] E2, r: E2Remote, slot: int, at: E2Drawn, bdt: f32) -> E2Drawn {
  a := s[0].ranim[slot..<slot + 1];
  ground := e2_height(r.x, r.z);
  a[0].x = r.x; a[0].z = r.z; a[0].y = ground + r.y; a[0].yaw = r.yaw; a[0].own = false;
  figs.bd_step(a, s[0].clock, bdt);
  air := r.y > f32(E2_AIRBORNE);
  if air && !s[0].rair[slot] { s[0].rair_at[slot] = s[0].clock; }
  if !air && s[0].rair[slot] { s[0].rland_at[slot] = s[0].clock; }
  s[0].rair[slot] = air;
  fig := e2k_figure(e2_jump_figure(a[0], air, s[0].clock, s[0].rair_at[slot], s[0].rland_at[slot]), s[0].casts[0].them[slot], s[0].clock);
  look := cast(string) s[0].rlook[slot * NET_LOOK..<slot * NET_LOOK + s[0].rlook_n[slot]];
  _ := e2_remote_look(s, look); c := s[0].rtmp[0];
  from := at.rec;
  d := e2_body(s, c, fig, at);
  drop := e2_fade_drop(s[0].rfade[slot]);
  for i: from..<d.rec { s[0].records[i * 24 + 23] = 2 + drop; }
  return d;
}
// The share of a body's pixels the dither drops at fade f (0 gone, 1 whole): eased, and never all of
// them while it is drawn (the record's word stays under 3).
e2_fade_drop :: (f: f32) -> f32 { t := ifx f < 0 then 0.0f32 else ifx f > 1 then 1.0f32 else f; e := t * t * (3 - 2 * t); return ifx 1 - e > 0.999 then 0.999f32 else 1 - e; }
#test "another player thins in over E2_FADE_S as it comes into your view, and out where it was as it leaves" {
  #assert e2_fade_drop(1) == 0 && e2_fade_drop(0) > 0.99 && e2_fade_drop(0) < 1 && abs(e2_fade_drop(0.5) - 0.5) < 0.001;
  s: [1] E2; s[0].net[0].state = E2N_OPEN; s[0].net[0].seat = 1;
  k := e2n_ent(s[0].net[..], 3, true); en := s[0].net[0].ents[k..<k + 1]; en[0].kind = WK_PLAYER; en[0].seat = 3;
  net_push(en, NetState.{t = 0, x = 4, z = -2});
  rows := 0; shown: [45] f32;
  for f: 0..<45 {
    if f == 20 { s[0].net[0].ents[k].live = false; }   // the room's x: gone from your view
    d := e2_remotes_draw(s[..], E2Drawn.{}, 1.0 / 60.0);
    shown[f] = s[0].rfade[k]; if d.rec > 0 { rows += 1; }
  }
  #assert s[0].fade_ins == 1 && s[0].pops == 0;
  // up a sixtieth over E2_FADE_S a frame, never a jump; then down from where it was to nothing
  for f: 1..<45 { #assert abs(shown[f] - shown[f - 1]) < 0.03; }
  #assert shown[19] > 0.5 && shown[19] < 0.6 && shown[44] == 0 && s[0].rseat[k] == 0 && rows >= 38 && rows <= 40;
}
// The names over the others' heads, in Character Create's face (AR Kai C, cc.text): each where its
// head is on the screen, whole within E2_PLATE_NEAR m, fading to nothing at E2_PLATE_FAR, and not
// drawn when the land stands between your eye and the head.
e2_plates :: (s: [] E2, out: [] f32, at: int) -> int {
  v := at; k := s[0].k; w := s[0].width; h := s[0].height; s[0].plates_drawn = 0;
  e := s[0].eye; f := s[0].fwd; r := s[0].right; up := s[0].up;
  // nearest first, so a nearer name keeps its place and one behind it in the picture moves up clear
  order: [E2_REMOTES] int; dists: [E2_REMOTES] f32;
  for i: 0..<s[0].plate_n {
    p := s[0].plates[i]; dx := p.x - e[0]; dy := p.y - e[1]; dz := p.z - e[2];
    dists[i] = dx * dx + dy * dy + dz * dz; order[i] = i;
    j := i; while j > 0 && dists[order[j - 1]] > dists[order[j]] { t := order[j]; order[j] = order[j - 1]; order[j - 1] = t; j -= 1; }
  }
  taken: [E2_REMOTES * 4] f32; tn := 0;
  for oi: 0..<s[0].plate_n {
    i := order[oi];
    p := s[0].plates[i];
    hx := p.x; hy := p.y; hz := p.z;
    dx := hx - e[0]; dy := hy - e[1]; dz := hz - e[2];
    ahead := dx * f[0] + dy * f[1] + dz * f[2];
    dist := sqrt(dx * dx + dy * dy + dz * dz);
    s[0].plates[i].alpha = 0;
    if ahead < 0.5 || dist > f32(E2_PLATE_FAR) || !e2_plate_seen(e, hx, hy, hz) { continue; }
    alpha := ifx dist <= f32(E2_PLATE_NEAR) then 1.0f32 else 1 - (dist - f32(E2_PLATE_NEAR)) / f32(E2_PLATE_FAR - E2_PLATE_NEAR);
    sx := w * 0.5 + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / ahead;
    sy := (ifx s[0].cy > 0 then s[0].cy else h * 0.5) - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / ahead;
    cap := 13 * k; em := cc.sans_em(cap); wide: f32 = 0;
    name := cast(string) p.name[0..<p.name_n];
    for ch: name { if ch >= 32 && ch <= 126 { wide += f32(cc.CC_FONT_WIDTH[cast(int) ch - 32]) / f32(cc.CC_FONT_UPM) * em; } }
    // over a nearer name: up a line at a time, at most four
    for lift: 0..<4 {
      over := false;
      for q: 0..<tn { if sx - wide * 0.5 < taken[q * 4 + 2] && sx + wide * 0.5 > taken[q * 4] && sy - cap * 1.3 < taken[q * 4 + 3] && sy > taken[q * 4 + 1] { over = true; } }
      if !over { break; }
      sy -= cap * 1.4;
    }
    if sx + wide * 0.5 < 0 || sx - wide * 0.5 > w || sy < 0 || sy > h { continue; }
    ink := cc.ink(k, 0.95 * alpha, 0.93 * alpha, 0.82 * alpha); ink.light = alpha; ink.glow *= alpha; ink.core *= alpha;
    v = cc.text(out, v, name, sx - wide * 0.5, sy - cap, cap, ink);
    taken[tn * 4] = sx - wide * 0.5; taken[tn * 4 + 1] = sy - cap * 1.3; taken[tn * 4 + 2] = sx + wide * 0.5; taken[tn * 4 + 3] = sy; tn += 1;
    s[0].plates[i].alpha = alpha * p.fade; s[0].plates_drawn += 1; s[0].plates[i].sy = sy;
  }
  return e2_familiar_plates(s, out, v);
}
e2_familiar_plates :: (s: [] E2, out: [] f32, at: int) -> int {
  v := at; e := s[0].eye; f := s[0].fwd; r := s[0].right; up := s[0].up;
  for row: s[0].net[0].familiar_rows {
    if !row.live { continue; }
    y := e2_height(row.x, row.z) + 0.65;
    dx := row.x - e[0]; dy := y - e[1]; dz := row.z - e[2];
    ahead := dx * f[0] + dy * f[1] + dz * f[2];
    if ahead < 0.5 || dx * dx + dy * dy + dz * dz > 900 || !e2_plate_seen(e, row.x, y, row.z) { continue; }
    sx := s[0].width * 0.5 + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / ahead;
    sy := (ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5) - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / ahead;
    if sx < 0 || sx > s[0].width || sy < 0 || sy > s[0].height { continue; }
    k := s[0].k;
    name := rs_monster_block(RS_FAMILIAR_FORMS[row.form]).name;
    v = cc.text(out, v, name, sx - 14 * k, sy - 12 * k, 11 * k, cc.ink(k, 0.54, 0.88, 1));
    v = e2k_line(out, v, sx - 14 * k, sy, sx + 14 * k, sy, 2 * k, 0.18, 0.30, 0.36);
    v = e2k_line(out, v, sx - 14 * k, sy, sx - 14 * k + 28 * k * f32(row.hp) / f32(row.max), sy, 2 * k, 0.54, 0.88, 1);
  }
  return v;
}
#test "two names in the same place in the picture: the farther one moves up clear of the nearer" {
  s: [1] E2; out: [8192 * E2_VERTEX_FLOATS] f32;
  s[0].k = 1; s[0].width = 1280; s[0].height = 720; s[0].focal = 900;
  y := e2_height(0, -150) + 2;
  s[0].eye = [3]f32.[0, y, -150]; s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].plate_n = 2;
  s[0].plates[0].x = 0; s[0].plates[0].y = y + 0.4; s[0].plates[0].z = -162;   // farther, first in the list
  s[0].plates[1].x = 0; s[0].plates[1].y = y + 0.3; s[0].plates[1].z = -158;
  for i: 0..<2 { for c: 0..<6 { s[0].plates[i].name[c] = "Badger"[c]; } s[0].plates[i].name_n = 6; }
  _ := e2_plates(s[..], out[..], 0);
  #assert s[0].plates_drawn == 2 && s[0].plates[0].sy < s[0].plates[1].sy - 13;
}
// The land doesn't stand between the eye and (x, y, z): its height under eight points along the way.
e2_plate_seen :: (e: [3] f32, x: f32, y: f32, z: f32) -> bool {
  for q: 1..<8 {
    t := f32(q) / 8;
    px := e[0] + (x - e[0]) * t; py := e[1] + (y - e[1]) * t; pz := e[2] + (z - e[2]) * t;
    if e2_height(px, pz) > py { return false; }
  }
  return true;
}
#test "a name is drawn over a head ahead within reach, and not over one behind you or too far" {
  s: [1] E2; out: [4096 * E2_VERTEX_FLOATS] f32;
  s[0].k = 1; s[0].width = 1280; s[0].height = 720; s[0].focal = 900;
  y := e2_height(0, -150) + 2;
  s[0].eye = [3]f32.[0, y, -150]; s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].plate_n = 3;
  s[0].plates[0].x = 0; s[0].plates[0].y = e2_height(0, -158) + 2.05; s[0].plates[0].z = -158;   // 8 m ahead
  s[0].plates[1].x = 0; s[0].plates[1].y = e2_height(0, -142) + 2.05; s[0].plates[1].z = -142;   // behind
  s[0].plates[2].x = 0; s[0].plates[2].y = e2_height(0, -200) + 2.05; s[0].plates[2].z = -200;   // 50 m off
  for i: 0..<3 { s[0].plates[i].name[0] = 'A'; s[0].plates[i].name[1] = 'r'; s[0].plates[i].name_n = 2; }
  v := e2_plates(s[..], out[..], 0);
  #assert s[0].plates_drawn == 1 && v > 0 && s[0].plates[0].alpha == 1 && s[0].plates[1].alpha == 0 && s[0].plates[2].alpha == 0;
}
#test "a name over a head fades with distance and hides behind the land" {
  #assert e2_plate_seen([3] f32.[0, e2_height(0, 0) + 2, 0], 0, e2_height(0, -10) + 2, -10);
  #assert !e2_plate_seen([3] f32.[0, e2_height(0, 0) - 50, 0], 0, e2_height(0, -10) - 50, -10);
}
// A player key the API minted (POST /api/playtest/player): the host keeps it as this browser's player
// (host.js action 5) when no other action is waiting, and the seat ticket asks with it.
E2_ACT_PLAYER :: 5;
e2_keep_player :: (s: [] E2, record: string) #export_c #effects(all) {
  if record.count > 1024 { return; }
  for i: 0..<record.count { s[0].player_key[i] = record[i]; }
  s[0].player_key_n = record.count;
}

// ---- the class bar (#13058)
e2_test_cast_state :: (s: [] E2, c: int) {
  s[0].placed = true; s[0].width = 1440; s[0].height = 900; s[0].k = 1; s[0].clock = 10;
  s[0].you_x = 0; s[0].you_z = -10; s[0].you_y = e2_height(0, -10); s[0].you_face = 3.14159265;   // facing -z
  s[0].right = [3] f32.[1, 0, 0];
  n := s[0].net[..]; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 1;
  e2k_set_class(s[0].casts[..], c, 1); e2n_set_class(n, c, 1);
}
#test "Everglade II's bar holds your class's kit, its keys press it at what is ahead, it cools down, and it goes to the room (#13058)" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_WIZARD);
  k := s[0].casts[..];
  bar: [XC_SLOTS] FbAb; want := xk_bar(FB_CL_WIZARD, bar[..]);
  #assert k[0].bar_n == want && k[0].bar_n >= 2 && k[0].bar[0].name == bar[0].name;
  // the bar's pictures for the host, one a slot, and a press on its first
  out: [8192] f32;
  s[0].media_n = 0; _ := e2k_hud(s[..], out[..], 0);
  lines := 1; for i: 0..<s[0].media_n { if s[0].media[i] == 10 { lines += 1; } }
  #assert s[0].media_n > 0 && lines == k[0].bar_n;
  b := e2k_box(k, 0, 1440, 900, 1);
  #assert e2k_slot_at(s[..], (b[0] + b[2]) / 2, (b[1] + b[3]) / 2) == 0 && e2k_slot_at(s[..], 10, 10) < 0;
  // Fire Bolt (the Wizard's first? find it): flies ahead, to its range
  fb := -1; for i: 0..<k[0].bar_n { if k[0].bar[i].kind == FB_SPELL && k[0].bar[i].sp == SP_FIRE_BOLT { fb = i; } }
  #assert fb >= 0 && fb < 9;
  #assert e2_key(s[..], '1' + fb, 0) && k[0].pressed == 1 && s[0].net[0].cast_sent == 1;
  #assert fxp_live(k[0].puffs[..]) >= 1 && k[0].audio[0].played >= 1 && k[0].me[0].clip == figs.BD_SPELL;
  last := s[0].net[0].pipe[0].n - 1; p := s[0].net[0].pipe[0];
  cw := cast(string) p.buf[p.from[last]..<p.from[last] + p.len[last]];
  r: [1] WireRd; r[0] = wire_rd(cw, 1); wc := wire_read_cast(cw, r[..]);
  #assert cw[0] == 'C' && wc.slot == xk_slot(FB_CL_WIZARD, fb) && abs(wc.ax) < 0.05 && abs(wc.az - (-10 - 36.576)) < 0.05;
  // too soon: nothing; a second on, the next
  #assert e2_key(s[..], '1', 0) && k[0].pressed == 1;
  s[0].clock += 1.01; #assert e2_key(s[..], '1', 0) && k[0].pressed == 2;
  // the bolt fizzles where it ends: its sound a moment later
  heard := k[0].audio[0].played; s[0].clock += 1; e2k_step(s[..]); #assert k[0].audio[0].played > heard;
  // a key past the bar is left alone; in the studio the bar is away
  #assert !e2_key(s[..], '1' + k[0].bar_n, 0) || k[0].bar_n >= 9;
  s[0].cz[0].on = true; #assert !e2k_on(s[..]);
}
#test "another's e cast plays when the picture reaches its tick, at it as drawn: a blow swings and sounds there (#13058)" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_WIZARD);
  n := s[0].net[..]; n[0].mono = 1000;
  // seat 3, a Fighter, stands 4 m ahead of you
  for i: 0..<12 {
    q := e2n_ent(n, 3, true); en := n[0].ents[q..<q + 1]; en[0].kind = WK_PLAYER; en[0].seat = 3; en[0].seen = i;
    net_push(en, NetState.{t = 1000 + i * 33, x = 0, z = -14});
  }
  e2n_step(n, 1300);
  #assert e2n_remote_seat(n, 3).ok;
  fbar: [XC_SLOTS] FbAb; fn := xk_bar(FB_CL_FIGHTER, fbar[..]); fi := -1;
  for i: 0..<fn { if fbar[i].kind == FB_ATTACK && fi < 0 { fi = i; } }
  sword := xk_slot(FB_CL_FIGHTER, fi);
  #assert xk_entry(FB_CL_FIGHTER, sword).aim.kind == XC_AIM_MELEE;
  n[0].tick_t = n[0].rt + 500;   // a tick the picture hasn't reached
  b: [128] u8; m := wire_put_cast_e(b[..], 0, WireCastE.{ss = 3, slot = sword, ax = 0, ay = 1, az = -16, seed = 77});
  e2n_entry(n, cast(string) b[0..<m], WireD.{tick = 9});
  k := s[0].casts[..];
  e2k_step(s[..]); #assert k[0].others == 0 && n[0].cast_heard == 1;
  n[0].casts[0].t = n[0].rt;     // now it has
  heard := k[0].audio[0].played;
  e2k_step(s[..]);
  r := e2n_remote_seat(n, 3);
  #assert k[0].others == 1 && k[0].them[r.slot].clip == figs.BD_SLASH && abs(k[0].them[r.slot].at - s[0].clock) < 0.001;
  #assert fxp_live(k[0].puffs[..]) >= 1 && k[0].puffs[0].out_n > 0 && k[0].audio[0].played > heard;
  // its body swings over its gait, eased in
  g: figs.BdAnim; g.clip = figs.BD_IDLE;
  a := e2k_figure(g, k[0].them[r.slot], s[0].clock + 0.3); #assert a.clip == figs.BD_SLASH && a.prev == figs.BD_IDLE;
  #assert e2k_figure(g, k[0].them[r.slot], s[0].clock + 5).clip == figs.BD_IDLE;
}

#test "Everglade II shows a matching cast refusal over the hotbar and retires it after four seconds" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; n[0].mono=100;
  #assert e2k_press(s[..],0);
  out:[8192] f32; plain:=e2k_hud(s[..],out[..],0);
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,n[0].cast_seq); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]);
  #assert e2n_cast_message(n)=="CAST NOT ALLOWED";
  #assert e2k_hud(s[..],out[..],0)>plain;
  n[0].mono=4100; #assert e2n_cast_message(n).count==0;
  #assert e2k_hud(s[..],out[..],0)==plain;
}

#test "Everglade II lifts the cooldown it predicted for a cast the room refused; an older cast's refusal changes nothing (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..]; n[0].mono=100;
  #assert e2k_press(s[..],0); first:=n[0].cast_seq; sent:=n[0].cast_sent;
  #assert !e2k_press(s[..],0) && n[0].cast_sent==sent;   // predicted: cooling down
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,first-1); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]); e2k_step(s[..]); #assert !e2k_press(s[..],0);   // not your last cast's number
  count=wire_put(message[..],0,"r "); count=wire_int(message[..],count,first); count=wire_put(message[..],count," range");
  e2n_record(n,cast(string)message[0..<count]); e2k_step(s[..]);
  #assert e2k_press(s[..],0) && n[0].cast_sent==sent+1 && n[0].cast_seq!=first;
  // the new cast cools down again, and reconciling once more changes nothing
  e2k_step(s[..]); #assert !e2k_press(s[..],0) && s[0].casts[0].refused_seen==n[0].cast_refused;
}

#test "Everglade II's refused cast fades its look and sound and drops its fizzle; nothing is cut (#13046)" #steps 2000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..]; n[0].mono=100;
  k:=s[0].casts[..];
  fb:=-1; for i:0..<k[0].bar_n { if k[0].bar[i].kind==FB_SPELL && k[0].bar[i].sp==SP_FIRE_BOLT { fb=i; } }
  #assert fb>=0 && e2k_press(s[..],fb) && k[0].mine_n>=1 && k[0].voice1>k[0].voice0;
  first:=k[0].voice0+1; slot:=k[0].mine[0]; t0:=k[0].mine_t0[0];
  waiting:=0; for i:0..<E2K_LATER { if k[0].later[i].on && k[0].later[i].mine { waiting+=1; } } #assert waiting==1;
  k[0].audio[0].n=0;
  // the room refuses it: the cooldown lifts, the voices it started fade, the fizzle is dropped
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,n[0].cast_seq); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]);
  s[0].clock+=0.02; e2k_step(s[..]);
  heard:=cast(string)k[0].audio[0].lines[0..<k[0].audio[0].n];
  want:[16] u8; wn:=e2k_put(want[..],0,"-x"); wn=e2k_int(want[..],wn,first);
  has:=false; for i:0..<heard.count-wn+1 { if heard[i..<i+wn]==cast(string)want[0..<wn] { has=true; } }
  #assert has && k[0].undone==1 && k[0].mine_n==0;
  for i:0..<E2K_LATER { #assert !(k[0].later[i].on && k[0].later[i].mine); }
  // its effect dims a little each frame, never jumps, and is gone once faded
  last:=1.0f32;
  for f:0..<20 {
    if !k[0].puffs[0].on[slot] { break; }
    shown:=e2k_shown(k,slot,t0,s[0].clock); #assert shown<=last && shown>=0 && last-shown<0.25; last=shown;
    s[0].clock+=1.0f32/60; e2k_step(s[..]);
  }
  #assert !k[0].puffs[0].on[slot] || k[0].puffs[0].live[slot].t0!=t0;
  // another's cast is never faded by your refusal
  #assert e2k_shown(k,slot,t0+5,s[0].clock)==1;
}

#test "Everglade II's bar is your class's at your level: a level 5 Fighter's Action Surge goes by its own wire slot (#13046)" #steps 2000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER);
  k:=s[0].casts[..]; n:=s[0].net[..];
  e2k_set_class(k,FB_CL_FIGHTER,5); e2n_set_class(n,FB_CL_FIGHTER,5);
  want:[XC_SLOTS] FbAb; wn:=xk_bar_at(FB_CL_FIGHTER,5,want[..]);
  #assert k[0].level==5 && k[0].bar_n==wn && wn>xk_bar(FB_CL_FIGHTER,want[..]);
  surge:=-1; for i:0..<k[0].bar_n { if k[0].bar[i].kind==FB_SURGE { surge=i; } }
  #assert surge>=0 && e2k_press(s[..],surge);
  last:=n[0].pipe[0].n-1; p:=n[0].pipe[0]; cw:=cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]];
  r:[1] WireRd; r[0]=wire_rd(cw,1); wc:=wire_read_cast(cw,r[..]);
  #assert wc.slot==xk_wire(FB_CL_FIGHTER,k[0].bar[surge]) && xk_entry_at(FB_CL_FIGHTER,5,wc.slot).ab.kind==FB_SURGE && !xk_entry_at(FB_CL_FIGHTER,1,wc.slot).ok;
  // the hello says the level
  n[0].pipe[0].n=0; n[0].pipe[0].used=0; e2n_hello(n);
  pipe:=cast(string)n[0].pipe[0].buf[0..<n[0].pipe[0].used];
  has:=false; for i:0..<pipe.count-13 { if pipe[i..<i+13]=="srd-fighter-5" { has=true; } } #assert has;
}

#test "Everglade II draws the room's counts on the bar's icons and frames a Rage while it holds (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_BARBARIAN);
  k:=s[0].casts[..]; n:=s[0].net[..];
  out:[8192] f32; plain:=e2k_hud(s[..],out[..],0);
  // Rage (slot 1): 1 left, raging; the rest nothing to count
  m:[128] u8; c:=wire_put(m[..],0,"b"); c=wire_int(m[..],c,k[0].bar_n);
  for i:0..<k[0].bar_n { c=wire_int(m[..],c,ifx i==0 then wire_kit_v(1,true) else wire_kit_v(-1,false)); }
  e2n_record(n,cast(string)m[0..<c]);
  #assert e2n_kit(n,0,k[0].bar_n).ok && e2n_kit(n,0,k[0].bar_n).left==1 && e2n_kit(n,0,k[0].bar_n).on;
  drawn:=e2k_hud(s[..],out[..],0); #assert drawn>plain+4*6;   // a count and four frame lines
  // no longer raging, none left: the count only
  c=wire_put(m[..],0,"b"); c=wire_int(m[..],c,k[0].bar_n);
  for i:0..<k[0].bar_n { c=wire_int(m[..],c,ifx i==0 then wire_kit_v(0,false) else wire_kit_v(-1,false)); }
  e2n_record(n,cast(string)m[0..<c]);
  calm:=e2k_hud(s[..],out[..],0); #assert calm>plain && calm<drawn;
}

#test "Everglade II health label uses its server row including temporary HP and snapshot removal" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; label:[80] u8;
  #assert e2k_health_text(s[..],label[..])==0;
  geometry:[8192] f32; plain:=e2k_hud(s[..],geometry[..],0);
  frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=3,max=8,temp=7},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  count=e2k_health_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 3/8 · TEMP 7";
  #assert e2k_hud(s[..],geometry[..],0)>plain;
  newer:[WIRE_SF] s32; wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=6,max=8},newer[..]);
  count=wire_put_d(frame[..],0,WireD.{tick=2}); count=wire_put_s(frame[..],count,1,1,row[..],newer[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  count=e2k_health_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 6/8";
  count=wire_put_d(frame[..],0,WireD.{tick=3,f=1}); e2n_record(n,cast(string)frame[0..<count]);
  #assert e2k_health_text(s[..],label[..])==0;
  #assert e2k_hud(s[..],geometry[..],0)==plain;
}

#test "Everglade II health ignores peers and invalid rows and distinguishes unconscious from dead" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..];
  label:[80] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32;
  for pass:0..<8 {
    w:=WireS.{id=1,kind=WK_PLAYER,hp=0,max=8};
    if pass==1 { w.g=WG_DEAD; }
    if pass==2 { w.id=2; }
    if pass==3 { w.max=0; }
    if pass==4 { w.hp=9; }
    if pass==5 { w.hp=-1; }
    if pass==6 { w.temp=-1; }
    if pass==7 { w.kind=WK_BEAST; }
    wire_s_pack(w,row[..]); count:=wire_put_d(frame[..],0,WireD.{tick=pass+1,f=1});
    count=wire_put_s(frame[..],count,w.id,0,zero[..],row[..]); e2n_record(n,cast(string)frame[0..<count]);
    count=e2k_health_text(s[..],label[..]);
    if pass==0 { #assert cast(string)label[0..<count]=="HP 0/8 · UNCONSCIOUS"; }
    else if pass==1 { #assert cast(string)label[0..<count]=="HP 0/8 · DEAD"; }
    else { #assert count==0; }
  }
  e2n_down(n); #assert e2k_health_text(s[..],label[..])==0;
}

#test "Everglade II health names the conditions and spell effects the room's row holds, once each (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_CLERIC); n:=s[0].net[..];
  label:[E2K_HEALTH] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32; tick:=1;
  for pass:0..<5 {
    w:=WireS.{id=1,kind=WK_PLAYER,hp=5,max=12};
    if pass==1 { w.cond=RS_PRONE|RS_POISONED|WC_BLESSED; }
    if pass==2 { w.cond=RS_UNCONSCIOUS|RS_EXHAUSTION; w.hp=0; }
    if pass==3 { w.cond=RS_UNCONSCIOUS; }
    if pass==4 { w.cond=RS_BLINDED|RS_CHARMED|RS_DEAFENED|RS_EXHAUSTION|RS_FRIGHTENED|RS_GRAPPLED|RS_INCAPACITATED|RS_INVISIBLE|RS_PARALYZED|RS_PETRIFIED|RS_POISONED|RS_PRONE|RS_RESTRAINED|RS_STUNNED|WC_HALTED|WC_SLOWED|WC_BOUND|WC_BANED|WC_ENFEEBLED|WC_HEXED|WC_BLESSED|WC_FAITH; }
    wire_s_pack(w,row[..]); count:=wire_put_d(frame[..],0,WireD.{tick=tick,f=1}); tick+=1;
    count=wire_put_s(frame[..],count,1,0,zero[..],row[..]); e2n_record(n,cast(string)frame[0..<count]);
    count=e2k_health_text(s[..],label[..]); t:=cast(string)label[0..<count];
    if pass==0 { #assert t=="HP 5/12"; }
    if pass==1 { #assert t=="HP 5/12 · POISONED · PRONE · BLESSED"; }
    if pass==2 { #assert t=="HP 0/12 · UNCONSCIOUS · EXHAUSTED"; }
    if pass==3 {
      #assert t=="HP 5/12 · UNCONSCIOUS";
      // asleep, as the room's rest says: Unconscious once, as ASLEEP
      e2n_record(n,"z 0 3 1"); count=e2k_health_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · ASLEEP";
      e2n_record(n,"z 0 0 1");
    }
    if pass==4 { #assert t=="HP 5/12 · BLINDED · CHARMED · DEAFENED · EXHAUSTED · FRIGHTENED · GRAPPLED · INCAPACITATED · INVISIBLE · PARALYZED · PETRIFIED · POISONED · PRONE · RESTRAINED · STUNNED · HALTED · SLOWED · EARTHBOUND · BANED · ENFEEBLED · HEXED · BLESSED · SHIELD OF FAITH" && count<E2K_HEALTH; }
  }
}

#test "Everglade II rest controls follow the room's rest: a click asks it, sleep holds the keys, and the label says it (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER); n:=s[0].net[..]; n[0].mono=100;
  label:[80] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32; reqs:[4] int;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1}); count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  // until the room says your rest: no controls
  #assert e2k_rest_choices(s[..],reqs[..])==0;
  geometry:[8192] f32; plain:=e2k_hud(s[..],geometry[..],0);
  e2n_record(n,"z 0 0 1");
  #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_SHORT && reqs[1]==RS_REST_SLEEP && e2k_rest_label(s[..],reqs[1])=="LONG REST";
  #assert e2k_hud(s[..],geometry[..],0)>plain;
  // the controls sit over the bar, inside the page, apart from the slots
  b0:=e2k_box(s[0].casts[..],0,s[0].width,s[0].height,s[0].k); a:=e2k_rest_box(s[..],0,2); z:=e2k_rest_box(s[..],1,2);
  #assert a[3]<b0[1]-40 && a[0]>=0 && z[2]<=s[0].width && a[2]<z[0];
  #assert e2k_slot_at(s[..],(a[0]+a[2])/2,(a[1]+a[3])/2)<0;
  // the probes a browser check presses them by
  #assert e2_probe(s[..],30)==WIRE_REST_NONE && e2_probe(s[..],31)==2 && e2_probe(s[..],32)==RS_REST_SHORT && e2_probe(s[..],33)==RS_REST_SLEEP;
  #assert e2_probe(s[..],34)==cast(int)((a[0]+a[2])/2) && e2_probe(s[..],35)==cast(int)((a[1]+a[3])/2) && e2_probe(s[..],36)==cast(int)((z[0]+z[2])/2) && e2_probe(s[..],37)==cast(int)((z[1]+z[3])/2);
  #assert e2_probe(s[..],38)==cast(int)(s[0].you_x*100) && e2_probe(s[..],39)==0;
  sent:=n[0].pipe[0].n;
  #assert e2_pointer(s[..],(z[0]+z[2])/2,(z[1]+z[3])/2,0,0,1) && n[0].pipe[0].n==sent+1 && s[0].casts[0].pressed==0;
  p:=n[0].pipe[0]; last:=p.n-1; ask:=cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]];
  r:[1] WireRd; r[0]=wire_rd(ask,1); w:=wire_read_rest_ask(ask,r[..]); #assert ask[0]=='Z' && w.req==RS_REST_SLEEP && w.seq==n[0].rest_seq;
  // the room's answer: asleep; your keys move nothing, and the label says so
  m:[64] u8; c:=wire_put_rest_state(m[..],0,WireRestState.{seq=w.seq,code=WIRE_REST_SLEEP,dice=1}); e2n_record(n,cast(string)m[0..<c]);
  s[0].held=HOLD_W; mv:=e2_move_in(s[..]); #assert mv.key_y==0 && mv.key_x==0 && !mv.jump; s[0].held=0;
  count=e2k_health_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · ASLEEP";
  #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_WATCH && reqs[1]==RS_REST_END;
  // a refusal shows briefly over the bar in the cast feedback's place
  #assert e2n_rest(n,RS_REST_WATCH); c=wire_put_refused(m[..],0,n[0].rest_seq,"rest"); e2n_record(n,cast(string)m[0..<c]);
  #assert e2n_rest_message(n).count>0 && e2_probe(s[..],39)==1;
  e2n_record(n,"z 0 2 1"); #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_DIE;
  count=e2k_health_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · HIT DICE 1";
  e2n_down(n); #assert e2k_rest_choices(s[..],reqs[..])==0 && e2_probe(s[..],30)== -1 && e2_probe(s[..],31)==0 && e2_probe(s[..],32)== -1 && e2_probe(s[..],34)== -1;
}

#test "Everglade II Healer's Kit control asks the room and displays the room's result" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER);
  n:=s[0].net[..]; n[0].mono=100;
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  box:=e2k_aid_box(s[..]); sent:=n[0].pipe[0].n;
  #assert e2_pointer(s[..],(box[0]+box[2])/2,(box[1]+box[3])/2,0,0,1);
  #assert n[0].pipe[0].n==sent+1 && n[0].aid_left==-1;
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="U1 3000001";
  e2n_record(n,"u1 3000000 8"); #assert n[0].aid_left==-1;
  e2n_record(n,"u1 3000001 9"); #assert n[0].aid_left==9 && e2n_aid_message(n)=="ALLY STABILIZED";
  #assert e2n_aid(n);
  e2n_record(n,"r 3000002 kit"); #assert n[0].aid_left==9 && e2n_aid_message(n)=="CAN'T USE HEALER'S KIT";
  e2n_down(n); #assert n[0].aid_left==-1 && e2n_aid_message(n)=="";
}

#test "Everglade II Wild Companion control sends the selected form and payment to the room" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..]; n[0].mono=100;
  e2k_set_class(s[0].casts[..],FB_CL_DRUID,2); e2n_set_class(n,FB_CL_DRUID,2);
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  box:=e2k_familiar_box(s[..]); y:=(box[1]+box[3])/2;
  #assert e2_pointer(s[..],box[2]-45,y,0,0,1);
  #assert e2_pointer(s[..],box[2]-8,y,0,0,1);
  #assert e2_pointer(s[..],box[0]+10,y,0,0,1);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="M1 4000001 1 1";
  e2n_record(n,"m1 4000000 1"); #assert e2n_familiar_message(n)=="";
  e2n_record(n,"m1 4000001 1"); #assert e2n_familiar_message(n)=="COMPANION SUMMONED";
}

#test "Everglade II familiar snapshots replace visible rows and reject malformed or stale updates" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..];
  e2n_record(n,"m2 4 2 0 8 1500 -2000 1 1 2 0 -4000 5500 2 2");
  #assert n[0].familiar_rows[0].live && n[0].familiar_rows[0].form==8 && n[0].familiar_rows[0].x==1.5;
  #assert n[0].familiar_rows[2].live && n[0].familiar_rows[2].z==5.5;
  e2n_record(n,"m2 5 2 0 8 1500 -2000 1 1 0 0 -4000 5500 2 2");
  e2n_record(n,"m2 3 0");
  #assert n[0].familiar_tick==4 && n[0].familiar_rows[2].live;
  e2n_record(n,"m2 5 1 2 0 -4000 5500 2 2");
  #assert !n[0].familiar_rows[0].live && n[0].familiar_rows[2].live;
  s[0].k=1; s[0].width=1280; s[0].height=720; s[0].focal=900;
  s[0].eye=[3]f32.[-4,e2_height(-4,13.5)+2,13.5];
  s[0].fwd=[3]f32.[0,0,-1]; s[0].right=[3]f32.[1,0,0]; s[0].up=[3]f32.[0,1,0];
  out:[8192 * E2_VERTEX_FLOATS]f32;
  #assert e2_plates(s[..],out[..],0)>0;
  e2n_record(n,"m2 6 0");
  #assert !n[0].familiar_rows[2].live && e2_plates(s[..],out[..],0)==0;
}
