// Explicit local editor NPCs use the battle's ordinary creatures and turns.
// Their orders are independent of the automatic siege controller.
E5RF_VILLAGER :: 12; // additional humanoid appearance after the existing SRD raid appearances
E5RF_HIT_SLOT :: 500; // internal room-to-world melee strike, never a player bar slot

#test "forge NPC targets resolve existing townspeople and live players without guessing a creature" {
  r:[1]E5rRoom;e5rr_start(r[..],3);e5rr_test_people(r[..]);e5rr_join(r[..],0,8,8);
  #assert e5rf_target(r[..],FNP_PERSON,0)==E5RR_FOLK0 && e5rf_target(r[..],FNP_PLAYER,0)==E5RR_SEAT;
  #assert e5rf_target(r[..],FNP_PLAYER,1)== -1 && e5rf_target(r[..],FNP_NPC,1)== -1 && e5rf_target(r[..],FNP_CREATURE,1)== -1;
}

#test "forge NPCs use cultist and villager stat blocks and their explicit target takes real damage" #steps 300000000 {
  r:[1]E5rRoom;e5rr_start(r[..],31);
  p:=ForgeNpc.{id=1,group=1,kind=0,x=600,z=-1200};q:=e5rf_spawn(r[..],p);#assert q>=0;
  p.id=2;p.kind=1;p.x=700;v:=e5rf_spawn(r[..],p);#assert v>=0 && q!=v;
  #assert r[0].b[0].c[E5RR_BEAST0+q].npc==RS_NPC_CULTIST && r[0].b[0].c[E5RR_BEAST0+v].hp==4;
  #assert !e5rd_is(r[0].beasts[q]);e5rd_clear(r[..]);#assert r[0].beasts[q].id>0;
  a:=r[0].beasts[q..<q+1];a[0].forge_action=FNP_ATTACK;a[0].foe=E5RR_BEAST0+v;
  ev:[64*E5RR_EV_FLOATS]f32;damage:=false;
  for k:1..<81 {e5rr_step(r[..],f32(k));n:=e5rr_events(r[..],ev[..]);for e:0..<n {if ev[e*E5RR_EV_FLOATS]==f32(RS_EV_DAMAGE) && ev[e*E5RR_EV_FLOATS+3]==f32(E5RR_TGT_BEAST+r[0].beasts[v].tag) {damage=true;}}}
  #assert damage && r[0].b[0].c[E5RR_BEAST0+v].hp<4;
  #assert e5rf_target(r[..],FNP_NPC,2)== -1; // dead targets cannot receive another order
}
#test "forge NPCs stop without choosing a raid foe and building blows are ordinary turn actions" #steps 300000000 {
  r:[1]E5rRoom;e5rr_start(r[..],19);p:=ForgeNpc.{id=1,group=1,kind=2,x=600,z=-1200};q:=e5rf_spawn(r[..],p);
  bt:=r[0].beasts[q..<q+1];x:=bt[0].x;z:=bt[0].z;
  e5rr_step(r[..],1);#assert bt[0].x==x && bt[0].z==z && bt[0].foe== -1;
  bt[0].forge_action=FNP_ATTACK;bt[0].forge_building=true;bt[0].goal_x=x+1;bt[0].goal_z=z;
  e5rr_step(r[..],10);#assert bt[0].forge_hit>0 && bt[0].forge_swing>0;
}
e5rf_spawn :: (r:[]E5rRoom,p:ForgeNpc)->int {
  q:=-1;for k:0..<E5RR_BEASTS {if q<0 && r[0].beasts[k].id==0 && r[0].beasts[k].forge_id==0 {q=k;}}
  if q<0 {return -1;}i:=E5RR_BEAST0+q;b:=r[0].b[..];
  c:RsCreature;
  if p.kind==0 {c=rs_cultist("Cultist",3);}else if p.kind==2 {c=rs_guard("Guard",1);}else{c=fb_folk("Villager",1,10,4,e5r_scores(0));}
  c.x=e5r_sq(f32(p.x)/100);c.y=e5rr_z_cell(r,f32(p.z)/100);c.turn_at=b[0].clock+0.1;c.round_at=b[0].clock;
  b[0].c[i]=c;id:=r[0].next_id;r[0].next_id+=1;
  form:=E5RR_FORM_RAID+(ifx p.kind==1 then E5RF_VILLAGER else c.npc);
  r[0].beasts[q]=E5rBeast.{id=id,tag=id,by=-1,spell=-1,form=form,forge_id=p.id,x=f32(p.x)/100,z=f32(p.z)/100,goal_x=f32(p.x)/100,goal_z=f32(p.z)/100};
  return q;
}
e5rf_target :: (r:[]E5rRoom,kind:int,id:int)->int {
  i:=-1;
  if kind==FNP_PERSON && id>=0 && id<E5R_FOLK {i=E5RR_FOLK0+id;}
  if kind==FNP_PLAYER && id>=0 && id<E5RR_SEATS && r[0].live[id] {i=E5RR_SEAT+id;}
  if kind==FNP_NPC || kind==FNP_CREATURE {for q:0..<E5RR_BEASTS {bt:=r[0].beasts[q];if bt.id>0 && (ifx kind==FNP_NPC then bt.forge_id==id else bt.id==id) {i=E5RR_BEAST0+q;}}}
  if i<0 {return -1;}c:=r[0].b[0].c[i];return ifx c.dead || c.hp<=0 || c.x==E5R_AWAY then -1 else i;
}
e5rf_turn :: (r:[]E5rRoom,q:int) {
  bt:=r[0].beasts[q..<q+1];if bt[0].forge_action!=FNP_ATTACK {return;}
  b:=r[0].b[..];i:=E5RR_BEAST0+q;
  if bt[0].forge_building {
    dx:=bt[0].goal_x-bt[0].x;dz:=bt[0].goal_z-bt[0].z;
    if dx*dx+dz*dz>4 || !rs_can_act(b[0].c[i]) {return;}
    b[0].turn.action=true;w:=rs_weapon(b[0].c[i].weapon);amount:=0;for n:0..<w.dice {amount+=rs_roll(b[0].dice[..],w.sides);}
    bt[0].forge_hit=rs_max(amount+rs_mod(b[0].c[i].score[RS_STR]),1);bt[0].forge_swing=b[0].clock;return;
  }
  foe:=bt[0].foe;if foe<0 {return;}
  if b[0].c[foe].dead || b[0].c[foe].hp<=0 || b[0].c[foe].x==E5R_AWAY {bt[0].foe= -1;bt[0].forge_action=FNP_STOP;return;}
  if rs_attack(b,i,foe,false,-1) {bt[0].forge_swing=b[0].clock;}
}
