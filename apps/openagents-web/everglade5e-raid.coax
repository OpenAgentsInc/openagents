// The Cultist Raid offline, a preview (?raid=preview, everglade-raid-preview.coax): Darian Odiodei
// and fifty of his cult outside the South Gate, in the page's own SRD 5e battle (everglade5e-rules.coax
// loads this file). Every raider is a creature of that battle built from the shared armies
// (aethyr/rules/srd/npcs.coax rs_siege_attacker, rs_siege_arch), so its stat block, speed, level and
// spell slots are the engine's, and they fight as the 5E Lab's Siege has them (fivelab-siege.coax):
//   - they mass first, the leader 120 feet or so behind his swarm;
//   - then the casters open on the town: each Warlock steps up to its Eldritch Blast's 120 feet of
//     where it aims and casts it once a beat (its beams by its level: two at 5), and Darian casts
//     Fireball deeper in while a Pact slot is left (the slots come back on the battle's cooldown),
//     Eldritch Blast when none is;
//   - then the swarm charges: the Cultists and Fanatics Dash at the gate, through it and on at the
//     town, while the Warlocks keep casting and Darian stays back.
// The page plays each cast with the Warlock's real spells (everglade-warlock.coax wl_shoot: the beams
// and the Fireball break and burn what they reach, the SRD's object damage) and draws the raiders.
// The room server's raid (coax/web/room/room-events.coax, #12740) replaces this driver: the page draws
// its raiders and plays its casts the same way (everglade_raider, everglade_raid_cast).
//   coax/bin/coax test --library apps/openagents-web/everglade5e-rules.coax --only "raid"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

E5R_RAIDERS :: 51;          // Darian Odiodei and fifty of his cult (npcs.coax: the Siege's armies)
E5R_RAID_CASTS :: 32;
E5R_RAID_VOLLEY :: 3.0;     // s from the raid's start: the casters open
E5R_RAID_CHARGE :: 13.0;    // and the swarm charges
E5R_RAID_RUN :: 9.0;        // m/s at 40 feet (everglade5e-beasts.coax E5RR_RUN): 30 feet is 6.75
E5R_RAID_DASH :: 1.4;       // the Dash's extra, compressed as the battle's beat is
E5R_RAID_BLAST_FT :: 120; E5R_RAID_FIREBALL_FT :: 150;
// what the page plays (everglade-warlock.coax WL_BLAST, WL_FIREBALL)
E5R_RAID_K_BLAST :: 0; E5R_RAID_K_FIREBALL :: 1;
E5R_RAIDER_FLOATS :: 8;     // x, z, yaw, moving, level, hp, max, casting

E5rRaider :: struct {
  i: int;                     // its creature in the battle
  npc: int;                   // RS_NPC_* (npcs.coax): Cultist, Fanatic, Warlock or the leader
  x: f32; z: f32; yaw: f32; moving: bool;
  side: f32;                  // its place across the swarm, -1 to 1
  act_at: f32;                // its next turn (the battle's beat)
  cast_t: f32;                // when it last cast (its arm up)
}
E5rRaidCast :: struct { k: int; fx: f32; fz: f32; ax: f32; az: f32; seed: int; beams: int; }
E5rRaid :: struct {
  on: bool; started: bool;
  t: f32;                     // s since the raid began
  lead_x: f32; lead_z: f32;   // the leader's place
  gate_x: f32; gate_z: f32;   // the gate it comes through
  in_x: f32; in_z: f32;       // where the swarm runs once in
  n: int;
  who: [E5R_RAIDERS] E5rRaider;
  casts: [E5R_RAID_CASTS] E5rRaidCast; cast_n: int; cast_read: int;
}

// The raid outside the gate: the leader at (lead_x, lead_z), the swarm massed toward the gate at
// (gate_x, gate_z), and (in_x, in_z) where it runs once through. Each raider joins the battle.
e5r_raid_start :: (r: [] E5r, lead_x: f32, lead_z: f32, gate_x: f32, gate_z: f32, in_x: f32, in_z: f32) #export_c {
  if !r[0].started || r[0].raid[0].started { return; }
  b := r[0].b[..];
  w := r[0].raid[..];
  w[0] = E5rRaid.{on = true, started = true, lead_x = lead_x, lead_z = lead_z, gate_x = gate_x, gate_z = gate_z, in_x = in_x, in_z = in_z};
  fx := gate_x - lead_x; fz := gate_z - lead_z;
  d := sqrt(fx * fx + fz * fz); fx /= d; fz /= d;
  rx := fz; rz := -fx;
  yaw := e5rr_heading(fx, fz);
  for q: 0..<E5R_RAIDERS {
    c := ifx q == 0 then rs_siege_arch(RS_ARCH_NAME, 2, SP_ELDRITCH_BLAST) else rs_siege_attacker(q - 1, 2, SP_ELDRITCH_BLAST);
    x := lead_x; z := lead_z; side: f32 = 0;
    if q > 0 {
      // five ranks of ten, from 30 feet in front of the leader, a little out of line each
      k := q - 1; row := k / 10; col := k % 10;
      side = (f32(col) - 4.5) / 4.5;
      jx := f32(rs_roll(b[0].dice[..], 9) - 5) * 0.12; jz := f32(rs_roll(b[0].dice[..], 9) - 5) * 0.12;
      ahead := 9.0 + f32(row) * 2.0;
      across := side * (7.5 + f32(row) * 0.8);
      x = lead_x + fx * ahead + rx * across + jx; z = lead_z + fz * ahead + rz * across + jz;
    }
    i := rs_add(b, c, e5r_sq(x), e5r_sq(z));
    b[0].c[i].turn_at = b[0].clock;
    w[0].who[q] = E5rRaider.{i = i, npc = b[0].c[i].npc, x = x, z = z, yaw = yaw, side = side,
                             act_at = b[0].clock + f32(E5R_RAID_VOLLEY) + 0.11 * f32(q % 13)};
  }
  w[0].n = E5R_RAIDERS;
}
e5r_raid_started :: (r: [] E5r) -> bool #export_c { return r[0].raid[0].started; }

// Raider q: its stat block's kind (RS_NPC_*, 0 none), then into out x, z (metres), yaw, 1 while it
// moves, its level, Hit Points and their most, and the share of its cast's look left (1 just cast).
e5r_raider :: (r: [] E5r, q: int, out: [] f32) -> int #export_c {
  w := r[0].raid[0];
  if !w.started || q < 0 || q >= w.n || out.count < E5R_RAIDER_FLOATS { return 0; }
  a := w.who[q];
  c := r[0].b[0].c[a.i];
  if c.dead { return 0; }
  out[0] = a.x; out[1] = a.z; out[2] = a.yaw; out[3] = ifx a.moving then 1.0f32 else 0.0f32;
  out[4] = f32(c.level); out[5] = f32(c.hp); out[6] = f32(c.hp_max);
  left := 1 - (w.t - a.cast_t) / 0.8;
  out[7] = ifx a.cast_t <= 0 || left < 0 then 0.0f32 else ifx left > 1 then 1.0f32 else left;
  return a.npc;
}
// The next cast to play, into out: the page's spell (0 Eldritch Blast, 1 Fireball), from x, z, at
// x, z, its seed and its beams; false when none is left.
e5r_raid_cast :: (r: [] E5r, out: [] f32) -> bool #export_c {
  w := r[0].raid[..];
  if !w[0].started || w[0].cast_read >= w[0].cast_n || out.count < 7 { return false; }
  c := w[0].casts[w[0].cast_read % E5R_RAID_CASTS];
  w[0].cast_read += 1;
  out[0] = f32(c.k); out[1] = c.fx; out[2] = c.fz; out[3] = c.ax; out[4] = c.az; out[5] = f32(c.seed); out[6] = f32(c.beams);
  return true;
}
e5r_raid_put :: (w: [] E5rRaid, c: E5rRaidCast) {
  if w[0].cast_n - w[0].cast_read >= E5R_RAID_CASTS { w[0].cast_read += 1; }
  w[0].casts[w[0].cast_n % E5R_RAID_CASTS] = c;
  w[0].cast_n += 1;
}

// Eldritch Blast's beams at a Warlock's level (SRD 5.2.1: two at 5, three at 11, four at 17).
e5r_raid_beams :: (level: int) -> int {
  if level >= 17 { return 4; }
  if level >= 11 { return 3; }
  if level >= 5 { return 2; }
  return 1;
}
// The highest level with a slot left (0 none).
e5r_raid_slot :: (c: RsCreature) -> int {
  for d: 0..<9 { l := 9 - d; if c.slots[l] > 0 && l <= 5 { return l; } }
  return 0;
}

// Each dt seconds of the raid (from e5r_step): the raiders move, and each whose turn has come acts.
e5r_raid_step :: (r: [] E5r, dt: f32) {
  w := r[0].raid[..];
  if !w[0].started { return; }
  b := r[0].b[..];
  w[0].t += dt;
  t := w[0].t;
  gx := w[0].gate_x; gz := w[0].gate_z;
  fx := gx - w[0].lead_x; fz := gz - w[0].lead_z;
  d0 := sqrt(fx * fx + fz * fz); fx /= d0; fz /= d0;
  rx := fz; rz := -fx;
  for q: 0..<w[0].n {
    a := w[0].who[q..<q + 1];
    i := a[0].i;
    if b[0].c[i].dead { continue; }
    npc := a[0].npc;
    caster := npc == RS_NPC_WARLOCK || npc == RS_NPC_ARCH;
    // where it goes
    tx := a[0].x; tz := a[0].z; run := false;
    if !caster && t >= f32(E5R_RAID_CHARGE) {
      run = true;
      // to the gate first, a few abreast, then on into the town, spread across it
      ahead := (a[0].x - gx) * fx + (a[0].z - gz) * fz;
      if ahead < 1.5 { tx = gx + rx * a[0].side * 2.6; tz = gz + rz * a[0].side * 2.6; tx += fx * 3; tz += fz * 3; }
      else { tx = w[0].in_x + rx * a[0].side * 9 + fx * f32(q % 5) * 1.4; tz = w[0].in_z + rz * a[0].side * 9 + fz * f32(q % 5) * 1.4; }
    }
    // a caster steps up till its spell reaches where it aims
    aim_x := gx + rx * a[0].side * 16 + fx * 3; aim_z := gz + rz * a[0].side * 16 + fz * 3;
    reach := f32(E5R_RAID_BLAST_FT) * 0.3048 - 3;
    if npc == RS_NPC_ARCH {
      aim_x = gx + fx * 12 + rx * f32(rs_roll(b[0].dice[..], 21) - 11) * 1.2;
      aim_z = gz + fz * 12 + rz * f32(rs_roll(b[0].dice[..], 21) - 11) * 1.2;
      reach = f32(E5R_RAID_FIREBALL_FT) * 0.3048 - 3;
    }
    if caster && t >= f32(E5R_RAID_VOLLEY) {
      ax := aim_x - a[0].x; az := aim_z - a[0].z;
      far := sqrt(ax * ax + az * az);
      if far > reach { tx = a[0].x + ax / far * (far - reach + 0.5); tz = a[0].z + az / far * (far - reach + 0.5); }
    }
    dx := tx - a[0].x; dz := tz - a[0].z;
    d := sqrt(dx * dx + dz * dz);
    a[0].moving = false;
    if d > 0.3 {
      speed := f32(E5R_RAID_RUN) * f32(b[0].c[i].speed) / 40.0 * (ifx run then f32(E5R_RAID_DASH) else 0.6f32);
      step := lo_r(speed * dt, d - 0.3);
      a[0].x += dx / d * step; a[0].z += dz / d * step;
      a[0].moving = step > 0.001;
      a[0].yaw = e5rr_heading(dx, dz);
    }
    b[0].c[i].x = e5r_sq(a[0].x); b[0].c[i].y = e5r_sq(a[0].z);
    // its turn: a caster in reach casts at the town
    if !caster || t < f32(E5R_RAID_VOLLEY) || b[0].clock < a[0].act_at { continue; }
    a[0].act_at = b[0].clock + rs_beat(b);
    ax := aim_x - a[0].x; az := aim_z - a[0].z;
    if sqrt(ax * ax + az * az) > reach + 1 { continue; }
    a[0].yaw = e5rr_heading(ax, az);
    a[0].cast_t = t;
    k := E5R_RAID_K_BLAST; beams := e5r_raid_beams(b[0].c[i].level);
    if npc == RS_NPC_ARCH {
      l := e5r_raid_slot(b[0].c[i]);
      if l > 0 { b[0].c[i].slots[l] -= 1; k = E5R_RAID_K_FIREBALL; }   // Fireball, at a Pact slot's level
      else { aim_x = gx + rx * f32(rs_roll(b[0].dice[..], 11) - 6) * 2; aim_z = gz + rz * f32(rs_roll(b[0].dice[..], 11) - 6) * 2; }
    }
    seed := rs_roll(b[0].dice[..], 1000000) * 2 + 1;
    e5r_raid_put(w, E5rRaidCast.{k = k, fx = a[0].x, fz = a[0].z, ax = aim_x, az = aim_z, seed = seed, beams = beams});
  }
}
lo_r :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }

#test "raid: the Siege's armies mass, cast at the town once the volley opens, and charge" #steps 2000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -38);
  #assert r[0].raid[0].n == E5R_RAIDERS;
  out: [8] f32;
  #assert e5r_raider(r[..], 0, out[..]) == RS_NPC_ARCH && out[4] == 17;
  cult := 0; casters := 0;
  for q: 1..<E5R_RAIDERS {
    k := e5r_raider(r[..], q, out[..]);
    if k == RS_NPC_CULTIST || k == RS_NPC_FANATIC { cult += 1; }
    if k == RS_NPC_WARLOCK { casters += 1; }
  }
  #assert cult + casters == 50 && casters > 0;
  // nobody casts while massing
  for f: 0..<60 { e5r_step(r[..], r[0].b[0].clock + 0.04); }
  #assert r[0].raid[0].cast_n == 0;
  for f: 0..<300 { e5r_step(r[..], r[0].b[0].clock + 0.04); }
  #assert r[0].raid[0].cast_n > 4;
  fireball := false;
  c: [7] f32;
  while e5r_raid_cast(r[..], c[..]) { if c[0] == 1 { fireball = true; } }
  #assert fireball;
  // the charge: a Cultist is through the gate in a few seconds more
  for f: 0..<400 { e5r_step(r[..], r[0].b[0].clock + 0.04); }
  inside := 0;
  for q: 1..<E5R_RAIDERS { k := e5r_raider(r[..], q, out[..]); if k == RS_NPC_CULTIST && out[1] > -52 { inside += 1; } }
  #assert inside > 5;
}
