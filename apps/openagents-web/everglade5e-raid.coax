// The Cultist Raid offline, a preview (?raid=preview, everglade-raid-preview.coax): the standing
// siege on the south road (#12860), in the page's own SRD 5e battle (everglade5e-rules.coax loads
// this file). It runs the room's front (everglade-raid-front.coax), so the preview and a room's
// siege hold and tip the same way:
//   - the cult (Cultists, Fanatics, Warlocks and Cult Priests, by the raid's mix: everglade-raid-
//     tactics.coax rt_kind) musters at its camp at z -106, Darian Odiodei behind it; the watch
//     (Guards, Veterans, Knights and Scouts: RF_TOWN_MIX) musters inside the South Gate;
//   - each side holds posts about the line (rf_post: melee in front, ranged behind), fights whoever
//     of the other side is in reach, and never goes far past the line (E5R_LEASH);
//   - the line moves each second by the two sides' standing (rf_step_caps), and each side's
//     reinforcements come every RF_EVERY_S or sooner: a fallen fighter's place musters again once
//     its body has lain E5R_SIEGE_BACK_S;
//   - your help (your damage to the cult, your kills, your heals) tips it, as a room's players' does
//     (everglade-raid-scale.coax raid_player_worth): pushed to the camp, Darian can be hurt, and at
//     half his Hit Points he withdraws by Dimension Door; the camp falls, and after E5R_REGROUP_S the
//     cult musters again. The town never falls;
//   - what each caster casts is the room raid's choice (everglade-raid-spells.coax), each rolled by
//     the engine in the caster's own turn; one caster in each squad burns the stables before the
//     gate (rt_house_burner), and Darian puts Fireballs and Eldritch Blasts on them while none of the
//     watch is near; by what they take they go scorched, ablaze, then fall (#12769).
// Whoever drops to 0 Hit Points is dead and stays where it fell (the page plays the fall and the body).
// The page plays each cast as its own look (everglade-warlock.coax WL_*) and each shot as an arrow or
// bolt, and draws everyone on the town's own rig.
//   coax/bin/coax test --library apps/openagents-web/everglade5e-rules.coax --only "raid:"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

E5R_RAIDERS :: 51;          // Darian Odiodei and fifty of his cult (npcs.coax: the Siege's armies)
E5R_DEFENDERS :: 12;        // the watch at the gate (rs_siege_defender)
E5R_RAID_PEOPLE :: E5R_RAIDERS + E5R_DEFENDERS;
E5R_RAID_CASTS :: 96;
E5R_SIEGE_CULT :: 15;       // the cult standing at once: against the preview's 12 of the watch, a room's 30 to 24
E5R_SIEGE_BACK_S :: 8.0;    // s a fallen body lies (the page sinks it at 7) before its place musters again
E5R_REGROUP_S :: 60.0;      // s from the camp's fall to the cult's muster
E5R_LEASH :: 6.0;           // m: the farthest one goes past the line after a foe
E5R_WORTH_AT :: 24;         // the watch a player's worth is reckoned for (room-events.coax EV_WORTH_AT)
E5R_DARIAN_FT :: 150;       // Darian's reach at the stables, his Fireball's
E5R_RAID_RUN :: 9.0;        // m/s at 40 feet (everglade5e-beasts.coax E5RR_RUN): 30 feet is 6.75
E5R_RAID_DASH :: 1.3;       // the Dash's extra, compressed as the battle's beat is
E5R_RAID_REACH :: 1.6;      // m: a melee attack's 5 feet, middle to middle
E5R_RAID_MEET :: 9.0;       // m: a raider this near one of the watch goes for them; the watch steps out this far
E5R_RAID_ON_ONE :: 3;       // the most of the cult on any one of the watch; the rest go on
E5R_RAID_PLACE :: 3.0;      // m from its siege place: near enough to cast on the call
E5R_RAID_BOLT_FT :: 120;    // Eldritch Blast's and Fire Bolt's 120 feet
E5R_RAID_FIREBALL_FT :: 150;
// what the page plays (everglade-raid-preview.coax RP_*): a spell's look (everglade-raid-spells.coax
// RT_K_*), an arrow or a bolt, plus E5R_RAID_AT_ONE when it is aimed at a creature
E5R_RAID_K_BLAST :: RT_K_BLAST; E5R_RAID_K_FIREBALL :: RT_K_FIREBALL; E5R_RAID_K_ARROW :: 24; E5R_RAID_K_BOLT :: 25;   // after the looks (RT_K_LOOKS)
E5R_RAID_AT_ONE :: 32;
E5R_RAID_BLIGHT_FT :: 30;   // Blight's range
E5R_RAIDER_FLOATS :: 10;    // x, z, yaw, speed, level, hp, max, cast's look, dead (1), s since death

E5rRaider :: struct {
  i: int;                     // its creature in the battle
  npc: int;                   // RS_NPC_*: Cultist, Fanatic, Warlock, the leader, or one of the watch
  town: bool;                 // one of the watch
  role: int;                  // RT_SKIRM, RT_CASTER, RT_SUPPORT, RT_GUARD, RT_LEAD (rt_role_of, by the raid's mix)
  squad: int; k: int;         // its squad and its place in it
  x: f32; z: f32; yaw: f32; speed: f32;
  act_at: f32;                // its next turn (the battle's beat)
  away: bool;                 // not in the siege now: a place still to muster, or Darian withdrawn
  cast_t: f32;                // when it last cast or struck (its arm's look)
  died_t: f32;                // when it fell (-1 alive)
}
E5rRaidCast :: struct { k: int; fx: f32; fz: f32; ax: f32; az: f32; seed: int; beams: int; }
E5R_RAID_SQUADS :: 7;       // fifty in squads of eight
E5rRaid :: struct {
  on: bool; started: bool;
  t: f32;                     // s since the raid began
  gate: RtGate;               // the way in, its wall and towers
  you_x: f32; you_z: f32;     // the page's player
  call: int;                  // the calls so far
  arch_calls: int;            // the calls Darian has cast on
  seq: int;                   // the engine's log read so far (the Warlocks' Hellish Rebukes)
  n: int;
  who: [E5R_RAID_PEOPLE] E5rRaider;
  casts: [E5R_RAID_CASTS] E5rRaidCast; cast_n: int; cast_read: int;
  // what of the palisade's breach sections the page's town has broken (rt_wall_broke): the cult goes
  // through only there (#12747)
  holes: [RT_TOWN_GATES * RT_BREACHES] int;
  // what the stables took from the cult's casts, their pieces down in the page's town (e5r_raid_broke),
  // the most it has come to (rt_house_stage: they never stand again in a raid), and whether their fall's
  // Fireballs have gone
  house_cast: int; house_pieces: int; house: int; house_down: bool;
  house_seen: int = 1;           // the stages they have been through (bit rt_house_stage), a check's
  mix: RtMix;                      // the raid's mix of roles, a setting
  // the siege (#12860): the front, your help on it (points, fading) and the log read for it, the
  // second's own clock, each side's fighters sent (the first muster too), the stand, the camp's fall
  front: [1] RfFront; pts: f32; worth: f32; you_seq: int; sec: f32;
  sent: [2] int; numbers: [12] int; stand: bool; quiet: int; fell_t: f32 = -1; falls: int; stands: int;
  n_cult: int; n_town: int;
}

E5R_DEFEND_ROLES :: [12] int.[RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_KNIGHT, RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_GUARD,
                              RS_NPC_VETERAN, RS_NPC_SCOUT, RS_NPC_SCOUT, RS_NPC_VETERAN, RS_NPC_SCOUT, RS_NPC_GUARD];
// The k-th of the watch at the gate: the first of the shared army's town watch of its role.
e5r_raid_defender :: (k: int) -> RsCreature {
  want := E5R_DEFEND_ROLES[k % 12];
  seen := 0;
  for j: 0..<200 {
    if rs_town_role(j) != want { continue; }
    if seen == k / 12 + (ifx k >= 6 && want == RS_NPC_GUARD then 1 else 0) { return rs_siege_defender(j, 1); }
    seen += 1;
  }
  return rs_siege_defender(k, 1);
}

// Fighter q's stat block (0 Darian, the cult to E5R_RAIDERS, then the watch): the shared army's,
// by the raid's mix, the same on every page (#12771).
e5r_raid_make :: (w: [] E5rRaid, q: int, role: [] int) -> RsCreature {
  c: [1] RsCreature;
  role[0] = RT_LEAD;
  if q == 0 { c[0] = rs_siege_arch(RS_ARCH_NAME, 2, SP_ELDRITCH_BLAST); c[0].vigor = true; return c[0]; }   // Fiendish Vigor
  if q >= E5R_RAIDERS {
    kk := q - E5R_RAIDERS;
    c[0] = e5r_raid_defender(kk);
    role[0] = ifx rf_town_ranged(c[0].npc) then RT_CASTER else RT_MELEE;
    return c[0];
  }
  c[0] = rs_siege_attacker(q - 1, 2, SP_ELDRITCH_BLAST);
  kind := rt_kind(c[0].npc, q + 1, w[0].mix);
  if kind == RS_NPC_CULT_PRIEST {
    nm: [RS_NAME] u8; nn := rs_npc_named(nm[..], kind, w[0].numbers[kind % 12] + 1);
    c[0] = rs_cult_priest(cast(string) nm[0..<nn], 2, 3);
  }
  role[0] = rt_role_of(kind, q + 1, w[0].mix);
  w[0].numbers[kind % 12] += 1;
  if kind == RS_NPC_CULTIST { c[0].spell_ability = RS_WIS; }
  if kind == RS_NPC_WARLOCK { c[0].vigor = c[0].level >= 2; }   // Fiendish Vigor, its invocation from level 2
  return c[0];
}

// The siege on the south road before the gate at (gate_x, gate_z) (#12860): Darian at the camp, the
// first E5R_SIEGE_CULT of the cult about it, the watch inside the gate; the cult's other places wait
// to muster. (lead and in: where the camp and the town are, kept for the page's call.)
e5r_raid_start :: (r: [] E5r, lead_x: f32, lead_z: f32, gate_x: f32, gate_z: f32, in_x: f32, in_z: f32) #export_c {
  if !r[0].started || r[0].raid[0].started { return; }
  b := r[0].b[..];
  w := r[0].raid[..];
  g := rt_gate(gate_x, gate_z, 6, false, gate_x - 64, gate_x + 64, in_x, in_z);
  mix := w[0].mix;   // the raid's setting (e5r_raid_mix), kept
  w[0] = E5rRaid.{on = true, started = true, gate = g, you_x = in_x, you_z = in_z + 9};
  w[0].mix = mix; w[0].front[0] = rf_fresh();
  role: [1] int;
  for q: 0..<E5R_RAID_PEOPLE {
    town := q >= E5R_RAIDERS;
    c := e5r_raid_make(w, q, role[..]);
    i := rs_add(b, c, e5r_sq(lead_x), e5r_sq(lead_z));
    b[0].c[i].turn_at = b[0].clock;
    w[0].who[q] = E5rRaider.{i = i, npc = b[0].c[i].npc, town = town, role = role[0], squad = (q - 1) / RT_SQUAD, k = (q - 1) % RT_SQUAD,
                             x = lead_x, z = lead_z, died_t = -1, away = true};
    w[0].n = q + 1;
    if q == 0 { _ := e5r_raid_muster(w, b, 0, true); }
    else if town || q <= E5R_SIEGE_CULT { _ := e5r_raid_muster(w, b, q, true); }
    else { b[0].c[i].dead = true; b[0].c[i].hp = 0; b[0].c[i].x = e5r_sq(0); b[0].c[i].y = e5r_sq(-400); }   // a place still to muster: out of the battle
  }
  w[0].n = E5R_RAID_PEOPLE;
}

// Fighter q musters (a fresh stat block, at its side's muster place) when its place is free: away,
// or its body lain E5R_SIEGE_BACK_S, or `now`. Whether it did.
e5r_raid_muster :: (w: [] E5rRaid, b: [] RsBattle, q: int, now: bool) -> bool {
  a := w[0].who[q..<q + 1];
  if !now && !a[0].away && !(b[0].c[a[0].i].dead && a[0].died_t >= 0 && w[0].t - a[0].died_t >= f32(E5R_SIEGE_BACK_S)) { return false; }
  role: [1] int;
  c := e5r_raid_make(w, q, role[..]);
  side := ifx a[0].town then RF_TOWN else RF_CULT;
  p: [2] f32;
  if q == 0 { p[0] = 0; p[1] = f32(RF_CAMP_Z) - 4; }
  else { rf_muster(side, w[0].sent[side], p[..]); w[0].sent[side] += 1; }
  keep := b[0].c[a[0].i];
  c.initiative = keep.initiative; c.turn_at = b[0].clock + rs_beat(b) * rt_own_offset(q + 1);
  c.x = e5r_sq(p[0]); c.y = e5r_sq(p[1]);
  b[0].c[a[0].i] = c;
  a[0].npc = c.npc; a[0].role = role[0];
  a[0].x = p[0]; a[0].z = p[1]; a[0].yaw = e5rr_heading(0, ifx a[0].town then -1.0f32 else 1.0f32);
  a[0].away = false; a[0].died_t = -1; a[0].cast_t = 0; a[0].speed = 0;
  a[0].act_at = b[0].clock + rs_beat(b) * (ifx a[0].town then 0.13 * f32(q % 11) / 1.43 else rt_own_offset(q + 1));
  return true;
}

// The raid's mix of roles (a setting, before it starts): each role's share of the cult.
e5r_raid_mix :: (r: [] E5r, skirm: int, casters: int, support: int, guard: int) #export_c {
  r[0].raid[0].mix = RtMix.{skirm = skirm, casters = casters, support = support, guard = guard};
}
e5r_raid_started :: (r: [] E5r) -> bool #export_c { return r[0].raid[0].started; }
// The page's town: the palisade whole again (then each post down, e5r_raid_broke).
e5r_raid_whole :: (r: [] E5r) #export_c { for n: 0..<RT_TOWN_GATES * RT_BREACHES { r[0].raid[0].holes[n] = 0; } r[0].raid[0].house_pieces = 0; }
// A palisade post or a piece of the stables down in the page's town at (x, z) (everglade-raid-preview.coax
// everglade_raid_wall).
e5r_raid_broke :: (r: [] E5r, x: f32, z: f32) #export_c {
  rt_wall_broke(r[0].raid[0].holes[..], x, z);
  if rt_house_has(x, z) { r[0].raid[0].house_pieces += 1; e5r_raid_house(r[0].raid[..], 0); }
}
// The stables take n from a cast: what they have taken now, the most it has come to.
e5r_raid_house :: (w: [] E5rRaid, n: int) {
  w[0].house_cast += n;
  w[0].house = rt_house_add(w[0].house, rs_max(w[0].house_cast + w[0].house_pieces * RT_HOUSE_PIECE - w[0].house, 0));
  w[0].house_seen = w[0].house_seen | (1 << rt_house_stage(w[0].house));
}
// The stables' stage now (rt_house_stage).
e5r_raid_house_stage :: (r: [] E5r) -> int #export_c { return rt_house_stage(r[0].raid[0].house); }
e5r_raid_t :: (r: [] E5r) -> f32 #export_c { return r[0].raid[0].t; }
// Where the page's player stands: the cult stops short of it (a preview's player is no one's quarry).
e5r_raid_you :: (r: [] E5r, x: f32, z: f32) #export_c { r[0].raid[0].you_x = x; r[0].raid[0].you_z = z; }

// Person q of the raid (raiders, then the watch): its kind (RS_NPC_*, 0 none), then into out x, z
// (metres), yaw, speed (m/s), level, Hit Points and their most, the share of its cast's or blow's
// look left (1 just now), 1 when dead, and the seconds since it fell.
e5r_raider :: (r: [] E5r, q: int, out: [] f32) -> int #export_c {
  w := r[0].raid[0];
  if !w.started || q < 0 || q >= w.n || out.count < E5R_RAIDER_FLOATS { return 0; }
  a := w.who[q];
  if a.away { return 0; }   // not in the siege now: the page has none there
  c := r[0].b[0].c[a.i];
  out[0] = a.x; out[1] = a.z; out[2] = a.yaw; out[3] = a.speed;
  out[4] = f32(c.level); out[5] = f32(c.hp); out[6] = f32(c.hp_max);
  left := 1 - (w.t - a.cast_t) / 0.8;
  out[7] = ifx a.cast_t <= 0 || left < 0 then 0.0f32 else ifx left > 1 then 1.0f32 else left;
  out[8] = ifx a.died_t >= 0 then 1.0f32 else 0.0f32;
  out[9] = ifx a.died_t >= 0 then w.t - a.died_t else 0.0f32;
  return a.npc;
}
// The next cast or shot to play, into out: what (E5R_RAID_K_*), from x, z, at x, z, its seed and its
// beams (a shot's: 1 a hit); false when none is left.
e5r_raid_cast :: (r: [] E5r, out: [] f32) -> bool #export_c {
  w := r[0].raid[..];
  if !w[0].started || w[0].cast_read >= w[0].cast_n || out.count < 7 { return false; }
  c := w[0].casts[w[0].cast_read % E5R_RAID_CASTS];
  w[0].cast_read += 1;
  out[0] = f32(c.k); out[1] = c.fx; out[2] = c.fz; out[3] = c.ax; out[4] = c.az; out[5] = f32(c.seed); out[6] = f32(c.beams);
  return true;
}
e5r_raid_put :: (w: [] E5rRaid, c: E5rRaidCast) {
  if w[0].cast_n - w[0].cast_read >= E5R_RAID_CASTS { w[0].cast_read += 1; }
  w[0].casts[w[0].cast_n % E5R_RAID_CASTS] = c;
  w[0].cast_n += 1;
}

// Eldritch Blast's beams at a Warlock's level (SRD 5.2.1: two at 5, three at 11, four at 17).
e5r_raid_beams :: (level: int) -> int {
  if level >= 17 { return 4; }
  if level >= 11 { return 3; }
  if level >= 5 { return 2; }
  return 1;
}
// The highest level with a slot left (0 none), to 5th: a Pact slot.
e5r_raid_slot :: (c: RsCreature) -> int {
  for d: 0..<9 { l := 9 - d; if c.slots[l] > 0 && l <= 5 { return l; } }
  return 0;
}
lo_r :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }
e5r_raid_gap :: (a: E5rRaider, x: f32, z: f32) -> f32 { dx := a.x - x; dz := a.z - z; return sqrt(dx * dx + dz * dz); }
// The nearest of the other side to person q, alive (-1 none), within `reach` m. At most
// E5R_RAID_ON_ONE of the cult go for any one of the watch (`taken` counts them this beat). The watch
// sets on Darian only at the stand (#12860).
e5r_raid_foe :: (w: [] E5rRaid, b: [] RsBattle, q: int, reach: f32, taken: [] int) -> int {
  best := -1; gap := reach * reach;
  town := w[0].who[q].town; x := w[0].who[q].x; z := w[0].who[q].z;
  if taken.count < w[0].n { return -1; }
  for o: 0..<w[0].n {   // read in place: every raider asks every step
    if w[0].who[o].town == town || w[0].who[o].away || b[0].c[w[0].who[o].i].dead || (!town && taken[o] >= E5R_RAID_ON_ONE) || (town && o == 0 && !w[0].stand) { continue; }
    dx := w[0].who[o].x - x; dz := w[0].who[o].z - z;
    d := dx * dx + dz * dz;
    if d < gap { gap = d; best = o; }
  }
  return best;
}
// Raider q casts at the battle's creature of person o on call `call`, in a turn of its own: Hex first
// (its Bonus Action), then what everglade-raid-spells.coax picks (the engine's attack roll or save
// and damage), each played at them.
e5r_raid_bolt :: (w: [] E5rRaid, b: [] RsBattle, q: int, o: int, call: int) {
  a := w[0].who[q..<q + 1]; e := w[0].who[o];
  i := a[0].i;
  b[0].who = i; rs_start_turn(b, i);
  feet := rs_feet_to(b, i, e.i);
  hexed := rt_hex(b[0].c[i], feet) && rs_cast(b, i, SP_HEX, rt_pact(b[0].c[i]), 0, 0, e.i);
  sp := rt_spell(b[0].c[i], a[0].k, call, feet);
  ok := false;
  if sp >= 0 && rs_spell(sp).area == RS_A_NONE { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), 0, 0, e.i); }
  else if sp >= 0 { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), b[0].c[e.i].x, b[0].c[e.i].y, -1); }
  level := b[0].c[i].level;
  rs_end_turn(b, i); b[0].who = -1;
  if hexed { e5r_raid_look(w, b, q, RT_K_HEX, e.x, e.z, true, 1); }
  if !ok { return; }
  a[0].cast_t = w[0].t;
  a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
  e5r_raid_look(w, b, q, rt_look(sp), e.x, e.z, true, ifx sp == SP_ELDRITCH_BLAST then e5r_raid_beams(level) else 1);
}
// Support q in a turn of its own (everglade-raid-spells.coax rt_support): its buffs and debuffs, the
// engine's, each played at the one of the cult it blessed or the one of the watch it cursed.
e5r_raid_support :: (w: [] E5rRaid, b: [] RsBattle, q: int, o: int) {
  a := w[0].who[q..<q + 1];
  i := a[0].i;
  b[0].who = i; rs_start_turn(b, i);
  done: [RT_CASTS_MAX] RtCastDone;
  n := rt_support(b, i, q + 1, ifx o >= 0 then w[0].who[o].i else -1, done[..]);
  // a Fanatic at hand strikes too
  if o >= 0 && !b[0].turn.action && a[0].npc == RS_NPC_FANATIC && rs_feet_to(b, i, w[0].who[o].i) <= 5 { _ := rs_attack(b, i, w[0].who[o].i, false, -1); }
  rs_end_turn(b, i); b[0].who = -1;
  for c: 0..<n {
    to := e5r_raid_of(w, done[c].to);
    if to < 0 { continue; }
    a[0].cast_t = w[0].t;
    e := w[0].who[to];
    if to != q { a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z); }
    e5r_raid_look(w, b, q, rt_look(done[c].sp), e.x, e.z, true, ifx done[c].sp == SP_ELDRITCH_BLAST then e5r_raid_beams(b[0].c[i].level) else 1);
  }
}
// Person q's look k at (ax, az) for the page (`one`: aimed at a creature).
e5r_raid_look :: (w: [] E5rRaid, b: [] RsBattle, q: int, k: int, ax: f32, az: f32, one: bool, beams: int) {
  if k < 0 { return; }
  a := w[0].who[q];
  e5r_raid_put(w, E5rRaidCast.{k = k + (ifx one then E5R_RAID_AT_ONE else 0), fx = a.x, fz = a.z, ax = ax, az = az,
                               seed = rs_roll(b[0].dice[..], 1000000) * 2 + 1, beams = beams});
}
// The person of the raid who is creature i (-1 none).
e5r_raid_of :: (w: [] E5rRaid, i: int) -> int {
  for q: 0..<w[0].n { if w[0].who[q].i == i { return q; } }
  return -1;
}
// The Hellish Rebukes the Warlocks cast since the last step (the engine's, as their Reaction): each
// played on whom it burned.
e5r_raid_rebukes :: (w: [] E5rRaid, b: [] RsBattle) {
  by: [8] int; to: [8] int;
  n := rt_rebukes(b, w[0].seq, by[..], to[..]);
  w[0].seq = b[0].book[0].seq;
  for k: 0..<n {
    q := e5r_raid_of(w, by[k]); o := e5r_raid_of(w, to[k]);
    if q < 0 || o < 0 { continue; }
    e5r_raid_look(w, b, q, RT_K_REBUKE, w[0].who[o].x, w[0].who[o].z, true, 1);
  }
}
// Darian on a call, in a turn of his own, from his Pact slots (one kept for Dimension Door): with
// none of the watch near (`siege`), Fireball and Eldritch Blast at the stables; at the watch, Blight on one within 30 feet, Lightning Bolt down a Line of two or more with none of
// his own, Fireball; Eldritch Blast when no slot is left to spend.
e5r_raid_arch :: (w: [] E5rRaid, b: [] RsBattle, q: int, foe: int, siege: bool) {
  a := w[0].who[q..<q + 1];
  i := a[0].i;
  g := w[0].gate;
  n := w[0].arch_calls; w[0].arch_calls += 1;
  spend := b[0].c[i].slots[5] > 1;
  beams := e5r_raid_beams(b[0].c[i].level);
  a[0].cast_t = w[0].t;
  p: [2] f32;
  b[0].who = i; rs_start_turn(b, i);
  // False Life on himself by Fiendish Vigor while none of the watch is near (#12771)
  if b[0].c[i].vigor && b[0].c[i].temp <= 0 && foe < 0 && rs_cast(b, i, SP_FALSE_LIFE, 0, 0, 0, i) {
    rs_end_turn(b, i); b[0].who = -1;
    e5r_raid_look(w, b, q, RT_K_FALSE_LIFE, a[0].x, a[0].z, true, 1);
    return;
  }
  if siege && rt_house_near(g) {
    // the stables (#12769): a Fireball while a slot is spare, else Eldritch Blast's beams
    rt_house_mid(p[..]);
    a[0].yaw = e5rr_heading(p[0] - a[0].x, p[1] - a[0].z);
    if spend && n % 4 == 1 {
      b[0].c[i].slots[5] -= 1;
      e5r_raid_look(w, b, q, RT_K_FIREBALL, p[0], p[1], false, 0);
      e5r_raid_house(w, 12 + rs_roll(b[0].dice[..], 8));
    } else {
      e5r_raid_look(w, b, q, RT_K_BLAST, p[0], p[1], false, beams);
      e5r_raid_house(w, rs_roll(b[0].dice[..], RT_HOUSE_BOLT));
    }
    rs_end_turn(b, i); b[0].who = -1;
    return;
  }
  if foe >= 0 {
    e := w[0].who[foe];
    a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
    feet := rs_feet_to(b, i, e.i);
    ln: [2] int;
    rt_line(b, i, b[0].c[e.i].x, b[0].c[e.i].y, ln[..]);
    if spend && feet <= E5R_RAID_BLIGHT_FT && rs_cast(b, i, SP_BLIGHT, 5, 0, 0, e.i) { e5r_raid_look(w, b, q, RT_K_BLIGHT, e.x, e.z, true, 1); }
    else if spend && feet <= 100 && ln[0] >= 2 && ln[1] == 0 && rs_cast(b, i, SP_LIGHTNING_BOLT, 5, b[0].c[e.i].x, b[0].c[e.i].y, -1) {
      rt_line_end(a[0].x, a[0].z, e.x, e.z, f32(RT_LINE_M), p[..]);
      e5r_raid_look(w, b, q, RT_K_LIGHTNING, p[0], p[1], true, 1);
    }
    else if spend && rs_cast(b, i, SP_FIREBALL, 5, b[0].c[e.i].x, b[0].c[e.i].y, -1) { e5r_raid_look(w, b, q, RT_K_FIREBALL, e.x, e.z, true, 0); }
    else if rs_cast(b, i, SP_ELDRITCH_BLAST, 0, 0, 0, e.i) { e5r_raid_look(w, b, q, RT_K_BLAST, e.x, e.z, true, beams); }
  }
  rs_end_turn(b, i); b[0].who = -1;
}

// Person q strikes person o with weapon `wp` (the engine's attack, its roll and damage); a shot goes
// to the page to fly.
e5r_raid_strike :: (w: [] E5rRaid, b: [] RsBattle, q: int, o: int, wp: int, shot: int) {
  a := w[0].who[q..<q + 1]; e := w[0].who[o];
  hp := b[0].c[e.i].hp;
  b[0].who = a[0].i;
  _ := rs_strike(b, a[0].i, e.i, wp, false);
  b[0].who = -1;
  a[0].cast_t = w[0].t;
  a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
  if shot >= 0 {
    e5r_raid_put(w, E5rRaidCast.{k = shot, fx = a[0].x, fz = a[0].z, ax = e.x, az = e.z, seed = rs_roll(b[0].dice[..], 100000), beams = ifx b[0].c[e.i].hp < hp then 1 else 0});
  }
}

// Your help on the line since the last step, from the engine's log (#12860): damage you dealt the
// cult, the cult you dropped, your heals on the watch; your points, as a room's seat's
// (everglade-raid-scale.coax RAID_PTS_*).
e5r_raid_help :: (w: [] E5rRaid, b: [] RsBattle) {
  for e: 0..<rs_min(b[0].book[0].seq - w[0].you_seq, RS_EVENTS) {
    ev := rs_recent_at(b[0].book[..], e);
    if ev.by != E5R_ME { continue; }
    o := e5r_raid_of(w, ev.to);
    if o < 0 { continue; }
    cult := !w[0].who[o].town;
    if ev.kind == RS_EV_DAMAGE && cult { w[0].pts += f32(rs_max(ev.amount, 0)); }
    if (ev.kind == RS_EV_DOWN || ev.kind == RS_EV_DEATH) && cult { w[0].pts += f32(RAID_PTS_KILL); }
    if ev.kind == RS_EV_HEAL && !cult { w[0].pts += f32(RAID_PTS_HEAL) * f32(rs_max(ev.amount, 0)); }
  }
  w[0].you_seq = b[0].book[0].seq;
}

// Each second of the siege: the line moves by each side's standing and your help, each side's
// reinforcements muster, the stand begins or ends, and the camp falls or the cult regroups.
e5r_raid_second :: (w: [] E5rRaid, b: [] RsBattle) {
  t := w[0].t;
  if w[0].fell_t >= 0 {
    // the camp fallen: after the regroup, the cult musters again, Darian with it
    if t - w[0].fell_t < f32(E5R_REGROUP_S) { return; }
    w[0].fell_t = -1; w[0].front[0] = rf_fresh(); w[0].stand = false; w[0].pts = 0; w[0].quiet = 0;
    _ := e5r_raid_muster(w, b, 0, true);
    for q: 1..<1 + E5R_SIEGE_CULT { _ = e5r_raid_muster(w, b, q, true); }
    return;
  }
  n_cult := 0; n_town := 0;
  for q: 1..<w[0].n {
    a := w[0].who[q];
    if a.away || b[0].c[a.i].dead { continue; }
    if a.town { n_town += 1; } else { n_cult += 1; }
  }
  w[0].n_cult = n_cult; w[0].n_town = n_town;
  w[0].pts = raid_points_fade(w[0].pts, 1);
  if w[0].pts < 0.5 { w[0].pts = 0; }
  w[0].quiet = ifx w[0].pts > 0 then 0 else w[0].quiet + 1;
  w[0].worth = raid_player_worth(w[0].pts) * f32(E5R_DEFENDERS) / f32(E5R_WORTH_AT);
  rf_step_caps(w[0].front[..], n_cult, E5R_SIEGE_CULT, n_town, E5R_DEFENDERS, w[0].worth, 1);
  // reinforcements: the cult's but at the stand, the watch's always; each a place whose body has lain
  if rf_due(w[0].front[..], RF_CULT) && !w[0].stand {
    want := rf_wave(E5R_SIEGE_CULT, n_cult);
    for q: 1..<E5R_RAIDERS { if want > 0 && e5r_raid_muster(w, b, q, false) { want -= 1; } }
  }
  if rf_due(w[0].front[..], RF_TOWN) {
    want := rf_wave(E5R_DEFENDERS, n_town);
    for q: E5R_RAIDERS..<w[0].n { if want > 0 && e5r_raid_muster(w, b, q, false) { want -= 1; } }
  }
  z := w[0].front[0].z;
  dar := b[0].c[w[0].who[0].i..<w[0].who[0].i + 1];
  if !w[0].stand && z <= f32(RF_STAND_Z) { w[0].stand = true; w[0].stands += 1; }
  else if w[0].stand && (z > f32(RF_STAND_Z) + 8 || w[0].quiet >= 90) { w[0].stand = false; }
  // Darian can't be hurt but at the stand, and there not below half (he withdraws at it)
  dar[0].floor = ifx w[0].stand then dar[0].hp_max / 2 else dar[0].hp_max + 1;
  if w[0].stand && !w[0].who[0].away && dar[0].hp <= dar[0].hp_max / 2 {
    // the camp falls: Darian's Dimension Door, the cult's survivors gone with him
    e5r_raid_look(w, b, 0, RT_K_DOOR, w[0].who[0].x, w[0].who[0].z, true, 1);
    for q: 0..<E5R_RAIDERS {
      a := w[0].who[q..<q + 1];
      if a[0].away { continue; }
      if q == 0 || !b[0].c[a[0].i].dead { a[0].away = true; b[0].c[a[0].i].dead = true; b[0].c[a[0].i].hp = 0; b[0].c[a[0].i].y = e5r_sq(-400); }
    }
    w[0].fell_t = t; w[0].falls += 1;
  }
}

// Each dt seconds of the siege (from e5r_step): each fighter holds its post about the line, sets on
// whoever of the other side is in reach, and whoever's turn has come strikes or casts.
e5r_raid_step :: (r: [] E5r, dt: f32) {
  w := r[0].raid[..];
  if !w[0].started { return; }
  b := r[0].b[..];
  w[0].t += dt;
  t := w[0].t;
  w[0].gate = rt_with_house(w[0].house, rt_with_holes(w[0].holes[..], w[0].gate));   // its wall and the stables as the page's town has them now
  g := w[0].gate;
  // the stables fall: Darian's last Fireballs across them bring the rest down (#12769)
  if g.fallen && !w[0].house_down && w[0].n > 0 {
    w[0].house_down = true;
    hp: [2] f32;
    for k: 0..<RT_HOUSE_BLASTS { rt_house_blast(k, hp[..]); e5r_raid_look(w, b, 0, RT_K_FIREBALL, hp[0], hp[1], false, 0); }
  }
  e5r_raid_help(w, b);
  w[0].sec += dt;
  while w[0].sec >= 1 { w[0].sec -= 1; e5r_raid_second(w, b); }
  fz := w[0].front[0].z;
  // Darian's turns, a beat apart
  beat := rs_beat(b);
  call := int(t / beat);
  calling := call >= w[0].call;
  if calling { w[0].call = call + 1; }
  taken: [E5R_RAID_PEOPLE] int;
  xs: [E5R_RAID_PEOPLE] f32; zs: [E5R_RAID_PEOPLE] f32; up: [E5R_RAID_PEOPLE] bool;
  for q: 0..<w[0].n {
    a := w[0].who[q];
    xs[q] = a.x; zs[q] = a.z; up[q] = !a.away && !b[0].c[a.i].dead && !a.town && q > 0;
  }
  p: [5] f32;
  for q: 0..<w[0].n {
    a := w[0].who[q..<q + 1];
    i := a[0].i;
    a[0].speed = 0;
    if a[0].away { continue; }
    if b[0].c[i].dead {
      if a[0].died_t < 0 { a[0].died_t = t; }
      continue;
    }
    npc := a[0].npc;
    town := a[0].town;
    shooter := town && rf_town_ranged(npc);
    lead := q == 0;
    ranged := ifx town then shooter else (a[0].role == RT_CASTER || a[0].role == RT_SUPPORT || npc == RS_NPC_WARLOCK);
    burner := !town && !lead && rt_house_burner(g, a[0].k) && npc != RS_NPC_FANATIC && rt_house_stage(w[0].house) != RT_HOUSE_FALLEN;
    // its post about the line (rf_post), the same as a room's
    rf_post(ifx town then RF_TOWN else RF_CULT, ranged, lead, q + 1, fz, p[..]);
    tx := p[0]; tz := p[1]; run := false; stop: f32 = 0.3;
    reach := ifx lead then f32(RT_THREAT) else (ifx ranged then f32(E5R_RAID_BOLT_FT) * 0.3048 * 0.3 else f32(E5R_RAID_MEET));
    foe := e5r_raid_foe(w, b, q, reach, taken[..]);
    if foe >= 0 && !ranged && !lead {
      // melee: at the foe, the cult at most E5R_RAID_ON_ONE on one
      if !town { taken[foe] += 1; }
      tx = w[0].who[foe].x; tz = w[0].who[foe].z; stop = f32(E5R_RAID_REACH) * 0.8; run = true;
    }
    if lead && foe >= 0 && b[0].c[i].slots[5] > 0 {
      // Darian: Dimension Door back from one come near
      rt_door(a[0].x, a[0].z, w[0].who[foe].x, w[0].who[foe].z, 0, f32(RF_CAMP_Z) - 10, p[..]);
      rt_free(g, p[0], p[1], p[..]);
      b[0].c[i].slots[5] -= 1;
      a[0].x = p[0]; a[0].z = p[1]; tx = p[0]; tz = p[1];
    }
    // never far past the line; the cult never in the town
    if town { tz = hi_r(tz, fz - f32(E5R_LEASH)); }
    else if !lead { tz = lo_r(lo_r(tz, fz + f32(E5R_LEASH)), f32(RF_HOLD_Z) + 2); }
    if !town && !lead {
      // its bounds (#12771): it holds to cast, buff or strike, a step or two about at its goal
      bound: [1] f32;
      near_goal := (tx - a[0].x) * (tx - a[0].x) + (tz - a[0].z) * (tz - a[0].z) < 3.6 * 3.6;
      if (foe >= 0 || near_goal) && !rt_bound(q + 1, a[0].role, t, bound[..]) && !run { tx = a[0].x; tz = a[0].z; }
      else if foe < 0 && near_goal { rt_shuffle(q + 1, bound[0], tx, tz, p[..]); tx = p[0]; tz = p[1]; }
      // round the ground kept clear about you
      rt_around(g, a[0].x, a[0].z, tx, tz, w[0].you_x, w[0].you_z, f32(RT_SPAWN_R), p[..]); tx = p[0]; tz = p[1];
    }
    dx := tx - a[0].x; dz := tz - a[0].z;
    d := sqrt(dx * dx + dz * dz);
    rt_way(g, a[0].x, a[0].z, tx, tz, w[0].you_x, w[0].you_z, ifx town then 0.0f32 else f32(RT_SPAWN_R), p[..]);
    wx := p[0] - a[0].x; wz := p[1] - a[0].z; wd := sqrt(wx * wx + wz * wz); direct := p[2] > 0.5;
    left := ifx direct then wd - stop else wd;
    if d > stop && left > 0 && wd > 0.0001 {
      speed := f32(E5R_RAID_RUN) * f32(b[0].c[i].speed) / 40.0 * (ifx run || d > 8 then f32(E5R_RAID_DASH) else 0.55f32) * rt_pace(q + 1);   // its own pace
      st := lo_r(speed * dt, left);
      mx := wx / wd * st; mz := wz / wd * st;
      if !town {
        rt_separate(a[0].x, a[0].z, q, xs[..], zs[..], up[..], w[0].n, p[..]);
        mx += p[0] * speed * dt * 0.6; mz += p[1] * speed * dt * 0.6;
        ml := sqrt(mx * mx + mz * mz);
        lim := speed * dt;
        if ml > lim && ml > 0 { mx = mx / ml * lim; mz = mz / ml * lim; }
      }
      rt_slide(g, a[0].x, a[0].z, mx, mz, p[..]);
      mx = p[0] - a[0].x; mz = p[1] - a[0].z;
      a[0].x += mx; a[0].z += mz;
      a[0].speed = sqrt(mx * mx + mz * mz) / hi_r(dt, 0.0001);
      a[0].yaw = e5rr_heading(wx, wz);
    } else {
      if !town && !lead {
        rt_separate(a[0].x, a[0].z, q, xs[..], zs[..], up[..], w[0].n, p[..]);
        rt_slide(g, a[0].x, a[0].z, p[0] * dt * 1.2, p[1] * dt * 1.2, p[..]);
        a[0].x = p[0]; a[0].z = p[1];
      }
      if foe >= 0 { a[0].yaw = e5rr_heading(w[0].who[foe].x - a[0].x, w[0].who[foe].z - a[0].z); }
      else { a[0].yaw = e5rr_heading(0, ifx town then -1.0f32 else 1.0f32); }
    }
    b[0].c[i].x = e5r_sq(a[0].x); b[0].c[i].y = e5r_sq(a[0].z);
    if lead {
      if !calling { continue; }
      // the watch within Fireball's 150 feet; with none near, the stables
      foe = e5r_raid_foe(w, b, q, f32(E5R_RAID_FIREBALL_FT) * 0.3048, taken[..]);
      hm: [2] f32; rt_house_mid(hm[..]);
      hx := hm[0] - a[0].x; hz := hm[1] - a[0].z;
      at_house := foe < 0 && rt_house_stage(w[0].house) != RT_HOUSE_FALLEN && hx * hx + hz * hz <= (f32(E5R_DARIAN_FT) * 0.3048) * (f32(E5R_DARIAN_FT) * 0.3048);
      e5r_raid_arch(w, b, q, foe, at_house);
      continue;
    }
    if b[0].clock < a[0].act_at || !rs_can_act(b[0].c[i]) { continue; }
    holding := town || !rt_moving(q + 1, a[0].role, t);
    if !town && a[0].role == RT_SUPPORT {
      // a support on its own turns while it holds: its buffs on the cult, its debuffs on the watch
      if !holding { continue; }
      a[0].act_at = b[0].clock + beat;
      e5r_raid_support(w, b, q, foe);
      continue;
    }
    if !town && ranged {
      if !holding { continue; }
      a[0].act_at = b[0].clock + beat;
      if burner {
        // the stables before the gate, from its post, till they fall (#12769)
        hm: [2] f32; rt_house_mid(hm[..]);
        hx := hm[0] - a[0].x; hz := hm[1] - a[0].z;
        if hx * hx + hz * hz <= (f32(E5R_RAID_BOLT_FT) * 0.3048) * (f32(E5R_RAID_BOLT_FT) * 0.3048) {
          a[0].cast_t = t; a[0].yaw = e5rr_heading(hx, hz);
          e5r_raid_look(w, b, q, rt_siege_look(npc), hm[0], hm[1], false, ifx npc == RS_NPC_WARLOCK then e5r_raid_beams(b[0].c[i].level) else 1);
          e5r_raid_house(w, rs_roll(b[0].dice[..], RT_HOUSE_BOLT));
          continue;
        }
      }
      if foe < 0 { continue; }
      // a Warlock between its blasts keeps its False Life up and puts Bane or Ray of Enfeeblement on its foe
      if npc == RS_NPC_WARLOCK && (q + call) % 3 == 0 { e5r_raid_support(w, b, q, foe); continue; }
      e5r_raid_bolt(w, b, q, foe, call + q);
      continue;
    }
    if foe < 0 { continue; }
    gap := e5r_raid_gap(w[0].who[foe], a[0].x, a[0].z);
    if shooter && b[0].c[i].ranged >= 0 {
      a[0].act_at = b[0].clock + beat;
      if gap <= f32(E5R_RAID_REACH) { e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1); }
      else { e5r_raid_strike(w, b, q, foe, b[0].c[i].ranged, ifx npc == RS_NPC_VETERAN then E5R_RAID_K_BOLT else E5R_RAID_K_ARROW); }
    } else if npc == RS_NPC_FANATIC && gap > f32(E5R_RAID_REACH) && gap <= 18.3 && b[0].c[i].slots[2] > 0 && b[0].c[w[0].who[foe].i].humanoid {
      // a Fanatic: Hold Person (its 1/Day) on one of the watch it closes on
      a[0].act_at = b[0].clock + beat;
      b[0].who = i; rs_start_turn(b, i);
      held := rs_cast(b, i, SP_HOLD_PERSON, 2, 0, 0, w[0].who[foe].i);
      rs_end_turn(b, i); b[0].who = -1;
      if held { a[0].cast_t = t; e5r_raid_look(w, b, q, RT_K_HOLD, w[0].who[foe].x, w[0].who[foe].z, true, 1); }
    } else if gap <= f32(E5R_RAID_REACH) {
      a[0].act_at = b[0].clock + beat;
      e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1);
      // a Multiattack's second blow (Extra Attack)
      if b[0].c[i].extra_attack > 0 && !b[0].c[w[0].who[foe].i].dead { e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1); }
    }
  }
  e5r_raid_rebukes(w, b);
}

#test "raid: with no help the siege holds before the palisade: the cult at its posts south of the line, the watch north of it, both losing fighters and mustering more (#12860)" #steps 12000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -25);
  e5r_raid_you(r[..], 0, -16);
  w := r[0].raid[..];
  #assert w[0].n == E5R_RAID_PEOPLE;
  out: [10] f32;
  #assert e5r_raider(r[..], 0, out[..]) == RS_NPC_ARCH && out[4] == 17;
  // the first muster: Darian, E5R_SIEGE_CULT of the cult, the watch; the cult's other places away
  up := 0; away := 0;
  for q: 1..<E5R_RAIDERS { if e5r_raider(r[..], q, out[..]) != 0 { up += 1; #assert out[1] < -100; } else { away += 1; } }
  #assert up == E5R_SIEGE_CULT && away == E5R_RAIDERS - 1 - E5R_SIEGE_CULT;
  for q: E5R_RAIDERS..<E5R_RAID_PEOPLE { #assert e5r_raider(r[..], q, out[..]) != 0 && out[1] > -56; }
  // 40 s
  lo: f32 = 0; hi: f32 = -1000; met := false; kinds := 0;
  c: [7] f32;
  for f: 0..<1000 {
    e5r_step(r[..], r[0].b[0].clock + 0.04);
    while e5r_raid_cast(r[..], c[..]) { k := int(c[0]) % E5R_RAID_AT_ONE; if k < E5R_RAID_K_ARROW { kinds = kinds | (1 << k); } }
    z := w[0].front[0].z;
    lo = lo_r(lo, z); hi = hi_r(hi, z);
    if f % 50 == 0 {
      // the cult never in the town, the watch never at the camp
      for q: 1..<E5R_RAID_PEOPLE {
        a := w[0].who[q];
        if a.away || a.died_t >= 0 { continue; }
        if !a.town { #assert a.z < f32(RF_HOLD_Z) + 2.5; } else { #assert a.z > -95; }
      }
    }
    if f == 0 { lo = z; }
  }
  #assert !w[0].stand && w[0].falls == 0;
  #assert rf_in_band(hi);
  #assert rf_in_band(lo);
  // both sides lost fighters and mustered more
  #assert w[0].sent[RF_CULT] > E5R_SIEGE_CULT && w[0].sent[RF_TOWN] > E5R_DEFENDERS;
  // the casters' spells at the watch, the watch's shots at the cult
  #assert (kinds & (1 << RT_K_FIRE_BOLT)) != 0 || (kinds & (1 << RT_K_BLAST)) != 0;
  // Darian can't be hurt short of the stand
  dar := r[0].b[0].c[w[0].who[0].i];
  #assert dar.floor > dar.hp_max / 2;
}

#test "raid: your help tips the siege: the line to the camp, Darian hurt at the stand withdraws, the camp falls, and the cult musters again (#12860)" #steps 12000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -25);
  e5r_raid_you(r[..], 0, -16);
  w := r[0].raid[..];
  b := r[0].b[..];
  // your damage to one of the cult counts, from the engine's log
  l: [1] RsLine;
  rs_tell(b, RS_EV_DAMAGE, -1, E5R_ME, w[0].who[3].i, 9, RS_FORCE, l[..]);
  e5r_step(r[..], b[0].clock + 0.04);
  #assert w[0].pts >= 9;
  // your help is a few fighters' worth on the watch's side: the line moves toward the camp
  z0 := w[0].front[0].z;
  w[0].pts = f32(RAID_WORTH_FULL) * 4;
  #assert w[0].pts > 0;
  // the line at the camp (as a room's four players take it there): the stand
  w[0].front[0].z = f32(RF_CAMP_Z) + 1;
  e5r_step(r[..], b[0].clock + 1.0);
  #assert w[0].stand && w[0].stands == 1 && w[0].worth > 0 && z0 == f32(RF_MID_Z);
  dar := b[0].c[w[0].who[0].i..<w[0].who[0].i + 1];
  // at the stand he can be hurt, to half: then the camp falls
  e5r_step(r[..], b[0].clock + 1.0);
  #assert dar[0].floor == dar[0].hp_max / 2;
  rs_damage(b, E5R_ME, w[0].who[0].i, dar[0].hp_max, RS_FORCE, false, -1);
  #assert dar[0].hp == dar[0].hp_max / 2;
  e5r_step(r[..], b[0].clock + 1.0);
  #assert w[0].falls == 1 && w[0].who[0].away;
  out: [10] f32;
  standing := 0; for q: 0..<E5R_RAIDERS { if e5r_raider(r[..], q, out[..]) != 0 && out[8] == 0 { standing += 1; } }
  #assert standing == 0;
  // the regroup: the cult and Darian again at the camp, the line in the middle
  w[0].t = w[0].fell_t + f32(E5R_REGROUP_S);
  for f: 0..<30 { e5r_step(r[..], b[0].clock + 0.04); if w[0].fell_t < 0 { break; } }
  #assert w[0].fell_t < 0;
  #assert !w[0].who[0].away;
  #assert !w[0].stand;
  #assert rf_in_band(w[0].front[0].z);
  up := 0; for q: 1..<E5R_RAIDERS { if e5r_raider(r[..], q, out[..]) != 0 && out[8] == 0 { up += 1; } }
  #assert up == E5R_SIEGE_CULT;
}

#test "raid: the cult burns the stables by stages from its posts till Darian's Fireballs bring them down (#12769)" #steps 12000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -25);
  e5r_raid_you(r[..], 0, -16);
  stage := RT_HOUSE_WHOLE; fall_balls := 0; fell_at: f32 = -1;
  c: [7] f32;
  for f: 0..<1500 {
    e5r_step(r[..], r[0].b[0].clock + 0.04);
    w := r[0].raid[0];
    now := e5r_raid_house_stage(r[..]);
    #assert now >= stage;
    if now != stage { stage = now; if now == RT_HOUSE_FALLEN { fell_at = w.t; } }
    while e5r_raid_cast(r[..], c[..]) {
      if fell_at >= 0 && w.t - fell_at < 0.05 && int(c[0]) == RT_K_FIREBALL && rt_house_has(c[3], c[4]) { fall_balls += 1; }
    }
    if stage == RT_HOUSE_FALLEN && fell_at >= 0 && w.t - fell_at > 0.1 { break; }
  }
  // whole, scorched, ablaze, fallen: each in turn
  #assert stage == RT_HOUSE_FALLEN && r[0].raid[0].house_seen == 15;
  #assert fall_balls >= RT_HOUSE_BLASTS;
}
