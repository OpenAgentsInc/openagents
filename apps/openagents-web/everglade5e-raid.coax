// The Cultist Raid offline, a preview (?raid=preview, everglade-raid-preview.coax): Darian Odiodei
// and fifty of his cult outside the South Gate, and the town watch holding it, in the page's own SRD
// 5e battle (everglade5e-rules.coax loads this file). Every raider and defender is a creature of that
// battle built from the shared armies (aethyr/rules/srd/npcs.coax rs_siege_attacker, rs_siege_arch,
// rs_siege_defender), so stat blocks, levels, slots, attacks and every roll are the engine's. How the
// cult fights is the room raid's own tactics (everglade-raid-tactics.coax), not this file's:
//   - squads of eight (RT_SQUAD), each member at its own place in a spread siege line: the casters
//     (the Warlocks and two Cultists in three, by rt_role) 14 m out, the screen before them;
//   - every squad's casters fire together on the call, so the volleys come big: half at a gate tower,
//     half at the squad's breach in the wall, till its volleys are done (RT_SIEGE_VOLLEYS);
//   - then they go in, by the gate or their breach, each to its own place in the town (rt_ring),
//     round the ground kept clear about you (rt_route, RT_SPAWN_R), never in one another (rt_separate);
//   - Darian holds RT_BACK behind his lines and commands from there (rt_command), casting from his
//     Pact slots: Fireball at a gate tower and Lightning Bolt at the other's top in the siege, then
//     Blight, Lightning Bolt and Fireball at the watch; Dimension Door takes him back if one comes
//     near (rt_door);
//   - what each caster casts is the room raid's choice too (everglade-raid-spells.coax): the
//     Cultists' Fire Bolt, Ray of Frost and Chill Touch, the Warlocks' Hex, Burning Hands, Eldritch
//     Blast and their Hellish Rebuke when the watch hurts one, a Fanatic's Hold Person, each rolled
//     by the engine in the caster's own turn.
//   - one caster in each squad burns the stables outside the gate (RT_AIM_HOUSE), and Darian puts
//     Fireballs and Eldritch Blasts on them too; by what they take, and their pieces down in the
//     page's town, they go scorched, ablaze, then fall to Darian's last Fireballs, and fallen are
//     rubble the cult walks over (#12769);
//   - each raider goes at its own pace and starts its charge its own moment after its squad's
//     call (rt_pace, rt_start), so a squad never moves as one block (#12769).
// The watch holds the gate: the Guards and the Knight in a line meet whoever reaches them, the
// Veterans and Scouts on its flanks shoot their Heavy Crossbows and Longbows at the nearest.
// Whoever drops to 0 Hit Points is dead and stays where it fell (the page plays the fall and the body).
// The page plays each cast as its own look (everglade-warlock.coax WL_*) and each shot as an arrow or
// bolt, and draws everyone on the town's own rig.
//   coax/bin/coax test --library apps/openagents-web/everglade5e-rules.coax --only "raid"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

E5R_RAIDERS :: 51;          // Darian Odiodei and fifty of his cult (npcs.coax: the Siege's armies)
E5R_DEFENDERS :: 12;        // the watch at the gate (rs_siege_defender)
E5R_RAID_PEOPLE :: E5R_RAIDERS + E5R_DEFENDERS;
E5R_RAID_CASTS :: 96;
E5R_RAID_CALL :: 7.0;       // s from the raid's start: the first call, the squads at their places
E5R_RAID_MARCH :: 22.0;     // m: the cult starts this much farther out than its siege places
E5R_RAID_RUN :: 9.0;        // m/s at 40 feet (everglade5e-beasts.coax E5RR_RUN): 30 feet is 6.75
E5R_RAID_DASH :: 1.3;       // the Dash's extra, compressed as the battle's beat is
E5R_RAID_REACH :: 1.6;      // m: a melee attack's 5 feet, middle to middle
E5R_RAID_MEET :: 9.0;       // m: a raider this near one of the watch goes for them; the watch steps out this far
E5R_RAID_ON_ONE :: 3;       // the most of the cult on any one of the watch; the rest go on
E5R_RAID_PLACE :: 3.0;      // m from its siege place: near enough to cast on the call
E5R_RAID_BOLT_FT :: 120;    // Eldritch Blast's and Fire Bolt's 120 feet
E5R_RAID_FIREBALL_FT :: 150;
E5R_RAID_IN_MIN :: 5.0; E5R_RAID_IN_MAX :: 17.0;   // m: the cult's places in the town about where it runs to
// what the page plays (everglade-raid-preview.coax RP_*): a spell's look (everglade-raid-spells.coax
// RT_K_*), an arrow or a bolt, plus E5R_RAID_AT_ONE when it is aimed at a creature
E5R_RAID_K_BLAST :: RT_K_BLAST; E5R_RAID_K_FIREBALL :: RT_K_FIREBALL; E5R_RAID_K_ARROW :: 20; E5R_RAID_K_BOLT :: 21;
E5R_RAID_AT_ONE :: 32;
E5R_RAID_BLIGHT_FT :: 30;   // Blight's range
E5R_RAIDER_FLOATS :: 10;    // x, z, yaw, speed, level, hp, max, cast's look, dead (1), s since death

E5rRaider :: struct {
  i: int;                     // its creature in the battle
  npc: int;                   // RS_NPC_*: Cultist, Fanatic, Warlock, the leader, or one of the watch
  town: bool;                 // one of the watch
  role: int;                  // RT_MELEE, RT_CASTER, RT_LEAD (rt_role)
  squad: int; k: int;         // its squad and its place in it
  x: f32; z: f32; yaw: f32; speed: f32;
  post_x: f32; post_z: f32;   // the watch's place in its line; the cult's place in the town (rt_ring)
  act_at: f32;                // its next turn (the battle's beat)
  cast_t: f32;                // when it last cast or struck (its arm's look)
  died_t: f32;                // when it fell (-1 alive)
}
E5rRaidCast :: struct { k: int; fx: f32; fz: f32; ax: f32; az: f32; seed: int; beams: int; }
E5R_RAID_SQUADS :: 7;       // fifty in squads of eight
E5rRaid :: struct {
  on: bool; started: bool;
  t: f32;                     // s since the raid began
  lead_x: f32; lead_z: f32;   // where the leader came from
  gate: RtGate;               // the way in, its wall and towers
  in_x: f32; in_z: f32;       // about where the cult's places in the town are
  you_x: f32; you_z: f32;     // the page's player
  call: int;                  // the calls so far
  arch_calls: int;            // the calls Darian has cast on
  seq: int;                   // the engine's log read so far (the Warlocks' Hellish Rebukes)
  sq_v: [E5R_RAID_SQUADS] int;   // each squad's volleys at the wall
  n: int;
  who: [E5R_RAID_PEOPLE] E5rRaider;
  casts: [E5R_RAID_CASTS] E5rRaidCast; cast_n: int; cast_read: int;
  // what of the palisade's breach sections the page's town has broken (rt_wall_broke): the cult goes
  // through only there (#12747)
  holes: [RT_TOWN_GATES * RT_BREACHES] int;
  // what the stables took from the cult's casts, their pieces down in the page's town (e5r_raid_broke),
  // the most it has come to (rt_house_stage: they never stand again in a raid), and whether their fall's
  // Fireballs have gone
  house_cast: int; house_pieces: int; house: int; house_down: bool;
  house_seen: int = 1;           // the stages they have been through (bit rt_house_stage), a check's
  go_t: [E5R_RAID_SQUADS] f32;   // when each squad's siege was done (-1 not yet): its charge from then
}

E5R_DEFEND_ROLES :: [12] int.[RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_KNIGHT, RS_NPC_GUARD, RS_NPC_GUARD, RS_NPC_GUARD,
                              RS_NPC_VETERAN, RS_NPC_SCOUT, RS_NPC_SCOUT, RS_NPC_VETERAN, RS_NPC_SCOUT, RS_NPC_GUARD];
// The k-th of the watch at the gate: the first of the shared army's town watch of its role.
e5r_raid_defender :: (k: int) -> RsCreature {
  want := E5R_DEFEND_ROLES[k % 12];
  seen := 0;
  for j: 0..<200 {
    if rs_town_role(j) != want { continue; }
    if seen == k / 12 + (ifx k >= 6 && want == RS_NPC_GUARD then 1 else 0) { return rs_siege_defender(j, 1); }
    seen += 1;
  }
  return rs_siege_defender(k, 1);
}

// The raid outside the gate at (gate_x, gate_z): the leader from (lead_x, lead_z), the cult marching to
// its siege line, and (in_x, in_z) about where its places in the town are. Each raider and each of
// the watch joins the battle.
e5r_raid_start :: (r: [] E5r, lead_x: f32, lead_z: f32, gate_x: f32, gate_z: f32, in_x: f32, in_z: f32) #export_c {
  if !r[0].started || r[0].raid[0].started { return; }
  b := r[0].b[..];
  w := r[0].raid[..];
  g := rt_gate(gate_x, gate_z, 6, false, gate_x - 64, gate_x + 64, in_x, in_z);
  w[0] = E5rRaid.{on = true, started = true, lead_x = lead_x, lead_z = lead_z, gate = g, in_x = in_x, in_z = in_z,
                  you_x = in_x, you_z = in_z + 9};
  for sq: 0..<E5R_RAID_SQUADS { w[0].go_t[sq] = -1; }
  ox := g.ox; oz := g.oz;
  numbers: [12] int;
  p: [2] f32;
  for q: 0..<E5R_RAID_PEOPLE {
    town := q >= E5R_RAIDERS;
    c: [1] RsCreature;
    x := lead_x; z := lead_z; face := e5rr_heading(-ox, -oz);
    role := RT_LEAD; squad := 0; k := 0;
    px: f32 = 0; pz: f32 = 0;
    if q == 0 { c[0] = rs_siege_arch(RS_ARCH_NAME, 2, SP_ELDRITCH_BLAST); }
    else if !town {
      c[0] = rs_siege_attacker(q - 1, 2, SP_ELDRITCH_BLAST);
      kind := c[0].npc;
      role = rt_role(kind, numbers[kind % 12]);
      numbers[kind % 12] += 1;
      if kind == RS_NPC_CULTIST { c[0].spell_ability = RS_WIS; }
      squad = (q - 1) / RT_SQUAD; k = (q - 1) % RT_SQUAD;
      // it marches from E5R_RAID_MARCH farther out than its place in the siege line
      rt_siege_pos(g, squad, k, role, p[..]);
      rt_free(g, p[0] + ox * f32(E5R_RAID_MARCH), p[1] + oz * f32(E5R_RAID_MARCH), p[..]);   // on open ground
      x = p[0]; z = p[1];
      rt_ring(q - 1, in_x, in_z, f32(E5R_RAID_IN_MIN), f32(E5R_RAID_IN_MAX), p[..]);
      px = p[0]; pz = p[1];
    } else {
      // the watch: the line inside the gate (Guards and the Knight), the shooters on its flanks
      kk := q - E5R_RAIDERS;
      c[0] = e5r_raid_defender(kk);
      shooter := c[0].npc == RS_NPC_VETERAN || c[0].npc == RS_NPC_SCOUT;
      if shooter { sd := ifx kk % 2 == 0 then 1.0f32 else -1.0f32; rt_at(g, sd * (8.5 + f32(kk % 3) * 2.2), -2.5, p[..]); }
      else { rt_at(g, (f32(kk % 6) - 2.5) * 1.3, -1.5 - f32(kk / 6) * 1.2, p[..]); }
      x = p[0]; z = p[1]; px = x; pz = z;
      face = e5rr_heading(ox, oz);
      role = RT_MELEE;
    }
    i := rs_add(b, c[0], e5r_sq(x), e5r_sq(z));
    b[0].c[i].turn_at = b[0].clock;
    w[0].who[q] = E5rRaider.{i = i, npc = b[0].c[i].npc, town = town, role = role, squad = squad, k = k, x = x, z = z, yaw = face,
                             post_x = px, post_z = pz, act_at = b[0].clock + 0.13 * f32(q % 11), died_t = -1};
  }
  w[0].n = E5R_RAID_PEOPLE;
}

e5r_raid_started :: (r: [] E5r) -> bool #export_c { return r[0].raid[0].started; }
// The page's town: the palisade whole again (then each post down, e5r_raid_broke).
e5r_raid_whole :: (r: [] E5r) #export_c { for n: 0..<RT_TOWN_GATES * RT_BREACHES { r[0].raid[0].holes[n] = 0; } r[0].raid[0].house_pieces = 0; }
// A palisade post or a piece of the stables down in the page's town at (x, z) (everglade-raid-preview.coax
// everglade_raid_wall).
e5r_raid_broke :: (r: [] E5r, x: f32, z: f32) #export_c {
  rt_wall_broke(r[0].raid[0].holes[..], x, z);
  if rt_house_has(x, z) { r[0].raid[0].house_pieces += 1; e5r_raid_house(r[0].raid[..], 0); }
}
// The stables take n from a cast: what they have taken now, the most it has come to.
e5r_raid_house :: (w: [] E5rRaid, n: int) {
  w[0].house_cast += n;
  w[0].house = rt_house_add(w[0].house, rs_max(w[0].house_cast + w[0].house_pieces * RT_HOUSE_PIECE - w[0].house, 0));
  w[0].house_seen = w[0].house_seen | (1 << rt_house_stage(w[0].house));
}
// The stables' stage now (rt_house_stage).
e5r_raid_house_stage :: (r: [] E5r) -> int #export_c { return rt_house_stage(r[0].raid[0].house); }
e5r_raid_t :: (r: [] E5r) -> f32 #export_c { return r[0].raid[0].t; }
// Where the page's player stands: the cult stops short of it (a preview's player is no one's quarry).
e5r_raid_you :: (r: [] E5r, x: f32, z: f32) #export_c { r[0].raid[0].you_x = x; r[0].raid[0].you_z = z; }

// Person q of the raid (raiders, then the watch): its kind (RS_NPC_*, 0 none), then into out x, z
// (metres), yaw, speed (m/s), level, Hit Points and their most, the share of its cast's or blow's
// look left (1 just now), 1 when dead, and the seconds since it fell.
e5r_raider :: (r: [] E5r, q: int, out: [] f32) -> int #export_c {
  w := r[0].raid[0];
  if !w.started || q < 0 || q >= w.n || out.count < E5R_RAIDER_FLOATS { return 0; }
  a := w.who[q];
  c := r[0].b[0].c[a.i];
  out[0] = a.x; out[1] = a.z; out[2] = a.yaw; out[3] = a.speed;
  out[4] = f32(c.level); out[5] = f32(c.hp); out[6] = f32(c.hp_max);
  left := 1 - (w.t - a.cast_t) / 0.8;
  out[7] = ifx a.cast_t <= 0 || left < 0 then 0.0f32 else ifx left > 1 then 1.0f32 else left;
  out[8] = ifx a.died_t >= 0 then 1.0f32 else 0.0f32;
  out[9] = ifx a.died_t >= 0 then w.t - a.died_t else 0.0f32;
  return a.npc;
}
// The next cast or shot to play, into out: what (E5R_RAID_K_*), from x, z, at x, z, its seed and its
// beams (a shot's: 1 a hit); false when none is left.
e5r_raid_cast :: (r: [] E5r, out: [] f32) -> bool #export_c {
  w := r[0].raid[..];
  if !w[0].started || w[0].cast_read >= w[0].cast_n || out.count < 7 { return false; }
  c := w[0].casts[w[0].cast_read % E5R_RAID_CASTS];
  w[0].cast_read += 1;
  out[0] = f32(c.k); out[1] = c.fx; out[2] = c.fz; out[3] = c.ax; out[4] = c.az; out[5] = f32(c.seed); out[6] = f32(c.beams);
  return true;
}
e5r_raid_put :: (w: [] E5rRaid, c: E5rRaidCast) {
  if w[0].cast_n - w[0].cast_read >= E5R_RAID_CASTS { w[0].cast_read += 1; }
  w[0].casts[w[0].cast_n % E5R_RAID_CASTS] = c;
  w[0].cast_n += 1;
}

// Eldritch Blast's beams at a Warlock's level (SRD 5.2.1: two at 5, three at 11, four at 17).
e5r_raid_beams :: (level: int) -> int {
  if level >= 17 { return 4; }
  if level >= 11 { return 3; }
  if level >= 5 { return 2; }
  return 1;
}
// The highest level with a slot left (0 none), to 5th: a Pact slot.
e5r_raid_slot :: (c: RsCreature) -> int {
  for d: 0..<9 { l := 9 - d; if c.slots[l] > 0 && l <= 5 { return l; } }
  return 0;
}
lo_r :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }
e5r_raid_gap :: (a: E5rRaider, x: f32, z: f32) -> f32 { dx := a.x - x; dz := a.z - z; return sqrt(dx * dx + dz * dz); }
// The nearest of the other side to person q, alive (-1 none), within `reach` m. At most
// E5R_RAID_ON_ONE of the cult go for any one of the watch (`taken` counts them this beat).
e5r_raid_foe :: (w: [] E5rRaid, b: [] RsBattle, q: int, reach: f32, taken: [] int) -> int {
  best := -1; gap := reach;
  a := w[0].who[q];
  if taken.count < w[0].n { return -1; }
  for o: 0..<w[0].n {
    e := w[0].who[o];
    if e.town == a.town || b[0].c[e.i].dead || (!a.town && taken[o] >= E5R_RAID_ON_ONE) { continue; }
    d := e5r_raid_gap(e, a.x, a.z);
    if d < gap { gap = d; best = o; }
  }
  return best;
}
// Whether the siege of squad s is done: its volleys at the wall, or RT_SIEGE_S since it came.
e5r_raid_done :: (w: [] E5rRaid, s: int) -> bool {
  return w[0].sq_v[s % E5R_RAID_SQUADS] >= RT_SIEGE_VOLLEYS || w[0].t >= f32(E5R_RAID_CALL) + f32(RT_SIEGE_S);
}
// Raider q casts at the battle's creature of person o on call `call`, in a turn of its own: Hex first
// (its Bonus Action), then what everglade-raid-spells.coax picks (the engine's attack roll or save
// and damage), each played at them.
e5r_raid_bolt :: (w: [] E5rRaid, b: [] RsBattle, q: int, o: int, call: int) {
  a := w[0].who[q..<q + 1]; e := w[0].who[o];
  i := a[0].i;
  b[0].who = i; rs_start_turn(b, i);
  feet := rs_feet_to(b, i, e.i);
  hexed := rt_hex(b[0].c[i], feet) && rs_cast(b, i, SP_HEX, rt_pact(b[0].c[i]), 0, 0, e.i);
  sp := rt_spell(b[0].c[i], a[0].k, call, feet);
  ok := false;
  if sp >= 0 && rs_spell(sp).area == RS_A_NONE { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), 0, 0, e.i); }
  else if sp >= 0 { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), b[0].c[e.i].x, b[0].c[e.i].y, -1); }
  level := b[0].c[i].level;
  rs_end_turn(b, i); b[0].who = -1;
  if hexed { e5r_raid_look(w, b, q, RT_K_HEX, e.x, e.z, true, 1); }
  if !ok { return; }
  a[0].cast_t = w[0].t;
  a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
  e5r_raid_look(w, b, q, rt_look(sp), e.x, e.z, true, ifx sp == SP_ELDRITCH_BLAST then e5r_raid_beams(level) else 1);
}
// Person q's look k at (ax, az) for the page (`one`: aimed at a creature).
e5r_raid_look :: (w: [] E5rRaid, b: [] RsBattle, q: int, k: int, ax: f32, az: f32, one: bool, beams: int) {
  if k < 0 { return; }
  a := w[0].who[q];
  e5r_raid_put(w, E5rRaidCast.{k = k + (ifx one then E5R_RAID_AT_ONE else 0), fx = a.x, fz = a.z, ax = ax, az = az,
                               seed = rs_roll(b[0].dice[..], 1000000) * 2 + 1, beams = beams});
}
// The person of the raid who is creature i (-1 none).
e5r_raid_of :: (w: [] E5rRaid, i: int) -> int {
  for q: 0..<w[0].n { if w[0].who[q].i == i { return q; } }
  return -1;
}
// The Hellish Rebukes the Warlocks cast since the last step (the engine's, as their Reaction): each
// played on whom it burned.
e5r_raid_rebukes :: (w: [] E5rRaid, b: [] RsBattle) {
  by: [8] int; to: [8] int;
  n := rt_rebukes(b, w[0].seq, by[..], to[..]);
  w[0].seq = b[0].book[0].seq;
  for k: 0..<n {
    q := e5r_raid_of(w, by[k]); o := e5r_raid_of(w, to[k]);
    if q < 0 || o < 0 { continue; }
    e5r_raid_look(w, b, q, RT_K_REBUKE, w[0].who[o].x, w[0].who[o].z, true, 1);
  }
}
// Darian on a call, in a turn of his own, from his Pact slots (one kept for Dimension Door): in the
// siege, Fireball at one gate tower and Lightning Bolt at the other's top, over his lines' heads; then
// at the watch, Blight on one within 30 feet, Lightning Bolt down a Line of two or more with none of
// his own, Fireball; Eldritch Blast when no slot is left to spend.
e5r_raid_arch :: (w: [] E5rRaid, b: [] RsBattle, q: int, foe: int, siege: bool) {
  a := w[0].who[q..<q + 1];
  i := a[0].i;
  g := w[0].gate;
  n := w[0].arch_calls; w[0].arch_calls += 1;
  spend := b[0].c[i].slots[5] > 1;
  beams := e5r_raid_beams(b[0].c[i].level);
  a[0].cast_t = w[0].t;
  p: [2] f32;
  b[0].who = i; rs_start_turn(b, i);
  if siege && rt_house_near(g) && n % 2 == 1 {
    // the stables (#12769): a Fireball while a slot is spare, else Eldritch Blast's beams
    rt_house_mid(p[..]);
    a[0].yaw = e5rr_heading(p[0] - a[0].x, p[1] - a[0].z);
    if spend && n % 4 == 1 {
      b[0].c[i].slots[5] -= 1;
      e5r_raid_look(w, b, q, RT_K_FIREBALL, p[0], p[1], false, 0);
      e5r_raid_house(w, 12 + rs_roll(b[0].dice[..], 8));
    } else {
      e5r_raid_look(w, b, q, RT_K_BLAST, p[0], p[1], false, beams);
      e5r_raid_house(w, rs_roll(b[0].dice[..], RT_HOUSE_BOLT));
    }
    rs_end_turn(b, i); b[0].who = -1;
    return;
  }
  if siege {
    rt_at(g, (ifx n % 2 == 0 then -1.0f32 else 1.0f32) * g.w * f32(RT_TOWER_AT), 0, p[..]);
    a[0].yaw = e5rr_heading(p[0] - a[0].x, p[1] - a[0].z);
    if spend && n % 4 == 0 && rs_cast(b, i, SP_FIREBALL, 5, e5r_sq(p[0]), e5r_sq(p[1]), -1) {
      // Fireball on the tower: the engine's at its square, on whoever stands there
      e5r_raid_look(w, b, q, RT_K_FIREBALL, p[0], p[1], false, 0);
    } else if spend && n % 4 == 2 {
      // Lightning Bolt at the tower's top: no creature stands in its Line up there
      b[0].c[i].slots[5] -= 1;
      e5r_raid_look(w, b, q, RT_K_LIGHTNING, p[0], p[1], false, 0);
    } else {
      e5r_raid_look(w, b, q, RT_K_BLAST, p[0], p[1], false, beams);
    }
    rs_end_turn(b, i); b[0].who = -1;
    return;
  }
  if foe >= 0 {
    e := w[0].who[foe];
    a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
    feet := rs_feet_to(b, i, e.i);
    ln: [2] int;
    rt_line(b, i, b[0].c[e.i].x, b[0].c[e.i].y, ln[..]);
    if spend && feet <= E5R_RAID_BLIGHT_FT && rs_cast(b, i, SP_BLIGHT, 5, 0, 0, e.i) { e5r_raid_look(w, b, q, RT_K_BLIGHT, e.x, e.z, true, 1); }
    else if spend && feet <= 100 && ln[0] >= 2 && ln[1] == 0 && rs_cast(b, i, SP_LIGHTNING_BOLT, 5, b[0].c[e.i].x, b[0].c[e.i].y, -1) {
      rt_line_end(a[0].x, a[0].z, e.x, e.z, f32(RT_LINE_M), p[..]);
      e5r_raid_look(w, b, q, RT_K_LIGHTNING, p[0], p[1], true, 1);
    }
    else if spend && rs_cast(b, i, SP_FIREBALL, 5, b[0].c[e.i].x, b[0].c[e.i].y, -1) { e5r_raid_look(w, b, q, RT_K_FIREBALL, e.x, e.z, true, 0); }
    else if rs_cast(b, i, SP_ELDRITCH_BLAST, 0, 0, 0, e.i) { e5r_raid_look(w, b, q, RT_K_BLAST, e.x, e.z, true, beams); }
  }
  rs_end_turn(b, i); b[0].who = -1;
}

// Person q strikes person o with weapon `wp` (the engine's attack, its roll and damage); a shot goes
// to the page to fly.
e5r_raid_strike :: (w: [] E5rRaid, b: [] RsBattle, q: int, o: int, wp: int, shot: int) {
  a := w[0].who[q..<q + 1]; e := w[0].who[o];
  hp := b[0].c[e.i].hp;
  b[0].who = a[0].i;
  _ := rs_strike(b, a[0].i, e.i, wp, false);
  b[0].who = -1;
  a[0].cast_t = w[0].t;
  a[0].yaw = e5rr_heading(e.x - a[0].x, e.z - a[0].z);
  if shot >= 0 {
    e5r_raid_put(w, E5rRaidCast.{k = shot, fx = a[0].x, fz = a[0].z, ax = e.x, az = e.z, seed = rs_roll(b[0].dice[..], 100000), beams = ifx b[0].c[e.i].hp < hp then 1 else 0});
  }
}

// Each dt seconds of the raid (from e5r_step): on each call the casters fire together; everyone goes
// where the shared tactics send it, round the ground about you, apart; whoever's turn has come strikes.
e5r_raid_step :: (r: [] E5r, dt: f32) {
  w := r[0].raid[..];
  if !w[0].started { return; }
  b := r[0].b[..];
  w[0].t += dt;
  t := w[0].t;
  w[0].gate = rt_with_house(w[0].house, rt_with_holes(w[0].holes[..], w[0].gate));   // its wall and the stables as the page's town has them now
  g := w[0].gate;
  // the stables fall: Darian's last Fireballs across them bring the rest down (#12769)
  if g.fallen && !w[0].house_down && w[0].n > 0 {
    w[0].house_down = true;
    hp: [2] f32;
    for k: 0..<RT_HOUSE_BLASTS { rt_house_blast(k, hp[..]); e5r_raid_look(w, b, 0, RT_K_FIREBALL, hp[0], hp[1], false, 0); }
  }
  for sq: 0..<E5R_RAID_SQUADS { if w[0].go_t[sq] < 0 && e5r_raid_done(w, sq) { w[0].go_t[sq] = t; } }
  period := f32(RT_VOLLEY_BEATS) * rs_beat(b);
  call := ifx t < f32(E5R_RAID_CALL) then -1 else int((t - f32(E5R_RAID_CALL)) / period);
  calling := call >= 0 && call >= w[0].call;   // a new call this step
  if calling { w[0].call = call + 1; }
  fired: [E5R_RAID_SQUADS] bool;
  taken: [E5R_RAID_PEOPLE] int;
  xs: [E5R_RAID_PEOPLE] f32; zs: [E5R_RAID_PEOPLE] f32; up: [E5R_RAID_PEOPLE] bool;
  lx: f32 = 0; lz: f32 = 0; ln := 0;
  for q: 0..<w[0].n {
    a := w[0].who[q];
    xs[q] = a.x; zs[q] = a.z; up[q] = !b[0].c[a.i].dead && !a.town && q > 0;
    if up[q] { lx += a.x; lz += a.z; ln += 1; }
  }
  if ln > 0 { lx /= f32(ln); lz /= f32(ln); }
  p: [5] f32;
  for q: 0..<w[0].n {
    a := w[0].who[q..<q + 1];
    i := a[0].i;
    a[0].speed = 0;
    if b[0].c[i].dead {
      if a[0].died_t < 0 { a[0].died_t = t; }
      continue;
    }
    npc := a[0].npc;
    shooter := a[0].town && (npc == RS_NPC_VETERAN || npc == RS_NPC_SCOUT);
    s := a[0].squad % E5R_RAID_SQUADS;
    done := e5r_raid_done(w, s);
    tx := a[0].x; tz := a[0].z; run := false; foe := -1; stop: f32 = 0.3;
    aim := RT_AIM_FOES; ax: f32 = 0; az: f32 = 0;
    if a[0].town {
      // the watch: back to its place, or out to meet one come near it
      tx = a[0].post_x; tz = a[0].post_z;
      foe = e5r_raid_foe(w, b, q, ifx shooter then 30.0f32 else f32(E5R_RAID_MEET), taken[..]);
      if foe >= 0 && !shooter && e5r_raid_gap(w[0].who[foe], a[0].post_x, a[0].post_z) < f32(E5R_RAID_MEET) {
        tx = w[0].who[foe].x; tz = w[0].who[foe].z; stop = f32(E5R_RAID_REACH) * 0.8; run = true;
      }
    } else if a[0].role == RT_LEAD {
      // Darian: behind his lines, commanding; Dimension Door back from one come near
      rt_command(lx, lz, ln, w[0].lead_x, w[0].lead_z, p[..]); tx = p[0]; tz = p[1];
      foe = e5r_raid_foe(w, b, q, f32(RT_THREAT), taken[..]);
      if foe >= 0 && b[0].c[i].slots[5] > 0 {
        rt_door(a[0].x, a[0].z, w[0].who[foe].x, w[0].who[foe].z, w[0].lead_x, w[0].lead_z, p[..]);
        rt_free(g, p[0], p[1], p[..]);   // onto open ground, not into a wall or a building
        b[0].c[i].slots[5] -= 1;
        a[0].x = p[0]; a[0].z = p[1]; tx = p[0]; tz = p[1];
      }
    } else {
      // its charge its own moment after its squad's call (rt_start)
      going := done && t >= w[0].go_t[s] + rt_start(q + 1);   // q + 1: the page's id for it (everglade-raid-preview.coax rp_id)
      rt_order(g, a[0].squad, a[0].k, a[0].role, w[0].sq_v[s], going, a[0].x, a[0].z, a[0].post_x, a[0].post_z, p[..]);
      tx = p[0]; tz = p[1]; aim = int(p[2]); ax = p[3]; az = p[4];
      run = going;
      if a[0].role == RT_MELEE {
        foe = e5r_raid_foe(w, b, q, f32(E5R_RAID_MEET), taken[..]);
        if foe >= 0 && (done || e5r_raid_gap(w[0].who[foe], a[0].x, a[0].z) < f32(E5R_RAID_MEET) * 0.6) { taken[foe] += 1; tx = w[0].who[foe].x; tz = w[0].who[foe].z; stop = f32(E5R_RAID_REACH) * 0.8; run = true; }
        else { foe = -1; }
      } else {
        // a caster: the foe at hand first; it keeps RT_KEEP from it
        foe = e5r_raid_foe(w, b, q, ifx done then f32(E5R_RAID_BOLT_FT) * 0.3048 else f32(RT_SELF), taken[..]);
        if foe >= 0 && e5r_raid_gap(w[0].who[foe], a[0].x, a[0].z) < f32(RT_KEEP) && !done { tx = a[0].x; tz = a[0].z; }
      }
      // round the ground kept clear about you
      rt_around(g, a[0].x, a[0].z, tx, tz, w[0].you_x, w[0].you_z, f32(RT_SPAWN_R), p[..]); tx = p[0]; tz = p[1];
    }
    dx := tx - a[0].x; dz := tz - a[0].z;
    d := sqrt(dx * dx + dz * dz);
    // the cult and the watch go round the town's trees, walls and buildings, through the palisade
    // by a gate or a breach (rt_way; the cult round the ground about you too): each stops `stop`
    // short of its goal, not of a corner on the way, and slides along what it meets
    rt_way(g, a[0].x, a[0].z, tx, tz, w[0].you_x, w[0].you_z, ifx a[0].town then 0.0f32 else f32(RT_SPAWN_R), p[..]);
    wx := p[0] - a[0].x; wz := p[1] - a[0].z; wd := sqrt(wx * wx + wz * wz); direct := p[2] > 0.5;
    left := ifx direct then wd - stop else wd;
    if d > stop && left > 0 && wd > 0.0001 {
      speed := f32(E5R_RAID_RUN) * f32(b[0].c[i].speed) / 40.0 * (ifx run then f32(E5R_RAID_DASH) else 0.55f32) * rt_pace(q + 1);   // its own pace
      st := lo_r(speed * dt, left);
      mx := wx / wd * st; mz := wz / wd * st;
      if !a[0].town {
        rt_separate(a[0].x, a[0].z, q, xs[..], zs[..], up[..], w[0].n, p[..]);
        mx += p[0] * speed * dt * 0.6; mz += p[1] * speed * dt * 0.6;
        ml := sqrt(mx * mx + mz * mz);
        lim := speed * dt;
        if ml > lim && ml > 0 { mx = mx / ml * lim; mz = mz / ml * lim; }
      }
      rt_slide(g, a[0].x, a[0].z, mx, mz, p[..]);
      mx = p[0] - a[0].x; mz = p[1] - a[0].z;
      a[0].x += mx; a[0].z += mz;
      a[0].speed = sqrt(mx * mx + mz * mz) / hi_r(dt, 0.0001);
      a[0].yaw = e5rr_heading(wx, wz);
    } else {
      if !a[0].town && q > 0 {
        rt_separate(a[0].x, a[0].z, q, xs[..], zs[..], up[..], w[0].n, p[..]);
        rt_slide(g, a[0].x, a[0].z, p[0] * dt * 1.2, p[1] * dt * 1.2, p[..]);
        a[0].x = p[0]; a[0].z = p[1];
      }
      if foe >= 0 { a[0].yaw = e5rr_heading(w[0].who[foe].x - a[0].x, w[0].who[foe].z - a[0].z); }
      else if a[0].town { a[0].yaw = e5rr_heading(g.ox, g.oz); }
      else { a[0].yaw = e5rr_heading(-g.ox, -g.oz); }
    }
    b[0].c[i].x = e5r_sq(a[0].x); b[0].c[i].y = e5r_sq(a[0].z);
    // the call: every caster of the cult fires on it
    if a[0].role == RT_LEAD {
      if !calling { continue; }
      // the siege while any squad is at the wall; then the watch within Fireball's 150 feet
      siege := false;
      for sq: 0..<E5R_RAID_SQUADS { if !e5r_raid_done(w, sq) { siege = true; } }
      foe = e5r_raid_foe(w, b, q, f32(E5R_RAID_FIREBALL_FT) * 0.3048, taken[..]);
      e5r_raid_arch(w, b, q, foe, siege);
      continue;
    }
    if a[0].role == RT_CASTER {
      if !calling { continue; }
      if foe >= 0 { e5r_raid_bolt(w, b, q, foe, call); continue; }
      if done || aim == RT_AIM_FOES { continue; }
      // the siege: this call's volley at its tower or its breach, once at its place
      rt_order(g, a[0].squad, a[0].k, a[0].role, w[0].sq_v[s], false, a[0].x, a[0].z, a[0].post_x, a[0].post_z, p[..]);
      if e5r_raid_gap(a[0], p[0], p[1]) > f32(E5R_RAID_PLACE) { continue; }
      fired[s] = true;
      a[0].cast_t = t;
      a[0].yaw = e5rr_heading(ax - a[0].x, az - a[0].z);
      e5r_raid_look(w, b, q, rt_siege_look(npc), ax, az, false, ifx npc == RS_NPC_WARLOCK then e5r_raid_beams(b[0].c[i].level) else 1);
      if aim == RT_AIM_HOUSE { e5r_raid_house(w, rs_roll(b[0].dice[..], RT_HOUSE_BOLT)); }   // the stables take its bolt or its beams
      continue;
    }
    if b[0].clock < a[0].act_at || foe < 0 || !rs_can_act(b[0].c[i]) { continue; }
    gap := e5r_raid_gap(w[0].who[foe], a[0].x, a[0].z);
    if shooter && b[0].c[i].ranged >= 0 {
      a[0].act_at = b[0].clock + rs_beat(b);
      if gap <= f32(E5R_RAID_REACH) { e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1); }
      else { e5r_raid_strike(w, b, q, foe, b[0].c[i].ranged, ifx npc == RS_NPC_VETERAN then E5R_RAID_K_BOLT else E5R_RAID_K_ARROW); }
    } else if npc == RS_NPC_FANATIC && gap > f32(E5R_RAID_REACH) && gap <= 18.3 && b[0].c[i].slots[2] > 0 && b[0].c[w[0].who[foe].i].humanoid {
      // a Fanatic: Hold Person (its 1/Day) on one of the watch it closes on
      a[0].act_at = b[0].clock + rs_beat(b);
      b[0].who = i; rs_start_turn(b, i);
      held := rs_cast(b, i, SP_HOLD_PERSON, 2, 0, 0, w[0].who[foe].i);
      rs_end_turn(b, i); b[0].who = -1;
      if held { a[0].cast_t = t; e5r_raid_look(w, b, q, RT_K_HOLD, w[0].who[foe].x, w[0].who[foe].z, true, 1); }
    } else if gap <= f32(E5R_RAID_REACH) {
      a[0].act_at = b[0].clock + rs_beat(b);
      e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1);
      // a Multiattack's second blow (Extra Attack)
      if b[0].c[i].extra_attack > 0 && !b[0].c[w[0].who[foe].i].dead { e5r_raid_strike(w, b, q, foe, b[0].c[i].weapon, -1); }
    }
  }
  for s: 0..<E5R_RAID_SQUADS { if fired[s] { w[0].sq_v[s] += 1; } }
  e5r_raid_rebukes(w, b);
}

#test "raid: the shared tactics' squads besiege the towers and the wall in big volleys, Darian at the back, then in apart and clear of you" #steps 2000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -38);
  e5r_raid_you(r[..], 0, -16);
  #assert r[0].raid[0].n == E5R_RAID_PEOPLE;
  out: [10] f32;
  #assert e5r_raider(r[..], 0, out[..]) == RS_NPC_ARCH && out[4] == 17;
  casters := 0; watch := 0;
  for q: 1..<E5R_RAID_PEOPLE {
    k := e5r_raider(r[..], q, out[..]);
    if r[0].raid[0].who[q].role == RT_CASTER && !r[0].raid[0].who[q].town { casters += 1; }
    if r[0].raid[0].who[q].town { watch += 1; }
  }
  #assert casters > 20 && watch == E5R_DEFENDERS;
  // the first call is a big volley: most casters at once, at the towers and the wall
  c: [7] f32;
  for f: 0..<170 { e5r_step(r[..], r[0].b[0].clock + 0.04); }
  while e5r_raid_cast(r[..], c[..]) { }
  for f: 0..<10 { e5r_step(r[..], r[0].b[0].clock + 0.04); }
  spells := 0; walls := 0;
  kinds := 0;
  while e5r_raid_cast(r[..], c[..]) {
    k := int(c[0]) % E5R_RAID_AT_ONE;
    if k < E5R_RAID_K_ARROW { spells += 1; kinds = kinds | (1 << k); }
    if (k == RT_K_BLAST || k == RT_K_FIRE_BOLT) && c[4] > -57 && c[4] < -55 && (c[3] > 10 || c[3] < -10) { walls += 1; }
  }
  #assert spells * 2 >= casters && walls > 0;
  // the volley mixes the Cultists' Fire Bolts with the Warlocks' Eldritch Blasts
  #assert (kinds & (1 << RT_K_BLAST)) != 0 && (kinds & (1 << RT_K_FIRE_BOLT)) != 0;
  // Darian holds behind his lines
  #assert e5r_raider(r[..], 0, out[..]) == RS_NPC_ARCH && out[1] < -70;
  // later: some fall, the cult is in, apart and clear of you, and Darian still at the back
  for f: 0..<700 {
    e5r_step(r[..], r[0].b[0].clock + 0.04);
    while e5r_raid_cast(r[..], c[..]) { k := int(c[0]) % E5R_RAID_AT_ONE; if k < E5R_RAID_K_ARROW { kinds = kinds | (1 << k); } }
  }
  // Darian's Fireball and Lightning Bolt, and the casters' other spells at the watch
  #assert (kinds & (1 << RT_K_FIREBALL)) != 0 && (kinds & (1 << RT_K_LIGHTNING)) != 0;
  others := 0;
  for k: [6] int.[RT_K_FROST, RT_K_CHILL, RT_K_HEX, RT_K_BURNING, RT_K_REBUKE, RT_K_HOLD] { if (kinds & (1 << k)) != 0 { others += 1; } }
  #assert others >= 2;
  dead := 0; inside := 0;
  for q: 1..<E5R_RAIDERS {
    _ := e5r_raider(r[..], q, out[..]);
    if out[8] > 0 { dead += 1; continue; }
    if out[1] > -50 {
      inside += 1;
      dx := out[0]; dz := out[1] + 16;
      #assert dx * dx + dz * dz >= (f32(RT_SPAWN_R) - 1.5) * (f32(RT_SPAWN_R) - 1.5);
    }
  }
  #assert inside > 5;
  _ := e5r_raider(r[..], 0, out[..]);
  #assert out[1] < -56;
}

#test "raid: the cult and the watch go round the stables, the houses, the park's trees, the walls and the towers, through the wall only by the gate or where it is broken (#12747)" #steps 6000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -25);
  e5r_raid_you(r[..], 0, -16);
  // the page's town has the wall broken through at 12.6 to 15.4 m east of the gate (squad 1's breach);
  // the others' breaches stand whole
  posts: [64] f32; holes: [RT_TOWN_GATES * RT_BREACHES] int;
  np := rt_test_break(holes[..], posts[..], 0, 1, 12.6, 15.4);
  e5r_raid_whole(r[..]);
  for q: 0..<np { e5r_raid_broke(r[..], posts[q * 2], posts[q * 2 + 1]); }
  clips := 0; by_gate := 0; by_breach := 0; elsewhere := 0; through := 0;
  was: [E5R_RAID_PEOPLE] f32;
  for q: 0..<E5R_RAID_PEOPLE { was[q] = r[0].raid[0].who[q].z; }
  for f: 0..<1500 {
    e5r_step(r[..], r[0].b[0].clock + 0.04);
    for q: 0..<E5R_RAID_PEOPLE {
      a := r[0].raid[0].who[q];
      if a.died_t >= 0 { was[q] = a.z; continue; }
      if rt_test_clips_in(a.x, a.z, posts[..], np, r[0].raid[0].gate.fallen) { clips += 1; }   // the stables' rubble is ground once they fall (#12769)
      // through the line of the South wall
      if (was[q] + 56) * (a.z + 56) < 0 && abs(a.x) < 64 {
        if abs(a.x) < 3 { by_gate += 1; } else if a.x > 12.6 && a.x < 15.4 { by_breach += 1; } else { elsewhere += 1; }
      }
      was[q] = a.z;
    }
  }
  #assert clips == 0 && elsewhere == 0 && by_gate > 0 && by_breach > 0;
  for q: 1..<E5R_RAIDERS { a := r[0].raid[0].who[q]; if a.died_t < 0 && rt_inside(a.x, a.z) { through += 1; } }
  #assert through > 5;
}

#test "raid: the cult burns the stables by stages till Darian's Fireballs bring them down, never stands in them before, and charges a raider at a time (#12769)" #steps 8000000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  e5r_raid_start(r[..], 0, -106, 0, -56, 0, -25);
  e5r_raid_you(r[..], 0, -16);
  posts: [2] f32;
  stage := RT_HOUSE_WHOLE; stages := 1; clips := 0; fall_balls := 0; fell_at: f32 = -1;
  moved: [E5R_RAID_PEOPLE] f32; was: [E5R_RAID_PEOPLE] f32;
  for q: 0..<E5R_RAID_PEOPLE { moved[q] = -1; }
  c: [7] f32;
  for f: 0..<1500 {
    e5r_step(r[..], r[0].b[0].clock + 0.04);
    w := r[0].raid[0];
    now := e5r_raid_house_stage(r[..]);
    #assert now >= stage;
    if now != stage { stages = stages | (1 << now); stage = now; if now == RT_HOUSE_FALLEN { fell_at = w.t; } }
    while e5r_raid_cast(r[..], c[..]) {
      // the fall's Fireballs: Darian's, at the stables, the step they fall
      if fell_at >= 0 && w.t - fell_at < 0.05 && int(c[0]) == RT_K_FIREBALL && rt_house_has(c[3], c[4]) { fall_balls += 1; }
    }
    for q: 1..<E5R_RAIDERS {
      a := w.who[q];
      if a.died_t >= 0 { continue; }
      if rt_test_clips_in(a.x, a.z, posts[..], 0, w.gate.fallen) { clips += 1; }
      // the first step each takes toward the wall once its squad's siege is done: its charge
      if e5r_raid_done(r[0].raid[..], a.squad) && moved[q] < 0 && f > 0 && a.z - was[q] > 0.02 && a.role != RT_LEAD { moved[q] = w.t; }
      was[q] = a.z;
    }
  }
  // whole, scorched, ablaze, fallen: each in turn
  #assert stage == RT_HOUSE_FALLEN && r[0].raid[0].house_seen == 15 && (stages & 9) == 9;
  #assert fell_at > f32(E5R_RAID_CALL) + 4 && fell_at < 24;   // they burn a while before they fall, in the siege
  #assert fall_balls >= RT_HOUSE_BLASTS;
  #assert clips == 0;
  // squad 0's charges: spread over most of RT_START_S, not one block
  first: f32 = 1000; last: f32 = -1;
  for q: 1..<1 + RT_SQUAD { if moved[q] >= 0 { first = lo_r(first, moved[q]); last = hi_r(last, moved[q]); } }
  #assert last > first && last - first > f32(RT_START_S) * 0.4;
}
