// The Cultist Raid in a shared room (spec docs/verse/2026-11-03-everglade-world-events.md, sections 4
// and 5; #12740, #12741): the raiders, the ward stones and Darian Odiodei as creatures of the room's
// one SRD 5e battle (everglade5e-room-rules.coax). Each is one of the room's summoned creatures (its
// E5rBeast, a form of E5RR_FORM_RAID and up, owned by no seat), so the room sends it to the pages as
// it sends a Wolf, every player can aim at it, and its hits, saves and deaths are the engine's. The
// room's world event (coax/web/room/room-events.coax) says when and where they come; this file is
// how they fight:
//   - the raiders fight a siege by the shared tactics (everglade-raid-tactics.coax): in squads, each
//     member at its own place; the casters (the Warlocks, and two Cultists in three) cast the mix of
//     SRD 5.2.1 spells everglade-raid-spells.coax picks (Fire Bolt, Ray of Frost, Chill Touch, Hex,
//     Burning Hands, Eldritch Blast, Hellish Rebuke as a Warlock's Reaction), and
//     fire their squad's volleys together on its call, first at a gate tower and a breach in the wall
//     (the room breaks and burns the town's pieces when its damage dial is on), then the squad goes
//     in by the gate or the breach to its places about the square, the casters on the defenders and
//     the players. Raiders keep apart, and clear of the players' spawn;
//   - a raider sets on whatever is nearest within reach, a player before a townsperson (12 m for one
//     in melee, 30 m for a caster, 12 m for a caster still at the wall); none sets on a player in the
//     spawn's clear ground;
//   - a Fanatic and the other Cultists run in and strike in melee; a Fanatic casts Hold Person once, at
//     a player; a caster keeps 18 m off;
//   - the ward stones (AC 15, 60 Hit Points) stand still; while one stands, nothing hurts Darian
//     Odiodei (RsCreature.floor at his whole Hit Points); with all broken his floor is half his Hit
//     Points, and the room withdraws him when he reaches it, so he never drops;
//   - one caster in each squad at the South Gate burns the stables outside it (RT_AIM_HOUSE), and Darian
//     with no foe in reach casts at them too; what they take, and their pieces broken in the room's
//     town, is the raid's record (house): by it they go scorched, ablaze, then fall, and the room
//     brings the rest down with RT_HOUSE_BLASTS blasts; fallen, a raider walks over their rubble;
//     a rebuild stands them up again (#12769);
//   - each raider goes at its own pace (rt_pace) and starts its charge its own moment after its
//     squad's siege is done (rt_start), so a squad never moves as one block (#12769);
//   - Darian stays RT_BACK behind his lines, and casts Dimension Door away from a foe at hand while he
//     has a Pact slot; he fights by the aggression dial: 0 watches, 1 Eldritch Blast
//     and Blight, 2 also Fireball at three or more together and Lightning Bolt down a Line of two or
//     more foes with none of his own in it, 3 also Circle of Death and Finger of Death, and twice a turn.
//   - the standing siege (#12860): in it the raid is two forces. The cult (raiders from the
//     camp on the south road) and the watch (Guards, Warrior Veterans, Knights and Scouts of the town's
//     team, raid creatures of forms E5RR_FORM_RAID + 1 to 4: e5rd_defender) each hold their posts
//     about the front (everglade-raid-front.coax rf_post, at E5rdRaid.front_z), set on the other
//     side's nearest within reach and strike, shoot or cast at it, never far from the line; the cult
//     sets on players but not on the town's people inside the walls. The camp's ward stones can't be
//     broken, nor Darian hurt, until the line reaches the camp (E5rdRaid.stand);
//   - a hero on the watch's side (#12996): Echo (e5rd_hero, form E5RR_FORM_HERO), Everglade's own
//     caster (fivebar.coax fb_everglade_hero), joins when the room's hero dial asks for her
//     (room-events.coax). She takes her post with the watch's ranged and casts Everglade's own four at
//     the cult, a cast every E5RD_HERO_EVERY s, where the tactics aim them (rt_hero_aim: Meteor Swarm
//     first): the pages hear her cast as it starts (its cast bar, CR_BAR), the town takes its strike as
//     the bar ends and the rules roll it when it lands (its bar slot's delay, fivebar.coax), as a
//     player's. The other players and the watch stand out of her roll, as a player's harm keeps them
//     out (e5rr_use). She holds while she casts. She can be hurt but never drops (floor 1 Hit Point).
// What the pages play (a raider's cast) and who fell (for the XP) wait in queues the room drains.
// The raiders take the summoned creatures' places from the top, so a raid always leaves the players'
// summons E5RR_BEASTS - E5RD_MAX places.
//   coax test --library apps/openagents-web/everglade5e-room-rules.coax --only "room raid"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "everglade-cast-rules.coax";   // Everglade's four's cast bars, for a hero's (CR_BAR)
// a raider's form is E5RR_FORM_RAID (everglade5e-beasts.coax) + its stat block (npcs.coax RS_NPC_*)
E5RR_FORM_WARD :: 40;                        // a ward stone
E5RD_HERO_NPC :: 15;                         // a hero's place past the stat blocks (npcs.coax RS_NPCS)
E5RR_FORM_HERO :: E5RR_FORM_RAID + E5RD_HERO_NPC;   // a hero of the watch: Echo (#12996)
E5RD_HERO_REACH :: 36.0;                     // m: how far Echo looks for the cult to cast at
E5RD_HERO_EVERY :: 6.0;                      // s from the start of one of her casts to the next (a round)
E5RD_TEAM :: 3;                              // the cult's team: not the players' (0), the town's (1) or a summons' (2)
E5RD_MAX :: 64;                              // raid creatures at once, the leader and the stones with them
// Main/bonus/support cues for every creature, plus the separately capped
// reaction cues. Critical object impacts fit inside each source's reservation.
E5RD_CASTS :: E5RR_BEASTS * 4 + E5RD_REBUKES;
E5RD_DOWNS :: E5RR_BEASTS;                   // one critical outcome reserved per physical creature slot
E5RD_REACH_MELEE :: 12.0; E5RD_REACH_CAST :: 30.0; E5RD_REACH_ARCH :: 40.0;   // m: how far a raider looks for a foe
E5RD_KEEP :: 20.0;                           // m a Warlock keeps from its foe (15 to 25)
E5RD_SEAT_FIRST :: 6.0;                      // m: a player this much farther than a townsperson still comes first
E5RD_HOME :: 2.0;                            // m: a raider that fled this near where it came from is gone
// the stages of its march
E5RD_IN :: 0; E5RD_FLEE :: 2;
// the players' spawn (verse/everglade/plan.coax EG_SPAWN_X, EG_SPAWN_Z): kept clear (RT_SPAWN_R)
E5RD_SPAWN_X :: 0.0; E5RD_SPAWN_Z :: -84.0;
// what a page plays for a cast (everglade-warlock.coax WL_*, everglade-raid-spells.coax RT_K_*)
E5RD_K_BLAST :: RT_K_BLAST; E5RD_K_FIREBALL :: RT_K_FIREBALL; E5RD_K_BLIGHT :: RT_K_BLIGHT; E5RD_K_CIRCLE :: RT_K_CIRCLE;
E5RD_K_FINGER :: RT_K_FINGER; E5RD_K_DOOR :: RT_K_DOOR;
E5RD_REBUKES :: 8;                           // Hellish Rebukes the raid plays from one step's log, at most
// Ward stone: a dark obelisk the cult raises at a gate. AC 15, 60 Hit Points; an object: no saves to
// fail or conditions to suffer, no poison or psychic harm.
E5RD_WARD_AC :: 15; E5RD_WARD_HP :: 60;

E5rdSlot :: struct {
  npc: int; level: int; stage: int;
  role: int;                                 // RT_SKIRM, RT_CASTER, RT_SUPPORT, RT_GUARD, RT_LEAD (everglade-raid-tactics.coax)
  squad: int; k: int;                        // its squad (the room's 8 to a gate) and its place in it
  g: RtGate;                                 // its way in
  gx: f32; gz: f32;                          // its gate (the way in)
  sx: f32; sz: f32;                          // its place in the town (the leader's: where he holds with no lines)
  hx: f32; hz: f32;                          // where it came from (the way out)
  held: bool;                                // a Fanatic's Hold Person is spent
  freed: bool;                               // a volleyer whose siege is done, on its own moment in the beat since
  bn: f32; bax: f32; baz: f32;               // its bound now, and which way off its foe it goes in it
  front: bool;                               // it fights the standing siege: by the front, not a gate's siege (#12860)
  town: bool;                                // one of the watch (e5rd_defender), not the cult
}
// A raider's cast for the pages: the creature (its beast id), the look k (RT_K_*), the creature
// it aimed at (-1 the town), where, and the seed the pages play it from.
// slot: the town's strike's bar slot (one of Everglade's four for a hero's), -1 the Warlock's look k's;
// cue: whether the pages hear it (a hero's strike at the end of her bar is the town's alone); ground:
// ay is the ground's height at the aim (a hero's, from the foe there), else it is the caster's.
E5rdCast :: struct { id: int; q: int = -1; k: int; to: int; ax: f32; az: f32; seed: int; fx: f32; fy: f32; fz: f32; harm: bool; slot: int = -1; cue: bool = true; ground: bool; ay: f32; }
// Echo's cast (#12996): bar slot k (Everglade's four) at (x, z), its seed, when its bar ends (the
// town's strike) and when it lands (the rules' roll), and when her next may start.
E5rdHero :: struct { q: int = -1; on: bool; struck: bool; k: int; x: f32; y: f32; z: f32; seed: int; release: f32; due: f32; next: f32; casts: int; rolled: int; }
// One that fell: its place among the beasts, its last id, stat block (0 a ward stone), level, where.
E5rdDown :: struct { q: int; tag: int; npc: int; level: int; x: f32; z: f32; }
E5rdRaid :: struct {
  limit: int = E5RD_MAX;                     // local authoring may borrow otherwise free summon slots
  slot: [E5RR_BEASTS] E5rdSlot;
  casts: [E5RD_CASTS] E5rdCast; cast_n: int;
  downs: [E5RD_DOWNS] E5rdDown; down_n: int;
  down_pending: [E5RR_BEASTS] bool;          // no raid reuses a slot before its result is consumed
  effect_known:bool;effect_free:[E5RR_BEASTS]int;effect_deferred:int;cue_dropped:int;
  aggr: int = 2; harm: bool = true;
  seq: int;                                  // the engine's log read so far (its Hellish Rebukes)
  arch: int = -1;                            // Darian's place among the beasts (-1 away)
  up: int;                                   // raid creatures standing, as the last step counted (the watch fights while any do)
  // the squads (squad % RT_SQUADS): which squad holds the place (+1), its calls' first, when it came,
  // its volleys at the wall so far and the call it last fired on
  sq_id: [RT_SQUADS] int; sq_anchor: [RT_SQUADS] f32; sq_at: [RT_SQUADS] f32; sq_v: [RT_SQUADS] int; sq_last: [RT_SQUADS] int;
  xs: [E5RR_BEASTS] f32; zs: [E5RR_BEASTS] f32; on: [E5RR_BEASTS] bool;   // where each raid creature stands, this step
  // what of the palisade's breach sections is broken in the room's town (rt_wall_broke): a raider
  // goes through only there (#12747)
  holes: [RT_TOWN_GATES * RT_BREACHES] int;
  // what the stables have taken (rt_house_stage), whether their fall is still to bring the rest
  // down in the room's town (e5rd_house_falls), and how high their blasts go off
  house: int; house_fall: bool; house_y: f32;
  sq_go: [RT_SQUADS] f32;                    // when each squad's siege was done (-1 not yet): its charge from then
  mix: RtMix;                                // the raid's mix of roles, a setting (everglade-raid-tactics.coax rt_role_of)
  siege: bool;                               // the standing siege: those who join fight by the front (#12860)
  front_z: f32 = RF_MID_Z;                   // where the front is (room-events.coax steps it: rf_step)
  stand: bool;                               // the front is at the camp: its ward stones and Darian can be hurt
  hero: E5rdHero;                            // Echo, while she fights for the watch (#12996)
}
// A piece of the room's town broke at (x, z) (room-everglade.coax rm_eg_piece): a palisade post in
// a breach section opens it; one of the stables' takes from them.
e5rd_wall_broke :: (r: [] E5rRoom, x: f32, z: f32) {
  rt_wall_broke(r[0].raid[0].holes[..], x, z);
  if rt_house_has(x, z) { e5rd_house_hurt(r, RT_HOUSE_PIECE); }
}
// The town is whole again (a rebuild): no breach, the stables standing.
e5rd_wall_whole :: (r: [] E5rRoom) {
  for n: 0..<RT_TOWN_GATES * RT_BREACHES { r[0].raid[0].holes[n] = 0; }
  r[0].raid[0].house = 0; r[0].raid[0].house_fall = false;
}
// The stables take `n`: as they reach their fall, it is owed to the room's town (e5rd_house_falls).
e5rd_house_hurt :: (r: [] E5rRoom, n: int) {
  w := r[0].raid[..];
  if rt_house_stage(w[0].house) == RT_HOUSE_FALLEN || n <= 0 { return; }
  w[0].house = rt_house_add(w[0].house, n);
  if rt_house_stage(w[0].house) == RT_HOUSE_FALLEN { w[0].house_fall = true; }
}
// The stables' stage now (rt_house_stage).
e5rd_house_stage :: (r: [] E5rRoom) -> int { return rt_house_stage(r[0].raid[0].house); }
// Whether the stables' fall is owed to the room's town, once: then it is the room's
// (room-events.coax ev_raid_step strikes RT_HOUSE_BLASTS Fireballs across them).
e5rd_house_falls :: (r: [] E5rRoom) -> bool {
  if !r[0].raid[0].house_fall { return false; }
  r[0].raid[0].house_fall = false;
  return true;
}
E5RD_WATCH_THROW :: 20;   // feet: a Guard's Spear thrown (its normal range, SRD 5.2.1 Weapons)
E5RD_WATCH_LOOK :: 120;   // feet: how far the watch looks for a raider to shoot at

e5rd_is :: (bt: E5rBeast) -> bool { return bt.id != 0 && bt.form >= E5RR_FORM_RAID && bt.forge_id==0; }
// One of the watch in the standing siege (e5rd_defender): a raid creature of the town's side.
e5rd_town :: (bt: E5rBeast) -> bool { return bt.id != 0 && e5rd_town_form(bt.form) && bt.forge_id==0; }
// A form of the watch's side: a Guard to a Scout, or the hero (#12996).
e5rd_town_form :: (form: int) -> bool { return (form > E5RR_FORM_RAID && form <= E5RR_FORM_RAID + RS_NPC_SCOUT) || form == E5RR_FORM_HERO; }
// One of the cult's: a raider, a ward stone or Darian.
e5rd_cult :: (bt: E5rBeast) -> bool { return e5rd_is(bt) && !e5rd_town(bt); }
e5rd_npc :: (form: int) -> int { return ifx form == E5RR_FORM_WARD then 0 else form - E5RR_FORM_RAID; }
// Where creature i is, in metres (the square's middle; a person, where the world has them).
e5rd_mx :: (r: [] E5rRoom, i: int) -> f32 {
  if i >= E5RR_FOLK0 && i < E5RR_FOLK0 + E5R_FOLK { return r[0].folk_x[i - E5RR_FOLK0]; }
  if i >= E5RR_BEAST0 && i < E5RR_BEAST0 + E5RR_BEASTS { return r[0].beasts[i - E5RR_BEAST0].x; }
  return f32(E5R_X0) + (f32(r[0].b[0].c[i].x) + 0.5) * f32(E5R_SQ);
}
e5rd_mz :: (r: [] E5rRoom, i: int) -> f32 {
  if i >= E5RR_FOLK0 && i < E5RR_FOLK0 + E5R_FOLK { return r[0].folk_z[i - E5RR_FOLK0]; }
  if i >= E5RR_BEAST0 && i < E5RR_BEAST0 + E5RR_BEASTS { return r[0].beasts[i - E5RR_BEAST0].z; }
  return f32(E5R_X0) + (f32(r[0].b[0].c[i].y) + 0.5) * f32(E5R_SQ);
}
// Whether creature i is up and here: a player at their seat, a person out of doors.
e5rd_up :: (r: [] E5rRoom, i: int) -> bool {
  c := r[0].b[0].c[i];
  if c.dead || c.hp <= 0 || c.x == E5R_AWAY { return false; }
  if i >= E5RR_SEAT && i < E5RR_SEAT + E5RR_SEATS { return r[0].live[i - E5RR_SEAT]; }
  if i >= E5RR_BEAST0 && i < E5RR_BEAST0 + E5RR_BEASTS { return e5rd_is(r[0].beasts[i - E5RR_BEAST0]) && r[0].raid[0].slot[i - E5RR_BEAST0].stage != E5RD_FLEE; }   // the siege's (#12860)
  return i >= E5RR_FOLK0 && i < E5RR_FOLK0 + E5R_FOLK;
}

// ---- who comes

// The first free place for a raid creature, from the top (-1 none, or E5RD_MAX are on).
e5rd_free :: (r: [] E5rRoom) -> int {
  on := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { on += 1; } }
  if on >= r[0].raid[0].limit { return -1; }
  q := E5RR_BEASTS - 1;
  while q >= 0 { if outcome_slot_reusable(r[0].beasts[q].id,r[0].raid[0].down_pending[q]) && r[0].beasts[q].forge_id == 0 { return q; } q -= 1; }
  return -1;
}
// Creature c joins the raid at (x, z) as form `form`, by its gate (gx, gz) to (sx, sz) in the square:
// its beast id, 0 with no place.
e5rd_join :: (r: [] E5rRoom, c: RsCreature, form: int, x0: f32, z0: f32, g: RtGate, squad: int, k: int, role: int, sx: f32, sz: f32) -> int {
  if !r[0].started { return 0; }
  // on open ground: never in a wall or a building (rt_free)
  at: [2] f32; rt_free(g, x0, z0, at[..]);
  x := at[0]; z := at[1];
  q := e5rd_free(r);
  if q < 0 { return 0; }
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  t := b[0].c[i].turn_at; ro := b[0].c[i].round_at;
  b[0].c[i] = c;
  b[0].c[i].team = E5RD_TEAM;
  b[0].c[i].turn_at = hi_r(t, b[0].clock) + 0.05 * f32(q % 17); b[0].c[i].round_at = ro;
  b[0].c[i].x = e5r_sq(x); b[0].c[i].y = e5r_sq(z);
  // its squad: a new one takes the place, its calls from now; a caster takes its turns on them
  w := r[0].raid[..];
  s := squad % RT_SQUADS;
  if w[0].sq_id[s] != squad + 1 {
    w[0].sq_id[s] = squad + 1; w[0].sq_anchor[s] = b[0].c[i].turn_at + rs_beat(b) * rt_squad_offset(squad); w[0].sq_at[s] = b[0].clock; w[0].sq_v[s] = 0; w[0].sq_last[s] = -1;
    w[0].sq_go[s] = -1;
  }
  id := r[0].next_id; r[0].next_id += 1;
  // a volleyer takes its turns on its squad's calls; every other raider its own moment in the beat (#12771)
  if role == RT_CASTER && rt_volleyer(id) { b[0].c[i].turn_at = rt_align(b[0].c[i].turn_at, w[0].sq_anchor[s], rs_beat(b)); }
  else if role != RT_LEAD { b[0].c[i].turn_at += rs_beat(b) * rt_turn_offset(id); }
  r[0].beasts[q] = E5rBeast.{id = id, tag = id, by = -1, spell = -1, form = form, x = x, z = z, goal_x = g.x, goal_z = g.z,
                            yaw = e5rr_heading(g.x - x, g.z - z)};
  w[0].slot[q] = E5rdSlot.{npc = e5rd_npc(form), level = c.level, stage = E5RD_IN, role = role, squad = squad, k = k, g = g,
                           gx = g.x, gz = g.z, sx = sx, sz = sz, hx = x, hz = z, front = w[0].siege};
  return id;
}
// The raider of stat block npc (RS_NPC_CULTIST, _FANATIC or _WARLOCK, at `level`), the number-th of
// its kind, at (x, z), in by way g, member k of squad `squad`, its place in the town (sx, sz): its
// beast id, 0 with no place. A Cultist who casts (rt_role) casts by Wisdom (everglade-raid-spells.coax).
e5rd_raider :: (r: [] E5rRoom, npc0: int, level: int, number: int, x: f32, z: f32, g: RtGate, squad: int, k: int, sx: f32, sz: f32) -> int {
  // its stat block and role by the raid's mix, from the id it will have (#12771)
  mix := r[0].raid[0].mix;
  id := r[0].next_id;
  // the stables' burner a caster of its own kind, whatever the mix (#12769)
  burner := rt_house_burner(g, k) && npc0 != RS_NPC_FANATIC;
  npc := ifx burner then npc0 else rt_kind(npc0, id, mix);
  nm: [RS_NAME] u8; nn := rs_npc_named(nm[..], npc, number);
  name := cast(string) nm[0..<nn];
  c: [1] RsCreature;
  if npc == RS_NPC_FANATIC { c[0] = rs_fanatic(name, E5RD_TEAM); }
  else if npc == RS_NPC_CULT_PRIEST { c[0] = rs_cult_priest(name, E5RD_TEAM, E5RD_PRIEST_LEVEL); }
  else if npc == RS_NPC_WARLOCK {
    c[0] = rs_warlock(name, E5RD_TEAM, rs_max(level, 1), SP_ELDRITCH_BLAST);
    c[0].npc = RS_NPC_WARLOCK; c[0].rebuke = true;
    c[0].vigor = c[0].level >= 2;   // Fiendish Vigor, its invocation from level 2
    c[0].repelling = -1;   // no Repelling Blast: a player's place is theirs and the world's, not the rules' to push
  } else { c[0] = rs_cultist(name, E5RD_TEAM); c[0].spell_ability = RS_WIS; }
  return e5rd_join(r, c[0], E5RR_FORM_RAID + c[0].npc, x, z, g, squad, k, ifx burner then RT_CASTER else rt_role_of(npc, id, mix), sx, sz);
}
E5RD_PRIEST_LEVEL :: 3;   // a Cult Priest: a level 3 Cleric (Bless, Shield of Faith, Bane, Command)
// A ward stone at (x, z): its beast id.
e5rd_ward :: (r: [] E5rRoom, x: f32, z: f32) -> int {
  c: [1] RsCreature;
  c[0] = fb_folk("Ward Stone", E5RD_TEAM, E5RD_WARD_AC, E5RD_WARD_HP, [6] int.[10, 1, 10, 1, 1, 1]);
  c[0].humanoid = false; c[0].speed = 0;
  c[0].immune = (1 << RS_POISON) | (1 << RS_PSYCHIC); c[0].immune_cond = -1;
  return e5rd_join(r, c[0], E5RR_FORM_WARD, x, z, rt_open(x, z, 0, 1), RT_SQUADS * 1000, 0, RT_MELEE, x, z);
}
// One of the watch in the standing siege (#12860): stat block npc (RS_NPC_GUARD, _VETERAN, _KNIGHT
// or _SCOUT, npcs.coax), the number-th of its kind, of the town's team, at (x, z) by way g. Its beast id.
e5rd_defender :: (r: [] E5rRoom, npc: int, number: int, x: f32, z: f32, g: RtGate) -> int {
  nm: [RS_NAME] u8; nn := rs_npc_named(nm[..], npc, number);
  name := cast(string) nm[0..<nn];
  c: [1] RsCreature;
  if npc == RS_NPC_VETERAN { c[0] = rs_veteran(name, 1); }
  else if npc == RS_NPC_KNIGHT { c[0] = rs_knight(name, 1); }
  else if npc == RS_NPC_SCOUT { c[0] = rs_scout(name, 1); }
  else { c[0] = rs_guard(name, 1); }
  id := e5rd_join(r, c[0], E5RR_FORM_RAID + c[0].npc, x, z, g, RT_SQUADS * 1000 + 2, 0, ifx rf_town_ranged(c[0].npc) then RT_CASTER else RT_SKIRM, x, z);
  if id <= 0 { return 0; }
  for q: 0..<E5RR_BEASTS {
    if r[0].beasts[q].id != id { continue; }
    r[0].b[0].c[E5RR_BEAST0 + q].team = 1;   // the town's
    r[0].raid[0].slot[q].town = true; r[0].raid[0].slot[q].front = true;
  }
  return id;
}
// Echo joins the watch (#12996) at (x, z), out by way g: Everglade's own caster (fb_everglade_hero),
// of the town's team, with the watch's ranged at the front. Once: her beast id, or her id already
// (0 with no place).
e5rd_hero :: (r: [] E5rRoom, x: f32, z: f32, g: RtGate) -> int {
  w := r[0].raid[..];
  q0 := w[0].hero.q;
  if q0 >= 0 && q0 < E5RR_BEASTS && r[0].beasts[q0].form == E5RR_FORM_HERO && e5rd_is(r[0].beasts[q0]) { return r[0].beasts[q0].id; }
  c: [1] RsCreature;
  c[0] = fb_everglade_hero("Echo", 1);
  c[0].floor = 1;   // she can be hurt but never drops
  id := e5rd_join(r, c[0], E5RR_FORM_HERO, x, z, g, RT_SQUADS * 1000 + 3, 0, RT_CASTER, x, z);
  if id <= 0 { return 0; }
  for q: 0..<E5RR_BEASTS {
    if r[0].beasts[q].id != id { continue; }
    r[0].b[0].c[E5RR_BEAST0 + q].team = 1;
    w[0].slot[q].town = true; w[0].slot[q].front = true;
    w[0].hero = E5rdHero.{q = q, next = r[0].b[0].clock};
  }
  return id;
}
// Echo's turn (#12996): with her bar not running and her moment come, the tactics aim one of
// Everglade's four at the cult within her reach (rt_hero_aim); the pages hear it start.
e5rd_hero_turn :: (r: [] E5rRoom, q: int) {
  w := r[0].raid[..];
  b := r[0].b[..];
  bt := r[0].beasts[q..<q + 1];
  if w[0].hero.on || b[0].clock < w[0].hero.next { return; }
  foe: [E5RR_BEASTS] bool;
  for o: 0..<E5RR_BEASTS {
    ob := r[0].beasts[o];
    foe[o] = o != q && e5rd_cult(ob) && w[0].slot[o].stage != E5RD_FLEE && !b[0].c[E5RR_BEAST0 + o].dead && w[0].on[o];
    if (ob.form == E5RR_FORM_WARD || ob.form == E5RR_FORM_RAID + RS_NPC_ARCH) && !w[0].stand { foe[o] = false; }
  }
  o: [4] f32;
  k := rt_hero_aim(bt[0].x, bt[0].z, w[0].xs[..], w[0].zs[..], foe[..], E5RR_BEASTS, f32(E5RD_HERO_REACH), w[0].hero.casts == 0, o[..]);
  bt[0].foe = ifx k >= 0 then E5RR_BEAST0 + cast(int) o[2] else -1;
  if k < 0 || w[0].cast_n >= E5RD_CASTS - 4 - E5RD_REBUKES { return; }
  bar: [FB_EG_SLOTS] FbAb;
  _ := fb_everglade(bar[..]);
  bt[0].yaw = e5rr_heading(o[0] - bt[0].x, o[1] - bt[0].z);
  seed := rs_roll(b[0].dice[..], 999983);
  y := r[0].beasts[cast(int) o[2]].y;   // the ground's at the aim: the foe's there
  w[0].casts[w[0].cast_n] = E5rdCast.{id = bt[0].id, q = q, k = RT_K_HERO0 + k, to = -1, ax = o[0], az = o[1], seed = seed, fx = bt[0].x, fy = bt[0].y + 1.5, fz = bt[0].z, harm = false, ground = true, ay = y};
  w[0].cast_n += 1;
  t := b[0].clock;
  w[0].hero = E5rdHero.{q = q, on = true, k = k, x = o[0], y = y, z = o[1], seed = seed, release = t + CR_BAR[k], due = t + bar[k].delay, next = t + f32(E5RD_HERO_EVERY), casts = w[0].hero.casts, rolled = w[0].hero.rolled};
}
// Each step, Echo's cast on: as its bar ends the town takes its strike (the damage dial on); as it
// lands the rules roll it, the other players and the watch out of it as a player's harm keeps them.
e5rd_hero_step :: (r: [] E5rRoom) {
  w := r[0].raid[..];
  b := r[0].b[..];
  h := w[0].hero;
  q := h.q;
  if !h.on || q < 0 || q >= E5RR_BEASTS { return; }
  i := E5RR_BEAST0 + q;
  bt := r[0].beasts[q];
  if bt.form != E5RR_FORM_HERO || !e5rd_is(bt) { w[0].hero.on = false; return; }
  if !h.struck && b[0].clock >= h.release {
    w[0].hero.struck = true;
    if w[0].harm && w[0].cast_n < E5RD_CASTS {
      w[0].casts[w[0].cast_n] = E5rdCast.{id = bt.id, q = q, k = RT_K_HERO0 + h.k, to = -1, ax = h.x, az = h.z, seed = h.seed, fx = bt.x, fy = bt.y + 1.5, fz = bt.z, harm = true, slot = h.k, cue = false, ground = true, ay = h.y};
      w[0].cast_n += 1;
    }
  }
  if b[0].clock < h.due { return; }
  w[0].hero.on = false; w[0].hero.casts += 1;
  if b[0].c[i].dead { return; }
  bar: [FB_EG_SLOTS] FbAb;
  _ := fb_everglade(bar[..]);
  a := bar[h.k];
  // the bar's spells never run out (e5rr_use): every slot back, a fresh turn of her own
  for l: 0..<10 { b[0].c[i].slots[l] = b[0].c[i].slots_max[l]; }
  kx: [E5RR_SEATS + E5RR_BEASTS] int; ky: [E5RR_SEATS + E5RR_BEASTS] int;
  for s: 0..<E5RR_SEATS { c := E5RR_SEAT + s; kx[s] = b[0].c[c].x; ky[s] = b[0].c[c].y; b[0].c[c].x = E5R_AWAY; b[0].c[c].y = E5R_AWAY; }
  for o: 0..<E5RR_BEASTS {
    c := E5RR_BEAST0 + o; kx[E5RR_SEATS + o] = b[0].c[c].x; ky[E5RR_SEATS + o] = b[0].c[c].y;
    if o != q && e5rd_town(r[0].beasts[o]) { b[0].c[c].x = E5R_AWAY; b[0].c[c].y = E5R_AWAY; }
  }
  who := b[0].who; kept := b[0].turn;
  b[0].who = i; b[0].turn = RsTurn.{};
  rolled := rs_cast(b, i, a.sp, rs_max(a.lvl, rs_spell(a.sp).level), e5r_sq(h.x), e5r_sq(h.z), -1);
  if rolled { w[0].hero.rolled += 1; }
  b[0].who = who; b[0].turn = kept;
  for s: 0..<E5RR_SEATS { c := E5RR_SEAT + s; b[0].c[c].x = kx[s]; b[0].c[c].y = ky[s]; }
  for o: 0..<E5RR_BEASTS { c := E5RR_BEAST0 + o; b[0].c[c].x = kx[E5RR_SEATS + o]; b[0].c[c].y = ky[E5RR_SEATS + o]; }
}
// The ward stones can't be broken while `hold` (the front short of the camp), else they can.
e5rd_wards_hold :: (r: [] E5rRoom, hold: bool) {
  for q: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[q]) || r[0].beasts[q].form != E5RR_FORM_WARD { continue; }
    i := E5RR_BEAST0 + q;
    r[0].b[0].c[i].floor = ifx hold then r[0].b[0].c[i].hp_max + 1 else 0;
  }
}
// How many of the watch stand in the siege.
e5rd_town_standing :: (r: [] E5rRoom) -> int {
  n := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_town(r[0].beasts[q]) && r[0].raid[0].slot[q].stage != E5RD_FLEE && !r[0].b[0].c[E5RR_BEAST0 + q].dead { n += 1; } }
  return n;
}
// Darian Odiodei (npcs.coax rs_siege_arch: the SRD's Fiend Warlock at level 17) at (x, z), by the gate
// (gx, gz); (sx, sz) where he holds with none of his lines standing. Warded until the stones fall.
// His beast id.
e5rd_arch :: (r: [] E5rRoom, x: f32, z: f32, gx: f32, gz: f32, sx: f32, sz: f32) -> int {
  c: [1] RsCreature;
  c[0] = rs_siege_arch(RS_ARCH_NAME, E5RD_TEAM, SP_ELDRITCH_BLAST);
  c[0].repelling = -1; c[0].vigor = true;   // Fiendish Vigor: False Life on himself, no slot
  c[0].immune_cond = -1;   // nothing holds him: he can be hurt (once the wards are down) but not stopped
  c[0].floor = c[0].hp_max + 1;
  id := e5rd_join(r, c[0], E5RR_FORM_RAID + RS_NPC_ARCH, x, z, rt_open(gx, gz, 0, 1), RT_SQUADS * 1000 + 1, 0, RT_LEAD, sx, sz);
  if id > 0 { for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id == id { r[0].raid[0].arch = q; } } }
  return id;
}
// The wards are down: hits hurt Darian, down to half his Hit Points (and then he withdraws).
e5rd_expose :: (r: [] E5rRoom) {
  q := r[0].raid[0].arch;
  if q < 0 || r[0].beasts[q].id == 0 { return; }
  i := E5RR_BEAST0 + q;
  r[0].b[0].c[i].floor = rs_max(r[0].b[0].c[i].hp_max / 2, 1);
}
// Whether Darian is here, and his Hit Points into hp[0], hp[1] (now, the most).
e5rd_arch_hp :: (r: [] E5rRoom, hp: [] int) -> bool {
  q := r[0].raid[0].arch;
  if q < 0 || r[0].beasts[q].id == 0 || hp.count < 2 { return false; }
  c := r[0].b[0].c[E5RR_BEAST0 + q];
  hp[0] = c.hp; hp[1] = c.hp_max;
  return true;
}
// Darian casts Dimension Door out of the town: gone, unhurt past his floor. His beast id (0 none here).
e5rd_withdraw :: (r: [] E5rRoom) -> int {
  q := r[0].raid[0].arch;
  r[0].raid[0].arch = -1;
  if q < 0 || r[0].beasts[q].id == 0 { return 0; }
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  id := r[0].beasts[q].id;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " casts Dimension Door and withdraws");
  rs_tell(b, RS_EV_END, SP_DIMENSION_DOOR, i, i, 0, 0, l[..]);
  e5rd_cast(r, q, E5RD_K_DOOR, -1, r[0].raid[0].slot[q].hx, r[0].raid[0].slot[q].hz);
  b[0].c[i].floor = 0;
  e5b_gone(b, r[0].beasts[..], E5RR_BEAST0, q);
  return id;
}
// The raid is over: everyone left runs back the way it came (and is gone there); the stones fall.
e5rd_flee :: (r: [] E5rRoom) {
  _ := e5rd_withdraw(r);
  for q: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[q]) { continue; }
    if r[0].beasts[q].form == E5RR_FORM_WARD { e5b_gone(r[0].b[..], r[0].beasts[..], E5RR_BEAST0, q); continue; }
    r[0].raid[0].slot[q].stage = E5RD_FLEE; r[0].beasts[q].foe = -1;
  }
}
// Every raid creature gone at once (STOP, the aftermath's end, a new room).
e5rd_clear :: (r: [] E5rRoom) {
  r[0].raid[0].arch = -1; r[0].raid[0].hero = E5rdHero.{};
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { r[0].b[0].c[E5RR_BEAST0 + q].floor = 0; e5b_gone(r[0].b[..], r[0].beasts[..], E5RR_BEAST0, q); } }
  // Released object impacts survive the disappearance of their caster.
  kept:=0;for n:0..<r[0].raid[0].cast_n{c:=r[0].raid[0].casts[n];if c.harm{r[0].raid[0].casts[kept]=c;kept+=1;}else{r[0].raid[0].cue_dropped+=1;}}
  r[0].raid[0].cast_n = kept; r[0].raid[0].down_n = 0;
  for q:0..<E5RR_BEASTS{r[0].raid[0].down_pending[q]=false;}
}
// How many raiders stand (the stones and the leader not counted), and how many stones.
e5rd_standing :: (r: [] E5rRoom) -> int {
  n := 0;
  for q: 0..<E5RR_BEASTS { bt := r[0].beasts[q]; if e5rd_cult(bt) && bt.form != E5RR_FORM_WARD && bt.form != E5RR_FORM_RAID + RS_NPC_ARCH && r[0].raid[0].slot[q].stage != E5RD_FLEE { n += 1; } }
  return n;
}
e5rd_wards :: (r: [] E5rRoom) -> int {
  n := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) && r[0].beasts[q].form == E5RR_FORM_WARD { n += 1; } }
  return n;
}
// How many raiders stand within rad metres of (x, z), and how many players.
e5rd_in :: (r: [] E5rRoom, x: f32, z: f32, rad: f32, players: bool) -> int {
  n := 0;
  if players {
    for s: 0..<E5RR_SEATS { i := E5RR_SEAT + s; if e5rd_up(r, i) { dx := e5rd_mx(r, i) - x; dz := e5rd_mz(r, i) - z; if dx * dx + dz * dz <= rad * rad { n += 1; } } }
    return n;
  }
  for q: 0..<E5RR_BEASTS {
    bt := r[0].beasts[q];
    if !e5rd_cult(bt) || bt.form == E5RR_FORM_WARD || r[0].raid[0].slot[q].stage == E5RD_FLEE { continue; }
    dx := bt.x - x; dz := bt.z - z;
    if dx * dx + dz * dz <= rad * rad { n += 1; }
  }
  return n;
}

// ---- the queues the room drains

e5rd_cast :: (r: [] E5rRoom, q: int, k: int, to: int, ax: f32, az: f32) {
  w := r[0].raid[..];
  if w[0].cast_n >= E5RD_CASTS { w[0].cue_dropped+=1;return; }
  seed := rs_roll(r[0].b[0].dice[..], 999983);
  bt:=r[0].beasts[q];
  harm:=w[0].harm&&effect_physical(64+k);
  w[0].casts[w[0].cast_n] = E5rdCast.{id = bt.id,q=q,k = k, to = to, ax = ax, az = az, seed = seed,fx=bt.x,fy=bt.y+1.5,fz=bt.z,harm=harm};
  w[0].cast_n += 1;
  if w[0].effect_known&&harm{w[0].effect_free[q]=rs_max(w[0].effect_free[q]-1,0);}
}
// Raid creature q fell (everglade5e-room-rules.coax e5rr_beasts_check, before it goes).
e5rd_down :: (r: [] E5rRoom, q: int) -> bool {
  w := r[0].raid[..];
  if w[0].slot[q].stage == E5RD_FLEE || w[0].down_pending[q] { return true; }
  if !outcome_slot_record(q,w[0].down_n,E5RD_DOWNS,w[0].down_pending[q]) { return false; }
  if q == w[0].arch { w[0].arch = -1; }
  bt := r[0].beasts[q];
  w[0].downs[w[0].down_n] = E5rdDown.{q = q, tag = bt.tag, npc = w[0].slot[q].npc, level = w[0].slot[q].level, x = bt.x, z = bt.z};
  w[0].down_n += 1;
  w[0].down_pending[q]=true;
  return true;
}

// ---- how they fight

// Whether player i stands in the spawn's clear ground (RT_SPAWN_R): no raider sets on them there.
e5rd_safe :: (r: [] E5rRoom, i: int) -> bool {
  dx := e5rd_mx(r, i) - f32(E5RD_SPAWN_X); dz := e5rd_mz(r, i) - f32(E5RD_SPAWN_Z);
  return dx * dx + dz * dz < f32(RT_SPAWN_R) * f32(RT_SPAWN_R);
}
// Whether raid creature q's squad is through with its siege: its volleys at the wall fired, or it has
// been at it RT_SIEGE_S, or its way has no wall.
e5rd_done :: (r: [] E5rRoom, q: int) -> bool {
  sl := r[0].raid[0].slot[q];
  if !sl.g.wall || sl.front { return true; }
  s := sl.squad % RT_SQUADS;
  return r[0].raid[0].sq_v[s] >= RT_SIEGE_VOLLEYS || r[0].b[0].clock - r[0].raid[0].sq_at[s] >= f32(RT_SIEGE_S);
}
// Whether raid creature q goes in: its squad's siege done (e5rd_done), and its own moment after
// that come (rt_start), so the squad starts a raider at a time.
e5rd_going :: (r: [] E5rRoom, q: int) -> bool {
  if !e5rd_done(r, q) { return false; }
  if rt_house_burner(r[0].raid[0].slot[q].g, r[0].raid[0].slot[q].k) { return false; }   // at the stables till they fall
  w := r[0].raid[..];
  s := w[0].slot[q].squad % RT_SQUADS;
  if w[0].sq_go[s] < 0 { w[0].sq_go[s] = r[0].b[0].clock; }
  return r[0].b[0].clock - w[0].sq_go[s] >= rt_start(r[0].beasts[q].id);
}

// The foe for raid creature q within reach metres: the nearest player, else the nearest townsperson
// (a player up to E5RD_SEAT_FIRST farther still comes first). -1 none.
e5rd_foe :: (r: [] E5rRoom, q: int, reach: f32) -> int {
  if r[0].raid[0].slot[q].front { return e5rd_foe_front(r, q, reach); }
  bt := r[0].beasts[q];
  best := -1; bd := reach + E5RD_SEAT_FIRST;
  for s: 0..<E5RR_SEATS {
    i := E5RR_SEAT + s;
    if !e5rd_up(r, i) || e5rd_safe(r, i) { continue; }
    dx := e5rd_mx(r, i) - bt.x; dz := e5rd_mz(r, i) - bt.z;
    d := sqrt(dx * dx + dz * dz);
    if d <= reach && d - E5RD_SEAT_FIRST < bd { bd = d - E5RD_SEAT_FIRST; best = i; }
  }
  for j: 0..<E5R_FOLK {
    i := E5RR_FOLK0 + j;
    if !e5rd_up(r, i) { continue; }
    dx := r[0].folk_x[j] - bt.x; dz := r[0].folk_z[j] - bt.z;
    if abs(dx) > reach || abs(dz) > reach { continue; }
    d := sqrt(dx * dx + dz * dz);
    if d <= reach && d < bd { bd = d; best = i; }
  }
  return best;
}
// In the standing siege (#12860): the foe for raid creature q within reach metres, of the other side.
// The cult's: the nearest player (as e5rd_foe) or one of the watch, never the town's people inside the
// walls. The watch's: the nearest of the cult, its ward stones and Darian only at the camp's stand.
e5rd_foe_front :: (r: [] E5rRoom, q: int, reach: f32) -> int {
  bt := r[0].beasts[q];
  town := r[0].raid[0].slot[q].town;
  best := -1; bd := reach + E5RD_SEAT_FIRST;
  if !town {
    for s: 0..<E5RR_SEATS {
      i := E5RR_SEAT + s;
      if !e5rd_up(r, i) || e5rd_safe(r, i) { continue; }
      dx := e5rd_mx(r, i) - bt.x; dz := e5rd_mz(r, i) - bt.z;
      d := sqrt(dx * dx + dz * dz);
      if d <= reach && d - E5RD_SEAT_FIRST < bd { bd = d - E5RD_SEAT_FIRST; best = i; }
    }
  }
  for o: 0..<E5RR_BEASTS {
    ob := r[0].beasts[o];
    if o == q || !e5rd_is(ob) || e5rd_town(ob) == town || r[0].raid[0].slot[o].stage == E5RD_FLEE || r[0].b[0].c[E5RR_BEAST0 + o].dead { continue; }
    if (ob.form == E5RR_FORM_WARD || ob.form == E5RR_FORM_RAID + RS_NPC_ARCH) && !r[0].raid[0].stand { continue; }
    dx := ob.x - bt.x; dz := ob.z - bt.z;
    if abs(dx) > reach || abs(dz) > reach { continue; }
    d := sqrt(dx * dx + dz * dz);
    if d <= reach && d < bd { bd = d; best = E5RR_BEAST0 + o; }
  }
  return best;
}
// One of the watch's turn in the standing siege (#12860): it strikes the nearest of the cult at hand,
// else shoots (a Veteran's Heavy Crossbow, a Scout's Longbow) or throws (a Guard's Spear) at it.
e5rd_town_turn :: (r: [] E5rRoom, q: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  c := b[0].c[i];
  ranged := c.ranged >= 0;
  foe := e5rd_foe(r, q, ifx ranged then f32(E5RD_REACH_CAST) else f32(E5RD_REACH_MELEE));
  r[0].beasts[q].foe = foe;
  if foe < 0 { return; }
  fd := rs_feet_to(b, i, foe);
  if fd <= 5 { _ := rs_attack(b, i, foe, false, -1); return; }
  if ranged { _ := rs_shoot(b, i, foe); return; }
  if fd > E5RD_WATCH_THROW || b[0].turn.action { return; }
  b[0].turn.action = true;
  _ := rs_strike(b, i, foe, c.weapon, false);
  rs_after_blow(b, i);
}
// The middle of the most players and people within 20 feet of one of them, within 150 feet of creature
// i: the one at its middle (its count into n[0]), -1 none.
e5rd_burst :: (r: [] E5rRoom, i: int, n: [] int) -> int {
  b := r[0].b[..];
  best := -1; most := 0;
  for a: 0..<E5RR_SEATS + E5R_FOLK {
    ia := ifx a < E5RR_SEATS then E5RR_SEAT + a else E5RR_FOLK0 + a - E5RR_SEATS;
    if !e5rd_up(r, ia) || rs_feet_to(b, i, ia) > 150 { continue; }
    m := 0;
    for c: 0..<E5RR_SEATS + E5R_FOLK {
      ic := ifx c < E5RR_SEATS then E5RR_SEAT + c else E5RR_FOLK0 + c - E5RR_SEATS;
      if e5rd_up(r, ic) && rs_feet_to(b, ia, ic) <= 20 { m += 1; }
    }
    // players count double: the leader means them
    if a < E5RR_SEATS { m += 1; }
    if m > most { most = m; best = ia; }
  }
  n[0] = most;
  return best;
}
// Raid creature q's turn (between rs_start_turn and rs_end_turn, everglade5e-room-rules.coax e5rr_step),
// by its role (#12771): a volleyer fires on its squad's calls; any other caster, and a support, casts
// on its own turns while it holds between bounds (rt_moving); a skirmisher and a guard strike at hand.
e5rd_turn :: (r: [] E5rRoom, q: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  bt := r[0].beasts[q..<q + 1];
  sl := r[0].raid[0].slot[q..<q + 1];
  w := r[0].raid[..];
  if bt[0].form == E5RR_FORM_WARD || sl[0].stage == E5RD_FLEE || !rs_can_act(b[0].c[i]) { return; }
  if q == w[0].hero.q && bt[0].form == E5RR_FORM_HERO { e5rd_hero_turn(r, q); return; }   // Echo's (#12996)
  if sl[0].town { e5rd_town_turn(r, q); return; }
  npc := sl[0].npc;
  need:=ifx npc==RS_NPC_ARCH then 2 else 1;
  if w[0].cast_n>E5RD_CASTS-4-E5RD_REBUKES||(w[0].effect_known&&!effect_admit(w[0].effect_free[q],0,need,EFFECT_NPC_CAP)){w[0].effect_deferred+=1;return;}
  if npc == RS_NPC_ARCH { e5rd_arch_turn(r, q); return; }
  done := e5rd_done(r, q);
  role := sl[0].role;
  burning := done && rt_house_burner(sl[0].g, sl[0].k);   // the stables' burner, at its siege place: no bounds
  holding := burning || !rt_moving(bt[0].id, role, b[0].clock);
  if role == RT_SUPPORT {
    foe := e5rd_foe(r, q, f32(E5RD_REACH_CAST));
    bt[0].foe = foe;
    if !holding { return; }
    e5rd_support(r, q, foe);
    if foe >= 0 && b[0].turn.action == false && npc == RS_NPC_FANATIC && rs_feet_to(b, i, foe) <= 5 { _ := rs_attack(b, i, foe, false, -1); }
    return;
  }
  caster := role == RT_CASTER || (role == RT_GUARD && npc == RS_NPC_WARLOCK);
  if caster {
    s := sl[0].squad % RT_SQUADS;
    volleyer := role == RT_CASTER && rt_volleyer(bt[0].id) && !done;   // the volleys are the siege's; in the town each on its own
    if role == RT_CASTER && rt_volleyer(bt[0].id) && done && !sl[0].freed {
      // its siege done: its turns from now at its own moment in the beat, not its squad's
      sl[0].freed = true;
      b[0].c[i].turn_at += rs_beat(b) * rt_own_offset(bt[0].id);
    }
    // a volleyer on its squad's call; the rest on their own turns, holding
    v := rt_volley(b[0].clock, w[0].sq_anchor[s], rs_beat(b));
    call := ifx v >= 0 then v else int(b[0].clock / rs_beat(b));
    // the stables' burner, while they stand, shoots only a foe at hand, as in the siege (the gate's watch
    // is in a caster's reach from its place: #12769)
    foe := e5rd_foe(r, q, ifx (done && !burning) || role == RT_GUARD then f32(E5RD_REACH_CAST) else f32(RT_SELF));
    bt[0].foe = foe;   // its foe, to keep its distance from, even in a bound
    if volleyer && v < 0 { return; }
    if !volleyer && !holding { return; }
    if foe < 0 && burning {
      // its siege done, the stables' burner keeps at them on its own turns till they fall (#12769)
      if !w[0].harm { return; }
      o: [2] f32; rt_house_mid(o[..]);
      o[0] += f32(call % 3 - 1) * 3.0; o[1] += f32((call / 3) % 3 - 1) * 3.0;
      bt[0].yaw = e5rr_heading(o[0] - bt[0].x, o[1] - bt[0].z);
      e5rd_cast(r, q, rt_siege_look(npc), -1, o[0], o[1]);
      w[0].house_y = bt[0].y; e5rd_house_hurt(r, rs_roll(b[0].dice[..], RT_HOUSE_BURN));
      return;
    }
    if foe < 0 {
      if done || role == RT_GUARD { return; }
      // the siege: a volley at the wall on the call (the squad's volleys count once a call), and the
      // others' bolts at it between
      if volleyer && w[0].sq_last[s] != v { w[0].sq_last[s] = v; w[0].sq_v[s] += 1; }
      o: [2] f32;
      aim := rt_siege_aim(sl[0].g, sl[0].squad, sl[0].k, rt_hi_i(w[0].sq_v[s] - 1, 0), o[..]);
      if aim != RT_AIM_FOES && w[0].harm {
        bt[0].yaw = e5rr_heading(o[0] - bt[0].x, o[1] - bt[0].z);
        e5rd_cast(r, q, rt_siege_look(npc), -1, o[0], o[1]);
        // the stables take its bolt or its beams (#12769)
        if aim == RT_AIM_HOUSE { w[0].house_y = bt[0].y; e5rd_house_hurt(r, rs_roll(b[0].dice[..], RT_HOUSE_BOLT)); }
      }
      return;
    }
    // a Warlock between the volleys keeps its False Life up and puts Bane or Ray of Enfeeblement on its foe
    if !volleyer && npc == RS_NPC_WARLOCK { e5rd_support(r, q, foe); return; }
    e5rd_spell(r, q, call);
    return;
  }
  foe := e5rd_foe(r, q, f32(E5RD_REACH_MELEE));
  bt[0].foe = foe;
  if foe < 0 { return; }
  // a Fanatic: Hold Person (its 1/Day) on a player within 60 feet when none is at hand
  if npc == RS_NPC_FANATIC && !sl[0].held && b[0].c[i].slots[2] > 0 && foe < E5RR_FOLK0 && rs_feet_to(b, i, foe) > 5 && rs_feet_to(b, i, foe) <= 60 {
    if rs_cast(b, i, SP_HOLD_PERSON, 2, 0, 0, foe) { sl[0].held = true; e5rd_cast(r, q, RT_K_HOLD, foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); return; }
  }
  if rs_feet_to(b, i, foe) <= 5 { _ := rs_attack(b, i, foe, false, -1); }
}
// Support q's buffs and debuffs (everglade-raid-spells.coax rt_support), each played for the pages:
// at the one of the cult it blessed, or the foe it cursed.
e5rd_support :: (r: [] E5rRoom, q: int, foe: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  done: [RT_CASTS_MAX] RtCastDone;
  n := rt_support(b, i, r[0].beasts[q].id, foe, done[..]);
  for c: 0..<n {
    to := done[c].to;
    if to < 0 { continue; }
    r[0].beasts[q].yaw = e5rr_heading(e5rd_mx(r, to) - r[0].beasts[q].x, e5rd_mz(r, to) - r[0].beasts[q].z);
    e5rd_cast(r, q, rt_look(done[c].sp), to, e5rd_mx(r, to), e5rd_mz(r, to));
  }
}
// Caster q's spells at its foe on its squad's call v (everglade-raid-spells.coax): Hex first, its Bonus
// Action, then the action spell rt_spell picks, each played for the pages.
e5rd_spell :: (r: [] E5rRoom, q: int, v: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  foe := r[0].beasts[q].foe;
  if foe < 0 { return; }
  feet := rs_feet_to(b, i, foe);
  if rt_hex(b[0].c[i], feet) && rs_cast(b, i, SP_HEX, rt_pact(b[0].c[i]), 0, 0, foe) { e5rd_cast(r, q, RT_K_HEX, foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); }
  sp := rt_spell(b[0].c[i], r[0].raid[0].slot[q].k, v, feet);
  if sp < 0 || b[0].c[foe].dead { return; }
  ok := false;
  if rs_spell(sp).area == RS_A_NONE { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), 0, 0, foe); }
  else { ok = rs_cast(b, i, sp, rt_slot(b[0].c[i], sp), b[0].c[foe].x, b[0].c[foe].y, -1); }
  if ok { e5rd_cast(r, q, rt_look(sp), foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); }
}
// The Hellish Rebukes the raid's Warlocks cast since the last step (the engine casts them as their
// Reaction, battle.coax rs_hellish_rebuke): each played for the pages, on whom it burned.
e5rd_rebukes :: (r: [] E5rRoom) {
  b := r[0].b[..];
  w := r[0].raid[..];
  by: [E5RD_REBUKES] int; to: [E5RD_REBUKES] int;
  n := rt_rebukes(b, w[0].seq, by[..], to[..]);
  w[0].seq = b[0].book[0].seq;
  for k: 0..<n {
    q := by[k] - E5RR_BEAST0;
    if q < 0 || q >= E5RR_BEASTS || !e5rd_is(r[0].beasts[q]) || to[k] < 0 { continue; }
    e5rd_cast(r, q, RT_K_REBUKE, to[k], e5rd_mx(r, to[k]), e5rd_mz(r, to[k]));
  }
}
// The town watch's arms (everglade5e-room-rules.coax e5rr_people): a Guard's Spear, a Warrior
// Veteran's and a Knight's Greatsword and Heavy Crossbow, as their stat blocks have them. The town's
// step owns where the watch stands; in a raid each fights from there (e5rd_folk_turn).
e5rd_arm :: (c: [] RsCreature, block: int) {
  w: [1] RsCreature;
  if block == E5R_GUARD { w[0] = rs_guard("Guard", 1); }
  else if block == E5R_VETERAN { w[0] = rs_veteran("Warrior Veteran", 1); }
  else if block == E5R_KNIGHT { w[0] = rs_knight("Knight", 1); }
  else if block == E5R_SCOUT { w[0] = rs_scout("Scout", 1); }
  else { return; }
  c[0].weapon = w[0].weapon; c[0].ranged = w[0].ranged; c[0].extra_attack = w[0].extra_attack; c[0].parry = w[0].parry;
}
// Townsperson j's turn (e5rr_step, between its start and end): while raiders stand, one of the watch
// strikes the nearest at hand, else shoots or throws at the nearest in reach.
e5rd_folk_turn :: (r: [] E5rRoom, j: int) {
  if r[0].raid[0].up == 0 { return; }
  block := r[0].block[j];
  if block != E5R_GUARD && block != E5R_VETERAN && block != E5R_KNIGHT { return; }
  b := r[0].b[..];
  i := E5RR_FOLK0 + j;
  if !rs_can_act(b[0].c[i]) { return; }
  reach := ifx b[0].c[i].ranged >= 0 then rs_weapon(b[0].c[i].ranged).long_ft else E5RD_WATCH_THROW;
  reach = rs_min(reach, E5RD_WATCH_LOOK);
  foe := -1; fd := reach + 1;
  for q: 0..<E5RR_BEASTS {
    bt := r[0].beasts[q];
    if !e5rd_cult(bt) || bt.form == E5RR_FORM_WARD || r[0].raid[0].slot[q].stage == E5RD_FLEE { continue; }
    o := E5RR_BEAST0 + q;
    if b[0].c[o].dead { continue; }
    d := rs_feet_to(b, i, o);
    if d < fd { fd = d; foe = o; }
  }
  if foe < 0 { return; }
  if fd <= 5 { _ := rs_attack(b, i, foe, false, -1); return; }
  if b[0].c[i].ranged >= 0 { _ := rs_shoot(b, i, foe); return; }
  // a Guard throws its Spear
  if b[0].turn.action { return; }
  b[0].turn.action = true;
  _ := rs_strike(b, i, foe, b[0].c[i].weapon, false);
  rs_after_blow(b, i);
}
// Darian's turn, by the aggression dial (spec 5.3).
e5rd_arch_turn :: (r: [] E5rRoom, q: int) {
  if e5rd_door(r, q) { return; }
  aggr := r[0].raid[0].aggr;
  if aggr <= 0 { return; }
  e5rd_arch_act(r, q, aggr);
  if aggr >= 3 {
    // twice a turn: a second action
    r[0].b[0].turn.action = false; r[0].b[0].turn.slot_spent = false; r[0].b[0].turn.bonus = false;
    e5rd_arch_act(r, q, aggr);
  }
}
// A foe within RT_THREAT of Darian, and a Pact slot left: he casts Dimension Door (SRD 5.2.1: 500 feet;
// a 5th-level Pact slot) RT_DOOR back from it, clear of the spawn. Whether he did.
e5rd_door :: (r: [] E5rRoom, q: int) -> bool {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  if b[0].c[i].slots[5] <= 0 || b[0].turn.action { return false; }
  foe := e5rd_foe(r, q, f32(RT_THREAT));
  if foe < 0 { return false; }
  bt := r[0].beasts[q..<q + 1];
  sl := r[0].raid[0].slot[q];
  o: [2] f32;
  rt_door(bt[0].x, bt[0].z, e5rd_mx(r, foe), e5rd_mz(r, foe), sl.hx, sl.hz, o[..]);
  rt_clear(o[0], o[1], f32(E5RD_SPAWN_X), f32(E5RD_SPAWN_Z), f32(RT_SPAWN_R), o[..]);
  rt_free(sl.g, o[0], o[1], o[..]);   // onto open ground, not into a wall or a building
  b[0].c[i].slots[5] -= 1; b[0].turn.action = true;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], " casts Dimension Door");
  rs_tell(b, RS_EV_END, SP_DIMENSION_DOOR, i, i, 0, 0, l[..]);
  e5rd_cast(r, q, E5RD_K_DOOR, -1, o[0], o[1]);
  bt[0].x = o[0]; bt[0].z = o[1];
  b[0].c[i].x = e5r_sq(o[0]); b[0].c[i].y = e5r_sq(o[1]);
  return true;
}
// Darian with no foe in reach, the stables standing within Fireball's 150 feet at his gate: a
// Fireball on them while he has a Pact slot to spare (one kept for Dimension Door), else Eldritch
// Blast's beams (#12769).
E5RD_HOUSE_REACH :: 45.0;
E5RD_ARCH_AT_HAND :: 40;   // ft: a foe this near Darian comes before the stables
e5rd_arch_house :: (r: [] E5rRoom, q: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  w := r[0].raid[..];
  bt := r[0].beasts[q..<q + 1];
  // (his way in is an open gate, no wall: his reach is the test, not rt_house_near)
  if !w[0].harm || rt_house_stage(w[0].house) == RT_HOUSE_FALLEN || b[0].turn.action { return; }
  o: [2] f32; rt_house_mid(o[..]);
  dx := o[0] - bt[0].x; dz := o[1] - bt[0].z;
  if dx * dx + dz * dz > f32(E5RD_HOUSE_REACH) * f32(E5RD_HOUSE_REACH) { return; }
  b[0].turn.action = true;
  bt[0].yaw = e5rr_heading(dx, dz);
  w[0].house_y = bt[0].y;
  if b[0].c[i].slots[5] > 1 {
    b[0].c[i].slots[5] -= 1;
    e5rd_cast(r, q, E5RD_K_FIREBALL, -1, o[0], o[1]);
    e5rd_house_hurt(r, 12 + rs_roll(b[0].dice[..], 8));
    return;
  }
  e5rd_cast(r, q, E5RD_K_BLAST, -1, o[0], o[1]);
  e5rd_house_hurt(r, rs_roll(b[0].dice[..], RT_HOUSE_BOLT));
}
e5rd_arch_act :: (r: [] E5rRoom, q: int, aggr: int) {
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  c := b[0].c[i];
  foe := e5rd_foe(r, q, f32(E5RD_REACH_ARCH));
  r[0].beasts[q].foe = foe;
  // False Life on himself by Fiendish Vigor while none is at hand (#12771)
  if c.vigor && c.temp <= 0 && (foe < 0 || rs_feet_to(b, i, foe) > 30) && rs_cast(b, i, SP_FALSE_LIFE, 0, 0, 0, i) { e5rd_cast(r, q, RT_K_FALSE_LIFE, i, r[0].beasts[q].x, r[0].beasts[q].z); return; }
  if foe < 0 { e5rd_arch_house(r, q); return; }
  // the stables standing in his reach and no foe at hand: he razes them first, whoever shoots at him
  // from farther off (a room's watch and players are always somewhere near: #12769)
  if rs_feet_to(b, i, foe) > E5RD_ARCH_AT_HAND {
    e5rd_arch_house(r, q);
    if b[0].turn.action { return; }
  }
  n: [1] int;
  // Circle of Death (his 6th-level Arcanum) and Finger of Death (the 7th), razing
  if aggr >= 3 && c.slots[6] > 0 {
    m := e5rd_burst(r, i, n[..]);
    if m >= 0 && n[0] >= 4 && rs_cast(b, i, SP_CIRCLE_OF_DEATH, 6, b[0].c[m].x, b[0].c[m].y, -1) { e5rd_cast(r, q, E5RD_K_CIRCLE, -1, e5rd_mx(r, m), e5rd_mz(r, m)); return; }
  }
  if aggr >= 3 && c.slots[7] > 0 && rs_feet_to(b, i, foe) <= 60 {
    if rs_cast(b, i, SP_FINGER_OF_DEATH, 7, 0, 0, foe) { e5rd_cast(r, q, E5RD_K_FINGER, foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); return; }
  }
  // Lightning Bolt (a 5th-level Pact slot: 10d6) down a Line at the foe with two or more foes in it
  // and none of his own, when it holds at least as many as a Fireball would
  if aggr >= 2 && c.slots[5] > 0 && rs_feet_to(b, i, foe) <= 100 {
    ln: [2] int;
    rt_line(b, i, b[0].c[foe].x, b[0].c[foe].y, ln[..]);
    m := e5rd_burst(r, i, n[..]);
    if ln[0] >= 2 && ln[1] == 0 && ln[0] + 1 >= n[0] && rs_cast(b, i, SP_LIGHTNING_BOLT, 5, b[0].c[foe].x, b[0].c[foe].y, -1) {
      o: [2] f32;
      rt_line_end(r[0].beasts[q].x, r[0].beasts[q].z, e5rd_mx(r, foe), e5rd_mz(r, foe), f32(RT_LINE_M), o[..]);
      e5rd_cast(r, q, RT_K_LIGHTNING, -1, o[0], o[1]);
      return;
    }
  }
  // Fireball (a 5th-level Pact slot) at three or more together
  if aggr >= 2 && c.slots[5] > 0 {
    m := e5rd_burst(r, i, n[..]);
    if m >= 0 && n[0] >= 3 && rs_cast(b, i, SP_FIREBALL, 5, b[0].c[m].x, b[0].c[m].y, -1) { e5rd_cast(r, q, E5RD_K_FIREBALL, -1, e5rd_mx(r, m), e5rd_mz(r, m)); return; }
  }
  // Blight on the foe within 30 feet
  if c.slots[5] > 1 && rs_feet_to(b, i, foe) <= 30 {
    if rs_cast(b, i, SP_BLIGHT, 5, 0, 0, foe) { e5rd_cast(r, q, E5RD_K_BLIGHT, foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); return; }
  }
  if rs_cast(b, i, SP_ELDRITCH_BLAST, 0, 0, 0, foe) { e5rd_cast(r, q, E5RD_K_BLAST, foe, e5rd_mx(r, foe), e5rd_mz(r, foe)); }
}

// Each dt seconds: every raid creature moves (everglade5e-room-rules.coax e5rr_step), the way
// e5b_step moves a Wolf: to its foe, else where its squad's orders put it (rt_order), the leader
// behind his lines (rt_command); each the way round the spawn (rt_route), pushed off its neighbours
// (rt_separate).
E5RD_PUSH :: 0.6;   // how hard neighbours push, against a step's length
E5RD_LEASH :: 6.0;  // m: in the standing siege, the farthest one goes past the front after a foe
e5rd_step :: (r: [] E5rRoom, dt: f32) {
  b := r[0].b[..];
  w := r[0].raid[..];
  w[0].up = e5rd_standing(r) + (ifx w[0].arch >= 0 then 1 else 0);
  e5rd_rebukes(r);
  e5rd_hero_step(r);   // Echo's cast on (#12996)
  // where everyone stands, and the middle of the lines
  lx: f32 = 0; lz: f32 = 0; ln := 0;
  for q: 0..<E5RR_BEASTS {
    bt := r[0].beasts[q];
    on := e5rd_is(bt) && !b[0].c[E5RR_BEAST0 + q].dead;
    w[0].on[q] = on; w[0].xs[q] = bt.x; w[0].zs[q] = bt.z;
    if on && bt.form != E5RR_FORM_WARD && !w[0].slot[q].town && w[0].slot[q].role != RT_LEAD && w[0].slot[q].stage != E5RD_FLEE { lx += bt.x; lz += bt.z; ln += 1; }
  }
  if ln > 0 { lx /= f32(ln); lz /= f32(ln); }
  o: [5] f32;
  for q: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[q]) { continue; }
    bt := r[0].beasts[q..<q + 1];
    sl := w[0].slot[q..<q + 1];
    i := E5RR_BEAST0 + q;
    bt[0].moving = false;
    if bt[0].form == E5RR_FORM_WARD || b[0].c[i].dead { continue; }
    // Echo holds where she stands while her bar runs, facing her aim (#12996)
    if w[0].hero.on && q == w[0].hero.q { bt[0].yaw = e5rr_heading(w[0].hero.x - bt[0].x, w[0].hero.z - bt[0].z); continue; }
    sl[0].g = rt_with_house(w[0].house, rt_with_holes(w[0].holes[..], sl[0].g));   // its wall and the stables as the town has them now
    foe := bt[0].foe;
    if foe >= 0 && !e5rd_up(r, foe) { foe = -1; bt[0].foe = -1; }
    tx := bt[0].x; tz := bt[0].z; stop: f32 = 0.3;
    arch := sl[0].role == RT_LEAD;
    if sl[0].stage == E5RD_FLEE {
      tx = sl[0].hx; tz = sl[0].hz;
      ddx := tx - bt[0].x; ddz := tz - bt[0].z;
      if ddx * ddx + ddz * ddz <= E5RD_HOME * E5RD_HOME { e5b_gone(b, r[0].beasts[..], E5RR_BEAST0, q); continue; }
    } else if arch && sl[0].front {
      // the standing siege's Darian: behind his lines at the camp (#12860)
      rf_post(RF_CULT, true, true, bt[0].id, w[0].front_z, o[..]); tx = o[0]; tz = o[1];
      stop = 1.0;
    } else if arch {
      if ln > 0 { rt_command(lx, lz, ln, sl[0].hx, sl[0].hz, o[..]); tx = o[0]; tz = o[1]; } else { tx = sl[0].sx; tz = sl[0].sz; }
      stop = 1.0;
    } else if sl[0].role == RT_GUARD && w[0].arch >= 0 && (foe < 0 || sl[0].npc == RS_NPC_WARLOCK) {
      // Darian's guard: about him, each at its own place round him
      rt_guard_pos(bt[0].id, r[0].beasts[w[0].arch].x, r[0].beasts[w[0].arch].z, o[..]); tx = o[0]; tz = o[1];
      stop = 0.6;
    } else if foe >= 0 {
      tx = e5rd_mx(r, foe); tz = e5rd_mz(r, foe);
      stop = ifx rt_ranged(sl[0].role) || sl[0].npc == RS_NPC_WARLOCK then f32(RT_KEEP) else f32(E5RR_REACH) * 0.6;
    } else if sl[0].front {
      // the standing siege: its post about the front (#12860)
      side := ifx sl[0].town then RF_TOWN else RF_CULT;
      rf_post(side, rt_ranged(sl[0].role) || sl[0].npc == RS_NPC_WARLOCK, false, bt[0].id, w[0].front_z, o[..]); tx = o[0]; tz = o[1];
    } else {
      s := sl[0].squad % RT_SQUADS;
      rt_order(sl[0].g, sl[0].squad, sl[0].k, sl[0].role, w[0].sq_v[s], e5rd_going(r, q), bt[0].x, bt[0].z, sl[0].sx, sl[0].sz, o[..]);
      tx = o[0]; tz = o[1];
    }
    // its bounds (#12771): it holds between them (to cast, buff or strike) and moves in them; at its
    // goal a bound takes it a step or two about, so a line holding its ground still stirs
    bound: [1] f32;
    gx := tx - bt[0].x; gz := tz - bt[0].z;
    near_goal := gx * gx + gz * gz < 3.6 * 3.6;   // at its goal (its bounds' steps about it): it holds there, by bounds
    // on its way with nothing to cast at nor strike, it keeps going: it holds where there is
    hold_here := foe >= 0 || near_goal || (sl[0].role == RT_SKIRM && e5rd_going(r, q));
    rolling := sl[0].stage == E5RD_FLEE || arch || !hold_here || rt_bound(bt[0].id, sl[0].role, b[0].clock, bound[..]);
    at_hand := foe >= 0 && sl[0].role == RT_SKIRM;
    keeping := foe >= 0 && sl[0].role != RT_SKIRM && !arch && sl[0].stage != E5RD_FLEE && stop > 2;
    kx := bt[0].x - tx; kz := bt[0].z - tz; kd := sqrt(kx * kx + kz * kz);
    too_close := keeping && kd < stop - 3;   // it steps back to its distance, bound or not
    if !rolling && !at_hand && !too_close { tx = bt[0].x; tz = bt[0].z; }
    else if keeping && kd < stop + 6 {
      // at its distance from its foe, each bound takes it to a new place round the foe, that far off
      if kd < 0.01 { kx = 0; kz = -1; kd = 1; }
      ux := kx / kd; uz := kz / kd;
      if sl[0].bn != bound[0] + 1 {
        // a new bound: a few metres round its foe, this way or that, from where it stands
        sl[0].bn = bound[0] + 1;
        h := rt_hash(bt[0].id * 64 + int(bound[0]) % 64, 18);
        a := (ifx h < 0.5 then -1.0f32 else 1.0f32) * (0.3 + 0.8 * (h - floor(h * 2) * 0.5) * 2 * 0.5);
        sl[0].bax = ux * cos(a) - uz * sin(a); sl[0].baz = ux * sin(a) + uz * cos(a);
      }
      rr := stop + (rt_hash(bt[0].id * 64 + int(bound[0]) % 64, 19) * 2 - 1) * 3.0;
      vx := sl[0].bax; vz := sl[0].baz;
      if too_close && !rolling { vx = ux; vz = uz; rr = stop; }
      tx = tx + vx * rr; tz = tz + vz * rr; stop = 0.3;
    }
    else if !arch && sl[0].stage != E5RD_FLEE && foe < 0 && sl[0].role != RT_GUARD {
      if near_goal { rt_shuffle(bt[0].id, bound[0], tx, tz, o[..]); tx = o[0]; tz = o[1]; }
    }
    // the standing siege: never far past the front, the cult never in the town (#12860)
    if sl[0].front && sl[0].stage != E5RD_FLEE && !arch {
      if sl[0].town { tz = rt_hi(tz, w[0].front_z - f32(E5RD_LEASH)); }
      else { tz = rt_lo(rt_lo(tz, w[0].front_z + f32(E5RD_LEASH)), f32(RF_HOLD_Z) + 2); }
    }
    // round the spawn (one fleeing goes home by the way it came)
    if sl[0].stage != E5RD_FLEE { rt_around(sl[0].g, bt[0].x, bt[0].z, tx, tz, f32(E5RD_SPAWN_X), f32(E5RD_SPAWN_Z), f32(RT_SPAWN_R), o[..]); tx = o[0]; tz = o[1]; }
    // round the town's walls and buildings, in by a gate or a breach (rt_way): it stops `stop`
    // short of its goal, not of a corner on the way
    dx := tx - bt[0].x; dz := tz - bt[0].z;
    d := sqrt(dx * dx + dz * dz);
    rt_way(sl[0].g, bt[0].x, bt[0].z, tx, tz, f32(E5RD_SPAWN_X), f32(E5RD_SPAWN_Z), f32(RT_SPAWN_R), o[..]);
    wx := o[0] - bt[0].x; wz := o[1] - bt[0].z;
    wd := sqrt(wx * wx + wz * wz);
    step := f32(E5RR_RUN) * dt * f32(b[0].c[i].speed) / 40.0 * rt_pace(bt[0].id);   // its own pace
    mx: f32 = 0; mz: f32 = 0;
    left := ifx o[2] > 0.5 then wd - stop else wd;   // to the goal, `stop` short; to a corner, all the way
    if d > stop && left > 0 && wd > 0.001 { m := rt_lo(step, left); mx = wx / wd * m; mz = wz / wd * m; }
    rt_separate(bt[0].x, bt[0].z, q, w[0].xs[..], w[0].zs[..], w[0].on[..], E5RR_BEASTS, o[..]);
    mx += o[0] * step * f32(E5RD_PUSH); mz += o[1] * step * f32(E5RD_PUSH);
    mm := sqrt(mx * mx + mz * mz);
    if mm > step { mx = mx / mm * step; mz = mz / mm * step; mm = step; }
    rt_slide(sl[0].g, bt[0].x, bt[0].z, mx, mz, o[..]);
    mx = o[0] - bt[0].x; mz = o[1] - bt[0].z; mm = sqrt(mx * mx + mz * mz);
    bt[0].x = o[0]; bt[0].z = o[1];
    bt[0].moving = mm > step * 0.3;   // walking, not a nudge off a neighbour (#12771)
    if mm > 0.01 { bt[0].yaw = e5rr_heading(mx, mz); }
    // one at its foe faces it
    if foe >= 0 { bt[0].yaw = e5rr_heading(e5rd_mx(r, foe) - bt[0].x, e5rd_mz(r, foe) - bt[0].z); }
    b[0].c[i].x = e5r_sq(bt[0].x); b[0].c[i].y = e5r_sq(bt[0].z);
    w[0].xs[q] = bt[0].x; w[0].zs[q] = bt[0].z;
  }
}

// ---- checks

e5rd_test_room :: (r: [] E5rRoom) {
  e5rr_start(r, 11);
  e5rr_test_people(r);
}

#test "room raid: raiders march in by their gate, set on a player near them and strike; the fallen are queued" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  e5rr_join(r[..], 0, 0, -30);
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 0, support = 0, guard = 0};   // all skirmishers
  // three Cultists who skirmish, 20 m south of the player, by an open way
  // 5 m on, to the square
  for n: 0..<3 { #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, 3 * (n + 1), f32(n) * 2.5 - 2.5, -50, rt_open(0, -45, 0, -1), 0, n, 0, 0) > 0; }
  #assert e5rd_standing(r[..]) == 3 && e5rd_wards(r[..]) == 0;
  // they take the places from the top
  #assert e5rd_is(r[0].beasts[E5RR_BEASTS - 1]) && !e5rd_is(r[0].beasts[0]);
  hp := r[0].b[0].c[E5RR_SEAT].hp;
  t: f32 = 0;
  for f: 0..<200 { t += 0.05; e5rr_step(r[..], t); }
  // they came to the player and hit them (the player is unhurt only on misses: some hit in 10 s)
  near := 0;
  for q: 0..<E5RR_BEASTS { bt := r[0].beasts[q]; if e5rd_is(bt) && abs(bt.z + 30) < 3 { near += 1; } }
  #assert near == 3;
  #assert r[0].b[0].c[E5RR_SEAT].hp < hp;
  // the player's Thunderbolt-free kill: drop one to 0, and it is queued as fallen and goes
  q0 := E5RR_BEASTS - 1;
  tag := r[0].beasts[q0].tag;
  rs_damage(r[0].b[..], E5RR_SEAT, E5RR_BEAST0 + q0, 50, RS_FORCE, false, -1);
  t += 0.05; e5rr_step(r[..], t);
  #assert r[0].beasts[q0].id == 0 && r[0].raid[0].down_n == 1 && r[0].raid[0].downs[0].tag == tag && r[0].raid[0].downs[0].npc == RS_NPC_CULTIST;
  #assert e5rd_standing(r[..]) == 2;
  // fled home, they are gone; nothing more is queued as fallen
  e5rd_flee(r[..]);
  #assert e5rd_standing(r[..]) == 0;
  for f: 0..<200 { t += 0.05; e5rr_step(r[..], t); }
  left := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { left += 1; } }
  #assert left == 0 && r[0].raid[0].down_n == 1;
}

#test "room raid: a Warlock keeps its distance and blasts; the leader can't be hurt while a ward stands, never drops, and withdraws" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  e5rr_join(r[..], 0, 0, -30);
  r[0].raid[0].mix = RtMix.{skirm = 0, casters = 1, support = 0, guard = 0};   // a caster
  #assert e5rd_raider(r[..], RS_NPC_WARLOCK, 2, 1, 0, -60, rt_open(0, -55, 0, -1), 0, 0, 0, 0) > 0;
  t: f32 = 0;
  for f: 0..<160 { t += 0.05; e5rr_step(r[..], t); }

  w := -1;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { w = q; } }
  d := abs(r[0].beasts[w].z + 30);
  #assert w >= 0;
  #assert r[0].beasts[w].foe == E5RR_SEAT;
  #assert d > 15;
  #assert d < 25;
  blasts := 0; hexes := 0;
  for c: 0..<r[0].raid[0].cast_n {
    k := r[0].raid[0].casts[c].k;
    if k == E5RD_K_BLAST && r[0].raid[0].casts[c].to == E5RR_SEAT { blasts += 1; }
    // its one Concentration spell on the player: Hex, Bane or Ray of Enfeeblement (#12771)
    if (k == RT_K_HEX || k == RT_K_BANE || k == RT_K_ENFEEBLE) && r[0].raid[0].casts[c].to == E5RR_SEAT { hexes += 1; }
  }
  #assert blasts > 0 && hexes == 1;   // a curse once (its Concentration holds), then Eldritch Blast
  e5rd_clear(r[..]);
  #assert e5rd_standing(r[..]) == 0;
  // the leader behind a stone: a hit of 500 does nothing
  #assert e5rd_ward(r[..], 10, -40) > 0 && e5rd_wards(r[..]) == 1;
  #assert e5rd_arch(r[..], 0, -70, 0, -56, 0, -14) > 0;
  hp: [2] int;
  #assert e5rd_arch_hp(r[..], hp[..]) && hp[0] == hp[1];
  a := E5RR_BEAST0 + r[0].raid[0].arch;
  rs_damage(r[0].b[..], E5RR_SEAT, a, 500, RS_FORCE, false, -1);
  #assert e5rd_arch_hp(r[..], hp[..]) && hp[0] == hp[1];
  // the stone broken (60 Hit Points), he is exposed: a hit of 500 leaves him at half, standing
  ws := -1;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) && r[0].beasts[q].form == E5RR_FORM_WARD { ws = q; } }
  rs_damage(r[0].b[..], E5RR_SEAT, E5RR_BEAST0 + ws, 60, RS_FORCE, false, -1);
  t += 0.05; e5rr_step(r[..], t);
  #assert e5rd_wards(r[..]) == 0 && r[0].raid[0].down_n == 1;
  e5rd_expose(r[..]);
  rs_damage(r[0].b[..], E5RR_SEAT, a, 500, RS_FORCE, false, -1);
  #assert e5rd_arch_hp(r[..], hp[..]) && hp[0] == hp[1] / 2 && !r[0].b[0].c[a].dead;
  t += 0.05; e5rr_step(r[..], t);
  #assert e5rd_arch_hp(r[..], hp[..]);
  // he withdraws: gone, never among the fallen
  #assert e5rd_withdraw(r[..]) > 0 && !e5rd_arch_hp(r[..], hp[..]) && r[0].raid[0].down_n == 1;
}

#test "room raid: the watch fights: a Guard with its Spear strikes a raider at hand and throws at one in reach; a commoner doesn't" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  // the test town's two Guards stand 3 m east of the origin: armed with their stat block's Spear
  g0 := E5RR_FOLK0;
  #assert r[0].b[0].c[g0].weapon == W_SPEAR && r[0].b[0].c[g0 + 2].weapon == W_UNARMED;
  // no raid: the watch's turn does nothing
  t: f32 = 0;
  for f: 0..<60 { t += 0.05; e5rr_step(r[..], t); }
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 0, support = 0, guard = 0};   // skirmishers
  // two Cultists come at them from 10 m off (nobody else to set on); one stands back 5 m off, in a throw's reach
  #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, 3, 13, 0, rt_open(10, 0, 1, 0), 0, 0, 10, 0) > 0;
  far := e5rd_raider(r[..], RS_NPC_CULTIST, 1, 6, 9, 1.6, rt_open(9, 1.6, 1, 0), 0, 1, 9, 1.6);
  #assert far > 0;
  hurt := 0;
  for f: 0..<400 {
    t += 0.05; e5rr_step(r[..], t);
    for q: 0..<E5RR_BEASTS {
      bt := r[0].beasts[q];
      if e5rd_is(bt) && r[0].b[0].c[E5RR_BEAST0 + q].hp < r[0].b[0].c[E5RR_BEAST0 + q].hp_max { hurt = hurt | (1 << (ifx bt.tag == far then 1 else 0)); }
    }
    if r[0].raid[0].down_n > 0 { hurt = hurt | 4; }
  }
  #assert (hurt & 3) != 0;
  #assert r[0].raid[0].up >= 0;
}

#test "room raid: a squad's casters mix their spells: Fire Bolt and Ray of Frost from the Cultists, each the engine's" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  e5rr_join(r[..], 0, 0, -40);
  for k: 0..<8 { #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, k + 1, (f32(k) - 3.5) * 2, -62, rt_open(0, -55, 0, -1), 0, k, 0, 0) > 0; }
  t: f32 = 0; kinds := 0; at_you := 0;
  for f: 0..<200 {
    t += 0.05; e5rr_step(r[..], t);
    for c: 0..<r[0].raid[0].cast_n { cs := r[0].raid[0].casts[c]; if cs.to == E5RR_SEAT { kinds = kinds | (1 << cs.k); at_you += 1; } }
    r[0].raid[0].cast_n = 0;
  }
  #assert at_you > 4 && (kinds & (1 << RT_K_FIRE_BOLT)) != 0 && (kinds & (1 << RT_K_FROST)) != 0 && (kinds & (1 << RT_K_BLAST)) == 0;
}

#test "room raid: a squad lays siege by the shared tactics: volleys at a tower and a breach, then in, spread, clear of the spawn; Darian stays back and doors away" #steps 16000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 2, support = 0, guard = 0};   // skirmishers and casters
  // a squad of 8 Cultists 40 m out
  for k: 0..<8 {
    p: [2] f32; rt_ring(k, 0, 0, 3, 12, p[..]);
    #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, k + 1, (f32(k) - 3.5) * 1.5, -100, south, 0, k, p[0], p[1]) > 0;
  }
  t: f32 = 0;
  towers := 0; walls := 0; together := 0; most_on_spawn: f32 = 1000; kinds := 0; house := 0;
  for f: 0..<1400 {
    t += 0.05; e5rr_step(r[..], t);
    // the casts this tick: at the wall (to -1), a tower's middle (x 4.5 off) or the breach (x 12 to 17 off)
    n := r[0].raid[0].cast_n;
    for c: 0..<n {
      cs := r[0].raid[0].casts[c];
      if cs.to >= 0 { kinds = kinds | (1 << cs.k); continue; }   // in the town, at the watch
      if rt_house_has(cs.ax, cs.az) && cs.az < -60 { house += 1; continue; }   // at the stables (#12769)
      #assert abs(cs.az + 56) < 0.01;
      if abs(abs(cs.ax) - 4.5) < 0.01 { towers += 1; } else { #assert abs(cs.ax) > 12 && abs(cs.ax) < 17; walls += 1; }
    }
    if n >= 2 { together += 1; }
    r[0].raid[0].cast_n = 0;
    for q: 0..<E5RR_BEASTS {
      bt := r[0].beasts[q];
      if !e5rd_is(bt) { continue; }
      dx := bt.x - f32(E5RD_SPAWN_X); dz := bt.z - f32(E5RD_SPAWN_Z);
      most_on_spawn = lo_r(most_on_spawn, sqrt(dx * dx + dz * dz));
    }
  }
  // the casters fired together, at both the tower and the breach, and the squad's siege is done
  #assert towers > 0 && walls > 0 && together > 0 && r[0].raid[0].sq_v[0] >= RT_SIEGE_VOLLEYS;
  // and one of them at the stables, which took it
  #assert house > 0 && r[0].raid[0].house > 0;
  // all of them in the town now but the stables' burner while they stand, none on another, and none
  // ever came near the spawn
  #assert most_on_spawn >= f32(RT_SPAWN_R) - 0.5;
  for a: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[a]) { continue; }
    burning := rt_house_burner(r[0].raid[0].slot[a].g, r[0].raid[0].slot[a].k);
    #assert r[0].beasts[a].z > -56 || burning;
    for b: a + 1..<E5RR_BEASTS {
      if !e5rd_is(r[0].beasts[b]) { continue; }
      dx := r[0].beasts[a].x - r[0].beasts[b].x; dz := r[0].beasts[a].z - r[0].beasts[b].z;
      #assert dx * dx + dz * dz > 0.6 * 0.6;
    }
  }
  // Darian comes by the gate and holds behind his lines; a player at his side, he doors away
  #assert e5rd_arch(r[..], 30, -76, 0, -56, 0, -46) > 0;
  for f: 0..<200 { t += 0.05; e5rr_step(r[..], t); }
  q := r[0].raid[0].arch;
  ax := r[0].beasts[q].x; az := r[0].beasts[q].z;
  // RT_BACK behind the middle of his lines (or where he came from, if that is nearer)
  lx: f32 = 0; lz: f32 = 0; ln := 0;
  for a: 0..<E5RR_BEASTS { bt := r[0].beasts[a]; if e5rd_is(bt) && a != q { lx += bt.x; lz += bt.z; ln += 1; } }
  #assert ln > 0;
  lx /= f32(ln); lz /= f32(ln);
  back := sqrt((ax - lx) * (ax - lx) + (az - lz) * (az - lz));
  #assert back > f32(RT_BACK) - 3;
  #assert az < lz;
  e5rr_join(r[..], 0, ax + 3, az);
  doors := 0; dx: f32 = 0; dz: f32 = 0;
  for f: 0..<80 {
    r[0].raid[0].cast_n = 0;
    t += 0.05; e5rr_step(r[..], t);
    for c: 0..<r[0].raid[0].cast_n {
      if r[0].raid[0].casts[c].k != E5RD_K_DOOR { continue; }
      if doors == 0 { dx = r[0].beasts[q].x - ax; dz = r[0].beasts[q].z - az; }
      doors += 1;
    }
  }
  #assert doors >= 1 && dx * dx + dz * dz > 20 * 20;
}

#test "room raid: squads at every gate and the bridge go round the walls, towers, buildings and trees, through the wall only by a gate or where the town's wall is broken, and home again (#12747)" #steps 30000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  // a squad of 8 Cultists 20 m out of each way in (room-events.coax ev_way, ev_gate): an even squad
  // goes in by its gate, an odd one by its breach where it is broken, the bridge's straight on
  ways: [5] RtGate;
  ways[0] = rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  ways[1] = rt_gate(44, 60, 5, false, -64, 64, 0, 0);
  ways[2] = rt_gate(-64, 0, 5, true, -56, 60, 0, 0);
  ways[3] = rt_gate(64, 0, 5, true, -56, 60, 0, 0);
  ways[4] = rt_open(84, -18, 0.524, 0.852);
  from := [10] f32.[0, -76,   55.8, 76.1,   -84, 0,   84, 0,   98.3, 5.2];
  for s: 0..<5 {
    for k: 0..<8 {
      p: [2] f32; rt_ring(s * 8 + k, 0, 0, 3, 15, p[..]);
      g := ways[s];
      side := f32(k) - 3.5;
      #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, s * 8 + k + 1, from[s * 2] + g.ax * side * 1.4, from[s * 2 + 1] + g.az * side * 1.4, g, s, k, p[0], p[1]) > 0;
    }
  }
  // the room's town breaks the North wall's posts at 56.6 to 59.4 m (the north squad's breach, 14 m
  // along from its gate), as the room's world tells it (rm_eg_piece); the West wall stands whole,
  // so the west squad (odd too) goes in by the West Gate
  posts: [64] f32; holes: [RT_TOWN_GATES * RT_BREACHES] int;
  np := rt_test_break(holes[..], posts[..], 0, 5, 56.6, 59.4);
  for q: 0..<np { e5rd_wall_broke(r[..], posts[q * 2], posts[q * 2 + 1]); }
  // Darian behind the south squad, by the South Gate
  #assert e5rd_arch(r[..], 30, -76, 0, -56, 0, -46) > 0;
  t: f32 = 0;
  clips := 0; by_gate := 0; by_breach := 0; elsewhere := 0;
  inside: [E5RR_BEASTS] bool;
  for q: 0..<E5RR_BEASTS { inside[q] = rt_inside(r[0].beasts[q].x, r[0].beasts[q].z); }
  for f: 0..<2600 {
    t += 0.05; e5rr_step(r[..], t);
    if f == 1400 { e5rd_flee(r[..]); }   // then they flee home the way they came
    for q: 0..<E5RR_BEASTS {
      bt := r[0].beasts[q];
      if !e5rd_is(bt) || bt.form == E5RR_FORM_WARD { continue; }
      if rt_test_clips(bt.x, bt.z, posts[..], np) { clips += 1; }
      // through the palisade: by one of the four gates, or the North wall's broken posts
      now := rt_inside(bt.x, bt.z);
      if now != inside[q] {
        gate := false;
        for n: 0..<RT_TOWN_GATES {
          w := rt_town_gate(n);
          if abs((bt.x - w.x) * w.ax + (bt.z - w.z) * w.az) < w.w / 2 && abs((bt.x - w.x) * w.ox + (bt.z - w.z) * w.oz) < 1.5 { gate = true; }
        }
        if gate { by_gate += 1; } else if bt.x > 56.6 && bt.x < 59.4 && abs(bt.z - 60) < 1.5 { by_breach += 1; } else { elsewhere += 1; }
      }
      inside[q] = now;
    }
    if f == 1399 {
      // the squads got in: most of those standing are inside the palisade
      in := 0; on := 0;
      for q: 0..<E5RR_BEASTS {
        bt := r[0].beasts[q];
        if !e5rd_is(bt) || r[0].raid[0].slot[q].role == RT_LEAD || r[0].b[0].c[E5RR_BEAST0 + q].dead { continue; }
        on += 1;
        if rt_inside(bt.x, bt.z) { in += 1; }
      }
      #assert on > 0 && in * 10 >= on * 8;
    }
  }
  #assert clips == 0 && elsewhere == 0 && by_gate > 0 && by_breach > 0;
  // and home, all gone
  left := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { left += 1; } }
  #assert left == 0;
  // a rebuild shuts the breach
  e5rd_wall_whole(r[..]);
  #assert r[0].raid[0].holes[1 * RT_BREACHES + 1] == 0;
}

#test "room raid: the stables burn by stages and fall once, raiders go round them standing and over their rubble fallen, a rebuild stands them up; a squad charges a raider at a time (#12769)" #steps 30000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  for k: 0..<8 {
    p: [2] f32; rt_ring(k, 0, 0, 3, 12, p[..]);
    #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, k + 1, (f32(k) - 3.5) * 1.5, -100, south, 0, k, p[0], p[1]) > 0;
  }
  t: f32 = 0;
  posts: [2] f32;
  stage := RT_HOUSE_WHOLE; stages := 1; clips := 0; falls := 0;
  going: [E5RR_BEASTS] f32;
  for q: 0..<E5RR_BEASTS { going[q] = -1; }
  for f: 0..<1200 {
    t += 0.05; e5rr_step(r[..], t);
    r[0].raid[0].cast_n = 0;
    // the room's town breaks a piece of them now and then, as their bolts strike
    if f % 10 == 0 && f > 200 { e5rd_wall_broke(r[..], 14, -70); }
    now := e5rd_house_stage(r[..]);
    #assert now >= stage;   // by stages, never back
    if now != stage { stages = stages | (1 << now); stage = now; }
    if e5rd_house_falls(r[..]) { falls += 1; }
    for q: 0..<E5RR_BEASTS {
      bt := r[0].beasts[q];
      if !e5rd_is(bt) { continue; }
      // never in the stables while they stand (nor in a wall or another building), at any stage
      if rt_test_clips_in(bt.x, bt.z, posts[..], 0, now == RT_HOUSE_FALLEN) { clips += 1; }
      if going[q] < 0 && e5rd_going(r[..], q) { going[q] = t; }
    }
  }
  // whole, scorched, ablaze, fallen: each seen, the fall owed to the town once, nobody in them
  #assert stages == 15 && stage == RT_HOUSE_FALLEN && falls == 1 && clips == 0;
  #assert !e5rd_house_falls(r[..]);
  // fallen, they are no one's aim and a raider's way runs over them
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { #assert r[0].raid[0].slot[q].g.fallen; } }
  // the squad went in a raider at a time: their charges spread over most of RT_START_S
  first: f32 = 1000; last: f32 = -1; n := 0;
  for q: 0..<E5RR_BEASTS { if going[q] >= 0 { n += 1; first = lo_r(first, going[q]); last = hi_r(last, going[q]); } }
  #assert n == 8 && last - first > f32(RT_START_S) * 0.4;
  // a rebuild stands them up: whole, in the way again
  e5rd_wall_whole(r[..]);
  #assert e5rd_house_stage(r[..]) == RT_HOUSE_WHOLE && !e5rd_house_falls(r[..]);
  t += 0.05; e5rr_step(r[..], t);
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { #assert !r[0].raid[0].slot[q].g.fallen; } }
}

#test "room raid: Cult Priests bless the cult and command the player: the player halts, and the seat's conditions say so, with the spell and the time left (#12771)" #steps 8000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  e5rr_join(r[..], 0, 0, -36);
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 0, support = 2, guard = 0};
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  priests := 0;
  for k: 0..<8 {
    p: [2] f32; rt_ring(k, 0, -40, 3, 8, p[..]);
    #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, k + 1, (f32(k) - 3.5) * 1.5, -60, south, 0, k, p[0], p[1]) > 0;
  }
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) && r[0].raid[0].slot[q].npc == RS_NPC_CULT_PRIEST { priests += 1; #assert r[0].raid[0].slot[q].role == RT_SUPPORT; } }
  #assert priests >= 2;
  t: f32 = 0;
  out: [E5RR_OUT_FLOATS] f32;
  halted := 0; stuck := true; blessed := 0; looks := 0;
  for f: 0..<600 {
    t += 0.05; e5rr_step(r[..], t);
    for c: 0..<r[0].raid[0].cast_n { k := r[0].raid[0].casts[c].k; if k == RT_K_BLESS || k == RT_K_FAITH || k == RT_K_COMMAND || k == RT_K_SACRED { looks = looks | (1 << k); } }
    r[0].raid[0].cast_n = 0;
    for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) && (e5rr_effect_bits(r[0].b[..], E5RR_BEAST0 + q) & (E5RR_C_BLESSED | E5RR_C_FAITH)) != 0 { blessed += 1; } }
    e5rr_seat_out(r[..], 0, out[..]);
    c := cast(int) out[3];
    if (c & E5RR_C_HALTED) != 0 {
      halted += 1;
      // its status: Command, and under its 6 s (to the end of the player's next turn)
      #assert int(out[7]) == SP_COMMAND && out[6] > 0 && out[6] <= 12;
      if rs_can_act(r[0].b[0].c[E5RR_SEAT]) { stuck = false; }
    }
  }
  // Bless or Shield of Faith on the cult, Command on the player who halted and couldn't act
  #assert blessed > 0 && halted > 0 && stuck;
  #assert (looks & (1 << RT_K_COMMAND)) != 0 && ((looks & (1 << RT_K_BLESS)) != 0 || (looks & (1 << RT_K_FAITH)) != 0);
}

#test "room raid: the horde acts apart: at any moment some move and some hold to cast, its casts spread over the beat (#12771)" #steps 30000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  e5rr_join(r[..], 0, 0, -14);
  r[0].b[0].c[E5RR_SEAT].hp_max = 100000; r[0].b[0].c[E5RR_SEAT].hp = 100000;   // a player who stands the raid out
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  for k: 0..<24 {
    p: [2] f32; rt_ring(k, 0, 0, 3, 12, p[..]);
    npc := ifx k % 6 == 5 then RS_NPC_WARLOCK else ifx k % 6 == 4 then RS_NPC_FANATIC else RS_NPC_CULTIST;
    #assert e5rd_raider(r[..], npc, 1 + k % 4, k + 1, (f32(k % 8) - 3.5) * 1.5, -100 - f32(k / 8) * 3, south, k / 8, k % 8, p[0], p[1]) > 0;
  }
  t: f32 = 0;
  bins: [10] int; casts := 0; worst := 0; low_move := 100; low_hold := 100; sum_move := 0; samples := 0;
  beat := rs_beat(r[0].b[..]);
  for f: 0..<1400 {
    t += 0.05; e5rr_step(r[..], t);
    n := r[0].raid[0].cast_n;
    r[0].raid[0].cast_n = 0;
    if t < 24 { continue; }   // from the siege's end: the squads in the town, on the player
    casts += n; worst = rs_max(worst, n);
    ph := t / beat - floor(t / beat);
    bins[int(ph * 10) % 10] += n;
    if f % 20 != 0 { continue; }
    up := 0; moving := 0; holding := 0;
    for q: 0..<E5RR_BEASTS {
      bt := r[0].beasts[q];
      if !e5rd_is(bt) { continue; }
      up += 1;
      if bt.moving { moving += 1; }
      else if rt_ranged(r[0].raid[0].slot[q].role) { holding += 1; }
    }
    low_move = rs_min(low_move, moving * 100 / rs_max(up, 1)); sum_move += moving * 100 / rs_max(up, 1); samples += 1;
    low_hold = rs_min(low_hold, holding * 100 / rs_max(up, 1));
  }
  // always some moving, a sixth of them on the whole, and always a tenth holding to cast
  #assert low_move >= 5 && sum_move >= 15 * samples && low_hold >= 10;
  for k: 0..<10 { #assert bins[k] * 3 < casts; }
  #assert casts > 100 && worst * 20 < casts;
}

#test "room raid: a room's lone squad at the South Gate brings the stables down: its burner stays at them past the siege, then goes in (#12769)" #steps 16000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  south := rt_gate(0, -56, 6, false, -64, 64, 0, 0);
  // a mix with no casters: the burner is a caster all the same
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 0, support = 0, guard = 0};
  for k: 0..<8 {
    p: [2] f32; rt_ring(k, 0, 0, 3, 12, p[..]);
    #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, k + 1, (f32(k) - 3.5) * 1.5, -100, south, 0, k, p[0], p[1]) > 0;
  }
  // a player 20 m from the burner's place, in a caster's reach but not at hand: the stables come first
  for q: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[q]) || r[0].raid[0].slot[q].k != 3 { continue; }
    sl := r[0].raid[0].slot[q]; o: [2] f32;
    rt_siege_pos(sl.g, sl.squad, sl.k, sl.role, o[..]);
    e5rr_join(r[..], 0, o[0], o[1] + 20);
    r[0].b[0].c[E5RR_SEAT].hp_max = 100000; r[0].b[0].c[E5RR_SEAT].hp = 100000;
  }
  t: f32 = 0; fell_at: f32 = -1; falls := 0;
  for f: 0..<1200 {
    t += 0.05; e5rr_step(r[..], t);
    r[0].raid[0].cast_n = 0;
    if e5rd_house_falls(r[..]) { falls += 1; }
    if fell_at < 0 && e5rd_house_stage(r[..]) == RT_HOUSE_FALLEN { fell_at = t; }
  }
  // down well inside a wave, owed to the room's town once
  #assert fell_at > 0 && fell_at < 50 && falls == 1;
  // and its burner, the stables down, is no longer held at them
  for q: 0..<E5RR_BEASTS {
    if !e5rd_is(r[0].beasts[q]) || r[0].raid[0].slot[q].k != 3 { continue; }
    #assert r[0].raid[0].slot[q].role == RT_CASTER && !rt_house_burner(r[0].raid[0].slot[q].g, 3);
  }
}

#test "room raid: Darian razes the stables in his reach while no foe is at hand, a player shooting from farther off or not; with one at hand he fights it (#12769)" #steps 16000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  // Darian by the South Gate, the stables 20 m off; a player 20 m behind him
  #assert e5rd_arch(r[..], 0, -76, 0, -56, 0, -46) > 0;
  e5rr_join(r[..], 0, 0, -96);
  r[0].b[0].c[E5RR_SEAT].hp_max = 100000; r[0].b[0].c[E5RR_SEAT].hp = 100000;
  t: f32 = 0; at_house := 0;
  for f: 0..<600 {
    t += 0.05; e5rr_step(r[..], t);
    for c: 0..<r[0].raid[0].cast_n { cs := r[0].raid[0].casts[c]; if cs.to < 0 && rt_house_has(cs.ax, cs.az) { at_house += 1; } }
    r[0].raid[0].cast_n = 0;
  }
  #assert at_house > 0 && r[0].raid[0].house > 0;
  // fallen, he turns on the player
  for n: 0..<3 { e5rd_house_hurt(r[..], RT_HOUSE_HP); }
  #assert e5rd_house_stage(r[..]) == RT_HOUSE_FALLEN;
  before := r[0].raid[0].house; at_house = 0;
  for f: 0..<300 {
    t += 0.05; e5rr_step(r[..], t);
    for c: 0..<r[0].raid[0].cast_n { cs := r[0].raid[0].casts[c]; if cs.to < 0 && rt_house_has(cs.ax, cs.az) { at_house += 1; } }
    r[0].raid[0].cast_n = 0;
  }
  #assert at_house == 0 && r[0].raid[0].house == before;
}

#test "room raid: Echo fights for the watch: Meteor Swarm first where the cult stands together, the town's strike as her bar ends, the roll as it lands, never on the watch; she never drops (#12996)" #steps 16000000000 {
  r: [1] E5rRoom;
  e5rd_test_room(r[..]);
  r[0].raid[0].siege = true; r[0].raid[0].front_z = -64;
  r[0].raid[0].mix = RtMix.{skirm = 1, casters = 0, support = 0, guard = 0};
  at := [8] f32.[0, -70, 2, -71, -2, -69, 1, -68];
  for n: 0..<4 { #assert e5rd_raider(r[..], RS_NPC_CULTIST, 1, n + 1, at[n * 2], at[n * 2 + 1], rt_open(at[n * 2], at[n * 2 + 1], 0, 1), 0, n, at[n * 2], at[n * 2 + 1]) > 0; }
  for q0: 0..<E5RR_BEASTS { if e5rd_cult(r[0].beasts[q0]) { r[0].b[0].c[E5RR_BEAST0 + q0].speed = 0; } }   // they hold their line
  guard := e5rd_defender(r[..], RS_NPC_GUARD, 1, 1.5, -70.5, rt_open(1.5, -70.5, 0, -1));
  echo := e5rd_hero(r[..], 0, -40, rt_open(0, -40, 0, -1));
  #assert guard > 0 && echo > 0 && e5rd_hero(r[..], 0, -40, rt_open(0, -40, 0, -1)) == echo;   // once
  q := r[0].raid[0].hero.q;
  #assert q >= 0 && r[0].beasts[q].form == E5RR_FORM_HERO && e5rd_town(r[0].beasts[q]) && r[0].b[0].c[E5RR_BEAST0 + q].team == 1;
  ev: [256 * E5RR_EV_FLOATS] f32;
  _ := e5rr_events(r[..], ev[..]);
  t: f32 = 0; cue_t: f32 = -1; strike_t: f32 = -1; roll_t: f32 = -1; first_k := -1; cues := 0; saved_cult := 0; saved_watch := 0;
  for f: 0..<240 {
    t += 0.05; e5rr_step(r[..], t);
    w := r[0].raid[..];
    for c: 0..<w[0].cast_n {
      cc := w[0].casts[c];
      if cc.id != echo { continue; }
      if cc.cue { cues += 1; if cue_t < 0 { cue_t = t; first_k = cc.k; #assert !cc.harm && cc.slot < 0; } }
      else if strike_t < 0 { strike_t = t; #assert cc.harm && cc.slot == RT_HERO_METEOR && cc.k == RT_K_HERO0; }
    }
    w[0].cast_n = 0;   // the room drains them (room-events.coax ev_raid_flush)
    n := e5rr_events(r[..], ev[..]);
    for k: 0..<n {
      o := k * E5RR_EV_FLOATS;
      if ev[o] != f32(RS_EV_SAVE) || ev[o + 1] != f32(SP_EG_METEOR_SWARM) { continue; }
      if roll_t < 0 { roll_t = t; }
      if ev[o + 3] == f32(E5RR_TGT_BEAST + guard) { saved_watch += 1; } else { saved_cult += 1; }
    }
    #assert !r[0].b[0].c[E5RR_BEAST0 + q].dead && r[0].b[0].c[E5RR_BEAST0 + q].hp >= 1;
  }
  #assert first_k == RT_K_HERO0 + RT_HERO_METEOR && cue_t > 0 && cues >= 1;
  #assert abs(strike_t - cue_t - CR_BAR[RT_HERO_METEOR]) < 0.11 && abs(roll_t - cue_t - 3.6) < 0.11;
  #assert r[0].raid[0].hero.rolled >= 1;
  #assert saved_watch == 0;
  #assert saved_cult >= 3;
  // a blow far past her Hit Points leaves her at one
  e5rr_hurt(r[..], E5RR_TGT_BEAST + echo, 1000, -1);
  #assert r[0].b[0].c[E5RR_BEAST0 + q].hp == 1 && !r[0].b[0].c[E5RR_BEAST0 + q].dead;
  e5rd_clear(r[..]);
  #assert r[0].raid[0].hero.q < 0 && !e5rd_is(r[0].beasts[q]);
}
