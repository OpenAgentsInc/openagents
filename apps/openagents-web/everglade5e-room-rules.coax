// Everglade 5E's rules for a shared room (spec docs/verse/2026-11-03-everglade-multiplayer-spec.md,
// sections 3.1 and 6): the room server's one SRD 5e battle for up to 16 players. Each seat is its
// own creature (E5RR_SEAT + seat, Everglade's caster: fb_everglade_hero), with its own turn (an
// FbSeat) and the realm's bar; Everglade's people are the creatures after the seats, as in
// everglade5e-rules.coax, whose helpers and constants this file reuses. The page's own single-
// caster unit stays as it is (everglade5e-face.c calls it); the room server links this one.
// Players are one team, so lasting areas never hurt them; a damaging cast never touches another
// player (PvP is off: the other seats step out of the battle for its roll), while a heal does.
// Lasting areas (Moonbeam, Black Tentacles, Wall of Thorns, ...) are the room's zones, E5RR_ZONES of
// them, in chunks of FB_ZONES for fivebar.coax's zone code.
// What a spell summons is a creature of the battle with its stat block (E5RR_BEASTS of them, after
// the people): Conjure Animals brings E5RR_PACK Wolves (SRD 5.2.1 p. 373), which the room runs on its
// tick: they run to where their caster points and bite the person they are set on, every player can
// hurt them, and they go when they drop to 0 Hit Points or their caster's Concentration ends. (The
// SRD's own Conjure Animals is an intangible pack, a zone; the room makes it beasts that can be
// fought, by the owner's call.)
//   coax test --library apps/openagents-web/everglade5e-room-rules.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "everglade5e-rules.coax";
#load "../../aethyr/rules/srd/press-budget.coax";
#load "everglade-raid-tactics.coax";   // how the cult fights a siege
#load "everglade-raid-spells.coax";    // what the cult casts (#12747)
#load "everglade-raid-front.coax";     // the standing siege's front (#12860)
#load "everglade5e-room-raid.coax";   // the Cultist Raid's raiders, ward stones and leader (#12740)
#load "everglade-raid-scale.coax";   // the raid's waves for the players present (room-events.coax, the EVENTS pane)
#load "../../aethyr/forge/npc-document.coax";
#load "../../aethyr/session/outcome-slot.coax";
#load "../../aethyr/session/effect-reservation.coax";
#load "everglade5e-forge.coax";

E5RR_SEATS :: 16;
E5RR_SEAT :: 0;                              // seat s is creature s
E5RR_FOLK0 :: E5RR_SEATS;                    // Everglade's person j is creature E5RR_FOLK0 + j
E5RR_ZONES :: 32;                            // a multiple of FB_ZONES
E5RR_EV_FLOATS :: 8;                         // kind, spell, by, to, amount, damage, x, z (metres)
// who an event names, as the room's frames do (spec 3.6 TGT): a seat 1000 + s, a person their index,
// a summoned creature 2000 + its id
E5RR_TGT_SEAT :: 1000;
E5RR_TGT_BEAST :: 2000;
E5RR_BEASTS :: 96;                           // summoned creatures at once: the players' and a raid's (E5RD_MAX of them)
E5RR_BEAST0 :: E5RR_FOLK0 + E5R_FOLK;        // summoned creature q is creature E5RR_BEAST0 + q
E5RR_SCENT :: 3.048;                         // m: a pack sets on whoever is within 10 feet of where it is sent
// The beasts themselves (E5rBeast, their forms, runs, bites and slams) are everglade5e-beasts.coax's,
// the page's own battle's too, so a Zombie offline is the room's Zombie.

E5RR_E2_Z_SHIFT :: 352;   // add squares south of the old origin, through the -640 m terrain edge
E5rRoom :: struct {
  b: [1] RsBattle;
  z_shift: int;
  seat: [E5RR_SEATS] FbSeat;
  live: [E5RR_SEATS] bool;
  familiar: [E5RR_SEATS] FbSeat;
  familiar_ready: bool;
  zones: [E5RR_ZONES] FbZone;
  zone_id: [E5RR_ZONES] int;                 // each zone's id while on (0 off); ids count up from 1
  zone_slot: [E5RR_ZONES] int;               // the bar slot that made it
  next_id: int;
  bar: [FB_EG_SLOTS] FbAb;
  wbar: [FB_WL_SLOTS] FbAb;                  // the Warlock's bar: slots FB_WL0 + k
  cbar: [FB_CL_N] FbAb;                      // Character Create's classes' abilities: slots FB_CL0 + class
  klass: [E5RR_SEATS] int;                   // each seat's class: 0 the druid, 1 the Warlock, E5R_CL0 + a Character Create class
  last_foe: [E5RR_SEATS] int;                // the person each seat last aimed harm at (-1 none): its Zombies go for them
  block: [E5R_FOLK] int;
  folk_x: [E5R_FOLK] f32; folk_z: [E5R_FOLK] f32;   // where each person stands (metres)
  beasts: [E5RR_BEASTS] E5rBeast;
  seen: int;
  started: bool;
  raid: [1] E5rdRaid;                        // the Cultist Raid's (everglade5e-room-raid.coax)
  pvp: bool;                                 // the realm's pvp row (oa-room room-control.coax): harm reaches other players too
  // each seat's blocked pairs, one bit a seat, both ways (oa-room room-blocks.coax, #12789): neither
  // targets, harms nor heals the other, so a body withheld from you can't fight you unseen
  apart: [E5RR_SEATS] int;
}

e5rr_folk :: (j: int) -> int { return E5RR_FOLK0 + j; }
// A creature's TGT code (spec 3.6), -1 for none.
e5rr_tgt :: (i: int) -> int {
  if i >= E5RR_SEAT && i < E5RR_SEAT + E5RR_SEATS { return E5RR_TGT_SEAT + i - E5RR_SEAT; }
  if i >= E5RR_FOLK0 && i < E5RR_FOLK0 + E5R_FOLK { return i - E5RR_FOLK0; }
  return -1;
}
// The same, in a room: a summoned creature is 2000 + its id.
e5rr_tgt_in :: (r: [] E5rRoom, i: int) -> int {
  if i >= E5RR_BEAST0 && i < E5RR_BEAST0 + E5RR_BEASTS { t := r[0].beasts[i - E5RR_BEAST0].tag; return ifx t > 0 then E5RR_TGT_BEAST + t else -1; }
  return e5rr_tgt(i);
}
// The summoned creature a TGT code names, -1 for none.
e5rr_beast_of_tgt :: (r: [] E5rRoom, t: int) -> int {
  if t <= E5RR_TGT_BEAST { return -1; }
  for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id == t - E5RR_TGT_BEAST { return E5RR_BEAST0 + q; } }
  return -1;
}
// The creature a TGT code names, -1 for none.
e5rr_of_tgt :: (t: int) -> int {
  if t >= E5RR_TGT_SEAT && t < E5RR_TGT_SEAT + E5RR_SEATS { return E5RR_SEAT + t - E5RR_TGT_SEAT; }
  if t >= 0 && t < E5R_FOLK { return E5RR_FOLK0 + t; }
  return -1;
}

e5rr_z_cell :: (r:[]E5rRoom,z:f32)->int { return e5r_sq(z)+r[0].z_shift; }
e5rr_cell_z :: (r:[]E5rRoom,y:int)->f32 { return e5rr_cell_m(y-r[0].z_shift); }
e5rr_cell_m :: (q:int)->f32 { return f32(E5R_X0)+(f32(q)+0.5)*f32(E5R_SQ); }

e5rr_start :: (r: [] E5rRoom, seed: int) #export_c #effects(reads,writes,traps) {
  b := r[0].b[..];
  r[0].z_shift=0;
  b[0].n = 0; b[0].clock = 0; b[0].who = -1; b[0].w = E5R_SIDE; b[0].h = E5R_SIDE;
  world_selected := rs_set_world(b,RS_EVERGLADE_WORLD);   // every declared deviation: world-profile.coax
  for k: 0..<RS_ZONES { b[0].zone[k].on = false; }
  b[0].truth_zones=0;
  b[0].dice[0].state = cast(u64) seed * 7919 + 3;
  for s: 0..<E5RR_SEATS {
    o := fb_everglade_hero("Player", 0);
    o.hp = 0; o.dead = true;
    _ := rs_add(b, o, E5R_AWAY, E5R_AWAY);
    r[0].live[s] = false;
  }
  for j: 0..<E5R_FOLK {
    _ := rs_add(b, fb_folk("Commoner", 1, 10, 4, e5r_scores(0)), E5R_AWAY, E5R_AWAY);
    r[0].block[j] = -1;
  }
  for q: 0..<E5RR_BEASTS {
    o := e5rr_wolf();
    o.hp = 0; o.dead = true;
    _ := rs_add(b, o, E5R_AWAY, E5R_AWAY);
    r[0].beasts[q] = E5rBeast.{};
  }
  rs_begin(b);
  for s: 0..<E5RR_SEATS { r[0].seat[s] = FbSeat.{me = E5RR_SEAT + s}; }
  for q: 0..<E5RR_ZONES { r[0].zones[q].on = false; r[0].zone_id[q] = 0; }
  r[0].next_id = 1;
  r[0].raid[0] = E5rdRaid.{};
  _ := fb_everglade(r[0].bar[..]);
  _ = fb_warlock_bar(r[0].wbar[..]);
  _ = fb_cl_bar(r[0].cbar[..]);
  for s: 0..<E5RR_SEATS { r[0].klass[s] = 0; r[0].last_foe[s] = -1; }
  r[0].seen = b[0].book[0].seq;
  r[0].started = true;
  r[0].familiar_ready=false;
}

// Everglade II reserves one stable actor per seat, beyond other summons.
e5rr_enable_familiars :: (r:[]E5rRoom) {
  if r[0].familiar_ready { return; }
  b:=r[0].b[..];
  if b[0].n+E5RR_SEATS>b[0].c.count { return; }
  for s:0..<E5RR_SEATS {
    f:=b[0].n;
    b[0].c[f]=RsCreature.{dead=true,familiar_owner=E5RR_SEAT+s+1,x=-1,y=-1};
    b[0].n+=1;
    r[0].familiar[s]=FbSeat.{me=f};
  }
  r[0].familiar_ready=true;
}
e5rr_reset_familiar :: (r:[]E5rRoom,s:int) {
  if !r[0].familiar_ready { return; }
  f:=r[0].familiar[s].me;
  rs_familiar_retire(r[0].b[..],f);
  r[0].familiar[s]=FbSeat.{me=f};
}
e5rr_wild_companion :: (r:[]E5rRoom,s:int,slot:int,form:int,x:int,y:int)->bool {
  if !r[0].familiar_ready || s<0 || s>=E5RR_SEATS || !r[0].live[s] { return false; }
  b:=r[0].b[..]; seat:=r[0].seat[s..<s+1];
  if !seat[0].open { return false; }
  fb_seat_in(b,seat);
  ok:=rs_wild_companion(b,E5RR_SEAT+s,slot,form,x,y);
  fb_seat_out(b,seat);
  return ok;
}
// A player sits at seat s: a fresh caster, full Hit Points, at (x, z).
e5rr_join :: (r: [] E5rRoom, s: int, x: f32, z: f32) #export_c #effects(reads,writes,traps) { e5rr_join_as(r, s, x, z, 0); }
// The same, as class klass (the H frame's CLASS): 0 Everglade's druid, 1 the level 17 Warlock,
// E5R_CL0 + c Character Create's class c at level 1 (fivebar.coax fb_cl_hero; e5rr_join_level: another).
e5rr_join_as :: (r: [] E5rRoom, s: int, x: f32, z: f32, klass: int) #export_c #effects(reads,writes,traps) { e5rr_join_level(r, s, x, z, klass, 0); }
// The same at `level` (a Character Create class: 1 to 6, its hello's srd-CLASS-LEVEL, #13046).
e5rr_join_level :: (r: [] E5rRoom, s: int, x: f32, z: f32, klass: int, level: int) {
  if !r[0].started || s < 0 || s >= E5RR_SEATS { return; }
  b := r[0].b[..];
  i := E5RR_SEAT + s;
  t := b[0].c[i].turn_at; ro := b[0].c[i].round_at;
  e5rr_reset_familiar(r,s);
  r[0].klass[s] = e5r_klass_ok(klass);
  r[0].last_foe[s] = -1;
  b[0].c[i] = e5rr_hero_of(r[0].klass[s], ifx r[0].klass[s] >= E5R_CL0 then level else 0);
  // the seat's last player's Zombies go with it
  for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id != 0 && r[0].beasts[q].by == s && r[0].beasts[q].form == E5RR_FORM_ZOMBIE { b[0].c[E5RR_BEAST0 + q].dead = true; } }
  b[0].c[i].turn_at = hi_r(t, b[0].clock); b[0].c[i].round_at = ro;
  b[0].c[i].x = e5r_sq(x); b[0].c[i].y = e5rr_z_cell(r,z);
  r[0].seat[s] = FbSeat.{me = i};
  r[0].live[s] = true;
  // the seat's last player's spells end with the new one (its Concentration is the new caster's)
  e5rr_zones_check(r);
  e5rr_beasts_check(r);
}
// The player at seat s left the battle. What it concentrates on (its zones, its summoned creatures)
// stays until the spell would end (spec 6.3), or until someone else takes the seat.
e5rr_leave :: (r: [] E5rRoom, s: int) #export_c #effects(reads,writes,traps) {
  if !r[0].started || s < 0 || s >= E5RR_SEATS || !r[0].live[s] { return; }
  b := r[0].b[..];
  i := E5RR_SEAT + s;
  // Leaving is a transport/participation transition, not lethal damage.
  // Retain the off-map caster for owned effects until duration/death/replacement.
  b[0].c[i].x = E5R_AWAY; b[0].c[i].y = E5R_AWAY;
  r[0].live[s] = false;
  e5rr_reset_familiar(r,s);
  e5rr_zones_check(r);
  e5rr_beasts_check(r);
}
// Class klass's character as the room builds it: at `level` (0: Everglade's own druid and level 17
// Warlock; a Character Create class is the SRD class at that level, at least 1).
e5rr_hero_of :: (klass: int, level: int) -> RsCreature {
  if klass >= E5R_CL0 { return fb_cl_hero(klass - E5R_CL0, "Player", 0, level); }
  if level <= 0 { return ifx klass == E5R_WARLOCK then fb_warlock_hero("Player", 0) else fb_everglade_hero("Player", 0); }
  if klass == E5R_WARLOCK { c := rs_warlock("Player", 0, level, SP_ELDRITCH_BLAST); c.rebuke = true; return c; }
  return rs_druid("Player", 0, level);
}
// The hello's CLASS word for class klass, and back (an unknown word: the druid).
e5rr_kind_of :: (klass: int) -> string {
  if klass >= E5R_CL0 && klass < E5R_CL0 + FB_CL_N { return FB_CL_KIND[klass - E5R_CL0]; }
  return ifx klass == E5R_WARLOCK then "warlock" else "druid";
}
e5rr_klass_of :: (kind: string) -> int {
  if kind == "warlock" { return E5R_WARLOCK; }
  c := fb_cl_of_kind(kind);
  return ifx c >= 0 then E5R_CL0 + c else E5R_DRUID;
}
// Bar slot k's entry (the druid's bar, the Warlock's from FB_WL0, Character Create's from FB_CL0); e5r_has(k) first.
e5rr_entry :: (r: [] E5rRoom, k: int) -> FbAb { return ifx k >= FB_CL0 then r[0].cbar[k - FB_CL0] else ifx k >= FB_WL0 then r[0].wbar[k - FB_WL0] else r[0].bar[k]; }
// Where the engine has seat s (Everglade's metres, a square's middle) into out[0], out[1]: after a
// Dimension Door, where it teleported to. False when the seat is empty.
e5rr_seat_at :: (r: [] E5rRoom, s: int, out: [] f32) -> bool #export_c #effects(reads,writes,traps) {
  if !r[0].started || s < 0 || s >= E5RR_SEATS || !r[0].live[s] || out.count < 2 { return false; }
  c := r[0].b[0].c[E5RR_SEAT + s];
  out[0] = e5rr_cell_m(c.x); out[1] = e5rr_cell_z(r,c.y);
  return true;
}
// Where seat s stands now (Everglade's metres).
e5rr_place :: (r: [] E5rRoom, s: int, x: f32, z: f32) #export_c #effects(reads,writes,traps) {
  if !r[0].started || s < 0 || s >= E5RR_SEATS || !r[0].live[s] { return; }
  i := E5RR_SEAT + s;
  r[0].b[0].c[i].x = e5r_sq(x); r[0].b[0].c[i].y = e5rr_z_cell(r,z);
}
// Everglade's people, E5R_FOLK_FLOATS each (here, x, z, hp, temp, max, ac,
// block): the town's step owns where they are; the engine keeps their Hit Points once they are in.
// A person seen for the first time (or with a new block) takes the given Hit Points.
e5rr_people :: (r: [] E5rRoom, folk: [] f32, folk_n: int) #export_c #effects(reads,writes,traps) {
  if !r[0].started { return; }
  b := r[0].b[..];
  for j: 0..<E5R_FOLK {
    i := e5rr_folk(j);
    f := j * E5R_FOLK_FLOATS;
    if j >= folk_n || folk[f] < 0.5 { b[0].c[i].x = E5R_AWAY; b[0].c[i].y = E5R_AWAY; continue; }
    r[0].folk_x[j] = folk[f + 1]; r[0].folk_z[j] = folk[f + 2];
    block := clamp_r(cast(int) folk[f + 7], 0, E5R_BLOCKS - 1);
    folk_max := rs_max(cast(int) folk[f + 5], 1);
    // a new face here: a reinforcement of another rank, or one the town stood up whole again (HERE 2)
    if r[0].block[j] != block || b[0].c[i].hp_max != folk_max || folk[f] > 1.5 {
      r[0].block[j] = block;
      t := b[0].c[i].turn_at; ro := b[0].c[i].round_at;
      b[0].c[i] = fb_folk(E5R_BLOCK_NAME[block], 1, cast(int) folk[f + 6], folk_max, e5r_scores(block));
      e5rd_arm(b[0].c[i..<i + 1], block);   // the watch's weapons, for a raid (everglade5e-room-raid.coax)
      b[0].c[i].hp = rs_min(rs_max(cast(int) folk[f + 3], 0), folk_max);
      b[0].c[i].dead = b[0].c[i].hp <= 0;
      b[0].c[i].turn_at = t; b[0].c[i].round_at = ro;
    }
    b[0].c[i].x = e5r_sq(folk[f + 1]); b[0].c[i].y = e5rr_z_cell(r,folk[f + 2]);
  }
}
// The room's clock on to `clock` (seconds): turns, the saves people repeat and the zones' rounds.
e5rr_step :: (r: [] E5rRoom, clock: f32) #export_c #effects(reads,writes,traps) {
  if !r[0].started { return; }
  b := r[0].b[..];
  dt := clock - b[0].clock;
  if dt <= 0 { return; }
  rs_tick(b, dt);
  for s: 0..<E5RR_SEATS {
    if !r[0].live[s] { continue; }
    fb_seat_step(b,r[0].seat[s..<s+1]);
    if r[0].familiar_ready { fb_seat_step(b,r[0].familiar[s..<s+1]); }
  }
  // each creature read in place, not copied whole, every tick (a raid's hundreds: #12717)
  for j: 0..<E5R_FOLK {
    i := e5rr_folk(j);
    if b[0].c[i].dead || b[0].c[i].x == E5R_AWAY || b[0].c[i].turn_at > b[0].clock { continue; }
    b[0].who = i; rs_start_turn(b, i); e5rd_folk_turn(r, j); rs_end_turn(b, i); b[0].who = -1;   // the watch in a raid
  }
  for q: 0..<E5RR_BEASTS {
    i := E5RR_BEAST0 + q;
    if r[0].beasts[q].id == 0 || b[0].c[i].dead || b[0].c[i].turn_at > b[0].clock { continue; }
    b[0].who = i; rs_start_turn(b, i);
    if r[0].beasts[q].patrol {e5rp_turn(r,q);}
    else if r[0].beasts[q].forge_id>0 {e5rf_turn(r,q);}
    else if r[0].beasts[q].form >= E5RR_FORM_RAID { e5rd_turn(r, q); }   // a raider's (everglade5e-room-raid.coax)
    rs_end_turn(b, i); b[0].who = -1;
  }
  e5rr_rise(r);
  e5rr_beasts_step(r, dt);
  e5rd_step(r, dt);
  for k: 0..<E5RR_ZONES / FB_ZONES { _ := fb_zones_round(r[0].zones[k * FB_ZONES..<(k + 1) * FB_ZONES], b); }
  e5rr_zones_check(r);
  e5rr_beasts_check(r);
}
// A patrolling guard's turn (coax/web/room/room-e2-guard.coax walks it): a melee blow at the creature it is
// set on, its own stat block's weapon through the shared attack, once the room has brought it within
// reach. It never chooses a foe: the room sets one only on a creature that harmed it. forge_swing keeps
// the battle's clock of its last blow, which the room tells the pages.
e5rp_turn :: (r: [] E5rRoom, q: int) {
  bt := r[0].beasts[q..<q + 1]; b := r[0].b[..]; i := E5RR_BEAST0 + q;
  foe := bt[0].foe;
  if foe < 0 { return; }
  if foe >= b[0].n || b[0].c[foe].dead || b[0].c[foe].hp <= 0 || b[0].c[foe].x == E5R_AWAY { bt[0].foe = -1; return; }
  was := b[0].turn.action;
  _ := rs_attack(b, i, foe, false, -1);
  if b[0].turn.action && !was { bt[0].forge_swing = b[0].clock; }
}
// A zone whose caster's concentration ended is off: its id goes.
e5rr_zones_check :: (r: [] E5rRoom) {
  b := r[0].b[..];
  for q: 0..<E5RR_ZONES {
    z := r[0].zones[q];
    if z.on && (z.by < 0 || z.by >= b[0].n || b[0].c[z.by].conc != z.spell) { r[0].zones[q].on = false; }
    if !r[0].zones[q].on { r[0].zone_id[q] = 0; }
  }
}
// The one most hurt of seat s and the other players within 60 feet, for a heal.
e5rr_most_hurt :: (r: [] E5rRoom, s: int) -> int {
  b := r[0].b[..];
  me := E5RR_SEAT + s;
  best := me; worst := b[0].c[me].hp_max - b[0].c[me].hp;
  for o: 0..<E5RR_SEATS {
    i := E5RR_SEAT + o;
    c := b[0].c[i];
    if o == s || !r[0].live[o] || c.dead || rs_feet_to(b, me, i) > 60 || ((r[0].apart[s] >> o) & 1) != 0 { continue; }
    if c.hp_max - c.hp > worst { worst = c.hp_max - c.hp; best = i; }
  }
  return best;
}
// Whether seats s and o are a blocked pair (either blocks the other).
e5rr_apart :: (r: [] E5rRoom, s: int, o: int) -> bool {
  if s < 0 || s >= E5RR_SEATS || o < 0 || o >= E5RR_SEATS { return false; }
  return ((r[0].apart[s] >> o) & 1) != 0;
}
// Seat s uses bar slot k, landing at (x, z), at the target tgt (a TGT code, -1 none: the person
// nearest the point within 10 feet). The engine rolls it. False (nothing spent) when it can't: no
// such slot, the seat is dead or can't act.
e5rr_use :: (r: [] E5rRoom, s: int, k: int, x: f32, z: f32, tgt: int) -> bool #export_c #effects(reads,writes,traps) {
  switch e5rr_use_atomic(r, s, k, x, z, tgt) { case none { return false; } case some(ok) { return ok; } }
}
// The shared battle, every affected creature and its lasting areas commit together.
// The bool C boundary stays the same; refusal leaves the battle exactly as it was.
e5rr_use_atomic :: (r: [] E5rRoom, s: int, k: int, x: f32, z: f32, tgt: int) -> bool? {
  #transaction {
    if !e5rr_use_apply(r, s, k, x, z, tgt) { return null; }
  }
  return some(true);
}
e5rr_use_apply :: (r: [] E5rRoom, s: int, k: int, x: f32, z: f32, tgt: int) -> bool {
  if !r[0].started || s < 0 || s >= E5RR_SEATS || !r[0].live[s] || !e5r_slot_of(r[0].klass[s], k) { return false; }
  b := r[0].b[..];
  me := E5RR_SEAT + s;
  a := e5rr_entry(r, k);
  if a.kind == FB_WORLD { return true; }
  if !rs_capable(b[0].c[me]) { return false; }
  if !rs_can_act(b[0].c[me]) && !(a.kind == FB_SPELL && rs_spell(a.sp).cast_time == RS_T_REACTION) { return false; }
  if a.kind == FB_SPELL && a.sp == SP_CONJURE_ANIMALS { return e5rr_conjure(r, s, x, z); }
  // The room declares the same unlimited cost profile as Experimental.
  // The enclosing transaction restores it on refusal; Reactions stay spent.
  c := b[0].c[me..<me + 1];
  press_turn:[1] RsTurn; press_turn[0]=r[0].seat[s].turn;
  prepared:=rs_press_prepare(c,press_turn[..],b[0].press);
  r[0].seat[s].turn=press_turn[0]; r[0].seat[s].open=true;
  tx := e5r_sq(x); ty := e5rr_z_cell(r,z);
  foe := ifx tgt > E5RR_TGT_BEAST then e5rr_beast_of_tgt(r, tgt) else e5rr_of_tgt(tgt);
  if foe >= 0 && foe < E5RR_FOLK0 && !e5rr_helps(a) && !r[0].pvp { foe = -1; }   // PvP off: no harm aimed at a player
  if foe >= E5RR_SEAT && foe < E5RR_SEAT + E5RR_SEATS && e5rr_apart(r, s, foe - E5RR_SEAT) { foe = -1; }   // a blocked pair: neither aims at the other
  if foe < 0 {
    // the person nearest the point within 10 feet
    bd := 11;
    for j: 0..<E5R_FOLK {
      i := e5rr_folk(j);
      cc := b[0].c[i];
      if cc.dead || cc.x == E5R_AWAY { continue; }
      d := rs_feet(tx, ty, cc.x, cc.y);
      if d < bd { bd = d; foe = i; }
    }
  }
  if a.tg == FB_SELF { foe = -1; tx = b[0].c[me].x; ty = b[0].c[me].y; }
  ally := e5rr_most_hurt(r, s);
  if a.tg == FB_ALLY { foe = ifx tgt > E5RR_TGT_BEAST then e5rr_beast_of_tgt(r, tgt) else ifx tgt >= E5RR_TGT_SEAT then e5rr_of_tgt(tgt) else ally; }
  if a.tg == FB_ALLY && foe >= E5RR_SEAT && foe < E5RR_SEAT + E5RR_SEATS && e5rr_apart(r, s, foe - E5RR_SEAT) { foe = me; }
  // a harmful roll: the other players step out of the battle while it is rolled; a blocked pair's
  // other player steps out of every roll, harm or help (#12789)
  helps := e5rr_helps(a);
  kept_x: [E5RR_SEATS] int; kept_y: [E5RR_SEATS] int;
  for o: 0..<E5RR_SEATS {
    i := E5RR_SEAT + o;
    kept_x[o] = b[0].c[i].x; kept_y[o] = b[0].c[i].y;
    if o != s && ((!helps && !r[0].pvp) || e5rr_apart(r, s, o)) { b[0].c[i].x = E5R_AWAY; b[0].c[i].y = E5R_AWAY; }
  }
  before: [10] int;
  for l: 0..<10 { before[l] = b[0].c[me].slots[l]; }
  ok := fb_seat_use(b, r[0].seat[s..<s + 1], a, foe, tx, ty, ally);
  // a Warlock's harm aimed at a person sends its Zombies at them
  if ok && !helps && foe >= E5RR_FOLK0 && foe < E5RR_FOLK0 + E5R_FOLK { e5rr_send(r, s, foe, x, z); }
  for o: 0..<E5RR_SEATS { if o != s { b[0].c[E5RR_SEAT + o].x = kept_x[o]; b[0].c[E5RR_SEAT + o].y = kept_y[o]; } }
  if ok && a.again >= 0 {
    spent := 0;
    for l: 1..<10 { if b[0].c[me].slots[l] < before[l] { spent = l; } }
    // into the first chunk with a free zone (fb_zone_add takes the first free of its chunk)
    chunk := -1;
    for q: 0..<E5RR_ZONES { if !r[0].zones[q].on && chunk < 0 { chunk = q / FB_ZONES; } }
    if chunk >= 0 {
      zs := r[0].zones[chunk * FB_ZONES..<(chunk + 1) * FB_ZONES];
      fb_zone_add(zs, b, me, a, rs_max(spent, a.lvl), tx, ty);
      for q: chunk * FB_ZONES..<(chunk + 1) * FB_ZONES { if r[0].zones[q].on && r[0].zone_id[q] == 0 { r[0].zone_id[q] = r[0].next_id; r[0].zone_slot[q] = k; r[0].next_id += 1; } }
    }
  }
  e5rr_zones_check(r);
  return ok;
}
// Seat s ends what bar slot k holds up: its concentration, when that is k's spell.
e5rr_end :: (r: [] E5rRoom, s: int, k: int) -> bool #export_c #effects(reads,writes,traps) {
  if !r[0].started || s < 0 || s >= E5RR_SEATS || !r[0].live[s] || !e5r_has(k) { return false; }
  b := r[0].b[..];
  i := E5RR_SEAT + s;
  a := e5rr_entry(r, k);
  if a.kind != FB_SPELL || b[0].c[i].conc < 0 || b[0].c[i].conc != a.sp { return false; }
  rs_end_concentration(b, i, " (ended)");
  e5rr_zones_check(r);
  e5rr_beasts_check(r);
  return true;
}
// The rebuild (R) stands the town's fallen up: every person whole again (the world's watch_restore).
e5rr_folk_restore :: (r: [] E5rRoom) #export_c #effects(reads,writes,traps) {
  if !r[0].started { return; }
  for j: 0..<E5R_FOLK {
    i := e5rr_folk(j);
    if r[0].b[0].c[i].hp_max <= 0 { continue; }
    r[0].b[0].c[i].hp = r[0].b[0].c[i].hp_max; r[0].b[0].c[i].dead = false;
  }
}
// Damage the world dealt (a guard's sword, a spear, a fall): to creature `who`, by `by` (TGT codes; a
// `by` that names nobody: the creature itself), so the hit event names the townsperson or guard.
e5rr_hurt :: (r: [] E5rRoom, who: int, amount: int, by: int) #export_c #effects(reads,writes,traps) {
  if !r[0].started || amount <= 0 { return; }
  i := ifx who > E5RR_TGT_BEAST then e5rr_beast_of_tgt(r, who) else e5rr_of_tgt(who);
  if i < 0 { return; }
  j := ifx by > E5RR_TGT_BEAST then e5rr_beast_of_tgt(r, by) else e5rr_of_tgt(by);
  hits:=[1]E5rrDamage.[E5rrDamage.{who=i,by=ifx j>=0 then j else i,amount=amount}];
  switch e5rr_damage_many(r[0].b[..],hits[..]) {case none {} case some(applied) {}}
}
E5rrDamage :: struct {who:int;by:int;amount:int;}
// World fire and falls enter the same in-memory battle undo scope. A batch
// may refuse a later target without keeping earlier damage or random draws.
e5rr_damage_many :: (b:[]RsBattle,hits:[]const E5rrDamage)->bool? #effects(reads,writes,traps) {
  #transaction {
    for hit:hits {
      if hit.who<0 || hit.who>=b[0].n || hit.amount<=0 {return null;}
      by:=ifx hit.by>=0 && hit.by<b[0].n then hit.by else hit.who;
      rs_damage(b,by,hit.who,hit.amount,RS_BLUDGEONING,false,-1);
    }
  }
  return some(true);
}
#test "fire damage transaction: refusal on the third target restores every creature, random draw and hit event" #steps 2000000000 {
  r:[1]E5rRoom;e5rr_start(r[..],9);e5rr_test_people(r[..]);
  first:=e5rr_folk(0);second:=e5rr_folk(1);hp0:=r[0].b[0].c[first].hp;hp1:=r[0].b[0].c[second].hp;
  random:=r[0].b[0].dice[0].state;events:=r[0].b[0].book[0].seq;
  hits:=[3]E5rrDamage.[E5rrDamage.{who=first,by=first,amount=3},E5rrDamage.{who=second,by=first,amount=4},E5rrDamage.{who= -1,amount=5}];
  switch e5rr_damage_many(r[0].b[..],hits[..]) {case none {} case some(wrong) {#assert false;}}
  #assert r[0].b[0].c[first].hp==hp0 && r[0].b[0].c[second].hp==hp1;
  #assert r[0].b[0].dice[0].state==random && r[0].b[0].book[0].seq==events;
  switch e5rr_damage_many(r[0].b[..],hits[0..<2]) {case none {#assert false;} case some(applied) {#assert applied;}}
  #assert r[0].b[0].c[first].hp==hp0-3 && r[0].b[0].c[second].hp==hp1-4;
}

// ---- summoned creatures

e5rr_wolf :: () -> RsCreature {
  c: [1] RsCreature;
  c[0] = rs_monster(MON_WOLF, "Wolf", E5RR_BEAST_TEAM);
  return c[0];
}
// Finger of Death (SRD 5.2.1 p. 131): a Humanoid it kills rises at the start of the caster's next turn
// as a Zombie under the caster's command. The room raises each where the person fell, set on the one
// its caster last aimed harm at. A Zombie stays until it drops to 0 Hit Points, its seat's player
// leaves or another takes the seat, or the rebuild (R).
e5rr_rise :: (r: [] E5rRoom) {
  b := r[0].b[..];
  for j: 0..<E5R_FOLK {
    i := e5rr_folk(j);
    by := b[0].c[i].rise_by;
    if by < E5RR_SEAT || by >= E5RR_SEAT + E5RR_SEATS || b[0].c[i].rise_at > b[0].clock { continue; }
    b[0].c[i].rise_by = -1;
    s := by - E5RR_SEAT;
    if !r[0].live[s] { continue; }
    if e5b_raise(b, r[0].beasts[..], E5RR_BEAST0, i, r[0].folk_x[j], r[0].folk_z[j], by, s, r[0].last_foe[s], r[0].next_id) >= 0 { r[0].next_id += 1; }
  }
}
// Seat s sends its Zombies at the person foe (a creature), last seen at (x, z).
e5rr_send :: (r: [] E5rRoom, s: int, foe: int, x: f32, z: f32) {
  r[0].last_foe[s] = foe;
  e5b_send(r[0].beasts[..], s, foe, x, z);
}
// The rebuild (R): every Zombie falls (the town's people stand up whole, e5rr_folk_restore).
e5rr_zombies_clear :: (r: [] E5rRoom) #export_c #effects(reads,writes,traps) {
  if !r[0].started { return; }
  for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id != 0 && r[0].beasts[q].form == E5RR_FORM_ZOMBIE { r[0].b[0].c[E5RR_BEAST0 + q].dead = true; } }
  e5rr_beasts_check(r);
}
// Seat s casts Conjure Animals at (x, z): the pack comes there, or, while it has one, runs there.
// Either way it sets on the person within 10 feet of the point (the nearest), if any.
e5rr_conjure :: (r: [] E5rRoom, s: int, x: f32, z: f32) -> bool {
  b := r[0].b[..];
  me := E5RR_SEAT + s;
  foe := e5rr_folk_near(r, x, z, f32(E5RR_SCENT));
  had := 0;
  for q: 0..<E5RR_BEASTS {
    if r[0].beasts[q].id == 0 || r[0].beasts[q].by != s || r[0].beasts[q].spell != SP_CONJURE_ANIMALS { continue; }
    r[0].beasts[q].goal_x = x; r[0].beasts[q].goal_z = z; r[0].beasts[q].foe = foe;
    had += 1;
  }
  if had > 0 && b[0].c[me].conc == SP_CONJURE_ANIMALS { return true; }
  // a new pack: Concentration on it, up to 10 minutes
  free := 0;
  for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id == 0 { free += 1; } }
  if free < E5RR_PACK { return false; }
  rs_end_concentration(b, me, "");
  e5rr_zones_check(r);
  e5rr_beasts_check(r);
  b[0].c[me].conc = SP_CONJURE_ANIMALS; b[0].c[me].conc_until = b[0].clock + rs_spell(SP_CONJURE_ANIMALS).duration_s;
  n := 0;
  for q: 0..<E5RR_BEASTS {
    if n >= E5RR_PACK || r[0].beasts[q].id != 0 { continue; }
    // in a ring about the point, a metre out
    a := 6.2831853 * f32(n) / f32(E5RR_PACK) + 0.4;
    bx := x + cos(a); bz := z + sin(a);
    i := E5RR_BEAST0 + q;
    t := b[0].c[i].turn_at; ro := b[0].c[i].round_at;
    b[0].c[i] = e5rr_wolf();
    b[0].c[i].turn_at = hi_r(t, b[0].clock); b[0].c[i].round_at = ro;
    b[0].c[i].x = e5r_sq(bx); b[0].c[i].y = e5rr_z_cell(r,bz);
    r[0].beasts[q] = E5rBeast.{id = r[0].next_id, tag = r[0].next_id, by = s, spell = SP_CONJURE_ANIMALS, form = E5RR_FORM_WOLF,
                              x = bx, z = bz, yaw = a, goal_x = x, goal_z = z, foe = foe, bite_at = b[0].clock};
    r[0].next_id += 1;
    n += 1;
  }
  return true;
}
// The living person nearest (x, z) within `reach` metres, as a creature, or -1.
e5rr_folk_near :: (r: [] E5rRoom, x: f32, z: f32, reach: f32) -> int {
  b := r[0].b[..];
  best := -1; bd := reach * reach;
  for j: 0..<E5R_FOLK {
    i := e5rr_folk(j);
    if b[0].c[i].dead || b[0].c[i].x == E5R_AWAY { continue; }
    dx := r[0].folk_x[j] - x; dz := r[0].folk_z[j] - z;
    d := dx * dx + dz * dz;
    if d <= bd { bd = d; best = i; }
  }
  return best;
}
// A scripted Hold Person on the living person nearest (x, z) within `reach` (oa-room room-control.coax
// "hold", the drift check's held step, #12886): Paralyzed for E5RR_HOLD_S with no save, so every room
// it is laid in holds them alike. The creature, or -1 for none near.
E5RR_HOLD_S :: 6.0;
e5rr_hold_folk :: (r: [] E5rRoom, x: f32, z: f32, reach: f32) -> int #export_c #effects(reads,writes,traps) {
  i := e5rr_folk_near(r, x, z, reach);
  if i < 0 { return -1; }
  b := r[0].b[..];
  if !rs_put_effect(b, i, RsEffect.{kind = EF_COND, cond = RS_PARALYZED, by = -1, spell = SP_HOLD_PERSON, until = b[0].clock + E5RR_HOLD_S, save = -1, dc = 0}) { return -1; }
  return i;
}
// Each summoned creature's dt seconds (everglade5e-beasts.coax e5b_step).
e5rr_beasts_step :: (r: [] E5rRoom, dt: f32) { e5b_step(r[0].b[..], r[0].beasts[..], E5RR_BEAST0, E5RR_FOLK0, r[0].folk_x[..], r[0].folk_z[..], r[0].z_shift, dt); }
// A summoned creature at 0 Hit Points, or whose caster's Concentration on its spell ended, is gone.
e5rr_beasts_check :: (r: [] E5rRoom) {
  b := r[0].b[..];
  for q: 0..<E5RR_BEASTS {
    bt := r[0].beasts[q];
    if bt.id == 0 { continue; }
    i := E5RR_BEAST0 + q;
    raid := bt.form >= E5RR_FORM_RAID;   // a raider's is the raid's, no seat's (everglade5e-room-raid.coax)
    me := E5RR_SEAT + rs_max(bt.by, 0);
    held := raid || b[0].c[me].conc == bt.spell || (bt.form == E5RR_FORM_ZOMBIE && r[0].live[bt.by]);
    if b[0].c[i].dead || b[0].c[i].hp <= 0 || !held {
      // Retain a dead source if its authoritative result cannot be reserved.
      if raid && bt.forge_id==0 && !bt.patrol && !e5rd_down(r, q) { continue; }
      e5b_gone(b, r[0].beasts[..], E5RR_BEAST0, q);
    }
  }
}

// ---- what the engine says

// Creature i (seat or person): hp, max, temp, conditions (the engine's, and its effects' as
// E5RR_C_* bits), dead (0 or 1), concentration's spell (-1), then the seconds left on what holds it
// longest and that spell (SP_*, -1 none): a held or cursed player's status (#12771).
E5RR_OUT_FLOATS :: 8;
// The engine's effects as condition bits, after Everglade's WC_SLOWED (everglade-wire.coax WC_HALTED...):
// the same numbers there.
E5RR_C_HALTED :: 131072;     // Command's Halt: it doesn't move and takes no action
E5RR_C_BANED :: 262144; E5RR_C_BLESSED :: 524288; E5RR_C_FAITH :: 1048576; E5RR_C_ENFEEBLED :: 2097152; E5RR_C_HEXED :: 4194304;
e5rr_creature :: (r: [] E5rRoom, i: int, out: [] f32) {
  b := r[0].b[..];   // read in place: the host asks for every seat and person every tick
  out[0] = f32(b[0].c[i].hp); out[1] = f32(b[0].c[i].hp_max); out[2] = f32(b[0].c[i].temp); out[3] = f32(b[0].c[i].cond | e5rr_effect_bits(b, i));
  out[4] = ifx b[0].c[i].dead then 1.0f32 else 0.0f32; out[5] = f32(b[0].c[i].conc);
  sp: [1] int;
  out[6] = e5rr_hold_left(b, i, sp[..]); out[7] = f32(sp[0]);
}
// Creature i's effects as E5RR_C_* bits.
e5rr_effect_bits :: (b: [] RsBattle, i: int) -> int {
  n := 0;
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k].kind;
    if e == EF_HALT { n = n | E5RR_C_HALTED; }
    if e == EF_BANE { n = n | E5RR_C_BANED; }
    if e == EF_BLESS { n = n | E5RR_C_BLESSED; }
    if e == EF_FAITH { n = n | E5RR_C_FAITH; }
    if e == EF_ENFEEBLED { n = n | E5RR_C_ENFEEBLED; }
    if e == EF_HEX { n = n | E5RR_C_HEXED; }
  }
  return n;
}
// The seconds left on what holds creature i longest, its spell into sp[0] (-1, 0 s none): what
// stops it first (Command's Halt, Hold Person's paralysis), else a curse (Bane, Ray of
// Enfeeblement, Hex), else a blessing (Bless, Shield of Faith).
e5rr_hold_left :: (b: [] RsBattle, i: int, sp: [] int) -> f32 {
  sp[0] = -1;
  best: f32 = 0; rank := 0;
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.kind == EF_NONE || e.until <= b[0].clock { continue; }
    stop := e.kind == EF_HALT || (e.kind == EF_COND && (e.cond & (RS_PARALYZED | RS_RESTRAINED | RS_STUNNED)) != 0);
    curse := e.kind == EF_BANE || e.kind == EF_ENFEEBLED || e.kind == EF_HEX;
    rk := ifx stop then 3 else ifx curse then 2 else ifx e.kind == EF_BLESS || e.kind == EF_FAITH then 1 else 0;
    if rk == 0 { continue; }
    left := e.until - b[0].clock;
    if rk > rank || (rk == rank && left > best) { rank = rk; best = left; sp[0] = e.spell; }
  }
  return best;
}
e5rr_seat_out :: (r: [] E5rRoom, s: int, out: [] f32) #export_c #effects(reads,writes,traps) { if s >= 0 && s < E5RR_SEATS && out.count >= E5RR_OUT_FLOATS { e5rr_creature(r, E5RR_SEAT + s, out); } }
e5rr_folk_out :: (r: [] E5rRoom, j: int, out: [] f32) #export_c #effects(reads,writes,traps) { if j >= 0 && j < E5R_FOLK && out.count >= E5RR_OUT_FLOATS { e5rr_creature(r, e5rr_folk(j), out); } }
// Summoned creature q (0 to E5RR_BEASTS): its id (0 when off), then into out: x, y, z (metres), yaw,
// hp, max, the seat that summoned it, its form, 1 while it runs, 1 once its y is the ground's.
E5RR_BEAST_FLOATS :: 10;
e5rr_beast :: (r: [] E5rRoom, q: int, out: [] f32) -> int #export_c #effects(reads,writes,traps) {
  if q < 0 || q >= E5RR_BEASTS || r[0].beasts[q].id == 0 || out.count < E5RR_BEAST_FLOATS { return 0; }
  bt := r[0].beasts[q];
  c := r[0].b[0].c[E5RR_BEAST0 + q];
  out[0] = bt.x; out[1] = bt.y; out[2] = bt.z; out[3] = bt.yaw; out[4] = f32(c.hp); out[5] = f32(c.hp_max);
  out[6] = f32(bt.by); out[7] = f32(bt.form); out[8] = ifx bt.moving then 1.0f32 else 0.0f32; out[9] = ifx bt.grounded then 1.0f32 else 0.0f32;
  return bt.id;
}
// The ground's height under summoned creature q (the host's world knows it).
e5rr_beast_ground :: (r: [] E5rRoom, q: int, y: f32) #export_c #effects(reads,writes,traps) {
  if q < 0 || q >= E5RR_BEASTS || r[0].beasts[q].id == 0 { return; }
  r[0].beasts[q].y = y; r[0].beasts[q].grounded = true;
}
// Zone q (0 to E5RR_ZONES): its id (0 when off), then into out: spell, by (a TGT code), x, z
// (metres, the square's middle), radius (metres) and the bar slot that made it.
E5RR_ZONE_FLOATS :: 6;
e5rr_zone :: (r: [] E5rRoom, q: int, out: [] f32) -> int #export_c #effects(reads,writes,traps) {
  if q < 0 || q >= E5RR_ZONES || !r[0].zones[q].on || out.count < E5RR_ZONE_FLOATS { return 0; }
  z := r[0].zones[q];
  out[0] = f32(z.spell); out[1] = f32(e5rr_tgt(z.by));
  out[2] = e5rr_cell_m(z.cx); out[3] = e5rr_cell_z(r,z.cy);
  out[4] = f32(z.r_ft) * 0.3048; out[5] = f32(r[0].zone_slot[q]);
  return r[0].zone_id[q];
}
// The engine's events since the last call, oldest first, E5RR_EV_FLOATS each (kind RS_EV_*, spell,
// by and to as TGT codes, amount, damage type, the square's x and z in metres): how many.
e5rr_events :: (r: [] E5rRoom, out: [] f32) -> int #export_c #effects(reads,writes,traps) {
  if !r[0].started { return 0; }
  b := r[0].b[..];
  unread := rs_min(b[0].book[0].seq - r[0].seen, RS_EVENTS);
  r[0].seen = b[0].book[0].seq;
  n := 0;
  q := unread - 1;
  while q >= 0 {
    e := rs_recent_at(b[0].book[..], q);
    q -= 1;
    if (n + 1) * E5RR_EV_FLOATS > out.count { continue; }
    o := n * E5RR_EV_FLOATS;
    out[o] = f32(e.kind); out[o + 1] = f32(e.spell); out[o + 2] = f32(e5rr_tgt_in(r, e.by)); out[o + 3] = f32(e5rr_tgt_in(r, e.to));
    out[o + 4] = f32(e.amount); out[o + 5] = f32(e.damage);
    out[o + 6] = e5rr_cell_m(e.x); out[o + 7] = e5rr_cell_z(r,e.y);
    n += 1;
  }
  return n;
}

// ---- checks

// Two guards 3 m east of the origin and a commoner 30 m off, as everglade5e-rules.coax's test world.
e5rr_test_people :: (r: [] E5rRoom) {
  folk: [E5R_FOLK * E5R_FOLK_FLOATS] f32;
  g := 0;
  folk[g] = 1; folk[g + 1] = 3; folk[g + 2] = 0; folk[g + 3] = 11; folk[g + 5] = 11; folk[g + 6] = 16; folk[g + 7] = f32(E5R_GUARD);
  g = E5R_FOLK_FLOATS;
  folk[g] = 1; folk[g + 1] = 3; folk[g + 2] = 1.6; folk[g + 3] = 11; folk[g + 5] = 11; folk[g + 6] = 16; folk[g + 7] = f32(E5R_GUARD);
  g = 2 * E5R_FOLK_FLOATS;
  folk[g] = 1; folk[g + 1] = 30; folk[g + 2] = 0; folk[g + 3] = 4; folk[g + 5] = 4; folk[g + 6] = 10; folk[g + 7] = f32(E5R_COMMONER);
  e5rr_people(r, folk[..], E5R_FOLK);
}
#test "Everglade 5E room: Thunderwave catches the townsperson at your shoulder and the one ahead, not the one behind (#12930)" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 7);
  x0 := e5rr_test_m(20); z0 := e5rr_test_m(20); sq := f32(E5R_SQ);
  folk: [E5R_FOLK * E5R_FOLK_FLOATS] f32;
  xs := [3] f32.[x0, x0 + 3 * sq, x0 - sq];   // beside you (your square), 15 feet ahead, behind
  zs := [3] f32.[z0 + 0.4, z0, z0];
  for j: 0..<3 {
    g := j * E5R_FOLK_FLOATS;
    folk[g] = 1; folk[g + 1] = xs[j]; folk[g + 2] = zs[j]; folk[g + 3] = 40; folk[g + 5] = 40; folk[g + 6] = 10; folk[g + 7] = f32(E5R_COMMONER);
  }
  e5rr_people(r[..], folk[..], E5R_FOLK);
  e5rr_join(r[..], 0, x0, z0);
  #assert r[0].bar[9].sp == SP_THUNDERWAVE;
  #assert e5rr_use(r[..], 0, 9, x0 + 6 * sq, z0, -1);
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(r[..], 0, out[..]); #assert out[0] < out[1];    // beside you: hurt (2d8, or half on a save)
  e5rr_folk_out(r[..], 1, out[..]); #assert out[0] < out[1];    // ahead: hurt
  e5rr_folk_out(r[..], 2, out[..]); #assert out[0] == out[1];   // behind: untouched
}
#test "Everglade 5E room: a scripted hold paralyzes the person nearest for 6 s with no save, and no one out of reach (#12886)" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 7);
  e5rr_test_people(r[..]);
  e5rr_join(r[..], 0, 0, 0);
  #assert e5rr_hold_folk(r[..], 29, 0, 30) == e5rr_folk(2) && e5rr_hold_folk(r[..], -80, 0, 30) == -1;
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(r[..], 2, out[..]); #assert (cast(int) out[3] & RS_PARALYZED) != 0 && out[7] == f32(SP_HOLD_PERSON);
  e5rr_folk_out(r[..], 0, out[..]); #assert (cast(int) out[3] & RS_PARALYZED) == 0;
  t := r[0].b[0].clock;
  e5rr_step(r[..], t + 5.5); e5rr_folk_out(r[..], 2, out[..]); #assert (cast(int) out[3] & RS_PARALYZED) != 0;
  e5rr_step(r[..], t + 6.5); e5rr_folk_out(r[..], 2, out[..]); #assert (cast(int) out[3] & RS_PARALYZED) == 0;
}
#test "Everglade 5E room: scripted hold reports full effect storage without evicting another owner" #steps 2000000000 {
  r: [1] E5rRoom; e5rr_start(r[..],7); e5rr_test_people(r[..]);
  i := e5rr_folk_near(r[..],29,0,30);
  for k: 0..<RS_EFFECTS { r[0].b[0].c[i].eff[k] = RsEffect.{kind=EF_HEX,by=100+k,until=100}; }
  #assert e5rr_hold_folk(r[..],29,0,30) == -1 && !rs_has(r[0].b[0].c[i],RS_PARALYZED);
  for k: 0..<RS_EFFECTS { #assert r[0].b[0].c[i].eff[k].kind == EF_HEX && r[0].b[0].c[i].eff[k].by == 100+k; }
}
#test "Everglade 5E room: sixteen players, each its own caster; a blast hurts the town, never another player" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 7);
  e5rr_test_people(r[..]);
  for s: 0..<E5RR_SEATS { e5rr_join(r[..], s, 0, f32(s) * 0.2); }
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_seat_out(r[..], 15, out[..]);
  #assert out[0] == 57 && out[1] == 57 && out[4] == 0;
  // seat 3 throws the Thunderbolt on the guards, with seats 0 to 15 standing round them
  for s: 0..<E5RR_SEATS { e5rr_place(r[..], s, 3, 0.5); }
  #assert e5rr_use(r[..], 3, 1, 3, 0.8, -1);
  e5rr_folk_out(r[..], 0, out[..]); #assert out[0] == 0;
  e5rr_folk_out(r[..], 1, out[..]); #assert out[0] == 0;
  e5rr_folk_out(r[..], 2, out[..]); #assert out[0] == 4;
  for s: 0..<E5RR_SEATS { e5rr_seat_out(r[..], s, out[..]); #assert out[0] == 57; }
  // the events name the caster as seat 3 and the guards by their index
  ev: [64 * E5RR_EV_FLOATS] f32;
  n := e5rr_events(r[..], ev[..]);
  hits := 0;
  for q: 0..<n {
    if ev[q * E5RR_EV_FLOATS] == f32(RS_EV_DAMAGE) { #assert ev[q * E5RR_EV_FLOATS + 2] == f32(E5RR_TGT_SEAT + 3); #assert ev[q * E5RR_EV_FLOATS + 3] < 2; hits += 1; }
  }
  #assert hits >= 2 && e5rr_events(r[..], ev[..]) == 0;
  // aimed straight at another player, a harm is refused a target; a heal reaches them
  e5rr_hurt(r[..], E5RR_TGT_SEAT + 5, 30, -1);
  e5rr_seat_out(r[..], 5, out[..]); #assert out[0] == 27;
  #assert e5rr_use(r[..], 3, 28, 3, 0.5, E5RR_TGT_SEAT + 5);   // Healing Word on seat 5
  e5rr_seat_out(r[..], 5, out[..]); #assert out[0] > 27;
}
// Square q's middle in metres (e5r_sq's inverse).
e5rr_test_m :: (q: int) -> f32 { return e5rr_cell_m(q); }
// Four guards: three on squares round (px, py) and one 40 squares off; seat 0 two squares west.
e5rr_test_ring :: (r: [] E5rRoom, px: int, py: int) {
  folk: [E5R_FOLK * E5R_FOLK_FLOATS] f32;
  xs := [4] int.[px, px, px, px + 40]; ys := [4] int.[py - 1, py, py + 1, py];
  for j: 0..<4 {
    g := j * E5R_FOLK_FLOATS;
    folk[g] = 1; folk[g + 1] = e5rr_test_m(xs[j]); folk[g + 2] = e5rr_test_m(ys[j]); folk[g + 3] = 200; folk[g + 5] = 200; folk[g + 6] = 16; folk[g + 7] = f32(E5R_GUARD);
  }
  e5rr_people(r, folk[..], E5R_FOLK);
  e5rr_place(r, 0, e5rr_test_m(px - 2), e5rr_test_m(py));
}
#test "Everglade 5E room: the world's blow lands on whom it struck, not on the guard who dealt it (#12794)" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 7);
  e5rr_test_people(r[..]);
  e5rr_join(r[..], 1, 0, 0);
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(r[..], 0, out[..]); guard := out[0];
  // person 0's sword (the watch's `took`, by 0) at seat 1: 7 Hit Points off the seat, none off person 0
  e5rr_hurt(r[..], E5RR_TGT_SEAT + 1, 7, 0);
  e5rr_seat_out(r[..], 1, out[..]); #assert out[0] == 50;
  e5rr_folk_out(r[..], 0, out[..]); #assert out[0] == guard;
}
#test "Everglade 5E room: an area spell resolves against every person in its shape, one save each, and none outside it (#12718)" #steps 4000000000 {
  // Entangle: the three in its 20-foot square each make one Strength save; whoever fails is Restrained
  for seed: 1..<9 {
    r: [1] E5rRoom;
    e5rr_start(r[..], seed);
    e5rr_join(r[..], 0, 0, 0);
    e5rr_test_ring(r[..], 60, 60);
    ev: [256 * E5RR_EV_FLOATS] f32;
    _ := e5rr_events(r[..], ev[..]);
    #assert e5rr_use(r[..], 0, 26, e5rr_test_m(60), e5rr_test_m(60), -1);
    n := e5rr_events(r[..], ev[..]);
    saves: [4] int; failed: [4] int;
    for q: 0..<n {
      o := q * E5RR_EV_FLOATS;
      j := cast(int) ev[o + 3];
      if ev[o] == f32(RS_EV_SAVE) && ev[o + 1] == f32(SP_ENTANGLE) && j >= 0 && j < 4 { saves[j] += 1; }
    }
    out: [E5RR_OUT_FLOATS] f32;
    for j: 0..<4 {
      e5rr_folk_out(r[..], j, out[..]);
      if (cast(int) out[3] & RS_RESTRAINED) != 0 { failed[j] = 1; }
    }
    for j: 0..<3 { #assert saves[j] == 1; }
    #assert saves[3] == 0 && failed[3] == 0;
  }
  // every area the bar aims at a point: whatever it does as it is cast, it does to each person its
  // shape covers (a Line only the one on it, a 10-foot wall two of the three) and to none outside
  bar: [FB_EG_SLOTS] FbAb;
  bn := fb_everglade(bar[..]);
  tried := 0;
  for k: 0..<bn {
    a := bar[k];
    if a.kind != FB_SPELL || a.tg != FB_POINT || a.sp == SP_CONJURE_ANIMALS { continue; }
    sp := rs_spell(a.sp);
    if sp.area == RS_A_NONE { continue; }
    r: [1] E5rRoom;
    e5rr_start(r[..], 3 + k);
    e5rr_join(r[..], 0, 0, 0);
    e5rr_test_ring(r[..], 60, 60);
    ev: [256 * E5RR_EV_FLOATS] f32;
    _ := e5rr_events(r[..], ev[..]);
    // inside: as the engine's shape has it from the caster toward the point, before the cast (a push
    // moves people out of it)
    zn := rs_area(r[0].b[..], E5RR_SEAT, sp, e5r_sq(e5rr_test_m(60)), e5r_sq(e5rr_test_m(60)));
    was_in: [4] bool;
    for j: 0..<4 { c := r[0].b[0].c[e5rr_folk(j)]; was_in[j] = rs_inside(zn, c.x, c.y); }
    if !e5rr_use(r[..], 0, k, e5rr_test_m(60), e5rr_test_m(60), -1) { continue; }
    n := e5rr_events(r[..], ev[..]);
    hit: [4] int; saves: [4] int;
    for q: 0..<n {
      o := q * E5RR_EV_FLOATS;
      j := cast(int) ev[o + 3];
      if j < 0 || j >= 4 || ev[o] == f32(RS_EV_CAST) || ev[o] == f32(RS_EV_ZONE) { continue; }
      hit[j] += 1;
      if ev[o] == f32(RS_EV_SAVE) && ev[o + 1] == f32(a.sp) { saves[j] += 1; }
    }
    for j: 0..<4 { #assert saves[j] <= 1; }
    if hit[0] + hit[1] + hit[2] + hit[3] == 0 { continue; }
    tried += 1;
    ins := 0;
    for j: 0..<4 {
      inside := was_in[j];
      // Everglade's own four (slots 0 to 3: Meteor Swarm's several spheres, the Thunderbolts' arcs)
      // reach past one SRD shape; only the far one is out of their reach
      if k < 4 { if j == 3 && !inside { #assert hit[j] == 0; } if inside { ins += 1; } continue; }
      if inside { ins += 1; #assert hit[j] > 0; } else { #assert hit[j] == 0; }
    }
    #assert ins > 0;
  }
  #assert tried >= 8;
  // Call Lightning's later bolts, a round each: every one within 5 feet of its point, not the one nearest
  r: [1] E5rRoom;
  e5rr_start(r[..], 5);
  e5rr_join(r[..], 0, 0, 0);
  e5rr_test_ring(r[..], 60, 60);
  ev: [256 * E5RR_EV_FLOATS] f32;
  #assert e5rr_use(r[..], 0, 30, e5rr_test_m(60), e5rr_test_m(60), -1);
  _ := e5rr_events(r[..], ev[..]);
  clock := r[0].b[0].clock;
  bolts: [4] int;
  for step: 1..<9 {
    e5rr_step(r[..], clock + f32(step));
    n := e5rr_events(r[..], ev[..]);
    for q: 0..<n {
      o := q * E5RR_EV_FLOATS;
      j := cast(int) ev[o + 3];
      if ev[o] == f32(RS_EV_SAVE) && ev[o + 1] == f32(SP_CALL_BOLT) && j >= 0 && j < 4 { bolts[j] += 1; }
    }
  }
  for j: 0..<3 { #assert bolts[j] >= 1; }
  #assert bolts[3] == 0;
}
#test "Everglade 5E room: Thunderwave and Gust of Wind push whom their one save failed, and a save says how it went (#12874)" #steps 4000000000 {
  bar: [FB_EG_SLOTS] FbAb;
  bn := fb_everglade(bar[..]);
  sps := [2] int.[SP_THUNDERWAVE, SP_GUST_OF_WIND];
  for w: 0..<2 {
    k := -1;
    for q: 0..<bn { if k < 0 && bar[q].kind == FB_SPELL && bar[q].sp == sps[w] { k = q; } }
    #assert k >= 0;
    sp := rs_spell(sps[w]);
    fails := 0; succeeds := 0;
    for seed: 1..<13 {
      r: [1] E5rRoom;
      e5rr_start(r[..], seed * 7 + w);
      e5rr_join(r[..], 0, 0, 0);
      e5rr_test_ring(r[..], 60, 60);   // three guards two squares east of seat 0, and one far off
      ev: [256 * E5RR_EV_FLOATS] f32;
      _ := e5rr_events(r[..], ev[..]);
      zn := rs_area(r[0].b[..], E5RR_SEAT, sp, e5r_sq(e5rr_test_m(60)), e5r_sq(e5rr_test_m(60)));
      was_in: [4] bool;
      for j: 0..<4 { c := r[0].b[0].c[e5rr_folk(j)]; was_in[j] = rs_inside(zn, c.x, c.y); }
      #assert was_in[0] && was_in[1] && was_in[2] && !was_in[3];
      #assert e5rr_use(r[..], 0, k, e5rr_test_m(60), e5rr_test_m(60), -1);
      n := e5rr_events(r[..], ev[..]);
      saves: [4] int; saved: [4] int; pushed: [4] int;
      for q: 0..<n {
        o := q * E5RR_EV_FLOATS;
        j := cast(int) ev[o + 3];
        if j < 0 || j >= 4 || ev[o + 1] != f32(sps[w]) { continue; }
        if ev[o] == f32(RS_EV_SAVE) { saves[j] += 1; saved[j] = cast(int) ev[o + 5]; }
        if ev[o] == f32(RS_EV_PUSH) { pushed[j] += 1; }
      }
      // each of the three: one save, and pushed exactly when it failed; the far one neither
      for j: 0..<3 {
        #assert saves[j] == 1 && (saved[j] == 0 || saved[j] == 1);
        #assert pushed[j] == 1 - saved[j];
        if saved[j] == 1 { succeeds += 1; } else { fails += 1; }
      }
      #assert saves[3] == 0 && pushed[3] == 0;
    }
    #assert fails > 0 && succeeds > 0;   // the seeds give both
  }
}
#test "Everglade 5E room: a refused cast restores resources, turn state and the random stream" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 9); e5rr_test_people(r[..]); e5rr_join(r[..], 0, 0, 0);
  me := E5RR_SEAT;
  r[0].b[0].c[me].slots[1] = 0; r[0].b[0].c[me].reacted = true;
  r[0].seat[0].turn.action = true; r[0].seat[0].open = false;
  #assert !e5rr_use(r[..], 0, 1, 10000, 10000, -1);
  #assert r[0].b[0].c[me].slots[1] == 0 && r[0].b[0].c[me].reacted;
  #assert r[0].seat[0].turn.action && !r[0].seat[0].open;
}
#test "Everglade 5E room: a lasting area is the room's, with an id; it outlasts its caster's leaving until its time is up" #steps 2000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 9);
  e5rr_test_people(r[..]);
  e5rr_join(r[..], 0, 0, 0); e5rr_join(r[..], 1, 1, 0);
  #assert e5rr_use(r[..], 0, 12, 3, 0.8, -1);   // Black Tentacles at the guards
  z: [E5RR_ZONE_FLOATS] f32;
  id := 0; q0 := -1;
  for q: 0..<E5RR_ZONES { got := e5rr_zone(r[..], q, z[..]); if got > 0 { id = got; q0 = q; } }
  #assert id == 1 && z[0] == f32(r[0].bar[12].sp) && z[1] == f32(E5RR_TGT_SEAT) && abs(z[2] - 3) < 2 && z[4] > 1 && z[5] == 12;
  // seat 1's Moonbeam is a second zone with the next id
  #assert e5rr_use(r[..], 1, 20, 30, 0, -1);
  ids := 0;
  for q: 0..<E5RR_ZONES { if e5rr_zone(r[..], q, z[..]) > 0 { ids += 1; } }
  #assert ids == 2;
  // a round on, the tentacles hold the guards; never the players
  e5rr_step(r[..], r[0].b[0].clock + 7);
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_seat_out(r[..], 1, out[..]); #assert out[0] == 57;
  // seat 0 leaves: its tentacles hold on
  e5rr_leave(r[..], 0);
  #assert e5rr_zone(r[..], q0, z[..]) == id;
  #assert !e5rr_use(r[..], 0, 1, 3, 0, -1);
  // seat 1 ends its Moonbeam (slot 20); ending a slot it doesn't hold up does nothing
  #assert !e5rr_end(r[..], 1, 12);
  #assert e5rr_end(r[..], 1, 20);
  ids = 0;
  for q: 0..<E5RR_ZONES { if e5rr_zone(r[..], q, z[..]) > 0 { ids += 1; } }
  #assert ids == 1;
  // the tentacles' minute is up: they go
  e5rr_step(r[..], r[0].b[0].clock + 61);
  #assert e5rr_zone(r[..], q0, z[..]) == 0;
}
#test "Everglade 5E room: Conjure Animals brings four Wolves that bite the town; another player can kill one; they go with Concentration" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 11);
  e5rr_test_people(r[..]);
  e5rr_join(r[..], 0, 0, 0); e5rr_join(r[..], 1, 1, 0);
  #assert e5rr_use(r[..], 0, 32, 3, 0.8, -1);   // at the guards
  bf: [E5RR_BEAST_FLOATS] f32;
  ids: [E5RR_PACK] int; n := 0;
  for q: 0..<E5RR_BEASTS { id := e5rr_beast(r[..], q, bf[..]); if id > 0 { #assert bf[4] == 11 && bf[5] == 11 && bf[6] == 0 && bf[7] == f32(E5RR_FORM_WOLF); ids[n] = id; n += 1; } }
  #assert n == E5RR_PACK;
  z: [E5RR_ZONE_FLOATS] f32;
  for q: 0..<E5RR_ZONES { #assert e5rr_zone(r[..], q, z[..]) == 0; }   // beasts, not an area
  // twenty seconds on, a step a thirtieth: the pack has bitten the guards, never a player
  ev: [256 * E5RR_EV_FLOATS] f32;
  _ := e5rr_events(r[..], ev[..]);
  bites := 0;
  t := r[0].b[0].clock;
  for k: 0..<600 {
    t += 1.0 / 30.0;
    e5rr_step(r[..], t);
    m := e5rr_events(r[..], ev[..]);
    for e: 0..<m {
      o := e * E5RR_EV_FLOATS;
      if ev[o + 2] > f32(E5RR_TGT_BEAST) && (ev[o] == f32(RS_EV_DAMAGE) || ev[o] == f32(RS_EV_MISS)) { #assert ev[o + 3] < 2; bites += 1; }
    }
  }
  #assert bites >= 2;
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(r[..], 0, out[..]); g0 := out[0];
  e5rr_folk_out(r[..], 1, out[..]); g1 := out[0];
  #assert g0 + g1 < 22;
  e5rr_seat_out(r[..], 0, out[..]); #assert out[0] == 57;
  e5rr_seat_out(r[..], 1, out[..]); #assert out[0] == 57;
  // seat 1 hurts a wolf by its TGT code until it drops: it goes, and the event names it
  w := ids[0];
  wq := -1;
  for q: 0..<E5RR_BEASTS { if r[0].beasts[q].id == w { wq = q; } }
  e5rr_hurt(r[..], E5RR_TGT_BEAST + w, 4, -1);
  #assert e5rr_beast(r[..], wq, bf[..]) == w && bf[4] == 7;
  #assert e5rr_use(r[..], 1, 1, bf[0], bf[2], E5RR_TGT_BEAST + w);   // the Thunderbolt at it
  e5rr_hurt(r[..], E5RR_TGT_BEAST + w, 20, -1);
  e5rr_step(r[..], t + 0.1);
  #assert e5rr_beast(r[..], wq, bf[..]) == 0;
  died := false;
  m := e5rr_events(r[..], ev[..]);
  for e: 0..<m { if ev[e * E5RR_EV_FLOATS] == f32(RS_EV_DEATH) && ev[e * E5RR_EV_FLOATS + 3] == f32(E5RR_TGT_BEAST + w) { died = true; } }
  #assert died;
  left := 0;
  for q: 0..<E5RR_BEASTS { if e5rr_beast(r[..], q, bf[..]) > 0 { left += 1; } }
  #assert left < E5RR_PACK;   // (the Thunderbolt's blast may take others of the pack too)
  // casting again sends the pack; ending it (slot 32) sends them all away
  #assert e5rr_use(r[..], 0, 32, 30, 0, -1);
  #assert e5rr_end(r[..], 0, 32);
  left = 0;
  for q: 0..<E5RR_BEASTS { if e5rr_beast(r[..], q, bf[..]) > 0 { left += 1; } }
  #assert left == 0;
  // a pack outlasts its caster's leaving; a new player in the seat ends it
  #assert e5rr_use(r[..], 0, 32, 30, 0, -1);
  e5rr_leave(r[..], 0);
  e5rr_step(r[..], r[0].b[0].clock + 1);
  left = 0;
  for q: 0..<E5RR_BEASTS { if e5rr_beast(r[..], q, bf[..]) > 0 { left += 1; } }
  #assert left == E5RR_PACK;
  e5rr_join(r[..], 0, 0, 0);
  left = 0;
  for q: 0..<E5RR_BEASTS { if e5rr_beast(r[..], q, bf[..]) > 0 { left += 1; } }
  #assert left == 0;
}
#test "Everglade 5E room: a level 17 Warlock seat; Finger of Death's dead rise as its Zombies and go for whom it sends them at" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 5);
  e5rr_test_people(r[..]);
  e5rr_join_as(r[..], 0, 0, 0, 1); e5rr_join(r[..], 1, 1, 0);
  #assert r[0].b[0].c[0].level == 17 && r[0].b[0].c[1].level != 17;
  #assert !e5rr_use(r[..], 1, FB_WL0 + 4, 3, 0, 0);   // a druid has no Finger of Death
  #assert !e5rr_use(r[..], 0, 1, 3, 0, 0);            // the Warlock no Thunderbolt
  #assert e5rr_use(r[..], 0, FB_WL0 + 4, 3, 0, 0);    // Finger of Death at guard 0: 7d8 + 30
  out: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(r[..], 0, out[..]); #assert out[4] == 1;
  e5rr_seat_out(r[..], 1, out[..]); #assert out[0] == 57;   // never the other player
  ev: [256 * E5RR_EV_FLOATS] f32;
  bf: [E5RR_BEAST_FLOATS] f32;
  t := r[0].b[0].clock;
  zq := -1;
  for k: 0..<120 { t += 1.0 / 30.0; e5rr_step(r[..], t); _ := e5rr_events(r[..], ev[..]); }
  for q: 0..<E5RR_BEASTS { if e5rr_beast(r[..], q, bf[..]) > 0 && bf[7] == f32(E5RR_FORM_ZOMBIE) { zq = q; #assert bf[4] == 15 && bf[6] == 0; } }
  #assert zq >= 0;
  // sent at the commoner 30 m off: it shambles there (20 feet, half a Wolf's run) and slams
  e5rr_send(r[..], 0, e5rr_folk(2), 30, 0);
  slams := 0;
  for k: 0..<900 {
    t += 1.0 / 30.0;
    e5rr_step(r[..], t);
    m := e5rr_events(r[..], ev[..]);
    for e: 0..<m { o := e * E5RR_EV_FLOATS; if ev[o + 2] > f32(E5RR_TGT_BEAST) && (ev[o] == f32(RS_EV_DAMAGE) || ev[o] == f32(RS_EV_MISS)) { #assert ev[o + 3] == 2; slams += 1; } }
  }
  #assert slams >= 1;
  // Dimension Door: the engine's seat stands where it teleported
  at: [2] f32;
  #assert e5rr_use(r[..], 0, FB_WL0 + 5, 12, 0, -1);
  #assert e5rr_seat_at(r[..], 0, at[..]) && abs(at[0] - 12) < 1.6 && abs(at[1]) < 1.6;
  // the rebuild ends the Zombies; so does the player leaving
  e5rr_zombies_clear(r[..]);
  #assert e5rr_beast(r[..], zq, bf[..]) == 0;
}
#test "Everglade 5E room: Wall of Fire's rounds are its caster's harm, though another seat cast since (#12923)" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 5);
  e5rr_join(r[..], 0, 0, 0); e5rr_join(r[..], 1, 0, 0);
  e5rr_test_ring(r[..], 60, 60);
  e5rr_place(r[..], 1, e5rr_test_m(100), e5rr_test_m(60));
  #assert r[0].bar[31].sp == SP_WALL_OF_FIRE;
  #assert e5rr_use(r[..], 0, 31, e5rr_test_m(60), e5rr_test_m(60), -1);
  ev: [256 * E5RR_EV_FLOATS] f32;
  _ := e5rr_events(r[..], ev[..]);
  // seat 1 strikes the far guard with the Thunderbolt after it
  #assert e5rr_use(r[..], 1, 1, e5rr_test_m(100), e5rr_test_m(60), -1);
  _ = e5rr_events(r[..], ev[..]);
  burns := 0;
  t := r[0].b[0].clock;
  for f: 0..<40 {
    t += 0.25; e5rr_step(r[..], t);
    n := e5rr_events(r[..], ev[..]);
    for q: 0..<n {
      o := q * E5RR_EV_FLOATS;
      if ev[o] != f32(RS_EV_DAMAGE) || ev[o + 1] != f32(SP_WALL_OF_FIRE) { continue; }
      #assert ev[o + 2] == f32(E5RR_TGT_SEAT);
      burns += 1;
    }
  }
  #assert burns > 0;
}
#test "Everglade 5E room: Character Create's classes sit as the SRD class at level 1 and use their one slot (#13024)" #steps 4000000000 {
  r: [1] E5rRoom;
  e5rr_start(r[..], 9);
  e5rr_test_people(r[..]);
  for c: 0..<FB_CL_N { #assert e5rr_klass_of(e5rr_kind_of(E5R_CL0 + c)) == E5R_CL0 + c; }
  #assert e5rr_klass_of("warlock") == E5R_WARLOCK && e5rr_klass_of("druid") == E5R_DRUID && e5rr_klass_of("srd-nobody") == E5R_DRUID;
  e5rr_join_as(r[..], 0, 0, 0, E5R_CL0 + FB_CL_BARD);
  e5rr_join_as(r[..], 1, 1, 0, E5R_CL0 + FB_CL_BARBARIAN);
  #assert r[0].b[0].c[0].level == 1 && r[0].b[0].c[0].klass == RS_BARD && r[0].b[0].c[0].hp_max == 9;
  #assert r[0].b[0].c[1].klass == RS_BARBARIAN && r[0].b[0].c[1].hp_max == 14;
  #assert !e5rr_use(r[..], 0, 1, 3, 0, 0);                         // not Everglade's druid's Thunderbolt
  #assert !e5rr_use(r[..], 0, FB_CL0 + FB_CL_BARBARIAN, 0, 0, -1);  // nor another class's
  #assert e5rr_use(r[..], 0, FB_CL0 + FB_CL_BARD, 3, 0, 0);         // Vicious Mockery at guard 0
  #assert e5rr_use(r[..], 1, FB_CL0 + FB_CL_BARBARIAN, 1, 0, -1) && r[0].b[0].c[1].raging;   // Rage
}

#test "Everglade room unlimited presses preserve spent Reactions and other seats" #steps 2000000000 {
  r:[1] E5rRoom; e5rr_start(r[..],9); e5rr_test_people(r[..]);
  e5rr_join_as(r[..],0,0,0,E5R_CL0+FB_CL_BARD); e5rr_join_as(r[..],1,1,0,E5R_CL0+FB_CL_BARD);
  b:=r[0].b[..]; b[0].c[0].reacted=true; b[0].c[1].reacted=true; b[0].c[1].slots[1]=0;
  r[0].seat[1].turn.action=true; r[0].seat[1].turn.bonus=true;
  #assert e5rr_use(r[..],0,FB_CL0+FB_CL_BARD,3,0,0);
  #assert b[0].c[0].reacted;
  #assert b[0].c[1].reacted && b[0].c[1].slots[1]==0;
  #assert r[0].seat[1].turn.action && r[0].seat[1].turn.bonus;
  // Public transaction still restores the press override when speech refuses.
  b[0].c[0].speech_blocked=true; b[0].c[0].slots[1]=0;
  r[0].seat[0].turn.action=true; r[0].seat[0].turn.bonus=true;
  #assert !e5rr_use(r[..],0,FB_CL0+FB_CL_BARD,3,0,0);
  #assert b[0].c[0].reacted && b[0].c[0].slots[1]==0;
  #assert r[0].seat[0].turn.action && r[0].seat[0].turn.bonus;
}

#test "Everglade room declares unlimited Rage uses without refreshing its Reaction" #steps 2000000000 {
  r:[1] E5rRoom; e5rr_start(r[..],9); e5rr_test_people(r[..]);
  e5rr_join_as(r[..],0,0,0,E5R_CL0+FB_CL_BARBARIAN);
  b:=r[0].b[..]; b[0].c[0].rages=0; b[0].c[0].reacted=true;
  #assert e5rr_use(r[..],0,FB_CL0+FB_CL_BARBARIAN,0,0,-1);
  #assert b[0].c[0].raging && b[0].c[0].rages==b[0].c[0].rages_max-1;
  #assert b[0].c[0].reacted;
}

#test "leaving the room is not death and retained summons still end on actual caster death" #steps 2000000000 {
  r:[1] E5rRoom; e5rr_start(r[..],9); e5rr_test_people(r[..]); e5rr_join(r[..],0,0,0);
  b:=r[0].b[..]; hp:=b[0].c[0].hp;
  #assert e5rr_use(r[..],0,32,30,0,-1);
  e5rr_leave(r[..],0);
  #assert !r[0].live[0] && !b[0].c[0].dead && b[0].c[0].hp==hp;
  #assert b[0].c[0].x==E5R_AWAY && b[0].c[0].y==E5R_AWAY;
  e5rr_step(r[..],b[0].clock+1);
  #assert b[0].c[0].conc==SP_CONJURE_ANIMALS;
  alive:=0; for q:0..<E5RR_BEASTS { if r[0].beasts[q].id!=0 && !b[0].c[E5RR_BEAST0+q].dead { alive+=1; } }
  #assert alive==E5RR_PACK;
  // Actual lethal damage retains the shared zero-HP/concentration lifecycle.
  rs_damage(b,1,0,hp+1000,RS_FORCE,false,-1);
  e5rr_step(r[..],b[0].clock+1);
  #assert b[0].c[0].dead && b[0].c[0].conc<0;
  alive=0; for q:0..<E5RR_BEASTS { if r[0].beasts[q].id!=0 && !b[0].c[E5RR_BEAST0+q].dead { alive+=1; } }
  #assert alive==0;
}
