// Everglade 5E's rules, openagents.com/worlds/everglade-5e (unlisted): Everglade's spell bar on the
// SRD 5e engine (rules/srd/), through the hotbar layer it shares with 5E MMO (fivebar.coax).
// The page's copy is only your caster (fb_everglade_hero: a 9th-level Druid, AC 15, 57 Hit Points,
// spell save DC 15, +7 to hit; or the Warlock), for the bar: what each slot can do now and its card.
// Every cast and every harm is the room's (everglade5e-room-rules.coax; offline the local host's,
// #12882), so the page rolls nothing (#12908). Nothing on the bar is ever held back (owner,
// November 3): no spell slots, actions or Bonus Actions to run out of. The shared numbers here (the
// grid, the stat blocks) are the room rules' too.
// This is its own C unit (everglade5e-face.c calls its e5r_ exports), so its names stay apart from
// Everglade's.
//   coax/bin/coax test --library apps/openagents-web/everglade5e-rules.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "../../rules/srd/battle.coax";
#load "../../everglade/shared/fivebar.coax";
#load "everglade5e-beasts.coax";   // what a spell summons, the room's rules too: Finger of Death's Zombies

E5R_BEAT :: 1.5; E5R_RECHARGE :: 9.0;
E5R_FOLK :: 47;            // Everglade's people who can be hurt (verse/everglade/watch.coax WATCH_ACTORS: 28 spots, 6 new watch, 13 responders)
E5R_OTHERS :: 15;          // the others in the room (room.coax ROOM_OTHERS)
E5R_BEASTS :: 8;           // your Zombies at once (everglade5e-beasts.coax), creatures after the others
E5R_ME :: 0;
E5R_SQ :: 1.524;           // a 5-foot square, in metres
E5R_X0 :: -110.0;          // the grid's corner (square 0, 0), in Everglade's metres
E5R_SIDE :: 145;           // squares a side: the whole city and its wood
E5R_AWAY :: -1000;         // the square of one who isn't here
E5R_FOLK_FLOATS :: 8;      // here, x, z, hp, temp, max, ac, block
E5R_SLOT_FLOATS :: 6;      // can, left, back, cost, delay, level
E5R_HERO_FLOATS :: 32;
// what the page sees a slot can do (e5r_bar's first number)
E5R_READY :: 0; E5R_NO_SLOT :: 1; E5R_SPENT :: 2; E5R_CANT :: 3;
// what a slot spends (e5r_bar's fourth)
E5R_COST_NONE :: 0; E5R_COST_ACTION :: 1; E5R_COST_BONUS :: 2; E5R_COST_REACTION :: 3;

// Everglade's stat blocks (verse/rules/srd5-combat.coax) and their SRD 5.2.1 ability scores
E5R_BLOCKS :: 9;
E5R_COMMONER :: 0; E5R_GUARD :: 1; E5R_VETERAN :: 2; E5R_MAGE :: 3; E5R_KNIGHT :: 4; E5R_PRIEST :: 5; E5R_ARCHMAGE :: 6; E5R_GLADIATOR :: 7; E5R_SCOUT :: 8;
E5R_BLOCK_NAME :: [9] string.["Commoner", "Guard", "Warrior Veteran", "Mage", "Knight", "Priest", "Archmage", "Gladiator", "Scout"];
E5R_SCORES :: [54] int.[10, 10, 10, 10, 10, 10,  13, 12, 12, 10, 11, 10,  16, 13, 14, 10, 11, 10,  9, 14, 11, 17, 12, 11,
                        16, 11, 14, 11, 11, 15,  10, 10, 12, 13, 16, 13,  10, 14, 12, 20, 15, 16,  18, 15, 16, 10, 12, 15,
                        11, 14, 12, 11, 13, 11];
e5r_scores :: (block: int) -> [6] int #effects(reads, writes, traps) {
  o: [6] int;
  for q: 0..<6 { o[q] = E5R_SCORES[block * 6 + q]; }
  return o;
}

E5r :: struct {
  b: [1] RsBattle;
  seat: [1] FbSeat;
  bar: [FB_EG_SLOTS] FbAb;
  wbar: [FB_WL_SLOTS] FbAb;  // the Warlock's bar (fivebar.coax fb_warlock_bar): slots FB_WL0 + k
  warlock: bool;             // you play the Warlock (the CHARACTER picker): creature 0 is fb_warlock_hero
  cbar: [FB_CL_N] FbAb;      // Character Create's classes' abilities (fivebar.coax fb_cl_bar): slot FB_CL0 + class
  klass: int;                // your class: E5R_DRUID, E5R_WARLOCK, or E5R_CL0 + a Character Create class
  started: bool;
}

e5r_sq :: (m: f32) -> int #effects(reads, writes, traps) { return cast(int) floor((m - f32(E5R_X0)) / f32(E5R_SQ)); }
e5r_start :: (r: [] E5r, seed: int) #export_c #effects(reads, writes, traps) {
  b := r[0].b[..];
  b[0].n = 0; b[0].clock = 0; b[0].who = -1; b[0].w = E5R_SIDE; b[0].h = E5R_SIDE;
  world_selected := rs_set_world(b,RS_ACTION_WORLD);   // every declared deviation: world-profile.coax
  for k: 0..<RS_ZONES { b[0].zone[k].on = false; }
  b[0].truth_zones=0;
  b[0].dice[0].state = cast(u64) seed * 7919 + 3;
  _ := rs_add(b, fb_everglade_hero("Your druid", 0), 72, 72);
  rs_begin(b);
  r[0].seat[0] = FbSeat.{me = E5R_ME};
  b[0].clock = b[0].c[E5R_ME].turn_at;
  fb_seat_step(b, r[0].seat[..]);
  _ = fb_everglade(r[0].bar[..]);
  _ = fb_warlock_bar(r[0].wbar[..]);
  _ = fb_cl_bar(r[0].cbar[..]);
  r[0].warlock = false; r[0].klass = E5R_DRUID;
  r[0].started = true;
}
// The classes: Everglade's druid (the CHARACTER picker's first), its Warlock, then Character Create's
// twelve (E5R_CL0 + fivebar.coax FB_CL_*), each the SRD 5.2.1 class at level 1.
E5R_DRUID :: 0; E5R_WARLOCK :: 1; E5R_CL0 :: 2;
e5r_klass_ok :: (klass: int) -> int { return ifx klass >= 0 && klass < E5R_CL0 + FB_CL_N then klass else E5R_DRUID; }
// Your class (the CHARACTER picker, everglade-join.coax; Character Create's CLASS row,
// everglade-create.coax). A change makes you that class's character, whole.
e5r_class :: (r: [] E5r, klass_in: int) #export_c #effects(reads, writes, traps) {
  klass := e5r_klass_ok(klass_in);
  if !r[0].started || klass == r[0].klass { return; }
  b := r[0].b[..];
  r[0].klass = klass;
  r[0].warlock = klass == E5R_WARLOCK;
  c := b[0].c[E5R_ME];
  b[0].c[E5R_ME] = ifx klass >= E5R_CL0 then fb_cl_hero(klass - E5R_CL0, "You", 0, 1) else ifx r[0].warlock then fb_warlock_hero("Your warlock", 0) else fb_everglade_hero("Your druid", 0);
  b[0].c[E5R_ME].x = c.x; b[0].c[E5R_ME].y = c.y; b[0].c[E5R_ME].turn_at = c.turn_at; b[0].c[E5R_ME].round_at = c.round_at;
}
// Bar slot k's entry: Everglade's bar (0 to FB_EG_SLOTS - 1), the Warlock's (FB_WL0 on); ok false for none.
// Character Create's classes' slots are FB_CL0 on.
e5r_has :: (k: int) -> bool #effects(reads, writes, traps) { return (k >= 0 && k < FB_EG_SLOTS) || (k >= FB_WL0 && k < FB_WL0 + FB_WL_SLOTS) || (k >= FB_CL0 && k < FB_CL0 + FB_CL_N); }
e5r_entry :: (r: [] E5r, k: int) -> FbAb #effects(reads, writes, traps) { return ifx k >= FB_CL0 then r[0].cbar[k - FB_CL0] else ifx k >= FB_WL0 then r[0].wbar[k - FB_WL0] else r[0].bar[k]; }
// Whether class `klass` has bar slot k: Everglade's druid its bar, the Warlock its own, a Character
// Create class its one ability and the realm's Repair (slot 47, everglade-repair.coax).
e5r_slot_of :: (klass: int, k: int) -> bool #effects(reads, writes, traps) {
  if !e5r_has(k) { return false; }
  if klass >= E5R_CL0 { return k == FB_CL0 + klass - E5R_CL0 || k == 47; }
  if k >= FB_CL0 { return false; }
  return (k >= FB_WL0) == (klass == E5R_WARLOCK);
}
// Your Hit Points and Temporary Hit Points, the room's (the page's: everglade5e.coax e5_me): at 0 the
// bar can't be used.
e5r_you :: (r: [] E5r, hp: f32, temp: f32) #export_c #effects(reads, writes, traps) {
  if !r[0].started { return; }
  c := r[0].b[0].c[E5R_ME..<E5R_ME + 1];
  c[0].hp = rs_min(rs_max(cast(int) hp, 0), c[0].hp_max); c[0].temp = rs_max(cast(int) temp, 0);
  c[0].dead = c[0].hp <= 0;
}
clamp_r :: (v: int, lo_v: int, hi_v: int) -> int #effects(reads, writes, traps) { return rs_max(lo_v, rs_min(hi_v, v)); }

// ---- what each slot can do now

// What entry a spends: its action, Bonus Action or Reaction (a feature taken at once: Bonus Action).
e5r_cost_of :: (a: FbAb) -> int #effects(reads, writes, traps) {
  if a.kind == FB_WORLD { return E5R_COST_NONE; }
  if a.kind == FB_RESURGE { return E5R_COST_BONUS; }
  if a.kind != FB_SPELL { return E5R_COST_ACTION; }
  t := rs_spell(a.sp).cast_time;
  if t == RS_T_BONUS { return E5R_COST_BONUS; }
  if t == RS_T_REACTION { return E5R_COST_REACTION; }
  return E5R_COST_ACTION;
}
e5r_can_of :: (r: [] E5r, a: FbAb) -> int #effects(reads, writes, traps) {
  b := r[0].b[..];
  if a.kind == FB_WORLD { return E5R_READY; }
  me := b[0].c[E5R_ME];
  if me.dead || me.hp <= 0 { return E5R_CANT; }
  return E5R_READY;
}
// Each of the bar's slots, E5R_SLOT_FLOATS each: whether it can be used now (E5R_READY or why not),
// what it has left (slots at its level, uses; -1 nothing to count), seconds till its next slot is
// back (0 none), what it spends, seconds from its press to its strike, its slot level.
e5r_bar :: (r: [] E5r, out: [] f32) -> int #export_c #effects(reads, writes, traps) {
  if !r[0].started { return 0; }
  b := r[0].b[..];
  n := 0;
  for k: 0..<FB_EG_SLOTS {
    if (k + 1) * E5R_SLOT_FLOATS > out.count { break; }
    a := r[0].bar[k];
    o := k * E5R_SLOT_FLOATS;
    out[o] = f32(e5r_can_of(r, a));
    out[o + 1] = -1;   // nothing to count: slots never run out here
    out[o + 2] = 0;
    out[o + 3] = f32(e5r_cost_of(a));
    out[o + 4] = a.delay;
    out[o + 5] = f32(a.lvl);
    n += 1;
  }
  return n;
}
// The Warlock's bar the same way: its FB_WL_SLOTS slots (FB_WL0 + k on the wire).
e5r_wbar :: (r: [] E5r, out: [] f32) -> int #export_c #effects(reads, writes, traps) {
  if !r[0].started { return 0; }
  n := 0;
  for k: 0..<FB_WL_SLOTS {
    if (k + 1) * E5R_SLOT_FLOATS > out.count { break; }
    a := r[0].wbar[k];
    o := k * E5R_SLOT_FLOATS;
    out[o] = f32(ifx r[0].warlock then e5r_can_of(r, a) else E5R_CANT);
    out[o + 1] = -1; out[o + 2] = 0;
    out[o + 3] = f32(e5r_cost_of(a)); out[o + 4] = a.delay; out[o + 5] = f32(a.lvl);
    n += 1;
  }
  return n;
}
hi_r :: (a: f32, b: f32) -> f32 #effects(reads, writes, traps) { return ifx a > b then a else b; }
lo_r :: (a: f32, b: f32) -> f32 #effects(reads, writes, traps) { return ifx a < b then a else b; }
// You, E5R_HERO_FLOATS: hp, max, temp, AC, the spell held (-1 none), action, Bonus Action and slot
// spent this turn (1 spent), seconds to your next turn, save DC, spell attack, conditions, then your
// slots at levels 1 to 9 and their most (from 12 and 21), the clock (30) and whether your turn is open (31).
e5r_hero :: (r: [] E5r, out: [] f32) -> int #export_c #effects(reads, writes, traps) {
  if !r[0].started || out.count < E5R_HERO_FLOATS { return 0; }
  b := r[0].b[..];
  c := b[0].c[E5R_ME];
  t := r[0].seat[0].turn;
  out[0] = f32(c.hp); out[1] = f32(c.hp_max); out[2] = f32(c.temp); out[3] = f32(c.ac);
  out[4] = f32(c.conc);
  out[5] = ifx t.action then 1.0f32 else 0.0f32; out[6] = ifx t.bonus then 1.0f32 else 0.0f32; out[7] = ifx t.slot_spent then 1.0f32 else 0.0f32;
  out[8] = hi_r(rs_ticks_s(fb_seat_next(b, r[0].seat[..]) - b[0].clock), 0);
  out[9] = f32(rs_spell_dc(c)); out[10] = f32(rs_spell_attack(c)); out[11] = f32(c.cond);
  for l: 1..<10 { out[11 + l] = f32(c.slots[l]); out[20 + l] = f32(c.slots_max[l]); }
  out[30] = rs_clock_s(b);
  out[31] = ifx r[0].seat[0].open then 1.0f32 else 0.0f32;
  return E5R_HERO_FLOATS;
}

// What slot k does under the rules, one line for the bar's card: its name, its level, how it
// resolves, and whether it is a house rule.
e5r_describe :: (r: [] E5r, k: int, out: [] u8) -> int #export_c #effects(reads, writes, traps) {
  if !e5r_has(k) { return 0; }
  a := e5r_entry(r, k);
  n := 0;
  if a.kind == FB_WORLD { return 0; }
  if a.kind != FB_SPELL && k >= FB_CL0 { return e5r_feature_line(r, a, out); }
  if a.kind != FB_SPELL { return rs_put(out, 0, "Wild Resurgence: a spell slot for a use of Wild Shape, a Bonus Action"); }
  s := rs_spell(a.sp);
  n = rs_put(out, n, s.name);
  n = rs_put(out, n, ifx s.level == 0 then " · cantrip" else " · ");
  if s.level > 0 { n = rs_put(out, n, RS_ORDINAL[s.level]); n = rs_put(out, n, " level"); }
  for q: 0..<s.step_n {
    st := s.steps[q];
    if st.kind == RS_S_ATTACK { n = rs_put(out, n, " · spell attack +"); n = rs_put_int(out, n, rs_spell_attack(r[0].b[0].c[E5R_ME])); }
    if st.kind == RS_S_SAVE { n = rs_put(out, n, " · "); n = rs_put(out, n, RS_ABILITY[clamp_r(st.a, 0, 5)]); n = rs_put(out, n, " save DC "); n = rs_put_int(out, n, rs_spell_dc(r[0].b[0].c[E5R_ME])); }
    if st.kind == RS_S_DAMAGE {
      // the dice it rolls as the bar casts it: a cantrip's by your level, a spell's by its slot
      dice := ifx s.level == 0 then st.a * rs_cantrip_tier(r[0].b[0].c[E5R_ME].level) else st.a + st.d * rs_max(a.lvl - s.level, 0);
      if s.level == 0 && q > 0 && s.steps[0].kind == RS_S_REPEAT { dice = st.a; }
      n = rs_put(out, n, " · "); n = rs_put_int(out, n, dice); n = rs_put(out, n, "d"); n = rs_put_int(out, n, st.b);
      if s.plus > 0 { n = rs_put(out, n, " + "); n = rs_put_int(out, n, s.plus); }
      if s.level == 0 && r[0].b[0].c[E5R_ME].agonizing == a.sp { n = rs_put(out, n, " + "); n = rs_put_int(out, n, rs_mod(r[0].b[0].c[E5R_ME].score[RS_CHA])); n = rs_put(out, n, " (Agonizing Blast)"); }
    }
    if st.kind == RS_S_REPEAT { n = rs_put(out, n, " · "); n = rs_put_int(out, n, ifx st.c == 1 then st.a * rs_cantrip_tier(r[0].b[0].c[E5R_ME].level) else st.a); n = rs_put(out, n, " beams"); }
    if st.kind == RS_S_RISE { n = rs_put(out, n, " · a Humanoid it kills rises as your Zombie"); }
    if st.kind == RS_S_TELEPORT { n = rs_put(out, n, " · teleport up to 500 feet"); }
    if st.kind == RS_S_HEAL { n = rs_put(out, n, " · heals "); n = rs_put_int(out, n, st.a); n = rs_put(out, n, "d"); n = rs_put_int(out, n, st.b); }
  }
  if s.concentration { n = rs_put(out, n, " · concentration"); }
  if !s.srd { n = rs_put(out, n, " · house rule"); }
  return n;
}

// A Character Create class's feature, one line: its name and what the engine does with it.
e5r_feature_line :: (r: [] E5r, a: FbAb, out: [] u8) -> int {
  me := r[0].b[0].c[E5R_ME];
  n := rs_put(out, 0, a.name);
  if a.kind == FB_RAGE { n = rs_put(out, n, " · Bonus Action · +"); n = rs_put_int(out, n, me.rage_bonus); n = rs_put(out, n, " damage, Resistance to Bludgeoning, Piercing and Slashing"); }
  if a.kind == FB_SECOND { n = rs_put(out, n, " · Bonus Action · heals 1d10 + "); n = rs_put_int(out, n, me.level); }
  if a.kind == FB_LAY { n = rs_put(out, n, " · Bonus Action · up to "); n = rs_put_int(out, n, me.uses_max[RS_USE_LAY]); n = rs_put(out, n, " Hit Points from the pool"); }
  if a.kind == FB_ATTACK {
    n = rs_put(out, n, " · melee attack +"); n = rs_put_int(out, n, rs_weapon_attack(me, me.weapon));
    if me.sneak_dice > 0 { n = rs_put(out, n, " · Sneak Attack "); n = rs_put_int(out, n, me.sneak_dice); n = rs_put(out, n, "d6"); }
  }
  return n;
}

// ---- tests: the page's numbers in, the engine's out

#test "Everglade 5E: nothing on the bar runs out, and the Warlock's bar is the Warlock's" #steps 400000000 {
  r: [1] E5r;
  e5r_start(r[..], 7);
  b := r[0].b[..];
  #assert b[0].c[E5R_ME].hp == 57 && b[0].c[E5R_ME].ac == 15;
  bar: [FB_EG_SLOTS * E5R_SLOT_FLOATS] f32;
  #assert e5r_bar(r[..], bar[..]) == FB_EG_SLOTS;
  #assert bar[1 * E5R_SLOT_FLOATS] == f32(E5R_READY) && bar[1 * E5R_SLOT_FLOATS + 3] == f32(E5R_COST_ACTION) && bar[1 * E5R_SLOT_FLOATS + 1] == -1;
  #assert bar[47 * E5R_SLOT_FLOATS] == f32(E5R_READY) && bar[47 * E5R_SLOT_FLOATS + 3] == f32(E5R_COST_NONE);
  // down (the room's Hit Points at 0): the bar can't be used till you stand again
  e5r_you(r[..], 0, 0);
  _ := e5r_bar(r[..], bar[..]);
  #assert bar[1 * E5R_SLOT_FLOATS] == f32(E5R_CANT) && bar[47 * E5R_SLOT_FLOATS] == f32(E5R_READY);
  e5r_you(r[..], 30, 0);
  _ = e5r_bar(r[..], bar[..]);
  #assert bar[1 * E5R_SLOT_FLOATS] == f32(E5R_READY) && b[0].c[E5R_ME].hp == 30;
  hero: [E5R_HERO_FLOATS] f32;
  #assert e5r_hero(r[..], hero[..]) == E5R_HERO_FLOATS && hero[0] == 30 && hero[1] == 57;
  line: [300] u8;
  n := e5r_describe(r[..], 2, line[..]);
  #assert n > 20 && line[n - 1] == 'e';   // "... house rule"
  wbar: [FB_WL_SLOTS * E5R_SLOT_FLOATS] f32;
  _ = e5r_wbar(r[..], wbar[..]);
  #assert wbar[3 * E5R_SLOT_FLOATS] == f32(E5R_CANT);   // the druid has no Circle of Death
  e5r_class(r[..], 1);
  #assert b[0].c[E5R_ME].level == 17 && rs_spell_dc(b[0].c[E5R_ME]) == 19;
  #assert e5r_wbar(r[..], wbar[..]) == FB_WL_SLOTS && wbar[3 * E5R_SLOT_FLOATS] == f32(E5R_READY);
  #assert e5r_describe(r[..], FB_WL0 + 4, line[..]) > 30;
  e5r_class(r[..], 0);
  #assert !r[0].warlock && b[0].c[E5R_ME].level != 17;
  // a Character Create class: the SRD class at level 1, its one slot and Repair
  e5r_class(r[..], E5R_CL0 + FB_CL_CLERIC);
  #assert b[0].c[E5R_ME].level == 1 && b[0].c[E5R_ME].klass == RS_CLERIC && !r[0].warlock;
  #assert e5r_slot_of(r[0].klass, FB_CL0 + FB_CL_CLERIC) && e5r_slot_of(r[0].klass, 47) && !e5r_slot_of(r[0].klass, 1) && !e5r_slot_of(r[0].klass, FB_CL0 + FB_CL_BARD);
  #assert !e5r_slot_of(E5R_DRUID, FB_CL0) && !e5r_slot_of(E5R_WARLOCK, FB_CL0 + 10) && e5r_slot_of(E5R_WARLOCK, FB_WL0) && e5r_slot_of(E5R_DRUID, 3);
  n = e5r_describe(r[..], FB_CL0 + FB_CL_CLERIC, line[..]);
  #assert n > 20 && cast(string) line[0..<12] == "Sacred Flame";
  e5r_class(r[..], E5R_CL0 + FB_CL_ROGUE);
  n = e5r_describe(r[..], FB_CL0 + FB_CL_ROGUE, line[..]);
  #assert cast(string) line[0..<12] == "Sneak Attack" && cast(string) line[n - 3..<n] == "1d6";
  e5r_class(r[..], 99);
  #assert r[0].klass == E5R_DRUID;
}
