// Everglade 5E, openagents.com/worlds/everglade: Everglade on the SRD 5e engine. The
// page is Everglade's (everglade.coax, loaded as it is): its city, its people and watch, its
// character controller, its spell bar with the alike slots, pictures, keys and order, its spells'
// fire, smoke and lightning, and its room. What changes is who decides: each slot of the bar is an
// entry of the hotbar layer it shares with 5E MMO (fivebar.coax fb_everglade), and the SRD 5e engine
// (everglade5e-rules.coax, its own C unit) rolls what it does. This file is between the two:
//   - nothing on the bar is held back: no spell slots, actions or Bonus Actions run out (the rules
//     give each use a fresh turn), so every slot, Meteor Swarm too, can always be cast; a cast on
//     its way shows on its icon, dimmed from the top and shrinking to its strike (e5_sweeps);
//   - no quests and no guidance: Everglade's quest tracker, first goal, quest board and the guide's
//     button are off (EgGuide.quiet); the people still talk with E;
//   - a cast that lands (Everglade's cast bar and fall end) is the engine's to resolve, on the
//     creatures under it, at the point you aimed;
//   - the engine keeps Hit Points: what Everglade rolls for your blasts is put back, and the
//     engine's own damage and healing land instead (with Everglade's knock-downs and deaths, and the
//     numbers over heads); what the world deals otherwise (a guard's sword, a spear, the river) goes
//     through the engine too, so it meets your Temporary Hit Points and your concentration;
//   - your Hit Points and Armor Class are the engine's caster's (57 and 15);
//   - the room is the realm's (a fork's own, everglade-fork.coax fk_slug), and in it the room's server
//     is the world (everglade-net.coax): your casts and abilities go to it as intents, it rolls them,
//     and your Hit Points, the others', their creatures and zones are what it says.
// The face (everglade5e-face.c) passes the numbers between this file and the rules each frame.
//   coax/bin/coax test apps/openagents-web/everglade5e.coax --only "Everglade 5E"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "everglade.coax";

E5_SLOTS :: 49;            // fivebar.coax FB_EG_SLOTS: Everglade's bar, slot for slot
E5_SLOT_FLOATS :: 6;       // everglade5e-rules.coax E5R_SLOT_FLOATS
E5_HERO_FLOATS :: 32;
E5_READY :: 0; E5_NO_SLOT :: 1; E5_SPENT :: 2; E5_CANT :: 3;
E5_COST_NONE :: 0; E5_COST_ACTION :: 1; E5_COST_BONUS :: 2; E5_COST_REACTION :: 3;
E5_PENDING :: 8;
E5_RED :: [3] f32.[0.95, 0.32, 0.26];
E5_GREEN :: [3] f32.[0.45, 0.9, 0.42];
E5_CONDITION :: [15] string.["BLINDED", "CHARMED", "DEAFENED", "EXHAUSTION", "FRIGHTENED", "GRAPPLED", "INCAPACITATED", "INVISIBLE",
                             "PARALYZED", "PETRIFIED", "POISONED", "PRONE", "RESTRAINED", "STUNNED", "UNCONSCIOUS"];
E5_COND_BLINDED :: 1;
// A hash's staged state, for a check or a screenshot ("gate+held"): you held, bound, slowed, and a
// Meteor Swarm always on its way (its icon's sweep).
E5_FORCE_HELD :: 1; E5_FORCE_BOUND :: 2; E5_FORCE_SLOW :: 4; E5_FORCE_COOL :: 8;
E5_FORCE_TAIL :: [4] string.["+held", "+bound", "+slowed", "+cool"];
// The hash (n bytes in `h`) without its staging tails, which set v's force bits: the new length.
e5_hash :: (v: [] E5, h: [] u8, n: int) -> int #export_c {
  m := lo_int(n, h.count);
  again := true;
  while again {
    again = false;
    for f: 0..<4 {
      tail := E5_FORCE_TAIL[f];
      if m < tail.count { continue; }
      alike := true;
      for q: 0..<tail.count { if h[m - tail.count + q] != tail[q] { alike = false; break; } }
      if alike { v[0].force |= 1 << f; m -= tail.count; again = true; }
    }
  }
  return m;
}

E5 :: struct {
  bar: [E5_SLOTS * E5_SLOT_FLOATS] f32; bar_ok: bool;
  hero: [E5_HERO_FLOATS] f32; hero_ok: bool;
  // the bar's casts on their way (their icons' sweeps)
  pend_slot: [E5_PENDING] int; pend_x: [E5_PENDING] f32; pend_z: [E5_PENDING] f32; pend_due: [E5_PENDING] f32; pend_n: int;
  now: f32;
  cond: [WATCH_ACTORS + 1] int;   // the room's conditions: you (none of the page's own), then Everglade's people
  force: int;                // a hash's staged state (e5_hash): E5_FORCE_* bits
  fps: f32; ms: f32; fps_n: int; fps_t: f32;   // frames a second (e5_tick)
  card: [160] u8; card_n: int; card_slot: int;
  shown: [E5_HOLDS * (E5_LINE + 1)] u8; shown_n: int;   // the status lines as last drawn, "|" between (the drift check)
}

// The realm this page is (data-realm, or a fork's slug): its analytics name, and its room's.
e5_realm :: (s: [] Everglade) -> string #export_c { return fk_slug(s); }
e5_room_name :: (s: [] Everglade) -> string #export_c { return net_room(s, fk_slug(s)); }

e5_slot_f :: (v: [] E5, k: int, f: int) -> f32 { return v[0].bar[k * E5_SLOT_FLOATS + f]; }
// ---- each frame, before Everglade's

// The rules' numbers for the bar and for you (last frame's), and what everyone is before Everglade's
// frame, to put back what Everglade's own dice do to them. Everglade's numbers over heads are the
// engine's from here on (e5_take pops them), so its own pops are off.
// What a hash staged, kept up each frame: held (a Hold Person's round, again before its save), bound
// (an Earthbind no caster keeps), slowed, and a Meteor Swarm on its way far off (it strikes no one).
e5_staged :: (s: [] Everglade, v: [] E5) {
  f := v[0].force;
  if f == 0 { return; }
  w := watch_w(s);
  if watch_you(w[..])[0].dead { return; }
  if (f & E5_FORCE_HELD) != 0 && watch_you(w[..])[0].held_t < 1 { watch_you(w[..])[0].held_t = 3; watch_you(w[..])[0].held_saves = 0; }
  if (f & E5_FORCE_BOUND) != 0 { watch_you(w[..])[0].bound_kept = true; if watch_you(w[..])[0].bound_t < 5 { watch_you(w[..])[0].bound_t = 60; } }
  if (f & E5_FORCE_SLOW) != 0 && watch_you(w[..])[0].slow_t < 1 { watch_you(w[..])[0].slow_t = 6; }
  if (f & E5_FORCE_COOL) != 0 && v[0].pend_n == 0 && v[0].bar_ok { e5_pend(v, SP_METEOR, -100, -100); }
}
// In a room your death is the server's too (your p's DEAD bit): you fall and lie, the view darkens
// and says YOU DIED, and it holds until the server stands you up where you fell (room-events.coax
// EV_RISE_S); then the view comes back where you lie. Never the page's own respawn at the Road In,
// which the hold keeps short of (watch.coax: DEATH_FADE + DEATH_HOLD).
E5_DEATH_HOLD :: 0.5;   // s short of the page's own respawn the room's death waits at
e5_room_death :: (s: [] Everglade, w: [] Watch) {
  dead := net_self_dead(s);
  y := watch_you(w[..]);
  if dead == 1 {
    if !y[0].dead { y[0].dead = true; y[0].dead_t = 0; y[0].you_fall = 0; y[0].you_body.on = false; y[0].you_body.settle = -1; }
    y[0].hp = 0; y[0].temp = 0; y[0].respawn = false;
    hold := f32(DEATH_FADE) + f32(DEATH_HOLD) - f32(E5_DEATH_HOLD);
    if y[0].dead_t > hold { y[0].dead_t = hold; }
  } else if dead == 0 && y[0].dead {
    y[0].dead = false; y[0].dead_t = -f32(RISE_FADE); y[0].hurt_t = 100; y[0].respawn = false;
    y[0].you_body.on = false; y[0].you_body.settle = -1; y[0].you_fall = 0;
  }
}
e5_before :: (s: [] Everglade, v: [] E5, bar: [] f32, bar_n: int, hero: [] f32, hero_n: int, now: f32) #export_c {
  v[0].now = now;
  if bar_n == E5_SLOTS { for q: 0..<E5_SLOTS * E5_SLOT_FLOATS { v[0].bar[q] = bar[q]; } v[0].bar_ok = true; }
  if hero_n == E5_HERO_FLOATS { for q: 0..<E5_HERO_FLOATS { v[0].hero[q] = hero[q]; } v[0].hero_ok = true; }
  s[0].guide.quiet = true;   // no quests, no first goal, no quest board, no guide's button or lines
  if !s[0].started || !s[0].wv.started { return; }
  w := watch_w(s);
  e5_staged(s, v);
  if v[0].hero_ok {
    // your Hit Points and Armor Class are the engine's caster's: a new life starts at its most
    hmax := cast(int) v[0].hero[1];
    if watch_you(w[..])[0].max != hmax && hmax > 0 { watch_you(w[..])[0].hp = ifx watch_you(w[..])[0].hp >= watch_you(w[..])[0].max then hmax else hi_int(lo_int(watch_you(w[..])[0].hp, hmax), 1); watch_you(w[..])[0].max = hmax; }
    watch_you(w[..])[0].ac = cast(int) v[0].hero[3];
  }
  // in a room your Hit Points are the server's (everglade-net.coax): its player entity for you
  hp := net_self_hp(s); most := net_self_max(s);
  if hp >= 0 && most > 0 { watch_you(w[..])[0].max = most; watch_you(w[..])[0].hp = lo_int(hp, most); watch_you(w[..])[0].temp = 0; }
  e5_room_death(s, w);
  for i: 0..<WATCH_ACTORS { s[0].wv.seen[i].on = false; }
  s[0].wv.seen_you.on = false;
}

// ---- each frame, after Everglade's

// After Everglade's frame: nothing of its casts or harm is the page's to roll. The room (the local
// host offline, #12882) resolves every cast and every harm; this page's rules keep only your bar.
e5_after :: (s: [] Everglade, v: [] E5) #export_c { v[0].pend_n = 0; }
e5_pend :: (v: [] E5, b: int, x: f32, z: f32) {
  if v[0].pend_n >= E5_PENDING { return; }
  q := v[0].pend_n;
  v[0].pend_slot[q] = b; v[0].pend_x[q] = x; v[0].pend_z[q] = z;
  v[0].pend_due[q] = v[0].now + (ifx b >= WL_SLOT0 then WL_DELAY[clamp_i(b - WL_SLOT0, 0, WL_SLOTS - 1)] else ifx v[0].bar_ok then e5_slot_f(v, b, 4) else 0.0f32);
  v[0].pend_n += 1;
}
// The casts whose strike is now: slot, x, z, 3 floats each. They leave the queue.
e5_due :: (v: [] E5, out: [] f32) -> int {
  n := 0; kept := 0;
  for q: 0..<v[0].pend_n {
    if v[0].pend_due[q] <= v[0].now && (n + 1) * 3 <= out.count {
      out[n * 3] = f32(v[0].pend_slot[q]); out[n * 3 + 1] = v[0].pend_x[q]; out[n * 3 + 2] = v[0].pend_z[q];
      n += 1;
      continue;
    }
    v[0].pend_slot[kept] = v[0].pend_slot[q]; v[0].pend_x[kept] = v[0].pend_x[q]; v[0].pend_z[kept] = v[0].pend_z[q]; v[0].pend_due[kept] = v[0].pend_due[q];
    kept += 1;
  }
  v[0].pend_n = kept;
  return n;
}
// ---- where everyone is, for the rules

// You: x, z, Hit Points, Temporary Hit Points, dead (your Hit Points the room's: e5_before).
e5_me :: (s: [] Everglade, out: [] f32) -> int #export_c {
  if !s[0].started || out.count < 5 { return 0; }
  w := watch_w(s);
  you := ab_you(s);
  out[0] = you.x; out[1] = you.z; out[2] = f32(watch_you(w[..])[0].hp); out[3] = f32(watch_you(w[..])[0].temp); out[4] = ifx watch_you(w[..])[0].dead then 1.0f32 else 0.0f32;
  return 5;
}
// ---- the room's word, onto Everglade

// The town's conditions are the server's (each person's row's COND, #12876); Blinded is Everglade's
// blind. Everglade's own pops are off: what it saw is now.
e5_take :: (s: [] Everglade, v: [] E5) #export_c {
  if !s[0].started { return; }
  for i: 0..<WATCH_ACTORS { v[0].cond[1 + i] = net_folk(s, i).cond; }
  if !s[0].wv.started { return; }
  w := watch_w(s);
  for i: 0..<WATCH_ACTORS {
    if !watch_here(w, i) { continue; }
    w[0].actors[i].blind = w[0].actors[i].blind || (v[0].cond[1 + i] & E5_COND_BLINDED) != 0;
  }
  for i: 0..<WATCH_ACTORS { s[0].wv.seen[i].life = w[0].actors[i].hp + w[0].actors[i].temp; }
  s[0].wv.seen_you.life = watch_you(w[..])[0].hp + watch_you(w[..])[0].temp;
}
// The bar's card for slot k: the rules' one line on how it resolves (everglade5e-rules.coax e5r_describe).
e5_card :: (v: [] E5, k: int, text: string) #export_c {
  n := 0;
  for ch: text { if n >= 160 { break; } v[0].card[n] = ch; n += 1; }
  v[0].card_n = n; v[0].card_slot = k;
}
// Which slot's card to ask for: the armed one, else -1.
e5_card_slot :: (s: [] Everglade) -> int #export_c { return ifx s[0].started then s[0].sp.armed else -1; }

// ---- the room: each player's numbers on its chat

e5_put :: (out: [] u8, at: int, t: string) -> int {
  n := at;
  for ch: t { if n >= out.count { break; } out[n] = ch; n += 1; }
  return n;
}
e5_starts :: (t: string, head: string) -> bool {
  if t.count < head.count { return false; }
  for q: 0..<head.count { if t[q] != head[q] { return false; } }
  return true;
}
// ---- the HUD, over Everglade's

e5_text :: (out: [] f32, n: int, t: string, x: f32, y: f32, cap: f32, k: f32, light: f32, rgb: [3] f32) -> int {
  return draw_text(out, n, t, x, y, cap, GAP, SPACE, ink(k, light, rgb[0], rgb[1], rgb[2]), false, false);
}
E5_GOLD :: [3] f32.[0.86, 0.72, 0.42];
E5_PARCH :: [3] f32.[0.93, 0.9, 0.82];
E5_GREY :: [3] f32.[0.55, 0.53, 0.5];
// What Everglade 5E draws over Everglade's HUD (after everglade_finish_frame: `at` is its vertex count,
// and the plates go on), and nothing else: the screen stays clean (owner, November 3). Under your Hit
// Points, one short line for each thing that holds you while it lasts (e5_status); on the bar, the
// dimmed top of an icon whose cast is still on its way, shrinking to its strike (e5_sweeps); the armed
// slot's card over the bar; conditions over Everglade's people and the others' Hit Points over theirs;
// and the frame rate, small, at the bottom right (e5_fps_draw).
e5_finish :: (s: [] Everglade, v: [] E5, out: [] f32, u: [] f32, at: int) -> int #export_c {
  n := at;
  // EDIT: Aethyrforge's panels alone, as on Everglade (everglade-forge.coax)
  if !s[0].started || at <= 0 || u.count < UNIFORM_FLOATS || forge_on(s) { return n; }
  if rp_hud_off(s) { u[5] = f32(s[0].plate_n); return n; }   // the raid preview's flight (everglade-raid-preview.coax)
  if sp_on(s) && !s[0].above && v[0].hero_ok { n = e5_play_hud(s, v, out, u, n); }
  n = e5_fps_draw(s, v, out, n);
  u[5] = f32(s[0].plate_n);
  return n;
}
e5_play_hud :: (s: [] Everglade, v: [] E5, out: [] f32, u: [] f32, at: int) -> int {
  n := at;
  k := hi(s[0].dpr, 0.5);
  wd := s[0].width; ht := s[0].height;
  cap := 6.5 * k;
  line: [120] u8;
  ln := 0;
  v[0].shown_n = 0;
  if s[0].wv.started && !eg_pane_open(s) { n = e5_status(s, v, out, u, n); }
  e5_sweeps(s, v);
  // the armed slot's card, over the bar
  top := ht;
  for b: 0..<SP_REBUILD { if s[0].sp.boxes[b].x1 > s[0].sp.boxes[b].x0 { top = lo(top, s[0].sp.boxes[b].y0); } }
  cy := top - 44 * k;
  if v[0].card_n > 0 && s[0].sp.armed == v[0].card_slot && v[0].card_slot >= 0 {
    t := cast(string) v[0].card[0..<v[0].card_n];
    tw := text_width(t, cap);
    plate(s, u, Box.{x0 = (wd - tw) / 2 - 12 * k, y0 = cy - cap - 9 * k, x1 = (wd + tw) / 2 + 12 * k, y1 = cy + 7 * k}, 0.8, 0);
    n = e5_text(out, n, t, (wd - tw) / 2, cy, cap, k, 0.95, E5_GOLD);
  }
  // conditions over Everglade's people, and the others' Hit Points over theirs
  if s[0].wv.started {
    w := watch_w(s);
    for i: 0..<WATCH_ACTORS {
      // one word while it lasts, the strongest (everglade-status.coax st_head_word): the rules' own,
      // or in a room the server's (e5_take: the person's row's COND)
      word := st_head_word(v[0].cond[1 + i]);
      if word < 0 || !watch_here(w, i) || w[0].actors[i].mode == WM_DEAD { continue; }
      sc := on_screen(u, add(watch_pop_head(s, i), v3(0, 0.5, 0)), wd, ht);
      if !sc.ok || sc.w > 60 { continue; }
      t := POP_WORDS[word]; wc := cap * 1.3; tw := text_width(t, wc);
      if s[0].plate_n < PLATES - 6 { plate(s, u, Box.{x0 = sc.x - tw / 2 - 6 * k, y0 = sc.y - wc - 6 * k, x1 = sc.x + tw / 2 + 6 * k, y1 = sc.y + 5 * k}, 0.78, PLATE_SHADE); }
      rgb := watch_pop_rgb(word);
      s[0].st_words |= 1 << word;
      n = draw_text(out, n, t, sc.x - tw / 2, sc.y, wc, GAP, SPACE, Ink.{core = 1.0 * k, light = 1, glow = 0.7 * k, red = rgb.x, green = rgb.y, blue = rgb.z, mode = 0, scale = k}, false, false);
    }
  }
  // the other players' Hit Points, as the room's server has them: a line just over their nameplate
  // (everglade-rangers.coax remote_plate_for), as near as it shows, none for a player you block
  for i: 0..<net_count(s, WK_PLAYER) {
    o := net_view(s, WK_PLAYER, i);
    if !o.ok || o.max <= 0 || net_blocks(s, net_view_id(s, WK_PLAYER, i)) { continue; }
    hp_at := e5_hp_at(s, o);
    if flat_gap(hp_at, ab_you(s)) > f32(REMOTE_PLATE_NEAR) { continue; }
    sc := on_screen(u, hp_at, wd, ht);
    if !sc.ok || sc.w > 60 { continue; }
    sc.y -= cap * 1.7;
    ln = put_digits(line[..], 0, hi_int(o.hp, 0));
    ln = e5_put(line[..], ln, " / ");
    ln = put_digits(line[..], ln, o.max);
    ln = e5_put(line[..], ln, " HP");
    t := cast(string) line[0..<ln];
    n = e5_text(out, n, t, sc.x - text_width(t, cap) / 2, sc.y, cap, k, 0.9, ifx o.hp > 0 && o.alive then E5_GREEN else E5_RED);
  }
  return n;
}
// Where another player's Hit Points go: at their nameplate (the line itself is drawn just over it).
e5_hp_at :: (s: [] Everglade, o: NetView) -> Point { return remote_plate_for(s, o.eid, v3(o.x, o.y, o.z)); }
// The names of conditions in bits `c`, in a row.
e5_conds :: (out: [] f32, at: int, c: int, x: f32, y: f32, cap: f32, k: f32) -> int {
  n := at; cx := x;
  for q: 0..<15 {
    if (c & (1 << q)) == 0 { continue; }
    n = e5_text(out, n, E5_CONDITION[q], cx, y, cap, k, 0.95, E5_RED);
    cx += text_width(E5_CONDITION[q], cap) + 8 * k;
  }
  return n;
}

E5_HOLDS :: 4;
E5_HOLD_RGB :: [12] f32.[1, 0.82, 0.36,   0.86, 0.6, 0.34,   0.62, 0.86, 1,   0.95, 0.42, 0.36];
// What holds you now, a short line each (E5_HOLDS at most): HELD · HOLD PERSON · 2 S (you can't move
// till your Wisdom save at its end), BOUND · EARTHBIND · 58 S (you can't rise or fly), SLOWED · RAY OF
// FROST · 4 S (two thirds of your pace), and the engine's own on you (Restrained, Grappled, Prone...).
// Into `lines` (E5_LINE bytes each), their colour index into `tone`; how many.
E5_LINE :: 48;
e5_holds :: (s: [] Everglade, v: [] E5, lines: [] u8, sizes: [] int, tone: [] int) -> int {
  // the status state (everglade-status.coax): the room's, or offline the page's own watch
  t := s[0].status[..];
  c := 0;
  for i: 0..<t[0].n {
    if t[0].e[i].who != ST_YOU || c >= E5_HOLDS { continue; }
    m := st_line(s, i, lines[c * E5_LINE..<(c + 1) * E5_LINE]);
    if m > 0 { sizes[c] = m; tone[c] = st_tone(t[0].e[i].cond); c += 1; }
  }
  // the engine's conditions on you (none of Everglade's: Blinded and Deafened have their own words):
  // the room's in your COND (the local host's offline, #12882)
  ec := st_cond(s, ST_YOU) & 32767 & (-1 ^ st_named(s, ST_YOU));   // (a line above says those)
  if c < E5_HOLDS && ec != 0 {
    m := 0;
    for q: 0..<15 {
      if q == 0 || q == 2 || (ec & (1 << q)) == 0 { continue; }
      if m > 0 { m = e5_put(lines[c * E5_LINE..<(c + 1) * E5_LINE], m, " · "); }
      m = e5_put(lines[c * E5_LINE..<(c + 1) * E5_LINE], m, E5_CONDITION[q]);
    }
    if m > 0 { sizes[c] = m; tone[c] = 3; c += 1; }
  }
  return c;
}
e5_hold_line :: (out: [] u8, head: string, left: f32) -> int {
  m := e5_put(out, 0, head);
  m = put_digits(out, m, hi_int(cast(int) -floor(-left), 1));
  return e5_put(out, m, " S");
}
// The status lines as last drawn ("" none), for a headless check.
e5_shown :: (v: [] E5) -> string #export_c { return cast(string) v[0].shown[0..<v[0].shown_n]; }
// The lines, small, right under your Hit Points (and WANTED), each in its own plate.
e5_status :: (s: [] Everglade, v: [] E5, out: [] f32, u: [] f32, at: int) -> int {
  lines: [E5_HOLDS * E5_LINE] u8; sizes: [E5_HOLDS] int; tone: [E5_HOLDS] int;
  c := e5_holds(s, v, lines[..], sizes[..], tone[..]);
  v[0].shown_n = 0;
  for q: 0..<c {
    if q > 0 { v[0].shown[v[0].shown_n] = '|'; v[0].shown_n += 1; }
    for i: 0..<sizes[q] { v[0].shown[v[0].shown_n] = lines[q * E5_LINE + i]; v[0].shown_n += 1; }
  }
  n := at;
  if c == 0 { return n; }
  k := hi(s[0].dpr, 0.5);
  gutter := 16 * k;
  cap := 7 * k;
  // watch_hud: MAP is 38 high at the top, HP 28 under it, WANTED 37 under that
  y := gutter + 38 * k + 10 * k + 28 * k + 8 * k;
  if watch_you(watch_w(s))[0].wanted { y += 9 * k + 28 * k; }
  x1 := s[0].width - gutter;
  for q: 0..<c {
    t := cast(string) lines[q * E5_LINE..<q * E5_LINE + sizes[q]];
    tw := text_width(t, cap);
    b := Box.{x0 = x1 - tw - 22 * k, y0 = y, x1 = x1, y1 = y + cap + 16 * k};
    plate(s, u, b, 0.82, 0);
    rgb := [3] f32.[E5_HOLD_RGB[tone[q] * 3], E5_HOLD_RGB[tone[q] * 3 + 1], E5_HOLD_RGB[tone[q] * 3 + 2]];
    n = e5_text(out, n, t, b.x0 + 11 * k, b.y1 - 8 * k, cap, k, 0.95, rgb);
    y = b.y1 + 5 * k;
  }
  return n;
}

// ---- the bar: a cast on its way, on its icon

// The share of slot b's cast still to go before it strikes (0 none on its way): the latest of its
// casts in the queue, over the slot's time from press to strike.
e5_left :: (v: [] E5, b: int) -> f32 {
  if !v[0].bar_ok || b < 0 || b >= E5_SLOTS { return 0; }
  whole := e5_slot_f(v, b, 4);
  if !(whole > 0.05) { return 0; }
  most := 0.0f32;
  for q: 0..<v[0].pend_n { if v[0].pend_slot[q] == b { most = hi(most, clamp01((v[0].pend_due[q] - v[0].now) / whole)); } }
  return most;
}
// For each slot with a cast on its way: its icon's top part again, dimmed, over the icon (the host's
// "over" line with a brightness and a band, coax/web/host.js), shrinking upward to nothing at the strike.
// The icon's picture is the bar's own line for it this frame (everglade-arrange.coax ar_icon).
E5_DIM :: 30;   // the dimmed part's brightness, in hundredths
e5_sweeps :: (s: [] Everglade, v: [] E5) {
  m := ifx s[0].sp.media_big.count > 0 then s[0].sp.media_big else s[0].sp.media[..];
  for b: 0..<SP_REBUILD {
    f := e5_left(v, b);
    bx := s[0].sp.boxes[b];
    if f <= 0.002 || bx.x1 <= bx.x0 { continue; }
    ic := e5_icon_in(m, s[0].sp.media_n, bx);
    if ic.n <= 0 { continue; }
    n := s[0].sp.media_n;
    if n + ic.n + 80 > m.count { return; }
    if n > 0 { m[n] = 10; n += 1; }
    n = e5_put(m, n, "over ");
    for q: 0..<ic.n { m[n] = m[ic.at + q]; n += 1; }
    y1 := ic.y0 + floor((ic.y1 - ic.y0) * f + 0.5);
    e := [4] int.[cast(int) ic.x0, cast(int) ic.y0, cast(int) ic.x1, cast(int) y1];
    for i: 0..<4 { n = e5_put(m, n, " "); if e[i] < 0 { n = e5_put(m, n, "-"); } n = put_digits(m, n, abs_int(e[i])); }
    n = e5_put(m, n, " "); n = put_digits(m, n, E5_DIM);
    n = e5_put(m, n, " 0 "); n = put_digits(m, n, cast(int) floor(f * 1000 + 0.5));
    s[0].sp.media_n = n;
  }
}
abs_int :: (a: int) -> int { return ifx a < 0 then -a else a; }
E5Icon :: struct { at: int; n: int; x0: f32; y0: f32; x1: f32; y1: f32; }
// The first "image" line in the media whose box lies in box b: where its URL is, and its box.
e5_icon_in :: (m: [] u8, count: int, b: Box) -> E5Icon {
  i := 0;
  end := lo_int(count, m.count);
  while i < end {
    e := i; while e < end && m[e] != 10 { e += 1; }
    if e - i > 6 && m[i] == 'i' && m[i + 1] == 'm' && m[i + 2] == 'a' && m[i + 4] == 'e' && m[i + 5] == ' ' {
      u0 := i + 6; while u0 < e && m[u0] == ' ' { u0 += 1; }
      u1 := u0; while u1 < e && m[u1] != ' ' { u1 += 1; }
      num: [4] f32; got := 0; p := u1;
      while got < 4 && p < e {
        while p < e && m[p] == ' ' { p += 1; }
        neg := p < e && m[p] == '-';
        if neg { p += 1; }
        val := 0;
        while p < e && m[p] >= '0' && m[p] <= '9' { val = val * 10 + cast(int) (m[p] - '0'); p += 1; }
        num[got] = f32(ifx neg then -val else val); got += 1;
      }
      if got == 4 && num[0] >= b.x0 - 1 && num[1] >= b.y0 - 1 && num[2] <= b.x1 + 1 && num[3] <= b.y1 + 1 && num[2] - num[0] > 4 {
        return E5Icon.{at = u0, n = u1 - u0, x0 = num[0], y0 = num[1], x1 = num[2], y1 = num[3]};
      }
    }
    i = e + 1;
  }
  return E5Icon.{};
}

// ---- frames a second

// The face's own frame time, each frame: frames a second and milliseconds, over each half second.
e5_tick :: (v: [] E5, dt: f32) #export_c {
  if !(dt > 0) || dt > 1 { return; }
  v[0].fps_n += 1; v[0].fps_t += dt;
  if v[0].fps_t >= 0.5 { v[0].fps = f32(v[0].fps_n) / v[0].fps_t; v[0].ms = v[0].fps_t * 1000 / f32(v[0].fps_n); v[0].fps_n = 0; v[0].fps_t = 0; }
}
// Small, at the bottom right: green at 50 and up, gold at 30, red under; above the bar where the
// bar reaches that corner (a phone's), and never in the golden (it has no clock).
e5_fps_draw :: (s: [] Everglade, v: [] E5, out: [] f32, at: int) -> int {
  if s[0].guide.golden || v[0].fps <= 0 { return at; }
  k := hi(s[0].dpr, 0.5);
  gutter := 16 * k; cap := 7 * k;
  fl: [72] u8;
  tenths := cast(int) (v[0].ms * 10 + 0.5);
  fm := put_digits(fl[..], 0, cast(int) (v[0].fps + 0.5)); fm = e5_put(fl[..], fm, " FPS  ");
  fm = put_digits(fl[..], fm, tenths / 10); fm = e5_put(fl[..], fm, "."); fm = put_digits(fl[..], fm, tenths % 10); fm = e5_put(fl[..], fm, " MS");
  // in a room: what the server sends you a second, and the most it sends (its byte budget, W)
  if net_rejoining(s) { fm = e5_put(fl[..], fm, "  NET · REJOINING"); }   // the room dropped: its kit and level stay while the page gets back in
  else if net_live(s) {
    n := net_of(s);
    fm = e5_put(fl[..], fm, "  NET "); fm = put_digits(fl[..], fm, (n[0].rate + 512) / 1024);
    fm = e5_put(fl[..], fm, " OF "); fm = put_digits(fl[..], fm, (n[0].budget * n[0].hz + 512) / 1024); fm = e5_put(fl[..], fm, " KB/S");
  }
  t := cast(string) fl[0..<fm];
  tw := text_width(t, cap);
  x0 := s[0].width - gutter - tw; y := s[0].height - 10 * k;
  for b: 0..<SP_BAR + 1 {
    bx := s[0].sp.boxes[b];
    if bx.x1 <= bx.x0 { continue; }
    if bx.x1 > x0 - 6 * k && bx.y1 > y - cap - 6 * k { y = lo(y, bx.y0 - 8 * k); }
  }
  // to the left of the graphics tier, on its line (everglade-quality.coax eg_quality_hud)
  if s[0].q_box.x1 > s[0].q_box.x0 { x0 = s[0].q_box.x0 - 6 * k - tw; y = s[0].q_base; }
  rgb := ifx v[0].fps >= 50 then E5_GREEN else ifx v[0].fps >= 30 then E5_GOLD else E5_RED;
  return e5_text(out, at, t, x0, y, cap, k, 0.9, rgb);
}
#test "Everglade 5E: the rules hold every one of the town's people the watch can call in, its responders too (#12794)" {
  // the rules' unit is apart: its E5R_FOLK (everglade5e-rules.coax) and the room's WORLD_FOLK are 47
  #assert WATCH_ACTORS == 47 && WATCH_ACTORS == EG_SPOTS + WATCH_NEW + WATCH_REIN && WATCH_REIN >= ladder_size(WANTED_LEVELS);
}
#test "Everglade 5E: a cast on its way dims the top of its icon, shrinking to its strike" {
  v: [1] E5;
  v[0].bar[0 * E5_SLOT_FLOATS + 4] = 3.6;                     // Meteor Swarm strikes 3.6 s on
  v[0].bar_ok = true;
  v[0].now = 10;
  #assert e5_left(v[..], 0) == 0;
  e5_pend(v[..], 0, 5, 6);
  v[0].now = 11.8;
  #assert e5_left(v[..], 0) > 0.49 && e5_left(v[..], 0) < 0.51 && e5_left(v[..], 1) == 0;
  out: [24] f32;
  v[0].now = 13.7;
  #assert e5_due(v[..], out[..]) == 1 && e5_left(v[..], 0) == 0;
  // the icon's line found in the bar's media, and the dimmed band written after it
  m := "image /worlds/everglade/hotbar/meteor-swarm-72.jpg 100 800 172 872\nimage /worlds/everglade/hotbar/key-0-0-72.jpg 100 800 120 812";
  buf: [400] u8;
  for q: 0..<m.count { buf[q] = m[q]; }
  ic := e5_icon_in(buf[..], m.count, Box.{x0 = 96, y0 = 796, x1 = 176, y1 = 876});
  #assert ic.n > 10 && ic.x0 == 100 && ic.y1 == 872 && buf[ic.at] == '/';
  #assert e5_icon_in(buf[..], m.count, Box.{x0 = 300, y0 = 796, x1 = 376, y1 = 876}).n == 0;
}
#test "Everglade 5E: a hash's +held, +bound, +slowed and +cool come off it and stage what they say" {
  v: [1] E5;
  h: [40] u8;
  t := "gate+held+slowed";
  for q: 0..<t.count { h[q] = t[q]; }
  #assert e5_hash(v[..], h[..], t.count) == 4 && v[0].force == E5_FORCE_HELD + E5_FORCE_SLOW;
}
#test "Everglade 5E: EDIT is Aethyrforge's panels alone, the frame rate and the rest gone" #steps 530000000 {
  s: [1] Everglade; v: [1] E5;
  everglade_start(s[..]);
  s[0].width = 1600; s[0].height = 900; s[0].dpr = 1;
  s[0].sp.on = true; s[0].sp.ready = true;
  dm: [1] DemoWorld; s[0].sp.dm = dm[..];
  v[0].hero_ok = true; v[0].bar_ok = true; v[0].hero[3] = 15; v[0].fps = 60; v[0].ms = 16.7;
  out: [60000 * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  #assert e5_finish(s[..], v[..], out[..], u[..], 6) > 6;
  everglade_message(s[..], MSG_VIEWER, "A|1\n");
  #assert everglade_key(s[..], 'b', 0) && forge_on(s[..]);
  #assert e5_finish(s[..], v[..], out[..], u[..], 6) == 6;
}
#test "Everglade 5E: in a room you die when the server says so, lie past the page's own respawn, and stand where you fell when it says" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  room: [1] NetTestRoom;
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  w := watch_w(a[..]);
  you := watch_you(w[..]);
  you[0].hp = 9; you[0].max = 9;
  // the server's word: alive, then dead
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = 0, kind = WK_PLAYER, owner = 0, x = 3, z = -70, g = WG_GROUND, hp = 9, max = 9});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  e5_room_death(a[..], w);
  #assert !you[0].dead;
  net_test_tick(room[..], 2, 0);
  net_test_s(room[..], WireS.{id = 0, kind = WK_PLAYER, owner = 0, x = 3, z = -70, g = WG_GROUND | WG_DEAD, hp = 0, max = 9});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  e5_room_death(a[..], w);
  #assert you[0].dead && you[0].dead_t == 0 && you[0].hp == 0 && !you[0].you_body.on;
  // 8 s on, still dead on the server: held short of the page's own respawn
  you[0].dead_t = 8;
  e5_room_death(a[..], w);
  #assert you[0].dead && you[0].dead_t < f32(DEATH_FADE) + f32(DEATH_HOLD) - 0.25 && !you[0].respawn;
  // the room's frame runs the fall and the dark: a second on, you have fallen further and it is darker
  you[0].dead_t = 0.2; you[0].you_fall = 0;
  f0 := watch_you_fall(w); d0 := watch_dark(w);
  for q: 0..<60 { watch_net_you(w, 1.0 / 60.0); }
  #assert watch_you_fall(w) != f0;
  #assert watch_dark(w) > d0 && you[0].dead_t > 1.1;
  // the server stands you up: the view comes back, no respawn at the Road In
  net_test_tick(room[..], 3, 0);
  net_test_s(room[..], WireS.{id = 0, kind = WK_PLAYER, owner = 0, x = 3, z = -70, g = WG_GROUND, hp = 9, max = 9});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  e5_room_death(a[..], w);
  #assert !you[0].dead && you[0].dead_t < 0 && !you[0].respawn;
  for q: 0..<60 { watch_net_you(w, 1.0 / 60.0); }
  #assert you[0].dead_t == 0 && watch_dark(w) == 0;
}
#test "Everglade 5E: in a room a townsperson's conditions are the server's, with the rest of their row (#12876)" {
  a: [1] Everglade; na: [1] EgNet;
  #assert net_test_page(a[..], na[..], 0, "pa", 100) && net_test_hear(a[..], 0, "y 0 1 5000100");
  room: [1] NetTestRoom;
  net_test_world(room[..], 0);
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  v: [1] E5;
  // person 2 held (Hold Person paralyzes), person 5 free
  net_test_tick(room[..], 1, 0);
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + 2, kind = WK_FOLK, x = 4, z = -70, hp = 9, max = 9, p1 = 2, cond = WC_PARALYZED});
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + 5, kind = WK_FOLK, x = 6, z = -70, hp = 9, max = 9, p1 = 5});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  #assert net_folk(a[..], 2).cond == WC_PARALYZED;
  a[0].started = true;
  e5_take(a[..], v[..]);
  #assert v[0].cond[1 + 2] == WC_PARALYZED && v[0].cond[1 + 5] == 0 && v[0].cond[1 + 3] == 0;
  // freed: the next row says so
  net_test_tick(room[..], 2, 0);
  net_test_s(room[..], WireS.{id = NET_FOLK_ID + 2, kind = WK_FOLK, x = 4, z = -70, hp = 9, max = 9, p1 = 2});
  #assert net_test_hear(a[..], 0, net_test_frame(room[..]));
  e5_take(a[..], v[..]);
  #assert v[0].cond[1 + 2] == 0;
}
#test "Everglade 5E: another player's Hit Points sit at their nameplate, not half a metre over it" {
  s: [1] Everglade;
  s[0].rangers[0].plates = 0;
  plate_put(s[0].rangers[..], 4, v3(1, 3.1, 2), 1);
  o := NetView.{ok = true, eid = 4, x = 1, y = 1, z = 2, max = 9, hp = 9};
  #assert e5_hp_at(s[..], o).y == 3.1;   // the posed body's plate (a lying body's sits low: there too)
  o.eid = 7;
  #assert e5_hp_at(s[..], o).y == 3.2;   // no body posed: where its name would be, 2.2 m over its feet
}
#test "Everglade 5E: no place name is drawn over the raid's banner" #steps 900000000 {
  g: [1] Everglade; nn: [1] EgNet;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  everglade_start(g[..]);
  everglade_catalog(g[..], CATALOG);
  everglade_attach_net(g[..], nn[..]);
  _ := everglade_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, -84, 0, 0, 0, 0, false, 0, 0, 0, 0);
  you := v3(0, 0, -84);
  clear := labels(g[..], out[..], u[..], 0, you);
  #assert clear > 0;   // the South Gate and the rest, ahead
  ege_of(g[..])[0].banner_box = Box.{x0 = 0, y0 = 0, x1 = 1280, y1 = 800};
  #assert labels(g[..], out[..], u[..], 0, you) == 0;   // a banner over all of it: none
  ege_of(g[..])[0].banner_box = Box.{};
  #assert labels(g[..], out[..], u[..], 0, you) == clear;
}
