// Everglade Experimental's combat (#13025): your class's level 1–6 kit on the hotbar, keys 1 to 9,
// against the Bestiary monsters that hunt you (verse/experimental-hostiles.coax), and CLASSES, a
// column under the ANIMATIONS browser that sets your class and reloads the bar.
//
// Every roll is the SRD 5e engine's (aethyr/rules/srd/), through the hotbar layer Everglade 5E
// plays on (fivebar.coax: fb_cl_hero, fb_cl_ability, fb_seat_use). You are creature 0, the engine's
// selected-level hero of your class; the village and dungeon bodies map to creatures 1 through
// XC_FOES by stable index. The page
// rolls offline, as Experimental runs: there is no room. Before each use the monsters stand on the
// engine's squares as they stand round you in metres (one square 5 feet, 1.524 m), so its reach
// and ranges are the world's.
//
// Slot 1 is the class's ability from Character Create (#13024): its picture and card are
// realms/everglade/hotbar/cl-*. The rest is the supported class kit through the selected level,
// with abilities that work without an ally and pictures and cards from
// realms/5e-mmo/hotbar/. As on Everglade's bar, nothing runs out: every slot and use comes back for
// each press. One second passes between presses (XC_COOL).
//
// Aim: everything goes the way you face (xc_aim): bolts fly straight ahead, blows strike ahead of
// you, and nothing behind or beside you is picked for you. A heal is yours: what it heals is added
// through the same shared Hit Points and Temporary Hit Points as hostile attacks.
//
// Weapons: a melee class holds its weapon in the right hand (xc_kit; charactercreator.coax
// held_weapon). A blow with it is an Aethyr action (aethyr/action/, #12993): the swing's clip is its
// definition, timed in fixed 1/64 s ticks, with a sensor window round the swing's impact. Each tick
// of that window the blade's actual pose (the swing clip's baked hands through the same weapon matrix
// that draws it, sampled within the tick) sweeps the monsters' hurt capsules; the first accepted
// contact is the monster the SRD Attack resolves against, once per swing however the frames fall
// (xc_swing_step). A swing whose window closes on no one swings at the air. Before the bake is ready
// (and in checks) the blade follows a declared fallback arc ahead of you and the fallback is counted.
//
// A monster at 0 Hit Points dies: it stops, a puff of dust rises, and it sinks into the ground over
// XC_SINK seconds (charactercreator.coax scene).
//
// The monsters' stat blocks are the world's own (fb_folk), so a level 1 caster can fell one: Imp,
// AC 13 and 10 Hit Points (the SRD's Imp is immune to fire); Gremlin, AC 12 and 13 Hit Points.
//   coax/bin/coax test --library apps/openagents-web/fivelab.coax --only "experimental combat"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "fivebar.coax";
#load "../../aethyr/rules/srd/press-budget.coax";
#load "class-kit.coax";   // the class kits, their aim and sounds, shared with Everglade II and its room (#13058)
#load "class-look.coax";  // their looks, the spells' colours and the bar's boxes, shared with Everglade II
#load "../../verse/experimental-terrain.coax" as xmeadow;
#load "../../aethyr/action/action.coax" as act;
#load "../../aethyr/action/sensor.coax" as sense;
#load "../../aethyr/query.coax" as aq;
#load "../../aethyr/cam/attention.coax" as attn;   // the cone spell's monster is the shared attention answer (#12994)
#load "../../aethyr/action/react.coax" as react;   // hit stops and the presentation queue (#13027)

XC_FOES :: hostile.HS_N;      // the village's six and the dungeon's (verse/experimental-hostiles.coax)
XC_SIDE :: 48; XC_MID :: 24;   // the engine's grid round you, squares (73 m a side)
XC_AWAY :: -1000;
XC_SQ :: 1.524;
XC_SINK :: 2.4;                // seconds a fallen monster takes to sink away
XC_PLAYER_MAX :: 44;           // legacy body-only fixture HP; live HP is the selected class's shared state
XC_FLOATS :: 8;
// the CLASSES column, CSS px: its header, its rows, the gap above it
XC_HEAD :: 32.0; XC_ROW :: 24.0; XC_ROWS_TOP :: 40.0; XC_GAP :: 8.0;

XcWave :: struct { x: f32; z: f32; y: f32; fx: f32; fz: f32; left: f32; right: f32; near: f32; far: f32; }
XcFloat :: struct { on: bool; x: f32; y: f32; z: f32; t0: f32; text: [12] u8; n: int; heal: bool; }
XcCombat :: struct {
  started: bool; klass: int = 11; level: int = 1;
  dash_until: f32 = -1; dash_face: f32;
  wave: XcWave; wave_until: f32 = -1;
  bar: [XC_SLOTS] FbAb; bar_n: int;
  order: [12] [XC_SLOTS] int; order_n: [12] int;
  arranging: bool; order_dirty: bool; drag_x: f32; drag_y: f32;
  b: [1] RsBattle; seat: [1] FbSeat;
  target: int = -1;                 // the monster struck at last (0 to 5), -1 none: its Hit Points over the bar
  cool_at: f32 = -100;              // when the last press was
  used: int = -1;                   // the slot pressed last
  u: [36] f32; w: f32; h: f32; k: f32; seen: bool;   // the last frame's camera and screen
  open: bool = true;                // the CLASSES column is open
  top: f32;                         // its top, device px
  hover: int = -1;                  // the bar's slot under the pointer
  down: int = -100; down_x: f32; down_y: f32; down_id: int;
  media: [16384] u8; media_n: int;   // the bar's pictures for the host (coaxial_media)
  fl: [XC_FLOATS] XcFloat;
  casts: int; landed: int; kills: int; refused: int; last_dmg: int;   // for the checks (lab_creator_probe 900+)
  whiffs: int;                      // bolts that flew to their range and blows that met no one
  fizzle: int = -1; fizzle_at: f32 = -100;   // the slot whose spell found no one ahead, and when (its icon flashes)
  seeded: bool;                     // the dice mixed with the clock at the first press, so each visit rolls its own
  pend: int = -1;                   // a blow swinging: its slot (xc_swing_step), -1 none
  swing_def: act.ActionDef; swing: act.ActionInstance; swing_tick: int = -1;   // its action and the last tick sensed
  swing_struck: bool; swing_next: int = 1; ledger: sense.HitLedger;
  contacts: int; fallbacks: int; exhausted: int;   // accepted blade contacts; ticks sensed on the fallback arc; ticks refused as too much work
  blade_step: f32;                  // the largest blade-end move in one tick so far, metres (lab_creator_probe 933, mm)
  lock: attn.AttnState;             // your target, held through attention (xc_lock_step): target is its answer
  stops: react.Stops;               // hit stops in force: a struck monster pauses, and a monster that strikes you
  present: react.PresentQueue;      // this frame's numbers, through react_present's caps
  npc_seat: [XC_FOES] FbSeat;
  seen_hits: int;                   // the monsters' landed blows already given their hit stop
  shown: int; suppressed: int;      // numbers shown and suppressed (lab_creator_probe 934, 935)
}
XC_TICK :: 64.0;           // aethyr/loop.coax: ticks a second
XC_BLADE_R :: 0.12;        // m: a blade's sensor radius
XC_BLADE_TIP :: [4]f32.[1.0,1.25,0.9,0.6];   // m from the weapon's origin to its tip (CC_KITS order)
XC_WINDOW :: 6;            // ticks the sensor is open either side of the swing's impact

xc_imp :: () -> RsCreature { return fb_folk("Imp", 1, 13, 10, [6] int.[6, 17, 13, 11, 12, 14]); }
xc_gremlin :: () -> RsCreature { return fb_folk("Gremlin", 1, 12, 13, [6] int.[12, 14, 12, 8, 10, 6]); }
// The dungeon's bigger monsters (verse/experimental-dungeon.coax DG_KIND_*): their AC and Hit
// Points are experimental-hostiles.coax's HS_FIEND, HS_BRUTE and HS_BOSS.
xc_foe :: (kind: int) -> RsCreature {
  if kind == xdungeon.DG_KIND_FIEND { return fb_folk("Imp Fiend", 1, hostile.HS_FIEND.ac, hostile.HS_FIEND.hp, [6] int.[8, 17, 14, 11, 12, 14]); }
  if kind == xdungeon.DG_KIND_BRUTE { return fb_folk("Puglin Brute", 1, hostile.HS_BRUTE.ac, hostile.HS_BRUTE.hp, [6] int.[17, 11, 15, 6, 10, 7]); }
  if kind == xdungeon.DG_KIND_BOSS { return fb_folk("Puglin Warlord", 1, hostile.HS_BOSS.ac, hostile.HS_BOSS.hp, [6] int.[19, 12, 17, 10, 12, 15]); }
  return ifx kind == xdungeon.DG_KIND_IMP then xc_imp() else xc_gremlin();
}
XC_FOE_NAMES :: [5] string.["IMP", "GREMLIN", "PUGLIN BRUTE", "IMP FIEND", "PUGLIN WARLORD"];
xc_set_level :: (x: [] XcCombat, level: int) {
  if level < 1 || level > 6 { return; }
  x[0].level = level;
  xc_set_class(x, x[0].klass);
}
xc_order_bar :: (x: [] XcCombat) {
  c := x[0].klass;
  for i: 0..<x[0].bar_n {
    id := xc_id(x[0].bar[i]); found := false;
    for j: 0..<x[0].order_n[c] { if x[0].order[c][j] == id { found = true; } }
    if !found && x[0].order_n[c] < XC_SLOTS { x[0].order[c][x[0].order_n[c]] = id; x[0].order_n[c] += 1; }
  }
  // Sort visible abilities by the full remembered order, including unavailable levels.
  for i: 0..<x[0].bar_n {
    for j: i + 1..<x[0].bar_n {
      pi := XC_SLOTS; pj := XC_SLOTS;
      for q: 0..<x[0].order_n[c] {
        if x[0].order[c][q] == xc_id(x[0].bar[i]) { pi = q; }
        if x[0].order[c][q] == xc_id(x[0].bar[j]) { pj = q; }
      }
      if pj < pi { a := x[0].bar[i]; x[0].bar[i] = x[0].bar[j]; x[0].bar[j] = a; }
    }
  }
}
xc_swap :: (x: [] XcCombat, from: int, to: int) {
  if from < 0 || to < 0 || from >= x[0].bar_n || to >= x[0].bar_n || from == to { return; }
  c := x[0].klass; a := x[0].bar[from]; b := x[0].bar[to];
  for j: 0..<x[0].order_n[c] {
    if x[0].order[c][j] == xc_id(a) { x[0].order[c][j] = xc_id(b); }
    else if x[0].order[c][j] == xc_id(b) { x[0].order[c][j] = xc_id(a); }
  }
  x[0].bar[from] = b; x[0].bar[to] = a; x[0].order_dirty = true;
  x[0].used = -1; x[0].fizzle = -1;
}
// The host's realm-specific hotbar save (action/message 12).
xc_order_save :: (x: [] XcCombat, out: [] u8) -> int {
  n := put(out, 0, "xc-bar 1\n");
  for c: 0..<FB_CL_N {
    for j: 0..<x[0].order_n[c] { n = put_int(out, n, x[0].order[c][j]); n = put(out, n, " "); }
    n = put(out, n, "\n");
  }
  return ifx n < out.count then n else 0;
}
xc_order_load :: (x: [] XcCombat, text: string) -> bool {
  head := "xc-bar 1\n";
  if text.count < head.count || text[0..<head.count] != head { return false; }
  order: [12] [XC_SLOTS] int; counts: [12] int; c := 0; at := head.count;
  while at < text.count && c < FB_CL_N {
    if text[at] == '\n' { c += 1; at += 1; continue; }
    id := 0; digits := 0;
    while at < text.count && text[at] >= '0' && text[at] <= '9' {
      if digits >= 6 { return false; }
      id = id * 10 + cast(int) text[at] - '0'; digits += 1; at += 1;
    }
    if digits == 0 || at >= text.count || text[at] != ' ' || id >= 220000 || counts[c] >= XC_SLOTS { return false; }
    for i: 0..<counts[c] { if order[c][i] == id { return false; } }
    order[c][counts[c]] = id; counts[c] += 1; at += 1;
  }
  if c != FB_CL_N || at != text.count { return false; }
  x[0].order = order; x[0].order_n = counts; x[0].order_dirty = false;
  if x[0].started { xc_order_bar(x); }
  return true;
}

// The battle, once: you and the six monsters, off the grid until a press places them.
xc_start :: (x: [] XcCombat, klass: int) {
  if x[0].started { return; }
  b := x[0].b[..];
  rs_reset(b);
  b[0].w = XC_SIDE; b[0].h = XC_SIDE;
  timing_selected := rs_set_timing(b,RS_ACTION_TIMING);
  b[0].dice[0].state = cast(u64) 13025 * 7919 + 3;
  _ := rs_add(b, fb_cl_hero(klass, "You", 0, 1), XC_MID, XC_MID);
  for i: 0..<XC_FOES { _ = rs_add(b, xc_foe(hostile.hostile_kind(i)), XC_AWAY, XC_AWAY); }
  rs_begin(b);
  for i: 0..<XC_FOES { x[0].npc_seat[i]=FbSeat.{me=i+1}; }
  x[0].started = true;
  xc_set_class(x, klass);
}
// You become class c at the selected level. The monsters keep their wounds.
xc_set_class :: (x: [] XcCombat, c: int) {
  if c < 0 || c >= FB_CL_N { return; }
  if !x[0].started { xc_start(x, c); return; }
  b := x[0].b[..];
  t := b[0].c[0].turn_at; ro := b[0].c[0].round_at;
  rs_end_concentration(b,0," (class preset changed)");
  rs_release_turned(b,0);
  b[0].c[0] = fb_cl_hero(c, "You", 0, x[0].level);
  b[0].c[0].turn_at = t; b[0].c[0].round_at = ro;
  rs_place(b, 0, XC_MID, XC_MID);
  x[0].seat[0] = FbSeat.{me = 0};
  x[0].klass = c;
  x[0].bar_n = xc_bar_level(c, x[0].level, x[0].bar[..]);
  xc_order_bar(x); x[0].arranging = false;
  x[0].used = -1; x[0].hover = -1; x[0].pend = -1;
}
// A monster's square round you: the nearest whole square to where it stands, off the grid when far.
xc_square :: (d: f32) -> int {
  q := cast(int) floor(d / f32(XC_SQ) + 0.5);
  return ifx q <= -XC_MID || q >= XC_MID then XC_AWAY else XC_MID + q;
}
xc_float :: (x: [] XcCombat, wx: f32, wy: f32, wz: f32, t0: f32, text: string, heal: bool) { xc_float_from(x, 0, wx, wy, wz, t0, text, heal); }
// A number rising off whoever took it, from source (0 you, 1 to 6 a monster): presentation of an accepted
// result, queued through react_present (at most XC_FLOATS a source a frame, the rest suppressed and
// counted). Nothing here changes what the ruleset applied.
xc_float_from :: (x: [] XcCombat, source: int, wx: f32, wy: f32, wz: f32, t0: f32, text: string, heal: bool) {
  x[0].present.per_source = XC_FLOATS;
  before := x[0].present.suppressed;
  x[0].present = react.react_present(x[0].present, react.PresentEvent.{kind = react.PresentKind.number, source = source, at = asp.world_point(wx, wy, wz), priority = ifx heal then 2 else 1});
  if x[0].present.suppressed > before { x[0].suppressed += 1; return; }
  x[0].shown += 1;
  q := 0; oldest := 1e9f32;
  for i: 0..<XC_FLOATS { if !x[0].fl[i].on { q = i; break; } if x[0].fl[i].t0 < oldest { oldest = x[0].fl[i].t0; q = i; } }
  f := x[0].fl[q..<q + 1];
  f[0] = XcFloat.{on = true, x = wx, y = wy, z = wz, t0 = t0, heal = heal};
  f[0].n = put(f[0].text[..], 0, text);
}
xc_float_int :: (x: [] XcCombat, wx: f32, wy: f32, wz: f32, t0: f32, v: int, heal: bool) {
  buf: [12] u8; n := 0;
  if heal { buf[0] = '+'; n = 1; }
  n = put_int(buf[..], n, v);
  xc_float(x, wx, wy, wz, t0, cast(string) buf[0..<n], heal);
}

// What kind of aim ability a takes, and its reach in metres (class-kit.coax xc_aim_for), for the weapon you hold.
xc_aim_kind :: (s: [] Lab, a: FbAb) -> XcAim { return xc_aim_for(a, s[0].xc[0].b[0].c[0].weapon); }
// A single-target spell's monster: Aethyr's attention query (aethyr/cam/attention.coax) for an action
// target within reach in a 30 degree cone ahead, the nearest first (angle-weighted), ties by id. The
// SRD still decides what the spell does; this only says at whom. -1 when none.
xc_attend :: (s: [] Lab, fx: f32, fz: f32, reach: f32) -> int {
  cr := s[0].creator[0]; h := cr.hostiles[0];
  y := xmeadow.exp_height(cr.player_x, cr.player_z) + 1.2;
  // the living monsters in reach you can see (not through a dungeon wall), within the shared
  // answer's ATTN_CANDIDATES
  ts: [attn.ATTN_CANDIDATES] attn.AttnTarget; tn := 0;
  for i: 0..<XC_FOES {
    e := h.enemies[i];
    dx := e.x - cr.player_x; dz := e.z - cr.player_z;
    if e.dead || dx * dx + dz * dz > (reach + 1) * (reach + 1) || tn >= ts.count || !hostile.hostile_sees(e, cr.player_x, cr.player_z) { continue; }
    ts[tn] = attn.AttnTarget.{id = i, gen = 1, caps = attn.ATTN_ACTION, at = asp.world_point(e.x, y, e.z), radius = 0, valid = true}; tn += 1;
  }
  q := attn.AttnQuery.{origin = asp.world_point(cr.player_x, y, cr.player_z), forward = asp.world_point(fx, 0, fz), need = attn.ATTN_ACTION, acquire = reach, acquire_cos = 0.9659};
  c: aq.Colliders; c.ground = -1000;   // the meadow fight has no walls between you and a monster
  return attn.attn_step(attn.AttnState.{}, q, ts[0..<tn], c, 0, false, false).target;
}
// Your target: the monster you struck at, held by Aethyr's attention (lock-on capability). Nothing is
// acquired for you (acquire 0): it is set only by a strike, kept within 24 m all round you for at least
// the hold, kept through a second of being out of reach (the grace), and released at once when it falls.
XC_LOCK_HOLD :: 16; XC_LOCK_GRACE :: 64;
xc_lock_query :: (s: [] Lab) -> attn.AttnQuery {
  cr := s[0].creator[0]; y := xmeadow.exp_height(cr.player_x, cr.player_z) + 1.2;
  return attn.AttnQuery.{origin = asp.world_point(cr.player_x, y, cr.player_z), forward = asp.world_point(sin(cr.player_face), 0, cos(cr.player_face)),
    need = attn.ATTN_LOCK, acquire = 0, retain = 24, acquire_cos = 1, retain_cos = -1, rise = 6, hold = XC_LOCK_HOLD, grace = XC_LOCK_GRACE};
}
// The living monsters within the hold's reach, the held one first, up to the shared answer's
// ATTN_CANDIDATES; how many.
xc_lock_targets :: (s: [] Lab, out: [] attn.AttnTarget) -> int {
  cr := s[0].creator[0]; h := cr.hostiles[0]; held := s[0].xc[0].lock.target; n := 0;
  for pass: 0..<2 { for i: 0..<XC_FOES {
    if (pass == 0) != (i == held) { continue; }
    e := h.enemies[i];
    dx := e.x - cr.player_x; dz := e.z - cr.player_z;
    if n >= out.count || (pass == 1 && (e.dead || dx * dx + dz * dz > 25 * 25)) { continue; }   // the held one always, so its range and fall are judged
    out[n] = attn.AttnTarget.{id = i, gen = 1, caps = attn.ATTN_LOCK | attn.ATTN_ACTION, at = asp.world_point(e.x, xmeadow.exp_height(e.x, e.z) + 1.2, e.z), radius = 0.35, valid = !e.dead}; n += 1;
  } }
  return n;
}
// Lock onto monster foe now (a strike at it).
xc_lock_on :: (s: [] Lab, foe: int) {
  x := s[0].xc[..]; now := xc_tick(s[0].creator[0].clock);
  if foe < 0 || foe >= XC_FOES { return; }
  if x[0].lock.target != foe { x[0].lock = attn.AttnState.{target = foe, gen = 1, since = now, seen = now, reason = attn.AttnReason.acquired}; }
  else { x[0].lock.seen = now; }
  x[0].target = foe;
}
// One step of the held target at the creator clock's tick.
xc_lock_step :: (s: [] Lab) {
  x := s[0].xc[..];
  if x[0].lock.target < 0 { x[0].target = -1; return; }
  ts: [attn.ATTN_CANDIDATES] attn.AttnTarget; tn := xc_lock_targets(s, ts[..]);
  c: aq.Colliders; c.ground = -1000;   // the meadow fight has no walls between you and a monster
  x[0].lock = attn.attn_step(x[0].lock, xc_lock_query(s), ts[0..<tn], c, xc_tick(s[0].creator[0].clock), false, false);
  x[0].target = x[0].lock.target;
}
// Hit stops (aethyr/action/react.coax): a blow that lands pauses the struck monster for its profile's
// ticks, and a monster whose blow lands on you pauses itself. Only those actors are held; the world, the
// other monsters and you go on. Actor 0 is you, 1 to 6 the monsters.
XC_STOP_STRUCK :: 5; XC_STOP_STRIKER :: 4;
xc_stop_hit :: (s: [] Lab, foe: int, kinds: u32) {
  x := s[0].xc[..]; cr := s[0].creator[0]; e := cr.hostiles[0].enemies[foe];
  dx := cr.player_x - e.x; dz := cr.player_z - e.z; l := sqrt(dx * dx + dz * dz);
  toward := ifx l > 0.0001 then asp.world_point(dx / l, 0, dz / l) else asp.world_point(0, 0, 1);
  a := react.AttackAttrs.{kinds = kinds, stop = react.HitStop.{ticks = XC_STOP_STRUCK, scope = react.StopScope.target}};
  r := react.react_decide(a, react.TargetResponse.{}, asp.world_point(e.face_x, 0, e.face_z), toward, 1);
  x[0].stops = react.react_stop_add(x[0].stops, r, 0, 1 + foe, xc_tick(cr.clock));
}
xc_stop_striker :: (s: [] Lab, foe: int) {
  x := s[0].xc[..]; cr := s[0].creator[0];
  claw := react.AttackAttrs.{kinds = react.DMG_SLASH, stop = react.HitStop.{ticks = XC_STOP_STRIKER, scope = react.StopScope.source}};
  r := react.react_decide(claw, react.TargetResponse.{}, asp.world_point(sin(cr.player_face),0,cos(cr.player_face)),asp.world_point(0,0,1),1);
  x[0].stops = react.react_stop_add(x[0].stops,r,1+foe,0,xc_tick(cr.clock));
}
xc_stops_step :: (s: [] Lab) {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..]; now := xc_tick(cr[0].clock);
  if h[0].hits > x[0].seen_hits && h[0].last >= 0 && h[0].last < XC_FOES {
    xc_stop_striker(s,h[0].last);
  }
  x[0].seen_hits = h[0].hits;
  x[0].stops = react.react_stop_expire(x[0].stops, now);
  for i: 0..<XC_FOES { h[0].enemies[i].stopped = !h[0].enemies[i].dead && react.react_held(x[0].stops, 1 + i, now); }
}
// Ability a's aim from where you stand and face: its kind, its reach, your forward and its monster.
xc_aim :: (s: [] Lab, a: FbAb) -> XcAim {
  cr := s[0].creator[0]; h := cr.hostiles[0];
  m := xc_aim_kind(s, a);
  m.fx = sin(cr.player_face); m.fz = cos(cr.player_face);   // aethyr/walk.coax: you face atan2(x, z)
  if m.kind == XC_AIM_SELF { return m; }
  best := 1e9f32;
  for i: 0..<XC_FOES {
    e := h.enemies[i];
    if e.dead { continue; }
    dx := e.x - cr.player_x; dz := e.z - cr.player_z;
    along := dx * m.fx + dz * m.fz; side := abs(dx * m.fz - dz * m.fx); d := sqrt(dx * dx + dz * dz);
    hit := false;
    if m.kind == XC_AIM_BOLT { hit = along > 0 && along <= m.reach + f32(XC_BODY) && (side <= f32(XC_BODY) || side <= along * f32(XC_ASSIST)); }
    else if m.kind == XC_AIM_MELEE { hit = d <= m.reach && along >= d * 0.7071; }
    else if m.kind == XC_AIM_AREA { hit = d <= hi(m.reach, 1) && along >= d * 0.9659; }   // an area's point: 30 degrees
    key := ifx m.kind == XC_AIM_BOLT then along else d;
    if hit && key < best && hostile.hostile_sees(e, cr.player_x, cr.player_z) { best = key; m.foe = i; }   // not through a wall
  }
  if m.kind == XC_AIM_CONE { m.foe = xc_attend(s, m.fx, m.fz, hi(m.reach, 1)); }
  if m.kind == XC_AIM_AREA {
    sp := rs_spell(a.sp);
    // a cube from you is set ahead of you; a placed area lands on that monster, or 6 m on
    m.reach = ifx sp.area == RS_A_CUBE_SELF then f32(sp.area_ft) * f32(XC_FT) else ifx m.foe >= 0 then best else lo(m.reach, 6);
    m.foe = -1;
  }
  return m;
}

// Derive the visible footprint from the same grid bounds used by the spell.
// Half a square at each edge accounts for the world's nearest-square mapping.
xc_wave_make :: (x: [] XcCombat, px: f32, pz: f32, face: f32) -> XcWave {
  z := rs_area(x[0].b[..], 0, rs_spell(SP_THUNDERWAVE), XC_MID, XC_MID+3);
  sq := f32(XC_SQ);
  return XcWave.{x=px, z=pz, fx=sin(face), fz=cos(face),
    left=(f32(z.x0-XC_MID)-0.5)*sq, right=(f32(z.x1-XC_MID)+0.5)*sq,
    near=(f32(z.y0-XC_MID)-0.5)*sq, far=(f32(z.y1-XC_MID)+0.5)*sq};
}
xc_wave_contains :: (w: XcWave, x: f32, z: f32) -> bool {
  dx := x-w.x; dz := z-w.z; side := dx*w.fz-dz*w.fx; forward := dx*w.fx+dz*w.fz;
  return side >= w.left && side < w.right && forward >= w.near && forward < w.far;
}
// Restore the world's coordinate frame after a facing-relative cube, so other
// ongoing areas and later combat steps continue to use world-aligned squares.
xc_sync_world :: (s: [] Lab) {
  b := s[0].xc[0].b[..]; cr := s[0].creator[0];
  rs_place(b,0,XC_MID,XC_MID);
  for i: 0..<XC_FOES {
    e := cr.hostiles[0].enemies[i];
    qx := xc_square(e.x-cr.player_x); qz := xc_square(e.z-cr.player_z);
    if e.dead || qx == XC_AWAY || qz == XC_AWAY { qx = XC_AWAY; qz = XC_AWAY; }
    rs_place(b, i+1, qx, qz);
  }
}
// The bodies publish contact intent; the shared battle owns all outcomes.
xc_hostile_attack :: (kind: int) -> RsStatAttack {
  if kind<0 || kind>=XC_FOE_NAMES.count { return RsStatAttack.{}; }
  old := hostile.hostile_blow(kind);
  names := [5] string.["experimental-imp","experimental-gremlin","experimental-brute","experimental-fiend","experimental-warlord"];
  return RsStatAttack.{id=names[kind],name=XC_FOE_NAMES[kind],bonus=old.attack,dice=old.dice,sides=old.sides,flat=old.bonus,kind=old.kind,
    ability=ifx kind==xdungeon.DG_KIND_FIEND then RS_DEX else RS_STR,reach=ifx kind==xdungeon.DG_KIND_BRUTE || kind==xdungeon.DG_KIND_BOSS then 10 else 5};
}
xc_sync_vitals :: (s: [] Lab) {
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  if !s[0].xc[0].started { return; }
  if h[0].hp>0 && b[0].c[0].hp==0 { h[0].died_at=h[0].time; }
  if !h[0].shared { for i: 0..<XC_FOES { if h[0].enemies[i].dead { b[0].c[i+1].hp=0; b[0].c[i+1].dead=true; } } }
  h[0].shared=true; h[0].hp=b[0].c[0].hp; h[0].max_hp=b[0].c[0].hp_max;
  h[0].temp=b[0].c[0].temp; h[0].player_dead=b[0].c[0].dead;
}
xc_hostile_contacts :: (s: [] Lab) {
  x := s[0].xc[..]; b := x[0].b[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  xc_sync_world(s);
  // Quiet actors take turns too: repeat saves do not depend on reaching you.
  for i: 0..<XC_FOES { fb_seat_step(b,x[0].npc_seat[i..<i+1]); }
  while h[0].contacts[0].count>0 {
    foe := hostile.hc_take(h[0].contacts[..]);
    if foe<0 || foe>=XC_FOES || !rs_up(b[0].c[0]) || h[0].enemies[foe].dead || !x[0].npc_seat[foe].open { continue; }
    before := b[0].c[0].hp+b[0].c[0].temp; seq := b[0].book[0].seq;
    fb_seat_in(b,x[0].npc_seat[foe..<foe+1]);
    accepted := rs_stat_attack(b,foe+1,0,xc_hostile_attack(h[0].enemies[foe].kind));
    fb_seat_out(b,x[0].npc_seat[foe..<foe+1]);
    lost := before-b[0].c[0].hp-b[0].c[0].temp;
    landed := false;
    for k: 0..<rs_min(b[0].book[0].seq-seq,RS_EVENTS) {
      event := rs_recent(b[0].book[0],k);
      if event.kind==RS_EV_ATTACK && event.by==foe+1 && event.to==0 { landed=true; }
    }
    if accepted && landed { h[0].hits+=1; h[0].last=foe; xc_stop_striker(s,foe); x[0].seen_hits=h[0].hits; }
    if accepted && lost>0 {
      h[0].pops[h[0].pop_next]=hostile.DamagePop.{amount=lost,x=cr[0].player_x,y=cr[0].player_y+2.1,z=cr[0].player_z,born=h[0].time};
      h[0].pop_next=(h[0].pop_next+1)%8;
    }
  }
  xc_sync_vitals(s);
}
// Project shared movement/action permissions independently into the body AI.
// A Stunned actor can move; a Restrained actor can still take an action.
xc_sync_permissions :: (s: [] Lab) {
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  for i: 0..<XC_FOES {
    if i+1>=b[0].n { break; }
    c := b[0].c[i+1];
    if c.dead && !h[0].enemies[i].dead {
      h[0].enemies[i].dead=true; h[0].enemies[i].died=s[0].creator[0].clock;
      h[0].enemies[i].moving=false; h[0].enemies[i].swing = -1;
      s[0].xc[0].kills+=1;
      if s[0].xc[0].target==i { s[0].xc[0].target = -1; }
    }
    h[0].enemies[i].held = !rs_can_move(c) || rs_walk_speed(b,i+1)<=0;
    h[0].enemies[i].inactive = !rs_can_act(c);
    // Retire a pending attack immediately, including between body ticks.
    if h[0].enemies[i].inactive { h[0].enemies[i].swing = -1; h[0].enemies[i].struck = false; }
  }
}
// Press slot k: the engine resolves it at what it aims at (xc_aim). True when it was used. Sets what the
// world shows: the look (xc_look), the numbers and the fallen.
xc_press :: (s: [] Lab, k: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  if !cr[0].experimental || cr[0].walk.on || !x[0].started || k < 0 || k >= x[0].bar_n { return false; }
  xc_sync_vitals(s);
  now := cr[0].clock;
  if now - x[0].cool_at < f32(XC_COOL) || h[0].hp <= 0 { x[0].refused += 1; return false; }
  xc_strike_due(s);
  a := x[0].bar[k];
  b := x[0].b[..];
  if !x[0].seeded { x[0].seeded = true; b[0].dice[0].state = b[0].dice[0].state ^ (cast(u64) (now * 1000003) * 2654435761); }
  // a blow with a weapon in hand is an action: it swings first and lands where the blade meets a monster
  kit := xc_kit(x[0].klass);
  if kit >= 0 && xc_aim_kind(s, a).kind == XC_AIM_MELEE {
    clip := ifx cc.CC_KIT_TWO[kit] then figs.BD_OWN + cc.CC_KIT_HOLD[kit] + 2 else figs.BD_SLASH;   // a two-hander's owned cleave
    cr[0].weapon = kit; cr[0].swing_clip = clip; cr[0].swing_at = now;
    tick := xc_tick(now);
    x[0].swing_def = xc_swing_def(s, clip);
    x[0].swing = act.action_begin(x[0].swing_def, clip, x[0].swing_next, 0, 1, tick, 1, 1);
    x[0].swing_next += 1; x[0].swing_tick = tick - 1; x[0].swing_struck = false;
    x[0].pend = k;
    x[0].cool_at = now; x[0].used = k;
    xc_cast_sound(s, a);   // the whoosh as the swing starts; the blow's hit when it lands (xc_use)
    return true;
  }
  return xc_use(s, k);
}
// The fixed tick a creator clock time falls in.
xc_tick :: (t: f32) -> int { return cast(int) floor(f64(t) * f64(XC_TICK)); }
// A swing's action: the clip's length in ticks and its sensor window round the impact (bd_blow), the
// impact itself an event. Its ID is the clip's, version 1.
xc_swing_def :: (s: [] Lab, clip: int) -> act.ActionDef {
  d: act.ActionDef; d.id = 1000 + clip; d.version = 1; d.clip = clip;
  d.length = act.action_ticks_of_seconds(f64(figs.bd_seconds(clip)));
  if d.length < 1 { d.length = 1; }
  hit := cast(int) floor(f64(figs.bd_blow(s[0].bodies[..], s[0].creator[0].female, clip)) * f64(d.length) + 0.5);
  open := hit - XC_WINDOW; shut := hit + XC_WINDOW;
  if open < 0 { open = 0; } if shut > d.length { shut = d.length; } if hit > shut { hit = shut; }
  d.events[0] = act.ActionEvent.{kind = act.ActionEventKind.window_open, tick = open};
  d.events[1] = act.ActionEvent.{kind = act.ActionEventKind.impact, tick = hit};
  d.events[2] = act.ActionEvent.{kind = act.ActionEventKind.window_close, tick = shut};
  d.event_n = 3;
  return d;
}
// The blow pressed earlier: its action stepped tick by tick to now, each sensing tick sweeping the
// blade (each frame, and before a press). Its slot lands on the first monster the blade meets.
xc_strike_due :: (s: [] Lab) { xc_swing_step(s, xc_tick(s[0].creator[0].clock)); }
xc_swing_step :: (s: [] Lab, now: int) {
  x := s[0].xc[..];
  if x[0].pend < 0 { return; }
  d := x[0].swing_def;
  top := ifx now > x[0].swing.start + d.length then x[0].swing.start + d.length else now;
  for t: x[0].swing_tick + 1..<top + 1 {
    st := act.action_advance(d, x[0].swing, t);
    x[0].swing = st.inst; x[0].swing_tick = t;
    if st.sensing && !x[0].swing_struck && s[0].creator[0].hostiles[0].hp > 0 { xc_sense(s, t); }
    closed := false;
    for e: 0..<st.n { if st.events[e].kind == act.ActionEventKind.window_close { closed = true; } }
    if (closed || st.finished) && !x[0].swing_struck {
      // the window closed on no one: the blow swings at the air (no roll, no damage)
      x[0].swing_struck = true;
      if s[0].creator[0].hostiles[0].hp > 0 { xc_whiff(s, x[0].pend); }
    }
    if st.finished || x[0].swing.phase != act.ActionPhase.running {
      x[0].ledger = sense.sensor_ledger_retire(x[0].ledger, x[0].swing.id);
      x[0].pend = -1; return;
    }
  }
}
// The blade at time t (creator seconds): the swing clip's baked hand pose, between its frames, through
// the weapon matrix that draws it. Not ready (no bake): the fallback arc, flagged.
XcBlade :: struct { pose: sense.SensorPose; fallback: bool; }
xc_blade :: (s: [] Lab, t: f32) -> XcBlade {
  cr := s[0].creator[0]; b := s[0].bodies[..];
  k := cr.weapon; clip := cr.swing_clip;
  if k < 0 || k >= cc.CC_KITS { k = 0; }
  y := xmeadow.exp_height(cr.player_x, cr.player_z) + cr.player_y;
  dur := figs.bd_seconds(clip);
  if !b[0].ready || clip < 0 || dur <= 0 {
    // the fallback: a blade from the shoulder sweeping 2 radians right to left ahead of you across the window
    d := s[0].xc[0].swing_def; ft := 0.5f32;
    if d.event_n == 3 && d.events[2].tick > d.events[0].tick {
      ft = (t * f32(XC_TICK) - f32(s[0].xc[0].swing.start) - f32(d.events[0].tick)) / f32(d.events[2].tick - d.events[0].tick);
      ft = ifx ft < 0 then 0 else ifx ft > 1 then 1 else ft;
    }
    ang := cr.player_face + 1.0 - 2.0 * ft;
    reach := XC_BLADE_TIP[k] + 0.45;
    base := asp.world_point(cr.player_x + sin(ang) * 0.3, y + 1.2, cr.player_z + cos(ang) * 0.3);
    tip := asp.world_point(cr.player_x + sin(ang) * reach, y + 1.2, cr.player_z + cos(ang) * reach);
    return XcBlade.{pose = sense.SensorPose.{a = base, b = tip}, fallback = true};
  }
  n := figs.bd_frames(clip);
  u := (t - cr.swing_at) / dur * f32(n) - 0.5;
  if u < 0 { u = 0; } if u > f32(n - 1) { u = f32(n - 1); }
  f0 := cast(int) floor(u); f1 := ifx f0 + 1 < n then f0 + 1 else f0; mix := u - f32(f0);
  r0 := f32(figs.bd_row(cr.female, clip, f0)); r1 := f32(figs.bd_row(cr.female, clip, f1));
  o := ifx cr.female then 3 else 0;
  hr := figs.bd_hand(b, r0, r1, mix, false); hand := [3]f32.[b[0].hand_at[o], b[0].hand_at[o + 1], b[0].hand_at[o + 2]];
  at := [3]f32.[cr.player_x, y, cr.player_z];
  w := ifx cc.CC_KIT_TWO[k] then cc.two_hand_matrix(hr, figs.bd_hand(b, r0, r1, mix, true), hand, [3]f32.[b[0].hand_at[6 + o], b[0].hand_at[7 + o], b[0].hand_at[8 + o]], k, cr.player_face, at)
    else cc.weapon_matrix(hr, hand, k, cr.player_face, at);
  l := XC_BLADE_TIP[k] / cc.CC_KIT_SCALE[k];
  base := asp.world_point(w[0], w[1], w[2]);
  tip := asp.world_point(w[0] + w[6] * l, w[1] + w[7] * l, w[2] + w[8] * l);
  return XcBlade.{pose = sense.SensorPose.{a = base, b = tip}};
}
// Sense tick t: sample the blade across the tick finely enough for the sensor's motion profile, sweep
// the living monsters' hurt capsules, and land the slot on the first accepted contact.
xc_sense :: (s: [] Lab, t: int) {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  t0 := f32(f64(t) / f64(XC_TICK)); t1 := f32(f64(t + 1) / f64(XC_TICK));
  p := xc_blade(s, t0); q := xc_blade(s, t1);
  if p.fallback { x[0].fallbacks += 1; }
  mv := sense.sensor_len(p.pose.b, q.pose.b); if sense.sensor_len(p.pose.a, q.pose.a) > mv { mv = sense.sensor_len(p.pose.a, q.pose.a); }
  if mv > x[0].blade_step { x[0].blade_step = mv; }
  n := sense.sensor_samples_needed(p.pose, q.pose, f32(XC_BLADE_R));
  if n > sense.SENSOR_SAMPLES { x[0].exhausted += 1; return; }
  // the chord understates a turning blade: add samples until no end moves more than the radius between two
  sw: sense.SensorSweep;
  for guard: 0..<sense.SENSOR_SAMPLES {
    sw.n = n; worst := 0.0f32;
    for i: 0..<n { sw.poses[i] = xc_blade(s, t0 + (t1 - t0) * f32(i) / f32(n - 1)).pose; }
    for i: 1..<n { a := sense.sensor_len(sw.poses[i - 1].a, sw.poses[i].a); b := sense.sensor_len(sw.poses[i - 1].b, sw.poses[i].b); if a > worst { worst = a; } if b > worst { worst = b; } }
    if worst <= f32(XC_BLADE_R) { break; }
    if n >= sense.SENSOR_SAMPLES { x[0].exhausted += 1; return; }
    n = n + 1 + cast(int) floor(f32(n - 1) * (worst / f32(XC_BLADE_R) - 1));
    if n > sense.SENSOR_SAMPLES { n = sense.SENSOR_SAMPLES; }
  }
  // the living monsters within a blade's reach, nearest first past the sensor's SENSOR_TARGETS
  hurt: [sense.SENSOR_TARGETS] sense.HurtCapsule; hn := 0;
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    if e.dead || dx * dx + dz * dz > 8 * 8 || hn >= hurt.count { continue; }
    hurt[hn] = sense.HurtCapsule.{id = 1 + i, gen = 1, team = 2, feet = asp.world_point(e.x, xmeadow.exp_height(e.x, e.z) - 0.1, e.z), height = 1.7 * e.scale, radius = 0.35 * e.scale, alive = true}; hn += 1;
  }
  y := xmeadow.exp_height(cr[0].player_x, cr[0].player_z) + cr[0].player_y;
  origin := asp.world_point(cr[0].player_x, y + 1.2, cr[0].player_z);
  open: aq.Colliders; open.ground_enabled = false;
  r := sense.sensor_resolve(x[0].swing_def, x[0].swing, t, 1, 1, origin, sw, f32(XC_BLADE_R), hurt[0..<hn], open, x[0].ledger);
  if r.status == sense.SensorStatus.exhausted { x[0].exhausted += 1; return; }
  x[0].ledger = r.ledger;
  for c: 0..<r.n {
    if r.contacts[c].status != sense.ContactStatus.hit || x[0].swing_struck { continue; }
    // the SRD Attack is one creature's: the first accepted contact is it
    x[0].swing_struck = true; x[0].contacts += 1;
    _ := xc_use_on(s, x[0].pend, r.contacts[c].target - 1);
  }
}
// A blow that met no one: the turn is spent swinging at the air.
xc_whiff :: (s: [] Lab, k: int) {
  x := s[0].xc[..]; cr := s[0].creator[..];
  a := x[0].bar[k]; m := xc_aim_kind(s, a);
  fx := sin(cr[0].player_face); fz := cos(cr[0].player_face);
  x[0].casts += 1; x[0].whiffs += 1;
  xc_look(s, a, -1, cr[0].player_x + fx * m.reach, cr[0].player_z + fz * m.reach);
}
// One cue heard where it happens: softer the farther it is, panned the way the camera faces.
xc_cue :: (s: [] Lab, name: string, gain: f32, x: f32, z: f32, rate: f32) {
  if name.count == 0 { return; }
  cr := s[0].creator[0];
  dx := x - cr.player_x; dz := z - cr.player_z; d := sqrt(dx * dx + dz * dz);
  pan := 0.0f32;
  if d > 0.5 { pan = (dx * cos(cr.yaw) - dz * sin(cr.yaw)) / d * 0.7; }
  exsound.experimental_sound_play(s[0].experimental_audio[..], name, gain / (1 + d / 10), pan, rate);
}
// A monster's voice when it is hurt or dies: the imp shrieks, the gremlin snarls; the bigger
// they are, the deeper (the Warlord's a growl).
xc_voice :: (s: [] Lab, i: int, died: bool) {
  e := s[0].creator[0].hostiles[0].enemies[i];
  imp := xdungeon.dg_kind_mesh(e.kind) == 0;
  name := ifx imp then (ifx died then "imp-death" else "imp-hurt") else (ifx died then "gremlin-death" else "gremlin-hurt");
  xc_cue(s, name, (ifx died then 0.6f32 else 0.5f32) * (ifx e.scale > 2 then 1.3f32 else 1.0f32), e.x, e.z, 1 / sqrt(e.scale));
}
xc_cast_sound :: (s: [] Lab, a: FbAb) {
  cr := s[0].creator[0]; d := xc_sound(a, s[0].xc[0].klass);
  xc_cue(s, d.start, 0.55, cr.player_x, cr.player_z, d.rate);
  xc_cue(s, d.layer, 0.32, cr.player_x, cr.player_z, d.rate);
}
// Slot k used now: the engine resolves it at what it aims at (xc_aim). True when it was used.
xc_use :: (s: [] Lab, k: int) -> bool { return xc_use_on(s, k, -2); }
// Slot k used now against monster on (a blade's contact), or at what it aims at when on is -2.
xc_use_on :: (s: [] Lab, k: int, on: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  now := cr[0].clock;
  a := x[0].bar[k];
  b := x[0].b[..];
  px := cr[0].player_x; pz := cr[0].player_z;
  // what it aims at: ahead of you, by its kind (xc_aim); nothing is picked for you behind or beside you
  aim := xc_aim(s, a);
  if on >= -1 { aim.foe = on; }
  foe := aim.foe;
  snd := xc_sound(a, x[0].klass);
  swung := xc_kit(x[0].klass) >= 0 && aim.kind == XC_AIM_MELEE;   // its whoosh played at the press (xc_press)
  if aim.kind == XC_AIM_CONE && foe < 0 { x[0].fizzle = k; x[0].fizzle_at = now; x[0].refused += 1; xc_cue(s, snd.miss, 0.35, px, pz, 1); return false; }   // no one ahead: the icon fizzles
  if (aim.kind == XC_AIM_BOLT || aim.kind == XC_AIM_MELEE) && foe < 0 {
    // the bolt flies on to its range and fizzles; the blow swings at the air. No roll, no damage.
    x[0].cool_at = now; x[0].used = k; x[0].casts += 1; x[0].whiffs += 1;
    xc_look(s, a, -1, px + aim.fx * aim.reach, pz + aim.fz * aim.reach);
    if !swung { xc_cast_sound(s, a); }
    if aim.kind == XC_AIM_BOLT { xc_cue(s, snd.miss, 0.45, px + aim.fx * aim.reach, pz + aim.fz * aim.reach, 1); }
    return true;
  }
  // Self-originating cubes use a grid aligned with your facing, so diagonal
  // casts cover the same width on both sides as casts along a world axis.
  facing_cube := a.kind == FB_SPELL && rs_spell(a.sp).area == RS_A_CUBE_SELF;
  // the monsters on the engine's squares round you
  rs_place(b, 0, XC_MID, XC_MID);
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    j := 1 + i;
    if e.dead { rs_place(b, j, XC_AWAY, XC_AWAY); continue; }
    dx := e.x - px; dz := e.z - pz;
    qx := xc_square(ifx facing_cube then dx * aim.fz - dz * aim.fx else dx);
    qz := xc_square(ifx facing_cube then dx * aim.fx + dz * aim.fz else dz);
    if qx == XC_AWAY || qz == XC_AWAY { qx = XC_AWAY; qz = XC_AWAY; }
    rs_place(b, j, qx, qz);
  }
  // Explicit world cost profile, not a new turn or component/access waiver.
  me := b[0].c[0..<1];
  saved_budget:=rs_press_budget(me[0],x[0].seat[0].turn);
  was_open:=x[0].seat[0].open;
  press_turn:[1] RsTurn; press_turn[0]=x[0].seat[0].turn;
  prepared:=rs_press_prepare(me,press_turn[..],RS_UNLIMITED_PRESS);
  x[0].seat[0].turn=press_turn[0];
  hp_before := me[0].hp; temp_before := me[0].temp;
  x[0].seat[0].open = true;
  before: [XC_FOES] int; bx: [XC_FOES] int; bz: [XC_FOES] int;
  for i: 0..<XC_FOES { before[i] = b[0].c[1 + i].hp; bx[i] = b[0].c[1+i].x; bz[i] = b[0].c[1+i].y; }
  tx := XC_MID; ty := XC_MID;
  if facing_cube { ty = XC_MID + 3; }
  else if foe >= 0 { tx = b[0].c[1 + foe].x; ty = b[0].c[1 + foe].y; }
  else if aim.kind == XC_AIM_AREA { tx = XC_MID + cast(int) floor(aim.fx * aim.reach / f32(XC_SQ) + 0.5); ty = XC_MID + cast(int) floor(aim.fz * aim.reach / f32(XC_SQ) + 0.5); }
  ok := fb_seat_use(b, x[0].seat[..], a, ifx foe >= 0 then 1 + foe else -1, tx, ty, 0);
  gain := rs_max(b[0].c[0].hp-hp_before,0);
  temp_gain := rs_max(b[0].c[0].temp-temp_before,0);
  xc_sync_vitals(s);
  if !ok {
    press_turn[0]=x[0].seat[0].turn; rs_press_restore(me,press_turn[..],saved_budget);
    x[0].seat[0].turn=press_turn[0]; x[0].seat[0].open=was_open;
    if facing_cube { xc_sync_world(s); } x[0].refused += 1; return false;
  }
  if a.kind == FB_SPELL && a.sp == SP_THUNDERWAVE {
    x[0].wave = xc_wave_make(x, px, pz, cr[0].player_face); x[0].wave.y = cr[0].player_y; x[0].wave_until = now + 1.4;
  }
  if a.kind == FB_DASH || a.kind == FB_CDASH || a.kind == FB_WIND {
    x[0].dash_face = cr[0].player_face; x[0].dash_until = now + 0.9;
  }
  x[0].cool_at = now; x[0].used = k; x[0].casts += 1;
  if foe >= 0 { xc_lock_on(s, foe); }   // the one struck at: your target, its Hit Points over the bar
  if gain > 0 {
    xc_float_int(x, px, cr[0].player_y + 2.1, pz, now, gain, true);
  }
  if temp_gain>0 { l: [1] RsLine; rs_add_int(l[..],temp_gain); rs_add_text(l[..]," TEMP HP"); xc_float(x,px,cr[0].player_y+2.1,pz,now,cast(string)l[0].buf[0..<l[0].n],true); }
  xc_look(s, a, foe, px + aim.fx * aim.reach, pz + aim.fz * aim.reach);
  if !swung { xc_cast_sound(s, a); }
  // what it did to each monster: the numbers, and the fallen
  struck := false;
  for i: 0..<XC_FOES {
    c := b[0].c[1 + i];
    e := h[0].enemies[i..<i + 1];
    // Copy a successful Thunderwave push back out of the battle grid. Sweep
    // small increments against the world's obstacles instead of teleporting.
    if facing_cube && !c.dead && !e[0].dead {
      gx := c.x - bx[i]; gz := c.y - bz[i];
      dist := hi(abs(f32(gx)), abs(f32(gz))) * f32(XC_SQ);
      if dist > 0 {
        lx := f32(gx); lz := f32(gz); length := sqrt(lx*lx + lz*lz);
        dx := (lx*aim.fz + lz*aim.fx) / length * dist / 20;
        dz := (-lx*aim.fx + lz*aim.fz) / length * dist / 20;
        for step: 0..<20 {
          nx := e[0].x + dx; nz := e[0].z + dz;
          if hostile.hostile_blocked(nx, nz) { break; }
          e[0].x = nx; e[0].z = nz;
        }
      }
    }
    lost := before[i] - rs_max(c.hp, 0);
    if lost > 0 { struck = true; x[0].landed += 1; x[0].last_dmg = lost; xc_float_int(x, e[0].x, 1.9, e[0].z, now, lost, false);
      if !c.dead && c.hp > 0 { xc_stop_hit(s, i, ifx swung then react.DMG_SLASH else cast(u32) 0); }
      xc_cue(s, snd.hit, 0.55, e[0].x, e[0].z, snd.rate);
      if !c.dead && c.hp > 0 { xc_voice(s, i, false); } }
    if !e[0].dead && (c.dead || c.hp <= 0) {
      e[0].dead = true; e[0].died = now; e[0].moving = false; e[0].swing = -1;
      x[0].kills += 1; xc_voice(s, i, true);
      if x[0].target == i { x[0].target = -1; x[0].lock = attn.AttnState.{}; }
      fx_start_at(s, FXR_DUST, now, fxp_v(e[0].x, 0.2, e[0].z), fxp_v(e[0].x, 0.2, e[0].z), fxp_v(0.6, 0.5, 0.4), 1.2, 1.2);
    }
  }
  xc_sync_permissions(s);
  if facing_cube { xc_sync_world(s); }
  if !struck && foe >= 0 && aim.kind != XC_AIM_AREA { xc_cue(s, snd.miss, 0.45, h[0].enemies[foe].x, h[0].enemies[foe].z, 1); xc_float(x, h[0].enemies[foe].x, 1.9, h[0].enemies[foe].z, now, "MISS", false); }
  return true;
}
// One of the glade's effects (aethyr/fx/puff.coax), on the creator's clock.
fx_start_at :: (s: [] Lab, recipe: int, now: f32, from: FxV, to: FxV, col: FxV, big: f32, reach: f32) {
  c := FxCause.{recipe = recipe, seed = now * 13.7 + f32(recipe), t0 = now, from = from, to = to, col = col, big = big, reach = reach};
  _ := fxp_start(s[0].puffs[..], c, now);
}
// A slot's look: Everglade's recipes for its spells and features (everglade-classes.coax cl_look).
xc_look :: (s: [] Lab, a: FbAb, foe: int, ax: f32, az: f32) {
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  at := fxp_v(ax, cr[0].player_y + 1.0, az);   // where it is aimed: ahead of you (a bolt's full range when it hits no one)
  if foe >= 0 { at = fxp_v(h[0].enemies[foe].x, 0.8, h[0].enemies[foe].z); }
  l := xc_look_of(a, cr[0].player_x, cr[0].player_y, cr[0].player_z, cr[0].player_face, at);
  fx_start_at(s, l.recipe, cr[0].clock, l.from, l.to, l.col, 1, l.reach);
  if l.glimmer { fx_start_at(s, FXR_GLIMMER, cr[0].clock, l.from, l.to, l.col, 1, 1); }
}

// ---- the screen: where a point in the world falls (charactercreator.coax camera's uniforms)
XcAt :: struct { x: f32; y: f32; ok: bool; }
xc_proj :: (x: [] XcCombat, wx: f32, wy: f32, wz: f32) -> XcAt {
  u := x[0].u[..];
  dx := wx - u[16]; dy := wy - u[17]; dz := wz - u[18];
  z := dx * u[20] + dy * u[21] + dz * u[22];
  if z < 0.2 { return XcAt.{}; }
  r := dx * u[24] + dy * u[25] + dz * u[26];
  up := dx * u[28] + dy * u[29] + dz * u[30];
  return XcAt.{x = u[23] + u[19] * r / z, y = u[27] - u[19] * up / z, ok = true};
}
// The column's height, CSS px: its header, and when open its twelve rows.
xc_class_height :: (x: XcCombat) -> f32 { return ifx x.open then f32(XC_ROWS_TOP) + 12 * f32(XC_ROW) + 8 else f32(XC_HEAD); }
xc_column :: (x: XcCombat) -> f32 { return xc_class_height(x) + 34; }
// The bar's slot i, device px.
xc_slot_box :: (x: XcCombat, i: int) -> cc.Box {
  r := xc_slot_at(x.bar_n, i, x.w, x.h, x.k);
  return cc.Box.{x0 = r[0], y0 = r[1], x1 = r[2], y1 = r[3]};
}
xc_in :: (r: cc.Box, px: f32, py: f32) -> bool { return px >= r.x0 && px <= r.x1 && py >= r.y0 && py <= r.y1; }
xc_text_w :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for i: 0..<t.count { c := cast(int) t[i]; if c >= 32 && c <= 126 { w += f32(cc.CC_FONT_WIDTH[c - 32]) / f32(cc.CC_FONT_UPM) * em; } }
  return w;
}

// A segment of the footprint, split so it follows the meadow's changing height
// and stays visible when only part of an edge is in front of the camera.
xc_wave_segment :: (x: [] XcCombat, w: XcWave, out: [] f32, at: int, sa: f32, fa: f32, sb: f32, fb: f32, width: f32, glow: f32) -> int {
  n := at; last: XcAt;
  for i: 0..<9 {
    t := f32(i)/8; side := sa+(sb-sa)*t; front := fa+(fb-fa)*t;
    wx := w.x + side*w.fz + front*w.fx; wz := w.z - side*w.fx + front*w.fz;
    p := xc_proj(x, wx, meadow_y(wx,wz)+w.y+0.08, wz);
    if i>0 && p.ok && last.ok { n = xc_line(out,n,last.x,last.y,p.x,p.y,width,0.35*glow,0.80*glow,glow); }
    last = p;
  }
  return n;
}
xc_wave_draw :: (x: [] XcCombat, w: XcWave, out: [] f32, at: int, k: f32, glow: f32) -> int {
  n := at;
  n=xc_wave_segment(x,w,out,n,w.left,w.near,w.right,w.near,3*k,glow);
  n=xc_wave_segment(x,w,out,n,w.right,w.near,w.right,w.far,3*k,glow);
  n=xc_wave_segment(x,w,out,n,w.right,w.far,w.left,w.far,3*k,glow);
  n=xc_wave_segment(x,w,out,n,w.left,w.far,w.left,w.near,3*k,glow);
  // Parallel guides fill the footprint, making the full hit area readable.
  for i: 1..<4 {
    q := f32(i)/4;
    side := w.left+(w.right-w.left)*q; front := w.near+(w.far-w.near)*q;
    n=xc_wave_segment(x,w,out,n,side,w.near,side,w.far,1.1*k,glow*0.55);
    n=xc_wave_segment(x,w,out,n,w.left,front,w.right,front,1.1*k,glow*0.55);
  }
  return n;
}
// ---- the frame: after Character Create's (cc.frame), in Experimental
xc_frame :: (s: [] Lab, out: [] f32, at: int, u: [] f32, w: f32, h: f32, k: f32, dt: f32) -> int {
  x := s[0].xc[..]; cr := s[0].creator[..]; hs := cr[0].hostiles[..];
  n := at;
  xc_start(x, x[0].klass);
  for i: 0..<36 { x[0].u[i] = ifx i < u.count then u[i] else 0; }
  x[0].w = w; x[0].h = h; x[0].k = k; x[0].seen = true;
  now := cr[0].clock;
  cr[0].weapon = ifx x[0].started then xc_kit(x[0].klass) else -1;
  x[0].present = react.react_present_drain(x[0].present);
  if dt > 0 && dt < 1 { rs_tick(x[0].b[..], ifx dt > 0.25 then 0.25 else dt); fb_seat_step(x[0].b[..], x[0].seat[..]); }
  xc_hostile_contacts(s);
  n=cc.combat_hud(cr[0],out,u,n,w,k);
  xc_strike_due(s);
  xc_lock_step(s);
  xc_stops_step(s);
  // Refresh both permissions after shared expiry, independently of body hit stop.
  xc_sync_permissions(s);
  // the column: under ANIMATIONS (its rows give it room: cc dev_visible), at the top without it
  col := xc_column(x[0]);
  cr[0].dev_below = col + f32(XC_GAP);
  x[0].top = ifx !cr[0].dev_animations then 20 * k else ifx cr[0].preview_collapsed then (52 + f32(XC_GAP)) * k else h - (20 + col) * k;
  bottom := x[0].top + col * k;
  if u.count > 54 {
    // gpu/character-glade.coax: the ANIMATIONS panel ends over the column (u[52]); the column's own dark panel (u[53], u[54])
    u[52] = ifx cr[0].dev_animations && !cr[0].preview_collapsed then cr[0].dev_below * k else 0;
    u[53] = x[0].top; u[54] = bottom;
  }
  head := ink_col(k, 0.95, 0.9, 0.7);
  n = cc.text(out, n, ifx x[0].open then "- CLASSES" else "+ CLASSES", 32 * k, x[0].top + 25 * k, 10 * k, head);
  if x[0].open {
    for c: 0..<FB_CL_N {
      y := x[0].top + (f32(XC_ROWS_TOP) + f32(c) * f32(XC_ROW) + 17) * k;
      n = cc.text(out, n, ifx c == x[0].klass then ">" else " ", 24 * k, y, 10 * k, ink_col(k, 0.95, 0.8, 0.4));
      n = cc.text(out, n, XC_CL_UP[c], 40 * k, y, 10 * k, ink_col(k, 0.91, 0.93, 0.88));
    }
  }
  level_y := x[0].top + (xc_class_height(x[0]) + 23) * k;
  n = cc.text(out, n, "LEVEL", 32 * k, level_y, 10 * k, head);
  for level: 1..<7 {
    digit: [1] u8; digit[0] = cast(u8) (48 + level);
    n = cc.text(out, n, cast(string) digit[..], (100 + f32(level - 1) * 34) * k, level_y, 10 * k,
      ifx level == x[0].level then ink_col(k, 1, 0.75, 0.3) else ink_col(k, 0.91, 0.93, 0.88));
  }
  // Hover the Thunderwave slot to preview its current footprint. A cast keeps
  // its footprint at the place and direction where it was released.
  wave_preview := x[0].hover >= 0 && x[0].hover < x[0].bar_n && !x[0].arranging && x[0].bar[x[0].hover].kind == FB_SPELL && x[0].bar[x[0].hover].sp == SP_THUNDERWAVE;
  wave_on := wave_preview || now < x[0].wave_until;
  wave := x[0].wave;
  if wave_preview { wave=xc_wave_make(x,cr[0].player_x,cr[0].player_z,cr[0].player_face); wave.y=cr[0].player_y; }
  if wave_on { n=xc_wave_draw(x,wave,out,n,k,ifx wave_preview then 0.8 else 1.0); }
  // the monsters' names and Hit Points over them, your target's in gold
  for i: 0..<XC_FOES {
    e := hs[0].enemies[i];
    c := x[0].b[0].c[1 + i];
    if e.dead { continue; }
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    if dx * dx + dz * dz > 30 * 30 || !hostile.hostile_sees(e, cr[0].player_x, cr[0].player_z) { continue; }
    p := xc_proj(x, e.x, meadow_y(e.x, e.z) + 1.55, e.z);
    if !p.ok || p.x < 0 || p.x > w || p.y < 0 || p.y > h { continue; }
    if p.x < 400 * k && p.y > x[0].top - 20 * k && p.y < bottom + 20 * k { continue; }   // not over the CLASSES column
    name := XC_FOE_NAMES[e.kind];
    on := i == x[0].target || (wave_on && xc_wave_contains(wave,e.x,e.z));
    cap := 9 * k;
    n = cc.text(out, n, name, p.x - xc_text_w(name, cap) / 2, p.y - 8 * k, cap, ifx on then ink_col(k, 1, 0.82, 0.4) else ink_col(k, 0.92, 0.9, 0.84));
    half := 26 * k; share := f32(rs_max(c.hp, 0)) / f32(rs_max(c.hp_max, 1));
    n = xc_line(out, n, p.x - half, p.y, p.x + half, p.y, 3 * k, 0.18, 0.06, 0.05);
    if share > 0 { n = xc_line(out, n, p.x - half, p.y, p.x - half + 2 * half * share, p.y, 3 * k, 0.86, 0.16, 0.12); }
  }
  // the numbers rising off whoever took them
  for q: 0..<XC_FLOATS {
    f := x[0].fl[q];
    if !f.on { continue; }
    a := (now - f.t0) / 1.2;
    if a < 0 || a > 1 { x[0].fl[q].on = false; continue; }
    base := ifx f.heal then f.y else meadow_y(f.x, f.z) + f.y;
    p := xc_proj(x, f.x, base + a * 0.9, f.z);
    if !p.ok { continue; }
    t := cast(string) f.text[0..<f.n];
    cap := 14 * k;
    n = cc.text(out, n, t, p.x - xc_text_w(t, cap) / 2, p.y, cap, ifx f.heal then ink_col(k, 0.5, 0.95, 0.55) else ink_col(k, 1, 0.55, 0.35));
  }
  // the bar: each slot's key over its picture; your class and your target over it
  m := 0;
  for i: 0..<x[0].bar_n {
    r := xc_slot_box(x[0], i);
    a := x[0].bar[i]; art := xc_art(a, i);
    m = put(x[0].media[..], m, "image "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
    m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
    m = xc_box_text(x[0].media[..], m, r); m = put(x[0].media[..], m, "\n");
    left := f32(XC_COOL) - (now - x[0].cool_at);
    if left > 0 {
      share := left / f32(XC_COOL);
      dim := cc.Box.{x0 = r.x0, y0 = r.y0, x1 = r.x1, y1 = r.y0 + (r.y1 - r.y0) * share};
      m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
      m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
      m = xc_box_text(x[0].media[..], m, dim); m = put(x[0].media[..], m, " 35 0 "); m = put_int(x[0].media[..], m, cast(int) (share * 1000)); m = put(x[0].media[..], m, "\n");
    }
    if i < 9 && xc_draw_slot_key(i,art) {key: [2] u8; key[0] = cast(u8) (49 + i);
     n = cc.text(out, n, cast(string) key[0..<1], r.x0 + 4 * k, r.y0 + 13 * k, 9 * k, ink_col(k, 0.98, 0.95, 0.85));}
    if i == x[0].used && left > 0 { n = xc_line(out, n, r.x0, r.y1 + 4 * k, r.x1, r.y1 + 4 * k, 1.5 * k, 1, 0.8, 0.4); }
  }
  // The picked-up icon follows the pointer, as in the original Everglade bar.
  if x[0].arranging && x[0].down >= 0 && x[0].down < x[0].bar_n {
    a := x[0].bar[x[0].down]; art := xc_art(a, 1);
    r := cc.Box.{x0 = x[0].drag_x - 26 * k, y0 = x[0].drag_y - 26 * k,
                x1 = x[0].drag_x + 26 * k, y1 = x[0].drag_y + 26 * k};
    m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
    m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
    m = xc_box_text(x[0].media[..], m, r); m = put(x[0].media[..], m, "\n");
  }
  // a spell that found no one ahead: its icon flashes red a moment (no words)
  if x[0].fizzle >= 0 && x[0].fizzle < x[0].bar_n && now - x[0].fizzle_at < 0.45 {
    r := xc_slot_box(x[0], x[0].fizzle); g := 1 - (now - x[0].fizzle_at) / 0.45; wd := 2.5 * k;
    n = xc_line(out, n, r.x0, r.y0, r.x1, r.y0, wd, 0.95 * g, 0.2 * g, 0.15 * g); n = xc_line(out, n, r.x0, r.y1, r.x1, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g);
    n = xc_line(out, n, r.x0, r.y0, r.x0, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g); n = xc_line(out, n, r.x1, r.y0, r.x1, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g);
    n = xc_line(out, n, r.x0 + 8 * k, r.y0 + 8 * k, r.x1 - 8 * k, r.y1 - 8 * k, wd, 0.95 * g, 0.2 * g, 0.15 * g);
  }
  if x[0].arranging && x[0].hover >= 0 && x[0].hover < x[0].bar_n {
    r := xc_slot_box(x[0], x[0].hover);
    n = xc_line(out, n, r.x0, r.y0, r.x1, r.y0, 3 * k, 1, 0.8, 0.4);
    n = xc_line(out, n, r.x0, r.y1, r.x1, r.y1, 3 * k, 1, 0.8, 0.4);
  }
  if !x[0].arranging && x[0].hover >= 0 && x[0].hover < x[0].bar_n {
    a := x[0].bar[x[0].hover];
    r := xc_slot_box(x[0], x[0].hover);
    cw := 358 * k; ch := 171 * k; cx := (r.x0 + r.x1) / 2;
    if cx - cw / 2 < 12 * k { cx = 12 * k + cw / 2; }
    if cx + cw / 2 > w - 12 * k { cx = w - 12 * k - cw / 2; }
    card := cc.Box.{x0 = cx - cw / 2, y0 = r.y0 - 30 * k - ch, x1 = cx + cw / 2, y1 = r.y0 - 30 * k};
    m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(a.art)); m = put(x[0].media[..], m, a.art);
    m = put(x[0].media[..], m, "-card-2x.jpg "); m = xc_box_text(x[0].media[..], m, card); m = put(x[0].media[..], m, "\n");
  }
  x[0].media_n = m;
  if x[0].bar_n > 0 {
    r0 := xc_slot_box(x[0], 0);
    line: [64] u8; ln := put(line[..], 0, XC_CL_UP[x[0].klass]);
    t := x[0].target;
    if t >= 0 && !hs[0].enemies[t].dead {
      c := x[0].b[0].c[1 + t];
      ln = put(line[..], ln, "  ·  "); ln = put(line[..], ln, ifx t < 3 then "IMP " else "GREMLIN ");
      ln = put_int(line[..], ln, rs_max(c.hp, 0)); ln = put(line[..], ln, " / "); ln = put_int(line[..], ln, c.hp_max); ln = put(line[..], ln, " HP");
    }
    tl := cast(string) line[0..<ln];
    n = cc.text(out, n, tl, (w - xc_text_w(tl, 10 * k)) / 2, r0.y0 - 12 * k, 10 * k, ink_col(k, 0.95, 0.9, 0.7));
  }
  // the effects: the frame's puffs for the host to draw (fivelab-fx.wgsl)
  pf := s[0].puffs[..];
  fxp_begin(pf, now, fxp_v(u[16], u[17], u[18]));
  fxp_emit_all(pf, now);
  _ := fxp_close(pf);
  return n;
}
xc_box_text :: (buf: [] u8, at: int, r: cc.Box) -> int {
  m := put_int(buf, at, cast(int) r.x0); m = put(buf, m, " "); m = put_int(buf, m, cast(int) r.y0); m = put(buf, m, " ");
  m = put_int(buf, m, cast(int) r.x1); m = put(buf, m, " "); return put_int(buf, m, cast(int) r.y1);
}
ink_col :: (k: f32, r: f32, g: f32, b: f32) -> Ink { return cc.ink(k, r, g, b); }
meadow_y :: (x: f32, z: f32) -> f32 { return xmeadow.exp_height(x, z); }
xc_line :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, wide: f32, r: f32, g: f32, b: f32) -> int {
  if cc.lit(out, n, ax, ay, bx, by, wide, 1, 0, r, g, b, 0) { return n + 6; }
  return n;
}

// ---- input
// Keys 1 to N press the bar's slots.
xc_key :: (s: [] Lab, key: int) -> bool {
  x := s[0].xc[..];
  if key >= '1' && key <= '9' { i := key - '1'; if i < x[0].bar_n { _ := xc_press(s, i); return true; } }
  return false;
}
// The column and the bar are pressed; a click (no drag) on a monster makes it your target. False
// leaves the pointer to Character Create (the camera, the ANIMATIONS browser).
xc_pointer :: (s: [] Lab, px: f32, py: f32, phase: int, id: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..];
  if !x[0].seen || cr[0].walk.on { return false; }
  k := x[0].k;
  over := -1;
  for i: 0..<x[0].bar_n { if xc_in(xc_slot_box(x[0], i), px, py) { over = i; } }
  x[0].hover = over;
  in_col := px >= 12 * k && px <= 370 * k && py >= x[0].top && py <= x[0].top + xc_column(x[0]) * k;
  if phase == 0 {
    x[0].down = -100; x[0].down_x = px; x[0].down_y = py; x[0].down_id = id;
    if over >= 0 { x[0].down = over; x[0].arranging = s[0].shift; x[0].drag_x = px; x[0].drag_y = py; return true; }
    if in_col { x[0].down = -2; return true; }
    x[0].down = -3;   // the world: a click or the camera's drag
    return false;
  }
  if phase == 2 && id == x[0].down_id {
    d := x[0].down; x[0].down = -100;
    if d >= 0 {
      if x[0].arranging { xc_swap(x, d, over); x[0].arranging = false; }
      else if d == over { _ := xc_press(s, d); }
      return true;
    }
    if d == -2 {
      if in_col {
        if py >= x[0].top + xc_class_height(x[0]) * k {
          level := cast(int) floor((px / k - 94) / 34) + 1;
          if level >= 1 && level <= 6 { xc_set_level(x, level); }
        }
        else if py < x[0].top + f32(XC_HEAD) * k { x[0].open = !x[0].open; }
        else if x[0].open {
          row := cast(int) floor((py - x[0].top - f32(XC_ROWS_TOP) * k) / (f32(XC_ROW) * k));
          if py >= x[0].top + f32(XC_ROWS_TOP) * k && row >= 0 && row < FB_CL_N { xc_set_class(x, row); }
        }
      }
      return true;
    }
    return false;
  }
  if phase == 3 && id == x[0].down_id { x[0].down = -100; x[0].arranging = false; return true; }
  if phase == 1 && x[0].arranging && id == x[0].down_id { x[0].drag_x = px; x[0].drag_y = py; }
  return x[0].down >= 0 || x[0].down == -2;
}
// What the checks read (lab_creator_probe 900 on).
xc_probe :: (s: [] Lab, f: int) -> int {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[..];
  if f == 900 { return x[0].klass; }
  if f == 901 { return x[0].bar_n; }
  if f == 902 { return x[0].casts; }
  if f == 903 { return x[0].landed; }
  if f == 904 { return x[0].kills; }
  if f == 905 { return x[0].target; }
  if f == 906 { return x[0].refused; }
  if f == 909 { return x[0].whiffs; }
  if f == 916 { return s[0].creator[0].weapon; }
  if f == 917 { return x[0].pend; }
  if f == 918 { return x[0].contacts; }
  if f == 919 { return x[0].fallbacks; }
  if f == 932 { return x[0].exhausted; }
  if f == 933 { return cast(int) (x[0].blade_step * 1000); }
  if f == 934 { return x[0].shown; }
  if f == 935 { return x[0].suppressed; }
  if f == 936 { return x[0].stops.n; }
  if f >= 990 && f < 996 { return ifx hs[0].enemies[f - 990].stopped then 1 else 0; }
  if f == 907 { return x[0].last_dmg; }
  if f == 908 { return hs[0].hp; }
  if f >= 910 && f < 916 { return ifx x[0].started then x[0].b[0].c[1 + f - 910].hp else -1; }
  if f >= 920 && f < 932 {
    i := (f - 920) / 2; e := hs[0].enemies[i];
    p := xc_proj(x, e.x, meadow_y(e.x, e.z) + 0.8, e.z);
    if !p.ok { return -1; }
    return cast(int) (ifx (f - 920) % 2 == 0 then p.x else p.y);
  }
  if f >= 940 && f < 946 { return ifx hs[0].enemies[f - 940].dead then 1 else 0; }
  if f >= 950 && f < 962 { return cast(int) (x[0].top + (f32(XC_ROWS_TOP) + f32(f - 950) * f32(XC_ROW) + 12) * x[0].k); }
  if f >= 970 && f < 976 { r := xc_slot_box(x[0], f - 970); return cast(int) ((r.x0 + r.x1) / 2); }
  if f == 976 { r := xc_slot_box(x[0], 0); return cast(int) ((r.y0 + r.y1) / 2); }
  if f >= 980 && f < 986 { return cast(int) (x[0].bar[f - 980].sp); }
  return -1;
}

#test "the class icon already carries its key and other slots draw theirs" {
 bar:[XC_SLOTS]FbAb;for c:0..<FB_CL_N {n:=xc_bar(c,bar[..]);#assert !xc_draw_slot_key(0,bar[0].art);for i:1..<n {#assert xc_draw_slot_key(i,bar[i].art);}}
 #assert xc_draw_slot_key(0,"attack") && xc_draw_slot_key(1,"cl-second-wind");
}
#test "experimental combat: every class's level 1 bar holds its Character Create ability first, each slot with its picture" #steps 400000000 {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    n := xc_bar(c, bar[..]);
    #assert n >= 1 && n <= XC_SLOTS;
    #assert bar[0].kind == fb_cl_ability(c).kind && bar[0].name == fb_cl_ability(c).name && xc_url(bar[0].art) == XC_EG_URL;
    for i: 0..<n { #assert bar[i].art.count > 0; if i > 0 { #assert xc_url(bar[i].art) == XC_MMO_URL; } }
  }
  #assert xc_bar(FB_CL_WIZARD, bar[..]) == 5 && bar[0].sp == SP_FIRE_BOLT;
  #assert xc_bar(FB_CL_FIGHTER, bar[..]) == 2 && bar[1].kind == FB_ATTACK;
}
#test "experimental combat: a Wizard's Fire Bolt and a Fighter's Attack fell a monster, which then lies still" #steps 2000000000 {
  for pass: 0..<2 {
    s: [1] Lab;
    lab_message(s[..], 600, "url=http://localhost/worlds/everglade-experimental\n");
    cr := s[0].creator[..]; h := cr[0].hostiles[..];
    h[0].ready = true; h[0].hp = XC_PLAYER_MAX; for i: 0..<XC_FOES { h[0].enemies[i].swing = -1; }
    x := s[0].xc[..];
    xc_start(x, ifx pass == 0 then FB_CL_WIZARD else FB_CL_FIGHTER);
    xc_set_class(x, ifx pass == 0 then FB_CL_WIZARD else FB_CL_FIGHTER);
    // one imp just ahead of you (in reach of a sword), the rest far off
    cr[0].player_x = 0; cr[0].player_z = 0;
    for i: 0..<XC_FOES { h[0].enemies[i].x = 60; h[0].enemies[i].z = 60 + f32(i) * 3; }
    h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.2; cr[0].player_face = 0;   // ahead of you (you face +z)
    slot := ifx pass == 0 then 0 else 1;   // Fire Bolt is slot 1; the Fighter's Attack slot 2
    #assert (pass == 0 && x[0].bar[0].sp == SP_FIRE_BOLT) || (pass == 1 && x[0].bar[1].kind == FB_ATTACK);
    tries := 0;
    while !h[0].enemies[0].dead && tries < 60 {
      cr[0].clock += 1.1; h[0].hp = XC_PLAYER_MAX;
      _ := xc_press(s[..], slot); tries += 1;
    }
    #assert h[0].enemies[0].dead && x[0].kills == 1 && x[0].landed >= 1 && x[0].casts >= 1;
    #assert x[0].b[0].c[1].hp <= 0 && x[0].target == -1;
    // the felled imp is out of the fight: the next press finds no one in reach for a sword, and no one is hurt
    for i: 1..<XC_FOES { #assert x[0].b[0].c[1 + i].hp == x[0].b[0].c[1 + i].hp_max; }
  }
}

// A fresh fight for the aim checks: class c, you at the origin facing +z (or `face`), every monster
// far away except those the check places.
xc_test_lab :: (s: [] Lab, c: int, face: f32) {
  lab_message(s, 600, "url=http://localhost/worlds/everglade-experimental\n");
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  h[0].ready = true; h[0].hp = XC_PLAYER_MAX;
  for i: 0..<XC_FOES { h[0].enemies[i].swing = -1; h[0].enemies[i].x = 70 + f32(i) * 3; h[0].enemies[i].z = -70; }
  xc_start(s[0].xc[..], c); xc_set_class(s[0].xc[..], c);
  cr[0].player_x = 0; cr[0].player_z = 0; cr[0].player_face = face;
}
xc_hp_sum :: (s: [] Lab) -> int { t := 0; for i: 0..<XC_FOES { t += s[0].xc[0].b[0].c[1 + i].hp; } return t; }
#test "experimental combat: a bolt flies the way you face; one behind you is never hit, one ahead is, and a miss does no damage" #steps 2000000000 {
  // behind you (you face +z, the imp 8 m at -z), fifty Fire Bolts: none touch it
  s: [1] Lab; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = -8;
  hp := xc_hp_sum(s[..]);
  for i: 0..<50 { s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp && s[0].xc[0].whiffs == 50 && s[0].xc[0].landed == 0 && s[0].xc[0].target == -1;
  // beside you, out of the 5 degree help: never hit either
  h[0].enemies[0].x = 6; h[0].enemies[0].z = 6;
  for i: 0..<20 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp;
  // past Fire Bolt's 120 feet (36.6 m) straight ahead: it fizzles short of it
  h[0].enemies[0].x = 0; h[0].enemies[0].z = 40;
  for i: 0..<20 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp;
  // turn round to face it, or put it ahead a little off the line (within 5 degrees): it is struck at
  h[0].enemies[0].x = 0.9; h[0].enemies[0].z = 20;   // 2.6 degrees off
  m := xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.kind == XC_AIM_BOLT && m.foe == 0 && abs(m.reach - 36.576) < 0.01;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = -8; s[0].creator[0].player_face = 3.14159265;
  m = xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.foe == 0;
  // the first monster on the line is the one struck, not one behind it
  h[0].enemies[1].x = 0; h[0].enemies[1].z = -4;
  m = xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.foe == 1;
  h[0].enemies[1].z = -70;
  landed := 0; tries := 0;
  while s[0].xc[0].landed == 0 && tries < 40 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); tries += 1; }
  #assert s[0].xc[0].landed == 1 && xc_hp_sum(s[..]) < hp && s[0].xc[0].target == 0;
}
#test "experimental combat: a blow strikes ahead within reach and nothing behind is picked" #steps 2000000000 {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
  h := s[0].creator[0].hostiles[..]; bar := s[0].xc[0].bar[1];   // Attack (a longsword: a blow)
  #assert xc_aim_kind(s[..], bar).kind == XC_AIM_MELEE;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = -1.2;   // right behind you
  hp := xc_hp_sum(s[..]);
  for i: 0..<30 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 1); }
  #assert xc_hp_sum(s[..]) == hp && s[0].xc[0].landed == 0;
  h[0].enemies[0].x = 1.0; h[0].enemies[0].z = 1.0;   // 45 degrees ahead, in reach
  #assert xc_aim(s[..], bar).foe == 0;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = 3.5;     // ahead but out of reach
  #assert xc_aim(s[..], bar).foe == -1;
  #assert xc_aim_kind(s[..], s[0].xc[0].bar[0]).kind == XC_AIM_SELF;
}
#test "experimental combat: a save spell takes the cone ahead and nothing outside is picked" #steps 2000000000 {
  // Sacred Flame: the nearest in range within 30 degrees ahead, or nothing (its icon fizzles, no turn spent)
  c: [1] Lab; xc_test_lab(c[..], FB_CL_CLERIC, 0);
  g := c[0].creator[0].hostiles[..]; flame := c[0].xc[0].bar[0];
  #assert xc_aim_kind(c[..], flame).kind == XC_AIM_CONE;
  g[0].enemies[0].x = 4; g[0].enemies[0].z = 4;      // 45 degrees off: outside the cone
  c[0].creator[0].clock = 5;
  #assert !xc_press(c[..], 0) && c[0].xc[0].fizzle == 0 && c[0].xc[0].casts == 0;
  g[0].enemies[0].x = 1; g[0].enemies[0].z = 8;      // 7 degrees off: inside
  #assert xc_aim(c[..], flame).foe == 0;
}
#test "experimental combat: Thunderwave's cube follows the facing direction" #steps 2000000000 {
  // Thunderwave's cube is set ahead of you; Second Wind is yours
  w: [1] Lab; xc_test_lab(w[..], FB_CL_WIZARD, 1.5707963);
  tw := xc_aim(w[..], w[0].xc[0].bar[4]); #assert tw.kind == XC_AIM_AREA && tw.fx > 0.99 && abs(tw.reach - 4.572) < 0.01;
}
#test "experimental combat: a melee class holds its weapon, and a blow lands where its blade meets a monster, not at the press" #steps 2000000000 {
  #assert xc_kit(FB_CL_BARBARIAN) == 0 && cc.CC_KIT_TWO[0] && xc_kit(FB_CL_FIGHTER) == 1 && xc_kit(FB_CL_PALADIN) == 2;
  #assert xc_kit(FB_CL_RANGER) == 3 && xc_kit(FB_CL_ROGUE) == 3 && xc_kit(FB_CL_MONK) == -1 && xc_kit(FB_CL_WIZARD) == -1 && xc_kit(FB_CL_CLERIC) == -1;
  s: [1] Lab; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.2;   // just ahead, in reach
  hp := xc_hp_sum(s[..]);
  tries := 0;
  while s[0].xc[0].landed == 0 && tries < 40 {
    s[0].creator[0].clock += 1.1 + figs.bd_seconds(figs.BD_SLASH);   // past the cooldown, which starts when the last blow landed
    #assert xc_press(s[..], 1);
    // the swing has begun (the slash clip, an action), the blow not yet landed: no one is hurt at the press
    #assert s[0].xc[0].pend == 1 && s[0].creator[0].swing_clip == figs.BD_SLASH && s[0].creator[0].swing_at == s[0].creator[0].clock;
    #assert s[0].xc[0].swing.phase == act.ActionPhase.running && act.action_admit(s[0].xc[0].swing_def) == act.ActionStatus.ok;
    #assert xc_hp_sum(s[..]) == hp || tries > 0;
    // through the swing it lands, once
    c0 := s[0].xc[0].contacts;
    s[0].creator[0].clock += figs.bd_seconds(figs.BD_SLASH) + 0.05; xc_strike_due(s[..]);
    #assert s[0].xc[0].pend == -1 && s[0].xc[0].contacts == c0 + 1;
    s[0].creator[0].clock -= figs.bd_seconds(figs.BD_SLASH) + 0.05;
    tries += 1;
  }
  #assert s[0].xc[0].landed == 1 && xc_hp_sum(s[..]) < hp && s[0].xc[0].fallbacks > 0;
}
#test "experimental combat: two-handed weapons use the owned cleave's impact timing" #steps 2000000000 {
  // the Barbarian's greataxe and the Fighter's greatsword swing the owned two-handed cleave, its impact the action's
  t: [1] Lab; xc_test_lab(t[..], FB_CL_BARBARIAN, 0); t[0].creator[0].clock = 5;
  #assert xc_press(t[..], 1) && t[0].creator[0].swing_clip == figs.BD_OWN + figs.TWOHAND_AXE_CLEAVE && t[0].creator[0].weapon == 0;
  d := t[0].xc[0].swing_def;
  #assert d.events[1].kind == act.ActionEventKind.impact && d.events[1].tick == cast(int) floor(f64(figs.BD_OWN_IMPACT) * f64(d.length) + 0.5);
  #assert d.length == act.action_ticks_of_seconds(f64(figs.bd_seconds(figs.BD_OWN + figs.TWOHAND_AXE_CLEAVE)));
  xc_test_lab(t[..], FB_CL_FIGHTER, 0); t[0].creator[0].clock = 9; t[0].xc[0].pend = -1;
  #assert xc_press(t[..], 1) && t[0].creator[0].swing_clip == figs.BD_OWN + figs.TWOHAND_SWORD_CLEAVE && t[0].creator[0].weapon == 1;
}
#test "experimental combat: a caster's spell resolves without a weapon swing" #steps 2000000000 {
  // a caster's spell resolves at once, with no swing
  w: [1] Lab; xc_test_lab(w[..], FB_CL_WIZARD, 0); w[0].creator[0].clock = 5;
  #assert xc_press(w[..], 0) && w[0].xc[0].pend == -1 && w[0].creator[0].swing_clip == -1;
}

#test "experimental combat level progression" {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    for level: 1..<7 {
      n := xc_bar_level(c, level, bar[..]);
      #assert n > 0 && n <= XC_SLOTS;
      #assert bar[0].kind == fb_cl_ability(c).kind;
      hero := fb_cl_hero(c, "You", 0, level);
      for i: 0..<n { if bar[i].kind == FB_SPELL { #assert rs_spell_ready(hero, bar[i].sp); } }
    }
  }
  n1 := xc_bar_level(FB_CL_WIZARD, 1, bar[..]);
  for i: 0..<n1 { #assert bar[i].sp != SP_SCORCHING_RAY && bar[i].sp != SP_FIREBALL; }
  n3 := xc_bar_level(FB_CL_WIZARD, 3, bar[..]); found := false;
  for i: 0..<n3 { if bar[i].sp == SP_SCORCHING_RAY { found = true; } #assert bar[i].sp != SP_FIREBALL; }
  #assert found;
  n5 := xc_bar_level(FB_CL_WIZARD, 5, bar[..]); found = false;
  for i: 0..<n5 { if bar[i].sp == SP_FIREBALL { found = true; } }
  #assert found;
  n2 := xc_bar_level(FB_CL_FIGHTER, 2, bar[..]); found = false;
  for i: 0..<n2 { if bar[i].kind == FB_SURGE { found = true; } }
  #assert found;
}

#test "experimental combat changing level preserves class and monsters" {
  x: [1] XcCombat; xc_start(x[..], FB_CL_FIGHTER);
  x[0].b[0].c[1].hp = 3;
  xc_set_level(x[..], 5);
  #assert x[0].klass == FB_CL_FIGHTER && x[0].level == 5 && x[0].b[0].c[0].level == 5;
  #assert x[0].b[0].c[1].hp == 3;
  xc_set_level(x[..], 7);
  #assert x[0].level == 5;
  xc_set_class(x[..], FB_CL_WIZARD);
  #assert x[0].level == 5 && x[0].b[0].c[0].level == 5;
}

#test "experimental combat level selector and multirow hotbar" {
  s: [1] Lab; xc_start(s[0].xc[..], FB_CL_WIZARD);
  x := s[0].xc[..]; x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800; x[0].top = 60;
  y := x[0].top + xc_class_height(x[0]) + 15;
  #assert xc_pointer(s[..], 174, y, 0, 1);
  #assert xc_pointer(s[..], 174, y, 2, 1);
  #assert x[0].level == 3 && x[0].b[0].c[0].level == 3;
  x[0].bar_n = 12;
  a := xc_slot_box(x[0], 0); b := xc_slot_box(x[0], 9);
  #assert a.y0 < b.y0 && a.x0 >= 0 && b.x1 <= x[0].w;
  x[0].open = false; y = x[0].top + xc_class_height(x[0]) + 15;
  #assert xc_pointer(s[..], 276, y, 0, 1);
  #assert xc_pointer(s[..], 276, y, 2, 1);
  #assert x[0].level == 6;
}

#test "experimental combat shift drag swaps keys without casting and cancels safely" {
  s: [1] Lab; s[0].creator[0].experimental = true; xc_start(s[0].xc[..], FB_CL_WIZARD);
  x := s[0].xc[..]; x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800;
  a := xc_slot_box(x[0], 0); b := xc_slot_box(x[0], 1); first := x[0].bar[0].sp; second := x[0].bar[1].sp;
  s[0].shift = true;
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 7);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 1, 7);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 2, 7);
  #assert x[0].bar[0].sp == second && x[0].bar[1].sp == first && x[0].casts == 0;
  #assert xc_art(x[0].bar[1], 1) == rs_spell(first).id && xc_draw_slot_key(1, xc_art(x[0].bar[1], 1));
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 8);
  #assert xc_pointer(s[..], 600, 200, 2, 8);
  #assert x[0].bar[0].sp == second && x[0].casts == 0;
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 9);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 3, 9);
  #assert x[0].bar[0].sp == second && x[0].casts == 0;
  xc_set_level(x, 5); xc_set_level(x, 1);
  #assert x[0].bar[0].sp == second && x[0].bar[1].sp == first;
}

#test "experimental combat hotbar arrangement survives a reload" {
  x: [1] XcCombat; xc_start(x[..], FB_CL_WIZARD); xc_swap(x[..], 0, 1);
  first := x[0].bar[0].sp; second := x[0].bar[1].sp;
  text: [4096] u8; n := xc_order_save(x[..], text[..]); #assert n > 0;
  y: [1] XcCombat; #assert xc_order_load(y[..], cast(string) text[0..<n]);
  xc_start(y[..], FB_CL_WIZARD);
  #assert y[0].bar[0].sp == first && y[0].bar[1].sp == second;
  #assert !xc_order_load(y[..], "xc-bar 1\n999999\n");
  #assert y[0].bar[0].sp == first;
}

#test "experimental combat stores swaps through the host" {
  s: [1] Lab; s[0].creator[0].on = true; s[0].creator[0].experimental = true;
  xc_start(s[0].xc[..], FB_CL_WIZARD); xc_swap(s[0].xc[..], 0, 1);
  #assert lab_action(s[..]) == 12 && s[0].out_n > 0;
  t: [1] Lab; lab_message(t[..], 12, cast(string) s[0].outbox[0..<s[0].out_n]);
  xc_start(t[0].xc[..], FB_CL_WIZARD);
  #assert t[0].xc[0].bar[0].sp == s[0].xc[0].bar[0].sp;
}
// One Fighter swing at a monster ahead, the frames dt apart (alternating with dt2): the accepted contacts.
xc_test_swing :: (dt: f32, dt2: f32, foe_z: f32) -> int {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0.2; h[0].enemies[0].z = foe_z; h[0].enemies[1].x = -0.3; h[0].enemies[1].z = foe_z;
  s[0].creator[0].clock = 3;
  if !xc_press(s[..], 1) { return -1; }
  i := 0;
  while s[0].xc[0].pend >= 0 && i < 2000 { s[0].creator[0].clock += ifx i % 2 == 0 then dt else dt2; xc_strike_due(s[..]); i += 1; }
  return s[0].xc[0].contacts * 100 + s[0].xc[0].whiffs;
}
#test "experimental combat: one swing makes one contact at 30, 60 and 144 FPS" #steps 2000000000 {
  #assert xc_test_swing(1.0 / 30, 1.0 / 30, 1.2) == 100;
  #assert xc_test_swing(1.0 / 60, 1.0 / 60, 1.2) == 100;
  #assert xc_test_swing(1.0 / 144, 1.0 / 144, 1.2) == 100;
}
#test "experimental combat: one swing makes one contact over uneven frames and a stall; out of reach it whiffs" #steps 2000000000 {
  #assert xc_test_swing(0.004, 0.051, 1.2) == 100;
  #assert xc_test_swing(2.0, 2.0, 1.2) == 100;      // the whole swing in one frame: caught up tick by tick
  #assert xc_test_swing(1.0 / 60, 1.0 / 60, 3.5) == 1;   // out of the blade's reach: the air
}

#test "experimental combat dash propels the player forward and stops after its burst" {
  s: [1] Lab; s[0].creator[0].experimental = true; s[0].creator[0].hostiles[0].ready = true; s[0].creator[0].hostiles[0].hp = 44;
  s[0].creator[0].player_face = 0.5; xc_start(s[0].xc[..], FB_CL_BARBARIAN);
  dash := -1; for i: 0..<s[0].xc[0].bar_n { if s[0].xc[0].bar[i].kind == FB_DASH { dash = i; } }
  #assert dash >= 0 && xc_press(s[..], dash);
  input := lab_move_in(s[..]);
  #assert input.key_y == 1 && input.key_x == 0 && input.link_flags & 512 != 0;
  #assert lab_move_world(s[..], 0, 0).link_flags & 512 != 0;
  #assert abs(input.theta - (0.5 - 3.14159265)) < 0.001;
  s[0].creator[0].clock += 2;
  input = lab_move_in(s[..]); #assert input.link_flags & 512 == 0 && input.key_y == 0;
  s[0].creator[0].clock += 1; #assert xc_press(s[..], dash);
  s[0].creator[0].hostiles[0].hp = 0; input = lab_move_in(s[..]); #assert input.link_flags & 512 == 0;
}

#test "no two abilities a class has at once share a cast sound, at every level 1 to 6, and every sound exists" {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    for level: 1..<7 {
      n := xc_bar_level(c, level, bar[..]);
      for i: 0..<n {
        d := xc_sound(bar[i], c);
        #assert d.start.count > 0 && d.rate >= 0.5 && d.rate <= 2;
        for name: [4] string.[d.start, d.layer, d.hit, d.miss] {
          if name.count > 0 { #assert exsound.sfx_id(name) >= 0 || exsound.xsfx_id(name) >= 0; }
        }
        for j: 0..<i { #assert xc_sound(bar[j], c).start != d.start; }
      }
    }
  }
  // the ones the owner named sound as asked
  #assert xc_spell_sound(SP_FIRE_BOLT).start == "fire-cast" && xc_spell_sound(SP_FIRE_BOLT).hit == "fire-hit";
  #assert xc_spell_sound(SP_RAY_OF_FROST).start == "frost-cast" && xc_spell_sound(SP_ELDRITCH_BLAST).rate < 1;
  #assert xc_spell_sound(SP_SACRED_FLAME).start == "choir" && xc_spell_sound(SP_GUIDING_BOLT).start == "radiant";
  #assert xc_spell_sound(SP_THUNDERWAVE).layer == "thunder" && xc_spell_sound(SP_VICIOUS_MOCKERY).start == "psychic-cast";
  #assert xc_spell_sound(SP_CURE_WOUNDS).start == "heal" && xc_spell_sound(SP_FIRE_BOLT).miss == "fizzle";
  axe := xc_sound(xc_attack(), FB_CL_BARBARIAN); sword := xc_sound(xc_attack(), FB_CL_PALADIN); great := xc_sound(xc_attack(), FB_CL_FIGHTER);
  #assert axe.start == "swing-heavy" && axe.hit == "hit-heavy" && axe.rate < great.rate && sword.start == "swing" && sword.hit == "hit";
  rage: FbAb; rage.kind = FB_RAGE; second: FbAb; second.kind = FB_SECOND;
  #assert xc_sound(rage, FB_CL_BARBARIAN).start == "rage-roar" && xc_sound(second, FB_CL_FIGHTER).start == "second-wind";
}

#test "experimental Thunderwave hits the whole forward cube at diagonal facings" #steps 2000000000 {
  for turn: 0..<4 {
    s: [1] Lab; face := 0.78539816 + f32(turn)*1.5707963; xc_test_lab(s[..], FB_CL_WIZARD, face);
    h := s[0].creator[0].hostiles[..]; fx := sin(face); fz := cos(face); rx := fz; rz := -fx;
    // Three creatures in a broad fan ahead, one at the shoulder, and one safely behind.
    h[0].enemies[0].x = fx*2; h[0].enemies[0].z = fz*2;
    h[0].enemies[1].x = fx*2+rx*1.2; h[0].enemies[1].z = fz*2+rz*1.2;
    h[0].enemies[2].x = fx*2-rx*1.2; h[0].enemies[2].z = fz*2-rz*1.2;
    h[0].enemies[3].x = rx*1.2; h[0].enemies[3].z = rz*1.2;
    h[0].enemies[4].x = -fx*2; h[0].enemies[4].z = -fz*2;
    s[0].creator[0].clock = 10; #assert xc_press(s[..], 4);
    for i: 0..<4 { #assert s[0].xc[0].b[0].c[i+1].hp < s[0].xc[0].b[0].c[i+1].hp_max; }
    #assert s[0].xc[0].b[0].c[5].hp == s[0].xc[0].b[0].c[5].hp_max;
    #assert s[0].xc[0].b[0].c[5].x == xc_square(h[0].enemies[4].x) && s[0].xc[0].b[0].c[5].y == xc_square(h[0].enemies[4].z);
  }
}

#test "experimental Thunderwave pushes a creature that fails its save in the scene" #steps 2000000000 {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; b := s[0].xc[0].b[..];
  b[0].c[1].score[RS_CON] = 1; pushed := false;
  for attempt: 0..<12 {
    h[0].enemies[0].x = 0; h[0].enemies[0].z = 2; h[0].enemies[0].dead = false;
    b[0].c[1].hp = b[0].c[1].hp_max; b[0].c[1].dead = false;
    s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 4);
    if h[0].enemies[0].z > 2.1 { pushed = true; break; }
  }
  #assert pushed;
}

#test "experimental Thunderwave area outline matches every grid square it can hit" {
  s: [1] Lab; xc_start(s[0].xc[..], FB_CL_WIZARD);
  for turn: 0..<4 {
    face := f32(turn)*0.78539816; wave := xc_wave_make(s[0].xc[..], 4, -6, face);
    b := s[0].xc[0].b[..]; z := rs_area(b, 0, rs_spell(SP_THUNDERWAVE), XC_MID, XC_MID+3);
    for side: -4..<5 { for forward: -3..<6 {
      wx := wave.x + f32(side)*f32(XC_SQ)*wave.fz + f32(forward)*f32(XC_SQ)*wave.fx;
      wz := wave.z - f32(side)*f32(XC_SQ)*wave.fx + f32(forward)*f32(XC_SQ)*wave.fz;
      #assert xc_wave_contains(wave, wx, wz) == rs_inside(z, XC_MID+side, XC_MID+forward);
    } }
  }
}

#test "experimental Thunderwave shows its cast area and keeps it at the cast position" {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_WIZARD, 0.78539816);
  s[0].creator[0].clock = 4; #assert xc_press(s[..], 4);
  #assert s[0].xc[0].wave_until > 4 && s[0].xc[0].wave.x == 0 && s[0].xc[0].wave.z == 0;
  #assert abs(s[0].xc[0].wave.fx - sin(0.78539816f32)) < 0.001;
  s[0].creator[0].player_x = 10; #assert s[0].xc[0].wave.x == 0;
}
#test "experimental combat: your target is held by attention, never picked for you, kept through the grace and dropped when it falls" #steps 2000000000 {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 6; h[0].enemies[1].x = 0.5; h[0].enemies[1].z = 3;
  // a monster near and ahead is not your target until you strike at it
  s[0].creator[0].clock = 2; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;
  xc_lock_on(s[..], 0); xc_lock_step(s[..]);
  #assert s[0].xc[0].target == 0 && s[0].xc[0].lock.reason == attn.AttnReason.kept && s[0].xc[0].lock.runner == -1;
  // behind you and 20 m off: still yours
  h[0].enemies[0].z = -20; s[0].creator[0].clock += 0.5; xc_lock_step(s[..]); #assert s[0].xc[0].target == 0;
  // past 24 m: held through the second's grace, then let go, and the near one is not taken instead
  h[0].enemies[0].z = -30; s[0].creator[0].clock += 0.5; xc_lock_step(s[..]);
  #assert s[0].xc[0].target == 0 && s[0].xc[0].lock.reason == attn.AttnReason.out_of_range;
  s[0].creator[0].clock += 0.3; xc_lock_step(s[..]); #assert s[0].xc[0].target == 0;    // 51 ticks lost: within the grace
  s[0].creator[0].clock += 0.2; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;   // 64: let go
  // back in reach after the release: nothing is acquired for you
  h[0].enemies[0].z = 4; s[0].creator[0].clock += 0.1; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;
  // a fallen target is dropped at once, with no grace
  xc_lock_on(s[..], 1); xc_lock_step(s[..]); #assert s[0].xc[0].target == 1;
  h[0].enemies[1].dead = true; s[0].creator[0].clock += 1.0 / 64; xc_lock_step(s[..]);
  #assert s[0].xc[0].target == -1 && s[0].xc[0].lock.reason == attn.AttnReason.invalid;
}
#test "experimental combat: a landed blow holds the struck monster for its hit stop, a monster's landed blow holds it, and nothing else pauses" #steps 2000000000 {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.2;
  hp := xc_hp_sum(s[..]); tries := 0; stopped := false;
  while xc_hp_sum(s[..]) == hp && tries < 40 {
    s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 1);
    for f: 0..<60 { s[0].creator[0].clock += 1.0 / 60; xc_strike_due(s[..]); xc_stops_step(s[..]); if h[0].enemies[0].stopped { stopped = true; break; } }
    tries += 1;
  }
  // struck and alive: it is held, for XC_STOP_STRUCK ticks, and the other monsters are not
  if s[0].xc[0].b[0].c[1].hp > 0 {
    #assert stopped && s[0].xc[0].stops.n == 1 && s[0].xc[0].target == 0;
    for i: 1..<XC_FOES { #assert !h[0].enemies[i].stopped; }
    s[0].creator[0].clock += f32(XC_STOP_STRUCK + 1) / 64; xc_stops_step(s[..]);
    #assert !h[0].enemies[0].stopped && s[0].xc[0].stops.n == 0;
  }
  // a monster's blow that lands on you holds that monster (the striker) for XC_STOP_STRIKER ticks
  h[0].last = 3; h[0].hits += 1; xc_stops_step(s[..]);
  #assert h[0].enemies[3].stopped && !h[0].enemies[0].stopped;
  s[0].creator[0].clock += f32(XC_STOP_STRIKER) / 64; xc_stops_step(s[..]); #assert !h[0].enemies[3].stopped;
  // the same landed blow is given its stop once
  xc_stops_step(s[..]); #assert !h[0].enemies[3].stopped && s[0].xc[0].stops.n == 0;
}
#test "experimental combat: numbers go through the presentation queue, capped a source a frame and counted" {
  s: [1] Lab; xc_test_lab(s[..], FB_CL_WIZARD, 0); x := s[0].xc[..];
  for i: 0..<10 { xc_float_int(x, f32(i), 1.9, 0, 1, 3 + i, false); }
  #assert x[0].shown == XC_FLOATS && x[0].suppressed == 2;
  // another source has its own share; the next frame starts empty
  xc_float_from(x, 4, 0, 1.9, 0, 1, "MISS", false); #assert x[0].shown == XC_FLOATS + 1;
  x[0].present = react.react_present_drain(x[0].present);
  xc_float_int(x, 0, 1.9, 0, 2, 7, false); #assert x[0].shown == XC_FLOATS + 2 && x[0].suppressed == 2;
}

#test "experimental combat: Stunned hostiles can move but cannot attack and restraint preserves separate action permission" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  h[0].enemies[0].swing=0.34;
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_STUNNED,by=0,spell=-1,until=60,save=-1});
  xc_sync_permissions(s[..]);
  #assert !h[0].enemies[0].held && h[0].enemies[0].inactive && h[0].enemies[0].swing<0;
  for i: 1..<XC_FOES { h[0].enemies[i].dead=true; }
  h[0].enemies[0].x=4; h[0].enemies[0].z=0;
  hostile.hostile_tick(h,0,0,0,0.05);
  #assert h[0].enemies[0].moving && h[0].enemies[0].x<4 && h[0].hits==0;
  rs_drop_effect(b,1,0);
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_RESTRAINED,by=0,spell=-1,until=60,save=-1});
  xc_sync_permissions(s[..]);
  #assert h[0].enemies[0].held && !h[0].enemies[0].inactive && h[0].enemies[0].swing<0;
  rs_drop_effect(b,1,0); xc_sync_permissions(s[..]);
  #assert !h[0].enemies[0].held && !h[0].enemies[0].inactive;
}

#test "experimental combat: physical contact uses shared class AC, defenses, temporary HP and the saved player turn" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=20; b[0].c[0].hp_max=30; b[0].c[0].temp=10;
  h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[0].kind=xdungeon.DG_KIND_IMP;
  b[0].c[1].turn_at=0;
  xc_sync_vitals(s[..]);
  #assert h[0].shared && hostile.hc_offer(h[0].contacts[..],0);
  kept := b[0].turn; seat := s[0].xc[0].seat[0].turn;
  xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==20 && b[0].c[0].temp==6 && h[0].hp==20 && h[0].temp==6;
  #assert h[0].contacts[0].count==0 && h[0].hits==1;
  #assert b[0].turn.action==kept.action && s[0].xc[0].seat[0].turn.action==seat.action;
  // A second contact before the actor's next turn cannot obtain another Action.
  rolls := b[0].dice[0].rolled;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].dice[0].rolled==rolls && h[0].hits==1;
  b[0].clock=1.5; b[0].c[0].temp=0; b[0].c[0].resist=1<<RS_SLASHING;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==18 && h[0].hp==18 && h[0].hits==2;
  b[0].clock=3; b[0].c[0].ac=30; rolls=b[0].dice[0].rolled;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==18 && b[0].dice[0].rolled==rolls+1 && h[0].hits==2;
  #assert !rs_stat_attack_valid(xc_hostile_attack(-1)) && !rs_stat_attack_valid(xc_hostile_attack(5));
  b[0].clock=4.5; b[0].c[0].ac=10; b[0].c[0].immune=1<<RS_SLASHING;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==18 && h[0].hits==3;
}

#test "experimental combat: accepted and refused casts preserve actual HP and temporary HP rather than synthetic healing" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].c[0].hp=3; b[0].c[0].temp=7; xc_sync_vitals(s[..]);
  h[0].enemies[0].x=0; h[0].enemies[0].z=4; s[0].creator[0].clock=2;
  #assert xc_press(s[..],0);
  #assert b[0].c[0].hp==3 && b[0].c[0].temp==7 && h[0].hp==3 && h[0].temp==7;
  #assert !xc_press(s[..],0) && b[0].c[0].hp==3 && b[0].c[0].temp==7;
}

#test "experimental combat: quiet NPC turns repeat their saves without physical contact" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; b[0].dice[0].fixed=true;
  b[0].c[1].turn_at=0; b[0].c[1].round_at=0; b[0].c[1].score[RS_WIS]=30;
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_PARALYZED,by=0,spell=-1,until=60,save=RS_WIS,dc=13});
  xc_hostile_contacts(s[..]); #assert rs_has(b[0].c[1],RS_PARALYZED);
  b[0].clock=1.5; xc_hostile_contacts(s[..]); xc_sync_permissions(s[..]);
  #assert !rs_has(b[0].c[1],RS_PARALYZED) && !s[0].creator[0].hostiles[0].enemies[0].held;
}

#test "experimental combat: healing caps at class HP and False Life never becomes ordinary healing" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_DRUID,0);
  x := s[0].xc[..]; b := x[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].hp=29; b[0].c[0].hp_max=30; b[0].c[0].temp=7;
  x[0].bar[0]=fb_spell(SP_CURE_WOUNDS,1,FB_SELF); x[0].bar_n=1; s[0].creator[0].clock=2;
  xc_sync_vitals(s[..]); #assert xc_press(s[..],0);
  #assert b[0].c[0].hp==30 && b[0].c[0].temp==7 && h[0].hp==30 && h[0].max_hp==30 && h[0].temp==7;
  xc_set_class(x,FB_CL_WIZARD); #assert rs_grant_spell(b[0].c[0..<1],SP_FALSE_LIFE);
  b[0].c[0].hp=3; b[0].c[0].hp_max=30; b[0].c[0].temp=2;
  x[0].bar[0]=fb_spell(SP_FALSE_LIFE,1,FB_SELF); x[0].bar_n=1; s[0].creator[0].clock=4;
  #assert xc_press(s[..],0);
  #assert b[0].c[0].hp==3 && b[0].c[0].temp==8 && h[0].hp==3 && h[0].temp==8;
}

#test "experimental combat: the real frame binds contact-only physics before the first hostile tick" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  for i: 1..<XC_FOES { h[0].enemies[i].dead=true; }
  h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[0].swing=0.34;
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=20; b[0].c[0].hp_max=30; b[0].c[0].temp=10;
  b[0].c[0].turn_at=0; b[0].c[1].turn_at=0;
  before := h[0].dice[0].state;
  u: [104] f32; out: [1] f32;
  _ := lab_frame(s[..],out[..],u[..],1280,720,1,0.05,false);
  #assert h[0].shared && h[0].contacts[0].count==0 && h[0].dice[0].state==before;
  #assert b[0].c[0].hp==20 && b[0].c[0].temp==6 && h[0].hp==20 && h[0].temp==6;
}

#test "experimental combat: simultaneous shared hits stop each striker even when temporary HP absorb them" {
  s: [1] Lab; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].temp=20;
  b[0].c[1].turn_at=0; b[0].c[2].turn_at=0;
  h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[1].x=1; h[0].enemies[1].z=0;
  #assert hostile.hc_offer(h[0].contacts[..],0) && hostile.hc_offer(h[0].contacts[..],1);
  xc_hostile_contacts(s[..]);
  #assert h[0].hits==2 && react.react_held(s[0].xc[0].stops,1,0) && react.react_held(s[0].xc[0].stops,2,0);
}

#test "experimental combat: refused press restores spent budgets while explicit unlimited casting preserves reactions" {
  s:[1] Lab; xc_test_lab(s[..],FB_CL_CLERIC,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; b[0].c[0].hp=1;
  b[0].c[0].slots[1]=0; b[0].c[0].reacted=true; b[0].c[0].speech_blocked=true;
  x[0].seat[0].open=true; x[0].seat[0].turn.bonus=true; x[0].seat[0].turn.slot_spent=true;
  #assert !xc_use_on(s[..],2,-2);
  #assert b[0].c[0].slots[1]==0 && x[0].seat[0].turn.bonus && x[0].seat[0].turn.slot_spent;
  b[0].c[0].speech_blocked=false;
  #assert xc_use_on(s[..],2,-2) && b[0].c[0].hp>1 && b[0].c[0].reacted;
  #assert b[0].c[0].slots[1]==b[0].c[0].slots_max[1]-1;
}
