#load "fivelab.coax";
#load "../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for klass:0..<FB_CL_N { for level:1..<7 {
    s:[1]Lab; xc_test_lab(s[..],klass,0); xc_set_level(s[0].xc[..],level);
    b:=s[0].xc[0].b[..]; c:=b[0].c[0..<1];
    body:=EgBody.{ground=true}; lab_rest_motion(s[..],body,body,false,false);
    c[0].hp=1; c[0].temp=4; c[0].reacted=true;
    for sl:1..<10 { c[0].slots[sl]=0; }
    if !xc_rest_request(s[..],RS_REST_SLEEP) || !rs_sleeping(c[0]) || lab_move_scale(s[..])!=0 { return 1; }
    // Exercise actual controls plus the shared scheduler without rendering
    // eight hours of world/AI frames. The frame clock has its own receipt.
    rs_tick(b,28800); xc_sync_vitals(s[..]);
    if !c[0].long_rest.completed || c[0].long_rest.finished!=28800000000 || c[0].hp!=c[0].hp_max || c[0].temp!=0 || !c[0].reacted { return 2; }
    if rs_sleeping(c[0]) || c[0].rest.dice!=level || s[0].creator[0].hostiles[0].hp!=c[0].hp { return 3; }
    if xc_rest_request(s[..],RS_REST_SLEEP) || !s[0].xc[0].rest_refused { return 4; }
    if !xc_rest_request(s[..],RS_REST_END) || !c[0].long_rest.completed { return 5; }
  } }
  s:[1]Lab; xc_test_lab(s[..],FB_CL_FIGHTER,0); x:=s[0].xc[..]; b:=x[0].b[..];
  body:=EgBody.{ground=true}; lab_rest_motion(s[..],body,body,false,false);
  x[0].seen=true; x[0].k=1; x[0].top=20;
  r:=xc_rest_box(x,0);
  if !xc_pointer(s[..],r.x0+10,r.y0+10,0,1) || !xc_pointer(s[..],r.x0+10,r.y0+10,2,1) || b[0].c[0].rest.phase!=1 { return 6; }
  b[0].c[0].hp=1; rs_tick(b,3600);
  r=xc_rest_box(x,3);
  if !xc_pointer(s[..],r.x0+10,r.y0+10,0,1) || !xc_pointer(s[..],r.x0+10,r.y0+10,2,1) || b[0].c[0].hp<=1 || b[0].c[0].rest.dice!=0 { return 7; }
  if !xc_rest_request(s[..],RS_REST_END) || !xc_rest_request(s[..],RS_REST_WATCH) { return 8; }
  to:=body; to.z=1; lab_rest_motion(s[..],body,to,true,false); rs_tick(b,20);
  lab_rest_motion(s[..],to,to,true,false);
  if b[0].c[0].long_rest.mode!=2 || b[0].c[0].long_rest.exertion!=20000000 { return 9; }
  tool_errln("PASS EXPERIMENTAL-REST (72 class/level control/recovery flows, pointer Hit Dice and admitted-motion accounting)"); return 0;
}
