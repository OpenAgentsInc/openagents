// Everglade Experimental's riding (everglade/docs/mounts-spec.md): what is this zone's alone, in
// fivelab.coax's module. Riding itself is the game's: Everglade's mounts (everglade/mounts.coax: the
// horse, the red dragon, the rider's keys) standing in a zone (everglade/zone-mounts.coax: E, the
// saddle, the prompt). Here are only the Lab's keys handed to them, the yes played through this
// zone's sound and effects, the dragon's Fire Breath as the SRD battle resolves it, and the film
// stages. Your bow, your monsters' blows and the camera follow your body, so they need nothing here.

// E: mount the horse in reach or get off the one you ride. False (the key goes on) when neither.
// It asks with your SRD conditions (rs_bearing: knocked out, held or paralyzed, you stay put), and
// only a yes presents: its footfall and the dust at the stirrup (everglade/mounts.coax eg_mount_feel).
lab_mount_key :: (s: [] Lab) -> bool {
  cr := s[0].creator[..];
  k := cc.xh_key(cr, cr[0].clock, lab_bearing(s));
  if k.r == egm.EG_PRESS_MOUNTED || k.r == egm.EG_PRESS_DISMOUNTED { _ := xc_bow_cancel(s); }
  if k.show {
    w := cr[0].mounts[0].show; x := cr[0].player_x; z := cr[0].player_z;
    xc_cue(s, w.sound, 0.5, x, z, 1);
    fx_start_at(s, w.fx, cr[0].clock, fxp_v(x, meadow_y(x, z), z), fxp_v(x, meadow_y(x, z), z), fxp_v(0.6, 0.55, 0.45), 0.6, 0.6);
  }
  return k.r != egm.EG_PRESS_NONE;
}
// Your bearing from your SRD conditions (aethyr/rules/srd/condition-bearing.coax); none before the
// rules have you.
lab_bearing :: (s: [] Lab) -> DeedBearing {
  b := s[0].xc[0].b[..];
  if b[0].n <= 0 || b[0].c.count == 0 { return DeedBearing.{}; }
  return rs_bearing(b[0].c[0]);
}
lab_riding :: (s: [] Lab) -> bool { return s[0].creator[0].experimental && s[0].creator[0].mounts[0].riding >= 0; }
// While you ride, the step the walker proposed is set aside: the mount steps on your keys or stick
// (everglade/mounts.coax eg_ride_input, through everglade/zone-mounts.coax xh_ride_keys), and your
// body goes where the saddle carries it, on the ground.
lab_ride_body :: (s: [] Lab, origin: EgBody, proposed: EgBody) -> EgBody {
  cr := s[0].creator[..]; h := s[0].held;
  keys := egm.EgRideKeys.{forward = axis(h, HOLD_W, HOLD_S), turn = axis(h, HOLD_D, HOLD_A), shift = s[0].shift, space = (h & HOLD_JUMP) != 0,
    stick_on = s[0].stick_on, stick_x = s[0].stick_px, stick_y = s[0].stick_py};
  // the horse-archer stage canters: a gallop's stick pushed part way
  at := cc.xh_ride_keys(cr, keys, ifx s[0].ride_dev == LAB_STAGE_HORSE_ARCHER then f32(LAB_ARCHER_CANTER) else 1.0f32, cr[0].clock);
  lab_breath_stream(s);
  b := origin;
  b.x = at[0]; b.z = at[1];
  b.px = b.x; b.pz = b.z; b.py = 0; b.vx = 0; b.vz = 0; b.y = 0; b.vy = 0; b.ground = true; b.air = false; b.show_vx = 0; b.show_vz = 0;
  return b;
}
// Your feet's height over the ground while you ride (the figure, the bow's launch and the camera all
// read it from your body): the saddle less your pelvis.
lab_ride_lift :: (s: [] Lab) -> f32 { if !lab_riding(s) { return 0; } return cc.xh_lift(s[0].creator[..], s[0].creator[0].clock); }
// The red dragon you ride as a creature of the battle, on your side: the SRD Adult Red Dragon, its
// turns kept by its own seat (experimental-combat.coax xc_hostile_contacts steps it), so its breath
// recharges on the SRD's 5-6 and what it sets alight burns. Its index, or -1 when there's no room.
lab_dragon_join :: (s: [] Lab) -> int {
  x := s[0].xc[..]; b := x[0].b[..];
  i := x[0].dragon_seat[0].me;
  if i > 0 && i < b[0].n && rs_breather(b[0].c[i]) && b[0].c[i].team == b[0].c[0].team { return i; }
  i = rs_add(b, rs_monster(MON_ADULT_RED_DRAGON, "Red Dragon", b[0].c[0].team), XC_MID, XC_MID + 1);
  if i < 0 { return -1; }
  x[0].dragon_seat[0] = FbSeat.{me = i};
  return i;
}
// F (or the bar's Fire Breath) on the dragon: its breath ahead, on the ground or in the air. You ask
// with your bearing (everglade/mounts.coax eg_breath_ask); the SRD's 60-foot cone
// (aethyr/rules/srd/dragon-actions.coax rs_in_cone3) runs from its jaws along its heading, tipped
// down as far as you look down (in the air, down to the ground), and picks the monsters in it; the
// SRD's breath acts on them on the dragon's own turn (rs_fire_breath_on: Dex save DC 21, 17d6 fire,
// half on a success, Burning on a failure). Only a yes shows the torrent and its roar; each monster
// it reaches flinches, cries out or falls (xc_harmed), the ones that failed burn, and the grass under
// the cone catches. False when you aren't on the dragon (the key goes on).
LAB_BREATH_DOWN :: 0.35;   // how far (the aim's down part) the cone tips down on the ground at most; in the air, 0.9
// The cone's aim: along the dragon's heading, tipped down by dn (the aim's down part), at most as far
// as LAB_BREATH_DOWN on the ground and 0.9 in the air.
lab_breath_aim :: (s: [] Lab, dn0: f32) -> [3] f32 {
  m := s[0].creator[0].mounts[0]; k := m.mounts[m.riding]; dn := dn0;
  lo_y := ifx egm.eg_aloft(m) then -0.9f32 else -f32(LAB_BREATH_DOWN);
  if dn < lo_y { dn = lo_y; } if dn > 0.2 { dn = 0.2; }
  h := sqrt(1 - dn * dn);
  return [3] f32.[sin(k.face) * h, dn, cos(k.face) * h];
}
// How far down you look: the camera's view's down part.
lab_look_down :: (s: [] Lab) -> f32 {
  x := s[0].xc[0]; fy := x.u[21]; fl := sqrt(x.u[20] * x.u[20] + fy * fy + x.u[22] * x.u[22]);
  return ifx fl > 0.0001 then fy / fl else 0;
}
lab_breath_key :: (s: [] Lab) -> bool { return lab_breath_down(s, lab_look_down(s)); }
// The breath tipped down by dn (a stage aims it at what it films).
lab_breath_down :: (s: [] Lab, dn: f32) -> bool {
  cr := s[0].creator[..]; m := cr[0].mounts[..]; x := s[0].xc[..];
  if !cr[0].experimental || !egm.eg_on_dragon(m[0]) || !x[0].started { return false; }
  now := cr[0].clock;
  seq := egm.eg_breath_ask(m, now, lab_bearing(s)); if seq == 0 { return true; }
  i := lab_dragon_join(s);
  if i < 0 { egm.eg_breath_answer(m, seq, false, now); return true; }
  b := x[0].b[..]; h := cr[0].hostiles[..];
  jaws := egm.eg_dragon_mouth(m[0], m[0].riding);
  f := lab_breath_aim(s, dn); s[0].breath_dn = f[1];
  picks: [XC_FOES] int; before: [XC_FOES] int; n := 0;
  for g: 0..<XC_FOES {
    e := h[0].enemies[g]; before[g] = rs_max(b[0].c[1 + g].hp, 0); if e.dead { continue; }
    ft := 1.0f32 / 0.3048;
    dx := (e.x - jaws[0]) * ft; dy := (meadow_y(e.x, e.z) + 0.9 * e.scale - jaws[1]) * ft; dz := (e.z - jaws[2]) * ft;
    if rs_in_cone3(dx, dy, dz, f[0], f[1], f[2], f32(RS_BREATH_FT)) { picks[n] = 1 + g; n += 1; }
  }
  fb_seat_in(b, x[0].dragon_seat[..]); r := rs_fire_breath_on(b, i, picks[0..<n]); fb_seat_out(b, x[0].dragon_seat[..]);
  egm.eg_breath_answer(m, seq, r >= 0, now);
  if r < 0 { return true; }
  w := m[0].show; far := f32(egm.EG_BREATH_M);
  xc_cue(s, w.sound, 0.9, jaws[0], jaws[2], 0.8);
  xc_cue(s, "rage-roar", 0.6, jaws[0], jaws[2], 0.6);   // the dragon's roar under the flames
  to := fxp_v(jaws[0] + f[0] * far, jaws[1] + f[1] * far, jaws[2] + f[2] * far);
  fx_start_at(s, w.fx, now, fxp_v(jaws[0], jaws[1], jaws[2]), to, fxp_v(1, 0.5, 0.1), 2.2, far); s[0].breath_puff_at = now;
  // the grass catches where the cone meets the ground: flames along its floor and the ground left black, wider the farther out
  for q: 1..<7 {
    d := far * f32(q) / 6; px := jaws[0] + f[0] * d; pz := jaws[2] + f[2] * d; gy := meadow_y(px, pz);
    if jaws[1] + f[1] * d - gy > d * 0.5 + 0.5 { continue; }
    fx_start_at(s, FXR_BURNING, now + 0.15 * f32(q), fxp_v(px, gy, pz), fxp_v(px, gy, pz), fxp_v(1, 0.5, 0.1), 0.8 + d * 0.06, 1);
    fx_start_at(s, FXR_SCORCH, now + 0.15 * f32(q), fxp_v(px, gy, pz), fxp_v(px, gy, pz), fxp_v(0.1, 0.08, 0.06), 1, 1.5 + d * 0.3);
  }
  // each monster in it: the number, the flinch, the cry or the fall; the ones that failed burn
  for j: 0..<n {
    g := picks[j] - 1; e := h[0].enemies[g];
    _ := xc_harmed(s, g, before[g], react.DMG_FIRE, "fire-hit", 1, now);
    if b[0].c[1 + g].burning > 0 || b[0].c[1 + g].dead { fx_start_at(s, FXR_BURNING, now + 0.2, fxp_v(e.x, meadow_y(e.x, e.z), e.z), fxp_v(e.x, meadow_y(e.x, e.z), e.z), fxp_v(1, 0.5, 0.1), e.scale, 1); }
  }
  xc_sync_permissions(s);
  return true;
}
// The breath pours from the jaws as the dragon flies on (its rules acted once, at the word): its
// torrents stay fixed to the jaws and the tilt it was aimed at, and a second torrent follows the first
// LAB_BREATH_AGAIN seconds on, so the fire lasts about a second and a half. Every frame while you ride.
LAB_BREATH_AGAIN :: 0.55;
lab_breath_stream :: (s: [] Lab) {
  m := s[0].creator[0].mounts[0]; now := s[0].creator[0].clock; b := m.breath_at;
  if !egm.eg_on_dragon(m) || now - b > f32(LAB_BREATH_AGAIN) + 2 { return; }
  jaws := egm.eg_dragon_mouth(m, m.riding); f := lab_breath_aim(s, s[0].breath_dn); far := f32(egm.EG_BREATH_M);
  from := fxp_v(jaws[0], jaws[1], jaws[2]); to := fxp_v(jaws[0] + f[0] * far, jaws[1] + f[1] * far, jaws[2] + f[2] * far);
  if now - b >= f32(LAB_BREATH_AGAIN) && s[0].breath_puff_at < b + f32(LAB_BREATH_AGAIN) * 0.5 {
    fx_start_at(s, FXR_DRAGON_BREATH, now, from, to, fxp_v(1, 0.5, 0.1), 2.2, far); s[0].breath_puff_at = now;
  }
  p := s[0].puffs[..];
  for k: 0..<p[0].live.count {
    c := p[0].live[k];
    if p[0].on[k] && c.recipe == FXR_DRAGON_BREATH && c.t0 >= b - 0.001 { p[0].live[k].from = from; p[0].live[k].to = to; }
  }
}
// The dragon's Fire Breath on the bar while you ride it, after your own slots: there as you mount it,
// gone as you get off. Every frame.
lab_breath_slot :: (s: [] Lab) {
  x := s[0].xc[..]; if !x[0].started { return; }
  want := s[0].creator[0].experimental && egm.eg_on_dragon(s[0].creator[0].mounts[0]);
  k := xc_slot_of(x, XC_BREATH);
  if want && k < 0 && x[0].bar_n < x[0].bar.count { x[0].bar[x[0].bar_n] = fb_feature(XC_BREATH, "Fire Breath", "fireball"); x[0].bar[x[0].bar_n].tg = FB_POINT; x[0].bar_n += 1; }
  if !want && k >= 0 {
    for i: k..<x[0].bar_n - 1 { x[0].bar[i] = x[0].bar[i + 1]; }
    x[0].bar_n -= 1; x[0].used = -1; x[0].hover = -1; x[0].fizzle = -1;
  }
}
// The breath's slot's sweep, 0 to 1: 0 ready; spent, the share of a round left to the dragon's next
// Recharge roll (on a 5 or 6 it is back), so it sweeps once a round until it comes back.
lab_breath_wait :: (s: [] Lab) -> f32 {
  x := s[0].xc[0]; i := x.dragon_seat[0].me;
  if i <= 0 || i >= x.b[0].n || !x.b[0].c[i].breath_spent { return 0; }
  left := (x.b[0].c[i].round_at - x.b[0].clock) / f32(RS_ROUND);
  return ifx left > 1 then 1.0f32 else ifx left < 0.04 then 0.04f32 else left;
}
// X on the dragon in the air: it comes down to land (Space again flies on). False otherwise.
lab_land_key :: (s: [] Lab) -> bool { return egm.eg_ride_land(s[0].creator[0].mounts[..]); }
// A local page's ?ride= (lab_dev_cell), for looking at riding headless: 1 puts you in the saddle, 2
// gallops (W and Shift held), 3 draws the bow in the saddle (a Ranger: add ?class=). Once.
// The stages (?stage=dragonback, ?stage=horseback, ?stage=dragon-fire, ?stage=horse-archer;
// LAB_STAGE_*) ride on every frame: lab_ride_stage.
LAB_STAGE_DRAGONBACK :: 4; LAB_STAGE_HORSEBACK :: 5; LAB_STAGE_DRAGONFIRE :: 6; LAB_STAGE_HORSE_ARCHER :: 7;
lab_ride_dev :: (s: [] Lab) {
  d := s[0].ride_dev; cr := s[0].creator[..];
  if d <= 0 || !cr[0].experimental || cr[0].mounts[0].n == 0 { return; }
  if cr[0].mounts[0].riding < 0 {
    k := ifx d == LAB_STAGE_DRAGONBACK || d == LAB_STAGE_DRAGONFIRE then cc.xh_dragon(cr) else 0; if k < 0 { return; }
    if d == LAB_STAGE_HORSE_ARCHER { xc_set_class(s[0].xc[..], FB_CL_RANGER); lab_archer_place(s); }
    h := cr[0].mounts[0].mounts[k]; side := egm.eg_tune(cr[0].mounts[0], k).radius + 1.2;
    cr[0].player_x = h.x + cos(h.face) * side; cr[0].player_z = h.z - sin(h.face) * side;
    if d == LAB_STAGE_DRAGONFIRE { lab_fire_stage_set(s, k); h = cr[0].mounts[0].mounts[k]; }
    _ := lab_mount_key(s); cr[0].yaw = h.face + 3.1415927; s[0].stage_at = cr[0].clock; return;
  }
  if cc.xh_rider(cr, cr[0].clock).seated < 1 { return; }
  if d >= LAB_STAGE_DRAGONBACK { lab_ride_stage(s, d); return; }
  if d == 2 { s[0].held = HOLD_W; s[0].shift = true; }
  if d == 3 { _ := xc_bow_begin(s, false); }
  s[0].ride_dev = 0;
}
// The dragon-fire stage's field: open meadow north of the dungeon, west of spawn, where a band of
// gremlins stands; the dragon turns to face it before it takes off.
LAB_FIRE_FIELD_X :: -39.0; LAB_FIRE_FIELD_Z :: -23.0;
LAB_FIRE_HIGH :: 13.0;   // m over the ground it climbs to first
LAB_FIRE_LOW :: 5.5;     // m over the ground it swoops down to
LAB_FIRE_BREATH_M :: 15.0;   // m short of the band it breathes
LAB_FIRE_WAIT :: 2.0;       // seconds it stands before it takes off
lab_fire_stage_set :: (s: [] Lab, k: int) {
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..];
  d := cr[0].mounts[0].mounts[k..<k + 1];
  d[0].face = atan2(f32(LAB_FIRE_FIELD_X) - d[0].x, f32(LAB_FIRE_FIELD_Z) - d[0].z);
  // the band: every gremlin in a loose knot round the field's middle, standing its ground
  n := 0;
  for g: 0..<XC_FOES {
    if hostile.hostile_kind(g) != xdungeon.DG_KIND_GREMLIN || n >= 7 { continue; }
    a := f32(n) * 2.39996; r := ifx n == 0 then 0.0f32 else 2.2 + 0.9 * f32(n % 3);
    e := h[0].enemies[g..<g + 1];
    e[0].x = f32(LAB_FIRE_FIELD_X) + cos(a) * r; e[0].z = f32(LAB_FIRE_FIELD_Z) + sin(a) * r;
    e[0].home_x = e[0].x; e[0].home_z = e[0].z; e[0].face_x = -sin(d[0].face); e[0].face_z = -cos(d[0].face);
    e[0].moving = false; e[0].awake = false; e[0].dead = false;
    x[0].calm[g] = true; n += 1;
  }
}
// A stage's rider, every frame once seated: the keys a player would hold and a camera that follows.
// dragonback: up off the meadow over the trees by spawn, on over the village and above the castle's
// towers, then circling left over the village and castle. horseback: a gallop down the meadow past the autumn
// trees, the camera off the horse's shoulder. dragon-fire: up off the meadow toward the band of
// gremlins, a swoop down low over them, Fire Breath across them, and a climb away.
LAB_STAGE_ALT :: 32.0;   // m over the ground the dragonback stage holds: above the castle's towers
lab_ride_stage :: (s: [] Lab, d: int) {
  cr := s[0].creator[..]; m := cr[0].mounts[0]; h := m.mounts[m.riding]; t := cr[0].clock - s[0].stage_at;
  side: f32 = 0;
  if d == LAB_STAGE_DRAGONFIRE {
    alt := h.wing.y - meadow_y(h.x, h.z);
    fx := f32(LAB_FIRE_FIELD_X) - h.x; fz := f32(LAB_FIRE_FIELD_Z) - h.z; far := sqrt(fx * fx + fz * fz);
    ahead := fx * sin(h.face) + fz * cos(h.face);   // the band ahead (> 0) or passed (< 0)
    breathed := s[0].xc[0].dragon_seat[0].me > 0;
    held := 0; dive := false; side = 0.5;
    if t < f32(LAB_FIRE_WAIT) { cr[0].pitch = 0.2; }   // it stands a moment, its rider in the saddle
    else if !breathed && ahead > 0 {
      // up off the meadow, unhurried (W held in beats), then down low as it nears them
      if far > 40 { held = ifx t - 0.5 * floor(t / 0.5) < 0.32 then HOLD_W else 0; if alt < f32(LAB_FIRE_HIGH) { held |= HOLD_JUMP; } }
      else { held = HOLD_W; if alt > f32(LAB_FIRE_LOW) { dive = true; } else if alt < f32(LAB_FIRE_LOW) - 1.5 { held |= HOLD_JUMP; } }
      // the swoop seen from ahead and to the side: the dragon comes on, the band burns in the foreground
      cr[0].pitch = ifx far > 60 then 0.25f32 else 0.3f32; side = ifx far > 60 then 0.5f32 else 2.5f32;
      if ahead < f32(LAB_FIRE_BREATH_M) && (alt < f32(LAB_FIRE_LOW) + 2.5 || ahead < 7) {
        // down at the band's middle, chest high, from the jaws
        j := egm.eg_dragon_mouth(m, m.riding); gy := meadow_y(f32(LAB_FIRE_FIELD_X), f32(LAB_FIRE_FIELD_Z)) + 0.9;
        dx := f32(LAB_FIRE_FIELD_X) - j[0]; dz := f32(LAB_FIRE_FIELD_Z) - j[2]; dy := gy - j[1];
        _ := lab_breath_down(s, dy / sqrt(dx * dx + dy * dy + dz * dz));
      }
    } else {
      // on past them, low, then hard round to the left, back over the burned ground (the meadow ends not far past them)
      if s[0].ride_fire_at <= 0 { s[0].ride_fire_at = t; }
      after := t - s[0].ride_fire_at;
      held = HOLD_W; if alt < f32(LAB_FIRE_LOW) + 3 { held |= HOLD_JUMP; }
      if after > 0.8 && (after < 3.6 || t - 0.5 * floor(t / 0.5) < 0.25) { held |= HOLD_A; }
      cr[0].pitch = ifx after < 2.0 then 0.3f32 else 0.4f32; side = ifx after < 2.0 then 2.5f32 else 0.7f32;
    }
    s[0].held = held; s[0].shift = dive;
  } else if d == LAB_STAGE_DRAGONBACK {
    alt := h.wing.y - meadow_y(h.x, h.z);
    held := HOLD_W; if alt < f32(LAB_STAGE_ALT) { held |= HOLD_JUMP; }
    // round to the left over the village and castle: A in short presses, a wide circle about 35 m across
    if t > 2.5 && t - 0.6 * floor(t / 0.6) < 0.2 { held |= HOLD_A; }
    s[0].held = held; s[0].shift = false; cr[0].pitch = 0.3; side = 0.8;
  } else if d == LAB_STAGE_HORSE_ARCHER {
    if lab_archer_stage(s, t) { return; }
  } else {
    s[0].held = HOLD_W; s[0].shift = true; cr[0].pitch = 0.1; side = 0.7;
  }
  // to look at the seat: &view=side puts the camera square off the rider's left, &view=rear right behind, both close and low
  if s[0].ride_view == 1 { side = -1.5707964; } if s[0].ride_view == 2 { side = 0; }
  if s[0].ride_view > 0 { cr[0].pitch = 0.05; cr[0].dist = 2.2; }
  // the camera eases round behind (and a little off the shoulder of) the way it goes
  want := h.face + 3.1415927 + side; dy := want - cr[0].yaw;
  while dy > 3.1415927 { dy -= 6.2831853; } while dy < -3.1415927 { dy += 6.2831853; }
  cr[0].yaw += dy * 0.06;
}
// horse-archer: a Ranger canters across the meadow at two gremlins standing ahead of the horse,
// reins in short of them, and shoots the first (the SRD Longbow attack, a draw and a loose each Attack)
// until an arrow hits; then the camera cuts from behind the rider's right shoulder (the bow's own aiming
// view) to beside the horse, which trots on a few strides.
LAB_ARCHER_CANTER :: 0.6;      // of the gallop's speed: 8.4 m/s
LAB_ARCHER_FOES :: [2] int.[3, 4];   // the village's gremlins (verse/experimental-hostiles.coax hostile_kind)
LAB_ARCHER_AHEAD :: [2] f32.[58, 68];   // metres ahead of the horse, and to its right (- left)
LAB_ARCHER_ACROSS :: [2] f32.[-2.5, 3.5];
LAB_ARCHER_SHOOT_M :: 42.0;    // the draw begins this close: inside the Longbow's 150 feet
LAB_ARCHER_HOLD_S :: 0.9;      // seconds from the draw's start to the loose (BOW_FULL 0.8 is a full draw)
LAB_ARCHER_NOCK_S :: 0.4;      // seconds from a loose to the next draw
LAB_ARCHER_STAND_M :: 10.0;    // the rider reins in this close to the gremlin
LAB_ARCHER_REIN_S :: 0.8;      // seconds of slowing to a stand
LAB_ARCHER_SHOOT_S :: 11.0;    // seconds after mounting the shooting ends, the gremlin down or not
LAB_ARCHER_CUT_S :: 1.8;       // seconds after the hit the camera cuts to the side
LAB_ARCHER_ON_S :: 3.5;        // seconds the horse trots on beside the camera before it stands
LAB_ARCHER_LOOK :: 0.5;        // radians the close shot may turn from the horse's way toward its gremlin
// The stage's horse 24 m out along the way the horseback stage gallops from spawn, past the houses,
// facing the open meadow south-west of the village; its gremlins ahead of it, facing it.
LAB_ARCHER_HORSE :: [3] f32.[-16, -7.3, -2.16];
lab_archer_place :: (s: [] Lab) {
  cr := s[0].creator[..]; m := cr[0].mounts[..];
  m[0].mounts[0].x = LAB_ARCHER_HORSE[0]; m[0].mounts[0].z = LAB_ARCHER_HORSE[1]; m[0].mounts[0].face = LAB_ARCHER_HORSE[2];
  h := m[0].mounts[0]; e := cr[0].hostiles[0].enemies[..];
  fx := sin(h.face); fz := cos(h.face);
  for j: 0..<2 {
    i := LAB_ARCHER_FOES[j]; a := LAB_ARCHER_AHEAD[j]; c := LAB_ARCHER_ACROSS[j];
    x := h.x + fx * a - fz * c; z := h.z + fz * a + fx * c;
    e[i].x = x; e[i].z = z; e[i].home_x = x; e[i].home_z = z; e[i].face_x = -fx; e[i].face_z = -fz;
    s[0].xc[0].calm[i] = true;   // unaware, they stand their ground until an arrow finds them (a wound ends it: xc_use_ab)
  }
}
// A frame of the horse-archer stage (t seconds since the rider sat). True when it set the camera itself.
lab_archer_stage :: (s: [] Lab, t: f32) -> bool {
  cr := s[0].creator[..]; h := cr[0].mounts[0].mounts[cr[0].mounts[0].riding]; x := s[0].xc[..]; now := cr[0].clock; e := cr[0].hostiles[0].enemies[..];
  g := LAB_ARCHER_FOES[0];
  // the shooting ends when an arrow hits it (or time runs out); a moment later the side shot
  if s[0].stage_hit <= 0 && (x[0].bow_hits > 0 || e[g].dead || t > f32(LAB_ARCHER_SHOOT_S)) { s[0].stage_hit = now; }
  shooting := s[0].stage_hit <= 0;
  dx := e[g].x - cr[0].player_x; dz := e[g].z - cr[0].player_z; d := sqrt(dx * dx + dz * dz);
  // a canter in, a stand short of it to shoot, and after the hit a short trot on
  if s[0].stage_rein <= 0 && d < f32(LAB_ARCHER_STAND_M) { s[0].stage_rein = now; }
  stand := shooting && s[0].stage_rein > 0 && now - s[0].stage_rein > f32(LAB_ARCHER_REIN_S);
  if !shooting { a := now - s[0].stage_hit; stand = a < f32(LAB_ARCHER_CUT_S) || a > f32(LAB_ARCHER_CUT_S) + f32(LAB_ARCHER_ON_S); }   // it watches the gremlin fall, then trots on a little
  s[0].held = ifx stand then 0 else HOLD_W; s[0].shift = s[0].stage_rein <= 0;
  if shooting && d < f32(LAB_ARCHER_SHOOT_M) {
    ey := meadow_y(e[g].x, e[g].z) + 0.85 * e[g].scale;
    if !x[0].ar[0].draw[0].on && now - cr[0].loose_at > f32(LAB_ARCHER_NOCK_S) { _ := xc_bow_begin(s, false); }
    if x[0].ar[0].draw[0].on && now - x[0].ar[0].draw[0].at > f32(LAB_ARCHER_HOLD_S) {
      // the crosshair on its chest, from the rider's eyes
      eye := [3] f32.[cr[0].player_x, meadow_y(cr[0].player_x, cr[0].player_z) + cr[0].player_y + 1.6, cr[0].player_z];
      v := [3] f32.[e[g].x - eye[0], ey - eye[1], e[g].z - eye[2]]; l := sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
      for k: 0..<3 { x[0].u[16 + k] = eye[k]; x[0].u[20 + k] = v[k] / l; }
      _ := xc_bow_loose(s);
    }
  } else if x[0].ar[0].draw[0].on { _ := xc_bow_cancel(s); }
  if !shooting && now - s[0].stage_hit > f32(LAB_ARCHER_CUT_S) {
    // beside the horse as it trots on
    cr[0].pitch = 0.04; cr[0].dist = 4.2;
    want := h.face + 3.1415927 - 1.5707964; dy := want - cr[0].yaw;
    while dy > 3.1415927 { dy -= 6.2831853; } while dy < -3.1415927 { dy += 6.2831853; }
    cr[0].yaw += ifx now - s[0].stage_hit < f32(LAB_ARCHER_CUT_S) + 0.05 then dy else dy * 0.2;   // a cut, then it tracks
    return true;
  }
  // behind the right shoulder, looking past the rider at the gremlin (never more than LAB_ARCHER_LOOK off the horse's way)
  cr[0].pitch = 0.12; cr[0].dist = 2.4;
  off := atan2(dx, dz) - h.face;
  while off > 3.1415927 { off -= 6.2831853; } while off < -3.1415927 { off += 6.2831853; }
  if off > f32(LAB_ARCHER_LOOK) { off = f32(LAB_ARCHER_LOOK); } if off < -f32(LAB_ARCHER_LOOK) { off = -f32(LAB_ARCHER_LOOK); }
  want := h.face + off + 3.1415927 + 0.45; dy := want - cr[0].yaw;
  while dy > 3.1415927 { dy -= 6.2831853; } while dy < -3.1415927 { dy += 6.2831853; }
  cr[0].yaw += dy * 0.2;
  return true;
}
// The phone's button and the mount's keys under the bar are the game's (everglade/zone-mounts.coax
// xh_button_press, xh_prompt_draw): this zone says whether a finger has touched the page.
lab_ride_pointer :: (s: [] Lab, x: f32, y: f32, phase: int) -> bool {
  if !cc.xh_button_press(s[0].creator[0], x, y, phase, s[0].touch) { return false; }
  return lab_mount_key(s);
}
lab_ride_prompt :: (s: [] Lab, out: [] f32, at: int, w: f32, h: f32, k: f32) -> int { return cc.xh_prompt_draw(s[0].creator[0], out, at, w, h, k, s[0].touch); }

#test "E mounts the white horse only in reach and E gets you off; you ride on the ground, lifted to the saddle (mounts)" #steps 400000000 {
  s: [1]Lab; s[0].creator[0].experimental = true; s[0].creator[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { s[0].creator[0].mounts[0].count[i] = 3; } s[0].creator[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  cc.xh_place(s[0].creator[..]); h := s[0].creator[0].mounts[0].mounts[0];
  s[0].creator[0].player_x = 0; s[0].creator[0].player_z = 0; #assert !lab_mount_key(s[..]) && !lab_riding(s[..]);
  s[0].creator[0].player_x = h.x + 1.8; s[0].creator[0].player_z = h.z; #assert lab_mount_key(s[..]) && lab_riding(s[..]);
  #assert s[0].creator[0].mounts[0].shows == 1 && fxp_live(s[0].puffs[..]) > 0;
  b := EgBody.{x = h.x + 1.8, z = h.z, ground = true};
  for k: 0..<60 { s[0].creator[0].clock = f32(k) / 60; b = lab_keep_body(s[..], b, b); }
  #assert b.ground && b.y == 0 && abs(b.x - h.x) < 0.5 && lab_ride_lift(s[..]) > 0.4;
  // W and Shift: a gallop, far quicker than your 7.5 m/s run on foot
  s[0].held = HOLD_W; s[0].shift = true;
  for k: 60..<300 { s[0].creator[0].clock = f32(k) / 60; b = lab_keep_body(s[..], b, b); }
  x0 := b.x; z0 := b.z;
  for k: 300..<360 { s[0].creator[0].clock = f32(k) / 60; b = lab_keep_body(s[..], b, b); }
  #assert sqrt((b.x - x0) * (b.x - x0) + (b.z - z0) * (b.z - z0)) > 12;
  s[0].held = 0; s[0].shift = false;
  for k: 360..<480 { s[0].creator[0].clock = f32(k) / 60; b = lab_keep_body(s[..], b, b); }
  s[0].creator[0].player_x = b.x; s[0].creator[0].player_z = b.z;
  #assert lab_mount_key(s[..]);
  for k: 480..<540 { s[0].creator[0].clock = f32(k) / 60; b = lab_keep_body(s[..], b, b); }
  #assert !lab_riding(s[..]) && lab_ride_lift(s[..]) == 0;
  left := s[0].creator[0].mounts[0].mounts[0]; dx := b.x - left.x; dz := b.z - left.z; #assert dx * dx + dz * dz > 0.8 && dx * dx + dz * dz < 1.3;
}
#test "a Longbow shot from the saddle leaves from the rider's hand and the SRD attack lands (mounts)" #steps 900000000 {
  s: [1]Lab; xc_test_bow(s[..], [3] f32.[0, -0.04, 1]);
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..]; b := x[0].b[..];
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  _ := egm.eg_mount_add(cr[0].mounts[..], cr[0].player_x + 1.6, cr[0].player_z, 0);
  #assert lab_mount_key(s[..]);
  body := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true};
  for k: 0..<60 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  lab_you(s[..], body.x, 0, body.z, 0, false, false, false, 0, 0, 0, 0);
  r := cc.xh_rider(cr, cr[0].clock); #assert r.on && r.seated == 1;
  g := 3; h[0].enemies[g].x = body.x; h[0].enemies[g].z = body.z + 20; b[0].c[1 + g].ac = 1; b[0].c[1 + g].hp = 40; b[0].c[1 + g].hp_max = 40;
  // the camera behind and over the rider, as the riding camera sits
  x[0].u[16] = body.x; x[0].u[17] = r.y + 0.6; x[0].u[18] = body.z - 4; x[0].u[21] = -0.05;
  #assert xc_bow_begin(s[..], false); xc_test_fly(s[..], 1.0); #assert xc_bow_point(s[..]).foe == g;
  #assert xc_bow_loose(s[..]) && x[0].ar[0].shots == 1;
  a := x[0].ar[0].arrows[0].a[0];
  // the hand: chest high over the saddle (your pelvis in it), beside the rider, not at a walker's height
  hand := r.y + f32(XC_BOW_HAND) - cc.xh_hip(cr);
  #assert abs(a.from[1] - hand) < 0.05 && a.from[1] > meadow_y(body.x, body.z) + 1.45 + 0.4;
  #assert abs(a.from[0] - r.x) < 0.6 && abs(a.from[2] - r.z) < 0.6;
  xc_test_fly(s[..], 1.0);
  #assert x[0].bow_hits == 1 && b[0].c[1 + g].hp < 40;
}
#test "riding, a monster's blow still lands on you (mounts)" #steps 400000000 {
  s: [1]Lab; s[0].creator[0].experimental = true; hs := s[0].creator[0].hostiles[..]; hostile.hostile_test_start(hs);
  for i: 0..<egm.EG_HORSE_FRAMES { s[0].creator[0].mounts[0].count[i] = 3; } s[0].creator[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  _ := egm.eg_mount_add(s[0].creator[0].mounts[..], 1.6, 0, 0);
  s[0].creator[0].player_x = 0; s[0].creator[0].player_z = 0; #assert lab_mount_key(s[..]);
  hp := hs[0].hp; for i: 0..<600 { hostile.hostile_tick(hs, 1.6, 0.6, -0.27, 0.016); }
  #assert hs[0].hp < hp;
}
#test "on the dragon: Space takes off and climbs, X brings it down, E in the air says Land first (mounts)" #steps 900000000 {
  s: [1]Lab; cr := s[0].creator[..]; cr[0].experimental = true; cr[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  cc.xh_place(cr); k := cc.xh_dragon(cr); d := cr[0].mounts[0].mounts[k];
  cr[0].player_x = d.x + cos(d.face) * 3.5; cr[0].player_z = d.z - sin(d.face) * 3.5;
  #assert lab_mount_key(s[..]) && egm.eg_on_dragon(cr[0].mounts[0]);
  b := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true}; f := 0;
  for j: 0..<60 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  s[0].held = HOLD_W | HOLD_JUMP;
  for j: 0..<240 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  #assert egm.eg_aloft(cr[0].mounts[0]) && lab_ride_lift(s[..]) > 15;
  cr[0].player_x = b.x; cr[0].player_z = b.z;
  #assert lab_mount_key(s[..]) && egm.eg_on_dragon(cr[0].mounts[0]);
  #assert egm.eg_mount_prompt(cr[0].mounts[0], b.x, b.z, cr[0].clock, false) == "Land first";
  s[0].held = 0; #assert lab_land_key(s[..]) && cr[0].mounts[0].land;
  for j: 0..<1200 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  #assert !egm.eg_aloft(cr[0].mounts[0]) && !lab_land_key(s[..]);
  cr[0].clock += 3; cr[0].player_x = b.x; cr[0].player_z = b.z;
  #assert lab_mount_key(s[..]);
  for j: 0..<60 { cr[0].clock += 1.0 / 60; b = lab_keep_body(s[..], b, b); }
  #assert !lab_riding(s[..]);
}
// Counts the footstep packets in the frame's sound lines.
lab_test_steps :: (s: [] Lab) -> int {
  a := s[0].experimental_audio[..]; t := cast(string) a[0].lines[0..<a[0].n]; n := 0;
  for i: 0..<t.count - 4 { if t[i..<i + 5] == "step-" { n += 1; } }
  return n;
}
#test "five seconds of flight on the dragon play no footstep of yours; on foot your steps are heard (mounts)" #steps 2000000000 {
  s: [1]Lab; cr := s[0].creator[..]; cr[0].experimental = true; cr[0].on = true; cr[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  cc.xh_place(cr); k := cc.xh_dragon(cr); d := cr[0].mounts[0].mounts[k];
  // on foot: ten metres of walking are heard
  steps := 0; lab_sounds(s[..], 1.0 / 60, false);
  for j: 0..<120 { cr[0].player_x = f32(j) * 0.1; s[0].experimental_audio[0].n = 0; lab_sounds(s[..], 1.0 / 60, false); steps += lab_test_steps(s[..]); }
  #assert steps >= 5;
  // the dragon: mounted (the mount's own footfall is the deed's cue, not a step of yours), up, and five seconds of flight
  cr[0].player_x = d.x + cos(d.face) * 3.5; cr[0].player_z = d.z - sin(d.face) * 3.5;
  #assert lab_mount_key(s[..]) && egm.eg_on_dragon(cr[0].mounts[0]);
  b := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true}; f := 0;
  for j: 0..<60 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); cr[0].player_x = b.x; cr[0].player_z = b.z; lab_sounds(s[..], 1.0 / 60, false); }
  s[0].held = HOLD_W | HOLD_JUMP;
  for j: 0..<120 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); cr[0].player_x = b.x; cr[0].player_z = b.z; lab_sounds(s[..], 1.0 / 60, false); }
  #assert egm.eg_aloft(cr[0].mounts[0]);
  steps = 0; x0 := b.x; z0 := b.z;
  for j: 0..<300 {
    f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); cr[0].player_x = b.x; cr[0].player_z = b.z;
    s[0].experimental_audio[0].n = 0; lab_sounds(s[..], 1.0 / 60, false); steps += lab_test_steps(s[..]);
  }
  #assert egm.eg_aloft(cr[0].mounts[0]) && abs(b.x - x0) + abs(b.z - z0) > 20 && steps == 0;
}
#test "the dragonback stage mounts the dragon and rides it up over the treeline (mounts)" #steps 900000000 {
  s: [1]Lab; cr := s[0].creator[..]; cr[0].experimental = true; cr[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  cc.xh_place(cr); s[0].ride_dev = LAB_STAGE_DRAGONBACK;
  b := EgBody.{ground = true};
  for j: 0..<720 { cr[0].clock = f32(j) / 60; b = lab_keep_body(s[..], b, b); }
  k := cc.xh_dragon(cr); h := cr[0].mounts[0].mounts[k];
  #assert cr[0].mounts[0].riding == k && egm.eg_aloft(cr[0].mounts[0]) && h.wing.y - meadow_y(h.x, h.z) > 20;
}
#test "the horse-archer stage canters a Ranger at two calm gremlins, reins in short of the first and shoots it (mounts)" #steps 900000000 {
  s: [1]Lab; xc_test_bow(s[..], [3] f32.[0, 0, 1]);
  x := s[0].xc[..]; cr := s[0].creator[..]; e := cr[0].hostiles[0].enemies[..];
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  cc.xh_place(cr); s[0].ride_dev = LAB_STAGE_HORSE_ARCHER;
  b := EgBody.{ground = true}; t0 := cr[0].clock;
  cr[0].clock += 1.0 / 60; b = lab_keep_body(s[..], b, b);
  // placed: the horse at its mark, the gremlins ahead of it and standing down until an arrow finds them
  h := cr[0].mounts[0].mounts[0]; fx := sin(h.face); fz := cos(h.face);
  #assert abs(h.x - LAB_ARCHER_HORSE[0]) < 0.5 && abs(h.z - LAB_ARCHER_HORSE[1]) < 0.5;
  for j: 0..<2 { i := LAB_ARCHER_FOES[j]; ahead := (e[i].x - h.x) * fx + (e[i].z - h.z) * fz; #assert abs(ahead - LAB_ARCHER_AHEAD[j]) < 0.5 && x[0].calm[i]; }
  for k: 0..<600 { cr[0].clock = t0 + f32(k + 2) / 60; b = lab_keep_body(s[..], b, b); lab_you(s[..], b.x, 0, b.z, 0, false, false, false, 0, 0, 0, 0); }   // the frame's own step puts you where the body went
  g := LAB_ARCHER_FOES[0]; dx := e[g].x - cr[0].player_x; dz := e[g].z - cr[0].player_z;
  #assert cr[0].mounts[0].riding == 0;
  #assert s[0].stage_rein > 0 && sqrt(dx * dx + dz * dz) < f32(LAB_ARCHER_STAND_M);
  #assert x[0].ar[0].shots > 0;
}
#test "on the dragon, F breathes fire where you look: the SRD's breath burns the monster in the cone, then waits to recharge (mounts)" #steps 900000000 {
  s: [1]Lab; xc_test_bow(s[..], [3] f32.[0, -0.1, 1]);
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..]; b := x[0].b[..];
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  k := egm.eg_dragon_add(cr[0].mounts[..], cr[0].player_x - 3.5, cr[0].player_z, 0, meadow_y(cr[0].player_x - 3.5, cr[0].player_z));
  #assert !lab_breath_key(s[..]);   // on foot, F is not the dragon's
  #assert lab_mount_key(s[..]) && egm.eg_on_dragon(cr[0].mounts[0]);
  body := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true};
  for j: 0..<90 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  d := cr[0].mounts[0].mounts[k];
  // a monster 9 m ahead of its jaws, one well off to the side
  g := 3; h[0].enemies[g].x = d.x; h[0].enemies[g].z = d.z + 15; b[0].c[1 + g].hp = 300; b[0].c[1 + g].hp_max = 300;
  o := 1; h[0].enemies[o].x = d.x + 30; h[0].enemies[o].z = d.z + 2; hp_o := b[0].c[1 + o].hp;
  shows := cr[0].mounts[0].shows;
  #assert lab_breath_key(s[..]);
  i := x[0].dragon_seat[0].me;
  #assert i > XC_FOES && rs_breather(b[0].c[i]) && b[0].c[i].breath_spent && b[0].c[i].team == b[0].c[0].team;
  #assert b[0].c[1 + g].hp < 300 && b[0].c[1 + o].hp == hp_o;
  #assert cr[0].mounts[0].shows == shows + 1 && fxp_live(s[0].puffs[..]) > 0;
  // spent: F again asks, the rules say no, and nothing shows
  #assert lab_breath_key(s[..]) && cr[0].mounts[0].shows == shows + 1 && lab_dragon_join(s[..]) == i;
}
// Whether the mount's hint draws something on a page w by h at scale k, all of it outside the middle
// half of the view (where the horse and the dragon are) and on the page; true too when it draws nothing.
lab_hint_clear :: (s: [] Lab, w: f32, h: f32, k: f32) -> bool {
  out: [24000] f32; n := lab_ride_prompt(s, out[..], 0, w, h, k); vf := cc.VERTEX_FLOATS;
  for q: 0..<n {
    x := out[q * vf]; y := out[q * vf + 1];
    if x > w * 0.25 && x < w * 0.75 && y > h * 0.25 && y < h * 0.75 { return false; }
    if x < 0 || x > w || y < 0 || y > h { return false; }
  }
  return true;
}
lab_hint_clear_all :: (s: [] Lab) -> bool {
  return lab_hint_clear(s, 1920, 1080, 1) && lab_hint_clear(s, 1280, 720, 1) && lab_hint_clear(s, 2560, 1440, 2) && lab_hint_clear(s, 1170, 2532, 3);
}
#test "the mount's keys draw under the bar, never in the middle of the view: by the horse, riding it, on the dragon on the ground and in the air (mounts)" #steps 2000000000 {
  s: [1]Lab; cr := s[0].creator[..]; cr[0].experimental = true; cr[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  cc.xh_place(cr); h := cr[0].mounts[0].mounts[0];
  out: [24000] f32;
  // by the horse, then on it
  cr[0].player_x = h.x + 1.8; cr[0].player_z = h.z; #assert lab_ride_prompt(s[..], out[..], 0, 1920, 1080, 1) > 0 && lab_hint_clear_all(s[..]);
  #assert lab_mount_key(s[..]);
  b := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true}; f := 0;
  for j: 0..<60 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  #assert lab_ride_prompt(s[..], out[..], 0, 1920, 1080, 1) > 0 && lab_hint_clear_all(s[..]);
  cr[0].player_x = b.x; cr[0].player_z = b.z; #assert lab_mount_key(s[..]);
  for j: 0..<60 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  // the dragon: on the ground, in the air, and E in the air
  k := cc.xh_dragon(cr); d := cr[0].mounts[0].mounts[k];
  cr[0].player_x = d.x + cos(d.face) * 3.5; cr[0].player_z = d.z - sin(d.face) * 3.5; #assert lab_mount_key(s[..]);
  b = EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true};
  for j: 0..<90 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  #assert egm.eg_on_dragon(cr[0].mounts[0]);
  #assert egm.eg_mount_hint(cr[0].mounts[0], cr[0].player_x, cr[0].player_z, cr[0].clock).count > 0;
  #assert lab_ride_prompt(s[..], out[..], 0, 1920, 1080, 1) > 0;
  #assert lab_hint_clear_all(s[..]);
  s[0].held = HOLD_W | HOLD_JUMP;
  for j: 0..<240 { f += 1; cr[0].clock = f32(f) / 60; b = lab_keep_body(s[..], b, b); }
  #assert egm.eg_aloft(cr[0].mounts[0]) && lab_ride_prompt(s[..], out[..], 0, 1920, 1080, 1) > 0 && lab_hint_clear_all(s[..]);
  cr[0].player_x = b.x; cr[0].player_z = b.z; #assert lab_mount_key(s[..]) && lab_hint_clear_all(s[..]);
  s[0].touch = true; #assert lab_hint_clear_all(s[..]);
}
#test "the bar carries the dragon's Fire Breath while you ride it, and its slot sweeps until it recharges (mounts)" #steps 900000000 {
  s: [1]Lab; xc_test_bow(s[..], [3] f32.[0, -0.1, 1]);
  x := s[0].xc[..]; cr := s[0].creator[..];
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  _ := egm.eg_dragon_add(cr[0].mounts[..], cr[0].player_x - 3.5, cr[0].player_z, 0, meadow_y(cr[0].player_x - 3.5, cr[0].player_z));
  n0 := x[0].bar_n; lab_breath_slot(s[..]); #assert x[0].bar_n == n0 && xc_slot_of(x, XC_BREATH) < 0;
  #assert lab_mount_key(s[..]);
  body := EgBody.{x = cr[0].player_x, z = cr[0].player_z, ground = true};
  for j: 0..<90 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  k := xc_slot_of(x, XC_BREATH); #assert k == n0 && x[0].bar_n == n0 + 1 && lab_breath_wait(s[..]) == 0;
  // the slot breathes; spent, it sweeps
  #assert xc_press(s[..], k) && x[0].b[0].c[x[0].dragon_seat[0].me].breath_spent;
  w := lab_breath_wait(s[..]); #assert w > 0 && w <= 1;
  // a second torrent follows the first from the jaws
  for j: 0..<40 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  #assert s[0].breath_puff_at > cr[0].mounts[0].breath_at;
  // off the dragon, the slot goes
  for j: 0..<120 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  cr[0].player_x = body.x; cr[0].player_z = body.z; #assert lab_mount_key(s[..]);
  for j: 0..<60 { cr[0].clock += 1.0 / 60; body = lab_keep_body(s[..], body, body); }
  #assert xc_slot_of(x, XC_BREATH) < 0 && x[0].bar_n == n0;
}
#test "the dragon-fire stage swoops down low over the gremlins and burns them (mounts)" #steps 4000000000 {
  s: [1]Lab; cr := s[0].creator[..]; cr[0].experimental = true; hs := cr[0].hostiles[..]; hostile.hostile_start(hs); cr[0].hostiles[0].hp = 44;
  for i: 0..<egm.EG_HORSE_FRAMES { cr[0].mounts[0].count[i] = 3; } cr[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { cr[0].mounts[0].dcount[i] = 3; } cr[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  xc_start(s[0].xc[..], s[0].xc[0].klass);
  cc.xh_place(cr); s[0].ride_dev = LAB_STAGE_DRAGONFIRE;
  b := EgBody.{ground = true}; low: f32 = 100;
  for j: 0..<900 {
    cr[0].clock = f32(j) / 60; b = lab_keep_body(s[..], b, b);
    m := cr[0].mounts[0]; if m.riding >= 0 && egm.eg_aloft(m) && s[0].xc[0].dragon_seat[0].me <= 0 { h := m.mounts[m.riding]; a := h.wing.y - meadow_y(h.x, h.z); dx := h.x - f32(LAB_FIRE_FIELD_X); dz := h.z - f32(LAB_FIRE_FIELD_Z); if dx * dx + dz * dz < 30 * 30 && a < low { low = a; } }
  }
  dead := 0; for g: 0..<XC_FOES { if hostile.hostile_kind(g) == xdungeon.DG_KIND_GREMLIN && hs[0].enemies[g].dead { dead += 1; } }
  #assert s[0].xc[0].dragon_seat[0].me > 0;
  #assert low < 9;
  #assert dead >= 3;
}
