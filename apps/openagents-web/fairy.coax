// Fairy Forest, openagents.com/realms/fairy-forest: the first crack of the
// realm verse/fairy-forest/README.md proposes, in the painterly style
// (docs/verse/art-styles.md). You are a newly woken fairy in a valley that
// has faded to grey. Press E (BLOOM on a phone) at a faded patch of flowers
// and colour spreads out from it again. Three of the forest's creatures
// each have one trouble, that their glade has faded; bloom a glade's
// patches and its creature is happy (the glyph over its head says how it
// feels), and one of the heart tree's five roots wakes and glows.
// The creatures talk (ff-talk, verse/fairy-forest/talk.coax): E by one, or
// a click or tap on it, opens a talk pane; you type, and its answer comes
// from the character chat, which knows its trouble and remembers you.
//
// The layout, the fade and the troubles are verse/fairy-forest/forest.coax;
// the stream and the pond are verse/fairy-forest/stream.coax (verse/water.coax
// physics, drawn in the painted water preset). You walk and run on the
// engine's controller (verse/player.coax) and see the valley through the free
// orbit (verse/camera.coax); every Space press is one wing beat up, with no
// limit, holding it beats on and climbs, and letting go glides down (the face does the flight).
//
// The look (fairy.wgsl, verse/paint.coax): three soft toon bands with a warm
// rim, shadows tinted blue, blue-cyan haze that steps the ridges back, a
// painted sky with a sun and soft clouds, wind-swept grass instanced on the
// GPU, blob canopies, and a post pass with gentle bloom, a soft tone curve
// and lifted blacks. Everything is drawn from the engine's five shapes in
// code: a ground of cells (store 0), every object as a shape (store 1), the
// stream's nodes (store 2), the grass from a hash of its cell.
//
// This file is the page: the controls, the scene, the HUD. fairy-face.c binds
// it for the browser and runs the player and the stream between its calls.
//   coax/bin/coax test apps/openagents-web/fairy.coax --steps 400000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/camera.coax";
#load "../../verse/terrain.coax";
#load "../../verse/fairy-forest/forest.coax";
#load "../../verse/fairy-forest/talk.coax";
#load "place-orbit.coax";
#load "../../verse/edit/edit.coax";   // EDIT for its owner and admins (docs/verse/realm-edit.md)
#load "fairyroom.coax";
#load "fairyquest.coax";   // lore and quests from edit mode's panes
#load "../../verse/fairy-forest/life.coax";
#load "fairymaker.coax";   // make your fairy, and the mirror pool
#load "fairyhome.coax";    // your home, room by room
#load "fairygarden.coax";  // your garden, by real days
#load "fairyvillage.coax"; // creatures moving in
#load "fairycourse.coax";  // vine hoop courses, shared by link

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 24000;
PLATES :: 16;
// The uniforms (fairy.wgsl U).
U_VIEW :: 8; U_EYE :: 24; U_SUN :: 28; U_GROUND :: 32; U_GRASS :: 36; U_GRASS2 :: 40; U_SHADOW :: 44;
SHADOWS :: 16;
U_PATH :: U_SHADOW + SHADOWS * 4;
PATHS :: 32;
U_PATH_INFO :: U_PATH + PATHS * 4;
U_BLOOM :: U_PATH_INFO + 4;
U_BLOOM_INFO :: U_BLOOM + FF_BLOOMS * 4;
U_PLATE :: U_BLOOM_INFO + 4;
U_WATER :: U_PLATE + PLATES * 8;
WATER_FLOATS :: 324;
UNIFORM_FLOATS :: U_WATER + WATER_FLOATS;

CELLS :: FF_CELLS;
SHAPE_BOX :: 1; SHAPE_SPHERE :: 2; SHAPE_CYLINDER :: 3; SHAPE_CONE :: 4;
SHAPE_VERTICES :: [5] int.[6, 36, 960, 192, 96];
SLOTS :: [5] int.[0, 60, 1200, 560, 200];
SLOT_AT :: [5] int.[0, 0, 60, 1260, 1820];
OBJECTS :: 2020;
OBJECT_FLOATS :: 16;
// Looks (fairy.wgsl): how a surface takes the light and the fade.
LOOK_MATTE :: 0; LOOK_LEAVES :: 1; LOOK_STONE :: 2; LOOK_SKIN :: 3; LOOK_GLOW :: 4; LOOK_WING :: 5;
LOOK_CLOTH :: 6; LOOK_RIDGE :: 7; LOOK_BARK :: 8; LOOK_SPARK :: 9;   // her own light: glows, and the fade never dims it
MINE :: 128;   // added to a shape's code when it is hers: what is near the lens fades, but never she
// The draws: the ground and four shapes, the grass, then the water (last: the host draws it after the rest).
DRAWS :: 7;
GRASS_DRAW :: 5;
WATER_DRAW :: 6;
GRASS_BLADES :: 96;        // blades a 2 m patch draws on a computer (24 a square metre)
GRASS_BLADES_PHONE :: 32;  // and on a phone (8)
GRASS_PATCHES :: 32;       // patches a side on a computer: out to 32 m
GRASS_PATCHES_PHONE :: 18; // on a phone: out to 18 m

WALLS :: 500;
// Thornfall's fallen giant: a trunk lying east-west, its root plate at the west end.
LOG_X0 :: -8.0; LOG_X1 :: 7.0; LOG_Z :: 54.0; LOG_R :: 1.3;               // a trunk and a crown a tree, the heart tree's, its roots, the stones, the valley's edge
SPHERES :: 64;
BOXES :: 120;
TREES :: 190;              // x, z, height, canopy radius, hue
TREE_FLOATS :: 5;
RIDGES :: 30;
FERNS :: 70;               // x, z, yaw, size

HOLD_FORWARD :: 1; HOLD_BACK :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8; HOLD_RUN :: 16; HOLD_JUMP :: 32;
HOLD_TURN_LEFT :: 64; HOLD_TURN_RIGHT :: 128; HOLD_TILT_UP :: 256; HOLD_TILT_DOWN :: 512;
KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_BACKSPACE :: -3; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7; KEY_SHIFT :: -13;
LOOK_DRAG :: 0.0055;
WHEEL_ZOOM :: 0.006;
NEWS_TIME :: 4.5;
HEART_NEWS_TIME :: 9.0;
GOLDEN_TIME :: 2.0;
// Talking to a creature (verse/fairy-forest/talk.coax).
TALK_LINES :: 8;           // the talk kept for the next question
LINE_BYTES :: 300;
TYPED :: 200;
ASK_BYTES :: 8192;
ANSWER_WAIT :: 30.0;       // seconds before an unanswered question is given up
TAP_TALK_NEAR :: 22.0;
FLYING :: 0.6;             // metres over the ground: flying, so E and the BLOOM button wait until you land     // metres: a creature this near can be clicked or tapped to talk

// The HUD's colours: a cream ink and a soft gold.
CREAM_R :: 0.97; CREAM_G :: 0.94; CREAM_B :: 0.86;
GOLD_R :: 0.98; GOLD_G :: 0.82; GOLD_B :: 0.46;
GAP :: 0.5; SPACE :: 1.2;

Box :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

Fairy :: struct {
  started: bool;
  stream: [FF_LINE_N * 3] f32;   // the stream's middle as a line (ff_stream_line), made at the start
  time: f64;
  width: f32; height: f32; dpr: f32;
  touch: bool;
  golden: bool;
  orbit: Orbit;
  held: int;
  drag_on: bool; drag_id: int; drag_x: f32; drag_y: f32; drag_travel: f32;
  look_yaw: f32; look_pitch: f32;
  key_x: f32; key_y: f32; run: bool; jump: bool;
  use: bool;
  button: Box; button_finger: int; button_on: bool;
  // you, as the face last placed you: your feet on the ground, how high in the air, your wings
  feet: Point; face: f32; act: int; stride: f32; air: f32; flap: f32; flying: bool; water: int;
  forest: [1] Forest;
  // the scene
  heights: [FF_GROUND_POINTS] f32;
  objects: [OBJECTS * OBJECT_FLOATS] f32;
  counts: [5] int;
  draws: [DRAWS * 4] u32;
  walls: [WALLS * 6] f32; wall_n: int;
  spheres: [SPHERES * 4] f32; sphere_n: int;
  boxes: [BOXES * 6] f32; box_n: int;
  trees: [TREES * TREE_FLOATS] f32; tree_n: int;
  ferns: [FERNS * 4] f32; fern_n: int;
  shadow_n: int;
  plate_n: int;
  water_vertices: int; water_patches: int;
  pads: [7 * 8] f32; pad_n: int;
  near_creature: int;
  sparks: [18 * 4] f32; spark_next: int; spark_clock: f32;
  taps: int;   // Space presses not yet taken by the face: each is one wing beat
  mine: bool;  // shapes now laid out are her own: the near fade (fairy.wgsl) leaves them be
  // talking: a creature passing by, who you talk to (creature + 1, 0 none), what was said and what you type
  remark_creature: int; remark_turn: int; remark_heard: bool;   // its remark: the next each time you come by
  talk: int;
  line_npc: [TALK_LINES] bool; line_len: [TALK_LINES] int; line_text: [TALK_LINES * LINE_BYTES] u8; line_n: int;
  typed: [TYPED] u8; typed_n: int;
  ask: [ASK_BYTES] u8; ask_n: int;          // a question for the face to send
  waiting: bool; waited: f32;
  visit: [24] u8; visit_n: int;             // this visit's stamp: the page facts' now
  field: [4] f32;                           // where the typed line is drawn (x0, y0, x1, y1, device pixels)
  bye_button: Box; talk_button: Box; talk_finger: int; talk_finger_on: bool;
  pane_top: f32;                            // the talk pane's top edge, while you talk
  seen_x: [FF_CREATURES] f32; seen_y: [FF_CREATURES] f32; seen_r: [FF_CREATURES] f32; seen_on: [FF_CREATURES] bool;
  tap_creature: int; tap_finger: int;       // a finger put down on a creature (creature + 1, 0 none)
  // The shared edit layer: its board switches the sparkles, the grass and the ridges; SETTINGS has flight
  ed: [1] RealmEdit;
  ed_out: [256] u8; ed_out_n: int;
  // the others in the forest, the chat room and the inbox (fairyroom.coax)
  room: [1] RoomState;
  social: [1] Social;
  quest: [1] FfQuest;   // the quest you are on (fairyquest.coax)
  life: [1] Life;       // what you made your own (verse/fairy-forest/life.coax)
  maker: [1] Maker;     // making your fairy (fairymaker.coax)
  build: [1] Build;     // building in your home (fairyhome.coax)
  race: [1] Race;       // a course of hoops, made or opened by link (fairycourse.coax)
  now_min: f64;         // the wall clock, minutes since 1970 (the face's; 0 not yet)
  fig_on: bool; fig_at: Point; fig_up: f32; fig_across: f32;   // her body's size, while she is laid out
}

// ---- small things

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.55 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
hash1 :: (a: f32, b: f32) -> f32 { v := sin(a * 127.1 + b * 311.7) * 43758.5453; return v - floor(v); }

coaxial_fairy_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_fairy_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_fairy_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }
fairy_water_at :: () -> int #export_c { return U_WATER; }
fairy_eye_at :: () -> int #export_c { return U_EYE; }

ground :: () -> Ground {
  g: Ground; g.n = CELLS; g.cell = f32(FF_CELL); g.west = f32(FF_EDGE); g.south = f32(FF_EDGE);
  g.rim_from = 46; g.rim = 0.03;
  return g;
}
ground_at :: (s: [] Fairy, x: f32, z: f32) -> f32 { return verse_terrain_height(ground(), s[0].heights[..], x, z); }
fairy_ground :: (s: [] Fairy, x: f32, z: f32) -> f32 #export_c { return ground_at(s, x, z); }

fairy_start :: (s: [] Fairy) {
  s[0].build[0].carry = -1; s[0].build[0].picked = -1;
  ff_bloom_add(s[0].forest[..], f32(FFH_X), f32(FFH_Z), 15, -100);   // your home is never grey
  s[0].started = true;
  ff_stream_line(s[0].stream[..]);
  nodes := FF_NODE_XZ; links := FF_LINK_AB; flats := FF_FLATS;
  shaped_ok := verse_terrain_build(ground(), s[0].heights[..], nodes[..], links[..], f32(FF_PATH_HALF), flats[..]);
  carve(s);
  s[0].feet = v3(f32(FF_SPAWN_X), ground_at(s, f32(FF_SPAWN_X), f32(FF_SPAWN_Z)), f32(FF_SPAWN_Z));
  s[0].face = f32(FF_SPAWN_FACE);
  s[0].orbit = verse_orbit_start(s[0].feet, f32(FF_SPAWN_FACE));
  s[0].button_finger = -1;
  s[0].near_creature = -1;
  s[0].forest[0].news = -1;
  plant_trees(s);
  plant_ferns(s);
  build_scenery(s);
}

// The stream's bed and banks, cut into the built ground.
// (The line is made once. A point further than the widest half and the
// banks from every piece of it can't be carved, so each row measures only
// the pieces that come that close to it.)
carve :: (s: [] Fairy) {
  w := CELLS + 1;
  line := s[0].stream[..];
  wide := 0.0f32;
  for k: 0..<FF_LINE_N { wide = hi(wide, line[k * 3 + 1]); }
  reach := wide * 0.5 + 14;
  ks: [FF_LINE_N] int;
  for j: 0..<w {
    z := f32(FF_EDGE) + f32(j) * f32(FF_CELL);
    n := 0;
    for k: 1..<FF_LINE_N {
      az := line[k * 3 - 1]; bz := line[k * 3 + 2];
      if z >= lo(az, bz) - reach && z <= hi(az, bz) + reach { ks[n] = k; n += 1; }
    }
    if n == 0 { continue; }
    x0 := 1000000.0f32; x1 := -1000000.0f32;
    for m: 0..<n { k := ks[m]; x0 = lo(x0, lo(line[k * 3 - 3], line[k * 3])); x1 = hi(x1, hi(line[k * 3 - 3], line[k * 3])); }
    for i: 0..<w {
      x := f32(FF_EDGE) + f32(i) * f32(FF_CELL);
      if x < x0 - reach || x > x1 + reach { continue; }
      near_s := ff_stream_near_some(line, ks[0..<n], x, z);
      if near_s.d < near_s.half + 14 { s[0].heights[j * w + i] = ff_carve(s[0].heights[j * w + i], near_s); }
    }
  }
}

// The course for the stream library: x, z and width a control.
fairy_course :: (out: [] f32) -> int #export_c {
  n := FF_COURSE_N * 3;
  if out.count < n { return 0; }
  for i: 0..<n { out[i] = FF_COURSE[i]; }
  return n;
}
fairy_level :: () -> f32 #export_c { return f32(FF_LEVEL); }
fairy_pond_x :: () -> f32 #export_c { return f32(FF_POND_X); }
fairy_pond_z :: () -> f32 #export_c { return f32(FF_POND_Z); }

// Clear of the trails, the stream (line: s[0].stream), the glades, the heart tree and the creatures?
open_ground :: (line: [] f32, x: f32, z: f32, room: f32) -> bool {
  nodes := FF_NODE_XZ; links := FF_LINK_AB;
  if verse_path_nearest(nodes[..], links[..], x, z).d < f32(FF_PATH_HALF) + 2.5 + room { return false; }
  st := ff_stream_near_line(line, x, z);
  if st.d < st.half + 2.5 + room { return false; }
  if sqrt(x * x + z * z) < 17 + room { return false; }
  if ffh_near(x, z, f32(FFH_CLEAR) + room) { return false; }   // your home's clearing
  if x > f32(LOG_X0) - 4 - room && x < f32(LOG_X1) + 3 + room && abs(z - f32(LOG_Z)) < 3.5 + room { return false; }
  for g: 0..<FF_GLADES {
    dx := x - FF_GLADE[g * 3]; dz := z - FF_GLADE[g * 3 + 1];
    if sqrt(dx * dx + dz * dz) < FF_GLADE[g * 3 + 2] + room { return false; }
  }
  return true;
}

// The forest: a jittered grid, kept off the open ground; out to the rim's slopes.
plant_trees :: (s: [] Fairy) {
  n := 0;
  line := s[0].stream[..];
  step := 7.0f32;
  for a: 0..<22 {
    for b: 0..<22 {
      if n >= TREES { break; }
      x := -74 + f32(a) * step + (hash1(f32(a), f32(b)) - 0.5) * 4.5;
      z := -74 + f32(b) * step + (hash1(f32(b) + 7.3, f32(a)) - 0.5) * 4.5;
      if !open_ground(line, x, z, 1.5) { continue; }
      // the valley floor near the trails is lighter wood: skip some
      if sqrt(x * x + z * z) < 45 && hash1(x, z) < 0.35 { continue; }
      k := n * TREE_FLOATS;
      s[0].trees[k] = x; s[0].trees[k + 1] = z;
      s[0].trees[k + 2] = 2.6 + hash1(z, x) * 2.6;
      s[0].trees[k + 3] = 2.0 + hash1(x + 1, z) * 1.4;
      s[0].trees[k + 4] = hash1(x + 3, z + 5);
      n += 1;
    }
  }
  s[0].tree_n = n;
}

// Ferns round each glade's edge and by the trails near where you wake, off the trails and the water.
plant_ferns :: (s: [] Fairy) {
  n := 0;
  line := s[0].stream[..];
  nodes := FF_NODE_XZ; links := FF_LINK_AB;
  for g: 0..<FF_GLADES {
    for k: 0..<14 {
      if n >= FERNS { break; }
      a := f32(k) * 2.399 + f32(g);
      d := FF_GLADE[g * 3 + 2] * (0.75 + 0.5 * hash1(f32(k), f32(g) + 3));
      x := FF_GLADE[g * 3] + cos(a) * d; z := FF_GLADE[g * 3 + 1] + sin(a) * d;
      if verse_path_nearest(nodes[..], links[..], x, z).d < f32(FF_PATH_HALF) + 0.8 { continue; }
      st := ff_stream_near_line(line, x, z);
      if st.d < st.half + 1.5 { continue; }
      if ff_patch_near_xz(x, z, 1.8) { continue; }
      k4 := n * 4;
      s[0].ferns[k4] = x; s[0].ferns[k4 + 1] = z; s[0].ferns[k4 + 2] = a * 3; s[0].ferns[k4 + 3] = 0.7 + 0.5 * hash1(x, z);
      n += 1;
    }
  }
  s[0].fern_n = n;
}
ff_patch_near_xz :: (x: f32, z: f32, r: f32) -> bool {
  for i: 0..<FF_PATCHES {
    dx := x - FF_PATCH[i * 4]; dz := z - FF_PATCH[i * 4 + 1];
    if dx * dx + dz * dz < (r + 1.4) * (r + 1.4) { return true; }
  }
  return false;
}

// A fern: five fronds arching out from its heart, the nearest ones first while the spheres last.
ferns :: (s: [] Fairy, eye: Point) {
  t := effect_time(s);
  for f: 0..<s[0].fern_n {
    k := f * 4;
    x := s[0].ferns[k]; z := s[0].ferns[k + 1]; yaw := s[0].ferns[k + 2]; size := s[0].ferns[k + 3];
    dx := x - eye.x; dz := z - eye.z;
    if dx * dx + dz * dz > 1600 { continue; }
    if s[0].counts[SHAPE_SPHERE] > SLOTS[SHAPE_SPHERE] - 8 { return; }
    g := ground_at(s, x, z);
    for i: 0..<5 {
      a := yaw + f32(i) * 1.2566;
      sway := sin(t * 1.4 + f32(f) + f32(i)) * 0.05;
      out := v3(sin(a), 0, cos(a));
      c := add(v3(x, g + 0.32 * size, z), times(out, 0.42 * size));
      shade := 0.85 + 0.3 * hash1(f32(f), f32(i));
      shape(s, SHAPE_SPHERE, LOOK_LEAVES, c, a, 1.0 + sway, 0.2 * size, 0.95 * size, 0.04, 0.2 * shade, 0.5 * shade, 0.08 * shade);
    }
  }
}

put6 :: (out: [] f32, i: int, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) {
  k := i * 6;
  if k + 6 > out.count { return; }
  out[k] = a; out[k + 1] = b; out[k + 2] = c; out[k + 3] = d; out[k + 4] = e; out[k + 5] = f;
}

// The player's walls and the camera's scenery, from the layout.
// The player's walls are boxes over the ground where they stand (the
// player's floor is flat; heights here are over the ground there): a box
// whose top is under your feet is something to stand on.
//   - each tree: its trunk, and its crown, a box inside the blobs whose top
//     you land on, walk over and take off from;
//   - the heart tree: its trunk, its canopy (the middle blob and the eight
//     round it) and its five roots, three boxes along each;
//   - the stones round the heart tree, and the valley's edge.
build_scenery :: (s: [] Fairy) {
  w := 0; bx := 0;
  wl := s[0].walls[..];
  for t: 0..<s[0].tree_n {
    k := t * TREE_FLOATS;
    x := s[0].trees[k]; z := s[0].trees[k + 1]; h := s[0].trees[k + 2]; r := s[0].trees[k + 3];
    g := ground_at(s, x, z);
    if w < WALLS { put6(wl, w, x - 0.35, 0, z - 0.35, x + 0.35, h + r * 0.2, z + 0.35); w += 1; }
    c := r * 0.78;
    if w < WALLS { put6(wl, w, x - c, h + r * 0.2, z - c, x + c, h + r * 1.42, z + c); w += 1; }
    if sqrt(x * x + z * z) < 58 {
      if bx < BOXES { put6(s[0].boxes[..], bx, x - 0.3, g - 1, z - 0.3, x + 0.3, g + h, z + 0.3); bx += 1; }
    }
  }
  // the heart tree (heart(): its trunk to 14.5 m, the canopy's blobs, the roots), over the ground at its foot
  hg := ground_at(s, 0, 0);
  if w < WALLS { put6(wl, w, -2.1, 0, -2.1, 2.1, 15 - hg, 2.1); w += 1; }
  if bx < BOXES { put6(s[0].boxes[..], bx, -2.2, -1, -2.2, 2.2, 16, 2.2); bx += 1; }
  // (the blobs round the middle one stand no higher than it, so its top is one floor and they are ledges off it)
  mid := heart_blob(0);
  mid_top := mid.y + mid.w * 0.37;
  for k: 0..<9 {
    b := heart_blob(k);
    half := b.w * 0.36;
    top := lo(b.y + b.w * 0.37, mid_top);
    if w < WALLS { put6(wl, w, b.x - half, b.y - b.w * 0.28 - hg, b.z - half, b.x + half, top - hg, b.z + half); w += 1; }
  }
  for r: 0..<FF_ROOTS {
    tx := FF_ROOT[r * 3]; tz := FF_ROOT[r * 3 + 1];
    for i: 0..<3 {
      f := 0.32 + f32(i) * 0.22;
      x := tx * f; z := tz * f;
      top := 1.25 - f32(i) * 0.2;
      if w < WALLS { put6(wl, w, x - 0.45, 0, z - 0.45, x + 0.45, top, z + 0.45); w += 1; }
    }
  }
  for k: 0..<7 {
    p := heart_stone(s, k);
    if p.ok && w < WALLS { put6(wl, w, p.x - 0.55, 0, p.z - 0.45, p.x + 0.55, 0.6, p.z + 0.45); w += 1; }
  }
  // the fallen giant (a floor along its top) and the Old Ring's stones
  if w < WALLS { put6(wl, w, f32(LOG_X0) - 1, 0, f32(LOG_Z) - f32(LOG_R), f32(LOG_X1), f32(LOG_R) * 2 - 0.3, f32(LOG_Z) + f32(LOG_R)); w += 1; }
  for k: 0..<FF_RING_STONES {
    st := ff_ring_stone(k);
    if w < WALLS { put6(wl, w, st.x - 0.5, 0, st.z - 0.5, st.x + 0.5, 3.1, st.z + 0.5); w += 1; }
  }
  rc := v3(FF_GLADE[FF_OLD_RING * 3], 0, FF_GLADE[FF_OLD_RING * 3 + 1]);
  if w < WALLS { put6(wl, w, rc.x - 0.75, 0, rc.z - 0.75, rc.x + 0.75, 0.85, rc.z + 0.75); w += 1; }
  b := f32(FF_BOUND);
  if w + 4 <= WALLS {
    put6(wl, w, -b - 2, 0, -b - 2, b + 2, 80, -b); put6(wl, w + 1, -b - 2, 0, b, b + 2, 80, b + 2);
    put6(wl, w + 2, -b - 2, 0, -b, -b, 80, b); put6(wl, w + 3, b, 0, -b, b + 2, 80, b);
    w += 4;
  }
  s[0].wall_n = w; s[0].box_n = bx;
}

// The heart tree's canopy blob k: its centre (absolute) and size, as heart() draws it.
HeartBlob :: struct { x: f32; y: f32; z: f32; w: f32; }
heart_blob :: (k: int) -> HeartBlob {
  a := f32(k) * 2.399;
  rr := ifx k == 0 then 0.0f32 else 6.5f32 + hash1(f32(k), 1) * 2;
  y := 18 + hash1(f32(k), 3) * 4 - ifx k == 0 then 0.0f32 else 2.0f32;
  size := ifx k == 0 then 15.0f32 else 9.0f32 + hash1(f32(k), 7) * 3;
  return HeartBlob.{x = cos(a) * rr, y = y, z = sin(a) * rr, w = size};
}
// The stone k round the heart tree, as props() places it (ok false: none there).
Stone :: struct { ok: bool; x: f32; z: f32; a: f32; }
heart_stone :: (s: [] Fairy, k: int) -> Stone {
  a := f32(k) * 0.9 + 0.2;
  x := cos(a) * 15; z := sin(a) * 15;
  return Stone.{ok = !(!open_ground(s[0].stream[..], x, z, -3) && k % 2 == 0), x = x, z = z, a = a};
}

// The camera keeps out of the crowns near you and the heart tree's canopy:
// they are the orbit's spheres (absolute), rebuilt each frame.
camera_spheres :: (s: [] Fairy, feet: Point) {
  sp := 0;
  for k: 0..<9 {
    b := heart_blob(k);
    q := sp * 4; s[0].spheres[q] = b.x; s[0].spheres[q + 1] = b.y; s[0].spheres[q + 2] = b.z; s[0].spheres[q + 3] = b.w * 0.42; sp += 1;
  }
  for t: 0..<s[0].tree_n {
    if sp >= SPHERES { break; }
    k := t * TREE_FLOATS;
    x := s[0].trees[k]; z := s[0].trees[k + 1];
    dx := x - feet.x; dz := z - feet.z;
    if dx * dx + dz * dz > 22 * 22 { continue; }
    h := s[0].trees[k + 2]; r := s[0].trees[k + 3];
    q := sp * 4; s[0].spheres[q] = x; s[0].spheres[q + 1] = ground_at(s, x, z) + h + r * 0.55; s[0].spheres[q + 2] = z; s[0].spheres[q + 3] = r * 1.05; sp += 1;
  }
  s[0].sphere_n = sp;
}

fairy_walls :: (s: [] Fairy) -> int #export_c { if !s[0].started { fairy_start(s); } return s[0].wall_n; }
fairy_spawn :: (s: [] Fairy) -> Point #export_c { if !s[0].started { fairy_start(s); } return v3(f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z)); }
fairy_spawn_face :: () -> f32 #export_c { return f32(FF_SPAWN_FACE); }
fairy_heights :: (s: [] Fairy) -> int #export_c { if !s[0].started { fairy_start(s); } return FF_GROUND_POINTS; }

// ---- what you restored, kept so a reload brings it back (the face saves it, save.coax)
// What you restored, then what you made your own (verse/fairy-forest/life.coax's tail).
fairy_progress :: (s: [] Fairy, out: [] u8) -> int #export_c {
  n := ff_progress(s[0].forest[..], out);
  if n <= 0 { return n; }
  return n + ffl_save(s[0].life[..], out[n..<out.count]);
}
fairy_progress_open :: (s: [] Fairy, b: [] u8) -> bool #export_c {
  if !s[0].started { fairy_start(s); }
  if b.count < 2 { return false; }
  base := cast(int) b[0] + FF_ROOTS + 2;
  if base > b.count { return false; }
  if base < b.count && !ffl_open(s[0].life[..], b[base..<b.count]) { return false; }
  if !ff_progress_open(s[0].forest[..], b[0..<base], s[0].time) { return false; }
  ffm_loaded(s);
  return true;
}
fairy_progress_count :: (s: [] Fairy) -> int #export_c { return ff_progress_count(s[0].forest[..]) + s[0].life[0].changes; }
fairy_progress_bytes :: () -> int #export_c { return FF_PROGRESS_BYTES + FFL_BYTES; }
// The face: the save has had its chance to come; a first visit opens the maker.
fairy_life_ready :: (s: [] Fairy) #export_c { if !s[0].started { fairy_start(s); } ffm_ready(s); }

// ---- where you are, kept so a reload puts you back (place.coax, the face's place-face.h)

// Open ground: inside the valley's bound, out of the stream's water and clear of the trunks.
fairy_place_open :: (s: [] Fairy, x: f32, z: f32) -> bool #export_c {
  if !s[0].started { fairy_start(s); }
  b := f32(FF_BOUND) - 1;
  if !finite(x) || !finite(z) || x < -b || x > b || z < -b || z > b { return false; }
  if ground_at(s, x, z) < f32(FF_LEVEL) + 0.1 { return false; }
  return verse_place_clear(s[0].walls[..], s[0].wall_n, x, 0, z, 0.35);
}
// A kept place made good: itself when open, else the nearest open spot, else the spawn.
fairy_place_fix :: (s: [] Fairy, p: Place) -> Place #export_c {
  q := p; q.y = 0; q.room = -1;
  for i: 0..<PLACE_TRIES {
    t := verse_place_try(p.x, p.z, i);
    if fairy_place_open(s, t.x, t.z) { q.x = t.x; q.z = t.z; return q; }
  }
  q.x = f32(FF_SPAWN_X); q.z = f32(FF_SPAWN_Z); q.face = f32(FF_SPAWN_FACE); q.yaw = f32(FF_SPAWN_FACE);
  return q;
}
// The camera behind you at a kept place, as it was kept.
fairy_place_camera :: (s: [] Fairy, p: Place) #export_c {
  if !s[0].started { fairy_start(s); }
  s[0].feet = v3(p.x, ground_at(s, p.x, p.z), p.z); s[0].face = p.face;
  s[0].orbit = verse_place_orbit(p, s[0].feet);
}
fairy_place_of :: (s: [] Fairy, x: f32, y: f32, z: f32, face: f32) -> Place #export_c { return verse_place_of(x, y, z, face, s[0].orbit, -1); }

// ---- the controls

hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_FORWARD; }
  if key == 's' || key == 'S' { return HOLD_BACK; }
  if key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == KEY_SHIFT { return HOLD_RUN; }
  if key == ' ' { return HOLD_JUMP; }
  if key == KEY_LEFT { return HOLD_TURN_LEFT; }
  if key == KEY_RIGHT { return HOLD_TURN_RIGHT; }
  if key == KEY_UP { return HOLD_TILT_UP; }
  if key == KEY_DOWN { return HOLD_TILT_DOWN; }
  return 0;
}

fairy_key :: (s: [] Fairy, key: int, mods: int) -> bool #export_c {
  if !s[0].started { fairy_start(s); }
  if ffm_key(s, key) { return true; }
  if ffb_key(s, key) { return true; }
  used := redit_key(s[0].ed[..], key, true);
  if used > 0 { return used == 1; }
  if key == '+' || key == '=' { s[0].orbit = verse_orbit_zoom(s[0].orbit, -0.8); return true; }
  if key == '-' || key == '_' { s[0].orbit = verse_orbit_zoom(s[0].orbit, 0.8); return true; }
  if ffs_key(s, key, mods) { return true; }
  if s[0].talk > 0 { return talk_key(s, key, mods); }
  if ffc_key(s, key) { return true; }
  if key == KEY_ENTER { ffs_start_chat(s); return true; }
  if key == 'e' || key == 'E' { s[0].use = true; return true; }
  b := hold_bit(key);
  if b == 0 { return false; }
  if b == HOLD_JUMP && s[0].held & HOLD_JUMP == 0 { s[0].taps += 1; }
  s[0].held = s[0].held | b;
  return true;
}

fairy_key_up :: (s: [] Fairy, key: int, mods: int) -> bool #export_c {
  if redit_key(s[0].ed[..], key, false) == 1 { return true; }
  if redit_typing(s[0].ed[..]) { return false; }
  b := hold_bit(key);
  if b == 0 { return false; }
  if s[0].held & b != 0 { s[0].held = s[0].held - b; }
  return true;
}

fairy_blur :: (s: [] Fairy) #export_c { s[0].held = 0; s[0].drag_on = false; s[0].button_finger = -1; s[0].button_on = false; }

in_box :: (b: Box, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

// A mouse drag turns the camera and a click blooms; a finger on BLOOM presses
// it; any other finger is the face's (the sticks).
fairy_pointer :: (s: [] Fairy, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if !s[0].started { fairy_start(s); }
  if ffm_pointer(s, x, y, phase, id) { return true; }
  if ffb_pointer(s, x, y, phase, id) { return true; }
  if !s[0].maker[0].open && ffc_pointer(s, x, y, phase, id) { return true; }
  if s[0].maker[0].open && kind != 0 { s[0].touch = true; return false; }   // the sticks turn the camera round her
  if s[0].maker[0].open { return look_drag(s, x, y, phase, id); }
  if redit_pointer(s[0].ed[..], x, y, phase, id) { return true; }
  if kind != 0 { s[0].touch = true; }
  if ffs_pointer(s, x, y, phase, id) { return true; }
  if ffq_pointer(s, x, y, phase, id) { return true; }
  talking := s[0].talk > 0;
  if talking && talk_pointer(s, x, y, phase, id) { return true; }
  if kind != 0 {
    s[0].touch = true;
    if talking { return false; }
    if phase == 0 && in_box(s[0].button, x, y) { s[0].button_finger = id; s[0].button_on = true; return true; }
    // a finger on a creature talks to it when it lifts there
    if phase == 0 && creature_at(s, x, y) >= 0 { s[0].tap_creature = creature_at(s, x, y) + 1; s[0].tap_finger = id; return true; }
    if s[0].tap_creature > 0 && id == s[0].tap_finger {
      if phase == 2 && creature_at(s, x, y) == s[0].tap_creature - 1 { talk_to(s, s[0].tap_creature - 1); }
      if phase >= 2 { s[0].tap_creature = 0; }
      return true;
    }
    if id != s[0].button_finger { return false; }
    if phase == 1 { s[0].button_on = in_box(s[0].button, x, y); return true; }
    if phase == 2 && in_box(s[0].button, x, y) { s[0].use = true; }
    s[0].button_finger = -1; s[0].button_on = false;
    return true;
  }
  k := hi(s[0].dpr, 0.5);
  if phase == 0 { s[0].drag_on = true; s[0].drag_id = id; s[0].drag_x = x; s[0].drag_y = y; s[0].drag_travel = 0; return true; }
  if !s[0].drag_on || id != s[0].drag_id { return false; }
  if phase == 1 {
    s[0].look_yaw -= (x - s[0].drag_x) / k * f32(LOOK_DRAG);
    s[0].look_pitch -= (y - s[0].drag_y) / k * f32(LOOK_DRAG);
    s[0].drag_travel += (abs(x - s[0].drag_x) + abs(y - s[0].drag_y)) / k;
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  if phase == 2 && s[0].drag_travel < 6 && !talking {
    c := creature_at(s, x, y);
    if c >= 0 { talk_to(s, c); }
    else if s[0].button.x1 > s[0].button.x0 { s[0].use = true; }
  }
  s[0].drag_on = false;
  return true;
}

// A mouse drag that only turns the camera (while the maker is open).
look_drag :: (s: [] Fairy, x: f32, y: f32, phase: int, id: int) -> bool {
  k := hi(s[0].dpr, 0.5);
  if phase == 0 { s[0].drag_on = true; s[0].drag_id = id; s[0].drag_x = x; s[0].drag_y = y; s[0].drag_travel = 0; return true; }
  if !s[0].drag_on || id != s[0].drag_id { return false; }
  if phase == 1 {
    s[0].look_yaw -= (x - s[0].drag_x) / k * f32(LOOK_DRAG);
    s[0].look_pitch -= (y - s[0].drag_y) / k * f32(LOOK_DRAG);
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  s[0].drag_on = false;
  return true;
}

fairy_wheel :: (s: [] Fairy, dy: f32) #export_c {
  if finite(dy) { s[0].orbit = verse_orbit_zoom(s[0].orbit, clamp(dy, -400, 400) * f32(WHEEL_ZOOM)); }
}

axis :: (held: int, plus: int, minus: int) -> f32 {
  a := 0.0f32;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}

fairy_controls :: (s: [] Fairy, dt: f32, dyaw: f32, dpitch: f32) #export_c {
  if !s[0].started { fairy_start(s); }
  h := s[0].held;
  s[0].key_x = axis(h, HOLD_RIGHT, HOLD_LEFT);
  s[0].key_y = axis(h, HOLD_FORWARD, HOLD_BACK);
  s[0].run = h & HOLD_RUN != 0;
  s[0].jump = h & HOLD_JUMP != 0;
  o := verse_orbit_look(s[0].orbit, s[0].look_yaw + dyaw, s[0].look_pitch + dpitch);
  o = verse_orbit_keys(o, axis(h, HOLD_TURN_LEFT, HOLD_TURN_RIGHT), axis(h, HOLD_TILT_UP, HOLD_TILT_DOWN), dt);
  s[0].orbit = o;
  s[0].look_yaw = 0; s[0].look_pitch = 0;
}

fairy_player_theta :: (s: [] Fairy) -> f32 #export_c { return wrap_angle(s[0].orbit.yaw + f32(PI)); }
fairy_jump :: (s: [] Fairy) -> bool #export_c { return s[0].jump; }
// The Space presses since the face last asked, each one wing beat (kept, so a
// quick tap between two frames still beats), and none left after.
fairy_taps :: (s: [] Fairy) -> int #export_c { n := s[0].taps; s[0].taps = 0; return n; }
fairy_phone :: (s: [] Fairy) -> bool #export_c { return phone(s); }
// The edit layer's: may visitors fly (its SETTINGS),
// and its push to talk for the host (the kind, its outbox in ed_out).
fairy_may_fly :: (s: [] Fairy) -> bool #export_c { return redit_tool(s[0].ed[..], "fly"); }
fairy_edit_action :: (s: [] Fairy) -> int #export_c { a := redit_take_action(s[0].ed[..], s[0].ed_out[..]); s[0].ed_out_n = a.n; return a.kind; }

// ---- talking (ff-talk, verse/fairy-forest/talk.coax)

// The creature drawn under (x, y), near enough to talk to, or -1.
creature_at :: (s: [] Fairy, x: f32, y: f32) -> int {
  best := -1; bd := 1000000.0f32;
  for c: 0..<FF_CREATURES {
    if !s[0].seen_on[c] { continue; }
    dx := x - s[0].seen_x[c]; dy := y - s[0].seen_y[c];
    d := dx * dx + dy * dy;
    r := s[0].seen_r[c];
    if d < r * r && d < bd { bd = d; best = c; }
  }
  return best;
}

add_line :: (s: [] Fairy, npc: bool, text: string) {
  if s[0].line_n == TALK_LINES {
    for k: 1..<TALK_LINES {
      s[0].line_npc[k - 1] = s[0].line_npc[k]; s[0].line_len[k - 1] = s[0].line_len[k];
      for b: 0..<LINE_BYTES { s[0].line_text[(k - 1) * LINE_BYTES + b] = s[0].line_text[k * LINE_BYTES + b]; }
    }
    s[0].line_n -= 1;
  }
  k := s[0].line_n;
  n := 0;
  for i: 0..<text.count { if n < LINE_BYTES { s[0].line_text[k * LINE_BYTES + n] = text[i]; n += 1; } }
  s[0].line_npc[k] = npc; s[0].line_len[k] = n;
  s[0].line_n = k + 1;
}
line_of :: (s: [] Fairy, k: int) -> string { return cast(string) s[0].line_text[k * LINE_BYTES..<k * LINE_BYTES + s[0].line_len[k]]; }
typed_text :: (s: [] Fairy) -> string { return cast(string) s[0].typed[0..<s[0].typed_n]; }

// Talking to creature c: it starts with what is on its mind, its trouble or its thanks.
talk_to :: (s: [] Fairy, c: int) {
  if c < 0 || c >= FF_CREATURES { return; }
  s[0].talk = c + 1; s[0].line_n = 0; s[0].typed_n = 0; s[0].waiting = false; s[0].ask_n = 0;
  s[0].held = 0; s[0].use = false; s[0].taps = 0; s[0].talk_finger_on = false;
  s[0].social[0].typing = false; s[0].social[0].inbox_open = false; s[0].social[0].writing = false;
  add_line(s, true, ff_says(s[0].forest[..], c));
}
end_talk :: (s: [] Fairy) { s[0].talk = 0; s[0].typed_n = 0; s[0].waiting = false; s[0].ask_n = 0; s[0].talk_finger_on = false; }

// What you typed goes to the face as a question, with the talk so far.
send_typed :: (s: [] Fairy) {
  if s[0].talk <= 0 || s[0].waiting || s[0].typed_n == 0 { return; }
  lines: [TALK_LINES] FfLine;
  for k: 0..<s[0].line_n { lines[k] = FfLine.{npc = s[0].line_npc[k], text = line_of(s, k)}; }
  n := ff_ask_body(s[0].ask[..], s[0].forest[..], s[0].talk - 1, lines[0..<s[0].line_n], typed_text(s), cast(string) s[0].visit[0..<s[0].visit_n], redit_lore(s[0].ed[..], FF_CREATURE_KEYS[s[0].talk - 1]));
  if n == 0 { return; }
  s[0].ask_n = n;
  add_line(s, false, typed_text(s));
  s[0].typed_n = 0;
  s[0].waiting = true; s[0].waited = 0;
}

// A key while you talk: it types, Enter says it, Backspace takes a letter
// back, Esc ends the talk. Keys with Ctrl or Cmd are the browser's.
talk_key :: (s: [] Fairy, key: int, mods: int) -> bool {
  if key == KEY_ESCAPE { end_talk(s); return true; }
  if key == KEY_ENTER { send_typed(s); return true; }
  if key == KEY_BACKSPACE {
    n := s[0].typed_n;
    while n > 0 { n -= 1; if (s[0].typed[n] & 0xC0) != 0x80 { break; } }
    s[0].typed_n = n;
    return true;
  }
  if (mods & 10) != 0 { return false; }
  if key < 32 || key == 127 { return key >= 0; }
  c := key; n := s[0].typed_n;
  size := ifx c < 0x80 then 1 else ifx c < 0x800 then 2 else ifx c < 0x10000 then 3 else 4;
  if n + size > TYPED { return true; }
  if size == 1 { s[0].typed[n] = cast(u8) c; }
  if size == 2 { s[0].typed[n] = cast(u8) (0xC0 | (c >> 6)); s[0].typed[n + 1] = cast(u8) (0x80 | (c & 63)); }
  if size == 3 { s[0].typed[n] = cast(u8) (0xE0 | (c >> 12)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 2] = cast(u8) (0x80 | (c & 63)); }
  if size == 4 {
    s[0].typed[n] = cast(u8) (0xF0 | (c >> 18)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 12) & 63));
    s[0].typed[n + 2] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 3] = cast(u8) (0x80 | (c & 63));
  }
  s[0].typed_n = n + size;
  return true;
}

// While you talk: BYE, pressed and lifted on it, ends it; the pane takes the
// fingers and clicks on it (a tap there brings the phone's keyboard back).
talk_pointer :: (s: [] Fairy, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 && in_box(s[0].bye_button, x, y) { s[0].talk_finger = id; s[0].talk_finger_on = true; return true; }
  if s[0].talk_finger_on && id == s[0].talk_finger {
    if phase == 2 && in_box(s[0].bye_button, x, y) { end_talk(s); }
    if phase >= 2 { s[0].talk_finger_on = false; }
    return true;
  }
  return phase == 0 && s[0].pane_top > 0 && y >= s[0].pane_top;
}

// The face's side: the question to send (its bytes in ask), that it went,
// the answer ("STATUS\n" then the server's JSON), and the page facts.
fairy_ask :: (s: [] Fairy) -> int #export_c { return s[0].ask_n; }
fairy_ask_sent :: (s: [] Fairy) #export_c { s[0].ask_n = 0; }
fairy_answer :: (s: [] Fairy, reply: string) #export_c {
  if s[0].talk <= 0 || !s[0].waiting { return; }
  s[0].waiting = false;
  ok := reply.count > 4 && reply[0..<4] == "200\n";
  text: [LINE_BYTES] u8;
  n := ifx ok then ff_answer_text(reply[4..<reply.count], text[..]) else 0;
  if n > 0 { add_line(s, true, cast(string) text[0..<n]); return; }
  // no answer: what is on its mind, as a creature would say it again
  add_line(s, true, ff_says(s[0].forest[..], s[0].talk - 1));
}
// Text typed into the host's field or pasted (message 1): added to what you type while you talk.
fairy_typed :: (s: [] Fairy, text: string) #export_c {
  if ffs_typed(s, text) { return; }
  if s[0].talk <= 0 { return; }
  for i: 0..<text.count {
    c := text[i];
    if c == '\n' || c == '\r' { send_typed(s); continue; }
    if c < 32 || s[0].typed_n >= TYPED { continue; }
    s[0].typed[s[0].typed_n] = c; s[0].typed_n += 1;
  }
}
// The page facts (key=value lines): now= is this visit's stamp, so the
// server tells this visit's words from an earlier visit's.
fairy_facts :: (s: [] Fairy, facts: string) #export_c {
  ffc_facts(s, facts);
  i := 0;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    if e - i > 4 && facts[i..<i + 4] == "now=" {
      n := 0;
      for k: i + 4..<e { if n < 24 { s[0].visit[n] = facts[k]; n += 1; } }
      s[0].visit_n = n;
    }
    i = e + 1;
  }
}
// While you talk, the phone's keyboard comes up over the typed line, and you stand still.
fairy_wants_text :: (s: [] Fairy) -> bool #export_c { return s[0].talk > 0 || redit_typing(s[0].ed[..]) || ffs_typing(s); }
fairy_talking :: (s: [] Fairy) -> bool #export_c { return s[0].talk > 0; }
// Talking to a creature or typing a line or a message: you stand still, and no key is tracked.
fairy_still :: (s: [] Fairy) -> bool #export_c { return s[0].talk > 0 || ffs_typing(s) || s[0].maker[0].open; }

// ---- the scene

// A shape at centre, turned yaw about +Y then tilt about its own +X, sized
// sx, sy, sz (the shape is a unit: a cube, a sphere, a cylinder or a cone a metre across).
shape :: (s: [] Fairy, kind: int, look: int, centre: Point, yaw: f32, tilt: f32, sx: f32, sy: f32, sz: f32,
          red: f32, green: f32, blue: f32) {
  cy := cos(yaw); sy_ := sin(yaw); ct := cos(tilt); st := sin(tilt);
  c0 := v3(cy * sx, 0, -sy_ * sx);
  c1 := v3(sy_ * st * sy, ct * sy, cy * st * sy);
  c2 := v3(sy_ * ct * sz, -st * sz, cy * ct * sz);
  oriented(s, kind, look, centre, c0, c1, c2, red, green, blue);
}

// A shape whose long axis runs from a to b (a cylinder or a cone, its tip at b).
limb :: (s: [] Fairy, kind: int, look: int, a: Point, b: Point, width: f32, red: f32, green: f32, blue: f32) {
  d := sub(b, a);
  l := length(d);
  if !(l > 0.0001) { return; }
  yaw := yaw_of(d.x, d.z);
  tilt := atan2(flat_length(d), d.y);
  shape(s, kind, look, mix(a, b, 0.5), yaw, tilt, width, l, width, red, green, blue);
}

shadow :: (s: [] Fairy, u: [] f32, x: f32, z: f32, radius: f32, strength: f32) {
  n := s[0].shadow_n;
  if n >= SHADOWS { return; }
  k := U_SHADOW + n * 4;
  u[k] = x; u[k + 1] = z; u[k + 2] = radius; u[k + 3] = strength;
  s[0].shadow_n = n + 1;
}

effect_time :: (s: [] Fairy) -> f32 { return ifx s[0].golden then f32(GOLDEN_TIME) else f32(s[0].time); }

// The forest's trees: a warm trunk and a canopy of three clumps, rich mid-greens, one lighter and one darker.
trees :: (s: [] Fairy, u: [] f32, eye: Point) {
  for t: 0..<s[0].tree_n {
    k := t * TREE_FLOATS;
    x := s[0].trees[k]; z := s[0].trees[k + 1]; h := s[0].trees[k + 2]; r := s[0].trees[k + 3]; hue := s[0].trees[k + 4];
    g := ground_at(s, x, z);
    shape(s, SHAPE_CYLINDER, LOOK_BARK, v3(x, g + h * 0.5 - 0.3, z), 0, 0, 0.5, h + 0.6, 0.5, 0.44, 0.38, 0.24);
    // a flared foot of roots on the near trees, while the cones last
    dx0 := x - eye.x; dz0 := z - eye.z;
    if dx0 * dx0 + dz0 * dz0 < 1600 && s[0].counts[SHAPE_CONE] < SLOTS[SHAPE_CONE] - 24 {
      shape(s, SHAPE_CONE, LOOK_BARK, v3(x, g + 0.3, z), hue * 4, 0, 1.25, 1.0, 1.15, 0.4, 0.36, 0.22);
    }
    gr := 0.12 + hue * 0.12; gg := 0.42 + hue * 0.12; gb := 0.05 + hue * 0.03;
    if hue > 0.86 { gr = 0.62; gg = 0.5; gb = 0.1; }   // a few autumn-gold crowns
    shape(s, SHAPE_SPHERE, LOOK_LEAVES, v3(x, g + h + r * 0.55, z), hue * 6, 0, r * 2.2, r * 1.9, r * 2.2, gr, gg, gb);
    // far off, the one clump is enough (the haze has it)
    if dx0 * dx0 + dz0 * dz0 > 70 * 70 { continue; }
    shape(s, SHAPE_SPHERE, LOOK_LEAVES, v3(x + r * 0.55, g + h + r * 0.05, z - r * 0.35), 0, 0, r * 1.4, r * 1.2, r * 1.4, gr * 1.35, gg * 1.22, gb * 1.1);
    shape(s, SHAPE_SPHERE, LOOK_LEAVES, v3(x - r * 0.45, g + h + r * 0.15, z + r * 0.4), 0, 0, r * 1.3, r * 1.15, r * 1.3, gr * 0.7, gg * 0.78, gb * 1.2);
    dx := x - eye.x; dz := z - eye.z;
    if dx * dx + dz * dz < 900 { shadow(s, u, x, z, r * 1.4, 0.5); }
  }
}

// Ridges past the rim: broad soft hills stepping back into the haze, like painted flats.
ridges :: (s: [] Fairy) {
  for i: 0..<RIDGES {
    ring := i % 3;
    a := f32(i) * 2.399 + f32(ring) * 0.5;
    d := 105 + f32(ring) * 55 + hash1(f32(i), 2) * 20;
    w := 70 + f32(ring) * 40 + hash1(f32(i), 5) * 30;
    hgt := 28 + f32(ring) * 18 + hash1(f32(i), 9) * 20;
    shape(s, SHAPE_SPHERE, LOOK_RIDGE, v3(cos(a) * d, -hgt * 0.15, sin(a) * d), a, 0, w, hgt * 2, w * 0.8, 0.2, 0.42, 0.18);
  }
}

// The heart tree: a great trunk, its canopy, and its five roots, grey until they wake.
heart :: (s: [] Fairy, u: [] f32) {
  f := s[0].forest[..];
  t := effect_time(s);
  awake := ff_roots_awake(f);
  shape(s, SHAPE_CYLINDER, LOOK_BARK, v3(0, 7, 0), 0, 0, 4.2, 15, 4.2, 0.42, 0.3, 0.22);
  shape(s, SHAPE_CYLINDER, LOOK_BARK, v3(0, 0.6, 0), 0.4, 0, 6, 1.6, 6, 0.4, 0.29, 0.2);
  // the canopy: soft rose-and-teal blobs, the blossom brighter with each root awake
  bloom := f32(awake) / f32(FF_ROOTS);
  for k: 0..<9 {
    a := f32(k) * 2.399;
    b := heart_blob(k);
    size := b.w;
    rose := ifx k % 2 == 0 then 1.0f32 else 0.0f32;
    shape(s, SHAPE_SPHERE, LOOK_LEAVES, v3(b.x, b.y, b.z), a, 0, size, size * 0.8, size,
          lerp(0.3, 0.86, rose * (0.4 + 0.6 * bloom)), lerp(0.52, 0.52, rose), lerp(0.42, 0.66, rose * (0.4 + 0.6 * bloom)));
  }
  for r: 0..<FF_ROOTS {
    tip := v3(FF_ROOT[r * 3], 0, FF_ROOT[r * 3 + 1]);
    tip.y = ground_at(s, tip.x, tip.z) + 0.15;
    root := v3(tip.x * 0.22, 1.2, tip.z * 0.22);
    mid := v3(tip.x * 0.6, 0.9, tip.z * 0.6);
    on := f[0].awake[r];
    look := ifx on then LOOK_GLOW else LOOK_BARK;
    pulse := ifx on then 0.75f32 + 0.25f32 * sin(t * 2.2 + f32(r)) else 1.0f32;
    cr := ifx on then 1.0f32 * pulse else 0.4f32; cg := ifx on then 0.78f32 * pulse else 0.3f32; cb := ifx on then 0.42f32 * pulse else 0.22f32;
    limb(s, SHAPE_CYLINDER, look, root, mid, 1.1, cr, cg, cb);
    limb(s, SHAPE_CONE, look, mid, tip, 0.8, cr, cg, cb);
  }
}

// A patch: a ring of flowers; small and closed while faded, open and glowing a moment as it blooms.
patches :: (s: [] Fairy) {
  f := s[0].forest[..];
  t := f64(effect_time(s));
  now := s[0].time;
  for i: 0..<FF_PATCHES {
    glade := cast(int) FF_PATCH[i * 4 + 3];
    if glade == FF_THORNFALL || glade == FF_OLD_RING { continue; }   // thornfall() and old_ring() draw theirs
    x := FF_PATCH[i * 4]; z := FF_PATCH[i * 4 + 1];
    g := ground_at(s, x, z);
    open := 0.0f32; glow := 0.0f32;
    if f[0].bloomed[i] {
      age := cast(f32) (now - f[0].bloomed_at[i]);
      open = clamp01(age / 1.2);
      glow = clamp01(1 - age / 3.0);
    }
    count := ifx i == 0 then 1 else 9;
    for k: 0..<count {
      a := f32(k) * 2.399 + f32(i);
      d := ifx count == 1 then 0.0f32 else 1.4f32 * sqrt((f32(k) + 0.5) / f32(count));
      fx := x + cos(a) * d; fz := z + sin(a) * d;
      fy := ground_at(s, fx, fz);
      tall := (ifx count == 1 then 0.75f32 else 0.42f32) * (0.7 + 0.3 * open);
      shape(s, SHAPE_CYLINDER, LOOK_LEAVES, v3(fx, fy + tall * 0.5, fz), 0, 0, 0.04, tall, 0.04, 0.3, 0.55, 0.22);
      c := (i + k) % 4;
      pr := [4] f32.[0.95, 0.98, 0.72, 0.62];
      pg := [4] f32.[0.52, 0.8, 0.55, 0.78];
      pb := [4] f32.[0.68, 0.42, 0.95, 0.96];
      size := (ifx count == 1 then 0.34f32 else 0.24f32) * (0.55 + 0.45 * open);
      look := ifx glow > 0.05 || i == 0 then LOOK_GLOW else LOOK_MATTE;
      k2 := ifx look == LOOK_GLOW then 0.55f32 + 0.45f32 * glow else 1.0f32;
      if i == 0 && !f[0].bloomed[0] { k2 = 0.5 + 0.15 * sin(f32(t) * 3); }
      shape(s, SHAPE_SPHERE, look, v3(fx, fy + tall + size * 0.25, fz), a, 0, size, size * 0.55, size, pr[c] * k2, pg[c] * k2, pb[c] * k2);
    }
    _ := g;
  }
}

// Mossbank's mushrooms, the pond's reeds, Lanternwood's glowing fruit and the stones round the heart.
props :: (s: [] Fairy) {
  f := s[0].forest[..];
  t := effect_time(s);
  for k: 0..<14 {
    a := f32(k) * 2.1 + 0.3;
    d := 4 + hash1(f32(k), 4) * 6;
    x := FF_GLADE[0] + cos(a) * d; z := FF_GLADE[1] + sin(a) * d;
    if ff_patch_near(f, x, z) >= 0 && false { continue; }
    g := ground_at(s, x, z);
    h := 0.35 + hash1(f32(k), 8) * 0.6;
    shape(s, SHAPE_CYLINDER, LOOK_MATTE, v3(x, g + h * 0.5, z), 0, 0, 0.16 + h * 0.1, h, 0.16 + h * 0.1, 0.9, 0.86, 0.74);
    cap := 0.5 + h * 0.7;
    pink := ifx k % 3 == 0 then 1.0f32 else 0.0f32;
    shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(x, g + h, z), 0, 0, cap, cap * 0.55, cap, lerp(0.86, 0.95, pink), lerp(0.36, 0.6, pink), lerp(0.3, 0.7, pink));
  }
  for k: 0..<36 {
    a := f32(k) * 0.52;
    rr := 8.2 + hash1(f32(k), 1) * 1.2;
    x := f32(FF_POND_X) + cos(a) * rr; z := f32(FF_POND_Z) + sin(a) * rr * 0.95;
    st := ff_stream_near_line(s[0].stream[..], x, z);
    if st.d < st.half - 0.8 || st.d > st.half + 1.6 { continue; }
    g := ground_at(s, x, z);
    sway := sin(t * 1.3 + f32(k)) * 0.06;
    h := 1.0 + hash1(f32(k), 3) * 0.7;
    shape(s, SHAPE_CONE, LOOK_LEAVES, v3(x, hi(g, f32(FF_LEVEL)) + h * 0.5, z), a, sway, 0.12, h, 0.12, 0.42, 0.56, 0.24);
  }
  for k: 0..<26 {
    a := f32(k) * 2.399;
    d := 3 + hash1(f32(k), 6) * 8;
    x := FF_GLADE[6] + cos(a) * d; z := FF_GLADE[7] + sin(a) * d;
    g := ground_at(s, x, z);
    lamp := ff_restored(f, x, z, s[0].time);
    y := g + 2.2 + hash1(f32(k), 2) * 2.2;
    limb(s, SHAPE_CYLINDER, LOOK_LEAVES, v3(x, y + 0.6, z), v3(x, y, z), 0.02, 0.3, 0.5, 0.2);
    k2 := 0.35 + 0.65 * lamp;
    shape(s, SHAPE_SPHERE, ifx lamp > 0.3 then LOOK_GLOW else LOOK_MATTE, v3(x, y, z), 0, 0, 0.28, 0.32, 0.28, 1.0 * k2, 0.8 * k2, 0.4 * k2);
  }
  for k: 0..<7 {
    st := heart_stone(s, k);
    if !st.ok { continue; }
    x := st.x; z := st.z; a := st.a;
    g := ground_at(s, x, z);
    shape(s, SHAPE_SPHERE, LOOK_STONE, v3(x, g + 0.2, z), a, 0, 1.4, 0.9, 1.1, 0.62, 0.6, 0.55);
  }
  for p: 0..<s[0].pad_n {
    k := p * 8;
    shape(s, SHAPE_CYLINDER, LOOK_LEAVES, v3(s[0].pads[k], s[0].pads[k + 1] + 0.02, s[0].pads[k + 2]), s[0].pads[k + 3], 0, 0.9, 0.03, 0.9, 0.32, 0.58, 0.24);
    if p % 3 == 0 { shape(s, SHAPE_SPHERE, LOOK_MATTE, v3(s[0].pads[k] + 0.1, s[0].pads[k + 1] + 0.1, s[0].pads[k + 2]), 0, 0, 0.18, 0.12, 0.18, 0.98, 0.78, 0.86); }
  }
}

// Thornfall: the fallen giant, its root plate reared up at the west end, and
// bramble thickets (its three patches among them): dark and thorny while
// faded; bloomed, they flower into wild roses.
thornfall :: (s: [] Fairy, eye: Point) {
  f := s[0].forest[..];
  t := effect_time(s);
  cx := FF_GLADE[FF_THORNFALL * 3]; cz := FF_GLADE[FF_THORNFALL * 3 + 1];
  dx := cx - eye.x; dz := cz - eye.z;
  if dx * dx + dz * dz > 95 * 95 { return; }
  gz := f32(LOG_Z);
  g0 := ground_at(s, f32(LOG_X0), gz); g1 := ground_at(s, f32(LOG_X1), gz);
  r := f32(LOG_R);
  a := v3(f32(LOG_X0), g0 + r - 0.3, gz); b := v3(f32(LOG_X1), g1 + r - 0.3, gz);
  // the trunk in three lengths, a little uneven, the bark darker in its cracks
  for k: 0..<3 {
    f0 := f32(k) / 3; f1 := f32(k + 1) / 3;
    wob := 1 + (hash1(f32(k), 8) - 0.5) * 0.12;
    shade := 0.88 + hash1(f32(k), 9) * 0.2;
    limb(s, SHAPE_CYLINDER, LOOK_MATTE, mix(a, b, f0 - 0.02), mix(a, b, f1 + 0.02), r * 2 * wob * (1 - f0 * 0.12), 0.44 * shade, 0.34 * shade, 0.23 * shade);
  }
  for k: 0..<7 {
    p0 := mix(a, b, 0.08 + f32(k) * 0.13);
    an := hash1(f32(k), 3) * 2.4 - 1.2;
    q := add(p0, v3(0, sin(an) * r * 1.0, cos(an) * r * 1.0));
    limb(s, SHAPE_CYLINDER, LOOK_MATTE, add(q, v3(-0.9, 0, 0)), add(q, v3(0.9, 0, 0)), 0.18, 0.28, 0.21, 0.15);
  }
  // moss along its top, a broken end, two snapped branches
  limb(s, SHAPE_CYLINDER, LOOK_LEAVES, add(a, v3(1.5, r * 0.85, 0)), add(b, v3(-2, r * 0.85, 0)), r * 0.9, 0.3, 0.46, 0.16);
  shape(s, SHAPE_CYLINDER, LOOK_MATTE, add(b, v3(0.15, 0, 0)), 1.5708, 1.5708, r * 1.9, 0.3, r * 1.9, 0.72, 0.58, 0.4);
  limb(s, SHAPE_CONE, LOOK_MATTE, add(a, v3(5, r * 0.6, 0.3)), add(a, v3(6.5, r + 2.2, 1.2)), 0.45, 0.42, 0.33, 0.22);
  limb(s, SHAPE_CONE, LOOK_MATTE, add(a, v3(10, r * 0.5, -0.4)), add(a, v3(11, r + 1.6, -1.6)), 0.35, 0.42, 0.33, 0.22);
  // the root plate: a disc of earth and roots standing on edge
  plate_at := add(a, v3(-0.6, 0.6, 0));
  shape(s, SHAPE_CYLINDER, LOOK_MATTE, plate_at, 1.5708, 1.5708, 5.2, 0.8, 4.6, 0.38, 0.28, 0.2);
  for k: 0..<9 {
    an := f32(k) * 0.698;
    tip := add(plate_at, v3(-0.4 - hash1(f32(k), 3) * 0.8, sin(an) * 3.4, cos(an) * 3.6));
    limb(s, SHAPE_CONE, LOOK_MATTE, plate_at, tip, 0.45, 0.4, 0.3, 0.2);
  }
  // the thickets: the three patches, and more brambles round the glade's edge
  for k: 0..<9 {
    x := 0.0f32; z := 0.0f32; patch := -1;
    if k < 3 {
      patch = FF_PATCHES - 6 + k;
      x = FF_PATCH[patch * 4]; z = FF_PATCH[patch * 4 + 1];
    } else {
      an := f32(k) * 1.05 + 0.4;
      d := 9.0 + hash1(f32(k), 5) * 2;
      x = cx + cos(an) * d; z = cz + sin(an) * d;
      if abs(z - gz) < 3 && x > f32(LOG_X0) - 4 && x < f32(LOG_X1) + 3 { continue; }
      nodes := FF_NODE_XZ; links := FF_LINK_AB;
      if verse_path_nearest(nodes[..], links[..], x, z).d < f32(FF_PATH_HALF) + 1 { continue; }
    }
    bloomed := patch >= 0 && f[0].bloomed[patch];
    back := ff_restored(f, x, z, s[0].time);
    open := 0.0f32;
    if bloomed { open = clamp01(cast(f32) (s[0].time - f[0].bloomed_at[patch]) / 1.5); }
    if patch < 0 { open = back; }
    g := ground_at(s, x, z);
    size := ifx patch >= 0 then 1.0f32 else 0.8f32 + hash1(x, z) * 0.4;
    // a low, lumpy mound of small dark leaves, deep green going plum, greener as it comes back
    for m: 0..<8 {
      an := f32(m) * 2.399 + f32(k);
      rr := 0.85 * size * sqrt((f32(m) + 0.5) / 8);
      c := v3(x + cos(an) * rr, g + (0.3 + 0.3 * (1 - rr / size)) * size, z + sin(an) * rr);
      shade := 0.8 + 0.4 * hash1(f32(m), f32(k) + 1);
      shape(s, SHAPE_SPHERE, LOOK_LEAVES, c, an, 0, 0.62 * size, 0.5 * size, 0.58 * size,
            lerp(0.2, 0.18, open) * shade, lerp(0.26, 0.42, open) * shade, lerp(0.16, 0.12, open) * shade);
    }
    // thorns all over it, red-brown, and two low canes looping over the top
    for m: 0..<10 {
      an := f32(m) * 2.399 + f32(k) * 0.7;
      up := 0.25 + 0.6 * hash1(f32(m), f32(k) + 4);
      dir := unit_or(v3(cos(an) * (1 - up), up, sin(an) * (1 - up)), v3(0, 1, 0));
      root := add(v3(x, g + 0.32 * size, z), times(dir, 0.6 * size));
      if s[0].counts[SHAPE_CONE] < SLOTS[SHAPE_CONE] - 30 { limb(s, SHAPE_CONE, LOOK_MATTE, root, add(root, times(dir, 0.28 * size)), 0.07, 0.5, 0.22, 0.2); }
    }
    for m: 0..<2 {
      an := f32(m) * 3.1416 + f32(k);
      p0 := v3(x + cos(an) * 0.8 * size, g + 0.3 * size, z + sin(an) * 0.8 * size);
      p1 := v3(x + cos(an + 1.2) * 0.25 * size, g + 0.9 * size, z + sin(an + 1.2) * 0.25 * size);
      p2 := v3(x + cos(an + 2.4) * 0.85 * size, g + 0.35 * size, z + sin(an + 2.4) * 0.85 * size);
      if s[0].counts[SHAPE_CYLINDER] < SLOTS[SHAPE_CYLINDER] - 40 {
        limb(s, SHAPE_CYLINDER, LOOK_MATTE, p0, p1, 0.06, 0.42, 0.18, 0.18);
        limb(s, SHAPE_CYLINDER, LOOK_MATTE, p1, p2, 0.06, 0.42, 0.18, 0.18);
      }
    }
    // the roses, opening as it blooms
    if open > 0.02 {
      for m: 0..<7 {
        an := f32(m) * 2.399 + f32(k);
        rr := 0.75 * size * (0.4 + 0.6 * hash1(f32(m), f32(k) + 2));
        c := v3(x + cos(an) * rr, g + 0.75 * size + hash1(f32(k), f32(m)) * 0.35, z + sin(an) * rr);
        sz := 0.2 * open;
        pink := ifx m % 3 == 0 then 0.0f32 else 1.0f32;
        shape(s, SHAPE_SPHERE, ifx bloomed && open < 1 then LOOK_GLOW else LOOK_MATTE, c, an, 0, sz, sz * 0.7, sz,
              lerp(1.0, 0.98, pink), lerp(0.96, 0.5, pink), lerp(0.86, 0.62, pink));
      }
    }
  }
}

// The Old Ring: nine standing stones round a low middle stone, with a gap to
// the north for the trail. Three of them (its patches) carry a carving that
// lights when you bloom them; the rest catch a little of the light once the
// ring is restored.
old_ring :: (s: [] Fairy, u: [] f32, eye: Point) {
  f := s[0].forest[..];
  t := effect_time(s);
  cx := FF_GLADE[FF_OLD_RING * 3]; cz := FF_GLADE[FF_OLD_RING * 3 + 1];
  dx := cx - eye.x; dz := cz - eye.z;
  if dx * dx + dz * dz > 110 * 110 { return; }
  for k: 0..<FF_RING_STONES {
    st := ff_ring_stone(k);
    g := ground_at(s, st.x, st.z);
    tall := 2.9 + hash1(f32(k), 4) * 0.7;
    lean := (hash1(f32(k), 9) - 0.5) * 0.12;
    yaw := st.a + 1.5708;
    // weathered grey-brown, with a lighter, narrower upper block and a rounded crown, mossy at the foot
    tone := 0.2 + hash1(f32(k), 2) * 0.06;
    shape(s, SHAPE_BOX, LOOK_STONE, v3(st.x, g + tall * 0.32 - 0.2, st.z), yaw, lean, 1.25, tall * 0.68, 0.8, tone, tone * 0.98, tone * 0.9);
    shape(s, SHAPE_BOX, LOOK_STONE, v3(st.x, g + tall * 0.72 - 0.2, st.z), yaw + 0.08, lean, 1.0, tall * 0.4, 0.66, tone * 1.08, tone * 1.06, tone);
    shape(s, SHAPE_SPHERE, LOOK_STONE, v3(st.x, g + tall - 0.3, st.z), yaw, lean, 1.0, 0.45, 0.66, tone * 1.08, tone * 1.06, tone);
    shape(s, SHAPE_SPHERE, LOOK_LEAVES, v3(st.x, g + 0.05, st.z), yaw, 0, 1.6, 0.5, 1.15, 0.2, 0.34, 0.12);
    // the carving on its inner face: a ring over a line
    patch := -1;
    if k % 3 == 0 { patch = FF_PATCHES - 3 + k / 3; }
    if patch < 0 { continue; }
    on := f[0].bloomed[patch];
    pulse := ifx on then 0.8f32 + 0.2f32 * sin(t * 2 + f32(k)) else 1.0f32;
    inward := v3(-cos(st.a), 0, -sin(st.a));
    face := add(v3(st.x, g + 1.5, st.z), times(inward, 0.33));
    col := ifx on then v3(0.55 * pulse, 0.95 * pulse, 0.9 * pulse) else v3(0.42, 0.42, 0.4);
    look := ifx on then LOOK_GLOW else LOOK_MATTE;
    side := v3(-inward.z, 0, inward.x);
    for m: 0..<8 {
      an := f32(m) * 0.785;
      p := add(add(face, v3(0, 0.45 + sin(an) * 0.22, 0)), times(side, cos(an) * 0.22));
      shape(s, SHAPE_SPHERE, look, p, 0, 0, 0.08, 0.08, 0.05, col.x, col.y, col.z);
    }
    limb(s, SHAPE_CYLINDER, look, add(face, v3(0, -0.55, 0)), add(face, v3(0, 0.18, 0)), 0.07, col.x, col.y, col.z);
    if on { shadow(s, u, st.x, st.z, 1.2, 0.0); }
  }
  // the middle stone, where the owl sits
  g := ground_at(s, cx, cz);
  shape(s, SHAPE_CYLINDER, LOOK_STONE, v3(cx, g + 0.4, cz), 0.3, 0, 1.5, 0.9, 1.4, 0.26, 0.25, 0.22);
}

// The heart tree in bloom (the ending): blossom over the canopy, a rising
// spiral of light from its trunk for the first moments, and petals drifting
// down round it from then on.
heart_bloom :: (s: [] Fairy) {
  f := s[0].forest[..];
  if !f[0].heart { return; }
  t := effect_time(s);
  age := cast(f32) (s[0].time - f[0].heart_at);
  if s[0].golden { age = 30; }
  for k: 0..<9 {
    b := heart_blob(k);
    for m: 0..<4 {
      an := f32(m) * 1.5708 + f32(k);
      up := 0.2 + hash1(f32(k), f32(m)) * 0.5;
      p := v3(b.x + cos(an) * b.w * 0.42, b.y + up * b.w * 0.3, b.z + sin(an) * b.w * 0.42);
      sz := 0.9 + hash1(f32(m), f32(k)) * 0.6;
      shape(s, SHAPE_SPHERE, LOOK_GLOW, p, an, 0, sz, sz * 0.8, sz, 1.0, 0.72, 0.84);
    }
  }
  // the spiral: forty lights climbing round the trunk and out over the valley
  if age < 14 {
    for k: 0..<40 {
      life := age * 0.9 - f32(k) * 0.12;
      if life < 0 || life > 6 { continue; }
      an := f32(k) * 0.55 + life * 1.4;
      rr := 3.5 + life * 3.2;
      p := v3(cos(an) * rr, 2 + life * 3.6, sin(an) * rr);
      sz := 0.5 * (1 - life / 6) + 0.15;
      gold := ifx k % 3 == 0 then 1.0f32 else 0.0f32;
      shape(s, SHAPE_SPHERE, LOOK_GLOW, p, 0, 0, sz, sz, sz, 1.0, lerp(0.7, 0.9, gold), lerp(0.85, 0.5, gold));
    }
  }
  // petals, falling for good
  for k: 0..<24 {
    cycle := 9.0 + hash1(f32(k), 1) * 4;
    ph := (t + hash1(f32(k), 2) * cycle) / cycle;
    ph = ph - floor(ph);
    an := f32(k) * 2.399;
    rr := 4 + hash1(f32(k), 3) * 12;
    p := v3(cos(an) * rr + sin(t * 0.7 + f32(k)) * 1.2, 22 - ph * 21, sin(an) * rr + cos(t * 0.6 + f32(k)) * 1.2);
    shape(s, SHAPE_SPHERE, LOOK_MATTE, p, an + t, 0.6, 0.22, 0.05, 0.16, 1.0, 0.7, 0.82);
  }
}

// The creatures: a hedgehog, a frog, a rabbit, a badger and an owl, turned to you when you are near.
creatures :: (s: [] Fairy, u: [] f32, you: Point) {
  for c: 0..<FF_CREATURES { creature_draw(s, u, c, FF_CREATURE[c * 4], FF_CREATURE[c * 4 + 1], you); }
}
// Creature c at (x, z): at home in its glade, or visiting the village (fairyvillage.coax).
creature_draw :: (s: [] Fairy, u: [] f32, c: int, x: f32, z: f32, you: Point) {
  t := effect_time(s);
  {
    kind := cast(int) FF_CREATURE[c * 4 + 3];
    g := ground_at(s, x, z);
    mood := ff_mood(s[0].forest[..], c);
    feel := ff_feel(s[0].forest[..], c);
    dx := you.x - x; dz := you.z - z;
    face := ifx dx * dx + dz * dz < 100 then yaw_of(dx, dz) else f32(c) * 2.0;
    // how it feels, in how it moves: happy hops, worried shivers, lost looks
    // about, hungry sniffs low, tired sags and sways slowly
    hop := ifx feel == FEEL_HAPPY then abs(sin(t * 3.0 + f32(c))) * 0.25 else 0.0f32;
    if feel == FEEL_WORRIED { face += sin(t * 11.0 + f32(c)) * 0.06; }
    if feel == FEEL_LOST { face += sin(t * 0.8 + f32(c)) * 1.1; }
    if feel == FEEL_HUNGRY { hop = -abs(sin(t * 2.4 + f32(c))) * 0.07; }
    if feel == FEEL_TIRED { hop = -0.05 + sin(t * 0.7 + f32(c)) * 0.02; face += sin(t * 0.5) * 0.12; }
    base := v3(x, g + hop, z);
    ahead := v3(sin(face), 0, cos(face));
    right := v3(-cos(face), 0, sin(face));
    if kind == 0 {
      body := add(base, v3(0, 0.32, 0));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, body, face, 0, 0.62, 0.5, 0.75, 0.46, 0.32, 0.22);
      for k: 0..<12 {
        a := f32(k) * 0.9;
        dir := add(add(times(ahead, -0.3 + 0.55 * cos(a) * 0.4), times(right, sin(a) * 0.28)), v3(0, 0.22 + 0.06 * cos(a * 2), 0));
        limb(s, SHAPE_CONE, LOOK_CLOTH, add(body, times(dir, 0.7)), add(body, times(dir, 1.7)), 0.12, 0.36, 0.26, 0.2);
      }
      head := add(body, add(times(ahead, 0.36), v3(0, -0.02, 0)));
      shape(s, SHAPE_SPHERE, LOOK_SKIN, head, face, 0, 0.32, 0.28, 0.4, 0.86, 0.72, 0.56);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, times(ahead, 0.2)), 0, 0, 0.08, 0.08, 0.08, 0.2, 0.14, 0.12);
      expression(s, add(head, add(times(ahead, 0.13), v3(0, 0.07, 0))), ahead, right, 0.09, 0.8, feel, true, t);
      shadow(s, u, x, z, 0.6, 0.55);
    } else if kind == 1 {
      body := add(base, v3(0, 0.3, 0));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, body, face, -0.3, 0.7, 0.5, 0.75, 0.36, 0.66, 0.3);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(body, v3(0, -0.08, 0)), face, 0, 0.6, 0.3, 0.6, 0.86, 0.9, 0.6);
      for side: 0..<2 {
        sign := ifx side == 0 then 1.0f32 else -1.0f32;
        eye := add(body, add(add(times(ahead, 0.18), times(right, 0.17 * sign)), v3(0, 0.25, 0)));
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, eye, 0, 0, 0.2, 0.2, 0.2, 0.4, 0.7, 0.32);
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(eye, times(ahead, 0.07)), 0, 0, 0.1, 0.1, 0.1, 0.12, 0.1, 0.1);
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(base, add(times(right, 0.3 * sign), v3(0, 0.08, -0.05))), face, 0, 0.3, 0.16, 0.42, 0.32, 0.6, 0.26);
      }
      expression(s, add(body, add(times(ahead, 0.3), v3(0, 0.25, 0))), ahead, right, 0.17, 1.1, feel, false, t);
      shadow(s, u, x, z, 0.6, 0.55);
    } else if kind == 3 {
      // a badger: long and low, grey, a white-striped black face
      body := add(base, v3(0, 0.36, 0));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, body, face, 0, 0.7, 0.5, 1.0, 0.5, 0.5, 0.52);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(body, v3(0, -0.12, 0)), face, 0, 0.6, 0.3, 0.86, 0.22, 0.2, 0.2);
      for side: 0..<2 {
        sign := ifx side == 0 then 1.0f32 else -1.0f32;
        for end: 0..<2 {
          along := ifx end == 0 then 0.3f32 else -0.3f32;
          shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(base, add(times(ahead, along), add(times(right, 0.22 * sign), v3(0, 0.1, 0)))), face, 0, 0.16, 0.22, 0.2, 0.16, 0.15, 0.15);
        }
      }
      head := add(body, add(times(ahead, 0.55), v3(0, 0.04, 0)));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, head, face, 0, 0.36, 0.32, 0.46, 0.14, 0.13, 0.13);
      limb(s, SHAPE_CYLINDER, LOOK_CLOTH, add(head, add(times(ahead, -0.12), v3(0, 0.15, 0))), add(head, add(times(ahead, 0.22), v3(0, 0.05, 0))), 0.11, 0.97, 0.96, 0.92);
      for side: 0..<2 {
        sign := ifx side == 0 then 1.0f32 else -1.0f32;
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, add(times(right, 0.15 * sign), v3(0, 0.15, -0.04))), face, 0, 0.12, 0.1, 0.08, 0.95, 0.94, 0.9);
        shape(s, SHAPE_SPHERE, LOOK_SPARK, add(head, add(times(ahead, 0.17), add(times(right, 0.1 * sign), v3(0, 0.05, 0)))), 0, 0, 0.045, 0.045, 0.045, 0.1, 0.08, 0.08);
      }
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, times(ahead, 0.24)), 0, 0, 0.08, 0.07, 0.07, 0.08, 0.07, 0.07);
      expression(s, add(head, add(times(ahead, 0.19), v3(0, 0.06, 0))), ahead, right, 0.1, 0.8, feel, false, t);
      shadow(s, u, x, z, 0.75, 0.55);
    } else if kind == 4 {
      // an owl on the middle stone: round, tawny, with great gold eyes and ear tufts
      sit := add(base, v3(0, 0.85, 0));
      body := add(sit, v3(0, 0.42, 0));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, body, face, 0, 0.66, 0.8, 0.6, 0.56, 0.4, 0.26);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(body, add(times(ahead, 0.16), v3(0, -0.06, 0))), face, 0, 0.46, 0.58, 0.32, 0.9, 0.8, 0.62);
      head := add(body, v3(0, 0.46, 0));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, head, face, 0, 0.56, 0.46, 0.5, 0.6, 0.44, 0.28);
      blink := ifx feel == FEEL_HAPPY then 1.0f32 else ifx feel == FEEL_TIRED then 0.3f32 else 0.75f32;
      for side: 0..<2 {
        sign := ifx side == 0 then 1.0f32 else -1.0f32;
        disc := add(head, add(times(ahead, 0.2), add(times(right, 0.13 * sign), v3(0, 0.02, 0))));
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, disc, face, 0, 0.22, 0.22, 0.08, 0.95, 0.88, 0.72);
        shape(s, SHAPE_SPHERE, LOOK_SPARK, add(disc, times(ahead, 0.03)), face, 0, 0.13, 0.13 * blink, 0.06, 1.0, 0.76, 0.2);
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(disc, times(ahead, 0.06)), face, 0, 0.06, 0.06 * blink, 0.03, 0.08, 0.06, 0.05);
        tuft := add(head, add(times(right, 0.18 * sign), v3(0, 0.18, 0)));
        limb(s, SHAPE_CONE, LOOK_CLOTH, tuft, add(tuft, add(times(right, 0.08 * sign), v3(0, 0.2, 0))), 0.1, 0.5, 0.36, 0.22);
        wing := add(body, add(times(right, 0.3 * sign), v3(0, -0.02, -0.04)));
        shape(s, SHAPE_SPHERE, LOOK_CLOTH, wing, face, 0.15 * sign, 0.16, 0.66, 0.42, 0.46, 0.32, 0.2);
      }
      limb(s, SHAPE_CONE, LOOK_CLOTH, add(head, add(times(ahead, 0.24), v3(0, -0.06, 0))), add(head, add(times(ahead, 0.32), v3(0, -0.14, 0))), 0.07, 0.92, 0.72, 0.3);
      expression(s, add(head, add(times(ahead, 0.3), v3(0, 0.03, 0))), ahead, right, 0.13, 1.0, feel, false, t);
    } else {
      body := add(base, v3(0, 0.38, 0));
      fur := v3(0.86, 0.82, 0.78);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, body, face, 0, 0.6, 0.62, 0.72, fur.x, fur.y, fur.z);
      head := add(body, add(times(ahead, 0.3), v3(0, 0.36, 0)));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, head, face, 0, 0.4, 0.38, 0.42, fur.x, fur.y, fur.z);
      perk := ifx feel == FEEL_HAPPY then 0.15f32 else ifx feel == FEEL_TIRED then -0.8f32 else -0.45f32;
      for side: 0..<2 {
        sign := ifx side == 0 then 1.0f32 else -1.0f32;
        ear := add(head, add(times(right, 0.1 * sign), v3(0, 0.2, -0.04)));
        tipd := add(add(v3(0, cos(perk), 0), times(ahead, -sin(perk) * 0.6)), times(right, 0.2 * sign));
        limb(s, SHAPE_CYLINDER, LOOK_CLOTH, ear, add(ear, times(tipd, 0.5)), 0.12, fur.x, fur.y * 0.95, fur.z * 0.95);
      }
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, times(ahead, 0.2)), 0, 0, 0.07, 0.06, 0.07, 0.95, 0.6, 0.66);
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(body, times(ahead, -0.36)), 0, 0, 0.22, 0.22, 0.22, 0.96, 0.95, 0.92);
      expression(s, add(head, add(times(ahead, 0.14), v3(0, 0.08, 0))), ahead, right, 0.11, 0.85, feel, true, t);
      shadow(s, u, x, z, 0.6, 0.55);
    }
  }
}

// A creature's face, how it feels: eyes (when its body has none), brows and a
// mouth just in front of `at`, the point between its eyes. Happy smiles;
// worried and lost raise their brows, worried frowns; hungry opens its mouth;
// tired half shuts its eyes.
expression :: (s: [] Fairy, at: Point, ahead: Point, right: Point, spread: f32, size: f32, feel: int, eyes: bool, t: f32) {
  dark := v3(0.1, 0.07, 0.06);
  up := v3(0, 1, 0);
  if eyes {
    shut := ifx feel == FEEL_TIRED then 0.28f32 else 1.0f32;
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      e := add(at, add(times(right, spread * sign), times(ahead, 0.02 * size)));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, e, yaw_of(ahead.x, ahead.z), 0, 0.05 * size, 0.055 * size * shut, 0.04 * size, dark.x, dark.y, dark.z);
      if feel != FEEL_TIRED { shape(s, SHAPE_SPHERE, LOOK_SPARK, add(e, add(times(ahead, 0.025 * size), add(times(right, 0.012 * size), v3(0, 0.016 * size, 0)))), 0, 0, 0.014 * size, 0.014 * size, 0.014 * size, 0.95, 0.95, 0.95); }
    }
  }
  if feel == FEEL_WORRIED || feel == FEEL_LOST || feel == FEEL_TIRED {
    // brows: worried pinched up in the middle, lost raised, tired low and flat
    lift := ifx feel == FEEL_LOST then 0.11f32 else ifx feel == FEEL_TIRED then 0.055f32 else 0.08f32;
    tip := ifx feel == FEEL_WORRIED then 0.035f32 else 0.0f32;
    for side: 0..<2 {
      sign := ifx side == 0 then 1.0f32 else -1.0f32;
      outer := add(at, add(times(right, (spread + 0.05 * size) * sign), add(times(up, lift * size), times(ahead, 0.02 * size))));
      inner := add(at, add(times(right, (spread - 0.04 * size) * sign), add(times(up, (lift + tip) * size), times(ahead, 0.03 * size))));
      limb(s, SHAPE_CYLINDER, LOOK_CLOTH, outer, inner, 0.018 * size, dark.x, dark.y, dark.z);
    }
  }
  mouth := add(at, add(times(up, -0.12 * size), times(ahead, 0.03 * size)));
  if feel == FEEL_HUNGRY {
    gape := 0.7 + 0.3 * abs(sin(t * 2.4));
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, mouth, yaw_of(ahead.x, ahead.z), 0, 0.045 * size, 0.05 * size * gape, 0.03 * size, 0.32, 0.08, 0.1);
  } else if feel == FEEL_TIRED {
    limb(s, SHAPE_CYLINDER, LOOK_CLOTH, add(mouth, times(right, -0.03 * size)), add(mouth, times(right, 0.03 * size)), 0.012 * size, dark.x, dark.y, dark.z);
  } else {
    // a smile, or a frown for worried and lost: three dots on a curve
    bend := ifx feel == FEEL_HAPPY then 0.028f32 else -0.022f32;
    for i: 0..<3 {
      a := f32(i - 1);
      p := add(mouth, add(times(right, a * 0.04 * size), times(up, bend * size * a * a)));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, p, 0, 0, 0.016 * size, 0.016 * size, 0.016 * size, dark.x, dark.y, dark.z);
    }
  }
}

// A shape at centre whose three axes are given (their lengths the sizes): for
// what yaw and tilt can't turn, a wing's membrane along its own spars.
oriented :: (s: [] Fairy, kind: int, look: int, centre: Point, c0: Point, c1: Point, c2: Point, red: f32, green: f32, blue: f32) {
  if kind < 1 || kind > 4 { return; }
  n := s[0].counts[kind];
  if n >= SLOTS[kind] { return; }
  s[0].counts[kind] = n + 1;
  o := (SLOT_AT[kind] + n) * OBJECT_FLOATS;
  pos := centre; a0 := c0; a1 := c1; a2 := c2;
  if s[0].fig_on {
    // her body's size (the maker's BODY): stretched up and across from her feet
    w := s[0].fig_across; up := s[0].fig_up; f := s[0].fig_at;
    pos = v3(f.x + (centre.x - f.x) * w, f.y + (centre.y - f.y) * up, f.z + (centre.z - f.z) * w);
    a0 = v3(c0.x * w, c0.y * up, c0.z * w); a1 = v3(c1.x * w, c1.y * up, c1.z * w); a2 = v3(c2.x * w, c2.y * up, c2.z * w);
  }
  s[0].objects[o] = a0.x; s[0].objects[o + 1] = a1.x; s[0].objects[o + 2] = a2.x; s[0].objects[o + 3] = pos.x;
  s[0].objects[o + 4] = a0.y; s[0].objects[o + 5] = a1.y; s[0].objects[o + 6] = a2.y; s[0].objects[o + 7] = pos.y;
  s[0].objects[o + 8] = a0.z; s[0].objects[o + 9] = a1.z; s[0].objects[o + 10] = a2.z; s[0].objects[o + 11] = pos.z;
  s[0].objects[o + 12] = red; s[0].objects[o + 13] = green; s[0].objects[o + 14] = blue;
  s[0].objects[o + 15] = f32(kind + 8 * look) + (ifx s[0].mine then f32(MINE) else 0.0f32);
}

// The figure's measures, from her feet (m): tall and slender, long in the
// leg, a narrow waist, the head a little large.
FAIRY_HIP :: 0.92;
FAIRY_WAIST :: 1.1;
FAIRY_SHOULDER :: 1.4;
FAIRY_HEAD :: 1.62;         // the head's centre
FAIRY_HEAD_R :: 0.135;      // its radius; the hair's crown reaches about 0.16
FAIRY_WING_ROOT :: 1.22;     // the wings' roots: on the upper back, under the shoulders
FAIRY_WING_BACK :: 0.1;     // behind the spine
FAIRY_WING_SIDE :: 0.05;    // out from it
WING_UP_LONG :: 1.25; WING_UP_WIDE :: 0.8;
WING_LOW_LONG :: 0.9; WING_LOW_WIDE :: 0.6;
WING_TAIL_LONG :: 0.7; WING_TAIL_WIDE :: 0.27;

Wing :: struct { root: Point; along: Point; across: Point; flat: Point; reach: f32; wide: f32; }

// A wing's outline (fairy.wgsl wing_half, the same curve): at p from its
// root (0) to its tip (1), its half width as a share of its oval's. Narrow at
// the root, full a little past the middle, coming to a point at the tip.
wing_half :: (p: f32) -> f32 {
  q := clamp01(p);
  return clamp01(1.9 * pow(q, 0.6) * (1 - q));
}

// One wing: pair 0 the upper, 1 the lower, 2 the long trailing tails; side
// +1 her right, -1 her left; beat -1 (down) to 1 (up). Each sweeps out and
// back from the upper back, the upper pair rising at most 20 degrees and the
// others hanging below it, so from behind it never crosses her head (the test below).
fairy_wing :: (feet: Point, face: f32, pair: int, side: f32, beat: f32) -> Wing { return fairy_wing_shaped(feet, face, pair, side, beat, 0); }
// The same for the maker's wing shapes: jewel, butterfly, dragonfly (life.coax FFL_WING_LONG, FFL_WING_WIDE).
fairy_wing_shaped :: (feet: Point, face: f32, pair: int, side: f32, beat: f32, wing_kind: int) -> Wing {
  ahead := v3(sin(face), 0, cos(face));
  right := v3(-cos(face), 0, sin(face));
  w: Wing;
  root_y := ifx pair == 2 then f32(FAIRY_WING_ROOT) - 0.08 else f32(FAIRY_WING_ROOT);
  w.root = add(add(feet, v3(0, root_y, 0)), add(times(ahead, -f32(FAIRY_WING_BACK)), times(right, side * f32(FAIRY_WING_SIDE))));
  rise := ifx pair == 0 then 0.1f32 + 0.25f32 * beat else ifx pair == 1 then -0.55f32 + 0.18f32 * beat else -1.15f32 + 0.1f32 * beat;
  back := ifx pair == 0 then 0.22f32 else ifx pair == 1 then 0.18f32 else 0.3f32;
  out := add(times(right, side * cos(rise) * cos(back)), add(v3(0, sin(rise), 0), times(ahead, -cos(rise) * sin(back))));
  w.along = unit_or(out, right);
  // the membrane lies about in her back's plane
  w.across = unit_or(cross(ahead, w.along), v3(0, 1, 0));
  w.flat = cross(w.along, w.across);
  w.reach = ifx pair == 0 then f32(WING_UP_LONG) else ifx pair == 1 then f32(WING_LOW_LONG) else f32(WING_TAIL_LONG);
  w.wide = ifx pair == 0 then f32(WING_UP_WIDE) else ifx pair == 1 then f32(WING_LOW_WIDE) else f32(WING_TAIL_WIDE);
  k := ifx wing_kind < 0 || wing_kind > 2 then 0 else wing_kind;
  longs := FFL_WING_LONG; wides := FFL_WING_WIDE;
  w.reach *= longs[k * 3 + pair]; w.wide *= wides[k * 3 + pair];
  return w;
}

// A soft limb from a to b: three overlapping ellipsoids along it, wide at a
// and narrowing to b, so it reads as a rounded, tapered arm, leg or lock of
// hair (not a stick).
soft :: (s: [] Fairy, look: int, a: Point, b: Point, wa: f32, wb: f32, side: Point, c: Point) {
  swell(s, look, a, b, wa, (wa + wb) * 0.5, wb, side, c);
}
// The same with a middle width of its own (a calf's swell, a lock's fullness):
// five long ellipsoids overlapping by half, so the steps between them don't show.
swell :: (s: [] Fairy, look: int, a: Point, b: Point, wa: f32, wm: f32, wb: f32, side: Point, c: Point) {
  d := sub(b, a);
  l := length(d);
  if !(l > 0.0001) { return; }
  along := times(d, 1 / l);
  across := unit_or(cross(along, side), v3(0, 0, 1));
  for i: 0..<5 {
    f := (f32(i) + 0.5) / 5;
    // a quadratic through the three widths
    w := wa * (1 - f) * (1 - 2 * f) + wm * 4 * f * (1 - f) + wb * f * (2 * f - 1);
    ellipsoid(s, look, add(a, times(d, f)), times(along, l * 0.8), times(across, w), w, c);
  }
}
// A lock of hair from a, bending at m, to a point at b: one cylinder and one
// cone, whose shading runs smooth along them (a row of ellipsoids lit each
// on its own reads as beads, worst seen from below in flight), and a ball
// to round the bend.
lock :: (s: [] Fairy, a: Point, m: Point, b: Point, w: f32, c: Point) {
  limb(s, SHAPE_CYLINDER, LOOK_CLOTH, a, m, w, c.x, c.y, c.z);
  limb(s, SHAPE_CONE, LOOK_CLOTH, m, b, w * 0.97, c.x, c.y, c.z);
  shape(s, SHAPE_SPHERE, LOOK_CLOTH, m, 0, 0, w, w, w, c.x, c.y, c.z);
}
// An ellipsoid with axes a1 and a2 (their lengths its sizes) and a third,
// w across both, turned so its faces point out (oriented() needs a
// right-handed frame, else the light falls on its inside).
ellipsoid :: (s: [] Fairy, look: int, centre: Point, a1: Point, a2: Point, w: f32, c: Point) {
  a0 := times(unit_or(cross(a1, a2), v3(0, 1, 0)), w);
  oriented(s, SHAPE_SPHERE, look, centre, a0, a1, a2, c.x, c.y, c.z);
}

// You: a tall, slender fairy in a sparkling outfit of her own: a teal bodice
// trimmed in gold over a short layered skirt of teal and violet, long violet
// gloves, knee-high violet boots on platform soles, and waist-long orchid
// hair in big swooping locks. Large almond eyes with lashes, a small nose and
// mouth. Three pairs of jewel-like wings, cyan going rose at the edges, wider
// than her shoulders. Standing, her weight is on one hip; flying, her arms
// open out and her legs trail together, one knee bent.
fairy_figure :: (s: [] Fairy, u: [] f32, feet: Point, face: f32, stride: f32, act: int, air: f32, flap: f32) {
  t := effect_time(s);
  walking := act == 1 || act == 2;
  flying := air > 0.2;
  idle := !walking && !flying;
  swing := ifx walking && !flying then sin(stride * 2.4) * (ifx act == 2 then 0.7f32 else 0.45f32) else 0.0f32;
  bob := ifx walking && !flying then abs(cos(stride * 2.4)) * 0.04 else ifx flying then sin(t * 2.6) * 0.06 else sin(t * 2) * 0.012;
  base := add(feet, v3(0, bob, 0));
  ahead := v3(sin(face), 0, cos(face));
  right := v3(-cos(face), 0, sin(face));
  // her palette, as you made her (the maker, verse/fairy-forest/life.coax): bright, a little shimmer in the cloth (LOOK_CLOTH)
  l := s[0].life[..];
  skin_t := FFL_SKIN_RGB; hair_t := FFL_HAIR_RGB; eyes_t := FFL_EYES_RGB; outfit_t := FFL_OUTFIT_RGB;
  outfit := ffl_part(l, FFL_OUTFIT);
  skin := ffl_rgb(skin_t[..], ffl_part(l, FFL_SKIN));
  top := ffl_rgb(outfit_t[..], outfit * 3);          // the bodice
  gold := v3(1.0, 0.8, 0.3);                         // trim
  skirt := ffl_rgb(outfit_t[..], outfit * 3 + 1);    // the skirt, layered over the under-skirt
  violet := ffl_rgb(outfit_t[..], outfit * 3 + 2);   // gloves, boots, the under-skirt
  hair := ffl_rgb(hair_t[..], ffl_part(l, FFL_HAIR));
  iris := ffl_rgb(eyes_t[..], ffl_part(l, FFL_EYES));
  style := ffl_part(l, FFL_STYLE);
  long_hair := style == 0;
  // the hip: idle, she stands with her weight on her left hip
  shift := ifx idle then 0.045f32 else 0.0f32;
  hip := add(add(base, v3(0, f32(FAIRY_HIP), 0)), times(right, -shift));
  waist := add(base, v3(0, f32(FAIRY_WAIST), 0));
  chest := add(base, v3(0, 1.27, 0));
  // legs: long and slim, the knee bent when the leg swings back; flying, they
  // trail together and pointed, the right knee bent
  for side: 0..<2 {
    sign := ifx side == 0 then 1.0f32 else -1.0f32;
    thigh_top := add(hip, times(right, 0.075 * sign));
    a := ifx flying then -0.3f32 else swing * sign;
    bend := ifx flying then (ifx side == 0 then 0.9f32 else 0.15f32) else hi(-a, 0) * 0.9 + 0.05;
    // idle: the right leg relaxed, its knee in toward the other
    inward := ifx idle && side == 0 then -0.08f32 else 0.0f32;
    if idle && side == 0 { bend = 0.22; }
    down := unit_or(add(add(times(ahead, sin(a)), v3(0, -cos(a), 0)), times(right, inward)), v3(0, -1, 0));
    knee := add(thigh_top, times(down, 0.44));
    shin := add(times(ahead, sin(a - bend)), v3(0, -cos(a - bend), 0));
    ankle := add(knee, times(shin, 0.4));
    swell(s, LOOK_SKIN, add(thigh_top, v3(0, 0.03, 0)), knee, 0.135, 0.11, 0.075, right, skin);
    shape(s, SHAPE_SPHERE, LOOK_SKIN, knee, face, 0, 0.078, 0.08, 0.078, skin.x, skin.y, skin.z);
    // the boot: knee-high and fitted, swelling at the calf and narrow at the
    // ankle, a scalloped cuff, a pointed toe and a small heel
    swell(s, LOOK_CLOTH, add(knee, times(shin, 0.03)), ankle, 0.082, 0.088, 0.05, right, violet);
    for m: 0..<4 {
      an := face + f32(m) * 1.5708 + 0.785;
      cuff := add(add(knee, times(shin, 0.05)), v3(sin(an) * 0.045, 0, cos(an) * 0.045));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, cuff, an, 0.4, 0.06, 0.06, 0.03, violet.x * 1.15, violet.y * 1.25, violet.z);
    }
    toe_dir := unit_or(add(ahead, times(shin, ifx flying then 1.2f32 else 0.1f32)), ahead);
    heel := add(ankle, times(shin, 0.03));
    ellipsoid(s, LOOK_CLOTH, add(heel, times(toe_dir, 0.05)), times(shin, 0.07), times(toe_dir, 0.2), 0.075, violet);
    limb(s, SHAPE_CONE, LOOK_CLOTH, add(heel, add(times(toe_dir, -0.03), times(shin, 0.02))), add(heel, add(times(toe_dir, -0.02), times(shin, 0.08))), 0.035, violet.x * 0.5, violet.y * 0.45, violet.z * 0.6);
  }
  // the body: hips, a narrow waist, the bodice, and a short layered skirt
  ellipsoid(s, LOOK_CLOTH, add(hip, v3(0, 0.07, 0)), v3(0, 0.2, 0), times(ahead, 0.19), 0.27, violet);
  shape(s, SHAPE_CYLINDER, LOOK_CLOTH, waist, face, 0, 0.17, 0.12, 0.13, top.x, top.y, top.z);
  ellipsoid(s, LOOK_CLOTH, chest, v3(0, 0.31, 0), times(ahead, 0.15), 0.25, top);
  ellipsoid(s, LOOK_CLOTH, add(chest, v3(0, 0.1, 0)), v3(0, 0.12, 0), times(ahead, 0.14), 0.3, top);   // the shoulders' line
  shape(s, SHAPE_CYLINDER, LOOK_CLOTH, add(waist, v3(0, -0.04, 0)), face, 0, 0.2, 0.035, 0.16, gold.x, gold.y, gold.z);
  shape(s, SHAPE_SPHERE, LOOK_SPARK, add(chest, add(times(ahead, 0.075), v3(0, 0.05, 0))), face, 0, 0.035, 0.035, 0.02, 1.0, 0.85, 0.5);
  for layer: 0..<2 {
    c := ifx layer == 0 then violet else skirt;
    drop := ifx layer == 0 then 0.0f32 else 0.06f32;
    for k: 0..<8 {
      an := face + f32(k) * 0.785 + f32(layer) * 0.39;
      lift := ifx flying then 0.05f32 * sin(t * 5 + f32(k)) else 0.0f32;
      out := v3(sin(an), 0, cos(an));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(add(hip, v3(0, 0.02 + drop + lift, 0)), times(out, 0.12 + 0.03 * f32(layer))), an, -0.55 - lift * 3,
            0.17, 0.27 - f32(layer) * 0.05, 0.05, c.x, c.y, c.z);
    }
  }
  // the neck and shoulders
  limb(s, SHAPE_CYLINDER, LOOK_SKIN, add(base, v3(0, 1.4, 0)), add(base, v3(0, 1.52, 0)), 0.065, skin.x, skin.y, skin.z);
  // arms: slim, an arm band above the elbow and long gloves; idle, one hand on
  // her hip; flying, both open out
  for side: 0..<2 {
    sign := ifx side == 0 then 1.0f32 else -1.0f32;
    shoulder := add(add(base, v3(0, f32(FAIRY_SHOULDER), 0)), times(right, 0.15 * sign));
    shape(s, SHAPE_SPHERE, LOOK_SKIN, shoulder, face, 0, 0.085, 0.08, 0.08, skin.x, skin.y, skin.z);
    swing_a := ifx flying then 0.15f32 else -swing * 0.7;
    spread := ifx flying then 1.15f32 + 0.12f32 * sin(t * 3) else 0.14f32;
    on_hip := idle && side == 1;
    if on_hip { spread = 0.55; swing_a = -0.25; }
    upper := unit_or(add(add(times(ahead, sin(swing_a)), v3(0, -cos(spread) * cos(swing_a), 0)), times(right, sin(spread) * sign)), v3(0, -1, 0));
    elbow := add(shoulder, times(upper, 0.27));
    fore := unit_or(add(upper, add(times(ahead, 0.3), v3(0, ifx flying then 0.45f32 else 0.0f32, 0))), upper);
    if on_hip { fore = unit_or(sub(add(hip, add(times(right, 0.17 * sign), v3(0, 0.1, 0))), elbow), upper); }
    wrist := add(elbow, times(fore, 0.24));
    swell(s, LOOK_SKIN, shoulder, elbow, 0.062, 0.056, 0.042, ahead, skin);
    shape(s, SHAPE_SPHERE, LOOK_SKIN, elbow, face, 0, 0.044, 0.044, 0.044, skin.x, skin.y, skin.z);
    shape(s, SHAPE_CYLINDER, LOOK_CLOTH, add(shoulder, times(upper, 0.18)), face, 0, 0.09, 0.03, 0.09, gold.x, gold.y, gold.z);
    swell(s, LOOK_CLOTH, elbow, wrist, 0.05, 0.048, 0.034, ahead, violet);
    palm := add(wrist, times(fore, 0.045));
    ellipsoid(s, LOOK_CLOTH, palm, times(fore, 0.08), times(ahead, 0.06), 0.032, violet);
    thumb := add(wrist, add(times(fore, 0.03), times(ahead, 0.03)));
    limb(s, SHAPE_CONE, LOOK_CLOTH, thumb, add(thumb, add(times(ahead, 0.03), times(fore, 0.03))), 0.024, violet.x, violet.y, violet.z);
  }
  // the head and face: large almond eyes with lashes, a small nose and mouth
  head := add(base, v3(0, f32(FAIRY_HEAD), 0));
  hr := f32(FAIRY_HEAD_R);
  shape(s, SHAPE_SPHERE, LOOK_SKIN, head, face, 0, hr * 1.9, hr * 2.1, hr * 2.0, skin.x, skin.y, skin.z);
  shape(s, SHAPE_SPHERE, LOOK_SKIN, add(head, add(times(ahead, 0.05), v3(0, -0.1, 0))), face, 0, 0.12, 0.08, 0.1, skin.x, skin.y, skin.z);   // the chin
  for side: 0..<2 {
    sign := ifx side == 0 then 1.0f32 else -1.0f32;
    eye := add(head, add(times(ahead, hr * 0.88), add(times(right, 0.052 * sign), v3(0, 0.0, 0))));
    tilt := 0.18 * sign;
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, eye, face + tilt * 0.3, tilt, 0.07, 0.052, 0.02, 0.98, 0.98, 1.0);
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(eye, times(ahead, 0.006)), face, 0, 0.038, 0.042, 0.02, iris.x, iris.y, iris.z);
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(eye, times(ahead, 0.01)), face, 0, 0.018, 0.022, 0.016, 0.06, 0.05, 0.1);
    shape(s, SHAPE_SPHERE, LOOK_SPARK, add(eye, add(times(ahead, 0.014), add(times(right, 0.008 * sign), v3(0, 0.01, 0)))), 0, 0, 0.012, 0.012, 0.01, 0.9, 0.92, 0.95);
    // the lash line, heavier at the outer corner
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(eye, add(times(ahead, 0.004), add(times(right, 0.006 * sign), v3(0, 0.028, 0)))), face + tilt * 0.3, tilt, 0.078, 0.012, 0.022, 0.12, 0.06, 0.12);
    limb(s, SHAPE_CONE, LOOK_CLOTH, add(eye, add(times(right, 0.035 * sign), v3(0, 0.02, 0))), add(eye, add(times(right, 0.055 * sign), v3(0, 0.035, 0))), 0.012, 0.12, 0.06, 0.12);
    // a fine brow
    shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(eye, add(times(ahead, -0.002), v3(0, 0.05, 0))), face + tilt * 0.4, tilt * 1.2, 0.06, 0.01, 0.015, hair.x * 0.7, hair.y * 0.7, hair.z * 0.7);
    // a pointed ear, back and up
    ear := add(head, add(times(right, hr * 0.92 * sign), v3(0, -0.01, -0.01)));
    limb(s, SHAPE_CONE, LOOK_SKIN, ear, add(ear, add(times(right, 0.09 * sign), add(v3(0, 0.07, 0), times(ahead, -0.05)))), 0.045, skin.x, skin.y, skin.z);
  }
  shape(s, SHAPE_SPHERE, LOOK_SKIN, add(head, add(times(ahead, hr * 0.98), v3(0, -0.035, 0))), face, 0, 0.016, 0.022, 0.016, skin.x, skin.y * 0.94, skin.z * 0.94);
  shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, add(times(ahead, hr * 0.86), v3(0, -0.085, 0))), face, 0, 0.038, 0.012, 0.016, 0.92, 0.32, 0.45);
  // hair: a full crown with volume on top, sweeping bangs, long locks
  // framing her face to her waist, and a great mass down her back whose
  // locks fan out behind and to the sides; in flight it streams back
  shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, add(v3(0, 0.035, 0), times(ahead, -0.03))), face, 0, hr * 2.3, hr * 2.2, hr * 2.3, hair.x, hair.y, hair.z);
  shape(s, SHAPE_SPHERE, LOOK_CLOTH, add(head, add(v3(0, 0.11, 0), times(ahead, -0.05))), face, -0.3, hr * 2.0, hr * 1.2, hr * 2.0, hair.x * 1.05, hair.y * 1.05, hair.z);
  for k: 0..<5 {
    off := (f32(k) - 2) * 0.045;
    bang := add(head, add(times(ahead, hr * 0.78), add(times(right, off), v3(0, 0.085 - abs(off) * 0.4, 0))));
    limb(s, SHAPE_CONE, LOOK_CLOTH, add(bang, v3(0, 0.05, -0.0)), add(bang, add(times(right, off * 0.6 + 0.02), add(times(ahead, 0.02), v3(0, -0.06, 0)))), 0.07, hair.x * 1.05, hair.y * 1.05, hair.z);
  }
  sway := ifx flying then 0.12f32 * sin(t * 4) else 0.03f32 * sin(t * 1.4);
  trail := ifx flying then 0.3f32 else 0.0f32;    // in flight the hair streams back
  // SHORT and BUNS: a bob to the jaw, and BUNS two buns on top
  reach := ifx long_hair then 1.0f32 else 0.32f32;
  for side: 0..<2 {
    sign := ifx side == 0 then 1.0f32 else -1.0f32;
    from := add(head, add(times(right, 0.12 * sign), add(times(ahead, 0.02), v3(0, 0.0, 0))));
    mid := add(from, add(times(right, 0.1 * sign), add(times(ahead, -0.04 - trail * 0.3), v3(0, -0.34 * reach, 0))));
    tip := add(mid, add(times(right, 0.08 * sign * reach), add(times(ahead, -0.06 - trail * 0.4), v3(0, (-0.36 + trail * 0.3) * reach, 0))));
    lock(s, from, mid, tip, 0.125, hair);
    if style == 2 {
      bun := add(head, add(times(right, 0.13 * sign), add(times(ahead, -0.04), v3(0, 0.15, 0))));
      shape(s, SHAPE_SPHERE, LOOK_CLOTH, bun, face, 0, 0.1, 0.1, 0.1, hair.x * 1.04, hair.y * 1.04, hair.z * 1.04);
    }
  }
  // the mass of it behind her head and shoulders
  if !long_hair { ellipsoid(s, LOOK_CLOTH, add(head, add(times(ahead, -0.09), v3(0, -0.04, 0))), v3(0, 0.2, 0), times(ahead, 0.16), 0.36, hair); }
  if long_hair { ellipsoid(s, LOOK_CLOTH, add(head, add(times(ahead, -0.11 - trail * 0.2), v3(0, -0.18, 0))), v3(0, 0.5, 0), times(ahead, 0.18), 0.44, hair); }
  for k: 0..<(ifx long_hair then 7 else 0) {
    off := (f32(k) - 3) * 0.06;
    from := add(head, add(times(ahead, -0.12), add(times(right, off), v3(0, -0.02, 0))));
    wave := sin(t * 1.6 + f32(k)) * 0.03 + sway;
    mid := add(from, add(times(ahead, -0.1 - trail - wave), add(times(right, off * 1.05), v3(0, -0.36 + trail * 0.2, 0))));
    tip := add(mid, add(times(ahead, -0.06 - trail * 1.2 + wave), add(times(right, off * 0.9 + 0.03 * sin(f32(k) * 1.7)), v3(0, -0.36 + trail * 0.5 + abs(off) * 0.3, 0))));
    curl := add(tip, add(times(right, off * 0.3), add(times(ahead, 0.03), v3(0, -0.06, 0))));
    shade := 0.88 + 0.16 * hash1(f32(k), 1);
    c := v3(hair.x * shade, hair.y * shade, hair.z * shade);
    lock(s, from, mid, tip, 0.2, c);
    limb(s, SHAPE_CONE, LOOK_CLOTH, mix(mid, tip, 0.8), curl, 0.05, c.x, c.y, c.z);
  }
  // a star clip in her hair
  clip := add(head, add(times(right, -0.13), add(v3(0, 0.1, 0), times(ahead, 0.02))));
  for k: 0..<5 {
    an := f32(k) * 1.2566;
    p := add(clip, add(times(ahead, cos(an) * 0.03), v3(0, sin(an) * 0.03, 0)));
    shape(s, SHAPE_SPHERE, LOOK_SPARK, p, face, 0, 0.022, 0.03, 0.03, 1.0, 0.82, 0.4);
  }
  // wings: three pairs, each a jewel-like oval of light whose root sits at the spine
  beat := sin(flap);
  kind := ffl_part(l, FFL_WINGS);
  wing_t := FFL_WING_RGB; glow_t := FFL_GLOW_GAIN;
  hue := ffl_part(l, FFL_WING_HUE); gain := glow_t[ffl_part(l, FFL_GLOW)];
  for side: 0..<2 {
    sign := ifx side == 0 then 1.0f32 else -1.0f32;
    for pair: 0..<3 {
      w := fairy_wing_shaped(base, face, pair, sign, beat, kind);
      c := add(w.root, times(w.along, w.reach * 0.5));
      tint := times(ffl_rgb(wing_t[..], hue * 3 + pair), gain);
      oriented(s, SHAPE_SPHERE, LOOK_WING, c, times(w.across, w.wide), times(w.along, w.reach), times(w.flat, 0.02), tint.x, tint.y, tint.z);
      // a smaller inner panel laid over it, a jewel colour of its own
      if pair < 2 {
        inner := add(w.root, add(times(w.along, w.reach * 0.42), times(w.flat, -0.012)));
        jewel := ifx pair == 0 then v3(0.75, 0.5, 1.0) else v3(1.0, 0.75, 0.45);
        if hue != 0 { jewel = mix(ffl_rgb(wing_t[..], hue * 3 + 1 - pair), v3(1, 1, 1), 0.3); }
        jewel = times(jewel, gain);
        oriented(s, SHAPE_SPHERE, LOOK_WING, inner, times(w.across, w.wide * 0.55), times(w.along, w.reach * 0.62), times(w.flat, 0.02), jewel.x, jewel.y, jewel.z);
      }
    }
  }
  shadow(s, u, feet.x, feet.z, lo(0.45 + air * 0.08, 0.9), clamp(0.6 - air * 0.12, 0.15, 0.6));
}

// The trail of sparkles she leaves while she moves or flies: born at her
// back, they drift down and fade. None in golden mode (they follow the clock).
SPARKS :: 18;
SPARK_LIFE :: 1.1;
sparkle :: (s: [] Fairy, feet: Point, face: f32, moving: bool, dt: f32) {
  if s[0].golden { return; }
  s[0].spark_clock -= dt;
  every := ifx moving then 0.07f32 else 0.45f32;
  if s[0].spark_clock <= 0 {
    s[0].spark_clock = every;
    i := s[0].spark_next % SPARKS;
    s[0].spark_next = i + 1;
    j := hash1(f32(s[0].time) * 13.1, f32(i));
    side := ifx i % 2 == 0 then 1.0f32 else -1.0f32;
    ahead := v3(sin(face), 0, cos(face));
    right := v3(-cos(face), 0, sin(face));
    p := add(feet, add(v3(0, 0.9 + j * 0.4, 0), add(times(ahead, -0.2), times(right, side * (0.15 + j * 0.35)))));
    k := i * 4;
    s[0].sparks[k] = p.x; s[0].sparks[k + 1] = p.y; s[0].sparks[k + 2] = p.z; s[0].sparks[k + 3] = f32(s[0].time);
  }
  for i: 0..<SPARKS {
    k := i * 4;
    age := f32(s[0].time) - s[0].sparks[k + 3];
    if s[0].sparks[k + 3] <= 0 || age < 0 || age > f32(SPARK_LIFE) { continue; }
    life := 1 - age / f32(SPARK_LIFE);
    size := 0.05 * life;
    gold := ifx i % 3 == 0 then 0.0f32 else 1.0f32;
    shape(s, SHAPE_SPHERE, LOOK_SPARK, v3(s[0].sparks[k], s[0].sparks[k + 1] - age * 0.35, s[0].sparks[k + 2]), 0, 0, size, size, size,
          lerp(1.0, 1.0, gold) * (0.6 + life), lerp(0.62, 0.9, gold) * (0.6 + life), lerp(0.95, 0.55, gold) * (0.6 + life));
  }
}

// The camera as clip-space rows (WebGPU: depth 0 near to 1 far).
NEAR :: 0.1; FAR :: 700.0;
view :: (shot: Shot, width: f32, height: f32, u: [] f32, at: int) {
  f := unit_or(sub(shot.at, shot.eye), v3(0, 0, 1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  aspect := width / hi(height, 1);
  fy := clamp(aspect * 1.25, 0.95, 1.9);
  fx := fy / aspect;
  depth := f32(FAR / (FAR - NEAR));
  e := shot.eye;
  rows := [16] f32.[
    r.x * fx, r.y * fx, r.z * fx, -dot(r, e) * fx,
    up.x * fy, up.y * fy, up.z * fy, -dot(up, e) * fy,
    f.x * depth, f.y * depth, f.z * depth, (-dot(f, e) - f32(NEAR)) * depth,
    f.x, f.y, f.z, -dot(f, e)
  ];
  for i: 0..<16 { u[at + i] = rows[i]; }
}

// A point on the screen in device pixels, or x < -1000 behind the camera.
project :: (u: [] f32, p: Point, width: f32, height: f32) -> Point {
  cx := u[U_VIEW] * p.x + u[U_VIEW + 1] * p.y + u[U_VIEW + 2] * p.z + u[U_VIEW + 3];
  cy := u[U_VIEW + 4] * p.x + u[U_VIEW + 5] * p.y + u[U_VIEW + 6] * p.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * p.x + u[U_VIEW + 13] * p.y + u[U_VIEW + 14] * p.z + u[U_VIEW + 15];
  if !(cw > 0.05) { return v3(-10000, 0, 0); }
  return v3((cx / cw * 0.5 + 0.5) * width, (0.5 - cy / cw * 0.5) * height, cw);
}

ground_room :: (s: [] Fairy, r: OrbitRay) -> f32 {
  lifted := add(r.from, v3(0, -0.5, 0));
  return verse_terrain_ray(ground(), s[0].heights[..], lifted, r.dir, r.far);
}

camera_frame :: (s: [] Fairy, feet: Point, vx: f32, vz: f32, dt: f32) -> Shot {
  speed := sqrt(vx * vx + vz * vz);
  // making your fairy on a phone: the pane covers the upper half, so she stands in the lower
  aim := ifx s[0].maker[0].open && phone(s) then add(feet, v3(0, 1.3, 0)) else feet;
  o := verse_orbit_follow(s[0].orbit, aim, yaw_of(vx, vz), finite(speed) && speed > 0.6, dt);
  camera_spheres(s, feet);
  room := verse_orbit_room(o, s[0].spheres[0..<s[0].sphere_n * 4], s[0].boxes[0..<s[0].box_n * 6]);
  room = lo(room, ground_room(s, verse_orbit_ray(o)));
  o = verse_orbit_limit(o, room, dt);
  s[0].orbit = o;
  return verse_orbit_shot(o);
}

paths :: (u: [] f32) {
  n := 0;
  for i: 0..<FF_LINKS {
    if n >= PATHS { break; }
    a := FF_LINK_AB[i * 2]; b := FF_LINK_AB[i * 2 + 1];
    k := U_PATH + n * 4;
    u[k] = FF_NODE_XZ[a * 2]; u[k + 1] = FF_NODE_XZ[a * 2 + 1]; u[k + 2] = FF_NODE_XZ[b * 2]; u[k + 3] = FF_NODE_XZ[b * 2 + 1];
    n += 1;
  }
  u[U_PATH_INFO] = f32(n); u[U_PATH_INFO + 1] = f32(FF_PATH_HALF);
}

blooms :: (s: [] Fairy, u: [] f32) {
  f := s[0].forest[..];
  for i: 0..<f[0].bloom_n {
    b := f[0].blooms[i];
    k := U_BLOOM + i * 4;
    u[k] = b.x; u[k + 1] = b.z; u[k + 2] = ff_bloom_radius(b, s[0].time);
    u[k + 3] = clamp01(1 - cast(f32) (s[0].time - b.began) / 4.0);   // a bright front while it spreads
  }
  u[U_BLOOM_INFO] = f32(f[0].bloom_n);
}

// ---- play

// E, a click or BLOOM: the patch at your feet blooms.
play :: (s: [] Fairy, you: Point) {
  f := s[0].forest[..];
  if s[0].use && s[0].race[0].making { ffc_act(s, FFC_HOOP); s[0].use = false; }   // making a course: E hangs a hoop, flying too
  if s[0].use && s[0].air > f32(FLYING) { s[0].use = false; }   // flying: nothing at hand (no prompt shows)
  if s[0].maker[0].open { s[0].use = false; }
  if s[0].use {
    i := ff_patch_near(f, you.x, you.z);
    if i >= 0 { done := ff_bloom(f, i, s[0].time); }
    else if s[0].near_creature >= 0 && ffv_can_invite(s, s[0].near_creature) { _ := ffv_invite(s[0].life[..], s[0].near_creature, s[0].now_min); }
    else if s[0].near_creature >= 0 && s[0].talk == 0 { talk_to(s, s[0].near_creature); }
    else if ffg_verb(s, you) != 0 { _ := ffg_use(s, you); }
    else if ffm_near_pool(you) { ffm_open(s, false); }
    else if ffh_near(you.x, you.z, f32(FFB_HOME_NEAR)) && !s[0].build[0].open { ffb_open(s); }
    s[0].use = false;
  }
  ff_step(f, s[0].time);
  s[0].near_creature = -1; s[0].remark_creature = -1;
  bd := f32(FF_TALK_NEAR); rd := f32(FF_REMARK_NEAR);
  for c: 0..<FF_CREATURES {
    dx := you.x - FF_CREATURE[c * 4]; dz := you.z - FF_CREATURE[c * 4 + 1];
    d := sqrt(dx * dx + dz * dz);
    if d < bd { bd = d; s[0].near_creature = c; }
    if d < rd { rd = d; s[0].remark_creature = c; }
  }
  if s[0].near_creature >= 0 { s[0].remark_creature = -1; }
  // come by again and it says something new
  if s[0].remark_creature >= 0 && !s[0].remark_heard { s[0].remark_turn += 1; }
  s[0].remark_heard = s[0].remark_creature >= 0 || s[0].near_creature >= 0;
}

// ---- the HUD

plate :: (s: [] Fairy, u: [] f32, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  k := U_PLATE + n * 8;
  u[k] = b.x0; u[k + 1] = b.y0; u[k + 2] = b.x1; u[k + 3] = b.y1;
  u[k + 4] = alpha; u[k + 5] = look; u[k + 6] = s[0].dpr; u[k + 7] = 0;
  s[0].plate_n = n + 1;
}

phone :: (s: [] Fairy) -> bool { return s[0].touch || s[0].width / hi(s[0].dpr, 0.5) < 700; }

hint :: (s: [] Fairy) -> string {
  if phone(s) { return "LEFT THUMB WALKS · RIGHT THUMB LOOKS · TAP RIGHT SIDE TO FLAP UP, HOLD TO CLIMB"; }
  return "WASD MOVE · DRAG TURNS · SPACE FLAPS UP, HOLD TO CLIMB · SHIFT WALKS, IN THE AIR DIVES";
}

// A mood glyph over a creature: a face in a ring, its colour and face how it
// feels (happy, worried, lost, hungry, tired); paler while it is partly helped.
FEEL_COLOUR :: [15] f32.[0.98, 0.82, 0.46,   0.62, 0.72, 0.94,   0.56, 0.86, 0.9,   0.98, 0.62, 0.4,   0.8, 0.68, 0.96];
mood_glyph :: (s: [] Fairy, out: [] f32, n: int, x: f32, y: f32, r: f32, mood: int, feel: int, k: f32) -> int {
  m := n;
  f := ifx feel < 0 || feel >= FEELS then FEEL_HAPPY else feel;
  cr := FEEL_COLOUR[f * 3]; cg := FEEL_COLOUR[f * 3 + 1]; cb := FEEL_COLOUR[f * 3 + 2];
  if mood == MOOD_HOPEFUL && feel != FEEL_HAPPY { cr = (cr + CREAM_R) / 2; cg = (cg + CREAM_G) / 2; cb = (cb + CREAM_B) / 2; }
  w := 0.9 * k; gl := 1.5 * k;
  for i: 0..<20 {
    a0 := f32(i) * f32(TAU) / 20; a1 := f32(i + 1) * f32(TAU) / 20;
    if lit(out, m, x + cos(a0) * r, y + sin(a0) * r, x + cos(a1) * r, y + sin(a1) * r, 1.0 * k, 0.9, 2.5 * k, cr, cg, cb, 0) { m += 6; }
  }
  // the eyes: dots, shut lines when tired
  for e: 0..<2 {
    sg := ifx e == 0 then -1.0f32 else 1.0f32;
    ex := x + sg * 0.36 * r; ey := y - 0.22 * r;
    if feel == FEEL_TIRED {
      if lit(out, m, ex - 0.16 * r, ey + 0.04 * r, ex + 0.16 * r, ey + 0.04 * r, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    } else if lit(out, m, ex - 0.01, ey, ex + 0.01, ey, 1.6 * k, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    // brows: worried pinched up in the middle, lost raised
    if feel == FEEL_WORRIED { if lit(out, m, ex + sg * 0.2 * r, ey - 0.2 * r, ex - sg * 0.14 * r, ey - 0.34 * r, w, 0.9, gl, cr, cg, cb, 0) { m += 6; } }
    if feel == FEEL_LOST { if lit(out, m, ex - 0.16 * r, ey - 0.36 * r, ex + 0.16 * r, ey - 0.36 * r, w, 0.9, gl, cr, cg, cb, 0) { m += 6; } }
  }
  // the mouth: a smile, a frown, a wobble for lost, an open O for hungry, a small line for tired
  if feel == FEEL_HUNGRY {
    for i: 0..<10 {
      a0 := f32(i) * f32(TAU) / 10; a1 := f32(i + 1) * f32(TAU) / 10;
      if lit(out, m, x + cos(a0) * 0.16 * r, y + 0.36 * r + sin(a0) * 0.2 * r, x + cos(a1) * 0.16 * r, y + 0.36 * r + sin(a1) * 0.2 * r, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    }
  } else if feel == FEEL_TIRED {
    if lit(out, m, x - 0.16 * r, y + 0.38 * r, x + 0.16 * r, y + 0.38 * r, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
  } else {
    bend := ifx feel == FEEL_HAPPY then 0.32f32 else ifx feel == FEEL_LOST then 0.0f32 else -0.26f32;
    for i: 0..<6 {
      t0 := f32(i) / 6 * 2 - 1; t1 := f32(i + 1) / 6 * 2 - 1;
      w0 := ifx feel == FEEL_LOST then sin(t0 * 6.0) * 0.07 * r else 0.0f32;
      w1 := ifx feel == FEEL_LOST then sin(t1 * 6.0) * 0.07 * r else 0.0f32;
      y0 := y + 0.3 * r + bend * r * (1 - t0 * t0) + w0; y1 := y + 0.3 * r + bend * r * (1 - t1 * t1) + w1;
      if lit(out, m, x + t0 * 0.42 * r, y0, x + t1 * 0.42 * r, y1, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    }
  }
  // beside it: sparkles for happy, a ? for lost, a z for tired, a drop for worried, a crumb for hungry
  bx := x + 1.25 * r; by := y - 0.95 * r; q := 0.42 * r;
  if feel == FEEL_HAPPY {
    for i: 0..<4 {
      a := f32(i) * 1.5708 + effect_time(s) * 1.2;
      sx := x + cos(a) * r * 1.55; sy := y + sin(a) * r * 1.55;
      if lit(out, m, sx - 0.01, sy, sx + 0.01, sy, 1.2 * k, 1.0, 3 * k, cr, cg, cb, 0) { m += 6; }
    }
  } else if feel == FEEL_LOST {
    for i: 0..<6 {
      a0 := f32(PI) + f32(i) / 6 * 3.6; a1 := f32(PI) + f32(i + 1) / 6 * 3.6;
      if lit(out, m, bx + cos(a0) * q, by + sin(a0) * q, bx + cos(a1) * q, by + sin(a1) * q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    }
    if lit(out, m, bx + cos(f32(PI) + 3.6) * q, by + sin(f32(PI) + 3.6) * q, bx, by + 1.25 * q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx - 0.01, by + 1.9 * q, bx + 0.01, by + 1.9 * q, 1.4 * k, 0.9, gl, cr, cg, cb, 0) { m += 6; }
  } else if feel == FEEL_TIRED {
    zz := 0.5 + 0.5 * sin(effect_time(s) * 1.5);
    zy := by - zz * 0.4 * r;
    if lit(out, m, bx - q, zy - q, bx + q, zy - q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx + q, zy - q, bx - q, zy + q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx - q, zy + q, bx + q, zy + q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
  } else if feel == FEEL_WORRIED {
    if lit(out, m, bx, by - q, bx - 0.5 * q, by + 0.4 * q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx, by - q, bx + 0.5 * q, by + 0.4 * q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx - 0.5 * q, by + 0.4 * q, bx + 0.5 * q, by + 0.4 * q, w, 0.9, gl, cr, cg, cb, 0) { m += 6; }
  } else if feel == FEEL_HUNGRY {
    // an acorn: its cap and its nut
    if lit(out, m, bx - 0.7 * q, by - 0.3 * q, bx + 0.7 * q, by - 0.3 * q, 1.2 * k, 0.9, gl, cr, cg, cb, 0) { m += 6; }
    if lit(out, m, bx - 0.01, by + 0.35 * q, bx + 0.01, by + 0.35 * q, 2.6 * k, 0.9, gl, cr, cg, cb, 0) { m += 6; }
  }
  return m;
}

hud :: (s: [] Fairy, out: [] f32, u: [] f32, move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32, you: Point) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  f := s[0].forest[..];
  n := 0;
  gutter := 16 * k;
  cap := 11 * k;
  title := "FAIRY FOREST";
  roots := ff_roots_awake(f);
  counted := [5] string.["ONE ROOT OF FIVE AWAKE", "TWO ROOTS OF FIVE AWAKE", "THREE ROOTS OF FIVE AWAKE", "FOUR ROOTS OF FIVE AWAKE", "ALL FIVE ROOTS AWAKE"];
  line2 := ifx f[0].heart then "THE HEART TREE IS IN BLOOM" else ifx roots == 0 then "THE HEART TREE SLEEPS" else counted[roots - 1];
  small := 7.5 * k;
  tw := hi(text_width(title, cap), text_width(line2, small));
  plate(s, u, Box.{x0 = gutter, y0 = gutter, x1 = gutter + tw + 28 * k, y1 = gutter + cap + small + 34 * k}, 0.78, 0);
  n = draw_text(out, n, title, gutter + 14 * k, gutter + 12 * k + cap, cap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  n = draw_text(out, n, line2, gutter + 14 * k, gutter + 22 * k + cap + small, small, GAP, SPACE, ink(k, 0.85, CREAM_R, CREAM_G, CREAM_B), false, false);
  n = ffc_chip(s, out, u, n, gutter + tw + 36 * k, gutter, gutter + cap + small + 34 * k);
  n = ffc_pane(s, out, u, n, gutter + cap + small + 42 * k + (ifx phone(s) then 38 * k else 0.0f32));   // on a phone, under the chat's line
  // the mood glyphs over the creatures in view
  for c: 0..<FF_CREATURES {
    s[0].seen_on[c] = false;
    x := FF_CREATURE[c * 4]; z := FF_CREATURE[c * 4 + 1];
    lift := ifx cast(int) FF_CREATURE[c * 4 + 3] == 4 then 2.9f32 else 1.6f32;   // the owl sits on its stone
    p := project(u, v3(x, ground_at(s, x, z) + lift, z), w, h);
    if p.x < -1000 || p.z > 60 { continue; }
    r := clamp(150 * k / hi(p.z, 1), 5 * k, 15 * k);
    n = mood_glyph(s, out, n, p.x, p.y, r, ff_mood(f, c), ff_feel(f, c), k);
    // where a click or a tap on it talks to it: its glyph and its body under it
    if p.z < f32(TAP_TALK_NEAR) {
      s[0].seen_on[c] = true;
      body := project(u, v3(x, ground_at(s, x, z) + lift * 0.4, z), w, h);
      s[0].seen_x[c] = p.x; s[0].seen_y[c] = (p.y + body.y) / 2;
      s[0].seen_r[c] = hi(abs(body.y - p.y) * 0.75 + r, 28 * k);
    }
  }
  s[0].pane_top = 0;
  s[0].button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  if s[0].maker[0].open { return ffm_hud(s, out, u, n); }
  if s[0].talk > 0 { n = conversation(s, out, u, n); return ffs_hud(s, out, u, n, s[0].pane_top); }
  // the hint at the foot
  line := hint(s);
  hs := 7.5 * k;
  room := w - 2 * gutter - 24 * k;
  lw := text_width(line, hs);
  if lw > room { hs = hs * room / lw; lw = room; }
  y1 := h - gutter;
  plate(s, u, Box.{x0 = (w - lw) / 2 - 12 * k, y0 = y1 - hs - 20 * k, x1 = (w + lw) / 2 + 12 * k, y1 = y1}, 0.68, 0);
  n = draw_text(out, n, line, (w - lw) / 2, y1 - 10 * k, hs, GAP, SPACE, ink(k, 0.85, CREAM_R, CREAM_G, CREAM_B), false, false);
  above := y1 - hs - 20 * k;
  foot_x0 := (w - lw) / 2 - 12 * k;   // the left edge of what is centred along the bottom
  // what a creature near you says, or the news
  said := "";
  who := "";
  if s[0].near_creature >= 0 { said = ff_says(f, s[0].near_creature); who = FF_CREATURE_NAMES[s[0].near_creature]; }
  else if s[0].remark_creature >= 0 { said = ff_remark(f, s[0].remark_creature, s[0].remark_turn); who = FF_CREATURE_NAMES[s[0].remark_creature]; }
  if f[0].news >= 0 && f[0].news < FF_ROOTS && s[0].time - f[0].news_at < f64(NEWS_TIME) { said = "A ROOT OF THE HEART TREE WAKES"; who = ""; }
  if f[0].news == FF_NEWS_HEART && s[0].time - f[0].news_at < f64(HEART_NEWS_TIME) { said = "THE FOREST IS AWAKE, AND IT IS YOURS TO WANDER"; who = "THE HEART TREE BLOOMS"; }
  if said.count > 0 {
    sc := 8.5 * k;
    sw := text_width(said, sc);
    roomw := w - 2 * gutter - 28 * k;
    if sw > roomw { sc = sc * roomw / sw; sw = roomw; }
    ww := hi(sw, text_width(who, 7.5 * k));
    b := Box.{x0 = (w - ww) / 2 - 14 * k, y0 = above - 12 * k - sc - (ifx who.count > 0 then 36 * k else 22 * k), x1 = (w + ww) / 2 + 14 * k, y1 = above - 12 * k};
    plate(s, u, b, 0.82, 1);
    if who.count > 0 { n = draw_text(out, n, who, (w - ww) / 2, b.y0 + 10 * k + 7.5 * k, 7.5 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false); }
    n = draw_text(out, n, said, (w - sw) / 2, b.y1 - 11 * k, sc, GAP, SPACE, ink(k, 0.95, CREAM_R, CREAM_G, CREAM_B), false, false);
    above = b.y0;
    foot_x0 = lo(foot_x0, b.x0);
  }
  // BLOOM (or LIGHT, or TALK): E on a computer, a button on a phone
  near_patch := ff_patch_near(f, you.x, you.z);
  pool := ffm_near_pool(you);
  home := ffh_near(you.x, you.z, f32(FFB_HOME_NEAR)) && !s[0].build[0].open;
  garden := ffg_verb(s, you);
  if s[0].build[0].open {
    n = ffb_hud(s, out, u, n, above - 8 * k);
    above = s[0].build[0].panel.y0; foot_x0 = lo(foot_x0, s[0].build[0].panel.x0);
  }
  if s[0].race[0].making {
    n = ffc_hud(s, out, u, n, above - 8 * k);
    above = s[0].race[0].panel.y0; foot_x0 = lo(foot_x0, s[0].race[0].panel.x0);
  }
  n = ffc_note_hud(s, out, u, n, above);
  if (near_patch >= 0 || s[0].near_creature >= 0 || pool || home || garden != 0) && s[0].air <= f32(FLYING) && !s[0].race[0].making {
    bc := 9 * k;
    // the Old Ring's stones are lit, not bloomed; the mirror pool makes your fairy; at home you build
    verb := ifx near_patch < 0 && s[0].near_creature < 0 then (ifx garden != 0 then ffg_word(garden) else ifx pool then "MIRROR" else "BUILD")
            else ifx near_patch < 0 && ffv_can_invite(s, s[0].near_creature) then (ifx phone(s) then "INVITE" else FFV_INVITE[s[0].near_creature])
            else ifx near_patch < 0 then (ifx phone(s) then "TALK" else FF_TALK_TO[s[0].near_creature])
            else ifx cast(int) FF_PATCH[near_patch * 4 + 3] == FF_OLD_RING then "LIGHT" else "BLOOM";
    if phone(s) {
      bw := hi(text_width(verb, bc) + 40 * k, 120 * k); bh := 46 * k;
      b := Box.{x0 = w - 16 * k - bw, y0 = above - 12 * k - bh, x1 = w - 16 * k, y1 = above - 12 * k};
      s[0].button = b;
      plate(s, u, b, 0.9, ifx s[0].button_on then 3.0f32 else 1.0f32);
      n = draw_text(out, n, verb, (b.x0 + b.x1 - text_width(verb, bc)) / 2, (b.y0 + b.y1 + bc) / 2, bc, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
    } else {
      wide := text_width("E", bc) + 16 * k + text_width(verb, bc);
      x0 := (w - wide) / 2;
      b := Box.{x0 = x0 - 14 * k, y0 = above - 12 * k - bc - 22 * k, x1 = x0 + wide + 14 * k, y1 = above - 12 * k};
      plate(s, u, b, 0.85, 1);
      n = draw_text(out, n, "E", x0, b.y1 - 11 * k, bc, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
      n = draw_text(out, n, verb, x0 + text_width("E", bc) + 16 * k, b.y1 - 11 * k, bc, GAP, SPACE, ink(k, 0.95, CREAM_R, CREAM_G, CREAM_B), false, false);
      above = b.y0; foot_x0 = lo(foot_x0, b.x0);
    }
  }
  // EDIT, top right, for its owner and admins (verse/edit/edit.coax)
  ew := text_width("EDIT", 9 * k) + 32 * k;
  n = redit_hud(s[0].ed[..], out, n, RBox.{x0 = w - gutter - ew, y0 = gutter, x1 = w - gutter, y1 = gutter + 38 * k});
  for i: 0..<s[0].ed[0].plate_n {
    pb := s[0].ed[0].plate_box[i];
    plate(s, u, Box.{x0 = pb.x0, y0 = pb.y0, x1 = pb.x1, y1 = pb.y1}, s[0].ed[0].plate_alpha[i], s[0].ed[0].plate_look[i]);
  }
  if redit_typing(s[0].ed[..]) { tb := redit_type_box(s[0].ed[..]); s[0].field[0] = tb.x0; s[0].field[1] = tb.y0; s[0].field[2] = tb.x1; s[0].field[3] = tb.y1; }
  n = ffq_hud(s, out, u, n);
  if move_on {
    r := 46 * k;
    for i: 0..<32 {
      a0 := f32(i) * f32(TAU) / 32; a1 := f32(i + 1) * f32(TAU) / 32;
      if lit(out, n, ox + cos(a0) * r, oy + sin(a0) * r, ox + cos(a1) * r, oy + sin(a1) * r, 0.8 * k, 0.5, 1.5 * k, CREAM_R, CREAM_G, CREAM_B, 0) { n += 6; }
    }
    kx := ox + pad_x * r; ky := oy - pad_y * r;
    if lit(out, n, kx - 0.01, ky, kx + 0.01, ky, 14 * k, 0.8, 6 * k, GOLD_R, GOLD_G, GOLD_B, 0) { n += 6; }
  }
  // the chat box sits over what is along the bottom only where they would meet
  chat_x1 := 16 * k + lo(400 * k, w * 0.34);
  return ffs_hud(s, out, u, n, ifx phone(s) || chat_x1 + 8 * k > foot_x0 then above else h - 16 * k);
}

FF_TALK_TO :: [5] string.["TALK TO BRAMBLE", "TALK TO PIP", "TALK TO CLOVER", "TALK TO BURDOCK", "TALK TO HOLLOW"];

// The talk, along the bottom: who you talk to, the last thing they said,
// what you said before it, what you are typing, and BYE.
conversation :: (s: [] Fairy, out: [] f32, u: [] f32, at: int) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  gutter := 16 * k;
  pw := lo(w - 2 * gutter, 760 * k);
  x0 := (w - pw) / 2; x1 := x0 + pw;
  cap := 8.5 * k; lead := cap * 2.1;
  c := s[0].talk - 1;
  // the last thing they said, wrapped to at most four lines, and the line you said before it
  said := ""; mine := "";
  last := -1;
  for q: 0..<s[0].line_n { if s[0].line_npc[q] { last = q; } }
  if s[0].waiting { last = s[0].line_n; }
  for q: 0..<s[0].line_n {
    if q == last { said = line_of(s, q); }
    if q < last && !s[0].line_npc[q] { mine = line_of(s, q); }
  }
  inner := pw - 32 * k;
  starts: [5] int; ends: [5] int; lines := 0; from := 0;
  next: [1] int;
  while from < said.count && lines < 4 {
    e := wrap(said, from, inner / cap, GAP, SPACE, false, next[..]);
    starts[lines] = from; ends[lines] = e; lines += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  shown_lines := ifx lines < 1 then 1 else lines;
  mine_h := ifx mine.count > 0 then cap * 0.85 + 16 * k else 0.0f32;
  ph := 30 * k + cap + 10 * k + mine_h + f32(shown_lines) * lead + 12 * k + cap + 26 * k;
  y0 := h - gutter - ph;
  s[0].pane_top = y0;
  plate(s, u, Box.{x0 = x0, y0 = y0, x1 = x1, y1 = h - gutter}, 0.9, 0);
  n := at;
  y := y0 + 18 * k + cap;
  n = draw_text(out, n, FF_CREATURE_NAMES[c], x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  // BYE, top right of the pane
  bw := text_width("BYE", 8 * k) + 28 * k;
  bb := Box.{x0 = x1 - 10 * k - bw, y0 = y0 + 8 * k, x1 = x1 - 10 * k, y1 = y0 + 8 * k + 34 * k};
  s[0].bye_button = bb;
  plate(s, u, bb, 0.85, ifx s[0].talk_finger_on then 3.0f32 else 1.0f32);
  n = draw_text(out, n, "BYE", bb.x0 + 14 * k, bb.y1 - 13 * k, 8 * k, GAP, SPACE, ink(k, 0.95, GOLD_R, GOLD_G, GOLD_B), false, false);
  y += 10 * k;
  if mine.count > 0 {
    mc := cap * 0.85;
    y += mc + 12 * k;
    // what you said, cut to the pane (the answer sits a little below it)
    shown := mine; tw := text_width("YOU · ", mc) + text_width(shown, mc);
    while tw > inner && shown.count > 1 { shown = shown[0..<shown.count - 1]; tw = text_width("YOU · ", mc) + text_width(shown, mc); }
    n = draw_text(out, n, "YOU · ", x0 + 16 * k, y, mc, GAP, SPACE, ink(k, 0.8, GOLD_R, GOLD_G, GOLD_B), false, false);
    n = draw_text(out, n, shown, x0 + 16 * k + text_width("YOU · ", mc), y, mc, GAP, SPACE, ink(k, 0.7, CREAM_R, CREAM_G, CREAM_B), false, false);
  }
  if mine.count > 0 { y += 4 * k; }
  for q: 0..<shown_lines {
    y += lead;
    if s[0].waiting && q == 0 {
      dots := ifx (cast(int) (s[0].time * 3)) % 3 == 0 then "." else ifx (cast(int) (s[0].time * 3)) % 3 == 1 then ". ." else ". . .";
      n = draw_text(out, n, dots, x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.7, CREAM_R, CREAM_G, CREAM_B), false, false);
    } else if q < lines && ends[q] > starts[q] {
      n = draw_text(out, n, said[starts[q]..<ends[q]], x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, CREAM_R, CREAM_G, CREAM_B), false, false);
    }
  }
  // what you type, or how to
  y += 12 * k + cap + 4 * k;
  s[0].field[0] = x0 + 12 * k; s[0].field[1] = y - cap - 10 * k; s[0].field[2] = x1 - 12 * k; s[0].field[3] = y + 10 * k;
  if s[0].typed_n > 0 {
    typed := typed_text(s);
    tw := text_width(typed, cap);
    // the end of a long line stays in view
    shown := typed; skip := 0;
    while tw > inner - 2 * cap && skip < typed.count { skip += 1; while skip < typed.count && (typed[skip] & 0xC0) == 0x80 { skip += 1; } shown = typed[skip..<typed.count]; tw = text_width(shown, cap); }
    n = draw_text(out, n, shown, x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, 1, 1, 1), false, false);
    cx := x0 + 16 * k + tw + 3 * k;
    if (cast(int) (s[0].time * 2)) % 2 == 0 && lit(out, n, cx, y, cx, y - cap, 0.6 * k, 0.9, 1.2 * k, 1, 1, 1, 0) { n += 6; }
  } else if !s[0].waiting {
    help := ifx phone(s) then "TYPE TO SAY SOMETHING" else "TYPE TO SAY SOMETHING · ENTER SAYS IT · ESC ENDS";
    n = draw_text(out, n, help, x0 + 16 * k, y, cap * 0.85, GAP, SPACE, ink(k, 0.6, CREAM_R, CREAM_G, CREAM_B), false, false);
  }
  return n;
}

// ---- the frame

// What the face tells the page about the stream before the frame: your
// medium, the stream's draw and the lily pads.
fairy_water :: (s: [] Fairy, medium: int, vertices: int, patch_n: int, pads: [] f32, count: int) #export_c {
  s[0].water = medium;
  s[0].water_vertices = vertices; s[0].water_patches = patch_n;
  n := count;
  if n * 8 > pads.count { n = pads.count / 8; }
  if n > 7 { n = 7; }
  for i: 0..<n * 8 { s[0].pads[i] = pads[i]; }
  s[0].pad_n = n;
}

fairy_golden :: (s: [] Fairy, on: bool) #export_c { s[0].golden = on; }

// After the player moved: your feet at (fx, fy, fz) on the flat floor, facing
// face, doing act (player.coax Act); air is how high you fly over the
// ground, flap your wings' phase. Lays out the scene, fills the uniforms and
// the HUD, and returns the vertex count.
fairy_frame :: (s: [] Fairy, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool,
                fx: f32, fy: f32, fz: f32, face: f32, act: int, vx: f32, vz: f32, air: f32, flap: f32,
                move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32) -> int #export_c {
  if !s[0].started { fairy_start(s); }
  if u.count < UNIFORM_FLOATS { return 0; }
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  s[0].time += f64(t);
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5);
  redit_start(s[0].ed[..], "fairy-forest");
  redit_step(s[0].ed[..], f32(s[0].time), width, height, dpr);
  feet := v3(fx, fy, fz);
  if !finite3(feet) { feet = s[0].feet; }
  s[0].face = face; s[0].act = act;
  s[0].air = ifx finite(air) then hi(air, 0) else 0.0f32;
  speed := sqrt(vx * vx + vz * vz);
  if finite(speed) { s[0].stride += speed * t / 1.6; }
  shown := add(v3(feet.x, 0, feet.z), v3(0, ground_at(s, feet.x, feet.z) + feet.y, 0));
  s[0].feet = shown;
  ffq_step(s);
  play(s, shown);
  ffb_step(s);
  ffc_step(s);
  if s[0].waiting {
    s[0].waited += t;
    if s[0].waited > f32(ANSWER_WAIT) { s[0].ask_n = 0; fairy_answer(s, "0\n"); }
  }

  shot := camera_frame(s, shown, vx, vz, t);

  for k: 0..<5 { s[0].counts[k] = 0; }
  s[0].shadow_n = 0; s[0].plate_n = 0;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  s[0].mine = true;
  body := ffl_part(s[0].life[..], FFL_BODY);
  ups := FFL_BODY_UP; acrosses := FFL_BODY_ACROSS;
  s[0].fig_on = true; s[0].fig_at = shown; s[0].fig_up = ups[body]; s[0].fig_across = acrosses[body];
  fairy_figure(s, u, shown, face, s[0].stride, act, s[0].air, flap);
  s[0].fig_on = false;
  s[0].mine = false;
  if ffh_near(shot.eye.x, shot.eye.z, 48) { ffm_pool(s); ffg_draw(s); }
  ffb_home(s, shot.eye);
  ffv_draw(s, u, shot.eye);
  if redit_row_on(s[0].ed[..], "sparkles") { sparkle(s, shown, face, speed > 0.6 || s[0].air > 0.2, t); } else { s[0].spark_next = 0; for i: 0..<18 * 4 { s[0].sparks[i] = 0; } }
  creatures(s, u, shown);
  heart(s, u);
  patches(s);
  props(s);
  thornfall(s, shot.eye);
  old_ring(s, u, shot.eye);
  heart_bloom(s);
  trees(s, u, shot.eye);
  if redit_row_on(s[0].ed[..], "ridges") { ridges(s); }
  ferns(s, shot.eye);
  ffc_draw(s, shot.eye);
  ffs_others(s, u, shown);   // last: if the shapes run out, they go first
  ph := phone(s);
  for kind: 0..<5 {
    d := kind * 4;
    s[0].draws[d] = 0;
    s[0].draws[d + 1] = cast(u32) SHAPE_VERTICES[kind];
    s[0].draws[d + 2] = cast(u32) (ifx kind == 0 then 0 else CELLS * CELLS + SLOT_AT[kind]);
    s[0].draws[d + 3] = cast(u32) (ifx kind == 0 then CELLS * CELLS else s[0].counts[kind]);
  }
  side := ifx ph then GRASS_PATCHES_PHONE else GRASS_PATCHES;
  blades := ifx ph then GRASS_BLADES_PHONE else GRASS_BLADES;
  g := GRASS_DRAW * 4;
  s[0].draws[g] = 0; s[0].draws[g + 1] = cast(u32) (blades * 3);
  s[0].draws[g + 2] = cast(u32) (CELLS * CELLS + OBJECTS); s[0].draws[g + 3] = cast(u32) (side * side);
  wd := WATER_DRAW * 4;
  s[0].draws[wd] = 0; s[0].draws[wd + 1] = cast(u32) s[0].water_vertices; s[0].draws[wd + 2] = 0; s[0].draws[wd + 3] = cast(u32) s[0].water_patches;

  u[0] = width; u[1] = height; u[2] = effect_time(s); u[3] = 1; u[4] = ifx still || s[0].golden then 1.0f32 else 0.0f32;
  u[6] = s[0].dpr;
  view(shot, width, height, u, U_VIEW);
  u[U_EYE] = shot.eye.x; u[U_EYE + 1] = shot.eye.y; u[U_EYE + 2] = shot.eye.z;
  u[U_EYE + 3] = ifx ph then 0.006f32 * 1.25f32 else 0.006f32;   // the far haze's density (fairy.wgsl hazed: none nearer than 48 m)
  sun := unit_or(v3(0.5, 0.62, 0.45), v3(0, 1, 0));
  u[U_SUN] = sun.x; u[U_SUN + 1] = sun.y; u[U_SUN + 2] = sun.z; u[U_SUN + 3] = ifx ph then 1.0f32 else 0.0f32;
  u[U_GROUND] = f32(CELLS); u[U_GROUND + 1] = f32(FF_CELL); u[U_GROUND + 2] = f32(FF_EDGE); u[U_GROUND + 3] = f32(FF_EDGE);
  // the grass round the camera's ground point, patch-snapped so it doesn't swim
  // the grass round your feet (the camera's look point is up in the air when you fly), and none once the eye is 30 m up
  gx := floor(shown.x / 2) * 2 - f32(side); gz := floor(shown.z / 2) * 2 - f32(side);
  if shot.eye.y - ground_at(s, shot.eye.x, shot.eye.z) > 30 || !redit_row_on(s[0].ed[..], "grass") { s[0].draws[g + 3] = 0; }
  u[U_GRASS] = gx; u[U_GRASS + 1] = gz; u[U_GRASS + 2] = f32(side); u[U_GRASS + 3] = f32(blades);
  u[U_GRASS2] = f32(side) - 1; u[U_GRASS2 + 1] = f32(FF_LEVEL); u[U_GRASS2 + 2] = f32(FF_PATH_HALF); u[U_GRASS2 + 3] = shown.x;
  // you part the grass where you stand
  u[U_SUN + 3] = u[U_SUN + 3];
  paths(u);
  blooms(s, u);
  n := hud(s, out, u, move_on, ox, oy, pad_x, pad_y, shown);
  u[5] = f32(s[0].plate_n);
  u[7] = shown.z;
  return n;
}

fairy_draws :: (s: [] Fairy) -> int #export_c { return DRAWS; }
fairy_store_cap :: (k: int) -> int #export_c {
  if k == 0 { return FF_GROUND_POINTS * 4; }
  return OBJECTS * OBJECT_FLOATS * 4;
}

// ---- checks

#test "the uniforms and the shape slots line up with fairy.wgsl's" {
  #assert UNIFORM_FLOATS % 4 == 0;
  #assert U_SHADOW == 44 && U_PATH == 108 && U_PATH_INFO == 236 && U_BLOOM == 240 && U_BLOOM_INFO == 336 && U_PLATE == 340 && U_WATER == 468;
  #assert SLOT_AT[4] + SLOTS[4] == OBJECTS;
  for k: 2..<5 { #assert SLOT_AT[k] == SLOT_AT[k - 1] + SLOTS[k - 1]; }
  #assert GRASS_BLADES * 3 <= 1024 && SHAPE_VERTICES[2] <= 1024;
}

#test "a frame lays the valley out within its slots and sees you" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  nv := 0;
  n := fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0.7, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert n > 0 && n <= MAX_VERTICES;
  #assert g[0].tree_n > 100;
  for k: 1..<5 { #assert g[0].counts[k] < SLOTS[k]; }
  #assert u[5] >= 2 && u[0] == 1280;
  y := ground_at(g[..], f32(FF_SPAWN_X), f32(FF_SPAWN_Z));
  p := project(u[..], v3(f32(FF_SPAWN_X), y + 1.2, f32(FF_SPAWN_Z)), 1280, 800);
  #assert p.x > 0 && p.x < 1280 && p.y > 0 && p.y < 800;
  // the triangles a frame draws stay inside a phone's budget
  tris := CELLS * CELLS * 2;
  for k: 1..<5 { tris += g[0].counts[k] * SHAPE_VERTICES[k] / 3; }
  tris += GRASS_PATCHES_PHONE * GRASS_PATCHES_PHONE * GRASS_BLADES_PHONE;
  #assert tris < 700000;
}

#test "E at the first flower blooms it; the hedgehog's three patches make it happy and wake a root" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  nv := 0;
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert ff_patch_near(g[0].forest[..], g[0].feet.x, g[0].feet.z) == 0;
  #assert fairy_key(g[..], 'e', 0);
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].forest[0].bloomed[0] && u[U_BLOOM_INFO] == 2;   // the home's and the flower's
  for i: 1..<4 {
    pressed := fairy_key(g[..], 'e', 0);
    for k: 0..<3 { nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, FF_PATCH[i * 4], 0, FF_PATCH[i * 4 + 1], 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  }
  #assert ff_mood(g[0].forest[..], 0) == MOOD_HAPPY;
  for k: 0..<30 { nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, -30, 0, -33, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert g[0].forest[0].awake[0] && g[0].near_creature == 0;
  #assert ff_restored(g[0].forest[..], -30, -32, g[0].time) == 1;
}

#test "a phone taps BLOOM; a tap elsewhere is the sticks'" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  nv := 0;
  g[0].touch = true;
  nv = fairy_frame(g[..], out[..], u[..], 1170, 2532, 3, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  b := g[0].button;
  #assert b.x1 > b.x0 && b.x1 <= 1170 && b.x0 >= 0;
  #assert !fairy_pointer(g[..], 20, 400, 0, 1, 3);
  #assert fairy_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 1, 4);
  #assert fairy_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 2, 1, 4);
  nv = fairy_frame(g[..], out[..], u[..], 1170, 2532, 3, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].forest[0].bloomed[0];
}

#test "E by a creature talks to it: you type, Enter asks, the answer shows, Esc ends; a click on it talks too" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  nv := 0;
  // beside the hedgehog, no patch at hand
  hx := FF_CREATURE[0] - 1.5; hz := FF_CREATURE[1] + 1.5;
  for k: 0..<2 { nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, hx, 0, hz, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert g[0].near_creature == 0 && ff_patch_near(g[0].forest[..], hx, hz) < 0;
  fairy_facts(g[..], "tab=x\nnow=1730000000000\nplayer=");
  #assert fairy_key(g[..], 'e', 0);
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, hx, 0, hz, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert fairy_talking(g[..]) && fairy_wants_text(g[..]) && g[0].line_n == 1 && line_of(g[..], 0) == FF_SAYS[0];
  #assert g[0].pane_top > 0 && g[0].bye_button.x1 > g[0].bye_button.x0 && g[0].button.x1 == 0;
  // E and Space type while you talk; they neither bloom nor flap
  #assert fairy_key(g[..], 'H', 1) && fairy_key(g[..], 'i', 0) && fairy_key(g[..], ' ', 0) && g[0].taps == 0;
  fairy_typed(g[..], "there");
  #assert typed_text(g[..]) == "Hi there";
  #assert fairy_key(g[..], KEY_ENTER, 0);
  #assert fairy_ask(g[..]) > 0 && g[0].waiting && g[0].typed_n == 0;
  body := cast(string) g[0].ask[0..<fairy_ask(g[..])];
  #assert ff_has(body, "\"name\":\"Bramble\"") && ff_has(body, "\"visit\":\"1730000000000\"") && ff_has(body, "\"question\":\"Hi there\"");
  fairy_ask_sent(g[..]);
  fairy_answer(g[..], "200\n{\"text\":\"Oh, a fairy! Will you wake my flowers?\",\"model\":\"m\"}");
  #assert !g[0].waiting && g[0].line_n == 3 && line_of(g[..], 2) == "Oh, a fairy! Will you wake my flowers?";
  // no answer: what is on its mind again
  fairy_typed(g[..], "Hello?\n");
  #assert g[0].waiting;
  fairy_answer(g[..], "503\n{}");
  #assert line_of(g[..], g[0].line_n - 1) == FF_SAYS[0];
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, hx, 0, hz, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert fairy_key(g[..], KEY_ESCAPE, 0) && !fairy_talking(g[..]);
  // a click on the hedgehog talks to it
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, hx, 0, hz, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].seen_on[0];
  cx := g[0].seen_x[0]; cy := g[0].seen_y[0];
  #assert fairy_pointer(g[..], cx, cy, 0, 0, 1) && fairy_pointer(g[..], cx, cy, 2, 0, 1);
  #assert fairy_talking(g[..]) && g[0].talk == 1;
  // BYE ends it
  nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, hx, 0, hz, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  b := g[0].bye_button;
  #assert fairy_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 0, 2) && fairy_pointer(g[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 2, 0, 2);
  #assert !fairy_talking(g[..]);
}

#test "flying, the BLOOM prompt hides and E waits until you land" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  nv := fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 3, f32(FF_SPAWN_Z), 0, 0, 0, 0, 3, 0, false, 0, 0, 0, 0);
  #assert ff_patch_near(g[0].forest[..], g[0].feet.x, g[0].feet.z) == 0;
  g[0].touch = true;
  nv = fairy_frame(g[..], out[..], u[..], 1170, 2532, 3, 1.0 / 60.0, false, f32(FF_SPAWN_X), 3, f32(FF_SPAWN_Z), 0, 0, 0, 0, 3, 0, false, 0, 0, 0, 0);
  #assert g[0].button.x1 == 0;
  #assert fairy_key(g[..], 'e', 0);
  nv = fairy_frame(g[..], out[..], u[..], 1170, 2532, 3, 1.0 / 60.0, false, f32(FF_SPAWN_X), 3, f32(FF_SPAWN_Z), 0, 0, 0, 0, 3, 0, false, 0, 0, 0, 0);
  #assert !g[0].forest[0].bloomed[0];
  // landed: the button is back
  nv = fairy_frame(g[..], out[..], u[..], 1170, 2532, 3, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].button.x1 > g[0].button.x0;
}

// What the player library (verse/player.coax) stands on: a wall whose top is
// within STEP_UP (0.55 m) of your feet and under you. Its own tests cover the
// landing and the pushing out; these check the boxes are where the trees are.
top_under :: (g: [] Fairy, x: f32, z: f32, feet: f32) -> f32 {
  out := 0.0f32;
  for i: 0..<g[0].wall_n {
    k := i * 6;
    w := g[0].walls[k..<k + 6];
    if x < w[0] || x > w[3] || z < w[2] || z > w[5] { continue; }
    if w[4] <= feet + 0.55 && w[4] > out { out = w[4]; }
  }
  return out;
}
#test "trunks are solid and crowns are floors; the heart tree's canopy and the stones too" {
  g: [1] Fairy;
  fairy_start(g[..]);
  #assert g[0].wall_n > g[0].tree_n * 2 + 20 && g[0].wall_n <= WALLS;
  for t: 0..<g[0].tree_n {
    k := t * TREE_FLOATS;
    x := g[0].trees[k]; z := g[0].trees[k + 1]; h := g[0].trees[k + 2]; r := g[0].trees[k + 3];
    // over its crown you stand on its top, which is inside the drawn blob (its top at h + 1.5 r)
    #assert top_under(g[..], x + r * 0.5, z - r * 0.5, h + r * 1.42) >= h + r * 1.42 - 0.001;   // (or a neighbour's crown just over it)
    #assert h + r * 1.42 < h + r * 0.55 + r * 0.95;
    // under it, on the ground, nothing holds you up but the ground
    #assert top_under(g[..], x + r * 0.5, z - r * 0.5, 0) == 0 || abs(x) < 20;
  }
  #assert top_under(g[..], 0, 0, 30) > 20;      // the heart tree's canopy
  #assert top_under(g[..], 0, 0, 1) == 0;       // its trunk is a wall, not a step
  st := heart_stone(g[..], 1);
  if st.ok { #assert near(top_under(g[..], st.x, st.z, 0.3), 0.6, 0.001); }
}

#test "a kept place in Fairy Forest: open ground stays, the stream or a trunk moves you clear" {
  g: [1] Fairy;
  fairy_start(g[..]);
  sx := f32(FF_SPAWN_X); sz := f32(FF_SPAWN_Z);
  #assert fairy_place_open(g[..], sx, sz);
  q := fairy_place_fix(g[..], verse_place(sx + 1, 0, sz + 1, 1, 1.5, 0.4, 6, 0, -1, 1000));
  #assert q.x == sx + 1 && q.z == sz + 1;
  t := g[0].trees[0..<2];
  m := fairy_place_fix(g[..], verse_place(t[0], 0, t[1], 0, 0, 0.3, 5, 0, -1, 1000));
  #assert fairy_place_open(g[..], m.x, m.z) && (m.x != t[0] || m.z != t[1]);
  w := fairy_place_fix(g[..], verse_place(f32(FF_POND_X), 0, f32(FF_POND_Z), 0, 0, 0.3, 5, 0, -1, 1000));
  #assert fairy_place_open(g[..], w.x, w.z);
  fairy_place_camera(g[..], q);
  #assert g[0].orbit.yaw == 1.5;
}

// Behind: the camera within 17 degrees of straight behind her, looking down
// from 10 degrees (the orbit rests at 17) to 65, near or far.
#test "from behind, no wing ever crosses her head, at any beat, pitch or distance, in any of the maker's shapes" {
  u: [UNIFORM_FLOATS] f32;
  feet := v3(3, 2, -4);
  face := 0.7f32;
  head := add(feet, v3(0, f32(FAIRY_HEAD), 0));
  hr := f32(FAIRY_HEAD_R) * 1.15;   // the hair and buns round it
  crossings := 0; looks := 0;
  for turn: 1..<4 {
    for pitch_i: 2..<6 {
      for dist_i: 0..<4 {
        o := verse_orbit_start(feet, face);
        o.yaw = o.yaw + (f32(turn) - 2) * 0.3;
        o.pitch = -0.3 + f32(pitch_i) * 0.24;
        z := f32(FREE_NEAR) + f32(dist_i) * 2.5;
        o.want = z; o.zoom = z;
        o.shown = verse_orbit_ray(o).far;
        view(verse_orbit_shot(o), 1280, 800, u[..], U_VIEW);
        hc := project(u[..], head, 1280, 800);
        if hc.x < -1000 { continue; }
        hs := hi(dist2(hc, project(u[..], add(head, v3(0, hr, 0)), 1280, 800)), dist2(hc, project(u[..], add(head, times(v3(-cos(face), 0, sin(face)), hr)), 1280, 800)));
        for b: 0..<9 {
          beat := -1 + f32(b) * 0.25;
          for pair: 0..<3 {
            for side: 0..<4 {
              // both sides, in the jewel's shape and (as made in the maker) the butterfly's and the dragonfly's
              w := fairy_wing_shaped(feet, face, pair, ifx side % 2 == 0 then 1.0f32 else -1.0f32, beat, ifx side < 2 then (turn + pitch_i + b) % 3 else 0);
              c := add(w.root, times(w.along, w.reach * 0.5));
              for k: 0..<24 {
                a := f32(k) * f32(TAU) / 24;
                for ring: 1..<5 {
                  // only where the wing is drawn: inside its pointed outline
                  if abs(sin(a)) * f32(ring) / 4 > wing_half(0.5 + 0.5 * cos(a) * f32(ring) / 4) { continue; }
                  q := add(c, add(times(w.along, cos(a) * w.reach * 0.5 * f32(ring) / 4), times(w.across, sin(a) * w.wide * 0.5 * f32(ring) / 4)));
                  pq := project(u[..], q, 1280, 800);
                  looks += 1;
                  // over the head on screen and nearer the camera than it: the wing would hide her face
                  if dist2(pq, hc) < hs && pq.z < hc.z { crossings += 1; }
                }
              }
            }
          }
        }
      }
    }
  }
  #assert looks > 10000 && crossings == 0;
}
dist2 :: (a: Point, b: Point) -> f32 { dx := a.x - b.x; dy := a.y - b.y; return sqrt(dx * dx + dy * dy); }

#test "trees keep off the trails, the stream and the glades" {
  g: [1] Fairy;
  fairy_start(g[..]);
  nodes := FF_NODE_XZ; links := FF_LINK_AB;
  for t: 0..<g[0].tree_n {
    x := g[0].trees[t * TREE_FLOATS]; z := g[0].trees[t * TREE_FLOATS + 1];
    #assert verse_path_nearest(nodes[..], links[..], x, z).d > f32(FF_PATH_HALF) + 2;
    st := ff_stream_near(x, z);
    #assert st.d > st.half + 2;
  }
  // the stream's bed is under its level, the trails over it
  #assert ground_at(g[..], f32(FF_POND_X), f32(FF_POND_Z)) < f32(FF_LEVEL) - 1;
  #assert ground_at(g[..], f32(FF_SPAWN_X), f32(FF_SPAWN_Z)) > f32(FF_LEVEL) + 0.2;
}

#test "Thornfall and the Old Ring: their patches can be stood at, and a frame there in full bloom stays within its slots" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  fairy_start(g[..]);
  for i: FF_PATCHES - 6..<FF_PATCHES { #assert fairy_place_open(g[..], FF_PATCH[i * 4], FF_PATCH[i * 4 + 1]); }
  for i: 0..<FF_PATCHES { #assert ff_bloom(g[0].forest[..], i, 0.5); }
  nv := 0;
  for at: 0..<2 {
    gl := ifx at == 0 then FF_THORNFALL else FF_OLD_RING;
    x := FF_GLADE[gl * 3]; z := FF_GLADE[gl * 3 + 1] + 4;
    for k: 0..<60 { nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, x, 0, z, 3.1, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
    #assert g[0].counts[1] < SLOTS[1];
    #assert g[0].counts[2] < SLOTS[2];
    #assert g[0].counts[3] < SLOTS[3];
    #assert g[0].counts[4] < SLOTS[4];
    #assert nv > 0 && nv <= MAX_VERTICES;
  }
  #assert g[0].forest[0].heart && ff_roots_awake(g[0].forest[..]) == FF_ROOTS;
  // the heart tree in bloom, seen from its clearing
  for k: 0..<3 { nv = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, 0, 0, -14, 3.1, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  for k: 1..<5 { #assert g[0].counts[k] < SLOTS[k]; }
}

#test "EDIT for its owner and admins only; the board switches the grass and the ridges off, SETTINGS flight" {
  g: [1] Fairy;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0.7, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].ed[0].req_ready && cast(string) g[0].ed[0].req_url[0..<g[0].ed[0].req_url_n] == "/api/playtest/realms/fairy-forest";
  spheres := g[0].counts[SHAPE_SPHERE];
  #assert g[0].draws[GRASS_DRAW * 4 + 3] > 0 && fairy_may_fly(g[..]);
  redit_requested(g[0].ed[..], 5);
  used := redit_message(g[0].ed[..], HTTP_KIND + 5, "200\nrealm fairy-forest\nrole visitor\nowner 0\ntool fly 0\nrow sparkles 1 Sparkles\nrow grass 0 Grass\nrow ridges 0 Ridges\n");
  n = fairy_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0.7, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].draws[GRASS_DRAW * 4 + 3] == 0 && g[0].counts[SHAPE_SPHERE] == spheres - RIDGES;
  #assert !fairy_may_fly(g[..]) && !g[0].ed[0].shown[RB_EDIT];   // a visitor: no flight, no EDIT
  a: [1] Fairy;
  n = fairy_frame(a[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0.7, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  redit_requested(a[0].ed[..], 6);
  used = redit_message(a[0].ed[..], HTTP_KIND + 6, "200\nrealm fairy-forest\nrole owner\nowner 1\ntool fly 0\nrow grass 1 Grass\nwaiting 0\n");
  n = fairy_frame(a[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, f32(FF_SPAWN_X), 0, f32(FF_SPAWN_Z), 0.7, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert a[0].ed[0].shown[RB_EDIT] && fairy_may_fly(a[..]);   // its owner flies, settings or not
  e := a[0].ed[0].boxes[RB_EDIT];
  #assert e.x1 <= 1280 && e.x0 > 1000;
  #assert fairy_pointer(a[..], (e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 0, 0, 1) && fairy_pointer(a[..], (e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 2, 0, 1);
  #assert a[0].ed[0].pane == REDIT_BOARD;
}
