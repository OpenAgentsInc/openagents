// /feed: the phone's shared controller and components, with browser effects.
#load "../shared/nostr-feed-view.coax";
#load "../../coax/native/relay-read-queue.coax";
#load "../../coax/web/socket.coax";
#load "../../components/backend/dom.coax";
#load "../../coax/web/api/account-settings-wire.coax";

WfRecord :: struct {kind:int;from:int;n:int;sequence:int;}
FeedWeb :: struct {
 ready:bool;dirty:bool=true;time:f32;feed:[1]NostrFeed;
 queues:[6]NrQueue;records:[6][64]WfRecord;data:[6][NRQ_BYTES]u8;physical:[6]int;logical:[6]int;
 pipe:[1]Pipe;inbox:[65536]u8;service:[NRR_WIRE]u8;
 asking:bool;http:int;http_n:int;http_bad:bool;http_body:[16384]u8;path:[64]u8;path_n:int;http_at:f32;auth:int;account:[64]u8;account_n:int;
 go:[64]u8;go_n:int;clip:[NFEED_CONTENT]u8;clip_n:int;
 sets:[MF_COUNT]AfSettings;settings:[1]AccountSettings;tree:[1]Tree;ui:[1]Ui;dom:[1]Dom;doc:[1]MdDoc;css:[32768]u8;
}

#test "browser observation ACKs use the same ledger and compact complete payloads" {
 s:[1]FeedWeb;#assert nrq_open(s[0].queues[0..<1],1);
 wf_enqueue(s[..],0,1,"abc");wf_enqueue(s[..],0,2,"defgh");q:=s[0].queues[0..<1];
 #assert nrq_poll(q,0)==1 && wf_ack(s[..],0,1)==2 && q[0].bytes==5;
 first:=s[0].records[0][q[0].head];#assert first.from==0 && first.n==5 && cast(string)s[0].data[0][0..<5]=="defgh";
 #assert wf_ack(s[..],0,3)<0;
}
#test "expired or refused account settings retire the browser relay scope" {
 for status:[2]int.[401,403] {
  s:[1]FeedWeb;s[0].auth=1;s[0].http=2;s[0].feed[0].active=true;s[0].feed[0].configured=true;s[0].feed[0].n=1;
  wf_http_done(s[..],status);#assert s[0].auth==2 && !s[0].feed[0].active && !s[0].feed[0].configured && s[0].feed[0].n==0 && s[0].feed[0].reset_all;
 }
 s:[1]FeedWeb;s[0].auth=1;s[0].http=1;s[0].feed[0].active=true;s[0].feed[0].configured=true;s[0].http_n=nfeed_copy(s[0].http_body[..],"{}");
 wf_http_done(s[..],200);#assert s[0].auth==2 && !s[0].feed[0].active && !s[0].feed[0].configured;
}
wf_enqueue :: (s:[]FeedWeb,slot:int,kind:int,payload:string) {
 q:=s[0].queues[slot..<slot+1];at:=(q[0].head+q[0].count)%64;from:=q[0].bytes;seq:=nrq_push(q,payload.count);
 if seq<0 {wf_finish(s,slot,5);return;}
 for c,i:payload {s[0].data[slot][from+i]=c;}s[0].records[slot][at]=WfRecord.{kind=kind,from=from,n=payload.count,sequence=seq};
}
wf_detach :: (s:[]FeedWeb,slot:int) {id:=s[0].physical[slot];if id>=0 && id<6 {s[0].logical[id]= -1;_=pipe_close(s[0].pipe[..],id);}s[0].physical[slot]= -1;}
wf_finish :: (s:[]FeedWeb,slot:int,kind:int) {
 q:=s[0].queues[slot..<slot+1];at:=(q[0].head+q[0].count)%64;seq:=nrq_terminal(q,0);
 if seq>0 {s[0].records[slot][at]=WfRecord.{kind=kind,from=q[0].bytes,n=0,sequence=seq};}wf_detach(s,slot);s[0].dirty=true;
}
wf_ack :: (s:[]FeedWeb,slot:int,ack:int)->int {
 q:=s[0].queues[slot..<slot+1];before:=q[0].bytes;next:=nrq_poll(q,ack);if next<0 {return -1;}removed:=before-q[0].bytes;
 if removed>0 {for i:0..<q[0].bytes {s[0].data[slot][i]=s[0].data[slot][i+removed];}for i:0..<q[0].count {at:=(q[0].head+i)%64;s[0].records[slot][at].from-=removed;}}
 return next;
}
wf_poll :: (s:[]FeedWeb,slot:int,generation:int,ack:int)->int {
 q:=s[0].queues[slot..<slot+1];if generation!=q[0].generation {return -1;}next:=wf_ack(s,slot,ack);if next<0 {return -1;}
 if next==0 {return nrr_observation(slot,generation,ack,"idle","",s[0].service[..]);}
 r:=s[0].records[slot][q[0].head];if r.sequence!=next {return -1;}
 return nrr_observation(slot,generation,next,NRR_KINDS[r.kind-1],cast(string)s[0].data[slot][r.from..<r.from+r.n],s[0].service[..]);
}
wf_opened :: (s:[]FeedWeb,slot:int,id:int) #export_c #effects(all) {
 if slot<0 || slot>=6 {return;}if id<0 || id>=6 {wf_finish(s,slot,7);return;}s[0].physical[slot]=id;s[0].logical[id]=slot;
}
wf_socket :: (s:[]FeedWeb,kind:int,raw:string) {
 e:=socket_event_limit(kind,6);if e.id<0 {return;}slot:=s[0].logical[e.id];if slot<0 || slot>=6 || s[0].physical[slot]!=e.id || !s[0].queues[slot].live {return;}
 if e.event==SOCKET_OPENED {wf_enqueue(s,slot,2,"");}
 else if e.event==SOCKET_FRAME {if raw.count>NRR_FRAME || !js_utf8(raw) {wf_finish(s,slot,7);}else {wf_enqueue(s,slot,3,raw);}}
 else {wf_finish(s,slot,ifx e.event==SOCKET_ERROR then 7 else 4);}s[0].dirty=true;
}
wf_service :: (s:[]FeedWeb,now:int) {
 f:=s[0].feed[..];if f[0].action!=NRR_OP {return;}q:[1]NrrRequest;valid:=nrr_read(cast(string)f[0].body[0..<f[0].nb],q[..]);f[0].action=0;n:= -1;
 if valid {
  i:=q[0].slot;gen:=q[0].generation;payload:=cast(string)q[0].payload[0..<q[0].n];ledger:=s[0].queues[i..<i+1];action:=q[0].action;
  if action==5 {for slot:0..<6 {wf_detach(s,slot);s[0].queues[slot]=NrQueue.{};}n=0;}
  else if action==6 {n=nrr_clock_record(i,gen,now,s[0].service[..]);}
  else if action==1 {
   if gen!=ledger[0].generation {wf_detach(s,i);if nrq_open(ledger,gen) {wf_enqueue(s,i,1,"");_=pipe_put(s[0].pipe[..],PIPE_OPEN,i,payload);}}
   n=wf_poll(s,i,gen,ledger[0].ack);
  }
  else if gen==ledger[0].generation {
   if action==3 {n=wf_poll(s,i,gen,q[0].sequence);}
   else if action==4 {if wf_ack(s,i,q[0].sequence)>=0 {wf_finish(s,i,4);n=nrr_observation(i,gen,q[0].sequence,"closed","",s[0].service[..]);}}
   else if action==2 && ledger[0].live && s[0].physical[i]>=0 {if pipe_send(s[0].pipe[..],s[0].physical[i],payload) {n=nrr_observation(i,gen,ledger[0].ack,"idle","",s[0].service[..]);}}
  }
 }
 _=nfeed_reply(f,ifx n>=0 then cast(string)s[0].service[0..<n] else "",n<0);s[0].dirty=true;
}
wf_http :: (s:[]FeedWeb,purpose:int) {s[0].http=purpose;s[0].http_n=0;s[0].http_bad=false;s[0].asking=true;s[0].path_n=nfeed_copy(s[0].path[..],ifx purpose==1 then "/api/auth/account" else "/api/auth/settings/v1");}
wf_http_done :: (s:[]FeedWeb,status:int) {
 purpose:=s[0].http;s[0].http=0;s[0].http_at=s[0].time+10;s[0].dirty=true;
 if status!=200 || s[0].http_bad {if status==401 || status==403 {s[0].auth=2;nfeed_clear(s[0].feed[..]);}else {if s[0].auth!=1 {s[0].auth=3;}}return;}
 raw:=cast(string)s[0].http_body[0..<s[0].http_n];
 if purpose==1 {
  d:[1]Jv;nodes:[256]JvNode;key:[64]u8;if !jv_parse(d[..],raw,nodes[..]) {s[0].auth=3;nfeed_clear(s[0].feed[..]);return;}n:=js_string(d[0],jv_get(d[0],0,"account"),key[..]);if n<1 {s[0].auth=2;nfeed_clear(s[0].feed[..]);return;}
  if n!=s[0].account_n || cast(string)key[0..<n]!=cast(string)s[0].account[0..<s[0].account_n] {nfeed_clear(s[0].feed[..]);s[0].account=key;s[0].account_n=n;}
  s[0].auth=1;wf_http(s,2);return;
 }
 if !asw_read(raw,s[0].settings[..]) {s[0].auth=3;nfeed_clear(s[0].feed[..]);return;}urls:[6]string;for i:0..<s[0].settings[0].relays_n {urls[i]=asw_relay(s[0].settings[..],i);}
 if !nfeed_configure(s[0].feed[..],urls[0..<s[0].settings[0].relays_n]) {s[0].auth=3;}
}
wf_frame :: (s:[]FeedWeb,dt:f32,reduced:bool,now:int)->int #export_c #effects(all) {
 if !s[0].ready {s[0].ready=true;_=mono_frames(s[0].sets[..]);for i:0..<6 {s[0].physical[i]= -1;s[0].logical[i]= -1;}wf_http(s,1);}
 if dt>0 && dt<1 {s[0].time+=dt;}if s[0].http==0 && s[0].time>=s[0].http_at && !s[0].feed[0].filters {wf_http(s,1);}
 if nfeed_tick(s[0].feed[..],dt) {s[0].dirty=true;}wf_service(s,now);
 if !s[0].dirty && !s[0].ui[0].busy {return 0;}t:=s[0].tree[..];u:=s[0].ui[..];d:=s[0].dom[..];
 if !d[0].styled {n:=mono_css(s[0].css[..]);n=mc(s[0].css[..],n,".feed-page{max-width:680px;margin:auto;padding:24px;display:flex;flex-direction:column;gap:14px}.feed-page>header{display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--ground);z-index:2}.feed-page .row{text-transform:none;letter-spacing:normal;text-align:left}.feed-page .msg-ai{padding-bottom:20px;border-bottom:1px solid var(--line)}.feed-filters{display:flex;flex-direction:column;gap:12px}.feed-page .remote-image{width:40px;height:40px;border-radius:50%}");dm_style(d,cast(string)s[0].css[0..<n]);}
 ui_begin(u,s[0].time,reduced);tr_begin(t);_=tr_open(t,"feed.page",TG_MAIN,"feed-page");
 if s[0].auth==1 {nfeed_render(s[0].feed[..],t,u,s[0].doc[..],s[0].settings[0].remote_images);}
 else {_=k_text(t,u,"feed.auth.title",TG_H1,"","Feed");_=k_text(t,u,"feed.auth.note",TG_P,"",ifx s[0].auth==2 then "Log in to use your saved relays" else ifx s[0].auth==3 then "Account unavailable" else "Loading…");if s[0].auth==2 {x:=k_link(t,"feed.login","Log in");tr_attr(t,x,AT_HREF,"/login");}}
 tr_close(t);ui_end(u);s[0].dirty=false;return dm_flush(d,t,s[0].sets[..]);
}
wf_event :: (s:[]FeedWeb,kind:int,slot:int,n:int) #export_c #effects(all) {
 if n<0 || n>65536 {return;}raw:=cast(string)s[0].inbox[0..<n];if kind>=SOCKET_KIND && kind<SOCKET_KIND+24 {wf_socket(s,kind,raw);return;}
 if kind==4 && s[0].http>0 {if s[0].http_n+n>16384 {s[0].http_bad=true;}else {for c,i:raw {s[0].http_body[s[0].http_n+i]=c;}s[0].http_n+=n;}return;}
 if kind==5 && s[0].http>0 {wf_http_done(s,slot);return;}
 id:=dm_slot_id(s[0].dom[..],slot);
 if kind==2 {_=nfeed_edit(s[0].feed[..],id,raw);}
 if kind==1 {
  if id=="nav.toggle" || id=="feed.relays.settings" {s[0].go_n=nfeed_copy(s[0].go[..],ifx id=="nav.toggle" then "/" else "/settings");}
  else if !nfeed_press(s[0].feed[..],id) {
   for i:0..<s[0].feed[0].n {a:[96]u8;b:[96]u8;if id==tr_cat(b[..],tr_join(a[..],"feed.note.",i),".copy") {note:=s[0].feed[0].notes[i];s[0].clip_n=nfeed_copy(s[0].clip[..],cast(string)note.content[0..<note.n]);}}
   at:=tr_find(s[0].tree[..],id);copy:=k_code_copy(s[0].tree[..],at);if copy.count>0 {s[0].clip_n=nfeed_copy(s[0].clip[..],copy);}
  }
 }s[0].dirty=true;
}
wf_size :: (s:[]FeedWeb,slot:int,w:f32,h:f32) #export_c #effects(all) {if dm_size(s[0].dom[..],slot,w,h) {s[0].dirty=true;}}
