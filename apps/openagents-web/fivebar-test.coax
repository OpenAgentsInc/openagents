// Checks for the hotbar on the SRD 5e engine (fivebar.coax): every slot of Everglade's bar resolved
// by the engine, the bar's mapping, the real-time seat, and 5E MMO's class bars.
//   coax/bin/coax test --library apps/openagents-web/fivebar-test.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "../../rules/srd/battle.coax";
#load "../../everglade/shared/fivebar.coax";
#load "fivemmo-hotbar.coax";   // 5E MMO's hotbar pictures, by name
#load "everglade-hotbar.coax";  // Everglade's

#test "Short Rest recovery leaves the saved seat and a surrounding running turn intact" {
  b:[1]RsBattle; s:[1]FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO]=rs_monk("You",0,5); rs_place(b[..],FT_HERO,10,10);
  b[0].c[FT_HERO].focus=0; b[0].c[FT_HERO].hp=1; b[0].c[FT_HERO].reacted=true;
  b[0].who=FT_FOE; b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.slot_spent=true; b[0].turn.move_left=7;
  s[0].turn.action=true; s[0].turn.bonus=true;
  #assert rs_short_rest_begin(b[..],s[0].me); rs_tick(b[..],3600);
  #assert b[0].c[FT_HERO].focus==5 && b[0].c[FT_HERO].rest.phase==2 && b[0].c[FT_HERO].reacted;
  b[0].dice[0].fixed=true;
  #assert rs_short_rest_hit_die(b[..],s[0].me).healed>0;
  #assert b[0].who==FT_FOE && b[0].turn.action && b[0].turn.bonus && b[0].turn.slot_spent && b[0].turn.move_left==7;
  #assert s[0].turn.action && s[0].turn.bonus && s[0].open;
}

#test "the existing bar Reaction path interrupts rest only after its actual admitted spell cost" {
  for allowed:0..<2 {
    b:[1]RsBattle; s:[1]FbSeat; ft_field(b[..],s[..],91);
    b[0].c[FT_HERO]=rs_wizard("You",0,3); rs_place(b[..],FT_HERO,10,10);
    // The bar's caller owns the fall trigger; this checks payment and rest state.
    #assert rs_grant_spell(b[0].c[FT_HERO..<FT_HERO+1],SP_FEATHER_FALL);
    b[0].c[FT_HERO].speech_blocked=allowed==0;
    #assert rs_short_rest_begin(b[..],s[0].me);
    slots:=b[0].c[FT_HERO].slots[1];
    #assert fb_seat_use(b[..],s[..],fb_spell(SP_FEATHER_FALL,1,FB_SELF),-1,10,10,FT_HERO)==(allowed==1);
    #assert b[0].c[FT_HERO].rest.phase==(ifx allowed==1 then 0 else 1);
    #assert b[0].c[FT_HERO].slots[1]==slots-allowed && b[0].c[FT_HERO].reacted==(allowed==1);
  }
}

#test "saved-seat Patient Defense loses Dodge when Restrained even if freed before another roll" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO] = rs_monk("You",0,3); rs_place(b[..],FT_HERO,10,10);
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_PATIENT,"PATIENT DEFENSE","patient-defense"),FT_FOE,10,10,FT_ALLY);
  #assert b[0].c[FT_HERO].dodging && b[0].c[FT_HERO].focus == 2 && s[0].turn.bonus;
  #assert rs_put_effect(b[..],FT_HERO,RsEffect.{kind=EF_COND,cond=RS_RESTRAINED,by=FT_FOE,spell=-1,until=b[0].clock+20,save=-1});
  #assert !b[0].c[FT_HERO].dodging;
  rs_drop_effect(b[..],FT_HERO,0);
  #assert rs_save_edge(b[..],FT_HERO,RS_DEX) == 0 && !b[0].c[FT_HERO].dodging && s[0].turn.bonus;
}

#test "a dying saved seat receives Bane and rescues on its six-second death save without disturbing another actors turn" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].dice[0].fixed = true;
  b[0].c[FT_HERO].hp = 0; b[0].c[FT_HERO].cond = RS_UNCONSCIOUS|RS_PRONE;
  b[0].c[FT_HERO].inspired = 6;
  #assert rs_put_effect(b[..],FT_HERO,RsEffect.{kind=EF_BANE,by=FT_FOE,spell=SP_BANE,until=b[0].clock+60,save=-1});
  b[0].c[FT_HERO].round_at = b[0].c[FT_HERO].turn_at;
  who := b[0].who; turn := b[0].turn; b[0].dice[0].rolled = 0;
  b[0].clock = fb_seat_next(b[..],s[..]); fb_seat_step(b[..],s[..]);
  #assert b[0].c[FT_HERO].death_ok == 1 && b[0].c[FT_HERO].death_fail == 0 && b[0].c[FT_HERO].inspired == 0;
  #assert b[0].dice[0].rolled == 3 && b[0].who == who && b[0].turn.action == turn.action && b[0].turn.move_left == turn.move_left;
  #assert b[0].c[FT_HERO].hp == 0 && rs_has(b[0].c[FT_HERO],RS_UNCONSCIOUS) && !s[0].turn.action;
  // An intervening short action beat is not a second death saving throw.
  b[0].clock = fb_seat_next(b[..],s[..]); fb_seat_step(b[..],s[..]);
  #assert b[0].dice[0].rolled == 3 && b[0].c[FT_HERO].death_ok == 1;
}

#test "a saved seat can dismiss concentration outside its own turn without spending either actor's budget" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  #assert fb_seat_use(b[..],s[..],fb_spell(SP_FOG_CLOUD,1,FB_POINT),-1,12,12,FT_HERO);
  #assert b[0].zone[0].on && s[0].turn.action && s[0].turn.slot_spent;
  slots := b[0].c[FT_HERO].slots[1]; rolls := b[0].dice[0].rolled;
  b[0].who=FT_FOE; b[0].turn.action=true; b[0].turn.bonus=true;
  b[0].turn.move_left=3; s[0].open=false;
  #assert fb_seat_dismiss(b[..],s[..]);
  #assert !b[0].zone[0].on && b[0].c[FT_HERO].conc==-1;
  #assert s[0].turn.action && s[0].turn.slot_spent && !s[0].turn.bonus;
  #assert b[0].who==FT_FOE && b[0].turn.action && b[0].turn.bonus && b[0].turn.move_left==3;
  #assert b[0].c[FT_HERO].slots[1]==slots && b[0].dice[0].rolled==rolls;
  #assert !fb_seat_dismiss(b[..],s[..]);
}

#test "component refusal reaches hotbar readiness, saved-seat casting and empty-target casts" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  me := s[0].me; b[0].c[me].speech_blocked=true;
  a := fb_spell(SP_HEALING_WORD,1,FB_ALLY);
  slots := b[0].c[me].slots[1]; seq := b[0].book[0].seq;
  #assert !fb_ready(b[..],me,a) && !fb_seat_can(b[..],s[..],a);
  #assert !fb_seat_use(b[..],s[..],a,-1,0,0,me);
  fb_seat_in(b[..],s[..]); #assert !fb_cast_at_nothing(b[..],me,SP_HEALING_WORD,1); fb_seat_out(b[..],s[..]);
  #assert b[0].c[me].slots[1]==slots && b[0].book[0].seq==seq && !s[0].turn.bonus;
  b[0].c[me].speech_blocked=false; #assert fb_ready(b[..],me,a) && fb_seat_can(b[..],s[..],a);
}

#test "a real-time seat retains Prone until it explicitly pays to stand in its own turn" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO].cond |= RS_PRONE;
  b[0].clock = fb_seat_next(b[..],s[..]); fb_seat_step(b[..],s[..]);
  #assert rs_has(b[0].c[FT_HERO],RS_PRONE);
  // The declared action profile prices standing at half the beat's grant.
  held := b[0].turn; who := b[0].who;
  #assert fb_seat_stand(b[..],s[..]) && !rs_has(b[0].c[FT_HERO],RS_PRONE);
  #assert !s[0].turn.action && !s[0].turn.bonus && s[0].turn.move_left == 1;
  #assert b[0].who == who && b[0].turn.move_left == held.move_left && b[0].turn.action == held.action;
  #assert !fb_seat_stand(b[..],s[..]);
}

#test "hotbar ranged spell hits use condition criticals and Petrified resistance at five feet" {
  for mode: 0..<4 {
    b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],101+mode);
    b[0].c[FT_HERO] = rs_wizard("You",0,3); rs_place(b[..],FT_HERO,10,10);
    rs_place(b[..],FT_FOE,10,11); b[0].c[FT_FOE].ac = 1;
    conditions := [4] int.[RS_PARALYZED,RS_UNCONSCIOUS,RS_STUNNED,RS_PETRIFIED];
    damage := [4] int.[10,10,5,2]; b[0].c[FT_FOE].cond = conditions[mode];
    b[0].dice[0].fixed = true;
    #assert fb_seat_use(b[..],s[..],fb_spell(SP_FIRE_BOLT,0,FB_FOE),FT_FOE,10,11,FT_ALLY);
    #assert b[0].c[FT_FOE].hp == 400-damage[mode] && s[0].turn.action && !s[0].turn.slot_spent;
    e := rs_recent_at(b[0].book[..],0);
    #assert e.kind == RS_EV_DAMAGE && e.spell == SP_FIRE_BOLT && e.amount == damage[mode];
  }
}

#test "a hotbar Rogue's Cunning Trip respects automatic saves and leaves rescue resources held" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],111);
  b[0].c[FT_HERO] = rs_rogue("You",0,5); rs_place(b[..],FT_HERO,10,10);
  b[0].c[FT_HERO].strike_plan = CS_TRIP;
  rs_place(b[..],FT_FOE,10,11); b[0].c[FT_FOE].ac = 1;
  b[0].c[FT_FOE].cond = RS_PARALYZED; b[0].c[FT_FOE].score[RS_DEX] = 30;
  b[0].c[FT_FOE].inspired = 12; b[0].c[FT_FOE].own_luck = true; b[0].c[FT_FOE].uses[RS_USE_LUCK] = 1;
  b[0].dice[0].fixed = true;
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_ATTACK,"ATTACK","attack"),FT_FOE,10,11,FT_ALLY);
  #assert s[0].turn.action && s[0].turn.sneaked && rs_has(b[0].c[FT_FOE],RS_PRONE);
  #assert b[0].c[FT_FOE].inspired == 12 && b[0].c[FT_FOE].uses[RS_USE_LUCK] == 1;
}

#test "hotbar Healing Word recovers a dying ally without erasing an independent Unconscious source" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].dice[0].fixed = true;
  b[0].c[FT_ALLY].hp = 0; b[0].c[FT_ALLY].temp = 7;
  b[0].c[FT_ALLY].cond = RS_PRONE|RS_UNCONSCIOUS;
  b[0].c[FT_ALLY].stable = true;
  #assert rs_put_effect(b[..],FT_ALLY,RsEffect.{kind=EF_COND,cond=RS_UNCONSCIOUS,until=b[0].clock+20});
  slots := b[0].c[FT_HERO].slots[1];
  #assert fb_seat_use(b[..],s[..],fb_spell(SP_HEALING_WORD,1,FB_ALLY),FT_FOE,0,0,FT_ALLY);
  #assert b[0].c[FT_ALLY].hp > 0 && b[0].c[FT_ALLY].temp == 7 && !b[0].c[FT_ALLY].stable;
  #assert rs_has(b[0].c[FT_ALLY],RS_UNCONSCIOUS) && !rs_can_act(b[0].c[FT_ALLY]);
  #assert b[0].c[FT_HERO].slots[1] == slots-1 && s[0].turn.bonus && s[0].turn.slot_spent;
  event := rs_recent_at(b[0].book[..],0); text := cast(string)event.text[0..<event.text_n];
  #assert event.kind == RS_EV_HEAL && event.to == FT_ALLY && event.amount == b[0].c[FT_ALLY].hp;
  #assert text.count >= 11 && text[text.count-11..<text.count] == " Hit Points";
  rs_drop_effect(b[..],FT_ALLY,0);
  #assert !rs_has(b[0].c[FT_ALLY],RS_UNCONSCIOUS) && rs_has(b[0].c[FT_ALLY],RS_PRONE) && rs_can_act(b[0].c[FT_ALLY]);
}

#test "a real-time seat activates Halt at its next beat but retains an unspent Reaction" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  #assert rs_effect_add(b[0].c[FT_HERO..<FT_HERO+1],RsEffect.{kind=EF_HALT_PENDING,by=FT_FOE,spell=SP_COMMAND,save=-1});
  attack := fb_feature(FB_ATTACK,"ATTACK","attack"); reaction := fb_art_spell(SP_FEATHER_FALL,FB_SELF,"feather-fall");
  #assert fb_seat_can(b[..],s[..],attack);
  b[0].clock = fb_seat_next(b[..],s[..]); fb_seat_step(b[..],s[..]);
  #assert !fb_seat_can(b[..],s[..],attack) && fb_seat_can(b[..],s[..],reaction);
  // Exercise response admission for a supplied Reaction trigger; falling
  // motion and Feather Fall's physical effect are not this budget fixture.
  #assert fb_seat_use(b[..],s[..],reaction,-1,10,10,FT_HERO);
  #assert s[0].turn.slot_spent && s[0].turn.leveled && !s[0].turn.action && !s[0].turn.bonus;
  #assert !fb_seat_can(b[..],s[..],reaction);
  rs_tick(b[..],100); #assert !rs_can_act(b[0].c[FT_HERO]);
  fb_seat_step(b[..],s[..]);
  #assert rs_can_act(b[0].c[FT_HERO]) && !rs_effect(b[0].c[FT_HERO],EF_HALT) && !rs_effect(b[0].c[FT_HERO],EF_HALT_PENDING);
}

#test "a hotbar weapon attack gets one Bless die and retires all next-roll weaknesses on its missed roll" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],71);
  b[0].dice[0].fixed = true;
  b[0].c[FT_FOE].ac = 100;
  rs_place(b[..],FT_FOE,10,11);
  for k: 0..<3 {
    #assert rs_put_effect(b[..],FT_HERO,RsEffect.{kind=EF_WEAK,by=k,until=b[0].clock+20});
    #assert rs_put_effect(b[..],FT_HERO,RsEffect.{kind=EF_BLESS,by=k,spell=SP_BLESS,until=b[0].clock+20});
  }
  rolled := b[0].dice[0].rolled;
  hp := b[0].c[FT_FOE].hp;
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_ATTACK,"ATTACK","attack"),FT_FOE,10,11,FT_ALLY);
  #assert b[0].dice[0].rolled == rolled+3 && b[0].c[FT_FOE].hp == hp;
  #assert s[0].turn.action;
  blessings := 0;
  for e: b[0].c[FT_HERO].eff {
    #assert e.kind != EF_WEAK;
    if e.kind == EF_BLESS { blessings += 1; }
  }
  #assert blessings == 3;
  event := rs_recent_at(b[0].book[..],0);
  #assert event.kind == RS_EV_MISS && event.by == FT_HERO && event.to == FT_FOE;
}

#test "Everglade extra-list and house grants are exactly its declared spell bar and stay off ordinary Druids" {
  world := fb_everglade_hero("World", 0); ordinary := rs_druid("Druid", 0, 9);
  bar: [FB_EG_SLOTS] FbAb; n := fb_everglade(bar[..]);
  for sp: 0..<RS_HOUSE_END {
    expected := false;
    for k: 0..<n {
      if bar[k].kind != FB_SPELL { continue; }
      helper := rs_spell(bar[k].sp).part_of;
      root := ifx helper >= 0 then helper else bar[k].sp;
      if sp == root { expected = true; }
    }
    #assert ((world.spell_grants[sp / 64] & (cast(u64) 1 << (sp % 64))) != 0) == expected;
  }
  #assert rs_spell_access(world, SP_WATER_ORB) && !rs_spell_access(ordinary, SP_WATER_ORB);
  #assert rs_spell_access(world, SP_LEVITATE) && !rs_spell_access(ordinary, SP_LEVITATE);
  #assert !rs_spell_access(world, SP_GUIDING_BOLT) && !rs_spell_access(ordinary, SP_GUIDING_BOLT);
}

FT_HERO :: 0; FT_FOE :: 1; FT_NEXT :: 2; FT_ALLY :: 3;
// A small field: you at (10, 10), a foe two squares east and another beside it, a hurt friend
// beside you; your seat's turn open. Foes have 400 Hit Points, so a blow shows and nobody drops.
ft_field :: (b: [] RsBattle, s: [] FbSeat, seed: int) {
  rs_reset(b);
  b[0].n = 0; b[0].clock = 0; b[0].who = -1; b[0].w = 40; b[0].h = 40;
  #assert rs_set_world(b,RS_ACTION_WORLD);   // Everglade's bar: action beats, no caster in its own blast
  for k: 0..<RS_ZONES { b[0].zone[k].on = false; }
  b[0].dice[0].state = cast(u64) seed * 7919 + 3;
  _ := rs_add(b, fb_everglade_hero("You", 0), 10, 10);
  _ = rs_add(b, fb_folk("Guard", 1, 16, 400, [6] int.[13, 12, 12, 10, 11, 10]), 12, 10);
  _ = rs_add(b, fb_folk("Guard", 1, 16, 400, [6] int.[13, 12, 12, 10, 11, 10]), 12, 11);
  _ = rs_add(b, fb_everglade_hero("Friend", 0), 11, 10);
  b[0].c[FT_ALLY].hp = 10;
  rs_begin(b);
  s[0] = FbSeat.{me = FT_HERO};
  b[0].clock = b[0].c[FT_HERO].turn_at;
  fb_seat_step(b, s);
}
// What a trial saw: whether it was used, the slot level spent (0 none), and the events of each kind
// on the foe (or the friend, for a heal).
FtSaw :: struct { ok: bool; spent: int; casted: bool; hits: int; saves: int; damage: int; heal: int; cond: int; conc: int; }
ft_try :: (b: [] RsBattle, s: [] FbSeat, k: int) -> FtSaw {
  bar: [FB_EG_SLOTS] FbAb; _ := fb_everglade(bar[..]);
  a := bar[k];
  before: [10] int; for l: 0..<10 { before[l] = b[0].c[FT_HERO].slots[l]; }
  seq := b[0].book[0].seq;
  saw: FtSaw;
  saw.ok = fb_seat_use(b, s, a, FT_FOE, b[0].c[FT_FOE].x, b[0].c[FT_FOE].y, FT_ALLY);
  for l: 1..<10 { if b[0].c[FT_HERO].slots[l] < before[l] { saw.spent = l; } }
  for e: 0..<rs_min(b[0].book[0].seq - seq, RS_EVENTS) {
    ev := rs_recent(b[0].book[0], e);
    if ev.kind == RS_EV_CAST { saw.casted = true; }
    if ev.to != FT_FOE && ev.to != FT_NEXT && ev.to != FT_ALLY && ev.to != FT_HERO { continue; }
    if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { saw.hits += 1; }
    if ev.kind == RS_EV_SAVE { saw.saves += 1; }
    if ev.kind == RS_EV_DAMAGE { saw.damage += ev.amount; }
    if ev.kind == RS_EV_HEAL { saw.heal += ev.amount; }
    if ev.kind == RS_EV_CONDITION { saw.cond += 1; }
  }
  saw.conc = b[0].c[FT_HERO].conc;
  return saw;
}
// Every slot k in from..<to: used, its slot spent at its level, and the engine's rolls on who it reaches.
ft_slots :: (from: int, to: int) -> int {
  b: [1] RsBattle; s: [1] FbSeat;
  bar: [FB_EG_SLOTS] FbAb; _ := fb_everglade(bar[..]);
  bad := 0;
  for k: from..<to {
    ft_field(b[..], s[..], k + 1);
    a := bar[k];
    saw := ft_try(b[..], s[..], k);
    good := saw.ok;
    if a.kind == FB_SPELL {
      sp := rs_spell(a.sp);
      good = good && saw.casted && saw.spent == a.lvl;
      // held, unless its one target saved (the engine ends a one-target spell with no one under it)
      if sp.concentration { good = good && (saw.conc == a.sp || (sp.area == RS_A_NONE && saw.saves > 0)); }
      for q: 0..<sp.step_n {
        st := sp.steps[q].kind;
        if st == RS_S_ATTACK { good = good && saw.hits > 0; }
        if st == RS_S_SAVE { good = good && saw.saves > 0; }
        if st == RS_S_HEAL { good = good && saw.heal > 0; }
      }
    }
    if !good { bad += 1; }
  }
  return bad;
}

#test "Everglade's bar: 49 slots in its order, each its art and its engine record" {
  bar: [FB_EG_SLOTS] FbAb; n := fb_everglade(bar[..]);
  #assert n == 49;
  names := [49] string.["meteor-swarm", "thunderbolt", "mega-thunderbolt", "water-orb", "reverse-gravity", "wind-wall", "levitate", "feather-fall", "gust-of-wind", "thunderwave", "wall-of-stone", "telekinesis", "black-tentacles", "ice-knife", "ice-storm", "sleet-storm", "water-walk", "control-water", "create-water", "water-breathing", "moonbeam", "produce-flame", "starry-wisp", "shillelagh", "poison-spray", "elementalism", "entangle", "faerie-fire", "healing-word", "spike-growth", "call-lightning", "wall-of-fire", "conjure-animals", "polymorph", "mass-cure-wounds", "sunbeam", "wall-of-thorns", "fire-storm", "sunburst", "storm-of-vengeance", "shapechange", "speak-with-animals", "wild-resurgence", "ray-of-frost", "fog-cloud", "hold-person", "cone-of-cold", "rebuild", "next-row"];
  for k: 0..<n { #assert bar[k].art == names[k]; }
  // Everglade's own four are house rules; every other spell is the SRD's
  for k: 0..<n {
    if bar[k].kind != FB_SPELL { continue; }
    #assert rs_spell(bar[k].sp).srd == (k >= 4);
    #assert bar[k].lvl == rs_spell(bar[k].sp).level;
  }
  #assert bar[2].sp == SP_MEGA_THUNDERBOLT && bar[2].lvl == 9 && bar[0].sp == SP_EG_METEOR_SWARM;
  #assert bar[9].sp == SP_THUNDERWAVE && bar[45].sp == SP_HOLD_PERSON && bar[30].sp == SP_CALL_LIGHTNING;
  #assert bar[42].kind == FB_RESURGE && bar[47].kind == FB_WORLD && bar[48].kind == FB_WORLD;
}

#test "Everglade's caster: DC 15, +7, cantrips at two dice, a slot of every level" {
  c := fb_everglade_hero("You", 0);
  #assert rs_spell_dc(c) == 15 && rs_spell_attack(c) == 7 && rs_cantrip_tier(c.level) == 2;
  #assert c.slots[9] == 1 && c.slots[1] == 4 && c.ac == 15 && c.hp_max == 57;
}

#test "the aimed four and the first row, resolved by the engine" #steps 2000000000 { #assert ft_slots(0, 10) == 0; }
#test "the second row, resolved by the engine" #steps 2000000000 { #assert ft_slots(10, 20) == 0; }
#test "the grove's spells, resolved by the engine" #steps 2000000000 { #assert ft_slots(20, 30) == 0; }
#test "the circle's spells, resolved by the engine" #steps 2000000000 { #assert ft_slots(30, 40) == 0; }
#test "the storm and the polar spells, resolved by the engine" #steps 2000000000 { #assert ft_slots(40, 49) == 0; }

#test "Mega Thunderbolt: Dexterity save, 100d10 Lightning, half on a success" #steps 2000000000 {
  b: [1] RsBattle; s: [1] FbSeat;
  lo := 100000; hi_ := 0;
  for t: 0..<6 {
    ft_field(b[..], s[..], 40 + t);
    b[0].c[FT_FOE].hp = 2000; b[0].c[FT_FOE].hp_max = 2000;
    saw := ft_try(b[..], s[..], 2);
    #assert saw.ok && saw.spent == 9 && saw.saves >= 1;
    took := 2000 - b[0].c[FT_FOE].hp;
    lo = rs_min(lo, took); hi_ = rs_max(hi_, took);
    #assert took >= 50 && took <= 1000;
  }
  #assert hi_ > 200;
}

#test "Meteor Swarm (Everglade's): both damage types, and a creature is hit once" #steps 2000000000 {
  b: [1] RsBattle; s: [1] FbSeat;
  ft_field(b[..], s[..], 5);
  seq := b[0].book[0].seq;
  saw := ft_try(b[..], s[..], 0);
  #assert saw.ok && saw.spent == 9;
  fire := 0; blunt := 0;
  for e: 0..<rs_min(b[0].book[0].seq - seq, RS_EVENTS) {
    ev := rs_recent(b[0].book[0], e);
    if ev.kind == RS_EV_DAMAGE && ev.to == FT_FOE && ev.damage == RS_FIRE { fire += 1; }
    if ev.kind == RS_EV_DAMAGE && ev.to == FT_FOE && ev.damage == RS_BLUDGEONING { blunt += 1; }
  }
  #assert fire == 1 && blunt == 1;
  // the foe beside it is in the same sphere
  #assert b[0].c[FT_NEXT].hp < 400;
}

#test "the seat: one action a turn, the next on the next beat; a spent slot back 9 seconds on" #steps 2000000000 {
  b: [1] RsBattle; s: [1] FbSeat;
  ft_field(b[..], s[..], 9);
  bar: [FB_EG_SLOTS] FbAb; _ := fb_everglade(bar[..]);
  #assert fb_seat_can(b[..], s[..], bar[43]);
  #assert ft_try(b[..], s[..], 43).ok;               // Ray of Frost, the action
  #assert !fb_seat_can(b[..], s[..], bar[22]);        // Starry Wisp: no action left this turn
  #assert !ft_try(b[..], s[..], 22).ok;
  #assert fb_seat_can(b[..], s[..], bar[28]);         // Healing Word is a Bonus Action
  #assert ft_try(b[..], s[..], 28).ok;
  // the next beat opens a new turn
  b[0].clock = fb_seat_next(b[..], s[..]);
  fb_seat_step(b[..], s[..]);
  #assert ft_try(b[..], s[..], 22).ok;
  // one 9th-level slot: Mega Thunderbolt spends it, Meteor Swarm waits for it
  b[0].clock = fb_seat_next(b[..], s[..]); fb_seat_step(b[..], s[..]);
  #assert ft_try(b[..], s[..], 2).ok;
  b[0].clock = fb_seat_next(b[..], s[..]); fb_seat_step(b[..], s[..]);
  #assert !fb_ready(b[..], FT_HERO, bar[0]) && fb_left(b[..], FT_HERO, bar[0]) == 0;
  for q: 0..<7 { rs_tick(b[..], 1.5); }
  #assert fb_ready(b[..], FT_HERO, bar[0]);
}

#test "concentration: a second spell held ends the first; a lasting area runs each round" #steps 2000000000 {
  b: [1] RsBattle; s: [1] FbSeat; z: [FB_ZONES] FbZone;
  ft_field(b[..], s[..], 13);
  bar: [FB_EG_SLOTS] FbAb; _ := fb_everglade(bar[..]);
  #assert ft_try(b[..], s[..], 20).ok && b[0].c[FT_HERO].conc == SP_MOONBEAM;
  fb_zone_add(z[..], b[..], FT_HERO, bar[20], 2, b[0].c[FT_FOE].x, b[0].c[FT_FOE].y);
  b[0].clock += 6100000;
  #assert fb_zones_round(z[..], b[..]) == 2;   // both guards: the second stands 5 feet off the first
  // Hold Person on the next turn ends Moonbeam, and its area with it
  b[0].clock = fb_seat_next(b[..], s[..]); fb_seat_step(b[..], s[..]);
  #assert ft_try(b[..], s[..], 45).ok && b[0].c[FT_HERO].conc != SP_MOONBEAM;   // held, or ended by a save: Moonbeam is gone either way
  b[0].clock += 6100000;
  #assert fb_zones_round(z[..], b[..]) == 0 && !z[0].on;
}

#test "Wild Resurgence: a use of Wild Shape, Temporary Hit Points of the Druid's level" #steps 2000000000 {
  b: [1] RsBattle; s: [1] FbSeat;
  ft_field(b[..], s[..], 17);
  saw := ft_try(b[..], s[..], 42);
  #assert saw.ok && b[0].c[FT_HERO].temp == 9 && b[0].c[FT_HERO].uses[RS_USE_WILD] == 2;
}

#test "5E MMO's class bars: kinds, aims and art in slot order" {
  out: [FB_CLASS_SLOTS] FbAb;
  n := fb_class_bar(RS_DRUID, out[..]);
  #assert n == 9 && out[0].art == "starry-wisp" && out[2].art == "produce-flame-hurl" && out[7].kind == FB_LANDS && out[7].art == "lands-aid";
  n = fb_class_bar(RS_FIGHTER, out[..]);
  #assert n == 4 && out[1].kind == FB_SECOND && out[1].art == "second-wind" && out[2].art == "action-surge";
  n = fb_class_bar(RS_CLERIC, out[..]);
  #assert out[4].sp == SP_SPIRIT_GUARDIANS && out[4].tg == FB_SELF && out[5].art == "turn-undead";
  total := 0;
  for kl: 0..<RS_CLASSES { if kl != RS_MONSTER { total += fb_class_bar(kl, out[..]); } }
  #assert total == 71;   // Lesser Restoration on the Life Cleric's bar (417eef69a4)
}

#test "every slot has its picture: 5E MMO's class bars and Everglade's bar" {
  out: [FB_CLASS_SLOTS] FbAb;
  for kl: 0..<RS_CLASSES {
    if kl == RS_MONSTER { continue; }
    n := fb_class_bar(kl, out[..]);
    for k: 0..<n {
      found := false;
      for q: 0..<MH_ABILITIES { if MH_NAME[q] == out[k].art { found = true; } }
      #assert found;
    }
  }
  bar: [FB_EG_SLOTS] FbAb; n := fb_everglade(bar[..]);
  #assert n == HB_SLOTS;
  for k: 0..<n { #assert HB_NAME[k] == bar[k].art; }
}

// Character Create's classes (#13024): each SRD 5.2.1 class at level 1, its Hit Points and Armor
// Class as the class tables and starting gear give them, and its slot 1 ability resolved by the
// engine against a foe beside it (the heals with the hero hurt first).
FT_CL_HP :: [12] int.[14, 9, 9, 9, 12, 9, 11, 11, 10, 7, 9, 7];
FT_CL_AC :: [12] int.[13, 13, 16, 15, 17, 15, 18, 15, 14, 12, 15, 15];
#test "Character Create's twelve classes: level 1, their Hit Points and AC, and slot 1 resolved by the engine" #steps 4000000000 {
  for c: 0..<FB_CL_N {
    h := fb_cl_hero(c, "You", 0, 1);
    #assert h.level == 1 && h.klass == FB_CL_ENGINE[c] && h.hp_max == FT_CL_HP[c] && h.ac == FT_CL_AC[c];
    #assert fb_cl_of_kind(FB_CL_KIND[c]) == c;
    b: [1] RsBattle; s: [1] FbSeat;
    b[0].n = 0; b[0].clock = 0; b[0].who = -1; b[0].w = 40; b[0].h = 40;
    #assert rs_set_timing(b[..],RS_ACTION_TIMING);
    for k: 0..<RS_ZONES { b[0].zone[k].on = false; }
    b[0].dice[0].state = cast(u64) (c + 5) * 7919 + 3;
    _ := rs_add(b[..], h, 10, 10);
    _ = rs_add(b[..], fb_folk("Guard", 1, 16, 400, [6] int.[13, 12, 12, 10, 11, 10]), 11, 10);
    rs_begin(b[..]);
    b[0].c[0].hp = 1;
    s[0] = FbSeat.{me = 0};
    b[0].clock = b[0].c[0].turn_at;
    fb_seat_step(b[..], s[..]);
    a := fb_cl_ability(c);
    #assert a.kind != FB_WORLD && a.art == FB_CL_ART[c] && a.delay > 0;
    seq := b[0].book[0].seq;
    #assert fb_seat_use(b[..], s[..], a, 1, 11, 10, 0);
    seen := 0;
    for e: 0..<rs_min(b[0].book[0].seq - seq, RS_EVENTS) { ev := rs_recent(b[0].book[0], e); if ev.kind != RS_EV_TURN { seen += 1; } }
    #assert seen > 0;
  }
  #assert fb_cl_of_kind("druid") == -1 && fb_cl_of_kind("warlock") == -1;
}


#test "each Moonbeam pulse shares damage across its simultaneous saves and renews next round" {
  b: [1] RsBattle; s: [1] FbSeat; z: [FB_ZONES] FbZone;
  ft_field(b[..],s[..],13); b[0].dice[0].fixed=true;
  bar: [FB_EG_SLOTS] FbAb; _ := fb_everglade(bar[..]);
  #assert ft_try(b[..],s[..],20).ok;
  fb_zone_add(z[..],b[..],FT_HERO,bar[20],2,b[0].c[FT_FOE].x,b[0].c[FT_FOE].y);
  for round: 0..<2 {
    b[0].clock+=6100000; before := b[0].dice[0].rolled;
    #assert fb_zones_round(z[..],b[..])==2;
    #assert b[0].dice[0].rolled==before+4; // two saves and one 2d10 roll
  }
}

#test "saved-seat Dash uses current modified Speed and preserves another actors turn" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO].speed=37; b[0].c[FT_HERO].slowed_until=rs_secs(20); b[0].c[FT_HERO].halved_until=rs_secs(20);
  s[0].turn.move_left=1; s[0].turn.move_feet=3;
  b[0].who=FT_FOE; b[0].turn.action=true; b[0].turn.move_left=7; b[0].turn.move_feet=2;
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_DASH,"DASH","dash"),-1,0,0,FT_HERO);
  #assert s[0].turn.action && s[0].turn.move_left==3 && s[0].turn.move_feet==1;
  #assert b[0].who==FT_FOE && b[0].turn.action && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
  #assert !fb_seat_use(b[..],s[..],fb_feature(FB_DASH,"DASH","dash"),-1,0,0,FT_HERO);
}

#test "saved-seat Dash credits Exhaustion-adjusted Speed through the shared world adapter" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO].speed=30;
  #assert rs_gain_exhaustion(b[..],FT_HERO) && rs_gain_exhaustion(b[..],FT_HERO);
  before := s[0].turn.move_left*5+s[0].turn.move_feet;
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_DASH,"DASH","dash"),-1,0,0,FT_HERO);
  #assert s[0].turn.move_left*5+s[0].turn.move_feet==before+15; // five fewer feet in the base action-profile grant, twenty from Dash
}

#test "saved seats retain movement debt across Speed loss without changing another actors turn" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  #assert fb_seat_use(b[..],s[..],fb_feature(FB_DASH,"DASH","dash"),-1,0,0,FT_HERO);
  s[0].turn.move_left=1; s[0].turn.move_feet=0; // 35 of the 40 granted feet spent
  b[0].who=FT_FOE; b[0].turn.move_left=7; b[0].turn.move_feet=2;
  b[0].c[FT_HERO].speed=10;
  fb_seat_in(b[..],s[..]); #assert rs_movement_left(b[..],FT_HERO)==0; fb_seat_out(b[..],s[..]);
  #assert s[0].turn.move_debt==20;
  b[0].c[FT_HERO].speed=30;
  fb_seat_in(b[..],s[..]); #assert rs_movement_left(b[..],FT_HERO)==5; fb_seat_out(b[..],s[..]);
  #assert s[0].turn.move_debt==0 && s[0].turn.move_left==1;
  #assert b[0].who==FT_FOE && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
}

#test "a Stunned saved seat can stand and walk while its hotbar actions remain unavailable" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  #assert rs_put_effect(b[..],FT_HERO,RsEffect.{kind=EF_COND,cond=RS_STUNNED,by=FT_FOE,spell=-1,until=60,save=-1});
  b[0].c[FT_HERO].cond|=RS_PRONE;
  b[0].who=FT_FOE; b[0].turn.move_left=7; b[0].turn.move_feet=2;
  #assert fb_seat_stand(b[..],s[..]) && s[0].turn.move_left==1;
  dash := fb_feature(FB_DASH,"DASH","dash");
  #assert !fb_seat_can(b[..],s[..],dash) && !fb_seat_use(b[..],s[..],dash,-1,0,0,FT_HERO);
  #assert !s[0].turn.action && !s[0].turn.bonus;
  fb_seat_in(b[..],s[..]); #assert rs_step_to(b[..],FT_HERO,10,11); fb_seat_out(b[..],s[..]);
  #assert s[0].turn.move_left==0 && rs_has(b[0].c[FT_HERO],RS_STUNNED);
  #assert b[0].who==FT_FOE && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
}

#test "saved-seat first aid stabilizes through Medicine and spends only that seats Action" {
  b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
  b[0].c[FT_HERO].score[RS_WIS]=10;
  b[0].c[FT_FOE].hp=0; b[0].c[FT_FOE].cond=RS_UNCONSCIOUS|RS_PRONE;
  b[0].dice[0].fixed=true; rolls:=b[0].dice[0].rolled;
  b[0].who=FT_FOE; b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.move_left=7; b[0].turn.move_feet=2;
  r:=fb_seat_first_aid(b[..],s[..],FT_FOE,RsFirstAidContext.{contact=true});
  #assert r.accepted && r.passed && s[0].turn.action && !s[0].turn.bonus && b[0].c[FT_FOE].stable;
  #assert b[0].who==FT_FOE && b[0].turn.action && b[0].turn.bonus && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
  #assert b[0].dice[0].rolled==rolls+2 && b[0].c[FT_FOE].stable_due==b[0].clock+rs_secs(7200);
  r=fb_seat_first_aid(b[..],s[..],FT_FOE,RsFirstAidContext.{contact=true});
  #assert !r.accepted && b[0].dice[0].rolled==rolls+2;
  s[0].open=false;
  r=fb_seat_first_aid(b[..],s[..],-1,RsFirstAidContext.{contact=true});
  #assert !r.accepted && b[0].who==FT_FOE && b[0].turn.move_left==7;
}

#test "saved-seat Help assists another actor while preserving the running actors entire turn" {
  for kind: 0..<2 {
    b: [1] RsBattle; s: [1] FbSeat; ft_field(b[..],s[..],91);
    b[0].c[FT_HERO].checks.skills|=1<<SK_ATHLETICS;
    b[0].who=FT_FOE; b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.move_left=7; b[0].turn.move_feet=2;
    target:=ifx kind==0 then FT_ALLY else FT_FOE;
    if kind==0 { #assert fb_seat_help_ability(b[..],s[..],target,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}); }
    else {
      rs_place(b[..],FT_FOE,b[0].c[FT_HERO].x+1,b[0].c[FT_HERO].y);
      #assert fb_seat_help_attack(b[..],s[..],target,true);
    }
    #assert s[0].turn.action && !s[0].turn.bonus;
    #assert b[0].who==FT_FOE && b[0].turn.action && b[0].turn.bonus && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
    found:=false; for e: b[0].c[target].eff { if e.kind==(ifx kind==0 then EF_HELP_CHECK else EF_HELP_ATTACK) && e.by==FT_HERO { found=true; } }
    #assert found;
    if kind==0 { #assert !fb_seat_help_ability(b[..],s[..],target,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}); }
    else { #assert !fb_seat_help_attack(b[..],s[..],target,true); }
    s[0].open=false; s[0].turn.action=false;
    #assert !fb_seat_help_ability(b[..],s[..],-1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
    #assert !fb_seat_help_attack(b[..],s[..],-1,true) && !s[0].turn.action;
  }
}

#test "a saved seat retains Disengage without changing another actor's turn or Reaction" {
  b:[1] RsBattle; b[0].w=12; b[0].h=12;
  _:=rs_add(b[..],rs_rogue("Rogue",0,2),2,2);
  _=rs_add(b[..],rs_guard("Other",1),4,2); rs_start_turn(b[..],1);
  b[0].turn.action=true; b[0].c[0].reacted=true;
  seat:[1] FbSeat; seat[0].me=0; seat[0].open=true;
  fb_seat_in(b[..],seat[..]);
  #assert rs_disengage_use(b[..],0,RS_DISENGAGE_CUNNING);
  fb_seat_out(b[..],seat[..]);
  #assert seat[0].turn.disengaged && seat[0].turn.bonus;
  #assert b[0].who==1 && b[0].turn.action && !b[0].turn.disengaged && b[0].c[0].reacted;
  fb_seat_in(b[..],seat[..]); rs_end_turn(b[..],0); fb_seat_out(b[..],seat[..]);
  #assert !seat[0].turn.disengaged && b[0].who==1 && b[0].turn.action;
}

#test "empty-target casting interrupts Long Rest before paying a Pact slot while cantrips preserve it" {
  for leveled:0..<2 {
    b:[1]RsBattle; c:[1]RsCreature; b[0].c=c[..]; b[0].n=1; b[0].who = -1;
    c[0]=rs_warlock("Watcher",0,3,SP_ELDRITCH_BLAST); c[0].slots[2]=1;
    #assert rs_rest_schedule_enable(b[..]) && rs_long_rest_start_owned(b[..],0,2,true);
    rs_tick(b[..],3600); b[0].who=0;
    #assert fb_cast_at_nothing(b[..],0,ifx leveled==1 then SP_HEX else SP_ELDRITCH_BLAST,ifx leveled==1 then 2 else 0);
    #assert c[0].long_rest.phase==(ifx leveled==1 then 2 else 1) && c[0].slots[2]==1;
    #assert c[0].long_rest.interruptions==leveled && b[0].turn.slot_spent==(leveled==1);
  }
}
#test "bar Reaction interruption recovers before payment and preserves its borrowed turn owner" {
  b:[1]RsBattle; c:[2]RsCreature; b[0].c=c[..]; b[0].n=2; b[0].who = -1;
  c[0]=rs_warlock("Watcher",0,3,SP_ELDRITCH_BLAST); c[1]=rs_fighter("Other",1,3);
  #assert rs_grant_spell(c[0..<1],SP_FEATHER_FALL);
  c[0].slots[2]=1; c[0].component_pouch=true;
  #assert rs_rest_schedule_enable(b[..]) && rs_long_rest_start_owned(b[..],0,2,true);
  rs_tick(b[..],3600); b[0].who=1; b[0].turn.action=true;
  #assert fb_cast(b[..],0,FbAb.{sp=SP_FEATHER_FALL,lvl=1},-1,0,0,-1);
  #assert c[0].long_rest.phase==2 && c[0].slots[2]==1 && c[0].reacted && b[0].who==1 && b[0].turn.action && !b[0].turn.slot_spent;
}

#test "empty-target free feature spells preserve slot zero and pay the source feature instead" {
  for vigor:0..<2 {
    b:[1]RsBattle; c:[1]RsCreature; b[0].c=c[..]; b[0].n=1; b[0].who = -1;
    c[0]=rs_warlock("Watcher",0,3,SP_ELDRITCH_BLAST);
    sp:=ifx vigor==1 then SP_FALSE_LIFE else SP_HEX;
    #assert rs_grant_spell(c[0..<1],sp);
    c[0].vigor=vigor==1; c[0].free_spell=sp; c[0].uses[RS_USE_FREE]=1;
    #assert rs_rest_schedule_enable(b[..]) && rs_long_rest_start_owned(b[..],0,2,true);
    rs_tick(b[..],3600); b[0].who=0;
    #assert fb_cast_at_nothing(b[..],0,sp,0);
    #assert c[0].slots[0]==0 && !b[0].turn.slot_spent && b[0].turn.leveled && c[0].long_rest.phase==2;
    #assert c[0].uses[RS_USE_FREE]==vigor;
  }
}
