#load "../../aethyr/cam/track.coax" as trk;   // ?stage= setups' camera tracks (lab_stage)
#load "../../everglade/world/housewright-stage.coax" as hws;   // ?stage=house-*: the housewright time-lapses (#13107)

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 250000;   // 16 MB of strokes: the HUD, the log, labels near the camera (the tokens are bg_fs's)
// The strokes' budget: the scene's labels and effects' text stop short of HUD_VERTS from the end, so
// the HUD, the log and the sliders always draw; a label that finds no room is counted and said
// (draw_sliders), never dropped quietly. LABEL_VERTS: the most one label takes.
HUD_VERTS :: 150000; LABEL_VERTS :: 900;   // the HUD's text is most of it: the log and 48 heroes' lines
SCENE_VERTS :: 100000;   // MAX_VERTICES - HUD_VERTS
U_FRAME_FLOATS :: 104;   // 26 vec4s: the camera, the grid, the zones (gpu/fivelab.coax FivelabU)
U_ENV :: 208;            // the camera's resolved environment, 27 vec4s (aethyr/render/painterly.coax PAINT_ENV_U, env_gpu_pack)
U_ENV_WORDS :: envf.ENV_FRAME_FLOATS;   // the record's words, from its owner (#13067: no second copy of the layout)
UNIFORM_FLOATS :: 316;   // 79 vec4s (gpu/fivelab.bindings, gpu/charactercreator.bindings)
// The frame store (a read-only storage buffer, group 0 binding 1: coax/web/host.js frame store),
// the tokens and squares bg_fs reads, too many for a uniform block's 64 KB: every creature's token
// (4 floats), then every square's (the token standing nearest its middle plus 1, 0 none).
F_SQUARES :: 69632;   // LAB_MAX * 4 (gpu/fivelab.coax FIVELAB_SQUARES)
FRAME_FLOATS :: 143360;   // F_SQUARES + LAB_SQUARES
U_GRID :: 4; U_CELLS :: 8; U_PANEL :: 12;
U_EYE :: 16; U_FWD :: 20; U_RIGHT :: 24; U_UP :: 28; U_SUN :: 32; U_ZONES :: 36; U_BOUNDS :: 100;
SQ :: 1.524;   // a 5-foot square, metres
HOLD_W :: 1; HOLD_A :: 2; HOLD_S :: 4; HOLD_D :: 8; HOLD_LEFT :: 16; HOLD_RIGHT :: 32; HOLD_UP :: 64; HOLD_DOWN :: 128; HOLD_IN :: 256; HOLD_OUT :: 512;
HOLD_JUMP :: 1024; HOLD_ALL :: 2047;
DIST :: 40.0; PIVOT_Z :: 0.6; ZOOM_NEAR :: 6.0; ZOOM_FAR :: 140.0;   // the camera's orbit: start, and how near and far it zooms
VIEW_FLAT :: 0; VIEW_GLADE :: 1;
// The time adapters (docs/dnd/README.md, "The time adapter"): the SRD's 6-second rounds, or action
// combat in the way of the Neverwinter MMO: a turn's worth every 1.5 seconds, spent slots, Rages and
// Focus Points back on a cooldown (`cost cooldown 9`), the same dice and Armor Class.
MODE_ROUNDS :: 0; MODE_ACTION :: 1;
ACTION_BEAT :: 1.5; ACTION_RECHARGE :: 9.0;

STEP :: 0.0166666667;
LAB_STEP_NS :: 16666667;
LAB_FRAME_NS :: 100000000;
OUTBOX_CAP :: 4096;
ACT_NAVIGATE :: 1;
ACT_PREFETCH :: 18;   // host.js (zone-host.js): open a page out of sight, up to its first drawn frame; its progress comes back as message 18, and action 1 to it then hands over in place
KEY_SHIFT :: -13; KEY_TAB :: -15; KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;

// The grid grows with the armies (size_grid): 40 by 20 for the 208 the lab fields by default, about
// four squares a figure past that, twice as wide as deep, at most 384 by 192 (LAB_SQUARES).
COLS :: 40; ROWS :: 20; ROWS_MAX :: 192;
LAB_SQUARES :: 73728;   // 2 * ROWS_MAX * ROWS_MAX: the squares' index the lab gives the battle
FAST :: 4.0;
// Three sides. Twenty-four a side, all level 6 (LEVEL), two of each of the twelve SRD 5e classes (the Circle
// of Moss against the Ember Pact), and an army of 160 Skeletons (the SRD's stat block) in the middle
// from the start as the Restless Dead, against everyone.
// The army-size sliders (and ?heroes=N&skeletons=M&dead=K) change the numbers: heroes come in
// companies of 48, each side's 24 two of every class, and the dead fill the rest.
SIDE :: 24; HEROES :: 48; SKELETONS :: 160; CASTERS :: 12; TEAMS :: 3;
HEROES_MAX :: 1024; SKELETONS_MAX :: 16384;
LAB_MAX :: 17408;   // HEROES_MAX + SKELETONS_MAX: the room the lab gives its battle (25 MB of creatures)
HORDE_MAX :: 20000;
LABELS_ALL :: 400; NAMES_ALL :: 96;   // past these, labels only near the camera (draw_sliders says so)   // the dead the Horde can send in after its first wave
LEVEL :: 6;
// The twelve SRD 5e classes as they stand: the casters' two back files, then the front two; each
// side fields every class twice.
ROSTER :: [12] int.[RS_DRUID, RS_WIZARD, RS_WARLOCK, RS_SORCERER, RS_BARD, RS_CLERIC,
                    RS_FIGHTER, RS_PALADIN, RS_BARBARIAN, RS_MONK, RS_ROGUE, RS_RANGER];
TEAM_NAME :: [3] string.["CIRCLE OF MOSS", "THE EMBER PACT", "THE RESTLESS DEAD"];
// A side's colour: the cult's is ember red in the Siege.
SIEGE_CULT_COL :: Col.{r = 1.0, g = 0.42, b = 0.36};
team_col :: (s: [] Lab, t: int) -> Col { if s[0].siege && t == 1 { return SIEGE_CULT_COL; } return TEAM_COL[rs_max(0, rs_min(t, 2))]; }
team_name :: (s: [] Lab, t: int) -> string { if s[0].siege { return SIEGE_TEAM_NAME[t]; } if s[0].horde && t == 0 { return "THE LIVING"; } return TEAM_NAME[t]; }
NAMES :: [48] string.["Rowan", "Briar", "Fern", "Hazel", "Alder", "Willow", "Sorrel", "Linden", "Moss", "Ivy", "Sen", "Lio",
                       "Mara", "Tam", "Ishu", "Rook", "Wen", "Kai", "Juna", "Pell", "Oro", "Suri", "Tavi", "Yen",
                       "Mordra", "Vesk", "Sallow", "Grimsby", "Ilse", "Nyx", "Corvin", "Morrow", "Sable", "Vex", "Thorn", "Gorr",
                       "Brakka", "Ulf", "Hild", "Torva", "Kesh", "Bjorn", "Rask", "Dagna", "Orm", "Sigra", "Hrolf", "Ygg"];

LOG_LINES :: 40;
LINE_CAP :: 96;
FXS :: 32;
FX_TEXT :: 3;   // a number floating off a figure (Num.kind; 0 none)

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
P3 :: struct { x: f32; y: f32; z: f32; }
Col :: struct { r: f32; g: f32; b: f32; }
WHITE :: Col.{r = 0.9, g = 0.92, b = 0.96};
DIM :: Col.{r = 0.52, g = 0.55, b = 0.6};
FAINT :: Col.{r = 0.28, g = 0.3, b = 0.34};
RED :: Col.{r = 1.0, g = 0.25, b = 0.22};
GREEN :: Col.{r = 0.4, g = 1.0, b = 0.5};
VIOLET :: Col.{r = 0.75, g = 0.48, b = 1.0};
GOLD :: Col.{r = 1.0, g = 0.8, b = 0.35};
CYAN :: Col.{r = 0.35, g = 0.9, b = 1.0};
TEAM_COL :: [3] Col.[Col.{r = 0.45, g = 0.95, b = 0.55}, Col.{r = 0.62, g = 0.85, b = 1.0}, Col.{r = 0.9, g = 0.86, b = 0.74}];

Line :: struct { text: [LINE_CAP] u8; n: int; col: Col; }
Num :: struct { kind: int; ax: f32; ay: f32; bx: f32; by: f32; t0: f32; life: f32; col: Col; text: [24] u8; n: int; }

Lab :: struct {
  stage: int = -1;   // a ?stage= setup (lab_stage): a housewright time-lapse (hws), -1 none
  stage_steps: int;  // its clock: the game steps (1/60 s) it has run
  stage_x: f32 = LAB_STAGE_X; stage_z: f32 = LAB_STAGE_Z; stage_turn: int = LAB_STAGE_TURN;   // where it stands: LAB_STAGE_*, or on a local page &sx=, &sz= (metres + 1000) and &turn=
  film: int; film_steps: int; film_x: f32;   // a film stage (fivelab-film.coax): which, its clock in steps, its front line's x in metres
  experimental_audio: [1] exsound.ExperimentalSound;
  respawn_id:int = -1;
  ride_dev: int;   // a local page's ?ride= or ?stage= (experimental-ride.coax lab_ride_dev): mounted, galloping, drawing on the horse, or a stage
  stage_at: f32;   // when a riding stage's rider sat down
  stage_hit: f32; stage_rein: f32;  // a horse-archer stage: when its shooting ended, and when the rider reined in (0: not yet)
  ride_view: int;  // a stage's &view=side or &view=rear: the camera beside or behind the rider, close (0: the stage's own)
  ride_land: bool; // X pressed on the dragon in the air: it comes down to land
  ride_fire_at: f32;   // the dragon-fire stage: when (stage seconds) the dragon breathed
  breath_dn: f32;   // how far down the breath was aimed (its torrent keeps that tilt as the dragon flies)
  breath_puff_at: f32 = -100;   // when the breath's torrent last left the dragon's jaws (experimental-ride.coax lab_breath_stream)
  drive: [] Drive;   // the agent driver (aethyr/agent/drive.coax), held by the face (fivelab-face.c): empty in checks, off until a driver speaks
  xc: [1] XcCombat;   // Experimental's combat and CLASSES column (experimental-combat.coax)
  creator: [1] cc.Creator;
  aribeth_state:[1]nwna.Aribeth;
  started: bool;
  battle: [1] RsBattle;
  seen: int;                       // the battle log's events already shown
  seed: u64;
  round: int;
  wins: [3] int;
  over: bool; over_t: f32; winner: int;
  army: [LAB_MAX] RsCreature; squares: [LAB_SQUARES] int;   // the battle's room (bt: rs_use)
  frame: [FRAME_FLOATS] f32;       // the frame store: the tokens and squares bg_fs reads
  shadow_draws: [4096] u32; shadow_n: int;
  records: [figs.BD_RECORDS * figs.BD_REC_FLOATS] f32;   // the figures' instances (fivelab-face.c's objects store)
  dx: [LAB_MAX] f32; dy: [LAB_MAX] f32;   // where each token is drawn, in squares
  acted: [LAB_MAX] f32;            // when each last took its turn
  fell: [LAB_MAX] f32;             // in the Horde, when each of the dead fell (0: standing)
  pool: int; raised: int;          // the Horde: the dead still to come, and how many have come
  lines: [LOG_LINES] Line; line_n: int; line_head: int;   // a ring: the oldest of line_n lines is at line_head
  fx: [FXS] Num; fx_at: int;   // the numbers floating off the figures
  puffs: [1] FxPuffs; fx_last: f32;   // the glade's effects as puffs (aethyr/fx/puff.coax), and the clock they last saw
  clock: f32;                      // the drawn clock
  pace: FrameClock;
  paused: bool; fast: bool;
  golden: bool; golden_ran: bool;
  width: f32; height: f32; dpr: f32;
  portrait: bool;
  gx: f32; gy: f32; cell: f32;
  panel: Rect; back: Rect; flip: Rect; modal: Rect;
  mode: int = MODE_ACTION;
  // Player mode (P): you play one hero of the Living, the class picked from the bar along the top
  player: bool; pick: int = 6; me: int = -1; act: int = ACT_ATTACK; target: int = -1;
  lw_q: [LW_RISING] int; lw_n: int;   // Finger of Death's dead waiting to rise (fivelab-warlock.coax)
  pbtn: Rect; picks: [12] Rect; slots: [SLOTS] Rect; down_x: f32; down_y: f32;
  horde: bool = true;   // the Horde (the default): every hero on one side, the dead running in from the edges
  // the Siege (fivelab-siege.coax): the town watch and the cult (its leader comes on top), each of
  // the watch's post on the line (y * cols + x), and the scenario button (H cycles Horde, Armies, Siege)
  siege: bool; town: int = SIEGE_TOWN; cult: int = SIEGE_CULT; post: [HEROES_MAX] int; posts: int; sbtn: Rect;
  stormed: bool;   // the swarm has reached the town (the leader's big spells wait for it)
  heroes: int = HEROES;   // the heroes' number
  skeletons: int = SKELETONS;   // the Restless Dead's number on the field at once (the tests field fewer, for the interpreter)
  stream: int = HORDE - SKELETONS;   // the dead the Horde sends in after its first wave
  cols: int = COLS; rows: int = ROWS;   // the grid (size_grid)
  // the army-size sliders: their tracks, the one being dragged (-1 none) and the numbers it shows
  // while dragged; the battle starts again at the new sizes when it lets go
  sliders: [3] Rect; sliding: int = -1; want: [3] int;
  asked: [3] int;   // a number asked past a slider's most (the address or a key), shown in red; 0 none
  ms: f32;   // the frame's time, milliseconds, averaged with the frames a second
  unlabelled: int;   // labels this frame left off for want of room in the strokes (SCENE_VERTS)
  cam_siege: bool;   // the Siege's camera is the home one (lab_view_home)
  scene_top: f32;    // floating numbers stay below this (the sliders)
  plates: [NP_MAX] Rect; plates_n: int;   // this frame's names over the figures (lab_heads3), which floating numbers keep off
  heads: [1] cc.HudPlates;                 // the frame's plates over the figures (lab_heads3: aethyr/ui/hud-plates.coax)
  signs: [1] cc.HudPlates;                 // the housewright showcase's labels on their boards (lab_showcase_titles)
  blk_up: [BLK_MAX * TEAMS] int; blk_w: int; blk_h: int;   // the standing by block and side (blk_count)
  due_t: [DUE_MAX] f32; due_i: [DUE_MAX] int; due_n: int;   // whose turn comes next (lab_due's heap)
  shown_n: int;   // the creatures the figures showed last frame (the slots past them are clear)
  pressing: int;
  // the glade's camera: an orbit round the clearing, and what it makes this frame
  view: int = VIEW_GLADE;
  yaw: f32 = 0; pitch: f32 = 0.6; dist: f32 = DIST;
  px: f32 = 0; pz: f32 = PIVOT_Z;   // the point it orbits, on the ground (metres)
  dragging: bool; drag_x: f32; drag_y: f32;
  panning: bool; shift: bool;       // Shift held: a drag pans
  fps: f32; fps_n: int; fps_t: f32;   // frames a second, counted over each half second
  held: int; vx: f32; vz: f32; vyaw: f32; vpitch: f32; vzoom: f32;   // keys held (HOLD_*), and how the camera flies
  fingers: int; fing_id: [2] int; fing_x: [2] f32; fing_y: [2] f32;   // touches down, for a pinch
  eye: P3; fwd: P3; right: P3; up: P3; focal: f32; cx: f32; cy: f32;
  // the figures (fivelab-bodies.coax): their playback, and the squares the Horde filled afresh
  bodies: [1] figs.Bodies; fresh: [LAB_MAX] bool;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  // Player mode's camera and your body: Everglade's free orbit (aethyr/camera.coax) behind the body
  // Everglade's controller walks (fivelab-face.c: aethyr/walk.coax through everglade-step.coax)
  orbit: figs.Orbit; look_yaw: f32; look_pitch: f32;   // a drag's look, spent each frame
  blend: f32;                       // 0 the spectator's camera, 1 the follow camera; it swings between
  you_on: bool; you_me: int = -1;   // the face walked your body this frame; the hero it is
  you_x: f32; you_y: f32; you_z: f32; you_face: f32;   // your body's feet (metres) and facing
  put_on: bool; put_x: f32; put_y: f32; put_z: f32; put_face: f32;
  safe_on: bool; safe_x: f32; safe_y: f32; safe_z: f32; safe_face: f32;   // the face puts your body here first
  my_sx: int; my_sy: int;           // your token's square as your last turn (or the put) left it
  move_bodies: [LAB_NEAR_BODIES * 7] f32;   // the figures round you, capsules for the controller
  village_near: [1] village.EvNear;
  touch: bool; stick_on: bool; stick_ox: f32; stick_oy: f32; stick_px: f32; stick_py: f32;   // the thumb's stick (aethyr/sticks.coax)
  env: [U_ENV_WORDS] f32; env_n: int;   // the light: the painterly default resolved at the page's fixed noon, once (lab_light)
}

// ---- small things

GAP :: 0.5; SPACE :: 1.2;
lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }

text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
put :: (buf: [] u8, at: int, text: string) -> int { return rs_put(buf, at, text); }
put_int :: (buf: [] u8, at: int, v: int) -> int { return rs_put_int(buf, at, v); }
// The battle, in the room the lab gives it (army and squares: more than a battle holds of its own).
bt :: (s: [] Lab) -> [] RsBattle {
  if s[0].battle[0].c.count != LAB_MAX { rs_use(s[0].battle[..], s[0].army[..], s[0].squares[..]); }
  return s[0].battle[..];
}
dice :: (s: [] Lab) -> [] RsDice { return s[0].battle[0].dice[..]; }

// A figure's look in the glade (gpu/fivelab.coax): its class's, plus 16 for each team past the first.
look_of :: (klass: int) -> int {
  if klass == RS_WARLOCK { return 1; }
  if klass == RS_BARBARIAN { return 2; }
  if klass == RS_MONK { return 3; }
  if klass == RS_MONSTER { return 4; }
  if klass == RS_WIZARD { return 5; }
  if klass == RS_BARD { return 6; }
  if klass == RS_CLERIC { return 7; }
  if klass == RS_FIGHTER { return 8; }
  if klass == RS_PALADIN { return 9; }
  if klass == RS_RANGER { return 10; }
  if klass == RS_ROGUE { return 11; }
  if klass == RS_SORCERER { return 12; }
  return 0;
}
rgb_col :: (c: FxV) -> Col { return Col.{r = c.x, g = c.y, b = c.z}; }
// A spell's light (aethyr/fx/spell-light.coax), which Everglade II's casts share.
spell_rgb :: (sp: int) -> Col { return rgb_col(fxl_spell_rgb(sp)); }

// ---- the log

add_line :: (s: [] Lab, t: string, c: Col) {
  if s[0].line_n == LOG_LINES {
    s[0].line_head = (s[0].line_head + 1) % LOG_LINES;
    s[0].line_n -= 1;
  }
  k := (s[0].line_head + s[0].line_n) % LOG_LINES;
  s[0].lines[k].n = put(s[0].lines[k].text[..], 0, t); s[0].lines[k].col = c;
  s[0].line_n += 1;
}
add_num :: (s: [] Lab, f: Num) {
  g := f; g.t0 = s[0].battle[0].clock;
  s[0].fx[s[0].fx_at] = g;
  s[0].fx_at = (s[0].fx_at + 1) % FXS;
}
// What the battle told since the last look: into the log, and into effects on the grid.
take_events :: (s: [] Lab) {
  if s[0].battle[0].book[0].seq == s[0].seen { return; }
  book := s[0].battle[0].book[..];
  fresh := rs_min(book[0].seq - s[0].seen, book[0].count);
  s[0].seen = book[0].seq;
  k := fresh - 1;
  rep_by := -1; rep_spell := -1; rep_t: f32 = -1; rep_n := 0;
  // one spell's damage to many at once (a Fireball, a Circle of Death): its numbers fold
  g: [HIT_GROUPS] HitGroup; ng := hit_groups(s, book, fresh, g[..]);
  while k >= 0 {
    e := rs_recent_at(book, k);
    k -= 1;
    t := cast(string) e.text[0..<e.text_n];
    c := DIM;
    if e.kind == RS_EV_CAST { c = WHITE; }
    if e.kind == RS_EV_DAMAGE { c = Col.{r = 1.0, g = 0.55, b = 0.4}; }
    if e.kind == RS_EV_HEAL || e.kind == RS_EV_UP { c = GREEN; }
    if e.kind == RS_EV_CONDITION { c = VIOLET; }
    if e.kind == RS_EV_DOWN || e.kind == RS_EV_DEATH { c = RED; }
    if e.kind == RS_EV_END || e.kind == RS_EV_STABLE { c = FAINT; }
    if e.text_n > 0 { add_line(s, t, c); }
    f: Num;
    if (e.kind == RS_EV_DAMAGE || e.kind == RS_EV_HEAL || e.kind == RS_EV_MISS) && hit_shown(s, e, g[0..<ng]) {
      f.kind = FX_TEXT; f.life = 1.2;
      f.col = ifx e.kind == RS_EV_HEAL then GREEN else ifx e.kind == RS_EV_MISS then DIM else RED;
      f.ax = f32(s[0].battle[0].c[e.to].x); f.ay = f32(s[0].battle[0].c[e.to].y);
      if e.kind == RS_EV_MISS { f.n = put(f.text[..], 0, "MISS"); }
      else { f.n = put(f.text[..], 0, ifx e.kind == RS_EV_HEAL then "+" else "-"); f.n = put_int(f.text[..], f.n, e.amount); }
      add_num(s, f);
    }
    // the glade's effects: rays and bolts of one cast leave one after another
    if e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS {
      if e.by == rep_by && e.spell == rep_spell && e.at - rep_t < 0.01 && e.spell >= 0 { rep_n = rs_min(rep_n + 1, 4); } else { rep_n = 0; }
      rep_by = e.by; rep_spell = e.spell; rep_t = e.at;
    }
    cue_event(s, e);
    lw_heard(s, e);
    lab_effect(s, e, f32((book[0].seq - k) % 8192) * 0.37 + 0.11, e.at + ifx e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS then f32(rep_n) * 0.14 else 0);
  }
  // each fold's total, gold, over the middle of those it hit: "-412 · 14 HIT"
  for q: 0..<ng {
    if g[q].count < HIT_FOLD { continue; }
    f: Num; f.kind = FX_TEXT; f.life = 1.8; f.col = GOLD;
    f.ax = g[q].sx / f32(g[q].count); f.ay = g[q].sy / f32(g[q].count) - 1.2;
    f.n = put(f.text[..], 0, "-"); f.n = put_int(f.text[..], f.n, g[q].total); f.n = put(f.text[..], f.n, " · ");
    f.n = put_int(f.text[..], f.n, g[q].count); f.n = put(f.text[..], f.n, " HIT");
    add_num(s, f);
  }
}
// A spell's damage to many in one go: HIT_FOLD or more of one caster's spell at one moment. Its
// biggest HIT_SHOW numbers float, and those on your hero or your target; the rest fold into one
// total over them. The log keeps every roll.
HIT_GROUPS :: 8; HIT_FOLD :: 4; HIT_SHOW :: 3;
HitGroup :: struct { by: int; spell: int; at: f32; count: int; total: int; sx: f32; sy: f32; top: [HIT_SHOW] int; shown: int; }
hit_group_of :: (e: RsEvent, g: [] HitGroup) -> int {
  for q: 0..<g.count { if g[q].by == e.by && g[q].spell == e.spell && g[q].at - e.at < 0.01 && e.at - g[q].at < 0.01 { return q; } }
  return -1;
}
hit_groups :: (s: [] Lab, book: [] RsLog, fresh: int, g: [] HitGroup) -> int {
  ng := 0; b := bt(s);
  for k: 0..<fresh {
    e := rs_recent_at(book, k);
    if e.kind != RS_EV_DAMAGE || e.spell < 0 || e.to < 0 || e.to >= b[0].n { continue; }
    q := hit_group_of(e, g[0..<ng]);
    if q < 0 {
      if ng >= g.count { continue; }
      q = ng; ng += 1;
      g[q].by = e.by; g[q].spell = e.spell; g[q].at = e.at; g[q].count = 0; g[q].total = 0; g[q].sx = 0; g[q].sy = 0; g[q].shown = 0;
      for h: 0..<HIT_SHOW { g[q].top[h] = -1; }
    }
    g[q].count += 1; g[q].total += e.amount;
    g[q].sx += f32(b[0].c[e.to].x); g[q].sy += f32(b[0].c[e.to].y);
    // the biggest HIT_SHOW amounts, largest first
    v := e.amount;
    for h: 0..<HIT_SHOW { if v > g[q].top[h] { w := g[q].top[h]; g[q].top[h] = v; v = w; } }
  }
  return ng;
}
// Whether event e's number floats: always, unless it's in a fold and neither among its biggest
// nor on your hero or your target.
hit_shown :: (s: [] Lab, e: RsEvent, g: [] HitGroup) -> bool {
  if e.kind != RS_EV_DAMAGE { return true; }
  q := hit_group_of(e, g);
  if q < 0 || g[q].count < HIT_FOLD { return true; }
  if e.to == s[0].me || e.to == s[0].target || e.to == s[0].you_me { return true; }
  if g[q].shown < HIT_SHOW && e.amount >= g[q].top[HIT_SHOW - 1] { g[q].shown += 1; return true; }
  return false;
}
// One battle event as the figures' clips: a blow swings, a cast or a shot plays the spell clip, a
// hurt figure is knocked back (fivelab-bodies.coax figs.bd_cue).
cue_event :: (s: [] Lab, e: RsEvent) {
  b := bt(s);
  if e.by < 0 || e.by >= b[0].n { return; }
  now := b[0].clock;
  aimed := e.to >= 0 && e.to < b[0].n && e.to != e.by;
  tx := ifx aimed then wx(s, s[0].dx[e.to]) else 0.0f32; tz := ifx aimed then wz(s, s[0].dy[e.to]) else 0.0f32;
  if (e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS) && aimed {
    melee := e.spell < 0 && rs_feet_to(b, e.by, e.to) <= 5;
    figs.bd_cue(s[0].bodies[..], e.by, ifx melee then figs.BD_SLASH else figs.BD_SPELL, now, tx, tz, true);
    return;
  }
  if e.kind == RS_EV_CAST { figs.bd_cue(s[0].bodies[..], e.by, figs.BD_SPELL, now, tx, tz, aimed); return; }
  if e.kind == RS_EV_DAMAGE && e.to >= 0 && e.to < b[0].n && b[0].c[e.to].hp > 0 { figs.bd_cue(s[0].bodies[..], e.to, figs.BD_KNOCK, now, 0, 0, false); }
}
// The figures this frame, from the battle: each creature's look, square and state. It reads the
// creatures in place (a copy of one is 1.5 KB, and there can be two thousand of them).
put_bodies :: (s: [] Lab) {
  b := bt(s);
  // your figure is your body: where it stands, and in squares for the labels and rings
  me := s[0].me;
  if s[0].player && me >= 0 && s[0].you_me == me {
    s[0].dx[me] = (s[0].you_x + f32(s[0].cols) * f32(SQ) / 2) / f32(SQ) - 0.5;
    s[0].dy[me] = (s[0].you_z + f32(s[0].rows) * f32(SQ) / 2) / f32(SQ) - 0.5;
  }
  for i: 0..<figs.BD_SLOTS {
    if i >= b[0].n { if i < s[0].shown_n { figs.bd_clear(s[0].bodies[..], i); continue; } break; }
    cd := b[0].c[i].cond;
    marks := 0;
    if cd & RS_RESTRAINED != 0 { marks += 1; }
    if cd & RS_POISONED != 0 { marks += 2; }
    if cd & RS_BLINDED != 0 { marks += 4; }
    if has_eff(b, i, EF_ENFEEBLED) { marks += 8; }
    if b[0].c[i].temp > 0 { marks += 16; }
    if cd & RS_PARALYZED != 0 { marks += 32; }
    if has_eff(b, i, EF_HEX) { marks += 64; }
    state := ifx b[0].c[i].dead then 2 else ifx b[0].c[i].hp == 0 then 1 else 0;
    kl := b[0].c[i].klass;
    // the second of each class, and every other skeleton, looks a little different
    v := ifx kl == RS_MONSTER then (i * 7 / 3) % 2 else (i / 12) % 2;
    look := ifx b[0].c[i].npc != RS_NPC_NONE then siege_look(b[0].c[i].npc) else look_of(kl);
    figs.bd_put(s[0].bodies[..], i, s[0].fresh[i], look, v, wx(s, s[0].dx[i]), wz(s, s[0].dy[i]), state, f32(marks), ifx b[0].c[i].outlined_by >= 0 then 1.0f32 else 0.0f32, b[0].clock);
    s[0].fresh[i] = false;
  }
  s[0].shown_n = b[0].n;
  if s[0].player && me >= 0 && s[0].you_me == me && !b[0].c[me].dead && b[0].c[me].hp > 0 { figs.bd_own(s[0].bodies[..], me, s[0].you_y, s[0].you_face); }
  figs.bd_frame(s[0].bodies[..], b[0].clock);
}
// Whether creature i is under an effect of `kind` (rs_effect, without copying the creature).
has_eff :: (b: [] RsBattle, i: int, kind: int) -> bool {
  for k: 0..<RS_EFFECTS { if b[0].c[i].eff[k].kind == kind { return true; } }
  return false;
}
// The pack's catalog arrived (fivelab-face.c): the figures' parts.
lab_catalog :: (s: [] Lab, text: string) #export_c #effects(all) { figs.bd_catalog(s[0].bodies[..], text); s[0].creator[0].aribeth=s[0].aribeth_state[..];cc.catalog(s[0].creator[..], text); }
// The clips baked into the bake store, once (fivelab-face.c).
lab_bake :: (s: [] Lab, d: [] figs.People, out: [] f32) #export_c #effects(all) { figs.people_load(d); figs.bd_bake(d, out, s[0].creator[0].dev_animations); figs.bd_bake_owned(out); figs.bd_bake_bow(d, out); figs.bd_keep_hands(s[0].bodies[..], d, out); }
// Existing optional layer-size hook: Character Create owns its quality choice.
lab_layers_side :: (s:[]Lab)->int #export_c #effects(all) {return cc.texture_side(s[0].creator[0]);}
// Character Create's shadow tiles for the host (coaxial_shadow_*_v1; charactercreator.coax shadow_frame): none on the lab's own pages.
lab_shadow_atlas :: (s:[]Lab,coarse:int,which:int)->int #export_c #effects(all) {return cc.shadow_atlas(s[0].creator[0],coarse!=0,which);}
lab_shadow_field :: (s:[]Lab,field:int)->int #export_c #effects(all) {return cc.shadow_field(s[0].creator[0],field);}
lab_shadow_event :: (s:[]Lab,kind:int,arg:int) #export_c #effects(all) {if s[0].creator[0].on {cc.shadow_event(s[0].creator[..],kind,arg);}}
// The shader already clips grass in both shadow tiles and static glade meshes
// in the player tile. Do not submit those vertices to the GPU in the first place.
lab_shadow_select :: (s: [] Lab) {
  s[0].shadow_n = 0;
  for i: 0..<s[0].bodies[0].draw_n {
    base := s[0].bodies[0].draws[i*4+2];
    if s[0].creator[0].on {
      if base >= 65536 { continue; }
      if s[0].creator[0].shadow[0].on && !s[0].creator[0].shadow[0].now && s[0].records[cast(int) base*24+15] > 11.5 { continue; }
      // the dungeon's inside (charactercreator.coax): under its roof, it casts no sun shadow
      if s[0].records[cast(int) base*24+15] > 15.5 && s[0].records[cast(int) base*24+15] < 16.5 && s[0].records[cast(int) base*24+14] > 0.5 { continue; }
      // a build site's parts (charactercreator.coax build_record): they grow, so the cached glade tile can't hold them
      if s[0].records[cast(int) base*24+15] > 18.5 && s[0].records[cast(int) base*24+13] > 6.5 { continue; }
    }
    j := s[0].shadow_n;
    for k: 0..<4 { s[0].shadow_draws[j*4+k] = s[0].bodies[0].draws[i*4+k]; }
    s[0].shadow_n += 1;
  }
}
// The figures' instances for the frame (the objects store) and their draws; the count of draws.
lab_scene :: (s: [] Lab, out: [] f32) -> int #export_c #effects(all) {
  if s[0].creator[0].on {
    n := cc.scene_reserved(s[0].creator[..],s[0].bodies[..],out,ifx s[0].creator[0].experimental then 2 else 0);
    if s[0].creator[0].experimental {
      n=xc_familiar_draw(s,out,n);n=xd_draw(s,out,n);
      if n<s[0].bodies[0].draws.count/4 { n=xc_objects_draw(s,out,n); }
    }
    lab_shadow_select(s);
    // first person (charactercreator.coax cc_self_hidden): your body still casts its shadow, but isn't drawn from your eyes
    for i: 0..<s[0].bodies[0].self_n { s[0].bodies[0].draws[i*4+1] = 0; }
    return n;
  }
  if !s[0].started || s[0].view != VIEW_GLADE { s[0].bodies[0].draw_n = 0; s[0].shadow_n = 0; return 0; }
  c := figs.BdCam.{ex = s[0].eye.x, ey = s[0].eye.y, ez = s[0].eye.z, fx = s[0].fwd.x, fy = s[0].fwd.y, fz = s[0].fwd.z,
              rx = s[0].right.x, ry = s[0].right.y, rz = s[0].right.z, ux = s[0].up.x, uy = s[0].up.y, uz = s[0].up.z,
              focal = s[0].focal, cx = s[0].cx, cy = s[0].cy, w = s[0].width, h = s[0].height};
  r := figs.bd_build(s[0].bodies[..], c, out);
  // none in view: one empty draw still, so host.js draws the effects after the scene
  if s[0].bodies[0].draw_n == 0 && s[0].bodies[0].ready {
    for k: 0..<4 { s[0].bodies[0].draws[k] = 0; }
    s[0].bodies[0].draw_n = 1;
  }
  lab_shadow_select(s);
  return s[0].bodies[0].draw_n;
}
// Where the battle's grid lies in the glade (wx, wz), for the shared effects (aethyr/fx/battle.coax).
lab_grid :: (s: [] Lab) -> FxeGrid { return FxeGrid.{x0 = -f32(s[0].cols) * f32(SQ) / 2, z0 = -f32(s[0].rows) * f32(SQ) / 2, sq = f32(SQ)}; }
// One battle event as the glade's effect (aethyr/fx/battle.coax), with what only the Lab knows: the
// foe a Cunning Action's Dash runs from or a Flurry of Blows strikes, and where the figure is drawn.
lab_effect :: (s: [] Lab, e: RsEvent, seed: f32, t0: f32) {
  b := bt(s);
  if e.by < 0 || e.by >= b[0].n { return; }
  foe := ifx e.feat == RS_FT_CUNNING_DASH then nearest_foe(s, e.by) else ifx e.feat == RS_FT_FLURRY then foe_at_hand(s, e.by, -1) else -1;
  g := lab_grid(s);
  fxe_event(s[0].puffs[..], b, g, e, seed, t0, FxeSeen.{foe = foe, was = fxe_point(g, s[0].dx[e.by], s[0].dy[e.by], 0)});
}
// What lasts on a creature, as the glade draws it (aethyr/fx/abilities.coax fxp_status): its
// conditions, concentration, Rage, Sacred Weapon, Innate Sorcery, a flame in hand and a Fiend's
// Temporary Hit Points from Dark One's Blessing.
// Its conditions' marks are the shared condition display's (aethyr/rules/srd/condition-display.coax).
fx_marks :: (s: [] Lab, i: int) -> int {
  b := bt(s);
  if b[0].c[i].dead || b[0].c[i].hp == 0 { return 0; }
  now := b[0].clock;
  f := cd_icons(b[0].c[i].cond);
  if b[0].c[i].conc >= 0 { f = f | FXS_CONCENTRATING; }
  if b[0].c[i].raging { f = f | FXS_RAGING; }
  if b[0].c[i].sacred_until > now { f = f | FXS_SACRED; }
  if b[0].c[i].innate_until > now { f = f | FXS_INNATE; }
  if b[0].c[i].flame_until > now { f = f | FXS_FLAME; }
  if b[0].c[i].dark_blessing && b[0].c[i].temp > 0 { f = f | FXS_FIEND; }
  return f;
}

// ---- a battle

// The Horde's flood: a second after one of the dead falls, a fresh Skeleton takes its place on a
// free square of the grid's two outer rings and runs in, until the Horde has sent all it has.
flood :: (s: [] Lab) {
  b := bt(s);
  edge := ring_size(s, 0) + ring_size(s, 1);
  for i: s[0].heroes..<b[0].n {
    if s[0].pool <= 0 { return; }
    if !b[0].c[i].dead { continue; }
    if s[0].fell[i] == 0 { s[0].fell[i] = b[0].clock; continue; }
    if b[0].clock - s[0].fell[i] < 1 { continue; }
    for t: 0..<8 {
      e := band_cell(s, 0, 2, rs_min(edge - 1, int(rs_unit(dice(s)) * f32(edge))));
      x := e % s[0].cols; y := e / s[0].cols;
      if rs_at(b, x, y) >= 0 { continue; }
      s[0].raised += 1; s[0].pool -= 1;
      nm: [16] u8;
      nn := put(nm[..], 0, "Skeleton "); nn = put_int(nm[..], nn, s[0].raised);
      ox := b[0].c[i].x; oy := b[0].c[i].y;
      b[0].c[i] = rs_skeleton(cast(string) nm[0..<nn], 2);
      b[0].c[i].x = ox; b[0].c[i].y = oy;
      rs_place(b, i, x, y);   // its body's square comes free
      b[0].c[i].turn_at = b[0].clock + 0.2 + rs_unit(dice(s)) * rs_beat(b);
      b[0].c[i].round_at = b[0].c[i].turn_at;
      due_push(s, i);
      s[0].dx[i] = f32(x); s[0].dy[i] = f32(y); s[0].acted[i] = b[0].clock; s[0].fell[i] = 0; s[0].fresh[i] = true;
      break;
    }
  }
}
ACT_ATTACK :: 0;   // the hotbar's first slot, always Attack; keys 1 to 9 pick a slot
HORDE :: 1000;   // the dead the Horde sends in all by default, SKELETONS at a time (the stream: the rest)
// The grid for the armies: 40 by 20 for the lab's 208, about four squares a figure past that.
size_grid :: (s: [] Lab) {
  total := ifx s[0].siege then s[0].town + s[0].cult + 1 else s[0].heroes + s[0].skeletons;
  area := rs_max(COLS * ROWS, (total * 50 + 12) / 13);
  r := ROWS;
  while 2 * r * r < area && r < ROWS_MAX { r += 1; }
  was := s[0].cols;
  s[0].rows = r; s[0].cols = 2 * r;
  if s[0].cols != was || s[0].siege != s[0].cam_siege { lab_view_home(s); }   // a grid of another size or the Siege: the camera backs off to see it all
}
// The ring d squares in from the grid's edge: its squares, and its n-th square (y * cols + x),
// clockwise from its top-left corner.
ring_size :: (s: [] Lab, d: int) -> int {
  w := s[0].cols - 2 * d; h := s[0].rows - 2 * d;
  if w <= 0 || h <= 0 { return 0; }
  if w == 1 || h == 1 { return w * h; }
  return 2 * w + 2 * h - 4;
}
ring_cell :: (s: [] Lab, d: int, n: int) -> int {
  x0 := d; y0 := d; x1 := s[0].cols - 1 - d; y1 := s[0].rows - 1 - d;
  w := x1 - x0 + 1; h := y1 - y0 + 1;
  if w == 1 || h == 1 { return (y0 + ifx w == 1 then n else 0) * s[0].cols + x0 + ifx w == 1 then 0 else n; }
  k := n;
  if k < w { return y0 * s[0].cols + x0 + k; }
  k -= w;
  if k < h - 1 { return (y0 + 1 + k) * s[0].cols + x1; }
  k -= h - 1;
  if k < w - 1 { return y1 * s[0].cols + x1 - 1 - k; }
  k -= w - 1;
  return (y1 - 1 - k) * s[0].cols + x0;
}
// The n-th square of the rings first..first+count-1 together.
band_cell :: (s: [] Lab, first: int, count: int, n: int) -> int {
  k := n;
  for d: first..<(first + count) {
    rs := ring_size(s, d);
    if k < rs { return ring_cell(s, d, k); }
    k -= rs;
  }
  return ring_cell(s, first, 0);
}
// Where the Horde's q-th Skeleton starts: spread over the two outer rings, then the next two in.
spawn_cell :: (s: [] Lab, q: int) -> int {
  k := q; d := 0;
  while d < s[0].rows / 2 {
    band := ring_size(s, d) + ring_size(s, d + 1);
    if band <= 0 { break; }
    if k < band { return band_cell(s, d, 2, (k * 97) % band); }
    k -= band; d += 2;
  }
  return 0;
}
// The free square nearest (x, y), or (x, y) when the grid is full.
free_near :: (s: [] Lab, x: int, y: int) -> int {
  b := bt(s);
  for r: 0..<(s[0].cols + s[0].rows) {
    for oy: -r..<(r + 1) {
      for ox: -r..<(r + 1) {
        if rs_max(rs_abs(ox), rs_abs(oy)) != r { continue; }
        nx := x + ox; ny := y + oy;
        if nx < 0 || ny < 0 || nx >= s[0].cols || ny >= s[0].rows || rs_at(b, nx, ny) >= 0 { continue; }
        return ny * s[0].cols + nx;
      }
    }
  }
  return y * s[0].cols + x;
}
// A creature onto the grid at (x, y), or the free square nearest it; its index.
place_on :: (s: [] Lab, c: RsCreature, x: int, y: int) -> int {
  e := free_near(s, rs_max(0, rs_min(s[0].cols - 1, x)), rs_max(0, rs_min(s[0].rows - 1, y)));
  i := rs_add(bt(s), c, e % s[0].cols, e / s[0].cols);
  if i >= 0 { s[0].dx[i] = f32(e % s[0].cols); s[0].dy[i] = f32(e / s[0].cols); s[0].acted[i] = -10; }
  return i;
}
// Hero i: company i / 48 (a side's 24 of each), its side and its class; casters are the first 12
// of each side's 24.
hero_team :: (i: int) -> int { return (i % (2 * SIDE)) / SIDE; }
hero_caster :: (i: int) -> bool { return i % SIDE < CASTERS; }
hero_class :: (i: int) -> int { k := i % SIDE; return ROSTER[(k / CASTERS) * 6 + k % 6]; }
// Hero i's name: the 48 names, then again with the company's number.
hero_name :: (i: int, out: [] u8) -> int {
  n := put(out, 0, NAMES[i % 48]);
  if i >= 48 { n = put(out, n, " "); n = put_int(out, n, i / 48 + 1); }
  return n;
}
// The Horde's ground: the heroes hold a block mid-glade (8 by 6 for 48), the casters at its heart
// and the rest round its rim; inner squares first in `cells`, the block's count returned.
hold_block :: (s: [] Lab, cells: [] int) -> int {
  h := s[0].heroes;
  bw := 8; while 3 * bw * bw < 4 * h { bw += 1; }
  bh := rs_max(6, (h + bw - 1) / bw);
  hx := s[0].cols / 2 - bw / 2; hy := s[0].rows / 2 - bh / 2;
  deep := (rs_min(bw, bh) - 1) / 2;
  n := 0;
  d := deep;
  while d >= 0 {
    for y: 0..<bh { for x: 0..<bw {
      if rs_min(rs_min(x, y), rs_min(bw - 1 - x, bh - 1 - y)) != d || n >= cells.count { continue; }
      cells[n] = (hy + y) * s[0].cols + hx + x; n += 1;
    } }
    d -= 1;
  }
  return n;
}
// A side's files in the armies' battle: the casters' two back files a pair at a time (each file
// cap deep, staggered), a file's gap, then the rest's. Hero m of its kind on side `team`.
file_cell :: (s: [] Lab, team: int, caster: bool, m: int, casters: int) -> int {
  cap := rs_max(2, (s[0].rows - 2) / 3);
  g := m / (2 * cap); q := m % (2 * cap);
  x := 1 + 2 * g + q % 2;
  if !caster { x += 2 * ((casters + 2 * cap - 1) / (2 * cap)) + 1; }
  y := 1 + q * (s[0].rows - 3) / (2 * cap - 1);
  if team == 1 { x = s[0].cols - 1 - x; }
  return y * s[0].cols + x;
}
new_battle :: (s: [] Lab) {
  size_grid(s);
  b := bt(s);
  rs_reset(b);
  b[0].w = s[0].cols; b[0].h = s[0].rows;
  s[0].lw_n = 0;
  s[0].seed += 1;
  b[0].dice[0].state = s[0].seed * 7919 + 17;
  hs := rs_min(s[0].heroes, HEROES_MAX); sk := rs_min(s[0].skeletons, SKELETONS_MAX);
  if s[0].siege { hs = 0; sk = 0; siege_battle(s); }   // the Siege fields its own (fivelab-siege.coax)
  // the heroes: a block mid-glade in the Horde, else each side in files on its own edge
  cells: [HEROES_MAX] int;
  nb := ifx s[0].horde then hold_block(s, cells[..]) else 0;
  casters: [2] int; for i: 0..<hs { if hero_caster(i) { casters[film_hero_team(s, i)] += 1; } }
  seen_c: [2] int; seen_m: [2] int; inner := 0; outer := 0;
  nm: [24] u8;
  west := 0;   // the armies film's heroes' front file
  for i: 0..<hs {
    team := film_hero_team(s, i); caster := hero_caster(i);
    nn := hero_name(i, nm[..]);
    who := hero_for(hero_class(i), cast(string) nm[0..<nn], team, LEVEL);
    e := 0;
    if s[0].horde {
      // the casting classes inside, the rest round them
      e = ifx caster then cells[rs_min(inner, nb - 1)] else cells[rs_max(nb - 1 - outer, 0)];
      if caster { inner += 1; } else { outer += 1; }
      who.team = 0;
    } else {
      e = file_cell(s, team, caster, ifx caster then seen_c[team] else seen_m[team], casters[team]);
      if caster { seen_c[team] += 1; } else { seen_m[team] += 1; }
    }
    j := place_on(s, who, e % s[0].cols, e / s[0].cols);
    west = rs_max(west, e % s[0].cols);
  }
  // the dead: in the Horde on the outer rings, else a block mid-glade (16 wide, ten deep for 160)
  aw := 16; while 5 * aw * aw < 8 * sk { aw += 1; }
  ah := (sk + aw - 1) / aw;
  ax := s[0].cols / 2 - aw / 2; ay := s[0].rows / 2 - ah / 2;
  // the armies film: the dead a block as tall as the heroes' files, close across from them, every
  // other square staggered so the ranks behind can get past the fallen to the front
  film := s[0].film == FILM_ARMIES && sk > 0;
  if film {
    ah = s[0].rows - 2; aw = 2 * ((sk + ah - 1) / ah) + 1; ay = 1; ax = rs_min(west + FILM_ARMIES_GAP, s[0].cols - aw);
    s[0].film_x = wx(s, f32(west + ax) / 2);
  }
  for q: 0..<sk {
    x := ax + q % aw; y := ay + q / aw;
    if film { x = ax + 2 * (q / ah) + (q % ah) % 2; y = ay + q % ah; }
    if s[0].horde { e := spawn_cell(s, q); x = e % s[0].cols; y = e / s[0].cols; }
    nn := put(nm[..], 0, "Skeleton "); nn = put_int(nm[..], nn, q + 1);
    j := place_on(s, rs_skeleton(cast(string) nm[0..<nn], 2), x, y);
  }
  s[0].battle[0].clock = 0;
  // Action mode is a house profile: its timing, and no caster caught in its own blast; round mode is strict.
  if s[0].mode == MODE_ACTION { world_selected := rs_set_world(s[0].battle[..],RS_ACTION_WORLD); }
  rs_begin(bt(s));
  bt(s)[0].kept = true;   // every move here goes through rs_add and rs_place
  due_all(s);
  s[0].seen = s[0].battle[0].book[0].seq;
  s[0].over = false; s[0].winner = -1;
  if s[0].player { pick_hero(s); }
  s[0].pool = ifx s[0].horde && !s[0].siege then rs_min(s[0].stream, HORDE_MAX) else 0; s[0].raised = sk;
  for i: 0..<LAB_MAX { s[0].fell[i] = 0; }
  s[0].round += 1;
  for i: 0..<FXS { s[0].fx[i].kind = 0; }
  l: [LINE_CAP] u8;
  n := put(l[..], 0, "Battle ");
  n = put_int(l[..], n, s[0].round);
  n = put(l[..], n, ifx s[0].mode == MODE_ACTION then ", action combat" else ", SRD rounds");
  if s[0].siege { n = siege_title(s, l[..], n); }
  else if s[0].horde { n = put(l[..], n, ": the Horde. "); n = put_int(l[..], n, hs); n = put(l[..], n, " heroes on one side, and "); n = put_int(l[..], n, sk); n = put(l[..], n, " skeletons run at them."); }
  else { n = put(l[..], n, ": "); n = put_int(l[..], n, hs); n = put(l[..], n, " heroes, two sides, and "); n = put_int(l[..], n, sk); n = put(l[..], n, " skeletons."); }
  add_line(s, cast(string) l[0..<n], GOLD);
  // the first 48's initiative, six to a line
  rows_ := (rs_min(hs, 48) + 5) / 6;
  for row: 0..<rows_ {
    m := put(l[..], 0, " ");
    for c: 0..<6 {
      i := row * 6 + c;
      if i >= rs_min(hs, 48) { break; }
      m = put(l[..], m, " "); m = put(l[..], m, NAMES[i]); m = put(l[..], m, " ");
      m = put_int(l[..], m, s[0].battle[0].c[i].initiative);
    }
    add_line(s, cast(string) l[0..<m], TEAM_COL[(row * 6) / SIDE]);
  }
}
hero_for :: (klass: int, name: string, team: int, level: int) -> RsCreature {
  if klass == RS_WIZARD { return rs_wizard(name, team, level); }
  if klass == RS_WARLOCK { return rs_warlock(name, team, level, SP_ELDRITCH_BLAST); }
  if klass == RS_BARBARIAN { return rs_barbarian(name, team, level); }
  if klass == RS_MONK { return rs_monk(name, team, level); }
  if klass == RS_BARD { return rs_bard(name, team, level); }
  if klass == RS_CLERIC { return rs_cleric(name, team, level); }
  if klass == RS_FIGHTER { return rs_fighter(name, team, level); }
  if klass == RS_PALADIN { return rs_paladin(name, team, level); }
  if klass == RS_RANGER { return rs_ranger(name, team, level); }
  if klass == RS_ROGUE { return rs_rogue(name, team, level); }
  if klass == RS_SORCERER { return rs_sorcerer(name, team, level); }
  return rs_druid(name, team, level);
}
lab_start :: (s: [] Lab) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].seed = 5;
  new_battle(s);
}

// ---- how a druid decides (the world's; the rules are the engine's)

// ---- who is near: a big battle asks the squares, not every creature
//
// Past NEAR_SCAN creatures a turn's questions ("which foes are within 60 feet?") look over the
// squares round the asker through the battle's index (battle.coax occ) rather than over every
// creature, and the nearest foe is found block by block (BLK squares a side, each block's
// standing creatures counted by side once a step: blk_count). A small battle asks every creature
// in order, as it always has, so its rolls come out the same.
NEAR_SCAN :: 400;
NEAR_MAX :: 3721;   // the squares within 150 feet (61 by 61): the farthest any routine here asks
NEAR_5 :: 9;    // the squares within 5 ft, and within 20 ft: foe_at_hand's and foes_near's few (a buffer is zeroed a call)
NEAR_20 :: 81;
BLK :: 8;
BLK_MAX :: 1152;    // (384 / 8) by (192 / 8) blocks
// The creatures within `feet` of square (x, y), the dead too (the asker decides), into ids: a small
// battle's in index order, a big one's by square. How many.
near_ids :: (s: [] Lab, x: int, y: int, feet: int, ids: [] int) -> int {
  b := bt(s);
  n := 0;
  r := feet / RS_SQUARE;
  if b[0].n <= NEAR_SCAN || !rs_indexed(b) || r > 30 {
    for j: 0..<b[0].n {
      // one a square on the grid (off it, a creature is not in the battle): ids holds the squares in reach
      if b[0].c[j].x >= 0 && b[0].c[j].y >= 0 && rs_feet(x, y, b[0].c[j].x, b[0].c[j].y) <= feet && n < ids.count { ids[n] = j; n += 1; }
    }
    return n;
  }
  w := b[0].w;
  y0 := rs_max(0, y - r); y1 := rs_min(b[0].h - 1, y + r);
  x0 := rs_max(0, x - r); x1 := rs_min(w - 1, x + r);
  row := y0;
  while row <= y1 {
    col := x0;
    while col <= x1 {
      k := b[0].occ[row * w + col] - 1;
      if k >= 0 && k < b[0].n && b[0].c[k].x == col && b[0].c[k].y == row && n < ids.count { ids[n] = k; n += 1; }
      col += 1;
    }
    row += 1;
  }
  return n;
}
// The blocks' counts of standing creatures by side, for nearest_foe_far: once a step, before the turns.
blk_count :: (s: [] Lab) {
  b := bt(s);
  s[0].blk_w = 0; s[0].blk_h = 0;
  if b[0].n <= NEAR_SCAN || !rs_indexed(b) { return; }
  bw := (s[0].cols + BLK - 1) / BLK; bh := (s[0].rows + BLK - 1) / BLK;
  if bw * bh > BLK_MAX { return; }
  s[0].blk_w = bw; s[0].blk_h = bh;
  for q: 0..<(bw * bh * TEAMS) { s[0].blk_up[q] = 0; }
  for j: 0..<b[0].n {
    if !rs_up(b[0].c[j]) || b[0].c[j].x < 0 || b[0].c[j].y < 0 { continue; }
    q := ((b[0].c[j].y / BLK) * bw + b[0].c[j].x / BLK) * TEAMS + b[0].c[j].team;
    s[0].blk_up[q] += 1;
  }
}
// The nearest foe by blocks, rings of them outward from i's, each block holding a foe looked over
// square by square; it stops once a ring is further off than the best found. -1: none counted.
nearest_foe_far :: (s: [] Lab, i: int) -> int {
  b := bt(s);
  bw := s[0].blk_w; bh := s[0].blk_h;
  x := b[0].c[i].x; y := b[0].c[i].y; team := b[0].c[i].team;
  mon := b[0].c[i].klass == RS_MONSTER;
  bx := x / BLK; by := y / BLK;
  best := -1; bd := 100000;
  far := rs_max(bw, bh);
  for rg: 0..<far {
    if rg > 0 && (rg - 1) * BLK * RS_SQUARE > bd { break; }
    qy := by - rg;
    while qy <= by + rg {
      // the rg's top and bottom rows whole, its sides at their two ends
      edge := qy == by - rg || qy == by + rg;
      hop := ifx edge || rg == 0 then 1 else 2 * rg;
      qx := bx - rg;
      while qx <= bx + rg {
        if qx >= 0 && qy >= 0 && qx < bw && qy < bh {
          q := (qy * bw + qx) * TEAMS;
          foes := 0;
          for t: 0..<TEAMS { if t != team { foes += s[0].blk_up[q + t]; } }
          if foes > 0 {
            for sy: (qy * BLK)..<rs_min(qy * BLK + BLK, s[0].rows) {
              for sx: (qx * BLK)..<rs_min(qx * BLK + BLK, s[0].cols) {
                k := b[0].occ[sy * b[0].w + sx] - 1;
                if k < 0 || k >= b[0].n || b[0].c[k].team == team || !rs_up(b[0].c[k]) || b[0].c[k].x != sx || b[0].c[k].y != sy { continue; }
                d := rs_feet(x, y, sx, sy);
                if b[0].c[k].klass == RS_MONSTER && b[0].c[k].npc == RS_NPC_NONE && !mon && d > 5 { d += 40; }
                if d < bd || (d == bd && k < best) { bd = d; best = k; }
              }
            }
          }
        }
        qx += hop;
      }
      qy += 1;
    }
  }
  return best;
}

nearest_foe :: (s: [] Lab, i: int) -> int {
  // heroes count the Restless Dead 40 feet further off than they are: the rival side is their
  // quarrel, and the dead are fought when they come close
  if s[0].blk_w > 0 { far := nearest_foe_far(s, i); if far >= 0 { return far; } }
  b := bt(s);
  best := -1; bd := 100000;
  team := b[0].c[i].team; mon := b[0].c[i].klass == RS_MONSTER;
  for j: 0..<b[0].n {
    if b[0].c[j].team == team || b[0].c[j].dead || b[0].c[j].hp <= 0 { continue; }
    d := rs_feet_to(b, i, j);
    if b[0].c[j].klass == RS_MONSTER && b[0].c[j].npc == RS_NPC_NONE && !mon && d > 5 { d += 40; }
    if d < bd { bd = d; best = j; }
  }
  return best;
}
// The lowest free slot of at least level, or 0.
free_slot :: (s: [] Lab, i: int, level: int) -> int {
  for k: level..<10 { if s[0].battle[0].c[i].slots[k] > 0 && !lw_arcanum_only(s, i, k, level) { return k; } }
  return 0;
}
// The open grid's default choice is to take an ordinary opportunity against
// a foe. Its normal sight excludes Blinded observers and Invisible movers;
// special senses/obscured terrain are not invented by this adapter.
lab_step :: (s:[] Lab,i:int,x:int,y:int)->bool {
  b:=bt(s); if !rs_step_ready(b,i,x,y) { return false; }
  choices:[8]RsOpportunityChoice; n:=0;
  mx:=b[0].c[i].x; my:=b[0].c[i].y;
  for dy:-1..<2 { for dx:-1..<2 {
    if dx==0 && dy==0 { continue; }
    actor:=rs_at(b,mx+dx,my+dy);
    if actor<0 || b[0].c[actor].team==b[0].c[i].team { continue; }
    seen:=!rs_has(b[0].c[actor],RS_BLINDED) && !rs_has(b[0].c[i],RS_INVISIBLE);
    if !seen { continue; }
    wp:=rs_weapon(b[0].c[actor].weapon);
    if !rs_opportunity_trigger(b,actor,i,RsOpportunityMove.{x=x,y=y,seen=true,movement=true,melee=wp.range_ft<=wp.reach_ft || wp.both,reach=wp.reach_ft}) { continue; }
    choices[n]=RsOpportunityChoice.{actor=actor,weapon=b[0].c[actor].weapon,seen=true}; n+=1;
  } }
  return rs_step_reactions(b,i,x,y,choices[0..<n]);
}
// Walk square by square: toward the foe to `want` feet, or away when closer than `least`.
walk :: (s: [] Lab, i: int, foe: int, least: int, want: int) {
  guard := 0;
  while rs_movement_left(bt(s),i) >= RS_SQUARE && guard < 12 {
    guard += 1;
    d := rs_feet_to(bt(s), i, foe);
    if d >= least && d <= want { return; }
    away := d < least;
    bx := -1; by := -1; bs := -100000;
    for oy: -1..<2 {
      for ox: -1..<2 {
        if ox == 0 && oy == 0 { continue; }
        x := s[0].battle[0].c[i].x + ox; y := s[0].battle[0].c[i].y + oy;
        if x < 0 || y < 0 || x >= s[0].cols || y >= s[0].rows || rs_at(bt(s), x, y) >= 0 { continue; }
        nd := rs_feet(x, y, s[0].battle[0].c[foe].x, s[0].battle[0].c[foe].y);
        score := ifx away then nd else -nd;
        if rs_difficult(bt(s), x, y) { score -= 4; }
        // keep off the edges when backing away
        if away && (x == 0 || y == 0 || x == s[0].cols - 1 || y == s[0].rows - 1) { score -= 3; }
        if score > bs { bs = score; bx = x; by = y; }
      }
    }
    here := ifx away then d else -d;
    if bx < 0 || bs <= here { return; }
    if !lab_step(s, i, bx, by) { return; }
  }
}
foes_near :: (s: [] Lab, i: int, x: int, y: int, feet: int) -> int {
  n := 0;
  ids: [NEAR_20] int; m := near_ids(s, x, y, feet, ids[..]);
  for q: 0..<m {
    j := ids[q]; c := s[0].battle[0].c[j..<j + 1];
    if c[0].team != s[0].battle[0].c[i].team && !c[0].dead && c[0].hp > 0 && rs_feet(x, y, c[0].x, c[0].y) <= feet { n += 1; }
  }
  return n;
}
friends_near :: (s: [] Lab, i: int, x: int, y: int, feet: int) -> int {
  n := 0;
  ids: [NEAR_20] int; m := near_ids(s, x, y, feet, ids[..]);
  for q: 0..<m {
    j := ids[q]; c := s[0].battle[0].c[j..<j + 1];
    if c[0].team == s[0].battle[0].c[i].team && !c[0].dead && rs_feet(x, y, c[0].x, c[0].y) <= feet { n += 1; }
  }
  return n;
}

// A Warlock's turn: Hex with a pact slot (a Bonus Action), moved to a new foe when its target
// drops, or Hold Person to open; with the other slot, Hold Person when it holds no spell, or
// Scorching Ray when Hex is up;
// Chill Touch on a Paralyzed foe at hand (a Critical Hit); else Eldritch Blast from range, at the
// hexed foe first.
pact_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  pl := 1; for k: 1..<6 { if b[0].c[i].slots_max[k] > 0 { pl = k; } }   // Pact Magic's slot level
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // Hex: moved on, or cast
  if b[0].c[i].conc == SP_HEX && b[0].c[i].hex_free { ok := rs_hex_move(b, i, foe); }
  // a barbarian within 60 feet: Rage does nothing for a Wisdom save, so Hold Person it
  brute := -1;
  ids1: [NEAR_MAX] int; m1 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 60, ids1[..]);
  for q1: 0..<m1 {
    j := ids1[q1];
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && c.klass == RS_BARBARIAN && !rs_has(c, RS_PARALYZED) && rs_feet_to(b, i, j) <= 60 {
      if brute < 0 || rs_feet_to(b, i, j) < rs_feet_to(b, i, brute) { brute = j; }
    }
  }
  if b[0].c[i].conc < 0 && b[0].c[i].slots[pl] > 0 {
    if brute >= 0 && rs_unit(dice(s)) < 0.7 { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, brute); }
    else if b[0].c[foe].humanoid && rs_feet_to(b, i, foe) <= 60 && !rs_has(b[0].c[foe], RS_PARALYZED) && rs_unit(dice(s)) < 0.35 { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, foe); }
    else if rs_feet_to(b, i, foe) <= 90 { ok := rs_cast(b, i, SP_HEX, pl, 0, 0, foe); }
  }
  // a Paralyzed foe within a walk: go and touch it
  held := -1;
  ids2: [NEAR_MAX] int; m2 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 30, ids2[..]);
  for q2: 0..<m2 {
    j := ids2[q2];
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && rs_has(c, RS_PARALYZED) && rs_feet_to(b, i, j) <= 30 { held = j; }
  }
  if held >= 0 && !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, held, 0, 5); }
  if held >= 0 && rs_feet_to(b, i, held) <= 5 { ok := rs_cast(b, i, SP_CHILL_TOUCH, 0, 0, 0, held); }
  if b[0].turn.action { return; }
  // keep its distance: Eldritch Blast reaches 120 feet
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // a raging barbarian next: Force isn't halved by Rage
  bd := 100000;
  ids3: [NEAR_MAX] int; m3 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 120, ids3[..]);
  for q3: 0..<m3 {
    j := ids3[q3];
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && c.klass == RS_BARBARIAN && rs_feet_to(b, i, j) <= 120 && rs_feet_to(b, i, j) < bd { bd = rs_feet_to(b, i, j); foe = j; }
  }
  // the hexed foe first
  ids4: [NEAR_MAX] int; m4 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 120, ids4[..]);
  for q4: 0..<m4 {
    j := ids4[q4];
    for k: 0..<RS_EFFECTS {
      if b[0].c[j].eff[k].kind == EF_HEX && b[0].c[j].eff[k].by == i && rs_up(b[0].c[j]) && rs_feet_to(b, i, j) <= 120 { foe = j; }
    }
  }
  d := rs_feet_to(b, i, foe);
  // the swarm: a Fiend's Fireball (from level 5) where it catches three foes and no friend
  if !b[0].turn.slot_spent && pl >= 3 && b[0].c[i].slots[pl] > 0 {
    fb := burst_at(s, i, 150, 20, false, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, pl, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  if !b[0].turn.slot_spent && b[0].c[i].slots[pl] > 0 {
    if b[0].c[i].conc < 0 && d <= 60 && b[0].c[foe].humanoid && !rs_has(b[0].c[foe], RS_PARALYZED) { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, foe); }
    else if rs_unit(dice(s)) < 0.6 { ok := rs_cast(b, i, SP_SCORCHING_RAY, pl, 0, 0, foe); }
  }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_ELDRITCH_BLAST, 0, 0, 0, foe); }
}

// The foe beside i most worth hitting: the most hurt, casters first.
foe_at_hand :: (s: [] Lab, i: int, but: int) -> int {
  b := bt(s);
  best := -1; bv := 100000;
  ids: [NEAR_5] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, 5, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if j == but || c.team == b[0].c[i].team || !rs_up(c) || rs_feet_to(b, i, j) > 5 { continue; }
    v := c.hp; if c.spell_ability >= 0 { v -= 8; }
    if rs_has(c, RS_PARALYZED) { v -= 100; }
    if v < bv { bv = v; best = j; }
  }
  return best;
}
// A Barbarian's turn: Rage when a foe is near, close in (Dash when far), attack recklessly with the
// Greataxe, and Cleave into a second foe beside the first.
barbarian_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // the casters behind the line, when a dash reaches them
  bd := 100000;
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, 60, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 60 && d < bd { bd = d; foe = j; }
  }
  // Rage once a foe is within a dash (Fast Movement makes it 40 feet a move from level 5)
  if !b[0].c[i].raging && rs_feet_to(b, i, foe) <= 2 * b[0].c[i].speed { ok := rs_rage(b, i); }
  if foe_at_hand(s, i, -1) < 0 && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 0, 5);
    if rs_feet_to(b, i, foe) > 5 && !b[0].turn.action { ok := rs_dash(b, i); walk(s, i, foe, 0, 5); }
  }
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  ok := rs_attack(b, i, j, true, foe_at_hand(s, i, j));
}
// A Monk's turn: run at the casters (Step of the Wind when far), strike, then Flurry of Blows that
// knocks a foe Prone (or pushes one already down); Patient Defense when badly hurt and alone with
// foes around it.
monk_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  // its quarry: the nearest caster within a dash, else the nearest foe
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  bd := 100000;
  ids1: [NEAR_MAX] int; m1 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 80, ids1[..]);
  for q1: 0..<m1 {
    j := ids1[q1];
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 80 && d < bd { bd = d; foe = j; }
  }
  // a Paralyzed foe within a dash comes first: every hit from 5 feet is a Critical Hit
  bd = 100000;
  ids2: [NEAR_MAX] int; m2 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 80, ids2[..]);
  for q2: 0..<m2 {
    j := ids2[q2];
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || !rs_has(c, RS_PARALYZED) { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 80 && d < bd { bd = d; foe = j; }
  }
  if foe_at_hand(s, i, -1) < 0 && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 0, 5);
    if rs_feet_to(b, i, foe) > 5 { ok := rs_step_of_the_wind(b, i); walk(s, i, foe, 0, 5); }
  }
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  // from level 5, a Stunning Strike on its hits while it has Focus to spare; from 6, Wholeness of
  // Body when badly hurt
  b[0].c[i].stun_ready = b[0].c[i].focus > 2;
  ok := rs_attack(b, i, j, false, -1);
  if b[0].c[i].hp * 5 < b[0].c[i].hp_max * 2 { ok = rs_wholeness(b, i); }
  brute := false;
  ids3: [NEAR_5] int; m3 := near_ids(s, b[0].c[i].x, b[0].c[i].y, 5, ids3[..]);
  for q3: 0..<m3 {
    k := ids3[q3];
    c := b[0].c[k];
    if c.team != b[0].c[i].team && rs_can_act(c) && c.klass == RS_BARBARIAN && rs_feet_to(b, i, k) <= 5 { brute = true; }
  }
  if (brute || b[0].c[i].hp * 3 < b[0].c[i].hp_max) && b[0].c[i].focus > 0 { ok = rs_patient_defense(b, i); return; }
  j = foe_at_hand(s, i, -1);
  if j < 0 { return; }
  if b[0].c[i].focus > 1 { ok = rs_flurry(b, i, j, ifx rs_has(b[0].c[j], RS_PRONE) then OH_PUSH else OH_TOPPLE); }
  else { ok = rs_bonus_strike(b, i, j); }
}

// A Skeleton's turn: the even ones close in with the Shortsword, the odd ones hang back and shoot;
// any with a foe beside it uses the Shortsword (a bow up close has Disadvantage).
skeleton_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  j := foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if s[0].horde || s[0].film == FILM_ARMIES {
    // the Horde (and the armies film's block of the dead) runs: Dash when the living are out of
    // reach, and cut at whoever it reaches
    close_in(s, i, foe);
    j = foe_at_hand(s, i, -1);
    if j >= 0 && !b[0].turn.action { ok := rs_attack(b, i, j, false, -1); }
    return;
  }
  archer := i % 2 == 1 && b[0].c[i].ranged >= 0;   // a Zombie has no bow
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, ifx archer then 30 else 0, ifx archer then 70 else 5); }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  foe = nearest_foe(s, i);
  if foe >= 0 && rs_feet_to(b, i, foe) <= 80 { ok := rs_shoot(b, i, foe); }
}

// The quarry for a striker: the nearest caster within `feet`, else the nearest foe.
quarry :: (s: [] Lab, i: int, feet: int) -> int {
  b := bt(s);
  foe := nearest_foe(s, i);
  bd := 100000;
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, feet, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 || c.klass == RS_MONSTER { continue; }
    d := rs_feet_to(b, i, j);
    if d <= feet && d < bd { bd = d; foe = j; }
  }
  return foe;
}
// Walk to 5 feet of the foe, then Dash when it still falls short.
close_in :: (s: [] Lab, i: int, foe: int) {
  b := bt(s);
  if foe_at_hand(s, i, -1) >= 0 || rs_has(b[0].c[i], RS_RESTRAINED) { return; }
  walk(s, i, foe, 0, 5);
  if rs_feet_to(b, i, foe) > 5 && !b[0].turn.action { ok := rs_dash(b, i); walk(s, i, foe, 0, 5); }
}
// The friend most hurt within `feet` (itself too), below `share` of its Hit Points, or -1.
most_hurt :: (s: [] Lab, i: int, feet: int, share: f32) -> int {
  b := bt(s);
  best := -1; bv := share;
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, feet, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if c.team != b[0].c[i].team || c.dead || c.stable || rs_feet_to(b, i, j) > feet { continue; }
    v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
    if v < bv { bv = v; best = j; }
  }
  return best;
}
// The foe that i's effect of `kind` is on, within `feet`, or -1.
marked_by :: (s: [] Lab, i: int, kind: int, feet: int) -> int {
  b := bt(s);
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, feet, ids[..]);
  for q: 0..<m {
    j := ids[q];
    if !rs_up(b[0].c[j]) || rs_feet_to(b, i, j) > feet { continue; }
    for k: 0..<RS_EFFECTS { if b[0].c[j].eff[k].kind == kind && b[0].c[j].eff[k].by == i { return j; } }
  }
  return -1;
}
// A foe in i's face: Thunderwave, a 15-foot cube from it, with its lowest free slot.
thunder_back :: (s: [] Lab, i: int, foe: int, chance: f32) {
  b := bt(s);
  if foe < 0 || rs_feet_to(b, i, foe) > 5 || b[0].turn.action || b[0].turn.slot_spent { return; }
  sl := free_slot(s, i, 1);
  if sl > 0 && rs_unit(dice(s)) < chance { ok := rs_cast(b, i, SP_THUNDERWAVE, sl, b[0].c[foe].x, b[0].c[foe].y, -1); }
}
// Hold Person with a 2nd-level slot on a humanoid foe within 60 feet, when i holds no spell.
hold_one :: (s: [] Lab, i: int, foe: int, chance: f32) {
  b := bt(s);
  if foe < 0 || b[0].turn.action || b[0].turn.slot_spent || b[0].c[i].conc >= 0 || b[0].c[i].slots[2] <= 0 { return; }
  if !b[0].c[foe].humanoid || rs_has(b[0].c[foe], RS_PARALYZED) || rs_feet_to(b, i, foe) > 60 { return; }
  if rs_unit(dice(s)) < chance { ok := rs_cast(b, i, SP_HOLD_PERSON, 2, 0, 0, foe); }
}

// The foe whose square makes the best centre for a burst of `radius` feet within `range` of i: the
// most foes caught, less three for each friend in it (none when `spare`: an Evoker sculpts them
// out), or -1 when fewer than `least` foes would be caught. It looks at 40 foes at most.
burst_at :: (s: [] Lab, i: int, range: int, radius: int, spare: bool, least: int) -> int {
  b := bt(s);
  best := -1; bv := least - 1; looked := 0;
  me := b[0].c[i..<i + 1];
  ids: [NEAR_MAX] int; m := near_ids(s, me[0].x, me[0].y, range, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j..<j + 1];
    if c[0].team == me[0].team || !(!c[0].dead && c[0].hp > 0) || rs_feet_to(b, i, j) > range || looked >= 40 { continue; }
    looked += 1;
    v := 0;
    inn: [NEAR_MAX] int; mi := near_ids(s, c[0].x, c[0].y, radius, inn[..]);
    for qi: 0..<mi {
      k := inn[qi];
      o := b[0].c[k..<k + 1];
      if o[0].dead || rs_feet(c[0].x, c[0].y, o[0].x, o[0].y) > radius { continue; }
      if o[0].team != me[0].team { if !o[0].dead && o[0].hp > 0 { v += 1; } } else if !spare || k == i { v -= 3; }
    }
    if v > bv { bv = v; best = j; }
  }
  return best;
}
// A Fighter's turn: Second Wind when Bloodied, close in on the casters, the Greatsword (Graze on a
// miss), then Action Surge for a second Attack action while a foe still stands beside it.
fighter_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  if b[0].c[i].hp * 2 < b[0].c[i].hp_max { ok := rs_second_wind(b, i); }
  foe := quarry(s, i, 40);
  if foe < 0 { return; }
  close_in(s, i, foe);
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  ok := rs_attack(b, i, j, false, -1);
  j = foe_at_hand(s, i, -1);
  if j >= 0 && rs_action_surge(b, i) { ok = rs_attack(b, i, j, false, -1); }
}
// A Paladin's turn: Lay On Hands on the worst hurt beside it, close in, Sacred Weapon with the first
// attack, the Longsword (Sap), and Divine Smite on a hit: without a slot first, then with one on a
// caster or a foe with Hit Points to spare. Sacred Flame (Blessed Warrior) at a foe it can't reach.
paladin_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  w := most_hurt(s, i, 5, 0.35);
  if w >= 0 { ok := rs_lay_on_hands(b, i, w, ifx b[0].c[w].hp == 0 then 5 else 10); }
  foe := quarry(s, i, 30);
  if foe < 0 { return; }
  close_in(s, i, foe);
  j := foe_at_hand(s, i, -1);
  if j < 0 {
    foe = nearest_foe(s, i);
    if foe >= 0 && !b[0].turn.action { ok := rs_cast(b, i, SP_SACRED_FLAME, 0, 0, 0, foe); }
    return;
  }
  ok := rs_sacred_weapon(b, i);
  ok = rs_attack(b, i, j, false, -1);
  if b[0].turn.last_hit == j + 1 && rs_up(b[0].c[j]) {
    if !rs_cast(b, i, SP_DIVINE_SMITE, 0, 0, 0, j) {
      sl := free_slot(s, i, 1);
      if sl > 0 && (b[0].c[j].spell_ability >= 0 || b[0].c[j].hp > 12) && rs_unit(dice(s)) < 0.5 { ok = rs_cast(b, i, SP_DIVINE_SMITE, sl, 0, 0, j); }
    }
  }
}
// A Ranger's turn: Hunter's Mark (without a slot while Favored Enemy lasts, then with one), moved
// on when its quarry drops; the Shortsword at a foe beside it, else back to 30 feet or more and the
// Longbow, at the marked foe first.
ranger_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  if b[0].c[i].conc == SP_HUNTERS_MARK && b[0].c[i].hex_free { ok := rs_hex_move(b, i, foe); }
  if b[0].c[i].conc < 0 && rs_feet_to(b, i, foe) <= 90 {
    if !rs_cast(b, i, SP_HUNTERS_MARK, 0, 0, 0, foe) {
      sl := free_slot(s, i, 1);
      if sl > 0 { ok := rs_cast(b, i, SP_HUNTERS_MARK, sl, 0, 0, foe); }
    }
  }
  j := foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 30, 90); }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  m := marked_by(s, i, EF_MARK, 150);
  foe = ifx m >= 0 then m else nearest_foe(s, i);
  if foe >= 0 { ok := rs_shoot(b, i, foe); }
}
// A Rogue's turn: the Shortsword at a foe beside it; else, in bow range and not yet moved, Steady
// Aim and the Shortbow with Advantage (and Sneak Attack); else a walk, Cunning Action's Dash when
// still out of range, and the bow. From level 5 Cunning Strike trips, or withdraws from a foe at hand.
rogue_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // Cunning Strike: Trip a standing foe, else Withdraw from one at hand
  j := foe_at_hand(s, i, -1);
  if j >= 0 { b[0].c[i].strike_plan = ifx rs_has(b[0].c[j], RS_PRONE) then CS_WITHDRAW else CS_TRIP; ok := rs_attack(b, i, j, false, -1); walk(s, i, j, 30, 70); return; }
  d := rs_feet_to(b, i, foe);
  if d >= 15 && d <= 80 { ok := rs_steady_aim(b, i); }
  if !b[0].turn.anchored && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 30, 70);
    if rs_feet_to(b, i, foe) > 80 { ok := rs_cunning_dash(b, i); walk(s, i, foe, 30, 70); }
  }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { b[0].c[i].strike_plan = CS_TRIP; ok := rs_attack(b, i, j, false, -1); return; }
  foe = nearest_foe(s, i);
  if foe >= 0 { b[0].c[i].strike_plan = ifx rs_has(b[0].c[foe], RS_PRONE) then CS_NONE else CS_TRIP; ok := rs_shoot(b, i, foe); }
}
// A Cleric's turn: Turn Undead when three of the dead stand within 30 feet, Preserve Life when two
// friends near it are Bloodied, Healing Word on the worst hurt; the Mace at a foe beside it, else
// Guiding Bolt or Sacred Flame from 15 to 45 feet off.
cleric_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  undead_near := 0; bloodied := 0;
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, 30, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if rs_feet_to(b, i, j) > 30 { continue; }
    if c.undead && rs_up(c) && c.team != b[0].c[i].team && rs_turned_by(c) < 0 { undead_near += 1; }
    if c.team == b[0].c[i].team && !c.dead && c.hp < c.hp_max / 2 { bloodied += 1; }
  }
  if undead_near >= 3 { ok := rs_turn_undead(b, i); }
  // Spirit Guardians (from level 5) when two foes or more are within 15 feet, or the dead are near
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 && b[0].c[i].conc < 0 && foes_near(s, i, b[0].c[i].x, b[0].c[i].y, 20) >= 2 {
    ok := rs_cast(b, i, SP_SPIRIT_GUARDIANS, 3, 0, 0, i);
  }
  if bloodied >= 2 { ok := rs_preserve_life(b, i); }
  w := most_hurt(s, i, 60, 0.4);
  if w >= 0 && !b[0].turn.slot_spent {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_HEALING_WORD, sl, 0, 0, w); }
  }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  j := foe_at_hand(s, i, -1);
  if j >= 0 && !b[0].turn.action { ok := rs_attack(b, i, j, false, -1); return; }
  // with Spirit Guardians up it wades in among them
  guarding := b[0].c[i].conc == SP_SPIRIT_GUARDIANS;
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, ifx guarding then 0 else 15, ifx guarding then 10 else 45); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  if !b[0].turn.action && !b[0].turn.slot_spent && rs_unit(dice(s)) < 0.5 {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_GUIDING_BOLT, sl, 0, 0, foe); }
  }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_SACRED_FLAME, 0, 0, 0, foe); }
}
// A Bard's turn: Healing Word on a friend near the end, Bardic Inspiration to a friend with a foe
// near it; Thunderwave at a foe in its face; then from 20 to 50 feet, Hold Person on a humanoid or
// Vicious Mockery. Cutting Words comes on its own, as a Reaction.
bard_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  w := most_hurt(s, i, 60, 0.3);
  if w >= 0 {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_HEALING_WORD, sl, 0, 0, w); }
  }
  pick := -1; pd := 100000;
  ids: [NEAR_MAX] int; m := near_ids(s, b[0].c[i].x, b[0].c[i].y, 60, ids[..]);
  for q: 0..<m {
    j := ids[q];
    c := b[0].c[j];
    if j == i || c.team != b[0].c[i].team || !rs_up(c) || c.inspired > 0 || c.klass == RS_MONSTER { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 60 && d < pd && foes_near(s, i, c.x, c.y, 10) > 0 { pd = d; pick = j; }
  }
  if pick >= 0 && b[0].c[i].uses[RS_USE_INSPIRE] == 0 && b[0].c[i].slots[1] > 0 { ok := rs_font(b, i); }
  if pick >= 0 { ok := rs_inspire(b, i, pick); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  thunder_back(s, i, foe, 0.6);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 20, 50); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // the swarm: Hypnotic Pattern (from level 5) on four foes and no friend, then a Fireball
  // (Magical Discoveries, level 6) on three
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    hp := ifx b[0].c[i].conc < 0 then burst_at(s, i, 120, 15, false, 4) else -1;
    if hp >= 0 { ok := rs_cast(b, i, SP_HYPNOTIC_PATTERN, 3, b[0].c[hp].x, b[0].c[hp].y, -1); }
    else if b[0].c[i].discoveries[0] == SP_FIREBALL {
      fb := burst_at(s, i, 150, 20, false, 3);
      if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
    }
  }
  hold_one(s, i, foe, 0.3);
  if !b[0].turn.action { ok := rs_cast(b, i, SP_VICIOUS_MOCKERY, 0, 0, 0, foe); }
}
// A Draconic Sorcerer's turn: Innate Sorcery as the fight opens, Thunderwave at a foe in its face,
// then from 25 to 60 feet Scorching Ray with a 2nd-level slot or Fire Bolt, and a second Fire Bolt
// Quickened (2 Sorcery Points) when no slot spell went this turn. Shield and Seeking Spell come on
// their own.
sorcerer_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  if rs_feet_to(b, i, foe) <= 120 { ok := rs_innate_sorcery(b, i); }
  thunder_back(s, i, foe, 0.6);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // Fireball (from level 5) where it catches three foes and no friend
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    fb := burst_at(s, i, 150, 20, false, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[2] > 0 && rs_unit(dice(s)) < 0.55 { ok := rs_cast(b, i, SP_SCORCHING_RAY, 2, 0, 0, foe); }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
  foe = nearest_foe(s, i);
  if foe >= 0 && rs_unit(dice(s)) < 0.5 { ok := rs_cast_quick(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
}
// An Evoker Wizard's turn: Thunderwave at a foe in its face; from 25 to 60 feet, Hold Person on a
// humanoid, Scorching Ray with a 2nd-level slot, or Fire Bolt (Potent Cantrip: half on a miss).
// Shield comes on its own.
wizard_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  thunder_back(s, i, foe, 0.7);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // Fireball (from level 5) where it catches three foes or more
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    fb := burst_at(s, i, 150, 20, b[0].c[i].sculpt, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  hold_one(s, i, foe, 0.25);
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[2] > 0 && rs_unit(dice(s)) < 0.5 { ok := rs_cast(b, i, SP_SCORCHING_RAY, 2, 0, 0, foe); }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
}

// A Circle of the Land Druid's turn: Healing Word on a friend near the end, Thunderwave at a foe in
// its face, Land's Aid where foes bunch, Hold Person (a polar land's spell), Entangle or Faerie Fire,
// then a cantrip; Cure Wounds on a friend at hand.
druid_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  roll := rs_unit(dice(s));
  // held by plants: strain against them half the time, else cast from where it stands
  if rs_has(b[0].c[i], RS_RESTRAINED) && roll < 0.5 { ok := rs_escape(b, i); }
  // a friend down or badly hurt: Healing Word (a Bonus Action) from afar, Cure Wounds by touch
  worst := -1; wv: f32 = 2;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team || c.dead || c.stable { continue; }
    v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
    if v < wv { wv = v; worst = j; }
  }
  if worst >= 0 && wv < 0.4 {
    slot := free_slot(s, i, 1);
    if slot > 0 && rs_feet_to(b, i, worst) <= 60 { ok := rs_cast(b, i, SP_HEALING_WORD, slot, 0, 0, worst); }
  }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  conc := b[0].c[i].conc >= 0;
  slot := ifx b[0].turn.slot_spent then 0 else free_slot(s, i, 1);
  // a foe in its face: Thunderwave, or step back
  if rs_feet_to(b, i, foe) <= 5 && slot > 0 && !b[0].turn.action && rs_unit(dice(s)) < 0.75 {
    ok := rs_cast(b, i, SP_THUNDERWAVE, slot, b[0].c[foe].x, b[0].c[foe].y, -1);
  }
  if !rs_has(b[0].c[i], RS_RESTRAINED) {
    want := ifx !conc && slot > 0 then 45 else 40;
    walk(s, i, foe, 15, want);
  }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  d := rs_feet_to(b, i, foe);
  fx := b[0].c[foe].x; fy := b[0].c[foe].y;
  slot = ifx b[0].turn.slot_spent then 0 else free_slot(s, i, 1);
  // Land's Aid where two foes or more stand within 10 feet of the nearest, healing the friend there most hurt
  // Call Lightning (from level 5) where its bolt catches two foes, and the later bolts while it lasts
  if !b[0].turn.action && d <= 120 {
    cl := burst_at(s, i, 120, 5, false, 2);
    if cl >= 0 && b[0].c[i].conc == SP_CALL_LIGHTNING { ok := rs_cast(b, i, SP_CALL_BOLT, 0, b[0].c[cl].x, b[0].c[cl].y, -1); }
    else if cl >= 0 && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 && b[0].c[i].conc < 0 { ok := rs_cast(b, i, SP_CALL_LIGHTNING, 3, b[0].c[cl].x, b[0].c[cl].y, -1); }
  }
  if foes_near(s, i, fx, fy, 10) >= 2 { ok := rs_wild_resurgence(b, i); }
  if !b[0].turn.action && d <= 60 && b[0].c[i].uses[RS_USE_WILD] > 0 && foes_near(s, i, fx, fy, 10) >= 2 {
    heal := -1; hv: f32 = 0.7;
    for j: 0..<b[0].n {
      c := b[0].c[j];
      if c.team != b[0].c[i].team || c.dead || rs_feet(fx, fy, c.x, c.y) > 10 { continue; }
      v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
      if v < hv { hv = v; heal = j; }
    }
    ok := rs_lands_aid(b, i, fx, fy, heal);
  }
  hold_one(s, i, foe, 0.25);
  conc = b[0].c[i].conc >= 0;
  if !b[0].turn.action && !conc && slot > 0 && rs_unit(dice(s)) < 0.45 {
    // an area spell where it catches foes and spares friends
    if friends_near(s, i, fx, fy, 15) == 0 {
      if !rs_has(b[0].c[foe], RS_RESTRAINED) && rs_unit(dice(s)) < 0.55 { ok := rs_cast(b, i, SP_ENTANGLE, slot, fx, fy, -1); }
      else { ok := rs_cast(b, i, SP_FAERIE_FIRE, slot, fx, fy, -1); }
    }
  }
  if !b[0].turn.action {
    // a cantrip: Produce Flame lit with the Bonus Action and hurled, or Starry Wisp, or Poison Spray up close
    if !b[0].turn.bonus && b[0].c[i].flame_until <= b[0].clock && d <= 60 && rs_unit(dice(s)) < 0.35 {
      ok := rs_cast(b, i, SP_PRODUCE_FLAME, 0, 0, 0, i);
    }
    if b[0].c[i].flame_until > b[0].clock && d <= 60 { ok := rs_cast(b, i, SP_FLAME_HURL, 0, 0, 0, foe); }
    else if d <= 30 && rs_unit(dice(s)) < 0.5 { ok := rs_cast(b, i, SP_POISON_SPRAY, 0, 0, 0, foe); }
    else if d <= 60 { ok := rs_cast(b, i, SP_STARRY_WISP, 0, 0, 0, foe); }
  }
  // a friend at hand and hurt: Cure Wounds would take the action, so only when it is still free
  if !b[0].turn.action && worst >= 0 && wv < 0.5 && rs_feet_to(b, i, worst) <= 5 {
    cs := free_slot(s, i, 1);
    if cs > 0 { ok := rs_cast(b, i, SP_CURE_WOUNDS, cs, 0, 0, worst); }
  }
}

lab_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  rs_start_turn(b, i);
  s[0].acted[i] = b[0].clock;
  kl := b[0].c[i].klass;
  // a turned Skeleton spends its turn moving away from the Cleric who turned it
  holy := rs_turned_by(b[0].c[i]);
  if holy >= 0 && rs_can_move(b[0].c[i]) { walk(s, i, holy, 300, 400); }
  if s[0].player && i == s[0].me {
    if rs_can_act(b[0].c[i]) { player_turn(s, i); }
    rs_end_turn(b, i);
    return;
  }
  if rs_can_act(b[0].c[i]) { class_turn(s, i); }
  rs_end_turn(b, i);
}
// A hero's turn as its class plays it.
class_turn :: (s: [] Lab, i: int) {
  kl := s[0].battle[0].c[i].klass;
  if s[0].battle[0].c[i].npc != RS_NPC_NONE { siege_turn(s, i); return; }   // a siege's (fivelab-siege.coax)
  if true {
    if kl == RS_BARBARIAN { barbarian_turn(s, i); }
    else if kl == RS_MONSTER { skeleton_turn(s, i); }
    else if kl == RS_MONK { monk_turn(s, i); }
    else if kl == RS_WARLOCK { pact_turn(s, i); }
    else if kl == RS_FIGHTER { fighter_turn(s, i); }
    else if kl == RS_PALADIN { paladin_turn(s, i); }
    else if kl == RS_RANGER { ranger_turn(s, i); }
    else if kl == RS_ROGUE { rogue_turn(s, i); }
    else if kl == RS_CLERIC { cleric_turn(s, i); }
    else if kl == RS_BARD { bard_turn(s, i); }
    else if kl == RS_SORCERER { sorcerer_turn(s, i); }
    else if kl == RS_WIZARD { wizard_turn(s, i); }
    else { druid_turn(s, i); }
  }
}
// Your turn in Player mode: your token walks to the square your body stands on, then the hotbar's slot: Attack (your target if it's in reach, else whoever is,
// else a shot or your class's own spell), your class's powers, or Dash.
player_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  tgt := s[0].target;
  if tgt >= 0 && !rs_up(b[0].c[tgt]) { tgt = -1; s[0].target = -1; }
  list: [SLOTS] Ab; nab := hero_abilities(s, i, list[..]);
  a := list[rs_min(s[0].act, nab - 1)];
  s[0].act = ACT_ATTACK;   // a slot is used once; the next turn attacks unless you pick again
  if !ab_ready(s, i, a) { a = list[0]; }
  // the dashes come before the walk
  ok := false;
  if a.kind == FB_DASH || a.kind == FB_CDASH { ok = fb_use(b, i, fb_feature(a.kind, a.name, ""), -1, 0, 0, -1); }   // the shared bar's Dash (fivebar.coax)
  if a.kind == AB_WIND { ok = rs_step_of_the_wind(b, i); }
  // your token walks the squares to where your body stands (Everglade's controller moves it,
  // fivelab-face.c), a square at a time on the rules' movement: Speed, Difficult Terrain, the
  // squares others hold. What the turn can't reach, your body is held back from (lab_keep).
  if s[0].you_on {
    gx := you_square_x(s); gy := you_square_y(s);
    guard := 0;
    while rs_movement_left(b,i) >= RS_SQUARE && guard < 16 {
      guard += 1;
      x := b[0].c[i].x; y := b[0].c[i].y;
      ox := rs_sign(gx - x); oy := rs_sign(gy - y);
      if ox == 0 && oy == 0 { break; }
      gone := false;
      for tr: 0..<3 {
        sx := ifx tr == 2 then 0 else ox; sy := ifx tr == 1 then 0 else oy;
        if sx == 0 && sy == 0 { continue; }
        nx := x + sx; ny := y + sy;
        if nx < 0 || ny < 0 || nx >= s[0].cols || ny >= s[0].rows || rs_at(b, nx, ny) >= 0 { continue; }
        if lab_step(s, i, nx, ny) { gone = true; break; }
      }
      if !gone { break; }
    }
  }
  s[0].my_sx = b[0].c[i].x; s[0].my_sy = b[0].c[i].y;
  foe := ifx tgt >= 0 then tgt else nearest_foe(s, i);
  if a.kind == FB_DASH || a.kind == FB_CDASH || a.kind == AB_WIND { if !b[0].turn.action { default_attack(s, i, foe); } return; }
  use_ab(s, i, a, foe);
}
// ---- the hotbar: each class's own abilities, a slot each
SLOTS :: 9;
AB_ATTACK :: 0; AB_SPELL :: 2; AB_RECKLESS :: 3; AB_RAGE :: 4; AB_FLURRY :: 5; AB_PATIENT :: 6;
AB_WIND :: 7; AB_WHOLE :: 8; AB_SECOND :: 9; AB_SURGE :: 10; AB_LAY :: 11; AB_SACRED :: 12;   // Dash and Cunning Dash are fivebar.coax FB_DASH (1), FB_CDASH (13)
AB_AIM :: 14; AB_INNATE :: 15; AB_INSPIRE :: 16; AB_TURN :: 17; AB_PRESERVE :: 18; AB_LANDS :: 19;
TG_FOE :: 0; TG_POINT :: 1; TG_SELF :: 2; TG_ALLY :: 3; TG_BESIDE :: 4;   // a spell's aim: your target, the ground under it, you, the friend most hurt, the free square nearest your target
Ab :: struct { kind: int; sp: int; lvl: int; tg: int; name: string; }
mk_ab :: (kind: int, name: string) -> Ab { return Ab.{kind = kind, sp = -1, name = name}; }
spell_ab :: (sp: int, lvl: int, tg: int) -> Ab { return Ab.{kind = AB_SPELL, sp = sp, lvl = lvl, tg = tg, name = rs_spell(sp).name}; }
// The abilities a class's hotbar holds, in slot order (the ones its rules in the engine support).
abilities :: (kl: int, out: [] Ab) -> int {
  n := 0;
  if kl == RS_DRUID {
    out[0] = spell_ab(SP_STARRY_WISP, 0, TG_FOE); out[1] = spell_ab(SP_PRODUCE_FLAME, 0, TG_SELF); out[2] = spell_ab(SP_FLAME_HURL, 0, TG_FOE);
    out[3] = spell_ab(SP_THUNDERWAVE, 1, TG_POINT); out[4] = spell_ab(SP_ENTANGLE, 1, TG_POINT); out[5] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY);
    out[6] = spell_ab(SP_CALL_LIGHTNING, 3, TG_POINT); out[7] = mk_ab(AB_LANDS, "LAND'S AID"); out[8] = mk_ab(FB_DASH, "DASH"); n = 9;
  } else if kl == RS_WIZARD {
    out[0] = spell_ab(SP_FIRE_BOLT, 0, TG_FOE); out[1] = spell_ab(SP_CHILL_TOUCH, 0, TG_FOE); out[2] = spell_ab(SP_RAY_OF_SICKNESS, 1, TG_FOE);
    out[3] = spell_ab(SP_FALSE_LIFE, 1, TG_SELF); out[4] = spell_ab(SP_MAGIC_MISSILE, 1, TG_FOE); out[5] = spell_ab(SP_SCORCHING_RAY, 2, TG_FOE);
    out[6] = spell_ab(SP_BLINDNESS, 2, TG_FOE); out[7] = spell_ab(SP_FIREBALL, 3, TG_POINT); out[8] = mk_ab(FB_DASH, "DASH"); n = 9;
  } else if kl == RS_WARLOCK {
    n = lw_abilities(out);   // the Warlock you play is level 17 (fivelab-warlock.coax)
  } else if kl == RS_SORCERER {
    out[0] = spell_ab(SP_FIRE_BOLT, 0, TG_FOE); out[1] = spell_ab(SP_ACID_SPLASH, 0, TG_POINT); out[2] = spell_ab(SP_MAGIC_MISSILE, 1, TG_FOE);
    out[3] = spell_ab(SP_SCORCHING_RAY, 2, TG_FOE); out[4] = spell_ab(SP_SHATTER, 2, TG_POINT); out[5] = spell_ab(SP_FIREBALL, 3, TG_POINT);
    out[6] = mk_ab(AB_INNATE, "INNATE SORCERY"); out[7] = mk_ab(FB_DASH, "DASH"); n = 8;
  } else if kl == RS_BARD {
    out[0] = spell_ab(SP_VICIOUS_MOCKERY, 0, TG_FOE); out[1] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY); out[2] = mk_ab(AB_INSPIRE, "BARDIC INSPIRATION");
    out[3] = spell_ab(SP_SHATTER, 2, TG_POINT); out[4] = spell_ab(SP_HYPNOTIC_PATTERN, 3, TG_POINT); out[5] = spell_ab(SP_MASS_HEALING_WORD, 3, TG_ALLY);
    out[6] = spell_ab(SP_FIREBALL, 3, TG_POINT); out[7] = mk_ab(FB_DASH, "DASH"); n = 8;
  } else if kl == RS_CLERIC {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_SACRED_FLAME, 0, TG_FOE); out[2] = spell_ab(SP_GUIDING_BOLT, 1, TG_FOE);
    out[3] = spell_ab(SP_INFLICT_WOUNDS, 1, TG_FOE); out[4] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY); out[5] = spell_ab(SP_SPIRIT_GUARDIANS, 3, TG_SELF);
    out[6] = mk_ab(AB_TURN, "TURN UNDEAD"); out[7] = mk_ab(AB_PRESERVE, "PRESERVE LIFE"); out[8] = mk_ab(FB_DASH, "DASH"); n = 9;
  } else if kl == RS_FIGHTER {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_SECOND, "SECOND WIND"); out[2] = mk_ab(AB_SURGE, "ACTION SURGE"); out[3] = mk_ab(FB_DASH, "DASH"); n = 4;
  } else if kl == RS_PALADIN {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_DIVINE_SMITE, 1, TG_FOE); out[2] = mk_ab(AB_LAY, "LAY ON HANDS");
    out[3] = mk_ab(AB_SACRED, "SACRED WEAPON"); out[4] = spell_ab(SP_SACRED_FLAME, 0, TG_FOE); out[5] = mk_ab(FB_DASH, "DASH"); n = 6;
  } else if kl == RS_BARBARIAN {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_RECKLESS, "RECKLESS ATTACK"); out[2] = mk_ab(AB_RAGE, "RAGE"); out[3] = mk_ab(FB_DASH, "DASH"); n = 4;
  } else if kl == RS_MONK {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_FLURRY, "FLURRY OF BLOWS"); out[2] = mk_ab(AB_PATIENT, "PATIENT DEFENSE");
    out[3] = mk_ab(AB_WIND, "STEP OF THE WIND"); out[4] = mk_ab(AB_WHOLE, "WHOLENESS OF BODY"); out[5] = mk_ab(FB_DASH, "DASH"); n = 6;
  } else if kl == RS_ROGUE {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_AIM, "STEADY AIM"); out[2] = mk_ab(FB_CDASH, "CUNNING DASH"); out[3] = mk_ab(FB_DASH, "DASH"); n = 4;
  } else if kl == RS_RANGER {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_HUNTERS_MARK, 1, TG_FOE); out[2] = mk_ab(FB_DASH, "DASH"); n = 3;
  } else { out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(FB_DASH, "DASH"); n = 2; }
  return n;
}
// The panel's row q (two columns of SIDE): the first 48 heroes; in the Siege, the watch on the
// left and the cult's leader and its first on the right. -1 an empty row.
panel_who :: (s: [] Lab, q: int) -> int {
  n := s[0].battle[0].n;
  if s[0].siege {
    i := ifx q < SIDE then (ifx q < s[0].posts then q else -1) else s[0].posts + q - SIDE;
    return ifx i >= 0 && i < n && (q < SIDE || i >= s[0].posts) then i else -1;
  }
  return ifx q < rs_min(n, s[0].heroes) then q else -1;
}
// The picker's count: the twelve classes, or the Siege's ten kinds.
pick_count :: (s: [] Lab) -> int { return ifx s[0].siege then SIEGE_PICKS else 12; }
// The battle the scenario button shows and H moves on from: the Horde, the two armies, the Siege.
scenario_name :: (s: [] Lab) -> string { return ifx s[0].siege then "SIEGE" else ifx s[0].horde then "HORDE" else "ARMIES"; }
next_scenario :: (s: [] Lab) {
  if s[0].siege { s[0].siege = false; s[0].horde = true; }
  else if s[0].horde { s[0].horde = false; }
  else { s[0].siege = true; }
  s[0].pick = ifx s[0].siege then 0 else 6;
  s[0].wins[0] = 0; s[0].wins[1] = 0; s[0].wins[2] = 0;
  new_battle(s);
}
// The hotbar of creature i: a siege's figure's (fivelab-siege.coax), else its class's.
hero_abilities :: (s: [] Lab, i: int, out: [] Ab) -> int {
  c := s[0].battle[0].c[i..<i + 1];
  if c[0].npc != RS_NPC_NONE { return siege_abilities(c[0], out); }
  return abilities(c[0].klass, out);
}
// Whether a slot can be used now, from the hero's slots, uses, Rages and Focus.
ab_ready :: (s: [] Lab, i: int, a: Ab) -> bool {
  c := s[0].battle[0].c[i];
  if a.kind == AB_SPELL { return a.lvl == 0 || free_slot(s, i, a.lvl) > 0; }
  if a.kind == AB_RAGE { return c.rages > 0 && !c.raging; }
  if a.kind == AB_FLURRY || a.kind == AB_PATIENT || a.kind == AB_WIND { return c.focus > 0; }
  if a.kind == AB_WHOLE { return c.uses[RS_USE_WHOLE] > 0; }
  if a.kind == AB_SECOND { return c.uses[RS_USE_WIND] > 0; }
  if a.kind == AB_SURGE { return c.uses[RS_USE_SURGE] > 0; }
  if a.kind == AB_LAY { return c.uses[RS_USE_LAY] > 0; }
  if a.kind == AB_INSPIRE { return c.uses[RS_USE_INSPIRE] > 0; }
  if a.kind == AB_INNATE { return c.uses[RS_USE_INNATE] > 0; }
  if a.kind == AB_LANDS { return c.uses[RS_USE_WILD] > 0; }
  if a.kind == AB_TURN || a.kind == AB_PRESERVE || a.kind == AB_SACRED { return c.uses[RS_USE_CHANNEL] > 0; }
  return true;
}
// What a slot has left to show in its corner: spell slots at its level, uses, Rages or Focus (-1: none).
ab_left :: (s: [] Lab, i: int, a: Ab) -> int {
  c := s[0].battle[0].c[i];
  if a.kind == AB_SPELL { if a.lvl == 0 { return -1; } sl := free_slot(s, i, a.lvl); return ifx sl > 0 then c.slots[sl] else 0; }
  if a.kind == AB_RAGE { return c.rages; }
  if a.kind == AB_FLURRY || a.kind == AB_PATIENT || a.kind == AB_WIND { return c.focus; }
  if a.kind == AB_WHOLE { return c.uses[RS_USE_WHOLE]; }
  if a.kind == AB_SECOND { return c.uses[RS_USE_WIND]; }
  if a.kind == AB_SURGE { return c.uses[RS_USE_SURGE]; }
  if a.kind == AB_LAY { return c.uses[RS_USE_LAY]; }
  if a.kind == AB_INSPIRE { return c.uses[RS_USE_INSPIRE]; }
  if a.kind == AB_INNATE { return c.uses[RS_USE_INNATE]; }
  if a.kind == AB_LANDS { return c.uses[RS_USE_WILD]; }
  if a.kind == AB_TURN || a.kind == AB_PRESERVE || a.kind == AB_SACRED { return c.uses[RS_USE_CHANNEL]; }
  return -1;
}
// The friend nearest you that isn't you, or -1.
nearest_friend :: (s: [] Lab, i: int) -> int {
  b := bt(s);
  best := -1; bd := 100000;
  for j: 0..<b[0].n {
    if j == i || b[0].c[j].team != b[0].c[i].team || !rs_up(b[0].c[j]) { continue; }
    d := rs_feet_to(b, i, j);
    if d < bd { bd = d; best = j; }
  }
  return best;
}
// Attack: your foe if it's within reach, else whoever is, else a shot, else your first cantrip.
default_attack :: (s: [] Lab, i: int, foe: int) {
  b := bt(s);
  j := ifx foe >= 0 && rs_feet_to(b, i, foe) <= 5 then foe else foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if foe < 0 { return; }
  if b[0].c[i].ranged >= 0 { ok := rs_shoot(b, i, foe); return; }
  list: [SLOTS] Ab; n := hero_abilities(s, i, list[..]);
  for k: 0..<n {
    if list[k].kind == AB_SPELL && list[k].lvl == 0 && list[k].tg == TG_FOE { ok := rs_cast(b, i, list[k].sp, 0, 0, 0, foe); return; }
  }
}
// A slot used on your turn; a bonus-action one leaves your action, which then attacks.
use_ab :: (s: [] Lab, i: int, a: Ab, foe: int) {
  b := bt(s);
  ok := false;
  at := ifx foe >= 0 && rs_feet_to(b, i, foe) <= 5 then foe else foe_at_hand(s, i, -1);
  if a.kind == AB_ATTACK { default_attack(s, i, foe); return; }
  if a.kind == AB_SPELL {
    sl := ifx a.lvl == 0 then 0 else free_slot(s, i, a.lvl);
    if a.lvl > 0 && sl == 0 { default_attack(s, i, foe); return; }
    if a.tg == TG_SELF { ok = rs_cast(b, i, a.sp, sl, 0, 0, i); }
    else if a.tg == TG_ALLY { w := most_hurt(s, i, 60, 0.99); ok = rs_cast(b, i, a.sp, sl, 0, 0, ifx w >= 0 then w else i); }
    else if foe >= 0 && a.tg == TG_POINT { ok = rs_cast(b, i, a.sp, sl, b[0].c[foe].x, b[0].c[foe].y, -1); }
    else if foe >= 0 && a.tg == TG_BESIDE { e := free_near(s, b[0].c[foe].x, b[0].c[foe].y); ok = rs_cast(b, i, a.sp, sl, e % s[0].cols, e / s[0].cols, i); }   // Dimension Door: you, to the point
    // a touch spell (Inflict Wounds, Chill Touch) or Divine Smite lands on a foe within reach when there is one
    else if foe >= 0 { ok = rs_cast(b, i, a.sp, sl, 0, 0, ifx (a.sp == SP_DIVINE_SMITE || rs_spell(a.sp).range_ft == 5) && at >= 0 then at else foe); }
  }
  else if a.kind == AB_RECKLESS { if at >= 0 { ok = rs_attack(b, i, at, true, -1); } }
  else if a.kind == AB_RAGE { ok = rs_rage(b, i); }
  else if a.kind == AB_FLURRY { if at >= 0 { ok = rs_attack(b, i, at, false, -1); if rs_up(b[0].c[at]) { ok = rs_flurry(b, i, at, OH_TOPPLE); } } }
  else if a.kind == AB_PATIENT { ok = rs_patient_defense(b, i); }
  else if a.kind == AB_WHOLE { ok = rs_wholeness(b, i); }
  else if a.kind == AB_SECOND { ok = rs_second_wind(b, i); }
  else if a.kind == AB_SURGE { ok = rs_action_surge(b, i); }
  else if a.kind == AB_LAY { w := most_hurt(s, i, 5, 0.99); w = ifx w >= 0 then w else i; ok = rs_lay_on_hands(b, i, w, ifx b[0].c[w].hp == 0 then 5 else 10); }
  else if a.kind == AB_SACRED { ok = rs_sacred_weapon(b, i); }
  else if a.kind == AB_AIM { ok = rs_steady_aim(b, i); }
  else if a.kind == AB_INNATE { ok = rs_innate_sorcery(b, i); }
  else if a.kind == AB_INSPIRE { w := nearest_friend(s, i); if w >= 0 { ok = rs_inspire(b, i, w); } }
  else if a.kind == AB_TURN { ok = rs_turn_undead(b, i); }
  else if a.kind == AB_PRESERVE { ok = rs_preserve_life(b, i); }
  else if a.kind == AB_LANDS { if foe >= 0 { ok = rs_lands_aid(b, i, b[0].c[foe].x, b[0].c[foe].y, most_hurt(s, i, 60, 0.7)); } }
  if !b[0].turn.action { default_attack(s, i, foe); }
  // Action Surge gives a second action: attack with it too
  if a.kind == AB_SURGE && !b[0].turn.action { default_attack(s, i, foe); }
}
// The hero you play prepares its hotbar (SRD 5.2.1: a caster chooses its prepared spells): the
// bar's spells first, then the class's usual choices while room remains (spell-loadouts.coax).
// Every choice goes through the shared selection rules, so a bar that broke a class's limits,
// list or spellbook would not be prepared (the check below would fail). Granted spells (a
// subclass's, Magical Discoveries') need no choice. AI heroes keep their presets.
lab_prepare_bar :: (c: [] RsCreature) {
  if c[0].klass == RS_WARLOCK { return; }   // the level 17 Warlock you play has its own kit (lw_raise)
  list: [SLOTS] Ab; n := abilities(c[0].klass, list[..]);
  keys: [SLOTS + 2] int; m := 0;
  for k: 0..<n {
    a := list[k];
    if a.kind != AB_SPELL || rs_spell_granted(c[0], a.sp) { continue; }
    key := RS_EXEC_SOURCE[a.sp]; seen := false;
    for q: 0..<m { if keys[q] == key { seen = true; } }
    if !seen { keys[m] = key; m += 1; }
  }
  if c[0].shield_spell { keys[m] = RS_EXEC_SOURCE[SP_SHIELD]; m += 1; }   // its Reaction
  if m == 0 || !rs_set_spells(c, keys[0..<m]) { return; }
  if c[0].klass == RS_WIZARD { _ := rs_select_spell(c, RS_KEY_MAGE_ARMOR); }
  for sp: rs_profile_spells(c[0].klass) {
    if !rs_spell_grant_has(c[0].klass,c[0].level,c[0].vigor,c[0].spell_grants,sp) { _ := rs_select_spell(c, RS_EXEC_SOURCE[sp]); }
  }
}
// The hero you play: the first of the Living's heroes of the picked class still up, or -1.
pick_hero :: (s: [] Lab) {
  if s[0].siege { siege_pick_hero(s); return; }
  b := bt(s);
  s[0].me = -1; s[0].target = -1;
  for i: 0..<rs_min(b[0].n, s[0].heroes) {
    if b[0].c[i].team == 0 && b[0].c[i].klass == ROSTER[s[0].pick] && rs_up(b[0].c[i]) { s[0].me = i; lab_prepare_bar(b[0].c[i..<i+1]); lw_raise(s); return; }
  }
}
set_player :: (s: [] Lab, on: bool) {
  s[0].player = on;
  s[0].you_me = -1; s[0].you_on = false;
  if on { pick_hero(s); s[0].view = VIEW_GLADE; s[0].fast = false; } else { s[0].me = -1; s[0].target = -1; }
}

// ---- Player mode's body and camera: Everglade's. fivelab-face.c steps Everglade's controller
// (aethyr/walk.coax through everglade-step.coax's eg_step_begin and eg_step_advance, the steps
// Everglade's page and room server run) on the keys and the thumb's stick each frame; this is the
// world's half: the figures round you, your Speed and what holds you, and where your body is
// held. Your body moves freely; the rules still decide: your token walks the squares to your body
// on your turn (player_turn), at most your Speed, and reach and range are the token's. Between
// turns your body may go no further from your token than one turn's Speed carries it (lab_keep, the
// gold box on the ground), so the next turn can always bring the token to you.
LAB_NEAR_BODIES :: 24;    // figures round you the controller walks round, capsules of 7 floats
LAB_NEAR_M :: 6.0;        // metres: as far as they are looked for
LAB_BODY_R :: 0.42;       // a figure's capsule round its feet's line
BLEND_TIME :: 1.0;        // seconds the camera takes to swing between the spectator's and the follow camera
// Your body's square: the one under its feet.
you_square_x :: (s: [] Lab) -> int { return cast(int) floor((s[0].you_x + f32(s[0].cols) * f32(SQ) / 2) / f32(SQ)); }
you_square_y :: (s: [] Lab) -> int { return cast(int) floor((s[0].you_z + f32(s[0].rows) * f32(SQ) / 2) / f32(SQ)); }
// The squares one turn's Speed carries you: 0 while you can't move (Grappled, Restrained, down).
you_reach :: (s: [] Lab) -> int {
  b := bt(s);
  if s[0].me < 0 || !rs_can_move(b[0].c[s[0].me]) { return 0; }
  return rs_max(b[0].c[s[0].me].speed / RS_SQUARE, 0);
}
// The controller's camera yaw (Everglade's everglade_player_theta): the keys walk along it. In the
// flat view up the screen is ahead.
you_theta :: (s: [] Lab) -> f32 {
  if s[0].view != VIEW_GLADE { return 0; }
  return figs.wrap_angle(s[0].orbit.yaw + 3.14159265);
}
LabWalk :: struct { on: bool; put: bool; x: f32; y: f32; z: f32; face: f32; }
// Whether the face walks your body this frame, and a place to put it first: a new hero, or your
// token moved by what the rules did (a shove, a new battle).
lab_walk :: (s: [] Lab) -> LabWalk #export_c #effects(all) {
  w: LabWalk;
  if s[0].creator[0].experimental {if s[0].creator[0].hostiles[0].ready && s[0].creator[0].hostiles[0].hp<=0 {return w;}w.on=true;if s[0].put_on {w.put=true;w.x=s[0].put_x;w.y=s[0].put_y;w.z=s[0].put_z;w.face=s[0].put_face;s[0].put_on=false;s[0].you_on=true;}else if !s[0].you_on {w.put=true;s[0].you_on=true;}if w.put {s[0].xc[0].jump=EgJump.{};s[0].xc[0].jump_run=0;s[0].you_x=w.x;s[0].you_y=w.y;s[0].you_z=w.z;s[0].you_face=w.face;s[0].creator[0].player_x=w.x;s[0].creator[0].player_y=w.y;s[0].creator[0].player_z=w.z;}return w;}
  if !s[0].started || !s[0].player || s[0].me < 0 || s[0].golden { s[0].you_on = false; return w; }
  b := bt(s);
  me := s[0].me;
  if me != s[0].you_me || b[0].c[me].x != s[0].my_sx || b[0].c[me].y != s[0].my_sy {
    s[0].put_on = true;
    s[0].put_x = wx(s, f32(b[0].c[me].x)); s[0].put_z = wz(s, f32(b[0].c[me].y));
    if me != s[0].you_me {
      // a new hero faces the way the camera looks, so the follow camera swings in from behind it
      s[0].put_face = figs.atan2(s[0].fwd.x, s[0].fwd.z);
      s[0].orbit = figs.verse_orbit_start(figs.v3(s[0].put_x, 0, s[0].put_z), s[0].put_face);
    } else { s[0].put_face = s[0].you_face; }
    s[0].you_me = me; s[0].my_sx = b[0].c[me].x; s[0].my_sy = b[0].c[me].y;
    s[0].you_x = s[0].put_x; s[0].you_y = 0; s[0].you_z = s[0].put_z; s[0].you_face = s[0].put_face;
  }
  w.on = !s[0].paused;
  s[0].you_on = w.on;
  if s[0].put_on { w.put = true; w.x = s[0].put_x; w.z = s[0].put_z; w.face = s[0].put_face; s[0].put_on = false; }
  return w;
}
// Your keys for Everglade's step: W, A, S and D along the camera, Shift (Everglade runs unless it
// is held: verse_runs), Space to jump. The face adds the thumb's stick.
lab_move_in :: (s: [] Lab) -> EgMoveIn #export_c #effects(all) {
  h := s[0].held;
  // a Dash's sprint runs you ahead the way it heads (xc_sprint_frame steers it), at its pace (lab_move_scale)
  if sprint.sprint_on(s[0].xc[0].dash[0], s[0].creator[0].clock) {
    return EgMoveIn.{key_y = 1, run = true, theta = s[0].xc[0].dash[0].face - 3.14159265, link_flags = 512};
  }
  dm := fd_move_in(s); if dm.ok && h == 0 { return xd_move_in(s, dm.in); }   // an agent's walk-to, face or use (fivelab-drive.coax)
  return xd_move_in(s, EgMoveIn.{key_x = axis(h, HOLD_D, HOLD_A), key_y = axis(h, HOLD_W, HOLD_S), run = s[0].shift,
                   jump = h & HOLD_JUMP != 0, theta = ifx s[0].creator[0].experimental then s[0].creator[0].yaw else you_theta(s)});
}
// The world where you stand, for Everglade's step: the figures round you (lab_move_bodies), your
// Speed as the walk's pace (30 feet Everglade's own), still while you can't move. `deck` keeps
// eg_step_advance's Everglade fountain out of the first figure.
#test "experimental unrecoverable contact returns to the last clear position" {
 s:[1]Lab;s[0].creator[0].experimental=true;s[0].you_on=true;s[0].safe_on=true;s[0].safe_x=7;s[0].safe_y=3;s[0].safe_z=9;s[0].safe_face=1;
 lab_queue_escape(s[..],10,0,12);w:=lab_walk(s[..]);#assert w.on && w.put && w.x==7 && w.y==3 && w.z==9 && w.face==1;
}
// If fixed structural geometry is genuinely unresolved, return to a previously
// accepted clear position rather than publishing an invalid collision step.
#test "experimental escape falls back to spawn if no earlier clear place exists" {
 s:[1]Lab;s[0].creator[0].experimental=true;s[0].you_on=true;lab_queue_escape(s[..],10,0,12);w:=lab_walk(s[..]);#assert w.put && w.x==0 && w.y==0 && w.z==0;
}
#test "experimental crowd does not block the player and mobs yield" {
 s:[1]Lab;s[0].creator[0].experimental=true;s[0].creator[0].hostiles[0].ready=true;
 for i:0..<6 {s[0].creator[0].hostiles[0].enemies[i].x=0;s[0].creator[0].hostiles[0].enemies[i].z=0;}
 w:=lab_move_world(s[..],0,0);#assert w.bodies==0;
 lab_you(s[..],0,0,-0.1,0,false,false,false,0,0,0,0);for i:0..<6 {e:=s[0].creator[0].hostiles[0].enemies[i];#assert e.x*e.x+e.z*e.z>0;}
}
lab_queue_escape :: (s:[]Lab,x:f32,y:f32,z:f32) {
 use_safe:=s[0].safe_on && (abs(s[0].safe_x-x)+abs(s[0].safe_y-y)+abs(s[0].safe_z-z)>0.05);
 s[0].put_on=true;s[0].put_x=ifx use_safe then s[0].safe_x else 0.0f32;s[0].put_y=ifx use_safe then s[0].safe_y else 0.0f32;s[0].put_z=ifx use_safe then s[0].safe_z else 0.0f32;s[0].put_face=ifx use_safe then s[0].safe_face else s[0].you_face;
}
// The combat controller rate is distinct from environmental pace (which the
// generic walker deliberately clamps to one). Other modes retain their path.
lab_move_scale :: (s:[]Lab)->f32 #export_c #effects(all) {
  if !s[0].creator[0].experimental || !s[0].xc[0].started { return 1; }
  xc_sync_world(s);
  // dragging what you grapple costs a foot more each foot (grapple.coax rs_drag_feet): half the pace
  // and a Dash's sprint over your run (aethyr/action/sprint.coax sprint_pace)
  return rs_walk_scale(s[0].xc[0].b[..],0) / f32(1 + rs_drag_feet(s[0].xc[0].b[..],0,XC_AWAY,XC_AWAY)/5) * sprint.sprint_pace(s[0].xc[0].dash[0], s[0].creator[0].clock);
}
lab_move_world :: (s: [] Lab, x: f32, z: f32) -> EgMoveWorld #export_c #effects(all) {
  w: EgMoveWorld;
  w.deck = true;
  if s[0].creator[0].experimental && s[0].creator[0].field {w.bodies=0;w.pace=xc_bow_pace(s);if xd_holds_body(s) {w.pace=0;}return w;}   // the open field: no village, its walls or its bushes
  if s[0].creator[0].experimental {rescue:=village.ev_player_near(s[0].village_near[..],x,s[0].you_y,z);if rescue==2 {lab_queue_escape(s,x,s[0].you_y,z);}else if rescue==0 {s[0].safe_on=true;s[0].safe_x=x;s[0].safe_y=s[0].you_y;s[0].safe_z=z;s[0].safe_face=s[0].you_face;}xc_objects_walls(s,x,z);w.walls=s[0].village_near[0].wall_n;w.floors=s[0].village_near[0].floor_n;w.bodies=0;w.pace=village.ev_bush_pace(x,s[0].you_y,z)*xc_bow_pace(s);if xd_holds_body(s) {w.pace=0;}if sprint.sprint_on(s[0].xc[0].dash[0],s[0].creator[0].clock) {w.link_flags=512;}return w;}
  b := bt(s);
  me := s[0].me;
  if me < 0 { w.still = true; return w; }
  w.still = you_reach(s) == 0;
  w.pace = f32(b[0].c[me].speed) / 30.0;
  n := 0;
  ids: [NEAR_MAX] int;
  m := near_ids(s, b[0].c[me].x, b[0].c[me].y, 20, ids[..]);
  for q: 0..<m {
    j := ids[q];
    if n >= LAB_NEAR_BODIES { break; }
    if j == me || j >= b[0].n || b[0].c[j].dead { continue; }
    jx := wx(s, s[0].dx[j]); jz := wz(s, s[0].dy[j]);
    if abs(jx - x) > f32(LAB_NEAR_M) || abs(jz - z) > f32(LAB_NEAR_M) { continue; }
    o := n * 7;
    s[0].move_bodies[o] = jx; s[0].move_bodies[o + 1] = 0.35; s[0].move_bodies[o + 2] = jz;
    s[0].move_bodies[o + 3] = jx; s[0].move_bodies[o + 4] = 1.5; s[0].move_bodies[o + 5] = jz;
    s[0].move_bodies[o + 6] = f32(LAB_BODY_R);
    n += 1;
  }
  w.bodies = n;
  return w;
}
lab_move_bodies :: (s: [] Lab) -> [] f32 #export_c #effects(all) { return s[0].move_bodies[..]; }
lab_move_walls :: (s: [] Lab) -> [] f32 #export_c #effects(all) { return s[0].village_near[0].walls[..]; }
lab_move_floors :: (s: [] Lab) -> [] f32 #export_c #effects(all) { return s[0].village_near[0].floors[..]; }
// Where your body may be: within one turn's Speed of your token (a box, as the grid counts
// diagonals: 5 feet each), and on the grid.
you_box :: (s: [] Lab) -> Rect {
  r := (f32(you_reach(s)) + 0.5) * f32(SQ) - 0.05;
  cx := wx(s, f32(s[0].my_sx)); cz := wz(s, f32(s[0].my_sy));
  hx := f32(s[0].cols) * f32(SQ) / 2 - 0.3; hz := f32(s[0].rows) * f32(SQ) / 2 - 0.3;
  return Rect.{x0 = hi(cx - r, -hx), y0 = hi(cz - r, -hz), x1 = lo(cx + r, hx), y1 = lo(cz + r, hz)};
}
lab_keep :: (s: [] Lab, x: f32, z: f32) -> P3 #export_c #effects(all) {
  // the meadow's edge, but for the dungeon, which runs on south past it (verse/experimental-dungeon.coax)
  if s[0].creator[0].experimental {kz:=lo(82,hi(-82,z));if x>f32(xdungeon.DG_X0) && x<xdungeon.dg_east() && z< -82 {kz=hi(xdungeon.dg_south()+0.3,z);}return P3.{x=lo(82,hi(-82,x)),z=kz};}
  if s[0].me < 0 { return P3.{x = x, z = z}; }
  r := you_box(s);
  return P3.{x = lo(r.x1, hi(r.x0, x)), z = lo(r.y1, hi(r.y0, z))};
}
// Translate the saved SRD turn to a physical jump envelope. Only an admitted
// rise commits its cost. A running start measures accepted ground motion.
lab_jump_plan :: (s:[] Lab,origin:EgBody,intent:EgMotionIntent,pending:bool)->EgJump #export_c #effects(all) {
  x:=s[0].xc[..];
  if !s[0].creator[0].experimental || !x[0].started { return EgJump.{}; }
  if xd_jump(s,pending) { return EgJump.{mode=EG_JUMP_DENIED}; }   // the dragon's wings take the jump (druid-scene.coax)
  if !origin.ground { return x[0].jump; }
  x[0].jump=EgJump.{};
  if !pending { return x[0].jump; }
  plan:=EgJump.{mode=EG_JUMP_DENIED};
  b:=x[0].b[..]; seat:=x[0].seat[..];
  saved:=seat[0].turn;
  fb_seat_in(b,seat);
  if rs_jump_ready(b,0) {
    b[0].turn.run_ft=ifx x[0].jump_run>=3.048 then 10 else 0;
    score:=rs_jump_score(b[0].c[0]);
    full:=ifx intent.walk then score else rs_max(3+rs_mod(score),0);
    feet:=rs_jump_reach(b,full);
    left:=rs_movement_left(b,0);
    if intent.walk { feet=rs_min(feet,left); }
    if feet>0 && feet<=left {
      plan.mode=ifx intent.walk then EG_JUMP_LONG else EG_JUMP_HIGH;
      plan.feet=feet;
      if intent.walk { plan.span=f32(feet)*f32(XC_FT); }
      else { plan.height=f32(feet)*f32(XC_FT); }
    }
  }
  fb_seat_out(b,seat); seat[0].turn=saved;
  x[0].jump=plan; x[0].jump_x=origin.x; x[0].jump_z=origin.z;
  return plan;
}
lab_jump_limit :: (s:[] Lab,origin:EgBody,body0:EgBody)->EgBody {
  body:=body0; x:=s[0].xc[..]; plan:=x[0].jump;
  if plan.mode<EG_JUMP_HIGH || origin.ground && body.ground { return body; }
  dx:=body.x-x[0].jump_x; dz:=body.z-x[0].jump_z;
  span:=sqrt(dx*dx+dz*dz);
  if span>plan.span {
    body.x=x[0].jump_x+dx*plan.span/span;
    body.z=x[0].jump_z+dz*plan.span/span;
    body.px=body.x; body.pz=body.z; body.vx=0; body.vz=0;
  }
  return body;
}
lab_jump_pay :: (s:[] Lab)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..]; seat:=x[0].seat[..];
  plan:=x[0].jump; saved:=seat[0].turn;
  fb_seat_in(b,seat);
  b[0].turn.run_ft=ifx x[0].jump_run>=3.048 then 10 else 0;
  paid:=false;
  if plan.mode==EG_JUMP_HIGH { paid=rs_high_jump(b,0)==plan.feet; }
  else if rs_jump_ready(b,0) { paid=rs_jump_pay(b,0,plan.feet); }
  fb_seat_out(b,seat);
  if paid { x[0].jump_run=0; }
  else { seat[0].turn=saved; x[0].jump=EgJump.{}; }
  return paid;
}
// Admission between controller advance and body publication. The host only
// transports this result back into the shared controller.
lab_keep_body :: (s:[] Lab,origin:EgBody,proposed:EgBody)->EgBody #export_c #effects(all) {
  lab_ride_dev(s); lab_breath_slot(s);
  if lab_riding(s) { return lab_ride_body(s,origin,proposed); }   // the horse carries you (experimental-ride.coax)
  body:=ifx s[0].creator[0].experimental then lab_jump_limit(s,origin,proposed) else proposed;
  kept:=lab_keep(s,body.x,body.z); body.x=kept.x; body.z=kept.z;
  if body.x!=proposed.x { body.px=body.x; body.vx=0; }
  if body.z!=proposed.z { body.pz=body.z; body.vz=0; }
  if s[0].creator[0].experimental {
    takes_off:=s[0].xc[0].jump.mode>=EG_JUMP_HIGH && origin.ground && !body.ground && body.y>origin.y;
    allowed:=xc_depart(s,origin,body);
    if takes_off && (!allowed || !lab_jump_pay(s)) { return origin; }
    if allowed { return body; }
    body.x=origin.x; body.z=origin.z;
    body.px=body.x; body.pz=body.z; body.vx=0; body.vz=0;
  }
  return body;
}
// Actual body activity after admission. A jump request alone and passive
// falling do not manufacture strenuous locomotion.
lab_rest_motion :: (s:[]Lab,origin:EgBody,body:EgBody,walking:bool,jumping:bool) #export_c #effects(all) {
  walked:=walking && (body.x!=origin.x || body.z!=origin.z);
  jumped:=jumping && origin.ground && !body.ground && body.y>origin.y;
  if s[0].creator[0].experimental {
    if s[0].xc[0].started {
      if walked && origin.ground && body.ground {
        dx:=body.x-origin.x; dz:=body.z-origin.z;
        s[0].xc[0].jump_run=lo(3.048,s[0].xc[0].jump_run+sqrt(dx*dx+dz*dz));
      } else if !walking || jumped || !body.ground || abs(body.vx)+abs(body.vz)<0.01 {
        s[0].xc[0].jump_run=0;
      }
      if body.ground && !origin.ground { s[0].xc[0].jump=EgJump.{}; }
      settled:=body.ground && abs(body.vx)<0.01 && abs(body.vz)<0.01;
      s[0].xc[0].rest_seen=true; s[0].xc[0].rest_settled=settled && !walking && !jumping;
      observed:=rs_rest_observe_motion(s[0].xc[0].b[..],0,walked,jumped,settled);
    }
    return;
  }
  if !s[0].started || !s[0].player { return; }
  b:=bt(s); i:=s[0].me; if i<0 || i>=b[0].n { return; }
  rs_rest_motion(b[0].c[i..<i+1],walked,jumped);
}
// A drawn bow turns you to face where the camera looks, as far as its aim has come in (docs/verse/bow-combat.md).
// Mouselook faces you the same way, as far as its fade has come: A and D strafe, S backpedals.
lab_aim_face :: (s:[]Lab,face:f32)->f32 {
  a:=s[0].creator[0].aim; look:=s[0].creator[0].ml[0].shown; if look>a { a=look; } if a<=0 { return face; }
  d:=figs.wrap_angle(s[0].creator[0].yaw+3.14159265-face);
  return figs.wrap_angle(face+d*a);
}
// Your body after the step (its feet, its facing) and the thumb's stick, for the frame.
lab_you :: (s: [] Lab, x: f32, y: f32, z: f32, face: f32, airborne: bool, touch: bool, stick_on: bool, ox: f32, oy: f32, px: f32, py: f32) #export_c #effects(all) {
  if s[0].creator[0].experimental {hostile.hostile_push(s[0].creator[0].hostiles[..],x,y,z,s[0].you_x,s[0].you_z);cc.experimental_air(s[0].creator[..],airborne);s[0].creator[0].player_x=x;s[0].creator[0].player_y=y+lab_ride_lift(s);s[0].creator[0].player_z=z;s[0].creator[0].player_face=lab_aim_face(s,face);s[0].creator[0].backpedal=s[0].creator[0].ml[0].shown>0.5 && axis(s[0].held,HOLD_W,HOLD_S)<0;s[0].creator[0].moving=axis(s[0].held,HOLD_W,HOLD_S)!=0 || axis(s[0].held,HOLD_D,HOLD_A)!=0 || stick_on || sprint.sprint_on(s[0].xc[0].dash[0],s[0].creator[0].clock);xc_sprint_frame(s);}
  if s[0].creator[0].experimental { xd_you(s); }
  s[0].you_x = x; s[0].you_y = y; s[0].you_z = z; s[0].you_face = face;
  if touch { s[0].touch = true; }
  s[0].stick_on = stick_on; s[0].stick_ox = ox; s[0].stick_oy = oy; s[0].stick_px = px; s[0].stick_py = py;
}
// A thumb's look and pinch (aethyr/sticks.coax), as a drag and the wheel.
lab_look :: (s: [] Lab, dyaw: f32, dpitch: f32, zoom: f32) #export_c #effects(all) {
  s[0].look_yaw += dyaw; s[0].look_pitch += dpitch;
  s[0].orbit = figs.cam_pinch(s[0].orbit, zoom);
}
// The follow camera this frame (aethyr/cam/chase.coax): the look asked for, the arrow keys, after
// your body, kept above the glade's ground.
lab_chase_step :: (s: [] Lab, dt: f32) {
  h := s[0].held; me := s[0].me;
  vx := 0.0f32; vz := 0.0f32;
  if me >= 0 && me < figs.BD_SLOTS { sp := s[0].bodies[0].slot[me].speed; vx = sin(s[0].you_face) * sp; vz = cos(s[0].you_face) * sp; }
  in := figs.CamChaseIn.{look_yaw = s[0].look_yaw, look_pitch = s[0].look_pitch, turn = axis(h, HOLD_LEFT, HOLD_RIGHT), tilt = axis(h, HOLD_UP, HOLD_DOWN),
    zoom = axis(h, HOLD_OUT, HOLD_IN), feet = figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), heading = figs.yaw_of(vx, vz), moving = sqrt(vx * vx + vz * vz) > 0.6};
  s[0].look_yaw = 0; s[0].look_pitch = 0;
  s[0].orbit = figs.cam_chase_floor(figs.cam_chase_orbit(figs.CamMode.{}, s[0].orbit, in, dt), 0.3, dt);
}

// ---- whose turn: battle.coax rs_due's choice (the earliest due, the lowest index on a tie), from a
// heap of (turn, creature) rather than a look at every creature each turn. Every change of a turn's
// time goes in (rs_begin's: due_all; a turn's end and a fresh Skeleton's: due_push); an entry whose
// creature's time has moved on since, or who died, is passed over.
DUE_MAX :: 34816;   // 2 * LAB_MAX: room for the stale; full, it is built again
due_less :: (s: [] Lab, a: int, c: int) -> bool { return s[0].due_t[a] < s[0].due_t[c] || (s[0].due_t[a] == s[0].due_t[c] && s[0].due_i[a] < s[0].due_i[c]); }
due_swap :: (s: [] Lab, a: int, c: int) {
  t := s[0].due_t[a]; s[0].due_t[a] = s[0].due_t[c]; s[0].due_t[c] = t;
  k := s[0].due_i[a]; s[0].due_i[a] = s[0].due_i[c]; s[0].due_i[c] = k;
}
due_push :: (s: [] Lab, i: int) {
  if s[0].due_n >= DUE_MAX { due_all(s); return; }
  q := s[0].due_n; s[0].due_n += 1;
  s[0].due_t[q] = s[0].battle[0].c[i].turn_at; s[0].due_i[q] = i;
  while q > 0 { up := (q - 1) / 2; if !due_less(s, q, up) { break; } due_swap(s, q, up); q = up; }
}
due_pop :: (s: [] Lab) {
  s[0].due_n -= 1;
  if s[0].due_n <= 0 { s[0].due_n = 0; return; }
  s[0].due_t[0] = s[0].due_t[s[0].due_n]; s[0].due_i[0] = s[0].due_i[s[0].due_n];
  q := 0;
  while true {
    l := 2 * q + 1; m := q;
    if l < s[0].due_n && due_less(s, l, m) { m = l; }
    if l + 1 < s[0].due_n && due_less(s, l + 1, m) { m = l + 1; }
    if m == q { break; }
    due_swap(s, q, m); q = m;
  }
}
due_all :: (s: [] Lab) {
  s[0].due_n = 0;
  for i: 0..<s[0].battle[0].n { if !s[0].battle[0].c[i].dead { due_push(s, i); } }
}
// Whose turn is due on the clock, or -1 (the entry stays until its turn is taken: due_push after).
lab_due :: (s: [] Lab) -> int {
  b := bt(s);
  while s[0].due_n > 0 {
    i := s[0].due_i[0]; t := s[0].due_t[0];
    if i >= b[0].n || b[0].c[i].dead || b[0].c[i].turn_at != t { due_pop(s); continue; }
    if t > b[0].clock { return -1; }
    due_pop(s);
    return i;
  }
  return -1;
}
step :: (s: [] Lab, dt: f32) {
  b := bt(s);
  if s[0].over {
    b[0].clock += dt;
    if b[0].clock - s[0].over_t > 6 { new_battle(s); }
    return;
  }
  rs_tick(b, dt);
  blk_count(s);
  // the turns due this step: at most 8, and more for a big battle (two thousand on a 1.5-second
  // beat is some 23 a step), so a crowd keeps its pace and the frame pays for it
  guard := 0; most := 8 + b[0].n / 40;
  due := lab_due(s);
  while due >= 0 && guard < most {
    lab_turn(s, due);
    due_push(s, due);
    guard += 1;
    due = lab_due(s);
  }
  take_events(s);
  if s[0].horde { flood(s); }
  lw_rise(s);
  // the last side standing wins (in the Horde, the dead stand while more are still to come)
  standing := 0; last := -1;
  for t: 0..<TEAMS { if rs_team_up(b, t) > 0 || (t == 2 && s[0].pool > 0) { standing += 1; last = t; } }
  if standing <= 1 && !s[0].over {
    s[0].over = true; s[0].over_t = b[0].clock; s[0].winner = last;
    l: [LINE_CAP] u8;
    n := 0;
    if last >= 0 { s[0].wins[last] += 1; n = put(l[..], 0, team_name(s, last)); n = put(l[..], n, " wins. A new battle in 6 seconds."); }
    else { n = put(l[..], 0, "Nobody is left standing. A new battle in 6 seconds."); }
    add_line(s, cast(string) l[0..<n], GOLD);
  }
  // the tokens go to their squares at a run (3.2 squares a second, faster the further they have to go)
  for i: 0..<b[0].n {
    if i == s[0].me && s[0].you_on { continue; }   // your figure stands where your body is (put_bodies)
    gx := f32(b[0].c[i].x) - s[0].dx[i]; gy := f32(b[0].c[i].y) - s[0].dy[i];
    d := sqrt(gx * gx + gy * gy);
    if d < 0.0001 { continue; }
    go := lo(d, hi(3.2, d * 3) * dt);
    s[0].dx[i] += gx / d * go; s[0].dy[i] += gy / d * go;
  }
}

lab_run :: (s: [] Lab, dt: f32) {
  c := s[0].pace;
  c.step_ns = LAB_STEP_NS; c.max_frame_ns = LAB_FRAME_NS;
  c = loop_accept(c, cast(f64) dt);
  s[0].clock += cast(f32) loop_counted(c);
  speed: f32 = ifx s[0].fast then FAST else 1;
  for k: 0..<loop_due(c) { step(s, f32(STEP) * speed); }
  s[0].pace = loop_ran(c);
}

// ---- drawing

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { size = 0.01; dx = 0.01; dy = 0; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}
seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, w: f32, light: f32, c: Col) -> int {
  if lit(out, n, ax, ay, bx, by, w * 0.55, light, w * 1.8, c.r, c.g, c.b, 0) { return n + 6; }
  return n;
}
ring :: (out: [] f32, at: int, x: f32, y: f32, r: f32, w: f32, light: f32, c: Col) -> int {
  n := at;
  sides := rs_max(8, rs_min(20, int(r * 2)));   // a small ring, fewer sides (the flat view's crowds)
  for i: 0..<sides {
    a0 := f32(i) * 6.2831853 / f32(sides); a1 := f32(i + 1) * 6.2831853 / f32(sides);
    n = seg(out, n, x + cos(a0) * r, y + sin(a0) * r, x + cos(a1) * r, y + sin(a1) * r, w, light, c);
  }
  return n;
}
box_lines :: (out: [] f32, at: int, r: Rect, w: f32, light: f32, c: Col) -> int {
  n := at;
  n = seg(out, n, r.x0, r.y0, r.x1, r.y0, w, light, c);
  n = seg(out, n, r.x1, r.y0, r.x1, r.y1, w, light, c);
  n = seg(out, n, r.x1, r.y1, r.x0, r.y1, w, light, c);
  n = seg(out, n, r.x0, r.y1, r.x0, r.y0, w, light, c);
  return n;
}
ink :: (k: f32, light: f32, c: Col) -> Ink {
  i: Ink;
  i.core = 0.6 * k; i.light = light; i.glow = 1.2 * k; i.red = c.r; i.green = c.g; i.blue = c.b; i.mode = 0; i.scale = k;
  return i;
}
say_at :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, k, false, false);
}
say_mid :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap) / 2, base, cap, k);
}
say_right :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap), base, cap, k);
}
// A square's middle on the screen.
scr_x :: (s: [] Lab, x: f32) -> f32 { return s[0].gx + (x + 0.5) * s[0].cell; }
scr_y :: (s: [] Lab, y: f32) -> f32 { return s[0].gy + (y + 0.5) * s[0].cell; }

norm3 :: (v: P3) -> P3 {
  l := sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
  if l <= 0 { return P3.{x = 0, y = 0, z = -1}; }
  return P3.{x = v.x / l, y = v.y / l, z = v.z / l};
}
// Where a square's middle is on the ground, metres.
wx :: (s: [] Lab, x: f32) -> f32 { return (x + 0.5) * f32(SQ) - f32(s[0].cols) * f32(SQ) / 2; }
wz :: (s: [] Lab, y: f32) -> f32 { return (y + 0.5) * f32(SQ) - f32(s[0].rows) * f32(SQ) / 2; }
// A point in the glade on the screen: x, y (device px) and its depth (0 or less: behind the eye).
proj :: (s: [] Lab, x: f32, y: f32, z: f32) -> P3 {
  dx := x - s[0].eye.x; dy := y - s[0].eye.y; dz := z - s[0].eye.z;
  depth := dx * s[0].fwd.x + dy * s[0].fwd.y + dz * s[0].fwd.z;
  if depth <= 0.05 { return P3.{x = 0, y = 0, z = 0}; }
  a := (dx * s[0].right.x + dy * s[0].right.y + dz * s[0].right.z) / depth;
  b := (dx * s[0].up.x + dy * s[0].up.y + dz * s[0].up.z) / depth;
  return P3.{x = s[0].cx + a * s[0].focal, y = s[0].cy - b * s[0].focal, z = depth};
}
seg3 :: (s: [] Lab, out: [] f32, n: int, a: P3, b: P3, w: f32, light: f32, c: Col) -> int {
  pa := proj(s, a.x, a.y, a.z); pb := proj(s, b.x, b.y, b.z);
  if pa.z <= 0 || pb.z <= 0 { return n; }
  return seg(out, n, pa.x, pa.y, pb.x, pb.y, w, light, c);
}
ring3 :: (s: [] Lab, out: [] f32, at: int, x: f32, z: f32, r: f32, y: f32, w: f32, light: f32, c: Col) -> int {
  n := at;
  for i: 0..<24 {
    a0 := f32(i) * 6.2831853 / 24; a1 := f32(i + 1) * 6.2831853 / 24;
    n = seg3(s, out, n, P3.{x = x + cos(a0) * r, y = y, z = z + sin(a0) * r}, P3.{x = x + cos(a1) * r, y = y, z = z + sin(a1) * r}, w, light, c);
  }
  return n;
}

layout :: (s: [] Lab, w: f32, h: f32, k: f32) {
  s[0].portrait = h > w * 1.1;
  pad := 16 * k;
  top := ifx s[0].portrait then 92 * k else 64 * k;
  gw := w - pad * 2; gh := h - top - pad;
  if s[0].portrait {
    gh = h * ifx s[0].player then 0.6f32 else 0.42f32;   // playing, the scene takes more of a phone
    s[0].panel = Rect.{x0 = pad, y0 = top + gh + pad, x1 = w - pad, y1 = h - pad};
  } else {
    pw := lo(hi(w * 0.34, 300 * k), 560 * k);
    gw = w - pw - pad * 3;
    s[0].panel = Rect.{x0 = w - pw - pad, y0 = top, x1 = w - pad, y1 = h - pad};
  }
  cell := lo(gw / f32(s[0].cols), gh / f32(s[0].rows));
  s[0].cell = cell;
  s[0].gx = pad + (gw - cell * f32(s[0].cols)) / 2;
  s[0].gy = top + (gh - cell * f32(s[0].rows)) / 2;
  bw := 96 * k;
  s[0].back = Rect.{x0 = w - pad - bw, y0 = 18 * k, x1 = w - pad, y1 = 46 * k};
  s[0].flip = Rect.{x0 = s[0].back.x0 - 8 * k - bw, y0 = 18 * k, x1 = s[0].back.x0 - 8 * k, y1 = 46 * k};
  mw := 128 * k;
  s[0].modal = Rect.{x0 = s[0].flip.x0 - 8 * k - mw, y0 = 18 * k, x1 = s[0].flip.x0 - 8 * k, y1 = 46 * k};
  // a phone has no room beside the title: the mode sits in the scene's bottom-left corner
  if s[0].portrait { s[0].modal = Rect.{x0 = pad, y0 = s[0].panel.y0 - 8 * k - 28 * k, x1 = pad + mw, y1 = s[0].panel.y0 - 8 * k}; }
  pbw := 104 * k;
  s[0].pbtn = Rect.{x0 = s[0].modal.x0 - 8 * k - pbw, y0 = s[0].modal.y0, x1 = s[0].modal.x0 - 8 * k, y1 = s[0].modal.y1};
  if s[0].portrait { s[0].pbtn = Rect.{x0 = s[0].modal.x1 + 8 * k, y0 = s[0].modal.y0, x1 = s[0].modal.x1 + 8 * k + pbw, y1 = s[0].modal.y1}; }
  // the scenario (Horde, Armies or Siege; H cycles them): left of the Spectator switch, on a phone
  // a row above the mode switch (the FPS has the right of its row)
  sbw := 84 * k;
  s[0].sbtn = Rect.{x0 = s[0].pbtn.x0 - 8 * k - sbw, y0 = s[0].pbtn.y0, x1 = s[0].pbtn.x0 - 8 * k, y1 = s[0].pbtn.y1};
  if s[0].portrait { s[0].sbtn = Rect.{x0 = pad, y0 = s[0].modal.y0 - 36 * k, x1 = pad + sbw, y1 = s[0].modal.y0 - 8 * k}; }
  // Player mode: the class picker along the scene's top, the hotbar centred at its foot
  scx0 := pad; scx1 := ifx s[0].portrait then w - pad else s[0].panel.x0 - pad;
  scy1 := ifx s[0].portrait then s[0].modal.y0 - (ifx s[0].player then 34.0f32 else 8.0f32) * k else h - pad;   // playing: room for the keys under it
  np := pick_count(s);
  pg := 4 * k; pwid := (scx1 - scx0 - f32(np - 1) * pg) / f32(np);
  for c: 0..<12 {
    s[0].picks[c] = Rect.{};
    if c < np { s[0].picks[c] = Rect.{x0 = scx0 + f32(c) * (pwid + pg), y0 = top + 6 * k, x1 = scx0 + f32(c) * (pwid + pg) + pwid, y1 = top + 30 * k}; }
  }
  nslot := 0;
  if s[0].player && s[0].me >= 0 { list: [SLOTS] Ab; nslot = hero_abilities(s, s[0].me, list[..]); }
  sg := 6 * k; slot := lo(64 * k, (scx1 - scx0 - f32(SLOTS - 1) * sg) / f32(SLOTS));
  hx0 := (scx0 + scx1) / 2 - (f32(nslot) * slot + f32(rs_max(nslot - 1, 0)) * sg) / 2;
  for c: 0..<SLOTS {
    s[0].slots[c] = Rect.{};
    if c < nslot { s[0].slots[c] = Rect.{x0 = hx0 + f32(c) * (slot + sg), y0 = scy1 - 20 * k - slot, x1 = hx0 + f32(c) * (slot + sg) + slot, y1 = scy1 - 20 * k}; }
  }
  if !s[0].player { for c: 0..<12 { s[0].picks[c] = Rect.{}; } }
  layout_sliders(s, k, scx0, scx1, top + ifx s[0].player then 34 * k else 4 * k);
  // the scene's top for floating numbers: under the sliders
  s[0].scene_top = top; for r: 0..<sl_count(s) { s[0].scene_top = hi(s[0].scene_top, s[0].sliders[r].y1 + 8 * k); }
  // the glade's camera, fitted to the space left of the log (above it on a phone)
  rx0 := pad; rx1 := ifx s[0].portrait then w - pad else s[0].panel.x0 - pad;
  ry0 := top; ry1 := ifx s[0].portrait then s[0].panel.y0 - pad else h - pad;
  if s[0].film != FILM_NONE { rx0 = 0; rx1 = w; ry0 = 0; ry1 = h; s[0].panel = Rect.{}; }   // a film: the whole frame, no log's glass
  s[0].cx = (rx0 + rx1) / 2; s[0].cy = (ry0 + ry1) / 2;
  // Aethyr's orbit (yaw 0 faces +Z there; here yaw 0 looks toward -Z, so it turns half round)
  turn := s[0].yaw + 3.14159265;
  ray := ash.shot_orbit_ray(asp.world_point(s[0].px, 0.5, s[0].pz), turn, s[0].pitch, s[0].dist, 0);
  shot := ash.shot_orbit(ray, ray.far, turn, s[0].pitch);
  s[0].eye = P3.{x = shot.eye.x, y = shot.eye.y, z = shot.eye.z};
  s[0].fwd = norm3(P3.{x = shot.at.x - shot.eye.x, y = shot.at.y - shot.eye.y, z = shot.at.z - shot.eye.z});
  s[0].right = norm3(P3.{x = -s[0].fwd.z, y = 0, z = s[0].fwd.x});
  r := s[0].right; f := s[0].fwd;
  s[0].up = P3.{x = r.y * f.z - r.z * f.y, y = r.z * f.x - r.x * f.z, z = r.x * f.y - r.y * f.x};
  s[0].focal = lo((rx1 - rx0) * 27 / (30 * f32(COLS) / 16), (ry1 - ry0) * 27 / (19 * f32(ROWS) / 10));   // fitted at the default orbit (it backs off as the grid grows); + and - zoom from there
  // Player mode: Everglade's follow camera (lab_chase_step), with Everglade's lens (everglade-face.c:
  // its vertical scale from the view's shape), swung in from the spectator's over BLEND_TIME
  if s[0].blend > 0 {
    sp := figs.Shot.{eye = figs.v3(s[0].eye.x, s[0].eye.y, s[0].eye.z), at = figs.v3(shot.at.x, shot.at.y, shot.at.z)};
    mix := figs.verse_shot_mix(sp, figs.verse_orbit_shot(s[0].orbit), s[0].blend);
    s[0].eye = P3.{x = mix.eye.x, y = mix.eye.y, z = mix.eye.z};
    s[0].fwd = norm3(P3.{x = mix.at.x - mix.eye.x, y = mix.at.y - mix.eye.y, z = mix.at.z - mix.eye.z});
    s[0].right = norm3(P3.{x = -s[0].fwd.z, y = 0, z = s[0].fwd.x});
    r = s[0].right; f = s[0].fwd;
    s[0].up = P3.{x = r.y * f.z - r.z * f.y, y = r.z * f.x - r.x * f.z, z = r.x * f.y - r.y * f.x};
    vh := hi(ry1 - ry0, 1);
    fy := lo(1.9, hi(0.95, (rx1 - rx0) / vh * 1.25));
    e := s[0].blend * s[0].blend * (3 - 2 * s[0].blend);
    s[0].focal += (fy * vh / 2 - s[0].focal) * e;
  }
}

// The battle's lasting areas on the board: each one's outline (aethyr/action/area-aim.coax, class-kit.coax
// xk_zone_area: a Line, a circle or its squares), held to the board, and what grows in its squares.
board_areas :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; c := s[0].cell;
  bx1 := s[0].gx + c * f32(s[0].cols); by1 := s[0].gy + c * f32(s[0].rows);
  for z: 0..<RS_ZONES {
    zo := s[0].battle[0].zone[z];
    if !zo.on { continue; }
    col := spell_rgb(zo.spell);
    area := xk_zone_area(zo); lx: f32 = 0; ly: f32 = 0;
    for p: 0..<aa.AREA_EDGE + 1 {
      w := aa.area_aim_point(area, p);
      px := lo(hi(s[0].gx + w[0] * c, s[0].gx), bx1); py := lo(hi(s[0].gy + w[1] * c, s[0].gy), by1);
      if aa.area_aim_joined(area, p) { n = seg(out, n, lx, ly, px, py, 1.2 * k, 0.55, col); }
      lx = px; ly = py;
    }
    for y: zo.y0..<(zo.y1 + 1) {
      for x: zo.x0..<(zo.x1 + 1) {
        if x < 0 || y < 0 || x >= s[0].cols || y >= s[0].rows { continue; }
        px := s[0].gx + f32(x) * c; py := s[0].gy + f32(y) * c;
        if zo.spell == SP_ENTANGLE {
          // plants: a few sprigs to a square
          w := 0.08 * sin(t * 1.7 + f32(x * 3 + y));
          n = seg(out, n, px + c * 0.25, py + c * 0.8, px + c * (0.3 + w), py + c * 0.45, 1.0 * k, 0.4, col);
          n = seg(out, n, px + c * 0.6, py + c * 0.85, px + c * (0.55 - w), py + c * 0.5, 1.0 * k, 0.4, col);
          n = seg(out, n, px + c * 0.75, py + c * 0.7, px + c * (0.82 + w), py + c * 0.35, 1.0 * k, 0.4, col);
        } else {
          // faerie light: motes that drift
          for m: 0..<2 {
            ph := t * 0.9 + f32(x * 7 + y * 13 + m * 5);
            mx := px + c * (0.3 + 0.4 * f32(m)) + sin(ph) * c * 0.12;
            my := py + c * 0.5 + cos(ph * 1.3) * c * 0.2;
            n = seg(out, n, mx, my, mx + 0.5, my, 1.6 * k, 0.5 + 0.3 * sin(ph * 2), col);
          }
        }
      }
    }
  }
  return n;
}

// The flat view's tokens: bg_fs draws each one's ring from the frame store (every creature, however
// many: gpu/fivelab.coax fivelab_flat_tokens); these are what a token wears besides, on squares big
// enough to read them (TOKEN_MARKS_PX), and only the ones on the screen.
TOKEN_MARKS_PX :: 12.0;
draw_tokens :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; c := s[0].cell;
  b := bt(s);
  if c < f32(TOKEN_MARKS_PX) * k { return n; }
  for i: 0..<b[0].n {
    cr := b[0].c[i..<i + 1];   // in place, not a copy
    x := scr_x(s, s[0].dx[i]); y := scr_y(s, s[0].dy[i]);
    if x < -c || y < -c || x > s[0].width + c || y > s[0].height + c { continue; }
    if n + LABEL_VERTS > SCENE_VERTS { s[0].unlabelled += 1; continue; }
    col := team_col(s, cr[0].team);
    r := c * 0.34;
    if cr[0].dead {
      g := FAINT;
      n = seg(out, n, x - r * 0.6, y - r * 0.6, x + r * 0.6, y + r * 0.6, 2 * k, 0.5, g);
      n = seg(out, n, x - r * 0.6, y + r * 0.6, x + r * 0.6, y - r * 0.6, 2 * k, 0.5, g);
      continue;
    }
    down := cr[0].hp == 0;
    light: f32 = ifx down then 0.35 else 0.95;
    if down { col = DIM; }
    if cr[0].outlined_by >= 0 { n = ring(out, n, x, y, r * 1.12, 2.2 * k, 0.55 + 0.25 * sin(t * 5), VIOLET); }
    if c >= 14 * k { n = ring(out, n, x, y, r * 0.55, 1.1 * k, light * 0.5, col); }
    if down {
      // Unconscious: the death saves, as ticks
      for d: 0..<3 {
        ok := d < cr[0].death_ok; bad := d < cr[0].death_fail;
        n = seg(out, n, x - r * 0.5 + f32(d) * r * 0.5, y - r * 0.15, x - r * 0.5 + f32(d) * r * 0.5, y - r * 0.15 + 0.5, 3 * k, 0.8, ifx ok then GREEN else FAINT);
        n = seg(out, n, x - r * 0.5 + f32(d) * r * 0.5, y + r * 0.25, x - r * 0.5 + f32(d) * r * 0.5, y + r * 0.25 + 0.5, 3 * k, 0.8, ifx bad then RED else FAINT);
      }
    }
    if rs_has(cr[0], RS_RESTRAINED) {
      g := spell_rgb(SP_ENTANGLE);
      for v: 0..<4 {
        a := f32(v) * 1.5708 + t * 0.4;
        n = seg(out, n, x + cos(a) * r * 1.05, y + sin(a) * r * 1.05, x + cos(a + 0.9) * r * 0.75, y + sin(a + 0.9) * r * 0.75, 1.6 * k, 0.8, g);
      }
    }
    if cr[0].flame_until > b[0].clock {
      fl := spell_rgb(SP_PRODUCE_FLAME);
      fx := x + r * 0.95; fy := y - r * 0.85;
      n = seg(out, n, fx, fy + 3 * k, fx + sin(t * 9) * 1.5 * k, fy - 5 * k, 3 * k, 0.9, fl);
    }
    if cr[0].wisp_until > b[0].clock { n = ring(out, n, x, y, r * 0.2, 2 * k, 0.9, spell_rgb(SP_STARRY_WISP)); }
    // the name, and the hit points
    cap := lo(hi(c * 0.15, 8 * k), 14 * k);
    nm := cast(string) b[0].c[i].name[0..<b[0].c[i].name_n];
    if c >= 18 * k { n = say_mid(out, n, nm, x, y - r - 5 * k, cap, ink(k, light * 0.85, col)); }
    bw := c * 0.7; by := y + r + 6 * k;
    share := f32(cr[0].hp) / f32(rs_max(cr[0].hp_max, 1));
    n = seg(out, n, x - bw / 2, by, x + bw / 2, by, 2.4 * k, 0.18, FAINT);
    hc := ifx share > 0.5 then GREEN else ifx share > 0.25 then GOLD else RED;
    if share > 0 { n = seg(out, n, x - bw / 2, by, x - bw / 2 + bw * share, by, 2.4 * k, 0.85, hc); }
    if cr[0].conc >= 0 {
      cc := spell_rgb(cr[0].conc);
      n = seg(out, n, x - bw / 2, by + 5 * k, x + bw / 2, by + 5 * k, 1.0 * k, 0.6, cc);
    }
  }
  return n;
}

// The flat view's effects: the glade's own causes seen from above (aethyr/fx/flat.coax), as strokes.
draw_casts :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at; c := s[0].cell;
  pf := s[0].puffs[..];
  pf[0].out_n = 0;   // the flat view writes no puffs
  now := s[0].battle[0].clock;
  if now < s[0].fx_last { fxp_clear(pf); }   // a new battle: its clock starts again
  s[0].fx_last = now;
  g := lab_grid(s);
  for q: 0..<FX_LIVE {
    if !pf[0].on[q] { continue; }
    f := fxf_of(pf[0].live[q], now);
    if f.kind == FXF_NONE { continue; }
    ax := s[0].gx + (f.ax - g.x0) / g.sq * c; ay := s[0].gy + (f.az - g.z0) / g.sq * c;
    if f.kind == FXF_LINE { n = seg(out, n, ax, ay, s[0].gx + (f.bx - g.x0) / g.sq * c, s[0].gy + (f.bz - g.z0) / g.sq * c, 3 * k, f.alpha, rgb_col(f.col)); }
    else { n = ring(out, n, ax, ay, f.r / g.sq * c, 2 * k, f.alpha, rgb_col(f.col)); }
  }
  return n;
}
// The flat view's numbers floating off the figures.
draw_nums :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at; c := s[0].cell;
  now := s[0].battle[0].clock;
  for i: 0..<FXS {
    f := s[0].fx[i];
    if f.kind != FX_TEXT { continue; }
    a := (now - f.t0) / f.life;
    if a < 0 || a > 1 { continue; }
    if n + LABEL_VERTS > SCENE_VERTS { s[0].unlabelled += 1; continue; }
    x := scr_x(s, f.ax) + c * 0.3; y := scr_y(s, f.ay) - c * 0.3 - a * c * 0.5;
    n = say_mid(out, n, cast(string) f.text[0..<f.n], x, y, lo(hi(c * 0.22, 11 * k), 20 * k), ink(k, 1 - a * 0.7, f.col));
  }
  return n;
}

// The glade's plates over its creatures, placed by the shared plates (aethyr/ui/hud-plates.coax) and
// drawn in the 5E Lab's strokes: every living figure's hit points (past LABELS_ALL creatures only the
// near ones', within 24 m), and the names where they don't pile up: first the ones always shown (a
// siege's leader, the hero you play, your target), then the rest nearest first; a covered name adds
// to the count on the one over it ("WARLOCK 4 +3") while its bar stays. Under a bar, its
// concentration and a dying figure's death saves; a Produce Flame in its hand.
NP_MAX :: 160;   // the names whose boxes the floating numbers keep off (draw_nums3)
lab_view3 :: (s: [] Lab) -> cc.HudPlateView {
  return cc.HudPlateView.{eye = [3] f32.[s[0].eye.x, s[0].eye.y, s[0].eye.z], fwd = [3] f32.[s[0].fwd.x, s[0].fwd.y, s[0].fwd.z],
                          right = [3] f32.[s[0].right.x, s[0].right.y, s[0].right.z], up = [3] f32.[s[0].up.x, s[0].up.y, s[0].up.z],
                          focal = s[0].focal, cx = s[0].cx, cy = s[0].cy, w = s[0].width, h = s[0].height};
}
np_first :: (s: [] Lab, i: int) -> bool { return s[0].battle[0].c[i].npc == RS_NPC_ARCH || i == s[0].me || i == s[0].target; }
lab_heads3 :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; b := bt(s); s[0].plates_n = 0;
  if s[0].width < 1 || s[0].height < 1 { return n; }
  pl := s[0].heads[..]; view := lab_view3(s);
  cc.hud_plates_begin(pl); pl[0].fold = true; pl[0].far = 0; pl[0].margin = 80 * k;
  cap := 10 * k; pl[0].cap = cap;
  if !s[0].portrait { cc.hud_plates_keep_out(pl, s[0].panel.x0 - 8 * k, -100000, 100000, 100000); }   // never over the log
  crowd := b[0].n > LABELS_ALL;
  who: [cc.HUD_PLATES] int;
  for i: 0..<b[0].n {
    cr := b[0].c[i..<i + 1];   // in place, not a copy
    if cr[0].dead { continue; }
    x := wx(s, s[0].dx[i]); z := wz(s, s[0].dy[i]);
    lift: f32 = ifx cr[0].hp == 0 then 0.75 else 2.2;
    if crowd { pz := proj(s, x, lift, z); if pz.z > 24 { continue; } }   // past 400, only the near ones' bars: far off they'd carpet the field
    named := cr[0].klass != RS_MONSTER || siege_named(cr[0]);
    q := cc.hud_plates_add(pl, x, lift, z, ifx named then cast(string) cr[0].name[0..<cr[0].name_n] else "", f32(cr[0].hp) / f32(rs_max(cr[0].hp_max, 1)), false, false, 1);
    if q < 0 { s[0].unlabelled += 1; continue; }
    pl[0].items[q].first = np_first(s, i); who[q] = i;
    if named { pl[0].items[q].wide = text_width(cast(string) cr[0].name[0..<cr[0].name_n], cap); }
  }
  cc.hud_plates_place(pl, view);
  l: [16] u8;
  for q: 0..<pl[0].n {
    plate := pl[0].items[q];
    if !(plate.shown > 0) { continue; }
    if n + LABEL_VERTS > SCENE_VERTS { s[0].unlabelled += 1; continue; }
    cr := b[0].c[who[q]..<who[q] + 1];
    col := ifx cr[0].hp == 0 then DIM else team_col(s, cr[0].team);
    px := plate.sx; by := plate.sy;
    bw := ifx cr[0].klass == RS_MONSTER then 26 * k else 46 * k;
    n = seg(out, n, px - bw / 2, by, px + bw / 2, by, 2.6 * k, 0.25, FAINT);
    hc := ifx plate.share > 0.5 then GREEN else ifx plate.share > 0.25 then GOLD else RED;
    if plate.share > 0 { n = seg(out, n, px - bw / 2, by, px - bw / 2 + bw * plate.share, by, 2.6 * k, 0.95, hc); }
    if cr[0].conc >= 0 { n = seg(out, n, px - bw / 2, by + 5 * k, px + bw / 2, by + 5 * k, 1.1 * k, 0.8, spell_rgb(cr[0].conc)); }
    if cr[0].hp == 0 {
      for d: 0..<3 {
        ok := d < cr[0].death_ok; bad := d < cr[0].death_fail;
        tick_x := px - 10 * k + f32(d) * 10 * k;
        n = seg(out, n, tick_x, by + 11 * k, tick_x + 0.5, by + 11 * k, 3 * k, 0.9, ifx ok then GREEN else ifx bad then RED else FAINT);
      }
    }
    if cr[0].flame_until > b[0].clock {
      fl := spell_rgb(SP_PRODUCE_FLAME);
      fq := proj(s, plate.x + 0.42, 2.0, plate.z + 0.08);
      if fq.z > 0 { n = seg(out, n, fq.x, fq.y + 3 * k, fq.x + sin(t * 9) * 1.5 * k, fq.y - 7 * k, 4 * k, 1.0, fl); }
    }
    if !plate.named { continue; }
    y := by - 8 * k;
    if s[0].plates_n < NP_MAX { s[0].plates[s[0].plates_n] = Rect.{x0 = px - plate.wide / 2 - 2 * k, y0 = y - cap - 1 * k, x1 = px + plate.wide / 2 + 2 * k, y1 = y + 2 * k}; s[0].plates_n += 1; }
    n = say_mid(out, n, cast(string) cr[0].name[0..<cr[0].name_n], px, y, cap, ink(k, 0.95, col));
    if plate.more > 0 {
      m := put(l[..], 0, "+"); m = put_int(l[..], m, plate.more);
      n = say_at(out, n, cast(string) l[0..<m], px + plate.wide / 2 + 3 * k, y, 7 * k, ink(k, 0.75, col));
    }
  }
  s[0].unlabelled += pl[0].full;
  return n;
}
abs_f :: (v: f32) -> f32 { return ifx v < 0 then -v else v; }
// The glade's effects: the frame's puffs (aethyr/fx/puff.coax) for the host to draw over bg_fs
// (fivelab-fx.wgsl, host.js particles), the lasting zones' motes with them (aethyr/fx/battle.coax).
glade_puffs :: (s: [] Lab) {
  now := s[0].battle[0].clock;
  pf := s[0].puffs[..];
  if now < s[0].fx_last { fxp_clear(pf); }   // a new battle: its clock starts again
  s[0].fx_last = now;
  fxp_begin(pf, now, fxp_v(s[0].eye.x, s[0].eye.y, s[0].eye.z));
  fxp_emit_all(pf, now);
  fxe_zones(pf, bt(s), lab_grid(s), s[0].clock);
  // what lasts on each creature: a few puffs each, capped (FX_STATUS_CAP), after the effects
  for i: 0..<s[0].battle[0].n {
    lf := fx_marks(s, i);
    if lf == 0 { continue; }
    feet := fxp_v(wx(s, s[0].dx[i]), 0, wz(s, s[0].dy[i]));
    fxp_status(pf, feet, fxp_v(feet.x + 0.3, 1.1, feet.z), lf, now, f32(i) * 1.37 + 0.4);
  }
  rep := fxp_close(pf);
}
// The glade's numbers floating off the figures, as strokes, placed as the nameplates are
// (lab_heads3): the folds' totals first, then the rest, each lifted until it clears those placed
// before it.
draw_nums3 :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at;
  now := s[0].battle[0].clock;
  px: [FXS] f32; py: [FXS] f32; pw: [FXS] f32; ph: [FXS] f32; np := 0;
  for pass: 0..<2 {
    for i: 0..<FXS {
      f := s[0].fx[i];
      if f.kind != FX_TEXT { continue; }
      total := f.life > 1.5;   // a fold's total (take_events): above the numbers it stands for, larger
      if total != (pass == 0) { continue; }
      a := (now - f.t0) / f.life;
      if a < 0 || a > 1 { continue; }
      p := proj(s, wx(s, f.ax) + 0.4, ifx total then 4.2 + a * 0.6 else 2.3 + a * 1.0, wz(s, f.ay));
      if p.z <= 0 { continue; }
      if n + LABEL_VERTS > SCENE_VERTS { s[0].unlabelled += 1; continue; }
      cap := ifx total then 18 * k else 15 * k;
      tx := cast(string) f.text[0..<f.n];
      w := text_width(tx, cap); x := p.x + 24 * k; y := p.y - 14 * k;
      // a total lifts up to three times to clear the others; a plain number once, and one still
      // covered is left to the log
      tries := 0; moved := true; most := ifx total then 3 else 1;
      while moved && tries <= most {
        moved = false;
        for q: 0..<np {
          if !moved && abs_f(x - px[q]) * 2 < w + pw[q] + 4 * k && abs_f(y - py[q]) < (cap + ph[q]) / 2 + 2 * k { y = py[q] - ph[q] - 3 * k; moved = true; }
        }
        // and off the nameplates
        for q: 0..<s[0].plates_n {
          r := s[0].plates[q];
          if !moved && x + w / 2 > r.x0 && x - w / 2 < r.x1 && y > r.y0 && y - cap < r.y1 { y = r.y0 - 3 * k; moved = true; }
        }
        tries += 1;
      }
      if moved || y - cap < s[0].scene_top { continue; }
      if !s[0].portrait && x + w / 2 > s[0].panel.x0 - 8 * k { continue; }
      if np < FXS { px[np] = x; py[np] = y; pw[np] = w; ph[np] = cap; np += 1; }
      n = say_mid(out, n, tx, x, y, cap, ink(k, 1 - a * ifx total then 0.5 else 0.7, f.col));
    }
  }
  return n;
}

draw_panel :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at; p := s[0].panel; b := bt(s);
  n = box_lines(out, n, p, 0.6 * k, 0.3, DIM);
  pad := 12 * k; x := p.x0 + pad; y := p.y0 + pad;
  cap := 8.5 * k; row := 16 * k;
  crow := 11.5 * k;
  // the characters
  y += cap;
  n = say_at(out, n, "CHARACTERS", x, y, cap, ink(k, 0.6, DIM));
  y += row * 0.6;
  l: [LINE_CAP] u8;
  // the two sides in two columns, a row each: the first company of 48 (the rest counted below)
  top := y; half := (p.x1 - p.x0) / 2;
  for q: 0..<2 * SIDE {
    i := panel_who(s, q);
    if i < 0 { continue; }
    cr := b[0].c[i];
    x = p.x0 + pad + f32(q / SIDE) * half;
    y = top + f32(q % SIDE + 1) * crow;
    col := ifx cr.dead then FAINT else team_col(s, cr.team);
    n = say_at(out, n, cast(string) cr.name[0..<cr.name_n], x, y, cap * 0.92, ink(k, 0.85, col));
    m := put(l[..], 0, "HP ");
    m = put_int(l[..], m, cr.hp); m = put(l[..], m, "/"); m = put_int(l[..], m, cr.hp_max);
    if cr.temp > 0 { m = put(l[..], m, " +"); m = put_int(l[..], m, cr.temp); }
    m = put(l[..], m, "  AC "); m = put_int(l[..], m, cr.ac);
    kl := cr.klass;
    if kl == RS_BARBARIAN { m = put(l[..], m, "  RAGES "); m = put_int(l[..], m, cr.rages); }
    else if kl == RS_MONK { m = put(l[..], m, "  FOCUS "); m = put_int(l[..], m, cr.focus); }
    else if kl == RS_FIGHTER {
      m = put(l[..], m, "  SECOND WIND "); m = put_int(l[..], m, cr.uses[RS_USE_WIND]);
      m = put(l[..], m, "  SURGE "); m = put_int(l[..], m, cr.uses[RS_USE_SURGE]);
    }
    else if kl == RS_ROGUE { m = put(l[..], m, "  SNEAK "); m = put_int(l[..], m, cr.sneak_dice); m = put(l[..], m, "D6"); }
    else {
      // the slots it has, lowest level first: 4+3+3 (Pact Magic's are all of one level)
      first := true;
      for sl_: 1..<10 {
        if cr.slots_max[sl_] <= 0 { continue; }
        m = put(l[..], m, ifx first then "  SLOTS " else "+");
        m = put_int(l[..], m, cr.slots[sl_]); first = false;
      }
    }
    if kl == RS_DRUID { m = put(l[..], m, "  LAND'S AID "); m = put_int(l[..], m, cr.uses[RS_USE_WILD]); }
    if kl == RS_BARD { m = put(l[..], m, "  INSP "); m = put_int(l[..], m, cr.uses[RS_USE_INSPIRE]); }
    if kl == RS_CLERIC || kl == RS_PALADIN { m = put(l[..], m, "  CHANNEL "); m = put_int(l[..], m, cr.uses[RS_USE_CHANNEL]); }
    if kl == RS_PALADIN { m = put(l[..], m, "  LAY ON HANDS "); m = put_int(l[..], m, cr.uses[RS_USE_LAY]); }
    if kl == RS_RANGER { m = put(l[..], m, "  MARKS "); m = put_int(l[..], m, cr.uses[RS_USE_FREE]); }
    if kl == RS_SORCERER { m = put(l[..], m, "  SORCERY "); m = put_int(l[..], m, cr.uses[RS_USE_SORCERY]); }
    m0 := m;   // the resources; what follows is its state, dropped when the row has no room
    if cr.dead { m = put(l[..], 0, "DEAD"); m0 = m; }
    else if cr.hp == 0 { m = put(l[..], m, cast(string) (ifx cr.stable then "  STABLE" else "  DYING")); }
    else {
      if rs_has(cr, RS_RESTRAINED) { m = put(l[..], m, "  RESTRAINED"); }
      if rs_has(cr, RS_POISONED) { m = put(l[..], m, "  POISONED"); }
      if rs_has(cr, RS_BLINDED) { m = put(l[..], m, "  BLINDED"); }
      if rs_effect(cr, EF_ENFEEBLED) { m = put(l[..], m, "  ENFEEBLED"); }
      if rs_effect(cr, EF_NOHEAL) { m = put(l[..], m, "  CHILLED"); }
      if rs_has(cr, RS_PARALYZED) { m = put(l[..], m, "  PARALYZED"); }
      if rs_effect(cr, EF_HEX) { m = put(l[..], m, "  HEXED"); }
      if rs_has(cr, RS_PRONE) { m = put(l[..], m, "  PRONE"); }
      if rs_effect(cr, EF_MARK) { m = put(l[..], m, "  MARKED"); }
      if rs_effect(cr, EF_EXPOSED) { m = put(l[..], m, "  LIT"); }
      if cr.slowed_until > b[0].clock { m = put(l[..], m, "  SLOWED"); }
      if cr.inspired > 0 { m = put(l[..], m, "  INSPIRED"); }
      if cr.innate_until > b[0].clock { m = put(l[..], m, "  INNATE SORCERY"); }
      if cr.shield_active { m = put(l[..], m, "  SHIELD"); }
      if cr.sacred_until > b[0].clock { m = put(l[..], m, "  SACRED WEAPON"); }
      if cr.raging { m = put(l[..], m, "  RAGING"); }
      if cr.reckless_until > b[0].clock { m = put(l[..], m, "  RECKLESS"); }
      if cr.dodging { m = put(l[..], m, "  DODGING"); }
      if cr.conc >= 0 { m = put(l[..], m, "  CONC: "); m = put(l[..], m, rs_spell(cr.conc).name); }
    }
    // after the name: 54 px in, or past a long name (a siege's "Cultist Fanatic 10")
    off := hi(54 * k, text_width(cast(string) cr.name[0..<cr.name_n], cap * 0.92) + 6 * k);
    room := half - off - 4 * k - pad;
    if text_width(cast(string) l[0..<m], cap * 0.8) > room * 1.25 { m = m0; }
    t := cast(string) l[0..<m];
    cp := lo(cap * 0.8, cap * 0.8 * room / hi(text_width(t, cap * 0.8), 1));
    n = say_at(out, n, t, x + off, y, cp, ink(k, 0.6, DIM));
  }
  x = p.x0 + pad; y = top + f32(SIDE) * crow;
  // the Siege's sides, counted (fivelab-siege.coax)
  if s[0].siege {
    for team: 0..<2 {
      up := 0; all := 0; hp := 0;
      for i: 0..<b[0].n { if b[0].c[i].team == team { all += 1; if rs_up(b[0].c[i]) { up += 1; hp += b[0].c[i].hp; } } }
      y += crow * 1.4;
      m := put(l[..], 0, team_name(s, team)); m = put(l[..], m, "  "); m = put_int(l[..], m, up); m = put(l[..], m, " OF ");
      m = put_int(l[..], m, all); m = put(l[..], m, " STANDING  HP "); m = put_int(l[..], m, hp);
      n = say_at(out, n, cast(string) l[0..<m], x, y, cap * 0.92, ink(k, 0.85, ifx up > 0 then team_col(s, team) else FAINT));
    }
  }
  // the heroes past the first 48, counted
  else if s[0].heroes > 2 * SIDE {
    up := 0; for i: 2 * SIDE..<rs_min(b[0].n, s[0].heroes) { if rs_up(b[0].c[i]) { up += 1; } }
    y += crow * 1.4;
    m := put(l[..], 0, "+"); m = put_int(l[..], m, s[0].heroes - 2 * SIDE); m = put(l[..], m, " MORE HEROES, ");
    m = put_int(l[..], m, up); m = put(l[..], m, " STANDING");
    n = say_at(out, n, cast(string) l[0..<m], x, y, cap * 0.92, ink(k, 0.85, TEAM_COL[0]));
  }
  // the Restless Dead, counted
  if !s[0].siege {
    up := 0; hp := 0;
    for i: s[0].heroes..<b[0].n { if rs_up(b[0].c[i]) { up += 1; hp += b[0].c[i].hp; } }
    y += crow * 1.4;
    n = say_at(out, n, "SKELETONS", x, y, cap * 0.92, ink(k, 0.85, ifx up > 0 then TEAM_COL[2] else FAINT));
    m := put(l[..], 0, ""); m = put_int(l[..], m, up); m = put(l[..], m, " OF "); m = put_int(l[..], m, s[0].skeletons);
    m = put(l[..], m, " STANDING  HP "); m = put_int(l[..], m, hp);
    if s[0].pool > 0 { m = put(l[..], m, "  "); m = put_int(l[..], m, s[0].pool); m = put(l[..], m, " MORE COMING"); }
    m = put(l[..], m, "  AC 14  SHORTSWORD AND SHORTBOW");
    n = say_at(out, n, cast(string) l[0..<m], x + 84 * k, y, cap * 0.85, ink(k, 0.6, DIM));
  }
  y += row * 1.2;
  n = seg(out, n, p.x0 + pad, y, p.x1 - pad, y, 0.6 * k, 0.25, DIM);
  // the log, newest at the bottom
  foot := p.y1 - pad - 18 * k;
  lines := int((foot - y - row * 0.5) / row);
  lines = rs_max(rs_min(lines, s[0].line_n), 0);
  ly := foot - f32(lines - 1) * row;
  for j: 0..<lines {
    q := (s[0].line_head + s[0].line_n - lines + j) % LOG_LINES;
    ln := s[0].lines[q..<q + 1];
    t := cast(string) ln[0].text[0..<ln[0].n];
    cp := lo(cap, cap * (p.x1 - p.x0 - pad * 2) / hi(text_width(t, cap), 1));
    n = say_at(out, n, t, x, ly + f32(j) * row, cp, ink(k, 0.8, ln[0].col));
  }
  // the attribution the SRD's licence asks for
  n = say_at(out, n, "SRD 5.2.1 BY WIZARDS OF THE COAST LLC, CC BY 4.0", x, p.y1 - pad, 7.5 * k, ink(k, 0.4, FAINT));
  return n;
}

// The token under (x, y) on the screen that's a foe of yours, or -1.
token_at :: (s: [] Lab, x: f32, y: f32) -> int {
  b := bt(s);
  best := -1; bd := 40 * hi(s[0].dpr, 1);
  for i: 0..<b[0].n {
    if !rs_up(b[0].c[i]) || (s[0].me >= 0 && b[0].c[i].team == b[0].c[s[0].me].team) { continue; }
    p := proj(s, wx(s, s[0].dx[i]), 0.9, wz(s, s[0].dy[i]));
    if p.z <= 0 { continue; }
    d := abs(p.x - x) + abs(p.y - y);
    if d < bd { bd = d; best = i; }
  }
  return best;
}
// A slot's picture, in strokes, by what the ability does: a blade for blows, a burst in the
// spell's colour for spells, a cross for healing, chevrons for moving, a ring for the rest.
ab_icon :: (out: [] f32, at: int, r: Rect, a: Ab, k: f32, c: Col) -> int {
  n := at; cx := (r.x0 + r.x1) / 2; cy := (r.y0 + r.y1) / 2 - 5 * k; e := (r.x1 - r.x0) * 0.22; w := 2.2 * k;
  heal := a.kind == AB_SECOND || a.kind == AB_LAY || a.kind == AB_WHOLE || a.kind == AB_PRESERVE || (a.kind == AB_SPELL && (a.sp == SP_HEALING_WORD || a.sp == SP_CURE_WOUNDS || a.sp == SP_FALSE_LIFE));
  if heal {
    n = seg(out, n, cx, cy - e, cx, cy + e, w * 1.4, 0.95, GREEN);
    n = seg(out, n, cx - e, cy, cx + e, cy, w * 1.4, 0.95, GREEN);
  } else if a.kind == AB_SPELL {
    sc := spell_rgb(a.sp);
    for q: 0..<8 { an := f32(q) * 0.7853982; n = seg(out, n, cx + cos(an) * e * 0.3, cy + sin(an) * e * 0.3, cx + cos(an) * e, cy + sin(an) * e, w, 0.95, sc); }
  } else if a.kind == AB_ATTACK || a.kind == AB_RECKLESS || a.kind == AB_FLURRY {
    n = seg(out, n, cx - e, cy + e, cx + e, cy - e, w, 0.95, c);
    n = seg(out, n, cx - e * 0.75, cy + e * 0.15, cx - e * 0.15, cy + e * 0.75, w, 0.95, c);
    if a.kind != AB_ATTACK { n = seg(out, n, cx - e, cy - e, cx + e, cy + e, w, 0.95, ifx a.kind == AB_RECKLESS then RED else c); }
  } else if a.kind == FB_DASH || a.kind == FB_CDASH || a.kind == AB_WIND {
    for v: 0..<2 { ox := f32(v) * e * 0.8 - e * 0.5; n = seg(out, n, cx + ox - e * 0.4, cy - e * 0.6, cx + ox + e * 0.2, cy, w, 0.95, c); n = seg(out, n, cx + ox + e * 0.2, cy, cx + ox - e * 0.4, cy + e * 0.6, w, 0.95, c); }
  } else {
    col := ifx a.kind == AB_RAGE then RED else GOLD;
    for q: 0..<12 { a0 := f32(q) * 0.5235988; a1 := f32(q + 1) * 0.5235988; n = seg(out, n, cx + cos(a0) * e * 0.8, cy + sin(a0) * e * 0.8, cx + cos(a1) * e * 0.8, cy + sin(a1) * e * 0.8, w, 0.95, col); }
    n = seg(out, n, cx, cy - e * 0.35, cx, cy + e * 0.35, w, 0.95, col);
  }
  return n;
}
// Player mode's bar: the Spectator/Player switch always; when playing, the class picker, your
// hero's ring and your target's, and the hotbar, each slot filling as your next turn comes round.
draw_player :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at;
  pb := s[0].pbtn;
  n = box_lines(out, n, pb, 0.8 * k, ifx s[0].pressing == 4 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].player then "PLAYER" else "SPECTATOR", (pb.x0 + pb.x1) / 2, (pb.y0 + pb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, ifx s[0].player then GOLD else WHITE));
  sb := s[0].sbtn;
  if !s[0].player {   // playing, the battle doesn't change under you
    n = box_lines(out, n, sb, 0.8 * k, ifx s[0].pressing == 5 then 0.9 else 0.45, DIM);
    n = say_mid(out, n, scenario_name(s), (sb.x0 + sb.x1) / 2, (sb.y0 + sb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, ifx s[0].siege then GOLD else WHITE));
  }
  if !s[0].player { return n; }
  b := bt(s);
  for c: 0..<pick_count(s) {
    r := s[0].picks[c];
    on := c == s[0].pick;
    n = box_lines(out, n, r, 0.8 * k, ifx on then 0.95 else 0.4, ifx on then GOLD else DIM);
    nm := ifx s[0].siege then SIEGE_PICK_NAME[c] else RS_CLASS[ROSTER[c]];
    cp := lo(8 * k, 8 * k * (r.x1 - r.x0 - 6 * k) / hi(text_width(nm, 8 * k), 1));
    n = say_mid(out, n, nm, (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2 + 4 * k, cp, ink(k, ifx on then 1 else 0.7, ifx on then GOLD else WHITE));
  }
  me := s[0].me;
  if s[0].view == VIEW_GLADE {
    if me >= 0 { n = ring3(s, out, n, wx(s, s[0].dx[me]), wz(s, s[0].dy[me]), 0.78, 0.06, 2.5 * k, 1, GOLD); }
    // how far one turn's Speed carries you from your token: your body goes no further (lab_keep)
    if me >= 0 && s[0].you_me == me {
      // your token's square, where the rules have you (reach and range are from it), bright
      tx := wx(s, f32(s[0].my_sx)); tz := wz(s, f32(s[0].my_sy)); hs := f32(SQ) / 2;
      tcx := [5] f32.[tx - hs, tx + hs, tx + hs, tx - hs, tx - hs]; tcz := [5] f32.[tz - hs, tz - hs, tz + hs, tz + hs, tz - hs];
      for e: 0..<4 { n = seg3(s, out, n, P3.{x = tcx[e], y = 0.05, z = tcz[e]}, P3.{x = tcx[e + 1], y = 0.05, z = tcz[e + 1]}, 2 * k, 0.8, GOLD); }
      bx := you_box(s);
      cx := [5] f32.[bx.x0, bx.x1, bx.x1, bx.x0, bx.x0]; cz := [5] f32.[bx.y0, bx.y0, bx.y1, bx.y1, bx.y0];
      for e: 0..<4 {
        for q: 0..<8 {   // in pieces, so an edge passing behind the eye still shows its near part
          t0 := f32(q) / 8; t1 := f32(q + 1) / 8;
          n = seg3(s, out, n, P3.{x = cx[e] + (cx[e + 1] - cx[e]) * t0, y = 0.04, z = cz[e] + (cz[e + 1] - cz[e]) * t0},
                   P3.{x = cx[e] + (cx[e + 1] - cx[e]) * t1, y = 0.04, z = cz[e] + (cz[e + 1] - cz[e]) * t1}, 1.2 * k, 0.35, GOLD);
        }
      }
    }
    if s[0].target >= 0 && rs_up(b[0].c[s[0].target]) { n = ring3(s, out, n, wx(s, s[0].dx[s[0].target]), wz(s, s[0].dy[s[0].target]), 0.7, 0.06, 2.5 * k, 1, RED); }
  }
  // the hotbar: your class's abilities, keys 1 to 9; the picked one gold, a spent one dim, and
  // every slot filling from its foot as your next turn comes round
  ready := 1.0f32;
  if me >= 0 { ready = lo(1, hi(0, (b[0].clock - s[0].acted[me]) / rs_beat(b))); }
  list: [SLOTS] Ab; nab := 0;
  if me >= 0 { nab = hero_abilities(s, me, list[..]); }
  for c: 0..<nab {
    r := s[0].slots[c];
    a := list[c];
    on := c == s[0].act;
    can := ab_ready(s, me, a);
    n = box_lines(out, n, r, ifx on then 1.6 * k else 0.9 * k, ifx on then 1 else ifx can then 0.6 else 0.25, ifx on then GOLD else DIM);
    fill := (r.y1 - r.y0 - 4 * k) * ready;
    for row: 0..<6 { yy := r.y1 - 2 * k - fill * f32(row) / 5; n = seg(out, n, r.x0 + 3 * k, yy, r.x1 - 3 * k, yy, 0.7 * k, ifx on then 0.3 else 0.15, ifx on then GOLD else DIM); }
    n = ab_icon(out, n, r, a, k, ifx !can then FAINT else ifx on then GOLD else WHITE);
    key: [2] u8; key[0] = cast(u8) ('1' + c);
    n = say_at(out, n, cast(string) key[0..<1], r.x1 - 9 * k, r.y0 + 10 * k, 7.5 * k, ink(k, 0.9, WHITE));
    left := ab_left(s, me, a);
    if left >= 0 { lb: [8] u8; lm := put_int(lb[..], 0, left); n = say_at(out, n, cast(string) lb[0..<lm], r.x0 + 4 * k, r.y0 + 10 * k, 7.5 * k, ink(k, 0.9, ifx left > 0 then GOLD else RED)); }
    cp := lo(6.5 * k, 6.5 * k * (r.x1 - r.x0 - 4 * k) / hi(text_width(a.name, 6.5 * k), 1));
    n = say_mid(out, n, a.name, (r.x0 + r.x1) / 2, r.y1 - 5 * k, cp, ink(k, ifx can then 0.9 else 0.4, ifx on then GOLD else WHITE));
  }
  // who you are, above the hotbar
  l: [LINE_CAP] u8;
  m := 0;
  if me >= 0 {
    cr := b[0].c[me];
    m = put(l[..], 0, "YOU: "); m = put(l[..], m, cast(string) cr.name[0..<cr.name_n]); m = put(l[..], m, ", ");
    if cr.npc != RS_NPC_NONE { m = siege_kind(cr, l[..], m); m = put(l[..], m, " of "); m = put(l[..], m, team_name(s, cr.team)); }
    else { m = put(l[..], m, RS_CLASS[cr.klass]); } m = put(l[..], m, "   HP "); m = put_int(l[..], m, cr.hp); m = put(l[..], m, "/"); m = put_int(l[..], m, cr.hp_max);
  } else { m = put(l[..], 0, ifx s[0].siege then "NONE OF THAT KIND STANDS. PICK ANOTHER TO PLAY." else "YOU HAVE FALLEN. PICK A CLASS TO PLAY ANOTHER HERO."); }
  r0 := s[0].slots[0]; r2 := s[0].slots[rs_max(nab - 1, 0)];
  n = say_mid(out, n, cast(string) l[0..<m], ifx nab > 0 then (r0.x0 + r2.x1) / 2 else s[0].cx, r0.y0 - 10 * k, 9 * k, ink(k, 0.9, ifx me >= 0 then WHITE else RED));
  // the keys you play with, under the hotbar
  // (from the left, short of the frames-a-second corner on a desktop)
  keys := ifx s[0].touch then "LEFT THUMB MOVE  RIGHT THUMB LOOK  TAP JUMP  PINCH ZOOM  TAP A SLOT TO ACT"
          else ifx s[0].siege then "W A S D MOVE  SHIFT WALK  DRAG LOOK  SPACE JUMP  WHEEL ZOOM  1 TO 9 ACT  CLICK OR TAB TARGET  [ ] WHO"
          else "W A S D MOVE  SHIFT WALK  DRAG LOOK  SPACE JUMP  WHEEL ZOOM  1 TO 9 ACT  CLICK OR TAB TARGET  [ ] CLASS";
  room := ifx s[0].portrait then s[0].width - 32 * k else s[0].panel.x0 - 300 * k;
  kc := lo(8.5 * k, 8.5 * k * room / hi(text_width(keys, 8.5 * k), 1));
  n = say_at(out, n, keys, 16 * k, ifx nab > 0 then r0.y1 + 14 * k else s[0].cy, kc, ink(k, 0.9, GOLD));
  // the thumb's stick: where it is held, or where to put your thumb (aethyr/sticks.coax's ring)
  if s[0].touch {
    sr := 56 * k;
    ox := ifx s[0].stick_on then s[0].stick_ox else s[0].width * 0.22;
    oy := ifx s[0].stick_on then s[0].stick_oy else s[0].height - hi(sr * 2.4, s[0].height * 0.18);
    n = ring(out, n, ox, oy, sr, 1.2 * k, ifx s[0].stick_on then 0.6 else 0.3, WHITE);
    if s[0].stick_on { n = ring(out, n, ox + s[0].stick_px * sr, oy - s[0].stick_py * sr, 12 * k, 2 * k, 0.8, GOLD); }
  }
  return n;
}
// The figures on the field: every creature not yet dead (the fallen lie a while, then fade).
on_field :: (s: [] Lab) -> int {
  b := bt(s); n := 0;
  for i: 0..<b[0].n { if !b[0].c[i].dead { n += 1; } }
  return n;
}
draw_top :: (s: [] Lab, out: [] f32, at: int, w: f32, k: f32, t: f32) -> int {
  n := at; pad := 16 * k;
  n = say_at(out, n, "5E LAB", pad, 38 * k, 18 * k, ink(k, 0.95, WHITE));
  l: [2 * LINE_CAP] u8;   // the key line runs long
  m := put(l[..], 0, "BATTLE "); m = put_int(l[..], m, s[0].round);
  if s[0].siege {
    // the Siege: each side's standing, of all it fielded
    for team: 0..<2 {
      all := 0; for i: 0..<bt(s)[0].n { if bt(s)[0].c[i].team == team { all += 1; } }
      // a phone's short form: "WATCH 13/50"
      m = put(l[..], m, "   ");
      if s[0].portrait { m = put(l[..], m, ifx team == 0 then "WATCH " else "CULT "); m = put_int(l[..], m, rs_team_up(bt(s), team)); m = put(l[..], m, "/"); m = put_int(l[..], m, all); m = put(l[..], m, " STANDING"); }
      else { m = put(l[..], m, team_name(s, team)); m = put(l[..], m, " "); m = put_int(l[..], m, rs_team_up(bt(s), team)); m = put(l[..], m, " OF "); m = put_int(l[..], m, all); m = put(l[..], m, " STANDING"); }
    }
  } else {
    // the other battles: each side's wins
    m = put(l[..], m, "   WINS: "); m = put(l[..], m, team_name(s, 0)); m = put(l[..], m, " "); m = put_int(l[..], m, s[0].wins[0]);
    if !s[0].horde { m = put(l[..], m, "  "); m = put(l[..], m, team_name(s, 1)); m = put(l[..], m, " "); m = put_int(l[..], m, s[0].wins[1]); }
    m = put(l[..], m, "  DEAD "); m = put_int(l[..], m, s[0].wins[2]);
  }
  sx0 := ifx s[0].portrait then pad else pad + text_width("5E LAB", 18 * k) + 28 * k;
  sy0 := ifx s[0].portrait then 62 * k else 34 * k;
  // fitted to the room before the buttons (a phone's whole width under them)
  room := ifx s[0].portrait then s[0].width - pad - sx0 else lo(s[0].sbtn.x0, s[0].pbtn.x0) - 16 * k - sx0;
  sc := ifx s[0].portrait then 8.5 * k else 10 * k;
  sw := text_width(cast(string) l[0..<m], sc);
  if sw > room && room > 0 { sc = sc * room / sw; }
  n = say_at(out, n, cast(string) l[0..<m], sx0, sy0, sc, ink(k, 0.7, DIM));
  // the keys: in Player mode under the top line (the play keys are under the hotbar); watching,
  // along the scene's foot left of the frame rate, two lines; a phone has no keys to show
  m = put(l[..], 0, "ESC "); m = put(l[..], m, ifx s[0].paused then "RESUME" else "PAUSE");
  if s[0].player { m = put(l[..], m, "   P SPECTATE   V 2D/3D"); n = say_at(out, n, cast(string) l[0..<m], sx0, sy0 + 16 * k, ifx s[0].portrait then 7 * k else 8 * k, ink(k, 0.45, FAINT)); }
  else if !s[0].portrait {
    m = put(l[..], m, "   F "); m = put(l[..], m, ifx s[0].fast then "NORMAL SPEED" else "FAST");
    m = put(l[..], m, "   R NEW BATTLE   H HORDE/ARMIES/SIEGE   P PLAY   V 2D/3D   M MODE");
    hroom := s[0].panel.x0 - 16 * k - 260 * k - pad;   // the figures' count and the FPS on the right
    hc := 8 * k; hw := text_width(cast(string) l[0..<m], hc);
    if hw > hroom && hroom > 0 { hc = hc * hroom / hw; }
    hy := s[0].height - 20 * k;
    if s[0].view == VIEW_GLADE {
      n = say_at(out, n, "DRAG ORBIT   SHIFT+DRAG PAN   WASD FLY   WHEEL ZOOM   C RESET CAMERA", pad, hy, hc, ink(k, 0.85, WHITE));
      hy -= 14 * k;
    }
    n = say_at(out, n, cast(string) l[0..<m], pad, hy, hc, ink(k, 0.85, WHITE));
  }
  // frames a second and the frame's milliseconds, in the scene's bottom-right corner, and over
  // them the figures on the field (not in the golden, which has no clock)
  if !s[0].golden {
    fl: [40] u8;
    fm := put_int(fl[..], 0, int(s[0].fps + 0.5)); fm = put(fl[..], fm, " FPS  ");
    tenths := int(s[0].ms * 10 + 0.5);
    fm = put_int(fl[..], fm, tenths / 10); fm = put(fl[..], fm, "."); fm = put_int(fl[..], fm, tenths % 10); fm = put(fl[..], fm, " MS");
    fc := 15 * k;
    fxr := ifx s[0].portrait then s[0].width - 16 * k else s[0].panel.x0 - 16 * k;
    fyb := ifx s[0].portrait then s[0].panel.y0 - 16 * k else s[0].height - 20 * k;
    // a phone's corner is narrow: the milliseconds go up a line, with the count
    if s[0].portrait { fm = put_int(fl[..], 0, int(s[0].fps + 0.5)); fm = put(fl[..], fm, " FPS"); }
    n = say_at(out, n, cast(string) fl[0..<fm], fxr - text_width(cast(string) fl[0..<fm], fc), fyb, fc, ink(k, 1, ifx s[0].fps >= 50 then GREEN else ifx s[0].fps >= 30 then GOLD else RED));
    fm = 0;
    if s[0].portrait { fm = put_int(fl[..], 0, tenths / 10); fm = put(fl[..], fm, "."); fm = put_int(fl[..], fm, tenths % 10); fm = put(fl[..], fm, " MS  "); }
    fm = put_int(fl[..], fm, on_field(s)); fm = put(fl[..], fm, ifx s[0].portrait then " FIGURES" else " FIGURES ON THE FIELD");
    n = say_at(out, n, cast(string) fl[0..<fm], fxr - text_width(cast(string) fl[0..<fm], 10 * k), fyb - 24 * k, 10 * k, ink(k, 0.85, WHITE));
  }
  if s[0].paused { n = say_mid(out, n, "PAUSED", s[0].cx, s[0].gy + 26 * k, 14 * k, ink(k, 0.9, GOLD)); }
  if s[0].over && s[0].winner >= 0 {
    mid := s[0].cx; cy := s[0].cy;
    m = put(l[..], 0, team_name(s, s[0].winner)); m = put(l[..], m, " WINS");
    n = say_mid(out, n, cast(string) l[0..<m], mid, cy, 26 * k, ink(k, 0.95, team_col(s, s[0].winner)));
  }
  mb := s[0].modal;
  n = box_lines(out, n, mb, 0.8 * k, ifx s[0].pressing == 3 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].mode == MODE_ACTION then "ACTION COMBAT" else "SRD ROUNDS", (mb.x0 + mb.x1) / 2, (mb.y0 + mb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, ifx s[0].mode == MODE_ACTION then GOLD else WHITE));
  fb := s[0].flip;
  n = box_lines(out, n, fb, 0.8 * k, ifx s[0].pressing == 2 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].view == VIEW_GLADE then "2D VIEW" else "3D VIEW", (fb.x0 + fb.x1) / 2, (fb.y0 + fb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, WHITE));
  b := s[0].back;
  n = box_lines(out, n, b, 0.8 * k, ifx s[0].pressing == 1 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, "WORLDS", (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, WHITE));
  return n;
}

#test "Aribeth local view and absent animation label are bounded" {
 s:[1]Lab;lab_dev_cell(s[..],"url=http://127.0.0.1/worlds/everglade-experimental?aribeth=1\n");#assert s[0].put_on && s[0].put_x==0 && s[0].put_z== -1.5 && s[0].creator[0].dist==4.5;
 b:[16]f32;#assert lab_aribeth_label(s[..],b[..],0,1600,1000,1)==0;
 lab_catalog(s[..],"C glade/aribeth0 0 3 248 0 3 0\nA aribeth pause1 0 1 2000\n");#assert s[0].aribeth_state[0].ready && s[0].creator[0].aribeth.count==1;
 lab_catalog(s[..],"C glade/environment 3 6 250 20 3 0\n");#assert !s[0].aribeth_state[0].ready;
}
lab_aribeth_label :: (s:[]Lab,out:[]f32,at:int,w:f32,h:f32,k:f32)->int {
 if s[0].creator[0].aribeth.count==0 {return at;}a:=s[0].creator[0].aribeth[0];pose:=nwna.arb_sample(a,s[0].creator[0].clock);
 if !pose.valid {return at;}p:=xc_proj(s[0].xc[..],1.8,2.15,-2);
 if !p.ok || p.x<60*k || p.x>w-60*k || p.y<45*k || p.y>h-90*k || at+4000>MAX_VERTICES {return at;}
 label:[32]u8;name:=nwna.arb_clip_label(a,pose.clip,label[..]);n:=cc.text(out,at,"ARIBETH",p.x-24*k,p.y-12*k,10*k,ink_col(k,1,0.95,0.8));
 return cc.text(out,n,name,p.x-f32(name.count)*2.7*k,p.y+3*k,9*k,ink_col(k,0.75,0.9,1));
}
// Labels belong to the loaded private comparison pack, not the public scene.
#test "biome labels are absent without the private terrain catalog marker" {
 s:[1]Lab;b:[16]f32;#assert lab_pack_titles(s[..],b[..],0,1600,1000,1)==0;
}
// The housewright showcase (verse/experimental-terrain.coax exp_showcase): each house's label on
// the board of its sign, the tier on one line and the stage under it ("Woven hut" over "2 of 4:
// walls woven"), sized to the board as you see it, for the houses within 16 m.
#test "the showcase labels the houses near you and none far away" {
 s:[1]Lab;s[0].creator[0].experimental=true;b:[16]f32;s[0].creator[0].player_x= -60;s[0].creator[0].player_z= -60;#assert lab_showcase_titles(s[..],b[..],0,1600,1000,1)==0;
 #assert lab_label_split("Woven hut, 2 of 4: walls woven")==9 && lab_label_split("none")==4;
}
// Where a label's tier ends: its first ", ".
lab_label_split :: (t:string)->int {for i:0..<t.count-1 {if t[i]==',' && t[i+1]==' ' {return i;}}return t.count;}
lab_showcase_titles :: (s:[]Lab,out:[]f32,at:int,w:f32,h:f32,k:f32)->int {
  n:=at;x:=s[0].xc[..];px:=s[0].creator[0].player_x;pz:=s[0].creator[0].player_z;
  // ?stage=build-cottage films its own house: the yards' labels would print over it
  if s[0].creator[0].build_review {return n;}
  near:=false;for i:0..<xterrain.EXP_SHOWCASE_SITES {site:=xterrain.exp_site(xterrain.EXP_SHOWCASE_SITE+i);if xterrain.exp_distance(site,px,pz)<16 {near=true;}}
  if !near {return n;}
  // Placed on the shared plates (aethyr/ui/hud-plates.coax): nearest first, and with no lifts a label
  // that would overlap a nearer one is left out, so a row across the walk doesn't print over the row
  // in front (drop). Each stands on its board 0.8 down, where its two lines end. Face 0 is the body face
  // cc.text sets labels in.
  pl:=s[0].signs[..];view:=xc_plate_view(x,w,h);
  cc.hud_plates_begin(pl);pl[0].far=0;pl[0].lifts=0;pl[0].fold=false;pl[0].drop=true;
  size:[cc.HUD_PLATES]f32;id:[cc.HUD_PLATES]int;
  for t:0..<hw.HW_TIERS {for st:1..<hw.hw_stages(t)+1 {f:=xterrain.exp_showcase(t,st);site:=xterrain.exp_site(xterrain.exp_showcase_site(t,st));
    g:=xterrain.exp_sign(t);q:=building.building_point(f,g[0],g[2]+0.04);dx:=q[0]-px;dz:=q[1]-pz;if dx*dx+dz*dz>16*16 {continue;}
    ground:=xterrain.exp_height(site.x,site.z);
    top:=xc_proj(x,q[0],ground+xterrain.EXP_SIGN_Y1,q[1]);bot:=xc_proj(x,q[0],ground+xterrain.EXP_SIGN_Y0,q[1]);
    if !top.ok || !bot.ok || top.x<60*k || top.x>w-60*k || top.y<45*k || bot.y>h-90*k {continue;}
    // the board's height on screen: two lines fill about half of it
    z:=(bot.y-top.y)*0.24;if z<11*k {z=11*k;}if z>26*k {z=26*k;}
    label:=hw.hw_label(t,st);sp:=lab_label_split(label);tier:=label[0..<sp];stage:=ifx sp+2<label.count then label[sp+2..<label.count] else "";
    w0:=cc.face_width(tier,z,0);w1:=cc.face_width(stage,z*0.82,0);
    i:=cc.hud_plates_add(pl,q[0],ground+xterrain.EXP_SIGN_Y1-(xterrain.EXP_SIGN_Y1-xterrain.EXP_SIGN_Y0)*0.8,q[1],tier,-1,false,false,1);
    if i<0 {continue;}
    pl[0].items[i].wide=(ifx w0>w1 then w0 else w1)+6*k;pl[0].items[i].tall=z*2.2+4*k;size[i]=z;id[i]=t*8+st;}}
  cc.hud_plates_place(pl,view);
  for i:0..<pl[0].n {plate:=pl[0].items[i];if !plate.named {continue;}
    if n+12000>MAX_VERTICES {return n;}
    label:=hw.hw_label(id[i]/8,id[i]%8);sp:=lab_label_split(label);tier:=label[0..<sp];stage:=ifx sp+2<label.count then label[sp+2..<label.count] else "";
    z:=size[i];y:=plate.sy-plate.tall+4*k;   // the label's top, as the box's
    n=cc.text(out,n,tier,plate.sx-cc.face_width(tier,z,0)*0.5,y,z,ink_col(k,1,0.95,0.8));
    n=cc.text(out,n,stage,plate.sx-cc.face_width(stage,z*0.82,0)*0.5,y+z*1.25,z*0.82,ink_col(k,1,0.9,0.7));}
  return n;
}
// The loaded private packs' titles over their stations (each pair's, NWN's and Quaternius's side; each
// biome's), on the shared plates (aethyr/ui/hud-plates.coax, everglade/hud/parts.coax eg_plates).
lab_pack_titles :: (s:[]Lab,out:[]f32,at:int,w:f32,h:f32,k:f32)->int {
 bp:=s[0].creator[0].biomes_present;cp:=s[0].creator[0].comparison_present;if (!bp && !cp) || s[0].creator[0].field {return at;}
 pl:=s[0].heads[..];view:=xc_plate_view(s[0].xc[..],w,h);
 cc.hud_plates_begin(pl);pl[0].far=0;
 if cp {
  for i:0..<compare.CMP_N {p:=compare.cmp_site(i);
   cc.hud_plates_ink(pl,cc.hud_plates_add(pl,p.x,0.35+p.span,p.z,p.title,-1,false,false,1),1,0.95,0.8);
   cc.hud_plates_ink(pl,cc.hud_plates_add(pl,p.left_x,0.5,p.z+1.15,"NWN",-1,false,false,1),0.75,0.9,1);
   cc.hud_plates_ink(pl,cc.hud_plates_add(pl,p.right_x,0.5,p.z+1.15,"QUATERNIUS",-1,false,false,1),0.75,1,0.8);
  }
 }
 if bp {
  for i:0..<biomes.BIO_N {p:=biomes.bio_site(i);cc.hud_plates_ink(pl,cc.hud_plates_add(pl,p.x,0.25,p.z+10.5,p.title,-1,false,false,1),1,0.95,0.8);}
 }
 return cc.eg_plates(out,at,pl,view,k,MAX_VERTICES-4000);
}

// ?stage=NAME (#13107): a named setup owns the camera, the sun and the clock, with no HUD, and runs
// on whole game steps so coax/web/clip.coax records the same frames every run. The housewright
// time-lapses (everglade/world/housewright-stage.coax, ?stage=house-*) stand their house in the
// glade as build sites drawn at their progress (#13106; ?stage=house-row stands the five finished).
lab_stage :: (s: [] Lab, facts: string) {
  i := 0;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    line := facts[i..<e]; i = e + 1;
    if line.count < 4 || line[0..<4] != "url=" { continue; }
    st := hws.hws_find(line[4..<line.count]);
    if st >= 0 { s[0].stage = st; s[0].stage_steps = 0; s[0].xc[0].open = false; }
    q := line[4..<line.count]; x := url_number(q, "sx"); z := url_number(q, "sz"); r := url_number(q, "turn");
    if st >= 0 && x >= 0 && z >= 0 { s[0].stage_x = f32(x) - 1000; s[0].stage_z = f32(z) - 1000; }
    if st >= 0 && r >= 0 && r < 4 { s[0].stage_turn = r; }
  }
}
lab_stage_t :: (s: [] Lab) -> f32 { return trk.cam_track_clock(s[0].stage_steps, hws.HWS_HZ); }
// Where the time-lapses stand: the open grass of the glade south of its village, west of the
// dungeon and clear of every building site (verse/experimental-terrain.coax EXP_SITES). Every house
// fronts -z (a half turn), so the sun lights its front and the camera looks north over the village.
LAB_STAGE_X :: -60.0;
LAB_STAGE_Z :: -38.0;
LAB_STAGE_TURN :: 2;
LAB_STAGE_SLOTS :: 5;
lab_stage_site :: (s: [] Lab) -> building.BuildingFrame { return building.BuildingFrame.{x = s[0].stage_x, z = s[0].stage_z, turn = s[0].stage_turn}; }
lab_stage_step :: (s: [] Lab, dt: f32, still: bool) {
  t := lab_stage_t(s);
  s[0].creator[0].clock = t;   // the page clock is the stage's too, so the builders' trips (cc_crew_set) land on the same frames every run
  site := lab_stage_site(s); g := xterrain.exp_height(site.x, site.z);
  // the houses: each a build site at its progress (aethyr/world/build-site.coax, #13106)
  h: [LAB_STAGE_SLOTS] hws.HwsHouse; n := hws.hws_houses(s[0].stage, t, 0, 0, h[..]);
  for i: 0..<LAB_STAGE_SLOTS {
    if i >= n { cc.build_site_clear(s[0].creator[..], i); continue; }
    p := building.building_point(site, h[i].frame.x, h[i].frame.z);
    f := building.BuildingFrame.{x = p[0], z = p[1], turn = site.turn};
    cc.build_site_set(s[0].creator[..], i, h[i].tier, f, xterrain.exp_height(p[0], p[1]), h[i].progress);
  }
  v := hws.hws_view(s[0].stage, t, 0, 0, 0);
  e := building.building_point(site, v.ex, v.ez); l := building.building_point(site, v.lx, v.lz);
  cc.stage_set(s[0].creator[..], trk.CamView.{ex = e[0], ey = v.ey + g, ez = e[1], lx = l[0], ly = v.ly + g, lz = l[1]}, hws.hws_day(s[0].stage, t));
  // whole game steps of the frame's time: a clip's fixed 1/30 s is exactly 2, and its loading steps (a
  // millionth of a second each) none, so the take starts on step 0 however long the page took to load
  if dt > 0 && dt < 1 && !still { q := int(dt * f32(hws.HWS_HZ) + 0.5); s[0].stage_steps += ifx q < 1 && dt > 0.001 then 1 else q; }
}
lab_stage_at :: (u: [] f32, px: f32, py: f32, pz: f32) -> [3] f32 {
  dx := px - u[16]; dy := py - u[17]; dz := pz - u[18];
  z := dx * u[20] + dy * u[21] + dz * u[22];
  if z < 0.2 { return [3] f32.[0, 0, 0]; }
  r := dx * u[24] + dy * u[25] + dz * u[26]; up := dx * u[28] + dy * u[29] + dz * u[30];
  return [3] f32.[u[23] + u[19] * r / z, u[27] - u[19] * up / z, 1];
}
// The corner (the speed and the workday) and, under the house, what it takes.
lab_stage_text :: (s: [] Lab, out: [] f32, at: int, u: [] f32, w: f32, h: f32, k: f32) -> int {
  n := at; st := s[0].stage; t := lab_stage_t(s); tier := hws.hws_tier(st);
  if st == hws.HWS_ROW {
    // the row: under each finished house, the tool that unlocks it
    site := lab_stage_site(s); rh: [LAB_STAGE_SLOTS] hws.HwsHouse; m := hws.hws_houses(st, t, 0, 0, rh[..]);
    for i: 0..<m {
      p := building.building_point(site, rh[i].frame.x, rh[i].frame.z + hw.HW_REACH[rh[i].tier][1] + 0.6);
      q := lab_stage_at(u, p[0], xterrain.exp_height(p[0], p[1]), p[1]);
      if q[2] < 1 { continue; }
      tool := hws.HWS_TOOL[rh[i].tier]; c3 := 15 * k;
      n = cc.text(out, n, tool, q[0] - cc.face_width(tool, c3, 0) * 0.5, q[1] + 18 * k, c3, ink_col(k, 1, 0.95, 0.8));
    }
    return n;
  }
  if tier < 0 { return n; }
  b: [64] u8; col := ink_col(k, 1, 0.95, 0.8); cap := 15 * k;
  m := hws.hws_speed_text(st, b[..]); line := cast(string) b[0..<m];
  n = cc.text(out, n, line, w - 28 * k - cc.face_width(line, cap, 0), 40 * k, cap, col);
  m = hws.hws_workday_text(st, t, b[..]); line = cast(string) b[0..<m];
  n = cc.text(out, n, line, w - 28 * k - cc.face_width(line, cap, 0), 64 * k, cap, col);
  bill := hws.HWS_BILL[tier]; work := hws.HWS_WORK[tier]; c2 := 13 * k;
  y := h - 70 * k;
  n = cc.text(out, n, bill, (w - cc.face_width(bill, c2, 0)) * 0.5, y, c2, col);
  n = cc.text(out, n, work, (w - cc.face_width(work, c2, 0)) * 0.5, y + 24 * k, c2, ink_col(k, 0.85, 0.9, 0.8));
  return n;
}
#test "a ?stage=house-* page stages its house: the clock is whole steps and the camera and day are the stage's" {
  s: [1] Lab; lab_stage(s[..], "tab=1\nurl=http://127.0.0.1:8800/worlds/everglade-experimental?stage=house-cottage\n");
  #assert s[0].stage == 2 && s[0].stage_steps == 0 && !s[0].xc[0].open;
  for i: 0..<600 { lab_stage_step(s[..], 0.000001, false); }   // a clip's loading steps
  #assert s[0].stage_steps == 0;
  for i: 0..<45 { lab_stage_step(s[..], 1.0 / 30.0, false); }
  #assert s[0].stage_steps == 90 && lab_stage_t(s[..]) == 1.5 && s[0].creator[0].stage_on;
  lab_stage_step(s[..], 0, true); #assert s[0].stage_steps == 90;
  a := s[0].creator[0].stage_view; d := s[0].creator[0].stage_day;
  // another frame rate, the same clock: the same shot and day
  lab_stage(s[..], "url=http://x/worlds/everglade-experimental?stage=house-cottage");
  #assert s[0].stage_steps == 0;
  for i: 0..<90 { lab_stage_step(s[..], 0.02, false); }
  lab_stage_step(s[..], 0, true);
  b := s[0].creator[0].stage_view;
  #assert a.ex == b.ex && a.ey == b.ey && a.lz == b.lz && d == s[0].creator[0].stage_day && abs(d - 0.3675) < 0.0001;
  s[0].stage = -1; lab_stage(s[..], "url=http://x/worlds/everglade-experimental?stage=nothing"); #assert s[0].stage == -1;
}

// The light (lighting plan Phase 1, #13066): the glade's passes (gpu/charactercreator.coax,
// gpu/fivelab.coax through the cg_* names) read the camera's resolved environment at U_ENV, written
// after the frame has placed the eye (u[16..18]). Experimental and 5E Lab author no environment, so
// it is the painterly default at the page's fixed noon (data-clock fixed:0.5): no region and no
// clock moves it, so the record is resolved once and the same words go up every frame.
lab_frame :: (s: [] Lab, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  n := lab_frame_draw(s, out, u, width, height, dpr, dt, still);
  fd_frame(s);   // the agent driver's entities and bar this frame (off: nothing)
  if u.count >= UNIFORM_FLOATS { lab_light(s, u); }
  return n;
}
lab_light :: (s: [] Lab, u: [] f32) {
  if (s[0].stage >= 0 || s[0].creator[0].build_review) && s[0].creator[0].stage_on {
    w := envf.env_frame_glade_day_words(s[0].creator[0].stage_day); for i: 0..<U_ENV_WORDS { u[U_ENV + i] = w[i]; }
    envf.env_frame_day_halo(s[0].creator[0].stage_day, u, 32); return;
  }
  if s[0].env_n == 0 { g := envf.env_frame_glade_words(); for i: 0..<U_ENV_WORDS { s[0].env[i] = g[i]; } s[0].env_n = U_ENV_WORDS; }
  for i: 0..<U_ENV_WORDS { u[U_ENV + i] = s[0].env[i]; }
}
#test "every frame writes the camera's environment: the glade's noon, as the resolver gives it" {
  s: [1] Lab; u: [UNIFORM_FLOATS] f32; u[16] = 1; u[17] = 2; u[18] = -30;
  lab_light(s[..], u[..]); lab_light(s[..], u[..]);
  // what a frame resolving the default set at the eye writes
  f: [1] envf.EnvFrame; w: [UNIFORM_FLOATS] f32;
  #assert envf.env_frame_write_eye(f[..], 0, u[16], u[17], u[18], w[..], U_ENV) && f[0].refusals == 0;
  for i: 0..<U_ENV_WORDS { #assert u[U_ENV + i] == w[U_ENV + i]; }
  for i: U_FRAME_FLOATS..<U_ENV { #assert u[i] == 0; }
  #assert s[0].env_n == U_ENV_WORDS && U_ENV_WORDS == envf.ENV_FRAME_FLOATS;
}
// Everglade Experimental's strokes blend straight alpha (its HUD is the FANTASY style, cc.hud_seal).
lab_straight_alpha :: (s: [] Lab) -> bool #export_c #effects(all) { return s[0].creator[0].experimental; }
lab_frame_draw :: (s: [] Lab, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int {
  if s[0].creator[0].on {
    s[0].creator[0].hostile_external=s[0].creator[0].experimental && !s[0].creator[0].walk.on;
    if s[0].creator[0].experimental && !s[0].creator[0].walk.on {
      hostile.hostile_start(s[0].creator[0].hostiles[..]);
      xc_start(s[0].xc[..],s[0].xc[0].klass); xc_sync_vitals(s); xc_sync_permissions(s);
    }
    if s[0].stage >= 0 {
      lab_stage_step(s, dt, still);
      n := cc.frame(s[0].creator[..],out,u,width,height,hi(dpr,0.5),dt,still);
      n = lab_stage_text(s,out,n,u,width,height,hi(dpr,0.5));
      cc.hud_seal(out,0,n);
      return n;
    }
    if s[0].creator[0].build_review {
      // ?stage=build-cottage films its cottage: the world alone, no HUD or bar
      n := cc.frame(s[0].creator[..],out,u,width,height,hi(dpr,0.5),dt,still);
      cc.hud_seal(out,0,n);
      return n;
    }
    lab_mouselook_step(s, ifx still then 0.0f32 else dt);
    n := cc.frame(s[0].creator[..],out,u,width,height,hi(dpr,0.5),dt,still);
    if s[0].creator[0].experimental && !s[0].creator[0].walk.on {
      if !still && dt>0 && dt<1 { xc_hostile_tick(s,ifx dt>0.25 then 0.25 else dt); }
      n = xc_frame(s,out,n,u,width,height,hi(dpr,0.5),ifx still then 0.0f32 else dt);
      n = lab_ride_hud(s,out,n,width,height,hi(dpr,0.5));
      n = lab_pack_titles(s,out,n,width,height,hi(dpr,0.5));
      n = lab_aribeth_label(s,out,n,width,height,hi(dpr,0.5));
      n = lab_showcase_titles(s,out,n,width,height,hi(dpr,0.5));
      if s[0].ride_dev >= LAB_STAGE_DRAGONBACK { n = 0; s[0].xc[0].media_n = 0; if u.count > 11 { u[11] = 1; } }   // a riding stage is a shot: the world alone, no HUD or bar
    }
    if s[0].creator[0].experimental { cc.hud_seal(out,0,n); }
    cr := s[0].creator[..];exsound.experimental_sound_tick(s[0].experimental_audio[..],cr[0].experimental && !cr[0].walk.on,cr[0].player_x,cr[0].player_z,cr[0].airborne,cr[0].hostiles[0].hp,cr[0].hostiles[0].hits,ifx still then 0.0f32 else dt);
    // the build sites' landings (charactercreator-crew.coax): a part lands with its material's sound
    if cr[0].experimental && !still {bc:[5]int;cc.cc_crew_sounds(cr,bc[..]);exsound.experimental_sound_build(s[0].experimental_audio[..],bc[..],0.45,0);}
    return n;
  }
  lab_start(s);
  if u.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  s[0].width = width; s[0].height = height; s[0].dpr = dpr;
  k := hi(dpr, 0.5);
  if s[0].golden && !s[0].golden_ran {
    // the golden: the same battle, 20 seconds in, every time
    s[0].golden_ran = true;
    for i: 0..<1200 { step(s, f32(STEP)); }
  }
  step_dt := ifx s[0].golden || still || s[0].paused then 0.0f32 else dt;
  lab_run(s, step_dt);
  if !s[0].golden { fly(s, dt); }
  if s[0].film != FILM_NONE { film_step(s, dt, still); }
  put_bodies(s);
  // Player mode's follow camera, and the swing to it from the spectator's camera and back
  if s[0].player && s[0].you_me >= 0 && s[0].me == s[0].you_me { lab_chase_step(s, lo(dt, 0.1)); }
  want := ifx s[0].player && s[0].you_me >= 0 && s[0].view == VIEW_GLADE then 1.0f32 else 0.0f32;
  if s[0].golden { s[0].blend = want; }
  else if s[0].blend < want { s[0].blend = lo(want, s[0].blend + lo(dt, 0.1) / f32(BLEND_TIME)); }
  else if s[0].blend > want { s[0].blend = hi(want, s[0].blend - lo(dt, 0.1) / f32(BLEND_TIME)); }
  if dt > 0 {
    s[0].fps_n += 1; s[0].fps_t += dt;
    if s[0].fps_t >= 0.5 { s[0].fps = f32(s[0].fps_n) / s[0].fps_t; s[0].ms = s[0].fps_t * 1000 / f32(s[0].fps_n); s[0].fps_n = 0; s[0].fps_t = 0; }
  }
  t := s[0].clock;
  layout(s, width, height, k);
  n := 0; s[0].unlabelled = 0;
  if s[0].film != FILM_NONE { glade_puffs(s); }   // a film draws the field alone
  else if s[0].view == VIEW_GLADE {
    n = lab_heads3(s, out, n, k, t);
    glade_puffs(s);
    n = draw_nums3(s, out, n, k);
  } else {
    n = board_areas(s, out, n, k, t);
    n = draw_casts(s, out, n, k);
    n = draw_nums(s, out, n, k);
    n = draw_tokens(s, out, n, k, t);
  }
  if s[0].film == FILM_NONE {
    n = draw_panel(s, out, n, k);
    n = draw_top(s, out, n, width, k, t);
    n = draw_player(s, out, n, k);
    n = draw_sliders(s, out, n, k);
  }
  for i: 0..<u.count { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = t; u[3] = 1;
  u[U_GRID] = s[0].gx; u[U_GRID + 1] = s[0].gy; u[U_GRID + 2] = s[0].cell;
  u[U_CELLS] = f32(s[0].cols); u[U_CELLS + 1] = f32(s[0].rows);
  p := s[0].panel;
  u[U_PANEL] = p.x0; u[U_PANEL + 1] = p.y0; u[U_PANEL + 2] = p.x1; u[U_PANEL + 3] = p.y1;
  u[U_CELLS + 2] = f32(s[0].view);
  u[U_CELLS + 3] = (ifx s[0].portrait then 92 else 64) * k;
  u[U_EYE] = s[0].eye.x; u[U_EYE + 1] = s[0].eye.y; u[U_EYE + 2] = s[0].eye.z; u[U_EYE + 3] = s[0].focal;
  u[U_FWD] = s[0].fwd.x; u[U_FWD + 1] = s[0].fwd.y; u[U_FWD + 2] = s[0].fwd.z; u[U_FWD + 3] = s[0].cx;
  u[U_RIGHT] = s[0].right.x; u[U_RIGHT + 1] = s[0].right.y; u[U_RIGHT + 2] = s[0].right.z; u[U_RIGHT + 3] = s[0].cy;
  u[U_UP] = s[0].up.x; u[U_UP + 1] = s[0].up.y; u[U_UP + 2] = s[0].up.z;
  u[U_SUN] = 0.45; u[U_SUN + 1] = 0.62; u[U_SUN + 2] = 0.38;
  if s[0].film != FILM_NONE { u[U_SUN] = FILM_SUN[0]; u[U_SUN + 1] = FILM_SUN[1]; u[U_SUN + 2] = FILM_SUN[2]; u[U_SUN + 3] = 1; u[U_CELLS + 3] = 0; }
  b := bt(s);
  // the tokens (the frame store), for the ground's rings and contact shadows and the flat view's
  // tokens: where each stands, its side and state, and the square it is nearest
  fr := s[0].frame[..];
  for i: 0..<(b[0].n * 4) { fr[i] = 0; }
  for q: 0..<(s[0].cols * s[0].rows) { fr[F_SQUARES + q] = 0; }
  for i: 0..<b[0].n {
    o := i * 4;
    if b[0].c[i].dead { if s[0].view == VIEW_FLAT { fr[o] = s[0].dx[i]; fr[o + 1] = s[0].dy[i]; fr[o + 2] = f32(1 + b[0].c[i].team + 8); } else { continue; } }
    else {
      // the glade's in metres; the flat view's in squares
      fr[o] = ifx s[0].view == VIEW_FLAT then s[0].dx[i] else wx(s, s[0].dx[i]);
      fr[o + 1] = ifx s[0].view == VIEW_FLAT then s[0].dy[i] else wz(s, s[0].dy[i]);
      down := 0; if b[0].c[i].hp == 0 { down = 1; }
      fr[o + 2] = f32(1 + b[0].c[i].team + 4 * down);
      since := b[0].clock - s[0].acted[i];
      fr[o + 3] = ifx since >= 0 && since < 1.2 then 1 - since / 1.2 else 0;
    }
    gx := cast(int) floor(s[0].dx[i] + 0.5); gy := cast(int) floor(s[0].dy[i] + 0.5);
    if gx < 0 || gx >= s[0].cols || gy < 0 || gy >= s[0].rows { continue; }
    sq := F_SQUARES + gy * s[0].cols + gx;
    if fr[sq] == 0 { fr[sq] = f32(i + 1); }
  }
  for z: 0..<RS_ZONES {
    o := U_ZONES + z * 8;
    zo := b[0].zone[z];
    if !zo.on { continue; }
    u[o] = wx(s, f32(zo.x0)) - f32(SQ) / 2; u[o + 1] = wz(s, f32(zo.y0)) - f32(SQ) / 2;
    u[o + 2] = wx(s, f32(zo.x1)) + f32(SQ) / 2; u[o + 3] = wz(s, f32(zo.y1)) + f32(SQ) / 2;
    u[o + 4] = ifx zo.spell == SP_ENTANGLE then 1 else 2;
  }
  u[U_BOUNDS] = f32(s[0].cols) * f32(SQ) / 2; u[U_BOUNDS + 1] = f32(s[0].rows) * f32(SQ) / 2; u[U_BOUNDS + 2] = f32(SQ); u[U_BOUNDS + 3] = grid_scale(s);
  return n;
}

// ---- the army-size sliders: heroes, the dead on the field at once and (in the Horde) the dead
// that stream in after them. Each runs on a log scale, so a few and a thousand both have room; a
// drag shows the number and lets go into a new battle at it. Z and X, Q and E, K and L nudge them.
SL_HEROES :: 0; SL_SKELETONS :: 1; SL_STREAM :: 2;
SL_NAME :: [3] string.["HEROES", "SKELETONS", "STREAM"];
SL_SIEGE_NAME :: [2] string.["DEFENDERS", "CULTISTS"];   // the cult's leader comes on top of its number
sl_name :: (s: [] Lab, k: int) -> string { return ifx s[0].siege && k < 2 then SL_SIEGE_NAME[k] else SL_NAME[k]; }
sl_least :: (s: [] Lab, k: int) -> int { return ifx k == SL_HEROES then 1 else 0; }
sl_most :: (s: [] Lab, k: int) -> int {
  if s[0].siege && k == SL_SKELETONS { return SIEGE_CULT_MAX; }
  return ifx k == SL_HEROES then HEROES_MAX else ifx k == SL_SKELETONS then SKELETONS_MAX else HORDE_MAX;
}
sl_value :: (s: [] Lab, k: int) -> int {
  if s[0].siege { return ifx k == SL_HEROES then s[0].town else s[0].cult; }
  return ifx k == SL_HEROES then s[0].heroes else ifx k == SL_SKELETONS then s[0].skeletons else s[0].stream;
}
// The slider's position 0..1 for a value, and the value at a position (log scale over 1 + v).
sl_pos :: (s: [] Lab, k: int, v: int) -> f32 { return clamp01(log(f32(v + 1)) / log(f32(sl_most(s, k) + 1))); }
sl_at :: (s: [] Lab, k: int, t: f32) -> int {
  v := cast(int) floor(pow(f32(sl_most(s, k) + 1), clamp01(t)) - 1 + 0.5);
  return rs_max(sl_least(s, k), rs_min(sl_most(s, k), v));
}
// The sliders' count: the stream only in the Horde.
sl_count :: (s: [] Lab) -> int { return ifx s[0].horde && !s[0].siege then 3 else 2; }
// The Siege's sizes: the battle starts again at them; false when nothing changed. Past a slider's
// most, said in red (no cap is silent), and the most fielded.
set_siege :: (s: [] Lab, town: int, cult: int) -> bool {
  s[0].asked[SL_HEROES] = ifx town > HEROES_MAX then town else 0;
  s[0].asked[SL_SKELETONS] = ifx cult > SIEGE_CULT_MAX then cult else 0;
  tw := rs_max(1, rs_min(HEROES_MAX, town)); cu := rs_max(0, rs_min(SIEGE_CULT_MAX, cult));
  if tw == s[0].town && cu == s[0].cult { return false; }
  s[0].town = tw; s[0].cult = cu;
  s[0].wins[0] = 0; s[0].wins[1] = 0; s[0].wins[2] = 0;
  new_battle(s);
  return true;
}
// New sizes: the battle starts again at them (and says so); false when nothing changed.
set_sizes :: (s: [] Lab, heroes: int, skeletons: int, stream: int) -> bool {
  // past a slider's most: say so (no cap is silent), and field the most
  s[0].asked[SL_HEROES] = ifx heroes > HEROES_MAX then heroes else 0;
  s[0].asked[SL_SKELETONS] = ifx skeletons > SKELETONS_MAX then skeletons else 0;
  s[0].asked[SL_STREAM] = ifx stream > HORDE_MAX then stream else 0;
  h := rs_max(1, rs_min(HEROES_MAX, heroes)); sk := rs_max(0, rs_min(SKELETONS_MAX, skeletons)); st := rs_max(0, rs_min(HORDE_MAX, stream));
  if h == s[0].heroes && sk == s[0].skeletons && st == s[0].stream { return false; }
  s[0].heroes = h; s[0].skeletons = sk; s[0].stream = st;
  s[0].wins[0] = 0; s[0].wins[1] = 0; s[0].wins[2] = 0;
  new_battle(s);
  return true;
}
set_slider :: (s: [] Lab, k: int, v: int) -> bool {
  if s[0].siege {
    tw := rs_max(s[0].town, s[0].asked[SL_HEROES]); cu := rs_max(s[0].cult, s[0].asked[SL_SKELETONS]);
    if k == SL_HEROES { tw = v; } else { cu = v; }
    return set_siege(s, tw, cu);
  }
  // the others keep what they asked
  h := rs_max(s[0].heroes, s[0].asked[SL_HEROES]); sk := rs_max(s[0].skeletons, s[0].asked[SL_SKELETONS]); st := rs_max(s[0].stream, s[0].asked[SL_STREAM]);
  if k == SL_HEROES { h = v; } else if k == SL_SKELETONS { sk = v; } else { st = v; }
  return set_sizes(s, h, sk, st);
}
// A key's nudge: a quarter up or a fifth down, at least one.
nudge :: (s: [] Lab, k: int, up: bool) -> bool {
  v := sl_value(s, k);
  w := ifx up then rs_max(v + 1, (v * 5 + 3) / 4) else rs_min(v - 1, (v * 4) / 5);
  return set_slider(s, k, rs_max(sl_least(s, k), w));   // past the most: set_sizes says so
}
// The sliders' tracks, in the scene's top-left corner (under the class picker in Player mode).
layout_sliders :: (s: [] Lab, k: f32, x0: f32, x1: f32, y0: f32) {
  tw := lo(220 * k, x1 - x0 - 150 * k);
  for r: 0..<3 {
    s[0].sliders[r] = Rect.{};
    if r >= sl_count(s) || tw < 40 * k { continue; }
    y := y0 + 12 * k + f32(r) * 24 * k;
    s[0].sliders[r] = Rect.{x0 = x0 + 84 * k, y0 = y - 10 * k, x1 = x0 + 84 * k + tw, y1 = y + 10 * k};
  }
}
// The slider under (x, y), or -1: its track, a little wider for a finger.
slider_at :: (s: [] Lab, x: f32, y: f32) -> int {
  k := hi(s[0].dpr, 0.5);
  for r: 0..<sl_count(s) {
    t := s[0].sliders[r];
    if t.x1 <= t.x0 { continue; }
    if x >= t.x0 - 10 * k && x <= t.x1 + 10 * k && y >= t.y0 - 3 * k && y <= t.y1 + 3 * k { return r; }
  }
  return -1;
}
slider_value_at :: (s: [] Lab, r: int, x: f32) -> int {
  t := s[0].sliders[r];
  return sl_at(s, r, (x - t.x0) / hi(t.x1 - t.x0, 1));
}
draw_sliders :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at;
  for r: 0..<sl_count(s) {
    t := s[0].sliders[r];
    if t.x1 <= t.x0 { continue; }
    on := s[0].sliding == r;
    v := ifx on then s[0].want[r] else sl_value(s, r);
    y := (t.y0 + t.y1) / 2;
    n = say_right(out, n, sl_name(s, r), t.x0 - 10 * k, y + 4 * k, 8.5 * k, ink(k, 0.85, ifx on then GOLD else WHITE));
    n = seg(out, n, t.x0, y, t.x1, y, 1.6 * k, 0.3, DIM);
    px := t.x0 + (t.x1 - t.x0) * sl_pos(s, r, v);
    n = seg(out, n, t.x0, y, px, y, 1.8 * k, 0.9, ifx r == SL_HEROES then TEAM_COL[0] else ifx s[0].siege then team_col(s, 1) else TEAM_COL[2]);
    n = ring(out, n, px, y, 6 * k, 1.8 * k, ifx on then 1 else 0.8, ifx on then GOLD else WHITE);
    l: [16] u8; m := put_int(l[..], 0, v);
    // the number, then the most it can field ("50 / 1024"), kept inside the screen
    e: [24] u8; em := put(e[..], 0, "/ "); em = put_int(e[..], em, sl_most(s, r));
    vw := text_width(cast(string) l[0..<m], 10 * k); mw := text_width(cast(string) e[0..<em], 7.5 * k);
    vx := lo(t.x1 + 12 * k, s[0].width - 8 * k - mw - 8 * k - vw);
    n = say_at(out, n, cast(string) l[0..<m], vx, y + 4.5 * k, 10 * k, ink(k, 0.95, ifx on then GOLD else WHITE));
    n = say_at(out, n, cast(string) e[0..<em], vx + vw + 8 * k, y + 4.5 * k, 7.5 * k, ink(k, 0.8, WHITE));
    if s[0].asked[r] > 0 {
      a: [64] u8; am := put_int(a[..], 0, s[0].asked[r]); am = put(a[..], am, " ASKED, ");
      am = put_int(a[..], am, sl_most(s, r)); am = put(a[..], am, " IS THE MOST");
      n = say_at(out, n, cast(string) a[0..<am], t.x1 + 62 * k, y + 4 * k, 7.5 * k, ink(k, 1, RED));
    }
  }
  t0 := s[0].sliders[0];
  if t0.x1 > t0.x0 {
    hint := ifx sl_count(s) == 3 then "DRAG, OR Z X  Q E  K L" else "DRAG, OR Z X  Q E";
    hy := t0.y0 + f32(sl_count(s)) * 24 * k + 6 * k;
    n = say_at(out, n, hint, t0.x0, hy, 7 * k, ink(k, 0.45, FAINT));
    // the labels' own limits, said: past them the far ones go unlabelled
    if bt(s)[0].n > LABELS_ALL && s[0].view == VIEW_GLADE { n = say_at(out, n, "PAST 400 FIGURES: BARS ONLY WITHIN 24 M", t0.x0, hy + 11 * k, 7 * k, ink(k, 0.8, GOLD)); hy += 11 * k; }
    if s[0].view == VIEW_FLAT && s[0].cell < f32(TOKEN_MARKS_PX) * k { n = say_at(out, n, "SQUARES UNDER 12 PX: TOKENS WITHOUT NAMES OR BARS", t0.x0, hy + 11 * k, 7 * k, ink(k, 0.8, GOLD)); hy += 11 * k; }
    if s[0].unlabelled > 0 {
      a: [64] u8; am := put_int(a[..], 0, s[0].unlabelled); am = put(a[..], am, " LABELS LEFT OFF: TOO MANY TO DRAW AT ONCE");
      n = say_at(out, n, cast(string) a[0..<am], t0.x0, hy + 11 * k, 7 * k, ink(k, 0.95, RED));
    }
  }
  return n;
}
// The page's address asks for sizes: ?heroes=N&skeletons=M&stream=K (dead= too), so a test reruns.
// Bounded numeric fields only, read from the page facts' url line (coax/web/host.js pageFacts).
// Whether the query holds `pair` (a key=value) whole.
url_has :: (q: string, pair: string) -> bool {
  i := 0;
  while i + pair.count <= q.count {
    if (i == 0 || q[i - 1] == '&' || q[i - 1] == '?') && q[i..<i + pair.count] == pair && (i + pair.count == q.count || q[i + pair.count] == '&') { return true; }
    i += 1;
  }
  return false;
}
url_number :: (q: string, key: string) -> int {
  i := 0;
  while i + key.count < q.count {
    at_start := i == 0 || q[i - 1] == '?' || q[i - 1] == '&';
    if at_start && q[i + key.count] == '=' && q[i..<i + key.count] == key {
      j := i + key.count + 1; v := 0; any := false;
      while j < q.count && q[j] >= '0' && q[j] <= '9' && v < 1000000 { v = v * 10 + cast(int) (q[j] - '0'); j += 1; any = true; }
      return ifx any then v else -1;
    }
    i += 1;
  }
  return -1;
}
// On a local page, ?cell=N (a dungeon cell, row*11+col) starts you in the middle of that cell,
// turned ?yaw=DEGREES, for looking at the dungeon headless.
lab_dev_cell :: (s: [] Lab, facts: string) {
 i:=0;while i<facts.count {e:=i;while e<facts.count && facts[e]!='\n' {e+=1;}line:=facts[i..<e];i=e+1;
  if line.count<4 || line[0..<4]!="url=" {continue;}q:=line[4..<line.count];
  if url_number(q,"aribeth")==1 {s[0].put_on=true;s[0].put_x=0;s[0].put_y=0;s[0].put_z= -1.5;s[0].put_face=0;s[0].creator[0].yaw=0;s[0].creator[0].pitch=0.25;s[0].creator[0].dist=4.5;s[0].xc[0].open=false;}
  bio:=url_number(q,"biome");if bio>=0 && bio<=biomes.BIO_N {
   p:=biomes.bio_site(ifx bio==0 then 1 else bio-1);s[0].put_on=true;s[0].put_x=ifx bio==0 then 35 else p.x;s[0].put_y=0.025;s[0].put_z=ifx bio==0 then 73 else p.z+3;s[0].put_face=0;s[0].creator[0].yaw=0;s[0].creator[0].pitch=ifx bio==0 then 1.15 else ifx bio==1 then 0.85 else 0.65;s[0].creator[0].dist=ifx bio==0 then 75 else ifx bio==1 then 24 else 15;s[0].xc[0].open=false;
  }
  cmp:=url_number(q,"compare");if cmp>=0 && cmp<=compare.CMP_N {
   p:=compare.cmp_site(ifx cmp==0 then 2 else cmp-1);s[0].put_on=true;s[0].put_x=ifx cmp==0 then 31 else p.x;s[0].put_y=0.2;s[0].put_z=ifx cmp==0 then 12 else p.z+1;s[0].put_face=0;s[0].creator[0].yaw=0;s[0].creator[0].pitch=ifx cmp==0 then 1.2 else 0.4;s[0].creator[0].dist=ifx cmp==0 then 28 else 5;s[0].xc[0].open=false;
  }
  cl:=url_number(q,"class");if cl>=0 && cl<FB_CL_N {xc_set_class(s[0].xc[..],cl);}
  rd:=url_number(q,"ride");if rd>0 && rd<=3 {s[0].ride_dev=rd;}
  if url_has(q,"stage=dragonback") {s[0].ride_dev=LAB_STAGE_DRAGONBACK;s[0].xc[0].open=false;} if url_has(q,"stage=horseback") {s[0].ride_dev=LAB_STAGE_HORSEBACK;s[0].xc[0].open=false;} if url_has(q,"stage=horse-archer") {s[0].ride_dev=LAB_STAGE_HORSE_ARCHER;s[0].xc[0].open=false;} if url_has(q,"stage=dragon-fire") {s[0].ride_dev=LAB_STAGE_DRAGONFIRE;s[0].xc[0].open=false;} if url_has(q,"view=side") {s[0].ride_view=1;} if url_has(q,"view=rear") {s[0].ride_view=2;}
  // px, pz: any spot, metres plus 1000 (px=970&pz=1010 is (-30, 10)); yaw the way you face in degrees
  // (0 is +z), the camera behind you; dist the camera's metres; pitch its tilt down in degrees; class a
  // class's row (fivebar.coax FB_CL_*)
  px:=url_number(q,"px");pz:=url_number(q,"pz");if px>=0 && pz>=0 {
   yaw:=url_number(q,"yaw");a:=ifx yaw>=0 then f32(yaw)*0.0174533 else 0.0f32;dist:=url_number(q,"dist");
   s[0].put_on=true;s[0].put_x=f32(px)-1000;s[0].put_y=0;s[0].put_z=f32(pz)-1000;s[0].put_face=a;s[0].creator[0].yaw=a+3.1415927;if dist>0 {s[0].creator[0].dist=f32(dist);}pt:=url_number(q,"pitch");if pt>=0 {s[0].creator[0].pitch=f32(pt)*0.0174533;}s[0].xc[0].open=false;continue;
  }
  n:=url_number(q,"cell");if n<0 || n>=xdungeon.DG_COLS*xdungeon.DG_ROWS {continue;}
  yaw:=url_number(q,"yaw");a:=ifx yaw>=0 then f32(yaw)*0.0174533 else 0.0f32;
  s[0].put_on=true;s[0].put_x=xdungeon.dg_x(n%xdungeon.DG_COLS)+f32(xdungeon.DG_CELL)*0.5;s[0].put_y=0;s[0].put_z=xdungeon.dg_z(n/xdungeon.DG_COLS)-f32(xdungeon.DG_CELL)*0.5;s[0].put_face=a;s[0].creator[0].yaw=a;
 }
}
#test "local biome views frame the three native terrain sections" {
 {s:[1]Lab;lab_dev_cell(s[..],"url=http://127.0.0.1/worlds/everglade-experimental?biome=0\n");#assert s[0].put_on && s[0].put_x==35 && s[0].put_z==73 && s[0].creator[0].dist==75;}
 {t:[1]Lab;lab_dev_cell(t[..],"url=http://localhost/worlds/everglade-experimental?biome=1\n");p:=biomes.bio_site(0);#assert t[0].put_x==p.x && t[0].put_z==p.z+3 && t[0].creator[0].dist==24 && !t[0].xc[0].open;}
}
#test "a local comparison view can frame all ten pairs or one station" {
 {s:[1]Lab;lab_dev_cell(s[..],"url=http://127.0.0.1/worlds/everglade-experimental?compare=0\n");
 #assert s[0].put_on && s[0].put_z==12 && s[0].creator[0].dist==28 && s[0].put_x==31 && !s[0].xc[0].open;}
 {t:[1]Lab;lab_dev_cell(t[..],"url=http://localhost/worlds/everglade-experimental?compare=10\n");p:=compare.cmp_site(9);
 #assert t[0].put_on && t[0].put_x==p.x && t[0].put_z==p.z+1 && t[0].creator[0].dist==5;
 b:[16]f32;#assert lab_pack_titles(t[..],b[..],0,1600,1000,1)==0;}
}
#test "a local page can start you in a dungeon cell" {
 // one Lab at a time: each block's Lab is gone before the next is made (two at once is most of the check's value slots)
 {s:[1]Lab;lab_dev_cell(s[..],"url=http://127.0.0.1:1/worlds/everglade-experimental?cell=200&yaw=90\n");
 #assert s[0].put_on && s[0].put_x==xdungeon.dg_x(2)+2.5 && s[0].put_z==xdungeon.dg_z(18)-2.5 && abs(s[0].creator[0].yaw-1.5708)<0.001;}
 {t:[1]Lab;lab_dev_cell(t[..],"url=http://127.0.0.1:1/worlds/everglade-experimental\n");#assert !t[0].put_on;}
}
url_sizes :: (s: [] Lab, facts: string) -> bool {
  i := 0;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    line := facts[i..<e];
    i = e + 1;
    if line.count < 4 || line[0..<4] != "url=" { continue; }
    q := line[4..<line.count];
    fm := film_find(q); if fm != FILM_NONE { film_setup(s, fm); return true; }
    // ?siege=1 plays the Siege, its sizes ?town=N&cult=M
    sg := url_number(q, "siege"); tw := url_number(q, "town"); cu := url_number(q, "cult");
    if sg > 0 || tw >= 0 || cu >= 0 {
      if !s[0].siege { s[0].siege = true; s[0].pick = 0; s[0].wins[0] = 0; s[0].wins[1] = 0; s[0].wins[2] = 0; if !set_siege(s, ifx tw >= 0 then tw else s[0].town, ifx cu >= 0 then cu else s[0].cult) { new_battle(s); } return true; }
      return set_siege(s, ifx tw >= 0 then tw else s[0].town, ifx cu >= 0 then cu else s[0].cult);
    }
    h := url_number(q, "heroes"); sk := url_number(q, "skeletons"); st := url_number(q, "stream");
    if st < 0 { st = url_number(q, "dead"); }
    if h < 0 && sk < 0 && st < 0 { return false; }
    return set_sizes(s, ifx h >= 0 then h else s[0].heroes, ifx sk >= 0 then sk else s[0].skeletons, ifx st >= 0 then st else s[0].stream);
  }
  return false;
}

#test "experimental respawn restores the player while keeping defeated monsters dead" {
 s:[1]Lab;s[0].creator[0].experimental=true;s[0].creator[0].on=true;s[0].creator[0].width=960;s[0].creator[0].height=600;s[0].creator[0].scale=1;
 h:=s[0].creator[0].hostiles[..];h[0].ready=true;h[0].hp=0;h[0].enemies[0].dead=true;h[0].enemies[1].x=3;h[0].enemies[1].home_x=10;h[0].enemies[1].home_z=9;s[0].you_on=true;
 #assert lab_key(s[..], 'r', 0) && h[0].hp==s[0].xc[0].b[0].c[0].hp_max && h[0].enemies[0].dead && h[0].enemies[1].x==10;
 w:=lab_walk(s[..]);#assert w.on && w.put && w.x==0 && w.z==0 && !lab_walk(s[..]).put;
 #assert s[0].xc[0].b[0].c[1].dead;
 h[0].hp=0;s[0].xc[0].b[0].c[0].hp=0;s[0].xc[0].b[0].c[0].dead=true;
 #assert hostile.hc_offer(h[0].contacts[..],1);
 #assert lab_pointer(s[..],480,130,0,1,7) && lab_pointer(s[..],480,130,2,1,7) && h[0].hp==s[0].xc[0].b[0].c[0].hp_max;
 #assert h[0].contacts[0].count==0 && !s[0].xc[0].b[0].c[0].dead;
 h[0].hp=0;#assert !lab_respawn(s[..]); // a stale observer cannot reset a living hero
}
