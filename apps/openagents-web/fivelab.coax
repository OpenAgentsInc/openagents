  #assert s[0].creator[0].experimental && s[0].creator[0].on && s[0].creator[0].preview_collapsed;
  u:[64]f32; out:[1]f32; _:=cc.frame(s[0].creator[..],out[..],u[..],1280,720,1,0,false); #assert u[11]==3;
  s[0].creator[0].preview_collapsed=false;lab_message(s[..],600,"url=http://localhost/worlds/everglade-experimental\n");#assert !s[0].creator[0].preview_collapsed;
  w:=lab_walk(s[..]); #assert w.on && w.put;
  #assert lab_key(s[..],'w',0); input:=lab_move_in(s[..]); #assert input.key_y==1 && input.theta==0;
  edge:=lab_keep(s[..],150,150); #assert edge.x==82 && edge.z==82;
  edge=lab_keep(s[..], -150, -150);#assert edge.x== -82 && edge.z== -82;
  edge=lab_keep(s[..],45,45);#assert edge.x==45 && edge.z==45;
  edge=lab_keep(s[..],-20,-150);#assert edge.x== -20 && edge.z== -150;edge=lab_keep(s[..],-20,-170);#assert edge.z>xdungeon.dg_south();
  #assert !lab_move_world(s[..],0,0).still;
  lab_you(s[..],2,0,3,1,false,false,false,0,0,0,0);
  #assert s[0].creator[0].player_x==2 && s[0].creator[0].player_z==3;
  #assert cc.probe(s[0].creator[..],26)==2000 && cc.probe(s[0].creator[..],27)==3000;
  released:=lab_key_up(s[..],'w',0); #assert lab_move_in(s[..]).key_y==0;
}

// ---- input

leave_to :: (s: [] Lab, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}
// SRD rounds or action combat: a new battle on the other clock.
switch_mode :: (s: [] Lab) {
  s[0].mode = 1 - s[0].mode;
  new_battle(s);
}
// Respawn at the experimental spawn; defeated foes stay defeated.
lab_respawn :: (s:[]Lab)->bool {
 c:=s[0].creator[..];h:=c[0].hostiles[..];if !c[0].experimental || !h[0].ready {return false;}
 if s[0].xc[0].started {if s[0].xc[0].b[0].c[0].hp>0 {return false;}} else if h[0].hp>0 {return false;}
 xc_start(s[0].xc[..],s[0].xc[0].klass);
 xc_set_class(s[0].xc[..],s[0].xc[0].klass);
 h[0].contacts[0]=hostile.HcContacts.{};hostile.hostile_calm(h);   // nothing engages you for a moment, and no shot is in the air
 xc_sync_vitals(s);xc_sync_permissions(s);
 h[0].died_at=0;h[0].pop_next=0;for i:0..<8 {h[0].pops[i].amount=0;}
 for i:0..<hostile.HS_N {e:=h[0].enemies[i..<i+1];if !e[0].dead {e[0].x=e[0].home_x;e[0].z=e[0].home_z;e[0].swing= -1;e[0].moving=false;e[0].cool=1;e[0].returning=false;if e[0].sleeper {e[0].awake=false;}}}
 c[0].player_x=0;c[0].player_y=0;c[0].player_z=0;c[0].airborne=false;c[0].land_at= -100;c[0].camera_room= -1;
 s[0].you_on=false;s[0].safe_on=false;s[0].put_on=false;s[0].held=0;s[0].shift=false;s[0].xc[0].target= -1;sprint.sprint_stop(s[0].xc[0].dash[..]);return true;
}
lab_respawn_pointer :: (s:[]Lab,x:f32,y:f32,phase:int,id:int)->bool {
 c := s[0].creator[..];if !c[0].experimental || !c[0].hostiles[0].ready || c[0].hostiles[0].hp>0 {s[0].respawn_id= -1;return false;}
 k:=c[0].scale;inside:=x>=c[0].width*0.5-130*k && x<=c[0].width*0.5+130*k && y>=105*k && y<=155*k;
 if phase==0 && inside {s[0].respawn_id=id;return true;}
 if s[0].respawn_id!=id {return false;}if phase==2 {s[0].respawn_id= -1;if inside {_:=lab_respawn(s);}return true;}if phase==3 {s[0].respawn_id= -1;return true;}return true;
}
lab_key :: (s: [] Lab, key: int, mods: int) -> bool #export_c #effects(all) {
  if s[0].creator[0].experimental {if (key=='r' || key=='R') && lab_respawn(s) {return true;}if mlook.ml_key(s[0].creator[0].ml[..],key) {return true;}if (key=='e' || key=='E') && lab_mount_key(s) {return true;}if (key=='x' || key=='X') && lab_land_key(s) {return true;}if (key=='f' || key=='F') && lab_breath_key(s) {return true;}if xc_key(s,key) {return true;}if key==' ' {s[0].held|=HOLD_JUMP;return true;}if key==KEY_SHIFT {s[0].shift=true;return true;}h:=hold_bit(key);if h!=0 {s[0].held|=h;return true;}return false;}
  if s[0].creator[0].on {return cc.key(s[0].creator[..],key);}
  lab_start(s);
  // Escape pauses and resumes, as a game's does (WORLDS, top right, goes back to the worlds)
  if key == KEY_ESCAPE { s[0].paused = !s[0].paused; s[0].held = 0; return true; }
  if key == 'p' || key == 'P' { set_player(s, !s[0].player); return true; }
  if key == 'v' || key == 'V' { s[0].view = 1 - s[0].view; return true; }
  if s[0].player {
    // playing: an action game's keys (Everglade's: W A S D, Shift, Space, the arrows), the hotbar's,
    // and none that start the battle again under you
    if key >= '1' && key <= '9' { s[0].act = key - '1'; return true; }
    if key == '[' || key == ']' { np := pick_count(s); s[0].pick = (s[0].pick + ifx key == ']' then 1 else np - 1) % np; pick_hero(s); return true; }
    if key == KEY_TAB { target_next(s); return true; }
    if key == ' ' { s[0].held |= HOLD_JUMP; return true; }
    if key == KEY_SHIFT { s[0].shift = true; return true; }
    h := hold_bit(key);
    if h != 0 { s[0].held |= h; return true; }
    return false;
  }
  if key == 'f' || key == 'F' { s[0].fast = !s[0].fast; return true; }
  if key == 'r' || key == 'R' { new_battle(s); return true; }
  if key == 'm' || key == 'M' { switch_mode(s); return true; }
  if key == 'z' || key == 'Z' || key == 'x' || key == 'X' { changed := nudge(s, SL_HEROES, key == 'x' || key == 'X'); return true; }
  if key == 'q' || key == 'Q' || key == 'e' || key == 'E' { changed := nudge(s, SL_SKELETONS, key == 'e' || key == 'E'); return true; }
  if s[0].horde && !s[0].siege && (key == 'k' || key == 'K' || key == 'l' || key == 'L') { changed := nudge(s, SL_STREAM, key == 'l' || key == 'L'); return true; }
  if key == 'h' || key == 'H' { next_scenario(s); return true; }
  if s[0].view == VIEW_GLADE {
    h := hold_bit(key);
    if h != 0 { s[0].held |= h; return true; }
    if key == 'c' || key == 'C' { lab_view_home(s); return true; }
    if key == KEY_SHIFT { s[0].shift = true; return false; }
  }
  return false;
}
lab_key_up :: (s: [] Lab, key: int, mods: int) -> bool #export_c #effects(all) {
  if key == KEY_SHIFT { s[0].shift = false; }
  if s[0].xc[0].dr.breath_slot >= 0 && key == s[0].xc[0].dr.breath_key && xd_release(s) { return true; }
  if mlook.ml_key_up(s[0].creator[0].ml[..], key) { return true; }
  h := ifx key == ' ' then HOLD_JUMP else hold_bit(key);
  s[0].held = s[0].held & (HOLD_ALL - h);   // h is one HOLD_ bit or none
  return h != 0;
}
// Tab: your target is the next of the foes standing, nearest first, round again past the last.
target_next :: (s: [] Lab) {
  b := bt(s);
  me := s[0].me;
  if me < 0 { return; }
  at := ifx s[0].target >= 0 && rs_up(b[0].c[s[0].target]) then rs_feet_to(b, me, s[0].target) else -1;
  best := -1; bd := 1000000; first := -1; fd := 1000000;
  for j: 0..<b[0].n {
    if j == me || !rs_up(b[0].c[j]) || b[0].c[j].team == b[0].c[me].team { continue; }
    d := rs_feet_to(b, me, j);
    if d < fd || (d == fd && j < first) { fd = d; first = j; }
    after := at >= 0 && (d > at || (d == at && j > s[0].target));
    if after && (d < bd || (d == bd && j < best)) { bd = d; best = j; }
  }
  s[0].target = ifx best >= 0 then best else first;
}
lab_blur :: (s: [] Lab) #export_c #effects(all) { s[0].creator[0].dragging=false;s[0].creator[0].down=-1; s[0].stick_on = false; s[0].sliding = -1; s[0].pressing = 0; s[0].dragging = false; s[0].shift = false; s[0].fingers = 0; s[0].held = 0; s[0].xc[0].arranging=false; s[0].xc[0].down= -100; mlook.ml_blur(s[0].creator[0].ml[..]); }
// The keys that fly the camera while they are held.
hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_W; }
  if key == 'a' || key == 'A' { return HOLD_A; }
  if key == 's' || key == 'S' { return HOLD_S; }
  if key == 'd' || key == 'D' { return HOLD_D; }
  if key == KEY_LEFT { return HOLD_LEFT; }
  if key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_UP { return HOLD_UP; }
  if key == KEY_DOWN { return HOLD_DOWN; }
  if key == '=' || key == '+' { return HOLD_IN; }
  if key == '-' || key == '_' { return HOLD_OUT; }
  return 0;
}
axis :: (held: int, plus: int, minus: int) -> f32 {
  a: f32 = 0;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}
// Each frame the held keys fly the camera: its speeds ease toward what the keys ask and coast to
// a stop when they let go, so it glides rather than steps. Paused or not, on the frame's real time.
fly :: (s: [] Lab, dt: f32) {
  t := lo(dt, 0.1);
  if !(t > 0) { return; }
  ease := lo(1, t * 9);
  h := s[0].held;
  if s[0].view != VIEW_GLADE { h = 0; }
  // in Player mode the keys walk your hero and turn the follow camera (lab_chase_step): the
  // spectator's camera waits where it was, for when you leave
  if s[0].player { h = 0; }
  speed := s[0].dist * 0.9;   // metres a second: a long way out, it flies faster
  s[0].vx += (axis(h, HOLD_D, HOLD_A) * speed - s[0].vx) * ease;
  s[0].vz += (axis(h, HOLD_W, HOLD_S) * speed - s[0].vz) * ease;
  s[0].vyaw += (axis(h, HOLD_RIGHT, HOLD_LEFT) * 1.6 - s[0].vyaw) * ease;
  s[0].vpitch += (axis(h, HOLD_UP, HOLD_DOWN) * 0.9 - s[0].vpitch) * ease;
  s[0].vzoom += (axis(h, HOLD_OUT, HOLD_IN) * 1.4 - s[0].vzoom) * ease;
  ax := s[0].fwd.x; az := s[0].fwd.z; al := sqrt(ax * ax + az * az);
  if al > 0.0001 { ax /= al; az /= al; }
  s[0].px += (s[0].right.x * s[0].vx + ax * s[0].vz) * t;
  s[0].pz += (s[0].right.z * s[0].vx + az * s[0].vz) * t;
  hx := f32(s[0].cols) * f32(SQ) / 2; hz := f32(s[0].rows) * f32(SQ) / 2;
  s[0].px = lo(hx, hi(-hx, s[0].px)); s[0].pz = lo(hz, hi(-hz, s[0].pz));
  s[0].yaw += s[0].vyaw * t;
  s[0].pitch = lo(1.35, hi(0.12, s[0].pitch + s[0].vpitch * t));
  lab_view_zoom(s, 1 + s[0].vzoom * t);
}
// The spectator's camera is Aethyr's overhead camera (aethyr/cam/overhead.coax) over the grid.
// Its zoom: its distance times `by`, held between near and far.
lab_view_zoom :: (s: [] Lab, by: f32) { s[0].dist = figs.cam_overhead_zoom(s[0].dist, by, ZOOM_NEAR, ZOOM_FAR * grid_scale(s)); }
// How much bigger the grid is than the lab's 40 by 20: the camera's orbit backs off by as much.
grid_scale :: (s: [] Lab) -> f32 { return f32(s[0].cols) / f32(COLS); }
// Its home view, the whole grid in view.
lab_view_home :: (s: [] Lab) {
  h := figs.cam_overhead_home(DIST * grid_scale(s), PIVOT_Z);
  s[0].yaw = h.yaw; s[0].pitch = h.pitch; s[0].dist = h.dist; s[0].px = h.px; s[0].pz = h.pz; s[0].vx = 0; s[0].vz = 0;
  s[0].cam_siege = s[0].siege;
  // the Siege: from behind the watch's line, looking out at the cult (its leader at the back),
  // near enough that the figures read; the wheel backs off from there
  if s[0].siege { s[0].yaw = SIEGE_YAW; s[0].pitch = 0.42; s[0].dist = 0.55 * DIST * grid_scale(s); s[0].px = wx(s, f32(s[0].cols) * 0.36); s[0].pz = PIVOT_Z; }
}
SIEGE_YAW :: -1.5707963;
// A pan: the ground follows the pointer, dx right and dy down (device px). It stays over the grid.
lab_view_pan :: (s: [] Lab, dx: f32, dy: f32) {
  p := figs.cam_overhead_pan(s[0].px, s[0].pz, s[0].dist, s[0].focal, s[0].pitch, s[0].fwd.x, s[0].fwd.z, s[0].right.x, s[0].right.z, dx, dy,
    f32(s[0].cols) * f32(SQ) / 2, f32(s[0].rows) * f32(SQ) / 2);
  s[0].px = p[0]; s[0].pz = p[1];
}
// The wheel (CSS px, down is out) zooms.
lab_wheel :: (s: [] Lab, dy: f32) -> bool #export_c #effects(all) {
  if s[0].creator[0].on {cc.wheel(s[0].creator[..],dy);return true;}
  lab_start(s);
  if s[0].view != VIEW_GLADE { return false; }
  if s[0].player { s[0].orbit = figs.cam_wheel(s[0].orbit, dy); return true; }
  lab_view_zoom(s, 1 + lo(200, hi(-200, dy)) * 0.0012);
  return true;
}
lab_pointer :: (s: [] Lab, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  if phase == 0 { s[0].creator[0].ml[0].touch = kind != 0; }
  if s[0].creator[0].on {if s[0].creator[0].experimental && lab_respawn_pointer(s,x,y,phase,id) {return true;}if s[0].creator[0].experimental && lab_ride_pointer(s,x,y,phase) {return true;}if s[0].creator[0].experimental && xc_pointer(s,x,y,phase,id) {return true;}return cc.pointer(s[0].creator[..],x,y,phase,id);}
  lab_start(s);
  if phase == 0 {
    if in_rect(s[0].back, x, y) { s[0].pressing = 1; return true; }
    if in_rect(s[0].flip, x, y) { s[0].pressing = 2; return true; }
    if in_rect(s[0].modal, x, y) { s[0].pressing = 3; return true; }
    if in_rect(s[0].pbtn, x, y) { s[0].pressing = 4; return true; }
    if !s[0].player && in_rect(s[0].sbtn, x, y) { s[0].pressing = 5; return true; }
    sl := slider_at(s, x, y);
    if sl >= 0 { s[0].sliding = sl; s[0].want[sl] = slider_value_at(s, sl, x); return true; }
    if s[0].player {
      for c: 0..<pick_count(s) { if in_rect(s[0].picks[c], x, y) { s[0].pressing = 10 + c; return true; } }
      for c: 0..<SLOTS { if in_rect(s[0].slots[c], x, y) { s[0].pressing = 30 + c; return true; } }
    }
    s[0].down_x = x; s[0].down_y = y;
    // playing on a phone, a finger off the buttons is the thumb's stick or look (fivelab-face.c)
    if s[0].player && kind != 0 { return false; }
    if s[0].view == VIEW_GLADE && !in_rect(s[0].panel, x, y) {
      // a second finger: the two pinch to zoom and move together to pan
      if kind == 1 && s[0].fingers == 1 && s[0].fing_id[0] != id {
        s[0].fingers = 2; s[0].fing_id[1] = id; s[0].fing_x[1] = x; s[0].fing_y[1] = y; return true;
      }
      if kind == 1 { s[0].fingers = 1; s[0].fing_id[0] = id; s[0].fing_x[0] = x; s[0].fing_y[0] = y; }
      s[0].dragging = true; s[0].panning = s[0].shift; s[0].drag_x = x; s[0].drag_y = y; return true;
    }
    return false;
  }
  if s[0].sliding >= 0 {
    // a slider dragged: the number follows; let go, and the battle starts again at it
    r := s[0].sliding;
    s[0].want[r] = slider_value_at(s, r, x);
    if phase == 1 { return true; }
    s[0].sliding = -1;
    if phase == 2 { changed := set_slider(s, r, s[0].want[r]); }
    return true;
  }
  if s[0].player && kind != 0 && s[0].pressing == 0 { return false; }
  if phase == 1 {
    if kind == 1 && s[0].fingers == 2 {
      f := ifx s[0].fing_id[0] == id then 0 else ifx s[0].fing_id[1] == id then 1 else -1;
      if f < 0 { return false; }
      gap0 := sqrt((s[0].fing_x[0] - s[0].fing_x[1]) * (s[0].fing_x[0] - s[0].fing_x[1]) + (s[0].fing_y[0] - s[0].fing_y[1]) * (s[0].fing_y[0] - s[0].fing_y[1]));
      mx0 := (s[0].fing_x[0] + s[0].fing_x[1]) / 2; my0 := (s[0].fing_y[0] + s[0].fing_y[1]) / 2;
      s[0].fing_x[f] = x; s[0].fing_y[f] = y;
      gap1 := sqrt((s[0].fing_x[0] - s[0].fing_x[1]) * (s[0].fing_x[0] - s[0].fing_x[1]) + (s[0].fing_y[0] - s[0].fing_y[1]) * (s[0].fing_y[0] - s[0].fing_y[1]));
      if gap0 > 1 && gap1 > 1 { lab_view_zoom(s, gap0 / gap1); }
      lab_view_pan(s, (s[0].fing_x[0] + s[0].fing_x[1]) / 2 - mx0, (s[0].fing_y[0] + s[0].fing_y[1]) / 2 - my0);
      return true;
    }
    if !s[0].dragging { return false; }
    if s[0].player {
      // playing, a drag looks round (Everglade's drag look)
      k := hi(s[0].dpr, 0.5);
      d := figs.cam_drag(x - s[0].drag_x, y - s[0].drag_y, k); s[0].look_yaw += d[0]; s[0].look_pitch += d[1];
    }
    else if s[0].panning { lab_view_pan(s, x - s[0].drag_x, y - s[0].drag_y); }
    else {
      k := hi(s[0].dpr, 0.5);
      s[0].yaw -= (x - s[0].drag_x) * 0.005 / k;
      s[0].pitch = lo(1.35, hi(0.12, s[0].pitch + (y - s[0].drag_y) * 0.004 / k));
    }
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  if kind == 1 && s[0].fingers > 0 {
    // a finger lifts: the one left (if any) drags on from where it is
    if s[0].fingers == 2 {
      left := ifx s[0].fing_id[0] == id then 1 else 0;
      s[0].fing_id[0] = s[0].fing_id[left]; s[0].fing_x[0] = s[0].fing_x[left]; s[0].fing_y[0] = s[0].fing_y[left];
      s[0].fingers = 1; s[0].drag_x = s[0].fing_x[0]; s[0].drag_y = s[0].fing_y[0];
      return true;
    }
    s[0].fingers = 0;
  }
  s[0].dragging = false; s[0].panning = false;
  held := s[0].pressing; s[0].pressing = 0;
  if held == 1 { if phase == 2 && in_rect(s[0].back, x, y) { leave_to(s, "/worlds"); } return true; }
  if held == 2 { if phase == 2 && in_rect(s[0].flip, x, y) { s[0].view = 1 - s[0].view; } return true; }
  if held == 3 { if phase == 2 && in_rect(s[0].modal, x, y) { switch_mode(s); } return true; }
  if held == 4 { if phase == 2 && in_rect(s[0].pbtn, x, y) { set_player(s, !s[0].player); } return true; }
  if held == 5 { if phase == 2 && in_rect(s[0].sbtn, x, y) { next_scenario(s); } return true; }
  if held >= 10 && held < 22 { if phase == 2 && in_rect(s[0].picks[held - 10], x, y) { s[0].pick = held - 10; pick_hero(s); } return true; }
  if held >= 30 && held < 30 + SLOTS { if phase == 2 && in_rect(s[0].slots[held - 30], x, y) { s[0].act = held - 30; } return true; }
  // in Player mode a click (not a drag) on one of the dead makes it your target
  if phase == 2 && s[0].player && s[0].view == VIEW_GLADE && abs(x - s[0].down_x) + abs(y - s[0].down_y) < 8 * hi(s[0].dpr, 1) {
    s[0].target = token_at(s, x, y);
    return true;
  }
  return false;
}
// No OS cursor while Experimental's crosshair is up (a drawn bow, mouselook's reticle): the crosshair is the pointer.
lab_cursor :: (s: [] Lab) -> int #export_c #effects(all) {
  c := s[0].creator[..];
  if c[0].on && c[0].experimental && !c[0].walk.on && (s[0].xc[0].draw[0].on || c[0].aim > 0.01 || c[0].ml[0].shown > 0.01) { return 4; }
  return 0;
}
// Experimental's mouselook, the host's face (aethyr/cam/mouselook.coax): in the world while you stand
// (dead, the cursor is free for the respawn), never in Character Create's studio or the walk out of it.
// The mouse turns the camera as a drag does, its tilt held to the drag's.
lab_mouselook :: (s: [] Lab) -> int #export_c #effects(all) { return mlook.ml_host(s[0].creator[0].ml[0]); }
lab_look_delta :: (s: [] Lab, dx: f32, dy: f32) #export_c #effects(all) {
  c := s[0].creator[..]; t := mlook.ml_turn(c[0].ml[0], dx, dy);
  c[0].yaw = figs.wrap_angle(c[0].yaw - t[0]); c[0].pitch = cc.cc_clamp(c[0].pitch + t[1], -1.2, 1.2);
}
lab_pointer_lock :: (s: [] Lab, status: int) #export_c #effects(all) { mlook.ml_lock(s[0].creator[0].ml[..], status); if status == 1 { s[0].creator[0].dragging = false; } }
#test "Experimental's mouse looks round in the world, not in the studio, and a dead hero gets the cursor" {
  s: [1] Lab; s[0].creator[0].on = true; s[0].creator[0].experimental = true; s[0].creator[0].hostiles[0].ready = true; s[0].creator[0].hostiles[0].hp = 10;
  lab_mouselook_step(s[..], 0.1); #assert lab_mouselook(s[..]) == mlook.ML_LOOK;
  lab_pointer_lock(s[..], 1); yaw := s[0].creator[0].yaw; pitch := s[0].creator[0].pitch;
  lab_look_delta(s[..], 100, 40); #assert s[0].creator[0].yaw < yaw && s[0].creator[0].pitch > pitch;
  #assert lab_key(s[..], KEY_TAB, 0) && lab_mouselook(s[..]) == mlook.ML_FREE;
  #assert lab_key(s[..], KEY_TAB, 0) && lab_mouselook(s[..]) == mlook.ML_LOOK;
  for i: 0..<5 { lab_mouselook_step(s[..], 0.1); }
  #assert abs(figs.wrap_angle(lab_aim_face(s[..], 0) - (s[0].creator[0].yaw + 3.14159265))) < 0.001;   // you face the camera's way
  s[0].creator[0].hostiles[0].hp = 0; lab_mouselook_step(s[..], 0.1); #assert lab_mouselook(s[..]) == 0;
  s[0].creator[0].experimental = false; lab_mouselook_step(s[..], 0.1); #assert lab_mouselook(s[..]) == 0;
}
lab_mouselook_step :: (s: [] Lab, dt: f32) {
  c := s[0].creator[..];
  c[0].ml[0].able = c[0].on && c[0].experimental && !c[0].walk.on && !(c[0].hostiles[0].ready && c[0].hostiles[0].hp <= 0);
  mlook.ml_step(c[0].ml[..], dt);
}
HOST_PAGE :: 600;   // coax/web/host.js's page facts: key=value lines, the url among them
lab_message :: (s: [] Lab, kind: int, t: string) #export_c #effects(all) {
  if kind == 700 { fd_message(s, t); return; }   // a driver's command (coax/web/host.js coaxial.drive)
  if kind==12 { _ := xc_order_load(s[0].xc[..], t); return; }
  if kind==16 {cc.load_player(s[0].creator[..],t);return;}
  if kind==17 {cc.player_reply(s[0].creator[..],t);return;}
  if kind==ACT_PREFETCH {cc.walk_reply(s[0].creator[..],t);return;}
  if kind==HOST_PAGE && (cc.experimental_page(t) || xd_page(t)) {if xd_page(t) {xd_enter(s);}if !s[0].creator[0].experimental {s[0].creator[0].preview_collapsed=true;}s[0].creator[0].on=true;s[0].creator[0].experimental=true;s[0].creator[0].dev_animations=cc.dev_local(t);s[0].creator[0].build_review=cc.build_review_page(t);s[0].creator[0].yaw=0;s[0].creator[0].pitch=0.35;s[0].creator[0].dist=4;s[0].started=true;s[0].view=VIEW_GLADE;cc.ensure(s[0].creator[..]);lab_stage(s,t);if s[0].creator[0].dev_animations {lab_dev_cell(s,t);}return;}
  if kind==HOST_PAGE && cc.page(t) {s[0].creator[0].on=true;s[0].creator[0].scene_only=cc.scene_capture(t);s[0].started=true;s[0].view=VIEW_GLADE;cc.ensure(s[0].creator[..]);return;}
  // The host delivers a kept appearance before page facts identify the route.
  if kind==4 { restored:=cc.restore(s[0].creator[..],t);if restored {return;} }
  lab_start(s);
  if kind == HOST_PAGE { changed := url_sizes(s, t); }
}
lab_golden :: (s: [] Lab, on: bool) #export_c #effects(all) { lab_start(s); s[0].golden = on; }
lab_action :: (s: [] Lab) -> int #export_c #effects(all) {
 if s[0].creator[0].on && s[0].creator[0].profile_request {for i:0..<56 {s[0].outbox[i]=s[0].creator[0].profile_bytes[i];}s[0].out_n=56;s[0].creator[0].profile_request=false;return 16;}
 if s[0].creator[0].experimental && s[0].xc[0].order_dirty {s[0].out_n=xc_order_save(s[0].xc[..],s[0].outbox[..]);s[0].xc[0].order_dirty=false;if s[0].out_n>0 {return 12;}}
 // USE IN EVERGLADE: open Everglade out of sight while the character walks there, then hand over in place (charactercreator-walk.coax).
 if s[0].creator[0].on && cc.walk_ask(s[0].creator[..]) {s[0].out_n=put(s[0].outbox[..],0,"/worlds/everglade");return ACT_PREFETCH;}
 if s[0].creator[0].on && cc.walk_leave(s[0].creator[..]) {s[0].out_n=put(s[0].outbox[..],0,"/worlds/everglade");return ACT_NAVIGATE;}
 if s[0].creator[0].on && s[0].creator[0].revision!=s[0].creator[0].saved {s[0].out_n=cc.save(s[0].creator[0],s[0].outbox[..]);s[0].creator[0].saved=s[0].creator[0].revision;return 4;} a := s[0].action; s[0].action = 0; return a; }
lab_action_done :: (s: [] Lab) #export_c #effects(all) { s[0].out_n = 0; }

coaxial_lab_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_lab_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_lab_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }
// The frame store's floats this frame: every token's room, then the grid's squares.
coaxial_lab_frame_floats :: (s: [] Lab) -> int #export_c #effects(all) { return F_SQUARES + s[0].cols * s[0].rows; }

// ---- checks

frame_at :: (s: [] Lab, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  return frame_into(s, out[..], w, h, dpr, dt);
}
// A frame into a check's own vertex buffer: a check that draws many frames makes the 4,000,000-float
// buffer once, not once a frame (#13115: 13 frames were 52,004,108 traversal visits).
frame_into :: (s: [] Lab, out: [] f32, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  u: [UNIFORM_FLOATS] f32;
  return lab_frame(s, out, u[..], w, h, dpr, dt, false);
}

#test "the battle runs on the SRD's rules: spells are cast, blows land, people drop" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false;
  lab_start(s[..]);
  dropped := 0;
  // a bit for each class once one of its people has spent a slot, a use, a Rage or a Focus Point,
  // or (a Rogue, who spends nothing) taken its turn
  spent := 0;
  for i: 0..<1500 {
    step(s[..], f32(STEP));
    if i % 30 == 0 {
      for h: 0..<s[0].heroes {
        c := s[0].battle[0].c[h..<h + 1];
        any := c[0].slots[1] < c[0].slots_max[1] || c[0].slots[2] < c[0].slots_max[2] || c[0].slots[3] < c[0].slots_max[3] || c[0].rages < c[0].rages_max || c[0].focus < c[0].focus_max;
        for u: 0..<RS_USES { if c[0].uses[u] < c[0].uses_max[u] { any = true; } }
        if c[0].klass == RS_ROGUE && s[0].acted[h] > 0 { any = true; }
        if any { spent = spent | (1 << c[0].klass); }
      }
      // every class has spent something: enough seen (and under the interpreter's budget)
      all := true; for r: 0..<12 { if (spent & (1 << ROSTER[r])) == 0 { all = false; } }
      if all { break; }
    }
    if s[0].over { break; }
  }
  for r: 0..<12 { #assert (spent & (1 << ROSTER[r])) != 0; }
  for i: 0..<s[0].battle[0].n { if s[0].battle[0].c[i].hp < s[0].battle[0].c[i].hp_max { dropped += 1; } }
  #assert dropped > 0;
  #assert s[0].line_n > 10;
}

#test "in the Horde every class finds the dead and spends its features on them" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = true;
  lab_start(s[..]);
  spent := 0;
  for i: 0..<700 {
    step(s[..], f32(STEP));
    if i % 30 == 0 {
      for h: 0..<s[0].heroes {
        c := s[0].battle[0].c[h..<h + 1];
        any := c[0].slots[1] < c[0].slots_max[1] || c[0].slots[2] < c[0].slots_max[2] || c[0].slots[3] < c[0].slots_max[3] || c[0].rages < c[0].rages_max || c[0].focus < c[0].focus_max;
        for u: 0..<RS_USES { if c[0].uses[u] < c[0].uses_max[u] { any = true; } }
        if c[0].klass == RS_ROGUE && s[0].acted[h] > 0 { any = true; }
        if any { spent = spent | (1 << c[0].klass); }
      }
    }
    if s[0].over { break; }
  }
  for r: 0..<12 { #assert (spent & (1 << ROSTER[r])) != 0; }
}

#test "each side fields two of every SRD 5e class at the Lab's LEVEL, the casters behind" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false;
  lab_start(s[..]);
  for team: 0..<2 {
    for r: 0..<12 {
      n := 0;
      for k: 0..<SIDE {
        c := s[0].battle[0].c[team * SIDE + k];
        #assert c.team == team && c.level == LEVEL;
        if c.klass == ROSTER[r] { n += 1; }
        // the casting classes at the back, each side on its own edge
        back := ifx team == 0 then c.x < 3 else c.x > s[0].cols - 4;
        if c.klass == RS_DRUID || c.klass == RS_WIZARD || c.klass == RS_WARLOCK || c.klass == RS_SORCERER || c.klass == RS_BARD || c.klass == RS_CLERIC { #assert back; }
      }
      #assert n == 2;
    }
  }
  #assert look_of(RS_DRUID) == 0 && look_of(RS_SORCERER) == 12 && look_of(RS_MONSTER) == 4;
}

#test "a frame draws the grid, the tokens and the log on a desktop and on a 390 px phone" #steps 2000000000 {
  // one Lab at a time (two at once is most of the check's value slots)
  cols := 0;
  { s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
    for i: 0..<200 { lab_start(s[..]); step(s[..], f32(STEP)); }
    a := frame_at(s[..], 1600, 1000, 1, 0.016);
    #assert a > 300 && a < MAX_VERTICES - 600;
    cols = s[0].cols; }
  { s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
    b := frame_at(s[..], 390 * 3, 844 * 3, 3, 0.016);
    #assert b > 100 && b < MAX_VERTICES - 600 && s[0].portrait;
    #assert s[0].gx >= 0 && s[0].gx + s[0].cell * f32(cols) <= 390 * 3; }
}

#test "the glade's camera sees the whole grid from its default orbit" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
  n := frame_at(s[..], 1600, 1000, 1, 0.016);
  for c: 0..<4 {
    x := ifx c % 2 == 0 then -0.5 else f32(s[0].cols) - 0.5;
    y := ifx c < 2 then -0.5 else f32(s[0].rows) - 0.5;
    p := proj(s[..], wx(s[..], x), 0, wz(s[..], y));
    #assert p.z > 0 && p.x > 0 && p.x < s[0].panel.x0 && p.y > 64 && p.y < 1000;
  }
}

#test "the camera zooms on the wheel and pans on Shift-drag and WASD, and C puts it back" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false; ok: bool; n: int;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  #assert lab_wheel(s[..], -100) && s[0].dist < DIST;
  ok = lab_wheel(s[..], 100000); #assert s[0].dist <= ZOOM_FAR;
  ok = lab_key(s[..], 'c', 0); #assert s[0].dist == DIST;
  ok = lab_key(s[..], KEY_SHIFT, 1);
  ok = lab_pointer(s[..], 400, 500, 0, 0, 1); ok = lab_pointer(s[..], 300, 500, 1, 0, 1); ok = lab_pointer(s[..], 300, 500, 2, 0, 1);
  #assert s[0].px > 0 && s[0].yaw == 0;   // the ground moved left under the pointer
  ok = lab_key_up(s[..], KEY_SHIFT, 0);
  ok = lab_key(s[..], 'c', 0); n = frame_at(s[..], 1600, 1000, 1, 0.016);
  ok = lab_key(s[..], 'w', 0);
  for i: 0..<20 { fly(s[..], 0.016); }
  z1 := s[0].pz; #assert z1 < PIVOT_Z;   // held, W flies forward (toward -Z at yaw 0)
  ok = lab_key_up(s[..], 'w', 0);
  for i: 0..<60 { fly(s[..], 0.016); }
  #assert s[0].pz < z1 && s[0].vz < 0.5 && s[0].vz > -0.5;   // let go, it coasts to a stop
  ok = lab_key(s[..], 'c', 0);
  ok = lab_pointer(s[..], 400, 500, 0, 0, 1); ok = lab_pointer(s[..], 450, 500, 1, 0, 1); ok = lab_pointer(s[..], 450, 500, 2, 0, 1);
  #assert s[0].yaw != 0;   // a plain drag still orbits
}

#test "two fingers pinch to zoom" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false; ok: bool; n: int;
  n = frame_at(s[..], 390, 844, 3, 0.016);
  ok = lab_pointer(s[..], 100, 300, 0, 1, 7); ok = lab_pointer(s[..], 200, 300, 0, 1, 8);
  ok = lab_pointer(s[..], 250, 300, 1, 1, 8);
  #assert s[0].dist < DIST && s[0].yaw == 0;
  ok = lab_pointer(s[..], 250, 300, 2, 1, 8); ok = lab_pointer(s[..], 100, 300, 2, 1, 7);
  #assert s[0].fingers == 0 && !s[0].dragging;
}

#test "Escape pauses, F runs fast, R starts a new battle, WORLDS goes to /worlds" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
  #assert !lab_key(s[..], ' ', 0) && !s[0].paused;   // Space is a jump, and a spectator has none
  #assert lab_key(s[..], KEY_ESCAPE, 0) && s[0].paused && lab_key(s[..], KEY_ESCAPE, 0) && !s[0].paused;
  #assert lab_key(s[..], 'f', 0) && s[0].fast;
  r := s[0].round;
  #assert lab_key(s[..], 'r', 0) && s[0].round == r + 1;
  #assert s[0].mode == MODE_ACTION && s[0].battle[0].timing.kind == RS_TIME_ACTION && lab_key(s[..], 'm', 0) && s[0].mode == MODE_ROUNDS && s[0].battle[0].timing.kind == RS_TIME_STRICT && lab_key(s[..], 'm', 0) && s[0].mode == MODE_ACTION;
  #assert s[0].view == VIEW_GLADE && lab_key(s[..], 'v', 0) && s[0].view == VIEW_FLAT && lab_key(s[..], 'v', 0) && s[0].view == VIEW_GLADE;
  n := frame_at(s[..], 1600, 1000, 1, 0.016);
  b := s[0].back;
  ok := lab_pointer(s[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 0, 0, 1); ok = lab_pointer(s[..], (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2, 2, 0, 1);
  #assert lab_action(s[..]) == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/worlds";
}

#test "the Horde: every hero on one side mid-glade, the dead on the edges, and they run in" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24;
  lab_start(s[..]);
  b := bt(s[..]);
  for i: 0..<s[0].heroes { #assert b[0].c[i].team == 0 && b[0].c[i].x >= s[0].cols / 2 - 4 && b[0].c[i].x < s[0].cols / 2 + 4; }
  far := 0;
  for i: s[0].heroes..<b[0].n {
    c := b[0].c[i];
    #assert c.team == 2 && rs_min(rs_min(c.x, c.y), rs_min(s[0].cols - 1 - c.x, s[0].rows - 1 - c.y)) <= 1;
    far += rs_feet_to(b, i, 0);
  }
  for i: 0..<40 { step(s[..], f32(STEP)); }
  closer := 0;
  for i: s[0].heroes..<b[0].n { closer += rs_feet_to(b, i, 0); }
  #assert closer < far;   // the dead have closed in
  #assert s[0].pool == s[0].stream && s[0].stream == HORDE - SKELETONS;
  b[0].c[s[0].heroes].dead = true; b[0].c[s[0].heroes].hp = 0;
  for i: 0..<70 { step(s[..], f32(STEP)); }
  // a fresh one ran in (at level 6 it may already have fallen again: that's raised past 25)
  #assert s[0].raised >= 25 && s[0].pool == s[0].stream + 24 - s[0].raised;
  #assert lab_key(s[..], 'h', 0) && !s[0].horde && b[0].c[s[0].heroes - 1].team == 1;
}

#test "Player mode: P plays the picked class, the hotbar keys pick the action, your token walks to your body and the follow camera swings in" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false; ok: bool; n: int;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  n = frame_into(s[..], out[..], 1600, 1000, 1, 0.016);
  ok = lab_key(s[..], 'p', 0);
  #assert s[0].player && s[0].me >= 0 && s[0].battle[0].c[s[0].me].klass == RS_FIGHTER;
  ok = lab_key(s[..], ']', 0);
  #assert s[0].battle[0].c[s[0].me].klass == ROSTER[7];
  ok = lab_key(s[..], '3', 0); #assert s[0].act == 2;
  ok = lab_key(s[..], '1', 0); #assert s[0].act == ACT_ATTACK;
  // Tab picks a foe, here while there are foes: the fight can be over before the walk below is
  ok = lab_key(s[..], KEY_TAB, 0); #assert s[0].target >= 0 && s[0].battle[0].c[s[0].target].team != 0;
  me := s[0].me; x0 := s[0].battle[0].c[me].x;
  // the face puts your body on your token, and Everglade's step walks it (the face's half, here by hand)
  w := lab_walk(s[..]);
  #assert w.on && w.put && abs(w.x - wx(s[..], f32(x0))) < 0.001;
  #assert !lab_walk(s[..]).put;   // put once
  ok = lab_key(s[..], 'd', 0); ok = lab_key(s[..], ' ', 0);
  mi := lab_move_in(s[..]);
  #assert mi.key_x == 1 && mi.key_y == 0 && mi.jump && !mi.run;
  ok = lab_key_up(s[..], ' ', 0); #assert !lab_move_in(s[..]).jump;
  ok = lab_key(s[..], KEY_SHIFT, 1); #assert lab_move_in(s[..]).run;   // Shift: Everglade walks (it runs unless held)
  ok = lab_key_up(s[..], KEY_SHIFT, 0);
  mw := lab_move_world(s[..], w.x, w.z);
  #assert mw.deck && !mw.still && mw.pace > 0.9;
  // your body walks three squares right: the token follows it on your turn, the rules' squares
  lab_you(s[..], w.x + 3 * f32(SQ), 0, w.z, 1.57, false, false, false, 0, 0, 0, 0);
  for i: 0..<200 { step(s[..], f32(STEP)); w = lab_walk(s[..]); }
  #assert s[0].battle[0].c[me].x > x0 && !w.put;
  // a body far past one turn's Speed is held to it
  kept := lab_keep(s[..], w.x + 100, w.z);
  #assert kept.x < w.x + 3 * f32(SQ) + (f32(you_reach(s[..])) + 0.6) * f32(SQ);
  // the follow camera swings in behind you; the play keys show under the hotbar
  for i: 0..<12 { n = frame_into(s[..], out[..], 1600, 1000, 1, 0.1); }
  #assert s[0].blend == 1 && s[0].eye.y < 4 && abs(s[0].eye.x - s[0].you_x) < 8;
  // a key that would start the battle again does nothing while you play
  r := s[0].round; #assert !lab_key(s[..], 'r', 0) && s[0].round == r;
  #assert n > 300 && s[0].slots[0].x1 > s[0].slots[0].x0;
  // every class's hotbar holds its own abilities, Attack or a cantrip first and Dash last
  for c: 0..<12 {
    list: [SLOTS] Ab; nab := abilities(ROSTER[c], list[..]);
    #assert nab >= 3 && nab <= SLOTS && list[nab - 1].kind == FB_DASH;
  }
  list: [SLOTS] Ab;
  #assert abilities(RS_BARBARIAN, list[..]) == 4 && list[2].kind == AB_RAGE;
  #assert abilities(RS_WIZARD, list[..]) == 9 && list[4].sp == SP_MAGIC_MISSILE && list[7].sp == SP_FIREBALL;
  ok = lab_key(s[..], 'p', 0); #assert !s[0].player && s[0].me < 0;
}

#test "the glade's effects: each kind of event starts its own recipe" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = false;
  lab_start(s[..]);
  b := bt(s[..]);
  sk := s[0].heroes;   // a Skeleton
  e: RsEvent; e.at = b[0].clock; e.by = 0; e.to = 1;
  kinds := [10] int.[RS_EV_ZONE, RS_EV_ZONE, RS_EV_ATTACK, RS_EV_ATTACK, RS_EV_ATTACK, RS_EV_HEAL, RS_EV_DEATH, RS_EV_CAST, RS_EV_ZONE, RS_EV_ATTACK];
  spells := [10] int.[SP_FIREBALL, SP_THUNDERWAVE, SP_FIRE_BOLT, SP_ELDRITCH_BLAST, -1, -1, -1, SP_SACRED_FLAME, SP_CALL_LIGHTNING, -1];
  want := [10] int.[FXR_FIREBALL, FXR_SHOCK, FXR_FIREBOLT, FXR_ELDRITCH, FXR_HIT, FXR_HEAL, FXR_BONES, FXR_COLUMN, FXR_LIGHTNING, FXR_HIT];
  for q: 0..<10 {
    fxp_clear(s[0].puffs[..]);
    e.kind = kinds[q]; e.spell = spells[q]; e.amount = 3; e.x = 10; e.y = 8; e.to = ifx q == 6 then sk else 1;
    b[0].c[e.to].x = 2 + q; b[0].c[e.to].y = 4;   // apart from the caster, but within reach of a blow
    b[0].c[0].x = 1 + q; b[0].c[0].y = 4;
    e.damage = ifx q == 9 then 1 else 0;
    lab_effect(s[..], e, 1.5 + f32(q), e.at);
    #assert fxp_live(s[0].puffs[..]) == 1;
    found := -1; big: f32 = 0;
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { found = s[0].puffs[0].live[k].recipe; big = s[0].puffs[0].live[k].big; } }
    #assert found == want[q];
    if q == 9 { #assert big > 1.5; }   // a critical hit is bigger
  }
  // a blow from afar is an arrow
  b[0].c[0].x = 1; b[0].c[1].x = 20;
  fxp_clear(s[0].puffs[..]);
  e.kind = RS_EV_ATTACK; e.spell = -1; e.to = 1; e.damage = 0;
  lab_effect(s[..], e, 3.5, e.at);
  for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { #assert s[0].puffs[0].live[k].recipe == FXR_ARROW; } }
}

#test "the glade's effects: each class feature and spell starts its own recipe" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = false;
  lab_start(s[..]);
  b := bt(s[..]);
  b[0].c[0].x = 4; b[0].c[0].y = 4; b[0].c[1].x = 5; b[0].c[1].y = 4;
  b[0].c[1].team = 1 - b[0].c[0].team;   // a foe beside it, for the Flurry
  e: RsEvent; e.at = b[0].clock; e.by = 0;
  feats := [16] int.[RS_FT_ACTION_SURGE, RS_FT_SECOND_WIND, RS_FT_SNEAK_ATTACK, RS_FT_STEADY_AIM, RS_FT_CUNNING_DASH, RS_FT_FLURRY,
                     RS_FT_STUNNING_STRIKE, RS_FT_PATIENT_DEFENSE, RS_FT_STEP_OF_THE_WIND, RS_FT_WHOLENESS, RS_FT_LAY_ON_HANDS,
                     RS_FT_SACRED_WEAPON, RS_FT_PRESERVE_LIFE, RS_FT_INSPIRATION, RS_FT_INNATE_SORCERY, RS_FT_DARK_BLESSING];
  kinds := [16] int.[RS_EV_CONDITION, RS_EV_CAST, RS_EV_DAMAGE, RS_EV_CONDITION, RS_EV_FEAT, RS_EV_CONDITION,
                     RS_EV_CONDITION, RS_EV_CONDITION, RS_EV_FEAT, RS_EV_CAST, RS_EV_CAST,
                     RS_EV_CONDITION, RS_EV_CAST, RS_EV_CONDITION, RS_EV_CONDITION, RS_EV_HEAL];
  want := [16] int.[FXR_SURGE, FXR_BREATH, FXR_SHADOW_SLASH, FXR_RETICLE, FXR_AFTERIMAGE, FXR_FLURRY,
                    FXR_STUN, FXR_WIND, FXR_WIND, FXR_WHOLENESS, FXR_LAY,
                    FXR_SACRED, FXR_WAVE, FXR_NOTES, FXR_ARCANE, FXR_FIEND];
  for q: 0..<16 {
    fxp_clear(s[0].puffs[..]);
    e.kind = kinds[q]; e.feat = feats[q]; e.spell = -1; e.to = ifx q == 2 || q == 6 || q == 10 || q == 13 then 1 else 0;
    lab_effect(s[..], e, 2.5 + f32(q), e.at);
    found := -1;
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { found = s[0].puffs[0].live[k].recipe; } }
    #assert found == want[q] && fxp_live(s[0].puffs[..]) == 1;
  }
  // a feature's own healing draws nothing more: its cast showed it
  fxp_clear(s[0].puffs[..]);
  e.kind = RS_EV_HEAL; e.feat = RS_FT_SECOND_WIND; e.to = 0;
  lab_effect(s[..], e, 1.5, e.at);
  #assert fxp_live(s[0].puffs[..]) == 0;
  // the spells that had no look of their own
  e.feat = RS_FT_NONE; e.kind = RS_EV_CAST; e.to = 1;
  spells := [5] int.[SP_HOLD_PERSON, SP_BLINDNESS, SP_VICIOUS_MOCKERY, SP_SHIELD, SP_DIVINE_SMITE];
  looks := [5] int.[FXR_BIND, FXR_VEIL, FXR_MOCKERY, FXR_BARRIER, FXR_SMITE];
  for q: 0..<5 {
    fxp_clear(s[0].puffs[..]);
    e.spell = spells[q]; e.amount = 3;
    lab_effect(s[..], e, 4.5 + f32(q), e.at);
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { #assert s[0].puffs[0].live[k].recipe == looks[q]; if q == 4 { #assert s[0].puffs[0].live[k].big > 1.5; } } }
  }
  // a creature poisoned and concentrating carries its lasting looks
  b[0].c[1].cond = RS_POISONED; b[0].c[0].conc = SP_HOLD_PERSON;
  #assert fx_marks(s[..], 1) == FXS_POISONED && (fx_marks(s[..], 0) & FXS_CONCENTRATING) != 0;
  #assert CD_ICON_POISONED == FXS_POISONED && CD_ICON_STUNNED == FXS_STUNNED && CD_ICON_FRIGHTENED == FXS_FRIGHTENED && CD_ICON_CHARMED == FXS_CHARMED;   // the shared icons are the puffs' marks
}

#test "a battle in the glade draws its effects as puffs, never past the budget" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = true;
  lab_start(s[..]);
  out: [4000 * VERTEX_FLOATS] f32;
  s[0].eye = P3.{x = 0, y = 20, z = 30};
  most := 0;
  for i: 0..<600 {
    step(s[..], f32(STEP));
    if i % 20 == 0 {
      glade_puffs(s[..]); n := draw_nums3(s[..], out[..], 0, 1);
      #assert s[0].puffs[0].out_n <= FX_PUFF_CAP && fxp_live(s[0].puffs[..]) <= FX_LIVE;
      if s[0].puffs[0].out_n > most { most = s[0].puffs[0].out_n; }
    }
  }
  #assert most > 0 && s[0].puffs[0].started > 0;
  // the flat view writes none
  n := draw_casts(s[..], out[..], 0, 1);
  #assert s[0].puffs[0].out_n == 0;
}

#test "the army sizes: the grid grows with them, every figure on its own square, the Horde's heroes in a block" #steps 2000000000 {
  s: [1] Lab; s[0].heroes = 4; s[0].skeletons = 6;
  lab_start(s[..]);
  b := bt(s[..]);
  #assert b[0].n == 10 && s[0].cols == COLS && s[0].rows == ROWS;
  ok := set_sizes(s[..], 100, 200, 50);
  #assert ok && b[0].n == 300 && s[0].pool == 50 && s[0].cols == 2 * s[0].rows && s[0].cols * s[0].rows >= 300 * 50 / 13;
  #assert !set_sizes(s[..], 100, 200, 50);   // the same sizes: no new battle
  #assert s[0].dist == DIST * grid_scale(s[..]) && grid_scale(s[..]) > 1;   // the camera backs off to see it all
  for i: 0..<b[0].n {
    c := b[0].c[i];
    #assert c.x >= 0 && c.y >= 0 && c.x < s[0].cols && c.y < s[0].rows && rs_at(b, c.x, c.y) == i;
    if i < 100 { #assert c.team == 0 && c.x >= s[0].cols / 2 - 6 && c.x < s[0].cols / 2 + 6; }
  }
  // past 48, the names count the company
  #assert cast(string) b[0].c[48].name[0..<b[0].c[48].name_n] == "Rowan 2";
  // the armies: two sides, each on its own edge, the dead in the middle
  #assert lab_key(s[..], 'h', 0) && !s[0].horde && b[0].n == 300;
  for i: 0..<100 {
    c := b[0].c[i];
    #assert c.team == hero_team(i) && (ifx c.team == 0 then c.x < s[0].cols / 2 - 8 else c.x > s[0].cols / 2 + 8);
  }
  // the most: 1024 and 16384 on the field at once, the grid at 384 by 192 at most
  #assert HEROES_MAX + SKELETONS_MAX == LAB_MAX && figs.BD_SLOTS == LAB_MAX && rs_room_for(b) == LAB_MAX;
  #assert F_SQUARES == LAB_MAX * 4 && F_SQUARES + LAB_SQUARES == FRAME_FLOATS && U_ZONES + RS_ZONES * 8 == U_BOUNDS && U_BOUNDS + 4 == U_FRAME_FLOATS && U_ENV + envf.ENV_FRAME_FLOATS == UNIFORM_FLOATS;
  #assert 2 * ROWS_MAX * ROWS_MAX == LAB_SQUARES && 2 * ROWS_MAX * ROWS_MAX * 13 >= LAB_MAX * 50;
  #assert figs.BD_RECORDS == SKELETONS_MAX * 3 + (HEROES_MAX + figs.BD_CORPSES) * figs.BD_PARTS_MAX;
}

#test "the sliders: a drag shows the number and lets go into a new battle; the keys nudge; the address sets them" #steps 2000000000 #traversal 268435456 {
  s: [1] Lab; s[0].heroes = 4; s[0].skeletons = 4; ok: bool; n: int;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  #assert sl_count(s[..]) == 3 && s[0].sliders[SL_HEROES].x1 > s[0].sliders[SL_HEROES].x0;
  // the scale: the ends are the least and the most, and a value comes back to itself
  #assert sl_at(s[..], SL_HEROES, 0) == 1 && sl_at(s[..], SL_HEROES, 1) == HEROES_MAX && sl_at(s[..], SL_SKELETONS, 0) == 0 && sl_at(s[..], SL_STREAM, 1) == HORDE_MAX;
  for v: 1..<60 { #assert sl_at(s[..], SL_SKELETONS, sl_pos(s[..], SL_SKELETONS, v)) == v; }
  t := s[0].sliders[SL_SKELETONS]; y := (t.y0 + t.y1) / 2;
  r := s[0].round;
  ok = lab_pointer(s[..], t.x0 + 2, y, 0, 1, 3);   // a finger
  #assert ok && s[0].sliding == SL_SKELETONS;
  ok = lab_pointer(s[..], t.x0 + (t.x1 - t.x0) * sl_pos(s[..], SL_SKELETONS, 9), y, 1, 1, 3);
  #assert s[0].want[SL_SKELETONS] == 9 && s[0].round == r && s[0].skeletons == 4;   // dragging: no new battle yet
  ok = lab_pointer(s[..], t.x0 + (t.x1 - t.x0) * sl_pos(s[..], SL_SKELETONS, 9), y, 2, 1, 3);
  #assert s[0].sliding < 0 && s[0].skeletons == 9 && s[0].round == r + 1 && s[0].battle[0].n == 13 && s[0].yaw == 0;
  ok = lab_key(s[..], 'x', 0); #assert s[0].heroes == 5;
  ok = lab_key(s[..], 'z', 0); #assert s[0].heroes == 4;
  ok = lab_key(s[..], 'q', 0); #assert s[0].skeletons == 7;
  ok = lab_key(s[..], 'l', 0); #assert s[0].stream == (840 * 5 + 3) / 4;
  facts := "tab=1\nurl=http://127.0.0.1:8809/worlds/5e-lab?heroes=6&skeletons=12&stream=30\nref=";
  lab_message(s[..], HOST_PAGE, facts);
  #assert s[0].heroes == 6 && s[0].skeletons == 12 && s[0].stream == 30 && s[0].battle[0].n == 18;
  #assert url_number("?heroes=7&xheroes=9", "heroes") == 7 && url_number("?xheroes=9", "heroes") == -1 && url_number("?skeletons=99999", "skeletons") == 99999;
  // past the most: said, in red, until a number under it is chosen; a key past the most says so too
  // (heroes here: a battle of the most skeletons is too big for the interpreter's checks)
  lab_message(s[..], HOST_PAGE, "url=http://x/worlds/5e-lab?heroes=5000&skeletons=0");
  #assert s[0].heroes == HEROES_MAX && s[0].skeletons == 0 && s[0].battle[0].n == HEROES_MAX;
  #assert s[0].asked[SL_HEROES] == 5000 && s[0].asked[SL_SKELETONS] == 0;
  ok = lab_key(s[..], 'e', 0); #assert s[0].skeletons == 1 && s[0].asked[SL_HEROES] == 5000;
  ok = lab_key(s[..], 'z', 0); #assert s[0].heroes < HEROES_MAX && s[0].asked[SL_HEROES] == 0;
  lab_message(s[..], HOST_PAGE, "url=http://x/worlds/5e-lab?heroes=1024&skeletons=0");
  ok = lab_key(s[..], 'x', 0); #assert s[0].heroes == HEROES_MAX && s[0].asked[SL_HEROES] == (HEROES_MAX * 5 + 3) / 4;
  // the skeletons' own: past 16384, the same
  #assert !set_sizes(s[..], HEROES_MAX, 0, s[0].stream) && sl_most(s[..], SL_SKELETONS) == SKELETONS_MAX && sl_at(s[..], SL_SKELETONS, 1) == 16384;
  // the HUD (the log, the top, the hotbar, the sliders) always has its room past the scene's strokes
  #assert SCENE_VERTS + HUD_VERTS == MAX_VERTICES;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  hud: [HUD_VERTS * VERTEX_FLOATS] f32;
  m := draw_sliders(s[..], hud[..], draw_player(s[..], hud[..], draw_top(s[..], hud[..], draw_panel(s[..], hud[..], 0, 1), 1600, 1, 0), 1), 1);
  #assert m > 1000 && m < HUD_VERTS - 100;
}

#test "the grid and the trees stand still through a battle's turns, its zooms and the next battle" #steps 2000000000 {
  s: [1] Lab; s[0].heroes = 40; s[0].skeletons = 200;
  lab_start(s[..]);
  #assert s[0].cols > COLS;   // a grid grown for them
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := lab_frame(s[..], out[..], u[..], 1600, 1000, 1, 0.05, false);
  #assert n > 0;
  // the shader's trees stand round the clearing at U_BOUNDS's half sizes (gpu/fivelab.coax
  // fivelab_tree): these four, and nothing else of the battle, place them and the grid's lines
  first: [4] f32; for k: 0..<4 { first[k] = u[U_BOUNDS + k]; }
  #assert first[0] == f32(s[0].cols) * f32(SQ) / 2 && first[1] == f32(s[0].rows) * f32(SQ) / 2 && first[2] == f32(SQ);
  cols := s[0].cols; rows := s[0].rows;
  r0 := s[0].round;
  turns := 0;
  for f: 0..<4 {
    // a second and more of the battle's turns, a zoom, and a frame
    for q: 0..<24 { step(s[..], f32(STEP)); }
    lab_view_zoom(s[..], ifx f % 2 == 0 then 0.6 else 1.5);
    n = lab_frame(s[..], out[..], u[..], 1600, 1000, 1, 0.05, false);
    for k: 0..<4 { #assert u[U_BOUNDS + k] == first[k]; }
    #assert s[0].cols == cols && s[0].rows == rows;
  }
  // the battle ran its turns, or ended and the next began at the same size
  #assert bt(s[..])[0].clock > 4 * 24 * f32(STEP) * 0.99 || s[0].round > r0;
}

#test "the Siege: H plays it after the Armies; 50 of the watch on their line, 50 of the cult 60 feet off, its leader on the far edge" #steps 2000000000 #traversal 1073741824 {
  s: [1] Lab;
  lab_start(s[..]);
  #assert s[0].horde && !s[0].siege && scenario_name(s[..]) == "HORDE";
  ok := lab_key(s[..], 'h', 0); #assert !s[0].horde && !s[0].siege && scenario_name(s[..]) == "ARMIES";
  ok = lab_key(s[..], 'h', 0); #assert s[0].siege && scenario_name(s[..]) == "SIEGE";
  b := bt(s[..]);
  #assert b[0].n == SIEGE_TOWN + SIEGE_CULT + 1 && s[0].pool == 0 && sl_count(s[..]) == 2;
  #assert team_name(s[..], 0) == "THE TOWN WATCH" && team_name(s[..], 1) == "THE CULT";
  kinds := 0; arch := -1; line := 0;
  for i: 0..<b[0].n {
    c := b[0].c[i];
    #assert c.npc != RS_NPC_NONE;
    kinds = kinds | (1 << c.npc);
    if c.npc == RS_NPC_ARCH { arch = i; #assert c.team == 1 && c.level == 17 && c.x == s[0].cols - 1; }
    if c.team == 0 { #assert c.x < s[0].cols / 3 && s[0].post[i] == c.y * s[0].cols + c.x; if siege_front(c.npc) { line = rs_max(line, c.x); } }
    else if c.npc != RS_NPC_ARCH { #assert c.x >= s[0].cols / 5 + 12; }   // 60 feet off the line or more
    // the casters stand behind the line
    if c.team == 0 && !siege_front(c.npc) { #assert c.x < s[0].cols / 5 - 1; }
  }
  #assert arch >= 0 && kinds == ((1 << RS_NPC_CULT_PRIEST) - 2);   // every stat block and role, once or more (a raid's Cult Priests aren't the Lab's)
  // the sliders: the watch's and the cult's own numbers; the address sets them
  #assert sl_name(s[..], SL_HEROES) == "DEFENDERS" && sl_name(s[..], SL_SKELETONS) == "CULTISTS" && sl_most(s[..], SL_SKELETONS) == SIEGE_CULT_MAX;
  ok = set_slider(s[..], SL_SKELETONS, 20); #assert ok && s[0].cult == 20 && s[0].town == 50 && bt(s[..])[0].n == 71;
  lab_message(s[..], HOST_PAGE, "url=http://x/worlds/5e-lab?siege=1&town=12&cult=30");
  #assert s[0].siege && s[0].town == 12 && s[0].cult == 30 && bt(s[..])[0].n == 43;
  ok = set_slider(s[..], SL_SKELETONS, 99999); #assert s[0].cult == SIEGE_CULT_MAX && s[0].asked[SL_SKELETONS] == 99999;
  ok = set_siege(s[..], 50, 50); #assert s[0].asked[SL_SKELETONS] == 0 && bt(s[..])[0].n == 101;
  // the scenario button cycles too, and Player mode picks among the Siege's kinds
  n := frame_at(s[..], 1600, 1000, 1, 0.016);
  sb := s[0].sbtn; #assert sb.x1 > sb.x0;
  ok = lab_pointer(s[..], (sb.x0 + sb.x1) / 2, (sb.y0 + sb.y1) / 2, 0, 0, 0);
  ok = lab_pointer(s[..], (sb.x0 + sb.x1) / 2, (sb.y0 + sb.y1) / 2, 2, 0, 0);
  #assert s[0].horde && !s[0].siege;
  ok = lab_key(s[..], 'h', 0); ok = lab_key(s[..], 'h', 0); #assert s[0].siege;
  for p: 0..<SIEGE_PICKS {
    s[0].pick = p; pick_hero(s[..]);
    me := s[0].me; #assert me >= 0 && bt(s[..])[0].c[me].npc == SIEGE_PICK[p];
    list: [SLOTS] Ab; nab := hero_abilities(s[..], me, list[..]);
    #assert nab >= 2 && nab <= SLOTS;
  }
  s[0].pick = 0; pick_hero(s[..]);
  list: [SLOTS] Ab; #assert hero_abilities(s[..], s[0].me, list[..]) == lw_abilities(list[..]);
}

#test "the Siege's tactics: the cult swarms, its leader stays back with its Arcanum, the watch holds its line" #steps 4000000000 {
  s: [1] Lab; s[0].siege = true; s[0].horde = false; s[0].town = 20; s[0].cult = 14;   // the interpreter's room; the page plays 50 and 50
  lab_start(s[..]);
  b := bt(s[..]);
  arch := -1; for i: 0..<b[0].n { if b[0].c[i].npc == RS_NPC_ARCH { arch = i; } }
  // Start the swarm within one action-beat Dash of the line. The default
  // 60-foot approach can be wiped out by ranged fire before engagement;
  // this fixture exercises the tactics after a successful approach.
  for i:0..<b[0].n { if b[0].c[i].team==1 && i!=arch { rs_place(b,i,b[0].c[i].x-6,b[0].c[i].y); } }
  spent := 0; met := false; back := true; held := 0; looked := 0;
  for f: 0..<5000 {
    step(s[..], f32(STEP));
    if s[0].over { break; }
    if f % 10 != 0 { continue; }
    b = bt(s[..]);
    if siege_engaged(s[..]) { met = true; }
    for i: 0..<b[0].n {
      cc := b[0].c[i..<i + 1]; c := cc[0..<1];
      if c[0].slots[1] < c[0].slots_max[1] { spent = spent | (1 << (c[0].npc * 2)); }
      if c[0].slots[2] < c[0].slots_max[2] || c[0].slots[3] < c[0].slots_max[3] || c[0].slots[4] < c[0].slots_max[4] || c[0].slots[5] < c[0].slots_max[5] { spent = spent | (1 << (c[0].npc * 2 + 1)); }
      if c[0].npc == RS_NPC_ARCH && (c[0].slots[6] < c[0].slots_max[6] || c[0].slots[7] < c[0].slots_max[7]) { spent = spent | (1 << 30); }
      // the leader keeps out of the watch's reach
      if c[0].npc == RS_NPC_ARCH && rs_up(c[0]) && met { foe := nearest_foe(s[..], i); if foe >= 0 && rs_feet_to(b, i, foe) < 15 { back = false; } }
      // the line holds: its standing are near their posts
      if c[0].team == 0 && siege_front(c[0].npc) && rs_up(c[0]) && met {
        looked += 1; p := s[0].post[i];
        if rs_feet(c[0].x, c[0].y, p % s[0].cols, p / s[0].cols) <= 15 { held += 1; }
      }
    }
  }
  #assert met;
  #assert (spent & (1 << (RS_NPC_MAGE * 2 + 1))) != 0;  // Fireball or Cone of Cold
  #assert (spent & (1 << (RS_NPC_FANATIC * 2 + 1))) != 0;  // Hold Person
  #assert (spent & (1 << 30)) != 0;                      // Circle of Death or Finger of Death
  #assert back;
  #assert looked > 0 && held * 10 >= looked * 8;
}

#test "the Siege's Priest heals the worst hurt with Healing Word and calls Spirit Guardians when the cult reaches it" #steps 400000000 {
  s: [1] Lab; s[0].siege = true; s[0].horde = false; s[0].town = 12; s[0].cult = 0;
  lab_start(s[..]);
  b := bt(s[..]);
  pr := -1; g := -1;
  for i: 0..<b[0].n { if b[0].c[i].npc == RS_NPC_PRIEST { pr = i; } if b[0].c[i].npc == RS_NPC_GUARD && g < 0 { g = i; } }
  b[0].c[g].hp = 3;
  rs_fresh(b, pr);
  priest_turn(s[..], pr);
  #assert b[0].c[pr].slots[1] == 2 && b[0].c[g].hp > 3;
  // two of the cult within 15 feet: Spirit Guardians (its 3rd-level slot)
  x := b[0].c[pr].x; y := b[0].c[pr].y;
  c1 := place_on(s[..], rs_siege_attacker(0, 1, SP_ELDRITCH_BLAST), x + 2, y);
  c2 := place_on(s[..], rs_siege_attacker(1, 1, SP_ELDRITCH_BLAST), x + 2, y + 1);
  rs_fresh(b, pr);
  priest_turn(s[..], pr);
  #assert b[0].c[pr].conc == SP_SPIRIT_GUARDIANS && b[0].c[pr].slots[3] == 0;
}

