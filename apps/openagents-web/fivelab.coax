}

#test "a Fireball's numbers fold: its three biggest float, and yours, and one gold total for the rest" #steps 400000000 {
  s: [1] Lab; s[0].siege = true; s[0].horde = false; s[0].town = 12; s[0].cult = 0;
  lab_start(s[..]);
  b := bt(s[..]);
  for i: 0..<FXS { s[0].fx[i].kind = 0; }
  s[0].seen = b[0].book[0].seq;
  mage := -1; for i: 0..<b[0].n { if b[0].c[i].npc == RS_NPC_MAGE { mage = i; } }
  // a Fireball on the watch's own line, from the Mage, by hand: one damage event for each it hits
  hit := 0;
  for j: 0..<b[0].n {
    if j == mage || hit >= 8 { continue; }
    l: [1] RsLine; rs_add_text(l[..], "fire");
    rs_tell(b, RS_EV_DAMAGE, SP_FIREBALL, mage, j, 10 + j, RS_FIRE, l[..]); hit += 1;
  }
  s[0].target = 0;
  take_events(s[..]);
  nums := 0; gold := 0;
  for i: 0..<FXS { f := s[0].fx[i]; if f.kind == FX_TEXT { if f.col.r == GOLD.r && f.col.g == GOLD.g { gold += 1; #assert f.text[f.n - 1] == 'T'; } else { nums += 1; } } }
  #assert hit == 8 && gold == 1 && nums == 4;   // the 3 biggest, and your target's
}

// 840 mouselook's word to the host, 841 the pointer held, 842 the reticle (percent), 843 the camera's turn, 844 its tilt (milliradians), 845 the bar slot under the pointer
lab_creator_probe :: (s:[]Lab,f:int)->int #export_c #effects(all) {if f>=900 {return xc_probe(s,f);}
  c := s[0].creator[..];if f==840 {return mlook.ml_host(c[0].ml[0]);}if f==841 {return ifx c[0].ml[0].locked then 1 else 0;}if f==842 {return cast(int)(c[0].ml[0].shown*100);}if f==843 {return cast(int)(c[0].yaw*1000);}if f==844 {return cast(int)(c[0].pitch*1000);}if f==845 {return s[0].xc[0].hover;}return cc.probe(s[0].creator[..],f);}

#test "creator restores a kept appearance before the host identifies its page" #steps 20000000 {
  s:[1]Lab;appearance:[1]cc.Creator;cc.ensure(appearance[..]);cc.change(appearance[..],1,1);
  buf:[64]u8;n:=cc.save(appearance[0],buf[..]);
  lab_message(s[..],4,cast(string)buf[0..<n]);
  #assert s[0].creator[0].configured && s[0].creator[0].outfit==3 && !s[0].started;
  lab_message(s[..],600,"url=http://127.0.0.1:8817/worlds/character-creator\n");
  #assert s[0].creator[0].on && s[0].started && s[0].creator[0].outfit==3;
}

// Optional browser mouse-button input. Existing pointer ABI and all other routes stay unchanged.
lab_pointer_buttons :: (s:[]Lab,x:f32,y:f32,phase:int,kind:int,id:int,button:int)->bool #export_c #effects(all) {
  if phase == 0 { s[0].creator[0].ml[0].touch = kind != 0; }
  // the bow (docs/verse/bow-combat.md): the right button held draws and its release looses; the left
  // button while drawing lets it down. The drag still turns the camera, which is the aim.
  if s[0].creator[0].on && kind==0 && s[0].creator[0].experimental {
    if button==2 && phase==0 {_:=xc_bow_begin(s,false);}
    else if button==2 && phase==2 {_:=xc_bow_loose(s);}
    else if button==0 && phase==0 && s[0].xc[0].draw[0].on && !s[0].xc[0].draw[0].self_loose && xc_bow_cancel(s) {return true;}
  }
  if s[0].creator[0].on && kind==0 {if s[0].creator[0].experimental && button!=1 && button!=2 && lab_respawn_pointer(s,x,y,phase,id) {return true;}if s[0].creator[0].experimental && button!=1 && button!=2 && xc_pointer(s,x,y,phase,id) {return true;}return cc.mouse_pointer(s[0].creator[..],x,y,phase,id,button);}
  return lab_pointer(s,x,y,phase,kind,id);
}

#test "character glade shadow draws include only casters for the tile being redrawn" {
  s: [1] Lab; s[0].creator[0].on = true; s[0].creator[0].shadow[0].on = true;
  s[0].bodies[0].draw_n = 4;
  // Player, village, instanced grass, and monster: their normal draw list stays intact.
  for i: 0..<4 { s[0].bodies[0].draws[i*4] = cast(u32) (100+i); s[0].bodies[0].draws[i*4+1] = 6; s[0].bodies[0].draws[i*4+2] = cast(u32) i; s[0].bodies[0].draws[i*4+3] = 1; }
  s[0].records[1*24+15] = 16; s[0].records[2*24+15] = 17; s[0].records[3*24+15] = 18;
  s[0].bodies[0].draws[2*4+2] = 196608;
  lab_shadow_select(s[..]);
  #assert s[0].shadow_n == 1 && s[0].shadow_draws[0] == 100 && s[0].bodies[0].draw_n == 4;
  s[0].creator[0].shadow[0].now = true; lab_shadow_select(s[..]);
  #assert s[0].shadow_n == 3 && s[0].shadow_draws[4] == 101 && s[0].shadow_draws[8] == 103;
  s[0].creator[0].on = false; lab_shadow_select(s[..]); #assert s[0].shadow_n == 4;
}

// The reaction's #transaction snapshots the whole battle, so this check's cost grows with RsCreature;
// the default budget ran out after Shapechange's fields (aethyr/rules/srd/shapechange.coax).
#test "experimental combat opportunity attacks precede the player's grid departure" #steps 40000000 {
  s:[1]Lab; b:=bt(s[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b,rs_fighter("Reactor",1,3),3,3); _=rs_add(b,rs_guard("Mover",0),4,3); rs_start_turn(b,1);
  b[0].c[1].hp=1; b[0].c[1].ac=10;
  #assert !lab_step(s[..],1,5,3) && b[0].c[1].x==4 && b[0].c[1].hp==0 && b[0].c[0].reacted;
}
#test "experimental combat opportunity selection respects allies and ordinary sight" {
  for mode:0..<3 {
    s:[1]Lab; b:=bt(s[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b,rs_guard("Reactor",ifx mode==0 then 0 else 1),3,3); _=rs_add(b,rs_fighter("Mover",0,3),4,3); rs_start_turn(b,1);
    if mode==1 { b[0].c[0].cond|=RS_BLINDED; }
    if mode==2 { b[0].c[1].cond|=RS_INVISIBLE; }
    hp:=b[0].c[1].hp;
    #assert lab_step(s[..],1,5,3) && !b[0].c[0].reacted && b[0].c[1].hp==hp;
  }
}

// Player mode offers each class's hotbar (abilities) on a LEVEL hero built as the Lab builds it
// (hero_for, then lab_prepare_bar). Every displayed spell must be one that hero can cast under the shared
// rules: accessible, selected or granted, and with its components supplied. (The level 17
// Warlock's bar is checked in fivelab-warlock.coax.)
#test "Player mode's displayed spells are castable by the hero the Lab builds for each class" #steps 2000000000 {
  for kl: 0..<13 {
    if kl == RS_MONSTER || kl == RS_WARLOCK { continue; }
    built := hero_for(kl, "You", 0, LEVEL);
    h: [1] RsCreature; h[0] = built; lab_prepare_bar(h[..]); hero := h[0];
    list: [SLOTS] Ab; n := abilities(kl, list[..]);
    #assert n > 0 && n <= SLOTS;
    for k: 0..<n {
      if list[k].kind != AB_SPELL { continue; }
      #assert rs_spell_ready(hero, list[k].sp) && rs_cast_components_ready(hero, list[k].sp);
      #assert list[k].lvl == 0 || hero.slots_max[list[k].lvl] > 0 || list[k].sp == SP_DIVINE_SMITE;
    }
  }
}

// Each spell the engine newly executes is playable from Player mode's hotbar in round mode: the
// Lab picks your hero, prepares its bar, and a press of the slot (use_ab) casts it, spending a
// slot for a leveled spell. Touch spells land on a foe within reach; heals find the hurt friend.
// Player mode for one class: each of its spells from Inflict Wounds to Shatter cast from the hotbar,
// counted. One Lab per call; the checks below take a class or two each, as a Lab is most of a
// check's traversal budget.
player_mode_casts :: (kl: int) -> int {
  played := 0;
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false;
  lab_start(s[..]);
  b := bt(s[..]);
  for p: 0..<12 { if ROSTER[p] == kl { s[0].pick = p; } }
  s[0].player = true; pick_hero(s[..]);
  me := s[0].me; #assert me >= 0 && b[0].c[me].klass == kl;
  list: [SLOTS] Ab; n := abilities(kl, list[..]);
  for k: 0..<n {
    a := list[k];
    if a.kind != AB_SPELL || a.sp < SP_INFLICT_WOUNDS || a.sp > SP_SHATTER { continue; }
    foe := nearest_foe(s[..], me); #assert foe >= 0;
    e := free_near(s[..], b[0].c[me].x + (ifx rs_spell(a.sp).range_ft == 5 then 1 else 3), b[0].c[me].y);
    rs_place(b, foe, e % s[0].cols, e / s[0].cols);
    b[0].c[foe].hp = b[0].c[foe].hp_max; b[0].c[me].hp = b[0].c[me].hp_max;
    if a.tg == TG_ALLY { w := nearest_friend(s[..], me); #assert w >= 0; b[0].c[w].hp = 1; }
    rs_start_turn(b, me);
    seq := b[0].book[0].seq; slots := ifx a.lvl > 0 then b[0].c[me].slots[a.lvl] else 0;
    use_ab(s[..], me, a, foe);
    was_cast := false;
    for q: 0..<rs_min(b[0].book[0].count, b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], q); if ev.kind == RS_EV_CAST && ev.spell == a.sp && ev.by == me { was_cast = true; } }
    #assert was_cast;
    if a.lvl > 0 { #assert b[0].c[me].slots[a.lvl] == slots - 1; }
    rs_end_turn(b, me);
    played += 1;
  }
  return played;
}
#test "Player mode casts Inflict Wounds, Acid Splash, Magic Missile, Mass Healing Word and Shatter from the hotbar: Wizard and Sorcerer" #steps 2000000000 {
  w := player_mode_casts(RS_WIZARD); #assert w == 1;
  so := player_mode_casts(RS_SORCERER); #assert so == 3;   // Magic Missile each, and the Sorcerer's Acid Splash and Shatter
}
#test "Player mode casts Inflict Wounds, Acid Splash, Magic Missile, Mass Healing Word and Shatter from the hotbar: Bard and Cleric" #steps 2000000000 {
  #assert player_mode_casts(RS_BARD) == 2 && player_mode_casts(RS_CLERIC) == 1;   // Shatter, Mass Healing Word, Inflict Wounds
}
