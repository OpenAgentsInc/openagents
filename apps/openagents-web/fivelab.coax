// 5E Lab, openagents.com/worlds/5e-lab (unlisted): a bare grid of 5-foot squares where
// characters play the SRD 5e rules against each other, so the shared engine
// (aethyr/rules/srd/, docs/dnd/README.md) can be watched at work. Two sides, each
// with two of every one of the twelve SRD 5e classes at level 3, and an army of
// Skeletons fight on the real-time clock: every creature's turn comes round on
// the beat, staggered by initiative, and the log shows each roll. Each class
// decides with a small routine here; the rules are all the engine's.
//
// Two views, V switches them. The glade (the default): gpu/fivelab.coax's bg_fs traces the
// battle in 3D in Everglade's painterly look, the druids standing on their squares in a
// clearing; drag (or the arrow keys) orbits the camera, Shift-drag, WASD or two fingers pan it,
// the wheel, a pinch or + and - zoom it. Flat: bg_fs draws the bare
// grid and the tokens and areas are strokes. Either way the labels, effects and text are fx
// strokes (font.coax) and bg_fs puts the log's glass under them.
//   coax/bin/coax test apps/openagents-web/fivelab.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.

#load "font.coax";
#load "../../aethyr/loop.coax";
#load "../../aethyr/rules/srd/battle.coax";
#load "../../aethyr/shot.coax" as ash;   // the camera's orbit is Aethyr's (book chapter 10)
#load "../../aethyr/space.coax" as asp;
#load "../../aethyr/fx/puff.coax";   // the glade's spell and combat effects (book chapter 72)
#load "fivelab-bodies.coax" as figs;   // the figures: Everglade's Quaternius people, skinned from baked clips

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 180000;
UNIFORM_FLOATS :: 1768;
TOKENS3 :: 216;   // the glade's tokens (gpu/fivelab.coax FIVELAB_TOKENS)
U_SQUARES :: 900;   // the grid's squares, the token on each (gpu/fivelab.coax FIVELAB_SQUARES)
U_GRID :: 4; U_CELLS :: 8; U_PANEL :: 12;
U_EYE :: 16; U_FWD :: 20; U_RIGHT :: 24; U_UP :: 28; U_SUN :: 32; U_TOKENS :: 36; U_ZONES :: 1700; U_BOUNDS :: 1764;
SQ :: 1.524;   // a 5-foot square, metres
HOLD_W :: 1; HOLD_A :: 2; HOLD_S :: 4; HOLD_D :: 8; HOLD_LEFT :: 16; HOLD_RIGHT :: 32; HOLD_UP :: 64; HOLD_DOWN :: 128; HOLD_IN :: 256; HOLD_OUT :: 512;
DIST :: 40.0; PIVOT_Z :: 0.6; ZOOM_NEAR :: 6.0; ZOOM_FAR :: 140.0;   // the camera's orbit: start, and how near and far it zooms
VIEW_FLAT :: 0; VIEW_GLADE :: 1;
// The time adapters (docs/dnd/README.md, "The time adapter"): the SRD's 6-second rounds, or action
// combat in the way of the Neverwinter MMO: a turn's worth every 1.5 seconds, spent slots, Rages and
// Focus Points back on a cooldown (`cost cooldown 9`), the same dice and Armor Class.
MODE_ROUNDS :: 0; MODE_ACTION :: 1;
ACTION_BEAT :: 1.5; ACTION_RECHARGE :: 9.0;

STEP :: 0.0166666667;
LAB_STEP_NS :: 16666667;
LAB_FRAME_NS :: 100000000;
OUTBOX_CAP :: 64;
ACT_NAVIGATE :: 1;
KEY_SHIFT :: -13; KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;

COLS :: 40; ROWS :: 20;
FAST :: 4.0;
// Three sides. Twenty-four a side, all level 3, two of each of the twelve SRD 5e classes (the Circle
// of Moss against the Ember Pact), and an army of 160 Skeletons (the SRD's stat block) in the middle
// from the start as the Restless Dead, against everyone.
SIDE :: 24; HEROES :: 48; SKELETONS :: 160; PEOPLE :: 208; CASTERS :: 12; TEAMS :: 3;
LEVEL :: 6;
// The twelve SRD 5e classes as they stand: the casters' two back files, then the front two; each
// side fields every class twice.
ROSTER :: [12] int.[RS_DRUID, RS_WIZARD, RS_WARLOCK, RS_SORCERER, RS_BARD, RS_CLERIC,
                    RS_FIGHTER, RS_PALADIN, RS_BARBARIAN, RS_MONK, RS_ROGUE, RS_RANGER];
ARMY_X :: 12; ARMY_Y :: 5; ARMY_COLS :: 16;   // the Restless Dead stand sixteen wide, ten deep, mid-glade
TEAM_NAME :: [3] string.["CIRCLE OF MOSS", "THE EMBER PACT", "THE RESTLESS DEAD"];
team_name :: (s: [] Lab, t: int) -> string { if s[0].horde && t == 0 { return "THE LIVING"; } return TEAM_NAME[t]; }
NAMES :: [48] string.["Rowan", "Briar", "Fern", "Hazel", "Alder", "Willow", "Sorrel", "Linden", "Moss", "Ivy", "Sen", "Lio",
                       "Mara", "Tam", "Ishu", "Rook", "Wen", "Kai", "Juna", "Pell", "Oro", "Suri", "Tavi", "Yen",
                       "Mordra", "Vesk", "Sallow", "Grimsby", "Ilse", "Nyx", "Corvin", "Morrow", "Sable", "Vex", "Thorn", "Gorr",
                       "Brakka", "Ulf", "Hild", "Torva", "Kesh", "Bjorn", "Rask", "Dagna", "Orm", "Sigra", "Hrolf", "Ygg"];

LOG_LINES :: 40;
LINE_CAP :: 96;
FXS :: 32;
FX_BOLT :: 1; FX_FLASH :: 2; FX_TEXT :: 3; FX_RING :: 4;

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
P3 :: struct { x: f32; y: f32; z: f32; }
Col :: struct { r: f32; g: f32; b: f32; }
WHITE :: Col.{r = 0.9, g = 0.92, b = 0.96};
DIM :: Col.{r = 0.52, g = 0.55, b = 0.6};
FAINT :: Col.{r = 0.28, g = 0.3, b = 0.34};
RED :: Col.{r = 1.0, g = 0.25, b = 0.22};
GREEN :: Col.{r = 0.4, g = 1.0, b = 0.5};
VIOLET :: Col.{r = 0.75, g = 0.48, b = 1.0};
GOLD :: Col.{r = 1.0, g = 0.8, b = 0.35};
GREEN_FX :: FxV.{x = 0.4, y = 1.0, z = 0.45};
CYAN :: Col.{r = 0.35, g = 0.9, b = 1.0};
TEAM_COL :: [3] Col.[Col.{r = 0.45, g = 0.95, b = 0.55}, Col.{r = 0.62, g = 0.85, b = 1.0}, Col.{r = 0.9, g = 0.86, b = 0.74}];

Line :: struct { text: [LINE_CAP] u8; n: int; col: Col; }
Fx :: struct { kind: int; ax: f32; ay: f32; bx: f32; by: f32; t0: f32; life: f32; col: Col; text: [12] u8; n: int; }

Lab :: struct {
  started: bool;
  battle: [1] RsBattle;
  seen: int;                       // the battle log's events already shown
  seed: u64;
  round: int;
  wins: [3] int;
  over: bool; over_t: f32; winner: int;
  dx: [RS_MAX] f32; dy: [RS_MAX] f32;   // where each token is drawn, in squares
  acted: [RS_MAX] f32;             // when each last took its turn
  fell: [RS_MAX] f32;              // in the Horde, when each of the dead fell (0: standing)
  pool: int; raised: int;          // the Horde: the dead still to come, and how many have come
  lines: [LOG_LINES] Line; line_n: int;
  fx: [FXS] Fx; fx_at: int;
  puffs: [1] FxPuffs; fx_last: f32;   // the glade's effects as puffs (aethyr/fx/puff.coax), and the clock they last saw
  clock: f32;                      // the drawn clock
  pace: FrameClock;
  paused: bool; fast: bool;
  golden: bool; golden_ran: bool;
  width: f32; height: f32; dpr: f32;
  portrait: bool;
  gx: f32; gy: f32; cell: f32;
  panel: Rect; back: Rect; flip: Rect; modal: Rect;
  mode: int = MODE_ACTION;
  // Player mode (P): you play one hero of the Living, the class picked from the bar along the top
  player: bool; pick: int = 6; me: int = -1; act: int = ACT_ATTACK; target: int = -1;
  pbtn: Rect; picks: [12] Rect; slots: [SLOTS] Rect; down_x: f32; down_y: f32;
  horde: bool = true;   // the Horde (the default): every hero on one side, the dead running in from the edges
  skeletons: int = SKELETONS;   // the Restless Dead's number (the tests field fewer, for the interpreter)
  pressing: int;
  // the glade's camera: an orbit round the clearing, and what it makes this frame
  view: int = VIEW_GLADE;
  yaw: f32 = 0; pitch: f32 = 0.6; dist: f32 = DIST;
  px: f32 = 0; pz: f32 = PIVOT_Z;   // the point it orbits, on the ground (metres)
  dragging: bool; drag_x: f32; drag_y: f32;
  panning: bool; shift: bool;       // Shift held: a drag pans
  fps: f32; fps_n: int; fps_t: f32;   // frames a second, counted over each half second
  held: int; vx: f32; vz: f32; vyaw: f32; vpitch: f32; vzoom: f32;   // keys held (HOLD_*), and how the camera flies
  fingers: int; fing_id: [2] int; fing_x: [2] f32; fing_y: [2] f32;   // touches down, for a pinch
  eye: P3; fwd: P3; right: P3; up: P3; focal: f32; cx: f32; cy: f32;
  // the figures (fivelab-bodies.coax): their playback, and the squares the Horde filled afresh
  bodies: [1] figs.Bodies; fresh: [RS_MAX] bool;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
}

// ---- small things

GAP :: 0.5; SPACE :: 1.2;
lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }

text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
put :: (buf: [] u8, at: int, text: string) -> int { return rs_put(buf, at, text); }
put_int :: (buf: [] u8, at: int, v: int) -> int { return rs_put_int(buf, at, v); }
bt :: (s: [] Lab) -> [] RsBattle { return s[0].battle[..]; }
dice :: (s: [] Lab) -> [] RsDice { return s[0].battle[0].dice[..]; }

// A figure's look in the glade (gpu/fivelab.coax): its class's, plus 16 for each team past the first.
look_of :: (klass: int) -> int {
  if klass == RS_WARLOCK { return 1; }
  if klass == RS_BARBARIAN { return 2; }
  if klass == RS_MONK { return 3; }
  if klass == RS_MONSTER { return 4; }
  if klass == RS_WIZARD { return 5; }
  if klass == RS_BARD { return 6; }
  if klass == RS_CLERIC { return 7; }
  if klass == RS_FIGHTER { return 8; }
  if klass == RS_PALADIN { return 9; }
  if klass == RS_RANGER { return 10; }
  if klass == RS_ROGUE { return 11; }
  if klass == RS_SORCERER { return 12; }
  return 0;
}
spell_col :: (sp: int) -> Col {
  if sp == SP_PRODUCE_FLAME || sp == SP_FLAME_HURL { return Col.{r = 1.0, g = 0.55, b = 0.15}; }
  if sp == SP_STARRY_WISP { return Col.{r = 1.0, g = 0.95, b = 0.6}; }
  if sp == SP_POISON_SPRAY { return Col.{r = 0.6, g = 1.0, b = 0.3}; }
  if sp == SP_CURE_WOUNDS || sp == SP_HEALING_WORD { return GREEN; }
  if sp == SP_THUNDERWAVE { return Col.{r = 0.55, g = 0.75, b = 1.0}; }
  if sp == SP_ENTANGLE { return Col.{r = 0.35, g = 0.85, b = 0.3}; }
  if sp == SP_FAERIE_FIRE { return VIOLET; }
  if sp == SP_CHILL_TOUCH { return Col.{r = 0.6, g = 0.92, b = 1.0}; }
  if sp == SP_RAY_OF_SICKNESS { return Col.{r = 0.75, g = 0.95, b = 0.2}; }
  if sp == SP_FALSE_LIFE { return Col.{r = 0.95, g = 0.25, b = 0.35}; }
  if sp == SP_RAY_OF_ENFEEBLEMENT { return Col.{r = 0.6, g = 0.55, b = 0.85}; }
  if sp == SP_BLINDNESS { return Col.{r = 0.4, g = 0.45, b = 1.0}; }
  if sp == SP_ELDRITCH_BLAST { return Col.{r = 0.85, g = 0.35, b = 1.0}; }
  if sp == SP_HEX { return Col.{r = 0.55, g = 0.2, b = 0.75}; }
  if sp == SP_HOLD_PERSON { return GOLD; }
  if sp == SP_SCORCHING_RAY { return Col.{r = 1.0, g = 0.4, b = 0.12}; }
  if sp == SP_VICIOUS_MOCKERY { return Col.{r = 1.0, g = 0.5, b = 0.8}; }
  if sp == SP_SACRED_FLAME { return Col.{r = 1.0, g = 0.92, b = 0.6}; }
  if sp == SP_GUIDING_BOLT { return Col.{r = 0.95, g = 0.95, b = 1.0}; }
  if sp == SP_DIVINE_SMITE { return Col.{r = 1.0, g = 0.85, b = 0.4}; }
  if sp == SP_HUNTERS_MARK { return Col.{r = 0.55, g = 0.95, b = 0.35}; }
  if sp == SP_FIRE_BOLT { return Col.{r = 1.0, g = 0.48, b = 0.1}; }
  if sp == SP_SHIELD { return CYAN; }
  if sp == SP_FIREBALL { return Col.{r = 1.0, g = 0.5, b = 0.12}; }
  if sp == SP_SPIRIT_GUARDIANS { return Col.{r = 1.0, g = 0.95, b = 0.7}; }
  if sp == SP_CALL_LIGHTNING || sp == SP_CALL_BOLT { return Col.{r = 0.7, g = 0.85, b = 1.0}; }
  if sp == SP_HYPNOTIC_PATTERN { return Col.{r = 0.95, g = 0.5, b = 1.0}; }
  if sp < 0 { return Col.{r = 0.5, g = 0.9, b = 0.4}; }
  return WHITE;
}

// ---- the log

add_line :: (s: [] Lab, t: string, c: Col) {
  if s[0].line_n == LOG_LINES {
    for i: 1..<LOG_LINES { s[0].lines[i - 1] = s[0].lines[i]; }
    s[0].line_n -= 1;
  }
  l: Line;
  l.n = put(l.text[..], 0, t); l.col = c;
  s[0].lines[s[0].line_n] = l;
  s[0].line_n += 1;
}
add_fx :: (s: [] Lab, f: Fx) {
  g := f; g.t0 = s[0].battle[0].clock;
  s[0].fx[s[0].fx_at] = g;
  s[0].fx_at = (s[0].fx_at + 1) % FXS;
}
// What the battle told since the last look: into the log, and into effects on the grid.
take_events :: (s: [] Lab) {
  if s[0].battle[0].book[0].seq == s[0].seen { return; }
  book := s[0].battle[0].book[..];
  fresh := rs_min(book[0].seq - s[0].seen, book[0].count);
  s[0].seen = book[0].seq;
  k := fresh - 1;
  rep_by := -1; rep_spell := -1; rep_t: f32 = -1; rep_n := 0;
  while k >= 0 {
    e := rs_recent_at(book, k);
    k -= 1;
    t := cast(string) e.text[0..<e.text_n];
    c := DIM;
    if e.kind == RS_EV_CAST { c = WHITE; }
    if e.kind == RS_EV_DAMAGE { c = Col.{r = 1.0, g = 0.55, b = 0.4}; }
    if e.kind == RS_EV_HEAL || e.kind == RS_EV_UP { c = GREEN; }
    if e.kind == RS_EV_CONDITION { c = VIOLET; }
    if e.kind == RS_EV_DOWN || e.kind == RS_EV_DEATH { c = RED; }
    if e.kind == RS_EV_END || e.kind == RS_EV_STABLE { c = FAINT; }
    if e.text_n > 0 { add_line(s, t, c); }
    f: Fx;
    if e.kind == RS_EV_CAST && e.to >= 0 && e.to != e.by {
      f.kind = FX_BOLT; f.life = 0.55; f.col = spell_col(e.spell);
      f.ax = f32(s[0].battle[0].c[e.by].x); f.ay = f32(s[0].battle[0].c[e.by].y);
      f.bx = f32(s[0].battle[0].c[e.to].x); f.by = f32(s[0].battle[0].c[e.to].y);
      add_fx(s, f);
    }
    if e.kind == RS_EV_ZONE {
      f.kind = FX_FLASH; f.life = 0.7; f.col = spell_col(e.spell);
      f.ax = f32(e.x); f.ay = f32(e.y); f.bx = f32(e.x + e.amount); f.by = f32(e.y + e.amount);
      add_fx(s, f);
    }
    if e.kind == RS_EV_DAMAGE || e.kind == RS_EV_HEAL || e.kind == RS_EV_MISS {
      f.kind = FX_TEXT; f.life = 1.2;
      f.col = ifx e.kind == RS_EV_HEAL then GREEN else ifx e.kind == RS_EV_MISS then DIM else RED;
      f.ax = f32(s[0].battle[0].c[e.to].x); f.ay = f32(s[0].battle[0].c[e.to].y);
      if e.kind == RS_EV_MISS { f.n = put(f.text[..], 0, "MISS"); }
      else { f.n = put(f.text[..], 0, ifx e.kind == RS_EV_HEAL then "+" else "-"); f.n = put_int(f.text[..], f.n, e.amount); }
      add_fx(s, f);
    }
    if e.kind == RS_EV_CONDITION && e.to >= 0 {
      f.kind = FX_RING; f.life = 0.8; f.col = VIOLET;
      f.ax = f32(s[0].battle[0].c[e.to].x); f.ay = f32(s[0].battle[0].c[e.to].y);
      add_fx(s, f);
    }
    // the glade's effects: rays and bolts of one cast leave one after another
    if e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS {
      if e.by == rep_by && e.spell == rep_spell && e.at - rep_t < 0.01 && e.spell >= 0 { rep_n = rs_min(rep_n + 1, 4); } else { rep_n = 0; }
      rep_by = e.by; rep_spell = e.spell; rep_t = e.at;
    }
    cue_event(s, e);
    fx_event(s, e, f32((book[0].seq - k) % 8192) * 0.37 + 0.11, e.at + ifx e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS then f32(rep_n) * 0.14 else 0);
  }
}
// One battle event as the figures' clips: a blow swings, a cast or a shot plays the spell clip, a
// hurt figure is knocked back (fivelab-bodies.coax figs.bd_cue).
cue_event :: (s: [] Lab, e: RsEvent) {
  b := bt(s);
  if e.by < 0 || e.by >= b[0].n { return; }
  now := b[0].clock;
  aimed := e.to >= 0 && e.to < b[0].n && e.to != e.by;
  tx := ifx aimed then wx(s[0].dx[e.to]) else 0.0f32; tz := ifx aimed then wz(s[0].dy[e.to]) else 0.0f32;
  if (e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS) && aimed {
    melee := e.spell < 0 && rs_feet_to(b, e.by, e.to) <= 5;
    figs.bd_cue(s[0].bodies[..], e.by, ifx melee then figs.BD_SLASH else figs.BD_SPELL, now, tx, tz, true);
    return;
  }
  if e.kind == RS_EV_CAST { figs.bd_cue(s[0].bodies[..], e.by, figs.BD_SPELL, now, tx, tz, aimed); return; }
  if e.kind == RS_EV_DAMAGE && e.to >= 0 && e.to < b[0].n && b[0].c[e.to].hp > 0 { figs.bd_cue(s[0].bodies[..], e.to, figs.BD_KNOCK, now, 0, 0, false); }
}
// The figures this frame, from the battle: each creature's look, square and state.
put_bodies :: (s: [] Lab) {
  b := s[0].battle[0];
  for i: 0..<figs.BD_SLOTS {
    if i >= b.n { figs.bd_clear(s[0].bodies[..], i); continue; }
    cr := b.c[i];
    marks := 0;
    if rs_has(cr, RS_RESTRAINED) { marks += 1; }
    if rs_has(cr, RS_POISONED) { marks += 2; }
    if rs_has(cr, RS_BLINDED) { marks += 4; }
    if rs_effect(cr, EF_ENFEEBLED) { marks += 8; }
    if cr.temp > 0 { marks += 16; }
    if rs_has(cr, RS_PARALYZED) { marks += 32; }
    if rs_effect(cr, EF_HEX) { marks += 64; }
    state := ifx cr.dead then 2 else ifx cr.hp == 0 then 1 else 0;
    // the second of each class, and every other skeleton, looks a little different
    v := ifx cr.klass == RS_MONSTER then (i * 7 / 3) % 2 else (i / 12) % 2;
    figs.bd_put(s[0].bodies[..], i, s[0].fresh[i], look_of(cr.klass), v, wx(s[0].dx[i]), wz(s[0].dy[i]), state, f32(marks), ifx cr.outlined_by >= 0 then 1.0f32 else 0.0f32, b.clock);
    s[0].fresh[i] = false;
  }
  figs.bd_frame(s[0].bodies[..], b.clock);
}
// The pack's catalog arrived (fivelab-face.c): the figures' parts.
lab_catalog :: (s: [] Lab, text: string) #export_c { figs.bd_catalog(s[0].bodies[..], text); }
// The clips baked into the bake store, once (fivelab-face.c).
lab_bake :: (d: [] figs.People, out: [] f32) #export_c { figs.people_load(d); figs.bd_bake(d, out); }
// The figures' instances for the frame (the objects store) and their draws; the count of draws.
lab_scene :: (s: [] Lab, out: [] f32) -> int #export_c {
  if !s[0].started || s[0].view != VIEW_GLADE { s[0].bodies[0].draw_n = 0; return 0; }
  c := figs.BdCam.{ex = s[0].eye.x, ey = s[0].eye.y, ez = s[0].eye.z, fx = s[0].fwd.x, fy = s[0].fwd.y, fz = s[0].fwd.z,
              rx = s[0].right.x, ry = s[0].right.y, rz = s[0].right.z, ux = s[0].up.x, uy = s[0].up.y, uz = s[0].up.z,
              focal = s[0].focal, cx = s[0].cx, cy = s[0].cy, w = s[0].width, h = s[0].height};
  r := figs.bd_build(s[0].bodies[..], c, out);
  // none in view: one empty draw still, so host.js draws the effects after the scene
  if s[0].bodies[0].draw_n == 0 && s[0].bodies[0].ready {
    for k: 0..<4 { s[0].bodies[0].draws[k] = 0; }
    s[0].bodies[0].draw_n = 1;
  }
  return s[0].bodies[0].draw_n;
}
// Where a figure stands in the glade (its square's middle), `lift` metres up.
fx_spot :: (s: [] Lab, i: int, lift: f32) -> FxV { return fxp_v(wx(f32(s[0].battle[0].c[i].x)), lift, wz(f32(s[0].battle[0].c[i].y))); }
// A spell's light for its effect, linear and bright.
fx_col :: (sp: int) -> FxV { c := spell_col(sp); return fxp_v(c.r, c.g, c.b); }
// True for a spell that makes an attack roll: its effect flies with each attack, not with the cast.
fx_attacks :: (sp: int) -> bool {
  if sp < 0 { return false; }
  sd := rs_spell(sp);
  for q: 0..<sd.step_n { if sd.steps[q].kind == RS_S_ATTACK { return true; } }
  return false;
}
fx_cause :: (s: [] Lab, recipe: int, seed: f32, t0: f32, from: FxV, to: FxV, col: FxV, big: f32, reach: f32) {
  c := FxCause.{recipe = recipe, seed = seed, t0 = t0, from = from, to = to, col = col, big = big, reach = reach};
  slot := fxp_start(s[0].puffs[..], c, s[0].battle[0].clock);
}
// One battle event as the glade's effect (aethyr/fx/puff.coax's recipes).
fx_event :: (s: [] Lab, e: RsEvent, seed: f32, t0: f32) {
  b := bt(s);
  if e.by < 0 || e.by >= b[0].n { return; }
  hand := fx_spot(s, e.by, 1.5); hand.x += 0.3;
  aimed := e.to >= 0 && e.to < b[0].n && e.to != e.by;
  if e.feat != RS_FT_NONE && fx_feat(s, e, seed, t0) { return; }
  if (e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS) && aimed {
    at := fx_spot(s, e.to, 1.1);
    if e.kind == RS_EV_MISS { at.x += fxp_sym(seed, 0, 0) * 0.9; at.z += fxp_sym(seed, 0, 1) * 0.9; at.y = 0.6; }
    if e.spell >= 0 {
      sp := e.spell; col := fx_col(sp);
      fiery := sp == SP_FIRE_BOLT || sp == SP_PRODUCE_FLAME || sp == SP_FLAME_HURL || sp == SP_SCORCHING_RAY;
      if fiery { fx_cause(s, FXR_FIREBOLT, seed, t0, hand, at, col, ifx e.damage == 1 then 1.5 else 1, 1); }
      else if sp == SP_STARRY_WISP { fx_cause(s, FXR_STAR, seed, t0, hand, at, col, 1, 1); }
      else { fx_cause(s, FXR_STREAK, seed, t0, hand, at, col, ifx sp == SP_ELDRITCH_BLAST || sp == SP_GUIDING_BOLT then 1.25 else 0.9, 1); }
      return;
    }
    if rs_feet_to(b, e.by, e.to) > 5 { fx_cause(s, FXR_ARROW, seed, t0, hand, at, fxp_v(0.9, 0.8, 0.6), 1, 1); return; }
    if e.kind == RS_EV_ATTACK {
      crit := e.damage == 1;
      fx_cause(s, FXR_HIT, seed, t0, fx_spot(s, e.by, 1.1), at, ifx crit then fxp_v(1.0, 0.75, 0.35) else fxp_v(1.0, 0.85, 0.6), ifx crit then 1.8 else 1, 1);
    }
    return;
  }
  if e.kind == RS_EV_CAST && e.spell >= 0 && !fx_attacks(e.spell) {
    sp := e.spell; col := fx_col(sp);
    if e.to >= 0 && e.to < b[0].n {
      at := fx_spot(s, e.to, 1.1);
      if sp == SP_SACRED_FLAME { fx_cause(s, FXR_COLUMN, seed, t0, hand, at, col, 1, 1); return; }
      feet := fx_spot(s, e.to, 0);
      if sp == SP_HEX || sp == SP_HUNTERS_MARK { fx_cause(s, FXR_MARK, seed, t0, hand, at, col, 1, 1); return; }
      if sp == SP_SHIELD { fx_cause(s, FXR_BARRIER, seed, t0, hand, feet, col, 1, 1); return; }
      // Divine Smite: bigger for each slot level over the first
      if sp == SP_DIVINE_SMITE { fx_cause(s, FXR_SMITE, seed, t0, fx_spot(s, e.by, 1.1), at, col, 1 + 0.3 * f32(rs_max(e.amount, 1) - 1), 1); return; }
      if sp == SP_HOLD_PERSON { fx_cause(s, FXR_BIND, seed, t0, hand, feet, col, 1, 1); return; }
      if sp == SP_BLINDNESS { fx_cause(s, FXR_VEIL, seed, t0, hand, feet, col, 1, 1); return; }
      if sp == SP_VICIOUS_MOCKERY { fx_cause(s, FXR_MOCKERY, seed, t0, hand, fx_spot(s, e.to, 1.7), MOCK_FX, 1, 1); return; }
      if sp == SP_FALSE_LIFE && e.to == e.by { fx_cause(s, FXR_DRAIN, seed, t0, hand, feet, col, 1, 1); return; }
      if sp == SP_PRODUCE_FLAME && e.to == e.by { fx_cause(s, FXR_KINDLE, seed, t0, hand, hand, col, 1, 1); return; }
      if sp == SP_CURE_WOUNDS || sp == SP_HEALING_WORD || e.to == e.by { return; }   // the healing shows on its HEAL
      fx_cause(s, FXR_STREAK, seed, t0, hand, at, col, 0.8, 1);
    }
    return;
  }
  if e.kind == RS_EV_CAST && e.spell < 0 && e.to < 0 {
    // a Channel Divinity (Turn Undead, Preserve Life) or Land's Aid: a ring out over the ground
    k := b[0].c[e.by].klass;
    if k == RS_CLERIC { fx_cause(s, FXR_HALO, seed, t0, hand, fx_spot(s, e.by, 0), fxp_v(1.0, 0.9, 0.55), 1, 9.1); }
    if k == RS_DRUID { fx_cause(s, FXR_BLOOM, seed, t0, hand, fx_spot(s, e.by, 0), fxp_v(0.45, 0.95, 0.4), 1, 4.6); }
    return;
  }
  if e.kind == RS_EV_ZONE {
    sp := e.spell; col := fx_col(sp);
    mid := f32(e.amount - 1) / 2;
    centre := fxp_v(wx(f32(e.x) + mid), 0.9, wz(f32(e.y) + mid));
    reach := f32(e.amount) * f32(SQ) / 2;
    if sp == SP_FIREBALL { fx_cause(s, FXR_FIREBALL, seed, t0, hand, centre, col, 1, reach); return; }
    if sp == SP_THUNDERWAVE { fx_cause(s, FXR_SHOCK, seed, t0, hand, centre, col, 1, reach); return; }
    if sp == SP_HYPNOTIC_PATTERN { fx_cause(s, FXR_SHIMMER, seed, t0, hand, centre, col, 1, reach); return; }
    if sp == SP_ENTANGLE || sp == SP_FAERIE_FIRE { fx_cause(s, FXR_BLOOM, seed, t0, hand, centre, col, 1, reach); return; }
    if sp == SP_CALL_LIGHTNING || sp == SP_CALL_BOLT { fx_cause(s, FXR_LIGHTNING, seed, t0, hand, centre, col, 1.2, reach); return; }
    if sp == SP_SPIRIT_GUARDIANS { fx_cause(s, FXR_ORBIT, seed, t0, hand, fx_spot(s, e.by, 0), col, 1, reach); return; }
    fx_cause(s, FXR_SHOCK, seed, t0, hand, centre, col, 1, reach);
    return;
  }
  if !(e.to >= 0 && e.to < b[0].n) { return; }
  if e.kind == RS_EV_HEAL { fx_cause(s, FXR_HEAL, seed, t0, hand, fx_spot(s, e.to, 0), GREEN_FX, 1, 1); return; }
  // Guiding Bolt's light left on its target: the next attack roll against it has Advantage
  if e.kind == RS_EV_CONDITION && e.spell == SP_GUIDING_BOLT { fx_cause(s, FXR_GLIMMER, seed, t0, hand, fx_spot(s, e.to, 0), fx_col(SP_GUIDING_BOLT), 1, 1); return; }
  if e.kind == RS_EV_DAMAGE && e.spell == SP_SPIRIT_GUARDIANS { fx_cause(s, FXR_COLUMN, seed, t0, hand, fx_spot(s, e.to, 1.1), fx_col(SP_SPIRIT_GUARDIANS), 0.6, 1); return; }
  if e.kind == RS_EV_DEATH && b[0].c[e.to].klass == RS_MONSTER { fx_cause(s, FXR_BONES, seed, t0, hand, fx_spot(s, e.to, 0), fxp_v(0.86, 0.83, 0.74), 1, 1); return; }
  if e.kind == RS_EV_DOWN || e.kind == RS_EV_DEATH { fx_cause(s, FXR_DUST, seed, t0, hand, fx_spot(s, e.to, 0), fxp_v(0.5, 0.45, 0.36), 1, 1); return; }
  if e.kind == RS_EV_CONDITION && e.to == e.by && b[0].c[e.by].klass == RS_BARBARIAN && b[0].c[e.by].raging {
    fx_cause(s, FXR_EMBERS, seed, t0, hand, fx_spot(s, e.by, 0), fxp_v(1.0, 0.18, 0.08), 1, 1);
  }
}

MOCK_FX :: FxV.{x = 0.8, y = 0.35, z = 1.0};   // a psychic burst's purple
// A class feature's event as its effect (aethyr/fx/abilities.coax), from the feature the engine
// says it is (RsEvent.feat). True when it drew one, or the feature's look is drawn by another of
// its events (the healing a feature's own cast already shows).
fx_feat :: (s: [] Lab, e: RsEvent, seed: f32, t0: f32) -> bool {
  b := bt(s);
  f := e.feat; i := e.by;
  hand := fx_spot(s, i, 1.5); hand.x += 0.3;
  feet := fx_spot(s, i, 0);
  on := e.to >= 0 && e.to < b[0].n;
  if f == RS_FT_ACTION_SURGE { fx_cause(s, FXR_SURGE, seed, t0, hand, feet, fxp_v(1.0, 0.78, 0.3), 1, 1); return true; }
  if f == RS_FT_SECOND_WIND || f == RS_FT_WHOLENESS || f == RS_FT_LAY_ON_HANDS {
    if e.kind == RS_EV_HEAL { return true; }   // its cast shows it
    if f == RS_FT_SECOND_WIND { fx_cause(s, FXR_BREATH, seed, t0, hand, feet, fxp_v(0.7, 1.0, 0.78), 1, 1); }
    if f == RS_FT_WHOLENESS { fx_cause(s, FXR_WHOLENESS, seed, t0, hand, feet, fxp_v(1.0, 0.9, 0.65), 1, 1); }
    if f == RS_FT_LAY_ON_HANDS && on { fx_cause(s, FXR_LAY, seed, t0, hand, fx_spot(s, e.to, 1.1), fxp_v(1.0, 0.85, 0.45), 1, 1); }
    return true;
  }
  if f == RS_FT_SNEAK_ATTACK && on { fx_cause(s, FXR_SHADOW_SLASH, seed, t0, fx_spot(s, i, 1.1), fx_spot(s, e.to, 1.1), fxp_v(0.7, 0.3, 1.0), 1, 1); return true; }
  if f == RS_FT_STEADY_AIM { fx_cause(s, FXR_RETICLE, seed, t0, hand, feet, fxp_v(1.0, 0.55, 0.3), 1, 1); return true; }
  if f == RS_FT_CUNNING_DASH {
    // the shadows trail away from the foe it runs for
    foe := nearest_foe(s, i);
    fx_cause(s, FXR_AFTERIMAGE, seed, t0, ifx foe >= 0 then fx_spot(s, foe, 0) else feet, feet, fxp_v(0.1, 0.1, 0.14), 1, 1);
    return true;
  }
  if f == RS_FT_FLURRY {
    foe := foe_at_hand(s, i, -1);
    if foe >= 0 { fx_cause(s, FXR_FLURRY, seed, t0, fx_spot(s, i, 1.2), fx_spot(s, foe, 1.15), fxp_v(0.8, 0.9, 1.0), 1, 1); }
    return true;
  }
  if f == RS_FT_STUNNING_STRIKE && on {
    fx_cause(s, FXR_STUN, seed, t0, hand, fx_spot(s, e.to, 0), fxp_v(1.0, 0.82, 0.35), ifx e.kind == RS_EV_CONDITION then 1.0f32 else 0.6f32, 1);
    return true;
  }
  if f == RS_FT_PATIENT_DEFENSE { fx_cause(s, FXR_WIND, seed, t0, hand, feet, fxp_v(0.72, 0.88, 1.0), 1, 0.8); return true; }
  if f == RS_FT_STEP_OF_THE_WIND { fx_cause(s, FXR_WIND, seed, t0, hand, feet, fxp_v(0.72, 0.88, 1.0), 1, 2); return true; }
  if f == RS_FT_SACRED_WEAPON { fx_cause(s, FXR_SACRED, seed, t0, hand, feet, fxp_v(1.0, 0.9, 0.6), 1, 1); return true; }
  if f == RS_FT_TURN_UNDEAD {
    if e.kind == RS_EV_CAST { fx_cause(s, FXR_HALO, seed, t0, hand, feet, fxp_v(1.0, 0.9, 0.55), 1, 9.1); return true; }
    return false;
  }
  if f == RS_FT_PRESERVE_LIFE {
    if e.kind == RS_EV_CAST { fx_cause(s, FXR_WAVE, seed, t0, hand, feet, fxp_v(0.85, 1.0, 0.6), 1, 9.1); return true; }
    return false;   // each one it heals: the healing motes
  }
  if f == RS_FT_LANDS_AID {
    if e.kind == RS_EV_ZONE {
      mid := f32(e.amount - 1) / 2;
      fx_cause(s, FXR_THORNS, seed, t0, hand, fxp_v(wx(f32(e.x) + mid), 0, wz(f32(e.y) + mid)), fxp_v(0.35, 0.9, 0.4), 1, f32(e.amount) * f32(SQ) / 2);
      return true;
    }
    return e.kind == RS_EV_CAST;   // the sphere shows it; its healing shows on its HEAL
  }
  if f == RS_FT_INSPIRATION && on { fx_cause(s, FXR_NOTES, seed, t0, hand, fx_spot(s, e.to, 1.9), fxp_v(1.0, 0.8, 0.35), 1, 1); return true; }
  if f == RS_FT_FONT { fx_cause(s, FXR_NOTES, seed, t0, feet, feet, fxp_v(1.0, 0.8, 0.35), 1, 1); return true; }
  if f == RS_FT_CUTTING_WORDS && on { fx_cause(s, FXR_MOCKERY, seed, t0, hand, fx_spot(s, e.to, 1.7), MOCK_FX, 0.6, 1); return true; }
  if f == RS_FT_INNATE_SORCERY { fx_cause(s, FXR_ARCANE, seed, t0, hand, feet, fxp_v(0.75, 0.4, 1.0), 1, 1); return true; }
  if f == RS_FT_DARK_BLESSING { fx_cause(s, FXR_FIEND, seed, t0, hand, feet, fxp_v(1.0, 0.25, 0.1), 1, 1); return true; }
  if f == RS_FT_WILD_RESURGENCE { fx_cause(s, FXR_BLOOM, seed, t0, hand, feet, fxp_v(0.45, 0.95, 0.4), 0.6, 1); return true; }
  return false;
}
// What lasts on a creature, as the glade draws it (aethyr/fx/abilities.coax fxp_status): its
// conditions, concentration, Rage, Sacred Weapon, Innate Sorcery, a flame in hand and a Fiend's
// Temporary Hit Points from Dark One's Blessing.
fx_lasting :: (s: [] Lab, i: int) -> int {
  b := bt(s);
  if b[0].c[i].dead || b[0].c[i].hp == 0 { return 0; }
  cond := b[0].c[i].cond; now := b[0].clock;
  f := 0;
  if (cond & RS_POISONED) != 0 { f = f | FXS_POISONED; }
  if (cond & (RS_STUNNED | RS_PARALYZED)) != 0 { f = f | FXS_STUNNED; }
  if (cond & RS_FRIGHTENED) != 0 { f = f | FXS_FRIGHTENED; }
  if (cond & RS_CHARMED) != 0 { f = f | FXS_CHARMED; }
  if b[0].c[i].conc >= 0 { f = f | FXS_CONCENTRATING; }
  if b[0].c[i].raging { f = f | FXS_RAGING; }
  if b[0].c[i].sacred_until > now { f = f | FXS_SACRED; }
  if b[0].c[i].innate_until > now { f = f | FXS_INNATE; }
  if b[0].c[i].flame_until > now { f = f | FXS_FLAME; }
  if b[0].c[i].dark_blessing && b[0].c[i].temp > 0 { f = f | FXS_FIEND; }
  return f;
}

// ---- a battle

// The Horde's flood: a second after one of the dead falls, a fresh Skeleton takes its place on a
// free square of the grid's edge and runs in, until the Horde has sent all it has.
flood :: (s: [] Lab) {
  b := bt(s);
  for i: HEROES..<b[0].n {
    if s[0].pool <= 0 { return; }
    if !b[0].c[i].dead { continue; }
    if s[0].fell[i] == 0 { s[0].fell[i] = b[0].clock; continue; }
    if b[0].clock - s[0].fell[i] < 1 { continue; }
    for t: 0..<8 {
      e := edge_cell(rs_min(EDGE_CELLS - 1, int(rs_unit(dice(s)) * f32(EDGE_CELLS))));
      x := e % COLS; y := e / COLS;
      if rs_at(b, x, y) >= 0 { continue; }
      s[0].raised += 1; s[0].pool -= 1;
      nm: [16] u8;
      nn := put(nm[..], 0, "Skeleton "); nn = put_int(nm[..], nn, s[0].raised);
      b[0].c[i] = rs_skeleton(cast(string) nm[0..<nn], 2);
      b[0].c[i].x = x; b[0].c[i].y = y;
      b[0].c[i].turn_at = b[0].clock + 0.2 + rs_unit(dice(s)) * rs_beat(b);
      b[0].c[i].round_at = b[0].c[i].turn_at;
      s[0].dx[i] = f32(x); s[0].dy[i] = f32(y); s[0].acted[i] = b[0].clock; s[0].fell[i] = 0; s[0].fresh[i] = true;
      break;
    }
  }
}
// The Horde's ground: the heroes hold an 8 by 6 block mid-glade, the casters in its 6 by 4 middle
// and the rest on its rim; the dead start on the grid's two outer rings.
ACT_ATTACK :: 0;   // the hotbar's first slot, always Attack; keys 1 to 9 pick a slot
HORDE :: 1000;   // the dead the Horde sends in all, 160 at a time
HOLD_X :: COLS / 2 - 4; HOLD_Y :: ROWS / 2 - 3;
EDGE_CELLS :: 2 * COLS + 2 * ROWS - 4 + 2 * (COLS - 2) + 2 * (ROWS - 2) - 4;
hold_cell :: (n: int, inner: bool) -> int {
  seen := 0;
  for y: 0..<6 { for x: 0..<8 {
    rim := x == 0 || y == 0 || x == 7 || y == 5;
    if rim == inner { continue; }
    if seen == n { return (HOLD_Y + y) * COLS + HOLD_X + x; }
    seen += 1;
  } }
  return HOLD_Y * COLS + HOLD_X;
}
edge_cell :: (n: int) -> int {
  seen := 0;
  for y: 0..<ROWS { for x: 0..<COLS {
    if rs_min(rs_min(x, y), rs_min(COLS - 1 - x, ROWS - 1 - y)) > 1 { continue; }
    if seen == n { return y * COLS + x; }
    seen += 1;
  } }
  return 0;
}
new_battle :: (s: [] Lab) {
  b: RsBattle;
  s[0].battle[0] = b;
  s[0].battle[0].w = COLS; s[0].battle[0].h = ROWS;
  s[0].seed += 1;
  s[0].battle[0].dice[0].state = s[0].seed * 7919 + 17;
  for i: 0..<PEOPLE {
    if i >= HEROES {
      q := i - HEROES;
      if q >= s[0].skeletons { break; } x := ARMY_X + q % ARMY_COLS; y := ARMY_Y + q / ARMY_COLS;
      if s[0].horde { e := edge_cell((q * 97) % EDGE_CELLS); x = e % COLS; y = e / COLS; }
      nm: [16] u8;
      nn := put(nm[..], 0, "Skeleton "); nn = put_int(nm[..], nn, q + 1);
      d := rs_add(bt(s), rs_skeleton(cast(string) nm[0..<nn], 2), x, y);
      s[0].dx[i] = f32(x); s[0].dy[i] = f32(y); s[0].acted[i] = -10;
      continue;
    }
    k := i % SIDE; team := i / SIDE;
    who := hero_for(ROSTER[(k / CASTERS) * 6 + k % 6], NAMES[i], team, LEVEL);
    // the six casting classes in two files at the back, the rest two files in front of them; the
    // Pact on the far edge
    sx := ifx k < CASTERS then 1 + k % 2 else 4 + k % 2;
    sy := 1 + (k % CASTERS) * (ROWS - 3) / (CASTERS - 1);
    if team == 1 { sx = COLS - 1 - sx; }
    if s[0].horde {
      // one company in the middle: the casting classes inside, the rest round them
      c := hold_cell(ifx k < CASTERS then team * CASTERS + k else team * (SIDE - CASTERS) + k - CASTERS, k < CASTERS);
      sx = c % COLS; sy = c / COLS;
      who.team = 0;
    }
    j := rs_add(bt(s), who, sx, sy);
    s[0].dx[i] = f32(sx); s[0].dy[i] = f32(sy); s[0].acted[i] = -10;
  }
  s[0].battle[0].clock = 0;
  if s[0].mode == MODE_ACTION { s[0].battle[0].beat = ACTION_BEAT; s[0].battle[0].recharge = ACTION_RECHARGE; }
  rs_begin(bt(s));
  s[0].seen = s[0].battle[0].book[0].seq;
  s[0].over = false; s[0].winner = -1;
  if s[0].player { pick_hero(s); }
  s[0].pool = ifx s[0].horde then rs_max(0, HORDE - s[0].skeletons) else 0; s[0].raised = s[0].skeletons;
  for i: 0..<RS_MAX { s[0].fell[i] = 0; }
  s[0].round += 1;
  for i: 0..<FXS { s[0].fx[i].kind = 0; }
  l: [LINE_CAP] u8;
  n := put(l[..], 0, "Battle ");
  n = put_int(l[..], n, s[0].round);
  n = put(l[..], n, ifx s[0].mode == MODE_ACTION then ", action combat" else ", SRD rounds");
  if s[0].horde { n = put(l[..], n, ": the Horde. Every hero on one side, and "); n = put_int(l[..], n, s[0].skeletons); n = put(l[..], n, " skeletons run at them."); }
  else { n = put(l[..], n, ": two of each SRD 5e class a side, and "); n = put_int(l[..], n, s[0].skeletons); n = put(l[..], n, " skeletons."); }
  add_line(s, cast(string) l[0..<n], GOLD);
  // six to a line
  for row: 0..<(HEROES / 6) {
    m := put(l[..], 0, " ");
    for c: 0..<6 {
      i := row * 6 + c;
      m = put(l[..], m, " "); m = put(l[..], m, NAMES[i]); m = put(l[..], m, " ");
      m = put_int(l[..], m, s[0].battle[0].c[i].initiative);
    }
    add_line(s, cast(string) l[0..<m], TEAM_COL[(row * 6) / SIDE]);
  }
}
hero_for :: (klass: int, name: string, team: int, level: int) -> RsCreature {
  if klass == RS_WIZARD { return rs_wizard(name, team, level); }
  if klass == RS_WARLOCK { return rs_warlock(name, team, level, SP_ELDRITCH_BLAST); }
  if klass == RS_BARBARIAN { return rs_barbarian(name, team, level); }
  if klass == RS_MONK { return rs_monk(name, team, level); }
  if klass == RS_BARD { return rs_bard(name, team, level); }
  if klass == RS_CLERIC { return rs_cleric(name, team, level); }
  if klass == RS_FIGHTER { return rs_fighter(name, team, level); }
  if klass == RS_PALADIN { return rs_paladin(name, team, level); }
  if klass == RS_RANGER { return rs_ranger(name, team, level); }
  if klass == RS_ROGUE { return rs_rogue(name, team, level); }
  if klass == RS_SORCERER { return rs_sorcerer(name, team, level); }
  return rs_druid(name, team, level);
}
lab_start :: (s: [] Lab) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].seed = 5;
  new_battle(s);
}

// ---- how a druid decides (the world's; the rules are the engine's)

nearest_foe :: (s: [] Lab, i: int) -> int {
  // heroes count the Restless Dead 40 feet further off than they are: the rival side is their
  // quarrel, and the dead are fought when they come close
  best := -1; bd := 100000;
  me := s[0].battle[0].c[i];
  for j: 0..<s[0].battle[0].n {
    c := s[0].battle[0].c[j];
    if c.team == me.team || !rs_up(c) { continue; }
    d := rs_feet_to(bt(s), i, j);
    if c.klass == RS_MONSTER && me.klass != RS_MONSTER && d > 5 { d += 40; }
    if d < bd { bd = d; best = j; }
  }
  return best;
}
// The lowest free slot of at least level, or 0.
free_slot :: (s: [] Lab, i: int, level: int) -> int {
  for k: level..<10 { if s[0].battle[0].c[i].slots[k] > 0 { return k; } }
  return 0;
}
// Walk square by square: toward the foe to `want` feet, or away when closer than `least`.
walk :: (s: [] Lab, i: int, foe: int, least: int, want: int) {
  guard := 0;
  while s[0].battle[0].turn.move_left > 0 && guard < 12 {
    guard += 1;
    d := rs_feet_to(bt(s), i, foe);
    if d >= least && d <= want { return; }
    away := d < least;
    bx := -1; by := -1; bs := -100000;
    for oy: -1..<2 {
      for ox: -1..<2 {
        if ox == 0 && oy == 0 { continue; }
        x := s[0].battle[0].c[i].x + ox; y := s[0].battle[0].c[i].y + oy;
        if x < 0 || y < 0 || x >= COLS || y >= ROWS || rs_at(bt(s), x, y) >= 0 { continue; }
        nd := rs_feet(x, y, s[0].battle[0].c[foe].x, s[0].battle[0].c[foe].y);
        score := ifx away then nd else -nd;
        if rs_difficult(bt(s), x, y) { score -= 4; }
        // keep off the edges when backing away
        if away && (x == 0 || y == 0 || x == COLS - 1 || y == ROWS - 1) { score -= 3; }
        if score > bs { bs = score; bx = x; by = y; }
      }
    }
    here := ifx away then d else -d;
    if bx < 0 || bs <= here { return; }
    if !rs_step_to(bt(s), i, bx, by) { return; }
  }
}
foes_near :: (s: [] Lab, i: int, x: int, y: int, feet: int) -> int {
  n := 0;
  for j: 0..<s[0].battle[0].n {
    c := s[0].battle[0].c[j];
    if c.team != s[0].battle[0].c[i].team && rs_up(c) && rs_feet(x, y, c.x, c.y) <= feet { n += 1; }
  }
  return n;
}
friends_near :: (s: [] Lab, i: int, x: int, y: int, feet: int) -> int {
  n := 0;
  for j: 0..<s[0].battle[0].n {
    c := s[0].battle[0].c[j];
    if c.team == s[0].battle[0].c[i].team && !c.dead && rs_feet(x, y, c.x, c.y) <= feet { n += 1; }
  }
  return n;
}

// A Warlock's turn: Hex with a pact slot (a Bonus Action), moved to a new foe when its target
// drops, or Hold Person to open; with the other slot, Hold Person when it holds no spell, or
// Scorching Ray when Hex is up;
// Chill Touch on a Paralyzed foe at hand (a Critical Hit); else Eldritch Blast from range, at the
// hexed foe first.
pact_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  pl := 1; for k: 1..<6 { if b[0].c[i].slots_max[k] > 0 { pl = k; } }   // Pact Magic's slot level
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // Hex: moved on, or cast
  if b[0].c[i].conc == SP_HEX && b[0].c[i].hex_free { ok := rs_hex_move(b, i, foe); }
  // a barbarian within 60 feet: Rage does nothing for a Wisdom save, so Hold Person it
  brute := -1;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && c.klass == RS_BARBARIAN && !rs_has(c, RS_PARALYZED) && rs_feet_to(b, i, j) <= 60 {
      if brute < 0 || rs_feet_to(b, i, j) < rs_feet_to(b, i, brute) { brute = j; }
    }
  }
  if b[0].c[i].conc < 0 && b[0].c[i].slots[pl] > 0 {
    if brute >= 0 && rs_unit(dice(s)) < 0.7 { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, brute); }
    else if b[0].c[foe].humanoid && rs_feet_to(b, i, foe) <= 60 && !rs_has(b[0].c[foe], RS_PARALYZED) && rs_unit(dice(s)) < 0.35 { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, foe); }
    else if rs_feet_to(b, i, foe) <= 90 { ok := rs_cast(b, i, SP_HEX, pl, 0, 0, foe); }
  }
  // a Paralyzed foe within a walk: go and touch it
  held := -1;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && rs_has(c, RS_PARALYZED) && rs_feet_to(b, i, j) <= 30 { held = j; }
  }
  if held >= 0 && !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, held, 0, 5); }
  if held >= 0 && rs_feet_to(b, i, held) <= 5 { ok := rs_cast(b, i, SP_CHILL_TOUCH, 0, 0, 0, held); }
  if b[0].turn.action { return; }
  // keep its distance: Eldritch Blast reaches 120 feet
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // a raging barbarian next: Force isn't halved by Rage
  bd := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team && rs_up(c) && c.klass == RS_BARBARIAN && rs_feet_to(b, i, j) <= 120 && rs_feet_to(b, i, j) < bd { bd = rs_feet_to(b, i, j); foe = j; }
  }
  // the hexed foe first
  for j: 0..<b[0].n {
    for k: 0..<RS_EFFECTS {
      if b[0].c[j].eff[k].kind == EF_HEX && b[0].c[j].eff[k].by == i && rs_up(b[0].c[j]) && rs_feet_to(b, i, j) <= 120 { foe = j; }
    }
  }
  d := rs_feet_to(b, i, foe);
  // the swarm: a Fiend's Fireball (from level 5) where it catches three foes and no friend
  if !b[0].turn.slot_spent && pl >= 3 && b[0].c[i].slots[pl] > 0 {
    fb := burst_at(s, i, 150, 20, false, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, pl, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  if !b[0].turn.slot_spent && b[0].c[i].slots[pl] > 0 {
    if b[0].c[i].conc < 0 && d <= 60 && b[0].c[foe].humanoid && !rs_has(b[0].c[foe], RS_PARALYZED) { ok := rs_cast(b, i, SP_HOLD_PERSON, pl, 0, 0, foe); }
    else if rs_unit(dice(s)) < 0.6 { ok := rs_cast(b, i, SP_SCORCHING_RAY, pl, 0, 0, foe); }
  }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_ELDRITCH_BLAST, 0, 0, 0, foe); }
}

// The foe beside i most worth hitting: the most hurt, casters first.
foe_at_hand :: (s: [] Lab, i: int, but: int) -> int {
  b := bt(s);
  best := -1; bv := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if j == but || c.team == b[0].c[i].team || !rs_up(c) || rs_feet_to(b, i, j) > 5 { continue; }
    v := c.hp; if c.spell_ability >= 0 { v -= 8; }
    if rs_has(c, RS_PARALYZED) { v -= 100; }
    if v < bv { bv = v; best = j; }
  }
  return best;
}
// A Barbarian's turn: Rage when a foe is near, close in (Dash when far), attack recklessly with the
// Greataxe, and Cleave into a second foe beside the first.
barbarian_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // the casters behind the line, when a dash reaches them
  bd := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 60 && d < bd { bd = d; foe = j; }
  }
  // Rage once a foe is within a dash (Fast Movement makes it 40 feet a move from level 5)
  if !b[0].c[i].raging && rs_feet_to(b, i, foe) <= 2 * b[0].c[i].speed { ok := rs_rage(b, i); }
  if foe_at_hand(s, i, -1) < 0 && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 0, 5);
    if rs_feet_to(b, i, foe) > 5 && !b[0].turn.action { ok := rs_dash(b, i); walk(s, i, foe, 0, 5); }
  }
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  ok := rs_attack(b, i, j, true, foe_at_hand(s, i, j));
}
// A Monk's turn: run at the casters (Step of the Wind when far), strike, then Flurry of Blows that
// knocks a foe Prone (or pushes one already down); Patient Defense when badly hurt and alone with
// foes around it.
monk_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  // its quarry: the nearest caster within a dash, else the nearest foe
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  bd := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 80 && d < bd { bd = d; foe = j; }
  }
  // a Paralyzed foe within a dash comes first: every hit from 5 feet is a Critical Hit
  bd = 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || !rs_has(c, RS_PARALYZED) { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 80 && d < bd { bd = d; foe = j; }
  }
  if foe_at_hand(s, i, -1) < 0 && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 0, 5);
    if rs_feet_to(b, i, foe) > 5 { ok := rs_step_of_the_wind(b, i); walk(s, i, foe, 0, 5); }
  }
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  // from level 5, a Stunning Strike on its hits while it has Focus to spare; from 6, Wholeness of
  // Body when badly hurt
  b[0].c[i].stun_ready = b[0].c[i].focus > 2;
  ok := rs_attack(b, i, j, false, -1);
  if b[0].c[i].hp * 5 < b[0].c[i].hp_max * 2 { ok = rs_wholeness(b, i); }
  brute := false;
  for k: 0..<b[0].n {
    c := b[0].c[k];
    if c.team != b[0].c[i].team && rs_can_act(c) && c.klass == RS_BARBARIAN && rs_feet_to(b, i, k) <= 5 { brute = true; }
  }
  if (brute || b[0].c[i].hp * 3 < b[0].c[i].hp_max) && b[0].c[i].focus > 0 { ok = rs_patient_defense(b, i); return; }
  j = foe_at_hand(s, i, -1);
  if j < 0 { return; }
  if b[0].c[i].focus > 1 { ok = rs_flurry(b, i, j, ifx rs_has(b[0].c[j], RS_PRONE) then OH_PUSH else OH_TOPPLE); }
  else { ok = rs_bonus_strike(b, i, j); }
}

// A Skeleton's turn: the even ones close in with the Shortsword, the odd ones hang back and shoot;
// any with a foe beside it uses the Shortsword (a bow up close has Disadvantage).
skeleton_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  j := foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if s[0].horde {
    // the Horde runs: Dash when the living are out of reach, and cut at whoever it reaches
    close_in(s, i, foe);
    j = foe_at_hand(s, i, -1);
    if j >= 0 && !b[0].turn.action { ok := rs_attack(b, i, j, false, -1); }
    return;
  }
  archer := i % 2 == 1;
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, ifx archer then 30 else 0, ifx archer then 70 else 5); }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  foe = nearest_foe(s, i);
  if foe >= 0 && rs_feet_to(b, i, foe) <= 80 { ok := rs_shoot(b, i, foe); }
}

// The quarry for a striker: the nearest caster within `feet`, else the nearest foe.
quarry :: (s: [] Lab, i: int, feet: int) -> int {
  b := bt(s);
  foe := nearest_foe(s, i);
  bd := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || c.spell_ability < 0 || c.klass == RS_MONSTER { continue; }
    d := rs_feet_to(b, i, j);
    if d <= feet && d < bd { bd = d; foe = j; }
  }
  return foe;
}
// Walk to 5 feet of the foe, then Dash when it still falls short.
close_in :: (s: [] Lab, i: int, foe: int) {
  b := bt(s);
  if foe_at_hand(s, i, -1) >= 0 || rs_has(b[0].c[i], RS_RESTRAINED) { return; }
  walk(s, i, foe, 0, 5);
  if rs_feet_to(b, i, foe) > 5 && !b[0].turn.action { ok := rs_dash(b, i); walk(s, i, foe, 0, 5); }
}
// The friend most hurt within `feet` (itself too), below `share` of its Hit Points, or -1.
most_hurt :: (s: [] Lab, i: int, feet: int, share: f32) -> int {
  b := bt(s);
  best := -1; bv := share;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team || c.dead || c.stable || rs_feet_to(b, i, j) > feet { continue; }
    v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
    if v < bv { bv = v; best = j; }
  }
  return best;
}
// The foe that i's effect of `kind` is on, within `feet`, or -1.
marked_by :: (s: [] Lab, i: int, kind: int, feet: int) -> int {
  b := bt(s);
  for j: 0..<b[0].n {
    if !rs_up(b[0].c[j]) || rs_feet_to(b, i, j) > feet { continue; }
    for k: 0..<RS_EFFECTS { if b[0].c[j].eff[k].kind == kind && b[0].c[j].eff[k].by == i { return j; } }
  }
  return -1;
}
// A foe in i's face: Thunderwave, a 15-foot cube from it, with its lowest free slot.
thunder_back :: (s: [] Lab, i: int, foe: int, chance: f32) {
  b := bt(s);
  if foe < 0 || rs_feet_to(b, i, foe) > 5 || b[0].turn.action || b[0].turn.slot_spent { return; }
  sl := free_slot(s, i, 1);
  if sl > 0 && rs_unit(dice(s)) < chance { ok := rs_cast(b, i, SP_THUNDERWAVE, sl, b[0].c[foe].x, b[0].c[foe].y, -1); }
}
// Hold Person with a 2nd-level slot on a humanoid foe within 60 feet, when i holds no spell.
hold_one :: (s: [] Lab, i: int, foe: int, chance: f32) {
  b := bt(s);
  if foe < 0 || b[0].turn.action || b[0].turn.slot_spent || b[0].c[i].conc >= 0 || b[0].c[i].slots[2] <= 0 { return; }
  if !b[0].c[foe].humanoid || rs_has(b[0].c[foe], RS_PARALYZED) || rs_feet_to(b, i, foe) > 60 { return; }
  if rs_unit(dice(s)) < chance { ok := rs_cast(b, i, SP_HOLD_PERSON, 2, 0, 0, foe); }
}

// The foe whose square makes the best centre for a burst of `radius` feet within `range` of i: the
// most foes caught, less three for each friend in it (none when `spare`: an Evoker sculpts them
// out), or -1 when fewer than `least` foes would be caught. It looks at 40 foes at most.
burst_at :: (s: [] Lab, i: int, range: int, radius: int, spare: bool, least: int) -> int {
  b := bt(s);
  best := -1; bv := least - 1; looked := 0;
  me := b[0].c[i];
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == me.team || !rs_up(c) || rs_feet_to(b, i, j) > range || looked >= 40 { continue; }
    looked += 1;
    v := 0;
    for k: 0..<b[0].n {
      o := b[0].c[k];
      if o.dead || rs_feet(c.x, c.y, o.x, o.y) > radius { continue; }
      if o.team != me.team { if rs_up(o) { v += 1; } } else if !spare || k == i { v -= 3; }
    }
    if v > bv { bv = v; best = j; }
  }
  return best;
}
// A Fighter's turn: Second Wind when Bloodied, close in on the casters, the Greatsword (Graze on a
// miss), then Action Surge for a second Attack action while a foe still stands beside it.
fighter_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  if b[0].c[i].hp * 2 < b[0].c[i].hp_max { ok := rs_second_wind(b, i); }
  foe := quarry(s, i, 40);
  if foe < 0 { return; }
  close_in(s, i, foe);
  j := foe_at_hand(s, i, -1);
  if j < 0 { return; }
  ok := rs_attack(b, i, j, false, -1);
  j = foe_at_hand(s, i, -1);
  if j >= 0 && rs_action_surge(b, i) { ok = rs_attack(b, i, j, false, -1); }
}
// A Paladin's turn: Lay On Hands on the worst hurt beside it, close in, Sacred Weapon with the first
// attack, the Longsword (Sap), and Divine Smite on a hit: without a slot first, then with one on a
// caster or a foe with Hit Points to spare. Sacred Flame (Blessed Warrior) at a foe it can't reach.
paladin_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  w := most_hurt(s, i, 5, 0.35);
  if w >= 0 { ok := rs_lay_on_hands(b, i, w, ifx b[0].c[w].hp == 0 then 5 else 10); }
  foe := quarry(s, i, 30);
  if foe < 0 { return; }
  close_in(s, i, foe);
  j := foe_at_hand(s, i, -1);
  if j < 0 {
    foe = nearest_foe(s, i);
    if foe >= 0 && !b[0].turn.action { ok := rs_cast(b, i, SP_SACRED_FLAME, 0, 0, 0, foe); }
    return;
  }
  ok := rs_sacred_weapon(b, i);
  ok = rs_attack(b, i, j, false, -1);
  if b[0].turn.last_hit == j + 1 && rs_up(b[0].c[j]) {
    if !rs_cast(b, i, SP_DIVINE_SMITE, 0, 0, 0, j) {
      sl := free_slot(s, i, 1);
      if sl > 0 && (b[0].c[j].spell_ability >= 0 || b[0].c[j].hp > 12) && rs_unit(dice(s)) < 0.5 { ok = rs_cast(b, i, SP_DIVINE_SMITE, sl, 0, 0, j); }
    }
  }
}
// A Ranger's turn: Hunter's Mark (without a slot while Favored Enemy lasts, then with one), moved
// on when its quarry drops; the Shortsword at a foe beside it, else back to 30 feet or more and the
// Longbow, at the marked foe first.
ranger_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  if b[0].c[i].conc == SP_HUNTERS_MARK && b[0].c[i].hex_free { ok := rs_hex_move(b, i, foe); }
  if b[0].c[i].conc < 0 && rs_feet_to(b, i, foe) <= 90 {
    if !rs_cast(b, i, SP_HUNTERS_MARK, 0, 0, 0, foe) {
      sl := free_slot(s, i, 1);
      if sl > 0 { ok := rs_cast(b, i, SP_HUNTERS_MARK, sl, 0, 0, foe); }
    }
  }
  j := foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 30, 90); }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  m := marked_by(s, i, EF_MARK, 150);
  foe = ifx m >= 0 then m else nearest_foe(s, i);
  if foe >= 0 { ok := rs_shoot(b, i, foe); }
}
// A Rogue's turn: the Shortsword at a foe beside it; else, in bow range and not yet moved, Steady
// Aim and the Shortbow with Advantage (and Sneak Attack); else a walk, Cunning Action's Dash when
// still out of range, and the bow. From level 5 Cunning Strike trips, or withdraws from a foe at hand.
rogue_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  // Cunning Strike: Trip a standing foe, else Withdraw from one at hand
  j := foe_at_hand(s, i, -1);
  if j >= 0 { b[0].c[i].strike_plan = ifx rs_has(b[0].c[j], RS_PRONE) then CS_WITHDRAW else CS_TRIP; ok := rs_attack(b, i, j, false, -1); walk(s, i, j, 30, 70); return; }
  d := rs_feet_to(b, i, foe);
  if d >= 15 && d <= 80 { ok := rs_steady_aim(b, i); }
  if !b[0].turn.anchored && !rs_has(b[0].c[i], RS_RESTRAINED) {
    walk(s, i, foe, 30, 70);
    if rs_feet_to(b, i, foe) > 80 { ok := rs_cunning_dash(b, i); walk(s, i, foe, 30, 70); }
  }
  j = foe_at_hand(s, i, -1);
  if j >= 0 { b[0].c[i].strike_plan = CS_TRIP; ok := rs_attack(b, i, j, false, -1); return; }
  foe = nearest_foe(s, i);
  if foe >= 0 { b[0].c[i].strike_plan = ifx rs_has(b[0].c[foe], RS_PRONE) then CS_NONE else CS_TRIP; ok := rs_shoot(b, i, foe); }
}
// A Cleric's turn: Turn Undead when three of the dead stand within 30 feet, Preserve Life when two
// friends near it are Bloodied, Healing Word on the worst hurt; the Mace at a foe beside it, else
// Guiding Bolt or Sacred Flame from 15 to 45 feet off.
cleric_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  undead_near := 0; bloodied := 0;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if rs_feet_to(b, i, j) > 30 { continue; }
    if c.undead && rs_up(c) && c.team != b[0].c[i].team && rs_turned_by(c) < 0 { undead_near += 1; }
    if c.team == b[0].c[i].team && !c.dead && c.hp < c.hp_max / 2 { bloodied += 1; }
  }
  if undead_near >= 3 { ok := rs_turn_undead(b, i); }
  // Spirit Guardians (from level 5) when two foes or more are within 15 feet, or the dead are near
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 && b[0].c[i].conc < 0 && foes_near(s, i, b[0].c[i].x, b[0].c[i].y, 20) >= 2 {
    ok := rs_cast(b, i, SP_SPIRIT_GUARDIANS, 3, 0, 0, i);
  }
  if bloodied >= 2 { ok := rs_preserve_life(b, i); }
  w := most_hurt(s, i, 60, 0.4);
  if w >= 0 && !b[0].turn.slot_spent {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_HEALING_WORD, sl, 0, 0, w); }
  }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  j := foe_at_hand(s, i, -1);
  if j >= 0 && !b[0].turn.action { ok := rs_attack(b, i, j, false, -1); return; }
  // with Spirit Guardians up it wades in among them
  guarding := b[0].c[i].conc == SP_SPIRIT_GUARDIANS;
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, ifx guarding then 0 else 15, ifx guarding then 10 else 45); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  if !b[0].turn.action && !b[0].turn.slot_spent && rs_unit(dice(s)) < 0.5 {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_GUIDING_BOLT, sl, 0, 0, foe); }
  }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_SACRED_FLAME, 0, 0, 0, foe); }
}
// A Bard's turn: Healing Word on a friend near the end, Bardic Inspiration to a friend with a foe
// near it; Thunderwave at a foe in its face; then from 20 to 50 feet, Hold Person on a humanoid or
// Vicious Mockery. Cutting Words comes on its own, as a Reaction.
bard_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  w := most_hurt(s, i, 60, 0.3);
  if w >= 0 {
    sl := free_slot(s, i, 1);
    if sl > 0 { ok := rs_cast(b, i, SP_HEALING_WORD, sl, 0, 0, w); }
  }
  pick := -1; pd := 100000;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if j == i || c.team != b[0].c[i].team || !rs_up(c) || c.inspired > 0 || c.klass == RS_MONSTER { continue; }
    d := rs_feet_to(b, i, j);
    if d <= 60 && d < pd && foes_near(s, i, c.x, c.y, 10) > 0 { pd = d; pick = j; }
  }
  if pick >= 0 && b[0].c[i].uses[RS_USE_INSPIRE] == 0 && b[0].c[i].slots[1] > 0 { ok := rs_font(b, i); }
  if pick >= 0 { ok := rs_inspire(b, i, pick); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  thunder_back(s, i, foe, 0.6);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 20, 50); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // the swarm: Hypnotic Pattern (from level 5) on four foes and no friend, then a Fireball
  // (Magical Discoveries, level 6) on three
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    hp := ifx b[0].c[i].conc < 0 then burst_at(s, i, 120, 15, false, 4) else -1;
    if hp >= 0 { ok := rs_cast(b, i, SP_HYPNOTIC_PATTERN, 3, b[0].c[hp].x, b[0].c[hp].y, -1); }
    else if b[0].c[i].discoveries[0] == SP_FIREBALL {
      fb := burst_at(s, i, 150, 20, false, 3);
      if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
    }
  }
  hold_one(s, i, foe, 0.3);
  if !b[0].turn.action { ok := rs_cast(b, i, SP_VICIOUS_MOCKERY, 0, 0, 0, foe); }
}
// A Draconic Sorcerer's turn: Innate Sorcery as the fight opens, Thunderwave at a foe in its face,
// then from 25 to 60 feet Scorching Ray with a 2nd-level slot or Fire Bolt, and a second Fire Bolt
// Quickened (2 Sorcery Points) when no slot spell went this turn. Shield and Seeking Spell come on
// their own.
sorcerer_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  if rs_feet_to(b, i, foe) <= 120 { ok := rs_innate_sorcery(b, i); }
  thunder_back(s, i, foe, 0.6);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // Fireball (from level 5) where it catches three foes and no friend
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    fb := burst_at(s, i, 150, 20, false, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[2] > 0 && rs_unit(dice(s)) < 0.55 { ok := rs_cast(b, i, SP_SCORCHING_RAY, 2, 0, 0, foe); }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
  foe = nearest_foe(s, i);
  if foe >= 0 && rs_unit(dice(s)) < 0.5 { ok := rs_cast_quick(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
}
// An Evoker Wizard's turn: Thunderwave at a foe in its face; from 25 to 60 feet, Hold Person on a
// humanoid, Scorching Ray with a 2nd-level slot, or Fire Bolt (Potent Cantrip: half on a miss).
// Shield comes on its own.
wizard_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  if rs_has(b[0].c[i], RS_RESTRAINED) && rs_unit(dice(s)) < 0.5 { ok := rs_escape(b, i); }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  thunder_back(s, i, foe, 0.7);
  if !rs_has(b[0].c[i], RS_RESTRAINED) { walk(s, i, foe, 25, 60); }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  // Fireball (from level 5) where it catches three foes or more
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 {
    fb := burst_at(s, i, 150, 20, b[0].c[i].sculpt, 3);
    if fb >= 0 { ok := rs_cast(b, i, SP_FIREBALL, 3, b[0].c[fb].x, b[0].c[fb].y, -1); }
  }
  hold_one(s, i, foe, 0.25);
  if !b[0].turn.action && !b[0].turn.slot_spent && b[0].c[i].slots[2] > 0 && rs_unit(dice(s)) < 0.5 { ok := rs_cast(b, i, SP_SCORCHING_RAY, 2, 0, 0, foe); }
  if !b[0].turn.action { ok := rs_cast(b, i, SP_FIRE_BOLT, 0, 0, 0, foe); }
}

// A Circle of the Land Druid's turn: Healing Word on a friend near the end, Thunderwave at a foe in
// its face, Land's Aid where foes bunch, Hold Person (a polar land's spell), Entangle or Faerie Fire,
// then a cantrip; Cure Wounds on a friend at hand.
druid_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  roll := rs_unit(dice(s));
  // held by plants: strain against them half the time, else cast from where it stands
  if rs_has(b[0].c[i], RS_RESTRAINED) && roll < 0.5 { ok := rs_escape(b, i); }
  // a friend down or badly hurt: Healing Word (a Bonus Action) from afar, Cure Wounds by touch
  worst := -1; wv: f32 = 2;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team != b[0].c[i].team || c.dead || c.stable { continue; }
    v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
    if v < wv { wv = v; worst = j; }
  }
  if worst >= 0 && wv < 0.4 {
    slot := free_slot(s, i, 1);
    if slot > 0 && rs_feet_to(b, i, worst) <= 60 { ok := rs_cast(b, i, SP_HEALING_WORD, slot, 0, 0, worst); }
  }
  foe := nearest_foe(s, i);
  if foe < 0 { return; }
  conc := b[0].c[i].conc >= 0;
  slot := ifx b[0].turn.slot_spent then 0 else free_slot(s, i, 1);
  // a foe in its face: Thunderwave, or step back
  if rs_feet_to(b, i, foe) <= 5 && slot > 0 && !b[0].turn.action && rs_unit(dice(s)) < 0.75 {
    ok := rs_cast(b, i, SP_THUNDERWAVE, slot, b[0].c[foe].x, b[0].c[foe].y, -1);
  }
  if !rs_has(b[0].c[i], RS_RESTRAINED) {
    want := ifx !conc && slot > 0 then 45 else 40;
    walk(s, i, foe, 15, want);
  }
  foe = nearest_foe(s, i);
  if foe < 0 { return; }
  d := rs_feet_to(b, i, foe);
  fx := b[0].c[foe].x; fy := b[0].c[foe].y;
  slot = ifx b[0].turn.slot_spent then 0 else free_slot(s, i, 1);
  // Land's Aid where two foes or more stand within 10 feet of the nearest, healing the friend there most hurt
  // Call Lightning (from level 5) where its bolt catches two foes, and the later bolts while it lasts
  if !b[0].turn.action && d <= 120 {
    cl := burst_at(s, i, 120, 5, false, 2);
    if cl >= 0 && b[0].c[i].conc == SP_CALL_LIGHTNING { ok := rs_cast(b, i, SP_CALL_BOLT, 0, b[0].c[cl].x, b[0].c[cl].y, -1); }
    else if cl >= 0 && !b[0].turn.slot_spent && b[0].c[i].slots[3] > 0 && b[0].c[i].conc < 0 { ok := rs_cast(b, i, SP_CALL_LIGHTNING, 3, b[0].c[cl].x, b[0].c[cl].y, -1); }
  }
  if foes_near(s, i, fx, fy, 10) >= 2 { ok := rs_wild_resurgence(b, i); }
  if !b[0].turn.action && d <= 60 && b[0].c[i].uses[RS_USE_WILD] > 0 && foes_near(s, i, fx, fy, 10) >= 2 {
    heal := -1; hv: f32 = 0.7;
    for j: 0..<b[0].n {
      c := b[0].c[j];
      if c.team != b[0].c[i].team || c.dead || rs_feet(fx, fy, c.x, c.y) > 10 { continue; }
      v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
      if v < hv { hv = v; heal = j; }
    }
    ok := rs_lands_aid(b, i, fx, fy, heal);
  }
  hold_one(s, i, foe, 0.25);
  conc = b[0].c[i].conc >= 0;
  if !b[0].turn.action && !conc && slot > 0 && rs_unit(dice(s)) < 0.45 {
    // an area spell where it catches foes and spares friends
    if friends_near(s, i, fx, fy, 15) == 0 {
      if !rs_has(b[0].c[foe], RS_RESTRAINED) && rs_unit(dice(s)) < 0.55 { ok := rs_cast(b, i, SP_ENTANGLE, slot, fx, fy, -1); }
      else { ok := rs_cast(b, i, SP_FAERIE_FIRE, slot, fx, fy, -1); }
    }
  }
  if !b[0].turn.action {
    // a cantrip: Produce Flame lit with the Bonus Action and hurled, or Starry Wisp, or Poison Spray up close
    if !b[0].turn.bonus && b[0].c[i].flame_until <= b[0].clock && d <= 60 && rs_unit(dice(s)) < 0.35 {
      ok := rs_cast(b, i, SP_PRODUCE_FLAME, 0, 0, 0, i);
    }
    if b[0].c[i].flame_until > b[0].clock && d <= 60 { ok := rs_cast(b, i, SP_FLAME_HURL, 0, 0, 0, foe); }
    else if d <= 30 && rs_unit(dice(s)) < 0.5 { ok := rs_cast(b, i, SP_POISON_SPRAY, 0, 0, 0, foe); }
    else if d <= 60 { ok := rs_cast(b, i, SP_STARRY_WISP, 0, 0, 0, foe); }
  }
  // a friend at hand and hurt: Cure Wounds would take the action, so only when it is still free
  if !b[0].turn.action && worst >= 0 && wv < 0.5 && rs_feet_to(b, i, worst) <= 5 {
    cs := free_slot(s, i, 1);
    if cs > 0 { ok := rs_cast(b, i, SP_CURE_WOUNDS, cs, 0, 0, worst); }
  }
}

lab_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  rs_start_turn(b, i);
  s[0].acted[i] = b[0].clock;
  kl := b[0].c[i].klass;
  // a turned Skeleton spends its turn moving away from the Cleric who turned it
  holy := rs_turned_by(b[0].c[i]);
  if holy >= 0 && rs_can_move(b[0].c[i]) { walk(s, i, holy, 300, 400); }
  if s[0].player && i == s[0].me {
    if rs_can_act(b[0].c[i]) { player_turn(s, i); }
    rs_end_turn(b, i);
    return;
  }
  if rs_can_act(b[0].c[i]) { class_turn(s, i); }
  rs_end_turn(b, i);
}
// A hero's turn as its class plays it.
class_turn :: (s: [] Lab, i: int) {
  kl := s[0].battle[0].c[i].klass;
  if true {
    if kl == RS_BARBARIAN { barbarian_turn(s, i); }
    else if kl == RS_MONSTER { skeleton_turn(s, i); }
    else if kl == RS_MONK { monk_turn(s, i); }
    else if kl == RS_WARLOCK { pact_turn(s, i); }
    else if kl == RS_FIGHTER { fighter_turn(s, i); }
    else if kl == RS_PALADIN { paladin_turn(s, i); }
    else if kl == RS_RANGER { ranger_turn(s, i); }
    else if kl == RS_ROGUE { rogue_turn(s, i); }
    else if kl == RS_CLERIC { cleric_turn(s, i); }
    else if kl == RS_BARD { bard_turn(s, i); }
    else if kl == RS_SORCERER { sorcerer_turn(s, i); }
    else if kl == RS_WIZARD { wizard_turn(s, i); }
    else { druid_turn(s, i); }
  }
}
// Your turn in Player mode: you walk where the held keys point (the camera's right and forward,
// on the grid), then the hotbar's slot: Attack (your target if it's in reach, else whoever is,
// else a shot or your class's own spell), your class's powers, or Dash.
player_turn :: (s: [] Lab, i: int) {
  b := bt(s);
  tgt := s[0].target;
  if tgt >= 0 && !rs_up(b[0].c[tgt]) { tgt = -1; s[0].target = -1; }
  list: [SLOTS] Ab; nab := abilities(b[0].c[i].klass, list[..]);
  a := list[rs_min(s[0].act, nab - 1)];
  s[0].act = ACT_ATTACK;   // a slot is used once; the next turn attacks unless you pick again
  if !ab_ready(s, i, a) { a = list[0]; }
  // the dashes come before the walk
  ok := false;
  if a.kind == AB_DASH { ok = rs_dash(b, i); }
  if a.kind == AB_CDASH { ok = rs_cunning_dash(b, i); }
  if a.kind == AB_WIND { ok = rs_step_of_the_wind(b, i); }
  ax := axis(s[0].held, HOLD_D, HOLD_A); az := axis(s[0].held, HOLD_W, HOLD_S);
  if ax != 0 || az != 0 {
    fx := s[0].fwd.x; fz := s[0].fwd.z; fl := sqrt(fx * fx + fz * fz);
    if fl > 0.0001 { fx /= fl; fz /= fl; }
    vx := s[0].right.x * ax + fx * az; vz := s[0].right.z * ax + fz * az;
    m := hi(abs(vx), abs(vz));
    ox := ifx vx > 0.4 * m then 1 else ifx vx < -0.4 * m then -1 else 0;
    oy := ifx vz > 0.4 * m then 1 else ifx vz < -0.4 * m then -1 else 0;
    guard := 0;
    while b[0].turn.move_left > 0 && guard < 16 {
      guard += 1;
      x := b[0].c[i].x; y := b[0].c[i].y;
      gone := false;
      for tr: 0..<3 {
        sx := ifx tr == 2 then 0 else ox; sy := ifx tr == 1 then 0 else oy;
        if sx == 0 && sy == 0 { continue; }
        nx := x + sx; ny := y + sy;
        if nx < 0 || ny < 0 || nx >= COLS || ny >= ROWS || rs_at(b, nx, ny) >= 0 { continue; }
        if rs_step_to(b, i, nx, ny) { gone = true; break; }
      }
      if !gone { break; }
    }
  } else if tgt >= 0 && b[0].c[i].ranged < 0 && b[0].c[i].spell_ability < 0 {
    walk(s, i, tgt, 0, 5);
  }
  foe := ifx tgt >= 0 then tgt else nearest_foe(s, i);
  if a.kind == AB_DASH || a.kind == AB_CDASH || a.kind == AB_WIND { if !b[0].turn.action { default_attack(s, i, foe); } return; }
  use_ab(s, i, a, foe);
}
// ---- the hotbar: each class's own abilities, a slot each
SLOTS :: 9;
AB_ATTACK :: 0; AB_DASH :: 1; AB_SPELL :: 2; AB_RECKLESS :: 3; AB_RAGE :: 4; AB_FLURRY :: 5; AB_PATIENT :: 6;
AB_WIND :: 7; AB_WHOLE :: 8; AB_SECOND :: 9; AB_SURGE :: 10; AB_LAY :: 11; AB_SACRED :: 12; AB_CDASH :: 13;
AB_AIM :: 14; AB_INNATE :: 15; AB_INSPIRE :: 16; AB_TURN :: 17; AB_PRESERVE :: 18; AB_LANDS :: 19;
TG_FOE :: 0; TG_POINT :: 1; TG_SELF :: 2; TG_ALLY :: 3;   // a spell's aim: your target, the ground under it, you, the friend most hurt
Ab :: struct { kind: int; sp: int; lvl: int; tg: int; name: string; }
mk_ab :: (kind: int, name: string) -> Ab { return Ab.{kind = kind, sp = -1, name = name}; }
spell_ab :: (sp: int, lvl: int, tg: int) -> Ab { return Ab.{kind = AB_SPELL, sp = sp, lvl = lvl, tg = tg, name = rs_spell(sp).name}; }
// The abilities a class's hotbar holds, in slot order (the ones its rules in the engine support).
abilities :: (kl: int, out: [] Ab) -> int {
  n := 0;
  if kl == RS_DRUID {
    out[0] = spell_ab(SP_STARRY_WISP, 0, TG_FOE); out[1] = spell_ab(SP_PRODUCE_FLAME, 0, TG_SELF); out[2] = spell_ab(SP_FLAME_HURL, 0, TG_FOE);
    out[3] = spell_ab(SP_THUNDERWAVE, 1, TG_POINT); out[4] = spell_ab(SP_ENTANGLE, 1, TG_POINT); out[5] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY);
    out[6] = spell_ab(SP_CALL_LIGHTNING, 3, TG_POINT); out[7] = mk_ab(AB_LANDS, "LAND'S AID"); out[8] = mk_ab(AB_DASH, "DASH"); n = 9;
  } else if kl == RS_WIZARD {
    out[0] = spell_ab(SP_FIRE_BOLT, 0, TG_FOE); out[1] = spell_ab(SP_CHILL_TOUCH, 0, TG_FOE); out[2] = spell_ab(SP_RAY_OF_SICKNESS, 1, TG_FOE);
    out[3] = spell_ab(SP_FALSE_LIFE, 1, TG_SELF); out[4] = spell_ab(SP_SCORCHING_RAY, 2, TG_FOE); out[5] = spell_ab(SP_BLINDNESS, 2, TG_FOE);
    out[6] = spell_ab(SP_FIREBALL, 3, TG_POINT); out[7] = mk_ab(AB_DASH, "DASH"); n = 8;
  } else if kl == RS_WARLOCK {
    out[0] = spell_ab(SP_ELDRITCH_BLAST, 0, TG_FOE); out[1] = spell_ab(SP_CHILL_TOUCH, 0, TG_FOE); out[2] = spell_ab(SP_HEX, 1, TG_FOE);
    out[3] = spell_ab(SP_HOLD_PERSON, 2, TG_FOE); out[4] = spell_ab(SP_SCORCHING_RAY, 2, TG_FOE); out[5] = spell_ab(SP_FIREBALL, 3, TG_POINT);
    out[6] = mk_ab(AB_DASH, "DASH"); n = 7;
  } else if kl == RS_SORCERER {
    out[0] = spell_ab(SP_FIRE_BOLT, 0, TG_FOE); out[1] = spell_ab(SP_SCORCHING_RAY, 2, TG_FOE); out[2] = spell_ab(SP_FIREBALL, 3, TG_POINT);
    out[3] = mk_ab(AB_INNATE, "INNATE SORCERY"); out[4] = mk_ab(AB_DASH, "DASH"); n = 5;
  } else if kl == RS_BARD {
    out[0] = spell_ab(SP_VICIOUS_MOCKERY, 0, TG_FOE); out[1] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY); out[2] = mk_ab(AB_INSPIRE, "BARDIC INSPIRATION");
    out[3] = spell_ab(SP_HYPNOTIC_PATTERN, 3, TG_POINT); out[4] = spell_ab(SP_FIREBALL, 3, TG_POINT); out[5] = mk_ab(AB_DASH, "DASH"); n = 6;
  } else if kl == RS_CLERIC {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_SACRED_FLAME, 0, TG_FOE); out[2] = spell_ab(SP_GUIDING_BOLT, 1, TG_FOE);
    out[3] = spell_ab(SP_HEALING_WORD, 1, TG_ALLY); out[4] = spell_ab(SP_SPIRIT_GUARDIANS, 3, TG_SELF); out[5] = mk_ab(AB_TURN, "TURN UNDEAD");
    out[6] = mk_ab(AB_PRESERVE, "PRESERVE LIFE"); out[7] = mk_ab(AB_DASH, "DASH"); n = 8;
  } else if kl == RS_FIGHTER {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_SECOND, "SECOND WIND"); out[2] = mk_ab(AB_SURGE, "ACTION SURGE"); out[3] = mk_ab(AB_DASH, "DASH"); n = 4;
  } else if kl == RS_PALADIN {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_DIVINE_SMITE, 1, TG_FOE); out[2] = mk_ab(AB_LAY, "LAY ON HANDS");
    out[3] = mk_ab(AB_SACRED, "SACRED WEAPON"); out[4] = spell_ab(SP_SACRED_FLAME, 0, TG_FOE); out[5] = mk_ab(AB_DASH, "DASH"); n = 6;
  } else if kl == RS_BARBARIAN {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_RECKLESS, "RECKLESS ATTACK"); out[2] = mk_ab(AB_RAGE, "RAGE"); out[3] = mk_ab(AB_DASH, "DASH"); n = 4;
  } else if kl == RS_MONK {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_FLURRY, "FLURRY OF BLOWS"); out[2] = mk_ab(AB_PATIENT, "PATIENT DEFENSE");
    out[3] = mk_ab(AB_WIND, "STEP OF THE WIND"); out[4] = mk_ab(AB_WHOLE, "WHOLENESS OF BODY"); out[5] = mk_ab(AB_DASH, "DASH"); n = 6;
  } else if kl == RS_ROGUE {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_AIM, "STEADY AIM"); out[2] = mk_ab(AB_CDASH, "CUNNING DASH"); out[3] = mk_ab(AB_DASH, "DASH"); n = 4;
  } else if kl == RS_RANGER {
    out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = spell_ab(SP_HUNTERS_MARK, 1, TG_FOE); out[2] = mk_ab(AB_DASH, "DASH"); n = 3;
  } else { out[0] = mk_ab(AB_ATTACK, "ATTACK"); out[1] = mk_ab(AB_DASH, "DASH"); n = 2; }
  return n;
}
// Whether a slot can be used now, from the hero's slots, uses, Rages and Focus.
ab_ready :: (s: [] Lab, i: int, a: Ab) -> bool {
  c := s[0].battle[0].c[i];
  if a.kind == AB_SPELL { return a.lvl == 0 || free_slot(s, i, a.lvl) > 0; }
  if a.kind == AB_RAGE { return c.rages > 0 && !c.raging; }
  if a.kind == AB_FLURRY || a.kind == AB_PATIENT || a.kind == AB_WIND { return c.focus > 0; }
  if a.kind == AB_WHOLE { return c.uses[RS_USE_WHOLE] > 0; }
  if a.kind == AB_SECOND { return c.uses[RS_USE_WIND] > 0; }
  if a.kind == AB_SURGE { return c.uses[RS_USE_SURGE] > 0; }
  if a.kind == AB_LAY { return c.uses[RS_USE_LAY] > 0; }
  if a.kind == AB_INSPIRE { return c.uses[RS_USE_INSPIRE] > 0; }
  if a.kind == AB_INNATE { return c.uses[RS_USE_INNATE] > 0; }
  if a.kind == AB_LANDS { return c.uses[RS_USE_WILD] > 0; }
  if a.kind == AB_TURN || a.kind == AB_PRESERVE || a.kind == AB_SACRED { return c.uses[RS_USE_CHANNEL] > 0; }
  return true;
}
// What a slot has left to show in its corner: spell slots at its level, uses, Rages or Focus (-1: none).
ab_left :: (s: [] Lab, i: int, a: Ab) -> int {
  c := s[0].battle[0].c[i];
  if a.kind == AB_SPELL { if a.lvl == 0 { return -1; } sl := free_slot(s, i, a.lvl); return ifx sl > 0 then c.slots[sl] else 0; }
  if a.kind == AB_RAGE { return c.rages; }
  if a.kind == AB_FLURRY || a.kind == AB_PATIENT || a.kind == AB_WIND { return c.focus; }
  if a.kind == AB_WHOLE { return c.uses[RS_USE_WHOLE]; }
  if a.kind == AB_SECOND { return c.uses[RS_USE_WIND]; }
  if a.kind == AB_SURGE { return c.uses[RS_USE_SURGE]; }
  if a.kind == AB_LAY { return c.uses[RS_USE_LAY]; }
  if a.kind == AB_INSPIRE { return c.uses[RS_USE_INSPIRE]; }
  if a.kind == AB_INNATE { return c.uses[RS_USE_INNATE]; }
  if a.kind == AB_LANDS { return c.uses[RS_USE_WILD]; }
  if a.kind == AB_TURN || a.kind == AB_PRESERVE || a.kind == AB_SACRED { return c.uses[RS_USE_CHANNEL]; }
  return -1;
}
// The friend nearest you that isn't you, or -1.
nearest_friend :: (s: [] Lab, i: int) -> int {
  b := bt(s);
  best := -1; bd := 100000;
  for j: 0..<b[0].n {
    if j == i || b[0].c[j].team != b[0].c[i].team || !rs_up(b[0].c[j]) { continue; }
    d := rs_feet_to(b, i, j);
    if d < bd { bd = d; best = j; }
  }
  return best;
}
// Attack: your foe if it's within reach, else whoever is, else a shot, else your first cantrip.
default_attack :: (s: [] Lab, i: int, foe: int) {
  b := bt(s);
  j := ifx foe >= 0 && rs_feet_to(b, i, foe) <= 5 then foe else foe_at_hand(s, i, -1);
  if j >= 0 { ok := rs_attack(b, i, j, false, -1); return; }
  if foe < 0 { return; }
  if b[0].c[i].ranged >= 0 { ok := rs_shoot(b, i, foe); return; }
  list: [SLOTS] Ab; n := abilities(b[0].c[i].klass, list[..]);
  for k: 0..<n {
    if list[k].kind == AB_SPELL && list[k].lvl == 0 && list[k].tg == TG_FOE { ok := rs_cast(b, i, list[k].sp, 0, 0, 0, foe); return; }
  }
}
// A slot used on your turn; a bonus-action one leaves your action, which then attacks.
use_ab :: (s: [] Lab, i: int, a: Ab, foe: int) {
  b := bt(s);
  ok := false;
  at := ifx foe >= 0 && rs_feet_to(b, i, foe) <= 5 then foe else foe_at_hand(s, i, -1);
  if a.kind == AB_ATTACK { default_attack(s, i, foe); return; }
  if a.kind == AB_SPELL {
    sl := ifx a.lvl == 0 then 0 else free_slot(s, i, a.lvl);
    if a.lvl > 0 && sl == 0 { default_attack(s, i, foe); return; }
    if a.tg == TG_SELF { ok = rs_cast(b, i, a.sp, sl, 0, 0, i); }
    else if a.tg == TG_ALLY { w := most_hurt(s, i, 60, 0.99); ok = rs_cast(b, i, a.sp, sl, 0, 0, ifx w >= 0 then w else i); }
    else if foe >= 0 && a.tg == TG_POINT { ok = rs_cast(b, i, a.sp, sl, b[0].c[foe].x, b[0].c[foe].y, -1); }
    else if foe >= 0 { ok = rs_cast(b, i, a.sp, sl, 0, 0, ifx a.sp == SP_DIVINE_SMITE && at >= 0 then at else foe); }
  }
  else if a.kind == AB_RECKLESS { if at >= 0 { ok = rs_attack(b, i, at, true, -1); } }
  else if a.kind == AB_RAGE { ok = rs_rage(b, i); }
  else if a.kind == AB_FLURRY { if at >= 0 { ok = rs_attack(b, i, at, false, -1); if rs_up(b[0].c[at]) { ok = rs_flurry(b, i, at, OH_TOPPLE); } } }
  else if a.kind == AB_PATIENT { ok = rs_patient_defense(b, i); }
  else if a.kind == AB_WHOLE { ok = rs_wholeness(b, i); }
  else if a.kind == AB_SECOND { ok = rs_second_wind(b, i); }
  else if a.kind == AB_SURGE { ok = rs_action_surge(b, i); }
  else if a.kind == AB_LAY { w := most_hurt(s, i, 5, 0.99); w = ifx w >= 0 then w else i; ok = rs_lay_on_hands(b, i, w, ifx b[0].c[w].hp == 0 then 5 else 10); }
  else if a.kind == AB_SACRED { ok = rs_sacred_weapon(b, i); }
  else if a.kind == AB_AIM { ok = rs_steady_aim(b, i); }
  else if a.kind == AB_INNATE { ok = rs_innate_sorcery(b, i); }
  else if a.kind == AB_INSPIRE { w := nearest_friend(s, i); if w >= 0 { ok = rs_inspire(b, i, w); } }
  else if a.kind == AB_TURN { ok = rs_turn_undead(b, i); }
  else if a.kind == AB_PRESERVE { ok = rs_preserve_life(b, i); }
  else if a.kind == AB_LANDS { if foe >= 0 { ok = rs_lands_aid(b, i, b[0].c[foe].x, b[0].c[foe].y, most_hurt(s, i, 60, 0.7)); } }
  if !b[0].turn.action { default_attack(s, i, foe); }
  // Action Surge gives a second action: attack with it too
  if a.kind == AB_SURGE && !b[0].turn.action { default_attack(s, i, foe); }
}
// The hero you play: the first of the Living's heroes of the picked class still up, or -1.
pick_hero :: (s: [] Lab) {
  b := bt(s);
  s[0].me = -1; s[0].target = -1;
  for i: 0..<rs_min(b[0].n, HEROES) {
    if b[0].c[i].team == 0 && b[0].c[i].klass == ROSTER[s[0].pick] && rs_up(b[0].c[i]) { s[0].me = i; return; }
  }
}
set_player :: (s: [] Lab, on: bool) {
  s[0].player = on;
  if on { pick_hero(s); } else { s[0].me = -1; s[0].target = -1; }
}

step :: (s: [] Lab, dt: f32) {
  b := bt(s);
  if s[0].over {
    b[0].clock += dt;
    if b[0].clock - s[0].over_t > 6 { new_battle(s); }
    return;
  }
  rs_tick(b, dt);
  guard := 0;
  due := rs_due(b);
  while due >= 0 && guard < 8 {
    lab_turn(s, due);
    guard += 1;
    due = rs_due(b);
  }
  take_events(s);
  if s[0].horde { flood(s); }
  // the last side standing wins (in the Horde, the dead stand while more are still to come)
  standing := 0; last := -1;
  for t: 0..<TEAMS { if rs_team_up(b, t) > 0 || (t == 2 && s[0].pool > 0) { standing += 1; last = t; } }
  if standing <= 1 && !s[0].over {
    s[0].over = true; s[0].over_t = b[0].clock; s[0].winner = last;
    l: [LINE_CAP] u8;
    n := 0;
    if last >= 0 { s[0].wins[last] += 1; n = put(l[..], 0, team_name(s, last)); n = put(l[..], n, " wins. A new battle in 6 seconds."); }
    else { n = put(l[..], 0, "Nobody is left standing. A new battle in 6 seconds."); }
    add_line(s, cast(string) l[0..<n], GOLD);
  }
  // the tokens go to their squares at a run (3.2 squares a second, faster the further they have to go)
  for i: 0..<b[0].n {
    gx := f32(b[0].c[i].x) - s[0].dx[i]; gy := f32(b[0].c[i].y) - s[0].dy[i];
    d := sqrt(gx * gx + gy * gy);
    if d < 0.0001 { continue; }
    go := lo(d, hi(3.2, d * 3) * dt);
    s[0].dx[i] += gx / d * go; s[0].dy[i] += gy / d * go;
  }
}

lab_run :: (s: [] Lab, dt: f32) {
  c := s[0].pace;
  c.step_ns = LAB_STEP_NS; c.max_frame_ns = LAB_FRAME_NS;
  c = loop_accept(c, cast(f64) dt);
  s[0].clock += cast(f32) loop_counted(c);
  speed: f32 = ifx s[0].fast then FAST else 1;
  for k: 0..<loop_due(c) { step(s, f32(STEP) * speed); }
  s[0].pace = loop_ran(c);
}

// ---- drawing

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { size = 0.01; dx = 0.01; dy = 0; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}
seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, w: f32, light: f32, c: Col) -> int {
  if lit(out, n, ax, ay, bx, by, w * 0.55, light, w * 1.8, c.r, c.g, c.b, 0) { return n + 6; }
  return n;
}
ring :: (out: [] f32, at: int, x: f32, y: f32, r: f32, w: f32, light: f32, c: Col) -> int {
  n := at;
  sides := 20;
  for i: 0..<sides {
    a0 := f32(i) * 6.2831853 / f32(sides); a1 := f32(i + 1) * 6.2831853 / f32(sides);
    n = seg(out, n, x + cos(a0) * r, y + sin(a0) * r, x + cos(a1) * r, y + sin(a1) * r, w, light, c);
  }
  return n;
}
box_lines :: (out: [] f32, at: int, r: Rect, w: f32, light: f32, c: Col) -> int {
  n := at;
  n = seg(out, n, r.x0, r.y0, r.x1, r.y0, w, light, c);
  n = seg(out, n, r.x1, r.y0, r.x1, r.y1, w, light, c);
  n = seg(out, n, r.x1, r.y1, r.x0, r.y1, w, light, c);
  n = seg(out, n, r.x0, r.y1, r.x0, r.y0, w, light, c);
  return n;
}
ink :: (k: f32, light: f32, c: Col) -> Ink {
  i: Ink;
  i.core = 0.6 * k; i.light = light; i.glow = 1.2 * k; i.red = c.r; i.green = c.g; i.blue = c.b; i.mode = 0; i.scale = k;
  return i;
}
say_at :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, k, false, false);
}
say_mid :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap) / 2, base, cap, k);
}
say_right :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap), base, cap, k);
}
// A square's middle on the screen.
scr_x :: (s: [] Lab, x: f32) -> f32 { return s[0].gx + (x + 0.5) * s[0].cell; }
scr_y :: (s: [] Lab, y: f32) -> f32 { return s[0].gy + (y + 0.5) * s[0].cell; }

norm3 :: (v: P3) -> P3 {
  l := sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
  if l <= 0 { return P3.{x = 0, y = 0, z = -1}; }
  return P3.{x = v.x / l, y = v.y / l, z = v.z / l};
}
// Where a square's middle is on the ground, metres.
wx :: (x: f32) -> f32 { return (x + 0.5) * f32(SQ) - f32(COLS) * f32(SQ) / 2; }
wz :: (y: f32) -> f32 { return (y + 0.5) * f32(SQ) - f32(ROWS) * f32(SQ) / 2; }
// A point in the glade on the screen: x, y (device px) and its depth (0 or less: behind the eye).
proj :: (s: [] Lab, x: f32, y: f32, z: f32) -> P3 {
  dx := x - s[0].eye.x; dy := y - s[0].eye.y; dz := z - s[0].eye.z;
  depth := dx * s[0].fwd.x + dy * s[0].fwd.y + dz * s[0].fwd.z;
  if depth <= 0.05 { return P3.{x = 0, y = 0, z = 0}; }
  a := (dx * s[0].right.x + dy * s[0].right.y + dz * s[0].right.z) / depth;
  b := (dx * s[0].up.x + dy * s[0].up.y + dz * s[0].up.z) / depth;
  return P3.{x = s[0].cx + a * s[0].focal, y = s[0].cy - b * s[0].focal, z = depth};
}
seg3 :: (s: [] Lab, out: [] f32, n: int, a: P3, b: P3, w: f32, light: f32, c: Col) -> int {
  pa := proj(s, a.x, a.y, a.z); pb := proj(s, b.x, b.y, b.z);
  if pa.z <= 0 || pb.z <= 0 { return n; }
  return seg(out, n, pa.x, pa.y, pb.x, pb.y, w, light, c);
}
ring3 :: (s: [] Lab, out: [] f32, at: int, x: f32, z: f32, r: f32, y: f32, w: f32, light: f32, c: Col) -> int {
  n := at;
  for i: 0..<24 {
    a0 := f32(i) * 6.2831853 / 24; a1 := f32(i + 1) * 6.2831853 / 24;
    n = seg3(s, out, n, P3.{x = x + cos(a0) * r, y = y, z = z + sin(a0) * r}, P3.{x = x + cos(a1) * r, y = y, z = z + sin(a1) * r}, w, light, c);
  }
  return n;
}

layout :: (s: [] Lab, w: f32, h: f32, k: f32) {
  s[0].portrait = h > w * 1.1;
  pad := 16 * k;
  top := ifx s[0].portrait then 92 * k else 64 * k;
  gw := w - pad * 2; gh := h - top - pad;
  if s[0].portrait {
    gh = h * 0.42;
    s[0].panel = Rect.{x0 = pad, y0 = top + gh + pad, x1 = w - pad, y1 = h - pad};
  } else {
    pw := lo(hi(w * 0.34, 300 * k), 560 * k);
    gw = w - pw - pad * 3;
    s[0].panel = Rect.{x0 = w - pw - pad, y0 = top, x1 = w - pad, y1 = h - pad};
  }
  cell := lo(gw / f32(COLS), gh / f32(ROWS));
  s[0].cell = cell;
  s[0].gx = pad + (gw - cell * f32(COLS)) / 2;
  s[0].gy = top + (gh - cell * f32(ROWS)) / 2;
  bw := 96 * k;
  s[0].back = Rect.{x0 = w - pad - bw, y0 = 18 * k, x1 = w - pad, y1 = 46 * k};
  s[0].flip = Rect.{x0 = s[0].back.x0 - 8 * k - bw, y0 = 18 * k, x1 = s[0].back.x0 - 8 * k, y1 = 46 * k};
  mw := 128 * k;
  s[0].modal = Rect.{x0 = s[0].flip.x0 - 8 * k - mw, y0 = 18 * k, x1 = s[0].flip.x0 - 8 * k, y1 = 46 * k};
  // a phone has no room beside the title: the mode sits in the scene's bottom-left corner
  if s[0].portrait { s[0].modal = Rect.{x0 = pad, y0 = s[0].panel.y0 - 8 * k - 28 * k, x1 = pad + mw, y1 = s[0].panel.y0 - 8 * k}; }
  pbw := 104 * k;
  s[0].pbtn = Rect.{x0 = s[0].modal.x0 - 8 * k - pbw, y0 = s[0].modal.y0, x1 = s[0].modal.x0 - 8 * k, y1 = s[0].modal.y1};
  if s[0].portrait { s[0].pbtn = Rect.{x0 = s[0].modal.x1 + 8 * k, y0 = s[0].modal.y0, x1 = s[0].modal.x1 + 8 * k + pbw, y1 = s[0].modal.y1}; }
  // Player mode: the class picker along the scene's top, the hotbar centred at its foot
  scx0 := pad; scx1 := ifx s[0].portrait then w - pad else s[0].panel.x0 - pad;
  scy1 := ifx s[0].portrait then s[0].modal.y0 - 8 * k else h - pad;
  pg := 4 * k; pwid := (scx1 - scx0 - 11 * pg) / 12;
  for c: 0..<12 { s[0].picks[c] = Rect.{x0 = scx0 + f32(c) * (pwid + pg), y0 = top + 6 * k, x1 = scx0 + f32(c) * (pwid + pg) + pwid, y1 = top + 30 * k}; }
  nslot := 0;
  if s[0].player && s[0].me >= 0 { list: [SLOTS] Ab; nslot = abilities(s[0].battle[0].c[s[0].me].klass, list[..]); }
  sg := 6 * k; slot := lo(64 * k, (scx1 - scx0 - f32(SLOTS - 1) * sg) / f32(SLOTS));
  hx0 := (scx0 + scx1) / 2 - (f32(nslot) * slot + f32(rs_max(nslot - 1, 0)) * sg) / 2;
  for c: 0..<SLOTS {
    s[0].slots[c] = Rect.{};
    if c < nslot { s[0].slots[c] = Rect.{x0 = hx0 + f32(c) * (slot + sg), y0 = scy1 - 20 * k - slot, x1 = hx0 + f32(c) * (slot + sg) + slot, y1 = scy1 - 20 * k}; }
  }
  if !s[0].player { for c: 0..<12 { s[0].picks[c] = Rect.{}; } }
  // the glade's camera, fitted to the space left of the log (above it on a phone)
  rx0 := pad; rx1 := ifx s[0].portrait then w - pad else s[0].panel.x0 - pad;
  ry0 := top; ry1 := ifx s[0].portrait then s[0].panel.y0 - pad else h - pad;
  s[0].cx = (rx0 + rx1) / 2; s[0].cy = (ry0 + ry1) / 2;
  // Aethyr's orbit (yaw 0 faces +Z there; here yaw 0 looks toward -Z, so it turns half round)
  turn := s[0].yaw + 3.14159265;
  ray := ash.shot_orbit_ray(asp.world_point(s[0].px, 0.5, s[0].pz), turn, s[0].pitch, s[0].dist, 0);
  shot := ash.shot_orbit(ray, ray.far, turn, s[0].pitch);
  s[0].eye = P3.{x = shot.eye.x, y = shot.eye.y, z = shot.eye.z};
  s[0].fwd = norm3(P3.{x = shot.at.x - shot.eye.x, y = shot.at.y - shot.eye.y, z = shot.at.z - shot.eye.z});
  s[0].right = norm3(P3.{x = -s[0].fwd.z, y = 0, z = s[0].fwd.x});
  r := s[0].right; f := s[0].fwd;
  s[0].up = P3.{x = r.y * f.z - r.z * f.y, y = r.z * f.x - r.x * f.z, z = r.x * f.y - r.y * f.x};
  s[0].focal = lo((rx1 - rx0) * 27 / (30 * f32(COLS) / 16), (ry1 - ry0) * 27 / (19 * f32(ROWS) / 10));   // fitted at the default orbit; + and - zoom from there
}

draw_zones :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; c := s[0].cell;
  for z: 0..<RS_ZONES {
    zo := s[0].battle[0].zone[z];
    if !zo.on { continue; }
    col := spell_col(zo.spell);
    r := Rect.{x0 = s[0].gx + f32(zo.x0) * c, y0 = s[0].gy + f32(zo.y0) * c, x1 = s[0].gx + f32(zo.x1 + 1) * c, y1 = s[0].gy + f32(zo.y1 + 1) * c};
    r.x0 = hi(r.x0, s[0].gx); r.y0 = hi(r.y0, s[0].gy);
    r.x1 = lo(r.x1, s[0].gx + c * f32(COLS)); r.y1 = lo(r.y1, s[0].gy + c * f32(ROWS));
    n = box_lines(out, n, r, 1.2 * k, 0.55, col);
    for y: zo.y0..<(zo.y1 + 1) {
      for x: zo.x0..<(zo.x1 + 1) {
        if x < 0 || y < 0 || x >= COLS || y >= ROWS { continue; }
        px := s[0].gx + f32(x) * c; py := s[0].gy + f32(y) * c;
        if zo.spell == SP_ENTANGLE {
          // plants: a few sprigs to a square
          w := 0.08 * sin(t * 1.7 + f32(x * 3 + y));
          n = seg(out, n, px + c * 0.25, py + c * 0.8, px + c * (0.3 + w), py + c * 0.45, 1.0 * k, 0.4, col);
          n = seg(out, n, px + c * 0.6, py + c * 0.85, px + c * (0.55 - w), py + c * 0.5, 1.0 * k, 0.4, col);
          n = seg(out, n, px + c * 0.75, py + c * 0.7, px + c * (0.82 + w), py + c * 0.35, 1.0 * k, 0.4, col);
        } else {
          // faerie light: motes that drift
          for m: 0..<2 {
            ph := t * 0.9 + f32(x * 7 + y * 13 + m * 5);
            mx := px + c * (0.3 + 0.4 * f32(m)) + sin(ph) * c * 0.12;
            my := py + c * 0.5 + cos(ph * 1.3) * c * 0.2;
            n = seg(out, n, mx, my, mx + 0.5, my, 1.6 * k, 0.5 + 0.3 * sin(ph * 2), col);
          }
        }
      }
    }
  }
  return n;
}

draw_tokens :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; c := s[0].cell;
  b := s[0].battle[0];
  for i: 0..<b.n {
    cr := b.c[i];
    x := scr_x(s, s[0].dx[i]); y := scr_y(s, s[0].dy[i]);
    col := TEAM_COL[cr.team];
    r := c * 0.34;
    if cr.dead {
      g := FAINT;
      n = seg(out, n, x - r * 0.6, y - r * 0.6, x + r * 0.6, y + r * 0.6, 2 * k, 0.5, g);
      n = seg(out, n, x - r * 0.6, y + r * 0.6, x + r * 0.6, y - r * 0.6, 2 * k, 0.5, g);
      n = ring(out, n, x, y, r, 1 * k, 0.3, g);
      continue;
    }
    down := cr.hp == 0;
    light: f32 = ifx down then 0.35 else 0.95;
    if down { col = DIM; }
    // whose turn just ran: a white ring that fades
    since := b.clock - s[0].acted[i];
    if since >= 0 && since < 1.2 { n = ring(out, n, x, y, r * (1.25 + since * 0.2), 1.4 * k, 0.9 * (1 - since / 1.2), WHITE); }
    if cr.outlined_by >= 0 { n = ring(out, n, x, y, r * 1.12, 2.2 * k, 0.55 + 0.25 * sin(t * 5), VIOLET); }
    n = ring(out, n, x, y, r, 2.2 * k, light, col);
    n = ring(out, n, x, y, r * 0.55, 1.1 * k, light * 0.5, col);
    if down {
      // Unconscious: the death saves, as ticks
      for d: 0..<3 {
        ok := d < cr.death_ok; bad := d < cr.death_fail;
        n = seg(out, n, x - r * 0.5 + f32(d) * r * 0.5, y - r * 0.15, x - r * 0.5 + f32(d) * r * 0.5, y - r * 0.15 + 0.5, 3 * k, 0.8, ifx ok then GREEN else FAINT);
        n = seg(out, n, x - r * 0.5 + f32(d) * r * 0.5, y + r * 0.25, x - r * 0.5 + f32(d) * r * 0.5, y + r * 0.25 + 0.5, 3 * k, 0.8, ifx bad then RED else FAINT);
      }
    }
    if rs_has(cr, RS_RESTRAINED) {
      g := spell_col(SP_ENTANGLE);
      for v: 0..<4 {
        a := f32(v) * 1.5708 + t * 0.4;
        n = seg(out, n, x + cos(a) * r * 1.05, y + sin(a) * r * 1.05, x + cos(a + 0.9) * r * 0.75, y + sin(a + 0.9) * r * 0.75, 1.6 * k, 0.8, g);
      }
    }
    if cr.flame_until > b.clock {
      fl := spell_col(SP_PRODUCE_FLAME);
      fx := x + r * 0.95; fy := y - r * 0.85;
      n = seg(out, n, fx, fy + 3 * k, fx + sin(t * 9) * 1.5 * k, fy - 5 * k, 3 * k, 0.9, fl);
    }
    if cr.wisp_until > b.clock { n = ring(out, n, x, y, r * 0.2, 2 * k, 0.9, spell_col(SP_STARRY_WISP)); }
    // the name, and the hit points
    cap := lo(hi(c * 0.15, 8 * k), 14 * k);
    nm := cast(string) b.c[i].name[0..<b.c[i].name_n];
    n = say_mid(out, n, nm, x, y - r - 5 * k, cap, ink(k, light * 0.85, col));
    bw := c * 0.7; by := y + r + 6 * k;
    share := f32(cr.hp) / f32(rs_max(cr.hp_max, 1));
    n = seg(out, n, x - bw / 2, by, x + bw / 2, by, 2.4 * k, 0.18, FAINT);
    hc := ifx share > 0.5 then GREEN else ifx share > 0.25 then GOLD else RED;
    if share > 0 { n = seg(out, n, x - bw / 2, by, x - bw / 2 + bw * share, by, 2.4 * k, 0.85, hc); }
    if cr.conc >= 0 {
      cc := spell_col(cr.conc);
      n = seg(out, n, x - bw / 2, by + 5 * k, x + bw / 2, by + 5 * k, 1.0 * k, 0.6, cc);
    }
  }
  return n;
}

draw_fx :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at; c := s[0].cell;
  s[0].puffs[0].out_n = 0;   // the flat view's effects are strokes
  now := s[0].battle[0].clock;
  for i: 0..<FXS {
    f := s[0].fx[i];
    if f.kind == 0 { continue; }
    a := (now - f.t0) / f.life;
    if a < 0 || a > 1 { continue; }
    if f.kind == FX_BOLT {
      ax := scr_x(s, f.ax); ay := scr_y(s, f.ay); bx := scr_x(s, f.bx); by := scr_y(s, f.by);
      head := lo(1, a * 2.2); tail := lo(1, hi(0, a * 2.2 - 0.5));
      n = seg(out, n, ax + (bx - ax) * tail, ay + (by - ay) * tail, ax + (bx - ax) * head, ay + (by - ay) * head, 3 * k, 1.0 - a * 0.5, f.col);
    }
    if f.kind == FX_FLASH {
      r := Rect.{x0 = s[0].gx + f.ax * c, y0 = s[0].gy + f.ay * c, x1 = s[0].gx + f.bx * c, y1 = s[0].gy + f.by * c};
      grow := a * c * 0.3;
      r.x0 -= grow; r.y0 -= grow; r.x1 += grow; r.y1 += grow;
      n = box_lines(out, n, r, 3 * k * (1 - a) + 0.5 * k, 1 - a, f.col);
    }
    if f.kind == FX_TEXT {
      x := scr_x(s, f.ax) + c * 0.3; y := scr_y(s, f.ay) - c * 0.3 - a * c * 0.5;
      n = say_mid(out, n, cast(string) f.text[0..<f.n], x, y, lo(hi(c * 0.22, 11 * k), 20 * k), ink(k, 1 - a * 0.7, f.col));
    }
    if f.kind == FX_RING { n = ring(out, n, scr_x(s, f.ax), scr_y(s, f.ay), c * (0.35 + a * 0.4), 2 * k, 1 - a, f.col); }
  }
  return n;
}

// The glade's labels: each druid's name and hit points over its head.
draw_labels3 :: (s: [] Lab, out: [] f32, at: int, k: f32, t: f32) -> int {
  n := at; b := s[0].battle[0];
  for i: 0..<b.n {
    cr := b.c[i];
    x := wx(s[0].dx[i]); z := wz(s[0].dy[i]);
    lift: f32 = ifx cr.hp == 0 then 0.75 else 2.2;
    p := proj(s, x, lift, z);
    if p.z <= 0 { continue; }
    col := ifx cr.dead then FAINT else ifx cr.hp == 0 then DIM else TEAM_COL[cr.team];
    if cr.klass == RS_MONSTER && cr.dead { continue; }
    nm := cast(string) cr.name[0..<cr.name_n];
    if cr.klass != RS_MONSTER { n = say_mid(out, n, nm, p.x, p.y - 8 * k, 10 * k, ink(k, 0.95, col)); }
    if cr.dead { continue; }
    bw := ifx cr.klass == RS_MONSTER then 26 * k else 46 * k; by := p.y;
    share := f32(cr.hp) / f32(rs_max(cr.hp_max, 1));
    n = seg(out, n, p.x - bw / 2, by, p.x + bw / 2, by, 2.6 * k, 0.25, FAINT);
    hc := ifx share > 0.5 then GREEN else ifx share > 0.25 then GOLD else RED;
    if share > 0 { n = seg(out, n, p.x - bw / 2, by, p.x - bw / 2 + bw * share, by, 2.6 * k, 0.95, hc); }
    if cr.conc >= 0 { n = seg(out, n, p.x - bw / 2, by + 5 * k, p.x + bw / 2, by + 5 * k, 1.1 * k, 0.8, spell_col(cr.conc)); }
    if cr.hp == 0 {
      for d: 0..<3 {
        ok := d < cr.death_ok; bad := d < cr.death_fail;
        tick_x := p.x - 10 * k + f32(d) * 10 * k;
        n = seg(out, n, tick_x, by + 11 * k, tick_x + 0.5, by + 11 * k, 3 * k, 0.9, ifx ok then GREEN else ifx bad then RED else FAINT);
      }
    }
    if cr.flame_until > b.clock {
      fl := spell_col(SP_PRODUCE_FLAME);
      q := proj(s, x + 0.42, 2.0, z + 0.08);
      if q.z > 0 { n = seg(out, n, q.x, q.y + 3 * k, q.x + sin(t * 9) * 1.5 * k, q.y - 7 * k, 4 * k, 1.0, fl); }
    }
  }
  return n;
}
// The glade's effects: the frame's puffs (aethyr/fx/puff.coax) for the host to draw over bg_fs
// (fivelab-fx.wgsl, host.js particles), the lasting zones' motes with them; only the numbers that
// float off a figure are strokes.
draw_fx3 :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at;
  now := s[0].battle[0].clock;
  pf := s[0].puffs[..];
  if now < s[0].fx_last { fxp_clear(pf); }   // a new battle: its clock starts again
  s[0].fx_last = now;
  fxp_begin(pf, now, fxp_v(s[0].eye.x, s[0].eye.y, s[0].eye.z));
  fxp_emit_all(pf, now);
  for z: 0..<RS_ZONES {
    zo := s[0].battle[0].zone[z];
    if !zo.on { continue; }
    zc := fx_col(zo.spell);
    fxp_zone(pf, wx(f32(zo.x0)) - f32(SQ) / 2, wz(f32(zo.y0)) - f32(SQ) / 2, wx(f32(zo.x1)) + f32(SQ) / 2, wz(f32(zo.y1)) + f32(SQ) / 2, zc, s[0].clock, f32(z) * 3.1 + 0.7);
  }
  // what lasts on each creature: a few puffs each, capped (FX_STATUS_CAP), after the effects
  for i: 0..<s[0].battle[0].n {
    lf := fx_lasting(s, i);
    if lf == 0 { continue; }
    feet := fxp_v(wx(s[0].dx[i]), 0, wz(s[0].dy[i]));
    fxp_status(pf, feet, fxp_v(feet.x + 0.3, 1.1, feet.z), lf, now, f32(i) * 1.37 + 0.4);
  }
  rep := fxp_close(pf);
  for i: 0..<FXS {
    f := s[0].fx[i];
    if f.kind != FX_TEXT { continue; }
    a := (now - f.t0) / f.life;
    if a < 0 || a > 1 { continue; }
    p := proj(s, wx(f.ax) + 0.4, 2.3 + a * 1.0, wz(f.ay));
    if p.z > 0 { n = say_mid(out, n, cast(string) f.text[0..<f.n], p.x + 24 * k, p.y - 14 * k, 15 * k, ink(k, 1 - a * 0.7, f.col)); }
  }
  return n;
}

draw_panel :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at; p := s[0].panel; b := s[0].battle[0];
  n = box_lines(out, n, p, 0.6 * k, 0.3, DIM);
  pad := 12 * k; x := p.x0 + pad; y := p.y0 + pad;
  cap := 8.5 * k; row := 16 * k;
  crow := 11.5 * k;
  // the characters
  y += cap;
  n = say_at(out, n, "CHARACTERS", x, y, cap, ink(k, 0.6, DIM));
  y += row * 0.6;
  l: [LINE_CAP] u8;
  // the two sides in two columns, a row each
  top := y; half := (p.x1 - p.x0) / 2;
  for i: 0..<rs_min(b.n, HEROES) {
    cr := b.c[i];
    x = p.x0 + pad + f32(i / SIDE) * half;
    y = top + f32(i % SIDE + 1) * crow;
    col := ifx cr.dead then FAINT else TEAM_COL[cr.team];
    n = say_at(out, n, cast(string) cr.name[0..<cr.name_n], x, y, cap * 0.92, ink(k, 0.85, col));
    m := put(l[..], 0, "HP ");
    m = put_int(l[..], m, cr.hp); m = put(l[..], m, "/"); m = put_int(l[..], m, cr.hp_max);
    if cr.temp > 0 { m = put(l[..], m, " +"); m = put_int(l[..], m, cr.temp); }
    m = put(l[..], m, "  AC "); m = put_int(l[..], m, cr.ac);
    kl := cr.klass;
    if kl == RS_BARBARIAN { m = put(l[..], m, "  RAGES "); m = put_int(l[..], m, cr.rages); }
    else if kl == RS_MONK { m = put(l[..], m, "  FOCUS "); m = put_int(l[..], m, cr.focus); }
    else if kl == RS_FIGHTER {
      m = put(l[..], m, "  SECOND WIND "); m = put_int(l[..], m, cr.uses[RS_USE_WIND]);
      m = put(l[..], m, "  SURGE "); m = put_int(l[..], m, cr.uses[RS_USE_SURGE]);
    }
    else if kl == RS_ROGUE { m = put(l[..], m, "  SNEAK "); m = put_int(l[..], m, cr.sneak_dice); m = put(l[..], m, "D6"); }
    else {
      // the slots it has, lowest level first: 4+3+3 (Pact Magic's are all of one level)
      m = put(l[..], m, "  SLOTS "); first := true;
      for sl_: 1..<10 {
        if cr.slots_max[sl_] <= 0 { continue; }
        if !first { m = put(l[..], m, "+"); }
        m = put_int(l[..], m, cr.slots[sl_]); first = false;
      }
    }
    if kl == RS_DRUID { m = put(l[..], m, "  LAND'S AID "); m = put_int(l[..], m, cr.uses[RS_USE_WILD]); }
    if kl == RS_BARD { m = put(l[..], m, "  INSP "); m = put_int(l[..], m, cr.uses[RS_USE_INSPIRE]); }
    if kl == RS_CLERIC || kl == RS_PALADIN { m = put(l[..], m, "  CHANNEL "); m = put_int(l[..], m, cr.uses[RS_USE_CHANNEL]); }
    if kl == RS_PALADIN { m = put(l[..], m, "  LAY ON HANDS "); m = put_int(l[..], m, cr.uses[RS_USE_LAY]); }
    if kl == RS_RANGER { m = put(l[..], m, "  MARKS "); m = put_int(l[..], m, cr.uses[RS_USE_FREE]); }
    if kl == RS_SORCERER { m = put(l[..], m, "  SORCERY "); m = put_int(l[..], m, cr.uses[RS_USE_SORCERY]); }
    m0 := m;   // the resources; what follows is its state, dropped when the row has no room
    if cr.dead { m = put(l[..], 0, "DEAD"); m0 = m; }
    else if cr.hp == 0 { m = put(l[..], m, cast(string) (ifx cr.stable then "  STABLE" else "  DYING")); }
    else {
      if rs_has(cr, RS_RESTRAINED) { m = put(l[..], m, "  RESTRAINED"); }
      if rs_has(cr, RS_POISONED) { m = put(l[..], m, "  POISONED"); }
      if rs_has(cr, RS_BLINDED) { m = put(l[..], m, "  BLINDED"); }
      if rs_effect(cr, EF_ENFEEBLED) { m = put(l[..], m, "  ENFEEBLED"); }
      if rs_effect(cr, EF_NOHEAL) { m = put(l[..], m, "  CHILLED"); }
      if rs_has(cr, RS_PARALYZED) { m = put(l[..], m, "  PARALYZED"); }
      if rs_effect(cr, EF_HEX) { m = put(l[..], m, "  HEXED"); }
      if rs_has(cr, RS_PRONE) { m = put(l[..], m, "  PRONE"); }
      if rs_effect(cr, EF_MARK) { m = put(l[..], m, "  MARKED"); }
      if rs_effect(cr, EF_EXPOSED) { m = put(l[..], m, "  LIT"); }
      if cr.slowed_until > b.clock { m = put(l[..], m, "  SLOWED"); }
      if cr.inspired > 0 { m = put(l[..], m, "  INSPIRED"); }
      if cr.innate_until > b.clock { m = put(l[..], m, "  INNATE SORCERY"); }
      if cr.shield_until > b.clock { m = put(l[..], m, "  SHIELD"); }
      if cr.sacred_until > b.clock { m = put(l[..], m, "  SACRED WEAPON"); }
      if cr.raging { m = put(l[..], m, "  RAGING"); }
      if cr.reckless_until > b.clock { m = put(l[..], m, "  RECKLESS"); }
      if cr.dodge_until > b.clock { m = put(l[..], m, "  DODGING"); }
      if cr.conc >= 0 { m = put(l[..], m, "  CONC: "); m = put(l[..], m, rs_spell(cr.conc).name); }
    }
    room := half - 58 * k - pad;
    if text_width(cast(string) l[0..<m], cap * 0.8) > room * 1.25 { m = m0; }
    t := cast(string) l[0..<m];
    cp := lo(cap * 0.8, cap * 0.8 * (half - 58 * k - pad) / hi(text_width(t, cap * 0.8), 1));
    n = say_at(out, n, t, x + 54 * k, y, cp, ink(k, 0.6, DIM));
  }
  x = p.x0 + pad; y = top + f32(SIDE) * crow;
  // the Restless Dead, counted
  if true {
    up := 0; hp := 0;
    for i: HEROES..<b.n { if rs_up(b.c[i]) { up += 1; hp += b.c[i].hp; } }
    y += crow * 1.4;
    n = say_at(out, n, "SKELETONS", x, y, cap * 0.92, ink(k, 0.85, ifx up > 0 then TEAM_COL[2] else FAINT));
    m := put(l[..], 0, ""); m = put_int(l[..], m, up); m = put(l[..], m, " OF "); m = put_int(l[..], m, s[0].skeletons);
    m = put(l[..], m, " STANDING  HP "); m = put_int(l[..], m, hp);
    if s[0].pool > 0 { m = put(l[..], m, "  "); m = put_int(l[..], m, s[0].pool); m = put(l[..], m, " MORE COMING"); }
    m = put(l[..], m, "  AC 14  SHORTSWORD AND SHORTBOW");
    n = say_at(out, n, cast(string) l[0..<m], x + 84 * k, y, cap * 0.85, ink(k, 0.6, DIM));
  }
  y += row * 1.2;
  n = seg(out, n, p.x0 + pad, y, p.x1 - pad, y, 0.6 * k, 0.25, DIM);
  // the log, newest at the bottom
  foot := p.y1 - pad - 18 * k;
  lines := int((foot - y - row * 0.5) / row);
  lines = rs_max(rs_min(lines, s[0].line_n), 0);
  ly := foot - f32(lines - 1) * row;
  for j: 0..<lines {
    ln := s[0].lines[s[0].line_n - lines + j];
    t := cast(string) ln.text[0..<ln.n];
    cp := lo(cap, cap * (p.x1 - p.x0 - pad * 2) / hi(text_width(t, cap), 1));
    n = say_at(out, n, t, x, ly + f32(j) * row, cp, ink(k, 0.8, ln.col));
  }
  // the attribution the SRD's licence asks for
  n = say_at(out, n, "SRD 5.2.1 BY WIZARDS OF THE COAST LLC, CC BY 4.0", x, p.y1 - pad, 7.5 * k, ink(k, 0.4, FAINT));
  return n;
}

// The token under (x, y) on the screen that's a foe of yours, or -1.
token_at :: (s: [] Lab, x: f32, y: f32) -> int {
  b := s[0].battle[0];
  best := -1; bd := 40 * hi(s[0].dpr, 1);
  for i: 0..<b.n {
    if !rs_up(b.c[i]) || (s[0].me >= 0 && b.c[i].team == b.c[s[0].me].team) { continue; }
    p := proj(s, wx(s[0].dx[i]), 0.9, wz(s[0].dy[i]));
    if p.z <= 0 { continue; }
    d := abs(p.x - x) + abs(p.y - y);
    if d < bd { bd = d; best = i; }
  }
  return best;
}
// A slot's picture, in strokes, by what the ability does: a blade for blows, a burst in the
// spell's colour for spells, a cross for healing, chevrons for moving, a ring for the rest.
ab_icon :: (out: [] f32, at: int, r: Rect, a: Ab, k: f32, c: Col) -> int {
  n := at; cx := (r.x0 + r.x1) / 2; cy := (r.y0 + r.y1) / 2 - 5 * k; e := (r.x1 - r.x0) * 0.22; w := 2.2 * k;
  heal := a.kind == AB_SECOND || a.kind == AB_LAY || a.kind == AB_WHOLE || a.kind == AB_PRESERVE || (a.kind == AB_SPELL && (a.sp == SP_HEALING_WORD || a.sp == SP_CURE_WOUNDS || a.sp == SP_FALSE_LIFE));
  if heal {
    n = seg(out, n, cx, cy - e, cx, cy + e, w * 1.4, 0.95, GREEN);
    n = seg(out, n, cx - e, cy, cx + e, cy, w * 1.4, 0.95, GREEN);
  } else if a.kind == AB_SPELL {
    sc := spell_col(a.sp);
    for q: 0..<8 { an := f32(q) * 0.7853982; n = seg(out, n, cx + cos(an) * e * 0.3, cy + sin(an) * e * 0.3, cx + cos(an) * e, cy + sin(an) * e, w, 0.95, sc); }
  } else if a.kind == AB_ATTACK || a.kind == AB_RECKLESS || a.kind == AB_FLURRY {
    n = seg(out, n, cx - e, cy + e, cx + e, cy - e, w, 0.95, c);
    n = seg(out, n, cx - e * 0.75, cy + e * 0.15, cx - e * 0.15, cy + e * 0.75, w, 0.95, c);
    if a.kind != AB_ATTACK { n = seg(out, n, cx - e, cy - e, cx + e, cy + e, w, 0.95, ifx a.kind == AB_RECKLESS then RED else c); }
  } else if a.kind == AB_DASH || a.kind == AB_CDASH || a.kind == AB_WIND {
    for v: 0..<2 { ox := f32(v) * e * 0.8 - e * 0.5; n = seg(out, n, cx + ox - e * 0.4, cy - e * 0.6, cx + ox + e * 0.2, cy, w, 0.95, c); n = seg(out, n, cx + ox + e * 0.2, cy, cx + ox - e * 0.4, cy + e * 0.6, w, 0.95, c); }
  } else {
    col := ifx a.kind == AB_RAGE then RED else GOLD;
    for q: 0..<12 { a0 := f32(q) * 0.5235988; a1 := f32(q + 1) * 0.5235988; n = seg(out, n, cx + cos(a0) * e * 0.8, cy + sin(a0) * e * 0.8, cx + cos(a1) * e * 0.8, cy + sin(a1) * e * 0.8, w, 0.95, col); }
    n = seg(out, n, cx, cy - e * 0.35, cx, cy + e * 0.35, w, 0.95, col);
  }
  return n;
}
// Player mode's bar: the Spectator/Player switch always; when playing, the class picker, your
// hero's ring and your target's, and the hotbar, each slot filling as your next turn comes round.
draw_player :: (s: [] Lab, out: [] f32, at: int, k: f32) -> int {
  n := at;
  pb := s[0].pbtn;
  n = box_lines(out, n, pb, 0.8 * k, ifx s[0].pressing == 4 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].player then "PLAYER" else "SPECTATOR", (pb.x0 + pb.x1) / 2, (pb.y0 + pb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, ifx s[0].player then GOLD else WHITE));
  if !s[0].player { return n; }
  b := bt(s);
  for c: 0..<12 {
    r := s[0].picks[c];
    on := c == s[0].pick;
    n = box_lines(out, n, r, 0.8 * k, ifx on then 0.95 else 0.4, ifx on then GOLD else DIM);
    nm := RS_CLASS[ROSTER[c]];
    cp := lo(8 * k, 8 * k * (r.x1 - r.x0 - 6 * k) / hi(text_width(nm, 8 * k), 1));
    n = say_mid(out, n, nm, (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2 + 4 * k, cp, ink(k, ifx on then 1 else 0.7, ifx on then GOLD else WHITE));
  }
  me := s[0].me;
  if s[0].view == VIEW_GLADE {
    if me >= 0 { n = ring3(s, out, n, wx(s[0].dx[me]), wz(s[0].dy[me]), 0.78, 0.06, 2.5 * k, 1, GOLD); }
    if s[0].target >= 0 && rs_up(b[0].c[s[0].target]) { n = ring3(s, out, n, wx(s[0].dx[s[0].target]), wz(s[0].dy[s[0].target]), 0.7, 0.06, 2.5 * k, 1, RED); }
  }
  // the hotbar: your class's abilities, keys 1 to 9; the picked one gold, a spent one dim, and
  // every slot filling from its foot as your next turn comes round
  ready := 1.0f32;
  if me >= 0 { ready = lo(1, hi(0, (b[0].clock - s[0].acted[me]) / rs_beat(b))); }
  list: [SLOTS] Ab; nab := 0;
  if me >= 0 { nab = abilities(b[0].c[me].klass, list[..]); }
  for c: 0..<nab {
    r := s[0].slots[c];
    a := list[c];
    on := c == s[0].act;
    can := ab_ready(s, me, a);
    n = box_lines(out, n, r, ifx on then 1.6 * k else 0.9 * k, ifx on then 1 else ifx can then 0.6 else 0.25, ifx on then GOLD else DIM);
    fill := (r.y1 - r.y0 - 4 * k) * ready;
    for row: 0..<6 { yy := r.y1 - 2 * k - fill * f32(row) / 5; n = seg(out, n, r.x0 + 3 * k, yy, r.x1 - 3 * k, yy, 0.7 * k, ifx on then 0.3 else 0.15, ifx on then GOLD else DIM); }
    n = ab_icon(out, n, r, a, k, ifx !can then FAINT else ifx on then GOLD else WHITE);
    key: [2] u8; key[0] = cast(u8) ('1' + c);
    n = say_at(out, n, cast(string) key[0..<1], r.x1 - 9 * k, r.y0 + 10 * k, 7.5 * k, ink(k, 0.9, WHITE));
    left := ab_left(s, me, a);
    if left >= 0 { lb: [8] u8; lm := put_int(lb[..], 0, left); n = say_at(out, n, cast(string) lb[0..<lm], r.x0 + 4 * k, r.y0 + 10 * k, 7.5 * k, ink(k, 0.9, ifx left > 0 then GOLD else RED)); }
    cp := lo(6.5 * k, 6.5 * k * (r.x1 - r.x0 - 4 * k) / hi(text_width(a.name, 6.5 * k), 1));
    n = say_mid(out, n, a.name, (r.x0 + r.x1) / 2, r.y1 - 5 * k, cp, ink(k, ifx can then 0.9 else 0.4, ifx on then GOLD else WHITE));
  }
  // who you are, above the hotbar
  l: [LINE_CAP] u8;
  m := 0;
  if me >= 0 {
    cr := b[0].c[me];
    m = put(l[..], 0, "YOU: "); m = put(l[..], m, cast(string) cr.name[0..<cr.name_n]); m = put(l[..], m, ", ");
    m = put(l[..], m, RS_CLASS[cr.klass]); m = put(l[..], m, "   HP "); m = put_int(l[..], m, cr.hp); m = put(l[..], m, "/"); m = put_int(l[..], m, cr.hp_max);
    m = put(l[..], m, "   WASD WALKS   CLICK ONE OF THE DEAD TO TARGET IT");
  } else { m = put(l[..], 0, "YOU HAVE FALLEN. PICK A CLASS TO PLAY ANOTHER HERO."); }
  r0 := s[0].slots[0]; r2 := s[0].slots[rs_max(nab - 1, 0)];
  n = say_mid(out, n, cast(string) l[0..<m], ifx nab > 0 then (r0.x0 + r2.x1) / 2 else s[0].cx, r0.y0 - 10 * k, 9 * k, ink(k, 0.9, ifx me >= 0 then WHITE else RED));
  return n;
}
draw_top :: (s: [] Lab, out: [] f32, at: int, w: f32, k: f32, t: f32) -> int {
  n := at; pad := 16 * k;
  n = say_at(out, n, "5E LAB", pad, 38 * k, 18 * k, ink(k, 0.95, WHITE));
  l: [2 * LINE_CAP] u8;   // the key line runs long
  m := put(l[..], 0, "BATTLE "); m = put_int(l[..], m, s[0].round);
  m = put(l[..], m, "   "); m = put(l[..], m, team_name(s, 0)); m = put(l[..], m, " "); m = put_int(l[..], m, s[0].wins[0]);
  if !s[0].horde { m = put(l[..], m, "  "); m = put(l[..], m, TEAM_NAME[1]); m = put(l[..], m, " "); m = put_int(l[..], m, s[0].wins[1]); }
  m = put(l[..], m, "  DEAD "); m = put_int(l[..], m, s[0].wins[2]);
  sx0 := ifx s[0].portrait then pad else pad + text_width("5E LAB", 18 * k) + 28 * k;
  sy0 := ifx s[0].portrait then 62 * k else 34 * k;
  n = say_at(out, n, cast(string) l[0..<m], sx0, sy0, ifx s[0].portrait then 8.5 * k else 10 * k, ink(k, 0.7, DIM));
  m = put(l[..], 0, "SPACE "); m = put(l[..], m, ifx s[0].paused then "RESUME" else "PAUSE");
  m = put(l[..], m, "   F "); m = put(l[..], m, ifx s[0].fast then "NORMAL SPEED" else "FAST");
  m = put(l[..], m, "   R NEW BATTLE   H HORDE/ARMIES   P PLAY   V 2D/3D   M MODE");
  if s[0].view == VIEW_GLADE { m = put(l[..], m, "   DRAG ORBIT   SHIFT+DRAG PAN   WHEEL ZOOM"); }
  n = say_at(out, n, cast(string) l[0..<m], sx0, sy0 + 16 * k, ifx s[0].portrait then 7 * k else 8 * k, ink(k, 0.45, FAINT));
  // frames a second, in the scene's bottom-right corner (not in the golden, which has no clock)
  if !s[0].golden {
    fl: [16] u8;
    fm := put_int(fl[..], 0, int(s[0].fps + 0.5)); fm = put(fl[..], fm, " FPS");
    fc := 15 * k;
    fxr := ifx s[0].portrait then s[0].width - 16 * k else s[0].panel.x0 - 16 * k;
    fyb := ifx s[0].portrait then s[0].panel.y0 - 16 * k else s[0].height - 20 * k;
    n = say_at(out, n, cast(string) fl[0..<fm], fxr - text_width(cast(string) fl[0..<fm], fc), fyb, fc, ink(k, 1, ifx s[0].fps >= 50 then GREEN else ifx s[0].fps >= 30 then GOLD else RED));
  }
  if s[0].paused { n = say_mid(out, n, "PAUSED", s[0].cx, s[0].gy + 26 * k, 14 * k, ink(k, 0.9, GOLD)); }
  if s[0].over && s[0].winner >= 0 {
    mid := s[0].cx; cy := s[0].cy;
    m = put(l[..], 0, team_name(s, s[0].winner)); m = put(l[..], m, " WINS");
    n = say_mid(out, n, cast(string) l[0..<m], mid, cy, 26 * k, ink(k, 0.95, TEAM_COL[s[0].winner]));
  }
  mb := s[0].modal;
  n = box_lines(out, n, mb, 0.8 * k, ifx s[0].pressing == 3 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].mode == MODE_ACTION then "ACTION COMBAT" else "SRD ROUNDS", (mb.x0 + mb.x1) / 2, (mb.y0 + mb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, ifx s[0].mode == MODE_ACTION then GOLD else WHITE));
  fb := s[0].flip;
  n = box_lines(out, n, fb, 0.8 * k, ifx s[0].pressing == 2 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, ifx s[0].view == VIEW_GLADE then "2D VIEW" else "3D VIEW", (fb.x0 + fb.x1) / 2, (fb.y0 + fb.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, WHITE));
  b := s[0].back;
  n = box_lines(out, n, b, 0.8 * k, ifx s[0].pressing == 1 then 0.9 else 0.45, DIM);
  n = say_mid(out, n, "WORLDS", (b.x0 + b.x1) / 2, (b.y0 + b.y1) / 2 + 4.5 * k, 9 * k, ink(k, 0.8, WHITE));
  return n;
}

lab_frame :: (s: [] Lab, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  lab_start(s);
  if u.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  s[0].width = width; s[0].height = height; s[0].dpr = dpr;
  k := hi(dpr, 0.5);
  if s[0].golden && !s[0].golden_ran {
    // the golden: the same battle, 20 seconds in, every time
    s[0].golden_ran = true;
    for i: 0..<1200 { step(s, f32(STEP)); }
  }
  step_dt := ifx s[0].golden || still || s[0].paused then 0.0f32 else dt;
  lab_run(s, step_dt);
  if !s[0].golden { fly(s, dt); }
  put_bodies(s);
  if dt > 0 {
    s[0].fps_n += 1; s[0].fps_t += dt;
    if s[0].fps_t >= 0.5 { s[0].fps = f32(s[0].fps_n) / s[0].fps_t; s[0].fps_n = 0; s[0].fps_t = 0; }
  }
  t := s[0].clock;
  layout(s, width, height, k);
  n := 0;
  if s[0].view == VIEW_GLADE {
    n = draw_labels3(s, out, n, k, t);
    n = draw_fx3(s, out, n, k);
  } else {
    n = draw_zones(s, out, n, k, t);
    n = draw_fx(s, out, n, k);
    n = draw_tokens(s, out, n, k, t);
  }
  n = draw_panel(s, out, n, k);
  n = draw_top(s, out, n, width, k, t);
  n = draw_player(s, out, n, k);
  for i: 0..<u.count { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = t; u[3] = 1;
  u[U_GRID] = s[0].gx; u[U_GRID + 1] = s[0].gy; u[U_GRID + 2] = s[0].cell;
  u[U_CELLS] = f32(COLS); u[U_CELLS + 1] = f32(ROWS);
  p := s[0].panel;
  u[U_PANEL] = p.x0; u[U_PANEL + 1] = p.y0; u[U_PANEL + 2] = p.x1; u[U_PANEL + 3] = p.y1;
  u[U_CELLS + 2] = f32(s[0].view);
  u[U_CELLS + 3] = (ifx s[0].portrait then 92 else 64) * k;
  u[U_EYE] = s[0].eye.x; u[U_EYE + 1] = s[0].eye.y; u[U_EYE + 2] = s[0].eye.z; u[U_EYE + 3] = s[0].focal;
  u[U_FWD] = s[0].fwd.x; u[U_FWD + 1] = s[0].fwd.y; u[U_FWD + 2] = s[0].fwd.z; u[U_FWD + 3] = s[0].cx;
  u[U_RIGHT] = s[0].right.x; u[U_RIGHT + 1] = s[0].right.y; u[U_RIGHT + 2] = s[0].right.z; u[U_RIGHT + 3] = s[0].cy;
  u[U_UP] = s[0].up.x; u[U_UP + 1] = s[0].up.y; u[U_UP + 2] = s[0].up.z;
  u[U_SUN] = 0.45; u[U_SUN + 1] = 0.62; u[U_SUN + 2] = 0.38;
  b := s[0].battle[0];
  // the tokens, for the ground's rings and contact shadows: where each stands, its side and state,
  // and the square it is nearest
  for i: 0..<TOKENS3 {
    if i >= b.n { continue; }
    cr := b.c[i];
    o := U_TOKENS + i * 4;
    if cr.dead { continue; }
    u[o] = wx(s[0].dx[i]); u[o + 1] = wz(s[0].dy[i]);
    down := 0; if cr.hp == 0 { down = 1; }
    u[o + 2] = f32(1 + cr.team + 4 * down);
    since := b.clock - s[0].acted[i];
    u[o + 3] = ifx since >= 0 && since < 1.2 then 1 - since / 1.2 else 0;
    gx := cast(int) floor(s[0].dx[i] + 0.5); gy := cast(int) floor(s[0].dy[i] + 0.5);
    if gx < 0 || gx >= COLS || gy < 0 || gy >= ROWS { continue; }
    sq := gy * COLS + gx;
    at := U_SQUARES + sq / 2;
    pair := cast(int) u[at];
    mine := ifx sq % 2 == 0 then pair % 256 else pair / 256;
    place := 1; if sq % 2 == 1 { place = 256; }
    if mine == 0 { u[at] = f32(pair + (i + 1) * place); }
  }
  for z: 0..<RS_ZONES {
    o := U_ZONES + z * 8;
    zo := b.zone[z];
    if !zo.on { continue; }
    u[o] = wx(f32(zo.x0)) - f32(SQ) / 2; u[o + 1] = wz(f32(zo.y0)) - f32(SQ) / 2;
    u[o + 2] = wx(f32(zo.x1)) + f32(SQ) / 2; u[o + 3] = wz(f32(zo.y1)) + f32(SQ) / 2;
    u[o + 4] = ifx zo.spell == SP_ENTANGLE then 1 else 2;
  }
  u[U_BOUNDS] = f32(COLS) * f32(SQ) / 2; u[U_BOUNDS + 1] = f32(ROWS) * f32(SQ) / 2; u[U_BOUNDS + 2] = f32(SQ);
  return n;
}

// ---- input

leave_to :: (s: [] Lab, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}
// SRD rounds or action combat: a new battle on the other clock.
switch_mode :: (s: [] Lab) {
  s[0].mode = 1 - s[0].mode;
  new_battle(s);
}
lab_key :: (s: [] Lab, key: int, mods: int) -> bool #export_c {
  lab_start(s);
  if key == KEY_ESCAPE { leave_to(s, "/worlds"); return true; }
  if key == ' ' || key == KEY_ENTER { s[0].paused = !s[0].paused; return true; }
  if key == 'f' || key == 'F' { s[0].fast = !s[0].fast; return true; }
  if key == 'r' || key == 'R' { new_battle(s); return true; }
  if key == 'v' || key == 'V' { s[0].view = 1 - s[0].view; return true; }
  if key == 'm' || key == 'M' { switch_mode(s); return true; }
  if key == 'p' || key == 'P' { set_player(s, !s[0].player); return true; }
  if s[0].player && key >= '1' && key <= '9' { s[0].act = key - '1'; return true; }
  if s[0].player && (key == '[' || key == ']') { s[0].pick = (s[0].pick + ifx key == ']' then 1 else 11) % 12; pick_hero(s); return true; }
  if key == 'h' || key == 'H' { s[0].horde = !s[0].horde; s[0].wins[0] = 0; s[0].wins[1] = 0; s[0].wins[2] = 0; new_battle(s); return true; }
  if s[0].view == VIEW_GLADE {
    h := hold_bit(key);
    if h != 0 { s[0].held |= h; return true; }
    if key == 'c' || key == 'C' { s[0].yaw = 0; s[0].pitch = 0.6; s[0].dist = DIST; s[0].px = 0; s[0].pz = PIVOT_Z; s[0].vx = 0; s[0].vz = 0; return true; }
    if key == KEY_SHIFT { s[0].shift = true; return false; }
  }
  return false;
}
lab_key_up :: (s: [] Lab, key: int, mods: int) -> bool #export_c {
  if key == KEY_SHIFT { s[0].shift = false; }
  h := hold_bit(key);
  s[0].held = s[0].held & (1023 - h);   // h is one HOLD_ bit or none
  return h != 0;
}
lab_blur :: (s: [] Lab) #export_c { s[0].pressing = 0; s[0].dragging = false; s[0].shift = false; s[0].fingers = 0; s[0].held = 0; }
// The keys that fly the camera while they are held.
hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_W; }
  if key == 'a' || key == 'A' { return HOLD_A; }
  if key == 's' || key == 'S' { return HOLD_S; }
  if key == 'd' || key == 'D' { return HOLD_D; }
  if key == KEY_LEFT { return HOLD_LEFT; }
  if key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_UP { return HOLD_UP; }
  if key == KEY_DOWN { return HOLD_DOWN; }
  if key == '=' || key == '+' { return HOLD_IN; }
  if key == '-' || key == '_' { return HOLD_OUT; }
  return 0;
}
axis :: (held: int, plus: int, minus: int) -> f32 {
  a: f32 = 0;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}
// Each frame the held keys fly the camera: its speeds ease toward what the keys ask and coast to
// a stop when they let go, so it glides rather than steps. Paused or not, on the frame's real time.
fly :: (s: [] Lab, dt: f32) {
  t := lo(dt, 0.1);
  if !(t > 0) { return; }
  ease := lo(1, t * 9);
  h := s[0].held;
  if s[0].view != VIEW_GLADE { h = 0; }
  // in Player mode W, A, S and D walk your hero, and the camera follows it
  if s[0].player { h = h & (1023 - HOLD_W - HOLD_A - HOLD_S - HOLD_D); }
  if s[0].player && s[0].me >= 0 {
    follow := lo(1, t * 4);
    s[0].px += (wx(s[0].dx[s[0].me]) - s[0].px) * follow;
    s[0].pz += (wz(s[0].dy[s[0].me]) - s[0].pz) * follow;
  }
  speed := s[0].dist * 0.9;   // metres a second: a long way out, it flies faster
  s[0].vx += (axis(h, HOLD_D, HOLD_A) * speed - s[0].vx) * ease;
  s[0].vz += (axis(h, HOLD_W, HOLD_S) * speed - s[0].vz) * ease;
  s[0].vyaw += (axis(h, HOLD_RIGHT, HOLD_LEFT) * 1.6 - s[0].vyaw) * ease;
  s[0].vpitch += (axis(h, HOLD_UP, HOLD_DOWN) * 0.9 - s[0].vpitch) * ease;
  s[0].vzoom += (axis(h, HOLD_OUT, HOLD_IN) * 1.4 - s[0].vzoom) * ease;
  ax := s[0].fwd.x; az := s[0].fwd.z; al := sqrt(ax * ax + az * az);
  if al > 0.0001 { ax /= al; az /= al; }
  s[0].px += (s[0].right.x * s[0].vx + ax * s[0].vz) * t;
  s[0].pz += (s[0].right.z * s[0].vx + az * s[0].vz) * t;
  hx := f32(COLS) * f32(SQ) / 2; hz := f32(ROWS) * f32(SQ) / 2;
  s[0].px = lo(hx, hi(-hx, s[0].px)); s[0].pz = lo(hz, hi(-hz, s[0].pz));
  s[0].yaw += s[0].vyaw * t;
  s[0].pitch = lo(1.35, hi(0.12, s[0].pitch + s[0].vpitch * t));
  cam_zoom(s, 1 + s[0].vzoom * t);
}
// The camera's zoom: its distance times `by`, held between near and far.
cam_zoom :: (s: [] Lab, by: f32) { s[0].dist = lo(ZOOM_FAR, hi(ZOOM_NEAR, s[0].dist * by)); }
// A pan: the ground follows the pointer, dx right and dy down (device px), so the pivot moves the
// other way along the camera's level right and forward. It stays over the grid.
cam_pan :: (s: [] Lab, dx: f32, dy: f32) {
  m := s[0].dist / hi(s[0].focal, 1);   // metres per px at the pivot
  ahead := m / hi(sin(s[0].pitch), 0.3);  // the ground is foreshortened along the view
  ax := s[0].fwd.x; az := s[0].fwd.z; al := sqrt(ax * ax + az * az);
  if al > 0.0001 { ax /= al; az /= al; }
  s[0].px += -s[0].right.x * dx * m + ax * dy * ahead;
  s[0].pz += -s[0].right.z * dx * m + az * dy * ahead;
  hx := f32(COLS) * f32(SQ) / 2; hz := f32(ROWS) * f32(SQ) / 2;
  s[0].px = lo(hx, hi(-hx, s[0].px)); s[0].pz = lo(hz, hi(-hz, s[0].pz));
}
// The wheel (CSS px, down is out) zooms.
lab_wheel :: (s: [] Lab, dy: f32) -> bool #export_c {
  lab_start(s);
  if s[0].view != VIEW_GLADE { return false; }
  cam_zoom(s, 1 + lo(200, hi(-200, dy)) * 0.0012);
  return true;
}
lab_pointer :: (s: [] Lab, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  lab_start(s);
  if phase == 0 {
    if in_rect(s[0].back, x, y) { s[0].pressing = 1; return true; }
    if in_rect(s[0].flip, x, y) { s[0].pressing = 2; return true; }
    if in_rect(s[0].modal, x, y) { s[0].pressing = 3; return true; }
    if in_rect(s[0].pbtn, x, y) { s[0].pressing = 4; return true; }
    if s[0].player {
      for c: 0..<12 { if in_rect(s[0].picks[c], x, y) { s[0].pressing = 10 + c; return true; } }
      for c: 0..<SLOTS { if in_rect(s[0].slots[c], x, y) { s[0].pressing = 30 + c; return true; } }
    }
    s[0].down_x = x; s[0].down_y = y;
    if s[0].view == VIEW_GLADE && !in_rect(s[0].panel, x, y) {
      // a second finger: the two pinch to zoom and move together to pan
      if kind == 1 && s[0].fingers == 1 && s[0].fing_id[0] != id {
        s[0].fingers = 2; s[0].fing_id[1] = id; s[0].fing_x[1] = x; s[0].fing_y[1] = y; return true;
      }
      if kind == 1 { s[0].fingers = 1; s[0].fing_id[0] = id; s[0].fing_x[0] = x; s[0].fing_y[0] = y; }
      s[0].dragging = true; s[0].panning = s[0].shift; s[0].drag_x = x; s[0].drag_y = y; return true;
    }
    return false;
  }
  if phase == 1 {
    if kind == 1 && s[0].fingers == 2 {
      f := ifx s[0].fing_id[0] == id then 0 else ifx s[0].fing_id[1] == id then 1 else -1;
      if f < 0 { return false; }
      gap0 := sqrt((s[0].fing_x[0] - s[0].fing_x[1]) * (s[0].fing_x[0] - s[0].fing_x[1]) + (s[0].fing_y[0] - s[0].fing_y[1]) * (s[0].fing_y[0] - s[0].fing_y[1]));
      mx0 := (s[0].fing_x[0] + s[0].fing_x[1]) / 2; my0 := (s[0].fing_y[0] + s[0].fing_y[1]) / 2;
      s[0].fing_x[f] = x; s[0].fing_y[f] = y;
      gap1 := sqrt((s[0].fing_x[0] - s[0].fing_x[1]) * (s[0].fing_x[0] - s[0].fing_x[1]) + (s[0].fing_y[0] - s[0].fing_y[1]) * (s[0].fing_y[0] - s[0].fing_y[1]));
      if gap0 > 1 && gap1 > 1 { cam_zoom(s, gap0 / gap1); }
      cam_pan(s, (s[0].fing_x[0] + s[0].fing_x[1]) / 2 - mx0, (s[0].fing_y[0] + s[0].fing_y[1]) / 2 - my0);
      return true;
    }
    if !s[0].dragging { return false; }
    if s[0].panning { cam_pan(s, x - s[0].drag_x, y - s[0].drag_y); }
    else {
      k := hi(s[0].dpr, 0.5);
      s[0].yaw -= (x - s[0].drag_x) * 0.005 / k;
      s[0].pitch = lo(1.35, hi(0.12, s[0].pitch + (y - s[0].drag_y) * 0.004 / k));
    }
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  if kind == 1 && s[0].fingers > 0 {
    // a finger lifts: the one left (if any) drags on from where it is
    if s[0].fingers == 2 {
      left := ifx s[0].fing_id[0] == id then 1 else 0;
      s[0].fing_id[0] = s[0].fing_id[left]; s[0].fing_x[0] = s[0].fing_x[left]; s[0].fing_y[0] = s[0].fing_y[left];
      s[0].fingers = 1; s[0].drag_x = s[0].fing_x[0]; s[0].drag_y = s[0].fing_y[0];
      return true;
    }
    s[0].fingers = 0;
  }
  s[0].dragging = false; s[0].panning = false;
  held := s[0].pressing; s[0].pressing = 0;
  if held == 1 { if phase == 2 && in_rect(s[0].back, x, y) { leave_to(s, "/worlds"); } return true; }
  if held == 2 { if phase == 2 && in_rect(s[0].flip, x, y) { s[0].view = 1 - s[0].view; } return true; }
  if held == 3 { if phase == 2 && in_rect(s[0].modal, x, y) { switch_mode(s); } return true; }
  if held == 4 { if phase == 2 && in_rect(s[0].pbtn, x, y) { set_player(s, !s[0].player); } return true; }
  if held >= 10 && held < 22 { if phase == 2 && in_rect(s[0].picks[held - 10], x, y) { s[0].pick = held - 10; pick_hero(s); } return true; }
  if held >= 30 && held < 30 + SLOTS { if phase == 2 && in_rect(s[0].slots[held - 30], x, y) { s[0].act = held - 30; } return true; }
  // in Player mode a click (not a drag) on one of the dead makes it your target
  if phase == 2 && s[0].player && s[0].view == VIEW_GLADE && abs(x - s[0].down_x) + abs(y - s[0].down_y) < 8 * hi(s[0].dpr, 1) {
    s[0].target = token_at(s, x, y);
    return true;
  }
  return false;
}
lab_cursor :: (s: [] Lab) -> int #export_c { return 0; }
lab_message :: (s: [] Lab, kind: int, t: string) #export_c { lab_start(s); }
lab_golden :: (s: [] Lab, on: bool) #export_c { lab_start(s); s[0].golden = on; }
lab_action :: (s: [] Lab) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
lab_action_done :: (s: [] Lab) #export_c { s[0].out_n = 0; }

coaxial_lab_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_lab_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_lab_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- checks

frame_at :: (s: [] Lab, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  return lab_frame(s, out[..], u[..], w, h, dpr, dt, false);
}

#test "the battle runs on the SRD's rules: spells are cast, blows land, people drop" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false;
  lab_start(s[..]);
  dropped := 0;
  // a bit for each class once one of its people has spent a slot, a use, a Rage or a Focus Point,
  // or (a Rogue, who spends nothing) taken its turn
  spent := 0;
  for i: 0..<1500 {
    step(s[..], f32(STEP));
    if i % 30 == 0 {
      for h: 0..<HEROES {
        c := s[0].battle[0].c[h];
        any := c.slots[1] < c.slots_max[1] || c.slots[2] < c.slots_max[2] || c.slots[3] < c.slots_max[3] || c.rages < c.rages_max || c.focus < c.focus_max;
        for u: 0..<RS_USES { if c.uses[u] < c.uses_max[u] { any = true; } }
        if c.klass == RS_ROGUE && s[0].acted[h] > 0 { any = true; }
        if any { spent = spent | (1 << c.klass); }
      }
      // every class has spent something: enough seen (and under the interpreter's budget)
      all := true; for r: 0..<12 { if (spent & (1 << ROSTER[r])) == 0 { all = false; } }
      if all { break; }
    }
    if s[0].over { break; }
  }
  for r: 0..<12 { #assert (spent & (1 << ROSTER[r])) != 0; }
  for i: 0..<s[0].battle[0].n { if s[0].battle[0].c[i].hp < s[0].battle[0].c[i].hp_max { dropped += 1; } }
  #assert dropped > 0;
  #assert s[0].line_n > 10;
}

#test "in the Horde every class finds the dead and spends its features on them" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = true;
  lab_start(s[..]);
  spent := 0;
  for i: 0..<700 {
    step(s[..], f32(STEP));
    if i % 30 == 0 {
      for h: 0..<HEROES {
        c := s[0].battle[0].c[h];
        any := c.slots[1] < c.slots_max[1] || c.slots[2] < c.slots_max[2] || c.slots[3] < c.slots_max[3] || c.rages < c.rages_max || c.focus < c.focus_max;
        for u: 0..<RS_USES { if c.uses[u] < c.uses_max[u] { any = true; } }
        if c.klass == RS_ROGUE && s[0].acted[h] > 0 { any = true; }
        if any { spent = spent | (1 << c.klass); }
      }
    }
    if s[0].over { break; }
  }
  for r: 0..<12 { #assert (spent & (1 << ROSTER[r])) != 0; }
}

#test "each side fields two of every SRD 5e class at level 3, the casters behind" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false;
  lab_start(s[..]);
  for team: 0..<2 {
    for r: 0..<12 {
      n := 0;
      for k: 0..<SIDE {
        c := s[0].battle[0].c[team * SIDE + k];
        #assert c.team == team && c.level == LEVEL;
        if c.klass == ROSTER[r] { n += 1; }
        // the casting classes at the back, each side on its own edge
        back := ifx team == 0 then c.x < 3 else c.x > COLS - 4;
        if c.klass == RS_DRUID || c.klass == RS_WIZARD || c.klass == RS_WARLOCK || c.klass == RS_SORCERER || c.klass == RS_BARD || c.klass == RS_CLERIC { #assert back; }
      }
      #assert n == 2;
    }
  }
  #assert look_of(RS_DRUID) == 0 && look_of(RS_SORCERER) == 12 && look_of(RS_MONSTER) == 4;
}

#test "a frame draws the grid, the tokens and the log on a desktop and on a 390 px phone" #steps 2000000000 {
  s: [2] Lab; s[0].skeletons = 24; s[0].horde = false; s[1].skeletons = 24; s[1].horde = false;
  for i: 0..<200 { lab_start(s[0..<1]); step(s[0..<1], f32(STEP)); }
  a := frame_at(s[0..<1], 1600, 1000, 1, 0.016);
  #assert a > 300 && a < MAX_VERTICES - 600;
  b := frame_at(s[1..<2], 390 * 3, 844 * 3, 3, 0.016);
  #assert b > 100 && b < MAX_VERTICES - 600 && s[1].portrait;
  #assert s[1].gx >= 0 && s[1].gx + s[1].cell * f32(COLS) <= 390 * 3;
}

#test "the glade's camera sees the whole grid from its default orbit" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
  n := frame_at(s[..], 1600, 1000, 1, 0.016);
  for c: 0..<4 {
    x := ifx c % 2 == 0 then -0.5 else f32(COLS) - 0.5;
    y := ifx c < 2 then -0.5 else f32(ROWS) - 0.5;
    p := proj(s[..], wx(x), 0, wz(y));
    #assert p.z > 0 && p.x > 0 && p.x < s[0].panel.x0 && p.y > 64 && p.y < 1000;
  }
}

#test "the camera zooms on the wheel and pans on Shift-drag and WASD, and C puts it back" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false; ok: bool; n: int;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  #assert lab_wheel(s[..], -100) && s[0].dist < DIST;
  ok = lab_wheel(s[..], 100000); #assert s[0].dist <= ZOOM_FAR;
  ok = lab_key(s[..], 'c', 0); #assert s[0].dist == DIST;
  ok = lab_key(s[..], KEY_SHIFT, 1);
  ok = lab_pointer(s[..], 400, 500, 0, 0, 1); ok = lab_pointer(s[..], 300, 500, 1, 0, 1); ok = lab_pointer(s[..], 300, 500, 2, 0, 1);
  #assert s[0].px > 0 && s[0].yaw == 0;   // the ground moved left under the pointer
  ok = lab_key_up(s[..], KEY_SHIFT, 0);
  ok = lab_key(s[..], 'c', 0); n = frame_at(s[..], 1600, 1000, 1, 0.016);
  ok = lab_key(s[..], 'w', 0);
  for i: 0..<20 { fly(s[..], 0.016); }
  z1 := s[0].pz; #assert z1 < PIVOT_Z;   // held, W flies forward (toward -Z at yaw 0)
  ok = lab_key_up(s[..], 'w', 0);
  for i: 0..<60 { fly(s[..], 0.016); }
  #assert s[0].pz < z1 && s[0].vz < 0.5 && s[0].vz > -0.5;   // let go, it coasts to a stop
  ok = lab_key(s[..], 'c', 0);
  ok = lab_pointer(s[..], 400, 500, 0, 0, 1); ok = lab_pointer(s[..], 450, 500, 1, 0, 1); ok = lab_pointer(s[..], 450, 500, 2, 0, 1);
  #assert s[0].yaw != 0;   // a plain drag still orbits
}

#test "two fingers pinch to zoom" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false; ok: bool; n: int;
  n = frame_at(s[..], 390, 844, 3, 0.016);
  ok = lab_pointer(s[..], 100, 300, 0, 1, 7); ok = lab_pointer(s[..], 200, 300, 0, 1, 8);
  ok = lab_pointer(s[..], 250, 300, 1, 1, 8);
  #assert s[0].dist < DIST && s[0].yaw == 0;
  ok = lab_pointer(s[..], 250, 300, 2, 1, 8); ok = lab_pointer(s[..], 100, 300, 2, 1, 7);
  #assert s[0].fingers == 0 && !s[0].dragging;
}

#test "space pauses, F runs fast, R starts a new battle, Escape goes to /worlds" {
  s: [1] Lab; s[0].skeletons = 24; s[0].horde = false;
  #assert lab_key(s[..], ' ', 0) && s[0].paused;
  #assert lab_key(s[..], 'f', 0) && s[0].fast;
  r := s[0].round;
  #assert lab_key(s[..], 'r', 0) && s[0].round == r + 1;
  #assert s[0].mode == MODE_ACTION && s[0].battle[0].beat == ACTION_BEAT && lab_key(s[..], 'm', 0) && s[0].mode == MODE_ROUNDS && s[0].battle[0].beat == 0 && lab_key(s[..], 'm', 0) && s[0].mode == MODE_ACTION;
  #assert s[0].view == VIEW_GLADE && lab_key(s[..], 'v', 0) && s[0].view == VIEW_FLAT && lab_key(s[..], 'v', 0) && s[0].view == VIEW_GLADE;
  #assert lab_key(s[..], KEY_ESCAPE, 0) && lab_action(s[..]) == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/worlds";
}

#test "the Horde: every hero on one side mid-glade, the dead on the edges, and they run in" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 24;
  lab_start(s[..]);
  b := bt(s[..]);
  for i: 0..<HEROES { #assert b[0].c[i].team == 0 && b[0].c[i].x >= HOLD_X && b[0].c[i].x < HOLD_X + 8; }
  far := 0;
  for i: HEROES..<b[0].n {
    c := b[0].c[i];
    #assert c.team == 2 && rs_min(rs_min(c.x, c.y), rs_min(COLS - 1 - c.x, ROWS - 1 - c.y)) <= 1;
    far += rs_feet_to(b, i, 0);
  }
  for i: 0..<40 { step(s[..], f32(STEP)); }
  closer := 0;
  for i: HEROES..<b[0].n { closer += rs_feet_to(b, i, 0); }
  #assert closer < far;   // the dead have closed in
  #assert s[0].pool == HORDE - 24;
  b[0].c[HEROES].dead = true; b[0].c[HEROES].hp = 0;
  for i: 0..<70 { step(s[..], f32(STEP)); }
  // a fresh one ran in (at level 6 it may already have fallen again: that's raised past 25)
  #assert s[0].raised >= 25 && s[0].pool == HORDE - s[0].raised;
  #assert lab_key(s[..], 'h', 0) && !s[0].horde && b[0].c[HEROES - 1].team == 1;
}

#test "Player mode: P plays the picked class, the hotbar keys pick the action, and D walks you right" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 0; s[0].horde = false; ok: bool; n: int;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  ok = lab_key(s[..], 'p', 0);
  #assert s[0].player && s[0].me >= 0 && s[0].battle[0].c[s[0].me].klass == RS_FIGHTER;
  ok = lab_key(s[..], ']', 0);
  #assert s[0].battle[0].c[s[0].me].klass == ROSTER[7];
  ok = lab_key(s[..], '3', 0); #assert s[0].act == 2;
  ok = lab_key(s[..], '1', 0); #assert s[0].act == ACT_ATTACK;
  me := s[0].me; x0 := s[0].battle[0].c[me].x;
  ok = lab_key(s[..], 'd', 0);
  for i: 0..<200 { step(s[..], f32(STEP)); }
  #assert s[0].battle[0].c[me].x > x0;
  n = frame_at(s[..], 1600, 1000, 1, 0.016);
  #assert n > 300 && s[0].slots[0].x1 > s[0].slots[0].x0;
  // every class's hotbar holds its own abilities, Attack or a cantrip first and Dash last
  for c: 0..<12 {
    list: [SLOTS] Ab; nab := abilities(ROSTER[c], list[..]);
    #assert nab >= 3 && nab <= SLOTS && list[nab - 1].kind == AB_DASH;
  }
  list: [SLOTS] Ab;
  #assert abilities(RS_BARBARIAN, list[..]) == 4 && list[2].kind == AB_RAGE;
  #assert abilities(RS_WIZARD, list[..]) == 8 && list[6].sp == SP_FIREBALL;
  ok = lab_key(s[..], 'p', 0); #assert !s[0].player && s[0].me < 0;
}

#test "the glade's effects: each kind of event starts its own recipe" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = false;
  lab_start(s[..]);
  b := bt(s[..]);
  sk := HEROES;   // a Skeleton
  e: RsEvent; e.at = b[0].clock; e.by = 0; e.to = 1;
  kinds := [10] int.[RS_EV_ZONE, RS_EV_ZONE, RS_EV_ATTACK, RS_EV_ATTACK, RS_EV_ATTACK, RS_EV_HEAL, RS_EV_DEATH, RS_EV_CAST, RS_EV_ZONE, RS_EV_ATTACK];
  spells := [10] int.[SP_FIREBALL, SP_THUNDERWAVE, SP_FIRE_BOLT, SP_ELDRITCH_BLAST, -1, -1, -1, SP_SACRED_FLAME, SP_CALL_LIGHTNING, -1];
  want := [10] int.[FXR_FIREBALL, FXR_SHOCK, FXR_FIREBOLT, FXR_STREAK, FXR_HIT, FXR_HEAL, FXR_BONES, FXR_COLUMN, FXR_LIGHTNING, FXR_HIT];
  for q: 0..<10 {
    fxp_clear(s[0].puffs[..]);
    e.kind = kinds[q]; e.spell = spells[q]; e.amount = 3; e.x = 10; e.y = 8; e.to = ifx q == 6 then sk else 1;
    b[0].c[e.to].x = 2 + q; b[0].c[e.to].y = 4;   // apart from the caster, but within reach of a blow
    b[0].c[0].x = 1 + q; b[0].c[0].y = 4;
    e.damage = ifx q == 9 then 1 else 0;
    fx_event(s[..], e, 1.5 + f32(q), e.at);
    #assert fxp_live(s[0].puffs[..]) == 1;
    found := -1; big: f32 = 0;
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { found = s[0].puffs[0].live[k].recipe; big = s[0].puffs[0].live[k].big; } }
    #assert found == want[q];
    if q == 9 { #assert big > 1.5; }   // a critical hit is bigger
  }
  // a blow from afar is an arrow
  b[0].c[0].x = 1; b[0].c[1].x = 20;
  fxp_clear(s[0].puffs[..]);
  e.kind = RS_EV_ATTACK; e.spell = -1; e.to = 1; e.damage = 0;
  fx_event(s[..], e, 3.5, e.at);
  for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { #assert s[0].puffs[0].live[k].recipe == FXR_ARROW; } }
}

#test "the glade's effects: each class feature and spell starts its own recipe" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = false;
  lab_start(s[..]);
  b := bt(s[..]);
  b[0].c[0].x = 4; b[0].c[0].y = 4; b[0].c[1].x = 5; b[0].c[1].y = 4;
  b[0].c[1].team = 1 - b[0].c[0].team;   // a foe beside it, for the Flurry
  e: RsEvent; e.at = b[0].clock; e.by = 0;
  feats := [16] int.[RS_FT_ACTION_SURGE, RS_FT_SECOND_WIND, RS_FT_SNEAK_ATTACK, RS_FT_STEADY_AIM, RS_FT_CUNNING_DASH, RS_FT_FLURRY,
                     RS_FT_STUNNING_STRIKE, RS_FT_PATIENT_DEFENSE, RS_FT_STEP_OF_THE_WIND, RS_FT_WHOLENESS, RS_FT_LAY_ON_HANDS,
                     RS_FT_SACRED_WEAPON, RS_FT_PRESERVE_LIFE, RS_FT_INSPIRATION, RS_FT_INNATE_SORCERY, RS_FT_DARK_BLESSING];
  kinds := [16] int.[RS_EV_CONDITION, RS_EV_CAST, RS_EV_DAMAGE, RS_EV_CONDITION, RS_EV_FEAT, RS_EV_CONDITION,
                     RS_EV_CONDITION, RS_EV_CONDITION, RS_EV_FEAT, RS_EV_CAST, RS_EV_CAST,
                     RS_EV_CONDITION, RS_EV_CAST, RS_EV_CONDITION, RS_EV_CONDITION, RS_EV_HEAL];
  want := [16] int.[FXR_SURGE, FXR_BREATH, FXR_SHADOW_SLASH, FXR_RETICLE, FXR_AFTERIMAGE, FXR_FLURRY,
                    FXR_STUN, FXR_WIND, FXR_WIND, FXR_WHOLENESS, FXR_LAY,
                    FXR_SACRED, FXR_WAVE, FXR_NOTES, FXR_ARCANE, FXR_FIEND];
  for q: 0..<16 {
    fxp_clear(s[0].puffs[..]);
    e.kind = kinds[q]; e.feat = feats[q]; e.spell = -1; e.to = ifx q == 2 || q == 6 || q == 10 || q == 13 then 1 else 0;
    fx_event(s[..], e, 2.5 + f32(q), e.at);
    found := -1;
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { found = s[0].puffs[0].live[k].recipe; } }
    #assert found == want[q] && fxp_live(s[0].puffs[..]) == 1;
  }
  // a feature's own healing draws nothing more: its cast showed it
  fxp_clear(s[0].puffs[..]);
  e.kind = RS_EV_HEAL; e.feat = RS_FT_SECOND_WIND; e.to = 0;
  fx_event(s[..], e, 1.5, e.at);
  #assert fxp_live(s[0].puffs[..]) == 0;
  // the spells that had no look of their own
  e.feat = RS_FT_NONE; e.kind = RS_EV_CAST; e.to = 1;
  spells := [5] int.[SP_HOLD_PERSON, SP_BLINDNESS, SP_VICIOUS_MOCKERY, SP_SHIELD, SP_DIVINE_SMITE];
  looks := [5] int.[FXR_BIND, FXR_VEIL, FXR_MOCKERY, FXR_BARRIER, FXR_SMITE];
  for q: 0..<5 {
    fxp_clear(s[0].puffs[..]);
    e.spell = spells[q]; e.amount = 3;
    fx_event(s[..], e, 4.5 + f32(q), e.at);
    for k: 0..<FX_LIVE { if s[0].puffs[0].on[k] { #assert s[0].puffs[0].live[k].recipe == looks[q]; if q == 4 { #assert s[0].puffs[0].live[k].big > 1.5; } } }
  }
  // a creature poisoned and concentrating carries its lasting looks
  b[0].c[1].cond = RS_POISONED; b[0].c[0].conc = SP_HOLD_PERSON;
  #assert fx_lasting(s[..], 1) == FXS_POISONED && (fx_lasting(s[..], 0) & FXS_CONCENTRATING) != 0;
}

#test "a battle in the glade draws its effects as puffs, never past the budget" #steps 2000000000 {
  s: [1] Lab; s[0].skeletons = 16; s[0].horde = true;
  lab_start(s[..]);
  out: [4000 * VERTEX_FLOATS] f32;
  s[0].eye = P3.{x = 0, y = 20, z = 30};
  most := 0;
  for i: 0..<600 {
    step(s[..], f32(STEP));
    if i % 20 == 0 {
      n := draw_fx3(s[..], out[..], 0, 1);
      #assert s[0].puffs[0].out_n <= FX_PUFF_CAP && fxp_live(s[0].puffs[..]) <= FX_LIVE;
      if s[0].puffs[0].out_n > most { most = s[0].puffs[0].out_n; }
    }
  }
  #assert most > 0 && s[0].puffs[0].started > 0;
  // the flat view writes none
  n := draw_fx(s[..], out[..], 0, 1);
  #assert s[0].puffs[0].out_n == 0;
}
