 s:[1]Lab;s[0].creator[0].experimental=true;s[0].creator[0].hostiles[0].ready=true;s[0].creator[0].hostiles[0].hp=0;
 #assert !lab_walk(s[..]).on;
}
#test "experimental glade starts with a free Everglade walker and accepts held keys" {
  s:[1]Lab;
