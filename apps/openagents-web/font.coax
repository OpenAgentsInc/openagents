// A code point and how many bytes of UTF-8 it took.
Rune :: struct { code: u32; len: int; }

FONT_BAD :: 0xFFFD;    // what a malformed byte reads as
FONT_TOFU :: 0x25A1;   // the box a character with no glyph draws as

// The code point at byte i of UTF-8 text. A malformed byte (a stray
// continuation byte, a cut-off sequence, an overlong form, a surrogate or a
// code past U+10FFFF) reads as one U+FFFD.
decode :: (text: string, i: int) -> Rune {
  bad := Rune.{code = FONT_BAD, len = 1};
  if i < 0 || i >= text.count { return bad; }
  b := cast(u32) text[i];
  if b < 0x80 { return Rune.{code = b, len = 1}; }
  n := 0; c: u32 = 0;
  if b >= 0xF0 && b < 0xF8 { n = 4; c = b & 7; }
  else if b >= 0xE0 && b < 0xF0 { n = 3; c = b & 15; }
  else if b >= 0xC0 && b < 0xE0 { n = 2; c = b & 31; }
  else { return bad; }
  if i + n > text.count { return bad; }
  for k: 1..<n {
    x := cast(u32) text[i + k];
    if (x & 0xC0) != 0x80 { return bad; }
    c = (c << 6) | (x & 63);
  }
  if (n == 2 && c < 0x80) || (n == 3 && c < 0x800) || (n == 4 && c < 0x10000) { return bad; }
  if c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) { return bad; }
  return Rune.{code = c, len = n};
}

// Writes code point c as UTF-8 at out[at]. Returns the bytes written (0
// when it doesn't fit).
encode :: (c: u32, out: [] u8, at: int) -> int {
  n := ifx c < 0x80 then 1 else ifx c < 0x800 then 2 else ifx c < 0x10000 then 3 else 4;
  if at < 0 || at + n > out.count || c > 0x10FFFF { return 0; }
  if n == 1 { out[at] = cast(u8) c; return 1; }
  lead: u32 = ifx n == 2 then 0xC0 else ifx n == 3 then 0xE0 else 0xF0;
  out[at] = cast(u8) (lead | (c >> (6 * cast(u32) (n - 1))));
  for k: 1..<n { out[at + k] = cast(u8) (0x80 | ((c >> (6 * cast(u32) (n - 1 - k))) & 63)); }
  return n;
}

// Whether code point c draws nothing and takes no room: the zero-width
// space, joiners and direction marks, the word joiner, the byte order mark,
// variation selectors, tags and combining marks.
font_invisible :: (c: u32) -> bool {
  if c < 0x300 { return false; }
  return (c >= 0x200B && c <= 0x200F) || c == 0x2060 || c == 0xFEFF || (c >= 0xFE00 && c <= 0xFE0F) ||
         (c >= 0xE0000 && c <= 0xE007F) || (c >= 0x300 && c <= 0x36F);
}

// Whether code point c goes with the character before it: a variation
// selector, a skin tone, a combining mark, the keycap or a tag.
font_rider :: (c: u32) -> bool {
  return (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0x1F3FB && c <= 0x1F3FF) || (c >= 0x300 && c <= 0x36F) ||
         c == 0x20E3 || (c >= 0xE0020 && c <= 0xE007F);
}

// The character at byte i as one glyph draws it: its first code point, and
// the bytes of it and all that goes with it. A ZWJ sequence (a family, a
// profession) is its first emoji, a skin tone, a variation selector, a
// keycap or a combining mark goes with the character before it, and two
// regional indicators (a flag) are one character.
cluster :: (text: string, i: int) -> Rune {
  // ASCII with ASCII after it, most text: nothing goes with it
  if i >= 0 && i < text.count && text[i] < 0x80 && (i + 1 >= text.count || text[i + 1] < 0x80) {
    return Rune.{code = cast(u32) text[i], len = 1};
  }
  // one decode, so one copy of it: the first code point, then each one that may go with it
  at := i; base: u32 = 0; join := false; flag := false;
  while at < text.count {
    r := decode(text, at);
    if at == i {
      if r.code == FONT_BAD { return r; }
      base = r.code; flag = base >= 0x1F1E6 && base <= 0x1F1FF;
    } else if join {
      if r.code == FONT_BAD || r.code <= 32 { break; }   // a joiner joins the code point after it
      join = false;
    } else if flag && r.code >= 0x1F1E6 && r.code <= 0x1F1FF {
      flag = false;
    } else if r.code == 0x200D {
      join = true; flag = false;
    } else if font_rider(r.code) {
      flag = false;
    } else { break; }
    at += r.len;
  }
  if at == i { return decode(text, i); }
  return Rune.{code = base, len = at - i};
}

// The larger and the smaller of two, kept here so that font.coax needs only
// lit from the program that loads it.
font_hi :: (a: f32, b: f32) -> f32 { return ifx a > b then a else b; }
font_lo :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }

// The glyph a code point draws as: lowercase as capitals (until stage 3), a
// Latin-1 or Latin Extended-A letter as its base letter (font_mark gives the
// mark that goes on it) or its own glyph, a no-break space as a space, and a
// malformed byte as the tofu box.
font_fold :: (code: u32) -> u32 {
  c := code;
  if c >= 'a' && c <= 'z' { return c - 32; }
  if c == 0xA0 || c == '\t' { return ' '; }
  if c >= FONT_ACCENT_FIRST && c < FONT_ACCENT_FIRST + FONT_ACCENTS {
    b := cast(u32) FONT_ACCENT_BASE[cast(int) (c - FONT_ACCENT_FIRST)];
    if b == 1 { return c; }
    if b == 2 { return c - 32; }
    if b == 3 { return c - 1; }
    return b;
  }
  if c == FONT_BAD { return FONT_TOFU; }
  return c;
}

// The mark drawn on code point c's base letter: 0 for none, else its row in
// FONT_MARK_* plus 1.
font_mark :: (code: u32) -> int {
  if code < FONT_ACCENT_FIRST || code >= FONT_ACCENT_FIRST + FONT_ACCENTS { return 0; }
  return cast(int) FONT_ACCENT_MARK[cast(int) (code - FONT_ACCENT_FIRST)];
}

// The table row for code point c (folded), or the tofu box's row when the
// font has no such glyph.
font_find :: (code: u32) -> int {
  c := font_fold(code);
  low := 0; high := FONT_GLYPHS - 1;
  while low <= high {
    mid := (low + high) / 2;
    k := cast(u32) FONT_CODES[mid];
    if k == c { return mid; }
    if k < c { low = mid + 1; } else { high = mid - 1; }
  }
  if c == FONT_TOFU { return -1; }
  return font_find(FONT_TOFU);
}

// The emoji picture code point c draws as, or -1.
emoji_find :: (code: u32) -> int {
  key: u32 = 0;
  if code >= 0x1F000 && code < 0x20000 { key = code - 0x10000; }
  else if code >= 0x2000 && code < 0x3000 { key = code; }
  else { return -1; }
  low := 0; high := EMOJI_COUNT - 1;
  while low <= high {
    mid := (low + high) / 2;
    k := cast(u32) EMOJI_CODES[mid];
    if k == key { return cast(int) EMOJI_PICTURE[mid]; }
    if k < key { low = mid + 1; } else { high = mid - 1; }
  }
  return -1;
}

// Pixel (row r, column c) of emoji picture e: 0 clear, else its palette colour plus 1.
emoji_pixel :: (e: int, r: int, c: int) -> int {
  at := 0; v := 0;
  if e < EMOJI_SYMMETRIC {
    at = e * 10;
    m := ifx c < 4 then c else 7 - c;
    v = (cast(int) EMOJI_PIXELS[at + 2 + r] >> (m * 2)) & 3;
  } else {
    at = EMOJI_SYMMETRIC * 10 + (e - EMOJI_SYMMETRIC) * 18;
    v = (cast(int) EMOJI_PIXELS[at + 2 + r * 2 + c / 4] >> ((c & 3) * 2)) & 3;
  }
  if v == 0 { return 0; }
  names := cast(int) EMOJI_PIXELS[at] | (cast(int) EMOJI_PIXELS[at + 1] << 8);
  return (names >> ((v - 1) * 4)) & 15;
}

// A glyph's points: x * 2, y * 2 + 2, FONT_BREAK between strokes. Writes
// pairs into out and returns how many points.
glyph :: (code: u32, out: [] u8) -> int {
  k := font_find(code);
  if k < 0 || out.count < FONT_MAX_POINTS * 2 { return 0; }
  first := cast(int) FONT_FIRST[k]; n := cast(int) FONT_FIRST[k + 1] - first;
  for p: 0..<n * 2 { out[p] = FONT_POINTS[first * 2 + p]; }
  return n;
}

// A glyph's width in cap heights (I is a single line: 0; an emoji is wider
// than a letter; a character that draws nothing is 0).
glyph_width :: (code: u32) -> f32 {
  if code >= 0x300 {
    if emoji_find(code) >= 0 { return cast(f32) EMOJI_WIDTH / 12; }
    if font_invisible(code) { return 0; }
  }
  k := font_find(code);
  if k < 0 { return 0; }
  return cast(f32) FONT_WIDTH[k] / 12;
}

// "**" at byte i: rich text's bold switch, which draws nothing.
bold_mark :: (text: string, i: int) -> bool {
  return i + 1 < text.count && text[i] == '*' && text[i + 1] == '*';
}

// Whether rich text is bold at byte i (an odd number of "**" before it).
bold_at :: (text: string, i: int) -> bool {
  on := false; k := 0;
  while k < i && k < text.count {
    if bold_mark(text, k) { on = !on; k += 2; } else { k += 1; }
  }
  return on;
}

// How wide text is, in cap heights: glyph widths, gap between letters that
// touch, and space for each space. Rich text's "**" takes no room.
measure :: (text: string, gap: f32, space: f32, rich: bool) -> f32 {
  w := 0.0f32; i := 0; after := false;
  while i < text.count {
    if rich && bold_mark(text, i) { i += 2; continue; }
    d := cluster(text, i); i += d.len;
    c := font_fold(d.code);
    if c == ' ' { w += space; after = false; continue; }
    if c < 32 || font_invisible(c) { continue; }
    if after { w += gap; }
    w += glyph_width(c);
    after = true;
  }
  return w;
}

// How text is drawn: the stroke's half width, brightness and glow reach
// (device pixels), its colour and the shader mode. Scale is device pixels per
// CSS pixel; when it's given, text under SMALL_TEXT CSS pixels follows
// font.md "Small sizes": no glow, a core about one device pixel wide, and
// every stroke's ends on device-pixel centres, so its lines land whole on
// pixels instead of smearing across two.
Ink :: struct { core: f32; light: f32; glow: f32; red: f32; green: f32; blue: f32; mode: f32; scale: f32 = 0; sans: bool = false; }
SMALL_TEXT :: 12.0;

// A device-pixel centre: where a small stroke's end goes.
pixel_centre :: (x: f32) -> f32 { return floor(x) + 0.5; }

// A glyph's or a mark's n points (pts, as FONT_POINTS keeps them) as strokes,
// dx half units right of pen on baseline base, unit device pixels a half
// unit, in ink k (its core, light, glow and colour as drawn), from vertex at.
// Small text's ends land on device-pixel centres. Returns the vertex count.
font_strokes :: (out: [] f32, at: int, pts: [] u8, n: int, pen: f32, dx: f32, base: f32, unit: f32, small: bool, k: Ink) -> int {
  v := at;
  for p: 1..<n {
    if pts[(p - 1) * 2] == FONT_BREAK || pts[p * 2] == FONT_BREAK { continue; }
    ax := pen + (cast(f32) pts[(p - 1) * 2] + dx) * unit;
    ay := base - (cast(f32) pts[(p - 1) * 2 + 1] - 2) * unit;
    bx := pen + (cast(f32) pts[p * 2] + dx) * unit;
    by := base - (cast(f32) pts[p * 2 + 1] - 2) * unit;
    if small {
      ax = pixel_centre(ax); ay = pixel_centre(ay); bx = pixel_centre(bx); by = pixel_centre(by);
      // a dot (. : ! ; ·) shorter than a pixel would snap to nothing: keep it a pixel tall
      if ax == bx && ay == by { by = ay - 1; }
    }
    if lit(out, v, ax, ay, bx, by, k.core, k.light, k.glow, k.red, k.green, k.blue, k.mode) { v += 6; }
  }
  return v;
}

// Draws emoji picture e in its box, the box's left end at x on baseline base,
// beside capitals cap pixels tall, from vertex at. A pixel is h device pixels
// square (h whole, about an eighth of 1.1 caps), and each run of one colour in
// a row is one stroke whose edges lie on device-pixel edges, so no colour
// bleeds into the next pixel. The ink gives its brightness and shader mode,
// not its colour. Returns the vertex count.
draw_emoji :: (out: [] f32, at: int, e: int, x: f32, base: f32, cap: f32, k: Ink) -> int {
  h := floor(cap * 1.1 / 8 + 0.5);
  if h < 1 { h = 1; }
  side := 8 * h;
  x0 := floor(x + (cap * cast(f32) EMOJI_WIDTH / 12 - side) / 2 + 0.5);
  y0 := floor(base - cap * 0.5 - side / 2 + 0.5);
  core := h / 2 - 0.05;
  light := font_lo(k.light, 1) * 0.78;   // the stroke shader adds a halo of about 0.28 at a stroke's centre
  v := at;
  for r: 0..<8 {
    y := y0 + cast(f32) r * h + h / 2;
    c := 0;
    while c < 8 {
      p := emoji_pixel(e, r, c);
      if p == 0 { c += 1; continue; }
      s := c;
      while c < 8 && emoji_pixel(e, r, c) == p { c += 1; }
      ax := x0 + cast(f32) s * h + h / 2;
      bx := x0 + cast(f32) c * h - h / 2;
      if bx <= ax { bx = ax + 0.01; }
      o := (p - 1) * 3;
      red := cast(f32) EMOJI_PALETTE[o] / 255; green := cast(f32) EMOJI_PALETTE[o + 1] / 255; blue := cast(f32) EMOJI_PALETTE[o + 2] / 255;
      if lit(out, v, ax, y, bx, y, core, light, 0, red, green, blue, k.mode) { v += 6; }
    }
  }
  return v;
}

// Draws text with the left end of its baseline at x, base (device pixels,
// y down) and capitals cap pixels tall, from vertex at. Rich text draws
// "**"-marked runs bold (brighter, thicker, white), starting bold if bold.
// An accented letter draws its base letter and its mark, an emoji its
// picture in colour, and a character the font lacks the tofu box.
// Returns the new vertex count; text that runs out of room stops drawing.
draw_text :: (out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, gap: f32, space: f32,
              k: Ink, rich: bool, bold: bool) -> int {
  if uses_sans(k, cap) { return draw_sans(out, at, text, x, base, cap, k); }
  points: [FONT_MAX_POINTS * 2] u8;
  unit := cap / 12;              // device pixels per half unit
  small := k.scale > 0 && cap < SMALL_TEXT * k.scale;
  vertices := at; i := 0; after := false; strong := bold; pen := x;
  while i < text.count {
    if rich && bold_mark(text, i) { strong = !strong; i += 2; continue; }
    d := cluster(text, i); i += d.len;
    c := font_fold(d.code);
    if c == ' ' { pen += space * cap; after = false; continue; }
    if c < 32 || font_invisible(c) { continue; }
    if after { pen += gap * cap; }
    e := emoji_find(c);
    if e >= 0 {
      vertices = draw_emoji(out, vertices, e, pen, base, cap, k);
      pen += glyph_width(c) * cap;
      after = true;
      continue;
    }
    n := glyph(c, points[..]);
    d_ink := k;
    d_ink.core = ifx strong then k.core * 1.5 else k.core;
    d_ink.light = ifx strong then font_hi(k.light, font_lo(1, k.light * 1.35)) else k.light;
    if small { d_ink.core = ifx strong then 0.85f32 else 0.6f32; d_ink.glow = 1; d_ink.light = font_lo(1, d_ink.light * 1.2); }
    if strong { d_ink.red = 1; d_ink.green = 1; d_ink.blue = 1; }
    vertices = font_strokes(out, vertices, points[..], n, pen, 0, base, unit, small, d_ink);
    m := font_mark(d.code) - 1;
    if m >= 0 {
      // the mark's anchor in half units: the glyph's centre, left edge or right edge
      w := cast(f32) FONT_WIDTH[font_find(c)];
      anchor := FONT_MARK_ANCHOR[m];
      ox := (ifx anchor == 0 then w / 2 else ifx anchor == 1 then 0.0f32 else w) - 8;
      first := cast(int) FONT_MARK_FIRST[m]; mn := cast(int) FONT_MARK_COUNT[m];
      for q: 0..<mn * 2 { points[q] = FONT_MARK_POINTS[first * 2 + q]; }   // FONT_MAX_POINTS > FONT_MARK_MAX_POINTS
      vertices = font_strokes(out, vertices, points[..], mn, pen, ox, base, unit, small, d_ink);
    }
    pen += glyph_width(c) * cap;
    after = true;
  }
  return vertices;
}

// The end of text's line that starts at byte from, wrapped to width cap
// heights at spaces: the first byte of the next line (past its spaces) is
// written to next[0]. A word longer than the line breaks where it must.
wrap :: (text: string, from: int, width: f32, gap: f32, space: f32, rich: bool, next: [] int) -> int {
  i := from; end := from; w := 0.0f32;
  while i < text.count {
    if text[i] == '\n' { end = i; next[0] = i + 1; return end; }
    // the next word
    j := i;
    while j < text.count && text[j] != ' ' && text[j] != '\n' { j += 1; }
    word := measure(text[i..<j], gap, space, rich);
    lead := ifx end > from then space else 0.0f32;
    if end > from && w + lead + word > width {
      next[0] = i; return end;
    }
    if end == from && word > width {
      // one long word: as many letters as fit
      k := i; fit := k;
      while k < j {
        d := cluster(text, k);
        if measure(text[i..<k + d.len], gap, space, rich) > width && fit > i { break; }
        k += d.len; fit = k;
      }
      next[0] = fit; return fit;
    }
    w += lead + word; end = j; i = j;
    while i < text.count && text[i] == ' ' { i += 1; }
  }
  next[0] = text.count;
  return end;
}

#test "every glyph is on the grid, inside its width, and the table is sorted" {
  for k: 0..<FONT_GLYPHS {
    if k > 0 { #assert FONT_CODES[k - 1] < FONT_CODES[k]; }
    first := cast(int) FONT_FIRST[k]; n := cast(int) FONT_FIRST[k + 1] - first;
    #assert n >= 2 && n <= FONT_MAX_POINTS;
    #assert FONT_POINTS[first * 2] != FONT_BREAK && FONT_POINTS[(first + n - 1) * 2] != FONT_BREAK;
    for p: 0..<n {
      x := FONT_POINTS[(first + p) * 2]; y := FONT_POINTS[(first + p) * 2 + 1];
      if x == FONT_BREAK { #assert y == FONT_BREAK; continue; }
      #assert x <= FONT_WIDTH[k] && y <= 16;
      // whole grid units, except the listed half units: dots, quotes, and the slash family
      if p > 0 && FONT_POINTS[(first + p - 1) * 2] != FONT_BREAK {
        px := FONT_POINTS[(first + p - 1) * 2]; py := FONT_POINTS[(first + p - 1) * 2 + 1];
        #assert px != x || py != y;    // no zero-length segments
      }
    }
  }
}

#test "the HUD's and a deck's characters all have glyphs" {
  need := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,:;!?'\"-/()&%$#@+=*·…–—“”‘’•";
  i := 0;
  while i < need.count {
    d := decode(need[..], i); i += d.len;
    k := font_find(d.code);
    #assert k >= 0 && cast(u32) FONT_CODES[k] == d.code;
  }
  #assert FONT_CODES[font_find('q')] == 'Q' && FONT_CODES[font_find(0xE9)] == 'E';
  #assert FONT_CODES[font_find(0x4E2D)] == FONT_TOFU && FONT_CODES[font_find(0x1F680)] == FONT_TOFU;
}

#test "UTF-8 goes both ways, and bad bytes read as U+FFFD" {
  buf: [8] u8;
  for c: [6] u32.[65, 0xB7, 0xE9, 0x2026, 0x1F600, 0x7FF] {
    n := encode(c, buf[..], 0);
    d := decode(cast(string) buf[0..<n], 0);
    #assert d.code == c && d.len == n;
  }
  #assert encode(0x2026, buf[..], 6) == 0;
  // a lead byte without its continuation, a stray continuation, a cut-off emoji, overlong forms,
  // a surrogate, a code past U+10FFFF and a byte no UTF-8 uses
  bad := [24] u8.[0xE2, 0x41, 0x80, 0xF0, 0x9F, 0x98, 0xC0, 0x80, 0xE0, 0x80, 0x80, 0xED, 0xA0, 0x80,
                  0xF4, 0x90, 0x80, 0x80, 0xFF, 0xF8, 0x88, 0x80, 0x80, 0x80];
  text := cast(string) bad[..];
  for at: [9] int.[0, 2, 3, 6, 8, 11, 14, 18, 19] {
    d := decode(text, at);
    #assert d.code == FONT_BAD && d.len == 1;
  }
  #assert decode(text, 1).code == 'A';
  // a bad byte draws the tofu box, never '?'
  #assert FONT_CODES[font_find(decode(text, 0).code)] == FONT_TOFU;
}

#test "a character is its first code point and what goes with it" {
  // a thumbs up with a skin tone: the thumbs up, 8 bytes
  d := cluster("👍🏽!", 0);
  #assert d.code == 0x1F44D && d.len == 8;
  // a heart with its emoji selector
  d = cluster("❤️", 0);
  #assert d.code == 0x2764 && d.len == 6;
  // a family: man, ZWJ, woman, ZWJ, girl
  family := "👨‍👩‍👧";
  d = cluster(family, 0);
  #assert d.code == 0x1F468 && d.len == family.count && family.count == 18;
  // a woman with a skin tone, ZWJ, a sword (a dark-skinned swordswoman reads as her first emoji)
  d = cluster("👩🏿‍⚔️x", 0);
  #assert d.code == 0x1F469 && d.len == 17;
  // a flag is two regional indicators
  d = cluster("🇺🇸", 0);
  #assert d.code == 0x1F1FA && d.len == 8;
  // a keycap and a combining accent ride on their letter
  d = cluster("1️⃣", 0);
  #assert d.code == '1' && d.len == 7;
  d = cluster("é", 0);
  #assert d.code == 'e' && d.len == 3;
  // a joiner at the end, and plain text
  d = cluster("🔥‍", 0);
  #assert d.code == 0x1F525 && d.len == 7;
  #assert cluster("AB", 0).len == 1 && cluster("été", 0).len == 2;
  // a malformed byte is one character of its own
  cut := [3] u8.[0xF0, 0x9F, 0x98];
  #assert cluster(cast(string) cut[..], 0).len == 1;
  // the extras take no room: a family measures as one emoji, a toned thumb as a plain one
  #assert measure(family, 0.5, 1, false) == measure("👨", 0.5, 1, false);
  #assert measure("👍🏽", 0.5, 1, false) == glyph_width(0x1F44D);
}

#test "Latin-1 and Latin Extended-A letters draw as a base letter and a mark" {
  #assert font_fold(0xE9) == 'E' && font_mark(0xE9) == 2;       // é: E, acute
  #assert font_fold(0xF1) == 'N' && font_mark(0xF1) == 4;       // ñ: N, tilde
  #assert font_fold(0xFC) == 'U' && font_mark(0xFC) == 8;       // ü: U, diaeresis
  #assert font_fold(0xE7) == 'C' && font_mark(0xE7) == 12;      // ç: C, cedilla
  #assert font_fold(0xF8) == 'O' && font_mark(0xF8) == 17;      // ø: O, slash
  #assert font_fold(0xC5) == 'A' && font_mark(0xC5) == 9;       // Å: A, ring
  #assert font_fold(0x161) == 'S' && font_mark(0x161) == 11;    // š: S, caron
  #assert font_fold(0x105) == 'A' && font_mark(0x105) == 13;    // ą: A, ogonek
  #assert font_fold(0x142) == 'L' && font_mark(0x142) == 16;    // ł: L, stroke
  #assert font_fold(0x151) == 'O' && font_mark(0x151) == 10;    // ő: O, double acute
  #assert font_fold(0x131) == 'I' && font_mark(0x131) == 0;     // ı: I
  // the ones with their own glyph: ß, Æ æ, Þ þ, Œ œ, Ĳ ĳ, Ŋ ŋ
  for c: [11] u32.[0xDF, 0xC6, 0xE6, 0xDE, 0xFE, 0x152, 0x153, 0x132, 0x133, 0x14A, 0x14B] {
    #assert FONT_CODES[font_find(c)] != FONT_TOFU && font_mark(c) == 0;
  }
  #assert FONT_CODES[font_find(0xE6)] == 0xC6 && FONT_CODES[font_find(0x153)] == 0x152;
  // every letter in both blocks has a glyph, and every mark is a real one
  for c: 0xC0..<0x180 {
    #assert FONT_CODES[font_find(cast(u32) c)] != FONT_TOFU;
    #assert font_mark(cast(u32) c) >= 0 && font_mark(cast(u32) c) <= FONT_MARKS;
  }
  #assert FONT_MARK_MAX_POINTS <= FONT_MAX_POINTS;   // draw_text copies a mark into a glyph's buffer
  for m: 0..<FONT_MARKS {
    first := cast(int) FONT_MARK_FIRST[m]; n := cast(int) FONT_MARK_COUNT[m];
    #assert n >= 2 && n <= FONT_MARK_MAX_POINTS && FONT_MARK_ANCHOR[m] <= 2;
    #assert FONT_MARK_POINTS[first * 2] != FONT_BREAK && FONT_MARK_POINTS[(first + n - 1) * 2] != FONT_BREAK;
  }
  // an accented letter is as wide as its letter, and draws its letter's strokes and its mark's
  out: [600 * VERTEX_FLOATS] f32;
  k := Ink.{core = 1, light = 0.8, glow = 1, red = 1, green = 1, blue = 1, mode = 0};
  #assert measure("é", 0.5, 1, false) == measure("E", 0.5, 1, false);
  #assert draw_text(out[..], 0, "é", 10, 40, 24, 0.5, 1, k, false, false) == draw_text(out[..], 0, "E", 10, 40, 24, 0.5, 1, k, false, false) + 6;
  #assert draw_text(out[..], 0, "ü", 10, 40, 24, 0.5, 1, k, false, false) == draw_text(out[..], 0, "U", 10, 40, 24, 0.5, 1, k, false, false) + 12;
  // the acute sits above the capital, over the letter's middle
  e := draw_text(out[..], 0, "E", 10, 40, 24, 0.5, 1, k, false, false);
  #assert draw_text(out[..], 0, "é", 10, 40, 24, 0.5, 1, k, false, false) == e + 6;
  #assert out[e * VERTEX_FLOATS + 1] < 40 - 24;   // its stroke starts above the cap line (y down)
}

#test "common emoji draw in colour, and anything else as the tofu box" {
  for q: 0..<EMOJI_COUNT {
    if q > 0 { #assert EMOJI_CODES[q - 1] < EMOJI_CODES[q]; }
    #assert cast(int) EMOJI_PICTURE[q] < EMOJI_ART;
  }
  for e: 0..<EMOJI_ART {
    any := false;
    for r: 0..<8 { for c: 0..<8 { p := emoji_pixel(e, r, c); #assert p * 3 <= EMOJI_PALETTE.count; if p > 0 { any = true; } } }
    #assert any;
  }
  // faces, hearts, thumbs, fire, swords, skulls, party
  for c: [12] u32.[0x1F600, 0x1F602, 0x1F60D, 0x2764, 0x1F499, 0x1F44D, 0x1F44E, 0x1F525, 0x2694, 0x1F480, 0x2620, 0x1F389] {
    #assert emoji_find(c) >= 0 && glyph_width(c) == cast(f32) EMOJI_WIDTH / 12;
  }
  #assert emoji_find(0x1F680) < 0 && emoji_find(0x2013) < 0 && emoji_find('A') < 0 && emoji_find(0xF600) < 0;
  #assert emoji_find(0x2665) == emoji_find(0x2764);   // a suit heart is the red heart
  out: [2000 * VERTEX_FLOATS] f32;
  k := Ink.{core = 0.55, light = 0.85, glow = 1.2, red = 1, green = 0.9, blue = 0.7, mode = 0, scale = 1};
  // a thumbs up draws runs of colour, not the ink's: some yellow and the blue cuff
  n := draw_text(out[..], 0, "👍", 10, 40, 8, 0.5, 1, k, false, false);
  #assert n > 6 * 8;
  yellow := false; blue := false;
  for v: 0..<n / 6 {
    o := v * 6 * VERTEX_FLOATS;
    #assert out[o + 7] == 0;   // no glow
    if out[o + 8] == 1 && out[o + 10] < 0.5 { yellow = true; }
    if out[o + 10] == 1 && out[o + 8] < 0.5 { blue = true; }
  }
  #assert yellow && blue;
  // with a skin tone, a ZWJ or its selector it draws the same picture
  #assert draw_text(out[..], 0, "👍🏽", 10, 40, 8, 0.5, 1, k, false, false) == n;
  #assert draw_text(out[..], 0, "❤️", 10, 40, 8, 0.5, 1, k, false, false) == draw_text(out[..], 0, "❤", 10, 40, 8, 0.5, 1, k, false, false);
  // an emoji the set lacks (a rocket), a letter no table has (中) and a bad byte draw the tofu box, never '?'
  box := draw_text(out[..], 0, "□", 10, 40, 8, 0.5, 1, k, false, false);
  ask := draw_text(out[..], 0, "?", 10, 40, 8, 0.5, 1, k, false, false);
  #assert box == 24 && ask != box;
  #assert draw_text(out[..], 0, "🚀", 10, 40, 8, 0.5, 1, k, false, false) == box;
  #assert draw_text(out[..], 0, "中", 10, 40, 8, 0.5, 1, k, false, false) == box;
  ff := [1] u8.[0xFF];
  #assert draw_text(out[..], 0, cast(string) ff[..], 10, 40, 8, 0.5, 1, k, false, false) == box;
  // at 2 device pixels a pixel, the strokes' ends and rows sit on whole pixels
  m := draw_text(out[..], 0, "😀", 10.3, 40.6, 15, 0.5, 1, k, false, false);
  for v: 0..<m / 6 {
    o := v * 6 * VERTEX_FLOATS;
    #assert out[o + 5] == 0.95;   // core: half of 2 pixels, less 0.05
  }
}

#test "measure and wrap" {
  #assert measure("I", 0.3, 1, false) == 0;
  #assert abs(measure("AB", 0.5, 1, false) - (4.0 / 6 * 2 + 0.5)) < 0.001;
  #assert measure("A**B**", 0.5, 1, true) == measure("AB", 0.5, 1, false);
  #assert measure("A B", 0.5, 1, false) == measure("AB", 0.5, 1, false) - 0.5 + 1;
  #assert bold_at("a **b** c", 4) && !bold_at("a **b** c", 8);
  text := "ONE TWO THREE FOUR";
  next: [1] int;
  width := measure("ONE TWO", 0.3, 0.7, false) + 0.01;
  end := wrap(text[..], 0, width, 0.3, 0.7, false, next[..]);
  #assert end == 7 && next[0] == 8;
  end = wrap(text[..], 8, width, 0.3, 0.7, false, next[..]);
  #assert end == 13 && next[0] == 14;
  end = wrap(text[..], 14, width, 0.3, 0.7, false, next[..]);
  #assert end == 18 && next[0] == 18;
  long := "ABCDEFGHIJ";
  end = wrap(long[..], 0, 3, 0.3, 0.7, false, next[..]);
  #assert end > 0 && end < 10 && measure(long[0..<end], 0.3, 0.7, false) <= 3;
}

#test "small text with a scale lands on device-pixel centres, without glow" {
  out: [600 * VERTEX_FLOATS] f32;
  k := Ink.{core = 1, light = 0.8, glow = 6, red = 1, green = 1, blue = 1, mode = 0, scale = 2};
  // 7.5 CSS pixels at 2x: small. Each quad's first corner is its start, back by core + glow along and across.
  n := draw_text(out[..], 0, "EH", 10.3, 40.7, 15, 0.3, 1, k, false, false);
  #assert n > 0;
  for q: 0..<n / 6 {
    o := q * 6 * VERTEX_FLOATS;
    #assert out[o + 7] == 1 && out[o + 5] == 0.6;   // glow, core
  }
  // the same text large keeps its glow and core
  m := draw_text(out[..], 0, "EH", 10.3, 140.7, 40, 0.3, 1, k, false, false);
  #assert m == n && out[7] == 6 && out[5] == 1;
  // without a scale nothing changes (the splash's inks)
  plain := Ink.{core = 1, light = 0.8, glow = 6, red = 1, green = 1, blue = 1, mode = 0};
  #assert draw_text(out[..], 0, "EH", 10.3, 40.7, 15, 0.3, 1, plain, false, false) == n && out[7] == 6;
}

#test "small text keeps its dots: a period, a colon and an exclamation mark each draw" {
  out: [600 * VERTEX_FLOATS] f32;
  k := Ink.{core = 1, light = 0.8, glow = 6, red = 1, green = 1, blue = 1, mode = 0, scale = 2};
  for cap: 0..<6 {
    c := 8.0f32 + cast(f32) cap * 1.7;
    for at: 0..<4 {
      base := 40.0f32 + cast(f32) at * 0.25;
      #assert draw_text(out[..], 0, ".", 10.3, base, c, 0.3, 1, k, false, false) == 6;
      #assert draw_text(out[..], 0, ":", 10.3, base, c, 0.3, 1, k, false, false) == 12;
      #assert draw_text(out[..], 0, "A.B", 10.3, base, c, 0.3, 1, k, false, false) == draw_text(out[..], 0, "AB", 10.3, base, c, 0.3, 1, k, false, false) + 6;
    }
  }
}

// ---------------------------------------------------------------- the system sans

// Small text on the project pages is set in the system's sans (Helvetica or
// Arial, which share their widths), drawn from a glyph atlas the host
// rasterizes (coax/web/host.js, "the sans atlas"): titles and the HUD's
// chrome stay in Filament. Widths are the fonts' advance widths in
// thousandths of an em; text is laid out here, so both sides agree on them.
// Atlas identity, cell metrics and codepoints come from sans-profile.coax.
SANS_CAP :: 0.716;          // cap height, ems
SANS_SCALE :: 1.3;          // sans text's cap height against the Filament cap it stands in for
SANS_MAX_CAP :: 9.0;        // CSS pixels: Filament from this cap height up (titles)
MODE_SANS :: 4.0;
SANS_WIDTH :: [111] u16.[
  278, 278, 355, 556, 556, 889, 667, 191, 333, 333, 389, 584, 278, 333, 278, 278,
  556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 278, 278, 584, 584, 584, 556,
  1015, 667, 667, 722, 722, 667, 611, 778, 722, 278, 500, 667, 556, 833, 722, 778,
  667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 278, 278, 278, 469, 556,
  333, 556, 556, 500, 556, 556, 278, 556, 556, 222, 222, 500, 222, 833, 556, 556,
  556, 556, 333, 500, 278, 556, 500, 722, 500, 500, 500, 334, 260, 334, 584,
  278, 556, 1000, 222, 222, 333, 333, 350, 1000, 1000, 556, 584, 584, 549, 549, 549
];

// Whether text at cap (device pixels) in ink k is set in the sans.
uses_sans :: (k: Ink, cap: f32) -> bool {
  return k.sans && (k.scale <= 0 || cap < SANS_MAX_CAP * k.scale);
}

// A code point's place in the atlas, or -1.
sans_index :: (code: u32) -> int {
  return render_sans_index(code);
}

// The em of sans text standing in for Filament capitals cap pixels tall.
sans_em :: (cap: f32) -> f32 { return cap * SANS_SCALE / SANS_CAP; }

// How wide text is in the sans at em pixels.
sans_width :: (text: string, em: f32) -> f32 {
  w := 0.0f32; i := 0;
  while i < text.count {
    d := decode(text, i); i += d.len;
    g := sans_index(d.code);
    if g < 0 { g = sans_index('?'); }
    w += cast(f32) SANS_WIDTH[g] / 1000 * em;
  }
  return w;
}

// How wide text is in ink k at cap, whichever face it's set in.
ink_width :: (text: string, cap: f32, gap: f32, space: f32, k: Ink) -> f32 {
  if uses_sans(k, cap) { return sans_width(text, sans_em(cap)); }
  return measure(text, gap, space, false) * cap;
}

// Draws text in the sans, its baseline's left end at x, base: one textured
// quad a glyph (place = the atlas coordinates, shape.x = the em in pixels for
// the shader's mip level, shape.z = brightness). Returns the vertex count.
draw_sans :: (out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  em := sans_em(cap);
  s := em / SANS_EM;
  w := SANS_CELL * cast(f32) SANS_COLUMNS; h := SANS_CELL * cast(f32) SANS_ROWS;
  y0 := floor(base + 0.5) - SANS_BASE * s;
  v := at; pen := x; i := 0;
  while i < text.count {
    d := decode(text, i); i += d.len;
    g := sans_index(d.code);
    if g < 0 { g = sans_index('?'); }
    advance := cast(f32) SANS_WIDTH[g] / 1000 * em;
    if d.code != 32 {
      if (v + 6) * VERTEX_FLOATS > out.count { return v; }
      cx := cast(f32) (g % SANS_COLUMNS) * SANS_CELL; cy := cast(f32) (g / SANS_COLUMNS) * SANS_CELL;
      x0 := pen - SANS_LEFT * s; x1 := x0 + SANS_CELL * s; y1 := y0 + SANS_CELL * s;
      qx := [6] f32.[x0, x1, x1, x0, x1, x0];
      qy := [6] f32.[y0, y0, y1, y0, y1, y1];
      ux := [6] f32.[cx, cx + SANS_CELL, cx + SANS_CELL, cx, cx + SANS_CELL, cx];
      uy := [6] f32.[cy, cy, cy + SANS_CELL, cy, cy + SANS_CELL, cy + SANS_CELL];
      for q: 0..<6 {
        o := (v + q) * VERTEX_FLOATS;
        out[o] = qx[q]; out[o + 1] = qy[q];
        out[o + 2] = ux[q] / w; out[o + 3] = uy[q] / h;
        out[o + 4] = em; out[o + 5] = 0; out[o + 6] = k.light; out[o + 7] = 0;
        out[o + 8] = k.red; out[o + 9] = k.green; out[o + 10] = k.blue; out[o + 11] = MODE_SANS;
      }
      v += 6;
    }
    pen += advance;
  }
  return v;
}

// wrap, measured in device pixels in ink k at cap, so sans text wraps by its own widths.
wrap_ink :: (text: string, from: int, width: f32, cap: f32, gap: f32, space: f32, k: Ink, next: [] int) -> int {
  if !uses_sans(k, cap) { return wrap(text, from, width / cap, gap, space, false, next); }
  i := from; end := from; w := 0.0f32;
  sp := sans_width(" ", sans_em(cap));
  while i < text.count {
    if text[i] == '\n' { end = i; next[0] = i + 1; return end; }
    j := i;
    while j < text.count && text[j] != ' ' && text[j] != '\n' { j += 1; }
    word := ink_width(text[i..<j], cap, gap, space, k);
    lead := ifx end > from then sp else 0.0f32;
    if end > from && w + lead + word > width { next[0] = i; return end; }
    if end == from && word > width {
      q := i; fit := q;
      while q < j {
        d := cluster(text, q);
        if ink_width(text[i..<q + d.len], cap, gap, space, k) > width && fit > i { break; }
        q += d.len; fit = q;
      }
      next[0] = fit; return fit;
    }
    w += lead + word; end = j; i = j;
    while i < text.count && text[i] == ' ' { i += 1; }
  }
  next[0] = text.count;
  return end;
}

#test "the sans covers ASCII and its extras, in the host's order" {
  #assert SANS_GLYPHS == 95 + 16 && SANS_COLUMNS * SANS_ROWS >= SANS_GLYPHS;
  #assert sans_index('A') == 33 && sans_index(' ') == 0 && sans_index('~') == 94;
  #assert sans_index(8212) == 97 && sans_index(8800) == 110 && sans_index(9731) == -1;
  #assert SANS_WIDTH[sans_index('M')] == 833 && SANS_WIDTH[sans_index('i')] == 222;
  #assert sans_width("HI", 1000) == 1000;
}

#test "Font and atlas roundtrip every codepoint into the same glyph cell" {
  font_atlas_fp := render_sans_profile();
  #assert SANS_WIDTH.count == font_atlas_fp.glyphs;
  font_atlas_ftext: [4] u8; font_atlas_fvertices: [6 * VERTEX_FLOATS] f32;
  font_atlas_fk := Ink.{core = 1, light = 1, glow = 0, red = 1, green = 1, blue = 1, mode = 0, sans = true};
  for font_atlas_fi: 0..<111 {
    font_atlas_fg := render_sans_glyph(0, font_atlas_fi);
    font_atlas_fn := encode(font_atlas_fg.code, font_atlas_ftext[..], 0);
    font_atlas_fr := decode(cast(string) font_atlas_ftext[0..<font_atlas_fn], 0);
    #assert font_atlas_fn > 0 && font_atlas_fr.len == font_atlas_fn && font_atlas_fr.code == font_atlas_fg.code && sans_index(font_atlas_fr.code) == font_atlas_fi;
    font_atlas_fv := draw_sans(font_atlas_fvertices[..], 0, cast(string) font_atlas_ftext[0..<font_atlas_fn], 20, 100, 8, font_atlas_fk);
    if font_atlas_fi == 0 { #assert font_atlas_fv == 0; }
    else {
      #assert font_atlas_fv == 6 && font_atlas_fvertices[11] == 4;
      #assert font_atlas_fvertices[2] == f32(font_atlas_fi % 16) / 16 && font_atlas_fvertices[3] == f32(font_atlas_fi / 16) / 7;
      #assert font_atlas_fvertices[2 * VERTEX_FLOATS + 2] == f32(font_atlas_fi % 16 + 1) / 16;
      #assert font_atlas_fvertices[2 * VERTEX_FLOATS + 3] == f32(font_atlas_fi / 16 + 1) / 7;
    }
  }
}
