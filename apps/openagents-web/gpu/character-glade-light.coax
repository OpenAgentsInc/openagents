// Scene-authored lighting informed by ore's lighting reconstruction, sections 5–9.
// These are our equations, not recovered Nintendo/Unreal shader equations.
#test "glade light decodes display colour once and round trips neutral grey" {
 #assert abs(cg_linear(0.5)-0.214041)<0.00001;
 #assert abs(cg_srgb(cg_linear(0.18))-0.18)<0.00001 && cg_linear(0)==0 && cg_srgb(0)==0;
}
#test "glade HDR shoulder preserves midtones and orders highlights above white" {
 #assert cg_shoulder(0.18)==0.18 && cg_shoulder(1)<cg_shoulder(4);
 #assert cg_shoulder(4)<cg_shoulder(100) && cg_shoulder(100)<=1;
}
#test "glade indirect occlusion and sun visibility affect separate light terms" {
 n:=v3(0,1,0);a:=cg_irradiance(n,1,1,0);b:=cg_irradiance(n,1,0.5,0);c:=cg_irradiance(n,1,1,1);
 #assert b.x<a.x && c.x>a.x;
 #assert abs((c.x-a.x)-(cg_irradiance(n,1,0.5,1).x-b.x))<0.00001;
 #assert cg_hemisphere(v3(0,1,0)).z>cg_hemisphere(v3(0,-1,0)).z;
}
#test "glade air has zero optical depth at the eye and thins above the meadow" {
 eye:=v3(0,1,3);#assert cg_air_depth(eye,eye)==0;
 low:=cg_air_depth(eye,v3(0,1,-30));high:=cg_air_depth(v3(0,20,3),v3(0,20,-30));
 #assert low>high && low>0 && low<1;
}
cg_linear :: (x:f32)->f32 {return ifx x<=0.04045f32 then fmax(x,0)/12.92f32 else pow((x+0.055f32)/1.055f32,2.4f32);}
cg_srgb :: (x:f32)->f32 {return ifx x<=0.0031308f32 then fmax(x,0)*12.92f32 else 1.055f32*pow(x,1.0f32/2.4f32)-0.055f32;}
cg_decode :: (c:V3)->V3 {return v3(cg_linear(c.x),cg_linear(c.y),cg_linear(c.z));}
cg_encode :: (c:V3)->V3 {return v3(cg_srgb(c.x),cg_srgb(c.y),cg_srgb(c.z));}
cg_shoulder :: (x:f32)->f32 {return ifx x<=0.65f32 then fmax(x,0) else 0.65f32+0.35f32*(1.0f32-exp(-(x-0.65f32)/0.35f32));}
cg_output :: (c:V3)->V3 {
 // One peak-channel gain preserves RGB ratios instead of clipping each channel.
 peak:=fmax(c.x,fmax(c.y,c.z));mapped:=scale3(c,ifx peak>0.00001f32 then cg_shoulder(peak)/peak else 1.0f32);return cg_encode(mapped);
}
cg_hemisphere :: (n:V3)->V3 {return mix3(v3(0.24f32,0.30f32,0.11f32),v3(0.38f32,0.47f32,0.62f32),saturate(n.y*0.5f32+0.5f32));}
cg_irradiance :: (n:V3,direct:f32,occlusion:f32,visibility:f32)->V3 {
 return add3(scale3(cg_hemisphere(n),occlusion),scale3(v3(1.85f32,1.62f32,1.22f32),direct*visibility));
}
cg_air_depth :: (eye:V3,p:V3)->f32 {
 ray:=sub3(p,eye);distance:=wg_length3(ray);density:f32=0;
 for i:0..<4 {height:=eye.y+ray.y*(cast(f32)i+0.5f32)*0.25f32;density=density+exp(-fmax(height,0)/8.0f32);}
 return distance*0.008f32*density*0.25f32;
}
cg_atmosphere :: (colour:V3,eye:V3,p:V3)->V3 {
 ray:=normalize3(add3(sub3(p,eye),v3(0,0.00001f32,0)));sun:=normalize3(v3(-0.45f32,0.78f32,-0.42f32));
 forward:=pow(saturate(dot3(ray,sun)),4.0f32);
 air:=mix3(v3(0.62f32,0.77f32,0.87f32),v3(1.15f32,1.02f32,0.72f32),0.35f32+forward*0.65f32);
 trans:=exp(-cg_air_depth(eye,p));return add3(scale3(colour,trans),scale3(air,1.0f32-trans));
}
#test "glade octahedral normal storage leaves room for indirect-light weight" {
 for i:0..<6 {n:=normalize3(v3(ifx i%2==0 then 0.3f32 else -0.3f32,ifx i<3 then 0.7f32 else -0.7f32,ifx i%3==0 then -0.4f32 else 0.4f32));p:=cg_normal_pack(n);r:=cg_normal_unpack(p);#assert dot3(n,r)>0.9999f32;}
}
cg_sign :: (x:f32)->f32 {return ifx x<0 then -1.0f32 else 1.0f32;}
cg_normal_pack :: (n:V3)->V2 {
 v:=scale3(n,1.0f32/(abs(n.x)+abs(n.y)+abs(n.z)));p:=v2(v.x,v.y);
 if (v.z<0) {p=v2((1.0f32-abs(v.y))*cg_sign(v.x),(1.0f32-abs(v.x))*cg_sign(v.y));}return p;
}
cg_normal_unpack :: (p:V2)->V3 {
 n:=v3(p.x,p.y,1.0f32-abs(p.x)-abs(p.y));t:=saturate(-n.z);n.x=n.x-cg_sign(n.x)*t;n.y=n.y-cg_sign(n.y)*t;return normalize3(n);
}

#test "glade highlight compression preserves orange RGB ratios" {
 c:=cg_decode(cg_output(v3(4,1,0.25)));#assert abs(c.x/c.y-4)<0.0001 && abs(c.y/c.z-4)<0.0001;
}
