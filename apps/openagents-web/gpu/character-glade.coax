// The Nature reference's bright cyan sky, wind and warm/cool outdoor light.
// Loaded after verse/gpu/wgsl.coax and verse/style.coax by fivelab.coax.
#test "glade sky retains cyan daylight and warm sunlight without nonfinite horizons" {
 a:=cg_sky(v3(0,0.2,-1),v3(-0.4,0.8,0.6),0);
 b:=cg_sky(v3(0,0,-1),v3(-0.4,0.8,0.6),0);
 #assert a.y>0.6 && a.z>0.5 && b.x>0.3 && b.z<=1.1;
 cyan:=false;for i:0..<8 {c:=cg_sky(v3(f32(i)*0.2-0.8,0.4,-1),v3(-0.4,0.8,0.6),0);if c.y>c.x && c.z>c.x {cyan=true;}}#assert cyan;
}
cg_noise :: (p:V2)->f32 {
 i:V2=v2(floor(p.x),floor(p.y));f:V2=v2(fract(p.x),fract(p.y));
 f=v2(f.x*f.x*(3.0f32-2.0f32*f.x),f.y*f.y*(3.0f32-2.0f32*f.y));
 a:f32=verse_style_hash(i.x,i.y);b:f32=verse_style_hash(i.x+1.0f32,i.y);c:f32=verse_style_hash(i.x,i.y+1.0f32);d:f32=verse_style_hash(i.x+1.0f32,i.y+1.0f32);
 return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}
cg_sky :: (rd:V3,sun:V3,time:f32)->V3 {
 up:f32=saturate(rd.y);
 col:V3=mix3(v3(0.82f32,0.94f32,0.90f32),v3(0.53f32,0.87f32,0.92f32),sqrt(saturate(up*2.0f32+0.14f32)));
 q:V2=v2(rd.x/fmax(rd.y+0.32f32,0.15f32),rd.z/fmax(rd.y+0.32f32,0.15f32));
 p:V2=v2(q.x*9.0f32+time*0.008f32,q.y*9.0f32);
 cloud:f32=cg_noise(p)*0.55f32+cg_noise(v2(p.x*2.1f32,p.y*2.1f32))*0.28f32+cg_noise(v2(p.x*5.0f32,p.y*5.0f32))*0.17f32;
 mask:f32=smoothstep(0.59f32,0.73f32,cloud)*smoothstep(-0.10f32,0.13f32,rd.y);
 streak:f32=pow(saturate(cg_noise(v2(q.x*25.0f32+q.y*5.0f32,q.y*1.5f32))-0.35f32)*1.8f32,3.0f32)*0.5f32;
 col=mix3(col,v3(1.0f32,0.985f32,0.92f32),saturate(mask+streak));
 halo:f32=pow(saturate(dot3(normalize3(rd),normalize3(sun))),12.0f32);
 return mix3(col,v3(1.0f32,0.98f32,0.83f32),halo*0.35f32);
}
cg_environment_vs :: (id:u32,instance:u32,m:FivelabObj,u:[]f32,vertices:[]u32)->FivelabS {
 b:u32=add_wrap(wg_u32_f(m.b.w),mul_wrap(id,8));
 p:V3=v3(f32_from_bits(vertices[cast(int)b]),f32_from_bits(vertices[cast(int)add_wrap(b,1)]),f32_from_bits(vertices[cast(int)add_wrap(b,2)]));
 normal:u32=vertices[cast(int)add_wrap(b,3)];kind:u32=(normal>>24)&255;
 tint:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(b,5)]);
 wind:f32=sin(p.x*1.8f32+p.z*0.7f32+u[2]*1.6f32)+sin(p.z*2.7f32+u[2]*0.9f32)*0.35f32;
 if ((kind==1)||(kind==2)) {p.x=p.x+wind*(ifx kind==2 then 0.035f32 else 0.045f32)*saturate(p.y*0.7f32);}
 nw:V4=wg_unpack4x8snorm(normal);o:FivelabS;o.pos=fivelab_project(p,u);o.world=p;o.normal=v3(nw.x,nw.y,nw.z);o.uv=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]);o.slice=vertices[cast(int)add_wrap(b,6)];o.tint=v3(tint.x,tint.y,tint.z);o.dye=v4(0.0f32,0.0f32,0.0f32,12.0f32);o.local=v3(cast(f32)kind,0.0f32,0.0f32);o.who=instance;return o;
}
cg_environment_fs :: (s:FivelabS,tex:V4,front:bool,u:[]f32)->V4 {
 kind:f32=s.local.x;n:V3=normalize3(add3(s.normal,v3(0.0f32,0.0001f32,0.0f32)));if (!front) {n=scale3(n,-1.0f32);}
 sun:V3=normalize3(v3(-0.278f32,0.913f32,0.300f32));light:f32=saturate(dot3(n,sun));
 albedo:V3=mul3(v3(pow(tex.x,0.4545f32),pow(tex.y,0.4545f32),pow(tex.z,0.4545f32)),s.tint);
 if ((kind>0.5f32)&&(kind<2.5f32)) {albedo=s.tint;}
 if (kind>6.5f32) {albedo=s.tint;}
 if (kind>2.5f32 && kind<3.5f32) {albedo=scale3(s.tint,0.8f32+0.2f32*verse_style_luma(tex.x,tex.y,tex.z));}
 if (kind>4.5f32 && kind<5.5f32) {albedo=mul3(s.tint,v3(1.12f32,1.18f32,1.65f32));}
 // Leaf transmission and soft wrap light keep foliage luminous rather than metallic.
 lit:f32=0.58f32+0.42f32*smoothstep(-0.15f32,0.75f32,dot3(n,sun));
 if (kind<2.5f32 && kind>0.5f32) {lit=0.77f32+0.30f32*light;}
 colour:V3=mul3(albedo,v3(lit*1.10f32,lit*1.04f32,lit*0.83f32));
 if (kind>3.5f32 && kind<4.5f32) {
   mineral:V3=scale3(v3(0.72f32,0.76f32,0.61f32),0.88f32+0.20f32*pow(verse_style_luma(tex.x,tex.y,tex.z),0.4545f32));
   colour=mul3(mineral,mix3(v3(0.68f32,0.77f32,0.55f32),v3(1.15f32,1.16f32,1.02f32),smoothstep(0.02f32,0.75f32,light)));
 }
 if (kind>0.5f32 && kind<1.5f32) {variation:f32=cg_noise(v2(s.world.x*0.9f32+s.world.z*0.5f32,s.world.y*1.1f32));colour=scale3(colour,0.88f32+variation*0.28f32);}
 if (kind>4.5f32 && kind<5.5f32) {
   shadow:f32=exp(-(s.world.x*s.world.x+s.world.z*s.world.z)*2.5f32)*0.36f32;
   mottled:f32=cg_noise(v2(s.world.x*1.8f32,s.world.z*1.8f32));colour=scale3(colour,(1.0f32-shadow)*(0.92f32+0.15f32*mottled));
 }
 distance:f32=wg_length3(sub3(s.world,wg_at3(u,16)));haze:f32=1.0f32-exp(-distance*0.006f32);
 colour=mix3(colour,v3(0.81f32,0.90f32,0.72f32),haze*0.65f32);
 return v4(colour.x,colour.y,colour.z,1.0f32);
}

#test "glade mobile panels cover the first appearance row while leaving the figure visible" {
 #assert cg_ui_cover(v2(20,360),390,844,1) && !cg_ui_cover(v2(190,300),390,844,1);
 #assert cg_ui_cover(v2(100,250),1440,900,1) && !cg_ui_cover(v2(720,250),1440,900,1);
}
cg_ui_cover :: (p:V2,w:f32,h:f32,k:f32)->bool {
 if (w<840.0f32*k) {return p.y>h-504.0f32*k;}
 return ((p.x<286.0f32*k)||(p.x>w-286.0f32*k))&&(p.y>140.0f32*k);
}
