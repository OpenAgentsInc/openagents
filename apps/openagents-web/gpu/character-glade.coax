// The Nature reference's bright cyan sky, wind and warm/cool outdoor light.
// Loaded after verse/gpu/wgsl.coax and verse/style.coax by fivelab.coax.
#load "../../../verse/character-glade.coax";
#load "../../../aethyr/render/filmic.coax";
#load "character-glade-light.coax";
#test "glade sky retains cyan daylight and warm sunlight without nonfinite horizons" {
 a:=cg_sky(v3(0,0.2,-1),v3(-0.4,0.8,0.6),0);
 b:=cg_sky(v3(0,0,-1),v3(-0.4,0.8,0.6),0);
 #assert a.y>0.6 && a.z>0.5 && b.x>0.3 && b.z<=1.1;
 cyan:=false;for i:0..<8 {c:=cg_sky(v3(f32(i)*0.2-0.8,0.4,-1),v3(-0.4,0.8,0.6),0);if c.y>c.x && c.z>c.x {cyan=true;}}#assert cyan;
}
#test "glade soil seams stay subtle and deterministic" {
 a:=cg_soil(v2(0.1,0.2));#assert a>=0.78 && a<=1.05 && a==cg_soil(v2(0.1,0.2));
}
cg_soil :: (p:V2)->f32 {
 cell:V2=v2(floor(p.x*3.5f32),floor(p.y*3.5f32));local:V2=v2(fract(p.x*3.5f32),fract(p.y*3.5f32));
 first:f32=10.0f32;second:f32=10.0f32;
 for j:0..<3 {for i:0..<3 {x:f32=cast(f32)i-1.0f32;y:f32=cast(f32)j-1.0f32;
  dx:f32=x+0.15f32+0.7f32*verse_style_hash(cell.x+x,cell.y+y)-local.x;
  dy:f32=y+0.15f32+0.7f32*verse_style_hash(cell.x+x+17.0f32,cell.y+y+3.0f32)-local.y;
  d:f32=dx*dx+dy*dy;if (d<first) {second=first;first=d;} else if (d<second) {second=d;}
 }}
 return (0.86f32+0.14f32*smoothstep(0.0f32,0.05f32,second-first))*(0.94f32+0.06f32*cg_noise(v2(p.x*2.0f32,p.y*2.0f32)));
}
cg_noise :: (p:V2)->f32 {
 i:V2=v2(floor(p.x),floor(p.y));f:V2=v2(fract(p.x),fract(p.y));
 f=v2(f.x*f.x*(3.0f32-2.0f32*f.x),f.y*f.y*(3.0f32-2.0f32*f.y));
 a:f32=verse_style_hash(i.x,i.y);b:f32=verse_style_hash(i.x+1.0f32,i.y);c:f32=verse_style_hash(i.x,i.y+1.0f32);d:f32=verse_style_hash(i.x+1.0f32,i.y+1.0f32);
 return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}
// Soft cloud shadows drift over the meadow as in the reference's dappled hill: two octaves of
// value noise, so a good part of the ground lies in broad shade (sunlight times .45).
cg_cloud :: (x:f32,z:f32)->f32 {
 c:=cg_noise(v2(x*0.10f32+12.9f32,z*0.10f32-1.7f32))*0.7f32+cg_noise(v2(x*0.27f32,z*0.27f32))*0.3f32;
 return 1.0f32-0.55f32*smoothstep(0.44f32,0.60f32,c);
}
#test "glade cloud shadows stay between broad shade and full sun and vary over the meadow" {
 lo:f32=1;hi:f32=0;
 for i:0..<400 {v:=cg_cloud(cast(f32)(i%20)*3.0f32,cast(f32)(i/20)*3.0f32);lo=fmin(lo,v);hi=fmax(hi,v);#assert v>=0.45f32 && v<=1;}
 #assert lo<0.6f32 && hi==1;
}
cg_cloud_fbm :: (p:V2)->f32 {
 return cg_noise(p)*0.5333f32+cg_noise(v2(p.x*2.03f32+7.0f32,p.y*2.03f32-3.0f32))*0.2667f32+cg_noise(v2(p.x*4.11f32-5.0f32,p.y*4.11f32+11.0f32))*0.1333f32+cg_noise(v2(p.x*8.31f32+13.0f32,p.y*8.31f32))*0.0667f32;
}
cg_sky :: (rd:V3,sun:V3,time:f32)->V3 {
 up:=saturate(rd.y);col:=mix3(v3(0.84f32,0.95f32,0.96f32),v3(0.52f32,0.86f32,0.94f32),sqrt(saturate(up*1.5f32+0.08f32)));
 q:=v2(rd.x/fmax(rd.y+0.15f32,0.08f32),rd.z/fmax(rd.y+0.15f32,0.08f32));
 p:=v2(q.x*10.0f32+time*0.001f32,q.y*14.0f32);warp:=v2(cg_noise(v2(p.x*0.45f32,p.y*0.45f32)),cg_noise(v2(p.x*0.45f32+7.0f32,p.y*0.45f32-3.0f32)));
 density:=cg_cloud_fbm(v2(p.x+warp.x*0.8f32,p.y+warp.y*0.8f32));threshold:=0.62f32-0.10f32*smoothstep(-0.5f32,0.8f32,rd.x);
 cloud:=smoothstep(threshold,threshold+0.09f32,density)*smoothstep(0.0f32,0.12f32,rd.y)*(0.15f32+0.85f32*smoothstep(-0.15f32,0.70f32,rd.x));
 thickness:=saturate((density-threshold)*6.0f32);cloud_colour:=mix3(v3(0.76f32,0.85f32,0.90f32),v3(1.0f32,0.995f32,0.98f32),saturate(thickness*0.70f32+0.15f32));
 col=mix3(col,cloud_colour,cloud*0.95f32);
 across:=q.x*0.78f32+q.y*0.63f32;along:=-q.x*0.63f32+q.y*0.78f32;
 fine:=cg_cloud_fbm(v2(along*0.75f32+cg_noise(v2(across*0.3f32,along*0.3f32))*0.4f32,across*30.0f32));
 wisps:=pow(saturate((fine-0.35f32)*1.6f32),3.0f32)*smoothstep(0.10f32,0.55f32,rd.y)*0.85f32*smoothstep(0.35f32,0.70f32,cg_noise(v2(q.x*0.7f32,q.y*0.7f32)));
 col=mix3(col,v3(0.98f32,0.99f32,0.99f32),wisps);
 halo:=pow(saturate(dot3(normalize3(rd),normalize3(sun))),8.0f32);return mix3(col,v3(1,0.97f32,0.81f32),halo*0.16f32);
}
#test "glade sky texture rays preserve reference image alignment" {
 r:=cg_sky_ray(-1,1);fy:=0.4f32/sqrt(9.77f32);fz:= -3.1f32/sqrt(9.77f32);z:=r.y*fy+r.z*fz;up:=r.y*(-fz)+r.z*fy;
 #assert abs(960.0f32+961.2f32*r.x/z)<0.01 && abs(518.4f32-961.2f32*up/z)<0.01;
}
cg_sky_ray :: (x:f32,y:f32)->V3 {
 fy:=0.4f32/sqrt(9.77f32);fz:= -3.1f32/sqrt(9.77f32);qx:=x*1920.0f32/(1080.0f32*1.78f32);qy:=(y*0.5f32-0.02f32)/0.89f32;
 return v3(qx,fy-qy*fz,fz+qy*fy);
}
cg_environment_vs :: (id:u32,instance:u32,m:FivelabObj,u:[]f32,vertices:[]u32)->FivelabS {
 b:u32=add_wrap(wg_u32_f(m.b.w),mul_wrap(id,8));
 p:V3=v3(f32_from_bits(vertices[cast(int)b]),f32_from_bits(vertices[cast(int)add_wrap(b,1)]),f32_from_bits(vertices[cast(int)add_wrap(b,2)]));
 sky_clip:=v4(p.x,p.y,0.999999f32,1);
 seed_uv:V2=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]);
 uv:V2=seed_uv;
 normal:u32=vertices[cast(int)add_wrap(b,3)];kind:u32=(normal>>24)&7;
 if (kind==0) {p=add3(wg_at3(u,16),scale3(cg_sky_ray(p.x,p.y),180.0f32));}
 if (kind==6) {uv=v2(seed_uv.x*64.0f32-32.0f32,seed_uv.y*64.0f32-32.0f32);}
 if (kind==4 && f32_from_bits(vertices[cast(int)add_wrap(b,7)])>=100.0f32) {uv=v2(seed_uv.x*8.0f32-4.0f32,seed_uv.y*8.0f32-4.0f32);}
 tint:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(b,5)]);
 wind:f32=sin(p.x*1.8f32+p.z*0.7f32+u[2]*1.6f32)+sin(p.z*2.7f32+u[2]*0.9f32)*0.35f32;
 if ((kind==1)||(kind==2)) {p.x=p.x+wind*(ifx kind==2 then 0.025f32 else 0.035f32)*(ifx kind==2 then wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]).y else saturate(p.y*0.7f32));}
 nw:V4=wg_unpack4x8snorm(normal);normal3:=v3(nw.x,nw.y,nw.z);
 if (m.d.w>17.5f32) {local:=sub3(p,v3(m.b.x,m.b.y,m.b.z));cs:=m.c.y;sn:=m.c.x;p=add3(v3(m.a.x,m.a.y,m.a.z),v3(local.x*cs+local.z*sn,local.y,-local.x*sn+local.z*cs));normal3=v3(normal3.x*cs+normal3.z*sn,normal3.y,-normal3.x*sn+normal3.z*cs);}
 o:FivelabS;o.pos=ifx kind==0 then sky_clip else fivelab_project(p,u);o.world=p;o.normal=normal3;o.uv=uv;o.slice=vertices[cast(int)add_wrap(b,6)];o.tint=v3(tint.x,tint.y,tint.z);o.dye=v4(0.0f32,0.0f32,0.0f32,12.0f32);o.local=v3(cast(f32)kind,f32_from_bits(vertices[cast(int)add_wrap(b,7)]),0.0f32); o.who=instance;return o;
}
#test "glade source mesh instances retain source shape and independent scale" {
 p:=cg_instance_point(v3(1,2,0),v3(4,0,-5),0.5,0.25,0);
 #assert p.x==4.25 && p.y==1 && p.z== -5;
}
#test "village atlas wraps source UV inside its padded tile" {
 p:=cg_village_uv(v2(-0.5,1.25),109);#assert abs(p.x-0.375)<0.001 && p.y>0.56 && p.y<0.57;
 q:=cg_village_uv(v2(2.5,-0.75),109);#assert abs(p.x-q.x)<0.0001 && abs(p.y-q.y)<0.0001;
}
cg_village_uv :: (uv:V2,marker:f32)->V2 {
 tile:=floor(marker-100.0f32+0.5f32);x:=tile-floor(tile/4.0f32)*4.0f32;y:=floor(tile/4.0f32);
 return v2((x*256.0f32+2.0f32+fract(uv.x)*252.0f32)/1024.0f32,(y*256.0f32+2.0f32+fract(uv.y)*252.0f32)/1024.0f32);
}
cg_instance_point :: (p:V3,center:V3,vertical:f32,horizontal:f32,angle:f32)->V3 {
 cs:f32=cos(angle);sn:f32=sin(angle);
 return add3(center,v3((p.x*cs+p.z*sn)*horizontal,p.y*vertical,(-p.x*sn+p.z*cs)*horizontal));
}
cg_instanced_vs :: (id:u32,instance:u32,m:FivelabObj,u:[]f32,vertices:[]u32)->FivelabS {
 b:u32=add_wrap(wg_u32_f(m.b.w),mul_wrap(id,8));seed:u32=add_wrap(wg_u32_f(m.a.x),mul_wrap(instance&65535,8));
 source:V3=v3(f32_from_bits(vertices[cast(int)b]),f32_from_bits(vertices[cast(int)add_wrap(b,1)]),f32_from_bits(vertices[cast(int)add_wrap(b,2)]));
 center:V3=v3(f32_from_bits(vertices[cast(int)seed]),f32_from_bits(vertices[cast(int)add_wrap(seed,1)]),f32_from_bits(vertices[cast(int)add_wrap(seed,2)]));
 sizes:V2=wg_unpack2x16unorm(vertices[cast(int)add_wrap(seed,4)]);angle:f32=f32_from_bits(vertices[cast(int)add_wrap(seed,7)]);
 p:V3=cg_instance_point(source,center,sizes.x,sizes.y,angle);height:f32=saturate(source.y);
 p.x=p.x+(sin(center.x*1.8f32+center.z*0.7f32+u[2]*1.6f32)+sin(center.z*2.7f32+u[2]*0.9f32)*0.35f32)*0.045f32*height*height;
 packed:u32=vertices[cast(int)add_wrap(b,3)];nw:V4=wg_unpack4x8snorm(packed);
 n:V3=normalize3(v3((nw.x*cos(angle)+nw.z*sin(angle))/sizes.y,nw.y/sizes.x,(-nw.x*sin(angle)+nw.z*cos(angle))/sizes.y));
 base:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(seed,5)]);autumn:f32=cg_autumn(center.x,center.z);
 o:FivelabS;o.pos=fivelab_project(p,u);o.world=p;o.normal=n;o.uv=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]);o.slice=vertices[cast(int)add_wrap(b,6)];
 rust:=saturate((center.x-0.5f32)/3.0f32)*smoothstep(0.50f32,0.72f32,cg_noise(v2(center.x*0.8f32,center.z*0.8f32)))*(1.0f32-autumn);
 bottom:=mix3(v3(base.x,base.y,base.z),v3(0.56f32,0.17f32,0.025f32),rust);top:=mix3(v3(0.65f32+0.28f32*autumn,0.88f32-0.20f32*autumn,0.07f32),v3(0.95f32,0.41f32,0.035f32),rust);o.tint=mix3(bottom,top,height);
 o.dye=v4(0,0,0,12);o.local=v3(2,height,1);o.who=(instance>>16)-1;return o;
}
// The town at the end of the road (verse/character-glade.coax cg_city, packed on the rock layer
// with one flat tint a material, character_glade_pack.coax gp_town_block): which material a tint is,
// 0 stone, 1 tower stone, 2 plaster, 3 tile, 4 slate, 5 timber, or -1 for a real rock.
cg_town_material :: (t:V3)->f32 {
 pal:=[6]V3.[v3(0.60f32,0.58f32,0.50f32),v3(0.55f32,0.53f32,0.47f32),v3(0.88f32,0.82f32,0.68f32),v3(0.68f32,0.28f32,0.16f32),v3(0.32f32,0.35f32,0.40f32),v3(0.36f32,0.25f32,0.15f32)];
 for k:0..<6 {d:=sub3(t,pal[k]);if (abs(d.x)<0.012f32 && abs(d.y)<0.012f32 && abs(d.z)<0.012f32) {return cast(f32)k;}}
 return -1;
}
// A town face painted as Everglade's own gate is built (display colour): coursed stone with mortar
// and a value per block, timber-framed plaster darker at its foot, roof tiles in rows, grained wood.
cg_town_albedo :: (m:f32,t:V3,p:V3,n:V3)->V3 {
 along:=ifx abs(n.x)>abs(n.z) then p.z else p.x;
 if (m<1.5f32) {
  row:=floor(p.y/0.42f32);off:=ifx fract(row*0.5f32)>0.25f32 then 0.4f32 else 0.0f32;col:=floor((along+off)/0.8f32);
  gy:=fract(p.y/0.42f32);gx:=fract((along+off)/0.8f32);
  mortar:=fmax(1.0f32-smoothstep(0.0f32,0.045f32,fmin(gy,1.0f32-gy)),1.0f32-smoothstep(0.0f32,0.03f32,fmin(gx,1.0f32-gx)));
  if (n.y>0.7f32) {mortar=0;}
  k:=0.86f32+0.24f32*verse_style_hash(col+row*17.0f32,m*3.0f32);
  moss:=smoothstep(0.6f32,1.0f32,verse_style_hash(col*1.3f32,row+5.0f32))*0.25f32;
  g:=(t.x+t.y+t.z)/3.0f32;c:=scale3(mix3(t,v3(g*1.04f32,g,g*0.94f32),0.5f32),k);c=mix3(c,v3(0.45f32,0.52f32,0.30f32),moss);return mix3(c,scale3(c,0.68f32),mortar);
 }
 if (m<2.5f32) {
  frame:=1.0f32-smoothstep(0.0f32,0.09f32,abs(fract(along/1.6f32+0.5f32)-0.5f32)*1.6f32);
  foot:=1.0f32-smoothstep(1.9f32,2.7f32,p.y); // the plateau stands at 1.8 m (CG_PLATEAU)
  c:=scale3(t,0.94f32+0.08f32*verse_style_hash(floor(along*3.0f32),floor(p.y*3.0f32)));
  c=mix3(c,scale3(c,0.78f32),saturate(foot));return mix3(c,v3(0.36f32,0.25f32,0.15f32),frame*0.9f32);
 }
 if (m<4.5f32) {
  gy:=fract(p.y/0.22f32);row:=floor(p.y/0.22f32);col:=floor((along+ifx fract(row*0.5f32)>0.25f32 then 0.15f32 else 0.0f32)/0.3f32);
  c:=scale3(t,0.85f32+0.25f32*verse_style_hash(col,row));return scale3(c,0.62f32+0.38f32*smoothstep(0.0f32,0.25f32,gy));
 }
 grain:=0.86f32+0.14f32*sin(p.y*31.0f32+sin(along*1.3f32)*0.8f32);
 return scale3(t,grain);
}
#test "town tints map to their materials and real rock tints do not" {
 #assert cg_town_material(v3(0.88f32,0.82f32,0.68f32))==2 && cg_town_material(v3(0.36f32,0.25f32,0.15f32))==5 && cg_town_material(v3(0.60f32,0.58f32,0.50f32))==0;
 #assert cg_town_material(v3(0.50f32,0.52f32,0.40f32))== -1;
 a:=cg_town_albedo(0,v3(0.6f32,0.58f32,0.5f32),v3(0.4f32,0.21f32,0),v3(0,0,1));b:=cg_town_albedo(0,v3(0.6f32,0.58f32,0.5f32),v3(0.4f32,0.0f32,0),v3(0,0,1));
 #assert b.x<a.x; // the mortar line is darker than the block
}
// An autumn crown's leaf colour by age (a world-anchored noise): old leaves turn orange, young
// leaves on a red tree deepen to the reference's crimson, so one crown holds both (Preview_1.jpg).
#test "red crowns keep crimson lobes and still show orange ones" {
 young:=cg_leaf_palette(v3(1,0.22f32,0.025f32),0.1f32);old:=cg_leaf_palette(v3(1,0.22f32,0.025f32),0.95f32);
 #assert young.y<0.12 && old.y>0.38 && young.x>0.65;
 gold:=cg_leaf_palette(v3(1,0.72f32,0.18f32),0.1f32);#assert gold.y>0.65;
}
cg_leaf_palette :: (tint:V3,age:f32)->V3 {
 red:=saturate((0.5f32-tint.y)*3.0f32);
 deep:=mix3(tint,v3(0.66f32,0.05f32,0.02f32),(1.0f32-smoothstep(0.20f32,0.55f32,age))*0.85f32*red);
 return mix3(deep,v3(1,0.58f32,0.10f32),smoothstep(0.40f32,0.85f32,age)*0.55f32);
}
cg_environment_fs :: (s:FivelabS,tex:V4,front:bool,u:[]f32,shadow:f32)->V4 {
 if (s.local.x<0.5f32) {return v4(pow(tex.x,0.62f32),pow(tex.y,0.75f32),tex.z*0.965f32,1);}
 kind:=s.local.x;village:=kind>3.5f32 && kind<4.5f32 && s.local.y>=100.0f32;n:=normalize3(add3(s.normal,v3(0,0.0001f32,0)));
 foliage:=kind>0.5f32 && kind<2.5f32;grass:=kind>1.5f32 && kind<2.5f32;leaves:=kind>0.5f32 && kind<1.5f32;ground:=kind>4.5f32 && kind<5.5f32;
 if (!front && !foliage) {n=scale3(n,-1);}
 sun:=cg_sun_dir();eye:=wg_at3(u,16);view:=normalize3(sub3(eye,s.world));
 albedo:=mul3(v3(tex.x,tex.y,tex.z),cg_decode(s.tint));
 if (foliage || ground) {albedo=cg_decode(s.tint);}
 if (ground) {trail:=cg_path(s.world.x,s.world.z);// the gold is a sunlit hilltop's: steep banks keep more of their olive, and broad patches vary
  steep:=0.55f32+0.45f32*smoothstep(0.80f32,0.95f32,n.y);
  // inside the ridge cut on the walk to Everglade (past the main shot's view) the banks stay a grassy olive
  cut:=(1.0f32-cg_ramp(3.0f32,10.0f32,abs(s.world.x-cg_road_x(s.world.z))))*cg_ramp(-17.0f32,-22.0f32,s.world.z);
  steep=steep*(1.0f32-0.65f32*cut);
  albedo=mix3(albedo,cg_decode(v3(0.82f32,0.58f32,0.16f32)),cg_autumn(s.world.x,s.world.z)*0.80f32*steep*(1.0f32-trail));
  albedo=scale3(albedo,0.84f32+0.32f32*cg_noise(v2(s.world.x*0.35f32+4.0f32,s.world.z*0.35f32)));
  // The reference trail is packed olive earth, darker than sand.
  albedo=mix3(albedo,cg_decode(v3(0.50f32,0.46f32,0.24f32)),trail*0.80f32);}
 if (leaves) {
  if (s.tint.x>s.tint.y*1.2f32) {age:=cg_noise(v2(s.world.x*1.4f32+s.world.y*0.7f32,s.world.z*1.4f32));albedo=cg_decode(cg_leaf_palette(s.tint,age));}
  albedo=scale3(albedo,0.70f32+0.45f32*sqrt(saturate(verse_style_luma(tex.x,tex.y,tex.z))));
 }
 if (kind>2.5f32 && kind<3.5f32 && s.tint.y<0.99f32) {albedo=scale3(cg_decode(v3(1,0.42f32,0.32f32)),0.7f32+0.3f32*sqrt(saturate(verse_style_luma(tex.x,tex.y,tex.z))));}
 if (kind>6.5f32) {albedo=scale3(cg_decode(ifx n.y>0.15f32 then v3(1,0.60f32,0.12f32) else v3(0.86f32,0.78f32,0.60f32)),0.72f32+0.28f32*sqrt(verse_style_luma(tex.x,tex.y,tex.z)));}
 town:=ifx !village && kind>3.5f32 && kind<4.5f32 && s.world.z< -32.5f32 then cg_town_material(s.tint) else -1.0f32;
 if (town>=0) {albedo=cg_decode(cg_town_albedo(town,s.tint,s.world,n));}
 if (kind>3.5f32 && kind<4.5f32 && town<0 && !village) {
  // Neutral grey stone (the placement tint keeps its value, loses most of its olive) with moss on
  // faces that look up, as the reference's cliff tops.
  base:=cg_decode(s.tint);grey:=verse_style_luma(base.x,base.y,base.z);base=mix3(base,v3(grey,grey*1.02f32,grey*0.96f32),0.35f32);
  moss:=smoothstep(0.30f32,0.85f32,n.y+0.25f32*(cg_noise(v2(s.world.x*0.9f32+s.world.y,s.world.z*0.9f32))-0.5f32))*(0.55f32+0.45f32*cg_noise(v2(s.world.x*1.7f32,s.world.z*1.7f32)));
  base=mix3(base,scale3(cg_decode(v3(0.52f32,0.64f32,0.26f32)),fmax(grey/0.22f32,0.7f32)),moss*0.85f32);
  albedo=scale3(base,0.60f32+0.50f32*sqrt(verse_style_luma(tex.x,tex.y,tex.z)));
 }
 visibility:=shadow*cg_cloud(s.world.x,s.world.z);
 ndl:=dot3(n,sun);direct:=saturate(ndl);ao:f32=1;
 if (leaves) {direct=saturate((ndl+0.65f32)/1.65f32);ao=clampf(s.local.y,0.5f32,1.0f32);}
 if (grass) {green:=saturate((s.tint.y-s.tint.x)*4.0f32);albedo=mul3(albedo,mix3(v3(0.88f32,0.80f32,0.08f32),v3(0.60f32,0.86f32,0.10f32),green));direct=(0.22f32+0.56f32*s.local.y)*(0.85f32+0.15f32*abs(ndl));ao=0.36f32+0.64f32*s.local.y;}
 if (kind>2.5f32 && kind<3.5f32) {direct=0.35f32+0.45f32*abs(ndl);}
 fill:=ifx leaves then (ifx s.tint.x>s.tint.y*1.2f32 then 2.1f32 else 1.15f32) else ifx kind>5.5f32 && kind<6.5f32 then 1.5f32 else ifx kind>3.5f32 && kind<4.5f32 && town<0 && !village then 0.78f32 else 1.0f32;
 indirect:=mul3(albedo,scale3(cg_hemisphere(n),ao*fill));
 if (leaves && s.tint.x>s.tint.y*1.2f32) {indirect=mul3(indirect,v3(1.12f32,0.90f32,0.75f32));}
 colour:=add3(indirect,mul3(albedo,cg_irradiance(n,direct,0,visibility)));
 if (foliage) {
  // Thin leaves transmit rear sunlight; volume normals and ambient mask stay separate.
  back:=pow(saturate(dot3(scale3(sun,-1),view)),2.0f32);scatter:=(0.15f32+0.60f32*back)*(1.0f32-abs(ndl)*0.65f32)*visibility;
  colour=add3(colour,mul3(albedo,scale3(v3(1.35f32,1.16f32,0.62f32),scatter*(ifx grass then s.local.y else 1.0f32))));
 }
 if (ground) {mottle:=cg_noise(v2(s.world.x*2,s.world.z*2));meadow:=1.0f32-cg_path(s.world.x,s.world.z);grain:=cg_noise(v2(s.world.x*14,s.world.z*14));surface:=(0.90f32+0.16f32*mottle)*(1.0f32+meadow*(grain-0.5f32)*0.18f32)*mix(cg_soil(v2(s.world.x,s.world.z)),1,meadow);colour=scale3(colour,surface);indirect=scale3(indirect,surface);}
 colour=cg_atmosphere(colour,eye,s.world);share:=saturate(verse_style_luma(indirect.x,indirect.y,indirect.z)*exp(-cg_air_depth(eye,s.world))/fmax(verse_style_luma(colour.x,colour.y,colour.z),0.00001f32));return v4(colour.x,colour.y,colour.z,share);
}

#test "glade controls use one light frosted left panel that also holds the title" {
 #assert cg_ui_cover(v2(30,120),1440,900,1) && !cg_ui_cover(v2(1400,250),1440,900,1);
 #assert cg_ui_cover(v2(100,700),1440,900,1) && !cg_ui_cover(v2(720,700),1440,900,1);
 #assert cg_ui_cover(v2(40,50),1440,900,1) && !cg_ui_cover(v2(40,12),1440,900,1);
 #assert cg_panel_opacity(v2(100,250),1440,900,1)==0.58 && cg_panel_opacity(v2(720,250),1440,900,1)==0;
 #assert cg_ui_cover(v2(20,360),390,844,1) && !cg_ui_cover(v2(195,200),390,844,1) && cg_ui_cover(v2(40,50),390,844,1);
 #assert cg_panel_edge(v2(16.5,300),1440,900,1)>0.5 && cg_panel_edge(v2(180,300),1440,900,1)==0;
}
cg_ui_cover :: (p:V2,w:f32,h:f32,k:f32)->bool {
 if (w<840.0f32*k || h<760.0f32*k) {return p.y>h-504.0f32*k || ((p.y>26.0f32*k)&&(p.y<124.0f32*k)&&(p.x>12.0f32*k)&&(p.x<w-12.0f32*k));}
 return p.x>=16.0f32*k && p.x<=350.0f32*k && p.y>=20.0f32*k && p.y<=730.0f32*k;
}
cg_panel_opacity :: (p:V2,w:f32,h:f32,k:f32)->f32 {return ifx cg_ui_cover(p,w,h,k) then 0.58f32 else 0.0f32;}
// A one-pixel light rim round the desktop glass panel, so the lighter panel still reads as a shape.
cg_panel_edge :: (p:V2,w:f32,h:f32,k:f32)->f32 {
 if (w<840.0f32*k || h<760.0f32*k || !cg_ui_cover(p,w,h,k)) {return 0;}
 d:=fmin(fmin(p.x-16.0f32*k,350.0f32*k-p.x),fmin(p.y-20.0f32*k,730.0f32*k-p.y));return 1.0f32-smoothstep(0.0f32,1.25f32*k,d);
}
// Frosted glass: the scene behind the panel blurred over a 14 px disc, then tinted.
cg_glass :: (uv:V2,u:[]f32,image:Tex2D,lin:Sampler)->V3 {
 sum:V3=v3(0,0,0);r:=14.0f32*u[4];
 for i:0..<16 {a:=cast(f32)i*2.399963f32;d:=sqrt((cast(f32)i+0.5f32)/16.0f32)*r;sum=add3(sum,cg_post_sample(image,lin,v2(uv.x+cos(a)*d/u[0],uv.y+sin(a)*d/u[1])));}
 return scale3(sum,1.0f32/16.0f32);
}

#test "glade shadow projection contains the clearing and separates light depth" {
 a:=cg_shadow_clip(v3(0,0,0));b:=cg_shadow_clip(v3(0,1,0));
 #assert abs(a.x)<1 && abs(a.y)<1 && a.z>0 && a.z<1 && b.z<a.z;
}
cg_shadow_clip :: (p:V3)->V4 {
 sun:=cg_sun_dir();right:=normalize3(v3(sun.z,0,-sun.x));up:=v3(sun.y*right.z,sun.z*right.x-sun.x*right.z,-sun.y*right.x);r:=sub3(p,v3(0,5,-16));
 return v4(dot3(r,right)/26.0f32,dot3(r,up)/26.0f32,0.5f32-dot3(r,sun)/70.0f32,1);
}
// The shadow tiles (charactercreator.coax shadow_frame, #13016): u[10] 3 or 4 puts the glade's casters
// in the atlas's left half, drawn only when u[10] is 3, and the player's in the right half, every
// frame, both through cg_shadow_clip; `edge` keeps each inside its own half.
CgShadow :: struct {pos:V4;uv:V2;slice:u32;edge:V2;}
cg_shadow_tiles :: (u:[]f32)->bool {return u[10]>2.5f32;}
charactercreator_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4)->CgShadow {
 o:CgShadow;
 if (u[10]<1.5f32 || instance>=65536) {o.pos=v4(0,0,-2,1);return o;}
 s:=fivelab_scene_vs(id,instance,u,vertices,objects,bake);if (s.dye.w>11.5f32 && s.local.x<0.5f32) {o.pos=v4(0,0,-2,1);return o;}
 c:=cg_shadow_clip(s.world);o.pos=c;o.edge=v2(c.x,c.y);o.uv=ifx s.local.x>3.5f32 && s.local.x<4.5f32 && s.local.y>=100.0f32 then cg_village_uv(s.uv,s.local.y) else s.uv;o.slice=s.slice;
 if cg_shadow_tiles(u) {
  glade:=s.dye.w>11.5f32;
  if (glade && u[10]>3.5f32) {o.pos=v4(0,0,-2,1);return o;}
  o.pos=v4(c.x*0.5f32+(ifx glade then -0.5f32 else 0.5f32),c.y,c.z,1);
 }
 return o;
}
charactercreator_shadow_fs :: (s:CgShadow,sheets:Tex2DArray,sheet:Sampler) {
 if (abs(s.edge.x)>1.0f32 || abs(s.edge.y)>1.0f32) {gpu_demote_helper();}
 t:=render_sample_layer8_bias(sheets,sheet,s.uv,cast(s32)s.slice,0);
 if (t.w<0.35f32) {gpu_demote_helper();}
}
// The map's taps at uv: x scaled by `half` (1 the one map, 0.5 a tile) and offset by `at`.
cg_shadow_taps :: (uv:V2,z:f32,half:f32,at:f32,map:TexDepth,cmp:SamplerCompare)->f32 {
 texel:=1.0f32/(cast(f32)wg_dims_depth(map).x*half);sum:f32=0;
 for i:0..<12 {a:=cast(f32)i*2.399963f32;r:=sqrt((cast(f32)i+0.5f32)/12.0f32)*4.0f32*texel;
  sum=sum+gpu_compare(map,cmp,v2(at+clampf(uv.x+cos(a)*r,0.0f32,1.0f32)*half,uv.y+sin(a)*r),z-0.0012f32);
 }
 return sum/12.0f32;
}
cg_shadow_visibility :: (p:V3,n:V3,u:[]f32,map:TexDepth,cmp:SamplerCompare)->f32 {
 c:=cg_shadow_clip(add3(p,scale3(normalize3(n),0.025f32)));uv:=v2(c.x*0.5f32+0.5f32,0.5f32-c.y*0.5f32);
 if (uv.x<0 || uv.x>1 || uv.y<0 || uv.y>1 || c.z<0 || c.z>1) {return 1;}
 if !cg_shadow_tiles(u) {return cg_shadow_taps(uv,c.z,1.0f32,0.0f32,map,cmp);}
 return fmin(cg_shadow_taps(uv,c.z,0.5f32,0.0f32,map,cmp),cg_shadow_taps(uv,c.z,0.5f32,0.5f32,map,cmp));
}

cg_rgb :: (c:V4)->V3 {return v3(c.x,c.y,c.z);}
charactercreator_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {
  texel:V2=v2(1.0f32/cast(f32)(wg_dims_2d(bloom_src).x),1.0f32/cast(f32)(wg_dims_2d(bloom_src).y));
  uv:V2=v2(pos.x*bloom_step[3]*texel.x,pos.y*bloom_step[3]*texel.y);
  if (bloom_step[2]<0.5f32) {
    c:V3=v3(0.0f32,0.0f32,0.0f32);
    {
      k:s32=0;
      while k<4 {
        o:V2=v2(((cast(f32)(k&1)*2.0f32)-1.0f32)*texel.x,((cast(f32)(k>>1)*2.0f32)-1.0f32)*texel.y);
        t:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+o.x,uv.y+o.y),0.0f32);
        c=add3(c,scale3(v3(t.x,t.y,t.z),verse_style_bloom_share(fmax(t.x,fmax(t.y,t.z)),0.62f32,0.30f32)*t.w));
        k+=1;
      }
    }
    return v4(c.x*0.25f32,c.y*0.25f32,c.z*0.25f32,1.0f32);
  }
  d:V2=v2(bloom_step[0]*texel.x,bloom_step[1]*texel.y);
  c:V3=scale3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,uv,0.0f32)),0.227f32);
  c=add3(c,scale3(add3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+(d.x*1.385f32),uv.y+(d.y*1.385f32)),0.0f32)),cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-(d.x*1.385f32),uv.y-(d.y*1.385f32)),0.0f32))),0.316f32));
  c=add3(c,scale3(add3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+(d.x*3.231f32),uv.y+(d.y*3.231f32)),0.0f32)),cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-(d.x*3.231f32),uv.y-(d.y*3.231f32)),0.0f32))),0.070f32));
  return v4(c.x,c.y,c.z,1.0f32);
}

cg_post_sample :: (image:Tex2D,lin:Sampler,uv:V2)->V3 {return cg_rgb(gpu_sample_level(image,lin,uv,0));}
cg_luma :: (c:V3)->f32 {return verse_style_luma(c.x,c.y,c.z);}
cg_fxaa :: (uv:V2,step:V2,image:Tex2D,lin:Sampler)->V3 {
 center:=cg_post_sample(image,lin,uv);
 nw:=cg_luma(cg_post_sample(image,lin,v2(uv.x-step.x,uv.y-step.y)));ne:=cg_luma(cg_post_sample(image,lin,v2(uv.x+step.x,uv.y-step.y)));
 sw:=cg_luma(cg_post_sample(image,lin,v2(uv.x-step.x,uv.y+step.y)));se:=cg_luma(cg_post_sample(image,lin,v2(uv.x+step.x,uv.y+step.y)));mid:=cg_luma(center);
 low:=fmin(mid,fmin(fmin(nw,ne),fmin(sw,se)));high:=fmax(mid,fmax(fmax(nw,ne),fmax(sw,se)));
 if (high-low<fmax(0.0312f32,high*0.125f32)) {return center;}
 dir:=v2(-(nw+ne-sw-se),nw+sw-ne-se);reduce:=fmax((nw+ne+sw+se)*0.03125f32,0.0078125f32);rcp:=1.0f32/(fmin(abs(dir.x),abs(dir.y))+reduce);
 dir=v2(clampf(dir.x*rcp,-8.0f32,8.0f32)*step.x,clampf(dir.y*rcp,-8.0f32,8.0f32)*step.y);
 a:=scale3(add3(cg_post_sample(image,lin,v2(uv.x-dir.x/6.0f32,uv.y-dir.y/6.0f32)),cg_post_sample(image,lin,v2(uv.x+dir.x/6.0f32,uv.y+dir.y/6.0f32))),0.5f32);
 b:=add3(scale3(a,0.5f32),scale3(add3(cg_post_sample(image,lin,v2(uv.x-dir.x*0.5f32,uv.y-dir.y*0.5f32)),cg_post_sample(image,lin,v2(uv.x+dir.x*0.5f32,uv.y+dir.y*0.5f32))),0.25f32));
 lum:=cg_luma(b);return ifx lum<low || lum>high then a else b;
}
cg_viewpoint :: (pixel:V2,z:f32,u:[]f32)->V3 {
 return add3(wg_at3(u,16),scale3(add3(wg_at3(u,20),add3(scale3(wg_at3(u,24),(pixel.x-u[23])/u[19]),scale3(wg_at3(u,28),(u[27]-pixel.y)/u[19]))),z));
}
cg_post_pixel :: (p:V2,size:U2)->I2 {return i2(wg_clamp_i(cast(s32)p.x,0,cast(s32)size.x-1),wg_clamp_i(cast(s32)p.y,0,cast(s32)size.y-1));}
cg_contact_ao :: (pixel:V2,u:[]f32,aux:Tex2D)->f32 {
 size:=wg_dims_2d(aux);a:=wg_load_2d(aux,cg_post_pixel(pixel,size),0);if (a.w<=0) {return 1;}
 n:=cg_normal_unpack(v2(a.x,a.y));center:=cg_viewpoint(pixel,a.w,u);sum:f32=0;radius:=clampf(u[1]*0.012f32,4.0f32,18.0f32);
 for i:0..<8 {angle:=cast(f32)i*0.785398f32;r:=radius*(ifx i%2==0 then 0.5f32 else 1.0f32);at:=v2(pixel.x+cos(angle)*r,pixel.y+sin(angle)*r);b:=wg_load_2d(aux,cg_post_pixel(at,size),0);
  if (abs(b.w)>0.001f32) {delta:=sub3(cg_viewpoint(at,abs(b.w),u),center);distance:=wg_length3(delta);sum=sum+saturate((dot3(n,delta)-0.015f32)/fmax(distance,0.0001f32))*(1.0f32-smoothstep(0.1f32,0.6f32,distance));}
 }
 return 1.0f32-sum*0.65f32/8.0f32;
}
// The reference's sunlit upper air: a soft warm veil over the far scene toward the top of the frame,
// strongest on the sun's side (it stands behind the glade, up and to the right of centre), none on
// the near ground. Linear light, added before the film curve.
cg_sun_veil :: (uv:V2)->V3 {
 side:=uv.x-0.62f32;k:=smoothstep(0.78f32,0.08f32,uv.y)*(0.2f32+0.8f32*exp(-side*side/0.08f32));
 return scale3(v3(1.0f32,0.82f32,0.52f32),0.075f32*k);
}
#test "glade sun veil warms the far scene on the sun's side and leaves the near ground" {
 a:=cg_sun_veil(v2(0.62f32,0.2f32));b:=cg_sun_veil(v2(0.05f32,0.2f32));c:=cg_sun_veil(v2(0.62f32,0.9f32));
 #assert a.x>b.x && b.x>0 && c.x==0 && a.z<a.x;
}
#test "the animation browser darkens only its local left column" {
 #assert cg_dev_panel(v2(20,30),720,1,false) && cg_dev_panel(v2(360,690),720,1,false);
 #assert !cg_dev_panel(v2(371,30),720,1,false) && !cg_dev_panel(v2(20,10),720,1,false);
 #assert cg_dev_panel(v2(20,30),720,1,true) && !cg_dev_panel(v2(20,70),720,1,true);
}
cg_dev_panel :: (p:V2,h:f32,k:f32,collapsed:bool)->bool {return p.x>=12*k && p.x<=370*k && p.y>=20*k && p.y<=ifx collapsed then 52*k else h-20*k;}
charactercreator_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
 pixel:=v2(pos.x,pos.y);uv:=v2(pos.x/u[0],pos.y/u[1]);raw:=gpu_sample_level(post_light,post_lin,uv,0);
 if (u[10]<1.5f32) {encoded:=cg_encode(v3(raw.x,raw.y,raw.z));return v4(encoded.x,encoded.y,encoded.z,1);}
 a:=wg_load_2d(post_aux,cg_post_pixel(pixel,wg_dims_2d(post_aux)),0);
 c:=cg_fxaa(uv,v2(1.0f32/u[0],1.0f32/u[1]),post_light,post_lin);c=scale3(c,1.0f32-(1.0f32-cg_contact_ao(pixel,u,post_aux))*saturate(a.z));
 glow:=add3(scale3(cg_post_sample(post_quarter,post_lin,uv),0.20f32),scale3(cg_post_sample(post_eighth,post_lin,uv),0.20f32));
 // A small foliage-only reconstruction filter integrates subpixel leaves and blades.
 // Depth/normal class keeps the character, painted petals and hard rocks sharp.
 if (a.w<0) {
  soft:V3=v3(0,0,0);
  for i:0..<4 {angle:=cast(f32)i*1.5707963f32;at:=v2(uv.x+cos(angle)*2.0f32/u[0],uv.y+sin(angle)*2.0f32/u[1]);soft=add3(soft,cg_post_sample(post_light,post_lin,at));}
  c=mix3(c,scale3(soft,0.25f32),0.55f32);
 }
 c=add3(c,glow);result:=ifx abs(a.w)<0.001f32 then cg_encode(c) else cg_output(add3(c,cg_sun_veil(uv)));if (u[11]<0.5f32) {glass:=cg_panel_opacity(pixel,u[0],u[1],u[4]);fade:=1.0f32-u[40];if (glass*fade>0) {panel:=mix3(cg_output(cg_glass(uv,u,post_light,post_lin)),v3(0.09f32,0.12f32,0.11f32),glass);result=mix3(result,panel,fade);result=mix3(result,v3(0.93f32,0.86f32,0.66f32),cg_panel_edge(pixel,u[0],u[1],u[4])*0.55f32*fade);}}if (u[11]>1.5f32 && cg_dev_panel(pixel,u[1],u[4],u[11]>2.5f32)) {result=mix3(result,v3(0.025f32,0.04f32,0.035f32),0.83f32);}result=cg_walk_veil(result,u);return v4(result.x,result.y,result.z,1);
}
#test "glade contact reconstruction preserves camera-forward depth" {
 u:[104]f32;u[16]=2;u[17]=1;u[18]=3;u[22]= -1;u[24]=1;u[29]=1;u[19]=100;u[23]=50;u[27]=40;
 p:=cg_viewpoint(v2(50,40),4,u[..]);#assert p.x==2 && p.y==1 && p.z== -1;
}

#test "glade sky extends continuously across both reference plate edges" {
 for i:0..<2 {edge:=cast(f32)i;#assert cg_sky_plate_weight(v2(0.5,edge))==0;}
 #assert cg_sky_plate_weight(v2(0.5,0.5))==1 && cg_sky_plate_weight(v2(0.5,-0.1))==0;
 uv:=cg_sky_uv(cg_sky_ray(-1,1));#assert abs(uv.x)<0.0001 && abs(uv.y)<0.0001;
 uv=cg_sky_uv(cg_sky_ray(1,-1));#assert abs(uv.x-1)<0.0001 && abs(uv.y-1)<0.0001;
}
cg_sky_plate_weight :: (uv:V2)->f32 {return smoothstep(0.0f32,0.16f32,uv.x)*smoothstep(0.0f32,0.16f32,1.0f32-uv.x)*smoothstep(0.0f32,0.16f32,uv.y)*smoothstep(0.0f32,0.16f32,1.0f32-uv.y);}
cg_sky_uv :: (ray:V3)->V2 {
 fy:=0.4f32/sqrt(9.77f32);fz:=-3.1f32/sqrt(9.77f32);depth:=fmax(ray.y*fy+ray.z*fz,0.001f32);
 return v2(0.5f32+ray.x/depth*(1080.0f32*1.78f32)/(2.0f32*1920.0f32),0.48f32-0.89f32*(ray.y*(-fz)+ray.z*fy)/depth);
}

// The walk into Everglade (charactercreator-walk.coax): u[40] fades the control panel's glass with
// the controls, u[41] fades the finished frame to black before the page changes.
#test "glade walk veil keeps the frame at rest and reaches black" {
 u:[104]f32;c:=v3(0.5f32,0.25f32,1.0f32);a:=cg_walk_veil(c,u[..]);#assert a.x==c.x && a.y==c.y && a.z==c.z;
 u[41]=1;b:=cg_walk_veil(c,u[..]);#assert b.x==0 && b.y==0 && b.z==0;
}
cg_walk_veil :: (c:V3,u:[]f32)->V3 {return scale3(c,1.0f32-saturate(u[41]));}
