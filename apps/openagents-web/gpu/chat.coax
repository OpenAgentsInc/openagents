// chat's shaders, the source of apps/openagents-web/chat.wgsl (docs/verse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (chat.module,
// chat.bindings beside it). It began as coax/web/wgsl-coax.coax's translation of the hand-written WGSL.
#load "../../../verse/gpu/wgsl.coax";

// /chat's passes: GPUI's quad, shadow and sprite shaders, the WebGPU port of
// apps/openagents-desktop/Zeron.metal (itself zeronsh/zui's
// gpui_macos/src/shaders.metal, Apache-2.0, the renderer Zeron draws with),
// so the page draws the shared Zeron components (apps/shared/zeron/,
// gpui.coax writes the vertices) exactly as the Mac app does. Based on Zeron
// by Wing, MIT. Colors are straight sRGB with alpha, blended source-over into
// a non-sRGB target, as GPUI does; the host (coax/web/gpui.js) gives this the
// glyph and icon atlas (gpui_atlas, r8) and the color-glyph atlas
// (gpui_color, rgba8, straight alpha).
//
// Hand-written WGSL, as Zeron.metal is hand-written Metal: GPUI's fragment
// shaders are not Coax, so coax wgsl (which writes Coax scalar functions
// as WGSL) has nothing to write. Keep the two files in step.
//
// A vertex is 28 floats (gpui.coax GP_VERTEX_FLOATS):
//   a: device x, y, kind (0 quad, 1 shadow, 2 sprite, 3 color sprite, 4 elbow, 5 gradient, 6 inset), blur
//   b: the primitive's bounds in device pixels: x, y, w, h
//   c: corner radius, border width, u, v
//   d: fill (a sprite's color)
//   e: border color
//   f: the content mask, device x0, y0, x1, y1
//   g: GPUI's EdgeFade, device top y, top band, bottom y, bottom band
// ChatU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   pad0 2
//   pad1 3
// The canvas: Zeron Dark's shell (the frame paints it too).
chat_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
chat_bg_fs :: (pos:V4)->V4 {
  return v4(13.0f32/255.0f32,13.0f32/255.0f32,13.0f32/255.0f32,1.0f32);
}
ChatZIn :: struct {a:V4; b:V4; c:V4; d:V4; e:V4; f:V4; g:V4; }
ChatZV :: struct {pos:V4; kind_blur:V2 #flat; bounds:V4 #flat; shape:V2 #flat; uv:V2; fill:V4 #flat; border:V4 #flat; clip:V4 #flat; fade:V4 #flat; }
chat_fx_vs :: (_vid2:u32,_iid3:u32,v:ChatZIn,u:[]f32)->ChatZV {
  o:ChatZV;
  o.pos=v4(((v.a.x/u[0])*2.0f32)-1.0f32,1.0f32-((v.a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.kind_blur=v2(v.a.z,v.a.w);
  o.bounds=v.b;
  o.shape=v2(v.c.x,v.c.y);
  o.uv=v2(v.c.z,v.c.w);
  o.fill=v.d;
  o.border=v.e;
  o.clip=v.f;
  o.fade=v.g;
  return o;
}
chat_quad_sdf_impl :: (corner_center_to_point:V2,corner_radius:f32)->f32 {
  if (corner_radius==0.0f32) {
    return fmax(corner_center_to_point.x,corner_center_to_point.y);
  }
  signed_distance_to_inset_quad:f32=wg_length2(wg_max_f2f2(v2(0.0f32,0.0f32),corner_center_to_point))+fmin(0.0f32,fmax(corner_center_to_point.x,corner_center_to_point.y));
  return signed_distance_to_inset_quad-corner_radius;
}
chat_over :: (below:V4,above:V4)->V4 {
  alpha:f32=above.w+(below.w*(1.0f32-above.w));
  return wg_make_f4_f3f(wg_div_f3f(wg_add_f3f3(wg_mul_f3f(v3(above.x,above.y,above.z),above.w),wg_mul_f3f(wg_mul_f3f(v3(below.x,below.y,below.z),below.w),(1.0f32-above.w))),alpha),alpha);
}
chat_gaussian :: (x:f32,sigma:f32)->f32 {
  return exp((-(x*x))/((2.0f32*sigma)*sigma))/(sqrt(2.0f32*3.14159265f32)*sigma);
}
chat_erf2 :: (x:V2)->V2 {
  s:V2=wg_sign_f2(x);
  a:V2=wg_abs_f2(x);
  r1:V2=wg_add_ff2(1.0f32,wg_mul_f2f2(wg_add_ff2(0.278393f32,wg_mul_f2f2(wg_add_ff2(0.230389f32,wg_mul_f2f2(wg_add_ff2(0.000972f32,wg_mul_ff2(0.078108f32,a)),a)),a)),a));
  r2:V2=wg_mul_f2f2(r1,r1);
  return wg_sub_f2f2(s,wg_div_f2f2(s,wg_mul_f2f2(r2,r2)));
}
chat_blur_along_x :: (x:f32,y:f32,sigma:f32,corner:f32,half_size:V2)->f32 {
  delta:f32=fmin((half_size.y-corner)-abs(y),0.0f32);
  curved:f32=(half_size.x-corner)+sqrt(fmax(0.0f32,(corner*corner)-(delta*delta)));
  integral:V2=wg_add_ff2(0.5f32,wg_mul_ff2(0.5f32,chat_erf2(wg_mul_f2f(wg_add_ff2(x,v2(-curved,curved)),(sqrt(0.5f32)/sigma)))));
  return integral.y-integral.x;
}
// GPUI quad_fragment: one radius and one border width on every side, solid fills.
chat_quad_color :: (p:V2,bounds:V4,corner_radius:f32,bw:f32,background_color:V4,border_color:V4)->V4 {
  if ((bw==0.0f32)&&(corner_radius==0.0f32)) {
    return background_color;
  }
  antialias_threshold:f32=0.5f32;
  half_size:V2=wg_div_f2f(v2(bounds.z,bounds.w),2.0f32);
  center_to_point:V2=wg_sub_f2f2(wg_sub_f2f2(p,v2(bounds.x,bounds.y)),half_size);
  reduced_border:f32=ifx bw==0.0f32 then -antialias_threshold else bw;
  corner_to_point:V2=wg_sub_f2f2(wg_abs_f2(center_to_point),half_size);
  corner_center_to_point:V2=wg_add_f2f(corner_to_point,corner_radius);
  is_near_rounded_corner:bool=(corner_center_to_point.x>=0.0f32)&&(corner_center_to_point.y>=0.0f32);
  straight_border_inner_corner_to_point:V2=wg_add_f2f(corner_to_point,reduced_border);
  is_beyond_inner_straight_border:bool=(straight_border_inner_corner_to_point.x>0.0f32)||(straight_border_inner_corner_to_point.y>0.0f32);
  is_within_inner_straight_border:bool=(straight_border_inner_corner_to_point.x<(-antialias_threshold))&&(straight_border_inner_corner_to_point.y<(-antialias_threshold));
  if (is_within_inner_straight_border&&(!is_near_rounded_corner)) {
    return background_color;
  }
  outer_sdf:f32=chat_quad_sdf_impl(corner_center_to_point,corner_radius);
  inner_sdf:f32=0.0f32;
  if ((corner_center_to_point.x<=0.0f32)||(corner_center_to_point.y<=0.0f32)) {
    inner_sdf=-fmax(straight_border_inner_corner_to_point.x,straight_border_inner_corner_to_point.y);
  } else if is_beyond_inner_straight_border {
    inner_sdf=-1.0f32;
  } else {
    inner_sdf=-(outer_sdf+reduced_border);
  }
  border_sdf:f32=fmax(inner_sdf,outer_sdf);
  color:V4=background_color;
  if (border_sdf<antialias_threshold) {
    blended_border:V4=chat_over(background_color,border_color);
    color=wg_mix_f4f4f(background_color,blended_border,saturate(antialias_threshold-inner_sdf));
  }
  return wg_mul_f4f4(color,v4(1.0f32,1.0f32,1.0f32,saturate(antialias_threshold-outer_sdf)));
}
// GPUI shadow_fragment for a drop shadow.
chat_shadow_color :: (p:V2,bounds:V4,corner_radius:f32,blur:f32,color:V4)->V4 {
  half_size:V2=wg_div_f2f(v2(bounds.z,bounds.w),2.0f32);
  pt:V2=wg_sub_f2f2(p,wg_add_f2f2(v2(bounds.x,bounds.y),half_size));
  alpha:f32=0.0f32;
  if (blur==0.0f32) {
    corner_center_to_point:V2=wg_add_f2f(wg_sub_f2f2(wg_abs_f2(pt),half_size),corner_radius);
    alpha=saturate(0.5f32-chat_quad_sdf_impl(corner_center_to_point,corner_radius));
  } else {
    low:f32=pt.y-half_size.y;
    high:f32=pt.y+half_size.y;
    start:f32=clampf((-3.0f32)*blur,low,high);
    end:f32=clampf(3.0f32*blur,low,high);
    step:f32=(end-start)/4.0f32;
    y:f32=start+(step*0.5f32);
    {
      i:s32=0;
      while i<4 {
        alpha=alpha+((chat_blur_along_x(pt.x,pt.y-y,blur,corner_radius,half_size)*chat_gaussian(y,blur))*step);
        y=y+step;
        i+=1;
      }
    }
  }
  return wg_mul_f4f4(color,v4(1.0f32,1.0f32,1.0f32,alpha));
}
// A vertical linear gradient (GPUI linear_gradient, 180 degrees, sRGB stops), no border.
chat_gradient_color :: (p:V2,bounds:V4,corner_radius:f32,top:V4,bottom:V4)->V4 {
  t:f32=saturate((p.y-bounds.y)/fmax(bounds.w,1.0f32));
  return chat_quad_color(p,bounds,corner_radius,0.0f32,wg_mix_f4f4f(top,bottom,t),v4(0.0f32,0.0f32,0.0f32,0.0f32));
}
// An unblurred inset shadow dy down (GPUI paint_inset_shadows).
chat_inset_color :: (p:V2,bounds:V4,corner_radius:f32,dy:f32,color:V4)->V4 {
  half_size:V2=wg_div_f2f(v2(bounds.z,bounds.w),2.0f32);
  a:V2=wg_add_f2f(wg_sub_f2f2(wg_abs_f2(wg_sub_f2f2(wg_sub_f2f2(p,v2(bounds.x,bounds.y)),half_size)),half_size),corner_radius);
  b:V2=wg_add_f2f(wg_sub_f2f2(wg_abs_f2(wg_sub_f2f2(wg_sub_f2f2(wg_sub_f2f2(p,v2(0.0f32,dy)),v2(bounds.x,bounds.y)),half_size)),half_size),corner_radius);
  inside:f32=saturate(0.5f32-chat_quad_sdf_impl(a,corner_radius));
  covered:f32=saturate(0.5f32-chat_quad_sdf_impl(b,corner_radius));
  return wg_mul_f4f4(color,v4(1.0f32,1.0f32,1.0f32,inside*(1.0f32-covered)));
}
// zui shaders.metal edge_fade_alpha, the top and bottom edges.
chat_edge_fade_alpha :: (p:V2,fade:V4)->f32 {
  ramp:f32=1.0f32;
  if (fade.y>0.0f32) {
    ramp=fmin(ramp,clampf((p.y-fade.x)/fade.y,0.0f32,1.0f32));
  }
  if (fade.w>0.0f32) {
    ramp=fmin(ramp,clampf((fade.z-p.y)/fade.w,0.0f32,1.0f32));
  }
  return ramp*ramp;
}
chat_segment_distance :: (p:V2,a:V2,b:V2)->f32 {
  pa:V2=wg_sub_f2f2(p,a);
  ba:V2=wg_sub_f2f2(b,a);
  h:f32=clampf(wg_dot2(pa,ba)/fmax(wg_dot2(ba,ba),1e-6f32),0.0f32,1.0f32);
  return wg_length2(wg_sub_f2f2(pa,wg_mul_f2f(ba,h)));
}
// The activity rail's elbow (transcript.rs activity_branch_points).
chat_elbow_color :: (p:V2,b:V4,c:V2,color:V4)->V4 {
  s:V2=v2(b.x,b.y);
  r:f32=b.z;
  end_x:f32=b.w;
  half_w:f32=0.5f32*c.x;
  dist:f32=1e9f32;
  prev:V2=s;
  {
    k:s32=1;
    while k<=24 {
      t:f32=(cast(f32)(k))/24.0f32;
      q:V2=wg_add_f2f2(s,wg_mul_ff2(r,v2(t*t,(2.0f32*t)-(t*t))));
      dist=fmin(dist,chat_segment_distance(p,prev,q));
      prev=q;
      k+=1;
    }
  }
  dist=fmin(dist,chat_segment_distance(p,prev,v2(end_x,s.y+r)));
  cover:f32=saturate((half_w+0.5f32)-dist);
  if (c.y>0.5f32) {
    cover=fmax(0.0f32,cover-saturate((half_w+0.5f32)-abs(p.x-s.x)));
  }
  return wg_mul_f4f4(color,v4(1.0f32,1.0f32,1.0f32,cover));
}
chat_fx_fs :: (v:ChatZV,gpui_atlas:Tex2D,gpui_color:Tex2D)->V4 {
  p:V2=v2(v.pos.x,v.pos.y);
  if ((((p.x<v.clip.x)||(p.y<v.clip.y))||(p.x>=v.clip.z))||(p.y>=v.clip.w)) {
    gpu_discard();
  }
  // read texel for pixel, as GPUI's sprites land on whole device pixels (no filtering to blur them)
  mono:f32=wg_load_2d(gpui_atlas,wg_cvt_i2f2(wg_floor_f2(wg_mul_f2f2(v.uv,wg_cvt_f2u2(wg_dims_2d(gpui_atlas))))),0).x;
  poly:V4=wg_load_2d(gpui_color,wg_cvt_i2f2(wg_floor_f2(wg_mul_f2f2(v.uv,wg_cvt_f2u2(wg_dims_2d(gpui_color))))),0);
  kind:f32=v.kind_blur.x;
  c:V4;
  if (kind>5.5f32) {
    c=chat_inset_color(p,v.bounds,v.shape.x,v.kind_blur.y,v.fill);
  } else if (kind>4.5f32) {
    c=chat_gradient_color(p,v.bounds,v.shape.x,v.fill,v.border);
  } else if (kind>3.5f32) {
    c=chat_elbow_color(p,v.bounds,v.shape,v.fill);
  } else if (kind>2.5f32) {
    c=wg_make_f4_f3f(v3(poly.x,poly.y,poly.z),poly.w*v.fill.w);
  } else if (kind>1.5f32) {
    c=wg_make_f4_f3f(v3(v.fill.x,v.fill.y,v.fill.z),v.fill.w*mono);
  } else if (kind>0.5f32) {
    c=chat_shadow_color(p,v.bounds,v.shape.x,v.kind_blur.y,v.fill);
  } else {
    c=chat_quad_color(p,v.bounds,v.shape.x,v.shape.y,v.fill,v.border);
  }
  c.w=c.w*chat_edge_fade_alpha(p,v.fade);
  return c;
}

// ---- generated by wgsl-coax: the vector helpers this file calls
wg_max_f2f2 :: (p0:V2,p1:V2)->V2 {return v2(fmax(p0.x,p1.x),fmax(p0.y,p1.y));}
wg_mul_f3f :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
wg_add_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
wg_div_f3f :: (a:V3,b:f32)->V3 {return v3(a.x/b,a.y/b,a.z/b);}
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
wg_sign_f2 :: (p0:V2)->V2 {return v2(wg_sign(p0.x),wg_sign(p0.y));}
wg_abs_f2 :: (p0:V2)->V2 {return v2(abs(p0.x),abs(p0.y));}
wg_mul_ff2 :: (a:f32,b:V2)->V2 {return v2(a*b.x,a*b.y);}
wg_add_ff2 :: (a:f32,b:V2)->V2 {return v2(a+b.x,a+b.y);}
wg_mul_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x*b.x,a.y*b.y);}
wg_div_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x/b.x,a.y/b.y);}
wg_sub_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x-b.x,a.y-b.y);}
wg_mul_f2f :: (a:V2,b:f32)->V2 {return v2(a.x*b,a.y*b);}
wg_div_f2f :: (a:V2,b:f32)->V2 {return v2(a.x/b,a.y/b);}
wg_add_f2f :: (a:V2,b:f32)->V2 {return v2(a.x+b,a.y+b);}
wg_mix_f4f4f :: (p0:V4,p1:V4,p2:f32)->V4 {return v4(mix(p0.x,p1.x,p2),mix(p0.y,p1.y,p2),mix(p0.z,p1.z,p2),mix(p0.w,p1.w,p2));}
wg_mul_f4f4 :: (a:V4,b:V4)->V4 {return v4(a.x*b.x,a.y*b.y,a.z*b.z,a.w*b.w);}
wg_add_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x+b.x,a.y+b.y);}
wg_cvt_f2u2 :: (p:U2)->V2 {return v2(cast(f32)(p.x),cast(f32)(p.y));}
wg_floor_f2 :: (p0:V2)->V2 {return v2(floor(p0.x),floor(p0.y));}
wg_cvt_i2f2 :: (p:V2)->I2 {return i2(wg_i32_f(p.x),wg_i32_f(p.y));}
