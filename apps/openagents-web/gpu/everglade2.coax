// Everglade v2's passes (docs/verse/everglade2.md): Character Create's glade light and materials on
// Everglade v2's land (verse/everglade2/forest.coax), the woods' kit pieces drawn instanced from the
// page's visible-piece store (everglade/client/client.coax), and a key-light shadow map that
// follows the player.
#load "fivelab.coax";
#load "../../../verse/everglade2/field.coax";
#load "portal.coax";   // Everglade's portal's light: Character Create's arrival from the homepage
#load "../../../aethyr/render/terrain-shade.coax";   // the ground's material table and baked AO (#13052)
#load "../../../aethyr/render/character-material.coax";   // the characters' material record's shading (#13012)
Everglade2Bg :: struct {c:V4;aux:V4;depth:f32 #depth;}
Everglade2Lit :: struct {c:V4;aux:V4;}
E2_KIT_BASE :: 1048576;   // a base instance at or past this draws kit pieces: inst[2 (instance - base)]
everglade2_bg_vs :: (id:u32,instance:u32)->V4 {return fivelab_bg_vs(id,instance);}
everglade2_bg_fs :: (pos:V4,u:[]f32,frame:[]f32)->Everglade2Bg {
 rd:=normalize3(add3(wg_at3(u,20),add3(scale3(wg_at3(u,24),(pos.x-u[23])/u[19]),scale3(wg_at3(u,28),(u[27]-pos.y)/u[19]))));
 sky:=cg_decode(cg_sky(u,rd,wg_at3(u,32),u[2]));return Everglade2Bg.{c=v4(sky.x,sky.y,sky.z,0),depth=1};
}
#test "kit pieces keep their shape, turn and scale, and unpack their tint" {
 p:=cg_instance_point(v3(1,2,0),v3(4,0,-5),2,1,0);#assert p.x==5 && p.y==4 && p.z== -5;
 t:=e2_unpack_tint(v4(0,0,255.0f32*256.0f32+128.0f32,0.5f32));#assert t.x==1 && abs(t.y-128.0f32/255.0f32)<0.001 && t.z==0.5f32;
 g:=e2_unpack_tint(v4(0,0,0,2.25f32));#assert g.z==0.25f32;
}
// A piece's tint: red and green bytes in z (red * 256 + green), blue in w (plus 2 for grass, plus 4
// times its fade code: e2_inst_fade).
e2_unpack_tint :: (c:V4)->V3 {
 hi:=floor(c.z/256.0f32);b:=c.w-4.0f32*floor(c.w/4.0f32);
 return v3(hi/255.0f32,(c.z-hi*256.0f32)/255.0f32,ifx b>1.5f32 then b-2.0f32 else b);
}
// A piece's fade (the page's e2_fade_code in w's fours): 0 whole; above 0 the share of its pixels
// the dither drops; below 0 a cross-fade's other half, keeping only that share (e2_dither_keep).
e2_inst_fade :: (c:V4)->f32 {k:=floor(c.w/4.0f32);return ifx k>64.5f32 then (64.0f32-k)/64.0f32 else k/64.0f32;}
// Whether a pixel of a fading piece stays: a fixed screen pattern (interleaved gradient noise)
// against the piece's fade, so two levels of detail at the same place cover each pixel once.
e2_dither_keep :: (pixel:V2,fade:f32)->bool {
 n:=fract(52.9829189f32*fract(0.06711056f32*floor(pixel.x)+0.00583715f32*floor(pixel.y)));
 return ifx fade>0.0f32 then n>=fade else ifx fade<0.0f32 then n< -fade else true;
}
// One vertex of a kit piece: the pack's template at the origin (u[48] its first vertex word), placed
// by its instance (x y z yaw, vertical and horizontal scale, tint).
e2_kit_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,inst:[]V4)->FivelabS {
 k:=cast(int)(instance-cast(u32)E2_KIT_BASE);return e2_kit_place(id,inst[k*2],inst[k*2+1],u,vertices);
}
// One vertex of a kit piece placed at a (x y z yaw) with c (vertical and horizontal scale, tint).
e2_kit_place :: (id:u32,a:V4,c:V4,u:[]f32,vertices:[]u32)->FivelabS {
 b:u32=add_wrap(wg_u32_f(u[48]),mul_wrap(id,8));
 source:V3=v3(f32_from_bits(vertices[cast(int)b]),f32_from_bits(vertices[cast(int)add_wrap(b,1)]),f32_from_bits(vertices[cast(int)add_wrap(b,2)]));
 normal:u32=vertices[cast(int)add_wrap(b,3)];kind:u32=(normal>>24)&7;
 p:=cg_instance_point(source,v3(a.x,a.y,a.z),c.x,c.y,a.w);
 if ((kind==1)||(kind==2)||(kind==3)) {sway:=sin(a.x*0.37f32+a.z*0.21f32+u[2]*1.1f32)+sin(a.z*0.53f32+u[2]*0.7f32)*0.35f32;p.x=p.x+sway*0.05f32*saturate(source.y*0.18f32)*c.x;}
 nw:V4=wg_unpack4x8snorm(normal);cs:=cos(a.w);sn:=sin(a.w);
 n:=normalize3(v3((nw.x*cs+nw.z*sn)/c.y,nw.y/c.x,(-nw.x*sn+nw.z*cs)/c.y));
 uv:V2=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]);if (kind==6) {uv=v2(uv.x*64.0f32-32.0f32,uv.y*64.0f32-32.0f32);}
 vt:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(b,5)]);t:=ifx (kind==1)||(kind==4) then e2_unpack_tint(c) else v3(1,1,1);
 o:FivelabS;o.pos=fivelab_project(p,u);o.world=p;o.normal=n;o.uv=uv;o.slice=vertices[cast(int)add_wrap(b,6)];
 o.tint=ifx kind==1 then t else mul3(v3(vt.x,vt.y,vt.z),t);o.dye=v4(e2_inst_fade(c),0,0,12);o.local=v3(cast(f32)kind,f32_from_bits(vertices[cast(int)add_wrap(b,7)]),0);o.who=0;
 if (kind==2) {
  // a grass tuft is shaded as the glade's grass (cg_instanced_vs): its height up the blade, its
  // root colour the piece's tint, its tips lighter, gold where the land is autumn
  height:=saturate(source.y);autumn:=e2_gold(a.x,a.z);base:=e2_unpack_tint(c);
  o.tint=mix3(base,v3(0.65f32+0.28f32*autumn,0.88f32-0.20f32*autumn,0.07f32),height);o.local=v3(2,height,1);
 }
 return o;
}
// ---- the grass field (verse/everglade2/field.coax): a tuft a cell, placed here from the draw's block
// code and the cell's own hash, so the CPU only picks the blocks in view.
e2_field_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32)->FivelabS {
 o:FivelabS;o.pos=v4(0,0,-2,1);
 local:=instance-cast(u32)E2_FIELD_BASE;cell:=local&255;rest:=local>>8;blk:=rest>>2;
 row:=cast(u32)E2_FIELD_ROW;tier:=blk/(row*row);bb:=blk-tier*row*row;bz:=bb/row;bx:=bb-bz*row;
 gx:=bx*16+(cell&15);gz:=bz*16+(cell>>4);t:=cast(int)tier;
 // the tuft's fine cell, and everything about it from that cell alone
 fx:=e2_field_fine_x(t,gx,gz);fz:=e2_field_fine_z(t,gx,gz);
 x:=E2_WEST+(cast(f32)fx+e2_unit(e2_field_hash(fx,fz,cast(u32)1)))*0.5f32;z:=E2_BACK-(cast(f32)fz+e2_unit(e2_field_hash(fx,fz,cast(u32)2)))*0.5f32;
 dx:=x-u[16];dz:=z-u[18];d:=sqrt(dx*dx+dz*dz);
 // this tier draws it only over its own stretch: the same tuft is the next tier's past it
 // (at the graphics quality's grass reach u[35] and finest share u[36], e2_field_start_r; whole, the original)
 whole:=u[35]>=0.9999f32 && u[36]>=0.9999f32;
 if (whole) {if (d<e2_field_start(t) || d>=e2_field_out(t)) {return o;}}
 else {if (d<e2_field_start_r(t,u[35],u[36]) || d>=e2_field_out_r(t,u[35],u[36])) {return o;}}
 if (e2_unit(e2_field_hash(fx,fz,cast(u32)6))>=e2_field_cover(x,z)) {return o;}
 // distance only fades a tuft (a dither share, e2_dither_keep); its place and size are its cell's
 rel:=ifx whole then e2_field_rel(t,d) else e2_field_rel_r(t,d,u[35],u[36]);
 shown:=e2_field_shown(rel,e2_field_rank(t,gx,gz,fx,fz));
 if (shown<=0.0f32) {return o;}
 woods:=e2_forest(x,z);edge:=e2_smooth(0.03,0.30,e2_path(x,z));
 hgt:=(0.22f32+0.26f32*e2_unit(e2_field_hash(fx,fz,cast(u32)4)))*(1.0f32-0.40f32*edge)*(1.0f32-0.25f32*woods);
 sv:=hgt/f32(E2_FIELD_MESH);sh:=(0.55f32+0.35f32*e2_unit(e2_field_hash(fx,fz,cast(u32)7)))*0.85f32;
 au:=e2_gold(x,z);dark:=1.0f32-0.38f32*woods;
 tr:=(0.30f32+0.26f32*au)*dark;tg:=0.48f32*dark;tb:=0.055f32*dark;
 c:=v4(sv,sh,floor(tr*255.0f32+0.5f32)*256.0f32+floor(tg*255.0f32+0.5f32),tb+2.0f32);
 o=e2_kit_place(id,v4(x,e2_height(x,z),z,e2_unit(e2_field_hash(fx,fz,cast(u32)3))*6.2831853f32),c,u,vertices);
 o.dye.x=1.0f32-shown;return o;
}
// An Everglade kit prop (21: the pack's M rows, everglade/client/bench.coax): its 12-word vertex (position,
// normal and uv as floats, then the tint's bytes under its layer), turned by the record's c.x, c.y
// (sine, cosine) and set at a; shaded as a textured model (10).
e2_prop_vs :: (id:u32,instance:u32,m:FivelabObj,u:[]f32,vertices:[]u32)->FivelabS {
 b:u32=add_wrap(wg_u32_f(m.b.w),mul_wrap(id,12));
 p:V3=v3(f32_from_bits(vertices[cast(int)b]),f32_from_bits(vertices[cast(int)add_wrap(b,1)]),f32_from_bits(vertices[cast(int)add_wrap(b,2)]));
 n:V3=v3(f32_from_bits(vertices[cast(int)add_wrap(b,3)]),f32_from_bits(vertices[cast(int)add_wrap(b,4)]),f32_from_bits(vertices[cast(int)add_wrap(b,5)]));
 w8:u32=vertices[cast(int)add_wrap(b,8)];t:V4=wg_unpack4x8unorm(w8);cs:=m.c.y;sn:=m.c.x;
 w:V3=add3(v3(m.a.x,m.a.y,m.a.z),v3(p.x*cs+p.z*sn,p.y,-p.x*sn+p.z*cs));
 o:FivelabS;o.pos=fivelab_project(w,u);o.world=w;o.normal=v3(n.x*cs+n.z*sn,n.y,-n.x*sn+n.z*cs);
 o.uv=v2(f32_from_bits(vertices[cast(int)add_wrap(b,6)]),f32_from_bits(vertices[cast(int)add_wrap(b,7)]));o.slice=(w8>>24)&255;
 o.tint=v3(t.x,t.y,t.z);o.dye=v4(0.0f32,0.0f32,0.0f32,12.0f32);o.local=v3(10.0f32,0.0f32,0.0f32);o.who=instance;
 return o;
}
#test "a kit prop's vertex: its float position turned a quarter by its record and set at a, its layer and tint from word 8" {
 vtx:[12]u32;vtx[0]=f32_bits(1.0f32);vtx[1]=f32_bits(0.5f32);vtx[2]=f32_bits(0.0f32);vtx[3]=f32_bits(1.0f32);
 vtx[6]=f32_bits(0.25f32);vtx[7]=f32_bits(0.75f32);vtx[8]=0x0e80ff40;
 m:FivelabObj;m.a=v4(10,2,-5,0);m.c=v4(1,0,0,0);m.d=v4(0,0,0,21);u:[208]f32;u[0]=1280;u[1]=720;
 o:=e2_prop_vs(0,3,m,u[..],vtx[..]);
 #assert abs(o.world.x-10)<0.0001 && abs(o.world.y-2.5)<0.0001 && abs(o.world.z+6)<0.0001 && abs(o.normal.z+1)<0.0001;
 #assert o.slice==14 && o.uv.x==0.25 && o.uv.y==0.75 && abs(o.tint.x-0.25f32)<0.01 && o.tint.y==1 && o.local.x==10 && o.who==3;
}
everglade2_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4,inst:[]V4)->FivelabS {
 if (instance>=cast(u32)E2_FIELD_BASE) {return e2_field_vs(id,instance,u,vertices);}
 if (instance>=cast(u32)E2_KIT_BASE) {return e2_kit_vs(id,instance,u,vertices,inst);}
 if (instance<cast(u32)65536) {mp:=objects[cast(int)instance];if (mp.d.w>20.5f32 && mp.d.w<21.5f32) {return e2_prop_vs(id,instance,mp,u,vertices);}}
 o:=fivelab_scene_vs(id,instance,u,vertices,objects,bake);
 // a monster's frame (18) or a held weapon (19, everglade/server/creatures.coax, everglade/client/guard.coax):
 // its record's f.w is the share of its pixels the dither drops as it thins in or out
 if (instance<cast(u32)65536) {m0:=objects[cast(int)instance];if (m0.d.w>17.5f32 && m0.d.w<19.5f32) {o.dye.x=m0.f.w;}}
 // Character Create's arrival (everglade/client/create.coax): your character pops up from its feet, u[99]
 // the share it is still short of its size (below 0 a little over it), for your records,
 // u[101] up to u[102]
 fi:=cast(f32)instance;
 if (abs(u[99])>0.0005f32 && fi>=u[101] && fi<u[102]) {
  m:=objects[cast(int)instance];k:=1.0f32-u[99];
  w:=v3(m.a.x+(o.world.x-m.a.x)*k,m.a.y+(o.world.y-m.a.y)*k,m.a.z+(o.world.z-m.a.z)*k);o.world=w;o.pos=fivelab_project(w,u);
 }
 return o;
}
#test "a grass tuft stands in one place at one size wherever the eye is, and only fades" #steps 4000000000 {
 // one template vertex (a grass blade's, kind 2) at the pack's start
 vtx:[8]u32;vtx[0]=f32_bits(0.3f32);vtx[1]=f32_bits(1.0f32);vtx[2]=f32_bits(0.2f32);vtx[3]=cast(u32)2<<24;
 u:[208]f32;u[0]=1280;u[1]=720;u[19]=900;u[20]=0;u[21]=0;u[22]= -1;u[24]=1;u[29]=1;u[35]=1;u[36]=1;
 seen:=0;faded:=0;
 for t:0..<4 {for i:0..<300 {
  // blocks round the walk, near and far from it
  pz:= -150.0f32+f32((i*13)%120);px:=e2_road_x(pz)+f32((i*29)%90)-45.0f32;bs:=e2_field_block(t);
  bx:=cast(int)floor((px-E2_WEST)/bs);bz:=cast(int)floor((E2_BACK-pz)/bs);cell:=(i*37)%256;
  inst:=cast(u32)(e2_field_code(t,bx,bz,2)+cell);
  wx:f32=0;wy:f32=0;wz:f32=0;has:=false;
  // the eye walks in 0.5 m steps 60 m down the path and back
  for k:0..<240 {
   ex:=e2_road_x(-120.0f32+f32(ifx k<120 then k else 239-k)*0.5f32);ez:= -120.0f32+f32(ifx k<120 then k else 239-k)*0.5f32;
   u[16]=ex;u[17]=e2_height(ex,ez)+2;u[18]=ez;
   o:=e2_field_vs(0,inst,u[..],vtx[..]);
   if (o.pos.z< -1.5f32) {continue;}
   #assert o.dye.x>=0 && o.dye.x<1;
   if (o.dye.x>0) {faded+=1;}
   if (!has) {wx=o.world.x;wy=o.world.y;wz=o.world.z;has=true;seen+=1;}
   else {#assert abs(o.world.x-wx)<0.0001 && abs(o.world.y-wy)<0.0001 && abs(o.world.z-wz)<0.0001;}
  }
 }}
 #assert seen>100 && faded>0;
}
// ---- the key light's shadow tiles (aethyr/render/cascades.coax cascade_rows; the page's
// E2_U_CASCADE, everglade/client/client.coax e2_shadows): up to four tiles of one depth atlas round the eye, each
// a ring further out, each snapped to its own texels in the light's space and drawn again only once
// the eye walks past its step. The header says how many and which is drawn this frame; each tile has
// its rect in the atlas, its rows across, up and in depth, its filter and its edge. As Everglade's
// (verse/everglade/gpu.coax eg_casc_*).
E2_U_CASCADE :: 104;
e2_casc :: (u:[]f32,k:int,row:int)->V4 {return wg_at4(u,E2_U_CASCADE+4+k*24+row*4);}
// A point's place in tile k: across and up -1 to 1, its depth 0 toward the light to 1.
e2_casc_place :: (w:V3,u:[]f32,k:int)->V3 {
 p:=v4(w.x,w.y,w.z,1);
 return v3(wg_dot4(e2_casc(u,k,1),p),wg_dot4(e2_casc(u,k,2),p),wg_dot4(e2_casc(u,k,3),p));
}
// Tile k's -1 to 1 into the atlas's (y up), where its casters draw.
e2_casc_clip :: (q:V3,u:[]f32,k:int)->V4 {
 r:=e2_casc(u,k,0);
 return v4(q.x*r.z+2.0f32*r.x+r.z-1.0f32,q.y*r.w+1.0f32-2.0f32*r.y-r.w,q.z,1);
}
#test "a shadow tile places a point by its rows and draws it inside its own rect" {
 u:[208]f32;o:=E2_U_CASCADE+4;
 // tile 0: the atlas's top-left quarter, 10 m reach round (0, 0), depth along y
 u[E2_U_CASCADE]=4;u[E2_U_CASCADE+1]=0;u[o]=0;u[o+1]=0;u[o+2]=0.5;u[o+3]=0.5;
 u[o+4]=0.1;u[o+11]=0;u[o+10]=0.1;u[o+13]= -0.01;u[o+15]=0.5;
 q:=e2_casc_place(v3(5,2,-5),u[..],0);#assert abs(q.x-0.5)<0.0001 && abs(q.y+0.5)<0.0001 && q.z>0 && q.z<0.5;
 c:=e2_casc_clip(v3(1,1,0.3),u[..],0);#assert abs(c.x-0)<0.0001 && abs(c.y-1)<0.0001;
 d:=e2_casc_clip(v3(-1,-1,0.3),u[..],0);#assert abs(d.x+1)<0.0001 && abs(d.y-0)<0.0001;
}
// A caster for the key light's tiles: CgShadow's, and a body's fade (e2_body_fade) so a player coming
// into or leaving your view thins its shadow as it thins itself.
E2Shadow :: struct {pos:V4;uv:V2;slice:u32;edge:V2;fade:f32;}
// A body's fade: the page's record word f.w is 2 for an Everglade II body (its eye colour in f.xyz)
// plus the share of its pixels the dither drops while it comes into or leaves your view (0 whole).
e2_body_fade :: (s:FivelabS,objects:[]FivelabObj)->f32 {
 if (s.dye.w>11.5f32) {return 0;}
 w:=objects[cast(int)s.who].f.w;return ifx w>2.0005f32 && w<3.0f32 then w-2.0f32 else 0.0f32;
}
everglade2_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4,inst:[]V4)->E2Shadow {
 o:E2Shadow;o.pos=v4(0,0,-2,1);
 k:=cast(int)u[E2_U_CASCADE+1];
 if (u[10]<1.5f32 || u[E2_U_CASCADE]<0.5f32 || k<0 || k>3) {return o;}
 s:=everglade2_scene_vs(id,instance,u,vertices,objects,bake,inst);if (s.dye.w>11.5f32 && s.local.x<0.5f32) {return o;}
 q:=e2_casc_place(s.world,u,k);o.pos=e2_casc_clip(q,u,k);o.edge=v2(q.x,q.y);o.uv=s.uv;o.slice=s.slice;o.fade=e2_body_fade(s,objects);return o;
}
everglade2_shadow_fs :: (s:E2Shadow,sheets:Tex2DArray,sheet:Sampler) {
 if (abs(s.edge.x)>1.0f32 || abs(s.edge.y)>1.0f32) {gpu_demote_helper();}
 if (!e2_dither_keep(v2(s.pos.x,s.pos.y),s.fade)) {gpu_demote_helper();}
 t:=render_sample_layer8_bias(sheets,sheet,s.uv,cast(s32)s.slice,0);
 if (t.w<0.35f32) {gpu_demote_helper();}
}
// Tile k's share of the key at p, -1 when it holds no picture or p is outside it with its filter.
// Called with a literal k (e2_shadow_visibility), so every row it reads is a fixed uniform.
e2_casc_try :: (p:V3,n:V3,u:[]f32,map:TexDepth,cmp:SamplerCompare,k:int)->f32 {
 x:=e2_casc(u,k,5);
 if (x.y<0.5f32) {return -1;}
 f:=e2_casc(u,k,4);
 q:=e2_casc_place(add3(p,scale3(normalize3(n),f.w)),u,k);
 edge:=1.0f32-x.x;
 if (!(abs(q.x)<edge && abs(q.y)<edge && q.z>0 && q.z<1)) {return -1;}
 r:=e2_casc(u,k,0);uv:=v2(r.x+(0.5f32+0.5f32*q.x)*r.z,r.y+(0.5f32-0.5f32*q.y)*r.w);
 lit:f32=0;
 // six taps at the graphics quality's lower shadow (row 5's w, e2_shadows)
 if (x.w>0.5f32) {
  for i:0..<6 {a:=cast(f32)i*2.399963f32;d:=sqrt((cast(f32)i+0.5f32)/6.0f32);
   lit=lit+gpu_compare(map,cmp,v2(uv.x+cos(a)*d*f.x,uv.y+sin(a)*d*f.y),q.z-f.z);}
  return lit/6.0f32;
 }
 for i:0..<12 {a:=cast(f32)i*2.399963f32;d:=sqrt((cast(f32)i+0.5f32)/12.0f32);
  lit=lit+gpu_compare(map,cmp,v2(uv.x+cos(a)*d*f.x,uv.y+sin(a)*d*f.y),q.z-f.z);}
 return lit/12.0f32;
}
// How much of the key reaches p: the finest drawn tile that holds p; outside them all, lit.
e2_shadow_visibility :: (p:V3,n:V3,u:[]f32,map:TexDepth,cmp:SamplerCompare)->f32 {
 if (u[E2_U_CASCADE]<0.5f32) {return 1;}
 a:=e2_casc_try(p,n,u,map,cmp,0);if (a>=0) {return a;}
 b:=e2_casc_try(p,n,u,map,cmp,1);if (b>=0) {return b;}
 if (u[E2_U_CASCADE]<2.5f32) {return 1;}
 c:=e2_casc_try(p,n,u,map,cmp,2);if (c>=0) {return c;}
 d:=e2_casc_try(p,n,u,map,cmp,3);if (d>=0) {return d;}
 return 1;
}
// ---- the ground: drawn from the admitted material table and the canopy's bake (#13052)
// The page's ground store (verse/everglade2/ground.coax e2g_gpu): vec4 0 the bake grid (cells, spacing,
// west, south), vec4 1 (rise, edge ease, live, the ground's share of the AO), then E2_GROUND_MATERIAL vec4s a material
// in the table's order, then the AO four to a vec4 from E2_GROUND_AO.
E2_GROUND_HEAD :: 2; E2_GROUND_MATERIAL :: 5; E2_GROUND_AO :: 22;   // ground.coax E2G_GPU_HEAD, E2G_GPU_MATERIAL, E2G_GPU_AO / 4
e2_ground_pick :: (w:V4,k:f32)->f32 {return ifx k<0.5f32 then w.x else ifx k<1.5f32 then w.y else ifx k<2.5f32 then w.z else w.w;}
// One material's linear albedo at (x, z) with the point's weights w (aethyr/render/terrain-shade.coax).
e2_ground_material :: (x:f32,z:f32,ground:[]V4,m:int,w:V4)->V3 {
 b:=E2_GROUND_HEAD+m*E2_GROUND_MATERIAL;a:=ground[b];c:=ground[b+1];f:=ground[b+2];g:=ground[b+3];h:=ground[b+4];
 t:=aethyr_terrain_blend_t(x,z,f.x,f.y,f.z,f.w,g.x,g.y);
 if (a.w>0.0f32) {t=t+a.w*aethyr_terrain_share(e2_ground_pick(w,c.w),e2_ground_pick(w,h.z));}
 gain:=aethyr_terrain_gain(x,z,g.z,g.w,h.x,h.y);
 return v3(aethyr_terrain_decode(a.x,c.x,t,gain),aethyr_terrain_decode(a.y,c.y,t,gain),aethyr_terrain_decode(a.z,c.z,t,gain));
}
// The ground's weights at (x, z): its layers over the meadow in order (forest.coax e2_ground_layer),
// as the tile's converter takes them (ground.coax e2g_weights).
e2_ground_weights :: (x:f32,z:f32)->V4 {
 w:=v4(1,0,0,0);
 c:=e2_ground_layer(x,z,0);w=v4(aethyr_terrain_over(w.x,c,0),aethyr_terrain_over(w.y,c,1),aethyr_terrain_over(w.z,c,0),aethyr_terrain_over(w.w,c,0));
 c=e2_ground_layer(x,z,1);w=v4(aethyr_terrain_over(w.x,c,0),aethyr_terrain_over(w.y,c,0),aethyr_terrain_over(w.z,c,1),aethyr_terrain_over(w.w,c,0));
 c=e2_ground_layer(x,z,2);w=v4(aethyr_terrain_over(w.x,c,0),aethyr_terrain_over(w.y,c,0),aethyr_terrain_over(w.z,c,0),aethyr_terrain_over(w.w,c,1));
 return w;
}
e2_ground_albedo :: (x:f32,z:f32,ground:[]V4)->V3 {
 w:=e2_ground_weights(x,z);out:=v3(0,0,0);
 if (w.x>0.0f32) {out=add3(out,scale3(e2_ground_material(x,z,ground,0,w),w.x));}
 if (w.y>0.0f32) {out=add3(out,scale3(e2_ground_material(x,z,ground,1,w),w.y));}
 if (w.z>0.0f32) {out=add3(out,scale3(e2_ground_material(x,z,ground,2,w),w.z));}
 if (w.w>0.0f32) {out=add3(out,scale3(e2_ground_material(x,z,ground,3,w),w.w));}
 return out;
}
e2_ground_at :: (ground:[]V4,k:int)->f32 {v:=ground[E2_GROUND_AO+k/4];r:=k%4;return ifx r==0 then v.x else ifx r==1 then v.y else ifx r==2 then v.z else v.w;}
// The canopy's AO on the ground at (x, z) (aethyr/render/bake.coax bake_sample at no height), eased to 1
// over the last metres inside the tile's edge as ground.coax e2g_ao; 1 off the tile or before the bake.
e2_ground_ao :: (x:f32,z:f32,ground:[]V4)->f32 {
 grid:=ground[0];head:=ground[1];
 if (head.z<0.5f32) {return 1.0f32;}
 n:=grid.x;span:=n*grid.y;
 if (aethyr_bake_inside(x,grid.z,span)*aethyr_bake_inside(z,grid.w,span)<0.5f32) {return 1.0f32;}
 gx:=(x-grid.z)/grid.y;gz:=(z-grid.w)/grid.y;ix:=aethyr_bake_index(gx,n);iz:=aethyr_bake_index(gz,n);
 fx:=aethyr_bake_fraction(gx,ix);fz:=aethyr_bake_fraction(gz,iz);
 side:=cast(int)n+1;q:=cast(int)iz*side+cast(int)ix;
 ao:=aethyr_bake_ao(aethyr_bake_bilerp(e2_ground_at(ground,q),e2_ground_at(ground,q+1),e2_ground_at(ground,q+side),e2_ground_at(ground,q+side+1),fx,fz),aethyr_bake_rise(0,head.x));
 edge:=fmin(fmin(x-grid.z,grid.z+span-x),fmin(z-grid.w,grid.w+span-z));t:=saturate(edge/head.y);
 return 1.0f32+(ao-1.0f32)*t*t*(3.0f32-2.0f32*t);
}
#test "the ground reads its table's material, the litter's share of the layers under it, and the bake's AO" {
 g:[40]V4;
 for i:0..<40 {g[i]=v4(1,1,1,1);}
 g[0]=v4(2,1,0,-2);g[1]=v4(6,0.5,1,4);
 // material 2 (the litter): its colours, all of its blend the autumn (1) against the meadow (0), a gain
 b:=E2_GROUND_HEAD+2*E2_GROUND_MATERIAL;
 g[b]=v4(0.2,0.3,0.1,1);g[b+1]=v4(0.6,0.3,0.1,1);g[b+2]=v4(0,0,0,0);g[b+3]=v4(0,0,0.9,0.2);g[b+4]=v4(1.5,7,0,0);
 w:=v4(0.1,0.3,0.6,0);
 got:=e2_ground_material(3,4,g[..],2,w);
 gain:=aethyr_terrain_gain(3,4,0.9,0.2,1.5,7);
 #assert abs(got.x-aethyr_terrain_decode(0.2,0.6,0.75,gain))<0.000001 && abs(got.y-aethyr_terrain_decode(0.3,0.3,0.75,gain))<0.000001;
 // the weights are the layers over the meadow, adding to one
 ww:=e2_ground_weights(-4.2,-8.8);
 #assert abs(ww.x+ww.y+ww.z+ww.w-1)<0.00001;
 // the AO: bilinear on its 3 by 3 samples, 1 off the grid, eased to 1 at the edge, 1 before the bake
 for k:0..<9 {v:=g[E2_GROUND_AO+k/4];r:=k%4;val:=0.6f32+0.04f32*f32(k);
  if r==0 {v.x=val;} else if r==1 {v.y=val;} else if r==2 {v.z=val;} else {v.w=val;} g[E2_GROUND_AO+k/4]=v;}
 // (1, -1) is sample 4, the middle, 0.5 from the edge: fully the bake
 #assert abs(e2_ground_ao(1,-1,g[..])-0.76)<0.00001;
 #assert abs(e2_ground_ao(0.5,-1,g[..])-mix(0.72f32,0.76f32,0.5f32))<0.00001;
 #assert e2_ground_ao(0,-1,g[..])==1 && e2_ground_ao(3,-1,g[..])==1 && e2_ground_ao(1,-3,g[..])==1;
 g[1]=v4(6,0.5,0,4);
 #assert e2_ground_ao(1,-1,g[..])==1;
}
e2_environment_fs :: (s:FivelabS,tex:V4,front:bool,u:[]f32,shadow:f32,table:[]V4)->V4 {
 if (s.local.x<0.5f32) {return v4(pow(tex.x,0.62f32),pow(tex.y,0.75f32),tex.z*0.965f32,1);}
 kind:=s.local.x;n:=normalize3(add3(s.normal,v3(0,0.0001f32,0)));
 foliage:=kind>0.5f32 && kind<2.5f32;grass:=kind>1.5f32 && kind<2.5f32;leaves:=kind>0.5f32 && kind<1.5f32;ground:=kind>4.5f32 && kind<5.5f32;
 if (!front && !foliage) {n=scale3(n,-1);}
 sun:=cg_sun_dir(u);eye:=wg_at3(u,16);view:=normalize3(sub3(eye,s.world));
 albedo:=mul3(v3(tex.x,tex.y,tex.z),cg_decode(s.tint));
 // 9: a model shaded by its vertex colour alone; 10: its texture times it (the monsters, their camp, the Sword)
 if (foliage || (kind>7.5f32 && kind<9.5f32)) {albedo=cg_decode(s.tint);}
 // the ground's colour is the admitted material table's at this point (the pack's vertex colours
 // are no longer read); the hand-set gold, woods and trail below are this realm's look on top
 if (ground) {albedo=e2_ground_albedo(s.world.x,s.world.z,table);}
 if (ground) {trail:=e2_path(s.world.x,s.world.z);// the gold is a sunlit hilltop's: steep banks keep more of their olive, and broad patches vary
  steep:=0.55f32+0.45f32*smoothstep(0.80f32,0.95f32,n.y);
  // inside the ridge cut on the walk to Everglade (past the main shot's view) the banks stay a grassy olive
  cut:=(1.0f32-cg_ramp(3.0f32,10.0f32,abs(s.world.x-e2_road_x(s.world.z))))*cg_ramp(-17.0f32,-22.0f32,s.world.z)*(1.0f32-cg_ramp(-40.0f32,-60.0f32,s.world.z));
  steep=steep*(1.0f32-0.65f32*cut);
  // under the woods the floor keeps less of the glade's gold and darkens to leaf litter
  woods:=e2_forest(s.world.x,s.world.z);
  albedo=mix3(albedo,cg_decode(v3(0.82f32,0.58f32,0.16f32)),e2_gold(s.world.x,s.world.z)*0.80f32*steep*(1.0f32-trail)*(1.0f32-0.75f32*woods));
  albedo=mix3(albedo,mul3(albedo,v3(0.62f32,0.70f32,0.55f32)),woods*0.55f32*(1.0f32-trail));
  albedo=scale3(albedo,0.84f32+0.32f32*cg_noise(v2(s.world.x*0.35f32+4.0f32,s.world.z*0.35f32)));
  // The reference trail is packed olive earth, darker than sand.
  albedo=mix3(albedo,cg_decode(v3(0.50f32,0.46f32,0.24f32)),trail*0.80f32);
  // where the grass field thins out with distance its colour carries on in the ground, by the same
  // cover (verse/everglade2/field.coax e2_field_cover), so the field never ends in a line
  au:=e2_gold(s.world.x,s.world.z);dk:=1.0f32-0.38f32*woods;
  lawn:=mul3(cg_decode(scale3(v3(0.47f32+0.27f32*au,0.66f32-0.10f32*au,0.06f32),dk)),mix3(v3(0.88f32,0.80f32,0.08f32),v3(0.60f32,0.86f32,0.10f32),0.6f32));
  away:=smoothstep(24.0f32,120.0f32,wg_length3(sub3(s.world,wg_at3(u,16))));
  albedo=mix3(albedo,lawn,e2_field_cover(s.world.x,s.world.z)*away*0.75f32);}
 if (leaves) {
  if (s.tint.x>s.tint.y*1.2f32) {age:=cg_noise(v2(s.world.x*1.4f32+s.world.y*0.7f32,s.world.z*1.4f32));albedo=cg_decode(cg_leaf_palette(s.tint,age));}
  albedo=scale3(albedo,0.70f32+0.45f32*sqrt(saturate(verse_style_luma(tex.x,tex.y,tex.z))));
 }
 if (kind>2.5f32 && kind<3.5f32 && s.tint.y<0.99f32) {albedo=scale3(cg_decode(v3(1,0.42f32,0.32f32)),0.7f32+0.3f32*sqrt(saturate(verse_style_luma(tex.x,tex.y,tex.z))));}
 if (kind>6.5f32 && kind<8.5f32) {albedo=scale3(cg_decode(ifx n.y>0.15f32 then v3(1,0.60f32,0.12f32) else v3(0.86f32,0.78f32,0.60f32)),0.72f32+0.28f32*sqrt(verse_style_luma(tex.x,tex.y,tex.z)));}
 town:f32= -1.0f32;
 if (kind>3.5f32 && kind<4.5f32 && town<0) {
  // Neutral grey stone (the placement tint keeps its value, loses most of its olive) with moss on
  // faces that look up, as the reference's cliff tops.
  base:=cg_decode(s.tint);grey:=verse_style_luma(base.x,base.y,base.z);base=mix3(base,v3(grey,grey*1.02f32,grey*0.96f32),0.35f32);
  moss:=smoothstep(0.30f32,0.85f32,n.y+0.25f32*(cg_noise(v2(s.world.x*0.9f32+s.world.y,s.world.z*0.9f32))-0.5f32))*(0.55f32+0.45f32*cg_noise(v2(s.world.x*1.7f32,s.world.z*1.7f32)));
  base=mix3(base,scale3(cg_decode(v3(0.52f32,0.64f32,0.26f32)),fmax(grey/0.22f32,0.7f32)),moss*0.85f32);
  albedo=scale3(base,0.60f32+0.50f32*sqrt(verse_style_luma(tex.x,tex.y,tex.z)));
 }
 visibility:=shadow*cg_cloud(u,s.world.x,s.world.z);
 ndl:=dot3(n,sun);direct:=saturate(ndl);ao:f32=1;
 if (leaves) {direct=saturate((ndl+0.65f32)/1.65f32);ao=clampf(s.local.y,0.5f32,1.0f32);}
 if (grass) {green:=saturate((s.tint.y-s.tint.x)*4.0f32);albedo=mul3(albedo,mix3(v3(0.88f32,0.80f32,0.08f32),v3(0.60f32,0.86f32,0.10f32),green));direct=(0.22f32+0.56f32*s.local.y)*(0.85f32+0.15f32*abs(ndl));ao=0.36f32+0.64f32*s.local.y;}
 if (kind>2.5f32 && kind<3.5f32) {direct=0.35f32+0.45f32*abs(ndl);}
 // the canopy's baked AO darkens the ground's sky light only, as it does your character's (u[62]), by
 // the share the page gives it (ground.coax E2G_GROUND_AO_SHARE)
 if (ground) {ao=1.0f32+(e2_ground_ao(s.world.x,s.world.z,table)-1.0f32)*table[1].w;}
 fill:=ifx leaves then (ifx s.tint.x>s.tint.y*1.2f32 then 2.1f32 else 1.15f32) else ifx kind>5.5f32 && kind<6.5f32 then 1.5f32 else ifx kind>3.5f32 && kind<4.5f32 && town<0 then 0.78f32 else 1.0f32;
 indirect:=mul3(albedo,scale3(cg_hemisphere(u,n),ao*fill));
 if (leaves && s.tint.x>s.tint.y*1.2f32) {indirect=mul3(indirect,v3(1.12f32,0.90f32,0.75f32));}
 colour:=add3(indirect,mul3(albedo,cg_irradiance(u,n,direct,0,visibility)));
 // the developer's light views (?light=ambient|direct, everglade/client/client.coax e2_light_view; u[51], 0 off): one term, no albedo
 lv:=u[51];if (lv>0.5f32 && lv<2.5f32) {lt:=ifx lv<1.5f32 then scale3(cg_hemisphere(u,n),ao*fill) else scale3(cg_sun_colour(u),direct*visibility);return v4(lt.x,lt.y,lt.z,0);}
 if (foliage) {
  // Thin leaves transmit rear sunlight; volume normals and ambient mask stay separate.
  back:=pow(saturate(dot3(scale3(sun,-1),view)),2.0f32);scatter:=(0.15f32+0.60f32*back)*(1.0f32-abs(ndl)*0.65f32)*visibility;
  colour=add3(colour,mul3(albedo,scale3(v3(1.35f32,1.16f32,0.62f32),scatter*(ifx grass then s.local.y else 1.0f32))));
 }
 if (ground) {mottle:=cg_noise(v2(s.world.x*2,s.world.z*2));meadow:=1.0f32-e2_path(s.world.x,s.world.z);grain:=cg_noise(v2(s.world.x*14,s.world.z*14));surface:=(0.90f32+0.16f32*mottle)*(1.0f32+meadow*(grain-0.5f32)*0.18f32)*mix(cg_soil(v2(s.world.x,s.world.z)),1,meadow);colour=scale3(colour,surface);indirect=scale3(indirect,surface);}
 colour=cg_atmosphere(u,colour,eye,s.world);share:=saturate(verse_style_luma(indirect.x,indirect.y,indirect.z)*exp(-cg_air_depth(u,eye,s.world))/fmax(verse_style_luma(colour.x,colour.y,colour.z),0.00001f32));return v4(colour.x,colour.y,colour.z,share);
}

cc_player_light :: (u:[]f32,albedo:V3,n:V3,view:V3,visibility:f32)->V3 {
 sun:=cg_sun_dir(u);
 // Same daylight as the meadow. Broad camera-side bounce keeps the face readable.
 direct:=saturate(dot3(n,sun));fill:=saturate(dot3(n,normalize3(add3(view,v3(0,0.35f32,0)))));
 irradiance:=add3(cg_irradiance(u,n,direct,1,visibility),scale3(v3(0.85f32,0.72f32,0.52f32),fill));
 return mul3(albedo,irradiance);
}
// A character's albedo: the colour layer's texel (the array sampler already decoded it from sRGB),
// dyed in display space (CA_DYES in aethyr/character-appearance.coax: the dye masks and colours are
// authored on display values), decoded, then times the part's tint and its record's multiplier.
// Live and film both call this, so they agree.
cc_albedo :: (tex:V3,dye:V4,tint:V3,base:V3,dyed:bool)->V3 {
 display:=cg_encode(tex);d:=ifx dyed then fivelab_dye(display,dye) else display;
 return mul3(mul3(cg_decode(d),cg_decode(tint)),base);
}
// The screen derivatives the material's normal map and data samples need, taken where every pixel
// still runs (WGSL's derivatives need uniform control flow).
CcDeriv :: struct {px:V3;py:V3;ux:V2;uy:V2;}
// The character surface: the part's material (mats: three vec4s a colour layer, aethyr/character/
// material.coax cm_pack), its normal and ORM maps from the pack's linear data layers, lit by the
// glade's sun, sky and the camera-side fill. u[60] 1 is the film quality (portraits and
// turntables, everglade/client/create.coax); u[61] 1 turns the maps off (before/after captures).
cc_player_fs :: (s:FivelabS,tex:V4,front:bool,u:[]f32,objects:[]FivelabObj,visibility:f32,mats:[]V4,data:Tex2DArray,sheet:Sampler,d:CcDeriv)->V4 {
 m:=objects[cast(int)s.who];at:=cast(int)s.slice*3;ma:=mats[at];mb:=mats[at+1];mc:=mats[at+2];kind:=cast(int)(ma.w+0.5f32);
 albedo:=cc_albedo(v3(tex.x,tex.y,tex.z),s.dye,s.tint,v3(ma.x,ma.y,ma.z),mc.z>0.5f32);
 if (m.f.w>1.5f32 && s.slice==FIVELAB_EYE_LAYER) {
  iris:=saturate((tex.x-fmax(tex.y,tex.z))*5.0f32);shade:=clampf(verse_style_luma(tex.x,tex.y,tex.z)*3.0f32,0.15f32,1.3f32);
  albedo=mix3(albedo,scale3(cg_decode(v3(m.f.x,m.f.y,m.f.z)),shade),iris);
 }
 g:=normalize3(add3(s.normal,v3(0,0.00001f32,0)));if (!front) {g=scale3(g,-1);}
 // the canopy's baked AO where you stand (u[62], verse/everglade2/ground.coax) shades the indirect terms only
 maps:=u[61]<0.5f32;rough:=mb.x;metal:=mb.y;ao:f32=clampf(u[62],0.0f32,1.0f32);n:=g;flags:=cast(int)(mc.w+0.5f32);
 if (maps && mb.z>-0.5f32) {nt:=render_sample_layer8_grad(data,sheet,s.uv,cast(s32)(mb.z+0.5f32),d.ux,d.uy,0);n=cm_normal(nt,mc.x,g,d.px,d.py,d.ux,d.uy);}
 if (maps && mb.w>-0.5f32) {o:=render_sample_layer8_grad(data,sheet,s.uv,cast(s32)(mb.w+0.5f32),d.ux,d.uy,0);rough=o.y;if ((flags&2)!=0) {metal=o.z;}if ((flags&1)!=0) {ao=ao*o.x;}}
 eye:=wg_at3(u,16);view:=normalize3(sub3(eye,s.world));sun:=cg_sun_dir(u);sunc:=cg_sun_colour(u);
 r:=cm_rough(rough,metal);f0:=cm_f0(albedo,metal);diffuse:=scale3(albedo,1.0f32-metal);
 // the sun on the mapped normal; the sky and the camera-side fill shaded by the map's occlusion
 direct:=saturate(dot3(n,sun))*visibility;fill:=saturate(dot3(n,normalize3(add3(view,v3(0,0.35f32,0)))));
 indirect:=mul3(diffuse,scale3(add3(cg_hemisphere(u,n),scale3(v3(0.85f32,0.72f32,0.52f32),fill)),ao));
 film:=u[60]>0.5f32;
 key:=scale3(mul3(diffuse,sunc),direct);
 if (film && kind==CM_SKIN) {key=scale3(mul3(cm_skin(diffuse,f0,r,n,g,sun,view),sunc),visibility);}
 else {key=add3(key,scale3(mul3(cm_ggx(f0,r,n,sun,view),sunc),visibility));}
 colour:=add3(key,indirect);
 lv:=u[51];if (lv>0.5f32 && lv<2.5f32) {lt:=ifx lv<1.5f32 then scale3(add3(cg_hemisphere(u,n),scale3(v3(0.85f32,0.72f32,0.52f32),fill)),ao) else scale3(sunc,direct);return v4(lt.x,lt.y,lt.z,0);}   // the light views, as the world's
 if (metal>0.0f32) {
  // a rough metal reflects what reaches it from every side: the sky, the camera-side fill and the sun
  around:=add3(scale3(add3(cg_hemisphere(u,n),scale3(v3(0.85f32,0.72f32,0.52f32),fill)),ao),scale3(sunc,direct));
  colour=add3(colour,cm_metal_sky(cm_metal_env(cg_hemisphere(u,reflect3(scale3(view,-1),n)),around,r),f0,r,saturate(dot3(n,view)),metal));
 }
 if (film && kind==CM_CLOTH) {colour=add3(colour,scale3(mul3(cm_sheen(scale3(albedo,mc.y),r,n,sun,view),sunc),visibility));}
 if (film && kind==CM_HAIR) {t:=cm_strand(n,d.px,d.py,d.ux,d.uy);colour=add3(colour,scale3(mul3(cm_hair(albedo,r,t,n,sun,view),sunc),visibility));}
 share:=saturate(verse_style_luma(indirect.x,indirect.y,indirect.z)/fmax(verse_style_luma(colour.x,colour.y,colour.z),0.00001f32));
 colour=cg_atmosphere(u,colour,eye,s.world);return v4(colour.x,colour.y,colour.z,share);
}
everglade2_scene_fs :: (s:FivelabS,front:bool,u:[]f32,objects:[]FivelabObj,mats:[]V4,ground:[]V4,sheets:Tex2DArray,sheet:Sampler,data:Tex2DArray,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->Everglade2Lit {
 deriv:=CcDeriv.{px=v3(gpu_dpdx_fine(s.world.x),gpu_dpdx_fine(s.world.y),gpu_dpdx_fine(s.world.z)),py=v3(gpu_dpdy_fine(s.world.x),gpu_dpdy_fine(s.world.y),gpu_dpdy_fine(s.world.z)),ux=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y)),uy=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y))};
 uv:=s.uv;ray:=add3(wg_at3(u,20),add3(scale3(wg_at3(u,24),(s.pos.x-u[23])/u[19]),scale3(wg_at3(u,28),(u[27]-s.pos.y)/u[19])));plate:=cg_sky_uv(ray);
 if (s.dye.w>11.5f32 && s.local.x<0.5f32) {uv=v2(clampf(plate.x,0.001f32,0.999f32),clampf(plate.y,0.001f32,0.999f32));}
 tex:=render_sample_layer8_bias(sheets,sheet,uv,cast(s32)s.slice,1);
 if (s.dye.w>11.5f32 && s.local.x<0.5f32) {
  // the painted plate follows the frame's resolved sky (#13067): the glade's record tints it by 1
  rd:=normalize3(ray);sky:=mix3(cg_decode(cg_sky(u,rd,wg_at3(u,32),u[2])),mul3(v3(tex.x,tex.y,tex.z),cg_sky_tint(u,rd)),cg_sky_plate_weight(plate));tex=v4(sky.x,sky.y,sky.z,1);
 }
 if (tex.w<0.35f32) {gpu_demote_helper();}
 if (s.dye.w>11.5f32 && !e2_dither_keep(v2(s.pos.x,s.pos.y),s.dye.x)) {gpu_demote_helper();}
 if (s.dye.w<11.5f32 && !e2_dither_keep(v2(s.pos.x,s.pos.y),e2_body_fade(s,objects))) {gpu_demote_helper();}
 c:V4;
 if (s.dye.w>11.5f32) {c=e2_environment_fs(s,tex,front,u,e2_shadow_visibility(s.world,s.normal,u,shadow_map,shadow_cmp),ground);}
 else {c=cc_player_fs(s,tex,front,u,objects,e2_shadow_visibility(s.world,s.normal,u,shadow_map,shadow_cmp),mats,data,sheet,deriv);}
 n:=normalize3(s.normal);z:=dot3(sub3(s.world,wg_at3(u,16)),wg_at3(u,20));
 sky:=s.dye.w>11.5f32 && s.local.x<0.5f32;foliage:=s.dye.w>11.5f32 && s.local.x>0.5f32 && s.local.x<2.5f32;
 indirect:=c.w;packed:=cg_normal_pack(n);
 c.w=ifx sky then 0.0f32 else ifx foliage then 0.4f32 else 0.12f32;
 return Everglade2Lit.{c=c,aux=v4(packed.x,packed.y,indirect,ifx sky then 0.0f32 else ifx foliage then -z else z)};
}
everglade2_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {
  texel:V2=v2(1.0f32/cast(f32)(wg_dims_2d(bloom_src).x),1.0f32/cast(f32)(wg_dims_2d(bloom_src).y));
  uv:V2=v2(pos.x*bloom_step[3]*texel.x,pos.y*bloom_step[3]*texel.y);
  if (bloom_step[2]<0.5f32) {
    c:V3=v3(0.0f32,0.0f32,0.0f32);
    {
      k:s32=0;
      while k<4 {
        o:V2=v2(((cast(f32)(k&1)*2.0f32)-1.0f32)*texel.x,((cast(f32)(k>>1)*2.0f32)-1.0f32)*texel.y);
        t:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+o.x,uv.y+o.y),0.0f32);
        c=add3(c,scale3(v3(t.x,t.y,t.z),verse_style_bloom_share(fmax(t.x,fmax(t.y,t.z)),0.62f32,0.30f32)*t.w));
        k+=1;
      }
    }
    return v4(c.x*0.25f32,c.y*0.25f32,c.z*0.25f32,1.0f32);
  }
  d:V2=v2(bloom_step[0]*texel.x,bloom_step[1]*texel.y);
  c:V3=scale3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,uv,0.0f32)),0.227f32);
  c=add3(c,scale3(add3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+(d.x*1.385f32),uv.y+(d.y*1.385f32)),0.0f32)),cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-(d.x*1.385f32),uv.y-(d.y*1.385f32)),0.0f32))),0.316f32));
  c=add3(c,scale3(add3(cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+(d.x*3.231f32),uv.y+(d.y*3.231f32)),0.0f32)),cg_rgb(gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-(d.x*3.231f32),uv.y-(d.y*3.231f32)),0.0f32))),0.070f32));
  return v4(c.x,c.y,c.z,1.0f32);
}

// Character Create's class pane (everglade/client/create.coax e2c_pane_uniforms): u[52..55] and u[56..59],
// device px, each a glass box like the wardrobe's (0 opacity outside, 0.58 inside), with its rim.
e2_in_box :: (p:V2,x0:f32,y0:f32,x1:f32,y1:f32)->bool {return x1>x0 && p.x>=x0 && p.x<=x1 && p.y>=y0 && p.y<=y1;}
e2_pane_cover :: (p:V2,u:[]f32)->f32 {return ifx e2_in_box(p,u[52],u[53],u[54],u[55]) || e2_in_box(p,u[56],u[57],u[58],u[59]) then 0.58f32 else 0.0f32;}
e2_box_edge :: (p:V2,x0:f32,y0:f32,x1:f32,y1:f32,k:f32)->f32 {
 if (!e2_in_box(p,x0,y0,x1,y1)) {return 0;}
 d:=fmin(fmin(p.x-x0,x1-p.x),fmin(p.y-y0,y1-p.y));return 1.0f32-smoothstep(0.0f32,1.25f32*k,d);
}
e2_pane_edge :: (p:V2,u:[]f32)->f32 {return fmax(e2_box_edge(p,u[52],u[53],u[54],u[55],u[4]),e2_box_edge(p,u[56],u[57],u[58],u[59],u[4]));}
#test "the class pane's glass covers its boxes only, with a rim" {
 u:[104]f32;u[4]=1;u[52]=1000;u[53]=20;u[54]=1300;u[55]=500;
 #assert e2_pane_cover(v2(1100,200),u[..])>0.5f32 && e2_pane_cover(v2(900,200),u[..])==0 && e2_pane_cover(v2(1100,600),u[..])==0;
 #assert e2_pane_edge(v2(1000.2f32,200),u[..])>0.5f32 && e2_pane_edge(v2(1100,200),u[..])==0;
}
// Character Create's arrival through Everglade's portal (everglade/client/create.coax): u[96] how much of the
// view the portal's light still holds, u[97] its clock, u[98] its swell, u[100] how far the glade has
// opened through it from the middle. The light is gpu/portal.coax's, at the scale the homepage handed
// over (PORTAL_HANDOFF half diagonals); the glade opens from the middle through rings that shimmer,
// and the picture ripples as it settles.
e2_arrival_uv :: (uv:V2,u:[]f32)->V2 {
 if (u[98]<=0.0005f32) {return uv;}
 x:=(uv.x-0.5f32)*u[0];y:=(uv.y-0.5f32)*u[1];half:=0.5f32*sqrt(u[0]*u[0]+u[1]*u[1]);l:=fmax(sqrt(x*x+y*y),1.0f32);r:=l/half;
 w:=sin(r*26.0f32-u[97]*7.0f32)*u[98]*0.011f32*half*(1.0f32-0.5f32*saturate(r));
 return v2(uv.x+x/l*w/u[0],uv.y+y/l*w/u[1]);
}
e2_arrival :: (c:V3,pixel:V2,u:[]f32)->V3 {
 if (u[96]<=0.0005f32) {return c;}
 half:=0.5f32*sqrt(u[0]*u[0]+u[1]*u[1]);x:=pixel.x-0.5f32*u[0];y:=pixel.y-0.5f32*u[1];big:=PORTAL_HANDOFF*half;
 p:=v2(x/big,y/big);light:=portal_field(p,u[97],u[98]);
 rn:=sqrt(x*x+y*y)/half;
 edge:=u[100]*1.5f32-0.1f32-rn+(portal_noise(v2(p.x*30.0f32+u[97]*0.6f32,p.y*30.0f32-u[97]*0.4f32))-0.5f32)*0.16f32;
 hold:=saturate(u[96]*(1.0f32-smoothstep(-0.02f32,0.22f32,edge)));
 rim:=exp(-(edge*edge)/0.004f32)*u[96]*(1.0f32-u[96]*0.5f32)*0.55f32;
 o:=mix3(c,light,hold);
 return v3(o.x+0.5f32*rim,o.y+0.92f32*rim,o.z+0.84f32*rim);
}
#test "the arrival's veil: whole, it is the portal's light; gone, the picture is untouched" {
 u:[104]f32;u[0]=1440;u[1]=900;c:=v3(0.2f32,0.4f32,0.1f32);
 a:=e2_arrival(c,v2(700,400),u[..]);#assert a.x==c.x && a.y==c.y && a.z==c.z;
 b:=e2_arrival_uv(v2(0.3f32,0.6f32),u[..]);#assert b.x==0.3f32 && b.y==0.6f32;
 u[96]=1;u[97]=12;u[98]=1;
 half:=0.5f32*sqrt(1440.0f32*1440.0f32+900.0f32*900.0f32);
 l:=portal_field(v2((700.0f32-720.0f32)/(PORTAL_HANDOFF*half),(400.0f32-450.0f32)/(PORTAL_HANDOFF*half)),12,1);d:=e2_arrival(c,v2(700,400),u[..]);
 #assert abs(d.x-l.x)<0.001f32 && abs(d.y-l.y)<0.001f32 && abs(d.z-l.z)<0.001f32;
 // opening: the middle shows the glade before the corners do
 u[100]=0.5f32;m:=e2_arrival(c,v2(720,450),u[..]);k:=e2_arrival(c,v2(5,5),u[..]);
 #assert abs(m.y-c.y)<0.05f32 && abs(k.y-c.y)>0.05f32;
}
everglade2_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
 pixel:=v2(pos.x,pos.y);uv:=e2_arrival_uv(v2(pos.x/u[0],pos.y/u[1]),u);raw:=gpu_sample_level(post_light,post_lin,uv,0);
 if (u[10]<1.5f32) {encoded:=e2_arrival(cg_encode(v3(raw.x,raw.y,raw.z)),pixel,u);return v4(encoded.x,encoded.y,encoded.z,1);}
 a:=wg_load_2d(post_aux,cg_post_pixel(pixel,wg_dims_2d(post_aux)),0);
 // the graphics quality's post knob u[37] (e2_knobs_frame): 1 all of it; under 1 no foliage filter and
 // the glow from the quarter chain alone (the host drew only it); under 0.45 also no contact shade,
 // no edge smoothing, no glow and plain glass
 if (u[37]<0.99f32) {
  low:=u[37]<0.45f32;
  m:=v3(raw.x,raw.y,raw.z);
  if (!low) {m=cg_fxaa(uv,v2(1.0f32/u[0],1.0f32/u[1]),post_light,post_lin);m=scale3(m,1.0f32-(1.0f32-cg_contact_ao(pixel,u,post_aux))*saturate(a.z));m=add3(m,scale3(cg_post_sample(post_quarter,post_lin,uv),0.40f32));}
  res:=ifx abs(a.w)<0.001f32 then cg_encode(m) else ifx u[51]>2.5f32 then cg_encode(add3(m,cg_sun_veil(uv))) else cg_output(u,add3(m,cg_sun_veil(uv)));
  if (u[11]<0.5f32) {glass:=fmax(cg_panel_opacity(pixel,u[0],u[1],u[4]),e2_pane_cover(pixel,u));fade:=1.0f32-u[40];if (glass*fade>0) {behind:=ifx low then cg_output(u,m) else cg_output(u,cg_glass(uv,u,post_light,post_lin));panel:=mix3(behind,v3(0.09f32,0.12f32,0.11f32),glass);res=mix3(res,panel,fade);res=mix3(res,v3(0.93f32,0.86f32,0.66f32),fmax(cg_panel_edge(pixel,u[0],u[1],u[4]),e2_pane_edge(pixel,u))*0.55f32*fade);}}
  res=cg_walk_veil(res,u);res=e2_arrival(res,pixel,u);return v4(res.x,res.y,res.z,1);
 }
 c:=cg_fxaa(uv,v2(1.0f32/u[0],1.0f32/u[1]),post_light,post_lin);c=scale3(c,1.0f32-(1.0f32-cg_contact_ao(pixel,u,post_aux))*saturate(a.z));
 glow:=add3(scale3(cg_post_sample(post_quarter,post_lin,uv),0.20f32),scale3(cg_post_sample(post_eighth,post_lin,uv),0.20f32));
 // A small foliage-only reconstruction filter integrates subpixel leaves and blades.
 // Depth/normal class keeps the character, painted petals and hard rocks sharp.
 if (a.w<0) {
  soft:V3=v3(0,0,0);
  for i:0..<4 {angle:=cast(f32)i*1.5707963f32;at:=v2(uv.x+cos(angle)*2.0f32/u[0],uv.y+sin(angle)*2.0f32/u[1]);soft=add3(soft,cg_post_sample(post_light,post_lin,at));}
  c=mix3(c,scale3(soft,0.25f32),0.55f32);
 }
 c=add3(c,glow);result:=ifx abs(a.w)<0.001f32 then cg_encode(c) else ifx u[51]>2.5f32 then cg_encode(add3(c,cg_sun_veil(uv))) else cg_output(u,add3(c,cg_sun_veil(uv)));if (u[11]<0.5f32) {glass:=fmax(cg_panel_opacity(pixel,u[0],u[1],u[4]),e2_pane_cover(pixel,u));fade:=1.0f32-u[40];if (glass*fade>0) {panel:=mix3(cg_output(u,cg_glass(uv,u,post_light,post_lin)),v3(0.09f32,0.12f32,0.11f32),glass);result=mix3(result,panel,fade);result=mix3(result,v3(0.93f32,0.86f32,0.66f32),fmax(cg_panel_edge(pixel,u[0],u[1],u[4]),e2_pane_edge(pixel,u))*0.55f32*fade);}}result=cg_walk_veil(result,u);result=e2_arrival(result,pixel,u);return v4(result.x,result.y,result.z,1);
}
everglade2_fx_vs_in :: struct {a:V4;b:V4;c:V4;d:V4;}
everglade2_fx_vs :: (id:u32,instance:u32,in_:everglade2_fx_vs_in,u:[]f32)->FivelabV {return fivelab_fx_vs(id,instance,fivelab_fx_vs_in.{a=in_.a,b=in_.b,c=in_.c,d=in_.d},u);}
everglade2_fx_fs :: (s:FivelabV,u:[]f32,sans_atlas:Tex2D,sans_sampler:Sampler)->V4 {return fivelab_fx_fs(s,u,sans_atlas,sans_sampler);}
