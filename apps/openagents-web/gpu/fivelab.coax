// 5E Lab's shaders (fivelab.coax): build.sh writes apps/openagents-web/fivelab.wgsl from this
// with coax/web/wgsl-module.coax (fivelab.module and fivelab.bindings beside it).
#load "../../../verse/gpu/wgsl.coax";
#load "../../../verse/style.coax";
#load "../../../aethyr/render/sampling.coax";

// bg_fs draws one of two views of the battle, as the page picks (V):
//  - flat: the bare grid of 5-foot squares, every fourth line brighter;
//  - glade: the same battle in 3D, in the painterly look Everglade has (docs/verse/art-styles.md):
//    a grass clearing ringed with trees under a hazy sky, the grid painted faintly on the grass,
//    the spells' areas on the ground. It traces each pixel against the glade's few shapes (the
//    ground and the trees' spheres and capsules, analytically), lights it with the style's soft
//    toon bands, cool shadows and haze (verse/style.coax), and writes its depth, so the figures
//    stand in it.
// The figures are scene_vs/scene_fs: the Quaternius people Everglade's NPCs wear (the realm's pack,
// verse/tools/people.py's parts), skinned on the GPU from the clips fivelab-bodies.coax bakes once
// into the bake store (three rows of four a joint, 65 joints a frame), an instance a part a figure
// (FivelabObj, the objects store), lit in the glade's bands.
// Either way the log panel's dark glass goes over it. fx_vs/fx_fs draw the strokes
// fivelab_frame writes (capsules): the HUD, the text, and in the glade the labels and effects.
// FivelabU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0: width, height, time, fade
//   grid 4: the flat grid's top-left corner x, y (device px), px per square, 0
//   cells 8: columns, rows, the view (0 flat, 1 glade), the HUD strip's height (device px)
//   panel 12: the log panel (x0, y0, x1, y1), device px; zero width is none
//   eye 16: the camera's eye xyz (m), its focal length (px)
//   fwd 20: forward xyz, the image centre's x (px)
//   right 24: right xyz, the image centre's y (px)
//   up 28: up xyz, 0
//   sun 32: toward the sun xyz, 0
//   zones 36: eight, two vec4s each: (x0, z0, x1, z1 m), (1 Entangle, 2 Faerie Fire, 0 none; 0; 0; 0)
//   bounds 100: the grid's half width and half depth (m), the square (m), how much bigger than 40
//              by 20 the grid is (the haze thins by as much, so a big field still reads)
// The frame store (`frame`, a read-only storage buffer at group 0 binding 1, coax/web/host.js), floats:
//   tokens 0: up to 17408 (fivelab.coax LAB_MAX), a vec4 each: (x, z: m in the glade, squares in the
//              flat view; 0 for none or 1 + its team + 4 times its state (0 standing, 1 down, 2 dead,
//              the flat view's only), whose turn just ran 0..1)
//   squares 69632: the grid's squares (up to 384 by 192), each the token standing nearest its
//              middle plus 1, 0 none
FIVELAB_SQUARES :: 69632;
FIVELAB_ZONES_AT :: 36;
FIVELAB_BOUNDS :: 100;
FIVELAB_ZONES :: 8;
FIVELAB_TREES :: 16;

fivelab_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
// How close p is to a square's edge, 1 on it; every fourth line brighter.
fivelab_lines :: (p:V2,u:[]f32)->f32 {
  s:f32=fmax(u[6],1.0f32);
  x:f32=(p.x-u[4])/s;
  y:f32=(p.y-u[5])/s;
  dx:f32=abs(fract(x+0.5f32)-0.5f32)*s;
  dy:f32=abs(fract(y+0.5f32)-0.5f32)*s;
  line:f32=1.0f32-smoothstep(0.3f32,1.1f32,fmin(dx,dy));
  mx:f32=abs(fract((x*0.25f32)+0.5f32)-0.5f32)*s*4.0f32;
  my:f32=abs(fract((y*0.25f32)+0.5f32)-0.5f32)*s*4.0f32;
  major:f32=1.0f32-smoothstep(0.4f32,1.4f32,fmin(mx,my));
  return (line*0.6f32)+(major*0.4f32);
}
// The flat view's tokens near pixel p: a ring in its side's colour (dimmed down, faint dead), a
// white one fading round whose turn just ran; a dot when the squares are too small for a ring.
fivelab_flat_tokens :: (p:V2,c0:V3,u:[]f32,frame:[]f32)->V3 {
  c:V3=c0;
  s:f32=fmax(u[6],1.0f32);
  gx:f32=(p.x-u[4])/s; gy:f32=(p.y-u[5])/s;
  cx:int=cast(int)floor(gx); cy:int=cast(int)floor(gy);
  cols:int=cast(int)u[8]; rows:int=cast(int)u[9];
  r:f32=s*0.34f32;
  w:f32=fmin(fmax(s*0.06f32,1.0f32),2.6f32);
  dy:int=-1;
  while dy<=1 {
    dx:int=-1;
    while dx<=1 {
      x:int=cx+dx; y:int=cy+dy;
      if ((x>=0)&&(x<cols)&&(y>=0)&&(y<rows)) {
        who:f32=frame[FIVELAB_SQUARES+(y*cols)+x];
        if (who>0.5f32) {
          at:int=(cast(int)who-1)*4;
          tk:V4=v4(frame[at],frame[at+1],frame[at+2],frame[at+3]);
          if (tk.z>0.5f32) {
            code:f32=tk.z-1.0f32;
            state:f32=floor(code/4.0f32);
            tm:f32=code-(4.0f32*state);
            col:V3=v3(0.45f32,0.95f32,0.55f32);
            if (tm>0.5f32) { col=v3(0.62f32,0.85f32,1.0f32); }
            if (tm>1.5f32) { col=v3(0.9f32,0.86f32,0.74f32); }
            a:f32=0.95f32;
            if (state>0.5f32) { col=v3(0.52f32,0.55f32,0.6f32); a=0.35f32; }
            if (state>1.5f32) { col=v3(0.28f32,0.3f32,0.34f32); a=0.3f32; }
            d:f32=wg_length2(v2(p.x-(u[4]+((tk.x+0.5f32)*s)),p.y-(u[5]+((tk.y+0.5f32)*s))));
            cover:f32=0.0f32;
            if (r<2.5f32) { cover=1.0f32-smoothstep(fmax(r,0.7f32),fmax(r,0.7f32)+0.8f32,d); }
            else { cover=1.0f32-smoothstep(w*0.5f32,(w*0.5f32)+1.0f32,abs(d-r)); }
            c=mix3(c,col,cover*a);
            if ((tk.w>0.0f32)&&(state<0.5f32)&&(r>=2.5f32)) {
              rt:f32=r*(1.25f32+((1.0f32-tk.w)*0.24f32));
              ring:f32=1.0f32-smoothstep(0.7f32,1.7f32,abs(d-rt));
              c=mix3(c,v3(0.9f32,0.92f32,0.96f32),ring*0.9f32*tk.w);
            }
          }
        }
      }
      dx+=1;
    }
    dy+=1;
  }
  return c;
}
fivelab_flat :: (p:V2,u:[]f32,frame:[]f32)->V3 {
  q:V2=v2((p.x/u[0])-0.5f32,(p.y/u[1])-0.5f32);
  r:f32=wg_length2(q);
  c:V3=scale3(v3(0.03f32,0.034f32,0.04f32),1.0f32-fmin(r,1.0f32));
  gx1:f32=u[4]+(u[8]*u[6]);
  gy1:f32=u[5]+(u[9]*u[6]);
  inside:f32=0.18f32;
  if ((((p.x>=u[4])&&(p.x<=gx1))&&(p.y>=u[5]))&&(p.y<=gy1)) {
    inside=1.0f32;
    c=add3(c,v3(0.012f32,0.016f32,0.014f32));
  }
  return fivelab_flat_tokens(p,add3(c,scale3(v3(0.2f32,0.23f32,0.22f32),fivelab_lines(p,u)*inside)),u,frame);
}

// ---- the glade's shapes

// A ray's distance to a sphere, or -1.
fivelab_sphere :: (ro:V3,rd:V3,c:V3,r:f32)->f32 {
  oc:V3=sub3(ro,c);
  b:f32=dot3(oc,rd);
  k:f32=dot3(oc,oc)-(r*r);
  h:f32=(b*b)-k;
  if (h<0.0f32) { return -1.0f32; }
  t:f32=(-b)-sqrt(h);
  if (t<0.0f32) { return -1.0f32; }
  return t;
}
// A ray's distance to a capsule from a to b, radius r, or -1.
fivelab_capsule :: (ro:V3,rd:V3,a:V3,b:V3,r:f32)->f32 {
  ba:V3=sub3(b,a);
  oa:V3=sub3(ro,a);
  baba:f32=dot3(ba,ba);
  bard:f32=dot3(ba,rd);
  baoa:f32=dot3(ba,oa);
  rdoa:f32=dot3(rd,oa);
  oaoa:f32=dot3(oa,oa);
  qa:f32=baba-(bard*bard);
  qb:f32=(baba*rdoa)-(baoa*bard);
  qc:f32=((baba*oaoa)-(baoa*baoa))-((r*r)*baba);
  h:f32=(qb*qb)-(qa*qc);
  if (h<0.0f32) { return -1.0f32; }
  t:f32=((-qb)-sqrt(h))/fmax(qa,0.000001f32);
  y:f32=baoa+(t*bard);
  if ((y>0.0f32)&&(y<baba)) {
    if (t<0.0f32) { return -1.0f32; }
    return t;
  }
  oc:V3=oa;
  if (y>=baba) { oc=sub3(ro,b); }
  b2:f32=dot3(rd,oc);
  c2:f32=dot3(oc,oc)-(r*r);
  h2:f32=(b2*b2)-c2;
  if (h2<0.0f32) { return -1.0f32; }
  t2:f32=(-b2)-sqrt(h2);
  if (t2<0.0f32) { return -1.0f32; }
  return t2;
}
fivelab_capsule_n :: (p:V3,a:V3,b:V3)->V3 {
  ba:V3=sub3(b,a);
  pa:V3=sub3(p,a);
  h:f32=saturate(dot3(pa,ba)/fmax(dot3(ba,ba),0.000001f32));
  return normalize3(sub3(pa,scale3(ba,h)));
}
// Where tree i stands: round the clearing, past the grid's corners, a little uneven.
fivelab_tree :: (i:int,u:[]f32)->V4 {
  fi:f32=cast(f32)i;
  a:f32=(fi*0.3926991f32)+(0.35f32*sin(fi*2.3f32));
  rx:f32=u[FIVELAB_BOUNDS]+5.5f32+(2.5f32*verse_style_hash(fi,3.0f32));
  rz:f32=u[FIVELAB_BOUNDS+1]+5.0f32+(2.5f32*verse_style_hash(fi,7.0f32));
  size:f32=0.8f32+(0.45f32*verse_style_hash(fi,11.0f32));
  return v4(cos(a)*rx,0.0f32,sin(a)*rz,size);
}
// What a ray hits first: t (or 1e9), its normal, the material (0 ground, 1 trunk, 2 leaves) and
// which tree.
FivelabHit :: struct {t:f32; n:V3; m:f32; who:f32; }
fivelab_trace :: (ro:V3,rd:V3,u:[]f32,shadow:bool)->FivelabHit {
  h:FivelabHit;
  h.t=1000000000.0f32; h.n=v3(0.0f32,1.0f32,0.0f32); h.m=-1.0f32; h.who=-1.0f32;
  // the ground
  if (rd.y<(-0.0001f32)) {
    tg:f32=(-ro.y)/rd.y;
    if (!shadow) { h.t=tg; h.m=0.0f32; }
  }
  {
    i:int=0;
    while i<FIVELAB_TREES {
      tr:V4=fivelab_tree(i,u);
      // the trees on the camera's side of the clearing stand aside, so they never hide the battle
      ex:V2=v2(u[16],u[18]);
      front:f32=((tr.x*ex.x)+(tr.z*ex.y))/fmax(wg_length2(v2(tr.x,tr.z))*wg_length2(ex),0.001f32);
      if (front>0.45f32) { tr.y=-1.0f32; }
      k:f32=tr.w;
      if (tr.y<0.0f32) { k=0.0f32; }
      c1:V3=v3(tr.x,4.6f32*k,tr.z);
      tc:f32=fivelab_sphere(ro,rd,c1,2.7f32*k);
      if ((tc>0.0f32)&&(tc<h.t)) { h.t=tc; h.n=normalize3(sub3(add3(ro,scale3(rd,tc)),c1)); h.m=2.0f32; h.who=cast(f32)i; }
      c2:V3=v3(tr.x+(0.9f32*k),6.3f32*k,tr.z-(0.4f32*k));
      tc2:f32=fivelab_sphere(ro,rd,c2,1.9f32*k);
      if ((tc2>0.0f32)&&(tc2<h.t)) { h.t=tc2; h.n=normalize3(sub3(add3(ro,scale3(rd,tc2)),c2)); h.m=2.0f32; h.who=cast(f32)i; }
      ta:V3=v3(tr.x,0.0f32,tr.z);
      tb:V3=v3(tr.x,3.4f32*k,tr.z);
      tt:f32=fivelab_capsule(ro,rd,ta,tb,0.32f32*k);
      if ((tt>0.0f32)&&(tt<h.t)) { h.t=tt; h.n=fivelab_capsule_n(add3(ro,scale3(rd,tt)),ta,tb); h.m=1.0f32; h.who=cast(f32)i; }
      i+=1;
    }
  }
  return h;
}

// Bit k of a token's marks.
fivelab_mark :: (marks:f32,k:f32)->bool {
  return wg_fmod(floor(marks/wg_exp2(k)),2.0f32)>0.5f32;
}

// ---- the glade's light (the style's: verse/style.coax)

fivelab_sky :: (rd:V3,sun:V3,t:f32)->V3 {
  up:f32=fmax(rd.y,0.0f32);
  st:f32=verse_style_sky_t(up);
  c:V3=mix3(v3(0.78f32,0.84f32,0.86f32),v3(0.32f32,0.52f32,0.84f32),st);
  halo:f32=verse_style_halo(dot3(rd,sun),7.0f32);
  c=add3(c,scale3(v3(1.0f32,0.86f32,0.62f32),halo*0.45f32));
  disc:f32=verse_style_halo(dot3(rd,sun),900.0f32);
  c=add3(c,scale3(v3(1.0f32,0.95f32,0.85f32),disc*3.0f32));
  if (rd.y>0.02f32) {
    k:f32=300.0f32/rd.y;
    x:f32=(rd.x*k)+(t*2.0f32);
    z:f32=rd.z*k;
    n:f32=verse_style_cloud_field(x,z,0.0032f32,0.0091f32,2.0f32);
    cover:f32=verse_style_cloud_cover(n,0.4f32,0.48f32,0.62f32)*verse_style_cloud_fade(rd.y);
    lit:f32=verse_style_cloud_lit(n,verse_style_cloud_field(x+(sun.x*40.0f32),z+(sun.z*40.0f32),0.0032f32,0.0091f32,2.0f32));
    cloud:V3=mix3(v3(0.62f32,0.66f32,0.76f32),v3(1.0f32,0.97f32,0.92f32),lit);
    c=mix3(c,cloud,cover);
  }
  return c;
}
// The grass at (x, z): two greens broken up by noise, dabbed, the grid painted on in the clearing.
fivelab_grass :: (x:f32,z:f32,u:[]f32,t:f32)->V3 {
  n1:f32=verse_style_noise(x*0.35f32,z*0.35f32);
  n2:f32=verse_style_noise((x*1.7f32)+5.0f32,(z*1.7f32)+2.0f32);
  dab:f32=verse_style_noise(x*6.0f32,z*6.0f32);
  c:V3=mix3(v3(0.16f32,0.3f32,0.07f32),v3(0.33f32,0.46f32,0.13f32),(n1*0.65f32)+(n2*0.35f32));
  c=scale3(c,0.88f32+(0.24f32*dab));
  hw:f32=u[FIVELAB_BOUNDS]; hd:f32=u[FIVELAB_BOUNDS+1]; sq:f32=fmax(u[FIVELAB_BOUNDS+2],0.1f32);
  inside:f32=(1.0f32-smoothstep(hw,hw+0.3f32,abs(x)))*(1.0f32-smoothstep(hd,hd+0.3f32,abs(z)));
  // the clearing: shorter, lighter grass
  c=mix3(c,add3(scale3(c,0.82f32),v3(0.05f32,0.06f32,0.02f32)),inside*0.6f32);
  gx:f32=(x+hw)/sq; gz:f32=(z+hd)/sq;
  lx:f32=abs(fract(gx+0.5f32)-0.5f32)*sq;
  lz:f32=abs(fract(gz+0.5f32)-0.5f32)*sq;
  line:f32=1.0f32-smoothstep(0.012f32,0.045f32,fmin(lx,lz));
  c=mix3(c,v3(0.55f32,0.6f32,0.36f32),line*inside*0.5f32);
  return c;
}

// The glade at pixel p: its colour, and in w the depth of what it hit (1 the sky).
fivelab_glade :: (p:V2,u:[]f32,frame:[]f32)->V4 {
  t:f32=u[2];
  eye:V3=wg_at3(u,16);
  f:f32=fmax(u[19],1.0f32);
  fwd:V3=wg_at3(u,20);
  right:V3=wg_at3(u,24);
  up:V3=wg_at3(u,28);
  sun:V3=normalize3(wg_at3(u,32));
  rd:V3=normalize3(add3(fwd,add3(scale3(right,(p.x-u[23])/f),scale3(up,(u[27]-p.y)/f))));
  h:FivelabHit=fivelab_trace(eye,rd,u,false);
  if (h.m<0.0f32) { sk:V3=fivelab_sky(rd,sun,t); return v4(sk.x,sk.y,sk.z,1.0f32); }
  pos:V3=add3(eye,scale3(rd,h.t));
  n:V3=h.n;
  albedo:V3=v3(0.5f32,0.5f32,0.5f32);
  glow:V3=v3(0.0f32,0.0f32,0.0f32);
  if (h.m<0.5f32) {
    albedo=fivelab_grass(pos.x,pos.z,u,t);
    // the spells' areas on the ground
    {
      i:int=0;
      while i<FIVELAB_ZONES {
        za:V4=wg_at4(u,FIVELAB_ZONES_AT+(i*8));
        zb:V4=wg_at4(u,FIVELAB_ZONES_AT+4+(i*8));
        if (zb.x>0.5f32) {
          if ((((pos.x>=za.x)&&(pos.x<=za.z))&&(pos.z>=za.y))&&(pos.z<=za.w)) {
            if (zb.x<1.5f32) {
              vine:f32=verse_style_noise(pos.x*3.0f32,pos.z*3.0f32);
              albedo=mix3(albedo,v3(0.05f32,0.2f32,0.04f32),0.55f32+(0.35f32*vine));
              glow=add3(glow,scale3(v3(0.1f32,0.3f32,0.05f32),0.15f32*smoothstep(0.55f32,0.8f32,vine)));
            } else {
              mote:f32=verse_style_noise((pos.x*2.0f32)+(t*0.7f32),(pos.z*2.0f32)-(t*0.5f32));
              glow=add3(glow,scale3(v3(0.55f32,0.3f32,1.0f32),0.18f32+(0.35f32*smoothstep(0.6f32,0.9f32,mote))));
            }
          }
        }
        i+=1;
      }
    }
    // whose turn just ran: a ring of light round their feet; and every figure's contact shadow, from
    // the tokens on the nine squares round this one
    {
      hw:f32=u[FIVELAB_BOUNDS]; hd:f32=u[FIVELAB_BOUNDS+1]; sq:f32=fmax(u[FIVELAB_BOUNDS+2],0.1f32);
      cx:int=cast(int)floor((pos.x+hw)/sq);
      cz:int=cast(int)floor((pos.z+hd)/sq);
      cols:int=cast(int)u[8]; rows:int=cast(int)u[9];
      dz:int=-1;
      while dz<=1 {
        dx:int=-1;
        while dx<=1 {
          gx:int=cx+dx; gz:int=cz+dz;
          if ((gx>=0)&&(gx<cols)&&(gz>=0)&&(gz<rows)) {
            sqi:int=(gz*cols)+gx;
            who:f32=frame[FIVELAB_SQUARES+sqi];
            if (who>0.5f32) {
              tk:V4=wg_at4(frame,(cast(int)who-1)*4);
              if (tk.z>0.5f32) {
                code:f32=tk.z-1.0f32;
                state:f32=floor(code/4.0f32);
                tm:f32=code-(4.0f32*state);
                d:f32=wg_length2(v2(pos.x-tk.x,pos.z-tk.y));
                albedo=scale3(albedo,0.55f32+(0.45f32*smoothstep(0.15f32,0.7f32,d)));
                ring:f32=1.0f32-smoothstep(0.03f32,0.08f32,abs(d-0.68f32));
                // the ring in its team's colour
                tc:V3=v3(0.35f32,0.95f32,0.45f32);
                if (tm>0.5f32) { tc=v3(0.55f32,0.85f32,1.0f32); }
                if (tm>1.5f32) { tc=v3(0.9f32,0.86f32,0.74f32); }
                if (state<0.5f32) { glow=add3(glow,scale3(tc,ring*(0.25f32+(tk.w*1.6f32)))); }
              }
            }
          }
          dx+=1;
        }
        dz+=1;
      }
    }
  } else if (h.m<1.5f32) {
    albedo=v3(0.24f32,0.15f32,0.08f32);
    albedo=scale3(albedo,0.8f32+(0.4f32*verse_style_noise(pos.y*4.0f32,(pos.x+pos.z)*6.0f32)));
  } else if (h.m<2.5f32) {
    leaf:f32=verse_style_noise((pos.x*1.3f32)+pos.y,(pos.z*1.3f32)-pos.y);
    albedo=mix3(v3(0.09f32,0.24f32,0.06f32),v3(0.3f32,0.45f32,0.1f32),leaf);
    // painted leaf masses: the normal nudged by the noise, so the bands break into dabs
    n=normalize3(add3(n,scale3(v3(leaf-0.5f32,verse_style_noise(pos.x*2.1f32,pos.z*2.1f32)-0.5f32,0.5f32-leaf),0.9f32)));
  }
  // the sun: soft toon bands, the shadow ray's answer folded in
  ndl:f32=dot3(n,sun);
  lit:f32=1.0f32;
  if (ndl>0.0f32) {
    sh:FivelabHit=fivelab_trace(add3(pos,scale3(n,0.02f32)),sun,u,true);
    if (sh.m>0.0f32) { lit=0.0f32; }
  }
  w:f32=verse_style_wrap(ndl)*lit;
  band:f32=verse_style_bands(w,0.2f32,0.58f32,0.06f32,0.55f32);
  amb:f32=verse_style_ambient(n.y,1.0f32,0.55f32,1.0f32);
  shadow_light:V3=scale3(v3(0.36f32,0.44f32,0.62f32),0.62f32*amb);
  lit_light:V3=add3(scale3(v3(1.0f32,0.9f32,0.74f32),1.25f32),scale3(shadow_light,0.6f32));
  c:V3=v3(verse_style_shade(albedo.x,shadow_light.x,lit_light.x,band),
          verse_style_shade(albedo.y,shadow_light.y,lit_light.y,band),
          verse_style_shade(albedo.z,shadow_light.z,lit_light.z,band));
  c=add3(c,glow);
  // haze toward the horizon
  hz:f32=1.0f32-exp(((-h.t)*0.011f32)/fmax(u[FIVELAB_BOUNDS+3],1.0f32));
  hc:V3=mix3(v3(0.72f32,0.8f32,0.84f32),v3(1.0f32,0.9f32,0.75f32),verse_style_halo(dot3(rd,sun),5.0f32)*0.5f32);
  o:V3=mix3(c,hc,hz*0.85f32);
  return v4(o.x,o.y,o.z,fivelab_depth(h.t*dot3(rd,fwd)));
}
// The glade's tone and grade, then the HUD's dark glass: the strip along the top, so its text reads
// over the sky, and the log panel.
fivelab_finish :: (c0:V3,p:V2,u:[]f32)->V3 {
  c:V3=v3(verse_style_tone(c0.x,1.15f32),verse_style_tone(c0.y,1.15f32),verse_style_tone(c0.z,1.15f32));
  l:f32=verse_style_luma(c.x,c.y,c.z);
  c=v3(verse_style_saturation(c.x,l,1.12f32),verse_style_saturation(c.y,l,1.12f32),verse_style_saturation(c.z,l,1.12f32));
  if (p.y<u[11]) { c=add3(scale3(c,0.22f32),v3(0.01f32,0.012f32,0.016f32)); }
  return fivelab_glass(c,p,u);
}
fivelab_glass :: (c:V3,p:V2,u:[]f32)->V3 {
  if (u[14]>u[12]) {
    if ((((p.x>=u[12])&&(p.x<=u[14]))&&(p.y>=u[13]))&&(p.y<=u[15])) {
      return add3(scale3(c,0.14f32),v3(0.012f32,0.014f32,0.02f32));
    }
  }
  return c;
}
// A traced point's depth in the figures' depth buffer (fivelab_project's): z along the view, from
// FIVELAB_NEAR to FIVELAB_FAR.
FIVELAB_NEAR :: 0.1f32;
FIVELAB_FAR :: 900.0f32;
fivelab_depth :: (z:f32)->f32 {
  if (z<=FIVELAB_NEAR) { return 0.0f32; }
  return fmin((FIVELAB_FAR*(z-FIVELAB_NEAR))/((FIVELAB_FAR-FIVELAB_NEAR)*z),1.0f32);
}
// The camera's projection of a world point, as bg_fs's rays: the eye's frame and focal length.
fivelab_project :: (w:V3,u:[]f32)->V4 {
  rel:V3=sub3(w,wg_at3(u,16));
  z:f32=dot3(rel,wg_at3(u,20));
  x:f32=dot3(rel,wg_at3(u,24));
  y:f32=dot3(rel,wg_at3(u,28));
  f:f32=fmax(u[19],1.0f32);
  cx:f32=((((2.0f32*u[23])/u[0])-1.0f32)*z)+((2.0f32*f*x)/u[0]);
  cy:f32=((1.0f32-((2.0f32*u[27])/u[1]))*z)+((2.0f32*f*y)/u[1]);
  cz:f32=(FIVELAB_FAR*(z-FIVELAB_NEAR))/(FIVELAB_FAR-FIVELAB_NEAR);
  return v4(cx,cy,cz,z);
}

FivelabBg :: struct {c:V4; depth:f32 #depth; }
fivelab_bg_fs :: (pos:V4,u:[]f32,frame:[]f32)->FivelabBg {
  p:V2=v2(pos.x,pos.y);
  if (u[10]>0.5f32) {
    g:V4=fivelab_glade(p,u,frame);
    c:V3=fivelab_finish(v3(g.x,g.y,g.z),p,u);
    return FivelabBg.{c=v4(c.x,c.y,c.z,1.0f32),depth=g.w};
  }
  c:V3=fivelab_glass(fivelab_flat(p,u,frame),p,u);
  return FivelabBg.{c=v4(c.x,c.y,c.z,1.0f32),depth=1.0f32};
}
// ---- the figures: the pack's people parts (verse/tools/people.py's 24-byte vertex: x, y and z in
// 16 bits over a 2.5 m box, the layer and the vertex's kind, the normal in three signed bytes, uv in
// 16 bits, four joints and four weights in bytes), skinned on the GPU by up to four joints of a baked
// frame of the bake store, a second frame mixed in while a clip fades into the next.
// FivelabObj, an instance a part a figure (fivelab-bodies.coax bd_record):
//   a: where it stands x, y, z (m), its yaw
//   b: its frame's first row in the bake, the frame it fades from, how much of that one, the part's
//      first vertex word in the pack
//   c: its skin's tint (rgb), its outfit's colourway (0, 1: a layer on)
//   d: its hair's tint (rgb), bits: 1 bones (a skeleton), 2 drawn far (fewer parts)
//   e: its cloth's dye (rgb), how much (0 none)
//   f: its marks (fivelab.coax's bits), its state (0 standing, 1 down, 2 dead), outlined, its fade (1 whole)
FivelabObj :: struct {a:V4; b:V4; c:V4; d:V4; e:V4; f:V4; }
FivelabS :: struct {pos:V4; world:V3; normal:V3; uv:V2; slice:u32 #flat; tint:V3; dye:V4 #flat; local:V3; who:u32 #flat; }
FIVELAB_SPAN :: 2.5f32;
FivelabSkinned :: struct {p:V3; n:V3; }
// A vertex skinned by the four joints of the frame starting at row.
fivelab_skin :: (row:u32,joints:u32,weights:u32,at:V4,nw:V3,bake:[]V4)->FivelabSkinned {
  o:FivelabSkinned;
  o.p=v3(0.0f32,0.0f32,0.0f32);
  o.n=v3(0.0f32,0.0f32,0.0f32);
  {
    k:u32=0;
    while k<4 {
      w:f32=(cast(f32)(wg_byte(weights,mul_wrap(k,8))))/255.0f32;
      if (w>0.0f32) {
        r:u32=add_wrap(row,mul_wrap(wg_byte(joints,mul_wrap(k,8)),3));
        a:V4=bake[cast(int)r];
        c:V4=bake[cast(int)add_wrap(r,1)];
        e:V4=bake[cast(int)add_wrap(r,2)];
        o.p=add3(o.p,scale3(v3(wg_dot4(a,at),wg_dot4(c,at),wg_dot4(e,at)),w));
        o.n=add3(o.n,scale3(v3(dot3(v3(a.x,a.y,a.z),nw),dot3(v3(c.x,c.y,c.z),nw),dot3(v3(e.x,e.y,e.z),nw)),w));
      }
      k=add_wrap(k,1);
    }
  }
  return o;
}
// A skeleton is the same body made gaunt: in its bind pose (T, facing +z) the trunk and the limbs
// drawn in toward their bones.
fivelab_gaunt :: (p:V3)->V3 {
  q:V3=p;
  if (abs(p.x)<0.24f32) {
    if ((p.y>0.9f32)&&(p.y<1.5f32)) { q=v3(p.x*0.74f32,p.y,p.z*0.66f32); }
    if (p.y<=0.9f32) {
      side:f32=ifx p.x<0.0f32 then -0.1f32 else 0.1f32;
      q=v3(side+((p.x-side)*0.55f32),p.y,p.z*0.55f32);
    }
  } else {
    if (p.y>1.15f32) { q=v3(p.x,1.4f32+((p.y-1.4f32)*0.55f32),p.z*0.55f32); }
  }
  return q;
}
fivelab_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4)->FivelabS {
  m:FivelabObj=objects[cast(int)instance];
  b:u32=add_wrap(wg_u32_f(m.b.w),mul_wrap(id,6));
  xy:V2=wg_unpack2x16unorm(vertices[cast(int)b]);
  zw:u32=vertices[cast(int)add_wrap(b,1)];
  local:V3=add3(scale3(v3(xy.x,xy.y,(cast(f32)(zw&0xffff))/65535.0f32),FIVELAB_SPAN),v3(-1.25f32,-0.25f32,-1.25f32));
  flags:f32=m.d.w;
  bones:bool=wg_fmod(flags,2.0f32)>0.5f32;
  at:V3=local;
  if bones { at=fivelab_gaunt(local); }
  at4:V4=v4(at.x,at.y,at.z,1.0f32);
  nw4:V4=wg_unpack4x8snorm(vertices[cast(int)add_wrap(b,2)]);
  nw:V3=v3(nw4.x,nw4.y,nw4.z);
  joints:u32=vertices[cast(int)add_wrap(b,4)];
  weights:u32=vertices[cast(int)add_wrap(b,5)];
  sk:FivelabSkinned=fivelab_skin(wg_u32_f(m.b.x),joints,weights,at4,nw,bake);
  if (m.b.z>0.001f32) {
    sk2:FivelabSkinned=fivelab_skin(wg_u32_f(m.b.y),joints,weights,at4,nw,bake);
    sk.p=mix3(sk.p,sk2.p,m.b.z);
    sk.n=mix3(sk.n,sk2.n,m.b.z);
  }
  c:f32=cos(m.a.w); sn:f32=sin(m.a.w);
  w:V3=v3((sk.p.x*c)+(sk.p.z*sn)+m.a.x,sk.p.y+m.a.y,((-sk.p.x)*sn)+(sk.p.z*c)+m.a.z);
  o:FivelabS;
  o.pos=fivelab_project(w,u);
  o.world=w;
  o.normal=v3((sk.n.x*c)+(sk.n.z*sn),sk.n.y,((-sk.n.x)*sn)+(sk.n.z*c));
  o.uv=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,3)]);
  o.local=local;
  o.who=instance;
  kind:u32=(zw>>24)&255;
  o.slice=(zw>>16)&255;
  o.tint=v3(1.0f32,1.0f32,1.0f32);
  o.dye=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  if (kind==1) { o.tint=v3(m.c.x,m.c.y,m.c.z); }
  if (kind==2) { o.tint=v3(m.d.x,m.d.y,m.d.z); }
  if ((kind==3)||(kind==4)) {
    o.slice=add_wrap(o.slice,wg_u32_f(m.c.w));
    o.dye=v4(m.e.x,m.e.y,m.e.z,((cast(f32)(sub_wrap(kind,2)))*2.0f32)+m.e.w);
  }
  // a skeleton's bones and its rags: dye.w 8 the bone, 9 the cloth
  if bones { o.dye=v4(0.0f32,0.0f32,0.0f32,ifx kind>=3 then 9.0f32 else 8.0f32); }
  return o;
}
// A person's cloth dyed (Everglade's person_dye): dye.w 2 + share on a pale cloth, 4 + share on a
// green one; under 2, the texture as it is.
fivelab_dye :: (t:V3,dye:V4)->V3 {
  if ((dye.w<2.0f32)||(dye.w>=6.0f32)) { return t; }
  green:bool=dye.w>=4.0f32;
  share:f32=clampf(dye.w-(ifx green then 4.0f32 else 2.0f32),0.0f32,1.0f32);
  hi:f32=fmax(t.x,fmax(t.y,t.z));
  lo:f32=fmin(t.x,fmin(t.y,t.z));
  sat:f32=(hi-lo)/fmax(hi,0.0001f32);
  light:f32=verse_style_luma(t.x,t.y,t.z);
  mask:f32=smoothstep(0.12f32,0.3f32,hi)*(1.0f32-smoothstep(0.22f32,0.42f32,sat));
  usual:f32=0.42f32;
  if green {
    mask=smoothstep(0.02f32,0.06f32,t.y-fmax(t.x,t.z));
    usual=0.09f32;
  }
  dyed:V3=scale3(v3(dye.x,dye.y,dye.z),clampf(light/usual,0.0f32,1.6f32));
  return mix3(t,dyed,mask*share);
}
FIVELAB_EYE_LAYER :: cast(u32)32; // the pack's layer of the people's eyes (T_Eye_Brown)
fivelab_scene_fs :: (s:FivelabS,front:bool,u:[]f32,objects:[]FivelabObj,sheets:Tex2DArray,sheet:Sampler)->V4 {
  tex:V4=render_sample_layer8_bias(sheets,sheet,s.uv,cast,trunc(s32)(s.slice),1.0f32);
  m:FivelabObj=objects[cast(int)s.who];
  if (tex.w<0.35f32) { gpu_demote_helper(); }
  t:f32=u[2];
  albedo:V3=mul3(fivelab_dye(v3(tex.x,tex.y,tex.z),s.dye),s.tint);
  glow:V3=v3(0.0f32,0.0f32,0.0f32);
  if (s.dye.w>7.5f32) {
    // a skeleton: old bone, its rags near black, the ribs open to the light between them, and an
    // ember in each socket
    l:f32=verse_style_luma(tex.x,tex.y,tex.z);
    albedo=scale3(v3(0.8f32,0.75f32,0.62f32),0.7f32+(0.6f32*saturate(l*2.2f32)));
    if (s.dye.w>8.5f32) { albedo=scale3(v3(0.09f32,0.08f32,0.07f32),0.7f32+l); }
    p:V3=s.local;
    if ((p.y>1.0f32)&&(p.y<1.38f32)&&(abs(p.x)<0.2f32)) {
      if ((fract((p.y-1.0f32)*15.0f32)<0.45f32)&&(abs(p.x)>0.028f32)) { gpu_demote_helper(); }
      albedo=scale3(v3(0.8f32,0.75f32,0.62f32),0.85f32);
    }
    if ((p.y>0.86f32)&&(p.y<0.98f32)&&(abs(p.x)<0.2f32)) { albedo=scale3(albedo,0.45f32); }
    if (s.slice==FIVELAB_EYE_LAYER) { albedo=v3(0.02f32,0.01f32,0.01f32); glow=v3(1.2f32,0.3f32,0.08f32); }
  }
  n:V3=normalize3(add3(s.normal,v3(0.0f32,0.00001f32,0.0f32)));
  if (!front) { n=scale3(n,-1.0f32); }
  eye:V3=wg_at3(u,16);
  rd:V3=normalize3(sub3(s.world,eye));
  marks:f32=m.f.x;
  // Restrained: vines up the legs; Poisoned: a sick green cast; Blinded: a blindfold; enfeebled: drained grey; Temporary
  // Hit Points: a red ward at the rim
  if (fivelab_mark(marks,0.0f32)&&(s.world.y-m.a.y<0.9f32)) {
    vine:f32=fract(((s.world.y-m.a.y)*7.0f32)+(wg_atan2(s.world.z-m.a.z,s.world.x-m.a.x)*1.2f32));
    if (vine<0.3f32) { albedo=v3(0.08f32,0.32f32,0.05f32); }
  }
  if (fivelab_mark(marks,1.0f32)) { albedo=mix3(albedo,v3(0.4f32,0.55f32,0.08f32),0.45f32); }
  // Blinded: a dark band round the head over the eyes (theirs at 1.64 to 1.71 m in the bind pose)
  if (fivelab_mark(marks,2.0f32)&&(abs(s.local.y-1.677f32)<0.05f32)) { albedo=v3(0.03f32,0.025f32,0.03f32); }
  if (fivelab_mark(marks,3.0f32)) { albedo=scale3(v3(1.0f32,1.0f32,1.0f32),verse_style_luma(albedo.x,albedo.y,albedo.z)*0.8f32); }
  rim:f32=1.0f32-saturate(dot3(n,scale3(rd,-1.0f32)));
  if (fivelab_mark(marks,4.0f32)) { glow=add3(glow,scale3(v3(0.9f32,0.15f32,0.25f32),pow(rim,3.0f32)*0.9f32)); }
  // Paralyzed: held stiff in a gold sheen; hexed: a violet curse flickering at the rim
  if (fivelab_mark(marks,5.0f32)) {
    albedo=mix3(albedo,v3(0.85f32,0.7f32,0.3f32),0.35f32);
    glow=add3(glow,scale3(v3(1.0f32,0.8f32,0.35f32),pow(rim,2.0f32)*0.8f32));
  }
  if (fivelab_mark(marks,6.0f32)) {
    glow=add3(glow,scale3(v3(0.55f32,0.15f32,0.8f32),pow(rim,4.0f32)*(0.7f32+(0.3f32*sin((t*9.0f32)+(s.world.y*6.0f32))))));
  }
  // dead: greyed; outlined by Faerie Fire: a violet glow
  if (m.f.y>1.5f32) { albedo=scale3(v3(0.4f32,0.4f32,0.42f32),verse_style_luma(albedo.x,albedo.y,albedo.z)*2.2f32); }
  if (m.f.z>0.5f32) { glow=add3(glow,scale3(v3(0.7f32,0.4f32,1.0f32),(0.35f32+(0.25f32*sin(t*5.0f32)))+(rim*rim*0.9f32))); }
  // the sun in the glade's two bands, the trees' shadow traced, a cool fill and a rim
  sun:V3=normalize3(wg_at3(u,32));
  ndl:f32=dot3(n,sun);
  lit:f32=1.0f32;
  if (ndl>0.0f32) {
    sh:FivelabHit=fivelab_trace(add3(s.world,scale3(n,0.03f32)),sun,u,true);
    if (sh.m>0.0f32) { lit=0.0f32; }
  }
  w:f32=verse_style_wrap(ndl)*lit;
  band:f32=verse_style_bands2(w,0.4f32,0.08f32);
  amb:f32=verse_style_ambient(n.y,1.0f32,0.55f32,1.0f32);
  shadow_light:V3=scale3(v3(0.36f32,0.44f32,0.62f32),0.62f32*amb);
  lit_light:V3=add3(scale3(v3(1.0f32,0.9f32,0.74f32),1.25f32),scale3(shadow_light,0.6f32));
  c:V3=v3(verse_style_shade(albedo.x,shadow_light.x,lit_light.x,band),
          verse_style_shade(albedo.y,shadow_light.y,lit_light.y,band),
          verse_style_shade(albedo.z,shadow_light.z,lit_light.z,band));
  c=add3(c,scale3(v3(0.55f32,0.62f32,0.75f32),pow(rim,3.0f32)*0.25f32*saturate(n.y+0.6f32)));
  c=add3(c,glow);
  d:f32=wg_length3(sub3(s.world,eye));
  hz:f32=1.0f32-exp((-d)*0.011f32);
  hc:V3=mix3(v3(0.72f32,0.8f32,0.84f32),v3(1.0f32,0.9f32,0.75f32),verse_style_halo(dot3(rd,sun),5.0f32)*0.5f32);
  c=mix3(c,hc,hz*0.85f32);
  // a body cleared away fades out by an ordered dither
  if (m.f.w<0.999f32) {
    bayer:[16]f32=[16]f32.[0.0f32,8.0f32,2.0f32,10.0f32,12.0f32,4.0f32,14.0f32,6.0f32,3.0f32,11.0f32,1.0f32,9.0f32,15.0f32,7.0f32,13.0f32,5.0f32];
    px:int=(cast(int)s.pos.x)%4; py:int=(cast(int)s.pos.y)%4;
    if (((bayer[(py*4)+px]+0.5f32)/16.0f32)>=m.f.w) { gpu_demote_helper(); }
  }
  o:V3=fivelab_finish(c,v2(s.pos.x,s.pos.y),u);
  return v4(o.x,o.y,o.z,1.0f32);
}
FivelabV :: struct {pos:V4; place:V2; shape:V4; tint:V4; bar:V4; }
fivelab_fx_vs_in :: struct {a:V4; b:V4; c:V4; d:V4; }
fivelab_fx_vs :: (_vid2:u32,_iid3:u32,in_:fivelab_fx_vs_in,u:[]f32)->FivelabV {
  a:V4=in_.a;
  o:FivelabV;
  o.pos=v4(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=in_.b;
  o.tint=in_.c;
  o.bar=in_.d;
  return o;
}
// A capsule: shape.x its length, y its core's half width, z its light, w its glow's reach.
fivelab_fx_fs :: (v:FivelabV,u:[]f32)->V4 {
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  g:f32=d/fmax(v.shape.w,1.0f32);
  halo:f32=exp(((-5.0f32)*g)*g)*0.28f32;
  return wg_make_f4_f3f(scale3(scale3(scale3(v3(v.tint.x,v.tint.y,v.tint.z),(core+halo)),v.shape.z),u[3]),1.0f32);
}

// ---- the vector helpers this file calls
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
