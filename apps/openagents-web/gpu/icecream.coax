IcecreamV :: struct {pos:V4; place:V2; shape:V4; tint:V4; bar:V4; }
icecream_fx_vs_in :: struct {a:V4; b:V4; c:V4; d:V4; }
icecream_fx_vs :: (_vid2:u32,_iid3:u32,in_:icecream_fx_vs_in,u:[]f32)->IcecreamV {
  a:V4=in_.a;
  b:V4=in_.b;
  c:V4=in_.c;
  d:V4=in_.d;
  o:IcecreamV;
  ndc:V2=v2(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32));
  o.pos=v4(ndc.x,ndc.y,0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=b;
  o.tint=c;
  o.bar=d;
  return o;
}
icecream_fx_fs :: (v:IcecreamV,u:[]f32)->V4 {
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
