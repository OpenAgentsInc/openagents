        v:V3=wg_normalize3(wg_sub_f3f3(v3(u[24],u[25],u[26]),s.world));
        h:V3=wg_normalize3(wg_add_f3f3(l,v));
        sp:f32=pow(fmax(wg_dot3(n,h),0.0f32),28.0f32);
        c=wg_add_f3f3(c,wg_add_f3f3(wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,1.0f32,1.0f32),smoothstep(0.4f32,0.5f32,sp)),0.6f32),shine),wg_mul_f3f(v3(0.06f32,0.06f32,0.06f32),shine)));
      }
      c=wg_mix_f3f3f(c,v3(u[28],u[29],u[30]),fog);
    }
  }
  return wg_make_f4_f3f(icecream_panels(v2(s.pos.x,s.pos.y),icecream_overlay(v2(s.pos.x,s.pos.y),wg_mul_f3f(c,u[3]),u),u),1.0f32);
