ICECREAM_CHUNK :: cast(u32)1020;
ICECREAM_OBJ_BASE :: cast(u32)8388608;
ICECREAM_OBJ_OUTLINE :: cast(u32)4194304;
ICECREAM_LIT_FLAT :: cast(u32)128;
