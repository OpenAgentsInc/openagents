    c=wg_mix_f3f3f(ICECREAM_INK(),v3(u[28],u[29],u[30]),fog*0.6f32);
  } else {
    if (!front) {
      gpu_discard();
    }
    if (mode>0.5f32) {
      c=wg_mix_f3f3f(v3(s.look.x,s.look.y,s.look.z),v3(u[28],u[29],u[30]),fog*0.6f32);
    } else {
      n:V3=wg_normalize3(s.normal);
      l:V3=wg_normalize3(v3(0.35f32,1.0f32,0.25f32));
      d:f32=wg_dot3(n,l);
      band:f32=ifx d>0.25f32 then 1.0f32 else ifx d>(-0.35f32) then 0.86f32 else 0.74f32;
