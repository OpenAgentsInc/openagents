  fill:V3=v3(0.165f32,0.114f32,0.078f32);
  line:V3=v3(0.69f32,0.541f32,0.29f32);
  if (look==1) {
    line=v3(0.86f32,0.70f32,0.42f32);
  }
  if (look==2) {
    fill=v3(0.235f32,0.168f32,0.115f32);
    line=v3(0.95f32,0.80f32,0.52f32);
  }
  if (look==3) {
    fill=v3(0.29f32,0.13f32,0.17f32);
    line=v3(1.0f32,0.56f32,0.69f32);
  }
  if (look==4) {
    fill=v3(0.22f32,0.16f32,0.07f32);
    line=v3(0.97f32,0.77f32,0.17f32);
  }
  if (look==5) {
    fill=v3(0.30f32,0.20f32,0.07f32);
    line=v3(1.0f32,0.86f32,0.40f32);
