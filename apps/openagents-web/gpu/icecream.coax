  outline:bool=false;
  at:u32=add_wrap(mul_wrap(instance,ICECREAM_CHUNK),id);
  light:V3=v3(1.0f32,1.0f32,1.0f32);
  tint:V3=v3(1.0f32,1.0f32,1.0f32);
  mode:f32=0.0f32;
  shine:f32=0.0f32;
  r0:V4=v4(1.0f32,0.0f32,0.0f32,0.0f32);
  r1:V4=v4(0.0f32,1.0f32,0.0f32,0.0f32);
