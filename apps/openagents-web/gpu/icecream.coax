icecream_scene_fs :: (s:IcecreamS,front:bool,u:[]f32)->V4 {
  mode:f32=s.look.w;
  shine:f32=s.shine;
  fog:f32=smoothstep(u[32],u[33],wg_length3(wg_sub_f3f3(v3(u[24],u[25],u[26]),s.world)))*u[34];
