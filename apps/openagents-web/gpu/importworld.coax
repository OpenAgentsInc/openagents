// An imported world's shaders (apps/openagents-web/importworld.coax), the source of importworld.wgsl:
// build.sh writes it with coax/web/wgsl-module.coax (importworld.module and importworld.bindings beside
// it). The scene is the pack's own vertices (48 bytes: position, normal, UV, linear RGBA) drawn by
// instance, each instance's rows and colour in the object store (metaverse-engine/world/imported.coax
// iw_draws); it is lit by the map's key light, a sky-and-ground fill and up to 16 point lights, and
// fogged into the sky. The HUD is the splash's strokes and panels.
#load "splash.coax";
#load "../../../metaverse-engine/ui/primitive-shader.coax";
#load "../../../metaverse-engine/render/sampling.coax";

// The uniforms, floats:
//   0 width, 1 height, 2 time, 3 fade; 8 eye, 12 right, 16 up, 20 ahead (each 3); 24 focal, 26 cx, 27 cy
//   28 toward the key light (3), 31 ambient; 32 the key's colour times its intensity (3), 35 lights
//   36 sky (3), 39 fog distance; 40 ground (3)
//   44 + 8k: light k's position (3), range; its colour times its intensity (3)
IWR_LIGHTS :: 16;
iwr_vec :: (u: [] f32, at: int) -> V3 { return v3(u[at], u[at + 1], u[at + 2]); }
iwr_bg_vs :: (i: u32, j: u32) -> V4 { return splash_bg_vs(i, j); }
iwr_bg_fs :: (pos: V4, u: [] f32) -> V4 {
  x := (pos.x - u[26]) / u[24]; y := (u[27] - pos.y) / u[24];
  ray := wg_normalize3(wg_add_f3f3(iwr_vec(u, 20), wg_add_f3f3(wg_mul_f3f(iwr_vec(u, 12), x), wg_mul_f3f(iwr_vec(u, 16), y))));
  up := clampf(ray.y * 3.0f32, -1.0f32, 1.0f32);
  c := ifx up > 0.0f32 then wg_mix_f3f3f(wg_mul_f3f(iwr_vec(u, 36), 1.15f32), iwr_vec(u, 36), up) else wg_mix_f3f3f(wg_mul_f3f(iwr_vec(u, 36), 1.15f32), iwr_vec(u, 40), -up);
  c = wg_mul_f3f(c, u[3]);
  return v4(c.x, c.y, c.z, 1.0f32);
}
// A filmic curve (Narkowicz's fit of ACES): a level's key light, sky fill and point lights add past 1,
// and this rolls them off instead of clipping them to white.
iwr_tone1 :: (x: f32) -> f32 { y := fmax(x, 0.0f32); return clampf(y * (2.51f32 * y + 0.03f32) / (y * (2.43f32 * y + 0.59f32) + 0.14f32), 0.0f32, 1.0f32); }
iwr_tone :: (c: V3) -> V3 { return v3(iwr_tone1(c.x), iwr_tone1(c.y), iwr_tone1(c.z)); }
IwrSurface :: struct { pos: V4; world: V3; normal: V3; colour: V4; uv: V2; layer: f32; shade: V4; }
iwr_scene_vs :: (i: u32, j: u32, u: [] f32, vertices: [] u32, objects: [] V4) -> IwrSurface {
  at := cast(int) i * 12; o := cast(int) j * 8;
  rest := v4(f32_from_bits(vertices[at]), f32_from_bits(vertices[at + 1]), f32_from_bits(vertices[at + 2]), 1.0f32);
  rn := v3(f32_from_bits(vertices[at + 3]), f32_from_bits(vertices[at + 4]), f32_from_bits(vertices[at + 5]));
  word := vertices[at + 8];
  vc := v4(cast(f32) (word & 255) / 255.0f32, cast(f32) ((word >> 8) & 255) / 255.0f32, cast(f32) ((word >> 16) & 255) / 255.0f32, cast(f32) ((word >> 24) & 255) / 255.0f32);
  p := v3(wg_dot4(objects[o], rest), wg_dot4(objects[o + 1], rest), wg_dot4(objects[o + 2], rest));
  n := v3(wg_dot3(v3(objects[o + 3].x, objects[o + 3].y, objects[o + 3].z), rn), wg_dot3(v3(objects[o + 4].x, objects[o + 4].y, objects[o + 4].z), rn), wg_dot3(v3(objects[o + 5].x, objects[o + 5].y, objects[o + 5].z), rn));
  m := objects[o + 6];
  r := sub3(p, iwr_vec(u, 8)); z := wg_dot3(r, iwr_vec(u, 20));
  near := 0.05f32; far := 4000.0f32;
  clip := v4(2.0f32 * (wg_dot3(r, iwr_vec(u, 12)) * u[24] + (u[26] - u[0] * 0.5f32) * z) / u[0],
    2.0f32 * (wg_dot3(r, iwr_vec(u, 16)) * u[24] + (u[1] * 0.5f32 - u[27]) * z) / u[1],
    far / (far - near) * (z - near), z);
  uv := v2(f32_from_bits(vertices[at + 6]), f32_from_bits(vertices[at + 7]));
  return IwrSurface.{pos = clip, world = p, normal = n, colour = v4(vc.x * m.x, vc.y * m.y, vc.z * m.z, m.w), uv = uv, layer = objects[o + 7].x,
    shade = v4(vc.x * objects[o + 7].y, vc.y * objects[o + 7].z, vc.z * objects[o + 7].w, objects[o + 7].y)};
}
iwr_scene_fs :: (v: IwrSurface, front: bool, u: [] f32, sheets: Tex2DArray, sheet: Sampler) -> V4 {
  base := v3(v.colour.x, v.colour.y, v.colour.z);
  // a material with a colour layer: the pack's layer at the vertex's UV, times its colour
  tex := render_sample_layer8(sheets, sheet, v.uv, cast(s32) (fmax(v.layer, 0.0f32) + 0.5f32));
  if v.layer > -0.5f32 { base = v3(base.x * tex.x, base.y * tex.y, base.z * tex.z); }
  c := base;
  if v.shade.w >= 0.0f32 {
    // two-tone: the lit colour where the key light falls, the shadow colour where it doesn't, as the
    // project's own toon master draws it (no curve: the two colours are what it shows)
    n := wg_normalize3(v.normal);
    if !front { n = wg_mul_f3f(n, -1.0f32); }
    t := clampf((wg_dot3(n, wg_normalize3(iwr_vec(u, 28))) + 0.05f32) * 5.0f32, 0.0f32, 1.0f32);
    sh := v3(v.shade.x, v.shade.y, v.shade.z);
    if v.layer > -0.5f32 { sh = v3(sh.x * tex.x, sh.y * tex.y, sh.z * tex.z); }
    c = wg_mix_f3f3f(sh, base, t * t * (3.0f32 - 2.0f32 * t));
  } else if v.colour.w >= 0.0f32 {
    n := wg_normalize3(v.normal);
    if !front { n = wg_mul_f3f(n, -1.0f32); }
    key := wg_normalize3(iwr_vec(u, 28));
    sky := wg_mix_f3f3f(iwr_vec(u, 40), iwr_vec(u, 36), n.y * 0.5f32 + 0.5f32);
    light := wg_add_f3f3(wg_mul_f3f(sky, u[31]), wg_mul_f3f(iwr_vec(u, 32), fmax(wg_dot3(n, key), 0.0f32)));
    k := 0;
    while k < IWR_LIGHTS {
      if cast(f32) k >= u[35] { break; }
      b := 44 + k * 8;
      to := sub3(iwr_vec(u, b), v.world); d := wg_length3(to);
      fall := clampf(1.0f32 - d / fmax(u[b + 3], 0.01f32), 0.0f32, 1.0f32);
      light = wg_add_f3f3(light, wg_mul_f3f(iwr_vec(u, b + 4), fall * fall * fmax(wg_dot3(n, wg_mul_f3f(to, 1.0f32 / fmax(d, 0.001f32))), 0.0f32)));
      k += 1;
    }
    c = iwr_tone(v3(base.x * light.x, base.y * light.y, base.z * light.z));
  }
  dist := wg_length3(sub3(v.world, iwr_vec(u, 8)));
  fog := clampf(dist / fmax(u[39], 1.0f32), 0.0f32, 1.0f32);
  c = wg_mix_f3f3f(c, iwr_vec(u, 36), fog * fog);
  c = wg_mul_f3f(c, u[3]);
  return v4(c.x, c.y, c.z, 1.0f32);
}
IwrStroke :: struct { a: V4; b: V4; c: V4; }
iwr_fx_vs :: (i: u32, j: u32, a: IwrStroke, u: [] f32) -> SplashV {
  return splash_fx_vs(i, j, splash_fx_vs_in.{a = a.a, b = a.b, c = a.c, d = v4(0.0f32, 0.0f32, 0.0f32, 0.0f32)}, u);
}
iwr_fx_fs :: (v: SplashV, u: [] f32) -> V4 { if v.tint.w > 4.5f32 { return hud_primitive_fs(v.place, v.shape, v.tint, u[3]); } return splash_fx_fs(v, u); }

#test "an instance's rows place and turn a pack vertex, and a key light lights what faces it" {
  u: [256] f32; v: [12] u32; ob: [8] V4;
  texels := [4] V4.[v4(1, 1, 1, 1), v4(1, 1, 1, 1), v4(1, 1, 1, 1), v4(1, 1, 1, 1)]; sheets := Tex2DArray.{width = 2, height = 2, layers = 1, texels = texels[..]}; sheet: Sampler;
  u[0] = 1280; u[1] = 800; u[3] = 1; u[8] = 0; u[9] = 1; u[10] = 10; u[12] = 1; u[17] = 1; u[22] = -1; u[24] = 800; u[26] = 640; u[27] = 400;
  v[0] = f32_bits(0.5); v[1] = f32_bits(0); v[2] = f32_bits(0); v[4] = f32_bits(1); v[8] = 0xFFFFFFFF;
  ob[0] = v4(2, 0, 0, 3); ob[1] = v4(0, 1, 0, 1); ob[2] = v4(0, 0, 1, -2); ob[3] = v4(0.5, 0, 0, 0); ob[4] = v4(0, 1, 0, 0); ob[5] = v4(0, 0, 1, 0); ob[6] = v4(0.5, 0.25, 1, 1); ob[7] = v4(-1, -1, 0, 0);
  s := iwr_scene_vs(0, 0, u[..], v[..], ob[..]);
  #assert s.world.x == 4 && s.world.y == 1 && s.world.z == -2 && s.normal.y == 1 && s.colour.y == 0.25f32;
  #assert s.pos.w == 12;   // 12 m ahead of the eye
  u[28] = 0; u[29] = 1; u[30] = 0; u[32] = 1; u[33] = 1; u[34] = 1; u[39] = 1000;
  lit := iwr_scene_fs(s, true, u[..], sheets, sheet); dark := iwr_scene_fs(s, false, u[..], sheets, sheet);
  #assert abs(lit.x - iwr_tone1(0.5)) < 0.01 && dark.x < 0.01 && iwr_tone1(4) < 1.0001 && iwr_tone1(4) > 0.95 && iwr_tone1(0.5) < 0.7;
  s.colour.w = -1; #assert abs(iwr_scene_fs(s, false, u[..], sheets, sheet).x - 0.5f32) < 0.001;   // unlit takes its colour
  // a layer darkens by its texels: half grey halves the colour
  for k: 0..<4 { texels[k] = v4(0.5, 0.5, 0.5, 1); } s.layer = 0;
  #assert abs(iwr_scene_fs(s, false, u[..], sheets, sheet).x - 0.25f32) < 0.01;   // unlit: no curve
  // two-tone: the lit colour facing the key, the shadow colour facing away, no curve
  for k: 0..<4 { texels[k] = v4(1, 1, 1, 1); } s.layer = -1; s.colour = v4(0.9, 0.6, 0.4, 1); s.shade = v4(0.2, 0.1, 0.3, 0.2);
  tl := iwr_scene_fs(s, true, u[..], sheets, sheet); ts := iwr_scene_fs(s, false, u[..], sheets, sheet);
  #assert abs(tl.x - 0.9f32) < 0.01 && abs(ts.x - 0.2f32) < 0.01 && abs(ts.z - 0.3f32) < 0.01;
}
