// MetaHuman Lab's shaders (metahumanlab.coax): build.sh writes apps/openagents-web/metahumanlab.wgsl
// from this with coax/web/wgsl-module.coax (metahumanlab.module and metahumanlab.bindings beside it).
#load "../../../verse/gpu/wgsl.coax";
#load "../../../verse/style.coax";
#load "../../../aethyr/render/sampling.coax";

// bg_fs traces each pixel against the scene: a studio floor (a soft grey with a metre grid, fading
// into the backdrop) and the figure, a capsule per bone posed from the skeleton (the ray tests the
// figure's bounding sphere first). A sun ray from each lit point gives the figure's shadow. With
// the skeleton overlay on, the body is drawn as glass: the scene behind it shows through, so the
// overlay's bones read inside it. fx_vs/fx_fs draw the strokes metahumanlab.coax writes: the HUD
// and the skeleton.
// MhlabU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0: width, height, time, fade
//   flags 4: the skeleton overlay (1 on), 0, the HUD strip's height and the key line's along the bottom (device px)
//   eye 16: the camera's eye xyz (m), its focal length (px)
//   fwd 20: forward xyz, the image centre's x (px)
//   right 24: right xyz, the image centre's y (px)
//   up 28: up xyz, 0
//   sun 32: toward the sun xyz, 0
//   bound 36: the figure's bounding sphere: centre xyz, radius
//   head 40: the cranium's middle xyz, its radius; 44: the head's forward xyz; 48: its up xyz
//   caps 52: twenty-six capsules, two vec4s each: (a xyz, radius; 0 for none), (b xyz, material:
//            1 suit, 2 skin, 3 shoe, 4 head)
MHLAB_CAPS :: 26;

mhlab_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}

// Whether a ray passes within r of c (from in front of it or inside it).
mhlab_near :: (ro:V3,rd:V3,c:V3,r:f32)->bool {
  oc:V3=sub3(ro,c);
  b:f32=dot3(oc,rd);
  k:f32=dot3(oc,oc)-(r*r);
  if (k<0.0f32) { return true; }
  if (b>0.0f32) { return false; }
  return ((b*b)-k)>0.0f32;
}
// A ray's distance to a capsule from a to b, radius r, or -1.
mhlab_capsule :: (ro:V3,rd:V3,a:V3,b:V3,r:f32)->f32 {
  ba:V3=sub3(b,a);
  oa:V3=sub3(ro,a);
  baba:f32=fmax(dot3(ba,ba),0.0000001f32);
  bard:f32=dot3(ba,rd);
  baoa:f32=dot3(ba,oa);
  rdoa:f32=dot3(rd,oa);
  oaoa:f32=dot3(oa,oa);
  qa:f32=baba-(bard*bard);
  qb:f32=(baba*rdoa)-(baoa*bard);
  qc:f32=((baba*oaoa)-(baoa*baoa))-((r*r)*baba);
  h:f32=(qb*qb)-(qa*qc);
  if (h<0.0f32) { return -1.0f32; }
  t:f32=((-qb)-sqrt(h))/fmax(qa,0.000001f32);
  y:f32=baoa+(t*bard);
  if ((y>0.0f32)&&(y<baba)) {
    if (t<0.0f32) { return -1.0f32; }
    return t;
  }
  // the end caps
  oc:V3=oa;
  if (y>=baba) { oc=sub3(ro,b); }
  b2:f32=dot3(rd,oc);
  c2:f32=dot3(oc,oc)-(r*r);
  h2:f32=(b2*b2)-c2;
  if (h2<0.0f32) { return -1.0f32; }
  t2:f32=(-b2)-sqrt(h2);
  if (t2<0.0f32) { return -1.0f32; }
  return t2;
}
mhlab_capsule_n :: (p:V3,a:V3,b:V3)->V3 {
  ba:V3=sub3(b,a);
  pa:V3=sub3(p,a);
  h:f32=saturate(dot3(pa,ba)/fmax(dot3(ba,ba),0.000001f32));
  return normalize3(sub3(pa,scale3(ba,h)));
}
// What a ray hits first: t (or 1e9), its normal, the material (0 floor, 1 suit, 2 skin, 3 shoe,
// 4 head; -1 nothing) and which capsule. `shadow` leaves out the floor; `figure` false leaves out
// the figure.
MhlabHit :: struct {t:f32; n:V3; m:f32; who:f32; }
mhlab_trace :: (ro:V3,rd:V3,u:[]f32,shadow:bool,figure:bool)->MhlabHit {
  h:MhlabHit;
  h.t=1000000000.0f32; h.n=v3(0.0f32,1.0f32,0.0f32); h.m=-1.0f32; h.who=-1.0f32;
  if ((rd.y<(-0.0001f32))&&(!shadow)) {
    h.t=(-ro.y)/rd.y; h.m=0.0f32;
  }
  bound:V4=wg_at4(u,36);
  if (figure&&mhlab_near(ro,rd,v3(bound.x,bound.y,bound.z),bound.w)) {
    i:int=0;
    while i<MHLAB_CAPS {
      ca:V4=wg_at4(u,52+(i*8));
      cb:V4=wg_at4(u,56+(i*8));
      if (ca.w>0.0f32) {
        a:V3=v3(ca.x,ca.y,ca.z);
        b:V3=v3(cb.x,cb.y,cb.z);
        tc:f32=mhlab_capsule(ro,rd,a,b,ca.w);
        if ((tc>0.0f32)&&(tc<h.t)) { h.t=tc; h.n=mhlab_capsule_n(add3(ro,scale3(rd,tc)),a,b); h.m=cb.w; h.who=cast(f32)i; }
      }
      i+=1;
    }
  }
  return h;
}

// The backdrop: a studio's soft grey sweep, lighter toward the sun.
mhlab_sky :: (rd:V3,sun:V3)->V3 {
  up:f32=saturate(rd.y);
  c:V3=mix3(v3(0.5f32,0.53f32,0.57f32),v3(0.2f32,0.23f32,0.29f32),pow(up,0.6f32));
  c=add3(c,scale3(v3(1.0f32,0.9f32,0.75f32),verse_style_halo(dot3(rd,sun),6.0f32)*0.12f32));
  return c;
}
// The floor at (x, z): pale grey, a line every metre and a fainter one every 25 cm near the middle.
mhlab_floor :: (x:f32,z:f32)->V3 {
  c:V3=v3(0.46f32,0.47f32,0.49f32);
  c=scale3(c,0.94f32+(0.06f32*verse_style_noise(x*2.0f32,z*2.0f32)));
  lx:f32=abs(fract(x+0.5f32)-0.5f32);
  lz:f32=abs(fract(z+0.5f32)-0.5f32);
  line:f32=1.0f32-smoothstep(0.004f32,0.014f32,fmin(lx,lz));
  sx:f32=abs(fract((x*4.0f32)+0.5f32)-0.5f32)*0.25f32;
  sz:f32=abs(fract((z*4.0f32)+0.5f32)-0.5f32)*0.25f32;
  fine:f32=(1.0f32-smoothstep(0.002f32,0.008f32,fmin(sx,sz)))*(1.0f32-smoothstep(2.0f32,4.0f32,wg_length2(v2(x,z))));
  c=mix3(c,v3(0.3f32,0.31f32,0.34f32),(line*0.55f32)+(fine*0.22f32));
  return c;
}

// The colour a ray from the eye sees after hitting h.
mhlab_shade :: (eye:V3,rd:V3,h:MhlabHit,u:[]f32,figure:bool,lit_in:f32)->V3 {
  sun:V3=normalize3(wg_at3(u,32));
  if (h.m<0.0f32) { return mhlab_sky(rd,sun); }
  pos:V3=add3(eye,scale3(rd,h.t));
  n:V3=h.n;
  albedo:V3=v3(0.5f32,0.5f32,0.5f32);
  spec:f32=0.0f32;
  if (h.m<0.5f32) {
    albedo=mhlab_floor(pos.x,pos.z);
    // a soft dark pool under the figure
    bound:V4=wg_at4(u,36);
    d:f32=wg_length2(v2(pos.x-bound.x,pos.z-bound.z));
    if (figure) { albedo=scale3(albedo,0.62f32+(0.38f32*smoothstep(0.05f32,0.75f32,d))); }
  } else if (h.m<1.5f32) {
    // the suit: a dark slate fabric, a seam down the sides
    albedo=v3(0.13f32,0.15f32,0.19f32);
    spec=0.12f32;
  } else if (h.m<2.5f32) {
    albedo=v3(0.72f32,0.5f32,0.4f32);
    spec=0.2f32;
  } else if (h.m<3.5f32) {
    albedo=v3(0.06f32,0.06f32,0.07f32);
    spec=0.3f32;
  } else {
    // the head: skin, with hair over the crown and back, brows and eyes on its forward side
    albedo=v3(0.72f32,0.5f32,0.4f32);
    spec=0.2f32;
    hc:V3=wg_at3(u,40);
    hf:V3=normalize3(wg_at3(u,44));
    hu:V3=normalize3(wg_at3(u,48));
    hs:V3=wg_cross3(hu,hf);
    d:V3=normalize3(sub3(pos,hc));
    fw:f32=dot3(d,hf); upw:f32=dot3(d,hu); side:f32=dot3(d,hs);
    if (((upw>0.42f32)&&(fw<0.8f32))||((fw<(-0.15f32))&&(upw>(-0.55f32)))||((upw>0.15f32)&&(abs(side)>0.82f32))) {
      albedo=v3(0.1f32,0.07f32,0.05f32); spec=0.35f32;
    }
    eye_d:f32=wg_length2(v2(abs(side)-0.34f32,upw-0.06f32));
    if ((fw>0.7f32)&&(eye_d<0.075f32)) {
      albedo=v3(0.9f32,0.88f32,0.85f32);
      if (eye_d<0.045f32) { albedo=v3(0.18f32,0.26f32,0.32f32); }
      if (eye_d<0.022f32) { albedo=v3(0.02f32,0.02f32,0.03f32); }
      spec=0.8f32;
    }
    if ((fw>0.7f32)&&(abs(upw-0.2f32)<0.025f32)&&(abs(abs(side)-0.34f32)<0.11f32)) { albedo=v3(0.12f32,0.08f32,0.06f32); }
  }
  // the sun: a soft wrap, the shadow ray's answer folded in, a cool sky fill and a rim
  ndl:f32=dot3(n,sun);
  lit:f32=1.0f32;
  if (lit_in>=0.0f32) { lit=lit_in; }
  else if (ndl>0.0f32) {
    sh:MhlabHit=mhlab_trace(add3(pos,scale3(n,0.01f32)),sun,u,true,figure);
    if (sh.m>0.0f32) { lit=0.0f32; }
  }
  w:f32=verse_style_wrap(ndl)*lit;
  amb:f32=verse_style_ambient(n.y,1.0f32,0.5f32,1.0f32);
  sky:V3=scale3(v3(0.42f32,0.48f32,0.6f32),0.5f32*amb);
  key:V3=scale3(v3(1.0f32,0.93f32,0.82f32),1.35f32*w);
  c:V3=v3(albedo.x*(sky.x+key.x),albedo.y*(sky.y+key.y),albedo.z*(sky.z+key.z));
  v:V3=scale3(rd,-1.0f32);
  if (h.m>0.5f32) {
    hv:V3=normalize3(add3(sun,v));
    c=add3(c,scale3(v3(1.0f32,0.95f32,0.88f32),spec*pow(saturate(dot3(n,hv)),24.0f32)*lit));
    rim:f32=pow(1.0f32-saturate(dot3(n,v)),3.0f32);
    c=add3(c,scale3(v3(0.55f32,0.65f32,0.85f32),rim*0.25f32));
  }
  // the floor fades into the backdrop far off
  fog:f32=1.0f32-exp((-h.t)*0.035f32);
  return mix3(c,mhlab_sky(rd,sun),fog);
}

mhlab_scene_hit :: (eye:V3,rd:V3,h:MhlabHit,u:[]f32,figure:bool,lit_in:f32)->V3 {
  c:V3=mhlab_shade(eye,rd,h,u,figure,lit_in);
  // the skeleton overlay: the body as glass over what is behind it
  if ((u[4]>0.5f32)&&(h.m>0.5f32)) {
    back:MhlabHit=mhlab_trace(eye,rd,u,false,false);
    behind:V3=mhlab_shade(eye,rd,back,u,false,-1.0f32);
    c=mix3(behind,scale3(c,0.8f32),0.32f32);
  }
  return c;
}

// What a pixel shows on the screen: with a mesh, ACES filmic and the sRGB curve over linear light
// (the mesh's own look, as Unreal's); without one, the capsule bench's soft tone as before.
mhlab_out :: (c:V3,u:[]f32)->V3 {
  if (u[5]>0.5f32) {
    return v3(mhlab_srgb(mhlab_aces(c.x*u[385])),mhlab_srgb(mhlab_aces(c.y*u[385])),mhlab_srgb(mhlab_aces(c.z*u[385])));
  }
  return v3(verse_style_tone(c.x,1.2f32),verse_style_tone(c.y,1.2f32),verse_style_tone(c.z,1.2f32));
}
// The HUD's strip along the top and the key line's along the bottom: dark glass, so their text reads.
mhlab_strips :: (p:V2,c:V3,u:[]f32)->V3 {
  if ((p.y<u[6])||(p.y>(u[1]-u[7]))) { return add3(scale3(c,0.22f32),v3(0.01f32,0.012f32,0.016f32)); }
  return c;
}
// A traced point's depth in the mesh's depth buffer (mhlab_project's): z along the view, from
// MHLAB_NEAR to MHLAB_FAR; the backdrop is at the far plane.
MHLAB_NEAR :: 0.05f32;
MHLAB_FAR :: 400.0f32;
mhlab_depth :: (z:f32)->f32 {
  if (z<=MHLAB_NEAR) { return 0.0f32; }
  return fmin((MHLAB_FAR*(z-MHLAB_NEAR))/((MHLAB_FAR-MHLAB_NEAR)*z),1.0f32);
}
MhlabBg :: struct {c:V4; depth:f32 #depth; }
mhlab_bg_fs :: (pos:V4,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->MhlabBg {
  p:V2=v2(pos.x,pos.y);
  eye:V3=wg_at3(u,16);
  f:f32=fmax(u[19],1.0f32);
  fwd:V3=wg_at3(u,20);
  rd:V3=normalize3(add3(fwd,add3(scale3(wg_at3(u,24),(p.x-u[23])/f),scale3(wg_at3(u,28),(u[27]-p.y)/f))));
  mesh:bool=u[5]>0.5f32;
  // with a mesh the figure's capsules only cast its shadow: the mesh draws the figure itself
  h:MhlabHit=mhlab_trace(eye,rd,u,false,!mesh);
  // with a mesh the floor takes the figure's shadow from the mesh's own shadow map
  at:V3=add3(eye,scale3(rd,fmax(h.t,0.0f32)));
  mlit:f32=mhlab_lit(at,v3(0.0f32,1.0f32,0.0f32),u,shadow_map,shadow_cmp);
  lit_in:f32=-1.0f32;
  if (mesh&&(h.m>=0.0f32)&&(h.m<0.5f32)) { lit_in=mlit; }
  c:V3=mhlab_scene_hit(eye,rd,h,u,!mesh,lit_in);
  probe:f32=u[386];
  // the bench's colours are picked by eye on the screen: with a mesh they go back to linear light
  if (mesh) { c=scale3(v3(pow(fmax(c.x,0.0f32),2.2f32),pow(fmax(c.y,0.0f32),2.2f32),pow(fmax(c.z,0.0f32),2.2f32)),0.95f32); }
  depth:f32=1.0f32;
  if (h.m>=0.0f32) { depth=mhlab_depth(h.t*dot3(rd,fwd)); }
  c=mhlab_strips(p,mhlab_out(c,u),u);
  if (probe>0.5f32) {
    // a probe view: black, and on 3 magenta wherever a capsule of the figure would be drawn
    c=v3(0.0f32,0.0f32,0.0f32);
    if ((probe>2.5f32)&&(probe<3.5f32)&&(h.m>0.5f32)) { c=v3(1.0f32,0.0f32,1.0f32); }
  }
  return MhlabBg.{c=v4(c.x,c.y,c.z,1.0f32),depth=depth};
}
// ---- the mesh (a human pack, verse/tools/humans/pack_human.py): GPU skinning by four joints of
// the pose (metahumanlab.coax lab_palette: three rows of four per joint), drawn into the depth
// buffer bg_fs has written the floor into, lit by the key (with its shadow map), a fill, a rim
// and the sky. MhlabU's mesh rows (floats):
//   260: the figure's turn (cos, sin) and place (x, z)
//   264: the shadow's box: centre xyz, 1 / half its size; 268: its right; 272: its up; 276: toward the key, bias
//   280: 24 materials (rgb tint, roughness: the roughness map's scale), by material number less one
//   376: the fill's direction xyz, strength; 380: the rim's, strength; 384: the key's strength, exposure
//   386: the probe view (0: lit; 1: albedo, 2: uv and base layer, 3: capsules magenta, 4: material, 5:
//        material and base layer, and whether the face rig runs), for scripts that check a frame
//        without looking at it
//   388: the face rig's vertices: the first, how many, and 1 when it moves them. Their rows (a
//        move in metres and a normal word, metahumanlab.coax lab_face) follow the palette in the
//        pose store, from row MHLAB_FACE_ROW.
// A vertex, 8 words (pack_human.py vertex): x y (unorm16 each), z (unorm16) | material << 16 |
// the bitangent's sign << 31, the normal and the tangent (octahedral unorm16 pairs), uv (unorm16
// pair), four joints (u8), four weights (unorm8), the layers base | normal << 8 | rough << 16.
MHLAB_SPAN :: 2.5f32;
MHLAB_FACE_ROW :: 195;
MHLAB_LOW :: -0.25f32;
mhlab_octa :: (w:u32)->V3 {
  e:V2=wg_unpack2x16unorm(w);
  x:f32=(e.x*2.0f32)-1.0f32;
  y:f32=(e.y*2.0f32)-1.0f32;
  z:f32=(1.0f32-abs(x))-abs(y);
  if (z<0.0f32) {
    ox:f32=x;
    sx:f32=1.0f32; if (ox<0.0f32) { sx=-1.0f32; }
    sy:f32=1.0f32; if (y<0.0f32) { sy=-1.0f32; }
    x=(1.0f32-abs(y))*sx;
    y=(1.0f32-abs(ox))*sy;
  }
  return normalize3(v3(x,y,z));
}
mhlab_srgb :: (x:f32)->f32 {
  c:f32=saturate(x);
  if (c<=0.0031308f32) { return c*12.92f32; }
  return (1.055f32*pow(c,1.0f32/2.4f32))-0.055f32;
}
// ACES filmic (Narkowicz's fit), the curve Unreal's tonemapper is built on.
mhlab_aces :: (x:f32)->f32 {
  return saturate((x*((2.51f32*x)+0.03f32))/((x*((2.43f32*x)+0.59f32))+0.14f32));
}
// A figure-space point moved to the floor: the figure's turn about +y, then its place.
mhlab_place :: (p:V3,u:[]f32)->V3 {
  c:f32=u[260]; sn:f32=u[261];
  return v3((p.x*c)+(p.z*sn)+u[262],p.y,((-p.x)*sn)+(p.z*c)+u[263]);
}
mhlab_turn :: (n:V3,u:[]f32)->V3 {
  c:f32=u[260]; sn:f32=u[261];
  return v3((n.x*c)+(n.z*sn),n.y,((-n.x)*sn)+(n.z*c));
}
// The camera's projection of a world point, as bg_fs's rays: the eye's frame and focal length,
// depth along the view from MHLAB_NEAR to MHLAB_FAR.
mhlab_project :: (w:V3,u:[]f32)->V4 {
  rel:V3=sub3(w,wg_at3(u,16));
  z:f32=dot3(rel,wg_at3(u,20));
  x:f32=dot3(rel,wg_at3(u,24));
  y:f32=dot3(rel,wg_at3(u,28));
  f:f32=fmax(u[19],1.0f32);
  cx:f32=(((2.0f32*u[23])/u[0])-1.0f32)*z+((2.0f32*f*x)/u[0]);
  cy:f32=((1.0f32-((2.0f32*u[27])/u[1]))*z)+((2.0f32*f*y)/u[1]);
  cz:f32=(MHLAB_FAR*(z-MHLAB_NEAR))/(MHLAB_FAR-MHLAB_NEAR);
  return v4(cx,cy,cz,z);
}
// Where a world point falls in the key's shadow map: uv and depth.
mhlab_light :: (w:V3,u:[]f32)->V3 {
  rel:V3=sub3(w,wg_at3(u,264));
  k:f32=u[267];
  x:f32=dot3(rel,wg_at3(u,268))*k;
  y:f32=dot3(rel,wg_at3(u,272))*k;
  z:f32=0.5f32-(dot3(rel,wg_at3(u,276))*k*0.25f32);
  return v3(x,y,z);
}
MhlabSkin :: struct {p:V3; n:V3; t:V3; sign:f32; uv:V2; layers:u32; material:u32; }
mhlab_skin :: (id:u32,u:[]f32,vertices:[]u32,pose:[]V4)->MhlabSkin {
  b:u32=mul_wrap(id,8);
  xy:V2=wg_unpack2x16unorm(vertices[cast(int)b]);
  w1:u32=vertices[cast(int)add_wrap(b,1)];
  at:V4=v4((xy.x*MHLAB_SPAN)-(MHLAB_SPAN*0.5f32),(xy.y*MHLAB_SPAN)+MHLAB_LOW,((cast(f32)(w1&0xffff))/65535.0f32*MHLAB_SPAN)-(MHLAB_SPAN*0.5f32),1.0f32);
  nw:V3=mhlab_octa(vertices[cast(int)add_wrap(b,2)]);
  tw:V3=mhlab_octa(vertices[cast(int)add_wrap(b,3)]);
  // the face rig's move (blend shapes and the face joints, before the body's skinning) and normal
  fid:f32=cast(f32)(id)-u[388];
  if ((u[390]>0.5f32)&&(fid>=0.0f32)&&(fid<u[389])) {
    m:V4=pose[MHLAB_FACE_ROW+cast(int)(fid)];
    at=v4(at.x+m.x,at.y+m.y,at.z+m.z,1.0f32);
    if (m.w>0.5f32) {
      q:u32=cast(u32)(m.w-1.0f32);
      ex:f32=(cast(f32)(q>>12)/4095.0f32*2.0f32)-1.0f32;
      ey:f32=(cast(f32)(q&4095)/4095.0f32*2.0f32)-1.0f32;
      ez:f32=(1.0f32-abs(ex))-abs(ey);
      if (ez<0.0f32) {
        ox:f32=ex;
        sx:f32=1.0f32; if (ox<0.0f32) { sx=-1.0f32; }
        sy:f32=1.0f32; if (ey<0.0f32) { sy=-1.0f32; }
        ex=(1.0f32-abs(ey))*sx;
        ey=(1.0f32-abs(ox))*sy;
      }
      nw=normalize3(v3(ex,ey,ez));
      tw=normalize3(sub3(tw,scale3(nw,dot3(nw,tw))));
    }
  }
  j:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(b,5)]);
  wt:V4=wg_unpack4x8unorm(vertices[cast(int)add_wrap(b,6)]);
  o:MhlabSkin;
  o.p=v3(0.0f32,0.0f32,0.0f32); o.n=v3(0.0f32,0.0f32,0.0f32); o.t=v3(0.0f32,0.0f32,0.0f32);
  k:int=0;
  while k<4 {
    jk:f32=j.x; wk:f32=wt.x;
    if (k==1) { jk=j.y; wk=wt.y; }
    if (k==2) { jk=j.z; wk=wt.z; }
    if (k==3) { jk=j.w; wk=wt.w; }
    if (wk>0.0f32) {
      r:int=cast(int)((jk*255.0f32)+0.5f32)*3;
      a:V4=pose[r]; c:V4=pose[r+1]; e:V4=pose[r+2];
      o.p=add3(o.p,scale3(v3(dot4(a,at),dot4(c,at),dot4(e,at)),wk));
      o.n=add3(o.n,scale3(v3(dot3(v3(a.x,a.y,a.z),nw),dot3(v3(c.x,c.y,c.z),nw),dot3(v3(e.x,e.y,e.z),nw)),wk));
      o.t=add3(o.t,scale3(v3(dot3(v3(a.x,a.y,a.z),tw),dot3(v3(c.x,c.y,c.z),tw),dot3(v3(e.x,e.y,e.z),tw)),wk));
    }
    k+=1;
  }
  o.sign=1.0f32; if ((w1>>31)==1) { o.sign=-1.0f32; }
  o.uv=wg_unpack2x16unorm(vertices[cast(int)add_wrap(b,4)]);
  w7:u32=vertices[cast(int)add_wrap(b,7)];
  o.layers=w7&0xffffff;
  o.material=w7>>24;
  return o;
}
MhlabS :: struct {pos:V4; world:V3; normal:V3; tangent:V4; uv:V2; layers:u32 #flat; material:u32 #flat; }
// The traced floor reads the mesh's shadow map (bg_fs's group 2); a caster stage is how the host
// hands bg_fs that map. It casts nothing (the page exports no caster count): the mesh's shadow_vs
// fills the map.
mhlab_caster_vs :: (v:u32,i:u32,u:[]f32)->V4 {
  return v4(2.0f32,2.0f32,2.0f32,1.0f32);
}
mhlab_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,pose:[]V4)->MhlabS {
  v:MhlabSkin=mhlab_skin(id,u,vertices,pose);
  o:MhlabS;
  o.world=mhlab_place(v.p,u);
  o.normal=mhlab_turn(v.n,u);
  t:V3=mhlab_turn(v.t,u);
  o.tangent=v4(t.x,t.y,t.z,v.sign);
  o.uv=v.uv;
  o.layers=v.layers;
  o.material=v.material;
  o.pos=mhlab_project(o.world,u);
  return o;
}
MhlabShadow :: struct {pos:V4; uv:V2; layers:u32 #flat; material:u32 #flat; }
mhlab_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,pose:[]V4)->MhlabShadow {
  v:MhlabSkin=mhlab_skin(id,u,vertices,pose);
  q:V3=mhlab_light(mhlab_place(v.p,u),u);
  o:MhlabShadow;
  o.pos=v4(q.x,q.y,q.z,1.0f32);
  o.uv=v.uv; o.layers=v.layers; o.material=v.material;
  return o;
}
mhlab_shadow_fs :: (v:MhlabShadow,sheets:Tex2DArray,sheet:Sampler) {
  // the eyes' wet layer casts nothing
  if (v.material==7) { gpu_demote_helper(); }
}
// A layer's texel (255: none, the fallback colour instead).
// The uv's derivatives come from the top of scene_fs (uniform control flow), so a layer can be
// read under a branch.
mhlab_layer :: (sheets:Tex2DArray,sheet:Sampler,uv:V2,dx:V2,dy:V2,layer:u32,none:V4)->V4 {
  if (layer==255) { return none; }
  return render_sample_layer8_grad(sheets,sheet,uv,cast,trunc(s32)(layer),dx,dy,0.0f32);
}
// How much of the key reaches a world point: the shadow map's comparison, four bilinear taps
// round it (16 texels) blended.
mhlab_lit :: (w:V3,n:V3,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->f32 {
  q:V3=mhlab_light(add3(w,scale3(n,0.006f32)),u);
  uv:V2=v2((q.x*0.5f32)+0.5f32,0.5f32-(q.y*0.5f32));
  // outside the key's box (to its sides, or past its far side, as the floor far off) nothing casts
  if ((uv.x<0.0f32)||(uv.x>1.0f32)||(uv.y<0.0f32)||(uv.y>1.0f32)||(q.z>=0.999f32)||(q.z<=0.0f32)) { return 1.0f32; }
  texel:f32=1.0f32/cast(f32)gpu_depth_width(shadow_map);
  s:f32=0.0f32;
  s=s+gpu_compare(shadow_map,shadow_cmp,add2(uv,v2(-texel,-texel)),q.z-u[279]);
  s=s+gpu_compare(shadow_map,shadow_cmp,add2(uv,v2(texel,-texel)),q.z-u[279]);
  s=s+gpu_compare(shadow_map,shadow_cmp,add2(uv,v2(-texel,texel)),q.z-u[279]);
  s=s+gpu_compare(shadow_map,shadow_cmp,add2(uv,v2(texel,texel)),q.z-u[279]);
  return s*0.25f32;
}
// GGX: the normal distribution and the visibility term (Smith, height-correlated, Karis's fit).
mhlab_ggx :: (nh:f32,a:f32)->f32 {
  a2:f32=a*a;
  d:f32=((nh*nh)*(a2-1.0f32))+1.0f32;
  return a2/(3.14159265f32*d*d);
}
mhlab_vis :: (nl:f32,nv:f32,a:f32)->f32 {
  return 0.5f32/fmax((nl*(nv*(1.0f32-a)+a))+(nv*(nl*(1.0f32-a)+a)),0.0001f32);
}
// One light's share: diffuse (skin wraps and reddens where the light turns away, the scatter a
// pre-integrated skin BRDF gives), and specular (skin: two GGX lobes, as Unreal's dual specular).
// Hair (cards, material 3) is lit along its strands instead (Kajiya-Kay's two shifted
// highlights, as Marschner's R and TRT lobes: a white one toward the root and a dimmer one in the
// hair's own colour toward the tip).
mhlab_strand :: (t:V3,n:V3,h:V3,shift:f32,power:f32)->f32 {
  ts:V3=normalize3(add3(t,scale3(n,shift)));
  th:f32=dot3(ts,h);
  return pow(sqrt(fmax(1.0f32-(th*th),0.0f32)),power);
}
mhlab_light_one :: (n:V3,v:V3,l:V3,albedo:V3,rough:f32,material:u32,colour:V3,strand:V3)->V3 {
  nl:f32=dot3(n,l);
  nv:f32=fmax(dot3(n,v),0.001f32);
  diff:V3=scale3(albedo,saturate(nl)/3.14159265f32);
  if (material==1) {
    // scatter: red light wraps furthest round the terminator, blue least
    w:V3=v3(saturate((nl+0.42f32)/1.42f32),saturate((nl+0.18f32)/1.18f32),saturate((nl+0.1f32)/1.1f32));
    w=v3(w.x*w.x,w.y*w.y,w.z*w.z);
    diff=v3(albedo.x*w.x,albedo.y*w.y,albedo.z*w.z);
    diff=scale3(diff,1.0f32/3.14159265f32);
  }
  spec:f32=0.0f32;
  if (nl>0.0f32) {
    h:V3=normalize3(add3(l,v));
    nh:f32=saturate(dot3(n,h));
    vh:f32=saturate(dot3(v,h));
    f0:f32=0.04f32;
    if (material==1) { f0=0.028f32; }
    fr:f32=f0+((1.0f32-f0)*pow(1.0f32-vh,5.0f32));
    a:f32=fmax(rough*rough,0.002f32);
    lobe:f32=mhlab_ggx(nh,a)*mhlab_vis(nl,nv,a);
    if (material==1) {
      a2:f32=fmax((rough*1.4f32)*(rough*1.4f32),0.002f32);
      a1:f32=fmax((rough*0.75f32)*(rough*0.75f32),0.002f32);
      lobe=(0.85f32*mhlab_ggx(nh,a1)*mhlab_vis(nl,nv,a1))+(0.15f32*mhlab_ggx(nh,a2)*mhlab_vis(nl,nv,a2));
    }
    spec=fr*lobe*nl;
    if (material==3) {
      wrap:f32=saturate((nl*0.6f32)+0.4f32);
      r1:f32=mhlab_strand(strand,n,h,-0.08f32,90.0f32)*0.05f32;
      r2:f32=mhlab_strand(strand,n,h,0.12f32,24.0f32)*0.12f32;
      return v3(colour.x*((diff.x)+(r1+(r2*albedo.x))*wrap),colour.y*((diff.y)+(r1+(r2*albedo.y))*wrap),colour.z*((diff.z)+(r1+(r2*albedo.z))*wrap));
    }
  }
  return v3(colour.x*(diff.x+spec),colour.y*(diff.y+spec),colour.z*(diff.z+spec));
}
// The 4x4 Bayer threshold at a pixel, in (0, 1).
mhlab_bayer :: (x:int,y:int)->f32 {
  x0:int=x%2; x1:int=(x/2)%2; y0:int=y%2; y1:int=(y/2)%2;
  k:int=(((x0+y0)%2)*8)+(y0*4)+(((x1+y1)%2)*2)+y1;
  return (cast(f32)(k)+0.5f32)/16.0f32;
}
mhlab_scene_fs :: (s:MhlabS,front:bool,u:[]f32,sheets:Tex2DArray,sheet:Sampler,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  dx:V2=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));
  dy:V2=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));
  // the skeleton overlay: the body as stippled glass, so the bones read through it
  if ((u[4]>0.5f32)&&(((cast(int)(s.pos.x)+cast(int)(s.pos.y))%2)==0)) { gpu_demote_helper(); }
  m:u32=s.material;
  mat:V4=wg_at4(u,280+(cast(int)(clamp_u(m,1,24))-1)*4);
  base:V4=mhlab_layer(sheets,sheet,s.uv,dx,dy,s.layers&255,v4(1.0f32,1.0f32,1.0f32,1.0f32));
  // hair and brow cards: the faintest texels (a flyaway's thin edge) go, the solid ones stay, and
  // between the two an ordered 4x4 dither fades them (a stable, sort-free stand-in for alpha to
  // coverage: the same pixels every frame); everything else cuts at 0.35
  if ((m==3)||(m==4)) {
    if (base.w<(0.25f32+(0.5f32*mhlab_bayer(cast(int)(s.pos.x),cast(int)(s.pos.y))))) { gpu_demote_helper(); }
  } else if (m!=1) {
    if (base.w<0.35f32) { gpu_demote_helper(); }
  }
  // skin keeps its occlusion (cavities, the creases round the eyes and lips) in the base's alpha
  ao:f32=1.0f32;
  if (m==1) { ao=base.w; }
  albedo:V3=v3(base.x*mat.x,base.y*mat.y,base.z*mat.z);
  ng:V3=normalize3(s.normal);
  if (!front) { ng=scale3(ng,-1.0f32); }
  n:V3=ng;
  tg:V3=normalize3(sub3(v3(s.tangent.x,s.tangent.y,s.tangent.z),scale3(ng,dot3(ng,v3(s.tangent.x,s.tangent.y,s.tangent.z)))));
  strand:V3=scale3(cross3(ng,tg),s.tangent.w);
  // a hair card's own normal flips from card to card; the hair is lit as the head's shape instead,
  // its normal bent toward the way out from the head's middle
  if (m==3) {
    radial:V3=normalize3(sub3(s.world,wg_at3(u,40)));
    ng=normalize3(add3(scale3(ng,0.35f32),scale3(radial,0.65f32)));
  }
  nm:V4=mhlab_layer(sheets,sheet,s.uv,dx,dy,(s.layers>>8)&255,v4(0.5f32,0.5f32,1.0f32,1.0f32));
  if (((s.layers>>8)&255)!=255) {
    // the layer is sRGB-decoded on the way in; a normal map is raw numbers, so encode it back
    tn:V3=v3((mhlab_srgb(nm.x)*2.0f32)-1.0f32,(mhlab_srgb(nm.y)*2.0f32)-1.0f32,(mhlab_srgb(nm.z)*2.0f32)-1.0f32);
    t:V3=normalize3(sub3(v3(s.tangent.x,s.tangent.y,s.tangent.z),scale3(ng,dot3(ng,v3(s.tangent.x,s.tangent.y,s.tangent.z)))));
    bt:V3=scale3(cross3(ng,t),s.tangent.w);
    n=normalize3(add3(add3(scale3(t,tn.x),scale3(bt,tn.y)),scale3(ng,fmax(tn.z,0.05f32))));
  }
  rough:f32=1.0f32;
  if (((s.layers>>16)&255)!=255) {
    rough=mhlab_srgb(mhlab_layer(sheets,sheet,s.uv,dx,dy,(s.layers>>16)&255,v4(1.0f32,1.0f32,1.0f32,1.0f32)).y);
  }
  rough=clampf(rough*mat.w,0.04f32,1.0f32);
  v:V3=normalize3(sub3(wg_at3(u,16),s.world));
  key:V3=normalize3(wg_at3(u,276));
  sh:f32=mhlab_lit(s.world,ng,u,shadow_map,shadow_cmp);
  c:V3=mhlab_light_one(n,v,key,albedo,rough,m,scale3(v3(1.0f32,0.95f32,0.88f32),u[384]*sh),strand);
  c=add3(c,mhlab_light_one(n,v,normalize3(wg_at3(u,376)),albedo,rough,m,scale3(v3(0.75f32,0.82f32,1.0f32),u[379]),strand));
  c=add3(c,mhlab_light_one(n,v,normalize3(wg_at3(u,380)),albedo,rough,m,scale3(v3(0.9f32,0.95f32,1.0f32),u[383]),strand));
  // the studio's light all round (its sky above, the floor's bounce below, as a low-order
  // spherical-harmonics irradiance would give), the cavities darker
  sky:f32=(0.5f32+(0.5f32*n.y));
  amb:V3=add3(scale3(v3(0.36f32,0.4f32,0.48f32),sky*0.55f32),scale3(v3(0.22f32,0.2f32,0.18f32),(1.0f32-sky)*0.35f32));
  amb=add3(amb,scale3(v3(0.05f32,0.045f32,0.04f32),saturate(dot3(n,normalize3(wg_at3(u,276))))));
  c=add3(c,scale3(v3(albedo.x*amb.x,albedo.y*amb.y,albedo.z*amb.z),ao));
  // and its reflection: the sky's colour off the surface, by Fresnel and how smooth it is
  if ((m!=3)&&(m!=4)) {
    rr:V3=reflect3(scale3(v,-1.0f32),n);
    nv0:f32=saturate(dot3(n,v));
    f0s:f32=0.04f32; if (m==1) { f0s=0.028f32; }
    fs:f32=f0s+((1.0f32-f0s)*pow(1.0f32-nv0,5.0f32)*(1.0f32-rough));
    env:V3=mix3(v3(0.2f32,0.19f32,0.18f32),v3(0.4f32,0.44f32,0.52f32),saturate((rr.y*0.5f32)+0.5f32));
    c=add3(c,scale3(env,fs*(1.0f32-(rough*rough))*ao*0.6f32));
  }
  // cloth: a soft sheen where the weave turns from the eye
  if (m>=8) {
    sheen:f32=pow(1.0f32-saturate(dot3(n,v)),3.0f32)*0.22f32;
    c=add3(c,scale3(v3(0.4f32+albedo.x,0.4f32+albedo.y,0.4f32+albedo.z),sheen*(0.35f32+(0.65f32*sh))));
  }
  // the eye's wet gloss: the sky's reflection on the cornea
  if (m==2) {
    // the cornea over it: a mirror-smooth coat on the eye's own shape (ng, not the iris's map) that
    // shows the sky and a sharp glint of each light; the eye darkens toward its rim (the lids' shade)
    r:V3=reflect3(scale3(v,-1.0f32),ng);
    fr:f32=0.02f32+(0.98f32*pow(1.0f32-saturate(dot3(ng,v)),5.0f32));
    c=add3(c,scale3(v3(0.55f32,0.6f32,0.68f32),fr*(0.4f32+(0.6f32*saturate(r.y)))));
    hk:V3=normalize3(add3(key,v));
    glint:f32=mhlab_ggx(saturate(dot3(ng,hk)),0.02f32)*0.0025f32*sh;
    c=add3(c,scale3(v3(1.0f32,0.96f32,0.9f32),glint*u[384]));
  }
  c=mhlab_out(c,u);
  c=mhlab_strips(v2(s.pos.x,s.pos.y),c,u);
  // the probe views a script reads: the albedo as the screen's sRGB, or uv and the base layer
  if ((u[386]>0.5f32)&&(u[386]<1.5f32)) { c=v3(mhlab_srgb(albedo.x),mhlab_srgb(albedo.y),mhlab_srgb(albedo.z)); }
  if ((u[386]>1.5f32)&&(u[386]<2.5f32)) { c=v3(fract(s.uv.x),fract(s.uv.y),cast(f32)(s.layers&255)/255.0f32); }
  if ((u[386]>2.5f32)&&(u[386]<3.5f32)) { c=v3(0.0f32,0.0f32,0.0f32); }
  // 4: the material's number, so a script can see which pieces take the skin's scatter; 5: the
  // material and the base layer together (one frame, so they can't drift apart between shots)
  if (u[386]>3.5f32) { c=v3(cast(f32)(m)/255.0f32,0.0f32,0.0f32); }
  if (u[386]>4.5f32) { c=v3(cast(f32)(m)/255.0f32,cast(f32)(s.layers&255)/255.0f32,saturate(u[390])); }
  return v4(c.x,c.y,c.z,1.0f32);
}
clamp_u :: (x:u32,a:u32,b:u32)->u32 {
  if (x<a) { return a; }
  if (x>b) { return b; }
  return x;
}
MhlabV :: struct {pos:V4; place:V2; shape:V4; tint:V4; bar:V4; }
mhlab_fx_vs_in :: struct {a:V4; b:V4; c:V4; d:V4; }
mhlab_fx_vs :: (_vid2:u32,_iid3:u32,in_:mhlab_fx_vs_in,u:[]f32)->MhlabV {
  a:V4=in_.a;
  o:MhlabV;
  o.pos=v4(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=in_.b;
  o.tint=in_.c;
  o.bar=in_.d;
  return o;
}
// A capsule stroke: shape.x its length, y its core's half width, z its light, w its glow's reach.
mhlab_fx_fs :: (v:MhlabV,u:[]f32)->V4 {
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  g:f32=d/fmax(v.shape.w,1.0f32);
  halo:f32=exp(((-5.0f32)*g)*g)*0.28f32;
  return mhlab_make_f4_f3f(scale3(scale3(scale3(v3(v.tint.x,v.tint.y,v.tint.z),(core+halo)),v.shape.z),u[3]),1.0f32);
}

mhlab_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
