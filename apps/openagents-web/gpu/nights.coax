// Shared engine lighting only. Every scene texture is supplied by the NWN pack.
#load "../../../everglade/scene/gpu/charactercreator.coax";
nights_bg_vs :: (id:u32,instance:u32)->V4 {return charactercreator_bg_vs(id,instance);}
nights_bg_fs :: (pos:V4,u:[]f32,frame:[]f32)->CharacterCreatorBg {return charactercreator_bg_fs(pos,u,frame);}
nights_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4,mats:[]V4)->FivelabS {
 s:=charactercreator_scene_vs(id,instance,u,vertices,objects,bake,mats);m:=objects[cast(int)instance];if (m.d.w>17.5f32 && m.d.w<18.5f32) {s.slice+=u32(m.d.y);}return s;
}
// Only explicitly marked native forest floors use the new material. The
// existing shared environment lighting, shadows and MRT encoding stay intact.
// `tiled`: the vertex's surface record is a tiled one (CM_S_TILED, the glade's bark id the native pieces
// carry, everglade/scene/surfaces.coax), and its marker says which native material it is.
nights_ground_active :: (tiled:bool,marker:f32,enabled:f32)->bool {return tiled && marker>7000.5f32 && marker<7001.5f32 && enabled>0.5f32;}
// Installed PLC_K09.mdl (models_02.bif, resource4515, SHA1497a43172b9...)
// Line20/21/22 diffuse is (0.368627,0.478431,0.211765). Normalize this
// actual native grass material after the same display-to-linear transfer as
// source vertex tints, then normalize its Rec.709 luma without darkening the
// source floor. Both the sampled texture and this material gain are linear.
nights_ground_grass_colour :: (sample:V3)->V3 {
 native:=cg_decode(v3(0.36862701177597046f32,0.47843098640441895f32,0.21176500618457794f32));return mul3(sample,scale3(native,1.0f32/metaverse_style_luma(native.x,native.y,native.z)));
}
#test "Nights ground borrows native grass diffuse while preserving neutral-sample luminance" {
 c:=nights_ground_grass_colour(v3(0.5,0.5,0.5));#assert c.y>c.x && c.x>c.z;
 #assert abs(metaverse_style_luma(c.x,c.y,c.z)-0.5)<0.00001;
 #assert c.x/0.5f32<0.75 && c.y/0.5f32>1.15 && c.z/0.5f32<0.3;
 #assert nights_ground_grass_colour(v3(0,0,0)).y==0;
}
#test "Nights spring material grade is local bounded lighter and preserves flower hue" {
 original:=v3(0.035,0.05,0.012);grass:=nights_spring_green(original,7002);earth:=nights_spring_earth(v3(0.06,0.045,0.02));
 #assert metaverse_style_luma(grass.x,grass.y,grass.z)>0.075 && grass.y>grass.x && grass.z>original.z;
 #assert earth.x>0.14 && earth.y>0.13 && earth.z>0.09;
 #assert nights_flora_active(true,7004) && !nights_flora_active(true,0) && !nights_flora_active(false,7004) && !nights_flora_active(true,7001);
 purple:=v3(0.6,0.2,0.9);flower:=nights_spring_flower(purple);#assert flower.z>flower.x && flower.x>flower.y && flower.z<=1;#assert abs(flower.x/flower.z-purple.x/purple.z)<0.00001;
}
nights_flora_active :: (tiled:bool,marker:f32)->bool {return tiled && marker>7001.5f32 && marker<7006.5f32;}
nights_spring_green :: (sample:V3,marker:f32)->V3 {
 y:=fmax(metaverse_style_luma(sample.x,sample.y,sample.z),0.002f32);tone:=(ifx marker<7001.5f32 then 0.015f32 else 0.01f32)+0.36f32*sqrt(y);palette:=ifx marker>7003.5f32 then v3(0.72f32,1.20f32,0.35f32) else v3(0.60f32,1.24f32,0.40f32);palette=scale3(palette,1.0f32/metaverse_style_luma(palette.x,palette.y,palette.z));hue:=mix3(scale3(sample,1.0f32/y),palette,0.40f32);return v3(clampf(hue.x*tone,0,0.85),clampf(hue.y*tone,0,0.85),clampf(hue.z*tone,0,0.85));
}
nights_spring_earth :: (sample:V3)->V3 {
 y:=fmax(metaverse_style_luma(sample.x,sample.y,sample.z),0.002f32);tone:=0.05f32+0.45f32*sqrt(y);cream:=v3(1.08f32,1.03f32,0.78f32);cream=scale3(cream,1.0f32/metaverse_style_luma(cream.x,cream.y,cream.z));return scale3(mix3(scale3(sample,1.0f32/y),cream,0.70f32),tone);
}
nights_spring_flower :: (sample:V3)->V3 {peak:=fmax(sample.x,fmax(sample.y,sample.z));gain:=ifx peak>0.6666667f32 then 1.0f32/peak else 1.5f32;return scale3(sample,gain);}
#test "Nights spring native grass roots retain depth without shading flowers or fern" {
 #assert abs(nights_grass_root_shade(7002,0)-0.65)<0.00001 && nights_grass_root_shade(7002,0.55)==1;
 #assert nights_grass_root_shade(7003,0)==1 && nights_grass_root_shade(7005,0)==1;
}
nights_grass_root_shade :: (marker:f32,y:f32)->f32 {return ifx marker>7001.5f32 && marker<7002.5f32 then 0.65f32+0.35f32*smoothstep(0.03f32,0.55f32,y) else 1.0f32;}
nights_ground_uv :: (x:f32,z:f32,metres:f32)->V2 {return v2(x/metres,z/metres);}
nights_ground_earth :: (x:f32,z:f32)->f32 {
 center:=sin(z*0.13f32)*0.35f32+sin(z*0.043f32)*0.25f32;trail:=1.0f32-smoothstep(0.8f32,1.6f32,abs(x-center));clearing:=1.0f32-smoothstep(2.0f32,3.2f32,sqrt(x*x+(z+10.0f32)*(z+10.0f32)));path:=fmax(trail,clearing);quiet:=0.025f32+0.02f32*sin(x*0.37f32+z*0.23f32)*sin(z*0.31f32);return quiet+(0.85f32-quiet)*path;
}
#test "Nights ground filtering is explicitly scoped and its native material mask stays quiet" {
 #assert nights_ground_active(true,7001,1) && !nights_ground_active(true,0,1) && !nights_ground_active(false,7001,1) && !nights_ground_active(true,7001,0);
 #assert abs(nights_ground_uv(1.6,3.2,1.6).x-1)<0.00001;
 #assert nights_ground_earth(0,-10)>0.8 && nights_ground_earth(12,20)<=0.05;
 #assert nights_ground_earth(3,-10)<0.1 && nights_ground_earth(2,20)<=0.05;
 for i:0..<40 {v:=nights_ground_earth(f32(i)-20,f32(i)*2-20);#assert v>=0 && v<=0.85f32;}
}
// Native textured crown cards keep their outward reconstructed volume normal
// on both faces. The shared tiled surface would flip it and treat the leaf as solid.
nights_canopy_active :: (tiled:bool,marker:f32)->bool {return tiled && marker>7005.5f32 && marker<7006.5f32;}
nights_canopy_wrap :: (ndl:f32)->f32 {return saturate((ndl+0.60f32)/1.60f32);}
nights_canopy_light :: (s:FivelabS,albedo:V3,u:[]f32,shadow:f32)->V4 {
 n:=normalize3(add3(s.normal,v3(0,0.0001f32,0)));sun:=cg_sun_dir(paint_env_of(u));eye:=wg_at3(u,16);view:=normalize3(sub3(eye,s.world));ndl:=dot3(n,sun);visibility:=shadow*cg_cloud(paint_env_of(u),s.world.x,s.world.z);
 indirect:=mul3(albedo,scale3(cg_hemisphere(paint_env_of(u),n),1.10f32));direct:=cg_irradiance(paint_env_of(u),n,nights_canopy_wrap(ndl),0,visibility);
 back:=pow(saturate(dot3(scale3(sun,-1),view)),2.0f32);transmission:=0.18f32*back*(1.0f32-abs(ndl))*visibility;
 colour:=add3(indirect,mul3(albedo,add3(direct,scale3(cg_sun_colour(paint_env_of(u)),transmission))));colour=cg_atmosphere(paint_env_of(u),colour,eye,s.world);
 share:=saturate(metaverse_style_luma(indirect.x,indirect.y,indirect.z)*exp(-cg_air_depth(paint_env_of(u),eye,s.world))/fmax(metaverse_style_luma(colour.x,colour.y,colour.z),0.00001f32));return v4(colour.x,colour.y,colour.z,share);
}
#test "Nights crown lighting wraps through thin leaves without affecting solid materials" {
 #assert nights_canopy_active(true,7006) && !nights_canopy_active(true,7004) && !nights_canopy_active(false,7006) && !nights_canopy_active(true,0);
 #assert nights_canopy_wrap(-1)==0 && nights_canopy_wrap(1)==1 && nights_canopy_wrap(-0.3)>0 && nights_canopy_wrap(0)>0.3;
 u:[316]f32;words:=env_gpu_pack(env_profile_sample(env_glade_profile(),0.5));for i:0..<108 {u[208+i]=words[i];}u[16]=0;u[17]=2;u[18]=5;
 s:=FivelabS.{normal=v3(0.5,0.5,0.7071068),world=v3(0,2,0)};a:=nights_canopy_light(s,v3(0.1,0.2,0.05),u[..],1);b:=nights_canopy_light(s,v3(0.1,0.2,0.05),u[..],0);
 #assert a.y>b.y && b.y>0 && a.w>=0 && a.w<=1 && b.w>=0 && b.w<=1;
}
nights_scene_fs :: (s:FivelabS,front:bool,u:[]f32,objects:[]FivelabObj,mats:[]V4,sheets:Tex2DArray,sheet:Sampler,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->CharacterCreatorLit {
 uv:=s.uv;ray:=add3(wg_at3(u,20),add3(scale3(wg_at3(u,24),(s.pos.x-u[23])/u[19]),scale3(wg_at3(u,28),(u[27]-s.pos.y)/u[19])));plate:=cg_sky_uv(ray);
 env:=s.dye.w>11.5f32;r:=e2_surface(s,mats);sky:=e2_sky(s,mats);tiled:=env && e2_surf_is(r,cmat.CM_S_TILED);
 if sky {uv=v2(clampf(plate.x,0.001f32,0.999f32),clampf(plate.y,0.001f32,0.999f32));}
 if (env && e2_village(r,s.local.y)) {uv=cg_village_uv(uv,s.local.y);}
 // Derivatives are taken before the material branch; repeated ground UVs
 // remain continuous world coordinates, never fract() of the footprint.
 dx:=v2(gpu_dpdx_fine(uv.x),gpu_dpdx_fine(uv.y));dy:=v2(gpu_dpdy_fine(uv.x),gpu_dpdy_fine(uv.y));repeat:=ifx u[106]>=0.5f32 then u[106] else 1.6f32;
 guv:=nights_ground_uv(s.world.x,s.world.z,repeat);gdx:=v2(gpu_dpdx_fine(guv.x),gpu_dpdx_fine(guv.y));gdy:=v2(gpu_dpdy_fine(guv.x),gpu_dpdy_fine(guv.y));ground:=nights_ground_active(tiled,s.local.y,u[107]);canopy:=nights_canopy_active(tiled,s.local.y);
 tex:=render_sample_layer8_grad(sheets,sheet,ifx ground then guv else uv,ifx ground then s32(u[104]) else s32(s.slice),ifx ground then gdx else dx,ifx ground then gdy else dy,ifx ground || canopy then 0.0f32 else 1.0f32);
 if ground {grass:=nights_spring_green(nights_ground_grass_colour(v3(tex.x,tex.y,tex.z)),7001);tex=v4(grass.x,grass.y,grass.z,tex.w);earth:=render_sample_layer8_grad(sheets,sheet,v2(guv.x+11.375f32,guv.y-7.125f32),s32(u[105]),gdx,gdy,0);earth_colour:=nights_spring_earth(v3(earth.x,earth.y,earth.z));earth=v4(earth_colour.x,earth_colour.y,earth_colour.z,earth.w);share:=nights_ground_earth(s.world.x,s.world.z);tex=v4(tex.x+(earth.x-tex.x)*share,tex.y+(earth.y-tex.y)*share,tex.z+(earth.z-tex.z)*share,1);}
 if sky {
  plate_sky:=mix3(cg_decode(cg_sky(paint_env_of(u),normalize3(ray),wg_at3(u,32),u[2])),v3(tex.x,tex.y,tex.z),cg_sky_plate_weight(plate));tex=v4(plate_sky.x,plate_sky.y,plate_sky.z,1);
 }
 if (tex.w<0.35f32) {gpu_demote_helper();}
 graded:=s;if nights_flora_active(tiled,s.local.y) {tint:=cg_decode(s.tint);gain:=scale3(tint,1.0f32/fmax(metaverse_style_luma(tint.x,tint.y,tint.z),0.02f32));albedo:=mul3(v3(tex.x,tex.y,tex.z),gain);albedo=ifx s.local.y>7004.5f32 && s.local.y<7005.5f32 then nights_spring_flower(albedo) else nights_spring_green(albedo,s.local.y);albedo=scale3(albedo,nights_grass_root_shade(s.local.y,s.world.y));tex=v4(albedo.x,albedo.y,albedo.z,tex.w);graded.tint=v3(1,1,1);}
 c:V4;
 if canopy {c=nights_canopy_light(graded,v3(tex.x,tex.y,tex.z),u,cg_shadow_visibility(s.world,s.normal,u,shadow_map,shadow_cmp));}
 else if env {c=cg_environment_fs(graded,tex,front,u,cg_shadow_visibility(s.world,s.normal,u,shadow_map,shadow_cmp),mats);}
 else {c=cc_player_fs(s,tex,front,u,objects,cg_shadow_visibility(s.world,s.normal,u,shadow_map,shadow_cmp),mats);}
 n:=normalize3(s.normal);z:=dot3(sub3(s.world,wg_at3(u,16)),wg_at3(u,20));
 foliage:=canopy || (env && !sky && e2_surf_is(r,cmat.CM_S_FOLIAGE));
 indirect:=c.w;packed:=cg_normal_pack(n);
 c.w=ifx sky then 0.0f32 else ifx foliage then 0.4f32 else 0.12f32;
 return CharacterCreatorLit.{c=c,aux=v4(packed.x,packed.y,indirect,ifx sky then 0.0f32 else ifx foliage then -z else z)};
}
nights_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]FivelabObj,bake:[]V4,mats:[]V4)->CgShadow {s:=charactercreator_shadow_vs(id,instance,u,vertices,objects,bake,mats);m:=objects[cast(int)instance];if (m.d.w>17.5f32 && m.d.w<18.5f32) {s.slice+=u32(m.d.y);}return s;}
nights_shadow_fs :: (s:CgShadow,sheets:Tex2DArray,sheet:Sampler) {charactercreator_shadow_fs(s,sheets,sheet);}
NightsUIIn ::struct {a:V4;b:V4;c:V4;d:V4;}
NightsUIVertex ::struct {pos:V4;uv:V2;layer:u32 #flat;tint:V4;}
nights_fx_vs :: (id:u32,instance:u32,in_:NightsUIIn,u:[]f32)->NightsUIVertex {
 return NightsUIVertex.{pos=v4(in_.a.x/u[0]*2.0f32-1.0f32,1.0f32-in_.a.y/u[1]*2.0f32,0,1),uv=v2(in_.a.z,in_.a.w),layer=u32(in_.b.x),tint=in_.c};
}
nights_fx_fs :: (s:NightsUIVertex,sheets:Tex2DArray,sheet:Sampler)->V4 {
 tex:=render_sample_layer8_bias(sheets,sheet,s.uv,s32(s.layer),0);rgb:=cg_encode(v3(tex.x,tex.y,tex.z));return v4(rgb.x*s.tint.x,rgb.y*s.tint.y,rgb.z*s.tint.z,tex.w*s.tint.w);
}
nights_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {return charactercreator_bloom_fs(pos,bloom_src,bloom_lin,bloom_step);}
nights_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {return charactercreator_post_fs(pos,u,post_light,post_quarter,post_eighth,post_aux,post_depth,post_lin);}

#test "Nights native canopy is distinct from ground litter grass flowers and actors" {
 #assert nights_flora_active(true,7006);
 #assert !nights_flora_active(true,0) && !nights_flora_active(false,7006);
}
