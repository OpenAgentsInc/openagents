// Original source Link with eight influences and semantic BNTX maps, in a shared-controller forest.
#load "splash.coax";
#load "../../../aethyr/render/sampling.coax";
#load "../../../verse/ocarina/forest.coax";
OgVertex :: struct {p:V3;n:V3;uv:V2;uv1:V2;t:V4;colour:V4;material:f32;character:f32;}
OgSurface :: struct {pos:V4;world:V3;normal:V3;uv:V2;uv1:V2;tangent:V4;colour:V4;material:f32;character:f32;}
OgShadow :: struct {pos:V4;uv:V2;uv1:V2;material:f32;character:f32;}
OgFoot :: struct {dx:V2;dy:V2;}
og_grad :: (uv:V2)->OgFoot {return OgFoot.{dx=v2(gpu_dpdx_fine(uv.x),gpu_dpdx_fine(uv.y)),dy=v2(gpu_dpdy_fine(uv.x),gpu_dpdy_fine(uv.y))};}
og_foot_scale :: (g:OgFoot,f:f32)->OgFoot {return OgFoot.{dx=v2(g.dx.x*f,g.dx.y*f),dy=v2(g.dy.x*f,g.dy.y*f)};}
OgHud :: struct {a:V4;b:V4;c:V4;}
og_at :: (u:[]f32,i:int)->V3 {return v3(u[i],u[i+1],u[i+2]);}
og_word :: (v:[]u32,i:int)->f32 {return f32_from_bits(v[i]);}
og_point :: (v:[]u32,i:int)->V3 {return v3(og_word(v,i),og_word(v,i+1),og_word(v,i+2));}
og_yaw :: (v:V3,yaw:f32)->V3 {c:=cos(yaw);s:=sin(yaw);return v3(c*v.x+s*v.z,v.y,-s*v.x+c*v.z);}
og_hash :: (n:f32)->f32 {return fract(sin(n*127.1)*43758.5453);}
og_sphere :: (id:int)->V3 {quad:=id/6;k:=id%6;dx:=ifx k==2 || k==3 || k==5 then 1 else 0;dy:=ifx k==1 || k==4 || k==5 then 1 else 0;a:=cast(f32)(quad%8+dx)*0.7853981634;b:=cast(f32)(quad/8+dy)*0.7853981634;return v3(sin(b)*cos(a),cos(b),sin(b)*sin(a));}
og_forest :: (id:int,time:f32)->OgVertex {
 o:=OgVertex.{n=v3(0,1,0),colour=v4(1,1,1,1),t=v4(1,0,0,1),material=34};k:=id;
 if k<6 {x:=ifx k==2 || k==3 || k==5 then 60.0f32 else -60.0f32;z:=ifx k==1 || k==4 || k==5 then 60.0f32 else -60.0f32;o.p=v3(x,0,z);o.uv=v2(x*0.2,z*0.2);return o;}k-=6;
 if k<OC_TREES*OC_TREE_VERTICES {tree:=oc_tree(k/OC_TREE_VERTICES);n:=k%OC_TREE_VERTICES;
  if n<60 {segment:=n/6;corner:=n%6;up:=ifx corner==1 || corner==4 || corner==5 then 1.0f32 else 0.0f32;side:=ifx corner==2 || corner==3 || corner==5 then 1 else 0;angle:=cast(f32)(segment+side)*0.62831853;r:=tree.radius*(1-up*0.65);o.p=v3(tree.x+cos(angle)*r,up*tree.height*0.78,tree.z+sin(angle)*r);o.n=v3(cos(angle),0.05,sin(angle));o.uv=v2(angle,up*6);o.material=32;return o;}
  n-=60;if n<144 {branch:=n/48;segment:=(n%48)/6;corner:=n%6;up:=ifx corner==1 || corner==4 || corner==5 then 1.0f32 else 0.0f32;side:=ifx corner==2 || corner==3 || corner==5 then 1 else 0;a:=cast(f32)(segment+side)*0.7853981634;angle:=cast(f32)branch*2.094+tree.x;out:=up*2.8;r:=tree.radius*(1-up*0.8)*0.6;o.p=v3(tree.x+sin(angle)*out+cos(a)*r,tree.height*0.52+up*2.4+sin(a)*r,tree.z+cos(angle)*out);o.n=v3(cos(a),0.2,sin(a));o.material=32;return o;}
  n-=144;cluster:=n/192;q:=og_sphere(n%192);angle:=cast(f32)cluster*2.4+tree.z;r:=ifx cluster==0 then 3.4f32 else 2.6f32;center:=v3(tree.x+sin(angle)*1.6,tree.height+(ifx cluster==0 then 0.2f32 else sin(angle)*1.4),tree.z+cos(angle)*1.5);o.p=add3(center,v3(q.x*r,q.y*r*0.65,q.z*r));o.p.x+=sin(time*0.7+tree.x)*0.07*(q.y+1);o.n=normalize3(v3(q.x,q.y*1.5,q.z));o.colour=v4(0.17+og_hash(tree.x+cast(f32)cluster)*0.1,0.30+og_hash(tree.z)*0.2,0.065,1);o.material=33;return o;
 }k-=OC_TREES*OC_TREE_VERTICES;
 if k<OC_GRASS*18 {clump:=k/18;blade:=(k%18)/3;tip:=k%3;x:=(og_hash(cast(f32)clump*3.7)*2-1)*27;z:=(og_hash(cast(f32)clump*7.1+3)*2-1)*22;if abs(x-oc_path(z))<2 {x+=4;}a:=cast(f32)blade*1.05;h:=0.18+og_hash(cast(f32)clump)*0.3;side:=ifx tip==0 then -0.035f32 else ifx tip==1 then 0.035f32 else 0.0f32;o.p=v3(x+cos(a)*side,(ifx tip==2 then h else 0.01f32),z+sin(a)*side);if tip==2 {o.p.x+=sin(time*1.4+x+z)*h*0.2;}o.n=v3(sin(a)*0.3,0.7,cos(a)*0.3);o.colour=v4(0.16,0.3+og_hash(x+z)*0.2,0.045,1);o.material=35;return o;}k-=OC_GRASS*18;
 if k<OC_ROCKS*192 {r:=oc_rock(k/192);q:=og_sphere(k%192);o.p=v3(r.x+q.x*r.radius,q.y*r.height+r.height*0.6,r.z+q.z*r.radius);o.n=normalize3(v3(q.x,q.y*1.5,q.z));o.colour=v4(0.16,0.21,0.15,1);o.material=36;return o;}k-=OC_ROCKS*192;
 fern:=k/288;local:=k%288;frond:=local/36;leaf:=(local%36)/6;corner:=local%6;x:=og_hash(cast(f32)fern*5.2)*48-24;z:=og_hash(cast(f32)fern*9.1)*40-20;if abs(x-oc_path(z))<2 {x+=4;}angle:=cast(f32)frond*0.78539816;reach:=cast(f32)(leaf+1)*0.11;lr:=ifx corner==0 || corner==5 then -1.0f32 else ifx corner==2 || corner==3 then 1.0f32 else 0.0f32;along:=ifx corner==1 then 1.0f32 else ifx corner==4 then -1.0f32 else 0.0f32;o.p=v3(x+sin(angle)*(reach+along*0.07)+cos(angle)*lr*0.12,0.1+sin(reach*2.3)*0.65,z+cos(angle)*(reach+along*0.07)-sin(angle)*lr*0.12);o.n=v3(0.1,1,0.1);o.colour=v4(0.06,0.27,0.09,1);o.material=35;return o;
}
og_skin :: (value:V4,at:int,v:[]u32,bones:[]f32)->V3 {sum:f32=0;out:V3;for k:0..<8 {joint:=cast(int)((v[at+9+k/2]>>cast(u32)(k%2*16))&65535);weight:=cast(f32)((v[at+13+k/4]>>cast(u32)(k%4*8))&255);if weight>0 {b:=joint*12;out=add3(out,scale3(v3(dot4(wg_at4(bones,b),value),dot4(wg_at4(bones,b+4),value),dot4(wg_at4(bones,b+8),value)),weight));sum+=weight;}}return scale3(out,1/fmax(sum,1.0f32));}
og_vertex :: (id:u32,u:[]f32,v:[]u32,bones:[]f32)->OgVertex {
 if id>=v[2] {return og_forest(cast(int)(id-v[2]),u[48]);}at:=cast(int)v[4]+cast(int)id*32;p:=og_point(v,at);normal:=og_point(v,at+3);t:=og_point(v,at+15);posed:=og_skin(v4(p.x,p.y,p.z,1),at,v,bones);n:=og_skin(v4(normal.x,normal.y,normal.z,0),at,v,bones);tangent:=og_skin(v4(t.x,t.y,t.z,0),at,v,bones);yaw:=u[27];return OgVertex.{p=add3(og_yaw(posed,yaw),og_at(u,24)),n=og_yaw(n,yaw),uv=v2(og_word(v,at+6),og_word(v,at+7)),uv1=v2(og_word(v,at+20),og_word(v,at+21)),t=v4(og_yaw(tangent,yaw).x,og_yaw(tangent,yaw).y,og_yaw(tangent,yaw).z,og_word(v,at+18)),colour=wg_unpack4x8unorm(v[at+19]),material=cast(f32)v[at+8],character=1};
}
og_shadow_point :: (p:V3,u:[]f32)->V3 {r:=sub3(p,og_at(u,44));return v3(dot3(r,og_at(u,32))/u[47],dot3(r,og_at(u,36))/u[47],0.5-dot3(r,og_at(u,40))/(u[47]*2));}
og_bg_vs :: (id:u32,instance:u32)->V4 {return splash_bg_vs(id,instance);}
og_bg_fs :: (p:V4,u:[]f32)->V4 {t:=p.y/u[1];return v4(0.045+(1-t)*0.08,0.11+(1-t)*0.08,0.115+(1-t)*0.08,1);}
og_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->OgSurface {v:=og_vertex(id,u,vertices,bones);r:=sub3(v.p,og_at(u,8));z:=dot3(r,og_at(u,20));return OgSurface.{pos=v4(dot3(r,og_at(u,12))*u[15],dot3(r,og_at(u,16))*u[19],160.0/159.95*(z-0.05),z),world=v.p,normal=v.n,uv=v.uv,uv1=v.uv1,tangent=v.t,colour=v.colour,material=v.material,character=v.character};}
og_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->OgShadow {v:=og_vertex(id,u,vertices,bones);q:=og_shadow_point(v.p,u);return OgShadow.{pos=v4(q.x,q.y,q.z,1),uv=v.uv,uv1=v.uv1,material=v.material,character=v.character};}
og_sample :: (layer:u32,uv:V2,sheets:Tex2DArray,sheet:Sampler,g:OgFoot)->V4 {if layer==0 {return v4(1,1,1,1);}return render_sample_layer8_grad(sheets,sheet,uv,cast(s32)(layer-1),g.dx,g.dy,0);}
og_raw :: (x:f32)->f32 {return ifx x<=0.0031308 then x*12.92 else 1.055*pow(x,1.0f32/2.4f32)-0.055;}
og_linear :: (x:f32)->f32 {return ifx x<=0.04045 then x/12.92 else pow((x+0.055)/1.055,2.4f32);}
og_coverage :: (uv:V2,uv1:V2,material:f32,v:[]u32,sheets:Tex2DArray,sheet:Sampler,g0:OgFoot,g1:OgFoot)->f32 {g:=g0;m:=cast(int)v[5]+cast(int)material*64;kind:=v[m+16];a:=og_sample(v[m],uv,sheets,sheet,g);if kind==1 {mask:=og_sample(v[m+5],uv1,sheets,sheet,g1);return a.w*og_raw(mask.x);}if kind==5 {return og_raw(a.x);}return a.w;}
og_shadow_fs :: (s:OgShadow,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,u:[]f32) {g0:=og_grad(s.uv);g1:=og_grad(s.uv1);if s.character<0.5 {if u[49]<0.5 {gpu_discard();}return;}m:=cast(int)vertices[5]+cast(int)s.material*64;kind:=vertices[m+16];if kind==4 || kind==6 {gpu_discard();}if og_coverage(s.uv,s.uv1,s.material,vertices,sheets,sheet,g0,g1)<og_word(vertices,m+18) {gpu_discard();}}
og_tone :: (x:f32)->f32 {a:=fmax(x,0.0f32);return og_raw(clampf((a*(2.51*a+0.03))/(a*(2.43*a+0.59)+0.14),0.0f32,1.0f32));}
og_scene_fs :: (s:OgSurface,u:[]f32,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
 g0:=og_grad(s.uv);g1:=og_grad(s.uv1);if s.character<0.5 && u[49]<0.5 {gpu_discard();}n:=normalize3(s.normal);view:=normalize3(sub3(og_at(u,8),s.world));sun:=og_at(u,28);colour:=v3(s.colour.x,s.colour.y,s.colour.z);rough:f32=0.85;ao:f32=1;alpha:f32=1;kind:u32=0;
 if s.character>0.5 {m:=cast(int)vertices[5]+cast(int)s.material*64;kind=vertices[m+16];if kind==4 || kind==6 {gpu_discard();}uv:=s.uv;g:=g0;if kind==7 {g=og_foot_scale(g1,og_word(vertices,m+33));uv=v2(s.uv1.x*og_word(vertices,m+33),s.uv1.y*og_word(vertices,m+34));}a:=og_sample(vertices[m],uv,sheets,sheet,g);colour=v3(a.x,a.y,a.z);alpha=og_coverage(s.uv,s.uv1,s.material,vertices,sheets,sheet,g0,g1);if alpha<og_word(vertices,m+18) {gpu_discard();}
  if kind==5 {colour=og_point(vertices,m+24);}if kind==3 {eye_scale:=og_word(vertices,m+47);euv:=v2((s.uv.x-0.5)*eye_scale+0.5,(s.uv.y-0.5)*eye_scale+0.5);iris:=og_sample(vertices[m],euv,sheets,sheet,og_foot_scale(g0,eye_scale));white:=og_sample(vertices[m+7],s.uv,sheets,sheet,g0);mask:=og_sample(vertices[m+5],euv,sheets,sheet,og_foot_scale(g0,eye_scale));f:=og_raw(mask.x);if euv.x<0 || euv.x>1 || euv.y<0 || euv.y>1 {f=0;}colour=v3(mix(white.x,iris.x,f),mix(white.y,iris.y,f),mix(white.z,iris.z,f));rough=0.18;}
  if kind!=3 {if vertices[m+1]>0 {normal_uv:=uv;normal_g:=g;layer:=vertices[m+1];if kind==7 && vertices[m+4]>0 {layer=vertices[m+4];normal_uv=s.uv;normal_g=g0;}aN:=og_sample(layer,normal_uv,sheets,sheet,normal_g);x:=og_raw(aN.x)*2.0078740157-1.0078740157;y:=og_raw(aN.y)*2.0078740157-1.0078740157;z:=sqrt(fmax(0.0f32,1-x*x-y*y));t:=normalize3(v3(s.tangent.x,s.tangent.y,s.tangent.z));b:=scale3(cross3(n,t),s.tangent.w);n=normalize3(add3(add3(scale3(t,x),scale3(b,y)),scale3(n,z)));}rough=og_word(vertices,m+19);if vertices[m+2]>0 {rough=og_raw(og_sample(vertices[m+2],uv,sheets,sheet,g).x);}if vertices[m+3]>0 {ao=og_raw(og_sample(vertices[m+3],s.uv,sheets,sheet,g0).x);}}
 }
 else {if s.material==34 {d:=abs(s.world.x-oc_path(s.world.z));trail:=1-smoothstep(1.3f32,2.5f32,d);noise:=og_hash(floor(s.world.x*8)+floor(s.world.z*8)*0.41);colour=v3(mix(0.045f32,0.18f32,trail)+noise*0.025,mix(0.12f32,0.125f32,trail)+noise*0.025,mix(0.025f32,0.055f32,trail));}if s.material==32 {noise:=sin(s.uv.x*12+sin(s.world.y*3))*0.5+0.5;colour=v3(0.10+noise*0.035,0.065+noise*0.025,0.029+noise*0.012);}}
 q:=og_shadow_point(s.world,u);shadow:f32=1;if abs(q.x)<1 && abs(q.y)<1 && q.z>0 && q.z<1 {shadow=0;for y:0..<3 {for x:0..<3 {shadow+=gpu_compare(shadow_map,shadow_cmp,v2(q.x*0.5+0.5+cast(f32)(x-1)*0.0007,0.5-q.y*0.5+cast(f32)(y-1)*0.0007),q.z-(ifx u[49]<0.5 then 0.0018f32 else 0.0006f32))/9;}}}
 ndl:=fmax(0.0f32,dot3(n,sun));if kind==2 {ndl=fmax(ndl,(dot3(n,sun)+0.4)/1.4);}ambient:=0.27+0.13*(n.y*0.5+0.5);lighting:=ambient*(0.45+0.55*ao)+ndl*shadow*1.35;colour=v3(colour.x*lighting*1.07,colour.y*lighting*1.02,colour.z*lighting*0.88);
 h:=normalize3(add3(view,sun));spec:=pow(fmax(0.0f32,dot3(n,h)),mix(120.0f32,8.0f32,rough))*(1-rough)*shadow*0.28;colour=add3(colour,v3(spec,spec,spec));if kind==3 {highlight:=pow(fmax(0.0f32,dot3(n,h)),100)*0.8;colour=add3(colour,v3(highlight,highlight,highlight));}
 if u[4]==1 && s.character>0.5 {m:=cast(int)vertices[5]+cast(int)s.material*64;a:=og_sample(vertices[m],s.uv,sheets,sheet,g0);colour=v3(a.x,a.y,a.z);}if u[4]==2 {colour=add3(scale3(n,0.5),v3(0.5,0.5,0.5));}if u[4]==3 {colour=v3(rough,rough,rough);}
 distance:=wg_length3(sub3(s.world,og_at(u,8)));fog:=1-exp(-distance*0.018);colour=v3(mix(colour.x,0.08f32,fog),mix(colour.y,0.16f32,fog),mix(colour.z,0.15f32,fog));return v4(og_tone(colour.x),og_tone(colour.y),og_tone(colour.z),1);
}
og_fx_vs :: (id:u32,instance:u32,a:OgHud,u:[]f32)->SplashV {return splash_fx_vs(id,instance,splash_fx_vs_in.{a=a.a,b=a.b,c=a.c,d=v4(0,0,0,0)},u);}
og_fx_fs :: (v:SplashV,u:[]f32)->V4 {return splash_fx_fs(v,u);}
