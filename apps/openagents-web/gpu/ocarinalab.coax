// Original source Link with eight influences and semantic BNTX maps, in a shared-controller forest.
#load "ocarina-atmosphere.coax";
#load "../../../aethyr/render/sampling.coax";

OgVertex :: struct {p:V3;n:V3;uv:V2;uv1:V2;t:V4;colour:V4;material:f32;character:f32;}
OgSurface :: struct {pos:V4;world:V3;normal:V3;uv:V2;uv1:V2;tangent:V4;colour:V4;material:f32;character:f32;}
OgShadow :: struct {pos:V4;uv:V2;uv1:V2;material:f32;character:f32;}
OgFoot :: struct {dx:V2;dy:V2;}
og_grad :: (uv:V2)->OgFoot {return OgFoot.{dx=v2(gpu_dpdx_fine(uv.x),gpu_dpdx_fine(uv.y)),dy=v2(gpu_dpdy_fine(uv.x),gpu_dpdy_fine(uv.y))};}
og_foot_scale :: (g:OgFoot,f:f32)->OgFoot {return OgFoot.{dx=v2(g.dx.x*f,g.dx.y*f),dy=v2(g.dy.x*f,g.dy.y*f)};}
OgHud :: struct {a:V4;b:V4;c:V4;}
og_at :: (u:[]f32,i:int)->V3 {return v3(u[i],u[i+1],u[i+2]);}
og_word :: (v:[]u32,i:int)->f32 {return f32_from_bits(v[i]);}
og_point :: (v:[]u32,i:int)->V3 {return v3(og_word(v,i),og_word(v,i+1),og_word(v,i+2));}
og_yaw :: (v:V3,yaw:f32)->V3 {c:=cos(yaw);s:=sin(yaw);return v3(c*v.x+s*v.z,v.y,-s*v.x+c*v.z);}
og_unit :: (p:V3,fallback:V3)->V3 {l:=dot3(p,p);if l<0.00000001 {return fallback;}return scale3(p,1/sqrt(l));}
og_signed10 :: (word:u32)->f32 {n:=cast(int)(word&1023);return clampf(cast(f32)(ifx n>=512 then n-1024 else n)/511.0,-1.0,1.0);}
og_snorm :: (word:u32)->V3 {return v3(og_signed10(word),og_signed10(word>>10),og_signed10(word>>20));}
og_skin :: (value:V4,at:int,v:[]u32,bones:[]f32)->V3 {sum:f32=0;out:V3;for k:0..<8 {joint:=cast(int)((v[at+9+k/2]>>cast(u32)(k%2*16))&65535);weight:=cast(f32)((v[at+13+k/4]>>cast(u32)(k%4*8))&255);if weight>0 {b:=joint*12;out=add3(out,scale3(v3(dot4(wg_at4(bones,b),value),dot4(wg_at4(bones,b+4),value),dot4(wg_at4(bones,b+8),value)),weight));sum+=weight;}}return scale3(out,1/fmax(sum,1.0f32));}
og_vertex :: (id:u32,u:[]f32,v:[]u32,bones:[]f32)->OgVertex {
 if id>=v[2] {
  at:=cast(int)v[9]+cast(int)(id-v[2])*16;n:=og_snorm(v[at+3]);t:=og_snorm(v[at+9]);w:=ifx (v[at+9]>>30)==3 then -1.0f32 else 1.0f32;p:=og_point(v,at);mat:=cast(int)v[at+8];m:=cast(int)v[5]+mat*64;
  return OgVertex.{p=p,n=n,uv=v2(og_word(v,at+4),og_word(v,at+5)),uv1=v2(og_word(v,at+6),og_word(v,at+7)),t=v4(t.x,t.y,t.z,w),colour=wg_unpack4x8unorm(v[at+10]),material=cast(f32)mat,character=0};
 }
at:=cast(int)v[4]+cast(int)id*32;p:=og_point(v,at);normal:=og_point(v,at+3);t:=og_point(v,at+15);posed:=og_skin(v4(p.x,p.y,p.z,1),at,v,bones);n:=og_skin(v4(normal.x,normal.y,normal.z,0),at,v,bones);tangent:=og_skin(v4(t.x,t.y,t.z,0),at,v,bones);yaw:=u[27];return OgVertex.{p=add3(og_yaw(posed,yaw),og_at(u,24)),n=og_yaw(n,yaw),uv=v2(og_word(v,at+6),og_word(v,at+7)),uv1=v2(og_word(v,at+20),og_word(v,at+21)),t=v4(og_yaw(tangent,yaw).x,og_yaw(tangent,yaw).y,og_yaw(tangent,yaw).z,og_word(v,at+18)),colour=wg_unpack4x8unorm(v[at+19]),material=cast(f32)v[at+8],character=1};
}
#test "Fixed foliage world positions normals and shadow coordinates do not depend on camera motion" {
 v:[320]u32;u:[64]f32;bones:[1]f32;v[5]=64;v[9]=256;v[80]=14;v[256]=f32_bits(10);v[257]=f32_bits(2);v[258]=f32_bits(-3);v[259]=511<<10;v[265]=511|(cast(u32)1<<30);v[266]=0xffffffff;u[32]=1;u[37]=1;u[42]=1;u[47]=20;
 a:=og_vertex(0,u[..],v[..],bones[..]);shadow:=og_shadow_vs(0,0,u[..],v[..],bones[..]);for k:0..<8 {u[8]=cast(f32)k-4;u[9]=cast(f32)k;u[10]=cast(f32)k*3;u[20]=sin(cast(f32)k);u[22]=cos(cast(f32)k);p:=og_vertex(0,u[..],v[..],bones[..]);q:=og_shadow_vs(0,0,u[..],v[..],bones[..]);#assert p.p.x==a.p.x && p.p.y==a.p.y && p.p.z==a.p.z && p.n.y==a.n.y && q.pos.x==shadow.pos.x && q.pos.y==shadow.pos.y && q.pos.z==shadow.pos.z;}
}
og_shadow_point :: (p:V3,u:[]f32)->V3 {r:=sub3(p,og_at(u,44));return v3(dot3(r,og_at(u,32))/u[47],dot3(r,og_at(u,36))/u[47],0.5-dot3(r,og_at(u,40))/(u[47]*2));}
og_bg_vs :: (id:u32,instance:u32)->V4 {return splash_bg_vs(id,instance);}
og_bg_fs :: (p:V4,u:[]f32)->V4 {px:=p.x;py:=p.y;ray:=normalize3(add3(og_at(u,20),add3(scale3(og_at(u,12),(px/u[0]*2-1)/u[15]),scale3(og_at(u,16),(1-py/u[1]*2)/u[19]))));sky:=oa_sky(ray,og_at(u,28));return v4(og_tone(sky.x),og_tone(sky.y),og_tone(sky.z),1);}
og_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->OgSurface {v:=og_vertex(id,u,vertices,bones);r:=sub3(v.p,og_at(u,8));z:=dot3(r,og_at(u,20));return OgSurface.{pos=v4(dot3(r,og_at(u,12))*u[15],dot3(r,og_at(u,16))*u[19],700.0/699.95*(z-0.05),z),world=v.p,normal=v.n,uv=v.uv,uv1=v.uv1,tangent=v.t,colour=v.colour,material=v.material,character=v.character};}
og_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->OgShadow {v:=og_vertex(id,u,vertices,bones);q:=og_shadow_point(v.p,u);return OgShadow.{pos=v4(q.x,q.y,q.z,1),uv=v.uv,uv1=v.uv1,material=v.material,character=v.character};}
og_sample :: (layer:u32,uv:V2,sheets:Tex2DArray,sheet:Sampler,g:OgFoot)->V4 {if layer==0 {return v4(1,1,1,1);}grid:=cast(int)(layer>>24);if grid>0 {tile:=cast(int)((layer>>16)&255)-1;cell:=1536/grid;scale:=cast(f32)(cell-16)/1536.0;origin:=v2(cast(f32)(tile%grid*cell+8)/1536.0,cast(f32)(tile/grid*cell+8)/1536.0);at:=v2(origin.x+fract(uv.x)*scale,origin.y+fract(uv.y)*scale);return render_sample_layer8_grad(sheets,sheet,at,cast(s32)((layer&65535)-1),v2(g.dx.x*scale,g.dx.y*scale),v2(g.dy.x*scale,g.dy.y*scale),0);}return render_sample_layer8_grad(sheets,sheet,uv,cast(s32)(layer-1),g.dx,g.dy,0);}
og_raw :: (x:f32)->f32 {return ifx x<=0.0031308 then x*12.92 else 1.055*pow(x,1.0f32/2.4f32)-0.055;}
og_linear :: (x:f32)->f32 {return ifx x<=0.04045 then x/12.92 else pow((x+0.055)/1.055,2.4f32);}
og_coverage :: (uv:V2,uv1:V2,material:f32,v:[]u32,sheets:Tex2DArray,sheet:Sampler,g0:OgFoot,g1:OgFoot)->f32 {g:=g0;m:=cast(int)v[5]+cast(int)floor(material+0.5)*64;kind:=v[m+16];a:=og_sample(v[m],uv,sheets,sheet,g);if kind==1 {mask:=og_sample(v[m+5],uv1,sheets,sheet,g1);return a.w*og_raw(mask.x);}if kind==5 {return og_raw(a.x);}if kind==9 || kind==11 || kind==12 {return 1;}return a.w;}
og_shadow_fs :: (s:OgShadow,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,u:[]f32) {g0:=og_grad(s.uv);g1:=og_grad(s.uv1);if s.character<0.5 && u[49]<0.5 {gpu_discard();}m:=cast(int)vertices[5]+cast(int)floor(s.material+0.5)*64;kind:=vertices[m+16];if kind==4 || kind==6 || kind==11 {gpu_discard();}if og_coverage(s.uv,s.uv1,s.material,vertices,sheets,sheet,g0,g1)<og_word(vertices,m+18) {gpu_discard();}}
og_tone :: (x:f32)->f32 {a:=fmax(x,0.0f32);return og_raw(clampf((a*(2.51*a+0.03))/(a*(2.43*a+0.59)+0.14),0.0f32,1.0f32));}
og_scene_fs :: (s:OgSurface,u:[]f32,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
 g0:=og_grad(s.uv);g1:=og_grad(s.uv1);ground_uv:=v2(s.world.x*0.25,s.world.z*0.25);ground_g:=og_grad(ground_uv);soil_uv:=v2(s.world.x*0.38+s.world.z*0.12,s.world.z*0.38-s.world.x*0.12);soil_g:=og_grad(soil_uv);if s.character<0.5 && u[49]<0.5 {gpu_discard();}n:=og_unit(s.normal,v3(0,1,0));view:=normalize3(sub3(og_at(u,8),s.world));sun:=og_at(u,28);colour:=v3(s.colour.x,s.colour.y,s.colour.z);rough:f32=0.85;ao:f32=1;alpha:f32=1;kind:u32=0;
 {m:=cast(int)vertices[5]+cast(int)floor(s.material+0.5)*64;kind=vertices[m+16];if kind==4 || kind==6 {gpu_discard();}uv:=s.uv;g:=g0;if kind==9 {uv=ground_uv;g=ground_g;}if kind==7 {g=og_foot_scale(g1,og_word(vertices,m+33));uv=v2(s.uv1.x*og_word(vertices,m+33),s.uv1.y*og_word(vertices,m+34));}a:=og_sample(vertices[m],uv,sheets,sheet,g);colour=v3(a.x,a.y,a.z);if kind==14 {colour=v3(colour.x*0.82,colour.y*0.86,colour.z*0.92);}if kind==9 {soil:=og_sample(vertices[m+7],soil_uv,sheets,sheet,soil_g);patch:=oa_noise(v2(s.world.x*0.14,s.world.z*0.14))*0.7+oa_noise(v2(s.world.x*0.37+9,s.world.z*0.37))*0.3;blend:=0.25+smoothstep(0.28f32,0.72f32,patch)*0.65+clampf(0.8-n.y,0,0.3);colour=oa_mix(colour,v3(soil.x,soil.y,soil.z),clampf(blend,0,0.9));colour=v3(colour.x*0.88,colour.y*0.80,colour.z*0.88);}alpha=og_coverage(s.uv,s.uv1,s.material,vertices,sheets,sheet,g0,g1);if alpha<og_word(vertices,m+18) {gpu_discard();}
  if kind==5 {colour=og_point(vertices,m+24);}if kind==3 {eye_scale:=og_word(vertices,m+47);euv:=v2((s.uv.x-0.5)*eye_scale+0.5,(s.uv.y-0.5)*eye_scale+0.5);iris:=og_sample(vertices[m],euv,sheets,sheet,og_foot_scale(g0,eye_scale));white:=og_sample(vertices[m+7],s.uv,sheets,sheet,g0);mask:=og_sample(vertices[m+5],euv,sheets,sheet,og_foot_scale(g0,eye_scale));f:=og_raw(mask.x);if euv.x<0 || euv.x>1 || euv.y<0 || euv.y>1 {f=0;}colour=v3(mix(white.x,iris.x,f),mix(white.y,iris.y,f),mix(white.z,iris.z,f));rough=0.18;}
  if kind!=3 {if vertices[m+1]>0 {normal_uv:=uv;normal_g:=g;layer:=vertices[m+1];if kind==7 && vertices[m+4]>0 {layer=vertices[m+4];normal_uv=s.uv;normal_g=g0;}aN:=og_sample(layer,normal_uv,sheets,sheet,normal_g);x:=og_raw(aN.x)*2.0078740157-1.0078740157;y:=og_raw(aN.y)*2.0078740157-1.0078740157;z:=sqrt(fmax(0.0f32,1-x*x-y*y));t0:=v3(s.tangent.x,s.tangent.y,s.tangent.z);fallback:=og_unit(cross3(n,v3(0,0,1)),v3(1,0,0));t:=og_unit(sub3(t0,scale3(n,dot3(n,t0))),fallback);b:=scale3(cross3(n,t),s.tangent.w);n=normalize3(add3(add3(scale3(t,x),scale3(b,y)),scale3(n,z)));}rough=og_word(vertices,m+19);if vertices[m+2]>0 {rough=og_raw(og_sample(vertices[m+2],uv,sheets,sheet,g).x);}if vertices[m+3]>0 {ao=og_raw(og_sample(vertices[m+3],s.uv,sheets,sheet,g0).x);}}
 }
 if kind==12 {colour=v3(0.012,0.016,0.012);rough=1;} q:=og_shadow_point(s.world,u);shadow:f32=1;if abs(q.x)<1 && abs(q.y)<1 && q.z>0 && q.z<1 {shadow=0;for y:0..<3 {for x:0..<3 {shadow+=gpu_compare(shadow_map,shadow_cmp,v2(q.x*0.5+0.5+cast(f32)(x-1)*0.0007,0.5-q.y*0.5+cast(f32)(y-1)*0.0007),q.z-(ifx u[49]<0.5 then 0.0018f32 else 0.0006f32))/9;}}}
 ndl:=fmax(0.0f32,dot3(n,sun));if kind==2 {ndl=fmax(ndl,(dot3(n,sun)+0.4)/1.4);}if kind==14 {ndl=0.25+abs(dot3(n,sun))*0.55;}ambient:=0.22+0.16*(n.y*0.5+0.5);lighting:=ambient*(0.35+0.65*ao)+ndl*shadow*1.55;colour=v3(colour.x*lighting*1.07,colour.y*lighting*1.02,colour.z*lighting*0.88);
 h:=normalize3(add3(view,sun));spec:=pow(fmax(0.0f32,dot3(n,h)),mix(120.0f32,8.0f32,rough))*(1-rough)*shadow*0.28;colour=add3(colour,v3(spec,spec,spec));if kind==3 {highlight:=pow(fmax(0.0f32,dot3(n,h)),100)*0.8;colour=add3(colour,v3(highlight,highlight,highlight));}
 if kind==11 {vertical:=abs(s.normal.y)<0.5;n=ifx vertical then og_unit(s.normal,v3(0,1,0)) else oa_water_normal(s.world,u[48]);reflected:=sub3(scale3(n,2*dot3(n,view)),view);sky:=oa_sky(reflected,sun);fresnel:=oa_fresnel(dot3(n,view));colour=oa_mix(v3(0.028,0.09,0.065),sky,fresnel);glint:=pow(fmax(0.0f32,dot3(n,h)),230)*1.6;colour=add3(colour,v3(glint,glint*0.91,glint*0.73));if vertical {flow:=0.5+0.5*sin(s.world.y*17+u[48]*4+s.world.x*3);colour=oa_mix(v3(0.16,0.29,0.26),v3(0.64,0.73,0.67),flow*0.55);}}
 if u[4]==1 && s.character>0.5 {m:=cast(int)vertices[5]+cast(int)floor(s.material+0.5)*64;a:=og_sample(vertices[m],s.uv,sheets,sheet,g0);colour=v3(a.x,a.y,a.z);}if u[4]==2 {colour=add3(scale3(n,0.5),v3(0.5,0.5,0.5));}if u[4]==3 {colour=v3(rough,rough,rough);}
 if kind>=8 {m:=cast(int)vertices[5]+cast(int)floor(s.material+0.5)*64;if vertices[m+61]>0 {em:=og_sample(vertices[m+61],s.uv,sheets,sheet,g0);colour=add3(colour,scale3(v3(em.x,em.y,em.z),1.5));}} distance:=wg_length3(sub3(s.world,og_at(u,8)));height_density:=0.45+0.55*exp(-fmax(s.world.y-109.0f32,0.0f32)/18.0f32);fog:=1-exp(-distance*0.0045*height_density);fog_sky:=oa_sky(normalize3(sub3(s.world,og_at(u,8))),sun);colour=oa_mix(colour,fog_sky,fog);opacity:=ifx kind==11 then 0.45+oa_fresnel(dot3(n,view))*0.5 else 1.0f32;return v4(og_tone(colour.x),og_tone(colour.y),og_tone(colour.z),opacity);
}
og_fx_vs :: (id:u32,instance:u32,a:OgHud,u:[]f32)->SplashV {return splash_fx_vs(id,instance,splash_fx_vs_in.{a=a.a,b=a.b,c=a.c,d=v4(0,0,0,0)},u);}
og_fx_fs :: (v:SplashV,u:[]f32)->V4 {return splash_fx_fs(v,u);}
