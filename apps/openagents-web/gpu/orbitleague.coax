    h.n=wg_add_f3f3(wg_add_f3f3(wg_mul_ff3(h.n.x,v3(c.x.x,c.x.y,c.x.z)),wg_mul_ff3(h.n.y,v3(c.y.x,c.y.y,c.y.z))),wg_mul_ff3(h.n.z,v3(c.z.x,c.z.y,c.z.z)));
  }
