// orbitleague's shaders, the source of apps/openagents-web/orbitleague.wgsl (docs/verse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (orbitleague.module,
// orbitleague.bindings beside it). It began as coax/web/wgsl-coax.coax's translation of the hand-written WGSL.
#load "../../../aethyr/render/noise.coax";
#load "../../../verse/gpu/wgsl.coax";
#load "../../../verse/style.coax";

// Orbit League's two passes (orbitleague.coax): bg_fs traces the whole
// world per pixel (the arena's floor and glass, the goal frames and nets,
// the ball, both roadsters, the boost flames, the station's ribs and the
// space round it: stars, a ringed planet, a moon and the sun), in the flat
// style with ink lines (docs/verse/art-styles.md), with the HUD's plates
// over it; fx draws the HUD's strokes and text. Every place and size comes
// from orbitleague.coax.
//
// The roadster is our own design: low-poly convex hulls (a wedge body,
// four fender pods, a raked windscreen, two speedster humps), a driver's
// helmet, a rear wing and four wheels, with headlights and a tail bar that
// glow. The floor and the glass reflect the ball and the cars.
OrbitleagueCar :: struct {p:V4; x:V4; y:V4; z:V4; } // place (w boost), right (w team), up (w the wheels' turn), forward (w steer)
// OrbitleagueU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   time 2
//   fade 3
//   still 4
//   panels 5
//   k 6
//   zerog 7
//   r0 8
//   r1 12
//   r2 16
//   r3 20
//   eye 24
//   fwd 28
//   rx 32
//   uy 36
//   ball 40
//   ballq 44
//   cars 48
//   arena 80
//   goal 84
//   misc 88
//   panel 92
//   trail 220
//   blast 328
//   blast2 332
//   pads 336
//   cars2 400
// the eye; w the goal's flash
// a pixel's ray: fwd + ndc.x rx + ndc.y uy; fwd.w the flash's team
// centre, radius
// its attitude
// half width, half length, roof, the goal mouth's half width
// crossbar, net depth, the drum's radius (0: the box; minus the sphere's radius: the sphere), the sphere's goal caps' radius
// the ball's speed (m/s), the cars in play (2 or 4)
// the ball's trail, then each car's boost: a bound (centre, radius) and 8 points (place, strength)
// the goal's blast: centre, age (< 0 none)
// its team
// the boost pads: x, z, big (1), how ready (1 ready)
// a 2v2's other two cars
// The cars in play, and car i of them (0 you, 1 the bot, then a 2v2's two).
orbitleague_ncars :: (u:[]f32)->s32 {
  return ifx u[89]>3.0f32 then 4 else 2;
}
orbitleague_car :: (i:s32,u:[]f32)->OrbitleagueCar {
  if (i<2) {
    return OrbitleagueCar.{p=wg_at4(u,(cast(int)i)*16+48),x=wg_at4(u,(cast(int)i)*16+52),y=wg_at4(u,(cast(int)i)*16+56),z=wg_at4(u,(cast(int)i)*16+60)};
  }
  return OrbitleagueCar.{p=wg_at4(u,(cast(int)(i-2))*16+400),x=wg_at4(u,(cast(int)(i-2))*16+404),y=wg_at4(u,(cast(int)(i-2))*16+408),z=wg_at4(u,(cast(int)(i-2))*16+412)};
}
// ---- the plates (droprealm.wgsl's)
orbitleague_plate :: (p:V2,under:V3,r:V4,s:V4)->V3 {
  if (s.y<=0.0f32) {
    return under;
  }
  half:V2=wg_mul_f2f(wg_sub_f2f2(v2(r.z,r.w),v2(r.x,r.y)),0.5f32);
  corner:f32=6.0f32*s.x;
  q:V2=wg_add_f2f2(wg_sub_f2f2(wg_abs_f2(wg_sub_f2f2(p,wg_add_f2f2(v2(r.x,r.y),half))),half),v2(corner,corner));
  d:f32=(wg_length2(wg_max_f2f2(q,v2(0.0f32,0.0f32)))+fmin(fmax(q.x,q.y),0.0f32))-corner;
  if (d>1.0f32) {
    return under;
  }
  over:bool=s.z>=2.0f32;
  lit:bool=over||((s.z>=1.0f32)&&(s.z<2.0f32));
  fill:V3=ifx over then v3(0.10f32,0.15f32,0.25f32) else v3(0.05f32,0.07f32,0.12f32);
  line:V3=ifx lit then v3(0.6f32,0.85f32,1.0f32) else v3(0.35f32,0.55f32,0.85f32);
  w:f32=1.25f32*s.x;
  inside:f32=clampf(0.5f32-d,0.0f32,1.0f32);
  edge:f32=clampf(((w*0.5f32)+0.5f32)-abs(d+(w*0.5f32)),0.0f32,1.0f32);
  a:f32=clampf(s.y,0.0f32,1.0f32);
  return wg_mix_f3f3f(wg_mix_f3f3f(under,fill,a*inside),line,edge*fmin(1.0f32,a+0.1f32));
}
orbitleague_panels :: (p:V2,under:V3,u:[]f32)->V3 {
  c:V3=under;
  {
    k:s32=0;
    while k<16 {
      if ((cast(f32)(k))>=u[5]) {
        break;
      }
      c=orbitleague_plate(p,c,wg_at4(u,(cast(int)(k*2))*4+92),wg_at4(u,(cast(int)((k*2)+1))*4+92));
      k+=1;
    }
  }
  return c;
}
#test "orbitleague_hash3 live lattice uses the portable integer noise profile" {
  #assert f32_bits(orbitleague_hash3(v3(1,2,3)))==0x3f42352b;
}
orbitleague_hash3 :: (p:V3)->f32 {
  return render_noise3(p.x,p.y,p.z);
}
ORBITLEAGUE_BLUE :: ()->V3 {return v3(0.18f32,0.48f32,1.0f32);}
ORBITLEAGUE_MAGENTA :: ()->V3 {return v3(1.0f32,0.22f32,0.72f32);}
ORBITLEAGUE_SUN :: ()->V3 {return v3(-0.5f32,0.62f32,-0.45f32);} // normalised in sun(): high, behind the blue end
orbitleague_sun :: ()->V3 {
  return wg_normalize3(ORBITLEAGUE_SUN());
}
orbitleague_team :: (t:f32)->V3 {
  return ifx t>0.5f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
}
// A car's x.w: its team (0 blue, 1 magenta) + 2 x its paint (ol-paint: a
// colour 0-7, + 8 x a decal 0-3; 0 is the team's own colour, no decal).
orbitleague_car_side :: (c:OrbitleagueCar)->f32 {
  return c.x.w-(2.0f32*floor(c.x.w*0.5f32));
}
orbitleague_car_paint :: (c:OrbitleagueCar)->s32 {
  return wg_i32_f(floor((c.x.w*0.5f32)+0.25f32));
}
// The paints a player picks from: none a team's colour, none orange.
orbitleague_paint_colour :: (k:s32,side:f32)->V3 {
  {
    _sw1:s32=k;
    if _sw1==1 {
      return v3(0.9f32,0.92f32,0.95f32);
    }    // white
 else if _sw1==2 {
      return v3(0.16f32,0.17f32,0.2f32);
    }    // graphite
 else if _sw1==3 {
      return v3(0.55f32,0.58f32,0.62f32);
    }    // silver
 else if _sw1==4 {
      return v3(0.08f32,0.38f32,0.18f32);
    }    // forest
 else if _sw1==5 {
      return v3(0.55f32,0.9f32,0.12f32);
    }    // lime
 else if _sw1==6 {
      return v3(0.05f32,0.75f32,0.7f32);
    }    // teal
 else if _sw1==7 {
      return v3(0.95f32,0.88f32,0.15f32);
    }    // yellow
 else {
      return orbitleague_team(side);
    }
  }
}
orbitleague_moving :: (u:[]f32)->f32 {
  return ifx u[4]>0.5f32 then 0.0f32 else 1.0f32;
}
// Flat light: three bands of the sun, and a sky fill.
orbitleague_flat_light :: (n:V3)->f32 {
  l:f32=fmax(0.0f32,wg_dot3(n,orbitleague_sun()));
  band:f32=ifx l>0.6f32 then 1.0f32 else ifx l>0.25f32 then 0.8f32 else 0.55f32;
  return 0.35f32+((0.65f32*band)*(0.7f32+(0.3f32*fmax(0.0f32,n.y))));
}
// ---- space: a ringed ice giant ahead of the blue end, a moon behind, the sun high over the blue end
ORBITLEAGUE_PLANET_D :: ()->V3 {return v3(-0.5f32,0.3f32,1.0f32);}
ORBITLEAGUE_PLANET_DIST :: 3000.0f32;
ORBITLEAGUE_PLANET_R :: 700.0f32;
ORBITLEAGUE_RING_N :: ()->V3 {return v3(0.22f32,1.0f32,-0.3f32);}
ORBITLEAGUE_MOON_D :: ()->V3 {return v3(0.5f32,0.32f32,-1.0f32);}
ORBITLEAGUE_MOON_DIST :: 2000.0f32;
ORBITLEAGUE_MOON_R :: 70.0f32;
orbitleague_planet_c :: ()->V3 {
  return wg_mul_f3f(wg_normalize3(ORBITLEAGUE_PLANET_D()),ORBITLEAGUE_PLANET_DIST);
}
orbitleague_sphere_t :: (d:V3,c:V3,r:f32)->f32 {
  b:f32=wg_dot3(c,d);
  disc:f32=((b*b)-wg_dot3(c,c))+(r*r);
  if (disc<0.0f32) {
    return -1.0f32;
  }
  return b-sqrt(disc);
}
orbitleague_planet_col :: (n:V3)->V3 {
  // cool bands along its own pole (the rings'), warped, and one pale storm
  pole:V3=wg_normalize3(ORBITLEAGUE_RING_N());
  la:f32=wg_dot3(n,pole);
  b:f32=(la+(sin(wg_dot3(n,v3(7.0f32,1.0f32,5.0f32)))*0.035f32))+(sin((la*31.0f32)+(n.x*5.0f32))*0.012f32);
  col:V3=wg_mix_f3f3f(v3(0.16f32,0.36f32,0.50f32),v3(0.58f32,0.74f32,0.86f32),0.5f32+(0.5f32*sin(b*21.0f32)));
  col=wg_mix_f3f3f(col,v3(0.40f32,0.34f32,0.62f32),(0.5f32+(0.5f32*sin((b*53.0f32)+1.3f32)))*0.35f32);
  storm:V3=wg_mul_f3f3(wg_sub_f3f3(n,wg_normalize3(v3(0.3f32,-0.05f32,-0.95f32))),v3(1.0f32,2.2f32,1.0f32));
  col=wg_mix_f3f3f(col,v3(0.86f32,0.93f32,0.98f32),(1.0f32-smoothstep(0.05f32,0.085f32,wg_length3(storm)))*0.85f32);
  return col;
}
orbitleague_space :: (d:V3,u:[]f32)->V3 {
  c:V3=wg_mix_f3f3f(v3(0.006f32,0.008f32,0.02f32),v3(0.025f32,0.02f32,0.055f32),clampf(0.5f32+(0.5f32*d.y),0.0f32,1.0f32));
  // a faint band of the galaxy
  band:f32=wg_dot3(d,wg_normalize3(v3(0.3f32,0.55f32,-0.78f32)));
  wave:f32=0.55f32+((0.45f32*sin((d.x*7.0f32)+(sin(d.z*5.0f32)*2.0f32)))*sin((d.y*9.0f32)+(d.z*3.0f32)));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(wg_mix_f3f3f(v3(0.09f32,0.03f32,0.15f32),v3(0.02f32,0.09f32,0.13f32),0.5f32+(0.5f32*sin((d.x*3.0f32)-(d.z*2.0f32)))),exp(((-band)*band)*14.0f32)),wave),0.55f32));
  // stars: one at most in a cell of the direction's grid
  g:V3=wg_mul_f3f(d,180.0f32);
  cell:V3=wg_floor_f3(g);
  h:f32=orbitleague_hash3(cell);
  if (h>0.96f32) {
    at:V3=wg_add_f3f3(cell,v3(orbitleague_hash3(wg_add_f3f(cell,1.3f32)),orbitleague_hash3(wg_add_f3f(cell,7.1f32)),orbitleague_hash3(wg_add_f3f(cell,3.7f32))));
    r:f32=wg_length3(wg_sub_f3f3(g,at));
    tw:f32=1.0f32-((0.2f32*orbitleague_moving(u))*(0.5f32+(0.5f32*sin((u[2]*(0.5f32+(h*3.0f32)))+(h*50.0f32)))));
    tint:V3=wg_mix_f3f3f(v3(0.75f32,0.85f32,1.0f32),v3(1.0f32,0.95f32,1.0f32),fract(h*37.0f32));
    c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(tint,(1.0f32-smoothstep(0.05f32,0.28f32,r))),ifx h>0.993f32 then 1.0f32 else 0.5f32),tw));
  }
  // the sun: a white disc and its glare
  sd:f32=wg_dot3(d,orbitleague_sun());
  c=wg_add_f3f3(c,wg_mul_f3f(v3(1.0f32,0.97f32,0.93f32),(((smoothstep(0.9995f32,0.9998f32,sd)*3.0f32)+(pow(fmax(sd,0.0f32),400.0f32)*0.7f32))+(pow(fmax(sd,0.0f32),24.0f32)*0.06f32))));
  // the moon: grey, cratered, lit from the sun's side
  mc:V3=wg_mul_f3f(wg_normalize3(ORBITLEAGUE_MOON_D()),ORBITLEAGUE_MOON_DIST);
  mt:f32=orbitleague_sphere_t(d,mc,ORBITLEAGUE_MOON_R);
  if (mt>0.0f32) {
    n:V3=wg_normalize3(wg_sub_f3f3(wg_mul_f3f(d,mt),mc));
    cr:f32=orbitleague_hash3(wg_floor_f3(wg_mul_f3f(n,9.0f32)));
    mcol:V3=wg_mul_f3f(v3(0.55f32,0.57f32,0.62f32),(0.85f32+(0.15f32*cr)));
    mcol=wg_mul_f3f(mcol,1.0f32-((0.25f32*(1.0f32-smoothstep(0.1f32,0.3f32,wg_length3(wg_sub_f3f(wg_fract_f3(wg_mul_f3f(n,9.0f32)),0.5f32)))))*stepf(0.6f32,cr)));
    c=wg_mul_f3f(mcol,(0.05f32+(0.95f32*smoothstep(-0.05f32,0.2f32,wg_dot3(n,orbitleague_sun())))));
  }
  // the planet and its rings
  pc:V3=orbitleague_planet_c();
  pt:f32=orbitleague_sphere_t(d,pc,ORBITLEAGUE_PLANET_R);
  if (pt>0.0f32) {
    n:V3=wg_normalize3(wg_sub_f3f3(wg_mul_f3f(d,pt),pc));
    l:f32=wg_dot3(n,orbitleague_sun());
    lit:f32=0.05f32+(0.95f32*smoothstep(-0.08f32,0.22f32,l));
    c=wg_add_f3f3(wg_mul_f3f(orbitleague_planet_col(n),lit),wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(0.3f32,0.6f32,1.0f32),pow(1.0f32-fmax(0.0f32,wg_dot3(n,wg_neg_f3(d))),3.0f32)),0.8f32),smoothstep(-0.35f32,0.3f32,l)));
  } else {
    // the air's halo round the limb
    b:f32=wg_dot3(pc,d);
    miss:f32=wg_length3(wg_sub_f3f3(pc,wg_mul_f3f(d,b)))-ORBITLEAGUE_PLANET_R;
    if ((b>0.0f32)&&(miss>0.0f32)) {
      c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.3f32,0.6f32,1.0f32),exp((-miss)/25.0f32)),0.45f32));
    }
  }
  rn:V3=wg_normalize3(ORBITLEAGUE_RING_N());
  den:f32=wg_dot3(d,rn);
  if (abs(den)>1e-4f32) {
    rt:f32=wg_dot3(pc,rn)/den;
    rp:V3=wg_sub_f3f3(wg_mul_f3f(d,rt),pc);
    r:f32=wg_length3(rp)/ORBITLEAGUE_PLANET_R;
    if ((((rt>0.0f32)&&(r>1.35f32))&&(r<2.25f32))&&((pt<0.0f32)||(rt<pt))) {
      a:f32=0.35f32+((0.35f32*sin(r*34.0f32))*sin((r*11.0f32)+0.7f32));
      a=a*((smoothstep(1.35f32,1.42f32,r)*(1.0f32-smoothstep(2.15f32,2.25f32,r)))*(1.0f32-(0.8f32*(1.0f32-smoothstep(0.012f32,0.03f32,abs(r-1.78f32))))));
      // the planet's shadow on the rings
      sb:f32=wg_dot3(rp,orbitleague_sun());
      shadowed:bool=(sb<0.0f32)&&((wg_dot3(rp,rp)-(sb*sb))<(ORBITLEAGUE_PLANET_R*ORBITLEAGUE_PLANET_R));
      rl:f32=ifx shadowed then 0.06f32 else 0.25f32+(0.75f32*abs(wg_dot3(rn,orbitleague_sun())));
      c=wg_mix_f3f3f(c,wg_mul_f3f(v3(0.74f32,0.78f32,0.90f32),rl),clampf(a,0.0f32,0.85f32));
    }
  }
  return c;
}
// A cheap reflection of the station for gloss: the floor's dark below, space above, the planet and the sun.
orbitleague_env :: (r:V3)->V3 {
  c:V3=wg_mix_f3f3f(v3(0.03f32,0.035f32,0.05f32),v3(0.05f32,0.07f32,0.13f32),smoothstep(-0.15f32,0.25f32,r.y));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.30f32,0.50f32,0.65f32),pow(fmax(wg_dot3(r,wg_normalize3(ORBITLEAGUE_PLANET_D())),0.0f32),10.0f32)),0.7f32));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.97f32,0.93f32),pow(fmax(wg_dot3(r,orbitleague_sun()),0.0f32),60.0f32)),1.2f32));
  // the arena's edge lights, a line at the horizon
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.35f32,0.55f32,1.0f32),exp(((-r.y)*r.y)*900.0f32)),0.5f32));
  return c;
}
// ---- shapes
// mat: 0 matte, 1 paint, 2 glass, 3 light (emits its colour), 4 the ball, 5 the floor
OrbitleagueHit :: struct {t:f32; n:V3; col:V3; ink:f32; mat:s32; }
orbitleague_miss :: ()->OrbitleagueHit {
  return OrbitleagueHit.{t=1e9f32,n=v3(0.0f32,1.0f32,0.0f32),col=v3(0.0f32,0.0f32,0.0f32),ink=0.0f32,mat=0};
}
orbitleague_closer :: (a:OrbitleagueHit,b:OrbitleagueHit)->OrbitleagueHit {
  if (b.t<a.t) {
    return b;
  }
  return a;
}
// A box (centre c, half h) in a frame; o and d already in it. Its normal in that frame, and ink near its edges.
orbitleague_box_hit :: (o:V3,d:V3,c:V3,h:V3,col:V3,mat:s32)->OrbitleagueHit {
  inv:V3=wg_div_ff3(1.0f32,d);
  t0:V3=wg_mul_f3f3(wg_sub_f3f3(wg_sub_f3f3(c,h),o),inv);
  t1:V3=wg_mul_f3f3(wg_sub_f3f3(wg_add_f3f3(c,h),o),inv);
  tn:V3=wg_min_f3f3(t0,t1);
  tf:V3=wg_max_f3f3(t0,t1);
  tnear:f32=fmax(fmax(tn.x,tn.y),tn.z);
  tfar:f32=fmin(fmin(tf.x,tf.y),tf.z);
  if (((tnear>tfar)||(tfar<0.0f32))||(tnear<0.0f32)) {
    return orbitleague_miss();
  }
  p:V3=wg_sub_f3f3(wg_add_f3f3(o,wg_mul_f3f(d,tnear)),c);
  e:V3=wg_sub_f3f3(h,wg_abs_f3(p));
  n:V3=v3(0.0f32,0.0f32,0.0f32);
  if (tnear==tn.x) {
    n=v3(-wg_sign(d.x),0.0f32,0.0f32);
  } else if (tnear==tn.y) {
    n=v3(0.0f32,-wg_sign(d.y),0.0f32);
  } else {
    n=v3(0.0f32,0.0f32,-wg_sign(d.z));
  }
  // the edge: the middle of the three distances to the faces
  mid:f32=(((e.x+e.y)+e.z)-fmin(fmin(e.x,e.y),e.z))-fmax(fmax(e.x,e.y),e.z);
  return OrbitleagueHit.{t=tnear,n=n,col=col,ink=1.0f32-smoothstep(0.025f32,0.05f32,mid),mat=mat};
}
// The roadster's hulls, planes as (normal, offset); from a small script of points and normals.
// A convex hull: planes n.p <= w from HULL[first..first + count]. The ray's
// way in, the face's normal, and ink where the face meets another.
OrbitleagueHullHit :: struct {t:f32; n:V3; edge:f32; }
orbitleague_hull_cast :: (o:V3,d:V3,first:s32,count:s32,HULL:[45]V4)->OrbitleagueHullHit {
  tn:f32=-1e9f32;
  tf:f32=1e9f32;
  nn:V3=v3(0.0f32,0.0f32,0.0f32);
  k:s32=-1;
  {
    i:s32=first;
    while i<(first+count) {
      pl:V4=HULL[cast(int)i];
      den:f32=wg_dot3(v3(pl.x,pl.y,pl.z),d);
      num:f32=pl.w-wg_dot3(v3(pl.x,pl.y,pl.z),o);
      if (abs(den)<1e-7f32) {
        if (num<0.0f32) {
          return OrbitleagueHullHit.{t=1e9f32,n=nn,edge=0.0f32};
        }
        {i+=1; continue;}
      }
      t:f32=num/den;
      if (den<0.0f32) {
        if (t>tn) {
          tn=t;
          nn=v3(pl.x,pl.y,pl.z);
          k=i;
        }
      } else {
        tf=fmin(tf,t);
      }
      i+=1;
    }
  }
  if (((k<0)||(tn>tf))||(tn<0.0f32)) {
    return OrbitleagueHullHit.{t=1e9f32,n=nn,edge=0.0f32};
  }
  p:V3=wg_add_f3f3(o,wg_mul_f3f(d,tn));
  e:f32=1e9f32;
  {
    i:s32=first;
    while i<(first+count) {
      if (i!=k) {
        pl:V4=HULL[cast(int)i];
        e=fmin(e,pl.w-wg_dot3(v3(pl.x,pl.y,pl.z),p));
      }
      i+=1;
    }
  }
  return OrbitleagueHullHit.{t=tn,n=nn,edge=1.0f32-smoothstep(0.012f32,0.028f32,e)};
}
// A wheel: a cylinder along x (centre c, radius r, half width w): a dark tyre and a bright rim.
orbitleague_wheel_hit :: (o:V3,d:V3,c:V3,r:f32,w:f32,spin:f32)->OrbitleagueHit {
  q:V3=wg_sub_f3f3(o,c);
  a:f32=(d.y*d.y)+(d.z*d.z);
  b:f32=(q.y*d.y)+(q.z*d.z);
  cc:f32=((q.y*q.y)+(q.z*q.z))-(r*r);
  best:OrbitleagueHit=orbitleague_miss();
  disc:f32=(b*b)-(a*cc);
  if ((disc>=0.0f32)&&(a>1e-6f32)) {
    t:f32=((-b)-sqrt(disc))/a;
    p:V3=wg_add_f3f3(q,wg_mul_f3f(d,t));
    if ((t>0.0f32)&&(abs(p.x)<=w)) {
      best=OrbitleagueHit.{t=t,n=wg_normalize3(v3(0.0f32,p.y,p.z)),col=v3(0.05f32,0.05f32,0.06f32),ink=1.0f32-smoothstep(0.03f32,0.06f32,w-abs(p.x)),mat=0};
    }
  }
  // the hubs: five spokes in a bright rim
  {
    s:f32=-1.0f32;
    while s<=1.0f32 {
      if (abs(d.x)>1e-6f32) {
        t:f32=((s*w)-q.x)/d.x;
        p:V3=wg_add_f3f3(q,wg_mul_f3f(d,t));
        rr:f32=wg_length2(v2(p.y,p.z));
        if (((t>0.0f32)&&(t<best.t))&&(rr<=r)) {
          ang:f32=((wg_atan2(p.y,p.z)+spin)*5.0f32)/6.2831853f32;
          spoke:f32=1.0f32-smoothstep(0.12f32,0.2f32,abs(fract(ang)-0.5f32));
          rim:bool=(rr<(r*0.66f32))&&((spoke>0.5f32)||(rr<(r*0.16f32)));
          col:V3=ifx rim then v3(0.78f32,0.82f32,0.88f32) else v3(0.05f32,0.05f32,0.06f32);
          best=OrbitleagueHit.{t=t,n=v3(s,0.0f32,0.0f32),col=col,ink=((1.0f32-smoothstep(0.02f32,0.04f32,abs(rr-(r*0.66f32))))+1.0f32)-smoothstep(0.02f32,0.04f32,r-rr),mat=ifx rim then 1 else 0};
        }
      }
