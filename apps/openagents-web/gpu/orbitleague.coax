}
// The boost: a blue-white cone out of the rear bumper, and its glow.
orbitleague_flame :: (ro:V3,rd:V3,c:OrbitleagueCar,tmax:f32,u:[]f32)->V3 {
  if (c.p.w<0.5f32) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  flick:f32=1.0f32+((orbitleague_moving(u)*0.12f32)*sin((u[2]*57.0f32)+(orbitleague_car_side(c)*3.0f32)));
  a:V3=wg_sub_f3f3(wg_sub_f3f3(v3(c.p.x,c.p.y,c.p.z),wg_mul_f3f(v3(c.z.x,c.z.y,c.z.z),2.12f32)),wg_mul_f3f(v3(c.y.x,c.y.y,c.y.z),0.05f32));
  b:V3=wg_sub_f3f3(a,wg_mul_f3f(v3(c.z.x,c.z.y,c.z.z),(2.2f32*flick)));
  // the closest approach of the ray and the segment
  ab:V3=wg_sub_f3f3(b,a);
  w0:V3=wg_sub_f3f3(ro,a);
  aa:f32=wg_dot3(rd,rd);
  bb:f32=wg_dot3(rd,ab);
  cc:f32=wg_dot3(ab,ab);
  dd:f32=wg_dot3(rd,w0);
  ee:f32=wg_dot3(ab,w0);
  den:f32=(aa*cc)-(bb*bb);
  s:f32=0.0f32;
  t:f32=0.0f32;
  if (den>1e-6f32) {
    s=clampf(((bb*ee)-(cc*dd))/den,0.0f32,tmax);
    t=clampf(((aa*ee)-(bb*dd))/den,0.0f32,1.0f32);
  }
  dist:f32=wg_length3(wg_sub_f3f3(wg_add_f3f3(ro,wg_mul_f3f(rd,s)),wg_add_f3f3(a,wg_mul_f3f(ab,t))));
  r:f32=0.3f32*(1.0f32-(t*0.8f32));
  core:f32=exp(((-dist)*dist)/((r*r)*0.35f32));
  halo:f32=exp(((-dist)*dist)/((r*r)*4.0f32))*0.35f32;
  diamonds:f32=1.0f32+((0.5f32*pow(0.5f32+(0.5f32*cos((t*22.0f32)-((u[2]*30.0f32)*orbitleague_moving(u)))),6.0f32))*(1.0f32-t));
  return wg_mul_f3f(wg_mul_f3f(wg_add_f3f3(wg_mul_f3f(wg_mul_f3f(v3(0.9f32,0.97f32,1.0f32),core),diamonds),wg_mul_f3f(v3(0.25f32,0.5f32,1.0f32),halo)),(1.6f32-t)),flick);
}
// A light's glow where the ray passes it, if the light is in front of what the ray hit.
orbitleague_halo :: (ro:V3,rd:V3,p:V3,tmax:f32,r:f32)->f32 {
  s:f32=wg_dot3(wg_sub_f3f3(p,ro),rd);
  if ((s<0.0f32)||(s>(tmax+0.3f32))) {
    return 0.0f32;
  }
  dd:f32=wg_length3(wg_sub_f3f3(wg_add_f3f3(ro,wg_mul_f3f(rd,s)),p));
  return exp(((-dd)*dd)/(r*r));
}
orbitleague_lights :: (ro:V3,rd:V3,c:OrbitleagueCar,tmax:f32)->V3 {
  f:V3=v3(c.z.x,c.z.y,c.z.z);
  m:V3=wg_sub_f3f3(v3(c.p.x,c.p.y,c.p.z),ro);
  along:f32=wg_dot3(m,rd);
  if (((along<0.0f32)||((wg_dot3(m,m)-(along*along))>9.0f32))||(along>90.0f32)) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  front:f32=fmax(0.0f32,-wg_dot3(rd,f));
  back:f32=fmax(0.0f32,wg_dot3(rd,f));
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    s:f32=-1.0f32;
    while s<=1.0f32 {
      hp:V3=wg_add_f3f3(wg_sub_f3f3(wg_add_f3f3(v3(c.p.x,c.p.y,c.p.z),wg_mul_f3f(v3(c.x.x,c.x.y,c.x.z),(s*0.5f32))),wg_mul_f3f(v3(c.y.x,c.y.y,c.y.z),0.11f32)),wg_mul_f3f(f,2.16f32));
      o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(0.75f32,0.88f32,1.0f32),orbitleague_halo(ro,rd,hp,tmax,0.25f32)),front),front),1.2f32));
      s=s+2.0f32;
    }
  }
  tp:V3=wg_sub_f3f3(v3(c.p.x,c.p.y,c.p.z),wg_mul_f3f(f,2.1f32));
  o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(wg_mix_f3f3f(orbitleague_team(orbitleague_car_side(c)),v3(1.0f32,1.0f32,1.0f32),0.3f32),orbitleague_halo(ro,rd,tp,tmax,0.35f32)),back),0.5f32));
  return o;
}
// A trail of light through its points, strongest and widest at its head.
orbitleague_trail :: (ro:V3,rd:V3,k:s32,tmax:f32,width:f32,col:V3,u:[]f32)->V3 {
  b:V4=wg_at4(u,(cast(int)(k*9))*4+220);
  if (b.w<0.0f32) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  m:V3=wg_sub_f3f3(ro,v3(b.x,b.y,b.z));
  bq:f32=wg_dot3(m,rd);
  if ((wg_dot3(m,m)-(bq*bq))>(b.w*b.w)) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    i:s32=0;
    while i<7 {
      p0:V4=wg_at4(u,(cast(int)(((k*9)+1)+i))*4+220);
      p1:V4=wg_at4(u,(cast(int)(((k*9)+2)+i))*4+220);
      if ((p0.w<=0.0f32)&&(p1.w<=0.0f32)) {
        {i+=1; continue;}
      }
      ab:V3=wg_sub_f3f3(v3(p1.x,p1.y,p1.z),v3(p0.x,p0.y,p0.z));
      w0:V3=wg_sub_f3f3(ro,v3(p0.x,p0.y,p0.z));
      bb:f32=wg_dot3(rd,ab);
      cc:f32=wg_dot3(ab,ab);
      dd:f32=wg_dot3(rd,w0);
      ee:f32=wg_dot3(ab,w0);
      den:f32=cc-(bb*bb);
      t:f32=0.0f32;
      if (den>1e-6f32) {
        t=clampf((ee-(bb*dd))/den,0.0f32,1.0f32);
      }
      q:V3=wg_add_f3f3(v3(p0.x,p0.y,p0.z),wg_mul_f3f(ab,t));
      s:f32=wg_dot3(wg_sub_f3f3(q,ro),rd);
      if ((s<0.0f32)||(s>tmax)) {
        {i+=1; continue;}
      }
      dist:f32=wg_length3(wg_sub_f3f3(wg_add_f3f3(ro,wg_mul_f3f(rd,s)),q));
      age:f32=((cast(f32)(i))+t)/7.0f32;
      r:f32=width*(1.0f32-(0.7f32*age));
      o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(col,((exp(((-dist)*dist)/((r*r)*0.2f32))*0.9f32)+(exp(((-dist)*dist)/(r*r))*0.3f32))),mix(p0.w,p1.w,t)),(1.0f32-age)));
      i+=1;
    }
  }
  return o;
}
// The goal's blast: a shell of light in the scorer's colour, and a flash at its heart.
orbitleague_blast_r :: (age:f32)->f32 {
  return 1.5f32+(28.0f32*(1.0f32-exp((-age)*2.2f32)));
}
orbitleague_blast_fade :: (age:f32)->f32 {
  k:f32=1.0f32-clampf(age/1.6f32,0.0f32,1.0f32);
  return k*k;
}
orbitleague_blast :: (ro:V3,rd:V3,tmax:f32,u:[]f32)->V3 {
  age:f32=u[331];
  if (age<0.0f32) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  c:V3=v3(u[328],u[329],u[330]);
  r:f32=orbitleague_blast_r(age);
  s:f32=wg_dot3(wg_sub_f3f3(c,ro),rd);
  dd:f32=wg_length3(wg_sub_f3f3(wg_add_f3f3(ro,wg_mul_f3f(rd,s)),c));
  if (((s<(-r))||(dd>(r+6.0f32)))||((s-r)>tmax)) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  rim:f32=exp(-pow((r-dd)/(1.0f32+(r*0.15f32)),2.0f32));
  col:V3=wg_mix_f3f3f(orbitleague_team(u[332]),v3(1.0f32,1.0f32,1.0f32),0.3f32);
  heart:f32=(exp(((-dd)*dd)/(8.0f32+(age*60.0f32)))*fmax(0.0f32,1.0f32-(age*1.6f32)))*2.5f32;
  return wg_add_f3f3(wg_mul_f3f(wg_mul_f3f(col,((rim*2.2f32)+(0.2f32*stepf(dd,r)))),orbitleague_blast_fade(age)),wg_mul_f3f(wg_mix_f3f3f(col,v3(1.0f32,1.0f32,1.0f32),0.6f32),heart));
}
orbitleague_qrot :: (q:V4,v:V3)->V3 {
  t:V3=wg_mul_ff3(2.0f32,wg_cross3(v3(q.x,q.y,q.z),v));
  return wg_add_f3f3(wg_add_f3f3(v,wg_mul_ff3(q.w,t)),wg_cross3(v3(q.x,q.y,q.z),t));
}
orbitleague_ball_hit :: (ro:V3,rd:V3,u:[]f32)->OrbitleagueHit {
  m:V3=wg_sub_f3f3(ro,v3(u[40],u[41],u[42]));
  b:f32=wg_dot3(m,rd);
  c:f32=wg_dot3(m,m)-(u[43]*u[43]);
  disc:f32=(b*b)-c;
  if (disc<0.0f32) {
    return orbitleague_miss();
  }
  t:f32=(-b)-sqrt(disc);
  if (t<0.0f32) {
    return orbitleague_miss();
  }
  n:V3=wg_normalize3(wg_add_f3f3(m,wg_mul_f3f(rd,t)));
  // its seams in its own frame: three great circles that glow, and a cap at each pole
  l:V3=orbitleague_qrot(wg_make_f4_f3f(wg_neg_f3(v3(u[44],u[45],u[46])),u[47]),n);
  a:V3=wg_abs_f3(l);
  seam:f32=fmin(fmin(a.x,a.y),a.z);
  pole:f32=fmax(fmax(a.x,a.y),a.z);
  col:V3=v3(0.90f32,0.92f32,0.96f32);
  if (pole>0.965f32) {
    col=v3(0.30f32,0.36f32,0.48f32);
  }
  return OrbitleagueHit.{t=t,n=n,col=col,ink=1.0f32-smoothstep(0.03f32,0.055f32,seam),mat=4};
}
// How a hit looks in the light (not the floor).
orbitleague_shade_hit :: (h:OrbitleagueHit,rd:V3,u:[]f32)->V3 {
  n:V3=h.n;
  if (h.mat==3) {
    return h.col;
  }
  l:f32=orbitleague_flat_light(n);
  r:V3=wg_reflect3(rd,n);
  fres:f32=pow(1.0f32-abs(wg_dot3(n,wg_neg_f3(rd))),4.0f32);
  c:V3=wg_mul_f3f(h.col,l);
  if (h.mat==1) {
    c=wg_mix_f3f3f(c,orbitleague_env(r),0.06f32+(0.5f32*fres));
    c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(1.0f32,1.0f32,1.0f32),smoothstep(0.93f32,0.97f32,wg_dot3(r,orbitleague_sun()))),0.7f32));
  } else if (h.mat==2) {
    c=wg_add_f3f3(wg_add_f3f3(h.col,wg_mul_f3f(orbitleague_env(r),0.9f32)),wg_mul_f3f(wg_mul_f3f(v3(1.0f32,1.0f32,1.0f32),smoothstep(0.9f32,0.95f32,wg_dot3(r,orbitleague_sun()))),0.6f32));
  } else if (h.mat==4) {
    c=wg_mix_f3f3f(c,orbitleague_env(r),0.05f32+(0.3f32*fres));
    glow:f32=clampf(u[88]/25.0f32,0.0f32,1.0f32);
    return wg_mix_f3f3f(c,wg_mix_f3f3f(v3(0.05f32,0.06f32,0.09f32),wg_mul_f3f(v3(0.6f32,0.9f32,1.0f32),1.6f32),0.2f32+(0.8f32*glow)),h.ink);
  }
  // a rim of light from the planet
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.15f32,0.3f32,0.6f32),pow(1.0f32-abs(wg_dot3(n,wg_neg_f3(rd))),3.0f32)),0.5f32));
  return wg_mix_f3f3f(c,v3(0.01f32,0.015f32,0.03f32),clampf(h.ink,0.0f32,1.0f32)*0.85f32);
}
// ---- the arena
// ?arena=drum: the inside of a drum along z on the floor (verse/drum.coax),
// its radius u.goal.z. The floor is its curve all the way round.
orbitleague_in_drum :: (u:[]f32)->bool {
  return u[86]>0.0f32;
}
// ?arena=sphere: the inside of a sphere on the floor (verse/sphere.coax),
// radius -u.goal.z, spun about z, with a goal cap u.goal.w round at each pole.
orbitleague_in_sphere :: (u:[]f32)->bool {
  return u[86]<0.0f32;
}
orbitleague_curved :: (u:[]f32)->bool {
  return u[86]!=0.0f32;
}
orbitleague_sr :: (u:[]f32)->f32 {
  return -u[86];
}
orbitleague_sph_c :: (u:[]f32)->V3 {
  return v3(0.0f32,orbitleague_sr(u),0.0f32);
}
// Where a ray from inside leaves through the sphere.
orbitleague_sph_t :: (ro:V3,rd:V3,u:[]f32)->f32 {
  o:V3=wg_sub_f3f3(ro,orbitleague_sph_c(u));
  b:f32=wg_dot3(o,rd);
  c:f32=wg_dot3(o,o)-(orbitleague_sr(u)*orbitleague_sr(u));
  disc:f32=(b*b)-c;
  if (disc<0.0f32) {
    return 1e9f32;
  }
  t:f32=(-b)+sqrt(disc);
  return ifx t>0.0f32 then t else 1e9f32;
}
orbitleague_sph_n :: (p:V3,u:[]f32)->V3 {
  return wg_normalize3(wg_sub_f3f3(orbitleague_sph_c(u),p));
}
// p's floor coordinates: round the axis from the lowest point, and toward the +z pole.
orbitleague_sph_uv :: (p:V3,u:[]f32)->V2 {
  d:V3=wg_normalize3(wg_sub_f3f3(p,orbitleague_sph_c(u)));
  return v2(orbitleague_sr(u)*wg_atan2(d.x,-d.y),orbitleague_sr(u)*wg_asin(clampf(d.z,-1.0f32,1.0f32)));
}
// The surface's point at floor coordinates x, z (verse/sphere.coax sphere_at).
orbitleague_sph_at :: (x:f32,z:f32,u:[]f32)->V3 {
  a:f32=x/orbitleague_sr(u);
  f:f32=z/orbitleague_sr(u);
  return v3((orbitleague_sr(u)*cos(f))*sin(a),orbitleague_sr(u)-((orbitleague_sr(u)*cos(f))*cos(a)),orbitleague_sr(u)*sin(f));
}
// The curve's up at p, the drum's or the sphere's.
orbitleague_curve_n :: (p:V3,u:[]f32)->V3 {
  if orbitleague_in_sphere(u) {
    return orbitleague_sph_n(p,u);
  }
  return orbitleague_drum_n(p,u);
}
// The sphere's deck: the box's markings round its middle, lit rings of
// latitude, and at each pole its goal: a cap in the team's colour behind a
// net, ringed in light.
orbitleague_sph_col :: (p:V3,u:[]f32,ft:V3)->V3 {
  q:V2=orbitleague_sph_uv(p,u);
  c:V3=orbitleague_deck_col(v3(q.x,0.0f32,q.y),1e4f32,u,ft);
  hoop:f32=0.0f32;
  {
    k:s32=0;
    while k<4 {
      hoop=fmax(hoop,1.0f32-smoothstep(0.12f32,0.3f32,abs(abs(q.y)-(8.0f32+((cast(f32)(k))*7.0f32)))));
      k+=1;
    }
  }
  c=wg_mix_f3f3f(c,v3(0.6f32,1.0f32,0.95f32),hoop*0.4f32);
  side:V3=ifx p.z>0.0f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
  rho:f32=wg_length2(wg_sub_f2f2(v2(p.x,p.y),wg_sw_xy_f3(orbitleague_sph_c(u))));
  gr:f32=u[87];
  if (rho<gr) {
    fi:f32=ft.x*sqrt(1.0f32+fmin(((ft.y*ft.y)+(ft.z*ft.z)),2500.0f32));
    mesh:f32=orbitleague_grid(v2(p.x,p.y),0.6f32,0.0275f32,0.025f32,fi,fi);
    c=wg_mix_f3f3f(wg_mul_f3f(side,0.35f32),wg_mul_f3f(side,1.3f32),mesh*0.7f32);
  }
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_mix_f3f3f(side,v3(1.0f32,1.0f32,1.0f32),0.3f32),exp(-pow((rho-gr)/0.25f32,2.0f32))),1.2f32));
  return c;
}
// Where a ray from inside leaves through the curve.
orbitleague_drum_t :: (ro:V3,rd:V3,u:[]f32)->f32 {
  r:f32=u[86];
  o:V2=v2(ro.x,ro.y-r);
  a:f32=wg_dot2(v2(rd.x,rd.y),v2(rd.x,rd.y));
  if (a<1e-8f32) {
    return 1e9f32;
  }
  b:f32=wg_dot2(o,v2(rd.x,rd.y));
  c:f32=wg_dot2(o,o)-(r*r);
  disc:f32=(b*b)-(a*c);
  if (disc<0.0f32) {
    return 1e9f32;
  }
  t:f32=((-b)+sqrt(disc))/a;
  return ifx t>0.0f32 then t else 1e9f32;
}
// The curve's up (toward the axis) at p, and p unrolled: the distance round
// from the floor's lowest line, and z.
orbitleague_drum_n :: (p:V3,u:[]f32)->V3 {
  return wg_normalize3(v3(-p.x,u[86]-p.y,0.0f32));
}
orbitleague_drum_uv :: (p:V3,u:[]f32)->V2 {
  return v2(u[86]*wg_atan2(p.x,u[86]-p.y),p.z);
}
// The floor's point at unrolled x, z, and its up.
orbitleague_drum_at :: (x:f32,z:f32,u:[]f32)->V3 {
  a:f32=x/u[86];
  return v3(u[86]*sin(a),u[86]*(1.0f32-cos(a)),z);
}
// How high something at p stands over the floor under it.
orbitleague_over_floor :: (p:V3,u:[]f32)->f32 {
  if orbitleague_in_sphere(u) {
    return orbitleague_sr(u)-wg_length3(wg_sub_f3f3(p,orbitleague_sph_c(u)));
  }
  if orbitleague_in_drum(u) {
    return u[86]-wg_length2(v2(p.x,p.y-u[86]));
  }
  return p.y;
}
// The drum's deck: the box's markings unrolled round it, and a lit hoop every 20 m.
orbitleague_drum_col :: (p:V3,u:[]f32,ft:V3)->V3 {
  q:V2=orbitleague_drum_uv(p,u);
  c:V3=orbitleague_deck_col(v3(q.x,0.0f32,q.y),1e4f32,u,ft);
  hz:f32=u[81];
  hoop:f32=0.0f32;
  {
    k:s32=0;
    while k<4 {
      hoop=fmax(hoop,1.0f32-smoothstep(0.12f32,0.3f32,abs(q.y-((-30.0f32)+((cast(f32)(k))*20.0f32)))));
      k+=1;
    }
  }
  c=wg_mix_f3f3f(c,v3(0.6f32,1.0f32,0.95f32),hoop*0.5f32);
  // the ends' rims
  side:V3=ifx p.z>0.0f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(side,(1.0f32-smoothstep(0.0f32,0.6f32,hz-abs(p.z)))),0.6f32));
  return c;
}
orbitleague_floor_col :: (p:V3,u:[]f32,ft:V3)->V3 {
  return orbitleague_deck_col(p,u[80],u,ft);
}
// ---- lines that hold at every distance: a pixel's footprint on a surface, and a line or a
// grid filtered over it, so they never alias, shimmer or break into moire.
// The angle a pixel spans (radians): the ray's step across one pixel at the middle of the view.
orbitleague_pixel_angle :: (u:[]f32)->f32 {
  return (2.0f32*wg_length3(v3(u[36],u[37],u[38])))/(u[1]*wg_length3(v3(u[28],u[29],u[30])));
}
// A surface's footprint frame for a ray rd meeting it at t, its normal n and its two axes a and
// b: x, how wide a pixel is there head on (metres), y and z, how much it stretches along a and b
// (the ray's slant along each over its slant into the surface).
orbitleague_foot :: (rd:V3,t:f32,n:V3,a:V3,b:V3,u:[]f32)->V3 {
  c:f32=fmax(abs(wg_dot3(rd,n)),0.02f32);
  return v3(t*orbitleague_pixel_angle(u),wg_dot3(rd,a)/c,wg_dot3(rd,b)/c);
}
// The footprint (metres) across a line whose distance grows along (ax, bz) in the surface.
orbitleague_fw :: (ft:V3,ax:f32,bz:f32)->f32 {
  s:f32=(ax*ft.y)+(bz*ft.z);
  return ft.x*sqrt(1.0f32+fmin(s*s,2500.0f32));
}
// How much of a pixel f wide a line covers at distance d from its middle: half width hw, its
// edge soft over `soft`. A line thinner than a pixel draws a pixel and a half wide, as faint as
// it is thin (its light kept, so it never flickers in and out).
orbitleague_aa :: (d:f32,hw:f32,soft:f32,f:f32)->f32 {
  ff:f32=fmax(f,1e-6f32);
  hh:f32=fmax(hw,0.7f32*ff);
  e:f32=fmax(soft,ff);
  return (1.0f32-smoothstep(hh-(0.5f32*e),hh+(0.5f32*e),d))*(hw/hh);
}
// Lines every `period` across x, as orbitleague_aa; where the cells shrink under four pixels
// they fade to their mean cover, so far away a grid is an even tint and never moire.
orbitleague_lines :: (x:f32,period:f32,hw:f32,soft:f32,f:f32)->f32 {
  d:f32=abs(fract((x/period)+0.5f32)-0.5f32)*period;
  a:f32=orbitleague_aa(d,hw,soft,f);
  m:f32=fmin(1.0f32,(2.0f32*hw)/period);
  return m+((a-m)*smoothstep(2.0f32,4.0f32,period/fmax(f,1e-6f32)));
}
// A square grid on (x, y) of lines every `period`, pixels fx and fy wide along x and y.
orbitleague_grid :: (q:V2,period:f32,hw:f32,soft:f32,fx:f32,fy:f32)->f32 {
  a:f32=orbitleague_lines(q.x,period,hw,soft,fx);
  b:f32=orbitleague_lines(q.y,period,hw,soft,fy);
  return 1.0f32-((1.0f32-a)*(1.0f32-b));
}
// The deck with its edge strip at hx (the drum's has none: it goes on round).
orbitleague_deck_col :: (p:V3,hx:f32,u:[]f32,ft:V3)->V3 {
  hz:f32=u[81];
  gw:f32=u[83];
  c:V3=ifx p.z>0.0f32 then v3(0.11f32,0.075f32,0.125f32) else v3(0.075f32,0.09f32,0.135f32);
  // the deck's plates, five metres a side
  fx:f32=orbitleague_fw(ft,1.0f32,0.0f32);
  fz:f32=orbitleague_fw(ft,0.0f32,1.0f32);
  c=wg_mul_f3f(c,1.0f32-(0.25f32*orbitleague_grid(v2(p.x,p.z),5.0f32,0.05f32,0.04f32,fx,fz)));
  // the markings, filtered over the pixel (orbitleague_aa)
  line:f32=0.0f32;
  line=fmax(line,orbitleague_aa(abs(p.z),0.13f32,0.06f32,fz));
  rl:f32=fmax(wg_length2(v2(p.x,p.z)),1e-3f32);
  line=fmax(line,orbitleague_aa(abs(rl-9.0f32),0.13f32,0.06f32,orbitleague_fw(ft,p.x/rl,p.z/rl)));
  box:V2=v2(abs(p.x)-(gw+5.0f32),abs(p.z)-(hz-12.0f32));
  line=fmax(line,(orbitleague_aa(abs(box.y),0.13f32,0.06f32,fz)*stepf(abs(p.x),gw+5.0f32))*stepf(abs(p.z),hz));
  line=fmax(line,(orbitleague_aa(abs(box.x),0.13f32,0.06f32,fx)*stepf(hz-12.0f32,abs(p.z)))*stepf(abs(p.z),hz));
  line=fmax(line,orbitleague_aa(abs(abs(p.z)-hz),0.13f32,0.06f32,fz)*stepf(abs(p.x),gw));
  side:V3=ifx p.z>0.0f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
  c=wg_mix_f3f3f(c,wg_mix_f3f3f(v3(0.85f32,0.9f32,1.0f32),side,0.35f32),line*0.85f32);
  // a strip of light round the edge
  edge:f32=fmin(hx-abs(p.x),hz-abs(p.z));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(side,(1.0f32-smoothstep(0.0f32,0.6f32,edge))),0.6f32),stepf(gw,abs(p.x)+(stepf(abs(p.z),hz)*99.0f32))));
  return c;
}
// Shadows straight down: soft discs under the ball and the cars.
orbitleague_shadow :: (p:V3,u:[]f32)->f32 {
  k:f32=1.0f32;
  bd:f32=wg_length2(wg_sub_f2f2(v2(p.x,p.z),v2(u[40],u[42])));
  bh:f32=fmax(u[41]-p.y,0.0f32);
  k=k*(1.0f32-((0.55f32*(1.0f32-smoothstep(u[43]*0.6f32,u[43]*(1.1f32+(bh*0.05f32)),bd)))*stepf(p.y,u[41])));
  {
    i:s32=0;
    while i<orbitleague_ncars(u) {
      c:OrbitleagueCar=orbitleague_car(i,u);
      q:V3=wg_sub_f3f3(p,v3(c.p.x,c.p.y,c.p.z));
      lx:f32=abs(wg_dot2(v2(q.x,q.z),v2(c.x.x,c.x.z)));
      lz:f32=abs(wg_dot2(v2(q.x,q.z),v2(c.z.x,c.z.z)));
      h:f32=fmax(c.p.y-p.y,0.0f32);
      s:f32=(1.0f32-smoothstep(0.85f32,1.3f32+(h*0.05f32),lx))*(1.0f32-smoothstep(1.9f32,2.4f32+(h*0.05f32),lz));
      k=k*(1.0f32-((0.5f32*s)*stepf(p.y,c.p.y)));
      i+=1;
    }
  }
  return k;
}
// The same on the drum's curve: each thing's shadow falls straight out from the axis.
orbitleague_drum_shadow :: (p:V3,u:[]f32)->f32 {
  n:V3=orbitleague_curve_n(p,u);
  k:f32=1.0f32;
  bq:V3=wg_sub_f3f3(v3(u[40],u[41],u[42]),p);
  bh:f32=wg_dot3(bq,n);
  bd:f32=wg_length3(wg_sub_f3f3(bq,wg_mul_f3f(n,bh)));
  k=k*(1.0f32-((0.55f32*(1.0f32-smoothstep(u[43]*0.6f32,u[43]*(1.1f32+(fmax(bh,0.0f32)*0.05f32)),bd)))*stepf(0.0f32,bh)));
  {
    i:s32=0;
    while i<orbitleague_ncars(u) {
      c:OrbitleagueCar=orbitleague_car(i,u);
      q:V3=wg_sub_f3f3(v3(c.p.x,c.p.y,c.p.z),p);
      h:f32=wg_dot3(q,n);
      f:V3=wg_sub_f3f3(q,wg_mul_f3f(n,h));
      lx:f32=abs(wg_dot3(f,v3(c.x.x,c.x.y,c.x.z)));
      lz:f32=abs(wg_dot3(f,v3(c.z.x,c.z.y,c.z.z)));
      s:f32=(1.0f32-smoothstep(0.85f32,1.3f32+(fmax(h,0.0f32)*0.05f32),lx))*(1.0f32-smoothstep(1.9f32,2.4f32+(fmax(h,0.0f32)*0.05f32),lz));
      k=k*(1.0f32-((0.5f32*s)*stepf(0.0f32,h)));
      i+=1;
    }
  }
  return k;
}
// The boost pads: a ring that fills as it gets ready, and a lit disc when it is.
ORBITLEAGUE_PAD_COL :: ()->V3 {return v3(0.75f32,0.9f32,1.0f32);}
orbitleague_pads :: (p:V3,u:[]f32)->V3 {
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    i:s32=0;
    while i<16 {
      pd:V4=wg_at4(u,(cast(int)i)*4+336);
      d:f32=wg_length2(wg_sub_f2f2(v2(p.x,p.z),v2(pd.x,pd.y)));
      r:f32=ifx pd.z>0.5f32 then 1.5f32 else 0.9f32;
      if (d>(r+0.6f32)) {
        {i+=1; continue;}
      }
      ready:bool=pd.w>=0.999f32;
      // the ring fills round as it recharges
      a:f32=(wg_atan2(p.x-pd.x,p.z-pd.y)/6.2831853f32)+0.5f32;
      lit:f32=ifx ready||(a<pd.w) then 0.9f32 else 0.18f32;
      o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(ORBITLEAGUE_PAD_COL(),exp(-pow((d-r)/0.09f32,2.0f32))),lit));
      if ready {
        pulse:f32=0.8f32+((0.2f32*orbitleague_moving(u))*sin((u[2]*4.0f32)+(cast(f32)(i))));
        o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(ORBITLEAGUE_PAD_COL(),(1.0f32-smoothstep(r*0.55f32,r*0.8f32,d))),0.45f32),pulse));
      }
      i+=1;
    }
  }
  return o;
}
// A big pad's floating orb, when it is ready.
orbitleague_pad_orbs :: (ro:V3,rd:V3,tmax:f32,u:[]f32)->V3 {
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    i:s32=0;
    while i<6 {
      pd:V4=wg_at4(u,(cast(int)i)*4+336);
      if (pd.w<0.999f32) {
        {i+=1; continue;}
      }
      bob:f32=1.3f32+((0.15f32*orbitleague_moving(u))*sin((u[2]*2.0f32)+(cast(f32)(i))));
      at:V3=v3(pd.x,bob,pd.y);
      if orbitleague_in_drum(u) {
        f:V3=orbitleague_drum_at(pd.x,pd.y,u);
        at=wg_add_f3f3(f,wg_mul_f3f(orbitleague_drum_n(f,u),bob));
      }
      if orbitleague_in_sphere(u) {
        f:V3=orbitleague_sph_at(pd.x,pd.y,u);
        at=wg_add_f3f3(f,wg_mul_f3f(orbitleague_sph_n(f,u),bob));
      }
      o=wg_add_f3f3(o,wg_mul_f3f(ORBITLEAGUE_PAD_COL(),((orbitleague_halo(ro,rd,at,tmax,0.35f32)*1.4f32)+(orbitleague_halo(ro,rd,at,tmax,1.0f32)*0.25f32))));
      i+=1;
    }
  }
  return o;
}
// Each car's glow on the floor under it, in its team's colour.
orbitleague_underglow :: (p:V3,u:[]f32)->V3 {
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    i:s32=0;
    while i<orbitleague_ncars(u) {
      c:OrbitleagueCar=orbitleague_car(i,u);
      q:V3=wg_sub_f3f3(p,v3(c.p.x,c.p.y,c.p.z));
      lx:f32=wg_dot3(q,v3(c.x.x,c.x.y,c.x.z));
      lz:f32=wg_dot3(q,v3(c.z.x,c.z.y,c.z.z));
      o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(orbitleague_team(orbitleague_car_side(c)),exp(-(((lx*lx)/1.1f32)+((lz*lz)/5.0f32)))),clampf(1.8f32-orbitleague_over_floor(v3(c.p.x,c.p.y,c.p.z),u),0.0f32,1.0f32)),0.4f32));
      i+=1;
    }
  }
  return o;
}
// What moves (the ball and the cars), and what moves or stands in the arena (and the goal frames).
orbitleague_movers :: (ro:V3,rd:V3,u:[]f32,HULL:[45]V4,mesh:[]f32,seen:bool)->OrbitleagueHit {
  h:OrbitleagueHit=orbitleague_ball_hit(ro,rd,u);
  {
    i:s32=0;
    while i<orbitleague_ncars(u) {
      h=orbitleague_closer(h,orbitleague_car_hit(ro,rd,orbitleague_car(i,u),HULL,mesh,seen));
      i+=1;
    }
  }
  return h;
}
// The station's ribs: four arches over the glass, outside it, each with a light at its crown.
orbitleague_ribs :: (ro:V3,rd:V3,u:[]f32)->OrbitleagueHit {
  hx:f32=u[80];
  hh:f32=u[82];
  h:OrbitleagueHit=orbitleague_miss();
  steel:V3=v3(0.11f32,0.12f32,0.15f32);
  {
    k:s32=0;
    while k<4 {
      z:f32=(-30.0f32)+((cast(f32)(k))*20.0f32);
      // only a ray that passes the arch's plane near the arch
      tz:f32=(z-ro.z)/rd.z;
      q:V3=wg_add_f3f3(ro,wg_mul_f3f(rd,tz));
      if (((((abs(rd.z)<1e-5f32)||(tz<0.0f32))||(abs(q.x)>(hx+3.0f32)))||(q.y>(hh+3.0f32)))||((abs(q.x)<(hx-1.0f32))&&(q.y<(hh-1.0f32)))) {
        {k+=1; continue;}
      }
      h=orbitleague_closer(h,orbitleague_box_hit(ro,rd,v3(0.0f32,hh+1.0f32,z),v3(hx+1.4f32,0.45f32,0.6f32),steel,0));
      h=orbitleague_closer(h,orbitleague_box_hit(ro,rd,v3(hx+0.95f32,hh*0.5f32,z),v3(0.45f32,(hh*0.5f32)+1.4f32,0.6f32),steel,0));
      h=orbitleague_closer(h,orbitleague_box_hit(ro,rd,v3((-hx)-0.95f32,hh*0.5f32,z),v3(0.45f32,(hh*0.5f32)+1.4f32,0.6f32),steel,0));
      k+=1;
    }
  }
  return h;
}
orbitleague_rib_lights :: (ro:V3,rd:V3,tmax:f32,u:[]f32)->V3 {
  hx:f32=u[80];
  hh:f32=u[82];
  o:V3=v3(0.0f32,0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      z:f32=(-30.0f32)+((cast(f32)(k))*20.0f32);
      blink:f32=ifx u[4]<0.5f32 then 0.25f32+(0.75f32*stepf(0.5f32,fract((u[2]*0.5f32)+((cast(f32)(k))*0.25f32)))) else 1.0f32;
      {
        s:f32=-1.0f32;
        while s<=1.0f32 {
          o=wg_add_f3f3(o,wg_mul_f3f(wg_mul_f3f(v3(0.6f32,1.0f32,0.95f32),orbitleague_halo(ro,rd,v3(s*(hx+0.95f32),hh+1.5f32,z),tmax,0.35f32)),blink));
          s=s+2.0f32;
        }
      }
      k+=1;
    }
  }
  return o;
}
// The glass the ray leaves the arena through, and the nets it passes: their
// colour over what is behind, how much, and the light they add (their edge
// lights, and the ball and cars reflected in them).
OrbitleagueGlass :: struct {t:f32; col:V3; a:f32; add:V3; }
orbitleague_glass :: (ro:V3,rd:V3,tmax:f32,u:[]f32,HULL:[45]V4,mesh:[]f32)->OrbitleagueGlass {
  hx:f32=u[80];
  hz:f32=u[81];
  hh:f32=u[82];
  gw:f32=u[83];
  gh:f32=u[84];
  gd:f32=u[85];
  out:OrbitleagueGlass=OrbitleagueGlass.{t=1e9f32,col=v3(0.0f32,0.0f32,0.0f32),a=0.0f32,add=v3(0.0f32,0.0f32,0.0f32)};
  // the sphere has no glass: its goals are in its curve
  if orbitleague_in_sphere(u) {
    return out;
  }
  // the exit: the nearest face ahead
  t:f32=1e9f32;
  n:V3=v3(0.0f32,0.0f32,0.0f32);
  drum:bool=orbitleague_in_drum(u);
  // the drum's only glass is its ends
  if ((!drum)&&(rd.x>0.0f32)) {
    s:f32=(hx-ro.x)/rd.x;
    if (s<t) {
      t=s;
      n=v3(1.0f32,0.0f32,0.0f32);
    }
  }
  if ((!drum)&&(rd.x<0.0f32)) {
    s:f32=((-hx)-ro.x)/rd.x;
    if (s<t) {
      t=s;
      n=v3(-1.0f32,0.0f32,0.0f32);
    }
  }
  if ((!drum)&&(rd.y>0.0f32)) {
    s:f32=(hh-ro.y)/rd.y;
    if (s<t) {
      t=s;
      n=v3(0.0f32,1.0f32,0.0f32);
    }
  }
  if (rd.z>0.0f32) {
    s:f32=(hz-ro.z)/rd.z;
    if (s<t) {
      t=s;
      n=v3(0.0f32,0.0f32,1.0f32);
    }
  }
  if (rd.z<0.0f32) {
    s:f32=((-hz)-ro.z)/rd.z;
    if (s<t) {
      t=s;
      n=v3(0.0f32,0.0f32,-1.0f32);
    }
  }
  if ((t>tmax)||(t>1e8f32)) {
    return out;
  }
  p:V3=wg_add_f3f3(ro,wg_mul_f3f(rd,t));
  mouth:bool=((n.z!=0.0f32)&&(abs(p.x)<gw))&&(p.y<gh);
  if (!mouth) {
    uv:V2=v2(p.x,p.z);
    if (n.x!=0.0f32) {
      uv=v2(p.z,p.y);
    } else if (n.z!=0.0f32) {
      uv=v2(p.x,p.y);
    }
    // glass in a frame of thin struts every 5 metres
    ga:V3=v3(1.0f32,0.0f32,0.0f32);
    gb:V3=v3(0.0f32,0.0f32,1.0f32);
    if (n.x!=0.0f32) {
      ga=v3(0.0f32,0.0f32,1.0f32);
      gb=v3(0.0f32,1.0f32,0.0f32);
    } else if (n.z!=0.0f32) {
      gb=v3(0.0f32,1.0f32,0.0f32);
    }
    gf:V3=orbitleague_foot(rd,t,n,ga,gb,u);
    strut:f32=orbitleague_grid(uv,5.0f32,0.06f32,0.06f32,orbitleague_fw(gf,1.0f32,0.0f32),orbitleague_fw(gf,0.0f32,1.0f32));
    // the distance to the face's edge (not along its own axis)
    e:f32=fmin(hx-abs(p.x),hz-abs(p.z));
    if (n.x!=0.0f32) {
      e=fmin(hz-abs(p.z),fmin(p.y,hh-p.y));
    }
    if (n.z!=0.0f32) {
      e=fmin(hx-abs(p.x),fmin(p.y,hh-p.y));
    }
    if drum {
      e=u[86]-wg_length2(v2(p.x,p.y-u[86]));
    }
    side:V3=ifx p.z>0.0f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
    fres:f32=pow(1.0f32-abs(wg_dot3(rd,n)),4.0f32);
    col:V3=wg_mix_f3f3f(v3(0.30f32,0.45f32,0.65f32),side,0.35f32);
    a:f32=(0.035f32+(0.3f32*fres))+(strut*0.2f32);
    // broad diagonal streaks, as light lies on glass
    sh:f32=fract(((((uv.x*0.8f32)+uv.y)*0.045f32)+(n.x*0.3f32))+(n.z*0.6f32));
    a=a+(0.07f32*((smoothstep(0.0f32,0.03f32,sh)*(1.0f32-smoothstep(0.03f32,0.12f32,sh)))+((0.5f32*smoothstep(0.2f32,0.22f32,sh))*(1.0f32-smoothstep(0.22f32,0.26f32,sh)))));
    if (n.z!=0.0f32) {
      col=wg_mix_f3f3f(col,side,0.4f32);
      a=a+0.03f32;
    }
    // light along the arena's edges
    add:V3=wg_mul_f3f(wg_mul_f3f(wg_mix_f3f3f(side,v3(1.0f32,1.0f32,1.0f32),0.25f32),exp(((-e)*e)/0.03f32)),0.9f32);
    // the ball and the cars, reflected
    rr:V3=wg_reflect3(rd,n);
    rh:OrbitleagueHit=orbitleague_movers(wg_sub_f3f3(p,wg_mul_f3f(n,0.02f32)),rr,u,HULL,mesh,false);
    if (rh.t<80.0f32) {
      add=wg_add_f3f3(add,wg_mul_f3f(wg_mul_f3f(orbitleague_shade_hit(rh,rr,u),(0.16f32+(0.4f32*fres))),exp((-rh.t)*0.02f32)));
    }
    return OrbitleagueGlass.{t=t,col=col,a=clampf(a,0.0f32,1.0f32),add=add};
  }
  // into a goal: its net (back, sides, roof)
  zs:f32=wg_sign(n.z);
  tn:f32=1e9f32;
  nn:V3=v3(0.0f32,0.0f32,0.0f32);
  back:f32=((zs*(hz+gd))-ro.z)/rd.z;
  if (back>t) {
    tn=back;
    nn=v3(0.0f32,0.0f32,zs);
  }
  if (rd.x>0.0f32) {
    s:f32=(gw-ro.x)/rd.x;
    if ((s>t)&&(s<tn)) {
      tn=s;
      nn=v3(1.0f32,0.0f32,0.0f32);
    }
  }
  if (rd.x<0.0f32) {
    s:f32=((-gw)-ro.x)/rd.x;
    if ((s>t)&&(s<tn)) {
      tn=s;
      nn=v3(-1.0f32,0.0f32,0.0f32);
    }
  }
  if (rd.y>0.0f32) {
    s:f32=(gh-ro.y)/rd.y;
    if ((s>t)&&(s<tn)) {
      tn=s;
      nn=v3(0.0f32,1.0f32,0.0f32);
    }
  }
  if (tn>tmax) {
    return out;
  }
  q:V3=wg_add_f3f3(ro,wg_mul_f3f(rd,tn));
  uv:V2=v2(q.x,q.y);
  na:V3=v3(1.0f32,0.0f32,0.0f32);
  nb:V3=v3(0.0f32,1.0f32,0.0f32);
  if (nn.x!=0.0f32) {
    uv=v2(q.z,q.y);
    na=v3(0.0f32,0.0f32,1.0f32);
  } else if (nn.y!=0.0f32) {
    uv=v2(q.x,q.z);
    nb=v3(0.0f32,0.0f32,1.0f32);
  }
  // the mesh's cords, filtered over the pixel: even and unbroken near, an even tint far off
  nf:V3=orbitleague_foot(rd,tn,nn,na,nb,u);
  weave:f32=orbitleague_grid(uv,0.6f32,0.0275f32,0.025f32,orbitleague_fw(nf,1.0f32,0.0f32),orbitleague_fw(nf,0.0f32,1.0f32));
  col:V3=ifx zs>0.0f32 then ORBITLEAGUE_MAGENTA() else ORBITLEAGUE_BLUE();
  return OrbitleagueGlass.{t=tn,col=wg_mul_f3f(col,1.2f32),a=clampf(0.12f32+(weave*0.65f32),0.0f32,1.0f32),add=v3(0.0f32,0.0f32,0.0f32)};
}
// The goal frames: posts and a crossbar at each mouth, lit in the team's colour.
orbitleague_frames :: (ro:V3,rd:V3,u:[]f32)->OrbitleagueHit {
