      wx:f32=ifx meshed then 0.777f32 else 0.86f32;
      x:f32=ifx (i&1)==1 then wx else -wx;
      wz:f32=ifx meshed then 1.371f32 else 1.4f32;
      z:f32=ifx i>=2 then -wz else wz;
      wo:V3=wg_sub_f3f3(o,v3(x,ifx meshed then -0.683f32 else -0.58f32,z));
      wd:V3=d;
      if (i<2) {
        // a front wheel turns with the steering
        cs:f32=cos(-steer);
        sn:f32=sin(-steer);
        wo=v3((cs*wo.x)-(sn*wo.z),wo.y,(sn*wo.x)+(cs*wo.z));
        wd=v3((cs*wd.x)-(sn*wd.z),wd.y,(sn*wd.x)+(cs*wd.z));
