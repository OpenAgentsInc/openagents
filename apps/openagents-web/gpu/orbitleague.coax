// The roadster's mesh (verse/tools/mesh-bvh.coax writes it; host.js binds it, mesh:URL): its
// triangles in a bounding volume hierarchy, in the car's frame. The nearest triangle the ray
// (o, d, in that frame) meets: t, and its corners' normals and colours blended to the point it
// meets (so curves shade smooth and a colour's edge runs smooth across the triangles), the
// normal turned to the ray's side, and how much it is paint (pw, 0 to 1: a light, unsaturated
// colour, eased over a band so paint fades into glass and trim rather than stepping). A triangle
// is 27 words (head word 8).
OrbitleagueMeshHit :: struct {t:f32; n:V3; col:V3; pw:f32; }
orbitleague_mesh_cast :: (o:V3,d:V3,mesh:[]f32)->OrbitleagueMeshHit {
  r:OrbitleagueMeshHit=OrbitleagueMeshHit.{t=1e9f32,n=v3(0.0f32,1.0f32,0.0f32),col=v3(0.0f32,0.0f32,0.0f32),pw=0.0f32};
  dd:V3=v3(ifx abs(d.x)<1e-8f32 then 1e-8f32 else d.x,ifx abs(d.y)<1e-8f32 then 1e-8f32 else d.y,ifx abs(d.z)<1e-8f32 then 1e-8f32 else d.z);
  inv:V3=wg_div_ff3(1.0f32,dd);
  tris:s32=wg_i32_f(mesh[3]);
  best:s32=-1;
  bu:f32=0.0f32;
  bv:f32=0.0f32;
  stack:[32]s32;
  stack[0]=0;
  sp:s32=1;
  while sp>0 {
    sp-=1;
    b:s32=16+(stack[cast(int)sp]*8);
    t0:V3=wg_mul_f3f3(wg_sub_f3f3(v3(mesh[cast(int)b],mesh[cast(int)(b+1)],mesh[cast(int)(b+2)]),o),inv);
    t1:V3=wg_mul_f3f3(wg_sub_f3f3(v3(mesh[cast(int)(b+4)],mesh[cast(int)(b+5)],mesh[cast(int)(b+6)]),o),inv);
    tn:V3=wg_min_f3f3(t0,t1);
    tf:V3=wg_max_f3f3(t0,t1);
    near:f32=fmax(fmax(tn.x,tn.y),tn.z);
    far:f32=fmin(fmin(tf.x,tf.y),tf.z);
    if ((far<fmax(near,0.0f32))||(near>r.t)) {
      continue;
    }
    a:s32=wg_i32_f(mesh[cast(int)(b+3)]);
    c:s32=wg_i32_f(mesh[cast(int)(b+7)]);
    if (a>=0) {
      // the child on the ray's side of the split first (the second child is a + 1, c the axis)
      back:bool=ifx c==0 then d.x<0.0f32 else ifx c==1 then d.y<0.0f32 else d.z<0.0f32;
      if (sp<31) {
        stack[cast(int)sp]=ifx back then a else a+1;
        stack[cast(int)(sp+1)]=ifx back then a+1 else a;
        sp+=2;
      }
      continue;
    }
    k:s32=-a-1;
    while k<((-a-1)+c) {
      w:s32=tris+(k*27);
      v0:V3=v3(mesh[cast(int)w],mesh[cast(int)(w+1)],mesh[cast(int)(w+2)]);
      e1:V3=v3(mesh[cast(int)(w+3)],mesh[cast(int)(w+4)],mesh[cast(int)(w+5)]);
      e2:V3=v3(mesh[cast(int)(w+6)],mesh[cast(int)(w+7)],mesh[cast(int)(w+8)]);
      pv:V3=wg_cross3(d,e2);
      det:f32=wg_dot3(e1,pv);
      if (abs(det)>1e-12f32) {
        id:f32=1.0f32/det;
        sv:V3=wg_sub_f3f3(o,v0);
        uu:f32=wg_dot3(sv,pv)*id;
        qv:V3=wg_cross3(sv,e1);
        vv:f32=wg_dot3(d,qv)*id;
        t:f32=wg_dot3(e2,qv)*id;
        if ((((uu>=0.0f32)&&(vv>=0.0f32))&&((uu+vv)<=1.0f32))&&((t>1e-4f32)&&(t<r.t))) {
          r.t=t;
          best=w;
          bu=uu;
          bv=vv;
        }
      }
      k+=1;
    }
  }
  if (best>=0) {
    e1:V3=v3(mesh[cast(int)(best+3)],mesh[cast(int)(best+4)],mesh[cast(int)(best+5)]);
    e2:V3=v3(mesh[cast(int)(best+6)],mesh[cast(int)(best+7)],mesh[cast(int)(best+8)]);
    n:V3=wg_normalize3(wg_cross3(e1,e2));
    n=ifx wg_dot3(n,d)>0.0f32 then wg_neg_f3(n) else n;
    w0:f32=(1.0f32-bu)-bv;
    sn:V3=v3(0.0f32,0.0f32,0.0f32);
    cl:V3=v3(0.0f32,0.0f32,0.0f32);
    {
      k:s32=0;
      while k<3 {
        wk:f32=ifx k==0 then w0 else ifx k==1 then bu else bv;
        ck:s32=best+9+(k*3);
        nk:s32=best+18+(k*3);
        cl=wg_add_f3f3(cl,wg_mul_f3f(v3(mesh[cast(int)ck],mesh[cast(int)(ck+1)],mesh[cast(int)(ck+2)]),wk));
        sn=wg_add_f3f3(sn,wg_mul_f3f(v3(mesh[cast(int)nk],mesh[cast(int)(nk+1)],mesh[cast(int)(nk+2)]),wk));
        k+=1;
      }
    }
    sl:f32=wg_length3(sn);
    sn=ifx sl>1e-6f32 then wg_mul_f3f(sn,1.0f32/sl) else n;
    r.n=ifx wg_dot3(sn,n)<0.0f32 then wg_neg_f3(sn) else sn;
    r.col=cl;
    // paint: light and grey (mesh-bvh.coax mb_paint, there a hard test), eased over a band
    hi:f32=fmax(fmax(cl.x,cl.y),cl.z);
    lo:f32=fmin(fmin(cl.x,cl.y),cl.z);
    r.pw=smoothstep(0.22f32,0.38f32,hi)*(1.0f32-smoothstep(0.17f32,0.33f32,(hi-lo)/fmax(hi,1e-4f32)));
  }
  return r;
}
// A roadster of our own, or the mesh's when the page has one.
orbitleague_car_hit :: (ro:V3,rd:V3,c:OrbitleagueCar,HULL:[45]V4,mesh:[]f32,seen:bool)->OrbitleagueHit {
  q:V3=wg_sub_f3f3(ro,v3(c.p.x,c.p.y,c.p.z));
  o:V3=v3(wg_dot3(q,v3(c.x.x,c.x.y,c.x.z)),wg_dot3(q,v3(c.y.x,c.y.y,c.y.z)),wg_dot3(q,v3(c.z.x,c.z.y,c.z.z)));
  d:V3=v3(wg_dot3(rd,v3(c.x.x,c.x.y,c.x.z)),wg_dot3(rd,v3(c.y.x,c.y.y,c.y.z)),wg_dot3(rd,v3(c.z.x,c.z.y,c.z.z)));
  // the bounding sphere first
  bq:f32=wg_dot3(o,d);
  oo:f32=wg_dot3(o,o);
  if (((oo-(bq*bq))>6.8f32)||((bq>0.0f32)&&(oo>6.8f32))) {
    return orbitleague_miss();
  }
  side:f32=orbitleague_car_side(c);
  accent:V3=orbitleague_team(side);
  pk:s32=orbitleague_car_paint(c);
  paint:V3=orbitleague_paint_colour(pk%8,side);
  decal:s32=pk/8;
  h:OrbitleagueHit=orbitleague_miss();
  // the mesh for what the eye sees; its reflections are the hull roadster (a mesh per reflected ray is too slow)
  meshed:bool=seen&&(mesh[0]>0.5f32);
  if meshed {
    // the body: the mesh, its paint the car's (with the decal), its dark parts glass, a red part a light
    m:OrbitleagueMeshHit=orbitleague_mesh_cast(o,d,mesh);
    if (m.t<1e8f32) {
      p:V3=wg_add_f3f3(o,wg_mul_f3f(d,m.t));
      n:V3=m.n;
      col:V3=m.col;
      mat:s32=0;
      if ((m.col.x>0.2f32)&&(m.col.x>(3.0f32*m.col.y))) {
        col=wg_mul_f3f(m.col,2.5f32);
        mat=3;
      } else if ((fmax(fmax(m.col.x,m.col.y),m.col.z)<0.05f32)&&(n.y>0.25f32)) {
        // dark and facing up: the glass roof and the windows; dark below is trim
        mat=2;
