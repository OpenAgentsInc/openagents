      // paint, blended in by how much of it this is (the band's middle decides the material)
      if (m.pw>0.0f32) {
        pc:V3=wg_mul_f3f(paint,0.75f32+(0.25f32*clampf(((0.2126f32*m.col.x)+(0.7152f32*m.col.y))+(0.0722f32*m.col.z),0.0f32,1.0f32)));
        if (((decal==1)&&(n.y>0.5f32))&&(abs(abs(p.x)-0.26f32)<0.07f32)) {
          pc=accent;
        }
        if (((decal==2)&&(abs(n.x)>0.5f32))&&(((wg_i32_f(floor(p.z*3.0f32)+floor((p.y*3.0f32)+10.0f32)))&1)==0)) {
          pc=accent;
        }
        if ((decal==3)&&(p.z>0.35f32)) {
          pc=accent;
        }
        col=wg_mix_f3f3f(col,pc,m.pw);
        if (m.pw>0.5f32) {
          mat=1;
        }
      }
      h=OrbitleagueHit.{t=m.t,n=n,col=col,ink=0.0f32,mat=mat};
    }
  } else {
    // the body: a wedge with a dark sill, a cockpit, a stripe, headlights and a tail bar
    b:OrbitleagueHullHit=orbitleague_hull_cast(o,d,0,18,HULL);
    if (b.t<h.t) {
      p:V3=wg_add_f3f3(o,wg_mul_f3f(d,b.t));
      n:V3=b.n;
      col:V3=paint;
      mat:s32=1;
      // the decal, in the team's colour: twin stripes, side checks, or the nose
      if (((decal==1)&&(n.y>0.5f32))&&(abs(abs(p.x)-0.26f32)<0.07f32)) {
        col=accent;
      }
      if (((decal==2)&&(abs(n.x)>0.5f32))&&(((wg_i32_f(floor(p.z*3.0f32)+floor((p.y*3.0f32)+10.0f32)))&1)==0)) {
        col=accent;
      }
      if ((decal==3)&&(p.z>0.35f32)) {
        col=accent;
      }
      if ((p.y<(-0.2f32))&&(n.y<0.5f32)) {
        col=v3(0.05f32,0.055f32,0.07f32);
        mat=0;
      }
      if ((((n.y>0.9f32)&&(abs(p.x)<0.6f32))&&(p.z>(-1.0f32)))&&(p.z<0.55f32)) {
        col=v3(0.035f32,0.04f32,0.055f32);
        mat=0;
      }
      if (((n.y>0.5f32)&&(abs(p.x)<0.13f32))&&(p.z>0.6f32)) {
        col=v3(0.92f32,0.94f32,1.0f32);
      }
      if (((((n.z>0.3f32)&&(p.z>1.7f32))&&(p.y>(-0.17f32)))&&(p.y<(-0.05f32)))&&(abs(p.x)>0.2f32)) {
        col=wg_mul_f3f(v3(0.85f32,0.93f32,1.0f32),1.8f32);
        mat=3;
      }
      if (((n.z<(-0.8f32))&&(abs(p.y)<0.035f32))&&(abs(p.x)<0.8f32)) {
        col=wg_mul_f3f(wg_mix_f3f3f(accent,v3(1.0f32,1.0f32,1.0f32),0.45f32),1.8f32);
        mat=3;
      }
      h=OrbitleagueHit.{t=b.t,n=n,col=col,ink=b.edge,mat=mat};
    }
    // the fender pods over the wheels
    {
      i:s32=0;
      while i<4 {
        sx:f32=ifx (i&1)==1 then 1.0f32 else -1.0f32;
        wz:f32=ifx i>=2 then -1.4f32 else 1.4f32;
        f:OrbitleagueHullHit=orbitleague_hull_cast(v3((o.x*sx)-0.86f32,o.y,o.z-wz),v3(d.x*sx,d.y,d.z),18,11,HULL);
        if (f.t<h.t) {
          h=OrbitleagueHit.{t=f.t,n=v3(f.n.x*sx,f.n.y,f.n.z),col=paint,ink=f.edge,mat=1};
        }
        i+=1;
      }
    }
    // the windscreen
    w:OrbitleagueHullHit=orbitleague_hull_cast(o,d,29,8,HULL);
    if (w.t<h.t) {
      h=OrbitleagueHit.{t=w.t,n=w.n,col=v3(0.02f32,0.035f32,0.07f32),ink=w.edge,mat=2};
    }
    // the humps behind the seats
    {
      s:f32=-1.0f32;
      while s<=1.0f32 {
        k:OrbitleagueHullHit=orbitleague_hull_cast(v3((o.x*s)-0.32f32,o.y,o.z),v3(d.x*s,d.y,d.z),37,8,HULL);
        if (k.t<h.t) {
          h=OrbitleagueHit.{t=k.t,n=v3(k.n.x*s,k.n.y,k.n.z),col=paint,ink=k.edge,mat=1};
        }
        s=s+2.0f32;
      }
    }
    // the driver's helmet: white, a dark visor, a stripe in the team's colour
    hc:V3=v3(0.32f32,0.4f32,-0.22f32);
    ht:f32=orbitleague_sphere_t(d,wg_sub_f3f3(hc,o),0.2f32);
    if ((ht>0.0f32)&&(ht<h.t)) {
      n:V3=wg_normalize3(wg_sub_f3f3(wg_add_f3f3(o,wg_mul_f3f(d,ht)),hc));
      col:V3=v3(0.92f32,0.93f32,0.95f32);
      mat:s32=0;
      if (((n.z>0.3f32)&&(n.y<0.5f32))&&(n.y>(-0.35f32))) {
        col=v3(0.03f32,0.06f32,0.12f32);
        mat=2;
      } else if ((abs(n.x)<0.12f32)&&(n.y>0.0f32)) {
        col=accent;
        mat=1;
      }
      h=OrbitleagueHit.{t=ht,n=n,col=col,ink=0.0f32,mat=mat};
    }
    // the rear wing on two struts
    h=orbitleague_closer(h,orbitleague_box_hit(o,d,v3(0.0f32,0.43f32,-1.86f32),v3(0.9f32,0.03f32,0.17f32),v3(0.07f32,0.075f32,0.09f32),1));
    h=orbitleague_closer(h,orbitleague_box_hit(o,d,v3(0.0f32,0.405f32,-1.86f32),v3(0.92f32,0.01f32,0.175f32),accent,1));
    h=orbitleague_closer(h,orbitleague_box_hit(o,d,v3(-0.5f32,0.26f32,-1.86f32),v3(0.03f32,0.15f32,0.07f32),v3(0.07f32,0.075f32,0.09f32),0));
    h=orbitleague_closer(h,orbitleague_box_hit(o,d,v3(0.5f32,0.26f32,-1.86f32),v3(0.03f32,0.15f32,0.07f32),v3(0.07f32,0.075f32,0.09f32),0));
  }
  steer:f32=c.z.w;
  {
    i:s32=0;
    while i<4 {
