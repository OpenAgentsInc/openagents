// particles's shaders, the source of apps/openagents-web/particles.wgsl (docs/verse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (particles.module,
// particles.bindings beside it). It began as coax/web/wgsl-coax.coax's translation of the hand-written WGSL.
#load "../../../verse/gpu/wgsl.coax";
#load "../../../verse/particle-motion.coax";
#load "../../../verse/haunt-light.coax";

// A realm's particles: one instanced draw after the house, PER particles an
// emitter (verse/particles.coax), each a small quad facing the eye, added to
// the light behind it and hidden where the house is in front. Where a
// particle is and how bright comes from verse/particle-motion.coax,
// written as WGSL by coax wgsl at build time into the generated block
// below. Group 0 is the realm's uniforms (realm.wgsl U, read up to its
// panels); group 1 the frame's emitters.
// ParticlesU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   time 2
//   fade 3
//   still 4
//   panels 5
//   k 6
//   pad0 7
//   r0 8
//   r1 12
//   r2 16
//   r3 20
//   eye 24
//   flash 28
//   panel 32
ParticlesEmitter :: struct {place:V4; color:V4; shape:V4; seed:V4; }
PARTICLES_PER :: cast(u32)64;
ParticlesP :: struct {pos:V4; corner:V2; color:V3; }
particles_particle_vs :: (v:u32,n:u32,u:[]f32,emitters:[]ParticlesEmitter)->ParticlesP {
  o:ParticlesP;
  e:ParticlesEmitter=emitters[cast(int)(n/PARTICLES_PER)];
  i:f32=cast(f32)(n%PARTICLES_PER);
  quad:[6]V2=[6]V2.[v2(-1.0f32,-1.0f32),v2(1.0f32,-1.0f32),v2(-1.0f32,1.0f32),v2(-1.0f32,1.0f32),v2(1.0f32,-1.0f32),v2(1.0f32,1.0f32)];
  o.corner=quad[cast(int)v];
  if (i>=e.shape.y) {
    o.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32);
    o.color=v3(0.0f32,0.0f32,0.0f32);
    return o;
  }
  kind:f32=e.shape.x;
  t:f32=u[2];
  speed:f32=e.shape.w;
  seed:f32=e.seed.x;
  off:V3=v3(verse_particle_offset(kind,seed,i,t,speed,e.place.w,0.0f32),verse_particle_offset(kind,seed,i,t,speed,e.place.w,1.0f32),verse_particle_offset(kind,seed,i,t,speed,e.place.w,2.0f32));
  w:V4=wg_make_f4_f3f(wg_add_f3f3(v3(e.place.x,e.place.y,e.place.z),off),1.0f32);
  c:V4=v4(wg_dot4(wg_at4(u,8),w),wg_dot4(wg_at4(u,12),w),wg_dot4(wg_at4(u,16),w),wg_dot4(wg_at4(u,20),w));
  half:f32=verse_particle_size(kind,seed,i,t,speed,e.shape.z)*0.5f32;
  px:f32=(((half*wg_length3(v3(u[12],u[13],u[14])))/fmax(c.w,0.01f32))*u[1])*0.5f32;
  grow:f32=fmax(1.0f32,2.2f32/fmax(px,0.001f32));
  s:f32=half*grow;
  c.x=c.x+((o.corner.x*s)*wg_length3(v3(u[8],u[9],u[10])));
  c.y=c.y+((o.corner.y*s)*wg_length3(v3(u[12],u[13],u[14])));
  o.pos=c;
  d:f32=wg_length3(wg_sub_f3f3(v3(u[24],u[25],u[26]),v3(w.x,w.y,w.z)));
  fog:f32=exp(((-d)*d)*0.0006f32);
  o.color=wg_div_f3f(wg_mul_f3f(wg_mul_f3f(v3(e.color.x,e.color.y,e.color.z),verse_particle_glow(kind,seed,i,t,speed,e.color.w)),fog),sqrt(grow));
  return o;
}
particles_under_panel :: (p:V2,u:[]f32)->bool {
  {
    k:s32=0;
    while k<28 {
      if ((cast(f32)(k))>=u[5]) {
        break;
      }
      r:V4=wg_at4(u,(cast(int)(k*2))*4+32);
      if (((((u[(cast(int)((k*2)+1))*4+33]>0.0f32)&&(p.x>=r.x))&&(p.x<=r.z))&&(p.y>=r.y))&&(p.y<=r.w)) {
        return true;
      }
      k+=1;
    }
  }
  return false;
}
particles_particle_fs :: (p:ParticlesP,u:[]f32)->V4 {
  r2:f32=wg_dot2(p.corner,p.corner);
  if ((r2>=1.0f32)||particles_under_panel(v2(p.pos.x,p.pos.y),u)) {
    gpu_demote_helper();
  }
  a:f32=exp((-r2)*4.0f32)*(1.0f32-r2);
  return wg_make_f4_f3f(wg_mul_f3f(p.color,a),verse_haunt_bloom_share(fmax(p.color.x,fmax(p.color.y,p.color.z)),1.0f32)*a);
}

// ---- generated by wgsl-coax: the vector helpers this file calls
wg_add_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
wg_sub_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
wg_mul_f3f :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
wg_div_f3f :: (a:V3,b:f32)->V3 {return v3(a.x/b,a.y/b,a.z/b);}
