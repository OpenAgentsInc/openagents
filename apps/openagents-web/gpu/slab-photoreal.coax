// SLAB's photoreal drawing (docs/metaverse/photoreal.md; docs/research/ocean/slab-world-spec.md):
// the platform and everything on it as meshes through the Metaverse Engine's photoreal style
// (metaverse-engine/render/shade/photoreal.coax), under a physical sky. slab.coax (this folder)
// loads this file and calls it through a few hooks:
//   slab_photo, slab_photo_meshes   which path a frame takes
//   slab_photo_first                the background's trace, or a miss when the meshes draw the platform
//   slab_photo_sky, slab_photo_haze the physical sky and air as the display shows them, for the sea
//   slab_scene_vs/fs, slab_shadow_vs/fs   the mesh pass and its shadow map
//
// The sea (slab_water and what the water agents add to it) is written for colours as a display
// shows them. So in this mode slab_sky, slab_haze and slab_grade hand it the physical sky, air
// and film already through pr_out, and slab.coax's P_SUNCOL, P_ZENITH and P_HORIZON hold the
// same (apps/openagents-web/slab-photoreal.coax writes them). Water that wants light's own scale
// reads the frame's block instead: pr_dome, pr_sky_light, pr_air and pr_out with SLAB_PHOTO.
#load "../../../metaverse-engine/render/shade/photoreal.coax";
#load "../slab-photo-rows.coax";

SLAB_PHOTO :: 15872;   // the photoreal frame's block in the uniforms (slab.coax U_PHOTO), then SLAB's own four:
SLAB_PHOTO_ON :: SLAB_PHOTO + PR_FLOATS;          // 1: the realm draws photoreal
SLAB_PHOTO_MESHES :: SLAB_PHOTO + PR_FLOATS + 1;  // 1: the meshes draw the platform this frame (0 under the sea)
SLAB_PHOTO_CONTACT :: SLAB_PHOTO + PR_FLOATS + 2; // 1: the post pass draws contact (photoreal.coax pr_post)
SLAB_PAINT :: 63.0f32;   // the material row that means: the plan's own paint for the record's kind (slab_paint)

slab_photo :: (u:[]f32)->bool {return u[SLAB_PHOTO_ON]>0.5f32;}
slab_photo_meshes :: (u:[]f32)->bool {return u[SLAB_PHOTO_MESHES]>0.5f32;}

// The background's first hit: the traced platform, or nothing where the meshes draw it. In the
// section (slab.coax P_SECTION) the meshes draw what the cut leaves and its cut faces above the
// sea (slab_photo_cut_point), and the trace what lies under the sea, which the slot shows through
// its water.
slab_photo_first :: (o:V3,d:V3,u:[]f32)->SlabHit {
  if (slab_photo_meshes(u)) {
    if (u[SLAB_P+52]!=0.0f32) {
      h:SlabHit=slab_scene(o,d,false,SLAB_MISS,u);
      if ((h.t<SLAB_MISS)&&((o.y+(d.y*h.t))<0.0f32)) {return h;}
    }
    return SlabHit.{t=SLAB_MISS,n=v3(0.0f32,1.0f32,0.0f32),kind=-1.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)};
  }
  return slab_scene(o,d,false,SLAB_MISS,u);
}
// In the section, how the cut takes the plan's `record` (-1: none), as slab_scene does: 0 point by
// point (a box, the hull, what stands on no record), 1 whole, -1 not at all (any other shape goes
// whole when its middle lies beyond the cut).
slab_photo_cut_whole :: (record:int,u:[]f32)->s32 {
  if (record<0) {return 0;}
  at:int=SLAB_BOXES+(record*8);
  p:V4=wg_at4(u,at);
  q:V4=wg_at4(u,at+4);
  if ((wg_i32_f(q.w+0.5f32)==0)||(wg_i32_f(p.w+0.5f32)==0)) {return 0;}
  return ifx (u[SLAB_P+52]*(((p.z+q.z)*0.5f32)-u[SLAB_P+53]))>0.0f32 then 1 else -1;
}
// In the section, where the meshes draw a point h (hull frame) of a part that rides the hull and
// stands on the plan's `record`. What the cut takes away is pressed flat onto the cut: a part's
// faces toward the eye become its cut face there (slab_scene_fs paints them as slab_section does),
// and its other faces end at the cut. What lies under the sea, which the trace draws wet, is
// pressed up to the waterline. It is done to the vertices, not by discarding fragments, so the
// mesh pass keeps the GPU's early depth test. What stands on no record is cut only where the
// sea's slot is.
slab_photo_cut_point :: (h:V3,record:int,u:[]f32)->V3 {
  sec:f32=u[SLAB_P+52]; cut:f32=u[SLAB_P+53];
  if (slab_photo_cut_whole(record,u)!=0) {return h;}
  c:V3=h;
  by:bool=abs(h.x)<u[36]+20.0f32;
  if (by&&(c.y<0.0f32)) {c.y=0.0f32;}
  if (((sec*(h.z-cut))>0.0f32)&&((record>=0)||by)) {c.z=cut;}
  return c;
}
// In the section, whether a part goes whole: a shape the cut takes by its record, a part on a box
// that lies wholly on the eye's side of the cut, and a part on no record whose place lies on the
// eye's side where the sea's slot is (a ship, a tree, a lamp).
slab_photo_cut_gone :: (place:V3,record:int,u:[]f32)->bool {
  sec:f32=u[SLAB_P+52]; cut:f32=u[SLAB_P+53];
  whole:s32=slab_photo_cut_whole(record,u);
  if (whole!=0) {return whole>0;}
  if (record>=0) {
    at:int=SLAB_BOXES+(record*8);
    far:f32=ifx sec>0.0f32 then u[at+2] else u[at+6];
    return (sec*(far-cut))>-0.01f32;
  }
  beyond:f32=sec*(place.z-cut);
  return (abs(place.x)<u[36]+20.0f32)&&(beyond>0.0f32)&&(beyond<1500.0f32);
}
// What the traced platform shows under the physical sky, as the display shows it before the air:
// its paint under the sun, the platform's own shadow traced, and the sky's light. The section's cut
// faces under the sea and the view from under the sea draw the platform this way, and so does
// whoever walks the deck.
slab_photo_lit :: (hit:SlabHit,o:V3,d:V3,u:[]f32)->V3 {
  return slab_photo_pulse(pr_out(slab_photo_light(hit,o,d,u),u,SLAB_PHOTO),hit.id,u);
}
// The same in the frame's light, before the air and the film: what the sea's water takes under
// it (gpu/slab-sea.coax slab_sea_through). The selection's pulse goes over the display's colour.
slab_photo_light :: (hit:SlabHit,o:V3,d:V3,u:[]f32)->V3 {
  b:int=SLAB_PHOTO;
  w:V3=sb_add(o,sb_mul(d,hit.t));
  pt:SlabPaint=slab_paint(hit,w,d,u);
  nw:V3=sb_dir_to_world(hit.n,u);
  sun:V3=pr_at3(u,b+PR_SUN);
  ndl:f32=fmax(dot3(nw,sun),0.0f32);
  if ((ndl>0.0f32)&&(u[5]<0.5f32)&&(hit.kind<39.0f32)&&(sun.y>-0.02f32)) {
    s:SlabHit=slab_scene(sb_add(w,sb_mul(hit.n,0.08f32)),sb_dir_to_hull(sun,u),true,900.0f32,u);
    if (s.t<900.0f32) {ndl=0.0f32;}
  }
  // a little less of the sky where a wall meets the deck
  occ:f32=ifx ((abs(hit.n.y)<0.5f32)&&(hit.kind>=0.5f32)) then 0.72f32+(0.28f32*smoothstep(0.0f32,6.0f32,w.y-u[38])) else 1.0f32;
  light:V3=add3(scale3(pr_at3(u,b+PR_SUN_LIGHT),ndl),scale3(pr_sky_light(nw,u,b),occ));
  return add3(mul3(pr_decode(pt.c),light),scale3(pr_decode(pt.emit),1.0f32/fmax(u[b+PR_SUN_LIGHT+3],0.001f32)));
}
slab_photo_pulse :: (c0:V3,id:f32,u:[]f32)->V3 {
  c:V3=c0;
  if (id>-0.5f32) {
    if (abs(id-u[SLAB_P+36])<0.5f32) {
      pulse:f32=0.5f32+(0.5f32*sin(u[SLAB_P+38]*5.0f32));
      c=add3(scale3(c,1.1f32),scale3(v3(1.0f32,0.62f32,0.2f32),0.12f32+(0.12f32*pulse)));
    } else if (abs(id-u[SLAB_P+37])<0.5f32) {
      c=add3(scale3(c,1.06f32),v3(0.06f32,0.05f32,0.03f32));
    }
  }
  return c;
}
// ---- the sea's surface in the frame's light (gpu/slab-sea.coax slab_sea_top_*: what the open
// sea, its foam and the hull's white water read when the realm draws photoreal)
// The frame's light as the display shows it: exposure, film, white balance.
slab_photo_show :: (c:V3,u:[]f32)->V3 {return pr_out(c,u,SLAB_PHOTO);}
// The sun's light on a white card facing it, and the sky's on one facing up.
slab_photo_sun :: (u:[]f32)->V3 {return pr_at3(u,SLAB_PHOTO+PR_SUN_LIGHT);}
slab_photo_skylight :: (u:[]f32)->V3 {return pr_sky_light(v3(0.0f32,1.0f32,0.0f32),u,SLAB_PHOTO);}
// The sky a sea mirrors along r: its air under the frame's cloud, without the sun's disc (the glint's).
slab_photo_mirror_sky :: (r:V3,u:[]f32)->V3 {return pr_sky(r,u,SLAB_PHOTO);}

// The physical sky along d as the display shows it: the air, the sun, cloud, and at night the
// moon and stars (pr_dome draws them).
slab_photo_sky :: (d:V3,u:[]f32)->V3 {
  b:int=SLAB_PHOTO;
  soft:f32=(u[b+PR_EYE+3]*2.0f32)/fmax(u[1],1.0f32);
  c:V3=pr_dome(d,soft,u,b);
  return pr_out(c,u,b);
}
// A display colour seen through `dist` metres of the physical air along d.
slab_photo_haze :: (c:V3,d:V3,dist:f32,u:[]f32)->V3 {
  b:int=SLAB_PHOTO;
  t:f32=pr_air_through(dist,u[b+PR_EYE+1],d.y,u,b);
  far:V3=pr_out(add3(pr_under_cloud(pr_air_far(d,pr_at3(u,b+PR_SUN),u[b+PR_AIR_HAZE]),u,b),pr_night(u[b+PR_SUN+3])),u,b);
  return mix3(c,far,1.0f32-t);
}

// A light seen through `dist` metres of the physical air along d (pr_air for a point the
// caller knows by its distance), and the share of slab_haze's distance the sea still takes: none.
slab_photo_air :: (c:V3,d:V3,dist:f32,u:[]f32)->V3 {
  b:int=SLAB_PHOTO;
  t:f32=pr_air_through(dist,u[b+PR_EYE+1],d.y,u,b);
  return add3(scale3(c,t),scale3(add3(pr_under_cloud(pr_air_far(d,pr_at3(u,b+PR_SUN),u[b+PR_AIR_HAZE]),u,b),pr_night(u[b+PR_SUN+3])),1.0f32-t));
}
slab_photo_sea_haze :: (u:[]f32)->f32 {return ifx slab_photo(u) then 0.0f32 else 0.4f32;}

// ---- the mesh pass
// (the vertices' store is not named `mesh`: host.js gives a store of that name in a page's shader its older single-mesh layout)
slab_scene_vs :: (id:u32,instance:u32,u:[]f32,parts:[]f32,objects:[]PrObj)->PrV {
  v:PrV=pr_stand(id,instance,u,SLAB_PHOTO,parts,objects);
  if ((u[SLAB_P+52]==0.0f32)||((v.pos.z==2.0f32)&&(v.pos.w==1.0f32)&&(v.pos.x==0.0f32))) {return v;}   // (pr_stand put it out of sight)
  // the section (slab_photo_cut_point)
  b:int=SLAB_PHOTO;
  m:PrObj=objects[cast(int)instance];
  record:int=cast(int)(m.c.w+0.5f32)-1;
  riding:bool=m.b.w<0.5f32;
  place:V3=v3(m.a.x,m.a.y,m.a.z);
  if (!riding) {place=sb_to_hull(place,u);}
  if (slab_photo_cut_gone(place,record,u)) {v.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32); return v;}
  if ((!riding)||(m.b.y>4.5f32)) {return v;}
  h:V3=sb_to_hull(v.world,u);
  c:V3=slab_photo_cut_point(h,record,u);
  if ((c.x==h.x)&&(c.y==h.y)&&(c.z==h.z)) {return v;}
  // the part's own frame moves with it (its patterns are laid on it), turned by its yaw
  dy:f32=c.y-h.y; dz:f32=c.z-h.z;
  v.local=add3(v.local,v3((0.0f32-sin(m.a.w))*dz,dy,cos(m.a.w)*dz));
  v.world=pr_posed(c,u,b);
  v.pos=pr_clip(v.world,u,b);
  if ((m.b.y>2.5f32)&&(m.b.y<4.5f32)) {v.pos=v4(v.pos.x,v.pos.y,v.pos.z-(0.0000006f32*v.pos.w),v.pos.w);}
  return v;
}
slab_shadow_vs :: (id:u32,instance:u32,u:[]f32,parts:[]f32,objects:[]PrObj)->PrShade {
  s:PrShade=pr_shadow_stand(id,instance,u,SLAB_PHOTO,parts,objects);
  m:PrObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  if ((u[SLAB_P+52]==0.0f32)||(m.b.y>4.5f32)||(parts[o+7]<=0.0f32-PR_FOLD_MARK)) {return s;}
  // the section: what the cut takes away casts no shadow (slab_photo_cut_point)
  b:int=SLAB_PHOTO;
  record:int=cast(int)(m.c.w+0.5f32)-1;
  riding:bool=m.b.w<0.5f32;
  place:V3=v3(m.a.x,m.a.y,m.a.z);
  if (!riding) {place=sb_to_hull(place,u);}
  if (slab_photo_cut_gone(place,record,u)) {s.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32); return s;}
  if (!riding) {return s;}
  w:V3=pr_placed_in(v3(parts[o],parts[o+1],parts[o+2]),m,u[b+PR_UP+3],wg_at4(u,b+PR_WIND));
  s.pos=pr_light_clip(pr_kept(pr_posed(slab_photo_cut_point(w,record,u),u,b),m,u,b),u,b);
  return s;
}
slab_shadow_fs :: (s:PrShade) {}

// How rough a kind's painted surface is (the plan's paint has no roughness of its own).
slab_photo_rough :: (k:s32,roof:bool)->f32 {
  if (k==0) {return ifx roof then 0.62f32 else 0.8f32;}
  if ((k==4)||(k==8)||(k==10)||(k==12)||(k==13)||(k==20)) {return 0.45f32;}   // painted metal
  if ((k==9)||(k==16)||(k==18)||(k==27)||(k==19)) {return 0.55f32;}        // dressed stone
  if ((k==15)||(k==7)) {return 0.9f32;}
  return 0.75f32;
}
// What a mirror on the platform shows along rh from ph (hull frame): the platform's own masses
// where the ray meets one, under the sun and sky without their shadows; else `sky`.
// At night the lamps' pools light what it shows, as they light the platform itself.
slab_photo_mirror :: (ph:V3,rh:V3,sky:V3,u:[]f32,field:[]f32,materials:[]f32)->V3 {
  b:int=SLAB_PHOTO;
  hit:SlabHit=slab_scene(ph,rh,true,1500.0f32,u);
  if (hit.t>=1500.0f32) {return sky;}
  w:V3=sb_add(ph,sb_mul(rh,hit.t));
  pt:SlabPaint=slab_paint(hit,w,rh,u);
  nw:V3=sb_dir_to_world(hit.n,u);
  light:V3=add3(scale3(pr_at3(u,b+PR_SUN_LIGHT),fmax(dot3(nw,pr_at3(u,b+PR_SUN)),0.0f32)),pr_sky_light(nw,u,b));
  tower:bool=wg_i32_f(hit.kind+0.5f32)==5;
  // (a tower's painted windows are not its lit rooms: those are the glass's own, pr_room)
  emit:V3=ifx tower then v3(0.0f32,0.0f32,0.0f32) else pr_decode(pt.emit);
  c:V3=add3(mul3(pr_decode(pt.c),light),scale3(emit,1.0f32/fmax(u[b+PR_SUN_LIGHT+3],0.001f32)));
  if (tower&&(abs(hit.n.y)<0.5f32)) {
    // another tower's glass: dark, with the sky it mirrors in turn and its floors' faint lines,
    // not the plan's painted pane grid, which a mirror magnifies into blocks
    storey:f32=fract((w.y-u[38])/3.9f32);
    edge:f32=smoothstep(0.0f32,0.06f32,storey)*(1.0f32-smoothstep(0.88f32,0.94f32,storey));
    edge=mix(edge,0.85f32,smoothstep(60.0f32,200.0f32,hit.t));
    c=add3(scale3(light,0.05f32),scale3(pr_sky(sb_dir_to_world(reflect3(rh,hit.n),u),u,b),0.3f32+0.12f32*edge));
  }
  if (u[b+PR_LAMPS]>0.001f32) {
    s:PrSurface; s.albedo=pr_decode(pt.c); s.normal=hit.n; s.rough=1.0f32; s.metal=0.0f32;
    c=add3(c,pr_lamps(w,hit.n,sb_mul(rh,-1.0f32),s,u,b,field,materials));
  }
  // the air between the mirror and what it shows
  t:f32=pr_air_through(hit.t,u[b+PR_EYE+1],rh.y,u,b);
  return mix3(sky,c,t);
}
// The deck's zones at the hull's point p (slab_paint's plan: 20 m streets on the 100 m grid, the
// promenade within 20 m of the edge, the parapet's cap): which material it is, and the street's
// own frame there. `across` is metres from the street's centre line, `along` metres along it,
// `cross` how far the nearest crossing street's centre is (0 at an intersection).
SlabDeck :: struct {row:f32; across:f32; along:f32; cross:f32;}
slab_deck_at :: (p:V2,u:[]f32)->SlabDeck {
  sx:f32=p.x-(wg_round(p.x/100.0f32)*100.0f32); sz:f32=p.y-(wg_round(p.y/100.0f32)*100.0f32);
  gx:f32=abs(sx); gz:f32=abs(sz);
  d:SlabDeck=SlabDeck.{row=cast(f32)(SLAB_M_PLAZA),across=sx,along=p.y,cross=gz};
  if (gz<gx) {d.across=sz; d.along=p.x; d.cross=gx;}
  g:f32=abs(d.across);
  if (g<10.0f32) {
    d.row=ifx g<5.0f32 then cast(f32)(SLAB_M_ASPHALT) else (ifx g<5.3f32 then cast(f32)(SLAB_M_KERB) else cast(f32)(SLAB_M_PAVER));
    // where two streets meet, the crossing's carriageway runs through
    if (d.cross<5.0f32) {d.row=cast(f32)(SLAB_M_ASPHALT);}
  }
  edge:f32=slab_hull_plan(p,u);
  if (edge>-20.0f32) {d.row=cast(f32)(SLAB_M_PROMENADE);}
  return d;
}
// A street's surface under the detail set's kerbs, gutters, dashes and crossings
// (slab-content-city.coax, which draws those as parts near the eye): edge lines, the gutter's
// shade at the kerb and the tyres' tracks, which also carry the street from far off.
// `aa` is a pixel's width on the deck (taken before any branch).
slab_deck_street :: (s0:PrSurface,d:SlabDeck,aa:f32)->PrSurface {
  s:PrSurface=s0;
  g:f32=abs(d.across);
  white:f32=0.0f32;
  if (d.row<cast(f32)(SLAB_M_ASPHALT)+0.5f32) {
    junction:bool=d.cross<10.0f32;
    if (!junction) {
      white=fmax(white,pr_band(g,4.2f32,0.12f32,aa,10.0f32));
      // the tyres' tracks: a little darker and smoother; oil down each lane's middle
      track:f32=fmax(pr_band(g,1.2f32,0.7f32,aa,0.0f32),pr_band(g,3.4f32,0.7f32,aa,0.0f32));
      s.albedo=scale3(s.albedo,1.0f32-0.07f32*track);
      s.rough=s.rough-0.1f32*track;
      oil:f32=pr_band(g,2.3f32,0.6f32,aa,0.0f32)*smoothstep(0.55f32,0.8f32,pr_noise2(d.along*0.7f32,d.across*2.0f32));
      s.albedo=scale3(s.albedo,1.0f32-0.25f32*oil);
    }
    // the gutter: the kerb's shadow and the grime that collects there
    s.albedo=scale3(s.albedo,1.0f32-0.38f32*pr_band(g,4.75f32,0.5f32,aa,0.0f32)*(ifx junction then 0.0f32 else 1.0f32));
  } else if (d.row<cast(f32)(SLAB_M_KERB)+0.5f32) {
    // the kerb's top catches the light; its face toward the road falls in shade
    s.albedo=scale3(s.albedo,mix(0.55f32,1.12f32,smoothstep(5.03f32,5.1f32,g)));
  } else if (d.row<cast(f32)(SLAB_M_PAVER)+0.5f32) {
    s.albedo=scale3(s.albedo,1.0f32-0.12f32*pr_band(g,5.4f32,0.2f32,aa,0.0f32));
  }
  s.albedo=mix3(s.albedo,v3(0.62f32,0.62f32,0.58f32),white);
  s.rough=mix(s.rough,0.6f32,white);
  return s;
}
slab_scene_fs :: (v:PrV,u:[]f32,materials:[]f32,field:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->PrLit {
  b:int=SLAB_PHOTO;
  full:bool=u[b+PR_GROUND+3]<0.5f32;
  eye:V3=pr_at3(u,b+PR_EYE);
  to:V3=sub3(v.world,eye);
  dist:f32=length3(to);
  rd:V3=scale3(to,1.0f32/fmax(dist,0.0001f32));
  toward:V3=scale3(rd,0.0f32-1.0f32);
  free:bool=v.info.w>0.5f32;
  // the hull's frame, where the plan's records and its paint live
  wh:V3=v.world; gh:V3=normalize3(v.normal); dh:V3=rd;
  if (!free) {wh=sb_to_hull(v.world,u); gh=sb_dir_to_hull(gh,u); dh=sb_dir_to_hull(rd,u);}
  // (a pixel's width on the deck, taken before anything branches)
  aa:f32=fmax(gpu_fwidth(wh.x),gpu_fwidth(wh.z));
  record:int=cast(int)(v.info.y+0.5f32)-1;
  exposure:f32=fmax(u[b+PR_SUN_LIGHT+3],0.001f32);
  kind:s32=-1;
  row:f32=v.info.x;
  painted:bool=row>SLAB_PAINT-0.5f32;
  tinted:bool=(row>cast(f32)(SLAB_M_TINTED_FIRST)-0.5f32)&&(row<cast(f32)(SLAB_M_TINTED_LAST)+0.5f32);
  pt:SlabPaint=SlabPaint.{c=v3(1.0f32,1.0f32,1.0f32),emit=v3(0.0f32,0.0f32,0.0f32)};
  wall:bool=false; deck:bool=false;
  street:SlabDeck=SlabDeck.{row=row,across=0.0f32,along=0.0f32,cross=100.0f32};
  vv:PrV=v;
  if (record>=0) {
    at:int=SLAB_BOXES+(record*8);
    p:V4=wg_at4(u,at);
    q:V4=wg_at4(u,at+4);
    kind=wg_i32_f(p.w+0.5f32);
    // a temple, a round temple and the statues are built in their own stone: the plan's paint
    // fakes their columns and dims their cella, which the real parts and the light now do
    if ((q.w>10.5f32)&&(q.w<13.5f32)&&(row<cast(f32)(SLAB_M_LIMESTONE)+1.5f32)) {tinted=false;}
    if (painted||tinted) {
      hit:SlabHit=SlabHit.{t=dist,n=gh,kind=p.w+(ifx q.w>10.5f32 then 0.25f32 else 0.0f32),top=q.y,id=cast(f32)(record),lo=v3(p.x,p.y,p.z),hi=v3(q.x,q.y,q.z)};
      pt=slab_paint(hit,wh,dh,u);
    }
    if ((kind==0)&&(abs(row-cast(f32)(SLAB_M_WALL))<0.5f32)) {
      if (gh.y>0.5f32) {deck=true; street=slab_deck_at(v2(wh.x,wh.z),u); vv.info.x=street.row;}
      else if (abs(gh.y)<0.5f32) {wall=true;}
    }
  }
  // the plan's paint tints the stone and the works (slab-photo-rows.coax)
  if (tinted) {vv.tint=mul3(vv.tint,pr_decode(pt.c));}
  s:PrSurface=pr_surface(vv,u,b,materials);
  nh:V3=s.normal;
  if (!free) {nh=sb_dir_to_hull(s.normal,u);}
  if (tinted) {s.glow=add3(s.glow,scale3(pr_decode(pt.emit),1.0f32/exposure));}
  if (painted&&(record>=0)) {
    s.albedo=mul3(pr_decode(pt.c),v.tint);
    s.glow=scale3(pr_decode(pt.emit),1.0f32/exposure);
    if (((kind==2)||(kind==3)||(kind==11)||(kind==20))&&(abs(nh.y)<0.5f32)) {
      // the painter's windows at night: only the rooms whose lights are on at this hour (the
      // frame's share of rooms lit, PR_ROOMS), and only as the daylight fails; at 0.55 of the
      // paint's glow, so a lit room is a warm cream and not the display's white
      along:f32=ifx abs(nh.x)>abs(nh.z) then wh.z else wh.x;
      cell:V2=v2(floor(along/4.0f32),floor((wh.y-u[38])/3.6f32)+(cast(f32)(record)*7.0f32));
      on:f32=stepf(slab_hash2(cell),u[b+PR_ROOMS]);
      s.glow=scale3(s.glow,on*u[b+PR_LAMPS]*0.55f32);
    }
    s.rough=slab_photo_rough(kind,nh.y>0.5f32);
    s.metal=0.0f32;
    if ((kind==14)&&(nh.y>0.5f32)) {
      // the stone rim round the deck's water (the water itself is its own sheet inside it,
      // apps/openagents-web/slab-content-green.coax green_pool); a moonpool is its shaft, below
      s.albedo=v3(0.62f32,0.6f32,0.55f32); s.rough=0.5f32; s.glow=v3(0.0f32,0.0f32,0.0f32);
      if (abs(wh.x+389.0f32)<6.5f32) {
        // a moonpool: not water at the deck but a shaft down to the sea, whose water rises and
        // falls with the simulated surge (gpu/slab-water.coax sw_pool); the shaft's own shade is
        // in the colour, and only the sky's light reaches down it, not the sun's
        pool:V3=sw_pool(v3(0.0f32,0.0f32,0.0f32),wh,dh,u);
        s.albedo=v3(0.0f32,0.0f32,0.0f32); s.rough=1.0f32;
        s.glow=mul3(pr_decode(pool),pr_sky_light(v3(0.0f32,1.0f32,0.0f32),u,b));
      }
    }
  }
  if ((u[SLAB_P+52]!=0.0f32)&&(!free)&&(abs(gh.z)>0.9f32)&&(abs(wh.z-u[SLAB_P+53])<0.6f32)) {
    // the section's cut face (slab_photo_cut_point pressed it there): the drawing bg_fs traces
    // there (slab_section), lit as the trace lights it, and without the post pass's contact shade
    cut:SlabHit=SlabHit.{t=dist,n=v3(0.0f32,0.0f32,ifx gh.z>0.0f32 then 1.0f32 else -1.0f32),kind=cast(f32)(ifx kind<0 then 0 else kind),top=0.0f32,id=cast(f32)(record),lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)};
    ho:V3=sb_to_hull(eye,u);
    cc:V3=slab_haze(slab_photo_lit(cut,ho,dh,u),rd,dist,u);
    cs:V4=slab_smoke(ho,dh,dist,u);
    cc=slab_grade(slab_weather_air(mix3(cc,v3(cs.x,cs.y,cs.z),cs.w),v2(v.pos.x,v.pos.y),u),u);
    return pr_lit_plain(v4(cc.x,cc.y,cc.z,1.0f32));
  }
  rain:f32=saturate(u[SLAB_SEA+17]*1.6f32);
  if (deck) {
    s=slab_deck_street(s,street,aa);
    // after rain the deck is dark and glossy, with standing water in its low places and gutters
    if (rain>0.0f32) {
      low:f32=smoothstep(0.6f32,0.7f32,pr_cloud2(wh.x*0.13f32,wh.z*0.13f32));
      gutter:f32=ifx street.row<cast(f32)(SLAB_M_ASPHALT)+0.5f32 then pr_band(abs(street.across),4.75f32,0.5f32,aa,0.0f32) else 0.0f32;
      s=pr_wet(s,rain,fmax(low,gutter*0.8f32),normalize3(v.normal));
    }
  }
  if (wall&&(v.world.y<u[28]+16.0f32)) {
    // the live sea wets the wall where it reaches, and leaves a damp band as high as its waves run
    hs:f32=u[35];
    over:f32=v.world.y-slab_sea_height(v2(v.world.x,v.world.z),u);
    along:f32=ifx abs(gh.x)>abs(gh.z) then wh.z else wh.x;
    run:f32=0.4f32+(hs*(0.5f32+(0.8f32*pr_noise2(along*0.05f32,u[b+PR_UP+3]*0.15f32))));
    wet:f32=1.0f32-smoothstep(0.0f32,run,over);
    damp:f32=0.5f32*(1.0f32-smoothstep(hs*0.6f32,(hs*1.4f32)+1.0f32,v.world.y-u[28]));
    s=pr_wet(s,fmax(wet,damp),0.0f32,s.normal);
  }
  if (wall) {
    // the white water a breaking crest throws up the walls, and the wet it leaves
    // (gpu/slab-water.coax sw_wash, from the walls' simulated water)
    wash:V2=sw_wash(v.world,s.normal,u[28],u);
    s=pr_wet(s,wash.y,0.0f32,s.normal);
    s.albedo=mix3(s.albedo,v3(0.8f32,0.82f32,0.84f32),wash.x);
  }
  n:V3=s.normal;
  sun:V3=pr_at3(u,b+PR_SUN);
  // the sun: the shadow map, and beyond its reach the platform's own masses, traced
  reach:f32=0.0f32;
  if (((dot3(n,sun)>0.0f32)||(s.through>0.0f32))&&(sun.y>-0.02f32)) {
    outside:f32=1.0f32;
    if (full&&(!free)&&(pr_shadow_edge(v.world,u,b)>0.9f32)) {
      far:SlabHit=slab_scene(sb_add(wh,sb_mul(nh,0.1f32)),sb_dir_to_hull(sun,u),true,900.0f32,u);
      if (far.t<900.0f32) {outside=0.0f32;}
    }
    reach=pr_shadow(v.world,n,outside,u,b,shadow_map,shadow_cmp);
    // the walker is traced, not drawn into the shadow map: trace its own shadow near its feet
    // (its bounding sphere turns away every other pixel)
    if ((reach>0.0f32)&&(u[SLAB_P+34]>0.5f32)) {
      fe:V3=sb_sub(wh,sb_p(u,28));
      if (((fe.x*fe.x)+(fe.z*fe.z))<900.0f32) {
        me:SlabHit=slab_walker(sb_add(wh,sb_mul(nh,0.05f32)),sb_dir_to_hull(sun,u),40.0f32,u);
        if (me.t<40.0f32) {reach=0.0f32;}
      }
    }
  }
  open:f32=ifx free then 1.0f32 else pr_field(wh,nh,u,b,field);
  mirrored:V3=pr_environment(n,toward,s.rough,u,b);
  if (full&&(!free)&&(s.rough<0.16f32)) {
    r:V3=reflect3(rd,n);
    mirrored=slab_photo_mirror(sb_add(wh,sb_mul(nh,0.15f32)),sb_dir_to_hull(r,u),mirrored,u,field,materials);
  }
  // the lamps: their pools baked in the field, and the near ones' highlights (hull frame)
  lamp:V3=ifx free then v3(0.0f32,0.0f32,0.0f32) else pr_lamps(wh,nh,sb_dir_to_hull(toward,u),s,u,b,field,materials);
  c:V3=pr_out(pr_air(add3(pr_lit(s,toward,reach,open,mirrored,u,b),lamp),v.world,u,b),u,b);
  // SLAB's own, over the display's colour: the stacks' smoke between the eye and the surface,
  // and a warm pulse on what is selected
  sm:V4=slab_smoke(sb_to_hull(eye,u),sb_dir_to_hull(rd,u),dist,u);
  c=mix3(c,v3(sm.x,sm.y,sm.z),sm.w);
  c=slab_weather_air(c,v2(v.pos.x,v.pos.y),u);
  if (record>=0) {
    if (abs(cast(f32)(record)-u[SLAB_P+36])<0.5f32) {
      pulse:f32=0.5f32+(0.5f32*sin(u[SLAB_P+38]*5.0f32));
      c=add3(scale3(c,1.1f32),scale3(v3(1.0f32,0.62f32,0.2f32),0.12f32+(0.12f32*pulse)));
    } else if (abs(cast(f32)(record)-u[SLAB_P+37])<0.5f32) {
      c=add3(scale3(c,1.06f32),v3(0.06f32,0.05f32,0.03f32));
    }
  }
  // the post pass's contact shade reads the normal and the sun's share of the light
  return pr_lit_out(c,n,pr_sun_share(n,reach,open,u,b));
}

// ---- the post pass (coax/web/host.js): the frame's two targets come together on the screen.
// In photoreal, contact (photoreal.coax pr_post): the screen's ambient occlusion and short
// contact shadows, so what stands on the deck sits on it. Painterly passes through. No bloom:
// slab-face.c asks for none of the five passes (coaxial_bloom_passes_v1), and slab_bloom_fs only
// copies its source for the host's pipeline.
slab_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {
  return gpu_load(bloom_src,cast(s32)pos.x,cast(s32)pos.y,0);
}
slab_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
  x:s32=cast(s32)pos.x; y:s32=cast(s32)pos.y;
  light:V4=gpu_load(post_light,x,y,0);
  if (u[SLAB_PHOTO_CONTACT]<0.5f32) {return v4(light.x,light.y,light.z,1.0f32);}
  c:V3=pr_post(light,gpu_load(post_aux,x,y,0),x,y,u,SLAB_PHOTO,post_depth);
  return v4(c.x,c.y,c.z,1.0f32);
}
