# slab's bindings for coax/web/wgsl-module.coax (NAME GROUP BINDING [uniform VEC4FS]), as coax/web/host.js lays them out:
# group 0 the frame's uniforms and the HUD's letters; group 1 the photoreal scene's stores (the parts'
# vertices, the records, the materials, the ground's sky field); group 2 the sun's shadow map and its
# comparison sampler.
u 0 0 uniform 4056
sans_atlas 0 1
sans_sampler 0 2
parts 1 0
objects 1 1
materials 1 2
field 1 3
shadow_map 2 0
shadow_cmp 2 1
bloom_src 1 0
bloom_lin 1 1
bloom_step 1 2 uniform 1
post_light 1 0
post_quarter 1 1
post_eighth 1 2
post_aux 1 3
post_depth 1 4
post_lin 1 5
