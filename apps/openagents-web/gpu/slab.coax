// SLAB Simulation's shaders, the source of apps/openagents-web/slab.wgsl (docs/metaverse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (slab.module, slab.bindings beside it).
// It began as the water lab's (gpu/waterlab.coax) with the beach and the view under the water taken out.
#load "../../../metaverse-engine/render/noise.coax";
#load "../../../metaverse-engine/gpu/wgsl.coax";
#load "../../../metaverse/style.coax";

// SLAB (slab.coax): the sea in deep water on the spectral tiles slab.coax packs into the
// uniforms each frame (metaverse/water-spectrum.coax), drawn by surface_vs as the water lab's
// clipmap mesh, in the painted water look (docs/metaverse/art-styles.md 12); and the platform,
// traced by bg_fs: metaverse/slab-plan.coax's boxes and upright cylinders (the hull's six pieces,
// then the masses on the deck), lit by a high sun with the masses' shadows on a desktop, painted
// by kind, its depth written so the sea's mesh hides behind it.
// SlabU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0      width, height, time, fade
//   mode 4      still, phone, the plan's record count, dpr
//   eye 8       xyz, tan of half the vertical field
//   fwd 12, right 16, up 20
//   sun 24      toward the sun, strength
//   sea 28      level, cascade 0's patch, the fine patch, choppiness
//   wind 32     direction x, z, speed, significant height
//   hull 36     half length, half beam, deck height, keel height
//   pack 40     the packed numbers' scales: height, slope, fine slope, choppy displacement
//   clip 44     quads a side, levels, morph band (quads), the skirt's reach (m)
//   levels 48   centre x, z, spacing, hole x + 2 hole z
//   boxes 96    the plan's records: min xyz, kind; max xyz, shape (0 box, 1 cylinder)
//   words 1056  cascade 0, its displacement, the fine slopes
SLAB_N :: cast(u32)64;
SLAB_WORDS :: 1056;
SLAB_BOXES :: 96;
SLAB_W_COARSE :: cast(u32)0;
SLAB_W_CHOP :: cast(u32)8192;
SLAB_W_FINE :: cast(u32)10240;
SLAB_MISS :: 1e9f32;
SLAB_CORNER :: 40.0f32;
slab_word :: (i:u32,u:[]f32)->u32 {
  return wg_get_u4(wg_at4u(u,(cast(int)(i>>2))*4+SLAB_WORDS),cast(int)(i&3));
}
// Cascade 0 at a rest point: height (m), foam, slope x, slope z; bilinear, wrapped.
slab_coarse :: (p:V2,u:[]f32)->V4 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[29]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V4=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      t:u32=add_wrap(mul_wrap(c.y,SLAB_N),c.x);
      a:V2=wg_unpack2x16float(slab_word(add_wrap(SLAB_W_COARSE,mul_wrap(cast(u32)2,t)),u));
      b:V2=wg_unpack2x16float(slab_word(add_wrap(add_wrap(SLAB_W_COARSE,mul_wrap(cast(u32)2,t)),cast(u32)1),u));
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      acc=wg_add_f4f4(acc,wg_mul_ff4(w,v4(a.x*u[40],a.y,b.x*u[41],b.y*u[41])));
      k+=1;
    }
  }
  return acc;
}
// The fine tile's slopes (the desktop's second cascade, the phone's baked tile).
slab_fine :: (p:V2,u:[]f32)->V2 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[30]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V2=v2(0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      acc=wg_add_f2f2(acc,wg_mul_f2f(wg_mul_ff2(w,wg_unpack2x16float(slab_word(add_wrap(add_wrap(SLAB_W_FINE,mul_wrap(c.y,SLAB_N)),c.x),u))),u[42]));
      k+=1;
    }
  }
  return acc;
}
// Cascade 0's choppy displacement at a rest point (m), bilinear, wrapped.
slab_chop :: (p:V2,u:[]f32)->V2 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[29]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V2=v2(0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      t:u32=add_wrap(mul_wrap(c.y,SLAB_N),c.x);
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      half:u32=(slab_word(add_wrap(SLAB_W_CHOP,(t>>1)),u)>>mul_wrap(cast(u32)16,(t&1)))&0xffff;
      acc=wg_add_f2f2(acc,wg_mul_ff2(w,wg_sw_xy_f4(wg_unpack4x8snorm(half))));
      k+=1;
    }
  }
  return wg_mul_f2f(acc,u[43]);
}
slab_hash2 :: (p:V2)->f32 {
  return render_noise2(p.x,p.y);
}
slab_noise :: (p:V2)->f32 {
  i:V2=wg_floor_f2(p);
  f:V2=wg_fract_f2(p);
  s:V2=wg_mul_f2f2(wg_mul_f2f2(f,f),wg_sub_ff2(3.0f32,wg_mul_ff2(2.0f32,f)));
  return mix(mix(slab_hash2(i),slab_hash2(wg_add_f2f2(i,v2(1.0f32,0.0f32))),s.x),mix(slab_hash2(wg_add_f2f2(i,v2(0.0f32,1.0f32))),slab_hash2(wg_add_f2f2(i,v2(1.0f32,1.0f32))),s.x),s.y);
}
// The sea's surface at rest point p: its height over the level (deep water everywhere).
slab_sea_height :: (p:V2,u:[]f32)->f32 {
  return u[28]+slab_coarse(p,u).x;
}
// How far p lies outside the hull's plan, a rectangle with rounded corners (negative inside).
slab_hull_plan :: (p:V2,u:[]f32)->f32 {
  qx:f32=(abs(p.x)-u[36])+SLAB_CORNER;
  qz:f32=(abs(p.y)-u[37])+SLAB_CORNER;
  out:f32=sqrt((fmax(qx,0.0f32)*fmax(qx,0.0f32))+(fmax(qz,0.0f32)*fmax(qz,0.0f32)));
  return (out+fmin(fmax(qx,qz),0.0f32))-SLAB_CORNER;
}
// The painted sky: zenith to a pale haze at the horizon, warm toward the sun.
slab_sky :: (d:V3,u:[]f32)->V3 {
  up:f32=clampf(d.y,0.0f32,1.0f32);
  zenith:V3=v3(0.30f32,0.55f32,0.82f32);
  horizon:V3=v3(0.80f32,0.88f32,0.90f32);
  c:V3=wg_mix_f3f3f(horizon,zenith,pow(up,0.5f32));
  s:f32=fmax(wg_dot3(d,v3(u[24],u[25],u[26])),0.0f32);
  c=wg_add_f3f3(c,wg_mul_f3f(v3(1.0f32,0.88f32,0.66f32),((pow(s,8.0f32)*0.25f32)+(pow(s,900.0f32)*1.2f32))));
  // trade-wind cumulus, broad and pale
  if (d.y>0.0f32) {
    q:V2=wg_mul_f2f(wg_div_f2f(v2(d.x,d.z),(d.y+0.18f32)),1.2f32);
    // three octaves, each turned, so the thresholded lattice doesn't show as blocks
    q2:V2=v2((q.x*1.71f32)-(q.y*1.10f32)+3.1f32,(q.x*1.10f32)+(q.y*1.71f32)-1.7f32);
    q3:V2=v2((q.x*1.20f32)-(q.y*3.85f32)-5.3f32,(q.x*3.85f32)+(q.y*1.20f32)+2.9f32);
    fbm:f32=((slab_noise(q)*0.5f32)+(slab_noise(q2)*0.3f32))+(slab_noise(q3)*0.2f32);
    cl:f32=smoothstep(0.5f32,0.78f32,fbm);
    c=wg_mix_f3f3f(c,v3(0.97f32,0.97f32,0.95f32),(cl*0.55f32)*smoothstep(0.04f32,0.3f32,d.y));
  }
  return c;
}
// The air between the eye and what it sees: a pale sea haze over kilometres.
slab_haze :: (c:V3,d:V3,dist:f32,u:[]f32)->V3 {
  a:f32=1.0f32-exp((-dist)/7000.0f32);
  tint:V3=wg_mix_f3f3f(v3(0.76f32,0.86f32,0.90f32),v3(1.0f32,0.92f32,0.78f32),pow(fmax(wg_dot3(d,v3(u[24],u[25],u[26])),0.0f32),6.0f32)*0.5f32);
  return wg_mix_f3f3f(c,tint,a*0.9f32);
}
// The water in the painted look, open ocean, with a ring of white water along the hull.
slab_water :: (p:V2,world:V3,d:V3,dist:f32,t:f32,u:[]f32)->V3 {
  c:V4=slab_coarse(p,u);
  footprint:f32=(((dist*2.0f32)*u[11])/u[1])/fmax(abs(d.y),0.08f32);
  keep:f32=clampf(((u[30]/64.0f32)/fmax(footprint,1e-4f32))-0.5f32,0.0f32,1.0f32);
  farfade:f32=1.0f32-smoothstep(400.0f32,6000.0f32,dist);
  slope:V2=wg_mul_f2f(wg_add_f2f2(v2(c.z,c.w),wg_mul_f2f(slab_fine(wg_add_f2f2(p,wg_mul_f2f(wg_mul_f2f(v2(u[32],u[33]),t),0.3f32)),u),keep)),0.35f32+(0.65f32*farfade));
  n:V3=wg_normalize3(v3(-slope.x,1.0f32,-slope.y));
  calm:V3=wg_normalize3(v3((-slope.x)/3.0f32,1.0f32,(-slope.y)/3.0f32));
  sun:V3=v3(u[24],u[25],u[26]);
  // deep tropical blue, lighter on the crests where the light comes through
  col:V3=v3(0.03f32,0.16f32,0.33f32);
  col=wg_add_f3f3(col,wg_mul_f3f(v3(0.02f32,0.12f32,0.12f32),clampf(c.x/fmax(u[35],0.2f32),0.0f32,1.0f32)));
  col=wg_mul_f3f(col,0.85f32+(0.3f32*fmax(wg_dot3(n,sun),0.0f32)));
  // the painted sky in Schlick's Fresnel, at most half of it
  v:V3=wg_neg_f3(d);
  r:V3=wg_reflect3(d,calm);
  fres:f32=0.02f32+(0.98f32*pow(1.0f32-fmax(wg_dot3(calm,v),0.0f32),5.0f32));
  col=wg_mix_f3f3f(col,slab_sky(v3(r.x,abs(r.y),r.z),u),fmin(fres,0.55f32));
  // sparkles on a grid near the sun's reflection, twinkling
  rs:V3=wg_reflect3(wg_neg_f3(sun),n);
  cell:f32=(ifx u[5]>0.5f32 then 0.25f32 else 0.15f32)*fmax(1.0f32,footprint/0.05f32);
  g:V2=wg_floor_f2(wg_div_f2f(v2(world.x,world.z),cell));
  tw:f32=slab_hash2(wg_add_f2f(g,floor(t*3.0f32)));
  near:f32=smoothstep(cos(0.07f32+(footprint*0.02f32)),1.0f32,wg_dot3(rs,v));
  // (faded out with distance: far off the cells grow with the footprint into white squares)
  glint:f32=1.0f32-smoothstep(200.0f32,1200.0f32,dist);
  col=wg_add_f3f3(col,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.95f32,0.85f32),stepf(0.82f32,tw)),near),1.4f32*glint));
  // whitecaps from the foam field, and white water breaking along the hull's walls
  froth:f32=(slab_noise(wg_add_f2f2(wg_mul_f2f(p,0.35f32),v2(t*0.2f32,0.0f32)))*0.6f32)+(slab_noise(wg_mul_f2f(p,1.3f32))*0.4f32);
  // (faded out far off, where the foam tile's texels would show as blocks)
  caps:f32=smoothstep(0.45f32,0.75f32,c.y*(0.6f32+froth))*(1.0f32-smoothstep(500.0f32,2500.0f32,dist));
  edge:f32=slab_hull_plan(p,u);
  wash:f32=(1.0f32-smoothstep(0.0f32,6.0f32+(10.0f32*froth),edge))*smoothstep(0.25f32,0.55f32,froth+(0.2f32*sin((p.x+p.y)*0.08f32+(t*1.3f32))));
  white:f32=clampf(fmax(caps*0.95f32,wash*0.9f32),0.0f32,1.0f32);
  col=wg_mix_f3f3f(col,wg_mul_f3f(v3(0.97f32,0.98f32,0.96f32),(0.85f32+(0.15f32*fmax(wg_dot3(n,sun),0.0f32)))),white);
  return col;
}
// ---- The platform: metaverse/slab-plan.coax's records, traced.
// A ray against a box: (t, normal), or t = SLAB_MISS when it misses or starts inside.
slab_box_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  ix:f32=ifx abs(d.x)>1e-6f32 then 1.0f32/d.x else 1e6f32;
  iy:f32=ifx abs(d.y)>1e-6f32 then 1.0f32/d.y else 1e6f32;
  iz:f32=ifx abs(d.z)>1e-6f32 then 1.0f32/d.z else 1e6f32;
  ax:f32=(lo.x-o.x)*ix; bx:f32=(hi.x-o.x)*ix;
  ay:f32=(lo.y-o.y)*iy; by:f32=(hi.y-o.y)*iy;
  az:f32=(lo.z-o.z)*iz; bz:f32=(hi.z-o.z)*iz;
  nx:f32=fmin(ax,bx); ny:f32=fmin(ay,by); nz:f32=fmin(az,bz);
  tn:f32=fmax(fmax(nx,ny),nz);
  tf:f32=fmin(fmin(fmax(ax,bx),fmax(ay,by)),fmax(az,bz));
  if ((tf<tn)||(tn<0.0f32)) {
    return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  }
  if (tn==nx) {
    return v4(tn,ifx d.x>0.0f32 then -1.0f32 else 1.0f32,0.0f32,0.0f32);
  }
  if (tn==ny) {
    return v4(tn,0.0f32,ifx d.y>0.0f32 then -1.0f32 else 1.0f32,0.0f32);
  }
  return v4(tn,0.0f32,0.0f32,ifx d.z>0.0f32 then -1.0f32 else 1.0f32);
}
// A ray against the upright cylinder inscribed in a box: its side and its top.
slab_drum_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  cx:f32=(lo.x+hi.x)*0.5f32;
  cz:f32=(lo.z+hi.z)*0.5f32;
  r:f32=fmin(hi.x-lo.x,hi.z-lo.z)*0.5f32;
  best:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  ox:f32=o.x-cx;
  oz:f32=o.z-cz;
  a:f32=(d.x*d.x)+(d.z*d.z);
  if (a>1e-8f32) {
    b:f32=(ox*d.x)+(oz*d.z);
    c:f32=((ox*ox)+(oz*oz))-(r*r);
    disc:f32=(b*b)-(a*c);
    if (disc>=0.0f32) {
      t:f32=((-b)-sqrt(disc))/a;
      y:f32=o.y+(t*d.y);
      if ((t>0.0f32)&&(y>=lo.y)&&(y<=hi.y)) {
        best=v4(t,(ox+(t*d.x))/r,0.0f32,(oz+(t*d.z))/r);
      }
    }
  }
  if (d.y<0.0f32) {
    t:f32=(hi.y-o.y)/d.y;
    px:f32=ox+(t*d.x);
    pz:f32=oz+(t*d.z);
    if ((t>0.0f32)&&(t<best.x)&&(((px*px)+(pz*pz))<=(r*r))) {
      best=v4(t,0.0f32,1.0f32,0.0f32);
    }
  }
  return best;
}
SlabHit :: struct {t:f32; n:V3; kind:f32; top:f32; }
// The nearest of the plan's records from `first` on, nearer than `limit`.
slab_scene :: (o:V3,d:V3,first:s32,limit:f32,u:[]f32)->SlabHit {
  hit:SlabHit=SlabHit.{t=limit,n=v3(0.0f32,1.0f32,0.0f32),kind=-1.0f32,top=0.0f32};
  // the platform's reach, keel to the tallest tower, first
  lo:V3=v3((-u[36])-12.0f32,u[39]-1.0f32,(-u[37])-12.0f32);
  hi:V3=v3(u[36]+12.0f32,u[38]+190.0f32,u[37]+12.0f32);
  inside:bool=(o.x>lo.x)&&(o.x<hi.x)&&(o.y>lo.y)&&(o.y<hi.y)&&(o.z>lo.z)&&(o.z<hi.z);
  if (!inside) {
    if (slab_box_hit(o,d,lo,hi).x>=limit) {
      return hit;
    }
  }
  count:s32=wg_i32_f(u[6]);
  i:s32=first;
  while i<count {
    at:int=SLAB_BOXES+((cast(int)i)*8);
    p:V4=wg_at4(u,at);
    q:V4=wg_at4(u,at+4);
    blo:V3=v3(p.x,p.y,p.z);
    bhi:V3=v3(q.x,q.y,q.z);
    h:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
    if (q.w>0.5f32) {
      h=slab_drum_hit(o,d,blo,bhi);
    } else {
      h=slab_box_hit(o,d,blo,bhi);
    }
    if (h.x<hit.t) {
      hit=SlabHit.{t=h.x,n=v3(h.y,h.z,h.w),kind=p.w,top=q.y};
    }
    i+=1;
  }
  return hit;
}
// Stripes: 1 on the first `share` of each `period` of v, else 0.
slab_band :: (v:f32,period:f32,share:f32)->f32 {
  f:f32=fract(v/period);
  return stepf(f,share);
}
// The paint of what the ray hit at w, by its kind (SLAB_KIND_* in metaverse/slab-plan.coax).
slab_paint :: (kind:f32,w:V3,n:V3,top:f32,d:V3,u:[]f32)->V3 {
  k:s32=wg_i32_f(kind+0.5f32);
  roof:bool=n.y>0.5f32;
  grain:f32=0.94f32+(0.08f32*slab_noise(v2((w.x*0.13f32)+(w.y*0.07f32),(w.z*0.13f32)-(w.y*0.05f32))));
  c:V3=v3(0.70f32,0.70f32,0.68f32);
  if (k==0) {
    if (roof) {
      // the deck: paving, 20 m streets on the 100 m grid, the promenade round the edge
      c=v3(0.70f32,0.69f32,0.65f32);
      gx:f32=abs((w.x/100.0f32)-wg_round(w.x/100.0f32))*100.0f32;
      gz:f32=abs((w.z/100.0f32)-wg_round(w.z/100.0f32))*100.0f32;
      if (fmin(gx,gz)<10.0f32) {
        c=v3(0.45f32,0.46f32,0.48f32);
        if (fmin(gx,gz)<0.4f32) {
          c=v3(0.92f32,0.90f32,0.82f32);
        }
      }
      if (slab_hull_plan(v2(w.x,w.z),u)>-20.0f32) {
        c=v3(0.80f32,0.74f32,0.64f32);
      }
    } else {
      // the walls: poured concrete in 5 m lifts, weathered dark at the waterline
      c=wg_mul_f3f(v3(0.62f32,0.62f32,0.60f32),0.94f32+(0.06f32*slab_band(w.y,5.0f32,0.08f32)));
      c=wg_mix_f3f3f(c,v3(0.22f32,0.28f32,0.27f32),1.0f32-smoothstep(0.5f32,3.0f32,w.y));
    }
  } else if (k==2) {
    c=v3(0.86f32,0.88f32,0.90f32);
    if (roof) {
      c=wg_mul_f3f(v3(0.74f32,0.77f32,0.80f32),0.92f32+(0.08f32*slab_band(w.x,6.0f32,0.5f32)));
    } else {
      c=wg_mul_f3f(c,0.9f32+(0.1f32*slab_band(w.y,4.0f32,0.8f32)));
    }
  } else if (k==3) {
    c=v3(0.60f32,0.44f32,0.33f32);
    if (!roof) {
      c=wg_mix_f3f3f(c,v3(0.36f32,0.34f32,0.33f32),slab_band(w.y,7.0f32,0.18f32));
    }
  } else if (k==4) {
    c=v3(0.30f32,0.34f32,0.40f32);
    if (roof) {
      // fans in rows on the halls' roofs
      fx:f32=fract(w.x/9.0f32)-0.5f32;
      fz:f32=fract(w.z/9.0f32)-0.5f32;
      c=ifx ((fx*fx)+(fz*fz))<0.09f32 then v3(0.16f32,0.18f32,0.21f32) else v3(0.46f32,0.48f32,0.52f32);
    } else {
      c=wg_mul_f3f(c,0.85f32+(0.15f32*slab_band(w.y,1.2f32,0.5f32)));
    }
  } else if (k==5) {
    if (roof) {
      c=v3(0.72f32,0.71f32,0.68f32);
    } else {
      // glass bands between the floors' white edges, the glass catching the sky
      storey:f32=fract((w.y-u[38])/3.6f32);
      glass:V3=wg_mix_f3f3f(v3(0.30f32,0.44f32,0.56f32),slab_sky(wg_reflect3(d,n),u),0.35f32);
      c=ifx storey>0.28f32 then glass else v3(0.90f32,0.88f32,0.82f32);
    }
  } else if (k==6) {
    // the stacks: off-white, red and white bands at the top
    c=v3(0.86f32,0.84f32,0.80f32);
    if ((w.y>(top-9.0f32))||((w.y>(top-19.0f32))&&(w.y<(top-14.0f32)))) {
      c=v3(0.74f32,0.20f32,0.15f32);
    }
    if (roof) {
      c=v3(0.12f32,0.11f32,0.10f32);
    }
  } else if (k==7) {
    c=wg_mix_f3f3f(v3(0.30f32,0.50f32,0.26f32),v3(0.42f32,0.60f32,0.30f32),slab_noise(v2(w.x*0.2f32,w.z*0.2f32)));
    if (top>(u[38]+2.0f32)) {
      c=wg_mul_f3f(c,0.75f32);
    }
  } else if (k==8) {
    // fifty containers in five rows: a colour each, a gap between them
    slot:f32=(w.x-160.0f32)/13.6f32;
    h:f32=slab_hash2(v2(floor(slot),floor(w.z/9.0f32)));
    c=v3(0.20f32,0.36f32,0.58f32);
    if (h>0.75f32) { c=v3(0.82f32,0.42f32,0.16f32); }
    else if (h>0.5f32) { c=v3(0.62f32,0.18f32,0.14f32); }
    else if (h>0.25f32) { c=v3(0.55f32,0.57f32,0.58f32); }
    if (fract(slot)>0.9f32) {
      c=v3(0.45f32,0.46f32,0.48f32);
    }
    if (!roof) {
      c=wg_mul_f3f(c,0.88f32+(0.12f32*slab_band(w.x,0.6f32,0.5f32)));
    }
  } else if (k==9) {
    c=v3(0.93f32,0.89f32,0.79f32);
    if (!roof) {
      c=wg_mul_f3f(c,0.86f32+(0.14f32*slab_band(w.x+w.z,4.0f32,0.65f32)));
    }
  } else if (k==10) {
    c=v3(0.90f32,0.90f32,0.87f32);
  } else if (k==11) {
    c=v3(0.86f32,0.90f32,0.91f32);
    if (!roof) {
      c=ifx fract((w.y-u[38])/3.6f32)>0.45f32 then v3(0.42f32,0.56f32,0.62f32) else c;
    }
  } else if (k==12) {
    c=v3(0.90f32,0.72f32,0.18f32);
  } else if (k==13) {
    c=v3(0.55f32,0.57f32,0.60f32);
    if (roof) {
      fx:f32=fract(w.x/10.0f32)-0.5f32;
      fz:f32=fract(w.z/10.0f32)-0.5f32;
      c=ifx ((fx*fx)+(fz*fz))<0.12f32 then v3(0.20f32,0.22f32,0.24f32) else c;
    }
  } else if (k==14) {
    c=v3(0.05f32,0.23f32,0.33f32);
  }
  return wg_mul_f3f(c,grain);
}
// The lit colour of a hit: the sky's light from above, the sun's where nothing on the deck shades it.
slab_lit :: (hit:SlabHit,o:V3,d:V3,u:[]f32)->V3 {
  w:V3=wg_add_f3f3(o,wg_mul_f3f(d,hit.t));
  n:V3=hit.n;
  sun:V3=v3(u[24],u[25],u[26]);
  base:V3=slab_paint(hit.kind,w,n,hit.top,d,u);
  ndl:f32=fmax(wg_dot3(n,sun),0.0f32);
  shade:f32=1.0f32;
  if ((ndl>0.0f32)&&(u[5]<0.5f32)) {
    // the masses' shadows (the records after the hull's six pieces), on a desktop
    s:SlabHit=slab_scene(wg_add_f3f3(w,wg_mul_f3f(n,0.05f32)),sun,6,4000.0f32,u);
    if (s.t<4000.0f32) {
      shade=0.0f32;
    }
  }
  sky:f32=0.46f32+(0.16f32*n.y);
  light:f32=sky+((0.72f32*ndl)*shade);
  // painterly: the light in soft steps
  light=mix(light,floor((light*6.0f32)+0.5f32)/6.0f32,0.35f32);
  c:V3=wg_mul_f3f3(wg_mul_f3f(base,light),v3(1.02f32,1.0f32,0.96f32));
  // shade's cool fill
  c=wg_add_f3f3(c,wg_mul_f3f(v3(0.02f32,0.04f32,0.08f32),1.0f32-(ndl*shade)));
  return c;
}
slab_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
// The depth buffer's value for a point `along` the view ray d (1 - near / view z: the
// surface's projection), so the clipmap hides behind the traced platform.
SLAB_NEAR :: 0.5f32;
slab_depth_of :: (d:V3,along:f32,u:[]f32)->f32 {
  return clampf(1.0f32-(SLAB_NEAR/fmax(along*wg_dot3(d,v3(u[12],u[13],u[14])),SLAB_NEAR)),0.0f32,1.0f32);
}
SlabOut :: struct {c:V4; depth:f32 #depth; }
slab_bg_fs :: (frag:V4,u:[]f32)->SlabOut {
  ndc:V2=v2(((frag.x/u[0])*2.0f32)-1.0f32,1.0f32-((frag.y/u[1])*2.0f32));
  aspect:f32=u[0]/u[1];
  d:V3=wg_normalize3(wg_add_f3f3(wg_add_f3f3(v3(u[12],u[13],u[14]),wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(u[16],u[17],u[18]),ndc.x),u[11]),aspect)),wg_mul_f3f(wg_mul_f3f(v3(u[20],u[21],u[22]),ndc.y),u[11])));
  o:V3=v3(u[8],u[9],u[10]);
  hit:SlabHit=slab_scene(o,d,0,SLAB_MISS,u);
  if (hit.t<SLAB_MISS) {
    c:V3=slab_haze(slab_lit(hit,o,d,u),d,hit.t,u);
    return SlabOut.{c=v4(c.x,c.y,c.z,1.0f32),depth=slab_depth_of(d,hit.t,u)};
  }
  c:V3=slab_haze(slab_sky(d,u),d,40000.0f32*(1.0f32-smoothstep(0.0f32,0.2f32,d.y)),u);
  return SlabOut.{c=v4(c.x,c.y,c.z,1.0f32),depth=1.0f32};
}
// ---- The clipmap sea: a vertex from its index, as ocean_vertex does it.
SlabS :: struct {pos:V4; rest:V2; world:V3; }
slab_surface_vs :: (vid:u32,_iid2:u32,u:[]f32)->SlabS {
  n:u32=wg_u32_f(u[44]);
  count:u32=wg_u32_f(u[45]);
  half:u32=n/2;
  q:u32=vid/6;
  corner:u32=vid%6;
  full:u32=mul_wrap(n,n);
  ring:u32=sub_wrap(full,mul_wrap(half,half));
  l:u32=0;
  if (q>=full) {
    q=sub_wrap(q,full);
    l=wg_min_u(add_wrap(cast(u32)1,q/ring),sub_wrap(count,cast(u32)1));
    q=sub_wrap(q,mul_wrap(sub_wrap(l,cast(u32)1),ring));
  }
  lv:V4=wg_at4(u,(cast(int)l)*4+48);
  qx:u32=q%n;
  qz:u32=q/n;
  if (l>0) {
    hole:u32=wg_u32_f(lv.w);
    hx:u32=add_wrap(n/4,(hole&1));
    hz:u32=add_wrap(n/4,(hole>>1));
    top:u32=mul_wrap(hz,n);
    if (q>=top) {
      band:u32=sub_wrap(q,top);
      if (band<mul_wrap(half,half)) {
        col:u32=band%half;
        qx=ifx col<hx then col else add_wrap(col,half);
        qz=add_wrap(hz,band/half);
      } else {
        rest:u32=sub_wrap(band,mul_wrap(half,half));
        qx=rest%n;
        qz=add_wrap(add_wrap(hz,half),rest/n);
      }
    }
  }
  cx:[6]u32=[6]u32.[0,1,0,0,1,1];
  cz:[6]u32=[6]u32.[0,0,1,1,0,1];
  ix:s32=cast,trunc(s32)(add_wrap(qx,cx[cast(int)corner]));
  iz:s32=cast,trunc(s32)(add_wrap(qz,cz[cast(int)corner]));
  gx:s32=((wg_i32_f(wg_round(lv.x/lv.z)))-(cast,trunc(s32)(half)))+ix;
  gz:s32=((wg_i32_f(wg_round(lv.y/lv.z)))-(cast,trunc(s32)(half)))+iz;
  rx:s32=wg_abs_i(ix-(cast,trunc(s32)(half)));
  rz:s32=wg_abs_i(iz-(cast,trunc(s32)(half)));
  edge:s32=wg_max_i(rx,rz);
  a:f32=0.0f32;
  if (add_wrap(l,cast(u32)1)<count) {
    a=clampf((cast(f32)(edge-((cast,trunc(s32)(half))-(wg_i32_f(u[46])))))/u[46],0.0f32,1.0f32);
  }
  p:V2=v2(((cast(f32)(gx))-(a*(cast(f32)(gx&1))))*lv.z,((cast(f32)(gz))-(a*(cast(f32)(gz&1))))*lv.z);
  if ((add_wrap(l,cast(u32)1)==count)&&(edge==(cast,trunc(s32)(half)))) {
    p=wg_add_f2f2(v2(lv.x,lv.y),wg_mul_f2f(wg_sub_f2f2(p,v2(lv.x,lv.y)),(u[47]/((cast(f32)(half))*lv.z))));
  }
  // the waves: the sea's height, and cascade 0's choppy displacement, both faded out where
  // the quads grow too coarse to carry them (past a few patches)
  reach:f32=wg_length2(wg_sub_f2f2(p,v2(u[8],u[10])));
  keep:f32=1.0f32-smoothstep(u[29]*2.5f32,u[29]*8.0f32,reach);
  moved:V2=wg_mul_f2f(slab_chop(p,u),keep);
  w:V3=v3(p.x+moved.x,u[28]+((slab_sea_height(p,u)-u[28])*keep),p.y+moved.y);
  o:SlabS;
  rel:V3=wg_sub_f3f3(w,v3(u[8],u[9],u[10]));
  vz:f32=wg_dot3(rel,v3(u[12],u[13],u[14]));
  aspect:f32=u[0]/u[1];
  o.pos=v4(wg_dot3(rel,v3(u[16],u[17],u[18]))/(u[11]*aspect),wg_dot3(rel,v3(u[20],u[21],u[22]))/u[11],vz-SLAB_NEAR,vz);
  o.rest=p;
  o.world=w;
  return o;
}
slab_surface_fs :: (v:SlabS,u:[]f32)->V4 {
  rel:V3=wg_sub_f3f3(v.world,v3(u[8],u[9],u[10]));
  dist:f32=wg_length3(rel);
  d:V3=wg_div_f3f(rel,fmax(dist,1e-4f32));
  c:V3=slab_water(v.rest,v.world,d,dist,u[2],u);
  return wg_make_f4_f3f(slab_haze(c,d,dist,u),1.0f32);
}
// The strokes (none yet): host.js draws them over the pass.
SlabV :: struct {pos:V4; tint:V4; }
slab_fx_vs_in :: struct {a:V4; b:V4; c:V4; e:V4; }
slab_fx_vs :: (_vid3:u32,_iid4:u32,in_:slab_fx_vs_in,u:[]f32)->SlabV {
  a:V4=in_.a;
  c:V4=in_.c;
  o:SlabV;
  o.pos=v4(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.tint=c;
  return o;
}
slab_fx_fs :: (v:SlabV)->V4 {
  return wg_make_f4_f3f(v3(v.tint.x,v.tint.y,v.tint.z),1.0f32);
}

// ---- the vector helpers this file calls
wg_get_u4 :: (p:U4,i:int)->u32 {if i==0 {return p.x;} if i==1 {return p.y;} if i==2 {return p.z;} return p.w;}
wg_div_f2f :: (a:V2,b:f32)->V2 {return v2(a.x/b,a.y/b);}
wg_mul_f2f :: (a:V2,b:f32)->V2 {return v2(a.x*b,a.y*b);}
wg_sub_f2f :: (a:V2,b:f32)->V2 {return v2(a.x-b,a.y-b);}
wg_fract_f2 :: (p0:V2)->V2 {return v2(fract(p0.x),fract(p0.y));}
wg_floor_f2 :: (p0:V2)->V2 {return v2(floor(p0.x),floor(p0.y));}
wg_cvt_i2f2 :: (p:V2)->I2 {return i2(wg_i32_f(p.x),wg_i32_f(p.y));}
wg_add_i2i2 :: (a:I2,b:I2)->I2 {return i2(a.x+b.x,a.y+b.y);}
wg_make_i2_i :: (p0:s32)->I2 {return i2(p0,p0);}
wg_band_i2i2 :: (a:I2,b:I2)->I2 {return i2(a.x&b.x,a.y&b.y);}
wg_cvt_u2i2 :: (p:I2)->U2 {return u2(cast,trunc(u32)(p.x),cast,trunc(u32)(p.y));}
wg_mul_ff4 :: (a:f32,b:V4)->V4 {return v4(a*b.x,a*b.y,a*b.z,a*b.w);}
wg_add_f4f4 :: (a:V4,b:V4)->V4 {return v4(a.x+b.x,a.y+b.y,a.z+b.z,a.w+b.w);}
wg_mul_ff2 :: (a:f32,b:V2)->V2 {return v2(a*b.x,a*b.y);}
wg_add_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x+b.x,a.y+b.y);}
wg_sw_xy_f4 :: (p:V4)->V2 {return v2(p.x,p.y);}
wg_mul_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x*b.x,a.y*b.y);}
wg_sub_ff2 :: (a:f32,b:V2)->V2 {return v2(a-b.x,a-b.y);}
wg_sub_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x-b.x,a.y-b.y);}
wg_mix_f3f3f :: (p0:V3,p1:V3,p2:f32)->V3 {return v3(mix(p0.x,p1.x,p2),mix(p0.y,p1.y,p2),mix(p0.z,p1.z,p2));}
wg_mul_f3f :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
wg_add_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
wg_add_f2f :: (a:V2,b:f32)->V2 {return v2(a.x+b,a.y+b);}
wg_mul_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x*b.x,a.y*b.y,a.z*b.z);}
wg_neg_f3 :: (a:V3)->V3 {return v3(-a.x,-a.y,-a.z);}
wg_sub_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
wg_div_f3f :: (a:V3,b:f32)->V3 {return v3(a.x/b,a.y/b,a.z/b);}
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
