  }
  if (oncut) {
    return slab_section(k,w,u);
  }
  if (k==21) {
    // the pipes: dark fibre-reinforced plastic, ringed every 12 m where its lengths join
    c=sb_mul(v3(0.16f32,0.17f32,0.18f32),0.9f32+(0.2f32*slab_band(w.y,12.0f32,0.08f32)));
    return SlabPaint.{c=c,emit=emit};
  }
  if ((k==0)&&(n.y< -0.5f32)) {
    // the bottom slab: bare concrete under a film of marine growth, the formwork's joints every 10 m
    jx:f32=abs(fract(w.x/10.0f32)-0.5f32); jz:f32=abs(fract(w.z/10.0f32)-0.5f32);
    c=sb_mul(v3(0.42f32,0.45f32,0.40f32),(0.85f32+(0.15f32*slab_noise(v2(w.x*0.05f32,w.z*0.05f32))))*(1.0f32-(0.12f32*stepf(0.48f32,fmax(jx,jz)))));
    return SlabPaint.{c=c,emit=emit};
  }
  if (k==0) {
    if (roof) {
      // the deck: pale paving, 20 m streets on the 100 m grid, the promenade and its parapet
      c=v3(0.82f32,0.79f32,0.72f32);
      gx:f32=abs((w.x/100.0f32)-wg_round(w.x/100.0f32))*100.0f32;
      gz:f32=abs((w.z/100.0f32)-wg_round(w.z/100.0f32))*100.0f32;
      if (fmin(gx,gz)<10.0f32) {
        c=v3(0.70f32,0.69f32,0.66f32);
        if (abs(fmin(gx,gz)-5.0f32)<0.25f32) { c=v3(0.9f32,0.88f32,0.8f32); }
      }
      // paving joints every 5 m
      jx:f32=abs(fract(w.x/5.0f32)-0.5f32); jz:f32=abs(fract(w.z/5.0f32)-0.5f32);
      c=sb_mul(c,1.0f32-(0.05f32*stepf(0.47f32,fmax(jx,jz))));
      edge:f32=slab_hull_plan(v2(w.x,w.z),u);
      if (edge>-20.0f32) { c=v3(0.9f32,0.87f32,0.8f32); }
      if (edge>-1.6f32) { c=v3(0.95f32,0.93f32,0.88f32); }
    } else {
      // the walls: cream precast panels on the concept image's 5 x 4.5 m grid, each its own shade,
      // streaked by weather, dark and green at the waterline, and the spray where the waves strike
      along:f32=ifx abs(n.x)>abs(n.z) then w.z else w.x;
      pu:f32=floor(along/5.0f32); pv:f32=floor(w.y/4.5f32);
      tone:f32=0.94f32+(0.08f32*slab_hash2(v2(pu,pv)));
      c=sb_mul(v3(0.86f32,0.82f32,0.74f32),tone);
      // the joints, fading to an even shade where they are finer than a pixel
      fine:f32=1.0f32-smoothstep(500.0f32,1600.0f32,hit.t);
      lu:f32=abs(fract(along/5.0f32)-0.5f32); lv:f32=abs(fract(w.y/4.5f32)-0.5f32);
      line:f32=fmax(stepf(0.47f32,lu),stepf(0.465f32,lv));
      c=sb_mul(c,1.0f32-(((0.2f32*line)*fine)+(0.05f32*(1.0f32-fine))));
      streak:f32=slab_noise(v2(along*0.6f32,w.y*0.02f32));
      c=sb_mul(c,0.93f32+(0.07f32*streak));
      c=sb_mix(c,v3(0.30f32,0.34f32,0.30f32),(1.0f32-smoothstep(-1.0f32,2.5f32,w.y))*0.8f32);
    }
  } else if ((k==2)||(k==20)) {
    c=v3(0.88f32,0.89f32,0.90f32);
    if (roof) {
      c=sb_mul(v3(0.70f32,0.73f32,0.76f32),0.92f32+(0.08f32*slab_band(w.x+w.z,6.0f32,0.5f32)));
    } else {
      c=sb_mul(c,0.88f32+(0.12f32*slab_band(w.y,4.0f32,0.8f32)));
      win:f32=slab_band(w.x+w.z,8.0f32,0.3f32)*slab_band(w.y-deck,6.0f32,0.25f32);
      c=sb_mix(c,v3(0.25f32,0.32f32,0.38f32),win*0.6f32);
      emit=sb_mul(v3(1.0f32,0.8f32,0.5f32),win*night*0.5f32);
    }
  } else if (k==3) {
    c=v3(0.74f32,0.70f32,0.64f32);
    if (!roof) {
      c=sb_mix(c,v3(0.45f32,0.43f32,0.42f32),slab_band(w.y,7.0f32,0.18f32));
      pipes:f32=slab_band(w.x+w.z,3.0f32,0.2f32)*smoothstep(4.0f32,6.0f32,w.y-deck);
      c=sb_mix(c,v3(0.6f32,0.6f32,0.58f32),pipes*0.5f32);
    } else {
