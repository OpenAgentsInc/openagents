      fz:f32=fract(w.z/10.0f32)-0.5f32;
      c=ifx ((fx*fx)+(fz*fz))<0.12f32 then v3(0.20f32,0.22f32,0.24f32) else c;
    }
  } else if (k==14) {
    // water on the deck: the sky in it, its depth's colour
    sky:V3=slab_sky(wg_reflect3(d,v3(0.0f32,1.0f32,0.0f32)),u);
    c=sb_mix(v3(0.06f32,0.26f32,0.32f32),sky,0.45f32);
    if (!roof) { c=v3(0.82f32,0.80f32,0.74f32); } else { c=sw_pool(c,w,d,u); }
  } else if (k==15) {
    if (w.y<hit.lo.y+0.45f32) {
      // the lawn under the trees, a hedge round its edge
      c=sb_mix(v3(0.42f32,0.46f32,0.26f32),v3(0.54f32,0.56f32,0.34f32),slab_noise(v2(w.x*0.3f32,w.z*0.3f32)));
      e:f32=fmin(fmin(w.x-hit.lo.x,hit.hi.x-w.x),fmin(w.z-hit.lo.z,hit.hi.z-w.z));
      if (e<2.0f32) { c=v3(0.22f32,0.32f32,0.16f32); }
      // paths of pale gravel through it every 24 m, and a paved margin, as the concept image's beds
      px:f32=abs(fract(w.x/24.0f32)-0.5f32)*24.0f32;
      pz:f32=abs(fract(w.z/24.0f32)-0.5f32)*24.0f32;
      if ((px<1.6f32)||(pz<1.6f32)||((e>2.0f32)&&(e<4.5f32))) { c=v3(0.84f32,0.80f32,0.70f32); }
      // gravel paths across a glade
      gcx:f32=(hit.lo.x+hit.hi.x)*0.5f32; gcz:f32=(hit.lo.z+hit.hi.z)*0.5f32;
      if ((abs(w.x-gcx)<2.0f32)||(abs(w.z-gcz)<2.0f32)) { c=v3(0.84f32,0.80f32,0.70f32); }
    } else {
