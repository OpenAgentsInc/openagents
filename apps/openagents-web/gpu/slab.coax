      c=sb_mix(v3(0.14f32,0.20f32,0.10f32),v3(0.30f32,0.36f32,0.18f32),nz);
    }
  } else if (k==17) {
    // the plaza: rings of paving round the fountain
    rr:f32=wg_length2(v2(w.x-((hit.lo.x+hit.hi.x)*0.5f32),w.z-((hit.lo.z+hit.hi.z)*0.5f32)));
    c=sb_mix(v3(0.88f32,0.85f32,0.78f32),v3(0.72f32,0.70f32,0.66f32),slab_band(rr,6.0f32,0.12f32));
  } else if (k==28) {
    // a Silone dome: the concrete base ring (weed at the waterline), planted terraces, glass risers
    dcx:f32=(hit.lo.x+hit.hi.x)*0.5f32; dcz:f32=(hit.lo.z+hit.hi.z)*0.5f32;
    rr:f32=sqrt(((w.x-dcx)*(w.x-dcx))+((w.z-dcz)*(w.z-dcz)));
    yc:f32=hit.lo.y+16.0f32;
    big:f32=(hit.hi.x-hit.lo.x)*0.5f32;
    if (w.y<yc-0.05f32) {
      c=sb_mul(v3(0.82f32,0.80f32,0.75f32),0.94f32+(0.06f32*slab_band(w.y,4.0f32,0.08f32)));
      c=sb_mix(v3(0.20f32,0.27f32,0.22f32),c,smoothstep(hit.lo.y+11.0f32,hit.lo.y+13.5f32,w.y));
    } else if (n.y>0.5f32) {
      tier:f32=wg_round((w.y-yc)/6.0f32);
      edge:f32=big-(6.0f32*tier);
      c=v3(0.86f32,0.84f32,0.78f32);
      if (rr>edge-2.6f32) { c=sb_mix(v3(0.26f32,0.36f32,0.16f32),v3(0.38f32,0.46f32,0.22f32),slab_noise(v2(w.x*0.5f32,w.z*0.5f32))); }
      if (w.y>yc+29.0f32) { c=ifx rr<4.5f32 then v3(0.9f32,0.9f32,0.88f32) else v3(0.80f32,0.82f32,0.80f32); }
    } else {
      ang:f32=wg_atan2(w.z-dcz,w.x-dcx)*rr;
      mull:f32=fmax(slab_band(ang,3.0f32,0.1f32),slab_band(w.y-yc,3.0f32,0.08f32));
      c=sb_mix(v3(0.30f32,0.38f32,0.42f32),v3(0.92f32,0.92f32,0.90f32),mull);
      if (w.y>yc+30.0f32) { c=sb_mix(v3(0.62f32,0.74f32,0.78f32),v3(0.92f32,0.92f32,0.90f32),mull); }
      emit=sb_mul(v3(1.0f32,0.86f32,0.62f32),(1.0f32-mull)*u[SLAB_P+39]*0.5f32);
    }
  } else if (k==30) {
    // the powership: a dark grey hull, red below its boot-top, white houses, grey stacks
    c=ifx w.y<0.5f32 then v3(0.45f32,0.12f32,0.09f32) else ifx w.y<8.05f32 then v3(0.24f32,0.26f32,0.29f32) else v3(0.90f32,0.90f32,0.88f32);
    if ((w.y>8.05f32)&&(n.y<0.5f32)&&(w.y>hit.lo.y+10.0f32)) { c=sb_mix(c,v3(0.20f32,0.26f32,0.32f32),slab_band(w.y,3.0f32,0.35f32)); }
    if (hit.hi.y>30.0f32) { c=ifx w.y>31.0f32 then v3(0.15f32,0.15f32,0.16f32) else v3(0.62f32,0.63f32,0.64f32); }
  } else if (k==31) {
    c=v3(0.10f32,0.10f32,0.10f32);
  } else if (k==29) {
    // a bridge: a concrete deck, its edges white rails
    c=ifx n.y>0.5f32 then v3(0.70f32,0.69f32,0.66f32) else v3(0.58f32,0.57f32,0.55f32);
  } else if (k==27) {
    // the statues: white cast stone, a little darker on the pedestal
    c=ifx w.y<(hit.lo.y+1.8f32) then v3(0.86f32,0.84f32,0.79f32) else v3(0.95f32,0.93f32,0.88f32);
  } else if (k==19) {
    c=v3(0.95f32,0.97f32,1.0f32);
  } else if (k==41) {
    c=v3(0.86f32,0.64f32,0.50f32);
  } else if (k==42) {
    c=v3(0.95f32,0.45f32,0.18f32);
  } else if (k==43) {
    c=v3(0.16f32,0.2f32,0.3f32);
  } else if (k==44) {
    c=v3(0.12f32,0.09f32,0.07f32);
  } else if (k==45) {
    c=v3(0.20f32,0.19f32,0.16f32);
  }
  return SlabPaint.{c=sb_mul(c,grain),emit=emit};
}
// The lit colour of a hit (hull frame): the sky's light, the sun's where nothing shades it, and a
// warm pulse round what is selected.
slab_lit :: (hit:SlabHit,o:V3,d:V3,u:[]f32)->V3 {
  if (slab_photo(u)) { return slab_photo_lit(hit,o,d,u); }
  w:V3=sb_add(o,sb_mul(d,hit.t));
  n:V3=hit.n;
  sun:V3=sb_p(u,40);
  scol:V3=sb_p(u,4);
  amb:f32=u[SLAB_P+7];
  pt:SlabPaint=slab_paint(hit,w,d,u);
  base:V3=pt.c;
  ndl:f32=fmax(wg_dot3(n,sun),0.0f32);
  shade:f32=1.0f32;
  if ((ndl>0.0f32)&&(u[5]<0.5f32)&&(hit.kind<39.0f32)) {
    s:SlabHit=slab_scene(sb_add(w,sb_mul(n,0.08f32)),sun,true,900.0f32,u);
    if (s.t<900.0f32) { shade=0.0f32; }
    if (shade>0.0f32) {
      ch:SlabHit=slab_walker(sb_add(w,sb_mul(n,0.05f32)),sun,60.0f32,u);
      if (ch.t<60.0f32) { shade=0.0f32; }
    }
  }
  skyc:V3=sb_mix(sb_p(u,12),sb_p(u,8),0.5f32+(0.5f32*n.y));
  // a little ambient occlusion where walls meet the deck
  occ:f32=ifx abs(n.y)<0.5f32 then 0.72f32+(0.28f32*smoothstep(0.0f32,6.0f32,w.y-u[38])) else 1.0f32;
  if (hit.kind<0.5f32) { occ=1.0f32; }
  light:V3=sb_add(sb_mul(skyc,(0.36f32+(0.2f32*n.y))*(1.0f32+(0.1f32*u[SLAB_P+43]))*occ*(0.35f32+(0.65f32*amb))),sb_mul(scol,ndl*shade*(1.05f32+(0.9f32*u[SLAB_P+43]))));
  c:V3=sb_mulv(base,light);
  // the sea's light bounced up onto the walls
  if (n.y<0.3f32) { c=sb_add(c,sb_mul(sb_mulv(base,v3(0.05f32,0.09f32,0.1f32)),amb*smoothstep(30.0f32,0.0f32,w.y))); }
  c=sb_add(c,pt.emit);
  if (hit.id>-0.5f32) {
    if (abs(hit.id-u[SLAB_P+36])<0.5f32) {
      pulse:f32=0.5f32+(0.5f32*sin(u[SLAB_P+38]*5.0f32));
      c=sb_add(sb_mul(c,1.1f32),sb_mul(v3(1.0f32,0.62f32,0.2f32),0.12f32+(0.12f32*pulse)));
    } else if (abs(hit.id-u[SLAB_P+37])<0.5f32) {
      c=sb_add(sb_mul(c,1.06f32),v3(0.06f32,0.05f32,0.03f32));
    }
  }
  return c;
}
// The industry's smoke: a plume from each stack's top, drifting downwind and spreading, lit
// from behind when the eye looks toward the sun. (rgb, opacity) for the ray up to `limit`.
slab_smoke :: (o:V3,d:V3,limit:f32,u:[]f32)->V4 {
  amount:f32=u[SLAB_P+3];
  first:s32=wg_i32_f(u[SLAB_P+1]);
  count:s32=wg_i32_f(u[SLAB_P+2]);
  acc:V3=v3(0.0f32,0.0f32,0.0f32);
  alpha:f32=0.0f32;
  if ((amount<0.01f32)||(first<0)) { return v4(0.0f32,0.0f32,0.0f32,0.0f32); }
  sun:V3=v3(u[24],u[25],u[26]);
  scol:V3=sb_p(u,4);
  wind:f32=u[34];
  rise:f32=1.8f32/(1.0f32+(wind*0.12f32));
  v:V3=wg_normalize3(v3(u[32],rise,u[33]));
  L:f32=190.0f32+(wind*7.0f32);
  i:s32=first;
  while i<first+count {
    at:int=SLAB_BOXES+((cast(int)i)*8);
    p:V4=wg_at4(u,at);
    q:V4=wg_at4(u,at+4);
    a:V3=v3((p.x+q.x)*0.5f32,q.y,(p.z+q.z)*0.5f32);
    w0:V3=sb_sub(o,a);
    b:f32=wg_dot3(d,v); dd:f32=wg_dot3(d,w0); e:f32=wg_dot3(v,w0);
    den:f32=fmax(1.0f32-(b*b),1e-5f32);
    s:f32=clampf(((e)-(b*dd))/den,0.0f32,L);
    pa:V3=sb_add(a,sb_mul(v,s));
    t:f32=wg_dot3(sb_sub(pa,o),d);
    // only the four tallest stacks (over 90 m) smoke, as in the concept image
    if ((t>0.0f32)&&(t<limit)&&((q.y-u[38])>90.0f32)) {
      dist:f32=wg_length3(sb_sub(sb_add(o,sb_mul(d,t)),pa));
      r:f32=3.0f32+(s*0.24f32);
      billow:f32=0.55f32+(0.45f32*slab_noise(v2((s*0.06f32)-(u[2]*0.5f32),(cast(f32)(i)*3.7f32)+(dist*0.08f32))));
      dens:f32=exp(-((dist/r)*(dist/r))*1.7f32)*sb_pow(1.0f32-(s/L),1.4f32)*billow*amount;
      a1:f32=(1.0f32-exp(-dens*3.5f32))*0.95f32;
      fwd:f32=sb_pow(fmax(wg_dot3(d,sun),0.0f32),4.0f32);
      // white steam and smoke, lit by the sky, the sun's warmth through it when the eye looks toward the sun
      sc:V3=sb_add(sb_mul(v3(0.93f32,0.92f32,0.9f32),0.3f32+(0.6f32*u[SLAB_P+7])),sb_mul(scol,0.3f32+(0.45f32*fwd)));
      sc=sb_mul(sc,0.9f32+(0.1f32*billow));
      acc=sb_add(sb_mul(acc,1.0f32-a1),sb_mul(sc,a1));
      alpha=alpha+(a1*(1.0f32-alpha));
    }
    i+=1;
  }
  return v4(acc.x,acc.y,acc.z,alpha);
}
slab_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
// The depth buffer's value for a point `along` the view ray d (1 - near / view z: the
// surface's projection), so the clipmap hides behind the traced platform.
SLAB_NEAR :: 0.5f32;
slab_depth_of :: (d:V3,along:f32,u:[]f32)->f32 {
  return clampf(1.0f32-(SLAB_NEAR/fmax(along*wg_dot3(d,v3(u[12],u[13],u[14])),SLAB_NEAR)),0.0f32,1.0f32);
}
// c the display's colour, aux what the post pass reads (photoreal.coax pr_lit_plain: no contact shade on a traced view or the sky)
SlabOut :: struct {c:V4; aux:V4; depth:f32 #depth; }
slab_bg_fs :: (frag:V4,u:[]f32)->SlabOut {
  ndc:V2=v2(((frag.x/u[0])*2.0f32)-1.0f32,1.0f32-((frag.y/u[1])*2.0f32));
  aspect:f32=u[0]/u[1];
  d:V3=wg_normalize3(sb_add(sb_add(v3(u[12],u[13],u[14]),sb_mul(sb_mul(v3(u[16],u[17],u[18]),ndc.x),u[11]*aspect)),sb_mul(v3(u[20],u[21],u[22]),ndc.y*u[11])));
  o:V3=v3(u[8],u[9],u[10]);
  ho:V3=sb_to_hull(o,u);
  hd:V3=sb_dir_to_hull(d,u);
  hit:SlabHit=slab_photo_first(ho,hd,u);
  ch:SlabHit=slab_walker(ho,hd,hit.t,u);
  if (ch.t<hit.t) { hit=ch; }
  // under the sea (the underwater view, or through the section's slot)
  wet:bool=(u[SLAB_P+56]>0.5f32)||(u[SLAB_P+52]!=0.0f32);
  if (u[SLAB_P+56]>0.5f32) {
    ln:SlabHit=slab_lines(o,d,hit.t,u);
    if (ln.t<hit.t) { hit=ln; }
  }
  if (hit.t<SLAB_MISS) {
    under:f32=ifx wet then slab_under_len(ho,hd,hit.t) else 0.0f32;
    // under the sea the photoreal style hands the water the frame's light, not a display's colour
    c:V3=ifx slab_photo(u)&&(under>0.0f32) then slab_photo_light(hit,ho,hd,u) else slab_lit(hit,ho,hd,u);
    // the section's cut face reads as a drawing: the water in front of it only tints it
    wy:f32=ho.y+(hd.y*hit.t);
    if ((u[SLAB_P+52]!=0.0f32)&&(abs(hit.n.z)>0.9f32)&&(abs((ho.z+(hd.z*hit.t))-u[SLAB_P+53])<0.6f32)) { under=under*0.12f32; wy=0.0f32; }
    if (under>0.0f32) {
      c=slab_through_water(c,under,wy,fmin(ho.y,0.0f32),hd.y,u);
      if (ho.y<0.0f32) { c=sw_under(c,ho,hd,hit.t,u); }
      if (ho.y>0.0f32) { c=slab_haze(c,d,hit.t-under,u); }
    } else {
      c=slab_haze(c,d,hit.t,u);
    }
    sm:V4=slab_smoke(ho,hd,hit.t,u);
    c=sb_mix(c,v3(sm.x,sm.y,sm.z),sm.w);
    if (ho.y>0.0f32) { c=slab_weather_air(c,v2(frag.x,frag.y),u); }
    c=slab_grade(c,u);
    return SlabOut.{c=v4(c.x,c.y,c.z,1.0f32),aux=v4(0.0f32,1.0f32,0.0f32,PR_POST_NONE),depth=slab_depth_of(d,hit.t,u)};
  }
  // through the section's slot (where the ray meets the waterline) or from under the sea
  slot:bool=false;
  if ((u[SLAB_P+52]!=0.0f32)&&(hd.y<0.0f32)&&(ho.y>0.0f32)) {
    c0:V3=sb_add(ho,sb_mul(hd,ho.y/(-hd.y)));
    beyond:f32=u[SLAB_P+52]*(c0.z-u[SLAB_P+53]);
    slot=(abs(c0.x)<u[36]+20.0f32)&&(beyond>0.0f32)&&(beyond<1500.0f32);
  }
  if (slot||((u[SLAB_P+56]>0.5f32)&&((hd.y<0.0f32)||(ho.y<0.0f32)))) {
    // open water all the way: the sea's own light, the sun's shafts, the bed where it is near
    c:V3=ifx slot then slab_deep_colour(fmin(ho.y,0.0f32),hd.y,u) else slab_sea_open(o,d,u);
    if (ho.y<0.0f32) { c=sw_under(c,ho,hd,4000.0f32,u); }
    c=slab_grade(c,u);
    return SlabOut.{c=v4(c.x,c.y,c.z,1.0f32),aux=v4(0.0f32,1.0f32,0.0f32,PR_POST_NONE),depth=1.0f32};
  }
  c:V3=slab_land(slab_haze(slab_weather_sky(slab_sky(d,u),d,u),d,40000.0f32*(1.0f32-smoothstep(0.0f32,0.2f32,d.y)),u),d,o,u);
  sm:V4=slab_smoke(ho,hd,SLAB_MISS,u);
  c=sb_mix(c,v3(sm.x,sm.y,sm.z),sm.w);
  c=slab_grade(slab_weather_air(c,v2(frag.x,frag.y),u),u);
  return SlabOut.{c=v4(c.x,c.y,c.z,1.0f32),aux=v4(0.0f32,1.0f32,0.0f32,PR_POST_NONE),depth=1.0f32};
}

// ---- The clipmap sea: a vertex from its index, as ocean_vertex does it.
SlabS :: struct {pos:V4; rest:V2; world:V3; }
slab_surface_vs :: (vid:u32,_iid2:u32,u:[]f32)->SlabS {
  n:u32=wg_u32_f(u[44]);
  count:u32=wg_u32_f(u[45]);
  half:u32=n/2;
  q:u32=vid/6;
  corner:u32=vid%6;
  full:u32=mul_wrap(n,n);
  ring:u32=sub_wrap(full,mul_wrap(half,half));
  l:u32=0;
  if (q>=full) {
    q=sub_wrap(q,full);
    l=wg_min_u(add_wrap(cast(u32)1,q/ring),sub_wrap(count,cast(u32)1));
    q=sub_wrap(q,mul_wrap(sub_wrap(l,cast(u32)1),ring));
  }
  lv:V4=wg_at4(u,(cast(int)l)*4+48);
  qx:u32=q%n;
  qz:u32=q/n;
  if (l>0) {
    hole:u32=wg_u32_f(lv.w);
    hx:u32=add_wrap(n/4,(hole&1));
    hz:u32=add_wrap(n/4,(hole>>1));
    top:u32=mul_wrap(hz,n);
    if (q>=top) {
      band:u32=sub_wrap(q,top);
      if (band<mul_wrap(half,half)) {
        col:u32=band%half;
        qx=ifx col<hx then col else add_wrap(col,half);
        qz=add_wrap(hz,band/half);
      } else {
        rest:u32=sub_wrap(band,mul_wrap(half,half));
        qx=rest%n;
        qz=add_wrap(add_wrap(hz,half),rest/n);
      }
    }
  }
  cx:[6]u32=[6]u32.[0,1,0,0,1,1];
  cz:[6]u32=[6]u32.[0,0,1,1,0,1];
  ix:s32=cast,trunc(s32)(add_wrap(qx,cx[cast(int)corner]));
  iz:s32=cast,trunc(s32)(add_wrap(qz,cz[cast(int)corner]));
  gx:s32=((wg_i32_f(wg_round(lv.x/lv.z)))-(cast,trunc(s32)(half)))+ix;
  gz:s32=((wg_i32_f(wg_round(lv.y/lv.z)))-(cast,trunc(s32)(half)))+iz;
  rx:s32=wg_abs_i(ix-(cast,trunc(s32)(half)));
  rz:s32=wg_abs_i(iz-(cast,trunc(s32)(half)));
  edge:s32=wg_max_i(rx,rz);
  a:f32=0.0f32;
  if (add_wrap(l,cast(u32)1)<count) {
    a=clampf((cast(f32)(edge-((cast,trunc(s32)(half))-(wg_i32_f(u[46])))))/u[46],0.0f32,1.0f32);
  }
  p:V2=v2(((cast(f32)(gx))-(a*(cast(f32)(gx&1))))*lv.z,((cast(f32)(gz))-(a*(cast(f32)(gz&1))))*lv.z);
  if ((add_wrap(l,cast(u32)1)==count)&&(edge==(cast,trunc(s32)(half)))) {
    p=wg_add_f2f2(v2(lv.x,lv.y),wg_mul_f2f(wg_sub_f2f2(p,v2(lv.x,lv.y)),(u[47]/((cast(f32)(half))*lv.z))));
  }
  // the waves: the sea's height, and cascade 0's choppy displacement, both faded out where
  // the quads grow too coarse to carry them (past a few patches)
  reach:f32=wg_length2(wg_sub_f2f2(p,v2(u[8],u[10])));
  keep:f32=1.0f32-smoothstep(u[29]*2.5f32,u[29]*8.0f32,reach);
  moved:V2=wg_mul_f2f(slab_chop(p,u),keep);
  w:V3=v3(p.x+moved.x,u[28]+((slab_sea_height(p,u)-u[28])*keep),p.y+moved.y);
  o:SlabS;
  rel:V3=wg_sub_f3f3(w,v3(u[8],u[9],u[10]));
  vz:f32=wg_dot3(rel,v3(u[12],u[13],u[14]));
  aspect:f32=u[0]/u[1];
  o.pos=v4(wg_dot3(rel,v3(u[16],u[17],u[18]))/(u[11]*aspect),wg_dot3(rel,v3(u[20],u[21],u[22]))/u[11],vz-SLAB_NEAR,vz);
  o.rest=p;
  o.world=w;
  return o;
}
// The build view's casting cells that are dry (apps/openagents-web/slab-build-draw.coax
// bd_uniforms): P+61 holds which are dry, as bits, plus the way along the yard as a share of a
// turn; P+62, P+63 the first cell's centre. The cells stand 150 m apart along the yard.
slab_dry_cell :: (w:V3,u:[]f32)->bool {
  dm:f32=u[SLAB_P+61];
  if (dm<0.5f32) { return false; }
  turn:f32=(fract(dm)/0.999f32)*6.2831853f32;
  rx:f32=w.x-u[SLAB_P+62]; rz:f32=w.z-u[SLAB_P+63];
  along:f32=(rx*cos(turn))+(rz*sin(turn));
  across:f32=(rz*cos(turn))-(rx*sin(turn));
  kf:f32=floor((along/150.0f32)+0.5f32);
  if ((kf<0.0f32)||(kf>7.5f32)||(abs(along-(kf*150.0f32))>52.0f32)||(abs(across)>27.0f32)) { return false; }
  bits:f32=floor(floor(dm)/pow(2.0f32,kf));
  return fract(bits*0.5f32)>0.25f32;
}
slab_surface_fs :: (v:SlabS,u:[]f32,frame:[]f32)->PrLit {
  rel:V3=wg_sub_f3f3(v.world,v3(u[8],u[9],u[10]));
  dist:f32=wg_length3(rel);
  d:V3=wg_div_f3f(rel,fmax(dist,1e-4f32));
  // The build view's dry casting cells keep the sea out (slab_dry_cell).
  if (slab_dry_cell(v.world,u)) { gpu_discard(); }
  // the section view: a slot cut out of the sea from the hull toward the eye
  sec:f32=u[SLAB_P+52];
  if (sec!=0.0f32) {
    hp:V3=sb_to_hull(v.world,u);
    beyond:f32=sec*(hp.z-u[SLAB_P+53]);
    if ((abs(hp.x)<u[36]+20.0f32)&&(beyond>0.0f32)&&(beyond<1500.0f32)) { gpu_discard(); }
  }
  if (u[SLAB_P+56]>0.5f32) {
    // from under the sea: the sky through Snell's window, the water mirrored outside it
    c:V3=slab_sea_below(v.rest,v.world,d,dist,sw_sea(v.rest,u),u);
    c=slab_grade(sw_under(c,sb_to_hull(v3(u[8],u[9],u[10]),u),sb_dir_to_hull(d,u),dist,u),u);
    return pr_lit_plain(wg_make_f4_f3f(c,1.0f32));
  }
  c:V3=slab_shore(slab_haze(slab_water(v.rest,v.world,d,dist,u[2],u,frame),d,dist*slab_photo_sea_haze(u),u),v.world,d,u);
  sm:V4=slab_smoke(sb_to_hull(v3(u[8],u[9],u[10]),u),sb_dir_to_hull(d,u),dist,u);
  c=slab_grade(slab_weather_air(sb_mix(c,v3(sm.x,sm.y,sm.z),sm.w),slab_weather_px(d,u),u),u);
  return pr_lit_plain(wg_make_f4_f3f(c,1.0f32));
}
// ---- The HUD: strokes (the stroke font's pen, as fixture.coax draws them) and rounded panels,
// both blended over the frame by their coverage (coaxial_fx_alpha_v1).
// a: x, y, along / local x, across / local y; b: length, core, light, glow / half w, half h, radius, alpha;
// c: red, green, blue, mode; e: border.
SlabV :: struct {pos:V4; place:V2; shape:V4; tint:V4; extra:V4; }
slab_fx_vs_in :: struct {a:V4; b:V4; c:V4; e:V4; }
slab_fx_vs :: (_vid3:u32,_iid4:u32,in_:slab_fx_vs_in,u:[]f32)->SlabV {
  a:V4=in_.a;
  o:SlabV;
  o.pos=v4(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=in_.b;
  o.tint=in_.c;
  o.extra=in_.e;
  return o;
}
slab_fx_fs :: (v:SlabV,u:[]f32,sans_atlas:Tex2D,sans_sampler:Sampler)->V4 {
  if ((v.tint.w>3.5f32)&&(v.tint.w<4.5f32)) {
    // a sans glyph (font.coax draw_sans): place is the atlas coordinate, shape.x the em in pixels,
    // shape.z its brightness; blended over the frame by its coverage like the strokes
    lod:f32=clampf(wg_log2(64.0f32/fmax(v.shape.x,1.0f32)),0.0f32,4.0f32);
    sa:f32=pow(gpu_sample_level(sans_atlas,sans_sampler,v.place,lod).w,0.85f32);
    return v4(v.tint.x,v.tint.y,v.tint.z,clampf(sa*v.shape.z,0.0f32,1.0f32)*u[3]);
  }
  if (v.tint.w>4.5f32) {
    // a rounded rectangle: its distance from the edge, a hairline border inside it
    q:V2=v2(abs(v.place.x)-(v.shape.x-v.shape.z),abs(v.place.y)-(v.shape.y-v.shape.z));
    out:f32=wg_length2(v2(fmax(q.x,0.0f32),fmax(q.y,0.0f32)))+fmin(fmax(q.x,q.y),0.0f32)-v.shape.z;
    cover:f32=1.0f32-smoothstep(-0.75f32,0.75f32,out);
    rim:f32=(1.0f32-smoothstep(0.0f32,1.2f32,abs(out+1.0f32)))*v.extra.x;
    c:V3=sb_mix(v3(v.tint.x,v.tint.y,v.tint.z),v3(1.0f32,0.95f32,0.85f32),rim*0.6f32);
    return v4(c.x,c.y,c.z,clampf(fmax(cover*v.shape.w,rim*0.8f32)*cover,0.0f32,1.0f32)*u[3]);
  }
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  g:f32=d/fmax(v.shape.w,1.0f32);
  halo:f32=exp(((-5.0f32)*g)*g)*0.18f32;
  a:f32=clampf((core+halo)*v.shape.z,0.0f32,1.0f32);
  return v4(v.tint.x,v.tint.y,v.tint.z,a*u[3]);
}

// ---- the vector helpers this file calls
wg_get_u4 :: (p:U4,i:int)->u32 {if i==0 {return p.x;} if i==1 {return p.y;} if i==2 {return p.z;} return p.w;}
wg_div_f2f :: (a:V2,b:f32)->V2 {return v2(a.x/b,a.y/b);}
wg_mul_f2f :: (a:V2,b:f32)->V2 {return v2(a.x*b,a.y*b);}
wg_sub_f2f :: (a:V2,b:f32)->V2 {return v2(a.x-b,a.y-b);}
wg_fract_f2 :: (p0:V2)->V2 {return v2(fract(p0.x),fract(p0.y));}
wg_floor_f2 :: (p0:V2)->V2 {return v2(floor(p0.x),floor(p0.y));}
wg_cvt_i2f2 :: (p:V2)->I2 {return i2(wg_i32_f(p.x),wg_i32_f(p.y));}
wg_add_i2i2 :: (a:I2,b:I2)->I2 {return i2(a.x+b.x,a.y+b.y);}
wg_make_i2_i :: (p0:s32)->I2 {return i2(p0,p0);}
wg_band_i2i2 :: (a:I2,b:I2)->I2 {return i2(a.x&b.x,a.y&b.y);}
wg_cvt_u2i2 :: (p:I2)->U2 {return u2(cast,trunc(u32)(p.x),cast,trunc(u32)(p.y));}
wg_mul_ff4 :: (a:f32,b:V4)->V4 {return v4(a*b.x,a*b.y,a*b.z,a*b.w);}
wg_add_f4f4 :: (a:V4,b:V4)->V4 {return v4(a.x+b.x,a.y+b.y,a.z+b.z,a.w+b.w);}
wg_mul_ff2 :: (a:f32,b:V2)->V2 {return v2(a*b.x,a*b.y);}
wg_add_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x+b.x,a.y+b.y);}
wg_sw_xy_f4 :: (p:V4)->V2 {return v2(p.x,p.y);}
wg_mul_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x*b.x,a.y*b.y);}
wg_sub_ff2 :: (a:f32,b:V2)->V2 {return v2(a-b.x,a-b.y);}
wg_sub_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x-b.x,a.y-b.y);}
wg_mix_f3f3f :: (p0:V3,p1:V3,p2:f32)->V3 {return v3(mix(p0.x,p1.x,p2),mix(p0.y,p1.y,p2),mix(p0.z,p1.z,p2));}
wg_mul_f3f :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
wg_add_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
wg_add_f2f :: (a:V2,b:f32)->V2 {return v2(a.x+b,a.y+b);}
wg_mul_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x*b.x,a.y*b.y,a.z*b.z);}
wg_neg_f3 :: (a:V3)->V3 {return v3(-a.x,-a.y,-a.z);}
wg_sub_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
wg_div_f3f :: (a:V3,b:f32)->V3 {return v3(a.x/b,a.y/b,a.z/b);}
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
