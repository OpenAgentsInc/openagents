    emit=sb_mul(v3(1.0f32,0.6f32,0.3f32),night*0.15f32*u[SLAB_P+48]*slab_band(w.x+w.y,11.0f32,0.08f32));
  } else if (k==4) {
    c=v3(0.62f32,0.64f32,0.66f32);
    if (roof) {
      fx:f32=fract(w.x/9.0f32)-0.5f32;
      fz:f32=fract(w.z/9.0f32)-0.5f32;
      c=ifx ((fx*fx)+(fz*fz))<0.09f32 then v3(0.22f32,0.24f32,0.27f32) else v3(0.72f32,0.73f32,0.75f32);
    } else {
      c=sb_mul(c,0.85f32+(0.15f32*slab_band(w.y,1.2f32,0.5f32)));
      strip:f32=slab_band(w.y-deck,6.0f32,0.12f32);
      emit=sb_mul(v3(0.4f32,0.7f32,1.0f32),strip*u[SLAB_P+47]*(0.15f32+(0.6f32*night)));
    }
  } else if (k==5) {
    if (roof) {
      c=v3(0.74f32,0.73f32,0.70f32);
    } else {
      // glass between the floors' pale edges, the glass catching the sky; lit windows at night
      storey:f32=fract((w.y-deck)/3.6f32);
      along:f32=ifx abs(n.x)>abs(n.z) then w.z else w.x;
      mull:f32=slab_band(along,1.8f32,0.12f32);
      r:V3=wg_reflect3(d,n);
      // the glass reflects the upper sky, cool against the warm stone, and the sun's glare
      sky:V3=sb_add(sb_mix(sb_p(u,8),sb_p(u,12),0.3f32),sb_mul(sb_p(u,4),0.6f32*sb_pow(fmax(wg_dot3(r,v3(u[24],u[25],u[26])),0.0f32),12.0f32)));
      // each pane its own tilt, so the glass glints unevenly
      pane:f32=slab_hash2(v2(floor(along/1.8f32),floor((w.y-deck)/3.6f32)+(hit.id*7.0f32)));
      detail:f32=1.0f32-smoothstep(220.0f32,650.0f32,hit.t);
      // glass: dark itself, its colour the sky it reflects (added after the lighting, in emit),
      // stronger at a grazing angle; the floor edges and mullions pale stone
      fres:f32=0.25f32+(0.75f32*sb_pow(1.0f32-abs(wg_dot3(d,n)),3.0f32));
      frame:f32=ifx storey>0.2f32 then mull*0.5f32*detail else 1.0f32;
      // far off, the floor edges and mullions average to a share of pale; each tower its own glass
      tower:f32=slab_hash2(v2(hit.id,3.0f32));
      frame=mix(0.3f32+(0.25f32*tower),frame,detail);
      glass:V3=sb_mix(v3(0.08f32,0.12f32,0.17f32),v3(0.20f32,0.24f32,0.28f32),tower);
      c=sb_mix(glass,v3(0.82f32,0.82f32,0.80f32),frame);
      // (the concept image's glass reads darker than the stone round it: a dim, cool reflection)
      emit=sb_mul(sb_mulv(sky,v3(0.6f32,0.8f32,1.05f32)),(1.0f32-frame)*fres*0.5f32*(0.85f32+(0.3f32*pane*detail)));
      // the tower's corners stand out pale
      // (measured along the face: a point on a face is always 0 m from its own plane)
      ce:f32=ifx abs(n.x)>abs(n.z) then fmin(abs(w.z-hit.lo.z),abs(hit.hi.z-w.z)) else fmin(abs(w.x-hit.lo.x),abs(hit.hi.x-w.x));
      c=sb_mix(c,v3(0.88f32,0.88f32,0.86f32),1.0f32-smoothstep(0.6f32,1.4f32,ce));
      lit:f32=stepf(0.45f32,slab_hash2(v2(floor(along/3.6f32),floor((w.y-deck)/3.6f32)+(hit.id*13.0f32))));
      emit=sb_add(emit,sb_mul(v3(1.0f32,0.78f32,0.48f32),stepf(0.24f32,storey)*lit*night*0.7f32));
    }
  } else if (k==6) {
    c=v3(0.88f32,0.86f32,0.82f32);
    if ((w.y>(top-7.0f32))||((w.y>(top-16.0f32))&&(w.y<(top-12.0f32)))) {
