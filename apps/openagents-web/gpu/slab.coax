    if (!roof) { c=sb_mul(c,0.92f32+(0.08f32*slab_band(w.y,3.0f32,0.1f32))); }
  } else if (k==11) {
    c=v3(0.90f32,0.92f32,0.92f32);
    if (!roof) {
      win:f32=stepf(0.45f32,fract((w.y-deck)/3.6f32))*slab_band((ifx abs(n.x)>abs(n.z) then w.z else w.x),4.0f32,0.7f32);
      c=ifx win>0.5f32 then v3(0.40f32,0.54f32,0.60f32) else c;
      emit=sb_mul(v3(0.9f32,0.95f32,1.0f32),win*night*0.45f32);
    }
  } else if (k==12) {
    c=v3(0.90f32,0.72f32,0.18f32);
  } else if (k==13) {
    c=v3(0.62f32,0.64f32,0.66f32);
    if (roof) {
