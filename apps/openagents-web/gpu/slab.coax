    on:f32=stepf(index+0.5f32,u[SLAB_P+46]);
    led:f32=(1.0f32-stepf(0.85f32,fract(slot)))*stepf(0.7f32,fract(slot))*stepf(w.y,deck+2.4f32)*stepf(deck+2.1f32,w.y);
    emit=sb_mul(v3(0.3f32,1.0f32,0.5f32),led*on*(0.4f32+night));
  } else if (((k==16)||(k==18))&&(fract(kind)>0.1f32)) {
    // a traced temple: marble, the roof's slopes a weathered grey, the cella dim behind its columns
    c=v3(0.95f32,0.92f32,0.85f32);
    if ((n.y>0.2f32)&&(n.y<0.99f32)) { c=v3(0.72f32,0.70f32,0.65f32); }
    inset:f32=fmin(fmin(w.x-hit.lo.x,hit.hi.x-w.x),fmin(w.z-hit.lo.z,hit.hi.z-w.z));
    tall:f32=hit.top-hit.lo.y;
    if ((abs(n.y)<0.3f32)&&(inset>fmin(hit.hi.x-hit.lo.x,hit.hi.z-hit.lo.z)*0.12f32)&&((w.y-hit.lo.y)<tall*0.62f32)) { c=sb_mul(c,0.62f32); }
    // fluting on the columns, faint
    c=sb_mul(c,0.97f32+(0.03f32*sin((w.x+w.z)*9.0f32)));
