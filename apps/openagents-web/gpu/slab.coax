    c=v3(0.94f32,0.91f32,0.84f32);
    if (n.y>0.2f32) {
      c=ifx k==9 then v3(0.82f32,0.80f32,0.74f32) else v3(0.66f32,0.64f32,0.60f32);
      if (n.y>0.98f32) { c=v3(0.86f32,0.84f32,0.78f32); }
    } else {
      along:f32=ifx abs(n.x)>abs(n.z) then w.z else w.x;
      h:f32=w.y-hit.lo.y;
      cornice:f32=(hit.top-hit.lo.y)*0.62f32;
      if ((h>1.2f32)&&(h<cornice)) {
        col:f32=slab_columns(along,ifx k==9 then 4.0f32 else 3.2f32);
        shade:f32=ifx k==18 then 0.55f32 else 0.42f32;
        c=sb_mul(c,mix(shade,1.0f32,col));
        // fluting
        c=sb_mul(c,0.96f32+(0.04f32*sin(along*12.0f32)));
      } else if (h<=1.2f32) {
