    h:f32=slab_hash2(v2(floor(slot),row));
    c=v3(0.20f32,0.36f32,0.58f32);
    if (h>0.75f32) { c=v3(0.82f32,0.42f32,0.16f32); }
    else if (h>0.5f32) { c=v3(0.62f32,0.18f32,0.14f32); }
    else if (h>0.25f32) { c=v3(0.55f32,0.57f32,0.58f32); }
    if (fract(slot)>0.9f32) { c=v3(0.62f32,0.62f32,0.6f32); }
    if (!roof) { c=sb_mul(c,0.88f32+(0.12f32*slab_band(w.x,0.6f32,0.5f32))); }
    // the miners that run show a green light; the rest are dark
