// SLAB Simulation's shaders, the source of apps/openagents-web/slab.wgsl (docs/metaverse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (slab.module, slab.bindings beside it).
// It began as the water lab's (gpu/waterlab.coax) with the beach and the view under the water taken out.
#load "../../../metaverse-engine/render/noise.coax";
#load "../../../metaverse-engine/gpu/wgsl.coax";
#load "../../../metaverse/style.coax";
#load "slab-sea.coax";
#load "slab-foam.coax";   // the open sea's foam, from the frame store (slab-foam.coax beside the page)
#load "slab-water.coax";
#load "../../../metaverse/hull.coax";
#load "slab-photoreal.coax";   // the photoreal style's mesh pass, sky and air (docs/metaverse/photoreal.md)

// SLAB (slab.coax): the sea in deep water on the spectral tiles slab.coax packs into the
// uniforms each frame (metaverse/water-spectrum.coax), drawn by surface_vs as the water lab's
// clipmap mesh, in the painted water look (docs/metaverse/art-styles.md 12); and the platform,
// traced by bg_fs: metaverse/slab-plan.coax's boxes and upright cylinders (the hull's six pieces,
// then the masses on the deck), lit by a high sun with the masses' shadows on a desktop, painted
// by kind, its depth written so the sea's mesh hides behind it.
// SlabU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0      width, height, time, fade
//   mode 4      still, phone, the plan's record count, dpr
//   eye 8       xyz, tan of half the vertical field
//   fwd 12, right 16, up 20
//   sun 24      toward the sun, strength
//   sea 28      level, cascade 0's patch, the fine patch, choppiness
//   wind 32     direction x, z, speed, significant height
//   hull 36     half length, half beam, deck height, keel height
//   pack 40     the packed numbers' scales: height, slope, fine slope, choppy displacement
//   clip 44     quads a side, levels, morph band (quads), the skirt's reach (m)
//   levels 48   centre x, z, spacing, hole x + 2 hole z
//   boxes 96    the plan's records: min xyz, kind; max xyz, shape (metaverse/slab-plan.coax SLAB_SHAPE_*)
//   groups 1312 the records' bounding groups: min xyz, first; max xyz, count
//   params 1440 the world's light, the hull's pose, the walker, the selection (slab.coax P_*)
//   words 1504  cascade 0, its displacement, the fine slopes
//   sea 15840   the water's optics, the finer cascades and the weather (slab-sea.coax)
//   water 15992 what the hull does to the water (gpu/slab-water.coax, slab-water.coax)
SLAB_N :: cast(u32)64;
SLAB_WORDS :: 1504;
SLAB_GROUPS :: 1312;
SLAB_P :: 1440;
SLAB_BOXES :: 96;
SLAB_W_COARSE :: cast(u32)0;
SLAB_W_CHOP :: cast(u32)8192;
SLAB_W_FINE :: cast(u32)10240;
SLAB_MISS :: 1e9f32;
SLAB_CORNER :: 1.5f32;
SLAB_HULL_DEPTH :: f32(HULL_PRIME_HULL);   // the watertight hull, keel to its top slab (metaverse/hull.coax)
slab_word :: (i:u32,u:[]f32)->u32 {
  return wg_get_u4(wg_at4u(u,(cast(int)(i>>2))*4+SLAB_WORDS),cast(int)(i&3));
}
// Cascade 0 at a rest point: height (m), foam, slope x, slope z; bilinear, wrapped.
slab_coarse :: (p:V2,u:[]f32)->V4 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[29]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V4=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      t:u32=add_wrap(mul_wrap(c.y,SLAB_N),c.x);
      aw:u32=slab_word(add_wrap(SLAB_W_COARSE,mul_wrap(cast(u32)2,t)),u);
      a:V2=wg_unpack2x16float(aw);
      b:V2=wg_unpack2x16float(slab_word(add_wrap(add_wrap(SLAB_W_COARSE,mul_wrap(cast(u32)2,t)),cast(u32)1),u));
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      // the word's upper half is two foams in bytes: cascade 0's here, the fine tile's in slab-sea.coax
      acc=wg_add_f4f4(acc,wg_mul_ff4(w,v4(a.x*u[40],(cast(f32)((aw>>16)&0xff))/255.0f32,b.x*u[41],b.y*u[41])));
      k+=1;
    }
  }
  return acc;
}
// The fine tile's slopes (the desktop's second cascade, the phone's baked tile).
slab_fine :: (p:V2,u:[]f32)->V2 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[30]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V2=v2(0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      acc=wg_add_f2f2(acc,wg_mul_f2f(wg_mul_ff2(w,wg_sw_xy_f4(wg_unpack4x8snorm(slab_word(add_wrap(add_wrap(SLAB_W_FINE,mul_wrap(c.y,SLAB_N)),c.x),u)&0xffff))),u[42]));
      k+=1;
    }
  }
  return acc;
}
// Cascade 0's choppy displacement at a rest point (m), bilinear, wrapped.
slab_chop :: (p:V2,u:[]f32)->V2 {
  q:V2=wg_sub_f2f(wg_mul_f2f(wg_div_f2f(p,u[29]),cast(f32)(SLAB_N)),0.5f32);
  f:V2=wg_fract_f2(q);
  i:I2=wg_cvt_i2f2(wg_floor_f2(q));
  acc:V2=v2(0.0f32,0.0f32);
  {
    k:s32=0;
    while k<4 {
      o:I2=i2(k&1,k>>1);
      c:U2=wg_cvt_u2i2(wg_band_i2i2(wg_add_i2i2(i,o),wg_make_i2_i((cast,trunc(s32)(SLAB_N))-1)));
      t:u32=add_wrap(mul_wrap(c.y,SLAB_N),c.x);
      w:f32=(ifx o.x==1 then f.x else 1.0f32-f.x)*(ifx o.y==1 then f.y else 1.0f32-f.y);
      half:u32=(slab_word(add_wrap(SLAB_W_CHOP,(t>>1)),u)>>mul_wrap(cast(u32)16,(t&1)))&0xffff;
      acc=wg_add_f2f2(acc,wg_mul_ff2(w,wg_sw_xy_f4(wg_unpack4x8snorm(half))));
      k+=1;
    }
  }
  return wg_mul_f2f(acc,u[43]*sw_calm_at(p,u));
}
slab_hash2 :: (p:V2)->f32 {
  return render_noise2(p.x,p.y);
}
slab_noise :: (p:V2)->f32 {
  i:V2=wg_floor_f2(p);
  f:V2=wg_fract_f2(p);
  s:V2=wg_mul_f2f2(wg_mul_f2f2(f,f),wg_sub_ff2(3.0f32,wg_mul_ff2(2.0f32,f)));
  return mix(mix(slab_hash2(i),slab_hash2(wg_add_f2f2(i,v2(1.0f32,0.0f32))),s.x),mix(slab_hash2(wg_add_f2f2(i,v2(0.0f32,1.0f32))),slab_hash2(wg_add_f2f2(i,v2(1.0f32,1.0f32))),s.x),s.y);
}
// The sea's surface at rest point p: its height over the level (deep water everywhere).
slab_sea_height :: (p:V2,u:[]f32)->f32 {
  return u[28]+sw_sea(p,u).x;
}
// How far p lies outside the hull's plan, a rectangle with rounded corners (negative inside).
slab_hull_plan :: (p:V2,u:[]f32)->f32 {
  qx:f32=(abs(p.x)-u[36])+SLAB_CORNER;
  qz:f32=(abs(p.y)-u[37])+SLAB_CORNER;
  out:f32=sqrt((fmax(qx,0.0f32)*fmax(qx,0.0f32))+(fmax(qz,0.0f32)*fmax(qz,0.0f32)));
  return (out+fmin(fmax(qx,qz),0.0f32))-SLAB_CORNER;
}

// ---- small vector helpers
// pow with its base kept off zero: pow(0, y) is exp2(y log2 0), which some GPUs give as NaN.
sb_pow :: (x:f32,y:f32)->f32 {return pow(fmax(x,1e-6f32),y);}
sb_add :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
sb_sub :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
sb_mul :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
sb_mulv :: (a:V3,b:V3)->V3 {return v3(a.x*b.x,a.y*b.y,a.z*b.z);}
sb_mix :: (a:V3,b:V3,t:f32)->V3 {return v3(mix(a.x,b.x,t),mix(a.y,b.y,t),mix(a.z,b.z,t));}
sb_p :: (u:[]f32,i:int)->V3 {return v3(u[SLAB_P+i],u[SLAB_P+i+1],u[SLAB_P+i+2]);}
// The hull's frame: world = R p + T, its rows at P_POSE.
sb_to_hull :: (w:V3,u:[]f32)->V3 {
  q:V3=sb_sub(w,v3(u[SLAB_P+19],u[SLAB_P+23],u[SLAB_P+27]));
  return sb_dir_to_hull(q,u);
}
sb_dir_to_hull :: (q:V3,u:[]f32)->V3 {
  r0:V3=sb_p(u,16); r1:V3=sb_p(u,20); r2:V3=sb_p(u,24);
  return v3((r0.x*q.x)+(r1.x*q.y)+(r2.x*q.z),(r0.y*q.x)+(r1.y*q.y)+(r2.y*q.z),(r0.z*q.x)+(r1.z*q.y)+(r2.z*q.z));
}
sb_dir_to_world :: (q:V3,u:[]f32)->V3 {
  return v3(wg_dot3(sb_p(u,16),q),wg_dot3(sb_p(u,20),q),wg_dot3(sb_p(u,24),q));
}

// The nearest land (slab-place.coax, from the site's chart; slab.coax P_SYSTEMS and P_UNDER): u[SLAB_P+50..51]
// is the way to its nearest shore and as long as that shore is far (m; 0: no land in sight), u[SLAB_P+58]
// how high it stands over the horizon (tan) and u[SLAB_P+59] the cosine of half its width. slab_land
// is its ridge against the sky, hazed; slab_shore is the land past the shore, where the sea's mesh would
// be. The ridge's small rises are noise: the chart gives the bearing, the height and the width.
slab_land_colour :: (u:[]f32)->V3 { return sb_mulv(sb_p(u,12),v3(0.34f32,0.42f32,0.33f32)); }
slab_land_within :: (toward:f32,u:[]f32)->f32 {
  edge:f32=u[SLAB_P+59];
  if (edge<=-0.999f32) { return 1.0f32; }
  return smoothstep(edge,edge+((1.0f32-edge)*0.3f32)+0.0001f32,toward);
}
// Distant land toward the sky's colour `sky`: a share that grows with its distance (m) and toward
// its foot (low 1), and its colour a little greyed.
slab_land_far :: (land:V3,sky:V3,far:f32,low:f32)->V3 {
  grey:f32=(land.x*0.3f32)+(land.y*0.59f32)+(land.z*0.11f32);
  l:V3=sb_mix(land,v3(grey,grey,grey),0.35f32);
  k:f32=fmin(0.22f32+(0.45f32*(1.0f32-exp(-far/9000.0f32)))+(0.15f32*low),0.85f32);
  return sb_mix(l,sky,k);
}
slab_land :: (c:V3,d:V3,o:V3,u:[]f32)->V3 {
  peak:f32=u[SLAB_P+58];
  far:f32=wg_length2(v2(u[SLAB_P+50],u[SLAB_P+51]));
  flat:f32=wg_length2(v2(d.x,d.z));
  if ((peak<=0.0f32)||(far<1.0f32)||(flat<0.001f32)||(d.y>0.6f32)) { return c; }
  toward:f32=((d.x*u[SLAB_P+50])+(d.z*u[SLAB_P+51]))/(flat*far);
  within:f32=slab_land_within(toward,u);
  // under the horizon the land starts where the look meets the shore (the sea's mesh ends short of it);
  // looking away from the nearest shore, land that is all round stands on the horizon
  reach:f32=fmax(far-(((o.x*u[SLAB_P+50])+(o.z*u[SLAB_P+51]))/far),1.0f32)/fmax(toward,0.0001f32);
  foot:f32=ifx toward>0.02f32 then -(fmax(o.y,0.0f32)/reach) else -0.001f32;
  // a ridge line with relief: a broad swell, hills of a kilometre or so at a few kilometres off, and
  // a ragged edge of trees and crests (the chart gives the height; these are the shape, not survey)
  ax:f32=d.x/flat; az:f32=d.z/flat;
  rise:f32=0.12f32+(0.38f32*slab_noise(v2(ax*4.0f32,az*4.0f32)))+(0.32f32*slab_noise(v2(ax*17.0f32+3.0f32,az*17.0f32)))+(0.14f32*slab_noise(v2(ax*61.0f32+7.0f32,az*61.0f32)))+(0.04f32*slab_noise(v2(ax*240.0f32+11.0f32,az*240.0f32)));
  rise=rise*rise*1.6f32;
  ridge:f32=peak*within*rise;
  el:f32=d.y/flat;
  m:f32=(1.0f32-smoothstep(ridge-(0.0012f32+(ridge*0.04f32)),ridge,el))*smoothstep(foot-0.0006f32,foot,el);
  // where no land stands (within 0) the ridge is 0 and the band above would still draw a pixel of
  // land along the whole horizon: a hard dark line over the open sea
  m=m*smoothstep(0.0f32,0.002f32,ridge);
  // the ridge stands at the shore's distance, so it takes that much haze; then aerial perspective
  // pulls it toward the sky behind it (c, the horizon's colour), most at its foot where the air over
  // the water is thickest, and greys its green, so land 5 km and more away reads as far
  land:V3=slab_land_far(slab_haze(slab_land_colour(u),d,far*0.6f32,u),c,far,1.0f32-fmin(fmax((el-foot)/fmax(ridge-foot,0.0001f32),0.0f32),1.0f32));
  return sb_mix(c,land,m);
}
slab_shore :: (c:V3,w:V3,d:V3,u:[]f32)->V3 {
  far:f32=wg_length2(v2(u[SLAB_P+50],u[SLAB_P+51]));
  r:f32=wg_length2(v2(w.x,w.z));
  if ((far<1.0f32)||(r<far*0.9f32)) { return c; }
  along:f32=((w.x*u[SLAB_P+50])+(w.z*u[SLAB_P+51]))/far;
  m:f32=smoothstep(far,(far*1.02f32)+15.0f32,along)*slab_land_within(along/r,u);
  // a pale strand where the land meets the water; behind it the ground climbs to the ridge, so
  // it takes the haze of a hillside a little past the shore and not of a plain out to the horizon
  strand:f32=1.0f32-smoothstep(far*1.02f32,(far*1.05f32)+40.0f32,along);
  land:V3=sb_mix(slab_land_colour(u),sb_mul(sb_p(u,12),0.82f32),strand*0.6f32);
  // the same aerial perspective as the ridge's (slab_land_far), toward the horizon's own colour
  return sb_mix(c,slab_land_far(slab_haze(land,d,fmin(r,far*1.5f32)*0.4f32,u),slab_haze(land,d,1.0e6f32,u),far,1.0f32),m);
}

// The sky: zenith to horizon in the hour's colours, the sun's disc and its glow, broad pale clouds.
slab_sky :: (d:V3,u:[]f32)->V3 {
  if (slab_photo(u)) { return slab_photo_sky(d,u); }
  up:f32=clampf(d.y,0.0f32,1.0f32);
  zenith:V3=sb_p(u,8);
  horizon:V3=sb_p(u,12);
  c:V3=sb_mix(horizon,zenith,sb_pow(up,0.45f32));
  sun:V3=v3(u[24],u[25],u[26]);
  scol:V3=sb_p(u,4);
  s:f32=fmax(wg_dot3(d,sun),0.0f32);
  gold:f32=u[SLAB_P+43];
  c=sb_add(c,sb_mul(scol,(sb_pow(s,6.0f32)*(0.18f32+(0.5f32*gold)))+(sb_pow(s,60.0f32)*0.35f32)+(smoothstep(0.9994f32,0.99975f32,s)*6.0f32)));
  // below the horizon the sky darkens into the sea's haze
  if (d.y<0.0f32) {
    c=sb_mix(c,sb_mul(horizon,0.8f32),clampf(-d.y*6.0f32,0.0f32,1.0f32));
  }
  if (d.y>0.0f32) {
    q:V2=wg_mul_f2f(wg_div_f2f(v2(d.x,d.z),(d.y+0.18f32)),1.2f32);
    q2:V2=v2((q.x*1.71f32)-(q.y*1.10f32)+3.1f32,(q.x*1.10f32)+(q.y*1.71f32)-1.7f32);
    q3:V2=v2((q.x*1.20f32)-(q.y*3.85f32)-5.3f32,(q.x*3.85f32)+(q.y*1.20f32)+2.9f32);
    fbm:f32=((slab_noise(q)*0.5f32)+(slab_noise(q2)*0.3f32))+(slab_noise(q3)*0.2f32);
    cover:f32=u[SLAB_P+11];
    cl:f32=smoothstep(0.62f32-(cover*0.25f32),0.86f32-(cover*0.2f32),fbm);
    lit:V3=sb_add(sb_mul(horizon,0.9f32),sb_mul(scol,0.35f32+(1.2f32*sb_pow(s,3.0f32))));
    c=sb_mix(c,lit,(cl*0.6f32)*smoothstep(0.02f32,0.25f32,d.y));
  }
  // stars, at night
  night:f32=u[SLAB_P+39];
  if ((night>0.3f32)&&(d.y>0.05f32)) {
    g:V2=wg_floor_f2(wg_mul_f2f(wg_div_f2f(v2(d.x,d.z),d.y+0.3f32),180.0f32));
    st:f32=stepf(0.996f32,slab_hash2(g));
    c=sb_add(c,sb_mul(v3(0.8f32,0.85f32,1.0f32),st*(night-0.3f32)));
  }
  return c;
}
// The air between the eye and what it sees: a sea haze, warm toward the sun.
slab_haze :: (c:V3,d:V3,dist:f32,u:[]f32)->V3 {
  if (slab_photo(u)) { return slab_photo_haze(c,d,dist,u); }
  a:f32=1.0f32-exp((-dist)/u[SLAB_P+15]);
  sun:V3=v3(u[24],u[25],u[26]);
  tint:V3=sb_mix(sb_p(u,12),sb_add(sb_p(u,12),sb_mul(sb_p(u,4),0.25f32)),sb_pow(fmax(wg_dot3(d,sun),0.0f32),5.0f32));
  return sb_mix(c,tint,a*0.92f32);
}
// The golden hour's grade over everything: warmer, a little sepia.
slab_grade :: (c0:V3,u:[]f32)->V3 {
  if (slab_photo(u)) { return c0; }   // the photoreal sky and air come through the film already
  // a soft shoulder over 0.6, so a white deck under a high sun keeps its detail; below it, unchanged
  // the concept image is exposed high and warm: lift the golden hour's exposure before the shoulder
  g:f32=u[SLAB_P+43];
  lift:f32=1.0f32+(0.75f32*g);
  c:V3=v3(slab_shoulder(c0.x*lift),slab_shoulder(c0.y*lift),slab_shoulder(c0.z*lift));
  l:f32=(c.x*0.3f32)+(c.y*0.59f32)+(c.z*0.11f32);
  sep:V3=v3(l*1.08f32,l*0.95f32,l*0.78f32);
  return sb_mix(c,sb_add(sb_mul(c,0.5f32),sb_mul(sep,0.55f32)),g*0.75f32);
}
slab_shoulder :: (x:f32)->f32 {
  if (x<0.7f32) { return x; }
  return 0.7f32+(0.3f32*(1.0f32-exp(-(x-0.7f32)/0.3f32)));
}
// The water: the sea as the hull leaves it (gpu/slab-water.coax sw_sea: calmer in its lee, the
// walls' reflections added) drawn by its optics (slab-sea.coax slab_sea), then the white water
// the hull makes, its discharge and its wake over it, all from the simulation.
slab_water :: (p:V2,world:V3,d:V3,dist:f32,t:f32,u:[]f32,frame:[]f32)->V3 {
  sea:V4=slab_sea(p,world,d,dist,t,sw_sea(p,u),u,frame);
  white:V3=slab_sea_white(u);
  fp:f32=(((dist*2.0f32)*u[11])/u[1])/fmax(abs(d.y),0.08f32);
  return sw_tint(sb_mix(v3(sea.x,sea.y,sea.z),white,sw_white_px(p,t,fp,u)),p,white,t,u);
}

// ---- The platform: metaverse/slab-plan.coax's records, traced in the hull's frame.
// A ray's span through a box: (enter, leave); enter > leave when it misses.
slab_span :: (o:V3,d:V3,lo:V3,hi:V3)->V2 {
  ix:f32=ifx abs(d.x)>1e-6f32 then 1.0f32/d.x else 1e6f32;
  iy:f32=ifx abs(d.y)>1e-6f32 then 1.0f32/d.y else 1e6f32;
  iz:f32=ifx abs(d.z)>1e-6f32 then 1.0f32/d.z else 1e6f32;
  ax:f32=(lo.x-o.x)*ix; bx:f32=(hi.x-o.x)*ix;
  ay:f32=(lo.y-o.y)*iy; by:f32=(hi.y-o.y)*iy;
  az:f32=(lo.z-o.z)*iz; bz:f32=(hi.z-o.z)*iz;
  tn:f32=fmax(fmax(fmin(ax,bx),fmin(ay,by)),fmin(az,bz));
  tf:f32=fmin(fmin(fmax(ax,bx),fmax(ay,by)),fmax(az,bz));
  return v2(tn,tf);
}
// A ray against a box: (t, normal), or t = SLAB_MISS when it misses or starts inside.
slab_box_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  ix:f32=ifx abs(d.x)>1e-6f32 then 1.0f32/d.x else 1e6f32;
  iy:f32=ifx abs(d.y)>1e-6f32 then 1.0f32/d.y else 1e6f32;
  iz:f32=ifx abs(d.z)>1e-6f32 then 1.0f32/d.z else 1e6f32;
  ax:f32=(lo.x-o.x)*ix; bx:f32=(hi.x-o.x)*ix;
  ay:f32=(lo.y-o.y)*iy; by:f32=(hi.y-o.y)*iy;
  az:f32=(lo.z-o.z)*iz; bz:f32=(hi.z-o.z)*iz;
  nx:f32=fmin(ax,bx); ny:f32=fmin(ay,by); nz:f32=fmin(az,bz);
  tn:f32=fmax(fmax(nx,ny),nz);
  tf:f32=fmin(fmin(fmax(ax,bx),fmax(ay,by)),fmax(az,bz));
  if ((tf<tn)||(tn<0.0f32)) {
    return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  }
  if (tn==nx) {
    return v4(tn,ifx d.x>0.0f32 then -1.0f32 else 1.0f32,0.0f32,0.0f32);
  }
  if (tn==ny) {
    return v4(tn,0.0f32,ifx d.y>0.0f32 then -1.0f32 else 1.0f32,0.0f32);
  }
  return v4(tn,0.0f32,0.0f32,ifx d.z>0.0f32 then -1.0f32 else 1.0f32);
}
// A ray against the upright cylinder inscribed in a box: its side and its top.
slab_drum_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  cx:f32=(lo.x+hi.x)*0.5f32;
  cz:f32=(lo.z+hi.z)*0.5f32;
  r:f32=fmin(hi.x-lo.x,hi.z-lo.z)*0.5f32;
  best:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  ox:f32=o.x-cx;
  oz:f32=o.z-cz;
  a:f32=(d.x*d.x)+(d.z*d.z);
  if (a>1e-8f32) {
    b:f32=(ox*d.x)+(oz*d.z);
    c:f32=((ox*ox)+(oz*oz))-(r*r);
    disc:f32=(b*b)-(a*c);
    if (disc>=0.0f32) {
      t:f32=((-b)-sqrt(disc))/a;
      y:f32=o.y+(t*d.y);
      if ((t>0.0f32)&&(y>=lo.y)&&(y<=hi.y)) {
        best=v4(t,(ox+(t*d.x))/r,0.0f32,(oz+(t*d.z))/r);
      }
    }
  }
  if (d.y<0.0f32) {
    t:f32=(hi.y-o.y)/d.y;
    px:f32=ox+(t*d.x);
    pz:f32=oz+(t*d.z);
    if ((t>0.0f32)&&(t<best.x)&&(((px*px)+(pz*pz))<=(r*r))) {
      best=v4(t,0.0f32,1.0f32,0.0f32);
    }
  }
  return best;
}
// A gabled hall: the box under a pitched roof whose ridge runs along X (or Z).
slab_gable_hit :: (o:V3,d:V3,lo:V3,hi:V3,along_x:bool)->V4 {
  h:V4=slab_box_hit(o,d,lo,hi);
  tn:f32=h.x;
  nrm:V3=v3(h.y,h.z,h.w);
  if (tn>=SLAB_MISS) {
    return h;
  }
  sp:V2=slab_span(o,d,lo,hi);
  tf:f32=sp.y;
  across:f32=ifx along_x then (hi.z-lo.z)*0.5f32 else (hi.x-lo.x)*0.5f32;
  mid:f32=ifx along_x then (hi.z+lo.z)*0.5f32 else (hi.x+lo.x)*0.5f32;
  rh:f32=fmin(across*0.36f32,(hi.y-lo.y)*0.45f32);
  oc:f32=ifx along_x then o.z else o.x;
  dc:f32=ifx along_x then d.z else d.x;
  k:s32=0;
  while k<2 {
    sg:f32=ifx k==0 then -1.0f32 else 1.0f32;
    // the plane through the ridge (mid, hi.y) and the eave (mid + sg * across, hi.y - rh); inside is below
    ny:f32=across; nc:f32=sg*rh;
    dd:f32=(ny*hi.y)+(nc*mid);
    den:f32=(ny*d.y)+(nc*dc);
    dist:f32=dd-((ny*o.y)+(nc*oc));
    if (abs(den)<1e-7f32) {
      if (dist<0.0f32) { return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32); }
    } else {
      t:f32=dist/den;
      if (den<0.0f32) {
        if (t>tn) {
          tn=t;
          nn:V3=ifx along_x then v3(0.0f32,ny,nc) else v3(nc,ny,0.0f32);
          nrm=wg_normalize3(nn);
        }
      } else {
        tf=fmin(tf,t);
      }
    }
    k+=1;
  }
  if ((tf<tn)||(tn<0.0f32)) {
    return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  }
  return v4(tn,nrm.x,nrm.y,nrm.z);
}
// The hemisphere inscribed on a box's floor.
slab_dome_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  r:f32=fmin(hi.x-lo.x,hi.z-lo.z)*0.5f32;
  c:V3=v3((lo.x+hi.x)*0.5f32,lo.y,(lo.z+hi.z)*0.5f32);
  oc:V3=sb_sub(o,c);
  b:f32=wg_dot3(oc,d);
  q:f32=wg_dot3(oc,oc)-(r*r);
  disc:f32=(b*b)-q;
  if (disc<0.0f32) { return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32); }
  t:f32=(-b)-sqrt(disc);
  if (t<0.0f32) { return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32); }
  p:V3=sb_add(oc,sb_mul(d,t));
  if (p.y<0.0f32) { return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32); }
  nn:V3=sb_mul(p,1.0f32/r);
  return v4(t,nn.x,nn.y,nn.z);
}
// A cypress standing at b (its foot) of radius r and height h: a column to a third of its height,
// a cone above to its tip. (t, normal), or a miss.
slab_cypress :: (o:V3,d:V3,b:V3,r:f32,h:f32)->V4 {
  best:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  y0:f32=b.y+0.4f32; y1:f32=b.y+(h*0.33f32); top:f32=b.y+h;
  ox:f32=o.x-b.x; oz:f32=o.z-b.z;
  // the column
  qa:f32=(d.x*d.x)+(d.z*d.z); qb:f32=(ox*d.x)+(oz*d.z); qc:f32=(ox*ox)+(oz*oz)-(r*r);
  disc:f32=(qb*qb)-(qa*qc);
  if ((qa>1e-8f32)&&(disc>0.0f32)) {
    t0:f32=((-qb)-sqrt(disc))/qa;
    y:f32=o.y+(d.y*t0);
    if ((t0>0.0f32)&&(y>=y0)&&(y<=y1)) {
      best=v4(t0,(ox+(d.x*t0))/r,0.0f32,(oz+(d.z*t0))/r);
    }
  }
  // the cone, its radius r at y1 narrowing to nothing at the top
  k:f32=r/(top-y1);
  oy:f32=top-o.y;
  ca:f32=qa-(k*k*d.y*d.y);
  cb:f32=(2.0f32*qb)+(2.0f32*k*k*oy*d.y);
  cc:f32=(ox*ox)+(oz*oz)-(k*k*oy*oy);
  cd:f32=(cb*cb)-(4.0f32*ca*cc);
  if ((abs(ca)>1e-8f32)&&(cd>0.0f32)) {
    sq:f32=sqrt(cd);
    ta:f32=((-cb)-sq)/(2.0f32*ca); tb:f32=((-cb)+sq)/(2.0f32*ca);
    t1:f32=fmin(ta,tb); t2:f32=fmax(ta,tb);
    j:s32=0;
    while j<2 {
      tt:f32=ifx j==0 then t1 else t2;
      y:f32=o.y+(d.y*tt);
      if ((tt>0.0f32)&&(tt<best.x)&&(y>=y1)&&(y<=top)) {
        px:f32=ox+(d.x*tt); pz:f32=oz+(d.z*tt);
        rr:f32=fmax(sqrt((px*px)+(pz*pz)),1e-4f32);
        nn:V3=wg_normalize3(v3(px/rr,k,pz/rr));
        best=v4(tt,nn.x,nn.y,nn.z);
        j=2;
      }
      j+=1;
    }
  }
  return best;
}
// A grove: cypresses on a 7 m grid (metaverse/slab-plan.coax slab_tree, the same hash) over a
// lawn, walked cell by cell along the ray. A glade grove leaves its middle clear.
SLAB_CELL :: 7.0f32;
slab_grove_hit :: (o:V3,d:V3,lo:V3,hi:V3,glade:bool,limit:f32)->V4 {
  sp:V2=slab_span(o,d,lo,hi);
  if ((sp.y<sp.x)||(sp.y<0.0f32)||(sp.x>=limit)) {
    return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  }
  ground:f32=lo.y+0.3f32;
  t:f32=fmax(sp.x,0.0f32);
  tend:f32=fmin(sp.y,limit);
  tg:f32=SLAB_MISS;
  if (d.y<0.0f32) {
    tg=(ground-o.y)/d.y;
    if (tg<t) { tg=SLAB_MISS; }
  }
  tend=fmin(tend,tg);
  p:V3=sb_add(o,sb_mul(d,t+0.001f32));
  cx:f32=floor(p.x/SLAB_CELL);
  cz:f32=floor(p.z/SLAB_CELL);
  stx:f32=ifx d.x>0.0f32 then 1.0f32 else -1.0f32;
  stz:f32=ifx d.z>0.0f32 then 1.0f32 else -1.0f32;
  tdx:f32=ifx abs(d.x)>1e-6f32 then SLAB_CELL/abs(d.x) else SLAB_MISS;
  tdz:f32=ifx abs(d.z)>1e-6f32 then SLAB_CELL/abs(d.z) else SLAB_MISS;
  tmx:f32=ifx abs(d.x)>1e-6f32 then (((cx+(ifx d.x>0.0f32 then 1.0f32 else 0.0f32))*SLAB_CELL)-o.x)/d.x else SLAB_MISS;
  tmz:f32=ifx abs(d.z)>1e-6f32 then (((cz+(ifx d.z>0.0f32 then 1.0f32 else 0.0f32))*SLAB_CELL)-o.z)/d.z else SLAB_MISS;
  gcx:f32=(lo.x+hi.x)*0.5f32; gcz:f32=(lo.z+hi.z)*0.5f32;
  ghx:f32=(hi.x-lo.x)*0.18f32; ghz:f32=(hi.z-lo.z)*0.18f32;
  i:s32=0;
  while (i<56)&&(t<tend) {
    a:f32=render_noise2(cx,cz);
    b:f32=render_noise2(cx+17.0f32,cz-9.0f32);
    c:f32=render_noise2(cx-31.0f32,cz+5.0f32);
    tx:f32=((cx+0.5f32)*SLAB_CELL)+((b-0.5f32)*2.2f32);
    tz:f32=((cz+0.5f32)*SLAB_CELL)+((c-0.5f32)*2.2f32);
    r:f32=1.5f32+(0.8f32*b);
    h:f32=7.0f32+(6.0f32*c);
    inside:bool=(tx>lo.x+1.0f32)&&(tx<hi.x-1.0f32)&&(tz>lo.z+1.0f32)&&(tz<hi.z-1.0f32);
    clear:bool=glade&&(abs(tx-gcx)<ghx)&&(abs(tz-gcz)<ghz);
    if ((a>0.4f32)&&inside&&(!clear)) {
      // a cypress: a column of foliage for its lower third, a cone to its tip above (a flame)
      cy:V4=slab_cypress(o,d,v3(tx,ground,tz),r,h);
      if ((cy.x>=fmax(sp.x-0.5f32,0.0f32))&&(cy.x<tend)) { return cy; }
    }
    if (tmx<tmz) { t=tmx; tmx+=tdx; cx+=stx; } else { t=tmz; tmz+=tdz; cz+=stz; }
    i+=1;
  }
  if ((tg<SLAB_MISS)&&(tg<=sp.y)&&(tg<limit)) {
    return v4(tg,0.0f32,1.0f32,0.0f32);
  }
  return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
}
// A row of statues (metaverse/slab-plan.coax slab_statue_near places the same ones): along the
// box's longer side every 12 m, 1.5 m in from each long edge, a 1.6 m pedestal 1.8 m tall and a
// 2.4 m figure on it. The candidates are the statues whose stations the ray's span crosses.
SLAB_STATUE_GAP :: 12.0f32;
slab_statues_hit :: (o:V3,d:V3,lo:V3,hi:V3,limit:f32)->V4 {
  best:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  sp:V2=slab_span(o,d,lo,hi);
  if ((sp.y<sp.x)||(sp.y<0.0f32)||(sp.x>=limit)) { return best; }
  t0:f32=fmax(sp.x,0.0f32); t1:f32=fmin(sp.y,limit);
  alongx:bool=(hi.x-lo.x)>=(hi.z-lo.z);
  la:f32=ifx alongx then lo.x else lo.z;
  ha:f32=ifx alongx then hi.x else hi.z;
  a0:f32=ifx alongx then o.x+(d.x*t0) else o.z+(d.z*t0);
  a1:f32=ifx alongx then o.x+(d.x*t1) else o.z+(d.z*t1);
  count:f32=floor((ha-la)/SLAB_STATUE_GAP);
  i0:f32=fmax(floor((fmin(a0,a1)-la)/SLAB_STATUE_GAP)-1.0f32,0.0f32);
  i1:f32=fmin(floor((fmax(a0,a1)-la)/SLAB_STATUE_GAP)+1.0f32,count-1.0f32);
  s0:f32=(ifx alongx then lo.z else lo.x)+1.5f32;
  s1:f32=(ifx alongx then hi.z else hi.x)-1.5f32;
  base:f32=lo.y;
  i:f32=i0;
  j:s32=0;
  while (i<=i1)&&(j<64) {
    c:f32=la+(SLAB_STATUE_GAP*(i+0.5f32));
    side:s32=0;
    while side<2 {
      w:f32=ifx side==0 then s0 else s1;
      px:f32=ifx alongx then c else w;
      pz:f32=ifx alongx then w else c;
      ped:V4=slab_box_hit(o,d,v3(px-0.8f32,base,pz-0.8f32),v3(px+0.8f32,base+1.8f32,pz+0.8f32));
      if ((ped.x>0.0f32)&&(ped.x<best.x)) { best=ped; }
      fig:V4=slab_drum_hit(o,d,v3(px-0.38f32,base+1.8f32,pz-0.38f32),v3(px+0.38f32,base+4.2f32,pz+0.38f32));
      if ((fig.x>0.0f32)&&(fig.x<best.x)) { best=fig; }
      side+=1;
    }
    i+=1.0f32;
    j+=1;
  }
  if (best.x>=limit) { return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32); }
  return best;
}
// A Silone dome module (metaverse/slab-plan.coax slab_silone): the base ring from the keel to 4 m
// over the water, 5 terraces each 6 m high and 6 m in from the one below, the glass lantern.
slab_silone_hit :: (o:V3,d:V3,lo:V3,hi:V3)->V4 {
  cx:f32=(lo.x+hi.x)*0.5f32; cz:f32=(lo.z+hi.z)*0.5f32;
  big:f32=(hi.x-lo.x)*0.5f32;
  yc:f32=lo.y+16.0f32;
  best:V4=slab_drum_hit(o,d,lo,v3(hi.x,yc,hi.z));
  k:s32=0;
  while k<6 {
    r:f32=ifx k<5 then big-(6.0f32*(cast(f32)(k)+1.0f32)) else 4.0f32;
    y0:f32=yc+(6.0f32*cast(f32)(k));
    y1:f32=ifx k<5 then y0+6.0f32 else y0+10.0f32;
    h:V4=slab_drum_hit(o,d,v3(cx-r,y0,cz-r),v3(cx+r,y1,cz+r));
    if ((h.x>0.0f32)&&(h.x<best.x)) { best=h; }
    k+=1;
  }
  return best;
}
// A box turned to lie along the segment a-b: half width hw across (level), half depth hh.
slab_obox_hit :: (o:V3,d:V3,a:V3,b:V3,hw:f32,hh:f32)->V4 {
  miss:V4=v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  ax:V3=sb_add(b,sb_mul(a,-1.0f32));
  hl:f32=wg_length3(ax)*0.5f32;
  if (hl<1e-3f32) { return miss; }
  e1:V3=sb_mul(ax,0.5f32/hl);
  wl:f32=fmax(sqrt((e1.x*e1.x)+(e1.z*e1.z)),1e-4f32);
  e3:V3=v3(-e1.z/wl,0.0f32,e1.x/wl);
  e2:V3=v3((e3.y*e1.z)-(e3.z*e1.y),(e3.z*e1.x)-(e3.x*e1.z),(e3.x*e1.y)-(e3.y*e1.x));
  m:V3=sb_mul(sb_add(a,b),0.5f32);
  p:V3=sb_add(o,sb_mul(m,-1.0f32));
  lo:V3=v3(wg_dot3(p,e1),wg_dot3(p,e2),wg_dot3(p,e3));
  ld:V3=v3(wg_dot3(d,e1),wg_dot3(d,e2),wg_dot3(d,e3));
  h:V4=slab_box_hit(lo,ld,v3(-hl,-hh,-hw),v3(hl,hh,hw));
  if (h.x>=SLAB_MISS) { return miss; }
  nw:V3=sb_add(sb_add(sb_mul(e1,h.y),sb_mul(e2,h.z)),sb_mul(e3,h.w));
  return v4(h.x,nw.x,nw.y,nw.z);
}
// The concept image's Greek buildings, traced on their distance fields inside their boxes.
slab_sd_box :: (p:V3,c:V3,h:V3)->f32 {
  qx:f32=abs(p.x-c.x)-h.x; qy:f32=abs(p.y-c.y)-h.y; qz:f32=abs(p.z-c.z)-h.z;
  ox:f32=fmax(qx,0.0f32); oy:f32=fmax(qy,0.0f32); oz:f32=fmax(qz,0.0f32);
  return sqrt((ox*ox)+(oy*oy)+(oz*oz))+fmin(fmax(qx,fmax(qy,qz)),0.0f32);
}
slab_sd_ring :: (p:V3,y0:f32,y1:f32,r:f32)->f32 {
  return fmax(sqrt((p.x*p.x)+(p.z*p.z))-r,fmax(y0-p.y,p.y-y1));
}
// A temple, its long side along x: q from the middle of its base, s = (half length, height, half width).
// Three steps (the crepidoma), a peristyle of columns, the cella inside, the entablature, and the roof
// whose ends are the pediments.
slab_temple_sd :: (q:V3,s:V3)->f32 {
  hh:f32=s.y; st:f32=hh*0.09f32; step:f32=s.z*0.03f32;
  d:f32=SLAB_MISS;
  k:s32=0;
  while k<3 {
    kf:f32=cast(f32)(k);
    d=fmin(d,slab_sd_box(q,v3(0.0f32,(st*(kf+0.5f32))/3.0f32,0.0f32),v3(s.x-(kf*step),st/6.0f32,s.z-(kf*step))));
    k+=1;
  }
  hl:f32=s.x-(3.0f32*step); hw:f32=s.z-(3.0f32*step);
  hc:f32=hh*0.56f32; rc:f32=fmax(hw*0.055f32,0.45f32);
  cl:f32=hl-(rc*1.6f32); cw:f32=hw-(rc*1.6f32);
  nl:f32=fmax(floor((cl*2.0f32)/(rc*5.0f32)),2.0f32); sl:f32=(cl*2.0f32)/nl;
  nw:f32=fmax(floor((cw*2.0f32)/(rc*5.0f32)),2.0f32); sw:f32=(cw*2.0f32)/nw;
  i:f32=clampf(wg_round((q.x+cl)/sl),0.0f32,nl);
  dx:f32=q.x-((-cl)+(i*sl)); dz:f32=abs(q.z)-cw;
  col:f32=sqrt((dx*dx)+(dz*dz))-rc;
  j:f32=clampf(wg_round((q.z+cw)/sw),0.0f32,nw);
  dz2:f32=q.z-((-cw)+(j*sw)); dx2:f32=abs(q.x)-cl;
  col=fmin(col,sqrt((dx2*dx2)+(dz2*dz2))-rc);
  col=fmax(col,fmax(st-q.y,q.y-(st+hc)));
  d=fmin(d,col);
  d=fmin(d,slab_sd_box(q,v3(0.0f32,st+(hc*0.5f32),0.0f32),v3(cl-(rc*3.5f32),hc*0.5f32,cw-(rc*3.5f32))));
  ye:f32=st+hc; he:f32=hh*0.13f32;
  d=fmin(d,slab_sd_box(q,v3(0.0f32,ye+(he*0.5f32),0.0f32),v3(hl,he*0.5f32,hw)));
  // the roof: a low triangle across, run the length (its ends the pediments)
  yr:f32=ye+he; hr:f32=fmax(hh-yr,0.5f32); b:f32=hw+0.4f32;
  ln:f32=sqrt((hr*hr)+(b*b));
  qy:f32=q.y-yr;
  tri:f32=fmax(((abs(q.z)*hr)+(qy*b)-(b*hr))/ln,-qy);
  d=fmin(d,fmax(tri,abs(q.x)-(hl+0.4f32)));
  return d;
}
// A tholos: round steps, a ring of columns round a round cella, a ring entablature and a dome.
slab_tholos_sd :: (q:V3,s:V3)->f32 {
  hh:f32=s.y; r:f32=s.x; st:f32=hh*0.08f32; step:f32=r*0.05f32;
  d:f32=SLAB_MISS;
  k:s32=0;
  while k<3 {
    kf:f32=cast(f32)(k);
    d=fmin(d,slab_sd_ring(q,(st*kf)/3.0f32,(st*(kf+1.0f32))/3.0f32,r-(kf*step)));
    k+=1;
  }
  r2:f32=r-(3.0f32*step); hc:f32=hh*0.45f32; rc:f32=fmax(r2*0.07f32,0.35f32);
  rr:f32=r2-(rc*1.6f32);
  n:f32=fmax(floor((6.2831853f32*rr)/(rc*5.0f32)),6.0f32); sector:f32=6.2831853f32/n;
  a:f32=wg_atan2(q.z,q.x); a=a-(sector*wg_round(a/sector));
  pr:f32=sqrt((q.x*q.x)+(q.z*q.z));
  px:f32=(pr*cos(a))-rr; pz:f32=pr*sin(a);
  col:f32=fmax(sqrt((px*px)+(pz*pz))-rc,fmax(st-q.y,q.y-(st+hc)));
  d=fmin(d,col);
  d=fmin(d,slab_sd_ring(q,st,st+hc,rr-(rc*3.0f32)));
  ye:f32=st+hc; he:f32=hh*0.12f32;
  d=fmin(d,slab_sd_ring(q,ye,ye+he,r2));
  // the dome, on a short drum
  yd:f32=ye+he; rd:f32=fmin(r2*0.92f32,hh-yd);
  dy:f32=q.y-yd;
  d=fmin(d,fmax(sqrt((q.x*q.x)+(dy*dy)+(q.z*q.z))-rd,-dy));
  return d;
}
slab_greek_sd :: (q:V3,s:V3,round:bool)->f32 {
  if (round) { return slab_tholos_sd(q,s); }
  return slab_temple_sd(q,s);
}
// Sphere-trace a temple (or tholos) in its box: (t, normal).
slab_greek_hit :: (o:V3,d:V3,lo:V3,hi:V3,round:bool,limit:f32)->V4 {
  sp:V2=slab_span(o,d,lo,hi);
  if ((sp.y<sp.x)||(sp.y<0.0f32)||(sp.x>=limit)) {
    return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
  }
  c:V3=v3((lo.x+hi.x)*0.5f32,lo.y,(lo.z+hi.z)*0.5f32);
  along:bool=(hi.x-lo.x)>=(hi.z-lo.z);
  s:V3=ifx along then v3((hi.x-lo.x)*0.5f32,hi.y-lo.y,(hi.z-lo.z)*0.5f32) else v3((hi.z-lo.z)*0.5f32,hi.y-lo.y,(hi.x-lo.x)*0.5f32);
  t:f32=fmax(sp.x,0.0f32); tend:f32=fmin(sp.y,limit);
  i:s32=0;
  while (i<72)&&(t<tend) {
    w:V3=sb_sub(sb_add(o,sb_mul(d,t)),c);
    q:V3=ifx along then w else v3(w.z,w.y,w.x);
    dist:f32=slab_greek_sd(q,s,round);
    if (dist<(0.02f32+(t*0.0004f32))) {
      e:f32=0.03f32+(t*0.0002f32);
      gx:f32=slab_greek_sd(sb_add(q,v3(e,0.0f32,0.0f32)),s,round)-slab_greek_sd(sb_sub(q,v3(e,0.0f32,0.0f32)),s,round);
      gy:f32=slab_greek_sd(sb_add(q,v3(0.0f32,e,0.0f32)),s,round)-slab_greek_sd(sb_sub(q,v3(0.0f32,e,0.0f32)),s,round);
      gz:f32=slab_greek_sd(sb_add(q,v3(0.0f32,0.0f32,e)),s,round)-slab_greek_sd(sb_sub(q,v3(0.0f32,0.0f32,e)),s,round);
      nn:V3=wg_normalize3(ifx along then v3(gx,gy,gz) else v3(gz,gy,gx));
      return v4(t,nn.x,nn.y,nn.z);
    }
    t+=fmax(dist*0.9f32,0.02f32);
    i+=1;
  }
  return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
}
SlabHit :: struct {t:f32; n:V3; kind:f32; top:f32; id:f32; lo:V3; hi:V3; }
// One record against a ray.
slab_record_hit :: (o:V3,d:V3,lo:V3,hi:V3,sh:s32,limit:f32)->V4 {
  if (sh==1) { return slab_drum_hit(o,d,lo,hi); }
  if (sh==2) { return slab_gable_hit(o,d,lo,hi,true); }
  if (sh==3) { return slab_gable_hit(o,d,lo,hi,false); }
  if ((sh>=7)&&(sh<=10)) {
    ax:f32=ifx ((sh-7)&1)==1 then hi.x else lo.x;
    az:f32=ifx ((sh-7)&2)==2 then hi.z else lo.z;
    bx:f32=lo.x+hi.x-ax; bz:f32=lo.z+hi.z-az;
    return slab_capsule(o,d,v3(ax,hi.y,az),v3(bx,lo.y,bz),0.48f32);
  }
  if (sh==4) { return slab_grove_hit(o,d,lo,hi,false,limit); }
  if (sh==5) { return slab_grove_hit(o,d,lo,hi,true,limit); }
  if (sh==6) { return slab_dome_hit(o,d,lo,hi); }
  if (sh==11) { return slab_greek_hit(o,d,lo,hi,false,limit); }
  if (sh==13) { return slab_statues_hit(o,d,lo,hi,limit); }
  if (sh==14) { return slab_silone_hit(o,d,lo,hi); }
  if ((sh>=15)&&(sh<=18)) {
    ex:f32=ifx ((sh-15)&1)==1 then hi.x-4.5f32 else lo.x+4.5f32;
    ez:f32=ifx ((sh-15)&2)==2 then hi.z-4.5f32 else lo.z+4.5f32;
    return slab_obox_hit(o,d,v3(ex,hi.y-1.2f32,ez),v3(lo.x+hi.x-ex,lo.y+1.2f32,lo.z+hi.z-ez),4.0f32,0.6f32);
  }
  if (sh==12) { return slab_greek_hit(o,d,lo,hi,true,limit); }
  return slab_box_hit(o,d,lo,hi);
}
// The nearest record nearer than `limit` (hull frame); with `masses`, only what stands on the deck.
slab_scene :: (o:V3,d:V3,masses:bool,limit:f32,u:[]f32)->SlabHit {
  hit:SlabHit=SlabHit.{t=limit,n=v3(0.0f32,1.0f32,0.0f32),kind=-1.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)};
  groups:s32=wg_i32_f(u[SLAB_P]);
  g:s32=ifx masses&&(u[SLAB_P+60]<0.5f32) then 1 else 0;
  // the section view: what lies beyond the cut (on the eye's side) is taken away
  sec:f32=u[SLAB_P+52];
  cut:f32=u[SLAB_P+53];
  while g<groups {
    ga:int=SLAB_GROUPS+((cast(int)g)*8);
    a:V4=wg_at4(u,ga);
    b:V4=wg_at4(u,ga+4);
    sp:V2=slab_span(o,d,v3(a.x,a.y,a.z),v3(b.x,b.y,b.z));
    if ((sp.x<=sp.y)&&(sp.y>=0.0f32)&&(sp.x<hit.t)) {
      first:s32=wg_i32_f(a.w);
      count:s32=wg_i32_f(b.w);
      i:s32=first;
      while i<first+count {
        at:int=SLAB_BOXES+((cast(int)i)*8);
        p:V4=wg_at4(u,at);
        q:V4=wg_at4(u,at+4);
        lo:V3=v3(p.x,p.y,p.z);
        hi:V3=v3(q.x,q.y,q.z);
        sh:s32=wg_i32_f(q.w+0.5f32);
        keep:bool=true;
        if (sec!=0.0f32) {
          if (sh==0) {
            // a box is cut through; anything else goes whole if its middle lies beyond
            if (sec>0.0f32) { hi.z=fmin(hi.z,cut); } else { lo.z=fmax(lo.z,cut); }
            keep=lo.z<hi.z;
          } else if (wg_i32_f(p.w+0.5f32)!=0) {
            keep=(sec*((((lo.z+hi.z)*0.5f32))-cut))<=0.0f32;
          }
        }
        // a tripped cold-water pipe: the first one broken off 300 m down
        if ((wg_i32_f(p.w+0.5f32)==21)&&(u[SLAB_P+57]>0.5f32)&&(lo.z<-200.0f32)) { lo.y=hi.y-300.0f32; }
        if (keep) {
          h:V4=slab_record_hit(o,d,lo,hi,sh,hit.t);
          // the hull's rounded corners: only the part on this side of the cut
          if ((sec!=0.0f32)&&(sh!=0)&&(wg_i32_f(p.w+0.5f32)==0)&&((sec*((o.z+(d.z*h.x))-cut))>0.0f32)) { h.x=SLAB_MISS; }
          if (h.x<hit.t) {
            // (a traced temple's kind carries a quarter, so its paint knows its columns are real)
            hit=SlabHit.{t=h.x,n=v3(h.y,h.z,h.w),kind=p.w+(ifx sh>=11 then 0.25f32 else 0.0f32),top=q.y,id=cast(f32)(i),lo=lo,hi=hi};
          }
        }
        i+=1;
      }
    }
    g+=1;
  }
  return hit;
}
// A capsule from a to b of radius r: (t, normal).
slab_capsule :: (o:V3,d:V3,a:V3,b:V3,r:f32)->V4 {
  ba:V3=sb_sub(b,a); oa:V3=sb_sub(o,a);
  baba:f32=wg_dot3(ba,ba); bard:f32=wg_dot3(ba,d); baoa:f32=wg_dot3(ba,oa);
  rdoa:f32=wg_dot3(d,oa); oaoa:f32=wg_dot3(oa,oa);
  qa:f32=baba-(bard*bard);
  qb:f32=(baba*rdoa)-(baoa*bard);
  qc:f32=(baba*oaoa)-(baoa*baoa)-(r*r*baba);
  h:f32=(qb*qb)-(qa*qc);
  if ((h>=0.0f32)&&(qa>1e-8f32)) {
    t:f32=((-qb)-sqrt(h))/qa;
    y:f32=baoa+(t*bard);
    if ((y>0.0f32)&&(y<baba)&&(t>0.0f32)) {
      pp:V3=sb_add(oa,sb_mul(d,t));
      nn:V3=wg_normalize3(sb_sub(pp,sb_mul(ba,y/baba)));
      return v4(t,nn.x,nn.y,nn.z);
    }
    // the caps
    oc:V3=ifx y<=0.0f32 then oa else sb_sub(o,b);
    bb:f32=wg_dot3(d,oc); cc:f32=wg_dot3(oc,oc)-(r*r);
    hh:f32=(bb*bb)-cc;
    if (hh>0.0f32) {
      t2:f32=(-bb)-sqrt(hh);
      if (t2>0.0f32) {
        pp:V3=sb_add(oc,sb_mul(d,t2));
        nn:V3=wg_normalize3(pp);
        return v4(t2,nn.x,nn.y,nn.z);
      }
    }
  }
  return v4(SLAB_MISS,0.0f32,1.0f32,0.0f32);
}
SLAB_MOOR :: 16212;   // the mooring lines (slab-lines.coax, U_MOOR): the seabed's and the fairleads' heights, two spare, then 4 lines of 5 floats
// The mooring lines nearest the eye (the world's frame), seen under water, as the mooring model
// has them now, the hull's own or its storm legs. Each line is its anchor on the seabed (x, z),
// its fairlead (x, z) and a code (slab-lines.coax, lines_uniforms): under 0 no line; else 2,048
// times the thousandths of the way to the fairlead at which it leaves the seabed, plus how far it
// hangs below the straight run half way (m), plus 1,024 for a storm leg down to one line (drawn
// thinner), or 2,047 for a broken line on the seabed. Four straight pieces: along the seabed, then
// up a parabola through the hanging point (at a third and two thirds of the way it hangs 8/9 as
// far) to the hull.
slab_lines :: (o:V3,d:V3,limit:f32,u:[]f32)->SlabHit {
  hit:SlabHit=SlabHit.{t=limit,n=v3(0.0f32,1.0f32,0.0f32),kind=-1.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)};
  bed:f32=u[SLAB_MOOR];
  fy:f32=u[SLAB_MOOR+1];
  i:s32=0;
  while i<4 {
    b:s32=SLAB_MOOR+4+(i*5);
    code:f32=u[b+4];
    if (code>=0.0f32) {
      q:f32=floor(code/2048.0f32);
      r:f32=code-(q*2048.0f32);
      lost:bool=r>2046.5f32;
      half:bool=(r>1023.5f32)&&(!lost);
      sag:f32=ifx lost then 0.0f32 else (-(ifx half then r-1024.0f32 else r)*0.8888889f32);
      share:f32=ifx lost then 0.5f32 else (q/1000.0f32);
      a:V3=v3(u[b],bed,u[b+1]);
      f:V3=v3(u[b+2],ifx lost then bed else fy,u[b+3]);
      p1:V3=v3(mix(a.x,f.x,share),bed,mix(a.z,f.z,share));
      p2:V3=sb_add(sb_mix(p1,f,0.33333334f32),v3(0.0f32,sag,0.0f32));
      p3:V3=sb_add(sb_mix(p1,f,0.6666667f32),v3(0.0f32,sag,0.0f32));
      rad:f32=ifx half then 0.3f32 else 0.6f32;
      j:s32=0;
      while j<4 {
        ca:V3=ifx j==0 then a else (ifx j==1 then p1 else (ifx j==2 then p2 else p3));
        cb:V3=ifx j==0 then p1 else (ifx j==1 then p2 else (ifx j==2 then p3 else f));
        h:V4=slab_capsule(o,d,ca,cb,rad);
        if (h.x<hit.t) { hit=SlabHit.{t=h.x,n=v3(h.y,h.z,h.w),kind=45.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)}; }
        j+=1;
      }
    }
    i+=1;
  }
  // the page lights in the hull's frame
  if (hit.kind>44.0f32) { hit=SlabHit.{t=hit.t,n=sb_dir_to_hull(hit.n,u),kind=45.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)}; }
  return hit;
}
// Sea water: what it scatters toward the eye at depth y (rgb), dimmer and bluer the deeper.
slab_deep_colour :: (y:f32,up:f32,u:[]f32)->V3 {
  return slab_sea_under_out(slab_sea_fog(y,up,u),y,u);
}
// A colour seen through `path` metres of sea, the point at depth y and the eye at depth eye: red
// goes first, then green (slab-sea.coax, by the site's water type).
slab_through_water :: (c:V3,path:f32,y:f32,eye:f32,up:f32,u:[]f32)->V3 {
  return slab_sea_through(c,path,y,eye,up,u);
}
// How far of the ray o + d t, up to t, lies under the sea (y < 0).
slab_under_len :: (o:V3,d:V3,t:f32)->f32 {
  if (o.y<0.0f32) {
    if (d.y>1e-5f32) { return fmin(t,(-o.y)/d.y); }
    return t;
  }
  if (d.y< -1e-5f32) { return fmax(t-(o.y/(-d.y)),0.0f32); }
  return 0.0f32;
}
// The walker (P_CHAR, P_GAIT): a body of capsules, legs and arms swinging with its gait.
// Returns the hit, its part in w (1 skin, 2 shirt, 3 trousers, 4 hair).
slab_walker :: (o:V3,d:V3,limit:f32,u:[]f32)->SlabHit {
  hit:SlabHit=SlabHit.{t=limit,n=v3(0.0f32,1.0f32,0.0f32),kind=-1.0f32,top=0.0f32,id=-1.0f32,lo=v3(0.0f32,0.0f32,0.0f32),hi=v3(0.0f32,0.0f32,0.0f32)};
  if (u[SLAB_P+34]<0.5f32) { return hit; }
  feet:V3=sb_p(u,28);
  cen:V3=sb_add(feet,v3(0.0f32,0.9f32,0.0f32));
  oc:V3=sb_sub(o,cen);
  bb:f32=wg_dot3(oc,d); cc:f32=wg_dot3(oc,oc)-1.44f32;
  if (((bb*bb)-cc)<0.0f32) { return hit; }
  yaw:f32=u[SLAB_P+31];
  f:V3=v3(sin(yaw),0.0f32,cos(yaw));
  rt:V3=v3(-cos(yaw),0.0f32,sin(yaw));
  phase:f32=u[SLAB_P+32];
  speed:f32=clampf(u[SLAB_P+33]/6.0f32,0.0f32,1.0f32);
  air:f32=u[SLAB_P+35];
  sw:f32=sin(phase)*(0.15f32+(0.5f32*speed))*(1.0f32-(air*0.6f32));
  k:s32=0;
  while k<7 {
    a:V3=v3(0.0f32,0.0f32,0.0f32); b:V3=a; r:f32=0.1f32; part:f32=1.0f32;
    if (k==0) { a=v3(0.0f32,0.95f32,0.0f32); b=v3(0.0f32,1.38f32,0.0f32); r=0.19f32; part=2.0f32; }
    if (k==1) { a=v3(0.0f32,1.62f32,0.02f32); b=v3(0.0f32,1.66f32,0.02f32); r=0.13f32; part=1.0f32; }
    if ((k==2)||(k==3)) {
      sd:f32=ifx k==2 then 1.0f32 else -1.0f32;
      s2:f32=sw*sd;
      a=v3(0.1f32*sd,0.9f32,0.0f32);
      b=v3(0.1f32*sd,0.9f32-(cos(s2)*0.82f32),sin(s2)*0.82f32);
      r=0.085f32; part=3.0f32;
    }
    if ((k==4)||(k==5)) {
      sd:f32=ifx k==4 then 1.0f32 else -1.0f32;
      s2:f32=-sw*sd*0.8f32;
      a=v3(0.25f32*sd,1.36f32,0.0f32);
      b=v3(0.28f32*sd,1.36f32-(cos(s2)*0.6f32),sin(s2)*0.6f32);
      r=0.06f32; part=2.0f32;
    }
    if (k==6) { a=v3(0.0f32,1.72f32,-0.02f32); b=v3(0.0f32,1.74f32,-0.03f32); r=0.115f32; part=4.0f32; }
    wa:V3=sb_add(feet,sb_add(sb_add(sb_mul(rt,a.x),v3(0.0f32,a.y,0.0f32)),sb_mul(f,a.z)));
    wb:V3=sb_add(feet,sb_add(sb_add(sb_mul(rt,b.x),v3(0.0f32,b.y,0.0f32)),sb_mul(f,b.z)));
    h:V4=slab_capsule(o,d,wa,wb,r);
    if (h.x<hit.t) {
      hit=SlabHit.{t=h.x,n=v3(h.y,h.z,h.w),kind=40.0f32+part,top=0.0f32,id=-1.0f32,lo=feet,hi=feet};
    }
    k+=1;
  }
  return hit;
}
// Stripes: 1 on the first `share` of each `period` of v, else 0.
slab_band :: (v:f32,period:f32,share:f32)->f32 {
  f:f32=fract(v/period);
  return stepf(f,share);
}
// Columns along a wall (for the classical buildings): 1 on a column, 0 in the shade between.
slab_columns :: (s:f32,period:f32)->f32 {
  f:f32=abs(fract(s/period)-0.5f32)*2.0f32;
  return smoothstep(0.42f32,0.55f32,f);
}
// The paint of what the ray hit at w (hull frame), by its kind (SLAB_KIND_* in metaverse/slab-plan.coax).
// Returns the albedo, and in emit how much it glows (windows at night, lit miners).
SlabPaint :: struct {c:V3; emit:V3; }
// The section's cut face at w, as metaverse/hull.coax weighs it. Below the hull's top, the
// watertight hull: 1.5 m sea walls and bottom, a 1 m top slab, a web every 50 m and two caisson
// walls back to back every 100 m, the ballast water, the flooded cell. Above it, the upper
// structure: a 0.8 m outer wall, the deck's 0.6 m slab on girders, and beyond the cut the columns
// that stand on the bulkhead crossings, with open space between. Then the waterline, and the
// buildings cut open floor by floor. It lights itself, as a drawing would.
slab_section :: (k:s32,w:V3,u:[]f32)->SlabPaint {
  c:V3=v3(0.10f32,0.10f32,0.11f32);
  if (k==0) {
    hl:f32=u[36]; hb:f32=u[37]; deck:f32=u[38]; keel:f32=u[39];
    top:f32=keel+SLAB_HULL_DEPTH;
    bx:f32=abs(fract((w.x+hl)/50.0f32+0.5f32)-0.5f32)*50.0f32;
    seam:f32=abs(fract((w.x+hl)/100.0f32+0.5f32)-0.5f32)*100.0f32;
    upper:bool=w.y>top;
    concrete:bool=(abs(w.x)>hl-1.5f32)||(w.y<keel+1.5f32)||(w.y>top-1.0f32)||(bx<0.3f32)||(seam<0.6f32);
    if (upper) { concrete=(abs(w.x)>hl-0.8f32)||(w.y>deck-0.6f32)||((bx<1.0f32)&&(w.y>deck-3.6f32)); }
    if (concrete) {
      hatch:f32=slab_band(w.x+w.y,2.0f32,0.25f32);
      c=sb_mul(v3(0.66f32,0.64f32,0.60f32),0.9f32+(0.1f32*hatch));
    } else if (upper) {
      // open space under the deck; the columns beyond the cut, 8 m square
      c=ifx bx<4.0f32 then v3(0.33f32,0.32f32,0.31f32) else v3(0.13f32,0.14f32,0.16f32);
    } else {
      c=v3(0.17f32,0.17f32,0.18f32);
      // the cells' own lights, a row along each
      c=sb_add(c,sb_mul(v3(0.2f32,0.18f32,0.14f32),slab_band(w.y-(top-6.0f32),50.0f32,0.04f32)));
      // cell A1, the south-west corner, is a void (no ballast): its floodwater when holed
      a1:bool=(w.x<(-hl)+50.0f32)&&(w.z<(-hb)+50.0f32);
      if ((w.y<u[SLAB_P+54])&&!a1) { c=v3(0.06f32,0.26f32,0.42f32); }
      if (a1&&(w.y<u[SLAB_P+55])) { c=v3(0.70f32,0.18f32,0.10f32); }
    }
    // the waterline outside, dashed across the cut
    if ((abs(w.y)<0.35f32)&&(slab_band(w.x,8.0f32,0.6f32)>0.5f32)) { c=v3(0.9f32,0.95f32,1.0f32); }
  } else if (k!=21) {
    // a building cut open: its floors every 3.6 m
    c=sb_add(v3(0.16f32,0.15f32,0.14f32),sb_mul(v3(0.5f32,0.48f32,0.44f32),slab_band(w.y-u[38],3.6f32,0.1f32)));
  }
  return SlabPaint.{c=sb_mul(c,0.25f32),emit=sb_mul(c,0.8f32)};
}
slab_paint :: (hit:SlabHit,w:V3,d:V3,u:[]f32)->SlabPaint {
  kind:f32=hit.kind; n:V3=hit.n; top:f32=hit.top;
  k:s32=wg_i32_f(kind+0.5f32);
  roof:bool=n.y>0.5f32;
  night:f32=u[SLAB_P+39];
  grain:f32=0.95f32+(0.07f32*slab_noise(v2((w.x*0.13f32)+(w.y*0.07f32),(w.z*0.13f32)-(w.y*0.05f32))));
  c:V3=v3(0.80f32,0.78f32,0.74f32);
  emit:V3=v3(0.0f32,0.0f32,0.0f32);
  deck:f32=u[38];
  oncut:bool=(u[SLAB_P+52]!=0.0f32)&&(abs(n.z)>0.9f32)&&(abs(w.z-u[SLAB_P+53])<0.6f32);
  // Construction materials share the existing lighting, depth and sea occlusion.
  if ((k>=22)&&(k<=26)) {
    if (k==22) {
      c=v3(0.72f32,0.72f32,0.66f32);
      if (roof) {
        j:f32=fmax(slab_band(w.x,100.0f32,0.012f32),slab_band(w.z,50.0f32,0.022f32));
        c=sb_mul(c,1.0f32-0.55f32*j);
      } else {
        c=sb_mul(c,0.93f32-0.13f32*slab_band(w.y,4.0f32,0.15f32));
        c=sb_mix(v3(0.26f32,0.34f32,0.31f32),c,smoothstep(0.0f32,2.0f32,w.y));
      }
    } else if (k==23) { c=v3(0.98f32,0.59f32,0.13f32); }
    else if (k==24) { c=ifx w.y<1.5f32 then v3(0.51f32,0.16f32,0.08f32) else v3(0.12f32,0.27f32,0.32f32); }
    else if (k==25) { c=ifx w.y>6.3f32 then v3(0.21f32,0.38f32,0.43f32) else v3(0.96f32,0.91f32,0.79f32); }
    else { c=v3(0.81f32,0.40f32,0.20f32); }
