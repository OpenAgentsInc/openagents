  } else if (k==7) {
    c=sb_mix(v3(0.30f32,0.42f32,0.22f32),v3(0.40f32,0.50f32,0.28f32),slab_noise(v2(w.x*0.2f32,w.z*0.2f32)));
  } else if (k==8) {
    slot:f32=(w.x-160.0f32)/13.6f32;
