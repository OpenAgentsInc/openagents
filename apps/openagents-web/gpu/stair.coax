    g:f32=fmax(d-r,0.0f32)/fmax(v.shape.w,1.0f32);
    col=wg_add_f3f3(col,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(v.tint.x,v.tint.y,v.tint.z),exp(((-5.0f32)*g)*g)),0.22f32),(1.0f32-body)));
    return wg_make_f4_f3f(wg_mul_f3f(wg_mul_f3f(col,v.shape.z),u[3]),1.0f32);
