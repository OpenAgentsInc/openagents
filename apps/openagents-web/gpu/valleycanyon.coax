// Valley Lab source pair: actual source normals/UV/paint, 4K maps and shared shadow effects.
#load "splash.coax";
#load "../../../aethyr/render/sampling.coax";
#load "../../../verse/valley/echo-materials.coax";
#load "../../../aethyr/render/pbr-env.coax";
#load "../../../aethyr/render/filmic.coax";
#load "../../../aethyr/anim/morph-gpu.coax";
#load "../../../verse/valley/slay-orb.coax";
#load "../../../verse/valley/slay-lights.coax";
#load "../../../aethyr/render/hair-fiber.coax";
#load "../../../aethyr/render/character.coax";
cv_orb_rotate :: (p:V3,u:[]f32)->V3 {q:=cv_at(u,100);return cv_add(p,cv_scale(wg_cross3(q,cv_add(wg_cross3(q,p),cv_scale(p,u[103]))),2));}
cv_world :: (id:u32,instance:u32,vertices:[]u32,u:[]f32,bones:[]f32)->V3 {
 if id>=1000000 {return cv_groom(id,vertices,u,bones,false).world;}
 if id>=980000 {at:=cv_vertex_at(id,vertices);return cv_add(cv_at(u,116),cv_orb_rotate(cv_scale(v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2)),SLAY_ORB_RADIUS*2),u));}
 if instance==2 {m:=cv_morph(id,vertices,bones,u);p:=v4(m.position.x,m.position.y,m.position.z,1);return cv_add(cv_at(u,104),cv_echo_direction(cv_skin(id,p,vertices,bones),u));}
 at:=cast(int)id*12;p:=v4(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2),1);m:=32+cast(int)instance*24;return v3(wg_dot4(wg_at4(u,m),p),wg_dot4(wg_at4(u,m+4),p),wg_dot4(wg_at4(u,m+8),p));
}
cv_shadow :: (world:V3,u:[]f32)->V3 {p:=cv_sub(world,cv_at(u,92));return v3(wg_dot3(p,cv_at(u,80))/u[96],wg_dot3(p,cv_at(u,84))/u[96],0.5-wg_dot3(p,cv_at(u,88))/(4*u[96]));}
vc_bg_vs :: (i:u32,j:u32)->V4 {return splash_bg_vs(i,j);}
// An explicit metre grid on the inspection floor, below every source bound. The original scene's terrain is not included.
cv_bg_colour :: (p:V4,u:[]f32)->V4 {
  if u[112]>0.5 {
   sy:=1-p.y/u[1]*2;if abs(sy)>u[0]/u[1]/u[113] {return v4(0,0,0,1);}
   ray:=wg_normalize3(cv_add(cv_at(u,20),cv_add(cv_scale(cv_at(u,12),(p.x/u[0]*2-1)/u[15]),cv_scale(cv_at(u,16),sy/u[19]))));
   delta:=cv_sub(cv_at(u,116),cv_at(u,8));along:=wg_dot3(delta,ray);distance:=sqrt(fmax(0.0f32,wg_dot3(delta,delta)-along*along));r:=SLAY_ORB_RADIUS;core:=1-smoothstep(r*0.8,r*1.05,distance);halo:=exp(-distance*distance/(r*r*5))*0.5;flare:=exp(-distance*distance/(r*r*35))*0.06;
   return v4(clampf(halo*0.2+flare*0.1,0.0f32,1.0f32),clampf(halo*0.65+flare*0.5,0.0f32,1.0f32),clampf(halo+flare,0.0f32,1.0f32),1);
  }
  if u[110]>0.5 {return v4(0,0,0,1);}
  sky:=v3(0.065,0.075,0.09);if u[7]<0.5 {return v4(sky.x,sky.y,sky.z,1);}
  ray:=cv_add(cv_at(u,20),cv_add(cv_scale(cv_at(u,12),(p.x/u[0]*2-1)/u[15]),cv_scale(cv_at(u,16),(1-p.y/u[1]*2)/u[19])));
  if ray.y>=-0.0001 {return v4(sky.x,sky.y,sky.z,1);}t:=(u[100]-u[9])/ray.y;if t<=0 {return v4(sky.x,sky.y,sky.z,1);}
  at:=cv_add(cv_at(u,8),cv_scale(ray,t));fx:=abs(at.x-floor(at.x+0.5));fz:=abs(at.z-floor(at.z+0.5));line:=ifx fx<0.025 || fz<0.025 then 0.08f32 else 0.0f32;
  fade:=1.0f32/(1.0f32+t*0.025f32);c:=cv_add(cv_scale(v3(0.16+line,0.15+line,0.13+line),fade),cv_scale(sky,1-fade));return v4(c.x,c.y,c.z,1);
}
// bg_fs and scene_fs draw the toned colour into the post pass's light target and, in aux.x, how
// much of the pixel is skin (aux.w the draw's coverage, so hair blended over skin thins it).
VcLit :: struct {light:V4; aux:V4;}
vc_bg_fs :: (p:V4,u:[]f32)->VcLit {c:=cv_bg_colour(p,u);return VcLit.{light=c,aux=v4(0,0,0,1)};}
vc_vertex :: struct {a:V4;b:V4;c:V4;}
vc_fx_vs :: (i:u32,j:u32,a:vc_vertex,u:[]f32)->SplashV {return splash_fx_vs(i,j,splash_fx_vs_in.{a=a.a,b=a.b,c=a.c,d=v4(0,0,0,0)},u);}
vc_fx_fs :: (v:SplashV,u:[]f32)->V4 {return splash_fx_fs(v,u);}
// The hair's direct light at one strand vertex: the key light (to be shadowed per pixel) and the
// ambient plus the other four Slay lights. One loop keeps one copy of the fiber and scattering code.
HairLight :: struct {key:V3;rest:V3;}
cv_hair_vertex_light :: (u:[]f32,albedo:V3,rough:f32,seed:f32,t:V3,world:V3)->HairLight {
 v:=wg_normalize3(cv_sub(cv_at(u,8),world));avg:=cv_hair_averages(albedo,-wg_dot3(t,v));
 slay:=u[112]>0.5;key:=v3(0,0,0);rest:=cv_scale(albedo,ifx slay then 0.08f32 else 0.7734375f32);rect:=cv_rect_delta(u,world);lights:=ifx slay then 5 else 1;
 for light:0..<lights {
  dir:=ifx light==0 then cv_at(u,24) else ifx light==1 then cv_at(u,97) else ifx light==2 then cv_at(u,28) else ifx light==3 then cv_kick_dir(u) else wg_normalize3(rect);
  power:=ifx light==0 then (ifx slay then u[123] else 3.5f32) else ifx light==1 then u[115]*SLAY_WRAP_FALLOFF else ifx light==2 then u[31]*SLAY_FILL_FALLOFF else ifx light==3 then SLAY_KICK_POWER*SLAY_KICK_FALLOFF else cv_rect_power(u,rect);
  tint:=ifx light==0 then (ifx slay then cv_at(u,120) else v3(1,1,1)) else ifx light==1 then v3(1,0.40197778,0.20155625) else ifx light==2 then cv_at(u,124) else ifx light==3 then v3(SLAY_KICK_R,SLAY_KICK_G,SLAY_KICK_B) else v3(u[23],u[27],u[95]);
  c:=cv_mul(cv_scale(cv_fiber_light(albedo,t,dir,v,rough,seed,avg),power),tint);if light==0 {key=c;} else {rest=cv_add(rest,c);}
 }
 return HairLight.{key=key,rest=rest};
}
// extra/extra2 carry per-vertex work the fragment stage reads: on hair the key light (extra.xyz,
// shadowed per pixel) and everything else (extra2.xyz), on Echo's body the orb light's hand-capsule
// visibility (extra.x).
CanyonSurface :: struct {pos:V4;world:V3;normal:V3;uv:V2;paint:V4;tangent:V4;character:f32;material:f32;extra:V4;extra2:V4;}
vc_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonSurface {
 world:=cv_world(id,instance,vertices,u,bones);at:=cast(int)id*12;normal:=v3(0,1,0);uv:=v2(0,0);paint:=v4(1,1,1,1);tangent:=v4(0,0,0,1);material:f32=0;character:f32=0;extra:=v4(1,1,1,1);extra2:=v4(0,0,0,0);
 if id>=1000000 && !cv_groom_kept(id,vertices,u,false) {return CanyonSurface.{pos=v4(0,0,-2,1),world=v3(0,0,0),normal=normal,uv=uv,paint=paint,tangent=tangent,character=1,material=26,extra=extra,extra2=extra2};}
 if id>=1000000 {groom:=cv_groom(id,vertices,u,bones,false);normal=groom.normal;tangent=v4(groom.tangent.x,groom.tangent.y,groom.tangent.z,1);uv=groom.uv;paint=v4(groom.coverage,groom.edge,1,1);character=1;material=groom.material;
  lit:=cv_hair_vertex_light(u,cv_hair_colour(u,groom.uv.x,groom.uv.y),mix(0.32f32,0.45f32,groom.uv.y)*(1+0.1*groom.uv.x),groom.uv.y,wg_normalize3(groom.tangent),world);extra=v4(lit.key.x,lit.key.y,lit.key.z,1);extra2=v4(lit.rest.x,lit.rest.y,lit.rest.z,0);}
 else if id>=980000 {at=cv_vertex_at(id,vertices);normal=cv_orb_rotate(v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5)),u);t:=cv_orb_rotate(v3(cv_word(vertices,at+15),cv_word(vertices,at+16),cv_word(vertices,at+17)),u);tangent=v4(t.x,t.y,t.z,cv_word(vertices,at+18));character=1;material=29;}
 else if instance==2 {at=cv_vertex_at(id,vertices);m:=cv_morph(id,vertices,bones,u);normal=cv_echo_direction(cv_skin(id,v4(m.normal.x,m.normal.y,m.normal.z,0),vertices,bones),u);t:=cv_echo_direction(cv_skin(id,v4(cv_word(vertices,at+15),cv_word(vertices,at+16),cv_word(vertices,at+17),0),vertices,bones),u);tangent=v4(t.x,t.y,t.z,cv_word(vertices,at+18));character=1;material=cast(f32)vertices[at+8];if u[112]>0.5 {rect:=cv_rect_delta(u,world);if cv_rect_power(u,rect)>0 {extra.x=cv_hand_visibility(world,cv_add(world,rect),u,bones);}}}
 else {n:=v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5));m:=44+cast(int)instance*24;normal=v3(wg_dot3(cv_at(u,m),n),wg_dot3(cv_at(u,m+4),n),wg_dot3(cv_at(u,m+8),n));paint=wg_unpack4x8unorm(vertices[at+8]);}
 if id<1000000 {uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));}r:=cv_sub(world,cv_at(u,8));z:=wg_dot3(r,cv_at(u,20));return CanyonSurface.{pos=v4(wg_dot3(r,cv_at(u,12))*u[15],wg_dot3(r,cv_at(u,16))*u[19],300.0/299.95*(z-0.05),z),world=world,normal=normal,uv=uv,paint=paint,tangent=tangent,character=character,material=material,extra=extra,extra2=extra2};
}
CanyonShadow :: struct {pos:V4;uv:V2;character:f32;material:f32;coverage:f32;edge:f32;}
vc_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonShadow {
 if id>=1000000 && !cv_groom_kept(id,vertices,u,true) {return CanyonShadow.{pos=v4(0,0,-2,1),uv=v2(0,0),character=1,material=26,coverage=0,edge=0};}
 if id>=1000000 {groom:=cv_groom(id,vertices,u,bones,true);g:=cv_shadow(groom.world,u);return CanyonShadow.{pos=v4(g.x,g.y,g.z,1),uv=groom.uv,character=ifx instance==2 then 1.0f32 else 0.0f32,material=groom.material,coverage=groom.coverage,edge=groom.edge};}
 q:=cv_shadow(cv_world(id,instance,vertices,u,bones),u);uv:=v2(0,0);material:f32=0;coverage:f32=1;edge:f32=0;if id>=1000000 {groom:=cv_groom(id,vertices,u,bones,true);uv=groom.uv;material=groom.material;coverage=groom.coverage;edge=groom.edge;}else if instance==2 {at:=cv_vertex_at(id,vertices);uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));material=cast(f32)vertices[at+8];}return CanyonShadow.{pos=v4(q.x,q.y,q.z,1),uv=uv,character=ifx instance==2 then 1.0f32 else 0.0f32,material=material,coverage=coverage,edge=edge};
}
vc_shadow_fs :: (s:CanyonShadow,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler) {if s.material==29 {gpu_discard();}if s.material==26 || s.material==27 {noise:=sin(floor(s.pos.x)*12.9898+floor(s.pos.y)*78.233+s.uv.y*437.0)*43758.5453;if cv_groom_opacity(s.coverage,s.edge)<noise-floor(noise) {gpu_discard();}}dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));if s.character>0.5 {cv_echo_mask(s.uv,s.material,vertices,sheets,sheet,dx,dy);}}
cv_orb_shade :: (s:CanyonSurface,u:[]f32,vertices:[]u32)->V4 {
 dist:=cast(int)vertices[ECHO_MATERIAL_WORD+31*16+2];energy:=cast(int)vertices[ECHO_MATERIAL_WORD+31*16+3];n:=wg_normalize3(s.normal);t:=wg_normalize3(v3(s.tangent.x,s.tangent.y,s.tangent.z));b:=cv_scale(wg_cross3(n,t),s.tangent.w);v:=wg_normalize3(cv_sub(cv_at(u,8),s.world));nv:=wg_dot3(n,v);if nv<=0 {gpu_discard();}
 bump:=raw_rgb_sample(vertices,dist,256,v2(u[5]*0.1,u[5]*0.1));x:=bump.x*2-1;y:=1-bump.y*2;z:=sqrt(fmax(0.0f32,1-x*x-y*y));normal:=cv_add(cv_scale(t,x*0.5),cv_add(cv_scale(b,y*0.5),cv_scale(n,z*0.5+0.5)));
 e:=slay_orb_emission(wg_dot3(normal,v),nv,slay_orb_energy(vertices,dist,energy,s.uv,u[5]));mapped:=film_rec709(film_rgb(e.x,e.y,e.z));return v4(cv_srgb(clampf(mapped.r,0.0f32,1.0f32)),cv_srgb(clampf(mapped.g,0.0f32,1.0f32)),cv_srgb(clampf(mapped.b,0.0f32,1.0f32)),e.w);
}
// The orb Rect Light from the shot: position (u[83],u[87],u[91]), colour x candelas
// (u[23],u[27],u[95]), attenuation radius u[107] and octahedral aim (u[11],u[127]), in
// otherwise unused uniform slots.
cv_rect_delta :: (u:[]f32,world:V3)->V3 {return v3(u[83]-world.x,u[87]-world.y,u[91]-world.z);}
// The kick is static in shot space; the face view turns the whole rig by the yaw in u[119].
cv_kick_dir :: (u:[]f32)->V3 {c:=cos(u[119]);s:=sin(u[119]);return v3(c*SLAY_KICK_X+s*SLAY_KICK_Z,SLAY_KICK_Y,-s*SLAY_KICK_X+c*SLAY_KICK_Z);}
// Closest distance between segments p0-p1 and q0-q1 (Ericson, Real-Time Collision Detection 5.1.9).
cv_segment_gap :: (p0:V3,p1:V3,q0:V3,q1:V3)->f32 {
 d1:=cv_sub(p1,p0);d2:=cv_sub(q1,q0);r:=cv_sub(p0,q0);a:=fmax(wg_dot3(d1,d1),0.00000001f32);e:=fmax(wg_dot3(d2,d2),0.00000001f32);f:=wg_dot3(d2,r);c:=wg_dot3(d1,r);b:=wg_dot3(d1,d2);denom:=a*e-b*b;
 sa:=ifx denom>0.0000000001 then clampf((b*f-c*e)/denom,0.0f32,1.0f32) else 0.0f32;t:=(b*sa+f)/e;
 if t<0 {t=0;sa=clampf(-c/a,0.0f32,1.0f32);} else if t>1 {t=1;sa=clampf((b-c)/a,0.0f32,1.0f32);}
 return wg_length3(cv_sub(cv_add(p0,cv_scale(d1,sa)),cv_add(q0,cv_scale(d2,t))));
}
// How much of the orb light reaches p past the orb hand's capsules. A capsule the point lies on
// (within 1.6 radii of its axis) is skipped so a finger does not shadow its own skin.
cv_hand_visibility :: (p:V3,light:V3,u:[]f32,bones:[]f32)->f32 {
 // Work in Echo's model space: two points turned once instead of forty capsule ends, and no test at
 // all when the ray to the light passes more than 0.3 m from the hand joint (capsule 1's start).
 a0:=cv_sub(p,cv_at(u,104));b0:=cv_sub(light,cv_at(u,104));
 q:=v3(u[108]*a0.x-u[109]*a0.z,a0.y,u[109]*a0.x+u[108]*a0.z);l:=v3(u[108]*b0.x-u[109]*b0.z,b0.y,u[109]*b0.x+u[108]*b0.z);
 hand:=SLAY_HAND_CAPSULE_WORD+8;if bones[hand+3]<=0 {return 1;}centre:=v3(bones[hand],bones[hand+1],bones[hand+2]);
 if cv_segment_gap(q,l,centre,centre)>0.3 {return 1;}
 visible:f32=1;
 for k:0..<SLAY_HAND_CAPSULES {at:=SLAY_HAND_CAPSULE_WORD+k*8;r:=bones[at+3];
  if r>0 {a:=v3(bones[at],bones[at+1],bones[at+2]);b:=v3(bones[at+4],bones[at+5],bones[at+6]);
   if cv_segment_gap(q,q,a,b)>r*1.6 {visible=visible*clampf((cv_segment_gap(q,l,a,b)-r*0.8)/(r*0.5),0.0f32,1.0f32);}}
 }
 return visible;
}
#test "Hand capsules shadow the orb light across them and never a point on their own skin" {
 u:[128]f32;u[108]=1;bones:[SLAY_HAND_CAPSULE_WORD+SLAY_HAND_CAPSULES*8]f32;at:=SLAY_HAND_CAPSULE_WORD;bones[at]= -0.1;bones[at+4]=0.1;bones[at+3]=0.02;bones[at+11]=0.02;
 #assert cv_hand_visibility(v3(0,-0.2,0),v3(0,0.2,0),u[..],bones[..])==0;u[104]=5;#assert cv_hand_visibility(v3(5,-0.2,0),v3(5,0.2,0),u[..],bones[..])==0;u[104]=0;bones[at+11]=0;#assert cv_hand_visibility(v3(0,-0.2,0),v3(0,0.2,0),u[..],bones[..])==1;bones[at+11]=0.02;
 #assert cv_hand_visibility(v3(0,-0.2,0),v3(0,0.2,0),u[..],bones[..])==0;
 #assert cv_hand_visibility(v3(0.5,-0.2,0),v3(0.5,0.2,0),u[..],bones[..])==1;
 #assert cv_hand_visibility(v3(0,-0.021,0),v3(0,0.2,0),u[..],bones[..])==1;
 #assert abs(cv_segment_gap(v3(0,0,0),v3(1,0,0),v3(0.5,1,0),v3(0.5,2,0))-1)<0.00001;
}
cv_oct_decode :: (x:f32,y:f32)->V3 {n:=v3(x,y,1-abs(x)-abs(y));t:=fmax(-n.z,0.0f32);return wg_normalize3(v3(n.x+(ifx n.x>=0 then -t else t),n.y+(ifx n.y>=0 then -t else t),n.z));}
cv_rect_power :: (u:[]f32,rect:V3)->f32 {d2:=wg_dot3(rect,rect);aim:=cv_oct_decode(u[11],u[127]);return slay_candela_scale(d2,u[107])*slay_rect_emission(-wg_dot3(aim,rect)/sqrt(fmax(d2,0.000001f32)));}
#test "Octahedral aim round-trips every octant and the rect light is dark behind its panel" {
 for d:[6]V3.[v3(0.6,0.48,0.64),v3(-0.6,0.48,-0.64),v3(0.36,-0.48,-0.8),v3(-0.8,-0.36,0.48),v3(0,0,-1),v3(0,1,0)] {e:=cv_oct_decode(slay_oct_x(d.x,d.y,d.z),slay_oct_y(d.x,d.y,d.z));#assert abs(e.x-d.x)<0.0001 && abs(e.y-d.y)<0.0001 && abs(e.z-d.z)<0.0001;}
 u:[128]f32;u[107]=0.5;u[11]=slay_oct_x(0,0,1);u[127]=slay_oct_y(0,0,1);
 #assert cv_rect_power(u[..],v3(0,0,-0.3))>0 && cv_rect_power(u[..],v3(0,0,0.3))==0 && cv_rect_power(u[..],v3(0.3,0,-0.01))==0;
}

vc_scene_fs :: (s:CanyonSurface,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->VcLit {
  if u[112]>0.5 && abs(1-s.pos.y/u[1]*2)>u[0]/u[1]/u[113] {gpu_discard();}
  dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));
  c:=cv_scene_shade(s,u,sheets,sheet,vertices,shadow_map,shadow_cmp,dx,dy);
  skin:=ifx s.character>0.5 && (s.material==ECHO_HEAD_SLOT || s.material==ECHO_SKIN_SLOT) then 1.0f32 else 0.0f32;
  // aux.y/aux.z: the view depth, weighted by coverage. Blended hair writes no depth buffer, so
  // the post pass reads the strands' depth from here instead of the background's behind them.
  return VcLit.{light=c,aux=v4(skin,cv_view_z(s.pos.z),1,c.w)};
}
cv_shadow_pcf :: (world:V3,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->f32 {
 q:=cv_shadow(world,u);shadow:f32=1;if abs(q.x)<1 && abs(q.y)<1 && q.z>0 && q.z<1 {shadow=0;for y:0..<3 {for x:0..<3 {offset:=ifx u[112]>0.5 then 0.004f32 else 0.0f32;shadow+=gpu_compare(shadow_map,shadow_cmp,v2(q.x*0.5+0.5+cast(f32)(x-1)*offset,0.5-q.y*0.5+cast(f32)(y-1)*offset),q.z-0.00015)/9;}}}
 return shadow;
}
cv_scene_shade :: (s:CanyonSurface,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,shadow_map:TexDepth,shadow_cmp:SamplerCompare,dx:V2,dy:V2)->V4 {
  if s.material==29 {return cv_orb_shade(s,u,vertices);}
  n:=wg_normalize3(s.normal);albedo:=v3(1,1,1);rough:f32=0.65;metal:f32=0;skin_f0:f32=0.04;occlusion:f32=1;

  if s.character>0.5 {e:=cv_echo_material(s.normal,s.tangent,s.world,s.uv,s.material,u,sheets,sheet,vertices,dx,dy);n=e.normal;albedo=e.albedo;rough=e.rough;metal=e.metal;skin_f0=e.f0;occlusion=e.occlusion;
  }else {a:=render_sample_layer8_grad(sheets,sheet,s.uv,0,dx,dy,0);albedo=cv_scale(v3(a.x,a.y,a.z),u[6]);rough=cv_srgb(render_sample_layer8_grad(sheets,sheet,s.uv,1,dx,dy,0).x);}rough=clampf(rough,0.045f32,1.0f32);
  if u[4]>0.5 && u[4]<1.5 {return v4(cv_srgb(albedo.x),cv_srgb(albedo.y),cv_srgb(albedo.z),1);}
  if u[4]>1.5 && u[4]<2.5 {return v4(n.x*0.5+0.5,n.y*0.5+0.5,n.z*0.5+0.5,1);}
  if u[4]>2.5 && u[4]<3.5 {return v4(rough,rough,rough,1);}if u[4]>3.5 {return v4(s.paint.x,s.paint.y,s.paint.z,1);}
  // Strands are under a pixel wide, so they are lit per vertex (cv_hair_vertex_light); a hair pixel
  // adds only the key light's shadow and its coverage.
  if s.character>0.5 && (s.material==26 || s.material==27) && u[114]>=0 {
   colour:=cv_add(cv_scale(v3(s.extra.x,s.extra.y,s.extra.z),cv_shadow_pcf(s.world,u,shadow_map,shadow_cmp)),v3(s.extra2.x,s.extra2.y,s.extra2.z));
   mapped:=film_rec709(film_rgb(colour.x,colour.y,colour.z));return v4(cv_srgb(clampf(mapped.r,0.0f32,1.0f32)),cv_srgb(clampf(mapped.g,0.0f32,1.0f32)),cv_srgb(clampf(mapped.b,0.0f32,1.0f32)),cv_groom_opacity(s.paint.x,s.paint.y));
  }
  l:=cv_at(u,24);v:=wg_normalize3(cv_sub(cv_at(u,8),s.world));halfway:=wg_normalize3(cv_add(l,v));nl:=fmax(0.0f32,wg_dot3(n,l));nv:=fmax(0.0001f32,wg_dot3(n,v));nh:=fmax(0.0f32,wg_dot3(n,halfway));vh:=fmax(0.0f32,wg_dot3(v,halfway));alpha:=rough*rough;aa:=alpha*alpha;den:=nh*nh*(aa-1)+1;distribution:=aa/(3.14159265*den*den);k:=(rough+1)*(rough+1)/8;g:=nv/(nv*(1-k)+k)*nl/(nl*(1-k)+k);dielectric:=ifx (s.material==26 || s.material==27) then mix(0.004f32,0.008f32,s.uv.y) else skin_f0;f0:=v3(mix(dielectric,albedo.x,metal),mix(dielectric,albedo.y,metal),mix(dielectric,albedo.z,metal));fresnel:=pow(1-vh,5.0f32);spec:=cv_scale(v3(f0.x+(1-f0.x)*fresnel,f0.y+(1-f0.y)*fresnel,f0.z+(1-f0.z)*fresnel),distribution*g/(4*nv*fmax(nl,0.0001f32)));
  shadow:=cv_shadow_pcf(s.world,u,shadow_map,shadow_cmp);
  ambient:=ifx s.character>0.5 then 0.7734375f32 else 0.16f32+0.12f32*(n.y*0.5f32+0.5f32);direct:=nl*shadow*3.5;colour:=cv_add(cv_scale(albedo,ambient*(1-metal)+direct*(1-metal)/3.14159265),cv_scale(spec,direct));
  if u[112]>0.5 {
   skin:=s.character>0.5 && (s.material==ECHO_HEAD_SLOT || s.material==ECHO_SKIN_SLOT);geo:=wg_normalize3(s.normal);rect:=cv_rect_delta(u,s.world);
   inner:=ifx s.character>0.5 && s.material==ECHO_TEETH_SLOT then SLAY_MOUTH_OCCLUSION else 1.0f32;
   // Skin creases: every light takes the contact term (the key on top of its shadow map).
   contact:=ifx skin then fmin(1.0f32,occlusion*SLAY_SKIN_CONTACT) else 1.0f32;soft:=inner*contact;
   colour=cv_add(cv_scale(albedo,0.08*occlusion*inner),cv_mul(cv_scale(cv_slay_light(skin,albedo,f0,metal,rough,n,geo,l,v,1,SLAY_KEY_SIZE),shadow*u[123]*inner),cv_at(u,120)));
   colour=cv_scale(colour,contact);
   if skin || inner<1 {bleed:=fmax(0.0f32,(wg_dot3(geo,l)+0.5)/1.5)*(1-shadow)*u[123]*contact*(ifx inner<1 then SLAY_MOUTH_BLEED else 1.0f32)/3.14159265;key_rgb:=cv_at(u,120);colour=cv_add(colour,v3(albedo.x*key_rgb.x*bleed*SLAY_SSS_BLEED_R,albedo.y*key_rgb.y*bleed*SLAY_SSS_BLEED_G,0));}
   colour=cv_add(colour,cv_mul(cv_scale(cv_slay_light(skin,albedo,f0,metal,rough,n,geo,cv_at(u,97),v,1,SLAY_SOFT_SIZE),u[115]*SLAY_WRAP_FALLOFF*soft),v3(1,0.40197778,0.20155625)));
   colour=cv_add(colour,cv_mul(cv_scale(cv_slay_light(skin,albedo,f0,metal,rough,n,geo,cv_at(u,28),v,SLAY_SOFT_SPECULAR,SLAY_SOFT_SIZE),u[31]*SLAY_FILL_FALLOFF*soft),cv_at(u,124)));
   colour=cv_add(colour,cv_mul(cv_scale(cv_slay_light(skin,albedo,f0,metal,rough,n,geo,cv_kick_dir(u),v,SLAY_SOFT_SPECULAR,SLAY_SOFT_SIZE),SLAY_KICK_POWER*SLAY_KICK_FALLOFF*soft),v3(SLAY_KICK_R,SLAY_KICK_G,SLAY_KICK_B)));
   colour=cv_add(colour,cv_mul(cv_scale(cv_slay_light(skin,albedo,f0,metal,rough,n,geo,wg_normalize3(rect),v,1,0),cv_rect_power(u,rect)*s.extra.x*soft),v3(u[23],u[27],u[95])));
   if skin {env:=pbr_environment(rough,nv);colour=cv_add(colour,cv_scale(v3(1,0.94,0.75),(f0.x*env.a+env.b)*SLAY_SKIN_ENV*cv_specular_occlusion(nv,occlusion,rough)*smoothstep(0.0f32,0.35f32,nv)));}
  }
  if s.character>0.5 && s.material<26 && u[112]<0.5 {environment:=pbr_environment(rough,nv);f90:=clampf(50*f0.y,0.0f32,1.0f32);colour=cv_add(colour,cv_scale(cv_add(cv_scale(f0,environment.a),v3(f90*environment.b,f90*environment.b,f90*environment.b)),0.7734375));}
  if s.character>0.5 {mapped:=film_rec709(film_rgb(colour.x,colour.y,colour.z));return v4(cv_srgb(clampf(mapped.r,0.0f32,1.0f32)),cv_srgb(clampf(mapped.g,0.0f32,1.0f32)),cv_srgb(clampf(mapped.b,0.0f32,1.0f32)),ifx s.material==26 || s.material==27 then cv_groom_opacity(s.paint.x,s.paint.y) else 1.0f32);}
  return v4(cv_tone(colour.x),cv_tone(colour.y),cv_tone(colour.z),1);
}

// ---- the post pass: TF0290's depth of field and the skin's subsurface blur
// No bloom: the host runs bloom_fs's passes for any post pass; these write nothing to it.
vc_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {return v4(0,0,0,1);}
CV_NEAR :: 0.05f32;
// Camera distance from the depth buffer (scene_vs: z' = 300/299.95 (z - 0.05), w = z).
cv_view_z :: (d:f32)->f32 {return CV_NEAR/fmax(1.0f32-d*299.95f32/300.0f32,0.000001f32);}
cv_srgb_linear :: (x:f32)->f32 {return ifx x<=0.04045 then x/12.92 else pow((x+0.055)/1.055,2.4f32);}
cv_light_at :: (t:Tex2D,p:I2,size:U2)->V3 {q:=i2(clamp_s(p.x,0,cast(s32)size.x-1),clamp_s(p.y,0,cast(s32)size.y-1));c:=wg_load_2d(t,q,0);return v3(cv_srgb_linear(c.x),cv_srgb_linear(c.y),cv_srgb_linear(c.z));}
clamp_s :: (x:s32,a:s32,b:s32)->s32 {if x<a {return a;}if x>b {return b;}return x;}
// The thin-lens circle of confusion's radius in target pixels: f^2/N |z-zf| / (z (zf-f)) on a filmback
// SLAY_SENSOR_WIDTH wide, spread over the target's width. u[128] focus (m), u[129] N, u[130] f (m).
CV_SENSOR :: 0.02489f32;
CV_DOF_MAX :: 14.0f32;
cv_coc :: (z:f32,u:[]f32,width:f32)->f32 {
 f:=u[130];zf:=u[128];if u[129]<=0 || f<=0 || zf<=f {return 0;}
 c:=f*f/u[129]*abs(z-zf)/(z*(zf-f));return fmin(0.5*c/CV_SENSOR*width,CV_DOF_MAX*width/1280.0f32);
}
#test "TF0290's lens blurs the face a little and the temple a lot" {
 u:[136]f32;u[128]=1.15;u[129]=2.4;u[130]=0.04;
 face:=cv_coc(1.32,u[..],1280);far:=cv_coc(5,u[..],1280);#assert face>1.5 && face<2.5 && far>10 && far<CV_DOF_MAX && cv_coc(1.15,u[..],1280)==0;
 #assert abs(cv_view_z(300.0f32/299.95f32*(1-CV_NEAR/1.32))-1.32)<0.001;
}
CV_GOLDEN :: 2.39996323f32;
CV_DOF_TAPS :: 48;
// Skin's subsurface blur, per channel (Gaussian sigma in mm on the face): red carries farthest.
CV_SSS_R :: 1.6f32;
CV_SSS_G :: 0.75f32;
CV_SSS_B :: 0.4f32;
// The depth the lens sees at q: the depth buffer, or blended hair in front of it.
cv_post_z :: (depth:TexDepth,aux:Tex2D,q:I2)->f32 {zd:=cv_view_z(wg_load_depth(depth,q,0));a:=wg_load_2d(aux,q,0);if a.z>0.02 {return fmin(zd,a.y/a.z);}return zd;}
vc_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
 px:=i2(wg_i32_f(pos.x),wg_i32_f(pos.y));size:=wg_dims_2d(post_light);width:=cast(f32)size.x;
 raw:=wg_load_2d(post_light,px,0);
 // K: the coverage matte for laying Echo over another page's frame (aux.z: 1 under geometry).
 if u[131]>0.5 {m:=clampf(wg_load_2d(post_aux,px,0).z,0.0f32,1.0f32);return v4(m,m,m,1);}
 if u[112]<0.5 || u[129]<=0 {return v4(raw.x,raw.y,raw.z,1);}
 zc:=cv_post_z(post_depth,post_aux,px);rc:=cv_coc(zc,u,width);centre:=cv_light_at(post_light,px,size);
 skin:=wg_load_2d(post_aux,px,0).x;
 if skin>0.01 {
  // Depth-aware Gaussian over the neighbouring skin: mm to pixels from the lens at this depth.
  per_mm:=0.001*u[130]/CV_SENSOR*width/zc;reach:=fmin(3.0f32*CV_SSS_R*per_mm,12.0f32);
  sum:=centre;wr:f32=1;wgt:f32=1;wb:f32=1;
  for k:0..<24 {r:=reach*sqrt((cast(f32)k+0.5)/24.0f32);a:=cast(f32)k*CV_GOLDEN;q:=i2(px.x+wg_i32_f(r*cos(a)+0.5),px.y+wg_i32_f(r*sin(a)+0.5));
   q=i2(clamp_s(q.x,0,cast(s32)size.x-1),clamp_s(q.y,0,cast(s32)size.y-1));
   if wg_load_2d(post_aux,q,0).x<0.5 || abs(cv_view_z(wg_load_depth(post_depth,q,0))-zc)>0.012 {continue;}
   c:=cv_light_at(post_light,q,size);mm:=r/per_mm;
   kr:=exp(-mm*mm/(2*CV_SSS_R*CV_SSS_R));kg:=exp(-mm*mm/(2*CV_SSS_G*CV_SSS_G));kb:=exp(-mm*mm/(2*CV_SSS_B*CV_SSS_B));
   sum=v3(sum.x+c.x*kr,sum.y+c.y*kg,sum.z+c.z*kb);wr+=kr;wgt+=kg;wb+=kb;}
  blurred:=v3(sum.x/wr,sum.y/wgt,sum.z/wb);centre=cv_add(cv_scale(centre,1-skin),cv_scale(blurred,skin));
 }
 // Gustafsson's single-pass bokeh gather: each tap counts where its own circle reaches this pixel;
 // taps behind the centre may not blur more than twice the centre's circle (no background bleeding).
 reach:=rc;for k:0..<8 {a:=cast(f32)k*0.785398;q:=i2(px.x+wg_i32_f(cos(a)*CV_DOF_MAX),px.y+wg_i32_f(sin(a)*CV_DOF_MAX));q=i2(clamp_s(q.x,0,cast(s32)size.x-1),clamp_s(q.y,0,cast(s32)size.y-1));z:=cv_post_z(post_depth,post_aux,q);if z<zc {reach=fmax(reach,cv_coc(z,u,width));}}
 colour:=centre;
 if reach>0.5 {
  total:f32=1;
  for k:0..<CV_DOF_TAPS {r:=reach*sqrt((cast(f32)k+0.5)/cast(f32)CV_DOF_TAPS);a:=cast(f32)k*CV_GOLDEN;q:=i2(clamp_s(px.x+wg_i32_f(r*cos(a)+0.5),0,cast(s32)size.x-1),clamp_s(px.y+wg_i32_f(r*sin(a)+0.5),0,cast(s32)size.y-1));
   z:=cv_post_z(post_depth,post_aux,q);sz:=cv_coc(z,u,width);if z>zc {sz=fmin(sz,rc*2);}
   m:=smoothstep(r-0.5,r+0.5,sz);c:=cv_light_at(post_light,q,size);mean:=cv_scale(colour,1/total);
   colour=cv_add(colour,cv_add(cv_scale(mean,1-m),cv_scale(c,m)));total+=1;}
  colour=cv_scale(colour,1/total);
 }
 return v4(cv_srgb(clampf(colour.x,0.0f32,1.0f32)),cv_srgb(clampf(colour.y,0.0f32,1.0f32)),cv_srgb(clampf(colour.z,0.0f32,1.0f32)),1);
}
