// Valley Lab source pair: actual source normals/UV/paint, 4K maps and shared shadow effects.
#load "splash.coax";
#load "../../../aethyr/render/sampling.coax";
#load "../../../verse/valley/echo-materials.coax";
#load "../../../aethyr/render/pbr-env.coax";
#load "../../../aethyr/render/filmic.coax";
cv_at :: (u:[]f32,at:int)->V3 {return v3(u[at],u[at+1],u[at+2]);}
cv_add :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
cv_sub :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
cv_scale :: (a:V3,k:f32)->V3 {return v3(a.x*k,a.y*k,a.z*k);}
cv_word :: (vertices:[]u32,at:int)->f32 {return f32_from_bits(vertices[at]);}
ECHO_VERTEX_WORD :: 6052916;
ECHO_MATERIAL_WORD :: 6052404;
ECHO_GROOM_WORD :: 13573820;
cv_head :: (p:V3,u:[]f32,bones:[]f32)->V3 {b:=82*12;q:=v4(p.x,p.y,p.z,1);local:=v3(wg_dot4(wg_at4(bones,b),q),wg_dot4(wg_at4(bones,b+4),q),wg_dot4(wg_at4(bones,b+8),q));return cv_add(cv_at(u,104),cv_echo_direction(local,u));}
GroomVertex :: struct {world:V3;normal:V3;tangent:V3;uv:V2;material:f32;coverage:f32;edge:f32;}
#test "Groom ribbons form two consistent triangles per original curve segment" {#assert cv_groom_endpoint(0)==0 && cv_groom_endpoint(1)==0 && cv_groom_endpoint(2)==1 && cv_groom_endpoint(3)==1 && cv_groom_endpoint(4)==0 && cv_groom_endpoint(5)==1;#assert cv_groom_side(0)== -1 && cv_groom_side(1)==1 && cv_groom_side(2)== -1 && cv_groom_side(3)== -1 && cv_groom_side(4)==1 && cv_groom_side(5)==1;}
cv_groom_endpoint :: (vertex:int)->int {return ifx vertex==2 || vertex==3 || vertex==5 then 1 else 0;}
cv_groom_side :: (vertex:int)->f32 {return ifx vertex==0 || vertex==2 || vertex==3 then -1.0f32 else 1.0f32;}
cv_groom :: (id:u32,vertices:[]u32,u:[]f32,bones:[]f32)->GroomVertex {
 vertex:=cast(int)id-1000000;at:=ECHO_GROOM_WORD+8+(vertex/6)*12;endpoint:=cv_groom_endpoint(vertex%6);p0:=cv_head(v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2)),u,bones);p1:=cv_head(v3(cv_word(vertices,at+4),cv_word(vertices,at+5),cv_word(vertices,at+6)),u,bones);p:=ifx endpoint==0 then p0 else p1;t:=wg_normalize3(cv_sub(p1,p0));view:=wg_normalize3(cv_sub(cv_at(u,8),p));side:=wg_normalize3(wg_cross3(t,view));radius:=cv_word(vertices,at+endpoint*4+3);z:=fmax(0.05f32,wg_dot3(cv_sub(p,cv_at(u,8)),cv_at(u,20)));expanded:=fmax(radius,z/(u[19]*u[1]));edge:=cv_groom_side(vertex%6);world:=cv_add(p,cv_scale(side,expanded*edge));return GroomVertex.{world=world,normal=wg_normalize3(wg_cross3(side,t)),tangent=t,uv=v2(cv_word(vertices,at+8+endpoint),cv_word(vertices,at+10)),material=cast(f32)vertices[at+11],coverage=radius/expanded,edge=edge};
}
cv_skin :: (id:u32,p:V4,vertices:[]u32,bones:[]f32)->V3 {
 at:=ECHO_VERTEX_WORD+(cast(int)id-504367)*24;out:=v3(0,0,0);sum:f32=0;
 for k:0..<8 {joint:=cast(int)((vertices[at+9+k/2]>>cast(u32)((k%2)*16))&65535);weight:=cast(f32)((vertices[at+13+k/4]>>cast(u32)((k%4)*8))&255)/255;
  if weight>0 && joint<334 {b:=joint*12;q:=v3(wg_dot4(wg_at4(bones,b),p),wg_dot4(wg_at4(bones,b+4),p),wg_dot4(wg_at4(bones,b+8),p));out=cv_add(out,cv_scale(q,weight));sum+=weight;}}
 return cv_scale(out,1/fmax(sum,0.00001f32));
}
cv_echo_direction :: (p:V3,u:[]f32)->V3 {return v3(u[108]*p.x+u[109]*p.z,p.y,-u[109]*p.x+u[108]*p.z);}
cv_world :: (id:u32,instance:u32,vertices:[]u32,u:[]f32,bones:[]f32)->V3 {
 if id>=1000000 {return cv_groom(id,vertices,u,bones).world;}
 if instance==2 {at:=ECHO_VERTEX_WORD+(cast(int)id-504367)*24;p:=v4(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2),1);return cv_add(cv_at(u,104),cv_echo_direction(cv_skin(id,p,vertices,bones),u));}
 at:=cast(int)id*12;p:=v4(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2),1);m:=32+cast(int)instance*24;return v3(wg_dot4(wg_at4(u,m),p),wg_dot4(wg_at4(u,m+4),p),wg_dot4(wg_at4(u,m+8),p));
}
cv_shadow :: (world:V3,u:[]f32)->V3 {p:=cv_sub(world,cv_at(u,92));return v3(wg_dot3(p,cv_at(u,80))/u[96],wg_dot3(p,cv_at(u,84))/u[96],0.5-wg_dot3(p,cv_at(u,88))/(4*u[96]));}
vc_bg_vs :: (i:u32,j:u32)->V4 {return splash_bg_vs(i,j);}
// An explicit metre grid on the inspection floor, below every source bound. The original scene's terrain is not included.
vc_bg_fs :: (p:V4,u:[]f32)->V4 {
  if u[110]>0.5 {return v4(0,0,0,1);}
  sky:=v3(0.065,0.075,0.09);if u[7]<0.5 {return v4(sky.x,sky.y,sky.z,1);}
  ray:=cv_add(cv_at(u,20),cv_add(cv_scale(cv_at(u,12),(p.x/u[0]*2-1)/u[15]),cv_scale(cv_at(u,16),(1-p.y/u[1]*2)/u[19])));
  if ray.y>=-0.0001 {return v4(sky.x,sky.y,sky.z,1);}t:=(u[100]-u[9])/ray.y;if t<=0 {return v4(sky.x,sky.y,sky.z,1);}
  at:=cv_add(cv_at(u,8),cv_scale(ray,t));fx:=abs(at.x-floor(at.x+0.5));fz:=abs(at.z-floor(at.z+0.5));line:=ifx fx<0.025 || fz<0.025 then 0.08f32 else 0.0f32;
  fade:=1.0f32/(1.0f32+t*0.025f32);c:=cv_add(cv_scale(v3(0.16+line,0.15+line,0.13+line),fade),cv_scale(sky,1-fade));return v4(c.x,c.y,c.z,1);
}
vc_vertex :: struct {a:V4;b:V4;c:V4;}
vc_fx_vs :: (i:u32,j:u32,a:vc_vertex,u:[]f32)->SplashV {return splash_fx_vs(i,j,splash_fx_vs_in.{a=a.a,b=a.b,c=a.c,d=v4(0,0,0,0)},u);}
vc_fx_fs :: (v:SplashV,u:[]f32)->V4 {return splash_fx_fs(v,u);}
CanyonSurface :: struct {pos:V4;world:V3;normal:V3;uv:V2;paint:V4;tangent:V4;character:f32;material:f32;}
vc_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonSurface {
 world:=cv_world(id,instance,vertices,u,bones);at:=cast(int)id*12;normal:=v3(0,1,0);uv:=v2(0,0);paint:=v4(1,1,1,1);tangent:=v4(0,0,0,1);material:f32=0;character:f32=0;
 if id>=1000000 {groom:=cv_groom(id,vertices,u,bones);normal=groom.normal;tangent=v4(groom.tangent.x,groom.tangent.y,groom.tangent.z,1);uv=groom.uv;paint=v4(groom.coverage,groom.edge,1,1);character=1;material=groom.material;}
 else if instance==2 {at=ECHO_VERTEX_WORD+(cast(int)id-504367)*24;normal=cv_echo_direction(cv_skin(id,v4(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5),0),vertices,bones),u);t:=cv_echo_direction(cv_skin(id,v4(cv_word(vertices,at+15),cv_word(vertices,at+16),cv_word(vertices,at+17),0),vertices,bones),u);tangent=v4(t.x,t.y,t.z,cv_word(vertices,at+18));character=1;material=cast(f32)vertices[at+8];}
 else {n:=v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5));m:=44+cast(int)instance*24;normal=v3(wg_dot3(cv_at(u,m),n),wg_dot3(cv_at(u,m+4),n),wg_dot3(cv_at(u,m+8),n));paint=wg_unpack4x8unorm(vertices[at+8]);}
 if id<1000000 {uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));}r:=cv_sub(world,cv_at(u,8));z:=wg_dot3(r,cv_at(u,20));return CanyonSurface.{pos=v4(wg_dot3(r,cv_at(u,12))*u[15],wg_dot3(r,cv_at(u,16))*u[19],300.0/299.95*(z-0.05),z),world=world,normal=normal,uv=uv,paint=paint,tangent=tangent,character=character,material=material};
}
CanyonShadow :: struct {pos:V4;uv:V2;character:f32;material:f32;}
vc_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonShadow {
 q:=cv_shadow(cv_world(id,instance,vertices,u,bones),u);uv:=v2(0,0);material:f32=0;if id>=1000000 {groom:=cv_groom(id,vertices,u,bones);uv=groom.uv;material=groom.material;}else if instance==2 {at:=ECHO_VERTEX_WORD+(cast(int)id-504367)*24;uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));material=cast(f32)vertices[at+8];}return CanyonShadow.{pos=v4(q.x,q.y,q.z,1),uv=uv,character=ifx instance==2 then 1.0f32 else 0.0f32,material=material};
}
cv_echo_mask :: (uv:V2,material:f32,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,dx:V2,dy:V2) {
 if material==ECHO_LASH_SLOT {if cv_echo_lash_mask(uv)<0.3333 {gpu_discard();}return;}
 m:=ECHO_MATERIAL_WORD+cast(int)material*16;if vertices[m+9]!=0 {gpu_discard();}alpha:=cast(int)vertices[m+3]-1;if alpha>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)alpha,dx,dy,0);if cv_srgb(a.x)<0.333333 {gpu_discard();}}
}
vc_shadow_fs :: (s:CanyonShadow,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler) {dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));if s.character>0.5 {cv_echo_mask(s.uv,s.material,vertices,sheets,sheet,dx,dy);}}
cv_srgb :: (x:f32)->f32 {return ifx x<=0.0031308 then 12.92*x else 1.055*pow(x,1.0f32/2.4f32)-0.055;}
cv_tone :: (x:f32)->f32 {return cv_srgb(fmin(1.0f32,(x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14)));}
#test "Echo source face graph applies instance colour multiplier desaturation contrast and tint" {
 c:=cv_echo_head_colour(v3(0.2,0.1,0.05));
 // UE Desaturation luminance factors (0.3,0.59,0.11), then CheapContrast_RGB(-0.02).
 #assert abs(c.x-0.417384)<0.000001 && abs(c.y-0.27176)<0.000001 && abs(c.z-0.1667997552)<0.000001;
 #assert cv_echo_head_colour(v3(10,10,10)).x==0.9;
 b:=cv_echo_body_colour(v3(0.2,0.1,0.05));#assert abs(b.x-0.18)<0.000001 && abs(b.y-0.1164215)<0.000001 && b.z==0.0625;
}
// M_Head_Echo: texture * Color_Mult -> Desaturation -> CheapContrast_RGB -> Tint.
// M_Head_Echo_Inst overrides 2.5, 0.2, -0.02 and (0.9,1,0.949020).
cv_echo_head_colour :: (a:V3)->V3 {
 c:=cv_scale(a,2.5);l:=c.x*0.3+c.y*0.59+c.z*0.11;
 return v3(clampf((c.x*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.9,clampf((c.y*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32),clampf((c.z*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.949020);
}
cv_echo_body_colour :: (a:V3)->V3 {return v3(a.x*0.9,a.y*1.164215,a.z*1.25);}
#test "Character material override uses original collection gain four gamma 1.2 and instance rolloff" {c:=cv_echo_overrides(v3(0.1,0.05,0.02),0.7,0.07);#assert abs(c.x-0.318432139)<0.000002 && abs(c.y-0.185325344)<0.000002 && abs(c.z-0.094407422)<0.000002;#assert cv_echo_overrides(v3(0,0,0),0.7,0.07).x==0;}
// MF_CharacterMaterialOverrides + MPC_CharacterAlbedo: gain 4, gamma 1.2,
// identity YCoCg Low/High, per-channel MinValue=0/Rolloff, then Desaturation.
cv_echo_overrides :: (base:V3,rolloff:f32,desat:f32)->V3 {c:=v3(pow(fmax(0.0f32,base.x*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.y*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.z*4),1.0f32/1.2f32)*rolloff);l:=wg_dot3(c,v3(0.3,0.59,0.11));return cv_add(cv_scale(c,1-desat),v3(l*desat,l*desat,l*desat));}
cv_echo_core_material :: (m:f32)->bool {return m==0 || m==1 || m==2 || m==4 || m==5 || m==6 || m==8 || m==13 || m==15 || m==23 || m==25;}
#test "Source angle corrected normal blend preserves either flat input" {a:=v3(0.2,0.1,0.9746794);b:=cv_echo_normal_blend(a,v3(0,0,1));#assert abs(a.x-b.x)<0.000001 && abs(a.z-b.z)<0.000001;b=cv_echo_normal_blend(v3(0,0,1),a);#assert abs(a.y-b.y)<0.000001 && abs(a.z-b.z)<0.000001;}
cv_echo_normal_blend :: (base:V3,detail:V3)->V3 {t:=v3(base.x,base.y,base.z+1);d:=v3(-detail.x,-detail.y,detail.z);return cv_sub(cv_scale(t,wg_dot3(t,d)/t.z),d);}
cv_echo_normal :: (a:V4,strength:f32)->V3 {return v3((cv_srgb(a.x)*2-1)*strength,(1-cv_srgb(a.y)*2)*strength,cv_srgb(a.z)*2-1);}
#test "Source groom colours retain the demo's brown root tip and pepper settings" {c:=cv_echo_groom_colour(0,0.5);#assert abs(c.x-0.08125)<0.000001 && abs(c.z-0.0284375)<0.000001;p:=cv_echo_groom_colour(0.5,0.1);#assert p.x==0.201556 && p.y==0.125356 && p.z==0.070545;}
cv_echo_groom_colour :: (u:f32,seed:f32)->V3 {if seed<0.15 {return v3(0.201556,0.125356,0.070545);}brightness:=ifx seed<1.0f32/3 then mix(0.4f32,0.15f32,seed*3) else ifx seed<2.0f32/3 then mix(0.15f32,0.5f32,seed*3-1) else mix(0.5f32,0.0f32,seed*3-2);return cv_scale(v3(mix(0.25f32,0.234375f32,u),mix(0.154883f32,0.164421f32,u),mix(0.0875f32,0.105469f32,u)),brightness);}
// The source eye's "Scale Pupils" node, at the instance's PupilScale=0.75.
#test "Eye pupil scaling retains centre and rim and source corner shadow bounds" {c:=cv_echo_pupil(v2(0.5,0.5));#assert c.x==0.5 && c.y==0.5;r:=cv_echo_pupil(v2(1,0.5));#assert r.x==1 && r.y==0.5;#assert cv_echo_eye_shadow(0)==1 && cv_echo_eye_shadow(0.35)==0;}
cv_echo_pupil :: (uv:V2)->V2 {x:=uv.x-0.5;y:=uv.y-0.5;r:=sqrt(x*x+y*y);if r<0.000001 {return v2(0.5,0.5);}k:=0.5/r*(1-clampf((1-r*2)*0.75,0.0f32,1.0f32));return v2(x*k+0.5,y*k+0.5);}
cv_echo_eye_shadow :: (radius:f32)->f32 {return clampf((1-radius/0.345)/(1-0.535610),0.0f32,1.0f32);}
#test "Original lash opacity tapers to the root and preserves the central tip" {#assert cv_echo_lash_mask(v2(0.5,1))==1 && cv_echo_lash_mask(v2(0.5,0))==0;#assert abs(cv_echo_lash_mask(v2(0,1))-0.35355339)<0.000001;}
cv_echo_lash_mask :: (uv:V2)->f32 {return pow(fmax(0.0f32,1-abs(uv.x-0.5)),1.5f32)*pow(fmax(0.0f32,uv.y),0.45f32);}
#test "Canyon material helpers retain linear roughness and bounded filmic response" {#assert abs(cv_srgb(0.21404114)-0.5)<0.00001;#assert cv_tone(0)==0 && cv_tone(1)>0.9 && cv_tone(100)<=1;}
vc_scene_fs :: (s:CanyonSurface,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));
  n:=wg_normalize3(s.normal);albedo:=v3(1,1,1);rough:f32=0.65;metal:f32=0;
  if s.material>=26 {noise:=sin(floor(s.pos.x)*12.9898+floor(s.pos.y)*78.233+s.uv.y*437.0)*43758.5453;threshold:=noise-floor(noise);if s.paint.x*(1-abs(s.paint.y)*0.25)<threshold {gpu_discard();}}
  if s.character>0.5 {cv_echo_mask(s.uv,s.material,vertices,sheets,sheet,dx,dy);m:=ECHO_MATERIAL_WORD+cast(int)s.material*16;albedo=v3(cv_word(vertices,m+4),cv_word(vertices,m+5),cv_word(vertices,m+6));rough=cv_word(vertices,m+8);metal=cv_word(vertices,m+7);colour:=cast(int)vertices[m]-1;normal_map:=cast(int)vertices[m+1]-1;orm:=cast(int)vertices[m+2]-1;
   if colour>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)colour,dx,dy,0);albedo=v3(albedo.x*a.x,albedo.y*a.y,albedo.z*a.z);}if orm>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)orm,dx,dy,0);rough=cv_srgb(a.y);metal=cv_srgb(a.z);}
   if s.material>=26 {albedo=cv_echo_groom_colour(s.uv.x,s.uv.y);metal=0;rough=mix(0.32f32,0.45f32,s.uv.y)*(1+0.1*s.uv.x);}
   if s.material==ECHO_LASH_SLOT {albedo=cv_scale(v3(mix(0.08f32,0.16f32,s.uv.y),mix(0.053397f32,0.090834f32,s.uv.y),mix(0.04f32,0.056f32,s.uv.y)),0.5);rough=0.6;metal=0;}
   if s.material==ECHO_HEAD_SLOT {albedo=cv_echo_head_colour(albedo);metal=0;macro:=render_sample_layer8_grad(sheets,sheet,s.uv,26,dx,dy,0);additional:=render_sample_layer8_grad(sheets,sheet,s.uv,27,dx,dy,0);rough=macro.x+rough*0.2+additional.x;}
   if s.material==ECHO_SKIN_SLOT {albedo=cv_echo_body_colour(albedo);rough=rough*0.2+0.45*0.8;metal=0;}
   if s.material==ECHO_EYE_LEFT_SLOT || s.material==ECHO_EYE_RIGHT_SLOT {x:=s.uv.x-0.5;y:=s.uv.y-0.5;r:=sqrt(x*x+y*y);iris_uv:=cv_echo_pupil(v2(x/0.3+0.5,y/0.3+0.5));iris:=render_sample_layer8_grad(sheets,sheet,iris_uv,9,cv_scale2(dx,1/0.3),cv_scale2(dy,1/0.3),0);mask:=1-smoothstep(0.115f32,0.15f32,r);limbus:=1-pow(fmin(1.0f32,sqrt((iris_uv.x-0.5)*(iris_uv.x-0.5)+(iris_uv.y-0.5)*(iris_uv.y-0.5))*2.15),8.0f32);ic:=v3(pow(iris.x*0.723055*1.4*2,1.1f32),pow(iris.y*0.644480*1.4*2,1.1f32),pow(iris.z*0.623960*1.4*2,1.1f32));sclera:=v3(albedo.x*0.541667,albedo.y*0.494239,albedo.z*0.460880);albedo=cv_add(cv_scale(sclera,1-mask),cv_scale(ic,mask*limbus));corner:=cv_echo_eye_shadow(r);albedo=v3(albedo.x*mix(0.23f32,1.0f32,corner)*1.4,albedo.y*mix(0.083042f32,1.0f32,corner)*1.4,albedo.z*mix(0.031906f32,1.0f32,corner)*1.4);}
   if normal_map>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)normal_map,dx,dy,0);strength:=ifx s.material==ECHO_HEAD_SLOT then 0.65f32 else ifx s.material==ECHO_SKIN_SLOT then 1.0f32 else ifx s.material==5 || s.material==13 then 0.7f32 else ifx cv_echo_core_material(s.material) then 0.65f32 else 1.0f32;map:=cv_echo_normal(a,strength);
    if s.material==ECHO_HEAD_SLOT {micro:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,s.uv,28,dx,dy,0),1);view:=wg_normalize3(cv_sub(cv_at(u,8),s.world));fresnel:=pow(1-fmax(0.0f32,wg_dot3(n,view)),3.0f32);amount:=0.5+fresnel;detail:=cv_add(cv_scale(v3(0,0,1),1-amount),cv_scale(micro,amount));detail=v3(detail.x*0.75,detail.y*0.75,detail.z);map=cv_echo_normal_blend(map,detail);brow:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,s.uv,29,dx,dy,0),0.1);mask:=render_sample_layer8_grad(sheets,sheet,s.uv,30,dx,dy,0).x;map=cv_add(cv_scale(map,1-mask),cv_scale(brow,mask));}
    t:=wg_normalize3(v3(s.tangent.x,s.tangent.y,s.tangent.z));b:=cv_scale(wg_cross3(n,t),s.tangent.w);n=wg_normalize3(cv_add(cv_scale(t,map.x),cv_add(cv_scale(b,map.y),cv_scale(n,map.z))));}
   if cv_echo_core_material(s.material) {material:=s.material;view:=wg_normalize3(cv_sub(cv_at(u,8),s.world));nv:=clampf(wg_dot3(n,view),0.0f32,1.0f32);fuzzy:f32=1;
    if material==2 || material==23 {fuzzy=1-0.1*nv;}if material==5 || material==13 {fuzzy=mix(1.0f32,1-0.15*nv+pow(1-nv,1.8f32),smoothstep(0.97f32,0.98f32,nv));}
    mult:=ifx material==1 || material==15 then 0.6f32 else 1.0f32;gamma:=ifx material==8 then 1.1f32 else ifx material==5 || material==13 then 1.05f32 else 1.0f32;albedo=v3(pow(fmax(0.0f32,albedo.x*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.y*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.z*fuzzy*mult),1/gamma));rolloff:=ifx material==5 || material==13 || material==8 then 0.6f32 else 0.7f32;desat:=ifx material==6 then 0.07f32 else ifx material==2 || material==23 || material==8 then 0.1f32 else 0.05f32;albedo=cv_echo_overrides(albedo,rolloff,desat);
    if material==0 {rough=rough*0.6+0.095238;}if material==1 || material==15 {rough*=0.721429;}if material==8 {rough*=0.883333;}if material==5 || material==13 {rough*=0.857451;}
   }
  }else {a:=render_sample_layer8_grad(sheets,sheet,s.uv,0,dx,dy,0);albedo=cv_scale(v3(a.x,a.y,a.z),u[6]);rough=cv_srgb(render_sample_layer8_grad(sheets,sheet,s.uv,1,dx,dy,0).x);}rough=clampf(rough,0.045f32,1.0f32);
  if u[4]>0.5 && u[4]<1.5 {return v4(cv_srgb(albedo.x),cv_srgb(albedo.y),cv_srgb(albedo.z),1);}
  if u[4]>1.5 && u[4]<2.5 {return v4(n.x*0.5+0.5,n.y*0.5+0.5,n.z*0.5+0.5,1);}
  if u[4]>2.5 && u[4]<3.5 {return v4(rough,rough,rough,1);}if u[4]>3.5 {return v4(s.paint.x,s.paint.y,s.paint.z,1);}
  l:=cv_at(u,24);v:=wg_normalize3(cv_sub(cv_at(u,8),s.world));halfway:=wg_normalize3(cv_add(l,v));nl:=fmax(0.0f32,wg_dot3(n,l));nv:=fmax(0.0001f32,wg_dot3(n,v));nh:=fmax(0.0f32,wg_dot3(n,halfway));vh:=fmax(0.0f32,wg_dot3(v,halfway));alpha:=rough*rough;aa:=alpha*alpha;den:=nh*nh*(aa-1)+1;distribution:=aa/(3.14159265*den*den);k:=(rough+1)*(rough+1)/8;g:=nv/(nv*(1-k)+k)*nl/(nl*(1-k)+k);dielectric:=ifx s.material>=26 then mix(0.004f32,0.008f32,s.uv.y) else 0.04f32;f0:=v3(mix(dielectric,albedo.x,metal),mix(dielectric,albedo.y,metal),mix(dielectric,albedo.z,metal));fresnel:=pow(1-vh,5.0f32);spec:=cv_scale(v3(f0.x+(1-f0.x)*fresnel,f0.y+(1-f0.y)*fresnel,f0.z+(1-f0.z)*fresnel),distribution*g/(4*nv*fmax(nl,0.0001f32)));
  q:=cv_shadow(s.world,u);shadow:f32=1;if abs(q.x)<1 && abs(q.y)<1 && q.z>0 && q.z<1 {shadow=gpu_compare(shadow_map,shadow_cmp,v2(q.x*0.5+0.5,0.5-q.y*0.5),q.z-0.00015);}
  ambient:=ifx s.character>0.5 then 0.7734375f32 else 0.16f32+0.12f32*(n.y*0.5f32+0.5f32);direct:=nl*shadow*3.5;colour:=cv_add(cv_scale(albedo,ambient*(1-metal)+direct*(1-metal)/3.14159265),cv_scale(spec,direct));
  if s.character>0.5 && s.material<26 {environment:=pbr_environment(rough,nv);f90:=clampf(50*f0.y,0.0f32,1.0f32);colour=cv_add(colour,cv_scale(cv_add(cv_scale(f0,environment.a),v3(f90*environment.b,f90*environment.b,f90*environment.b)),0.7734375));}
  if s.character>0.5 {mapped:=film_rec709(film_rgb(colour.x,colour.y,colour.z));return v4(cv_srgb(clampf(mapped.r,0.0f32,1.0f32)),cv_srgb(clampf(mapped.g,0.0f32,1.0f32)),cv_srgb(clampf(mapped.b,0.0f32,1.0f32)),1);}
  return v4(cv_tone(colour.x),cv_tone(colour.y),cv_tone(colour.z),1);
}
cv_scale2 :: (a:V2,k:f32)->V2 {return v2(a.x*k,a.y*k);}
