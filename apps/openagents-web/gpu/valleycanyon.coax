// Valley Lab source pair: actual source normals/UV/paint, 4K maps and shared shadow effects.
#load "splash.coax";
#load "../../../aethyr/render/sampling.coax";
#load "../../../verse/valley/echo-materials.coax";
#load "../../../aethyr/render/pbr-env.coax";
#load "../../../aethyr/render/filmic.coax";
#load "../../../aethyr/anim/morph-gpu.coax";
#load "../../../verse/valley/slay-orb.coax";
#load "../../../verse/valley/slay-lights.coax";
#load "../../../aethyr/render/hair-fiber.coax";
cv_at :: (u:[]f32,at:int)->V3 {return v3(u[at],u[at+1],u[at+2]);}
cv_add :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
cv_sub :: (a:V3,b:V3)->V3 {return v3(a.x-b.x,a.y-b.y,a.z-b.z);}
cv_scale :: (a:V3,k:f32)->V3 {return v3(a.x*k,a.y*k,a.z*k);}
cv_word :: (vertices:[]u32,at:int)->f32 {return f32_from_bits(vertices[at]);}
ECHO_VERTEX_WORD :: 6052916;
ECHO_MATERIAL_WORD :: 6052404;
ECHO_GROOM_WORD :: 13573820;
cv_vertex_at :: (id:u32,vertices:[]u32)->int {return ifx id>=980000 then cast(int)vertices[ECHO_MATERIAL_WORD+31*16+1]+(cast(int)id-980000)*24 else ifx id>=900000 then cast(int)vertices[ECHO_MATERIAL_WORD+31*16]+(cast(int)id-900000)*24 else ECHO_VERTEX_WORD+(cast(int)id-504367)*24;}
cv_morph :: (id:u32,vertices:[]u32,bones:[]f32,u:[]f32)->MorphVertex {
 at:=cv_vertex_at(id,vertices);p:=v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2));n:=v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5));
 if u[111]<0.5 {return MorphVertex.{position=p,normal=n};}
 return morph_gpu(p,n,vertices,cast(int)vertices[ECHO_MATERIAL_WORD+30*16],cast(int)vertices[at+20],cast(int)vertices[at+21],bones,4008,cast(int)vertices[ECHO_MATERIAL_WORD+30*16+1]);
}
cv_head :: (p:V3,u:[]f32,bones:[]f32)->V3 {b:=82*12;q:=v4(p.x,p.y,p.z,1);local:=v3(wg_dot4(wg_at4(bones,b),q),wg_dot4(wg_at4(bones,b+4),q),wg_dot4(wg_at4(bones,b+8),q));return cv_add(cv_at(u,104),cv_echo_direction(local,u));}
GroomVertex :: struct {world:V3;normal:V3;tangent:V3;uv:V2;material:f32;coverage:f32;edge:f32;}
#test "Groom ribbons form two consistent triangles per original curve segment" {#assert cv_groom_endpoint(0)==0 && cv_groom_endpoint(1)==0 && cv_groom_endpoint(2)==1 && cv_groom_endpoint(3)==1 && cv_groom_endpoint(4)==0 && cv_groom_endpoint(5)==1;#assert cv_groom_side(0)== -1 && cv_groom_side(1)==1 && cv_groom_side(2)== -1 && cv_groom_side(3)== -1 && cv_groom_side(4)==1 && cv_groom_side(5)==1;}
#test "Strand colour coverage preserves the former stochastic expectation continuously" {#assert cv_groom_opacity(0.5,0)==0.5 && cv_groom_opacity(0.5,1)==0.375 && cv_groom_opacity(0,0)==0 && cv_groom_opacity(2,0)==1;}
cv_groom_opacity :: (coverage:f32,edge:f32)->f32 {return clampf(coverage*(1-abs(edge)*0.25),0.0f32,1.0f32);}
cv_groom_endpoint :: (vertex:int)->int {return ifx vertex==2 || vertex==3 || vertex==5 then 1 else 0;}
cv_groom_side :: (vertex:int)->f32 {return ifx vertex==0 || vertex==2 || vertex==3 then -1.0f32 else 1.0f32;}
cv_groom :: (id:u32,vertices:[]u32,u:[]f32,bones:[]f32)->GroomVertex {
 vertex:=cast(int)id-1000000;at:=ECHO_GROOM_WORD+8+(vertex/6)*12;endpoint:=cv_groom_endpoint(vertex%6);p0:=cv_head(v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2)),u,bones);p1:=cv_head(v3(cv_word(vertices,at+4),cv_word(vertices,at+5),cv_word(vertices,at+6)),u,bones);p:=ifx endpoint==0 then p0 else p1;t:=wg_normalize3(cv_sub(p1,p0));view:=wg_normalize3(cv_sub(cv_at(u,8),p));side:=wg_normalize3(wg_cross3(t,view));radius:=cv_word(vertices,at+endpoint*4+3);z:=fmax(0.05f32,wg_dot3(cv_sub(p,cv_at(u,8)),cv_at(u,20)));expanded:=fmax(radius,z/(u[19]*u[1]));edge:=cv_groom_side(vertex%6);world:=cv_add(p,cv_scale(side,expanded*edge));return GroomVertex.{world=world,normal=wg_normalize3(wg_cross3(side,t)),tangent=t,uv=v2(cv_word(vertices,at+8+endpoint),cv_word(vertices,at+10)),material=cast(f32)vertices[at+11],coverage=radius/expanded,edge=edge};
}
cv_skin :: (id:u32,p:V4,vertices:[]u32,bones:[]f32)->V3 {
 at:=cv_vertex_at(id,vertices);out:=v3(0,0,0);sum:f32=0;
 for k:0..<8 {joint:=cast(int)((vertices[at+9+k/2]>>cast(u32)((k%2)*16))&65535);weight:=cast(f32)((vertices[at+13+k/4]>>cast(u32)((k%4)*8))&255)/255;
  if weight>0 && joint<334 {b:=joint*12;q:=v3(wg_dot4(wg_at4(bones,b),p),wg_dot4(wg_at4(bones,b+4),p),wg_dot4(wg_at4(bones,b+8),p));out=cv_add(out,cv_scale(q,weight));sum+=weight;}}
 return cv_scale(out,1/fmax(sum,0.00001f32));
}
cv_echo_direction :: (p:V3,u:[]f32)->V3 {return v3(u[108]*p.x+u[109]*p.z,p.y,-u[109]*p.x+u[108]*p.z);}
cv_orb_rotate :: (p:V3,u:[]f32)->V3 {q:=cv_at(u,100);return cv_add(p,cv_scale(wg_cross3(q,cv_add(wg_cross3(q,p),cv_scale(p,u[103]))),2));}
cv_world :: (id:u32,instance:u32,vertices:[]u32,u:[]f32,bones:[]f32)->V3 {
 if id>=1000000 {return cv_groom(id,vertices,u,bones).world;}
 if id>=980000 {at:=cv_vertex_at(id,vertices);return cv_add(cv_at(u,116),cv_orb_rotate(cv_scale(v3(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2)),SLAY_ORB_RADIUS*2),u));}
 if instance==2 {m:=cv_morph(id,vertices,bones,u);p:=v4(m.position.x,m.position.y,m.position.z,1);return cv_add(cv_at(u,104),cv_echo_direction(cv_skin(id,p,vertices,bones),u));}
 at:=cast(int)id*12;p:=v4(cv_word(vertices,at),cv_word(vertices,at+1),cv_word(vertices,at+2),1);m:=32+cast(int)instance*24;return v3(wg_dot4(wg_at4(u,m),p),wg_dot4(wg_at4(u,m+4),p),wg_dot4(wg_at4(u,m+8),p));
}
cv_shadow :: (world:V3,u:[]f32)->V3 {p:=cv_sub(world,cv_at(u,92));return v3(wg_dot3(p,cv_at(u,80))/u[96],wg_dot3(p,cv_at(u,84))/u[96],0.5-wg_dot3(p,cv_at(u,88))/(4*u[96]));}
vc_bg_vs :: (i:u32,j:u32)->V4 {return splash_bg_vs(i,j);}
// An explicit metre grid on the inspection floor, below every source bound. The original scene's terrain is not included.
vc_bg_fs :: (p:V4,u:[]f32)->V4 {
  if u[112]>0.5 {
   sy:=1-p.y/u[1]*2;if abs(sy)>u[0]/u[1]/u[113] {return v4(0,0,0,1);}
   ray:=wg_normalize3(cv_add(cv_at(u,20),cv_add(cv_scale(cv_at(u,12),(p.x/u[0]*2-1)/u[15]),cv_scale(cv_at(u,16),sy/u[19]))));
   delta:=cv_sub(cv_at(u,116),cv_at(u,8));along:=wg_dot3(delta,ray);distance:=sqrt(fmax(0.0f32,wg_dot3(delta,delta)-along*along));r:=SLAY_ORB_RADIUS;core:=1-smoothstep(r*0.8,r*1.05,distance);halo:=exp(-distance*distance/(r*r*5))*0.5;flare:=exp(-distance*distance/(r*r*35))*0.06;
   return v4(clampf(halo*0.2+flare*0.1,0.0f32,1.0f32),clampf(halo*0.65+flare*0.5,0.0f32,1.0f32),clampf(halo+flare,0.0f32,1.0f32),1);
  }
  if u[110]>0.5 {return v4(0,0,0,1);}
  sky:=v3(0.065,0.075,0.09);if u[7]<0.5 {return v4(sky.x,sky.y,sky.z,1);}
  ray:=cv_add(cv_at(u,20),cv_add(cv_scale(cv_at(u,12),(p.x/u[0]*2-1)/u[15]),cv_scale(cv_at(u,16),(1-p.y/u[1]*2)/u[19])));
  if ray.y>=-0.0001 {return v4(sky.x,sky.y,sky.z,1);}t:=(u[100]-u[9])/ray.y;if t<=0 {return v4(sky.x,sky.y,sky.z,1);}
  at:=cv_add(cv_at(u,8),cv_scale(ray,t));fx:=abs(at.x-floor(at.x+0.5));fz:=abs(at.z-floor(at.z+0.5));line:=ifx fx<0.025 || fz<0.025 then 0.08f32 else 0.0f32;
  fade:=1.0f32/(1.0f32+t*0.025f32);c:=cv_add(cv_scale(v3(0.16+line,0.15+line,0.13+line),fade),cv_scale(sky,1-fade));return v4(c.x,c.y,c.z,1);
}
vc_vertex :: struct {a:V4;b:V4;c:V4;}
vc_fx_vs :: (i:u32,j:u32,a:vc_vertex,u:[]f32)->SplashV {return splash_fx_vs(i,j,splash_fx_vs_in.{a=a.a,b=a.b,c=a.c,d=v4(0,0,0,0)},u);}
vc_fx_fs :: (v:SplashV,u:[]f32)->V4 {return splash_fx_fs(v,u);}
CanyonSurface :: struct {pos:V4;world:V3;normal:V3;uv:V2;paint:V4;tangent:V4;character:f32;material:f32;}
vc_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonSurface {
 world:=cv_world(id,instance,vertices,u,bones);at:=cast(int)id*12;normal:=v3(0,1,0);uv:=v2(0,0);paint:=v4(1,1,1,1);tangent:=v4(0,0,0,1);material:f32=0;character:f32=0;
 if id>=1000000 {groom:=cv_groom(id,vertices,u,bones);normal=groom.normal;tangent=v4(groom.tangent.x,groom.tangent.y,groom.tangent.z,1);uv=groom.uv;paint=v4(groom.coverage,groom.edge,1,1);character=1;material=groom.material;}
 else if id>=980000 {at=cv_vertex_at(id,vertices);normal=cv_orb_rotate(v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5)),u);t:=cv_orb_rotate(v3(cv_word(vertices,at+15),cv_word(vertices,at+16),cv_word(vertices,at+17)),u);tangent=v4(t.x,t.y,t.z,cv_word(vertices,at+18));character=1;material=29;}
 else if instance==2 {at=cv_vertex_at(id,vertices);m:=cv_morph(id,vertices,bones,u);normal=cv_echo_direction(cv_skin(id,v4(m.normal.x,m.normal.y,m.normal.z,0),vertices,bones),u);t:=cv_echo_direction(cv_skin(id,v4(cv_word(vertices,at+15),cv_word(vertices,at+16),cv_word(vertices,at+17),0),vertices,bones),u);tangent=v4(t.x,t.y,t.z,cv_word(vertices,at+18));character=1;material=cast(f32)vertices[at+8];}
 else {n:=v3(cv_word(vertices,at+3),cv_word(vertices,at+4),cv_word(vertices,at+5));m:=44+cast(int)instance*24;normal=v3(wg_dot3(cv_at(u,m),n),wg_dot3(cv_at(u,m+4),n),wg_dot3(cv_at(u,m+8),n));paint=wg_unpack4x8unorm(vertices[at+8]);}
 if id<1000000 {uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));}r:=cv_sub(world,cv_at(u,8));z:=wg_dot3(r,cv_at(u,20));return CanyonSurface.{pos=v4(wg_dot3(r,cv_at(u,12))*u[15],wg_dot3(r,cv_at(u,16))*u[19],300.0/299.95*(z-0.05),z),world=world,normal=normal,uv=uv,paint=paint,tangent=tangent,character=character,material=material};
}
CanyonShadow :: struct {pos:V4;uv:V2;character:f32;material:f32;coverage:f32;edge:f32;}
vc_shadow_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,bones:[]f32)->CanyonShadow {
 q:=cv_shadow(cv_world(id,instance,vertices,u,bones),u);uv:=v2(0,0);material:f32=0;coverage:f32=1;edge:f32=0;if id>=1000000 {groom:=cv_groom(id,vertices,u,bones);uv=groom.uv;material=groom.material;coverage=groom.coverage;edge=groom.edge;}else if instance==2 {at:=cv_vertex_at(id,vertices);uv=v2(cv_word(vertices,at+6),cv_word(vertices,at+7));material=cast(f32)vertices[at+8];}return CanyonShadow.{pos=v4(q.x,q.y,q.z,1),uv=uv,character=ifx instance==2 then 1.0f32 else 0.0f32,material=material,coverage=coverage,edge=edge};
}
cv_echo_mask :: (uv:V2,material:f32,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler,dx:V2,dy:V2) {
 if material==ECHO_LASH_SLOT {if cv_echo_lash_mask(uv)<0.3333 {gpu_discard();}return;}
 m:=ECHO_MATERIAL_WORD+cast(int)material*16;if vertices[m+9]!=0 {gpu_discard();}alpha:=cast(int)vertices[m+3]-1;if alpha>=0 {a:=render_sample_layer8_grad(sheets,sheet,uv,cast(s32)alpha,dx,dy,0);if cv_srgb(a.x)<0.333333 {gpu_discard();}}
}
vc_shadow_fs :: (s:CanyonShadow,vertices:[]u32,sheets:Tex2DArray,sheet:Sampler) {if s.material==29 {gpu_discard();}if s.material==26 || s.material==27 {noise:=sin(floor(s.pos.x)*12.9898+floor(s.pos.y)*78.233+s.uv.y*437.0)*43758.5453;if cv_groom_opacity(s.coverage,s.edge)<noise-floor(noise) {gpu_discard();}}dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));if s.character>0.5 {cv_echo_mask(s.uv,s.material,vertices,sheets,sheet,dx,dy);}}
cv_srgb :: (x:f32)->f32 {return ifx x<=0.0031308 then 12.92*x else 1.055*pow(x,1.0f32/2.4f32)-0.055;}
cv_tone :: (x:f32)->f32 {return cv_srgb(fmin(1.0f32,(x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14)));}
#test "Echo source face graph applies instance colour multiplier desaturation contrast and tint" {
 c:=cv_echo_head_colour(v3(0.2,0.1,0.05));
 // UE Desaturation luminance factors (0.3,0.59,0.11), then CheapContrast_RGB(-0.02).
 #assert abs(c.x-0.417384)<0.000001 && abs(c.y-0.27176)<0.000001 && abs(c.z-0.1667997552)<0.000001;
 #assert cv_echo_head_colour(v3(10,10,10)).x==0.9;
 b:=cv_echo_body_colour(v3(0.2,0.1,0.05));#assert abs(b.x-0.18)<0.000001 && abs(b.y-0.1164215)<0.000001 && b.z==0.0625;
}
// M_Head_Echo: texture * Color_Mult -> Desaturation -> CheapContrast_RGB -> Tint.
// M_Head_Echo_Inst overrides 2.5, 0.2, -0.02 and (0.9,1,0.949020).
cv_echo_head_colour :: (a:V3)->V3 {
 c:=cv_scale(a,2.5);l:=c.x*0.3+c.y*0.59+c.z*0.11;
 return v3(clampf((c.x*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.9,clampf((c.y*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32),clampf((c.z*0.8+l*0.2)*0.96+0.02,0.0f32,1.0f32)*0.949020);
}
#test "Slay head instance retains its own desaturation and tint instead of Valley settings" {
 c:=cv_echo_slay_head_colour(v3(0.2,0.1,0.05));#assert abs(c.x-0.4106946115)<0.000002 && abs(c.y-0.27764)<0.000002 && abs(c.z-0.168731506)<0.000002;
}
// Slay MI_Head_Echo: Desat=.3, Tint=(.921582,1,.871367), gain/contrast unchanged.
cv_echo_slay_head_colour :: (a:V3)->V3 {
 c:=cv_scale(a,2.5);l:=c.x*0.3+c.y*0.59+c.z*0.11;
 return v3(clampf((c.x*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32)*0.921582,clampf((c.y*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32),clampf((c.z*0.7+l*0.3)*0.96+0.02,0.0f32,1.0f32)*0.871367);
}
#test "Slay skin specular uses both highpass channels and the ORM specular mask" {
 #assert abs(cv_echo_head_f0(0,0,1)-0.00465449106)<0.000001;
 #assert abs(cv_echo_head_f0(1,1,1)-0.07341152)<0.000001;
 #assert cv_echo_head_f0(0.5,0.25,0)==0;
 #assert abs(cv_echo_head_f0(0.5,0.25,0.7)-0.014754683)<0.000002;
}
// MI_Head_Echo: lerp(SpecVary0,1,highpass.r) *
// lerp(SpecVary2,3,highpass.g) * ORM.r; UE dielectric F0 = .08 * Specular.
cv_echo_head_f0 :: (r:f32,g:f32,mask:f32)->f32 {return 0.08*mix(0.195238f32,0.917644f32,r)*mix(0.298004f32,1.0f32,g)*mask;}
cv_echo_body_colour :: (a:V3)->V3 {return v3(a.x*0.9,a.y*1.164215,a.z*1.25);}
#test "Character material override uses original collection gain four gamma 1.2 and instance rolloff" {c:=cv_echo_overrides(v3(0.1,0.05,0.02),0.7,0.07);#assert abs(c.x-0.318432139)<0.000002 && abs(c.y-0.185325344)<0.000002 && abs(c.z-0.094407422)<0.000002;#assert cv_echo_overrides(v3(0,0,0),0.7,0.07).x==0;}
// MF_CharacterMaterialOverrides + MPC_CharacterAlbedo: gain 4, gamma 1.2,
// identity YCoCg Low/High, per-channel MinValue=0/Rolloff, then Desaturation.
cv_echo_overrides :: (base:V3,rolloff:f32,desat:f32)->V3 {c:=v3(pow(fmax(0.0f32,base.x*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.y*4),1.0f32/1.2f32)*rolloff,pow(fmax(0.0f32,base.z*4),1.0f32/1.2f32)*rolloff);l:=wg_dot3(c,v3(0.3,0.59,0.11));return cv_add(cv_scale(c,1-desat),v3(l*desat,l*desat,l*desat));}
cv_echo_core_material :: (m:f32)->bool {return m==0 || m==1 || m==2 || m==4 || m==5 || m==6 || m==8 || m==13 || m==15 || m==23 || m==25;}
#test "Source angle corrected normal blend preserves either flat input" {a:=v3(0.2,0.1,0.9746794);b:=cv_echo_normal_blend(a,v3(0,0,1));#assert abs(a.x-b.x)<0.000001 && abs(a.z-b.z)<0.000001;b=cv_echo_normal_blend(v3(0,0,1),a);#assert abs(a.y-b.y)<0.000001 && abs(a.z-b.z)<0.000001;}
cv_echo_normal_blend :: (base:V3,detail:V3)->V3 {t:=v3(base.x,base.y,base.z+1);d:=v3(-detail.x,-detail.y,detail.z);return cv_sub(cv_scale(t,wg_dot3(t,d)/t.z),d);}
cv_echo_normal :: (a:V4,strength:f32)->V3 {return v3((cv_srgb(a.x)*2-1)*strength,(1-cv_srgb(a.y)*2)*strength,cv_srgb(a.z)*2-1);}
#test "Source groom colours retain the demo's brown root tip and pepper settings" {c:=cv_echo_groom_colour(0,0.5);#assert abs(c.x-0.08125)<0.000001 && abs(c.z-0.0284375)<0.000001;p:=cv_echo_groom_colour(0.5,0.1);#assert p.x==0.201556 && p.y==0.125356 && p.z==0.070545;}
cv_echo_groom_colour :: (u:f32,seed:f32)->V3 {if seed<0.15 {return v3(0.201556,0.125356,0.070545);}brightness:=ifx seed<1.0f32/3 then mix(0.4f32,0.15f32,seed*3) else ifx seed<2.0f32/3 then mix(0.15f32,0.5f32,seed*3-1) else mix(0.5f32,0.0f32,seed*3-2);return cv_scale(v3(mix(0.25f32,0.234375f32,u),mix(0.154883f32,0.164421f32,u),mix(0.0875f32,0.105469f32,u)),brightness);}
// The source eye's "Scale Pupils" node, at the instance's PupilScale=0.75.
#test "Eye pupil scaling retains centre and rim and source corner shadow bounds" {c:=cv_echo_pupil(v2(0.5,0.5));#assert c.x==0.5 && c.y==0.5;r:=cv_echo_pupil(v2(1,0.5));#assert r.x==1 && r.y==0.5;#assert cv_echo_eye_shadow(0)==1 && cv_echo_eye_shadow(0.35)==0;}
cv_echo_pupil :: (uv:V2)->V2 {x:=uv.x-0.5;y:=uv.y-0.5;r:=sqrt(x*x+y*y);if r<0.000001 {return v2(0.5,0.5);}k:=0.5/r*(1-clampf((1-r*2)*0.75,0.0f32,1.0f32));return v2(x*k+0.5,y*k+0.5);}
cv_echo_eye_shadow :: (radius:f32)->f32 {return clampf((1-radius/0.345)/(1-0.535610),0.0f32,1.0f32);}
#test "Original lash opacity tapers to the root and preserves the central tip" {#assert cv_echo_lash_mask(v2(0.5,1))==1 && cv_echo_lash_mask(v2(0.5,0))==0;#assert abs(cv_echo_lash_mask(v2(0,1))-0.35355339)<0.000001;}
cv_echo_lash_mask :: (uv:V2)->f32 {return pow(fmax(0.0f32,1-abs(uv.x-0.5)),1.5f32)*pow(fmax(0.0f32,uv.y),0.45f32);}
#test "Canyon material helpers retain linear roughness and bounded filmic response" {#assert abs(cv_srgb(0.21404114)-0.5)<0.00001;#assert cv_tone(0)==0 && cv_tone(1)>0.9 && cv_tone(100)<=1;}
cv_orb_shade :: (s:CanyonSurface,u:[]f32,vertices:[]u32)->V4 {
 dist:=cast(int)vertices[ECHO_MATERIAL_WORD+31*16+2];energy:=cast(int)vertices[ECHO_MATERIAL_WORD+31*16+3];n:=wg_normalize3(s.normal);t:=wg_normalize3(v3(s.tangent.x,s.tangent.y,s.tangent.z));b:=cv_scale(wg_cross3(n,t),s.tangent.w);v:=wg_normalize3(cv_sub(cv_at(u,8),s.world));nv:=wg_dot3(n,v);if nv<=0 {gpu_discard();}
 bump:=raw_rgb_sample(vertices,dist,256,v2(u[5]*0.1,u[5]*0.1));x:=bump.x*2-1;y:=1-bump.y*2;z:=sqrt(fmax(0.0f32,1-x*x-y*y));normal:=cv_add(cv_scale(t,x*0.5),cv_add(cv_scale(b,y*0.5),cv_scale(n,z*0.5+0.5)));
 e:=slay_orb_emission(wg_dot3(normal,v),nv,slay_orb_energy(vertices,dist,energy,s.uv,u[5]));mapped:=film_rec709(film_rgb(e.x,e.y,e.z));return v4(cv_srgb(clampf(mapped.r,0.0f32,1.0f32)),cv_srgb(clampf(mapped.g,0.0f32,1.0f32)),cv_srgb(clampf(mapped.b,0.0f32,1.0f32)),e.w);
}
cv_fiber_light :: (base:V3,t:V3,l:V3,v:V3,rough:f32,seed:f32)->V3 {
 // Rootward tangent follows the source hair BSDF convention.
 root:=cv_scale(t,-1);sl:=wg_dot3(root,l);sv:=wg_dot3(root,v);lp:=cv_sub(l,cv_scale(root,sl));vp:=cv_sub(v,cv_scale(root,sv));phi:=wg_dot3(lp,vp)/sqrt(wg_dot3(lp,lp)*wg_dot3(vp,vp)+0.0001);vl:=wg_dot3(v,l);spec:=mix(0.05f32,0.1f32,seed);back:=mix(0.15f32,0.5f32,seed);
 return v3(hair_fiber(base.x,rough,spec,back,sl,sv,phi,vl),hair_fiber(base.y,rough,spec,back,sl,sv,phi,vl),hair_fiber(base.z,rough,spec,back,sl,sv,phi,vl));
}
cv_mul :: (a:V3,b:V3)->V3 {return v3(a.x*b.x,a.y*b.y,a.z*b.z);}
#test "Each light evaluates its own microfacet highlight and back lights contribute zero" {
 n:=v3(0,0,1);a:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,n,n,1);
 #assert abs(a.x-0.369239468)<0.000002;
 b:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,v3(0,0,-1),n,1);#assert b.x==0 && b.y==0 && b.z==0;
 d:=cv_surface_light(v3(1,1,1),v3(0.04,0.04,0.04),0,0.5,n,n,n,0);#assert abs(d.x-0.318309886)<0.000002;
}
cv_surface_light :: (base:V3,f0:V3,metal:f32,rough:f32,n:V3,l:V3,v:V3,spec_scale:f32)->V3 {return cv_area_light(base,f0,metal,rough,n,l,v,spec_scale,0);}
// Unreal's sphere-light widening (New_a2): a light subtending sin(angle) `size`
// spreads a smooth surface's highlight instead of leaving a pinpoint.
cv_area_a2 :: (a:f32,size:f32,vh:f32)->f32 {return fmin(1.0f32,a*a+0.25*size*(3*a+size)/(vh+0.001));}
cv_area_light :: (base:V3,f0:V3,metal:f32,rough:f32,n:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {
 nl:=fmax(0.0f32,wg_dot3(n,l));if nl==0 {return v3(0,0,0);}
 h:=wg_normalize3(cv_add(l,v));nv:=fmax(0.0001f32,wg_dot3(n,v));nh:=fmax(0.0f32,wg_dot3(n,h));vh:=fmax(0.0f32,wg_dot3(v,h));a:=rough*rough;aa:=cv_area_a2(a,size,vh);den:=nh*nh*(aa-1)+1;k:=(rough+1)*(rough+1)/8;
 scale:=aa/(3.14159265*den*den)*nv/(nv*(1-k)+k)*nl/(nl*(1-k)+k)/(4*nv)*spec_scale;f:=pow(1-vh,5.0f32);
 return cv_add(cv_scale(base,nl*(1-metal)/3.14159265),cv_scale(v3(f0.x+(1-f0.x)*f,f0.y+(1-f0.y)*f,f0.z+(1-f0.z)*f),scale));
}
#test "Skin keeps light past the terminator in red only and broadens its highlight" {
 n:=v3(0,0,1);l:=wg_normalize3(v3(0,1,-0.2));v:=v3(0,0,1);f0:=v3(0.028,0.028,0.028);
 back:=cv_skin_light(v3(0.8,0.5,0.4),f0,0.4,n,n,l,v,1,0);#assert back.x>0 && back.z==0 && cv_surface_light(v3(0.8,0.5,0.4),f0,0,0.4,n,l,v,1).x==0;
 h:=wg_normalize3(v3(0,0.3,1));r:=wg_normalize3(cv_sub(cv_scale(h,2*wg_dot3(h,v)),v));peak:=cv_skin_light(v3(0,0,0),f0,0.3,h,h,r,v,1,0);plain:=cv_surface_light(v3(0,0,0),f0,0,0.3,h,r,v,1);
 #assert peak.x>0 && peak.x<plain.x;
 front:=cv_skin_light(v3(0.8,0.5,0.4),f0,0.4,n,n,n,v,1,0);flat:=cv_surface_light(v3(0.8,0.5,0.4),f0,0,0.4,n,n,v,1);#assert abs(front.z-flat.z)<0.02 && front.x<flat.x+0.02;
}
// Unreal's subsurface-profile skin: two specular lobes at 0.75x and 1.30x roughness
// mixed 0.85 toward the broader one, and diffuse that wraps further for red than
// green and blue, with diffuse normals bent toward the smoother geometric normal.
#test "An area light lowers a smooth highlight's peak, keeps point lights unchanged and stays bounded" {
 n:=v3(0,0,1);v:=v3(0,0,1);f0:=v3(0.04,0.04,0.04);black:=v3(0,0,0);
 #assert cv_area_light(black,f0,0,0.2,n,n,v,1,0).x==cv_surface_light(black,f0,0,0.2,n,n,v,1).x;
 #assert cv_area_light(black,f0,0,0.2,n,n,v,1,SLAY_KEY_SIZE).x<cv_surface_light(black,f0,0,0.2,n,n,v,1).x*0.5;
 #assert cv_area_a2(0.04,0,1)==0.04*0.04 && cv_area_a2(0.04,SLAY_KEY_SIZE,1)>0.04*0.04 && cv_area_a2(1,1,0)==1;
}
cv_skin_light :: (base:V3,f0:V3,rough:f32,n:V3,g:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {
 black:=v3(0,0,0);a:=cv_area_light(black,f0,0,clampf(rough*0.75,0.045f32,1.0f32),n,l,v,spec_scale,size);b:=cv_area_light(black,f0,0,clampf(rough*1.3,0.045f32,1.0f32),n,l,v,spec_scale,size);
 nr:=wg_normalize3(cv_add(cv_scale(n,0.4),cv_scale(g,0.6)));ng:=wg_normalize3(cv_add(cv_scale(n,0.75),cv_scale(g,0.25)));
 dr:=fmax(0.0f32,(wg_dot3(nr,l)+0.35)/1.35);dg:=fmax(0.0f32,(wg_dot3(ng,l)+0.12)/1.12);db:=fmax(0.0f32,wg_dot3(n,l));
 return cv_add(cv_add(cv_scale(a,0.15),cv_scale(b,0.85)),v3(base.x*dr/3.14159265,base.y*dg/3.14159265,base.z*db/3.14159265));
}
// The orb Rect Light from the shot: position (u[83],u[87],u[91]), colour x candelas
// (u[23],u[27],u[95]), attenuation radius u[107] and octahedral aim (u[11],u[127]), in
// otherwise unused uniform slots.
cv_rect_delta :: (u:[]f32,world:V3)->V3 {return v3(u[83]-world.x,u[87]-world.y,u[91]-world.z);}
// The kick is static in shot space; the face view turns the whole rig by the yaw in u[119].
cv_kick_dir :: (u:[]f32)->V3 {c:=cos(u[119]);s:=sin(u[119]);return v3(c*SLAY_KICK_X+s*SLAY_KICK_Z,SLAY_KICK_Y,-s*SLAY_KICK_X+c*SLAY_KICK_Z);}
// Closest distance between segments p0-p1 and q0-q1 (Ericson, Real-Time Collision Detection 5.1.9).
cv_segment_gap :: (p0:V3,p1:V3,q0:V3,q1:V3)->f32 {
 d1:=cv_sub(p1,p0);d2:=cv_sub(q1,q0);r:=cv_sub(p0,q0);a:=fmax(wg_dot3(d1,d1),0.00000001f32);e:=fmax(wg_dot3(d2,d2),0.00000001f32);f:=wg_dot3(d2,r);c:=wg_dot3(d1,r);b:=wg_dot3(d1,d2);denom:=a*e-b*b;
 sa:=ifx denom>0.0000000001 then clampf((b*f-c*e)/denom,0.0f32,1.0f32) else 0.0f32;t:=(b*sa+f)/e;
 if t<0 {t=0;sa=clampf(-c/a,0.0f32,1.0f32);} else if t>1 {t=1;sa=clampf((b-c)/a,0.0f32,1.0f32);}
 return wg_length3(cv_sub(cv_add(p0,cv_scale(d1,sa)),cv_add(q0,cv_scale(d2,t))));
}
// How much of the orb light reaches p past the orb hand's capsules. A capsule the point lies on
// (within 1.6 radii of its axis) is skipped so a finger does not shadow its own skin.
cv_hand_visibility :: (p:V3,light:V3,u:[]f32,bones:[]f32)->f32 {
 visible:f32=1;
 for k:0..<SLAY_HAND_CAPSULES {at:=SLAY_HAND_CAPSULE_WORD+k*8;r:=bones[at+3];
  if r>0 {a:=cv_add(cv_at(u,104),cv_echo_direction(v3(bones[at],bones[at+1],bones[at+2]),u));b:=cv_add(cv_at(u,104),cv_echo_direction(v3(bones[at+4],bones[at+5],bones[at+6]),u));
   if cv_segment_gap(p,p,a,b)>r*1.6 {visible=visible*clampf((cv_segment_gap(p,light,a,b)-r*0.8)/(r*0.5),0.0f32,1.0f32);}}
 }
 return visible;
}
#test "Hand capsules shadow the orb light across them and never a point on their own skin" {
 u:[128]f32;u[108]=1;bones:[SLAY_HAND_CAPSULE_WORD+SLAY_HAND_CAPSULES*8]f32;at:=SLAY_HAND_CAPSULE_WORD;bones[at]= -0.1;bones[at+4]=0.1;bones[at+3]=0.02;
 #assert cv_hand_visibility(v3(0,-0.2,0),v3(0,0.2,0),u[..],bones[..])==0;
 #assert cv_hand_visibility(v3(0.5,-0.2,0),v3(0.5,0.2,0),u[..],bones[..])==1;
 #assert cv_hand_visibility(v3(0,-0.021,0),v3(0,0.2,0),u[..],bones[..])==1;
 #assert abs(cv_segment_gap(v3(0,0,0),v3(1,0,0),v3(0.5,1,0),v3(0.5,2,0))-1)<0.00001;
}
cv_oct_decode :: (x:f32,y:f32)->V3 {n:=v3(x,y,1-abs(x)-abs(y));t:=fmax(-n.z,0.0f32);return wg_normalize3(v3(n.x+(ifx n.x>=0 then -t else t),n.y+(ifx n.y>=0 then -t else t),n.z));}
cv_rect_power :: (u:[]f32,rect:V3)->f32 {d2:=wg_dot3(rect,rect);aim:=cv_oct_decode(u[11],u[127]);return slay_candela_scale(d2,u[107])*slay_rect_emission(-wg_dot3(aim,rect)/sqrt(fmax(d2,0.000001f32)));}
#test "Octahedral aim round-trips every octant and the rect light is dark behind its panel" {
 for d:[6]V3.[v3(0.6,0.48,0.64),v3(-0.6,0.48,-0.64),v3(0.36,-0.48,-0.8),v3(-0.8,-0.36,0.48),v3(0,0,-1),v3(0,1,0)] {e:=cv_oct_decode(slay_oct_x(d.x,d.y,d.z),slay_oct_y(d.x,d.y,d.z));#assert abs(e.x-d.x)<0.0001 && abs(e.y-d.y)<0.0001 && abs(e.z-d.z)<0.0001;}
 u:[128]f32;u[107]=0.5;u[11]=slay_oct_x(0,0,1);u[127]=slay_oct_y(0,0,1);
 #assert cv_rect_power(u[..],v3(0,0,-0.3))>0 && cv_rect_power(u[..],v3(0,0,0.3))==0 && cv_rect_power(u[..],v3(0.3,0,-0.01))==0;
}
cv_slay_light :: (skin:bool,base:V3,f0:V3,metal:f32,rough:f32,n:V3,g:V3,l:V3,v:V3,spec_scale:f32,size:f32)->V3 {if skin {return cv_skin_light(base,f0,rough,n,g,l,v,spec_scale,size);}return cv_area_light(base,f0,metal,rough,n,l,v,spec_scale,size);}

vc_scene_fs :: (s:CanyonSurface,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,bones:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  if u[112]>0.5 && abs(1-s.pos.y/u[1]*2)>u[0]/u[1]/u[113] {gpu_discard();}
  dx:=v2(gpu_dpdx_fine(s.uv.x),gpu_dpdx_fine(s.uv.y));dy:=v2(gpu_dpdy_fine(s.uv.x),gpu_dpdy_fine(s.uv.y));
  return cv_scene_shade(s,u,sheets,sheet,vertices,bones,shadow_map,shadow_cmp,dx,dy);
}
#test "Walking Valley and Slay retain their own source head material profiles" {a:=v3(0.2,0.1,0.05);v:=cv_profile_head_colour(a,true);s:=cv_profile_head_colour(a,false);#assert v.x==cv_echo_head_colour(a).x && s.x==cv_echo_slay_head_colour(a).x && v.x!=s.x;}
cv_profile_head_colour :: (a:V3,valley:bool)->V3 {return ifx valley then cv_echo_head_colour(a) else cv_echo_slay_head_colour(a);}
cv_scene_shade :: (s:CanyonSurface,u:[]f32,sheets:Tex2DArray,sheet:Sampler,vertices:[]u32,bones:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare,dx:V2,dy:V2)->V4 {
  if s.material==29 {return cv_orb_shade(s,u,vertices);}
  n:=wg_normalize3(s.normal);albedo:=v3(1,1,1);rough:f32=0.65;metal:f32=0;skin_f0:f32=0.04;

  if s.character>0.5 {cv_echo_mask(s.uv,s.material,vertices,sheets,sheet,dx,dy);m:=ECHO_MATERIAL_WORD+cast(int)s.material*16;albedo=v3(cv_word(vertices,m+4),cv_word(vertices,m+5),cv_word(vertices,m+6));rough=cv_word(vertices,m+8);metal=cv_word(vertices,m+7);colour:=cast(int)vertices[m]-1;normal_map:=cast(int)vertices[m+1]-1;orm:=cast(int)vertices[m+2]-1;
   if colour>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)colour,dx,dy,0);albedo=v3(albedo.x*a.x,albedo.y*a.y,albedo.z*a.z);}if orm>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)orm,dx,dy,0);rough=cv_srgb(a.y);metal=cv_srgb(a.z);}
   if (s.material==26 || s.material==27) {albedo=cv_echo_groom_colour(s.uv.x,s.uv.y);metal=0;rough=mix(0.32f32,0.45f32,s.uv.y)*(1+0.1*s.uv.x);}
   if s.material==ECHO_LASH_SLOT {albedo=cv_scale(v3(mix(0.08f32,0.16f32,s.uv.y),mix(0.053397f32,0.090834f32,s.uv.y),mix(0.04f32,0.056f32,s.uv.y)),0.5);rough=0.6;metal=0;}
   if s.material==ECHO_HEAD_SLOT {albedo=cv_profile_head_colour(albedo,u[114]<0);metal=0;macro:=render_sample_layer8_grad(sheets,sheet,s.uv,26,dx,dy,0);additional:=render_sample_layer8_grad(sheets,sheet,s.uv,27,dx,dy,0);rough=macro.x+rough*0.2+additional.x;highpass:=render_sample_layer8_grad(sheets,sheet,s.uv,31,dx,dy,0);mask:=render_sample_layer8_grad(sheets,sheet,s.uv,17,dx,dy,0);if u[114]>=0 {skin_f0=cv_echo_head_f0(highpass.x,highpass.y,cv_srgb(mask.x));}}
   if s.material==ECHO_SKIN_SLOT {albedo=cv_echo_body_colour(albedo);rough=rough*0.2+0.45*0.8;metal=0;}
   if s.material==ECHO_EYE_LEFT_SLOT || s.material==ECHO_EYE_RIGHT_SLOT {x:=s.uv.x-0.5;y:=s.uv.y-0.5;r:=sqrt(x*x+y*y);iris_uv:=cv_echo_pupil(v2(x/0.3+0.5,y/0.3+0.5));iris:=render_sample_layer8_grad(sheets,sheet,iris_uv,9,cv_scale2(dx,1/0.3),cv_scale2(dy,1/0.3),0);mask:=1-smoothstep(0.115f32,0.15f32,r);limbus:=1-pow(fmin(1.0f32,sqrt((iris_uv.x-0.5)*(iris_uv.x-0.5)+(iris_uv.y-0.5)*(iris_uv.y-0.5))*2.15),8.0f32);ic:=v3(pow(iris.x*0.723055*1.4*2,1.1f32),pow(iris.y*0.644480*1.4*2,1.1f32),pow(iris.z*0.623960*1.4*2,1.1f32));sclera:=v3(albedo.x*0.541667,albedo.y*0.494239,albedo.z*0.460880);albedo=cv_add(cv_scale(sclera,1-mask),cv_scale(ic,mask*limbus));corner:=cv_echo_eye_shadow(r);albedo=v3(albedo.x*mix(0.23f32,1.0f32,corner)*1.4,albedo.y*mix(0.083042f32,1.0f32,corner)*1.4,albedo.z*mix(0.031906f32,1.0f32,corner)*1.4);}
   if normal_map>=0 {a:=render_sample_layer8_grad(sheets,sheet,s.uv,cast(s32)normal_map,dx,dy,0);strength:=ifx s.material==ECHO_HEAD_SLOT then 0.65f32 else ifx s.material==ECHO_SKIN_SLOT then 1.0f32 else ifx s.material==5 || s.material==13 then 0.7f32 else ifx cv_echo_core_material(s.material) then 0.65f32 else 1.0f32;map:=cv_echo_normal(a,strength);
    if s.material==ECHO_HEAD_SLOT {micro:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,s.uv,28,dx,dy,0),1);view:=wg_normalize3(cv_sub(cv_at(u,8),s.world));fresnel:=pow(1-fmax(0.0f32,wg_dot3(n,view)),3.0f32);amount:=0.5+fresnel;detail:=cv_add(cv_scale(v3(0,0,1),1-amount),cv_scale(micro,amount));detail=v3(detail.x*0.75,detail.y*0.75,detail.z);map=cv_echo_normal_blend(map,detail);brow:=cv_echo_normal(render_sample_layer8_grad(sheets,sheet,s.uv,29,dx,dy,0),0.1);mask:=render_sample_layer8_grad(sheets,sheet,s.uv,30,dx,dy,0).x;map=cv_add(cv_scale(map,1-mask),cv_scale(brow,mask));}
    t:=wg_normalize3(v3(s.tangent.x,s.tangent.y,s.tangent.z));b:=cv_scale(wg_cross3(n,t),s.tangent.w);n=wg_normalize3(cv_add(cv_scale(t,map.x),cv_add(cv_scale(b,map.y),cv_scale(n,map.z))));}
   if cv_echo_core_material(s.material) {material:=s.material;view:=wg_normalize3(cv_sub(cv_at(u,8),s.world));nv:=clampf(wg_dot3(n,view),0.0f32,1.0f32);fuzzy:f32=1;
    if material==2 || material==23 {fuzzy=1-0.1*nv;}if material==5 || material==13 {fuzzy=mix(1.0f32,1-0.15*nv+pow(1-nv,1.8f32),smoothstep(0.97f32,0.98f32,nv));}
    mult:=ifx material==1 || material==15 then 0.6f32 else 1.0f32;gamma:=ifx material==8 then 1.1f32 else ifx material==5 || material==13 then 1.05f32 else 1.0f32;albedo=v3(pow(fmax(0.0f32,albedo.x*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.y*fuzzy*mult),1/gamma),pow(fmax(0.0f32,albedo.z*fuzzy*mult),1/gamma));rolloff:=ifx material==5 || material==13 || material==8 then 0.6f32 else 0.7f32;desat:=ifx material==6 then 0.07f32 else ifx material==2 || material==23 || material==8 then 0.1f32 else 0.05f32;albedo=cv_echo_overrides(albedo,rolloff,desat);
    if material==0 {rough=rough*0.6+0.095238;}if material==1 || material==15 {rough*=0.721429;}if material==8 {rough*=0.883333;}if material==5 || material==13 {rough*=0.857451;}
   }
  }else {a:=render_sample_layer8_grad(sheets,sheet,s.uv,0,dx,dy,0);albedo=cv_scale(v3(a.x,a.y,a.z),u[6]);rough=cv_srgb(render_sample_layer8_grad(sheets,sheet,s.uv,1,dx,dy,0).x);}rough=clampf(rough,0.045f32,1.0f32);
  if u[4]>0.5 && u[4]<1.5 {return v4(cv_srgb(albedo.x),cv_srgb(albedo.y),cv_srgb(albedo.z),1);}
  if u[4]>1.5 && u[4]<2.5 {return v4(n.x*0.5+0.5,n.y*0.5+0.5,n.z*0.5+0.5,1);}
  if u[4]>2.5 && u[4]<3.5 {return v4(rough,rough,rough,1);}if u[4]>3.5 {return v4(s.paint.x,s.paint.y,s.paint.z,1);}
