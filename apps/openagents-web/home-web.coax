// The app's frame for someone who is logged in (the home page, /): an empty screen with a side of
// places down the left, Chats and Projects, each a link with its icon. Drawn by the browser
// (coax/web/dom-host.js) from the frames set on the mono skin, as /chat is; index.html opens it in
// place of the public home page once /api/auth/account says who is here.
//   coax/bin/coax test apps/openagents-web/home-web.coax
#load "../../components/kit/frames.coax";
#load "../../components/backend/dom.coax";

HW_INBOX :: 256;
HW_CSS :: 28672;

HomeWeb :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  inbox: [HW_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [HW_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

hw_build :: (s: [] HomeWeb) {
  t := s[0].tree[..]; u := s[0].ui[..];
  tr_begin(t);
  app := tr_open(t, "app", TG_DIV, "app");
  side := tr_open(t, "side", TG_NAV, "side");
  tr_attr(t, side, AT_LABEL, "Places");
  a := k_place(t, u, "place.chats", IC_CHATS, "Chats", "/chat", false);
  b := k_place(t, u, "place.projects", IC_FOLDER, "Projects", "/projects", false);
  tr_close(t);
  tr_close(t);
}

// One frame: builds and flushes if something changed or is entering. Bytes of commands to apply.
coaxial_homeweb_frame :: (s: [] HomeWeb, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready { n := mono_frames(s[0].sets[..]); s[0].ready = true; s[0].dirty = true; }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled { n := mono_css(s[0].css[..]); dm_style(d, cast(string) s[0].css[0..<n]); }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  hw_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}
coaxial_homeweb_busy :: (s: [] HomeWeb) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
// A press, a field's text or Enter on the node in this slot: the places are links, so nothing here yet.
coaxial_homeweb_event :: (s: [] HomeWeb, kind: int, slot: int, length: int) #export_c #effects(all) { if s.count > 0 { s[0].dirty = true; } }
coaxial_homeweb_size :: (s: [] HomeWeb, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_homeweb_inbox_cap :: () -> int #export_c #effects(all) { return HW_INBOX; }

#test "someone logged in sees a side with Chats and Projects, each a link with its icon, and nothing else" {
  s: [1] HomeWeb;
  n := coaxial_homeweb_frame(s[..], 0.016, true);
  t := s[0].tree[..];
  #assert n > 0 && tr_class(t, tr_find(t, "side")) == "side";
  #assert tr_class(t, tr_find(t, "place.chats")) == "row row-i" && tr_text_of(t, tr_find(t, "place.chats.t")) == "Chats" && tr_find(t, "place.chats.ic") > 0;
  #assert tr_text_of(t, tr_find(t, "place.projects.t")) == "Projects" && tr_find(t, "place.projects.ic") > 0;
  #assert tr_find(t, "composer") < 0;
}
