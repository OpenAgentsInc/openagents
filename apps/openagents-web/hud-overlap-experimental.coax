// The HUD overlap check for Everglade Experimental (GitHub #13076): its HUD (Character Create's
// combat HUD, the frame rate and your coordinates, the CLASSES column, the bar and its card, and
// in a local build the ANIMATIONS browser) drawn by lab_frame_draw on the four screens of
// hud-overlap.coax, for every class, with the column open and shut, the browser open and shut, a
// slot's card shown and you down. It prints each finding once; see hud-overlap.coax.
//   coax/web/tool.sh apps/openagents-web/hud-overlap-experimental.coax
#load "fivelab.coax";
#load "../../coax/lib/sys/tool.coax";
#load "hud-overlap.coax";

HUD_GATE :: true;   // a NEW finding in the player's HUD fails the run
// The findings already reported (docs/verification/hud-overlap-2026-11-09.md), each under the issue
// that fixes it: their keys, as printed, with the screen and state each first shows on. When a fix
// lands, the run says "gone" for its keys; take them out here.
// None is open now: #13092 fixed the last of them. A new finding fails the run.
hud_known :: (key: string) -> bool { return key.count < 0; }

HX_OUT :: 1048576;   // floats: 65536 stroke vertices
// The HUD of lab s on screen v: its trace in t.
hx_draw :: (s: [] Lab, t: [] cc.UitTrace, out: [] f32, u: [] f32, v: int) {
  cc.uit_clear(t); s[0].creator[0].ui = t;
  view := hud_view(v);
  n := lab_frame_draw(s, out, u, view.w, view.h, view.k, 0, true);
  s[0].creator[0].ui = t[0..<0];
}
// A lab in Experimental as class `klass` with the ANIMATIONS browser off, as the site shows it.
hx_lab :: (s: [] Lab, klass: int) {
  xc_test_lab(s, klass, 0);
  s[0].creator[0].dev_animations = false;
}
tool_main :: () -> int #export_c #effects(all) {
  r: [1] HudRun; t: [1] cc.UitTrace;
  out: [HX_OUT] f32; u: [UNIFORM_FLOATS] f32;
  for v: 0..<HUD_VIEWS {
    for klass: 0..<FB_CL_N {
      s: [1] Lab; hx_lab(s[..], klass);
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "world", false);
      s[0].xc[0].open = false;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "classes shut", false);
      // each side-bar button's tip, then its menu open with a row's tip
      g := xc_side_geo(s[..]);
      for j: 0..<g.n {
        s[0].xc[0].side = EgSideState.{side_hover = j};
        hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "side tip", false);
        s[0].xc[0].side = EgSideState.{menu = g.ids[j], menu_hover = 0};
        hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "side menu", false);
      }
    }
    {
      s: [1] Lab; hx_lab(s[..], FB_CL_WIZARD); s[0].xc[0].hover = 0;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "card", false);
    }
    {
      s: [1] Lab; hx_lab(s[..], FB_CL_DRUID); s[0].xc[0].b[0].c[0].wild_swap = true;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "wild shape swap", false);
    }
    {
      s: [1] Lab; hx_lab(s[..], FB_CL_FIGHTER); s[0].creator[0].hostiles[0].hp = 0;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "down", false);
    }
    {
      s: [1] Lab; hx_lab(s[..], FB_CL_WIZARD); s[0].creator[0].dev_animations = true; s[0].creator[0].preview_collapsed = false;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "animations open", true);
      s[0].creator[0].preview_collapsed = true;
      hx_draw(s[..], t[..], out[..], u[..], v); hud_screen(r[..], t[..], v, "animations shut", false);
    }
  }
  return hud_done(r[..], "everglade-experimental", HUD_GATE);
}
