// openagents.com/login: ultra-minimal centered dark-mode Apps SDK UI sign-in page
// (pure Coax DOM, zero WebGPU HUD, synced with OpenAgents Desktop pure-black palette).
// Built directly from components/skin/apps-sdk.coax + components/kit/apps-sdk.coax over dom.coax.
//   coax/bin/coax test apps/openagents-web/login-web.coax

#load "../../components/kit/apps-sdk.coax";
#load "../../components/backend/dom.coax";

LW_INBOX :: 4096;
LW_CSS :: 49152;
LW_REQ_CAP :: 1024;
LW_RESP_CAP :: 4096;

LW_CLICK :: 1;
LW_INPUT :: 2;
LW_SUBMIT :: 3;
LW_PIECE :: 4;
LW_END :: 5;
LW_PATH :: 13;

// Screens
LW_SCR_EMAIL :: 0;
LW_SCR_CODE :: 1;
LW_SCR_SIGNED_IN :: 2;

// Active HTTP requests
LW_REQ_NONE :: 0;
LW_REQ_ACCOUNT :: 1;
LW_REQ_WORKOS_CFG :: 2;
LW_REQ_START :: 3;
LW_REQ_VERIFY :: 4;
LW_REQ_LOGOUT :: 5;

LoginWeb :: struct {
  ready: bool;
  dirty: bool;
  screen: int;
  busy: bool;
  workos: bool;
  req_kind: int;
  asking: bool;
  stop_req: bool;
  email: [256] u8; email_n: int;
  code: [32] u8; code_n: int;
  sent_email: [256] u8; sent_email_n: int;
  signed_email: [256] u8; signed_email_n: int;
  next_path: [256] u8; next_path_n: int;
  ref_code: [64] u8; ref_code_n: int;
  err: [256] u8; err_n: int;
  info: [256] u8; info_n: int;
  door: [256] u8; door_n: int;
  request: [LW_REQ_CAP] u8; request_n: int;
  resp: [LW_RESP_CAP] u8; resp_n: int;
  go: [512] u8; go_n: int; go_push: bool;
  inbox: [LW_INBOX] u8;
  css: [LW_CSS] u8;
  tree: [1] Tree;
  dom: [1] Dom;
}

lw_copy :: (dst: [] u8, src: string) -> int {
  n := 0;
  for c: src { if n < dst.count { dst[n] = c; n += 1; } }
  return n;
}

lw_append :: (dst: [] u8, at: int, src: string) -> int {
  n := at;
  for c: src { if n < dst.count { dst[n] = c; n += 1; } }
  return n;
}

lw_json_str :: (dst: [] u8, at: int, src: string) -> int {
  n := lw_append(dst, at, "\"");
  for c: src {
    if c == '"' || c == '\\' { n = lw_append(dst, n, "\\"); }
    if c >= 32 && n < dst.count { dst[n] = c; n += 1; }
  }
  return lw_append(dst, n, "\"");
}

lw_set_err :: (s: [] LoginWeb, msg: string) {
  s[0].err_n = lw_copy(s[0].err[..], msg);
  s[0].info_n = 0;
}

lw_set_info :: (s: [] LoginWeb, msg: string) {
  s[0].info_n = lw_copy(s[0].info[..], msg);
  s[0].err_n = 0;
}

lw_clear_msgs :: (s: [] LoginWeb) { s[0].err_n = 0; s[0].info_n = 0; }

lw_line_val :: (resp: string, key: string) -> string {
  i := 0;
  while i < resp.count {
    e := i;
    while e < resp.count && resp[e] != '\n' && resp[e] != '\r' { e += 1; }
    line := resp[i..<e];
    if line.count > key.count && line[0..<key.count] == key && line[key.count] == ' ' {
      return line[key.count + 1..<line.count];
    }
    i = e + 1;
  }
  return "";
}

lw_valid_email :: (em: string) -> bool {
  at := -1; dot := -1;
  if em.count < 5 || em.count > 250 { return false; }
  for i: 0..<em.count {
    c := em[i];
    if c <= 32 || c == '"' || c == '\\' { return false; }
    if c == '@' { if at >= 0 { return false; } at = i; }
    else if c == '.' && at >= 0 { dot = i; }
  }
  return at > 0 && dot > at + 1 && dot < em.count - 1;
}

lw_safe_next :: (p: string) -> bool {
  if p.count < 1 || p[0] != '/' { return false; }
  if p.count >= 2 && (p[1] == '/' || p[1] == '\\') { return false; }
  for c: p { if c <= 32 { return false; } }
  return true;
}

lw_ask :: (s: [] LoginWeb, kind: int, url: string, body: string) {
  s[0].req_kind = kind;
  s[0].door_n = lw_copy(s[0].door[..], url);
  s[0].request_n = lw_copy(s[0].request[..], body);
  s[0].resp_n = 0;
  s[0].asking = true;
  if kind == LW_REQ_START || kind == LW_REQ_VERIFY || kind == LW_REQ_LOGOUT {
    s[0].busy = true;
  }
}

lw_go :: (s: [] LoginWeb, dest: string) {
  s[0].go_n = lw_copy(s[0].go[..], dest);
  s[0].go_push = false;
}

lw_parse_query :: (s: [] LoginWeb, path: string) {
  q := -1;
  for i: 0..<path.count { if path[i] == '?' { q = i + 1; break; } }
  if q < 0 { return; }
  i := q;
  while i < path.count {
    e := i;
    while e < path.count && path[e] != '&' { e += 1; }
    eq := -1;
    for j: i..<e { if path[j] == '=' { eq = j; break; } }
    if eq > i {
      k := path[i..<eq];
      v := path[eq + 1..<e];
      if k == "next" && lw_safe_next(v) {
        s[0].next_path_n = lw_copy(s[0].next_path[..], v);
      } else if k == "ref" && v.count > 0 && v.count <= 64 {
        s[0].ref_code_n = lw_copy(s[0].ref_code[..], v);
      }
    }
    i = e + 1;
  }
}

lw_submit_email :: (s: [] LoginWeb) {
  em := cast(string) s[0].email[0..<s[0].email_n];
  if !lw_valid_email(em) {
    lw_set_err(s, "Enter a valid email address.");
    return;
  }
  lw_clear_msgs(s);
  s[0].sent_email_n = lw_copy(s[0].sent_email[..], em);
  b: [512] u8;
  n := lw_append(b[..], 0, "{\"email\":");
  n = lw_json_str(b[..], n, em);
  n = lw_append(b[..], n, "}");
  url := ifx s[0].workos then "/api/auth/workos/magic/start?as=lines" else "/api/auth/email/start?as=lines";
  lw_ask(s, LW_REQ_START, url, cast(string) b[0..<n]);
}

lw_submit_code :: (s: [] LoginWeb) {
  cd := cast(string) s[0].code[0..<s[0].code_n];
  if cd.count < 4 {
    lw_set_err(s, "Enter the 6-digit verification code from your email.");
    return;
  }
  lw_clear_msgs(s);
  b: [512] u8;
  n := lw_append(b[..], 0, "{\"code\":");
  n = lw_json_str(b[..], n, cd);
  if s[0].workos && s[0].sent_email_n > 0 {
    n = lw_append(b[..], n, ",\"email\":");
    n = lw_json_str(b[..], n, cast(string) s[0].sent_email[0..<s[0].sent_email_n]);
  }
  n = lw_append(b[..], n, "}");
  url := ifx s[0].workos then "/api/auth/workos/magic/verify?as=lines" else "/api/auth/email/verify?as=lines";
  lw_ask(s, LW_REQ_VERIFY, url, cast(string) b[0..<n]);
}

lw_css :: (out: [] u8, at: int) -> int {
  n := at;
  n = as_put(out, n, "*,*::before,*::after{box-sizing:border-box}");
  n = as_put(out, n, "html,body{margin:0;min-height:100%;background:#000000;color:#ededed;font-family:var(--font-sans);-webkit-font-smoothing:antialiased}");
  n = as_put(out, n, ".lw-page{min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 20px;background:#000000;position:relative}");
  n = as_put(out, n, ".lw-box{width:100%;max-width:340px;display:flex;flex-direction:column;align-items:stretch;gap:10px}");
  n = as_put(out, n, ".lw-head{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:10px;text-align:center}");
  n = as_put(out, n, ".lw-brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none;color:#ededed;font:600 22px/1.1 var(--font-sans);letter-spacing:-.025em}");
  n = as_put(out, n, ".lw-mark{width:22px;height:22px;display:block}");
  n = as_put(out, n, ".lw-sub{margin:0;font:400 13px/1.4 var(--font-sans);color:#818181}");
  n = as_put(out, n, ".lw-oauth{display:flex;flex-direction:column;gap:8px;width:100%}");
  n = as_put(out, n, ".lw-oauth .as-btn{width:100%;height:40px;border-radius:8px;background:#111111;color:#ededed;box-shadow:inset 0 0 0 1px #2c2c2c;font:500 13.5px/1 var(--font-sans);justify-content:center;gap:8px}");
  n = as_put(out, n, ".lw-oauth .as-btn:hover{background:#191919;box-shadow:inset 0 0 0 1px #404040}");
  n = as_put(out, n, ".lw-oauth .as-btn .si-mark{width:18px;height:18px;display:block;color:#ededed;flex:none}");
  n = as_put(out, n, ".lw-or{display:flex;align-items:center;gap:12px;margin:6px 0;color:#656565;font:500 11px/1 var(--font-sans);letter-spacing:.08em;text-transform:uppercase}");
  n = as_put(out, n, ".lw-or::before,.lw-or::after{content:'';flex:1;height:1px;background:#1b1b1b}");
  n = as_put(out, n, ".lw-box .as-in-wrap{height:40px;border-radius:8px;background:#0a0a0a;box-shadow:inset 0 0 0 1px #2c2c2c}");
  n = as_put(out, n, ".lw-box .as-in-wrap:hover{box-shadow:inset 0 0 0 1px #404040}");
  n = as_put(out, n, ".lw-box .as-in-wrap:focus-within{box-shadow:inset 0 0 0 1px #3b82f6,0 0 0 2px rgba(59,130,246,.22)}");
  n = as_put(out, n, ".lw-box .as-in-wrap input{font-size:13.5px;color:#ededed}");
  n = as_put(out, n, ".lw-box .as-in-wrap input::placeholder{color:#656565}");
  n = as_put(out, n, ".lw-primary{width:100%;height:40px !important;border-radius:8px !important;background:#ededed !important;color:#0a0a0a !important;font:600 13.5px/1 var(--font-sans) !important}");
  n = as_put(out, n, ".lw-primary:hover:not(:disabled){background:#ffffff !important}");
  n = as_put(out, n, ".lw-aux{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:4px}");
  n = as_put(out, n, ".lw-in-card{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;background:#0e0e0e;border:1px solid #2c2c2c}");
  n = as_put(out, n, ".lw-foot{position:fixed;bottom:20px;left:0;right:0;padding:0 20px;text-align:center;font:400 12px/1.4 var(--font-sans);color:#656565}");
  n = as_put(out, n, ".lw-foot a{color:#818181;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#2c2c2c}");
  n = as_put(out, n, ".lw-foot a:hover{color:#ededed}");
  return n;
}

lw_oauth_btn :: (t: [] Tree, id: string, label: string, href: string, mark_href: string, use_svg: bool) {
  a := tr_open(t, id, TG_A, "as-btn as-v-outline as-c-secondary as-s-lg");
  tr_attr(t, a, AT_HREF, href);
  ida: [64] u8; idb: [64] u8;
  if use_svg {
    sv := tr_open(t, tr_cat(ida[..], id, ".ic"), TG_SVG, "si-mark");
    tr_attr(t, sv, AT_HIDDEN, "true");
    u := tr_open(t, tr_cat(idb[..], id, ".u"), TG_USE, "");
    tr_attr(t, u, AT_HREF, mark_href);
    tr_close(t);
    tr_close(t);
  } else {
    im := tr_open(t, tr_cat(ida[..], id, ".ic"), TG_IMG, "si-mark");
    tr_attr(t, im, AT_SRC, mark_href);
    tr_attr(t, im, AT_HIDDEN, "true");
    tr_close(t);
  }
  _ = tr_leaf(t, tr_cat(ida[..], id, ".l"), TG_SPAN, "", label);
  tr_close(t);
}

lw_build :: (s: [] LoginWeb) {
  t := s[0].tree[..];
  buf: [256] u8;
  tr_begin(t);

  _ = tr_open(t, "lw.page", TG_MAIN, "lw-page");
  _ = tr_open(t, "lw.box", TG_SECTION, "lw-box");

  // Brand mark + wordmark + minimal subtitle
  _ = tr_open(t, "lw.head", TG_HEADER, "lw-head");
  br := tr_open(t, "lw.brand", TG_A, "lw-brand");
  tr_attr(t, br, AT_HREF, "/");
  im := tr_open(t, "lw.brand.ic", TG_IMG, "lw-mark");
  tr_attr(t, im, AT_SRC, "/favicon.svg");
  tr_attr(t, im, AT_LABEL, "OpenAgents");
  tr_close(t);
  _ = tr_leaf(t, "lw.brand.t", TG_SPAN, "", "OpenAgents");
  tr_close(t);
  sub_txt := ifx s[0].screen == LW_SCR_CODE then "Enter the 6-digit code we sent to your email"
    else ifx s[0].screen == LW_SCR_SIGNED_IN then "Your OpenAgents account is logged in"
    else "Log in or create an account";
  _ = tr_leaf(t, "lw.sub", TG_P, "lw-sub", sub_txt);
  tr_close(t);

  if s[0].ref_code_n > 0 {
    _ = as_alert_open(t, "lw.ref.al", "Referral invite applied", "Log in to claim $10 promo credit after your first paid top-up.", AS_SUCCESS, AS_SOFT, IC_SPARKLES);
    as_alert_end(t);
  }
  if s[0].err_n > 0 {
    _ = as_alert_open(t, "lw.err", "Could not log in", cast(string) s[0].err[0..<s[0].err_n], AS_DANGER, AS_SOFT, IC_ERROR);
    as_alert_end(t);
  } else if s[0].info_n > 0 {
    _ = as_alert_open(t, "lw.info", "Code sent", cast(string) s[0].info[0..<s[0].info_n], AS_INFO, AS_SOFT, IC_MAIL);
    as_alert_end(t);
  }

  if s[0].screen == LW_SCR_EMAIL {
    _ = tr_open(t, "lw.oauth", TG_DIV, "lw-oauth");
    lw_oauth_btn(t, "lw.oauth.google", "Continue with Google", "/api/auth/workos/oauth/start?provider=GoogleOAuth", "/login/google.svg", false);
    lw_oauth_btn(t, "lw.oauth.apple", "Continue with Apple", "/api/auth/workos/oauth/start?provider=AppleOAuth", "/login/apple.svg#i", true);
    tr_close(t);

    _ = tr_leaf(t, "lw.or", TG_DIV, "lw-or", "OR");

    _ = as_input(t, "lw.email", "Email address", "email", AS_OUTLINE, AS_LG, false, -1, s[0].err_n > 0, s[0].busy);

    btn := tr_open(t, "lw.submit.email", TG_BUTTON, "as-btn as-v-solid as-c-primary as-s-lg lw-primary");
    tr_attr(t, btn, AT_TYPE, "button");
    if s[0].busy { tr_attr(t, btn, AT_DISABLED, ""); tr_attr(t, btn, AT_STATE, "busy"); _ = as_spinner(t, "lw.submit.email.sp", false); }
    _ = tr_leaf(t, "lw.submit.email.l", TG_SPAN, "", ifx s[0].busy then "Sending code…" else "Log in");
    tr_close(t);
  } else if s[0].screen == LW_SCR_CODE {
    if s[0].sent_email_n > 0 {
      _ = tr_leaf(t, "lw.code.to", TG_P, "lw-sub", tr_cat(buf[..], "Sent to ", cast(string) s[0].sent_email[0..<s[0].sent_email_n]));
    }
    _ = as_input(t, "lw.code", "6-digit code", "text", AS_OUTLINE, AS_LG, false, -1, s[0].err_n > 0, s[0].busy);

    btn := tr_open(t, "lw.submit.code", TG_BUTTON, "as-btn as-v-solid as-c-primary as-s-lg lw-primary");
    tr_attr(t, btn, AT_TYPE, "button");
    if s[0].busy { tr_attr(t, btn, AT_DISABLED, ""); tr_attr(t, btn, AT_STATE, "busy"); _ = as_spinner(t, "lw.submit.code.sp", false); }
    _ = tr_leaf(t, "lw.submit.code.l", TG_SPAN, "", ifx s[0].busy then "Verifying…" else "Verify code");
    tr_close(t);

    _ = tr_open(t, "lw.code.acts", TG_DIV, "lw-aux");
    _ = as_button(t, "lw.resend", "Resend code", AS_SECONDARY, AS_GHOST, AS_SM, false, -1, s[0].busy, false);
    _ = as_button(t, "lw.back.email", "Change email", AS_SECONDARY, AS_GHOST, AS_SM, false, -1, s[0].busy, false);
    tr_close(t);
  } else {
    _ = tr_open(t, "lw.in.card", TG_DIV, "lw-in-card");
    _ = as_avatar(t, "lw.in.av", "OA", AS_SECONDARY, AS_SOFT, AS_LG, false, true);
    _ = tr_open(t, "lw.in.tx", TG_DIV, "as-ctl-txt");
    _ = tr_leaf(t, "lw.in.em", TG_SPAN, "as-ctl-lbl", ifx s[0].signed_email_n > 0 then cast(string) s[0].signed_email[0..<s[0].signed_email_n] else "Logged in");
    _ = tr_leaf(t, "lw.in.st", TG_SPAN, "as-ctl-desc", "OpenAgents Cloud session active");
    tr_close(t);
    tr_close(t);
    dest := ifx s[0].next_path_n > 0 then cast(string) s[0].next_path[0..<s[0].next_path_n] else "/chat";
    a := tr_open(t, "lw.in.open", TG_A, "as-btn as-v-solid as-c-primary as-s-lg lw-primary");
    tr_attr(t, a, AT_HREF, dest);
    _ = tr_leaf(t, "lw.in.open.l", TG_SPAN, "", "Open Workspace");
    tr_close(t);
    _ = as_button(t, "lw.logout", ifx s[0].busy then "Logging out…" else "Log out", AS_SECONDARY, AS_OUTLINE, AS_MD, false, -1, false, s[0].busy);
  }

  tr_close(t); // lw.box

  _ = tr_open(t, "lw.foot", TG_FOOTER, "lw-foot");
  _ = tr_leaf(t, "lw.leg.0", TG_SPAN, "", "By continuing, you agree to our ");
  l1 := tr_leaf(t, "lw.leg.1", TG_A, "", "Terms of Service"); tr_attr(t, l1, AT_HREF, "/terms");
  _ = tr_leaf(t, "lw.leg.2", TG_SPAN, "", " and ");
  l2 := tr_leaf(t, "lw.leg.3", TG_A, "", "Privacy Policy"); tr_attr(t, l2, AT_HREF, "/privacy");
  _ = tr_leaf(t, "lw.leg.4", TG_SPAN, "", ".");
  tr_close(t);

  tr_close(t); // lw.page
}

lw_on_end :: (s: [] LoginWeb, status: int) {
  kind := s[0].req_kind;
  s[0].req_kind = LW_REQ_NONE;
  s[0].busy = false;
  resp := cast(string) s[0].resp[0..<s[0].resp_n];

  if kind == LW_REQ_ACCOUNT {
    if status == 200 && lw_line_val(resp, "logged_in") == "1" {
      em := lw_line_val(resp, "email");
      s[0].signed_email_n = lw_copy(s[0].signed_email[..], em);
      s[0].screen = LW_SCR_SIGNED_IN;
    } else {
      lw_ask(s, LW_REQ_WORKOS_CFG, "/api/auth/workos/config?as=lines", "");
    }
    return;
  }
  if kind == LW_REQ_WORKOS_CFG {
    s[0].workos = (status == 200 && lw_line_val(resp, "enabled") == "1");
    return;
  }
  if kind == LW_REQ_START {
    if status == 200 {
      s[0].screen = LW_SCR_CODE;
      s[0].code_n = 0;
      dm_value(s[0].dom[..], "lw.code", "");
      dm_focus(s[0].dom[..], "lw.code");
      lw_set_info(s, "Enter the 6-digit code we emailed you.");
    } else {
      err := lw_line_val(resp, "error");
      lw_set_err(s, ifx err.count > 0 then err else "Could not send log-in code. Try again.");
    }
    return;
  }
  if kind == LW_REQ_VERIFY {
    if status == 200 {
      dest := ifx s[0].next_path_n > 0 then cast(string) s[0].next_path[0..<s[0].next_path_n] else "/chat";
      lw_go(s, dest);
    } else {
      err := lw_line_val(resp, "error");
      lw_set_err(s, ifx err.count > 0 then err else "That code didn't work. Check it and try again.");
    }
    return;
  }
  if kind == LW_REQ_LOGOUT {
    s[0].screen = LW_SCR_EMAIL;
    s[0].signed_email_n = 0;
    lw_clear_msgs(s);
    return;
  }
}

lw_click :: (s: [] LoginWeb, id: string) {
  if id == "lw.submit.email" { lw_submit_email(s); }
  else if id == "lw.submit.code" { lw_submit_code(s); }
  else if id == "lw.resend" { lw_submit_email(s); }
  else if id == "lw.back.email" { s[0].screen = LW_SCR_EMAIL; lw_clear_msgs(s); dm_focus(s[0].dom[..], "lw.email"); }
  else if id == "lw.logout" { lw_ask(s, LW_REQ_LOGOUT, "/api/auth/logout?as=lines", "{}"); }
}

coaxial_loginweb_frame :: (s: [] LoginWeb, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  _ = dt; _ = reduced;
  if !s[0].ready {
    s[0].ready = true;
    s[0].dirty = true;
    lw_ask(s, LW_REQ_ACCOUNT, "/api/auth/account?as=lines", "");
  }
  if !s[0].dirty { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := apps_sdk_css(s[0].css[..], 0);
    n = lw_css(s[0].css[..], n);
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  lw_build(s);
  s[0].dirty = false;
  af: [1] AfSettings;
  bytes := dm_flush(d, s[0].tree[..], af[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}

coaxial_loginweb_busy :: (s: [] LoginWeb) -> bool #export_c #effects(all) { return s.count > 0 && s[0].dirty; }
coaxial_loginweb_inbox_cap :: () -> int #export_c #effects(all) { return LW_INBOX; }

coaxial_loginweb_event :: (s: [] LoginWeb, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  if kind == LW_PATH {
    n := ifx length < 0 then 0 else ifx length > LW_INBOX then LW_INBOX else length;
    lw_parse_query(s, cast(string) s[0].inbox[0..<n]);
    s[0].dirty = true;
    return;
  }
  if kind == LW_PIECE {
    n := ifx length < 0 then 0 else ifx length > LW_INBOX then LW_INBOX else length;
    for i: 0..<n { if s[0].resp_n < LW_RESP_CAP { s[0].resp[s[0].resp_n] = s[0].inbox[i]; s[0].resp_n += 1; } }
    return;
  }
  if kind == LW_END {
    lw_on_end(s, slot);
    s[0].dirty = true;
    return;
  }
  id := dm_slot_id(s[0].dom[..], slot);
  if id.count == 0 { return; }
  if kind == LW_CLICK { lw_click(s, id); }
  else if kind == LW_INPUT {
    n := ifx length < 0 then 0 else ifx length > LW_INBOX then LW_INBOX else length;
    txt := cast(string) s[0].inbox[0..<n];
    if id == "lw.email" { s[0].email_n = lw_copy(s[0].email[..], txt); }
    else if id == "lw.code" { s[0].code_n = lw_copy(s[0].code[..], txt); }
  } else if kind == LW_SUBMIT {
    if id == "lw.email" { lw_submit_email(s); }
    else if id == "lw.code" { lw_submit_code(s); }
  }
  s[0].dirty = true;
}

coaxial_loginweb_asking :: (s: [] LoginWeb) -> bool #export_c #effects(all) { return s.count > 0 && s[0].asking; }
coaxial_loginweb_ask_len :: (s: [] LoginWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].request_n else 0; }
coaxial_loginweb_asked :: (s: [] LoginWeb) #export_c #effects(all) { if s.count > 0 { s[0].asking = false; } }
coaxial_loginweb_stop :: (s: [] LoginWeb) -> bool #export_c #effects(all) {
  if s.count < 1 || !s[0].stop_req { return false; }
  s[0].stop_req = false;
  return true;
}
coaxial_loginweb_go_len :: (s: [] LoginWeb) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].go_n else 0; }
coaxial_loginweb_go_push :: (s: [] LoginWeb) -> bool #export_c #effects(all) { return s.count > 0 && s[0].go_push; }
coaxial_loginweb_go_done :: (s: [] LoginWeb) #export_c #effects(all) { if s.count > 0 { s[0].go_n = 0; } }

LwTest :: struct { s: [1] LoginWeb; }

#test "login-web renders minimal centered pure-black auth flow without SSO or side panel" {
  h: [1] LwTest; s := h[0].s[..];
  n := coaxial_loginweb_frame(s, 0.016, true);
  t := s[0].tree[..]; d := s[0].dom[..];
  #assert n > 10000 && t[0].lost == 0 && t[0].depth == 0;
  #assert tr_find(t, "lw.box") > 0 && tr_find(t, "lw.email") > 0 && tr_find(t, "lw.submit.email") > 0;
  #assert tr_find(t, "lw.oauth.github") < 0 && tr_find(t, "lw.oauth.google") > 0 && tr_find(t, "lw.oauth.apple") > 0;
  #assert tr_find(t, "lw.stage") < 0 && tr_find(t, "lw.go.sso") < 0 && tr_find(t, "lw.leg.0") > 0;
  #assert coaxial_loginweb_asking(s) && cast(string) s[0].door[0..<s[0].door_n] == "/api/auth/account?as=lines";
  coaxial_loginweb_asked(s);

  a0 := "logged_in 0\n";
  for i: 0..<a0.count { s[0].inbox[i] = a0[i]; }
  coaxial_loginweb_event(s, LW_PIECE, 200, a0.count);
  coaxial_loginweb_event(s, LW_END, 200, 0);
  coaxial_loginweb_asked(s);
  w0 := "enabled 1\n";
  for i: 0..<w0.count { s[0].inbox[i] = w0[i]; }
  coaxial_loginweb_event(s, LW_PIECE, 200, w0.count);
  coaxial_loginweb_event(s, LW_END, 200, 0);
  #assert s[0].workos;

  qp := "/login?next=/projects&ref=CHRIS99";
  for i: 0..<qp.count { s[0].inbox[i] = qp[i]; }
  coaxial_loginweb_event(s, LW_PATH, 0, qp.count);
  _ = coaxial_loginweb_frame(s, 0.016, true);
  #assert tr_find(t, "lw.ref.al") > 0 && cast(string) s[0].next_path[0..<s[0].next_path_n] == "/projects";

  coaxial_loginweb_event(s, LW_CLICK, dm_find(d, "lw.submit.email"), 0);
  _ = coaxial_loginweb_frame(s, 0.016, true);
  #assert tr_find(t, "lw.err") > 0;

  em := "chris@openagents.com";
  for i: 0..<em.count { s[0].inbox[i] = em[i]; }
  coaxial_loginweb_event(s, LW_INPUT, dm_find(d, "lw.email"), em.count);
  coaxial_loginweb_event(s, LW_SUBMIT, dm_find(d, "lw.email"), 0);
  coaxial_loginweb_asked(s);
  coaxial_loginweb_event(s, LW_END, 200, 0);
  _ = coaxial_loginweb_frame(s, 0.016, true);
  #assert s[0].screen == LW_SCR_CODE && tr_find(t, "lw.code") > 0;

  cd := "123456";
  for i: 0..<cd.count { s[0].inbox[i] = cd[i]; }
  coaxial_loginweb_event(s, LW_INPUT, dm_find(d, "lw.code"), cd.count);
  coaxial_loginweb_event(s, LW_SUBMIT, dm_find(d, "lw.code"), 0);
  coaxial_loginweb_asked(s);
  coaxial_loginweb_event(s, LW_END, 200, 0);
  #assert coaxial_loginweb_go_len(s) > 0 && cast(string) s[0].go[0..<s[0].go_n] == "/projects";
}
