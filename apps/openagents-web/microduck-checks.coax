// Input journeys and a quantized geometry receipt for the HUD and shared camera.
#load "../../metaverse-engine/core/replay.coax";

#test "both key cases, presets and arrow directions operate on the retained orbit" {
  s: [1] Microduck;
  for key: [2] int.[110, 78] { s[0].mode = 0; #assert md_key(s[..], key) && s[0].mode == 1; #assert md_key(s[..], key) && s[0].mode == 0; }
  for key: [2] int.[114, 82] {
    s[0].yaw = 1; s[0].pitch = 1; s[0].zoom = 1; s[0].mode = 1; s[0].drag = true;
    #assert md_key(s[..], key) && s[0].yaw == 3.85 && s[0].pitch == 0.24 && s[0].zoom == 0.74 && s[0].mode == 0 && !s[0].drag;
  }
  s[0].yaw = 0; #assert md_key(s[..], -4) && s[0].yaw == -0.12;
  #assert md_key(s[..], -5) && s[0].yaw == 0;
  s[0].yaw = 0; s[0].pitch = 0; #assert md_key(s[..], 49) && s[0].yaw == 3.85 && s[0].pitch == 0.24;
  #assert md_key(s[..], 50) && s[0].yaw == 4.712389 && s[0].pitch == 0.05;
  #assert md_key(s[..], 51) && s[0].pitch == 1.3;
  for key: [8] int.[-6, -3, 48, 52, 79, 83, 111, 115] { #assert !md_key(s[..], key); }
}
#test "pointer ownership, DPR and release preserve the exact orbit deltas" {
  s: [1] Microduck;
  #assert !md_pointer(s[..], 100, 100, 1, 0, 1);
  s[0].yaw = 0; s[0].pitch = 0; s[0].dpr = 2;
  #assert md_pointer(s[..], 10, 20, 0, 0, 7) && s[0].drag && s[0].pointer_id == 7 && s[0].px == 10 && s[0].py == 20;
  #assert !md_pointer(s[..], 40, 60, 1, 0, 8) && s[0].px == 10;
  #assert md_pointer(s[..], 30, 60, 1, 0, 7);
  #assert abs(s[0].yaw + 0.06) < 0.000001 && abs(s[0].pitch - 0.12) < 0.000001 && s[0].px == 30 && s[0].py == 60;
  #assert md_pointer(s[..], 30, -10000, 1, 0, 7) && s[0].pitch == -0.15;
  #assert md_pointer(s[..], 30, 10000, 1, 0, 7) && s[0].pitch == 1.3;
  #assert md_pointer(s[..], 30, 60, 2, 0, 7) && !s[0].drag;
  #assert !md_pointer(s[..], 30, 60, 2, 0, 7);
  s[0].zoom = 1; md_wheel(s[..], 100); #assert abs(s[0].zoom - 1.05) < 0.000001;
}
#test "a refused replacement pack clears the old ready state before a later catalog" {
  s: [1] Microduck;
  for k: 0..<32 { s[0].digest[k] = cast(u8) (asset_digit(MD_PACK_SHA[k * 2]) * 16 + asset_digit(MD_PACK_SHA[k * 2 + 1])); }
  #assert md_gate(s[..], MD_PACK_BYTES) && s[0].admitted && !s[0].ready;
  md_asset(s[..], ""); #assert !s[0].ready;
  md_test_asset(s[..]); #assert s[0].ready;
  #assert !md_gate(s[..], 0) && !s[0].admitted && !s[0].ready;
  md_asset(s[..], "bad"); #assert !s[0].ready;
}
#test "a small high-DPR viewport clips the header through the shared pen" {
  s: [1] Microduck; out: [MD_HUD_VERTICES * 12] f32; u: [MD_UNIFORMS] f32;
  n := md_frame(s[..], out[..], u[..], 900, 100, 2);
  // Every stroke's first vertex remains near this short viewport; no y=108 header can escape.
  for stroke: 0..<n / 6 { #assert out[stroke * 72 + 1] < 125; }
}
#test "invalid dimensions and a short uniform span produce no frame" {
  s: [1] Microduck; out: [1] f32; u: [MD_UNIFORMS] f32;
  for value: [2] f32.[0, -1] {
    s[0].dpr = 9; u[0] = 777;
    #assert md_frame(s[..], out[..], u[..], value, 800, 1) == 0;
    #assert s[0].dpr == 9 && u[0] == 777;
    #assert md_frame(s[..], out[..], u[..], 1280, value, 1) == 0;
    #assert s[0].dpr == 9 && u[0] == 777;
    #assert md_frame(s[..], out[..], u[..], 1280, 800, value) == 0;
    #assert s[0].dpr == 9 && u[0] == 777;
  }
  #assert md_frame(s[..], out[..], u[0..<MD_UNIFORMS-1], 1280, 800, 1) == 0;
}

md_test_asset :: (s:[]Microduck) {a:[1]RigidAssembly;a[0]=assembly_fixture();a[0].source=md_source();b:[8192]u8;n:=assembly_catalogue_write(a[..],b[..]);s[0].admitted=true;md_asset(s,cast(string)b[0..<n]);}
#test "the viewer poses selected joints and explosion preserves the admitted mechanical state" {
 s:[1]Microduck;md_test_asset(s[..]);#assert s[0].ready && s[0].assembly[0].parts==3;#assert md_key(s[..],1000) && s[0].joint==0 && s[0].selected==0;
 #assert md_key(s[..],43) && abs(s[0].angles[0]-0.0872664626)<0.000001;old:=s[0].angles;#assert md_key(s[..],120) && s[0].explosion==1 && s[0].angles[0]==old[0] && s[0].zoom==1.6;
 #assert md_key(s[..],120) && s[0].explosion==0 && s[0].zoom==0.74;#assert md_key(s[..],120);s[0].zoom=1.2;
 #assert !md_angle(s[..],0,3) && s[0].angles[0]==old[0];#assert md_key(s[..],2002) && s[0].selected==2 && s[0].joint== -1;#assert !md_key(s[..],43);
 #assert md_key(s[..],114) && s[0].explosion==0 && s[0].angles[0]==0 && s[0].angles[1]==0 && s[0].joint== -1 && s[0].selected== -1;
 b:[32768]u8;n:=md_menu(s[..],b[..]);#assert n>0;nodes:[4096]JvNode;d:[1]Jv;#assert jv_parse(d[..],cast(string)b[0..<n],nodes[..]);#assert jv_len(d[0],jv_get(d[0],0,"items"))==37;
 s[0].assembly[0].joints=32;s[0].assembly[0].parts=96;b[0]=77;#assert md_menu(s[..],b[..])== -1 && b[0]==77;
}
#test "actual workbench controls compose servo pose plots refusal and background admission" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3000) && s[0].lab[0].active;md_advance(s[..],0);
 md_advance(s[..],0.02);#assert s[0].lab[0].session[0].snapshot.steps==9 || s[0].lab[0].session[0].snapshot.steps==10;
 for i:0..<20 {md_advance(s[..],0.02);}#assert s[0].angles[0]>0;
 packet:[SLW_SIZE]u8;#assert md_lab_packet(s[..],packet[..]);decoded:[1]RslPacket;#assert slw_read(packet[..],slw_digest(packet[..]),decoded[..]) && decoded[0].config.joint==0;
 before:=s[0].lab[0].session[0];angle:=s[0].angles[0];#assert !md_key(s[..],3011) && s[0].lab[0].status==RslStatus.config && rsl_same(before,s[0].lab[0].session[0]) && s[0].angles[0]==angle;
 out:[MD_HUD_VERTICES*12]f32;u:[MD_UNIFORMS]f32;#assert md_frame(s[..],out[..],u[..],430,900,1)>0;
 md_message(s[..],601);md_advance(s[..],0.05);md_message(s[..],602);md_advance(s[..],5);#assert rsl_same(before,s[0].lab[0].session[0]);
 #assert md_key(s[..],3001) && s[0].lab[0].session[0].config.p.delay==16;md_advance(s[..],0);md_advance(s[..],0.016);#assert s[0].lab[0].session[0].last.position==0;
 #assert md_key(s[..],3002) && s[0].lab[0].session[0].config.p.effort.value==0.03;
 #assert md_key(s[..],114) && !s[0].lab[0].active && s[0].angles[0]==0;
}
#test "saved app records retain the actual servo state through replay and branching" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3001);md_advance(s[..],0);md_advance(s[..],0.004);#assert md_key(s[..],3004);md_advance(s[..],0.004);
 b:[RSW_MAX]u8;n:=md_run_packet(s[..],b[..]);#assert n==1100;old:=s[0].lab[0].session[0];#assert md_run_load(s[..],b[0..<n]) && s[0].lab[0].playback;
 #assert rsr_snapshot_same(s[0].lab[0].session[0].snapshot,old.snapshot,old.config);#assert md_key(s[..],3205) && s[0].lab[0].session[0].snapshot.steps==0;
 #assert md_key(s[..],3207) && s[0].lab[0].session[0].snapshot.steps==old.snapshot.steps;
 #assert md_key(s[..],3208) && !s[0].lab[0].playback && s[0].lab[0].initial.steps==old.snapshot.steps;
}
#test "valid records with altered source limits refuse atomically at the viewer" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3000);other:[1]MdLab;c:=s[0].lab[0].session[0].config;c.low-=0.25;#assert mdl_begin(other[..],c);
 wrong:[RSW_MAX]u8;n:=mdl_save(other[..],wrong[..]);#assert n==1088;before:=s[0].angles;#assert !md_run_load(s[..],wrong[0..<n]) && s[0].angles[0]==before[0] && !s[0].lab[0].playback;
}
#test "the source stand coordinate keeps its exact signed zero word" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3000);other:[1]MdLab;c:=s[0].lab[0].session[0].config;c.stand=f64_from_bits(0x8000000000000000);#assert mdl_begin(other[..],c);
 wrong:[RSW_MAX]u8;n:=mdl_save(other[..],wrong[..]);#assert n==1088 && !md_run_load(s[..],wrong[0..<n]) && !s[0].lab[0].playback;
}
#test "stale storage replies preserve the active app while a matching full record opens" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3000);b:[RSW_MAX]u8;n:=md_run_packet(s[..],b[..]);#assert n==1088;
 #assert md_key(s[..],3201);req:=md_run_storage(s[..]);#assert req.operation==2;#assert md_key(s[..],3000);
 reply:[16+RSW_MAX]u8;_:=cb_store_le32(reply[..],0,cast(u32)req.token);_:=cb_store_le32(reply[..],8,cast(u32)n);_:=cb_store_le32(reply[..],12,cast(u32)n);for i:0..<n {reply[16+i]=b[i];}
 md_run_inbox(s[..],768,reply[0..<16+n]);#assert !s[0].lab[0].playback && s[0].files[0].status==3;
 #assert md_key(s[..],3201);req=md_run_storage(s[..]);_:=cb_store_le32(reply[..],0,cast(u32)req.token);md_run_inbox(s[..],768,reply[0..<16+n]);#assert s[0].lab[0].playback && s[0].files[0].status==2;
}
#test "a share acknowledgement means file offered and an invalid import preserves the active run" {
 s:[1]Microduck;md_test_asset(s[..]);#assert md_key(s[..],3000) && md_key(s[..],3202);token:=s[0].files[0].token;b:[1]u8;
 md_run_document_reply(s[..],token,0,b[0..<0]);#assert s[0].files[0].status==7 && s[0].lab[0].active && !s[0].lab[0].playback;
 #assert md_key(s[..],3203);token=s[0].files[0].token;md_run_document_reply(s[..],token,0,b[..]);#assert s[0].files[0].status==5 && s[0].lab[0].active && !s[0].lab[0].playback;
}
