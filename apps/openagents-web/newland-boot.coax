// Verse OS's boot sequence over the Grid (docs/os/2026-11-02-verse-os.md, V1): when the machine's
// session opens the Grid (os/verse-session.coax), it passes what came up as page facts, one line
// each, `boot=LABEL|VALUE|STATE` (STATE 1 ready, 0 failed, 2 waiting). The screen starts black: a
// line is drawn across it, a frame assembles round the middle, the lines are typed in one after
// another, each with READY or FAILED, and then the world fades in under them as they go. A failed
// line stays red and says why. With no boot facts (the website, every check) nothing changes.
// Loaded by newland.coax; the face calls coaxial_land_boot_frame after either page's frame.
//
// Your identity (V2): when the IDENTITY line is WAITING, the Grid says so once the sequence is over,
// and N asks the session to make one (it navigates to /realms/verse-os-identity, which
// os/verse-session.coax answers with `openagents nostr new`). The session opens the Grid again with
// the 12 words as `seed=` and the key as `npub=` facts, from a file in the user's runtime directory
// that vk-realm removes as it reads it (--facts-once). The words are shown once, over a dimmed
// world, behind a warning; Enter says they are written down and wipes them from memory.

BOOT_LINES :: 10;
BOOT_LABEL :: 24; BOOT_VALUE :: 96;
BOOT_READY :: 1; BOOT_FAILED :: 0; BOOT_WAITING :: 2;
BOOT_SWEEP :: 0.6;     // seconds: the line across the screen
BOOT_FRAME :: 0.5;     // the frame assembling, after the sweep
BOOT_EVERY :: 0.22;    // between one line and the next
BOOT_HOLD :: 0.9;      // the last line held before the world comes in
BOOT_FADE :: 0.8;      // the world fading in, and the sequence fading out

LandBoot :: struct {
  n: int;
  label: [BOOT_LINES][BOOT_LABEL] u8; label_n: [BOOT_LINES] int;
  value: [BOOT_LINES][BOOT_VALUE] u8; value_n: [BOOT_LINES] int;
  state: [BOOT_LINES] int;
  seed: [256] u8; seed_n: int;   // the 12 words, while they are shown (then wiped)
  npub: [80] u8; npub_n: int;
  asked: bool;                   // N was pressed: the session is making the identity
}
BOOT_IDENTITY_URL :: "/realms/verse-os-identity";

// One boot= line's fields into slot k: whether it was well formed.
boot_line :: (b: [] LandBoot, k: int, line: string) -> bool {
  bar1 := -1; bar2 := -1;
  for i: 0..<line.count { if line[i] == '|' { if bar1 < 0 { bar1 = i; } else if bar2 < 0 { bar2 = i; } } }
  if bar1 < 1 || bar2 < 0 || bar2 + 2 != line.count { return false; }
  st := line[bar2 + 1];
  if st != '0' && st != '1' && st != '2' { return false; }
  ln := lo_int(bar1, BOOT_LABEL); vn := lo_int(bar2 - bar1 - 1, BOOT_VALUE);
  for i: 0..<ln { b[0].label[k][i] = line[i]; }
  for i: 0..<vn { b[0].value[k][i] = line[bar1 + 1 + i]; }
  b[0].label_n[k] = ln; b[0].value_n[k] = vn; b[0].state[k] = cast(int) (st - '0');
  return true;
}

// The page facts' boot= lines, in their order; any other line is left to its reader. A second set
// of facts replaces the first (the session sends them once, before the first frame).
boot_facts :: (b: [] LandBoot, facts: string) {
  if b.count != 1 { return; }
  i := 0; n := 0; any := false;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    if e - i > 5 && facts[i..<i + 5] == "boot=" {
      if !any { any = true; }
      if n < BOOT_LINES && boot_line(b, n, facts[i + 5..<e]) { n += 1; }
    }
    i = e + 1;
  }
  if any { b[0].n = n; }
  i = 0;
  while i < facts.count {
    e := i; while e < facts.count && facts[e] != '\n' { e += 1; }
    if e - i > 5 && facts[i..<i + 5] == "seed=" && e - i - 5 <= 256 { m := e - i - 5; for k: 0..<m { b[0].seed[k] = facts[i + 5 + k]; } b[0].seed_n = m; }
    if e - i > 5 && facts[i..<i + 5] == "npub=" && e - i - 5 <= 80 { m := e - i - 5; for k: 0..<m { b[0].npub[k] = facts[i + 5 + k]; } b[0].npub_n = m; }
    i = e + 1;
  }
}
// The IDENTITY line, or -1.
boot_identity_line :: (b: [] LandBoot) -> int {
  for k: 0..<b[0].n { if cast(string) b[0].label[k][0..<b[0].label_n[k]] == "IDENTITY" { return k; } }
  return -1;
}
// Whether the machine has no identity yet and nothing is making one: the Grid offers N.
boot_offers_identity :: (b: [] LandBoot) -> bool {
  k := boot_identity_line(b);
  return k >= 0 && b[0].state[k] == BOOT_WAITING && b[0].seed_n == 0 && !b[0].asked;
}
// The words shown, wiped: every byte zeroed, the IDENTITY line READY with the key.
boot_words_written :: (b: [] LandBoot) {
  for k: 0..<256 { b[0].seed[k] = 0; }
  b[0].seed_n = 0;
  k := boot_identity_line(b);
  if k >= 0 {
    b[0].state[k] = BOOT_READY;
    n := lo_int(b[0].npub_n, BOOT_VALUE);
    for i: 0..<n { b[0].value[k][i] = b[0].npub[i]; }
    b[0].value_n[k] = n;
  }
}
#test "identity: offered when waiting, the words held until Enter, then wiped" {
  b: [1] LandBoot;
  boot_facts(b[..], "boot=GPU|x|1\nboot=IDENTITY|none yet|2\n");
  #assert boot_offers_identity(b[..]) && boot_identity_line(b[..]) == 1;
  b[0].asked = true;
  #assert !boot_offers_identity(b[..]);
  c: [1] LandBoot;
  boot_facts(c[..], "boot=IDENTITY|made|1\nseed=one two three\nnpub=npub1abc\n");
  #assert c[0].seed_n == 13 && c[0].npub_n == 8 && !boot_offers_identity(c[..]);
  boot_words_written(c[..]);
  #assert c[0].seed_n == 0 && c[0].seed[0] == 0 && c[0].seed[12] == 0 && cast(string) c[0].value[0][0..<c[0].value_n[0]] == "npub1abc";
  d: [1] LandBoot;
  boot_facts(d[..], "boot=IDENTITY|Nostr key on this machine|1\n");
  #assert !boot_offers_identity(d[..]);
}
#test "boot facts: well-formed lines in order, the rest left alone" {
  b: [1] LandBoot;
  boot_facts(b[..], "now=1\nboot=GPU|NVIDIA GeForce RTX 4080|1\nurl=/x\nboot=WALLET|no wallet yet|0\nboot=bad\nboot=PYLON|starting|2\n");
  #assert b[0].n == 3 && b[0].state[0] == BOOT_READY && b[0].state[1] == BOOT_FAILED && b[0].state[2] == BOOT_WAITING;
  #assert cast(string) b[0].label[0][0..<b[0].label_n[0]] == "GPU" && cast(string) b[0].value[1][0..<b[0].value_n[1]] == "no wallet yet";
  c: [1] LandBoot;
  boot_facts(c[..], "now=1\ntab=native\n");
  #assert c[0].n == 0;
  boot_facts(c[..], "boot=|x|1\nboot=A|x|3\nboot=A|x|1z\nboot=A||1\n");
  #assert c[0].n == 1 && c[0].value_n[0] == 0;
  many: [1] LandBoot;
  for k: 0..<12 { boot_facts(many[..], "boot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\nboot=A|b|1\n"); }
  #assert many[0].n == BOOT_LINES;
}

// When the last line is in and held: the world starts coming in here.
boot_end :: (n: int) -> f32 { return BOOT_SWEEP + BOOT_FRAME + cast(f32) n * BOOT_EVERY + BOOT_HOLD; }
// The world's light at time t (1 when there is no boot sequence).
boot_world :: (n: int, t: f32) -> f32 {
  if n <= 0 { return 1; }
  return ease((t - boot_end(n)) / BOOT_FADE);
}
// The sequence's own light: full until the world is in, then gone over BOOT_FADE more.
boot_light :: (n: int, t: f32) -> f32 {
  if n <= 0 { return 0; }
  return 1 - ease((t - boot_end(n) - BOOT_FADE * 0.5) / BOOT_FADE);
}
// How many lines show at t.
boot_shown :: (n: int, t: f32) -> int {
  if n <= 0 { return 0; }
  k := cast(int) floor((t - BOOT_SWEEP - BOOT_FRAME) / BOOT_EVERY) + 1;
  if k < 0 { return 0; }
  return lo_int(k, n);
}
#test "the timeline: black, then the lines, then the world" {
  #assert boot_world(0, 0) == 1 && boot_light(0, 0) == 0 && boot_shown(0, 5) == 0;
  #assert boot_world(4, 0) == 0 && boot_light(4, 0) == 1 && boot_shown(4, 0) == 0;
  #assert boot_shown(4, BOOT_SWEEP + BOOT_FRAME) == 1 && boot_shown(4, BOOT_SWEEP + BOOT_FRAME + BOOT_EVERY * 1.5) == 2;
  #assert boot_shown(4, 100) == 4 && boot_world(4, boot_end(4)) == 0;
  #assert boot_world(4, boot_end(4) + BOOT_FADE) == 1 && boot_light(4, boot_end(4) + BOOT_FADE * 2) == 0;
  #assert boot_light(4, boot_end(4)) == 1;
}

// The frame's vertices [0, n) dimmed to the world's light, and the sequence drawn over them: the
// new count. Nothing at all when the session sent no boot lines.
boot_frame :: (out: [] f32, n: int, uniforms: [] f32, b: [] LandBoot, t: f32, width: f32, height: f32, dpr: f32) -> int {
  if b.count != 1 || b[0].n <= 0 { return n; }
  if b[0].seed_n > 0 { return boot_words(out, n, uniforms, b, t, width, height, dpr); }
  world := boot_world(b[0].n, t);
  if world < 1 {
    for q: 0..<n { out[q * VERTEX_FLOATS + 6] *= world; }
    // the HUD's glass panels (newland.coax glass: alpha at slot 5 of each eight) go with the world
    for k: 0..<PANELS + EDIT_PANELS { o := 8 + k * 8 + 5; if o < uniforms.count { uniforms[o] *= world; } }
  }
  light := boot_light(b[0].n, t);
  if light <= 0 { return boot_offer(out, n, b, t, width, height, dpr); }
  d := hi(dpr, 1);
  p := Pen.{d = d, fade = 1, time = t, still = false, phone = width < height};
  cx := width * 0.5; cy := height * 0.5;
  w := lo(560 * d, width - 48 * d); h := (64 + cast(f32) b[0].n * 26) * d;
  x0 := cx - w * 0.5; x1 := cx + w * 0.5; y0 := cy - h * 0.5; y1 := cy + h * 0.5;
  bright := dimmed(ink(p, INK_BRIGHT), light); blue := dimmed(ink(p, INK_BLUE), light);
  v := n;
  // the sweep: one line out from the middle to the edges
  s := ease(t / BOOT_SWEEP);
  v = rule(out, v, cx - cx * s, cy, cx + cx * s, cy, blue, light * (1 - 0.7 * ease((t - BOOT_SWEEP) / BOOT_FRAME)));
  // the frame: its brackets drawn in from the corners, then its faint outline
  f := ease((t - BOOT_SWEEP) / BOOT_FRAME);
  if f > 0 {
    arm := 28 * d * f;
    v = rule(out, v, x0, y0, x0 + arm, y0, bright, light); v = rule(out, v, x0, y0, x0, y0 + arm * 0.6, bright, light);
    v = rule(out, v, x1, y1, x1 - arm, y1, bright, light); v = rule(out, v, x1, y1, x1, y1 - arm * 0.6, bright, light);
    faint := dimmed(ink(p, INK_FAINT), light * f);
    v = rule(out, v, x0 + arm, y0, x1, y0, faint, faint.light); v = rule(out, v, x1, y0, x1, y1 - arm * 0.6, faint, faint.light);
    v = rule(out, v, x1 - arm, y1, x0, y1, faint, faint.light); v = rule(out, v, x0, y1, x0, y0 + arm * 0.6, faint, faint.light);
    v = put(out, v, "VERSE OS", x0 + 18 * d, y0 + 26 * d, 9 * d, dimmed(chrome(ink(p, INK_BRIGHT)), light * f));
  }
  // the lines, typed in: label, value, and what became of it
  shown := boot_shown(b[0].n, t);
  for k: 0..<shown {
    y := y0 + (54 + cast(f32) k * 26) * d;
    age := t - (BOOT_SWEEP + BOOT_FRAME + cast(f32) k * BOOT_EVERY);
    typed := ease(age / 0.18);
    label := cast(string) b[0].label[k][0..<b[0].label_n[k]];
    value := cast(string) b[0].value[k][0..<b[0].value_n[k]];
    v = put(out, v, label, x0 + 18 * d, y, 7 * d, dimmed(ink(p, INK_DIM), light * typed));
    v = put_fit(out, v, value, x0 + 120 * d, y, 7 * d, dimmed(ink(p, INK_PALE), light * typed), w - 230 * d);
    st := b[0].state[k];
    mark := ifx st == BOOT_READY then "READY" else ifx st == BOOT_FAILED then "FAILED" else "WAITING";
    mk := ifx st == BOOT_READY then blue else dimmed(ink(p, INK_DIM), light);
    if st == BOOT_FAILED { mk.red = 1.0; mk.green = 0.32; mk.blue = 0.28; mk.light = light; }
    v = put(out, v, mark, x1 - 18 * d - text_width(mark, 7 * d, mk), y, 7 * d, dimmed(mk, typed));
  }
  return v;
}
#test "the sequence draws over a black world, then leaves it be" {
  s: [1] LandState;
  coaxial_land_message(s[..], 600, "boot=GPU|RTX 4080|1\nboot=WALLET|none yet|0\n");
  #assert s[0].boot[0].n == 2;
  out: [600000] f32; u: [UNIFORM_FLOATS] f32;
  for q: 0..<100 { out[q * VERTEX_FLOATS + 6] = 1; }
  u[13] = 0.9;
  m := boot_frame(out[..], 100, u[..], s[0].boot[..], 2.0, 1440, 900, 1);
  #assert m > 100 && out[6] == 0 && u[13] == 0;
  u[13] = 0.9;
  late := boot_frame(out[..], 100, u[..], s[0].boot[..], 30, 1440, 900, 1);
  #assert late == 100 && u[13] == 0.9f32;
  none: [1] LandState;
  #assert boot_frame(out[..], 100, u[..], none[0].boot[..], 0, 1440, 900, 1) == 100;
}

coaxial_land_boot_frame :: (s: [] LandState, out: [] f32, uniforms: [] f32, n: int, width: f32, height: f32, dpr: f32) -> int #export_c {
  if s.count < 1 || n < 0 { return n; }
  return boot_frame(out, n, uniforms, s[0].boot[..], s[0].time, width, height, dpr);
}

// After the sequence, while there is no identity: one line at the foot of the screen.
boot_offer :: (out: [] f32, n: int, b: [] LandBoot, t: f32, width: f32, height: f32, dpr: f32) -> int {
  if !boot_offers_identity(b) { return n; }
  d := hi(dpr, 1);
  p := Pen.{d = d, fade = 1, time = t, still = false, phone = width < height};
  pulse := 0.75 + 0.25 * sin(t * 3);
  text := "NO IDENTITY ON THIS MACHINE  ·  PRESS N TO MAKE ONE";
  k := dimmed(chrome(ink(p, INK_BLUE)), pulse);
  return put_centred(out, n, text, width * 0.5, height - 64 * d, 8 * d, k);
}
// The 12 words, over a world dimmed almost away: a warning, the words in three columns, and Enter.
boot_words :: (out: [] f32, n: int, uniforms: [] f32, b: [] LandBoot, t: f32, width: f32, height: f32, dpr: f32) -> int {
  for q: 0..<n { out[q * VERTEX_FLOATS + 6] *= 0.12; }
  for k: 0..<PANELS + EDIT_PANELS { o := 8 + k * 8 + 5; if o < uniforms.count { uniforms[o] *= 0.12; } }
  d := hi(dpr, 1);
  p := Pen.{d = d, fade = 1, time = t, still = false, phone = width < height};
  cx := width * 0.5; cy := height * 0.5;
  w := lo(620 * d, width - 48 * d); h := 300 * d;
  x0 := cx - w * 0.5; x1 := cx + w * 0.5; y0 := cy - h * 0.5; y1 := cy + h * 0.5;
  bright := ink(p, INK_BRIGHT); warn := ink(p, INK_BRIGHT); warn.red = 1.0; warn.green = 0.55; warn.blue = 0.3;
  v := n; arm := 28 * d;
  v = rule(out, v, x0, y0, x0 + arm, y0, bright, 1); v = rule(out, v, x0, y0, x0, y0 + arm * 0.6, bright, 1);
  v = rule(out, v, x1, y1, x1 - arm, y1, bright, 1); v = rule(out, v, x1, y1, x1, y1 - arm * 0.6, bright, 1);
  v = put(out, v, "YOUR IDENTITY", x0 + 18 * d, y0 + 28 * d, 9 * d, chrome(bright));
  v = put_fit(out, v, "These 12 words are your Nostr key and your wallet. They are shown once.", x0 + 18 * d, y0 + 52 * d, 7 * d, warn, w - 36 * d);
  v = put_fit(out, v, "Write them down. Anyone with them is you; without them a lost key is gone.", x0 + 18 * d, y0 + 70 * d, 7 * d, ink(p, INK_PALE), w - 36 * d);
  // the words: numbered, three columns of four
  words: [12] string; seed := cast(string) b[0].seed[0..<b[0].seed_n];
  c := 0; i := 0;
  while i < seed.count && c < 12 {
    while i < seed.count && seed[i] == ' ' { i += 1; }
    s0 := i; while i < seed.count && seed[i] != ' ' { i += 1; }
    if i > s0 { words[c] = seed[s0..<i]; c += 1; }
  }
  col := (w - 36 * d) / 3;
  for k: 0..<c {
    x := x0 + 18 * d + cast(f32) (k / 4) * col; y := y0 + (110 + cast(f32) (k % 4) * 30) * d;
    nb: [4] u8; nn := number(k + 1, nb[..]);
    v = put(out, v, cast(string) nb[0..<nn], x, y, 7 * d, ink(p, INK_DIM));
    v = put(out, v, words[k], x + 26 * d, y, 9 * d, chrome(bright));
  }
  v = put_fit(out, v, cast(string) b[0].npub[0..<b[0].npub_n], x0 + 18 * d, y1 - 46 * d, 7 * d, ink(p, INK_DIM), w - 36 * d);
  return put(out, v, "PRESS ENTER WHEN THEY ARE WRITTEN DOWN", x0 + 18 * d, y1 - 22 * d, 8 * d, dimmed(chrome(ink(p, INK_BLUE)), 0.75 + 0.25 * sin(t * 3)));
}
// The boot layer's keys, ahead of the page's: N asks for an identity, Enter puts the words away.
coaxial_land_boot_key :: (s: [] LandState, key: int) -> bool #export_c {
  if s.count < 1 { return false; }
  b := s[0].boot[..];
  if b[0].seed_n > 0 { if key == KEY_ENTER { boot_words_written(b); return true; } return true; }   // nothing else while the words show
  if (key == 'n' || key == 'N') && boot_offers_identity(b) && boot_light(b[0].n, s[0].time) <= 0 {
    b[0].asked = true; go(s, BOOT_IDENTITY_URL); return true;
  }
  return false;
}
#test "N and Enter" {
  s: [1] LandState;
  coaxial_land_message(s[..], 600, "boot=IDENTITY|none yet|2\n");
  #assert !coaxial_land_boot_key(s[..], 'n');   // the sequence is still on
  s[0].time = 60;
  #assert !coaxial_land_boot_key(s[..], 'x') && coaxial_land_boot_key(s[..], 'n');
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == BOOT_IDENTITY_URL;
  #assert !coaxial_land_boot_key(s[..], 'n');
  w: [1] LandState;
  coaxial_land_message(w[..], 600, "boot=IDENTITY|made|1\nseed=a b c d e f g h i j k l\nnpub=npub1x\n");
  #assert coaxial_land_boot_key(w[..], 'w') && w[0].boot[0].seed_n > 0;
  #assert coaxial_land_boot_key(w[..], KEY_ENTER) && w[0].boot[0].seed_n == 0;
  #assert !coaxial_land_boot_key(w[..], KEY_ENTER);
}
