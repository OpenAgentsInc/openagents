// Penultimate Frontier (/worlds/penultimate-frontier, data-page 2): the Grid's scene, flown, with
// the opening of Episode 292 (docs/transcripts/292.md) drawn in it as line art. The page's clock
// is the reading's: T seconds from the page's start, the narration's beats at FR_* below. Nothing
// here is text: the trees, the Pylons and the floor are the homepage's, without their names, and
// the story's things are lines, rings, diamonds and figures in the same inks.
//
//   FR_FRONTIER  "the penultimate frontier"  the projects' trees build up
//   FR_SPACE     "we'll go to space"         a trail climbs from the open ground into the sky
//   FR_TREK...   "Trek or Wars, Earth or Mars or belt or outer planets": two ships duel, then the
//                solar system as Belt 2200 draws it (newland-frontier-sky.coax)
//   FR_HUMANS    "care for humans on Earth"  people stand on the open ground
//   FR_OLD       "the old world's power..."  a capitol, a tower and an exchange rise, then fall to rubble
//                (newland-frontier-ruins.coax)
//   FR_NEW       "a bright new world..."     a bright tree struggles up among them
//   FR_MIDWIVES  "we are its midwives"       the people walk to it and ring it, hands up
//
// After the story the camera eases onto the slow lap (wk_fly_path) and stays on it.

FR_FRONTIER :: 27.4; FR_SPACE :: 30.3; FR_SUN :: 32.8; FR_EARTH :: 36.4; FR_MARS :: 36.9; FR_BELT :: 38.2;
FR_OUTER :: 39.2; FR_HUMANS :: 40.3; FR_OLD :: 44.1; FR_DECAY :: 46.4; FR_NEW :: 48.3; FR_MIDWIVES :: 52.1;
FR_END :: 157.0;      // the story's last key: the lap takes over after it
FR_JOIN :: 5.0;      // s the camera takes to ease onto the lap
FR_S :: Fv.{x = 15, y = 0, z = 3};         // the open ground east of the places, where the story stands
FR_SKY :: Fv.{x = 15, y = 20, z = 3};      // the sun, straight up from the open ground: the orbits' middle
FR_PEOPLE :: 9;
FR_TOWERS :: 3;
FR_KEYS :: 34;

// ---- the camera: a smooth path through keys (Catmull-Rom), eye and aim, in grid units
FrKey :: struct { t: f32; eye: Fv; at: Fv; }
FR_KEY_TABLE :: [FR_KEYS] FrKey.[
    FrKey.{t = 0,           eye = Fv.{x = 32, y = 17, z = 32}, at = Fv.{x = 0, y = 0, z = 0}},
    FrKey.{t = 14,          eye = Fv.{x = 28, y = 13, z = 31}, at = Fv.{x = 2, y = 0, z = 2}},
    FrKey.{t = FR_FRONTIER, eye = Fv.{x = 20, y = 6.5, z = 22}, at = Fv.{x = -1, y = 1.5, z = 1}},
    FrKey.{t = FR_SPACE + 0.8, eye = Fv.{x = 24, y = 3, z = 15}, at = Fv.{x = 15, y = 9, z = 3}},
    FrKey.{t = 33.4,        eye = Fv.{x = 20, y = 21.5, z = 12.5}, at = Fv.{x = 15, y = 20.6, z = 3}},
    FrKey.{t = 35.5,        eye = Fv.{x = 16.2, y = 21.8, z = 9.6}, at = Fv.{x = 15, y = 21, z = 3.4}},
    FrKey.{}, FrKey.{}, FrKey.{},
    FrKey.{t = FR_OUTER + 0.9, eye = Fv.{x = 26, y = 30, z = 17}, at = Fv.{x = 15, y = 20, z = 3}},
    FrKey.{t = FR_HUMANS + 1.7, eye = Fv.{x = 25, y = 3.2, z = 11}, at = Fv.{x = 14, y = 1.2, z = 2.5}},
    FrKey.{t = FR_DECAY,    eye = Fv.{x = 27.5, y = 5.5, z = 13.5}, at = Fv.{x = 12.5, y = 2.6, z = 0.5}},
    FrKey.{t = FR_MIDWIVES - 0.5, eye = Fv.{x = 24, y = 3.6, z = 10}, at = Fv.{x = 15, y = 2.3, z = 3}},
    // the rest of the reading (newland-frontier-act2.coax)
    FrKey.{t = 55.8,  eye = Fv.{x = 25, y = 6, z = 14},     at = Fv.{x = 14, y = 1, z = 3}},
    FrKey.{t = 60.6,  eye = Fv.{x = 27.5, y = 4.6, z = 8},   at = Fv.{x = 20, y = 0.8, z = 0.6}},
    FrKey.{t = 65.6,  eye = Fv.{x = 25.6, y = 2.4, z = 4.2}, at = Fv.{x = 20, y = 0.9, z = -0.4}},
    FrKey.{t = 70.6,  eye = Fv.{x = 31, y = 9, z = 17},      at = Fv.{x = 20.5, y = 0, z = 6.5}},
    FrKey.{t = 76.2,  eye = Fv.{x = 29, y = 5, z = 15.5},    at = Fv.{x = 21, y = 1.3, z = 6}},
    FrKey.{t = 80.8,  eye = Fv.{x = 26, y = 3.0, z = 13},    at = Fv.{x = 21, y = 2.2, z = 2.5}},
    FrKey.{t = 85.6,  eye = Fv.{x = 42, y = 22, z = 32},     at = Fv.{x = 20, y = 0, z = 7}},
    FrKey.{t = 90.8,  eye = Fv.{x = 32, y = 7.5, z = 19},    at = Fv.{x = 21, y = 3.6, z = 8}},
    FrKey.{t = 96.2,  eye = Fv.{x = 28, y = 3.6, z = 14.5},  at = Fv.{x = 21, y = 2.2, z = 8}},
    FrKey.{t = 101.6, eye = Fv.{x = 35, y = 11, z = 24},     at = Fv.{x = 21, y = 1.5, z = 8}},
    FrKey.{t = 106.6, eye = Fv.{x = 40, y = 26, z = 30},     at = Fv.{x = 20, y = 0, z = 8}},
    FrKey.{t = 111.6, eye = Fv.{x = 29, y = 3.6, z = 15},    at = Fv.{x = 21, y = 1, z = 8}},
    FrKey.{t = 117.6, eye = Fv.{x = 22, y = 9.5, z = 14},    at = Fv.{x = 11, y = 2.0, z = 0.6}},
    FrKey.{t = 123.6, eye = Fv.{x = 25, y = 6, z = 13.5},    at = Fv.{x = 14, y = 3.4, z = 2.5}},
    FrKey.{t = 128.6, eye = Fv.{x = 31, y = 8, z = 18},      at = Fv.{x = 19, y = 3.5, z = 6}},
    FrKey.{t = 133.6, eye = Fv.{x = 29, y = 11, z = 16},     at = Fv.{x = 18, y = 7, z = 5}},
    FrKey.{t = 137.6, eye = Fv.{x = 23.5, y = 9.2, z = 10.5}, at = Fv.{x = 18, y = 8.3, z = 5}},
    FrKey.{t = 142.6, eye = Fv.{x = 32, y = 13, z = 20},     at = Fv.{x = 18, y = 9, z = 5}},
    FrKey.{t = 147.2, eye = Fv.{x = 27, y = 10.5, z = 14.5}, at = Fv.{x = 18, y = 9.4, z = 5}},
    FrKey.{t = 151.0, eye = Fv.{x = 27, y = 7, z = 16},      at = Fv.{x = 15, y = 2.2, z = 3}},
    FrKey.{t = FR_END, eye = Fv.{x = 38, y = 20, z = 32},    at = Fv.{x = 13, y = 1, z = 2}}];

fr_key :: (i: int) -> FrKey {
  j := clamp_i(i, 0, FR_KEYS - 1);
  // the worlds' keys follow the worlds: Earth and Mars where they are at their beats
  if j == 6 { e := fr_body_sky(BODY_EARTH, FR_EARTH + 0.5); return FrKey.{t = FR_EARTH + 0.5, eye = fv_add(e, fv(1.1, 0.55, 1.25)), at = e}; }
  if j == 7 { m := fr_body_sky(BODY_MARS, FR_MARS + 0.95); return FrKey.{t = FR_MARS + 0.95, eye = fv_add(m, fv(0.85, 0.45, 1.0)), at = m}; }
  if j == 8 { ce := fr_body_sky(BODY_CERES, FR_BELT + 0.6); return FrKey.{t = FR_BELT + 0.6, eye = fv_add(ce, fv(0.9, 0.5, 1.3)), at = fv_mix(ce, FR_SKY, 0.25)}; }
  return FR_KEY_TABLE[j];
}

clamp_i :: (v: int, a: int, b: int) -> int { if v < a { return a; } if v > b { return b; } return v; }
fr_cr :: (p0: Fv, p1: Fv, p2: Fv, p3: Fv, u: f32) -> Fv {
  u2 := u * u; u3 := u2 * u;
  a := fv_times(p1, 2);
  b := fv_times(fv_sub(p2, p0), u);
  c := fv_times(fv_add(fv_sub(fv_times(p0, 2), fv_times(p1, 5)), fv_sub(fv_times(p2, 4), p3)), u2);
  d := fv_times(fv_add(fv_sub(fv_times(p1, 3), p0), fv_sub(p3, fv_times(p2, 3))), u3);
  return fv_times(fv_add(fv_add(a, b), fv_add(c, d)), 0.5);
}
FrPose :: struct { eye: Fv; at: Fv; }
fr_story_pose :: (t: f32) -> FrPose {
  i := 0;
  while i < FR_KEYS - 2 && t >= fr_key(i + 1).t { i += 1; }
  a := fr_key(i); b := fr_key(i + 1);
  u := clamp((t - a.t) / (b.t - a.t), 0, 1);
  e := fr_cr(fr_key(i - 1).eye, a.eye, b.eye, fr_key(i + 2).eye, u);
  at := fr_cr(fr_key(i - 1).at, a.at, b.at, fr_key(i + 2).at, u);
  return FrPose.{eye = e, at = at};
}
// The page's camera: the story's path, then onto the lap.
fr_cam :: (mid: Fv, t: f32, width: f32, height: f32) -> Cam {
  q := fr_story_pose(t);
  if t > FR_END {
    lap := wk_fly_path(mid, t - FR_END);
    j := smooth01((t - FR_END) / FR_JOIN);
    q = FrPose.{eye = fv_mix(q.eye, lap.eye, j), at = fv_mix(q.at, lap.at, j)};
  }
  return wk_cam(q.eye, q.at, wk_focal(width, height), width * 0.5, height * 0.5, width, height);
}

// ---- the scene

// The Grid's own things, nameless: the floor, the roads, the trees (built up at FR_FRONTIER) and the Pylons.
fr_scene :: (out: [] f32, at: int, s: [] LandState, c: Cam, look: Fv, p: Pen, t: f32) -> int {
  v := floor_grid(out, at, s, c, look, p);
  grow := p; grow.time = p.time - FR_FRONTIER + 1.3;   // place's grown(): the first tree starts at FR_FRONTIER
  if grow.time > 0 {
    v = roads(out, v, s, c, grow);
    for k: 0..<s[0].plots { v = place(out, v, s, c, k, grow); }
    v = pylon_bay(out, v, s, c, grow, t);
  }
  for k: 0..<s[0].plots { s[0].plot[k].hit = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0}; s[0].plot[k].tag = s[0].plot[k].hit; }
  v = fr_space(out, v, c, p, t);
  v = fr_planets(out, v, c, p, t);
  v = fr_towers(out, v, c, p, t);
  v = fr_new_world(out, v, c, p, t);
  v = fr_people(out, v, c, p, t);
  v = fr_act2(out, v, c, p, t);
  return v;
}
fr_in :: (t: f32, from: f32, take: f32) -> f32 { return ease((t - from) / take); }
fr_out :: (t: f32, from: f32, take: f32) -> f32 { return 1 - ease((t - from) / take); }

// "We'll go to space": a bright head climbs from the open ground, its trail behind it.
fr_space :: (out: [] f32, at: int, c: Cam, p: Pen, t: f32) -> int {
  if t < FR_SPACE || t > FR_HUMANS + 1 { return at; }
  v := at;
  rise := fr_in(t, FR_SPACE, 2.6);
  fade := fr_out(t, FR_SUN + 2.5, 2.5);
  head := fv_mix(FR_S, fv(FR_SKY.x, FR_SKY.y - 1.0, FR_SKY.z), rise);
  trail := ink(p, INK_BRIGHT); trail.core = 1.0 * p.d; trail.glow = 6 * p.d;
  n := 24;
  for i: 0..<n {
    a := fv_mix(FR_S, head, cast(f32) i / cast(f32) n); b := fv_mix(FR_S, head, cast(f32) (i + 1) / cast(f32) n);
    v = seg(out, v, c, a, b, trail, (0.25 + 0.75 * cast(f32) (i + 1) / cast(f32) n) * fade);
  }
  h := spot(c, head);
  if h.ok && rise < 1 { v = diamond(out, v, h.x, h.y, 4 * p.d, ink(p, INK_BRIGHT), fade); }
  // a ring where it left the ground
  r := 0.4 + 2.5 * fract((t - FR_SPACE) * 0.5);
  v = loop3(out, v, c, FR_S.x, 0.02, FR_S.z, r, ink(p, INK_PALE), 0.5 * (1 - fract((t - FR_SPACE) * 0.5)) * fade * fr_out(t, FR_SPACE + 2, 0.4));
  return v;
}

// A level circle of n pieces, drawn as far round as `round` (0 to 1).
fr_orbit :: (out: [] f32, at: int, c: Cam, o: Fv, r: f32, round: f32, n: int, k: Ink, light: f32, dotted: bool) -> int {
  v := at;
  for i: 0..<n {
    s0 := cast(f32) i / cast(f32) n; s1 := cast(f32) (i + 1) / cast(f32) n;
    if s0 >= round { break; }
    if dotted && i % 2 == 1 { continue; }
    a0 := FR_TAU * s0; a1 := FR_TAU * lo(s1, round);
    v = seg(out, v, c, fv(o.x + r * cos(a0), o.y, o.z + r * sin(a0)), fv(o.x + r * cos(a1), o.y, o.z + r * sin(a1)), k, light);
  }
  return v;
}
FR_TAU :: 6.2831853;
// The people on the open ground: where each stands at first, and where it stands round the new tree.
fr_crowd :: (i: int) -> Fv {
  a := cast(f32) i * 2.399 + 0.6;   // a loose sunflower, open toward the camera (+x +z)
  r := 1.9 + 1.3 * sqrt(cast(f32) i / cast(f32) FR_PEOPLE);
  return fv(FR_S.x + r * cos(a) * 1.1, 0, FR_S.z + r * sin(a) * 0.9 + 0.6);
}
fr_ring_at :: (i: int) -> Fv {
  a := FR_TAU * cast(f32) i / cast(f32) FR_PEOPLE + 0.3;
  return fv(FR_S.x + 1.45 * cos(a), 0, FR_S.z + 1.45 * sin(a));
}
// "Care for humans on Earth", then "we are its midwives": they stand, then walk in and ring the new tree.
fr_people :: (out: [] f32, at: int, c: Cam, p: Pen, t: f32) -> int {
  if t < FR_HUMANS { return at; }
  v := at;
  seen := fr_in(t, FR_HUMANS, 1.4);
  pale := ink(p, INK_PALE);
  sh: Shape; sh.size = 0.95;
  k := verse_figure_skeleton(sh);
  for i: 0..<FR_PEOPLE {
    start := FR_MIDWIVES + 0.12 * cast(f32) i;
    go := fr_in(t, start, 1.8);
    from := fr_crowd(i); to := fr_ring_at(i);
    w := fv_mix(from, to, go);
    walking := go > 0 && go < 1;
    // facing: toward the new tree once it's up, the camera's way before
    face_x := ifx t >= FR_NEW then FR_S.x - w.x else 1.0f32;
    face_z := ifx t >= FR_NEW then FR_S.z - w.z else 1.0f32;
    if walking { face_x = to.x - from.x; face_z = to.z - from.z; }
    yaw := angle_of(face_x, face_z);
    pose := verse_figure_gait(Rig.person, ifx walking then Gait.walk else Gait.stand, fract(t * 1.3 + cast(f32) i * 0.31), t * 1.4 + cast(f32) i);
    if go >= 1 {
      // round it, hands up to it
      lift := fr_in(t, start + 1.8, 0.7);
      pose.turn[P_R_SHOULDER] = fv(-2.4 * lift, 0, -0.15 * lift);
      pose.turn[P_L_SHOULDER] = fv(-2.4 * lift, 0, 0.15 * lift);
    }
    top: [1] Spot;
    light := seen * fr_in(t, FR_HUMANS + 0.12 * cast(f32) i, 0.8);
    v = figure(out, v, c, k, pose, w.x, w.z, yaw, pale, light, p, top[0..<0]);
  }
  return v;
}

// "A bright new world struggles to be born": a tree of light climbs from the open ground, faltering
// as it goes, its newest nodes pulsing; rings go out from its foot.
fr_new_world :: (out: [] f32, at: int, c: Cam, p: Pen, t: f32) -> int {
  if t < FR_NEW { return at; }
  v := at;
  raw := clamp((t - FR_NEW) / 3.6, 0, 1);
  // the struggle: it climbs in fits, slipping back a little, then holds
  g := clamp(ease(raw) - 0.06 * sin(raw * 19) * (1 - raw), 0, 1);
  bright := ink(p, INK_BRIGHT); bright.glow = 6 * p.d;
  white := ink(p, INK_WHITE);
  n := 34;
  shown := cast(int) (cast(f32) n * g);
  height := fr_tree_height(t);
  nodes: [34] Fv;
  for i: 0..<n {
    f := cast(f32) i / cast(f32) (n - 1);
    r := 0.3 + 1.2 * (1 - f);
    a := cast(f32) i * 0.62 + t * 0.25;
    nodes[i] = fv(FR_S.x + r * cos(a), 0.3 + height * f, FR_S.z + r * sin(a));
  }
  if shown <= 0 { return v; }
  trunk := bright; trunk.core = 1.4 * p.d;
  v = seg(out, v, c, FR_S, fv(FR_S.x, nodes[shown - 1].y + 0.3, FR_S.z), trunk, 0.9);
  for i: 1..<shown {
    v = seg(out, v, c, nodes[i - 1], nodes[i], ifx i >= shown - 4 then bright else white, ifx i >= shown - 4 then 0.95f32 else 0.6f32);
    if i % 3 == 0 { v = seg(out, v, c, fv(FR_S.x, nodes[i].y, FR_S.z), nodes[i], white, 0.3); }
  }
  for i: 0..<shown {
    q := spot(c, nodes[i]);
    if !q.ok || !inside(c.clip, q.x, q.y) { continue; }
    recent := i >= shown - 4;
    pulse := 0.6 + 0.4 * sin(t * 3.0 + cast(f32) i);
    v = diamond(out, v, q.x, q.y, (ifx recent then 3.2f32 else 2.0f32) * p.d, ifx recent then bright else white, (ifx recent then pulse else 0.6f32) * vignette(c, q.x, q.y));
  }
  // rings out from its foot, and its plot taking shape round it
  for k: 0..<3 {
    ph := fract((t - FR_NEW) * 0.45 + cast(f32) k / 3);
    v = loop3(out, v, c, FR_S.x, 0.02, FR_S.z, 0.5 + 3.5 * ph, ink(p, INK_PALE), 0.45 * (1 - ph) * fr_in(t, FR_NEW, 0.6));
  }
  edge_in := fr_in(t, FR_NEW + 1.2, 2.2);
  if edge_in > 0 {
    v = fr_orbit(out, v, c, fv(FR_S.x, 0.02, FR_S.z), 2.3, edge_in, 48, bright, 0.8, false);
  }
  return v;
}

#test "the story's camera passes every key and moves smoothly between them" #steps 4000000000 {
  for i: 0..<FR_KEYS - 1 {
    k := fr_key(i);
    q := fr_story_pose(k.t);
    #assert fv_length(fv_sub(q.eye, k.eye)) < 0.01 && fv_length(fv_sub(q.at, k.at)) < 0.01;
    #assert fr_key(i + 1).t > k.t;
  }
  // no jump frame to frame (a 60 Hz step moves the eye far less than a unit)
  last := fr_story_pose(0).eye;
  t: f32 = 0;
  while t < FR_END + FR_JOIN + 2 {
    t += 1.0 / 60;
    e := fr_cam(fv(0, 0, 0), t, 1280, 720).eye;
    #assert fv_length(fv_sub(e, last)) < 0.6;
    last = e;
  }
}
#test "the people stand apart, then ring the new tree" {
  for i: 0..<FR_PEOPLE {
    for j: i + 1..<FR_PEOPLE {
      #assert fv_length(fv_sub(fr_crowd(i), fr_crowd(j))) > 0.45;
      #assert fv_length(fv_sub(fr_ring_at(i), fr_ring_at(j))) > 0.6;
    }
    #assert abs(fv_length(fv_sub(fr_ring_at(i), FR_S)) - 1.45) < 0.01;
  }
}
