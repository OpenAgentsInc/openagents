// Verse OS: the agents on your own machine, standing in the Grid by the spawn (docs/os/2026-11-02-verse-os.md,
// V4). The machine's session (os/verse-agents.coax) sends them as message 610, one line each,
// `agent=KIND|PROJECT|STATE|MINUTES` (STATE working or waiting), newest first; a new message
// replaces the last. They stand in an arc seven metres ahead of where you arrive, past the
// terminal, facing you: one at work with a hand raised to its work, one waiting with its arms
// down, each named over its head. The website never sends 610, so it never shows them.
// Loaded by newland.coax; newland-walk.coax draws them after you.

LOCAL_MAX :: 8;
LOCAL_KIND :: 610;
LocalAgent :: struct { kind: [16] u8; kind_n: int; project: [48] u8; project_n: int; working: bool; minutes: int; }
LocalAgents :: struct {
  a: [LOCAL_MAX] LocalAgent; n: int;
  // the desk's screen in the world (message 611 "desk=1": the host has a desk): where it was drawn
  // this frame, in the realm's pixels, for the host to put the desk there (its F8)
  desk: bool; rect: [4] f32; rect_ok: bool;
  // where each agent's name was drawn (a click there asks for its transcript), and that ask
  head_x: [LOCAL_MAX] f32; head_y: [LOCAL_MAX] f32; head_ok: [LOCAL_MAX] bool;
  down_x: f32; down_y: f32; asked: int;   // the agent asked for, plus one: 0 is none
  talk: bool;                              // and asked to talk to a new one like it (T), not to read it
  offer: int; offer_until: f32;            // the agent last clicked, plus one, and until when T talks
}
LOCAL_DESK_KIND :: 611;

// One agent= line into slot k: whether it was well formed.
local_line :: (l: [] LocalAgents, k: int, line: string) -> bool {
  bars: [3] int; nb := 0;
  for i: 0..<line.count { if line[i] == '|' && nb < 3 { bars[nb] = i; nb += 1; } }
  if nb != 3 || bars[0] < 1 || bars[1] <= bars[0] + 1 { return false; }
  st := line[bars[1] + 1..<bars[2]];
  if st != "working" && st != "waiting" { return false; }
  m := 0; mins := line[bars[2] + 1..<line.count];
  if mins.count < 1 || mins.count > 6 { return false; }
  for c: mins { if c < '0' || c > '9' { return false; } m = m * 10 + cast(int) (c - '0'); }
  g: LocalAgent;
  g.kind_n = lo_int(bars[0], 16); for i: 0..<g.kind_n { g.kind[i] = line[i]; }
  g.project_n = lo_int(bars[1] - bars[0] - 1, 48); for i: 0..<g.project_n { g.project[i] = line[bars[0] + 1 + i]; }
  g.working = st == "working"; g.minutes = m;
  l[0].a[k] = g;
  return true;
}
local_message :: (l: [] LocalAgents, text: string) {
  n := 0; i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    if e - i > 6 && text[i..<i + 6] == "agent=" && n < LOCAL_MAX && local_line(l, n, text[i + 6..<e]) { n += 1; }
    i = e + 1;
  }
  l[0].n = n;
}
#test "the machine's agents: in order, the malformed left out, a new list replacing the last" {
  l: [1] LocalAgents;
  local_message(l[..], "agent=claude|openagents|working|0\nagent=bad\nagent=codex|coder|waiting|12\nagent=x|y|sleeping|1\n");
  #assert l[0].n == 2 && l[0].a[0].working && !l[0].a[1].working && l[0].a[1].minutes == 12;
  #assert cast(string) l[0].a[0].kind[0..<l[0].a[0].kind_n] == "claude" && cast(string) l[0].a[1].project[0..<l[0].a[1].project_n] == "coder";
  local_message(l[..], "agents=none\n");
  #assert l[0].n == 0;
  local_message(l[..], "agent=a|b|working|1x\nagent=|b|working|1\nagent=a||working|1\nagent=a|b|working|\n");
  #assert l[0].n == 0;
}

// Where agent k of n stands, in the world's metres from the places' middle: an arc seven metres
// ahead of the spawn, a metre and a half apart, centred on your line of sight.
local_place :: (k: int, n: int) -> Fv {
  face: f32 = WK_SPAWN_FACE;
  fx := sin(face); fz := cos(face);                      // ahead, as the player's yaw is
  rx := fz; rz := -fx;                                   // to the right
  side := (cast(f32) k - cast(f32) (n - 1) * 0.5) * 1.5;
  return fv(WK_SPAWN_X + fx * 7 + rx * side, 0, WK_SPAWN_Z + fz * 7 + rz * side);
}
#test "they stand ahead of you, side by side" {
  a := local_place(0, 2); b := local_place(1, 2); m := local_place(0, 1);
  d := sqrt((a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z));
  #assert d > 1.49 && d < 1.51;
  ahead := sqrt((m.x - WK_SPAWN_X) * (m.x - WK_SPAWN_X) + (m.z - WK_SPAWN_Z) * (m.z - WK_SPAWN_Z));
  #assert ahead > 6.99 && ahead < 7.01;
}

// The desk's screen: four metres by two and a quarter, its foot 0.6 m up, nine metres ahead of the
// spawn and four and a half to its left, facing you. Corner k (0 bottom-left, 1 bottom-right,
// 2 top-right, 3 top-left) in the world's metres.
local_desk_corner :: (k: int) -> Fv {
  face: f32 = WK_SPAWN_FACE;
  fx := sin(face); fz := cos(face); rx := fz; rz := -fx;
  cx := WK_SPAWN_X + fx * 9 - rx * 4.5; cz := WK_SPAWN_Z + fz * 9 - rz * 4.5;
  side: f32 = ifx k == 0 || k == 3 then -2.0f32 else 2.0f32;
  up: f32 = ifx k < 2 then 0.6f32 else 2.85f32;
  return fv(cx + rx * side, up, cz + rz * side);
}
#test "the desk's screen: four metres wide, 16 by 9, upright" {
  a := local_desk_corner(0); b := local_desk_corner(1); t := local_desk_corner(3);
  w := sqrt((a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z));
  #assert w > 3.99 && w < 4.01 && t.y - a.y > 2.24 && t.y - a.y < 2.26 && t.x == a.x && t.z == a.z;
}
// The frame drawn where the desk stands, and the rectangle it covers on the screen kept for the host.
local_desk :: (out: [] f32, at: int, s: [] LandState, c: Cam, mid: Fv, p: Pen) -> int {
  l := s[0].local[..];
  l[0].rect_ok = false;
  if !l[0].desk { return at; }
  pts: [4] Spot; all := true;
  for k: 0..<4 { w := local_desk_corner(k); g := wk_at(mid, w.x, w.y, w.z); pts[k] = spot(c, g); all = all && pts[k].ok; }
  if !all { return at; }
  v := at; k := ink(p, INK_BRIGHT);
  for e: 0..<4 { n := (e + 1) % 4; v = rule(out, v, pts[e].x, pts[e].y, pts[n].x, pts[n].y, k, 0.8); }
  x0 := pts[0].x; y0 := pts[0].y; x1 := x0; y1 := y0;
  for e: 1..<4 { x0 = lo(x0, pts[e].x); y0 = lo(y0, pts[e].y); x1 = hi(x1, pts[e].x); y1 = hi(y1, pts[e].y); }
  l[0].rect[0] = x0; l[0].rect[1] = y0; l[0].rect[2] = x1; l[0].rect[3] = y1; l[0].rect_ok = x1 > x0 + 8 && y1 > y0 + 8;
  return put_centred(out, v, "DESK  ·  F8", (x0 + x1) * 0.5, y1 + 14 * p.d, 7 * p.d, chrome(ink(p, INK_DIM)));
}
// The rectangle for the host: k 0..3 x0 y0 x1 y1 in the realm's pixels, 4 whether it is on screen.
coaxial_land_panel :: (s: [] LandState, k: int) -> f32 #export_c {
  if s.count < 1 || k < 0 || k > 4 { return -1; }
  l := s[0].local[..];
  if k == 4 { return ifx l[0].rect_ok then 1.0f32 else 0.0f32; }
  return ifx l[0].rect_ok then l[0].rect[k] else -1.0f32;
}

local_agents :: (out: [] f32, at: int, s: [] LandState, c: Cam, mid: Fv, p: Pen, t: f32) -> int {
  l := s[0].local[..];
  v := local_desk(out, at, s, c, mid, p);
  if l[0].n == 0 { return v; }
  sh: Shape; sh.size = 0.95;
  k := verse_figure_skeleton(sh);
  you := wk_at(mid, WK_SPAWN_X, 0, WK_SPAWN_Z);
  for a: 0..<l[0].n {
    g := l[0].a[a];
    w := local_place(a, l[0].n);
    at_grid := wk_at(mid, w.x, w.y, w.z);
    yaw := angle_of(you.x - at_grid.x, you.z - at_grid.z);
    pose := verse_figure_gait(Rig.person, Gait.stand, 0, t * 1.4 + cast(f32) a);
    if g.working { pose.turn[P_R_SHOULDER] = fv(-1.1 - 0.15 * sin(t * 3.1 + cast(f32) a), 0, -0.2); pose.turn[P_R_ELBOW] = fv(-0.5, 0, 0); }
    tint := ink(p, ifx g.working then INK_BLUE else INK_PALE);
    top: [1] Spot;
    v = figure(out, v, c, k, pose, at_grid.x, at_grid.z, yaw, tint, ifx g.working then 1.0f32 else 0.6f32, p, top[..]);
    l[0].head_ok[a] = top[0].ok; l[0].head_x[a] = top[0].x; l[0].head_y[a] = top[0].y;
    if top[0].ok {
      name: [80] u8; n := 0;
      kind := cast(string) g.kind[0..<g.kind_n];
      n = app(name[..], n, ifx kind == "claude" then "CLAUDE CODE" else ifx kind == "codex" then "CODEX" else ifx kind == "coder" then "CODER" else kind);
      n = app(name[..], n, " · "); n = app(name[..], n, cast(string) g.project[0..<g.project_n]);
      v = put_centred(out, v, cast(string) name[0..<n], top[0].x, top[0].y - 16 * p.d, 7 * p.d, chrome(ink(p, INK_BRIGHT)));
      st: [32] u8; sn := 0;
      if g.working { sn = app(st[..], 0, "AT WORK"); } else { sn = app(st[..], 0, "WAITING "); sn = app_int(st[..], sn, g.minutes); sn = app(st[..], sn, " MIN"); }
      v = put_centred(out, v, cast(string) st[0..<sn], top[0].x, top[0].y - 4 * p.d, 6 * p.d, ink(p, ifx g.working then INK_BLUE else INK_DIM));
      if l[0].offer == a + 1 && s[0].time <= l[0].offer_until {
        v = put_centred(out, v, "TRANSCRIPT ON THE DESK  ·  T TO TALK TO A NEW ONE", top[0].x, top[0].y - 30 * p.d, 6 * p.d, chrome(ink(p, INK_BLUE)));
      }
    }
  }
  return v;
}

// A click (down then up within a few pixels) on an agent's name and figure asks the host for its
// transcript (coaxial_land_os_request): true when the click was an agent's, so the walk ignores it.
local_click :: (s: [] LandState, x: f32, y: f32, phase: int, d: f32) -> bool {
  if s.count < 1 { return false; }
  l := s[0].local[..];
  if phase == 0 { l[0].down_x = x; l[0].down_y = y; return false; }
  if phase != 2 || abs(x - l[0].down_x) > 6 * d || abs(y - l[0].down_y) > 6 * d { return false; }
  for a: 0..<l[0].n {
    if !l[0].head_ok[a] { continue; }
    // the name over the head and the body under it
    if x > l[0].head_x[a] - 60 * d && x < l[0].head_x[a] + 60 * d && y > l[0].head_y[a] - 24 * d && y < l[0].head_y[a] + 90 * d {
      l[0].asked = a + 1; l[0].talk = false; l[0].offer = a + 1; l[0].offer_until = s[0].time + 8; return true;
    }
  }
  return false;
}
// What the host is asked since it last looked: agent K's transcript (K), a new agent like K to talk
// to (1000 + K), or -1; asking clears it.
coaxial_land_os_request :: (s: [] LandState) -> int #export_c {
  if s.count < 1 { return -1; }
  a := s[0].local[0].asked - 1; s[0].local[0].asked = 0;
  if a < 0 || a >= s[0].local[0].n { return -1; }
  return ifx s[0].local[0].talk then 1000 + a else a;
}
// T within eight seconds of clicking an agent: a new agent like it, in its project, to talk to.
local_key :: (s: [] LandState, key: int) -> bool {
  if s.count < 1 { return false; }
  l := s[0].local[..];
  if (key != 't' && key != 'T') || l[0].offer <= 0 || s[0].time > l[0].offer_until { return false; }
  l[0].asked = l[0].offer; l[0].talk = true; l[0].offer = 0;
  return true;
}
coaxial_land_local_key :: (s: [] LandState, key: int) -> bool #export_c { return local_key(s, key); }
#test "T after a click asks for a new agent to talk to; late, or with nothing clicked, it is a key like any" {
  s: [1] LandState;
  local_message(s[0].local[..], "agent=claude|openagents|working|0\n");
  #assert !local_key(s[..], 't');
  s[0].local[0].head_ok[0] = true; s[0].local[0].head_x[0] = 500; s[0].local[0].head_y[0] = 300;
  b := local_click(s[..], 500, 320, 0, 1); b = local_click(s[..], 500, 320, 2, 1);
  #assert coaxial_land_os_request(s[..]) == 0;
  #assert local_key(s[..], 't') && coaxial_land_os_request(s[..]) == 1000 && !local_key(s[..], 't');
  b = local_click(s[..], 500, 320, 0, 1); b = local_click(s[..], 500, 320, 2, 1); r := coaxial_land_os_request(s[..]);
  s[0].time += 9;
  #assert !local_key(s[..], 'T');
}
#test "a click on an agent asks for its transcript, a drag does not" {
  s: [1] LandState;
  local_message(s[0].local[..], "agent=claude|openagents|working|0\n");
  #assert coaxial_land_os_request(s[..]) == -1;   // nothing asked before a click
  s[0].local[0].head_ok[0] = true; s[0].local[0].head_x[0] = 500; s[0].local[0].head_y[0] = 300;
  #assert !local_click(s[..], 500, 320, 0, 1) && local_click(s[..], 502, 321, 2, 1) && coaxial_land_os_request(s[..]) == 0;
  #assert coaxial_land_os_request(s[..]) == -1;
  #assert !local_click(s[..], 500, 320, 0, 1) && !local_click(s[..], 560, 320, 2, 1);
  #assert !local_click(s[..], 900, 320, 0, 1) && !local_click(s[..], 900, 320, 2, 1) && coaxial_land_os_request(s[..]) == -1;
}
coaxial_land_local_click :: (s: [] LandState, x: f32, y: f32, phase: int) -> bool #export_c { return local_click(s, x, y, phase, 1); }
