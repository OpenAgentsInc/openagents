// Everglade's portal on the homepage, and the way through it.
//
// One portal stands in the Grid near the places' middle: a ring of the accent's light round a face of
// Everglade's (gpu/portal.coax, portal_field), on a dais, with motes rising into it and its name over
// it. One button, "Create your character", sits at the foot of the page. Pressing it:
//   1. the HUD fades and the camera flies to the portal: it swings down from the Grid's high view to
//      the portal's height, the lens widening as it closes, so the portal grows smoothly on screen;
//   2. the portal's face fills the view, the page goes dark behind it and its light swells: the
//      shimmer;
//   3. the page goes on to Character Create (/worlds/character-creator?via=portal), whose arrival
//      (everglade2-create.coax) opens on the same light at the same scale and clock, then lets the
//      glade through it.
// At the press the host is asked to fetch that page and its engine, shaders, font and pack into the
// HTTP cache (host.js action 21), so they load from it while the camera flies.
// Checks: coax test apps/openagents-web/newland.coax --steps 400000000 --only portal.

PORTAL_URL :: "/worlds/character-creator?via=portal";
PORTAL_LABEL :: "Create your character";
ACT_WARM :: 21;          // host.js: fetch this page and what its engine loads into the HTTP cache
MODE_PORTAL :: -1.0;     // gpu/newland.coax newland_portal
PORTAL_R :: 1.9;         // grid units: the ring's radius
PORTAL_LIFT :: 0.4;      // its foot over the floor
PORTAL_DAIS :: 2.5;      // the dais's radius
PORTAL_FLY :: 2.1;       // s: the camera flies to the portal and into it
PORTAL_HOLD :: 0.45;     // s: its light holds the view, swelling, before the page goes on
PORTAL_THROUGH :: 3.0;   // the face's radius at the hand-over, in half view diagonals (gpu/portal.coax PORTAL_HANDOFF)
PORTAL_WALL :: 600000;   // the shimmer's clock: the wall clock's ms modulo this, in seconds (everglade2-create.coax)
PORTAL_MOTES :: 18;

Portal :: struct {
  going: bool; t: f32; went: bool;
  box: Box;                                    // the button, where the last frame drew it
  wall: f32; wall_age: f64; clocked: bool;     // the shimmer's clock: the wall's seconds at data_age wall_age
  look0: Fv; yaw0: f32; pitch0: f32; focal0: f32; cx0: f32; cy0: f32; taken: bool;   // the view at the press
  sx: f32; sy: f32; rx: f32; ry: f32; on: bool;   // the face on screen this frame
  fill: f32;                                   // how much of the view its light has taken (1: all)
}

// The page's wall clock (its facts' now=, in ms): the shimmer's clock starts from it.
portal_clock :: (s: [] LandState, ms: int) {
  s[0].portal[0].wall = f32(ms % PORTAL_WALL) / 1000; s[0].portal[0].wall_age = s[0].data_age; s[0].portal[0].clocked = true;
}
portal_shimmer :: (s: [] LandState) -> f32 {
  q := s[0].portal[0];
  if !q.clocked { return s[0].time; }
  return q.wall + f32(s[0].data_age - q.wall_age);
}
// Where it stands: a little behind the places' middle, where the view has open floor.
portal_foot :: (s: [] LandState) -> Fv { m := centre(s, -1); return fv(m.x - 2.4, 0, m.z - 2.4); }
portal_mid :: (s: [] LandState) -> Fv { f := portal_foot(s); return fv(f.x, PORTAL_LIFT + PORTAL_R, f.z); }

// The button: at the foot of the page between the worlds and the feed; on a phone over the row of
// buttons.
portal_box :: (l: Layout, width: f32, height: f32, d: f32) -> Box {
  w := width / d; h := height / d;
  if l.phone { y1 := l.playtest.y0 / d - 12; return scaled(Box.{x0 = 16, y0 = y1 - 48, x1 = w - 16, y1 = y1}, d); }
  left := l.galaxy.x1 / d + 16; right := l.feed.x0 / d - 16;
  bw := clamp(right - left, 200, 340);
  x0 := (left + right - bw) * 0.5;
  return scaled(Box.{x0 = x0, y0 = h - 32 - 54, x1 = x0 + bw, y1 = h - 32}, d);
}
portal_go :: (s: [] LandState) {
  q := s[0].portal[..];
  if q[0].going { return; }
  q[0].going = true; q[0].t = 0; q[0].went = false; q[0].taken = false;
  if s[0].card != CARD_NONE { close_card(s); }
  s[0].vel_x = 0; s[0].vel_z = 0;
  // the page and its loads into the cache while the camera flies (host.js action 21)
  n := lo_int(PORTAL_URL.count, s[0].outbox.count);
  for i: 0..<n { s[0].outbox[i] = PORTAL_URL[i]; }
  s[0].out_n = n; s[0].action = ACT_WARM;
}
// smoothstep, not smootherstep: the flight is under way within a few frames of the press
portal_ease :: (u: f32) -> f32 { t := clamp(u, 0, 1); return t * t * (3 - 2 * t); }
// The camera this frame: the page's own, or after the press the flight to the portal. The portal's
// size on screen grows evenly (by the same share each frame) from what the page showed to
// PORTAL_THROUGH half diagonals, the lens widening from the page's long one to a wide one, the
// camera swinging down to the portal's height; the distance is what that size needs.
portal_view :: (s: [] LandState, c: Cam, step: f32, width: f32, height: f32) -> Cam {
  q := s[0].portal[..];
  if !q[0].going { return c; }
  if !q[0].taken {
    q[0].taken = true; q[0].look0 = s[0].look; q[0].yaw0 = s[0].yaw; q[0].pitch0 = s[0].pitch;
    q[0].focal0 = c.focal; q[0].cx0 = c.cx; q[0].cy0 = c.cy;
  } else { q[0].t += step; }
  return portal_fly(s, q[0].t, c, width, height);
}
portal_fly :: (s: [] LandState, t: f32, c: Cam, width: f32, height: f32) -> Cam {
  q := s[0].portal[0];
  u := clamp(t / PORTAL_FLY, 0, 1); e := portal_ease(u); aim := smooth01(u * 1.6);
  mid := portal_mid(s);
  look := fv_mix(q.look0, mid, aim);
  pitch := q.pitch0 + (0.05 - q.pitch0) * e;
  yaw := q.yaw0 + 0.22 * e;
  half := sqrt(width * width + height * height) * 0.5;
  focal := exp(log(q.focal0) + (log(width * 0.9) - log(q.focal0)) * e);
  r0 := PORTAL_R * q.focal0 / 90; r1 := PORTAL_THROUGH * half;
  size := exp(log(r0) + (log(r1) - log(r0)) * e);
  dist := PORTAL_R * focal / size;
  eye := fv_add(look, fv(dist * cos(pitch) * sin(yaw), dist * sin(pitch), dist * cos(pitch) * cos(yaw)));
  ahead := unit3(fv_sub(look, eye));
  right := unit3(cross3(ahead, fv(0, 1, 0)));
  up := cross3(right, ahead);
  v := c;
  v.eye = eye; v.ahead = ahead; v.right = right; v.up = up; v.focal = focal;
  v.cx = q.cx0 + (width * 0.5 - q.cx0) * aim; v.cy = q.cy0 + (height * 0.5 - q.cy0) * aim;
  v.near = lo(1, dist * 0.3);
  s[0].view = v;
  return v;
}

// The portal in the Grid, through camera c: its dais, its ring, the motes rising into it and its name;
// the face's place on screen kept for the frame's end (portal_face). What stands behind the face is
// dimmed under it, from `under` on (the scene drawn before it).
portal_scene :: (out: [] f32, at: int, s: [] LandState, c: Cam, p: Pen, t: f32) -> int {
  q := s[0].portal[..]; d := p.d;
  grow := ifx p.still then 1.0f32 else ease((t - 1.0) / 1.6);   // it lights as the page comes up
  q[0].on = false;
  if grow <= 0 { return at; }
  foot := portal_foot(s); mid := portal_mid(s);
  right := unit3(fv(c.right.x, 0, c.right.z)); up := fv(0, 1, 0);
  // the face on screen: an ellipse, its half axes from the ring's side and top
  m := spot(c, mid); a := spot(c, fv_add(mid, fv_times(right, PORTAL_R))); b := spot(c, fv_add(mid, fv_times(up, PORTAL_R)));
  if m.ok && a.ok && b.ok {
    q[0].sx = m.x; q[0].sy = m.y;
    q[0].rx = hi(sqrt((a.x - m.x) * (a.x - m.x) + (a.y - m.y) * (a.y - m.y)), 1);
    q[0].ry = hi(sqrt((b.x - m.x) * (b.x - m.x) + (b.y - m.y) * (b.y - m.y)), 1);
    q[0].on = true;
  }
  // what stands behind the face goes quiet under it
  if q[0].on {
    for k: 0..<at / 6 {
      o := k * 6 * VERTEX_FLOATS;
      x := (out[o] + out[o + 2 * VERTEX_FLOATS]) * 0.5; y := (out[o + 1] + out[o + 2 * VERTEX_FLOATS + 1]) * 0.5;
      dx := (x - q[0].sx) / q[0].rx; dy := (y - q[0].sy) / q[0].ry;
      r := sqrt(dx * dx + dy * dy);
      if r < 1.05 { cut := 1 - 0.9 * grow * (1 - smooth01((r - 0.9) / 0.15)); for j: 0..<6 { out[o + j * VERTEX_FLOATS + 6] *= cut; } }
    }
  }
  v := at;
  dais := ink(p, INK_BRIGHT); dais.core = 0.45 * d; dais.glow = 3.0 * d;
  blue := ink(p, INK_BLUE); blue.core = 0.7 * d; blue.glow = 6.0 * d;
  spin := ifx p.still then 0.0f32 else t * 0.25;
  // the dais: two rings on the floor and their ticks
  n := 48;
  for i: 0..<n {
    a0 := f32(i) * 2 * PI / f32(n); a1 := f32(i + 1) * 2 * PI / f32(n);
    for k: 0..<2 {
      rr := PORTAL_DAIS * (ifx k == 0 then 1.0f32 else 0.86f32);
      v = seg(out, v, c, fv(foot.x + rr * cos(a0), 0, foot.z + rr * sin(a0)), fv(foot.x + rr * cos(a1), 0, foot.z + rr * sin(a1)), dais, (ifx k == 0 then 0.55f32 else 0.3f32) * grow);
    }
    if i % 4 == 0 { v = seg(out, v, c, fv(foot.x + PORTAL_DAIS * cos(a0), 0, foot.z + PORTAL_DAIS * sin(a0)), fv(foot.x + PORTAL_DAIS * 1.1 * cos(a0), 0, foot.z + PORTAL_DAIS * 1.1 * sin(a0)), dais, 0.45 * grow); }
  }
  // the ring's outer band: dashes turning slowly round it
  dashes := 20;
  for i: 0..<dashes {
    a0 := spin + f32(i) * 2 * PI / f32(dashes); a1 := a0 + 0.55 * 2 * PI / f32(dashes);
    for k: 0..<3 {
      b0 := a0 + (a1 - a0) * f32(k) / 3; b1 := a0 + (a1 - a0) * f32(k + 1) / 3;
      rr: f32 = PORTAL_R * 1.1;
      v = seg(out, v, c, fv_add(mid, fv_add(fv_times(right, rr * cos(b0)), fv_times(up, rr * sin(b0)))), fv_add(mid, fv_add(fv_times(right, rr * cos(b1)), fv_times(up, rr * sin(b1)))), blue, 0.5 * grow);
    }
  }
  // two struts from the dais to the ring's sides
  for side: 0..<2 {
    sg := ifx side == 0 then -1.0f32 else 1.0f32;
    v = seg(out, v, c, fv_add(foot, fv_times(right, sg * PORTAL_R * 0.55)), fv_add(mid, fv_add(fv_times(right, sg * PORTAL_R * 1.1 * 0.6), fv_times(up, -PORTAL_R * 1.1 * 0.8))), dais, 0.5 * grow);
  }
  // motes rising from the dais and spiralling into the face
  if !p.still {
    for i: 0..<PORTAL_MOTES {
      ph := fract(t * 0.18 + f32(i) * 0.6180339);
      ang := f32(i) * 2.399963 + t * 0.4;
      rr := PORTAL_DAIS * 0.8 * (1 - ph);
      pos := fv(foot.x + rr * cos(ang) * (1 - ph) + (mid.x - foot.x) * ph, PORTAL_LIFT * 0.5 + (mid.y - PORTAL_LIFT * 0.5) * ph * ph, foot.z + rr * sin(ang) * (1 - ph) + (mid.z - foot.z) * ph);
      sp := spot(c, pos);
      if sp.ok && inside(c.clip, sp.x, sp.y) { v = diamond(out, v, sp.x, sp.y, 1.6 * d, blue, 0.8 * grow * sin(ph * PI)); }
    }
  }
  return v;
}
// Its name over it, faded with the HUD.
portal_name :: (out: [] f32, at: int, s: [] LandState, c: Cam, p: Pen, light: f32) -> int {
  if light <= 0.003 { return at; }
  top := spot(c, fv_add(portal_mid(s), fv(0, PORTAL_R * 1.1 + 0.55, 0)));
  if !top.ok || !inside(c.clip, top.x, top.y) { return at; }
  d := p.d; cap := (ifx p.phone then 8.0f32 else 10.0f32) * d;
  white := chrome(dimmed(ink(p, INK_WHITE), light));
  w := text_width("EVERGLADE", cap, white);
  v := put(out, at, "EVERGLADE", top.x - w * 0.5, top.y, cap, white);
  return rule(out, v, top.x - hi(w, 70 * d) * 0.5, top.y + 7 * d, top.x + hi(w, 70 * d) * 0.5, top.y + 7 * d, dimmed(ink(p, INK_BLUE), light), 0.8 * light);
}
// The face: one quad on screen, over the ellipse and its glow (the whole view once it fills it), its
// light gpu/newland.coax's newland_portal. Drawn last, after the HUD.
portal_face :: (out: [] f32, at: int, s: [] LandState, width: f32, height: f32, p: Pen, t: f32) -> int {
  q := s[0].portal[..];
  grow := ifx p.still then 1.0f32 else ease((t - 1.0) / 1.6);
  if grow <= 0 { return at; }
  if !q[0].on {
    // flown past its middle (behind the near plane): the light is the whole view
    if !q[0].going { return at; }
    half := sqrt(width * width + height * height) * 0.5;
    q[0].sx = width * 0.5; q[0].sy = height * 0.5; q[0].rx = PORTAL_THROUGH * half; q[0].ry = q[0].rx;
  }
  sx := q[0].sx; sy := q[0].sy; rx := q[0].rx; ry := q[0].ry;
  // how far the view's farthest corner is from the middle, in the face's radii: 1 or less, it covers it
  far := 0.0f32;
  for k: 0..<4 {
    cx := ifx k % 2 == 0 then 0.0f32 else width; cy := ifx k < 2 then 0.0f32 else height;
    dx := (cx - sx) / rx; dy := (cy - sy) / ry;
    far = hi(far, sqrt(dx * dx + dy * dy));
  }
  q[0].fill = ifx q[0].going then 1 - smooth01((far - 1.0) / 2.0) else 0.0f32;
  x0 := clamp(sx - rx * 1.4, 0, width); x1 := clamp(sx + rx * 1.4, 0, width);
  y0 := clamp(sy - ry * 1.4, 0, height); y1 := clamp(sy + ry * 1.4, 0, height);
  if x1 - x0 < 1 || y1 - y0 < 1 || (at + 6) * VERTEX_FLOATS > out.count { return at; }
  swell := ifx q[0].going then smooth01((q[0].fill - 0.4) / 0.6) else 0.0f32;
  rim := grow * (1 - q[0].fill);
  xs := [6] f32.[x0, x1, x1, x0, x1, x0]; ys := [6] f32.[y0, y0, y1, y0, y1, y1];
  shimmer := portal_shimmer(s);
  for j: 0..<6 {
    o := (at + j) * VERTEX_FLOATS;
    out[o] = xs[j]; out[o + 1] = ys[j];
    out[o + 2] = (xs[j] - sx) / rx; out[o + 3] = (ys[j] - sy) / ry;
    out[o + 4] = rx; out[o + 5] = grow; out[o + 6] = swell; out[o + 7] = shimmer;
    out[o + 8] = rim; out[o + 9] = 0; out[o + 10] = 0; out[o + 11] = MODE_PORTAL;
  }
  return at + 6;
}
// The button, under the HUD's glass in slot g (one the page's own five don't use).
portal_button :: (out: [] f32, at: int, s: [] LandState, uniforms: [] f32, l: Layout, p: Pen, light: f32, width: f32, height: f32) -> int {
  q := s[0].portal[..];
  b := portal_box(l, width, height, p.d);
  q[0].box = b;
  if light <= 0.003 { return at; }
  d := p.d;
  hover := !s[0].touch && s[0].pointed && inside(b, s[0].px, s[0].py);
  breathe := ifx p.still then 1.0f32 else 0.85 + 0.15 * sin(p.time * 1.6);
  edge := ink(p, ifx hover then INK_BLUE else INK_BRIGHT); edge.glow = 6 * d;
  v := frame(out, at, b, 9 * d, edge, light * (ifx hover then 1.0f32 else 0.85f32 * breathe), p);
  // a thin line of the accent along its foot, the portal's colour
  v = rule(out, v, b.x0 + 18 * d, b.y1 - 6 * d, b.x1 - 18 * d, b.y1 - 6 * d, ink(p, INK_BLUE), light * 0.55 * breathe);
  k := ink(p, ifx hover then INK_BLUE else INK_BRIGHT); k.sans = false;
  cap := (ifx l.phone then 8.6f32 else 9.6f32) * d;
  tw := measure(PORTAL_LABEL, 0.5, 1.2, false) * cap;
  v = draw_text(out, v, PORTAL_LABEL, (b.x0 + b.x1 - tw) * 0.5, (b.y0 + b.y1 + cap) * 0.5 - 1 * d, cap, 0.5, 1.2, dimmed(k, light * (ifx hover then 1.15f32 else 1.0f32)), false, false);
  glass(uniforms, PANELS, b, 9 * d, 0.95 * light, 1);
  return v;
}
// After the frame's HUD: it fades as the flight starts; the page dims as the face fills the view;
// once the light has held it, the page goes on.
portal_end :: (s: [] LandState, out: [] f32, hud_from: int, hud_to: int, uniforms: [] f32) {
  q := s[0].portal[..];
  if !q[0].going { return; }
  out_k := 1 - smooth01(q[0].t / 0.35);
  for k: hud_from..<hud_to { out[k * VERTEX_FLOATS + 6] *= out_k; }
  for g: 0..<PANELS + 1 { uniforms[8 + g * 8 + 5] *= out_k; }
  uniforms[3] *= 1 - q[0].fill;
  if q[0].t >= PORTAL_FLY + PORTAL_HOLD && !q[0].went && s[0].action == 0 { go(s, PORTAL_URL); q[0].went = true; }
}

#test "portal: the button warms Character Create, the flight fills the view with the portal's light, then the page goes on" #steps 300000000 {
  s: [1] LandState; u: [UNIFORM_FLOATS] f32;
  out: [TEST_VERTICES * VERTEX_FLOATS] f32;
  s[0].time = 9;
  coaxial_land_message(s[..], 600, "now=1700000123456\n");
  #assert s[0].portal[0].clocked && abs(s[0].portal[0].wall - 323.456) < 0.01;
  #assert coaxial_land_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, false) > 1000 && s[0].portal[0].on;
  b := s[0].portal[0].box;
  #assert b.x1 - b.x0 >= 200 && b.y1 <= 900 && !inside(b, s[0].walk_box.x0 + 1, s[0].walk_box.y0 + 1);
  // the press: the cache is warmed with the page it goes to, nothing navigates yet
  #assert coaxial_land_pointer(s[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, POINTER_DOWN, 0, 1);
  #assert coaxial_land_pointer(s[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, POINTER_UP, 0, 1);
  #assert s[0].portal[0].going && s[0].action == ACT_WARM && cast(string) s[0].outbox[0..<s[0].out_n] == PORTAL_URL;
  coaxial_land_action_done(s[..]);
  // the face grows on screen every frame, and in the end covers the whole view (the flight's own
  // steps, without the rest of the page, which the other checks draw)
  home := s[0].view; pen := Pen.{d = 1, fade = 1, time = 9, still = false, phone = false};
  last := 0.0f32; frames := 0;
  while s[0].portal[0].t < PORTAL_FLY {
    c := portal_view(s[..], home, 1.0 / 60.0, 1440, 900);
    n := portal_face(out[..], portal_scene(out[..], 0, s[..], c, pen, 9), s[..], 1440, 900, pen, 9);
    for k: 0..<UNIFORM_FLOATS { u[k] = 0; } u[3] = 1;
    portal_end(s[..], out[..], 0, 0, u[..]);
    #assert n > 0 && s[0].action == 0;
    if s[0].portal[0].on { #assert s[0].portal[0].rx >= last * 0.999; last = s[0].portal[0].rx; }
    frames += 1;
  }
  #assert frames >= 120 && s[0].portal[0].fill > 0.99 && u[3] < 0.01;
  // the light holds, then the page goes on, once
  for i: 0..<40 { c := portal_view(s[..], home, 1.0 / 60.0, 1440, 900); n := portal_face(out[..], portal_scene(out[..], 0, s[..], c, pen, 9), s[..], 1440, 900, pen, 9); portal_end(s[..], out[..], 0, 0, u[..]); }
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == PORTAL_URL;
  coaxial_land_action_done(s[..]);
  for i: 0..<10 { c := portal_view(s[..], home, 1.0 / 60.0, 1440, 900); portal_end(s[..], out[..], 0, 0, u[..]); }
  #assert s[0].action == 0;
}
#test "portal: the flight starts on the page's own view, with no cut" #steps 200000000 {
  s: [1] LandState; u: [UNIFORM_FLOATS] f32;
  out: [TEST_VERTICES * VERTEX_FLOATS] f32;
  s[0].time = 9;
  n := coaxial_land_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, false);
  before := s[0].view;
  portal_go(s[..]);
  c := portal_view(s[..], before, 0.0, 1440, 900);
  #assert abs(c.eye.x - before.eye.x) + abs(c.eye.y - before.eye.y) + abs(c.eye.z - before.eye.z) < 0.01 && abs(c.focal - before.focal) < 0.5;
  // and each frame of it is a small step
  last := c;
  for i: 0..<int(PORTAL_FLY * 60) {
    nx := portal_view(s[..], before, 1.0 / 60.0, 1440, 900);
    #assert abs(nx.cx - last.cx) < 12 && abs(nx.cy - last.cy) < 12;
    last = nx;
  }
}
#test "portal: the button fits a phone above its row of buttons" {
  l := layout(390 * 3, 844 * 3, 3);
  b := portal_box(l, 390 * 3, 844 * 3, 3);
  #assert b.x0 >= 0 && b.x1 <= 390 * 3 && b.y1 <= l.playtest.y0 && b.y1 - b.y0 >= 40 * 3;
}
