// NIP-XP on the homepage. The reader (landing-xp.coax) verified each event's
// signature and shape; here the page keeps a reader's ledger: XP only from
// the referee's awards whose exact quest it holds, none for a revoked award
// or for two live awards on one uniqueness key (NIP-XP "Deriving a ledger").
// Pylon receipts (3201) and check labels (1985) are the work a pylon-check
// quest pays from; they are counted as work, never as XP.
// Live records send pulses across the Grid: a receipt flies from its Pylon
// to its bay's project, a check rings the Pylon blue, an award rises over
// the project it was earned on. XP is never sats, so no orange here.
XP_QUESTS :: 32; XP_AWARDS :: 64; XP_KEYS :: 48; XP_PROVIDERS :: 40; XP_RECEIPTS :: 128; XP_CHECKS :: 48; XP_REVOKES :: 16; XP_PULSES :: 16; XP_ROWS :: 2048;
XP_CODER :: 3; XP_VERSE :: 4; XP_PSIONIC :: 1;
PULSE_RECEIPT :: 1; PULSE_CHECK :: 2; PULSE_XP :: 3;
RULE_OTHER :: 0; RULE_PYLON :: 1; RULE_PLAYTEST :: 2;
// Event ids and uniqueness keys are held as hashes (xp_hash): the page only
// needs to tell them apart. Public keys stay whole, to match Pylons and name keys.
XpAward :: struct {id:int;quest:int;key:int;at:int;n:int;pk:[4]int;role:[4][12]u8;role_n:[4]int;xp:[4]int;counted:bool;}
XpPulse :: struct {kind:int;pylon:int;plot:int;xp:int;born:f32;live:bool;ok:bool;}
HomeXp :: struct {
  asked:bool;history:bool;work_history:bool;version:int;
  quests:int;quest_id:[XP_QUESTS]int;quest_title:[XP_QUESTS][96]u8;quest_title_n:[XP_QUESTS]int;quest_rule:[XP_QUESTS]int;
  awards:int;award:[XP_AWARDS]XpAward;revokes:int;revoke:[XP_REVOKES]int;
  keys:int;key:[XP_KEYS][64]u8;key_short:[XP_KEYS][20]u8;key_short_n:[XP_KEYS]int;key_xp:[XP_KEYS]int;key_awards:[XP_KEYS]int;
  total:int;counted:int;paid:int;
  providers:int;prov:[XP_PROVIDERS][64]u8;prov_slug:[XP_PROVIDERS][32]u8;prov_slug_n:[XP_PROVIDERS]int;prov_ok:[XP_PROVIDERS]int;prov_fail:[XP_PROVIDERS]int;prov_pass:[XP_PROVIDERS]int;
  receipts:int;receipt:[XP_RECEIPTS]int;receipt_prov:[XP_RECEIPTS]int;receipt_at:[XP_RECEIPTS]int;receipt_ok:[XP_RECEIPTS]bool;
  checks:int;check:[XP_CHECKS]int;
  accepted:int;failed:int;passed:int;
  pulse:[XP_PULSES]XpPulse;pulse_n:int;
  rows:[XP_ROWS]u8;rows_n:int;rows_version:int;
}
#test "a reader's ledger: revoked, conflicting and quest-less awards count for no one" {
  s:[1]LandState;s[0].golden=true;
  q:="{\"id\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"at\":10,\"t\":\"q\",\"rule\":\"eval-check\",\"title\":\"Check a result\"}";
  a:="{\"id\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"at\":11,\"t\":\"a\",\"quest\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"key\":\"k1\",\"aw\":[{\"pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"role\":\"checker\",\"xp\":50},{\"pubkey\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"role\":\"evaluator\",\"xp\":0}]}";
  xp_record(s[..],a);#assert s[0].xp[0].total==0;   // its quest isn't held yet
  xp_record(s[..],q);#assert s[0].xp[0].total==50 && s[0].xp[0].counted==1 && s[0].xp[0].keys==2 && s[0].xp[0].key_xp[0]==50;
  xp_record(s[..],a);#assert s[0].xp[0].awards==1 && s[0].xp[0].total==50;   // the same event counts once
  b:="{\"id\":\"3333333333333333333333333333333333333333333333333333333333333333\",\"at\":12,\"t\":\"a\",\"quest\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"key\":\"k1\",\"aw\":[{\"pubkey\":\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"role\":\"checker\",\"xp\":50}]}";
  xp_record(s[..],b);#assert s[0].xp[0].total==0 && s[0].xp[0].counted==0;   // two live awards on one key
  v:="{\"id\":\"4444444444444444444444444444444444444444444444444444444444444444\",\"at\":13,\"t\":\"v\",\"award\":\"3333333333333333333333333333333333333333333333333333333333333333\"}";
  xp_record(s[..],v);#assert s[0].xp[0].total==50 && s[0].xp[0].counted==1;
}
#test "receipts and checks are counted per Pylon, once each, and never as XP" {
  s:[1]LandState;s[0].golden=true;
  r:="{\"id\":\"5555555555555555555555555555555555555555555555555555555555555555\",\"at\":20,\"t\":\"r\",\"provider\":\"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"pylon\":\"mac\",\"ok\":1}";
  c:="{\"id\":\"6666666666666666666666666666666666666666666666666666666666666666\",\"at\":21,\"t\":\"c\",\"receipt\":\"5555555555555555555555555555555555555555555555555555555555555555\",\"provider\":\"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"pass\":1}";
  xp_record(s[..],r);xp_record(s[..],r);xp_record(s[..],c);
  #assert s[0].xp[0].accepted==1 && s[0].xp[0].passed==1 && s[0].xp[0].total==0;
  #assert xp_provider(s[..],"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")==0;
  #assert s[0].xp[0].prov_ok[0]==1 && s[0].xp[0].prov_pass[0]==1;
}
xp_hex_ok :: (s:string)->bool {if s.count!=64 {return false;}for c:s {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}return true;}
// Two polynomial hashes side by side: never overflows, and distinct ids and
// keys don't meet in practice.
xp_hash :: (s:string)->int {a:=7;b:=11;for c:s {a=(a*131+cast(int)c)%1000000007;b=(b*137+cast(int)c)%998244353;}return a*1000000000+b;}
xp_copy :: (dst:[]u8,src:string) {n:=lo_int(dst.count,src.count);for i:0..<n {dst[i]=src[i];}}
xp_index :: (table:[]int,count:int,h:int)->int {for i:0..<lo_int(count,table.count) {if table[i]==h {return i;}}return -1;}
xp_find :: (table:[][64]u8,count:int,id:string)->int {for i:0..<count {if cast(string)table[i][..]==id {return i;}}return -1;}
xp_provider :: (s:[]LandState,pk:string)->int {x:=s[0].xp[..];return xp_find(x[0].prov[..],x[0].providers,pk);}
xp_add_provider :: (s:[]LandState,pk:string,slug:string)->int {
  x:=s[0].xp[..];at:=xp_provider(s,pk);
  if at<0 {if x[0].providers>=XP_PROVIDERS {return -1;}at=x[0].providers;x[0].providers+=1;xp_copy(x[0].prov[at][..],pk);}
  if slug.count>0 && x[0].prov_slug_n[at]==0 {x[0].prov_slug_n[at]=hi_int(0,hn_cell(x[0].prov_slug[at][..],0,slug,28));}
  return at;
}
// The Pylon drawn for a provider key (-1 none).
xp_pylon_of :: (s:[]LandState,pk:string)->int {for i:0..<s[0].pylons {if pylon_value(s,s[0].pyl[i],26)==pk {return i;}}return -1;}
xp_quest :: (s:[]LandState,h:int)->int {x:=s[0].xp[..];return xp_index(x[0].quest_id[..],x[0].quests,h);}
xp_revoked :: (s:[]LandState,h:int)->bool {x:=s[0].xp[..];return xp_index(x[0].revoke[..],x[0].revokes,h)>=0;}
xp_rule :: (s:[]LandState,a:XpAward)->int {k:=xp_quest(s,a.quest);return ifx k<0 then RULE_OTHER else s[0].xp[0].quest_rule[k];}
// npub1abcd...wxyz (the hex's ends where no npub can be made).
xp_name :: (s:[]LandState,k:int) {
  x:=s[0].xp[..];out:[128]u8;n:= -1;
  if !s[0].golden && hn_put(0,cast(string)x[0].key[k][..]) && home_call(14,0,0,0)==1 {n=hn_output(out[..]);}
  text:=ifx n==63 then cast(string)out[0..<63] else cast(string)x[0].key[k][..];
  m:=app(x[0].key_short[k][..],0,text[0..<10]);m=app(x[0].key_short[k][..],m,"...");x[0].key_short_n[k]=app(x[0].key_short[k][..],m,text[text.count-4..<text.count]);
}
xp_short :: (s:[]LandState,k:int,out:[]u8)->int {x:=s[0].xp[..];return app(out,0,cast(string)x[0].key_short[k][0..<x[0].key_short_n[k]]);}
xp_key :: (s:[]LandState,pk:string)->int {
  x:=s[0].xp[..];at:=xp_find(x[0].key[..],x[0].keys,pk);if at>=0 {return at;}
  if x[0].keys>=XP_KEYS {return -1;}at=x[0].keys;x[0].keys+=1;xp_copy(x[0].key[at][..],pk);xp_name(s,at);return at;
}
// The ledger, derived again from the held records each time one changes.
xp_derive :: (s:[]LandState) {
  x:=s[0].xp[..];for k:0..<x[0].keys {x[0].key_xp[k]=0;x[0].key_awards[k]=0;}x[0].total=0;x[0].counted=0;x[0].paid=0;
  quests:[XP_QUESTS]bool;
  for i:0..<x[0].awards {
    a:=x[0].award[i];x[0].award[i].counted=false;
    if xp_revoked(s,a.id) {continue;}q:=xp_quest(s,a.quest);if q<0 {continue;}
    conflict:=false;
    for j:0..<x[0].awards {if j!=i && x[0].award[j].key==a.key && !xp_revoked(s,x[0].award[j].id) {conflict=true;break;}}
    if conflict {continue;}
    x[0].award[i].counted=true;x[0].counted+=1;if !quests[q] {quests[q]=true;x[0].paid+=1;}
    for w:0..<a.n {k:=a.pk[w];if a.xp[w]<=0 || k<0 {continue;}x[0].key_xp[k]+=a.xp[w];x[0].key_awards[k]+=1;x[0].total+=a.xp[w];}
  }
  x[0].version+=1;
}
xp_pulse :: (s:[]LandState,kind:int,pylon:int,plot:int,amount:int,delay:f32,live:bool,ok:bool) {
  x:=s[0].xp[..];slot:=x[0].pulse_n%XP_PULSES;x[0].pulse_n+=1;
  x[0].pulse[slot]=XpPulse.{kind=kind,pylon=pylon,plot=plot,xp=amount,born=s[0].time+delay,live=live,ok=ok};
}
// Where an award shows: a pylon-check award on its Pylon, a playtest on
// Verse, the eval and benchmark quests on Coder.
xp_award_place :: (s:[]LandState,a:XpAward,pylon:[]int)->int {
  how:=xp_rule(s,a);pylon[0]= -1;
  if how==RULE_PYLON && a.n>0 && a.pk[0]>=0 {i:=xp_pylon_of(s,cast(string)s[0].xp[0].key[a.pk[0]][..]);if i>=0 {pylon[0]=i;return s[0].pyl[i].plot;}return XP_PSIONIC;}
  return ifx how==RULE_PLAYTEST then XP_VERSE else XP_CODER;
}
xp_award_pulse :: (s:[]LandState,i:int,delay:f32,live:bool) {
  a:=s[0].xp[0].award[i];total:=0;for w:0..<a.n {total+=hi_int(0,a.xp[w]);}if total<=0 {return;}
  py:[1]int;plot:=xp_award_place(s,a,py[..]);xp_pulse(s,PULSE_XP,py[0],plot,total,delay,live,true);
}
// A verified record from the reader; live once its subscription is past EOSE.
xp_record :: (s:[]LandState,text:string) {
  x:=s[0].xp[..];t:=hn_string(text,"t");live:=ifx t=="r" || t=="c" then x[0].work_history else x[0].history;
  id:=hn_string(text,"id");at:=hn_number(text,"at");if !xp_hex_ok(id) {return;}h:=xp_hash(id);
  if t=="q" {
    if xp_quest(s,h)>=0 || x[0].quests>=XP_QUESTS {return;}k:=x[0].quests;x[0].quests+=1;x[0].quest_id[k]=h;
    x[0].quest_title_n[k]=hi_int(0,hn_cell(x[0].quest_title[k][..],0,hn_string(text,"title"),90));
    how:=hn_string(text,"rule");x[0].quest_rule[k]=ifx how=="pylon-check" then RULE_PYLON else ifx how=="playtest" then RULE_PLAYTEST else RULE_OTHER;
    xp_derive(s);
  }else if t=="a" {
    for i:0..<x[0].awards {if x[0].award[i].id==h {return;}}if x[0].awards>=XP_AWARDS {return;}
    a:XpAward;a.id=h;quest:=hn_string(text,"quest");key:=hn_string(text,"key");if !xp_hex_ok(quest) || key.count<1 {return;}
    a.quest=xp_hash(quest);a.key=xp_hash(key);a.at=at;
    j:[1]Json;json_start(j[..],hn_field(text,"aw"));if json_next(j[..])!=JSON_ARRAY {return;}
    while true {tk:=json_next(j[..]);if tk==JSON_ARRAY_END {break;}if tk!=JSON_OBJECT || a.n>=4 {return;}raw:=hn_raw(j[..],tk);
      pk:=hn_string(raw,"pubkey");if !xp_hex_ok(pk) {return;}a.pk[a.n]=xp_key(s,pk);a.role_n[a.n]=hi_int(0,hn_cell(a.role[a.n][..],0,hn_string(raw,"role"),12));a.xp[a.n]=hn_number(raw,"xp");a.n+=1;}
    if a.n<1 {return;}x[0].award[x[0].awards]=a;x[0].awards+=1;xp_derive(s);
    if live && x[0].award[x[0].awards-1].counted {xp_award_pulse(s,x[0].awards-1,0,true);}
  }else if t=="v" {
    award:=hn_string(text,"award");if !xp_hex_ok(award) {return;}r:=xp_hash(award);if xp_revoked(s,r) || x[0].revokes>=XP_REVOKES {return;}
    x[0].revoke[x[0].revokes]=r;x[0].revokes+=1;xp_derive(s);
  }else if t=="r" {
    if xp_index(x[0].receipt[..],x[0].receipts,h)>=0 {return;}
    p:=xp_add_provider(s,hn_string(text,"provider"),hn_string(text,"pylon"));if p<0 {return;}
    ok:=hn_number(text,"ok")==1;slot:=x[0].receipts%XP_RECEIPTS;x[0].receipts+=1;
    x[0].receipt[slot]=h;x[0].receipt_prov[slot]=p;x[0].receipt_at[slot]=at;x[0].receipt_ok[slot]=ok;
    if ok {x[0].accepted+=1;x[0].prov_ok[p]+=1;}else {x[0].failed+=1;x[0].prov_fail[p]+=1;}x[0].version+=1;
    if live {i:=xp_pylon_of(s,hn_string(text,"provider"));if i>=0 {xp_pulse(s,PULSE_RECEIPT,i,s[0].pyl[i].plot,0,0,true,ok);}}
  }else if t=="c" {
    if xp_index(x[0].check[..],x[0].checks,h)>=0 {return;}
    p:=xp_add_provider(s,hn_string(text,"provider"),"");if p<0 {return;}
    pass:=hn_number(text,"pass")==1;x[0].check[x[0].checks%XP_CHECKS]=h;x[0].checks+=1;
    if pass {x[0].passed+=1;x[0].prov_pass[p]+=1;}x[0].version+=1;
    if live {i:=xp_pylon_of(s,hn_string(text,"provider"));if i>=0 {xp_pulse(s,PULSE_CHECK,i,s[0].pyl[i].plot,0,0,true,pass);}}
  }
}
// History is in: replay its latest real records once, oldest first, as the
// page opens (work 6: receipts and checks on the Pylons drawn; 5: awards).
xp_history :: (s:[]LandState,code:int) {
  x:=s[0].xp[..];
  if code==5 {
    if x[0].history {return;}x[0].history=true;
    order:[XP_AWARDS]int;n:=0;for i:0..<x[0].awards {if x[0].award[i].counted {order[n]=i;n+=1;}}
    for i:0..<n {for j:i+1..<n {if x[0].award[order[j]].at>x[0].award[order[i]].at {tmp:=order[i];order[i]=order[j];order[j]=tmp;}}}
    shown:=lo_int(n,5);for k:0..<shown {xp_award_pulse(s,order[shown-1-k],1.0+1.5*cast(f32)k,false);}
  }else if code==6 {
    if x[0].work_history {return;}x[0].work_history=true;
    held:=lo_int(x[0].receipts,XP_RECEIPTS);order:[XP_RECEIPTS]int;n:=0;
    for i:0..<held {if xp_pylon_of(s,cast(string)x[0].prov[x[0].receipt_prov[i]][..])>=0 {order[n]=i;n+=1;}}
    for i:0..<n {for j:i+1..<n {if x[0].receipt_at[order[j]]>x[0].receipt_at[order[i]] {tmp:=order[i];order[i]=order[j];order[j]=tmp;}}}
    shown:=lo_int(n,6);
    for k:0..<shown {r:=order[shown-1-k];py:=xp_pylon_of(s,cast(string)x[0].prov[x[0].receipt_prov[r]][..]);
      xp_pulse(s,PULSE_RECEIPT,py,s[0].pyl[py].plot,0,0.6+1.1*cast(f32)k,false,x[0].receipt_ok[r]);
      if x[0].receipt_ok[r] && x[0].prov_pass[x[0].receipt_prov[r]]>0 && k==shown-1 {xp_pulse(s,PULSE_CHECK,py,s[0].pyl[py].plot,0,1.8+1.1*cast(f32)k,false,true);}
    }
  }
}

// ---- the feed: XP and receipts woven between the projects' rows
xp_rows :: (s:[]LandState,out:[]u8)->int {
  x:=s[0].xp[..];n:=0;
  // the 4 latest counted awards and the latest accepted receipt of 4 Pylons, newest first
  chosen:[8]int;at:[8]int;kind:[8]int;m:=0;
  for pass:0..<4 {best:= -1;
    for i:0..<x[0].awards {a:=x[0].award[i];if !a.counted {continue;}taken:=false;for k:0..<m {if kind[k]==PULSE_XP && chosen[k]==i {taken=true;}}
      if !taken && (best<0 || a.at>x[0].award[best].at) {best=i;}}
    if best<0 {break;}chosen[m]=best;at[m]=x[0].award[best].at;kind[m]=PULSE_XP;m+=1;}
  held:=lo_int(x[0].receipts,XP_RECEIPTS);
  for pass:0..<4 {best:= -1;
    for i:0..<held {if !x[0].receipt_ok[i] {continue;}taken:=false;for k:0..<m {if kind[k]==PULSE_RECEIPT && x[0].receipt_prov[chosen[k]]==x[0].receipt_prov[i] {taken=true;}}
      if !taken && (best<0 || x[0].receipt_at[i]>x[0].receipt_at[best]) {best=i;}}
    if best<0 {break;}chosen[m]=best;at[m]=x[0].receipt_at[best];kind[m]=PULSE_RECEIPT;m+=1;}
  for i:0..<m {for j:i+1..<m {if at[j]>at[i] {t0:=at[i];at[i]=at[j];at[j]=t0;t1:=chosen[i];chosen[i]=chosen[j];chosen[j]=t1;t2:=kind[i];kind[i]=kind[j];kind[j]=t2;}}}
  for r:0..<m {
    if kind[r]==PULSE_XP {
      a:=x[0].award[chosen[r]];py:[1]int;plot:=xp_award_place(s,a,py[..]);w:=0;for k:0..<a.n {if a.xp[k]>0 {w=k;break;}}
      k:=a.pk[w];who:[32]u8;wn:=ifx k>=0 then xp_short(s,k,who[..]) else 0;
      n=json_write_int(out,n,plot);n=json_raw(out,n,"|XP|");n=json_raw(out,n,cast(string)who[0..<wn]);n=json_raw(out,n,"|+");n=json_write_int(out,n,a.xp[w]);n=json_raw(out,n," XP ");
      n=json_raw(out,n,cast(string)a.role[w][0..<a.role_n[w]]);q:=xp_quest(s,a.quest);
      if q>=0 {n=json_raw(out,n,": ");n=json_raw(out,n,cast(string)x[0].quest_title[q][0..<x[0].quest_title_n[q]]);}
    }else {
      i:=chosen[r];p:=x[0].receipt_prov[i];py:=xp_pylon_of(s,cast(string)x[0].prov[p][..]);plot:=ifx py>=0 then s[0].pyl[py].plot else XP_PSIONIC;
      n=json_write_int(out,n,plot);n=json_raw(out,n,"|RECEIPT|");n=json_raw(out,n,cast(string)x[0].prov_slug[p][0..<x[0].prov_slug_n[p]]);
      n=json_raw(out,n,ifx x[0].prov_pass[p]>0 then "|Signed receipt: job accepted, rerun passed" else "|Signed receipt: job accepted");
    }
    n=json_raw(out,n,"|");n=json_write_int(out,n,at[r]);n=json_raw(out,n,"\n");
  }
  return hi_int(0,n);
}
// How many XP and receipt rows the feed weaves in (0 in a visual test).
xp_feed_rows :: (s:[]LandState)->int {
  x:=s[0].xp[..];if s[0].golden || (x[0].counted==0 && x[0].accepted==0) {return 0;}
  if x[0].rows_version!=x[0].version || x[0].rows_n==0 {x[0].rows_n=xp_rows(s,x[0].rows[..]);x[0].rows_version=x[0].version;}
  return rows(cast(string)x[0].rows[0..<x[0].rows_n]);
}
// Feed row r of nb projects' rows and nx XP rows, one XP row after every two
// of the projects': the text it is in, its row there in which[0].
xp_feed_row :: (s:[]LandState,nb:int,nx:int,r:int,which:[]int)->string {
  g:=lo_int(nx,nb/2);xp:=false;k:=0;
  if r<3*g {k=ifx r%3<2 then 2*(r/3)+r%3 else r/3;xp=r%3==2;}
  else {rest:=r-3*g;if rest<nb-2*g {k=2*g+rest;}else {xp=true;k=g+rest-(nb-2*g);}}
  which[0]=k;return ifx xp then cast(string)s[0].xp[0].rows[0..<s[0].xp[0].rows_n] else land_feed(s);
}
#test "the feed weaves one XP row after every two of the projects'" {
  s:[1]LandState;w:[1]int;
  t:=xp_feed_row(s[..],4,3,2,w[..]);#assert w[0]==0 && t.count==0;
  t=xp_feed_row(s[..],4,3,3,w[..]);#assert w[0]==2;
  t=xp_feed_row(s[..],4,3,6,w[..]);#assert w[0]==2 && t.count==0;
}

// ---- the Grid: pulses and the marks real work leaves
xp_bez :: (a:Fv,b:Fv,lift:f32,f:f32)->Fv {
  m:=fv((a.x+b.x)*0.5,hi(a.y,b.y)+lift,(a.z+b.z)*0.5);g:=1-f;
  return fv(g*g*a.x+2*g*f*m.x+f*f*b.x,g*g*a.y+2*g*f*m.y+f*f*b.y,g*g*a.z+2*g*f*m.z+f*f*b.z);
}
xp_scene :: (out:[]f32,at:int,s:[]LandState,c:Cam,p:Pen,t:f32)->int {
  v:=at;x:=s[0].xp[..];d:=p.d;if p.still || s[0].golden {return v;}
  seen:=ease((t-2.4)/1.4);if seen<=0 {return v;}
  white:=ink(p,INK_WHITE);bright:=ink(p,INK_BRIGHT);blue:=ink(p,INK_BLUE);dim:=ink(p,INK_DIM);pale:=ink(p,INK_PALE);
  // a Pylon's checked work: an orbit of its passes (blue) and accepted receipts
  for i:0..<s[0].pylons {
    q:=s[0].pyl[i];pr:=xp_provider(s,pylon_value(s,q,26));if pr<0 {continue;}
    passes:=lo_int(x[0].prov_pass[pr],8);oks:=lo_int(x[0].prov_ok[pr],12);if passes+oks==0 {continue;}
    v=loop3(out,v,c,q.x,0.02,q.z,0.62,dim,0.22*seen);
    total:=passes+oks;
    for k:0..<total {a:=t*0.35+cast(f32)k*2*PI/cast(f32)total+cast(f32)i;sp:=spot(c,fv(q.x+0.62*cos(a),0.02,q.z+0.62*sin(a)));
      if sp.ok && inside(c.clip,sp.x,sp.y) {v=diamond(out,v,sp.x,sp.y,(ifx k<passes then 1.9f32 else 1.3f32)*d,ifx k<passes then blue else pale,(ifx k<passes then 0.85f32 else 0.5f32)*seen);}}
  }
  // a crown over a project that has paid XP
  if x[0].counted>0 && XP_CODER<s[0].plots {
    pl:=s[0].plot[XP_CODER];top:=tree_height(pl)+0.75;
    for k:0..<3 {a0:=t*0.4+cast(f32)k*2*PI/3;v=seg(out,v,c,fv(pl.x+0.55*cos(a0),top,pl.z+0.55*sin(a0)),fv(pl.x+0.55*cos(a0+1.2),top,pl.z+0.55*sin(a0+1.2)),pale,0.5*seen);}
  }
  for n:0..<lo_int(x[0].pulse_n,XP_PULSES) {
    u:=x[0].pulse[n];age:=t-u.born;if age<0 {continue;}
    gain:=ifx u.live then 1.0f32 else 0.8f32;
    if u.kind==PULSE_RECEIPT {
      if age>2.6 || u.pylon<0 || u.pylon>=s[0].pylons || u.plot<0 || u.plot>=s[0].plots {continue;}
      q:=s[0].pyl[u.pylon];pl:=s[0].plot[u.plot];
      from:=fv(q.x,machine_top(q)+beam_height(q),q.z);to:=fv(pl.x,tree_height(pl)+0.3,pl.z);
      if age<0.7 {g:=age/0.7;v=loop3(out,v,c,q.x,0.02,q.z,0.4+1.2*g,ifx u.ok then bright else dim,0.6*(1-g)*gain);}
      f:=ease(age/1.5);tail:=hi(0,f-0.3);k:=ifx u.ok then white else dim;
      if age<1.7 {for j:0..<10 {f0:=tail+(f-tail)*cast(f32)j/10;f1:=tail+(f-tail)*cast(f32)(j+1)/10;v=seg(out,v,c,xp_bez(from,to,2.4,f0),xp_bez(from,to,2.4,f1),k,(0.15+0.85*cast(f32)(j+1)/10)*gain*(1-0.6*clamp((age-1.4)/0.3,0,1)));}
        head:=spot(c,xp_bez(from,to,2.4,f));if head.ok && inside(c.clip,head.x,head.y) {v=diamond(out,v,head.x,head.y,3*d,k,gain);}}
      if u.ok && age>1.4 {g:=(age-1.4)/1.2;v=loop3(out,v,c,pl.x,0.03,pl.z,0.8+2.6*g,bright,0.7*(1-g)*gain);v=loop3(out,v,c,pl.x,0.03,pl.z,0.5+1.6*g,white,0.4*(1-g)*gain);}
    }else if u.kind==PULSE_CHECK {
      if age>2.2 || u.pylon<0 || u.pylon>=s[0].pylons {continue;}
      q:=s[0].pyl[u.pylon];g:=age/2.2;k:=ifx u.ok then blue else dim;
      v=loop3(out,v,c,q.x,0.03,q.z,0.5+1.4*g,k,0.9*(1-g)*gain);v=loop3(out,v,c,q.x,0.03,q.z,0.3+0.9*g,k,0.6*(1-g)*gain);
      tip:=spot(c,fv(q.x,machine_top(q)+beam_height(q)+0.4,q.z));
      if tip.ok && inside(c.clip,tip.x,tip.y) {label:=ifx u.ok then "CHECK PASS" else "CHECK FAIL";kk:=chrome(k);v=put_centred(out,v,label,tip.x,tip.y-26*d*ease(g),6.6*d,dimmed(kk,(1-g*g)*gain));}
    }else if u.kind==PULSE_XP {
      if age>3.2 || u.plot<0 || u.plot>=s[0].plots {continue;}
      g:=age/3.2;px:=s[0].plot[u.plot].x;pz:=s[0].plot[u.plot].z;base:=0.03f32;top:=tree_height(s[0].plot[u.plot])+0.9;
      if u.pylon>=0 && u.pylon<s[0].pylons {q:=s[0].pyl[u.pylon];px=q.x;pz=q.z;top=machine_top(q)+beam_height(q)+0.5;}
      rise:=ease(clamp(age/0.5,0,1));fade:=1-clamp((age-2.2)/1.0,0,1);
      v=seg(out,v,c,fv(px,base,pz),fv(px,base+(top+2.2)*rise,pz),white,0.55*fade*gain);
      v=loop3(out,v,c,px,base,pz,0.6+2.8*g,blue,0.7*(1-g)*gain);
      hd:=spot(c,fv(px,top+1.6,pz));
      if hd.ok && inside(c.clip,hd.x,hd.y) {
        y:=hd.y-28*d*ease(clamp(age/1.6,0,1));buf:[24]u8;bn:=app(buf[..],0,"+");bn=app_int(buf[..],bn,u.xp);
        cap:=(ifx p.phone then 10.0f32 else 13.0f32)*d;wk:=chrome(white);wk.glow=6*d;nw:=text_width(cast(string)buf[0..<bn],cap,wk);
        sw:=text_width("XP",cap*0.62,chrome(blue));x0:=hd.x-(nw+5*d+sw)*0.5;
        v=put(out,v,cast(string)buf[0..<bn],x0,y,cap,dimmed(wk,fade*gain));v=put(out,v,"XP",x0+nw+5*d,y,cap*0.62,dimmed(chrome(blue),fade*gain));
      }
    }
  }
  return v;
}

// ---- the HUD: the ledger under the wordmark (a line on a phone)
xp_comma :: (buf:[]u8,n:int,value:int)->int {
  if value<1000 {return app_int(buf,n,value);}m:=app_int(buf,n,value/1000);m=app(buf,m,",");
  r:=value%1000;if r<100 {m=app(buf,m,"0");}if r<10 {m=app(buf,m,"0");}return app_int(buf,m,r);
}
xp_has :: (s:[]LandState)->bool {x:=s[0].xp[..];return !s[0].golden && (x[0].counted>0 || x[0].accepted>0 || x[0].passed>0);}
xp_box :: (l:Layout,d:f32,height:f32)->Box {top:=86*d;return Box.{x0=28*d,y0=top,x1=28*d+256*d,y1=lo(top+214*d,height-232*d)};}
xp_panel :: (out:[]f32,at:int,s:[]LandState,l:Layout,p:Pen,width:f32,height:f32,light:f32)->int {
  v:=at;if light<=0 || !xp_has(s) {return v;}x:=s[0].xp[..];d:=p.d;
  white:=chrome(ink(p,INK_WHITE));dim:=ink(p,INK_DIM);bright:=ink(p,INK_BRIGHT);blue:=ink(p,INK_BLUE);
  if l.phone {
    line:[96]u8;n:=xp_comma(line[..],0,x[0].total);n=app(line[..],n," XP from ");n=app_int(line[..],n,x[0].counted);n=app(line[..],n," awards");
    return put_fit(out,v,cast(string)line[0..<n],16*d,96*d,6.5*d,dimmed(ink(p,INK_PALE),light),l.galaxy.x0-26*d);
  }
  b:=xp_box(l,d,height);if b.y1-b.y0<120*d {return v;}
  v=frame(out,v,b,8*d,bright,0.7*light,p);
  left:=b.x0+14*d;right:=b.x1-14*d;y:=b.y0+20*d;
  v=rule(out,v,left-2*d,y-3.8*d,left+4*d,y-3.8*d,dimmed(bright,light),light);v=put(out,v,"XP",left+10*d,y,7.6*d,dimmed(bright,light));
  state:=ifx x[0].history then "SIGNED AWARDS" else "SYNCING";sw:=text_width(state,6*d,dim);
  v=put(out,v,state,right-sw-10*d,y,6*d,dimmed(dim,light));
  beat:=0.55+0.45*sin(p.time*2.4);v=diamond(out,v,right-3*d,y-3*d,2.4*d,blue,beat*light);
  y+=34*d;
  big:[32]u8;bn:=xp_comma(big[..],0,x[0].total);cap:=20*d;bk:=white;bk.glow=7*d;
  v=put(out,v,cast(string)big[0..<bn],left,y,cap,dimmed(bk,light));bw:=text_width(cast(string)big[0..<bn],cap,bk);
  v=put(out,v,"XP",left+bw+6*d,y,9*d,dimmed(chrome(blue),light));
  sub:[64]u8;sn:=app_int(sub[..],0,x[0].counted);sn=app(sub[..],sn," awards / ");sn=app_int(sub[..],sn,x[0].paid);sn=app(sub[..],sn," quests");
  subw:=text_width(cast(string)sub[0..<sn],6.4*d,dim);v=put(out,v,cast(string)sub[0..<sn],right-subw,y,6.4*d,dimmed(dim,light));
  y+=18*d;
  // the leaders: who holds the most XP in this reader's ledger
  order:[5]int;on:=0;
  for k:0..<x[0].keys {if x[0].key_xp[k]<=0 {continue;}slot:=on;if on<5 {on+=1;}else if x[0].key_xp[k]<=x[0].key_xp[order[4]] {continue;}else {slot=4;}
    order[slot]=k;while slot>0 && x[0].key_xp[order[slot]]>x[0].key_xp[order[slot-1]] {tmp:=order[slot];order[slot]=order[slot-1];order[slot-1]=tmp;slot-=1;}}
  most:=ifx on>0 then x[0].key_xp[order[0]] else 1;
  rows_room:=cast(int)floor((b.y1-56*d-y)/(15*d));
  for r:0..<lo_int(on,hi_int(0,rows_room)) {
    k:=order[r];y+=15*d;rank:[4]u8;rn:=app_int(rank[..],0,r+1);
    v=put(out,v,cast(string)rank[0..<rn],left,y,6.2*d,dimmed(dim,light));
    who:[32]u8;wn:=xp_short(s,k,who[..]);v=put_fit(out,v,cast(string)who[0..<wn],left+12*d,y,6.4*d,dimmed(ink(p,INK_PALE),light),100*d);
    val:[16]u8;vn:=xp_comma(val[..],0,x[0].key_xp[k]);vw:=text_width(cast(string)val[0..<vn],6.6*d,white);v=put(out,v,cast(string)val[0..<vn],right-vw,y,6.6*d,dimmed(white,light));
    bx0:=left+118*d;bx1:=right-vw-8*d;by:=y-2.6*d;
    if bx1>bx0 {v=rule(out,v,bx0,by,bx1,by,dim,0.18*light);f:=cast(f32)x[0].key_xp[k]/cast(f32)hi_int(1,most);v=rule(out,v,bx0,by,bx0+(bx1-bx0)*f*ease(clamp((p.time-3)/1.5,0,1)),by,ifx r==0 then blue else ink(p,INK_PALE),0.85*light);}
  }
  // the Pylon work a pylon-check quest pays from
  y=b.y1-36*d;v=rule(out,v,left,y-10*d,right,y-10*d,dim,0.14*light);
  v=put(out,v,"PYLON WORK",left,y,6.4*d,dimmed(bright,light));
  y+=16*d;w:[96]u8;wn:=app_int(w[..],0,x[0].accepted);wn=app(w[..],wn," receipts accepted / ");wn=app_int(w[..],wn,x[0].passed);wn=app(w[..],wn," reruns passed");
  v=put_fit(out,v,cast(string)w[0..<wn],left,y,6.6*d,dimmed(ink(p,INK_WHITE),light),right-left);
  return v;
}
// The Pylon card's work rows; returns the vertex count, ys[0] the next y.
xp_pylon_rows :: (out:[]f32,at:int,s:[]LandState,q:Pyl,x0:f32,right:f32,p:Pen,ys:[]f32)->int {
  v:=at;pr:=xp_provider(s,pylon_value(s,q,26));if pr<0 || s[0].golden {return v;}x:=s[0].xp[..];d:=p.d;y:=ys[0];
  v=section(out,v,"SIGNED WORK",x0,y,right,p);y+=20*d;
  rb:[64]u8;rn:=app_int(rb[..],0,x[0].prov_ok[pr]);rn=app(rb[..],rn," accepted");if x[0].prov_fail[pr]>0 {rn=app(rb[..],rn,", ");rn=app_int(rb[..],rn,x[0].prov_fail[pr]);rn=app(rb[..],rn," failed");}
  v=kv(out,v,"Receipts",cast(string)rb[0..<rn],x0,right,y,p);y+=18*d;
  cb:[32]u8;cn:=app_int(cb[..],0,x[0].prov_pass[pr]);cn=app(cb[..],cn," passed");v=kv(out,v,"Checker reruns",cast(string)cb[0..<cn],x0,right,y,p);y+=18*d;
  k:=xp_find(x[0].key[..],x[0].keys,pylon_value(s,q,26));xb:[24]u8;xn:=xp_comma(xb[..],0,ifx k>=0 then x[0].key_xp[k] else 0);xn=app(xb[..],xn," XP");
  v=kv(out,v,"XP",cast(string)xb[0..<xn],x0,right,y,p);y+=24*d;ys[0]=y;return v;
}
