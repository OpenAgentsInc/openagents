// Nostr Lab (openagents.com/worlds/nostr-lab, unlisted): Nostr's keys, events, IDs and signatures as a
// short walk on the Grid, for Episode 295. You walk your own character down one lit lane past four
// stations:
//   1 a key pair: the secret key's 32 bytes, never shown, and the public key it makes, as hex and npub
//   2 an event: a kind 1 note taking shape field by field
//   3 the ID: the event's NIP-01 bytes into SHA-256, the ID out
//   4 the signature: BIP-340 over the ID, valid; one letter of the content changed, and it fails
// Every value is worked out at run time by coax/lib/nostr/ and the shared crypto (nostr-lab-lesson.coax).
//
// The walking, the camera, the HUD, WORLDS, the slabs, the skyline and the Grid are the lab walk's
// (verse/lab-walk.coax), shared with Bitcoin Lab; this module names the stations and draws their
// lessons. Its C face is nostr-lab-walk-face.c over lab-walk-face.h.
//   coax/remote/remote.sh run -- coax/bin/coax test --library apps/openagents-web/nostr-lab-walk.coax --only "nostr lab walk"
#run_steps 250000000;   // secp256k1's signing tables, built at compile time (event_sign.coax)
#load "../../verse/lab-walk.coax";
#load "nostr-lab-lesson.coax";

NW_STATIONS :: 4;
NW_STATION_Z :: [NW_STATIONS] f32.[-10, -25, -40, -55];
NW_STATION_SIDE :: [NW_STATIONS] f32.[-1, 1, -1, 1];
NW_NAME :: [NW_STATIONS] string.["KEY PAIR", "AN EVENT", "THE ID", "THE SIGNATURE"];
NW_LINE :: [NW_STATIONS] string.[
  "A secret key makes a public key. Only the public one is shown.",
  "An event: your public key, a time, a kind, tags and content.",
  "The event's bytes go into SHA-256. The ID comes out.",
  "The key signs the ID. Change one letter and it fails.",
];
NW_INTRO :: "Walk the lane: a key, an event, its ID, its signature.";
NW_PURPLE :: LabRgb.{r = 0.85, g = 0.42, b = 1.35};   // Nostr's colour, for the public key

NostrWalk :: struct {
  w: [1] LabWalk;
  lesson: [1] NostrLesson;
}
// The walk's stations and words: set on every call in, so a fresh state has them.
nw_conf :: (nk: [] NostrWalk) -> [] LabWalk {
  w := nk[0].w[..];
  if w[0].n == 0 { lab_conf(w, "NOSTR LAB", NW_INTRO, "NOSTR: KEYS, EVENTS, IDS AND SIGNATURES", "NOSTR", NW_STATION_Z[..], NW_STATION_SIDE[..], NW_NAME[..], NW_LINE[..]); }
  return w;
}

// A JSON field on a face: its key in one colour, its value after it in another.
nw_field :: (w: [] LabWalk, x0: f32, z: f32, u: f32, v: f32, h: f32, key: string, value: string, kc: LabRgb, vc: LabRgb, light: f32) {
  lab_say(w, key, x0, z, u, v, h, kc, light);
  lab_say(w, value, x0, z, u + f32(key.count) * h * 6 / 7, v, h, vc, light + 0.2);
}
// The first `shown` characters of t: text typed in as you arrive.
nw_typed :: (t: string, shown: int) -> string { n := shown; if n < 0 { n = 0; } if n > t.count { n = t.count; } return t[0..<n]; }

// 1 a key pair: the secret key's 32 bytes as lamps with no digits, then the public key it makes.
nw_keys :: (nk: [] NostrWalk, i: int, lit: f32) {
  w := nk[0].w[..]; x0 := lab_left(w, i); z := lab_face(w, i); l := nk[0].lesson[0]; t := lab_anim(w, i);
  lab_say(w, "SECRET KEY", x0, z, 0.35, 3.05, 0.17, LAB_CYAN, 1.0);
  lab_say(w, "32 BYTES, HIDDEN", x0, z, LAB_PANEL_W - 0.35 - lab_text_w(16, 0.17), 3.05, 0.17, LAB_ORANGE, 1.1 + lit);
  cell := 0.12f32; pitch := 0.205f32; u0 := (LAB_PANEL_W - (32 * pitch - (pitch - cell))) * 0.5;
  on := cast(int) lab_clamp(t * 24, 0, 32); if t <= 0 { on = 0; }
  for k: 0..<32 {
    c := ifx k < on then lab_scale(LAB_ORANGE, 0.45) else LAB_DIM;
    lab_face_z(w, x0 + u0 + f32(k) * pitch + cell * 0.5, 2.62, z + 0.01, cell * 0.5, 0.17, c, ifx k < on then 0.4 else 0.1, ifx k < on then 1.1 else 0.5, 1);
  }
  lab_say(w, "PUBLIC KEY", x0, z, 0.35, 2.05, 0.17, LAB_GOLD, 1.0);
  shown := cast(int) ((t - 1.0) * 48); h := 0.17f32; row := lab_text_w(32, h);
  for r: 0..<2 {
    part := nw_typed(cast(string) l.pub_hex[r * 32..<r * 32 + 32], shown - r * 32);
    lab_say(w, part, x0, z, (LAB_PANEL_W - row) * 0.5, 1.72 - f32(r) * 0.27, h, NW_PURPLE, 1.2);
  }
  lab_say(w, "NPUB", x0, z, 0.35, 1.0, 0.17, LAB_GOLD, 1.0);
  np := cast(string) l.npub[0..<l.npub_n]; typed := cast(int) ((t - 2.4) * 40); h2 := 0.2f32; row2 := lab_text_w(32, h2);
  half := (np.count + 1) / 2;
  lab_say(w, nw_typed(np[0..<half], typed), x0, z, (LAB_PANEL_W - row2) * 0.5, 0.66, h2, LAB_ICE, 1.3 + lit);
  lab_say(w, nw_typed(np[half..<np.count], typed - half), x0, z, (LAB_PANEL_W - row2) * 0.5, 0.36, h2, LAB_ICE, 1.3 + lit);
}
// 2 an event: its fields one after another, the newest lit; the ID and the signature still to come.
NW_FIELDS :: 5;
nw_event :: (nk: [] NostrWalk, i: int, lit: f32) {
  w := nk[0].w[..]; x0 := lab_left(w, i); z := lab_face(w, i); l := nk[0].lesson[0]; t := lab_anim(w, i);
  h := 0.2f32; u := 0.6f32; top := 3.1f32; step := 0.3f32;
  shown := ifx t > 0 then cast(int) ((t - 0.4) / 0.9) + 1 else 0;
  newest := shown - 1;
  lab_say(w, "{", x0, z, u - 0.25, top, h, LAB_ICE, 1.0);
  b: [64] u8;
  for f: 0..<NW_FIELDS {
    if f >= shown { continue; }
    v := top - f32(f + 1) * step; n := 0; key := "";
    if f == 0 { key = "\"pubkey\": "; n = lab_str(b[..], 0, "\""); n = lab_str(b[..], n, cast(string) l.pub_hex[0..<16]); n = lab_str(b[..], n, "...\","); }
    else if f == 1 { key = "\"created_at\": "; n = lab_int(b[..], 0, NL_CREATED); n = lab_str(b[..], n, ","); }
    else if f == 2 { key = "\"kind\": "; n = lab_int(b[..], 0, NL_KIND); n = lab_str(b[..], n, ","); }
    else if f == 3 { key = "\"tags\": "; n = lab_str(b[..], 0, NL_TAGS); n = lab_str(b[..], n, ","); }
    else { key = "\"content\": "; n = lab_str(b[..], 0, "\""); n = lab_str(b[..], n, NL_CONTENT); n = lab_str(b[..], n, "\","); }
    fresh := f == newest && t < 0.4 + 0.9 * f32(NW_FIELDS) + 0.6;
    nw_field(w, x0, z, u, v, h, key, cast(string) b[0..<n], LAB_CYAN, ifx fresh then LAB_ORANGE else ifx f == 0 then NW_PURPLE else LAB_GOLD, ifx fresh then 1.5 else 1.0);
  }
  if shown > NW_FIELDS {
    nw_field(w, x0, z, u, top - 6 * step, h, "\"id\": ", "?", LAB_DIM, LAB_DIM, 0.9);
    nw_field(w, x0, z, u, top - 7 * step, h, "\"sig\": ", "?", LAB_DIM, LAB_DIM, 0.9);
    lab_say(w, "}", x0, z, u - 0.25, top - 8 * step, h, LAB_ICE, 1.0);
  }
}
// 3 the ID: the event's bytes flow into SHA-256 and the 32 bytes of its ID come out.
nw_id :: (nk: [] NostrWalk, i: int, lit: f32) {
  w := nk[0].w[..]; x0 := lab_left(w, i); z := lab_face(w, i); l := nk[0].lesson[0]; t := lab_anim(w, i); now := lab_clock(w);
  // in: the serialized bytes, small, eighteen a row
  pre := cast(string) l.pre[0..<l.pre_n]; h := 0.105f32; per := 18;
  rows := (pre.count + per - 1) / per;
  for r: 0..<rows { e := (r + 1) * per; if e > pre.count { e = pre.count; } lab_say(w, pre[r * per..<e], x0, z, 0.3, 3.05 - f32(r) * 0.19, h, LAB_CYAN, 0.9); }
  b: [32] u8; n := lab_int(b[..], 0, pre.count); n = lab_str(b[..], n, " BYTES");
  lab_say(w, cast(string) b[0..<n], x0, z, 0.3, 1.0, 0.17, LAB_CYAN, 1.0);
  // the hash: a lit box
  bx := x0 + 3.55; lab_face_z(w, bx, 2.25, z + 0.01, 0.7, 0.6, LAB_ORANGE, 0.35 + 0.15 * lit, 1.5, 1);
  lab_say_mid(w, "SHA", x0, z + 0.01, 3.55, 2.32, 0.24, LabRgb.{r = 1.6, g = 1.5, b = 1.3}, 1.6);
  lab_say_mid(w, "256", x0, z + 0.01, 3.55, 1.95, 0.24, LabRgb.{r = 1.6, g = 1.5, b = 1.3}, 1.6);
  // the flow: a beam in and a beam out, a light running along each
  lab_beam(w, lab_v(x0 + 2.05, 2.25, z + 0.015), lab_v(bx - 0.72, 2.25, z + 0.015), 0.06, LAB_CYAN, 1.6, false);
  lab_beam(w, lab_v(bx + 0.72, 2.25, z + 0.015), lab_v(x0 + 4.75, 2.25, z + 0.015), 0.06, LAB_ORANGE, 1.6, false);
  run := now * 0.7 - floor(now * 0.7);
  lab_lamp(w, x0 + 2.05 + (bx - 0.72 - x0 - 2.05) * run, 2.25, z + 0.02, 0.16, LAB_CYAN, 2.2);
  lab_lamp(w, bx + 0.72 + (x0 + 4.75 - bx - 0.72) * run, 2.25, z + 0.02, 0.16, LAB_ORANGE, 2.2);
  // out: the ID, four rows of sixteen digits, appearing as you arrive
  shown := cast(int) lab_clamp((t - 0.5) * 40, 0, 64);
  for r: 0..<4 { a := r * 16; e := a + 16; if e > shown { e = shown; } if e > a { lab_say(w, cast(string) l.id_hex[a..<e], x0, z, 4.85, 2.75 - f32(r) * 0.3, 0.15, LAB_GOLD, 1.2); } }
  lab_say(w, "EVENT ID", x0, z, 4.85, 1.0, 0.17, LAB_GOLD, 1.0);
  lab_say_mid(w, "[0, PUBKEY, CREATED_AT, KIND, TAGS, CONTENT]", x0, z, LAB_PANEL_W * 0.5, 0.42, 0.14, LAB_ICE, 0.9);
}
// 4 the signature: 64 bytes over the ID, and the check; then the content with one letter changed, its
// bytes' new ID, and the same check failing; back and forth.
NW_SWAP :: 2.6f32;
nw_changed :: (w: [] LabWalk, t: f32) -> bool { if t < 2.5 { return false; } return (cast(int) ((t - 2.5) / NW_SWAP)) % 2 == 1; }
nw_sig :: (nk: [] NostrWalk, i: int, lit: f32) {
  w := nk[0].w[..]; x0 := lab_left(w, i); z := lab_face(w, i); l := nk[0].lesson[0]; t := lab_anim(w, i);
  lab_say(w, "SIGNATURE", x0, z, 0.35, 3.12, 0.17, LAB_CYAN, 1.0);
  lab_say(w, "64 BYTES, BIP-340", x0, z, LAB_PANEL_W - 0.35 - lab_text_w(17, 0.17), 3.12, 0.17, LAB_CYAN, 0.9);
  h := 0.15f32; row := lab_text_w(32, h); shown := cast(int) lab_clamp((t - 0.3) * 64, 0, 128);
  for r: 0..<4 { a := r * 32; e := a + 32; if e > shown { e = shown; } if e > a { lab_say(w, cast(string) l.sig_hex[a..<e], x0, z, (LAB_PANEL_W - row) * 0.5, 2.8 - f32(r) * 0.24, h, LAB_GOLD, 1.2); } }
  changed := nw_changed(w, t);
  // the content, its changed letter lit
  hc := 0.22f32; adv := hc * 6 / 7; key := "\"content\": \""; u := 0.6f32;
  content := ifx changed then cast(string) l.changed_content[0..<l.changed_content_n] else NL_CONTENT;
  lab_say(w, key, x0, z, u, 1.75, hc, LAB_CYAN, 1.0);
  cu := u + f32(key.count) * adv;
  for k: 0..<content.count {
    hit := changed && k == NL_CHANGE_AT;
    if hit { lab_face_z(w, x0 + cu + f32(k) * adv + adv * 0.42, 1.75 + hc * 0.5, z + 0.012, adv * 0.6, hc * 0.75, lab_scale(LAB_ORANGE, 0.3), 0.3, 1.3, 1); }
    lab_say(w, content[k..<k + 1], x0, z + 0.01, cu + f32(k) * adv, 1.75, hc, ifx hit then LAB_WHITE else LAB_GOLD, ifx hit then 1.8 else 1.1);
  }
  lab_say(w, "\"", x0, z, cu + f32(content.count) * adv, 1.75, hc, LAB_CYAN, 1.0);
  // the ID those bytes hash to
  ids := ifx changed then cast(string) l.changed_id_hex[0..<32] else cast(string) l.id_hex[0..<32];
  lab_say(w, "ID", x0, z, u, 1.32, 0.17, LAB_CYAN, 1.0);
  lab_say(w, ids, x0, z, u + lab_text_w(4, 0.17), 1.32, 0.17, ifx changed then LAB_ORANGE else LAB_GOLD, 1.2);
  lab_say(w, "...", x0, z, u + lab_text_w(4, 0.17) + lab_text_w(33, 0.17), 1.32, 0.17, LAB_DIM, 1.0);
  // the check
  if t > 1.6 {
    ok := ifx changed then l.changed_sig else l.valid;
    lab_say_mid(w, ifx ok then "SIGNATURE VALID" else "SIGNATURE FAILS", x0, z, LAB_PANEL_W * 0.5, 0.42, 0.4, ifx ok then LAB_GREEN else LAB_RED, 1.4 + lit);
  }
}

nw_station :: (nk: [] NostrWalk, i: int) {
  lit := lab_station(nk[0].w[..], i);
  if i == 0 { nw_keys(nk, i, lit); } else if i == 1 { nw_event(nk, i, lit); } else if i == 2 { nw_id(nk, i, lit); } else { nw_sig(nk, i, lit); }
}
nw_list :: (nk: [] NostrWalk, u: [] f32) {
  w := nw_conf(nk);
  lab_list_begin(w, u);
  if nk[0].lesson[0].ready { for i: 0..<NW_STATIONS { nw_station(nk, i); } }
  lab_list_end(w);
}
nw_stand :: (nk: [] NostrWalk) {
  w := nw_conf(nk);
  _ := nl_ready(nk[0].lesson[..]);
  none: [6] f32; lab_stand(w, none[..], 0);
}

// ---- the realm: what nostr-lab-walk-face.c calls
nostr_frame :: (nk: [] NostrWalk, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  w := nw_conf(nk); s := w[0].z[..];
  if !s[0].creator[0].on { w[0].quad_n = 0; return 0; }
  if !w[0].stood { nw_stand(nk); }
  n := lab_frame(w, out, u, width, height, dpr, dt, still);
  if u.count >= 32 { nw_list(nk, u); }
  return n;
}
nostr_pointer :: (nk: [] NostrWalk, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) { return lab_pointer(nw_conf(nk), x, y, phase, kind, id); }
nostr_pointer_buttons :: (nk: [] NostrWalk, x: f32, y: f32, phase: int, kind: int, id: int, button: int) -> bool #export_c #effects(all) { return lab_pointer_buttons(nw_conf(nk), x, y, phase, kind, id, button); }
// On a local page, ?at=N stands you before station N (1 to 4) for shots and clips.
nostr_message :: (nk: [] NostrWalk, kind: int, t: string) #export_c #effects(all) { _ := lab_message(nw_conf(nk), kind, t); }

// ---- checks
nw_test_lab :: (nk: [] NostrWalk) {
  w := nw_conf(nk);
  w[0].z[0].creator[0].width = 1280; w[0].z[0].creator[0].height = 720; w[0].z[0].creator[0].scale = 1;
  nostr_message(nk, HOST_PAGE, "url=https://openagents.com/worlds/nostr-lab\n");
}
#test "nostr lab walk: the page stands a level, bare zone with four stations down the lane" #steps 2000000000 {
  nk: [1] NostrWalk; nw_test_lab(nk[..]); w := nk[0].w[..]; s := w[0].z[..];
  #assert w[0].on && s[0].creator[0].flat && s[0].bare && s[0].put_z == w[0].start_z;
  #assert w[0].n == NW_STATIONS && w[0].name[3] == "THE SIGNATURE" && w[0].title == "NOSTR LAB";
  for k: 1..<NW_STATIONS { #assert NW_STATION_Z[k] < NW_STATION_Z[k - 1] - 10; }
  nw_stand(nk[..]); p := w[0].z[0].creator[0].props[0];
  #assert p.n == NW_STATIONS + LAB_TOWERS && !wprops.props_inside(p, 0, 1, NW_STATION_Z[0]);
  #assert nk[0].lesson[0].ready;
}
#test "nostr lab walk: every station lists its lesson's live values as glyphs, in budget" #steps 2000000000 {
  nk: [1] NostrWalk; nw_test_lab(nk[..]); nw_stand(nk[..]); w := nk[0].w[..];
  for i: 0..<NW_STATIONS { w[0].near_at[i] = -30; }   // as if you came to each a while ago: every value shown
  w[0].z[0].creator[0].clock = 0;
  u: [64] f32; u[16] = 0; u[17] = 2.5; u[18] = w[0].start_z + 4; w[0].z[0].creator[0].player_z = w[0].start_z;
  nw_list(nk[..], u[..]);
  n := w[0].quad_n; #assert n > 600 && n < LAB_QUADS && w[0].quads[3] == QK_SKY;
  // the npub's letters are on station 1: count the glyphs of its 63 characters among the quads
  glyphs := 0; for k: 0..<n { if w[0].quads[k * LAB_QF + 3] == QK_GLYPH { glyphs += 1; } }
  #assert glyphs > 63 + 64 + 128 + 64;
}
#test "nostr lab walk: at the signature the content swaps to its changed letter and back" {
  w: [1] LabWalk;
  #assert !nw_changed(w[..], 0) && !nw_changed(w[..], 2.4) && !nw_changed(w[..], 2.5 + NW_SWAP * 0.5) && nw_changed(w[..], 2.5 + NW_SWAP * 1.5) && !nw_changed(w[..], 2.5 + NW_SWAP * 2.5);
}
