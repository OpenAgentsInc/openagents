// Amounts that float up from the graph's clusters, as payments landing do in
// the Payment Network demo (aethyr-cpp web/payment-network.js): white digits
// with a Bitcoin-orange glow and a bolt,
// drifting up 7 CSS pixels a second (about 25 in all), popping a little as they appear and fading
// out. Here they are very faint and few, part of the background.
//
// Like the graph, nothing is stored: amount k is born at a fixed time, and
// its place, size and colour come from a hash of k.

NUMBER_QUADS :: 320;   // NUMBER_ALIVE amounts of up to NUMBER_DIGITS glyphs, with room
NUMBER_FIRST :: 6.5;   // seconds before the first one, after COMING SOON
NUMBER_EVERY :: 1.9;   // seconds between them
NUMBER_LIFE :: 3.6;    // seconds each one lives
NUMBER_ALIVE :: 3;     // at most this many at once (NUMBER_LIFE / NUMBER_EVERY, rounded up)
NUMBER_DIGITS :: 7;
NUMBER_CAP :: 8.0;     // cap height, CSS pixels
NUMBER_LIGHT :: 0.2;   // very faint
NUMBER_RISE :: 7.0;    // CSS pixels a second: a short drift, staying low

// An amount in sats, from 21 to about 210,000, spread evenly in magnitude.
number_amount :: (k: int) -> int { return cast(int) (21 * exp(hash(k, 5) * 9.2)); }

// Writes amount's text (a bolt, then its digits) into text.
// Returns how many characters.
number_text :: (amount: int, text: [] u8) -> int {
  if text.count < NUMBER_DIGITS + 1 { return 0; }
  digits: [NUMBER_DIGITS] u8;
  n := 0;
  v := ifx amount < 0 then 0 else amount;
  while n < NUMBER_DIGITS {
    digits[n] = cast(u8) ('0' + v % 10);
    n += 1; v = v / 10;
    if v == 0 { break; }
  }
  text[0] = '*';
  for i: 0..<n { text[1 + i] = digits[n - 1 - i]; }
  return n + 1;
}

// How bright an amount is at age seconds, 0 to 1, and how big (its pop).
number_opacity :: (age: f32) -> f32 {
  if age < 0 || age > NUMBER_LIFE { return 0; }
  return lo(clamp(age / 0.14, 0, 1), clamp((NUMBER_LIFE - age) / 0.6, 0, 1));
}
number_pop :: (age: f32) -> f32 { return 1 + 0.22 * hi(0, 1 - age / 0.22); }

// Draws the amounts alive at time t from vertex at. Returns the vertices written.
numbers_draw :: (out: [] f32, at: int, width: f32, height: f32, dpr: f32, t: f32, still: bool) -> int {
  if still || t < NUMBER_FIRST { return 0; }
  newest := cast(int) floor((t - NUMBER_FIRST) / NUMBER_EVERY);
  band := lo(height, width * 0.7);
  vertices := at;
  text: [NUMBER_DIGITS + 1] u8;
  points: [32] u8;
  for back: 0..<NUMBER_ALIVE {
    k := newest - back;
    if k < 0 { break; }
    age := t - NUMBER_FIRST - cast(f32) k * NUMBER_EVERY;
    shown := number_opacity(age);
    if shown <= 0 { continue; }
    // above one of the satellite clusters, a little to one side
    c := 1 + (cast(int) (hash(k, 1) * SATELLITES)) % SATELLITES;
    x := (0.5 + satellite_x(c) * 0.5) * width + (hash(k, 2) - 0.5) * 0.06 * width;
    y := 0.5 * height - satellite_y(c) * 0.5 * band - 0.05 * band - age * NUMBER_RISE * dpr;
    count := number_text(number_amount(k), text[..]);
    cap := NUMBER_CAP * dpr * number_pop(age);
    unit := cap / 6;
    w := 0.0f32;
    for i: 0..<count { w += glyph_width(text[i]) * unit; if i + 1 < count { w += GAP * 0.6 * cap; } }
    left := x - w * 0.5;
    light := NUMBER_LIGHT * shown;
    red := GOLD_R * 1.0f32; green := GOLD_G * 1.0f32; blue := GOLD_B * 1.0f32;
    for i: 0..<count {
      n := glyph(text[i], points[..]);
      for p: 1..<n {
        ax := left + cast(f32) points[(p - 1) * 2] * unit;
        ay := y - cast(f32) points[(p - 1) * 2 + 1] * unit;
        bx := left + cast(f32) points[p * 2] * unit;
        by := y - cast(f32) points[p * 2 + 1] * unit;
        if lit(out, vertices, ax, ay, bx, by, CORE * dpr, light, GLOW * 1.4 * dpr, red, green, blue, MODE_GLOW_TEXT) { vertices += 6; }
      }
      left += glyph_width(text[i]) * unit + GAP * 0.6 * cap;
    }
  }
  return vertices - at;
}

#test "amounts are written with a bolt" {
  text: [NUMBER_DIGITS + 1] u8;
  #assert number_text(2100, text[..]) == 5 && text[0] == '*' && text[1] == '2' && text[4] == '0';
  #assert number_text(7, text[..]) == 2 && text[0] == '*' && text[1] == '7';
  for k: 0..<200 { a := number_amount(k); #assert a >= 21 && a < 10000000; }
}

#test "amounts rise, fade and never crowd" {
  #assert number_opacity(-1) == 0 && number_opacity(NUMBER_LIFE + 0.1) == 0;
  #assert number_opacity(1) == 1 && number_pop(0) > 1.2 && number_pop(1) == 1;
  #assert NUMBER_LIFE <= NUMBER_EVERY * NUMBER_ALIVE;
  #assert NUMBER_RISE * NUMBER_LIFE <= 30;   // they stay low
  out: [NUMBER_QUADS * 6 * VERTEX_FLOATS] f32;
  #assert numbers_draw(out[..], 0, 1280, 800, 1, 3, false) == 0;
  #assert numbers_draw(out[..], 0, 1280, 800, 1, 30, true) == 0;
  most := 0;
  for s: 0..<80 {
    n := numbers_draw(out[..], 0, 1280, 800, 2, NUMBER_FIRST + cast(f32) s * 0.37, false);
    #assert n % 6 == 0 && n <= NUMBER_QUADS * 6;
    most = ifx n > most then n else most;
  }
  #assert most > 0;
}

#test "every glyph an amount uses is drawn" {
  points: [32] u8;
  for c: 0..<10 { #assert glyph(cast(u8) ('0' + c), points[..]) >= 3; }
  #assert glyph('+', points[..]) > 0 && glyph('*', points[..]) > 0;
}
