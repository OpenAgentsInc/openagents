// Shared browser/native read-only Lab client. Effects are an explicit two-
// slot outbox; platform hosts execute only the URLs/cancels supplied here.
#load "../../../../bitcoin/lab/model.coax";
#load "../../../../bitcoin/lab/page.coax";
#load "../../../../bitcoin/lab/selection.coax";
#load "bitcoin-lab-replay.coax";
LrEffect :: struct {wanted:bool;cancel:int=-1;path:[1024]u8;n:int;}
LrBlock :: struct {hash:[64]u8;previous:[64]u8;work:[64]u8;work_n:int;height:int;time:int;size:int;weight:int;count:int;active:bool;fees:int=-1;subsidy:int=-1;}
LabRemote :: struct {
  active:bool;info:bool;model:[1]LabClient;effects:[2]LrEffect;
  window:[24]LrBlock;wn:int;window_offset:int;window_total:int;window_next:[256]u8;next_n:int;
  body:[LAB_REPLY_MAX]u8;n:int;nodes:[32768]JvNode;node_n:int;scratch:[32768]JvNode;
  kind:int=2;key:[256]u8;kn:int;offset:int;total:int;returned:int;selected:int=-1;output:int;
  page_next:[256]u8;pn:int;poll:f32;elapsed:int;clock:f64;query:[256]u8;qn:int;search:bool;notice:int;
  block:LrBlock;has_block:bool;table:bool;detail:int;table_page:int;
  history:[12]LabPlace;history_n:int;restore:LabPlace;restore_stage:int;restore_strict:bool;
  replay:[1]LabReplay;transition:bool;phase_before:int;auto_tail:bool;
}
#test "Lab remote source selection cancels both effects and emits only allowlisted URLs" {
  s:[1]LabRemote;lr_select(s[..],2,0);#assert s[0].active && s[0].effects[1].wanted;

  route:=lr_route("GET",cast(string)s[0].effects[1].path[0..<s[0].effects[1].n]);#assert route.code==200 && route.source==2 && route.kind==2 && route.ticket==1;
  lr_dispatched(s[..],1,7);lr_select(s[..],1,2);#assert s[0].effects[1].cancel==7 && s[0].model[0].phase==2 && !s[0].model[0].ready;
  lr_select(s[..],0,0);#assert !s[0].active && !s[0].effects[1].wanted;
}
#test "Lab late callbacks cannot overwrite the admitted object's JSON offsets" {
  s:[1]LabRemote;s[0].active=true;text:="{\"marker\":\"before\"}";s[0].n=text.count;for i:0..<text.count {s[0].body[i]=text[i];}
  d:[1]Jv;#assert jv_parse(d[..],text,s[0].nodes[..]);s[0].node_n=d[0].count;
  #assert lm_begin(s[0].model[..],1,7)==1 && lm_begin(s[0].model[..],1,7)==2;
  lr_receive(s[..],7,LM_SAMPLE);#assert lr_text(s[..],0,"marker")=="before" && s[0].model[0].base[0].pending[1].serial==2;
}
#test "Lab undispatched views cannot shadow a live transport slot" {
  s:[1]LabRemote;s[0].active=true;#assert lm_begin(s[0].model[..],0,0)==1;
  lr_queue(s[..],1);#assert s[0].model[0].base[0].pending[1].id==9;
  lr_receive(s[..],0,LM_SAMPLE);
  #assert s[0].model[0].base[0].pending[0].id== -1 && s[0].model[0].base[0].pending[1].id==9 && s[0].effects[1].wanted;
  #assert s[0].model[0].error==0;
}
#test "Lab view clearing preserves the authority's increasing transport backoff" {
  s:[1]LabRemote;s[0].active=true;#assert lm_begin(s[0].model[..],1,7)==1;lr_receive(s[..],7,"503\n{}");#assert s[0].model[0].retry_at==500;
  s[0].elapsed=10;#assert lm_begin(s[0].model[..],1,7)==2;lr_receive(s[..],7,"503\n{}");#assert s[0].model[0].retry_at==1010 && s[0].model[0].failures==2;
}
#test "Lab own-node links normalize the fixture-only phase" {s:[1]LabRemote;lr_select(s[..],2,2);#assert s[0].model[0].phase==0;}
lr_document :: (s:[]LabRemote)->Jv {return Jv.{text=cast(string)s[0].body[0..<s[0].n],nodes=s[0].nodes[..],count=s[0].node_n,ok=true};}
lr_cancel :: (s:[]LabRemote) {
  for i:0..<2 {id:=s[0].model[0].base[0].pending[i].id;if id>=0 && id<8 {s[0].effects[i].cancel=id;}s[0].effects[i].wanted=false;s[0].model[0].base[0].pending[i].id= -1;}
}
lr_select :: (s:[]LabRemote,source:int,phase:int) {
  lr_cancel(s);s[0].active=source!=0;s[0].info=false;s[0].wn=0;s[0].n=0;s[0].selected= -1;s[0].search=false;s[0].kn=0;s[0].offset=0;s[0].window_offset=ifx source==1 then ((LAB_SNAPSHOTS[phase].count-1)/24)*24 else 0;s[0].kind=2;
  s[0].has_block=false;s[0].notice=0;s[0].table=false;s[0].detail=0;s[0].table_page=0;s[0].history_n=0;s[0].restore_stage=0;s[0].transition=false;s[0].replay[0].playing=false;s[0].auto_tail=source==2;
  if source==0 {return;}lm_select(s[0].model[..],source,ifx source==2 then 0 else phase);lr_queue(s,1);
}
lr_queue :: (s:[]LabRemote,slot:int) {
  id:=s[0].model[0].base[0].pending[slot].id;if id>=0 && id<8 {s[0].effects[slot].cancel=id;}
  ticket:=lm_begin(s[0].model[..],slot,0);if ticket<0 {s[0].model[0].ready=false;s[0].model[0].error=503;return;}
  // Platform ids are 0..7. A reserved outbox has its own distinct sentinel
  // until dispatch, so an older live callback cannot be mistaken for it.
  s[0].model[0].base[0].pending[slot].id=8+slot;
  o:[1]Jo;jo_start(o[..],s[0].effects[slot].path[..]);kind:=ifx slot==0 then 1 else s[0].kind;
  jo_put(o[..],"/api/lab/v1/");jo_put(o[..],[7]string.["snapshot","window","transactions","transaction","script","outputs","search"][kind-1]);
  jo_put(o[..],"?source=");jo_put(o[..],ifx s[0].model[0].source==1 then "fixture" else "own-node");jo_put(o[..],"&ticket=");jo_int(o[..],ticket);jo_put(o[..],"&cursor=");
  identity:=s[0].model[0].identity;
  if kind==1 || kind==2 || kind==7 {jo_put(o[..],"latest");}else {jo_put(o[..],cast(string)identity.cursor[0..<identity.cn]);}
  if s[0].model[0].source==1 {jo_put(o[..],"&phase=");jo_int(o[..],s[0].model[0].phase);}
  jo_put(o[..],"&offset=");jo_int(o[..],ifx kind==2 then s[0].window_offset else s[0].offset);
  if kind>=3 {jo_put(o[..],"&key=");jo_put(o[..],cast(string)s[0].key[0..<s[0].kn]);}
  s[0].effects[slot].n=o[0].n;s[0].effects[slot].wanted=!o[0].bad;s[0].poll=0;
}
lr_dispatched :: (s:[]LabRemote,slot:int,id:int) #export_c #effects(all) {
  s[0].effects[slot].wanted=false;s[0].model[0].base[0].pending[slot].id=id;
  if id<0 {s[0].model[0].ready=false;s[0].model[0].error=503;s[0].model[0].retry_at=s[0].elapsed+500;}
}
lr_query :: (s:[]LabRemote,kind:int,key:string,offset:int) {
  if !lr_token(key,256) || kind<3 || kind>7 || offset<0 {return;}
  s[0].info=false;s[0].has_block=false;s[0].notice=0;s[0].table_page=0;s[0].kind=kind;s[0].kn=key.count;for i:0..<key.count {s[0].key[i]=key[i];}s[0].offset=offset;s[0].selected= -1;s[0].output=0;s[0].n=0;
  lr_queue(s,1);
}
lr_tx :: (s:[]LabRemote,index:int)->int {
  d:=lr_document(s);if s[0].kind==4 {return jv_get(d,0,"transaction");}
  return jv_at(d,jv_get(d,0,"transactions"),index);
}
lr_text :: (s:[]LabRemote,node:int,key:string)->string {d:=lr_document(s);return jv_raw(d,jv_get(d,node,key));}
lr_int :: (s:[]LabRemote,node:int,key:string)->int {d:=lr_document(s);return jv_int(d,jv_get(d,node,key),-1);}
lr_child :: (s:[]LabRemote,node:int,key:string,index:int)->int {d:=lr_document(s);return jv_at(d,jv_get(d,node,key),index);}
lr_size :: (s:[]LabRemote,node:int,key:string)->int {d:=lr_document(s);return jv_len(d,jv_get(d,node,key));}
lr_fail :: (s:[]LabRemote,code:int) {
  s[0].model[0].ready=false;s[0].model[0].error=code;if s[0].model[0].retry_at<=s[0].elapsed {s[0].model[0].retry_at=s[0].elapsed+lm_backoff(s[0].model[0].failures);s[0].model[0].failures+=1;}s[0].wn=0;s[0].n=0;s[0].selected= -1;
}
lr_receive :: (s:[]LabRemote,id:int,text:string) {
  if !s[0].active {return;}slot:= -1;for i:0..<2 {if s[0].model[0].base[0].pending[i].id==id {slot=i;}}
  if slot<0 {return;}identity:=lm_decode(text,s[0].scratch[..]);d:[1]Jv;
  accepted:=lm_receive(s[0].model[..],slot,id,identity,s[0].elapsed);if accepted==0 {return;}
  if accepted<0 {lr_fail(s,s[0].model[0].error);return;}
  if slot==0 {
    if accepted==2 || !s[0].model[0].ready {s[0].wn=0;s[0].n=0;s[0].kind=2;s[0].window_offset=0;lr_queue(s,1);}return;
  }
  // Decode to owned bytes/offsets. No persistent string points into an inbox
  // or another engine instance; a rescue reissues effects before using it.
  s[0].n=text.count-4;for i:0..<s[0].n {s[0].body[i]=text[4+i];}
  if !jv_parse(d[..],cast(string)s[0].body[0..<s[0].n],s[0].nodes[..]) {lr_fail(s,502);return;}s[0].node_n=d[0].count;v:=d[0];
  if s[0].kind==2 {
    array:=jv_get(v,0,"blocks");count:=jv_len(v,array);page:=jv_get(v,0,"page");
    if !lp_counts(v,page,count,LAB_WINDOW_MAX,s[0].window_offset,cast(string)identity.cursor[0..<identity.cn]) {lr_fail(s,502);return;}
    s[0].wn=count;s[0].window_total=jv_int(v,jv_get(v,page,"total"),-1);s[0].next_n=jv_str(v,jv_get(v,page,"next"),s[0].window_next[..]);
    for i:0..<count {
      b:=lr_block(v,jv_at(v,array,i));if b.height<0 {lr_fail(s,502);return;}s[0].window[i]=b;
    }s[0].selected= -1;
    if s[0].auto_tail {s[0].auto_tail=false;if s[0].window_total>24 {s[0].window_offset=((s[0].window_total-1)/24)*24;lr_queue(s,1);return;}}
    if s[0].transition {lbr_admitted(s[0].replay[..],s[0].phase_before,s[0].model[0].phase);s[0].transition=false;}
  }else if s[0].kind==7 {
    kind:=jv_raw(v,jv_get(v,0,"kind"));key:=jv_raw(v,jv_get(v,0,"key"));target:=ifx kind=="block" then 3 else ifx kind=="transaction" then 4 else ifx kind=="script" then 5 else 0;
    if target==0 {lr_fail(s,502);return;}saved:[256]u8;n:=key.count;if n>256 {lr_fail(s,502);return;}for i:0..<n {saved[i]=key[i];}lr_query(s,target,cast(string)saved[0..<n],0);
  }else {
    page:=jv_get(v,0,"page");if s[0].kind==4 {page=jv_path(v,0,"transaction.output_page");}
    length:=ifx s[0].kind==4 then jv_len(v,jv_path(v,0,"transaction.outputs")) else jv_len(v,jv_get(v,0,ifx s[0].kind==6 then "outputs" else "transactions"));cap:=ifx s[0].kind==4 || s[0].kind==6 then 16 else 32;
    if !lp_counts(v,page,length,cap,s[0].offset,cast(string)identity.cursor[0..<identity.cn]) {lr_fail(s,502);return;}
    s[0].total=jv_int(v,jv_get(v,page,"total"),-1);s[0].returned=jv_int(v,jv_get(v,page,"returned"),-1);s[0].pn=jv_str(v,jv_get(v,page,"next"),s[0].page_next[..]);
    if s[0].kind==3 || s[0].kind==5 {if lr_size(s,0,"transactions")>LAB_TX_MAX {lr_fail(s,502);return;}s[0].selected=ifx lr_size(s,0,"transactions")>0 then 0 else -1;}
    if s[0].kind==4 {s[0].selected=0;}
    if s[0].kind==6 {s[0].selected=ifx length>0 then 0 else -1;}
    txs:=ifx s[0].kind==4 then 1 else ifx s[0].kind==6 then 0 else length;
    for i:0..<txs {tx:=lr_tx(s,i);for name:[2]string.["inputs","outputs"] {
      array:=jv_get(v,tx,name);page=jv_get(v,tx,ifx name=="inputs" then "input_page" else "output_page");size:=jv_len(v,array);
      if !lp_counts(v,page,size,16,ifx s[0].kind==4 then s[0].offset else 0,cast(string)identity.cursor[0..<identity.cn]) {lr_fail(s,502);return;}
    }}
    bi:=jv_get(v,0,"block_info");if bi>=0 {s[0].block=lr_block(v,bi);if s[0].block.height<0 {lr_fail(s,502);return;}s[0].has_block=true;}
  }
  lr_after_place(s);
}
lr_frame :: (s:[]LabRemote,dt:f32) {
  if !s[0].active {return;}s[0].clock+=cast(f64)dt*1000;s[0].elapsed=cast(int)s[0].clock;s[0].poll+=dt;
  pending:=s[0].model[0].base[0].pending;
  if pending[0].id>=0 || pending[1].id>=0 || s[0].effects[0].wanted || s[0].effects[1].wanted {return;}
  if s[0].model[0].error!=0 {
    if s[0].model[0].error==404 {return;}
    if s[0].elapsed>=s[0].model[0].retry_at {s[0].kind=2;lr_queue(s,1);}return;
  }
  if s[0].poll>=5 {lr_queue(s,0);}
}
lr_block :: (v:Jv,at:int)->LrBlock {
  b:LrBlock;b.height= -1;
  if jv_str(v,jv_get(v,at,"hash"),b.hash[..])!=64 || jv_str(v,jv_get(v,at,"previous"),b.previous[..])!=64 {return b;}
  b.work_n=jv_str(v,jv_get(v,at,"chainwork"),b.work[..]);height:=jv_int(v,jv_get(v,at,"height"),-1);b.time=jv_int(v,jv_get(v,at,"time"),-1);b.size=jv_int(v,jv_get(v,at,"size"),-1);b.weight=jv_int(v,jv_get(v,at,"weight"),-1);b.count=jv_int(v,jv_get(v,at,"tx_count"),-1);
  if height<0 || b.time<0 || b.size<0 || b.size>4000000 || b.weight<0 || b.weight>4000000 || b.count<1 || b.count>1000000 {return b;}
  b.height=height;b.active=jv_bool(v,jv_get(v,at,"active"));b.fees=jv_int(v,jv_get(v,at,"fees_sat"),-1);b.subsidy=jv_int(v,jv_get(v,at,"subsidy_sat"),-1);return b;
}
#load "bitcoin-lab-navigation.coax";
