];
CL_REC_EXPLAIN :: "E0303: name already declared; no shadowing";                // coax explain E0303
CL_REC_AUTH_1 :: "auth.coax:3:1: error[E0380]: 'fee' is not exercised";            // coax check auth.coax (one line, wrapped here)
CL_REC_AUTH_2 :: "by any #test or #forall";
CL_REC_AUTH_FIX_1 :: "  fix: #authority files check every procedure:";
CL_REC_AUTH_FIX_2 :: "       add a #test or #forall that calls it";
CL_REC_AUTH_PASS :: "1 check, 1 passed, 0 failed";                             // coax test auth.coax, after the #test is added
CL_REC_FORALL :: "ok   #forall refunds (1974 cases, native, 0 ms)";            // coax test coax/examples/money.coax
CL_REC_CHECKS :: "10 checks, 10 passed, 0 failed";
CL_REC_MUTATE :: "43 mutants, 43 killed, 0 survived";                          // coax mutate coax/examples/money.coax
// coax c and coax wgsl of metaverse-engine/fx/quad-wave.coax's qfx_wave: the first two lines of each.
CL_REC_WAVE_C :: [2] string.[
  "static float coax_p_qfx_wave(float l_x, float l_y, float l_t) {",
  "  float l_ax = (l_x + 0x1.19999ap-1f);",
];
CL_REC_WAVE_WGSL :: [2] string.[
  "fn coax_p_qfx_wave(p_x: f32, p_y: f32, p_t: f32) -> f32 {",
  "  l_ax = (l_x + 0x1.19999ap-1f);",
];
// git ls-files '*.coax' by folder at ed22cd4c22 (2026-11-13), tests, examples and generated seeds included.
CL_BUILT :: 8;
CL_BUILT_DIR :: [CL_BUILT] string.["coax/", "psionic/", "metaverse-engine/", "apps/", "metaverse/", "bitcoin/", "nostr/", "everglade/"];
CL_BUILT_WHAT :: [CL_BUILT] string.["THE COMPILER, LIBRARIES, WEB", "MACHINE LEARNING", "THE GAME ENGINE", "OPENAGENTS.COM AND THE APPS", "THE WORLDS", "BITCOIN FROM SCRATCH", "NOSTR FROM SCRATCH", "EVERGLADE, THE MMORPG"];
CL_BUILT_FILES :: [CL_BUILT] int.[2020, 1600, 1490, 555, 324, 234, 213, 211];
CL_BUILT_TOTAL :: 7467;

// ---- each station's live values, checked in the page: the walk shows a station as finished only when these hold
CL_STATIONS :: 17;
cl_verify :: (station: int) -> bool {
  if station == 0 { v := cl_names(); return v.limit == 64 && v.sum == 3 && v.half_tenths == 10; }
  if station == 2 { c := cl_count_after(CL_COUNT_ADDS); return c.stopped && c.checked == 255 && c.wrapped == 4; }
  if station == 3 { return cl_layout(0).size == 16 && cl_layout_padding(cl_layout(0)) == 0 && cl_layout(1).size > cl_layout(2).size && cl_layout_padding(cl_layout(1)) > cl_layout_padding(cl_layout(2)); }
  if station == 4 { cells := CL_CELLS; return cl_view_read(cells[..], 2, 4, 3).value == 9 && !cl_view_read(cells[..], 2, 4, 4).ok; }
  if station == 5 { b: [4] u8; n := cl_defer_order(b[..]); good := cl_parse("42"); bad := cl_parse("4x"); return n == 3 && cast(string) b[0..<3] == "CBA" && good.ok && good.value == 42 && bad.refused && bad.cleanups == 1; }
  if station == 6 { g := cl_life_seed(0); for i: 0..<4 { g = cl_life_step(g); } return g.generation == 4 && g.alive > 0; }
  if station == 7 { t: [CL_TOKENS] ClTok; return cl_lex("x := add(1, 2.5);", t[..]) == 9; }
  if station == 8 { return cl_crc32("123456789") == 0xCBF43926 && cl_crc32("123456789") == CL_CRC_CHECK; }
  if station == 9 { return cl_mandel_at(17, 61) == cl_escape(cl_mandel_cr(61), cl_mandel_ci(17)) && cl_mandel_at(17, 61) == CL_MLIMIT; }
  if station == 11 { return cl_cases_failing(false) == 0; }
  if station == 12 { return cl_cases_failing(true) == 40; }
  return true;   // 1 the procedure and 14 the targets are checked by the walk (it holds their procedures); the rest are recorded
}

// ---- checks
#test "coax lab: the declarations give the values the station shows" {
  v := cl_names(); #assert v.limit == 64 && v.x == 1 && v.y == 2 && v.sum == 3 && v.half_tenths == 10;
}
#forall "coax lab: a u8 counts to 255 and the checked add stops there; the wrapping one goes round" adds: 0..<40 {
  c := cl_count_after(adds);
  #assert c.adds == adds && cast(int) c.wrapped == (CL_COUNT_FROM + adds) % 256;
  #assert c.stopped == (adds > 5) && cast(int) c.checked == (ifx adds > 5 then 255 else CL_COUNT_FROM + adds);
}
#test "coax lab: ten adds from 250 end stopped at 255, and wrapped at the 4 a release build prints" {
  c := cl_count_after(CL_COUNT_ADDS); #assert c.stopped && c.checked == 255 && c.wrapped == 4 && CL_REC_OVERFLOW_RELEASE == "4";
}
#test "coax lab: the layouts are what coax layout prints: Pulse 16 bytes with no padding, Loose 24 with 10, Tight 16 with 2" {
  p := cl_layout(0); #assert p.size == 16 && p.align == 4 && p.n == 4 && p.f[0].name == "position" && p.f[3].offset == 12 && p.f[2].type_name == "s32" && cl_layout_padding(p) == 0;
  l := cl_layout(1); #assert l.size == 24 && l.align == 8 && l.f[1].offset == 4 && l.f[2].offset == 8 && l.f[3].offset == 16 && cl_layout_padding(l) == 10;
  t := cl_layout(2); #assert t.size == 16 && t.f[0].offset == 0 && t.f[1].offset == 8 && t.f[2].offset == 12 && t.f[3].offset == 13 && cl_layout_padding(t) == 2;
  #assert cl_layout_owner(l, 0) == 0 && cl_layout_owner(l, 1) == -1 && cl_layout_owner(l, 7) == 1 && cl_layout_owner(l, 23) == 3;
}
#forall "coax lab: a view reads only inside itself, wherever it lies over the array" from: 0..<6, count: 0..<5, i: -2..<8 {
  cells := CL_CELLS; r := cl_view_read(cells[..], from, count, i);
  inside := from + count <= 8 && i >= 0 && i < count;
  #assert r.ok == inside;
  if inside { #assert r.value == cells[from + i]; } else { #assert r.value == 0; }
}
#test "coax lab: defers run in reverse; try passes the error up and the defer still runs once" {
  b: [4] u8; n := cl_defer_order(b[..]); #assert n == 3 && cast(string) b[0..<3] == "CBA";
  good := cl_parse("42"); #assert good.ok && good.value == 42 && !good.refused && good.cleanups == 1;
  bad := cl_parse("4x"); #assert !bad.ok && bad.refused && bad.cleanups == 1;
  first := cl_parse("x4"); #assert first.refused && first.cleanups == 1;
  short := cl_parse("7"); #assert short.refused && short.cleanups == 1;
}
#test "coax lab: Life: a blinker turns and comes back, a block stays, the seed lives on" {
  g: [1] ClLife; cl_life_put(g[..], 4, 4); cl_life_put(g[..], 4, 5); cl_life_put(g[..], 4, 6);
  a := cl_life_step(g[0]); #assert a.alive == 3 && a.cells[3 * CL_LW + 5] && a.cells[5 * CL_LW + 5] && !a.cells[4 * CL_LW + 4] && a.generation == 1;
  b := cl_life_step(a); #assert b.cells[4 * CL_LW + 4] && b.cells[4 * CL_LW + 6] && b.alive == 3;
  k: [1] ClLife; cl_life_put(k[..], 0, 0); cl_life_put(k[..], 0, 1); cl_life_put(k[..], 1, 0); cl_life_put(k[..], 1, 1);
  still := cl_life_step(k[0]); #assert still.alive == 4 && still.cells[0] && still.cells[CL_LW + 1];
  // the torus: a blinker across the edge
  e: [1] ClLife; cl_life_put(e[..], 0, CL_LW - 1); cl_life_put(e[..], 0, 0); cl_life_put(e[..], 0, 1);
  wrap := cl_life_step(e[0]); #assert wrap.alive == 3 && wrap.cells[(CL_LH - 1) * CL_LW] && wrap.cells[CL_LW];
  s := cl_life_seed(0); #assert s.alive > 200 && s.alive < 400 && cl_life_count(s) == s.alive && s.generation == 0;
  other := cl_life_seed(1); same := 0; for i: 0..<CL_LH * CL_LW { if other.cells[i] == s.cells[i] { same += 1; } } #assert same < CL_LH * CL_LW - 100;
  again := cl_life_seed(0); for i: 0..<CL_LH * CL_LW { #assert again.cells[i] == s.cells[i]; }
  for i: 0..<60 { s = cl_life_step(s); } #assert s.generation == 60 && s.alive > 5 && s.alive == cl_life_count(s);
}
#test "coax lab: the compiler's lexer gives a line's tokens, their spans and what each is" {
  t: [CL_TOKENS] ClTok; line := "x := add(1, 2.5); // a note";
  n := cl_lex(line, t[..]); #assert n == 9;
  #assert t[0].role == CL_ROLE_NAME && line[t[0].a..<t[0].b] == "x" && line[t[1].a..<t[1].b] == ":=" && t[1].role == CL_ROLE_MARK && cl_kind_name(t[1].kind) == "':='";
  #assert t[4].role == CL_ROLE_NUMBER && line[t[6].a..<t[6].b] == "2.5" && cl_kind_name(t[6].kind) == "float" && t[8].b == 17;
  d := "TABLE :: #run make_table();"; n = cl_lex(d, t[..]); #assert n == 7 && d[t[2].a..<t[2].b] == "#run" && t[2].role == CL_ROLE_DIRECTIVE && cl_kind_name(t[2].kind) == "directive";
  s := "if !ok { return \"no\"; }"; n = cl_lex(s, t[..]); #assert n == 8 && t[0].role == CL_ROLE_KEYWORD && s[t[5].a..<t[5].b] == "\"no\"" && t[5].role == CL_ROLE_STRING && s[t[6].a..<t[6].b] == ";";
  // every span is inside its line and after the one before, on every line a station shows
  r := "for i: 0..<n { sum += xs[i]; }"; n = cl_lex(r, t[..]); #assert n == 15 && r[t[4].a..<t[4].b] == "..<";
  for k: 1..<n { #assert t[k].a >= t[k - 1].b && t[k].b <= r.count; }
}
#test "coax lab: the CRC-32 table the compiler built gives the published sums" {
  #assert cl_crc_entry(0) == 0 && cl_crc_entry(1) == 0x77073096 && cl_crc_entry(255) == 0x2D02EF8D;
  #assert cl_crc32("123456789") == 0xCBF43926 && CL_CRC_CHECK == 3421780262 && cl_crc32("") == 0;
  #assert cl_crc32("The quick brown fox jumps over the lazy dog") == 0x414FA339 && cl_crc32("The quick brown fox jumps over the lazy dog") == 1095738169;
  fresh := cl_crc_table(); for i: 0..<256 { #assert fresh[i] == cl_crc_entry(i); }
}
#test "coax lab: the Mandelbrot table the compiler built is what escape gives now, point for point" #steps 400000000 {
  for row: 0..<CL_MH { for col: 0..<CL_MW { #assert cl_mandel_at(row, col) == cl_escape(cl_mandel_cr(col), cl_mandel_ci(row)); } }
  #assert CL_MW * CL_MH == 3128 && cl_mandel_at(17, 61) == CL_MLIMIT && cl_mandel_at(17, 30) == CL_MLIMIT && cl_mandel_at(0, 0) < 5 && cl_mandel_inside() > 300 && cl_mandel_inside() < 1000;
}
#forall "coax lab: refunds, every case the book's check tries" paid: -2..<40, refund: -2..<45 {
  #assert cl_refund_ok(paid, refund) == (paid >= 0 && refund >= 0 && refund <= paid);
}
#test "coax lab: refunds at the top of the range" {
  #assert cl_refund_ok(CL_MAX_MSAT, CL_MAX_MSAT) && !cl_refund_ok(CL_MAX_MSAT + 1, 0) && cl_money_range(0) && !cl_money_range(-1);
}
#test "coax lab: the cases are the #forall's 1,974 in its order; all hold, and the planted bug fails exactly the 40 full refunds" {
  #assert CL_CASES == 1974 && cl_case(false, 0).paid == -2 && cl_case(false, 0).refund == -2 && cl_case(false, CL_CASES - 1).paid == 39 && cl_case(false, CL_CASES - 1).refund == 44;
  #assert cl_cases_failing(false) == 0 && cl_case_first_failing(false) == -1;
  #assert cl_cases_failing(true) == 40;
  first := cl_case(true, cl_case_first_failing(true)); #assert first.paid == 0 && first.refund == 0 && !first.allowed && !first.holds;
  for k: 0..<CL_CASES { c := cl_case(true, k); #assert c.holds == !(c.paid >= 0 && c.refund == c.paid); }
}
#test "coax lab: the recorded lines are whole, and the folder counts add up to less than the total" {
  #assert CL_REC_MUTATE == "43 mutants, 43 killed, 0 survived" && CL_REC_VERSION == "coax0 0.52.0";
  sum := 0; for i: 0..<CL_BUILT { sum += CL_BUILT_FILES[i]; if i > 0 { #assert CL_BUILT_FILES[i] <= CL_BUILT_FILES[i - 1]; } }
  #assert sum == 6647 && sum < CL_BUILT_TOTAL;
}
#test "coax lab: every station's live values hold" #steps 400000000 {
  for i: 0..<CL_STATIONS { #assert cl_verify(i); }
}
