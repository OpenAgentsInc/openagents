// Coax Lab's lesson (coax-lab-walk.coax draws it): what the walk's stations show of the Coax language,
// for Episode 296 and the book (coax/book/). Two kinds of value, kept apart:
//
//   LIVE      worked out in the page, as you stand there, by the procedures below, which are compiled
//             into the page like any other Coax: a u8 counted to its limit, a struct's layout from
//             size_of and field_info, a view's bounds, defers in reverse, a Result passed up with
//             try, a CRC-32 table and a Mandelbrot set the compiler built with #run, Conway's Life,
//             every case of a #forall, a planted bug, and the compiler's own lexer
//             (coax/lib/compiler/lexer.coax) reading source.
//   RECORDED  what `coax` 0.52.0 printed on 2026-11-13 for the small files in the Episode 296 show
//             notes (docs/transcripts/296-show-notes.md), kept here as text (CL_REC_*). The compiler
//             does not run in the page: its evaluator and C emitter are C++.
//
// The rules a station shows (the refund rule, the CRC-32, the Mandelbrot set, Life) follow the book's
// examples in coax/examples/ (money.coax, crc32.coax, mandelbrot.coax, life.coax). Those are whole
// programs, each with its own `main`, so a page cannot load them; these are the lab's own, held to
// the same published answers by the checks below.
//   coax/bin/coax test apps/openagents-web/old/labs/coax-lab-lesson.coax
#module "openagents.coaxlab.lesson";
#run_steps 60000000;   // the Mandelbrot set, drawn while compiling (CL_MANDEL)
#load "../../../../coax/lib/compiler/lexer.coax";

// ---- 1 a name and a value: the only ways to declare
CL_LIMIT :: 64;
cl_add :: (a: int, b: int) -> int { return a + b; }
ClNames :: struct { limit: int; x: int; y: int; sum: int; half_tenths: int; }
// The declarations the station shows, run: a constant, an inferred variable, a typed one, a written
// conversion and a procedure call.
cl_names :: () -> ClNames {
  x := 1;
  y: int = 2;
  half := cast(f32) y / 2;
  return ClNames.{limit = CL_LIMIT, x = x, y = y, sum = cl_add(x, y), half_tenths = cast(int) (half * 10)};
}

// ---- 3 numbers that stop: one add at a time on a u8, two ways
ClCount :: struct {
  checked: u8;       // the checked counter: it stops at the add that does not fit
  stopped: bool;
  wrapped: u8;       // the wrapping counter: 255 + 1 is 0, and it carries on
  adds: int;
}
CL_COUNT_FROM :: 250; CL_COUNT_ADDS :: 10;
cl_count_start :: () -> ClCount { return ClCount.{checked = CL_COUNT_FROM, wrapped = CL_COUNT_FROM}; }
cl_count_step :: (c: ClCount) -> ClCount {
  out := c; out.adds = c.adds + 1;
  out.wrapped = add_wrap(c.wrapped, 1);
  if c.stopped { return out; }
  switch add_checked(c.checked, 1) {
    case some(v) { out.checked = v; }
    case none { out.stopped = true; }
  }
  return out;
}
cl_count_after :: (adds: int) -> ClCount { c := cl_count_start(); for i: 0..<adds { c = cl_count_step(c); } return c; }

// ---- 4 a struct, byte by byte: what size_of and field_info say (the LP64 layout `coax layout` prints)
ClPulse :: struct { position: f32; speed: f32; channel: s32; hops: s32; }   // coax/examples/pulse/pulse.coax's Pulse
ClLoose :: struct { a: u8; b: s32; c: u8; d: s64; }                         // four fields, small and large mixed
ClTight :: struct { d: s64; b: s32; a: u8; c: u8; }                         // the same four, largest first
CL_LAYOUTS :: 3; CL_FIELDS :: 4;
ClField :: struct { name: string; type_name: string; offset: int; size: int; }
ClLayout :: struct { name: string; size: int; align: int; n: int; f: [CL_FIELDS] ClField; }
cl_layout :: (which: int) -> ClLayout {
  l: ClLayout;
  if which == 0 {
    l.name = "Pulse"; l.size = size_of(ClPulse); l.align = type_info(ClPulse).alignment; l.n = type_info(ClPulse).field_count;
    for i: 0..<CL_FIELDS { fi := field_info(ClPulse, i); l.f[i] = ClField.{name = fi.name, type_name = fi.type_name, offset = fi.offset, size = fi.size}; }
  } else if which == 1 {
    l.name = "Loose"; l.size = size_of(ClLoose); l.align = type_info(ClLoose).alignment; l.n = type_info(ClLoose).field_count;
    for i: 0..<CL_FIELDS { fi := field_info(ClLoose, i); l.f[i] = ClField.{name = fi.name, type_name = fi.type_name, offset = fi.offset, size = fi.size}; }
  } else {
    l.name = "Tight"; l.size = size_of(ClTight); l.align = type_info(ClTight).alignment; l.n = type_info(ClTight).field_count;
    for i: 0..<CL_FIELDS { fi := field_info(ClTight, i); l.f[i] = ClField.{name = fi.name, type_name = fi.type_name, offset = fi.offset, size = fi.size}; }
  }
  return l;
}
// The field byte `at` of a layout belongs to, or -1 for padding.
cl_layout_owner :: (l: ClLayout, at: int) -> int {
  for i: 0..<l.n { if at >= l.f[i].offset && at < l.f[i].offset + l.f[i].size { return i; } }
  return -1;
}
cl_layout_padding :: (l: ClLayout) -> int { n := 0; for at: 0..<l.size { if cl_layout_owner(l, at) < 0 { n += 1; } } return n; }

// ---- 5 an array and a view
CL_CELLS :: [8] int.[3, 1, 4, 1, 5, 9, 2, 6];
ClRead :: struct { ok: bool; value: int; }
// view := cells[from..<from + count]; view[i], decided the way every index is: inside the view or refused.
// The array may well hold a value there; the view does not reach it.
cl_view_read :: (cells: [] const int, from: int, count: int, i: int) -> ClRead {
  if from < 0 || count < 0 || from + count > cells.count { return ClRead.{}; }
  view := cells[from..<from + count];
  if i < 0 || i >= view.count { return ClRead.{}; }
  return ClRead.{ok = true, value = view[i]};
}

// ---- 6 cleanup you can see: defers run in reverse, and a Result is passed up with try
// Three defers in one block, each writing its letter when it runs: the letters in the order they ran.
cl_defer_order :: (out: [] u8) -> int {
  n: [1] int;
  {
    defer { out[n[0]] = 'A'; n[0] += 1; }
    defer { out[n[0]] = 'B'; n[0] += 1; }
    defer { out[n[0]] = 'C'; n[0] += 1; }
  }
  return n[0];
}
ClDigitError :: enum u8 { not_a_digit; }
cl_digit :: (c: u8) -> Result(int, ClDigitError) {
  if c < '0' || c > '9' { return Result(int, ClDigitError).{err = ClDigitError.not_a_digit}; }
  return Result(int, ClDigitError).{ok = cast(int) (c - '0')};
}
// Two digits to a number. `try` unwraps a digit or returns its error from here; the defer runs either way.
cl_two_digits :: (t: string, cleanup: [] int) -> Result(int, ClDigitError) {
  defer cleanup[0] += 1;
  if t.count != 2 { return Result(int, ClDigitError).{err = ClDigitError.not_a_digit}; }
  a := try cl_digit(t[0]);
  b := try cl_digit(t[1]);
  return Result(int, ClDigitError).{ok = a * 10 + b};
}
ClParsed :: struct { ok: bool; value: int; refused: bool; cleanups: int; }
cl_parse :: (t: string) -> ClParsed {
  ran: [1] int; r: ClParsed;
  switch cl_two_digits(t, ran[..]) {
    case ok(v) { r.ok = true; r.value = v; }
    case err(e) { r.refused = e == ClDigitError.not_a_digit; }
  }
  r.cleanups = ran[0];
  return r;
}

// ---- 7 Life: a struct holding an array, copied by value each generation (coax/examples/life.coax's rules, on a torus)
CL_LW :: 44; CL_LH :: 18;
ClLife :: struct { cells: [CL_LH * CL_LW] bool; generation: int; alive: int; }
cl_life_put :: (g: [] ClLife, row: int, col: int) { g[0].cells[((row + CL_LH) % CL_LH) * CL_LW + (col + CL_LW) % CL_LW] = true; }
cl_life_count :: (g: ClLife) -> int { n := 0; for i: 0..<CL_LH * CL_LW { if g.cells[i] { n += 1; } } return n; }
// The start: a soup, about three cells in eight alive, the same for the same salt. Its numbers come
// from a counter that is meant to wrap, so it says so (mul_wrap, add_wrap).
cl_life_seed :: (salt: int) -> ClLife {
  g: [1] ClLife; x: u32 = add_wrap(cast,trunc(u32) salt, 2463534242);
  for i: 0..<CL_LH * CL_LW {
    x = add_wrap(mul_wrap(x, 1664525), 1013904223);
    if (x >> 16) % 8 < 3 { g[0].cells[i] = true; }
  }
  g[0].alive = cl_life_count(g[0]);
  return g[0];
}
cl_life_neighbours :: (g: ClLife, row: int, col: int) -> int {
  count := 0;
  for dr: -1..<2 { for dc: -1..<2 {
    if dr == 0 && dc == 0 { continue; }
    if g.cells[((row + dr + CL_LH) % CL_LH) * CL_LW + (col + dc + CL_LW) % CL_LW] { count += 1; }
  } }
  return count;
}
cl_life_step :: (g: ClLife) -> ClLife {
  next: ClLife; next.generation = g.generation + 1;
  for row: 0..<CL_LH { for col: 0..<CL_LW {
    n := cl_life_neighbours(g, row, col);
    live := n == 3 || (n == 2 && g.cells[row * CL_LW + col]);
    next.cells[row * CL_LW + col] = live; if live { next.alive += 1; }
  } }
  return next;
}

// ---- 8 the compiler's own lexer, reading a line of source
CL_TOKENS :: 40;
CL_ROLE_NAME :: 0; CL_ROLE_KEYWORD :: 1; CL_ROLE_NUMBER :: 2; CL_ROLE_STRING :: 3; CL_ROLE_DIRECTIVE :: 4; CL_ROLE_MARK :: 5;
ClTok :: struct { kind: int; role: int; a: int; b: int; }   // its kind (LX_Kind), what it is drawn as, and its bytes [a, b) of the line
cl_role :: (kind: LX_Kind) -> int {
  if kind == LX_Kind.k_ident { return CL_ROLE_NAME; }
  if kind == LX_Kind.k_keyword { return CL_ROLE_KEYWORD; }
  if kind == LX_Kind.k_int_lit || kind == LX_Kind.k_float_lit { return CL_ROLE_NUMBER; }
  if kind == LX_Kind.k_string_lit { return CL_ROLE_STRING; }
  if kind == LX_Kind.k_directive || kind == LX_Kind.k_annotation || kind == LX_Kind.k_dollar { return CL_ROLE_DIRECTIVE; }
  return CL_ROLE_MARK;
}
// The tokens of one line, by the compiler's lexer (LX_next); how many. A directive's span takes in its '#'.
cl_lex :: (line: string, out: [] ClTok) -> int {
  state := [1] LX_State.[LX_begin(line.count)]; decoded: [160] u8; message: [96] u8; n := 0;
  for k: 0..<CL_TOKENS * 2 {
    if n >= out.count { break; }
    r := LX_next(line, state[..], decoded[..], message[..]);
    if !r.has_token { continue; }
    if r.token.kind == LX_Kind.k_eof { break; }
    role := cl_role(r.token.kind); a := r.token.text_begin; b := r.token.text_end;
    if role == CL_ROLE_DIRECTIVE && a > 0 { a -= 1; }
    if role == CL_ROLE_STRING {   // from its opening quote to where the lexer stands after it
      a = r.token.loc.offset; b = state[0].pos;
    }
    if a < 0 || b > line.count || b <= a { continue; }
    out[n] = ClTok.{kind = cast(int) r.token.kind, role = role, a = a, b = b}; n += 1;
  }
  return n;
}
cl_kind_name :: (kind: int) -> string { return LX_name(cast(u32) kind); }

// ---- 9 work done while compiling: the CRC-32 table (the zlib and PNG polynomial), built by #run
CL_POLY :: cast(u32) 0xEDB88320;
cl_crc_table :: () -> [256] u32 {
  table: [256] u32;
  for n: 0..<256 {
    c := cast(u32) n;
    for k: 0..<8 { c = ifx c & 1 == 1 then CL_POLY ^ (c >> 1) else c >> 1; }
    table[n] = c;
  }
  return table;
}
CL_CRC :: #run cl_crc_table();            // in the page as 256 constants: the page never builds it
cl_crc32 :: (data: string) -> u32 {
  crc: u32 = 0xFFFF_FFFF;
  for byte: data { crc = CL_CRC[(crc ^ cast(u32) byte) & 0xFF] ^ (crc >> 8); }
  return crc ^ 0xFFFF_FFFF;
}
CL_CRC_CHECK :: #run cl_crc32("123456789");
#assert CL_CRC[1] == 0x77073096;
#assert CL_CRC[255] == 0x2D02EF8D;
#assert CL_CRC_CHECK == 0xCBF43926;
cl_crc_entry :: (i: int) -> u32 { t := CL_CRC; return t[i & 255]; }
CL_CRC_TEXT :: "Hello, Coax!";

// ---- 10 the compiler drew this: the Mandelbrot set (coax/examples/mandelbrot.coax's escape), every point by #run
CL_MW :: 92; CL_MH :: 34; CL_MLIMIT :: 200;
cl_escape :: (cr: f64, ci: f64) -> int {
  zr := 0.0; zi := 0.0;
  for n: 0..<CL_MLIMIT {
    if zr * zr + zi * zi > 4 { return n; }
    t := zr * zr - zi * zi + cr;
    zi = 2 * zr * zi + ci;
    zr = t;
  }
  return CL_MLIMIT;
}
cl_mandel_cr :: (col: int) -> f64 { return -2.2 + 3.0 * cast(f64) col / CL_MW; }
cl_mandel_ci :: (row: int) -> f64 { return -1.2 + 2.4 * cast(f64) row / CL_MH; }
cl_mandel :: () -> [CL_MH * CL_MW] u8 {
  out: [CL_MH * CL_MW] u8;
  for row: 0..<CL_MH { for col: 0..<CL_MW { out[row * CL_MW + col] = cast(u8) cl_escape(cl_mandel_cr(col), cl_mandel_ci(row)); } }
  return out;
}
CL_MANDEL :: #run cl_mandel();            // 3,128 escape counts, in the page as constants
cl_mandel_at :: (row: int, col: int) -> int { m := CL_MANDEL; return cast(int) m[row * CL_MW + col]; }
cl_mandel_inside :: () -> int { n := 0; for i: 0..<CL_MH * CL_MW { if cl_mandel_at(i / CL_MW, i % CL_MW) == CL_MLIMIT { n += 1; } } return n; }

// ---- 12 and 13 a check over every case, and a planted bug (coax/examples/money.coax's refund rule)
CL_MAX_MSAT :: 2_100_000_000_000_000_000;
cl_money_range :: (v: int) -> bool { return v >= 0 && v <= CL_MAX_MSAT; }
// A refund is never negative and never more than was paid.
cl_refund_ok :: (paid: int, refund: int) -> bool { return cl_money_range(paid) && cl_money_range(refund) && refund <= paid; }
// The planted bug: one operator changed, <= to <, the kind of change `coax mutate` makes.
cl_refund_mutant :: (paid: int, refund: int) -> bool { return cl_money_range(paid) && cl_money_range(refund) && refund < paid; }
CL_PAID_FROM :: -2; CL_PAID_TO :: 40; CL_REFUND_FROM :: -2; CL_REFUND_TO :: 45;
CL_PAIDS :: CL_PAID_TO - CL_PAID_FROM; CL_REFUNDS :: CL_REFUND_TO - CL_REFUND_FROM;
CL_CASES :: CL_PAIDS * CL_REFUNDS;   // 1,974: every pair the #forall tries
ClCase :: struct { paid: int; refund: int; allowed: bool; holds: bool; }
// Case k of the #forall, in its order (paid outermost): what the rule under test answers, and
// whether the check's assertion holds for it.
cl_case :: (mutant: bool, k: int) -> ClCase {
  paid := CL_PAID_FROM + k / CL_REFUNDS; refund := CL_REFUND_FROM + k % CL_REFUNDS;
  got := ifx mutant then cl_refund_mutant(paid, refund) else cl_refund_ok(paid, refund);
  return ClCase.{paid = paid, refund = refund, allowed = got, holds = got == (paid >= 0 && refund >= 0 && refund <= paid)};
}
cl_cases_failing :: (mutant: bool) -> int { n := 0; for k: 0..<CL_CASES { if !cl_case(mutant, k).holds { n += 1; } } return n; }
// The first case that fails, -1 when every one holds.
cl_case_first_failing :: (mutant: bool) -> int { for k: 0..<CL_CASES { if !cl_case(mutant, k).holds { return k; } } return -1; }

// ---- recorded: what coax0 0.52.0 printed (2026-11-13). The files are in docs/transcripts/296-show-notes.md.
CL_REC_VERSION :: "coax0 0.52.0";
CL_REC_OVERFLOW :: "over.coax:4: integer overflow in '+'";                     // coax run over.coax
CL_REC_OVERFLOW_RELEASE :: "4";                                               // coax run over.coax --release
CL_REC_BOUNDS :: "past.coax:6: index out of bounds";                           // coax run past.coax
CL_REC_SHADOW_1 :: "shadow.coax:5:5: error[E0303]: 'count' is already declared";   // coax check shadow.coax (one line, wrapped here)
CL_REC_SHADOW_2 :: "at line 3; Coax does not allow shadowing";
CL_REC_SHADOW_FIX :: "  fix: pick another name";
CL_REC_SHADOW_JSON :: [6] string.[                                            // coax check shadow.coax --json (one line, wrapped here)
  "{\"file\": \"shadow.coax\", \"line\": 5, \"col\": 5,",
  " \"code\": \"E0303\",",
  " \"message\": \"'count' is already declared at line 3;",
