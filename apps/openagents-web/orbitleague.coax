#test "Orbit v2 page (#12845): complete snapshots own every pose; partial, stale and foreign generations change nothing" {
  s:[1]OrbitLeague;game_reset(s[..]);s[0].online=true;s[0].room_authority=true;s[0].room_seq=17;
  s[0].room_tick=-1;s[0].sock=2;s[0].sock_open=true;
  room_take(s[..],ORB_SNAPSHOT_FIXTURE);
  #assert s[0].heard==1 && s[0].room_tick==9 && s[0].room_generation.value==7 && s[0].room_ack==17;
  #assert abs(s[0].bodies[YOU].pos.x+1.234)<0.0001 && abs(s[0].bodies[YOU].pos.z-36)<0.0001;
  #assert s[0].tanks[0].fuel==42.5 && s[0].paints[1]==5;
  before:=s[0].bodies[YOU];s[0].held=HOLD_UP;game_step(s[..],0.2);
  #assert s[0].bodies[YOU].pos.x==before.pos.x && s[0].bodies[YOU].pos.z==before.pos.z;
  room_take(s[..],"S 10 1 7 17 12345 1 1500 299000 3 4 2 2;s 0 0 32834 1000 1000000 1");
  room_take(s[..],ORB_SNAPSHOT_FIXTURE);#assert s[0].heard==1 && s[0].bodies[YOU].pos.x==before.pos.x;
  room_take(s[..],"S 10 1 8 17 12345 1 1500 299000 3 4 2 1;s 0 0 32834 1000 1000000 1;s 2 0 32768 8");
  room_take(s[..],"S 8 1 7 17 12345 1 1500 299000 3 4 2 1;s 0 0 32834 1000 1000000 1;s 2 0 32768 7");
  future:="S 10 1 7 18 12345 1 1500 299000 3 4 2 1;s 0 0 32834 1000 1000000 1;s 2 0 32768 7";
  room_take(s[..],future);#assert s[0].heard==1 && s[0].room_present[0] && s[0].room_generation.value==7;
  s[0].room_seq=18;room_take(s[..],future);
  #assert s[0].heard==2 && s[0].room_tick==10 && !s[0].room_present[0] && s[0].bodies[BOT].pos.y< -100;
}
// ---- ol-predict's checks: a page against a room over a late link
// The room's side of one seat, as metaverse/orbit-league/server/room.coax runs it (its own checks are the room
// suite's): controls wait their turn, one is stepped a tick with the game's step, and the seat
// hears a whole snapshot naming the last control stepped.
PT_Q :: 256;
PtLink :: struct {
  room: [1] OrbitLeague; tick: int; ack: int; input: OrbInput;
  wait: [8] OrbInput; waiting: int;
  up: [PT_Q] OrbInput; up_due: [PT_Q] int; up_n: int; up_head: int;
  down: [PT_Q][768] u8; down_len: [PT_Q] int; down_due: [PT_Q] int; down_n: int; down_head: int;
}
pt_start :: (l: [] PtLink, c: [] OrbitLeague) {
  room_reset(l[0].room[..]); l[0].room[0].cars_n = CARS; l[0].room[0].phase = PHASE_PLAY; l[0].room[0].phase_t = 0.0;
  game_reset(c); c[0].online = true; c[0].room_authority = true; c[0].no_bot = true; c[0].sock = 2; c[0].sock_open = true; c[0].room_tick = -1;
  room_predict_reset(c);
}
pt_snapshot :: (l: [] PtLink, out: [] u8) -> int {
  s := l[0].room[..];
  header := [12] int.[l[0].tick, 0, 1, l[0].ack, -1, s[0].phase, cast(int) (s[0].phase_t * 1000), cast(int) (s[0].clock * 1000), s[0].score[0], s[0].score[1], s[0].kicks, 1];
  n := net_record_write('S', header[..], out); if n == 0 { return 0; }
  for row: 0..<2 {
    b := s[0].bodies[row];
    raw := [16] f64.[b.pos.x, b.pos.y, b.pos.z, b.orientation.x, b.orientation.y, b.orientation.z, b.orientation.w,
      b.vel.x, b.vel.y, b.vel.z, b.omega.x, b.omega.y, b.omega.z, 0.0, ifx row == 1 then s[0].tanks[0].fuel else 0.0, 1.0];
    f := orb_fields(raw[..]); if !f.ok { return 0; }
    out[n] = ';'; n += 1;
    w := orb_row_write(row, f.v[..], 0, out[n..<out.count]); if w == 0 { return 0; }
    n += w;
  }
  return n;
}
// One 60 Hz frame of both: the page's frame, its controls on their way up for `up` frames, the
// room's tick, its snapshot on its way down for `down` frames.
pt_frame :: (l: [] PtLink, c: [] OrbitLeague, frame: int, up: int, down: int) {
  pipe_drained(c[0].pipe[..]);
  room_frame(c, 1.0 / 60.0);
  for k: 0..<c[0].pipe[0].n {
    i := orb_input(pipe_bytes(c[0].pipe[..], k));
    if !i.ok || l[0].up_n >= PT_Q { continue; }
    slot := (l[0].up_head + l[0].up_n) % PT_Q; l[0].up[slot] = i; l[0].up_due[slot] = frame + up; l[0].up_n += 1;
  }
  while l[0].up_n > 0 && l[0].up_due[l[0].up_head] <= frame {
    if l[0].waiting < 8 { l[0].wait[l[0].waiting] = l[0].up[l[0].up_head]; l[0].waiting += 1; }
    l[0].up_head = (l[0].up_head + 1) % PT_Q; l[0].up_n -= 1;
  }
  // more than two waiting at a tick lose the oldest (the room's ORB_QUEUE_KEEP), then one has its tick
  while l[0].waiting > 2 { l[0].waiting -= 1; for q: 0..<l[0].waiting { l[0].wait[q] = l[0].wait[q + 1]; } }
  if l[0].waiting > 0 {
    l[0].input = l[0].wait[0]; l[0].waiting -= 1;
    for q: 0..<l[0].waiting { l[0].wait[q] = l[0].wait[q + 1]; }
  }
  drives: [CARS] Drive; active: [CARS] bool; active[0] = true;
  if l[0].input.ok { drives[0] = orb_drive(l[0].input.throttle, l[0].input.steer, l[0].input.flags); l[0].ack = l[0].input.seq; }
  for k: 0..<orb_realm().beat.substeps {
    if room_step_begin(l[0].room[..], 1) { physics_step_masked(l[0].room[..], drives, active); room_step_end(l[0].room[..]); }
  }
  l[0].tick += 1;
  if l[0].down_n < PT_Q {
    slot := (l[0].down_head + l[0].down_n) % PT_Q;
    l[0].down_len[slot] = pt_snapshot(l, l[0].down[slot][..]); l[0].down_due[slot] = frame + down; l[0].down_n += 1;
  }
  while l[0].down_n > 0 && l[0].down_due[l[0].down_head] <= frame {
    h := l[0].down_head;
    room_heard(c, cast(string) l[0].down[h][0..<l[0].down_len[h]]);
    l[0].down_head = (h + 1) % PT_Q; l[0].down_n -= 1;
  }
}
#test "ol-predict (#13277): over 100 ms each way your car moves the frame you press, the room's snapshots agree with your steps, and nothing is re-run" #steps 2000000000 {
  l: [1] PtLink; c: [1] OrbitLeague; pt_start(l[..], c[..]);
  // the ball is out of the way: this is your car against the arena alone
  l[0].room[0].bodies[BALL].pos = d3(22.0, BALL_R, 36.0);
  for f: 0..<30 { pt_frame(l[..], c[..], f, 6, 6); }
  #assert c[0].room_tick > 0 && c[0].phase == PHASE_PLAY && d3_dist(c[0].you.pos, l[0].room[0].bodies[YOU].pos) < 0.002;
  at := c[0].you.pos; word := c[0].word[YOU].pos;
  c[0].held = HOLD_UP | HOLD_BOOST;
  pt_frame(l[..], c[..], 30, 6, 6);
  // the frame you press: your steps moved you, the room has not heard yet
  #assert c[0].you.vel.z > 0.05 && d3_dist(c[0].word[YOU].pos, word) < 0.002 && game_probe(c[..], 10) >= 10;
  #assert d3_dist(c[0].bodies[YOU].pos, c[0].you.pos) < 0.02;
  far := 0.0;
  for f: 31..<150 {
    if f == 60 { c[0].held = HOLD_UP | HOLD_LEFT; }
    if f == 90 { c[0].held = HOLD_UP | HOLD_JUMP; }
    if f == 100 { c[0].held = HOLD_RIGHT | HOLD_DOWN; }
    pt_frame(l[..], c[..], f, 6, 6);
    far = fmax(far, d3_dist(c[0].you.pos, c[0].word[YOU].pos));
  }
  // you are ahead of the room's word by the trip, and every snapshot found you where your steps had you
  #assert d3_dist(c[0].you.pos, at) > 10.0 && far > 1.0;
  #assert c[0].reruns == 0 && c[0].fix_mm == 0 && c[0].pred[0].replays > 100;
  // you let go: once the room has stepped every control, its word is where you are
  c[0].held = 0;
  for f: 150..<330 { pt_frame(l[..], c[..], f, 6, 6); }
  // (it may still roll: you lead the room by the trip's ticks of that)
  lead := 0.02 + 0.25 * d3_len(c[0].you.vel);
  #assert d3_dist(c[0].you.pos, c[0].word[YOU].pos) < lead && d3_dist(c[0].you.pos, l[0].room[0].bodies[YOU].pos) < lead;
  #assert c[0].reruns == 0 && abs(c[0].tanks[0].fuel - l[0].room[0].tanks[0].fuel) < 1.0;
}
#test "ol-predict (#13277): a control that comes a tick late is re-run from the room's word, and what it moved you by is eased, never drawn as a jump" #steps 2000000000 {
  l: [1] PtLink; c: [1] OrbitLeague; pt_start(l[..], c[..]);
  l[0].room[0].bodies[BALL].pos = d3(22.0, BALL_R, 36.0);
  for f: 0..<30 { pt_frame(l[..], c[..], f, 3, 3); }
  c[0].held = HOLD_UP | HOLD_BOOST;
  last := c[0].bodies[YOU].pos; jump := 0.0;
  for f: 30..<210 {
    // every twentieth frame the link holds your controls two frames longer: the room steps its last one again
    pt_frame(l[..], c[..], f, ifx f % 20 == 0 then 5 else 3, 3);
    step := d3_dist(c[0].bodies[YOU].pos, last); last = c[0].bodies[YOU].pos;
    jump = fmax(jump, step - d3_len(c[0].you.vel) / 60.0);
  }
  #assert c[0].reruns > 0 && c[0].fix_mm > 0 && c[0].fix_mm < 1200;
  #assert jump < 0.35;
  c[0].held = 0;
  for f: 210..<420 { pt_frame(l[..], c[..], f, 3, 3); }
  #assert d3_dist(c[0].you.pos, l[0].room[0].bodies[YOU].pos) < 0.02 + 0.25 * d3_len(c[0].you.vel) && d3_dist(c[0].bodies[YOU].pos, c[0].you.pos) < 0.02;
}
#test "ol-predict (#13277): the ball is drawn a jitter buffer behind its snapshots, between them, evenly when they come in pairs" #steps 2000000000 {
  l: [1] PtLink; c: [1] OrbitLeague; pt_start(l[..], c[..]);
  // zero-g, so the ball flies level and straight; x stays clear of the walls for the run
  l[0].room[0].spin_every = 0.0; l[0].room[0].spin_g = 0.0;
  l[0].room[0].bodies[BALL].pos = d3(-15.0, 8.0, 0.0);
  for f: 0..<40 { pt_frame(l[..], c[..], f, 3, 3); }
  l[0].room[0].bodies[BALL].vel = d3(6.0, 0.0, 0.0);
  last := c[0].bodies[BALL].pos.x; most := 0.0; least := 1.0; behind := 0.0;
  for f: 40..<200 {
    // every other snapshot is a frame late: none one frame, two the next
    pt_frame(l[..], c[..], f, 3, ifx f % 2 == 0 then 4 else 3);
    if f >= 120 {
      step := c[0].bodies[BALL].pos.x - last;
      most = fmax(most, step); least = fmin(least, step);
      behind = fmax(behind, c[0].word[BALL].pos.x - c[0].bodies[BALL].pos.x);
    }
    last = c[0].bodies[BALL].pos.x;
  }
  speed := l[0].room[0].bodies[BALL].vel.x;
  #assert speed > 3.0 && game_probe(c[..], 13) >= NET_LOW;
  // each frame draws about a frame's travel: never still, never two frames' worth
  #assert least > speed / 60.0 * 0.5 && most < speed / 60.0 * 1.5;
  // and it is behind the newest snapshot by the buffer's delay, not by nothing and not by a second
  #assert behind > speed * 0.06 && behind < speed * 0.4;
}
#test "Orbit v2 presentation follows the server spin clock and describes a lost connection truthfully" {
  s:[1]OrbitLeague;game_reset(s[..]);s[0].online=true;s[0].room_authority=true;s[0].room_seq=17;
  s[0].room_tick=-1;s[0].sock=2;s[0].sock_open=true;s[0].spin_every=0;s[0].spin_g=HALF_SPIN;
  room_take(s[..],"S 9 1 7 17 12345 1 1500 202500 3 4 2 1;s 0 0 32834 1000 1000000 1;s 2 0 32768 7");
  #assert abs(s[0].played-97.5)<0.001 && s[0].spin_every==SPIN_EVERY && s[0].spin_g==1;
  #assert s[0].spin_now==0;
  s[0].held=HOLD_UP;room_authority_end(s[..]);
  #assert room_connection_text(s[..])=="ROOM CONNECTION LOST. RELOAD TO REJOIN";
  #assert s[0].held==0 && !game_key(s[..],'w',0);
  s[0].room_authority=false;#assert room_connection_text(s[..])=="LOST THE ROOM: PLAYING ON YOUR OWN";
}

