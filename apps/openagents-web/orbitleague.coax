// Orbit League (docs/verse/game-ideas/orbit-league.md): electric roadsters
// playing ball in a glass arena in orbit. This file is the page: the controls,
// the camera, the HUD, the clips and the frame. The game's rules, its match
// state and the room's wire are orbitleague-game.coax, which the room server
// loads without the page (#13347); the physics is the engine's space primitives
// (docs/verse/space.md): metaverse-engine/physics/vehicle.coax drives the cars, metaverse-engine/physics/contact.coax
// answers every touch, metaverse-engine/physics/gravity.coax says which way is down, and
// metaverse-engine/physics/thrust.coax burns the boost.
//
// The first playable: you (blue) against one bot (magenta), a five-minute
// match, a goal at each end of a flat box arena. Every 90 seconds of play the
// station spins down: gravity fades to nothing for half a minute, then
// comes back. W/S (or the arrows) drive, A/D steer, Space jumps (twice),
// Shift boosts, C is ball cam, Escape goes to /worlds. On a phone
// the left thumb steers and drives; JUMP and BOOST are on the right.
// ?stage=highlight plays a staged goal for clips (docs/verse/clips.md).
// ?arena=drum (or PLAY IN THE DRUM when a match ends) plays inside a spinning drum
// (metaverse/drum.coax): the floor curves up into the walls and over into the
// ceiling, the spin holds you to all of it, and the goals sit at the foot of
// each end wall.
//
// orbitleague.wgsl traces the arena, the cars, the ball and the space round
// them from the uniforms written here; the HUD is strokes over it.
//   coax/bin/coax test apps/openagents-web/orbitleague.coax   (long simulations declare measured #steps)

#load "../../metaverse-engine/ui/font.coax";
#load "ui.coax";
#load "orbitleague-game.coax";   // the game without its page: the match, the arenas, the bot, the physics, the room's wire
#load "../../metaverse-engine/core/budget.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, 0, 0, 0, 0
MAX_VERTICES :: 24000;
MODE_STROKE :: 0.0;
MODE_BAR :: 4.0;   // ui.coax's

// The uniforms (orbitleague.wgsl's U): width, height, time, fade, still,
// plates, dpr, zero-g share; the view's rows; the eye and the screen's rays;
// the ball; each car's place and axes; the arena; the plates.
VIEW_AT :: 8; EYE_AT :: 24; FWD_AT :: 28; RX_AT :: 32; UY_AT :: 36;
BALL_AT :: 40; BALLQ_AT :: 44; CAR_AT :: 48; CAR_FLOATS :: 16; ARENA_AT :: 80; GOAL_AT :: 84; MISC_AT :: 88;
PANEL_AT :: 92;
// then the trails (the ball's, then each car's boost): a bound (centre,
// radius; radius < 0 none) and TRAIL_N points (place, strength) each; then
// the goal's blast (centre, age; team)
TRAIL_AT :: PANEL_AT + PLATES * 8;
BLAST_AT :: TRAIL_AT + 3 * (TRAIL_N + 1) * 4;
PADS_AT :: BLAST_AT + 8;     // each boost pad: x, z, big (1) or small (0), how ready (1 ready)
CARS2_AT :: PADS_AT + PADS * 4;   // a 2v2's other two cars, as CAR_AT's
UNIFORM_FLOATS :: CARS2_AT + 2 * CAR_FLOATS;

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow (droprealm.coax's).
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

game_step :: (s: [] OrbitLeague, dt: f64) {
  if s[0].golden { return; }
  if s[0].online && s[0].room_authority {return;}
  s[0].sim = loop_accept(s[0].sim, dt);
  due := loop_due(s[0].sim);
  s[0].sim = loop_ran(s[0].sim);
  for k: 0..<due {
    if s[0].clip_play { clip_step(s); continue; }
    s[0].phase_t += STEP;
    if s[0].phase == PHASE_KICKOFF && s[0].phase_t >= KICKOFF { s[0].phase = PHASE_PLAY; s[0].phase_t = 0.0; }
    if s[0].phase == PHASE_GOAL && s[0].phase_t >= CELEBRATE && !s[0].online {
      if !(s[0].replays && replay_start(s)) { after_goal(s); }
    }
    if s[0].phase == PHASE_REPLAY {
      if s[0].rp_step >= s[0].rp_end { replay_end(s); continue; }
      physics_step(s, s[0].rp_drives[s[0].rp_step % REPLAY_STEPS]);
      s[0].rp_step += 1;
      continue;
    }
    if s[0].phase == PHASE_PLAY && !s[0].online {
      s[0].played += STEP;
      if !s[0].overtime { s[0].clock = fmax(0.0, s[0].clock - STEP); }
      if s[0].clock <= 0.0 && !s[0].overtime {
        if s[0].score[0] == s[0].score[1] { s[0].overtime = true; }
        else { s[0].phase = PHASE_OVER; s[0].phase_t = 0.0; end_tracked(s); }
      }
    }
    stage_hold(s);
    // ol-replay: the state each second, before this step's decisions
    recording := s[0].phase == PHASE_PLAY && !s[0].online;
    if recording && s[0].rec_n % KEY_EVERY == 0 { s[0].rp_keys[(s[0].rec_n / KEY_EVERY) % REPLAY_KEYS] = phys_save(s); }
    drives: [CARS] Drive;
    drives[0] = you_drive(s);
    for c: 1..<s[0].cars_n { drives[c] = bot_drive(s, c); }
    if s[0].phase == PHASE_OVER { for c: 0..<CARS { drives[c] = Drive.{}; } }
    // ol-replay: this play's drives
    if recording { for c: 0..<CARS { s[0].rp_drives[s[0].rec_n % REPLAY_STEPS][c] = drives[c]; } }
    // the sphere's curve slopes down to its equator everywhere off it: through
    // the countdown the cars and the ball wait where they were set
    held: [BODIES] RigidBody;
    for i: 0..<BODIES { held[i] = s[0].bodies[i]; }
    physics_step(s, drives);
    if recording { s[0].rec_n += 1; }
    if s[0].sphere && s[0].phase == PHASE_KICKOFF { for i: 0..<BODIES { s[0].bodies[i] = held[i]; } }
    if s[0].online { s[0].you_hist[s[0].hist_n % HIST] = s[0].bodies[YOU]; s[0].hist_n += 1; }
    if s[0].phase == PHASE_PLAY && !s[0].online {
      team := goal_past(s, s[0].bodies[BALL].pos.z);
      if team >= 0 { goal_scored(s, team); }
    }
  }
}

// The ball glows in its trail from 10 m/s, fully at 24.
ball_glow :: (s: [] OrbitLeague) -> f64 { return fclamp((d3_len(s[0].bodies[BALL].vel) - 10.0) / 14.0, 0.0, 1.0); }
nozzle :: (b: RigidBody) -> D3 { return d3_sub(b.pos, d3_add(d3_scale(rigid_axis(b, D3_Z), 2.3), d3_scale(rigid_axis(b, D3_Y), 0.05))); }

effects_step :: (s: [] OrbitLeague, dt: f64) {
  g := gravity_at(s[0].field, D3_ZERO);
  for i: 0..<SPARKS {
    if s[0].sparks[i].life <= 0.0 { continue; }
    sp := s[0].sparks[i];
    sp.v = d3_add(sp.v, d3_scale(g, dt * 0.6));
    sp.v = d3_scale(sp.v, 1.0 - fmin(1.5 * dt, 0.5));
    sp.p = d3_add(sp.p, d3_scale(sp.v, dt));
    if sp.p.y < 0.03 { sp.p.y = 0.03; sp.v.y = abs(sp.v.y) * 0.4; }
    sp.life -= dt;
    s[0].sparks[i] = sp;
  }
  if s[0].blast_t >= 0.0 { s[0].blast_t += dt; if s[0].blast_t > BLAST_LIFE { s[0].blast_t = -1.0; } }
  s[0].shake *= exp(-dt * 6.0);
  // the wheels roll with the car (kept within a turn)
  for c: 0..<s[0].cars_n {
    w := s[0].wheel_spin[c] + vehicle_forward_speed(s[0].bodies[c + 1]) / s[0].spec.wheel_r * dt;
    s[0].wheel_spin[c] = w - floor(w / TAU_D) * TAU_D;
  }
  if s[0].phase == PHASE_KICKOFF { clear_trails(s); }
  s[0].trail_t += dt;
  if s[0].trail_t < TRAIL_DT { return; }
  s[0].trail_t -= TRAIL_DT;
  if s[0].trail_t > TRAIL_DT { s[0].trail_t = 0.0; }
  for i: 0..<TRAIL_N - 1 {
    j := TRAIL_N - 1 - i;
    s[0].ball_trail[j] = s[0].ball_trail[j - 1]; s[0].ball_k[j] = s[0].ball_k[j - 1];
    for c: 0..<2 { o := c * TRAIL_N; s[0].boost_trail[o + j] = s[0].boost_trail[o + j - 1]; s[0].boost_k[o + j] = s[0].boost_k[o + j - 1]; }
  }
  s[0].ball_trail[0] = s[0].bodies[BALL].pos; s[0].ball_k[0] = ball_glow(s);
  for c: 0..<2 {
    s[0].boost_trail[c * TRAIL_N] = nozzle(s[0].bodies[c + 1]);
    s[0].boost_k[c * TRAIL_N] = ifx s[0].boosting[c] then 1.0 else 0.0;
  }
}

// A trail into the uniforms: its bound, then now and the points behind it.
put_trail :: (u: [] f32, at: int, now: D3, now_k: f64, pts: [] D3, ks: [] f64, first: int) {
  c := D3_ZERO; n := 0.0;
  for i: 0..<TRAIL_N {
    p := ifx i == 0 then now else pts[first + i - 1];
    k := ifx i == 0 then now_k else ks[first + i - 1];
    o := at + 4 + i * 4;
    u[o] = cast(f32) p.x; u[o + 1] = cast(f32) p.y; u[o + 2] = cast(f32) p.z; u[o + 3] = cast(f32) k;
    if k > 0.0 { c = d3_add(c, p); n += 1.0; }
  }
  u[at + 3] = -1;
  if n < 1.0 { return; }
  c = d3_scale(c, 1.0 / n);
  r := 0.0;
  for i: 0..<TRAIL_N {
    o := at + 4 + i * 4;
    if u[o + 3] > 0 || (i > 0 && u[o - 1] > 0) { r = fmax(r, d3_dist(c, d3(cast(f64) u[o], cast(f64) u[o + 1], cast(f64) u[o + 2]))); }
  }
  u[at] = cast(f32) c.x; u[at + 1] = cast(f32) c.y; u[at + 2] = cast(f32) c.z; u[at + 3] = cast(f32) (r + 1.0);
}

// Each spark as a short streak along its flight.
draw_sparks :: (s: [] OrbitLeague, out: [] f32, at: int) -> int {
  v := at;
  for i: 0..<SPARKS {
    sp := s[0].sparks[i];
    if sp.life <= 0.0 { continue; }
    k := cast(f32) (sp.life / sp.max);
    tail := d3_sub(sp.p, d3_scale(sp.v, 0.035));
    a := seen(s, cast(f32) sp.p.x, cast(f32) sp.p.y, cast(f32) sp.p.z);
    b := seen(s, cast(f32) tail.x, cast(f32) tail.y, cast(f32) tail.z);
    if !a.ok || !b.ok { continue; }
    w := clamp(sp.size * s[0].height * 0.5 * s[0].sy / a.w, 0.7 * s[0].dpr, 8 * s[0].dpr);
    bx := b.x;
    if abs(a.x - b.x) + abs(a.y - b.y) < 0.5 { bx = a.x + 0.5; }
    if lit(out, v, bx, b.y, a.x, a.y, w, k * 1.2, w * 2.5, sp.red, sp.green, sp.blue, MODE_STROKE) { v += 6; }
  }
  return v;
}

// ---- in from the host

has_text :: (text: string, part: string) -> bool {
  if part.count == 0 { return true; }
  for i: 0..<text.count - part.count + 1 { if text[i..<i + part.count] == part { return true; } }
  return false;
}

game_message :: (s: [] OrbitLeague, kind: int, text: string) #export_c #effects(all) {
  if !s[0].started { game_reset(s); }
  if kind == HOST_FACTS && fact_of(text, "coarse") == "1" { s[0].touch = true; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "arena=drum") { set_arena(s, true); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "arena=sphere") { set_arena_kind(s, ARENA_SPHERE); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=60") { s[0].spin_every = 60.0; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=off") { s[0].spin_every = 0.0; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=half") { s[0].spin_g = HALF_SPIN; }
  // ?mode=1v1 or ?mode=2v2; without it a phone plays 2v2 (ol-bot-modes)
  if kind == HOST_FACTS && !s[0].online {
    url := fact_of(text, "url");
    if has_text(url, "mode=2v2") { s[0].mode_set = true; set_mode(s, CARS); }
    else if has_text(url, "mode=1v1") { s[0].mode_set = true; set_mode(s, 2); }
    else if s[0].touch && !s[0].mode_set && s[0].cars_n != CARS && !has_text(url, "room=") && !has_text(url, "quick=") { set_mode(s, CARS); }
  }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "bot=pro") { s[0].bot_smart = true; s[0].bot_miss_k = 0.3; }
  if kind == HOST_FACTS { s[0].lag = cast(f64) url_number(fact_of(text, "url"), "lag=") / 1000.0; }
  if kind == HOST_FACTS { keep_origin(s, fact_of(text, "url")); }
  if kind == HOST_KEPT { paint_kept(s, text); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "#clip=") { opened := clip_open(s, fact_of(text, "url")); }
  if kind == HOST_FACTS && !s[0].online && (has_text(fact_of(text, "url"), "room=") || has_text(fact_of(text, "url"), "quick=")) { room_join(s, fact_of(text, "url")); }
  if room_socket(s, kind, text) { return; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "bot=0") { s[0].no_bot = true; s[0].cars_n = 2; kickoff(s); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "stage=highlight") { stage_highlight(s); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "card=1") { s[0].card = true; }
  if kind == MAKER_KIND { take_maker(s, text); }
  t := track_message(s[0].track[..], kind, text);
  if kind == HOST_FACTS { track_world(s[0].track[..], "orbit-league"); }
}

// The player's side. ?room=NAME joins; the socket opens to this site's
// /api/room/orbit-league/NAME.
room_join :: (s: [] OrbitLeague, url: string) {
  // the room's name: [a-z0-9-], at most ROOM_NAME
  i := 0; key := "room=";
  found := -1;
  while i + key.count <= url.count { if url[i..<i + key.count] == key { found = i + key.count; break; } i += 1; }
  // ?quick=1v1 or ?quick=2v2: the room server's matchmaking (ol-quick-match)
  named := url;
  if found < 0 && has_text(url, "quick=") { named = ifx has_text(url, "quick=2v2") then "room=quick-2v2" else "room=quick-1v1"; found = 5; }
  if found < 0 { return; }
  n := 0; j := found;
  while j < named.count && n < ROOM_NAME {
    c := named[j];
    if c >= 'A' && c <= 'Z' { c += 32; }
    if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { break; }
    s[0].room[n] = c; n += 1; j += 1;
  }
  if n == 0 { return; }
  s[0].room_n = n;
  s[0].room_authority=!has_text(url,"room-profile=legacy");
  s[0].room_generation=SeatGeneration.{};s[0].room_tick=-1;s[0].room_seq=0;s[0].room_ack=0;room_predict_reset(s);
  if s[0].room_authority && (s[0].drum || s[0].sphere) {set_arena_kind(s,ARENA_BOX);}
  // the origin: scheme and host
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  secure := url.count > 5 && url[0..<5] == "https";
  o := 0;
  pre := ifx secure then "wss://" else "ws://";
  for b: pre { s[0].origin[o] = b; o += 1; }
  start := ifx secure then 8 else 7;
  for q: start..<k { if o < 120 { s[0].origin[o] = url[q]; o += 1; } }
  s[0].origin_n = o;
  s[0].online = true; s[0].no_bot = true; s[0].cars_n = 2; s[0].sock_state = ROOM_JOINING;
  buf: [256] u8; m := 0;
  for q: 0..<o { buf[m] = s[0].origin[q]; m += 1; }
  path:=ifx s[0].room_authority then "/api/room/orbit-league-v2/" else "/api/room/orbit-league/";
  for b:path { buf[m] = b; m += 1; }
  for q: 0..<n { buf[m] = s[0].room[q]; m += 1; }
  ok := pipe_open(s[0].pipe[..], cast(string) buf[0..<m]);
  kickoff(s);
}
game_socket_opened :: (s: [] OrbitLeague, id: int) #export_c #effects(all) {
  s[0].sock = id;
  if id < 0 { s[0].sock_state = ROOM_LOST; }
}
room_socket :: (s: [] OrbitLeague, kind: int, text: string) -> bool {
  e := socket_event(kind);
  if e.id < 0 { return false; }
  if e.id != s[0].sock { return true; }
  if e.event == SOCKET_OPENED {
    s[0].sock_open = true;
    if s[0].room_authority {
      s[0].room_generation=SeatGeneration.{};s[0].room_tick=-1;s[0].room_seq=0;s[0].room_ack=0;room_predict_reset(s);
      s[0].in_n=0;s[0].in_head=0;s[0].lag_on=0;s[0].lag_ohead=0;
      sent:=pipe_send(s[0].pipe[..],s[0].sock,"H 2 1 1 1");
    }
  }
  if e.event == SOCKET_FRAME { room_heard(s, text); }
  if e.event == SOCKET_CLOSED || e.event == SOCKET_ERROR {
    s[0].sock_open = false; s[0].sock = -1; s[0].sock_state = ROOM_LOST;
    if s[0].room_authority {game_blur(s);}
  }
  return true;
}
// A state from the server: the ball, the other car, the score and the phase.
room_take :: (s: [] OrbitLeague, text: string) {
  if s[0].room_authority {room_authority_take(s,text);return;}
  room_take_legacy(s, text);
}
// Every frame online: report your car, 60 times a second. On the v2 profile a report is a control,
// and each one is stepped here as it is sent (room_input): ROOM_HZ a second whatever the display's
// rate, a slow frame's controls together, PREDICT_BURST at most.
PREDICT_BURST :: 4;
room_send :: (s: [] OrbitLeague, dt: f64) {
  if !s[0].online || !s[0].sock_open || s[0].sock < 0 { return; }
  s[0].send_t += dt;
  if s[0].send_t < 1.0 / ROOM_HZ - 0.002 { return; }
  if s[0].room_authority {
    n := 0;
    while n < PREDICT_BURST && s[0].send_t >= 1.0 / ROOM_HZ - 0.002 {
      s[0].send_t = fmax(0.0, s[0].send_t - 1.0 / ROOM_HZ); n += 1;
      if !room_input(s) { return; }
    }
    if n == PREDICT_BURST { s[0].send_t = 0.0; }
    return;
  }
  s[0].send_t = 0.0;
  buf: [256] u8; k := 0;
  buf[k] = 'c'; k += 1;
  k = room_put_body(buf[..], k, room_view(s[0].bodies[YOU], s[0].seat));
  k = room_put_int(buf[..], k, cast(int) (s[0].net_t * 1000.0));
  k = room_put_int(buf[..], k, s[0].paint);
  room_out(s, cast(string) buf[0..<k]);
}
// A frame to the room: at once, or held ?lag's half when simulating latency.
room_out :: (s: [] OrbitLeague, text: string) {
  if s[0].lag <= 0.0 { ok := pipe_send(s[0].pipe[..], s[0].sock, text); return; }
  if s[0].lag_on >= LAG_FRAMES || text.count > 256 { return; }
  slot := (s[0].lag_ohead + s[0].lag_on) % LAG_FRAMES;
  for i: 0..<text.count { s[0].lag_oq[slot][i] = text[i]; }
  s[0].lag_olen[slot] = text.count; s[0].lag_odue[slot] = s[0].net_t + s[0].lag * 0.5; s[0].lag_on += 1;
}

// ---- ol-predict (#13277): the v2 profile's page steps your car itself
// The room is the authority, and still your car moves the frame you press: each control is kept by
// its number (metaverse-engine/net/predict.coax), stepped here with the room's own step, and when
// a snapshot says which control the room stepped last, your car starts again from the snapshot and
// steps the controls after it. What a re-run moved you by is eased out of the drawing
// (NetCorrect). The ball and the other cars are drawn from their last snapshots a jitter buffer
// behind (metaverse-engine/net/interp.coax); your car collides with the ball where it is drawn.
PREDICT_NEAR :: 0.02;        // m: a snapshot this near where your steps had you (and 0.1 m/s) needs no re-run
room_predict_reset :: (s: [] OrbitLeague) {
  s[0].pred[0] = NetPredict.{}; s[0].fix[0] = NetCorrect.{};
  for i: 0..<NET_PREDICT_HIST { s[0].pred_at[i] = 0; }
  for i: 0..<BODIES { s[0].ring_n[i] = 0; }
  s[0].jit = NetJitter.{}; s[0].jit_ticks = 0; s[0].jit_delay = 0; s[0].jit_lag = 0; s[0].rerun = false;
}
// One control's steps of your car alone: the room's substeps of the game's one step, against the
// arena and the ball as drawn. Nothing steps during a kickoff's countdown, as in the room.
room_you_steps :: (s: [] OrbitLeague, drive: Drive, rerun: bool) {
  if s[0].phase == PHASE_KICKOFF { return; }
  ball := s[0].bodies[BALL]; shake := s[0].shake; pads := s[0].pad_wait; was := s[0].replaying;
  s[0].replaying = true; s[0].rerun = rerun;
  drives: [CARS] Drive; drives[0] = drive;
  active: [CARS] bool; active[0] = true;
  for k: 0..<orb_realm().beat.substeps { physics_step_masked(s, drives, active); s[0].bodies[BALL] = ball; }
  if rerun { s[0].pad_wait = pads; s[0].shake = shake; }
  s[0].replaying = was; s[0].rerun = false;
}
// Your car as control `seq`'s steps left it, kept for the snapshot that names that control.
room_you_keep :: (s: [] OrbitLeague, seq: int) {
  slot := seq % NET_PREDICT_HIST;
  s[0].pred_at[slot] = seq; s[0].pred_body[slot] = s[0].bodies[YOU]; s[0].pred_car[slot] = s[0].cars[0];
  s[0].pred_fuel[slot] = s[0].tanks[0].fuel; s[0].pred_stuck[slot] = s[0].stuck_for[0];
}
// One control: numbered, written, kept, sent, and stepped here. False when the socket had to end.
room_input :: (s: [] OrbitLeague) -> bool {
  if s[0].pred[0].seq != s[0].room_seq { room_predict_reset(s); s[0].pred[0].seq = s[0].room_seq; s[0].pred[0].acked = s[0].room_ack; }
  seq := orb_next_input(s[0].room_seq); if seq == 0 { room_authority_end(s); return false; }
  drive := you_drive(s); flags := 0;
  if drive.input.handbrake { flags += 1; } if drive.input.jump { flags += 2; } if drive.boost { flags += 4; }
  i := OrbInput.{ok = true, seq = seq, throttle = cast(int) floor(drive.input.throttle * 1000 + 0.5), steer = cast(int) floor(drive.input.steer * 1000 + 0.5),
    flags = flags, paint = s[0].paint, clock = cast(int) floor(s[0].net_t * 1000), heard = ifx s[0].room_tick < 0 then 0 else s[0].room_tick};
  buf: [256] u8;
  k := orb_input_write(i, buf[..]); if k == 0 { room_authority_end(s); return false; }
  words := [3] int.[i.throttle, i.steer, i.flags];
  _ := net_predict_input(s[0].pred[..], words[..]);
  s[0].room_seq = seq;
  room_out(s, cast(string) buf[0..<k]);
  if s[0].room_tick < 0 { return true; }   // no word on you yet: nothing to step from
  s[0].bodies[YOU] = s[0].you;
  room_you_steps(s, orb_drive(i.throttle, i.steer, i.flags), false);
  room_you_keep(s, seq);
  s[0].you = s[0].bodies[YOU];
  return true;
}
// Your car (bodies[YOU]) stepped again with every control the room has not stepped yet, oldest first.
room_replay :: (s: [] OrbitLeague) {
  words: [NET_PREDICT_WORDS] int;
  for k: 0..<net_predict_pending(s[0].pred[..]) {
    q := net_predict_nth(s[0].pred[..], k);
    if net_predict_held(s[0].pred[..], q, words[..]) != 3 { continue; }
    room_you_steps(s, orb_drive(words[0], words[1], words[2]), true);
    room_you_keep(s, q);
  }
}
// A snapshot named a newer control: when your steps had you somewhere else after that control,
// start from the snapshot and step the controls after it again; ease out what that moved you by.
room_rerun :: (s: [] OrbitLeague) {
  if !net_predict_due(s[0].pred[..]) { return; }
  a := s[0].pred[0].acked; slot := a % NET_PREDICT_HIST; w := s[0].word[YOU];
  kept := a > 0 && s[0].pred_at[slot] == a;
  h := s[0].pred_body[slot];
  turn := h.orientation.x * w.orientation.x + h.orientation.y * w.orientation.y + h.orientation.z * w.orientation.z + h.orientation.w * w.orientation.w;
  near := kept && d3_dist(h.pos, w.pos) < PREDICT_NEAR && d3_dist(h.vel, w.vel) < 0.1 && abs(turn) > 0.9999 && abs(s[0].pred_fuel[slot] - s[0].word_fuel) < 1.0;
  if !near {
    before := s[0].you;
    s[0].bodies[YOU] = w; s[0].tanks[0].fuel = s[0].word_fuel;
    if kept { s[0].cars[0] = s[0].pred_car[slot]; s[0].stuck_for[0] = s[0].pred_stuck[slot]; }
    room_replay(s);
    s[0].you = s[0].bodies[YOU];
    d := d3_sub(s[0].you.pos, before.pos);
    net_correct_take(s[0].fix[..], cast(f32) d.x, cast(f32) d.y, cast(f32) d.z);
    mm := cast(int) (d3_len(d) * 1000);
    if mm > 0 { s[0].reruns = add_sat(s[0].reruns, 1); }
    if mm > s[0].fix_mm { s[0].fix_mm = mm; }
  }
  net_predict_done(s[0].pred[..]);
}
// A body as a ring's state at server time t: its turn rides in the realm's three scalars (w is
// kept positive, so three name it), blended with the ring's span.
room_ring_state :: (b: RigidBody, t: int) -> NetState {
  q := b.orientation; k := ifx q.w < 0.0 then -1.0 else 1.0;
  return NetState.{t = t, x = cast(f32) b.pos.x, y = cast(f32) b.pos.y, z = cast(f32) b.pos.z, vx = cast(f32) b.vel.x, vy = cast(f32) b.vel.y, vz = cast(f32) b.vel.z,
                   ax = cast(f32) (q.x * k), az = cast(f32) (q.y * k), age = cast(f32) (q.z * k)};
}
room_ring_turn :: (p: NetState) -> DQ {
  x := cast(f64) p.ax; y := cast(f64) p.az; z := cast(f64) p.age;
  return dq(x, y, z, sqrt(fmax(0.0, 1.0 - x * x - y * y - z * z)));
}
// Body i where its snapshots put it at server time rt.
room_ring_body :: (s: [] OrbitLeague, i: int, rt: int) -> RigidBody {
  ring := s[0].rings[i * ORB_RING..<i * ORB_RING + s[0].ring_n[i]];
  p := net_ring_at(ring, rt, NET_AHEAD); sp := net_ring_span(ring, rt);
  b := s[0].word[i];
  b.pos = d3(cast(f64) p.x, cast(f64) p.y, cast(f64) p.z); b.vel = d3(cast(f64) p.vx, cast(f64) p.vy, cast(f64) p.vz);
  qa := room_ring_turn(ring[sp.a]); qb := room_ring_turn(ring[sp.b]);
  if qa.x * qb.x + qa.y * qb.y + qa.z * qb.z + qa.w * qb.w < 0.0 { qa = dq(-qa.x, -qa.y, -qa.z, -qa.w); }
  b.orientation = dq_unit(dq_axpy(qa, dq_axpy(qb, qa, -1.0), cast(f64) sp.f));
  return b;
}
// A snapshot's tick on the page's clock (ms): the tick map starts where the first one was heard and
// follows the room (net_map_follow).
room_tick_t :: (s: [] OrbitLeague, tick: int) -> int { return s[0].jit_t0 + ((tick - s[0].jit_tick0) * 1000) / cast(int) ROOM_HZ; }
// Every frame on the v2 profile: what is drawn. The ball and the other cars from their rings, the
// buffer's delay behind; your car where your steps have it, less what the re-runs have yet to ease
// out, on by its speed for the part of a control's interval not yet stepped (a display faster
// than ROOM_HZ draws it between its steps).
room_draw :: (s: [] OrbitLeague, dt: f64) {
  if s[0].room_tick < 0 { return; }
  s[0].jit_lag = net_lag_step(s[0].jit_lag, s[0].jit_delay, s[0].jit_ticks, cast(f32) dt);
  rt := cast(int) (s[0].net_t * 1000.0) - cast(int) s[0].jit_lag;
  for i: 0..<BODIES {
    if i == YOU { continue; }
    s[0].bodies[i] = ifx s[0].ring_n[i] == 0 then s[0].word[i] else room_ring_body(s, i, rt);
  }
  off := net_correct_step(s[0].fix[..], cast(f32) dt);
  b := s[0].you;
  b.pos = d3_add(b.pos, d3(cast(f64) off[0], cast(f64) off[1], cast(f64) off[2]));
  if s[0].phase != PHASE_KICKOFF && s[0].sock_open { b.pos = d3_add(b.pos, d3_scale(b.vel, fclamp(s[0].send_t, 0.0, 1.0 / ROOM_HZ))); }
  s[0].bodies[YOU] = b;
}
room_authority_end :: (s:[]OrbitLeague) {
  if s[0].sock>=0 {closed:=pipe_close(s[0].pipe[..],s[0].sock);}
  s[0].sock_open=false;s[0].sock=-1;s[0].sock_state=ROOM_LOST;
  game_blur(s);
}
room_connection_text :: (s:[]OrbitLeague)->string {
  if s[0].sock_state==ROOM_LOST && s[0].room_authority {return "ROOM CONNECTION LOST. RELOAD TO REJOIN";}
  return ifx s[0].sock_state==ROOM_LOST then "LOST THE ROOM: PLAYING ON YOUR OWN" else "JOINING THE ROOM";
}
room_authority_body :: (v:[]s32,old:RigidBody)->RigidBody {
  b:=old;b.pos=d3(f64(cast(int)v[0])/1000,f64(cast(int)v[1])/1000,f64(cast(int)v[2])/1000);
  q:=dq(f64(cast(int)v[3])/1000000,f64(cast(int)v[4])/1000000,f64(cast(int)v[5])/1000000,f64(cast(int)v[6])/1000000);
  b.orientation=ifx dq_len(q)>0.5 then dq_unit(q) else DQ.{};
  b.vel=d3(f64(cast(int)v[7])/1000,f64(cast(int)v[8])/1000,f64(cast(int)v[9])/1000);
  b.omega=d3(f64(cast(int)v[10])/1000,f64(cast(int)v[11])/1000,f64(cast(int)v[12])/1000);return b;
}
room_authority_take :: (s:[]OrbitLeague,text:string) {
  if !s[0].sock_open || s[0].sock<0 {return;}
  if text.count>0 && text[0]=='R' {r:=net_record_read(text);if r.ok && r.n==1 && r.v[0]>0 {room_authority_end(s);}return;}
  frame:=orb_snapshot_read(text);if !orb_snapshot_takes(frame,s[0].room_generation,s[0].room_tick,s[0].room_seq) {return;}
  seat:=frame.h[1];side:=seat%2;kicked:=s[0].kicks!=frame.h[10];
  mine:=ifx side==0 then frame.h[8] else frame.h[9];theirs:=ifx side==0 then frame.h[9] else frame.h[8];
  if frame.h[5]==PHASE_GOAL && s[0].phase!=PHASE_GOAL && mine+theirs>s[0].score[0]+s[0].score[1] {
    goal_scored(s,ifx mine>s[0].score[0] then BLUE else MAGENTA);
  }
  first:=s[0].room_tick<0;
  s[0].seat=seat;s[0].room_generation=SeatGeneration.{value=frame.h[2]};s[0].room_tick=frame.h[0];s[0].room_ack=frame.h[3];
  s[0].heard+=1;s[0].sock_state=ROOM_IN;s[0].phase=frame.h[5];s[0].phase_t=f64(frame.h[6])/1000;s[0].clock=f64(frame.h[7])/1000;
  // Presentation derives spin from the authoritative match clock. It cannot refill fuel or
  // advance physics; those remain server state. URL-only offline spin settings do not select v2 rules.
  s[0].played=MATCH_TIME-s[0].clock;s[0].spin_every=SPIN_EVERY;s[0].spin_g=1;
  s[0].spin_now=spin_share(s[0].played,SPIN_EVERY);s[0].field.scale=s[0].spin_now;
  s[0].score[0]=mine;s[0].score[1]=theirs;s[0].kicks=frame.h[10];s[0].ball_err=D3_ZERO;s[0].oth_n=0;
  // the snapshot's tick on the page's clock, and the jitter buffer's delay (ol-predict)
  now:=cast(int)(s[0].net_t*1000.0);
  if s[0].jit_ticks==0 {s[0].jit_tick0=frame.h[0];s[0].jit_t0=now;}
  at_t:=room_tick_t(s,frame.h[0]);
  j:=net_jitter_heard(s[0].jit,s[0].jit_ticks,now,at_t,s[0].jit_last);
  s[0].jit_delay=net_jitter_delay(j);
  follow:=net_map_follow(j.late_mean,s[0].jit_ticks);s[0].jit_t0+=follow;j.late_mean-=cast(f32)follow;
  s[0].jit=j;s[0].jit_ticks+=1;s[0].jit_last=at_t;
  if kicked {for i:0..<BODIES {s[0].ring_n[i]=0;}}   // a kickoff sets everything out again: nothing is drawn between
  s[0].word[BALL]=room_view(room_authority_body(frame.v[0..<ORB_FIELDS],s[0].bodies[BALL]),seat);
  if s[0].ring_n[BALL]==0 {s[0].bodies[BALL]=s[0].word[BALL];}   // nothing to draw it between yet: where the room says
  s[0].ring_n[BALL]=net_ring_push(s[0].rings[BALL*ORB_RING..<(BALL+1)*ORB_RING],s[0].ring_n[BALL],room_ring_state(s[0].word[BALL],at_t));
  fourth:=false;
  for c:0..<ROOM_PLAYERS {
    slot:=ifx c==seat then YOU else ifx c%2==side then MATE else ifx c<2 then BOT else RIVAL;
    visible:=net_snapshot_visible(s[0].room_present[c],frame.present[c+1],true);s[0].room_present[c]=visible;
    if !visible {
      s[0].word[slot]=vehicle_body(s[0].spec,CAR_MASS,d3(0,-1000-f64(slot)*10,0),DQ.{});s[0].ring_n[slot]=0;
      s[0].bodies[slot]=s[0].word[slot];if slot==YOU {s[0].you=s[0].word[slot];}
      continue;
    }
    at:=(c+1)*ORB_FIELDS;
    s[0].word[slot]=room_view(room_authority_body(frame.v[at..<at+ORB_FIELDS],s[0].bodies[slot]),seat);
    s[0].paints[slot-1]=cast(int)frame.v[at+13];if slot==MATE || slot==RIVAL {fourth=true;}
    if slot!=YOU {
      if s[0].ring_n[slot]==0 {s[0].bodies[slot]=s[0].word[slot];}
      s[0].ring_n[slot]=net_ring_push(s[0].rings[slot*ORB_RING..<(slot+1)*ORB_RING],s[0].ring_n[slot],room_ring_state(s[0].word[slot],at_t));
      continue;
    }
    // the room's word on you, and the last control of yours it stepped: the re-run starts here
    s[0].word_fuel=f64(cast(int)frame.v[at+ORB_FUEL])/1000;
    newer:=net_predict_heard(s[0].pred[..],frame.h[3]);
    if kicked || first || (newer && net_predict_pending(s[0].pred[..])==0) {
      // a kickoff, your first snapshot, or nothing of yours waits: you are where the room says
      // (the controls already on their way are stepped from it at once, with nothing to ease)
      s[0].bodies[YOU]=s[0].word[YOU];s[0].tanks[0].fuel=s[0].word_fuel;s[0].fix[0]=NetCorrect.{};
      if kicked || first {s[0].cars[0]=VehicleState.{};s[0].stuck_for[0]=0.0;for i:0..<NET_PREDICT_HIST {s[0].pred_at[i]=0;}}
      room_replay(s);s[0].you=s[0].bodies[YOU];
      net_predict_done(s[0].pred[..]);
    }
  }
  s[0].cars_n=ifx fourth then CARS else 2;
  if kicked {clear_trails(s);s[0].cam_ready=false;}
  if frame.h[4]>=0 {trip:=s[0].net_t-f64(frame.h[4])/1000;if trip>=0 && trip<2 {s[0].rtt=ifx s[0].rtt<=0 then trip else s[0].rtt+(trip-s[0].rtt)*0.1;}}
}
// Every frame online (ol-prediction): the clock, the fading corrections, and
// ?lag's held frames let through when due; then your car's report.
room_frame :: (s: [] OrbitLeague, dt: f64) {
  if !s[0].online { return; }
  s[0].net_t += dt;
  s[0].ball_err = d3_scale(s[0].ball_err, exp(-dt / SMOOTH));
  while s[0].in_n > 0 && s[0].in_due[s[0].in_head] <= s[0].net_t {
    h := s[0].in_head;
    s[0].in_head = (h + 1) % LAG_FRAMES; s[0].in_n -= 1;
    room_take(s, cast(string) s[0].in_q[h][0..<s[0].in_len[h]]);
  }
  while s[0].lag_on > 0 && s[0].lag_odue[s[0].lag_ohead] <= s[0].net_t {
    h := s[0].lag_ohead;
    s[0].lag_ohead = (h + 1) % LAG_FRAMES; s[0].lag_on -= 1;
    if s[0].sock_open && s[0].sock >= 0 { ok := pipe_send(s[0].pipe[..], s[0].sock, cast(string) s[0].lag_oq[h][0..<s[0].lag_olen[h]]); }
  }
  if s[0].room_authority { room_rerun(s); }
  room_send(s, dt);
  if s[0].room_authority { room_draw(s, dt); }
}
// A state as it arrives: at once, or held ?lag's half when simulating latency.
room_heard :: (s: [] OrbitLeague, text: string) {
  if s[0].lag <= 0.0 { room_take(s, text); return; }
  if s[0].in_n >= LAG_FRAMES || text.count > LAG_BYTES { return; }
  slot := (s[0].in_head + s[0].in_n) % LAG_FRAMES;
  for i: 0..<text.count { s[0].in_q[slot][i] = text[i]; }
  s[0].in_len[slot] = text.count; s[0].in_due[slot] = s[0].net_t + s[0].lag * 0.5; s[0].in_n += 1;
}
// ?NAME=digits in a URL: the number, or 0.
url_number :: (url: string, key: string) -> int {
  i := 0;
  while i + key.count <= url.count {
    if url[i..<i + key.count] == key {
      j := i + key.count; v := 0;
      while j < url.count && url[j] >= '0' && url[j] <= '9' && v < 100000 { v = v * 10 + cast(int) (url[j] - '0'); j += 1; }
      return v;
    }
    i += 1;
  }
  return 0;
}

// The maker's name, as sent (never read): up to MAKER_BYTES, not cutting a character.
take_maker :: (s: [] OrbitLeague, text: string) {
  n := least(text.count, MAKER_BYTES);
  if n < text.count { while n > 0 && (text[n] & 0xC0) == 0x80 { n -= 1; } }
  for i: 0..<n { s[0].maker[i] = text[i]; }
  s[0].maker_n = n;
}

// ---- clips (ol-clips): a goal's replay as a link anyone can open
//
// The link carries the saved state its replay starts from (every number
// exactly, as an integer and a power of two), your drives (runs of equal
// ones) and the arena and mode; the bots' drives are not in it: they decide
// again from the same state, as they did. #clip=... plays it and loops.

CLIP_ABC :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
// An integer as base-32 digits, low first: the first 32 letters go on, the last 32 end it.
clip_int :: (buf: [] u8, at: int, v: int) -> int {
  u := ifx v >= 0 then v * 2 else -v * 2 - 1;
  k := at;
  while k < buf.count {
    dg := u % 32; u = u / 32;
    buf[k] = CLIP_ABC[ifx u > 0 then dg else dg + 32]; k += 1;
    if u == 0 { break; }
  }
  return k;
}
clip_read_int :: (text: string, at: [] int, ok: [] bool) -> int {
  u := 0; mul := 1; i := at[0];
  while true {
    if i >= text.count || mul > 1 << 58 { ok[0] = false; at[0] = i; return 0; }
    c := text[i]; i += 1;
    dg := -1;
    for j: 0..<64 { if CLIP_ABC[j] == c { dg = j; break; } }
    if dg < 0 { ok[0] = false; at[0] = i; return 0; }
    u += (dg % 32) * mul; mul *= 32;
    if dg >= 32 { break; }
  }
  at[0] = i;
  return ifx u % 2 == 0 then u / 2 else -(u + 1) / 2;
}
// A number exactly: m * 2^e with m a 53-bit integer.
clip_num :: (buf: [] u8, at: int, x: f64) -> int {
  if x == 0.0 || x != x { k := clip_int(buf, at, 0); return clip_int(buf, k, 0); }
  a := abs(x); e := 0;
  while a >= 9007199254740992.0 { a *= 0.5; e += 1; }
  while a < 4503599627370496.0 { a *= 2.0; e -= 1; }
  m := cast(int) a;
  k := clip_int(buf, at, ifx x < 0.0 then -m else m);
  return clip_int(buf, k, e);
}
clip_read_num :: (text: string, at: [] int, ok: [] bool) -> f64 {
  m := clip_read_int(text, at, ok); e := clip_read_int(text, at, ok);
  if e < -1100 || e > 1100 { ok[0] = false; return 0.0; }
  x := cast(f64) m;
  while e > 0 { x *= 2.0; e -= 1; }
  while e < 0 { x *= 0.5; e += 1; }
  return x;
}
clip_d3 :: (buf: [] u8, at: int, v: D3) -> int { k := clip_num(buf, at, v.x); k = clip_num(buf, k, v.y); return clip_num(buf, k, v.z); }
clip_read_d3 :: (text: string, at: [] int, ok: [] bool) -> D3 { x := clip_read_num(text, at, ok); y := clip_read_num(text, at, ok); z := clip_read_num(text, at, ok); return d3(x, y, z); }
clip_flag :: (b: bool) -> int { return ifx b then 1 else 0; }

// A saved state, written; and read back over `o` (masses, sizes and the field from it).
clip_state :: (buf: [] u8, at: int, o: PhysState) -> int {
  k := at;
  for i: 0..<BODIES {
    b := o.bodies[i];
    k = clip_d3(buf, k, b.pos); k = clip_d3(buf, k, b.vel);
    k = clip_num(buf, k, b.orientation.x); k = clip_num(buf, k, b.orientation.y); k = clip_num(buf, k, b.orientation.z); k = clip_num(buf, k, b.orientation.w);
    k = clip_d3(buf, k, b.omega); k = clip_d3(buf, k, b.force); k = clip_d3(buf, k, b.torque);
    k = clip_int(buf, k, clip_flag(b.sleeping) + 2 * clip_flag(b.supported)); k = clip_num(buf, k, b.sleep_time);
  }
  for c: 0..<CARS {
    v := o.cars[c];
    for w: 0..<WHEELS { k = clip_int(buf, k, clip_flag(v.touching[w])); k = clip_num(buf, k, v.compression[w]); k = clip_d3(buf, k, v.contact[w]); }
    k = clip_d3(buf, k, v.ground_n); k = clip_int(buf, k, v.wheels); k = clip_num(buf, k, v.steer_now); k = clip_num(buf, k, v.air_time);
    k = clip_int(buf, k, v.jumps); k = clip_int(buf, k, clip_flag(v.jump_held)); k = clip_num(buf, k, v.dodge_t); k = clip_num(buf, k, v.since_jump);
    k = clip_num(buf, k, o.tanks[c].fuel); k = clip_num(buf, k, o.tanks[c].capacity); k = clip_int(buf, k, clip_flag(o.tanks[c].carried));
    k = clip_int(buf, k, clip_flag(o.boosting[c])); k = clip_num(buf, k, o.stuck_for[c]); k = clip_num(buf, k, o.wheel_spin[c]);
    k = clip_num(buf, k, o.bot_jump_t[c]); k = clip_num(buf, k, o.bot_touch_t[c]); k = clip_num(buf, k, o.bot_aim[c]);
  }
  for i: 0..<PADS { k = clip_num(buf, k, o.pad_wait[i]); }
  for i: 0..<BOT_PATH { k = clip_d3(buf, k, o.bot_path[i]); }
  k = clip_num(buf, k, o.played); k = clip_num(buf, k, o.spin_now); k = clip_num(buf, k, o.field.scale);
  k = clip_num(buf, k, o.bot_path_at); k = clip_int(buf, k, o.bot_path_goal); k = clip_num(buf, k, o.seed); k = clip_num(buf, k, o.phase_t);
  return k;
}
clip_read_state :: (text: string, at: [] int, ok: [] bool, base: PhysState) -> PhysState {
  o := base;
  for i: 0..<BODIES {
    b := o.bodies[i];
    b.pos = clip_read_d3(text, at, ok); b.vel = clip_read_d3(text, at, ok);
    qx := clip_read_num(text, at, ok); qy := clip_read_num(text, at, ok); qz := clip_read_num(text, at, ok); qw := clip_read_num(text, at, ok);
    b.orientation = dq(qx, qy, qz, qw);
    b.omega = clip_read_d3(text, at, ok); b.force = clip_read_d3(text, at, ok); b.torque = clip_read_d3(text, at, ok);
    f := clip_read_int(text, at, ok); b.sleeping = f % 2 == 1; b.supported = f / 2 == 1; b.sleep_time = clip_read_num(text, at, ok);
    o.bodies[i] = b;
  }
  for c: 0..<CARS {
    v := o.cars[c];
    for w: 0..<WHEELS { v.touching[w] = clip_read_int(text, at, ok) == 1; v.compression[w] = clip_read_num(text, at, ok); v.contact[w] = clip_read_d3(text, at, ok); }
    v.ground_n = clip_read_d3(text, at, ok); v.wheels = clip_read_int(text, at, ok); v.steer_now = clip_read_num(text, at, ok); v.air_time = clip_read_num(text, at, ok);
    v.jumps = clip_read_int(text, at, ok); v.jump_held = clip_read_int(text, at, ok) == 1; v.dodge_t = clip_read_num(text, at, ok); v.since_jump = clip_read_num(text, at, ok);
    o.cars[c] = v;
    o.tanks[c].fuel = clip_read_num(text, at, ok); o.tanks[c].capacity = clip_read_num(text, at, ok); o.tanks[c].carried = clip_read_int(text, at, ok) == 1;
    o.boosting[c] = clip_read_int(text, at, ok) == 1; o.stuck_for[c] = clip_read_num(text, at, ok); o.wheel_spin[c] = clip_read_num(text, at, ok);
    o.bot_jump_t[c] = clip_read_num(text, at, ok); o.bot_touch_t[c] = clip_read_num(text, at, ok); o.bot_aim[c] = clip_read_num(text, at, ok);
  }
  for i: 0..<PADS { o.pad_wait[i] = clip_read_num(text, at, ok); }
  for i: 0..<BOT_PATH { o.bot_path[i] = clip_read_d3(text, at, ok); }
  o.played = clip_read_num(text, at, ok); o.spin_now = clip_read_num(text, at, ok); o.field.scale = clip_read_num(text, at, ok);
  o.bot_path_at = clip_read_num(text, at, ok); o.bot_path_goal = clip_read_int(text, at, ok); o.seed = clip_read_num(text, at, ok); o.phase_t = clip_read_num(text, at, ok);
  return o;
}
// A drive's own fields, and whether two are the same.
drive_same :: (a: Drive, b: Drive) -> bool {
  return a.input.throttle == b.input.throttle && a.input.steer == b.input.steer && a.input.handbrake == b.input.handbrake && a.input.jump == b.input.jump && a.boost == b.boost;
}
// The clip of the replay now playing (or last played), written to buf: its length, 0 if it doesn't fit.
clip_write :: (s: [] OrbitLeague, buf: [] u8) -> int {
  key := s[0].rp_key; end := s[0].rp_end;
  k := 0;
  for b: "o1" { buf[k] = b; k += 1; }
  k = clip_int(buf, k, arena_kind(s)); k = clip_int(buf, k, s[0].cars_n); k = clip_int(buf, k, clip_flag(s[0].bot_smart));
  k = clip_num(buf, k, s[0].bot_miss_k); k = clip_num(buf, k, s[0].spin_every); k = clip_num(buf, k, s[0].spin_g);
  k = clip_int(buf, k, s[0].last_goal); k = clip_int(buf, k, clip_flag(s[0].no_bot));
  k = clip_int(buf, k, end - key); k = clip_int(buf, k, s[0].rp_start - key);
  k = clip_state(buf, k, s[0].rp_keys[(key / KEY_EVERY) % REPLAY_KEYS]);
  // your drives, in runs
  i := key;
  while i < end {
    d := s[0].rp_drives[i % REPLAY_STEPS][0];
    n := 1;
    while i + n < end && drive_same(s[0].rp_drives[(i + n) % REPLAY_STEPS][0], d) { n += 1; }
    k = clip_int(buf, k, n); k = clip_num(buf, k, d.input.throttle); k = clip_num(buf, k, d.input.steer);
    k = clip_int(buf, k, clip_flag(d.input.handbrake) + 2 * clip_flag(d.input.jump) + 4 * clip_flag(d.boost));
    if k >= buf.count - 64 { return 0; }
    i += n;
  }
  return k;
}
// SAVE CLIP: the link to this replay, copied.
clip_save :: (s: [] OrbitLeague) {
  if s[0].action != 0 { return; }
  k := 0;
  for i: 0..<s[0].origin_url_n { s[0].outbox[k] = s[0].origin_url[i]; k += 1; }
  for b: "/worlds/orbit-league/#clip=" { s[0].outbox[k] = b; k += 1; }
  n := clip_write(s, s[0].outbox[k..<OUTBOX]);
  if n == 0 { return; }
  s[0].out_n = k + n; s[0].action = ACT_COPY;
  s[0].copied_t = s[0].time;
  track_tally(s[0].track[..], "clip", "");
}
// The page's scheme and host, for links.
keep_origin :: (s: [] OrbitLeague, url: string) {
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  n := 0;
  for i: 0..<k { if n < 128 { s[0].origin_url[n] = url[i]; n += 1; } }
  s[0].origin_url_n = n;
}
// #clip=...: the clip's arena and mode, its state and your drives; then it plays.
clip_open :: (s: [] OrbitLeague, url: string) -> bool {
  key := "#clip=";
  i := 0; found := -1;
  while i + key.count <= url.count { if url[i..<i + key.count] == key { found = i + key.count; break; } i += 1; }
  if found < 0 || found + 2 > url.count || url[found..<found + 2] != "o1" { return false; }
  text := url[found..<url.count];
  at: [1] int; at[0] = 2; ok: [1] bool; ok[0] = true;
  kind := clip_read_int(text, at[..], ok[..]); cars := clip_read_int(text, at[..], ok[..]); smart := clip_read_int(text, at[..], ok[..]);
  miss := clip_read_num(text, at[..], ok[..]); every := clip_read_num(text, at[..], ok[..]); g := clip_read_num(text, at[..], ok[..]);
  last := clip_read_int(text, at[..], ok[..]); nobot := clip_read_int(text, at[..], ok[..]);
  steps := clip_read_int(text, at[..], ok[..]); skip := clip_read_int(text, at[..], ok[..]);
  if !ok[0] || kind < 0 || kind > 2 || (cars != 2 && cars != CARS) || steps < 1 || steps > REPLAY_STEPS || skip < 0 || skip >= steps { return false; }
  s[0].cars_n = cars; s[0].bot_smart = smart == 1; s[0].bot_miss_k = miss; s[0].spin_every = every; s[0].spin_g = g; s[0].no_bot = nobot == 1;
  set_arena_kind(s, kind);
  o := clip_read_state(text, at[..], ok[..], phys_save(s));
  n := 0;
  while n < steps && ok[0] {
    run := clip_read_int(text, at[..], ok[..]);
    d: Drive;
    d.input.throttle = clip_read_num(text, at[..], ok[..]); d.input.steer = clip_read_num(text, at[..], ok[..]);
    f := clip_read_int(text, at[..], ok[..]);
    d.input.handbrake = f % 2 == 1; d.input.jump = (f / 2) % 2 == 1; d.boost = f / 4 == 1;
    if run < 1 || n + run > steps { ok[0] = false; break; }
    for j: 0..<run { s[0].rp_drives[n + j][0] = d; }
    n += run;
  }
  if !ok[0] || n != steps { new_match(s); return false; }
  s[0].clip_key = o; s[0].clip_skip = skip;
  s[0].rp_end = steps; s[0].last_goal = last;
  s[0].clip_play = true; s[0].no_bot = nobot == 1;
  clip_restart(s);
  return true;
}
// The clip from its start: its state, then quietly on to where its replay begins.
clip_restart :: (s: [] OrbitLeague) {
  phys_load(s, s[0].clip_key);
  s[0].phase = PHASE_PLAY; s[0].phase_t = s[0].clip_key.phase_t;
  s[0].rp_step = 0; s[0].clip_hold = 0.0; s[0].rp_cut = -1; s[0].cam_ready = false;
  clear_trails(s);
  while s[0].rp_step < s[0].clip_skip { clip_one(s); }
}
// One step of a clip, as the live game took it: the drives (yours as
// recorded, the bots' decided again), the physics, then the clocks.
clip_one :: (s: [] OrbitLeague) {
  drives: [CARS] Drive;
  drives[0] = s[0].rp_drives[s[0].rp_step][0];
  for c: 1..<s[0].cars_n { drives[c] = bot_drive(s, c); }
  physics_step(s, drives);
  s[0].rp_step += 1;
  s[0].phase_t += STEP; s[0].played += STEP;
}
clip_step :: (s: [] OrbitLeague) {
  if s[0].rp_step < s[0].rp_end { clip_one(s); return; }
  // at its end it holds a moment, then plays again
  s[0].clip_hold += STEP;
  if s[0].clip_hold > 1.5 { clip_restart(s); }
}
play_realm :: (s: [] OrbitLeague) {
  if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/worlds/orbit-league/"); s[0].action = ACT_NAVIGATE; }
}
// ---- paint (ol-paint): your car's colour and decal, kept in this browser
// and sent with your car online, so the others see it.

paint_set :: (s: [] OrbitLeague, p: int) {
  s[0].paint = p;
  if s[0].action == 0 {
    n := put(s[0].outbox[..], 0, "paint ");
    s[0].out_n = put_int(s[0].outbox[..], n, p); s[0].action = ACT_KEEP;
  }
  track_tally(s[0].track[..], "paint", "");
}
paint_kept :: (s: [] OrbitLeague, text: string) {
  if text.count < 7 || text[0..<6] != "paint " { return; }
  p := 0;
  for i: 6..<text.count { if text[i] < '0' || text[i] > '9' || p > 1000 { return; } p = p * 10 + cast(int) (text[i] - '0'); }
  if p < PAINT_COLOURS * PAINT_DECALS { s[0].paint = p; }
}
paint_name :: (p: int) -> string {
  c := p % PAINT_COLOURS;
  if c == 1 { return "WHITE"; } if c == 2 { return "GRAPHITE"; } if c == 3 { return "SILVER"; }
  if c == 4 { return "FOREST"; } if c == 5 { return "LIME"; } if c == 6 { return "TEAL"; } if c == 7 { return "YELLOW"; }
  return "TEAM COLOUR";
}
decal_name :: (p: int) -> string {
  d := p / PAINT_COLOURS;
  if d == 1 { return "STRIPES"; } if d == 2 { return "CHECKS"; } if d == 3 { return "NOSE"; }
  return "NO DECAL";
}
// QUICK MATCH: this mode's queue on the room server (ol-quick-match).
quick_match :: (s: [] OrbitLeague) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, ifx s[0].cars_n == CARS then "/worlds/orbit-league/?quick=2v2" else "/worlds/orbit-league/?quick=1v1");
  s[0].action = ACT_NAVIGATE;
  track_tally(s[0].track[..], "quick", "");
}
// TIP: the maker's tip page.
tip :: (s: [] OrbitLeague) { if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/worlds/orbit-league/tip"); s[0].action = ACT_NAVIGATE; } }

// A finger or the mouse on TIP: only TIP's own presses are taken.
tip_pointer :: (s: [] OrbitLeague, x: f32, y: f32, phase: int, kind: int, id: int) -> bool {
  on := s[0].tip_shown && inside(s[0].tip_box, x, y);
  if kind == 0 { s[0].tip_hover = on && phase != POINTER_CANCEL; }
  if phase == POINTER_DOWN && on { s[0].tip_down = true; s[0].tip_id = id; return true; }
  if !s[0].tip_down || id != s[0].tip_id { return false; }
  if phase == POINTER_MOVE { return true; }
  s[0].tip_down = false;
  if phase == POINTER_UP && on { tip(s); }
  return true;
}

game_golden :: (s: [] OrbitLeague, on: bool) #export_c #effects(all) { s[0].golden = on; }

hold_of :: (key: int) -> int {
  if key == KEY_UP || key == 'w' || key == 'W' { return HOLD_UP; }
  if key == KEY_DOWN || key == 's' || key == 'S' { return HOLD_DOWN; }
  if key == KEY_LEFT || key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == KEY_RIGHT || key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == ' ' { return HOLD_JUMP; }
  if key == KEY_SHIFT { return HOLD_BOOST; }
  return 0;
}

leave :: (s: [] OrbitLeague) { if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/worlds"); s[0].action = ACT_NAVIGATE; } }

toggle_cam :: (s: [] OrbitLeague) {
  s[0].ball_cam = !s[0].ball_cam;
  track_setting(s[0].track[..], "ballcam", s[0].ball_cam);
}

play_again :: (s: [] OrbitLeague) {
  new_match(s);
  track_tally(s[0].track[..], "again", "");
}

game_key :: (s: [] OrbitLeague, key: int, mods: int) -> bool #export_c #effects(all) {
  if !s[0].started { game_reset(s); }
  if s[0].phase == PHASE_REPLAY { replay_end(s); return true; }
  if s[0].clip_play { return true; }
  track_key(s[0].track[..], key, false);
  h := hold_of(key);
  if h != 0 {
    if s[0].online && s[0].room_authority && s[0].sock_state==ROOM_LOST {return false;}
    s[0].held |= h; return true;
  }
  if key == 'c' || key == 'C' { toggle_cam(s); return true; }
  if key == KEY_ESCAPE { leave(s); return true; }
  if key == KEY_ENTER && s[0].phase == PHASE_OVER { play_again(s); return true; }
  return false;
}
game_key_up :: (s: [] OrbitLeague, key: int, mods: int) -> bool #export_c #effects(all) {
  if !s[0].started { game_reset(s); }
  track_key_up(s[0].track[..], key);
  h := hold_of(key);
  if h != 0 { s[0].held &= 63 - h; return true; }
  return false;
}
game_blur :: (s: [] OrbitLeague) #export_c #effects(all) {
  s[0].held = 0; s[0].stick = false; s[0].stick_dx = 0; s[0].stick_dy = 0;
  for b: 0..<BUTTONS { s[0].button_id[b] = -1; }
  track_blur(s[0].track[..]);
  if s[0].online && s[0].room_authority {s[0].send_t=1.0/ROOM_HZ;room_send(s,0);}
}

button_at :: (s: [] OrbitLeague, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if s[0].shown[i] && inside(s[0].boxes_ui[i], x, y) { return i; } }
  return -1;
}

game_pointer :: (s: [] OrbitLeague, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  if !s[0].started { game_reset(s); }
  if kind == 1 { s[0].touch = true; }
  if s[0].phase == PHASE_REPLAY && phase == POINTER_DOWN && button_at(s, x, y) != BTN_BACK && button_at(s, x, y) != BTN_CLIP { replay_end(s); return true; }
  if s[0].clip_play && phase == POINTER_DOWN && button_at(s, x, y) < 0 { return true; }
  if tip_pointer(s, x, y, phase, kind, id) { s[0].hover = -1; return true; }
  b := button_at(s, x, y);
  s[0].hover = ifx kind == 0 && phase != POINTER_CANCEL then b else -1;
  track_pointer(s[0].track[..], x, y, phase, kind, "");
  if phase == POINTER_DOWN {
    if b >= 0 {
      s[0].button_id[b] = id;
      if b == BTN_CAM { toggle_cam(s); }
      if b == BTN_AGAIN { play_again(s); }
      if b == BTN_QUICK { quick_match(s); }
      if b == BTN_PAINT { s[0].paint_open = !s[0].paint_open; }
      if b == BTN_PDONE { s[0].paint_open = false; }
      if b == BTN_PCOL { paint_set(s, (s[0].paint % PAINT_COLOURS + 1) % PAINT_COLOURS + (s[0].paint / PAINT_COLOURS) * PAINT_COLOURS); }
      if b == BTN_PDEC { paint_set(s, s[0].paint % PAINT_COLOURS + ((s[0].paint / PAINT_COLOURS + 1) % PAINT_DECALS) * PAINT_COLOURS); }
      if b == BTN_CLIP { if s[0].clip_play { play_realm(s); } else { clip_save(s); } }
      if b == BTN_MODE { set_mode(s, ifx s[0].cars_n == CARS then 2 else CARS); track_tally(s[0].track[..], ifx s[0].cars_n == CARS then "2v2" else "1v1", ""); }
      if b == BTN_ARENA { set_arena_kind(s, (arena_kind(s) + 1) % 3); track_tally(s[0].track[..], ifx s[0].sphere then "sphere" else ifx s[0].drum then "drum" else "box", ""); }
      if b == BTN_BOOST { track_tally(s[0].track[..], "boost", ""); }
      return true;
    }
    if kind == 1 && x < s[0].width * 0.55 && !s[0].stick {
      s[0].stick = true; s[0].stick_id = id; s[0].stick_x0 = x; s[0].stick_y0 = y; s[0].stick_dx = 0; s[0].stick_dy = 0;
      return true;
    }
    return false;
  }
  for i: 0..<BUTTONS {
    if s[0].button_id[i] == id && phase != POINTER_MOVE {
      if i == BTN_BACK && phase == POINTER_UP && b == BTN_BACK { leave(s); }
      s[0].button_id[i] = -1;
      return true;
    }
  }
  if s[0].stick && id == s[0].stick_id {
    if phase == POINTER_MOVE {
      reach := STICK * hi(s[0].dpr, 0.5);
      s[0].stick_dx = clamp((x - s[0].stick_x0) / reach, -1, 1); s[0].stick_dy = clamp((y - s[0].stick_y0) / reach, -1, 1);
    } else { s[0].stick = false; s[0].stick_dx = 0; s[0].stick_dy = 0; s[0].stick_id = -1; }
    return true;
  }
  return false;
}
game_cursor :: (s: [] OrbitLeague) -> int #export_c #effects(all) { return ifx s[0].hover >= 0 || s[0].tip_hover then 1 else 0; }
game_action :: (s: [] OrbitLeague) -> int #export_c #effects(all) { a := s[0].action; s[0].action = 0; return a; }
game_action_done :: (s: [] OrbitLeague) #export_c #effects(all) { s[0].out_n = 0; }

// ---- the camera: behind your car, or behind it looking at the ball

f3 :: (v: D3) -> [3] f32 { o: [3] f32; o[0] = cast(f32) v.x; o[1] = cast(f32) v.y; o[2] = cast(f32) v.z; return o; }

// Where the eye can be: inside the glass, or in a goal's mouth.
eye_inside :: (e: D3, slack: f64, kind: int) -> bool {
  m := 0.8 - slack;
  // the sphere: anywhere inside its curve
  if kind == ARENA_SPHERE { return sphere_clearance(arena_sphere(), e) > m + 0.4; }
  drum := kind == ARENA_DRUM;
  if drum {
    // inside the curve, or down in a goal's mouth under it
    in_goal := abs(e.z) > ARENA_HZ - m && abs(e.x) < GOAL_HW - m && e.y > m && e.y < GOAL_H - m;
    if drum_clearance(arena_drum(), e) < m + 0.4 && !in_goal { return false; }
  } else if abs(e.x) > ARENA_HX - m || e.y < m || e.y > ARENA_H - m { return false; }
  // clear of the goal frames' posts and crossbar
  if abs(e.z) > ARENA_HZ - 2.5 && abs(e.z) < ARENA_HZ + 1.5 && abs(abs(e.x) - GOAL_HW) < 1.5 && e.y < GOAL_H + 1.5 { return false; }
  if abs(e.z) > ARENA_HZ - 2.5 && abs(e.z) < ARENA_HZ + 1.5 && abs(e.x) < GOAL_HW + 1.5 && abs(e.y - GOAL_H) < 1.5 { return false; }
  if abs(e.z) <= ARENA_HZ - m { return true; }
  return abs(e.z) <= ARENA_HZ + GOAL_D - 1.0 + slack && abs(e.x) < GOAL_HW - m && e.y < GOAL_H - m;
}

// The tangents of half the view's width and height (view_rows's lens).
Lens :: struct { tx: f64; ty: f64; }
lens_of :: (width: f32, height: f32) -> Lens {
  aspect := cast(f64) (width / hi(height, 1));
  t := 1.0 / tan(FOV * 0.5);
  sx := t / fmax(aspect, 0.3); sy := t;
  if aspect < 1.0 { sx = t * 1.25; sy = sx * aspect; }
  return Lens.{tx = 1.0 / sx, ty = 1.0 / sy};
}
// Where p lands looking from e along look: x, y as shares of the half width
// and half height (|x|, |y| < 1 on screen; y up); z < 0.3 is behind.
Lands :: struct { x: f64; y: f64; z: f64; }
lands :: (e: D3, look: D3, p: D3, l: Lens) -> Lands {
  r := d3_unit_or(d3(-look.z, 0.0, look.x), D3_X);
  u := d3_cross(r, look);
  if u.y < 0.0 { u = d3_neg(u); }
  d := d3_sub(p, e);
  z := d3_dot(d, look);
  if z < 0.3 { return Lands.{x = 9.0, y = 9.0, z = z}; }
  return Lands.{x = d3_dot(d, r) / z / l.tx, y = d3_dot(d, u) / z / l.ty, z = z};
}
// Framed: a car's length or two away, across the middle, above the phone's
// thumbs and below the score.
framed :: (q: Lands) -> bool { return q.z >= 5.0 && abs(q.x) < 0.8 && q.y > -0.6 && q.y < 0.75; }

Shot3 :: struct { eye: D3; at: D3; }

// Ball cam looks between the car and the ball, a little toward the ball.
ball_cam_look :: (e: D3, car: D3, ball: D3) -> D3 {
  u := d3_unit_or(d3_sub(d3_add(car, d3(0.0, 0.5, 0.0)), e), D3_Z);
  v := d3_unit_or(d3_sub(ball, e), D3_Z);
  return d3_unit_or(d3_add(d3_scale(u, 0.45), d3_scale(v, 0.55)), v);
}

// The shot: the eye behind the car along dir. Against the glass it comes in,
// rises or swings round the car, the least change that still frames the car
// (and on ball cam the ball); it never leaves the arena. If nothing frames
// both, your car wins: the edge marker shows where the ball is.
choose_shot :: (car: D3, dir: D3, ball: D3, ball_cam: bool, at: D3, l: Lens, kind: int) -> Shot3 {
  drum := kind != ARENA_BOX;
  rc := ifx kind == ARENA_SPHERE then SPHERE_R else DRUM_R;
  hh := ifx drum then 2.0 * rc else ARENA_H;
  hx := ifx drum then rc else ARENA_HX;
  best := Shot3.{}; best_cost := 1000000.0;
  near := Shot3.{}; near_cost := 1000000.0;
  carp := d3_add(car, d3(0.0, 0.5, 0.0));
  for h: 0..<3 { for r: 0..<4 { for k: 0..<13 {
    back := CAM_BACK - cast(f64) r * 2.0;
    up := CAM_UP + cast(f64) h * 3.0;
    turn := cast(f64) ((k + 1) / 2) * (PI_D / 12.0) * (ifx k % 2 == 1 then 1.0 else -1.0);
    c := cos(turn); sn := sin(turn);
    d := d3(dir.x * c + dir.z * sn, 0.0, -dir.x * sn + dir.z * c);
    e := d3_add(d3_sub(car, d3_scale(d, back)), d3(0.0, up, 0.0));
    e.y = fclamp(e.y, 0.8, hh - 0.8);
    if !eye_inside(e, 0.0, kind) { continue; }
    look := ifx ball_cam then ball_cam_look(e, car, ball) else d3_unit_or(d3_sub(at, e), d);
    cost := abs(turn) + 0.15 * (CAM_BACK - back) + 0.05 * (up - CAM_UP);
    qc := lands(e, look, carp, l);
    ok := framed(qc);
    if ball_cam { ok = ok && framed(lands(e, look, ball, l)); }
    if ok && cost < best_cost { best_cost = cost; best = Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
    // failing that: the nearest the car comes to the frame
    miss := fmax(abs(qc.x) - 0.8, 0.0) + fmax(-0.6 - qc.y, 0.0) + fmax(qc.y - 0.75, 0.0) + cost * 0.1;
    if miss < near_cost { near_cost = miss; near = Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
  } } }
  if best_cost < 1000000.0 { return best; }
  if near_cost >= 1000000.0 {
    // no eye fits round the car (deep in a goal): above it, looking ahead
    e := d3(fclamp(car.x, -hx + 0.8, hx - 0.8), fclamp(car.y + CAM_UP + 3.0, 0.8, hh - 0.8), fclamp(car.z, -ARENA_HZ - GOAL_D + 1.0, ARENA_HZ + GOAL_D - 1.0));
    e = d3_sub(e, d3_scale(dir, 2.0));
    if !eye_inside(e, 0.0, kind) { e.x = fclamp(e.x, -hx + 0.8, hx - 0.8); e.z = fclamp(e.z, -ARENA_HZ + 2.6, ARENA_HZ - 2.6); }
    if drum && !eye_inside(e, 0.0, kind) { e = d3(0.0, CAM_UP + 3.0, e.z); }
    return Shot3.{eye = e, at = d3_add(car, d3_scale(dir, 2.0))};
  }
  if !ball_cam { return near; }
  // nothing frames both (pinned in a corner with the ball high or behind):
  // your car stays in the frame, turned as far toward the ball as it allows
  e := near.eye;
  u := d3_unit_or(d3_sub(carp, e), D3_Z); v := d3_unit_or(d3_sub(ball, e), D3_Z);
  for i: 0..<12 {
    t := 0.55 - cast(f64) i * 0.05;
    look := d3_unit_or(d3_add(d3_scale(u, 1.0 - t), d3_scale(v, t)), u);
    if framed(lands(e, look, carp, l)) || i == 11 { return Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
  }
  return near;
}

// A goal's replay from three cameras, cut as it plays: behind the ball toward
// the goal, from the side, then from the goal it went into.
replay_camera :: (s: [] OrbitLeague, dt: f32) {
  bl := s[0].bodies[BALL].pos;
  gs := ifx s[0].last_goal == BLUE then 1.0 else -1.0;
  left := cast(f64) (s[0].rp_end - s[0].rp_step) * STEP;
  cut := ifx left > 3.0 then 0 else ifx left > 1.5 then 1 else 2;
  if cut != s[0].rp_cut { s[0].rp_cut = cut; s[0].cam_ready = false; }
  turn := frame_at(s, bl);
  on := to_floor(s, bl, turn);
  eye := D3_ZERO;
  if cut == 0 { eye = from_floor(s, d3_add(on, d3(0.0, 4.0, -10.0 * gs)), turn); }
  if cut == 1 { eye = from_floor(s, d3_add(on, d3(ifx on.x > 0.0 then -12.0 else 12.0, 5.0, -2.0 * gs)), turn); }
  if cut == 2 {
    eye = ifx s[0].sphere then d3(0.0, SPHERE_R, gs * (SPHERE_R - 4.0)) else d3(0.0, GOAL_H + 3.0, gs * (ARENA_HZ - 2.0));
  }
  // kept inside the arena: drawn in toward the ball until it is
  for i: 0..<12 { if eye_inside(eye, 0.0, arena_kind(s)) { break; } eye = d3_add(eye, d3_scale(d3_sub(bl, eye), 0.2)); }
  up := dq_rotate(turn, D3_Y);
  e := f3(eye); a := f3(bl); w := f3(up);
  k: f32 = ifx s[0].cam_ready then 1 - exp(-dt * 10.0) else 1;
  for i: 0..<3 {
    s[0].cam_eye[i] += (e[i] - s[0].cam_eye[i]) * k; s[0].cam_at[i] += (a[i] - s[0].cam_at[i]) * k;
    s[0].cam_up[i] += (w[i] - s[0].cam_up[i]) * k;
  }
  s[0].cam_ready = true;
}
camera :: (s: [] OrbitLeague, dt: f32) {
  if s[0].phase == PHASE_REPLAY || s[0].clip_play { replay_camera(s, dt); return; }
  car := s[0].bodies[YOU]; bl := s[0].bodies[BALL];
  // in the drum the shot is found as if the car were on the floor's lowest
  // line, then turned back round the axis to where it is
  turn := frame_at(s, car.pos);
  if curved(s) {
    car.pos = to_floor(s, car.pos, turn); car.vel = dq_rotate(dq_conj(turn), car.vel);
    car.orientation = dq_mul(dq_conj(turn), car.orientation);
    bl.pos = to_floor(s, bl.pos, turn);
  }
  f := rigid_axis(car, D3_Z);
  dir := d3_unit_or(d3(f.x, 0.0, f.z), D3_Z);
  // moving fast: look the way it goes
  flat_v := d3(car.vel.x, 0.0, car.vel.z);
  if d3_len(flat_v) > 4.0 && d3_dot(flat_v, dir) > 0.0 { dir = d3_unit_or(d3_add(dir, d3_scale(d3_unit(flat_v), 0.6)), dir); }
  at := d3_add(car.pos, d3_add(d3_scale(dir, 4.0), d3(0.0, 1.0, 0.0)));
  // ball cam: behind the car on the line from the ball
  if s[0].ball_cam { to := d3_sub(bl.pos, car.pos); dir = d3_unit_or(d3(to.x, 0.0, to.z), dir); }
  shot := choose_shot(car.pos, dir, bl.pos, s[0].ball_cam, at, lens_of(s[0].width, s[0].height), arena_kind(s));
  up := D3_Y;
  if curved(s) { shot.eye = from_floor(s, shot.eye, turn); shot.at = from_floor(s, shot.at, turn); up = dq_rotate(turn, D3_Y); }
  e := f3(shot.eye); a := f3(shot.at); w := f3(up);
  k: f32 = ifx s[0].cam_ready then 1 - exp(-dt * 7.0) else 1;
  for i: 0..<3 {
    s[0].cam_eye[i] += (e[i] - s[0].cam_eye[i]) * k; s[0].cam_at[i] += (a[i] - s[0].cam_at[i]) * k;
    s[0].cam_up[i] += (w[i] - s[0].cam_up[i]) * k;
  }
  s[0].cam_ready = true;
}

view_rows :: (s: [] OrbitLeague) {
  aspect := s[0].width / hi(s[0].height, 1);
  ex := s[0].cam_eye[0]; ey := s[0].cam_eye[1]; ez := s[0].cam_eye[2];
  // a hit or a goal shakes the camera a little
  if s[0].shake > 0.01 && !s[0].golden && !s[0].still {
    m := cast(f32) s[0].shake * 0.28; t := s[0].time;
    ex += sin(t * 53.0) * m; ey += sin(t * 47.0 + 1.3) * m * 0.7; ez += sin(t * 41.0 + 2.1) * m;
  }
  fx := s[0].cam_at[0] - ex; fy := s[0].cam_at[1] - ey; fz := s[0].cam_at[2] - ez;
  fl := hi(sqrt(fx * fx + fy * fy + fz * fz), 0.001); fx /= fl; fy /= fl; fz /= fl;
  // right = forward x up, up = right x forward (up is +y outside the drum)
  upx := s[0].cam_up[0]; upy := s[0].cam_up[1]; upz := s[0].cam_up[2];
  if upx * upx + upy * upy + upz * upz < 0.01 { upx = 0; upy = 1; upz = 0; }
  rx := fy * upz - fz * upy; ry := fz * upx - fx * upz; rz := fx * upy - fy * upx;
  rl := hi(sqrt(rx * rx + ry * ry + rz * rz), 0.001); rx /= rl; ry /= rl; rz /= rl;
  ux := ry * fz - rz * fy; uy := rz * fx - rx * fz; uz := rx * fy - ry * fx;
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 1.25; sy = sx * aspect; }
  s[0].sy = sy;
  zn: f32 = 0.1; zf: f32 = 400.0;
  a := zf / (zn - zf); b := zn * zf / (zn - zf);
  v := s[0].view[..];
  v[0] = sx * rx; v[1] = sx * ry; v[2] = sx * rz; v[3] = -sx * (rx * ex + ry * ey + rz * ez);
  v[4] = sy * ux; v[5] = sy * uy; v[6] = sy * uz; v[7] = -sy * (ux * ex + uy * ey + uz * ez);
  v[8] = -a * fx; v[9] = -a * fy; v[10] = -a * fz; v[11] = a * (fx * ex + fy * ey + fz * ez) + b;
  v[12] = fx; v[13] = fy; v[14] = fz; v[15] = -(fx * ex + fy * ey + fz * ez);
  s[0].eye[0] = ex; s[0].eye[1] = ey; s[0].eye[2] = ez;
  s[0].fwd[0] = fx; s[0].fwd[1] = fy; s[0].fwd[2] = fz;
  s[0].right[0] = rx / sx; s[0].right[1] = ry / sx; s[0].right[2] = rz / sx;
  s[0].up[0] = ux / sy; s[0].up[1] = uy / sy; s[0].up[2] = uz / sy;
}

Seen :: struct { x: f32; y: f32; ok: bool; w: f32; }
seen :: (s: [] OrbitLeague, x: f32, y: f32, z: f32) -> Seen {
  v := s[0].view[..];
  cx := v[0] * x + v[1] * y + v[2] * z + v[3];
  cy := v[4] * x + v[5] * y + v[6] * z + v[7];
  cw := v[12] * x + v[13] * y + v[14] * z + v[15];
  if cw < 0.01 { return Seen.{x = 0, y = 0, ok = false, w = 0}; }
  return Seen.{x = (cx / cw * 0.5 + 0.5) * s[0].width, y = (0.5 - cy / cw * 0.5) * s[0].height, ok = true, w = cw};
}

// ---- the HUD

GAP :: 0.5; SPACE :: 1.2;
PARCH_R :: 0.93; PARCH_G :: 0.95; PARCH_B :: 1.0;
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;
white :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, PARCH_R, PARCH_G, PARCH_B); }
team_ink :: (team: int, k: f32, light: f32) -> Ink {
  if team == BLUE { return ink(0.6 * k, light, 1.6 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B); }
  return ink(0.6 * k, light, 1.6 * k, TEAM_O_R, TEAM_O_G, TEAM_O_B);
}
plate :: (s: [] OrbitLeague, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  s[0].plates[n] = b; s[0].plate_alpha[n] = alpha; s[0].plate_look[n] = look; s[0].plate_n = n + 1;
}
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  w := measure(text, GAP, SPACE, false) * cap;
  return write(d, out, at, text, x - w * 0.5, base, cap, GAP, SPACE, k, false, false);
}
clock_text :: (buf: [] u8, at: int, seconds: f64) -> int {
  t := cast(int) ceil_d(fmax(seconds, 0.0));
  n := put_int(buf, at, t / 60); n = put(buf, n, ":");
  if t % 60 < 10 { n = put(buf, n, "0"); }
  return put_int(buf, n, t % 60);
}
hud_button :: (s: [] OrbitLeague, out: [] f32, at: int, which: int, b: Box, label: string, cap: f32) -> int {
  k := s[0].dpr;
  s[0].boxes_ui[which] = b; s[0].shown[which] = true;
  look: f32 = LOOK_LIT;
  if s[0].hover == which || s[0].button_id[which] >= 0 { look += LOOK_HOVER; }
  plate(s, b, 0.85, look);
  return centred(k, out, at, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, white(k, 0.95));
}

// MADE BY <NAME> · TIP along the bottom, centred between x0 and x1 (small,
// dim; TIP in Bitcoin's orange). Nothing without a maker.
maker_line :: (s: [] OrbitLeague, out: [] f32, at: int, x0: f32, x1: f32, base: f32) -> int {
  s[0].tip_shown = false;
  if s[0].maker_n == 0 { return at; }
  k := s[0].dpr;
  lead: [MAKER_BYTES + 16] u8;
  n := put(lead[..], 0, "MADE BY "); n = put(lead[..], n, cast(string) s[0].maker[0..<s[0].maker_n]); n = put(lead[..], n, " · ");
  left := cast(string) lead[0..<n];
  lw := measure(left, GAP, SPACE, false); tw := measure("TIP", GAP, SPACE, false);
  cap := lo(6 * k, (x1 - x0) / hi(lw + tw, 1));
  x := (x0 + x1) * 0.5 - (lw + tw) * cap * 0.5;
  v := write(k, out, at, left, x, base, cap, GAP, SPACE, white(k, 0.55), false, false);
  tx := x + lw * cap;
  hot := s[0].tip_hover || s[0].tip_down;
  v = write(k, out, v, "TIP", tx, base, cap, GAP, SPACE, ink(0.6 * k, ifx hot then 1.0f32 else 0.8f32, 2 * k, ORANGE_R, ORANGE_G, ORANGE_B), false, false);
  s[0].tip_box = Box.{x0 = tx - 8 * k, y0 = base - cap - 10 * k, x1 = tx + tw * cap + 8 * k, y1 = base + 8 * k};
  s[0].tip_shown = true;
  return v;
}

draw_hud :: (s: [] OrbitLeague, out: [] f32) -> int {
  k := s[0].dpr; w := s[0].width; h := s[0].height; d := k;
  phone := w < 700 * k;
  g := 14 * k;
  v := 0;
  buf: [64] u8;
  v = draw_sparks(s, out, v);
  // the score and the clock, top middle
  sw := lo(236 * k, w - 2 * (g + 104 * k));
  sb := Box.{x0 = w * 0.5 - sw * 0.5, y0 = g, x1 = w * 0.5 + sw * 0.5, y1 = g + 46 * k};
  plate(s, sb, 0.88, LOOK_PLAIN);
  n := put_int(buf[..], 0, s[0].score[0]);
  v = centred(d, out, v, cast(string) buf[0..<n], sb.x0 + 34 * k, sb.y0 + 32 * k, 18 * k, team_ink(BLUE, k, 1));
  n = put_int(buf[..], 0, s[0].score[1]);
  v = centred(d, out, v, cast(string) buf[0..<n], sb.x1 - 34 * k, sb.y0 + 32 * k, 18 * k, team_ink(MAGENTA, k, 1));
  n = ifx s[0].overtime then put(buf[..], 0, "+OT") else clock_text(buf[..], 0, s[0].clock);
  v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y0 + 29 * k, 12 * k, white(k, 0.95));
  // REALMS, top left
  bb := Box.{x0 = g, y0 = g, x1 = g + 96 * k, y1 = g + 34 * k};
  v = hud_button(s, out, v, BTN_BACK, bb, "WORLDS", 8 * k);
  // PAINT, under it, before a kickoff and at the end; it opens the picker
  if (s[0].phase == PHASE_KICKOFF || s[0].phase == PHASE_OVER || s[0].paint_open) && !s[0].clip_play {
    pb := Box.{x0 = g, y0 = bb.y1 + 10 * k, x1 = g + 96 * k, y1 = bb.y1 + 44 * k};
    v = hud_button(s, out, v, BTN_PAINT, pb, "PAINT", 8 * k);
    if s[0].paint_open {
      cw := 170 * k;
      c1 := Box.{x0 = g, y0 = pb.y1 + 10 * k, x1 = g + cw, y1 = pb.y1 + 44 * k};
      v = hud_button(s, out, v, BTN_PCOL, c1, paint_name(s[0].paint), 7.5 * k);
      c2 := Box.{x0 = g, y0 = c1.y1 + 8 * k, x1 = g + cw, y1 = c1.y1 + 42 * k};
      v = hud_button(s, out, v, BTN_PDEC, c2, decal_name(s[0].paint), 7.5 * k);
      c3 := Box.{x0 = g, y0 = c2.y1 + 8 * k, x1 = g + 96 * k, y1 = c2.y1 + 42 * k};
      v = hud_button(s, out, v, BTN_PDONE, c3, "DONE", 7.5 * k);
    }
  }
  // the station's spin
  sc := spin_clock(s[0].played, s[0].spin_every);
  if s[0].phase != PHASE_OVER && sc > 0.0 {
    n = put(buf[..], 0, "SPIN-DOWN  ZERO-G  "); n = clock_text(buf[..], n, sc);
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y1 + 26 * k, 9 * k, ink(0.6 * k, 1, 2 * k, 0.6, 0.95, 1.0));
  } else if s[0].phase == PHASE_PLAY && sc > -6.0 {
    n = put(buf[..], 0, "SPIN-DOWN IN "); n = put_int(buf[..], n, cast(int) ceil_d(-sc));
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y1 + 26 * k, 9 * k, white(k, 0.85));
  }
  // the middle: the countdown, a goal, the end
  if s[0].phase == PHASE_KICKOFF && s[0].phase_t < 0.0 {
    v = centred(d, out, v, "FINDING PLAYERS", w * 0.5, h * 0.3, 16 * k, white(k * 1.4, 1));
    n = put_int(buf[..], 0, cast(int) ceil_d(-s[0].phase_t));
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, h * 0.3 + 34 * k, 11 * k, white(k, 0.8));
  } else if s[0].phase == PHASE_KICKOFF {
    left := cast(int) ceil_d(KICKOFF - s[0].phase_t);
    n = put_int(buf[..], 0, left);
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, h * 0.3, 52 * k, ink(1.5 * k, 1, 4 * k, PARCH_R, PARCH_G, PARCH_B));
  }
  if s[0].phase == PHASE_PLAY && s[0].phase_t < 0.8 && s[0].played < 1.0 + s[0].phase_t {
    v = centred(d, out, v, "GO", w * 0.5, h * 0.3, 52 * k, ink(1.5 * k, cast(f32) (1.0 - s[0].phase_t / 0.8), 4 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B));
  }
  if s[0].phase == PHASE_GOAL {
    v = centred(d, out, v, "GOAL", w * 0.5, h * 0.3, 52 * k, team_ink(s[0].last_goal, k * 2, 1));
    two := s[0].cars_n == CARS;
    v = centred(d, out, v, ifx s[0].last_goal == BLUE then (ifx two then "YOUR TEAM SCORED" else "YOU SCORED") else (ifx two then "THE BOTS SCORED" else "THE BOT SCORED"), w * 0.5, h * 0.3 + 34 * k, 11 * k, white(k * 1.4, 1));
  }
  if s[0].phase == PHASE_REPLAY || s[0].clip_play {
    v = centred(d, out, v, "REPLAY", w * 0.5, h * 0.18, 14 * k, team_ink(s[0].last_goal, k, 1));
    cb := Box.{x0 = w * 0.5 - 90 * k, y0 = h * 0.18 + 16 * k, x1 = w * 0.5 + 90 * k, y1 = h * 0.18 + 50 * k};
    copied := s[0].time - s[0].copied_t < 2.5;
    v = hud_button(s, out, v, BTN_CLIP, cb, ifx s[0].clip_play then "PLAY ORBIT LEAGUE" else ifx copied then "LINK COPIED" else "SAVE CLIP", 8 * k);
  }
  if s[0].online && s[0].sock_state != ROOM_IN {
    v = centred(d, out, v, room_connection_text(s), w * 0.5, h * 0.3 + 70 * k, 9 * k, white(k, 0.8));
  }
  if s[0].phase == PHASE_OVER {
    won := s[0].score[0] > s[0].score[1];
    two := s[0].cars_n == CARS;
    v = centred(d, out, v, ifx won then (ifx two then "YOUR TEAM WINS" else "YOU WIN") else (ifx two then "THE BOTS WIN" else "THE BOT WINS"), w * 0.5, h * 0.38, 26 * k, team_ink(ifx won then BLUE else MAGENTA, k, 1));
    ab := Box.{x0 = w * 0.5 - 90 * k, y0 = h * 0.38 + 24 * k, x1 = w * 0.5 + 90 * k, y1 = h * 0.38 + 66 * k};
    v = hud_button(s, out, v, BTN_AGAIN, ab, "PLAY AGAIN", 10 * k);
    db := Box.{x0 = ab.x0, y0 = ab.y1 + 12 * k, x1 = ab.x1, y1 = ab.y1 + 46 * k};
    v = hud_button(s, out, v, BTN_ARENA, db, ifx s[0].sphere then "PLAY IN THE BOX" else ifx s[0].drum then "PLAY IN THE SPHERE" else "PLAY IN THE DRUM", 8 * k);
    if !s[0].online {
      mb := Box.{x0 = db.x0, y0 = db.y1 + 10 * k, x1 = db.x1, y1 = db.y1 + 44 * k};
      v = hud_button(s, out, v, BTN_MODE, mb, ifx s[0].cars_n == CARS then "PLAY 1V1" else "PLAY 2V2", 8 * k);
      qb := Box.{x0 = db.x0, y0 = mb.y1 + 10 * k, x1 = db.x1, y1 = mb.y1 + 44 * k};
      v = hud_button(s, out, v, BTN_QUICK, qb, ifx s[0].cars_n == CARS then "QUICK MATCH 2V2" else "QUICK MATCH 1V1", 8 * k);
    }
  }
  // a clip only plays: none of the driving's controls
  if !s[0].clip_play && !(s[0].online && s[0].room_authority && s[0].sock_state==ROOM_LOST) {
  // boost, bottom right (above the buttons on a phone)
  fuel := cast(f32) s[0].tanks[0].fuel;
  n = put_int(buf[..], 0, cast(int) fuel);
  thumbs := s[0].touch || phone;
  // a gauge: the tank as an arc round its number
  rr := 30 * k;
  gx := w - g - rr - 6 * k; gy := ifx thumbs then h - 2 * 46 * k - g - rr - 34 * k else h - g - rr - 8 * k;
  v = centred(d, out, v, cast(string) buf[0..<n], gx, gy + 6 * k, 15 * k, ink(0.6 * k, 1, 2 * k, 0.92, 0.95, 1.0));
  v = centred(d, out, v, "BOOST", gx, gy + 19 * k, 5.5 * k, white(k, 0.7));
  hot: f32 = ifx s[0].boosting[0] then 1.6 else 1.0;
  for q: 0..<ARC {
    a0 := 2.356 + cast(f32) q / ARC * 4.712; a1 := 2.356 + cast(f32) (q + 1) / ARC * 4.712;
    on := cast(f32) q < fuel / 100 * ARC;
    if lit(out, v, gx + cos(a0) * rr, gy + sin(a0) * rr, gx + cos(a1) * rr, gy + sin(a1) * rr,
           ifx on then 2.2 * k else 0.8 * k, ifx on then hot else 0.25, ifx on then 4 * k * hot else 1 * k,
           ifx on then 0.55 else 1, ifx on then 0.8 else 1, 1.0, MODE_STROKE) { v += 6; }
  }
  if thumbs {
    // the right thumb's buttons, and the left thumb's stick
    r := 46 * k;
    jb := Box.{x0 = w - g - 2 * r, y0 = h - g - 2 * r, x1 = w - g, y1 = h - g};
    v = hud_button(s, out, v, BTN_JUMP, jb, "JUMP", 9 * k);
    ob := Box.{x0 = jb.x0 - 2 * r - 12 * k, y0 = h - g - 1.6 * r, x1 = jb.x0 - 12 * k, y1 = h - g + 0.4 * r - 0.4 * r};
    v = hud_button(s, out, v, BTN_BOOST, ob, "BOOST", 9 * k);
    cb := Box.{x0 = w - g - 92 * k, y0 = sb.y1 + 40 * k, x1 = w - g, y1 = sb.y1 + 70 * k};
    v = hud_button(s, out, v, BTN_CAM, cb, ifx s[0].ball_cam then "CAR CAM" else "BALL CAM", 7 * k);
    if s[0].stick {
      cx := s[0].stick_x0; cy := s[0].stick_y0; reach := STICK * k;
      for q: 0..<24 {
        a0 := cast(f32) q / 24.0 * 6.2831853; a1 := cast(f32) (q + 1) / 24.0 * 6.2831853;
        if lit(out, v, cx + cos(a0) * reach, cy + sin(a0) * reach, cx + cos(a1) * reach, cy + sin(a1) * reach, 0.6 * k, 0.5, 1.5 * k, 1, 1, 1, MODE_STROKE) { v += 6; }
      }
      if tinted_dot(out, v, cx + s[0].stick_dx * reach, cy + s[0].stick_dy * reach, 14 * k, 0.9, 6 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B) { v += 6; }
    } else if s[0].played < 20 {
      v = centred(d, out, v, "DRAG HERE TO DRIVE", w * 0.25, h - 60 * k, 7.5 * k, white(k, 0.6));
    }
    // the maker's line: bottom left, beside BOOST
    v = maker_line(s, out, v, g, ob.x0 - 12 * k, h - g - 4 * k);
  } else {
    cb := Box.{x0 = w - g - 112 * k, y0 = g, x1 = w - g, y1 = g + 34 * k};
    v = hud_button(s, out, v, BTN_CAM, cb, ifx s[0].ball_cam then "CAR CAM  C" else "BALL CAM  C", 7.5 * k);
    if s[0].played < 25 && s[0].phase != PHASE_OVER {
      hint := "W S DRIVE   A D STEER   SPACE JUMP, AGAIN WITH W A S D TO FLIP   SHIFT BOOST";
      v = centred(d, out, v, hint, w * 0.5, h - 30 * k, lo(8 * k, (w - 2 * g) / hi(measure(hint, GAP, SPACE, false), 1)), white(k, 0.65));
    }
    // the maker's line: bottom middle, under the hint, clear of the boost gauge
    v = maker_line(s, out, v, g + 110 * k, w - g - 110 * k, h - 12 * k);
  }
  }
  // the ball, when it is off the screen: a marker at the edge toward it,
  // clear of the score and, on a phone, of the thumbs
  m := ball_marker(s, w, h, k, phone);
  if m.ok && tinted_dot(out, v, m.x, m.y, 7 * k, 1, 8 * k, 1, 1, 1) { v += 6; }
  return v;
}

// Where the off-screen ball's marker goes: from the screen's middle toward
// the ball (behind you: toward its side, along the bottom), to the edge of
// the space the HUD leaves.
Marker :: struct { x: f32; y: f32; ok: bool; }
ball_marker :: (s: [] OrbitLeague, w: f32, h: f32, k: f32, phone: bool) -> Marker {
  bp := s[0].bodies[BALL].pos;
  sp := seen(s, cast(f32) bp.x, cast(f32) bp.y, cast(f32) bp.z);
  if sp.ok && sp.x >= 0 && sp.x <= w && sp.y >= 0 && sp.y <= h { return Marker.{}; }
  x0 := 40 * k; x1 := w - 40 * k; y0 := 90 * k;
  y1 := ifx phone then h - 210 * k else h - 60 * k;
  cx := w * 0.5; cy := (y0 + y1) * 0.5;
  dx: f32; dy: f32;
  if sp.ok { dx = sp.x - cx; dy = sp.y - cy; }
  else {
    // behind the eye: its side on the screen's right, and down
    rx := cast(f32) bp.x - s[0].eye[0]; rz := cast(f32) bp.z - s[0].eye[2];
    side := rx * s[0].right[0] + rz * s[0].right[2];
    dx = ifx side > 0 then w else -w; dx *= 0.25; dy = h;
  }
  if abs(dx) < 0.001 && abs(dy) < 0.001 { dy = 1; }
  // scale the direction to the box's edge
  tx: f32 = ifx abs(dx) > 0.001 then (ifx dx > 0 then (x1 - cx) / dx else (x0 - cx) / dx) else 1000000;
  ty: f32 = ifx abs(dy) > 0.001 then (ifx dy > 0 then (y1 - cy) / dy else (y0 - cy) / dy) else 1000000;
  t := lo(tx, ty);
  return Marker.{x = clamp(cx + dx * t, x0, x1), y = clamp(cy + dy * t, y0, y1), ok = true};
}

// ---- the frame

put_car :: (u: [] f32, at: int, b: RigidBody, boost: bool, team: int, steer: f64, spin: f64) {
  x := rigid_axis(b, D3_X); y := rigid_axis(b, D3_Y); z := rigid_axis(b, D3_Z);
  u[at] = cast(f32) b.pos.x; u[at + 1] = cast(f32) b.pos.y; u[at + 2] = cast(f32) b.pos.z; u[at + 3] = ifx boost then 1.0f32 else 0.0f32;
  u[at + 4] = cast(f32) x.x; u[at + 5] = cast(f32) x.y; u[at + 6] = cast(f32) x.z; u[at + 7] = cast(f32) team;
  u[at + 8] = cast(f32) y.x; u[at + 9] = cast(f32) y.y; u[at + 10] = cast(f32) y.z; u[at + 11] = cast(f32) spin;
  u[at + 12] = cast(f32) z.x; u[at + 13] = cast(f32) z.y; u[at + 14] = cast(f32) z.z; u[at + 15] = cast(f32) steer;
}

game_frame :: (s: [] OrbitLeague, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  if s.count < 1 || u.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  if !s[0].started { game_reset(s); }
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = still;
  // the time outside the steps moves by what the physics clock counts the frame for
  step := cast(f32) loop_counts(s[0].sim, cast(f64) dt);
  if !s[0].golden { s[0].time += step; }
  s[0].replays = !s[0].golden && !s[0].online;
  game_step(s, cast(f64) dt);
  room_frame(s, cast(f64) step);
  if !s[0].golden { effects_step(s, cast(f64) step); }
  if s[0].jumped[0] { s[0].jumped[0] = false; track_tally(s[0].track[..], "jump", ""); }
  camera(s, step);
  view_rows(s);
  s[0].plate_n = 0;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  s[0].tip_shown = false;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = ifx still || s[0].golden then 20.0f32 else s[0].time;
  u[3] = 1; u[4] = ifx still || s[0].golden then 1.0f32 else 0.0f32; u[6] = s[0].dpr;
  u[7] = cast(f32) (1.0 - s[0].spin_now);
  for i: 0..<16 { u[VIEW_AT + i] = s[0].view[i]; }
  for i: 0..<3 { u[EYE_AT + i] = s[0].eye[i]; u[FWD_AT + i] = s[0].fwd[i]; u[RX_AT + i] = s[0].right[i]; u[UY_AT + i] = s[0].up[i]; }
  // the goal's flash: its share, then the team
  if s[0].phase == PHASE_GOAL { u[EYE_AT + 3] = cast(f32) fmax(0.0, 1.0 - s[0].phase_t / 1.5); u[FWD_AT + 3] = cast(f32) s[0].last_goal; }
  bl := s[0].bodies[BALL];
  bl.pos = d3_add(bl.pos, s[0].ball_err);
  u[BALL_AT] = cast(f32) bl.pos.x; u[BALL_AT + 1] = cast(f32) bl.pos.y; u[BALL_AT + 2] = cast(f32) bl.pos.z; u[BALL_AT + 3] = cast(f32) BALL_R;
  q := bl.orientation;
  u[MISC_AT] = cast(f32) d3_len(bl.vel);
  u[BALLQ_AT] = cast(f32) q.x; u[BALLQ_AT + 1] = cast(f32) q.y; u[BALLQ_AT + 2] = cast(f32) q.z; u[BALLQ_AT + 3] = cast(f32) q.w;
  s[0].paints[0] = s[0].paint;
  put_car(u, CAR_AT, s[0].bodies[YOU], s[0].boosting[0], BLUE + 2 * s[0].paints[0], s[0].cars[0].steer_now, s[0].wheel_spin[0]);
  put_car(u, CAR_AT + CAR_FLOATS, room_other(s), s[0].boosting[1], MAGENTA + 2 * s[0].paints[1], s[0].cars[1].steer_now, s[0].wheel_spin[1]);
  for c: 2..<CARS { put_car(u, CARS2_AT + (c - 2) * CAR_FLOATS, s[0].bodies[c + 1], s[0].boosting[c], c % 2 + 2 * s[0].paints[c], s[0].cars[c].steer_now, s[0].wheel_spin[c]); }
  u[MISC_AT + 1] = cast(f32) s[0].cars_n;
  u[ARENA_AT] = cast(f32) ARENA_HX; u[ARENA_AT + 1] = cast(f32) ARENA_HZ; u[ARENA_AT + 2] = cast(f32) ARENA_H; u[ARENA_AT + 3] = cast(f32) GOAL_HW;
  u[GOAL_AT] = cast(f32) GOAL_H; u[GOAL_AT + 1] = cast(f32) GOAL_D; u[GOAL_AT + 2] = ifx s[0].sphere then cast(f32) -SPHERE_R else ifx s[0].drum then cast(f32) DRUM_R else 0;
  u[GOAL_AT + 3] = cast(f32) SPHERE_GOAL_R;
  put_trail(u, TRAIL_AT, bl.pos, ball_glow(s), s[0].ball_trail[..], s[0].ball_k[..], 0);
  for c: 0..<2 {
    put_trail(u, TRAIL_AT + (c + 1) * (TRAIL_N + 1) * 4, nozzle(s[0].bodies[c + 1]), ifx s[0].boosting[c] then 1.0 else 0.0,
              s[0].boost_trail[..], s[0].boost_k[..], c * TRAIL_N);
  }
  u[BLAST_AT] = cast(f32) s[0].blast.x; u[BLAST_AT + 1] = cast(f32) s[0].blast.y; u[BLAST_AT + 2] = cast(f32) s[0].blast.z;
  u[BLAST_AT + 3] = cast(f32) s[0].blast_t; u[BLAST_AT + 4] = cast(f32) s[0].blast_team;
  for i: 0..<PADS {
    p := pad_at(i); o := PADS_AT + i * 4;
    u[o] = cast(f32) p.x; u[o + 1] = cast(f32) (ifx s[0].sphere then p.z * SPHERE_PAD_Z else p.z); u[o + 2] = cast(f32) p.y; u[o + 3] = cast(f32) (1.0 - s[0].pad_wait[i] / pad_wait_of(i));
  }
  n := ifx s[0].card then draw_sparks(s, out, 0) else draw_hud(s, out);
  u[5] = cast(f32) s[0].plate_n;
  for i: 0..<s[0].plate_n {
    o := PANEL_AT + i * 8; b := s[0].plates[i];
    u[o] = b.x0; u[o + 1] = b.y0; u[o + 2] = b.x1; u[o + 3] = b.y1;
    u[o + 4] = s[0].dpr; u[o + 5] = s[0].plate_alpha[i]; u[o + 6] = s[0].plate_look[i]; u[o + 7] = 0;
  }
  if n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  track_frame(s[0].track[..], dt, width, height, dpr);
  return n;
}

#test "Orbit observations expose accepted snapshot state without changing it" {
  s:[1]OrbitLeague;s[0].room_authority=true;s[0].room_tick=19;s[0].room_generation=SeatGeneration.{value=7};s[0].room_ack=11;s[0].room_seq=13;
  s[0].seat=0;s[0].word[1].pos=d3(1.25,2.5,-3.75);s[0].bodies[1].pos=d3(1.5,2.5,-3.75);s[0].room_present[0]=true;
  #assert game_probe(s[..],0)==1 && game_probe(s[..],1)==19 && game_probe(s[..],2)==7;
  #assert game_probe(s[..],3)==11 && game_probe(s[..],4)==13 && game_probe(s[..],111)==1250;
  #assert game_probe(s[..],112)==2500 && game_probe(s[..],113)== -3750;
  #assert game_probe(s[..],110)==1 && game_probe(s[..],120)==0 && game_probe(s[..],-1)==-1;
  #assert game_probe(s[..],211)==1500 && game_probe(s[..],213)== -3750 && game_probe(s[..],10)==0 && game_probe(s[..],11)==0;
}
// Read-only scalar observations, shared by page diagnostics and headless qualification.
game_probe :: (s:[]OrbitLeague,field:int)->int #export_c #effects(all) {
  if field==0 {return ifx s[0].room_authority then 1 else 0;}
  if field==1 {return s[0].room_tick;}if field==2 {return s[0].room_generation.value;}
  if field==3 {return s[0].room_ack;}if field==4 {return s[0].room_seq;}
  if field==5 {return s[0].seat;}if field==6 {return s[0].phase;}
  if field==7 {return s[0].score[0];}if field==8 {return s[0].score[1];}
  if field>=100 && field<150 {
    row:=(field-100)/10;part:=(field-100)%10;
    if part==0 {
      if row==0 {return ifx s[0].room_tick>=0 then 1 else 0;}
      for c:0..<ROOM_PLAYERS {
        slot:=ifx c==s[0].seat then YOU else ifx c%2==s[0].seat%2 then MATE else ifx c<2 then BOT else RIVAL;
        if slot==row {return ifx s[0].room_present[c] then 1 else 0;}
      }
      return 0;
    }
    if part==1 {return cast(int)(s[0].word[row].pos.x*1000);}
    if part==2 {return cast(int)(s[0].word[row].pos.y*1000);}
    if part==3 {return cast(int)(s[0].word[row].pos.z*1000);}
  }
  // ol-predict: the controls that wait for the room, the re-runs that moved you and the farthest
  // (mm), the buffer's delay drawn (ms), and each body as drawn (200 + 10 * row + 1..3, mm)
  if field==10 {return net_predict_pending(s[0].pred[..]);}if field==11 {return s[0].reruns;}
  if field==12 {return s[0].fix_mm;}if field==13 {return cast(int)s[0].jit_lag;}
  if field>=200 && field<250 {
    row:=(field-200)/10;part:=(field-200)%10;
    if part==1 {return cast(int)(s[0].bodies[row].pos.x*1000);}
    if part==2 {return cast(int)(s[0].bodies[row].pos.y*1000);}
    if part==3 {return cast(int)(s[0].bodies[row].pos.z*1000);}
  }
  return -1;
}
coaxial_orbitleague_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_orbitleague_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_orbitleague_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }

// ---- checks

run_for :: (s: [] OrbitLeague, seconds: f64) {
  steps := cast(int) (seconds / STEP);
  for i: 0..<steps { game_step(s, STEP); }
}

#test "kickoff counts down, then you drive and boost toward the ball" #steps 60000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].width = 1440; s[0].height = 900; s[0].dpr = 1;
  run_for(s[..], 1.0);
  #assert s[0].phase == PHASE_KICKOFF && s[0].cars[0].wheels == 4;
  z0 := s[0].bodies[YOU].pos.z;
  run_for(s[..], 2.1);
  #assert s[0].phase == PHASE_PLAY;
  s[0].held = HOLD_UP | HOLD_BOOST;
  run_for(s[..], 1.0);
  #assert s[0].bodies[YOU].pos.z > z0 + 8.0 && s[0].tanks[0].fuel < BOOST_START + PAD_SMALL - 10.0;
}

#test "driving into the ball moves it; a ball past the line scores and kicks off again" #steps 130000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].held = HOLD_UP;
  run_for(s[..], 3.0);
  #assert d3_len(s[0].bodies[BALL].vel) > 1.0 || abs(s[0].bodies[BALL].pos.z) > 1.0;
  // put the ball in the bot's net
  s[0].bodies[BALL].pos = d3(0.0, 2.0, ARENA_HZ + 1.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 10.0);
  run_for(s[..], 0.5);
  #assert s[0].score[0] == 1 && s[0].phase == PHASE_GOAL;
  // the net holds it
  #assert s[0].bodies[BALL].pos.z < ARENA_HZ + GOAL_D;
  run_for(s[..], CELEBRATE);
  #assert s[0].phase == PHASE_KICKOFF && abs(s[0].bodies[BALL].pos.z) < 0.01;
}

#test "a ball hit at the wall beside the goal bounces back; the roof and walls hold it" #steps 80000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[BALL].pos = d3(15.0, 3.0, 30.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 40.0);
  run_for(s[..], 1.0);
  #assert s[0].score[0] == 0 && s[0].bodies[BALL].vel.z < 0.0;
  s[0].bodies[BALL].pos = d3(0.0, 10.0, 0.0);
  s[0].bodies[BALL].vel = d3(30.0, 30.0, 0.0);
  run_for(s[..], 2.0);
  p := s[0].bodies[BALL].pos;
  #assert abs(p.x) < ARENA_HX && p.y < ARENA_H && p.y > 0.0;
}

#test "a goal sets off its blast and sparks, a hard hit throws sparks, and both die away" #steps 130000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[BALL].pos = d3(0.0, 2.0, ARENA_HZ + 1.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 10.0);
  run_for(s[..], 0.1);
  #assert s[0].blast_t >= 0.0 && s[0].blast_team == BLUE && s[0].shake > 0.5;
  alive := 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert alive >= 90;
  for i: 0..<cast(int) ((BLAST_LIFE + 0.1) / STEP) { effects_step(s[..], STEP); }
  alive = 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert s[0].blast_t < 0.0 && alive == 0 && s[0].shake < 0.01;
  // a car at speed into the ball
  run_for(s[..], CELEBRATE + KICKOFF + 0.1);
  s[0].bodies[YOU].pos = d3(0.0, 1.0, -4.0); s[0].bodies[YOU].vel = d3(0.0, 0.0, 20.0);
  run_for(s[..], 0.3);
  alive = 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert alive > 0;
}

#test "a car over a ready pad takes its boost; the pad waits, then is ready again" #steps 160000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].no_bot = true;
  p := pad_at(0);
  s[0].tanks[0].fuel = 10.0;
  s[0].bodies[YOU].pos = d3(p.x, 0.9, p.z);
  run_for(s[..], 0.1);
  #assert s[0].tanks[0].fuel > 99.0 && s[0].pad_wait[0] > PAD_BIG_WAIT - 0.5 && s[0].pads_taken == 1;
  q := pad_at(8);
  s[0].tanks[0].fuel = 10.0;
  s[0].bodies[YOU].pos = d3(q.x, 0.9, q.z); s[0].bodies[YOU].vel = D3_ZERO;
  run_for(s[..], 0.1);
  #assert s[0].tanks[0].fuel > 21.0 && s[0].tanks[0].fuel < 30.0;
  s[0].tanks[0].fuel = 100.0;
  run_for(s[..], PAD_BIG_WAIT);
  #assert s[0].pad_wait[0] == 0.0 && s[0].pad_wait[8] == 0.0;
  // all sixteen in the arena, apart
  for i: 0..<PADS {
    a := pad_at(i);
    #assert abs(a.x) < ARENA_HX - 2.0 && abs(a.z) < ARENA_HZ - 2.0;
    for j: i + 1..<PADS { #assert d3_len(d3(a.x - pad_at(j).x, 0.0, a.z - pad_at(j).z)) > 5.0; }
  }
}

#test "the station spins down at 90 s for 15 s, at 60 s with ?spin=60, never with ?spin=off; half spin is 0.4 g; every tank fills as it starts (ol-spin-down)" {
  #assert spin_share(10.0, 90.0) == 1.0 && spin_share(89.9, 90.0) == 1.0;
  #assert near_d(spin_share(91.0, 90.0), 0.5, 0.000001);
  #assert spin_share(97.0, 90.0) == 0.0 && spin_share(104.0, 90.0) > 0.4 && spin_share(105.5, 90.0) == 1.0;
  #assert near_d(spin_clock(97.0, 90.0), 8.0, 0.000001) && near_d(spin_clock(80.0, 90.0), -10.0, 0.000001);
  // the second one: 90 s more at spin
  #assert spin_share(180.0, 90.0) == 1.0 && spin_share(200.0, 90.0) == 0.0;
  #assert spin_share(67.0, 60.0) == 0.0 && spin_share(67.0, 90.0) == 1.0;
  #assert spin_share(97.0, 0.0) == 1.0 && spin_clock(97.0, 0.0) < -1000.0;
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/worlds/orbit-league?spin=60\n");
  #assert s[0].spin_every == 60.0;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/worlds/orbit-league?spin=off\n");
  #assert s[0].spin_every == 0.0;
  t: [1] OrbitLeague;
  game_message(t[..], HOST_FACTS, "url=https://openagents.com/worlds/orbit-league?spin=half\n");
  t[0].phase = PHASE_PLAY; t[0].played = 10.0; set_spin(t[..]);
  #assert t[0].spin_every == SPIN_EVERY && near_d(t[0].field.scale, HALF_SPIN, 0.000001) && t[0].spin_now == 1.0;
  // the tanks fill as the spin-down starts
  u: [1] OrbitLeague;
  game_reset(u[..]);
  u[0].tanks[0].fuel = 5.0; u[0].tanks[1].fuel = 20.0;
  u[0].played = 90.0 - 0.5 * STEP; set_spin(u[..]);
  #assert u[0].tanks[0].fuel == 5.0;
  u[0].played = 90.0 + 0.5 * STEP; set_spin(u[..]);
  #assert u[0].tanks[0].fuel == 100.0 && u[0].tanks[1].fuel == 100.0;
}

#test "a kickoff while you sit still doesn't fly the ball into your goal" #steps 90000000 {
  s: [1] OrbitLeague;
