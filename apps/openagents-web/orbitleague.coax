  t := 0.0;
  while t < 6.0 && s[0].score[MAGENTA] == 0 { run_for(s[..], 0.25); t += 0.25; }
  #assert s[0].score[MAGENTA] >= 1;
}

// ---- 1v1 and 2v2 (ol-bot-modes)

#test "?mode=2v2 puts you and a blue bot against two magenta bots, a phone plays 2v2 unless told, and the room stays 1v1 (ol-bot-modes)" {
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/worlds/orbit-league?mode=2v2\n");
  #assert s[0].cars_n == CARS;
  for c: 0..<CARS {
    b := s[0].bodies[c + 1];
    // each on its own team's half, on its wheels, facing the other end
    side := ifx c % 2 == 0 then -1.0 else 1.0;
    #assert b.pos.z * side > 10.0 && near_d(b.pos.y, 1.0, 0.01) && rigid_axis(b, D3_Z).z * side < -0.99;
  }
  p: [1] OrbitLeague;
  game_message(p[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/worlds/orbit-league\n");
  #assert p[0].cars_n == CARS;
  q: [1] OrbitLeague;
  game_message(q[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/worlds/orbit-league?mode=1v1\n");
  #assert q[0].cars_n == 2 && q[0].bodies[MATE].pos.y < -100.0;
  r: [1] OrbitLeague;
  game_message(r[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/worlds/orbit-league?room=a\n");
  #assert r[0].cars_n == 2;
}
#test "in a 2v2 all three bots drive after the kickoff, the one of a pair further from the ball hangs back, and PLAY 1V1 / PLAY 2V2 switch (ol-bot-modes)" #steps 110000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]); set_mode(s[..], CARS);
  run_for(s[..], KICKOFF + 1.5);
  for c: 1..<CARS { #assert d3_len(s[0].bodies[c + 1].vel) > 3.0; }
  // the magenta pair: the one further from the ball goes back toward +z
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 0.0); s[0].bodies[BALL].vel = D3_ZERO;
  s[0].bodies[BOT].pos = d3(0.0, 1.0, 6.0); s[0].bodies[RIVAL].pos = d3(0.0, 1.0, -10.0);
  s[0].bodies[RIVAL].orientation = dq_y(PI_D);
  d := bot_drive(s[..], 3);
  // facing -z with its target behind it (+z): it turns or backs off, never drives on at the ball
  #assert abs(d.input.steer) > 0.5 || d.input.throttle < 0.0;
  set_mode(s[..], 2);
  #assert s[0].cars_n == 2 && s[0].bodies[RIVAL].pos.y < -100.0 && s[0].phase == PHASE_KICKOFF;
}

// ---- goal replays (ol-replay)

#test "a goal's replay plays its recorded drives through the same physics and ends with the ball where the goal left it (ol-replay)" #steps 280000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].replays = true; s[0].no_bot = true; kickoff(s[..]);
  // in the countdown the ball is set rolling slowly at +z; you drive round
  // in circles, boosting, and bump into it now and then
  run_for(s[..], KICKOFF - 0.2);
  s[0].bodies[BALL].pos = d3(1.0, BALL_R, -20.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 9.5);
  s[0].held = HOLD_UP | HOLD_RIGHT | HOLD_BOOST;
  t := 0.0;
  while t < 12.0 && s[0].phase != PHASE_GOAL { run_for(s[..], STEP); t += STEP; }
  #assert s[0].phase == PHASE_GOAL && s[0].score[BLUE] == 1;
  at := s[0].bodies[BALL].pos; g := s[0].rec_n; touches := s[0].touches;
  #assert g > KEY_EVERY * 2;
  run_for(s[..], CELEBRATE + STEP);
  #assert s[0].phase == PHASE_REPLAY && s[0].rp_end == g && s[0].rp_step == imax(0, g - cast(int) (REPLAY_SECONDS / STEP)) + 1;
  while s[0].phase == PHASE_REPLAY { run_for(s[..], STEP); }
  #assert d3_dist(s[0].rp_ball, at) < 0.000001 && s[0].phase == PHASE_KICKOFF && s[0].score[BLUE] == 1 && s[0].touches == touches;
}
#test "a key or a tap skips the replay to the kickoff; tests and the room skip replays (ol-replay)" #steps 200000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].replays = true;
  run_for(s[..], KICKOFF + 1.0);
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 38.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 20.0);
  run_for(s[..], 0.5);
  #assert s[0].phase == PHASE_GOAL;
  run_for(s[..], CELEBRATE + 0.2);
  #assert s[0].phase == PHASE_REPLAY;
  took := game_key(s[..], 'x', 0);
  #assert s[0].phase == PHASE_KICKOFF;
  q: [1] OrbitLeague;
  game_reset(q[..]);
  run_for(q[..], KICKOFF + 1.0);
  q[0].bodies[BALL].pos = d3(0.0, BALL_R, 38.0); q[0].bodies[BALL].vel = d3(0.0, 0.0, 20.0);
  run_for(q[..], 0.5 + CELEBRATE + 0.2);
  #assert q[0].phase == PHASE_KICKOFF;
}

// ---- clips (ol-clips)

#test "a clip's numbers come back exactly, and a bad link is no clip (ol-clips)" {
  buf: [256] u8;
  xs: [7] f64; xs[0] = 0.0; xs[1] = 1.0; xs[2] = -0.1; xs[3] = 123456.789012345; xs[4] = 0.000000123; xs[5] = -9.81; xs[6] = 1.0 / 3.0;
  k := 0;
  for i: 0..<7 { k = clip_num(buf[..], k, xs[i]); }
  k = clip_int(buf[..], k, -12345);
  at: [1] int; ok: [1] bool; ok[0] = true;
  for i: 0..<7 { #assert clip_read_num(cast(string) buf[0..<k], at[..], ok[..]) == xs[i]; }
  #assert clip_read_int(cast(string) buf[0..<k], at[..], ok[..]) == -12345 && ok[0] && at[0] == k;
  s: [1] OrbitLeague; game_reset(s[..]);
  #assert !clip_open(s[..], "https://openagents.com/worlds/orbit-league/#clip=o1ABC") && !s[0].clip_play;
}
#test "a saved clip's link plays the same replay in another game: your drives as recorded, the bot deciding again, the ball into the same goal (ol-clips)" #steps 300000000 {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].replays = true; kickoff(s[..]);
  run_for(s[..], KICKOFF - 0.2);
  s[0].bodies[BALL].pos = d3(1.0, BALL_R, -20.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 9.5);
  s[0].held = HOLD_UP | HOLD_RIGHT | HOLD_BOOST;
  t := 0.0;
  while t < 40.0 && s[0].phase != PHASE_GOAL { run_for(s[..], STEP); t += STEP; }
  #assert s[0].phase == PHASE_GOAL;
  at := s[0].bodies[BALL].pos;
  run_for(s[..], CELEBRATE + STEP);
  #assert s[0].phase == PHASE_REPLAY;
  link: [OUTBOX] u8;
  k := put(link[..], 0, "https://openagents.com/worlds/orbit-league/#clip=");
  n := clip_write(s[..], link[k..<OUTBOX]);
  #assert n > 0 && k + n < OUTBOX;
  q: [1] OrbitLeague; game_reset(q[..]);
  #assert clip_open(q[..], cast(string) link[0..<k + n]) && q[0].clip_play;
  while q[0].rp_step < q[0].rp_end { clip_step(q[..]); }
  #assert d3_dist(q[0].bodies[BALL].pos, at) < 0.000001;
  // it plays again from its start
  for i: 0..<cast(int) (1.6 / STEP) { clip_step(q[..]); }
  #assert q[0].rp_step >= q[0].clip_skip && q[0].rp_step <= q[0].clip_skip + cast(int) (0.1 / STEP) + 2;
}

// ---- paint (ol-paint)

#test "PAINT picks a colour and a decal, keeps them in this browser and draws them on your car; the kept paint comes back (ol-paint)" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  paint_set(s[..], (s[0].paint % PAINT_COLOURS + 1) % PAINT_COLOURS);
  #assert s[0].paint == 1 && s[0].action == ACT_KEEP && cast(string) s[0].outbox[0..<s[0].out_n] == "paint 1";
  s[0].action = 0;
  paint_set(s[..], s[0].paint % PAINT_COLOURS + ((s[0].paint / PAINT_COLOURS + 1) % PAINT_DECALS) * PAINT_COLOURS);
  #assert s[0].paint == 9 && paint_name(s[0].paint) == "WHITE" && decal_name(s[0].paint) == "STRIPES";
  u: [UNIFORM_FLOATS] f32; out: [65536] f32;
  n := game_frame(s[..], out[..], u[..], 1280, 720, 1, 0.016, false);
  #assert u[CAR_AT + 7] == 18.0;
  q: [1] OrbitLeague; game_reset(q[..]);
  game_message(q[..], HOST_KEPT, "paint 26");
  #assert q[0].paint == 26;
  game_message(q[..], HOST_KEPT, "paint 999");
  #assert q[0].paint == 26;
}

#test "a page's state starts zeroed, and game_reset gives every defaulted field its default: gravity, the bot, its miss (the face runs no initialisers)" #steps 50000000 {
  s: [1] OrbitLeague;
  // zeroed, as the browser's memory is
  s[0].copied_t = 0.0; s[0].cars_n = 0; s[0].bot_miss_k = 0.0; s[0].bot_path_at = 0.0; s[0].bot_path_goal = 0;
  s[0].spin_every = 0.0; s[0].spin_g = 0.0; s[0].spin_now = 0.0; s[0].sock = 0; s[0].oth_gap = 0.0;
  game_reset(s[..]);
  d: [1] OrbitLeague;
  #assert s[0].copied_t == d[0].copied_t && s[0].cars_n == d[0].cars_n && s[0].bot_miss_k == d[0].bot_miss_k;
  #assert s[0].bot_path_at == d[0].bot_path_at && s[0].bot_path_goal == d[0].bot_path_goal;
  #assert s[0].spin_every == d[0].spin_every && s[0].spin_g == d[0].spin_g && s[0].spin_now == d[0].spin_now;
  #assert s[0].sock == d[0].sock && s[0].oth_gap == d[0].oth_gap;
  // and the ball falls
  run_for(s[..], KICKOFF + 0.5);
  s[0].bodies[BALL].pos = d3(0.0, 6.0, 10.0); s[0].bodies[BALL].vel = D3_ZERO;
  run_for(s[..], 0.5);
  #assert s[0].bodies[BALL].pos.y < 5.0;
}

// ---------------------------------------------------------------------------------------------
// The frame budget (metaverse-engine/core/budget.coax, book chapter 16): what one frame of Orbit League may use.
// The vertex limit is under the vertex buffer, so a frame its writers clip fails the check.
ORBITLEAGUE_BUDGET :: FrameBudget.{steps = 8, vertices = 5000, draws = 0, bytes = 2031616};

// A match from its kickoff: three frames at each budget screen, the last one 0.1 s long. Book
// chapter 16 gives the peaks of 120 frames at each screen, measured natively.
#test "Orbit League's frames fit its declared budget" {
  #assert budget_declared(ORBITLEAGUE_BUDGET, MAX_VERTICES) == BUDGET_NONE;
  frames := 3;
  m := [1] BudgetMeter.[budget_meter(ORBITLEAGUE_BUDGET)];
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  bytes := budget_arena_bytes(size_of(OrbitLeague), MAX_VERTICES, VERTEX_FLOATS, UNIFORM_FLOATS);
  for i: 0..<BUDGET_SCREENS {
    s: [1] OrbitLeague;
    sc := budget_screen(i);
    for f: 0..<frames {
      dt := ifx f < frames - 1 then 1.0f32 / 60.0 else 0.1f32;
      n := game_frame(s[..], out[..], u[..], sc.width, sc.height, sc.dpr, dt, false);
      budget_measure(m[..], n, 0, bytes);
      #assert budget_take(m[..], BUDGET_STEPS, s[0].sim.ran);
    }
    // a 3 s stall runs the budget's 8 steps of 1/120 s and drops the rest
    n := game_frame(s[..], out[..], u[..], sc.width, sc.height, sc.dpr, 3.0, false);
    budget_measure(m[..], n, 0, bytes);
    #assert budget_take(m[..], BUDGET_STEPS, s[0].sim.ran) && s[0].sim.ran == 8 && s[0].sim.stalls == 2;   // the 0.1 s frame owed 12 too
  }
  #assert budget_ok(m[0]) && m[0].peak[BUDGET_STEPS] == ORBITLEAGUE_BUDGET.steps;
  // the time outside the steps is what the clock counts: a stall, the 8 steps it runs and the part
  // of a step it keeps (0.1 s less the four steps dropped)
  c: FrameClock = FrameClock.{step_ns = STEP_NS, max_frame_ns = MAX_FRAME_NS, max_steps = MAX_STEPS};
  #assert loop_counts(c, 3.0) == 0.066666668 && loop_counts(c, 0.05) == 0.05 && loop_counts(c, -1.0) == 0;
}
