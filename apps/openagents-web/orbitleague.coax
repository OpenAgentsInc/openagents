// Orbit League (docs/verse/game-ideas/orbit-league.md): electric roadsters
// playing ball in a glass arena in orbit. This file is the game's rules and
// its drawing only; the physics is the engine's space primitives
// (docs/verse/space.md): verse/vehicle.coax drives the cars, verse/contact.coax
// answers every touch, verse/gravity.coax says which way is down, and
// verse/thrust.coax burns the boost.
//
// The first playable: you (blue) against one bot (magenta), a five-minute
// match, a goal at each end of a flat box arena. Every 90 seconds of play the
// station spins down: gravity fades to nothing for half a minute, then
// comes back. W/S (or the arrows) drive, A/D steer, Space jumps (twice),
// Shift boosts, C is ball cam, Escape goes back to the galaxy. On a phone
// the left thumb steers and drives; JUMP and BOOST are on the right.
// ?stage=highlight plays a staged goal for clips (docs/verse/clips.md).
// ?arena=drum (or PLAY IN THE DRUM when a match ends) plays inside a spinning drum
// (verse/drum.coax): the floor curves up into the walls and over into the
// ceiling, the spin holds you to all of it, and the goals sit at the foot of
// each end wall.
//
// orbitleague.wgsl traces the arena, the cars, the ball and the space round
// them from the uniforms written here; the HUD is strokes over it.
//   coax/bin/coax test apps/openagents-web/orbitleague.coax --steps 2000000000

#load "font.coax";
#load "ui.coax";
#load "analytics.coax";
#load "../../verse/vehicle.coax";
#load "../../verse/gravity.coax";
#load "../../verse/thrust.coax";
#load "../../verse/drum.coax";
#load "../../verse/sphere.coax";
#load "socket.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, 0, 0, 0, 0
MAX_VERTICES :: 24000;
PLATES :: 16;
MODE_STROKE :: 0.0;
MODE_BAR :: 4.0;   // ui.coax's

// The uniforms (orbitleague.wgsl's U): width, height, time, fade, still,
// plates, dpr, zero-g share; the view's rows; the eye and the screen's rays;
// the ball; each car's place and axes; the arena; the plates.
VIEW_AT :: 8; EYE_AT :: 24; FWD_AT :: 28; RX_AT :: 32; UY_AT :: 36;
BALL_AT :: 40; BALLQ_AT :: 44; CAR_AT :: 48; CAR_FLOATS :: 16; ARENA_AT :: 80; GOAL_AT :: 84; MISC_AT :: 88;
PANEL_AT :: 92;
// then the trails (the ball's, then each car's boost): a bound (centre,
// radius; radius < 0 none) and TRAIL_N points (place, strength) each; then
// the goal's blast (centre, age; team)
TRAIL_N :: 8;
TRAIL_AT :: PANEL_AT + PLATES * 8;
BLAST_AT :: TRAIL_AT + 3 * (TRAIL_N + 1) * 4;
PADS_AT :: BLAST_AT + 8;     // each boost pad: x, z, big (1) or small (0), how ready (1 ready)
CARS2_AT :: PADS_AT + PADS * 4;   // a 2v2's other two cars, as CAR_AT's
UNIFORM_FLOATS :: CARS2_AT + 2 * CAR_FLOATS;

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow (droprealm.coax's).
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// ---- the game's numbers

ARENA_HX :: 25.0;        // half its width (x), metres
ARENA_HZ :: 40.0;        // half its length (z): the goal lines
ARENA_H :: 18.0;         // the glass roof
GOAL_HW :: 7.0;          // half the mouth's width
GOAL_H :: 6.5;           // the crossbar
GOAL_D :: 6.0;           // how deep the net goes
WALL :: 2.0;             // the end walls' and nets' thickness (the ball's boxes)
BALL_R :: 1.4;
BALL_MASS :: 150.0;
BALL_DRAG :: 0.03;       // 1/s
BALL_MAX :: 32.0;        // m/s: no hit sends it faster
BOT_REACT :: 0.4;        // seconds the bot waits at a kickoff
BOT_KICKOFF_CALM :: 3.0; // and how long after it drives in without boost
BOT_RECOVER :: 1.5;      // seconds the bot coasts after it hits the ball before it chases again
BOT_THROTTLE :: 0.6;     // its share of the drive: slower than you without boost
BOT_BOOST_FAR :: 26.0;   // it boosts only from further than this
BOT_MISS :: 15.0;        // metres its aim misses by at kickoff, shrinking to BOT_MISS_LATE by full time
BOT_MISS_LATE :: 6.0;
// In the drum a miss wide still rolls down the curve toward the middle, and
// a beginner spends longer finding the ball on the curve: the bot drives
// slower there and waits longer after a hit (ol-drum-bot).
BOT_DRUM_THROTTLE :: 0.5;
BOT_DRUM_RECOVER :: 2.5;
BOT_PATH :: 30;          // ol-bot: the ball's path ahead, a sample every BOT_PATH_DT
BOT_PATH_DT :: 0.1;
BOT_LOOK :: 0.1;         // it looks again this often
BOT_DEFEND :: 0.35;      // defending, it waits this share of the way from its goal to the ball
bot_recover :: (s: [] OrbitLeague) -> f64 { return ifx s[0].drum then BOT_DRUM_RECOVER else BOT_RECOVER; }
STUCK_TIME :: 0.7;       // seconds a car lies tipped or leans on the glass, slow, before it is set back on its wheels
CAR_MASS :: 1000.0;
CAR_WALL_MU :: 0.05;     // the glass is slick: a car pressed into it slides along
PINNED_SPEED :: 2.0;     // m/s: slower than this against the glass, steering turns the car on the spot
PINNED_TURN :: 1.4;      // rad/s
SPAWN_Z :: 28.0;
FULL_SPIN_G :: G_EARTH;  // the station at full spin: 1 g toward the floor
MATCH_TIME :: 300.0;     // seconds
SPIN_EVERY :: 90.0;      // a spin-down starts after this many seconds at spin (?spin=60, ?spin=off)
SPIN_DOWN :: 15.0;       // and lasts this long: RAMP down, zero-g, RAMP up; every tank fills at its start
RAMP :: 2.0;
HALF_SPIN :: 0.4;        // ?spin=half: the station turns slower, 0.4 g
KICKOFF :: 3.0;          // the countdown
CELEBRATE :: 3.0;        // after a goal, before the next kickoff
BOOST_FORCE :: 12000.0;  // N
BOOST_RATE :: 33.0;      // of 100 a second at full boost
BOOST_START :: 34.0;
BOOST_REGEN :: 7.0;      // a second while the wheels touch
HIT_KICK :: 0.35;
HIT_FLATTEN :: 0.65;
HIT_SPIN :: 0.6;         // the share of the car's spin speed across the contact that the ball takes     // how much of the up-down part of a hit's line the kick drops (ol-hit-feel)        // the share of the closing speed added to the ball on a car's hit
STEP :: 0.008333333333333333;   // physics at 120 Hz
MAX_STEPS :: 12;
BLUE :: 0; MAGENTA :: 1;
PHASE_KICKOFF :: 0; PHASE_PLAY :: 1; PHASE_GOAL :: 2; PHASE_OVER :: 3; PHASE_REPLAY :: 4;
// ol-replay: each step's drives and a whole physics state each second, so a
// goal's last REPLAY_SECONDS play again through the same physics
REPLAY_SECONDS :: 5.0;
KEY_EVERY :: 120;        // steps between saved states (1 s)
REPLAY_KEYS :: 7;
REPLAY_STEPS :: 720;     // the drives kept: 6 s
BALL :: 0; YOU :: 1; BOT :: 2; MATE :: 3; RIVAL :: 4; BODIES :: 5;
// the cars: 0 you and 2 your mate are blue, 1 and 3 magenta (a car's team is
// c % 2); a 1v1 plays the first two, a 2v2 all four (ol-bot-modes)
CARS :: 4;
BOXES :: 12;
TRAIL_DT :: 0.04;        // seconds between a trail's points
SPARKS :: 128;
BLAST_LIFE :: 1.6;
// Boost pads on the floor: six big ones (a full tank) and ten small, each
// waiting a while after a car takes it.
PADS :: 16;
PAD_BIG :: 100.0; PAD_SMALL :: 12.0;
PAD_BIG_WAIT :: 10.0; PAD_SMALL_WAIT :: 4.0;
PAD_BIG_R :: 1.6; PAD_SMALL_R :: 1.1;
ARC :: 36;               // the boost gauge's segments
STICK :: 60.0;           // CSS pixels of thumb travel for full lock
CAM_BACK :: 9.5; CAM_UP :: 3.4; FOV :: 1.15;
ROOM_NAME :: 32;
ROOM_PLAYERS :: 4;
LAG_FRAMES :: 48;        // ?lag=MS: frames held each way (48 at 60 Hz: up to 800 ms)
LAG_BYTES :: 768;
PREDICT_MAX :: 72;       // the ball is replayed at most this many steps (0.6 s)
HIST :: 128;             // your car's last steps, for the replay
SMOOTH :: 0.12;          // a correction fades over about this many seconds
SNAP :: 6.0;             // a correction farther than this (a kickoff) is taken at once      // the most cars in a room
ROOM_HZ :: 60.0;        // the server's tick, and how often a player reports its car
ROOM_OFF :: 0; ROOM_JOINING :: 1; ROOM_IN :: 2; ROOM_LOST :: 3;
SPHERE_R :: 24.0;       // the sphere arena's radius (ol-sphere-arena): about the drum's floor area
SPHERE_GOAL_R :: 4.0;   // each pole's goal: the cap within this of the axis
SPHERE_SPAWN :: 14.0;   // metres round the curve from the lowest point that each car starts
SPHERE_PAD_Z :: 0.65;   // the pads' z, scaled to stay out of the goal caps
ARENA_BOX :: 0; ARENA_DRUM :: 1; ARENA_SPHERE :: 2;
DRUM_R :: 15.0;         // the drum arena's radius, metres; it is as long as the box
CAM_BALL_OFF :: 0.3;   // radians: the furthest ball cam puts the ball off centre to fit the car in

HOLD_UP :: 1; HOLD_DOWN :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8; HOLD_JUMP :: 16; HOLD_BOOST :: 32;
KEY_SHIFT :: -13;
OUTBOX :: 256;
HOST_FACTS :: 600;
MAKER_KIND :: 608;   // the realm's claimed maker's display name (coax/web/host.js, docs/verse/makers.md)
MAKER_BYTES :: 160;  // its 40 characters of UTF-8
BTN_BACK :: 0; BTN_JUMP :: 1; BTN_BOOST :: 2; BTN_CAM :: 3; BTN_AGAIN :: 4; BTN_ARENA :: 5; BTN_MODE :: 6; BTN_QUICK :: 7; BUTTONS :: 8;

SBox :: struct { c: D3; h: D3; }
// A spark: a short-lived streak of light (a hit's, a goal's).
Spark :: struct { p: D3; v: D3; life: f64; max: f64; red: f32; green: f32; blue: f32; size: f32; }

OrbitLeague :: struct {
  started: bool; golden: bool; still: bool; touch: bool;
  card: bool;   // ?card=1: the world without the HUD, for a link's card (coax/web/og-render.ts)
  time: f32; width: f32; height: f32; dpr: f32;
  bodies: [BODIES] RigidBody;
  cars: [CARS] VehicleState;
  tanks: [CARS] Tank;
  boosting: [CARS] bool;
  stuck_for: [CARS] f64;
  // ol-replay
  rp_keys: [REPLAY_KEYS] PhysState; rp_drives: [REPLAY_STEPS][CARS] Drive;
  rec_n: int;                 // steps recorded since this kickoff's play began
  replays: bool;              // a browser's game shows them (the tests and the simulator skip them)
  replaying: bool; rp_step: int; rp_end: int; rp_resume: PhysState; rp_ball: D3; rp_cut: int;
  cars_n: int = 2;            // 2: 1v1; 4: 2v2 (?mode=2v2, and a phone's default)
  mode_set: bool;             // ?mode= chose it
  boxes: [BOXES] SBox;
  field: GravityField;
  spec: VehicleSpec;
  phase: int; phase_t: f64; clock: f64; played: f64; overtime: bool;
  score: [2] int; last_goal: int; touches: int;
  carry: f64;                 // physics time not yet stepped
  held: int;
  ball_cam: bool;
  stick: bool; stick_id: int; stick_x0: f32; stick_y0: f32; stick_dx: f32; stick_dy: f32;
  button_id: [BUTTONS] int;   // the finger holding each button, -1 none
  hover: int;
  boxes_ui: [BUTTONS] Box; shown: [BUTTONS] bool;
  outbox: [OUTBOX] u8; out_n: int; action: int;
  // the maker's line, MADE BY <NAME> · TIP: the name (608), TIP's box and the finger on it
  maker: [MAKER_BYTES] u8; maker_n: int;
  tip_box: Box; tip_shown: bool; tip_down: bool; tip_id: int; tip_hover: bool;
  plates: [PLATES] Box; plate_look: [PLATES] f32; plate_alpha: [PLATES] f32; plate_n: int;
  // the camera, eased
  cam_eye: [3] f32; cam_at: [3] f32; cam_ready: bool;
  view: [16] f32; eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32;
  bot_jump_t: [CARS] f64;
  bot_touch_t: [CARS] f64;    // when each bot last hit the ball (played seconds)
  bot_aim: [CARS] f64;        // its aim's miss on this approach, metres across the goal
  bot_smart: bool;            // ?bot=pro: the bot reads the ball's path, meets it and defends (ol-bot); the default is the beginner's bot
  bot_miss_k: f64 = 1.0;      // its aim's miss, scaled (the pro misses less)
  bot_path: [BOT_PATH] D3; bot_path_at: f64 = -100.0; bot_path_goal: int = -1;   // ol-bot: where the ball goes, if no car touches it
  no_bot: bool;               // ?bot=0: practice alone
  drum: bool;                 // ?arena=drum: the drum, not the box
  sphere: bool;               // ?arena=sphere: the sphere (drum is then false)
  spin_every: f64 = SPIN_EVERY;   // seconds at spin between spin-downs; 0: never (ol-spin-down)
  spin_g: f64 = 1.0;              // the spin's gravity in g: 1, or HALF_SPIN
  spin_now: f64 = 1.0;            // the spin now, 0 to 1 (spin_share)
  // ?room=NAME: online (ol-room): the room server owns the ball, the clock and the score
  online: bool; room: [ROOM_NAME] u8; room_n: int; origin: [128] u8; origin_n: int;
  pipe: [1] Pipe; sock: int = -1; sock_open: bool; sock_state: int;   // ROOM_*
  seat: int; kicks: int; send_t: f64; heard: int;   // heard: server states taken
  // ol-prediction: the round trip, the ball's and the other car's smoothing,
  // and ?lag=MS's simulated latency (half each way)
  net_t: f64; rtt: f64; ball_err: D3;
  you_hist: [HIST] RigidBody; hist_n: int;
  oth_prev: RigidBody; oth_last: RigidBody; oth_at: f64; oth_gap: f64 = 1.0 / 60.0; oth_n: int;
  lag: f64; in_q: [LAG_FRAMES][LAG_BYTES] u8; in_len: [LAG_FRAMES] int; in_due: [LAG_FRAMES] f64; in_head: int; in_n: int;
  lag_oq: [LAG_FRAMES][256] u8; lag_olen: [LAG_FRAMES] int; lag_odue: [LAG_FRAMES] f64; lag_ohead: int; lag_on: int;
  cam_up: [3] f32;            // the camera's up, eased (the drum turns it)
  jumped: [2] bool;
  // the look: trails, sparks, the goal's blast, the camera's shake
  ball_trail: [TRAIL_N] D3; ball_k: [TRAIL_N] f64;
  boost_trail: [2 * TRAIL_N] D3; boost_k: [2 * TRAIL_N] f64;
  trail_t: f64;
  sparks: [SPARKS] Spark; spark_next: int; seed: f64;
  shake: f64;
  blast: D3; blast_t: f64; blast_team: int;
  sy: f32;
  pad_wait: [PADS] f64;
  wheel_spin: [CARS] f64;        // each car's wheels' turn, radians
  pads_taken: int;
  track: [1] Track;
  stage: int;                 // a staged moment (?stage=NAME) running: STAGE_*
}

// ---- the arena

arena_drum :: () -> Drum { return drum_on_floor(DRUM_R, ARENA_HZ); }
arena_sphere :: () -> Sphere { return sphere_on_floor(SPHERE_R); }
// The drum or the sphere: a curved floor that goes on round.
curved :: (s: [] OrbitLeague) -> bool { return s[0].drum || s[0].sphere; }
arena_kind :: (s: [] OrbitLeague) -> int { return ifx s[0].sphere then ARENA_SPHERE else ifx s[0].drum then ARENA_DRUM else ARENA_BOX; }
// Which way is up for something standing at p: the floor's, the drum's or the sphere's.
up_at :: (s: [] OrbitLeague, p: D3) -> D3 {
  if s[0].sphere { return sphere_up(arena_sphere(), p); }
  return ifx s[0].drum then drum_up(arena_drum(), p) else D3_Y;
}
// How far p is in from the floor under it (the curve's, or the box floor's).
clearance :: (s: [] OrbitLeague, p: D3) -> f64 {
  if s[0].sphere { return sphere_clearance(arena_sphere(), p); }
  return ifx s[0].drum then drum_clearance(arena_drum(), p) else p.y;
}
// The arena's half width and height.
arena_hx :: (s: [] OrbitLeague) -> f64 { return ifx s[0].sphere then SPHERE_R else ifx s[0].drum then DRUM_R else ARENA_HX; }
arena_h :: (s: [] OrbitLeague) -> f64 { return 2.0 * arena_hx(s) * (ifx curved(s) then 1.0 else ARENA_H / (2.0 * ARENA_HX)); }
// The sphere's goal line: a ball's centre past this z (toward a pole) is in.
sphere_goal_z :: () -> f64 { r := SPHERE_R - BALL_R; return sqrt(r * r - SPHERE_GOAL_R * SPHERE_GOAL_R); }
// The team that scored with the ball's centre at z: BLUE past +z's line, MAGENTA past -z's, or -1.
goal_past :: (s: [] OrbitLeague, z: f64) -> int {
  line := ifx s[0].sphere then sphere_goal_z() else ARENA_HZ + BALL_R;
  return ifx z > line then BLUE else ifx z < -line then MAGENTA else -1;
}
// Where the goal you attack (team BLUE: +z) or defend is, for the bot's aim.
goal_point :: (s: [] OrbitLeague, z_sign: f64) -> D3 {
  if s[0].sphere { return d3(0.0, SPHERE_R, z_sign * SPHERE_R); }
  return d3(0.0, 0.0, z_sign * (ARENA_HZ + 2.0));
}
// The point over the floor at floor coordinates (x, z), lift up, and its frame.
floor_point :: (s: [] OrbitLeague, x: f64, z: f64, lift: f64) -> D3 {
  if s[0].sphere { return sphere_at(arena_sphere(), x, z, lift); }
  if s[0].drum { return drum_turn(d3(0.0, lift, z), x / DRUM_R); }
  return d3(x, lift, z);
}
floor_turn :: (s: [] OrbitLeague, x: f64, z: f64) -> DQ {
  if s[0].sphere { return sphere_turn(arena_sphere(), x, z); }
  return ifx s[0].drum then dq_z(x / DRUM_R) else DQ.{};
}

// Seen from where something is: the rotation that takes the floor's frame at
// the arena's lowest point (up +y) to the frame at p, about the curve's
// centre. In the box nothing turns; in the drum it is Rz(drum_angle); in the
// sphere the shortest turn from +y to the up at p.
frame_at :: (s: [] OrbitLeague, p: D3) -> DQ {
  if s[0].drum { return dq_z(drum_angle(arena_drum(), p)); }
  if !s[0].sphere { return DQ.{}; }
  up := sphere_up(arena_sphere(), p);
  w := 1.0 + up.y;
  if w < 0.000001 { return dq_z(PI_D); }
  // the shortest arc from +y to up: axis y x up, half the angle
  return dq_unit(dq(up.z, 0.0, -up.x, w));
}
curve_centre :: (s: [] OrbitLeague) -> D3 { return d3(0.0, arena_hx(s), 0.0); }
// p seen from the frame q (into the lowest point's frame), and back.
to_floor :: (s: [] OrbitLeague, p: D3, q: DQ) -> D3 {
  if !curved(s) { return p; }
  c := curve_centre(s);
  return d3_add(c, dq_rotate(dq_conj(q), d3_sub(p, c)));
}
from_floor :: (s: [] OrbitLeague, p: D3, q: DQ) -> D3 {
  if !curved(s) { return p; }
  c := curve_centre(s);
  return d3_add(c, dq_rotate(q, d3_sub(p, c)));
}

// The drum seen from where the car is: Rz(a) about the drum's axis turns the
// floor's lowest line to the line at angle a round it (drum_angle).
drum_turn :: (p: D3, a: f64) -> D3 {
  c := cos(a); sn := sin(a);
  x := p.x; y := p.y - DRUM_R;
  return d3(x * c - y * sn, x * sn + y * c + DRUM_R, p.z);
}
drum_turn_dir :: (v: D3, a: f64) -> D3 {
  c := cos(a); sn := sin(a);
  return d3(v.x * c - v.y * sn, v.x * sn + v.y * c, v.z);
}

// The planes the cars meet: floor, roof, sides and ends.
car_planes :: () -> [6] Plane {
  p: [6] Plane;
  p[0] = plane(D3_Y, 0.0); p[1] = plane(d3(0.0, -1.0, 0.0), -ARENA_H);
  p[2] = plane(d3(1.0, 0.0, 0.0), -ARENA_HX); p[3] = plane(d3(-1.0, 0.0, 0.0), -ARENA_HX);
  p[4] = plane(D3_Z, -ARENA_HZ); p[5] = plane(d3(0.0, 0.0, -1.0), -ARENA_HZ);
  return p;
}
// The ball's planes: the same less the ends, which are boxes round the goal mouths.
ball_planes :: () -> [4] Plane {
  p: [4] Plane;
  p[0] = plane(D3_Y, 0.0); p[1] = plane(d3(0.0, -1.0, 0.0), -ARENA_H);
  p[2] = plane(d3(1.0, 0.0, 0.0), -ARENA_HX); p[3] = plane(d3(-1.0, 0.0, 0.0), -ARENA_HX);
  return p;
}
sbox :: (x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> SBox {
  return SBox.{c = d3((x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5), h = d3((x1 - x0) * 0.5, (y1 - y0) * 0.5, (z1 - z0) * 0.5)};
}
// Each end: the wall either side of the mouth and over it, then the net's back, sides and roof.
build_boxes :: (s: [] OrbitLeague) {
  hx := arena_hx(s); hh := arena_h(s);
  for e: 0..<2 {
    z := ifx e == 0 then ARENA_HZ else -ARENA_HZ;
    out := ifx e == 0 then 1.0 else -1.0;
    za := z; zb := z + out * WALL;
    zn := z + out * GOAL_D; zm := zn + out * WALL;
    k := e * 6;
    s[0].boxes[k] = sbox(-hx - WALL, 0.0, fmin(za, zb), -GOAL_HW, hh + WALL, fmax(za, zb));
    s[0].boxes[k + 1] = sbox(GOAL_HW, 0.0, fmin(za, zb), hx + WALL, hh + WALL, fmax(za, zb));
    s[0].boxes[k + 2] = sbox(-GOAL_HW, GOAL_H, fmin(za, zb), GOAL_HW, hh + WALL, fmax(za, zb));
    s[0].boxes[k + 3] = sbox(-GOAL_HW - WALL, -1.0, fmin(zn, zm), GOAL_HW + WALL, GOAL_H + WALL, fmax(zn, zm));
    s[0].boxes[k + 4] = sbox(-GOAL_HW - WALL, -1.0, fmin(za, zn), -GOAL_HW, GOAL_H + WALL, fmax(za, zn));
    s[0].boxes[k + 5] = sbox(GOAL_HW, -1.0, fmin(za, zn), GOAL_HW + WALL, GOAL_H + WALL, fmax(za, zn));
  }
  // the sphere has no frames: its goals are caps of its curve
  if s[0].sphere { for k: 0..<BOXES { s[0].boxes[k] = sbox(-1.0, -1001.0, -1.0, 1.0, -1000.0, 1.0); } }
}

// ---- the match

// Pad i: x and z, and y 1 for a big one.
pad_at :: (i: int) -> D3 {
  if i < 4 { return d3(ifx i % 2 == 0 then -(ARENA_HX - 4.0) else ARENA_HX - 4.0, 1.0, ifx i < 2 then -(ARENA_HZ - 6.0) else ARENA_HZ - 6.0); }
  if i < 6 { return d3(ifx i == 4 then -(ARENA_HX - 3.0) else ARENA_HX - 3.0, 1.0, 0.0); }
  if i < 8 { return d3(0.0, 0.0, ifx i == 6 then -22.0 else 22.0); }
  k := i - 8;
  x := ifx k % 2 == 0 then -1.0 else 1.0;
  z := ifx (k / 2) % 2 == 0 then -1.0 else 1.0;
  if k < 4 { return d3(x * 12.0, 0.0, z * 12.0); }
  return d3(x * 8.0, 0.0, z * 30.0);
}
// Pad i where it lies: on the box's floor, or round the drum (its x is then
// the distance round the curve from the floor's lowest line).
pad_world :: (s: [] OrbitLeague, i: int) -> D3 {
  p := pad_at(i);
  return floor_point(s, p.x, ifx s[0].sphere then p.z * SPHERE_PAD_Z else p.z, 0.0);
}
pad_wait_of :: (i: int) -> f64 { return ifx pad_at(i).y > 0.5 then PAD_BIG_WAIT else PAD_SMALL_WAIT; }

// A car on the floor over a ready pad takes it, unless its tank is full.
take_pads :: (s: [] OrbitLeague, dt: f64) {
  for i: 0..<PADS { s[0].pad_wait[i] = fmax(0.0, s[0].pad_wait[i] - dt); }
  for c: 0..<s[0].cars_n {
    b := s[0].bodies[c + 1];
    // its height off the floor (in the drum: in from the rim)
    off := clearance(s, b.pos);
    if off > 2.0 || s[0].tanks[c].fuel >= 100.0 { continue; }
    for i: 0..<PADS {
      if s[0].pad_wait[i] > 0.0 { continue; }
      big := pad_at(i).y > 0.5;
      p := pad_world(s, i);
      gap := d3_sub(b.pos, p);
      gap = d3_sub(gap, d3_scale(up_at(s, p), d3_dot(gap, up_at(s, p))));
      if d3_len(gap) > ifx big then PAD_BIG_R + 0.6 else PAD_SMALL_R + 0.6 { continue; }
      s[0].tanks[c].fuel = fmin(100.0, s[0].tanks[c].fuel + ifx big then PAD_BIG else PAD_SMALL);
      s[0].pad_wait[i] = pad_wait_of(i);
      if c == 0 && !s[0].replaying { s[0].pads_taken += 1; }
    }
  }
}

kickoff :: (s: [] OrbitLeague) {
  s[0].bodies[BALL] = rigid_body(BALL_MASS, d3_scale(d3(1.0, 1.0, 1.0), 0.4 * BALL_MASS * BALL_R * BALL_R), d3(0.0, BALL_R + 0.02, 0.0), DQ.{});
  s[0].bodies[YOU] = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, 1.0, -SPAWN_Z), DQ.{});
  s[0].bodies[BOT] = vehicle_body(s[0].spec, CAR_MASS, ifx s[0].no_bot then d3(arena_hx(s) - 3.0, 1.0, ARENA_HZ - 4.0) else d3(0.0, 1.0, SPAWN_Z), dq_y(PI_D));
  if s[0].no_bot && s[0].drum { s[0].bodies[BOT].pos = d3(0.0, 1.0, ARENA_HZ - 4.0); }
  if s[0].sphere {
    s[0].bodies[BALL].pos = floor_point(s, 0.0, 0.0, BALL_R + 0.02);
    s[0].bodies[YOU].pos = floor_point(s, 0.0, -SPHERE_SPAWN, 1.0); s[0].bodies[YOU].orientation = floor_turn(s, 0.0, -SPHERE_SPAWN);
    // without the bot its car parks round the side, out of the way
    bx := ifx s[0].no_bot then SPHERE_R * 1.3 else 0.0;
    s[0].bodies[BOT].pos = floor_point(s, bx, SPHERE_SPAWN, 1.0); s[0].bodies[BOT].orientation = dq_mul(floor_turn(s, bx, SPHERE_SPAWN), dq_y(PI_D));
  }
  // a 2v2's other two: diagonal behind each, or parked far below in a 1v1
  for c: 2..<CARS {
    side := ifx c % 2 == 0 then -1.0 else 1.0;
    sz := (ifx s[0].sphere then SPHERE_SPAWN else SPAWN_Z) + 6.0;
    x := ifx s[0].sphere then 8.0 else 14.0;
    x *= ifx c == MATE - 1 then 1.0 else -1.0;
    b := vehicle_body(s[0].spec, CAR_MASS, floor_point(s, x, side * sz, 1.0), DQ.{});
    b.orientation = floor_turn(s, x, side * sz);
    if side > 0.0 { b.orientation = dq_mul(b.orientation, dq_y(PI_D)); }
    if c >= s[0].cars_n { b = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, -1000.0 - cast(f64) c * 10.0, 0.0), DQ.{}); }
    s[0].bodies[c + 1] = b;
  }
  for c: 0..<CARS {
    s[0].cars[c] = VehicleState.{};
    s[0].tanks[c] = tank(fmax(s[0].tanks[c].fuel, BOOST_START), 100.0, false);
    s[0].stuck_for[c] = 0.0;
  }
  clear_trails(s);
  s[0].phase = PHASE_KICKOFF; s[0].phase_t = 0.0;
  s[0].rec_n = 0;
  for c: 1..<s[0].cars_n { bot_hit(s, c); s[0].bot_touch_t[c] = -100.0; }   // a fresh miss for each first approach
  s[0].cam_ready = false;
  s[0].stage = STAGE_NONE;
}

new_match :: (s: [] OrbitLeague) {
  s[0].score[0] = 0; s[0].score[1] = 0;
  s[0].clock = MATCH_TIME; s[0].played = 0.0; s[0].overtime = false; s[0].touches = 0;
  for c: 0..<CARS { s[0].tanks[c] = tank(BOOST_START, 100.0, false); }
  for i: 0..<PADS { s[0].pad_wait[i] = 0.0; }
  kickoff(s);
}

game_reset :: (s: [] OrbitLeague) {
  s[0].started = true;
  s[0].spec = vehicle_roadster();
  s[0].field = arena_field(s);
  s[0].stick_id = -1; s[0].hover = -1;
  for b: 0..<BUTTONS { s[0].button_id[b] = -1; }
  build_boxes(s);
  s[0].blast_t = -1.0;
  new_match(s);
  track_init(s[0].track[..], "orbit-league");
}

// The station's spin, 0 to 1, after `played` seconds of play: full for
// `every` seconds, then a spin-down of SPIN_DOWN (RAMP down, zero-g, RAMP
// up), and again. every 0: it never spins down.
spin_share :: (played: f64, every: f64) -> f64 {
  if every <= 0.0 { return 1.0; }
  into := spin_clock(played, every);
  if into < 0.0 { return 1.0; }
  into = SPIN_DOWN - into;
  if into < RAMP { return 1.0 - into / RAMP; }
  if into > SPIN_DOWN - RAMP { return (into - (SPIN_DOWN - RAMP)) / RAMP; }
  return 0.0;
}
// Seconds of the spin-down left, or until the next one (negative; -1e9 when off).
spin_clock :: (played: f64, every: f64) -> f64 {
  if every <= 0.0 { return -1000000000.0; }
  cycle := every + SPIN_DOWN;
  k := played - floor(played / cycle) * cycle;
  into := k - every;
  if into < 0.0 { return into; }
  return SPIN_DOWN - into;
}
// The spin for this step: the field's strength, and every tank full as a spin-down starts.
set_spin :: (s: [] OrbitLeague) {
  was := spin_clock(s[0].played - STEP, s[0].spin_every);
  now := spin_clock(s[0].played, s[0].spin_every);
  if was < 0.0 && now >= 0.0 && s[0].played > STEP { for c: 0..<CARS { s[0].tanks[c].fuel = 100.0; } }
  s[0].spin_now = spin_share(s[0].played, s[0].spin_every);
  s[0].field.scale = s[0].spin_now * s[0].spin_g;
}

ceil_d :: (x: f64) -> f64 { return -floor(-x); }
// atan2 from rigid.coax atan_d.
atan2_d :: (y: f64, x: f64) -> f64 {
  if x > 0.0 { return atan_d(y / x); }
  if x < 0.0 { return ifx y >= 0.0 then atan_d(y / x) + PI_D else atan_d(y / x) - PI_D; }
  if y > 0.0 { return PI_D / 2.0; }
  if y < 0.0 { return -PI_D / 2.0; }
  return 0.0;
}

// ---- the bot: drive to a spot behind the ball, toward our goal, and hit it

Drive :: struct { input: VehicleInput; boost: bool; }

// Everything a physics step reads and writes (ol-replay).
PhysState :: struct {
  bodies: [BODIES] RigidBody; cars: [CARS] VehicleState; tanks: [CARS] Tank; boosting: [CARS] bool;
  stuck_for: [CARS] f64; wheel_spin: [CARS] f64; pad_wait: [PADS] f64; played: f64; spin_now: f64; field: GravityField;
}
phys_save :: (s: [] OrbitLeague) -> PhysState {
  o: PhysState;
  for i: 0..<BODIES { o.bodies[i] = s[0].bodies[i]; }
  for c: 0..<CARS { o.cars[c] = s[0].cars[c]; o.tanks[c] = s[0].tanks[c]; o.boosting[c] = s[0].boosting[c]; o.stuck_for[c] = s[0].stuck_for[c]; o.wheel_spin[c] = s[0].wheel_spin[c]; }
  for i: 0..<PADS { o.pad_wait[i] = s[0].pad_wait[i]; }
  o.played = s[0].played; o.spin_now = s[0].spin_now; o.field = s[0].field;
  return o;
}
phys_load :: (s: [] OrbitLeague, o: PhysState) {
  for i: 0..<BODIES { s[0].bodies[i] = o.bodies[i]; }
  for c: 0..<CARS { s[0].cars[c] = o.cars[c]; s[0].tanks[c] = o.tanks[c]; s[0].boosting[c] = o.boosting[c]; s[0].stuck_for[c] = o.stuck_for[c]; s[0].wheel_spin[c] = o.wheel_spin[c]; }
  for i: 0..<PADS { s[0].pad_wait[i] = o.pad_wait[i]; }
  s[0].played = o.played; s[0].spin_now = o.spin_now; s[0].field = o.field;
}
// After a goal (its replay done): the end, or the next kickoff.
after_goal :: (s: [] OrbitLeague) {
  if !s[0].overtime && s[0].clock <= 0.0 { s[0].phase = PHASE_OVER; } else if s[0].overtime { s[0].phase = PHASE_OVER; } else { kickoff(s); }
}
// The goal's replay: back to the saved state before its last REPLAY_SECONDS,
// quietly on to where they start, then a step each STEP from there.
replay_start :: (s: [] OrbitLeague) -> bool {
  g := s[0].rec_n;
  start := imax(0, g - cast(int) (REPLAY_SECONDS / STEP));
  key := (start / KEY_EVERY) * KEY_EVERY;
  if g < 2 || g - key > REPLAY_STEPS || g / KEY_EVERY - key / KEY_EVERY >= REPLAY_KEYS { return false; }
  s[0].rp_resume = phys_save(s);
  s[0].replaying = true;
  phys_load(s, s[0].rp_keys[(key / KEY_EVERY) % REPLAY_KEYS]);
  for k: key..<start { physics_step(s, s[0].rp_drives[k % REPLAY_STEPS]); }
  s[0].rp_step = start; s[0].rp_end = g;
  s[0].phase = PHASE_REPLAY; s[0].phase_t = 0.0;
  s[0].rp_cut = -1;
  clear_trails(s);
  return true;
}
replay_end :: (s: [] OrbitLeague) {
  s[0].rp_ball = s[0].bodies[BALL].pos;
  phys_load(s, s[0].rp_resume);
  s[0].replaying = false;
  s[0].cam_ready = false;
  after_goal(s);
}
imax :: (a: int, b: int) -> int { return ifx a > b then a else b; }

// The same in the car's own frame (on a curved floor its floor is its own).
steer_local :: (b: RigidBody, target: D3) -> f64 {
  to := d3_sub(target, b.pos);
  return atan2_d(-d3_dot(to, rigid_axis(b, D3_X)), d3_dot(to, rigid_axis(b, D3_Z)));
}
steer_to :: (b: RigidBody, target: D3) -> f64 {
  f := rigid_axis(b, D3_Z);
  to := d3_sub(target, b.pos);
  // the signed angle in the floor's plane; +: to the right (the car's right is -x when it faces +z)
  fa := atan2_d(f.x, f.z);
  ta := atan2_d(to.x, to.z);
  a := fa - ta;
  while a > PI_D { a -= TAU_D; }
  while a < -PI_D { a += TAU_D; }
  return a;
}

// The ball after a car's hit (the game's and the room's): the contact's
// bounce, then a kick of a share of the closing speed, which includes the
// car's spin at the contact point. The kick goes along the line from the
// car's middle to the ball with most of its up-down part (in the car's own
// frame) taken out: a hit with the nose drives the ball low and along, a
// corner sends it off at the corner's angle, the roof pops it up, and a
// side dodge's spin adds its own sideways push.
ball_hit :: (ball: RigidBody, car: RigidBody, spec: VehicleSpec, ct: Contact) -> RigidBody {
  closing := -d3_dot(d3_sub(ball.vel, rigid_point_velocity(car, ct.point)), ct.normal);
  out := contact_resolve(ball, car, ct, 0.55, 0.3).a;
  if closing <= 1.0 { return out; }
  up := rigid_axis(car, D3_Y);
  line := d3_sub(ball.pos, car.pos);
  line = d3_sub(line, d3_scale(up, d3_dot(line, up) * HIT_FLATTEN));
  dir := d3_unit_or(line, ct.normal);
  // never into the car
  if d3_dot(dir, ct.normal) < 0.2 { dir = d3_unit_or(d3_add(dir, ct.normal), ct.normal); }
  out.vel = d3_add(out.vel, d3_scale(dir, closing * HIT_KICK));
  // the car's spin at the contact drags the ball across its face
  turn := d3_sub(rigid_point_velocity(car, ct.point), car.vel);
  turn = d3_sub(turn, d3_scale(ct.normal, d3_dot(turn, ct.normal)));
  out.vel = d3_add(out.vel, d3_scale(turn, HIT_SPIN));
  return out;
}

// ol-bot: the ball's path for the next three seconds with no car touching
// it (the same ball physics, on a copy), and which goal, if any, it ends in.
bot_predict :: (s: [] OrbitLeague) {
  keep := s[0].bodies[BALL];
  none: [1] RigidBody;
  s[0].bot_path_goal = -1;
  per := cast(int) (BOT_PATH_DT / STEP + 0.5);
  for k: 0..<BOT_PATH {
    if s[0].bot_path_goal < 0 {
      for i: 0..<per { ball_step(s, none[..], 0); }
      s[0].bot_path_goal = goal_past(s, s[0].bodies[BALL].pos.z);
    }
    s[0].bot_path[k] = s[0].bodies[BALL].pos;
  }
  s[0].bodies[BALL] = keep;
  s[0].bot_path_at = s[0].played;
}
// Where it meets the ball: the first point on the path it can reach in time.
bot_intercept :: (s: [] OrbitLeague, me: RigidBody) -> D3 {
  pace := fmax(d3_len(me.vel) * 0.6 + 8.0, 10.0);
  for k: 0..<BOT_PATH {
    p := s[0].bot_path[k];
    if d3_dist(p, me.pos) / pace <= cast(f64) (k + 1) * BOT_PATH_DT { return p; }
  }
  return s[0].bot_path[BOT_PATH - 1];
}
bot_drive :: (s: [] OrbitLeague, c: int) -> Drive {
  me := s[0].bodies[c + 1]; bl := s[0].bodies[BALL];
  team := c % 2;
  side := ifx team == MAGENTA then 1.0 else -1.0;   // its own goal's end: magenta's is +z
  goal := goal_point(s, -side);     // it attacks the other end
  out: Drive;
  if s[0].phase != PHASE_PLAY && s[0].phase != PHASE_GOAL { return out; }
  if s[0].no_bot { return out; }
  if s[0].phase == PHASE_PLAY && s[0].phase_t < BOT_REACT { return out; }
  // just after a hit it coasts: you get a chance at the ball
  if s[0].played - s[0].bot_touch_t[c] < bot_recover(s) { out.input.throttle = 0.2; return out; }
  // it aims at a point across your goal mouth that misses by bot_aim
  goal.x = fclamp(s[0].bot_aim[c] * s[0].bot_miss_k, -GOAL_HW - 6.0, GOAL_HW + 6.0);
  // the sphere's goal is a cap SPHERE_GOAL_R round: the miss in the same proportion
  if s[0].sphere { goal.x *= SPHERE_GOAL_R / GOAL_HW; }
  // the beginner's bot: a short lead on the ball's velocity
  meet := d3_add(bl.pos, d3_scale(d3(bl.vel.x, 0.0, bl.vel.z), 0.35));
  // the pro: where the ball is going, and the first point it can meet it
  if s[0].bot_smart {
    if s[0].played - s[0].bot_path_at > BOT_LOOK || s[0].played < s[0].bot_path_at { bot_predict(s); }
    meet = bot_intercept(s, me);
  }
  aim := d3_unit_or(d3_sub(goal, ifx s[0].bot_smart then meet else bl.pos), d3(0.0, 0.0, -1.0));
  target := d3_sub(meet, d3_scale(aim, 3.0));
  // the pro, lined up behind the ball toward the goal, drives on through it
  if s[0].bot_smart {
    to := d3_sub(meet, me.pos);
    along := d3_dot(to, aim);
    if along > 0.0 && d3_len(d3_sub(to, d3_scale(aim, along))) < 2.0 { target = d3_add(meet, d3_scale(aim, 4.0)); }
  }
  // the pro defends: the ball is headed into its own goal (+z) and it can't
  // get there first, so it drops back between the ball and the goal
  own := goal_point(s, side);
  if s[0].bot_smart && s[0].bot_path_goal == 1 - team && d3_dist(me.pos, own) > d3_dist(bl.pos, own) {
    target = d3_add(own, d3_scale(d3_sub(bl.pos, own), BOT_DEFEND));
  }
  // in a 2v2 the one of a pair further from the ball hangs back, between it and their goal
  mate := c ^ 2;
  back := s[0].cars_n == CARS && d3_dist(s[0].bodies[mate + 1].pos, bl.pos) < d3_dist(me.pos, bl.pos);
  if back { target = d3_add(own, d3_scale(d3_sub(bl.pos, own), BOT_DEFEND)); }
  // on the wrong side of the ball (between it and our goal): go round, back toward its own goal
  if (me.pos.z - bl.pos.z) * side < -1.0 && !back { target = d3(bl.pos.x + (ifx me.pos.x > bl.pos.x then 6.0 else -6.0), ifx s[0].sphere then bl.pos.y else 0.0, bl.pos.z + 9.0 * side); }
  target.x = fclamp(target.x, -arena_hx(s) + 2.0, arena_hx(s) - 2.0);
  hz := ifx s[0].sphere then SPHERE_R - 2.0 else ARENA_HZ;
  target.z = fclamp(target.z, -hz + 2.0, hz - 2.0);
  a := ifx curved(s) then steer_local(me, target) else steer_to(me, target);
  dist := ifx curved(s) then d3_dist(target, me.pos) else d3_len(d3(target.x - me.pos.x, 0.0, target.z - me.pos.z));
  out.input.steer = fclamp(a * 2.2, -1.0, 1.0);
  out.input.throttle = ifx abs(a) > 2.2 && dist < 10.0 then -0.6 else ifx s[0].drum then BOT_DRUM_THROTTLE else BOT_THROTTLE;
  out.input.handbrake = abs(a) > 1.4 && d3_len(me.vel) > 8.0;
  out.boost = abs(a) < 0.25 && dist > BOT_BOOST_FAR && s[0].tanks[c].fuel > 30.0;
  // the kickoff is a fair race: the bot drives in without boost, so you get there first if you go
  if s[0].phase == PHASE_PLAY && s[0].phase_t < BOT_KICKOFF_CALM { out.boost = false; out.input.throttle = fmin(out.input.throttle, 0.85); }
  near_ball := d3_dist(me.pos, bl.pos);
  // in zero-g the boost is how it gets anywhere
  // (in bursts, half of each second: a full tank at the spin-down doesn't make it a rocket)
  if s[0].cars[c].wheels == 0 && s[0].spin_now < 0.2 { out.boost = abs(a) < 0.4 && s[0].played - floor(s[0].played) < 0.5; out.input.throttle = 0.0; }
  out.input.jump = near_ball < 6.0 && bl.pos.y > 3.0 && bl.pos.y < 7.0 && s[0].played - s[0].bot_jump_t[c] > 1.5;
  if out.input.jump { s[0].bot_jump_t[c] = s[0].played; }
  return out;
}

// The bot hit the ball: it coasts a moment, and its next approach misses by
// a new amount, less as the match goes on.
bot_hit :: (s: [] OrbitLeague, c: int) {
  s[0].bot_touch_t[c] = s[0].played;
  late := fclamp(s[0].played / MATCH_TIME, 0.0, 1.0);
  miss := BOT_MISS + (BOT_MISS_LATE - BOT_MISS) * late;
  s[0].bot_aim[c] = (rnd(s) * 2.0 - 1.0) * miss;
}

you_drive :: (s: [] OrbitLeague) -> Drive {
  out: Drive;
  if s[0].phase != PHASE_PLAY && s[0].phase != PHASE_GOAL { return out; }
  h := s[0].held;
  t := 0.0; st := 0.0;
  if (h & HOLD_UP) != 0 { t += 1.0; }
  if (h & HOLD_DOWN) != 0 { t -= 1.0; }
  if (h & HOLD_LEFT) != 0 { st -= 1.0; }
  if (h & HOLD_RIGHT) != 0 { st += 1.0; }
  if s[0].stick { t -= cast(f64) s[0].stick_dy; st += cast(f64) s[0].stick_dx; }
  out.input.throttle = fclamp(t, -1.0, 1.0);
  out.input.steer = fclamp(st, -1.0, 1.0);
  out.input.jump = (h & HOLD_JUMP) != 0 || s[0].button_id[BTN_JUMP] >= 0;
  out.boost = (h & HOLD_BOOST) != 0 || s[0].button_id[BTN_BOOST] >= 0;
  return out;
}

// ---- staged moments (?stage=NAME, docs/verse/clips.md): a seeded scene that
// plays the same way every time, for a clip

STAGE_NONE :: 0; STAGE_HIGHLIGHT :: 1;

// The highlight: 2-2 late on, you boosting in on a dropping ball as the bot
// slides across its goal to block; the hit, the ball past it into the net
// and the blast.
stage_highlight :: (s: [] OrbitLeague) {
  new_match(s);
  s[0].stage = STAGE_HIGHLIGHT;
  s[0].score[0] = 2; s[0].score[1] = 2;
  s[0].clock = 24.0; s[0].played = 30.0;
  s[0].phase = PHASE_PLAY; s[0].phase_t = 2.0;
  s[0].bodies[BALL].pos = STAGE_BALL_AT; s[0].bodies[BALL].vel = STAGE_BALL_V;
  s[0].bodies[BALL].omega = d3(4.0, 0.0, 1.0);
  s[0].bodies[YOU].pos = STAGE_YOU_AT; s[0].bodies[YOU].vel = STAGE_YOU_V;
  s[0].bodies[YOU].orientation = dq_y(atan2_d(STAGE_YOU_V.x, STAGE_YOU_V.z));
  s[0].bodies[BOT].pos = STAGE_BOT_AT; s[0].bodies[BOT].vel = STAGE_BOT_V;
  s[0].bodies[BOT].orientation = dq_y(atan2_d(STAGE_BOT_V.x, STAGE_BOT_V.z));
  s[0].tanks[0].fuel = 100.0; s[0].tanks[1].fuel = 60.0;
  s[0].ball_cam = true;
  s[0].cam_ready = false;
  s[0].seed = 7.0;
}
STAGE_BALL_AT :: D3.{x = 0.0, y = 2.5, z = 8.0};
STAGE_BALL_V :: D3.{x = 0.0, y = 0.0, z = 0.0};
STAGE_YOU_AT :: D3.{x = 1.0, y = 1.0, z = -8.0};   // just right of the ball: the kick goes up the left, past the bot
STAGE_YOU_V :: D3.{x = 0.0, y = 0.0, z = 15.0};
STAGE_BOT_AT :: D3.{x = 8.0, y = 1.0, z = 37.0};
STAGE_BOT_V :: D3.{x = -9.0, y = 0.0, z = -3.6};

// The staged player: full throttle and boost until the goal.
stage_hold :: (s: [] OrbitLeague) {
  if s[0].stage == STAGE_HIGHLIGHT { s[0].held = ifx s[0].phase == PHASE_PLAY then HOLD_UP | HOLD_BOOST else 0; }
}

// ---- one physics step

// The ball against the arena: the floor, glass or curve, and the goal ends.
ball_arena :: (s: [] OrbitLeague) {
  bp := ball_planes();
  if s[0].sphere {
    ct := sphere_ball(arena_sphere(), s[0].bodies[BALL].pos, BALL_R);
    if ct.hit { s[0].bodies[BALL] = contact_resolve_static(s[0].bodies[BALL], ct, 0.65, 0.35); }
    return;
  }
  if s[0].drum {
    // the curve, inside the drum; in a goal its flat floor
    bpos := s[0].bodies[BALL].pos;
    ct := ifx abs(bpos.z) <= ARENA_HZ then drum_sphere(arena_drum(), bpos, BALL_R) else contact_sphere_plane(bpos, BALL_R, bp[0]);
    if ct.hit { s[0].bodies[BALL] = contact_resolve_static(s[0].bodies[BALL], ct, 0.65, 0.35); }
  } else {
    for p: bp {
      ct := contact_sphere_plane(s[0].bodies[BALL].pos, BALL_R, p);
      if ct.hit { s[0].bodies[BALL] = contact_resolve_static(s[0].bodies[BALL], ct, 0.65, 0.35); }
    }
  }
  for k: 0..<BOXES {
    b := s[0].boxes[k];
    ct := contact_sphere_box(s[0].bodies[BALL].pos, BALL_R, b.c, DQ.{}, b.h);
    if ct.hit { s[0].bodies[BALL] = contact_resolve_static(s[0].bodies[BALL], ct, 0.5, 0.35); }
  }
}

physics_step :: (s: [] OrbitLeague, drives: [CARS] Drive) {
  dt := STEP;
  set_spin(s);
  cp := car_planes();
  bp := ball_planes();
  dm := arena_drum();
  for c: 0..<s[0].cars_n {
    i := c + 1;
    dp := ifx s[0].sphere then sphere_planes(arena_sphere(), s[0].bodies[i].pos) else drum_planes(dm, s[0].bodies[i].pos);
    st := vehicle_step(s[0].bodies[i], s[0].spec, s[0].cars[c], drives[c].input, ifx curved(s) then dp[..] else cp[..], gravity_at(s[0].field, s[0].bodies[i].pos), dt);
    s[0].bodies[i] = st.body;
    if st.state.jumps > s[0].cars[c].jumps && c == 0 && !s[0].replaying { s[0].jumped[0] = true; }
    s[0].cars[c] = st.state;
    s[0].boosting[c] = false;
    if drives[c].boost {
      t := thruster_budget(d3(0.0, -0.05, -2.1), D3_Z, BOOST_FORCE, BOOST_RATE);
      burn := thrust_apply(s[0].bodies[i], t, s[0].tanks[c], 1.0, dt);
      s[0].bodies[i] = burn.body; s[0].tanks[c] = burn.tank;
      s[0].boosting[c] = burn.thrust > 0.0;
    } else if s[0].cars[c].wheels > 0 {
      s[0].tanks[c].fuel = fmin(100.0, s[0].tanks[c].fuel + BOOST_REGEN * dt);
    }
  }
  take_pads(s, dt);
  bl := s[0].bodies[BALL];
  bl.force = d3_add(bl.force, d3_scale(gravity_at(s[0].field, bl.pos), bl.mass));
  bl.force = d3_sub(bl.force, d3_scale(bl.vel, bl.mass * BALL_DRAG));
  s[0].bodies[BALL] = bl;
  w := rigid_world(dt, s[0].bodies[..]);
  w = rigid_step(w, D3_ZERO);
  // the cars against the arena, the ball, each other
  for c: 0..<s[0].cars_n {
    dp := ifx s[0].sphere then sphere_planes(arena_sphere(), s[0].bodies[c + 1].pos) else drum_planes(dm, s[0].bodies[c + 1].pos);
    s[0].bodies[c + 1] = vehicle_collide(s[0].bodies[c + 1], s[0].spec, ifx curved(s) then dp[..] else cp[..], 0.1, CAR_WALL_MU);
  }
  ball_arena(s);
  for c: 0..<s[0].cars_n {
    car := s[0].bodies[c + 1];
    ct := contact_sphere_box(s[0].bodies[BALL].pos, BALL_R, car.pos, car.orientation, s[0].spec.half);
    if ct.hit {
      closing := -d3_dot(d3_sub(s[0].bodies[BALL].vel, rigid_point_velocity(car, ct.point)), ct.normal);
      pair: BodyPair;
      pair.a = ball_hit(s[0].bodies[BALL], car, s[0].spec, ct);
      pair.b = contact_resolve(s[0].bodies[BALL], car, ct, 0.55, 0.3).b;
      if closing > 1.0 && !s[0].replaying {
        if c == 0 { s[0].touches += 1; track_tally(s[0].track[..], "touch", ""); }
        if c > 0 && s[0].played - s[0].bot_touch_t[c] > bot_recover(s) { bot_hit(s, c); }
      }
      if closing > 6.0 {
        k := fmin(closing / 25.0, 1.0);
        burst(s, ct.point, d3_scale(ct.normal, 6.0 + 10.0 * k), 6.0 + 6.0 * k, cast(int) (6.0 + 12.0 * k), -1, 0.45, 1.0);
        if c == 0 { s[0].shake = fmax(s[0].shake, 0.25 + 0.5 * k); }
      }
      s[0].bodies[BALL] = pair.a; s[0].bodies[c + 1] = pair.b;
    }
  }
  sp := d3_len(s[0].bodies[BALL].vel);
  if sp > BALL_MAX { s[0].bodies[BALL].vel = d3_scale(s[0].bodies[BALL].vel, BALL_MAX / sp); }
  for a: 0..<s[0].cars_n {
    for b: a + 1..<s[0].cars_n {
      cc := contact_sphere_sphere(s[0].bodies[a + 1].pos, 1.6, s[0].bodies[b + 1].pos, 1.6);
      if !cc.hit { continue; }
      pair := contact_resolve(s[0].bodies[a + 1], s[0].bodies[b + 1], cc, 0.3, 0.2);
      s[0].bodies[a + 1] = pair.a; s[0].bodies[b + 1] = pair.b;
    }
  }
  // a car on its wheels pressed into the glass turns where you steer: the
  // tyres alone can't swing it while its nose is pinned
  for c: 0..<s[0].cars_n {
    i := c + 1; b := s[0].bodies[i];
    if s[0].cars[c].wheels < 3 || drives[c].input.steer == 0.0 || drives[c].input.throttle == 0.0 { continue; }
    if abs(vehicle_forward_speed(b)) > PINNED_SPEED || !at_glass(s, b.pos) { continue; }
    want := -drives[c].input.steer * fsign(drives[c].input.throttle) * PINNED_TURN;
    up := up_at(s, b.pos);
    spin := d3_dot(b.omega, up);
    b.omega = d3_add(b.omega, d3_scale(up, (want - spin) * fmin(1.0, dt * 8.0)));
    s[0].bodies[i] = b;
  }
  // a car on its roof or side, or leaning on the glass, slow, for STUCK_TIME: set back on its wheels
  for c: 0..<s[0].cars_n {
    i := c + 1;
    // the count holds while it tumbles fast, and starts over once it is back on its wheels
    up := up_at(s, s[0].bodies[i].pos);
    tipped := d3_dot(rigid_axis(s[0].bodies[i], D3_Y), up) < 0.5 && s[0].cars[c].wheels < 3;
    if (vehicle_stuck(s[0].bodies[i], s[0].cars[c], up) || leaning(s, s[0].bodies[i], s[0].cars[c])) && s[0].spin_now > 0.5 { s[0].stuck_for[c] += dt; } else if !tipped { s[0].stuck_for[c] = 0.0; }
    if s[0].stuck_for[c] > STUCK_TIME {
      b := s[0].bodies[i];
      // set down where it is, facing the way it faced, on the floor under it
      q := frame_at(s, b.pos);
      f := dq_rotate(dq_conj(q), rigid_axis(b, D3_Z));
      on := to_floor(s, b.pos, q);
      b.orientation = dq_mul(q, dq_y(atan2_d(f.x, f.z)));
      b.pos = from_floor(s, d3(on.x, 1.2, on.z), q);
      b.vel = D3_ZERO; b.omega = D3_ZERO;
      s[0].bodies[i] = b;
      s[0].stuck_for[c] = 0.0;
    }
  }
  // anything that left the arena (it shouldn't) comes back to the kickoff;
  // online only your own car (the room owns the ball, and parks a missing
  // player's car under the floor)
  for i: 0..<BODIES {
    if (s[0].online && i != YOU) || i > s[0].cars_n { continue; }
    p := s[0].bodies[i].pos;
    if out_of_arena(s, p) && !s[0].replaying { kickoff(s); return; }
  }
}

// Something that left the arena (it shouldn't): through the glass or the curve.
out_of_arena :: (s: [] OrbitLeague, p: D3) -> bool {
  if !d3_finite(p) { return true; }
  if s[0].sphere { return sphere_clearance(arena_sphere(), p) < -4.0; }
  return abs(p.x) > arena_hx(s) + 4.0 || p.y < -3.0 || p.y > arena_h(s) + 4.0 || abs(p.z) > ARENA_HZ + GOAL_D + 4.0;
}

goal_scored :: (s: [] OrbitLeague, team: int) {
  s[0].score[team] += 1;
  s[0].last_goal = team;
  s[0].phase = PHASE_GOAL; s[0].phase_t = 0.0;
  s[0].blast = s[0].bodies[BALL].pos; s[0].blast_t = 0.0; s[0].blast_team = team;
  if s[0].stage != STAGE_NONE { s[0].stage = STAGE_NONE; s[0].held = 0; }
  burst(s, s[0].blast, D3_ZERO, 26.0, 100, team, 1.6, 3.5);
  s[0].shake = 1.0;
  // the goal knocks every car back from the ball
  for i: 1..<BODIES {
    away := d3_sub(s[0].bodies[i].pos, s[0].bodies[BALL].pos);
    d := d3_len(away);
    if d < 30.0 {
      k := 14.0 * (1.0 - d / 30.0);
      up := up_at(s, s[0].bodies[i].pos);
      flat := d3_sub(away, d3_scale(up, d3_dot(away, up)));
      s[0].bodies[i] = rigid_impulse_at(s[0].bodies[i], d3_scale(d3_unit_or(d3_add(flat, d3_scale(up, d * 0.4)), up), k * CAR_MASS), s[0].bodies[i].pos);
    }
  }
  if track_begin(s[0].track[..], "goal") {
    track_str(s[0].track[..], "team", ifx team == BLUE then "blue" else "magenta");
    track_int(s[0].track[..], "blue", s[0].score[0]); track_int(s[0].track[..], "magenta", s[0].score[1]);
    track_end(s[0].track[..]);
  }
}

game_step :: (s: [] OrbitLeague, dt: f64) {
  if s[0].golden { return; }
  s[0].carry = fmin(s[0].carry + dt, STEP * f64(MAX_STEPS));
  while s[0].carry >= STEP {
    s[0].carry -= STEP;
    s[0].phase_t += STEP;
    if s[0].phase == PHASE_KICKOFF && s[0].phase_t >= KICKOFF { s[0].phase = PHASE_PLAY; s[0].phase_t = 0.0; }
    if s[0].phase == PHASE_GOAL && s[0].phase_t >= CELEBRATE && !s[0].online {
      if !(s[0].replays && replay_start(s)) { after_goal(s); }
    }
    if s[0].phase == PHASE_REPLAY {
      if s[0].rp_step >= s[0].rp_end { replay_end(s); continue; }
      physics_step(s, s[0].rp_drives[s[0].rp_step % REPLAY_STEPS]);
      s[0].rp_step += 1;
      continue;
    }
    if s[0].phase == PHASE_PLAY && !s[0].online {
      s[0].played += STEP;
      if !s[0].overtime { s[0].clock = fmax(0.0, s[0].clock - STEP); }
      if s[0].clock <= 0.0 && !s[0].overtime {
        if s[0].score[0] == s[0].score[1] { s[0].overtime = true; }
        else { s[0].phase = PHASE_OVER; s[0].phase_t = 0.0; end_tracked(s); }
      }
    }
    stage_hold(s);
    drives: [CARS] Drive;
    drives[0] = you_drive(s);
    for c: 1..<s[0].cars_n { drives[c] = bot_drive(s, c); }
    if s[0].phase == PHASE_OVER { for c: 0..<CARS { drives[c] = Drive.{}; } }
    // ol-replay: this play's drives, and its state each second
    recording := s[0].phase == PHASE_PLAY && !s[0].online;
    if recording {
      if s[0].rec_n % KEY_EVERY == 0 { s[0].rp_keys[(s[0].rec_n / KEY_EVERY) % REPLAY_KEYS] = phys_save(s); }
      for c: 0..<CARS { s[0].rp_drives[s[0].rec_n % REPLAY_STEPS][c] = drives[c]; }
    }
    // the sphere's curve slopes down to its equator everywhere off it: through
    // the countdown the cars and the ball wait where they were set
    held: [BODIES] RigidBody;
    for i: 0..<BODIES { held[i] = s[0].bodies[i]; }
    physics_step(s, drives);
    if recording { s[0].rec_n += 1; }
    if s[0].sphere && s[0].phase == PHASE_KICKOFF { for i: 0..<BODIES { s[0].bodies[i] = held[i]; } }
    if s[0].online { s[0].you_hist[s[0].hist_n % HIST] = s[0].bodies[YOU]; s[0].hist_n += 1; }
    if s[0].phase == PHASE_PLAY && !s[0].online {
      team := goal_past(s, s[0].bodies[BALL].pos.z);
      if team >= 0 { goal_scored(s, team); }
    }
  }
}

end_tracked :: (s: [] OrbitLeague) {
  if track_begin(s[0].track[..], "end") {
    track_int(s[0].track[..], "blue", s[0].score[0]); track_int(s[0].track[..], "magenta", s[0].score[1]);
    track_int(s[0].track[..], "touches", s[0].touches);
    track_end(s[0].track[..]);
  }
}

// ---- the look: sparks, trails, the goal's blast

rnd :: (s: [] OrbitLeague) -> f64 {
  s[0].seed += 1.0;
  x := sin(s[0].seed * 12.9898 + 78.233) * 43758.5453;
  return x - floor(x);
}

// n sparks from `at`, flying out at up to `speed` on top of `push`: white,
// or some in a team's colour (team -1: all white).
burst :: (s: [] OrbitLeague, at: D3, push: D3, speed: f64, n: int, team: int, life: f64, size: f64) {
  for i: 0..<n {
    z := rnd(s) * 2.0 - 1.0; a := rnd(s) * TAU_D; r := sqrt(fmax(0.0, 1.0 - z * z));
    sp: Spark;
    sp.p = at;
    sp.v = d3_add(push, d3_scale(d3(r * cos(a), z, r * sin(a)), speed * (0.35 + 0.65 * rnd(s))));
    sp.max = life * (0.6 + 0.4 * rnd(s)); sp.life = sp.max;
    sp.red = 0.85; sp.green = 0.95; sp.blue = 1.0;
    if team == BLUE && rnd(s) > 0.3 { sp.red = TEAM_B_R; sp.green = TEAM_B_G; sp.blue = TEAM_B_B; }
    if team == MAGENTA && rnd(s) > 0.3 { sp.red = TEAM_O_R; sp.green = TEAM_O_G; sp.blue = TEAM_O_B; }
    sp.size = cast(f32) ((0.05 + 0.07 * rnd(s)) * size);
    s[0].sparks[s[0].spark_next] = sp;
    s[0].spark_next = (s[0].spark_next + 1) % SPARKS;
  }
}

clear_trails :: (s: [] OrbitLeague) {
  for i: 0..<TRAIL_N { s[0].ball_k[i] = 0.0; s[0].boost_k[i] = 0.0; s[0].boost_k[TRAIL_N + i] = 0.0; }
}

// The ball glows in its trail from 10 m/s, fully at 24.
ball_glow :: (s: [] OrbitLeague) -> f64 { return fclamp((d3_len(s[0].bodies[BALL].vel) - 10.0) / 14.0, 0.0, 1.0); }
nozzle :: (b: RigidBody) -> D3 { return d3_sub(b.pos, d3_add(d3_scale(rigid_axis(b, D3_Z), 2.3), d3_scale(rigid_axis(b, D3_Y), 0.05))); }

effects_step :: (s: [] OrbitLeague, dt: f64) {
  g := gravity_at(s[0].field, D3_ZERO);
  for i: 0..<SPARKS {
    if s[0].sparks[i].life <= 0.0 { continue; }
    sp := s[0].sparks[i];
    sp.v = d3_add(sp.v, d3_scale(g, dt * 0.6));
    sp.v = d3_scale(sp.v, 1.0 - fmin(1.5 * dt, 0.5));
    sp.p = d3_add(sp.p, d3_scale(sp.v, dt));
    if sp.p.y < 0.03 { sp.p.y = 0.03; sp.v.y = abs(sp.v.y) * 0.4; }
    sp.life -= dt;
    s[0].sparks[i] = sp;
  }
  if s[0].blast_t >= 0.0 { s[0].blast_t += dt; if s[0].blast_t > BLAST_LIFE { s[0].blast_t = -1.0; } }
  s[0].shake *= exp(-dt * 6.0);
  // the wheels roll with the car (kept within a turn)
  for c: 0..<s[0].cars_n {
    w := s[0].wheel_spin[c] + vehicle_forward_speed(s[0].bodies[c + 1]) / s[0].spec.wheel_r * dt;
    s[0].wheel_spin[c] = w - floor(w / TAU_D) * TAU_D;
  }
  if s[0].phase == PHASE_KICKOFF { clear_trails(s); }
  s[0].trail_t += dt;
  if s[0].trail_t < TRAIL_DT { return; }
  s[0].trail_t -= TRAIL_DT;
  if s[0].trail_t > TRAIL_DT { s[0].trail_t = 0.0; }
  for i: 0..<TRAIL_N - 1 {
    j := TRAIL_N - 1 - i;
    s[0].ball_trail[j] = s[0].ball_trail[j - 1]; s[0].ball_k[j] = s[0].ball_k[j - 1];
    for c: 0..<2 { o := c * TRAIL_N; s[0].boost_trail[o + j] = s[0].boost_trail[o + j - 1]; s[0].boost_k[o + j] = s[0].boost_k[o + j - 1]; }
  }
  s[0].ball_trail[0] = s[0].bodies[BALL].pos; s[0].ball_k[0] = ball_glow(s);
  for c: 0..<2 {
    s[0].boost_trail[c * TRAIL_N] = nozzle(s[0].bodies[c + 1]);
    s[0].boost_k[c * TRAIL_N] = ifx s[0].boosting[c] then 1.0 else 0.0;
  }
}

// A trail into the uniforms: its bound, then now and the points behind it.
put_trail :: (u: [] f32, at: int, now: D3, now_k: f64, pts: [] D3, ks: [] f64, first: int) {
  c := D3_ZERO; n := 0.0;
  for i: 0..<TRAIL_N {
    p := ifx i == 0 then now else pts[first + i - 1];
    k := ifx i == 0 then now_k else ks[first + i - 1];
    o := at + 4 + i * 4;
    u[o] = cast(f32) p.x; u[o + 1] = cast(f32) p.y; u[o + 2] = cast(f32) p.z; u[o + 3] = cast(f32) k;
    if k > 0.0 { c = d3_add(c, p); n += 1.0; }
  }
  u[at + 3] = -1;
  if n < 1.0 { return; }
  c = d3_scale(c, 1.0 / n);
  r := 0.0;
  for i: 0..<TRAIL_N {
    o := at + 4 + i * 4;
    if u[o + 3] > 0 || (i > 0 && u[o - 1] > 0) { r = fmax(r, d3_dist(c, d3(cast(f64) u[o], cast(f64) u[o + 1], cast(f64) u[o + 2]))); }
  }
  u[at] = cast(f32) c.x; u[at + 1] = cast(f32) c.y; u[at + 2] = cast(f32) c.z; u[at + 3] = cast(f32) (r + 1.0);
}

// Each spark as a short streak along its flight.
draw_sparks :: (s: [] OrbitLeague, out: [] f32, at: int) -> int {
  v := at;
  for i: 0..<SPARKS {
    sp := s[0].sparks[i];
    if sp.life <= 0.0 { continue; }
    k := cast(f32) (sp.life / sp.max);
    tail := d3_sub(sp.p, d3_scale(sp.v, 0.035));
    a := seen(s, cast(f32) sp.p.x, cast(f32) sp.p.y, cast(f32) sp.p.z);
    b := seen(s, cast(f32) tail.x, cast(f32) tail.y, cast(f32) tail.z);
    if !a.ok || !b.ok { continue; }
    w := clamp(sp.size * s[0].height * 0.5 * s[0].sy / a.w, 0.7 * s[0].dpr, 8 * s[0].dpr);
    bx := b.x;
    if abs(a.x - b.x) + abs(a.y - b.y) < 0.5 { bx = a.x + 0.5; }
    if lit(out, v, bx, b.y, a.x, a.y, w, k * 1.2, w * 2.5, sp.red, sp.green, sp.blue, MODE_STROKE) { v += 6; }
  }
  return v;
}

// ---- in from the host

has_text :: (text: string, part: string) -> bool {
  if part.count == 0 { return true; }
  for i: 0..<text.count - part.count + 1 { if text[i..<i + part.count] == part { return true; } }
  return false;
}

game_message :: (s: [] OrbitLeague, kind: int, text: string) #export_c {
  if !s[0].started { game_reset(s); }
  if kind == HOST_FACTS && fact_of(text, "coarse") == "1" { s[0].touch = true; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "arena=drum") { set_arena(s, true); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "arena=sphere") { set_arena_kind(s, ARENA_SPHERE); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=60") { s[0].spin_every = 60.0; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=off") { s[0].spin_every = 0.0; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "spin=half") { s[0].spin_g = HALF_SPIN; }
  // ?mode=1v1 or ?mode=2v2; without it a phone plays 2v2 (ol-bot-modes)
  if kind == HOST_FACTS && !s[0].online {
    url := fact_of(text, "url");
    if has_text(url, "mode=2v2") { s[0].mode_set = true; set_mode(s, CARS); }
    else if has_text(url, "mode=1v1") { s[0].mode_set = true; set_mode(s, 2); }
    else if s[0].touch && !s[0].mode_set && s[0].cars_n != CARS && !has_text(url, "room=") && !has_text(url, "quick=") { set_mode(s, CARS); }
  }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "bot=pro") { s[0].bot_smart = true; s[0].bot_miss_k = 0.3; }
  if kind == HOST_FACTS { s[0].lag = cast(f64) url_number(fact_of(text, "url"), "lag=") / 1000.0; }
  if kind == HOST_FACTS && !s[0].online && (has_text(fact_of(text, "url"), "room=") || has_text(fact_of(text, "url"), "quick=")) { room_join(s, fact_of(text, "url")); }
  if room_socket(s, kind, text) { return; }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "bot=0") { s[0].no_bot = true; s[0].cars_n = 2; kickoff(s); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "stage=highlight") { stage_highlight(s); }
  if kind == HOST_FACTS && has_text(fact_of(text, "url"), "card=1") { s[0].card = true; }
  if kind == MAKER_KIND { take_maker(s, text); }
  t := track_message(s[0].track[..], kind, text);
  if kind == HOST_FACTS { track_world(s[0].track[..], "orbit-league"); }
}

// The box or the drum: a new match in it.
set_arena :: (s: [] OrbitLeague, drum: bool) { set_arena_kind(s, ifx drum then ARENA_DRUM else ARENA_BOX); }
// 1v1 (2 cars) or 2v2 (CARS): a new match with bots in every seat but yours.
set_mode :: (s: [] OrbitLeague, n: int) {
  s[0].cars_n = ifx n == CARS then CARS else 2;
  new_match(s);
}
set_arena_kind :: (s: [] OrbitLeague, kind: int) {
  s[0].drum = kind == ARENA_DRUM; s[0].sphere = kind == ARENA_SPHERE;
  s[0].field = arena_field(s);
  build_boxes(s);
  new_match(s);
}
// The spin's field: the box's floor pulls down; the drum and the sphere spin.
arena_field :: (s: [] OrbitLeague) -> GravityField {
  if s[0].sphere { return sphere_field(arena_sphere(), FULL_SPIN_G); }
  return ifx s[0].drum then drum_field(arena_drum(), FULL_SPIN_G) else gravity_constant(d3(0.0, -FULL_SPIN_G, 0.0));
}

// ---- the online room (ol-room)
//
// The server (coax/web/room/room.coax) owns the ball: it steps it 120 times
// a second against the arena and the cars its players report, and runs the
// kickoffs, goals and clock; 60 times a second it sends every player the
// room's state. Each player drives its own car here and reports it 60 times
// a second. The text frames are integers (mm, mm/s, 1/10000ths, mrad/s):
//   to the server:  c PX PY PZ QX QY QZ QW VX VY VZ WX WY WZ
//   to a player:    s TICK SEAT PHASE PHASE_MS CLOCK_MS BLUE MAGENTA KICKS N  BALL(13)  then N times SEAT CAR(13)
// Seats 0 and 2 are blue (at -z, attacking +z), 1 and 3 magenta. A
// magenta player sees the arena turned round (x and z negated), so here
// every player is blue at -z, attacking +z.

// A body's 13 numbers.
room_put_body :: (buf: [] u8, at: int, b: RigidBody) -> int {
  k := at;
  vals := [13] f64.[b.pos.x * 1000.0, b.pos.y * 1000.0, b.pos.z * 1000.0,
    b.orientation.x * 10000.0, b.orientation.y * 10000.0, b.orientation.z * 10000.0, b.orientation.w * 10000.0,
    b.vel.x * 1000.0, b.vel.y * 1000.0, b.vel.z * 1000.0, b.omega.x * 1000.0, b.omega.y * 1000.0, b.omega.z * 1000.0];
  for v: vals { k = room_put_int(buf, k, cast(int) floor(v + 0.5)); }
  return k;
}
room_put_int :: (buf: [] u8, at: int, v: int) -> int {
  k := at;
  if k < buf.count { buf[k] = ' '; k += 1; }
  if v < 0 { if k < buf.count { buf[k] = '-'; k += 1; } return put_int(buf, k, -v); }
  return put_int(buf, k, v);
}
// Reading: the next integer from at[0] on, skipping spaces; ok[0] false past the end.
room_int :: (text: string, at: [] int, ok: [] bool) -> int {
  i := at[0];
  while i < text.count && text[i] == ' ' { i += 1; }
  neg := false;
  if i < text.count && text[i] == '-' { neg = true; i += 1; }
  if i >= text.count || text[i] < '0' || text[i] > '9' { ok[0] = false; at[0] = i; return 0; }
  v := 0;
  while i < text.count && text[i] >= '0' && text[i] <= '9' && v < 100000000000 { v = v * 10 + cast(int) (text[i] - '0'); i += 1; }
  at[0] = i;
  return ifx neg then -v else v;
}
room_body :: (text: string, at: [] int, ok: [] bool, b: RigidBody) -> RigidBody {
  v: [13] f64;
  for i: 0..<13 { v[i] = cast(f64) room_int(text, at, ok); }
  out := b;
  out.pos = d3(v[0] / 1000.0, v[1] / 1000.0, v[2] / 1000.0);
  q := DQ.{x = v[3] / 10000.0, y = v[4] / 10000.0, z = v[5] / 10000.0, w = v[6] / 10000.0};
  n := sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
  out.orientation = ifx n > 0.5 then DQ.{x = q.x / n, y = q.y / n, z = q.z / n, w = q.w / n} else DQ.{};
  out.vel = d3(v[7] / 1000.0, v[8] / 1000.0, v[9] / 1000.0);
  out.omega = d3(v[10] / 1000.0, v[11] / 1000.0, v[12] / 1000.0);
  if !d3_finite(out.pos) || !d3_finite(out.vel) || !d3_finite(out.omega) { return b; }
  return out;
}
// The arena turned round (x and z negated): a magenta seat's view.
room_turn :: (b: RigidBody) -> RigidBody {
  out := b;
  out.pos = d3(-b.pos.x, b.pos.y, -b.pos.z);
  out.vel = d3(-b.vel.x, b.vel.y, -b.vel.z);
  out.omega = d3(-b.omega.x, b.omega.y, -b.omega.z);
  out.orientation = dq_mul(dq_y(PI_D), b.orientation);
  return out;
}
room_view :: (b: RigidBody, seat: int) -> RigidBody { return ifx seat % 2 == 1 then room_turn(b) else b; }

// The server's room: one match, its ball, and the cars its players last reported.
room_reset :: (s: [] OrbitLeague) {
  game_reset(s); s[0].no_bot = true;
  room_kickoff(s);
}
room_kickoff :: (s: [] OrbitLeague) {
  s[0].bodies[BALL] = rigid_body(BALL_MASS, d3_scale(d3(1.0, 1.0, 1.0), 0.4 * BALL_MASS * BALL_R * BALL_R), d3(0.0, BALL_R + 0.02, 0.0), DQ.{});
  s[0].phase = PHASE_KICKOFF; s[0].phase_t = 0.0;
  s[0].kicks += 1;
}
// One STEP of the room: the clock and phases, then the ball against the
// arena and the reported cars (they push it; it doesn't push them back).
room_step :: (s: [] OrbitLeague, cars: [] RigidBody, players: int) {
  s[0].phase_t += STEP;
  if s[0].phase == PHASE_KICKOFF && s[0].phase_t >= KICKOFF { s[0].phase = PHASE_PLAY; s[0].phase_t = 0.0; }
  if s[0].phase == PHASE_GOAL && s[0].phase_t >= CELEBRATE {
    if s[0].clock <= 0.0 { s[0].score[0] = 0; s[0].score[1] = 0; s[0].clock = MATCH_TIME; s[0].played = 0.0; }
    room_kickoff(s);
  }
  if s[0].phase == PHASE_KICKOFF { return; }
  if s[0].phase == PHASE_PLAY && players > 0 {
    s[0].played += STEP; s[0].clock = fmax(0.0, s[0].clock - STEP);
    // full time: a pause like a goal's, then a new match
    if s[0].clock <= 0.0 { s[0].phase = PHASE_GOAL; s[0].phase_t = 0.0; s[0].last_goal = -1; }
  }
  s[0].spin_now = spin_share(s[0].played, s[0].spin_every); s[0].field.scale = s[0].spin_now * s[0].spin_g;
  ball_step(s, cars, players);
  if s[0].phase == PHASE_PLAY {
    z := s[0].bodies[BALL].pos.z;
    team := goal_past(s, z);
    if team >= 0 { s[0].score[team] += 1; s[0].last_goal = team; s[0].phase = PHASE_GOAL; s[0].phase_t = 0.0; }
  }
  p := s[0].bodies[BALL].pos;
  if out_of_arena(s, p) { room_kickoff(s); }
}
// One STEP of the ball alone, the room's and a player's replay of it: its
// gravity and drag, the arena, and the cars given (they push it; it doesn't
// push them back).
ball_step :: (s: [] OrbitLeague, cars: [] RigidBody, players: int) {
  bl := s[0].bodies[BALL];
  bl.force = d3_add(d3_scale(gravity_at(s[0].field, bl.pos), bl.mass), d3_scale(bl.vel, -bl.mass * BALL_DRAG));
  one: [1] RigidBody; one[0] = bl;
  w := rigid_world(STEP, one[..]);
  w = rigid_step(w, D3_ZERO);
  s[0].bodies[BALL] = one[0];
  ball_arena(s);
  for c: 0..<players {
    car := cars[c];
    ct := contact_sphere_box(s[0].bodies[BALL].pos, BALL_R, car.pos, car.orientation, s[0].spec.half);
    if !ct.hit { continue; }
    s[0].bodies[BALL] = ball_hit(s[0].bodies[BALL], car, s[0].spec, ct);
  }
  sp := d3_len(s[0].bodies[BALL].vel);
  if sp > BALL_MAX { s[0].bodies[BALL].vel = d3_scale(s[0].bodies[BALL].vel, BALL_MAX / sp); }
}
// ol-quick-match: one STEP for the room's bots, the seats no player has
// (seat = car: even seats blue, odd magenta, in the room's own frame). The
// players' cars are copied in so the bots see them; each bot drives the game's
// bot (bot_drive) through the same vehicle physics, against the arena.
room_bots :: (s: [] OrbitLeague, cars: [] RigidBody, human: [] bool, seats: int) {
  s[0].cars_n = seats;
  for c: 0..<seats { if human[c] { s[0].bodies[c + 1] = cars[c]; } }
  cp := car_planes(); dm := arena_drum();
  for c: 0..<seats {
    if human[c] { continue; }
    i := c + 1;
    d := bot_drive(s, c);
    dp := ifx s[0].sphere then sphere_planes(arena_sphere(), s[0].bodies[i].pos) else drum_planes(dm, s[0].bodies[i].pos);
    planes := ifx curved(s) then dp[..] else cp[..];
    st := vehicle_step(s[0].bodies[i], s[0].spec, s[0].cars[c], d.input, planes, gravity_at(s[0].field, s[0].bodies[i].pos), STEP);
    b := st.body; s[0].cars[c] = st.state;
    s[0].boosting[c] = false;
    if d.boost {
      t := thruster_budget(d3(0.0, -0.05, -2.1), D3_Z, BOOST_FORCE, BOOST_RATE);
      burn := thrust_apply(b, t, s[0].tanks[c], 1.0, STEP);
      b = burn.body; s[0].tanks[c] = burn.tank; s[0].boosting[c] = burn.thrust > 0.0;
    } else if s[0].cars[c].wheels > 0 { s[0].tanks[c].fuel = fmin(100.0, s[0].tanks[c].fuel + BOOST_REGEN * STEP); }
    one: [1] RigidBody; one[0] = b;
    w := rigid_world(STEP, one[..]);
    w = rigid_step(w, D3_ZERO);
    b = vehicle_collide(one[0], s[0].spec, planes, 0.1, CAR_WALL_MU);
    // it touched the ball: it coasts a moment and draws a new miss, as offline
    if d3_dist(b.pos, s[0].bodies[BALL].pos) < BALL_R + 2.6 && s[0].played - s[0].bot_touch_t[c] > bot_recover(s) { bot_hit(s, c); }
    s[0].bodies[i] = b;
    cars[c] = b;
  }
}
// A quick match's bots at their kickoff spots (the game's kickoff, room frame).
room_bots_kickoff :: (s: [] OrbitLeague, cars: [] RigidBody, human: [] bool, seats: int) {
  s[0].no_bot = false; s[0].cars_n = seats;
  // the room's own kickoff set the ball, the phase and its clock: kept
  ball := s[0].bodies[BALL]; phase := s[0].phase; t := s[0].phase_t;
  kickoff(s);
  s[0].bodies[BALL] = ball; s[0].phase = phase; s[0].phase_t = t;
  for c: 0..<seats { if !human[c] { cars[c] = s[0].bodies[c + 1]; } }
}
// The state frame for the player in `seat`; cars[i] is seat seats[i]'s.
room_state :: (s: [] OrbitLeague, tick: int, seat: int, cars: [] RigidBody, seats: [] int, players: int, buf: [] u8) -> int {
  return room_state_echo(s, tick, seat, cars, seats, players, -1, buf);
}
// The same, ending with the clock the player last sent (its ms; -1: none), so it can time the round trip.
room_state_echo :: (s: [] OrbitLeague, tick: int, seat: int, cars: [] RigidBody, seats: [] int, players: int, echo: int, buf: [] u8) -> int {
  k := 0;
  buf[k] = 's'; k += 1;
  k = room_put_int(buf, k, tick); k = room_put_int(buf, k, seat);
  k = room_put_int(buf, k, s[0].phase); k = room_put_int(buf, k, cast(int) (s[0].phase_t * 1000.0));
  k = room_put_int(buf, k, cast(int) (s[0].clock * 1000.0));
  k = room_put_int(buf, k, s[0].score[0]); k = room_put_int(buf, k, s[0].score[1]);
  k = room_put_int(buf, k, s[0].kicks);
  k = room_put_int(buf, k, players - 1);
  k = room_put_body(buf, k, s[0].bodies[BALL]);
  for i: 0..<players {
    if seats[i] == seat { continue; }
    k = room_put_int(buf, k, seats[i]);
    k = room_put_body(buf, k, cars[i]);
  }
  if echo >= 0 { k = room_put_int(buf, k, echo); }
  return k;
}
// The clock a player's report ends with (its ms), or -1.
room_report_clock :: (text: string) -> int {
  if text.count < 2 || text[0] != 'c' { return -1; }
  at: [1] int; at[0] = 1; ok: [1] bool; ok[0] = true;
  b := room_body(text, at[..], ok[..], RigidBody.{});
  v := room_int(text, at[..], ok[..]);
  return ifx ok[0] && v >= 0 then v else -1;
}
// What a player reported: its car, or the old one if the frame is bad.
room_report :: (text: string, old: RigidBody) -> RigidBody {
  if text.count < 2 || text[0] != 'c' { return old; }
  at: [1] int; at[0] = 1; ok: [1] bool; ok[0] = true;
  b := room_body(text, at[..], ok[..], old);
  return ifx ok[0] then b else old;
}

// The player's side. ?room=NAME joins; the socket opens to this site's
// /api/room/orbit-league/NAME.
room_join :: (s: [] OrbitLeague, url: string) {
  // the room's name: [a-z0-9-], at most ROOM_NAME
  i := 0; key := "room=";
  found := -1;
  while i + key.count <= url.count { if url[i..<i + key.count] == key { found = i + key.count; break; } i += 1; }
  // ?quick=1v1 or ?quick=2v2: the room server's matchmaking (ol-quick-match)
  named := url;
  if found < 0 && has_text(url, "quick=") { named = ifx has_text(url, "quick=2v2") then "room=quick-2v2" else "room=quick-1v1"; found = 5; }
  if found < 0 { return; }
  n := 0; j := found;
  while j < named.count && n < ROOM_NAME {
    c := named[j];
    if c >= 'A' && c <= 'Z' { c += 32; }
    if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { break; }
    s[0].room[n] = c; n += 1; j += 1;
  }
  if n == 0 { return; }
  s[0].room_n = n;
  // the origin: scheme and host
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  secure := url.count > 5 && url[0..<5] == "https";
  o := 0;
  pre := ifx secure then "wss://" else "ws://";
  for b: pre { s[0].origin[o] = b; o += 1; }
  start := ifx secure then 8 else 7;
  for q: start..<k { if o < 120 { s[0].origin[o] = url[q]; o += 1; } }
  s[0].origin_n = o;
  s[0].online = true; s[0].no_bot = true; s[0].cars_n = 2; s[0].sock_state = ROOM_JOINING;
  buf: [256] u8; m := 0;
  for q: 0..<o { buf[m] = s[0].origin[q]; m += 1; }
  for b: "/api/room/orbit-league/" { buf[m] = b; m += 1; }
  for q: 0..<n { buf[m] = s[0].room[q]; m += 1; }
  ok := pipe_open(s[0].pipe[..], cast(string) buf[0..<m]);
  kickoff(s);
}
game_socket_opened :: (s: [] OrbitLeague, id: int) #export_c {
  s[0].sock = id;
  if id < 0 { s[0].sock_state = ROOM_LOST; }
}
room_socket :: (s: [] OrbitLeague, kind: int, text: string) -> bool {
  e := socket_event(kind);
  if e.id < 0 { return false; }
  if e.id != s[0].sock { return true; }
  if e.event == SOCKET_OPENED { s[0].sock_open = true; }
  if e.event == SOCKET_FRAME { room_heard(s, text); }
  if e.event == SOCKET_CLOSED || e.event == SOCKET_ERROR { s[0].sock_open = false; s[0].sock = -1; s[0].sock_state = ROOM_LOST; }
  return true;
}
// A state from the server: the ball, the other car, the score and the phase.
room_take :: (s: [] OrbitLeague, text: string) {
  if text.count < 2 || text[0] != 's' { return; }
  at: [1] int; at[0] = 1; ok: [1] bool; ok[0] = true;
  tick := room_int(text, at[..], ok[..]); seat := room_int(text, at[..], ok[..]);
  phase := room_int(text, at[..], ok[..]); phase_ms := room_int(text, at[..], ok[..]); clock_ms := room_int(text, at[..], ok[..]);
  blue := room_int(text, at[..], ok[..]); magenta := room_int(text, at[..], ok[..]);
  kicks := room_int(text, at[..], ok[..]); others := room_int(text, at[..], ok[..]);
  ball := room_body(text, at[..], ok[..], s[0].bodies[BALL]);
  if !ok[0] || seat < 0 || seat >= ROOM_PLAYERS { return; }
  s[0].seat = seat; s[0].sock_state = ROOM_IN; s[0].heard += 1;
  mine := seat % 2;
  kicked := kicks != s[0].kicks;
  if kicked { s[0].kicks = kicks; kickoff(s); }
  now_mine := ifx mine == 0 then blue else magenta; now_theirs := ifx mine == 0 then magenta else blue;
  if phase == PHASE_GOAL && s[0].phase != PHASE_GOAL && now_mine + now_theirs > s[0].score[0] + s[0].score[1] {
    goal_scored(s, ifx now_mine > s[0].score[0] then BLUE else MAGENTA);
  }
  s[0].phase = phase; s[0].phase_t = cast(f64) phase_ms / 1000.0; s[0].clock = cast(f64) clock_ms / 1000.0;
  s[0].score[0] = now_mine; s[0].score[1] = now_theirs;
  // the others (players, or a quick match's bots): the first opponent is the
  // magenta car, drawn between its states; a teammate the blue mate; a second
  // opponent the other magenta car. A seat nobody has is parked under the floor.
  opp := 0; mated := false;
  for k: 0..<others {
    other_seat := room_int(text, at[..], ok[..]);
    car := room_body(text, at[..], ok[..], s[0].bodies[BOT]);
    if !ok[0] { break; }
    b := room_view(car, seat);
    if other_seat % 2 == mine {
      if !mated { s[0].bodies[MATE] = b; mated = true; }
      continue;
    }
    if opp == 0 {
      s[0].bodies[BOT] = b;
      gap := s[0].net_t - s[0].oth_at;
      if s[0].oth_n > 0 && gap > 0.0 && gap < 0.5 { s[0].oth_gap += (gap - s[0].oth_gap) * 0.1; }
      s[0].oth_prev = ifx s[0].oth_n > 0 then room_other(s) else s[0].bodies[BOT];
      s[0].oth_last = s[0].bodies[BOT]; s[0].oth_at = s[0].net_t; s[0].oth_n = ifx s[0].oth_n < 2 then s[0].oth_n + 1 else 2;
      if kicked { s[0].oth_prev = s[0].oth_last; }
    } else if opp == 1 { s[0].bodies[RIVAL] = b; }
    opp += 1;
  }
  if opp == 0 { s[0].bodies[BOT] = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, -40.0, 0.0), DQ.{}); s[0].oth_n = 0; }
  if !mated { s[0].bodies[MATE] = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, -1030.0, 0.0), DQ.{}); }
  if opp < 2 { s[0].bodies[RIVAL] = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, -1040.0, 0.0), DQ.{}); }
  s[0].cars_n = ifx mated || opp > 1 then CARS else 2;
  // the round trip: the server sends back the last clock you sent
  echo := room_int(text, at[..], ok[..]);
  if ok[0] && echo >= 0 {
    trip := s[0].net_t - cast(f64) echo / 1000.0;
    if trip >= 0.0 && trip < 2.0 { s[0].rtt = ifx s[0].rtt <= 0.0 then trip else s[0].rtt + (trip - s[0].rtt) * 0.1; }
  }
  // the ball (the rollback): the room stepped it against your car as it was
  // a round trip ago, so replay it a round trip on against your car's steps
  // since, as you drove them; then fade the difference from where it was
  // drawn rather than jump
  shown := d3_add(s[0].bodies[BALL].pos, s[0].ball_err);
  s[0].bodies[BALL] = room_view(ball, seat);
  if phase == PHASE_PLAY && !kicked {
    n := cast(int) fmin(fmin(cast(f64) PREDICT_MAX, cast(f64) s[0].hist_n), floor(s[0].rtt / STEP + 0.5));
    cars: [CARS] RigidBody;
    for c: 1..<CARS { cars[c] = s[0].bodies[c + 1]; }
    for i: 0..<n {
      cars[0] = s[0].you_hist[(s[0].hist_n - n + i) % HIST];
      ball_step(s, cars[..], ifx others > 0 then s[0].cars_n else 1);
    }
  }
  err := d3_sub(shown, s[0].bodies[BALL].pos);
  s[0].ball_err = ifx kicked || d3_len(err) > SNAP then D3_ZERO else err;
}
// Every frame online: report your car, 60 times a second.
room_send :: (s: [] OrbitLeague, dt: f64) {
  if !s[0].online || !s[0].sock_open || s[0].sock < 0 { return; }
  s[0].send_t += dt;
  if s[0].send_t < 1.0 / ROOM_HZ - 0.002 { return; }
  s[0].send_t = 0.0;
  buf: [256] u8; k := 0;
  buf[k] = 'c'; k += 1;
  k = room_put_body(buf[..], k, room_view(s[0].bodies[YOU], s[0].seat));
  k = room_put_int(buf[..], k, cast(int) (s[0].net_t * 1000.0));
  if s[0].lag <= 0.0 { ok := pipe_send(s[0].pipe[..], s[0].sock, cast(string) buf[0..<k]); return; }
  if s[0].lag_on >= LAG_FRAMES { return; }
  slot := (s[0].lag_ohead + s[0].lag_on) % LAG_FRAMES;
  for i: 0..<k { s[0].lag_oq[slot][i] = buf[i]; }
  s[0].lag_olen[slot] = k; s[0].lag_odue[slot] = s[0].net_t + s[0].lag * 0.5; s[0].lag_on += 1;
}
// Every frame online (ol-prediction): the clock, the fading corrections, and
// ?lag's held frames let through when due; then your car's report.
room_frame :: (s: [] OrbitLeague, dt: f64) {
  if !s[0].online { return; }
  s[0].net_t += dt;
  s[0].ball_err = d3_scale(s[0].ball_err, exp(-dt / SMOOTH));
  while s[0].in_n > 0 && s[0].in_due[s[0].in_head] <= s[0].net_t {
    h := s[0].in_head;
    s[0].in_head = (h + 1) % LAG_FRAMES; s[0].in_n -= 1;
    room_take(s, cast(string) s[0].in_q[h][0..<s[0].in_len[h]]);
  }
  while s[0].lag_on > 0 && s[0].lag_odue[s[0].lag_ohead] <= s[0].net_t {
    h := s[0].lag_ohead;
    s[0].lag_ohead = (h + 1) % LAG_FRAMES; s[0].lag_on -= 1;
    if s[0].sock_open && s[0].sock >= 0 { ok := pipe_send(s[0].pipe[..], s[0].sock, cast(string) s[0].lag_oq[h][0..<s[0].lag_olen[h]]); }
  }
  room_send(s, dt);
}
// A state as it arrives: at once, or held ?lag's half when simulating latency.
room_heard :: (s: [] OrbitLeague, text: string) {
  if s[0].lag <= 0.0 { room_take(s, text); return; }
  if s[0].in_n >= LAG_FRAMES || text.count > LAG_BYTES { return; }
  slot := (s[0].in_head + s[0].in_n) % LAG_FRAMES;
  for i: 0..<text.count { s[0].in_q[slot][i] = text[i]; }
  s[0].in_len[slot] = text.count; s[0].in_due[slot] = s[0].net_t + s[0].lag * 0.5; s[0].in_n += 1;
}
// The other car as drawn: between its last two states, a state's gap behind (interpolation).
room_other :: (s: [] OrbitLeague) -> RigidBody {
  if !s[0].online || s[0].oth_n < 2 { return s[0].bodies[BOT]; }
  a := fclamp((s[0].net_t - s[0].oth_at) / fmax(s[0].oth_gap, 0.005), 0.0, 1.5);
  p := s[0].oth_prev; l := s[0].oth_last;
  out := l;
  out.pos = d3_add(p.pos, d3_scale(d3_sub(l.pos, p.pos), a));
  qp := p.orientation; ql := l.orientation;
  if qp.x * ql.x + qp.y * ql.y + qp.z * ql.z + qp.w * ql.w < 0.0 { qp = dq(-qp.x, -qp.y, -qp.z, -qp.w); }
  out.orientation = dq_unit(dq_axpy(qp, dq_axpy(ql, qp, -1.0), a));
  return out;
}
// ?NAME=digits in a URL: the number, or 0.
url_number :: (url: string, key: string) -> int {
  i := 0;
  while i + key.count <= url.count {
    if url[i..<i + key.count] == key {
      j := i + key.count; v := 0;
      while j < url.count && url[j] >= '0' && url[j] <= '9' && v < 100000 { v = v * 10 + cast(int) (url[j] - '0'); j += 1; }
      return v;
    }
    i += 1;
  }
  return 0;
}

// The maker's name, as sent (never read): up to MAKER_BYTES, not cutting a character.
take_maker :: (s: [] OrbitLeague, text: string) {
  n := least(text.count, MAKER_BYTES);
  if n < text.count { while n > 0 && (text[n] & 0xC0) == 0x80 { n -= 1; } }
  for i: 0..<n { s[0].maker[i] = text[i]; }
  s[0].maker_n = n;
}

// QUICK MATCH: this mode's queue on the room server (ol-quick-match).
quick_match :: (s: [] OrbitLeague) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, ifx s[0].cars_n == CARS then "/realms/orbit-league/?quick=2v2" else "/realms/orbit-league/?quick=1v1");
  s[0].action = ACT_NAVIGATE;
  track_tally(s[0].track[..], "quick", "");
}
// TIP: the maker's tip page.
tip :: (s: [] OrbitLeague) { if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/realms/orbit-league/tip"); s[0].action = ACT_NAVIGATE; } }

// A finger or the mouse on TIP: only TIP's own presses are taken.
tip_pointer :: (s: [] OrbitLeague, x: f32, y: f32, phase: int, kind: int, id: int) -> bool {
  on := s[0].tip_shown && inside(s[0].tip_box, x, y);
  if kind == 0 { s[0].tip_hover = on && phase != POINTER_CANCEL; }
  if phase == POINTER_DOWN && on { s[0].tip_down = true; s[0].tip_id = id; return true; }
  if !s[0].tip_down || id != s[0].tip_id { return false; }
  if phase == POINTER_MOVE { return true; }
  s[0].tip_down = false;
  if phase == POINTER_UP && on { tip(s); }
  return true;
}

game_golden :: (s: [] OrbitLeague, on: bool) #export_c { s[0].golden = on; }

hold_of :: (key: int) -> int {
  if key == KEY_UP || key == 'w' || key == 'W' { return HOLD_UP; }
  if key == KEY_DOWN || key == 's' || key == 'S' { return HOLD_DOWN; }
  if key == KEY_LEFT || key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == KEY_RIGHT || key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == ' ' { return HOLD_JUMP; }
  if key == KEY_SHIFT { return HOLD_BOOST; }
  return 0;
}

leave :: (s: [] OrbitLeague) { if s[0].action == 0 { s[0].out_n = put(s[0].outbox[..], 0, "/verse/galaxy"); s[0].action = ACT_NAVIGATE; } }

toggle_cam :: (s: [] OrbitLeague) {
  s[0].ball_cam = !s[0].ball_cam;
  track_setting(s[0].track[..], "ballcam", s[0].ball_cam);
}

play_again :: (s: [] OrbitLeague) {
  new_match(s);
  track_tally(s[0].track[..], "again", "");
}

game_key :: (s: [] OrbitLeague, key: int, mods: int) -> bool #export_c {
  if !s[0].started { game_reset(s); }
  if s[0].phase == PHASE_REPLAY { replay_end(s); return true; }
  track_key(s[0].track[..], key, false);
  h := hold_of(key);
  if h != 0 { s[0].held |= h; return true; }
  if key == 'c' || key == 'C' { toggle_cam(s); return true; }
  if key == KEY_ESCAPE { leave(s); return true; }
  if key == KEY_ENTER && s[0].phase == PHASE_OVER { play_again(s); return true; }
  return false;
}
game_key_up :: (s: [] OrbitLeague, key: int, mods: int) -> bool #export_c {
  if !s[0].started { game_reset(s); }
  track_key_up(s[0].track[..], key);
  h := hold_of(key);
  if h != 0 { s[0].held &= 63 - h; return true; }
  return false;
}
game_blur :: (s: [] OrbitLeague) #export_c {
  s[0].held = 0; s[0].stick = false; s[0].stick_dx = 0; s[0].stick_dy = 0;
  for b: 0..<BUTTONS { s[0].button_id[b] = -1; }
  track_blur(s[0].track[..]);
}

button_at :: (s: [] OrbitLeague, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if s[0].shown[i] && inside(s[0].boxes_ui[i], x, y) { return i; } }
  return -1;
}

game_pointer :: (s: [] OrbitLeague, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if !s[0].started { game_reset(s); }
  if kind == 1 { s[0].touch = true; }
  if s[0].phase == PHASE_REPLAY && phase == POINTER_DOWN && button_at(s, x, y) != BTN_BACK { replay_end(s); return true; }
  if tip_pointer(s, x, y, phase, kind, id) { s[0].hover = -1; return true; }
  b := button_at(s, x, y);
  s[0].hover = ifx kind == 0 && phase != POINTER_CANCEL then b else -1;
  track_pointer(s[0].track[..], x, y, phase, kind, "");
  if phase == POINTER_DOWN {
    if b >= 0 {
      s[0].button_id[b] = id;
      if b == BTN_CAM { toggle_cam(s); }
      if b == BTN_AGAIN { play_again(s); }
      if b == BTN_QUICK { quick_match(s); }
      if b == BTN_MODE { set_mode(s, ifx s[0].cars_n == CARS then 2 else CARS); track_tally(s[0].track[..], ifx s[0].cars_n == CARS then "2v2" else "1v1", ""); }
      if b == BTN_ARENA { set_arena_kind(s, (arena_kind(s) + 1) % 3); track_tally(s[0].track[..], ifx s[0].sphere then "sphere" else ifx s[0].drum then "drum" else "box", ""); }
      if b == BTN_BOOST { track_tally(s[0].track[..], "boost", ""); }
      return true;
    }
    if kind == 1 && x < s[0].width * 0.55 && !s[0].stick {
      s[0].stick = true; s[0].stick_id = id; s[0].stick_x0 = x; s[0].stick_y0 = y; s[0].stick_dx = 0; s[0].stick_dy = 0;
      return true;
    }
    return false;
  }
  for i: 0..<BUTTONS {
    if s[0].button_id[i] == id && phase != POINTER_MOVE {
      if i == BTN_BACK && phase == POINTER_UP && b == BTN_BACK { leave(s); }
      s[0].button_id[i] = -1;
      return true;
    }
  }
  if s[0].stick && id == s[0].stick_id {
    if phase == POINTER_MOVE {
      reach := STICK * hi(s[0].dpr, 0.5);
      s[0].stick_dx = clamp((x - s[0].stick_x0) / reach, -1, 1); s[0].stick_dy = clamp((y - s[0].stick_y0) / reach, -1, 1);
    } else { s[0].stick = false; s[0].stick_dx = 0; s[0].stick_dy = 0; s[0].stick_id = -1; }
    return true;
  }
  return false;
}
game_cursor :: (s: [] OrbitLeague) -> int #export_c { return ifx s[0].hover >= 0 || s[0].tip_hover then 1 else 0; }
game_action :: (s: [] OrbitLeague) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
game_action_done :: (s: [] OrbitLeague) #export_c { s[0].out_n = 0; }

// ---- the camera: behind your car, or behind it looking at the ball

f3 :: (v: D3) -> [3] f32 { o: [3] f32; o[0] = cast(f32) v.x; o[1] = cast(f32) v.y; o[2] = cast(f32) v.z; return o; }

// Leaning on the glass or tipped up off its wheels, and slow, or sliding on
// its roof or side along the floor or the glass: not driving anywhere (a car
// racing along a wall has its wheels on it).
leaning :: (s: [] OrbitLeague, b: RigidBody, st: VehicleState) -> bool {
  return d3_dot(rigid_axis(b, D3_Y), up_at(s, b.pos)) < 0.5 && st.wheels < 3 && (d3_len(b.vel) < 8.0 || near_surface(s, b.pos));
}

// Within a car's height of the floor or a wall.
near_surface :: (s: [] OrbitLeague, p: D3) -> bool {
  if s[0].sphere { return sphere_clearance(arena_sphere(), p) < 2.6; }
  if s[0].drum { return drum_clearance(arena_drum(), p) < 2.6 || abs(p.z) > ARENA_HZ - 1.4; }
  return p.y < 2.6 || abs(p.x) > ARENA_HX - 1.4 || (abs(p.z) > ARENA_HZ - 1.4 && abs(p.x) > GOAL_HW);
}

fsign :: (x: f64) -> f64 { return ifx x < 0.0 then -1.0 else 1.0; }
// Within a car's length of a side or end wall.
at_glass :: (s: [] OrbitLeague, p: D3) -> bool { return !s[0].sphere && ((!s[0].drum && abs(p.x) > ARENA_HX - 3.2) || abs(p.z) > ARENA_HZ - 3.2); }

// Where the eye can be: inside the glass, or in a goal's mouth.
eye_inside :: (e: D3, slack: f64, kind: int) -> bool {
  m := 0.8 - slack;
  // the sphere: anywhere inside its curve
  if kind == ARENA_SPHERE { return sphere_clearance(arena_sphere(), e) > m + 0.4; }
  drum := kind == ARENA_DRUM;
  if drum {
    // inside the curve, or down in a goal's mouth under it
    in_goal := abs(e.z) > ARENA_HZ - m && abs(e.x) < GOAL_HW - m && e.y > m && e.y < GOAL_H - m;
    if drum_clearance(arena_drum(), e) < m + 0.4 && !in_goal { return false; }
  } else if abs(e.x) > ARENA_HX - m || e.y < m || e.y > ARENA_H - m { return false; }
  // clear of the goal frames' posts and crossbar
  if abs(e.z) > ARENA_HZ - 2.5 && abs(e.z) < ARENA_HZ + 1.5 && abs(abs(e.x) - GOAL_HW) < 1.5 && e.y < GOAL_H + 1.5 { return false; }
  if abs(e.z) > ARENA_HZ - 2.5 && abs(e.z) < ARENA_HZ + 1.5 && abs(e.x) < GOAL_HW + 1.5 && abs(e.y - GOAL_H) < 1.5 { return false; }
  if abs(e.z) <= ARENA_HZ - m { return true; }
  return abs(e.z) <= ARENA_HZ + GOAL_D - 1.0 + slack && abs(e.x) < GOAL_HW - m && e.y < GOAL_H - m;
}

// The tangents of half the view's width and height (view_rows's lens).
Lens :: struct { tx: f64; ty: f64; }
lens_of :: (width: f32, height: f32) -> Lens {
  aspect := cast(f64) (width / hi(height, 1));
  t := 1.0 / tan(FOV * 0.5);
  sx := t / fmax(aspect, 0.3); sy := t;
  if aspect < 1.0 { sx = t * 1.25; sy = sx * aspect; }
  return Lens.{tx = 1.0 / sx, ty = 1.0 / sy};
}
// Where p lands looking from e along look: x, y as shares of the half width
// and half height (|x|, |y| < 1 on screen; y up); z < 0.3 is behind.
Lands :: struct { x: f64; y: f64; z: f64; }
lands :: (e: D3, look: D3, p: D3, l: Lens) -> Lands {
  r := d3_unit_or(d3(-look.z, 0.0, look.x), D3_X);
  u := d3_cross(r, look);
  if u.y < 0.0 { u = d3_neg(u); }
  d := d3_sub(p, e);
  z := d3_dot(d, look);
  if z < 0.3 { return Lands.{x = 9.0, y = 9.0, z = z}; }
  return Lands.{x = d3_dot(d, r) / z / l.tx, y = d3_dot(d, u) / z / l.ty, z = z};
}
// Framed: a car's length or two away, across the middle, above the phone's
// thumbs and below the score.
framed :: (q: Lands) -> bool { return q.z >= 5.0 && abs(q.x) < 0.8 && q.y > -0.6 && q.y < 0.75; }

Shot3 :: struct { eye: D3; at: D3; }

// Ball cam looks between the car and the ball, a little toward the ball.
ball_cam_look :: (e: D3, car: D3, ball: D3) -> D3 {
  u := d3_unit_or(d3_sub(d3_add(car, d3(0.0, 0.5, 0.0)), e), D3_Z);
  v := d3_unit_or(d3_sub(ball, e), D3_Z);
  return d3_unit_or(d3_add(d3_scale(u, 0.45), d3_scale(v, 0.55)), v);
}

// The shot: the eye behind the car along dir. Against the glass it comes in,
// rises or swings round the car, the least change that still frames the car
// (and on ball cam the ball); it never leaves the arena. If nothing frames
// both, your car wins: the edge marker shows where the ball is.
choose_shot :: (car: D3, dir: D3, ball: D3, ball_cam: bool, at: D3, l: Lens, kind: int) -> Shot3 {
  drum := kind != ARENA_BOX;
  rc := ifx kind == ARENA_SPHERE then SPHERE_R else DRUM_R;
  hh := ifx drum then 2.0 * rc else ARENA_H;
  hx := ifx drum then rc else ARENA_HX;
  best := Shot3.{}; best_cost := 1000000.0;
  near := Shot3.{}; near_cost := 1000000.0;
  carp := d3_add(car, d3(0.0, 0.5, 0.0));
  for h: 0..<3 { for r: 0..<4 { for k: 0..<13 {
    back := CAM_BACK - cast(f64) r * 2.0;
    up := CAM_UP + cast(f64) h * 3.0;
    turn := cast(f64) ((k + 1) / 2) * (PI_D / 12.0) * (ifx k % 2 == 1 then 1.0 else -1.0);
    c := cos(turn); sn := sin(turn);
    d := d3(dir.x * c + dir.z * sn, 0.0, -dir.x * sn + dir.z * c);
    e := d3_add(d3_sub(car, d3_scale(d, back)), d3(0.0, up, 0.0));
    e.y = fclamp(e.y, 0.8, hh - 0.8);
    if !eye_inside(e, 0.0, kind) { continue; }
    look := ifx ball_cam then ball_cam_look(e, car, ball) else d3_unit_or(d3_sub(at, e), d);
    cost := abs(turn) + 0.15 * (CAM_BACK - back) + 0.05 * (up - CAM_UP);
    qc := lands(e, look, carp, l);
    ok := framed(qc);
    if ball_cam { ok = ok && framed(lands(e, look, ball, l)); }
    if ok && cost < best_cost { best_cost = cost; best = Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
    // failing that: the nearest the car comes to the frame
    miss := fmax(abs(qc.x) - 0.8, 0.0) + fmax(-0.6 - qc.y, 0.0) + fmax(qc.y - 0.75, 0.0) + cost * 0.1;
    if miss < near_cost { near_cost = miss; near = Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
  } } }
  if best_cost < 1000000.0 { return best; }
  if near_cost >= 1000000.0 {
    // no eye fits round the car (deep in a goal): above it, looking ahead
    e := d3(fclamp(car.x, -hx + 0.8, hx - 0.8), fclamp(car.y + CAM_UP + 3.0, 0.8, hh - 0.8), fclamp(car.z, -ARENA_HZ - GOAL_D + 1.0, ARENA_HZ + GOAL_D - 1.0));
    e = d3_sub(e, d3_scale(dir, 2.0));
    if !eye_inside(e, 0.0, kind) { e.x = fclamp(e.x, -hx + 0.8, hx - 0.8); e.z = fclamp(e.z, -ARENA_HZ + 2.6, ARENA_HZ - 2.6); }
    if drum && !eye_inside(e, 0.0, kind) { e = d3(0.0, CAM_UP + 3.0, e.z); }
    return Shot3.{eye = e, at = d3_add(car, d3_scale(dir, 2.0))};
  }
  if !ball_cam { return near; }
  // nothing frames both (pinned in a corner with the ball high or behind):
  // your car stays in the frame, turned as far toward the ball as it allows
  e := near.eye;
  u := d3_unit_or(d3_sub(carp, e), D3_Z); v := d3_unit_or(d3_sub(ball, e), D3_Z);
  for i: 0..<12 {
    t := 0.55 - cast(f64) i * 0.05;
    look := d3_unit_or(d3_add(d3_scale(u, 1.0 - t), d3_scale(v, t)), u);
    if framed(lands(e, look, carp, l)) || i == 11 { return Shot3.{eye = e, at = d3_add(e, d3_scale(look, 10.0))}; }
  }
  return near;
}

// A goal's replay from three cameras, cut as it plays: behind the ball toward
// the goal, from the side, then from the goal it went into.
replay_camera :: (s: [] OrbitLeague, dt: f32) {
  bl := s[0].bodies[BALL].pos;
  gs := ifx s[0].last_goal == BLUE then 1.0 else -1.0;
  left := cast(f64) (s[0].rp_end - s[0].rp_step) * STEP;
  cut := ifx left > 3.0 then 0 else ifx left > 1.5 then 1 else 2;
  if cut != s[0].rp_cut { s[0].rp_cut = cut; s[0].cam_ready = false; }
  turn := frame_at(s, bl);
  on := to_floor(s, bl, turn);
  eye := D3_ZERO;
  if cut == 0 { eye = from_floor(s, d3_add(on, d3(0.0, 4.0, -10.0 * gs)), turn); }
  if cut == 1 { eye = from_floor(s, d3_add(on, d3(ifx on.x > 0.0 then -12.0 else 12.0, 5.0, -2.0 * gs)), turn); }
  if cut == 2 {
    eye = ifx s[0].sphere then d3(0.0, SPHERE_R, gs * (SPHERE_R - 4.0)) else d3(0.0, GOAL_H + 3.0, gs * (ARENA_HZ - 2.0));
  }
  // kept inside the arena: drawn in toward the ball until it is
  for i: 0..<12 { if eye_inside(eye, 0.0, arena_kind(s)) { break; } eye = d3_add(eye, d3_scale(d3_sub(bl, eye), 0.2)); }
  up := dq_rotate(turn, D3_Y);
  e := f3(eye); a := f3(bl); w := f3(up);
  k: f32 = ifx s[0].cam_ready then 1 - exp(-dt * 10.0) else 1;
  for i: 0..<3 {
    s[0].cam_eye[i] += (e[i] - s[0].cam_eye[i]) * k; s[0].cam_at[i] += (a[i] - s[0].cam_at[i]) * k;
    s[0].cam_up[i] += (w[i] - s[0].cam_up[i]) * k;
  }
  s[0].cam_ready = true;
}
camera :: (s: [] OrbitLeague, dt: f32) {
  if s[0].phase == PHASE_REPLAY { replay_camera(s, dt); return; }
  car := s[0].bodies[YOU]; bl := s[0].bodies[BALL];
  // in the drum the shot is found as if the car were on the floor's lowest
  // line, then turned back round the axis to where it is
  turn := frame_at(s, car.pos);
  if curved(s) {
    car.pos = to_floor(s, car.pos, turn); car.vel = dq_rotate(dq_conj(turn), car.vel);
    car.orientation = dq_mul(dq_conj(turn), car.orientation);
    bl.pos = to_floor(s, bl.pos, turn);
  }
  f := rigid_axis(car, D3_Z);
  dir := d3_unit_or(d3(f.x, 0.0, f.z), D3_Z);
  // moving fast: look the way it goes
  flat_v := d3(car.vel.x, 0.0, car.vel.z);
  if d3_len(flat_v) > 4.0 && d3_dot(flat_v, dir) > 0.0 { dir = d3_unit_or(d3_add(dir, d3_scale(d3_unit(flat_v), 0.6)), dir); }
  at := d3_add(car.pos, d3_add(d3_scale(dir, 4.0), d3(0.0, 1.0, 0.0)));
  // ball cam: behind the car on the line from the ball
  if s[0].ball_cam { to := d3_sub(bl.pos, car.pos); dir = d3_unit_or(d3(to.x, 0.0, to.z), dir); }
  shot := choose_shot(car.pos, dir, bl.pos, s[0].ball_cam, at, lens_of(s[0].width, s[0].height), arena_kind(s));
  up := D3_Y;
  if curved(s) { shot.eye = from_floor(s, shot.eye, turn); shot.at = from_floor(s, shot.at, turn); up = dq_rotate(turn, D3_Y); }
  e := f3(shot.eye); a := f3(shot.at); w := f3(up);
  k: f32 = ifx s[0].cam_ready then 1 - exp(-dt * 7.0) else 1;
  for i: 0..<3 {
    s[0].cam_eye[i] += (e[i] - s[0].cam_eye[i]) * k; s[0].cam_at[i] += (a[i] - s[0].cam_at[i]) * k;
    s[0].cam_up[i] += (w[i] - s[0].cam_up[i]) * k;
  }
  s[0].cam_ready = true;
}

view_rows :: (s: [] OrbitLeague) {
  aspect := s[0].width / hi(s[0].height, 1);
  ex := s[0].cam_eye[0]; ey := s[0].cam_eye[1]; ez := s[0].cam_eye[2];
  // a hit or a goal shakes the camera a little
  if s[0].shake > 0.01 && !s[0].golden && !s[0].still {
    m := cast(f32) s[0].shake * 0.28; t := s[0].time;
    ex += sin(t * 53.0) * m; ey += sin(t * 47.0 + 1.3) * m * 0.7; ez += sin(t * 41.0 + 2.1) * m;
  }
  fx := s[0].cam_at[0] - ex; fy := s[0].cam_at[1] - ey; fz := s[0].cam_at[2] - ez;
  fl := hi(sqrt(fx * fx + fy * fy + fz * fz), 0.001); fx /= fl; fy /= fl; fz /= fl;
  // right = forward x up, up = right x forward (up is +y outside the drum)
  upx := s[0].cam_up[0]; upy := s[0].cam_up[1]; upz := s[0].cam_up[2];
  if upx * upx + upy * upy + upz * upz < 0.01 { upx = 0; upy = 1; upz = 0; }
  rx := fy * upz - fz * upy; ry := fz * upx - fx * upz; rz := fx * upy - fy * upx;
  rl := hi(sqrt(rx * rx + ry * ry + rz * rz), 0.001); rx /= rl; ry /= rl; rz /= rl;
  ux := ry * fz - rz * fy; uy := rz * fx - rx * fz; uz := rx * fy - ry * fx;
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 1.25; sy = sx * aspect; }
  s[0].sy = sy;
  zn: f32 = 0.1; zf: f32 = 400.0;
  a := zf / (zn - zf); b := zn * zf / (zn - zf);
  v := s[0].view[..];
  v[0] = sx * rx; v[1] = sx * ry; v[2] = sx * rz; v[3] = -sx * (rx * ex + ry * ey + rz * ez);
  v[4] = sy * ux; v[5] = sy * uy; v[6] = sy * uz; v[7] = -sy * (ux * ex + uy * ey + uz * ez);
  v[8] = -a * fx; v[9] = -a * fy; v[10] = -a * fz; v[11] = a * (fx * ex + fy * ey + fz * ez) + b;
  v[12] = fx; v[13] = fy; v[14] = fz; v[15] = -(fx * ex + fy * ey + fz * ez);
  s[0].eye[0] = ex; s[0].eye[1] = ey; s[0].eye[2] = ez;
  s[0].fwd[0] = fx; s[0].fwd[1] = fy; s[0].fwd[2] = fz;
  s[0].right[0] = rx / sx; s[0].right[1] = ry / sx; s[0].right[2] = rz / sx;
  s[0].up[0] = ux / sy; s[0].up[1] = uy / sy; s[0].up[2] = uz / sy;
}

Seen :: struct { x: f32; y: f32; ok: bool; w: f32; }
seen :: (s: [] OrbitLeague, x: f32, y: f32, z: f32) -> Seen {
  v := s[0].view[..];
  cx := v[0] * x + v[1] * y + v[2] * z + v[3];
  cy := v[4] * x + v[5] * y + v[6] * z + v[7];
  cw := v[12] * x + v[13] * y + v[14] * z + v[15];
  if cw < 0.01 { return Seen.{x = 0, y = 0, ok = false, w = 0}; }
  return Seen.{x = (cx / cw * 0.5 + 0.5) * s[0].width, y = (0.5 - cy / cw * 0.5) * s[0].height, ok = true, w = cw};
}

// ---- the HUD

GAP :: 0.5; SPACE :: 1.2;
PARCH_R :: 0.93; PARCH_G :: 0.95; PARCH_B :: 1.0;
TEAM_B_R :: 0.30; TEAM_B_G :: 0.62; TEAM_B_B :: 1.0;
TEAM_O_R :: 1.0; TEAM_O_G :: 0.28; TEAM_O_B :: 0.78;
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;
white :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, PARCH_R, PARCH_G, PARCH_B); }
team_ink :: (team: int, k: f32, light: f32) -> Ink {
  if team == BLUE { return ink(0.6 * k, light, 1.6 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B); }
  return ink(0.6 * k, light, 1.6 * k, TEAM_O_R, TEAM_O_G, TEAM_O_B);
}
plate :: (s: [] OrbitLeague, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  s[0].plates[n] = b; s[0].plate_alpha[n] = alpha; s[0].plate_look[n] = look; s[0].plate_n = n + 1;
}
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  w := measure(text, GAP, SPACE, false) * cap;
  return write(d, out, at, text, x - w * 0.5, base, cap, GAP, SPACE, k, false, false);
}
clock_text :: (buf: [] u8, at: int, seconds: f64) -> int {
  t := cast(int) ceil_d(fmax(seconds, 0.0));
  n := put_int(buf, at, t / 60); n = put(buf, n, ":");
  if t % 60 < 10 { n = put(buf, n, "0"); }
  return put_int(buf, n, t % 60);
}
hud_button :: (s: [] OrbitLeague, out: [] f32, at: int, which: int, b: Box, label: string, cap: f32) -> int {
  k := s[0].dpr;
  s[0].boxes_ui[which] = b; s[0].shown[which] = true;
  look: f32 = LOOK_LIT;
  if s[0].hover == which || s[0].button_id[which] >= 0 { look += LOOK_HOVER; }
  plate(s, b, 0.85, look);
  return centred(k, out, at, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, white(k, 0.95));
}

// MADE BY <NAME> · TIP along the bottom, centred between x0 and x1 (small,
// dim; TIP in Bitcoin's orange). Nothing without a maker.
maker_line :: (s: [] OrbitLeague, out: [] f32, at: int, x0: f32, x1: f32, base: f32) -> int {
  s[0].tip_shown = false;
  if s[0].maker_n == 0 { return at; }
  k := s[0].dpr;
  lead: [MAKER_BYTES + 16] u8;
  n := put(lead[..], 0, "MADE BY "); n = put(lead[..], n, cast(string) s[0].maker[0..<s[0].maker_n]); n = put(lead[..], n, " · ");
  left := cast(string) lead[0..<n];
  lw := measure(left, GAP, SPACE, false); tw := measure("TIP", GAP, SPACE, false);
  cap := lo(6 * k, (x1 - x0) / hi(lw + tw, 1));
  x := (x0 + x1) * 0.5 - (lw + tw) * cap * 0.5;
  v := write(k, out, at, left, x, base, cap, GAP, SPACE, white(k, 0.55), false, false);
  tx := x + lw * cap;
  hot := s[0].tip_hover || s[0].tip_down;
  v = write(k, out, v, "TIP", tx, base, cap, GAP, SPACE, ink(0.6 * k, ifx hot then 1.0f32 else 0.8f32, 2 * k, ORANGE_R, ORANGE_G, ORANGE_B), false, false);
  s[0].tip_box = Box.{x0 = tx - 8 * k, y0 = base - cap - 10 * k, x1 = tx + tw * cap + 8 * k, y1 = base + 8 * k};
  s[0].tip_shown = true;
  return v;
}

draw_hud :: (s: [] OrbitLeague, out: [] f32) -> int {
  k := s[0].dpr; w := s[0].width; h := s[0].height; d := k;
  phone := w < 700 * k;
  g := 14 * k;
  v := 0;
  buf: [64] u8;
  v = draw_sparks(s, out, v);
  // the score and the clock, top middle
  sw := lo(236 * k, w - 2 * (g + 104 * k));
  sb := Box.{x0 = w * 0.5 - sw * 0.5, y0 = g, x1 = w * 0.5 + sw * 0.5, y1 = g + 46 * k};
  plate(s, sb, 0.88, LOOK_PLAIN);
  n := put_int(buf[..], 0, s[0].score[0]);
  v = centred(d, out, v, cast(string) buf[0..<n], sb.x0 + 34 * k, sb.y0 + 32 * k, 18 * k, team_ink(BLUE, k, 1));
  n = put_int(buf[..], 0, s[0].score[1]);
  v = centred(d, out, v, cast(string) buf[0..<n], sb.x1 - 34 * k, sb.y0 + 32 * k, 18 * k, team_ink(MAGENTA, k, 1));
  n = ifx s[0].overtime then put(buf[..], 0, "+OT") else clock_text(buf[..], 0, s[0].clock);
  v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y0 + 29 * k, 12 * k, white(k, 0.95));
  // GALAXY, top left
  bb := Box.{x0 = g, y0 = g, x1 = g + 96 * k, y1 = g + 34 * k};
  v = hud_button(s, out, v, BTN_BACK, bb, "GALAXY", 8 * k);
  // the station's spin
  sc := spin_clock(s[0].played, s[0].spin_every);
  if s[0].phase != PHASE_OVER && sc > 0.0 {
    n = put(buf[..], 0, "SPIN-DOWN  ZERO-G  "); n = clock_text(buf[..], n, sc);
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y1 + 26 * k, 9 * k, ink(0.6 * k, 1, 2 * k, 0.6, 0.95, 1.0));
  } else if s[0].phase == PHASE_PLAY && sc > -6.0 {
    n = put(buf[..], 0, "SPIN-DOWN IN "); n = put_int(buf[..], n, cast(int) ceil_d(-sc));
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, sb.y1 + 26 * k, 9 * k, white(k, 0.85));
  }
  // the middle: the countdown, a goal, the end
  if s[0].phase == PHASE_KICKOFF && s[0].phase_t < 0.0 {
    v = centred(d, out, v, "FINDING PLAYERS", w * 0.5, h * 0.3, 16 * k, white(k * 1.4, 1));
    n = put_int(buf[..], 0, cast(int) ceil_d(-s[0].phase_t));
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, h * 0.3 + 34 * k, 11 * k, white(k, 0.8));
  } else if s[0].phase == PHASE_KICKOFF {
    left := cast(int) ceil_d(KICKOFF - s[0].phase_t);
    n = put_int(buf[..], 0, left);
    v = centred(d, out, v, cast(string) buf[0..<n], w * 0.5, h * 0.3, 52 * k, ink(1.5 * k, 1, 4 * k, PARCH_R, PARCH_G, PARCH_B));
  }
  if s[0].phase == PHASE_PLAY && s[0].phase_t < 0.8 && s[0].played < 1.0 + s[0].phase_t {
    v = centred(d, out, v, "GO", w * 0.5, h * 0.3, 52 * k, ink(1.5 * k, cast(f32) (1.0 - s[0].phase_t / 0.8), 4 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B));
  }
  if s[0].phase == PHASE_GOAL {
    v = centred(d, out, v, "GOAL", w * 0.5, h * 0.3, 52 * k, team_ink(s[0].last_goal, k * 2, 1));
    two := s[0].cars_n == CARS;
    v = centred(d, out, v, ifx s[0].last_goal == BLUE then (ifx two then "YOUR TEAM SCORED" else "YOU SCORED") else (ifx two then "THE BOTS SCORED" else "THE BOT SCORED"), w * 0.5, h * 0.3 + 34 * k, 11 * k, white(k * 1.4, 1));
  }
  if s[0].phase == PHASE_REPLAY {
    v = centred(d, out, v, "REPLAY", w * 0.5, h * 0.18, 14 * k, team_ink(s[0].last_goal, k, 1));
  }
  if s[0].online && s[0].sock_state != ROOM_IN {
    v = centred(d, out, v, ifx s[0].sock_state == ROOM_LOST then "LOST THE ROOM: PLAYING ON YOUR OWN" else "JOINING THE ROOM", w * 0.5, h * 0.3 + 70 * k, 9 * k, white(k, 0.8));
  }
  if s[0].phase == PHASE_OVER {
    won := s[0].score[0] > s[0].score[1];
    two := s[0].cars_n == CARS;
    v = centred(d, out, v, ifx won then (ifx two then "YOUR TEAM WINS" else "YOU WIN") else (ifx two then "THE BOTS WIN" else "THE BOT WINS"), w * 0.5, h * 0.38, 26 * k, team_ink(ifx won then BLUE else MAGENTA, k, 1));
    ab := Box.{x0 = w * 0.5 - 90 * k, y0 = h * 0.38 + 24 * k, x1 = w * 0.5 + 90 * k, y1 = h * 0.38 + 66 * k};
    v = hud_button(s, out, v, BTN_AGAIN, ab, "PLAY AGAIN", 10 * k);
    db := Box.{x0 = ab.x0, y0 = ab.y1 + 12 * k, x1 = ab.x1, y1 = ab.y1 + 46 * k};
    v = hud_button(s, out, v, BTN_ARENA, db, ifx s[0].sphere then "PLAY IN THE BOX" else ifx s[0].drum then "PLAY IN THE SPHERE" else "PLAY IN THE DRUM", 8 * k);
    if !s[0].online {
      mb := Box.{x0 = db.x0, y0 = db.y1 + 10 * k, x1 = db.x1, y1 = db.y1 + 44 * k};
      v = hud_button(s, out, v, BTN_MODE, mb, ifx s[0].cars_n == CARS then "PLAY 1V1" else "PLAY 2V2", 8 * k);
      qb := Box.{x0 = db.x0, y0 = mb.y1 + 10 * k, x1 = db.x1, y1 = mb.y1 + 44 * k};
      v = hud_button(s, out, v, BTN_QUICK, qb, ifx s[0].cars_n == CARS then "QUICK MATCH 2V2" else "QUICK MATCH 1V1", 8 * k);
    }
  }
  // boost, bottom right (above the buttons on a phone)
  fuel := cast(f32) s[0].tanks[0].fuel;
  n = put_int(buf[..], 0, cast(int) fuel);
  thumbs := s[0].touch || phone;
  // a gauge: the tank as an arc round its number
  rr := 30 * k;
  gx := w - g - rr - 6 * k; gy := ifx thumbs then h - 2 * 46 * k - g - rr - 34 * k else h - g - rr - 8 * k;
  v = centred(d, out, v, cast(string) buf[0..<n], gx, gy + 6 * k, 15 * k, ink(0.6 * k, 1, 2 * k, 0.92, 0.95, 1.0));
  v = centred(d, out, v, "BOOST", gx, gy + 19 * k, 5.5 * k, white(k, 0.7));
  hot: f32 = ifx s[0].boosting[0] then 1.6 else 1.0;
  for q: 0..<ARC {
    a0 := 2.356 + cast(f32) q / ARC * 4.712; a1 := 2.356 + cast(f32) (q + 1) / ARC * 4.712;
    on := cast(f32) q < fuel / 100 * ARC;
    if lit(out, v, gx + cos(a0) * rr, gy + sin(a0) * rr, gx + cos(a1) * rr, gy + sin(a1) * rr,
           ifx on then 2.2 * k else 0.8 * k, ifx on then hot else 0.25, ifx on then 4 * k * hot else 1 * k,
           ifx on then 0.55 else 1, ifx on then 0.8 else 1, 1.0, MODE_STROKE) { v += 6; }
  }
  if thumbs {
    // the right thumb's buttons, and the left thumb's stick
    r := 46 * k;
    jb := Box.{x0 = w - g - 2 * r, y0 = h - g - 2 * r, x1 = w - g, y1 = h - g};
    v = hud_button(s, out, v, BTN_JUMP, jb, "JUMP", 9 * k);
    ob := Box.{x0 = jb.x0 - 2 * r - 12 * k, y0 = h - g - 1.6 * r, x1 = jb.x0 - 12 * k, y1 = h - g + 0.4 * r - 0.4 * r};
    v = hud_button(s, out, v, BTN_BOOST, ob, "BOOST", 9 * k);
    cb := Box.{x0 = w - g - 92 * k, y0 = sb.y1 + 40 * k, x1 = w - g, y1 = sb.y1 + 70 * k};
    v = hud_button(s, out, v, BTN_CAM, cb, ifx s[0].ball_cam then "CAR CAM" else "BALL CAM", 7 * k);
    if s[0].stick {
      cx := s[0].stick_x0; cy := s[0].stick_y0; reach := STICK * k;
      for q: 0..<24 {
        a0 := cast(f32) q / 24.0 * 6.2831853; a1 := cast(f32) (q + 1) / 24.0 * 6.2831853;
        if lit(out, v, cx + cos(a0) * reach, cy + sin(a0) * reach, cx + cos(a1) * reach, cy + sin(a1) * reach, 0.6 * k, 0.5, 1.5 * k, 1, 1, 1, MODE_STROKE) { v += 6; }
      }
      if tinted_dot(out, v, cx + s[0].stick_dx * reach, cy + s[0].stick_dy * reach, 14 * k, 0.9, 6 * k, TEAM_B_R, TEAM_B_G, TEAM_B_B) { v += 6; }
    } else if s[0].played < 20 {
      v = centred(d, out, v, "DRAG HERE TO DRIVE", w * 0.25, h - 60 * k, 7.5 * k, white(k, 0.6));
    }
    // the maker's line: bottom left, beside BOOST
    v = maker_line(s, out, v, g, ob.x0 - 12 * k, h - g - 4 * k);
  } else {
    cb := Box.{x0 = w - g - 112 * k, y0 = g, x1 = w - g, y1 = g + 34 * k};
    v = hud_button(s, out, v, BTN_CAM, cb, ifx s[0].ball_cam then "CAR CAM  C" else "BALL CAM  C", 7.5 * k);
    if s[0].played < 25 && s[0].phase != PHASE_OVER {
      hint := "W S DRIVE   A D STEER   SPACE JUMP, AGAIN WITH W A S D TO FLIP   SHIFT BOOST";
      v = centred(d, out, v, hint, w * 0.5, h - 30 * k, lo(8 * k, (w - 2 * g) / hi(measure(hint, GAP, SPACE, false), 1)), white(k, 0.65));
    }
    // the maker's line: bottom middle, under the hint, clear of the boost gauge
    v = maker_line(s, out, v, g + 110 * k, w - g - 110 * k, h - 12 * k);
  }
  // the ball, when it is off the screen: a marker at the edge toward it,
  // clear of the score and, on a phone, of the thumbs
  m := ball_marker(s, w, h, k, phone);
  if m.ok && tinted_dot(out, v, m.x, m.y, 7 * k, 1, 8 * k, 1, 1, 1) { v += 6; }
  return v;
}

// Where the off-screen ball's marker goes: from the screen's middle toward
// the ball (behind you: toward its side, along the bottom), to the edge of
// the space the HUD leaves.
Marker :: struct { x: f32; y: f32; ok: bool; }
ball_marker :: (s: [] OrbitLeague, w: f32, h: f32, k: f32, phone: bool) -> Marker {
  bp := s[0].bodies[BALL].pos;
  sp := seen(s, cast(f32) bp.x, cast(f32) bp.y, cast(f32) bp.z);
  if sp.ok && sp.x >= 0 && sp.x <= w && sp.y >= 0 && sp.y <= h { return Marker.{}; }
  x0 := 40 * k; x1 := w - 40 * k; y0 := 90 * k;
  y1 := ifx phone then h - 210 * k else h - 60 * k;
  cx := w * 0.5; cy := (y0 + y1) * 0.5;
  dx: f32; dy: f32;
  if sp.ok { dx = sp.x - cx; dy = sp.y - cy; }
  else {
    // behind the eye: its side on the screen's right, and down
    rx := cast(f32) bp.x - s[0].eye[0]; rz := cast(f32) bp.z - s[0].eye[2];
    side := rx * s[0].right[0] + rz * s[0].right[2];
    dx = ifx side > 0 then w else -w; dx *= 0.25; dy = h;
  }
  if abs(dx) < 0.001 && abs(dy) < 0.001 { dy = 1; }
  // scale the direction to the box's edge
  tx: f32 = ifx abs(dx) > 0.001 then (ifx dx > 0 then (x1 - cx) / dx else (x0 - cx) / dx) else 1000000;
  ty: f32 = ifx abs(dy) > 0.001 then (ifx dy > 0 then (y1 - cy) / dy else (y0 - cy) / dy) else 1000000;
  t := lo(tx, ty);
  return Marker.{x = clamp(cx + dx * t, x0, x1), y = clamp(cy + dy * t, y0, y1), ok = true};
}

// ---- the frame

put_car :: (u: [] f32, at: int, b: RigidBody, boost: bool, team: int, steer: f64, spin: f64) {
  x := rigid_axis(b, D3_X); y := rigid_axis(b, D3_Y); z := rigid_axis(b, D3_Z);
  u[at] = cast(f32) b.pos.x; u[at + 1] = cast(f32) b.pos.y; u[at + 2] = cast(f32) b.pos.z; u[at + 3] = ifx boost then 1.0f32 else 0.0f32;
  u[at + 4] = cast(f32) x.x; u[at + 5] = cast(f32) x.y; u[at + 6] = cast(f32) x.z; u[at + 7] = cast(f32) team;
  u[at + 8] = cast(f32) y.x; u[at + 9] = cast(f32) y.y; u[at + 10] = cast(f32) y.z; u[at + 11] = cast(f32) spin;
  u[at + 12] = cast(f32) z.x; u[at + 13] = cast(f32) z.y; u[at + 14] = cast(f32) z.z; u[at + 15] = cast(f32) steer;
}

game_frame :: (s: [] OrbitLeague, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || u.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  if !s[0].started { game_reset(s); }
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = still;
  step := clamp(dt, 0, 0.1);
  if !s[0].golden { s[0].time += step; }
  s[0].replays = !s[0].golden && !s[0].online;
  game_step(s, cast(f64) step);
  room_frame(s, cast(f64) step);
  if !s[0].golden { effects_step(s, cast(f64) step); }
  if s[0].jumped[0] { s[0].jumped[0] = false; track_tally(s[0].track[..], "jump", ""); }
  camera(s, step);
  view_rows(s);
  s[0].plate_n = 0;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  s[0].tip_shown = false;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = ifx still || s[0].golden then 20.0f32 else s[0].time;
  u[3] = 1; u[4] = ifx still || s[0].golden then 1.0f32 else 0.0f32; u[6] = s[0].dpr;
  u[7] = cast(f32) (1.0 - s[0].spin_now);
  for i: 0..<16 { u[VIEW_AT + i] = s[0].view[i]; }
  for i: 0..<3 { u[EYE_AT + i] = s[0].eye[i]; u[FWD_AT + i] = s[0].fwd[i]; u[RX_AT + i] = s[0].right[i]; u[UY_AT + i] = s[0].up[i]; }
  // the goal's flash: its share, then the team
  if s[0].phase == PHASE_GOAL { u[EYE_AT + 3] = cast(f32) fmax(0.0, 1.0 - s[0].phase_t / 1.5); u[FWD_AT + 3] = cast(f32) s[0].last_goal; }
  bl := s[0].bodies[BALL];
  bl.pos = d3_add(bl.pos, s[0].ball_err);
  u[BALL_AT] = cast(f32) bl.pos.x; u[BALL_AT + 1] = cast(f32) bl.pos.y; u[BALL_AT + 2] = cast(f32) bl.pos.z; u[BALL_AT + 3] = cast(f32) BALL_R;
  q := bl.orientation;
  u[MISC_AT] = cast(f32) d3_len(bl.vel);
  u[BALLQ_AT] = cast(f32) q.x; u[BALLQ_AT + 1] = cast(f32) q.y; u[BALLQ_AT + 2] = cast(f32) q.z; u[BALLQ_AT + 3] = cast(f32) q.w;
  put_car(u, CAR_AT, s[0].bodies[YOU], s[0].boosting[0], BLUE, s[0].cars[0].steer_now, s[0].wheel_spin[0]);
  put_car(u, CAR_AT + CAR_FLOATS, room_other(s), s[0].boosting[1], MAGENTA, s[0].cars[1].steer_now, s[0].wheel_spin[1]);
  for c: 2..<CARS { put_car(u, CARS2_AT + (c - 2) * CAR_FLOATS, s[0].bodies[c + 1], s[0].boosting[c], c % 2, s[0].cars[c].steer_now, s[0].wheel_spin[c]); }
  u[MISC_AT + 1] = cast(f32) s[0].cars_n;
  u[ARENA_AT] = cast(f32) ARENA_HX; u[ARENA_AT + 1] = cast(f32) ARENA_HZ; u[ARENA_AT + 2] = cast(f32) ARENA_H; u[ARENA_AT + 3] = cast(f32) GOAL_HW;
  u[GOAL_AT] = cast(f32) GOAL_H; u[GOAL_AT + 1] = cast(f32) GOAL_D; u[GOAL_AT + 2] = ifx s[0].sphere then cast(f32) -SPHERE_R else ifx s[0].drum then cast(f32) DRUM_R else 0;
  u[GOAL_AT + 3] = cast(f32) SPHERE_GOAL_R;
  put_trail(u, TRAIL_AT, bl.pos, ball_glow(s), s[0].ball_trail[..], s[0].ball_k[..], 0);
  for c: 0..<2 {
    put_trail(u, TRAIL_AT + (c + 1) * (TRAIL_N + 1) * 4, nozzle(s[0].bodies[c + 1]), ifx s[0].boosting[c] then 1.0 else 0.0,
              s[0].boost_trail[..], s[0].boost_k[..], c * TRAIL_N);
  }
  u[BLAST_AT] = cast(f32) s[0].blast.x; u[BLAST_AT + 1] = cast(f32) s[0].blast.y; u[BLAST_AT + 2] = cast(f32) s[0].blast.z;
  u[BLAST_AT + 3] = cast(f32) s[0].blast_t; u[BLAST_AT + 4] = cast(f32) s[0].blast_team;
  for i: 0..<PADS {
    p := pad_at(i); o := PADS_AT + i * 4;
    u[o] = cast(f32) p.x; u[o + 1] = cast(f32) (ifx s[0].sphere then p.z * SPHERE_PAD_Z else p.z); u[o + 2] = cast(f32) p.y; u[o + 3] = cast(f32) (1.0 - s[0].pad_wait[i] / pad_wait_of(i));
  }
  n := ifx s[0].card then draw_sparks(s, out, 0) else draw_hud(s, out);
  u[5] = cast(f32) s[0].plate_n;
  for i: 0..<s[0].plate_n {
    o := PANEL_AT + i * 8; b := s[0].plates[i];
    u[o] = b.x0; u[o + 1] = b.y0; u[o + 2] = b.x1; u[o + 3] = b.y1;
    u[o + 4] = s[0].dpr; u[o + 5] = s[0].plate_alpha[i]; u[o + 6] = s[0].plate_look[i]; u[o + 7] = 0;
  }
  if n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  track_frame(s[0].track[..], dt, width, height, dpr);
  return n;
}

coaxial_orbitleague_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_orbitleague_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_orbitleague_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- checks

run_for :: (s: [] OrbitLeague, seconds: f64) {
  steps := cast(int) (seconds / STEP);
  for i: 0..<steps { game_step(s, STEP); }
}

#test "kickoff counts down, then you drive and boost toward the ball" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].width = 1440; s[0].height = 900; s[0].dpr = 1;
  run_for(s[..], 1.0);
  #assert s[0].phase == PHASE_KICKOFF && s[0].cars[0].wheels == 4;
  z0 := s[0].bodies[YOU].pos.z;
  run_for(s[..], 2.1);
  #assert s[0].phase == PHASE_PLAY;
  s[0].held = HOLD_UP | HOLD_BOOST;
  run_for(s[..], 1.0);
  #assert s[0].bodies[YOU].pos.z > z0 + 8.0 && s[0].tanks[0].fuel < BOOST_START + PAD_SMALL - 10.0;
}

#test "driving into the ball moves it; a ball past the line scores and kicks off again" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].held = HOLD_UP;
  run_for(s[..], 3.0);
  #assert d3_len(s[0].bodies[BALL].vel) > 1.0 || abs(s[0].bodies[BALL].pos.z) > 1.0;
  // put the ball in the bot's net
  s[0].bodies[BALL].pos = d3(0.0, 2.0, ARENA_HZ + 1.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 10.0);
  run_for(s[..], 0.5);
  #assert s[0].score[0] == 1 && s[0].phase == PHASE_GOAL;
  // the net holds it
  #assert s[0].bodies[BALL].pos.z < ARENA_HZ + GOAL_D;
  run_for(s[..], CELEBRATE);
  #assert s[0].phase == PHASE_KICKOFF && abs(s[0].bodies[BALL].pos.z) < 0.01;
}

#test "a ball hit at the wall beside the goal bounces back; the roof and walls hold it" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[BALL].pos = d3(15.0, 3.0, 30.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 40.0);
  run_for(s[..], 1.0);
  #assert s[0].score[0] == 0 && s[0].bodies[BALL].vel.z < 0.0;
  s[0].bodies[BALL].pos = d3(0.0, 10.0, 0.0);
  s[0].bodies[BALL].vel = d3(30.0, 30.0, 0.0);
  run_for(s[..], 2.0);
  p := s[0].bodies[BALL].pos;
  #assert abs(p.x) < ARENA_HX && p.y < ARENA_H && p.y > 0.0;
}

#test "a goal sets off its blast and sparks, a hard hit throws sparks, and both die away" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[BALL].pos = d3(0.0, 2.0, ARENA_HZ + 1.0);
  s[0].bodies[BALL].vel = d3(0.0, 0.0, 10.0);
  run_for(s[..], 0.1);
  #assert s[0].blast_t >= 0.0 && s[0].blast_team == BLUE && s[0].shake > 0.5;
  alive := 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert alive >= 90;
  for i: 0..<cast(int) ((BLAST_LIFE + 0.1) / STEP) { effects_step(s[..], STEP); }
  alive = 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert s[0].blast_t < 0.0 && alive == 0 && s[0].shake < 0.01;
  // a car at speed into the ball
  run_for(s[..], CELEBRATE + KICKOFF + 0.1);
  s[0].bodies[YOU].pos = d3(0.0, 1.0, -4.0); s[0].bodies[YOU].vel = d3(0.0, 0.0, 20.0);
  run_for(s[..], 0.3);
  alive = 0;
  for i: 0..<SPARKS { if s[0].sparks[i].life > 0.0 { alive += 1; } }
  #assert alive > 0;
}

#test "a car over a ready pad takes its boost; the pad waits, then is ready again" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  s[0].no_bot = true;
  p := pad_at(0);
  s[0].tanks[0].fuel = 10.0;
  s[0].bodies[YOU].pos = d3(p.x, 0.9, p.z);
  run_for(s[..], 0.1);
  #assert s[0].tanks[0].fuel > 99.0 && s[0].pad_wait[0] > PAD_BIG_WAIT - 0.5 && s[0].pads_taken == 1;
  q := pad_at(8);
  s[0].tanks[0].fuel = 10.0;
  s[0].bodies[YOU].pos = d3(q.x, 0.9, q.z); s[0].bodies[YOU].vel = D3_ZERO;
  run_for(s[..], 0.1);
  #assert s[0].tanks[0].fuel > 21.0 && s[0].tanks[0].fuel < 30.0;
  s[0].tanks[0].fuel = 100.0;
  run_for(s[..], PAD_BIG_WAIT);
  #assert s[0].pad_wait[0] == 0.0 && s[0].pad_wait[8] == 0.0;
  // all sixteen in the arena, apart
  for i: 0..<PADS {
    a := pad_at(i);
    #assert abs(a.x) < ARENA_HX - 2.0 && abs(a.z) < ARENA_HZ - 2.0;
    for j: i + 1..<PADS { #assert d3_len(d3(a.x - pad_at(j).x, 0.0, a.z - pad_at(j).z)) > 5.0; }
  }
}

#test "the station spins down at 90 s for 15 s, at 60 s with ?spin=60, never with ?spin=off; half spin is 0.4 g; every tank fills as it starts (ol-spin-down)" {
  #assert spin_share(10.0, 90.0) == 1.0 && spin_share(89.9, 90.0) == 1.0;
  #assert near_d(spin_share(91.0, 90.0), 0.5, 0.000001);
  #assert spin_share(97.0, 90.0) == 0.0 && spin_share(104.0, 90.0) > 0.4 && spin_share(105.5, 90.0) == 1.0;
  #assert near_d(spin_clock(97.0, 90.0), 8.0, 0.000001) && near_d(spin_clock(80.0, 90.0), -10.0, 0.000001);
  // the second one: 90 s more at spin
  #assert spin_share(180.0, 90.0) == 1.0 && spin_share(200.0, 90.0) == 0.0;
  #assert spin_share(67.0, 60.0) == 0.0 && spin_share(67.0, 90.0) == 1.0;
  #assert spin_share(97.0, 0.0) == 1.0 && spin_clock(97.0, 0.0) < -1000.0;
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?spin=60\n");
  #assert s[0].spin_every == 60.0;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?spin=off\n");
  #assert s[0].spin_every == 0.0;
  t: [1] OrbitLeague;
  game_message(t[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?spin=half\n");
  t[0].phase = PHASE_PLAY; t[0].played = 10.0; set_spin(t[..]);
  #assert t[0].spin_every == SPIN_EVERY && near_d(t[0].field.scale, HALF_SPIN, 0.000001) && t[0].spin_now == 1.0;
  // the tanks fill as the spin-down starts
  u: [1] OrbitLeague;
  game_reset(u[..]);
  u[0].tanks[0].fuel = 5.0; u[0].tanks[1].fuel = 20.0;
  u[0].played = 90.0 - 0.5 * STEP; set_spin(u[..]);
  #assert u[0].tanks[0].fuel == 5.0;
  u[0].played = 90.0 + 0.5 * STEP; set_spin(u[..]);
  #assert u[0].tanks[0].fuel == 100.0 && u[0].tanks[1].fuel == 100.0;
}

#test "a kickoff while you sit still doesn't fly the ball into your goal" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  top := 0.0;
  for i: 0..<cast(int) ((KICKOFF + 4.0) / STEP) { game_step(s[..], STEP); top = fmax(top, d3_len(s[0].bodies[BALL].vel)); }
  #assert s[0].score[1] == 0 && top <= BALL_MAX + 0.001;
}

#test "the bot drives to the ball and gets it moving" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 5.0);
  #assert d3_len(s[0].bodies[BALL].vel) > 0.5 || d3_len(d3_sub(s[0].bodies[BALL].pos, d3(0.0, BALL_R, 0.0))) > 1.0;
}

#test "?stage=highlight sets up the shot: a hard hit, then a goal for blue within 2 s; without it, a plain kickoff" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league\n");
  #assert s[0].stage == STAGE_NONE && s[0].phase == PHASE_KICKOFF && !s[0].ball_cam;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?stage=highlight\n");
  #assert s[0].stage == STAGE_HIGHLIGHT && s[0].phase == PHASE_PLAY && s[0].score[0] == 2 && s[0].score[1] == 2;
  top := 0.0; goal := -1.0; near := 99.0;
  for k: 0..<cast(int) (2.0 / STEP) {
    game_step(s[..], STEP);
    top = fmax(top, d3_len(s[0].bodies[BALL].vel));
    if goal < 0.0 && s[0].touches > 0 { near = fmin(near, d3_dist(s[0].bodies[BOT].pos, s[0].bodies[BALL].pos)); }
    if goal < 0.0 && s[0].score[0] == 3 { goal = cast(f64) k * STEP; }
  }
  // past the bot by a few metres, at the ball's top speed, the blast going off
  #assert goal > 0.8 && goal < 2.0 && s[0].score[1] == 2 && top > BALL_MAX - 1.0 && near < 5.0;
  #assert s[0].blast_t >= 0.0 && s[0].blast_team == BLUE && s[0].stage == STAGE_NONE && s[0].held == 0;
}

#test "a frame draws the HUD and keys and thumbs drive" {
  s: [1] OrbitLeague;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := game_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, false);
  #assert n > 0 && u[5] >= 3;
  #assert game_key(s[..], 'w', 0) && (s[0].held & HOLD_UP) != 0;
  #assert game_key_up(s[..], 'W', 0) && s[0].held == 0;
  #assert game_key(s[..], KEY_SHIFT, 0) && (s[0].held & HOLD_BOOST) != 0;
  m := game_frame(s[..], out[..], u[..], 390, 844, 3, 0.016, false);
  a := game_pointer(s[..], 100, 2000, POINTER_DOWN, 1, 7);
  b := game_pointer(s[..], 100, 1800, POINTER_MOVE, 1, 7);
  #assert s[0].stick && s[0].stick_dy < -0.9;
  m = game_frame(s[..], out[..], u[..], 390 * 3, 844 * 3, 3, 0.016, false);
  #assert s[0].shown[BTN_JUMP] && s[0].shown[BTN_BOOST];
  jb := s[0].boxes_ui[BTN_JUMP];
  c := game_pointer(s[..], (jb.x0 + jb.x1) * 0.5, (jb.y0 + jb.y1) * 0.5, POINTER_DOWN, 1, 8);
  #assert s[0].button_id[BTN_JUMP] == 8 && you_drive(s[..]).input.jump || s[0].phase == PHASE_KICKOFF;
  #assert game_key(s[..], KEY_ESCAPE, 0) && game_action(s[..]) == ACT_NAVIGATE;
}

#test "a claimed maker's name draws MADE BY <NAME> · TIP, and TIP goes to the tip page" {
  ss: [2] OrbitLeague;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for dims: 0..<2 {
    s := ss[dims..<dims + 1];
    w: f32 = ifx dims == 0 then 1440 else 390 * 3; h: f32 = ifx dims == 0 then 900 else 844 * 3; dpr: f32 = ifx dims == 0 then 1 else 3;
    a := game_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert !s[0].tip_shown;
    game_message(s, MAKER_KIND, "Topher");
    b := game_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert b > a && s[0].tip_shown;
    t := s[0].tip_box;
    for i: 0..<BUTTONS { #assert !s[0].shown[i] || t.x1 < s[0].boxes_ui[i].x0 || t.x0 > s[0].boxes_ui[i].x1 || t.y1 < s[0].boxes_ui[i].y0 || t.y0 > s[0].boxes_ui[i].y1; }
    #assert t.x0 >= 0 && t.x1 <= w && t.y1 <= h;
    cx := (t.x0 + t.x1) * 0.5; cy := (t.y0 + t.y1) * 0.5;
    #assert game_pointer(s, cx, cy, POINTER_DOWN, 1, 4) && !s[0].stick;
    #assert game_pointer(s, cx, cy, POINTER_UP, 1, 4) && s[0].action == ACT_NAVIGATE;
    #assert cast(string) s[0].outbox[0..<s[0].out_n] == "/realms/orbit-league/tip";
  }
}

#test "a kickoff is a fair race: holding W from the countdown, you reach the ball before the bot, and it doesn't score off it" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].held = HOLD_UP;
  first := -1.0; you_first := false;
  for k: 0..<cast(int) ((KICKOFF + 6.0) / STEP) {
    game_step(s[..], STEP);
    if first < 0.0 && d3_len(s[0].bodies[BALL].vel) > 2.0 {
      first = cast(f64) k * STEP;
      you_first = d3_dist(s[0].bodies[YOU].pos, s[0].bodies[BALL].pos) < d3_dist(s[0].bodies[BOT].pos, s[0].bodies[BALL].pos);
    }
  }
  #assert first > KICKOFF && you_first && s[0].score[1] == 0;
}

eye_of :: (s: [] OrbitLeague) -> D3 { return d3(cast(f64) s[0].eye[0], cast(f64) s[0].eye[1], cast(f64) s[0].eye[2]); }

#test "ball cam keeps your car on screen everywhere, and the ball too away from the glass, on a laptop and a phone" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].ball_cam = true;
  cars := [8] D3.[d3(0.0, 0.5, -28.0), d3(20.0, 0.5, 35.0), d3(-23.5, 0.5, -38.5), d3(0.0, 0.5, 38.5), d3(23.5, 0.5, 0.0), d3(-10.0, 0.5, 20.0), d3(21.0, 0.5, -10.0), d3(-21.5, 0.5, 30.0)];
  balls := [5] D3.[d3(0.0, 1.4, 0.0), d3(15.0, 8.0, -30.0), d3(-20.0, 3.0, 38.0), d3(0.0, 10.0, 10.0), d3(22.0, 1.4, -38.0)];
  for size: 0..<2 {
    s[0].width = ifx size == 0 then 1440.0f32 else 390.0f32; s[0].height = ifx size == 0 then 900.0f32 else 844.0f32;
    for c: cars { for b: balls { for yaw: 0..<4 {
      if d3_dist(c, b) < 6.0 { continue; }
      s[0].bodies[YOU].pos = c; s[0].bodies[YOU].vel = D3_ZERO;
      s[0].bodies[YOU].orientation = dq_y(cast(f64) yaw * PI_D * 0.5);
      s[0].bodies[BALL].pos = b;
      s[0].cam_ready = false;
      camera(s[..], 0.016); view_rows(s[..]);
      #assert eye_inside(eye_of(s[..]), 0.01, ARENA_BOX);
      w := s[0].width; h := s[0].height;
      pb := seen(s[..], cast(f32) b.x, cast(f32) b.y, cast(f32) b.z);
      pc := seen(s[..], cast(f32) c.x, cast(f32) c.y + 0.5, cast(f32) c.z);
      clear := abs(c.x) < ARENA_HX - 3.5 && abs(c.z) < ARENA_HZ - 3.5 && (b.y < 6.0 || abs(c.z) < ARENA_HZ - 6.0);
      // your car always on screen; clear of the glass, both, the car in the middle above the thumbs
      #assert pc.ok && pc.x > 0 && pc.x < w && pc.y > 0 && pc.y < h;
      #assert !clear || pb.ok && pb.x > 0 && pb.x < w && pb.y > 0 && pb.y < h;
      #assert !clear || pc.x > w * 0.08 && pc.x < w * 0.92 && pc.y > h * 0.12 && pc.y < h * 0.86;
    } } }
  }
}

#test "the chase camera stays inside the glass with the car in front of it, even nose-out of a corner" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].width = 1440; s[0].height = 900;
  s[0].bodies[YOU].pos = d3(-23.5, 0.5, -38.5);
  s[0].bodies[YOU].orientation = dq_y(PI_D * 0.75);   // facing out of the corner, back to the glass
  s[0].cam_ready = false;
  camera(s[..], 0.016); view_rows(s[..]);
  pc := seen(s[..], -23.5, 1.0, -38.5);
  #assert eye_inside(eye_of(s[..]), 0.01, ARENA_BOX) && pc.ok && pc.x > 0 && pc.x < 1440 && pc.y > 0 && pc.y < 900 && pc.w > 3.0;
}

// Drive into the glass (or across open floor at x), then hold `held` for
// secs: how far the car turned, signed (+: toward +x from +z, its left).
wall_run :: (s: [] OrbitLeague, yaw: f64, held: int, secs: f64, x: f64) -> f64 {
  game_reset(s); s[0].no_bot = true; kickoff(s);
  run_for(s, KICKOFF + 0.1);
  s[0].bodies[YOU].pos = d3(x, 0.9, 0.0); s[0].bodies[YOU].orientation = dq_y(yaw);
  s[0].held = HOLD_UP;
  run_for(s, 2.0);
  f0 := rigid_axis(s[0].bodies[YOU], D3_Z);
  s[0].held = held;
  run_for(s, secs);
  f := rigid_axis(s[0].bodies[YOU], D3_Z);
  a := acos_d(fclamp(f.x * f0.x + f.z * f0.z, -1.0, 1.0));
  return ifx f0.z * f.x - f0.x * f.z > 0.0 then a else -a;
}

#test "a car pinned nose-first against the glass turns right on D, the way it turns on open floor" {
  s: [1] OrbitLeague;
  open_right := wall_run(s[..], PI_D * 0.5, HOLD_UP | HOLD_RIGHT, 1.0, -15.0);
  wall_right := wall_run(s[..], PI_D * 0.5, HOLD_UP | HOLD_RIGHT, 2.0, ARENA_HX - 3.0);
  #assert abs(open_right) > 0.3 && wall_right * open_right > 0.0 && abs(wall_right) > 0.7;
}
#test "a car pinned nose-first against the glass turns left on A" {
  s: [1] OrbitLeague;
  open_right := wall_run(s[..], PI_D * 0.5, HOLD_UP | HOLD_RIGHT, 1.0, -15.0);
  wall_left := wall_run(s[..], PI_D * 0.5, HOLD_UP | HOLD_LEFT, 2.0, ARENA_HX - 3.0);
  #assert wall_left * open_right < 0.0 && abs(wall_left) > 0.7;
}
#test "a car into the glass at an angle turns away on the stick, and S backs it off" {
  s: [1] OrbitLeague;
  #assert abs(wall_run(s[..], PI_D * 0.3, HOLD_UP | HOLD_RIGHT, 2.0, ARENA_HX - 3.0)) > 0.7;
  r := wall_run(s[..], PI_D * 0.5, HOLD_DOWN, 2.0, ARENA_HX - 3.0);
  #assert s[0].bodies[YOU].pos.x < ARENA_HX - 5.0;
}

#test "the off-screen ball's marker points toward it and stays off the phone's thumbs" {
  s: [1] OrbitLeague;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := game_frame(s[..], out[..], u[..], 390 * 3, 844 * 3, 3, 0.016, true);
  k: f32 = 3;
  w: f32 = 390 * 3; h: f32 = 844 * 3;
  // the ball behind your car at the kickoff spot, a little to one side
  s[0].bodies[BALL].pos = d3(6.0, 1.4, -ARENA_HZ + 3.0);
  n = game_frame(s[..], out[..], u[..], w, h, 3, 0.0, true);
  m := ball_marker(s[..], w, h, k, true);
  #assert m.ok && m.y <= h - 210 * k && m.y >= 90 * k;
  for i: 0..<BUTTONS { b := s[0].boxes_ui[i]; #assert !s[0].shown[i] || m.x < b.x0 || m.x > b.x1 || m.y < b.y0 || m.y > b.y1; }
  // ball ahead and on screen: no marker
  s[0].bodies[BALL].pos = d3(0.0, 1.4, 0.0);
  n = game_frame(s[..], out[..], u[..], w, h, 3, 0.0, true);
  #assert !ball_marker(s[..], w, h, k, true).ok;
  // far to the right, up high and behind: on the right half
  s[0].bodies[BALL].pos = d3(-20.0, 10.0, -36.0);
  n = game_frame(s[..], out[..], u[..], w, h, 3, 0.0, true);
  r := ball_marker(s[..], w, h, k, true);
  #assert r.ok;
}

#test "a goal knocks a car near it back from the goal, then kickoff puts car and ball on their spots" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  s[0].no_bot = true;
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[YOU].pos = d3(3.0, 0.9, ARENA_HZ - 6.0); s[0].bodies[YOU].vel = D3_ZERO;
  s[0].bodies[BALL].pos = d3(0.0, 2.0, ARENA_HZ + 1.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 10.0);
  run_for(s[..], 0.05);
  #assert s[0].phase == PHASE_GOAL && s[0].blast_team == BLUE && s[0].bodies[YOU].vel.z < -3.0;
  run_for(s[..], CELEBRATE);
  #assert s[0].phase == PHASE_KICKOFF && d3_len(d3_sub(s[0].bodies[BALL].pos, d3(0.0, BALL_R + 0.02, 0.0))) < 0.05;
  #assert abs(s[0].bodies[YOU].pos.x) < 0.01 && abs(s[0].bodies[YOU].pos.z + SPAWN_Z) < 0.01;
}

#test "C and the on-screen button both switch ball cam, on a laptop and a phone" {
  s: [1] OrbitLeague;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := game_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, true);
  #assert !s[0].ball_cam && game_key(s[..], 'c', 0) && s[0].ball_cam;
  #assert game_key(s[..], 'C', 0) && !s[0].ball_cam;
  for dims: 0..<2 {
    w: f32 = ifx dims == 0 then 1440 else 390 * 3; h: f32 = ifx dims == 0 then 900 else 844 * 3; dpr: f32 = ifx dims == 0 then 1 else 3;
    was := s[0].ball_cam;
    n = game_frame(s[..], out[..], u[..], w, h, dpr, 0.016, true);
    #assert s[0].shown[BTN_CAM];
    b := s[0].boxes_ui[BTN_CAM];
    cx := (b.x0 + b.x1) * 0.5; cy := (b.y0 + b.y1) * 0.5;
    p := game_pointer(s[..], cx, cy, POINTER_DOWN, 1, 9);
    q := game_pointer(s[..], cx, cy, POINTER_UP, 1, 9);
    #assert s[0].ball_cam != was;
  }
}

#test "after it hits the ball the bot coasts a moment, and its aim misses by less as the match goes on" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  run_for(s[..], KICKOFF + 0.5);
  bot_hit(s[..], 1);
  d := bot_drive(s[..], 1);
  #assert d.input.throttle < 0.5 && !d.boost;
  early := 0.0; late := 0.0;
  for i: 0..<40 { s[0].played = 1.0; bot_hit(s[..], 1); early = fmax(early, abs(s[0].bot_aim[1])); }
  for i: 0..<40 { s[0].played = MATCH_TIME; bot_hit(s[..], 1); late = fmax(late, abs(s[0].bot_aim[1])); }
  #assert early > late && early <= BOT_MISS && late <= BOT_MISS_LATE + 0.001;
  s[0].played = MATCH_TIME + BOT_RECOVER + 0.1;
  #assert bot_drive(s[..], 1).input.throttle > 0.5;
}

// Drives at the glass on the right from mid-field at `yaw` off square,
// holding W (and boost), for `secs`: the longest the car spends tipped up
// (its roof axis under 0.5) and the share of the end it sits upright.
glass_charge :: (s: [] OrbitLeague, yaw: f64, boost: bool, secs: f64) -> f64 {
  game_reset(s); s[0].no_bot = true; kickoff(s);
  run_for(s, KICKOFF + 0.1);
  s[0].bodies[YOU].pos = d3(ARENA_HX - 14.0, 0.9, 0.0); s[0].bodies[YOU].orientation = dq_y(PI_D / 2.0 - yaw);
  s[0].held = HOLD_UP | (ifx boost then HOLD_BOOST else 0);
  tipped := 0.0; longest := 0.0;
  for i: 0..<cast(int) (secs / STEP) {
    game_step(s, STEP);
    if rigid_axis(s[0].bodies[YOU], D3_Y).y < 0.5 { tipped += STEP; longest = fmax(longest, tipped); } else { tipped = 0.0; }
  }
  return longest;
}
#test "driving into the glass, square or at an angle, the car never stands on it for long (ol-fp-wall-stand)" {
  s: [1] OrbitLeague;
  #assert glass_charge(s[..], 0.0, false, 4.0) < 1.5;
  #assert glass_charge(s[..], 0.5, false, 4.0) < 1.5;
  #assert glass_charge(s[..], 1.0, false, 4.0) < 1.5;
}
#test "with boost too" {
  s: [1] OrbitLeague;
  #assert glass_charge(s[..], 0.0, true, 4.0) < 1.5;
  #assert glass_charge(s[..], 0.5, true, 4.0) < 1.5;
  #assert glass_charge(s[..], 1.0, true, 4.0) < 1.5;
}
#test "a car leaning on the glass, slow, is set back on its wheels within 1.5 s" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].no_bot = true; kickoff(s[..]);
  run_for(s[..], KICKOFF + 0.1);
  // nose up against the right-hand glass, roof toward the floor's centre
  s[0].bodies[YOU].pos = d3(ARENA_HX - 1.2, 2.0, 0.0);
  s[0].bodies[YOU].orientation = dq_z(1.3);
  s[0].held = HOLD_UP;
  run_for(s[..], 1.5);
  b := s[0].bodies[YOU];
  #assert rigid_axis(b, D3_Y).y > 0.8 && b.pos.y < 1.6;
}

// ---- the drum arena (ol-drum-arena)

drum_game :: (s: [] OrbitLeague) {
  game_reset(s); s[0].no_bot = true; set_arena(s, true);
  run_for(s, KICKOFF + 0.1);
}
#test "in the drum the car drives from the floor up the curve, over the ceiling and down again, wheels on" {
  s: [1] OrbitLeague;
  drum_game(s[..]);
  s[0].bodies[YOU].pos = d3(0.0, 0.9, 0.0); s[0].bodies[YOU].orientation = dq_y(PI_D / 2.0);
  s[0].held = HOLD_UP | HOLD_BOOST;
  top := 0.0; off := 0.0;
  for i: 0..<cast(int) (2.6 / STEP) {
    game_step(s[..], STEP);
    b := s[0].bodies[YOU];
    a := abs(drum_angle(arena_drum(), b.pos));
    if a > 2.6 && s[0].cars[0].wheels >= 2 { top = 1.0; }
    off = fmax(off, abs(drum_clearance(arena_drum(), b.pos) - 0.85));
  }
  #assert top > 0.0 && off < 0.4 && s[0].phase == PHASE_PLAY;
}
#test "the ball keeps inside the curve, and the bot scores in the drum's goal" {
  s: [1] OrbitLeague;
  drum_game(s[..]);
  // thrown hard at the wall
  s[0].bodies[BALL].pos = d3(0.0, 8.0, 0.0); s[0].bodies[BALL].vel = d3(30.0, 10.0, 4.0);
  closest := 100.0;
  for i: 0..<cast(int) (3.0 / STEP) { game_step(s[..], STEP); closest = fmin(closest, drum_clearance(arena_drum(), s[0].bodies[BALL].pos)); }
  #assert closest > BALL_R - 0.35;
  // rolled at your goal mouth
  s[0].bodies[BALL].pos = d3(0.0, BALL_R + 0.1, -ARENA_HZ + 6.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, -14.0);
  run_for(s[..], 1.0);
  #assert s[0].score[1] == 1;
}
#test "in the drum the camera stays inside, its up toward the axis, with your car in view all the way round" {
  s: [1] OrbitLeague;
  drum_game(s[..]);
  s[0].width = 1440; s[0].height = 900;
  for k: 0..<12 {
    a := cast(f64) k * TAU_D / 12.0 - PI_D;
    car := drum_turn(d3(0.0, 0.85, -12.0 + cast(f64) k * 3.0), a);
    s[0].bodies[YOU].pos = car;
    s[0].bodies[YOU].orientation = dq_mul(dq_z(a), dq_y(cast(f64) k * 0.9));
    s[0].cam_ready = false;
    camera(s[..], 0.016); view_rows(s[..]);
    e := eye_of(s[..]);
    #assert drum_clearance(arena_drum(), e) > 0.5;
    up := d3(cast(f64) s[0].cam_up[0], cast(f64) s[0].cam_up[1], cast(f64) s[0].cam_up[2]);
    #assert d3_dot(up, drum_up(arena_drum(), car)) > 0.99;
    pc := seen(s[..], cast(f32) car.x, cast(f32) car.y, cast(f32) car.z);
    #assert pc.ok && pc.x > 0 && pc.x < 1440 && pc.y > 0 && pc.y < 900;
  }
}
#test "a car tipped over on the drum's wall is set back on its wheels there" {
  s: [1] OrbitLeague;
  drum_game(s[..]);
  a := 1.2;
  s[0].bodies[YOU].pos = drum_turn(d3(0.0, 1.0, 5.0), a);
  s[0].bodies[YOU].orientation = dq_mul(dq_z(a), dq_z(PI_D));   // on its roof
  s[0].field.scale = 1.0;
  run_for(s[..], 1.5);
  b := s[0].bodies[YOU];
  #assert d3_dot(rigid_axis(b, D3_Y), drum_up(arena_drum(), b.pos)) > 0.8;
}
#test "?arena=drum plays in the drum; the box is the default" {
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league\n");
  #assert !s[0].drum;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?arena=drum\n");
  #assert s[0].drum && s[0].field.kind == GRAVITY_DRUM;
}
#test "when a match ends, PLAY IN THE DRUM starts one in the drum, and PLAY IN THE BOX goes back" {
  s: [1] OrbitLeague;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := game_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, true);
  #assert !s[0].shown[BTN_ARENA];
  for round: 0..<2 {
    s[0].phase = PHASE_OVER;
    n = game_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, true);
    #assert s[0].shown[BTN_ARENA];
    b := s[0].boxes_ui[BTN_ARENA];
    cx := (b.x0 + b.x1) * 0.5; cy := (b.y0 + b.y1) * 0.5;
    p := game_pointer(s[..], cx, cy, POINTER_DOWN, 1, 9);
    q := game_pointer(s[..], cx, cy, POINTER_UP, 1, 9);
    #assert s[0].drum == (round == 0) && s[0].phase == PHASE_KICKOFF && s[0].score[0] == 0;
    n = game_frame(s[..], out[..], u[..], 1440, 900, 1, 0.016, true);
    #assert (u[GOAL_AT + 2] > 0) == s[0].drum;
  }
}

// ---- the online room's checks (ol-room)

#test "a car's report and the room's state read back as sent, and a magenta seat sees the arena turned round" {
  s: [1] OrbitLeague;
  room_reset(s[..]);
  car := vehicle_body(s[0].spec, CAR_MASS, d3(3.25, 0.9, -12.5), dq_y(0.7));
  car.vel = d3(-4.0, 0.5, 18.25); car.omega = d3(0.0, 1.5, 0.0);
  buf: [512] u8; k := 0;
  buf[0] = 'c'; k = room_put_body(buf[..], 1, car);
  back := room_report(cast(string) buf[0..<k], RigidBody.{});
  #assert d3_dist(back.pos, car.pos) < 0.002 && d3_dist(back.vel, car.vel) < 0.002 && abs(back.orientation.y - car.orientation.y) < 0.0002;
  #assert d3_dist(room_turn(room_turn(car)).pos, car.pos) < 0.000001 && room_turn(car).pos.z == 12.5;
  // a bad frame keeps the old car
  #assert room_report("c 1 2 x", car).pos.x == car.pos.x;
  // the state: seat 1 hears seat 0's car, turned round
  cars: [2] RigidBody; seats := [2] int.[0, 1];
  cars[0] = car; cars[1] = room_turn(car);
  n := room_state(s[..], 7, 1, cars[..], seats[..], 2, buf[..]);
  p: [1] OrbitLeague;
  game_reset(p[..]); p[0].online = true; p[0].no_bot = true;
  room_take(p[..], cast(string) buf[0..<n]);
  #assert p[0].seat == 1 && p[0].sock_state == ROOM_IN && p[0].heard == 1;
  #assert d3_dist(p[0].bodies[BOT].pos, room_turn(car).pos) < 0.002;
}
#test "the room's ball: a reported car kicks it, it scores, and the room kicks off again" {
  s: [1] OrbitLeague;
  room_reset(s[..]);
  cars: [1] RigidBody;
  cars[0] = vehicle_body(s[0].spec, CAR_MASS, d3(0.0, 0.9, -40.0), DQ.{});
  for i: 0..<cast(int) ((KICKOFF + 0.1) / STEP) { room_step(s[..], cars[..], 1); }
  #assert s[0].phase == PHASE_PLAY && d3_len(s[0].bodies[BALL].vel) < 1.0;
  // a car at 20 m/s into the ball, toward +z
  for i: 0..<60 {
    cars[0].pos = d3(0.0, 0.9, -6.0 + cast(f64) i * 20.0 * STEP); cars[0].vel = d3(0.0, 0.0, 20.0);
    room_step(s[..], cars[..], 1);
  }
  #assert s[0].bodies[BALL].vel.z > 15.0;
  cars[0].pos = d3(20.0, 0.9, -30.0); cars[0].vel = D3_ZERO;
  for i: 0..<cast(int) (4.0 / STEP) { room_step(s[..], cars[..], 1); }
  #assert s[0].score[BLUE] == 1 && s[0].phase == PHASE_GOAL;
  k := s[0].kicks;
  for i: 0..<cast(int) (CELEBRATE / STEP + 2.0) { room_step(s[..], cars[..], 1); }
  #assert s[0].kicks == k + 1 && s[0].phase == PHASE_KICKOFF && s[0].bodies[BALL].pos.z == 0.0;
}
#test "?room=NAME opens a socket to this site's room, and reports your car 60 times a second once it opens" {
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?room=Topher-1\n");
  #assert s[0].online && s[0].no_bot && s[0].pipe[0].n == 1 && s[0].pipe[0].op[0] == PIPE_OPEN;
  #assert pipe_bytes(s[..][0].pipe[..], 0) == "wss://openagents.com/api/room/orbit-league/topher-1";
  pipe_drained(s[0].pipe[..]);
  game_socket_opened(s[..], 2);
  game_message(s[..], SOCKET_KIND + 4 * 2 + SOCKET_OPENED, "");
  room_send(s[..], 0.02);
  #assert s[0].pipe[0].n == 1 && s[0].pipe[0].op[0] == PIPE_SEND && s[0].pipe[0].id[0] == 2;
  room_send(s[..], 0.005);
  #assert s[0].pipe[0].n == 1;
  game_message(s[..], SOCKET_KIND + 4 * 2 + SOCKET_CLOSED, "");
  #assert s[0].sock_state == ROOM_LOST && !s[0].sock_open;
  t: [1] OrbitLeague;
  game_message(t[..], HOST_FACTS, "url=http://127.0.0.1:8894/realms/orbit-league?arena=drum&room=a\n");
  #assert pipe_bytes(t[0].pipe[..], 0) == "ws://127.0.0.1:8894/api/room/orbit-league/a";
}

#test "in the drum the bot drives slower and waits longer after a hit (ol-drum-bot; orbitleague-sim.coax plays the matches)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); set_arena(s[..], true);
  s[0].phase = PHASE_PLAY; s[0].phase_t = BOT_KICKOFF_CALM + 1.0; s[0].played = 30.0;
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 20.0);
  d := bot_drive(s[..], 1);
  #assert d.input.throttle == BOT_DRUM_THROTTLE || d.input.throttle == -0.6;
  bot_hit(s[..], 1);
  s[0].played += BOT_RECOVER + 0.1;
  #assert bot_drive(s[..], 1).input.throttle == 0.2;
  s[0].played += BOT_DRUM_RECOVER;
  #assert bot_drive(s[..], 1).input.throttle != 0.2;
  b: [1] OrbitLeague;
  game_reset(b[..]);
  #assert bot_recover(b[..]) == BOT_RECOVER && bot_recover(s[..]) == BOT_DRUM_RECOVER && BOT_DRUM_THROTTLE < BOT_THROTTLE;
}

#test "in the drum the pads lie up the walls too: a car on the wall takes one, and it comes back (ol-boost-pads)" {
  s: [1] OrbitLeague;
  drum_game(s[..]);
  walls := 0;
  for i: 0..<PADS { if abs(pad_at(i).x) / DRUM_R > 0.9 { walls += 1; } }
  #assert walls >= 4;
  // pad 5, round the curve 84 degrees: on the wall
  a := pad_at(5).x / DRUM_R;
  s[0].bodies[YOU].pos = drum_turn(d3(0.0, 0.9, pad_at(5).z), a);
  s[0].bodies[YOU].orientation = dq_mul(dq_z(a), DQ.{}); s[0].bodies[YOU].vel = D3_ZERO;
  s[0].tanks[0].fuel = 10.0;
  run_for(s[..], 0.1);
  #assert s[0].tanks[0].fuel > 99.0 && s[0].pad_wait[5] > PAD_BIG_WAIT - 0.5;
  s[0].bodies[YOU].pos = d3(0.0, 0.9, 0.0);
  run_for(s[..], PAD_BIG_WAIT);
  #assert s[0].pad_wait[5] == 0.0;
}

// The way the ball leaves a hit (the ol-hit-feel check).
hit_way :: (spec: VehicleSpec, car: RigidBody, ball_at: D3, ball_vel: D3) -> D3 {
  ball := rigid_body(BALL_MASS, d3_scale(d3(1.0, 1.0, 1.0), 0.4 * BALL_MASS * BALL_R * BALL_R), ball_at, DQ.{});
  ball.vel = ball_vel;
  ct := contact_sphere_box(ball.pos, BALL_R, car.pos, car.orientation, spec.half);
  #assert ct.hit;
  return d3_unit_or(ball_hit(ball, car, spec, ct).vel, D3_ZERO);
}

#test "the nose, a corner and the roof send the ball three different ways, and a side dodge's spin pushes it sideways (ol-hit-feel)" {
  spec := vehicle_roadster(); h := spec.half;
  car := vehicle_body(spec, CAR_MASS, d3(0.0, 1.0, 0.0), DQ.{});
  car.vel = d3(0.0, 0.0, 15.0);
  nose := hit_way(spec, car, d3(0.0, 1.0, h.z + BALL_R - 0.05), D3_ZERO);
  corner := hit_way(spec, car, d3(h.x + BALL_R * 0.6, 1.0, h.z + BALL_R * 0.6), D3_ZERO);
  still := vehicle_body(spec, CAR_MASS, d3(0.0, 1.0, 0.0), DQ.{});
  roof := hit_way(spec, still, d3(0.0, 1.0 + h.y + BALL_R - 0.05, 0.3), d3(0.0, -8.0, 0.0));
  // the nose drives it along and low, the corner off to its side, the roof up
  #assert nose.z > 0.95 && abs(nose.y) < 0.3;
  #assert corner.x > 0.35 && corner.z > 0.35;
  #assert roof.y > 0.8;
  #assert d3_dot(nose, corner) < 0.9 && d3_dot(nose, roof) < 0.5 && d3_dot(corner, roof) < 0.5;
  // the same nose hit, but the car spinning about its up axis (a side dodge's turn): the ball goes off sideways
  spun := car; spun.omega = d3(0.0, 6.0, 0.0);
  side := hit_way(spec, spun, d3(0.0, 1.0, h.z + BALL_R - 0.05), D3_ZERO);
  #assert abs(side.x) > 0.15 && d3_dot(side, nose) < 0.99;
}

// ---- the sphere arena (ol-sphere-arena)

sphere_game :: (s: [] OrbitLeague) {
  game_reset(s); s[0].no_bot = true; set_arena_kind(s, ARENA_SPHERE);
  run_for(s, KICKOFF + 0.1);
}
#test "?arena=sphere plays in the sphere: the cars start on its curve on their wheels and the ball at its lowest point" {
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?arena=sphere\n");
  #assert s[0].sphere && !s[0].drum && arena_kind(s[..]) == ARENA_SPHERE;
  sp := arena_sphere();
  for i: 1..<1 + s[0].cars_n {
    b := s[0].bodies[i];
    #assert near_d(sphere_clearance(sp, b.pos), 1.0, 0.001) && d3_dot(rigid_axis(b, D3_Y), sphere_up(sp, b.pos)) > 0.999;
  }
  #assert s[0].bodies[YOU].pos.z < -10.0 && s[0].bodies[BOT].pos.z > 10.0;
  run_for(s[..], KICKOFF + 1.0);
  you := s[0].bodies[YOU];
  #assert s[0].cars[0].wheels == 4 && d3_dot(rigid_axis(you, D3_Y), sphere_up(sp, you.pos)) > 0.95 && sphere_clearance(sp, you.pos) < 1.5;
  #assert near_d(sphere_clearance(sp, s[0].bodies[BALL].pos), BALL_R, 0.05);
}
#test "in the sphere a car drives round toward the equator's wall and up it, wheels on" {
  s: [1] OrbitLeague;
  sphere_game(s[..]);
  sp := arena_sphere();
  s[0].bodies[YOU].pos = floor_point(s[..], 0.0, 0.0, 0.9); s[0].bodies[YOU].orientation = dq_y(PI_D / 2.0);
  s[0].bodies[BALL].pos = floor_point(s[..], 0.0, 15.0, BALL_R);
  s[0].held = HOLD_UP | HOLD_BOOST;
  top := 0.0; off := 0;
  for i: 0..<cast(int) (2.5 / STEP) {
    game_step(s[..], STEP);
    b := s[0].bodies[YOU];
    top = fmax(top, b.pos.y);
    if s[0].cars[0].wheels == 0 { off += 1; }
  }
  // up past the wall's middle, and on its wheels almost all the way
  #assert top > SPHERE_R && cast(f64) off * STEP < 0.4;
}
#test "in the sphere a ball into the +z pole's cap is blue's goal, into the -z cap magenta's; a ball elsewhere is no goal" {
  s: [1] OrbitLeague;
  sphere_game(s[..]);
  #assert goal_past(s[..], sphere_goal_z() + 0.1) == BLUE && goal_past(s[..], -sphere_goal_z() - 0.1) == MAGENTA && goal_past(s[..], 20.0) == -1;
  // rolled hard up the curve straight at +z's pole it climbs into the cap
  at := floor_point(s[..], 0.0, 20.0, BALL_R + 0.05);
  s[0].bodies[BALL].pos = at; s[0].bodies[BALL].vel = d3_scale(d3_unit(d3_sub(floor_point(s[..], 0.0, 20.1, BALL_R + 0.05), at)), 18.0);
  for i: 0..<cast(int) (3.0 / STEP) { game_step(s[..], STEP); if s[0].phase == PHASE_GOAL { break; } }
  #assert s[0].phase == PHASE_GOAL && s[0].score[BLUE] == 1;
}
#test "the sphere's camera stays inside it and keeps your car in frame, at the bottom and up the wall" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].no_bot = true; set_arena_kind(s[..], ARENA_SPHERE);
  s[0].width = 1440; s[0].height = 900;
  zs := [3] f64.[0.0, 30.0, -20.0]; xs := [3] f64.[0.0, 0.0, 25.0];
  for k: 0..<3 {
    s[0].bodies[YOU].pos = floor_point(s[..], xs[k], zs[k], 0.9); s[0].bodies[YOU].orientation = floor_turn(s[..], xs[k], zs[k]);
    s[0].cam_ready = false;
    camera(s[..], 0.016);
    e := d3(cast(f64) s[0].cam_eye[0], cast(f64) s[0].cam_eye[1], cast(f64) s[0].cam_eye[2]);
    #assert sphere_clearance(arena_sphere(), e) > 0.5;
  }
}
#test "the arena button goes box, drum, sphere, box" {
  s: [1] OrbitLeague;
  game_reset(s[..]);
  #assert arena_kind(s[..]) == ARENA_BOX;
  set_arena_kind(s[..], (arena_kind(s[..]) + 1) % 3); #assert s[0].drum;
  set_arena_kind(s[..], (arena_kind(s[..]) + 1) % 3); #assert s[0].sphere && !s[0].drum;
  set_arena_kind(s[..], (arena_kind(s[..]) + 1) % 3); #assert !s[0].sphere && !s[0].drum;
}

// ---- prediction (ol-prediction)

// A room and one player ?lag=MS away, a 60 Hz frame at a time: the player's
// reports reach the room, the room steps twice and answers.
lag_frame :: (room: [] OrbitLeague, c: [] OrbitLeague, cars: [] RigidBody, echo: [] int, tick: int) {
  dt := 1.0 / 60.0;
  game_step(c, dt);
  room_frame(c, dt);
  for i: 0..<c[0].pipe[0].n {
    if c[0].pipe[0].op[i] != PIPE_SEND { continue; }
    t := pipe_bytes(c[0].pipe[..], i);
    cars[0] = room_report(t, cars[0]);
    e := room_report_clock(t); if e >= 0 { echo[0] = e; }
  }
  pipe_drained(c[0].pipe[..]);
  room_step(room, cars, 1); room_step(room, cars, 1);
  buf: [LAG_BYTES] u8; seats := [1] int.[0];
  n := room_state_echo(room, tick, 0, cars, seats[..], 1, echo[0], buf[..]);
  room_heard(c, cast(string) buf[0..<n]);
}
#test "with 150 ms of latency your car answers the first frame you press, and the ball you hit is drawn without a jump (ol-prediction)" {
  room: [1] OrbitLeague; room_reset(room[..]);
  c: [1] OrbitLeague;
  game_message(c[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?room=lag&lag=150\n");
  game_socket_opened(c[..], 2);
  game_message(c[..], SOCKET_KIND + 4 * 2 + SOCKET_OPENED, "");
  #assert c[0].lag == 0.15;
  cars: [1] RigidBody; cars[0] = c[0].bodies[YOU]; echo := [1] int.[-1];
  tick := 0;
  while tick < cast(int) ((KICKOFF + 0.6) * 60.0) { lag_frame(room[..], c[..], cars[..], echo[..], tick); tick += 1; }
  #assert c[0].phase == PHASE_PLAY && abs(c[0].rtt - 0.15) < 0.04;
  // press: the car moves on this frame, not a round trip later
  v0 := d3_len(c[0].bodies[YOU].vel);
  c[0].held = HOLD_UP | HOLD_BOOST;
  lag_frame(room[..], c[..], cars[..], echo[..], tick); tick += 1;
  #assert d3_len(c[0].bodies[YOU].vel) > v0 + 0.1;
  // drive through the ball; the ball as drawn never jumps more than its own
  // motion plus a little in a frame
  last := d3_add(c[0].bodies[BALL].pos, c[0].ball_err);
  worst := 0.0; moved := 0.0;
  for f: 0..<150 {
    lag_frame(room[..], c[..], cars[..], echo[..], tick); tick += 1;
    shown := d3_add(c[0].bodies[BALL].pos, c[0].ball_err);
    if c[0].phase == PHASE_PLAY { worst = fmax(worst, d3_dist(shown, last) - d3_len(c[0].bodies[BALL].vel) / 60.0); }
    moved = fmax(moved, d3_len(room[0].bodies[BALL].vel));
    last = shown;
  }
  #assert moved > 8.0 && worst < 0.1;
}

// ---- the pro bot (ol-bot)

#test "the pro bot reads where a rolling ball goes, and drops back when it heads for its goal (ol-bot)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].bot_smart = true;
  run_for(s[..], KICKOFF + 0.1);
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 0.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 30.0);
  bot_predict(s[..]);
  #assert s[0].bot_path_goal == BLUE && s[0].bot_path[5].z > 10.0 && s[0].bodies[BALL].pos.z == 0.0;
  s[0].bodies[BALL].vel = d3(8.0, 0.0, 0.0);
  bot_predict(s[..]);
  #assert s[0].bot_path_goal == -1 && s[0].bot_path[4].x > 2.0;
}
#test "the pro bot scores into an empty goal (ol-bot; orbitleague-sim.coax plays full 1v1s against it)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].bot_smart = true; s[0].bot_miss_k = 0.0;
  run_for(s[..], KICKOFF + 0.1);
  // you park out of the way, by your goal's corner
  s[0].bodies[YOU].pos = d3(ARENA_HX - 3.0, 1.0, -ARENA_HZ + 6.0);
  s[0].bodies[BALL].pos = d3(-6.0, BALL_R, -22.0);
  s[0].bodies[BOT].pos = d3(0.0, 1.0, -8.0);
  t := 0.0;
  while t < 6.0 && s[0].score[MAGENTA] == 0 { run_for(s[..], 0.25); t += 0.25; }
  #assert s[0].score[MAGENTA] >= 1;
}

// ---- 1v1 and 2v2 (ol-bot-modes)

#test "?mode=2v2 puts you and a blue bot against two magenta bots, a phone plays 2v2 unless told, and the room stays 1v1 (ol-bot-modes)" {
  s: [1] OrbitLeague;
  game_message(s[..], HOST_FACTS, "url=https://openagents.com/realms/orbit-league?mode=2v2\n");
  #assert s[0].cars_n == CARS;
  for c: 0..<CARS {
    b := s[0].bodies[c + 1];
    // each on its own team's half, on its wheels, facing the other end
    side := ifx c % 2 == 0 then -1.0 else 1.0;
    #assert b.pos.z * side > 10.0 && near_d(b.pos.y, 1.0, 0.01) && rigid_axis(b, D3_Z).z * side < -0.99;
  }
  p: [1] OrbitLeague;
  game_message(p[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/realms/orbit-league\n");
  #assert p[0].cars_n == CARS;
  q: [1] OrbitLeague;
  game_message(q[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/realms/orbit-league?mode=1v1\n");
  #assert q[0].cars_n == 2 && q[0].bodies[MATE].pos.y < -100.0;
  r: [1] OrbitLeague;
  game_message(r[..], HOST_FACTS, "coarse=1\nurl=https://openagents.com/realms/orbit-league?room=a\n");
  #assert r[0].cars_n == 2;
}
#test "in a 2v2 all three bots drive after the kickoff, the one of a pair further from the ball hangs back, and PLAY 1V1 / PLAY 2V2 switch (ol-bot-modes)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); set_mode(s[..], CARS);
  run_for(s[..], KICKOFF + 1.5);
  for c: 1..<CARS { #assert d3_len(s[0].bodies[c + 1].vel) > 3.0; }
  // the magenta pair: the one further from the ball goes back toward +z
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 0.0); s[0].bodies[BALL].vel = D3_ZERO;
  s[0].bodies[BOT].pos = d3(0.0, 1.0, 6.0); s[0].bodies[RIVAL].pos = d3(0.0, 1.0, -10.0);
  s[0].bodies[RIVAL].orientation = dq_y(PI_D);
  d := bot_drive(s[..], 3);
  // facing -z with its target behind it (+z): it turns or backs off, never drives on at the ball
  #assert abs(d.input.steer) > 0.5 || d.input.throttle < 0.0;
  set_mode(s[..], 2);
  #assert s[0].cars_n == 2 && s[0].bodies[RIVAL].pos.y < -100.0 && s[0].phase == PHASE_KICKOFF;
}

// ---- goal replays (ol-replay)

#test "a goal's replay plays its recorded drives through the same physics and ends with the ball where the goal left it (ol-replay)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].replays = true; s[0].no_bot = true; kickoff(s[..]);
  // in the countdown the ball is set rolling slowly at +z; you drive round
  // in circles, boosting, and bump into it now and then
  run_for(s[..], KICKOFF - 0.2);
  s[0].bodies[BALL].pos = d3(1.0, BALL_R, -20.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 9.5);
  s[0].held = HOLD_UP | HOLD_RIGHT | HOLD_BOOST;
  t := 0.0;
  while t < 12.0 && s[0].phase != PHASE_GOAL { run_for(s[..], STEP); t += STEP; }
  #assert s[0].phase == PHASE_GOAL && s[0].score[BLUE] == 1;
  at := s[0].bodies[BALL].pos; g := s[0].rec_n; touches := s[0].touches;
  #assert g > KEY_EVERY * 2;
  run_for(s[..], CELEBRATE + STEP);
  #assert s[0].phase == PHASE_REPLAY && s[0].rp_end == g && s[0].rp_step == imax(0, g - cast(int) (REPLAY_SECONDS / STEP)) + 1;
  while s[0].phase == PHASE_REPLAY { run_for(s[..], STEP); }
  #assert d3_dist(s[0].rp_ball, at) < 0.000001 && s[0].phase == PHASE_KICKOFF && s[0].score[BLUE] == 1 && s[0].touches == touches;
}
#test "a key or a tap skips the replay to the kickoff; tests and the room skip replays (ol-replay)" {
  s: [1] OrbitLeague;
  game_reset(s[..]); s[0].replays = true;
  run_for(s[..], KICKOFF + 1.0);
  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 38.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 20.0);
  run_for(s[..], 0.5);
  #assert s[0].phase == PHASE_GOAL;
  run_for(s[..], CELEBRATE + 0.2);
  #assert s[0].phase == PHASE_REPLAY;
  took := game_key(s[..], 'x', 0);
  #assert s[0].phase == PHASE_KICKOFF;
  q: [1] OrbitLeague;
  game_reset(q[..]);
  run_for(q[..], KICKOFF + 1.0);
  q[0].bodies[BALL].pos = d3(0.0, BALL_R, 38.0); q[0].bodies[BALL].vel = d3(0.0, 0.0, 20.0);
  run_for(q[..], 0.5 + CELEBRATE + 0.2);
  #assert q[0].phase == PHASE_KICKOFF;
}
