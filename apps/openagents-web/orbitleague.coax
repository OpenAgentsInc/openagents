  s[0].bodies[BALL].pos = d3(0.0, BALL_R, 0.0); s[0].bodies[BALL].vel = d3(0.0, 0.0, 30.0);
  bot_predict(s[..]);
  #assert s[0].bot_path_goal == BLUE && s[0].bot_path[5].z > 10.0 && s[0].bodies[BALL].pos.z == 0.0;
  s[0].bodies[BALL].vel = d3(8.0, 0.0, 0.0);
  bot_predict(s[..]);
  #assert s[0].bot_path_goal == -1 && s[0].bot_path[4].x > 2.0;
}
#test "the pro bot scores into an empty goal (ol-bot; orbitleague-sim.coax plays full 1v1s against it)" #steps 230000000 {
  s: [1] OrbitLeague;
