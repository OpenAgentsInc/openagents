// Painted Village, openagents.com/worlds/painted-village: a showcase of Aethyr's hand-painted
// look. Scene 1 is the village road: a dirt road between a timber-frame cottage and a stone house,
// grass verges and stone walls. Scene 2 is the plaza it leads into: flagstones, stalls, lamps,
// banners and bunting, and steps up to a fountain and the church. You stand where a reference
// shot was taken and walk from one scene into the other; houses, walls, trees and furniture
// block you, and the steps carry you up to the terrace (aethyr/arch/solids.coax).
//
// This file is the page: the camera you walk, the HUD, and what it hands the host. It builds
// nothing itself. The scene (verse/painted/village-road.coax) stands parts made by Aethyr's
// architecture kit (aethyr/arch/village.coax, flora.coax), and Aethyr's stylized shading
// (aethyr/render/stylized.coax, named by gpu/painted.coax) draws them: store 0 the kit's vertices,
// store 1 the records, store 2 the ground table, each copied to the GPU once.
//
// South of the village (verse/painted/wilds.coax) the road runs on as a path through pines, over a
// plank bridge and into a meadow of oaks under a cliff and its waterfall. The river, the falls,
// their spray and the rainbow are the scene's last draws: the host draws them in the water pass
// (coaxial_water_draws; aethyr/render/stylized.coax, stylized_water_*).
//
// Keys: W A S D or the arrows walk, a drag looks, shift runs, C shows what blocks you, H hides the
// HUD, Escape leaves. The shots, by their reference frame: 1 the road, 2 the plaza, 3 the church
// steps, 5 6 7 8 the meadow, 9 and 0 the waterfall, - the bridge, = the pine path. On a phone the
// left half of the screen walks and the right half looks. `#shot`, `#shot2` ... `#shot12` in the
// address open a shot with no HUD (for comparing with the reference); `#solids`, `#solids2` ...
// show the solids over it.
//   coax/bin/coax test apps/openagents-web/painted.coax --steps 2000000000

#load "font.coax";
#load "../../aethyr/loop.coax";
#load "../../verse/painted/village-road.coax";

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 6000;
UNIFORM_FLOATS :: STY_UNIFORM_FLOATS;

STEP :: 0.0166666667;
PAINTED_STEP_NS :: 16666667;
PAINTED_FRAME_NS :: 100000000;
WALK :: 3.6;             // metres a second
RUN :: 9.0;
EYE :: 1.68;             // the eye above the ground
EDGE :: VW_EDGE;         // how far from the middle you may walk
NORTH :: -142.0;         // and how far along the road's line: from behind the church
SOUTH :: VW_SOUTH;       // to the meadow's far side
RISE :: 9.0;             // how fast the eye follows the feet up a step, a second

HOST_PAGE :: 600;
OUTBOX_CAP :: 64;
ACT_NAVIGATE :: 1;
KEY_ESCAPE :: -1; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;
GO_AHEAD :: 1; GO_BACK :: 2; GO_LEFT :: 4; GO_RIGHT :: 8; GO_RUN :: 16;

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

Painted :: struct {
  started: bool;
  cam: StyCamera;
  feet: f32;                 // the height your feet stand at
  held: f32;                 // the eye above them: EYE once you walk
  solids: bool;              // the solids are drawn over the scene
  look: StyLook;
  keys: int;                 // GO_ bits held
  looking: bool; look_id: int; last_x: f32; last_y: f32;
  walking: bool; walk_id: int; walk_x0: f32; walk_y0: f32; stick_x: f32; stick_y: f32;
  clock: f32;
  steps: FrameClock;
  width: f32; height: f32; dpr: f32;
  golden: bool;
  clean: bool;               // no HUD
  blades: int;
  worlds: Rect; pressing: bool;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  host_draws: [VR_DRAWS * 4] u32; host_draw_n: int;
  generation: int;           // the stores' generation: they are copied to the GPU when it changes
  scene: [1] VillageRoad;
}

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n >= buf.count { break; } buf[n] = c; n += 1; }
  return n;
}

// Stand where a shot was taken, by its reference frame's number: 1 the village road, 2 the plaza,
// 3 the church steps, 5 to 12 the country to the south.
painted_shot_at :: (s: [] Painted, shot: int) {
  s[0].cam = vr_camera(shot);
  s[0].feet = s[0].cam.y - EYE;
  // A shot from above or below head height: the feet are on the ground there, and the eye comes
  // to head height once you walk.
  if shot >= 3 { s[0].feet = ifx shot == 11 then f32(VW_DECK) else vr_height(s[0].cam.x, s[0].cam.z); }
  s[0].held = s[0].cam.y - s[0].feet;
}
painted_shot :: (s: [] Painted) { painted_shot_at(s, 1); }
// The host's draws: a part's vertices in order (the top bit of the base instance), once a record.
// The solids' own mesh is left out unless they are shown.
painted_list :: (s: [] Painted) {
  n := 0; wet0 := s[0].scene[0].wet_first; wet1 := wet0 + s[0].scene[0].wet_n;
  // What is solid first, then the water: the host draws its last painted_water draws in the water pass.
  for pass: 0..<2 {
    for d: 0..<s[0].scene[0].draw_n {
      if d == s[0].scene[0].solid_draw && !s[0].solids { continue; }
      if (d >= wet0 && d < wet1) != (pass == 1) { continue; }
      o := d * 4;
      s[0].host_draws[n * 4] = s[0].scene[0].draws[o]; s[0].host_draws[n * 4 + 1] = s[0].scene[0].draws[o + 1];
      s[0].host_draws[n * 4 + 2] = s[0].scene[0].draws[o + 2] | 0x80000000; s[0].host_draws[n * 4 + 3] = s[0].scene[0].draws[o + 3];
      n += 1;
    }
  }
  s[0].host_draw_n = ifx s[0].scene[0].built then n else 0;
}
painted_start :: (s: [] Painted) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].look = vr_look();
  built := vr_build(s[0].scene[..]);
  painted_shot(s);
  painted_list(s);
  s[0].generation = 1;
}
leave_to :: (s: [] Painted, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}

// One fixed step: walk the way the keys and the thumb say. Aethyr's walking capsule slides you
// along what blocks you and stands you on the ground, a step or a terrace; the eye follows the feet.
step :: (s: [] Painted, dt: f32) {
  s[0].cam.y += (s[0].feet + s[0].held - s[0].cam.y) * lo(1, RISE * dt);
  ahead: f32 = 0; side: f32 = 0;
  if s[0].keys & GO_AHEAD != 0 { ahead += 1; } if s[0].keys & GO_BACK != 0 { ahead -= 1; }
  if s[0].keys & GO_RIGHT != 0 { side += 1; } if s[0].keys & GO_LEFT != 0 { side -= 1; }
  ahead += s[0].stick_y; side += s[0].stick_x;
  size := sqrt(ahead * ahead + side * side);
  if size < 0.01 { return; }
  s[0].held = EYE;
  if size > 1 { ahead /= size; side /= size; }
  speed: f32 = ifx s[0].keys & GO_RUN != 0 then RUN else WALK;
  c := cos(s[0].cam.yaw); sn := sin(s[0].cam.yaw);
  to := vr_walk(s[0].scene[..], world_point(s[0].cam.x, s[0].feet, s[0].cam.z), (sn * ahead + c * side) * speed * dt, (-c * ahead + sn * side) * speed * dt);
  s[0].cam.x = lo(EDGE, hi(-EDGE, to.x)); s[0].cam.z = lo(SOUTH, hi(NORTH, to.z));
  s[0].feet = to.y;
}
painted_run :: (s: [] Painted, dt: f32) {
  c := s[0].steps;
  c.step_ns = PAINTED_STEP_NS; c.max_frame_ns = PAINTED_FRAME_NS;
  c = loop_accept(c, cast(f64) dt);
  s[0].clock += cast(f32) loop_counted(c);
  for k: 0..<loop_due(c) { step(s, f32(STEP)); }
  s[0].steps = loop_ran(c);
}

// ---- the HUD

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}
seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32, r: f32, g: f32, b: f32) -> int {
  if lit(out, n, ax, ay, bx, by, core, light, glow, r, g, b, 0) { return n + 6; }
  return n;
}
ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.6 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
say_at :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, k, false, false);
}
HOW :: "W A S D WALK. DRAG LOOKS. 1 TO 0 THE SHOTS. C SHOWS WHAT BLOCKS YOU. H HIDES THIS.";
HOW_PHONE :: "LEFT THUMB WALKS. RIGHT THUMB LOOKS.";
draw_hud :: (s: [] Painted, out: [] f32, at: int, w: f32, h: f32, k: f32) -> int {
  n := at;
  cap := 12 * k; pad := 11 * k;
  white := ink(k, 1.0, 1.0, 1.0, 1.0);
  gw := text_width("WORLDS", cap) + 2 * pad;
  s[0].worlds = Rect.{x0 = pad, y0 = pad, x1 = pad + gw, y1 = pad + cap + 2 * pad};
  if s[0].clean { return n; }
  g := s[0].worlds;
  n = seg(out, n, g.x0, g.y0, g.x1, g.y0, 0.8 * k, 0.9, 1.5 * k, 1, 1, 1);
  n = seg(out, n, g.x1, g.y0, g.x1, g.y1, 0.8 * k, 0.9, 1.5 * k, 1, 1, 1);
  n = seg(out, n, g.x1, g.y1, g.x0, g.y1, 0.8 * k, 0.9, 1.5 * k, 1, 1, 1);
  n = seg(out, n, g.x0, g.y1, g.x0, g.y0, 0.8 * k, 0.9, 1.5 * k, 1, 1, 1);
  n = say_at(out, n, "WORLDS", g.x0 + pad, g.y1 - pad, cap, white);
  n = say_at(out, n, "PAINTED VILLAGE", g.x1 + pad * 1.5, g.y1 - pad, cap, white);
  how := ifx w / k < 700 then HOW_PHONE else HOW;
  small := lo(cap * 0.85, cap * 0.85 * (w - 2 * pad) / hi(text_width(how, cap * 0.85), 1));
  n = say_at(out, n, how, pad, h - pad, small, white);
  return n;
}

painted_frame :: (s: [] Painted, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  painted_start(s);
  if u.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  s[0].width = width; s[0].height = height; s[0].dpr = dpr;
  k := hi(dpr, 0.5);
  painted_run(s, ifx s[0].golden || still then 0.0f32 else dt);
  for i: 0..<u.count { u[i] = 0; }
  // Golden mode holds the grass and the clouds still.
  ok := sty_frame(u, width, height, ifx s[0].golden || still then 0.0f32 else s[0].clock, s[0].cam, s[0].look);
  s[0].blades = ifx ok then vr_frame(u, s[0].look, s[0].cam) else 0;
  return draw_hud(s, out, 0, width, height, k);
}

// ---- input

// The shot a key goes to, by its reference frame's number (0: none).
shot_key :: (key: int) -> int {
  if key >= '1' && key <= '3' { return key - '0'; }
  if key >= '5' && key <= '9' { return key - '0'; }
  if key == '0' { return 10; } if key == '-' { return 11; } if key == '=' { return 12; }
  return 0;
}
held_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' || key == KEY_UP { return GO_AHEAD; }
  if key == 's' || key == 'S' || key == KEY_DOWN { return GO_BACK; }
  if key == 'a' || key == 'A' || key == KEY_LEFT { return GO_LEFT; }
  if key == 'd' || key == 'D' || key == KEY_RIGHT { return GO_RIGHT; }
  return 0;
}
painted_key :: (s: [] Painted, key: int, mods: int) -> bool #export_c #effects(all) {
  painted_start(s);
  // Shift is the host's modifier bit 1: W with it is 'W'.
  bit := held_bit(key);
  if bit != 0 {
    s[0].keys |= bit;
    if key == 'W' || key == 'A' || key == 'S' || key == 'D' || mods & 1 != 0 { s[0].keys |= GO_RUN; } else { s[0].keys = s[0].keys & (GO_AHEAD | GO_BACK | GO_LEFT | GO_RIGHT); }
    return true;
  }
  // The shots: 1 2 3, then 5 to 9, 0 the tenth, - and = the eleventh and twelfth.
  shot := shot_key(key);
  if shot > 0 { painted_shot_at(s, shot); return true; }
  if key == 'c' || key == 'C' { s[0].solids = !s[0].solids; painted_list(s); return true; }
  if key == 'h' || key == 'H' { s[0].clean = !s[0].clean; return true; }
  if key == KEY_ESCAPE { leave_to(s, "/worlds"); return true; }
  return false;
}
painted_key_up :: (s: [] Painted, key: int, mods: int) -> bool #export_c #effects(all) {
  bit := held_bit(key);
  if bit == 0 { return false; }
  s[0].keys = s[0].keys & ((GO_AHEAD | GO_BACK | GO_LEFT | GO_RIGHT | GO_RUN) ^ bit);
  if s[0].keys & (GO_AHEAD | GO_BACK | GO_LEFT | GO_RIGHT) == 0 { s[0].keys = 0; }
  return true;
}
painted_blur :: (s: [] Painted) #export_c #effects(all) { s[0].keys = 0; s[0].looking = false; s[0].walking = false; s[0].stick_x = 0; s[0].stick_y = 0; s[0].pressing = false; }
// The mouse drags the view. A finger on the left half is a walking stick, on the right half it looks.
painted_pointer :: (s: [] Painted, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  painted_start(s);
  k := hi(s[0].dpr, 0.5);
  if phase == 0 {
    if !s[0].clean && in_rect(s[0].worlds, x, y) { s[0].pressing = true; return true; }
    if kind != 0 && x < s[0].width * 0.5 && !s[0].walking {
      s[0].walking = true; s[0].walk_id = id; s[0].walk_x0 = x; s[0].walk_y0 = y; s[0].stick_x = 0; s[0].stick_y = 0;
      return true;
    }
    if !s[0].looking { s[0].looking = true; s[0].look_id = id; s[0].last_x = x; s[0].last_y = y; }
    return true;
  }
  if phase == 1 {
    if s[0].walking && id == s[0].walk_id {
      reach := 60 * k;
      s[0].stick_x = lo(1, hi(-1, (x - s[0].walk_x0) / reach)); s[0].stick_y = lo(1, hi(-1, (s[0].walk_y0 - y) / reach));
      return true;
    }
    if s[0].looking && id == s[0].look_id {
      turn := 0.0045 / k;
      s[0].cam.yaw -= (x - s[0].last_x) * turn;
      s[0].cam.pitch = lo(1.2, hi(-1.2, s[0].cam.pitch + (y - s[0].last_y) * turn));
      s[0].last_x = x; s[0].last_y = y;
      return true;
    }
    return false;
  }
  if s[0].pressing {
    s[0].pressing = false;
    if phase == 2 && in_rect(s[0].worlds, x, y) { leave_to(s, "/worlds"); }
    return true;
  }
  if s[0].walking && id == s[0].walk_id { s[0].walking = false; s[0].stick_x = 0; s[0].stick_y = 0; }
  if s[0].looking && id == s[0].look_id { s[0].looking = false; }
  return true;
}
painted_cursor :: (s: [] Painted) -> int #export_c #effects(all) { return 0; }
painted_message :: (s: [] Painted, kind: int, t: string) #export_c #effects(all) { painted_start(s); }
// The address's hash: `shot` and `shot2` stand you at a shot with no HUD; `solids` and `solids2`
// the same with the solids shown.
painted_hash :: (s: [] Painted, t: string) #export_c #effects(all) {
  painted_start(s);
  // `shot` or `solids`, then the shot's number (none: the first).
  solids := t.count >= 6 && t[0] == 's' && t[1] == 'o' && t[2] == 'l' && t[3] == 'i' && t[4] == 'd' && t[5] == 's';
  shot := t.count >= 4 && t[0] == 's' && t[1] == 'h' && t[2] == 'o' && t[3] == 't';
  if !solids && !shot { return; }
  n := 0; from := ifx solids then 6 else 4;
  for i: from..<t.count { if t[i] < '0' || t[i] > '9' { return; } n = n * 10 + cast(int) (t[i] - '0'); }
  if n == 0 { n = 1; }
  if n > 12 || n == 4 { return; }
  s[0].clean = true; painted_shot_at(s, n);
  if solids { s[0].solids = true; painted_list(s); }
}
painted_golden :: (s: [] Painted, on: bool) #export_c #effects(all) { painted_start(s); s[0].golden = on; }
painted_action :: (s: [] Painted) -> int #export_c #effects(all) { a := s[0].action; s[0].action = 0; return a; }
painted_action_done :: (s: [] Painted) #export_c #effects(all) { s[0].out_n = 0; }

// ---- what the host draws: the parts, the grass, and the three stores
painted_draws :: (s: [] Painted) -> int #export_c #effects(all) { return s[0].host_draw_n; }
painted_water :: (s: [] Painted) -> int #export_c #effects(all) { return ifx s[0].host_draw_n > 0 then s[0].scene[0].wet_n else 0; }
painted_grass :: (s: [] Painted) -> int #export_c #effects(all) { return ifx s[0].host_draw_n > 0 then s[0].blades else 0; }
painted_store_cap :: (k: int) -> int #export_c #effects(all) {
  if k == 0 { return VR_VERTICES * ARCH_VERTEX_FLOATS * 4; }
  if k == 1 { return VR_RECORDS * ARCH_RECORD_FLOATS * 4; }
  return VR_NODES * ARCH_GROUND_FLOATS * 4;
}
painted_store_bytes :: (s: [] Painted, k: int) -> int #export_c #effects(all) {
  if k == 0 { return s[0].scene[0].vertices * ARCH_VERTEX_FLOATS * 4; }
  if k == 1 { return s[0].scene[0].record_n * ARCH_RECORD_FLOATS * 4; }
  return VR_NODES * ARCH_GROUND_FLOATS * 4;
}
painted_generation :: (s: [] Painted) -> int #export_c #effects(all) { return s[0].generation; }

coaxial_painted_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_painted_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_painted_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }

// ---- checks

frame_at :: (s: [] Painted, w: f32, h: f32, dpr: f32, dt: f32) -> int {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  return painted_frame(s, out[..], u[..], w, h, dpr, dt, false);
}
#test "the page starts at the shot, builds the scene, and hands the host its draws, its grass and its stores" #steps 2000000000 #traversal 268435456 {
  s: [1] Painted;
  n := frame_at(s[..], 1920, 1080, 1, 0.016);
  #assert n > 100 && n <= MAX_VERTICES && s[0].scene[0].built && painted_draws(s[..]) == s[0].scene[0].draw_n - 1 && painted_grass(s[..]) == VR_GRASS_COLS * VR_GRASS_ROWS;
  shot := vr_shot_camera();
  #assert s[0].cam.x == shot.x && s[0].cam.y == shot.y && s[0].cam.z == shot.z && s[0].cam.pitch == shot.pitch;
  for d: 0..<s[0].host_draw_n { #assert s[0].host_draws[d * 4 + 2] & 0x80000000 != 0 && s[0].host_draws[d * 4 + 1] == s[0].scene[0].draws[d * 4 + 1]; }
  // C shows the solids: one more draw, the last; C again hides them.
  #assert painted_key(s[..], 'c', 0) && painted_draws(s[..]) == s[0].scene[0].draw_n && painted_key(s[..], 'c', 0) && painted_draws(s[..]) == s[0].scene[0].draw_n - 1;
  #assert painted_store_bytes(s[..], 0) == s[0].scene[0].vertices * 48 && painted_store_bytes(s[..], 0) <= painted_store_cap(0) && painted_store_bytes(s[..], 1) <= painted_store_cap(1);
  #assert painted_store_bytes(s[..], 2) == painted_store_cap(2) && painted_generation(s[..]) == 1;
  // Walking: W for two seconds moves you up the road and up the slope; 1 puts you back; the HUD hides.
  #assert painted_key(s[..], 'w', 0);
  for i: 0..<120 { n = frame_at(s[..], 1920, 1080, 1, 0.0166667); }
  #assert s[0].cam.z < shot.z - 6.8 && s[0].cam.z > shot.z - 7.6 && abs(s[0].cam.x - shot.x) < 0.001 && s[0].cam.y > shot.y + 0.001;
  #assert painted_key_up(s[..], 'w', 0) && s[0].keys == 0;
  z := s[0].cam.z; n = frame_at(s[..], 1920, 1080, 1, 0.5); #assert s[0].cam.z == z;
  #assert painted_key(s[..], '1', 0) && s[0].cam.z == shot.z;
  // 2 stands you in the plaza. Walking on from there you reach the steps, climb them to the
  // terrace, and stop at the fountain: you never pass through it.
  plaza := vr_plaza_camera();
  #assert painted_key(s[..], '2', 0) && s[0].cam.z == plaza.z && s[0].cam.x == plaza.x && s[0].feet == plaza.y - EYE;
  s[0].cam.x = VR_AXIS + 0.4;
  #assert painted_key(s[..], 'W', 0);
  fz: f32 = VR_PLAZA_FAR - VR_STEPS_RUN - 3.4;
  for i: 0..<240 {
    n = frame_at(s[..], 1920, 1080, 1, 0.0166667);
    away := sqrt((s[0].cam.x - VR_AXIS) * (s[0].cam.x - VR_AXIS) + (s[0].cam.z - fz) * (s[0].cam.z - fz));
    #assert away > 2.3 + 0.29 && s[0].cam.z > VR_CHURCH_FRONT;
  }
  #assert painted_key_up(s[..], 'W', 0) && abs(s[0].feet - (VR_VILLAGE + VR_TERRACE)) < 0.2 && s[0].cam.z < VR_PLAZA_FAR - VR_STEPS_RUN;
  #assert abs(s[0].cam.y - (s[0].feet + EYE)) < 0.05;
  #assert painted_key(s[..], '1', 0) && s[0].cam.z == shot.z && s[0].feet == shot.y - EYE;
  // A drag to the left turns you to the right... the view follows the hand: dragging left looks right.
  #assert painted_pointer(s[..], 900, 500, 0, 0, 0) && painted_pointer(s[..], 800, 500, 1, 0, 0) && s[0].cam.yaw > 0.4 && painted_pointer(s[..], 800, 500, 2, 0, 0) && !s[0].looking;
  // A thumb on the left half walks.
  #assert painted_pointer(s[..], 200, 800, 0, 1, 7) && painted_pointer(s[..], 200, 700, 1, 1, 7) && s[0].stick_y == 1 && painted_pointer(s[..], 200, 700, 2, 1, 7) && s[0].stick_y == 0;
  with_hud := frame_at(s[..], 1920, 1080, 1, 0);
  s[0].cam.yaw = 0;
  painted_hash(s[..], "shot"); bare := frame_at(s[..], 1920, 1080, 1, 0);
  #assert with_hud > 0 && bare == 0 && s[0].cam.z == shot.z && !s[0].solids;
  painted_hash(s[..], "solids2"); #assert s[0].cam.z == plaza.z && s[0].solids && painted_draws(s[..]) == s[0].scene[0].draw_n;
  #assert painted_key(s[..], KEY_ESCAPE, 0) && painted_action(s[..]) == ACT_NAVIGATE && s[0].out_n == 7;
  // A phone: the HUD fits.
  s[0].clean = false; n = frame_at(s[..], 390 * 3, 844 * 3, 3, 0);
  #assert n > 0 && s[0].worlds.x1 < 390 * 3 / 2 && text_width(HOW_PHONE, 12 * 3 * 0.85) > 0;
}
#test "the water is drawn last, and the other shots stand you at the church steps, on the bridge and in the country" #steps 2000000000 {
  s: [1] Painted;
  n := frame_at(s[..], 1920, 1080, 1, 0.016);
  #assert s[0].scene[0].built;
  // The water is the host's last draws, and stays last when the solids are shown.
  wet := s[0].scene[0].wet_n; #assert painted_water(s[..]) == wet && wet > 0;
  for d: 0..<s[0].host_draw_n {
    o := cast(int) s[0].host_draws[d * 4] * ARCH_VERTEX_FLOATS;
    #assert (s[0].scene[0].mesh[o + 6] >= ARCH_M_WET) == (d >= s[0].host_draw_n - wet);
  }
  #assert painted_key(s[..], 'c', 0) && s[0].scene[0].mesh[cast(int) s[0].host_draws[(s[0].host_draw_n - 1) * 4] * ARCH_VERTEX_FLOATS + 6] >= ARCH_M_WET && painted_key(s[..], 'c', 0);
  // 3 stands you low at the foot of the church steps; you come to head height when you walk.
  steps := vr_camera(3);
  #assert painted_key(s[..], '3', 0) && s[0].cam.y == steps.y && s[0].feet == VR_VILLAGE && s[0].cam.y < s[0].feet + 1;
  #assert painted_key(s[..], 'w', 0); for i: 0..<60 { n = frame_at(s[..], 1920, 1080, 1, 0.0166667); }
  #assert painted_key_up(s[..], 'w', 0) && s[0].cam.y > s[0].feet + EYE - 0.05 && s[0].cam.z < steps.z - 3;
  // The other shots: 5 to 9, 0, - and = stand you where frames 5 to 12 were taken; = is the pine path, - the bridge's deck.
  #assert shot_key('4') == 0 && shot_key('5') == 5 && shot_key('0') == 10 && shot_key('-') == 11 && shot_key('=') == 12;
  #assert painted_key(s[..], '-', 0) && s[0].cam.z == vr_camera(11).z && s[0].feet == VW_DECK && s[0].held == EYE;
  // From the deck you walk off the bridge's north end onto the path.
  #assert painted_key(s[..], 'W', 0); for i: 0..<120 { n = frame_at(s[..], 1920, 1080, 1, 0.0166667); }
  #assert painted_key_up(s[..], 'W', 0) && s[0].cam.z < VW_BRIDGE_Z - VW_BRIDGE_RUN * 0.5 && abs(s[0].feet) < 0.2 && abs(s[0].cam.x - VR_ROAD_X) < 0.01;
  painted_hash(s[..], "shot10"); #assert s[0].clean && s[0].cam.z == vr_camera(10).z && s[0].cam.x == vr_camera(10).x;
  painted_hash(s[..], "shot4"); painted_hash(s[..], "shot13"); painted_hash(s[..], "shots"); #assert s[0].cam.z == vr_camera(10).z;
  painted_hash(s[..], "solids9"); #assert s[0].cam.z == vr_camera(9).z && s[0].solids;
}
