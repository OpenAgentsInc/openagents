// The project page's frame checks, run natively. Each draws real frames, and
// choosing a project admits its rows through the capacity kernel
// (project-capacity.coax), which is compiled separately and linked: a recorded
// verification boundary (docs/verification/coax-project-capacity-2026-10-30.json).
// A compile-time check can't call that #foreign, so these run natively:
// coax/web/tool.sh suites builds this file and the unit, links them with
// coax/web/native-check.c and runs each check in its own process.
//   coax test apps/openagents-web/project-frames.coax --native-link project-capacity.coax
#import "Basic";
#load "project.coax";

// Check i, run; or, with run false, its name. The count of checks either way.
native_check :: (i: int, run: bool) -> int #export_c {
  if i == 0 { if run { pf_0(); } else { print("a frame draws every panel inside the canvas, within the vertex budget"); } }
  if i == 1 { if run { pf_1(); } else { print("the queue's rows are found by the pointer on a desktop and a phone, and a click opens each"); } }
  if i == 2 { if run { pf_2(); } else { print("the header's crumbs go home and back to the project list"); } }
  if i == 3 { if run { pf_3(); } else { print("the detail opens and closes: CLOSE, a click outside, Esc, and the keys move through the queue"); } }
  if i == 4 { if run { pf_4(); } else { print("the keys move through the queue and open it; the location's hash opens a task"); } }
  if i == 5 { if run { pf_5(); } else { print("a task's detail draws inside its panel within the vertex budget, scrolled or not: desktop"); } }
  if i == 6 { if run { pf_6(); } else { print("a task's detail draws inside its panel within the vertex budget, scrolled or not: tablet and phone"); } }
  if i == 7 { if run { pf_7(); } else { print("a long body scrolls with the wheel, a drag and the keys; a blocker's alias opens it"); } }
  if i == 8 { if run { pf_8(); } else { print("a task's detail lists what it needs from other projects and who needs it, and each opens that project's page on it"); } }
  if i == 9 { if run { pf_9(); } else { print("a page names its project, paints what was baked, and draws the relay's fold from the last EOSE on"); } }
  return 10;
}

// a frame draws every panel inside the canvas, within the vertex budget
pf_0 :: () {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  uniforms: [UNIFORM_FLOATS] f32;
  s: [1] ProjectState;
  t: [1] Tree;
  work: [1] Work;
  live: [1] Live;
  sizes := [6] f32.[1440, 900, 768, 1024, 320, 568];
  for page: 0..<2 {
    s[0].page = page;
    for k: 0..<3 {
      w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
      n := coaxial_project_frame(s[..], t[..], work[..], live[..], out[..], uniforms[..], w, h, 2, 0, true);
      #assert n > 3000 && n < MAX_VERTICES && n % 6 == 0;
      #assert on_canvas(out[..], n, w, h, 2);
      panels := ifx project_layout(w, h, 2, work[..]).agents_on then 3 else 2;
      #assert uniforms[5] >= cast(f32) panels && uniforms[0] == w;
    }
  }
}

// the queue's rows are found by the pointer on a desktop and a phone, and a click opens each
pf_1 :: () {
  out: [PAGE_OUT] f32;
  sizes := [4] f32.[1440, 900, 320, 568];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    g: [1] Page;
    _ := draw_page(g[..], out[..], w, h);
    l := project_layout(w, h, 2, g[0].w[..]);
    vw := g[0].w[0].view;
    #assert vw.hit_n >= ifx k == 0 then 3 else 1;
    for i: 0..<vw.hit_n {
      b := vw.hit_box[i];
      // inside the queue's panel, one under another, apart
      #assert b.x0 >= l.queue.x0 && b.x1 <= l.queue.x1 && b.y0 >= l.queue.y0 && b.y1 <= l.queue.y1;
      if i > 0 { #assert b.y0 >= vw.hit_box[i - 1].y1; }
      #assert row_at(g[0].w[..], mid_x(b), mid_y(b)) == vw.hit_row[i];
      #assert row_at(g[0].w[..], mid_x(b), b.y0 + 1) == vw.hit_row[i] && row_at(g[0].w[..], mid_x(b), b.y1 - 1) == vw.hit_row[i];
    }
    // off the rows: nothing
    #assert row_at(g[0].w[..], mid_x(l.header), mid_y(l.header)) == -1;
    // a mouse over a row: a pointer cursor; over the header: the default
    poke(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
    poke(g[..], mid_x(l.header), mid_y(l.header), POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 0;
    // a tap on each row opens it and names it in the hash
    for i: 0..<vw.hit_n {
      g[0].s[0].open = 0;
      b := vw.hit_box[i];
      #assert tap(g[..], mid_x(b), mid_y(b), k);
      #assert g[0].s[0].open == vw.hit_row[i] + 1 && g[0].s[0].action == ACT_HASH;
      #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], item(g[0].w[..], g[0].w[0].text, vw.hit_row[i], 0));
      coaxial_project_action_done(g[0].s[..]);
    }
    // a drag isn't a click
    g[0].s[0].open = 0;
    b := vw.hit_box[0];
    poke(g[..], mid_x(b), mid_y(b), POINTER_DOWN, 1);
    poke(g[..], mid_x(b), mid_y(b) + 60, POINTER_MOVE, 1);
    poke(g[..], mid_x(b), mid_y(b) + 60, POINTER_UP, 1);
    #assert g[0].s[0].open == 0;
  }
}

// the header's crumbs go home and back to the project list
pf_2 :: () {
  out: [PAGE_OUT] f32;
  sizes := [4] f32.[1440, 900, 320, 568];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    g: [1] Page;
    _ := draw_page(g[..], out[..], w, h);
    hb := layout(w, h, 2).header;
    x0 := hb.x0 + 36; y := hb.y0 + 36;
    px := x0 + text_width("OPENAGENTS / ", 14) + text_width("PROJECTS", 14) * 0.5;
    poke(g[..], px, y, POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
    #assert tap(g[..], px, y, k) && g[0].s[0].action == ACT_NAVIGATE;
    #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], "/projects");
    coaxial_project_action_done(g[0].s[..]);
    #assert tap(g[..], x0 + 10, y, k) && same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], "/");
    #assert same(crumb_at(g[0].s[..], x0 + 10, hb.y0 + 80), "");
  }
}

// the detail opens and closes: CLOSE, a click outside, Esc, and the keys move through the queue
pf_3 :: () {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  vw := g[0].w[0].view;
  r := vw.hit_row[0];
  #assert tap(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), 0) && g[0].s[0].open == r + 1;
  _ = draw_page(g[..], out[..], w, h);
  l := project_layout(w, h, 2, g[0].w[..]);
  // wide: over the scene's column, the queue still there beside it
  #assert same_box(g[0].s[0].panel, l.scene) && g[0].w[0].view.hit_n > 0;
  // a click inside the panel keeps it; CLOSE closes it and clears the hash
  #assert tap(g[..], mid_x(l.scene), l.scene.y1 - 20, 0) && g[0].s[0].open == r + 1;
  c := g[0].s[0].close;
  #assert inside(l.scene, mid_x(c), mid_y(c));
  poke(g[..], mid_x(c), mid_y(c), POINTER_MOVE, 0);
  #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
  #assert tap(g[..], mid_x(c), mid_y(c), 0) && g[0].s[0].open == 0 && g[0].s[0].out_n == 0 && g[0].s[0].action == ACT_HASH;
  // another row's click switches to it; a click outside both closes
  #assert tap(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), 0);
  #assert tap(g[..], mid_x(vw.hit_box[1]), mid_y(vw.hit_box[1]), 0) && g[0].s[0].open == vw.hit_row[1] + 1;
  #assert tap(g[..], mid_x(l.header), mid_y(l.header), 0) && g[0].s[0].open == 0;
}

// the keys move through the queue and open it; the location's hash opens a task
pf_4 :: () {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  vw := g[0].w[0].view;
  l := project_layout(w, h, 2, g[0].w[..]);
  // a click on the second row, then closed: the keys start there
  #assert tap(g[..], mid_x(vw.hit_box[1]), mid_y(vw.hit_box[1]), 0);
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ESCAPE, 0) && g[0].s[0].open == 0;
  // the keys: down picks the first shown, down again the next, Enter opens, Esc closes
  // (the first press shows the keys where the last click left them: the second row)
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].pick == vw.hit_row[1] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].pick == vw.hit_row[2] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_UP, 0) && coaxial_project_key(g[0].s[..], g[0].w[..], KEY_UP, 0);
  #assert g[0].s[0].pick == vw.hit_row[0] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ENTER, 0) && g[0].s[0].open == vw.hit_row[0] + 1;
  // with it open, down opens the next
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].open == vw.hit_row[1] + 1;
  // a fresh page: down picks the first row shown
  f: [1] Page;
  _ = draw_page(f[..], out[..], w, h);
  #assert coaxial_project_key(f[0].s[..], f[0].w[..], KEY_DOWN, 0) && f[0].s[0].pick == vw.hit_row[0] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ESCAPE, 0) && g[0].s[0].open == 0;
  #assert !coaxial_project_key(g[0].s[..], g[0].w[..], 'c', 8);   // the browser's keys stay the browser's
  // the hash opens a task straight away, and an empty one closes it
  alias := item(g[0].w[..], g[0].w[0].text, vw.hit_row[2], 0);
  n := put_text(g[0].l[0].inbox[..], 0, "#");
  n += put_text(g[0].l[0].inbox[..], n, alias);
  coaxial_project_hash(g[0].s[..], g[0].l[..], n);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].open == vw.hit_row[2] + 1;
  coaxial_project_hash(g[0].s[..], g[0].l[..], 0);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].open == 0;
  // the demo's placeholder queue opens nothing
  d: [1] Page;
  d[0].s[0].page = 1;
  _ = draw_page(d[..], out[..], w, h);
  #assert !tap(d[..], mid_x(l.queue), mid_y(l.queue), 0) && d[0].s[0].open == 0;
}

// a task's detail draws inside its panel within the vertex budget, scrolled or not: desktop
pf_5 :: () {
  #assert detail_fits(1440, 900, 2);
}

// a task's detail draws inside its panel within the vertex budget, scrolled or not: tablet and phone
pf_6 :: () {
  #assert detail_fits(768, 1024, 3) && detail_fits(320, 568, 3);
}

// a long body scrolls with the wheel, a drag and the keys; a blocker's alias opens it
pf_7 :: () {
  out: [PAGE_OUT] f32;
  w := 320.0f32 * 2; h := 568.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  // the task with the longest body, and one that waits on another
  long := -1; most := 0; waiting := -1;
  for r: 0..<g[0].w[0].n {
    if g[0].w[0].kind[r] != KIND_TASK { continue; }
    k := detail_of(g[0].w[..], r);
    if cell(COAX_WORK_DETAILS, k, 3).count > most { most = cell(COAX_WORK_DETAILS, k, 3).count; long = r; }
    if waiting < 0 && g[0].w[0].waits[r] >= 0 { waiting = r; }
  }
  #assert long >= 0 && waiting >= 0;
  open_task(g[0].s[..], g[0].w[..], long);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].scroll_max > 0 && g[0].w[0].view.hit_n == 0;   // full screen: no rows under it
  coaxial_project_wheel(g[0].s[..], 100);
  #assert g[0].s[0].scroll == 200;
  coaxial_project_wheel(g[0].s[..], -1000);
  #assert g[0].s[0].scroll == 0;
  coaxial_project_wheel(g[0].s[..], 1000000);
  #assert g[0].s[0].scroll == g[0].s[0].scroll_max;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_HOME, 0) && g[0].s[0].scroll == 0;
  // a finger drags it up
  p := g[0].s[0].panel;
  poke(g[..], mid_x(p), p.y1 - 100, POINTER_DOWN, 1);
  poke(g[..], mid_x(p), p.y1 - 400, POINTER_MOVE, 1);
  #assert g[0].s[0].scroll == hi(0, lo(300, g[0].s[0].scroll_max));
  poke(g[..], mid_x(p), p.y1 - 400, POINTER_UP, 1);
  #assert g[0].s[0].open == long + 1;   // a drag doesn't close it
  // the blocker's alias is a link to its own detail
  open_task(g[0].s[..], g[0].w[..], waiting);
  _ = draw_page(g[..], out[..], w, h);
  blocker := g[0].w[0].waits[waiting];
  found := -1;
  for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] == blocker { found = k; } }
  if found < 0 {
    // below the fold: scroll till it shows
    for step: 0..<40 {
      if found >= 0 { break; }
      coaxial_project_wheel(g[0].s[..], 200);
      _ = draw_page(g[..], out[..], w, h);
      for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] == blocker { found = k; } }
    }
  }
  #assert found >= 0;
  lb := g[0].s[0].link_box[found];
  #assert tap(g[..], mid_x(lb), mid_y(lb), 1) && g[0].s[0].open == blocker + 1 && g[0].s[0].scroll == 0;
  // and the phone's CLOSE closes it
  _ = draw_page(g[..], out[..], w, h);
  c := g[0].s[0].close;
  #assert tap(g[..], mid_x(c), mid_y(c), 1) && g[0].s[0].open == 0;
}

// a task's detail lists what it needs from other projects and who needs it, and each opens that project's page on it
pf_8 :: () {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  // two tasks: one needs Verse's #d981 (and a done one), the other is needed by Planetary Villa's #a3b5
  a := -1; b := -1;
  for r: 0..<g[0].w[0].n {
    if g[0].w[0].kind[r] != KIND_TASK || finished(g[0].w[..], r) || g[0].w[0].waits[r] >= 0 { continue; }
    if a < 0 { a = r; } else if b < 0 { b = r; }
  }
  #assert a >= 0 && b >= 0;
  lb: [256] u8;
  m := put_text(lb[..], 0, item(g[0].w[..], g[0].w[0].text, a, 0)); m += put_text(lb[..], m, "|needs|verse|d981|open|The galaxy\n");
  m += put_text(lb[..], m, item(g[0].w[..], g[0].w[0].text, a, 0)); m += put_text(lb[..], m, "|needs|verse|abcd|resolved|Done one\n");
  m += put_text(lb[..], m, item(g[0].w[..], g[0].w[0].text, b, 0)); m += put_text(lb[..], m, "|by|planetary-villa|a3b5|open|Wants it\n");
  g[0].w[0].links = cast(string) lb[0..<m];
  read_work(g[0].w[..], g[0].w[0].text);
  #assert !g[0].w[0].ready[a] && g[0].w[0].far[a] >= 0;
  // the queue says what it waits on, and draws inside its panel
  n := draw_page(g[..], out[..], w, h);
  #assert n > 3000 && n <= MAX_VERTICES;
  wanted := [2] string.["/projects/verse#d981", "/projects/planetary-villa#a3b5"];
  picks := [2] int.[a, b];
  for i: 0..<2 {
    open_task(g[0].s[..], g[0].w[..], picks[i]);
    found := -1;
    for step: 0..<40 {
      _ = draw_page(g[..], out[..], w, h);
      for k: 0..<g[0].s[0].link_n { if found < 0 && g[0].s[0].link_row[k] <= -2 { found = k; } }
      if found >= 0 { break; }
      coaxial_project_wheel(g[0].s[..], 200);
    }
    #assert found >= 0;
    // a needs two: both drawn, the open one first
    if i == 0 {
      far := 0;
      for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] <= -2 { far += 1; } }
      #assert far == 2;
    }
    lk := g[0].s[0].link_box[found];
    #assert tap(g[..], mid_x(lk), mid_y(lk), 0) && g[0].s[0].action == ACT_NAVIGATE;
    #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], wanted[i]);
    g[0].s[0].action = 0;
  }
}

// a page names its project, paints what was baked, and draws the relay's fold from the last EOSE on
pf_9 :: () {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  uniforms: [UNIFORM_FLOATS] f32;
  s: [1] ProjectState; t: [1] Tree; w: [1] Work; lv: [1] Live;
  page_says(lv[..], "9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575 coax");
  n := coaxial_project_frame(s[..], t[..], w[..], lv[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 3000 && w[0].baked == 0 && w[0].live == LIVE_CONNECTING && same(w[0].text, COAX_WORK_ITEMS) && t[0].n == (ifx COAX_COMMITS < MAX_COMMITS then COAX_COMMITS else MAX_COMMITS);
  #assert lv[0].pipe[0].n == 1 && same(pipe_bytes(lv[0].pipe[..], 0), COAX_WORK_RELAY);
  pipe_drained(lv[0].pipe[..]);
  coaxial_project_opened(lv[..], 0);
  fake_message(lv[..], 0, SOCKET_OPENED, "");
  feed_transcript(lv[..], 0, COAX_RELAY);
  #assert lv[0].state == LIVE_SYNCING && !lv[0].dirty;
  finish_fixture_backfill(lv[..], 0);
  n = coaxial_project_frame(s[..], t[..], w[..], lv[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  // This historical capture is older than the current baked queue. Missing
  // immutable roots must retain the full snapshot, never shrink it to the
  // old fixture just because its watches sent EOSE.
  #assert n > 3000 && w[0].live == LIVE_OFFLINE && lv[0].folds == 0;
  #assert same(w[0].text, COAX_WORK_ITEMS) && same(w[0].details, COAX_WORK_DETAILS);
  #assert same(w[0].name, "Coax") && same(w[0].license, "Apache-2.0") && same(w[0].path, "coax/");
  // another baked project, and one this build doesn't know
  s2: [1] ProjectState; t2: [1] Tree; w2: [1] Work; l2: [1] Live;
  page_says(l2[..], "951b70f9fa97d8214e0c9f3ff392a1dd1668e61561ef21a2a69168d382452e18 verse");
  n = coaxial_project_frame(s2[..], t2[..], w2[..], l2[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 3000 && w2[0].baked == baked_index("verse") && w2[0].baked > 0 && same(w2[0].name, "Verse") && same(w2[0].text, VERSE_WORK_ITEMS);
  s3: [1] ProjectState; t3: [1] Tree; w3: [1] Work; l3: [1] Live;
  page_says(l3[..], "1111111111111111111111111111111111111111111111111111111111111111 elsewhere");
  n = coaxial_project_frame(s3[..], t3[..], w3[..], l3[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 1000 && w3[0].baked == -1 && same(w3[0].name, "elsewhere") && t3[0].n == 0 && l3[0].pipe[0].n == 1;
  // a page that names nothing is Coax's
  s4: [1] ProjectState; t4: [1] Tree; w4: [1] Work; l4: [1] Live;
  n = coaxial_project_frame(s4[..], t4[..], w4[..], l4[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert w4[0].baked == 0 && same(live_slug(l4[..]), "coax");
}
