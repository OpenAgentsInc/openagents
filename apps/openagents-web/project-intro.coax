// Editorial introduction for the actual Coax project, separate from relay data.
COAX_PROJECT_KEY :: "9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575";
COAX_INTRO :: "Coax is OpenAgents' systems language for fast, real-time software. It brings the web, worlds and machine learning into one codebase with built-in checks, compiled through C11 to native code and WebAssembly. The bootstrap works today; the language and libraries are still growing alongside a runnable book.";
COAX_BOOK_URL :: "https://github.com/OpenAgentsInc/openagents/blob/main/coax/book/README.md";

project_intro :: (w:[]Work)->bool {return w.count==1 && same(w[0].slug,"coax") && same(w[0].key,COAX_PROJECT_KEY);}
coax_intro_lines :: (room:f32)->int {
  p:=Pen.{d=1,fade=1};k:=ink(p,INK_WHITE);next:[1]int;from:=0;n:=0;
  while from<COAX_INTRO.count {
    end:=wrap_ink(COAX_INTRO,from,room,8.5,GAP,SPACE,k,next[..]);
    if next[0]<=from {break;}from=next[0];n+=1;
  }return n;
}
coax_head_height :: (width:f32)->f32 {
  margin:=ifx width<TWO then 12.0f32 else 24.0f32;
  return 178+cast(f32)coax_intro_lines(width-2*margin-36)*19;
}
coax_book_box :: (b:Box,d:f32)->Box {
  baseline:=b.y0+(90+19*cast(f32)coax_intro_lines((box_w(b)-36*d)/d))*d;
  return Box.{x0=b.x0+18*d,y0=baseline-24*d,x1=lo(b.x1-18*d,b.x0+38*d+text_width("READ THE COAX BOOK",9*d)),y1=baseline+20*d};
}
coax_header :: (out:[]f32,at:int,b:Box,p:Pen,w:[]Work)->int {
  d:=p.d;v:=at;x:=b.x0+18*d;right:=b.x1-18*d;
  body:=ink(p,INK_WHITE);dim:=ink(p,INK_DIM);title:=body;title.sans=false;orange:=ink(p,INK_ORANGE);
  v=put(out,v,"OPENAGENTS / PROJECTS / COAX",x,b.y0+22*d,7*d,orange);
  ab:=add_box(w,b,d);if ab.x1>ab.x0 {v=put(out,v,add_label(w,b,d),ab.x0,b.y0+22*d,7*d,orange);}
  v=put(out,v,"Coax",x,b.y0+58*d,26*d,title);
  lines:[1]int;v=put_wrapped(out,v,COAX_INTRO,x,b.y0+82*d,8.5*d,body,right-x,19*d,32,lines[..]);
  book:=coax_book_box(b,d);
  v=put(out,v,"READ THE COAX BOOK",book.x0,book.y0+28*d,9*d,orange);
  v=rule(out,v,book.x0,book.y0+34*d,book.x0+text_width("READ THE COAX BOOK",9*d),book.y0+34*d,orange,0.8*p.fade);
  y:=book.y1+24*d;cap:=7*d;
  v=chip(out,v,"IN DEVELOPMENT",x,y,cap,orange,p);
  lx:=x+chip_width("IN DEVELOPMENT",cap,p)+8*d;
  v=chip(out,v,w[0].license,lx,y,cap,dim,p);
  source:=ifx w[0].live==LIVE_LIVE then "LIVE" else ifx w[0].live==LIVE_OFFLINE then "OFFLINE" else "CONNECTING";
  sx:=lx+chip_width(w[0].license,cap,p)+8*d;
  if sx+chip_width(source,cap,p)>right {sx=x;y+=23*d;}
  v=chip(out,v,source,sx,y,cap,dim,p);
  return frame(out,v,b,10*d,p);
}
