// A project's page, drawn by Coax: /projects/coax first. The whole screen is
// HUD: glass panels with their corners clipped at 45° (project.wgsl draws
// the glass; this file places it), stroke text (font.coax), and in the
// middle the project's plot on the Grid, seen from a slow orbit, with its
// commit history growing out of it as a tree and agents walking between the
// task queue's beacon and the branches they're working on.
//
// Real: the project, its tasks, claims, plans, notes and order, live from
// its relay (project-live.coax); the commits (baked by projects/commits.sh
// into projects/SLUG/commits.coax), file and line counts. The page learns
// which project it shows from its HTML (data-text: "KEY SLUG"), so one
// project.wasm draws every project. Placeholders until the projects API
// exists (docs/protocol/2026-10-28-projects.md): the demo's agents and
// their activity.
//
// Checks: coax test apps/openagents-web/project.coax --steps 300000000. They
// draw whole frames of the real baked Coax queue (a frame is ~14M steps, the
// longest check ~135M), more than the default 20M a check.

#load "font.coax";
#load "projects/baked.coax";   // every project with a page (coax/web/project/baked.ts)
#load "project-live.coax";
#load "analytics.coax";
#load "project-intro.coax";
// Separately compiled checked admission policy; no authority checks attach to the UI graph.
project_row_count_fits :: (count:int,maximum:int)->bool #foreign;

// page 0 is a real page (/projects/SLUG), 1 the demo (/projects/coax/demo).
// The rest is the page's input: the pointer, the task open in the detail
// panel and what the last frame drew there, for the pointer to find.
ProjectState :: struct {
  time: f32;
  frames: int;
  page: int;
  width: f32; height: f32; dpr: f32;   // the last frame's canvas, device pixels
  // the pointer, device pixels; touch when the last one was a finger or pen
  px: f32; py: f32; touch: bool; pointed: bool;
  down: bool; down_x: f32; down_y: f32; moved: bool; drag_scroll: f32;
  pick: int;                 // the task the keys are on: its row + 1, 0 for none
  keys_moved: bool;          // the keys moved last (the pick shows), not the pointer
  open: int;                 // the task in the detail panel: its row + 1, 0 when closed
  scroll: f32; scroll_max: f32;
  // what the detail panel drew last
  panel: Box; close: Box;
  link_n: int; link_box: [MAX_LINKS] Box; link_row: [MAX_LINKS] int;
  // the open task's text, decoded from WORK_DETAILS (undetail)
  body: [DETAIL_BODY] u8; body_n: int;
  checks: [DETAIL_LIST] u8; checks_n: int;
  notes: [DETAIL_BODY] u8; notes_n: int;
  event: [64] u8; event_n: int;          // its id, hex
  nevent: [NAME_ROOM] u8; nevent_n: int;  // and its NIP-19 name with the relay hint (the face writes it)
  nevent_for: int;                        // the open task nevent names (open), 0 for none yet
  claimed: [24] u8; claimed_n: int;
  // the location's hash: the task a link asks for (in), the task open now (outbox out)
  want: [16] u8; want_n: int; wanted: bool;
  action: int; outbox: [160] u8; out_n: int;
  chosen: bool;      // the project is picked (at the first frame)
}
MAX_LINKS :: 48;
DETAIL_BODY :: 16384;
DETAIL_LIST :: 4096;

MSG_PAGE_TEXT :: 2;   // the host's: the page's data-text, once the engine loads

// What a build bakes for each project it knows: the first paint before the
// relay's first EOSE (snapshot.ts), the commits (commits.sh) and the owner
// (project.json), generated for every projects/<slug>/project.json into
// projects/baked.coax by coax/web/project/baked.ts. A project
// the build doesn't know still draws live, without a tree.
Baked :: struct {
  slug: string; pubkey: string; relay: string; naddr: string;
  name: string; description: string; license: string; path: string; repo: string; owner: string;
  items: string; log: string; plans: string; plan_info: string; details: string; steps: string;
  links: string;   // WORK_LINKS: work across projects (project-links.coax)
  history: string; commits: int; authors: int; lines: int;
}
// The baked project with this slug, or -1.
baked_index :: (slug: string) -> int {
  for k: 0..<BAKED_N { if same(baked(k).slug, slug) { return k; } }
  return -1;
}
DEFAULT_RELAY :: "wss://relay.openagents.com";
// Room for a NIP-19 name the face writes (project-names-face.h, encoded by
// project-names.coax, its own library): an naddr or nevent with a relay hint.
NAME_ROOM :: 320;

VERTEX_FLOATS :: 12;   // x, y, along, across, length, core, light, glow, red, green, blue, mode
MAX_VERTICES :: 240000;  // the page is ~120K at 1440 px; an open detail adds up to ~70K
PANELS :: 10;
UNIFORM_FLOATS :: 88;  // width, height, time, fade, still, panels, 0, 0, then per panel x0, y0, x1, y1, cut, alpha, tint, 0

MODE_STROKE :: 0.0;    // a sharp core in a soft glow
MODE_LINK :: 1.0;      // a soft line, faded at its ends
MODE_PULSE :: 2.0;     // a hot head with a tail: work in flight

GAP :: 0.34;           // letter gap, cap heights
SPACE :: 0.95;         // a space, cap heights
MAX_COMMITS :: 256;
BRANCHES :: 7;

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }
fract :: (x: f32) -> f32 { return x - floor(x); }

// One stroke as a quad wide enough for its glow (as splash.coax draws them).
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0.002 { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v];
    out[o + 3] = c[v];
    out[o + 4] = length;
    out[o + 5] = core;
    out[o + 6] = light;
    out[o + 7] = glow;
    out[o + 8] = red;
    out[o + 9] = green;
    out[o + 10] = blue;
    out[o + 11] = mode;
  }
  return true;
}

// ---------------------------------------------------------------- the palette and the pen

Pen :: struct { d: f32; fade: f32; time: f32; demo: bool; }

// The four inks of the page: white text, dim text, the lit blue (orange is only for Bitcoin)
// and the pale blue of something in review.
INK_WHITE :: 0; INK_DIM :: 1; INK_LIT :: 2; INK_PALE :: 3; INK_FAINT :: 4;
ink :: (p: Pen, kind: int) -> Ink {
  k := Ink.{core = 0.5 * p.d, light = 0.9 * p.fade, glow = 3.2 * p.d, red = 0.93, green = 0.93, blue = 0.95, mode = MODE_STROKE, scale = p.d};
  if kind == INK_DIM { k.light = 0.48 * p.fade; k.red = 0.82; k.green = 0.84; k.blue = 0.9; }
  if kind == INK_FAINT { k.light = 0.3 * p.fade; k.red = 0.8; k.green = 0.82; k.blue = 0.88; }
  if kind == INK_LIT { k.light = 1.0 * p.fade; k.red = 0.5; k.green = 0.82; k.blue = 1.0; k.glow = 4.5 * p.d; }
  if kind == INK_PALE { k.light = 0.95 * p.fade; k.red = 0.78; k.green = 0.9; k.blue = 1.0; }
  // small text is set in the system sans; titles, accent labels and the chrome stay in Filament
  k.sans = kind != INK_LIT;
  return k;
}

text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }

// Text from x at baseline y, caps cap device pixels tall.
put :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, at, text, x, y, cap, GAP, SPACE, k, false, false);
}

// Text ending at x.
put_right :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink) -> int {
  return put(out, at, text, x - ink_width(text, cap, GAP, SPACE, k), y, cap, k);
}

// How many bytes of text fit in width (device pixels) at cap.
fits :: (text: string, cap: f32, width: f32, k: Ink) -> int {
  if ink_width(text, cap, GAP, SPACE, k) <= width { return text.count; }
  n := 0; i := 0;
  while i < text.count {
    d := decode(text, i);
    if ink_width(text[0..<i + d.len], cap, GAP, SPACE, k) > width - ink_width("...", cap, GAP, SPACE, k) { break; }
    i += d.len; n = i;
  }
  return n;
}

// Text cut to width, with "..." when it was cut.
put_fit :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink, width: f32) -> int {
  n := fits(text, cap, width, k);
  if n >= text.count { return put(out, at, text, x, y, cap, k); }
  v := put(out, at, text[0..<n], x, y, cap, k);
  return put(out, v, "...", x + ink_width(text[0..<n], cap, GAP, SPACE, k) + (ifx uses_sans(k, cap) then 0.0f32 else GAP * cap), y, cap, k);
}

// Text wrapped to width from baseline y, lines step apart, at most lines
// lines. Returns the vertex count; drawn[0] gets the lines drawn.
put_wrapped :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink, width: f32,
                step: f32, lines: int, drawn: [] int) -> int {
  v := at; from := 0; n := 0;
  next: [1] int;
  while from < text.count && n < lines {
    end := wrap_ink(text, from, width, cap, GAP, SPACE, k, next[..]);
    v = put(out, v, text[from..<end], x, y + step * cast(f32) n, cap, k);
    n += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  if drawn.count > 0 { drawn[0] = n; }
  return v;
}

// A whole number: K for thousands when short is set, else commas (12,000).
number :: (n: int, short: bool, buf: [] u8) -> int {
  v := n; suffix := false;
  if short && v >= 10000 { v = v / 1000; suffix = true; }
  digits: [28] u8; c := 0;
  if v == 0 { digits[0] = '0'; c = 1; }
  k := 0;
  while v > 0 && c < 27 {
    if !short && k > 0 && k % 3 == 0 { digits[c] = ','; c += 1; }
    digits[c] = cast(u8) ('0' + v % 10); v = v / 10; c += 1; k += 1;
  }
  w := 0;
  for i: 0..<c { if w < buf.count { buf[w] = digits[c - 1 - i]; w += 1; } }
  if suffix && w < buf.count { buf[w] = 'K'; w += 1; }
  return w;
}

put_number :: (out: [] f32, at: int, n: int, short: bool, x: f32, y: f32, cap: f32, k: Ink) -> int {
  buf: [24] u8;
  c := number(n, short, buf[..]);
  return put(out, at, cast(string) buf[0..<c], x, y, cap, k);
}

number_width :: (n: int, short: bool, cap: f32) -> f32 {
  buf: [24] u8;
  c := number(n, short, buf[..]);
  return text_width(cast(string) buf[0..<c], cap);
}

// ---------------------------------------------------------------- HUD elements

Box :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
box_w :: (b: Box) -> f32 { return b.x1 - b.x0; }
box_h :: (b: Box) -> f32 { return b.y1 - b.y0; }

// A line in an ink, at a brightness.
rule :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, k: Ink, light: f32) -> int {
  if lit(out, at, ax, ay, bx, by, k.core, light, k.glow, k.red, k.green, k.blue, k.mode) { return at + 6; }
  return at;
}

// A panel's frame: the outline, faint, with 45° cuts on the plain corners
// (top right, bottom left) and square, bright L brackets on the highlighted
// ones (top left, bottom right), as the HUD's panels have.
frame :: (out: [] f32, at: int, b: Box, cut: f32, p: Pen) -> int {
  k := ink(p, INK_LIT);
  v := at; f := 0.28 * p.fade;
  xs := [7] f32.[b.x0, b.x1 - cut, b.x1, b.x1, b.x0 + cut, b.x0, b.x0];
  ys := [7] f32.[b.y0, b.y0, b.y0 + cut, b.y1, b.y1, b.y1 - cut, b.y0];
  for i: 0..<6 { v = rule(out, v, xs[i], ys[i], xs[i + 1], ys[i + 1], k, f); }
  // the brackets: square, top left and bottom right, bright
  arm := lo(36 * p.d, box_w(b) * 0.25);
  v = rule(out, v, b.x0, b.y0 + arm * 0.6, b.x0, b.y0, k, p.fade);
  v = rule(out, v, b.x0, b.y0, b.x0 + arm, b.y0, k, p.fade);
  v = rule(out, v, b.x1, b.y1 - arm * 0.6, b.x1, b.y1, k, p.fade);
  v = rule(out, v, b.x1, b.y1, b.x1 - arm, b.y1, k, p.fade);
  return v;
}

// A panel's title: lit, with a short tick before it and a rule under it.
// Returns the vertex count; the content starts at b.y0 + title_room.
title_room :: (p: Pen) -> f32 { return 34 * p.d; }
titled :: (out: [] f32, at: int, b: Box, title: string, note: string, p: Pen) -> int {
  cap := 8 * p.d; y := b.y0 + 20 * p.d;
  o := ink(p, INK_LIT);
  v := rule(out, at, b.x0 + 12 * p.d, y - cap * 0.5, b.x0 + 18 * p.d, y - cap * 0.5, o, p.fade);
  v = put(out, v, title, b.x0 + 24 * p.d, y, cap, o);
  if note.count > 0 {
    room := box_w(b) - 48 * p.d - text_width(title, cap);
    n := fits(note, 6.5 * p.d, room, ink(p, INK_DIM));
    v = put_right(out, v, note[0..<n], b.x1 - 14 * p.d, y, 6.5 * p.d, ink(p, INK_DIM));
  }
  v = rule(out, v, b.x0 + 12 * p.d, y + 7 * p.d, b.x1 - 12 * p.d, y + 7 * p.d, ink(p, INK_DIM), 0.12 * p.fade);
  return v;
}

// A chip: text in a small clipped outline. Its width:
chip_width :: (text: string, cap: f32, p: Pen) -> f32 { return text_width(text, cap) + 14 * p.d; }
chip :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink, p: Pen) -> int {
  w := chip_width(text, cap, p); h := cap + 10 * p.d; c := 4 * p.d;
  top := y - cap - 5 * p.d;
  xs := [7] f32.[x + c, x + w, x + w, x + w - c, x, x, x + c];
  ys := [7] f32.[top, top, top + h - c, top + h, top + h, top + c, top];
  v := at;
  for i: 0..<6 { v = rule(out, v, xs[i], ys[i], xs[i + 1], ys[i + 1], k, k.light * 0.55); }
  f := k; f.sans = false;   // chips are chrome: Filament
  return put(out, v, text, x + 7 * p.d, y, cap, f);
}

// A small diamond, as nodes and dots are drawn.
diamond :: (out: [] f32, at: int, x: f32, y: f32, r: f32, k: Ink, light: f32) -> int {
  v := rule(out, at, x, y - r, x + r, y, k, light);
  v = rule(out, v, x + r, y, x, y + r, k, light);
  v = rule(out, v, x, y + r, x - r, y, k, light);
  return rule(out, v, x - r, y, x, y - r, k, light);
}

// ---------------------------------------------------------------- the data

// Rows of '\n'-separated text, fields split by '|'.
row_start :: (text: string, row: int) -> int {
  r := 0; i := 0;
  while r < row && i < text.count { if text[i] == '\n' { r += 1; } i += 1; }
  return i;
}
field :: (text: string, row: int, col: int) -> string {
  i := row_start(text, row); c := 0;
  while c < col && i < text.count && text[i] != '\n' { if text[i] == '|' { c += 1; } i += 1; }
  j := i;
  while j < text.count && text[j] != '|' && text[j] != '\n' { j += 1; }
  return text[i..<j];
}
// The first byte of the row after the one starting at i: walk a table a row
// at a time with it and cell(), instead of field(), which counts from the top.
next_row :: (text: string, i: int) -> int {
  j := i;
  while j < text.count && text[j] != '\n' { j += 1; }
  return j + 1;
}
rows :: (text: string) -> int {
  n := 0;
  for i: 0..<text.count { if text[i] == '\n' { n += 1; } }
  if text.count > 0 && text[text.count - 1] != '\n' { n += 1; }
  return n;
}
same :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count { if a[i] != b[i] { return false; } }
  return true;
}

// The tasks. Placeholders: id | state | title | labels | sats | claimant | branch.
TASKS :: "CX-101|OPEN|Filament lowercase a to z (font.md stage 3)|FONT WEB|5000||web\nCX-102|CLAIMED|HEAD requests answer 405 in coax serve|WEB BUG|1000|MICROCODER-3|web\nCX-103|IN REVIEW|Markdown docs and blog pages in Coaxial (web.md W3)|WEB DOCS|12000|CODER-1|web\nCX-104|OPEN|Stage timing and generated-size reports (roadmap R0)|COMPILER|8000||src\nCX-105|CLAIMED|Original-source debugging: line maps for generated C|COMPILER|10000|SOLVER-7|src\nCX-106|OPEN|Coax emits WGSL for Coaxial shaders (roadmap R8a)|GPU|20000||src\nCX-107|OPEN|Book chapter: a web page in Coaxial|BOOK|3000||book\nCX-100|DONE|Filament capitals, digits and punctuation|FONT|4000|CODER-1|web\n";
STATE_OPEN :: 0; STATE_CLAIMED :: 1; STATE_REVIEW :: 2; STATE_DONE :: 3;
task_state :: (row: int) -> int {
  s := field(TASKS, row, 1);
  if same(s, "CLAIMED") { return STATE_CLAIMED; }
  if same(s, "IN REVIEW") { return STATE_REVIEW; }
  if same(s, "DONE") { return STATE_DONE; }
  return STATE_OPEN;
}
open_tasks :: () -> int {
  n := 0;
  for r: 0..<rows(TASKS) { if task_state(r) == STATE_OPEN { n += 1; } }
  return n;
}
claimed_tasks :: () -> int {
  n := 0;
  for r: 0..<rows(TASKS) { s := task_state(r); if s == STATE_CLAIMED || s == STATE_REVIEW { n += 1; } }
  return n;
}

// The agents at work (placeholders): name | task | branch.
AGENTS :: "MICROCODER-3|CX-102|web\nSOLVER-7|CX-105|src\nCODER-1|CX-103|web\n";

// ---------------------------------------------------------------- the real work (from the relay)

// WORK_ITEMS (projects/coax/work.coax, made by coax/web/project/snapshot.ts
// from the project's Nostr events): one row an item, fields
//   alias | kind | status | title | labels | size | worker | parent | blocked by | rank | slug | commit | done at
// where parent and blocked by are aliases, worker is who claimed it (empty
// when nobody has), commit the short hash that finished it and done at ten
// digits of seconds. Read once into Work: the queue's order is computed
// here, never stored as numbers. Claimed tasks come first (in progress),
// then ready ones (every blocker resolved or closed) by rank, then waiting
// ones by rank; the latest finished tasks are kept apart.
// A task ranked above an open blocker is shown with a warning: it moved
// ahead of what it waits on, and stays waiting until that's done.
MAX_ITEMS :: 320;   // bounded combined roadmap + Nostr queue; seed check prevents truncation
#assert MAX_ITEMS == FOLD_ISSUES; // a live fold cannot silently exceed the page's row capacity
RECENT :: 3;
KIND_INITIATIVE :: 0; KIND_MILESTONE :: 1; KIND_TASK :: 2;
WS_OPEN :: 0; WS_RESOLVED :: 1; WS_CLOSED :: 2; WS_DRAFT :: 3;

Work :: struct {
  read: bool;
  n: int;
  start: [MAX_ITEMS] int;     // each row's first byte
  rank: [MAX_ITEMS] string;   // each row's rank (column 9), read once for the sorts
  kind: [MAX_ITEMS] int;
  status: [MAX_ITEMS] int;
  parent: [MAX_ITEMS] int;    // a row, or -1
  ready: [MAX_ITEMS] bool;
  claimed: [MAX_ITEMS] bool;  // an open task a worker is on
  waits: [MAX_ITEMS] int;     // an open blocker's row, or -1
  ahead: [MAX_ITEMS] int;     // an open blocker ranked below this task, or -1
  queue: [MAX_ITEMS] int;     // open tasks: in progress, then ready by rank, then waiting by rank
  queued: int;
  working_n: int;             // in progress: claimed
  ready_n: int;               // ready and nobody on them
  recent: [RECENT] int;       // the latest finished tasks, newest first
  recent_n: int;
  done_n: int;
  tasks: int;
  milestones: [MAX_ITEMS] int;   // milestone rows by rank
  milestone_n: int;
  initiative: int;
  initiatives: [8] int;       // initiative rows by rank
  initiative_n: int;
  text: string;              // the WORK_ITEMS it was read from
  plans: string;              // WORK_PLANS: alias | mark (x done, > doing, o to do) | step
  plan_info: string;          // WORK_PLAN_INFO: alias | done | steps | plan updated | claimed | latest note
  details: string;            // WORK_DETAILS: alias | event id | claimed at | body | acceptance | notes (escaped: undetail)
  view: QueueView;            // what the queue drew last, for the pointer
  log: string;                // WORK_LOG: time (Chicago) | what, newest first
  steps: string;              // WORK_STEPS: how to take a task
  naddr: string;              // the project's address as baked (snapshot.ts), or ""
  key: string; relay: string; // the project's key and relay (set_names)
  // the address and the key as NIP-19 names them, encoded in Coax and
  // written by the face (project-names-face.h) once key is set; named says so
  naddr_buf: [NAME_ROOM] u8; naddr_n: int;
  npub_buf: [64] u8; npub_n: int; named: bool;
  // the header: from the project's 30621 event and its repository's 30617
  slug: string; name: string; description: string; license: string; path: string; repo: string;
  owner: string;              // who owns it (project.json owner), the header says
  realm: string;              // its first realm's page (the 30621's realm tag, a project made from a drop), or ""
  add: string;                // where a member drops more on it (/projects' drop area for this project), or ""
  add_buf: [192] u8;
  dstart: [MAX_ITEMS] int;    // each row's line in details (index_details), or -1
  dlines: int;                // the lines in details
  links: string;              // WORK_LINKS: alias | needs or by | project d | its alias | its status | its title
  far: [MAX_ITEMS] int;       // the first open need of another project's issue: its line in links, or -1
  links_buf: [LINKS_CAP] u8;  // links, when they come from the relay (live_links_end)
  baked: int;                 // the baked project it started from, or -1
  // the line to the relay, for the header's chip
  live: int;                  // LIVE_* (project-live.coax)
  head: [1024] u8;            // the header's strings, when they come from the relay
}

// The queue's rows as the last frame drew them, and what they light: the
// row under a mouse, the one the keys are on and the one that's open (rows
// + 1, 0 for none; px, py the pointer, hover false for a finger).
MAX_HITS :: 64;
QueueView :: struct {
  hit_n: int; hit_box: [MAX_HITS] Box; hit_row: [MAX_HITS] int;
  px: f32; py: f32; hover: bool; pick: int; open: int;
}

// A task's row in a table keyed by alias (column 0), or -1.
keyed :: (table: string, alias: string, from: int) -> int {
  i := row_start(table, from); r := from;
  while i < table.count { if same(cell(table, i, 0), alias) { return r; } i = next_row(table, i); r += 1; }
  return -1;
}

// A tick for a plan step, centred at (x, y): done is a check, doing a
// beating diamond, to do an empty square.
step_mark :: (out: [] f32, at: int, mark: string, x: f32, y: f32, p: Pen) -> int {
  d := p.d; v := at;
  if same(mark, ">") {
    beat := 0.55 + 0.45 * sin(p.time * 2.4);
    return diamond(out, v, x, y, 2.4 * d, ink(p, INK_LIT), beat * p.fade);
  }
  if same(mark, "x") {
    k := ink(p, INK_PALE);
    v = rule(out, v, x - 2.6 * d, y, x - 0.8 * d, y + 2 * d, k, 0.8 * p.fade);
    return rule(out, v, x - 0.8 * d, y + 2 * d, x + 2.8 * d, y - 2.6 * d, k, 0.8 * p.fade);
  }
  k := ink(p, INK_DIM); r := 2.2 * d;
  v = rule(out, v, x - r, y - r, x + r, y - r, k, 0.5 * p.fade);
  v = rule(out, v, x + r, y - r, x + r, y + r, k, 0.5 * p.fade);
  v = rule(out, v, x + r, y + r, x - r, y + r, k, 0.5 * p.fade);
  return rule(out, v, x - r, y + r, x - r, y - r, k, 0.5 * p.fade);
}

// Under a task in progress: its worker's plan, the step it's on and the
// ones around it when they don't all fit, then the latest note. Returns the
// last line's y.
PlanDrawn :: struct { v: int; y: f32; }
plan_steps :: (out: [] f32, at: int, w: [] Work, alias: string, x: f32, y0: f32, right: f32, bottom: f32, limit: int, p: Pen) -> PlanDrawn {
  d := p.d; v := at;
  dim := ink(p, INK_DIM); pale := ink(p, INK_PALE); white := ink(p, INK_WHITE); accent := ink(p, INK_LIT);
  small := 6 * d; line := 11 * d;
  plans := w[0].plans;
  total := 0; current := -1;
  pi := 0;
  while pi < plans.count {
    pa := pi; pi = next_row(plans, pi);
    if !same(cell(plans, pa, 0), alias) { continue; }
    mark := cell(plans, pa, 1);
    if current < 0 && !same(mark, "x") { current = total; }
    total += 1;
  }
  y := y0;
  if total == 0 {
    if y <= bottom { v = put_fit(out, v, "NO PLAN POSTED YET", x, y, small, dim, right - x); }
    return PlanDrawn.{v = v, y = y};
  }
  // the window: from the step before the current one, as many as fit
  skip := 0;
  if total > limit {
    skip = ifx current > 0 then current - 1 else 0;
    if current < 0 { skip = total - limit; }
    if skip + limit > total { skip = total - limit; }
  }
  if skip > 0 {
    buf: [32] u8;
    n := number(skip, false, buf[..]);
    n += put_text(buf[..], n, " DONE ABOVE");
    if y <= bottom { v = put(out, v, cast(string) buf[0..<n], x + 10 * d, y, 5.5 * d, dim); }
    y += line;
  }
  k := 0; drawn := 0;
  pi = 0;
  while pi < plans.count {
    r := pi; pi = next_row(plans, pi);
    if !same(cell(plans, r, 0), alias) { continue; }
    if k < skip || drawn >= limit || y > bottom { k += 1; continue; }
    mark := cell(plans, r, 1);
    v = step_mark(out, v, mark, x + 3 * d, y - small * 0.45, p);
    tint := ifx same(mark, ">") then white else ifx same(mark, "x") then dim else pale;
    v = put_fit(out, v, cell(plans, r, 2), x + 10 * d, y, small, tint, right - x - 10 * d);
    y += line; k += 1; drawn += 1;
  }
  rest := total - skip - drawn;
  if rest > 0 && y <= bottom {
    buf: [32] u8;
    n := number(rest, false, buf[..]);
    n += put_text(buf[..], n, " MORE TO DO");
    v = put(out, v, cast(string) buf[0..<n], x + 10 * d, y, 5.5 * d, dim);
    y += line;
  }
  info := keyed(w[0].plan_info, alias, 0);
  if info >= 0 {
    note := field(w[0].plan_info, info, 5);
    if note.count > 0 && y <= bottom {
      v = put(out, v, "NOTE", x, y, 5.5 * d, accent);
      v = put_fit(out, v, note, x + 26 * d, y, 5.5 * d, dim, right - x - 26 * d);
      y += line;
    }
  }
  return PlanDrawn.{v = v, y = y - line};
}

cell :: (text: string, start: int, col: int) -> string {
  i := start; c := 0;
  while c < col && i < text.count && text[i] != '\n' { if text[i] == '|' { c += 1; } i += 1; }
  j := i;
  while j < text.count && text[j] != '|' && text[j] != '\n' { j += 1; }
  return text[i..<j];
}
// Byte order: ranks are base-62 digits in ASCII order.
before :: (a: string, b: string) -> bool {
  n := ifx a.count < b.count then a.count else b.count;
  for i: 0..<n { if a[i] != b[i] { return a[i] < b[i]; } }
  return a.count < b.count;
}
work_kind :: (s: string) -> int {
  if same(s, "initiative") { return KIND_INITIATIVE; }
  if same(s, "milestone") { return KIND_MILESTONE; }
  return KIND_TASK;
}
work_status :: (s: string) -> int {
  if same(s, "resolved") { return WS_RESOLVED; }
  if same(s, "closed") { return WS_CLOSED; }
  if same(s, "draft") { return WS_DRAFT; }
  return WS_OPEN;
}
// A need of another project's issue holds until that issue is resolved or closed.
link_open :: (status: string) -> bool { return !same(status, "resolved") && !same(status, "closed"); }
// A project's name from its d, as the page writes it: PLANETARY VILLA.
put_project :: (buf: [] u8, at: int, d: string) -> int {
  n := 0;
  while n < d.count && at + n < buf.count {
    c := d[n];
    buf[at + n] = ifx c == '-' then ' ' else (ifx c >= 'a' && c <= 'z' then cast(u8) (c - 32) else c);
    n += 1;
  }
  return n;
}
finished :: (w: [] Work, r: int) -> bool { return w[0].status[r] == WS_RESOLVED || w[0].status[r] == WS_CLOSED; }
row_of :: (w: [] Work, text: string, alias: string) -> int {
  if alias.count == 0 { return -1; }
  for r: 0..<w[0].n { if same(cell(text, w[0].start[r], 0), alias) { return r; } }
  return -1;
}
item :: (w: [] Work, text: string, r: int, col: int) -> string { return cell(text, w[0].start[r], col); }

// Rows sorted by rank, in place (insertion sort: at most MAX_ITEMS).
by_rank :: (w: [] Work, text: string, order: [] int, n: int) {
  for i: 1..<n {
    k := order[i]; j := i - 1;
    while j >= 0 && before(w[0].rank[k], w[0].rank[order[j]]) { order[j + 1] = order[j]; j -= 1; }
    order[j + 1] = k;
  }
}

read_work :: (w: [] Work, text: string) {
  // Private parser: every public replacement preflights the complete row set.
  #assert rows(text) <= MAX_ITEMS;
  w[0].read = true;
  w[0].text = text;
  n := 0; i := 0;
  while i < text.count && n < MAX_ITEMS {
    w[0].start[n] = i; n += 1;
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  w[0].n = n;
  w[0].initiative = -1;
  for r: 0..<n {
    w[0].rank[r] = cell(text, w[0].start[r], 9);
    w[0].kind[r] = work_kind(cell(text, w[0].start[r], 1));
    w[0].status[r] = work_status(cell(text, w[0].start[r], 2));
    if w[0].kind[r] == KIND_INITIATIVE && w[0].initiative < 0 { w[0].initiative = r; }
  }
  for r: 0..<n { w[0].parent[r] = row_of(w, text, cell(text, w[0].start[r], 7)); w[0].far[r] = -1; }
  // what another project's issue still has to do first
  lt := w[0].links; li := 0;
  while li < lt.count {
    if same(cell(lt, li, 1), "needs") && link_open(cell(lt, li, 4)) {
      k := row_of(w, text, cell(lt, li, 0));
      if k >= 0 && w[0].far[k] < 0 { w[0].far[k] = li; }
    }
    li = next_row(lt, li);
  }
  // readiness: every blocker done; the first open one is what it waits on
  for r: 0..<n {
    w[0].waits[r] = -1; w[0].ahead[r] = -1;
    blockers := cell(text, w[0].start[r], 8);
    a := 0;
    while a < blockers.count {
      b := a;
      while b < blockers.count && blockers[b] != ' ' { b += 1; }
      k := row_of(w, text, blockers[a..<b]);
      if k >= 0 && !finished(w, k) {
        if w[0].waits[r] < 0 { w[0].waits[r] = k; }
        if w[0].ahead[r] < 0 && before(w[0].rank[r], w[0].rank[k]) { w[0].ahead[r] = k; }
      }
      a = b + 1;
    }
    w[0].ready[r] = w[0].kind[r] == KIND_TASK && w[0].status[r] == WS_OPEN && w[0].waits[r] < 0 && w[0].far[r] < 0;
    w[0].claimed[r] = w[0].kind[r] == KIND_TASK && !finished(w, r) && cell(text, w[0].start[r], 6).count > 0;
  }
  // the queue: tasks in progress, then ready ones by rank, then the rest
  // still to do by rank
  working: [MAX_ITEMS] int; ready: [MAX_ITEMS] int; rest: [MAX_ITEMS] int;
  on := 0; rn := 0; sn := 0; tasks := 0; done := 0; mn := 0;
  for r: 0..<n {
    if w[0].kind[r] == KIND_MILESTONE { w[0].milestones[mn] = r; mn += 1; }
    if w[0].kind[r] != KIND_TASK { continue; }
    tasks += 1;
    if finished(w, r) { done += 1; continue; }
    if w[0].claimed[r] { working[on] = r; on += 1; }
    else if w[0].ready[r] { ready[rn] = r; rn += 1; } else { rest[sn] = r; sn += 1; }
  }
  by_rank(w, text, working[..], on);
  by_rank(w, text, ready[..], rn);
  by_rank(w, text, rest[..], sn);
  by_rank(w, text, w[0].milestones[..], mn);
  // the initiatives by rank: each one's milestones are drawn under it
  ins: [MAX_ITEMS] int; inn := 0;
  for r: 0..<n { if w[0].kind[r] == KIND_INITIATIVE { ins[inn] = r; inn += 1; } }
  by_rank(w, text, ins[..], inn);
  if inn > 8 { inn = 8; }
  for k: 0..<inn { w[0].initiatives[k] = ins[k]; }
  w[0].initiative_n = inn;
  if inn > 0 { w[0].initiative = ins[0]; }
  for k: 0..<on { w[0].queue[k] = working[k]; }
  for k: 0..<rn { w[0].queue[on + k] = ready[k]; }
  for k: 0..<sn { w[0].queue[on + rn + k] = rest[k]; }
  w[0].queued = on + rn + sn; w[0].working_n = on; w[0].ready_n = rn; w[0].done_n = done; w[0].tasks = tasks; w[0].milestone_n = mn;
  // the latest finished: the largest done-at, newest first
  w[0].recent_n = 0;
  for k: 0..<RECENT {
    best := -1;
    for r: 0..<n {
      if w[0].kind[r] != KIND_TASK || !finished(w, r) { continue; }
      taken := false;
      for j: 0..<w[0].recent_n { if w[0].recent[j] == r { taken = true; } }
      if taken { continue; }
      if best < 0 || before(cell(text, w[0].start[best], 12), cell(text, w[0].start[r], 12)) { best = r; }
    }
    if best < 0 { break; }
    w[0].recent[w[0].recent_n] = best; w[0].recent_n += 1;
  }
}

// A milestone's tasks: how many, done and ready.
Progress :: struct { total: int; done: int; ready: int; }
progress :: (w: [] Work, m: int) -> Progress {
  p: Progress;
  for r: 0..<w[0].n {
    if w[0].kind[r] != KIND_TASK || w[0].parent[r] != m { continue; }
    p.total += 1;
    if finished(w, r) { p.done += 1; }
    if w[0].ready[r] { p.ready += 1; }
  }
  return p;
}

// The tree's branches: the subfolders of coax/ a commit mostly touched.
branch_index :: (name: string) -> int {
  if same(name, "src") { return 1; }
  if same(name, "tests") { return 2; }
  if same(name, "book") { return 3; }
  if same(name, "web") { return 4; }
  if same(name, "examples") { return 5; }
  if same(name, "bin") { return 6; }
  return 0;   // spec: the folder's own files
}
// A subfolder's branch on this tree: Coax's own subfolders keep their
// places; any other gets the next free one, in the order it first appears
// (the spec branch, 0, when all are taken).
branch_of :: (t: [] Tree, name: string) -> int {
  k := branch_index(name);
  if k != 0 || same(name, "spec") { return k; }
  for b: 1..<BRANCHES {
    if t[0].label_n[b] != name.count + 1 { continue; }
    match := true;
    for i: 0..<name.count { c := name[i]; if t[0].labels[b * 24 + i] != (ifx c >= 'a' && c <= 'z' then c - 32 else c) { match = false; } }
    if match { return b; }
  }
  for b: 1..<BRANCHES {
    if t[0].used[b] || name.count + 1 > 24 { continue; }
    t[0].used[b] = true;
    for i: 0..<name.count { c := name[i]; t[0].labels[b * 24 + i] = ifx c >= 'a' && c <= 'z' then c - 32 else c; }
    t[0].labels[b * 24 + name.count] = '/';
    t[0].label_n[b] = name.count + 1;
    return b;
  }
  return 0;
}
branch_label :: (t: [] Tree, b: int) -> string {
  if t[0].label_n[b] > 0 { return cast(string) t[0].labels[b * 24..<b * 24 + t[0].label_n[b]]; }
  return branch_name(b);
}
branch_name :: (b: int) -> string {
  if b == 1 { return "SRC/"; }
  if b == 2 { return "TESTS/"; }
  if b == 3 { return "BOOK/"; }
  if b == 4 { return "WEB/"; }
  if b == 5 { return "EXAMPLES/"; }
  if b == 6 { return "BIN/"; }
  return "SPEC";
}

// ---------------------------------------------------------------- the tree

Vec3 :: struct { x: f32; y: f32; z: f32; }
v3 :: (x: f32, y: f32, z: f32) -> Vec3 { return Vec3.{x = x, y = y, z = z}; }
add :: (a: Vec3, b: Vec3) -> Vec3 { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }
sub :: (a: Vec3, b: Vec3) -> Vec3 { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }
scale :: (a: Vec3, k: f32) -> Vec3 { return v3(a.x * k, a.y * k, a.z * k); }
dot :: (a: Vec3, b: Vec3) -> f32 { return a.x * b.x + a.y * b.y + a.z * b.z; }
cross :: (a: Vec3, b: Vec3) -> Vec3 { return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x); }
normalize :: (a: Vec3) -> Vec3 { l := sqrt(dot(a, a)); if l <= 0 { return a; } return scale(a, 1 / l); }
mix3 :: (a: Vec3, b: Vec3, t: f32) -> Vec3 { return add(a, scale(sub(b, a), t)); }

// One node per commit: where it sits and which branch it's on. The trunk
// climbs with time; each commit hangs on its branch, which leaves the trunk
// at its first commit and reaches out and up as the branch grows.
Tree :: struct {
  n: int;
  branch: [MAX_COMMITS] int;
  at: [MAX_COMMITS] Vec3;
  trunk: [MAX_COMMITS] f32;   // the trunk's height at each commit
  last: [BRANCHES] int;       // the newest commit on each branch, or -1
  count: [BRANCHES] int;
  used: [BRANCHES] bool;      // a branch taken by a subfolder
  labels: [BRANCHES * 24] u8; label_n: [BRANCHES] int;   // names of the branches not Coax's own
  history: string;            // the commits it grew from
}

TRUNK :: 5.8;   // the tree's height, grid units
branch_angle :: (b: int) -> f32 { return 0.5 + cast(f32) b * 2.0 * 3.14159265 / cast(f32) BRANCHES; }

grow :: (t: [] Tree, all: string) {
  // the newest MAX_COMMITS commits (the history is oldest first)
  from := 0;
  for skip: 0..<rows(all) - MAX_COMMITS { from = next_row(all, from); }
  history := all[from..<all.count];
  n := rows(history);
  t[0].n = n; t[0].history = history;
  for b: 0..<BRANCHES { t[0].last[b] = -1; t[0].count[b] = 0; t[0].used[b] = false; t[0].label_n[b] = 0; }
  // Coax's own subfolders hold their places; the others take what's left
  firsts: [MAX_COMMITS] int;
  hi_at := 0;
  for i: 0..<n { firsts[i] = hi_at; hi_at = next_row(history, hi_at); }
  for i: 0..<n { k := branch_index(cell(history, firsts[i], 2)); if k != 0 { t[0].used[k] = true; } }
  branches: [MAX_COMMITS] int;
  for i: 0..<n { b := branch_of(t, cell(history, firsts[i], 2)); branches[i] = b; t[0].count[b] += 1; }
  seen: [BRANCHES] int;
  for i: 0..<n {
    b := branches[i];
    t[0].branch[i] = b;
    h := 0.35 + TRUNK * (ifx n > 1 then cast(f32) i / cast(f32) (n - 1) else 0.0f32);
    t[0].trunk[i] = h;
    k := seen[b]; seen[b] += 1;
    reach := 0.7 + 2.3 * cast(f32) (k + 1) / cast(f32) (t[0].count[b] + 1);
    a := branch_angle(b) + 0.06 * cast(f32) k;
    t[0].at[i] = v3(reach * cos(a), h + 0.25 * cast(f32) k / cast(f32) (t[0].count[b] + 1), reach * sin(a));
    t[0].last[b] = i;
  }
}

// ---------------------------------------------------------------- the camera

Camera :: struct { eye: Vec3; right: Vec3; up: Vec3; ahead: Vec3; cx: f32; cy: f32; focal: f32; clip: Box; }
Spot :: struct { x: f32; y: f32; z: f32; ok: bool; }

camera :: (b: Box, angle: f32) -> Camera {
  look := v3(0, 3.0, 0);
  eye := v3(12.5 * sin(angle), 6.2, 12.5 * cos(angle));
  ahead := normalize(sub(look, eye));
  right := normalize(cross(ahead, v3(0, 1, 0)));
  up := cross(right, ahead);
  // fit about 11 grid units of height in the box, and keep the tree inside a narrow one
  focal := lo(box_h(b) * 1.18, box_w(b) * 1.2);
  return Camera.{eye = eye, right = right, up = up, ahead = ahead, cx = (b.x0 + b.x1) * 0.5,
                 cy = b.y0 + box_h(b) * 0.58, focal = focal, clip = b};
}

spot :: (c: Camera, p: Vec3) -> Spot {
  v := sub(p, c.eye);
  z := dot(v, c.ahead);
  if z < 0.5 { return Spot.{x = 0, y = 0, z = z, ok = false}; }
  return Spot.{x = c.cx + dot(v, c.right) / z * c.focal, y = c.cy - dot(v, c.up) / z * c.focal, z = z, ok = true};
}

// A segment in the world, projected, cut to the camera's box (Liang-Barsky)
// and dimmed with distance.
seg :: (out: [] f32, at: int, c: Camera, a: Vec3, b: Vec3, k: Ink, light: f32) -> int {
  p := spot(c, a); q := spot(c, b);
  if !p.ok || !q.ok { return at; }
  t0 := 0.0f32; t1 := 1.0f32;
  dx := q.x - p.x; dy := q.y - p.y;
  ps := [4] f32.[-dx, dx, -dy, dy];
  qs := [4] f32.[p.x - c.clip.x0, c.clip.x1 - p.x, p.y - c.clip.y0, c.clip.y1 - p.y];
  for i: 0..<4 {
    if ps[i] == 0 { if qs[i] < 0 { return at; } continue; }
    r := qs[i] / ps[i];
    if ps[i] < 0 { if r > t1 { return at; } if r > t0 { t0 = r; } }
    else { if r < t0 { return at; } if r < t1 { t1 = r; } }
  }
  depth := clamp(1.55 - (p.z + q.z) * 0.5 / 20, 0.22, 1);
  return rule(out, at, p.x + dx * t0, p.y + dy * t0, p.x + dx * t1, p.y + dy * t1, k, light * depth);
}

inside :: (b: Box, x: f32, y: f32) -> bool { return x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

PLOT :: 3.2;   // the plot's half size, grid units
GRID :: 12;    // grid lines each way from the centre

// The Grid's floor, the plot, the tree, the queue's beacon and the agents.
scene :: (out: [] f32, at: int, b: Box, p: Pen, t: [] Tree, still: bool, waiting: int) -> int {
  angle := 0.62 + (ifx still then 0.0f32 else p.time * 0.045);
  // the readouts take the top of the box; the world stays under them
  view := Box.{x0 = b.x0, y0 = b.y0 + 44 * p.d, x1 = b.x1, y1 = b.y1};
  c := camera(view, angle);
  roomy := box_w(b) > 520 * p.d;
  v := at;
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE);
  grid := dim; grid.glow = 2.0 * p.d; grid.core = hi(0.45 * p.d, 0.7);
  // the floor, in one-unit pieces so each fades with its distance
  for i: -GRID..<GRID + 1 {
    for j: -GRID..<GRID {
      x := cast(f32) i; z := cast(f32) j;
      far := sqrt(x * x + z * z) / cast(f32) GRID;
      light := 0.42 * clamp(1.15 - far, 0, 1) * p.fade;
      onplot := abs(x) <= PLOT && abs(z + 0.5) <= PLOT;
      v = seg(out, v, c, v3(x, 0, z), v3(x, 0, z + 1), ifx onplot then accent else grid, ifx onplot then light * 0.9 else light);
      onplot2 := abs(z) <= PLOT && abs(x + 0.5) <= PLOT;
      v = seg(out, v, c, v3(z, 0, x), v3(z + 1, 0, x), ifx onplot2 then accent else grid, ifx onplot2 then light * 0.9 else light);
    }
  }
  // the plot's edge and its corner posts
  e: f32 = PLOT + 0.25;
  cx := [5] f32.[-e, e, e, -e, -e];
  cz := [5] f32.[-e, -e, e, e, -e];
  for k: 0..<4 {
    v = seg(out, v, c, v3(cx[k], 0.02, cz[k]), v3(cx[k + 1], 0.02, cz[k + 1]), accent, 0.85 * p.fade);
    v = seg(out, v, c, v3(cx[k], 0, cz[k]), v3(cx[k], 0.7, cz[k]), accent, 0.7 * p.fade);
  }
  // the tree grows in over the first seconds
  n := t[0].n;
  shown := ifx still then n else cast(int) (cast(f32) n * ease((p.time - 0.5) / 3.2));
  bark := white; bark.core = 1.3 * p.d; bark.glow = 5 * p.d;
  for i: 1..<shown { v = seg(out, v, c, v3(0, t[0].trunk[i - 1], 0), v3(0, t[0].trunk[i], 0), bark, 0.55 * p.fade); }
  if shown > 0 { v = seg(out, v, c, v3(0, 0, 0), v3(0, t[0].trunk[0], 0), bark, 0.55 * p.fade); }
  twig := white; twig.core = 0.65 * p.d;
  prev: [BRANCHES] int;
  for k: 0..<BRANCHES { prev[k] = -1; }
  for i: 0..<shown {
    br := t[0].branch[i];
    from := ifx prev[br] < 0 then v3(0, t[0].trunk[i], 0) else t[0].at[prev[br]];
    recent := i >= n - 6;
    v = seg(out, v, c, from, t[0].at[i], ifx recent then accent else twig, ifx recent then 0.8 * p.fade else 0.5 * p.fade);
    prev[br] = i;
  }
  // the nodes; the newest glow and pulse
  for i: 0..<shown {
    s := spot(c, t[0].at[i]);
    if !s.ok || !inside(view, s.x, s.y) { continue; }
    recent := i >= n - 6;
    r := (ifx recent then 3.2f32 else 2.2f32) * p.d;
    if recent {
      pulse := 0.6 + 0.4 * sin(p.time * 3.0 + cast(f32) i);
      v = diamond(out, v, s.x, s.y, r, accent, pulse * p.fade);
    } else {
      v = diamond(out, v, s.x, s.y, r, white, 0.6 * p.fade);
    }
    if i == n - 1 && i < shown {
      ring := 6 * p.d + 5 * p.d * fract(p.time * 0.7);
      v = diamond(out, v, s.x, s.y, ring, accent, 0.6 * (1 - fract(p.time * 0.7)) * p.fade);
      small := 6.5 * p.d;
      v = put(out, v, field(t[0].history, i, 0)[0..<7], s.x + 10 * p.d, s.y - 6 * p.d, small, accent);
      if roomy { v = put(out, v, "HEAD", s.x + 10 * p.d, s.y + 5 * p.d, small, dim); }
    }
  }
  // each branch's name at its newest commit
  if shown == n && roomy {
    for br: 0..<BRANCHES {
      last := t[0].last[br];
      if last < 0 { continue; }
      s := spot(c, t[0].at[last]);
      if !s.ok || !inside(view, s.x, s.y) { continue; }
      v = put(out, v, branch_label(t, br), s.x - text_width(branch_label(t, br), 6 * p.d) - 8 * p.d, s.y + 10 * p.d, 6 * p.d, dim);
    }
  }
  // the task queue's beacon at the plot's front corner
  beacon := v3(e, 0, e);
  top := v3(e, 2.4, e);
  v = seg(out, v, c, beacon, top, accent, 0.9 * p.fade);
  bs := spot(c, top);
  if bs.ok && inside(view, bs.x, bs.y) {
    beat := 0.55 + 0.45 * sin(p.time * 2.2);
    v = diamond(out, v, bs.x, bs.y, 5 * p.d, accent, beat * p.fade);
    v = diamond(out, v, bs.x, bs.y, 9 * p.d, accent, 0.35 * beat * p.fade);
    label := 6.5 * p.d;
    v = put(out, v, "TASK QUEUE", bs.x + 13 * p.d, bs.y - 2 * p.d, label, accent);
    buf: [24] u8;
    m := number(ifx p.demo then open_tasks() else waiting, false, buf[..]);
    v = put(out, v, cast(string) buf[0..<m], bs.x + 13 * p.d, bs.y + 9 * p.d, label, white);
    v = put(out, v, ifx p.demo then "OPEN" else "READY", bs.x + 13 * p.d + text_width(cast(string) buf[0..<m], label) + SPACE * label, bs.y + 9 * p.d, label, dim);
  }
  // the agents: out from the beacon to their branch, work there, come back
  // (samples: only the demo has them until claims are real)
  for a: 0..<(ifx p.demo then rows(AGENTS) else 0) {
    target := t[0].last[branch_of(t, field(AGENTS, a, 2))];
    if target < 0 || shown < n { continue; }
    node := add(t[0].at[target], v3(0.35 * cos(cast(f32) a * 2.1), 0.5 + 0.2 * cast(f32) a, 0.35 * sin(cast(f32) a * 2.1)));
    phase := fract((ifx still then 0.5f32 else p.time) * 0.055 + cast(f32) a * 0.31);
    there := ease(phase / 0.3) * (1 - ease((phase - 0.78) / 0.22));
    at3 := mix3(top, node, there);
    s := spot(c, at3);
    if !s.ok || !inside(view, s.x, s.y) { continue; }
    working := phase > 0.3 && phase < 0.78;
    if working {
      ns := spot(c, t[0].at[target]);
      if ns.ok {
        // work in flight: a pulse from the agent down to the commit it's on
        beam := accent; beam.mode = MODE_LINK; beam.core = 0.5 * p.d;
        v = rule(out, v, s.x, s.y, ns.x, ns.y, beam, 0.45 * p.fade);
        f := fract(p.time * 1.4 + cast(f32) a * 0.4);
        hx := s.x + (ns.x - s.x) * f; hy := s.y + (ns.y - s.y) * f;
        if lit(out, v, hx - (ns.x - s.x) * 0.08, hy - (ns.y - s.y) * 0.08, hx, hy, 1.2 * p.d, 0.9 * p.fade, 5 * p.d, 0.5, 0.82, 1.0, MODE_PULSE) { v += 6; }
      }
    }
    // the marker: a small chevron over a dot
    r := 5 * p.d;
    v = rule(out, v, s.x - r, s.y - r, s.x, s.y, pale, p.fade);
    v = rule(out, v, s.x, s.y, s.x + r, s.y - r, pale, p.fade);
    v = diamond(out, v, s.x, s.y + 3 * p.d, 1.6 * p.d, white, p.fade);
    // named once it has left the beacon, so it never covers the queue's label
    if there > 0.2 {
      label := 6 * p.d;
      v = put(out, v, field(AGENTS, a, 0), s.x + 9 * p.d, s.y - 9 * p.d, label, pale);
      if roomy { v = put(out, v, field(AGENTS, a, 1), s.x + 9 * p.d, s.y + 1 * p.d, label, dim); }
    }
  }
  return v;
}

// ---------------------------------------------------------------- the layout

#test "Coax's introduction fits a small phone and its book link navigates" {
  wk:[1]Work;s:[1]ProjectState;
  wk[0].slug="coax";wk[0].key=COAX_PROJECT_KEY;
  #assert project_intro(wk[..]);
  sizes:=[6]f32.[320,568,390,844,1440,900];
  for k:0..<3 {
    width:=sizes[k*2];height:=sizes[k*2+1];
    l:=project_layout(width,height,1,wk[..]);
    #assert fits_in(l.header,width,height) && fits_in(l.scene,width,height) && fits_in(l.queue,width,height) && fits_in(l.agents,width,height);
    #assert apart(l.header,l.scene) && apart(l.scene,l.queue) && apart(l.queue,l.agents);
    book:=coax_book_box(l.header,1);#assert inside(l.header,mid_x(book),mid_y(book)) && box_h(book)>=44;
    s[0].width=width;s[0].height=height;s[0].dpr=1;
    #assert click(s[..],wk[..],mid_x(book),mid_y(book));
    #assert same(cast(string)s[0].outbox[0..<s[0].out_n],COAX_BOOK_URL);
  }
  wk[0].key="other";#assert !project_intro(wk[..]);
}

Layout :: struct { wide: bool; columns: bool; header: Box; scene: Box; queue: Box; activity: Box; agents: Box; activity_on: bool; }

WIDE :: 1080.0;   // CSS pixels: three columns from here
TWO :: 700.0;     // CSS pixels: below this, one column

layout :: (width: f32, height: f32, d: f32) -> Layout {
  return layout_height(width,height,d,0);
}
project_layout :: (width:f32,height:f32,d:f32,w:[]Work)->Layout {
  return layout_height(width,height,d,ifx project_intro(w) then coax_head_height(width/d) else 0.0f32);
}
layout_height :: (width:f32,height:f32,d:f32,intro:f32)->Layout {
  w := width / d; h := height / d;
  m := ifx w < TWO then 12.0f32 else 24.0f32;
  g := ifx w < TWO then 8.0f32 else 16.0f32;
  l: Layout;
  l.wide = w >= WIDE;
  l.columns = w >= TWO;
  if l.wide {
    head := ifx intro>0 then intro else 112.0f32;
    l.header = Box.{x0 = m, y0 = m, x1 = w - m, y1 = m + head};
    top := m + head + g;
    left := 390.0f32; right := 360.0f32;
    l.queue = Box.{x0 = m, y0 = top, x1 = m + left, y1 = h - m};
    l.activity_on = true;
    split := top + (h - m - top) * 0.52;
    l.activity = Box.{x0 = w - m - right, y0 = top, x1 = w - m, y1 = split - g * 0.5};
    l.agents = Box.{x0 = w - m - right, y0 = split + g * 0.5, x1 = w - m, y1 = h - m};
    l.scene = Box.{x0 = m + left + g, y0 = top, x1 = w - m - right - g, y1 = h - m};
  } else {
    head := ifx intro>0 then intro else ifx l.columns then 112.0f32 else 146.0f32;
    l.header = Box.{x0 = m, y0 = m, x1 = w - m, y1 = m + head};
    top := m + head + g;
    rest := h - m - top;
    sh := clamp(rest * 0.4, ifx intro>0 then 80.0f32 else 150.0f32, 420);
    l.scene = Box.{x0 = m, y0 = top, x1 = w - m, y1 = top + sh};
    below := top + sh + g;
    l.activity_on = false;
    if l.columns {
      mid := w * 0.55;
      l.queue = Box.{x0 = m, y0 = below, x1 = mid - g * 0.5, y1 = h - m};
      l.agents = Box.{x0 = mid + g * 0.5, y0 = below, x1 = w - m, y1 = h - m};
    } else {
      agents_h := clamp((h - m - below) * 0.4, ifx intro>0 then 60.0f32 else 92.0f32, 150);
      l.queue = Box.{x0 = m, y0 = below, x1 = w - m, y1 = h - m - agents_h - g};
      l.agents = Box.{x0 = m, y0 = h - m - agents_h, x1 = w - m, y1 = h - m};
    }
  }
  l.header = scaled(l.header, d); l.scene = scaled(l.scene, d); l.queue = scaled(l.queue, d);
  l.activity = scaled(l.activity, d); l.agents = scaled(l.agents, d);
  return l;
}
scaled :: (b: Box, d: f32) -> Box { return Box.{x0 = b.x0 * d, y0 = b.y0 * d, x1 = b.x1 * d, y1 = b.y1 * d}; }

// The glass behind a panel, for project.wgsl.
glass :: (uniforms: [] f32, k: int, b: Box, cut: f32, alpha: f32, tint: f32) {
  if k >= PANELS { return; }
  o := 8 + k * 8;
  uniforms[o] = b.x0; uniforms[o + 1] = b.y0; uniforms[o + 2] = b.x1; uniforms[o + 3] = b.y1;
  uniforms[o + 4] = cut; uniforms[o + 5] = alpha; uniforms[o + 6] = tint; uniforms[o + 7] = 0;
}

// ---------------------------------------------------------------- the panels

header :: (out: [] f32, at: int, b: Box, p: Pen, wide: bool, w: [] Work) -> int {
  if !p.demo && project_intro(w) {return coax_header(out,at,b,p,w);}
  d := p.d; v := at;
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT);
  white.sans = false; dim.sans = false;   // the top bar is Filament
  x := b.x0 + 18 * d; right := b.x1 - 18 * d;
  // the project's name, line and home: from its 30621 event and its repository
  name := ifx p.demo then "COAX" else w[0].name;
  v = put(out, v, "OPENAGENTS / PROJECTS /", x, b.y0 + 22 * d, 7 * d, dim);
  crumb := x + text_width("OPENAGENTS / PROJECTS /", 7 * d) + SPACE * 7 * d;
  v = put(out, v, name, crumb, b.y0 + 22 * d, 7 * d, accent);
  if p.demo { v = put(out, v, "/ DEMO", crumb + text_width(name, 7 * d) + SPACE * 7 * d, b.y0 + 22 * d, 7 * d, ink(p, INK_PALE)); }
  // a project made from a drop: its first realm, at the right of the crumbs
  rb := realm_box(w, b, d);
  if rb.x1 > rb.x0 { v = put(out, v, realm_label(w, b, d), rb.x0, b.y0 + 22 * d, 7 * d, accent); }
  ab := add_box(w, b, d);
  if ab.x1 > ab.x0 { v = put(out, v, add_label(w, b, d), ab.x0, b.y0 + 22 * d, 7 * d, accent); }
  title := 26 * d;
  // a long name shrinks to fit a phone's width (PLANETARY VILLA)
  room := right - x;
  if text_width(name, title) > room && text_width(name, 1) > 0 { title = hi(14 * d, room / text_width(name, 1)); }
  ty := b.y0 + 58 * d;
  v = put(out, v, name, x, ty, title, white);
  tag := ifx p.demo then "A systems language for real-time code. Compiles to C11, then to native code and wasm." else w[0].description;
  chips_y := 0.0f32;
  if wide {
    tx := x + text_width(name, title) + 22 * d;
    v = put_fit(out, v, tag, tx, ty - 10 * d, 8 * d, white, right - tx - 330 * d);
    hb: [192] u8;
    hn := put_text(hb[..], 0, "HOME ");
    hn += put_text(hb[..], hn, w[0].repo); hn += put_text(hb[..], hn, "/"); hn += put_text(hb[..], hn, w[0].path);
    hn += put_text(hb[..], hn, "  ·  TASKS FROM NOSTR  ·  OWNER "); hn += put_text(hb[..], hn, ifx w[0].owner.count > 0 then w[0].owner else w[0].repo);
    line := ifx p.demo then "HOME OPENAGENTS/COAX/  ·  PLOT 12,-4 ON THE GRID  ·  OWNER OPENAGENTS" else cast(string) hb[0..<hn];
    v = put_fit(out, v, line, tx, ty + 6 * d, 6.5 * d, dim, right - tx);
    chips_y = ty - 8 * d;
  } else {
    lines: [1] int;
    v = put_wrapped(out, v, tag, x, ty + 22 * d, 7.5 * d, white, right - x, 13 * d, 3, lines[..]);
    chips_y = ty + 22 * d + 13 * d * cast(f32) lines[0] + 14 * d;
  }
  // the chips: open for contributions (pulsing), the licence, and the data's
  // source: SAMPLE DATA on the demo; on a real page the line to the relay
  cap := 7 * d;
  open := "OPEN FOR CONTRIBUTIONS";
  lic := ifx p.demo then "APACHE-2.0" else w[0].license;
  state := ifx w[0].live == LIVE_LIVE then "LIVE" else ifx w[0].live == LIVE_OFFLINE then "OFFLINE" else "CONNECTING";
  source := ifx p.demo then "DEMO · SAMPLE DATA" else state;
  third := chip_width(source, cap, p) + 8 * d;
  cx := ifx wide then right - chip_width(open, cap, p) - chip_width(lic, cap, p) - 8 * d else x;
  if wide { cx = cx - third; }
  v = chip(out, v, open, cx, chips_y, cap, accent, p);
  beat := 0.5 + 0.5 * sin(p.time * 2.4);
  v = diamond(out, v, cx - 8 * d, chips_y - cap * 0.5, 2 * d, accent, beat * p.fade);
  v = chip(out, v, lic, cx + chip_width(open, cap, p) + 8 * d, chips_y, cap, dim, p);
  sx := cx + chip_width(open, cap, p) + chip_width(lic, cap, p) + 16 * d;
  if !wide && sx + chip_width(source, cap, p) > right { sx = x; chips_y = chips_y + cap + 16 * d; }
  live := !p.demo && w[0].live == LIVE_LIVE;
  v = chip(out, v, source, sx, chips_y, cap, ifx p.demo then ink(p, INK_PALE) else ifx live then accent else dim, p);
  if live { v = diamond(out, v, sx + chip_width(source, cap, p) + 6 * d, chips_y - cap * 0.5, 2 * d, accent, beat * p.fade); }
  return frame(out, v, b, 10 * d, p);
}

// The readouts over the scene: commits, contributors, lines, open tasks, agents at work.
stats :: (out: [] f32, at: int, b: Box, p: Pen, w: [] Work, t: [] Tree) -> int {
  d := p.d; v := at;
  dim := ink(p, INK_DIM); white := ink(p, INK_WHITE); accent := ink(p, INK_LIT);
  dim.sans = false; white.sans = false;   // the stats are chrome: Filament
  labels := [5] string.["COMMITS", "CONTRIBUTORS", "LINES", "OPEN TASKS", "AGENTS AT WORK"];
  short := [5] string.["COMMITS", "PEOPLE", "LINES", "OPEN", "AGENTS"];
  k := ifx p.demo || w[0].baked < 0 then 0 else w[0].baked;
  values := [5] int.[baked(k).commits, baked(k).authors, baked(k).lines, open_tasks(), rows(AGENTS)];
  if !p.demo && w[0].baked < 0 { values[0] = t[0].n; values[1] = 0; values[2] = 0; }
  if !p.demo {
    // the real page counts the relay's tasks: ready to take, and still to do
    labels[3] = "READY"; short[3] = "READY"; values[3] = w[0].ready_n;
    labels[4] = "TASKS TO DO"; short[4] = "TO DO"; values[4] = w[0].queued;
  }
  each := (box_w(b) - 28 * d) / 5;
  cap := clamp(each / 6.5, 8 * d, 15 * d);
  small := clamp(each / 11, 5.5 * d, 7 * d);
  for i: 0..<5 {
    x := b.x0 + 16 * d + each * cast(f32) i;
    name := ifx text_width(labels[i], small) > each - 6 * d then short[i] else labels[i];
    v = put_fit(out, v, name, x, b.y0 + 18 * d, small, dim, each - 6 * d);
    v = put_number(out, v, values[i], i == 2, x, b.y0 + 22 * d + cap, cap, ifx i == 3 then accent else white);
    v = rule(out, v, x - 6 * d, b.y0 + 10 * d, x - 6 * d, b.y0 + 26 * d + cap, dim, 0.15 * p.fade);
  }
  return v;
}

// The scene's own HUD: corner brackets, a caption and a legend.
scene_hud :: (out: [] f32, at: int, b: Box, p: Pen, columns: bool, wk: [] Work) -> int {
  d := p.d; v := at;
  accent := ink(p, INK_LIT); dim := ink(p, INK_DIM); white := ink(p, INK_WHITE);
  arm := 16 * d;
  xs := [4] f32.[b.x0, b.x1, b.x0, b.x1];
  ys := [4] f32.[b.y0, b.y0, b.y1, b.y1];
  for k: 0..<4 {
    sx := ifx k % 2 == 0 then 1.0f32 else -1.0f32;
    sy := ifx k < 2 then 1.0f32 else -1.0f32;
    v = rule(out, v, xs[k], ys[k], xs[k] + sx * arm, ys[k], accent, 0.8 * p.fade);
    v = rule(out, v, xs[k], ys[k], xs[k], ys[k] + sy * arm, accent, 0.8 * p.fade);
  }
  small := 6 * d;
  pb: [96] u8;
  pn := put_text(pb[..], 0, "GRID · SECTOR 12,-4 · PLOT ");
  pn += put_text(pb[..], pn, ifx p.demo then "COAX" else wk[0].slug);
  v = put(out, v, cast(string) pb[0..<pn], b.x0 + 12 * d, b.y1 - 12 * d, small, dim);
  if columns {
    lx := b.x1 - 12 * d;
    v = put_right(out, v, "COMMIT   RECENT   AGENT", lx, b.y1 - 12 * d, small, dim);
    w := text_width("COMMIT   RECENT   AGENT", small);
    v = diamond(out, v, lx - w - 8 * d, b.y1 - 15 * d, 2.2 * d, white, 0.6 * p.fade);
    v = diamond(out, v, lx - w + text_width("COMMIT   ", small) - 7 * d, b.y1 - 15 * d, 2.6 * d, accent, p.fade);
    ax := lx - w + text_width("COMMIT   RECENT   ", small) - 8 * d;
    v = rule(out, v, ax - 3 * d, b.y1 - 18 * d, ax, b.y1 - 15 * d, ink(p, INK_PALE), p.fade);
    v = rule(out, v, ax, b.y1 - 15 * d, ax + 3 * d, b.y1 - 18 * d, ink(p, INK_PALE), p.fade);
  }
  return v;
}

state_ink :: (p: Pen, s: int) -> Ink {
  if s == STATE_OPEN { return ink(p, INK_LIT); }
  if s == STATE_REVIEW { return ink(p, INK_PALE); }
  if s == STATE_DONE { return ink(p, INK_FAINT); }
  return ink(p, INK_WHITE);
}

// The task queue: one row a task, open first as an agent pulls them. A tall
// panel wraps titles to two lines and shows the live claims' leases under
// the queue.
LEASES :: "CX-102|MICROCODER-3|4300\nCX-105|SOLVER-7|2600\nCX-103|CODER-1|6100\n";   // seconds left (placeholders)
LEASE :: 7200.0;   // a claim's lease, seconds (the spec's first policy: 2 hours)
queue :: (out: [] f32, at: int, b: Box, p: Pen) -> int {
  d := p.d;
  buf: [48] u8;
  o := number(open_tasks(), false, buf[..]);
  o += put_text(buf[..], o, " OPEN · ");
  o += number(claimed_tasks(), false, buf[o..<buf.count]);
  o += put_text(buf[..], o, " CLAIMED");
  v := titled(out, at, b, "TASK QUEUE", cast(string) buf[0..<o], p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 14 * d;
  cap := 7.5 * d; small := 6 * d;
  tall := box_h(b) > 560 * d && box_w(b) > 340 * d;
  leases := 34 * d + 30 * d * cast(f32) rows(LEASES);
  note := "Agents pull open tasks from the top. A claim is a lease: renew it while you work, release it when you stop.";
  note_room := ifx box_h(b) > 420 * d then 40 * d else 0.0f32;
  bottom := b.y1 - 12 * d - note_room;
  idw := text_width("CX-000", cap) + 10 * d;
  for pass: 0..<2 {
    // open tasks first, then the rest in order
    for r: 0..<rows(TASKS) {
      s := task_state(r);
      if (pass == 0) != (s == STATE_OPEN) { continue; }
      if y + 14 * d > bottom { break; }
      k := state_ink(p, s);
      state := field(TASKS, r, 1);
      sw := chip_width(state, small, p);
      done := s == STATE_DONE;
      v = put(out, v, field(TASKS, r, 0), x, y, cap, ifx done then dim else accent);
      v = chip(out, v, state, right - sw, y, small, k, p);
      title := field(TASKS, r, 2);
      lines := 1;
      if tall {
        drawn: [1] int;
        v = put_wrapped(out, v, title, x + idw, y, cap, ifx done then dim else white, right - sw - 10 * d - x - idw, 12 * d, 2, drawn[..]);
        lines = drawn[0];
      } else {
        v = put_fit(out, v, title, x + idw, y, cap, ifx done then dim else white, right - sw - 10 * d - x - idw);
      }
      meta := y + 12 * d * cast(f32) (lines - 1) + 13 * d;
      // labels and who has it
      m := 0;
      m += put_text(buf[..], m, field(TASKS, r, 3));
      v = put(out, v, cast(string) buf[0..<m], x + idw, meta, small, dim);
      who := field(TASKS, r, 5);
      if who.count > 0 { v = put_right(out, v, who, right, meta, small, ifx done then dim else pale); }
      v = rule(out, v, x, meta + 8 * d, right, meta + 8 * d, dim, 0.07 * p.fade);
      y = meta + 23 * d;
    }
  }
  // the leases go under the queue when there's room; they say what the note
  // says, so the note gives way to them when both don't fit
  show := y <= b.y1 - 12 * d - leases + 6 * d;
  if show && y > b.y1 - 12 * d - note_room - leases + 6 * d { note_room = 0; }
  if show {
    // the live claims: who holds what, and how much of the lease is left
    ly := b.y1 - 12 * d - note_room - leases + 14 * d;
    v = rule(out, v, x, ly - 4 * d, x + 6 * d, ly - 4 * d, accent, p.fade);
    v = put(out, v, "LEASES", x + 12 * d, ly, small, accent);
    v = put_right(out, v, "NIP-COORD CLAIMS · RENEW BEFORE ZERO", right, ly, 5.5 * d, dim);
    ly += 22 * d;
    for r: 0..<rows(LEASES) {
      left := clamp(cast(f32) parse(field(LEASES, r, 2)) - p.time * 30, 0, LEASE);   // time runs fast in the mockup
      v = put(out, v, field(LEASES, r, 0), x, ly, small, accent);
      v = put(out, v, field(LEASES, r, 1), x + idw, ly, small, pale);
      tl: [16] u8;
      mins := cast(int) (left / 60);
      n := number(mins / 60, false, tl[..]);
      n += put_text(tl[..], n, "H ");
      if mins % 60 < 10 { n += put_text(tl[..], n, "0"); }
      n += number(mins % 60, false, tl[n..<tl.count]);
      n += put_text(tl[..], n, "M");
      v = put_right(out, v, cast(string) tl[0..<n], right, ly, small, white);
      // the bar: a track and the lease left, as one thick stroke
      bx0 := x + idw; bx1 := right; by := ly + 9 * d;
      v = rule(out, v, bx0, by, bx1, by, dim, 0.12 * p.fade);
      fill := bx0 + (bx1 - bx0) * left / LEASE;
      bar := accent; bar.core = 1.4 * d; bar.glow = 4 * d;
      if fill > bx0 + 1 { v = rule(out, v, bx0, by, fill, by, bar, 0.75 * p.fade); }
      for q: 1..<8 {
        tx := bx0 + (bx1 - bx0) * cast(f32) q / 8;
        v = rule(out, v, tx, by - 3 * d, tx, by + 3 * d, dim, 0.18 * p.fade);
      }
      ly += 30 * d;
    }
  }
  if note_room > 0 {
    lines: [1] int;
    v = put_wrapped(out, v, note, x, b.y1 - note_room + 2 * d, 6 * d, dim, right - x, 11 * d, 3, lines[..]);
  }
  return frame(out, v, b, 10 * d, p);
}

// Bytes of text into buf at at; returns how many fit.
put_text :: (buf: [] u8, at: int, text: string) -> int {
  n := 0;
  while n < text.count && at + n < buf.count { buf[at + n] = text[n]; n += 1; }
  return n;
}
parse :: (text: string) -> int {
  n := 0;
  for i: 0..<text.count { if text[i] >= '0' && text[i] <= '9' { n = n * 10 + cast(int) (text[i] - '0'); } }
  return n;
}

// Activity: the agents' latest moves (placeholders), then real commits.
MOVES :: "NOW|SOLVER-7 renewed its claim on CX-105\n2M|MICROCODER-3 claimed CX-102\n9M|CODER-1 opened a review for CX-103\n";
activity :: (out: [] f32, at: int, b: Box, p: Pen) -> int {
  d := p.d;
  v := titled(out, at, b, "ACTIVITY", "COMMITS ARE REAL · CLAIMS ARE SAMPLES", p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 12 * d;
  cap := 6.5 * d; step := 25 * d;
  bottom := b.y1 - 10 * d;
  lead := 48 * d;
  for r: 0..<rows(MOVES) {
    if y > bottom { break; }
    v = put(out, v, field(MOVES, r, 0), x, y, cap, accent);
    v = put_fit(out, v, field(MOVES, r, 1), x + lead, y, cap, pale, right - x - lead);
    y += step;
  }
  n := COAX_COMMITS;
  for k: 0..<n {
    if y + 9 * d > bottom { break; }
    i := n - 1 - k;
    date := field(COAX_HISTORY, i, 1);
    v = put(out, v, date[5..<date.count], x, y, cap, dim);
    v = put(out, v, field(COAX_HISTORY, i, 0)[0..<7], x + lead, y, cap, accent);
    hx := x + lead + text_width("0000000", cap) + 8 * d;
    v = put_fit(out, v, field(COAX_HISTORY, i, 4), hx, y, cap, white, right - hx);
    v = put_fit(out, v, branch_name(branch_index(field(COAX_HISTORY, i, 2))), hx, y + 10 * d, 5.5 * d, dim, right - hx);
    y += step;
  }
  return frame(out, v, b, 10 * d, p);
}

// For agents: how to read the project and pull work from it.
AGENT_STEPS :: "READ|/projects/coax/index.md\nSHOW|openagents project show coax\nLIST|openagents tasks --project coax\nCLAIM|openagents task claim CX-101\nSUBMIT|openagents task submit CX-101\nAPI|GET /v1/projects/coax/tasks?state=open\n|POST /v1/projects/coax/tasks/CX-101/claim\n";
POLICY :: "WHO|any registered agent key\nLOAD|one task at a time\nLEASE|2 hours, renewable\nWHERE|a branch per task\nGATE|a maintainer reviews the pull request\n";
agents :: (out: [] f32, at: int, b: Box, p: Pen, compact: bool) -> int {
  d := p.d;
  v := titled(out, at, b, "FOR AGENTS", ifx compact then "" else "HOW TO CONTRIBUTE", p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 12 * d;
  cap := 6.5 * d; step := ifx compact then 13 * d else 17 * d;
  lead := 52 * d;
  if !compact {
    lines: [1] int;
    v = put_wrapped(out, v, "This project takes work from people and agents. Pull an open task, claim it, push a commit that meets its acceptance, and a maintainer reviews it.", x, y, 6.5 * d, dim, right - x, 12 * d, 4, lines[..]);
    y += 12 * d * cast(f32) lines[0] + 10 * d;
  }
  for r: 0..<rows(AGENT_STEPS) {
    if y > b.y1 - 10 * d { break; }
    v = put(out, v, field(AGENT_STEPS, r, 0), x, y, cap, accent);
    v = put_fit(out, v, field(AGENT_STEPS, r, 1), x + lead, y, cap, white, right - x - lead);
    y += step;
  }
  if !compact && y + 20 * d < b.y1 - 10 * d {
    lines: [1] int;
    v = put_wrapped(out, v, "Tasks are NIP-WORK items; claims are NIP-COORD leases; the project is a NIP-MP group over NIP-34 repositories.", x, y + 8 * d, 6 * d, dim, right - x, 11 * d, 3, lines[..]);
    y += 8 * d + 11 * d * cast(f32) lines[0] + 16 * d;
  }
  if !compact && y + 90 * d < b.y1 - 10 * d {
    // the contribution policy (the spec's first one)
    v = rule(out, v, x, y - 4 * d, x + 6 * d, y - 4 * d, accent, p.fade);
    v = put(out, v, "POLICY", x + 12 * d, y, 6 * d, accent);
    y += 18 * d;
    for r: 0..<rows(POLICY) {
      if y > b.y1 - 12 * d { break; }
      v = put(out, v, field(POLICY, r, 0), x, y, cap, dim);
      v = put_fit(out, v, field(POLICY, r, 1), x + lead, y, cap, white, right - x - lead);
      y += 15 * d;
    }
  }
  return frame(out, v, b, 10 * d, p);
}

// ---------------------------------------------------------------- the real page's panels

// The queue from the relay: the tasks in progress first, with the worker on
// each; the latest finished, with the commit that did it; then the ready
// tasks by rank and the ones still waiting, by rank. Each row: its alias
// (from its event id, never a number that order could change), its title,
// its state, and under it who is on it, the commit, or the milestone and
// size, or what it waits on.
SEC_WORKING :: 0; SEC_DONE :: 1; SEC_READY :: 2; SEC_WAITING :: 3;

// What the queue shows, in order: in progress, just finished, ready,
// waiting. Fills order (rows) and sect (SEC_*); returns how many.
queue_order :: (w: [] Work, order: [] int, sect: [] int) -> int {
  count := 0; cap := lo_int(order.count, sect.count);
  for k: 0..<w[0].queued {
    if k == w[0].working_n {
      for j: 0..<w[0].recent_n { if count < cap { order[count] = w[0].recent[j]; sect[count] = SEC_DONE; count += 1; } }
    }
    if count >= cap { break; }
    order[count] = w[0].queue[k];
    sect[count] = ifx k < w[0].working_n then SEC_WORKING else ifx k < w[0].working_n + w[0].ready_n then SEC_READY else SEC_WAITING;
    count += 1;
  }
  if w[0].queued == w[0].working_n {
    for j: 0..<w[0].recent_n { if count < cap { order[count] = w[0].recent[j]; sect[count] = SEC_DONE; count += 1; } }
  }
  return count;
}
lo_int :: (a: int, b: int) -> int { if a < b { return a; } return b; }

// A row's outline, its plain corners cut at 45° (as the panels' are), and
// a bright bar down its left: the row under the pointer, the keys' or the
// open one.
lit_row :: (out: [] f32, at: int, b: Box, light: f32, p: Pen) -> int {
  k := ink(p, INK_LIT); c := 6 * p.d; v := at;
  xs := [7] f32.[b.x0, b.x1 - c, b.x1, b.x1, b.x0 + c, b.x0, b.x0];
  ys := [7] f32.[b.y0, b.y0, b.y0 + c, b.y1, b.y1, b.y1 - c, b.y0];
  for i: 0..<6 { v = rule(out, v, xs[i], ys[i], xs[i + 1], ys[i + 1], k, 0.4 * light * p.fade); }
  bar := k; bar.core = 1.2 * p.d;
  return rule(out, v, b.x0 + 2 * p.d, b.y0 + c, b.x0 + 2 * p.d, b.y1 - 4 * p.d, bar, light * p.fade);
}
real_queue :: (out: [] f32, at: int, b: Box, p: Pen, w: [] Work) -> int {
  d := p.d;
  text := w[0].text;
  buf: [96] u8;
  o := 0;
  if w[0].working_n > 0 { o += number(w[0].working_n, false, buf[o..<buf.count]); o += put_text(buf[..], o, " AT WORK · "); }
  o += number(w[0].ready_n, false, buf[o..<buf.count]);
  o += put_text(buf[..], o, " READY · ");
  o += number(w[0].queued - w[0].ready_n - w[0].working_n, false, buf[o..<buf.count]);
  o += put_text(buf[..], o, " WAITING");
  if w[0].done_n > 0 { o += put_text(buf[..], o, " · "); o += number(w[0].done_n, false, buf[o..<buf.count]); o += put_text(buf[..], o, " DONE"); }
  v := titled(out, at, b, "TASK QUEUE", cast(string) buf[0..<o], p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 14 * d;
  cap := 7.5 * d; small := 6 * d;
  if w[0].n == 0 {
    v = put(out, v, "NO TASKS PUBLISHED YET", x, y + 6 * d, cap, white);
    lines: [1] int;
    v = put_wrapped(out, v, "The queue fills from the project's events on the relay.", x, y + 24 * d, small, dim, right - x, 11 * d, 3, lines[..]);
    return frame(out, v, b, 10 * d, p);
  }
  order: [MAX_ITEMS] int; sect: [MAX_ITEMS] int;
  count := queue_order(w, order[..], sect[..]);
  w[0].view.hit_n = 0;
  tall := box_h(b) > 560 * d && box_w(b) > 340 * d;
  bottom := b.y1 - 30 * d;
  idw := text_width("#0000", cap) + 10 * d;
  shown := 0;
  for k: 0..<count {
    r := order[k]; sc := sect[k];
    if k > 0 && sc != sect[k - 1] && (sc == SEC_DONE || sc == SEC_WAITING) {
      // a group starts here
      if y + 26 * d > bottom { break; }
      v = rule(out, v, x, y - 6 * d, x + 6 * d, y - 6 * d, dim, p.fade);
      v = put(out, v, ifx sc == SEC_DONE then "JUST FINISHED" else "WAITING ON OTHER TASKS", x + 12 * d, y - 2 * d, small, dim);
      y += 16 * d;
    }
    if y + 14 * d > bottom { break; }
    state := ifx sc == SEC_WORKING then "IN PROGRESS" else ifx sc == SEC_DONE then "DONE" else ifx sc == SEC_READY then "READY"
             else ifx w[0].status[r] == WS_DRAFT then "DRAFT" else "WAITING";
    hue := ifx sc == SEC_WORKING then white else ifx sc == SEC_READY then accent else dim;
    sw := chip_width(state, small, p);
    am := put_text(buf[..], 0, "#");
    am += put_text(buf[..], am, item(w, text, r, 0));
    v = put(out, v, cast(string) buf[0..<am], x, y, cap, ifx sc == SEC_WAITING || sc == SEC_DONE then dim else accent);
    if sc == SEC_WORKING {
      // in progress: the chip beats, someone is on it now
      beat := 0.55 + 0.45 * sin(p.time * 2.4);
      v = diamond(out, v, right - sw - 7 * d, y - small * 0.5, 2 * d, accent, beat * p.fade);
    }
    v = chip(out, v, state, right - sw, y, small, hue, p);
    title := item(w, text, r, 3);
    tint := ifx sc == SEC_WORKING || sc == SEC_READY then white else dim;
    room := right - sw - 14 * d - x - idw;
    lines := 1;
    if tall {
      drawn: [1] int;
      v = put_wrapped(out, v, title, x + idw, y, cap, tint, room, 12 * d, 2, drawn[..]);
      lines = drawn[0];
    } else {
      v = put_fit(out, v, title, x + idw, y, cap, tint, room);
    }
    meta := y + 12 * d * cast(f32) (lines - 1) + 13 * d;
    m := 0;
    ms := w[0].parent[r];
    if sc == SEC_WORKING {
      alias := item(w, text, r, 0);
      m += put_text(buf[..], m, "ON IT: ");
      m += put_text(buf[..], m, item(w, text, r, 6));
      info := keyed(w[0].plan_info, alias, 0);
      if info >= 0 {
        since := field(w[0].plan_info, info, 4);
        if since.count > 0 { m += put_text(buf[..], m, " SINCE "); m += put_text(buf[..], m, since); }
        steps := field(w[0].plan_info, info, 2);
        if parse(steps) > 0 {
          m += put_text(buf[..], m, "  ·  PLAN ");
          m += put_text(buf[..], m, field(w[0].plan_info, info, 1));
          m += put_text(buf[..], m, "/");
          m += put_text(buf[..], m, steps);
          updated := field(w[0].plan_info, info, 3);
          if updated.count > 0 { m += put_text(buf[..], m, " AT "); m += put_text(buf[..], m, updated); }
        }
      }
      v = put_fit(out, v, cast(string) buf[0..<m], x + idw, meta, small, pale, right - x - idw);
      // the plan: every step on a tall panel, the ones around the current step otherwise
      pd := plan_steps(out, v, w, alias, x + idw, meta + 13 * d, right, bottom - 4 * d, ifx tall then 10 else 4, p);
      v = pd.v; meta = pd.y;
    } else if sc == SEC_DONE {
      hash := item(w, text, r, 11);
      m += put_text(buf[..], m, ifx hash.count > 0 then "DONE IN " else "RESOLVED");
      m += put_text(buf[..], m, hash);
      if ms >= 0 { m += put_text(buf[..], m, "  ·  "); m += put_text(buf[..], m, item(w, text, ms, 3)); }
      v = put_fit(out, v, cast(string) buf[0..<m], x + idw, meta, small, dim, right - x - idw);
    } else if sc == SEC_READY || (w[0].waits[r] < 0 && w[0].far[r] < 0) {
      if ms >= 0 { m += put_text(buf[..], m, item(w, text, ms, 3)); m += put_text(buf[..], m, "  ·  "); }
      size := item(w, text, r, 5);
      if size.count > 0 { m += put_text(buf[..], m, "SIZE "); m += put_text(buf[..], m, size); }
      v = put_fit(out, v, cast(string) buf[0..<m], x + idw, meta, small, dim, right - x - idw - 70 * d);
    } else if w[0].waits[r] < 0 {
      // it waits on another project's issue
      fl := w[0].far[r]; lt := w[0].links;
      m += put_text(buf[..], m, "WAITS ON ");
      m += put_project(buf[..], m, cell(lt, fl, 2));
      m += put_text(buf[..], m, " #");
      m += put_text(buf[..], m, cell(lt, fl, 3));
      m += put_text(buf[..], m, " ");
      m += put_text(buf[..], m, cell(lt, fl, 5));
      v = put_fit(out, v, cast(string) buf[0..<m], x + idw, meta, small, dim, right - x - idw);
    } else {
      m += put_text(buf[..], m, "WAITS ON #");
      m += put_text(buf[..], m, item(w, text, w[0].waits[r], 0));
      m += put_text(buf[..], m, " ");
      m += put_text(buf[..], m, item(w, text, w[0].waits[r], 3));
      v = put_fit(out, v, cast(string) buf[0..<m], x + idw, meta, small, dim, right - x - idw);
    }
    if sc != SEC_DONE && w[0].ahead[r] >= 0 {
      // moved above what it waits on: allowed, and said
      meta += 11 * d;
      wm := put_text(buf[..], 0, "! RANKED ABOVE ITS BLOCKER #");
      wm += put_text(buf[..], wm, item(w, text, w[0].ahead[r], 0));
      v = put(out, v, cast(string) buf[0..<wm], x + idw, meta, small, pale);
    }
    v = rule(out, v, x, meta + 8 * d, right, meta + 8 * d, dim, 0.07 * p.fade);
    // the row, for the pointer; lit when it's under a mouse, the keys' or open
    row := Box.{x0 = b.x0 + 6 * d, y0 = y - cap - 7 * d, x1 = b.x1 - 6 * d, y1 = meta + 8 * d};
    vw := w[0].view;
    if vw.hit_n < MAX_HITS { w[0].view.hit_box[vw.hit_n] = row; w[0].view.hit_row[vw.hit_n] = r; w[0].view.hit_n = vw.hit_n + 1; }
    if vw.open == r + 1 { v = lit_row(out, v, row, 1.0, p); }
    else if vw.pick == r + 1 || (vw.hover && inside(row, vw.px, vw.py)) { v = lit_row(out, v, row, 0.6, p); }
    y = meta + 23 * d;
    shown += 1;
  }
  more := count - shown;
  mb: [64] u8;
  mm := 0;
  if more > 0 { mm = number(more, false, mb[..]); mm += put_text(mb[..], mm, " MORE · "); }
  mm += put_text(mb[..], mm, "EVERY TASK: /PROJECTS/");
  mm += put_text(mb[..], mm, w[0].slug);
  mm += put_text(mb[..], mm, "/INDEX.MD");
  v = put_fit(out, v, cast(string) mb[0..<mm], x, b.y1 - 14 * d, small, dim, right - x);
  return frame(out, v, b, 10 * d, p);
}

// The activity from the relay, newest first: claims, releases, notes and
// finished tasks, each with its time in Chicago. The newest is brightest.
activity_rows :: (out: [] f32, at: int, x: f32, y0: f32, right: f32, bottom: f32, p: Pen, w: [] Work) -> int {
  rows_of := w[0].log;
  d := p.d; v := at;
  dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE); white := ink(p, INK_WHITE);
  small := 5.5 * d;
  y := y0;
  v = rule(out, v, x, y - 4 * d, x + 6 * d, y - 4 * d, accent, p.fade);
  v = put(out, v, "ACTIVITY", x + 12 * d, y, small, accent);
  v = put_right(out, v, "CHICAGO TIME", right, y, small, dim);
  y += 15 * d;
  if rows(rows_of) == 0 {
    v = put(out, v, "NO CLAIMS OR NOTES YET", x, y, small, dim);
    return v;
  }
  ri := 0; r := 0;
  while ri < rows_of.count {
    if y > bottom { break; }
    v = put(out, v, cell(rows_of, ri, 0), x, y, small, dim);
    v = put_fit(out, v, cell(rows_of, ri, 1), x + 64 * d, y, small, ifx r == 0 then white else pale, right - x - 64 * d);
    y += 12 * d; ri = next_row(rows_of, ri); r += 1;
  }
  return v;
}

// The plan: the initiative and its milestones in order, each with its tasks
// done and ready; then the workers' activity from the relay.
plan :: (out: [] f32, at: int, b: Box, p: Pen, w: [] Work) -> int {
  d := p.d;
  text := w[0].text;
  v := titled(out, at, b, "MILESTONES", "FROM NOSTR", p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 12 * d;
  cap := 6.5 * d; small := 5.5 * d;
  if w[0].milestone_n == 0 { v = put(out, v, "NO MILESTONES YET", x, y, cap, dim); }
  // the activity keeps room for a few rows under the milestones
  keep := ifx box_h(b) > 260 * d then 76 * d else 0.0f32;
  // each initiative in rank order, its milestones under it; milestones with
  // no initiative come last
  for g: 0..<(w[0].initiative_n + 1) {
    root := ifx g < w[0].initiative_n then w[0].initiatives[g] else -1;
    if root >= 0 {
      if y + 30 * d > b.y1 - 10 * d - keep { break; }
      if g > 0 { y += 4 * d; }
      v = rule(out, v, x, y - 4 * d, x + 6 * d, y - 4 * d, ifx g == 0 then accent else pale, p.fade);
      v = put_fit(out, v, item(w, text, root, 3), x + 12 * d, y, 6.5 * d, ifx g == 0 then white else pale, right - x - 12 * d);
      y += 15 * d;
    }
    for k: 0..<w[0].milestone_n {
      m := w[0].milestones[k];
      pm := w[0].parent[m];
      loose := pm < 0 || w[0].kind[pm] != KIND_INITIATIVE;
      if (root >= 0 && pm != root) || (root < 0 && !loose) { continue; }
      if y + 16 * d > b.y1 - 10 * d - keep { break; }
      pr := progress(w, m);
      v = put_fit(out, v, item(w, text, m, 3), x, y, cap, ifx pr.ready > 0 then white else dim, right - x - 96 * d);
      buf: [32] u8;
      n := number(pr.done, false, buf[..]);
      n += put_text(buf[..], n, "/");
      n += number(pr.total, false, buf[n..<buf.count]);
      v = put_right(out, v, cast(string) buf[0..<n], right, y, cap, dim);
      if pr.ready > 0 {
        rb: [16] u8;
        rn := number(pr.ready, false, rb[..]);
        rn += put_text(rb[..], rn, " READY");
        v = put_right(out, v, cast(string) rb[0..<rn], right - 34 * d, y, small, accent);
      }
      // the bar: done of total
      by := y + 6 * d; bx1 := right;
      v = rule(out, v, x, by, bx1, by, dim, 0.1 * p.fade);
      if pr.total > 0 && pr.done > 0 {
        bar := accent; bar.core = 1.1 * d; bar.glow = 3 * d;
        v = rule(out, v, x, by, x + (bx1 - x) * cast(f32) pr.done / cast(f32) pr.total, by, bar, 0.75 * p.fade);
      }
      y += 15 * d;
    }
  }
  // what workers did, if there's room
  if y + 30 * d < b.y1 - 10 * d { v = activity_rows(out, v, x, y + 8 * d, right, b.y1 - 12 * d, p, w); }
  return frame(out, v, b, 10 * d, p);
}

// For agents, on the real page: where the project's events are and how to
// take a task today. Without the plan panel (narrower screens) the activity
// goes here, under the steps, when there's room.
real_agents :: (out: [] f32, at: int, b: Box, p: Pen, compact: bool, with_activity: bool, w: [] Work) -> int {
  d := p.d;
  v := titled(out, at, b, "FOR AGENTS", ifx compact then "" else "HOW TO CONTRIBUTE", p);
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT);
  x := b.x0 + 16 * d; right := b.x1 - 14 * d;
  y := b.y0 + title_room(p) + 12 * d;
  cap := 6.5 * d; step := ifx compact then 13 * d else 17 * d;
  lead := 52 * d;
  if !compact {
    lines: [1] int;
    v = put_wrapped(out, v, "Take the top ready task nobody is on: its issue says what to build, the checks that must pass and the files it writes. Claim it with a comment on the issue, note as you go, and finish it with the commit that passes its checks.", x, y, 6.5 * d, dim, right - x, 12 * d, 4, lines[..]);
    y += 12 * d * cast(f32) lines[0] + 10 * d;
  }
  for r: 0..<rows(w[0].steps) {
    if y > b.y1 - 10 * d { break; }
    v = put(out, v, field(w[0].steps, r, 0), x, y, cap, accent);
    v = put_fit(out, v, field(w[0].steps, r, 1), x + lead, y, cap, white, right - x - lead);
    y += step;
  }
  if !compact && y + 24 * d < b.y1 - 10 * d {
    v = put(out, v, "PROJECT", x, y, cap, dim);
    v = put_fit(out, v, project_naddr(w), x + lead, y, 5.5 * d, dim, right - x - lead);
    y += step;
  }
  if !compact && w[0].npub_n > 0 && y + 24 * d < b.y1 - 10 * d {
    v = put(out, v, "KEY", x, y, cap, dim);
    v = put_fit(out, v, cast(string) w[0].npub_buf[0..<w[0].npub_n], x + lead, y, 5.5 * d, dim, right - x - lead);
    y += step;
  }
  if with_activity && y + 50 * d < b.y1 - 10 * d { v = activity_rows(out, v, x, y + 10 * d, right, b.y1 - 12 * d, p, w); }
  return frame(out, v, b, 10 * d, p);
}

// ---------------------------------------------------------------- a task's detail

// A WORK_DETAILS field decoded into buf, as coax/web/project/details.ts
// escapes it: "\\" a backslash, "\n" a newline, "\p" a '|', "\." the next
// item of a list (ITEM_BREAK) and "\:" the next part of an item
// (PART_BREAK). Returns the bytes written; what doesn't fit is dropped.
ITEM_BREAK :: 30; PART_BREAK :: 31;
undetail :: (src: string, buf: [] u8) -> int {
  n := 0; i := 0;
  while i < src.count && n < buf.count {
    c := src[i]; i += 1;
    if c == '\\' && i < src.count {
      e := src[i]; i += 1;
      if e == 'n' { c = '\n'; }
      else if e == 'p' { c = '|'; }
      else if e == '.' { c = cast(u8) ITEM_BREAK; }
      else if e == ':' { c = cast(u8) PART_BREAK; }
      else { c = e; }
    }
    buf[n] = c; n += 1;
  }
  return n;
}
// The pieces of decoded text between sep bytes: how many (0 for none), and the k-th.
pieces :: (text: string, sep: int) -> int {
  if text.count == 0 { return 0; }
  n := 1;
  for i: 0..<text.count { if cast(int) text[i] == sep { n += 1; } }
  return n;
}
piece :: (text: string, sep: int, k: int) -> string {
  i := 0; c := 0;
  while c < k && i < text.count { if cast(int) text[i] == sep { c += 1; } i += 1; }
  j := i;
  while j < text.count && cast(int) text[j] != sep { j += 1; }
  return text[i..<j];
}

// The first byte of the row keyed by alias (column 0) in a table, or -1: one
// pass over the table, as WORK_DETAILS is long.
keyed_start :: (table: string, alias: string) -> int {
  i := 0;
  while i < table.count {
    j := i;
    while j < table.count && table[j] != '|' && table[j] != '\n' { j += 1; }
    if same(table[i..<j], alias) { return i; }
    while j < table.count && table[j] != '\n' { j += 1; }
    i = j + 1;
  }
  return -1;
}

ACT_HASH :: 3;   // host.js: the location's hash becomes the outbox's text
tell :: (s: [] ProjectState, text: string) {
  s[0].action = ACT_HASH;
  s[0].out_n = put_text(s[0].outbox[..], 0, text[0..<lo_int(text.count, 16)]);
}

// Where each row's line in WORK_DETAILS starts, in one pass: the details are
// written in the items' order, so a row's line is usually its own index;
// an alias out of place is looked for among the rows.
index_details :: (w: [] Work) {
  for r: 0..<w[0].n { w[0].dstart[r] = -1; }
  dt := w[0].details; i := 0; k := 0;
  while i < dt.count {
    alias := cell(dt, i, 0);
    r := -1;
    if k < w[0].n && same(item(w, w[0].text, k, 0), alias) { r = k; }
    else { for j: 0..<w[0].n { if r < 0 && same(item(w, w[0].text, j, 0), alias) { r = j; } } }
    if r >= 0 && w[0].dstart[r] < 0 { w[0].dstart[r] = i; }
    i = next_row(dt, i); k += 1;
  }
  w[0].dlines = k;
}
// The baked snapshot's event ids (each details line's second field) as the
// live line's known roots (live_seed_known), found through index_details
// rather than by reading every line to its end.
seed_known :: (lv: [] Live, w: [] Work) -> bool {
  dt := w[0].details;
  if w[0].dlines != w[0].n { return live_seed_known(lv, dt); }
  for r: 0..<w[0].n {
    i := w[0].dstart[r];
    if i < 0 { return false; }
    while i < dt.count && dt[i] != '|' && dt[i] != '\n' { i += 1; }
    if i + 65 >= dt.count || dt[i] != '|' || dt[i + 65] != '|' { return false; }
    if !live_known_add(lv, dt[i + 1..<i + 65]) { return false; }
  }
  return true;
}
// Row r's line in WORK_DETAILS, or -1.
detail_of :: (w: [] Work, r: int) -> int { if r < 0 || r >= w[0].n { return -1; } return w[0].dstart[r]; }

// Opens row r's detail: its text decoded once, the panel at its top, and the
// location's hash naming it.
open_task :: (s: [] ProjectState, w: [] Work, r: int) {
  if r < 0 || r >= w[0].n { return; }
  s[0].open = r + 1; s[0].pick = r + 1; s[0].scroll = 0; s[0].scroll_max = 0; s[0].link_n = 0;
  s[0].body_n = 0; s[0].checks_n = 0; s[0].notes_n = 0; s[0].event_n = 0; s[0].nevent_n = 0; s[0].nevent_for = 0; s[0].claimed_n = 0;
  alias := item(w, w[0].text, r, 0);
  dt := w[0].details;
  k := detail_of(w, r);
  if k >= 0 {
    event := cell(dt, k, 1); claimed := cell(dt, k, 2);
    s[0].event_n = put_text(s[0].event[..], 0, event[0..<lo_int(event.count, 64)]);
    s[0].claimed_n = put_text(s[0].claimed[..], 0, claimed[0..<lo_int(claimed.count, 24)]);
    s[0].body_n = undetail(cell(dt, k, 3), s[0].body[..]);
    s[0].checks_n = undetail(cell(dt, k, 4), s[0].checks[..]);
    s[0].notes_n = undetail(cell(dt, k, 5), s[0].notes[..]);
  }
  tell(s, alias);
}
close_task :: (s: [] ProjectState) {
  s[0].open = 0; s[0].link_n = 0; s[0].scroll = 0;
  tell(s, "");
}

// What a row is now, as its chip says, and the chip's ink.
state_label :: (w: [] Work, r: int) -> string {
  if w[0].kind[r] == KIND_MILESTONE { return "MILESTONE"; }
  if w[0].kind[r] == KIND_INITIATIVE { return "INITIATIVE"; }
  if w[0].status[r] == WS_RESOLVED { return "DONE"; }
  if w[0].status[r] == WS_CLOSED { return "CLOSED"; }
  if w[0].claimed[r] { return "IN PROGRESS"; }
  if w[0].ready[r] { return "READY"; }
  if w[0].status[r] == WS_DRAFT { return "DRAFT"; }
  return "WAITING";
}
state_hue :: (w: [] Work, r: int, p: Pen) -> Ink {
  if w[0].kind[r] == KIND_TASK && w[0].claimed[r] { return ink(p, INK_WHITE); }
  if w[0].ready[r] { return ink(p, INK_LIT); }
  return ink(p, INK_DIM);
}

// Whether row r waits on row k: k's alias is in r's blocked-by.
waits_on :: (w: [] Work, r: int, k: int) -> bool {
  blockers := item(w, w[0].text, r, 8); alias := item(w, w[0].text, k, 0);
  a := 0;
  while a < blockers.count {
    b := a;
    while b < blockers.count && blockers[b] != ' ' { b += 1; }
    if same(blockers[a..<b], alias) { return true; }
    a = b + 1;
  }
  return false;
}

// Where the detail goes: over the scene's column on a wide screen, the
// whole screen (inside a margin) otherwise.
detail_box :: (l: Layout, width: f32, height: f32, d: f32) -> Box {
  if l.wide { return l.scene; }
  m := (ifx width / d < TWO then 6.0f32 else 14.0f32) * d;
  return Box.{x0 = m, y0 = m, x1 = width - m, y1 = height - m};
}

// Text in the detail's scrolled body: wrapped to width, every line counted,
// only the lines between top and bottom drawn. y is the first baseline;
// the result's y the one after the last line.
Flow :: struct { v: int; y: f32; }
in_view :: (y: f32, cap: f32, top: f32, bottom: f32) -> bool { return y - cap >= top && y <= bottom; }
flow :: (out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, k: Ink, width: f32, step: f32,
         top: f32, bottom: f32) -> Flow {
  v := at; from := 0; yy := y;
  next: [1] int;
  while from < text.count {
    end := wrap_ink(text, from, width, cap, GAP, SPACE, k, next[..]);
    if in_view(yy, cap, top, bottom) { v = put(out, v, text[from..<end], x, yy, cap, k); }
    yy += step;
    if next[0] <= from { break; }
    from = next[0];
  }
  return Flow.{v = v, y = yy};
}

// A section's name in the detail: a lit tick, the name and a faint rule.
section :: (out: [] f32, at: int, name: string, x: f32, y: f32, right: f32, top: f32, bottom: f32, p: Pen) -> int {
  if !in_view(y, 6 * p.d, top, bottom) { return at; }
  o := ink(p, INK_LIT);
  v := rule(out, at, x, y - 3 * p.d, x + 6 * p.d, y - 3 * p.d, o, p.fade);
  v = put(out, v, name, x + 12 * p.d, y, 6 * p.d, o);
  sx := x + 18 * p.d + text_width(name, 6 * p.d);
  if sx < right { v = rule(out, v, sx, y - 3 * p.d, right, y - 3 * p.d, ink(p, INK_DIM), 0.1 * p.fade); }
  return v;
}

// One task related to the open one: its alias (a link to its own detail),
// title and state, on a line.
related :: (out: [] f32, at: int, s: [] ProjectState, w: [] Work, k: int, x: f32, y: f32, right: f32,
            top: f32, bottom: f32, p: Pen) -> int {
  d := p.d; cap := 7 * d; v := at;
  if !in_view(y, cap, top, bottom) { return v; }
  buf: [24] u8;
  n := put_text(buf[..], 0, "#");
  n += put_text(buf[..], n, item(w, w[0].text, k, 0));
  tag := cast(string) buf[0..<n];
  tw := text_width(tag, cap);
  link := Box.{x0 = x - 4 * d, y0 = y - cap - 6 * d, x1 = x + tw + 4 * d, y1 = y + 6 * d};
  hot := !s[0].touch && s[0].pointed && inside(link, s[0].px, s[0].py);
  v = put(out, v, tag, x, y, cap, ink(p, ifx hot then INK_WHITE else INK_LIT));
  // underlined, as a link is
  v = rule(out, v, x, y + 3 * d, x + tw, y + 3 * d, ink(p, INK_LIT), (ifx hot then 0.9f32 else 0.45f32) * p.fade);
  if s[0].link_n < MAX_LINKS { s[0].link_box[s[0].link_n] = link; s[0].link_row[s[0].link_n] = k; s[0].link_n += 1; }
  st := state_label(w, k); small := 5.5 * d;
  sw := text_width(st, small);
  v = put_right(out, v, st, right, y, small, state_hue(w, k, p));
  tx := x + text_width("#00000", cap) + 6 * d;
  return put_fit(out, v, item(w, w[0].text, k, 3), tx, y, 6.5 * d, ink(p, INK_PALE), right - sw - 10 * d - tx);
}

// Another project's issue the open one needs, or that needs it (line fl of
// links): VERSE #d981 or NEEDED BY PLANETARY VILLA #a3b5, a link to that
// project's page open on it, then its title and state.
far_related :: (out: [] f32, at: int, s: [] ProjectState, w: [] Work, fl: int, x: f32, y: f32, right: f32,
                top: f32, bottom: f32, p: Pen) -> int {
  d := p.d; cap := 7 * d; v := at; lt := w[0].links;
  if !in_view(y, cap, top, bottom) { return v; }
  buf: [96] u8;
  n := 0;
  if same(cell(lt, fl, 1), "by") { n = put_text(buf[..], 0, "NEEDED BY "); }
  n += put_project(buf[..], n, cell(lt, fl, 2));
  n += put_text(buf[..], n, " #");
  n += put_text(buf[..], n, cell(lt, fl, 3));
  tag := cast(string) buf[0..<n];
  tw := text_width(tag, cap);
  link := Box.{x0 = x - 4 * d, y0 = y - cap - 6 * d, x1 = x + tw + 4 * d, y1 = y + 6 * d};
  hot := !s[0].touch && s[0].pointed && inside(link, s[0].px, s[0].py);
  v = put(out, v, tag, x, y, cap, ink(p, ifx hot then INK_WHITE else INK_LIT));
  v = rule(out, v, x, y + 3 * d, x + tw, y + 3 * d, ink(p, INK_LIT), (ifx hot then 0.9f32 else 0.45f32) * p.fade);
  if s[0].link_n < MAX_LINKS { s[0].link_box[s[0].link_n] = link; s[0].link_row[s[0].link_n] = -2 - fl; s[0].link_n += 1; }
  st := far_label(cell(lt, fl, 4)); small := 5.5 * d;
  sw := text_width(st, small);
  v = put_right(out, v, st, right, y, small, ink(p, ifx link_open(cell(lt, fl, 4)) then INK_DIM else INK_PALE));
  tx := x + tw + 10 * d;
  return put_fit(out, v, cell(lt, fl, 5), tx, y, 6.5 * d, ink(p, INK_PALE), right - sw - 10 * d - tx);
}
far_label :: (status: string) -> string {
  if same(status, "resolved") { return "DONE"; }
  if same(status, "closed") { return "CLOSED"; }
  if same(status, "draft") { return "DRAFT"; }
  if same(status, "missing") { return "NOT FOUND"; }
  return "OPEN";
}
// Where a link to another project's issue goes: /projects/<d>#<alias>.
far_url :: (s: [] ProjectState, w: [] Work, fl: int) -> int {
  lt := w[0].links;
  n := put_text(s[0].outbox[..], 0, "/projects/");
  n += put_text(s[0].outbox[..], n, cell(lt, fl, 2));
  n += put_text(s[0].outbox[..], n, "#");
  n += put_text(s[0].outbox[..], n, cell(lt, fl, 3));
  return n;
}
// The lines of links about row r in direction dir, drawn one under another.
far_rows :: (out: [] f32, at: int, s: [] ProjectState, w: [] Work, r: int, dir: string, x: f32, y: [] f32, right: f32,
             top: f32, bottom: f32, p: Pen) -> int {
  v := at; lt := w[0].links; li := 0; alias := item(w, w[0].text, r, 0);
  while li < lt.count {
    if same(cell(lt, li, 1), dir) && same(cell(lt, li, 0), alias) {
      v = far_related(out, v, s, w, li, x, y[0], right, top, bottom, p); y[0] += 16 * p.d; y[1] = 1;
    }
    li = next_row(lt, li);
  }
  return v;
}

// The open task, drawn into b: its alias, state and CLOSE, its title and
// facts, then a body that scrolls: who's on it, the plan, the description,
// the acceptance checks, what it waits on and what waits on it, the notes
// and the event. Records the panel, CLOSE and the links for the pointer.
detail :: (out: [] f32, at: int, b: Box, p: Pen, s: [] ProjectState, w: [] Work) -> int {
  d := p.d; text := w[0].text; r := s[0].open - 1;
  white := ink(p, INK_WHITE); dim := ink(p, INK_DIM); accent := ink(p, INK_LIT); pale := ink(p, INK_PALE); faint := ink(p, INK_FAINT);
  s[0].panel = b; s[0].link_n = 0;
  narrow := box_w(b) < 440 * d;
  pad := (ifx narrow then 16.0f32 else 24.0f32) * d;
  x := b.x0 + pad; right := b.x1 - pad;
  v := at;
  buf: [160] u8;
  // the head: the alias, its state and CLOSE
  y := b.y0 + 30 * d;
  big := 11 * d; small := 6.5 * d;
  n := put_text(buf[..], 0, "#");
  n += put_text(buf[..], n, item(w, text, r, 0));
  v = rule(out, v, b.x0 + 10 * d, y - big * 0.5, x - 6 * d, y - big * 0.5, accent, p.fade);
  v = put(out, v, cast(string) buf[0..<n], x, y, big, accent);
  sx := x + text_width(cast(string) buf[0..<n], big) + 14 * d;
  st := state_label(w, r);
  v = chip(out, v, st, sx, y - 1 * d, small, state_hue(w, r, p), p);
  if w[0].kind[r] == KIND_TASK && w[0].claimed[r] {
    beat := 0.55 + 0.45 * sin(p.time * 2.4);
    v = diamond(out, v, sx + chip_width(st, small, p) + 9 * d, y - 1 * d - small * 0.5, 2 * d, accent, beat * p.fade);
  }
  cw := chip_width("CLOSE", small, p);
  cx := right - cw;
  close := Box.{x0 = cx - 30 * d, y0 = b.y0, x1 = b.x1, y1 = y + 14 * d};
  hot := !s[0].touch && s[0].pointed && inside(close, s[0].px, s[0].py);
  ck := ink(p, ifx hot then INK_LIT else INK_PALE);
  v = chip(out, v, "CLOSE", cx, y - 1 * d, small, ck, p);
  // an X before it, and ESC for a keyboard
  xc := cx - 12 * d; yc := y - 1 * d - small * 0.5; xr := 3.5 * d;
  v = rule(out, v, xc - xr, yc - xr, xc + xr, yc + xr, ck, p.fade);
  v = rule(out, v, xc - xr, yc + xr, xc + xr, yc - xr, ck, p.fade);
  if !s[0].touch && !narrow { v = put_right(out, v, "ESC", xc - 10 * d, y - 1 * d, 5.5 * d, faint); }
  s[0].close = close;
  // the title
  y += 30 * d;
  tcap := (ifx narrow then 9.5f32 else 11.0f32) * d; tstep := tcap + 7 * d;
  lines: [1] int;
  v = put_wrapped(out, v, item(w, text, r, 3), x, y, tcap, white, right - x, tstep, 4, lines[..]);
  y += tstep * cast(f32) (lines[0] - 1) + 18 * d;
  // the facts: size, labels, milestone
  m := 0;
  size := item(w, text, r, 5);
  if size.count > 0 { m += put_text(buf[..], m, "SIZE "); m += put_text(buf[..], m, size); }
  labels := item(w, text, r, 4);
  if labels.count > 0 { if m > 0 { m += put_text(buf[..], m, " · "); } m += put_text(buf[..], m, labels); }
  ms := w[0].parent[r];
  if ms >= 0 {
    if m > 0 { m += put_text(buf[..], m, " · "); }
    m += put_text(buf[..], m, ifx w[0].kind[ms] == KIND_INITIATIVE then "INITIATIVE #" else "MILESTONE #");
    m += put_text(buf[..], m, item(w, text, ms, 0)); m += put_text(buf[..], m, " "); m += put_text(buf[..], m, item(w, text, ms, 3));
  }
  if m > 0 {
    v = put_wrapped(out, v, cast(string) buf[0..<m], x, y, small, dim, right - x, 12 * d, 3, lines[..]);
    y += 12 * d * cast(f32) (lines[0] - 1) + 10 * d;
  }
  v = rule(out, v, b.x0 + 12 * d, y, b.x1 - 12 * d, y, dim, 0.14 * p.fade);
  // the body scrolls between top and bottom
  top := y + 4 * d; bottom := b.y1 - 14 * d;
  s[0].scroll = clamp(s[0].scroll, 0, s[0].scroll_max);
  y = top + 22 * d - s[0].scroll;
  body := 7 * d; step := 12.5 * d; gap := 26 * d;
  alias := item(w, text, r, 0);
  tw := right - x;
  // who's on it, or what finished it
  if w[0].kind[r] == KIND_TASK && (w[0].claimed[r] || finished(w, r)) {
    v = section(out, v, ifx finished(w, r) then "FINISHED" else "ON IT", x, y, right, top, bottom, p);
    y += 18 * d;
    m = 0;
    if finished(w, r) {
      hash := item(w, text, r, 11);
      m += put_text(buf[..], m, ifx hash.count > 0 then "DONE IN COMMIT " else ifx w[0].status[r] == WS_CLOSED then "CLOSED" else "RESOLVED");
      m += put_text(buf[..], m, hash);
    } else {
      m += put_text(buf[..], m, item(w, text, r, 6));
      if s[0].claimed_n > 0 { m += put_text(buf[..], m, "  SINCE "); m += put_text(buf[..], m, cast(string) s[0].claimed[0..<s[0].claimed_n]); }
    }
    f := flow(out, v, cast(string) buf[0..<m], x, y, body, white, tw, step, top, bottom);
    v = f.v; y = f.y - step + gap;
  }
  // the worker's plan
  plans := w[0].plans; total := 0;
  done := 0;
  pi := 0;
  while pi < plans.count {
    if same(cell(plans, pi, 0), alias) { total += 1; if same(cell(plans, pi, 1), "x") { done += 1; } }
    pi = next_row(plans, pi);
  }
  if total > 0 {
    m = number(done, false, buf[..]); m += put_text(buf[..], m, " OF "); m += number(total, false, buf[m..<buf.count]); m += put_text(buf[..], m, " DONE");
    v = section(out, v, "PLAN", x, y, right, top, bottom, p);
    if in_view(y, small, top, bottom) { v = put_right(out, v, cast(string) buf[0..<m], right, y, 5.5 * d, dim); }
    y += 18 * d;
    pi = 0;
    while pi < plans.count {
      k := pi; pi = next_row(plans, pi);
      if !same(cell(plans, k, 0), alias) { continue; }
      mark := cell(plans, k, 1);
      if in_view(y, body, top, bottom) { v = step_mark(out, v, mark, x + 3 * d, y - body * 0.45, p); }
      now := same(mark, ">");
      lead := 14.0f32 * d;
      if now && in_view(y, body, top, bottom) { v = put(out, v, "NOW", x + lead, y, 5.5 * d, accent); lead += 26 * d; }
      tint := ifx now then white else ifx same(mark, "x") then dim else pale;
      f := flow(out, v, cell(plans, k, 2), x + lead, y, body, tint, tw - lead, step, top, bottom);
      v = f.v; y = f.y + 2 * d;
    }
    y += gap - step;
  }
  // the description: "## " lines are headings, "- " lines bullets
  v = section(out, v, "DESCRIPTION", x, y, right, top, bottom, p);
  y += 18 * d;
  text_body := cast(string) s[0].body[0..<s[0].body_n];
  if text_body.count == 0 {
    if in_view(y, body, top, bottom) { v = put(out, v, "NO DESCRIPTION", x, y, body, dim); }
    y += step;
  }
  i := 0;
  while i < text_body.count {
    j := i;
    while j < text_body.count && text_body[j] != '\n' { j += 1; }
    line := text_body[i..<j];
    i = j + 1;
    if line.count == 0 { y += step * 0.55; continue; }
    if line.count > 2 && line[0] == '#' {
      h := 0;
      while h < line.count && (line[h] == '#' || line[h] == ' ') { h += 1; }
      y += 4 * d;
      if in_view(y, small, top, bottom) { v = put_fit(out, v, line[h..<line.count], x, y, small, accent, tw); }
      y += step + 2 * d;
      continue;
    }
    if line.count > 2 && (line[0] == '-' || line[0] == '*') && line[1] == ' ' {
      if in_view(y, body, top, bottom) { v = diamond(out, v, x + 3 * d, y - body * 0.45, 1.8 * d, accent, 0.8 * p.fade); }
      f := flow(out, v, line[2..<line.count], x + 14 * d, y, body, pale, tw - 14 * d, step, top, bottom);
      v = f.v; y = f.y + 2 * d;
      continue;
    }
    f := flow(out, v, line, x, y, body, pale, tw, step, top, bottom);
    v = f.v; y = f.y;
  }
  y += gap - step;
  // the acceptance checks
  checks := cast(string) s[0].checks[0..<s[0].checks_n];
  nc := pieces(checks, ITEM_BREAK);
  if nc > 0 {
    v = section(out, v, "ACCEPTANCE", x, y, right, top, bottom, p);
    y += 18 * d;
    passed := finished(w, r);
    for k: 0..<nc {
      if in_view(y, body, top, bottom) { v = step_mark(out, v, ifx passed then "x" else "o", x + 3 * d, y - body * 0.45, p); }
      f := flow(out, v, piece(checks, ITEM_BREAK, k), x + 14 * d, y, body, ifx passed then dim else white, tw - 14 * d, step, top, bottom);
      v = f.v; y = f.y + 3 * d;
    }
    y += gap - step;
  }
  // what it waits on, and what waits on it
  v = section(out, v, "WAITS ON", x, y, right, top, bottom, p);
  y += 18 * d;
  any := false;
  for k: 0..<w[0].n {
    if !waits_on(w, r, k) { continue; }
    v = related(out, v, s, w, k, x, y, right, top, bottom, p); y += 16 * d; any = true;
  }
  fy: [2] f32; fy[0] = y; fy[1] = 0;
  v = far_rows(out, v, s, w, r, "needs", x, fy[..], right, top, bottom, p); y = fy[0]; if fy[1] > 0 { any = true; }
  if !any { if in_view(y, body, top, bottom) { v = put(out, v, "NOTHING", x, y, small, dim); } y += 16 * d; }
  y += gap - 16 * d;
  v = section(out, v, "WAITED ON BY", x, y, right, top, bottom, p);
  y += 18 * d;
  any = false;
  for k: 0..<w[0].n {
    if !waits_on(w, k, r) { continue; }
    v = related(out, v, s, w, k, x, y, right, top, bottom, p); y += 16 * d; any = true;
  }
  fy[0] = y; fy[1] = 0;
  v = far_rows(out, v, s, w, r, "by", x, fy[..], right, top, bottom, p); y = fy[0]; if fy[1] > 0 { any = true; }
  if !any { if in_view(y, body, top, bottom) { v = put(out, v, "NOTHING", x, y, small, dim); } y += 16 * d; }
  y += gap - 16 * d;
  // the notes, oldest first, each with its time in Chicago
  notes := cast(string) s[0].notes[0..<s[0].notes_n];
  nn := pieces(notes, ITEM_BREAK);
  m = put_text(buf[..], 0, "NOTES");
  if nn > 0 { m += put_text(buf[..], m, " ("); m += number(nn, false, buf[m..<buf.count]); m += put_text(buf[..], m, ")"); }
  v = section(out, v, cast(string) buf[0..<m], x, y, right, top, bottom, p);
  if in_view(y, small, top, bottom) { v = put_right(out, v, "CHICAGO TIME", right, y, 5.5 * d, dim); }
  y += 18 * d;
  if nn == 0 { if in_view(y, body, top, bottom) { v = put(out, v, "NO NOTES YET", x, y, small, dim); } y += step; }
  for k: 0..<nn {
    one := piece(notes, ITEM_BREAK, k);
    when := piece(one, PART_BREAK, 0); by := piece(one, PART_BREAK, 1);
    if in_view(y, small, top, bottom) {
      v = put(out, v, when, x, y, small, dim);
      if by.count > 0 { v = put_fit(out, v, by, x + text_width(when, small) + 10 * d, y, small, accent, right - x - text_width(when, small) - 10 * d); }
    }
    y += 13 * d;
    f := flow(out, v, piece(one, PART_BREAK, 2), x + 8 * d, y, body, pale, tw - 8 * d, step, top, bottom);
    v = f.v; y = f.y + 6 * d;
  }
  y += gap - step;
  // the event the task is
  v = section(out, v, "NOSTR EVENT", x, y, right, top, bottom, p);
  y += 18 * d;
  if s[0].nevent_n > 0 {
    f := flow(out, v, cast(string) s[0].nevent[0..<s[0].nevent_n], x, y, 5.5 * d, dim, tw, 11 * d, top, bottom);
    v = f.v; y = f.y + 4 * d;
  }
  f := flow(out, v, cast(string) s[0].event[0..<s[0].event_n], x, y, 5.5 * d, dim, tw, 11 * d, top, bottom);
  v = f.v; y = f.y;
  // how far it scrolls, and where it is
  s[0].scroll_max = hi(0, y + s[0].scroll - bottom);
  if s[0].scroll_max > 0 {
    bx := b.x1 - 7 * d; span := bottom - top;
    v = rule(out, v, bx, top, bx, bottom, dim, 0.12 * p.fade);
    seen_part := span / (span + s[0].scroll_max);
    t0 := top + (span - span * seen_part) * s[0].scroll / s[0].scroll_max;
    thumb := accent; thumb.core = 1.1 * d;
    v = rule(out, v, bx, t0, bx, t0 + span * seen_part, thumb, 0.8 * p.fade);
  }
  return frame(out, v, b, 10 * d, p);
}

// ---------------------------------------------------------------- input

POINTER_DOWN :: 0; POINTER_MOVE :: 1; POINTER_UP :: 2; POINTER_CANCEL :: 3;
KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_UP :: -6; KEY_DOWN :: -7; KEY_HOME :: -8; KEY_END :: -9;
KEY_PAGE_UP :: -10; KEY_PAGE_DOWN :: -11;

// The queue row under (x, y) as the last frame drew it, or -1.
row_at :: (w: [] Work, x: f32, y: f32) -> int {
  for k: 0..<w[0].view.hit_n { if inside(w[0].view.hit_box[k], x, y) { return w[0].view.hit_row[k]; } }
  return -1;
}
link_at :: (s: [] ProjectState, x: f32, y: f32) -> int {
  if s[0].open == 0 { return -1; }
  for k: 0..<s[0].link_n { if inside(s[0].link_box[k], x, y) { return s[0].link_row[k]; } }
  return -1;
}

// A click (a press let go where it was pressed): CLOSE or outside the
// panel closes it, a link opens its task, a queue row opens its own.
// The header's crumbs: OPENAGENTS goes home, PROJECTS to the list.
ACT_NAVIGATE :: 1;   // host.js: go to the outbox's URL
crumb_at :: (s: [] ProjectState, x: f32, y: f32) -> string {
  d := hi(s[0].dpr, 1); h := layout(s[0].width, s[0].height, d).header;
  x0 := h.x0 + 18 * d;
  if y < h.y0 + 10 * d || y > h.y0 + 27 * d { return ""; }
  if x >= x0 && x <= x0 + text_width("OPENAGENTS", 7 * d) { return "/"; }
  if x >= x0 + text_width("OPENAGENTS /", 7 * d) && x <= x0 + text_width("OPENAGENTS / PROJECTS", 7 * d) { return "/projects"; }
  return "";
}

// The header's link to the project's first realm: WALK THE REALM, or REALM where the crumbs leave less room.
realm_label :: (w: [] Work, b: Box, d: f32) -> string {
  crumbs := text_width("OPENAGENTS / PROJECTS /", 7 * d) + SPACE * 7 * d + text_width(w[0].name, 7 * d);
  long := "WALK THE REALM";
  return ifx b.x0 + 18 * d + crumbs + 24 * d + text_width(long, 7 * d) <= b.x1 - 18 * d then long else "REALM";
}
realm_box :: (w: [] Work, b: Box, d: f32) -> Box {
  if w[0].realm.count == 0 { return Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0}; }
  right := b.x1 - 18 * d;
  return Box.{x0 = right - text_width(realm_label(w, b, d), 7 * d), y0 = b.y0 + 10 * d, x1 = right, y1 = b.y0 + 27 * d};
}

// The header's door for a member to drop more on the project (rc-later-drops): ADD TO PROJECT opens
// /projects' drop area for it, left of the realm's link; ADD where there's less room, none on the
// narrowest screens.
add_label :: (w: [] Work, b: Box, d: f32) -> string {
  crumbs := text_width("OPENAGENTS / PROJECTS /", 7 * d) + SPACE * 7 * d + text_width(w[0].name, 7 * d);
  rb := realm_box(w, b, d);
  right := ifx rb.x1 > rb.x0 then rb.x0 - 18 * d else b.x1 - 18 * d;
  long := "ADD TO PROJECT";
  if b.x0 + 18 * d + crumbs + 24 * d + text_width(long, 7 * d) <= right { return long; }
  return ifx b.x0 + 18 * d + crumbs + 24 * d + text_width("ADD", 7 * d) <= right then "ADD" else "";
}
add_box :: (w: [] Work, b: Box, d: f32) -> Box {
  label := add_label(w, b, d);
  if w[0].add.count == 0 || label.count == 0 { return Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0}; }
  rb := realm_box(w, b, d);
  right := ifx rb.x1 > rb.x0 then rb.x0 - 18 * d else b.x1 - 18 * d;
  return Box.{x0 = right - text_width(label, 7 * d), y0 = b.y0 + 10 * d, x1 = right, y1 = b.y0 + 27 * d};
}
// "/projects?add=SLUG&key=KEY#new" for a project whose key and slug the page knows.
set_add :: (w: [] Work, slug: string, key: string) {
  w[0].add = "";
  if key.count != 64 || slug.count == 0 || slug.count > 80 { return; }
  for i: 0..<slug.count { c := slug[i]; if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return; } }
  n := put_text(w[0].add_buf[..], 0, "/projects?add="); n += put_text(w[0].add_buf[..], n, slug);
  n += put_text(w[0].add_buf[..], n, "&key="); n += put_text(w[0].add_buf[..], n, key); n += put_text(w[0].add_buf[..], n, "#new");
  w[0].add = cast(string) w[0].add_buf[0..<n];
}

click :: (s: [] ProjectState, w: [] Work, x: f32, y: f32) -> bool {
  if s[0].page==0 && project_intro(w) {
    d:=hi(s[0].dpr,1);book:=coax_book_box(project_layout(s[0].width,s[0].height,d,w).header,d);
    if inside(book,x,y) {s[0].action=ACT_NAVIGATE;s[0].out_n=put_text(s[0].outbox[..],0,COAX_BOOK_URL);return true;}
  }
  rb := realm_box(w, layout(s[0].width, s[0].height, hi(s[0].dpr, 1)).header, hi(s[0].dpr, 1));
  if rb.x1 > rb.x0 && inside(rb, x, y) { s[0].action = ACT_NAVIGATE; s[0].out_n = put_text(s[0].outbox[..], 0, w[0].realm); return true; }
  ab := add_box(w, layout(s[0].width, s[0].height, hi(s[0].dpr, 1)).header, hi(s[0].dpr, 1));
  if ab.x1 > ab.x0 && inside(ab, x, y) { s[0].action = ACT_NAVIGATE; s[0].out_n = put_text(s[0].outbox[..], 0, w[0].add); return true; }
  go := crumb_at(s, x, y);
  if go.count > 0 { s[0].action = ACT_NAVIGATE; s[0].out_n = put_text(s[0].outbox[..], 0, go); return true; }
  if s[0].open > 0 {
    if inside(s[0].close, x, y) { close_task(s); return true; }
    k := link_at(s, x, y);
    if k >= 0 { open_task(s, w, k); return true; }
    if k <= -2 { s[0].action = ACT_NAVIGATE; s[0].out_n = far_url(s, w, -2 - k); return true; }
    if inside(s[0].panel, x, y) { return true; }
  }
  r := row_at(w, x, y);
  if r >= 0 { s[0].keys_moved = false; if s[0].open != r + 1 { open_task(s, w, r); } return true; }
  if s[0].open > 0 { close_task(s); return true; }
  return false;
}

// The keys move through the queue in the order it's shown.
step_pick :: (s: [] ProjectState, w: [] Work, by: int) {
  order: [MAX_ITEMS] int; sect: [MAX_ITEMS] int;
  count := queue_order(w, order[..], sect[..]);
  if count == 0 { return; }
  at := -1;
  for k: 0..<count { if order[k] + 1 == s[0].pick { at = k; } }
  // the first press shows where the keys are; the next ones move them
  if at < 0 { at = ifx by > 0 then 0 else count - 1; } else if s[0].keys_moved || s[0].open > 0 { at = clamp_int(at + by, 0, count - 1); }
  s[0].pick = order[at] + 1; s[0].keys_moved = true;
}
clamp_int :: (a: int, low: int, high: int) -> int { if a < low { return low; } if a > high { return high; } return a; }

coaxial_project_pointer :: (s: [] ProjectState, w: [] Work, x: f32, y: f32, phase: int, kind: int) -> bool #export_c {
  if s.count < 1 || w.count < 1 || s[0].page != 0 || !w[0].read { return false; }
  d := hi(s[0].dpr, 1);
  s[0].px = x; s[0].py = y; s[0].pointed = true;
  if phase == POINTER_DOWN {
    s[0].down = true; s[0].down_x = x; s[0].down_y = y; s[0].moved = false; s[0].touch = kind != 0;
    s[0].drag_scroll = s[0].scroll;
    return s[0].open > 0;
  }
  if phase == POINTER_MOVE {
    if kind == 0 && !s[0].down { s[0].touch = false; s[0].keys_moved = false; }
    if s[0].down && abs(x - s[0].down_x) + abs(y - s[0].down_y) > 8 * d { s[0].moved = true; }
    // a drag in the open panel scrolls it
    if s[0].down && s[0].moved && s[0].open > 0 && inside(s[0].panel, s[0].down_x, s[0].down_y) {
      s[0].scroll = clamp(s[0].drag_scroll - (y - s[0].down_y), 0, s[0].scroll_max);
      return true;
    }
    return false;
  }
  if phase == POINTER_CANCEL || !s[0].down { s[0].down = false; return false; }
  s[0].down = false;
  if s[0].moved { return s[0].open > 0; }
  return click(s, w, x, y);
}

coaxial_project_key :: (s: [] ProjectState, w: [] Work, key: int, mods: int) -> bool #export_c {
  if s.count < 1 || w.count < 1 || s[0].page != 0 || !w[0].read || (mods & 10) != 0 { return false; }
  open := s[0].open > 0;
  if key == KEY_ESCAPE {
    if open { close_task(s); return true; }
    if s[0].keys_moved { s[0].keys_moved = false; return true; }
    return false;
  }
  if key == KEY_UP || key == KEY_DOWN {
    step_pick(s, w, ifx key == KEY_UP then -1 else 1);
    if open { open_task(s, w, s[0].pick - 1); }
    return true;
  }
  if (key == KEY_ENTER || key == ' ') && !open {
    if s[0].pick > 0 && s[0].keys_moved { open_task(s, w, s[0].pick - 1); return true; }
    return false;
  }
  if open {
    page := hi(box_h(s[0].panel) * 0.75, 40);
    if key == KEY_PAGE_DOWN || key == ' ' { s[0].scroll = clamp(s[0].scroll + page, 0, s[0].scroll_max); return true; }
    if key == KEY_PAGE_UP { s[0].scroll = clamp(s[0].scroll - page, 0, s[0].scroll_max); return true; }
    if key == KEY_HOME { s[0].scroll = 0; return true; }
    if key == KEY_END { s[0].scroll = s[0].scroll_max; return true; }
  }
  return false;
}

// The wheel, CSS pixels down: scrolls the open panel.
coaxial_project_wheel :: (s: [] ProjectState, dy: f32) #export_c {
  if s.count < 1 || s[0].open == 0 { return; }
  s[0].scroll = clamp(s[0].scroll + dy * hi(s[0].dpr, 1), 0, s[0].scroll_max);
}

// The pointer's cursor: 1 (a link) over a row, a related task or CLOSE.
coaxial_project_cursor :: (s: [] ProjectState, w: [] Work) -> int #export_c {
  if s.count < 1 || w.count < 1 || s[0].page != 0 || s[0].touch || !s[0].pointed { return 0; }
  x := s[0].px; y := s[0].py;
  if project_intro(w) {
    d:=hi(s[0].dpr,1);
    if inside(coax_book_box(project_layout(s[0].width,s[0].height,d,w).header,d),x,y) {return 1;}
  }
  if crumb_at(s, x, y).count > 0 { return 1; }
  rb := realm_box(w, layout(s[0].width, s[0].height, hi(s[0].dpr, 1)).header, hi(s[0].dpr, 1));
  if rb.x1 > rb.x0 && inside(rb, x, y) { return 1; }
  ab := add_box(w, layout(s[0].width, s[0].height, hi(s[0].dpr, 1)).header, hi(s[0].dpr, 1));
  if ab.x1 > ab.x0 && inside(ab, x, y) { return 1; }
  if s[0].open > 0 {
    if inside(s[0].close, x, y) || link_at(s, x, y) != -1 { return 1; }
    if inside(s[0].panel, x, y) { return 0; }
  }
  return ifx row_at(w, x, y) >= 0 then 1 else 0;
}

// The location's hash, n bytes in the inbox the relay's frames share
// (host.js, at load and on every change): the task to open, or none. Read
// at the next frame, once the work is.
coaxial_project_hash :: (s: [] ProjectState, l: [] Live, n: int) #export_c {
  if s.count < 1 || l.count < 1 { return; }
  k := clamp_int(n, 0, 32);
  from := ifx k > 0 && l[0].inbox[0] == '#' then 1 else 0;
  s[0].want_n = put_text(s[0].want[..], 0, cast(string) l[0].inbox[from..<lo_int(k, from + 16)]);
  s[0].wanted = true;
}
coaxial_project_action :: (s: [] ProjectState) -> int #export_c { if s.count < 1 { return 0; } return s[0].action; }
coaxial_project_action_done :: (s: [] ProjectState) #export_c { if s.count > 0 { s[0].action = 0; } }

// ---------------------------------------------------------------- the frame

coaxial_project_frame :: (s: [] ProjectState, t: [] Tree, w: [] Work, lv: [] Live, out: [] f32, uniforms: [] f32,
                          width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || t.count < 1 || w.count < 1 || lv.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  step := clamp(dt, 0, 0.1);
  s[0].time += step;
  s[0].frames += 1;
  if !s[0].chosen { choose(s, t, w, lv); }
  // a real page holds its socket to the relay and draws each new fold; the
  // demo keeps its samples
  if s[0].page == 0 {
    live_tick(lv, s[0].time, ifx w[0].baked >= 0 then baked(w[0].baked).relay else DEFAULT_RELAY);
    w[0].live = lv[0].state;
    if lv[0].dirty { live_apply(lv, w); }
    if lv[0].link_ready { live_links_apply(lv, w); }
  }
  time := ifx still then 20.0f32 else s[0].time;
  d := hi(dpr, 1);
  s[0].width = width; s[0].height = height; s[0].dpr = d;
  // the task a link (the location's hash) asks for, once the work is read
  if s[0].wanted {
    s[0].wanted = false;
    want := cast(string) s[0].want[0..<s[0].want_n];
    k := row_of(w, w[0].text, want);
    if want.count == 0 { s[0].open = 0; } else if k >= 0 && s[0].open != k + 1 { open_task(s, w, k); }
  }
  fade := ifx still then 1.0f32 else ease(time / 1.1);
  p := Pen.{d = d, fade = fade, time = time, demo = s[0].page == 1};
  l := ifx p.demo then layout(width,height,d) else project_layout(width,height,d,w);
  // the open task: over the scene on a wide screen, the whole screen otherwise
  open := !p.demo && s[0].open > 0 && s[0].open <= w[0].n;
  full := open && !l.wide;
  db := detail_box(l, width, height, d);
  w[0].view.hit_n = 0;
  w[0].view.px = s[0].px; w[0].view.py = s[0].py;
  w[0].view.hover = s[0].pointed && !s[0].touch && !s[0].keys_moved;
  w[0].view.pick = ifx s[0].keys_moved then s[0].pick else 0;
  w[0].view.open = ifx open then s[0].open else 0;
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = 20 + time; uniforms[3] = fade;
  uniforms[4] = ifx still then 1.0f32 else 0.0f32; uniforms[5] = 0; uniforms[6] = 0; uniforms[7] = 0;
  for k: 0..<PANELS { glass(uniforms, k, l.header, 0, 0, 0); }
  cut := 10 * d;
  glass(uniforms, 0, l.header, cut, 0.92, 0);
  glass(uniforms, 1, l.queue, cut, 0.92, 0);
  glass(uniforms, 2, l.agents, cut, 0.92, 0);
  panels := 3;
  if l.activity_on { glass(uniforms, 3, l.activity, cut, 0.92, 0); panels = 4; }
  if open { glass(uniforms, panels, db, cut, 0.97, 0); panels += 1; }
  if full {
    // the detail is the screen: its glass alone, and nothing drawn under it
    for k: 0..<PANELS { glass(uniforms, k, l.header, 0, 0, 0); }
    glass(uniforms, 0, db, cut, 0.97, 0);
    uniforms[5] = 1;
    return detail(out, 0, db, p, s, w);
  }
  uniforms[5] = cast(f32) panels;
  v := 0;
  if !open {
    v = scene(out, v, l.scene, p, t, still, w[0].ready_n);
    v = scene_hud(out, v, l.scene, p, l.columns, w);
    v = stats(out, v, l.scene, p, w, t);
  }
  v = header(out, v, l.header, p, l.wide, w);
  compact := !l.wide && !l.columns;
  if p.demo {
    v = queue(out, v, l.queue, p);
    if l.activity_on { v = activity(out, v, l.activity, p); }
    v = agents(out, v, l.agents, p, compact);
  } else {
    v = real_queue(out, v, l.queue, p, w);
    if l.activity_on { v = plan(out, v, l.activity, p, w); }
    v = real_agents(out, v, l.agents, p, compact, !l.activity_on, w);
    if open { v = detail(out, v, db, p, s, w); }
  }
  return v;
}

// The first frame: which project. The page named it (MSG_PAGE_TEXT, before
// any frame); a page that didn't is Coax's, as is the demo. A project this
// build baked starts from its baked tables and commits; any other from
// nothing until its relay answers.
// Admit the baked row set before any displayed tables, names or tree change.
choose_baked :: (t: [] Tree, w: [] Work, lv: [] Live, b: Baked, k: int, seed: bool) -> bool {
  if !project_row_count_fits(rows(b.items), MAX_ITEMS) {
    live_incomplete(lv, 5); w[0].live = LIVE_OFFLINE; return false;
  }
  w[0].baked = k;
  w[0].links = b.links;
  read_work(w, b.items);
  w[0].plans = b.plans; w[0].plan_info = b.plan_info; w[0].details = b.details; w[0].log = b.log; w[0].steps = b.steps; w[0].naddr = b.naddr;
  index_details(w);
  if seed && !seed_known(lv, w) { live_incomplete(lv, 5); }
  w[0].slug = b.slug; w[0].name = b.name; w[0].description = b.description; w[0].license = b.license;
  w[0].path = b.path; w[0].repo = b.repo; w[0].owner = b.owner;
  set_names(w, b.pubkey, b.relay);
  grow(t, b.history);
  return true;
}
choose :: (s: [] ProjectState, t: [] Tree, w: [] Work, lv: [] Live) {
  s[0].chosen = true;
  k := 0;
  if s[0].page == 0 && lv[0].key_n > 0 { k = baked_index(live_slug(lv)); }
  else if s[0].page == 0 && !live_project_of(lv, baked(0)) { k = -1; }
  if s[0].page == 0 && k >= 0 && !equal(live_key(lv), baked(k).pubkey) { k = -1; }
  if k >= 0 {
    if !choose_baked(t, w, lv, baked(k), k, s[0].page == 0) { return; }
  } else {
    w[0].baked = -1;
    w[0].links = ""; read_work(w, "");
    w[0].slug = live_slug(lv); w[0].name = live_slug(lv);
    set_names(w, live_key(lv), DEFAULT_RELAY);
    grow(t, "");
  }
  if s[0].page == 0 { set_add(w, w[0].slug, live_key(lv)); }
}
// The project's key and relay, for the face to name it by (its address,
// kind 30621 with d its slug, and its key) and each task's event.
set_names :: (w: [] Work, key: string, relay: string) {
  w[0].key = key; w[0].relay = relay; w[0].named = false; w[0].naddr_n = 0; w[0].npub_n = 0;
}
// The address the PROJECT row shows: the face's Coax naddr, else the baked one.
project_naddr :: (w: [] Work) -> string {
  if w[0].naddr_n > 0 { return cast(string) w[0].naddr_buf[0..<w[0].naddr_n]; }
  return w[0].naddr;
}
live_project_of :: (lv: [] Live, b: Baked) -> bool {
  buf: [160] u8;
  n := put_text(buf[..], 0, b.pubkey); n += put_text(buf[..], n, " "); n += put_text(buf[..], n, b.slug);
  return live_project(lv, cast(string) buf[0..<n]);
}

// A tag's value from the project's or its repository's event, as a cell, into the header's buffer.
head_put :: (lv: [] Live, w: [] Work, e: int, name: string, k: int, at: int, keep: string) -> Head {
  h := Head.{text = keep, at = at};
  if e < 0 { return h; }
  st := lv[0].store[..];
  tg := tag_named(st, e, name);
  if tg < 0 || st[0].tag_len[tg] <= k { return h; }
  n := cell_into(w[0].head[..], at, element(st, tg, k));
  if n < 0 { return h; }
  h.text = cast(string) w[0].head[at..<n]; h.at = n;
  return h;
}
Head :: struct { text: string; at: int; }

// Events arrived: fold them again and draw the result.
live_apply :: (lv: [] Live, w: [] Work) {
  count := lv[0].candidate[0].items_n;
  if !lv[0].candidate[0].complete || count < 0 || count > lv[0].candidate[0].items.count ||
      !project_row_count_fits(rows(cast(string) lv[0].candidate[0].items[0..<count]), MAX_ITEMS) {
    live_incomplete(lv, 5); w[0].live = LIVE_OFFLINE; return;
  }
  lv[0].dirty = false; lv[0].folds += 1;
  st := lv[0].store[..]; tb := lv[0].tables[..];
  // The catch-up path validated all candidate outputs before setting dirty.
  tb[0] = lv[0].candidate[0];
  read_work(w, cast(string) tb[0].items[0..<tb[0].items_n]);
  w[0].log = cast(string) tb[0].log[0..<tb[0].log_n];
  w[0].plans = cast(string) tb[0].plans[0..<tb[0].plans_n];
  w[0].plan_info = cast(string) tb[0].info[0..<tb[0].info_n];
  w[0].details = cast(string) tb[0].details[0..<tb[0].details_n];
  index_details(w);
  pe := lv[0].fold[0].project; re := lv[0].fold[0].repo;
  h := head_put(lv, w, pe, "name", 1, 0, w[0].name); w[0].name = h.text;
  h = head_put(lv, w, pe, "description", 1, h.at, w[0].description); w[0].description = h.text;
  h = head_put(lv, w, pe, "license", 1, h.at, w[0].license); w[0].license = h.text;
  h = head_put(lv, w, pe, "path", 2, h.at, w[0].path); w[0].path = h.text;
  h = head_put(lv, w, re, "name", 1, h.at, w[0].repo); w[0].repo = h.text;
  h = head_put(lv, w, pe, "realm", 1, h.at, w[0].realm);
  w[0].realm = ifx realm_path(h.text) then h.text else "";
}
// A realm's page as a project event may name it: one of this site's, under /projects/.
realm_path :: (path: string) -> bool {
  pre := "/projects/";
  if path.count <= pre.count || path.count > 120 || path[0..<pre.count] != pre { return false; }
  for i: 0..<path.count { c := path[i]; if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '/') { return false; } }
  return true;
}

// Work across projects came back from the relay: draw its table.
live_links_apply :: (lv: [] Live, w: [] Work) {
  lv[0].link_ready = false;
  n := lv[0].link_n;
  for i: 0..<n { w[0].links_buf[i] = lv[0].link_out[i]; }
  w[0].links = cast(string) w[0].links_buf[0..<n];
  read_work(w, w[0].text);
}

// The host's messages: the relay socket's events (project-live.coax).
coaxial_project_message :: (l: [] Live, kind: int, length: int) #export_c {
  if l.count < 1 || length < 0 || length > LIVE_INBOX { return; }
  if kind == MSG_PAGE_TEXT { if live_project(l, cast(string) l[0].inbox[0..<length]) {} return; }
  live_message(l, kind, length);
}
// The face carried out the pipe's open: the host's socket id, or -1.
coaxial_project_opened :: (l: [] Live, id: int) #export_c {
  if l.count < 1 { return; }
  live_opened(l, id);
}
coaxial_project_inbox_cap :: () -> int #export_c { return LIVE_INBOX; }

coaxial_project_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_project_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_project_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---------------------------------------------------------------- checks

#test "the tree has one node per commit, on the branch of the folder it touched" {
  t: [1] Tree;
  grow(t[..], COAX_HISTORY);
  #assert t[0].n == (ifx COAX_COMMITS < MAX_COMMITS then COAX_COMMITS else MAX_COMMITS) && COAX_COMMITS == rows(COAX_HISTORY);
  // past MAX_COMMITS the tree keeps the newest: its last node is the latest commit
  #assert same(field(t[0].history, t[0].n - 1, 0), field(COAX_HISTORY, COAX_COMMITS - 1, 0));
  total := 0;
  for b: 0..<BRANCHES { total += t[0].count[b]; }
  #assert total == t[0].n;
  for i: 0..<t[0].n {
    #assert t[0].branch[i] == branch_of(t[..], field(t[0].history, i, 2));
    if i > 0 { #assert t[0].trunk[i] > t[0].trunk[i - 1]; }
    r := sqrt(t[0].at[i].x * t[0].at[i].x + t[0].at[i].z * t[0].at[i].z);
    #assert r > 0.6 && r < PLOT;   // every branch stays over the plot
  }
  // the newest commit on each branch is its last
  for b: 0..<BRANCHES {
    if t[0].count[b] > 0 { #assert t[0].branch[t[0].last[b]] == b; }
  }
}

#test "a made-up history: branches by folder, oldest first" {
  t: [1] Tree;
  grow(t[..], "a|2026-01-01|src|x|one\nb|2026-01-02|web|x|two\nc|2026-01-03|src|x|three\nd|2026-01-04|spec|x|four\n");
  #assert t[0].n == 4 && t[0].count[1] == 2 && t[0].count[4] == 1 && t[0].count[0] == 1;
  #assert t[0].last[1] == 2 && t[0].last[4] == 1 && t[0].last[2] == -1;
  #assert same(field("a|bb|c\nd|e|f\n", 1, 1), "e") && same(field("a|bb|c\n", 0, 1), "bb");
}

fits_in :: (b: Box, w: f32, h: f32) -> bool {
  return b.x0 >= 0 && b.y0 >= 0 && b.x1 <= w && b.y1 <= h && b.x1 > b.x0 && b.y1 > b.y0;
}
apart :: (a: Box, b: Box) -> bool { return a.x1 <= b.x0 || b.x1 <= a.x0 || a.y1 <= b.y0 || b.y1 <= a.y0; }

#test "the layout fits a desktop, a tablet and a 320 px phone, without overlaps" {
  sizes := [8] f32.[1440, 900, 1080, 760, 768, 1024, 320, 568];
  dprs := [4] f32.[1, 2, 2, 2];
  for k: 0..<4 {
    w := sizes[k * 2] * dprs[k]; h := sizes[k * 2 + 1] * dprs[k];
    l := layout(w, h, dprs[k]);
    #assert fits_in(l.header, w, h) && fits_in(l.scene, w, h) && fits_in(l.queue, w, h) && fits_in(l.agents, w, h);
    #assert apart(l.header, l.scene) && apart(l.header, l.queue) && apart(l.scene, l.queue) && apart(l.queue, l.agents) && apart(l.scene, l.agents);
    if l.activity_on { #assert fits_in(l.activity, w, h) && apart(l.activity, l.agents) && apart(l.activity, l.scene); }
    #assert box_h(l.scene) >= 150 * dprs[k] && box_h(l.queue) >= 60 * dprs[k];
  }
  #assert layout(1440, 900, 1).wide && !layout(320 * 2, 568 * 2, 2).columns;
}

// Every stroke of a frame stays on the canvas.
on_canvas :: (out: [] f32, n: int, w: f32, h: f32, d: f32) -> bool {
  for v: 0..<n {
    x := out[v * VERTEX_FLOATS]; y := out[v * VERTEX_FLOATS + 1];
    // a quad reaches its glow past the stroke's end
    if x < -12 * d || y < -12 * d || x > w + 12 * d || y > h + 12 * d { return false; }
  }
  return true;
}

#test "a frame draws every panel inside the canvas, within the vertex budget" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  uniforms: [UNIFORM_FLOATS] f32;
  s: [1] ProjectState;
  t: [1] Tree;
  work: [1] Work;
  live: [1] Live;
  sizes := [6] f32.[1440, 900, 768, 1024, 320, 568];
  for page: 0..<2 {
    s[0].page = page;
    for k: 0..<3 {
      w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
      n := coaxial_project_frame(s[..], t[..], work[..], live[..], out[..], uniforms[..], w, h, 2, 0, true);
      #assert n > 3000 && n < MAX_VERTICES && n % 6 == 0;
      #assert on_canvas(out[..], n, w, h, 2);
      #assert uniforms[5] >= 3 && uniforms[0] == w;
    }
  }
}

#test "the queue lists open tasks first and fits its panel" {
  out: [60000 * VERTEX_FLOATS] f32;
  p := Pen.{d = 1, fade = 1, time = 20};
  b := Box.{x0 = 0, y0 = 0, x1 = 390, y1 = 700};
  n := queue(out[..], 0, b, p);
  #assert n > 600;
  for v: 0..<n { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
  #assert open_tasks() == 4 && claimed_tasks() == 3 && rows(TASKS) == 8;
  // a short panel draws fewer rows, never past its bottom
  small := Box.{x0 = 0, y0 = 0, x1 = 296, y1 = 120};
  m := queue(out[..], 0, small, p);
  #assert m < n;
  for v: 0..<m { #assert out[v * VERTEX_FLOATS + 1] <= 132; }
}

// A made-up project: an initiative, a milestone, and tasks where c waits on
// b, b is done (in commit abc1234567), d waits on e (open), d is ranked
// above e, f is claimed by w1 and h was closed by hand after b.
FIXTURE :: "i1|initiative|open|Init||||||0V|init||\nm1|milestone|open|First||||i1||1V|m-first||\nb1|task|resolved|Bee||S||m1||3|b|abc1234567|0000000100\nc1|task|open|Cee||M||m1|b1|5|c||\nd1|task|open|Dee||S||m1|e1|6|d||\ne1|task|open|Eee||L||m1||7|e||\nf1|task|open|Eff||S|w1|m1||4|f||\ng1|task|draft|Gee||S||m1||2|g||\nh1|task|closed|Aitch||S||m1||8|h||0000000200\n";

#test "the real queue: in progress first, then ready by rank, then waiting; done ones kept apart" {
  w: [1] Work;
  read_work(w[..], FIXTURE);
  #assert w[0].n == 9 && w[0].tasks == 7 && w[0].done_n == 2 && w[0].milestone_n == 1 && w[0].initiative == 0;
  // in progress: f (claimed by w1); ready: c (rank 5, its blocker b is done), e (7); then waiting: g (draft, 2), d (6, waits on e)
  #assert w[0].working_n == 1 && w[0].ready_n == 2 && w[0].queued == 5;
  names := [5] string.["f1", "c1", "e1", "g1", "d1"];
  for k: 0..<5 { #assert same(item(w[..], FIXTURE, w[0].queue[k], 0), names[k]); }
  #assert w[0].ready[3] && !w[0].ready[4] && !w[0].ready[7];
  #assert w[0].claimed[6] && !w[0].claimed[3] && same(item(w[..], FIXTURE, 6, 6), "w1");
  #assert w[0].waits[4] == 5 && w[0].waits[3] == -1;
  // the latest finished, newest first: h (closed at 200), then b (100, in abc1234567)
  #assert w[0].recent_n == 2 && w[0].recent[0] == 8 && w[0].recent[1] == 2;
  #assert same(item(w[..], FIXTURE, 2, 11), "abc1234567");
  pr := progress(w[..], 1);
  #assert pr.total == 7 && pr.done == 2 && pr.ready == 3;
  #assert w[0].initiative_n == 1 && w[0].initiatives[0] == 0;
}

FIXTURE_PLAN :: "f1|x|read the spec\nf1|x|write the vectors\nf1|>|field multiply\nf1|o|field square\nf1|o|inverse\nf1|o|benchmarks\nf1|o|docs\n";

#test "a plan's steps are found by alias, and the current one is the first not done" {
  #assert keyed("a|1\nb|2\n", "b", 0) == 1 && keyed("a|1\n", "z", 0) == -1;
  w: [1] Work;
  read_work(w[..], FIXTURE);
  w[0].plans = FIXTURE_PLAN;
  out: [20000 * VERTEX_FLOATS] f32;
  p := Pen.{d = 1, fade = 1, time = 20};
  // four fit: the window starts at the step before the current one
  a := plan_steps(out[..], 0, w[..], "f1", 0, 20, 300, 1000, 4, p);
  #assert a.v > 0 && a.y > 20;
  none := plan_steps(out[..], 0, w[..], "c1", 0, 20, 300, 1000, 4, p);
  #assert none.y == 20;
  #assert a.v > 300;
  #assert a.y >= 20 + 11 * 4;
  w[0].claimed[6] = true;
  #assert w[0].working_n == 1 && same(item(w[..], FIXTURE, w[0].queue[0], 0), "f1");
  #assert same(item(w[..], FIXTURE, w[0].queue[0], 6), "w1");
  big := Box.{x0 = 0, y0 = 0, x1 = 390, y1 = 700};
  q1 := real_queue(out[..], 0, big, p, w[..]);
  e: [1] Work;
  read_work(e[..], FIXTURE);
  q0 := real_queue(out[..], 0, big, p, e[..]);
  #assert q0 > 600;
  #assert q1 != q0;
}

#test "a finished task drops its worker" {
  w: [1] Work;
  read_work(w[..], "t1|task|resolved|Tee||S|w9|||1|t|0123456789|0000000300\n");
  #assert !w[0].claimed[0] && w[0].working_n == 0 && w[0].queued == 0 && w[0].recent_n == 1;
}

#test "a task ranked above an open blocker is flagged, and stays waiting" {
  w: [1] Work;
  read_work(w[..], FIXTURE);
  // d (rank 6) waits on e (rank 7): ranked above it
  #assert w[0].ahead[4] == 5 && !w[0].ready[4];
  // c (rank 5) waits on b, which is done: no flag
  #assert w[0].ahead[3] == -1;
  // ranks compare as bytes: "1z" < "2", "V" < "a", "a" < "aV"
  #assert before("1z", "2") && before("V", "a") && before("a", "aV") && !before("b", "aV");
  e: [1] Work;
  read_work(e[..], "");
  #assert e[0].n == 0 && e[0].queued == 0;
}

#test "the real queue draws inside its panel, and an empty one says so" {
  out: [60000 * VERTEX_FLOATS] f32;
  p := Pen.{d = 1, fade = 1, time = 20, demo = false};
  w: [1] Work;
  read_work(w[..], COAX_WORK_ITEMS);
  #assert rows(COAX_WORK_ITEMS) <= MAX_ITEMS && w[0].n == rows(COAX_WORK_ITEMS) && rows(VERSE_WORK_ITEMS) <= MAX_ITEMS;
  b := Box.{x0 = 0, y0 = 0, x1 = 390, y1 = 700};
  n := real_queue(out[..], 0, b, p, w[..]);
  #assert n > 600;
  for v: 0..<n { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
  e: [1] Work;
  read_work(e[..], "");
  m := real_queue(out[..], 0, b, p, e[..]);
  #assert m > 60 && m < n;
  q := plan(out[..], 0, b, p, w[..]);
  for v: 0..<q { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
  // the made-up project, with a task in progress and two finished, draws inside too
  f: [1] Work;
  read_work(f[..], FIXTURE);
  k := real_queue(out[..], 0, b, p, f[..]);
  #assert k > 600;
  // and with a plan under its task in progress: more strokes, still inside
  f[0].plans = FIXTURE_PLAN; f[0].plan_info = "f1|2|7|14:52|14:41|chose the RFC vectors\n";
  kp := real_queue(out[..], 0, b, p, f[..]);
  #assert kp > k;
  for v: 0..<kp { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
  short := Box.{x0 = 0, y0 = 0, x1 = 300, y1 = 200};
  ks := real_queue(out[..], 0, short, p, f[..]);
  for v: 0..<ks { #assert out[v * VERTEX_FLOATS + 1] <= 212; }
  for v: 0..<k { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
  a := real_agents(out[..], 0, b, p, false, true, w[..]);
  for v: 0..<a { #assert out[v * VERTEX_FLOATS + 1] <= 712; }
}

// ---------------------------------------------------------------- checks: a task's detail

#test "COAX_WORK_DETAILS fields decode as details.ts escapes them" {
  buf: [256] u8;
  // details.ts escapeDetail("a|b\nc\\d \\. e")
  n := undetail("a\\pb\\nc\\\\d \\\\. e", buf[..]);
  #assert same(cast(string) buf[0..<n], "a|b\nc\\d \\. e");
  // escapeList([["10-28 14:52 CDT", "w1", "took it | now"], ["10-28 15:00 CDT", "", "x\\:y"]])
  m := undetail("10-28 14:52 CDT\\:w1\\:took it \\p now\\.10-28 15:00 CDT\\:\\:x\\\\:y", buf[..]);
  list := cast(string) buf[0..<m];
  #assert pieces(list, ITEM_BREAK) == 2 && pieces("", ITEM_BREAK) == 0;
  one := piece(list, ITEM_BREAK, 0); two := piece(list, ITEM_BREAK, 1);
  #assert same(piece(one, PART_BREAK, 0), "10-28 14:52 CDT") && same(piece(one, PART_BREAK, 1), "w1") && same(piece(one, PART_BREAK, 2), "took it | now");
  #assert same(piece(two, PART_BREAK, 1), "") && same(piece(two, PART_BREAK, 2), "x\\:y");
  // a buffer too small keeps what fits
  small: [4] u8;
  #assert undetail("abcdef", small[..]) == 4;
  // the snapshot: one row an item, six fields each, keyed by the items' aliases
  w: [1] Work;
  read_work(w[..], COAX_WORK_ITEMS);
  w[0].details = COAX_WORK_DETAILS; index_details(w[..]);
  #assert rows(COAX_WORK_DETAILS) == w[0].n;
  for r: 0..<w[0].n {
    k := detail_of(w[..], r);
    #assert k >= 0 && cell(COAX_WORK_DETAILS, k, 1).count == 64;
    bars := 0; i := k;
    while i < COAX_WORK_DETAILS.count && COAX_WORK_DETAILS[i] != '\n' { if COAX_WORK_DETAILS[i] == '|' { bars += 1; } i += 1; }
    #assert bars == 5;
  }
  #assert keyed_start("ab|1\nb|2\n", "b") == 5 && keyed_start("ab|1\n", "a") == -1;
}

// A page's state and work after one frame at a size (device pixels, dpr 2).
Page :: struct { s: [1] ProjectState; t: [1] Tree; w: [1] Work; l: [1] Live; }
PAGE_OUT :: MAX_VERTICES * VERTEX_FLOATS;
draw_page :: (g: [] Page, out: [] f32, w: f32, h: f32) -> int {
  uniforms: [UNIFORM_FLOATS] f32;
  return coaxial_project_frame(g[0].s[..], g[0].t[..], g[0].w[..], g[0].l[..], out, uniforms[..], w, h, 2, 0, true);
}
poke :: (g: [] Page, x: f32, y: f32, phase: int, kind: int) {
  used := coaxial_project_pointer(g[0].s[..], g[0].w[..], x, y, phase, kind);
}
tap :: (g: [] Page, x: f32, y: f32, kind: int) -> bool {
  poke(g, x, y, POINTER_DOWN, kind);
  return coaxial_project_pointer(g[0].s[..], g[0].w[..], x, y, POINTER_UP, kind);
}
mid_x :: (b: Box) -> f32 { return (b.x0 + b.x1) * 0.5; }
mid_y :: (b: Box) -> f32 { return (b.y0 + b.y1) * 0.5; }
// Every vertex of out[from..<to] within b, give or take a glow.
within :: (out: [] f32, from: int, to: int, b: Box, d: f32) -> bool {
  for v: from..<to {
    x := out[v * VERTEX_FLOATS]; y := out[v * VERTEX_FLOATS + 1];
    if x < b.x0 - 12 * d || y < b.y0 - 12 * d || x > b.x1 + 12 * d || y > b.y1 + 12 * d { return false; }
  }
  return true;
}

#test "the queue's rows are found by the pointer on a desktop and a phone, and a click opens each" {
  out: [PAGE_OUT] f32;
  sizes := [4] f32.[1440, 900, 320, 568];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    g: [1] Page;
    _ := draw_page(g[..], out[..], w, h);
    l := project_layout(w, h, 2, g[0].w[..]);
    vw := g[0].w[0].view;
    #assert vw.hit_n >= ifx k == 0 then 3 else 1;
    for i: 0..<vw.hit_n {
      b := vw.hit_box[i];
      // inside the queue's panel, one under another, apart
      #assert b.x0 >= l.queue.x0 && b.x1 <= l.queue.x1 && b.y0 >= l.queue.y0 && b.y1 <= l.queue.y1;
      if i > 0 { #assert b.y0 >= vw.hit_box[i - 1].y1; }
      #assert row_at(g[0].w[..], mid_x(b), mid_y(b)) == vw.hit_row[i];
      #assert row_at(g[0].w[..], mid_x(b), b.y0 + 1) == vw.hit_row[i] && row_at(g[0].w[..], mid_x(b), b.y1 - 1) == vw.hit_row[i];
    }
    // off the rows: nothing
    #assert row_at(g[0].w[..], mid_x(l.header), mid_y(l.header)) == -1;
    // a mouse over a row: a pointer cursor; over the header: the default
    poke(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
    poke(g[..], mid_x(l.header), mid_y(l.header), POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 0;
    // a tap on each row opens it and names it in the hash
    for i: 0..<vw.hit_n {
      g[0].s[0].open = 0;
      b := vw.hit_box[i];
      #assert tap(g[..], mid_x(b), mid_y(b), k);
      #assert g[0].s[0].open == vw.hit_row[i] + 1 && g[0].s[0].action == ACT_HASH;
      #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], item(g[0].w[..], g[0].w[0].text, vw.hit_row[i], 0));
      coaxial_project_action_done(g[0].s[..]);
    }
    // a drag isn't a click
    g[0].s[0].open = 0;
    b := vw.hit_box[0];
    poke(g[..], mid_x(b), mid_y(b), POINTER_DOWN, 1);
    poke(g[..], mid_x(b), mid_y(b) + 60, POINTER_MOVE, 1);
    poke(g[..], mid_x(b), mid_y(b) + 60, POINTER_UP, 1);
    #assert g[0].s[0].open == 0;
  }
}

#test "the header's crumbs go home and back to the project list" {
  out: [PAGE_OUT] f32;
  sizes := [4] f32.[1440, 900, 320, 568];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    g: [1] Page;
    _ := draw_page(g[..], out[..], w, h);
    hb := layout(w, h, 2).header;
    x0 := hb.x0 + 36; y := hb.y0 + 36;
    px := x0 + text_width("OPENAGENTS / ", 14) + text_width("PROJECTS", 14) * 0.5;
    poke(g[..], px, y, POINTER_MOVE, 0);
    #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
    #assert tap(g[..], px, y, k) && g[0].s[0].action == ACT_NAVIGATE;
    #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], "/projects");
    coaxial_project_action_done(g[0].s[..]);
    #assert tap(g[..], x0 + 10, y, k) && same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], "/");
    #assert same(crumb_at(g[0].s[..], x0 + 10, hb.y0 + 80), "");
  }
}

#test "a project made from a drop links its first realm from the header; one that isn't doesn't" {
  #assert realm_path("/projects/lantern-garden/realm") && !realm_path("https://example.com/x") && !realm_path("/projects/")
    && !realm_path("/projects/a b") && !realm_path("/verse");
  sizes := [4] f32.[1440, 900, 320, 568];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    s: [1] ProjectState; wk: [1] Work;
    s[0].width = w; s[0].height = h; s[0].dpr = 2; s[0].pointed = true; s[0].touch = k == 1;
    wk[0].name = "LANTERN GARDEN";
    hb := layout(w, h, 2).header;
    #assert realm_box(wk[..], hb, 2).x1 <= realm_box(wk[..], hb, 2).x0;   // none named
    wk[0].realm = "/projects/lantern-garden/realm";
    rb := realm_box(wk[..], hb, 2);
    #assert rb.x1 > rb.x0 && rb.x1 <= hb.x1 && rb.x0 > hb.x0 + 36 + text_width("OPENAGENTS / PROJECTS /", 14);
    #assert same(realm_label(wk[..], hb, 2), ifx k == 0 then "WALK THE REALM" else "REALM");
    s[0].px = (rb.x0 + rb.x1) * 0.5; s[0].py = (rb.y0 + rb.y1) * 0.5;
    if k == 0 { #assert coaxial_project_cursor(s[..], wk[..]) == 1; }
    #assert click(s[..], wk[..], s[0].px, s[0].py) && s[0].action == ACT_NAVIGATE;
    #assert same(cast(string) s[0].outbox[0..<s[0].out_n], "/projects/lantern-garden/realm");
  }
}

#test "a member adds to a project from its header: ADD TO PROJECT opens the drop area for it" {
  key := "f841614afa0210523f6f4038fe85ce7d83cacdc2098ba60d63128f064088e0a7";
  sizes := [4] f32.[1440, 900, 390, 844];
  for k: 0..<2 {
    w := sizes[k * 2] * 2; h := sizes[k * 2 + 1] * 2;
    s: [1] ProjectState; wk: [1] Work;
    s[0].width = w; s[0].height = h; s[0].dpr = 2; s[0].pointed = true;
    wk[0].name = "PLANETARY VILLA";
    hb := layout(w, h, 2).header;
    set_add(wk[..], "planetary villa", key);
    #assert wk[0].add.count == 0;
    set_add(wk[..], "planetary-villa", "f8");
    #assert wk[0].add.count == 0;
    set_add(wk[..], "planetary-villa", key);
    #assert same(wk[0].add, "/projects?add=planetary-villa&key=f841614afa0210523f6f4038fe85ce7d83cacdc2098ba60d63128f064088e0a7#new");
    ab := add_box(wk[..], hb, 2);
    #assert ab.x1 > ab.x0 && ab.x1 <= hb.x1 && ab.x0 > hb.x0 + 36 + text_width("OPENAGENTS / PROJECTS / PLANETARY VILLA", 14);
    #assert same(add_label(wk[..], hb, 2), ifx k == 0 then "ADD TO PROJECT" else "ADD");
    wk[0].realm = "/projects/planetary-villa/realm";
    rb := realm_box(wk[..], hb, 2); ab = add_box(wk[..], hb, 2);
    #assert ab.x1 <= ab.x0 || ab.x1 < rb.x0;   // left of the realm's link, or none
    if k == 0 {
      #assert ab.x1 > ab.x0;
      s[0].px = (ab.x0 + ab.x1) * 0.5; s[0].py = (ab.y0 + ab.y1) * 0.5;
      #assert coaxial_project_cursor(s[..], wk[..]) == 1;
      #assert click(s[..], wk[..], s[0].px, s[0].py) && s[0].action == ACT_NAVIGATE;
      #assert same(cast(string) s[0].outbox[0..<s[0].out_n], wk[0].add);
    }
  }
}

#test "the detail opens and closes: CLOSE, a click outside, Esc, and the keys move through the queue" {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  vw := g[0].w[0].view;
  r := vw.hit_row[0];
  #assert tap(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), 0) && g[0].s[0].open == r + 1;
  _ = draw_page(g[..], out[..], w, h);
  l := project_layout(w, h, 2, g[0].w[..]);
  // wide: over the scene's column, the queue still there beside it
  #assert same_box(g[0].s[0].panel, l.scene) && g[0].w[0].view.hit_n > 0;
  // a click inside the panel keeps it; CLOSE closes it and clears the hash
  #assert tap(g[..], mid_x(l.scene), l.scene.y1 - 20, 0) && g[0].s[0].open == r + 1;
  c := g[0].s[0].close;
  #assert inside(l.scene, mid_x(c), mid_y(c));
  poke(g[..], mid_x(c), mid_y(c), POINTER_MOVE, 0);
  #assert coaxial_project_cursor(g[0].s[..], g[0].w[..]) == 1;
  #assert tap(g[..], mid_x(c), mid_y(c), 0) && g[0].s[0].open == 0 && g[0].s[0].out_n == 0 && g[0].s[0].action == ACT_HASH;
  // another row's click switches to it; a click outside both closes
  #assert tap(g[..], mid_x(vw.hit_box[0]), mid_y(vw.hit_box[0]), 0);
  #assert tap(g[..], mid_x(vw.hit_box[1]), mid_y(vw.hit_box[1]), 0) && g[0].s[0].open == vw.hit_row[1] + 1;
  #assert tap(g[..], mid_x(l.header), mid_y(l.header), 0) && g[0].s[0].open == 0;
}

#test "the keys move through the queue and open it; the location's hash opens a task" {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  vw := g[0].w[0].view;
  l := project_layout(w, h, 2, g[0].w[..]);
  // a click on the second row, then closed: the keys start there
  #assert tap(g[..], mid_x(vw.hit_box[1]), mid_y(vw.hit_box[1]), 0);
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ESCAPE, 0) && g[0].s[0].open == 0;
  // the keys: down picks the first shown, down again the next, Enter opens, Esc closes
  // (the first press shows the keys where the last click left them: the second row)
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].pick == vw.hit_row[1] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].pick == vw.hit_row[2] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_UP, 0) && coaxial_project_key(g[0].s[..], g[0].w[..], KEY_UP, 0);
  #assert g[0].s[0].pick == vw.hit_row[0] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ENTER, 0) && g[0].s[0].open == vw.hit_row[0] + 1;
  // with it open, down opens the next
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_DOWN, 0) && g[0].s[0].open == vw.hit_row[1] + 1;
  // a fresh page: down picks the first row shown
  f: [1] Page;
  _ = draw_page(f[..], out[..], w, h);
  #assert coaxial_project_key(f[0].s[..], f[0].w[..], KEY_DOWN, 0) && f[0].s[0].pick == vw.hit_row[0] + 1;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_ESCAPE, 0) && g[0].s[0].open == 0;
  #assert !coaxial_project_key(g[0].s[..], g[0].w[..], 'c', 8);   // the browser's keys stay the browser's
  // the hash opens a task straight away, and an empty one closes it
  alias := item(g[0].w[..], g[0].w[0].text, vw.hit_row[2], 0);
  n := put_text(g[0].l[0].inbox[..], 0, "#");
  n += put_text(g[0].l[0].inbox[..], n, alias);
  coaxial_project_hash(g[0].s[..], g[0].l[..], n);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].open == vw.hit_row[2] + 1;
  coaxial_project_hash(g[0].s[..], g[0].l[..], 0);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].open == 0;
  // the demo's placeholder queue opens nothing
  d: [1] Page;
  d[0].s[0].page = 1;
  _ = draw_page(d[..], out[..], w, h);
  #assert !tap(d[..], mid_x(l.queue), mid_y(l.queue), 0) && d[0].s[0].open == 0;
}
same_box :: (a: Box, b: Box) -> bool { return a.x0 == b.x0 && a.y0 == b.y0 && a.x1 == b.x1 && a.y1 == b.y1; }

// The tasks worth drawing: the one with the longest body, the one with the
// most notes, and the first in progress (its plan), as rows.
samples :: (w: [] Work, pick: [] int) -> int {
  long := -1; most := 0; chatty := -1; notes := 0;
  for r: 0..<w[0].n {
    if w[0].kind[r] != KIND_TASK { continue; }
    k := detail_of(w, r);
    if cell(COAX_WORK_DETAILS, k, 3).count > most { most = cell(COAX_WORK_DETAILS, k, 3).count; long = r; }
    if cell(COAX_WORK_DETAILS, k, 5).count > notes { notes = cell(COAX_WORK_DETAILS, k, 5).count; chatty = r; }
  }
  n := 0;
  if long >= 0 { pick[n] = long; n += 1; }
  if chatty >= 0 && chatty != long { pick[n] = chatty; n += 1; }
  if w[0].working_n > 0 && w[0].queue[0] != long && w[0].queue[0] != chatty { pick[n] = w[0].queue[0]; n += 1; }
  return n;
}

detail_fits :: (size_w: f32, size_h: f32, most: int) -> bool {
  out: [PAGE_OUT] f32;
  w := size_w * 2; h := size_h * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  l := project_layout(w, h, 2, g[0].w[..]);
  db := detail_box(l, w, h, 2);
  pick: [3] int;
  for i: 0..<lo_int(most, samples(g[0].w[..], pick[..])) {
    open_task(g[0].s[..], g[0].w[..], pick[i]);
    for end: 0..<2 {
      // drawn at its top, then scrolled to its end
      if end == 1 { g[0].s[0].scroll = g[0].s[0].scroll_max; }
      n := draw_page(g[..], out[..], w, h);
      if n < 300 || n >= MAX_VERTICES || n % 6 != 0 || !on_canvas(out[..], n, w, h, 2) { return false; }
      // below the wide layout the detail is the screen: all that's drawn
      if !l.wide && !within(out[..], 0, n, db, 2) { return false; }
      if l.wide && !same_box(g[0].s[0].panel, l.scene) { return false; }
    }
  }
  return true;
}

#test "a task's detail draws inside its panel within the vertex budget, scrolled or not: desktop" {
  #assert detail_fits(1440, 900, 2);
}
#test "a task's detail draws inside its panel within the vertex budget, scrolled or not: tablet and phone" {
  #assert detail_fits(768, 1024, 3) && detail_fits(320, 568, 3);
}

#test "a long body scrolls with the wheel, a drag and the keys; a blocker's alias opens it" {
  out: [PAGE_OUT] f32;
  w := 320.0f32 * 2; h := 568.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  // the task with the longest body, and one that waits on another
  long := -1; most := 0; waiting := -1;
  for r: 0..<g[0].w[0].n {
    if g[0].w[0].kind[r] != KIND_TASK { continue; }
    k := detail_of(g[0].w[..], r);
    if cell(COAX_WORK_DETAILS, k, 3).count > most { most = cell(COAX_WORK_DETAILS, k, 3).count; long = r; }
    if waiting < 0 && g[0].w[0].waits[r] >= 0 { waiting = r; }
  }
  #assert long >= 0 && waiting >= 0;
  open_task(g[0].s[..], g[0].w[..], long);
  _ = draw_page(g[..], out[..], w, h);
  #assert g[0].s[0].scroll_max > 0 && g[0].w[0].view.hit_n == 0;   // full screen: no rows under it
  coaxial_project_wheel(g[0].s[..], 100);
  #assert g[0].s[0].scroll == 200;
  coaxial_project_wheel(g[0].s[..], -1000);
  #assert g[0].s[0].scroll == 0;
  coaxial_project_wheel(g[0].s[..], 1000000);
  #assert g[0].s[0].scroll == g[0].s[0].scroll_max;
  #assert coaxial_project_key(g[0].s[..], g[0].w[..], KEY_HOME, 0) && g[0].s[0].scroll == 0;
  // a finger drags it up
  p := g[0].s[0].panel;
  poke(g[..], mid_x(p), p.y1 - 100, POINTER_DOWN, 1);
  poke(g[..], mid_x(p), p.y1 - 400, POINTER_MOVE, 1);
  #assert g[0].s[0].scroll == hi(0, lo(300, g[0].s[0].scroll_max));
  poke(g[..], mid_x(p), p.y1 - 400, POINTER_UP, 1);
  #assert g[0].s[0].open == long + 1;   // a drag doesn't close it
  // the blocker's alias is a link to its own detail
  open_task(g[0].s[..], g[0].w[..], waiting);
  _ = draw_page(g[..], out[..], w, h);
  blocker := g[0].w[0].waits[waiting];
  found := -1;
  for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] == blocker { found = k; } }
  if found < 0 {
    // below the fold: scroll till it shows
    for step: 0..<40 {
      if found >= 0 { break; }
      coaxial_project_wheel(g[0].s[..], 200);
      _ = draw_page(g[..], out[..], w, h);
      for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] == blocker { found = k; } }
    }
  }
  #assert found >= 0;
  lb := g[0].s[0].link_box[found];
  #assert tap(g[..], mid_x(lb), mid_y(lb), 1) && g[0].s[0].open == blocker + 1 && g[0].s[0].scroll == 0;
  // and the phone's CLOSE closes it
  _ = draw_page(g[..], out[..], w, h);
  c := g[0].s[0].close;
  #assert tap(g[..], mid_x(c), mid_y(c), 1) && g[0].s[0].open == 0;
}

#test "another project's open need keeps a task waiting; a resolved or closed one doesn't" {
  w: [1] Work;
  w[0].links = "c1|needs|verse|d981|open|The galaxy\ne1|needs|verse|abcd|resolved|Done\ne1|needs|verse|abce|closed|Closed\nf1|by|planetary-villa|a3b5|open|Wants f\n";
  read_work(w[..], FIXTURE);
  // c1 was ready (its blocker b1 is done): now it waits on Verse's d981; e1's needs are done
  #assert !w[0].ready[3] && w[0].far[3] == 0 && w[0].waits[3] == -1;
  #assert w[0].ready[5] && w[0].far[5] == -1 && w[0].far[6] == -1;
  #assert w[0].ready_n == 1;
  // a page with no links is as it was
  e: [1] Work;
  read_work(e[..], FIXTURE);
  #assert e[0].ready[3] && e[0].far[3] == -1 && e[0].ready_n == 2;
  buf: [32] u8;
  n := put_project(buf[..], 0, "planetary-villa");
  #assert same(cast(string) buf[0..<n], "PLANETARY VILLA") && same(far_label("missing"), "NOT FOUND") && !link_open("resolved") && link_open("missing");
}

#test "a task's detail lists what it needs from other projects and who needs it, and each opens that project's page on it" {
  out: [PAGE_OUT] f32;
  w := 1440.0f32 * 2; h := 900.0f32 * 2;
  g: [1] Page;
  _ := draw_page(g[..], out[..], w, h);
  // two tasks: one needs Verse's #d981 (and a done one), the other is needed by Planetary Villa's #a3b5
  a := -1; b := -1;
  for r: 0..<g[0].w[0].n {
    if g[0].w[0].kind[r] != KIND_TASK || finished(g[0].w[..], r) || g[0].w[0].waits[r] >= 0 { continue; }
    if a < 0 { a = r; } else if b < 0 { b = r; }
  }
  #assert a >= 0 && b >= 0;
  lb: [256] u8;
  m := put_text(lb[..], 0, item(g[0].w[..], g[0].w[0].text, a, 0)); m += put_text(lb[..], m, "|needs|verse|d981|open|The galaxy\n");
  m += put_text(lb[..], m, item(g[0].w[..], g[0].w[0].text, a, 0)); m += put_text(lb[..], m, "|needs|verse|abcd|resolved|Done one\n");
  m += put_text(lb[..], m, item(g[0].w[..], g[0].w[0].text, b, 0)); m += put_text(lb[..], m, "|by|planetary-villa|a3b5|open|Wants it\n");
  g[0].w[0].links = cast(string) lb[0..<m];
  read_work(g[0].w[..], g[0].w[0].text);
  #assert !g[0].w[0].ready[a] && g[0].w[0].far[a] >= 0;
  // the queue says what it waits on, and draws inside its panel
  n := draw_page(g[..], out[..], w, h);
  #assert n > 3000 && n <= MAX_VERTICES;
  wanted := [2] string.["/projects/verse#d981", "/projects/planetary-villa#a3b5"];
  picks := [2] int.[a, b];
  for i: 0..<2 {
    open_task(g[0].s[..], g[0].w[..], picks[i]);
    found := -1;
    for step: 0..<40 {
      _ = draw_page(g[..], out[..], w, h);
      for k: 0..<g[0].s[0].link_n { if found < 0 && g[0].s[0].link_row[k] <= -2 { found = k; } }
      if found >= 0 { break; }
      coaxial_project_wheel(g[0].s[..], 200);
    }
    #assert found >= 0;
    // a needs two: both drawn, the open one first
    if i == 0 {
      far := 0;
      for k: 0..<g[0].s[0].link_n { if g[0].s[0].link_row[k] <= -2 { far += 1; } }
      #assert far == 2;
    }
    lk := g[0].s[0].link_box[found];
    #assert tap(g[..], mid_x(lk), mid_y(lk), 0) && g[0].s[0].action == ACT_NAVIGATE;
    #assert same(cast(string) g[0].s[0].outbox[0..<g[0].s[0].out_n], wanted[i]);
    g[0].s[0].action = 0;
  }
}

page_says :: (lv: [] Live, text: string) {
  for i: 0..<text.count { lv[0].inbox[i] = text[i]; }
  coaxial_project_message(lv, MSG_PAGE_TEXT, text.count);
}

#test "a page names its project, paints what was baked, and draws the relay's fold from the last EOSE on" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  uniforms: [UNIFORM_FLOATS] f32;
  s: [1] ProjectState; t: [1] Tree; w: [1] Work; lv: [1] Live;
  page_says(lv[..], "9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575 coax");
  n := coaxial_project_frame(s[..], t[..], w[..], lv[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 3000 && w[0].baked == 0 && w[0].live == LIVE_CONNECTING && same(w[0].text, COAX_WORK_ITEMS) && t[0].n == (ifx COAX_COMMITS < MAX_COMMITS then COAX_COMMITS else MAX_COMMITS);
  #assert lv[0].pipe[0].n == 1 && same(pipe_bytes(lv[0].pipe[..], 0), COAX_WORK_RELAY);
  pipe_drained(lv[0].pipe[..]);
  coaxial_project_opened(lv[..], 0);
  fake_message(lv[..], 0, SOCKET_OPENED, "");
  feed_transcript(lv[..], 0, COAX_RELAY);
  #assert lv[0].state == LIVE_SYNCING && !lv[0].dirty;
  finish_fixture_backfill(lv[..], 0);
  n = coaxial_project_frame(s[..], t[..], w[..], lv[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  // This historical capture is older than the current baked queue. Missing
  // immutable roots must retain the full snapshot, never shrink it to the
  // old fixture just because its watches sent EOSE.
  #assert n > 3000 && w[0].live == LIVE_OFFLINE && lv[0].folds == 0;
  #assert same(w[0].text, COAX_WORK_ITEMS) && same(w[0].details, COAX_WORK_DETAILS);
  #assert same(w[0].name, "Coax") && same(w[0].license, "Apache-2.0") && same(w[0].path, "coax/");
  // another baked project, and one this build doesn't know
  s2: [1] ProjectState; t2: [1] Tree; w2: [1] Work; l2: [1] Live;
  page_says(l2[..], "951b70f9fa97d8214e0c9f3ff392a1dd1668e61561ef21a2a69168d382452e18 verse");
  n = coaxial_project_frame(s2[..], t2[..], w2[..], l2[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 3000 && w2[0].baked == baked_index("verse") && w2[0].baked > 0 && same(w2[0].name, "Verse") && same(w2[0].text, VERSE_WORK_ITEMS);
  s3: [1] ProjectState; t3: [1] Tree; w3: [1] Work; l3: [1] Live;
  page_says(l3[..], "1111111111111111111111111111111111111111111111111111111111111111 elsewhere");
  n = coaxial_project_frame(s3[..], t3[..], w3[..], l3[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert n > 1000 && w3[0].baked == -1 && same(w3[0].name, "elsewhere") && t3[0].n == 0 && l3[0].pipe[0].n == 1;
  // a page that names nothing is Coax's
  s4: [1] ProjectState; t4: [1] Tree; w4: [1] Work; l4: [1] Live;
  n = coaxial_project_frame(s4[..], t4[..], w4[..], l4[..], out[..], uniforms[..], 640, 900, 1, 0.016, true);
  #assert w4[0].baked == 0 && same(live_slug(l4[..]), "coax");
}

#test "all 320 physical rows fit the private Work parser" {
  w:[1]Work;bytes:[320]u8;
  for i:0..<bytes.count {bytes[i]='\n';}
  read_work(w[..],cast(string)bytes[..]);
  #assert w[0].n==320 && w[0].tasks==320 && w[0].queued==320;
}
