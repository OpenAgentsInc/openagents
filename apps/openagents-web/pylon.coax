// A read-only Pylon board. Coax owns layout, sockets and projection. The
// private C effects bridge runs the same immutable event through the shared
// Coax verifier before delivering admitted beacon bytes or activity here.
#load "splash.coax";
#load "../../verse/hud.coax";
#load "../../coax/lib/nostr/json.coax";
#load "socket.coax";
#load "pylon-policy.coax";
#load "connect-pylon-content.coax";
PL_MAX :: 64;
PL_JOIN :: CP_JOIN;
PL_REQ :: "[\"REQ\",\"pylons\",{\"kinds\":[30200],\"limit\":200},{\"kinds\":[26910,27010],\"since\":";
PlRow :: struct {
  key:[64]u8;slug:[64]u8;slug_n:int;label:[64]u8;label_n:int;model:[128]u8;model_n:int;
  npub:[63]u8;npub_n:int;status:[16]u8;status_n:int;generation:int;observed:int;until:int;free:int;total:int;
  answers:int;statuses:int;
}
Pylon :: struct {
  pipe:[1]Pipe;socket:int;connection:int;started:bool;epoch:int;opened:int;time:f32;retry:f32;
  inbox:[270336]u8;pending_from:int;pending_n:int;pending_kind:int;
  rows:[PL_MAX]PlRow;count:int;capacity:bool;refused:int;ids:[4096]u8;seen:int;answers:int;statuses:int;full:bool;
  width:f32;height:f32;dpr:f32;scroll:f32;scroll_max:f32;down_y:f32;drag_y:f32;dragged:bool;down:bool;pressed:int;
  action:int;route:[1024]u8;route_n:int;copied:bool;
}
// Top-level field spans retain their original JSON until copied. Admission
// happened already; these helpers only project bounded presentation fields.
pl_field :: (text:string,key:string)->string {
  j:[1]Json;json_start(j[..],text);if json_next(j[..])!=JSON_OBJECT {return "";}
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END || t==JSON_END || t==JSON_ERROR {return "";}
    if t!=JSON_STRING || !j[0].key {return "";}match:=json_is(json_text(j[..]),key);t=json_next(j[..]);a:=j[0].from;
    if t==JSON_STRING {if match {return json_text(j[..]);}}
    else {if t==JSON_OBJECT || t==JSON_ARRAY {_:=json_skip(j[..]);if match {return text[a..<j[0].at];}}else if match {return json_text(j[..]);}}
  }return "";
}
pl_number :: (text:string)->int {j:[1]Json;json_start(j[..],text);if json_next(j[..])!=JSON_NUMBER {return 0;}return json_int(json_text(j[..])).value;}
pl_provider :: (text:string)->string #export_c {return pl_field(text,"provider");}
pl_copy :: (out:[]u8,text:string)->int #export_c {
  n:=json_unescape(text,out);return ifx n<0 then 0 else n;
}
pl_now :: (p:[]Pylon)->int #export_c {return p[0].epoch+cast(int)p[0].time;}
pl_row_key :: (r:[]PlRow)->string {return cast(string)r[0].key[..];}
// This same full admitted identity is drawn and exposed to observation
// tools: preserve the model, algorithm and digest exactly as advertised.
pl_display_identity :: (p:[]Pylon,i:int)->string #export_c {
  if i<0 || i>=p[0].count {return "";}
  return cast(string)p[0].rows[i].model[0..<p[0].rows[i].model_n];
}
pl_observed :: (p:[]Pylon,content:string,npub:string) #export_c {
  key:=pl_field(content,"provider");slug:=pl_field(content,"pylon");
  generation:=pl_number(pl_field(content,"generation"));observed:=pl_number(pl_field(content,"observed_at"));
  at:=p[0].count;for i:0..<p[0].count {if cast(string)p[0].rows[i].key[..]==key && cast(string)p[0].rows[i].slug[0..<p[0].rows[i].slug_n]==slug {at=i;}}
  if at<p[0].count && !pl_newer(generation,observed,p[0].rows[at].generation,p[0].rows[at].observed) {return;}
  if at>=PL_MAX {p[0].capacity=true;return;}
  if key.count!=64 || slug.count>64 {return;}
  if at==p[0].count {p[0].count+=1;}
  r:=p[0].rows[at..<at+1];for i:0..<64 {r[0].key[i]=key[i];}
  r[0].slug_n=pl_copy(r[0].slug[..],slug);r[0].label_n=pl_copy(r[0].label[..],pl_field(content,"label"));
  r[0].npub_n=pl_copy(r[0].npub[..],npub);r[0].generation=generation;r[0].observed=observed;
  r[0].until=pl_number(pl_field(content,"valid_until"));r[0].status_n=pl_copy(r[0].status[..],pl_field(content,"status"));
  slots:=pl_field(content,"slots");r[0].free=pl_number(pl_field(slots,"free"));r[0].total=pl_number(pl_field(slots,"total"));
  services:=pl_field(content,"services");j:[1]Json;json_start(j[..],services);begin:=json_next(j[..]);t:=json_next(j[..]);
  if t==JSON_OBJECT {a:=j[0].from;_:=json_skip(j[..]);r[0].model_n=pl_copy(r[0].model[..],pl_field(services[a..<j[0].at],"model"));}
}
// Called only after lr_verify_public on the identical original. No public
// Wasm export accepts a verified bit, key, count, or replacement row.
pl_activity :: (p:[]Pylon,text:string) #export_c {
  key:=pl_field(text,"pubkey");id:=pl_field(text,"id");kind:=pl_number(pl_field(text,"kind"));created:=pl_number(pl_field(text,"created_at"));
  if (kind!=26910 && kind!=27010) || id.count!=64 || !pl_live_time(created,p[0].opened,pl_now(p)) {return;}
  found:=false;for i:0..<p[0].count {if cast(string)p[0].rows[i].key[..]==key {found=true;}}
  if !found {return;}for i:0..<p[0].seen {if cast(string)p[0].ids[i*64..<i*64+64]==id {return;}}
  // Freeze, rather than silently forget deduplication, when the bounded
  // live window fills. Reload starts a new explicitly labelled session.
  if p[0].seen>=64 {p[0].full=true;return;}for i:0..<64 {p[0].ids[p[0].seen*64+i]=id[i];}p[0].seen+=1;
  if kind==26910 {p[0].answers+=1;}else {p[0].statuses+=1;}
  for i:0..<p[0].count {if cast(string)p[0].rows[i].key[..]==key {if kind==26910 {p[0].rows[i].answers+=1;}else {p[0].rows[i].statuses+=1;}}}
}
pl_receive :: (p:[]Pylon,kind:int,n:int)->int #export_c {
  p[0].pending_kind=0;if n<0 || n>p[0].inbox.count {return 0;}text:=cast(string)p[0].inbox[0..<n];
  if kind==600 && !p[0].started {
    p[0].epoch=cast(int)(fact_num(fact_of(text,"now"))/1000);p[0].opened=p[0].epoch;p[0].started=true;p[0].socket= -1;
    _:=pipe_open(p[0].pipe[..],"wss://relay.openagents.com");return 0;
  }
  e:=socket_event(kind);if e.id!=p[0].socket {return 0;}
  if e.event==SOCKET_OPENED {
    p[0].connection=1;out:[256]u8;a:=json_raw(out[..],0,PL_REQ);a=json_write_int(out[..],a,p[0].opened);a=json_raw(out[..],a,"}]");
    _:=pipe_send(p[0].pipe[..],e.id,cast(string)out[0..<a]);return 0;
  }
  if e.event==SOCKET_CLOSED || e.event==SOCKET_ERROR {p[0].connection= -1;p[0].retry=3;return 0;}
  if e.event!=SOCKET_FRAME || !json_valid(text) {return 0;}
  j:[1]Json;json_start(j[..],text);if json_next(j[..])!=JSON_ARRAY || json_next(j[..])!=JSON_STRING {return 0;}
  command:=json_text(j[..]);if json_is(command,"CLOSED") {p[0].connection= -2;return 0;}
  if !json_is(command,"EVENT") || json_next(j[..])!=JSON_STRING || !json_is(json_text(j[..]),"pylons") || json_next(j[..])!=JSON_OBJECT {return 0;}
  a:=j[0].from;_:=json_skip(j[..]);b:=j[0].at;if json_next(j[..])!=JSON_ARRAY_END || json_next(j[..])!=JSON_END {return 0;}
  p[0].pending_from=a;p[0].pending_n=b-a;p[0].pending_kind=pl_number(pl_field(text[a..<b],"kind"));return p[0].pending_kind;
}
pl_button :: (p:[]Pylon,i:int)->Box {d:=p[0].dpr;return Box.{x0=(24+cast(f32)i*150)*d,y0=188*d,x1=(164+cast(f32)i*150)*d,y1=230*d};}
pl_route :: (p:[]Pylon,text:string,action:int) {p[0].route_n=0;for i:0..<text.count {p[0].route[i]=text[i];}p[0].route_n=text.count;p[0].action=action;}
pl_pointer :: (p:[]Pylon,x:f32,y:f32,phase:int)->bool #export_c {
  if phase==POINTER_CANCEL {p[0].down=false;return false;}
  if phase==0 {p[0].down=true;p[0].down_y=y;p[0].drag_y=y;p[0].dragged=false;p[0].pressed= -1;for i:0..<2 {if inside(pl_button(p,i),x,y) {p[0].pressed=i;}}return true;}
  if phase==1 && p[0].down {if abs(y-p[0].down_y)>6*p[0].dpr {p[0].dragged=true;}if p[0].dragged {p[0].scroll=clamp(p[0].scroll+(p[0].drag_y-y)/p[0].dpr,0,p[0].scroll_max);}p[0].drag_y=y;return true;}
  if phase==2 && p[0].down {p[0].down=false;if !p[0].dragged && p[0].pressed>=0 && inside(pl_button(p,p[0].pressed),x,y) {if p[0].pressed==0 {pl_route(p,PL_JOIN,2);p[0].copied=true;}else {pl_route(p,"/docs/connect-a-pylon",1);}}return true;}return false;
}
pl_wheel :: (p:[]Pylon,dy:f32) #export_c {p[0].scroll=clamp(p[0].scroll+dy,0,p[0].scroll_max);}
pl_text :: (out:[]f32,v:int,text:string,x:f32,y:f32,width:f32,d:f32,k:Ink)->int {
  at:=v;start:=0;line:=0;next:[1]int;k2:=k;k2.sans=true;k2.scale=d;
  while start<text.count {n:=wrap_ink(text,start,width,10*d,0.15,0.55,k2,next[..]);at=write(d,out,at,text[start..<n],x,y+cast(f32)line*18*d,10*d,0.15,0.55,k2,false,false);if next[0]<=start {break;}start=next[0];line+=1;}return at;
}
pl_text_lines :: (text:string,width:f32,d:f32,k:Ink)->int {
  start:=0;lines:=0;next:[1]int;k2:=k;k2.sans=true;k2.scale=d;
  while start<text.count {n:=wrap_ink(text,start,width,10*d,0.15,0.55,k2,next[..]);lines+=1;if next[0]<=start {break;}start=next[0];}
  return ifx lines>0 then lines else 1;
}
pl_frame :: (p:[]Pylon,out:[]f32,u:[]f32,w:f32,h:f32,d:f32,dt:f32,still:bool)->int #export_c {
  p[0].width=w;p[0].height=h;p[0].dpr=d;if dt>0 {p[0].time+=dt;}
  if p[0].connection== -1 {p[0].retry-=dt;if p[0].retry<=0 {p[0].connection=0;closed:=pipe_close(p[0].pipe[..],p[0].socket);_:=pipe_open(p[0].pipe[..],"wss://relay.openagents.com");}}
  for i:0..<16 {u[i]=0;}u[0]=w;u[1]=h;u[3]=1;u[4]=1;v:=0;
  white:=ink(0.6*d,0.95,3*d,0.95,0.95,0.95);muted:=ink(0.5*d,0.6,2*d,0.7,0.7,0.7);amber:=ink(0.6*d,0.95,3*d,1,0.62,0.16);left:=24*d;room:=w-48*d;
  v=write(d,out,v,"PYLON",left,52*d,24*d,0.4,0.7,white,false,false);
  status:=ifx still then "PYLON NETWORK" else ifx p[0].connection==1 then "LIVE RELAY" else ifx p[0].connection== -2 then "RELAY REFUSED / RELOAD" else "CONNECTING";
  v=write(d,out,v,status,left,82*d,8*d,0.2,0.6,amber,false,false);
  v=pl_text(out,v,"Lend a computer. Serve a native model.",left,116*d,room,d,white);
  v=pl_text(out,v,"Elephant / 18.8 GB / GPU required",left,153*d,room,d,muted);
  for i:0..<2 {b:=pl_button(p,i);v=hud(out,v,b,d,0,0,0.75,0.95,0.65,0.22);v=write(d,out,v,ifx i==0 then (ifx p[0].copied then "COPIED" else "COPY COMMAND") else "AGENT GUIDE",b.x0+12*d,b.y0+26*d,8*d,0.15,0.55,white,false,false);}
  now:=pl_now(p);online:=0;for i:0..<p[0].count {r:=p[0].rows[i..<i+1];if pl_current(r[0].until,now,cast(string)r[0].status[0..<r[0].status_n]) {online+=1;}}
  buf:[160]u8;n:=put_int(buf[..],0,online);n=put(buf[..],n," ONLINE     ");n=put_int(buf[..],n,p[0].answers);n=put(buf[..],n," ANSWERS     ");n=put_int(buf[..],n,p[0].statuses);n=put(buf[..],n," STATUS");
  v=write(d,out,v,cast(string)buf[0..<n],left,270*d,8*d,0.15,0.55,amber,false,false);
  v=pl_text(out,v,"Signed live activity since this page opened",left,296*d,room,d,muted);
  y:=(336-p[0].scroll)*d;first:=v;
  if p[0].count==0 {v=pl_text(out,v,"Waiting for a verified Pylon beacon",left,y+20*d,room,d,white);}
  for i:0..<p[0].count {
    r:=p[0].rows[i..<i+1];current:=pl_current(r[0].until,now,cast(string)r[0].status[0..<r[0].status_n]);tone:=ifx current then white else muted;
    identity:=pl_display_identity(p,i);extra:=18*cast(f32)(pl_text_lines(identity,room,d,tone)-1)*d;row_height:=136*d+extra;
    if y+row_height<316*d || y>h-120*d {y+=row_height;continue;}
    name:=ifx r[0].label_n>0 then cast(string)r[0].label[0..<r[0].label_n] else cast(string)r[0].slug[0..<r[0].slug_n];
    v=write(d,out,v,name,left,y+18*d,11*d,0.15,0.55,tone,false,false);
    n=put_int(buf[..],0,r[0].free);n=put(buf[..],n,"/");n=put_int(buf[..],n,r[0].total);n=put(buf[..],n," slots   ");n=put_int(buf[..],n,ifx now>=r[0].observed then now-r[0].observed else 0);n=put(buf[..],n,"s ago");if !current {n=put(buf[..],n," / offline");}
    v=pl_text(out,v,cast(string)buf[0..<n],left,y+46*d,room,d,muted);
    v=pl_text(out,v,identity,left,y+69*d,room,d,tone);
    keytone:=muted;keytone.sans=true;keytone.scale=d;
    split:=ifx r[0].npub_n>32 then 32 else r[0].npub_n;
    v=write(d,out,v,cast(string)r[0].npub[0..<split],left,y+102*d+extra,7*d,0.1,0.5,keytone,false,false);
    if r[0].npub_n>split {v=write(d,out,v,cast(string)r[0].npub[split..<r[0].npub_n],left,y+116*d+extra,7*d,0.1,0.5,keytone,false,false);}
    y+=row_height;
  }
  p[0].scroll_max=hi(0,(y+p[0].scroll*d-(h-125*d))/d);p[0].scroll=clamp(p[0].scroll,0,p[0].scroll_max);
  // Clip the scrolling table, keeping the header and limitations visible.
  for i:first..<v {at:=i*16;if out[at+1]<316*d || out[at+1]>h-120*d {out[at+6]=0;}}
  caveat:=ifx p[0].full then "64-event live window full. Reload to reset." else ifx p[0].capacity then "64-machine view full." else "Demo network / no payments / demo keys";
  v=pl_text(out,v,caveat,left,h-89*d,room,d,amber);
  v=pl_text(out,v,"Pylons read requests. No private prompts or real keys.",left,h-53*d,room,d,muted);return v;
}
#test "display projection preserves original spans and does not accept another subscription" {
  #assert pl_field("{\"x\":{\"a\":2},\"s\":\"hello\"}","x")=="{\"a\":2}";
  #assert pl_field("{\"x\":1}","missing")=="" && pl_number("31")==31;
  p:[1]Pylon;p[0].socket=0;
  sample:="[\"EVENT\",\"other\",{\"kind\":30200}]";for i:0..<sample.count {p[0].inbox[i]=sample[i];}
  #assert pl_receive(p[..],257,sample.count)==0;
  p[0].dpr=1;p[0].down=true;cancelled:=pl_pointer(p[..],40,200,POINTER_CANCEL);#assert !cancelled && !p[0].down;
}
