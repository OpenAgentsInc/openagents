// A Verse realm on the web, drawn by Coax: openagents.com/realm/haunted-house
// first. The world is the Verse engine's own code, unchanged from the iOS app:
// verse/haunt.coax plays the Haunted House, player.coax walks you through
// it and grid.coax reads a phone's thumbs, and realm-face.c binds them for
// the browser as HauntViewController.swift does on the phone. This file is
// everything on the screen over the world and what you do with it: the HUD
// (the room you're in, the quest, a notice, who or what is near, a
// conversation, the map, the hotbar, edit mode and the survey box), the controls (keys and a mouse drag on
// a desktop, two thumbs on a phone) and what a press on the HUD does. The
// face reads this file's intent each frame and hands back what the house
// says (RealmView).
//
// Every panel and button is a plate (plate below): a dark wood fill with one
// thin bronze line round it and rounded corners, drawn behind by realm.wgsl
// (plate), its words parchment and bronze in Filament (font.coax). The
// projects pages keep the HUD bar; the house has this, plainer, look.

#load "font.coax";
#load "ui.coax";
#load "analytics.coax";
#load "save.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, a HUD bar's press and flash, 0, 0
MAX_VERTICES :: 36000;
PLATES :: 28;   // the most plates (panels and buttons) one frame shows
// width, height, time, fade, still, panels, dpr, 0; the view matrix's four
// rows; the eye and the light count; the flash, 0, 0, 0; then per panel
// x0, y0, x1, y1, scale, alpha, look (plate: LOOK_*), 0. The face writes the view, the eye,
// the lights and the flash (verse_grid_view, verse_haunt_lights).
PANEL_AT :: 32;
UNIFORM_FLOATS :: PANEL_AT + PLATES * 8;

MODE_STROKE :: 0.0;    // a sharp core in a soft glow: words, rings
MODE_LINK :: 1.0;
MODE_PULSE :: 2.0;
MODE_GLOW_TEXT :: 3.0;
MODE_BAR :: 4.0;       // a Verse HUD bar (ui.coax bar)

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow, as splash.coax draws one.
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// A round light (a dot with a glow), as graph.coax draws a node.
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// ---- what the house says this frame (realm-face.c fills it)

MAP_MAX :: 66;   // verse_haunt_map's boxes: rooms, you and the people
ITEMS :: 5;      // edit mode's hotbar: short names (the face's), so a phone fits them
QUEST_STEPS :: 8;
TYPED_MAX :: 480;  // the survey's answer, in bytes

RealmView :: struct {
  ready: bool;          // the house is open and drawing
  failed: bool;         // it couldn't be loaded
  loaded: f32;          // 0 to 1: how much of it has arrived
  title: string;        // the room you're in
  quest: int;           // the quest's step, 0 to 8 (8: complete)
  quest_line: string;   // what to do now
  goal: string;         // at the quest's orb: what E does there ("" not at it)
  bearing: f32;         // the orb's angle from where you look, radians (sign: the side)
  editing: bool;        // edit mode
  items: [ITEMS] string; item_n: int;   // what edit mode's hotbar places, slot 1 up
  selected: string;     // in edit mode, the thing picked ("" none)
  person: bool;         // it is a character
  mind: string;         // then what they do: STAYS, FOLLOWS, WANDERS, GUARDS, FLEES
  zone: string;         // in edit mode with nothing picked, the zone nearest ("" none)
  zone_once: bool;      // it goes off once
  can_undo: bool; can_redo: bool;
  notice: string;       // the house's notice, while it lasts
  target: string;       // who or what E acts on: a person's name, "Door", or ""
  talking: string;      // the person you're talking to ("" none)
  reply: string;        // what they said
  // the move stick (grid.coax Sticks), where a thumb is down
  move_on: bool; ox: f32; oy: f32; pad_x: f32; pad_y: f32;
  // the map (verse_haunt_map, in the map box's pixels): x, y, width, height, kind
  map_n: int; map: [MAP_MAX * 5] f32;
}

// ---- the controls and the HUD

// Keys held, a bit each.
HOLD_FORWARD :: 1; HOLD_BACK :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8;
HOLD_RUN :: 16; HOLD_JUMP :: 32; HOLD_USE :: 64; HOLD_VIEW :: 128; HOLD_MAP :: 256; HOLD_EDIT :: 512; HOLD_PLACE :: 1024;
KEY_SHIFT :: -13;      // host.js names Shift, so a run starts while a key is already down

// What the face is asked to do, a bit each, until it takes them.
ASK_USE :: 1;          // open the door or talk to whoever is near
ASK_VIEW :: 2;         // the next camera
ASK_HINT :: 4;         // ask the person you're talking to for a hint
ASK_BYE :: 8;          // end the conversation
ASK_EXIT :: 16;        // leave (the outbox has where to)
ASK_GOAL :: 32;        // do the quest's step at its orb
ASK_SEND :: 64;        // send the survey's answer (typed)
ASK_EDIT :: 128;       // into or out of edit mode
ASK_PLACE :: 256;      // place edit mode's item `slot` in front of you
ASK_PICK :: 512;       // pick what's under (pick_x, pick_y)
ASK_OP :: 1024;        // an edit, `op` (OP_*)

// Edits (ASK_OP): to the picked thing, to the nearest zone, and undo.
OP_LEFT :: 0; OP_RIGHT :: 1; OP_AWAY :: 2; OP_NEAR :: 3; OP_TURN :: 4; OP_BIGGER :: 5; OP_SMALLER :: 6; OP_DELETE :: 7;
OP_ZONE_BIGGER :: 8; OP_ZONE_SMALLER :: 9; OP_ZONE_ONCE :: 10; OP_ZONE_RESET :: 11;
OP_UNDO :: 12; OP_REDO :: 13; OP_DROP :: 14;   // OP_DROP: let go of the picked thing
OP_MIND :: 15; OP_HERE :: 16;                  // a character: what they do next, come to where you look
OP_ZONE_LEFT :: 17; OP_ZONE_RIGHT :: 18; OP_ZONE_AWAY :: 19; OP_ZONE_NEAR :: 20;

// The buttons, drawn and hit in this order.
BTN_USE :: 0; BTN_VIEW :: 1; BTN_MAP :: 2; BTN_EXIT :: 3; BTN_HINT :: 4; BTN_BYE :: 5;
BTN_SEND :: 6; BTN_CANCEL :: 7; BTN_EDIT :: 8; BTN_UNDO :: 9; BTN_REDO :: 10;
BTN_ITEM :: 11;                        // then one per item
BTN_OP :: BTN_ITEM + ITEMS;            // then the row for the picked thing or the zone: OPS of them
OPS :: 8;
BUTTONS :: BTN_OP + OPS;

HELP_TIME :: 9.0;      // seconds the controls stay written after you first move

Realm :: struct {
  time: f32; width: f32; height: f32; dpr: f32;
  held: int;            // HOLD_* bits
  touch: bool;          // the last pointer was a finger: the phone's controls show
  looking: bool; look_id: int; lx: f32; ly: f32;   // a mouse drag looking around
  dyaw: f32; dpitch: f32; zoom: f32;               // looked and zoomed since the face last read
  press: int; press_id: int;                       // the button a pointer is down on (-1 none)
  asks: int;            // ASK_* bits
  map: bool;
  moved_at: f32;        // when you first moved (-1 not yet)
  boxes: [BUTTONS] Box; shown: [BUTTONS] bool;     // where each button was last drawn
  typing: bool; typed: [TYPED_MAX] u8; typed_n: int;   // the survey box, open, and its answer
  slot: int;            // the item ASK_PLACE places
  op: int;              // the edit ASK_OP does
  pick_x: f32; pick_y: f32;              // where ASK_PICK picks, device pixels
  down_x: f32; down_y: f32; down_id: int; down_at: f32;   // a press that may be a click or tap
  outbox: [64] u8; out_n: int; action: int;        // the host's: ACT_NAVIGATE and a URL
  hover: int;           // the button the mouse is over (-1 none)
  plates: [PLATES] Box; plate_look: [PLATES] f32; plate_alpha: [PLATES] f32; plate_n: int;   // this frame's plates
}

realm_reset :: (r: [] Realm) #export_c { r[0].press = -1; r[0].press_id = -1; r[0].moved_at = -1; r[0].hover = -1; }

// The survey box: open it (the face does, at the last step's orb), what's
// typed, and closing it.
realm_ask_text :: (r: [] Realm) #export_c { r[0].typing = true; r[0].typed_n = 0; }
realm_typed :: (r: [] Realm) -> string #export_c { return cast(string) r[0].typed[0..<r[0].typed_n]; }
realm_close_text :: (r: [] Realm) #export_c { r[0].typing = false; }
realm_wants_text :: (r: [] Realm) -> bool #export_c { return r[0].typing; }
// Typed or pasted text (the host's field on a phone): printable bytes only.
realm_type :: (r: [] Realm, text: string) #export_c {
  if !r[0].typing { return; }
  for i: 0..<text.count {
    c := text[i];
    if c >= 32 && r[0].typed_n < TYPED_MAX { r[0].typed[r[0].typed_n] = c; r[0].typed_n += 1; }
  }
}
// A code point as UTF-8 into buf; returns the bytes.
utf8 :: (buf: [] u8, c: int) -> int {
  if c < 0x80 { buf[0] = cast(u8) c; return 1; }
  if c < 0x800 { buf[0] = cast(u8) (0xC0 + c / 64); buf[1] = cast(u8) (0x80 + c % 64); return 2; }
  if c < 0x10000 { buf[0] = cast(u8) (0xE0 + c / 4096); buf[1] = cast(u8) (0x80 + (c / 64) % 64); buf[2] = cast(u8) (0x80 + c % 64); return 3; }
  buf[0] = cast(u8) (0xF0 + c / 262144); buf[1] = cast(u8) (0x80 + (c / 4096) % 64); buf[2] = cast(u8) (0x80 + (c / 64) % 64); buf[3] = cast(u8) (0x80 + c % 64);
  return 4;
}
// Backspace: one whole character, however many bytes it is.
realm_unType :: (r: [] Realm) {
  while r[0].typed_n > 0 {
    r[0].typed_n -= 1;
    if r[0].typed[r[0].typed_n] & 0xC0 != 0x80 { return; }
  }
}

// Takes the asks since the last frame.
realm_take :: (r: [] Realm) -> int #export_c { a := r[0].asks; r[0].asks = 0; return a; }

// Keyboard axes: x right, y forward, -1 to 1.
realm_key_x :: (r: [] Realm) -> f32 #export_c {
  x := 0.0f32;
  if r[0].held & HOLD_RIGHT != 0 { x += 1; }
  if r[0].held & HOLD_LEFT != 0 { x -= 1; }
  return x;
}
realm_key_y :: (r: [] Realm) -> f32 #export_c {
  y := 0.0f32;
  if r[0].held & HOLD_FORWARD != 0 { y += 1; }
  if r[0].held & HOLD_BACK != 0 { y -= 1; }
  return y;
}

// Which held bit a key is (0: none). Letters either case.
hold_of :: (key: int) -> int {
  if key == 'w' || key == 'W' || key == KEY_UP { return HOLD_FORWARD; }
  if key == 's' || key == 'S' || key == KEY_DOWN { return HOLD_BACK; }
  if key == 'a' || key == 'A' || key == KEY_LEFT { return HOLD_LEFT; }
  if key == 'd' || key == 'D' || key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_SHIFT { return HOLD_RUN; }
  if key == ' ' { return HOLD_JUMP; }
  if key == 'e' || key == 'E' || key == KEY_ENTER { return HOLD_USE; }
  if key == 'v' || key == 'V' { return HOLD_VIEW; }
  if key == 'm' || key == 'M' { return HOLD_MAP; }
  if key == 'b' || key == 'B' { return HOLD_EDIT; }
  return 0;
}

// What a button does when pressed (a key or a click).
realm_do :: (r: [] Realm, v: RealmView, b: int) {
  if b == BTN_USE { r[0].asks |= ifx v.target.count > 0 then ASK_USE else ASK_GOAL; }
  if b == BTN_HINT { r[0].asks |= ASK_HINT; }
  if b == BTN_BYE { r[0].asks |= ASK_BYE; }
  if b == BTN_VIEW { r[0].asks |= ASK_VIEW; }
  if b == BTN_MAP { r[0].map = !r[0].map; }
  if b == BTN_EDIT { r[0].asks |= ASK_EDIT; }
  if b == BTN_SEND && r[0].typed_n > 0 { r[0].asks |= ASK_SEND; }
  if b == BTN_CANCEL { r[0].typing = false; }
  if b >= BTN_ITEM && b < BTN_ITEM + v.item_n { r[0].slot = b - BTN_ITEM; r[0].asks |= ASK_PLACE; }
  if b == BTN_UNDO { edit_op(r, OP_UNDO); }
  if b == BTN_REDO { edit_op(r, OP_REDO); }
  if b >= BTN_OP && b < BTN_OP + OPS {
    k := b - BTN_OP;
    if v.selected.count > 0 { edit_op(r, row_op(v, k)); }
    else if v.zone.count > 0 { edit_op(r, row_op(v, k)); }
  }
  if b == BTN_EXIT {
    r[0].asks |= ASK_EXIT;
    r[0].out_n = put(r[0].outbox[..], 0, "/");
    r[0].action = ACT_NAVIGATE;
  }
}

edit_op :: (r: [] Realm, op: int) { r[0].op = op; r[0].asks |= ASK_OP; }

// The edit button k of the row does: a thing's, a character's or the zone's.
row_op :: (v: RealmView, k: int) -> int {
  if v.selected.count == 0 { return ifx k < 4 then OP_ZONE_LEFT + k else OP_ZONE_BIGGER + k - 4; }
  if !v.person || k < 5 { return k; }
  return ifx k == 5 then OP_MIND else ifx k == 6 then OP_HERE else OP_DELETE;
}

// Edit mode's keys for the picked thing: arrows move it (from where you
// look), R turns it, + and - resize it, Delete or Backspace removes it; Z
// undoes and Y redoes any edit. Returns the edit, or -1.
edit_key :: (v: RealmView, key: int) -> int {
  if key == 'z' || key == 'Z' { return OP_UNDO; }
  if key == 'y' || key == 'Y' { return OP_REDO; }
  if v.selected.count == 0 && v.zone.count > 0 {
    if key == KEY_LEFT { return OP_ZONE_LEFT; }
    if key == KEY_RIGHT { return OP_ZONE_RIGHT; }
    if key == KEY_UP { return OP_ZONE_AWAY; }
    if key == KEY_DOWN { return OP_ZONE_NEAR; }
    if key == '+' || key == '=' { return OP_ZONE_BIGGER; }
    if key == '-' || key == '_' { return OP_ZONE_SMALLER; }
  }
  if v.selected.count == 0 { return -1; }
  if key == KEY_LEFT { return OP_LEFT; }
  if key == KEY_RIGHT { return OP_RIGHT; }
  if key == KEY_UP { return OP_AWAY; }
  if key == KEY_DOWN { return OP_NEAR; }
  if key == 'r' || key == 'R' { return OP_TURN; }
  if key == '+' || key == '=' { return OP_BIGGER; }
  if key == '-' || key == '_' { return OP_SMALLER; }
  if key == KEY_DELETE || key == KEY_BACKSPACE { return OP_DELETE; }
  return -1;
}

// A key down (down) or up. Returns whether it was used. A key held down
// repeats; only its first press acts.
realm_key :: (r: [] Realm, v: RealmView, key: int, mods: int, down: bool) -> bool #export_c {
  if (mods & (MOD_CTRL | MOD_META)) != 0 && down { return false; }
  // The survey box takes every key while it's open.
  if r[0].typing {
    if !down { return true; }
    if key == KEY_ESCAPE { realm_do(r, v, BTN_CANCEL); }
    else if key == KEY_ENTER { realm_do(r, v, BTN_SEND); }
    else if key == KEY_BACKSPACE { realm_unType(r); }
    else if key >= 32 && key < 0x110000 { buf: [4] u8; n := utf8(buf[..], key); realm_type(r, cast(string) buf[0..<n]); }
    return true;
  }
  bit := hold_of(key);
  if !down {
    if key >= '1' && key <= '9' { r[0].held = r[0].held & (0x7fffffff - HOLD_PLACE); }
    if bit == 0 { return false; }
    r[0].held = r[0].held & (0x7fffffff - bit);
    return true;
  }
  if key == KEY_ESCAPE {
    if v.talking.count > 0 { realm_do(r, v, BTN_BYE); return true; }
    if r[0].map { r[0].map = false; return true; }
    if v.editing && v.selected.count > 0 { edit_op(r, OP_DROP); return true; }
    if v.editing { realm_do(r, v, BTN_EDIT); return true; }
    return false;
  }
  if v.editing {
    op := edit_key(v, key);
    if op >= 0 { edit_op(r, op); return true; }
  }
  // Edit mode's hotbar: 1 to 9 place its items.
  if v.editing && key >= '1' && key < '1' + v.item_n {
    if r[0].held & HOLD_PLACE == 0 { realm_do(r, v, BTN_ITEM + (key - '1')); }
    r[0].held |= HOLD_PLACE;
    return true;
  }
  if bit == 0 { return false; }
  first := r[0].held & bit == 0;
  r[0].held |= bit;
  if (mods & MOD_SHIFT) != 0 { r[0].held |= HOLD_RUN; }
  if bit & (HOLD_FORWARD | HOLD_BACK | HOLD_LEFT | HOLD_RIGHT) != 0 { realm_moved(r); }
  if !first { return true; }
  if bit == HOLD_USE {
    if v.talking.count > 0 { realm_do(r, v, BTN_HINT); }
    else if v.target.count > 0 { realm_do(r, v, BTN_USE); }
    else if v.goal.count > 0 { r[0].asks |= ASK_GOAL; }
  }
  if bit == HOLD_EDIT { realm_do(r, v, BTN_EDIT); }
  if bit == HOLD_VIEW { realm_do(r, v, BTN_VIEW); }
  if bit == HOLD_MAP { realm_do(r, v, BTN_MAP); }
  return true;
}

// The window lost the keyboard: nothing is held any more.
realm_blur :: (r: [] Realm) #export_c { r[0].held = 0; r[0].looking = false; r[0].press = -1; r[0].hover = -1; }

realm_moved :: (r: [] Realm) { if r[0].moved_at < 0 { r[0].moved_at = r[0].time; } }

// The button at (x, y), of those drawn last frame (-1 none).
button_at :: (r: [] Realm, x: f32, y: f32) -> int {
  slop := 6 * r[0].dpr;
  for i: 0..<BUTTONS {
    if !r[0].shown[i] { continue; }
    b := r[0].boxes[i];
    if x >= b.x0 - slop && x <= b.x1 + slop && y >= b.y0 - slop && y <= b.y1 + slop { return i; }
  }
  return -1;
}

// The pointer in device pixels: phase 0 down, 1 move, 2 up, 3 cancel; kind
// 0 a mouse, 1 a finger or pen; id the host's number for it. Returns
// whether it was used here: a finger that isn't on the HUD is the face's,
// for the thumbs (verse_sticks_world_touch).
realm_pointer :: (r: [] Realm, v: RealmView, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  r[0].hover = ifx kind == 0 && phase != POINTER_CANCEL then button_at(r, x, y) else -1;
  // In edit mode a click or a tap on the world (a short press that hardly
  // moves) picks what's under it; a drag still looks.
  if phase == POINTER_DOWN && v.editing && button_at(r, x, y) < 0 { r[0].down_x = x; r[0].down_y = y; r[0].down_id = id; r[0].down_at = r[0].time; }
  if phase == POINTER_UP && v.editing && id == r[0].down_id && r[0].down_at >= 0 && button_at(r, x, y) < 0 {
    slop := 8 * r[0].dpr;
    if abs(x - r[0].down_x) < slop && abs(y - r[0].down_y) < slop && r[0].time - r[0].down_at < 0.4 {
      r[0].pick_x = x; r[0].pick_y = y; r[0].asks |= ASK_PICK;
    }
    r[0].down_at = -1;
  }
  if phase == POINTER_DOWN {
    r[0].touch = kind != 0;
    b := button_at(r, x, y);
    if b >= 0 { r[0].press = b; r[0].press_id = id; return true; }
    if kind != 0 { realm_moved(r); return false; }
    r[0].looking = true; r[0].look_id = id; r[0].lx = x; r[0].ly = y;
    return true;
  }
  if r[0].press >= 0 && id == r[0].press_id {
    if phase == POINTER_UP && button_at(r, x, y) == r[0].press { realm_do(r, v, r[0].press); }
    if phase != POINTER_MOVE { r[0].press = -1; r[0].press_id = -1; }
    return true;
  }
  if r[0].looking && id == r[0].look_id {
    if phase == POINTER_MOVE {
      // as a thumb looks on the phone (grid.coax LOOK): radians per point dragged
      k := hi(r[0].dpr, 0.5);
      r[0].dyaw -= (x - r[0].lx) / k * LOOK_RADIANS;
      r[0].dpitch -= (y - r[0].ly) / k * LOOK_RADIANS;
      r[0].lx = x; r[0].ly = y;
    } else { r[0].looking = false; }
    return true;
  }
  return kind == 0;
}
LOOK_RADIANS :: 0.006;   // grid.coax LOOK

// The wheel, in CSS pixels down: zooms the camera out (verse_player_zoom).
realm_wheel :: (r: [] Realm, dy: f32) #export_c { r[0].zoom += dy * 0.01; }

realm_cursor :: (r: [] Realm) -> int #export_c { return ifx r[0].press >= 0 then 1 else 0; }

// ---- layout, in device pixels

STICK :: 56.0;   // grid.coax STICK: the move stick's radius, in points

// Where the move stick rests before a thumb is down (grid.coax stick_rest_y).
stick_rest_y :: (height: f32, k: f32) -> f32 { return height - hi(STICK * k * 2.4, height * 0.18); }

gutter :: (r: [] Realm) -> f32 { return 16 * r[0].dpr; }
phone :: (r: [] Realm) -> bool { return r[0].touch || r[0].width < 640 * r[0].dpr; }

// The hotbar: VIEW, MAP, EDIT, EXIT. On a desktop, along the bottom right; on a
// phone, under the title, clear of the thumbs.
slot_box :: (r: [] Realm, i: int) -> Box {
  k := r[0].dpr; m := gutter(r);
  w := ifx phone(r) then 62 * k else 76 * k;
  h := ifx phone(r) then 34 * k else 40 * k;
  gap := 12 * k;
  if phone(r) {
    x0 := m + 4 * k + cast(f32) i * (w + gap); y0 := title_box(r).y1 + 14 * k;
    return Box.{x0 = x0, y0 = y0, x1 = x0 + w, y1 = y0 + h};
  }
  x1 := r[0].width - m - 4 * k - cast(f32) (SLOTS - 1 - i) * (w + gap);
  y0 := r[0].height - m - 4 * k - h;
  return Box.{x0 = x1 - w, y0 = y0, x1 = x1, y1 = y0 + h};
}

SLOTS :: 4;

// The bottom of the HUD's top: the title, and on a phone the hotbar under it.
top_bottom :: (r: [] Realm) -> f32 { return ifx phone(r) then slot_box(r, 0).y1 else title_box(r).y1; }

// The title panel at the top left: the room and the haunts found.
title_box :: (r: [] Realm) -> Box {
  k := r[0].dpr; m := gutter(r);
  w := lo(320 * k, r[0].width - 2 * m - 8 * k);
  return Box.{x0 = m + 4 * k, y0 = m + 4 * k, x1 = m + 4 * k + w, y1 = m + 4 * k + 50 * k};
}

// The conversation, at the bottom middle, above the hotbar.
talk_box :: (r: [] Realm) -> Box {
  k := r[0].dpr; m := gutter(r);
  w := lo(560 * k, r[0].width - 2 * m - 8 * k);
  bottom := ifx phone(r) then r[0].height - m - 4 * k else slot_box(r, 0).y0 - 18 * k;
  x0 := (r[0].width - w) * 0.5;
  return Box.{x0 = x0, y0 = bottom - 150 * k, x1 = x0 + w, y1 = bottom};
}

// The map: a square in the middle, the face draws the house's into it.
realm_map_box :: (r: [] Realm) -> Box #export_c {
  k := r[0].dpr;
  top := top_bottom(r) + 24 * k;
  bottom := ifx phone(r) then r[0].height - gutter(r) - 4 * k else slot_box(r, 0).y0 - 18 * k;
  side := lo(lo(r[0].width - 2 * gutter(r) - 8 * k, bottom - top), 560 * k);
  x0 := (r[0].width - side) * 0.5; y0 := top + (bottom - top - side) * 0.5;
  return Box.{x0 = x0, y0 = y0, x1 = x0 + side, y1 = y0 + side};
}

// What E acts on: who or what is near, else the quest's orb.
use_label :: (v: RealmView) -> string { return ifx v.target.count > 0 then v.target else v.goal; }

// The prompt for E, at the bottom middle (above edit mode's hotbar).
use_box :: (r: [] Realm, v: RealmView) -> Box {
  k := r[0].dpr;
  cap := 10 * k;
  w := measure(use_label(v), GAP, SPACE, false) * cap + ifx phone(r) then 48 * k else 82 * k;
  bottom := ifx phone(r) then stick_rest_y(r[0].height, k) - STICK * k - 28 * k else slot_box(r, 0).y0 - 22 * k;
  if v.editing { bottom = op_box(r, 0).y0 - 34 * k; }
  x0 := (r[0].width - w) * 0.5;
  return Box.{x0 = x0, y0 = bottom - 40 * k, x1 = x0 + w, y1 = bottom};
}

GAP :: 0.5;       // letter gap, in cap heights
SPACE :: 1.2;     // a space, in cap heights

// ---- the look: change it here. The plate's own colours (the wood fill
// #2a1d14, a step lighter under the mouse, and the bronze line #b08a4a,
// brighter when lit or under the mouse) are realm.wgsl plate's.
PARCH_R :: 0.91; PARCH_G :: 0.863; PARCH_B :: 0.753;   // #e8dcc0, words
GOLD_R :: 0.80; GOLD_G :: 0.64; GOLD_B :: 0.36;        // bronze, keys and headings
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;   // added: lit and under the mouse is 3

white :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, PARCH_R, PARCH_G, PARCH_B); }
orange :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, GOLD_R, GOLD_G, GOLD_B); }

// A plate behind b this frame: a panel (alpha, how much it hides) or a
// button (lit, or under the mouse or pressed).
plate :: (r: [] Realm, b: Box, alpha: f32, look: f32) {
  n := r[0].plate_n;
  if n >= PLATES { return; }
  r[0].plates[n] = b; r[0].plate_alpha[n] = alpha; r[0].plate_look[n] = look; r[0].plate_n = n + 1;
}
button_look :: (r: [] Realm, i: int, lit_up: bool) -> f32 {
  look: f32 = ifx lit_up then LOOK_LIT else LOOK_PLAIN;
  if r[0].press == i || r[0].hover == i { look += LOOK_HOVER; }
  return look;
}

// Text centred on x.
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  w := measure(text, GAP, SPACE, false) * cap;
  return write(d, out, at, text, x - w * 0.5, base, cap, GAP, SPACE, k, false, false);
}

// A button: its plate, its label and, on a desktop, its key.
hud_button :: (r: [] Realm, out: [] f32, at: int, i: int, b: Box, label: string, key: string, lit_up: bool) -> int {
  k := r[0].dpr; d := r[0].dpr;
  r[0].boxes[i] = b; r[0].shown[i] = true;
  plate(r, b, 0.9, button_look(r, i, lit_up));
  vertices := at;
  cap := 8.5 * k;
  cy := (b.y0 + b.y1) * 0.5 + cap * 0.5;
  if key.count > 0 && !phone(r) {
    vertices = write(d, out, vertices, key, b.x0 + 10 * k, cy, cap, GAP, SPACE, orange(k, 0.9), false, false);
    // the label right-aligned in the room after its key, smaller if it must be
    room := b.x1 - b.x0 - 26 * k - measure(key, GAP, SPACE, false) * cap;
    size := lo(cap, room / hi(measure(label, GAP, SPACE, false), 0.001));
    w := measure(label, GAP, SPACE, false) * size;
    return write(d, out, vertices, label, b.x1 - 10 * k - w, (b.y0 + b.y1) * 0.5 + size * 0.5, size, GAP, SPACE, white(k, 0.9), false, false);
  }
  fit := lo(cap, (b.x1 - b.x0 - 8 * k) / hi(measure(label, GAP, SPACE, false), 0.001));
  return centred(d, out, vertices, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + fit * 0.5, fit, white(k, 0.9));
}

// Writes "MAKE IT YOURS  N / 8" (the steps done), or that it's complete, into buf.
quest_text :: (buf: [] u8, quest: int) -> string {
  n := put(buf, 0, "MAKE IT YOURS");
  if quest >= QUEST_STEPS { n = put(buf, n, " · COMPLETE"); return cast(string) buf[0..<n]; }
  n = put(buf, n, "  ");
  n = put_int(buf, n, quest);
  n = put(buf, n, " / ");
  n = put_int(buf, n, QUEST_STEPS);
  return cast(string) buf[0..<n];
}

// Edit mode's hotbar: its items along the bottom middle, then UNDO, REDO
// and DONE (i = ITEMS, ITEMS + 1, ITEMS + 2).
EDIT_SLOTS :: ITEMS + 3;
item_box :: (r: [] Realm, i: int) -> Box {
  k := r[0].dpr; m := gutter(r);
  gap := ifx phone(r) then 4 * k else 10 * k;
  n := cast(f32) EDIT_SLOTS;
  w := lo(ifx phone(r) then 56 * k else 104 * k, (r[0].width - 2 * m - 8 * k - (n - 1) * gap) / n);
  h := 40 * k;
  total := n * w + (n - 1) * gap;
  x0 := (r[0].width - total) * 0.5 + cast(f32) i * (w + gap);
  bottom := ifx phone(r) then stick_rest_y(r[0].height, k) - STICK * k - 18 * k else slot_box(r, 0).y0 - 22 * k;
  return Box.{x0 = x0, y0 = bottom - h, x1 = x0 + w, y1 = bottom};
}

// The row for the picked thing or the zone, over edit mode's hotbar.
op_box :: (r: [] Realm, i: int) -> Box {
  k := r[0].dpr; m := gutter(r);
  gap := ifx phone(r) then 4 * k else 10 * k;
  n := cast(f32) OPS;
  w := lo(ifx phone(r) then 56 * k else 96 * k, (r[0].width - 2 * m - 8 * k - (n - 1) * gap) / n);
  h := 36 * k;
  total := n * w + (n - 1) * gap;
  x0 := (r[0].width - total) * 0.5 + cast(f32) i * (w + gap);
  bottom := item_box(r, 0).y0 - 12 * k;
  return Box.{x0 = x0, y0 = bottom - h, x1 = x0 + w, y1 = bottom};
}

// The survey box, where the conversation goes.
ask_box :: (r: [] Realm) -> Box { return talk_box(r); }



// The move stick, where to put a thumb, and what it pushes.
draw_stick :: (r: [] Realm, v: RealmView, out: [] f32, at: int) -> int {
  k := r[0].dpr; rad := STICK * k;
  ox := v.ox; oy := v.oy; light := 0.35f32;
  if !v.move_on { ox = r[0].width * 0.22; oy = stick_rest_y(r[0].height, k); light = 0.16; }
  vertices := at;
  for i: 0..<40 {
    a0 := cast(f32) i * 6.2831853 / 40; a1 := cast(f32) (i + 1) * 6.2831853 / 40;
    if lit(out, vertices, ox + cos(a0) * rad, oy + sin(a0) * rad, ox + cos(a1) * rad, oy + sin(a1) * rad,
           0.6 * k, light, 3 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { vertices += 6; }
  }
  if v.move_on && tinted_dot(out, vertices, ox + v.pad_x * rad, oy - v.pad_y * rad, 7 * k, 0.8, 6 * k, PARCH_R, PARCH_G, PARCH_B) { vertices += 6; }
  return vertices;
}

// The house's map: the rooms' outlines, you and the people.
draw_map :: (r: [] Realm, v: RealmView, out: [] f32, at: int, uniforms: [] f32) -> int {
  k := r[0].dpr; b := realm_map_box(r);
  plate(r, b, 0.92, LOOK_PLAIN);
  vertices := at;
  vertices = write(k, out, vertices, "MAP", b.x0 + 14 * k, b.y0 + 22 * k, 9 * k, GAP, SPACE, orange(k, 0.9), false, false);
  // verse_haunt_map lays the house out from the box's top left; centre it.
  x0 := 1e9f32; y0 := 1e9f32; x1 := -1e9f32; y1 := -1e9f32;
  for i: 0..<v.map_n {
    o := i * 5;
    x0 = lo(x0, v.map[o]); y0 = lo(y0, v.map[o + 1]); x1 = hi(x1, v.map[o] + v.map[o + 2]); y1 = hi(y1, v.map[o + 1] + v.map[o + 3]);
  }
  dx := b.x0 + ((b.x1 - b.x0) - (x1 - x0)) * 0.5 - x0;
  dy := b.y0 + ((b.y1 - b.y0) - (y1 - y0)) * 0.5 - y0;
  for i: 0..<v.map_n {
    o := i * 5;
    x := dx + v.map[o]; y := dy + v.map[o + 1]; w := v.map[o + 2]; h := v.map[o + 3]; kind := cast(int) v.map[o + 4];
    if kind < 2 {
      light := ifx kind == 0 then 0.75f32 else 0.28f32;
      xs := [5] f32.[x, x + w, x + w, x, x]; ys := [5] f32.[y, y, y + h, y + h, y];
      for e: 0..<4 {
        if lit(out, vertices, xs[e], ys[e], xs[e + 1], ys[e + 1], 0.5 * k, light, 2 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { vertices += 6; }
      }
    } else {
      red: f32 = ifx kind == 2 then PARCH_R else GOLD_R; green: f32 = ifx kind == 2 then PARCH_G else GOLD_G; blue: f32 = ifx kind == 2 then PARCH_B else GOLD_B;
      if tinted_dot(out, vertices, x + w * 0.5, y + h * 0.5, hi(w, h) * 0.5, 0.95, 5 * k, red, green, blue) { vertices += 6; }
    }
  }
  return vertices;
}

// The conversation: their name, what they said, HINT and BYE.
draw_talk :: (r: [] Realm, v: RealmView, out: [] f32, at: int, uniforms: [] f32) -> int {
  k := r[0].dpr; b := talk_box(r);
  plate(r, b, 0.92, LOOK_PLAIN);
  vertices := at;
  x := b.x0 + 18 * k;
  vertices = write(k, out, vertices, v.talking, x, b.y0 + 26 * k, 10 * k, GAP, SPACE, orange(k, 0.95), false, false);
  height: [1] f32;
  vertices = draw_wrapped(k, out, vertices, v.reply, x, b.y0 + 38 * k, 8.5 * k, GAP, SPACE, white(k, 0.85),
                          b.x1 - x - 18 * k, 17 * k, false, true, height[..]);
  bw := ifx phone(r) then 74 * k else 92 * k; bh := 32 * k;
  y1 := b.y1 - 14 * k;
  bye := Box.{x0 = b.x1 - 18 * k - bw, y0 = y1 - bh, x1 = b.x1 - 18 * k, y1 = y1};
  hint := Box.{x0 = bye.x0 - 12 * k - bw, y0 = y1 - bh, x1 = bye.x0 - 12 * k, y1 = y1};
  vertices = hud_button(r, out, vertices, BTN_HINT, hint, "HINT", "E", true);
  return hud_button(r, out, vertices, BTN_BYE, bye, "BYE", "ESC", false);
}

OP_LABELS :: [OPS] string.["LEFT", "RIGHT", "AWAY", "NEAR", "TURN", "BIGGER", "SMALLER", "DELETE"];
PERSON_LABELS :: [OPS] string.["LEFT", "RIGHT", "AWAY", "NEAR", "TURN", "", "HERE", "REMOVE"];
ZONE_LABELS :: [OPS] string.["LEFT", "RIGHT", "AWAY", "NEAR", "BIGGER", "SMALLER", "ONCE", "RESET"];

// Edit mode: EDITING over the middle; the picked thing (or the nearest
// zone) with its edits; the hotbar with a number key each, UNDO, REDO, DONE.
draw_edit :: (r: [] Realm, v: RealmView, out: [] f32, at: int) -> int {
  k := r[0].dpr; d := r[0].dpr;
  y := top_bottom(r) + 100 * k;
  vertices := centred(d, out, at, "EDITING", r[0].width * 0.5, y, 12 * k, orange(k, 0.95));
  hint := ifx phone(r) then "TAP A THING TO PICK IT · A SLOT PLACES ONE" else "CLICK A THING TO PICK IT · 1 TO 5 PLACE · Z UNDO · B OR ESC TO PLAY";
  if v.selected.count > 0 && !phone(r) { hint = "ARROWS MOVE IT · R TURNS · + AND - RESIZE · DELETE REMOVES · ESC LETS GO"; }
  if v.person && !phone(r) { hint = "ARROWS MOVE THEM · R TURNS THEM · DELETE REMOVES THEM · ESC LETS GO"; }
  if v.selected.count == 0 && v.zone.count > 0 && !phone(r) { hint = "ARROWS MOVE THE ZONE · + AND - RESIZE IT · CLICK A THING TO PICK IT"; }
  vertices = centred(d, out, vertices, hint, r[0].width * 0.5, y + 20 * k, 7.5 * k, white(k, 0.7));
  buf: [2] u8;
  for i: 0..<v.item_n {
    buf[0] = cast(u8) ('1' + i);
    vertices = hud_button(r, out, vertices, BTN_ITEM + i, item_box(r, i), v.items[i], cast(string) buf[0..<1], false);
  }
  if v.can_undo { vertices = hud_button(r, out, vertices, BTN_UNDO, item_box(r, ITEMS), "UNDO", "Z", false); }
  if v.can_redo { vertices = hud_button(r, out, vertices, BTN_REDO, item_box(r, ITEMS + 1), "REDO", "Y", false); }
  vertices = hud_button(r, out, vertices, BTN_EDIT, item_box(r, ITEMS + 2), "DONE", "", true);
  // what's picked, or the zone, named over its row
  name := ifx v.selected.count > 0 then v.selected else v.zone;
  if name.count == 0 { return vertices; }
  row := op_box(r, 0);
  label := ifx v.selected.count > 0 then name else "ZONE";
  vertices = write(d, out, vertices, label, row.x0, row.y0 - 10 * k, 8.5 * k, GAP, SPACE, orange(k, 0.95), false, false);
  if v.selected.count == 0 {
    vertices = write(d, out, vertices, v.zone, row.x0 + measure(label, GAP, SPACE, false) * 8.5 * k + 14 * k, row.y0 - 10 * k, 8.5 * k, GAP, SPACE, white(k, 0.9), false, false);
    for i: 0..<OPS {
      text := ZONE_LABELS[i];
      if i == 6 { text = ifx v.zone_once then "ONCE" else "ALWAYS"; }
      vertices = hud_button(r, out, vertices, BTN_OP + i, op_box(r, i), text, "", i == 6 && v.zone_once);
    }
    return vertices;
  }
  for i: 0..<OPS {
    text := ifx v.person then PERSON_LABELS[i] else OP_LABELS[i];
    if v.person && i == 5 { text = v.mind; }
    vertices = hud_button(r, out, vertices, BTN_OP + i, op_box(r, i), text, "", i == OP_DELETE);
  }
  return vertices;
}

// The survey: the question, what's typed with a caret, SEND and CANCEL.
draw_ask :: (r: [] Realm, out: [] f32, at: int, uniforms: [] f32) -> int {
  k := r[0].dpr; b := ask_box(r);
  plate(r, b, 0.92, LOOK_PLAIN);
  vertices := at;
  x := b.x0 + 18 * k;
  vertices = write(k, out, vertices, "TELL US HOW IT WENT", x, b.y0 + 26 * k, 10 * k, GAP, SPACE, orange(k, 0.95), false, false);
  text := realm_typed(r);
  shown := ifx text.count > 0 then text else "Type here";
  used: [1] f32;
  vertices = draw_wrapped(k, out, vertices, shown, x, b.y0 + 38 * k, 8.5 * k, GAP, SPACE, white(k, ifx text.count > 0 then 0.9f32 else 0.4f32),
                          b.x1 - x - 18 * k, 17 * k, false, true, used[..]);
  if sin(r[0].time * 6) > -0.2 {
    cx := x + ifx text.count > 0 then measure(last_line(text), GAP, SPACE, false) * 8.5 * k + 3 * k else 0.0f32;
    cy := b.y0 + 38 * k + hi(used[0] - 17 * k, 0) + 8.5 * k;
    if lit(out, vertices, cx, cy - 10 * k, cx, cy + 2 * k, 0.6 * k, 0.9, 3 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
  }
  bw := ifx phone(r) then 84 * k else 132 * k; bh := 32 * k;
  y1 := b.y1 - 14 * k;
  cancel := Box.{x0 = b.x1 - 18 * k - bw, y0 = y1 - bh, x1 = b.x1 - 18 * k, y1 = y1};
  sending := Box.{x0 = cancel.x0 - 12 * k - bw, y0 = y1 - bh, x1 = cancel.x0 - 12 * k, y1 = y1};
  vertices = hud_button(r, out, vertices, BTN_SEND, sending, "SEND", "ENTER", text.count > 0);
  // what happens to the answer, under the box (analytics.coax)
  said: [1] f32;
  vertices = draw_wrapped(k, out, vertices, TRACK_DISCLOSURE, b.x0 + 4 * k, b.y1 + 8 * k, 7 * k, GAP, SPACE, white(k, 0.7),
                          b.x1 - b.x0 - 8 * k, 14 * k, false, true, said[..]);
  return hud_button(r, out, vertices, BTN_CANCEL, cancel, "CANCEL", "ESC", false);
}
// The text after the last line break a wrap would make, roughly: the caret goes after it.
last_line :: (text: string) -> string { return text; }

// The way to the quest's orb when it's off to one side: an orange glow on
// that edge of the screen, with chevrons pointing out.
draw_way :: (r: [] Realm, v: RealmView, out: [] f32, at: int) -> int {
  k := r[0].dpr;
  side := ifx v.bearing > 0 then 1.0f32 else -1.0f32;
  strength := clamp((abs(v.bearing) - 0.55) / 0.5, 0, 1) * (0.75 + 0.25 * sin(r[0].time * 3.2));
  x := ifx side > 0 then r[0].width - 3 * k else 3 * k;
  cy := r[0].height * 0.5;
  vertices := at;
  if lit(out, vertices, x, cy - 160 * k, x, cy + 160 * k, 1.2 * k, 0.8 * strength, 26 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
  for c: 0..<2 {
    tip := x - side * (22 + cast(f32) c * 14) * k; back := tip - side * 10 * k;
    if lit(out, vertices, back, cy - 12 * k, tip, cy, 0.8 * k, 0.9 * strength, 5 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
    if lit(out, vertices, tip, cy, back, cy + 12 * k, 0.8 * k, 0.9 * strength, 5 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
  }
  return vertices;
}

// Before the house opens: its name, LOADING and how much has arrived.
draw_loading :: (r: [] Realm, v: RealmView, out: [] f32, at: int) -> int {
  k := r[0].dpr; cx := r[0].width * 0.5; cy := r[0].height * 0.5;
  vertices := centred(k, out, at, "HAUNTED HOUSE", cx, cy - 18 * k, 16 * k, white(k, 0.95));
  if v.failed { return centred(k, out, vertices, "THE HOUSE COULD NOT BE LOADED", cx, cy + 22 * k, 8.5 * k, orange(k, 0.9)); }
  vertices = centred(k, out, vertices, "LOADING", cx, cy + 20 * k, 8.5 * k, white(k, 0.6));
  w := lo(220 * k, r[0].width - 2 * gutter(r));
  x0 := cx - w * 0.5; y := cy + 40 * k;
  if lit(out, vertices, x0, y, x0 + w, y, 0.5 * k, 0.18, 2 * k, PARCH_R, PARCH_G, PARCH_B, MODE_STROKE) { vertices += 6; }
  f := clamp(v.loaded, 0, 1);
  if f > 0 && lit(out, vertices, x0, y, x0 + w * f, y, 0.8 * k, 0.95, 5 * k, GOLD_R, GOLD_G, GOLD_B, MODE_STROKE) { vertices += 6; }
  // what the house saves while you're here (analytics.coax), as the playtest says it
  dw := lo(360 * k, r[0].width - 2 * gutter(r));
  said: [1] f32;
  return draw_wrapped(k, out, vertices, TRACK_DISCLOSURE, cx - dw * 0.5, y + 22 * k, 7 * k, GAP, SPACE, white(k, 0.5),
                      dw, 14 * k, false, true, said[..]);
}

// The frame: steps the clock and draws the HUD over the house. Returns the
// vertex count.
realm_draw :: (r: [] Realm, v: RealmView, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c {
  if uniforms.count < UNIFORM_FLOATS { return 0; }
  r[0].plate_n = 0;
  n := realm_hud(r, v, out, uniforms, width, height, dpr, dt);
  uniforms[5] = cast(f32) r[0].plate_n;
  for i: 0..<r[0].plate_n {
    o := PANEL_AT + i * 8; b := r[0].plates[i];
    uniforms[o] = b.x0; uniforms[o + 1] = b.y0; uniforms[o + 2] = b.x1; uniforms[o + 3] = b.y1;
    uniforms[o + 4] = r[0].dpr; uniforms[o + 5] = r[0].plate_alpha[i]; uniforms[o + 6] = r[0].plate_look[i]; uniforms[o + 7] = 0;
  }
  return n;
}
realm_hud :: (r: [] Realm, v: RealmView, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int {
  r[0].width = width; r[0].height = height; r[0].dpr = hi(dpr, 0.5);
  r[0].time += clamp(dt, 0, 0.1);
  for i: 0..<BUTTONS { r[0].shown[i] = false; }
  for i: PANEL_AT..<UNIFORM_FLOATS { uniforms[i] = 0; }
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = r[0].time; uniforms[3] = 1;
  uniforms[4] = 0; uniforms[5] = 0; uniforms[6] = r[0].dpr; uniforms[7] = 0;
  if !v.ready { return draw_loading(r, v, out, 0); }
  k := r[0].dpr; d := r[0].dpr;
  vertices := 0;

  // the room you're in and the quest
  t := title_box(r);
  plate(r, t, 0.88, LOOK_PLAIN);
  room := ifx v.title.count > 0 then v.title else "HAUNTED HOUSE";
  vertices = draw_fit(d, out, vertices, room, t.x0 + 14 * k, t.y0 + 22 * k, 10.5 * k, GAP, SPACE, white(k, 0.95), t.x1 - t.x0 - 28 * k);
  buf: [48] u8;
  vertices = draw_fit(d, out, vertices, quest_text(buf[..], v.quest), t.x0 + 14 * k, t.y0 + 39 * k, 7.5 * k, GAP, SPACE,
                      orange(k, 0.85), t.x1 - t.x0 - 28 * k);
  // what to do now, under it
  if v.quest_line.count > 0 {
    vertices = draw_fit(d, out, vertices, v.quest_line, t.x0 + 14 * k, top_bottom(r) + 22 * k, 8 * k, GAP, SPACE,
                        orange(k, ifx v.quest < QUEST_STEPS then 0.95f32 else 0.6f32), r[0].width - 2 * gutter(r) - 28 * k);
  }

  // the hotbar
  vertices = hud_button(r, out, vertices, BTN_VIEW, slot_box(r, 0), "VIEW", "V", false);
  vertices = hud_button(r, out, vertices, BTN_MAP, slot_box(r, 1), "MAP", "M", r[0].map);
  vertices = hud_button(r, out, vertices, BTN_EDIT, slot_box(r, 2), "EDIT", "B", v.editing);
  vertices = hud_button(r, out, vertices, BTN_EXIT, slot_box(r, 3), "EXIT", "", false);

  // the house's notice, under the title
  if v.notice.count > 0 {
    cap := 9 * k;
    w := lo(measure(v.notice, GAP, SPACE, false) * cap, r[0].width - 2 * gutter(r));
    y := top_bottom(r) + 52 * k;
    used: [1] f32;
    vertices = draw_wrapped(d, out, vertices, v.notice, (r[0].width - w) * 0.5, y, cap, GAP, SPACE, white(k, 0.95),
                            w + cap, 18 * k, false, true, used[..]);
  }

  if v.quest > 0 && v.quest < QUEST_STEPS && v.goal.count == 0 && abs(v.bearing) > 0.55 { vertices = draw_way(r, v, out, vertices); }
  // the map before edit mode's rows, so their plates lie over it
  if r[0].map { vertices = draw_map(r, v, out, vertices, uniforms); }
  if v.editing { vertices = draw_edit(r, v, out, vertices); }
  if r[0].typing { vertices = draw_ask(r, out, vertices, uniforms); }
  else if v.talking.count > 0 { vertices = draw_talk(r, v, out, vertices, uniforms); }
  else if use_label(v).count > 0 {
    b := use_box(r, v);
    r[0].boxes[BTN_USE] = b; r[0].shown[BTN_USE] = true;
    plate(r, b, 0.9, button_look(r, BTN_USE, true));
    cap := 10 * k; cy := (b.y0 + b.y1) * 0.5 + cap * 0.5;
    if phone(r) { vertices = centred(d, out, vertices, use_label(v), (b.x0 + b.x1) * 0.5, cy, cap, white(k, 0.95)); }
    else {
      vertices = write(d, out, vertices, "E", b.x0 + 16 * k, cy, cap, GAP, SPACE, orange(k, 0.95), false, false);
      vertices = write(d, out, vertices, use_label(v), b.x0 + 46 * k, cy, cap, GAP, SPACE, white(k, 0.95), false, false);
    }
  }

  // the controls: the thumbs on a phone, and until a while after you first
  // move, what the keys or thumbs do
  if phone(r) { vertices = draw_stick(r, v, out, vertices); }
  help := ifx r[0].moved_at < 0 then 1.0f32 else 1 - ease((r[0].time - r[0].moved_at - HELP_TIME) / 1.5);
  if help > 0 {
    k2 := white(k, 0.55 * help);
    if phone(r) {
      y := stick_rest_y(r[0].height, k) + STICK * k + 24 * k;
      vertices = centred(d, out, vertices, "LEFT THUMB MOVES", r[0].width * 0.5, y, 7.5 * k, k2);
      vertices = centred(d, out, vertices, "RIGHT THUMB LOOKS · TAP TO JUMP", r[0].width * 0.5, y + 18 * k, 7.5 * k, k2);
    } else {
      vertices = write(d, out, vertices, "WASD MOVE · DRAG LOOK · SPACE JUMP · SHIFT RUN · E USE · B EDIT", gutter(r) + 4 * k,
                       r[0].height - gutter(r) - 16 * k, 7.5 * k, GAP, SPACE, k2, false, false);
    }
    // what the house saves (analytics.coax), while the controls show and
    // nothing else is up: on a plate above the controls (a phone: above the stick)
    if !v.editing && !r[0].typing && v.talking.count == 0 && !r[0].map {
      said: [1] f32;
      dw := lo(420 * k, r[0].width - 2 * gutter(r) - 24 * k);
      vertices = draw_wrapped(d, out, vertices, TRACK_DISCLOSURE, 0, 0, 6.5 * k, GAP, SPACE, white(k, 0), dw, 13 * k, false, false, said[..]);
      bottom := ifx phone(r) then stick_rest_y(r[0].height, k) - STICK * k - 20 * k else r[0].height - gutter(r) - 34 * k;
      x0 := ifx phone(r) then (r[0].width - dw) * 0.5 else gutter(r) + 12 * k;
      top := bottom - said[0] - 6.5 * k;
      plate(r, Box.{x0 = x0 - 12 * k, y0 = top - 15 * k, x1 = x0 + dw + 12 * k, y1 = bottom + 4 * k}, 0.75 * help, LOOK_PLAIN);
      vertices = draw_wrapped(d, out, vertices, TRACK_DISCLOSURE, x0, top - 6.5 * k, 6.5 * k, GAP, SPACE, white(k, 0.8 * help), dw, 13 * k, false, true, said[..]);
    }
  }
  return vertices;
}

coaxial_realm_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_realm_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_realm_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }
coaxial_realm_map_max :: () -> int #export_c { return MAP_MAX; }

// ---- what the house records (analytics.coax): the playtest's Haunted House
// events, from what the HUD shows changing frame to frame

RealmSeen :: struct {
  started: bool; broke: bool;
  room: [48] u8; room_n: int;
  quest: int; line: [80] u8; line_n: int;
  editing: bool; map: bool; typing: bool; camera: int;
  with: [48] u8; with_n: int;
  said: [80] u8; said_n: int;
}
seen_same :: (buf: [] u8, n: int, text: string) -> bool {
  m := ifx text.count < buf.count then text.count else buf.count;
  if m != n { return false; }
  for i: 0..<m { if buf[i] != text[i] { return false; } }
  return true;
}
// What the quest's step `n` was, done (the playtest's step events).
quest_done_event :: (n: int) -> string {
  if n == 1 { return "edit"; } if n == 2 { return "place"; } if n == 3 { return "publish"; }
  if n == 4 { return "share"; } if n == 5 { return "fork"; } if n == 6 { return "invite"; }
  return "";
}
HAUNT_WORLD :: "haunted-house";

// Every frame, after realm_draw: the house's changes as events.
realm_track :: (r: [] Realm, s: [] RealmSeen, t: [] Track, v: RealmView, camera: int) #export_c {
  if !t[0].ready { return; }
  if v.failed && !s[0].broke { s[0].broke = true; track_error(t, "the house didn't load", "realm", 0); }
  if !v.ready { return; }
  if !s[0].started {
    s[0].started = true; s[0].quest = v.quest; s[0].camera = camera;
    track_world(t, HAUNT_WORLD);
    track_loaded(t, "load-engine");
  }
  if !seen_same(s[0].room[..], s[0].room_n, v.title) {
    s[0].room_n = tw_copy(s[0].room[..], 0, v.title);
    if track_begin(t, "area") { track_str(t, "area", v.title); track_str(t, "world", HAUNT_WORLD); track_end(t); }
  }
  if v.quest != s[0].quest {
    done := quest_done_event(s[0].quest);
    if v.quest > s[0].quest && done.count > 0 && track_begin(t, done) { track_str(t, "world", HAUNT_WORLD); track_end(t); }
    if track_begin(t, "quest") { track_int(t, "step", v.quest); track_int(t, "n", QUEST_STEPS); track_end(t); }
    s[0].quest = v.quest;
  }
  if !seen_same(s[0].line[..], s[0].line_n, v.quest_line) {
    s[0].line_n = tw_copy(s[0].line[..], 0, v.quest_line);
    if v.quest_line.count > 0 && track_begin(t, "objective") { track_str(t, "goal", v.quest_line); track_end(t); }
  }
  if v.editing != s[0].editing {
    s[0].editing = v.editing;
    if track_begin(t, ifx v.editing then "edit-open" else "edit-close") { track_num(t, "ms", track_now_ms(t)); track_end(t); }
  }
  if r[0].map != s[0].map {
    s[0].map = r[0].map;
    if track_begin(t, "map") { track_bool(t, "open", r[0].map); track_end(t); }
  }
  if camera != s[0].camera {
    s[0].camera = camera;
    if track_begin(t, "view") { track_int(t, "camera", camera); track_end(t); }
  }
  if !seen_same(s[0].with[..], s[0].with_n, v.talking) {
    if v.talking.count > 0 { if track_begin(t, "npc") { track_str(t, "who", v.talking); track_str(t, "world", HAUNT_WORLD); track_end(t); } }
    else if track_begin(t, "npc-end") { track_str(t, "who", cast(string) s[0].with[0..<s[0].with_n]); track_end(t); }
    s[0].with_n = tw_copy(s[0].with[..], 0, v.talking);
  }
  if !seen_same(s[0].said[..], s[0].said_n, v.notice) {
    s[0].said_n = tw_copy(s[0].said[..], 0, v.notice);
    if v.notice.count > 0 && track_begin(t, "notice") { track_str(t, "line", v.notice); track_end(t); }
  }
  if r[0].typing != s[0].typing {
    s[0].typing = r[0].typing;
    if r[0].typing && track_begin(t, "survey-show") { track_str(t, "q", "how it went"); track_str(t, "world", HAUNT_WORLD); track_end(t); }
  }
}
// The survey's answer, sent: the words, with consent (the box says they're saved).
realm_track_answer :: (t: [] Track, text: string) #export_c {
  if track_begin(t, "survey-sent") { track_str(t, "q", "how it went"); track_str(t, "world", HAUNT_WORLD); track_words(t, text); track_end(t); }
}
// Something placed from edit mode's hotbar or the quest's orb.
realm_track_place :: (t: [] Track, item: string, via: string) #export_c {
  if track_begin(t, "place") { track_str(t, "item", item); track_str(t, "via", via); track_str(t, "world", HAUNT_WORLD); track_end(t); }
}
// The label of the button at (x, y), for a click ("" none).
realm_button_label :: (r: [] Realm, x: f32, y: f32) -> string #export_c {
  b := button_at(r, x, y);
  if b == BTN_USE { return "use"; } if b == BTN_VIEW { return "view"; } if b == BTN_MAP { return "map"; }
  if b == BTN_EXIT { return "exit"; } if b == BTN_HINT { return "hint"; } if b == BTN_BYE { return "bye"; }
  if b == BTN_SEND { return "send"; } if b == BTN_CANCEL { return "cancel"; } if b == BTN_EDIT { return "edit"; }
  if b == BTN_UNDO { return "undo"; } if b == BTN_REDO { return "redo"; }
  if b >= BTN_OP { return "edit-op"; }
  if b >= BTN_ITEM { return "item"; }
  return "";
}
// An edit to the picked thing or the zone (OP_*): delete, undo and redo as
// themselves, the rest as the playtest's build with what it did.
realm_track_edit :: (t: [] Track, op: int) #export_c {
  if op == OP_DROP { return; }
  ev := ifx op == OP_DELETE then "delete" else ifx op == OP_UNDO then "undo" else ifx op == OP_REDO then "redo" else "build";
  if track_begin(t, ev) {
    if op < OPS { track_str(t, "op", OP_LABELS[op]); }
    else if op == OP_MIND || op == OP_HERE { track_str(t, "person", ifx op == OP_MIND then "mind" else "here"); }
    else if op >= OP_ZONE_LEFT && op <= OP_ZONE_NEAR { track_str(t, "zone", ZONE_LABELS[op - OP_ZONE_LEFT]); }
    else if op >= OP_ZONE_BIGGER && op <= OP_ZONE_RESET { track_str(t, "zone", ifx op == OP_ZONE_BIGGER then "bigger" else ifx op == OP_ZONE_SMALLER then "smaller" else ifx op == OP_ZONE_ONCE then "once" else "reset"); }
    track_str(t, "world", HAUNT_WORLD);
    track_end(t);
  }
}

// ---- checks

desk :: (r: [] Realm) { r[0].width = 1440; r[0].height = 900; r[0].dpr = 2; realm_reset(r); }
view :: () -> RealmView { v: RealmView; v.ready = true; v.title = "Foyer"; v.quest = 2; v.quest_line = "Place something in the hall"; return v; }

#test "keys move, run and jump while held, and stop when let go" {
  r: [1] Realm; desk(r[..]); v := view();
  #assert realm_key(r[..], v, 'w', 0, true) && realm_key_y(r[..]) == 1;
  #assert realm_key(r[..], v, KEY_LEFT, 0, true) && realm_key_x(r[..]) == -1;
  _ := realm_key(r[..], v, KEY_SHIFT, MOD_SHIFT, true);
  #assert r[0].held & HOLD_RUN != 0;
  _ = realm_key(r[..], v, 'W', 0, false);
  #assert realm_key_y(r[..]) == 0 && realm_key_x(r[..]) == -1;
  realm_blur(r[..]);
  #assert r[0].held == 0 && realm_key_x(r[..]) == 0;
  #assert r[0].moved_at >= 0;
}

#test "E acts once per press, on whatever is near, and asks for a hint in a conversation" {
  r: [1] Realm; desk(r[..]); v := view();
  _ := realm_key(r[..], v, 'e', 0, true);
  #assert realm_take(r[..]) == 0;                 // nothing near
  _ = realm_key(r[..], v, 'e', 0, false);
  v.target = "Door";
  _ = realm_key(r[..], v, 'e', 0, true);
  _ = realm_key(r[..], v, 'e', 0, true);          // the key repeats
  #assert realm_take(r[..]) == ASK_USE;
  _ = realm_key(r[..], v, 'e', 0, false);
  v.talking = "Mortimer"; v.reply = "Welcome.";
  _ = realm_key(r[..], v, KEY_ENTER, 0, true);
  #assert realm_take(r[..]) == ASK_HINT;
  #assert realm_key(r[..], v, KEY_ESCAPE, 0, true) && realm_take(r[..]) == ASK_BYE;
}

#test "V cycles the view, M opens and Escape closes the map; shortcuts with Cmd stay the browser's" {
  r: [1] Realm; desk(r[..]); v := view();
  _ := realm_key(r[..], v, 'v', 0, true);
  #assert realm_take(r[..]) == ASK_VIEW;
  _ = realm_key(r[..], v, 'm', 0, true);
  #assert r[0].map;
  #assert realm_key(r[..], v, KEY_ESCAPE, 0, true) && !r[0].map;
  #assert !realm_key(r[..], v, 'v', MOD_META, true);
  #assert !realm_key(r[..], v, 'q', 0, true);
}

#test "a mouse drag looks around; a finger off the HUD is the thumbs'" {
  r: [1] Realm; desk(r[..]); v := view();
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  _ := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert realm_pointer(r[..], v, 700, 400, POINTER_DOWN, 0, 1);
  #assert realm_pointer(r[..], v, 720, 390, POINTER_MOVE, 0, 1);
  #assert r[0].dyaw < 0 && r[0].dpitch > 0;
  #assert realm_pointer(r[..], v, 720, 390, POINTER_UP, 0, 1) && !r[0].looking;
  #assert !realm_pointer(r[..], v, 300, 700, POINTER_DOWN, 1, 7);
  #assert !realm_pointer(r[..], v, 320, 690, POINTER_MOVE, 1, 7);
}

#test "the hotbar's buttons act on release over them, and EXIT goes home" {
  r: [1] Realm; desk(r[..]); v := view();
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  _ := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  b := slot_box(r[..], 0);
  x := (b.x0 + b.x1) * 0.5; y := (b.y0 + b.y1) * 0.5; e := slot_box(r[..], 2);
  #assert realm_pointer(r[..], v, x, y, POINTER_DOWN, 0, 1) && r[0].press == BTN_VIEW;
  p1 := realm_pointer(r[..], v, x, y, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_VIEW && r[0].press == -1;
  // dragged off before letting go: nothing
  p2 := realm_pointer(r[..], v, x, y, POINTER_DOWN, 1, 3);
  p3 := realm_pointer(r[..], v, x, y - 300, POINTER_UP, 1, 3);
  #assert realm_take(r[..]) == 0;
  e = r[0].boxes[BTN_EXIT];
  p4 := realm_pointer(r[..], v, e.x0 + 4, e.y0 + 4, POINTER_DOWN, 0, 1);
  p5 := realm_pointer(r[..], v, e.x0 + 4, e.y0 + 4, POINTER_UP, 0, 1);
  #assert r[0].action == ACT_NAVIGATE && cast(string) r[0].outbox[0..<r[0].out_n] == "/";
}

#test "the HUD fits a narrow phone: title, hotbar and conversation inside the gutters" {
  r: [1] Realm; realm_reset(r[..]); v := view();
  v.talking = "Mortimer"; v.reply = "I have kept this house for a hundred years, and I will keep it for a hundred more.";
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  r[0].touch = true;
  n := realm_draw(r[..], v, out[..], u[..], 1170, 2532, 3, 0.016);
  #assert n > 0 && n < MAX_VERTICES;
  t := title_box(r[..]); s := slot_box(r[..], 0); e := slot_box(r[..], 3); b := talk_box(r[..]);
  #assert t.x0 >= 48 && t.x1 <= 1170 - 48 && s.y0 > t.y1 && e.x1 <= 1170 - 48;
  #assert b.x0 >= 48 && b.x1 <= 1170 - 48 && b.y1 <= 2532 - 48;
  for i: 0..<n { #assert out[i * VERTEX_FLOATS] > -100 && out[i * VERTEX_FLOATS] < 1270; }
  buf: [48] u8; t2 := title_box(r[..]);
  #assert measure(quest_text(buf[..], 8), GAP, SPACE, false) * 7.5 * 3 < t2.x1 - t2.x0 - 28 * 3;
  #assert item_box(r[..], 0).x0 >= 48 && item_box(r[..], EDIT_SLOTS - 1).x1 <= 1170 - 48;
  #assert op_box(r[..], 0).x0 >= 48 && op_box(r[..], OPS - 1).x1 <= 1170 - 48 && op_box(r[..], 0).y1 < item_box(r[..], 0).y0;
  #assert measure("RIGHT THUMB LOOKS · TAP TO JUMP", GAP, SPACE, false) * 7.5 * 3 < 1170 - 96;
}

#test "before the house opens: LOADING and how much has arrived; then the HUD" {
  r: [1] Realm; desk(r[..]); v: RealmView; v.loaded = 0.5;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  a := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert a > 0 && !r[0].shown[BTN_VIEW];
  v = view(); v.notice = "The sheet rises."; v.target = "Mortimer";
  b := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert b > a && r[0].shown[BTN_VIEW] && r[0].shown[BTN_USE] && u[PANEL_AT + 5] > 0;
}

#test "the map opens over the middle and draws the rooms and you" {
  r: [1] Realm; desk(r[..]); v := view();
  r[0].map = true;
  v.map_n = 2;
  v.map[0] = 10; v.map[1] = 10; v.map[2] = 200; v.map[3] = 100; v.map[4] = 0;
  v.map[5] = 50; v.map[6] = 50; v.map[7] = 8; v.map[8] = 8; v.map[9] = 2;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  m := realm_map_box(r[..]);
  #assert n > 0 && m.x1 - m.x0 > 400 && m.y1 <= slot_box(r[..], 0).y0 && plated(u[..], m) == LOOK_PLAIN;
}

// The look of the plate the frame laid over b (-1 if none did).
plated :: (u: [] f32, b: Box) -> f32 {
  for i: 0..<cast(int) u[5] {
    o := PANEL_AT + i * 8;
    if u[o] == b.x0 && u[o + 1] == b.y0 && u[o + 2] == b.x1 && u[o + 3] == b.y1 && u[o + 5] > 0 { return u[o + 6]; }
  }
  return -1;
}

#test "every button is a plate: lit when on, a step brighter under the mouse" {
  r: [1] Realm; desk(r[..]); v := view(); v.editing = true;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  _ := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert plated(u[..], slot_box(r[..], 0)) == LOOK_PLAIN && plated(u[..], slot_box(r[..], 2)) == LOOK_LIT;
  #assert plated(u[..], item_box(r[..], ITEMS + 2)) == LOOK_LIT && plated(u[..], title_box(r[..])) == LOOK_PLAIN;
  b := slot_box(r[..], 1);
  over := realm_pointer(r[..], v, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, POINTER_MOVE, 0, 1);
  _ = realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert plated(u[..], b) == LOOK_HOVER && plated(u[..], slot_box(r[..], 2)) == LOOK_LIT;
  over = realm_pointer(r[..], v, 5, 5, POINTER_MOVE, 0, 1);
  _ = realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert plated(u[..], b) == LOOK_PLAIN && cast(int) u[5] <= PLATES;
}

#test "the quest: its progress in the title, and E at the orb does the step" {
  r: [1] Realm; desk(r[..]); v := view();
  buf: [48] u8;
  #assert quest_text(buf[..], 2) == "MAKE IT YOURS  2 / 8" && quest_text(buf[..], 8) == "MAKE IT YOURS · COMPLETE";
  _ := realm_key(r[..], v, 'e', 0, true);
  #assert realm_take(r[..]) == 0;                 // not at the orb
  _ = realm_key(r[..], v, 'e', 0, false);
  v.goal = "Place something here";
  _ = realm_key(r[..], v, 'e', 0, true);
  #assert realm_take(r[..]) == ASK_GOAL;
  _ = realm_key(r[..], v, 'e', 0, false);
  v.target = "Mortimer";                          // a person comes first
  _ = realm_key(r[..], v, 'e', 0, true);
  #assert realm_take(r[..]) == ASK_USE;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  v.target = ""; v.goal = ""; v.bearing = 2;
  a := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  v.bearing = 0;
  b := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  #assert a > b;                                  // the way glows on the edge
}

#test "edit mode: B goes in and out, its hotbar places, Escape leaves" {
  r: [1] Realm; desk(r[..]); v := view();
  _ := realm_key(r[..], v, 'b', 0, true);
  #assert realm_take(r[..]) == ASK_EDIT;
  _ = realm_key(r[..], v, 'b', 0, false);
  v.editing = true; v.item_n = 2; v.items[0] = "JACK"; v.items[1] = "CANDLE";
  _ = realm_key(r[..], v, '2', 0, true);
  _ = realm_key(r[..], v, '2', 0, true);          // held: once
  #assert realm_take(r[..]) == ASK_PLACE && r[0].slot == 1;
  _ = realm_key(r[..], v, '2', 0, false);
  #assert !realm_key(r[..], v, '3', 0, true);     // no third item
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  i := item_box(r[..], 0);
  #assert r[0].shown[BTN_ITEM] && r[0].shown[BTN_ITEM + 1] && !r[0].shown[BTN_ITEM + 2] && r[0].shown[BTN_EDIT];
  p1 := realm_pointer(r[..], v, i.x0 + 4, i.y0 + 4, POINTER_DOWN, 0, 1);
  p2 := realm_pointer(r[..], v, i.x0 + 4, i.y0 + 4, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_PLACE && r[0].slot == 0;
  #assert realm_key(r[..], v, KEY_ESCAPE, 0, true) && realm_take(r[..]) == ASK_EDIT;
}

#test "the survey box takes typed text, Backspace a whole character, Enter sends, Escape closes" {
  r: [1] Realm; desk(r[..]); v := view();
  realm_ask_text(r[..]);
  #assert realm_wants_text(r[..]);
  for c: "Fun" { _ := realm_key(r[..], v, cast(int) c, 0, true); }
  _ := realm_key(r[..], v, 0xE9, 0, true);        // é: two bytes
  #assert realm_typed(r[..]).count == 5 && r[0].typed[3] == 0xC3 && r[0].typed[4] == 0xA9;
  _ = realm_key(r[..], v, KEY_BACKSPACE, 0, true);
  #assert realm_typed(r[..]) == "Fun";
  #assert realm_take(r[..]) == 0;                 // W, E: typed, not walked or used
  _ = realm_key(r[..], v, KEY_ENTER, 0, true);
  #assert realm_take(r[..]) == ASK_SEND;
  _ = realm_key(r[..], v, KEY_ESCAPE, 0, true);
  #assert !realm_wants_text(r[..]);
  realm_ask_text(r[..]);
  _ = realm_key(r[..], v, KEY_ENTER, 0, true);
  #assert realm_take(r[..]) == 0;                 // nothing typed: nothing sent
}

#test "edit mode: a click picks, a drag looks; keys and buttons edit the picked thing, the zone, undo" {
  r: [1] Realm; desk(r[..]); v := view(); v.editing = true; v.item_n = 2; v.items[0] = "JACK"; v.items[1] = "CANDLE";
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  d0 := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  p1 := realm_pointer(r[..], v, 700, 400, POINTER_DOWN, 0, 1);
  p2 := realm_pointer(r[..], v, 702, 401, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_PICK && r[0].pick_x == 702;
  p3 := realm_pointer(r[..], v, 700, 400, POINTER_DOWN, 0, 1);
  p4 := realm_pointer(r[..], v, 760, 400, POINTER_MOVE, 0, 1);
  p5 := realm_pointer(r[..], v, 760, 400, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == 0 && r[0].dyaw != 0;   // a drag: looked, not picked
  #assert realm_key(r[..], v, 'z', 0, true) && realm_take(r[..]) == ASK_OP && r[0].op == OP_UNDO;
  k1 := realm_key(r[..], v, KEY_LEFT, 0, true);
  #assert realm_take(r[..]) == 0 && r[0].held & HOLD_LEFT != 0;   // nothing picked: arrows walk
  realm_blur(r[..]);
  v.selected = "Ghost";
  k2 := realm_key(r[..], v, KEY_LEFT, 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_LEFT && r[0].held == 0;
  k3 := realm_key(r[..], v, KEY_DELETE, 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_DELETE;
  k4 := realm_key(r[..], v, KEY_ESCAPE, 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_DROP;   // Escape lets go first
  d1 := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  b := op_box(r[..], OP_TURN);
  p6 := realm_pointer(r[..], v, b.x0 + 4, b.y0 + 4, POINTER_DOWN, 0, 1);
  p7 := realm_pointer(r[..], v, b.x0 + 4, b.y0 + 4, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_TURN;
  v.selected = ""; v.zone = "Potion shelves";
  d2 := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  z := op_box(r[..], 6);
  p8 := realm_pointer(r[..], v, z.x0 + 4, z.y0 + 4, POINTER_DOWN, 0, 1);
  p9 := realm_pointer(r[..], v, z.x0 + 4, z.y0 + 4, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_ZONE_ONCE;
  z = op_box(r[..], 0);
  p10 := realm_pointer(r[..], v, z.x0 + 4, z.y0 + 4, POINTER_DOWN, 0, 1);
  p11 := realm_pointer(r[..], v, z.x0 + 4, z.y0 + 4, POINTER_UP, 0, 1);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_ZONE_LEFT;
  k5 := realm_key(r[..], v, KEY_UP, 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_ZONE_AWAY && r[0].held == 0;   // a zone near: arrows move it
  k6 := realm_key(r[..], v, '+', 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_ZONE_BIGGER;
}

#test "edit mode: a picked character's row moves them, changes what they do, calls them over, removes them" {
  r: [1] Realm; desk(r[..]); v := view(); v.editing = true; v.selected = "Mortimer"; v.person = true; v.mind = "STAYS";
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  d0 := realm_draw(r[..], v, out[..], u[..], 1440, 900, 2, 0.016);
  ops := [OPS] int.[OP_LEFT, OP_RIGHT, OP_AWAY, OP_NEAR, OP_TURN, OP_MIND, OP_HERE, OP_DELETE];
  for i: 0..<OPS {
    b := op_box(r[..], i);
    #assert plated(u[..], b) >= 0;
    p1 := realm_pointer(r[..], v, b.x0 + 4, b.y0 + 4, POINTER_DOWN, 0, 1);
    p2 := realm_pointer(r[..], v, b.x0 + 4, b.y0 + 4, POINTER_UP, 0, 1);
    #assert realm_take(r[..]) == ASK_OP && r[0].op == ops[i];
  }
  k1 := realm_key(r[..], v, KEY_DOWN, 0, true);
  #assert realm_take(r[..]) == ASK_OP && r[0].op == OP_NEAR;
}

#test "the house records the playtest's events: entering, the room, the quest's steps, the survey's words" {
  r: [1] Realm; desk(r[..]); v := view();
  t: [1] Track; s: [1] RealmSeen;
  track_init(t[..], "haunt");
  #assert track_message(t[..], HOST_PAGE, "tab=00000000000000aa\nfresh=1\nvisitor=00000000000000bb\nnow=1793200000000\nnav=10\nua=x\nvw=1280\nvh=800\ndpr=2");
  realm_track(r[..], s[..], t[..], v, 0);
  body := cast(string) t[0].buf[0..<t[0].buf_n];
  #assert text_has(body, "\"ev\":\"world-enter\"") && text_has(body, "\"world\":\"haunted-house\"");
  #assert text_has(body, "\"ev\":\"load-engine\"") && text_has(body, "{\"area\":\"Foyer\",\"world\":\"haunted-house\"}");
  v.quest = 3; v.editing = true;
  realm_track(r[..], s[..], t[..], v, 1);
  realm_track_answer(t[..], "It was spooky");
  body = cast(string) t[0].buf[0..<t[0].buf_n];
  #assert text_has(body, "\"ev\":\"place\"") && text_has(body, "{\"step\":3,\"n\":8}") && text_has(body, "\"ev\":\"edit-open\"");
  #assert text_has(body, "{\"camera\":1}") && text_has(body, "\"text\":\"It was spooky\",\"consent\":true");
}
