// /realms' public made realms (realmlist.coax): GET /api/playtest/realms/listed
// (coax/web/api/migrations/0101_realm_list.sql), asked once by the page's face. Its
// answer comes as "STATUS\n" then the body (coax/web/host.js):
//   total N
//   SLUG|TITLE|LINE|YYYY-MM-DDTHH:MM|STYLE     one a line, newest first
// This file decides which rows go on the page: a row with exactly those five fields,
// a realm address for a slug, a title and the time; the first ones that fit in the
// room the built-in realms leave, and how many more there are. The server lists only
// public realms; this never adds a row it didn't send. Anything else (no answer, a
// refusal, an older API's 404) adds nothing.
//   coax/bin/coax test apps/openagents-web/realms-listed.coax --library
#authority;

LISTED_URL :: "/api/playtest/realms/listed";
LISTED_FLAGS :: 4;             // a GET, its answer wanted (coax/web/host.js)

ListedAsk :: struct { sent: bool; id: int; done: bool; }
// What was taken: rows copied, the bytes they took, and how many public realms were left out
// (the total less the rows; 0 or less is none).
Listed :: struct { rows: int; n: int; more: int; }

listed_wants :: (a: [] ListedAsk) -> bool { return !a[0].sent; }
listed_sent :: (a: [] ListedAsk, id: int) { a[0].sent = true; a[0].id = id; }
// Whether a host message is this answer (base: the kind answers come under, plus the id).
listed_is :: (a: [] ListedAsk, base: int, kind: int) -> bool { return a[0].sent && !a[0].done && a[0].id >= 0 && kind == base + a[0].id; }

#test "asked once; only its own answer is taken" {
  a: [1] ListedAsk;
  #assert listed_wants(a[..]) && !listed_is(a[..], 512, 512);
  listed_sent(a[..], 3);
  #assert !listed_wants(a[..]) && listed_is(a[..], 512, 515) && !listed_is(a[..], 512, 514) && !listed_is(a[..], 500, 515);
  a[0].done = true;
  #assert !listed_is(a[..], 512, 515);
  b: [1] ListedAsk;
  listed_sent(b[..], -1);
  #assert !listed_is(b[..], 512, 511);
  c: [1] ListedAsk;
  listed_sent(c[..], 0);
  #assert listed_is(c[..], 512, 512);
}

// A realm's address: 1 to 48 of a-z, 0-9 and -, not starting with -.
listed_slug_ok :: (s: string) -> bool {
  if s.count < 1 || s.count > 48 || s[0] == '-' { return false; }
  for c: s { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}
#test "slugs" {
  #assert listed_slug_ok("farm") && listed_slug_ok("floating-island-village-3") && listed_slug_ok("a") && listed_slug_ok("9z");
  #assert !listed_slug_ok("") && !listed_slug_ok("-farm") && !listed_slug_ok("Farm") && !listed_slug_ok("a_b") && !listed_slug_ok("a/b") && !listed_slug_ok("a b");
  #assert listed_slug_ok("abcdefghijabcdefghijabcdefghijabcdefghijabcdefgh") && !listed_slug_ok("abcdefghijabcdefghijabcdefghijabcdefghijabcdefghi");
  #assert !listed_slug_ok("a.b") && !listed_slug_ok("{") && !listed_slug_ok("`") && listed_slug_ok("z-0") && !listed_slug_ok(":") && !listed_slug_ok("/");
}

// A row's field k (0-based) by '|', or "" past the last.
listed_field :: (row: string, k: int) -> string {
  f := 0; at := 0;
  for i: 0..<row.count + 1 {
    if i < row.count && row[i] != '|' { continue; }
    if f == k { return row[at..<i]; }
    f += 1; at = i + 1;
  }
  return "";
}
// A row the page shows: five fields, a slug, a title and "YYYY-MM-DDTHH:MM".
listed_row_ok :: (row: string) -> bool {
  bars := 0;
  for c: row { if c == '|' { bars += 1; } }
  if bars != 4 || !listed_slug_ok(listed_field(row, 0)) || listed_field(row, 1).count == 0 { return false; }
  t := listed_field(row, 3);
  return t.count == 16 && t[4] == '-' && t[7] == '-' && t[10] == 'T' && t[13] == ':';
}
#test "rows" {
  #assert listed_row_ok("farm|Farm|A meadow by day|2026-10-31T09:05|lowpoly") && listed_row_ok("farm|Farm||2026-10-31T09:05|");
  #assert !listed_row_ok("farm|Farm|A meadow|2026-10-31T09:05") && !listed_row_ok("farm|Farm|A|meadow|2026-10-31T09:05|lowpoly");
  #assert !listed_row_ok("Farm|Farm|x|2026-10-31T09:05|s") && !listed_row_ok("farm||x|2026-10-31T09:05|s") && !listed_row_ok("farm|Farm|x|2026-10-31|s");
  #assert !listed_row_ok("farm|Farm|x|2026-10-31 09:05|s") && !listed_row_ok("farm|Farm|x|2026/10-31T09:05|s") && !listed_row_ok("farm|Farm|x|2026-10/31T09:05|s");
  #assert !listed_row_ok("farm|Farm|x|2026-10-31T09-05|s") && !listed_row_ok("farm|Farm|x|2026-10-31T09:055|s") && !listed_row_ok("");
  #assert listed_field("|b", 0) == "" && listed_field("a|b|c", 0) == "a" && listed_field("a|b|c", 2) == "c" && listed_field("a|b|c", 3) == "" && listed_field("", 0) == "";
}

#test "a prefix" {
  #assert listed_prefix("200\nx", "200\n") && listed_prefix("200\n", "200\n") && !listed_prefix("200", "200\n") && !listed_prefix("404\n", "200\n");
}
listed_prefix :: (s: string, p: string) -> bool { return s.count >= p.count && s[0..<p.count] == p; }

// "total N": N, or -1.
listed_total :: (line: string) -> int {
  if line.count < 7 || line.count > 15 || line[0..<6] != "total " { return -1; }
  n := 0;
  for c: line[6..<line.count] {
    if c < '0' || c > '9' { return -1; }
    n = n * 10 + cast(int) (c - '0');
  }
  return n;
}
#test "the total" {
  #assert listed_total("total 0") == 0 && listed_total("total 15") == 15 && listed_total("total 123456789") == 123456789;
  #assert listed_total("total ") == -1 && listed_total("total x") == -1 && listed_total("totals 5") == -1 && listed_total("total 5x") == -1;
  #assert listed_total("total 1234567890") == -1 && listed_total("") == -1 && listed_total("total /") == -1 && listed_total("total :") == -1;
}

// The answer ("STATUS\n" and the body) into into, each row ending in '\n', at most room rows.
// Nothing on a status but 200 or a body without its total.
listed_read :: (answer: string, into: [] u8, room: int) -> Listed {
  got: Listed;
  if !listed_prefix(answer, "200\n") { return got; }
  body := answer[4..<answer.count];
  total := -1;
  at := 0;
  while at <= body.count {
    end := at;
    while end < body.count && body[end] != '\n' { end += 1; }
    line := body[at..<end];
    at = end + 1;
    if total < 0 { total = listed_total(line); if total < 0 { return got; } continue; }
    if !listed_row_ok(line) { continue; }
    if got.rows >= room || got.n + line.count + 1 > into.count { continue; }
    for i: 0..<line.count { into[got.n + i] = line[i]; }
    into[got.n + line.count] = '\n';
    got.n += line.count + 1;
    got.rows += 1;
  }
  got.more = total - got.rows;   // 0 or less: none left out
  return got;
}
#test "an answer read" {
  buf: [256] u8;
  a := listed_read("200\ntotal 3\nfarm|Farm|A meadow|2026-10-31T09:05|lowpoly\nbad row\nmoon|Moon||2026-10-30T01:00|flat\n", buf[..], 10);
  #assert a.rows == 2 && a.more == 1 && cast(string) buf[0..<a.n] == "farm|Farm|A meadow|2026-10-31T09:05|lowpoly\nmoon|Moon||2026-10-30T01:00|flat\n";
  b := listed_read("200\ntotal 2\nfarm|Farm|A meadow|2026-10-31T09:05|lowpoly\nmoon|Moon||2026-10-30T01:00|flat", buf[..], 1);
  #assert b.rows == 1 && b.more == 1 && b.n == 44;
  #assert listed_read("404\ntotal 2\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9).rows == 0 && listed_read("200\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9).rows == 0;
  #assert listed_read("200\n", buf[..], 9).more == 0 && listed_read("200\ntotal 0\n", buf[..], 9).rows == 0 && listed_read("", buf[..], 9).more == 0 && listed_read("200", buf[..], 9).rows == 0;
  c := listed_read("200\ntotal 1\nfarm|Farm|A|2026-10-31T09:05|s\nmoon|Moon|B|2026-10-30T01:00|s\n", buf[..], 9);
  #assert c.rows == 2 && c.more == -1;   // the rows it sent count, whatever the total says
  z := listed_read("200\ntotal 0\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9);
  #assert z.rows == 1 && z.more == -1;
  #assert listed_read("200\n\ntotal 1\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9).rows == 0;
  exact: [29] u8;
  #assert listed_read("200\ntotal 1\nab|Farm|A|2026-10-31T09:05|s\n", exact[..], 9).rows == 1;
  small: [30] u8;
  d := listed_read("200\ntotal 2\nfarm|Farm|A|2026-10-31T09:05|s\nmoon|Moon|B|2026-10-30T01:00|s\n", small[..], 9);
  #assert d.rows == 0 && d.n == 0 && d.more == 2;
  e := listed_read("200\ntotal 2\nab|Farm|A|2026-10-31T09:05|s\nmoon|Moon|B|2026-10-30T01:00|s\n", small[..], 9);
  #assert e.rows == 1 && e.n == 29 && e.more == 1;
  #assert listed_read("201\ntotal 1\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9).rows == 0 && listed_read("200\ntotal 5\n", buf[..], 0).more == 5;
  #assert listed_read("2000total 1\nfarm|Farm|A|2026-10-31T09:05|s\n", buf[..], 9).rows == 0;
}
