// Saves of a realm, as the engine keeps them (aethyr-cpp docs/save.md): a
// versioned snapshot in an AESV container with a CRC-32, in two slots, the
// current save and the last good one. A load tries the current save, then
// the previous one, so a corrupted save falls back to the last good one.
// The page keeps the record in this browser (IndexedDB, through the host's
// action 4), and a player who joined with an email also on the server
// (/api/playtest/progress, coax/web/api/player.c), which checks the same
// container. The server keeps a save only from the revision there now
// (coax/web/api/progress-policy.coax, #12719), so a page names the revision
// it saved from (SaveSync below) and no device's clock decides which save
// wins. A server from before revisions answers none: then the newer of the
// two by time wins, as before.
//
// The container (docs/save.md "The binary format"):
//   "AESV", container version (2), layer (2: player progress), 2 reserved,
//   schema (u32 LE), varint + the world id, varint + the payload, CRC-32 LE
//   of everything before it.
// The record the browser keeps, a line each:
//   verse-save 1 / the current save's time (ms) / its container, base64 /
//   the previous save's time / its container, base64 (both may be empty)
// Migrations forward: a record from before containers (the house's save as
// bare hex, what the page kept until now) opens as schema 0 and is kept
// again as a container of this build's schema. A newer schema than this
// build knows is refused, never guessed at.

SAVE_VERSION :: 2;
SAVE_PROGRESS :: 2;
SAVE_HEAD :: "verse-save 1\n";

SAVE_POLY :: cast(u32) 0xEDB88320;
save_crc_table :: () -> [256] u32 {
  table: [256] u32;
  for n: 0..<256 {
    c := cast(u32) n;
    for k: 0..<8 { c = ifx c & 1 == 1 then SAVE_POLY ^ (c >> 1) else c >> 1; }
    table[n] = c;
  }
  return table;
}
// The table save_crc_table makes, written out: each literal element costs one
// compile-time step where the #run cost about 32,000 of the compile's shared
// 100,000 (everglade5e sat at 99%). The #test below checks it against the procedure.
SAVE_CRC :: [256] u32.[
  0x00000000, 0x77073096, 0xEE0E612C, 0x990951BA, 0x076DC419, 0x706AF48F, 0xE963A535, 0x9E6495A3,
  0x0EDB8832, 0x79DCB8A4, 0xE0D5E91E, 0x97D2D988, 0x09B64C2B, 0x7EB17CBD, 0xE7B82D07, 0x90BF1D91,
  0x1DB71064, 0x6AB020F2, 0xF3B97148, 0x84BE41DE, 0x1ADAD47D, 0x6DDDE4EB, 0xF4D4B551, 0x83D385C7,
  0x136C9856, 0x646BA8C0, 0xFD62F97A, 0x8A65C9EC, 0x14015C4F, 0x63066CD9, 0xFA0F3D63, 0x8D080DF5,
  0x3B6E20C8, 0x4C69105E, 0xD56041E4, 0xA2677172, 0x3C03E4D1, 0x4B04D447, 0xD20D85FD, 0xA50AB56B,
  0x35B5A8FA, 0x42B2986C, 0xDBBBC9D6, 0xACBCF940, 0x32D86CE3, 0x45DF5C75, 0xDCD60DCF, 0xABD13D59,
  0x26D930AC, 0x51DE003A, 0xC8D75180, 0xBFD06116, 0x21B4F4B5, 0x56B3C423, 0xCFBA9599, 0xB8BDA50F,
  0x2802B89E, 0x5F058808, 0xC60CD9B2, 0xB10BE924, 0x2F6F7C87, 0x58684C11, 0xC1611DAB, 0xB6662D3D,
  0x76DC4190, 0x01DB7106, 0x98D220BC, 0xEFD5102A, 0x71B18589, 0x06B6B51F, 0x9FBFE4A5, 0xE8B8D433,
  0x7807C9A2, 0x0F00F934, 0x9609A88E, 0xE10E9818, 0x7F6A0DBB, 0x086D3D2D, 0x91646C97, 0xE6635C01,
  0x6B6B51F4, 0x1C6C6162, 0x856530D8, 0xF262004E, 0x6C0695ED, 0x1B01A57B, 0x8208F4C1, 0xF50FC457,
  0x65B0D9C6, 0x12B7E950, 0x8BBEB8EA, 0xFCB9887C, 0x62DD1DDF, 0x15DA2D49, 0x8CD37CF3, 0xFBD44C65,
  0x4DB26158, 0x3AB551CE, 0xA3BC0074, 0xD4BB30E2, 0x4ADFA541, 0x3DD895D7, 0xA4D1C46D, 0xD3D6F4FB,
  0x4369E96A, 0x346ED9FC, 0xAD678846, 0xDA60B8D0, 0x44042D73, 0x33031DE5, 0xAA0A4C5F, 0xDD0D7CC9,
  0x5005713C, 0x270241AA, 0xBE0B1010, 0xC90C2086, 0x5768B525, 0x206F85B3, 0xB966D409, 0xCE61E49F,
  0x5EDEF90E, 0x29D9C998, 0xB0D09822, 0xC7D7A8B4, 0x59B33D17, 0x2EB40D81, 0xB7BD5C3B, 0xC0BA6CAD,
  0xEDB88320, 0x9ABFB3B6, 0x03B6E20C, 0x74B1D29A, 0xEAD54739, 0x9DD277AF, 0x04DB2615, 0x73DC1683,
  0xE3630B12, 0x94643B84, 0x0D6D6A3E, 0x7A6A5AA8, 0xE40ECF0B, 0x9309FF9D, 0x0A00AE27, 0x7D079EB1,
  0xF00F9344, 0x8708A3D2, 0x1E01F268, 0x6906C2FE, 0xF762575D, 0x806567CB, 0x196C3671, 0x6E6B06E7,
  0xFED41B76, 0x89D32BE0, 0x10DA7A5A, 0x67DD4ACC, 0xF9B9DF6F, 0x8EBEEFF9, 0x17B7BE43, 0x60B08ED5,
  0xD6D6A3E8, 0xA1D1937E, 0x38D8C2C4, 0x4FDFF252, 0xD1BB67F1, 0xA6BC5767, 0x3FB506DD, 0x48B2364B,
  0xD80D2BDA, 0xAF0A1B4C, 0x36034AF6, 0x41047A60, 0xDF60EFC3, 0xA867DF55, 0x316E8EEF, 0x4669BE79,
  0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236, 0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F,
  0xC5BA3BBE, 0xB2BD0B28, 0x2BB45A92, 0x5CB36A04, 0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
  0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A, 0x9C0906A9, 0xEB0E363F, 0x72076785, 0x05005713,
  0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38, 0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21,
  0x86D3D2D4, 0xF1D4E242, 0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
  0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69, 0x616BFFD3, 0x166CCF45,
  0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2, 0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB,
  0xAED16A4A, 0xD9D65ADC, 0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
  0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693, 0x54DE5729, 0x23D967BF,
  0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94, 0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D
];

save_crc32 :: (b: [] u8, n: int) -> u32 {
  crc: u32 = 0xFFFF_FFFF;
  for i: 0..<n { crc = SAVE_CRC[cast(int) ((crc ^ cast(u32) b[i]) & 0xFF)] ^ (crc >> 8); }
  return crc ^ 0xFFFF_FFFF;
}

save_varint :: (out: [] u8, at: int, v: int) -> int {
  x := v; i := at;
  while true {
    if i >= out.count { return -1; }
    if x < 128 { out[i] = cast(u8) x; return i + 1; }
    out[i] = cast(u8) ((x & 127) | 128); x = x >> 7; i += 1;
  }
  return -1;
}

// book:begin pack
// payload packed into out as a progress container; its length, or -1 when it doesn't fit.
save_pack :: (world: string, schema: int, payload: [] u8, n: int, out: [] u8) -> int #export_c {
  if out.count < 16 + world.count + n || n < 0 || n > payload.count { return -1; }
  out[0] = 65; out[1] = 69; out[2] = 83; out[3] = 86;
  out[4] = SAVE_VERSION; out[5] = SAVE_PROGRESS; out[6] = 0; out[7] = 0;
  for k: 0..<4 { out[8 + k] = cast(u8) ((schema >> (8 * k)) & 255); }
  i := save_varint(out, 12, world.count);
  if i < 0 || i + world.count > out.count { return -1; }
  for k: 0..<world.count { out[i + k] = world[k]; }
  i = save_varint(out, i + world.count, n);
  if i < 0 || i + n + 4 > out.count { return -1; }
  for k: 0..<n { out[i + k] = payload[k]; }
  i += n;
  crc := save_crc32(out, i);
  for k: 0..<4 { out[i + k] = cast(u8) ((crc >> cast(u32) (8 * k)) & 255); }
  return i + 4;
}
// book:end pack

SaveOpened :: struct { ok: bool; schema: int; at: int; count: int; }   // the payload: bytes[at..<at+count]

save_read_varint :: (b: [] u8, n: int, at: [] int) -> int {
  v := 0; shift := 0;
  while at[0] < n && shift < 35 {
    c := cast(int) b[at[0]]; at[0] += 1;
    v = v | ((c & 127) << shift);
    if c < 128 { return v; }
    shift += 7;
  }
  return -1;
}

// book:begin open
// A container's payload, when its magic, version, layer, CRC and world are
// right and its schema is one this build knows (at most max_schema).
save_open :: (b: [] u8, n: int, world: string, max_schema: int) -> SaveOpened #export_c {
  no: SaveOpened;
  if n < 18 || n > b.count || b[0] != 65 || b[1] != 69 || b[2] != 83 || b[3] != 86 { return no; }
  if (b[4] != 1 && b[4] != 2) || b[5] != SAVE_PROGRESS { return no; }
  want := cast(u32) b[n - 4] | (cast(u32) b[n - 3] << 8) | (cast(u32) b[n - 2] << 16) | (cast(u32) b[n - 1] << 24);
  if save_crc32(b, n - 4) != want { return no; }
  schema := cast(int) b[8] | (cast(int) b[9] << 8) | (cast(int) b[10] << 16) | (cast(int) b[11] << 24);
  if schema > max_schema { return no; }
  at: [1] int; at[0] = 12;
  wn := save_read_varint(b, n - 4, at[..]);
  if wn != world.count || at[0] + wn > n - 4 { return no; }
  for k: 0..<wn { if b[at[0] + k] != world[k] { return no; } }
  at[0] += wn;
  pn := save_read_varint(b, n - 4, at[..]);
  if pn < 0 || at[0] + pn != n - 4 { return no; }
  return SaveOpened.{ok = true, schema = schema, at = at[0], count = pn};
}
// book:end open

// ---- base64 (RFC 4648, padded), for the record and the server
SAVE_B64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
save_b64_digit :: (c: u8) -> int {
  if c >= 65 && c <= 90 { return cast(int) c - 65; }
  if c >= 97 && c <= 122 { return cast(int) c - 71; }
  if c >= 48 && c <= 57 { return cast(int) c + 4; }
  if c == 43 { return 62; }
  if c == 47 { return 63; }
  return -1;
}
save_b64 :: (b: [] u8, n: int, out: [] u8, at: int) -> int {
  i := 0; o := at;
  while i < n {
    if o + 4 > out.count { return -1; }
    a := cast(int) b[i];
    c1 := ifx i + 1 < n then cast(int) b[i + 1] else 0;
    c2 := ifx i + 2 < n then cast(int) b[i + 2] else 0;
    out[o] = SAVE_B64[a >> 2];
    out[o + 1] = SAVE_B64[((a & 3) << 4) | (c1 >> 4)];
    out[o + 2] = ifx i + 1 < n then SAVE_B64[((c1 & 15) << 2) | (c2 >> 6)] else 61;
    out[o + 3] = ifx i + 2 < n then SAVE_B64[c2 & 63] else 61;
    i += 3; o += 4;
  }
  return o;
}
// text's base64 into out from at; the bytes written, or -1 when it isn't base64.
save_unb64 :: (text: string, out: [] u8, at: int) -> int {
  if text.count % 4 != 0 { return -1; }
  o := at; i := 0;
  while i < text.count {
    d: [4] int;
    for k: 0..<4 { d[k] = ifx text[i + k] == 61 && i + 4 == text.count && k >= 2 then -2 else save_b64_digit(text[i + k]); }
    if d[0] < 0 || d[1] < 0 || d[2] == -1 || d[3] == -1 || (d[2] == -2 && d[3] != -2) { return -1; }
    got := ifx d[2] == -2 then 1 else ifx d[3] == -2 then 2 else 3;
    if o + got > out.count { return -1; }
    out[o] = cast(u8) ((d[0] << 2) | (d[1] >> 4));
    if got > 1 { out[o + 1] = cast(u8) (((d[1] & 15) << 4) | (d[2] >> 2)); }
    if got > 2 { out[o + 2] = cast(u8) (((d[2] & 3) << 6) | d[3]); }
    o += got; i += 4;
  }
  return o - at;
}

// ---- the two slots
SaveSlots :: struct {
  cur: int; cur_n: int; cur_at: f64;     // the current save: bytes[cur..<cur+cur_n]
  prev: int; prev_n: int; prev_at: f64;  // the last good one
  legacy: bool;                          // a bare-hex save from before containers (cur, schema 0)
}

save_line :: (text: string, at: [] int) -> string {
  s := at[0];
  while at[0] < text.count && text[at[0]] != 10 { at[0] += 1; }
  line := text[s..<at[0]];
  if at[0] < text.count { at[0] += 1; }
  return line;
}
save_number :: (s: string) -> f64 {
  v: f64 = 0; any_digit := false;
  for i: 0..<s.count {
    c := s[i];
    if c == 46 { break; }
    if c < 48 || c > 57 { return -1; }
    v = v * 10 + cast(f64) (cast(int) c - 48); any_digit = true;
  }
  return ifx any_digit then v else -1;
}
save_hex :: (c: u8) -> int { return ifx c >= 48 && c <= 57 then cast(int) c - 48 else ifx c >= 97 && c <= 102 then cast(int) c - 87 else -1; }

// The record the browser kept, decoded into bytes: the current save first,
// the previous after it. A part that doesn't decode is left out (n 0).
save_read :: (text: string, bytes: [] u8) -> SaveSlots #export_c {
  s: SaveSlots;
  if text.count >= SAVE_HEAD.count && text[0..<SAVE_HEAD.count] == SAVE_HEAD {
    at: [1] int; at[0] = SAVE_HEAD.count;
    s.cur_at = save_number(save_line(text, at[..]));
    n := save_unb64(save_line(text, at[..]), bytes, 0);
    if n > 0 { s.cur_n = n; } else { s.cur_n = 0; }
    s.prev = s.cur_n;
    s.prev_at = save_number(save_line(text, at[..]));
    m := save_unb64(save_line(text, at[..]), bytes, s.prev);
    if m > 0 { s.prev_n = m; }
    return s;
  }
  // before containers: the save as bare hex
  if text.count == 0 || text.count % 2 != 0 || text.count / 2 > bytes.count { return s; }
  for i: 0..<text.count / 2 {
    a := save_hex(text[2 * i]); b := save_hex(text[2 * i + 1]);
    if a < 0 || b < 0 { return s; }
    bytes[i] = cast(u8) (a * 16 + b);
  }
  s.cur_n = text.count / 2; s.legacy = true; s.cur_at = 0;
  return s;
}

// The record for a new current save `cur`: the old current becomes the
// previous one when it was a good container, else the old previous stays.
// old: the slots' bytes; its length into out, or -1 when it doesn't fit.
save_record :: (cur: [] u8, n: int, at: f64, old: [] u8, s: SaveSlots, world: string, max_schema: int, out: [] u8) -> int #export_c {
  o := 0;
  head := SAVE_HEAD;
  if out.count < head.count + 64 { return -1; }
  for k: 0..<head.count { out[k] = head[k]; }
  o = head.count;
  o = save_put_number(out, o, at); if o < 0 { return -1; }
  o = save_b64(cur, n, out, o); if o < 0 || o >= out.count { return -1; }
  out[o] = 10; o += 1;
  keep_cur := !s.legacy && s.cur_n > 0 && save_open(old[s.cur..<s.cur + s.cur_n], s.cur_n, world, max_schema).ok;
  keep_prev := s.prev_n > 0 && save_open(old[s.prev..<s.prev + s.prev_n], s.prev_n, world, max_schema).ok;
  if keep_cur {
    o = save_put_number(out, o, s.cur_at); if o < 0 { return -1; }
    o = save_b64(old[s.cur..<s.cur + s.cur_n], s.cur_n, out, o);
  } else if keep_prev {
    o = save_put_number(out, o, s.prev_at); if o < 0 { return -1; }
    o = save_b64(old[s.prev..<s.prev + s.prev_n], s.prev_n, out, o);
  } else {
    if o + 1 > out.count { return -1; }
    out[o] = 10; o += 1;
  }
  if o < 0 || o >= out.count { return -1; }
  out[o] = 10;
  return o + 1;
}
save_put_number :: (out: [] u8, at: int, v: f64) -> int {
  digits: [24] u8; n := 0;
  x := cast(int) (ifx v < 0 then 0 else v);
  if x == 0 { digits[0] = 48; n = 1; }
  while x > 0 && n < 24 { digits[n] = cast(u8) (48 + x % 10); x = x / 10; n += 1; }
  if at + n + 1 > out.count { return -1; }
  for k: 0..<n { out[at + k] = digits[n - 1 - k]; }
  out[at + n] = 10;
  return at + n + 1;
}

// book:begin pick
SavePick :: struct { which: int; at: int; count: int; schema: int; time: f64; }   // which: 0 none, 1 current, 2 previous
// The save to load, trying the current one first (from `from`: 1, or 2 when
// the current one opened but its house didn't), then the last good one.
save_pick :: (bytes: [] u8, s: SaveSlots, world: string, max_schema: int, from: int) -> SavePick #export_c {
  none: SavePick;
  if from <= 1 && s.cur_n > 0 {
    if s.legacy { return SavePick.{which = 1, at = s.cur, count = s.cur_n, schema = 0, time = 0}; }
    o := save_open(bytes[s.cur..<s.cur + s.cur_n], s.cur_n, world, max_schema);
    if o.ok { return SavePick.{which = 1, at = s.cur + o.at, count = o.count, schema = o.schema, time = s.cur_at}; }
  }
  if s.prev_n > 0 {
    o := save_open(bytes[s.prev..<s.prev + s.prev_n], s.prev_n, world, max_schema);
    if o.ok { return SavePick.{which = 2, at = s.prev + o.at, count = o.count, schema = o.schema, time = s.prev_at}; }
  }
  return none;
}
// book:end pick

// ---- the server: {"current": {"at", "bytes"}, "previous": ...} into the same slots
save_find :: (text: string, from: int, what: string) -> int {
  if what.count == 0 { return -1; }
  i := from;
  while i + what.count <= text.count {
    if text[i..<i + what.count] == what { return i + what.count; }
    i += 1;
  }
  return -1;
}
save_server_part :: (text: string, key: string, bytes: [] u8, at: int, time: [] f64) -> int {
  k := save_find(text, 0, key);
  if k < 0 || k + 1 > text.count || text[k] != 123 { return 0; }
  end := k;
  while end < text.count && text[end] != 125 { end += 1; }
  part := text[k..<end];
  b := save_find(part, 0, "\"bytes\": \"");
  if b < 0 { b = save_find(part, 0, "\"bytes\":\""); }
  t := save_find(part, 0, "\"at\": ");
  if t < 0 { t = save_find(part, 0, "\"at\":"); }
  if b < 0 || t < 0 { return 0; }
  e := b;
  while e < part.count && part[e] != 34 { e += 1; }
  q := t;
  while q < part.count && ((part[q] >= 48 && part[q] <= 57) || part[q] == 46) { q += 1; }
  time[0] = save_number(part[t..<q]);
  n := save_unb64(part[b..<e], bytes, at);
  return ifx n > 0 then n else 0;
}
// The server's answer ("STATUS\n" then the body) as slots; none when it isn't a 200.
save_from_server :: (answer: string, bytes: [] u8) -> SaveSlots #export_c {
  s: SaveSlots;
  if answer.count < 4 || answer[0..<4] != "200\n" { return s; }
  return save_slots_of(answer[4..<answer.count], bytes);
}
// A 409's saves (what is on the server now), as slots; none when it isn't a 409.
save_from_conflict :: (answer: string, bytes: [] u8) -> SaveSlots #export_c {
  s: SaveSlots;
  if answer.count < 4 || answer[0..<4] != "409\n" { return s; }
  return save_slots_of(answer[4..<answer.count], bytes);
}
save_slots_of :: (body: string, bytes: [] u8) -> SaveSlots {
  s: SaveSlots;
  t: [1] f64;
  s.cur_n = save_server_part(body, "\"current\": ", bytes, 0, t[..]);
  if s.cur_n == 0 { s.cur_n = save_server_part(body, "\"current\":", bytes, 0, t[..]); }
  s.cur_at = t[0];
  s.prev = s.cur_n;
  s.prev_n = save_server_part(body, "\"previous\": ", bytes, s.prev, t[..]);
  if s.prev_n == 0 { s.prev_n = save_server_part(body, "\"previous\":", bytes, s.prev, t[..]); }
  s.prev_at = t[0];
  return s;
}

// The body that saves a container on the server: {"bytes": base64, "at": ms}.
save_post_body :: (c: [] u8, n: int, at: f64, out: [] u8) -> int #export_c {
  head := "{\"bytes\":\"";
  if out.count < head.count + 40 { return -1; }
  for k: 0..<head.count { out[k] = head[k]; }
  o := save_b64(c, n, out, head.count);
  tail := "\",\"at\":";
  if o < 0 || o + tail.count + 26 > out.count { return -1; }
  for k: 0..<tail.count { out[o + k] = tail[k]; }
  o = save_put_number(out, o + tail.count, at);
  if o < 0 { return -1; }
  out[o - 1] = 125;   // the number's line end becomes the closing brace
  return o;
}

// ---- revisions (#12719): the revision a page saves from, and what it does with the answer
//
// rev is the slot's revision as the server last answered it (has: it answered one; a server from
// before revisions never does). All zero is a SaveSync's start, so a C face's static one is ready. One save is in flight at a time: a save asked for meanwhile waits for its answer
// (again). A page of progress also waits for the server's copy it asked for (asked, known), so it
// never sends from no revision; a page of SAVE_MINE needn't (its 409 sends it again). A page being left
// sends at once, from the revision the save in flight makes. A 409 carries the revision and the
// saves there now: a page of progress takes the server's (SAVE_THEIRS: it is newer by revision);
// a page of where you are or your spell bar sends its own again from that revision (SAVE_MINE:
// what you just did on this device is what you meant last).
SAVE_DONE :: 0;
SAVE_THEIRS :: 1;   // open the server's save: it is newer by revision
SAVE_MINE :: 2;     // send this device's again, now
SAVE_WAIT :: -2;    // save_sync_send: not now; SAVE_MINE comes when it may go
SaveSync :: struct {
  rev: int;
  has: bool;      // rev is the server's
  asked: bool;    // the server's copy was asked for (save_sync_ask)
  known: bool;    // and it (or its failure) has come
  busy: bool;     // a save is in flight
  again: bool;    // one was asked for while it was
}
// The answer's status: the number before its first line end (0 none).
save_status :: (answer: string) -> int {
  v := 0; i := 0;
  while i < answer.count && i < 4 && answer[i] >= 48 && answer[i] <= 57 { v = v * 10 + cast(int) answer[i] - 48; i += 1; }
  return ifx i > 0 && i < answer.count && answer[i] == 10 then v else 0;
}
// The revision in a 200 or 409 answer's body ("rev": N); -1 when it names none.
save_rev :: (answer: string) -> int #export_c {
  st := save_status(answer);
  if st != 200 && st != 409 { return -1; }
  k := save_find(answer, 4, "\"rev\": ");
  if k < 0 { k = save_find(answer, 4, "\"rev\":"); }
  if k < 0 || k >= answer.count || answer[k] < 48 || answer[k] > 57 { return -1; }
  v := 0;
  while k < answer.count && answer[k] >= 48 && answer[k] <= 57 && v < 1000000000000000 { v = v * 10 + cast(int) answer[k] - 48; k += 1; }
  return v;
}
// The server's copy was asked for: saves wait for it.
save_sync_ask :: (s: [] SaveSync) #export_c { s[0].asked = true; }
// The server's copy came (its answer, any status). SAVE_MINE when a save waited for it.
save_sync_read :: (s: [] SaveSync, answer: string) -> int #export_c {
  r := save_rev(answer);
  if !s[0].has && r >= 0 { s[0].rev = r; s[0].has = true; }
  s[0].known = true;
  if s[0].again && !s[0].busy { s[0].again = false; return SAVE_MINE; }
  return SAVE_DONE;
}
// A save is to go: the revision to name (-1 none), or SAVE_WAIT. leaving: the page is being left
// (sent at once, nothing comes back).
save_sync_send :: (s: [] SaveSync, leaving: bool) -> int #export_c {
  if leaving { return ifx !s[0].has then -1 else ifx s[0].busy then s[0].rev + 1 else s[0].rev; }
  if s[0].busy || (s[0].asked && !s[0].known) { s[0].again = true; return SAVE_WAIT; }
  s[0].busy = true;
  return ifx s[0].has then s[0].rev else -1;
}
// The save in flight was never sent (the host had no room for it).
save_sync_unsent :: (s: [] SaveSync) #export_c { s[0].busy = false; s[0].again = true; }
// The answer to the save in flight. mine: what a 409 means for this page (SAVE_THEIRS, SAVE_MINE).
// SAVE_DONE, SAVE_THEIRS (open the 409's saves) or SAVE_MINE (send again now).
save_sync_heard :: (s: [] SaveSync, answer: string, mine: int) -> int #export_c {
  s[0].busy = false;
  r := save_rev(answer);
  if r >= 0 { s[0].rev = r; s[0].has = true; }
  if save_status(answer) == 409 && r >= 0 {
    s[0].again = false;
    return ifx mine == SAVE_THEIRS then SAVE_THEIRS else SAVE_MINE;
  }
  if s[0].again { s[0].again = false; return SAVE_MINE; }
  return SAVE_DONE;
}
// Whether the server answered with revisions: then its copy is the account's, newer than this
// browser's whatever the clocks say.
save_sync_revised :: (s: [] SaveSync) -> bool #export_c { return s[0].has; }
// Whether two slots' current saves are the same bytes (the server's copy is what this browser has).
save_same :: (a: [] u8, sa: SaveSlots, b: [] u8, sb: SaveSlots) -> bool #export_c {
  if sa.cur_n == 0 || sa.cur_n != sb.cur_n { return false; }
  for i: 0..<sa.cur_n { if a[sa.cur + i] != b[sb.cur + i] { return false; } }
  return true;
}
// The body that saves a container on the server from revision rev: {"bytes", "at", "rev"} ("rev"
// left out when rev < 0: an old server reads "at", a new one the revision).
save_post_rev :: (c: [] u8, n: int, at: f64, rev: int, out: [] u8) -> int #export_c {
  o := save_post_body(c, n, at, out);
  if o < 0 || rev < 0 { return o; }
  tail := ",\"rev\":";
  if o + tail.count + 24 > out.count { return -1; }
  o -= 1;   // the closing brace
  for k: 0..<tail.count { out[o + k] = tail[k]; }
  o = save_put_number(out, o + tail.count, cast(f64) rev);
  if o < 0 { return -1; }
  out[o - 1] = 125;
  return o;
}

#test "the written-out CRC-32 table is the one save_crc_table makes" {
  made := save_crc_table();
  for n: 0..<256 { #assert SAVE_CRC[n] == made[n]; }
}

#test "a save packs into an AESV container that opens again, and a corrupted save falls back to the last good one" {
  payload := "the house: room 3, two haunts found";
  p: [64] u8;
  for k: 0..<payload.count { p[k] = payload[k]; }
  a: [128] u8; b: [128] u8;
  an := save_pack("haunted-house", 1, p[..], payload.count, a[..]);
  #assert an == 12 + 1 + 13 + 1 + payload.count + 4;
  #assert a[0] == 65 && a[4] == 2 && a[5] == 2 && a[8] == 1;
  o := save_open(a[..], an, "haunted-house", 1);
  #assert o.ok && o.count == payload.count && cast(string) a[o.at..<o.at + o.count] == payload;
  #assert !save_open(a[..], an, "dead-gears", 1).ok;              // another world's save
  #assert !save_open(a[..], an, "haunted-house", 0).ok;           // newer than this build
  // the zlib check value: crc32("123456789")
  nine: [9] u8;
  for k: 0..<9 { nine[k] = cast(u8) (49 + k); }
  #assert save_crc32(nine[..], 9) == 0xCBF43926;
  // two saves in the record, then the current one corrupted
  p[0] = 84; p[1] = 72; p[2] = 69;
  bn := save_pack("haunted-house", 1, p[..], payload.count, b[..]);
  empty: [1] u8; none: SaveSlots;
  r1: [1024] u8;
  n1 := save_record(a[..], an, 1000, empty[..], none, "haunted-house", 1, r1[..]);
  slots: [512] u8;
  s1 := save_read(cast(string) r1[0..<n1], slots[..]);
  #assert s1.cur_n == an && s1.prev_n == 0 && s1.cur_at == 1000;
  r2: [1024] u8;
  n2 := save_record(b[..], bn, 2000, slots[..], s1, "haunted-house", 1, r2[..]);
  back: [512] u8;
  s2 := save_read(cast(string) r2[0..<n2], back[..]);
  #assert s2.cur_n == bn && s2.prev_n == an && s2.cur_at == 2000 && s2.prev_at == 1000;
  k := save_pick(back[..], s2, "haunted-house", 1, 1);
  #assert k.which == 1 && k.time == 2000 && back[k.at] == 84;
  back[s2.cur + 20] = back[s2.cur + 20] ^ 1;                     // a flipped bit in the current save
  k = save_pick(back[..], s2, "haunted-house", 1, 1);
  #assert k.which == 2 && k.time == 1000 && cast(string) back[k.at..<k.at + k.count] == payload;
  // a current save whose house didn't open: the last good one
  #assert save_pick(back[..], s2, "haunted-house", 1, 2).which == 2;
  // the bad one is never kept as the previous: a new save keeps the last good one
  r3: [1024] u8;
  n3 := save_record(a[..], an, 3000, back[..], s2, "haunted-house", 1, r3[..]);
  again: [512] u8;
  s3 := save_read(cast(string) r3[0..<n3], again[..]);
  #assert s3.prev_n == an && s3.prev_at == 1000;
  // both broken: nothing to load
  back[s2.prev + 3] = 0;
  #assert save_pick(back[..], s2, "haunted-house", 1, 1).which == 0;
}

#test "migrations forward: the bare-hex save from before containers opens as schema 0" {
  bytes: [16] u8;
  s := save_read("0a0b0cff", bytes[..]);
  #assert s.legacy && s.cur_n == 4 && bytes[3] == 255;
  k := save_pick(bytes[..], s, "haunted-house", 1, 1);
  #assert k.which == 1 && k.schema == 0 && k.count == 4;
  #assert save_read("0a0", bytes[..]).cur_n == 0 && save_read("zz", bytes[..]).cur_n == 0;
}

#test "the server's answer and body: base64 both ways, the newer save known by its time" {
  p: [8] u8; c: [64] u8;
  p[0] = 1; p[1] = 2; p[2] = 250;
  cn := save_pack("haunted-house", 1, p[..], 3, c[..]);
  body: [256] u8;
  bn := save_post_body(c[..], cn, 1793222723475, body[..]);
  text := cast(string) body[0..<bn];
  #assert text[0..<10] == "{\"bytes\":\"" && text[bn - 21..<bn] == "\",\"at\":1793222723475}";
  b64 := text[10..<bn - 21];
  answer: [512] u8; an := 0;
  pre := "200\n{\"current\": {\"at\": 1793222723475, \"bytes\": \"";
  for k: 0..<pre.count { answer[an] = pre[k]; an += 1; }
  for k: 0..<b64.count { answer[an] = b64[k]; an += 1; }
  post := "\"}, \"previous\": null}";
  for k: 0..<post.count { answer[an] = post[k]; an += 1; }
  bytes: [128] u8;
  s := save_from_server(cast(string) answer[0..<an], bytes[..]);
  #assert s.cur_n == cn && s.cur_at == 1793222723475 && s.prev_n == 0;
  k := save_pick(bytes[..], s, "haunted-house", 1, 1);
  #assert k.which == 1 && bytes[k.at + 2] == 250;
  #assert save_from_server("403\n{\"error\":\"join\"}", bytes[..]).cur_n == 0;
  out: [8] u8;
  #assert save_unb64("Zm9vYg==", out[..], 0) == 4 && out[3] == 98 && save_unb64("Zm9=", out[..], 0) == 2 && save_unb64("Z===", out[..], 0) == -1;
}

#test "revisions: one save in flight, the revision named, and what a 409 does (#12719)" {
  s: [1] SaveSync;
  save_sync_ask(s[..]);
  #assert !s[0].has && save_sync_send(s[..], false) == SAVE_WAIT && s[0].again;   // before the copy it asked for
  #assert save_sync_read(s[..], "200\n{\"rev\": 4, \"current\": null, \"previous\": null}") == SAVE_MINE && s[0].rev == 4 && s[0].known;
  #assert save_sync_send(s[..], false) == 4 && s[0].busy;
  #assert save_sync_send(s[..], false) == SAVE_WAIT && s[0].again;                      // one in flight
  #assert save_sync_send(s[..], true) == 5;                                             // left: from the revision it makes
  #assert save_sync_heard(s[..], "200\n{\"rev\":5}", SAVE_THEIRS) == SAVE_MINE && s[0].rev == 5 && !s[0].busy && !s[0].again;
  #assert save_sync_send(s[..], false) == 5;
  #assert save_sync_heard(s[..], "200\n{\"rev\": 6}", SAVE_THEIRS) == SAVE_DONE && s[0].rev == 6;
  #assert save_sync_send(s[..], true) == 6;                                             // left, nothing in flight
  // a 409: the revision there now, and the page's choice
  #assert save_sync_send(s[..], false) == 6;
  #assert save_sync_heard(s[..], "409\n{\"rev\": 9, \"error\": \"changed since\"}", SAVE_THEIRS) == SAVE_THEIRS && s[0].rev == 9;
  #assert save_sync_send(s[..], false) == 9;
  _ := save_sync_send(s[..], false);                                                    // waits
  #assert save_sync_heard(s[..], "409\n{\"rev\": 11}", SAVE_MINE) == SAVE_MINE && s[0].rev == 11 && !s[0].again;
  // a server from before revisions: its 409 has none, and changes nothing here
  #assert save_sync_send(s[..], false) == 11;
  #assert save_sync_heard(s[..], "409\n{\"current\": null}", SAVE_THEIRS) == SAVE_DONE && s[0].rev == 11;
  // no answer, or one the host never sent
  #assert save_sync_send(s[..], false) == 11;
  #assert save_sync_heard(s[..], "0\n", SAVE_THEIRS) == SAVE_DONE && !s[0].busy && s[0].rev == 11;
  #assert save_sync_send(s[..], false) == 11;
  save_sync_unsent(s[..]);
  #assert !s[0].busy && s[0].again;
  #assert save_sync_heard(s[..], "200\n{}", SAVE_THEIRS) == SAVE_MINE && s[0].rev == 11;
  // an old server: no revision, so the page names none and the clocks decide as before
  o: [1] SaveSync;
  #assert save_sync_read(o[..], "200\n{\"current\": null, \"previous\": null}") == SAVE_DONE && !save_sync_revised(o[..]);
  #assert save_sync_send(o[..], false) == -1 && save_sync_send(o[..], true) == -1;
  // a page that never asks (SAVE_MINE) sends at once, from no revision until it hears one
  m: [1] SaveSync;
  #assert save_sync_send(m[..], false) == -1 && m[0].busy && !m[0].again;
  #assert save_sync_heard(m[..], "409\n{\"rev\": 4}", SAVE_MINE) == SAVE_MINE && save_sync_send(m[..], false) == 4;
  #assert save_sync_read(s[..], "200\n{\"rev\": 2}") == SAVE_DONE && s[0].rev == 11;  // a late copy never moves it back
  // the answer's parts
  #assert save_rev("200\n{\"rev\": 1793222723475}") == 1793222723475 && save_rev("409\n{\"rev\":0}") == 0;
  #assert save_rev("403\n{\"rev\": 3}") == -1 && save_rev("200\n{\"rev\": x}") == -1 && save_rev("200\n{}") == -1 && save_rev("") == -1;
  #assert save_rev("200\n{\"rev\": ") == -1 && save_rev("200") == -1 && save_rev("20x\n{\"rev\": 3}") == -1;
  #assert save_status("409\n") == 409 && save_status("0\n") == 0 && save_status("200") == 0 && save_status("12345\n") == 0;
}

#test "a 409's saves, the same bytes, and the body that names the revision" {
  p: [8] u8; c: [64] u8;
  p[0] = 7; p[1] = 8;
  cn := save_pack("haunted-house", 1, p[..], 2, c[..]);
  body: [256] u8;
  bn := save_post_rev(c[..], cn, 1793222723475, 12, body[..]);
  text := cast(string) body[0..<bn];
  #assert text[bn - 30..<bn] == "\",\"at\":1793222723475,\"rev\":12}";
  #assert save_post_rev(c[..], cn, 5, -1, body[..]) == save_post_body(c[..], cn, 5, body[..]);
  #assert save_post_rev(c[..], cn, 5, 0, body[..]) > 0 && cast(string) body[0..<4] == "{\"by";
  small: [90] u8;
  #assert save_post_body(c[..], cn, 5, small[..]) > 0 && save_post_rev(c[..], cn, 5, 3, small[..]) == -1;
  b64 := text[10..<bn - 30];
  answer: [512] u8; an := 0;
  pre := "409\n{\"rev\": 3, \"error\": \"changed since\", \"current\": {\"at\": 9, \"bytes\": \"";
  for k: 0..<pre.count { answer[an] = pre[k]; an += 1; }
  for k: 0..<b64.count { answer[an] = b64[k]; an += 1; }
  post := "\"}, \"previous\": null}";
  for k: 0..<post.count { answer[an] = post[k]; an += 1; }
  a := cast(string) answer[0..<an];
  bytes: [128] u8;
  s := save_from_conflict(a, bytes[..]);
  #assert s.cur_n == cn && s.cur_at == 9 && save_from_server(a, bytes[..]).cur_n == 0;
  #assert save_from_conflict("200\n{}", bytes[..]).cur_n == 0 && save_rev(a) == 3;
  mine: [64] u8;
  for k: 0..<cn { mine[k] = c[k]; }
  m: SaveSlots; m.cur_n = cn;
  s = save_from_conflict(a, bytes[..]);
  #assert save_same(bytes[..], s, mine[..], m) && save_same(mine[..], m, bytes[..], s);
  mine[cn - 1] = mine[cn - 1] ^ 1;
  #assert !save_same(bytes[..], s, mine[..], m);
  m.cur_n = cn - 1;
  #assert !save_same(bytes[..], s, mine[..], m);
  none: SaveSlots;
  #assert !save_same(bytes[..], none, mine[..], none);
}
