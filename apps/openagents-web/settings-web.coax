  #assert s[0].envs_state == 1 && s[0].nenvs == 1 && s[0].env_online[0] && s[0].env_nws[0] == 2;
  #assert s[0].aprojs_state == 1 && s[0].naprojs == 1 && s[0].aproj_envs[0] == 1;
