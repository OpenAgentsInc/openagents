  #assert tr_text_of(t, tr_find(t, "home.envs.r.0.n")) == "Chris MacBook";
  #assert tr_text_of(t, tr_find(t, "home.envs.r.0.a")) == "Online · macos · 2 workspaces · openagentsinc/openagents";
  #assert tr_attr_of(t, tr_find(t, "home.envs.go.0"), AT_HREF) == "/chat?host=1111111111111111111111111111111111111111111111111111111111111111";
  #assert tr_text_of(t, tr_find(t, "home.projects.r.0.n")) == "OpenAgents Cloud";
  #assert tr_text_of(t, tr_find(t, "home.projects.r.0.a")) == "openagentsinc/openagents · 1 computer";
  #assert tr_attr_of(t, tr_find(t, "home.projects.go.0"), AT_HREF) == "/chat?project=prj_0123456789abcdef0123456789abcdef";
  #assert tr_find(t, "sw.proj.toggle") > 0;
  s[0].new_proj_open = true;
  sw_gh_status_read(s, 200, "connected 1\nprovider github\nlogin octocat\nscopes repo,read:user\n");
  sw_gh_repos_read(s, 200, "repo OpenAgentsInc/openagents|main|0|https://github.com/OpenAgentsInc/openagents\nrepo OpenAgentsInc/private-ops|main|1|https://github.com/OpenAgentsInc/private-ops\n");
  #assert s[0].gh_connected && s[0].gh_nrepos == 2 && s[0].gh_repo_priv[1];
  tr_begin(t); ui_begin(u, 0, true);
  sw_home(s, t, u, "chris@openagents.com", 0, 0);
  #assert tr_find(t, "sw.proj.name") > 0 && tr_find(t, "sw.proj.repo") > 0 && tr_find(t, "sw.proj.create") > 0;
  #assert tr_find(t, "sw.proj.pick.0") > 0 && tr_find(t, "sw.proj.pick.1") > 0 && tr_find(t, "sw.gh.disconnect") > 0;
  sw_gh_status_read(s, 200, "connected 0\nprovider github\n");
  tr_begin(t); ui_begin(u, 0, true);
  sw_home(s, t, u, "chris@openagents.com", 0, 0);
  #assert tr_find(t, "sw.gh.connect") > 0 && tr_find(t, "sw.gh.disconnect") < 0;
}

#test "promo credit two-line display and Settings Invite section parse and render referral summary" {
  x: [1] SwTest; s := x[0].s[..]; t := x[0].t[..]; u := x[0].u[..];
  #assert sw_section_of("/settings/invite") == SW_INVITE;
  sw_account_read(s, "logged_in 1\naccount acct_42\nkind person\nlevel L1\nvia workos\nprimary chris@openagents.com\npromo_micros 15000000\npromo_expires_at 2027-02-25T00:00:00Z\n");
  sw_life_read(s, 200, "account acct_42\nkind person\nfrozen no\nstrong 0\nagents 0\nagents_paused 0\ncredit_msat 100000\nworlds 0\nsaves 0\nlimited 0\nfresh 1\npromo_micros 15000000\npromo_expires_at 2027-02-25T00:00:00Z\n");
  #assert s[0].promo_micros == 15000000 && cast(string) s[0].promo_expires[0..<10] == "2027-02-25";
  tr_begin(t); ui_begin(u, 0, true);
  sw_home(s, t, u, "chris@openagents.com", 0, 0);
  #assert tr_text_of(t, tr_find(t, "home.status.credit.v")) == "100 sats";
  #assert tr_text_of(t, tr_find(t, "home.status.promo.v")) == "$15.00";
  #assert tr_attr_of(t, tr_find(t, "home.go.invite.go"), AT_HREF) == "/settings/invite";

