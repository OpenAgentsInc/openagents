#load "shield-turn-checks.coax";
#load "../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for profile:0..<2 {
    b:[1]RsBattle; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
    if profile==1 { if !rs_set_timing(b[..],RS_ACTION_TIMING) { return 1; } }
    _:=rs_add(b[..],rs_fighter("Reactor",1,3),2,2); _=rs_add(b[..],rs_wizard("Mover",0,3),3,2);
    spells:=[1]int.[RS_EXEC_SOURCE[SP_SHIELD]]; if !rs_set_spells(b[0].c[1..<2],spells[..]) { return 2; } b[0].c[1].shield_spell=true;
    seat:[1]FbSeat; seat[0].me=1; fb_seat_step(b[..],seat[..]);
    slots:=b[0].c[1].slots[1]; hp:=b[0].c[1].hp;
    fb_seat_in(b[..],seat[..]);
    r:=rs_opportunity_attack(b[..],0,1,W_UNARMED,RsOpportunityMove.{x=4,y=2,seen=true,movement=true});
    fb_seat_out(b[..],seat[..]);
    if !r.admitted || r.hit || b[0].c[1].hp!=hp || b[0].c[1].slots[1]!=slots-1 || rs_ac(b[..],1)!=20 { return 3; }
    rs_tick(b[..],rs_beat(b[..])*3); if rs_ac(b[..],1)!=20 { return 4; }
    fb_seat_step(b[..],seat[..]); if rs_ac(b[..],1)!=15 || b[0].c[1].shield_active { return 5; }
  }
  tool_errln("PASS SHIELD-TURN-START"); return 0;
}
