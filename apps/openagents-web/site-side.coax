// The site's side: the rules behind the left side every page shows someone logged in (docs/app-shell.md).
// Plain functions, no drawing: which place a page is, who is logged in as the account's lines say, and which section a row of a list falls in. The side is drawn with the kit's pieces
// (components/kit/frames.coax: k_side, k_side_head, k_side_folds, k_fold, k_who, k_side_open) by the page that holds it; today that is the app shell (chat-web.coax).
//   coax/bin/coax test apps/openagents-web/site-side.coax
#load "../../coax/lib/nostr/nip19-core.coax";

// The places at the top of the side, in order, and the page each one is.
SS_HOME :: -1; SS_CHATS :: 0; SS_PROJECTS :: 1; SS_WORLDS :: 2; SS_PLACES :: 3;
SS_NAMES :: [3] string.["Chats", "Projects", "Worlds"];
SS_HREFS :: [3] string.["/chat", "/projects", "/worlds"];
SS_WHO :: 96;          // bytes of a name at the foot

// The place an address is: the home page, or one of the places (anything under it). -2 for none.
ss_place_of :: (path: string) -> int {
  if path == "/" || path.count == 0 { return SS_HOME; }
  hrefs := SS_HREFS;
  for k: 0..<SS_PLACES {
    h := hrefs[k];
    if path.count >= h.count && cast(string) path[0..<h.count] == h && (path.count == h.count || path[h.count] == '/' || path[h.count] == '?' || path[h.count] == '#') { return k; }
  }
  return -2;
}
// Whether the app shell draws this address itself (the home page and the chat) or the browser goes to it.
ss_in_shell :: (path: string) -> bool { p := ss_place_of(path); return p == SS_HOME || p == SS_CHATS; }
// What the shell draws at an address: the home page (the side alone), the chat beside the side, or, on a page
// it is only part of, the chat alone (the world editor's foot) or the side alone (the editor's left, which the
// editor opens at "/side"; from there every place is another page). A page of a place that holds the side
// beside its own content names its place after "/side" ("/side/projects" on /projects), so the side shows it as
// the place you are in (ss_side_place).
// A page the shell holds (SS_HELD) is another module's page: the shell draws the side and, beside it, that page in a
// frame (ss_held).
SS_FOOT :: -3; SS_SIDE :: -4; SS_HELD :: -5;
ss_page_of :: (path: string) -> int {
  if path == "/side" || (path.count > 6 && cast(string) path[0..<6] == "/side/") { return SS_SIDE; }
  if ss_held(path) { return SS_HELD; }
  p := ss_place_of(path);
  if p == SS_HOME || p == SS_CHATS { return p; }
  return SS_FOOT;
}

// Whether the shell holds an address (path and query) as a page of another module beside the side, in a frame, so
// moving to it keeps the side (docs/app-shell.md): Projects and every project's page, the list of worlds, a world's
// editor (/worlds/ID?edit; a world played, without ?edit, is a page of its own with no side), and the older settings
// pages under /settings/ (the shell's own sections, settings-web.coax's, are read before this).
ss_held :: (path: string) -> bool {
  e := 0;
  while e < path.count && path[e] != '?' && path[e] != '#' { e += 1; }
  p := cast(string) path[0..<e];
  q := ifx e < path.count && path[e] == '?' then cast(string) path[e + 1..<path.count] else "";
  if ss_under(p, "/projects") || p == "/worlds" || p == "/worlds/" || ss_under(p, "/worlds/new") || (ss_under(p, "/settings/") && p.count > 10) { return true; }
  if p.count <= 8 || cast(string) p[0..<8] != "/worlds/" { return false; }
  id := cast(string) p[8..<p.count];
  if id.count > 0 && id[id.count - 1] == '/' { id = cast(string) id[0..<id.count - 1]; }
  return ss_world_id_ok(id) && ss_has_word(q, "edit");
}
// Whether a path is `base` or under it ("/projects", "/projects/coax"; not "/projectsx").
ss_under :: (p: string, base: string) -> bool {
  if p.count < base.count || cast(string) p[0..<base.count] != base { return false; }
  return p.count == base.count || base[base.count - 1] == '/' || p[base.count] == '/';
}
// Whether a query ("a=1&edit") names `key`, bare or with a value.
ss_has_word :: (q: string, key: string) -> bool {
  at := 0;
  while at < q.count {
    e := at;
    while e < q.count && q[e] != '&' && q[e] != '#' { e += 1; }
    w := cast(string) q[at..<e];
    if w == key || (w.count > key.count && cast(string) w[0..<key.count] == key && w[key.count] == '=') { return true; }
    if e < q.count && q[e] == '#' { return false; }
    at = e + 1;
  }
  return false;
}

// The place the side alone stands in: "/side/projects" is on Projects; "/side" alone, or anything else, on none (-2).
ss_side_place :: (path: string) -> int {
  if path.count <= 6 || cast(string) path[0..<6] != "/side/" { return -2; }
  p := ss_place_of(cast(string) path[5..<path.count]);
  return ifx p >= 0 then p else -2;
}

ss_put :: (out: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n < out.count { out[n] = c; n += 1; } }
  return n;
}
ss_hex :: (c: u8) -> int {
  if c >= '0' && c <= '9' { return cast(int) (c - '0'); }
  if c >= 'a' && c <= 'f' { return cast(int) (c - 'a') + 10; }
  return -1;
}
// The name at the foot from /api/auth/account?as=lines: the account's primary email ("primary", whole), else
// the first email (masked by the API), else the key
// it acts as, as a short npub ("npub1abcdefg...uvwxyz"). Its length in out, 0 when the lines say nobody.
ss_who_read :: (body: string, out: [] u8) -> int {
  at := 0; key := ""; email := ""; primary := ""; logged := false;
  while at < body.count {
    e := at;
    while e < body.count && body[e] != '\n' { e += 1; }
    line := cast(string) body[at..<e];
    if line == "logged_in 1" { logged = true; }
    if email.count == 0 && line.count > 6 && cast(string) line[0..<6] == "email " { email = cast(string) line[6..<line.count]; }
    if primary.count == 0 && line.count > 8 && cast(string) line[0..<8] == "primary " { primary = cast(string) line[8..<line.count]; }
    if key.count == 0 && line.count == 68 && cast(string) line[0..<4] == "key " { key = cast(string) line[4..<68]; }
    at = e + 1;
  }
  if !logged { return 0; }
  if primary.count > 0 { return ss_put(out, 0, primary); }
  if email.count > 0 { return ss_put(out, 0, email); }
  n := ss_npub_short(key, out);
  return ifx n > 0 then n else ss_put(out, 0, "Your account");
}
// A key given as 64 hex digits, as a short npub ("npub1abcdefg...uvwxyz") in out: its length, 0 when it isn't one.
ss_npub_short :: (key: string, out: [] u8) -> int {
  if key.count != 64 { return 0; }
  raw: [32] u8;
  for i: 0..<32 {
    a := ss_hex(key[2 * i]); b := ss_hex(key[2 * i + 1]);
    if a < 0 || b < 0 { return 0; }
    raw[i] = cast(u8) (a * 16 + b);
  }
  npub: [80] u8;
  r := nip19_encode_checked(N19_NPUB, cast(string) raw[..], npub[..], false);
  if r.error != NC_OK || r.written <= 20 { return 0; }
  n := ss_put(out, 0, cast(string) npub[0..<12]);
  n = ss_put(out, n, "...");
  return ss_put(out, n, cast(string) npub[r.written - 6..<r.written]);
}

// The sections of a list of conversations, top to bottom: those at work now, then Claude Code's here, then
// the ones that ended most recently. A conversation is in exactly one.
SS_RUNNING :: 0; SS_CLAUDE :: 1; SS_RECENT :: 2; SS_SECTIONS :: 3;
SS_SECTION_NAMES :: [3] string.["Running", "Claude Code", "Recent"];
// Which section a conversation is in: `busy` it is at work now (a session running, a Claude Code conversation
// open in a terminal here), `claude` it is Claude Code's.
ss_section :: (busy: bool, claude: bool) -> int {
  if busy { return SS_RUNNING; }
  if claude { return SS_CLAUDE; }
  return SS_RECENT;
}

// The worlds someone may edit, as GET /api/worlds lists them ("world ID NAME" a line, Splice first), each
// opening its editor, and the projects they are in, as GET /api/projects lists them ("project SLUG NAME"), each
// opening its page. A line whose ID is not that form (a lowercase letter or digit, then those and '-', 48 bytes
// at most) is skipped.
SS_WORLDS_MAX :: 24;   // as many as /api/worlds and /api/projects send
SsWorld :: struct { id: [48] u8; id_n: int; name: [48] u8; name_n: int; }
ss_world_id_ok :: (id: string) -> bool {
  if id.count == 0 || id.count > 48 || id[0] == '-' { return false; }
  for c: id { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}
ss_worlds_read :: (body: string, out: [] SsWorld) -> int { return ss_lines_read(body, "world ", out); }
ss_projects_read :: (body: string, out: [] SsWorld) -> int { return ss_lines_read(body, "project ", out); }
ss_lines_read :: (body: string, word: string, out: [] SsWorld) -> int {
  at := 0; n := 0; w := word.count;
  while at < body.count && n < out.count {
    e := at;
    while e < body.count && body[e] != '\n' { e += 1; }
    line := cast(string) body[at..<e];
    at = e + 1;
    if line.count < w + 1 || cast(string) line[0..<w] != word { continue; }
    i := w;
    while i < line.count && line[i] != ' ' { i += 1; }
    id := cast(string) line[w..<i];
    if !ss_world_id_ok(id) { continue; }
    name := ifx i + 1 < line.count then cast(string) line[i + 1..<line.count] else id;
    out[n].id_n = ss_put(out[n].id[..], 0, id);
    out[n].name_n = ss_put(out[n].name[..], 0, name);
    n += 1;
  }
  return n;
}
// A world's editor: /worlds/ID?edit. Its length in out.
ss_world_href :: (id: string, out: [] u8) -> int { n := ss_put(out, 0, "/worlds/"); n = ss_put(out, n, id); return ss_put(out, n, "?edit"); }
// A project's page: /projects/SLUG. Its length in out.
ss_project_href :: (slug: string, out: [] u8) -> int { n := ss_put(out, 0, "/projects/"); return ss_put(out, n, slug); }
// Where each heading's + goes: a new chat is made in the shell (""), a new project from /projects' drop, a new
// world at /worlds/new. What the + says, for a screen reader and the pointer.
SS_NEW_HREFS :: [3] string.["", "/projects#new", "/worlds/new"];
SS_NEW_LABELS :: [3] string.["New chat", "New project", "New world"];

#test "an address is its place: the home page, a place or anything under it, or none" {
  #assert ss_place_of("/") == SS_HOME && ss_place_of("") == SS_HOME;
  #assert ss_place_of("/chat") == SS_CHATS && ss_place_of("/chat/") == SS_CHATS && ss_place_of("/chat?x=1") == SS_CHATS;
  #assert ss_place_of("/projects") == SS_PROJECTS && ss_place_of("/projects/coax") == SS_PROJECTS && ss_place_of("/worlds/new") == SS_WORLDS;
  #assert ss_place_of("/chatter") == -2 && ss_place_of("/chat-gpu") == -2 && ss_place_of("/settings") == -2;
  #assert ss_in_shell("/") && ss_in_shell("/chat") && !ss_in_shell("/projects") && !ss_in_shell("/worlds") && !ss_in_shell("/login");
  #assert ss_page_of("/") == SS_HOME && ss_page_of("/chat/x") == SS_CHATS && ss_page_of("/worlds/splice") == SS_FOOT && ss_page_of("/projects") == SS_HELD && ss_page_of("/side") == SS_SIDE;
}
#test "the shell holds Projects, the worlds' list, a world's editor and the older settings pages; a world played is a page of its own" {
  #assert ss_held("/projects") && ss_held("/projects/coax") && ss_held("/projects?x=1") && !ss_held("/projectsx") && !ss_held("/project");
  #assert ss_held("/worlds") && ss_held("/worlds/") && ss_held("/worlds?sort=new") && !ss_held("/worldsx") && ss_held("/worlds/new");
  #assert ss_held("/worlds/splice?edit") && ss_held("/worlds/splice/?edit") && ss_held("/worlds/splice?edit=agent") && ss_held("/worlds/splice?x=1&edit") && ss_held("/worlds/splice?edit#here");
  #assert !ss_held("/worlds/splice") && !ss_held("/worlds/splice?editor") && !ss_held("/worlds/splice?x#edit") && !ss_held("/worlds/Bad?edit") && !ss_held("/worlds/a/b?edit");
  #assert ss_held("/settings/security") && ss_held("/settings/devices?x") && !ss_held("/settings/") && !ss_held("/settings") && !ss_held("/settingsx/a");
  #assert !ss_held("/") && !ss_held("/chat") && !ss_held("/login") && !ss_held("");
  #assert ss_page_of("/worlds/splice?edit") == SS_HELD && ss_page_of("/worlds") == SS_HELD && ss_page_of("/side/worlds") == SS_SIDE && ss_page_of("/chat?edit") == SS_CHATS;
  #assert ss_has_word("edit", "edit") && ss_has_word("a&edit=1", "edit") && !ss_has_word("edits", "edit") && !ss_has_word("", "edit") && !ss_has_word("a=edit", "edit");
}
#test "the side alone on a place's page lights that place, and nothing on any other" {
  #assert ss_page_of("/side/projects") == SS_SIDE && ss_page_of("/side/worlds") == SS_SIDE && ss_page_of("/sidebar") == SS_FOOT && ss_page_of("/side/") == SS_FOOT;
  #assert ss_side_place("/side/projects") == SS_PROJECTS && ss_side_place("/side/worlds") == SS_WORLDS && ss_side_place("/side/projects/coax") == SS_PROJECTS;
  #assert ss_side_place("/side") == -2 && ss_side_place("/side/") == -2 && ss_side_place("/side/settings") == -2 && ss_side_place("/projects") == -2 && ss_side_place("/side/chat") == SS_CHATS;
}
#test "the name at the foot is the primary email, else the first email, else a short npub of the key, and nothing for nobody" {
  out: [SS_WHO] u8;
  n0 := ss_who_read("logged_in 1\naccount acct_1\nemail c•••@openagents.com\nprimary chris@openagents.com\nkey 7e7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e\n", out[..]);
  #assert cast(string) out[0..<n0] == "chris@openagents.com";
  n := ss_who_read("logged_in 1\naccount acct_1\nkind email\nemail a•••@example.com\nemail b@x.com\nkey 7e7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e\n", out[..]);
  #assert cast(string) out[0..<n] == "a•••@example.com";
  n = ss_who_read("logged_in 1\naccount acct_1\nkey 7e7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e\n", out[..]);
  #assert cast(string) out[0..<n] == "npub10elfcs4...zvjptg";
  n = ss_who_read("logged_in 1\naccount acct_1\nkind words\n", out[..]);
  #assert cast(string) out[0..<n] == "Your account";
  #assert ss_who_read("logged_in 0\n", out[..]) == 0 && ss_who_read("", out[..]) == 0;
  n = ss_npub_short("7e7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e", out[..]);
  #assert cast(string) out[0..<n] == "npub10elfcs4...zvjptg" && ss_npub_short("7e7e", out[..]) == 0 && ss_npub_short("zz7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e", out[..]) == 0;
}
#test "a conversation at work is Running whoever's it is; else Claude Code's, else Recent" {
  #assert ss_section(true, false) == SS_RUNNING && ss_section(true, true) == SS_RUNNING;
  #assert ss_section(false, true) == SS_CLAUDE && ss_section(false, false) == SS_RECENT;
  names := SS_SECTION_NAMES; #assert names[SS_RECENT] == "Recent" && SS_SECTIONS == 3;
}
#test "the worlds someone may edit and the projects they are in are read from the lists' lines, in the order sent, each opening its page" {
  w: [SS_WORLDS_MAX] SsWorld;
  n := ss_worlds_read("world splice Splice\nworld my-realm The Harbour\nworld Bad Name\nnoise\nworld -x X\nworld lone\n", w[..]);
  #assert n == 3 && cast(string) w[0].id[0..<w[0].id_n] == "splice" && cast(string) w[0].name[0..<w[0].name_n] == "Splice";
  #assert cast(string) w[1].name[0..<w[1].name_n] == "The Harbour" && cast(string) w[2].name[0..<w[2].name_n] == "lone";
  #assert ss_worlds_read("", w[..]) == 0;
  h: [80] u8; k := ss_world_href("splice", h[..]); #assert cast(string) h[0..<k] == "/worlds/splice?edit";
  p: [SS_WORLDS_MAX] SsWorld;
  m := ss_projects_read("project coax Coax\nworld splice Splice\nproject side-list Side List\nproject Up Up\n", p[..]);
  #assert m == 2 && cast(string) p[0].id[0..<p[0].id_n] == "coax" && cast(string) p[1].name[0..<p[1].name_n] == "Side List";
  k = ss_project_href("coax", h[..]); #assert cast(string) h[0..<k] == "/projects/coax";
  news := SS_NEW_HREFS; #assert news[SS_WORLDS] == "/worlds/new" && news[SS_CHATS] == "";
}
