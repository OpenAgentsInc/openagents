// SLAB's architectural and industrial detail (docs/metaverse/photoreal.md; spec section 7): what
// makes the deck read as a built place from walking height. A content set of slab-content.coax.
//
// Nothing here is placed by hand. Every piece follows a rule over the plan's records as they are
// this frame (metaverse/slab-plan.coax, after slab-change.coax has sized the hull and cut the
// dock), so a longer hull or a re-planned deck gets its detail with no edit here:
//   the edge      a parapet and handrail round the wall's top and the dock's basin, the promenade's
//                 lamps and benches, stair and lift heads
//   the dock      cranes on the basin's rims, a landing stage with its gangway, fenders, bollards
//   streets       the paint's 100 m grid (gpu/slab.coax slab_paint): kerbs and gutters, centre
//                 lines, crossings, lamps, bollards, signs, benches, covers, where nothing stands
//   blocks        towers, the medical block, data halls: plinths, piers, entrances, fins or belts,
//                 roof parapets and roof plant, window surrounds, cooling yards
// The parts are the Metaverse Engine's (metaverse-engine/arch/city.coax, works.coax, plaza.coax).
// Small things carry a distance (pr_near) and most are fine (pr_fine): a phone leaves those out.
#load "../../metaverse-engine/arch/works.coax";
#load "../../metaverse-engine/arch/plaza.coax";

CITY_SEED :: 7129;
CITY_PI :: 3.14159265f32;
// How near the eye a small thing is drawn (m): about where it is two pixels across.
CITY_NEAR_RAIL :: 140.0f32; CITY_NEAR_POST :: 130.0f32; CITY_NEAR_SEAT :: 200.0f32; CITY_NEAR_LAMP :: 330.0f32;
CITY_NEAR_KERB :: 460.0f32; CITY_NEAR_MARK :: 800.0f32; CITY_NEAR_PLANT :: 1500.0f32;
CITY_NEAR_FIN :: 560.0f32; CITY_NEAR_FRAME :: 260.0f32; CITY_NEAR_STEEL :: 420.0f32;
CITY_FLOOR :: 3.9f32;      // a tower's storey and its mullions' module: the glass's pattern
CITY_MODULE :: 4.5f32;
CITY_GRID :: 100.0f32;     // the streets' grid: the deck's paint (gpu/slab.coax slab_paint)
// What the last list placed, by rule (the report's and the checks' counts).
CITY_EDGE :: 0; CITY_DOCK :: 1; CITY_STREETS :: 2; CITY_BLOCKS :: 3; CITY_RULES :: 4;

SlabCity :: struct {
  made: bool;
  look: ArchCityLook;        // the material rows: metal, dark, glass, lamp, stone, paint
  // parts
  rail: int; lamp_post: int; bench: int; bollard: int; lift: int; stair_head: int;
  crane: int; ramp: int;
  sign: int; dashes: int; zebra: int; cover: int;
  canopy: int; ring: int; ring_wide: int; fan: int; unit: int; chiller: int; mast: int; frame: int; louvre: int; pipe: int;
  placed: [CITY_RULES] int;
}

// ---- once: the materials and the parts
slab_city_make :: (ph: [] SlabPhoto, p: [] ArchPen) {
  c: SlabCity; k: ArchCityLook;
  k.metal = photo_material(ph, 0.95, 0.95, 0.94, 0.5, 0, PR_PATTERN_PLAIN, 0, 0);
  k.dark = photo_material(ph, 0.09, 0.1, 0.11, 0.6, 0, PR_PATTERN_PLAIN, 0, 0);
  k.glass = photo_material(ph, 0.24, 0.31, 0.35, 0.08, 0.6, PR_PATTERN_PLAIN, 0, 0);
  k.lamp = photo_material(ph, 1.0, 0.94, 0.8, 0.4, 0, PR_PATTERN_PLAIN, 0, 0);
  k.stone = photo_material(ph, 0.8, 0.78, 0.73, 0.85, 0, PR_PATTERN_CONCRETE, 0, 0);
  k.paint = photo_material(ph, 0.95, 0.95, 0.92, 0.75, 0, PR_PATTERN_PLAIN, 0, 0);
  c.look = k;
  c.rail = photo_part(ph, arch_railing(p, k, 12, 0.34, 5, 2));
  c.lamp_post = photo_part(ph, arch_street_lamp(p, k, 8.5, 2.2));
  c.bench = photo_part(ph, arch_bench(p, 2.2));
  c.bollard = photo_part(ph, arch_bollard(p, k, 0.9, 0.12));
  c.lift = photo_part(ph, arch_kiosk(p, k, 3, 3, 3.6));
  c.stair_head = photo_part(ph, arch_kiosk(p, k, 3.2, 5, 3.1));
  c.crane = photo_part(ph, arch_dock_crane(p, k, 5, 22, 30));
  c.ramp = photo_part(ph, arch_gangway(p, k, 18, 6, 1.6));
  c.sign = photo_part(ph, arch_sign_post(p, k, 3.0, 0.9, 0.6, 0.1, 0.28, 0.55));
  c.dashes = photo_part(ph, arch_dashes(p, k, 20, 4, 6, 0.16));
  c.zebra = photo_part(ph, arch_zebra(p, k, 10, 3));
  from := p[0].n;
  arch_material(p, k.metal, 0.24, 0.24, 0.25);
  arch_disc(p, 0.42, 0.012, 12);
  c.cover = photo_part(ph, arch_part(p, from));
  c.canopy = photo_part(ph, arch_canopy(p, k, 7, 4.5, 4.4));
  arch_material(p, k.metal, 0, 0, 0);
  c.ring = photo_part(ph, arch_curb_ring(p, 0.012));
  c.ring_wide = photo_part(ph, arch_curb_ring(p, 0.003));
  c.fan = photo_part(ph, arch_roof_fan(p, k, 1, 0.5));
  c.unit = photo_part(ph, arch_roof_unit(p, k, 4.2, 2.2, 2.0, 2));
  c.chiller = photo_part(ph, arch_roof_unit(p, k, 6.5, 2.4, 2.3, 4));
  c.mast = photo_part(ph, arch_mast(p, k, 16));
  c.frame = photo_part(ph, arch_window_frame(p, k));
  c.louvre = photo_part(ph, arch_louvre(p, k, 8));
  arch_material(p, k.metal, 0, 0, 0);
  c.pipe = photo_part(ph, arch_pipe(p, 8));
  c.made = c.pipe >= 0;
  ph[0].content.city = c;
}

// ---- reading the plan
city_rec :: (w: SlabWorld, i: int, k: int) -> f32 { return w.records[i * SLAB_RECORD + k]; }
city_kind :: (w: SlabWorld, i: int) -> int { return cast(int) (city_rec(w, i, 3) + 0.5); }
city_shape :: (w: SlabWorld, i: int) -> int { return cast(int) (city_rec(w, i, 7) + 0.5); }
// The deck, from the hull's own records: its bounds, its height, and the dock's basin if one is
// cut (the hull piece that stands in from the south wall stands behind it).
CityDeck :: struct { ok: bool; x0: f32; z0: f32; x1: f32; z1: f32; y: f32; dock: bool; bx0: f32; bx1: f32; bz: f32; }
city_deck :: (w: SlabWorld) -> CityDeck {
  d: CityDeck;
  if w.count < SLAB_HULL_PIECES { return d; }
  top: f32 = -1000000;
  for i: 0..<SLAB_HULL_PIECES { if city_kind(w, i) == SLAB_KIND_HULL && city_rec(w, i, 5) > top { top = city_rec(w, i, 5); } }
  d.x0 = 1000000; d.z0 = 1000000; d.x1 = -1000000; d.z1 = -1000000; d.y = top;
  n := 0;
  for i: 0..<SLAB_HULL_PIECES {
    if city_kind(w, i) != SLAB_KIND_HULL || city_rec(w, i, 5) < top - 0.01 || city_rec(w, i, 4) - city_rec(w, i, 0) < 4 || city_rec(w, i, 6) - city_rec(w, i, 2) < 4 { continue; }
    d.x0 = arch_lowf(d.x0, city_rec(w, i, 0)); d.x1 = arch_highf(d.x1, city_rec(w, i, 4));
    d.z0 = arch_lowf(d.z0, city_rec(w, i, 2)); d.z1 = arch_highf(d.z1, city_rec(w, i, 6));
    n += 1;
  }
  d.ok = n > 0 && d.x1 - d.x0 > 120 && d.z1 - d.z0 > 120;
  if !d.ok { return d; }
  for i: 0..<SLAB_HULL_PIECES {
    if city_kind(w, i) != SLAB_KIND_HULL || city_rec(w, i, 5) < top - 0.01 { continue; }
    if city_rec(w, i, 0) > d.x0 + 1 && city_rec(w, i, 4) < d.x1 - 1 && city_rec(w, i, 2) > d.z0 + 4 {
      d.dock = true; d.bx0 = city_rec(w, i, 0); d.bx1 = city_rec(w, i, 4); d.bz = city_rec(w, i, 2);
    }
  }
  return d;
}
// Whether (x, z) is on the deck, m clear of its edge and the basin.
city_on :: (d: CityDeck, x: f32, z: f32, m: f32) -> bool {
  if x < d.x0 + m || x > d.x1 - m || z < d.z0 + m || z > d.z1 - m { return false; }
  return !(d.dock && x > d.bx0 - m && x < d.bx1 + m && z < d.bz + m);
}
// Whether (x, z) is on the deck and m clear of everything that stands on it or is cut into it
// (but record `skip`: what a piece is fixed to). Hawsers and the dome layouts' pieces are not
// on the deck; statues are (their rows stand on the promenade).
city_open :: (w: SlabWorld, d: CityDeck, x: f32, z: f32, m: f32, skip: int) -> bool {
  if !city_on(d, x, z, m) { return false; }
  for i: SLAB_HULL_PIECES..<w.count {
    if i == skip { continue; }
    o := i * SLAB_RECORD;
    if w.records[o + 5] < d.y - 0.5 { continue; }
    sh := cast(int) (w.records[o + 7] + 0.5);
    if (sh >= 7 && sh <= 10) || sh >= SLAB_SILONE { continue; }
    x0 := w.records[o]; z0 := w.records[o + 2]; x1 := w.records[o + 4]; z1 := w.records[o + 6];
    if x < x0 - m || x > x1 + m || z < z0 - m || z > z1 + m { continue; }
    if sh == SLAB_CYLINDER || sh == SLAB_DOME {
      cx := (x0 + x1) * 0.5; cz := (z0 + z1) * 0.5; rr := arch_lowf(x1 - x0, z1 - z0) * 0.5 + m;
      if (x - cx) * (x - cx) + (z - cz) * (z - cz) < rr * rr { return false; }
      continue;
    }
    return false;
  }
  return true;
}

// Whether something of record i's own kind stands on its roof (a tower's upper stage).
city_roofed :: (w: SlabWorld, i: int) -> bool {
  y1 := city_rec(w, i, 5);
  for j: SLAB_HULL_PIECES..<w.count {
    if j == i || abs(city_rec(w, j, 1) - y1) > 0.5 { continue; }
    cx := (city_rec(w, j, 0) + city_rec(w, j, 4)) * 0.5; cz := (city_rec(w, j, 2) + city_rec(w, j, 6)) * 0.5;
    if cx > city_rec(w, i, 0) && cx < city_rec(w, i, 4) && cz > city_rec(w, i, 2) && cz < city_rec(w, i, 6) { return true; }
  }
  return false;
}

// ---- placing
// A part's turn so that its +z (the way a wall's part faces) looks along (nx, nz), and so that
// its +x (the way a run lies) lies along (tx, tz). Both for the four level directions. A part's
// +x runs along (cos yaw, 0, -sin yaw) and its +z along (sin yaw, 0, cos yaw).
city_facing :: (nx: f32, nz: f32) -> f32 {
  if nz > 0.5 { return 0; }
  if nx > 0.5 { return CITY_PI * 0.5; }
  if nz < -0.5 { return CITY_PI; }
  return -CITY_PI * 0.5;
}
city_along :: (tx: f32, tz: f32) -> f32 {
  if tx > 0.5 { return 0; }
  if tz > 0.5 { return -CITY_PI * 0.5; }
  if tx < -0.5 { return CITY_PI; }
  return CITY_PI * 0.5;
}
// One of a part, drawn within `reach` metres (0: at any distance).
city_put :: (l: [] PrList, part: int, x: f32, y: f32, z: f32, yaw: f32, reach: f32) -> int {
  r := pr_put(l, part, x, y, z, yaw, 1);
  if reach > 0 { pr_near(l, r, reach); }
  return r;
}
// A box of one material and tint between two corners.
city_box :: (ph: [] SlabPhoto, l: [] PrList, x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32, material: int, red: f32, green: f32, blue: f32, reach: f32) -> int {
  r := pr_box(l, ph[0].box, arch_lowf(x0, x1), y0, arch_lowf(z0, z1), arch_highf(x0, x1), y1, arch_highf(z0, z1), material);
  pr_tint(l, r, red, green, blue);
  if reach > 0 { pr_near(l, r, reach); }
  return r;
}
// A pipe of a bore from (ax, az) to (bx, bz) along x or z, its underside at y.
city_pipe :: (ph: [] SlabPhoto, l: [] PrList, ax: f32, az: f32, bx: f32, bz: f32, y: f32, bore: f32, red: f32, green: f32, blue: f32, near: f32) {
  c := ph[0].content.city;
  along_x := abs(bx - ax) >= abs(bz - az);
  run := ifx along_x then abs(bx - ax) else abs(bz - az);
  if run < 0.2 { return; }
  r := city_put(l, c.pipe, (ax + bx) * 0.5, y, (az + bz) * 0.5, ifx along_x then 0.0f32 else CITY_PI * 0.5, near);
  pr_stretch(l, r, run, bore, bore); pr_tint(l, r, red, green, blue);
}
// A side of a box record: its middle, the way it faces (n) and the way it runs (t), half its length.
CityFace :: struct { cx: f32; cz: f32; nx: f32; nz: f32; tx: f32; tz: f32; half: f32; }
city_face :: (x0: f32, z0: f32, x1: f32, z1: f32, f: int) -> CityFace {
  cx := (x0 + x1) * 0.5; cz := (z0 + z1) * 0.5;
  if f == 0 { return CityFace.{cx = x1, cz = cz, nx = 1, nz = 0, tx = 0, tz = 1, half = (z1 - z0) * 0.5}; }
  if f == 1 { return CityFace.{cx = x0, cz = cz, nx = -1, nz = 0, tx = 0, tz = 1, half = (z1 - z0) * 0.5}; }
  if f == 2 { return CityFace.{cx = cx, cz = z1, nx = 0, nz = 1, tx = 1, tz = 0, half = (x1 - x0) * 0.5}; }
  return CityFace.{cx = cx, cz = z0, nx = 0, nz = -1, tx = 1, tz = 0, half = (x1 - x0) * 0.5};
}
// A box on a face: `wide` along it, standing `deep` out of it, `at` metres along from its middle.
city_on_face :: (ph: [] SlabPhoto, l: [] PrList, f: CityFace, at: f32, wide: f32, deep: f32, y0: f32, y1: f32, material: int, red: f32, green: f32, blue: f32, near: f32) -> int {
  mx := f.cx + f.tx * at + f.nx * deep * 0.5; mz := f.cz + f.tz * at + f.nz * deep * 0.5;
  hx := abs(f.tx) * wide * 0.5 + abs(f.nx) * deep * 0.5; hz := abs(f.tz) * wide * 0.5 + abs(f.nz) * deep * 0.5;
  return city_box(ph, l, mx - hx, y0, mz - hz, mx + hx, y1, mz + hz, material, red, green, blue, near);
}
// A wall's part (one made on z 0 facing +z) on a face, `at` along it and y up, stretched.
city_wall_part :: (l: [] PrList, part: int, f: CityFace, at: f32, y: f32, sx: f32, sy: f32, near: f32) -> int {
  r := city_put(l, part, f.cx + f.tx * at + f.nx * 0.02, y, f.cz + f.tz * at + f.nz * 0.02, city_facing(f.nx, f.nz), near);
  if sx > 0 { pr_stretch(l, r, sx, sy, 1); }
  return r;
}
// The records a list holds so far (counted on the first run, written on the second).
city_total :: (l: [] PrList) -> int {
  n := 0;
  for i: 0..<PR_PARTS * 2 { n += ifx l[0].filling then l[0].at[i] else l[0].count[i]; }
  return n;
}

// ---- the edge
// One straight run of the deck's edge from a to b, the water on its n side.
city_edge_run :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, ax: f32, az: f32, bx: f32, bz: f32, nx: f32, nz: f32, basin: bool) {
  c := ph[0].content.city; y := d.y;
  run := abs(bx - ax) + abs(bz - az);
  if run < 6 { return; }
  tx := (bx - ax) / run; tz := (bz - az) / run;
  // the parapet: a metre of the wall's own concrete at its face, a drain channel inside its foot
  pr_fine(l, false);
  r := pr_box(l, ph[0].box, arch_lowf(ax - nx * 0.5, bx), y, arch_lowf(az - nz * 0.5, bz), arch_highf(ax - nx * 0.5, bx), y + 1.05, arch_highf(az - nz * 0.5, bz), PHOTO_PAINT);
  pr_value(l, r, 1);
  pr_fine(l, true);
  r = city_box(ph, l, ax - nx * 0.95, y, az - nz * 0.95, bx - nx * 0.6, y + 0.02, bz - nz * 0.6, c.look.metal, 0.2, 0.2, 0.21, CITY_NEAR_KERB);
  pr_laid(l, r);
  // a handrail along its top
  n := cast(int) floor(run / 12 + 0.5); if n < 1 { n = 1; }
  seg := run / cast(f32) n;
  for k: 0..<n {
    s := (cast(f32) k + 0.5) * seg;
    r = city_put(l, c.rail, ax + tx * s - nx * 0.25, y + 1.05, az + tz * s - nz * 0.25, city_along(tx, tz), CITY_NEAR_RAIL);
    pr_stretch(l, r, seg / 12, 1, 1); pr_tint(l, r, 0.6, 0.62, 0.64);
  }
  // lamps along the walk, their arms over it, and benches between them
  lamps := cast(int) floor(run / 36);
  for k: 0..<lamps {
    s := (cast(f32) k + 0.5) * run / cast(f32) lamps;
    px := ax + tx * s - nx * 2.6; pz := az + tz * s - nz * 2.6;
    if city_open(w, d, px, pz, 0.7, -1) { _ = city_put(l, c.lamp_post, px, y, pz, city_along(-nx, -nz), CITY_NEAR_LAMP); }
    if basin || k == 0 { continue; }
    s = cast(f32) k * run / cast(f32) lamps;
    px = ax + tx * s - nx * 2.3; pz = az + tz * s - nz * 2.3;
    if city_open(w, d, px, pz, 1.3, -1) { r = city_put(l, c.bench, px, y, pz, city_along(tx, tz), CITY_NEAR_SEAT); pr_made_of(l, r, c.look.metal); }
  }
  // the heads of the stairs and lifts that come up through the hull: a lift, then a stair
  pr_fine(l, false);
  heads := ifx basin then 0 else cast(int) floor(run / 220);
  for k: 0..<heads {
    s := (cast(f32) k + 0.5) * run / cast(f32) heads;
    px := ax + tx * s - nx * 9; pz := az + tz * s - nz * 9;
    if city_open(w, d, px, pz, 3.4, -1) { _ = city_put(l, ifx k % 2 == 0 then c.lift else c.stair_head, px, y, pz, city_facing(-nx, -nz), CITY_NEAR_PLANT); }
  }
}
city_edge :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck) {
  city_edge_run(ph, l, w, d, d.x0, d.z1, d.x1, d.z1, 0, 1, false);
  city_edge_run(ph, l, w, d, d.x1, d.z0, d.x1, d.z1, 1, 0, false);
  city_edge_run(ph, l, w, d, d.x0, d.z0, d.x0, d.z1, -1, 0, false);
  if !d.dock { city_edge_run(ph, l, w, d, d.x0, d.z0, d.x1, d.z0, 0, -1, false); return; }
  city_edge_run(ph, l, w, d, d.x0, d.z0, d.bx0, d.z0, 0, -1, false);
  city_edge_run(ph, l, w, d, d.bx1, d.z0, d.x1, d.z0, 0, -1, false);
  city_edge_run(ph, l, w, d, d.bx0, d.z0, d.bx0, d.bz, 1, 0, true);
  city_edge_run(ph, l, w, d, d.bx1, d.z0, d.bx1, d.bz, -1, 0, true);
  city_edge_run(ph, l, w, d, d.bx0, d.bz, d.bx1, d.bz, 0, -1, true);
}

// ---- the dock
city_dock :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck) {
  if !d.dock || d.bx1 - d.bx0 < 40 || d.bz - d.z0 < 30 { return; }
  c := ph[0].content.city; k := c.look;
  mid := (d.bx0 + d.bx1) * 0.5; deep := d.bz - d.z0;
  pr_fine(l, false);
  // cranes on the rims, their booms over the basin
  for side: 0..<2 {
    for j: 0..<2 {
      z := d.z0 + deep * (0.28 + 0.44 * cast(f32) j);
      x := ifx side == 0 then d.bx0 - 3.4 else d.bx1 + 3.4;
      _ = city_put(l, c.crane, x, d.y, z, city_facing(ifx side == 0 then -1.0f32 else 1.0f32, 0), 0);
    }
  }
  // a landing stage afloat under the basin's head wall, bollards along it, a lift up the wall
  // and a gangway from the stage up to a landing at a door in the head wall
  x0 := d.bx0 + 10; x1 := d.bx1 - 10; z1 := d.bz - 0.6; z0 := z1 - 9;
  _ = city_box(ph, l, x0, -0.7, z0, x1, 0.9, z1, k.stone, 1, 1, 1, 0);
  _ = city_box(ph, l, mid - 22, 0.9, d.bz - 4.4, mid - 18, d.y, d.bz, k.stone, 1, 1, 1, 0);
  if city_open(w, d, mid - 20, d.bz + 3.2, 2.0, -1) { _ = city_put(l, c.lift, mid - 20, d.y, d.bz + 3.2, 0, CITY_NEAR_PLANT); }
  _ = city_put(l, c.ramp, mid - 9, 0.9, d.bz - 2.0, 0, CITY_NEAR_PLANT);
  _ = city_box(ph, l, mid + 9, 6.7, d.bz - 3.2, mid + 13, 6.9, d.bz, k.metal, 0.4, 0.42, 0.44, 0);
  _ = city_box(ph, l, mid + 10, 6.9, d.bz - 0.1, mid + 12.2, 9.2, d.bz, k.dark, 1, 1, 1, 0);
  pr_fine(l, true);
  n := cast(int) floor((x1 - x0) / 10);
  for j: 0..<n + 1 {
    x := x0 + 1 + (x1 - x0 - 2) * cast(f32) j / cast(f32) n;
    r := pr_put(l, c.bollard, x, 0.9, z0 + 0.9, 0, 1.4); pr_near(l, r, CITY_NEAR_SEAT);
  }
  // fenders down the side walls at the water
  for side: 0..<2 {
    x := ifx side == 0 then d.bx0 + 0.55 else d.bx1 - 0.55;
    m := cast(int) floor((deep - 14) / 9);
    for j: 0..<m {
      r := city_put(l, ph[0].post, x, -2.2, d.z0 + 5 + 9 * cast(f32) j, 0, CITY_NEAR_KERB);
      pr_stretch(l, r, 1.1, 5.4, 1.1); pr_made_of(l, r, k.dark);
    }
  }
  pr_fine(l, false);
}

// ---- the streets
// A point of a street that runs along x (axis 0) or z (axis 1): s along it, q across.
city_sx :: (axis: int, s: f32, q: f32) -> f32 { return ifx axis == 0 then s else q; }
city_sz :: (axis: int, s: f32, q: f32) -> f32 { return ifx axis == 0 then q else s; }
// Whether the grid has a street at coordinate q between lo and hi: clear of the promenade.
city_street_at :: (q: f32, lo: f32, hi: f32) -> bool { return q - lo > 30 && hi - q > 30; }
city_streets :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck) {
  c := ph[0].content.city; y := d.y; grid := CITY_GRID;
  for axis: 0..<2 {
    lo := ifx axis == 0 then d.x0 else d.z0; hi := ifx axis == 0 then d.x1 else d.z1;       // along
    clo := ifx axis == 0 then d.z0 else d.x0; chi := ifx axis == 0 then d.z1 else d.x1;     // across
    tx: f32 = ifx axis == 0 then 1.0 else 0.0; tz := 1 - tx;
    for line: cast(int) floor(clo / grid)..<cast(int) floor(chi / grid) + 2 {
      q := cast(f32) line * grid;
      if !city_street_at(q, clo, chi) { continue; }
      // kerbs and gutters down both sides, wherever nothing stands, broken at the crossings
      pr_fine(l, true);
      for side: 0..<2 {
        e: f32 = ifx side == 0 then -1.0 else 1.0;
        start := lo; going := false;
        cells := cast(int) floor((hi - lo - 40) / 5);
        for cell: 0..<cells + 1 {
          s := lo + 20 + 5 * cast(f32) cell; m := s + 2.5;
          cross_at := floor(m / grid + 0.5) * grid;
          ok := cell < cells && !(abs(m - cross_at) < 7.5 && city_street_at(cross_at, lo, hi)) && city_open(w, d, city_sx(axis, m, q + e * 5.15), city_sz(axis, m, q + e * 5.15), 0.3, -1);
          if ok && !going { start = s; going = true; }
          if !ok && going {
            going = false;
            _ = city_box(ph, l, city_sx(axis, start, q + e * 5.0), y, city_sz(axis, start, q + e * 5.0), city_sx(axis, s, q + e * 5.3), y + 0.13, city_sz(axis, s, q + e * 5.3), c.look.stone, 1, 1, 1, CITY_NEAR_KERB);
            r := city_box(ph, l, city_sx(axis, start, q + e * 4.5), y, city_sz(axis, start, q + e * 4.5), city_sx(axis, s, q + e * 5.0), y + 0.015, city_sz(axis, s, q + e * 5.0), c.look.metal, 0.3, 0.3, 0.31, CITY_NEAR_KERB);
            pr_laid(l, r);
          }
        }
      }
      // the centre line, three lengths a block, and a cover or two
      pr_fine(l, false);
      for unit: cast(int) floor((lo + 20) / 20) + 1..<cast(int) floor((hi - 20) / 20) {
        m := cast(f32) unit * 20 + 10;
        cross_at := floor(m / grid + 0.5) * grid;
        if abs(m - cross_at) < 12 && city_street_at(cross_at, lo, hi) { continue; }
        if !city_open(w, d, city_sx(axis, m, q), city_sz(axis, m, q), 2, -1) { continue; }
        r := city_put(l, c.dashes, city_sx(axis, m, q), y, city_sz(axis, m, q), city_along(tx, tz), CITY_NEAR_MARK);
        pr_laid(l, r);
        if unit % 2 == 0 {
          pr_fine(l, true);
          r = city_put(l, c.cover, city_sx(axis, m + 4, q - 1.9), y, city_sz(axis, m + 4, q - 1.9), 0, CITY_NEAR_SEAT);
          pr_laid(l, r);
          pr_fine(l, false);
        }
      }
      // block by block: lamps down both sides, their arms over the road, and a bench
      pr_fine(l, true);
      for block: cast(int) floor(lo / grid) - 1..<cast(int) floor(hi / grid) + 1 {
        b := cast(f32) block * grid;
        for k: 0..<3 {
          e: f32 = ifx k == 1 then -1.0 else 1.0;
          s := b + 30 + 20 * cast(f32) k;
          if s < lo + 22 || s > hi - 22 { continue; }
          px := city_sx(axis, s, q + e * 6.3); pz := city_sz(axis, s, q + e * 6.3);
          if city_open(w, d, px, pz, 0.8, -1) { _ = city_put(l, c.lamp_post, px, y, pz, ifx axis == 0 then city_along(0, -e) else city_along(-e, 0), CITY_NEAR_LAMP); }
        }
        s := b + 50;
        px := city_sx(axis, s, q + 8.4); pz := city_sz(axis, s, q + 8.4);
        if s > lo + 22 && s < hi - 22 && city_open(w, d, px, pz, 1.4, -1) { r := city_put(l, c.bench, px, y, pz, city_along(tx, tz), CITY_NEAR_SEAT); pr_made_of(l, r, c.look.metal); }
      }
      // the crossings on this street: a zebra over each of its two arms
      pr_fine(l, false);
      for cross: cast(int) floor(lo / grid)..<cast(int) floor(hi / grid) + 2 {
        p := cast(f32) cross * grid;
        if !city_street_at(p, lo, hi) { continue; }
        for arm: 0..<2 {
          s := p + (ifx arm == 0 then -13.5f32 else 13.5f32);
          if !city_open(w, d, city_sx(axis, s, q), city_sz(axis, s, q), 3, -1) { continue; }
          r := city_put(l, c.zebra, city_sx(axis, s, q), y, city_sz(axis, s, q), city_along(tx, tz), CITY_NEAR_MARK);
          pr_laid(l, r);
        }
        if axis != 0 { continue; }
        // and, once a crossing, its corners: two bollards each, a sign on two of them
        pr_fine(l, true);
        for corner: 0..<4 {
          ex: f32 = ifx corner & 1 == 0 then -1.0 else 1.0; ez: f32 = ifx corner & 2 == 0 then -1.0 else 1.0;
          for b: 0..<2 {
            px := p + ex * (ifx b == 0 then 6.3f32 else 7.9f32); pz := q + ez * (ifx b == 0 then 7.9f32 else 6.3f32);
            if city_open(w, d, px, pz, 0.5, -1) { _ = city_put(l, c.bollard, px, y, pz, 0, CITY_NEAR_POST); }
          }
          if corner == 0 || corner == 3 {
            px := p + ex * 7.6; pz := q + ez * 7.6;
            if city_open(w, d, px, pz, 0.6, -1) { _ = city_put(l, c.sign, px, y, pz, ifx (cross + line) % 2 == 0 then 0.0f32 else CITY_PI * 0.5, CITY_NEAR_SEAT); }
          }
        }
        pr_fine(l, false);
      }
    }
  }
  pr_fine(l, false);
}

// ---- the blocks: towers, the medical block, the data halls
// Plant on a flat roof, on a grid of cells: packaged units, fans, a lift's overrun in the middle.
city_roof_plant :: (ph: [] SlabPhoto, l: [] PrList, x0: f32, z0: f32, x1: f32, z1: f32, y: f32, cell: f32, dense: f32, seed: int, overrun: bool) {
  c := ph[0].content.city;
  nx := cast(int) floor((x1 - x0 - 6) / cell); nz := cast(int) floor((z1 - z0 - 6) / cell);
  if nx < 1 || nz < 1 { return; }
  sx := (x1 - x0 - 6) / cast(f32) nx; sz := (z1 - z0 - 6) / cast(f32) nz;
  for a: 0..<nx { for b: 0..<nz {
    px := x0 + 3 + (cast(f32) a + 0.5) * sx; pz := z0 + 3 + (cast(f32) b + 0.5) * sz;
    if overrun && a == nx / 2 && b == nz / 2 {
      pr_fine(l, false);
      _ = city_box(ph, l, px - 2.6, y, pz - 2.1, px + 2.6, y + 3.6, pz + 2.1, c.look.stone, 1, 1, 1, 0);
      continue;
    }
    h := arch_hash(seed, a * 37 + b);
    pr_fine(l, true);
    if h < dense {
      _ = city_put(l, c.unit, px, y, pz, ifx arch_hash(seed + 3, a * 37 + b) < 0.5 then 0.0f32 else CITY_PI * 0.5, CITY_NEAR_PLANT);
    } else if h < dense * 1.4 {
      r := city_put(l, c.fan, px, y, pz, 0, CITY_NEAR_PLANT); pr_stretch(l, r, 1.5, 1.8, 1.5);
    }
  } }
  pr_fine(l, false);
}
// A roof's parapet: a ring round its edge.
city_parapet :: (ph: [] SlabPhoto, l: [] PrList, x0: f32, z0: f32, x1: f32, z1: f32, y: f32, tall: f32, tone: f32) {
  c := ph[0].content.city;
  wide := arch_highf(x1 - x0, z1 - z0) > 60;
  r := pr_put(l, ifx wide then c.ring_wide else c.ring, (x0 + x1) * 0.5, y, (z0 + z1) * 0.5, 0, 1);
  pr_stretch(l, r, x1 - x0 + 0.3, tall, z1 - z0 + 0.3); pr_tint(l, r, tone, tone, tone * 0.98);
}
// Entrances: a canopy on up to `most` sides that open onto clear deck.
city_entrances :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, i: int, x0: f32, y0: f32, z0: f32, x1: f32, z1: f32, most: int, seed: int) -> int {
  c := ph[0].content.city;
  first := cast(int) (arch_hash(seed, 2) * 4); doors := 0; mask := 0;
  for j: 0..<4 {
    f := city_face(x0, z0, x1, z1, (first + j) % 4);
    if doors >= most || f.half < 6 { continue; }
    if !city_open(w, d, f.cx + f.nx * 8, f.cz + f.nz * 8, 3, i) { continue; }
    _ = city_put(l, c.canopy, f.cx + f.nx * 0.02, y0, f.cz + f.nz * 0.02, city_facing(f.nx, f.nz), CITY_NEAR_PLANT);
    doors += 1; mask = mask | (1 << ((first + j) % 4));
  }
  return mask;
}
city_tower :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, i: int) {
  c := ph[0].content.city; k := c.look;
  x0 := city_rec(w, i, 0); y0 := city_rec(w, i, 1); z0 := city_rec(w, i, 2); x1 := city_rec(w, i, 4); y1 := city_rec(w, i, 5); z1 := city_rec(w, i, 6);
  if x1 - x0 < 12 || z1 - z0 < 12 || y1 - y0 < 12 { return; }
  seed := CITY_SEED + i * 131;
  ground := y0 < d.y + 1;
  style := cast(int) (arch_hash(seed, 1) * 3);
  pr_fine(l, false);
  city_parapet(ph, l, x0, z0, x1, z1, y1, 1.3, 0.82);
  if !city_roofed(w, i) {
    city_roof_plant(ph, l, x0, z0, x1, z1, y1, 9, 0.34, seed + 7, true);
    if y1 - d.y > 125 && arch_hash(seed, 5) > 0.35 { _ = city_put(l, c.mast, (x0 + x1) * 0.5 + 1.2, y1 + 3.6, (z0 + z1) * 0.5, 0, CITY_NEAR_PLANT); }
  }
  foot := y0;
  if ground {
    // a plinth, piers to the first floor and a dark fascia over them; doors where the deck is clear
    _ = city_box(ph, l, x0 - 0.2, y0, z0 - 0.2, x1 + 0.2, y0 + 0.45, z1 + 0.2, k.stone, 1, 1, 1, 0);
    _ = city_box(ph, l, x0 - 0.35, y0 + 5.2, z0 - 0.35, x1 + 0.35, y0 + 5.8, z1 + 0.35, k.metal, 0.2, 0.21, 0.22, 0);
    _ = city_entrances(ph, l, w, d, i, x0, y0, z0, x1, z1, 2, seed);
    pr_fine(l, true);
    for f: 0..<4 {
      face := city_face(x0, z0, x1, z1, f);
      n := cast(int) floor((face.half - 0.4) / 9 + 0.5);
      for j: 0..<n * 2 {
        at := (cast(f32) (j / 2) + 0.5) * 9 * (ifx j % 2 == 0 then 1.0f32 else -1.0f32);
        if abs(at) > face.half - 0.35 { continue; }
        _ = city_on_face(ph, l, face, at, 0.7, 0.5, y0, y0 + 5.2, k.stone, 1, 1, 1, CITY_NEAR_FIN);
      }
    }
    pr_fine(l, false);
    foot = y0 + 5.8;
  }
  if style == 0 {
    // fins up the glass on every third mullion
    pr_fine(l, true);
    for f: 0..<4 {
      face := city_face(x0, z0, x1, z1, f);
      n := cast(int) floor((face.half - 0.5) / CITY_MODULE);
      for j: -n..<n + 1 { _ = city_on_face(ph, l, face, cast(f32) j * CITY_MODULE, 0.22, 0.45, foot, y1 + 0.8, k.metal, 0.9, 0.9, 0.88, CITY_NEAR_FIN); }
    }
    pr_fine(l, false);
  } else if style == 1 {
    // a belt every fifth floor
    yb := y0 + CITY_FLOOR * 5;
    while yb < y1 - 8 {
      _ = city_box(ph, l, x0 - 0.3, yb, z0 - 0.3, x1 + 0.3, yb + 0.55, z1 + 0.3, k.metal, 0.84, 0.84, 0.82, 2000);
      yb += CITY_FLOOR * 5;
    }
  } else {
    // its corners in stone
    for corner: 0..<4 {
      px := ifx corner & 1 == 0 then x0 else x1; pz := ifx corner & 2 == 0 then z0 else z1;
      _ = city_box(ph, l, px - 0.55, foot, pz - 0.55, px + 0.55, y1 + 0.6, pz + 0.55, k.stone, 1, 1, 1, 2000);
    }
  }
}
// The medical block: a surround round each painted window (the paint's bays and storeys), a
// door, a parapet and roof plant.
city_medical :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, i: int) {
  c := ph[0].content.city;
  x0 := city_rec(w, i, 0); y0 := city_rec(w, i, 1); z0 := city_rec(w, i, 2); x1 := city_rec(w, i, 4); y1 := city_rec(w, i, 5); z1 := city_rec(w, i, 6);
  if x1 - x0 < 12 || z1 - z0 < 12 { return; }
  seed := CITY_SEED + i * 131;
  pr_fine(l, false);
  city_parapet(ph, l, x0, z0, x1, z1, y1, 1.1, 0.9);
  city_roof_plant(ph, l, x0, z0, x1, z1, y1, 11, 0.4, seed + 7, true);
  doors := city_entrances(ph, l, w, d, i, x0, y0, z0, x1, z1, 1, seed);
  pr_fine(l, true);
  for f: 0..<4 {
    face := city_face(x0, z0, x1, z1, f);
    lo := (ifx f < 2 then z0 else x0) + 0.4; hi := (ifx f < 2 then z1 else x1) - 0.4; mid := ifx f < 2 then face.cz else face.cx;
    for bay: cast(int) floor(lo / 4)..<cast(int) floor(hi / 4) + 1 {
      a := cast(f32) bay * 4;
      if a < lo || a + 2.8 > hi { continue; }
      for floor_n: 0..<12 {
        yb := d.y + 3.6 * cast(f32) floor_n + 1.62;
        if yb < y0 || yb + 1.98 > y1 - 0.2 { continue; }
        if floor_n < 2 && (doors & (1 << f)) != 0 && abs(a + 1.4 - mid) < 6.5 { continue; }
        _ = city_wall_part(l, c.frame, face, a + 1.4 - mid, yb, 2.8, 1.98, CITY_NEAR_FRAME);
      }
    }
  }
  pr_fine(l, false);
}
// A data hall: fans in their cowls over the roof's painted ones, louvres and doors in its walls,
// and a cooling yard along its clearest side: chillers in a row, their headers along the wall.
city_data :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, i: int) {
  c := ph[0].content.city;
  x0 := city_rec(w, i, 0); y0 := city_rec(w, i, 1); z0 := city_rec(w, i, 2); x1 := city_rec(w, i, 4); y1 := city_rec(w, i, 5); z1 := city_rec(w, i, 6);
  if x1 - x0 < 14 || z1 - z0 < 14 { return; }
  seed := CITY_SEED + i * 131;
  pr_fine(l, false);
  city_parapet(ph, l, x0, z0, x1, z1, y1, 0.7, 0.74);
  _ = city_entrances(ph, l, w, d, i, x0, y0, z0, x1, z1, 1, seed);
  pr_fine(l, true);
  for a: cast(int) floor(x0 / 9)..<cast(int) floor(x1 / 9) + 1 { for b: cast(int) floor(z0 / 9)..<cast(int) floor(z1 / 9) + 1 {
    px := (cast(f32) a + 0.5) * 9; pz := (cast(f32) b + 0.5) * 9;
    if px < x0 + 3 || px > x1 - 3 || pz < z0 + 3 || pz > z1 - 3 { continue; }
    r := pr_put(l, c.fan, px, y1, pz, 0, 1); pr_stretch(l, r, 2.5, 2.4, 2.5);
  } }
  // the yard: the side with the most clear deck 7 m off it
  best := -1; most := 2;
  for f: 0..<4 {
    face := city_face(x0, z0, x1, z1, f);
    n := 0;
    for j: 0..<cast(int) floor(face.half * 2 / 8) {
      at := -face.half + 4 + 8 * cast(f32) j;
      if city_open(w, d, face.cx + face.tx * at + face.nx * 7, face.cz + face.tz * at + face.nz * 7, 3.6, i) { n += 1; }
    }
    if n > most { most = n; best = f; }
  }
  for f: 0..<4 {
    face := city_face(x0, z0, x1, z1, f);
    if f == best {
      first: f32 = 0; last: f32 = 0; any := false;
      for j: 0..<cast(int) floor(face.half * 2 / 8) {
        at := -face.half + 4 + 8 * cast(f32) j;
        px := face.cx + face.tx * at + face.nx * 7; pz := face.cz + face.tz * at + face.nz * 7;
        if !city_open(w, d, px, pz, 3.6, i) { continue; }
        _ = city_put(l, c.chiller, px, y0, pz, city_along(face.nx, face.nz), CITY_NEAR_PLANT);
        city_pipe(ph, l, face.cx + face.tx * at, face.cz + face.tz * at, px - face.nx * 3.2, pz - face.nz * 3.2, y0 + 0.5, 0.4, 0.3, 0.42, 0.55, CITY_NEAR_STEEL);
        if !any { first = at; any = true; }
        last = at;
      }
      if any {
        city_pipe(ph, l, face.cx + face.tx * (first - 2) + face.nx * 2.2, face.cz + face.tz * (first - 2) + face.nz * 2.2, face.cx + face.tx * (last + 2) + face.nx * 2.2, face.cz + face.tz * (last + 2) + face.nz * 2.2, y0 + 0.8, 0.6, 0.3, 0.42, 0.55, CITY_NEAR_STEEL);
        city_pipe(ph, l, face.cx + face.tx * (first - 2) + face.nx * 3.0, face.cz + face.tz * (first - 2) + face.nz * 3.0, face.cx + face.tx * (last + 2) + face.nx * 3.0, face.cz + face.tz * (last + 2) + face.nz * 3.0, y0 + 0.8, 0.45, 0.62, 0.3, 0.2, CITY_NEAR_STEEL);
      }
      continue;
    }
    city_vents(ph, l, w, d, i, face, y0, arch_lowf((y1 - y0) * 0.55, 12), 12, f == (best + 1) % 4);
  }
  pr_fine(l, false);
}
// Louvres along a wall every `pitch` metres, `up` above its foot, and a shuttered door at the
// ground under every third; none where the wall does not open onto clear deck.
city_vents :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck, i: int, face: CityFace, y0: f32, up: f32, pitch: f32, doors: bool) {
  c := ph[0].content.city;
  n := cast(int) floor(face.half * 2 / pitch);
  for j: 0..<n {
    at := (cast(f32) j + 0.5 - cast(f32) n * 0.5) * pitch;
    if !city_open(w, d, face.cx + face.tx * at + face.nx * 4, face.cz + face.tz * at + face.nz * 4, 0.8, i) { continue; }
    _ = city_wall_part(l, c.louvre, face, at, y0 + up, 3.6, 2.6, CITY_NEAR_STEEL);
    if doors && j % 3 == 1 { _ = city_wall_part(l, c.louvre, face, at, y0, 4.4, 4.8, CITY_NEAR_STEEL); }
  }
}
city_blocks :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld, d: CityDeck) {
  for i: SLAB_HULL_PIECES..<w.count {
    if city_shape(w, i) != SLAB_BOX || city_rec(w, i, 1) < d.y - 0.5 { continue; }
    kind := city_kind(w, i);
    if kind == SLAB_KIND_TOWER { city_tower(ph, l, w, d, i); }
    if kind == SLAB_KIND_MEDICAL || kind == SLAB_KIND_CIVIC { city_medical(ph, l, w, d, i); }
    if kind == SLAB_KIND_DATA { city_data(ph, l, w, d, i); }
  }
  pr_fine(l, false);
}

// ---- the set's calls (slab-content.coax)
slab_city_place :: (ph: [] SlabPhoto, l: [] PrList, w: SlabWorld) {
  if !ph[0].content.city.made || w.layout != LAYOUT_PRIME || w.build { return; }
  d := city_deck(w);
  if !d.ok { return; }
  n: [CITY_RULES + 1] int;
  n[0] = city_total(l);
  city_edge(ph, l, w, d); n[1] = city_total(l);
  city_dock(ph, l, w, d); n[2] = city_total(l);
  city_streets(ph, l, w, d); n[3] = city_total(l);
  city_blocks(ph, l, w, d); n[4] = city_total(l);
  pr_fine(l, false);
  if l[0].filling { for k: 0..<CITY_RULES { ph[0].content.city.placed[k] = n[k + 1] - n[k]; } }
}
// The lamps' lenses: the material content-green's night lamps light (slab-content-green.coax).
slab_city_lamp :: (ph: [] SlabPhoto) -> int { return ifx ph[0].content.city.made then ph[0].content.city.look.lamp else 0; }

// ---- checks
city_test_world :: (rec: [] f32, n: int) -> SlabWorld { return SlabWorld.{records = rec, count = n, layout = LAYOUT_PRIME, build = false, build_day = 0, reduced = false, time = 0, hour = 12, night = 0}; }
#test "the city reads the deck from the hull's own records: its bounds, its height and the dock's basin" {
  rec: [SLAB_MAX_BOXES * SLAB_RECORD] f32;
  n := slab_plan(rec[..]);
  w := city_test_world(rec[..], n);
  d := city_deck(w);
  // the plan as drawn: one hull, no basin
  #assert d.ok && !d.dock && d.x0 == -SLAB_LENGTH / 2 && d.x1 == SLAB_LENGTH / 2 && d.z0 == -SLAB_BEAM / 2 && d.z1 == SLAB_BEAM / 2 && d.y == SLAB_DECK;
  #assert !city_on(d, SLAB_LENGTH / 2 - 0.5, 0, 1) && city_on(d, SLAB_LENGTH / 2 - 2, 0, 1);
  // a hull in three blocks round a basin, as slab-change.coax cuts it
  for i: 0..<SLAB_HULL_PIECES * SLAB_RECORD { rec[i] = 0; }
  blocks := [12] f32.[-500, -300, -50, 300, 50, -300, 500, 300, -50, -240, 50, 300];
  for b: 0..<3 {
    o := b * SLAB_RECORD;
    rec[o] = blocks[b * 4]; rec[o + 1] = -25; rec[o + 2] = blocks[b * 4 + 1]; rec[o + 3] = cast(f32) SLAB_KIND_HULL;
    rec[o + 4] = blocks[b * 4 + 2]; rec[o + 5] = 118; rec[o + 6] = blocks[b * 4 + 3]; rec[o + 7] = cast(f32) SLAB_BOX;
  }
  d = city_deck(w);
  #assert d.ok && d.dock && d.bx0 == -50 && d.bx1 == 50 && d.bz == -240 && d.x0 == -500 && d.z0 == -300;
  #assert !city_on(d, 0, -270, 1) && !city_on(d, 50.5, -270, 1) && city_on(d, 52, -270, 1) && city_on(d, 0, -238, 1);
  // the directions: a wall's part faces its wall's way, a run lies along its run
  #assert city_facing(0, 1) == 0 && abs(sin(city_facing(1, 0)) - 1) < 0.0001 && abs(cos(city_facing(0, -1)) + 1) < 0.0001 && abs(sin(city_facing(-1, 0)) + 1) < 0.0001;
  #assert city_along(1, 0) == 0 && abs(sin(city_along(0, 1)) + 1) < 0.0001 && abs(cos(city_along(-1, 0)) + 1) < 0.0001 && abs(sin(city_along(0, -1)) - 1) < 0.0001;
}
#test "the city's detail is placed by rule from the live deck: every rule gets its share, a phone gets less and the build view none" #steps 20000000000 {
  s: [1] Slab;
  u: [UNIFORM_FLOATS] f32;
  slab_reset(s[..]);
  slab_build(s[..], false);
  u[U_MODE + 2] = f32(s[0].box_count);
  for i: 0..<s[0].box_count * SLAB_RECORD { u[U_BOXES + i] = s[0].boxes[i]; }
  for i: 0..<12 { u[U_PARAMS + P_POSE + i] = ifx i == 0 || i == 5 || i == 10 then 1.0f32 else 0.0f32; }
  s[0].eye = [3] f32.[600, 500, 700]; s[0].fwd = [3] f32.[-0.6, -0.5, -0.6245]; s[0].right = [3] f32.[0.72, 0, -0.69]; s[0].up = [3] f32.[-0.35, 0.87, -0.36];
  s[0].tanh = 0.4; s[0].aspect = 1.6;
  sun := sim_sun(27.8, 5.5, 17.85);
  s[0].photo[0].on = true;
  slab_photo_frame(s[..], u[..], sun, false);
  ph := s[0].photo[..];
  c := ph[0].content.city;
  #assert c.made && !ph[0].full && ph[0].fixed <= PHOTO_VERTICES && ph[0].material_count < PHOTO_PAINT;
  // the page's deck has the dock cut (slab-change.coax): the basin's rims get cranes and a stage
  d := city_deck(photo_world(s[..], u[U_BOXES..<U_BOXES + s[0].box_count * SLAB_RECORD], s[0].box_count, false));
  #assert d.ok && d.dock;
  #assert c.placed[CITY_EDGE] == 466 && c.placed[CITY_DOCK] == 29 && c.placed[CITY_STREETS] == 1269 && c.placed[CITY_BLOCKS] == 1160;
  // every record stands on or over the deck's plan, or down the wall or in the basin beside it
  for r: 0..<ph[0].still {
    o := r * PR_RECORD_FLOATS;
    #assert ph[0].records[o] > d.x0 - 3 && ph[0].records[o] < d.x1 + 3 && ph[0].records[o + 2] > d.z0 - 3 && ph[0].records[o + 2] < d.z1 + 3;
  }
  // a phone: the fine records are left out
  full := 0;
  for dr: 0..<ph[0].draw_count { full += cast(int) ph[0].draws[dr * 4 + 3]; }
  slab_photo_frame(s[..], u[..], sun, true);
  less := 0;
  for dr: 0..<ph[0].draw_count { less += cast(int) ph[0].draws[dr * 4 + 3]; }
  #assert !ph[0].full && less < full;
  // the construction view: no rail is drawn
  s[0].build.on = true;
  ph[0].keyed = false;
  slab_photo_frame(s[..], u[..], sun, false);
  rails := 0;
  for dr: 0..<ph[0].draw_count { if cast(int) ph[0].draws[dr * 4] == ph[0].kinds[c.rail].first { rails += 1; } }
  #assert rails == 0;
}
