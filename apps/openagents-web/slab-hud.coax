// The SLAB world's HUD (GitHub #13685): what the world says is on screen, in plain words, and what
// each press does. slab.coax loads this file and says the HUD once a frame (sb_say). The browser draws
// it with the scene set in the mono skin, as /chat is drawn: the pane is scene-pane.coax, the words
// travel as scene-hud.coax describes, and the looks are components/kit/scene.coax and mono_scene_css.
// The canvas keeps only drawn lines (the flow arrows, the bending line, the chart): there is no
// canvas HUD, and the old toolbar, panels and first screen are gone.
//
// How to add a control, a menu entry or a panel (another file's, in the same world)
//
// 1. In your own file, which slab.coax loads, write two procedures:
//      yours_hud :: (s: [] Slab, h: [] SceneHud, group: int)        what you show
//      yours_act :: (s: [] Slab, id: string, value: int) -> bool    what a press does; true when the id was yours
// 2. Add one line for each to the two lists below, sb_more and sb_act_more. That is the whole hook.
//
// yours_hud is called once for each group every frame: HUD_LOOK, HUD_INSIDE ("See inside"), HUD_CHANGE
// and HUD_BUILD ("Build it"). Say your part under the group it belongs to, with scene-hud.coax's
// procedures. A panel under Change, a switch and a menu entry look like this:
//      if group != HUD_CHANGE { return; }
//      sh_panel(h, "take", "What would it take?", "Move a number and see what follows");
//        sh_say(h, "Deeper water needs longer lines.");
//        sh_slider(h, "take.depth", "Water depth", "1,500 m", 500, 4000, 100, 1500);
//        sh_fact(h, "Line length", "2,500 m", SH_OURS);
//        sh_link(h, "The research behind this", "https://github.com/OpenAgentsInc/openagents/blob/main/docs/…");
//      sh_end_of(h);
//      sh_switch(h, "line.lose", "Lose a line", "Cut one mooring line and see the others take its load", s[0].lost);
//      sh_menu(h, "weather", "Weather", "");
//        sh_option(h, "weather.clear", "Clear", "", clear); sh_option(h, "weather.squall", "A squall", "", !clear);
//      sh_end_of(h);
// yours_act gets the id you gave (and a slider's new number in `value`). Ids are yours to choose: start
// them with your own word and a dot. Write in sentence case and plain words, explain a term the first
// time, and state a slider's limits (its ends are its limits). Tag numbers: SH_CLAIM is "From Luckey",
// SH_SOURCE "From a source", SH_OURS "Our assumption". sb_toast(s, "…") says a short word for a moment
// (not while the tour runs: its caption has the screen).
// Everything the HUD says in one frame fits SH_TEXT (16 KB): a line past that is left out whole, and the
// first HUD check fails (`lost`). What is inside a panel is drawn only while the panel is open, but it
// is said, and counts, every frame: keep a panel to what a person reads in one look.
//
//   coax/bin/coax test apps/openagents-web/slab.coax --only "HUD"

#load "scene-hud.coax";
#load "slab-tour.coax";     // the guided tour: its stops, its camera and its caption
#load "slab-labels.coax";   // the names in the scene
#load "slab-cards.coax";    // the card about what was clicked

SB_PANE :: "scene-pane";   // the pane's module (scene-pane.coax)
HUD_LOOK :: 0; HUD_INSIDE :: 1; HUD_CHANGE :: 2; HUD_BUILD :: 3;
SB_DOCS :: "https://github.com/OpenAgentsInc/openagents/blob/main/docs/research/ocean/";
SB_TEXT :: 200;            // bytes of one line of words built here
SB_TOAST :: 3.5;           // seconds a word said for a moment stays

SlabHud :: struct {
  said: [1] SceneHud;
  pane: bool;              // the browser draws the HUD: the page has read its address
  visit: int = -1;         // -1 not told yet, 0 the visitor has been here, 1 a first visit
  want: [SH_ID] u8; want_n: int; serial: int;   // the tab the pane is asked to open, and how many times it was asked
  toast: [SB_TEXT] u8; toast_n: int; toast_at: f64;
  touch: bool;             // the last press on the scene was a finger's
  tour: SlabTour;          // the guided tour (slab-tour.coax)
  lab: SlabLabels;         // the names in the scene (slab-labels.coax)
  carded: int = -1;        // what the card was last about (-1: no card)
  short_s: f64;            // seconds of the world's clock the data halls have been short of power
  backup: SimBackup;       // what their batteries and generators carry now (slab-sim.coax, spec 6.2)
  lift: f32;               // how far the orbit's view is lifted over an open card, eased (sb_card_lift)
  open: int;               // the opening view on a tall screen: 1 asked (tour_opening), 2 made, 0 gone (sb_open_fit)
  open_v: [3] f32;         // its pitch, distance and target's x as made: the visitor moving any of them ends it
  bar: f32;                // how tall the pane's bar stands, CSS px, as the pane last said ("hud.bar")
  sheet: f32;              // how tall the open sheet stands, CSS px; 0 with none open ("hud.sheet")
  fit_l: f32; fit_b: f32;  // the hull's length and beam the view was last fitted to (0: none yet) (sb_hull_fit)
  fit_on: bool;            // the orbit easing to a resized hull's view
  fit_v: [4] f32;          // that view's distance and point (x, y, z)
  fit_was: [4] f32;        // the distance and point as last eased: the visitor moving any ends the easing
}

// The opening view on a phone held upright. The wide screen's view leaves the platform at mid-height,
// with sky above it and sea below, so on a tall screen the opening looks down more steeply, comes a
// little nearer and stands the platform in the upper half. The yaw is the picture's and stays.
// tour_opening asks for it, and the orbit's first frame of known size makes it.
SB_OPEN_PITCH :: 0.14f32;   // radians more look-down on a phone held upright
SB_OPEN_NEAR :: 0.03f32;    // and this share nearer
SB_OPEN_LIFT :: 0.2f32;     // and what it looks at this share of half the screen above the middle
sb_open_fit :: (s: [] Slab, width: f32, height: f32) {
  if s[0].hp.open != 1 || !(width > 0) || !(height > 0) { return; }
  t := clamp32((1 - width / height) / 0.5, 0, 1);
  s[0].hp.open = ifx t > 0 then 2 else 0;
  s[0].pitch += SB_OPEN_PITCH * t; s[0].dist *= 1 - SB_OPEN_NEAR * t;
  s[0].hp.open_v = [3] f32.[s[0].pitch, s[0].dist, s[0].tx];
}
// The opening's lift, while the visitor has not moved the view: turning, tilting, zooming or moving
// it ends the opening for good.
sb_open_lift :: (s: [] Slab) -> f32 {
  if s[0].hp.open != 2 { return 0; }
  v := s[0].hp.open_v;
  if s[0].pitch != v[0] || s[0].dist != v[1] || s[0].tx != v[2] || s[0].yaw != TOUR_OPEN.yaw || s[0].mode != CAM_ORBIT || s[0].build.on { s[0].hp.open = 0; return 0; }
  if !(s[0].aspect > 0) || s[0].aspect >= 1 { return 0; }
  return SB_OPEN_LIFT * clamp32((1 - s[0].aspect) / 0.5, 0, 1);
}

// On a phone held upright an open card covers the lower half of the screen, so the orbit tips its view
// down and what it looks at stands in the upper half, as the tour's does over its caption. It eases in
// and out over about half a second. Returns the share of half the screen's height to lift by.
SB_CARD_AT :: 0.41f32;   // where a card's subject stands: this share of half the screen over the middle
sb_card_lift :: (s: [] Slab, step: f32) -> f32 {
  want := ifx s[0].selected != -1 && s[0].hp.pane && !s[0].build.on then tour_tall(s) else 0.0f32;
  i := s[0].selected;
  if want > 0 && i >= 0 && i < s[0].box_count && s[0].height > 0 {
    // a thing's card: the lift stands that thing between the menu and the card, wherever it was pressed
    q := screen_of(s, (rec(s, i, 0) + rec(s, i, 4)) / 2, (rec(s, i, 1) + rec(s, i, 5)) / 2, (rec(s, i, 2) + rec(s, i, 6)) / 2);
    if q[2] > 5 { want = clamp32(SB_CARD_AT - (1 - 2 * q[1] / s[0].height) + s[0].hp.lift, 0, 0.9); }
  }
  // any sheet open (the panel, Look, See inside, Help) covers a phone's lower half as a card does: the
  // platform stands between the bar and the sheet. (The build view lifts its own: slab-build-draw.coax.)
  if s[0].hp.sheet > 0 && s[0].hp.pane && !s[0].build.on { want = hi_f32(want, tour_tall(s)); }
  want = hi_f32(want, sb_open_lift(s));
  s[0].hp.lift += (want - s[0].hp.lift) * clamp32(step * 6, 0, 1);
  return s[0].hp.lift;
}

// A hull resized (a preset, a slider, the address) fills the screen as the picture's hull does: the
// orbit eases its distance, and its point, by how much larger or smaller the hull's footprint is than
// the picture's, from the opening view (TOUR_OPEN), on a wide screen and a tall one alike. Only a change
// of size does it: a visitor who zooms or moves by hand is never pulled back, and moving during the
// easing ends it. Not in the tour or the build view, whose cameras are their own.
SB_FIT_NEAR :: 60.0f32;     // m: the nearest the orbit is fitted, for the smallest hull
// The hull's size as the eye takes it in: across its footprint's diagonal and twice its height from
// keel to deck, against the picture's hull's.
sb_fit_share :: (l: f32, b: f32, tall: f32) -> f32 {
  pt := f32(HULL_PRIME_DECK) * 2;
  return sqrt(l * l + b * b + 4 * tall * tall) / sqrt(f32(HULL_PRIME_L * HULL_PRIME_L + HULL_PRIME_B * HULL_PRIME_B) + pt * pt);
}
sb_hull_fit :: (s: [] Slab, step: f32) {
  hs := change_hull(s[0].change[..]);
  l := hs[0] * 2; b := hs[1] * 2;
  // the view as made is the picture's hull's: an address that sizes the hull is a change from it
  if s[0].hp.fit_l == 0 { s[0].hp.fit_l = f32(HULL_PRIME_L); s[0].hp.fit_b = f32(HULL_PRIME_B); }
  if l != s[0].hp.fit_l || b != s[0].hp.fit_b {
    s[0].hp.fit_l = l; s[0].hp.fit_b = b;
    if s[0].hp.tour.on || s[0].build.on || s[0].mode != CAM_ORBIT || s[0].layout != LAYOUT_PRIME { s[0].hp.fit_on = false; return; }
    r := sb_fit_share(l, b, hs[2] - hs[3]);
    // the point looked at is as far into the hull, and no higher over the water than the hull's share of it
    s[0].hp.fit_v = [4] f32.[clamp32(TOUR_OPEN.dist * r, SB_FIT_NEAR, 9000), clamp32(TOUR_OPEN.x * r, -4000, 4000), TOUR_OPEN.y * clamp32(r, 0, 1), clamp32(TOUR_OPEN.z * r, -4000, 4000)];
    s[0].hp.fit_was = [4] f32.[s[0].dist, s[0].tx, s[0].ty, s[0].tz];
    s[0].hp.fit_on = true;
  }
  if !s[0].hp.fit_on { return; }
  w := s[0].hp.fit_was;
  if s[0].dist != w[0] || s[0].tx != w[1] || s[0].ty != w[2] || s[0].tz != w[3] || s[0].hp.tour.on || s[0].build.on || s[0].mode != CAM_ORBIT { s[0].hp.fit_on = false; return; }
  v := s[0].hp.fit_v;
  k := clamp32(step * 4, 0, 1);
  s[0].dist += (v[0] - s[0].dist) * k; s[0].tx += (v[1] - s[0].tx) * k; s[0].ty += (v[2] - s[0].ty) * k; s[0].tz += (v[3] - s[0].tz) * k;
  if abs(s[0].dist - v[0]) < 0.5 && abs(s[0].tx - v[1]) < 0.5 && abs(s[0].ty - v[2]) < 0.5 && abs(s[0].tz - v[3]) < 0.5 {
    s[0].dist = v[0]; s[0].tx = v[1]; s[0].ty = v[2]; s[0].tz = v[3]; s[0].hp.fit_on = false;
  }
  s[0].hp.fit_was = [4] f32.[s[0].dist, s[0].tx, s[0].ty, s[0].tz];
  // a phone's opening view stays the opening while the hull's view eases (sb_open_lift)
  if s[0].hp.open == 2 { s[0].hp.open_v = [3] f32.[s[0].pitch, s[0].dist, s[0].tx]; }
}

// ---------------------------------------------------------------- the data halls' backup

// Once a frame, after the power is worked out: `dt` more seconds of the world's clock have passed.
// While the halls are short the clock of their batteries runs; with all their power back it is
// wound back to nothing (we do not model the recharge).
sb_backup_step :: (s: [] Slab, dt: f64) {
  pw := s[0].power;
  if pw.data_on_backup { s[0].hp.short_s += dt; } else { s[0].hp.short_s = 0; }
  s[0].hp.backup = sim_backup(pw, s[0].hp.short_s);
}
// The state of the backup in one plain line.
sb_backup_words :: (b: SimBackup) -> string {
  if b.dark > 0 { return "Batteries spent: the generators carry 40 MW and the rest of the halls are dark"; }
  if b.batteries > 0 && b.generators > 0 { return "Short of power: generators and batteries carry the halls"; }
  if b.batteries > 0 { return "Short of power: batteries carry the halls while the generators start"; }
  return "Short of power: the generators carry the halls";
}

// ---------------------------------------------------------------- the two lists

// What other files add to the HUD: one line each.
sb_more :: (s: [] Slab, h: [] SceneHud, group: int) {
  // yours_hud(s, h, group);
  sea_look_hud(s, h, group);   // the weather, and the water under the sea (slab-sea.coax)
  panel_hud(s, h, group);   // "What would it take?" (slab-panel.coax)
  lines_hud(s, h, group);      // what holds the hull in place, and "lose a line" (slab-lines.coax)
  sq_hud(s, h, group);         // the picture's detail, and when it is lowered (slab-quality.coax)
}
// What other files' presses do: one line each.
sb_act_more :: (s: [] Slab, id: string, value: int) -> bool {
  // if yours_act(s, id, value) { return true; }
  if sea_look_act(s, id, value) { return true; }
  if chart_act(s, id) { return true; }          // the chart's own tags (slab-chart.coax)
  if place_act(s, id) { return true; }          // the dock's name (slab-place.coax)
  if panel_act(s, id, value) { return true; }   // "What would it take?" (slab-panel.coax)
  if lines_act(s, id, value) { return true; }
  if sq_act(s, id, value) { return true; }
  return false;
}

// ---------------------------------------------------------------- words

SbText :: struct { b: [SB_TEXT] u8; n: int; }
sb_w :: (t: SbText, s: string) -> SbText { o := t; o.n = put(o.b[..], o.n, s); return o; }
// A number with its thousands separated by commas: 15,375 or 1,187.5 (putf separates them).
sb_n :: (t: SbText, v: f64, decimals: int) -> SbText {
  o := t; o.n = putf(o.b[..], o.n, v, decimals);
  return o;
}
sb_s :: (t: [] SbText) -> string { return cast(string) t[0].b[0..<t[0].n]; }
sb_toast :: (s: [] Slab, text: string) {
  n := 0;
  for c: text { if n < SB_TEXT { s[0].hp.toast[n] = c; n += 1; } }
  s[0].hp.toast_n = n; s[0].hp.toast_at = s[0].time;
}
// The pane is asked to open a tab ("" shuts whichever is open).
sb_open :: (s: [] Slab, group: string) {
  n := 0;
  for c: group { if n < SH_ID { s[0].hp.want[n] = c; n += 1; } }
  s[0].hp.want_n = n; s[0].hp.serial += 1;
}
// An id from a word and a number: "site." and 2 is "site.2".
sb_id :: (out: [] u8, part: string, k: int) -> string {
  n := put(out, 0, part);
  a: [SH_NUM] u8;
  n = put(out, n, sh_int(a[..], k));
  return cast(string) out[0..<n];
}
// The number at the end of an id that starts with `part` ("go." and "go.6" is 6), or -1.
sb_index :: (id: string, part: string) -> int {
  if id.count <= part.count || cast(string) id[0..<part.count] != part { return -1; }
  return sh_number_of(cast(string) id[part.count..<id.count], -1);
}

SB_STATIONS :: [9] string.["The temples", "The power plant", "The data halls", "The mining yard", "The towers", "The fountain", "The bow", "The view in Luckey's picture", "From 1.5 km out"];
// The sites in plain words, in slab-sim.coax's order (where_site in metaverse/slab-where.coax holds the same
// titles with the chart: when the world loads that file, read the titles from it and drop this table).
SB_SITES :: [SITES] string.["Guam, west coast", "Puerto Rico, off Yabucoa", "Hawaii, off Kona", "The equator, by Baker Island", "California, three miles out", "Texas, the Gulf of Mexico", "Norway, Yrkefjorden"];
SB_STORMS :: [SITES] string.["Typhoons pass here.", "Hurricanes and earthquakes happen here.", "Hurricanes are rare here.", "No hurricanes form this close to the equator.", "Winter storms come through.", "Hurricanes come from June to November.", "A sheltered fjord: a place to join the hull, not to run it."];
SB_SEAS :: [SEAS] string.["Calm", "Trade wind", "The equator's roughest", "Rough", "Gale", "Hurricane"];
SB_MONTHS :: [12] string.["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

sb_clock :: (hour: f64) -> SbText {
  t: SbText;
  hh := cast(int) floor(hour); mm := cast(int) floor((hour - f64(hh)) * 60);
  t.n = two(t.b[..], t.n, hh); t = sb_w(t, ":"); t.n = two(t.b[..], t.n, mm);
  return t;
}

// ---------------------------------------------------------------- what the HUD holds

sb_look :: (s: [] Slab, h: [] SceneHud) {
  ids: [SH_ID] u8;
  sh_group(h, "look", "Look");
  if s[0].hp.touch {
    sh_say(h, "Drag to turn. Pinch to zoom, or use the buttons. Tap anything to learn what it is. Walking and flying need a keyboard.");
  } else {
    sh_choices(h, "look.as", "Move as");
      sh_option(h, "look.orbit", "Orbit", "", s[0].mode == CAM_ORBIT);
      sh_option(h, "look.walk", "Walk", "", s[0].mode == CAM_WALK);
      sh_option(h, "look.fly", "Fly", "", s[0].mode == CAM_FLY);
    sh_end_of(h);
    if s[0].mode == CAM_WALK { sh_say(h, "W, A, S and D run; hold Shift to walk. Space jumps; twice, and you fly. Drag to turn. Scroll to zoom."); }
    else if s[0].mode == CAM_FLY { sh_say(h, "W, A, S and D fly. Space climbs and Shift drops. Drag to look. Scroll to change speed, from 3 to 60 metres a second."); }
    else { sh_say(h, "Drag to turn. Scroll to zoom. W, A, S and D move the point you circle. Click anything to learn what it is."); }
  }
  if s[0].mode == CAM_ORBIT {
    sh_button(h, "look.in", "Closer", false);
    sh_button(h, "look.out", "Farther", false);
  }
  sh_menu(h, "go", "Go to a place", "Choose a place");
    names := SB_STATIONS;
    // the places on the deck are the picture's (slab-labels.coax): on another hull only the two views from the sea
    deck := lab_picture_deck(s);
    for i: 0..<9 { if deck || i >= 7 { sh_option(h, sb_id(ids[..], "go.", i), names[i], "", false); } }
  sh_end_of(h);
  if !deck { sh_say(h, "The places on the deck are the picture's. Reset to the picture under Change to visit them."); }
  sb_more(s, h, HUD_LOOK);
}

sb_inside :: (s: [] Slab, h: [] SceneHud) {
  sh_group(h, "inside", "See inside");
  if s[0].layout == LAYOUT_PRIME {
    sh_switch(h, "view.section", "Cut it open", "A slice through the hull: its cells, its ballast water and the waterline", s[0].section);
    sh_switch(h, "view.under", "Go underwater", "The underside of the hull, the cold-water pipes and the mooring lines", s[0].under);
    sh_switch(h, "view.flow", "Water and power", "Where the sea water goes, and where the electricity goes", s[0].flow);
  } else {
    sh_say(h, "The cut-open view, the underwater view and the water and power lines are drawn for the one-platform shape. Choose it under Change.");
  }
  sb_now(s, h);
  sb_more(s, h, HUD_INSIDE);
}
// What the world is doing now, in a part of the sheet: the old statistics, in plain words.
sb_now :: (s: [] Slab, h: [] SceneHud) {
  pw := s[0].power; hl := s[0].hull;
  ts: [1] SbText; t: SbText;
  sh_panel(h, "now", "What it is doing now", "The sea, the hull's motion and the power, as this world works them out");
    sh_say(h, "These numbers come from this world's own model, not from SLAB.");
    sh_heading(h, "The sea");
    t = SbText.{}; t = sb_n(t, f64(s[0].synth[0].significant), 1); t = sb_w(t, " m"); ts[0] = t;
    sh_fact(h, "Wave height", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, s[0].wind, 1); t = sb_w(t, " m/s"); ts[0] = t;
    sh_fact(h, "Wind", sb_s(ts[..]), SH_NONE);
    sh_heading(h, "The hull");
    t = SbText.{}; t = sb_n(t, hl.heave, 2); t = sb_w(t, " m"); ts[0] = t;
    sh_fact(h, "Rise and fall", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, hl.roll * 180 / SIM_PI, 3); t = sb_w(t, "°"); ts[0] = t;
    sh_fact(h, "Lean to one side", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, sqrt(hl.surge * hl.surge + hl.sway * hl.sway), 1); t = sb_w(t, " m"); ts[0] = t;
    sh_fact(h, "Pushed off its place by", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, lines_hull(s).tension / 1e6, 1); t = sb_w(t, " of "); t = sb_n(t, sim_shape(lines_hull(s)).mbl / 1e6, 0); t = sb_w(t, " meganewtons"); ts[0] = t;
    sh_fact(h, "Hardest-pulled mooring line", sb_s(ts[..]), SH_NONE);
    sh_heading(h, "Power");
    t = SbText.{}; t = sb_n(t, pw.supply, 1); t = sb_w(t, " MW"); ts[0] = t;
    sh_fact(h, "Made", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, pw.data, 1); t = sb_w(t, " of "); t = sb_n(t, pw.data_load, 0); t = sb_w(t, " MW"); ts[0] = t;
    sh_fact(h, "Data halls", sb_s(ts[..]), SH_NONE);
    if pw.data_on_backup {
      bk := s[0].hp.backup;
      sh_say(h, sb_backup_words(bk));
      if bk.batteries > 0 { t = SbText.{}; t = sb_n(t, floor((bk.left + 59) / 60), 0); t = sb_w(t, " min"); ts[0] = t; sh_fact(h, "Battery left", sb_s(ts[..]), SH_OURS); }
      if bk.dark > 0 { t = SbText.{}; t = sb_n(t, bk.dark, 0); t = sb_w(t, " of "); t = sb_n(t, pw.data_load, 0); t = sb_w(t, " MW"); ts[0] = t; sh_fact(h, "Halls dark", sb_s(ts[..]), SH_OURS); }
    }
    if !s[0].plant.demo10 {
      t = SbText.{}; t = sb_n(t, pw.desal, 1); t = sb_w(t, " of "); t = sb_n(t, SIM_DESAL, 0); t = sb_w(t, " MW"); ts[0] = t;
      sh_fact(h, "Fresh water plant", sb_s(ts[..]), SH_NONE);
    }
    t = SbText.{}; t = sb_n(t, pw.industry, 1); t = sb_w(t, " MW"); ts[0] = t;
    sh_fact(h, "Industry", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, pw.mining, 1); t = sb_w(t, " MW"); ts[0] = t;
    sh_fact(h, "Bitcoin mining", sb_s(ts[..]), SH_NONE);
    if sim_fixed_short(s[0].plant, pw) { sh_say(h, "There is not enough power for everything, so some of it is switched off."); }
  sh_end_of(h);
}

sb_change :: (s: [] Slab, h: [] SceneHud) {
  ids: [SH_ID] u8; ts: [1] SbText; t: SbText;
  sh_group(h, "change", "Change");
  sh_menu(h, "site", "Where it floats", "");
    sites := SB_SITES; storms := SB_STORMS;
    for i: 0..<SITES {
      st := sim_site(i);
      t = SbText.{}; t = sb_w(t, "Surface water "); t = sb_n(t, st.surface_min, 1); t = sb_w(t, " to "); t = sb_n(t, st.surface_max, 1);
      t = sb_w(t, ifx st.sourced then " °C, measured. " else " °C, our planning value. "); t = sb_w(t, storms[i]); ts[0] = t;
      sh_option(h, sb_id(ids[..], "site.", i), sites[i], sb_s(ts[..]), s[0].site == i);
    }
  sh_end_of(h);
  sh_menu(h, "sea", "The sea", "");
    seas := SB_SEAS;
    for i: 0..<SEAS {
      se := sim_sea(i);
      t = SbText.{}; t = sb_w(t, "Waves about "); t = sb_n(t, se.hs, 1); t = sb_w(t, " m high, wind "); t = sb_n(t, se.wind, 1); t = sb_w(t, " m/s"); ts[0] = t;
      sh_option(h, sb_id(ids[..], "sea.", i), seas[i], sb_s(ts[..]), s[0].sea == i && s[0].wind_forced <= 0);
    }
  sh_end_of(h);
  t = sb_clock(s[0].hour); ts[0] = t;
  sh_slider(h, "hour", "Time of day", sb_s(ts[..]), 0, 95, 1, cast(int) floor(s[0].hour * 4));
  months := SB_MONTHS;
  mo := cast(int) floor(s[0].month) % 12;
  sh_slider(h, "month", "Month", months[mo], 0, 11, 1, mo);
  sh_switch(h, "pause", "Stop the clock", "The sun and the seasons hold still. The sea keeps moving.", s[0].paused);
  sh_menu(h, "power", "Power source", "");
    sh_option(h, "power.otec", "Ocean thermal power", "Electricity from the gap between warm surface water and cold deep water (OTEC)", s[0].plant.power == POWER_OTEC && !s[0].plant.demo10);
    sh_option(h, "power.nuclear", "Four small reactors", "", s[0].plant.power == POWER_NUCLEAR);
    sh_option(h, "power.hybrid", "Two reactors and ocean thermal power", "", s[0].plant.power == POWER_HYBRID);
    sh_option(h, "power.demo", "A first plant of 10 megawatts", "The size the research report proposes building first", s[0].plant.demo10);
  sh_end_of(h);
  sh_switch(h, "swac", "Cool the data halls with sea water", "Cold deep water takes their heat away, which saves 10 megawatts", s[0].plant.swac);
  sh_menu(h, "layout", "Shape", "");
    sh_option(h, "layout.0", "One platform, a kilometre long", "The shape in Luckey's picture", s[0].layout == LAYOUT_PRIME);
    sh_option(h, "layout.1", "One round dome", "122 m across", s[0].layout == LAYOUT_DOME);
    sh_option(h, "layout.2", "Seven domes joined by bridges", "", s[0].layout == LAYOUT_CLUSTER);
  sh_end_of(h);
  sh_panel(h, "fault", "Break something", "Shut a pipe, hole the hull, take a reactor off line");
    sh_say(h, "Each of these is a failure the platform has to live through. Switch one on and watch what the rest does.");
    if s[0].plant.power != POWER_NUCLEAR { sh_switch(h, "fault.pipe", "Shut one cold-water pipe", "One of four. The plant loses a quarter of its power.", s[0].plant.pipe_tripped); }
    if s[0].plant.power != POWER_OTEC {
      sh_switch(h, "fault.refuel", "Take a reactor off line", "As when one is refuelled", s[0].plant.refuelling > 0);
    }
    if s[0].layout != LAYOUT_CLUSTER {
      sh_switch(h, "fault.hole", "Hole the hull", ifx s[0].layout == LAYOUT_PRIME then "A hole of 4 m² below the waterline, in the corner cell" else "A hole of 4 m² below the waterline, in one part of the dome", s[0].hull.holed);
      if s[0].hull.holed { sh_switch(h, "fault.pump", "Pump ballast across", "Moves water to the far corner to level the hull again", s[0].hull.pumping); }
    }
    sh_switch(h, "fault.halving", "Halve the mining reward", "Bitcoin pays miners half as much about every four years", s[0].plant.halving);
  sh_end_of(h);
  sb_more(s, h, HUD_CHANGE);
}

sb_help :: (s: [] Slab, h: [] SceneHud) {
  sh_group(h, "help", "Help");
  sh_say(h, "This is our reconstruction of SLAB, a floating platform that Palmer Luckey says he is building. He has published no design, so the sizes and the systems here are our assumptions, worked out from his picture.");
  sh_heading(h, "Getting around");
  sh_say(h, "Drag to turn. Scroll or pinch to zoom. Click or tap anything on the platform to learn what it is.");
  sh_say(h, "Look changes how you move. See inside cuts the hull open, takes you underwater, and shows where the water and the power go. Change moves the platform to another sea, hour or power source. Build it shows how it could be made.");
  sh_heading(h, "Keys");
  sh_fact(h, "1 to 9", "Go to a place", SH_NONE);
  sh_fact(h, "O, G, F", "Orbit, walk, fly", SH_NONE);
  sh_fact(h, "V, U, L", "Cut it open, go underwater, water and power", SH_NONE);
  sh_fact(h, "[ and ]", "An hour earlier or later", SH_NONE);
  sh_fact(h, "B", "Build it", SH_NONE);
  sh_fact(h, "H", "Hide or show these controls", SH_NONE);
  sh_fact(h, "Esc", "Close what is open", SH_NONE);
  sh_heading(h, "Read the research");
  b: [SB_TEXT] u8;
  n := put(b[..], 0, SB_DOCS); n = put(b[..], n, "slab-world-spec.md");
  sh_link(h, "How this world was worked out", cast(string) b[0..<n]);
  n = put(b[..], 0, SB_DOCS); n = put(b[..], n, "slab-image-feasibility.md");
  sh_link(h, "Could the platform in the picture be built?", cast(string) b[0..<n]);
  n = put(b[..], 0, SB_DOCS); n = put(b[..], n, "otec.md");
  sh_link(h, "Ocean thermal power", cast(string) b[0..<n]);
  n = put(b[..], 0, SB_DOCS); n = put(b[..], n, "palmer-luckey-post.md");
  sh_link(h, "What Luckey said", cast(string) b[0..<n]);
}

// The card about what was clicked (slab-cards.coax). In a narrow window a card and a sheet do not
// both fit, so a card that opens shuts the sheet.
sb_card :: (s: [] Slab, h: [] SceneHud) {
  now := ifx s[0].build.on then -1 else s[0].selected;
  if now != -1 && now != s[0].hp.carded && s[0].width < 760 * s[0].dpr { sb_open(s, ""); }
  s[0].hp.carded = now;
  cd_card(s, h);
}

// The HUD, said: every frame, and the pane hears of it when it changed.
sb_say :: (s: [] Slab) {
  h := s[0].hp.said[..];
  sh_begin(h);
  if s[0].hp.pane && s[0].hud && !s[0].golden {
    sh_scene(h, "SLAB", "From Luckey", "Close", "Back");
    sh_open(h, cast(string) s[0].hp.want[0..<s[0].hp.want_n], s[0].hp.serial);
    touring := s[0].hp.tour.on;
    s[0].hp.lab.boxes = 0;   // the names in the scene are placed afresh (lab_put)
    sh_mode(h, "mode.tour", "Tour", touring);
    sh_mode(h, "mode.explore", "Explore", !touring && !s[0].build.on);
    sh_mode_of(h, "mode.build", "Build it", !touring && s[0].build.on, "build");
    // the tour has the screen to itself: its caption, and the bar to leave by
    if touring { tour_say(s, h); }
    else if s[0].build.on { bd_hud(s, h); }   // the build view's group (slab-build-draw.coax)
    else { sb_look(s, h); sb_inside(s, h); sb_change(s, h); }
    lab_say(s, h);
    sb_help(s, h);
    if !touring { if s[0].build.on { bd_card(s, h); } else { sb_card(s, h); } }
    if s[0].build.on { bd_tags(s, h); } else { chart_tags(s, h); }   // the chart's names (slab-chart.coax)
    if !touring { place_tags(s, h); }   // the lines on the water and the dock (slab-place.coax); the tour's caption has the screen
    foot: [200] u8;
    sh_foot(h, sea_look_foot(s, foot[..]));
    if !touring && s[0].hp.toast_n > 0 && s[0].time - s[0].hp.toast_at < SB_TOAST { sh_toast(h, cast(string) s[0].hp.toast[0..<s[0].hp.toast_n]); }
  }
  _ = sh_end(h);
}

// ---------------------------------------------------------------- what a press does

sb_act :: (s: [] Slab, body: string) {
  p := sh_pressed(body);
  id := p.id;
  if id == "hud.visit" {
    // a first visit by the plain address opens on the tour
    s[0].hp.visit = ifx p.has && p.value == 1 then 1 else 0;
    if ((s[0].hp.visit == 1 && s[0].hp.tour.wanted) || s[0].hp.tour.asked) && !s[0].hp.tour.on { s[0].hp.tour.asked = false; tour_start(s); }
    return;
  }
  // the pane's measures: the bar (names stay clear of it) and the open sheet (the view lifts over it)
  if id == "hud.bar" { s[0].hp.bar = cast(f32) p.value; return; }
  if id == "hud.sheet" { s[0].hp.sheet = cast(f32) p.value; return; }
  if tour_act(s, id) { return; }
  if lab_act(s, id) { return; }
  if cd_act(s, id) { return; }
  if sb_act_more(s, id, p.value) { return; }
  if id == "mode.explore" { if s[0].build.on { build_toggle(s); } sb_open(s, ""); return; }
  if id == "mode.build" { if !s[0].build.on { build_toggle(s); } sb_open(s, "build"); return; }
  if bd_act(s, id, p.value, p.has) { return; }   // Build it (slab-build-draw.coax)
  if id == "card.x" { s[0].selected = -1; return; }
  if s[0].build.on { return; }
  // Look
  if id == "look.orbit" { set_mode(s, CAM_ORBIT); return; }
  if id == "look.walk" { set_mode(s, CAM_WALK); return; }
  if id == "look.fly" { set_mode(s, CAM_FLY); return; }
  if id == "look.in" { s[0].dist = clamp32(s[0].dist * 0.7f32, 25, 9000); s[0].intro = 0; return; }
  if id == "look.out" { s[0].dist = clamp32(s[0].dist / 0.7f32, 25, 9000); s[0].intro = 0; return; }
  k := sb_index(id, "go.");
  if k >= 0 && k < 9 { if k < 7 && !lab_picture_deck(s) { return; } names := SB_STATIONS; travel(s, k); sb_toast(s, names[k]); return; }
  // See inside
  if id == "view.section" { press(s, BTN_SECTION); return; }
  if id == "view.under" { press(s, BTN_UNDER); return; }
  if id == "view.flow" { press(s, BTN_FLOW); return; }
  // Change
  k = sb_index(id, "site.");
  if k >= 0 && k < SITES { sites := SB_SITES; s[0].site = k; s[0].sea = sim_site(k).sea; s[0].wind_forced = -1; sb_toast(s, sites[k]); change_said(s); return; }
  k = sb_index(id, "sea.");
  if k >= 0 && k < SEAS { s[0].sea = k; s[0].wind_forced = -1; return; }
  if id == "hour" { if p.has { s[0].hour = fclamp(f64(p.value) / 4, 0, 23.99); } return; }
  if id == "month" { if p.has { s[0].month = fclamp(f64(p.value), 0, 11) + 0.5; } return; }
  if id == "pause" { s[0].paused = !s[0].paused; return; }
  if id == "swac" { s[0].plant.swac = !s[0].plant.swac; return; }
  if id == "power.otec" || id == "power.nuclear" || id == "power.hybrid" || id == "power.demo" {
    s[0].plant.demo10 = id == "power.demo";
    s[0].power_chosen = true;   // a change of layout keeps the visitor's choice
    s[0].plant.power = ifx id == "power.nuclear" then POWER_NUCLEAR else ifx id == "power.hybrid" then POWER_HYBRID else POWER_OTEC;
    s[0].plant.refuelling = 0;
    if has_ship(s) { sb_toast(s, "A dome is too short for the reactors, so they ride on a ship moored beside it."); }
    if s[0].layout != LAYOUT_PRIME { layout_records(s); }
    return;
  }
  k = sb_index(id, "layout.");
  if k >= 0 && k < 3 { set_layout(s, k); change_said(s); return; }
  if id == "fault.pipe" { s[0].plant.pipe_tripped = !s[0].plant.pipe_tripped; return; }
  if id == "fault.refuel" { press(s, BTN_REFUEL); return; }
  if id == "fault.hole" {
    press(s, BTN_HOLE);   // it says what it did
    return;
  }
  if id == "fault.pump" { s[0].hull.pumping = !s[0].hull.pumping; return; }
  if id == "fault.halving" { s[0].plant.halving = !s[0].plant.halving; return; }
}

// ---------------------------------------------------------------- the canvas's part

// What the canvas still draws under the HUD: lines in the scene (the flow arrows, the hull's bending),
// and the construction view's own strip until it moves to the HUD.
sb_lines :: (s: [] Slab, out: [] f32) -> int {
  s[0].hp.lab.flow_n = 0;   // the flow view's names are handed over again each frame (lab_flow)
  // the build view's words are in the pane's sheet (bd_hud); the canvas draws its chart
  if s[0].build.on { return bd_lines_2d(s, out); }
  n := 0;
  n = tour_lines(s, out, n);
  if s[0].flow { n = flow_overlay(s, out, n); }
  if s[0].section { n = bend_overlay(s, out, n); }
  return n;
}

// A key the HUD takes before the world does (slab_key). With the pane on, the keys that used to step
// blind through the sites, seas, powers and layouts open Change, where every choice is listed; I and ?
// open the sheets that hold what the old panels said; Esc shuts the open sheet.
sb_key :: (s: [] Slab, key: int) -> bool {
  if !s[0].hp.pane || !s[0].hud { return false; }
  if tour_key(s, key) { return true; }
  if s[0].build.on { return false; }
  if key == 'n' || key == 'N' || key == 'm' || key == 'M' || key == 'p' || key == 'P' || key == 'k' || key == 'K' { sb_open(s, "change"); return true; }
  if key == 'i' || key == 'I' { sb_open(s, "inside"); return true; }
  if key == '?' { sb_open(s, "help"); return true; }
  if key == KEY_ESCAPE && s[0].selected == -1 { sb_open(s, ""); }
  return false;
}

// A press on the scene: whether it was a finger's, which decides what Look offers.
sb_touch :: (s: [] Slab, phase: int, kind: int) {
  if phase == 0 { s[0].hp.touch = kind == 1; }
}
// Two fingers. The first finger down drags as a mouse does. A second one turns the drag into a
// pinch: the view zooms by how far the fingers move apart (as the wheel zooms it; flying has no
// zoom), and neither finger's lift counts as a tap. True when the event is the pinch's.
sb_pinch :: (s: [] Slab, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 {
    if s[0].touch_a == -1 || s[0].touch_a == id { s[0].touch_a = id; s[0].touch_b = -1; s[0].touch_ax = x; s[0].touch_ay = y; return false; }
    s[0].touch_b = id; s[0].touch_bx = x; s[0].touch_by = y;
    s[0].dragging = false;
    return true;
  }
  if phase == 1 {
    if s[0].touch_b == -1 { if id == s[0].touch_a { s[0].touch_ax = x; s[0].touch_ay = y; } return false; }
    was := sqrt((s[0].touch_ax - s[0].touch_bx) * (s[0].touch_ax - s[0].touch_bx) + (s[0].touch_ay - s[0].touch_by) * (s[0].touch_ay - s[0].touch_by));
    if id == s[0].touch_a { s[0].touch_ax = x; s[0].touch_ay = y; } else if id == s[0].touch_b { s[0].touch_bx = x; s[0].touch_by = y; } else { return true; }
    now := sqrt((s[0].touch_ax - s[0].touch_bx) * (s[0].touch_ax - s[0].touch_bx) + (s[0].touch_ay - s[0].touch_by) * (s[0].touch_ay - s[0].touch_by));
    if was > 1 && now > 1 && s[0].mode != CAM_FLY { slab_wheel(s, (was / now - 1) * 1000); }
    return true;
  }
  if s[0].touch_b == -1 { if id == s[0].touch_a { s[0].touch_a = -1; } return false; }
  // one of the two lifts: the other stays down and does nothing more until it lifts too
  if id == s[0].touch_a { s[0].touch_a = s[0].touch_b; s[0].touch_ax = s[0].touch_bx; s[0].touch_ay = s[0].touch_by; }
  s[0].touch_b = -1;
  s[0].dragging = false;
  return true;
}

// The page's address, once: the pane is asked for unless the HUD is off.
sb_address :: (s: [] Slab, url: string) {
  s[0].hp.pane = true;
  if s[0].build.on { sb_open(s, "build"); }
  tour_address(s, url);
  cd_address(s, url);
}
// The pane the browser draws beside the canvas, its last saying and how many there have been (the
// face's coaxial_pane, coaxial_pane_model and coaxial_pane_rev).
slab_pane :: (s: [] Slab) -> string #export_c #effects(all) { return ifx s.count > 0 && s[0].hp.pane && s[0].hud && !s[0].golden then SB_PANE else ""; }
slab_pane_rev :: (s: [] Slab) -> int #export_c #effects(all) { return s[0].hp.said[0].rev; }
slab_pane_model :: (s: [] Slab) -> string #export_c #effects(all) { return sh_text(s[0].hp.said[..]); }

// ---------------------------------------------------------------- checks

SbTest :: struct { s: [1] Slab; }
sb_test_open :: (x: [] SbTest) {
  s := x[0].s[..];
  slab_reset(s);
  slab_message(s, HOST_FACTS, "url=https://openagents.com/realms/slab/\n");
  sb_say(s);
}
// Whether the saying has a line of `kind` whose first field is `a` (and whose second is `b`, when given).
sb_test_has :: (s: [] Slab, kind: u8, a: string, b: string) -> bool {
  text := sh_text(s[0].hp.said[..]);
  i := 0;
  while i < text.count {
    l := sh_read(text, i); i = l.next;
    if l.kind == kind && l.n > 0 && l.f[0] == a && (b.count == 0 || (l.n > 1 && l.f[1] == b)) { return true; }
  }
  return false;
}
// The field `k` of the first line of `kind` whose first field is `a`.
// How many lines of `kind` the saying has.
sb_test_count :: (s: [] Slab, kind: u8) -> int {
  text := sh_text(s[0].hp.said[..]);
  i := 0; n := 0;
  while i < text.count { l := sh_read(text, i); i = l.next; if l.kind == kind { n += 1; } }
  return n;
}
sb_test_field :: (s: [] Slab, kind: u8, a: string, k: int) -> string {
  text := sh_text(s[0].hp.said[..]);
  i := 0;
  while i < text.count {
    l := sh_read(text, i); i = l.next;
    if l.kind == kind && l.n > k && l.f[0] == a { return l.f[k]; }
  }
  return "";
}

#test "HUD: short of power, the data halls say what carries them, and the rest go dark when the batteries are spent" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  // off California the ocean plant alone gives the halls almost nothing
  s[0].plant.power = POWER_OTEC; s[0].site = SITE_CALIFORNIA; s[0].month = 1.5;
  s[0].power = sim_power(slab_plant(s), sim_site(s[0].site), s[0].month);
  #assert s[0].power.data_on_backup && s[0].power.data_load - s[0].power.data > SIM_BACKUP_GEN;
  sb_backup_step(s, 0);
  #assert s[0].hp.backup.lit == 1 && sb_backup_words(s[0].hp.backup) == "Short of power: batteries carry the halls while the generators start";
  sb_backup_step(s, 120);
  #assert s[0].hp.backup.generators == SIM_BACKUP_GEN && s[0].hp.backup.lit == 1 && sb_backup_words(s[0].hp.backup) == "Short of power: generators and batteries carry the halls";
  sb_say(s);
  #assert sb_test_has(s, 'F', "Battery left", "13 min") && !sb_test_has(s, 'F', "Halls dark", "");
  // fifteen minutes of the world's clock after they went short, the batteries are spent
  sb_backup_step(s, SIM_BACKUP_BATTERY);
  #assert s[0].hp.backup.dark > 0 && s[0].hp.backup.lit < 1 && sb_backup_words(s[0].hp.backup) == "Batteries spent: the generators carry 40 MW and the rest of the halls are dark";
  sb_say(s);
  #assert sb_test_has(s, 'F', "Halls dark", "") && !sb_test_has(s, 'F', "Battery left", "");
  // the power back, the halls are whole again and the batteries' clock is wound back
  s[0].plant.power = POWER_NUCLEAR;
  s[0].power = sim_power(slab_plant(s), sim_site(s[0].site), s[0].month);
  sb_backup_step(s, 1);
  #assert !s[0].power.data_on_backup && s[0].hp.short_s == 0 && s[0].hp.backup.lit == 1;
}
#test "HUD: the world asks for its pane once it has read its address, and not with the HUD off" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  slab_reset(s);
  #assert slab_pane(s) == "";
  slab_message(s, HOST_FACTS, "url=https://openagents.com/realms/slab/\n");
  #assert slab_pane(s) == "scene-pane";
  sb_say(s);
  #assert slab_pane_rev(s) == 1 && slab_pane_model(s).count > 1000 && !s[0].hp.said[0].lost;
  sb_say(s);
  #assert slab_pane_rev(s) == 1;
  ys: [1] SbTest; y := ys[..]; r := y[0].s[..];
  slab_reset(r);
  slab_message(r, HOST_FACTS, "url=https://openagents.com/realms/slab/?hud=0\n");
  #assert slab_pane(r) == "";
  sb_say(r);
  #assert slab_pane_model(r).count == 0;
}
#test "HUD: a number's thousands are separated once" {
  t: [1] SbText;
  t[0] = sb_n(sb_w(SbText.{}, "Day "), 1401, 0); #assert sb_s(t[..]) == "Day 1,401";
  t[0] = sb_n(SbText.{}, 15374950.5, 1); #assert sb_s(t[..]) == "15,374,950.5";
  t[0] = sb_n(SbText.{}, -1187.5, 1); #assert sb_s(t[..]) == "-1,187.5";
  t[0] = sb_n(SbText.{}, 999, 0); #assert sb_s(t[..]) == "999";
}
#test "HUD: four groups in plain words, and every menu says its choices" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  #assert sb_test_has(s, 'G', "look", "Look") && sb_test_has(s, 'G', "inside", "See inside") && sb_test_has(s, 'G', "change", "Change");
  #assert sb_test_has(s, 'M', "mode.build", "Build it") && sb_test_has(s, 'M', "mode.explore", "Explore") && !sb_test_has(s, 'G', "build", "");
  #assert sb_test_has(s, 'T', "view.section", "Cut it open") && sb_test_has(s, 'T', "view.under", "Go underwater") && sb_test_has(s, 'T', "view.flow", "Water and power");
  #assert sb_test_has(s, 'O', "site.0", "Guam, west coast") && sb_test_has(s, 'O', "site.6", "Norway, Yrkefjorden") && sb_test_has(s, 'O', "sea.5", "Hurricane");
  #assert sb_test_has(s, 'O', "power.otec", "Ocean thermal power") && sb_test_field(s, 'O', "power.hybrid", 3) == "1" && sb_test_has(s, 'O', "layout.2", "") && sb_test_has(s, 'O', "go.8", "From 1.5 km out");
  // no line is in capitals: every word of three letters or more has a small letter (units and names like SLAB, OTEC and MW aside)
  text := sh_text(s[0].hp.said[..]);
  i := 0; shout := 0;
  while i < text.count {
    j := i; caps := 0; small := 0;
    while j < text.count && text[j] != '\n' { if text[j] >= 'A' && text[j] <= 'Z' { caps += 1; } if text[j] >= 'a' && text[j] <= 'z' { small += 1; } j += 1; }
    if caps > 8 && caps > small { shout += 1; }
    i = j + 1;
  }
  #assert shout == 0;
  // the build view has the fourth group, and going back takes it away
  sb_act(s, "mode.build"); sb_say(s);
  #assert s[0].build.on && sb_test_has(s, 'G', "build", "Build it") && !sb_test_has(s, 'G', "look", "") && sb_test_field(s, 'D', "build", 0) == "build";
  bd_ready(s); sb_say(s);   // the run done (it goes on a piece a frame: slab-build-draw.coax bd_more)
  #assert sb_test_has(s, 'R', "build.at", "") && sb_test_has(s, 'B', "build.play", "");
  sb_act(s, "mode.explore"); sb_say(s);
  #assert !s[0].build.on && sb_test_has(s, 'G', "look", "Look");
}
#test "HUD: a press does what its control says" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  sb_act(s, "look.fly"); #assert s[0].mode == CAM_FLY;
  sb_act(s, "look.orbit"); #assert s[0].mode == CAM_ORBIT;
  d := s[0].dist; sb_act(s, "look.in"); #assert s[0].dist < d; sb_act(s, "look.out"); #assert abs(s[0].dist - d) < 1;
  sb_act(s, "go.6"); sb_say(s);
  #assert s[0].tx == STATION_X[6] && sb_test_has(s, 'Y', "The bow", "");
  sb_act(s, "view.section"); #assert s[0].section; sb_act(s, "view.section"); #assert !s[0].section;
  sb_act(s, "view.flow"); #assert s[0].flow;
  sb_act(s, "site.4"); #assert s[0].site == SITE_CALIFORNIA && s[0].sea == SEA_WINTER;
  sb_act(s, "sea.4"); #assert s[0].sea == SEA_GALE;
  sb_act(s, "hour 50"); #assert s[0].hour == 12.5;
  sb_act(s, "month 0"); #assert s[0].month == 0.5;
  sb_act(s, "hour"); #assert s[0].hour == 12.5;
  sb_act(s, "power.demo"); #assert s[0].plant.demo10 && s[0].plant.power == POWER_OTEC;
  sb_act(s, "power.hybrid"); #assert !s[0].plant.demo10 && s[0].plant.power == POWER_HYBRID;
  sb_act(s, "layout.1"); #assert s[0].layout == LAYOUT_DOME;
  sb_say(s);
  #assert !sb_test_has(s, 'T', "view.section", "") && sb_test_has(s, 'T', "fault.hole", "");
  sb_act(s, "layout.0"); sb_act(s, "fault.hole"); sb_say(s);
  #assert s[0].hull.holed && sb_test_has(s, 'T', "fault.pump", "");
  sb_act(s, "pause"); #assert s[0].paused;
  sb_act(s, "no.such.thing"); sb_act(s, "");
}
#test "HUD: two fingers zoom the orbit and do not turn it, and a finger is not offered walk or fly" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  d := s[0].dist; yaw := s[0].yaw;
  _ = slab_pointer(s, 100, 300, 0, 1, 7);
  _ = slab_pointer(s, 200, 300, 0, 1, 8);
  _ = slab_pointer(s, 300, 300, 1, 1, 8);
  #assert s[0].dist < d && s[0].yaw == yaw && s[0].hp.touch;
  _ = slab_pointer(s, 300, 300, 2, 1, 8);
  _ = slab_pointer(s, 100, 300, 2, 1, 7);
  #assert s[0].selected == -1;
  // a finger's visitor is not offered what needs a keyboard
  sb_say(s);
  #assert !sb_test_has(s, 'O', "look.walk", "") && sb_test_has(s, 'B', "look.in", "Closer");
}
#test "HUD: the keys that stepped blind through sites and powers open Change, where the choices are listed" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  site := s[0].site; power := s[0].plant.power;
  #assert slab_key(s, 'n', true) && slab_key(s, 'p', true) && slab_key(s, 'k', true);
  sb_say(s);
  #assert s[0].site == site && s[0].plant.power == power && s[0].layout == LAYOUT_PRIME && sb_test_field(s, 'D', "change", 0) == "change";
  #assert slab_key(s, '?', true); sb_say(s);
  #assert sb_test_field(s, 'D', "help", 0) == "help" && !s[0].help;
  // with the HUD off, the old keys work as they did
  _ = slab_key(s, 'h', true);
  #assert slab_key(s, 'n', true) && s[0].site == (site + 1) % SITES;
}
#test "two fingers pinch the orbit in and out, and lifting them is no tap" {
  s: [1]Slab;
  slab_message(s[..], HOST_FACTS, "url=/worlds/slab?t=1\n");
  s[0].dpr = 1; s[0].width = 390; s[0].height = 844;
  d := s[0].dist;
  #assert slab_pointer(s[..], 100, 400, 0, 1, 7) && s[0].dragging;
  #assert slab_pointer(s[..], 200, 400, 0, 1, 8) && !s[0].dragging;   // the second finger: a pinch
  _ = slab_pointer(s[..], 300, 400, 1, 1, 8);                          // apart, 100 to 200 px: twice as close
  #assert abs(s[0].dist - d * 0.5) < 1 && s[0].yaw == 0.802;
  _ = slab_pointer(s[..], 150, 400, 1, 1, 8);                          // together, 200 to 50 px: four times as far
  #assert abs(s[0].dist - d * 2) < 4;
  _ = slab_pointer(s[..], 150, 400, 2, 1, 8);
  _ = slab_pointer(s[..], 100, 400, 2, 1, 7);
  #assert s[0].selected == -1 && s[0].touch_a == -1 && s[0].touch_b == -1 && !s[0].dragging;
  // one finger again drags as before
  _ = slab_pointer(s[..], 100, 400, 0, 1, 9); _ = slab_pointer(s[..], 150, 400, 1, 1, 9);
  #assert s[0].yaw != 0.802;
}
#test "HUD: a phone's opening looks down more steeply and nearer, until the visitor moves it" {
  s: [1] Slab; slab_reset(s[..]); s[0].hp.pane = true;
  tour_opening(s[..]); sb_open_fit(s[..], 390, 844);
  #assert abs(s[0].pitch - (TOUR_OPEN.pitch + SB_OPEN_PITCH)) < 0.001 && abs(s[0].dist - TOUR_OPEN.dist * (1 - SB_OPEN_NEAR)) < 0.5 && s[0].yaw == TOUR_OPEN.yaw;
  s[0].aspect = 390.0 / 844.0;
  #assert abs(sb_open_lift(s[..]) - SB_OPEN_LIFT) < 0.001;
  sb_open_fit(s[..], 390, 844);   // once only
  #assert abs(s[0].pitch - (TOUR_OPEN.pitch + SB_OPEN_PITCH)) < 0.001;
  s[0].yaw += 0.1;
  #assert sb_open_lift(s[..]) == 0 && s[0].hp.open == 0;
  w: [1] Slab; slab_reset(w[..]);
  tour_opening(w[..]); sb_open_fit(w[..], 1440, 900); w[0].aspect = 1.6;
  #assert w[0].pitch == TOUR_OPEN.pitch && w[0].dist == TOUR_OPEN.dist && sb_open_lift(w[..]) == 0;
}
#test "HUD: a thing's card on a phone lifts the view more for a thing pressed low on the screen" {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  if s[0].hp.tour.on { tour_end(s); }
  lab_test_view(s, TOUR_OPEN, 390, 844);
  #assert s[0].box_count > 0;
  // the things standing lowest and highest on the screen
  low := -1; high := -1; ly := -1.0e9f32; hy := 1.0e9f32;
  for i: 0..<s[0].box_count {
    q := screen_of(s, (rec(s, i, 0) + rec(s, i, 4)) / 2, (rec(s, i, 1) + rec(s, i, 5)) / 2, (rec(s, i, 2) + rec(s, i, 6)) / 2);
    if !(q[2] > 5) { continue; }
    if q[1] > ly { ly = q[1]; low = i; }
    if q[1] < hy { hy = q[1]; high = i; }
  }
  #assert low >= 0 && high >= 0 && ly > hy;
  s[0].selected = low; s[0].hp.lift = 0; a := sb_card_lift(s, 0.1);
  s[0].selected = high; s[0].hp.lift = 0; b := sb_card_lift(s, 0.1);
  #assert a > b && a > 0;
}
#test "HUD: an open sheet on a phone held upright lifts the view as a card does; shut, or on a wide screen, it does not" {
  s: [1] Slab; slab_reset(s[..]); s[0].hp.pane = true; s[0].tanh = 1;
  s[0].aspect = 390.0 / 844.0; s[0].selected = -1;
  sb_act(s[..], "hud.sheet 412");
  for i: 0..<60 { _ = sb_card_lift(s[..], 0.1); }
  #assert abs(s[0].hp.lift - tour_tall(s[..])) < 0.001;
  sb_act(s[..], "hud.sheet 0");
  for i: 0..<60 { _ = sb_card_lift(s[..], 0.1); }
  #assert s[0].hp.lift < 0.001;
  s[0].aspect = 1.6; sb_act(s[..], "hud.sheet 412");
  #assert sb_card_lift(s[..], 1) == 0;
}
#test "HUD: a resized hull eases the orbit to fill the screen as the picture's does, and a hand-made zoom stays" {
  s: [1] Slab; slab_reset(s[..]);
  if s[0].hp.tour.on { tour_end(s[..]); }
  sb_hull_fit(s[..], 0.1);
  #assert !s[0].hp.fit_on;   // the picture's hull: nothing to do
  d0 := s[0].dist;
  change_preset(s[0].change[..], WP_PILOT);
  for i: 0..<200 { sb_hull_fit(s[..], 0.1); }
  hs := change_hull(s[0].change[..]);
  #assert abs(s[0].dist - TOUR_OPEN.dist * sb_fit_share(hs[0] * 2, hs[1] * 2, hs[2] - hs[3])) < 1 && s[0].dist < d0 / 4 && !s[0].hp.fit_on;
  // the visitor zooms out by hand: it stays
  s[0].dist = 900; sb_hull_fit(s[..], 0.1);
  #assert s[0].dist == 900;
  // a hull of 2,000 by 1,000 m is fitted farther than the picture's, within the orbit's reach
  change_preset(s[0].change[..], WP_PICTURE);
  w := s[0].change[0].what; w.v[WC_LENGTH] = 2000; w.v[WC_WIDTH] = 1000; s[0].change[0].what = w; change_refresh(s[0].change[..]);
  hs = change_hull(s[0].change[..]);
  #assert hs[0] * 2 == 2000;
  sb_hull_fit(s[..], 0.1);
  #assert s[0].hp.fit_on;
  s[0].dist -= 10; sb_hull_fit(s[..], 0.1);   // moved during the easing: it ends
  #assert !s[0].hp.fit_on;
  s[0].hp.fit_l = 1; for i: 0..<200 { sb_hull_fit(s[..], 0.1); }
  #assert s[0].dist > TOUR_OPEN.dist * 1.5 && s[0].dist <= 9000;
}
#test "HUD: an open card on a phone held upright lifts the orbit's view, and nothing else does" {
  s: [1] Slab; slab_reset(s[..]); s[0].hp.pane = true; s[0].tanh = 1;
  s[0].aspect = 390.0 / 844.0; s[0].selected = 0;
  for i: 0..<60 { _ = sb_card_lift(s[..], 0.1); }
  #assert abs(s[0].hp.lift - tour_tall(s[..])) < 0.001 && s[0].hp.lift > 0.3;
  f := view_lift(s[..], [3] f32.[0, 0, -1], s[0].hp.lift);
  #assert f[1] < -0.3;   // tipped down: what it looked at stands above the middle
  s[0].selected = -1;
  for i: 0..<60 { _ = sb_card_lift(s[..], 0.1); }
  #assert s[0].hp.lift < 0.001;
  s[0].aspect = 1.6; s[0].selected = 0;
  #assert sb_card_lift(s[..], 1) == 0;
}
