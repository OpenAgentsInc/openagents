// The SLAB world's hull on its moorings, on the page (GitHub #13688): the sea as the hull feels
// it, where the hull rests when the weather or the place changes, "lose a line", the lines' drawn
// points for the view under water, and what the HUD says about them. slab.coax loads this file;
// the physics is metaverse/slab-station.coax's and the modules it names.
//
// The hull samples the spectral sea's gameplay band, each wave weighted by its length against
// the draft (metaverse/water-hull.coax), in the sea the hull changes round itself: the page's
// wall and lee models (slab-water.coax) give a gain under each buoyancy column and at each piece
// of waterline (metaverse/slab-shelter.coax), so the forces and the drawn water are one sea. The
// slow drift is not scaled: it already counts the waves the hull turns back (the spec's results,
// "The hull on its moorings").
//
//   coax/bin/coax test apps/openagents-web/slab.coax --only "lines"

#load "../../metaverse/slab-shelter.coax";

LINES_ALL :: 16 + MOOR_STORM_LEGS;              // the hull's own lines and its storm legs
LINES_SHOWN :: 4;                               // the lines nearest the eye, which the view under water draws
LINES_EACH :: 5;                                // floats a line in the block (lines_uniforms)
LINES_HEAD :: 4;                                // the block's first floats: the seabed's height, the fairleads' height, then spare
LINES_FLOATS :: LINES_HEAD + LINES_SHOWN * LINES_EACH;   // their block of the uniforms: 24 floats, 6 vec4s
LINES_LOST :: 2047.0;                           // a line's code: lost, on the seabed
LINES_HALF :: 1024.0;                           // added to a storm leg's code when it has lost a line of its own
LINES_DOC :: "https://github.com/OpenAgentsInc/openagents/blob/main/docs/research/ocean/slab-world-spec.md#the-hull-on-its-moorings";
// What this world does not work out, for the HUD and the hull's card.
LINES_HONEST :: "Not worked out here: how the platform changes the waves round it, beyond the white water at its walls and the calm behind it, and the forces a full hydrodynamic analysis gives for each wave frequency. The water it carries and its damping are stand-ins.";

Lines :: struct {
  sea: [1] DriftSea;        // the sea as the hull feels it this frame
  // what the hull was last put to rest for: a change of any of these is a change of weather or place
  have: bool; site: int; layout: int; wind: f64; depth: f64;
  lose: int;                // ?lose=N: lines already lost when the world opens
  // where the lines that still hold will bring the hull to rest, worked out when a line goes
  rested: bool; rest_lost: u32; rest_chains: f64; rest: SimStation;
  // the sea as the hull changes it, for its forces, and the wall and lee models' lay it was made from
  shelter: [1] Shelter;
  sheltered: bool; lee_wind: f64; lee_x: f64; lee_z: f64; lee_c: f64; lee_s: f64; lee_mode: int;
}

// The gains of the sea round the hull, from the wall and lee models as they are laid now. They
// are made again only when those models are laid again (a new wind, or the hull has moved or turned).
lines_shelter :: (s: [] Slab, phone: bool) {
  w := s[0].water[..]; k := s[0].lines[..];
  slab_water_bodies(s);
  if w[0].mode == 0 { shelter_none(k[0].shelter[..]); k[0].sheltered = false; return; }
  ww_lay(w, s[0].synth[..], phone);
  if k[0].sheltered && k[0].lee_wind == w[0].for_wind && k[0].lee_x == w[0].for_x && k[0].lee_z == w[0].for_z && k[0].lee_c == w[0].for_c && k[0].lee_s == w[0].for_s && k[0].lee_mode == w[0].for_mode { return; }
  k[0].sheltered = true; k[0].lee_wind = w[0].for_wind; k[0].lee_x = w[0].for_x; k[0].lee_z = w[0].for_z; k[0].lee_c = w[0].for_c; k[0].lee_s = w[0].for_s; k[0].lee_mode = w[0].for_mode;
  shelter_none(k[0].shelter[..]);
  ok := true;
  if s[0].layout == LAYOUT_CLUSTER {
    for i: 0..<SIM_DOMES { d := s[0].cluster.domes[i]; ok = ok && shelter_body(k[0].shelter[..], sim_shape(d), d, w[0].frame, w[0].bodies[i], w[0].sea, w[0].faces, w[0].grid[..]); }
  } else {
    ok = shelter_body(k[0].shelter[..], sim_shape(s[0].hull), s[0].hull, w[0].frame, w[0].bodies[0], w[0].sea, w[0].faces, w[0].grid[..]);
  }
  if !ok { shelter_none(k[0].shelter[..]); }
}
// The sea's tiles for the hull at this tick, and the hull's steps on them for a frame of `frame`
// seconds. Called once a frame after the sea's own tile is made (its working room is free then).
lines_step :: (s: [] Slab, tick: u64, wx: f64, wz: f64, frame: f64, settle: bool, phone: bool) {
  depth := slab_site(s).depth; wind := s[0].wind;
  // the hull the "What would it take?" panel gives: its size, draft and load move it (a change
  // lays its lines afresh, so the next lines put it at rest for that hull)
  if !s[0].hull.round && s[0].layout != LAYOUT_CLUSTER { s[0].hull = sim_hull_sized(s[0].hull, lines_shape(s)); }
  whl_sea(s[0].synth[..], tick, sim_shape(s[0].hull).t, s[0].tile[0].scratch[..], s[0].lines[0].sea[..]);
  if s[0].layout == LAYOUT_CLUSTER {
    for i: 0..<SIM_DOMES { s[0].cluster.domes[i].depth = depth; }
    lines_shelter(s, phone);
    nc := s[0].lines[0].shelter[0].columns; ne := s[0].lines[0].shelter[0].edges;
    if settle && s[0].cluster.domes[0].time < 20 {
      for i: 0..<300 { s[0].cluster = sim_cluster_step_lee(s[0].cluster, s[0].lines[0].sea[..], s[0].lines[0].shelter[0].lee[0..<nc], s[0].lines[0].shelter[0].wall[0..<ne], wind, wx, wz, SIM_STEP); }
    }
    s[0].cluster = sim_cluster_advance_lee(s[0].cluster, s[0].lines[0].sea[..], s[0].lines[0].shelter[0].lee[0..<nc], s[0].lines[0].shelter[0].wall[0..<ne], wind, wx, wz, frame);
    s[0].hull = s[0].cluster.domes[0];
    return;
  }
  s[0].hull.depth = depth;
  k := s[0].lines[0];
  if !k.have || !s[0].hull.rig[0].built || k.site != s[0].site || k.layout != s[0].layout || k.wind != wind || k.depth != depth {
    // new weather or a new place: the storm legs are made fast if it is a storm warning, and the
    // hull is where hours of it would leave it
    s[0].hull = sim_hull_weathered(s[0].hull, s[0].lines[0].sea[..], wind, wx, wz);
    for i: 0..<k.lose { s[0].hull = sim_hull_settle(sim_lose_line(s[0].hull), s[0].lines[0].sea[..], wind, wx, wz); }
    s[0].lines[0].lose = 0;
    s[0].lines[0].have = true; s[0].lines[0].site = s[0].site; s[0].lines[0].layout = s[0].layout;
    s[0].lines[0].wind = wind; s[0].lines[0].depth = depth; s[0].lines[0].rested = false;
  }
  // the sea round the hull where it lies now
  lines_shelter(s, phone);
  nc := s[0].lines[0].shelter[0].columns; ne := s[0].lines[0].shelter[0].edges;
  if settle && s[0].hull.time < 30 {
    // a fixed moment: let the hull's heave and roll settle onto it
    for i: 0..<20 { s[0].hull = sim_hull_advance_lee(s[0].hull, s[0].lines[0].sea[..], s[0].lines[0].shelter[0].lee[0..<nc], s[0].lines[0].shelter[0].wall[0..<ne], wind, wx, wz, 0.1); }
  }
  held := s[0].hull.lost;
  s[0].hull = sim_hull_advance_lee(s[0].hull, s[0].lines[0].sea[..], s[0].lines[0].shelter[0].lee[0..<nc], s[0].lines[0].shelter[0].wall[0..<ne], wind, wx, wz, frame);
  if s[0].hull.lost != held { sb_toast(s, "A mooring line reached its breaking load and parted."); }
  if !lines_rest_now(s) {
    s[0].lines[0].rest = sim_station(sim_hull_settle(s[0].hull, s[0].lines[0].sea[..], wind, wx, wz));
    s[0].lines[0].rested = true; s[0].lines[0].rest_lost = s[0].hull.lost; s[0].lines[0].rest_chains = lines_chains(s[0].hull);
  }
}
// The lines in the hull's rig, a storm leg counting each of its own.
lines_chains :: (h: SimHull) -> f64 { n := 0.0; for i: 0..<h.rig[0].count { n += h.rig[0].chains[i]; } return n; }
// Whether the rest worked out last is for the lines that hold now.
lines_rest_now :: (s: [] Slab) -> bool {
  k := s[0].lines[0];
  return k.rested && k.rest_lost == s[0].hull.lost && k.rest_chains == lines_chains(s[0].hull);
}
// The most loaded line parts; the hull moves off and turns over the next minutes.
lines_lose :: (s: [] Slab) {
  if s[0].layout == LAYOUT_CLUSTER { return; }
  s[0].hull = sim_lose_line(s[0].hull);
}
// New lines on every fairlead, and the hull back where they hold it.
lines_refit :: (s: [] Slab) {
  s[0].hull = sim_refit_lines(s[0].hull);
  s[0].lines[0].have = false;
}
// The hull's shape for the physics: the panel's hull in the prime layout, else prime's.
lines_shape :: (s: [] Slab) -> SimShape {
  if s[0].layout == LAYOUT_PRIME && s[0].change[0].ready && !change_picture_hull(s[0].change[..]) { return sim_shape_of_hull(s[0].change[0].facts.shape, s[0].change[0].facts.led); }
  return sim_prime_shape();
}
// The storm legs made fast, or let go, in the weather now; the hull is where the lines then hold it.
lines_storm :: (s: [] Slab, fast: bool) {
  if s[0].layout == LAYOUT_CLUSTER { return; }
  wd := wsp_direction(s[0].spectrum);
  s[0].hull = sim_hull_stormed(s[0].hull, fast, s[0].lines[0].sea[..], s[0].wind, wd.x, wd.y);
  s[0].lines[0].rested = false;
}

// Every line as sim_line_packed has it, in the world's frame: STATION_PACKED floats each at
// out[j * STATION_PACKED] for j up to LINES_ALL (under 0 at +4: no line).
lines_packed :: (h: SimHull, out: [] f32) {
  for j: 0..<LINES_ALL { sim_line_packed(h, j, out, j * STATION_PACKED); }
}
// Whether storm leg j has lost a line of its own (its partner carries it).
lines_half :: (h0: SimHull, j: int) -> bool {
  h := sim_rigged(h0); sh := sim_shape(h); rig := h.rig[0];
  if j < rig.own || j >= rig.count { return false; }
  made := ifx j - rig.own < 2 * MOOR_STORM_LONG then sh.storm_kz else sh.storm_kx;
  return rig.chains[j] > 0 && rig.chains[j] < f64(made);
}
// The lines for the view under the sea, in the world's frame: LINES_FLOATS floats at u[at..]. The
// seabed's height and the fairleads', then the LINES_SHOWN lines nearest the eye (the sea hides
// the rest: under water the view reaches tens of metres), each its anchor x, z, its fairlead x, z,
// and a code: under 0 no line; else 2,048 times the share of the way along the seabed at which it
// leaves it (in thousandths) plus how far it hangs below the straight run half way, in m, with
// LINES_HALF added for a storm leg down to one line, or LINES_LOST for a line on the seabed. The
// shader (gpu/slab.coax, slab_lines) draws each along the seabed, then up a parabola to the hull.
// A uniform block holds 4,096 vec4s on every device WebGPU promises; this block keeps to six.
lines_uniforms :: (s: [] Slab, u: [] f32, at: int) {
  for i: 0..<LINES_FLOATS { u[at + i] = 0; }
  for j: 0..<LINES_SHOWN { u[at + LINES_HEAD + j * LINES_EACH + 4] = -1; }
  if !s[0].under || s[0].build.on || s[0].layout == LAYOUT_CLUSTER { return; }
  h := s[0].hull;
  bed := -f32(sim_rigged(h).rig[0].depth); fy := f32(sim_fairlead_y(h));
  u[at] = bed; u[at + 1] = fy;
  p: [LINES_ALL * STATION_PACKED] f32;
  lines_packed(h, p[..]);
  // each line's distance from the eye: to the straight run from its anchor to its fairlead
  far: [LINES_ALL] f32;
  e := s[0].eye;
  for j: 0..<LINES_ALL {
    b := j * STATION_PACKED;
    far[j] = 1.0e30;
    if p[b + 4] < 0 { continue; }
    top := ifx p[b + 5] >= 1 then bed else fy;
    dx := p[b + 2] - p[b]; dy := top - bed; dz := p[b + 3] - p[b + 1];
    ll := dx * dx + dy * dy + dz * dz;
    t: f32 = 0;
    if ll > 0 { t = ((e[0] - p[b]) * dx + (e[1] - bed) * dy + (e[2] - p[b + 1]) * dz) / ll; }
    if t < 0 { t = 0; } if t > 1 { t = 1; }
    qx := p[b] + dx * t - e[0]; qy := bed + dy * t - e[1]; qz := p[b + 1] + dz * t - e[2];
    far[j] = qx * qx + qy * qy + qz * qz;
  }
  for k: 0..<LINES_SHOWN {
    best := -1;
    for j: 0..<LINES_ALL { if far[j] < 1.0e29 && (best < 0 || far[j] < far[best]) { best = j; } }
    if best < 0 { break; }
    far[best] = 1.0e30;
    b := best * STATION_PACKED; o := at + LINES_HEAD + k * LINES_EACH;
    u[o] = p[b]; u[o + 1] = p[b + 1]; u[o + 2] = p[b + 2]; u[o + 3] = p[b + 3];
    sag := -p[b + 5]; if sag < 0 { sag = 0; } if sag > 1000 { sag = 1000; }
    code := f32(floor(f64(p[b + 4]) * 1000.0 + 0.5)) * 2048.0;
    if p[b + 5] >= 1 { code += f32(LINES_LOST); } else { code += f32(floor(f64(sag) + 0.5)); if lines_half(h, best) { code += f32(LINES_HALF); } }
    u[o + 4] = code;
  }
}

// ---------------------------------------------------------------- words
// The hull whose lines the words are about: the platform or the dome, or a cluster's first outer dome.
lines_hull :: (s: [] Slab) -> SimHull { return ifx s[0].layout == LAYOUT_CLUSTER then s[0].cluster.domes[1] else s[0].hull; }
// The layout in a sentence: what the lines are, how long, and how deep the water is.
lines_layout :: (st: SimStation) -> SbText {
  t: SbText;
  t = sb_n(t, f64(st.lines), 0);
  if st.kind == MOOR_CATENARY {
    t = sb_w(t, " chains, each "); t = sb_n(t, st.length, 0); t = sb_w(t, " m long, run from the waterline and lie along the seabed ");
    t = sb_n(t, st.depth, 0); t = sb_w(t, " m down. Their weight holds the platform.");
  } else {
    t = sb_w(t, " taut rope lines, each "); t = sb_n(t, st.length, 0); t = sb_w(t, " m long, run from the keel to anchors ");
    t = sb_n(t, st.span, 0); t = sb_w(t, " m out, in water "); t = sb_n(t, st.depth, 0); t = sb_w(t, " m deep. Their stretch holds the platform.");
  }
  return t;
}
// The hull's card (slab.coax's slab_card, in its capitals): the layout, and what is not modelled.
lines_card :: (s: [] Slab, c: [] Card) {
  st := sim_station(s[0].hull);
  l := line(c, ST_BODY, ""); num(c, l, f64(st.lines), 0);
  if st.kind == MOOR_CATENARY {
    more(c, l, " CHAINS OF "); num(c, l, st.length, 0); more(c, l, " M LIE ALONG THE SEABED "); num(c, l, st.depth, 0); more(c, l, " M DOWN");
  } else {
    more(c, l, " TAUT LINES, KEEL TO ANCHORS "); num(c, l, st.span, 0); more(c, l, " M OUT, "); num(c, l, st.depth, 0); more(c, l, " M DOWN");
  }
  ln(c, ST_NOTE, "NOT MODELLED: HOW THE HULL CHANGES THE WAVES ROUND IT, BEYOND");
  ln(c, ST_NOTE, "ITS WALL AND LEE; THE FORCES AT EACH WAVE FREQUENCY");
}
lines_card_now :: (s: [] Slab, c: [] Card) {
  st := sim_station(s[0].hull);
  l := line(c, ST_LIVE, "OFFSET "); num(c, l, st.offset, 1); more(c, l, " M  TURN "); num(c, l, abs(st.turn), 2);
  more(c, l, "°  PEAK LINE "); num(c, l, st.peak / 1e6, 1); more(c, l, " OF "); num(c, l, st.breaking / 1e6, 0); more(c, l, " MN");
  l = line(c, ST_LIVE, "WIND "); num(c, l, st.wind / 1e6, 1); more(c, l, " MN  WAVES' SLOW PUSH "); num(c, l, st.drift / 1e6, 1); more(c, l, " MN");
  if st.storm { l = line(c, ST_LIVE, "STORM LINES FAST: "); num(c, l, f64(st.storm_lines), 0); more(c, l, " IN "); num(c, l, f64(st.legs), 0); more(c, l, " LEGS"); if st.storm_held < st.storm_lines { more(c, l, ", "); num(c, l, f64(st.storm_lines - st.storm_held), 0); more(c, l, " BROKEN"); } }
  if st.lost > 0 { l = line(c, ST_WARN, "LINES BROKEN: "); num(c, l, f64(st.lost), 0); more(c, l, " OF "); num(c, l, f64(st.lines), 0); }
}
// The hull's card in the HUD (slab-cards.coax, cd_hull): what the lines are doing now ...
lines_cd_now :: (s: [] Slab, h: [] SceneHud) {
  st := sim_station(s[0].hull);
  ts: [1] SbText; t: SbText;
  t = SbText.{}; t = sb_n(t, abs(st.turn), 1); t = sb_w(t, "°"); ts[0] = t;
  sh_fact(h, "Turned by", sb_s(ts[..]), SH_OURS);
  if st.storm {
    t = SbText.{}; t = sb_n(t, f64(st.storm_held), 0); t = sb_w(t, " of "); t = sb_n(t, f64(st.storm_lines), 0); ts[0] = t;
    sh_fact(h, "Storm lines holding", sb_s(ts[..]), SH_OURS);
  }
  if st.lost > 0 {
    t = SbText.{}; t = sb_n(t, f64(st.lost), 0); t = sb_w(t, " of "); t = sb_n(t, f64(st.lines), 0); ts[0] = t;
    sh_fact(h, "Mooring lines broken", sb_s(ts[..]), SH_OURS);
  }
}
// ... and, behind its fold, the layout the depth gives and what this world does not work out.
lines_cd_maths :: (s: [] Slab, h: [] SceneHud) {
  ts: [1] SbText; ts[0] = lines_layout(sim_station(s[0].hull)); sh_say(h, sb_s(ts[..]));
  sh_say(h, LINES_HONEST);
}
lines_hud :: (s: [] Slab, h: [] SceneHud, group: int) {
  if group != HUD_INSIDE || s[0].build.on { return; }
  st := sim_station(lines_hull(s));
  ts: [1] SbText; t: SbText;
  sh_panel(h, "lines", "What holds it in place", "The mooring lines, the push of wind and waves, and what happens when a line breaks");
    if s[0].layout == LAYOUT_CLUSTER { sh_say(h, "Each of the six outer domes has its own lines. The centre dome is held by its bridges. These numbers are one outer dome's."); }
    ts[0] = lines_layout(st); sh_say(h, sb_s(ts[..]));
    t = SbText.{}; t = sb_n(t, f64(st.lines - st.lost), 0); t = sb_w(t, " of "); t = sb_n(t, f64(st.lines), 0); ts[0] = t;
    sh_fact(h, "Lines holding", sb_s(ts[..]), SH_NONE);
    if st.storm {
      t = SbText.{}; t = sb_n(t, f64(st.storm_held), 0); t = sb_w(t, " of "); t = sb_n(t, f64(st.storm_lines), 0); t = sb_w(t, ", in "); t = sb_n(t, f64(st.legs), 0); t = sb_w(t, " legs"); ts[0] = t;
      sh_fact(h, "Storm lines holding", sb_s(ts[..]), SH_OURS);
    }
    t = SbText.{}; t = sb_n(t, st.offset, 0); t = sb_w(t, " m"); ts[0] = t;
    sh_fact(h, "Pushed off its place by", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, abs(st.turn), 1); t = sb_w(t, "°"); ts[0] = t;
    sh_fact(h, "Turned by", sb_s(ts[..]), SH_NONE);
    if st.held > 0 {
      t = SbText.{}; t = sb_n(t, st.peak / 1e6, 1); t = sb_w(t, " of "); t = sb_n(t, st.breaking / 1e6, 0); t = sb_w(t, " meganewtons"); ts[0] = t;
      sh_fact(h, "Hardest-pulled line", sb_s(ts[..]), SH_OURS);
    }
    t = SbText.{}; t = sb_n(t, st.wind / 1e6, 1); t = sb_w(t, " meganewtons"); ts[0] = t;
    sh_fact(h, "Push of the wind", sb_s(ts[..]), SH_NONE);
    t = SbText.{}; t = sb_n(t, st.drift / 1e6, 1); t = sb_w(t, " meganewtons"); ts[0] = t;
    sh_fact(h, "Slow push of the waves", sb_s(ts[..]), SH_NONE);
    if st.held > 0 {
      if st.kind == MOOR_CATENARY {
        t = SbText.{}; t = sb_w(t, "at least "); t = sb_n(t, st.grounded, 0); t = sb_w(t, " m of each"); ts[0] = t;
        sh_fact(h, "Chain still on the seabed", sb_s(ts[..]), SH_NONE);
      } else {
        t = SbText.{}; t = sb_n(t, st.uplift / 1e6, 1); t = sb_w(t, " meganewtons"); ts[0] = t;
        sh_fact(h, "Hardest upward pull on an anchor", sb_s(ts[..]), SH_NONE);
      }
    }
    if lines_hull(s).round { sh_say(h, "The domes have no storm lines in this world: their own lines hold them alone, whatever the weather."); }
    if st.storm { sh_say(h, "A storm is forecast, so storm lines are made fast: more of the same line in legs square to the sides, as during the build. The sixteen alone would be pulled past their safe load."); }
    if st.held == 0 { sh_say(h, "Every line has broken. The platform is adrift."); }
    else if st.lost > 0 || st.storm_held < st.storm_lines {
      sh_say(h, "A broken line lies on the seabed. The platform moves off and turns, over several minutes, until the rest hold it. If one of those reaches its breaking load it goes too.");
      k := s[0].lines[0];
      if s[0].layout != LAYOUT_CLUSTER && lines_rest_now(s) {
        t = SbText.{}; t = sb_n(t, k.rest.offset, 0); t = sb_w(t, " m off its place, turned "); t = sb_n(t, abs(k.rest.turn), 1); t = sb_w(t, "°"); ts[0] = t;
        sh_fact(h, "Where it comes to rest", sb_s(ts[..]), SH_NONE);
        t = SbText.{}; t = sb_n(t, k.rest.peak / 1e6, 1); t = sb_w(t, " of "); t = sb_n(t, k.rest.breaking / 1e6, 0); t = sb_w(t, " meganewtons"); ts[0] = t;
        sh_fact(h, "Hardest-pulled line then", sb_s(ts[..]), SH_NONE);
        if k.rest.peak >= k.rest.breaking { sh_say(h, "That is over its breaking load: another line will part before the platform gets there."); }
      }
    }
    if s[0].layout != LAYOUT_CLUSTER {
      if st.held > 0 { sh_button(h, "lines.lose", "Lose a line", false); }
      if st.lost > 0 || st.storm_held < st.storm_lines { sh_button(h, "lines.refit", "Fit new lines", false); }
      if !lines_hull(s).round { sh_button(h, "lines.storm", ifx st.storm then "Let the storm lines go" else "Make the storm lines fast", false); }
    }
    sh_say(h, LINES_HONEST);
    sh_link(h, "How this is worked out", LINES_DOC);
  sh_end_of(h);
}
lines_act :: (s: [] Slab, id: string, value: int) -> bool {
  if id == "lines.lose" {
    lines_lose(s);
    sb_toast(s, "A line has broken. A platform this heavy takes several minutes to move to where the rest hold it.");
    return true;
  }
  if id == "lines.refit" {
    lines_refit(s);
    sb_toast(s, "New lines are fitted.");
    return true;
  }
  if id == "lines.storm" {
    fast := !s[0].hull.storm;
    lines_storm(s, fast);
    sb_toast(s, ifx fast then "The storm lines are made fast." else "The storm lines are let go. The sixteen hold the platform alone.");
    return true;
  }
  return false;
}

// ---------------------------------------------------------------- checks
// A world in a sea at a site, its hull at rest on its lines at a fixed moment.
lines_test_at :: (s: [] Slab, site: int, sea: int) {
  slab_reset(s);
  s[0].site = site; s[0].sea = sea; s[0].wind_forced = -1;
  slab_build(s, true);
  lines_test_step(s, 0, true);
}
lines_test_step :: (s: [] Slab, frame: f64, settle: bool) {
  sp := s[0].spectrum; wd := wsp_direction(sp);
  tick := wsp_tick_at(sp, s[0].hull.time) % sp.period;
  wsp_tile(s[0].synth[..], 0, tick, s[0].tile[..]);
  lines_step(s, tick, wd.x, wd.y, frame, settle, false);
}

#test "lines: the mooring block follows the sea block, where the shader reads it" {
  // gpu/slab.coax SLAB_MOOR and gpu/slab.bindings' vec4 count (4059) follow these. A uniform block
  // is at most 64 KiB (4,096 vec4s) on every device WebGPU promises, so 37 are left.
  #assert U_MOOR == 16212 && LINES_FLOATS == 24 && UNIFORM_FLOATS == 16236 && UNIFORM_FLOATS == 4059 * 4 && UNIFORM_FLOATS * 4 <= 65536;
  #assert LINES_ALL == 28 && LINES_ALL <= MOOR_MAX && LINES_SHOWN == 4 && LINES_EACH == 5 && STATION_PACKED == 6;
}
#test "lines: the hull's forces read the sea the wall and lee models draw: more at the weather walls, less in the lee" #steps 4000000000 {
  xs: [1] SbTest; s := xs[0].s[..];
  lines_test_at(s, SITE_GUAM, SEA_GALE);
  k := s[0].lines[0].shelter[..]; w := s[0].water[..];
  #assert w[0].laid && w[0].mode == 1 && s[0].lines[0].sheltered && k[0].columns == 6000 && k[0].edges == 320;
  // at a piece of each wall the gain times the open sea is the height the page draws there
  // (ww_height), a hand's breadth off the wall
  plan := sim_plan_of(sim_shape(s[0].hull)); patch := s[0].synth[0].cascades[0].patch;
  picks := [4] int.[50, 150, 230, 290]; mean: [4] f64;
  for q: 0..<4 {
    e := drift_edge(plan, picks[q]);
    at := lee_world(w[0].frame, e.x + e.nx * 1.0e-6, e.z + e.nz * 1.0e-6); wx := at.x; wz := at.y;
    open := wall_at(s[0].tile[0].height[..], s[0].tile[0].size, patch, wx, wz);
    #assert abs(f64(k[0].wall[picks[q]]) * open - ww_height(w, s[0].tile[..], patch, wx, wz)) < 0.002 + 0.002 * abs(open);
    mean[q] = f64(k[0].wall[picks[q]]);
  }
  // the gale comes from just north of east: the south wall, the north, the west (the lee), the east
  #assert mean[3] > 1.6 && mean[1] > 1.3 && mean[2] < 0.5 && mean[0] < mean[1];
  // a second frame at the same place does not lay them again; a new wind does
  was := k[0].wall[290];
  lines_test_step(s, 0.1, false);
  #assert k[0].wall[290] == was;
  s[0].sea = SEA_CALM; slab_build(s, true); lines_test_step(s, 0, true);
  #assert s[0].lines[0].sheltered && s[0].lines[0].lee_wind == s[0].wind && k[0].columns == 6000;
  // a cluster's seven domes each have their own
  set_layout(s, LAYOUT_CLUSTER); slab_build(s, true); lines_test_step(s, 0, true);
  #assert w[0].mode == 2 && k[0].columns == 7 * 384 && k[0].edges == 7 * 38;
}
#test "lines: the pose turns with the hull, and there and back is the same point" {
  xs: [1] SbTest; s := xs[0].s[..];
  slab_reset(s);
  s[0].hull.yaw = 0.1; s[0].hull.surge = 40; s[0].hull.sway = -25; s[0].hull.heave = 0.5;
  slab_pose(s);
  // the bow, 1,000 m along the hull, swings towards north
  w := to_world(s, 1000, 0, 0);
  #assert abs(w[0] - (40 + 1000 * f32(cos(0.1)))) < 0.01 && abs(w[2] - (-25 + 1000 * f32(sin(0.1)))) < 0.01 && abs(w[1] - 0.5) < 0.01;
  b := to_hull(s, w[0], w[1], w[2]);
  #assert abs(b[0] - 1000) < 0.01 && abs(b[1]) < 0.01 && abs(b[2]) < 0.01;
  // with heel and trim too, the frame is still a rotation
  s[0].hull.roll = 0.02; s[0].hull.pitch = -0.01;
  slab_pose(s);
  w = to_world(s, 300, 20, -200); b = to_hull(s, w[0], w[1], w[2]);
  #assert abs(b[0] - 300) < 0.01 && abs(b[1] - 20) < 0.01 && abs(b[2] + 200) < 0.01;
}
#test "lines: a gale holds the platform off its place and turned, with the waves' slow push in the load" #steps 4000000000 {
  xs: [1] SbTest; s := xs[0].s[..]; card: [1] Card;
  lines_test_at(s, SITE_GUAM, SEA_GALE);
  st := sim_station(s[0].hull);
  // wind off the quarter turns it against its lines; the drift is a named part of the load
  #assert st.lines == 16 && st.lost == 0 && st.kind == MOOR_TAUT && st.depth == 1408;
  #assert st.offset > 50 && st.offset < 100 && abs(st.turn) > 0.3 && abs(st.turn) < 3;
  #assert st.drift > 8e6 && st.wind > 30e6 && st.peak > 14e6 && st.peak < st.breaking;
  // a calm day at the same place leaves it almost where it was put
  ys: [1] SbTest; r := ys[0].s[..];
  lines_test_at(r, SITE_GUAM, SEA_CALM);
  calm := sim_station(r[0].hull);
  #assert calm.offset < 5 && calm.drift < 0.2e6 && calm.peak < 6e6;
  // the card says the layout this depth gives, the turn and the drift, and what is not modelled
  slab_card(s, 0, card[..]);
  #assert card[0].lines < CARD_LINES;
  #assert card_says(card[..], "16 TAUT LINES, KEEL TO ANCHORS") && card_says(card[..], "1,408 M DOWN") && card_says(card[..], "TURN ") && card_says(card[..], "WAVES' SLOW PUSH ");
  #assert card_says(card[..], "NOT MODELLED: HOW THE HULL CHANGES THE WAVES") && !card_says(card[..], "LINES BROKEN");
}
#test "lines: lose a line in a gale and the platform moves off and turns, its neighbours take the load, and the card, the HUD and the drawing show it" #steps 4000000000 {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..]; card: [1] Card;
  sb_test_open(x);
  s[0].sea = SEA_GALE; s[0].wind_forced = -1;
  slab_build(s, true);
  lines_test_step(s, 0, true);
  before := sim_station(s[0].hull);
  sb_say(s);
  #assert sb_test_has(s, 'P', "lines", "What holds it in place") && sb_test_has(s, 'F', "Lines holding", "16 of 16");
  #assert sb_test_has(s, 'B', "lines.lose", "Lose a line") && !sb_test_has(s, 'B', "lines.refit", "");
  sb_act(s, "lines.lose");
  #assert sim_lines_lost(s[0].hull) == 1;
  // 15 million tonnes on lines this soft swing in about a quarter of an hour: two minutes on it
  // has begun to move off and turn, and its neighbours' load is rising
  first := sim_station(s[0].hull);
  for i: 0..<1200 { lines_test_step(s, 0.1, false); }
  after := sim_station(s[0].hull);
  #assert first.peak < before.peak && after.peak > first.peak + 0.3e6;
  #assert after.lost == 1 && after.offset > before.offset + 2 && abs(after.turn) > abs(before.turn) + 0.1;
  // where the fifteen come to hold it: some 30 m further off, turned more than twice as far
  rest := sim_station(sim_hull_settle(s[0].hull, s[0].lines[0].sea[..], s[0].wind, wsp_direction(s[0].spectrum).x, wsp_direction(s[0].spectrum).y));
  #assert rest.offset > before.offset + 20 && abs(rest.turn) > 2 * abs(before.turn) && rest.peak > before.peak + 2e6 && rest.peak < rest.breaking;
  sb_say(s);
  #assert sb_test_has(s, 'F', "Lines holding", "15 of 16") && sb_test_has(s, 'B', "lines.refit", "Fit new lines");
  // the HUD says at once where the fifteen will hold it, without the wait
  #assert s[0].lines[0].rested && s[0].lines[0].rest.lost == 1 && s[0].lines[0].rest.offset > before.offset + 20;
  #assert sb_test_has(s, 'F', "Where it comes to rest", "") && sb_test_has(s, 'F', "Hardest-pulled line then", "");
  slab_card(s, 0, card[..]);
  #assert card_says(card[..], "LINES BROKEN: 1 OF 16");
  // under the sea fifteen lines run to the hull and one lies on the seabed
  u: [LINES_ALL * STATION_PACKED] f32; fy := f32(sim_fairlead_y(s[0].hull));
  s[0].under = true; slab_pose(s);
  lines_packed(s[0].hull, u[..]);
  held := 0; down := 0;
  for j: 0..<LINES_ALL {
    at := j * STATION_PACKED;
    // a gale is no storm warning: no storm legs are drawn
    if j >= 16 { #assert u[at + 4] < 0; continue; }
    #assert u[at + 4] >= 0;
    if u[at + 5] < 1 {
      held += 1;
      // a taut leg from its anchor 2 km out to the keel, at a corner of the hull as it lies now
      f := to_hull(s, u[at + 2], fy, u[at + 3]);
      #assert u[at + 4] == 0 && abs(f[1] + f32(SIM_T)) < 0.5 && abs(abs(f[0]) - f32(SIM_L) / 2) < 15 && abs(abs(f[2]) - f32(SIM_B) / 2) < 15;
      #assert sqrt(u[at] * u[at] + u[at + 1] * u[at + 1]) > 2000 && u[at + 5] < 0;
    } else {
      // the broken one lies on the seabed
      down += 1;
      #assert u[at + 4] == 0.5 && u[at + 5] == 1;
    }
  }
  #assert held == 15 && down == 1;
  // the view under the sea draws the four nearest the eye: at the broken line's anchor, it is one
  // of them, on the seabed
  b: [UNIFORM_FLOATS] f32;
  gone := -1; for j: 0..<LINES_ALL { if u[j * STATION_PACKED + 4] >= 0 && u[j * STATION_PACKED + 5] >= 1 { gone = j; } }
  s[0].eye[0] = u[gone * STATION_PACKED]; s[0].eye[1] = -1400; s[0].eye[2] = u[gone * STATION_PACKED + 1];
  lines_uniforms(s, b[..], U_MOOR);
  #assert b[U_MOOR] == -1408;
  b0 := U_MOOR + LINES_HEAD;
  #assert b[b0] == u[gone * STATION_PACKED] && b[b0 + 1] == u[gone * STATION_PACKED + 1] && abs(f64(b[b0 + 4]) - (500.0 * 2048.0 + LINES_LOST)) < 0.5;
  for k: 1..<LINES_SHOWN { #assert b[b0 + k * LINES_EACH + 4] >= 0 && b[b0 + k * LINES_EACH + 4] < 2048; }
  // out of the water the block says no lines: nothing is worked out for a view that does not draw it
  s[0].under = false;
  lines_uniforms(s, b[..], U_MOOR);
  for j: 0..<LINES_SHOWN { #assert b[U_MOOR + LINES_HEAD + j * LINES_EACH + 4] < 0; }
  // new lines put it back
  sb_act(s, "lines.refit");
  lines_test_step(s, 0, true);
  again := sim_station(s[0].hull);
  #assert again.lost == 0 && abs(again.offset - before.offset) < 2 && abs(again.peak - before.peak) < 0.5e6;
}
#test "lines: a shallow site lies on chains and a deep one hangs on taut lines, said and drawn" #steps 4000000000 {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..]; card: [1] Card;
  sb_test_open(x);
  s[0].site = SITE_TEXAS; s[0].sea = sim_site(SITE_TEXAS).sea; s[0].wind_forced = -1;
  slab_build(s, true);
  lines_test_step(s, 0, true);
  st := sim_station(s[0].hull);
  #assert st.kind == MOOR_CATENARY && st.depth == 89 && st.lines == 16 && st.grounded > 100 && st.length > 1000 && st.length < 1200;
  slab_card(s, 0, card[..]);
  #assert card_says(card[..], "16 CHAINS OF 1,0") && card_says(card[..], "LIE ALONG THE SEABED 89 M DOWN");
  sb_say(s);
  #assert sb_test_has(s, 'F', "Chain still on the seabed", "") && !sb_test_has(s, 'F', "Hardest upward pull on an anchor", "");
  u: [LINES_ALL * STATION_PACKED] f32;
  s[0].under = true; slab_pose(s);
  lines_packed(s[0].hull, u[..]);
  #assert sim_rigged(s[0].hull).rig[0].depth == 89;
  for j: 0..<LINES_ALL {
    at := j * STATION_PACKED;
    if j >= 16 { #assert u[at + 4] < 0; continue; }
    // the chain lies on the seabed 89 m down for part of its run, then comes up to the waterline,
    // hanging below the straight run
    #assert u[at + 4] > 0.1 && u[at + 4] < 1 && abs(sim_fairlead_y(s[0].hull)) < 1.5 && u[at + 5] < -1;
    #assert sqrt(u[at] * u[at] + u[at + 1] * u[at + 1]) > 1000;
  }
  // the deep site
  sb_act(s, "site.0");
  slab_build(s, true);
  lines_test_step(s, 0, true);
  deep := sim_station(s[0].hull);
  #assert deep.kind == MOOR_TAUT && deep.depth == 1408 && deep.uplift > 1e6 && deep.length > 2000;
  sb_say(s);
  #assert sb_test_has(s, 'F', "Hardest upward pull on an anchor", "") && !sb_test_has(s, 'F', "Chain still on the seabed", "");
  // a length over a thousand metres has one comma, not two
  ts: [1] SbText; ts[0] = lines_layout(deep); said := sb_s(ts[..]); pair := false; one := false;
  for i: 0..<said.count - 1 { if said[i] == ',' && said[i + 1] == ',' { pair = true; } if said[i] == ',' && said[i + 1] >= '0' && said[i + 1] <= '9' { one = true; } }
  #assert one && !pair;
}
#test "lines: ?lose=2 opens the world with two lines already broken" #steps 4000000000 {
  xs: [1] SbTest; s := xs[0].s[..];
  slab_reset(s);
  slab_message(s, HOST_FACTS, "url=https://openagents.com/realms/slab/?sea=gale&lose=2&t=40\n");
  #assert s[0].lines[0].lose == 2;
  slab_build(s, true);
  lines_test_step(s, 0, true);
  st := sim_station(s[0].hull);
  #assert st.lost == 2 && s[0].lines[0].lose == 0 && st.offset > 100 && st.peak < st.breaking;
}
#test "lines: the address places the view under the sea, and a swimmer stays above the seabed" {
  xs: [1] SbTest; s := xs[0].s[..];
  slab_reset(s);
  slab_message(s, HOST_FACTS, "url=https://openagents.com/realms/slab/?site=texas&view=under&ex=300&ey=-60&ez=400&eyaw=1.5&epitch=0.2\n");
  #assert s[0].under && s[0].site == SITE_TEXAS && s[0].fx == 300 && s[0].fy == -60 && s[0].fz == 400 && abs(s[0].fyaw - 1.5) < 1e-6 && abs(s[0].fpitch - 0.2) < 1e-6;
  // down for a minute: the swimmer stops 2 m over the bed, 89 m down
  s[0].held = KB_SHIFT;
  for i: 0..<600 { fly_step(s, 0.1); }
  #assert abs(s[0].fy + 87) < 0.01;
}
#test "lines: a hurricane is a storm warning: the storm lines are made fast, said, drawn, and can be let go from the HUD" #steps 4000000000 {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..]; card: [1] Card;
  sb_test_open(x);
  s[0].site = SITE_TEXAS; s[0].sea = SEA_HURRICANE; s[0].wind_forced = -1;
  slab_build(s, true);
  lines_test_step(s, 0, true);
  st := sim_station(s[0].hull);
  #assert st.storm && st.legs == MOOR_STORM_LEGS && st.storm_lines == 20 && st.storm_held == 20 && st.held == 28 && st.peak < st.breaking;
  sb_say(s);
  #assert sb_test_has(s, 'F', "Storm lines holding", "20 of 20, in 12 legs") && sb_test_has(s, 'B', "lines.storm", "Let the storm lines go");
  slab_card(s, 0, card[..]);
  #assert card_says(card[..], "STORM LINES FAST: 20 IN 12 LEGS");
  // the HUD's card for the hull says it too, and behind its fold what is not modelled
  s[0].selected = cd_test_pick(s, SLAB_KIND_HULL, 0); sb_say(s);
  #assert sb_test_has(s, 'K', "card", "The hull") && sb_test_has(s, 'F', "Storm lines holding", "20 of 20") && sb_test_has(s, 'F', "Turned by", "");
  #assert sb_test_has(s, 'S', LINES_HONEST, "");
  s[0].selected = -1; sb_say(s);
  // under the sea the twelve legs are drawn too, each from its own anchor square to a side
  u: [LINES_ALL * STATION_PACKED] f32;
  s[0].under = true; slab_pose(s);
  lines_packed(s[0].hull, u[..]);
  for j: 0..<LINES_ALL { #assert u[j * STATION_PACKED + 4] >= 0; }
  // a line of a storm leg lost by hand: its partner carries the leg, the HUD says so, and the leg
  // is drawn as one line
  sb_act(s, "lines.lose");
  ss := sim_station(s[0].hull);
  sb_say(s);
  #assert (ss.storm_held == 19 || ss.lost == 1) && sb_test_has(s, 'B', "lines.refit", "Fit new lines");
  if ss.storm_held == 19 {
    leg := -1; for j: 16..<LINES_ALL { if lines_half(s[0].hull, j) { leg = j; } }
    #assert leg >= 16;
    lines_packed(s[0].hull, u[..]);
    b: [UNIFORM_FLOATS] f32;
    s[0].eye[0] = u[leg * STATION_PACKED]; s[0].eye[1] = -60; s[0].eye[2] = u[leg * STATION_PACKED + 1];
    lines_uniforms(s, b[..], U_MOOR);
    code := f64(b[U_MOOR + LINES_HEAD + 4]); r := code - floor(code / 2048.0) * 2048.0;
    #assert b[U_MOOR + LINES_HEAD] == u[leg * STATION_PACKED] && r >= LINES_HALF && r < LINES_LOST;
  }
  sb_act(s, "lines.refit"); lines_test_step(s, 0, true);
  #assert sim_station(s[0].hull).storm_held == 20 && sim_station(s[0].hull).lost == 0;
  // let them go: the sixteen alone, and the HUD offers to make them fast again
  sb_act(s, "lines.storm");
  lone := sim_station(s[0].hull);
  #assert !lone.storm && lone.legs == 0 && lone.peak > st.peak + 5e6;
  sb_say(s);
  #assert sb_test_has(s, 'B', "lines.storm", "Make the storm lines fast") && !sb_test_has(s, 'F', "Storm lines holding", "");
  sb_act(s, "lines.storm");
  #assert sim_station(s[0].hull).storm;
  // a gale off Guam is not a storm warning
  sb_act(s, "site.0"); s[0].sea = SEA_GALE; slab_build(s, true); lines_test_step(s, 0, true);
  #assert s[0].site == SITE_GUAM && !sim_station(s[0].hull).storm;
}
#test "lines: the panel's hull moves as that hull: a pilot caisson and a 2 km hull each get their own lines and ride the sea" #steps 8000000000 {
  xs: [1] SbTest; x := xs[..]; s := x[0].s[..];
  sb_test_open(x);
  slab_build(s, true); lines_test_step(s, 0, true);
  #assert !s[0].hull.sized && sim_shape(s[0].hull).l == SIM_L;
  // the Gulf Coast pilot: one 100 by 50 m caisson drawing 5 m, off Texas, on chains at its corners
  #assert panel_act(s, "take.from.1", 0);
  slab_build(s, true); lines_test_step(s, 0, true);
  sh := sim_shape(s[0].hull);
  #assert s[0].hull.sized && sh.l == 100 && sh.b == 50 && abs(sh.t - 5) < 0.5 && s[0].hull.rig[0].built && s[0].hull.rig[0].kind == MOOR_CATENARY;
  for i: 0..<s[0].hull.rig[0].count { #assert abs(s[0].hull.rig[0].fx[i]) <= 50.01 && abs(s[0].hull.rig[0].fz[i]) <= 25.01; }
  for i: 0..<40 { lines_test_step(s, 0.1, false); }
  st := sim_station(s[0].hull);
  #assert st.held == 16 && st.offset < 100 && abs(s[0].hull.heave) < 3 && abs(s[0].hull.roll) < 0.2 && st.wind < 5e6;
  // a hull of 2,000 by 1,000 m takes about four times the wind of the picture's
  w := s[0].change[..];
  wi: [1] WhatIf; wi[0] = w[0].what;
  what_set(wi[..], change_chart(w), WC_LENGTH, 2000); what_set(wi[..], change_chart(w), WC_WIDTH, 1000); w[0].what = wi[0]; change_refresh(w);
  slab_build(s, true); lines_test_step(s, 0, true);
  big := sim_shape(s[0].hull);
  #assert big.l == 2000 && big.b == 1000 && s[0].hull.rig[0].built && abs(s[0].hull.rig[0].fx[0]) > 900;
  for i: 0..<8 { lines_test_step(s, 0.1, false); }
  #assert sim_station(s[0].hull).held == 16 && abs(s[0].hull.heave) < 3 && abs(s[0].hull.roll) < 0.05;
  // back to the picture: prime's own hull and lines again
  #assert panel_act(s, "take.reset", 0);
  slab_build(s, true); lines_test_step(s, 0, true);
  #assert !s[0].hull.sized && s[0].hull.rig[0].built && abs(s[0].hull.rig[0].fx[0]) > 400 && abs(s[0].hull.rig[0].fx[0]) <= SIM_L / 2;
}
