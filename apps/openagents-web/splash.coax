// The openagents.com splash, drawn by Coax. The page is one WebGPU canvas:
// a slow nebula behind (splash.wgsl) and the words COMING SOON drawn as
// glowing strokes that write themselves on, letter by letter, then shimmer,
// over the iOS home's graph fading in as a wide band (graph.coax).
// The host (coax/web/host.js) owns the GPU and calls this once a frame; this
// file decides every number it draws: where each stroke goes, how much of it
// is written, how bright it is, and the nebula's clock.
//
// State lives in the host's memory (a SplashState it allocates and keeps),
// so the dev server can swap this code in while the page runs and the
// animation carries on from where it was.

#load "graph.coax";

SplashState :: struct {
  time: f32;       // seconds since the page started, as this code counts them
  frames: int;
}

TEXT_COUNT :: 11;    // "COMING SOON"
MAX_POINTS :: 12;    // the longest glyph (S) has 12 points
MAX_SEGMENTS :: 96;  // all of COMING SOON's strokes, with room
VERTEX_FLOATS :: 8;  // x, y, along, across, length, core, light, glow
MAX_VERTICES :: 14016; // (MAX_SEGMENTS + GRAPH_QUADS) * 6
UNIFORM_FLOATS :: 8; // width, height, time, fade, still, 0, 0, 0

CAP :: 11.0;         // cap height, CSS pixels
GAP :: 0.72;         // letter gap, in cap heights (the old page's 0.6em spacing)
SPACE :: 1.5;        // a space, in cap heights
CORE :: 0.62;        // half the stroke, CSS pixels (a 1.2 px line, like weight 500 at 13 px)
GLOW :: 7.0;         // the glow's reach, CSS pixels
START :: 0.35;       // seconds before the first stroke starts
STEP :: 0.032;       // seconds between strokes starting
DRAW :: 0.22;        // seconds one stroke takes to write
FADE :: 1.6;         // seconds the canvas takes to fade in, as the old page

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// The letter at position i of COMING SOON (0 is a space).
letter :: (i: int) -> u8 {
  t := [11] u8.['C', 'O', 'M', 'I', 'N', 'G', 0, 'S', 'O', 'O', 'N'];
  if i < 0 || i >= TEXT_COUNT { return 0; }
  return t[i];
}

// A glyph is one stroke through points on a 4 wide, 6 high grid, y up.
// Writes x, y pairs into out and returns how many points.
glyph :: (c: u8, out: [] u8) -> int {
  if out.count < MAX_POINTS * 2 { return 0; }
  n := 0;
  if c == 'C' { p := [16] u8.[4,5, 3,6, 1,6, 0,5, 0,1, 1,0, 3,0, 4,1]; for k: 0..<16 { out[k] = p[k]; } n = 8; }
  if c == 'O' { p := [18] u8.[1,0, 3,0, 4,1, 4,5, 3,6, 1,6, 0,5, 0,1, 1,0]; for k: 0..<18 { out[k] = p[k]; } n = 9; }
  if c == 'M' { p := [10] u8.[0,0, 0,6, 2,3, 4,6, 4,0]; for k: 0..<10 { out[k] = p[k]; } n = 5; }
  if c == 'I' { p := [4] u8.[0,0, 0,6]; for k: 0..<4 { out[k] = p[k]; } n = 2; }
  if c == 'N' { p := [8] u8.[0,0, 0,6, 4,0, 4,6]; for k: 0..<8 { out[k] = p[k]; } n = 4; }
  if c == 'G' { p := [20] u8.[4,5, 3,6, 1,6, 0,5, 0,1, 1,0, 3,0, 4,1, 4,3, 2,3]; for k: 0..<20 { out[k] = p[k]; } n = 10; }
  if c == 'S' { p := [24] u8.[4,5, 3,6, 1,6, 0,5, 0,4, 1,3, 3,3, 4,2, 4,1, 3,0, 1,0, 0,1]; for k: 0..<24 { out[k] = p[k]; } n = 12; }
  return n;
}

// How wide a glyph is, in grid units (I is a single line).
glyph_width :: (c: u8) -> f32 {
  if c == 'I' { return 0; }
  return 4;
}

// The text's width in cap heights, so it can be centred.
text_width :: () -> f32 {
  w := 0.0f32;
  for i: 0..<TEXT_COUNT {
    c := letter(i);
    if c == 0 { w += SPACE; } else { w += glyph_width(c) / 6; }
    if i + 1 < TEXT_COUNT && c != 0 && letter(i + 1) != 0 { w += GAP; }
  }
  return w;
}

// How much of stroke k is written at time t: 0 to 1.
written :: (k: int, t: f32, still: bool) -> f32 {
  if still { return 1; }
  return ease((t - START - STEP * cast(f32) k) / DRAW);
}

// One stroke as a quad (two triangles) wide enough for its glow. Each
// vertex carries its place along and across the stroke, so the shader can
// draw a sharp core and a soft glow from the distance to the centre line.
quad :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;      // along
  nx := -uy; ny := ux;                       // across
  r := glow + core;
  // corners: (along, across) in pixels from the stroke's start
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v];
    out[o + 3] = c[v];
    out[o + 4] = length;
    out[o + 5] = core;
    out[o + 6] = light;
    out[o + 7] = glow;
  }
  return true;
}

// Lays out COMING SOON for a canvas of width x height device pixels and
// writes its strokes as vertices. Returns the vertex count.
strokes :: (out: [] f32, width: f32, height: f32, dpr: f32, t: f32, still: bool) -> int {
  unit := CAP * dpr / 6;                       // device pixels per grid unit
  cap := CAP * dpr;
  x := (width - text_width() * cap) * 0.5;
  base := height * 0.5 + cap * 0.5;            // y down on screen
  points: [24] u8;
  segment := 0;
  vertices := 0;
  for i: 0..<TEXT_COUNT {
    c := letter(i);
    if c == 0 { x += SPACE * cap; continue; }
    n := glyph(c, points[..]);
    for p: 1..<n {
      if segment >= MAX_SEGMENTS { return vertices; }
      f := written(segment, t, still);
      ax := x + cast(f32) points[(p - 1) * 2] * unit;
      ay := base - cast(f32) points[(p - 1) * 2 + 1] * unit;
      bx := x + cast(f32) points[p * 2] * unit;
      by := base - cast(f32) points[p * 2 + 1] * unit;
      if f > 0 {
        // after it's written, a slow shimmer runs across the words
        shimmer := ifx still then 0.0f32 else 0.12 * sin(t * 1.1 - ax / (40 * dpr));
        light := 0.93 * (0.88 + shimmer) * hi(f, 0.35);
        if quad(out, vertices, ax, ay, ax + (bx - ax) * f, ay + (by - ay) * f, CORE * dpr, light, GLOW * dpr) { vertices += 6; }
      }
      segment += 1;
    }
    x += glyph_width(c) * unit;
    if i + 1 < TEXT_COUNT && letter(i + 1) != 0 { x += GAP * cap; }
  }
  return vertices;
}

// The host calls this once a frame. dt is seconds since the last frame
// (the host clamps a stalled tab). still: the visitor prefers reduced motion.
coaxial_splash_frame :: (s: [] SplashState, out: [] f32, uniforms: [] f32,
                         width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  s[0].time += clamp(dt, 0, 0.1);
  s[0].frames += 1;
  t := s[0].time;
  uniforms[0] = width;
  uniforms[1] = height;
  uniforms[2] = ifx still then 20.0f32 else 20 + t;   // the nebula's clock, as the old page
  uniforms[3] = ifx still then 1.0f32 else ease(t / FADE);
  uniforms[4] = ifx still then 1.0f32 else 0.0f32;
  uniforms[5] = 0; uniforms[6] = 0; uniforms[7] = 0;
  d := hi(dpr, 1);
  words := strokes(out, width, height, d, t, still);
  hole := Hole.{cx = width * 0.5, cy = height * 0.5, w = text_width() * CAP * d * 0.5, h = CAP * d * 0.5};
  return words + graph_draw(out, words, width, height, d, ifx still then 20.0f32 else t, still, hole);
}

coaxial_splash_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_splash_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_splash_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

#test "the words are centred and fit a narrow phone" {
  out: [4608] f32;
  n := strokes(out[..], 320 * 3, 640 * 3, 3, 0, true);
  #assert n > 0 && n % 6 == 0;
  lowest := 1.0e9f32; highest := -1.0e9f32;
  for v: 0..<n {
    x := out[v * VERTEX_FLOATS];
    lowest = lo(lowest, x); highest = hi(highest, x);
  }
  #assert lowest > 0 && highest < 960;
  #assert abs((lowest + highest) * 0.5 - 480) < 4;
}

#test "nothing is written before the start, everything after" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [8] f32; s: [1] SplashState;
  #assert coaxial_splash_frame(s[..], out[..], u[..], 1280, 800, 1, 0, false) == 0;
  #assert strokes(out[..], 1280, 800, 1, 10, false) == strokes(out[..], 1280, 800, 1, 0, true);
  s[0].time = 10;
  all := coaxial_splash_frame(s[..], out[..], u[..], 1280, 800, 1, 0, false);
  #assert u[3] == 1 && all > strokes(out[..], 1280, 800, 1, 10, false) && all <= MAX_VERTICES;
}

#test "strokes start in order" {
  #assert written(0, START + DRAW, false) == 1;
  #assert written(1, START + DRAW, false) < 1;
  #assert written(40, 0, true) == 1;
}

#test "a small output or a missing state draws nothing" {
  out: [10] f32; u: [8] f32; s: [1] SplashState;
  s[0].time = 10;
  #assert coaxial_splash_frame(s[..], out[..], u[..], 800, 600, 1, 0, false) == 0;
  #assert coaxial_splash_frame(s[0..<0], out[..], u[..], 800, 600, 1, 0, false) == 0;
}

#test "a stalled tab doesn't jump the clock" {
  out: [4608] f32; u: [8] f32; s: [1] SplashState;
  _ := coaxial_splash_frame(s[..], out[..], u[..], 800, 600, 1, 5, false);
  #assert s[0].time <= 0.1;
}
