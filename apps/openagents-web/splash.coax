// The openagents.com splash, drawn by Coax. The page is one WebGPU canvas:
// a slow nebula behind (splash.wgsl), the iOS home's graph fading in as a
// wide band across the middle (graph.coax), and two lines drawn as glowing
// strokes that write themselves on, letter by letter, then shimmer:
// OPENAGENTS in the top third after a pause, COMING SOON in the bottom third
// a little later.
// The host (coax/web/host.js) owns the GPU and calls this once a frame; this
// file decides every number it draws: where each stroke goes, how much of it
// is written, how bright it is, and the nebula's clock.
//
// State lives in the host's memory (a SplashState it allocates and keeps),
// so the dev server can swap this code in while the page runs and the
// animation carries on from where it was.

#load "graph.coax";

SplashState :: struct {
  time: f32;       // seconds since the page started, as this code counts them
  frames: int;
}

LINES :: 2;          // OPENAGENTS, COMING SOON
LINE_MAX :: 11;      // letters in the longest line
MAX_POINTS :: 12;    // the longest glyph (S) has 12 points
MAX_SEGMENTS :: 160; // both lines' strokes, with room
VERTEX_FLOATS :: 8;  // x, y, along, across, length, core, light, glow
MAX_VERTICES :: 14400; // (MAX_SEGMENTS + GRAPH_QUADS) * 6
UNIFORM_FLOATS :: 8; // width, height, time, fade, still, 0, 0, 0

CAP :: 11.0;         // COMING SOON's cap height, CSS pixels
TITLE_CAP :: 20.0;   // OPENAGENTS's cap height, CSS pixels
GAP :: 0.72;         // letter gap, in cap heights (the old page's 0.6em spacing)
SPACE :: 1.5;        // a space, in cap heights
CORE :: 0.62;        // half the stroke, CSS pixels (a 1.2 px line, like weight 500 at 13 px)
GLOW :: 7.0;         // the glow's reach, CSS pixels
TITLE_START :: 2.0;  // seconds before OPENAGENTS starts to appear
START :: 4.5;        // seconds before COMING SOON starts to appear
APPEAR :: 1.2;       // seconds a line takes to fade up as it writes
STEP :: 0.032;       // seconds between strokes starting
DRAW :: 0.22;        // seconds one stroke takes to write
FADE :: 1.6;         // seconds the canvas takes to fade in, as the old page

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// How many letters line l has (0 is OPENAGENTS, 1 is COMING SOON).
line_count :: (l: int) -> int { return ifx l == 0 then 10 else 11; }

// The letter at position i of line l (0 is a space).
letter :: (l: int, i: int) -> u8 {
  if i < 0 || i >= line_count(l) { return 0; }
  if l == 0 { t := [10] u8.['O', 'P', 'E', 'N', 'A', 'G', 'E', 'N', 'T', 'S']; return t[i]; }
  t := [11] u8.['C', 'O', 'M', 'I', 'N', 'G', 0, 'S', 'O', 'O', 'N'];
  return t[i];
}

// Line l's cap height in CSS pixels, when it starts, and where its centre
// sits as a fraction of the page height.
line_cap :: (l: int) -> f32 { return ifx l == 0 then TITLE_CAP else CAP; }

// Line l's cap height on a page width CSS pixels wide: the title shrinks to
// keep a margin on a narrow phone.
fitted_cap :: (l: int, width: f32) -> f32 { return lo(line_cap(l), width * 0.86 / text_width(l)); }
line_start :: (l: int) -> f32 { return ifx l == 0 then TITLE_START else START; }
line_y :: (l: int) -> f32 { return ifx l == 0 then 0.14f32 else 0.86f32; }

// A glyph is one stroke through points on a 4 wide, 6 high grid, y up.
// Writes x, y pairs into out and returns how many points.
glyph :: (c: u8, out: [] u8) -> int {
  if out.count < MAX_POINTS * 2 { return 0; }
  n := 0;
  if c == 'C' { p := [16] u8.[4,5, 3,6, 1,6, 0,5, 0,1, 1,0, 3,0, 4,1]; for k: 0..<16 { out[k] = p[k]; } n = 8; }
  if c == 'O' { p := [18] u8.[1,0, 3,0, 4,1, 4,5, 3,6, 1,6, 0,5, 0,1, 1,0]; for k: 0..<18 { out[k] = p[k]; } n = 9; }
  if c == 'M' { p := [10] u8.[0,0, 0,6, 2,3, 4,6, 4,0]; for k: 0..<10 { out[k] = p[k]; } n = 5; }
  if c == 'I' { p := [4] u8.[0,0, 0,6]; for k: 0..<4 { out[k] = p[k]; } n = 2; }
  if c == 'N' { p := [8] u8.[0,0, 0,6, 4,0, 4,6]; for k: 0..<8 { out[k] = p[k]; } n = 4; }
  if c == 'G' { p := [20] u8.[4,5, 3,6, 1,6, 0,5, 0,1, 1,0, 3,0, 4,1, 4,3, 2,3]; for k: 0..<20 { out[k] = p[k]; } n = 10; }
  if c == 'P' { p := [14] u8.[0,0, 0,6, 3,6, 4,5, 4,4, 3,3, 0,3]; for k: 0..<14 { out[k] = p[k]; } n = 7; }
  if c == 'E' { p := [14] u8.[4,6, 0,6, 0,3, 3,3, 0,3, 0,0, 4,0]; for k: 0..<14 { out[k] = p[k]; } n = 7; }
  if c == 'A' { p := [16] u8.[0,0, 0,5, 1,6, 3,6, 4,5, 4,0, 4,3, 0,3]; for k: 0..<16 { out[k] = p[k]; } n = 8; }
  if c == 'T' { p := [8] u8.[0,6, 4,6, 2,6, 2,0]; for k: 0..<8 { out[k] = p[k]; } n = 4; }
  if c == 'S' { p := [24] u8.[4,5, 3,6, 1,6, 0,5, 0,4, 1,3, 3,3, 4,2, 4,1, 3,0, 1,0, 0,1]; for k: 0..<24 { out[k] = p[k]; } n = 12; }
  return n;
}

// How wide a glyph is, in grid units (I is a single line).
glyph_width :: (c: u8) -> f32 {
  if c == 'I' { return 0; }
  return 4;
}

// Line l's width in cap heights, so it can be centred.
text_width :: (l: int) -> f32 {
  w := 0.0f32;
  n := line_count(l);
  for i: 0..<n {
    c := letter(l, i);
    if c == 0 { w += SPACE; } else { w += glyph_width(c) / 6; }
    if i + 1 < n && c != 0 && letter(l, i + 1) != 0 { w += GAP; }
  }
  return w;
}

// How much of line l's stroke k is written at time t: 0 to 1.
written :: (l: int, k: int, t: f32, still: bool) -> f32 {
  if still { return 1; }
  return ease((t - line_start(l) - STEP * cast(f32) k) / DRAW);
}

// How bright line l is at time t as it fades up: 0 to 1.
appeared :: (l: int, t: f32, still: bool) -> f32 {
  if still { return 1; }
  return ease((t - line_start(l)) / APPEAR);
}

// One stroke as a quad (two triangles) wide enough for its glow. Each
// vertex carries its place along and across the stroke, so the shader can
// draw a sharp core and a soft glow from the distance to the centre line.
quad :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;      // along
  nx := -uy; ny := ux;                       // across
  r := glow + core;
  // corners: (along, across) in pixels from the stroke's start
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v];
    out[o + 3] = c[v];
    out[o + 4] = length;
    out[o + 5] = core;
    out[o + 6] = light;
    out[o + 7] = glow;
  }
  return true;
}

// Lays out both lines for a canvas of width x height device pixels and
// writes their strokes as vertices. Returns the vertex count.
strokes :: (out: [] f32, width: f32, height: f32, dpr: f32, t: f32, still: bool) -> int {
  vertices := 0;
  for l: 0..<LINES { vertices = line_strokes(out, vertices, l, width, height, dpr, t, still); }
  return vertices;
}

// One line's strokes, written from vertex at. Returns the new vertex count.
line_strokes :: (out: [] f32, at: int, l: int, width: f32, height: f32, dpr: f32, t: f32, still: bool) -> int {
  size := fitted_cap(l, width / dpr);
  unit := size * dpr / 6;                      // device pixels per grid unit
  cap := size * dpr;
  x := (width - text_width(l) * cap) * 0.5;
  base := height * line_y(l) + cap * 0.5;      // y down on screen
  shown := appeared(l, t, still);
  points: [24] u8;
  segment := 0;
  vertices := at;
  count := line_count(l);
  for i: 0..<count {
    c := letter(l, i);
    if c == 0 { x += SPACE * cap; continue; }
    n := glyph(c, points[..]);
    for p: 1..<n {
      if segment >= MAX_SEGMENTS / LINES { return vertices; }
      f := written(l, segment, t, still);
      ax := x + cast(f32) points[(p - 1) * 2] * unit;
      ay := base - cast(f32) points[(p - 1) * 2 + 1] * unit;
      bx := x + cast(f32) points[p * 2] * unit;
      by := base - cast(f32) points[p * 2 + 1] * unit;
      if f > 0 {
        // after it's written, a slow shimmer runs across the words
        shimmer := ifx still then 0.0f32 else 0.12 * sin(t * 1.1 - ax / (40 * dpr));
        light := 0.93 * (0.88 + shimmer) * hi(f, 0.35) * shown;
        weight := size / CAP;            // the title's stroke scales with it, a little less
        core := CORE * dpr * (1 + (weight - 1) * 0.6);
        if quad(out, vertices, ax, ay, ax + (bx - ax) * f, ay + (by - ay) * f, core, light, GLOW * dpr * weight) { vertices += 6; }
      }
      segment += 1;
    }
    x += glyph_width(c) * unit;
    if i + 1 < count && letter(l, i + 1) != 0 { x += GAP * cap; }
  }
  return vertices;
}

// The host calls this once a frame. dt is seconds since the last frame
// (the host clamps a stalled tab). still: the visitor prefers reduced motion.
coaxial_splash_frame :: (s: [] SplashState, out: [] f32, uniforms: [] f32,
                         width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  s[0].time += clamp(dt, 0, 0.1);
  s[0].frames += 1;
  t := s[0].time;
  uniforms[0] = width;
  uniforms[1] = height;
  uniforms[2] = ifx still then 20.0f32 else 20 + t;   // the nebula's clock, as the old page
  uniforms[3] = ifx still then 1.0f32 else ease(t / FADE);
  uniforms[4] = ifx still then 1.0f32 else 0.0f32;
  uniforms[5] = 0; uniforms[6] = 0; uniforms[7] = 0;
  d := hi(dpr, 1);
  words := strokes(out, width, height, d, t, still);
  // The graph dims under both lines so the words read over it.
  title := Hole.{cx = width * 0.5, cy = height * line_y(0), w = text_width(0) * fitted_cap(0, width / d) * d * 0.5, h = fitted_cap(0, width / d) * d * 0.5};
  soon := Hole.{cx = width * 0.5, cy = height * line_y(1), w = text_width(1) * CAP * d * 0.5, h = CAP * d * 0.5};
  return words + graph_draw(out, words, width, height, d, ifx still then 20.0f32 else t, still, title, soon);
}

coaxial_splash_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_splash_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_splash_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

#test "the words are centred and fit a narrow phone" {
  out: [4608] f32;
  n := strokes(out[..], 320 * 3, 640 * 3, 3, 0, true);
  #assert n > 0 && n % 6 == 0;
  lowest := 1.0e9f32; highest := -1.0e9f32;
  for v: 0..<n {
    x := out[v * VERTEX_FLOATS];
    lowest = lo(lowest, x); highest = hi(highest, x);
  }
  #assert lowest > 0 && highest < 960;
  #assert abs((lowest + highest) * 0.5 - 480) < 4;
}

#test "nothing is written before the start, everything after" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [8] f32; s: [1] SplashState;
  #assert coaxial_splash_frame(s[..], out[..], u[..], 1280, 800, 1, 0, false) == 0;
  #assert strokes(out[..], 1280, 800, 1, 10, false) == strokes(out[..], 1280, 800, 1, 0, true);
  s[0].time = 10;
  all := coaxial_splash_frame(s[..], out[..], u[..], 1280, 800, 1, 0, false);
  #assert u[3] == 1 && all > strokes(out[..], 1280, 800, 1, 10, false) && all <= MAX_VERTICES;
}

#test "strokes start in order, the title first, after a pause" {
  #assert written(1, 0, START + DRAW, false) == 1;
  #assert written(1, 1, START + DRAW, false) < 1;
  #assert written(1, 40, 0, true) == 1;
  #assert written(0, 0, 1.0, false) == 0 && appeared(0, 1.0, false) == 0;
  #assert written(0, 0, TITLE_START + DRAW, false) == 1 && written(1, 0, TITLE_START + DRAW, false) == 0;
  #assert appeared(1, 30, false) == 1;
}

#test "the title keeps a margin on a small phone" {
  #assert fitted_cap(0, 1280) == TITLE_CAP;
  #assert text_width(0) * fitted_cap(0, 280) <= 280 * 0.87;
}

#test "the title sits in the top third, COMING SOON in the bottom third" {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  title := line_strokes(out[..], 0, 0, 1280, 900, 1, 0, true);
  #assert title > 0;
  for v: 0..<title { #assert out[v * VERTEX_FLOATS + 1] < 200; }
  all := line_strokes(out[..], title, 1, 1280, 900, 1, 0, true);
  #assert all > title;
  for v: title..<all { #assert out[v * VERTEX_FLOATS + 1] > 700; }
}

#test "a small output or a missing state draws nothing" {
  out: [10] f32; u: [8] f32; s: [1] SplashState;
  s[0].time = 10;
  #assert coaxial_splash_frame(s[..], out[..], u[..], 800, 600, 1, 0, false) == 0;
  #assert coaxial_splash_frame(s[0..<0], out[..], u[..], 800, 600, 1, 0, false) == 0;
}

#test "a stalled tab doesn't jump the clock" {
  out: [4608] f32; u: [8] f32; s: [1] SplashState;
  _ := coaxial_splash_frame(s[..], out[..], u[..], 800, 600, 1, 5, false);
  #assert s[0].time <= 0.1;
}
