// Splice, openagents.com/worlds/splice (unlisted): robots and machines on Mars and stranger worlds,
// drawn in the anime style (docs/verse/art-styles.md, Anime: cel bands, coloured ink, a vivid sky).
//
// Everything that draws is Aethyr's: the cel mesh writers (aethyr/render/cel-mesh.coax), the
// machine and land kits (aethyr/kit/machines.coax, aethyr/kit/land.coax), Anime Lab's uniform
// layout and camera rows (animelab.coax), its style block (animelab-style.coax) and its shader
// (gpu/splice.coax loads gpu/animelab.coax). This page only stages scenes: each picks pieces from
// the kits, their colours, a camera, a key light and an anime variant and clock (its look).
//   coax/bin/coax test apps/openagents-web/splice.coax
#load "animelab.coax";
#load "../../aethyr/kit/land.coax";
#load "splice-game.coax";

SP_WORLD_WORDS :: 150000;

// The state the page keeps: the world is written once a scene, the clock runs while the page is open.
Splice :: struct {
  started: bool;
  world_built: bool;
  world_n: int;
  live_n: int;
  time: f32;
  over: bool;
  draws: [8] u32;
  scene: int;                 // ?scene=N in the page's URL: which scene (SP_SCENES)
  built_scene: int = -1;
  world_gen: int;             // counts the world's writes: the page copies the store when it changes
  gallery: bool;              // ?scene=N: the still scenes; without it the page is the game
  game: [1] SpGame;           // the vertical slice (splice-game.coax)
}

// A scene's look: its anime variant (verse/style-preset.coax ANIME_*), the clock it is seen at, and
// where its key light comes from.
SpLook :: struct { variant: int; clock: f32; key: Point; }
SP_PASTORAL :: 0; SP_ACTION :: 1; SP_DUSK :: 2; SP_NEON :: 3;

sc :: (r: f32, g: f32, b: f32) -> KitTint { return kit_tint(r, g, b); }
sink :: () -> KitTint { return sc(0.23, 0.16, 0.21); }
scream :: () -> KitTint { return sc(0.95, 0.90, 0.78); }
steal :: () -> KitTint { return sc(0.25, 0.84, 0.76); }
sred :: () -> KitTint { return sc(0.83, 0.27, 0.23); }

// The scenes' robot, in its home colours (cream plates, a red band, a teal eye).
sp_robot :: (buf: [] u32, p: [] Pen, f: Frame, s: f32) {
  kit_robot(buf, p, f, s, 20, scream(), sred(), steal(), sink(), 0.62);
}

// 0, Dunes: a coral basin, ochre dunes, lavender mesas, and the robot waving.
sp_dunes :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.86, 0.50, 0.37), true);
  kit_dunes(buf, p, 2, sc(0.89, 0.66, 0.35), 18, 0, 46, -70, -22, 4, 11);
  kit_mesas(buf, p, 3, sc(0.64, 0.55, 0.80), 9, 0, -70, 22, 14, 36);
  kit_rocks(buf, p, 4, sc(0.60, 0.30, 0.24), 22, 0, 0, 0, 3.5, 17.5, 0.25, 0.95);
  sp_robot(buf, p, frame_at(v3(0, 0, 0), -0.35), 1);
}
// 1, Arch (pin 3): a red post-and-lintel arch over the sand, the robot in its shadow.
sp_arch :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.93, 0.72, 0.42), true);
  kit_arch_block(buf, p, frame_at(v3(0, 0, -4), 0), 2, sc(0.84, 0.44, 0.30), sc(0.78, 0.36, 0.26), 4.6, 7.6, 4.6);
  kit_rocks(buf, p, 4, sc(0.80, 0.42, 0.28), 6, 300, 0, -20, 14, 22, 1.4, 3);
  kit_mesas(buf, p, 5, sc(0.64, 0.55, 0.80), 7, 330, -75, 16, 16, 30);
  sp_robot(buf, p, frame_at(v3(0, 0, 0.5), 0.15), 1);
}
// 2, Scissors (pin 14): two red crab-bots squaring off on a coral plain, the robot watching.
sp_crabs :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.86, 0.56, 0.40), true);
  kit_rocks(buf, p, 4, sc(0.66, 0.34, 0.26), 14, 400, 0, 0, 7, 24, 0.4, 1.5);
  kit_mesas(buf, p, 5, sc(0.70, 0.50, 0.66), 8, 410, -80, 20, 12, 26);
  kit_crab(buf, p, frame_at(v3(-2.6, 0, 0.2), 0.9), 0.8, 30, sc(0.80, 0.20, 0.18), sc(0.84, 0.26, 0.22), sink());
  kit_crab(buf, p, frame_at(v3(2.4, 0, -0.8), -0.9), 0.8, 34, sc(0.80, 0.20, 0.18), sc(0.84, 0.26, 0.22), sink());
  sp_robot(buf, p, frame_at(v3(0.2, 0, -5.5), 0.1), 0.85);
}
// 3, Walker (pin 13): the white walker with orange bands striding over pale ground.
sp_walker :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.93, 0.82, 0.62), true);
  kit_walker(buf, p, frame_at(v3(0, 0, 0), 0), 1, 2, sc(0.97, 0.96, 0.92), sc(0.95, 0.45, 0.15), sink());
  kit_rocks(buf, p, 6, sc(0.78, 0.62, 0.46), 12, 450, 0, 0, 6, 20, 0.3, 0.9);
}
// 4, Terraces (pin 8): a lavender terraced city, a domed top, a sage tower, the robot below.
sp_terraces :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.66, 0.56, 0.82), true);
  kit_terraces(buf, p, frame_at(v3(0, 0, 0), 0), 2, sc(0.62, 0.52, 0.80), sc(0.86, 0.74, 0.68), sc(0.24, 0.20, 0.36), 5, 16, 12, 2.2);
  kit_pen(p, 6, MAT_SKIN, sc(0.90, 0.86, 0.80));
  ellipsoid(buf, p, frame_at(v3(0, 11.0, 0), 0), 1.9, 1.3, 1.9, 14, 7, 0);
  kit_pen(p, 7, MAT_WORLD, sc(0.55, 0.66, 0.50));
  tube(buf, p, frame_at(v3(9.5, 0, -4), 0), 15, 1.3, 1.0, 0.8, 0.6, 8, true);
  sp_robot(buf, p, frame_at(v3(-6.5, 0, 10), 0.5), 1);
}
// 5, Pack walker (pin 3): a long-legged pack beast under a natural red arch, teal noon sky.
sp_pack :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.90, 0.62, 0.42), false);
  kit_arch_round(buf, p, frame_at(v3(2, 0, -14), 0), 2, sc(0.80, 0.30, 0.22), 30, 22, 4.5, 6, 18);
  kit_mesas(buf, p, 3, sc(0.85, 0.45, 0.32), 6, 500, -90, 26, 18, 34);
  kit_rocks(buf, p, 4, sc(0.72, 0.34, 0.26), 18, 510, 0, -4, 6, 26, 0.5, 2.2);
  kit_beast(buf, p, frame_at(v3(-1, 0, -2), 1.1), 1, 10, sc(0.92, 0.86, 0.74), sink(), sc(0.62, 0.48, 0.36), true);
  sp_robot(buf, p, frame_at(v3(4.5, 0, 3), -0.5), 0.6);
}
// 6, Yellow canyon (pins 1, 10): a deep ochre canyon, the robot small on its floor, a moon above.
sp_canyon :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.95, 0.78, 0.40), false);
  kit_canyon(buf, p, 2, sc(0.96, 0.74, 0.30), sc(0.90, 0.62, 0.26), 600, 12, -90, 10, 26);
  kit_rocks(buf, p, 4, sc(0.82, 0.55, 0.25), 16, 610, 0, -10, 2, 18, 0.4, 1.4);
  kit_moon(buf, p, 5, sc(0.98, 0.95, 0.85), v3(-6, 52, -120), 7);
  sp_robot(buf, p, frame_at(v3(0.5, 0, 0), 0.2), 1);
}
// 7, Palace (pin 6): sage-green domed houses and palms by a sea, the robot on the shore.
sp_palace :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.90, 0.80, 0.60), false);
  kit_sea(buf, p, 2, sc(0.30, 0.62, 0.66), sc(0.94, 0.96, 0.92), 0.05, -16, 700);
  wall := sc(0.86, 0.84, 0.72); dome := sc(0.55, 0.72, 0.58);
  kit_dome_house(buf, p, frame_at(v3(-11, 0, -10), 0.2), 3, wall, dome, 6, 5);
  kit_dome_house(buf, p, frame_at(v3(-1, 0, -16), 0), 3, wall, dome, 9, 7);
  kit_dome_house(buf, p, frame_at(v3(9, 0, -11), -0.3), 3, wall, dome, 5, 4);
  kit_towers(buf, p, 5, wall, dome, 710, 2, 2, -26, 8, 12, 16);
  for i: 0..<6 {
    k := cast(f32) i;
    kit_palm(buf, p, frame_at(v3(-14 + k * 5.6, 0, -1.5 - kit_rand(k + 720) * 4), kit_rand(k + 730) * 6), 0.9 + kit_rand(k + 740) * 0.4, 7, sc(0.62, 0.46, 0.32), sc(0.36, 0.58, 0.34));
  }
  sp_robot(buf, p, frame_at(v3(1.5, 0, 5), -0.3), 0.8);
}
// 8, Spider (pin 26): an orange spider bot crossing dark cinder ground at dusk, the robot facing it.
sp_spider :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.42, 0.26, 0.28), false);
  kit_rocks(buf, p, 4, sc(0.30, 0.20, 0.24), 26, 800, 0, 0, 5, 26, 0.3, 1.6);
  kit_mesas(buf, p, 3, sc(0.52, 0.30, 0.40), 8, 810, -80, 20, 14, 30);
  kit_spider(buf, p, frame_at(v3(-1.5, 0, -1), 0.5), 1.2, 10, sc(0.96, 0.52, 0.18), sc(0.99, 0.80, 0.30), sink());
  sp_robot(buf, p, frame_at(v3(4.2, 0, 2.5), -1.1), 0.75);
}
// 9, Tank crabs (pin 32): three blue tank crabs rolling across a white salt flat.
sp_tanks :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.95, 0.94, 0.90), false);
  kit_rocks(buf, p, 4, sc(0.78, 0.80, 0.84), 10, 900, 0, 0, 8, 30, 0.2, 0.6);
  kit_mesas(buf, p, 3, sc(0.70, 0.78, 0.90), 7, 910, -100, 26, 8, 16);
  blue := sc(0.28, 0.48, 0.86); tread := sc(0.18, 0.20, 0.30); lens := sc(1.0, 0.62, 0.20);
  kit_tank(buf, p, frame_at(v3(-3.2, 0, 1), 0.4), 1, 10, blue, tread, lens);
  kit_tank(buf, p, frame_at(v3(1.0, 0, -2), 0.1), 1.2, 14, blue, tread, lens);
  kit_tank(buf, p, frame_at(v3(4.6, 0, 0.5), -0.3), 0.9, 18, blue, tread, lens);
}
// 10, Salt caravan (pin 35): sand-coloured walkers in a line across a white flat, the robot leading.
sp_caravan :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.96, 0.95, 0.91), false);
  kit_mesas(buf, p, 3, sc(0.84, 0.80, 0.86), 8, 1000, -110, 30, 10, 20);
  for i: 0..<4 {
    k := cast(f32) i;
    kit_beast(buf, p, frame_at(v3(-12 + k * 8, 0, -6 - k * 3), 1.35), 0.7 + kit_rand(k + 1010) * 0.2, 10 + i * 3, sc(0.88, 0.78, 0.60), sink(), sc(0.80, 0.42, 0.30), i % 2 == 0);
  }
  sp_robot(buf, p, frame_at(v3(9, 0, 2), 1.2), 0.7);
}
// 11, Windmill (pin 37): a lone turbine on dusty ground under a purple dusk, the robot below it.
sp_windmill :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.80, 0.62, 0.52), false);
  kit_dunes(buf, p, 2, sc(0.86, 0.70, 0.56), 14, 1100, 50, -60, -14, 5, 12);
  kit_rocks(buf, p, 4, sc(0.56, 0.40, 0.42), 16, 1110, 0, 0, 4, 20, 0.3, 1.1);
  kit_turbine(buf, p, frame_at(v3(-3, 0, -5), 0.3), 1, 10, sc(0.94, 0.92, 0.86), sc(0.94, 0.92, 0.86), 0.4);
  kit_moon(buf, p, 6, sc(0.98, 0.84, 0.80), v3(30, 40, -140), 9);
  sp_robot(buf, p, frame_at(v3(1.5, 0, 1.5), -0.4), 0.9);
}
// 12, Sky city (pins 11, 12): lavender towers in a canyon, airships and birds over it.
sp_skycity :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.72, 0.62, 0.80), false);
  kit_canyon(buf, p, 2, sc(0.66, 0.56, 0.80), sc(0.80, 0.66, 0.78), 1200, 26, -110, -10, 30);
  kit_towers(buf, p, 4, sc(0.90, 0.82, 0.86), sc(0.58, 0.70, 0.84), 1210, 7, 0, -50, 12, 18, 40);
  kit_airship(buf, p, frame_at(v3(-6, 30, -30), 1.3), 1.8, 10, sc(0.94, 0.86, 0.72), sc(0.98, 0.94, 0.88), sink());
  kit_airship(buf, p, frame_at(v3(12, 40, -60), -1.9), 1.4, 13, sc(0.94, 0.86, 0.72), sc(0.86, 0.44, 0.40), sink());
  for i: 0..<7 {
    k := cast(f32) i;
    kit_bird(buf, p, frame_at(v3(-4 + k * 2.4, 22 + kit_rand(k + 1220) * 6, -12 - kit_rand(k + 1230) * 8), 0.2), 0.8, 16, sink());
  }
  sp_robot(buf, p, frame_at(v3(0, 0, 6), 0.1), 1);
}
// 13, Big mech (pins 15, 30): a round white mech with orange plates and a tracked rover on snow.
sp_mech :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.92, 0.94, 0.97), false);
  kit_dunes(buf, p, 2, sc(0.96, 0.97, 0.99), 16, 1300, 60, -80, -16, 6, 14);
  kit_mesas(buf, p, 3, sc(0.62, 0.70, 0.84), 7, 1310, -110, 28, 18, 34);
  kit_mech(buf, p, frame_at(v3(-2, 0, -1), 0.35), 1, 10, sc(0.96, 0.95, 0.92), sc(0.96, 0.48, 0.16), sc(0.30, 0.30, 0.36), sc(0.30, 0.86, 0.95));
  kit_rover(buf, p, frame_at(v3(4.5, 0, 3), -0.7), 0.9, 15, sc(0.95, 0.94, 0.90), sc(0.96, 0.48, 0.16), sc(0.22, 0.22, 0.28));
}
// 14, Spire (pin 38): a red canyon with one tall tower spire, the robot looking up at it.
sp_spire :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.78, 0.36, 0.26), false);
  kit_canyon(buf, p, 2, sc(0.74, 0.28, 0.22), sc(0.86, 0.40, 0.28), 1400, 18, -100, 0, 34);
  kit_pen(p, 5, MAT_WORLD, sc(0.96, 0.88, 0.76));
  tube(buf, p, frame_at(v3(0, 0, -40), 0), 46, 3.4, 3.4, 1.6, 1.6, 10, true);
  tube(buf, p, frame_at(v3(0, 46, -40), 0), 12, 1.6, 1.6, 0.02, 0.02, 10, true);
  kit_pen(p, 6, MAT_FLAT, sc(0.20, 0.30, 0.52));
  for r: 0..<4 { tube(buf, p, frame_at(v3(0, 10 + cast(f32) r * 9, -40), 0), 1.2, 3.6 - cast(f32) r * 0.45, 3.6 - cast(f32) r * 0.45, 3.5 - cast(f32) r * 0.45, 3.5 - cast(f32) r * 0.45, 10, true); }
  sp_robot(buf, p, frame_at(v3(2.2, 0, -4), 2.8), 0.9);
}
// 15, Coral sea (pin 7): a red-orange sea at dusk, birds, and the robot on a rock at the shore.
sp_sea :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.82, 0.52, 0.42), false);
  kit_sea(buf, p, 2, sc(0.86, 0.36, 0.30), sc(0.98, 0.80, 0.66), 0.05, -6, 1500);
  kit_rocks(buf, p, 4, sc(0.42, 0.24, 0.26), 8, 1510, 0, 2, 2, 8, 0.5, 1.8);
  kit_pen(p, 5, MAT_WORLD, sc(0.42, 0.24, 0.26));
  ellipsoid(buf, p, frame_at(v3(0, 0.2, 0), 0), 2.2, 1.0, 1.8, 10, 6, 0);
  for i: 0..<5 {
    k := cast(f32) i;
    kit_bird(buf, p, frame_at(v3(-6 + k * 3.2, 9 + kit_rand(k + 1520) * 4, -10 - kit_rand(k + 1530) * 6), 0.4), 0.7, 16, sc(0.98, 0.94, 0.90));
  }
  sp_robot(buf, p, frame_at(v3(0, 0.95, 0), 2.6), 0.8);
}
// 16, Sun stairs (pin 8): a great lavender stair to a wall with a blue banner, the sun behind.
sp_stairs :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.76, 0.66, 0.86), false);
  kit_steps(buf, p, frame_at(v3(0, 0, 0), 0), 2, sc(0.70, 0.60, 0.86), sc(0.82, 0.72, 0.90), 12, 0.9, 1.8, 14);
  kit_pen(p, 3, MAT_WORLD, sc(0.64, 0.54, 0.80));
  block(buf, p, 0, 0, -24, 14, 22, 2);
  block(buf, p, -13, 0, -22, 2.4, 26, 2.4);
  block(buf, p, 13, 0, -22, 2.4, 26, 2.4);
  kit_banner(buf, p, frame_at(v3(0, 16, -21.8), 0), 4, sc(0.24, 0.40, 0.80), sc(1.0, 0.86, 0.50), 6, 9);
  kit_moon(buf, p, 6, sc(1.0, 0.92, 0.70), v3(-24, 34, -60), 6);
  sp_robot(buf, p, frame_at(v3(-1, 0, 5), 3.0), 1);
}

SP_SCENES :: 17;
// Each scene's world, written once when the scene is chosen.
sp_build_world :: (buf: [] u32, p: [] Pen, scene: int) {
  if scene == 1 { sp_arch(buf, p); } else if scene == 2 { sp_crabs(buf, p); } else if scene == 3 { sp_walker(buf, p); }
  else if scene == 4 { sp_terraces(buf, p); } else if scene == 5 { sp_pack(buf, p); } else if scene == 6 { sp_canyon(buf, p); }
  else if scene == 7 { sp_palace(buf, p); } else if scene == 8 { sp_spider(buf, p); } else if scene == 9 { sp_tanks(buf, p); }
  else if scene == 10 { sp_caravan(buf, p); } else if scene == 11 { sp_windmill(buf, p); } else if scene == 12 { sp_skycity(buf, p); }
  else if scene == 13 { sp_mech(buf, p); } else if scene == 14 { sp_spire(buf, p); } else if scene == 15 { sp_sea(buf, p); }
  else if scene == 16 { sp_stairs(buf, p); } else { sp_dunes(buf, p); }
}
scam :: (ex: f32, ey: f32, ez: f32, ax: f32, ay: f32, az: f32, fov: f32) -> CamNow { return CamNow.{eye = v3(ex, ey, ez), at = v3(ax, ay, az), fov = fov}; }
// Each scene's camera (one fixed view per scene).
sp_camera :: (scene: int) -> CamNow {
  if scene == 1 { return scam(0, 2.2, 21, 0, 4.2, -1, 0.62); }
  if scene == 2 { return scam(0, 3.4, 13, 0, 1.0, -1, 0.6); }
  if scene == 3 { return scam(-9, 3.2, 17, 0, 4.2, 0, 0.62); }
  if scene == 4 { return scam(-14, 7, 34, 0, 6, 0, 0.6); }
  if scene == 5 { return scam(-6, 2.2, 22, 1, 7, -6, 0.7); }
  if scene == 6 { return scam(0, 1.6, 14, 0, 9, -20, 0.75); }
  if scene == 7 { return scam(6, 3, 24, -1, 4, -10, 0.62); }
  if scene == 8 { return scam(-4, 3.2, 13, 0.5, 1.4, 0, 0.62); }
  if scene == 9 { return scam(0, 2.2, 12, 0.6, 0.9, -0.5, 0.62); }
  if scene == 10 { return scam(2, 2.4, 22, -2, 3, -8, 0.6); }
  if scene == 11 { return scam(4, 1.2, 14, -2, 6, -4, 0.75); }
  if scene == 12 { return scam(0, 2, 20, 0, 16, -30, 0.85); }
  if scene == 13 { return scam(-4, 2.4, 15, 0.5, 2.4, 0, 0.62); }
  if scene == 14 { return scam(3, 1.6, 12, 0, 18, -40, 0.8); }
  if scene == 15 { return scam(-5, 2.6, 12, 0, 2.6, -6, 0.62); }
  if scene == 16 { return scam(5, 4.5, 22, 0, 8, -14, 0.7); }
  return scam(-5.6, 2.6, 13, 0.5, 1.7, 0, 0.52);
}
slook :: (variant: int, clock: f32, kx: f32, ky: f32, kz: f32) -> SpLook { return SpLook.{variant = variant, clock = clock, key = unit_or(v3(kx, ky, kz), v3(0, 1, 0))}; }
// Each scene's look: a noon pastoral for the bright pins, dusk for the sunset ones, neon for night.
sp_look :: (scene: int) -> SpLook {
  if scene == 5 || scene == 7 || scene == 9 || scene == 10 || scene == 13 { return slook(SP_PASTORAL, 0.5, -0.45, 0.62, -0.64); }
  if scene == 6 || scene == 12 || scene == 16 { return slook(SP_PASTORAL, 0.62, -0.6, 0.45, -0.66); }
  if scene == 8 { return slook(SP_NEON, 0.0, 0.5, 0.4, -0.76); }
  if scene == 11 || scene == 15 { return slook(SP_DUSK, 0.80, 0.55, 0.2, -0.81); }
  if scene == 14 { return slook(SP_ACTION, 0.0, -0.4, 0.5, -0.77); }
  return slook(SP_DUSK, 0.78, -0.5, 0.27, -0.82);
}
splice_variant :: (s: [] Splice) -> int #export_c #effects(all) { if !s[0].gallery { return g_variant(s[0].game[..]); } return sp_look(s[0].scene).variant; }
splice_clock :: (s: [] Splice) -> f32 #export_c #effects(all) { if !s[0].gallery { return g_clock(s[0].game[..]); } return sp_look(s[0].scene).clock; }

// The page's facts (kind 600) carry the URL: ?scene=N picks the scene, 0 to SP_SCENES - 1; anything else is 0.
splice_message :: (s: [] Splice, kind: int, body: string) #export_c #effects(all) {
  if kind == 610 && s.count > 0 && body.count > 0 {   // a moment of the game to stand in: "0" to "10"
    n := 0;
    for i: 0..<body.count { d := cast(int) body[i] - 48; if d >= 0 && d <= 9 { n = n * 10 + d; } }
    s[0].started = true; g_stage(s[0].game[..], n);
    return;
  }
  if kind != 600 || s.count < 1 { return; }
  target := "scene=";
  for i: 0..<body.count {
    hit := true;
    for j: 0..<target.count {
      if i + j >= body.count || body[i + j] != target[j] { hit = false; break; }
    }
    if hit {
      s[0].gallery = true;
      n := 0; digits := 0; at := i + target.count;
      while at < body.count && digits < 3 {
        d := cast(int) body[at] - 48;
        if d < 0 || d > 9 { break; }
        n = n * 10 + d; digits += 1; at += 1;
      }
      s[0].scene = ifx digits > 0 && n < SP_SCENES then n else 0;
      return;
    }
  }
}

// Shadows follow what the camera looks at (Anime Lab's are fixed on its courtyard).
sp_shadow_rows :: (u: [] f32, l: Point, c: Point) {
  z := unit_or(l, v3(0, 1, 0));
  r := unit_or(cross(v3(0, 1, 0), z), v3(1, 0, 0));
  up := cross(z, r);
  k := 1 / SHADOW_HALF;
  put4(u, U_SHADOW, r.x * k, r.y * k, r.z * k, -dot(r, c) * k);
  put4(u, U_SHADOW + 4, up.x * k, up.y * k, up.z * k, -dot(up, c) * k);
  d := -0.5 / SHADOW_DEEP;
  put4(u, U_SHADOW + 8, z.x * d, z.y * d, z.z * d, 0.5 - dot(z, c) * d);
  put4(u, U_SHADOW + 12, 0, 0, 0, 1);
}

// The frame: the anime look over the world. The game steps, writes what moves and draws its
// interface; a still scene has one fixed camera and no interface.
splice_frame :: (s: [] Splice, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool,
                 world: [] u32, live: [] u32, style: [] f32) -> int #export_c #effects(all) {
  if s.count < 1 || u.count < UNIFORM_FLOATS || !(width >= 1) || !(height >= 1) { return 0; }
  g := s[0].game[..];
  if !s[0].started { s[0].started = true; s[0].time = 0; g_reset(g); }
  if !s[0].world_built || (s[0].gallery && s[0].built_scene != s[0].scene) {
    pen := [1] Pen.[Pen.{}];
    if s[0].gallery { sp_build_world(world, pen[..], s[0].scene); } else { g_world(g, world, pen[..]); }
    s[0].world_n = pen[0].n; s[0].world_built = true; s[0].built_scene = s[0].scene;
    s[0].over = pen[0].over; s[0].world_gen += 1;
  }
  step := ifx still then 0.0f32 else clamp(dt, 0, 0.1);
  s[0].time += step;
  t := s[0].time;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  for i: 0..<lo_i(style.count, STYLE_FLOATS) { u[U_STYLE + i] = style[i]; }
  view := sp_camera(s[0].scene); key := sp_look(s[0].scene).key; flash := 0.0f32;
  s[0].live_n = 0;
  if !s[0].gallery {
    g_step(g, step);
    view = g_camera(g); key = g_key_light(g); flash = g[0].flash;
    pen := [1] Pen.[Pen.{}];
    g_live(g, live, pen[..]);
    s[0].live_n = pen[0].n;
  }
  view_rows(u, view, width / height);
  if style.count >= STYLE_FLOATS { u[U_STYLE + SU_KEY_DIR] = key.x; u[U_STYLE + SU_KEY_DIR + 1] = key.y; u[U_STYLE + SU_KEY_DIR + 2] = key.z; u[U_STYLE + SU_KEY_DIR + 3] = 0; }
  if s[0].gallery { shadow_rows(u, key); } else { sp_shadow_rows(u, key, view.at); }
  put4(u, U_SIZE, width, height, t, dpr);
  ink := hi(1, lo(width, height) / 720);
  put4(u, U_FX, flash, 0, 0, ink);   // a hit or a breakthrough flashes; no speed lines
  put4(u, U_DRAW, 0, 0, 0, -1);
  put4(u, U_MISC, ifx animelab_phone(width, dpr) then 1.0f32 else 0.0f32, 0.5, 0.45, 1);
  s[0].draws[0] = 0; s[0].draws[1] = cast(u32) s[0].world_n; s[0].draws[2] = 0x80000000; s[0].draws[3] = 1;
  s[0].draws[4] = 0; s[0].draws[5] = cast(u32) s[0].live_n; s[0].draws[6] = 0x80000001; s[0].draws[7] = 1;
  if s[0].gallery { return 0; }   // a still scene has no interface
  return g_overlay(g, out, u, width, height);
}
splice_key :: (s: [] Splice, key: int, down: bool) -> bool #export_c #effects(all) {
  if s[0].gallery || !s[0].started { return false; }
  return g_key(s[0].game[..], key, down);
}
// Mouse look (the host holds the pointer while you walk): 0 a still scene, 1 the cursor is free, 2 hold it.
splice_mouselook :: (s: [] Splice) -> int #export_c #effects(all) { if s[0].gallery || !s[0].started { return 0; } return g_mouselook(s[0].game[..]); }
splice_look :: (s: [] Splice, dx: f32, dy: f32) #export_c #effects(all) { if !s[0].gallery && s[0].started { g_look(s[0].game[..], dx, dy); } }
splice_lock :: (s: [] Splice, status: int) #export_c #effects(all) { if !s[0].gallery && s[0].started { g_lock(s[0].game[..], status); } }
splice_pointer :: (s: [] Splice, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s[0].gallery || !s[0].started { return false; }
  return g_pointer(s[0].game[..], x, y, phase);
}

coaxial_splice_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_splice_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_splice_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }
splice_world_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].world_n; }
splice_world_version :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].world_gen; }
splice_live_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].live_n; }
splice_draw_count :: (s: [] Splice) -> int #export_c #effects(all) { return ifx !s[0].world_built then 0 else ifx s[0].gallery then 1 else 2; }

#test "two digit scenes parse, and an unknown scene is the first" {
  s := [1] Splice.[Splice.{}];
  splice_message(s[..], 600, "https://x/worlds/splice?scene=16");
  #assert s[0].scene == 16;
  splice_message(s[..], 600, "?scene=7&x=1");
  #assert s[0].scene == 7;
  splice_message(s[..], 600, "?scene=99");
  #assert s[0].scene == 0;
}
