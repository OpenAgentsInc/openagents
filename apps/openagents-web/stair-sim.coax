// Hold the Stair's difficulty curve over many seeds, natively (the #tests in stair.coax take one):
//   coax/bin/coax run apps/openagents-web/stair-sim.coax --release
// Each map, then each line: a player (stair.coax's play_as), WON or LOST, the wave it ended on, lives left,
// defenders placed and the lives the waves from 9 on took. 2026-10-31, forty waves, each map's
// late weight on the late beasts' hit points (1.7, 1.6, 1.3), the subclasses and the magic items: BEST wins all
// fifteen runs, losing 0 to 69 lives to waves 21-40; a little more (1.8, 1.7, 1.4) costs lives first and still wins 11 of 15. Seconds a run.
#import "Basic";
#load "stair.coax";

main :: () {
  names := [5] string.["NEW_PLAYER", "NEW_LEVELS", "BETWEEN", "HOARDER", "BEST"];
  s: [1] Stair;
  stair_start(s[..]);
  for map: 0..<MAPS {
    set_map(s[..], map);
    print("map %: %\n", map + 1, STAIR_MAP_NAME[map]);
    for who: 0..<5 {
      for seed: 1..<6 {
        r := play_as(s[..], who, cast(u64) (seed * 7919));
        print("% seed %: % wave % lives % placed % late %\n", names[who], seed * 7919, ifx r.won then "WON " else "LOST", r.wave, r.lives, r.placed, r.lost_late);
      }
    }
  }
}
