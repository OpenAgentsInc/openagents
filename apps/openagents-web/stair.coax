// Hold the Stair, openagents.com/realms/hold-the-stair: a popping tower
// defense on the SRD 5e rules (docs/verse/game-ideas/hold-the-stair.md).
// Bubble-beasts climb a winding stair from the cellar door to the top of the
// wizard's tower; you place a party beside it with gold. Each defender rolls
// a real d20 against a beast's armor class on its turn (verse/rules/
// srd5-combat.coax), damage types meet immunities (an ember shrugs off fire),
// and a popped beast lets out the layer inside. Ten waves; lives are the
// tower's hit points.
//
// Everything is drawn flat: stair.wgsl's bg_fs draws the floor, the stair and
// the panels from the uniforms; the beasts, the party, the bolts, the red
// damage numbers and the HUD text are fx strokes (font.coax).
//   coax/bin/coax test apps/openagents-web/stair.coax --steps 2000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/rules/srd5-combat.coax";
#load "stair-tables.coax";

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 36000;
PLATES :: 24;
COLS :: 14; ROWS :: 9; CELLS :: 126;
// The uniforms: size, time, fade; the map (origin x, y, tile, squash); info (screen cols, rows,
// portrait, hover cell); info2 (hurt, selected cell, plates, 0); the cells (a kind each, 128: the
// stair's progress as its fraction, 10 + class where a defender stands); the units (a defender's
// facing × 1 + its attack flash; 3 for the ghost of one about to go down); the plates.
U_MAP :: 4; U_INFO :: 8; U_INFO2 :: 12; U_CELLS :: 16; U_UNIT :: 144; U_PLATE :: 272;
U_ENDS :: U_PLATE + PLATES * 8;   // the stairs' doors and tops, for their light
UNIFORM_FLOATS :: U_ENDS + 8;
SQUASH :: 0.86;          // the slight tilt: a tile is drawn this much shorter than wide
WALL_ROWS :: 0.55;       // the back wall above the map, and the stone rim round the rest (stair.wgsl's WALL, RIM)
RIM_TILES :: 0.16;

CELL_FLOOR :: 0; CELL_PATH :: 1; CELL_DEFENDER :: 2; CELL_DOOR :: 3; CELL_TOP :: 4;

// The stair: waypoints (column, row) from the cellar door to the tower top.

// ---- the bubble-beasts (original creatures, stat blocks in the SRD's terms)
MOTE :: 0; WISP :: 1; GLIMMER :: 2; EMBER :: 3; FROSTLING :: 4; IRONSKIN :: 5; SHADOW :: 6; HULK :: 7; LAYERS :: 8;
LAYER_NAME :: [8] string.["MOTE", "WISP", "GLIMMER", "EMBER", "FROSTLING", "IRONSKIN", "SHADOW", "HULK"];
// A wisp resists cold; an ember is immune to fire, a frostling to cold; an ironskin resists slashing,
// piercing and bludgeoning from non-magical attacks (every weapon here is); a hulk regenerates.
HULK_REGEN :: 2.0;   // hit points a second
// A shadow can't be targeted until it is seen: a cleric casts Daylight (once a wave, when a shadow
// is in its reach), and every shadow within DAYLIGHT_REACH of it is seen for the rest of the wave.
DAYLIGHT_REACH :: 3.0;
// What each pops into: up to two inner layers (-1 none).

// ---- the party (SRD 5.2.1 classes at level 1)
FIGHTER :: 0; WIZARD :: 1; CLERIC :: 2; ROGUE :: 3; RANGER :: 4; BARD :: 5; PALADIN :: 6; CLASSES :: 7;
CLASS_NAME :: [7] string.["FIGHTER", "WIZARD", "CLERIC", "ROGUE", "RANGER", "BARD", "PALADIN"];
CLASS_R :: [7] f32.[0.85, 0.72, 1.0, 0.55, 0.5, 1.0, 0.92];
CLASS_G :: [7] f32.[0.88, 0.55, 0.86, 0.85, 0.9, 0.5, 0.95];
CLASS_B :: [7] f32.[0.95, 1.0, 0.42, 0.8, 0.45, 0.75, 1.0];
CLASS_ATTACK :: [7] string.["LONGSWORD +5 · 1D8+3 SLASHING", "FIRE BOLT +5 · 1D10 FIRE", "SACRED FLAME · DEX DC 13 · 1D8 RADIANT",
  "SHORTSWORD +5 · 1D6+3 PIERCING", "LONGBOW +5 · 1D8+3 PIERCING", "VICIOUS MOCKERY · WIS DC 13 · 1D6 PSYCHIC", "LONGSWORD +5 · 1D8+3 SLASHING"];
// Fighter: Strength 16 (+3), proficiency +2: a longsword, +5 to hit, 1d8 + 3 slashing.
STAIR_FIGHTER :: SrdCreature.{name = "Fighter", ac = 16, hp = 12, dex = 1, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_SLASHING};
// Wizard: Intelligence 16 (+3), proficiency +2: Fire Bolt, a ranged spell attack +5, 1d10 fire.
STAIR_FIRE_BOLT :: SrdCreature.{name = "Fire Bolt", ac = 12, hp = 8, dex = 2, attack = 5, dice = 1, sides = 10, bonus = 0, kind = DMG_FIRE};
// Magic Missile (level 1): three darts that never miss, 1d4 + 1 force each. Two slots a wave.
MM_SLOTS :: 2;
// Cleric: Wisdom 16 (+3), proficiency +2: Sacred Flame, a Dexterity save against DC 13, 1d8 radiant.
SACRED_DC :: 13;
// Rogue: Dexterity 16 (+3): a shortsword +5, 1d6 + 3 piercing, and Sneak Attack, +1d6 when another
// of the party stands within 5 feet (a tile and a half here) of the target.
STAIR_ROGUE :: SrdCreature.{name = "Rogue", ac = 14, hp = 9, dex = 3, attack = 5, dice = 1, sides = 6, bonus = 3, kind = DMG_PIERCING};
SNEAK_REACH :: 1.5;
// Ranger: Dexterity 16 (+3): a longbow +5, 1d8 + 3 piercing. Favoured Enemy: Hunter's Mark on the
// layer it is placed against (the next wave's strongest), +1d6 on a hit, and it shoots those first.
STAIR_RANGER :: SrdCreature.{name = "Ranger", ac = 14, hp = 11, dex = 3, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_PIERCING};
// Bard: Charisma 16 (+3): Vicious Mockery, a Wisdom save against DC 13 (a bubble-beast's Wisdom is
// +0), 1d6 psychic; and Bardic Inspiration each turn: the nearest of the party in its reach without
// one adds a d6 to its next attack roll.
MOCKERY_DC :: 13;
// Paladin: Strength 16 (+3): a longsword +5, 1d8 + 3 slashing. Its aura (Aura of Protection, here
// for the party's aim, not saves): the party within 10 feet (two tiles) adds +1 to attack rolls.
STAIR_PALADIN :: SrdCreature.{name = "Paladin", ac = 18, hp = 12, dex = 0, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_SLASHING};
AURA_REACH :: 2.0;

// ---- levels 2 and 3 (SRD 5.2.1 class features and spell slots; proficiency stays +2)
// Fighter 2: Action Surge, its turn takes two attacks once a wave. Fighter 3 (Champion): Improved
// Critical, a 19 or 20 crits. Wizard 2: three 1st-level slots (Magic Missile). Wizard 3: two
// 2nd-level slots a wave for Shatter: everything within 10 feet (a tile) of the target makes a
// Constitution save against DC 13, 3d8 thunder, half on a success. Cleric 2: Bless, the party in
// its reach adds a d4 to attack rolls. Cleric 3: Spiritual Weapon, a melee spell attack +5 each
// turn too, 1d8 + 3 force. Rogue 2: Cunning Action, a turn a quarter sooner. Rogue 3: Sneak Attack 2d6.
// Ranger 2: Hunter's Mark on whatever it hits. Ranger 3: a second arrow each turn. Bard 2: two
// inspired a turn. Bard 3: Mockery 2d6. Paladin 2: Divine Smite, +2d8 radiant on its first hit of a
// wave. Paladin 3: the aura reaches three tiles. Level 4, every class: an Ability Score Improvement,
// +1 to its attack rolls and its save DCs. Level 5: Extra Attack for the fighter and the paladin, a
// third arrow for the ranger, Sneak Attack 3d6, the cantrips' second die (Fire Bolt 2d10, Sacred
// Flame 2d8), and Bardic Inspiration a d8.
MAX_LEVEL :: 5;
LEVEL_COSTS :: 4;   // a class's costs for levels 2 to 5
SHATTER_SLOTS :: 2; SHATTER_RADIUS :: 1.0; SHATTER_DC :: 13; SHATTER_MIN :: 3;
STAIR_SPIRIT :: SrdCreature.{name = "Spiritual Weapon", ac = 10, hp = 1, dex = 0, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_FORCE};
up_cost :: (s: [] Stair, cls: int, level: int) -> int { return ifx level >= MAX_LEVEL then 0 else s[0].ct[0].up[cls * LEVEL_COSTS + level - 1]; }
// Its save DC, with level 4's improvement.
dc_of :: (s: [] Stair, k: int, base: int) -> int { return ifx s[0].party[k].level >= 4 then base + 1 else base; }

// Level 3: each class's SRD 5.2.1 subclass (the SRD's one each), on top of what level 3 already gave.
// Champion: Improved Critical (19-20). Evoker: Potent Cantrip, a Fire Bolt that misses still deals half.
// Life: Preserve Life, the tower gets LIFE_RESTORE lives back when a wave is held. Thief: Fast Hands,
// its turns come faster still. Hunter: Colossus Slayer, 1d8 more on a beast already hurt. Lore: Cutting
// Words... in the tower, a third inspired a turn. Devotion: Sacred Weapon, +3 (Charisma) to hit.
SUBCLASS_NAME :: [7] string.["CHAMPION", "EVOKER", "LIFE", "THIEF", "HUNTER", "LORE", "DEVOTION"];
SUBCLASS_FEAT :: [7] string.["CHAMPION: CRITS ON 19-20 · ACTION SURGE", "EVOKER: A MISSED FIRE BOLT BURNS FOR HALF · SHATTER", "LIFE: +2 LIVES A WAVE HELD · BLESS · SPIRITUAL WEAPON", "THIEF: FAST HANDS, TURNS FASTER STILL · SNEAK 2D6", "HUNTER: +1D8 ON A HURT BEAST · TWO ARROWS", "LORE: INSPIRES 3 IN REACH · MOCKERY 2D6", "DEVOTION: SACRED WEAPON +3 TO HIT · AURA 3 TILES"];
LIFE_RESTORE :: 2; SACRED_WEAPON :: 3; THIEF_TURN :: 0.6;
LEVEL4_FEAT :: [7] string.["+1 TO HIT · NEXT: EXTRA ATTACK", "+1 TO HIT AND DC · NEXT: FIRE BOLT 2D10", "+1 TO HIT AND DC · NEXT: SACRED FLAME 2D8", "+1 TO HIT · NEXT: SNEAK ATTACK 3D6", "+1 TO HIT · NEXT: A THIRD ARROW", "+1 TO HIT AND DC · NEXT: INSPIRATION 1D8", "+1 TO HIT · NEXT: EXTRA ATTACK"];
LEVEL5_FEAT :: [7] string.["EXTRA ATTACK: 2 A TURN · SURGE · CRITS 19-20", "FIRE BOLT 2D10 · SHATTER · +1 TO HIT AND DC", "SACRED FLAME 2D8 · BLESS · SPIRITUAL WEAPON", "SNEAK ATTACK 3D6 · CUNNING ACTION", "THREE ARROWS A TURN · MARKS ALL", "INSPIRES 2 WITH 1D8 · MOCKERY 2D6", "EXTRA ATTACK · AURA 3 TILES · SMITE"];

CLASS_PAD :: 14;
// The room a class button's portrait takes: most of its height, but no more than 30% of a narrow button.
class_icon :: (r: Rect) -> f32 { return lo((r.y1 - r.y0) * 0.8, (r.x1 - r.x0) * 0.3); }   // a class button's text keeps this far (in CSS px) from its right edge

// ---- your spells: the tower's wizard (you) has a few a map. Wall of Stone across the stair: the
// beasts stop at it and break it (SRD panels, AC 15; WALL_HP between them), then climb on. Wall of
// Fire across it for a minute: a beast going through makes a Dexterity save against DC 15 or takes
// 5d8 fire, half on a success. Slow: every beast on the stair at half speed for SLOW_TIME seconds.
YOUR_SPELLS :: 3; SPELL_STONE :: 0; SPELL_FIRE :: 1; SPELL_SLOW :: 2;
SPELL_CASTS :: [YOUR_SPELLS] int.[2, 2, 2];
SPELL_NAME :: [YOUR_SPELLS] string.["STONE", "FIRE", "SLOW"];
// Past the free casts, gold buys more: the first at this price, each after it that much again.
SPELL_PRICE :: [YOUR_SPELLS] int.[150, 200, 120];
BONUS_TOP :: 20;
spell_price :: (s: [] Stair, sp: int) -> int { return SPELL_PRICE[sp] * (1 + s[0].bought[sp]); }
// Ready to cast: a free cast left, or the gold for one.
spell_ready :: (s: [] Stair, sp: int) -> bool { return s[0].spells[sp] > 0 || s[0].gold >= spell_price(s, sp); }
// Spend a cast: a free one first, else its price.
spell_spend :: (s: [] Stair, sp: int) {
  if s[0].spells[sp] > 0 { s[0].spells[sp] -= 1; return; }
  s[0].gold -= spell_price(s, sp); s[0].bought[sp] += 1;
}
WALLS :: 4;
WALL_HP :: 120; WALL_CHEW :: 4.0;   // hit points a beast pressed against it takes off a second
WALL_FIRE_TIME :: 60.0; WALL_FIRE_DC :: 15;
SLOW_TIME :: 12.0;
Wall :: struct { on: bool; kind: int; path: int; d: f32; hp: f32; t: f32; }
// Where a stair tile is along a stair: its path and its distance (-1 path: not on a stair).
PathSpot :: struct { path: int; d: f32; }
path_spot :: (s: [] Stair, cell: int) -> PathSpot {
  for p: 0..<2 {
    l := path_len_of(s, p);
    if l <= 0 { continue; }
    d := 0.5f32;
    while d < l - 0.5 {
      q := path_on(s, p, d);
      if cell_of(cast(int) floor(q.x), cast(int) floor(q.y)) == cell { return PathSpot.{path = p, d = d}; }
      d += 0.25;
    }
  }
  return PathSpot.{path = -1, d = 0};
}
// Arm a wall (again to put it down), or cast Slow.
spell_press :: (s: [] Stair, sp: int) {
  if !spell_ready(s, sp) { say(s, "NOT ENOUGH GOLD"); return; }
  if sp == SPELL_SLOW {
    if live_beasts(s) == 0 { say(s, "NOTHING ON THE STAIR TO SLOW"); return; }
    spell_spend(s, sp); s[0].slow_t = SLOW_TIME;
    track_tally(s[0].track[..], "spell", "slow");
    return;
  }
  s[0].spell_pick = ifx s[0].spell_pick == sp then -1 else sp;
  s[0].pick = -1; s[0].selected = -1; s[0].card = -1;
  if s[0].spell_pick >= 0 { say(s, "TAP A STAIR TILE FOR THE WALL"); }
}
// The armed wall, across the stair at this tile.
cast_wall :: (s: [] Stair, cell: int) -> bool {
  sp := s[0].spell_pick;
  if sp < 0 || !spell_ready(s, sp) { s[0].spell_pick = -1; return false; }
  at := path_spot(s, cell);
  if at.path < 0 || at.d < 1.0 { say(s, "A WALL GOES ON THE STAIR"); return false; }
  slot := -1;
  for i: 0..<WALLS { if slot < 0 && !s[0].walls[i].on { slot = i; } }
  if slot < 0 { say(s, "FOUR WALLS STAND ALREADY"); return false; }
  // centred on its tile, as the stair runs through it
  s[0].walls[slot] = Wall.{on = true, kind = sp, path = at.path, d = at.d, hp = f32(WALL_HP), t = 0};
  spell_spend(s, sp); s[0].spell_pick = -1;
  track_tally(s[0].track[..], "spell", ifx sp == SPELL_STONE then "stone" else "fire");
  return true;
}
// A beast's step up the stair, through the walls: stopped by stone (and chewing it), burnt crossing fire.
wall_step :: (s: [] Stair, i: int, from: f32, dt: f32) {
  for w: 0..<WALLS {
    wl := s[0].walls[w];
    if !wl.on || wl.path != s[0].beasts[i].path || !s[0].beasts[i].live { continue; }
    if wl.kind == SPELL_STONE {
      stop := wl.d - 0.45;
      if from <= stop + 0.001 && s[0].beasts[i].d > stop {
        s[0].beasts[i].d = stop;
        s[0].walls[w].hp -= WALL_CHEW * dt;
        if s[0].walls[w].hp <= 0 {
          s[0].walls[w].on = false;
          p := path_on(s, wl.path, wl.d);
          add_fx(s, FX_SHATTER, p.x, p.y, p.x, p.y, 0.6, 0, 0.7, 0.7, 0.72, false);
        }
      }
    } else if from < wl.d && s[0].beasts[i].d >= wl.d {
      sv := srd_save(s[0].dice[..], s[0].ct[0].dex[s[0].beasts[i].kind], WALL_FIRE_DC);
      dmg := srd_sum(s[0].dice[..], 5, 8);
      p := beast_xy(s, i);
      add_fx(s, FX_FLAME, p.x, p.y, p.x, p.y - 0.4, 0.4, 0, 1.0, 0.3, 0.15, false);
      hurt_beast(s, i, ifx sv.success then dmg / 2 else dmg, DMG_FIRE, false, -1);
    }
  }
}
walls_tick :: (s: [] Stair, dt: f32) {
  s[0].slow_t = hi(0, s[0].slow_t - dt);
  for w: 0..<WALLS {
    if !s[0].walls[w].on { continue; }
    s[0].walls[w].t += dt;
    if s[0].walls[w].kind == SPELL_FIRE && s[0].walls[w].t >= WALL_FIRE_TIME { s[0].walls[w].on = false; }
  }
}

// The walls across the stair: stone a grey bar (dimmer as it breaks), fire a flickering red one.
draw_walls :: (s: [] Stair, out: [] f32, n0: int, t: f32) -> int {
  n := n0;
  for w: 0..<WALLS {
    wl := s[0].walls[w];
    if !wl.on { continue; }
    a := path_on(s, wl.path, wl.d - 0.1); b := path_on(s, wl.path, wl.d + 0.1);
    dx := b.x - a.x; dy := b.y - a.y;
    l := hi(0.0001, sqrt(dx * dx + dy * dy));
    c := path_on(s, wl.path, wl.d);
    px := -dy / l * 0.45; py := dx / l * 0.45;
    p0 := to_screen(s, c.x + px, c.y + py); p1 := to_screen(s, c.x - px, c.y - py);
    if wl.kind == SPELL_STONE {
      left := clamp(wl.hp / f32(WALL_HP), 0, 1);
      n = seg(out, n, p0.x, p0.y, p1.x, p1.y, t * 0.16, 0.5 + 0.5 * left, t * 0.05, 0.62, 0.6, 0.58);
    } else {
      fl := 0.75 + 0.25 * sin(wl.t * 13);
      n = seg(out, n, p0.x, p0.y, p1.x, p1.y, t * 0.09, fl, t * 0.22, 1.0, 0.22, 0.12);
      n = seg(out, n, p0.x, p0.y, p1.x, p1.y, t * 0.03, fl, t * 0.06, 1.0, 0.92, 0.5);
    }
  }
  return n;
}

// ---- the waves: up to three groups each (layer, count, seconds between, delay)
GROUPS :: 3;
waves_of :: (s: [] Stair) -> int { return s[0].ct[0].waves; }

// How many defenders go on the field in one round: three, and one more every two waves.
BEASTS :: 512;
DEFENDERS :: 48;
FX :: 160;
STEP :: 0.0166666667;

// Phases
BUILD :: 0; FIGHT :: 1; WON :: 2; LOST :: 3;

// Fx kinds
FX_NUM :: 1; FX_MISS :: 2; FX_IMMUNE :: 3; FX_BOLT :: 4; FX_SLASH :: 5; FX_POP :: 6; FX_FLAME :: 7; FX_DART :: 8; FX_SAVED :: 9; FX_CRIT :: 10; FX_SHATTER :: 11; FX_SPIRIT :: 12; FX_LEVEL :: 13;

// Buttons
B_START :: 0; B_FAST :: 1; B_GALAXY :: 2; B_FIGHTER :: 3; B_WIZARD :: 4; B_CLERIC :: 5;   // and on to B_FIGHTER + CLASSES - 1
B_LAST_CLASS :: 9; B_SELL :: 10; B_CLOSE :: 11; B_AGAIN :: 12; B_PAUSE :: 13; B_UPGRADE :: 14; B_MAP :: 15; B_STONE :: 16; B_FIRE :: 17; B_SLOW :: 18; BUTTONS :: 19;

OUTBOX_CAP :: 128;
ACT_NAVIGATE :: 1;
KEY_ESCAPE :: -1; KEY_ENTER :: -2;
LONG_PRESS :: 0.45;

INK_R :: 0.86; INK_G :: 0.88; INK_B :: 0.92;
GOLD_R :: 1.0; GOLD_G :: 0.8; GOLD_B :: 0.35;
TIP_R :: 1.0; TIP_G :: 0.55; TIP_B :: 0.12;   // ui.coax's orange: Bitcoin's, for TIP alone
MAKER_KIND :: 608;   // the realm's claimed maker's display name (coax/web/host.js, docs/verse/makers.md)
MAKER_BYTES :: 160;  // its 40 characters of UTF-8

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
Beast :: struct { live: bool; kind: int; d: f32; hp: int; wob: f32; age: f32; path: int; regen: f32; seen: bool; }   // seen: a shadow Daylight has shown
Defender :: struct {
  live: bool; cls: int; cell: int; wait: f32; slots: int;
  level: int; surge: bool; slots2: int; bless: int;   // bless: the d4 Bless added to its last roll (0 none)
  fav: int;        // a ranger's favoured layer
  inspired: int;   // a Bardic Inspiration die waiting for its next attack roll (its sides, 0 none)
  smite: bool;     // a paladin's Divine Smite, ready this wave
  aura: int;       // the +1 a paladin's aura added to its last roll (0 none)
  insp: int;       // the inspiration die it added to its last roll (0 none)
  swings: int;     // fighter attacks made, all told
  slayer: int;     // a Hunter's Colossus Slayer hits, all told
  daylight: bool;  // a cleric's Daylight, lit this wave
  hits: int; misses: int; pops: int;
  roll: int; total: int; vs: int; hit: bool; crit: bool; dealt: int; how: int;   // the last turn (how: 0 attack, 1 save, 2 auto)
  aim: f32; flash: f32;
}
// One event in the rules log, for replays and analytics: a pop, or a split into the inner layers.
RULE_POP :: 1; RULE_SPLIT :: 2;
RULES_LOG :: 64;
Rule :: struct { what: int; wave: int; kind: int; d: f32; a: int = -1; b: int = -1; by: int; }
rule_last :: (s: [] Stair, back: int) -> Rule {
  if back >= s[0].rules_n || back >= RULES_LOG { return Rule.{}; }
  return s[0].rules[(s[0].rules_n - 1 - back) % RULES_LOG];
}
Fx :: struct { kind: int; x: f32; y: f32; x2: f32; y2: f32; t: f32; life: f32; amount: int; r: f32; g: f32; b: f32; big: bool; dx: f32; }

Finger :: struct { id: int = -1; x: f32; y: f32; }
ZOOM_MAX :: 3.0;

Stair :: struct {
  started: bool;
  spells: [YOUR_SPELLS] int;    // the tower wizard's (your) casts left this map: Wall of Stone, Wall of Fire, Slow
  bought: [YOUR_SPELLS] int;    // casts bought with gold this map
  spell_pick: int;         // the wall armed for a tap on the stair (-1 none)
  walls: [WALLS] Wall;
  slow_t: f32;             // seconds of Slow left on the stair
  area: [1] Area;          // where every beast is, a tile a bucket, for area queries
  ct: [1] Content;   // the layers, classes, levels, waves and stair (stair-tables.coax)
  track: [1] Track;
  dice: [1] SrdDice;       // the rules' dice: every attack, save and damage roll, from seed
  looks: [1] SrdDice;      // the looks' (a bubble's wobble, a number's drift), apart so they never shift a roll
  seed: u64;               // the map's seed (its table's, or ?seed=): the same seed rolls the same game
  rules: [RULES_LOG] Rule; rules_n: int;   // the rules log: pops and splits, newest last (a ring)
  time: f64; clock: f32; acc: f32;
  width: f32; height: f32; dpr: f32;
  golden: bool; still: bool; touch: bool;
  card_shot: bool;   // ?card=1: the world without the HUD, for a link's card (coax/web/og-render.ts)
  // the map's layout this frame
  portrait: bool; ox: f32; oy: f32; tile: f32; scols: int; srows: int;
  // the camera (verse/camera.coax's zoom and focus): the map as laid out to fit (bx, by, bt), its
  // middle on the screen (acx, acy), how far in (zoom, 1 to ZOOM_MAX) and the map point, in tiles,
  // at that middle (fu, fv); what lies outside clip_y0..clip_y1 is the HUD's
  bx: f32; by: f32; bt: f32; acx: f32; acy: f32; clip_y0: f32; clip_y1: f32;
  zoom: f32 = 1; fu: f32; fv: f32;
  fingers: [2] Finger; pinch: f32; pinched: bool; panning: bool; mx: f32; my: f32;
  path_len: f32;
  path_len2: f32;   // the second stair's (0: none)
  map: int;         // which of STAIR_MAPS (?map=1..3)
  next_path: int;   // the stair the next beast from the door takes
  cells: [CELLS] int;
  prog: [CELLS] f32;        // how far up the stair a stair cell is (tiles)
  phase: int; wave: int; lives: int; gold: int; speed: int;
  spawned: [GROUPS] int; spawn_t: [GROUPS] f32; wave_t: f32;
  beasts: [BEASTS] Beast;
  party: [DEFENDERS] Defender;
  pops: int; leaked: int; placed: int; placed_round: int;
  pick: int;                // the class armed for placing (-1 none)
  paused: bool;
  fx: [FX] Fx; fx_next: int;
  hurt: f32;
  banner: f32;              // the wave's name across the map as it starts (seconds left)
  selected: int;            // a cell (-1 none)
  card: int;                // a defender whose card shows (-1 none)
  hover: int;               // the cell under the mouse (-1)
  hover_b: int;
  boxes: [BUTTONS] Rect; shown: [BUTTONS] bool; enabled: [BUTTONS] bool;
  press: int; press_id: int; down_t: f32; down_x: f32; down_y: f32; down_cell: int; down_on: bool; long_done: bool;
  plate_n: int;
  toast: [64] u8; toast_n: int; toast_t: f32;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  // the maker's line, MADE BY <NAME> · TIP: the name (608), TIP's box and the finger on it
  maker: [MAKER_BYTES] u8; maker_n: int;
  tip_box: Rect; tip_shown: bool; tip_down: bool; tip_id: int; tip_hover: bool;
  facts: bool; tracked_wave: int;
  swarm: bool;   // ?stage=swarm: SWARM beasts climb round and round, for the frame-rate check
}

// ---- small things

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
lo_i :: (a: int, b: int) -> int { if a < b { return a; } return b; }
hi_i :: (a: int, b: int) -> int { if a > b { return a; } return b; }
clamp01 :: (v: f32) -> f32 { return lo(1, hi(0, v)); }
clamp :: (v: f32, a: f32, b: f32) -> f32 { return lo(b, hi(a, v)); }
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n >= buf.count { break; } buf[n] = c; n += 1; }
  return n;
}
put_int :: (buf: [] u8, at: int, v: int) -> int {
  n := at;
  x := v;
  if x < 0 { if n < buf.count { buf[n] = 45; n += 1; } x = -x; }
  digits: [20] u8; d := 0;
  if x == 0 { digits[0] = 48; d = 1; }
  while x > 0 && d < 20 { digits[d] = cast(u8) (48 + x % 10); x = x / 10; d += 1; }
  while d > 0 { d -= 1; if n < buf.count { buf[n] = digits[d]; n += 1; } }
  return n;
}
// A number after key= in a URL's query (or -1).
query_number :: (url: string, key: string) -> f32 {
  at := 0;
  while at + key.count + 1 <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1;
      v: f32 = 0; digits := 0;
      while i < url.count && url[i] >= 48 && url[i] <= 57 && digits < 6 { v = v * 10 + f32(url[i] - 48); i += 1; digits += 1; }
      if digits == 0 { return -1; }
      return v;
    }
    at += 1;
  }
  return -1;
}

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  return lit_bar(out, at, ax, ay, bx, by, core, light, glow, red, green, blue, mode, 0, 0, 0, 0);
}
// A stroke with stair.wgsl's mode and its four more numbers (bar).
lit_bar :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32, b0: f32, b1: f32, b2: f32, b3: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = b0; out[o + 13] = b1; out[o + 14] = b2; out[o + 15] = b3;
  }
  return true;
}
seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32, r: f32, g: f32, b: f32) -> int {
  if lit(out, n, ax, ay, bx, by, core, light, glow, r, g, b, 0) { return n + 6; }
  return n;
}
disc :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, glow: f32, r: f32, g: f32, b: f32) -> int {
  return seg(out, n, x - 0.01, y, x + 0.01, y, rad, light, glow, r, g, b);
}
// A ring on the floor (squashed by the tilt), one quad: stair.wgsl's mode 1.
ring :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, width: f32, light: f32, r: f32, g: f32, b: f32, sides: int) -> int {
  return ring_sq(out, n, x, y, rad, width, light, r, g, b, f32(SQUASH));
}
ring_sq :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, width: f32, light: f32, r: f32, g: f32, b: f32, squash: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, width * 2 + 1, r, g, b, 1, width * 0.5, squash, 0, 0) { return n + 6; }
  return n;
}
// A glossy bubble (mode 2) with the layer inside showing (inner: its radius as a share, 0 none).
bubble :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, r: f32, g: f32, b: f32, inner: f32, ir: f32, ig: f32, ib: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, rad * 0.7, r, g, b, 2, inner, ir, ig, ib) { return n + 6; }
  return n;
}
// A soft light (mode 3).
glow_disc :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, r: f32, g: f32, b: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, 1, r, g, b, 3, 0, 0, 0, 0) { return n + 6; }
  return n;
}
ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.6 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
say_at :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, k, false, false);
}
say_mid :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap) / 2, base, cap, k);
}

// ---- the stair

cell_of :: (c: int, r: int) -> int { return c + r * COLS; }
// Distance along the stair at the centre of each waypoint, and where a distance is (tile units).
path_length :: (s: [] Stair) -> f32 { return path_len_of(s, 0); }
// Stair p's corners (0 the first, 1 the second).
way_n :: (s: [] Stair, p: int) -> int { return ifx p == 1 then s[0].ct[0].way2_n else s[0].ct[0].way_n; }
way_c :: (s: [] Stair, p: int, i: int) -> int { return ifx p == 1 then s[0].ct[0].way2_c[i] else s[0].ct[0].way_c[i]; }
way_r :: (s: [] Stair, p: int, i: int) -> int { return ifx p == 1 then s[0].ct[0].way2_r[i] else s[0].ct[0].way_r[i]; }
path_len_of :: (s: [] Stair, p: int) -> f32 {
  if way_n(s, p) < 2 { return 0; }
  l := 0.0f32;
  for i: 1..<way_n(s, p) { l += f32(abs_i(way_c(s, p, i) - way_c(s, p, i - 1)) + abs_i(way_r(s, p, i) - way_r(s, p, i - 1))); }
  return l + 1.0;   // the door and the top are half a tile each, and half a tile off the top
}
beast_len :: (s: [] Stair, i: int) -> f32 { return ifx s[0].beasts[i].path == 1 then s[0].path_len2 else s[0].path_len; }
abs_i :: (v: int) -> int { return ifx v < 0 then -v else v; }
P2 :: struct { x: f32; y: f32; }
path_at :: (s: [] Stair, d: f32) -> P2 { return path_on(s, 0, d); }
path_on :: (s: [] Stair, p: int, d: f32) -> P2 {
  // half a tile in from the door, coming in from off the map's edge
  left := d - 0.5;
  if left < 0 {
    c0 := way_c(s, p, 0); r0 := way_r(s, p, 0);
    // in from whichever edge the door is on
    if c0 == 0 { return P2.{x = 0.5 + left, y = f32(r0) + 0.5}; }
    if c0 == COLS - 1 { return P2.{x = f32(c0) + 0.5 - left, y = f32(r0) + 0.5}; }
    if r0 == 0 { return P2.{x = f32(c0) + 0.5, y = 0.5 + left}; }
    return P2.{x = f32(c0) + 0.5, y = f32(r0) + 0.5 - left};
  }
  n := way_n(s, p);
  for i: 1..<n {
    dc := way_c(s, p, i) - way_c(s, p, i - 1); dr := way_r(s, p, i) - way_r(s, p, i - 1);
    seglen := f32(abs_i(dc) + abs_i(dr));
    if left <= seglen || i == n - 1 {
      t := left / hi(seglen, 0.001);
      return P2.{x = f32(way_c(s, p, i - 1)) + 0.5 + f32(dc) * t, y = f32(way_r(s, p, i - 1)) + 0.5 + f32(dr) * t};
    }
    left -= seglen;
  }
  return P2.{x = f32(way_c(s, p, n - 1)) + 0.5, y = f32(way_r(s, p, n - 1)) + 0.5};
}
lay_cells :: (s: [] Stair) {
  for i: 0..<CELLS { s[0].cells[i] = CELL_FLOOR; s[0].prog[i] = 0; }
  for p: 0..<2 {
    n := way_n(s, p);
    if n < 2 { continue; }
    d := 0.5f32;
    for i: 1..<n {
      c := way_c(s, p, i - 1); r := way_r(s, p, i - 1);
      while true {
        // where the stairs share a tile, the first's step stays
        if s[0].cells[cell_of(c, r)] != CELL_PATH { s[0].cells[cell_of(c, r)] = CELL_PATH; s[0].prog[cell_of(c, r)] = d; }
        if c == way_c(s, p, i) && r == way_r(s, p, i) { break; }
        if c < way_c(s, p, i) { c += 1; } else if c > way_c(s, p, i) { c -= 1; } else if r < way_r(s, p, i) { r += 1; } else { r -= 1; }
        d += 1;
      }
    }
  }
  for p: 0..<2 {
    n := way_n(s, p);
    if n < 2 { continue; }
    s[0].cells[cell_of(way_c(s, p, 0), way_r(s, p, 0))] = CELL_DOOR;
    s[0].cells[cell_of(way_c(s, p, n - 1), way_r(s, p, n - 1))] = CELL_TOP;
  }
  for i: 0..<DEFENDERS { if s[0].party[i].live { s[0].cells[s[0].party[i].cell] = CELL_DEFENDER; } }
}
free_cell :: (s: [] Stair, cell: int) -> bool { return cell >= 0 && cell < CELLS && s[0].cells[cell] == CELL_FLOOR; }
defender_at :: (s: [] Stair, cell: int) -> int {
  for i: 0..<DEFENDERS { if s[0].party[i].live && s[0].party[i].cell == cell { return i; } }
  return -1;
}

// ---- starting

stair_reset :: (s: [] Stair) {
  s[0].phase = BUILD; s[0].wave = 0; s[0].lives = s[0].ct[0].start_lives; s[0].gold = s[0].ct[0].start_gold; s[0].speed = 1;
  for i: 0..<BEASTS { s[0].beasts[i].live = false; }
  s[0].area[0].ok = false;
  for i: 0..<DEFENDERS { s[0].party[i].live = false; }
  for i: 0..<FX { s[0].fx[i].life = 0; }
  s[0].pops = 0; s[0].leaked = 0; s[0].placed = 0; s[0].placed_round = 0;
  // a fresh game rolls its seed's dice from the first roll
  s[0].dice[0] = srd_dice(s[0].seed); s[0].looks[0] = srd_dice(s[0].seed ^ 0x5DEECE66D);
  s[0].rules_n = 0;
  s[0].pick = -1; s[0].paused = false;
  for i: 0..<YOUR_SPELLS { s[0].spells[i] = SPELL_CASTS[i]; s[0].bought[i] = 0; }
  s[0].spell_pick = -1; s[0].slow_t = 0;
  for i: 0..<WALLS { s[0].walls[i].on = false; }
  s[0].selected = -1; s[0].card = -1; s[0].hurt = 0;
  s[0].path_len = path_length(s); s[0].path_len2 = path_len_of(s, 1); s[0].next_path = 0;
  lay_cells(s);
}
// Plays map m (0 to MAPS - 1) from the start: its stair, the same tables and seed.
set_map :: (s: [] Stair, m: int) {
  s[0].map = ((m % MAPS) + MAPS) % MAPS;
  ok := stair_tables_default(s[0].ct[..], s[0].map);
  stair_reset(s);
}
stair_start :: (s: [] Stair) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].hover = -1; s[0].hover_b = -1; s[0].press = -1; s[0].press_id = -1; s[0].down_cell = -1;
  s[0].tracked_wave = 0;
  ok := stair_tables_default(s[0].ct[..], s[0].map);
  s[0].seed = s[0].ct[0].seed;
  // the host's state starts zeroed, not at the struct's defaults: no finger down, the map fitted
  for i: 0..<2 { s[0].fingers[i].id = -1; }
  s[0].zoom = 1;
  track_init(s[0].track[..], "hold-the-stair");
  stair_reset(s);
}

say :: (s: [] Stair, t: string) { s[0].toast_n = put(s[0].toast[..], 0, t); s[0].toast_t = 2.4; }

// ---- the fight

add_fx :: (s: [] Stair, kind: int, x: f32, y: f32, x2: f32, y2: f32, life: f32, amount: int, r: f32, g: f32, b: f32, big: bool) {
  k := s[0].fx_next; s[0].fx_next = (k + 1) % FX;
  dx := srd_unit(s[0].looks[..]) * 2 - 1;
  s[0].fx[k] = Fx.{kind = kind, x = x, y = y, x2 = x2, y2 = y2, t = 0, life = life, amount = amount, r = r, g = g, b = b, big = big, dx = dx};
}
beast_xy :: (s: [] Stair, i: int) -> P2 { return path_on(s, s[0].beasts[i].path, s[0].beasts[i].d); }
cell_xy :: (cell: int) -> P2 { return P2.{x = f32(cell % COLS) + 0.5, y = f32(cell / COLS) + 0.5}; }

spawn :: (s: [] Stair, kind: int, d: f32) -> int {
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live {
      s[0].beasts[i] = Beast.{live = true, kind = kind, d = d, hp = s[0].ct[0].hp[kind], wob = srd_unit(s[0].looks[..]) * 6.28};
      // from the door, the stairs in turn
      if s[0].path_len2 > 0 { s[0].beasts[i].path = s[0].next_path; s[0].next_path = 1 - s[0].next_path; }
      s[0].area[0].ok = false;
      return i;
    }
  }
  return -1;
}
// A hulk knits back up to its full hit points.
regen :: (s: [] Stair, i: int, dt: f32) {
  if s[0].beasts[i].kind != HULK { return; }
  s[0].beasts[i].regen += dt * f32(HULK_REGEN);
  while s[0].beasts[i].regen >= 1 {
    s[0].beasts[i].regen -= 1;
    s[0].beasts[i].hp = lo_i(s[0].beasts[i].hp + 1, s[0].ct[0].hp[HULK]);
  }
}
live_beasts :: (s: [] Stair) -> int { n := 0; for i: 0..<BEASTS { if s[0].beasts[i].live { n += 1; } } return n; }

// A beast loses `amount` of `kind` damage: immunities and resistances first; at 0 it pops.
hurt_beast :: (s: [] Stair, i: int, amount: int, kind: int, crit: bool, by: int) {
  b := s[0].beasts[i];
  p := beast_xy(s, i);
  if (b.kind == EMBER && kind == DMG_FIRE) || (b.kind == FROSTLING && kind == DMG_COLD) { add_fx(s, FX_IMMUNE, p.x, p.y, 0, 0, 0.9, 0, 1, 0.45, 0.45, false); return; }
  dealt := amount;
  if b.kind == WISP && kind == DMG_COLD { dealt = amount / 2; }
  if b.kind == IRONSKIN && (kind == DMG_SLASHING || kind == DMG_PIERCING || kind == DMG_BLUDGEONING) { dealt = amount / 2; }
  if by >= 0 { s[0].party[by].dealt = dealt; }
  add_fx(s, FX_NUM, p.x, p.y, 0, 0, 0.9, dealt, 1, 0.16, 0.1, crit);
  s[0].beasts[i].hp -= dealt;
  if s[0].beasts[i].hp > 0 { return; }
  // pop: the layer inside comes out where it was
  s[0].beasts[i].live = false;
  s[0].gold += s[0].ct[0].gold[b.kind]; s[0].pops += 1;
  if by >= 0 { s[0].party[by].pops += 1; }
  add_fx(s, FX_POP, p.x, p.y, 0, 0, 0.6, 0, s[0].ct[0].red[b.kind], s[0].ct[0].green[b.kind], s[0].ct[0].blue[b.kind], b.kind >= GLIMMER);
  r := Rule.{what = RULE_POP, wave = s[0].wave, kind = b.kind, d = b.d, by = by};
  if s[0].ct[0].inner_a[b.kind] >= 0 { r.a = spawn(s, s[0].ct[0].inner_a[b.kind], b.d + 0.12); r.what = RULE_SPLIT; if r.a >= 0 { s[0].beasts[r.a].path = b.path; } }
  if s[0].ct[0].inner_b[b.kind] >= 0 { r.b = spawn(s, s[0].ct[0].inner_b[b.kind], hi(b.d - 0.12, 0)); r.what = RULE_SPLIT; if r.b >= 0 { s[0].beasts[r.b].path = b.path; } }
  // a hulk's four
  if s[0].ct[0].inner_c[b.kind] >= 0 { j := spawn(s, s[0].ct[0].inner_c[b.kind], b.d + 0.36); if j >= 0 { s[0].beasts[j].path = b.path; } }
  if s[0].ct[0].inner_d[b.kind] >= 0 { j := spawn(s, s[0].ct[0].inner_d[b.kind], hi(b.d - 0.36, 0)); if j >= 0 { s[0].beasts[j].path = b.path; } }
  s[0].rules[s[0].rules_n % RULES_LOG] = r; s[0].rules_n += 1;
}

// The beast furthest along within range of a cell (-1 none); skip: a layer to pass over (-1 none).
// A beast the party can target: anything but a shadow, and a shadow that has passed through a
// cleric's Daylight (once shown, it stays seen).
shadow_seen :: (s: [] Stair, i: int) -> bool {
  if s[0].beasts[i].kind != SHADOW || s[0].beasts[i].seen { return true; }
  p := beast_xy(s, i);
  for k: 0..<DEFENDERS {
    d := s[0].party[k];
    if !d.live || !d.daylight { continue; }
    c := cell_xy(d.cell);
    if (p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y) <= f32(DAYLIGHT_REACH * DAYLIGHT_REACH) { s[0].beasts[i].seen = true; return true; }
  }
  return false;
}
first_in_range :: (s: [] Stair, cell: int, range: f32, skip: int) -> int {
  c := cell_xy(cell);
  n := area_sphere(s, c.x, c.y, range, s[0].area[0].hits[..]);
  best := -1; far := -1.0f32;
  for j: 0..<n {
    i := s[0].area[0].hits[j];
    if s[0].beasts[i].kind == skip || !shadow_seen(s, i) { continue; }
    if s[0].beasts[i].d > far { far = s[0].beasts[i].d; best = i; }
  }
  return best;
}

// A wave's spell slots and Action Surge come back.
refresh :: (s: [] Stair, k: int) {
  lv := s[0].party[k].level;
  s[0].party[k].slots = ifx lv >= 2 then MM_SLOTS + 1 else MM_SLOTS;
  s[0].party[k].slots2 = ifx lv >= 3 then SHATTER_SLOTS else 0;
  s[0].party[k].surge = lv >= 2;
  s[0].party[k].smite = s[0].party[k].cls == PALADIN && lv >= 2;
  s[0].party[k].daylight = false;
}
// A cleric of level 2 or more with this defender in its reach blesses it.
blessed :: (s: [] Stair, k: int) -> bool {
  c := cell_xy(s[0].party[k].cell);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live || d.cls != CLERIC || d.level < 2 { continue; }
    e := cell_xy(d.cell);
    if (e.x - c.x) * (e.x - c.x) + (e.y - c.y) * (e.y - c.y) <= s[0].ct[0].range[CLERIC] * s[0].ct[0].range[CLERIC] { return true; }
  }
  return false;
}
// An attack roll as srd_attack's, with a crit on crit_on or better and Bless's d4 when blessed.
stair_attack :: (s: [] Stair, k: int, c: SrdCreature, ac: int, crit_on: int) -> SrdAttack {
  dice := s[0].dice[..];
  a: SrdAttack;
  a.roll = srd_roll(dice, 20);
  bless := ifx blessed(s, k) then srd_roll(dice, 4) else 0;
  s[0].party[k].bless = bless;
  insp := 0;
  if s[0].party[k].inspired > 0 { insp = srd_roll(dice, s[0].party[k].inspired); s[0].party[k].inspired = 0; }
  aura := ifx in_aura(s, k) then 1 else 0;
  s[0].party[k].aura = aura; s[0].party[k].insp = insp;
  asi := ifx s[0].party[k].level >= 4 then 1 else 0;
  if s[0].party[k].cls == PALADIN && s[0].party[k].level >= 3 { asi += SACRED_WEAPON; }   // Devotion's Sacred Weapon
  a.total = a.roll + c.attack + bless + insp + aura + asi;
  a.crit = a.roll >= crit_on;
  a.hit = a.roll != 1 && (a.crit || a.total >= ac);
  if a.hit {
    n := ifx a.crit then c.dice * 2 else c.dice;
    a.damage = srd_max_i(srd_sum(dice, n, c.sides) + c.bonus, 1);
  }
  return a;
}
// Seconds between a defender's turns (a rogue's Cunning Action makes them a quarter shorter).
turn_of :: (s: [] Stair, k: int) -> f32 {
  d := s[0].party[k];
  t := s[0].ct[0].turn[d.cls];
  if d.cls == ROGUE && d.level >= 3 { return t * f32(THIEF_TURN); }
  return ifx d.cls == ROGUE && d.level >= 2 then t * 0.75 else t;
}
// Within a paladin's aura (its own included).
in_aura :: (s: [] Stair, k: int) -> bool {
  c := cell_xy(s[0].party[k].cell);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live || d.cls != PALADIN { continue; }
    e := cell_xy(d.cell);
    r := f32(ifx d.level >= 3 then AURA_REACH + 1 else AURA_REACH);
    if (e.x - c.x) * (e.x - c.x) + (e.y - c.y) * (e.y - c.y) <= r * r { return true; }
  }
  return false;
}
// Another of the party within SNEAK_REACH of beast t (a rogue's Sneak Attack).
ally_near :: (s: [] Stair, k: int, t: int) -> bool {
  p := beast_xy(s, t);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if i == k || !d.live { continue; }
    e := cell_xy(d.cell);
    if (e.x - p.x) * (e.x - p.x) + (e.y - p.y) * (e.y - p.y) <= f32(SNEAK_REACH * SNEAK_REACH) { return true; }
  }
  return false;
}
// The strongest layer in the coming wave (a ranger's favoured enemy).
strongest_next :: (s: [] Stair) -> int {
  w := lo_i(s[0].wave, waves_of(s) - 1);
  best := 0;
  for g: 0..<GROUPS { kd := s[0].ct[0].kind[w * GROUPS + g]; if kd > best { best = kd; } }
  return best;
}
// A weapon attack by defender k with creature c on beast t: the roll, the fx, the damage
// (extra: dice of 6 added on a hit, doubled on a crit). False when t is gone.
weapon_hit :: (s: [] Stair, k: int, c: SrdCreature, t: int, extra: int, how_fx: int) -> SrdAttack {
  d := s[0].party[k];
  e := cell_xy(d.cell);
  b := s[0].beasts[t]; p := beast_xy(s, t);
  a := stair_attack(s, k, c, s[0].ct[0].ac[b.kind], 20);
  record(s, k, a.roll, a.total, s[0].ct[0].ac[b.kind], a.hit, a.crit, 0, p);
  add_fx(s, how_fx, e.x, e.y, p.x, p.y, 0.3, 0, CLASS_R[d.cls], CLASS_G[d.cls], CLASS_B[d.cls], a.crit);
  if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
  if a.hit {
    dmg := a.damage;
    if extra > 0 { dmg += srd_sum(s[0].dice[..], ifx a.crit then extra * 2 else extra, 6); }
    s[0].party[k].dealt = dmg;
    hurt_beast(s, t, dmg, c.kind, a.crit, k);
  } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
  return a;
}
// The beast furthest along in reach of a layer, else any (-1 none).
first_of :: (s: [] Stair, cell: int, range: f32, kind: int) -> int {
  c := cell_xy(cell);
  best := -1; far := -1.0f32;
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live || s[0].beasts[i].kind != kind || !shadow_seen(s, i) { continue; }
    p := beast_xy(s, i);
    dx := p.x - c.x; dy := p.y - c.y;
    if dx * dx + dy * dy <= range * range && s[0].beasts[i].d > far { far = s[0].beasts[i].d; best = i; }
  }
  return ifx best >= 0 then best else first_in_range(s, cell, range, -1);
}
ranger_shot :: (s: [] Stair, k: int) -> bool {
  d := s[0].party[k];
  range := s[0].ct[0].range[RANGER];
  t := first_of(s, d.cell, range, d.fav);
  if t < 0 { return false; }
  marked := d.level >= 2 || s[0].beasts[t].kind == d.fav;
  // Colossus Slayer: a beast already hurt takes 1d8 more on a hit
  hurt := s[0].beasts[t].hp < s[0].ct[0].hp[s[0].beasts[t].kind];
  a := weapon_hit(s, k, STAIR_RANGER, t, ifx marked then 1 else 0, FX_DART);
  if d.level >= 3 && hurt && a.hit && s[0].beasts[t].live { hurt_beast(s, t, srd_roll(s[0].dice[..], 8), DMG_PIERCING, false, k); s[0].party[k].slayer += 1; }
  return true;
}

// A fighter's attack on the beast furthest along in reach (false: nothing in reach).
fighter_attack :: (s: [] Stair, k: int) -> bool {
  d := s[0].party[k];
  c := cell_xy(d.cell);
  t := first_in_range(s, d.cell, s[0].ct[0].range[FIGHTER], -1);
  if t < 0 { return false; }
  b := s[0].beasts[t]; p := beast_xy(s, t);
  a := stair_attack(s, k, STAIR_FIGHTER, s[0].ct[0].ac[b.kind], ifx d.level >= 3 then 19 else 20);
  record(s, k, a.roll, a.total, s[0].ct[0].ac[b.kind], a.hit, a.crit, 0, p);
  add_fx(s, FX_SLASH, c.x, c.y, p.x, p.y, 0.26, 0, 0.9, 0.92, 1.0, a.crit);
  if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
  if a.hit { hurt_beast(s, t, a.damage, STAIR_FIGHTER.kind, a.crit, k); } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
  s[0].party[k].swings += 1;
  return true;
}
// Level 5's Extra Attack: a second swing on the same turn.
attacks_of :: (d: Defender) -> int { return ifx d.level >= 5 && (d.cls == FIGHTER || d.cls == PALADIN) then 2 else 1; }
// ---- area queries: a spatial grid of the beasts, a tile a bucket, built once a step (and again
// after anything spawns), so a sphere or a line looks only at the tiles it covers.
Area :: struct {
  ok: bool;
  head: [CELLS] int;      // the first beast in a tile (-1 none)
  next: [BEASTS] int;     // the next beast in the same tile
  x: [BEASTS] f32; y: [BEASTS] f32;
  looked: int;            // beasts the last query looked at (its cost)
  hits: [BEASTS] int;     // the game's own queries' answers
}
area_col :: (x: f32) -> int { return lo_i(hi_i(cast(int) floor(x), 0), COLS - 1); }
area_row :: (y: f32) -> int { return lo_i(hi_i(cast(int) floor(y), 0), ROWS - 1); }
area_build :: (s: [] Stair) {
  for c: 0..<CELLS { s[0].area[0].head[c] = -1; }
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live { continue; }
    p := beast_xy(s, i);
    s[0].area[0].x[i] = p.x; s[0].area[0].y[i] = p.y;
    c := area_row(p.y) * COLS + area_col(p.x);
    s[0].area[0].next[i] = s[0].area[0].head[c];
    s[0].area[0].head[c] = i;
  }
  s[0].area[0].ok = true;
}
// Live beasts within r tiles of (x, y), into out in index order; returns how many.
area_sphere :: (s: [] Stair, x: f32, y: f32, r: f32, out: [] int) -> int {
  if !s[0].area[0].ok { area_build(s); }
  n := 0; looked := 0;
  for row: area_row(y - r)..<area_row(y + r) + 1 {
    for col: area_col(x - r)..<area_col(x + r) + 1 {
      i := s[0].area[0].head[row * COLS + col];
      while i >= 0 {
        looked += 1;
        dx := s[0].area[0].x[i] - x; dy := s[0].area[0].y[i] - y;
        if s[0].beasts[i].live && dx * dx + dy * dy <= r * r && n < len(out) { out[n] = i; n += 1; }
        i = s[0].area[0].next[i];
      }
    }
  }
  s[0].area[0].looked = looked;
  sort_ints(out[0..<n]);
  return n;
}
// Live beasts within half_w tiles of the segment a-b (a line spell), in index order.
area_line :: (s: [] Stair, ax: f32, ay: f32, bx: f32, by: f32, half_w: f32, out: [] int) -> int {
  if !s[0].area[0].ok { area_build(s); }
  n := 0; looked := 0;
  lx := bx - ax; ly := by - ay;
  ll := hi(lx * lx + ly * ly, 0.000001);
  for row: area_row(lo(ay, by) - half_w)..<area_row(hi(ay, by) + half_w) + 1 {
    for col: area_col(lo(ax, bx) - half_w)..<area_col(hi(ax, bx) + half_w) + 1 {
      // a tile the line's band doesn't touch is skipped without looking in it
      cx := f32(col) + 0.5; cy := f32(row) + 0.5;
      ct := clamp(((cx - ax) * lx + (cy - ay) * ly) / ll, 0, 1);
      ex := ax + lx * ct - cx; ey := ay + ly * ct - cy;
      reach := half_w + 0.7072;
      if ex * ex + ey * ey > reach * reach { continue; }
      i := s[0].area[0].head[row * COLS + col];
      while i >= 0 {
        looked += 1;
        px := s[0].area[0].x[i]; py := s[0].area[0].y[i];
        t := clamp(((px - ax) * lx + (py - ay) * ly) / ll, 0, 1);
        qx := ax + lx * t - px; qy := ay + ly * t - py;
        if s[0].beasts[i].live && qx * qx + qy * qy <= half_w * half_w && n < len(out) { out[n] = i; n += 1; }
        i = s[0].area[0].next[i];
      }
    }
  }
  s[0].area[0].looked = looked;
  sort_ints(out[0..<n]);
  return n;
}
sort_ints :: (a: [] int) {
  for i: 1..<len(a) {
    v := a[i]; j := i - 1;
    while j >= 0 && a[j] > v { a[j + 1] = a[j]; j -= 1; }
    a[j + 1] = v;
  }
}
// Live beasts within r tiles of a beast.
crowd :: (s: [] Stair, t: int, r: f32) -> int {
  p := beast_xy(s, t);
  return area_sphere(s, p.x, p.y, r, s[0].area[0].hits[..]);
}

// One defender's turn.
take_turn :: (s: [] Stair, k: int) -> bool {
  d := s[0].party[k];
  c := cell_xy(d.cell);
  dice := s[0].dice[..];
  if d.cls == FIGHTER {
    if !fighter_attack(s, k) { return false; }
    if attacks_of(d) > 1 { ok := fighter_attack(s, k); }
    // Action Surge: once a wave, a second attack
    if s[0].party[k].surge {
      s[0].party[k].surge = false;
      ok := fighter_attack(s, k);
    }
    return true;
  }
  if d.cls == WIZARD {
    t := first_in_range(s, d.cell, s[0].ct[0].range[WIZARD], -1);
    if t < 0 { return false; }
    // Shatter, where three or more crowd together
    if d.slots2 > 0 && crowd(s, t, f32(SHATTER_RADIUS)) >= SHATTER_MIN {
      s[0].party[k].slots2 -= 1;
      at := beast_xy(s, t);
      record(s, k, 0, 0, dc_of(s, k, SHATTER_DC), true, false, 3, at);
      add_fx(s, FX_SHATTER, at.x, at.y, c.x, c.y, 0.6, 0, 0.75, 0.8, 1.0, false);
      dmg := srd_sum(dice, 3, 8);
      total := 0;
      nh := area_sphere(s, at.x, at.y, f32(SHATTER_RADIUS), s[0].area[0].hits[..]);
      for j: 0..<nh {
        i := s[0].area[0].hits[j];   // hurting a beast queries nothing, so the list holds
        if !s[0].beasts[i].live { continue; }
        sv := srd_save(dice, s[0].ct[0].con[s[0].beasts[i].kind], dc_of(s, k, SHATTER_DC));
        took := ifx sv.success then dmg / 2 else dmg;
        total += took;
        hurt_beast(s, i, took, DMG_THUNDER, false, k);
      }
      s[0].party[k].dealt = total;
      return true;
    }
    // an ember is immune to fire: Magic Missile while a slot lasts, else Fire Bolt at what isn't an ember
    if s[0].beasts[t].kind == EMBER {
      if d.slots > 0 {
        s[0].party[k].slots -= 1;
        p := beast_xy(s, t);
        record(s, k, 0, 0, 0, true, false, 2, p);
        total := 0;
        for dart: 0..<3 {
          if !s[0].beasts[t].live { t = first_in_range(s, d.cell, s[0].ct[0].range[WIZARD], -1); if t < 0 { break; } }
          q := beast_xy(s, t);
          add_fx(s, FX_DART, c.x, c.y, q.x, q.y, 0.45, 0, 0.75, 0.6, 1.0, false);
          dmg := srd_roll(dice, 4) + 1; total += dmg;
          hurt_beast(s, t, dmg, DMG_FORCE, false, k);
        }
        s[0].party[k].dealt = total;
        return true;
      }
      other := first_in_range(s, d.cell, s[0].ct[0].range[WIZARD], EMBER);
      if other >= 0 { t = other; }
    }
    b := s[0].beasts[t]; p := beast_xy(s, t);
    bolt := STAIR_FIRE_BOLT;
    if d.level >= 5 { bolt.dice = 2; }
    a := stair_attack(s, k, bolt, s[0].ct[0].ac[b.kind], 20);
    record(s, k, a.roll, a.total, s[0].ct[0].ac[b.kind], a.hit, a.crit, 0, p);
    add_fx(s, FX_BOLT, c.x, c.y, p.x, p.y, 0.4, 0, 1.0, 0.3, 0.15, a.crit);
    if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
    if a.hit { hurt_beast(s, t, a.damage, DMG_FIRE, a.crit, k); }
    else if d.level >= 3 {
      // Potent Cantrip: a miss still burns, for half
      half := srd_sum(dice, bolt.dice, 10) / 2;
      s[0].party[k].dealt = half;
      add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false);
      if half > 0 { hurt_beast(s, t, half, DMG_FIRE, false, k); }
    } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
    return true;
  }
  if d.cls == ROGUE {
    t := first_in_range(s, d.cell, s[0].ct[0].range[ROGUE], -1);
    if t < 0 { return false; }
    sneak := ifx ally_near(s, k, t) then (ifx d.level >= 5 then 3 else ifx d.level >= 3 then 2 else 1) else 0;
    a := weapon_hit(s, k, STAIR_ROGUE, t, sneak, FX_SLASH);
    s[0].party[k].how = ifx sneak > 0 then 4 else 0;
    return true;
  }
  if d.cls == RANGER {
    if !ranger_shot(s, k) { return false; }
    if d.level >= 3 { ok := ranger_shot(s, k); }
    if d.level >= 5 { ok := ranger_shot(s, k); }
    return true;
  }
  if d.cls == PALADIN {
    if first_in_range(s, d.cell, s[0].ct[0].range[PALADIN], -1) < 0 { return false; }
    for sw: 0..<attacks_of(d) {
    t := first_in_range(s, d.cell, s[0].ct[0].range[PALADIN], -1);
    if t < 0 { break; }
    b := s[0].beasts[t]; p := beast_xy(s, t);
    a := stair_attack(s, k, STAIR_PALADIN, s[0].ct[0].ac[b.kind], 20);
    record(s, k, a.roll, a.total, s[0].ct[0].ac[b.kind], a.hit, a.crit, 0, p);
    add_fx(s, FX_SLASH, c.x, c.y, p.x, p.y, 0.26, 0, 0.95, 0.95, 1.0, a.crit);
    if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
    if a.hit {
      dmg := a.damage;
      // Divine Smite: radiant on the first hit of the wave
      if s[0].party[k].smite { s[0].party[k].smite = false; dmg += srd_sum(dice, ifx a.crit then 4 else 2, 8); s[0].party[k].how = 5; add_fx(s, FX_FLAME, p.x, p.y, c.x, c.y, 0.55, 0, 1.0, 0.95, 0.7, true); }
      s[0].party[k].dealt = dmg;
      hurt_beast(s, t, dmg, DMG_SLASHING, a.crit, k);
    } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
    }
    return true;
  }
  if d.cls == BARD {
    t := first_in_range(s, d.cell, s[0].ct[0].range[BARD], -1);
    if t < 0 { return false; }
    b := s[0].beasts[t]; p := beast_xy(s, t);
    sv := srd_save(dice, 0, dc_of(s, k, MOCKERY_DC));
    record(s, k, sv.roll, sv.total, dc_of(s, k, MOCKERY_DC), !sv.success, false, 1, p);
    add_fx(s, FX_SPIRIT, p.x, p.y, c.x, c.y, 0.45, 0, CLASS_R[BARD], CLASS_G[BARD], CLASS_B[BARD], false);
    if !sv.success { hurt_beast(s, t, srd_sum(dice, ifx d.level >= 3 then 2 else 1, 6), DMG_PSYCHIC, false, k); } else { add_fx(s, FX_SAVED, p.x, p.y, 0, 0, 0.7, sv.roll, 0.8, 0.8, 0.85, false); }
    inspire(s, k, ifx d.level >= 3 then 3 else ifx d.level >= 2 then 2 else 1);
    return true;
  }
  // Cleric: Daylight first, once a wave, when a shadow it can't see is in its reach
  if !d.daylight {
    for i: 0..<BEASTS {
      if !s[0].beasts[i].live || s[0].beasts[i].kind != SHADOW || shadow_seen(s, i) { continue; }
      p := beast_xy(s, i);
      if (p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y) > s[0].ct[0].range[CLERIC] * s[0].ct[0].range[CLERIC] { continue; }
      s[0].party[k].daylight = true;
      record(s, k, 0, 0, 0, true, false, 6, p);
      add_fx(s, FX_LEVEL, c.x, c.y, 0, 0, 1.2, 0, 1.0, 0.95, 0.7, true);
      return true;
    }
  }
  // Sacred Flame, the target saves (Dexterity) against DC 13 or takes 1d8 radiant
  t := first_in_range(s, d.cell, s[0].ct[0].range[CLERIC], -1);
  if t < 0 { return false; }
  b := s[0].beasts[t]; p := beast_xy(s, t);
  sv := srd_save(dice, s[0].ct[0].dex[b.kind], dc_of(s, k, SACRED_DC));
  record(s, k, sv.roll, sv.total, dc_of(s, k, SACRED_DC), !sv.success, false, 1, p);
  add_fx(s, FX_FLAME, p.x, p.y, c.x, c.y, 0.55, 0, 1.0, 0.92, 0.55, false);
  if !sv.success { hurt_beast(s, t, srd_sum(dice, ifx d.level >= 5 then 2 else 1, 8), DMG_RADIANT, false, k); } else { add_fx(s, FX_SAVED, p.x, p.y, 0, 0, 0.7, sv.roll, 0.8, 0.8, 0.85, false); }
  // Spiritual Weapon: a spectral mace strikes too
  if d.level >= 3 {
    w := first_in_range(s, d.cell, s[0].ct[0].range[CLERIC], -1);
    if w >= 0 {
      q := beast_xy(s, w);
      a := srd_attack(dice, STAIR_SPIRIT, s[0].ct[0].ac[s[0].beasts[w].kind]);
      add_fx(s, FX_SPIRIT, q.x, q.y, c.x, c.y, 0.4, 0, 1.0, 0.9, 0.5, a.crit);
      if a.hit { hurt_beast(s, w, a.damage, DMG_FORCE, a.crit, k); } else { add_fx(s, FX_MISS, q.x, q.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
    }
  }
  return true;
}
// Bardic Inspiration to the n nearest of the party in the bard's reach without a die waiting.
inspire :: (s: [] Stair, k: int, n: int) {
  c := cell_xy(s[0].party[k].cell);
  r := s[0].ct[0].range[BARD];
  for m: 0..<n {
    best := -1; bd := 0.0f32;
    for i: 0..<DEFENDERS {
      d := s[0].party[i];
      if i == k || !d.live || d.inspired > 0 { continue; }
      e := cell_xy(d.cell);
      dd := (e.x - c.x) * (e.x - c.x) + (e.y - c.y) * (e.y - c.y);
      if dd <= r * r && (best < 0 || dd < bd) { best = i; bd = dd; }
    }
    if best < 0 { return; }
    s[0].party[best].inspired = ifx s[0].party[k].level >= 5 then 8 else 6;
    e := cell_xy(s[0].party[best].cell);
    add_fx(s, FX_LEVEL, e.x, e.y, 0, 0, 0.6, 0, CLASS_R[BARD], CLASS_G[BARD], CLASS_B[BARD], false);
  }
}
record :: (s: [] Stair, k: int, roll: int, total: int, vs: int, hit: bool, crit: bool, how: int, at: P2) {
  s[0].party[k].roll = roll; s[0].party[k].total = total; s[0].party[k].vs = vs;
  s[0].party[k].hit = hit; s[0].party[k].crit = crit; s[0].party[k].how = how; s[0].party[k].dealt = 0;
  if hit { s[0].party[k].hits += 1; } else { s[0].party[k].misses += 1; }
  c := cell_xy(s[0].party[k].cell);
  s[0].party[k].aim = atan2_f(at.y - c.y, at.x - c.x);
  s[0].party[k].flash = 1;
}
atan2_f :: (y: f32, x: f32) -> f32 {
  // enough for which way a defender faces
  if abs(x) < 0.0001 && abs(y) < 0.0001 { return 0; }
  a := 0.0f32;
  if abs(x) >= abs(y) { z := y / x; a = z / (1 + 0.28 * z * z); if x < 0 { a += ifx y >= 0 then 3.14159265 else -3.14159265; } }
  else { z := x / y; a = 1.5707963 - z / (1 + 0.28 * z * z); if y < 0 { a -= 3.14159265; } }
  return a;
}

wave_groups_done :: (s: [] Stair) -> bool {
  w := s[0].wave - 1;
  for g: 0..<GROUPS { if s[0].ct[0].kind[w * GROUPS + g] >= 0 && s[0].spawned[g] < s[0].ct[0].count[w * GROUPS + g] { return false; } }
  return true;
}

start_wave :: (s: [] Stair) -> bool {
  if s[0].phase != BUILD || s[0].wave >= waves_of(s) { return false; }
  s[0].wave += 1; s[0].phase = FIGHT; s[0].wave_t = 0; s[0].banner = 1.6;
  for g: 0..<GROUPS { s[0].spawned[g] = 0; s[0].spawn_t[g] = s[0].ct[0].delay[(s[0].wave - 1) * GROUPS + g]; }
  for i: 0..<DEFENDERS { refresh(s, i); }
  s[0].placed_round = 0;
  if round_allowance(s, s[0].wave) > round_allowance(s, s[0].wave - 1) {
    buf: [48] u8;
    n := put(buf[..], 0, "NOW "); n = put_int(buf[..], n, round_allowance(s, s[0].wave)); n = put(buf[..], n, " DEFENDERS A ROUND");
    say(s, cast(string) buf[0..<n]);
  }
  return true;
}
// Defenders allowed in the round that a wave opens (wave 0 is the build before the first).
round_allowance :: (s: [] Stair, wave: int) -> int { return s[0].ct[0].round_base + hi_i(wave, 0) / s[0].ct[0].round_every; }
round_left :: (s: [] Stair) -> int { return hi_i(round_allowance(s, s[0].wave) - s[0].placed_round, 0); }

step :: (s: [] Stair, dt: f32) {
  for i: 0..<FX { if s[0].fx[i].life > 0 { s[0].fx[i].t += dt; if s[0].fx[i].t >= s[0].fx[i].life { s[0].fx[i].life = 0; } } }
  s[0].hurt = hi(0, s[0].hurt - dt * 1.5);
  s[0].banner = hi(0, s[0].banner - dt);
  for i: 0..<DEFENDERS { if s[0].party[i].live { s[0].party[i].flash = hi(0, s[0].party[i].flash - dt * 4); } }
  if s[0].phase != FIGHT { return; }
  w := s[0].wave - 1;
  s[0].wave_t += dt;
  // spawns at the cellar door
  for g: 0..<GROUPS {
    kind := s[0].ct[0].kind[w * GROUPS + g];
    if kind < 0 || s[0].spawned[g] >= s[0].ct[0].count[w * GROUPS + g] { continue; }
    s[0].spawn_t[g] -= dt;
    if s[0].spawn_t[g] <= 0 {
      j := spawn(s, kind, 0);
      s[0].spawned[g] += 1;
      s[0].spawn_t[g] += s[0].ct[0].gap[w * GROUPS + g];
    }
  }
  // the climb
  walls_tick(s, dt);
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live { continue; }
    from := s[0].beasts[i].d;
    s[0].beasts[i].d += s[0].ct[0].speed[s[0].beasts[i].kind] * dt * (ifx s[0].slow_t > 0 then 0.5f32 else 1.0f32);
    wall_step(s, i, from, dt);
    if !s[0].beasts[i].live { continue; }
    s[0].beasts[i].wob += dt * 3;
    s[0].beasts[i].age += dt;
    regen(s, i, dt);
    if s[0].beasts[i].d >= beast_len(s, i) && s[0].swarm { s[0].beasts[i].d -= beast_len(s, i); continue; }
    if s[0].beasts[i].d >= beast_len(s, i) {
      s[0].beasts[i].live = false;
      s[0].lives -= s[0].ct[0].lives[s[0].beasts[i].kind];
      s[0].leaked += 1;
      s[0].hurt = 1;
    }
  }
  s[0].area[0].ok = false;
  if s[0].swarm { for j: live_beasts(s)..<SWARM { b := spawn(s, j % 4, srd_unit(s[0].dice[..]) * s[0].path_len); } }
  if s[0].lives <= 0 {
    s[0].lives = 0; s[0].phase = LOST; s[0].selected = -1; s[0].card = -1;
    for i: 0..<BEASTS { s[0].beasts[i].live = false; }
    return;
  }
  // the party's turns, in the order they were placed
  for k: 0..<DEFENDERS {
    if !s[0].party[k].live { continue; }
    s[0].party[k].wait -= dt;
    if s[0].party[k].wait <= 0 {
      if take_turn(s, k) { s[0].party[k].wait += turn_of(s, k); } else { s[0].party[k].wait = 0; }
    }
  }
  if wave_groups_done(s) && live_beasts(s) == 0 {
    bonus := 30 + lo_i(s[0].wave, BONUS_TOP) * 8;   // the wave bonus stops growing at wave BONUS_TOP
    // Preserve Life: a Life cleric gives the tower lives back (one channel a wave, however many clerics)
    life := false;
    for q: 0..<DEFENDERS { if s[0].party[q].live && s[0].party[q].cls == CLERIC && s[0].party[q].level >= 3 { life = true; } }
    if life { s[0].lives = lo_i(s[0].lives + LIFE_RESTORE, s[0].ct[0].start_lives); }
    s[0].gold += bonus;
    if s[0].wave >= waves_of(s) { s[0].phase = WON; s[0].selected = -1; s[0].card = -1; return; }
    s[0].phase = BUILD;
    buf: [48] u8;
    n := put(buf[..], 0, "WAVE "); n = put_int(buf[..], n, s[0].wave); n = put(buf[..], n, " HELD · +"); n = put_int(buf[..], n, bonus); n = put(buf[..], n, " GOLD");
    say(s, cast(string) buf[0..<n]);
  }
}

place :: (s: [] Stair, cell: int, cls: int) -> bool {
  if !free_cell(s, cell) || s[0].gold < s[0].ct[0].cost[cls] || s[0].phase == WON || s[0].phase == LOST || round_left(s) <= 0 { return false; }
  for i: 0..<DEFENDERS {
    if !s[0].party[i].live {
      d: Defender;
      d.live = true; d.cls = cls; d.cell = cell; d.slots = MM_SLOTS; d.level = 1;
      // initiative: a d20 sets where in the round its first turn falls
      d.wait = f32(srd_roll(s[0].dice[..], 20)) / 20 * s[0].ct[0].turn[cls];
      d.roll = -1;
      if cls == RANGER { d.fav = strongest_next(s); }
      s[0].party[i] = d;
      s[0].gold -= s[0].ct[0].cost[cls];
      s[0].placed += 1; s[0].placed_round += 1;
      lay_cells(s);
      track_tally(s[0].track[..], "place", CLASS_NAME[cls]);
      return true;
    }
  }
  return false;
}
// What a defender has cost, levels and all.
spent :: (s: [] Stair, k: int) -> int {
  d := s[0].party[k];
  n := s[0].ct[0].cost[d.cls];
  for lv: 1..<d.level { n += up_cost(s, d.cls, lv); }
  return n;
}
// A level up: it costs gold, not a place in the round; the new level's slots come at once.
upgrade :: (s: [] Stair, k: int) -> bool {
  if k < 0 || !s[0].party[k].live || s[0].phase == WON || s[0].phase == LOST { return false; }
  d := s[0].party[k];
  if d.level >= MAX_LEVEL || s[0].gold < up_cost(s, d.cls, d.level) { return false; }
  s[0].gold -= up_cost(s, d.cls, d.level);
  s[0].party[k].level += 1;
  lv := s[0].party[k].level;
  if lv == 2 { s[0].party[k].slots += 1; s[0].party[k].surge = true; s[0].party[k].smite = d.cls == PALADIN; }
  if lv == 3 { s[0].party[k].slots2 = SHATTER_SLOTS; }
  c := cell_xy(d.cell);
  add_fx(s, FX_LEVEL, c.x, c.y, 0, 0, 0.9, lv, CLASS_R[d.cls], CLASS_G[d.cls], CLASS_B[d.cls], false);
  track_tally(s[0].track[..], "upgrade", CLASS_NAME[d.cls]);
  return true;
}
sell :: (s: [] Stair, k: int) {
  if k < 0 || !s[0].party[k].live { return; }
  s[0].gold += spent(s, k) * 7 / 10;
  s[0].party[k].live = false;
  s[0].placed_round = hi_i(s[0].placed_round - 1, 0);   // a sold defender gives its place in the round back
  lay_cells(s);
}

// ---- layout

layout :: (s: [] Stair, w: f32, h: f32, k: f32) {
  s[0].portrait = h > w * 1.1;
  top := ifx s[0].portrait then 92 * k else 52 * k;   // a phone's spells sit in a row under the top bar
  bottom := ifx s[0].portrait then 216 * k else 118 * k;
  if s[0].card_shot { top = 0; bottom = 0; }   // no HUD: the stair fills the shot
  s[0].scols = ifx s[0].portrait then ROWS else COLS;
  s[0].srows = ifx s[0].portrait then COLS else ROWS;
  aw := w - 24 * k; ah := h - top - bottom - 16 * k;
  // the map, the back wall above it and the rim round it
  rows := f32(s[0].srows) + f32(WALL_ROWS) + f32(RIM_TILES);
  t := lo(aw / (f32(s[0].scols) + 2 * f32(RIM_TILES)), ah / (rows * f32(SQUASH)));
  t = hi(t, 8);
  s[0].bt = t;
  s[0].bx = (w - t * f32(s[0].scols)) / 2;
  s[0].by = top + 8 * k + (ah - t * f32(SQUASH) * rows) / 2 + f32(WALL_ROWS) * t * f32(SQUASH);
  // the camera: the fitted map is zoom 1; in closer, the map point (fu, fv) sits at the fitted
  // map's middle, kept so the map always covers the space it had
  sq := f32(SQUASH);
  x0 := s[0].bx - f32(RIM_TILES) * t; x1 := s[0].bx + (f32(s[0].scols) + f32(RIM_TILES)) * t;
  y0 := s[0].by - f32(WALL_ROWS) * t * sq; y1 := s[0].by + (f32(s[0].srows) + f32(RIM_TILES)) * t * sq;
  s[0].acx = (x0 + x1) / 2; s[0].acy = (y0 + y1) / 2;
  s[0].clip_y0 = y0; s[0].clip_y1 = y1;
  fu0 := (s[0].acx - s[0].bx) / t; fv0 := (s[0].acy - s[0].by) / (t * sq);
  z := clamp(s[0].zoom, 1, f32(ZOOM_MAX));
  if s[0].card_shot || s[0].golden { z = 1; }
  if z <= 1.001 { z = 1; s[0].fu = fu0; s[0].fv = fv0; }
  s[0].zoom = z;
  hu := (x1 - x0) / t / 2; hv := (y1 - y0) / (t * sq) / 2;
  s[0].fu = clamp(s[0].fu, fu0 - hu * (1 - 1 / z), fu0 + hu * (1 - 1 / z));
  s[0].fv = clamp(s[0].fv, fv0 - hv * (1 - 1 / z), fv0 + hv * (1 - 1 / z));
  s[0].tile = t * z;
  s[0].ox = s[0].acx - s[0].fu * s[0].tile;
  s[0].oy = s[0].acy - s[0].fv * s[0].tile * sq;
}
// Zoom by g about a screen point, keeping the map point under it there.
zoom_about :: (s: [] Stair, g: f32, x: f32, y: f32) {
  if s[0].tile <= 0 || s[0].bt <= 0 { return; }
  sq := f32(SQUASH);
  mu := (x - s[0].ox) / s[0].tile; mv := (y - s[0].oy) / (s[0].tile * sq);
  z := clamp(s[0].zoom * g, 1, f32(ZOOM_MAX));
  t := s[0].bt * z;
  s[0].zoom = z;
  s[0].fu = (s[0].acx - (x - mu * t)) / t;
  s[0].fv = (s[0].acy - (y - mv * t * sq)) / (t * sq);
}
// Drag the map by (dx, dy) pixels.
pan_by :: (s: [] Stair, dx: f32, dy: f32) {
  if s[0].tile <= 0 { return; }
  s[0].fu -= dx / s[0].tile;
  s[0].fv -= dy / (s[0].tile * f32(SQUASH));
}
// Logical (column, row) tile units to the screen.
to_screen :: (s: [] Stair, x: f32, y: f32) -> P2 {
  sx := x; sy := y;
  if s[0].portrait { sx = y; sy = f32(COLS) - x; }
  return P2.{x = s[0].ox + sx * s[0].tile, y = s[0].oy + sy * s[0].tile * f32(SQUASH)};
}
cell_at :: (s: [] Stair, x: f32, y: f32) -> int {
  if s[0].tile <= 0 { return -1; }
  if y < s[0].clip_y0 || y > s[0].clip_y1 { return -1; }   // under the HUD
  fx := (x - s[0].ox) / s[0].tile; fy := (y - s[0].oy) / (s[0].tile * f32(SQUASH));
  if fx < 0 || fy < 0 || fx >= f32(s[0].scols) || fy >= f32(s[0].srows) { return -1; }
  sc := cast(int) floor(fx); sr := cast(int) floor(fy);
  if s[0].portrait { return cell_of(COLS - 1 - sr, sc); }
  return cell_of(sc, sr);
}

set_button :: (s: [] Stair, b: int, r: Rect, on: bool) { s[0].boxes[b] = r; s[0].shown[b] = true; s[0].enabled[b] = on; }
buttons :: (s: [] Stair, w: f32, h: f32, k: f32) {
  for b: 0..<BUTTONS { s[0].shown[b] = false; }
  over := s[0].phase == WON || s[0].phase == LOST;
  set_button(s, B_GALAXY, Rect.{x0 = 10 * k, y0 = 10 * k, x1 = (ifx s[0].portrait then 78 * k else 96 * k), y1 = 42 * k}, true);
  // the map, chosen before the first wave (a new map starts the game over)
  if s[0].phase == BUILD && s[0].wave == 0 && !s[0].card_shot {
    mw := ifx s[0].portrait then 92 * k else 260 * k;
    set_button(s, B_MAP, Rect.{x0 = w - mw - 10 * k, y0 = 10 * k, x1 = w - 10 * k, y1 = 42 * k}, true);
  } else if !over {
    // your spells, top right
    // (on a phone, a row of their own under the top bar)
    sw := ifx s[0].portrait then (w - 28 * k - 16 * k) / 3 else 96 * k;
    for i: 0..<YOUR_SPELLS {
      x1 := w - (ifx s[0].portrait then 14 * k else 10 * k) - f32(YOUR_SPELLS - 1 - i) * (sw + (ifx s[0].portrait then 8 * k else 4 * k));
      y0 := ifx s[0].portrait then 50 * k else 10 * k;
      set_button(s, B_STONE + i, Rect.{x0 = x1 - sw, y0 = y0, x1 = x1, y1 = y0 + 32 * k}, spell_ready(s, i) && !(i == SPELL_SLOW && s[0].slow_t > 0));
    }
  }
  if over {
    cx := w / 2; cy := h / 2;
    bw := lo(140 * k, w / 2 - 30 * k);
    set_button(s, B_AGAIN, Rect.{x0 = cx - bw - 10 * k, y0 = cy + 30 * k, x1 = cx - 10 * k, y1 = cy + 74 * k}, true);
    set_button(s, B_GALAXY, Rect.{x0 = cx + 10 * k, y0 = cy + 30 * k, x1 = cx + bw + 10 * k, y1 = cy + 74 * k}, true);
    return;
  }
  bh := 46 * k;
  if s[0].portrait {
    y1 := h - 14 * k; y0 := y1 - bh;
    set_button(s, B_START, Rect.{x0 = 14 * k, y0 = y0, x1 = w - 178 * k, y1 = y1}, s[0].phase == BUILD);
    set_button(s, B_PAUSE, Rect.{x0 = w - 168 * k, y0 = y0, x1 = w - 96 * k, y1 = y1}, true);
    set_button(s, B_FAST, Rect.{x0 = w - 86 * k, y0 = y0, x1 = w - 14 * k, y1 = y1}, true);
    ry1 := y0 - 12 * k; ry0 := ry1 - bh - 18 * k;
    if s[0].card < 0 {
      // the seven classes in two rows: four, then three
      rh := 44 * k;
      for c: 0..<CLASSES {
        row := ifx c < 4 then 0 else 1;
        per := ifx row == 0 then 4 else 3;
        col := ifx row == 0 then c else c - 4;
        bw := (w - 28 * k - f32(per - 1) * 8 * k) / f32(per);
        x0 := 14 * k + f32(col) * (bw + 8 * k);
        yb := ry1 - f32(1 - row) * (rh + 8 * k);
        set_button(s, B_FIGHTER + c, Rect.{x0 = x0, y0 = yb - rh, x1 = x0 + bw, y1 = yb}, can_pick(s, c));
      }
    }
    if s[0].card >= 0 {
      if s[0].party[s[0].card].level < MAX_LEVEL { set_button(s, B_UPGRADE, Rect.{x0 = w - 134 * k, y0 = ry1 - 78 * k, x1 = w - 14 * k, y1 = ry1 - 44 * k}, can_upgrade(s)); }
      set_button(s, B_SELL, Rect.{x0 = w - 134 * k, y0 = ry1 - 34 * k, x1 = w - 14 * k, y1 = ry1}, true);
    }
    return;
  }
  y1 := h - 22 * k; y0 := y1 - bh - 8 * k;
  set_button(s, B_START, Rect.{x0 = w - 386 * k, y0 = y0, x1 = w - 196 * k, y1 = y1}, s[0].phase == BUILD);
  set_button(s, B_PAUSE, Rect.{x0 = w - 186 * k, y0 = y0, x1 = w - 110 * k, y1 = y1}, true);
  set_button(s, B_FAST, Rect.{x0 = w - 100 * k, y0 = y0, x1 = w - 24 * k, y1 = y1}, true);
  if s[0].card < 0 {
    bw := lo(170 * k, (w - 420 * k - f32(CLASSES - 1) * 10 * k) / f32(CLASSES));
    for c: 0..<CLASSES {
      x0 := 24 * k + f32(c) * (bw + 10 * k);
      set_button(s, B_FIGHTER + c, Rect.{x0 = x0, y0 = y0, x1 = x0 + bw, y1 = y1}, can_pick(s, c));
    }
  }
  if s[0].card >= 0 {
    set_button(s, B_SELL, Rect.{x0 = w - 500 * k, y0 = y0, x1 = w - 396 * k, y1 = y1}, true);
    if s[0].party[s[0].card].level < MAX_LEVEL { set_button(s, B_UPGRADE, Rect.{x0 = w - 700 * k, y0 = y0, x1 = w - 510 * k, y1 = y1}, can_upgrade(s)); }
  }
}
can_upgrade :: (s: [] Stair) -> bool {
  k := s[0].card;
  if k < 0 || !s[0].party[k].live || s[0].party[k].level >= MAX_LEVEL { return false; }
  return s[0].gold >= up_cost(s, s[0].party[k].cls, s[0].party[k].level);
}
can_pick :: (s: [] Stair, c: int) -> bool { return s[0].gold >= s[0].ct[0].cost[c] && round_left(s) > 0; }
button_at :: (s: [] Stair, x: f32, y: f32) -> int {
  for b: 0..<BUTTONS { if s[0].shown[b] && in_rect(s[0].boxes[b], x, y) { return b; } }
  return -1;
}

press :: (s: [] Stair, b: int) {
  if !s[0].enabled[b] { return; }
  if b == B_START { if start_wave(s) { s[0].selected = -1; s[0].card = -1; } return; }
  if b == B_FAST { s[0].speed = ifx s[0].speed >= 3 then 1 else s[0].speed + 1; return; }
  if b == B_PAUSE { s[0].paused = !s[0].paused; return; }
  if b == B_GALAXY { leave_to(s, "/verse/galaxy"); return; }
  if b == B_MAP { set_map(s, s[0].map + 1); return; }
  if b == B_AGAIN { stair_reset(s); s[0].tracked_wave = 0; return; }
  if b == B_SELL { sell(s, s[0].card); s[0].card = -1; s[0].selected = -1; return; }
  if b == B_UPGRADE { ok := upgrade(s, s[0].card); return; }
  if b >= B_FIGHTER && b <= B_LAST_CLASS { s[0].spell_pick = -1; pick(s, b - B_FIGHTER); return; }
  if b >= B_STONE && b <= B_SLOW { spell_press(s, b - B_STONE); return; }
}
leave_to :: (s: [] Stair, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}

tap_cell :: (s: [] Stair, cell: int) {
  if s[0].phase == WON || s[0].phase == LOST { return; }
  if s[0].spell_pick >= 0 { ok := cast_wall(s, cell); return; }
  d := defender_at(s, cell);
  if d >= 0 { s[0].card = ifx s[0].card == d then -1 else d; s[0].selected = -1; return; }
  s[0].card = -1;
  if !free_cell(s, cell) { s[0].selected = -1; return; }
  if s[0].pick < 0 { s[0].selected = -1; say(s, "PICK A DEFENDER FIRST"); return; }
  // On a phone the first tap shows the defender's reach on that tile; the second places it.
  if s[0].touch && s[0].selected != cell { s[0].selected = cell; return; }
  drop(s, cell);
}
// Arm a class for placing (again to put it down).
pick :: (s: [] Stair, c: int) {
  if s[0].pick == c { s[0].pick = -1; s[0].selected = -1; return; }
  if round_left(s) <= 0 { say(s, "NO MORE DEFENDERS THIS ROUND"); return; }
  if s[0].gold < s[0].ct[0].cost[c] { say(s, "NOT ENOUGH GOLD"); return; }
  s[0].pick = c; s[0].card = -1;
}
drop :: (s: [] Stair, cell: int) {
  c := s[0].pick;
  if c < 0 { return; }
  if round_left(s) <= 0 { say(s, "NO MORE DEFENDERS THIS ROUND"); s[0].pick = -1; s[0].selected = -1; return; }
  if s[0].gold < s[0].ct[0].cost[c] { say(s, "NOT ENOUGH GOLD"); s[0].pick = -1; s[0].selected = -1; return; }
  if place(s, cell, c) {
    s[0].selected = -1;
    if !can_pick(s, c) { s[0].pick = -1; }
  }
}
// The tile whose reach shows: the one tapped on a phone, the one under the mouse otherwise.
aim_cell :: (s: [] Stair) -> int {
  if s[0].pick < 0 { return -1; }
  c := ifx s[0].touch then s[0].selected else s[0].hover;
  return ifx free_cell(s, c) then c else -1;
}

// ---- in from the host

stair_pointer :: (s: [] Stair, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  stair_start(s);
  if kind != 0 { s[0].touch = true; }
  if tip_pointer(s, x, y, phase, kind, id) { s[0].hover_b = -1; s[0].hover = -1; return true; }
  b := button_at(s, x, y);
  cell := cell_at(s, x, y);
  if kind == 0 && phase != 3 { s[0].hover_b = b; s[0].hover = cell; } else { s[0].hover_b = -1; s[0].hover = -1; }
  if camera_pointer(s, x, y, phase, kind, id, b) { return true; }
  if phase == 0 {
    track_pointer(s[0].track[..], x, y, phase, kind, "");
    if b >= 0 { s[0].press = b; s[0].press_id = id; return true; }
    s[0].down_on = true; s[0].down_t = s[0].clock; s[0].down_x = x; s[0].down_y = y; s[0].down_cell = cell; s[0].long_done = false;
    s[0].press_id = id;
    return cell >= 0;
  }
  if phase == 1 {
    if s[0].down_on {
      dx := x - s[0].down_x; dy := y - s[0].down_y;
      if dx * dx + dy * dy > 144 * s[0].dpr * s[0].dpr { s[0].down_on = false; }
    }
    return s[0].press >= 0 || s[0].down_on;
  }
  if phase == 2 || phase == 3 {
    if s[0].press >= 0 {
      if phase == 2 && b == s[0].press { press(s, b); }
      s[0].press = -1;
      return true;
    }
    if s[0].down_on {
      s[0].down_on = false;
      if phase == 2 && !s[0].long_done && cell == s[0].down_cell {
        if cell >= 0 { tap_cell(s, cell); return true; }
        s[0].selected = -1; s[0].card = -1; s[0].pick = -1;
      }
      return cell >= 0;
    }
  }
  return false;
}
// The camera's share of a pointer: two fingers pinch and pan (a tap or a press under way is
// dropped); one finger or the mouse dragging the map when zoomed in pans it. True when taken.
camera_pointer :: (s: [] Stair, x: f32, y: f32, phase: int, kind: int, id: int, b: int) -> bool {
  k := hi(s[0].dpr, 0.5);
  if kind != 0 {
    f := -1;
    for i: 0..<2 { if s[0].fingers[i].id == id { f = i; } }
    if phase == 0 && f < 0 {
      for i: 0..<2 { if f < 0 && s[0].fingers[i].id < 0 { f = i; s[0].fingers[i] = Finger.{id = id, x = x, y = y}; } }
      if s[0].fingers[0].id >= 0 && s[0].fingers[1].id >= 0 {
        ex := s[0].fingers[0].x - s[0].fingers[1].x; ey := s[0].fingers[0].y - s[0].fingers[1].y;
        s[0].pinch = sqrt(ex * ex + ey * ey);
        s[0].down_on = false; s[0].press = -1; s[0].selected = -1; s[0].pinched = true;
        return true;
      }
      s[0].panning = false;
      return false;
    }
    if f < 0 { return false; }
    both := s[0].fingers[0].id >= 0 && s[0].fingers[1].id >= 0;
    if phase == 1 {
      if both {
        mx0 := (s[0].fingers[0].x + s[0].fingers[1].x) / 2; my0 := (s[0].fingers[0].y + s[0].fingers[1].y) / 2;
        s[0].fingers[f].x = x; s[0].fingers[f].y = y;
        nx := (s[0].fingers[0].x + s[0].fingers[1].x) / 2; ny := (s[0].fingers[0].y + s[0].fingers[1].y) / 2;
        ex := s[0].fingers[0].x - s[0].fingers[1].x; ey := s[0].fingers[0].y - s[0].fingers[1].y;
        d := sqrt(ex * ex + ey * ey);
        layout(s, s[0].width, s[0].height, k);
        pan_by(s, nx - mx0, ny - my0);
        layout(s, s[0].width, s[0].height, k);
        if s[0].pinch > 1 && d > 1 { zoom_about(s, d / s[0].pinch, nx, ny); }
        s[0].pinch = d;
        return true;
      }
      px := s[0].fingers[f].x; py := s[0].fingers[f].y;
      s[0].fingers[f].x = x; s[0].fingers[f].y = y;
      if s[0].pinched { return true; }
      if s[0].zoom > 1.001 && s[0].press < 0 {
        ddx := x - s[0].down_x; ddy := y - s[0].down_y;
        if !s[0].panning && ddx * ddx + ddy * ddy > 144 * k * k { s[0].panning = true; s[0].down_on = false; pan_by(s, ddx, ddy); return true; }
        if s[0].panning { pan_by(s, x - px, y - py); return true; }
      }
      return false;
    }
    if phase == 2 || phase == 3 {
      s[0].fingers[f].id = -1;
      if s[0].pinched {   // a pinch's fingers lifting: no tap
        if s[0].fingers[0].id < 0 && s[0].fingers[1].id < 0 { s[0].pinched = false; }
        return true;
      }
      if s[0].panning { s[0].panning = false; return true; }
      return false;
    }
    return false;
  }
  // the mouse: a drag on the map pans when zoomed in
  if phase == 0 { s[0].mx = x; s[0].my = y; s[0].panning = false; return false; }
  if phase == 1 {
    px := s[0].mx; py := s[0].my; s[0].mx = x; s[0].my = y;
    if s[0].down_on || s[0].panning {
      ddx := x - s[0].down_x; ddy := y - s[0].down_y;
      if s[0].zoom > 1.001 && !s[0].panning && ddx * ddx + ddy * ddy > 64 * k * k { s[0].panning = true; s[0].down_on = false; pan_by(s, ddx, ddy); return true; }
      if s[0].panning { pan_by(s, x - px, y - py); return true; }
    }
    return false;
  }
  if s[0].panning { s[0].panning = false; return true; }
  return false;
}
// The wheel zooms about the mouse.
stair_wheel :: (s: [] Stair, dy: f32) -> bool #export_c {
  stair_start(s);
  if s[0].card_shot || s[0].tile <= 0 { return false; }
  if s[0].my < s[0].clip_y0 || s[0].my > s[0].clip_y1 { return false; }
  zoom_about(s, f32(exp(f64(-dy) * 0.0018)), s[0].mx, s[0].my);
  return true;
}

// A finger held still on a defender shows its card (the long-press).
long_press :: (s: [] Stair) {
  if !s[0].down_on || s[0].long_done || s[0].clock - s[0].down_t < LONG_PRESS { return; }
  d := defender_at(s, s[0].down_cell);
  if d < 0 { return; }
  s[0].long_done = true; s[0].card = d; s[0].selected = -1;
}

stair_key :: (s: [] Stair, key: int, mods: int) -> bool #export_c {
  stair_start(s);
  track_key(s[0].track[..], key, false);
  if key == KEY_ESCAPE { s[0].selected = -1; s[0].card = -1; s[0].pick = -1; return true; }
  if key == 'p' || key == 'P' { press(s, B_PAUSE); return true; }
  if key == KEY_ENTER || key == ' ' {
    if s[0].phase == WON || s[0].phase == LOST { stair_reset(s); return true; }
    ok := start_wave(s); if ok { s[0].selected = -1; s[0].card = -1; }
    return true;
  }
  if key >= '1' && key <= '7' { pick(s, key - '1'); return true; }
  if key == 'f' || key == 'F' { press(s, B_FAST); return true; }
  if (key == 'u' || key == 'U') && s[0].card >= 0 { ok := upgrade(s, s[0].card); return true; }
  return false;
}
stair_key_up :: (s: [] Stair, key: int, mods: int) -> bool #export_c { track_key_up(s[0].track[..], key); return false; }
stair_blur :: (s: [] Stair) #export_c { s[0].down_on = false; s[0].press = -1; track_blur(s[0].track[..]); }
stair_cursor :: (s: [] Stair) -> int #export_c {
  if s[0].hover_b >= 0 || s[0].tip_hover { return 1; }
  if s[0].hover >= 0 && (free_cell(s, s[0].hover) || defender_at(s, s[0].hover) >= 0) { return 1; }
  return 0;
}

stair_message :: (s: [] Stair, kind: int, t: string) #export_c {
  stair_start(s);
  if kind == HOST_PAGE {
    s[0].facts = true;
    url := fact_of(t, "url");
    sp := query_number(url, "speed");
    if sp >= 1 && sp <= 8 { s[0].speed = cast(int) sp; }
    g := query_number(url, "gold");
    if g >= 0 && g <= 99999 { s[0].gold = cast(int) g; }
    wv := query_number(url, "wave");
    if wv >= 1 && wv <= f32(waves_of(s)) { s[0].wave = cast(int) wv - 1; }
    if fact_of(t, "coarse") == "1" { s[0].touch = true; }
    mp := query_number(url, "map");
    if mp >= 1 && mp <= MAPS { set_map(s, cast(int) mp - 1); }
    sd := query_number(url, "seed");
    if sd >= 1 && sd <= 999999999 { s[0].seed = cast(u64) sd; stair_reset(s); }
    if query_is(url, "stage", "highlight") { stage_highlight(s); }
    if query_is(url, "stage", "swarm") { stage_highlight(s); s[0].swarm = true; }
    if query_is(url, "card", "1") { s[0].card_shot = true; }
  }
  if kind == MAKER_KIND { take_maker(s, t); }
  ok := track_message(s[0].track[..], kind, t);
  if kind == HOST_PAGE { track_world(s[0].track[..], "hold-the-stair"); }
}

// The maker's name, as sent (never read): up to MAKER_BYTES, not cutting a character.
take_maker :: (s: [] Stair, t: string) {
  n := lo_i(t.count, MAKER_BYTES);
  if n < t.count { while n > 0 && (t[n] & 0xC0) == 0x80 { n -= 1; } }
  for i: 0..<n { s[0].maker[i] = t[i]; }
  s[0].maker_n = n;
}

// A finger or the mouse on TIP (the maker's tip page): only TIP's own presses are taken.
tip_pointer :: (s: [] Stair, x: f32, y: f32, phase: int, kind: int, id: int) -> bool {
  on := s[0].tip_shown && in_rect(s[0].tip_box, x, y);
  if kind == 0 { s[0].tip_hover = on && phase != 3; }
  if phase == 0 && on { s[0].tip_down = true; s[0].tip_id = id; return true; }
  if !s[0].tip_down || id != s[0].tip_id { return false; }
  if phase == 1 { return true; }
  s[0].tip_down = false;
  if phase == 2 && on { leave_to(s, "/realms/hold-the-stair/tip"); }
  return true;
}
// ?KEY=VALUE in a page's URL, exactly.
query_is :: (url: string, key: string, value: string) -> bool {
  at := 0;
  while at + key.count + 1 + value.count <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1;
      after := i + value.count;
      return url[i..<after] == value && (after == url.count || url[after] == 38 || url[after] == 35);
    }
    at += 1;
  }
  return false;
}
// A staged moment for clips (?stage=highlight, docs/verse/clips.md): the last wave against
// a full party at level 3, the stair crowded and every class firing.
// The free tile beside the stair nearest a point part of the way up it.
// Some defender has a level the gold buys.
can_level :: (s: [] Stair) -> bool {
  for k: 0..<DEFENDERS {
    d := s[0].party[k];
    if d.live && d.level < MAX_LEVEL && up_cost(s, d.cls, d.level) <= s[0].gold { return true; }
  }
  return false;
}
spot_near :: (s: [] Stair, along: f32) -> int {
  best := -1; bd := 1000.0f32;
  m := path_at(s, s[0].path_len * along);
  for cell: 0..<CELLS {
    if !free_cell(s, cell) || !beside_path(s, cell) { continue; }
    c := cell_xy(cell);
    dd := (c.x - m.x) * (c.x - m.x) + (c.y - m.y) * (c.y - m.y);
    if dd < bd { bd = dd; best = cell; }
  }
  return best;
}
SWARM :: 500;
stage_highlight :: (s: [] Stair) {
  stair_reset(s);
  s[0].gold = 99999; s[0].wave = waves_of(s) - 1;
  for i: 0..<20 {
    s[0].placed_round = 0;
    spot := spot_near(s, 0.08 + 0.8 * f32(i) / 19);   // spread up the whole climb
    if spot < 0 || !place(s, spot, AI_CLASSES[i % 6]) { break; }
  }
  for k: 0..<DEFENDERS { while s[0].party[k].live && upgrade(s, k) {} }
  for i: 0..<FX { s[0].fx[i].life = 0; }
  s[0].gold = 1260; s[0].placed_round = 0;
  ok := start_wave(s);
  s[0].toast_t = 0;
}
stair_golden :: (s: [] Stair, on: bool) #export_c { s[0].golden = on; }
stair_action :: (s: [] Stair) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
stair_action_done :: (s: [] Stair) #export_c { s[0].out_n = 0; }

coaxial_stair_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_stair_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_stair_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- drawing

// A heart hr round from its left edge at x, its lobes' middles at y.
heart :: (out: [] f32, at: int, lx: f32, hy: f32, hr: f32) -> int {
  n := disc(out, at, lx + hr * 0.75, hy - hr * 0.35, hr, 1, hr * 0.6, 1.0, 0.3, 0.32);
  n = disc(out, n, lx + hr * 2.25, hy - hr * 0.35, hr, 1, hr * 0.6, 1.0, 0.3, 0.32);
  n = seg(out, n, lx + hr * 0.3, hy, lx + hr * 1.5, hy + hr * 1.35, hr * 0.62, 1, hr * 0.4, 1.0, 0.3, 0.32);
  return seg(out, n, lx + hr * 2.7, hy, lx + hr * 1.5, hy + hr * 1.35, hr * 0.62, 1, hr * 0.4, 1.0, 0.3, 0.32);
}
plate :: (s: [] Stair, u: [] f32, r: Rect, alpha: f32, style: f32) { plate_icon(s, u, r, alpha, style, -1); }
// A panel; icon: a class whose portrait stair.wgsl paints at its left (-1 none).
plate_icon :: (s: [] Stair, u: [] f32, r: Rect, alpha: f32, style: f32, icon: int) {
  if s[0].plate_n >= PLATES { return; }
  o := U_PLATE + s[0].plate_n * 8;
  u[o] = r.x0; u[o + 1] = r.y0; u[o + 2] = r.x1; u[o + 3] = r.y1;
  u[o + 4] = alpha; u[o + 5] = style; u[o + 6] = hi(s[0].dpr, 0.5); u[o + 7] = f32(icon + 1);
  s[0].plate_n += 1;
}

// The bubble-beasts: glossy see-through bubbles with the layer inside showing, glowing eyes and a
// grin, looking the way they climb; embers burn at the crown, glimmers throw sparkles, wisps trail.
draw_beasts :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  for i: 0..<BEASTS {
    b := s[0].beasts[i];
    if !b.live { continue; }
    p := path_at(s, b.d);
    q := to_screen(s, p.x, p.y);
    ahead := to_screen(s, path_at(s, b.d + 0.2).x, path_at(s, b.d + 0.2).y);
    lx := ahead.x - q.x; ly := ahead.y - q.y;
    ll := hi(sqrt(lx * lx + ly * ly), 0.001); lx /= ll; ly /= ll;
    bob := sin(b.wob) * t * 0.04;
    // out of its outer skin (or the cellar door) with a bounce
    grow := clamp01(b.age / 0.28);
    pop := 1 - (1 - grow) * (1 - grow) * (1 - grow) + 0.22 * sin(grow * 3.14159);
    rad := s[0].ct[0].size[b.kind] * t * (0.35 + 0.65 * pop);
    y := q.y - t * 0.24 + bob;
    r := s[0].ct[0].red[b.kind]; g := s[0].ct[0].green[b.kind]; bl := s[0].ct[0].blue[b.kind];
    // a bubble a little squashed and stretched as it bobs
    inner := s[0].ct[0].inner_a[b.kind];
    share := ifx inner >= 0 then 0.5f32 else 0.0f32;
    ir := 0.0f32; ig := 0.0f32; ib := 0.0f32;
    if inner >= 0 { ir = s[0].ct[0].red[inner]; ig = s[0].ct[0].green[inner]; ib = s[0].ct[0].blue[inner]; }
    // a shadow no one can see is only a smudge
    n = bubble(out, n, q.x, y, rad, ifx b.kind == SHADOW && !shadow_seen(s, i) then 0.3f32 else 1.0f32, r, g, bl, share, ir, ig, ib);
    // the face: two glowing eyes (one on a mote), a grin; a blink now and then
    ex := q.x + lx * rad * 0.2; ey := y - rad * 0.05 + ly * rad * 0.12;
    bw := b.wob * 0.11 + f32(i) * 0.37;
    blink := bw - floor(bw) > 0.94;
    hh := ifx blink then rad * 0.01 else rad * 0.07;
    ew := hi(0.9, rad * 0.12);
    if b.kind == MOTE {
      n = seg(out, n, ex, ey - hh, ex, ey + hh, ew * 1.2, 1.0, ew * 2, 1, 1, 1);
    } else {
      sp := rad * 0.27;
      n = seg(out, n, ex - sp, ey - hh, ex - sp, ey + hh, ew, 1.0, ew * 2, 1, 1, 1);
      n = seg(out, n, ex + sp, ey - hh, ex + sp, ey + hh, ew, 1.0, ew * 2, 1, 1, 1);
      mw := hi(0.6, rad * 0.045);
      my := ey + rad * 0.3;
      n = seg(out, n, ex - rad * 0.16, my - rad * 0.05, ex, my + rad * 0.03, mw, 0.85, mw * 2, 1, 1, 1);
      n = seg(out, n, ex, my + rad * 0.03, ex + rad * 0.16, my - rad * 0.05, mw, 0.85, mw * 2, 1, 1, 1);
    }
    if b.kind == EMBER {
      for j: 0..<3 {
        fx := q.x + f32(j - 1) * rad * 0.38;
        fy := y - rad * (0.82 - 0.12 * abs(f32(j - 1)));
        lick := rad * (0.32 + 0.14 * sin(s[0].clock * 13 + f32(j) * 2.1 + b.wob));
        sway := rad * 0.12 * sin(s[0].clock * 9 + f32(j) * 1.7);
        n = seg(out, n, fx, fy, fx + sway, fy - lick, rad * 0.11, 0.9, rad * 0.2, 1.0, 0.18, 0.12);
        n = seg(out, n, fx, fy, fx + sway * 0.7, fy - lick * 0.6, rad * 0.05, 1.0, rad * 0.08, 1.0, 0.9, 0.45);
      }
    }
    if b.kind == GLIMMER {
      for j: 0..<2 {
        a := s[0].clock * 2.4 + f32(j) * 3.14159 + b.wob;
        sx := q.x + cos(a) * rad * 1.3; sy := y + sin(a) * rad * 1.1;
        tw := rad * (0.12 + 0.06 * sin(s[0].clock * 10 + f32(j) * 2));
        n = seg(out, n, sx - tw, sy, sx + tw, sy, hi(0.6, rad * 0.035), 1.0, rad * 0.08, 1.0, 0.95, 0.6);
        n = seg(out, n, sx, sy - tw, sx, sy + tw, hi(0.6, rad * 0.035), 1.0, rad * 0.08, 1.0, 0.95, 0.6);
      }
    }
    if b.kind == FROSTLING {
      // ice spikes on its crown
      for j: 0..<3 {
        fx := q.x + f32(j - 1) * rad * 0.4;
        fy := y - rad * (0.8 - 0.1 * abs(f32(j - 1)));
        n = seg(out, n, fx, fy, fx + f32(j - 1) * rad * 0.12, fy - rad * (0.34 - 0.1 * abs(f32(j - 1))), rad * 0.07, 1.0, rad * 0.14, 0.75, 0.92, 1.0);
      }
    }
    if b.kind == IRONSKIN {
      // riveted bands round it
      n = ring(out, n, q.x, y, rad * 0.98, hi(1, rad * 0.1), 0.9, 0.42, 0.44, 0.5, 0);
      for j: 0..<4 {
        a := f32(j) * 1.5708 + 0.785;
        n = bubble(out, n, q.x + cos(a) * rad * 0.98, y + sin(a) * rad * 0.98, rad * 0.11, 1.0, 0.85, 0.86, 0.9, 0, 0, 0, 0);
      }
    }
    if b.kind == SHADOW {
      // a trail of dark smoke behind it
      for j: 1..<4 {
        sx := q.x - lx * rad * 0.7 * f32(j); sy := y - ly * rad * 0.7 * f32(j) + sin(b.wob + f32(j)) * rad * 0.2;
        n = bubble(out, n, sx, sy, rad * (0.5 - 0.1 * f32(j)), 0.5 - 0.12 * f32(j), 0.16, 0.12, 0.24, 0, 0, 0, 0);
      }
    }
    if b.kind == HULK {
      // horns, and its hit points as a bar while hurt
      for j: 0..<2 {
        sx := ifx j == 0 then -1.0f32 else 1.0f32;
        n = seg(out, n, q.x + sx * rad * 0.5, y - rad * 0.75, q.x + sx * rad * 0.85, y - rad * 1.2, rad * 0.09, 1.0, rad * 0.16, 0.95, 0.88, 0.75);
      }
      full := f32(s[0].ct[0].hp[HULK]);
      if f32(b.hp) < full {
        bw2 := rad * 1.6; by2 := y - rad * 1.35;
        n = seg(out, n, q.x - bw2 / 2, by2, q.x + bw2 / 2, by2, rad * 0.07, 0.7, rad * 0.1, 0.15, 0.1, 0.2);
        n = seg(out, n, q.x - bw2 / 2, by2, q.x - bw2 / 2 + bw2 * f32(b.hp) / full, by2, rad * 0.07, 1.0, rad * 0.1, 0.95, 0.4, 1.0);
      }
    }
    if b.kind == WISP {
      tx := q.x - lx * rad * 1.0; ty := y - ly * rad * 1.0 + rad * 0.3;
      curl := sin(b.wob * 1.5) * rad * 0.4;
      n = seg(out, n, q.x - lx * rad * 0.8, y + rad * 0.25, tx, ty + curl, rad * 0.1, 0.3, rad * 0.3, r, g, bl);
    }
  }
  return n;
}
// The party itself is painted by stair.wgsl (a figure per tile); here: reach rings, and the armed
// defender's reach where it would go, with the beasts it would reach ringed.
draw_party :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  k := hi(s[0].dpr, 0.5);
  n = draw_walls(s, out, n, t);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live { continue; }
    if d.level >= 2 {
      // a gold pip a level, at its feet
      c := cell_xy(d.cell);
      q := to_screen(s, c.x, c.y);
      for j: 0..<d.level - 1 {
        px := q.x + t * (0.39 - 0.11 * f32(d.level - 1)) + f32(j) * t * 0.11; py := q.y + t * 0.18;
        pr := hi(1, t * 0.035);
        n = seg(out, n, px - pr, py, px, py - pr * 1.4, pr * 0.45, 1, pr, GOLD_R, GOLD_G, GOLD_B);
        n = seg(out, n, px, py - pr * 1.4, px + pr, py, pr * 0.45, 1, pr, GOLD_R, GOLD_G, GOLD_B);
      }
    }
    if d.daylight {
      // Daylight: a warm pool round the cleric
      c := cell_xy(d.cell);
      q := to_screen(s, c.x, c.y);
      rr := f32(DAYLIGHT_REACH) * t;
      n = ring(out, n, q.x, q.y, rr * 0.5, rr, 0.07, 1.0, 0.93, 0.62, 0);
    }
    if i == s[0].card || d.cell == s[0].hover {
      c := cell_xy(d.cell);
      q := to_screen(s, c.x, c.y);
      n = ring(out, n, q.x, q.y, s[0].ct[0].range[d.cls] * t, hi(1, 1.2 * k), 0.5, CLASS_R[d.cls], CLASS_G[d.cls], CLASS_B[d.cls], 0);
    }
  }
  a := aim_cell(s);
  if a >= 0 {
    c := s[0].pick;
    q := to_screen(s, cell_xy(a).x, cell_xy(a).y);
    r := CLASS_R[c]; g := CLASS_G[c]; b := CLASS_B[c];
    pulse := 0.75 + 0.25 * sin(s[0].clock * 5);
    rr := s[0].ct[0].range[c] * t;
    n = ring(out, n, q.x, q.y, rr * 0.5, rr, 0.06, r, g, b, 0);
    n = ring(out, n, q.x, q.y, rr, hi(1, 1.6 * k), 0.7 * pulse, r, g, b, 0);
    for i: 0..<BEASTS {
      if !s[0].beasts[i].live { continue; }
      p := path_at(s, s[0].beasts[i].d); cc := cell_xy(a);
      if (p.x - cc.x) * (p.x - cc.x) + (p.y - cc.y) * (p.y - cc.y) <= s[0].ct[0].range[c] * s[0].ct[0].range[c] {
        bq := to_screen(s, p.x, p.y);
        n = ring_sq(out, n, bq.x, bq.y - t * 0.24, s[0].ct[0].size[s[0].beasts[i].kind] * t * 1.45, hi(1, t * 0.02), 0.8, r, g, b, 1);
      }
    }
  }
  return n;
}
// A point on a curve from a to b bowed sideways by bow (a share of its length).
Curve :: struct { x: f32; y: f32; }
bow_at :: (ax: f32, ay: f32, bx: f32, by: f32, bow: f32, h: f32) -> Curve {
  mx := (ax + bx) / 2 - (by - ay) * bow; my := (ay + by) / 2 + (bx - ax) * bow;
  u1 := 1 - h;
  return Curve.{x = u1 * u1 * ax + 2 * u1 * h * mx + h * h * bx, y = u1 * u1 * ay + 2 * u1 * h * my + h * h * by};
}
draw_fx :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  k := hi(s[0].dpr, 0.5);
  buf: [16] u8;
  for i: 0..<FX {
    f := s[0].fx[i];
    if f.life <= 0 { continue; }
    a := clamp01(f.t / f.life);
    fade := clamp01((f.life - f.t) / (f.life * 0.5));
    p := to_screen(s, f.x, f.y);
    if f.kind == FX_SLASH {
      // a swept arc across the target, white-steel (gold on a crit)
      q := to_screen(s, f.x2, f.y2);
      cx := q.x; cy := q.y - t * 0.24;
      rad := t * (ifx f.big then 0.42f32 else 0.3f32);
      w := hi(1, t * 0.035) * (ifx f.big then 1.6f32 else 1.0f32);
      sweep := clamp01(a * 3);
      cr: f32 = 0.9; cg: f32 = 0.95; cb: f32 = 1.0;
      if f.big { cr = 1.0; cg = 0.88; cb = 0.45; }
      for j: 0..<6 {
        a0 := -2.6 + f32(j) / 6 * 2.4 * sweep; a1 := -2.6 + f32(j + 1) / 6 * 2.4 * sweep;
        taper := 0.4 + 0.6 * f32(j) / 5;
        n = seg(out, n, cx + cos(a0) * rad, cy + sin(a0) * rad, cx + cos(a1) * rad, cy + sin(a1) * rad, w * taper, fade, t * 0.08, cr, cg, cb);
      }
      continue;
    }
    if f.kind == FX_BOLT {
      // Fire Bolt: a white-hot head, a red trail throwing sparks, a burst where it lands
      q := to_screen(s, f.x2, f.y2);
      ay := p.y - t * 0.45; by := q.y - t * 0.24;
      h := clamp01(a * 2.2);
      hx := p.x + (q.x - p.x) * h; hy := ay + (by - ay) * h;
      lx := p.x + (q.x - p.x) * hi(0, h - 0.3); ly := ay + (by - ay) * hi(0, h - 0.3);
      w := hi(1, t * 0.05) * (ifx f.big then 1.5f32 else 1.0f32);
      if h < 1 {
        n = seg(out, n, lx, ly, hx, hy, w * 1.6, 0.8, t * 0.12, 1.0, 0.16, 0.08);
        n = seg(out, n, (lx + hx) / 2, (ly + hy) / 2, hx, hy, w * 0.7, 1.0, t * 0.06, 1.0, 0.85, 0.35);
        n = disc(out, n, hx, hy, w * 1.4, 1.0, t * 0.12, 1.0, 0.95, 0.7);
        for j: 0..<3 {
          sh := hi(0, h - 0.1 - f32(j) * 0.07);
          sx := p.x + (q.x - p.x) * sh + sin(f.dx * 9 + f32(j) * 2.3 + a * 20) * t * 0.06;
          sy := ay + (by - ay) * sh + cos(f.dx * 7 + f32(j) * 1.9 + a * 17) * t * 0.06;
          n = disc(out, n, sx, sy, hi(0.7, t * 0.012), 0.9, t * 0.03, 1.0, 0.75, 0.3);
        }
      } else {
        burst := clamp01((a - 0.45) / 0.55);
        n = glow_disc(out, n, q.x, by, t * (0.2 + 0.35 * burst), (1 - burst) * 0.9, 1.0, 0.3, 0.15);
        n = ring_sq(out, n, q.x, by, t * (0.1 + 0.4 * burst), hi(1, t * 0.03) * (1 - burst), 1 - burst, 1.0, 0.8, 0.35, 1);
      }
      continue;
    }
    if f.kind == FX_DART {
      // Magic Missile: a violet dart on a bowed path, its trail behind it
      q := to_screen(s, f.x2, f.y2);
      ay := p.y - t * 0.45; by := q.y - t * 0.24;
      h := clamp01(a * 1.8);
      bow := f.dx * 0.45;
      w := hi(0.8, t * 0.028);
      prev := bow_at(p.x, ay, q.x, by, bow, hi(0, h - 0.3));
      for j: 1..<5 {
        c := bow_at(p.x, ay, q.x, by, bow, hi(0, h - 0.3 + 0.3 * f32(j) / 4));
        n = seg(out, n, prev.x, prev.y, c.x, c.y, w * (0.4 + 0.6 * f32(j) / 4), fade * (0.4 + 0.6 * f32(j) / 4), t * 0.07, 0.7, 0.55, 1.0);
        prev = c;
      }
      if h < 1 { n = disc(out, n, prev.x, prev.y, w * 1.5, 1.0, t * 0.1, 0.9, 0.85, 1.0); }
      else { n = glow_disc(out, n, q.x, by, t * 0.3, fade * 0.8, 0.65, 0.5, 1.0); }
      continue;
    }
    if f.kind == FX_POP {
      // the skin bursts: a flash, a ring, droplets flung out and falling
      cy := p.y - t * 0.24;
      rad := t * (0.15 + a * 0.5);
      n = glow_disc(out, n, p.x, cy, t * 0.35 * (1 - a), (1 - a) * (1 - a) * 1.2, 1, 1, 1);
      n = ring_sq(out, n, p.x, cy, rad, hi(1, t * 0.035 * (1 - a)), fade, f.r, f.g, f.b, 1);
      drops := ifx f.big then 10 else 7;
      for j: 0..<drops {
        ang := f32(j) / f32(drops) * 6.2831853 + f.dx;
        sp := t * (0.55 + 0.25 * sin(f32(j) * 2.7 + f.dx * 5));
        dx := cos(ang) * sp * a; dy := sin(ang) * sp * a * 0.8 + t * 1.1 * a * a;
        sz := hi(0.8, t * 0.03 * (1 - a * 0.6));
        n = seg(out, n, p.x + dx * 0.8, cy + dy * 0.8 - t * 0.02, p.x + dx, cy + dy, sz, fade, t * 0.05, f.r, f.g, f.b);
      }
      continue;
    }
    if f.kind == FX_FLAME {
      // Sacred Flame: a pillar of light comes down on the target, a ring where it strikes
      cy := p.y - t * 0.2;
      fall := clamp01(a * 4);
      top := cy - t * 1.5;
      bot := top + (cy - top) * fall;
      w := t * 0.07 * (1 - a * 0.5);
      n = seg(out, n, p.x, top, p.x, bot, w * 1.8, fade * 0.7, t * 0.2, 1.0, 0.9, 0.55);
      n = seg(out, n, p.x, top, p.x, bot, w * 0.6, fade, t * 0.06, 1.0, 1.0, 0.9);
      if fall >= 1 {
        n = ring_sq(out, n, p.x, p.y, t * (0.15 + 0.35 * a), hi(1, t * 0.03), fade, 1.0, 0.9, 0.5, f32(SQUASH) * 0.6);
        for j: 0..<4 {
          rx := p.x + f32(j - 2) * t * 0.1 + t * 0.05; ry := cy - t * 0.6 * a - f32(j % 2) * t * 0.15;
          n = disc(out, n, rx, ry, hi(0.7, t * 0.015), fade, t * 0.04, 1.0, 0.95, 0.7);
        }
      }
      continue;
    }
    if f.kind == FX_CRIT {
      // a natural 20: the die itself rises over the target, gold
      rise := t * 0.6 * (1 - (1 - a) * (1 - a));
      cx := p.x; cy := p.y - t * 1.0 - rise;
      rad := t * 0.32 * (1 + 0.3 * clamp01(1 - f.t / 0.15));
      w := hi(1, t * 0.03);
      for j: 0..<6 {
        a0 := f32(j) / 6 * 6.2831853 - 1.5708; a1 := f32(j + 1) / 6 * 6.2831853 - 1.5708;
        n = seg(out, n, cx + cos(a0) * rad, cy + sin(a0) * rad, cx + cos(a1) * rad, cy + sin(a1) * rad, w, fade, t * 0.1, 1.0, 0.86, 0.4);
      }
      // the face's triangle
      for j: 0..<3 {
        a0 := f32(j) / 3 * 6.2831853 - 1.5708; a1 := f32(j + 1) / 3 * 6.2831853 - 1.5708;
        n = seg(out, n, cx + cos(a0) * rad * 0.62, cy + sin(a0) * rad * 0.62, cx + cos(a1) * rad * 0.62, cy + sin(a1) * rad * 0.62, w * 0.6, fade * 0.6, t * 0.04, 1.0, 0.86, 0.4);
      }
      cap := rad * 0.62;
      m := put_int(buf[..], 0, f.amount);
      n = say_mid(out, n, cast(string) buf[0..<m], cx, cy + cap * 0.5, cap, ink(k, fade, 1.0, 0.95, 0.75));
      n = say_mid(out, n, "CRIT", cx, cy + rad + t * 0.22, t * 0.17, ink(k, fade, 1.0, 0.86, 0.4));
      continue;
    }
    if f.kind == FX_SHATTER {
      // Shatter: a ringing boom, rings out across the crowd, cracks of light
      cy := p.y - t * 0.24;
      for j: 0..<3 {
        ra := clamp01(a * 1.6 - f32(j) * 0.18);
        if ra <= 0 || ra >= 1 { continue; }
        n = ring_sq(out, n, p.x, cy, t * f32(SHATTER_RADIUS) * ra, hi(1, t * 0.05 * (1 - ra)), (1 - ra), 0.75, 0.82, 1.0, 0.9);
      }
      n = glow_disc(out, n, p.x, cy, t * 0.6 * (1 - a * 0.5), (1 - a) * 0.8, 0.6, 0.7, 1.0);
      for j: 0..<7 {
        ang := f32(j) * 0.8976 + f.dx;
        l0 := t * 0.15; l1 := t * (0.3 + 0.5 * clamp01(a * 3));
        kink := t * 0.08 * sin(f32(j) * 3.1);
        mx := p.x + cos(ang) * (l0 + l1) * 0.5 - sin(ang) * kink; my := cy + sin(ang) * (l0 + l1) * 0.5 + cos(ang) * kink;
        n = seg(out, n, p.x + cos(ang) * l0, cy + sin(ang) * l0, mx, my, hi(0.7, t * 0.015), fade, t * 0.05, 0.85, 0.9, 1.0);
        n = seg(out, n, mx, my, p.x + cos(ang) * l1, cy + sin(ang) * l1, hi(0.7, t * 0.012), fade, t * 0.05, 0.85, 0.9, 1.0);
      }
      continue;
    }
    if f.kind == FX_SPIRIT {
      // Spiritual Weapon: a spectral mace swings down onto the target
      cx := p.x; cy := p.y - t * 0.24;
      sw := 1.9 - 1.7 * clamp01(a * 2.5);
      hx := cx + cos(sw) * t * 0.45 - t * 0.2; hy := cy - sin(sw) * t * 0.45;
      n = seg(out, n, cx - t * 0.2, cy + t * 0.05, hx, hy, hi(1, t * 0.03), fade * 0.85, t * 0.08, 1.0, 0.9, 0.55);
      n = disc(out, n, hx, hy, t * 0.07, fade, t * 0.12, 1.0, 0.95, 0.7);
      if a > 0.4 { n = glow_disc(out, n, cx, cy, t * 0.3, fade * 0.7, 1.0, 0.9, 0.5); }
      continue;
    }
    if f.kind == FX_LEVEL {
      // a level up: a column of the class's light and LEVEL N rising
      cy := p.y - t * 0.3;
      n = seg(out, n, p.x, cy + t * 0.3, p.x, cy - t * (0.4 + 0.8 * a), t * 0.12 * (1 - a), fade * 0.6, t * 0.3, f.r, f.g, f.b);
      n = ring_sq(out, n, p.x, p.y, t * (0.2 + 0.4 * a), hi(1, t * 0.03), fade, f.r, f.g, f.b, f32(SQUASH) * 0.6);
      m := put(buf[..], 0, "LEVEL "); m = put_int(buf[..], m, f.amount);
      n = say_mid(out, n, cast(string) buf[0..<m], p.x, cy - t * (0.7 + 0.4 * a), t * 0.2, ink(k, fade, 1.0, 0.92, 0.6));
      continue;
    }
    // words and numbers rise and fade (Everglade's red damage numbers)
    rise := t * 0.7 * (1 - (1 - a) * (1 - a));
    x := p.x + f.dx * t * 0.15; y := p.y - t * 0.45 - rise;
    if f.kind == FX_NUM {
      grow := 1 + 0.4 * clamp01(1 - f.t / 0.12);
      cap := (ifx f.big then 0.42f32 else 0.3f32) * t * grow;
      m := put_int(buf[..], 0, f.amount);
      line := cast(string) buf[0..<m];
      body := Ink.{core = (ifx f.big then 1.5f32 else 1.05f32) * k, light = fade, glow = 0.9 * k, red = 1.0, green = 0.16, blue = 0.1, mode = 0, scale = k};
      n = draw_text(out, n, line, x - text_width(line, cap) / 2, y, cap, GAP, SPACE, body, false, false);
      continue;
    }
    word := ifx f.kind == FX_MISS then "MISS" else ifx f.kind == FX_SAVED then "SAVED" else "IMMUNE";
    cap := 0.2 * t;
    n = say_mid(out, n, word, x, y, cap, ink(k, fade * 0.8, f.r, f.g, f.b));
  }
  return n;
}

button_label :: (s: [] Stair, b: int, buf: [] u8) -> int {
  if b == B_START {
    if s[0].phase == BUILD { n := put(buf, 0, "START WAVE "); return put_int(buf, n, s[0].wave + 1); }
    n := put(buf, 0, "WAVE "); n = put_int(buf, n, s[0].wave); return put(buf, n, " CLIMBING");
  }
  if b == B_FAST { n := put(buf, 0, "SPEED "); return put_int(buf, n, s[0].speed); }
  if b == B_GALAXY { return put(buf, 0, "GALAXY"); }
  if b >= B_STONE && b <= B_SLOW {
    sp := b - B_STONE;
    if sp == SPELL_SLOW && s[0].slow_t > 0 { n := put(buf, 0, "SLOW "); n = put_int(buf, n, cast(int) floor(s[0].slow_t + 0.999)); return put(buf, n, "S"); }
    n := put(buf, 0, SPELL_NAME[sp]); n = put(buf, n, " ");
    if s[0].spells[sp] > 0 { return put_int(buf, n, s[0].spells[sp]); }
    n = put_int(buf, n, spell_price(s, sp)); return put(buf, n, "G");
  }
  if b == B_MAP {
    n := put(buf, 0, "MAP "); n = put_int(buf, n, s[0].map + 1); n = put(buf, n, "/"); n = put_int(buf, n, MAPS);
    return ifx s[0].portrait then n else put(buf, put(buf, n, " · "), STAIR_MAP_NAME[s[0].map]);
  }
  if b == B_PAUSE { return put(buf, 0, ifx s[0].paused then "RESUME" else "PAUSE"); }
  if b == B_AGAIN { return put(buf, 0, "AGAIN"); }
  if b == B_SELL { n := put(buf, 0, "SELL +"); return put_int(buf, n, spent(s, s[0].card) * 7 / 10); }
  if b == B_UPGRADE {
    d := s[0].party[s[0].card];
    if d.level >= MAX_LEVEL { n := put(buf, 0, "LEVEL "); return put_int(buf, n, MAX_LEVEL); }
    n := put(buf, 0, "LEVEL "); n = put_int(buf, n, d.level + 1); n = put(buf, n, " · "); n = put_int(buf, n, up_cost(s, d.cls, d.level));
    return ifx s[0].portrait then n else put(buf, n, " GOLD");
  }
  c := b - B_FIGHTER;
  n := put(buf, 0, CLASS_NAME[c]); n = put(buf, n, " "); return put_int(buf, n, s[0].ct[0].cost[c]);
}

// MADE BY <NAME> · TIP (small, dim; TIP in Bitcoin's orange), centred: in the
// gap between the map and the bottom panel when there is one, else in the
// strip under the panel's buttons. Nothing without a maker.
maker_line :: (s: [] Stair, out: [] f32, at: int, w: f32, h: f32) -> int {
  s[0].tip_shown = false;
  if s[0].maker_n == 0 { return at; }
  k := hi(s[0].dpr, 0.5);
  bottom := ifx s[0].portrait then 216 * k else 118 * k;
  map_y1 := s[0].by + (f32(s[0].srows) + f32(RIM_TILES)) * s[0].bt * f32(SQUASH);
  // the band it sits in: the gap over the panel, or the strip under its buttons
  y0 := map_y1; y1 := h - bottom;
  if y1 - y0 < 24 * k { y0 = h - (ifx s[0].portrait then 14 * k else 22 * k); y1 = h; }
  y0 = hi(y0, y1 - 40 * k);   // a tall gap: just over the panel
  lead: [MAKER_BYTES + 16] u8;
  n := put(lead[..], 0, "MADE BY "); n = put(lead[..], n, cast(string) s[0].maker[0..<s[0].maker_n]); n = put(lead[..], n, " · ");
  left := cast(string) lead[0..<n];
  lw := measure(left, GAP, SPACE, false); tw := measure("TIP", GAP, SPACE, false);
  cap := lo(lo(6 * k, y1 - y0 - 6 * k), (w - 40 * k) / hi(lw + tw, 1));
  base := (y0 + y1) * 0.5 + cap * 0.5;
  x := w * 0.5 - (lw + tw) * cap * 0.5;
  v := say_at(out, at, left, x, base, cap, ink(k, 0.55, INK_R, INK_G, INK_B));
  tx := x + lw * cap;
  hot := s[0].tip_hover || s[0].tip_down;
  v = say_at(out, v, "TIP", tx, base, cap, ink(k, ifx hot then 1.0f32 else 0.8f32, TIP_R, TIP_G, TIP_B));
  // the target: TIP and round it, within the band
  s[0].tip_box = Rect.{x0 = tx - 8 * k, y0 = y0 + 1 * k, x1 = tx + tw * cap + 8 * k, y1 = y1 - 1 * k};
  s[0].tip_shown = true;
  return v;
}

draw_hud :: (s: [] Stair, out: [] f32, u: [] f32, at: int, w: f32, h: f32) -> int {
  n := at;
  k := hi(s[0].dpr, 0.5);
  buf: [96] u8;
  // the top bar
  plate(s, u, Rect.{x0 = 0, y0 = 0, x1 = w, y1 = 52 * k}, 0.85, 0);
  cap := ifx s[0].portrait then 10.5 * k else 13 * k;
  sp := ifx s[0].portrait then 12 * k else 24 * k;
  // a heart for the tower's lives, a coin for the gold
  m := put_int(buf[..], 0, s[0].lives);
  lx := ifx s[0].portrait then 88 * k else 112 * k;
  hy := 32 * k - cap * 0.5; hr := cap * 0.36;
  n = heart(out, n, lx, hy, hr);
  lx += hr * 3 + 6 * k;
  n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, 1.0, 0.42, 0.4));
  lx += text_width(cast(string) buf[0..<m], cap) + sp;
  m = put_int(buf[..], 0, s[0].gold);
  coin := cap * 0.55;
  n = bubble(out, n, lx + coin, hy, coin, 1, GOLD_R, GOLD_G, GOLD_B, 0, 0, 0, 0);
  n = ring_sq(out, n, lx + coin, hy, coin * 0.6, hi(0.8, coin * 0.12), 0.8, GOLD_R, GOLD_G, GOLD_B, 1);
  lx += coin * 2 + 6 * k;
  n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
  lx += text_width(cast(string) buf[0..<m], cap) + sp;
  m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave); m = put(buf[..], m, "/"); m = put_int(buf[..], m, waves_of(s));
  // on a phone, MAP (before the first wave) takes the wave count's place
  right := ifx s[0].shown[B_MAP] then s[0].boxes[B_MAP].x0 else ifx s[0].shown[B_STONE] && !s[0].portrait then s[0].boxes[B_STONE].x0 else w;
  if lx + text_width(cast(string) buf[0..<m], cap) <= right - 6 * k {
    n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, INK_R, INK_G, INK_B));
    lx += text_width(cast(string) buf[0..<m], cap) + sp;
  }
  title := "HOLD THE STAIR";
  if !s[0].portrait && lx + text_width(title, cap) + 24 * k < right - 12 * k { n = say_at(out, n, title, right - text_width(title, cap) - 24 * k, 32 * k, cap, ink(k, 0.7, GOLD_R, GOLD_G, GOLD_B)); }
  // the bottom panel
  bottom := ifx s[0].portrait then 216 * k else 118 * k;
  plate(s, u, Rect.{x0 = 0, y0 = h - bottom, x1 = w, y1 = h}, 0.85, 0);
  // the defender card, or a hint
  if s[0].card >= 0 && s[0].party[s[0].card].live {
    d := s[0].party[s[0].card];
    x0 := ifx s[0].portrait then 14 * k else 24 * k;
    y0 := ifx s[0].portrait then h - bottom + 24 * k else h - bottom + 26 * k;
    // the lines keep clear of the card's buttons
    room := ifx s[0].portrait then w - 28 * k - 142 * k else w - 24 * k - 716 * k;
    lines: [6] [72] u8; lens: [6] int; tones: [6] int;   // tone 0 ink, 1 gold, 2 the class's colour
    nl := 0;
    lens[nl] = put(lines[nl][..], 0, CLASS_NAME[d.cls]); lens[nl] = put(lines[nl][..], lens[nl], " · LEVEL "); lens[nl] = put_int(lines[nl][..], lens[nl], d.level);
    if d.level >= 3 { lens[nl] = put(lines[nl][..], lens[nl], " · "); lens[nl] = put(lines[nl][..], lens[nl], SUBCLASS_NAME[d.cls]); }
    if !s[0].portrait {
      lens[nl] = put(lines[nl][..], lens[nl], " · HITS "); lens[nl] = put_int(lines[nl][..], lens[nl], d.hits);
      lens[nl] = put(lines[nl][..], lens[nl], " · MISSES "); lens[nl] = put_int(lines[nl][..], lens[nl], d.misses);
      lens[nl] = put(lines[nl][..], lens[nl], " · POPS "); lens[nl] = put_int(lines[nl][..], lens[nl], d.pops);
    }
    tones[nl] = 2; nl += 1;
    attack := CLASS_ATTACK[d.cls];
    lens[nl] = put(lines[nl][..], 0, attack); tones[nl] = 0; nl += 1;
    if d.cls == WIZARD {
      lens[nl] = put(lines[nl][..], 0, "MAGIC MISSILE 3 X 1D4+1 · "); lens[nl] = put_int(lines[nl][..], lens[nl], d.slots); lens[nl] = put(lines[nl][..], lens[nl], " LEFT");
      if d.level >= 3 { lens[nl] = put(lines[nl][..], lens[nl], " · SHATTER "); lens[nl] = put_int(lines[nl][..], lens[nl], d.slots2); lens[nl] = put(lines[nl][..], lens[nl], " LEFT"); }
      tones[nl] = 0; nl += 1;
    }
    // what its levels give
    feat := "";
    if d.cls == FIGHTER { feat = ifx d.level >= 3 then "ACTION SURGE · CRITS ON 19-20" else ifx d.level == 2 then "ACTION SURGE: 2 ATTACKS ONCE A WAVE" else "NEXT: ACTION SURGE, 2 ATTACKS ONCE A WAVE"; }
    if d.cls == WIZARD { feat = ifx d.level >= 3 then "SHATTER: 3D8 THUNDER WHERE 3 CROWD" else ifx d.level == 2 then "NEXT: SHATTER, 3D8 THUNDER ON A CROWD" else "NEXT: A THIRD MAGIC MISSILE"; }
    if d.cls == CLERIC { feat = ifx d.level >= 3 then "BLESS +1D4 IN REACH · SPIRITUAL WEAPON" else ifx d.level == 2 then "BLESS: +1D4 TO HIT IN REACH · NEXT: SPIRITUAL WEAPON" else "NEXT: BLESS, +1D4 TO HIT IN REACH"; }
    if d.cls == ROGUE { feat = ifx d.level >= 3 then "SNEAK ATTACK 2D6 BESIDE AN ALLY · CUNNING ACTION" else ifx d.level == 2 then "SNEAK ATTACK 1D6 · CUNNING ACTION: FASTER TURNS" else "SNEAK ATTACK +1D6 WHEN AN ALLY IS BESIDE ITS TARGET"; }
    if d.cls == RANGER {
      fl := put(buf[..], 0, "FAVOURED: "); fl = put(buf[..], fl, LAYER_NAME[d.fav]); fl = put(buf[..], fl, "S +1D6");
      if d.level >= 2 { fl = put(buf[..], fl, " · MARKS ALL"); }
      if d.level >= 3 { fl = put(buf[..], fl, " · TWO ARROWS"); }
      feat = cast(string) buf[0..<fl];
    }
    if d.cls == BARD { feat = ifx d.level >= 3 then "INSPIRES 2 IN REACH +1D6 · MOCKERY 2D6" else ifx d.level == 2 then "INSPIRES 2 IN REACH: +1D6 TO HIT" else "BARDIC INSPIRATION: AN ALLY ADDS 1D6 TO ITS NEXT ROLL"; }
    if d.cls == PALADIN { feat = ifx d.level >= 3 then "AURA +1 TO HIT, 3 TILES · DIVINE SMITE 2D8" else ifx d.level == 2 then "AURA +1 TO HIT, 2 TILES · DIVINE SMITE 2D8 A WAVE" else "AURA: THE PARTY WITHIN 2 TILES +1 TO HIT"; }
    // from level 3, its subclass and the levels after it
    if d.level == 3 { feat = SUBCLASS_FEAT[d.cls]; } else if d.level >= 4 { feat = ifx d.level >= 5 then LEVEL5_FEAT[d.cls] else LEVEL4_FEAT[d.cls]; }
    lens[nl] = put(lines[nl][..], 0, feat); tones[nl] = 2; nl += 1;
    m = 0;
    if d.roll < 0 && d.how != 3 && d.how != 6 { m = put(buf[..], 0, "NO TURN YET"); }
    else if d.how == 6 { m = put(buf[..], 0, "LAST: DAYLIGHT, SHADOWS IN REACH SEEN"); }
    else if d.how == 3 { m = put(buf[..], 0, "LAST: SHATTER, "); m = put_int(buf[..], m, d.dealt); m = put(buf[..], m, " THUNDER"); }
    else if d.how == 2 { m = put(buf[..], 0, "LAST: MAGIC MISSILE, NEVER MISSES, "); m = put_int(buf[..], m, d.dealt); }
    else if d.how == 1 {
      m = put(buf[..], 0, "LAST: SAVE D20 "); m = put_int(buf[..], m, d.roll); m = put(buf[..], m, " = "); m = put_int(buf[..], m, d.total);
      m = put(buf[..], m, " VS DC "); m = put_int(buf[..], m, d.vs); m = put(buf[..], m, ifx d.hit then " FAILED" else " SAVED");
    } else {
      m = put(buf[..], 0, "LAST: D20 "); m = put_int(buf[..], m, d.roll); m = put(buf[..], m, " + 5");
      if d.bless > 0 { m = put(buf[..], m, " + BLESS "); m = put_int(buf[..], m, d.bless); }
      if d.insp > 0 { m = put(buf[..], m, " + INSPIRED "); m = put_int(buf[..], m, d.insp); }
      if d.aura > 0 { m = put(buf[..], m, " + AURA 1"); }
      m = put(buf[..], m, " = "); m = put_int(buf[..], m, d.total);
      m = put(buf[..], m, " VS AC "); m = put_int(buf[..], m, d.vs); m = put(buf[..], m, ifx d.crit then " CRIT" else ifx d.hit then " HIT" else " MISS");
      if d.how == 4 { m = put(buf[..], m, " · SNEAK"); }
      if d.how == 5 { m = put(buf[..], m, " · SMITE"); }
    }
    lens[nl] = put(lines[nl][..], 0, cast(string) buf[0..<m]); tones[nl] = 1; nl += 1;
    ly := y0;
    for i: 0..<nl {
      line := cast(string) lines[i][0..<lens[i]];
      c := ifx i == 0 then 12 * k else 10 * k;
      while text_width(line, c) > room && c > 6 * k { c -= 0.5 * k; }
      tr: f32 = INK_R; tg: f32 = INK_G; tb: f32 = INK_B;
      if tones[i] == 1 { tr = GOLD_R; tg = GOLD_G; tb = GOLD_B; }
      if tones[i] == 2 { tr = CLASS_R[d.cls]; tg = CLASS_G[d.cls]; tb = CLASS_B[d.cls]; }
      n = say_at(out, n, line, x0, ly, c, ink(k, ifx i == 0 then 1.0f32 else 0.88f32, tr, tg, tb));
      ly += ifx i == 0 then 19 * k else 15 * k;
    }
  } else if s[0].phase != WON && s[0].phase != LOST {
    // how many more this round, and what to do next
    left := round_left(s);
    m = put(buf[..], 0, "PLACE "); m = put_int(buf[..], m, left); m = put(buf[..], m, " MORE THIS ROUND (");
    m = put_int(buf[..], m, round_allowance(s, s[0].wave)); m = put(buf[..], m, " A ROUND)");
    hint := "PICK A DEFENDER, THEN A TILE BESIDE THE STAIR";
    cheapest := s[0].ct[0].cost[FIGHTER];
    for c: 0..<CLASSES { if s[0].ct[0].cost[c] < cheapest { cheapest = s[0].ct[0].cost[c]; } }
    hb: [64] u8;
    if left <= 0 { hint = ifx s[0].phase == BUILD then "START THE WAVE FOR MORE" else "MORE WHEN THE NEXT WAVE STARTS"; }
    if left <= 0 && s[0].phase == BUILD && s[0].gold >= 150 && can_level(s) {
      // gold piling up with the round's places used: spend it on levels
      hm := put_int(hb[..], 0, s[0].gold); hm = put(hb[..], hm, " GOLD UNSPENT · TAP A DEFENDER TO LEVEL IT UP");
      hint = cast(string) hb[0..<hm];
    }
    else if s[0].pick < 0 && s[0].gold < cheapest { hint = "NOT ENOUGH GOLD YET · POP BEASTS FOR MORE"; }
    else if s[0].pick >= 0 {
      if s[0].touch { hint = ifx aim_cell(s) >= 0 then "TAP IT AGAIN TO PLACE · TAP OFF THE MAP TO STOP" else "TAP A TILE TO SEE ITS REACH"; }
      else { hint = "CLICK A TILE TO PLACE · ESC TO STOP"; }
    }
    x0 := ifx s[0].portrait then 14 * k else 24 * k;
    yy := ifx s[0].portrait then h - bottom + 22 * k else h - bottom + 22 * k;
    c := 11 * k;
    count := cast(string) buf[0..<m];
    if s[0].portrait {
      while text_width(count, c) > w - 28 * k && c > 7 * k { c -= 0.5 * k; }
      n = say_at(out, n, count, x0, yy, c, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
      c2 := 10 * k;
      while text_width(hint, c2) > w - 28 * k && c2 > 6 * k { c2 -= 0.5 * k; }
      n = say_at(out, n, hint, x0, yy + 16 * k, c2, ink(k, 0.75, INK_R, INK_G, INK_B));
    } else {
      n = say_at(out, n, count, x0, yy, c, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
      n = say_at(out, n, hint, x0 + text_width(count, c) + 24 * k, yy, c, ink(k, 0.75, INK_R, INK_G, INK_B));
    }
  }
  // buttons; the class buttons share one size of name and cost, the one the narrowest fits
  cnc := 12 * k; ccc := 10 * k;
  for b: B_FIGHTER..<B_LAST_CLASS + 1 {
    if !s[0].shown[b] { continue; }
    r := s[0].boxes[b];
    room := r.x1 - r.x0 - class_icon(r) - CLASS_PAD * k;   // clear of the bevelled corner
    while text_width(CLASS_NAME[b - B_FIGHTER], cnc) > room && cnc > 7 * k { cnc -= 0.5 * k; }
    m = put_int(buf[..], 0, s[0].ct[0].cost[b - B_FIGHTER]); m = put(buf[..], m, " GOLD");
    while text_width(cast(string) buf[0..<m], ccc) > room && ccc > 6 * k { ccc -= 0.5 * k; }
  }
  ccc = lo(ccc, cnc);
  for b: 0..<BUTTONS {
    if !s[0].shown[b] { continue; }
    r := s[0].boxes[b];
    armed := (b >= B_FIGHTER && b <= B_LAST_CLASS && s[0].pick == b - B_FIGHTER) || (b == B_PAUSE && s[0].paused);
    style := ifx armed then 2.0f32 else ifx !s[0].enabled[b] then 3.0f32 else ifx s[0].press == b || s[0].hover_b == b then 2.0f32 else 1.0f32;
    cls := ifx b >= B_FIGHTER && b <= B_LAST_CLASS then b - B_FIGHTER else -1;
    plate_icon(s, u, r, 1, style, cls);
    if cls >= 0 {
      // the class's portrait (stair.wgsl), its name, its cost
      light := ifx s[0].enabled[b] then 1.0f32 else 0.4f32;
      bh := r.y1 - r.y0;
      tx := r.x0 + class_icon(r);
      nc := cnc;
      n = say_at(out, n, CLASS_NAME[cls], tx, (r.y0 + r.y1) / 2 - 2 * k, nc, ink(k, light, CLASS_R[cls], CLASS_G[cls], CLASS_B[cls]));
      m = put_int(buf[..], 0, s[0].ct[0].cost[cls]); m = put(buf[..], m, " GOLD");
      cc := ccc;
      n = say_at(out, n, cast(string) buf[0..<m], tx, (r.y0 + r.y1) / 2 + cc + 4 * k, cc, ink(k, light * 0.9, GOLD_R, GOLD_G, GOLD_B));
      continue;
    }
    m = button_label(s, b, buf[..]);
    lab := cast(string) buf[0..<m];
    bc := 12 * k;
    tw := text_width(lab, bc);
    while tw > r.x1 - r.x0 - 10 * k && bc > 7 * k { bc -= 1 * k; tw = text_width(lab, bc); }
    light := ifx s[0].enabled[b] then 1.0f32 else 0.4f32;
    cr: f32 = INK_R; cg: f32 = INK_G; cb: f32 = INK_B;
    if b >= B_FIGHTER && b <= B_LAST_CLASS { cr = CLASS_R[b - B_FIGHTER]; cg = CLASS_G[b - B_FIGHTER]; cb = CLASS_B[b - B_FIGHTER]; }
    if (b == B_START && s[0].phase == BUILD) || b == B_UPGRADE { cr = GOLD_R; cg = GOLD_G; cb = GOLD_B; }
    n = say_at(out, n, lab, (r.x0 + r.x1) / 2 - tw / 2, (r.y0 + r.y1) / 2 + bc / 2, bc, ink(k, light, cr, cg, cb));
  }
  // the next wave, on the back wall: a bubble of each layer and how many
  if s[0].phase == BUILD && s[0].wave < waves_of(s) && s[0].bt > 0 {
    wy := s[0].by - f32(WALL_ROWS) * s[0].bt * f32(SQUASH) * 0.5;
    wh := f32(WALL_ROWS) * s[0].bt * f32(SQUASH);
    pc := lo(wh * 0.42, 13 * k);
    br := pc * 0.62;
    // what it says and how wide, to centre it
    total := text_width("NEXT", pc) + 10 * k;
    for g: 0..<GROUPS {
      kind := s[0].ct[0].kind[s[0].wave * GROUPS + g];
      if kind < 0 { continue; }
      m = put(buf[..], 0, "X"); m = put_int(buf[..], m, s[0].ct[0].count[s[0].wave * GROUPS + g]);
      total += br * 2 + 4 * k + text_width(cast(string) buf[0..<m], pc) + 12 * k;
      if s[0].ct[0].lives[kind] > 1 { m = put_int(buf[..], 0, s[0].ct[0].lives[kind]); total += pc * 1.1 + 3 * k + text_width(cast(string) buf[0..<m], pc) + 10 * k; }
    }
    px := s[0].bx + f32(s[0].scols) * s[0].bt * 0.5 - total / 2;
    plate(s, u, Rect.{x0 = px - 10 * k, y0 = wy - pc * 0.5 - 7 * k, x1 = px + total + 4 * k, y1 = wy + pc * 0.5 + 7 * k}, 0.8, 0);
    n = say_at(out, n, "NEXT", px, wy + pc * 0.5, pc, ink(k, 0.8, INK_R, INK_G, INK_B));
    px += text_width("NEXT", pc) + 10 * k;
    for g: 0..<GROUPS {
      kind := s[0].ct[0].kind[s[0].wave * GROUPS + g];
      if kind < 0 { continue; }
      n = bubble(out, n, px + br, wy, br, 1, s[0].ct[0].red[kind], s[0].ct[0].green[kind], s[0].ct[0].blue[kind], 0, 0, 0, 0);
      px += br * 2 + 4 * k;
      m = put(buf[..], 0, "X"); m = put_int(buf[..], m, s[0].ct[0].count[s[0].wave * GROUPS + g]);
      n = say_at(out, n, cast(string) buf[0..<m], px, wy + pc * 0.5, pc, ink(k, 1, s[0].ct[0].red[kind], s[0].ct[0].green[kind], s[0].ct[0].blue[kind]));
      px += text_width(cast(string) buf[0..<m], pc) + 12 * k;
      // the lives each takes if it reaches the top
      if s[0].ct[0].lives[kind] > 1 {
        hr2 := pc * 0.36;
        n = heart(out, n, px, wy - hr2 * 0.2, hr2);
        px += pc * 1.1 + 3 * k;
        m = put_int(buf[..], 0, s[0].ct[0].lives[kind]);
        n = say_at(out, n, cast(string) buf[0..<m], px, wy + pc * 0.5, pc, ink(k, 1, 1.0, 0.42, 0.4));
        px += text_width(cast(string) buf[0..<m], pc) + 10 * k;
      }
    }
  }
  // the wave's name as it starts
  if s[0].banner > 0 && s[0].phase == FIGHT {
    a := clamp01(s[0].banner / 0.4) * clamp01((1.6 - s[0].banner) / 0.15);
    m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave);
    bc := lo(44 * k, w / 9);
    grow := 1 + 0.08 * (1.6 - s[0].banner);
    my := s[0].by + f32(s[0].srows) * s[0].bt * f32(SQUASH) * 0.5;
    n = say_mid(out, n, cast(string) buf[0..<m], w / 2, my + bc * grow * 0.5, bc * grow, Ink.{core = 1.6 * k, light = a, glow = 3 * k, red = GOLD_R, green = GOLD_G, blue = GOLD_B, mode = 0, scale = k});
  }
  // a toast
  if s[0].toast_t > 0 && s[0].phase != WON && s[0].phase != LOST {
    tt := cast(string) s[0].toast[0..<s[0].toast_n];
    c := 14 * k;
    // over the map's first row, on a dark plate, clear of the wall and its preview
    ty := s[0].by + s[0].bt * f32(SQUASH) * 0.5 + c * 0.5;
    tw := text_width(tt, c);
    plate(s, u, Rect.{x0 = w / 2 - tw / 2 - 14 * k, y0 = ty - c - 10 * k, x1 = w / 2 + tw / 2 + 14 * k, y1 = ty + 10 * k}, clamp01(s[0].toast_t) * 0.9, 0);
    n = say_mid(out, n, tt, w / 2, ty, c, ink(k, clamp01(s[0].toast_t), GOLD_R, GOLD_G, GOLD_B));
  }
  if s[0].paused && s[0].phase != WON && s[0].phase != LOST {
    py := s[0].by + f32(s[0].srows) * s[0].bt * f32(SQUASH) * 0.5;
    pw := text_width("PAUSED", 20 * k);
    plate(s, u, Rect.{x0 = w / 2 - pw / 2 - 18 * k, y0 = py - 24 * k, x1 = w / 2 + pw / 2 + 18 * k, y1 = py + 24 * k}, 0.9, 0);
    n = say_mid(out, n, "PAUSED", w / 2, py + 10 * k, 20 * k, ink(k, 1, INK_R, INK_G, INK_B));
  }
  // the end
  if s[0].phase == WON || s[0].phase == LOST {
    cx := w / 2; cy := h / 2;
    half := lo(180 * k, w / 2 - 10 * k);
    plate(s, u, Rect.{x0 = cx - half, y0 = cy - 96 * k, x1 = cx + half, y1 = cy + 92 * k}, 0.95, 0);
    won := s[0].phase == WON;
    head := ifx won then "THE STAIR HOLDS" else "THE TOWER FALLS";
    hc := lo(22 * k, (2 * half - 40 * k) / hi(measure(head, GAP, SPACE, false), 1));
    n = say_mid(out, n, head, cx, cy - 48 * k, hc, ink(k, 1, ifx won then GOLD_R else 1.0f32, ifx won then GOLD_G else 0.4f32, ifx won then GOLD_B else 0.35f32));
    m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave); m = put(buf[..], m, " OF "); m = put_int(buf[..], m, waves_of(s));
    m = put(buf[..], m, " · "); m = put_int(buf[..], m, s[0].pops); m = put(buf[..], m, " POPPED · "); m = put_int(buf[..], m, s[0].lives); m = put(buf[..], m, " LIVES");
    sc := lo(11 * k, (2 * half - 24 * k) / hi(measure(cast(string) buf[0..<m], GAP, SPACE, false), 1));
    n = say_mid(out, n, cast(string) buf[0..<m], cx, cy - 6 * k, sc, ink(k, 0.9, INK_R, INK_G, INK_B));
  }
  n = maker_line(s, out, n, w, h);
  return n;
}

stair_frame :: (s: [] Stair, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  stair_start(s);
  s[0].width = width; s[0].height = height; s[0].dpr = dpr; s[0].still = still;
  k := hi(dpr, 0.5);
  step_dt := lo(hi(dt, 0), 0.1);
  if s[0].golden { step_dt = 0; }
  s[0].time += f64(step_dt);
  s[0].clock += step_dt;
  s[0].toast_t = hi(0, s[0].toast_t - step_dt);
  long_press(s);
  if !s[0].paused { s[0].acc += step_dt * f32(s[0].speed); }
  guard := 0;
  while s[0].acc >= f32(STEP) && guard < 64 { step(s, f32(STEP)); s[0].acc -= f32(STEP); guard += 1; }
  if guard >= 64 { s[0].acc = 0; }
  if s[0].wave != s[0].tracked_wave && s[0].phase == FIGHT {
    s[0].tracked_wave = s[0].wave;
    if track_begin(s[0].track[..], "wave") { track_int(s[0].track[..], "wave", s[0].wave); track_end(s[0].track[..]); }
  }
  layout(s, width, height, k);
  buttons(s, width, height, k);
  // uniforms
  for i: 0..<u.count { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = s[0].clock; u[3] = 1;
  u[U_MAP] = s[0].ox; u[U_MAP + 1] = s[0].oy; u[U_MAP + 2] = s[0].tile; u[U_MAP + 3] = f32(SQUASH);
  u[U_INFO] = f32(s[0].scols); u[U_INFO + 1] = f32(s[0].srows); u[U_INFO + 2] = ifx s[0].portrait then 1.0f32 else 0.0f32;
  u[U_INFO + 3] = f32(ifx s[0].hover >= 0 && free_cell(s, s[0].hover) then s[0].hover else -1);
  u[U_INFO2] = s[0].hurt; u[U_INFO2 + 1] = f32(aim_cell(s));
  for p: 0..<2 {
    n := way_n(s, p);
    o := U_ENDS + p * 4;
    if n < 2 || (p == 1 && way_c(s, 1, 0) == way_c(s, 0, 0) && way_r(s, 1, 0) == way_r(s, 0, 0) && way_c(s, 1, n - 1) == way_c(s, 0, way_n(s, 0) - 1) && way_r(s, 1, n - 1) == way_r(s, 0, way_n(s, 0) - 1)) {
      u[o] = -1; u[o + 1] = -1; u[o + 2] = -1; u[o + 3] = -1;
      continue;
    }
    u[o] = f32(way_c(s, p, 0)) + 0.5; u[o + 1] = f32(way_r(s, p, 0)) + 0.5;
    u[o + 2] = f32(way_c(s, p, n - 1)) + 0.5; u[o + 3] = f32(way_r(s, p, n - 1)) + 0.5;
  }
  for i: 0..<CELLS { u[U_CELLS + i] = f32(s[0].cells[i]) + s[0].prog[i] / 100; }
  // the party's figures: a class per tile, which way each faces, its attack's flash
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live { continue; }
    u[U_CELLS + d.cell] = f32(10 + d.cls) + f32(d.level) / 100;
    dx := ifx s[0].portrait then sin(d.aim) else cos(d.aim);
    u[U_UNIT + d.cell] = (ifx dx < -0.05 then -1.0f32 else 1.0f32) * (1 + d.flash);
  }
  ghost := aim_cell(s);
  if ghost >= 0 && s[0].phase != WON && s[0].phase != LOST { u[U_CELLS + ghost] = f32(10 + s[0].pick); u[U_UNIT + ghost] = 3; }
  s[0].plate_n = 0;
  n := 0;
  if s[0].phase != WON && s[0].phase != LOST {
    n = draw_party(s, out, n);
    n = draw_beasts(s, out, n);
    n = draw_fx(s, out, n);
  }
  // the map's strokes (the first n) and the floor are cut to the map's band when zoomed in
  u[U_INFO2 + 3] = f32(n);
  u[U_UNIT + 126] = ifx s[0].zoom > 1.001 then s[0].clip_y0 else 0.0f32;
  u[U_UNIT + 127] = ifx s[0].zoom > 1.001 then s[0].clip_y1 else height;
  s[0].tip_shown = false;
  if !s[0].card_shot { n = draw_hud(s, out, u, n, width, height); }
  u[U_INFO2 + 2] = f32(s[0].plate_n);
  track_frame(s[0].track[..], dt, width, height, dpr);
  if n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  return n;
}

// ---- checks

#test "the game's content is its tables: they read whole, and a broken one is refused with its line and why" {
  c: [1] Content;
  #assert stair_tables_default(c[..], 0) && c[0].hp[EMBER] == 7 && c[0].cost[WIZARD] == 85 && c[0].count[9 * GROUPS + 2] == 6 && c[0].way_n == 8 && c[0].waves == 40;
  // the game plays them
  s: [1] Stair;
  stair_start(s[..]);
  #assert s[0].lives == c[0].start_lives && s[0].gold == c[0].start_gold && s[0].path_len == path_length(s[..]);
  good := "layer mote ac 10 hp 2 dex 0 con 0 speed 1 size 0.2 gold 2 lives 1 colour 1 1 1 inside - -\nlayer wisp ac 11 hp 4 dex 1 con 0 speed 1.2 size 0.24 gold 2 lives 3 colour 0 1 0 inside mote mote\nlayer glimmer ac 13 hp 5 dex 3 con 1 speed 1.6 size 0.26 gold 3 lives 7 colour 1 1 0 inside wisp wisp\nlayer ember ac 12 hp 7 dex 1 con 2 speed 1.4 size 0.3 gold 3 lives 11 colour 1 0 0 inside glimmer wisp\nlayer frostling ac 12 hp 8 dex 1 con 2 speed 1.3 size 0.3 gold 4 lives 15 colour 1 1 1 inside glimmer glimmer\nlayer ironskin ac 15 hp 10 dex 0 con 3 speed 1 size 0.34 gold 5 lives 23 colour 0.6 0.6 0.6 inside ember ember\nlayer shadow ac 13 hp 9 dex 3 con 1 speed 1.5 size 0.3 gold 5 lives 31 colour 0.2 0.2 0.3 inside frostling frostling\nlayer hulk ac 17 hp 60 dex -1 con 5 speed 0.6 size 0.44 gold 20 lives 93 colour 0.6 0.3 0.9 inside ironskin ironskin ironskin ironskin\nclass fighter cost 50 range 1.6 turn 0.9; class wizard cost 85 range 3.4 turn 1.4; class cleric cost 65 range 3 turn 1.3\nclass rogue cost 60 range 1.6 turn 0.8; class ranger cost 75 range 4 turn 1.3; class bard cost 70 range 3 turn 1.4; class paladin cost 80 range 1.6 turn 1\nlevel fighter 30 50; level wizard 50 80; level cleric 40 65; level rogue 35 55; level ranger 45 70; level bard 40 60; level paladin 50 75\nwave 1 mote 5 gap 1 delay 0; wave 2 mote 5 gap 1 delay 0; wave 3 mote 5 gap 1 delay 0; wave 4 mote 5 gap 1 delay 0; wave 5 mote 5 gap 1 delay 0\nwave 6 wisp 5 gap 1 delay 0; wave 7 wisp 5 gap 1 delay 0; wave 8 wisp 5 gap 1 delay 0; wave 9 wisp 5 gap 1 delay 0; wave 10 ember 5 gap 1 delay 0\nstart gold 200 lives 30 # a note\nround 2 every 3\nstair 0 4 13 4";
  #assert stair_tables_read(c[..], good) && c[0].way_n == 2 && c[0].start_lives == 30;
  // a straight stair across the middle row: the game lays it
  s[0].ct[0] = c[0];
  stair_reset(s[..]);
  #assert s[0].path_len == 14 && s[0].cells[cell_of(0, 4)] == CELL_DOOR && s[0].cells[cell_of(13, 4)] == CELL_TOP && s[0].cells[cell_of(6, 4)] == CELL_PATH;
  // broken: a layer popping into a bigger one, a range out of bounds, a crooked stair, a missing wave, a word it doesn't know
  bad := "layer mote ac 10 hp 2 dex 0 con 0 speed 1 size 0.2 gold 2 lives 1 colour 1 1 1 inside wisp -";
  #assert !stair_tables_read(c[..], bad) && c[0].line == 1 && stair_tables_error(c[..]) == "line 1: a layer pops into lower layers (or -), not wisp";
  #assert !stair_tables_read(c[..], "# fine\nclass wizard cost 85 range 30 turn 1.4") && c[0].line == 2 && stair_tables_error(c[..]) == "line 2: range is a number from 0.5 to 8";
  #assert !stair_tables_read(c[..], "stair 0 4 3 5") && stair_tables_error(c[..]) == "line 1: each corner is straight across or down from the last, and not on it";
  #assert !stair_tables_read(c[..], "wave 41 mote 5 gap 1 delay 0") && stair_tables_error(c[..]) == "line 1: a wave is numbered 1 to 40";
  #assert !stair_tables_read(c[..], "\n\ntower 3") && c[0].line == 3;
  #assert !stair_tables_read(c[..], "late 9") && stair_tables_error(c[..]) == "line 1: late is a number from 0.25 to 4";
  #assert !stair_tables_read(c[..], "start gold 1 lives 1") && stair_tables_error(c[..]) == "line 1: no layer mote";
}

#test "the stair winds from the cellar door to the tower top, and the cells beside it are floor" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert s[0].path_len > 26 && s[0].path_len < 29;
  a := path_at(s[..], 0.5); #assert abs(a.x - 0.5) < 0.01 && abs(a.y - 7.5) < 0.01;
  z := path_at(s[..], s[0].path_len - 0.5); #assert abs(z.x - 13.5) < 0.01 && abs(z.y - 1.5) < 0.01;
  #assert s[0].cells[cell_of(0, 7)] == CELL_DOOR && s[0].cells[cell_of(13, 1)] == CELL_TOP;
  #assert s[0].cells[cell_of(3, 4)] == CELL_PATH && s[0].cells[cell_of(4, 4)] == CELL_FLOOR;
  #assert free_cell(s[..], cell_of(4, 6)) && !free_cell(s[..], cell_of(5, 2));
}

#test "placing costs gold, a placed tile is taken, and the layers pop into their insides" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert place(s[..], cell_of(4, 6), FIGHTER) && s[0].gold == s[0].ct[0].start_gold - 50;
  #assert !place(s[..], cell_of(4, 6), CLERIC) && !free_cell(s[..], cell_of(4, 6));
  #assert !place(s[..], cell_of(5, 2), CLERIC);
  i := spawn(s[..], EMBER, 5);
  hurt_beast(s[..], i, 50, DMG_FIRE, false, -1);
  #assert s[0].beasts[i].live && live_beasts(s[..]) == 1;     // immune to fire
  hurt_beast(s[..], i, 50, DMG_FORCE, false, -1);
  #assert live_beasts(s[..]) == 2 && s[0].beasts[i].kind != EMBER;    // a glimmer and a wisp
  #assert s[0].pops == 1 && s[0].gold == s[0].ct[0].start_gold - 50 + s[0].ct[0].gold[EMBER];
}

// A simple player: defenders on free tiles beside the stair, from the door up, as gold allows.
AI_CLASSES :: [6] int.[FIGHTER, WIZARD, FIGHTER, CLERIC, WIZARD, FIGHTER];
beside_path :: (s: [] Stair, cell: int) -> bool {
  c := cell % COLS; r := cell / COLS;
  for dr: -1..<2 { for dc: -1..<2 {
    cc := c + dc; rr := r + dr;
    if cc >= 0 && cc < COLS && rr >= 0 && rr < ROWS && s[0].cells[cell_of(cc, rr)] != CELL_FLOOR && s[0].cells[cell_of(cc, rr)] != CELL_DEFENDER { return true; }
  } }
  return false;
}
ai_spot :: (s: [] Stair) -> int {
  // the free tile beside the stair nearest the middle of the climb
  best := -1; bd := 1000.0f32;
  for cell: 0..<CELLS {
    if !free_cell(s, cell) || !beside_path(s, cell) { continue; }
    c := cell_xy(cell);
    // with two stairs, each in turn
    pa := ifx s[0].path_len2 > 0 then s[0].placed % 2 else 0;
    m := path_on(s[..], pa, ifx pa == 1 then s[0].path_len2 * 0.45 else s[0].path_len * 0.45);
    dd := (c.x - m.x) * (c.x - m.x) + (c.y - m.y) * (c.y - m.y);
    if dd < bd { bd = dd; best = cell; }
  }
  return best;
}
play_through :: (s: [] Stair, builds: bool) -> int {
  guard := 0;
  while s[0].phase != WON && s[0].phase != LOST && guard < 400000 {
    if builds {
      while s[0].gold >= s[0].ct[0].cost[AI_CLASSES[s[0].placed % 6]] {
        spot := ai_spot(s);
        if spot < 0 || !place(s, spot, AI_CLASSES[s[0].placed % 6]) { break; }
      }
    }
    if s[0].phase == BUILD { ok := start_wave(s); }
    step(s, f32(STEP));
    guard += 1;
  }
  return s[0].phase;
}
// Seeded players for the difficulty curve (the tests below, and stair-sim.coax over many seeds):
//   NEW_PLAYER    one defender a round, placed between waves, never levelled
//   NEW_LEVELS    one a round, and levels with what's left over a placement's worth
//   BETWEEN       as many as the round allows, between waves only, then levels with all the rest
//   HOARDER       three defenders, then nothing (the first playtest's run)
//   BEST          as many as the round allows, mid-wave too as gold comes in, then levels
NEW_PLAYER :: 0; NEW_LEVELS :: 1; BETWEEN :: 2; HOARDER :: 3; BEST :: 4;
Played :: struct { won: bool; wave: int; lives: int; placed: int; lost_late: int; }
place_rotation :: (s: [] Stair, most: int) {
  done := 0;
  while done < most && round_left(s) > 0 && s[0].gold >= s[0].ct[0].cost[AI_CLASSES[s[0].placed % 6]] {
    spot := ai_spot(s);
    if spot < 0 || !place(s, spot, AI_CLASSES[s[0].placed % 6]) { break; }
    done += 1;
  }
}
level_all :: (s: [] Stair, keep: int) {
  for q: 0..<DEFENDERS {
    d := s[0].party[q];
    if d.live && d.level < MAX_LEVEL && s[0].gold - up_cost(s[..], d.cls, d.level) >= keep { ok := upgrade(s, q); }
  }
}
play_as :: (s: [] Stair, who: int, seed: u64) -> Played { return play_until(s, who, seed, waves_of(s)); }
// The same, stopping once the first `until` waves are held (won: they were).
play_until :: (s: [] Stair, who: int, seed: u64, until: int) -> Played {
  s[0].seed = seed;
  stair_reset(s);
  r: Played;
  guard := 0;
  while s[0].phase != WON && s[0].phase != LOST && guard < 3200000 && !(s[0].phase == BUILD && s[0].wave >= until) {
    if who == BEST && s[0].phase == FIGHT {
      place_rotation(s, 99);
      if round_left(s) <= 0 { for i: 0..<3 { level_all(s, 0); } }
    }
    if s[0].phase == BUILD {
      most := ifx who == BETWEEN || who == BEST then 99 else ifx who == HOARDER then (ifx s[0].placed < 3 then 3 else 0) else 1;
      place_rotation(s, most);
      if who == NEW_LEVELS { level_all(s, 85); }
      if who == BETWEEN || who == BEST { for i: 0..<3 { level_all(s, 0); } }
      ok := start_wave(s);
    }
    before := s[0].lives;
    step(s, f32(STEP));
    if s[0].wave >= 8 { r.lost_late += before - s[0].lives; }   // from wave 9 on
    guard += 1;
  }
  r.won = s[0].phase == WON || (s[0].phase == BUILD && s[0].wave >= until); r.wave = s[0].wave; r.lives = s[0].lives; r.placed = s[0].placed;
  return r;
}
#test "with no party the tower falls; a party that builds as gold allows holds the first ten waves" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert play_through(s[..], false) == LOST;
  stair_reset(s[..]);
  s[0].ct[0].waves = 10;   // the first ten (the full forty: the forty-wave test and stair-sim.coax)
  #assert play_through(s[..], true) == WON && s[0].wave == 10;
}

#test "a popped glimmer splits into two wisps where it was on the stair, and the split is in the rules log" {
  s: [1] Stair;
  stair_start(s[..]);
  g := spawn(s[..], GLIMMER, 5.0);
  hurt_beast(s[..], g, 99, DMG_FORCE, false, -1);
  r := rule_last(s[..], 0);
  #assert r.what == RULE_SPLIT && r.kind == GLIMMER && abs(r.d - 5.0) < 0.001;
  #assert r.a >= 0 && r.b >= 0 && s[0].beasts[r.a].kind == WISP && s[0].beasts[r.b].kind == WISP;
  #assert abs(s[0].beasts[r.a].d - 5.0) <= 0.13 && abs(s[0].beasts[r.b].d - 5.0) <= 0.13;
  // a mote has nothing inside: a pop
  hurt_beast(s[..], spawn(s[..], MOTE, 2.0), 99, DMG_FORCE, false, -1);
  #assert rule_last(s[..], 0).what == RULE_POP && rule_last(s[..], 1).what == RULE_SPLIT;
}

#test "seeded dice: a map replayed with its seed rolls every roll the same; another seed doesn't" {
  a: [1] Stair; b: [1] Stair; c: [1] Stair;
  stair_start(a[..]); stair_start(b[..]); stair_start(c[..]);
  #assert a[0].seed == STAIR_SEED;
  c[0].seed = 4242;
  stage_highlight(a[..]); stage_highlight(b[..]); stage_highlight(c[..]);
  same := true; differs := false;
  for i: 0..<600 {
    step(a[..], f32(STEP)); step(b[..], f32(STEP)); step(c[..], f32(STEP));
    // the dice's state after every roll so far: equal states, equal rolls
    if a[0].dice[0].state != b[0].dice[0].state || a[0].dice[0].rolled != b[0].dice[0].rolled { same = false; }
    if a[0].dice[0].state != c[0].dice[0].state { differs = true; }
  }
  #assert same && differs && a[0].dice[0].rolled > 100 && a[0].pops == b[0].pops && a[0].rules_n == b[0].rules_n;
  // a seed in the table
  t: [1] Content;
  #assert stair_tables_default(t[..], 0) && t[0].seed == STAIR_SEED;
  #assert !stair_tables_read(t[..], "seed 0") && stair_tables_error(t[..]) == "line 1: a seed is a whole number from 1 to 999999999";
}

#test "turns are deterministic: two runs on the same seed end the same, turn by turn" {
  a: [1] Stair; b: [1] Stair;
  stair_start(a[..]); stair_start(b[..]);
  // the last wave against a full party (the highlight stage), twenty seconds of turns each
  stage_highlight(a[..]); stage_highlight(b[..]);
  for i: 0..<1200 { step(a[..], f32(STEP)); step(b[..], f32(STEP)); }
  #assert a[0].pops > 0 && a[0].phase == b[0].phase;
  #assert a[0].wave == b[0].wave && a[0].lives == b[0].lives && a[0].gold == b[0].gold && a[0].pops == b[0].pops && a[0].leaked == b[0].leaked;
  for i: 0..<DEFENDERS {
    #assert a[0].party[i].live == b[0].party[i].live && a[0].party[i].hits == b[0].party[i].hits && a[0].party[i].misses == b[0].party[i].misses && a[0].party[i].pops == b[0].party[i].pops;
  }
}

#test "the curve: a new player placing one a round reaches wave 8" {
  s: [1] Stair;
  stair_start(s[..]);
  r := play_until(s[..], NEW_PLAYER, 7919, 10);
  #assert r.wave >= 8;
}
#test "the curve: a player who keeps their gold and places three falls by wave 7" {
  s: [1] Stair;
  stair_start(s[..]);
  r := play_until(s[..], HOARDER, 7919, 10);
  #assert !r.won && r.wave <= 7;
}
#test "the curve: the best play holds the first ten waves (all forty: stair-sim.coax)" {
  s: [1] Stair;
  stair_start(s[..]);
  r := play_until(s[..], BEST, 7919, 10);
  #assert r.won && r.wave == 10 && r.lives > s[0].ct[0].start_lives / 2;
}

#test "forty waves: a hulk every ten from 20, the other four layers after 10, and a seeded full party at level 5 holds the last three to the top" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert waves_of(s[..]) == 40;
  for w: 0..<40 {
    hulk := false; late := false;
    for g: 0..<GROUPS {
      kd := s[0].ct[0].kind[w * GROUPS + g];
      if kd == HULK { hulk = true; }
      if kd >= FROSTLING { late = true; }
    }
    #assert hulk == (w + 1 >= 20 && (w + 1) % 10 == 0);
    #assert late == (w + 1 > 10);
  }
  s[0].seed = 7919;
  stair_reset(s[..]);
  s[0].gold = 99999; s[0].wave = 37;
  // the late waves weigh more on the easier maps (this one 1.3 times as many)
  #assert s[0].ct[0].late > 1.2 && s[0].ct[0].count[37 * GROUPS] == cast(int) (18.0 * s[0].ct[0].late + 0.5);
  for i: 0..<60 {
    s[0].placed_round = 0;
    spot := ai_spot(s[..]);
    if spot < 0 || !place(s[..], spot, AI_CLASSES[i % 6]) { break; }
  }
  for k: 0..<DEFENDERS { while s[0].party[k].live && upgrade(s[..], k) {} }
  s[0].gold = 0;
  guard := 0;
  while s[0].phase != WON && s[0].phase != LOST && guard < 400000 {
    if s[0].phase == BUILD { ok := start_wave(s[..]); }
    step(s[..], f32(STEP));
    guard += 1;
  }
  #assert s[0].phase == WON && s[0].wave == 40 && s[0].lives > 0;
}

#test "a defender is picked before it goes down, a round allows only so many, and the allowance grows" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 2000;
  tap_cell(s[..], cell_of(4, 6));
  #assert s[0].placed == 0;                     // nothing picked: nothing placed
  pick(s[..], FIGHTER);
  #assert s[0].pick == FIGHTER;
  s[0].hover = cell_of(4, 6);
  #assert aim_cell(s[..]) == cell_of(4, 6);     // its reach shows before it is put down
  tap_cell(s[..], cell_of(4, 6));
  #assert s[0].placed == 1 && s[0].pick == FIGHTER;
  s[0].touch = true;
  tap_cell(s[..], cell_of(4, 5));
  #assert s[0].placed == 1 && s[0].selected == cell_of(4, 5);   // a phone's first tap only aims
  tap_cell(s[..], cell_of(4, 5));
  #assert s[0].placed == 2;
  #assert round_allowance(s[..], 0) == 3 && round_allowance(s[..], 1) == 3 && round_allowance(s[..], 2) == 4 && round_allowance(s[..], 9) == 7;
  tap_cell(s[..], cell_of(2, 4)); tap_cell(s[..], cell_of(2, 4));
  #assert s[0].placed == 3 && round_left(s[..]) == 0 && s[0].pick == -1;
  #assert !place(s[..], cell_of(4, 3), FIGHTER);
  #assert start_wave(s[..]) && round_left(s[..]) == 3;
  pick(s[..], WIZARD); pick(s[..], WIZARD);
  #assert s[0].pick == -1;                      // the same button again stops placing
}

#test "levels cost gold, not a place in the round; each gives its SRD feature; selling returns 70% of all of it" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 1000;
  #assert place(s[..], cell_of(4, 6), FIGHTER) && place(s[..], cell_of(2, 4), WIZARD) && place(s[..], cell_of(4, 3), CLERIC);
  f := defender_at(s[..], cell_of(4, 6)); w := defender_at(s[..], cell_of(2, 4)); c := defender_at(s[..], cell_of(4, 3));
  left := round_left(s[..]);
  #assert upgrade(s[..], f) && s[0].party[f].level == 2 && s[0].gold == 1000 - 50 - 85 - 65 - 30 && round_left(s[..]) == left;
  #assert s[0].party[f].surge;                                  // Action Surge, at once
  #assert upgrade(s[..], f) && s[0].party[f].level == 3;
  #assert upgrade(s[..], w) && s[0].party[w].slots == MM_SLOTS + 1;
  #assert upgrade(s[..], w) && s[0].party[w].slots2 == SHATTER_SLOTS;
  // Bless: a level-2 cleric in reach adds a d4; the fighter is in the cleric's reach
  #assert !blessed(s[..], f);
  #assert upgrade(s[..], c) && blessed(s[..], f);
  // Improved Critical: a level-3 fighter's 19 crits; checked over many rolls
  crit19 := false;
  for i: 0..<400 { a := stair_attack(s[..], f, STAIR_FIGHTER, 30, 19); if a.roll == 19 { #assert a.crit && a.hit; crit19 = true; } #assert a.total == a.roll + 5 + s[0].party[f].bless && s[0].party[f].bless >= 1 && s[0].party[f].bless <= 4; }
  #assert crit19;
  // Shatter: three crowded beasts all take thunder
  j0 := spawn(s[..], EMBER, 12.0); j1 := spawn(s[..], EMBER, 12.2); j2 := spawn(s[..], EMBER, 12.4);
  s[0].party[w].cell = cell_of(6, 3);
  #assert take_turn(s[..], w) && s[0].party[w].slots2 == SHATTER_SLOTS - 1 && s[0].party[w].how == 3 && s[0].party[w].dealt > 0;
  before := s[0].gold;
  sell(s[..], f);
  #assert s[0].gold == before + (50 + 30 + 50) * 7 / 10;
}

#test "levels four and five: +1 to hit and DC, then a fighter's Extra Attack, and five is the top" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 5000;
  t := spawn(s[..], HULK, 12.0);
  p := beast_xy(s[..], t);
  fc := -1;
  for y: 0..<ROWS { for x: 0..<COLS { c := cell_of(x, y); q := cell_xy(c); if fc < 0 && free_cell(s[..], c) && (q.x - p.x) * (q.x - p.x) + (q.y - p.y) * (q.y - p.y) <= 1.2 * 1.2 { fc = c; } } }
  #assert fc >= 0 && place(s[..], fc, FIGHTER);
  f := defender_at(s[..], fc);
  #assert attacks_of(s[0].party[f]) == 1 && dc_of(s[..], f, 13) == 13;
  for i: 0..<3 { #assert upgrade(s[..], f); }
  #assert s[0].party[f].level == 4 && dc_of(s[..], f, 13) == 14 && attacks_of(s[0].party[f]) == 1;
  a := stair_attack(s[..], f, STAIR_FIGHTER, 30, 19);
  #assert a.total == a.roll + 5 + 1 + s[0].party[f].bless;
  // one swing a turn at level 4 (Action Surge spent)
  s[0].party[f].surge = false; s[0].party[f].swings = 0;
  #assert take_turn(s[..], f) && s[0].party[f].swings == 1;
  #assert upgrade(s[..], f) && s[0].party[f].level == MAX_LEVEL && !upgrade(s[..], f);   // 5 is the top
  s[0].party[f].surge = false; s[0].party[f].swings = 0;
  #assert attacks_of(s[0].party[f]) == 2 && take_turn(s[..], f) && s[0].party[f].swings == 2;
  // the costs: levels four and five from the table
  #assert up_cost(s[..], FIGHTER, 3) == 110 && up_cost(s[..], FIGHTER, 4) == 160;
}

// A free tile beside the stair within r tiles of p, not the one to skip (-1: none).
free_near :: (s: [] Stair, p: P2, r: f32, skip: int) -> int {
  for y: 0..<ROWS { for x: 0..<COLS {
    c := cell_of(x, y); q := cell_xy(c);
    if c != skip && free_cell(s, c) && (q.x - p.x) * (q.x - p.x) + (q.y - p.y) * (q.y - p.y) <= r * r { return c; }
  } }
  return -1;
}
// A defender of class cls placed at c and levelled to lv (gold and the round's allowance given).
placed_at :: (s: [] Stair, c: int, cls: int, lv: int) -> int {
  s[0].gold = 99999; s[0].placed_round = 0;
  if c < 0 || !place(s, c, cls) { return -1; }
  k := defender_at(s, c);
  while s[0].party[k].level < lv { ok := upgrade(s, k); }
  return k;
}

#test "subclasses at level 3, the SRD's own: an Evoker's missed Fire Bolt still burns for half, a Life cleric gives the tower two lives a wave held (once, however many), a Thief's turns come faster, a Hunter adds 1d8 on a hurt beast, a Lore bard inspires three, Devotion adds +3 to hit" {
  s: [1] Stair;
  stair_start(s[..]);
  t := spawn(s[..], HULK, 12.0);
  p := beast_xy(s[..], t);
  // Evoker: with no slots, Fire Bolt; against a hulk's AC 17 it misses often, and every miss still burns
  w := placed_at(s[..], free_near(s[..], p, 3.0, -1), WIZARD, 3);
  #assert w >= 0;
  s[0].party[w].slots = 0; s[0].party[w].slots2 = 0;
  misses := 0;
  for i: 0..<60 {
    s[0].beasts[t].hp = 60;
    if take_turn(s[..], w) && !s[0].party[w].hit && s[0].party[w].roll != 1 { misses += 1; #assert s[0].beasts[t].hp < 60 || s[0].party[w].dealt == 0; }
  }
  #assert misses > 5;
  // Thief: its turns at 0.6 of a rogue's
  r := placed_at(s[..], free_near(s[..], p, 1.5, -1), ROGUE, 3);
  #assert r >= 0 && abs(turn_of(s[..], r) - s[0].ct[0].turn[ROGUE] * f32(THIEF_TURN)) < 0.0001;
  // Hunter: Colossus Slayer on the hurt hulk
  h := placed_at(s[..], free_near(s[..], p, 3.5, -1), RANGER, 3);
  #assert h >= 0;
  for i: 0..<40 { s[0].beasts[t].hp = 30; ok := ranger_shot(s[..], h); }
  #assert s[0].party[h].slayer > 0;
  // Devotion: +3 to hit, with its own aura's +1
  pd := placed_at(s[..], free_near(s[..], p, 1.5, -1), PALADIN, 3);
  #assert pd >= 0;
  a := stair_attack(s[..], pd, STAIR_PALADIN, 30, 20);
  #assert a.total == a.roll + STAIR_PALADIN.attack + SACRED_WEAPON + s[0].party[pd].aura + s[0].party[pd].bless + s[0].party[pd].insp;
  // Lore: three of the party in reach inspired in one turn
  b := placed_at(s[..], free_near(s[..], p, 2.5, -1), BARD, 3);
  #assert b >= 0;
  for q: 0..<DEFENDERS { s[0].party[q].inspired = 0; }
  #assert take_turn(s[..], b);
  got := 0;
  for q: 0..<DEFENDERS { if s[0].party[q].live && s[0].party[q].inspired > 0 { got += 1; } }
  #assert got == 3;
  // Life: a wave held gives the tower two lives back (no more than it started with)
  for i: 0..<BEASTS { s[0].beasts[i].live = false; }
  c := placed_at(s[..], free_near(s[..], p, 6.0, -1), CLERIC, 3);
  #assert c >= 0;
  s[0].lives = 50;
  quiet_fight(s[..]);
  step(s[..], 0.05);
  #assert s[0].phase == BUILD && s[0].lives == 52;
  s[0].lives = s[0].ct[0].start_lives;
  quiet_fight(s[..]);
  step(s[..], 0.05);
  #assert s[0].lives == s[0].ct[0].start_lives;
}

#test "the new classes: Sneak Attack beside an ally, Cunning Action, the ranger's favoured layer, Bardic Inspiration, the paladin's aura and Smite" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 5000;
  t := spawn(s[..], EMBER, 12.0);
  far := spawn(s[..], MOTE, 12.4);
  p := beast_xy(s[..], t);
  // free tiles beside the ember, and one a few tiles off
  near: [8] int; nn := 0; off := -1;
  for y: 0..<ROWS {
    for x: 0..<COLS {
      c := cell_of(x, y);
      if !free_cell(s[..], c) { continue; }
      q := cell_xy(c);
      dd := (q.x - p.x) * (q.x - p.x) + (q.y - p.y) * (q.y - p.y);
      if dd <= 1.4 * 1.4 && nn < 8 { near[nn] = c; nn += 1; }
      if dd >= 3.2 * 3.2 && dd <= 3.8 * 3.8 && off < 0 { off = c; }
    }
  }
  #assert nn >= 3 && off >= 0;
  s[0].placed_round = 0;
  #assert place(s[..], near[0], ROGUE);
  r := defender_at(s[..], near[0]);
  #assert !ally_near(s[..], r, t);
  s[0].placed_round = 0;
  #assert place(s[..], near[1], PALADIN);
  pl := defender_at(s[..], near[1]);
  // Sneak Attack: an ally beside the target
  #assert ally_near(s[..], r, t) && take_turn(s[..], r) && s[0].party[r].how == 4;
  // the aura: the paladin's own roll and any of the party within two tiles add 1
  #assert in_aura(s[..], pl) && in_aura(s[..], r);
  a := stair_attack(s[..], r, STAIR_ROGUE, 30, 20);
  #assert a.total == a.roll + 5 + 1 && s[0].party[r].aura == 1;
  // a defender three tiles off is outside it
  s[0].placed_round = 0;
  #assert place(s[..], off, BARD);
  bd := defender_at(s[..], off);
  #assert !in_aura(s[..], bd);
  // Bardic Inspiration: the rogue's next roll adds a d6, then it is spent
  s[0].party[bd].cell = near[2]; lay_cells(s[..]);
  inspire(s[..], bd, 1);
  #assert s[0].party[r].inspired == 6 || s[0].party[pl].inspired == 6;
  if s[0].party[r].inspired == 6 {
    b := stair_attack(s[..], r, STAIR_ROGUE, 30, 20);
    #assert b.total - b.roll - 5 - 1 >= 1 && b.total - b.roll - 5 - 1 <= 6 && s[0].party[r].inspired == 0;
  }
  // the ranger shoots its favoured layer first, though another is further along
  s[0].placed_round = 0;
  #assert place(s[..], off, RANGER);
  rg := defender_at(s[..], off);
  #assert s[0].party[rg].fav == strongest_next(s[..]);
  s[0].party[rg].fav = EMBER;
  #assert s[0].beasts[far].d > s[0].beasts[t].d && first_of(s[..], off, s[0].ct[0].range[RANGER], EMBER) == t;
  // Cunning Action: a level-2 rogue's turns come a quarter sooner; a level-2 paladin has Divine Smite
  #assert !s[0].party[pl].smite;
  #assert upgrade(s[..], r) && turn_of(s[..], r) < s[0].ct[0].turn[ROGUE] * 0.8;
  #assert upgrade(s[..], pl) && s[0].party[pl].smite;
}

#test "area queries: a Fireball's 20-foot sphere and a Lightning Bolt's line over five hundred beasts look only at the tiles they cover, and find what a full scan finds" {
  s: [1] Stair;
  stair_start(s[..]);
  stair_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/hold-the-stair?stage=swarm");
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for f: 0..<60 { n := stair_frame(s[..], out[..], u[..], 1280, 800, 1, 0.05, false); }
  live := live_beasts(s[..]);
  #assert live >= SWARM;
  hits: [BEASTS] int;
  most := 0; found := 0;
  for q: 0..<40 {
    // a Fireball (20 feet: two tiles) on a beast, then a full scan to check it
    t := (q * 37) % BEASTS;
    while !s[0].beasts[t].live { t = (t + 1) % BEASTS; }
    at := beast_xy(s[..], t);
    n := area_sphere(s[..], at.x, at.y, 2.0, hits[..]);
    most = hi_i(most, s[0].area[0].looked);
    m := 0;
    for i: 0..<BEASTS {
      if !s[0].beasts[i].live { continue; }
      p := beast_xy(s[..], i);
      if (p.x - at.x) * (p.x - at.x) + (p.y - at.y) * (p.y - at.y) <= 4.0 { #assert m < n && hits[m] == i; m += 1; }
    }
    #assert m == n && n >= 1;
    found += n;
    // a Lightning Bolt (100 feet long, 5 wide: ten tiles by half a tile) from a defender's tile
    bx := at.x + 10 * cos(f32(q)); by := at.y + 10 * sin(f32(q));
    nl := area_line(s[..], at.x, at.y, bx, by, 0.25, hits[..]);
    ml := 0;
    lx := bx - at.x; ly := by - at.y; ll := lx * lx + ly * ly;
    for i: 0..<BEASTS {
      if !s[0].beasts[i].live { continue; }
      p := beast_xy(s[..], i);
      tt := clamp(((p.x - at.x) * lx + (p.y - at.y) * ly) / ll, 0, 1);
      ex := at.x + lx * tt - p.x; ey := at.y + ly * tt - p.y;
      if ex * ex + ey * ey <= 0.0625 { #assert ml < nl && hits[ml] == i; ml += 1; }
    }
    #assert ml == nl;
  }
  // the cost: a Fireball looks at the beasts in its few tiles, never all five hundred
  #assert most < live / 2 && found > 40;
}

#test "three maps: each holds its first ten waves, the fork sends the beasts up both stairs, and MAP picks one before the first wave" {
  s: [1] Stair;
  stair_start(s[..]);
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for m: 0..<MAPS {
    set_map(s[..], m);
    #assert s[0].ct[0].ok && s[0].map == m && s[0].path_len > 20;
    r := play_until(s[..], BEST, 7919, 10);
    #assert r.won && r.wave == 10;
    n := stair_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
    #assert n > 0;
  }
  // the fork: two stairs from one door to one top, the beasts in turn
  set_map(s[..], 2);
  #assert s[0].path_len2 > 20 && s[0].cells[cell_of(2, 0)] == CELL_PATH && s[0].cells[cell_of(2, 8)] == CELL_PATH;
  a := spawn(s[..], MOTE, 6); b := spawn(s[..], MOTE, 6);
  #assert s[0].beasts[a].path != s[0].beasts[b].path;
  pa := beast_xy(s[..], a); pb := beast_xy(s[..], b);
  #assert pa.y < 4 && pb.y > 4;
  // a split keeps to its stair
  g := spawn(s[..], GLIMMER, 8);
  gp := s[0].beasts[g].path;
  hurt_beast(s[..], g, 99, DMG_FORCE, false, -1);
  last := s[0].rules[(s[0].rules_n - 1) % RULES_LOG];
  #assert last.what == RULE_SPLIT && s[0].beasts[last.a].path == gp && s[0].beasts[last.b].path == gp;
  // the MAP button: shown before the first wave, it moves on a map and starts over
  stair_reset(s[..]);
  layout(s[..], 1280, 800, 1); buttons(s[..], 1280, 800, 1);
  #assert s[0].shown[B_MAP];
  press(s[..], B_MAP);
  #assert s[0].map == 0 && s[0].ct[0].way2_n == 0;
  stair_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/hold-the-stair?map=2");
  #assert s[0].map == 1 && s[0].phase == BUILD;
  #assert start_wave(s[..]);
  layout(s[..], 1280, 800, 1); buttons(s[..], 1280, 800, 1);
  #assert !s[0].shown[B_MAP];
}

// What each layer pops into, from the design (docs/verse/game-ideas/hold-the-stair.md), for its test.
LAYER_INTO :: [32] int.[-1, -1, -1, -1,  MOTE, MOTE, -1, -1,  WISP, WISP, -1, -1,  GLIMMER, WISP, -1, -1,
  GLIMMER, GLIMMER, -1, -1,  EMBER, EMBER, -1, -1,  FROSTLING, FROSTLING, -1, -1,  IRONSKIN, IRONSKIN, IRONSKIN, IRONSKIN];
#test "all eight bubble-beasts: each pops into what the design says, fire does nothing to an ember nor cold to a frostling, an ironskin halves a weapon's damage, a hulk regenerates" {
  s: [1] Stair;
  stair_start(s[..]);
  // what each pops into (docs/verse/game-ideas/hold-the-stair.md)
  for l: 0..<LAYERS {
    #assert s[0].ct[0].inner_a[l] == LAYER_INTO[l * 4] && s[0].ct[0].inner_b[l] == LAYER_INTO[l * 4 + 1] && s[0].ct[0].inner_c[l] == LAYER_INTO[l * 4 + 2] && s[0].ct[0].inner_d[l] == LAYER_INTO[l * 4 + 3];
    // and a layer's lives are its own and its insides'
    held := 1;
    for j: 0..<4 { if LAYER_INTO[l * 4 + j] >= 0 { held += s[0].ct[0].lives[LAYER_INTO[l * 4 + j]]; } }
    #assert s[0].ct[0].lives[l] == held;
  }
  for l: 0..<LAYERS { s[0].beasts[l].live = false; }
  e := spawn(s[..], EMBER, 6);
  hurt_beast(s[..], e, 50, DMG_FIRE, false, -1);
  #assert s[0].beasts[e].live && s[0].beasts[e].hp == s[0].ct[0].hp[EMBER];
  f := spawn(s[..], FROSTLING, 7);
  hurt_beast(s[..], f, 50, DMG_COLD, false, -1);
  #assert s[0].beasts[f].live && s[0].beasts[f].hp == s[0].ct[0].hp[FROSTLING];
  pops := s[0].pops;
  hurt_beast(s[..], f, 50, DMG_FIRE, false, -1);
  #assert s[0].pops == pops + 1;
  ir := spawn(s[..], IRONSKIN, 8);
  hurt_beast(s[..], ir, 6, DMG_SLASHING, false, -1);
  #assert s[0].beasts[ir].hp == s[0].ct[0].hp[IRONSKIN] - 3;
  hurt_beast(s[..], ir, 6, DMG_FORCE, false, -1);
  #assert s[0].beasts[ir].hp == s[0].ct[0].hp[IRONSKIN] - 9;
  // a hulk: down 20, two seconds later 4 back; never past its full
  for i: 0..<BEASTS { s[0].beasts[i].live = false; }
  h := spawn(s[..], HULK, 9);
  hurt_beast(s[..], h, 20, DMG_FORCE, false, -1);
  for t: 0..<120 { regen(s[..], h, f32(STEP)); }
  #assert s[0].beasts[h].hp >= s[0].ct[0].hp[HULK] - 17 && s[0].beasts[h].hp <= s[0].ct[0].hp[HULK] - 15;
  for t: 0..<6000 { regen(s[..], h, f32(STEP)); }
  #assert s[0].beasts[h].hp == s[0].ct[0].hp[HULK];
  hurt_beast(s[..], h, 999, DMG_FORCE, false, -1);
  irons := 0;
  for i: 0..<BEASTS { if s[0].beasts[i].live && s[0].beasts[i].kind == IRONSKIN { irons += 1; } }
  #assert irons == 4;
}

#test "shadows: a defender without detection skips a shadow; a cleric's Daylight reveals it and then it is targeted" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 5000;
  sh := spawn(s[..], SHADOW, 12.0);
  p := beast_xy(s[..], sh);
  // a free tile beside it for a fighter, another within the cleric's reach
  fc := -1; cc := -1;
  for y: 0..<ROWS {
    for x: 0..<COLS {
      c := cell_of(x, y);
      if !free_cell(s[..], c) { continue; }
      q := cell_xy(c);
      dd := (q.x - p.x) * (q.x - p.x) + (q.y - p.y) * (q.y - p.y);
      if dd <= 1.2 * 1.2 && fc < 0 { fc = c; continue; }
      if dd > 1.5 * 1.5 && dd <= 2.5 * 2.5 && cc < 0 { cc = c; }
    }
  }
  #assert fc >= 0 && cc >= 0;
  s[0].placed_round = 0;
  #assert place(s[..], fc, FIGHTER);
  f := defender_at(s[..], fc);
  #assert !shadow_seen(s[..], sh) && !take_turn(s[..], f) && s[0].beasts[sh].hp == s[0].ct[0].hp[SHADOW];
  s[0].placed_round = 0;
  #assert place(s[..], cc, CLERIC);
  c := defender_at(s[..], cc);
  #assert take_turn(s[..], c) && s[0].party[c].daylight && s[0].party[c].how == 6;
  #assert shadow_seen(s[..], sh) && take_turn(s[..], f);
  // a new wave: Daylight again
  refresh(s[..], c);
  #assert !s[0].party[c].daylight;
}

// A fight with nothing more to spawn (for the tests' own beasts).
quiet_fight :: (s: [] Stair) { s[0].phase = FIGHT; s[0].wave = 1; for g: 0..<GROUPS { s[0].spawned[g] = 999; } }
#test "your spells: Wall of Stone blocks the stair until the beasts break it, Wall of Fire burns what crosses it, Slow halves the climb, and each has its casts a map" {
  s: [1] Stair;
  stair_start(s[..]);
  // a stair tile about a third of the way up
  q := path_on(s[..], 0, 9.0);
  cell := cell_of(cast(int) floor(q.x), cast(int) floor(q.y));
  at := path_spot(s[..], cell);
  #assert at.path == 0 && abs(at.d - 9.0) < 0.8;
  // a tile beside the stair takes no wall
  spell_press(s[..], SPELL_STONE);
  #assert s[0].spell_pick == SPELL_STONE;
  #assert !cast_wall(s[..], cell_of(4, 4)) && s[0].spells[SPELL_STONE] == 2;
  tap_cell(s[..], cell);
  #assert s[0].walls[0].on && s[0].walls[0].kind == SPELL_STONE && s[0].spells[SPELL_STONE] == 1 && s[0].spell_pick == -1;
  // a mote climbs to it and stops there, chewing, until it breaks, then climbs on
  m := spawn(s[..], MOTE, s[0].walls[0].d - 2.0);
  quiet_fight(s[..]);
  for i: 0..<40 { step(s[..], 0.1); }
  #assert s[0].beasts[m].live && s[0].beasts[m].d <= s[0].walls[0].d - 0.44 && s[0].walls[0].hp < f32(WALL_HP);
  for i: 0..<400 { if s[0].walls[0].on { s[0].beasts[m].hp = 99; step(s[..], 0.1); } }
  #assert !s[0].walls[0].on;
  for i: 0..<10 { s[0].beasts[m].hp = 99; step(s[..], 0.1); }
  #assert s[0].beasts[m].d > at.d;
  // Wall of Fire: a glimmer crossing it is burnt (or popped)
  stair_reset(s[..]);
  spell_press(s[..], SPELL_FIRE);
  #assert cast_wall(s[..], cell);
  g := spawn(s[..], FROSTLING, s[0].walls[0].d - 0.2);
  hp := s[0].beasts[g].hp;
  quiet_fight(s[..]);
  for i: 0..<4 { step(s[..], 0.1); }
  #assert !s[0].beasts[g].live || s[0].beasts[g].hp < hp;
  // Slow: half the climb, for SLOW_TIME
  stair_reset(s[..]);
  b := spawn(s[..], MOTE, 2.0);
  quiet_fight(s[..]);
  spell_press(s[..], SPELL_SLOW);
  #assert s[0].slow_t == f32(SLOW_TIME) && s[0].spells[SPELL_SLOW] == 1;
  d0 := s[0].beasts[b].d;
  step(s[..], 0.1);
  #assert abs((s[0].beasts[b].d - d0) - s[0].ct[0].speed[MOTE] * 0.05) < 0.001;
  s[0].slow_t = 0; s[0].gold = 0;
  spell_press(s[..], SPELL_SLOW);
  #assert s[0].spells[SPELL_SLOW] == 0;
  // past the free casts, gold buys them, each dearer
  s[0].slow_t = 0;
  spell_press(s[..], SPELL_SLOW);
  #assert s[0].slow_t == 0;
  s[0].gold = 1000;
  spell_press(s[..], SPELL_SLOW);
  #assert s[0].slow_t > 0 && s[0].gold == 1000 - SPELL_PRICE[SPELL_SLOW] && spell_price(s[..], SPELL_SLOW) == 2 * SPELL_PRICE[SPELL_SLOW];
  // a new game, the casts back
  stair_reset(s[..]);
  #assert s[0].spells[SPELL_SLOW] == 2 && !s[0].walls[0].on;
}

#test "the camera: two fingers pinch the map in about their middle and pan it, a finger pans when zoomed, and nothing is placed by it" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].width = 780; s[0].height = 1688; s[0].dpr = 2;
  layout(s[..], 780, 1688, 2);
  #assert s[0].zoom == 1 && s[0].tile == s[0].bt;
  pick(s[..], FIGHTER);
  mid := to_screen(s[..], 5.5, 4.5);
  // pinch out: 100 px apart to 250 px apart about the middle of tile (5, 4)
  #assert stair_pointer(s[..], mid.x - 50, mid.y, 0, 1, 1);
  #assert stair_pointer(s[..], mid.x + 50, mid.y, 0, 1, 2);
  for i: 1..<11 {
    d := 50 + 7.5 * f32(i);
    #assert stair_pointer(s[..], mid.x - d, mid.y, 1, 1, 1);
    #assert stair_pointer(s[..], mid.x + d, mid.y, 1, 1, 2);
  }
  #assert stair_pointer(s[..], mid.x + 125, mid.y, 2, 1, 2);
  #assert stair_pointer(s[..], mid.x - 125, mid.y, 2, 1, 1);
  layout(s[..], 780, 1688, 2);
  #assert s[0].zoom > 2.3 && s[0].zoom < 2.7 && s[0].placed == 0;
  after := to_screen(s[..], 5.5, 4.5);
  #assert abs(after.x - mid.x) < 10 && abs(after.y - mid.y) < 10;   // the point under the fingers stayed (a finger moves at a time)
  // one finger drags the map right by 60 px
  down := stair_pointer(s[..], 300, 800, 0, 1, 3);
  for i: 1..<7 { ok := stair_pointer(s[..], 300 + 10 * f32(i), 800, 1, 1, 3); }
  #assert stair_pointer(s[..], 360, 800, 2, 1, 3);
  layout(s[..], 780, 1688, 2);
  moved := to_screen(s[..], 5.5, 4.5);
  #assert abs(moved.x - after.x - 60) < 2 && s[0].placed == 0;
  // the map never leaves its band: pan far, it stops at the edge; zoom back out, it fits again
  pan_by(s[..], 100000, 100000);
  layout(s[..], 780, 1688, 2);
  // dragged as far right and down as it goes: the zoomed map's rim and wall meet the band's edges
  #assert abs((s[0].ox - f32(RIM_TILES) * s[0].tile) - (s[0].bx - f32(RIM_TILES) * s[0].bt)) < 1;
  #assert abs((s[0].oy - f32(WALL_ROWS) * s[0].tile * f32(SQUASH)) - s[0].clip_y0) < 1;
  zoom_about(s[..], 0.1, 390, 800);
  layout(s[..], 780, 1688, 2);
  #assert s[0].zoom == 1 && s[0].ox == s[0].bx && s[0].oy == s[0].by;
  // a tile under the HUD is no tile
  #assert cell_at(s[..], 390, s[0].clip_y1 + 5) == -1;
}

#test "pause stops the clock and resume starts it" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert start_wave(s[..]);
  s[0].enabled[B_PAUSE] = true; press(s[..], B_PAUSE);
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  t0 := s[0].wave_t;
  n = stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  #assert s[0].wave_t == t0;
  s[0].enabled[B_PAUSE] = true; press(s[..], B_PAUSE);
  n = stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  #assert s[0].wave_t > t0;
}

#test "the staged highlight is the last wave against a full party at the top level, and the stair is busy" {
  s: [1] Stair;
  stair_start(s[..]);
  stair_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/hold-the-stair?stage=highlight");
  #assert s[0].phase == FIGHT && s[0].wave == waves_of(s[..]) && s[0].placed >= 16;
  for k: 0..<DEFENDERS { if s[0].party[k].live { #assert s[0].party[k].level == MAX_LEVEL; } }
  for i: 0..<720 { step(s[..], f32(STEP)); }
  #assert live_beasts(s[..]) >= 8 && s[0].pops >= 10;
  #assert !query_is("https://x/y?stage=highlights", "stage", "highlight") && query_is("https://x/y?a=1&stage=highlight#z", "stage", "highlight");
}

#test "the swarm stage keeps five hundred beasts on the stair, every one drawn within the vertex budget" {
  s: [1] Stair;
  stair_start(s[..]);
  stair_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/hold-the-stair?stage=swarm");
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for f: 0..<120 { n := stair_frame(s[..], out[..], u[..], 1280, 800, 1, 0.05, false); }
  #assert live_beasts(s[..]) >= SWARM && s[0].phase == FIGHT;
  n := stair_frame(s[..], out[..], u[..], 390 * 3, 844 * 3, 3, 0.016, false);
  #assert n > SWARM * 6 && n < MAX_VERTICES;
}

#test "the NEXT preview names the lives a beast takes, and gold piling up with the round's places used says to level up" {
  s: [1] Stair;
  stair_start(s[..]);
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  s[0].wave = 4;   // wave 5 is next: glimmers, seven lives each
  n0 := stair_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
  s[0].wave = 1;   // wave 2: motes, one life each, no heart (and no MAP: that is before wave 1)
  n1 := stair_frame(s[..], out[..], u[..], 1280, 800, 1, 0.016, false);
  #assert n0 > n1;
  #assert !can_level(s[..]);
  #assert place(s[..], spot_near(s[..], 0.3), FIGHTER);
  s[0].gold = 400;
  #assert can_level(s[..]);
}

#test "a claimed maker's name draws MADE BY <NAME> · TIP, and TIP goes to the tip page" {
  ss: [2] Stair;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  for dims: 0..<2 {
    s := ss[dims..<dims + 1];
    w: f32 = ifx dims == 0 then 1440 else 390 * 3; h: f32 = ifx dims == 0 then 900 else 844 * 3; dpr: f32 = ifx dims == 0 then 1 else 3;
    a := stair_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert !s[0].tip_shown;
    stair_message(s, MAKER_KIND, "Topher");
    b := stair_frame(s, out[..], u[..], w, h, dpr, 0, true);
    #assert b > a && s[0].tip_shown;
    t := s[0].tip_box;
    for i: 0..<BUTTONS { r := s[0].boxes[i]; #assert !s[0].shown[i] || t.x1 < r.x0 || t.x0 > r.x1 || t.y1 < r.y0 || t.y0 > r.y1; }
    #assert t.x0 >= 0 && t.x1 <= w && t.y1 <= h && cell_at(s, (t.x0 + t.x1) * 0.5, t.y0) < 0;
    cx := (t.x0 + t.x1) * 0.5; cy := (t.y0 + t.y1) * 0.5;
    #assert stair_pointer(s, cx, cy, 0, 1, 4) && s[0].press < 0 && !s[0].down_on;
    #assert stair_pointer(s, cx, cy, 2, 1, 4) && s[0].action == ACT_NAVIGATE;
    #assert cast(string) s[0].outbox[0..<s[0].out_n] == "/realms/hold-the-stair/tip";
  }
}
